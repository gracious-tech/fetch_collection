<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Gamo Full Bible final version</book>
  <para style="h">Luqaasa Mishiraachcho</para>
  <para style="toc1">Luqaasa Mishiraachcho</para>
  <para style="toc2">Luqaasa Mishiraachcho</para>
  <para style="toc3">Luqa</para>
  <para style="mt1">Luqaasi Xaafida</para>
  <para style="mt2">Nu Godaa Yesus Kirstoosa Mishiraachcho Qaala</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Luqaasa Mishiraachcho qaalay Yesusi daro wodeppe kase yaana geetetti nabetan Isra7eele asaas yootetti uttiin Isra7eele asay naagi uttida Kirstoosi, «As ubbaa ashshizaade» gididayssa qonccisanaassa. Luqaasi Yesusa, «Manqotas Mishiraachcho qaala sabbakanaas» ba aawappe kiitettidaade gididayssanne Mishiraachcho qaalazikka asas diza dumma dumma metos oge bessizayssa yootees. Luqaasa Mishiraachcho qaalaza giddon harappeka Yesusa hidota gishshas yootiza koyro shempotaninne wurseththa shempotan lo7eththi yootiday hidota gishshassa. Yesusi pude salo bidaappe guye ammanoy waani nam7anththo diccidaakko Hawaareta maxaafan hayssa xaafiday he maxaafazan yootides.</para>
  <para style="ip">Kiitanchchati yexxida yeththaa gishshas Yesusi yelettiin mehe heemmizayti iza be7idayssa, Yesusi buro guuththan dishin Xoossa Keeththe bidayssa asas misha gidida he Samaariya addeza ooson dhayi beettida naaza taarikey heyti wurikka Luqaasa Mishiraachcho maxaafan xalala beetteettes. Iza Mishiraachcho qaalazan gaxappe gaxa gakkanaas addafe yootiday woosa gishshas, Xillo Ayana gishshas, maccassatas Yesusa ooso giddon isttas imettida gishanne Xoossi nagara atto gidayssa yootees guussa.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">Xammaqiza Yohannisa yeleteththinne Yesusa yeleteth <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref> </char></para>
  <para style="io1">Xammaqiza Yohannisa ooso <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref> </char></para>
  <para style="io1">Yesusa xammaqeteththinne paaceteth <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref> </char></para>
  <para style="io1">Yesusi ba ooso koyro Galilan doommides <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref> </char></para>
  <para style="io1">Galilappe Yerusalaame buus <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref> </char></para>
  <para style="io1">Yerusalaameninne he heeran wurseththa saaminttan Yesusa gakkida meto <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref> </char></para>
  <para style="io1">Godaa denththa qoncceththinne pude salo buus <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>Bonchcho Tofiloosaa! Nu achchan hanida yo7ota gishshas daro asati baas hanida mala xaafida. <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>He taarikezikka koyroppe denththidi ba ayfera be7ida markkatinne Xoossa qaala yootidayti nuus aaththidayssa. <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>Tanikka ta baggara xaphoppe denththada keeha naagettadanne paacca xeellada taarikeza wursa sinththe xaafettanaas bessizayssa sinththasada kaallidi xaafettanaas bessizayssa kaaleththada naagettada nees xaafana mala taas lo7o gidi beettides. <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>Hayssa ubbaa ta ooththizay ne tamaardayssi tuma gididayssa nena ero guussassa.<verse eid="LUK 1:4"/></para>
  <para style="s1">Xammaqiza Yohannisi Yelettanayssa Kiitanchcha Gabreeley Kasetidi Yootida Qaala</para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 1:5-6"/>Herdoosi Yuhuda biittan kawotida wode Abiya geetettiza qeeseta halaqaza baggafe qeeseteththa ooso taray iza gakkida Zakaraasa geetettiza issi qeesey dees. Iza machcheyakka Elsabeexo geetettawus; izakka Aaroone bagga asa. Nam7atikka Godaa azazonne iza wogaa wosoy baynda naagidi dizaytanne Xoossa sinththan xillo asa.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1Taari 24:10</ref></char></note><verse eid="LUK 1:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 1:7"/>Gido attiin Elsabeexa naa yelontta maynne gidida gishshas isttas nay baa; nam7atikka wodey bida asa.<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>Zakaraasi Xoossa sinththan qeeseteththa ooso taray iza gakkiin izi ooththishin <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>qeesetas diza wogaa mala Xoossa Keeththan gelidi exaane cuwasana mala exay iza gakkides. <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>Exaaney cuwattishin asay wurikka karen diidi woossees.<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>Godaa kiitanchchay exaaney cuwattiza sooppe ushachcha baggara eqqidi Zakaraasas beettides. <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>Zakaraasikka iza be7idi keehi dagammidi babbides. <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>Kiitanchchay Zakaraasas, «Babbofa! Ne woosay seetettides; ne machcheya Elsabeexa nees attuma naa yelana; iza sunththaaka ne Yohannisa gaada sunththana. <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>Iza yeletan neni daro ufayettana; Daro asaykka ufayettana. <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>Godaa sinththan izi gita gidana. Woyneppe oosettida cajje gidiinkka hara maththosiza ushshu gidiinkka izi uyenna; izi buro ba aayey qanththan dishe Xillo Ayanan kumana.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">Tay 6:3</ref></char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>Isra7eele asaappe darota istta Xoossako zaarana. <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>Aawata wozina istta naytakko, azazettonttaytakka gede Xillota cinccateththaako zaarana malanne Godaas bessiza dere giigsana mala Eelaasa Ayananinne iza wolqqan Godaappe sinththara izi baana» gides.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">Mil 4:5-6</ref></char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>Zakaraasi kiitanchchazas, «Tani cima; ta machcheyakka cimmadus; tani hayssa aazan eranee?» giidi oychchides.<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>Kiitanchchazikka zaaridi, «Tani Xoossa sinththan eqqiza Gabreele. Tanikka ha Mishiraachchoza nees gaththanaas kiitettada yadis.<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">Daane 8:16</ref>; <ref loc="DAN 9:21">9:21</ref></char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>Hekko neni ba woden polettana ta qaala ammanontta ixxida gishshas ne doonay duudana; nenikka haasayana dandayakka» gides.<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>He wode derey Zakaraasi, «Xoossa Keeththaafe kezontta aazas gam7idaakko» giidi modhettishe naagides. <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>Izi Xoossa Keeththaafe kezidi asa haasayssanaas dandaybeenna; malati malati besoppe attiin haasayanaas dandayontta aggiin asay izi Xoossa Keeththan Xoossafe ooraththa miish be7idayssa erides.<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>Zakaraasikka ba ooso taray polettidaappe guye baso simmides. <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>Hessafe guye iza machcheya Elsabeexa naa qanththatadus, ichchashanththo aginay gakkanaas asi bana be7ontta mala qotettadus. <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>Izakka, «Goday ba maarotan ta leqettidayssa asaa giddofe digganaas ha wodezan hayssa taas ooththides» gadus.<verse eid="LUK 1:25"/></para>
  <para style="s1">Yesusi Yelettanayssa Gabreeley Kaseti Yootides</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>Elsabeexa qanththatida usuppunththa aginan, Xoossi ba kiitanchcha Gabreele, Galila biittan diza Naazirete geetettiza katama yeddides. <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>Izikka kawo Dawite zereth gidida Yooseefe geetettiza asas giiga uttida Maaramo geetettiza geela7oykko kiitettides.<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">Mato 1:18</ref></char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>Yiidinne iza dizaso gelidi, «Hanne Xoossi nena anjjidaare saro! Xoossi Goday nenara dees nenikka anjjettidaaro» gides.<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>Maarama kiitanchchaa haasayan keeha dagammada, «Hayssi ay giza sarokaa?» gaada yo7oza keeha qoppadus. <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>Kiitanchchayka Maaramo, «Xoossi nenan ufayettiza gishshas babbofa! <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>Neni qanththatana; attuma naakka yelana; sunththaaka Yesusa gaada sunththana.<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mato 1:21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>Izikka gita gidana; ubbaafe bolla gidida Xoossa naa geetettana; Godaa Xoossi iza aawaa Dawite kawoteththaa izas immana. <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>Izi Isra7eele nayta bollan mernaas kawotana; iza Kawoteththaskka wurseththi deenna» gides.<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>Maaramakka kiitanchchaas, «Tani adde gelabeekke shin hayssi waani hananee?» gaada oychchadus.<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>Kiitanchchayka Maaramis, «Xillo Ayanay ne bolla wodhdhana; ubbaafe bolla Xoossa wolqqay ne bolla kuwasana; hessa gishshas yelettana naazi Geeshsha Xoossa naa geetettana. <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>Asi yelukku; iza maynne giidi haasayza ne dabboya Elsabeexa cimateththan attuma naa qanththatada yelanaas usuppunththo agina oykkadus. <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>Xoossas hanontta miishshi deenna» gides.<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Medhe 18:14</ref></char></note><verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>Maaramakka zaarada, «Hekko tani Xoossa aylle diikkinaa; ne gida mala taas hano» giin kiitanchchay izippe shaakettidi bides. Maarama Elsabeexo beyana badus.<verse eid="LUK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>Maaramakka he wode matara eesota dendada pude gezze deren diza issi Yuhuda katama badus. <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>Zakaraasa keeththe gelada Elsabeexo sarotadus. <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>Elsabeexa Maarami sarokaa siyida mala qanththan diza naazi izi qanththan guppides, Elsabeexinkka Xillo Ayanay kumides. <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>Izakka ba qaala dhoqqu histtada, «Maccassa ubbaafe ne anjjettidaaro; Ne qanththan diza naazikka anjjettidayssa. <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>Ta Godaa aaya taakko yaada tana oychchanaas tani oonee? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>Ne saroka qaala ta siyida mala ta ulo giddon diza nay ufayssan guppides. <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>Polettana giidi Goday izis yootidayssa ammanidaara iza anjjettidaaro» gadus.<verse eid="LUK 1:45"/></para>
  <para style="s1">Maarami Galata Woosa</para>
  <para style="p">
    <verse number="46-49" style="v" sid="LUK 1:46-49"/>Maaramakka,</para>
  <para style="q1" vid="LUK 1:46-49">«Izi ba aylley</para>
  <para style="q2" vid="LUK 1:46-49">kawushshateththaa</para>
  <para style="q2" vid="LUK 1:46-49">xeellida gishshas</para>
  <para style="q2" vid="LUK 1:46-49">ta shemppiya Godaa dhoqqu</para>
  <para style="q2" vid="LUK 1:46-49">ooththada bonchchawus.<note caller="-" style="x"><char style="xo" closed="false">1:46-55 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1Same 2:1-10</ref></char></note></para>
  <para style="q2" vid="LUK 1:46-49">Ta Ayanaykka tana ashshiza</para>
  <para style="q2" vid="LUK 1:46-49">ta Xoossaan ufayettawus.</para>
  <para style="q2" vid="LUK 1:46-49">Wolqqama Goday taas</para>
  <para style="q2" vid="LUK 1:46-49">gita miishshe ooththida gishshas</para>
  <para style="q2" vid="LUK 1:46-49">hachchife sinththan asi wuri tana</para>
  <para style="q2" vid="LUK 1:46-49">anjjettidaaro gaana.</para>
  <para style="q2" vid="LUK 1:46-49">Iza sunththayka geeshsha.<note caller="-" style="x"><char style="xo" closed="false">1:46-48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1Same 1:11</ref></char></note><verse eid="LUK 1:46-49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>Iza maaroy izas babbizaytas</para>
  <para style="q2" vid="LUK 1:50">naa naa gakkanaas daana.<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>Ba wolqqan daro mino</para>
  <para style="q2" vid="LUK 1:51">ooso ooththides;</para>
  <para style="q2" vid="LUK 1:51">ba wozina qofan</para>
  <para style="q2" vid="LUK 1:51">otorettizayta laallides.<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>Kawota kawoteththafe woththides,</para>
  <para style="q2" vid="LUK 1:52">ashketa qasse</para>
  <para style="q2" vid="LUK 1:52">dhoqqu dhoqqu histtides.<note caller="-" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">Iyo 5:11</ref>; <ref loc="JOB 12:19">12:19</ref></char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>Gafidayta lo7o miishshan kalssides;</para>
  <para style="q2" vid="LUK 1:53">dureta gidikko</para>
  <para style="q2" vid="LUK 1:53">mela kushe yeddides.<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55"/>Kase nu aawatas</para>
  <para style="q2" vid="LUK 1:54-55">Abrahaamessinne iza</para>
  <para style="q2" vid="LUK 1:54-55">qommotas gida hidota qaala</para>
  <para style="q2" vid="LUK 1:54-55">naaganaas ba maareteththaa</para>
  <para style="q2" vid="LUK 1:54-55">yuushshi qoppidi</para>
  <para style="q2" vid="LUK 1:54-55">ba aylle Isra7eele</para>
  <para style="q2" vid="LUK 1:54-55">maaddides» gadus.<note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">Medhe 17:7</ref></char></note><verse eid="LUK 1:54-55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>Maaramakka Elsabeexi achchan heedzdzu agina sire gam7ada baso simmadus.<verse eid="LUK 1:56"/></para>
  <para style="s1">Xammaqiza Yohannisa Yeleteth</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>Elsabeexis yelo gallassay gakkiin attuma naa yeladus. <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>Izi gutatinne dabbotikka Goday izis gita maareteth ooththidayssa siyidi izira issife ufayettida.<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>Yelettida osppunththa gallas qaxxaras yida. Iza aawaa sunththan Zakaraasa giidi sunththana koyida.<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Lewe 12:3</ref></char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>Gido attiin aayeya, «Hanenna; iza sunththi Yohannisa geetetto» gadus.<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>Isttika izis, «Ne dabbotappe Yohannisa geetettidi xeygettida asi oonikka baa» gida. <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>Aaway Zakaraasi Naaza oona giidi sunththana koyidaakko malatan oychchida.<verse eid="LUK 1:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63"/>Zakaraasikka xaafiza miish izas immana mala oychchi ekkidi sunththay, «Yohannisa» gi xaafiin asay wurikka malalettides. <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>Heerakka Zakaraasa doonay pogettidi inxarsi birshettiin Xoossaa galata oykkides.<verse eid="LUK 1:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="LUK 1:65"/>Iza gutati wuri daro babbida. Hayssi wurikka dhoqqa gezze biittan Yuhuda deren, ubbason haasayettides. <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>Hayssaka siyida asi wurikka, «Ha guuththa nay ay hananeeshaa?» giidi hanoza wursika ba wozinan oykkides; Godaa kushey tumappe izara issife dees.<verse eid="LUK 1:66"/></para>
  <para style="s1">Zakaraasi Yootida Tinbite</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>Naaza aaway Zakaraasi Xillo Ayanan kumidi tinbite haasayshe,<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>«Yiidi ba asaa ashshida gishshas</para>
  <para style="q2" vid="LUK 1:68">Isra7eele Xoossi galatetto.<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69-70" style="v" sid="LUK 1:69-70"/>Beni wode ba geeshsha nabeta</para>
  <para style="q2" vid="LUK 1:69-70">doonan haasayettidayssa mala</para>
  <para style="q2" vid="LUK 1:69-70">ba aylle Dawite keeththan</para>
  <para style="q2" vid="LUK 1:69-70">ashshiza wolqqa</para>
  <para style="q2" vid="LUK 1:69-70">nuus denththides.<verse eid="LUK 1:69-70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>Izi nuna nu morkketappenne,</para>
  <para style="q2" vid="LUK 1:71">nuna ixxizayta</para>
  <para style="q2" vid="LUK 1:71">kusheppe ashshees.<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>Hayssa izi ooththiday</para>
  <para style="q2" vid="LUK 1:72">nu aawatas</para>
  <para style="q2" vid="LUK 1:72">ba maaroteth bessanaassa,</para>
  <para style="q2" vid="LUK 1:72">ba geeshsha caaqoza</para>
  <para style="q2" vid="LUK 1:72">yuushshi qoppanaassa.<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73-75" style="v" sid="LUK 1:73-75"/>Kase nu aawaa Abrahaames</para>
  <para style="q2" vid="LUK 1:73-75">caaqqidayssa qoppana malanne</para>
  <para style="q2" vid="LUK 1:73-75">nu morkketa kusheppe</para>
  <para style="q2" vid="LUK 1:73-75">izi nuna kessiin</para>
  <para style="q2" vid="LUK 1:73-75">nuni izas baboy baynda</para>
  <para style="q2" vid="LUK 1:73-75">ooththanaassinne</para>
  <para style="q2" vid="LUK 1:73-75">nu diza wode ubbaan</para>
  <para style="q2" vid="LUK 1:73-75">ba sinththan nuna</para>
  <para style="q2" vid="LUK 1:73-75">geeshshateththaninne</para>
  <para style="q2" vid="LUK 1:73-75">xilloteththan essanaassa.<verse eid="LUK 1:73-75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>Godaa oge giigsanaas</para>
  <para style="q2" vid="LUK 1:76">ne izappe sinththara biza gishshas</para>
  <para style="q2" vid="LUK 1:76">ta naazoo neni wogga</para>
  <para style="q2" vid="LUK 1:76">Xoossaa nabe geetettana.<note caller="-" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil 3:1</ref></char></note><verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>Asay ba nagarappe</para>
  <para style="q2" vid="LUK 1:77">maarettida gishshas</para>
  <para style="q2" vid="LUK 1:77">deres atoteththa erateth</para>
  <para style="q2" vid="LUK 1:77">ne immana mala,<verse eid="LUK 1:77"/></para>
  <para style="q2">
    <verse number="78" style="v" sid="LUK 1:78"/>nu Xoossaa lo7o maaroteththaafe</para>
  <para style="q2" vid="LUK 1:78">dendidayssan Saloppe nuus</para>
  <para style="q2" vid="LUK 1:78">arshey kezides.<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>Hessika dhuman dizaytassinne</para>
  <para style="q2" vid="LUK 1:79">hayqo kuwa giddon dizaytaska</para>
  <para style="q2" vid="LUK 1:79">poo7isana malanne</para>
  <para style="q2" vid="LUK 1:79">nu tohotakka saroteththa</para>
  <para style="q2" vid="LUK 1:79">oge kaaleththanaassa» gides.<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>Guuththa naazikka diccides; Ayanankka minnides; Isra7eele asaas qonccen beettana gakkanaas bazzo biittan de7ides.<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">Yesusa Yeleteth</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mato 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>He wode biitta bollan diza asi wurikka taybettidi xaafettana mala Oroome kawo Awugisxoosappe awajjay kezides. <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>Hessika Qerenewoosa geetettizayssi Sooriya dere haariza wode hanida koyro dere taybo. <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>Hessa gishshas asi wuri xaafettanaas ba dere dere bides.<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>Yooseefeykka asho dabboteththan Dawite baggafe gidida gishshas Galila awuraajja giddon diza Naazirete katamappe Yuhuda awuraajja Beeteliheeme geetettiza Dawite katamappe yides. <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>Izi xaafettana bishin izas giigetta dashe yelana matida Maaramira bides. <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>Isttika heen dishin izis yelo wodey gakkides. <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>Izakka koyro attuma naa yelidayssafe guye imaththi aqiza keeththan aqizasoy baynda gishshas naaza carqqara xaaxada miiza sinththan ishisadus.<verse eid="LUK 2:7"/></para>
  <para style="s1">Mehe Heemmizaytanne Kiitanchchata</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>Beeteliheeme achchan dors heemmiza asati dorsa naagishe omarsara karen aqizayti deettes. <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>Godaa kiitanchchayka isttako yides; Godaa bonchcho poo7oykka istta lanqen yuuyi aadhdhanaas poo7ides. Isttika keehi dagammida gishshas, <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>Kiitanchchay istta, «Babbofte! Tani asa ubbaas gidiza gita ufayssa mishiraachcho ekka yadis. <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>Hach kawo Dawite katama Beeteliheemen shempo dhaley yelettides. Izikka Godaa Kirstoosa geetettees. <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>Carqqara xaaxetti ichchida gacino naa demmandeta; hessika inttes malata gido» gides.<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>Izarakka hara daro salo kiitanchchati beettida. Xoossa galatishe,<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>«Bolla salon Xoossas</para>
  <para style="q2" vid="LUK 2:14">bonchchoy gido;</para>
  <para style="q2" vid="LUK 2:14">saroteththika biitta bollan</para>
  <para style="q2" vid="LUK 2:14">izi dosiza</para>
  <para style="q2" vid="LUK 2:14">asaa ubbaas gido» gida.<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>Kiitanchchati isttafe shaakettidi salo simmiin dorsa heemmizayti ba giddon issoy issaa, «Ane haa yiite Goday nuus qonccisidayssanne hanidayssa Beeteliheeme katama biidi beyoos» gida.<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>Isttika eleli biidi Maaramira, Yooseeferanne miiza sinththan ichchida naaza demmida. <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>Be7idaappe guye Godaa kiitanchchay naaza gishshas isttas yootidayssa ubbaa zaari yootida. <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>Heemmizayti yootidayssa siyida asay wuri keehi malalettides. <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>Gido attiin Maarama yo7oza wursa ba wozinan woththa denththa qoppashe gam7adus. <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>Heemmizaytikka hanidayssi wurikka kiitanchchay isttas yootida mala gididi beettida gishshas siyidayssassinne be7idayssas ubbaas Xoossa galatishenne bonchchishe simmida.<verse eid="LUK 2:20"/></para>
  <para style="s1">Gacino Naa Yesusa Xoossa Keeth Efida</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>Naazi yelettiin osppunththa gallassan qaxxarettiza wodey gakkiin aayeya iza qanththatanaappe kase kiitanchchay gida mala Yesusa geetettidi summides.<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Lewe 12:3</ref>; <ref loc="LUK 1:31">Luqa 1:31</ref></char></note><verse eid="LUK 2:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 2:22-23"/>Muse wogaa mala istti geeyza wodey wuriin Yooseefeynne Maarama guuththa naaza Yesusa Godaa Xoossa sinththe shiishshanaas ekkidi Yerusalaame kezida. Hessika Godaa wogaan koyro yelettiza attuma nay wuri Godaas dumma gidana geetettidi xaafettidayssa polanaassinne<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">Kessa 13:2</ref>,<ref loc="EXO 13:12">12</ref></char></note> <verse eid="LUK 2:22-23"/><verse number="24" style="v" sid="LUK 2:24"/>qasseka Godaa wogaan nam7u haraphphetanne woykko nam7u haraphphe ciyeta geetettidayssa mala yarsho shiishshanaassa.<note caller="-" style="x"><char style="xo" closed="false">2:22-24 </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">Lewe 12:6-8</ref></char></note><verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>He wode Yerusalaame kataman xillonne Xoossa babbiza issi Simoona geetettiza asi dees; izikka Isra7eele nayta atoteththaa naagiza asanne Xillo Ayanay iza bolla shempida asa. <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>Qasseka Kirstoosa be7ontta dishe hayqqontta mala Xillo Ayanay izas qonccides. <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>Izikka he wode Xillo Ayanay kaaleththiin Xoossa Keeththe lasha gaath gelides. Naaza aayeyranne aawara Muse wogaan bessizayssa polanaas guuththa naaza Yesusa ekkidi gelida wode,<figure style="fig" alt="Herod’s temple at time of Christ" file="LB00250B.TIF" size="span" ref="2:27">Herdoosi keexisida Xoossa keeth</figure> <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>Simooni naaza ekki idimmidi Xoossaa galatishe,<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29-31" style="v" sid="LUK 2:29-31"/>«Godoo! Ne caaqqida qaalaa mala</para>
  <para style="q2" vid="LUK 2:29-31">ha7i tani ne aylley</para>
  <para style="q2" vid="LUK 2:29-31">ne ashshizayssa</para>
  <para style="q2" vid="LUK 2:29-31">ta ayfera be7ida gishshas</para>
  <para style="q2" vid="LUK 2:29-31">hi7a tana saron ekka;</para>
  <para style="q2" vid="LUK 2:29-31">asa ubbaa sinththan</para>
  <para style="q2" vid="LUK 2:29-31">ne giigsida atoteththaa</para>
  <para style="q2" vid="LUK 2:29-31">ha7i tani ta ayfera beyadis.<verse eid="LUK 2:29-31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>Hayssika ubba deres</para>
  <para style="q2" vid="LUK 2:32">geemettidayssa qonccisiza poo7o;</para>
  <para style="q2" vid="LUK 2:32">ne dere Isra7eelesikka</para>
  <para style="q2" vid="LUK 2:32">bonchcho» gides.<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>Iza aawaynne aaya iza gishshas haasayettida yo7ozan malalettida. <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>Simoonikka istta anjjides; Maaramokka, «Daro asa wozina qofay qonccana mala hayssi Isra7eelen diza darotas dhayossinne atoteththassa; Iza ixxizaytas qasse malata gidana mala doorettides. <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>Qasseka darota wozina qofay qonccana mala naaza mishay qara mashsha mala ne wozina phalqana» gides.<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>Qasseka Aaseere baggafe Fanu7eele naa Haanna geetettiza cimmida nabey dawus; izakka ba koyro azinara laappun layth kumeth de7adus. <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>Layththay izis osppun tammanne oyddu layth gidana gakkanaas omarsinne gallas xoomashenne woossashe Xoossa Keeththafe shaakettontta am7eteththan gam7adus. <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>He wodekka shiiqada Xoossaa galatadus; Yerusalaame wozzeteth naagishe dizaytas ubbaas guuththa naaza gishshas yootadus.<verse eid="LUK 2:38"/></para>
  <para style="s1">Naazirete Simo</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>Yooseeferanne Maaramira Godaa wogaan azazettidayssa polidi Galila awuraajjan diza baso Naazirete katama simmida.<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">Mato 2:23</ref></char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>Guuththa naazikka diccidi minni minni bides; aadho erateththan kumides; Xoossa aadho kiyateththika iza bolla dees.<verse eid="LUK 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>Iza aawaynne iza aaya layththan layththan Paaziga bonchchanaas Yerusalaame beettes.<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref>; <ref loc="DEU 16:1-8">Zaare 16:1-8</ref></char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>Naazas layththay tammanne nam7u layth kumida wode kase lose gididayssa mala Paaziga bonchchana kezida. <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>Paaziga ba7aaleza bonchchidi baso simmishin Yesusi Yerusalaamen attides. Yelidaytikka izi attiddayssa eribeettenna. <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>Banara issife biza oge asaara dees gishe issi gallassa oge bida. Gido attiin izi isttara bayndayssa eridi ba dabbota achchaninne laggeta achchan dizaakko giidi koyida.<verse eid="LUK 2:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 2:45"/>Koyi koyidi beettontta ixxiin Yerusalaame simmida.<verse eid="LUK 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46"/>Heedzdzu gallassafe guye Xoossa Keeththan tamaarsizayta giddon uttidi siyishe, asata oychchishenne istta oysha zaarishe Xoossa Keeththan dishin demmida. <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>Siyidayti wuri Yesusa akeekaninne iza zaarozan daro malalettida.<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>Yooseefeynne Maarama iza be7ida wode malalettida. Maaramakka, «Ta naazoo ays hayssa mala ooththadii? Ne aawaynne tani nena koyishe keehi metotettidos» gadus.<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>Izikka zaaridi, «Tana ays koyidetii? Tani ta aawa keeththan daanaas bessizayssa eribeekketii?» gides. <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>Gido attiin isttas izi yootidayssi gelibeenna.<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>Hessafe guye isttara issife Naazirete wodhdhidi isttas azazettishe de7ides. Iza aaya Maaramakka he hanida miishshaa ubbaa ba wozinan naagashe gam7adus. <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>Yesusi aadho erateththan, geesaninne saban Xoossa sinththaninne asa sinththan diccides.<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1Same 2:26</ref>; <ref loc="PRO 3:4">Leemi 3:4</ref></char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">Xammaqiza Yohannisa Timirte</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mato 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>Xibiraadoose geetettiza Qeesaarey kawotida tammanne ichchashanththo layththan Phanxoosa Philaxoosa geeteizayssi Yuhuda biittaa haariza wode Herdoosi Galila biittaa haariza wode, iza ishay Piliphoosi, Ixuriyaasanne Xirakondoose biittaa haariza wode Lisanoosikka Abloone biitta haariza wode,<verse eid="LUK 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 3:2"/>Haannaynne Qayafay qeeseta halaqa gidida wode Xoossa qaalay bazzo biittan diza Zakaraasa naa Yohannisakko yides.<verse eid="LUK 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 3:3"/>Yohannisi Yordaanoose shaafa achchan diza dereta, «Intte nagara atto gaanaas nagarappe simmidi xammaqettite» giidi yootides; <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>Hessika qasse nabe Isayaasi,</para>
  <para style="q1" vid="LUK 3:4">«Bazzon hizgidi waassiza</para>
  <para style="q2" vid="LUK 3:4">asa kooshinchchi,</para>
  <para style="q2" vid="LUK 3:4">‹Godaas oge giigsite;</para>
  <para style="q2" vid="LUK 3:4">baasidikka lo7eththite.<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>Shoobba biittay wuri kumana;</para>
  <para style="q2" vid="LUK 3:5">zumatinne zumbullati wuri</para>
  <para style="q2" vid="LUK 3:5">ziqqi gaana;</para>
  <para style="q2" vid="LUK 3:5">geella ogey sitti gaana;</para>
  <para style="q2" vid="LUK 3:5">moorettida ogey lo7o gidana.<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>Asa zereth ubbaa ashshiza</para>
  <para style="q2" vid="LUK 3:6">Xoossa wolqqa beyana›</para>
  <para style="q2" vid="LUK 3:6">giidi bazzon waassiza</para>
  <para style="q2" vid="LUK 3:6">asa qaala giiris»</para>
  <para style="q2" vid="LUK 3:6">giidi ba maxaafan xaafida mala.<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>Yohannisikka iza kushen xammaqettana yiza asaas, «Intteno ha shooshsha naytoo! Yaana diza Xoossa hanqofe haakkana mala ooni inttena zoridee?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mato 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>Intte nagara oosoppe simmidayssa erisiza ooso ooththite; ‹Nu aaway Abrahaamey nuus dees› guus aggite gides. ‹Xoossi baas giikko ha shuchchatappe Abrahaames naa ooththi denththanaas dandayzayssa erite›<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoha 8:33</ref></char></note> <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>Kalttay mith qanxxanaas miththa xaphon dees. Lo7o ayfe ayfontta iita miththi wuri qanxxettidi taman yegettana» gides.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mato 7:19</ref></char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>Asaykka, «Histtiin ay ooththinoo?» giidi oychchides.<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>Yohannisikka asaas, «Nam7u may7oy dizay issi may7oy baynda asas immo; qasseka qumay dizaykka bayndaades shaakki immo» gides.<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>Qaraxa shiishshizaytikka xammaqettanaas yiidi, «Astamaaree! Nu ay ooththinoo?» gida.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luqa 7:29</ref></char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>«Izikka, ‹Intte azazettidayssafe bollara qaraxa shiishshofte› gides.<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>«Wottadaratikka, ‹Nuni qasse ay ooththinoo?› giidi oychchida. Izikka, ‹Oona miishsheka wolqqan ekkofte; qasseka oonakka wordon mootopite; intte damozay inttes gidana› » gides.<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>Asay Yohannisa be7idi, «Hayssi Kirstoosaa?» giidi ba wozinan sidhides. <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>Yohannisikka ubbaas, «Tani inttena haaththan xammaqays; gido attiin ta iza caamma birshanaas bessonttay taappe aadhdhizaadey yaana. Izi inttena Xillo Ayananinne taman xammaqana. <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>Balezan diza kaththaa gafezappe geeshshanaas kath suraggiza layday iza kushen dees. Baleza kumeth geeshshana; gistteza qasse di7en qolana; gafezakka to7ontta taman xuuggana» gides.<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>Yohannisi asaa hara dumma dumma zore qaalara minththi zorishe Mishiraachcho qaala yootides. <verse eid="LUK 3:18"/><verse number="19" style="v" sid="LUK 3:19"/>Gido attiin Galila biitta haariza Herdoosi ba isha machcho Herodiyaado ekkida gishshassinne hara daro iita ooththida gishshas Yohannisi iza hanqida gishshas, <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>kase mooroza bolla hara gujjidi Herdoosi Yohannisa qasho keeththan yeggides.<verse eid="LUK 3:20"/></para>
  <para style="s1">Yesusi Xammaqettides</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mato 3:13-17</ref>; <ref loc="MRK 1:9-11">Mar 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>Asay xammaqettidaappe guye Yesusikka xammaqettides; izi woossishin saloy doyettides. <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>Xillo Ayanaykka haraphphe misatidi iza bolla wodhdhides. «Saloppe, ‹Ta dosiza nay nena; Nenan tani ufayettays› » giza qaalay yides.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maza 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Mato 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 9:35">Luqa 9:35</ref></char></note><verse eid="LUK 3:22"/></para>
  <para style="s1">Yesusa Zereththa Zarkke</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mato 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>Yesusi Xoossa ooso oykkishin izas layththay gede heedzdzu tammu gidana. Asaykka izi Yooseefe naa, Eele naa, <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>Maate naa, Lewe naa, Milka naa, Yuhuda naa, Yooseefe naa, <verse eid="LUK 3:24"/><verse number="25" style="v" sid="LUK 3:25"/>Matotiyo naa, Amoxe naa, Nahome naa, Isilime naa, Naage naa, <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>Maate naa, Matotiyo naa, Semeye naa, Yooseefe naa, Yuhuda naa, <verse eid="LUK 3:26"/><verse number="27" style="v" sid="LUK 3:27"/>Yoonane naa, Ereese naa, Zerubaabele naa, Salatiyaale naa, Neere naa, <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>Milka naa, Hade naa, Yoosa naa, Qoosaame naa, Elimodaame naa, Eera naa, <verse eid="LUK 3:28"/><verse number="29" style="v" sid="LUK 3:29"/>Iyaaso naa, El7ezeere naa, Iyoraame naa, Maate naa, Eele naa, <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>Simoona naa, Yuhuda naa, Yooseefe naa, Yoona naa, Elyaaqeeme naa, <verse eid="LUK 3:30"/><verse number="31" style="v" sid="LUK 3:31"/>Meeliya naa, Maynaane naa, Maxaate naa, Naataane naa, Dawite naa, <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>Isseye naa, Iyoobeede naa, Boo7eeze naa, Solomoone naa, Naasoone naa, <verse eid="LUK 3:32"/><verse number="33" style="v" sid="LUK 3:33"/>Aminadaabe naa, Aaraame naa, Aaroone naa, Esroome naa, Faareese naa, Yuhuda naa, <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>Yaaqoobe naa, Yisaaqa naa, Abrahaame naa, Taara naa, Naakoore naa, <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>Seerohe naa, Eraaguwe naa, Faaleqe naa, Abeere naa, Saala naa, <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>Qayiname naa, Arfaakiside naa, Seeme naa, Nohe naa, Laamehe naa, <verse eid="LUK 3:36"/><verse number="37" style="v" sid="LUK 3:37"/>Maatusaala naa, Heenooke naa, Yaareede naa, Malal7eele naa, Qayiname naa, <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>Heenoose naa, Seete naa Addaame naa, Xoossa naa geettes.<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">Yesusa Paaceteth</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mato 4:1-11</ref>; <ref loc="MRK 1:12-13">Mar 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>Yesusi Xillo Ayanan kumidi Yordaanoose shaafappe simmida mala Xillo Ayanay iza kaaleththidi bazzo biitta efides. <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>Heenkka Xala7en oyddu tammu gallas paacettides. He paacettiza gallassatan aykkoka montta gishshas wurseththan gafides.<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>Xala7eykka Yesusa, «Ne Xoossa naa gidikko ane hayssa shuchchaa kath gidana mala azaza» gides.<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>Yesusikka zaaridi, «Asi kaththan xalla deenna geetettidi xaafettides» giidi Xala7es zaarides.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Zaare 8:3</ref></char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>Hessafe kaallidi Xala7ey Yesusa issi dhoqqa zuma bolla kessidi salo gufanththon diza kawoteththata qiphida ayfey xeellanaas bessidi, <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>«Hayssi ne be7iza biitta kawota godateththinne bonchchoy wurikka taas imettides; tanikka ta dosizaades immanaas dandayza gishshas neeskka immana.<verse eid="LUK 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 4:7"/>«Hessa gishshas neni kundada taas goynniko hayssi wurikka nees gidana» gides.<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>Yesusikka zaaridi, «Ne Godaa Xoossas kundada izas xalla goynna geetettidi xaafettides» gides.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Zaare 6:13</ref></char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9-11" style="v" sid="LUK 4:9-11"/>Hessafekka Yesusa Yerusalaamen Xoossa Keeththa xeera kessi essidi Xoossa Maxaafan, «Nena naagana mala Xoossi ne gishshas ba kiitanchcha azazana; ‹Ne tohoy shuchchan dhuphettontta mala kiitanchchati ba kushera nena dhoqqu histti oykkana› geetettidi xaafettida gishshas ane ne Xoossa Naa gidikko hayssafe duge kunda» gides.<note caller="-" style="x"><char style="xo" closed="false">4:10-11 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Maza 91:11-12</ref></char></note><verse eid="LUK 4:9-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>Yesusikka, «Ne Godaa Xoossaa paaccofa» geetettides giidi zaarides.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Zaare 6:16</ref></char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>Xala7eykka ba paaccanayssa wursidaappe guye baas injje wodey beettanaashe Yesusappe shaakettides.<verse eid="LUK 4:13"/></para>
  <para style="s1">Yesusi Galilan Tamaarso Oykkides</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mato 4:12-17</ref>; <ref loc="MRK 1:14-15">Mar 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>Yesusikka Xillo Ayana wolqqan Galila simmides; iza goobateththi Galila achchan diza deretan siyettides. <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>Izikka Ayhudata Woosa Keeththan tamaarsishin iza timirtey lo7iin asay wurikka iza galatides.<verse eid="LUK 4:15"/></para>
  <para style="s1">Naazireten Yesusa Ixeteth</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mato 13:53-58</ref>; <ref loc="MRK 6:1-6">Mar 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>Heeppe ba yelettida katama Naazirete yiidi kase Sambata gallas Ayhuda Woosa Keeth geliza mala gelidi Xoossa Maxaafa nababanaas dendi eqqides. <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>Nabe Isayaasa Maxaafay izas imettiin maxaafaa doyda mala.<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="LUK 4:18-19"/>«Godaa Ayanay ta bolla dees;</para>
  <para style="q2" vid="LUK 4:18-19">manqotas Mishiraachcho qaala</para>
  <para style="q2" vid="LUK 4:18-19">yootana mala tana tiydes;</para>
  <para style="q2" vid="LUK 4:18-19">qashettidaytas birsheteth,</para>
  <para style="q2" vid="LUK 4:18-19">qooqeti xeellana oge</para>
  <para style="q2" vid="LUK 4:18-19">ta awajjana mala,</para>
  <para style="q2" vid="LUK 4:18-19">metotettidayta ashshana mala,</para>
  <para style="q2" vid="LUK 4:18-19">dosettida Godaa layththa awajjaa</para>
  <para style="q2" vid="LUK 4:18-19">ta yootana mala</para>
  <para style="q2" vid="LUK 4:18-19">tana kiittides»</para>
  <para style="q2" vid="LUK 4:18-19">gizaso demmi nababides.<verse eid="LUK 4:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>Maxaafaakka gordidi Ayhuda Woosa Keeththe naagizayssas zaari immidi uttides. Ayhudata Woosa Keeththan dizayti wurikka iza tishshi histti xeellida. <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>Izikka isttas, «Hayssi intte intte hayththara siyida maxaafa qaalay hach polettides» gides.<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>Asay wurikka iza gishshas lo7o xalala haasayeettes; qasseka iza doonappe keziza lo7o qaalaappe dendidayssan malalettidi, «Hayssi Yooseefe naa gidennee?» gida.<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>Izikka, «Dhale Godoo nerkka nena paththa; Qifirnahoomen neni ooththishin nu siyidayssa hayssan ne katamankka ooththa giza leemiso intte ta bolla malatanayssas sidhey baa» giidi isttas yootides. <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>Qasseka, «Ta inttes tuma gays; nabey ba yelettida deren bonchchetti erenna.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoha 4:44</ref></char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25-26" style="v" sid="LUK 4:25-26"/>«Gido attiin ta inttes tuma gays; heedzdzu layththinne bagga gakkanaas saloy gordettiin wolqqama koshay biitta bolla hanida Eelaasa wode he layththatan azinay baynda daro maccassati Isra7eele biittan deettes shin Eelaasi isttafe issineykkoka kiitettibeenna. Gido attiin Sidoona geetettiza biittan Seraphita geetettiza kataman diza issi azinay baynda maccassayko kiitettides.<note caller="-" style="x"><char style="xo" closed="false">4:25-26 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1Kawo 17:1</ref>,<ref loc="1KI 17:8-16">8-16</ref></char></note> <verse eid="LUK 4:25-26"/><verse number="27" style="v" sid="LUK 4:27"/>Nabe Elssa7e wode Isra7eele deren daro inchchirachcha hargizayti deettes; gido attiin Sooriya biitta as Ni7imaaneppe attiin he darotappe oonikka inchchirachcha hargefe paxibeenna» gides.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2Kawo 5:1-14</ref></char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>Ayhudata Woosa Keeththan dizayti wurikka hessa siyidi daro hanqettida. <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>Ba uttidasohoppe dendi eqqidi Yesusa katamaappe kare kessidi duge zaari yeddanaas istta katamaya oosettida zumaa bolla aafotizason oosettidaso ekki efida. <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>Gido attiin izi istta giddora shaakki yeggidi aadhdhi bides.<verse eid="LUK 4:30"/></para>
  <para style="s1">Yesusi Tuna Ayana Kessides</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>Heeppeka Galila awuraajjan diza Qifirnahoome geetettiza katama wodhdhides; heenkka Sambata gallas daro asa tamaarso oykkides. <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>Izi Godateththara haasayza gishshas iza timirtezan malalettida.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Mato 7:28-29</ref></char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>Ayhudata Woosa Keeththan tuna ayanay oykkida addey dees. Izikka ba qaala dhoqqu histtidi, <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>«Naazirete Yesusaa ha7i ta waanoo? Nenara tana aazi gaththidee? Ne yiday nuna dhayssanaassee? Ne oonakko ta erays; ne Xoossa Xilloza gidikkii?» giidi waassides.<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>Yesusikka tuna ayanaza ha addezappe, «Co7u gaada keza» giidi seerides; tuna ayanazikka daro asaa sinththan addeza bollafe yeggidi issi qohokka gaththontta yeddi kezides.<note caller="-" style="x"><char style="xo" closed="false">4:35 </char><char style="xt" closed="false"><ref loc="MRK 1:21-28">Mar 1:21-28</ref></char></note><verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>Asay wurikka malalettidi ba giddon issoy issaara, «Aso hayssi ay giza timirtee? Godateththaranne wolqqara iita ayana azazees; isttika kezeettes» giidi haasayettida. <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>Yesusa goobateththika ubbaso gakkides.<verse eid="LUK 4:37"/></para>
  <para style="s1">Yesusi Daro Harganchchata Paththides</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mato 8:14-17</ref>; <ref loc="MRK 1:29-34">Mar 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>Hessafe guye Yesusi Ayhuda Woosa Keeththafe kezidi Simoona keeththe gelides. Simoona bolloteya, «Wolqqama misho hargey oykkiin sakettada dishin Yesusa izo paththarkkii!» giidi woossida. <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>Yesusikka izikko shiiqidi misho hargeza seerides. Misha hargeyka yeddiin heerakka denda eqqada imaththata mokkadus.<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>Arshey wullana gishin dumma dumma hargey oykkida asaa wursi izakko ekki yida. Izikka hargiza asaa ubbaa bolla ba kushe woththidi paththides. <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>Tuna ayanati qasseka Yesusa, «Neni Xoossa naa» gishenne waassishe daro asatappe kezida; gido attiin izi istta seerides; tuna ayanati izi Kirstoosa gididayssa eriza gishshas istti issinokka haasayana mala koyibeenna.<verse eid="LUK 4:41"/></para>
  <para style="s1">Galilan Yesusa Timirte</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>Gadey wontishin Yesusi issi asikka bayndaso bides. Daro asaykka iza koyishe izi dizaso gakkides. Izi isttafe shaakettidi bontta mala digganaas koyida. <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>Gido attiin isttas, «Gede hara katama baada Xoossa Kawoteththa Mishiraachcho qaala yootanaas taas bessees; tani kiitettida gita qofay hessa» gides.<verse eid="LUK 4:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44"/>Izikka Yuhudan Ayhudata Woosa Keeththan qaala gujji yootides.<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">Yesusi Koyro Hawaareta Xeygides</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mato 4:18-22</ref>; <ref loc="MRK 1:16-20">Mar 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>Yesusi Gensereexe Abba lanqen eqqidi Xoossa qaala tamaarsishin siyiza asay iza un7eththides.<verse eid="LUK 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 5:2"/>He wode nam7u wogoloti abba achchan dishin Yesusi be7ides. Mole oykkizayti wogolotappe wodhdhidi mole giteta meecceettes.<figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.TIF" size="span" ref="5:2">Mole oykkizayti wogolon diidi mole oykkishin</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>Yesusi wogolotappe Simoona wogolon gelidi biittafe gede abba gido shiishshana mala oychchidinne wogolo giddon uttidi asaa tamaarsides.<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>Tamaarsi wursidaappe guye Simoona, «Abbay ciimmatizaso shiiqa mole oykkanaas intte giteza abba giddo yeggite» gides.<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>Simooni Yesusas zaaridi, «Godoo! Qammaa kumeth daaburi aqidi issinokka oykkibeekko; gido attiin ne qaalaan giteza nu yeggana» gides.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">Yoha 21:3</ref></char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>Giteza yeggida wode daro mole oykkida. Giteykka daakettides.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">Yoha 21:6</ref></char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>Hara wogolon dizayti yiidi istta maaddana mala kushera wutti xeygida. Isttika yiidi nam7u wogolota mole kunththida. Wogolotikka duge miteteth oykkida.<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>Simoona geetettiza Phexroosi hessa be7idi Yesusa toho bolla kundidi, «Godoo! Ta nagaranchcha gidida gishshas ta achchafe kichcha» gides. <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>Izi hessa giday izinne izara dizayti oykkida daro molezan malalettida gishshassa. <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>Qasseka Simoona laggeti Zabdoosa nayti Yaaqoobeynne Yohannisi wurikka malalettida. Yesusikka Simoona, «Babbofa! Hayssafe guye ne as oykkizaade gidana» gides.<verse eid="LUK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11"/>Isttika wogolota biittako shiishshidi wursika yeggi aggidi Yesusa kaallida.<verse eid="LUK 5:11"/></para>
  <para style="s1">Yesusi Inchchirachcha Hargefe Paththida Addeza</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>Yesusi katamatappe issineyn dishin inchchirachcha hargey bolla wursi oykkida issi asi he kataman dees; he addezikka Yesusa be7idi iza sinththan kundidi, «Godoo! Ne koykko tana paththana dandayaasa» giidi woossides.<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>Yesusi ba kushe yeddi bochchidi, «Ta dosadis, paxa» gides. Inchchirachchay heerakka dhaydes. <verse eid="LUK 5:13"/><verse number="14" style="v" sid="LUK 5:14"/>Yesusi izas, «Hayssa oonaska yootoppa; gido attiin baada nena qeese halaqas bessa; isttas markka gidana mala ne geeyidayssas Musey azazida yarshoza shiishsha» giidi azazides.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lewe 14:1-32</ref></char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>Gido attiin iza gishshas asay haasayza worey kaseppe aakki aakki bides; keehi daro asay iza haasaya siyanaassinne bana sakkiza hargefe paxanaas izakko shiiqides. <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>Yesusi daro wode asi bayndaso biidi woossides.<verse eid="LUK 5:16"/></para>
  <para style="s1">Yesusi Paththida Sila Addeza</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mato 9:1-8</ref>; <ref loc="MRK 2:1-12">Mar 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>Yesusi tamaarsishin asay Galilappenne Yuhudappe qasseka Yerusalaameppe yida Farsaawetinne wogaa tamaarsizayti heen uttida. Izi paththana mala Godaa wolqqay izara dees. <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>He wode asay issi kumeththa bollay silidi qaaxxontta harganchcha halara tookki ekki yiidi keeththe gelththidi Yesusa sinththan woththanaas paaccida. <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>Asaa daroteththafe dendidayssan keeththe gelththanaas xoonettida gishshas pude keeththa kaara bolla kezidinne kaaraa qaaridi harganchchaza halaara tookki ehidi asaa giddora Yesusa sinththan woththida. <verse eid="LUK 5:19"/><verse number="20" style="v" sid="LUK 5:20"/>Yesusi istta ammano be7idi, «Haysso neni ne nagaraappe maarettadasa» gides.<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>Muse wogaa xaafizaytinne Farsaaweti, «Hayssi Xoossa bolla xalateththan hayssaththo haasayzay izi oonee? Issi Xoossafe attiin nagara maaranaas ooni dandayzee?» giidi qoppida.<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>Yesusi istta qofaa erida gishshas, «Intte intte wozinan ays, hessaththo qoppeetii? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‹Ne nagaray atto geetettides› guussafenne ‹Dendada ba› guussafe awayssi kawushshee? <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>Gido attiin ta hayssa giday asa naas biitta bolla as nagarappe maaranaas godateththi dizayssa intte erana mala» gides; qasseka he sila addeza, «Nena gays! Denda eqqa! Ne halaa tookkada ba!» gides.<verse eid="LUK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25"/>Izi heerakka istta sinththan dendi eqqides; kase ba ichchida halaa tookkidi Xoossaa galatishe baso bides. <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>He wode asi wuri malalettides. Xoossa galatishe, «Hach malalisizaaz be7idos» giidi daro babbida.<verse eid="LUK 5:26"/></para>
  <para style="s1">Matoosa Geetettiza Lewe Xeygeteth</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mato 9:9-13</ref>; <ref loc="MRK 2:13-17">Mar 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>Hessafe guye Yesusi heeppe kezi bides. Lewe geetettiza issi qaraxa qanxxisizayssi qaraxa qanxxizason uttidayssa be7idi, «Tana kaalla» gides. <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>Izikka wursi aggidi iza kaallides.<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>Leweykka Yesusas ba keeththan gita diggisa diggisides. Qaraxa qanxxisiza daro asatinne hara asatikka isttara issife maaddan uttida. <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>Farsaawetinne istta Xaafeti, «Qaraxa qanxxisizaytaranne nagaranchchatara issife aazas meetii?» giidi Yesusa kaallizayta bolla zuuzumettida.<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luqa 15:1-2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>Yesusikka isttas, «Harganchchatas attiin paxa asas aakime koshshenna. <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>Tanikka nagaranchchata maaroteththaako zaaranaas yadis attiin xillota xeyganaas yabeekke» gides.<verse eid="LUK 5:32"/></para>
  <para style="s1">Xooma Gishshas Oyshettida Oysho</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mato 9:14-17</ref>; <ref loc="MRK 2:18-22">Mar 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>Isttika zaaridi, «Yohannisa kaallizayti daro wode xoomeettessinne woosseettes. Farsaaweta kaallizaytikka izaththo ooththeettes. Nena kaallizayti gidikko ubba wode meettessinne uyeettes» gida.<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>Yesusikka isttas zaaridi, «Mishiray issife dishin diggisas xeygettidayti xoomanaas bessizee? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>Gido attiin mishiray isttafe shaakettana wodey yaana; istti he wode xoomana» gides.<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>Isttas, «Ooraththa may7ofe qanxxi ekkidi gal7a may7o bolla woththi sikkizaadey deenna; woththi sikkiko ooraththazi gal7aara gaaggontta gishshas gal7aza daakkana. <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>Woyneppe oosettida ooraththa cajje gal7a lukkamon kunththidi woththiza asi oonikka deenna; woththizaa gidikko woyneppe oosettida ooraththa cajjey gal7aza daakkana. Woyne cajjezikka biittan gukkana; gal7a lukkamoy sinththafe go7onttaaz gidana. <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>Hessa gishshas ooraththa woyne cajjey ooraththa ogoron gujettanaas bessees. <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>Histtiko caala woyne cajje uyidaappe guye caalonttaaz uyana koyzay oonikka deenna gaasoykka caalay lo7o gidida gishshassa» gides.<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">Sambata Gishshas Oyshettida Oysho</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mato 12:1-8</ref>; <ref loc="MRK 2:23-28">Mar 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>Issi Sambata gallas Yesusi kaththa giddora aadhdhi bishin iza kaallizayti tiya xuphi ekkidi ba kushen shigechchi mishin,<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref></char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>Farsaawetappe issi issi asati, «Sambata gallas ooththanaas bessonttayssa ays ooththeetii?» gida.<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>Yesusikka isttas, «Dawiti izara diza asati gafida wode izi ooththidayssa nababibeekketii?<note caller="-" style="x"><char style="xo" closed="false">6:3-4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Same 21:1-6</ref></char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>Izi Xoossa Keeththe gelidi qeeseti xalla maana mala azazettida dumma ukeththaa baas miidi banara dizaytas immides» giidi zaarides.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lewe 24:9</ref></char></note><verse eid="LUK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5"/>Qasseka Yesusi, «Asa Nay Sambata Godaa» giidi isttas yootides.<verse eid="LUK 6:5"/></para>
  <para style="s1">Yesusi Paththida Kushe Sila Addeza</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mato 12:9-14</ref>; <ref loc="MRK 3:1-6">Mar 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>Yesusikka hara Sambata gallas Ayhuda Woosa Keeththe gelidi tamaarsishin ushachcha kushey silida issi asi heen dees. <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>Muse wogaa tamaarsizaytinne Farsaaweti Yesusa mootanaas gaaso koyidi ane izi Sambata gallassan addeza paththiko beyana giidi naagishe gam7ida. <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>Yesusikka istta wozina qofaa eridi kushey silida addeza ubbaa sinththan, «Denda eqqa» gides. Addezikka dendi eqqides.<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>Yesusikka istta, «Ta inttena issi miish ane oychchays; Sambata gallas ooththanaas bessizay lo7o oosoyee? Iita oosoo? Shempo asho woykko dhayssoo?» giidi oychchides.<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>Qasseka Yesusi ba yuushon diza ubbaa yuushshi xeellidaappe guye addeza, «Ne kushe piddisa» gides; addezikka Yesusi gida mala ooththides. Iza kusheykka paxides.<verse eid="LUK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11"/>Gido attiin asati hanqettida; Yesusa bolla ay ooththanaas koshshizaakko ba giddon zorettida.<verse eid="LUK 6:11"/></para>
  <para style="s1">Tammanne Nam7u Hawaareta Dooreteth</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mato 10:1-4</ref>; <ref loc="MRK 3:13-19">Mar 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>He gallassatappe issi gallas Yesusi woossanaas zuma bolla kezidi omars kumeth Xoossaa woossishe aqides. <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>Gadey wontishin bana kaallizayta xeygidi isttafe tammanne nam7ata doorides. Isttaka, «Hawaareta» giidi sunththides.<verse eid="LUK 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 6:14"/>Isttika Phexroosa giidi sunththida Simoonanne iza isha Indiraasa, Yaaqoobe, Yohannisa, Piliphoosa, Bartelemoosa, <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>Matoosa, Toomaasa, Ilfiyoosa naa Yaaqoobe, ba baggas mishettiza Simoona, <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>Yaaqoobe naa Yuhudanne Yesusa aaththi immida Asqoronto Yuhuda.<verse eid="LUK 6:16"/></para>
  <para style="s1">Yesusi Daro As Tamaarsidessinne Paththides</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mato 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>Yesusikka isttara issife zumaa bollafe duge wodhdhidi dembason eqqides. Iza kaallizaytappe daro asay heen dees, Yuhudappenne Yerusalaameppe, qasseka Xirooseppenne Sidoona Abba achchafe yida keehi daro asaykka heen dees. <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>Isttika yiday Yesusi gizayssa siyanaassinne hargefe paxanaassa; tuna ayanaykka waayisizayti wuri paxida. <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>Wolqqayka izappe kezidi darota paththiza gishshas asay wuri iza bochchanaas yides.<verse eid="LUK 6:19"/></para>
  <para style="s1">Anjjonne Waaye Gaasota</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mato 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>Yesusikka bana kaallizaytas, «Xoossa Kawoteththay inttes gidida gishshas intteno manqotoo! Intte anjjettidayta;<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>«Intte guyeppe kallana gishshas</para>
  <para style="q2" vid="LUK 6:21">ha7i gafizaytoo!</para>
  <para style="q2" vid="LUK 6:21">Intte anjjettidayta;</para>
  <para style="q2" vid="LUK 6:21">intte guyeppe miiccana gishshas</para>
  <para style="q2" vid="LUK 6:21">intteno ha7i yeekkizaytoo!</para>
  <para style="q2" vid="LUK 6:21">Intte anjjettidayta;<verse eid="LUK 6:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="LUK 6:22"/>asay ta gishshas inttena ixxishin</para>
  <para style="q2" vid="LUK 6:22">ba giddofe shaakkishin,</para>
  <para style="q2" vid="LUK 6:22">borishininne</para>
  <para style="q2" vid="LUK 6:22">inttena iita sunththara xeygishin</para>
  <para style="q2" vid="LUK 6:22">intte anjjettidayta;<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1Phex 4:14</ref></char></note><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>«Inttes salon gita woytoy diza gishshas he wode ufayssan guppite; ays giikko istta Aawati nabeta bolla hessaththo ooththida.<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2Taari 36:16</ref>; <ref loc="ACT 7:52">Hawa 7:52</ref></char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>«Gido attiin intteno duretoo!</para>
  <para style="q2" vid="LUK 6:24">Intte ha7i ufayettida gishshas</para>
  <para style="q2" vid="LUK 6:24">inttes aayye ana!<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>Intteno ha7i kallidaytoo!</para>
  <para style="q2" vid="LUK 6:25">Inttena aayye ana!</para>
  <para style="q2" vid="LUK 6:25">Intte guyeppe gafana;</para>
  <para style="q2" vid="LUK 6:25">intteno ha7i miiccizaytoo!</para>
  <para style="q2" vid="LUK 6:25">Inttes aayye ana!</para>
  <para style="q2" vid="LUK 6:25">Intte guyeppe</para>
  <para style="q2" vid="LUK 6:25">mishettananne yeekkana.<verse eid="LUK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26"/>«Asi wuri intte gishshas lo7o haasayza wode inttes aayye ana! Ays giikko istta aawati wordo nabetas hessa mala ooththida.<verse eid="LUK 6:26"/></para>
  <para style="s1">Morkke Siiqo Gishshas</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mato 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>«Gido attiin ta yootizayssa siyizaytoo! Tani inttes yootizay intte morkketa siiqite; inttena ixxizaytas lo7o ooththite; <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>inttena qanggizayta anjjite; inttena qohizaytas woossite; <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>Issi shagalan baqqiko nam7anththo shagalaa<note caller="+" style="f"><char style="fr" closed="false">6:29 </char><char style="fqa" closed="false">Shagala: </char><char style="ft" closed="false">Shagala geetettizayssi issi issi bagga Gamoththo qaalan qinxalle geetettees.</char></note> gujja bessa; oonikka ne bollara may7idayssa qaari ekkiko gaaththara may7idayssaka diggofa.<verse eid="LUK 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 6:30"/>«Nena woossiza ubbaas imma; ne miishshaa ekkida asi zaari immana mala oychchofa.<verse eid="LUK 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 6:31"/>«Asi inttes ooththana mala intte koyzayssaththo intteka hara asas ooththite.<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">Mato 7:12</ref></char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>«Nagaranchchatikka bana siiqizayta siiqiza gishshas intte inttena siiqizayta xalla siiqikko inttes ay dumma anjjoy dizee? <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>Intte inttes lo7o ooththizaytas xalala lo7o ooththiko inttes ay dumma anjjoy dizee? Ays giikko nagaranchchatikka hessaththo ooththeettes. <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>Tal7e ekkidi zaarana dandayeettes gizaytas xalla intte tal7iko intte hara ay dumma anjjo demmanee? Ays giikko nagaranchchatikka istti tal7idayssa sire zaaridi ekkanaas nagaranchchatas tal7eettes. <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>Gido attiin Xoossi bana galatonttaytassinne iitatas kiya gidida mala intte morkketa siiqite; lo7o ooththite; guyeppe zaari ekkanaas qoppontta dishe tal7e immite; hessankka inttes kushe zaaroy gita gidana; qasseka intte wogga Xoossaa naa gidana. <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>Intte aaway kiya gidida mala intteka kiyata gidite.<verse eid="LUK 6:36"/></para>
  <para style="s1">Hara Asa Bolla Pirdanaas Bessenna</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mato 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>«Intte harata bolla pirdofte; intte bollaka pirdettenna; intte bolla pirday darontta mala harata bolla pirda darsofte; Asas atto giite; intteska atto geetettana. <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>Immite! Intteska imettana; inttes intte makkida miishshan simmidi makettana; harappeka naaqqi baqettidi yigetti kumidi wora gukkanaashe lo7o makkiza miishshan makettidi inttes imettana» gides.<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>Qasseka Yesusi isttas leemison, «Qooqey qooqe kaaleththanaas dandayzee? Kaaleththikokka nam7ati issoy issaara oykettidi ollan gelettennee?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">Mato 15:14</ref></char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>Tamaarey bana tamaarsizaadefe aadhdhenna; gido attiin lo7eththi tamaarda asi wuri ba astamaare mala gidees.<note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">Mato 10:24-25</ref>; <ref loc="JHN 13:16">Yoha 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char></note><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>«Ne ayfe giddon diza tuussaa xeellontta dashe ne isha ayfe giddon diza buuraa ays xeellay? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>Ne ayfen diza tuussaa be7ontta ne ishaa, ‹Tani ne ayfen diza buuraa ane kessays› gaanaas wostta dandayay? Nenoo qoodheppe qommon hanizaysso koyrottada ne ayfen diza tuussaa kessa; hessafe guye ne ishaa ayfen diza buuraa kessanaas lo7eththa xeellandassa.<verse eid="LUK 6:42"/></para>
  <para style="s1">Miththi Ba Ayfen Erettees</para>
  <para style="r">(<ref loc="MAT 7:17-20">Mato 7:17-20</ref>; <ref loc="MAT 12:34-35">12:34-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>«Lo7o miththi iita ayfe ayfenna; qasseka iita miththi lo7o ayfe ayfenna. <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>Miththi wurikka ba ayfen ayfen erettees; Agunththafe Balase geetettiza miththa ayfey maxettenna; laadeppe woyne ayfey qanxxettenna.<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mato 12:33</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>Lo7o asi ba wozinaa kumida lo7o miish kessees; iita asikka ba wozina kumida iita miishshaafe iita kessees; asi wurikka ba wozina kumi palahidayssa ba doonan haasayees.<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mato 12:34</ref></char></note><verse eid="LUK 6:45"/></para>
  <para style="s1">Nam7u Qommo Keeththe Keexxiza Asata</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mato 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>«Tani gizayssa ooththeketa shin ays tana, ‹Godoo! Godoo!› geetii? <verse eid="LUK 6:46"/><verse number="47-48" style="v" sid="LUK 6:47-48"/>Taakko yiidinne ta qaala siyidi polizay wuri oona misatizaakko ta inttena bessana; keeththe keexxanaas ziqqi ooththi bookkidi shuchcha bollan ba keeth keexxida asa misatees. Haro haaththi yiidi he keeththaa sugides; gido attiin minni keexettida gishshas qaaththanaas dandaybeenna. <verse eid="LUK 6:47-48"/><verse number="49" style="v" sid="LUK 6:49"/>Gido attiin ta qaala siyidi polontta asi ba keeththe lo7eththi baasonttanne giddon shuch yeggontta keexxida asa misatees; haroykka keeththaa sugiin keeththay heerakka kundidi iita laaleth laalettides» gi yootides.<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">Yesusi Paththida Mato Halaqaza Ashkaraza</para>
  <para style="r">(<ref loc="MAT 8:13">Mato 8:13</ref>; <ref loc="JHN 4:3">Yoha 4:3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>Yesusi hessa wursika dere sinththan yooti wursidaappe guye Qifirnahoome gizaso bi gelides. <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>Heen Qifirnahoomen mato halaqay dees; he addezas izi siiqiza ashkaray hargidi hayqos shempo bolla dees. <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>Izikka Yesusa gishshas siyidi, «Ba ashkaraa paththana mala Yesusa woosseriketii!» giidi issi issi Ayhuda bagga asatappe cimata Yesusaakko yeddides. <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>Kiitettidi bida asati Yesusaakko yiidi, «Hayssa addeza gishshas ne ashkaraza paththana bessees. <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>Ays giikko hayssi addezi nu asaa daro dosees; nuuska Ayhuda Woosa Keeththe keexisiday iza» giidi minththi woossida.<verse eid="LUK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6"/>Yesusikka isttara bides. Yesusi addeza keeththaako matiza wode addezi ba laggeta Yesusaakko yeddidi, «Godoo! Ne ta keeththe gelanaas bessenna; tanikka nena ta keeththe gelththanaas bessiza as gidontta gishshas haa yashe daaburoppa. <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>Tani ne sinththan beettanaas bessontta as gidida gishshas neekko babeekke; hessa gishshas neni heen daada qaala xalla giikko ta ashkaray paxana. <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>Taaska tana azaziza asi taappe bollara dees. Taappe garsara tani azaziza wottadarati deettes. Issaa, ‹Haa ya!› giikko yees; issaa, ‹Hee ba!› giikko bees; ashkaraykka, ‹Hessa ooththa!› giikko azazettidayssa ooththees» gides.<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>Yesusikka addezi gidayssa siyidi addeza hanoteththaan malalettides; guye simmidi bana kaalliza deraas, «Ta inttes gizay hayssa mala gita ammano haray attoshin Isra7eele nayta giddonkka demmabeekke» gides.<verse eid="LUK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10"/>Yesusaakko kiitettida asati guye kiittida halaqazaso simmidi ashkarazi paxidayssa be7ida.<verse eid="LUK 7:10"/></para>
  <para style="s1">Yesusi Hayqoppe Paththida Am7ey Naaza</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>Hessafe guye Yesusi gam7ontta dishe Nayne geetettiza katama bana kaallizaytaranne daro derera issife bides. <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>Izi biidi katamaa geliza miixaa gakkishin he katamayppe daro asay aha tookki ekkidi kezi wodhdhides. Hayqqidayssi ba aayeys izi mexi issino. Aayeyska azinay baa; katamappe daro asay izira issife dees. <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>Godaykka izo be7ida wode izis mishettidi, «Aykkoy baa; yeekkofa!» gides.<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>Shiiqidi ahaa tookkida hala bochchiin ahaa tookkidayti sitti gi eqqida. Yesusikka, «Haysso naazoo nena gays denda!» gides. <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Hayqqida naazikka suuri uttidi haasaya oykkides. Yesusikka naaza aayeys efi immides.<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>Asay wurikka keehi babbidi Xoossaa galatishe, «Gita nabey nu giddofe dendides; Xoossika hayssa dereza yiidi be7ides» gides. <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>Hayssi Yesusa gishshas haasayettiza lo7o haasayay kumeththa Yuhudaninne Yuhuda yuushon diza deretan kezides.<verse eid="LUK 7:17"/></para>
  <para style="s1">Xammaqiza Yohannisappe Yesusaakko Kiitettida Asata</para>
  <para style="r">(<ref loc="MAT 11:19">Mato 11:19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>Xammaqiza Yohannisa kaallizaytikka hayssa ubbaa Yohannisas yootida. Yohannisikka istta giddofe nam7ata xeygidi, <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>«Izi yaana geetettidi haasayettizayssi neneyee? Hara as naaginoo? gi oychchite» giidi Godaakko yeddides.<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>Bida asati Yesusaakko gakkidi, «Xammaqiza Yohannisi, ‹Izi yaana geetettidi haasayettizayssi neneyee? Hara as naaginoo?› giidi neekko nuna yeddides» gida.<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>He wode Yesusi daro asaa waayeppe, hargefenne tuna ayanatappe paththides. Daro qooqeta ayfeykka xeellides. <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>Yohannisi kiittiin izakko yidayta, «Biidi intte intte ayfera be7idayssanne siyidayssa Yohannisas yootite. Ayfe qooqeti xeelleettes; toho wobbeti suure hemetteettes; inchchirachcha hargizayti paxida; tulleti siyida; hayqqidayti hayqoppe dendida; manqotas Mishiraachcho qaalay yootettees.<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isa 35:5-6</ref>; <ref loc="ISA 61:1">Isa 61:1</ref></char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>Tanan dhuphettontta asi wurikka anjjettidayssa» gides.<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>Yohannisi kiittida asati Yesusa achchafe bidaappe guye Yesusi daro asaas Yohannisa gishshas, «Intte ay beyanaas bazzo kezidetii? Carkoy yaanne haa qaaseththiza shomboqo beyanaassee? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>Ay beyanaas kezidetii? Lo7iza may7o may7ida as beyana kezidetii? Lo7o may7o may7idi warxi warxi gizayti ishalo duus dizayti kawo keeththan deettes. <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>Histtiko ay beyanaas kezidetii? Nabe beyanaassee? Ee ta inttes tuma gays; intte keziday nabeppe aadhdhizaade beyanaassa. <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/>Xoossa qaalan, ‹Ne baana oge nees baasi lo7eththana kiitettida as ta neeppe sinththara yeddana› geetettidi iza gishshas xaafettidayssi izakko.<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil 3:1</ref></char></note><verse eid="LUK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28"/>«Tani inttes gizay maccassafe yelettida asaa giddon Yohannisappe aadhdhizaadey oonikka deenna; Xoossa Kawoteththan gidikko as ubbaafe guuth geetettida asi Yohannisappe aadhdhana» gi yootides.<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>Qaraxa qanxxisizaytikka attontta hayssa Yesusa qaala siyidayti wurikka Yohannisa kushen xammaqettidi Xoossas bessiza bonchcho immida.<note caller="-" style="x"><char style="xo" closed="false">7:29-30 </char><char style="xt" closed="false"><ref loc="MAT 21:32">Mato 21:32</ref>; <ref loc="LUK 3:12">Luqa 3:12</ref></char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>Farsaawetinne Muse wogaa eranchchati Yohannisa kushen xammaqettontta gishshas Xoossi isttas waanna qofa ooththidi shiishshidayssa hirayssida.<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>Qasseka Yesusi zaaridi, «Histtiko ha7i yeletaa aazan leemisoo? Istti ay misatizoo? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>Giyan uttidi ba giddon issoy issaara xeygettidi, ‹Inttes nuni diith diixxidos shin duribeekketa; zilas zilalidos shin yeekkibeekketa giza nayta misateettes› gides. <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>Ays giikko Xammaqiza Yohannisi kath monttanne woyneppe oosettida cajje uyontta yiin, ‹Daydanththi iza bolla dees› gideta. <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>Asa nay qasse mishenne uyishe yiin, ‹Ganjamanne ushshanchcha, qaraxa shiishshizaytaranne nagaranchchatara laggetees› gideta. <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>Hessa gishshas erateththa tumateththay izi nayta ubbata achchan ammanettides» gides.<verse eid="LUK 7:35"/></para>
  <para style="s1">Yesusa Toho Shitto Tiyda Maccassayo</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>Hessafe guye Farsaawetappe issi asi quma maanaas Yesusa baso xeygiin Yesusi xeygida Farsaawezaso bi uttides. <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>He kataman diza issi nagaranchcha maccas dizaara Yesusi Farsaaweza keeththan quma maadda bollan dizayssa siyada issi albasxiroose bilqaaxe shitto ekka yadus. <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>Histtada Yesusappe guyera iza toho achchan eqqada yeekkashenne ba afunththan iza toho caphisada ba hu7e binanara quccashenne yeerashe shittoza tiyadus. <verse eid="LUK 7:38"/><verse number="39" style="v" sid="LUK 7:39"/>Yesusa qumas xeyssida Farsaaweykka hessa be7idi, «Hayssi addezi nabe gididaakko hanna iza bochchida maccassaya iza oonakkonne ay ooththiza asakko eranakkoshin; iza nagaranchchako shin» giidi ba wozinan qoppides.<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>Yesusi, «Simoona! Nees ta yootanaazi dees» gides. Simoonikka, «Astamaaree! Ero yoota» gides.<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>Yesusi zaaridi, «Issi miishshe tal7e immizaadefe tal7e ekkida nam7u asati deettes; isttafe issaa bolla ichchashu xeet dinaarey dees; nam7anththoza bolla ichchashu tammu dinaarey<note caller="+" style="f"><char style="fr" closed="false">7:41 </char><char style="fqa" closed="false">Dinaare: </char><char style="ft" closed="false">Dinaarey he wode issi oosanchchas issi gallassa damoza.</char></note> dees. <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>Isttas qanxxiza miishshi dhayiin tal7e immidayssi nam7ata acoza ubbaaka maarides; histtiko ha nam7atappe ha tal7e immidayssa darssi dosanay awayssee?» gides.<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>Simoonikka zaaridi, «Daro acoy maarettidayssa gaada qoppays» gides. Yesusikka, «Tumu pirdadasa» gides.<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>He maccassayko yuuyidi Simoona, «Hanno maccassayo xeellay? Ta ne keeththe geliin ne ta tohos haaththe shiishshabeekka; iza gidikko ta toho ba afunththan caphisada ba hu7e binanara quccadus. <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>Neni ubbaaka tana yeerabeekka; iza gidikko ta geloosoppe doommada ta toho yeero aggabeekku. <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>Ne ta hu7e zayte tiyabeekka shin iza gidikko ta toho shitto tiyadus.<verse eid="LUK 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 7:47"/>«Hessa gishshas ta nena gizay iza tana keeha dosida gishshas iza ba daro nagarappe maarettadus; guuththara maarettiza asa siiqoykka guuththa» gides.<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>Yesusi maccassayo, «Ne nagarappe maarettadasa» gides.<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>Izara issife maaddan uttida imaththatikka, «Hayssi nagara maarizay izi oonee?» giidi ba wozinara qoppida. <verse eid="LUK 7:49"/><verse number="50" style="v" sid="LUK 7:50"/>Yesusikka maccassayo, «Nena ne ammanoy ashshides; saron ba!» gides.<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">Yesusa Kaallidaytanne Izas Ooththida Maccassata</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>Hessafe guye Yesusi Xoossa Kawoteththa Mishiraachcho sabbakishe dumma dumma katamata giddoranne gutata giddora aadhdhides. Aadhdhi biza wode iza kaalliza tammanne nam7ati izara deettes. <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>Qasseka tuna ayanappenne iita hargefe paxida issi issi maccassati izara deettes. Isttika laappun tuna ayanay izippe kezida Magdale geetettiza dereppe yida Maaramo, <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>Kawo Herdoosason ooththiza Kuza machcho Yohaano qasseka Soosinonne hara daro maccassati deettes; isttika banttas diza miishshara Yesusas ooththizayta.<verse eid="LUK 8:3"/></para>
  <para style="s1">Kath Zerizaade Leemiso</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mato 13:1-9</ref>; <ref loc="MRK 4:1-9">Mar 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>Daro derey issife shiiqi dishin qasseka asay dumma dumma katamappe izakko wodhdhiza wode Yesusi leemisora tamaarsishe,<verse eid="LUK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5"/>«Issi goshshanchchay zereth zeranaas kezides; izi zerishin baggay ogen wodhdhidi asa tohon yedhettides; salo kafotikka yiidi maxi mida; <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>Issi zereththay shuchcha gaden wodhdhidi heerakka caarides; gadezikka mela gade gidida gishshas elle melides. <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>Qasseka hara zereththi agunththa giddon wodhdhides; agunththayka izara issife diccidi caarechchayka diccontta mala cuullides. <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>Qasseka hara zereththay aradda gaden wodhdhides; caaridi xeetu kushe ayfides» gides.</para>
  <para style="s1" vid="LUK 8:8">Yesusi Leemison Haasayda Gaaso</para>
  <para style="r" vid="LUK 8:8">(<ref loc="MAT 13:10-17">Mato 13:10-17</ref>; <ref loc="MRK 4:10-12">Mar 4:10-12</ref>)</para>
  <para style="p" vid="LUK 8:8">Yesusi haasayaa wursidaappe guye qaala dhoqqu histtidi, «Siyiza hayththi diza asi siyo!» gides.<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>Yesusa kaallizayti, «Zereththaa leemisozas birsheth imma» giidi oychchiin, <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>izikka isttas, «Xoossa Kawoteththaa xuura eroy inttes imettides; haratas gidikko leemisora yootays qasseka harati be7idi wozinan woththontta malanne siyidi yuushshi qoppontta mala hanides.<verse eid="LUK 8:10"/></para>
  <para style="s1">Yesusi Birshida Zereththa Leemiso</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mato 13:18-23</ref>; <ref loc="MRK 4:13-20">Mar 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>«Zereththaza leemisoykka hayssa; zereth geetettidayssi Xoossa qaala. <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>Oge lanqen wodhdhidayssi qaala siyizayta; gido attiin istti ammanidi attontta mala Xala7ey yiidi qaalaa istta wozinappe ekkichchizayta. <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>Shuchcha bolla wodhdhidaytikka qaala siyidi ufayssara ekkizayta; isttika ha7is ammaneettes attiin metoy istta bolla gakkiza wode xapho yeddontta gishshas ellera ammano kaddizayta. <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>Agunththa giddon wodhdhidayti qaalaa siyizayta; heytikka hayssa ha alame qofaninne aqotan, ha biittaa bolla duussa lo7eteththan cuulettidi lo7eththi ayfe imettenna. <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>Aradda biittan wodhdhidayssi qaalaa suureninne lo7o wozinan siyidi naagizaytanne dandayan minnidi ayfe ayfizayta.<verse eid="LUK 8:15"/></para>
  <para style="s1">Qoncceson Diza Xomppe</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mar 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>«Poo7o poo7isidi baaththa giddon woykko arsa garsan woththiza asi deenna; gido attiin keeththe geliza asas poo7ana mala qoncceson woththeettes.<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mato 5:15</ref>; <ref loc="LUK 11:33">Luqa 11:33</ref></char></note> <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/>Qotettidi qoncce kezonttay, poo7on kezidi erettontta geeman attana miishshi deenna.<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mato 10:26</ref>; <ref loc="LUK 12:2">Luqa 12:2</ref></char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>«Hessa gishshas intte siyizayssa naagetti siyite; diza asas gujettana; bayndaades ubbaafe izas dizaa misatizaarakka ekettaychchana» gi zaarides.<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mato 25:29</ref>; <ref loc="LUK 19:26">Luqa 19:26</ref></char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">Yesusanne Iza Ishata</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mato 12:46-50</ref>; <ref loc="MRK 3:31-35">Mar 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>Hessafe guye Yesusa aayanne iza ishati Yesusaakko yida; gido attiin asaa daroteththafe dendidayssan izakko shiiqanaas dandaybeettenna. <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>He wode asay Yesusas, «Ne aayeyanne ne ishati nena beyanaas koyidi karen eqqida» giidi yootida.<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>Yesusikka zaaridi, «Ta aayanne ta ishati Xoossa qaala siyidi naagizayta» gides.<verse eid="LUK 8:21"/></para>
  <para style="s1">Yesusi Abba Dambalaza Seerides</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mato 8:23-27</ref>; <ref loc="MRK 4:35-41">Mar 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>Issi gallas Yesusi bana kaallizaytara wogolo giddo gelidi, «Abbaafe he pinth pinnoos» gides. <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>Isttika pinnishin abbaa bolla dambalay dendidi waayisiza wode Yesusi dhiskides; haaththika wogoloza giddo geliin asay daro metotettides. <verse eid="LUK 8:23"/><verse number="24" style="v" sid="LUK 8:24"/>Yesusa kaallizayti izakko shiiqidi, «Godoo! Godoo! Nu wurana hanoos» giidi Yesusa dhiskofe denththida.</para>
  <para style="p" vid="LUK 8:24">Izikka beeggidi carkozanne abba dambalaa seeriin carkoynne abbaa dambalay co7u gides. <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>Izikka bana kaallizayta, «Intte ammanoy awa bidee?» gides; isttika ba giddon babbishenne malalettishe, «Carkonne haaththe azazizay; isttika izas azazettizay izi oonee?» gida.<verse eid="LUK 8:25"/></para>
  <para style="s1">Daydanththi Oykkiin Yesusi Paththida Addeza</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mato 8:28-34</ref>; <ref loc="MRK 5:1-20">Mar 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>Izappe guye Galilappe he pinththan diza Gergesenoone geetettiza dere wogolora pinnida. <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>Yesusi wogolozappe gaden wodhdhiin daydanththi iza bolla diza issaadey katamappe kezidi iza demmides; he addezi daro wode may7o may7ontta kallo dizaadenne keeththan aqontta duufo baas aqoso ooththida asa. <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>Yesusa be7ida wode waassishe Yesusa sinththan kundides; qaalaa dhoqqu histtidi, «Bonchcho Xoossaa Naa Yesusaa! Taassinne nees ay gaytoteththi dizee? Ne tana waayisontta mala ta nena woossays» gides. <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>Tuna ayanay hessa gaanaas dandayday addezappe kezana mala Yesusi azazida gishshassa. Tuna ayanazikka woden woden dendiza gishshas addezi sansalataninne biratan toho qachchi naagiinkka qashettida sansalataa duusereththidi iza bolla diza daydanththay iza duge bazzo zaari efees.<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>Yesusi, «Ne sunththi oonee?» giidi oychchides; izikka daro daydanththati izan gelidi diza gishshas ta sunththi, «Leegoone» gides. <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>Daydanththatikka bana wurseththi baynda ciimma ollan yeggontta mala minththidi woossida.<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>Heenkka zuma bolla daro guddunththi heemettees; daydanththati, «Guddunththa wudezan gelite» giidi azazana mala woossiin Yesusi, «Ero gelite!» gides. <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>Daydanththati addezappe kezidi guddunththatan gelida. Guddunththati aafoza dugunththaara bichcharishe biidi abbaan geli mitettida.<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>Heemmizayti hanidayssa be7ida wode beerotti biidi katama asaassinne dere asaas yootida. <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>Hanidayssa beyana giidi asay ba dizasoppe Yesusaakko yides; daydanththay izappe kezida addezikka kahay simmiin afala may7idi Yesusa toho giddon uttidayssa be7idi babbida. <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>Daydanththan oykettida addezi paxishin be7idayti izi waani paxidaakko derezas yootida. <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>Gergesenoone matan diza asay keehi babbida gishshas Yesusa, «Hayssafe kichcha!» giidi woossida; izikka wogolozan gelidi simmi bides.<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>Daydanththay izappe kezida addezi Yesusara issife daana mala woossides. <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>Gido attiin Yesusi iza, «Neso simmada Xoossi nees ooththida gita miish ubbaa yoota» giidi moyzides; addezikka Yesusi izas ooththida gita miish ba kataman diza asaas ubbaas qonccen yootishe bides.<verse eid="LUK 8:39"/></para>
  <para style="s1">Iya7iroosa Nayonne Yesusa May7o Bochchida Maccassayo</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mato 9:18-26</ref>; <ref loc="MRK 5:21-43">Mar 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>Asay wuri Yesusa yuussaa naagishe gam7ida gishshas izi simmishin ufayssan mokki ekkides. <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>He wode Iya7iroosa geetettiza Ayhuda Woosa Keeththa halaqay yiidi Yesusa toho bolla kundidi baso baana mala woossides. <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>Izi hessaththo oychchiday izas tammanne nam7u layth kumida issi macca nay sakettada shempo bolla diza gishshassa.</para>
  <para style="p" vid="LUK 8:42">Izi hee buussan dishin derey daridi ba giddon sugettidi iza keehi un7isides. <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>Tammanne nam7u layth suuththi izippe gukkishin diza issi maccassaya baas diza miishshaa wursa dhale eriza asatas imma wursiin izo paththanaas dandayda asi issaadeyka deenna. <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>Izakka guyera shiiqada Yesusa afala macarata bochchadus; izippe gukkiza suuththay heerakka eqqi aggides.<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>Yesusikka, «Tana bochchiday oonee?» gides. Wurikka nuni bochchibeekko gi kaddida wode Phexroosi zaaridi, «Godoo! Asi wuri yuuyi aadhdhidi nena sugereththidi un7isees» gides.<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>Gido attiin Yesusi, «Asi tana bochchides; wolqqay taappe kezidayssa ta erays» gides.<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>Maccassaya erettontta qotettada baanaas dandayonttayssa erada kokkorashe yaada Yesusa sinththan kundadus; izakka Yesusa waana bochchidaakkonne qasseka ellera waana paxidaakko ubba asaa sinththan yootadus. <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>Izikka, «Ta nayee! Ne ammanoy nena paththides; saron ba!» gides.<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>Yesusi buro maccassays haasaya bolla dishin Ayhuda Woosa Keeththa halaqa Iya7iroosa keeththafe issi asi Iya7iroosas, «Ne naya hayqqadus; hessa gishshas hayssafe guye astamaareza mela daabursofa!» gides.<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>Yesusi hessa siyidi Iya7iroosa, «Aykkoy baa; babbofa! Ammana attiin ne naya paxana» gides.<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>Yesusi Iya7iroosa keeththe geliza wode Phexroosa, Yohannisanne Yaaqoobe qasseka nayi aawappenne aayppe attiin haray oonikka izara gelana mala koyibeenna. <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>He wode asay wuri nays, «Wu! Wuy» gi waassi yeekkishin Yesusi, «Yeekkofte; iza ichchadus attiin hayqqabeekku» gides.<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>Asaykka naya hayqqidayssa eriza gishshas Yesusa bolla miiccides. <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>Gido attiin nayi kushe izi oykkidi, «Ta nayee! Denda!» gides. <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>Nays shemppoyka simmides; heerakka denda eqqadus; Yesusikka izis miza miish immana mala azazides. <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>Nayo yelidaytikka malalettida; gido attiin izi hanidayssa oonaska yootontta mala azazides.<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">Mishiraachcho Qaala Yootana Mala Yesusi Kiittida Hawaareta</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mato 10:5-15</ref>; <ref loc="MRK 6:7-13">Mar 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>Yesusikka tammanne nam7u Hawaareta issife xeygidi daydanththata kessana malanne hargefe paththana mala isttas wolqqanne godateth immides. <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>Qasseka Xoossa Kawoteth yootanaassinne hargizayta paththanaas istta kiittides. <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>Isttas, «Oge bishe guufe woykko, qaraxiite woykko, quma woykko, miishshe woykko nam7u may7o oykki baanaas koshshenna.<note caller="-" style="x"><char style="xo" closed="false">9:3-5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luqa 10:4-11</ref></char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>Intteka he katamayppe kezana gakkanaas koyro gelida oona keeththankka gidiin heen gam7ite. <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>Katamaa asay inttena mokki ekkontta ixxiko he katamayppe kezidi inttena mokkonttaytas markka gidana mala intte tohon diza gudulla pittidi kezite» gides.<verse eid="LUK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6"/>Isttika Goday gida mala kezidi Mishiraachcho qaalaa yootishenne harganchchata paththishe gutan gutan yuuyida.<verse eid="LUK 9:6"/></para>
  <para style="s1">Herdoosi Siyida Yesusa Wore</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mato 14:1-12</ref>; <ref loc="MRK 6:14-29">Mar 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7-8" style="v" sid="LUK 9:7-8"/>He wode issi issi asati, «Yohannisi hayqoppe dendides» baggayti, «Eelaasi kezidi beettides» Qasse baggayti, «Beni nabetappe issoy hayqoppe dendides» giidi haasayettiza gishshas Yuhuda biittaa haariza Herdoosi hessa siyidi haniza miishshaan ba wozinan metotettides. <verse eid="LUK 9:7-8"/><verse number="9" style="v" sid="LUK 9:9"/>Herdoosikka, «Tani iza qoodhe qanxxida xammaqiza Yohannisi hayqqides. Histtiin iza gishshas hayssa mala haasayettishin ta siyizayssi izi oonee?» giidi iza ba ayfera beyana koyides.<verse eid="LUK 9:9"/></para>
  <para style="s1">Yesusi Mizida Ichchashu Shii Asaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mato 14:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>Hawaaretikka simmidi istti ooththidayssa ubbaa Yesusas yootida; izikka istta xalla banara ekkidi Betesayda geetettiza poossan diza katama bides. <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>Gido attiin daro asay hessa eridi istta kaallides; izikka istta mokki ekkidi Xoossa Kawoteththa gishshas yootides; qasseka hargefe paththanaas bessizayta paththides.<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>Gadey lem7ishin tammanne nam7u Hawaareti izakko shiiqidi, «Nuni dizay bazzo biittan gidida gishshas asay biidi baas aqanasonne miza miish koyana mala asaa moyza» gida.<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>Gido attiin izi isttas zaaridi, «Intte isttas mizaaz immite» gides. Isttika, «Nuus ichchashu ukeththafenne nam7u moleppe haray baa; ha asaas gidiza kath koshshiko shammanaas bessees» gida. <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>Yesusikka bana kaallizayta, «Asaa ichchashu tammu, ichchashu tammu histti shaakki shaakki utisite» gides. Heenkka ichchashu shii gidiza attumasay dees. <verse eid="LUK 9:14"/><verse number="15" style="v" sid="LUK 9:15"/>Yesusa kaallizaytikka Yesusi azazida mala asaa ubbaa utisida. <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>Yesusikka ichchashu ukeththaanne nam7u moleta oykki pude salo xeellidi Xoossaa galatides; izikka ukeththaa menththidi asaa gaththana mala bana kaallizaytas immides. <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>Asay wurikka miidi kaallides. Yesusa kaallizaytikka asaappe attida tammanne nam7u leemate kumeth maaddaafe denththida.<verse eid="LUK 9:17"/></para>
  <para style="s1">Phexroosa Ammanonne Iza Markkateth</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mato 16:13-19</ref>; <ref loc="MRK 8:27-29">Mar 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>Issi gallas Yesusi barkka woossishin iza kaallizayti izakko yida. Izikka istta, «Asay tana oona gizee?» giidi oychchides.<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>Isttika izas, «Issi issi asay Xammaqiza Yohannisa; baggayti Eelaasa; harati qasse beni nabetappe issoy hayqoppe dendides geettes» gida.<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>Izikka istta, «Inttech tana oona geetii?» giidi oychchides. Phexroosikka, «Neni Xoossafe kiitettida Kirstoosa» giidi zaarides.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">Yoha 6:68-69</ref></char></note><verse eid="LUK 9:20"/></para>
  <para style="s1">Yesusa Kaaloy Qanxxisiza Waaga</para>
  <para style="r">(<ref loc="MAT 10:38-39">Mato 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="MRK 8:34-38">Mar 8:34-38</ref>; <ref loc="LUK 14:25-27">Luqa 14:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>Yesusikka istta, «Hayssa oonaska yootopite» giidi minththi yootidi <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>qasseka, «Asa Nay daro waaye ekkanaas bessees; dere cimatan, qeese halaqataninne Muse wogaa xaafizaytan ixettana, istta kushen hayqqananne heedzdzanththo gallassan hayqoppe dendana» gides.<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23-24" style="v" sid="LUK 9:23-24"/>Qasseka ubbaas, «Ba shempo ashshana giza asi wuri dhayssana shin ba shempo ta gishshas giidi dhayssiza asi ashshana. Hessa gishshas tana kaallana koyza asi diikko bana kaddo; ubba gallas ba masqale tookkidi tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">9:23-24 </char><char style="xt" closed="false"><ref loc="MAT 10:38-39">Mato 10:38-39</ref>; <ref loc="LUK 14:27">Luqa 14:27</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref></char></note> <verse eid="LUK 9:23-24"/><verse number="25" style="v" sid="LUK 9:25"/>Asi alame go7a mule demmidi ba shempo dhayssiko aaza go7ay dizee? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>Oonikka tananinne ta qaalan yeellatiko Asa Nay ba bonchchora, Aawaa bonchchoranne Geeshsha kiitanchchata bonchchora yiza wode tani izan yeellatana. <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>Ta inttes tumu gays; hayssan eqqida asaappe hayqqanaappe sinththan Xoossa Kawoteth beyana issi issi asati deettes» gides.<verse eid="LUK 9:27"/></para>
  <para style="s1">Yesusa Medho Laameteth</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mato 17:1-8</ref>; <ref loc="MRK 9:2-8">Mar 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>Yesusi hessa gida osppun gallassa malappe guye woossanaas zuma bolla kezides; bishe banara Phexroosa, Yohannisanne Yaaqoobe ekki bides. <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>Izi woossishin iza ayfesoy laamettides. Iza medhaykka wolqqanththa mala xolqidi boottides. <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>Nam7u asati Museynne Eelaasi izara haasayettida <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>Isttika bonchchora qonccidi Yerusalaamen polettana diza Yesusa hayqo gishshas haasayettida. <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>Phexroosanne izara dizayta deexo dhiskoy oykkides; isttika dhiskofe beeggidi Yesusa bonchchonne nam7u asi izara eqqidayta be7ida. <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>He nam7u asati Yesusappe shaaketti bishin Phexroosi Yesusa, «Godoo! Issi daase nees, issi daase Muses, issi daase Eelaasas ooththidi haan dizaakko nuus lo7okkoshin» gides; gido attiin Phexroosi ba gizayssa erontta gides.<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>Izi hessa haasayshin shaaray yiidi istta genththides. Shaara giddo gelidi babbida. <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>Shaaraa giddofekka, «Tani doorida ta nay hayssa; iza siyite» giza qaalay seetettides.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Mato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref></char></note><verse eid="LUK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36"/>Qaalay seetettida wode Yesusi xalla beettides. Yesusa kaallizaytikka hanida miish ubbaa ba wozinan oykkida attiin oonaska yootibeettenna.<verse eid="LUK 9:36"/></para>
  <para style="s1">Yesusi Iita Ayanappe Paththida Naaza</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mato 17:14-18</ref>; <ref loc="MRK 9:14-27">Mar 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>Wonteththa gallas istti zuma bollafe wodhdhiin daro asay yiidi Yesusara gaaggides. <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>He wode asaa giddofe issaadey qaala dhoqqu histtidi «Tamaarsizayssoo! Taas issi nay xalla diza gishshas iza ne xeellana mala ta nena woossays. <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>Iza iita ayanay oykkishin hassa7ay baynda waassees; qakettishe doonara goppontto kessees; qoho gaththidaappe guye daro waayisidi aggees. <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>Nena kaallizayti naazappe kessana mala istta ta woossadis; gido attiin kessana dandaybeettenna» gides.<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>Yesusikka isttas zaaridi, «Ammanontta ha wode wobbe asatoo! Tani inttenara ayde gakkanaas daanee? Inttenakka ayde gakkanaas dandayanee? Naaza ane haa eha!» gides.<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>Naazi yishin iita ayanay iza bollafe yeggiin qakettides. Yesusikka iita ayanaza seeridi naaza paththidi naaza aawaas immides. <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>Asaykka wuri Xoossa gitateththan malalettides.</para>
  <para style="s1" vid="LUK 9:43">Yesusi Ba Hayqo Gishshas Nam7anththo Yootides</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Mato 17:22-23</ref>; <ref loc="MRK 9:30-32">Mar 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Izi ooththidayssan asay wuri malalettishin Yesusi bana kaallizayta, <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>«Asa nay asa kushen aadhdhi imettana; intteka ha yo7oza balopite» gides.<verse eid="LUK 9:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 9:45"/>Gido attiin izi gizayssi isttas gelibeenna. Gaasoykka istti akeekontta mala yo7ozi isttafe geemettides; zaaridikka oychchontta mala babbida.<verse eid="LUK 9:45"/></para>
  <para style="s1">Ubbaafe Aadhdhizay Oonee?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mato 18:1-5</ref>; <ref loc="MRK 9:33-37">Mar 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>Iza kaallizayti, «Ooni oonappe aadhdhizee?» giidi ba giddon palamettida.<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa 22:24</ref></char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>Yesusikka istta wozina qofaa eridi guuththa naa ekki yiidi ba matan essidi, <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>«Ha guuththa naaza ta sunththan ekkizaadey oonikka diikko tana ekkees; tana ekkizaadeyka tana kiittidayssa ekkees; inttefe ubbatappe guuxxizaadey izi ubbaafe aadhdhees» gides.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mato 10:40</ref>; <ref loc="LUK 10:16">Luqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref></char></note><verse eid="LUK 9:48"/></para>
  <para style="s1">Intte Gizayssa Ixxonttay Intte Bagga</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mar 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>Yohannisikka, «Godoo! Issi asi ne sunththan daydanth kessishin nu beydos; gido attiin izi nunara kaallontta gishshas nu iza digganaas koyidos» gides.<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>Yesusikka, «Inttena ixxontta asi wuri intte bagga gidida gishshas diggofte» gides.<verse eid="LUK 9:50"/></para>
  <para style="s1">Samaariya Asay Yesusa Mokkanaas Koyibeenna</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>Yesusi salo biza wodey matida gishshas Yerusalaame baanaas dendides. <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>Izikka sinththasidi ase kiittides; isttika koshshiza miish giigsanaappe kasetidi Samaariya biittan diza issi guta bida. <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>Gido attiin derey izi Yerusalaame bizayssa erida gishshas mokki ekkibeenna. <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>Iza kaallizaytappe Yaaqoobeynne Yohannisi hanizayssa be7idi, «Godoo! Eelaasi ooththoyssaththo, ‹Tamay saloppe wodhdhidi istta dippi histto!› giidi azazana mala koyay?» gida.<note caller="+" style="f"><char style="fr" closed="false">9:54 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati, «Elyaasi ooththoyssa mala» giza qaala gujjeettes.</char></note><note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2Kawo 1:9-16</ref></char></note><verse eid="LUK 9:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55"/>Gido attiin Yesusi isttako yuuyidi, «Inttes ay mala ayanay dizaakko erekketii? Asa Nay yiday asa shempo ashshanaas attiin dhayssanaas gidenna» giidi istta seerides. <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>Istti wurikka hara guta bida.<verse eid="LUK 9:56"/></para>
  <para style="s1">Yesusa Kaallizayta Gakkiza Paace</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mato 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>Isttika bishin issi asi isttako shiiqidi, «Neni biza ubbaso ta nena kaallana» gides.<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>Yesusi, «Worakanatas aqiza ollay, kafotas qasse aqiza kafo keeththi dees; gido attiin asa naas ba hu7e ayssizasoykka baa» gides.<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>Yesusikka hinkoyssa, «Tana kaalla» gides. He addezikka «Godoo! Ta kaseta baada ta aawa moogoo?» gides.<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>Yesusikka, «Aggaaga, hayqqidayti hayqqidayta moogetto. Neni gidikko baada Xoossa Kawoteththaa asaas yoota» gides.<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>Qasseka hara asi, «Godoo! Ta nena kaallana shin koyro soo baada ta keeththa asaa saro gaada yoo?» gides.<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1Kawo 19:20</ref></char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>Gido attiin Yesusi, «Boora kaso oykkidi goyishe guye zaari xeellizaadey oonikka Xoossa Kawoteththas bessenna» gides.<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">Yesusi Kiittida Laappun Tammanne Nam7ata</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>Hessafe guye Goday hara laappun tammanne nam7u<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">Laappun tammanne nam7ata issi issi Geeshsha Maxaafata birsheththan «Laappun tamma» geettes.</char></note> as dooridi sunththides; isttaka nam7u nam7u histtidi izi baana sohotanne katamata wursika istti kasetidi baana mala kiittides. <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>«Maxa gakkida kaththay daro; kaththaa maxi shiishshizayti guuththata; hessa gishshas kaththaa Goday kaththaa maxidi shiishshizayta kaththay dizaso yeddana mala woossite.<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">Mato 9:37-38</ref></char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>Hessa gishshas biite; dorsati kana suyte giddora biza mala ta inttena yeddays.<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">Mato 10:16</ref></char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>Korojo woykko qaraxiite woykko caamma ekkofte; oge bolla oonakka saro goopite.<note caller="-" style="x"><char style="xo" closed="false">10:4-11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Mato 10:7-14</ref>; <ref loc="MRK 6:8-11">Mar 6:8-11</ref>; <ref loc="LUK 9:3-5">Luqa 9:3-5</ref></char></note><verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>«Intte oona keeththika gelizaa gidikko koyrottidi, ‹Keeththa aso saro!› giite. <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>He keeththan saro dosiza asi diikko intte sarotay he keeththaan shempana; saro dosiza asi dontta aggiko intte sarotay inttes simmana. <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>Inttes maana shiishshida kath ubbaa mishenne uyishe he intte gelida keeththaan uttite; ooththizaades ba wolqqa waaga ekkanaas izas bessees; ha keeththaafe he keeththe yuuyopite.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1Qoro 9:14</ref>; <ref loc="1TI 5:18">1Xim 5:18</ref></char></note><verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>«Intte ay katamakka gakkiza wode asay inttena mokki ekkiko istti inttes aaththida qumaa miite. <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>He kataman diza harganchchata paththidi, ‹Xoossa Kawoteththi intteko matides› giidi yootite. <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>Gido attiin intte biidi issi katama gelishin he katamaa asay inttena mokki ekkontta ixxiko he katama asay shiiqiza dubbushaa kezidi, <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‹Nu toho bolla diza intte katamaa gudullaa inttes markka gidana mala nu toho bollafe pittoos; gido attiin Xoossa Kawoteththay intteko matidayssa erite› giite. <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>Ta inttes yootays pirda gallas he katama pirdafe Sodoome katama pirday kawushshe gidana.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Medhe 19:24-28</ref>; <ref loc="MAT 10:15">Mato 10:15</ref>; <ref loc="MAT 11:24">11:24</ref></char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">Ammanontta Ixxida Gishshas Walassettida Katamata</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mato 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>«Kuraziine nees aayye ana! Betesayda nees aayye ana! Inttenan oosettida malaatati Xirooseninne Sidoonan oosettidaakko isttika maaqa may7idinne bidinth gorpettidi he wode beni maarettanashin.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Hizi 26:1—28:26</ref>; <ref loc="JOL 3:4-8">Iyu 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zaka 9:2-4</ref></char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>Gido attiin pirda wode inttefe Xiroosessinne Sidoonas kawuyana. <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>Hanne Qifirnahoome pude salo dhoqqu dhoqqu gadii? Neni duge Si7oole wodhdhana,<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isa 14:13-15</ref></char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>«Intte gizayssa siyiza asi tana siyees; inttena ekkontta asi tanakka ekkenna; tana ekkonttaykka tana kiittidayssa ekkenna» gides.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mato 10:40</ref>; <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luqa 9:48</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref></char></note><verse eid="LUK 10:16"/></para>
  <para style="s1">Yesusi Kiittida Laappun Tammanne Nam7ati Bidasoppe Simmida</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>Laappun tammanne nam7atikka ufayettishe simmidi, «Godoo! Haray attoshin daydanththatikka ne sunththan nuus haarettida» gi yootida.<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>Izikka isttas, «Xala7ey wolqqanththa mala saloppe kundishin ta beyadis.<verse eid="LUK 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 10:19"/>«Histtiko shooshshinne masimaso intte yedhdhana mala morkke wolqqa ubbaa bolla inttes godateth ta immadis; inttena qohiza issi miishshika deenna.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 91:13">Maza 91:13</ref></char></note><figure style="fig" alt="Scorpion" file="BK00058B.TIF" size="span" ref="10:19">Masmaso</figure> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>Intte sunththay salon xaafettida gishshas ufayettite attiin tuna ayanati inttes haarettida gishshas ufayettofte» gides.<verse eid="LUK 10:20"/></para>
  <para style="s1">Yesusi Ba Ufayssaa Qoncciseth</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mato 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>He wode Yesusi Xillo Ayanan ufayettidi, «Salossinne sa7as Godaa gidida Aabboo! Hayssa wursaka aadho eranchchatappenne eranchchatappe qottada qeeri guuththa naytas ne qonccisida gishshas tani nena galatays; ee, ta Aawawu! Hayssi ne lo7o sheney hanides.<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>«Wuri ta Aawaa matappe taas imettides; qasseka iza nay oonakko Aawappe attiin erizay baa; Aaway oonakko Naazappe attiin woykko Naazi izas qonccisanaas dosidaadefe attiin erizaadey baa» gides.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yoha 3:35</ref>; <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>Bana kaallizaytakko simmidi isttas dumma, «Intte be7izayssa be7iza ayfeti anjjettidayta. <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>Ta inttes tuma gays; daro nabetinne kawoti intte ha7i be7izayssa beyanaas koyidi beyibeettenna; intte ha7i siyizayssaka siyanaas koyidi siyibeettenna» gides.<verse eid="LUK 10:24"/></para>
  <para style="s1">Asas Qadhettiza Samaariya Addeza</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>Issi gallas Muse wogaa tamaarsiza issi asi Yesusa paaccanaas koyidi, «Tamaarsizayssoo! Tani mernaa de7o laattanaas ay ooththoo?» giidi oychchides.<note caller="-" style="x"><char style="xo" closed="false">10:25-28 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">Mato 22:35-40</ref>; <ref loc="MRK 12:28-34">Mar 12:28-34</ref></char></note><verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>Yesusikka zaaridi, «Woga maxaafan ay geetetti xaafettidee? Izappe nees geliday aazee?» giidi oychchides.<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>Addezi zaaridi, «Ne Godaa Xoossaa ne kumeththa wozinappe, ne kumeththa shemppofe, ne kumeththa wolqqafenne ne kumeththa qofappe siiqa; ne laggeka ne hu7e mala siiqa gees» giidi zaarides.<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Zaare 6:5</ref>; <ref loc="LEV 19:18">Lewe 19:18</ref></char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>Yesusikka, «Lo7o zaaradasa. Nenikka hessaththo ooththiko mernaa de7o demmana» gides.<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lewe 18:5</ref></char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>Addezi bana xillisanaas koyidi, «Histtiin ta laggey oonee?» giidi Yesusa oychchides.<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>Yesusikka zaaridi, «Issi addezi Yerusalaameppe Iyarkko wodhdhishin pangati demmidi iza may7o qaari ekkida; keehi qoxereththidi hayqoppenne paxappe giddon yeggi aggidi bida. <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>Issi qeesey he ogera baas duge wodhdhishe aamunsontta he qoxettida addeza demmidi pooqeththara yeggi aadhdhides. <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>Qasseka issi Lewe bagga asappe issi addezi he ogera aadhdhishe qoxettida addeza be7idi ha7ikka pooqqidi aadhdhides. <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>Issi Samaariya biitta asi he ogera aadhdhi bishe qoxettida addeza bolla gakki wodhdhides; Addeza be7idi keehi mishettides. <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>Addezakko shiiqidi madunththaa dhallana mala wogara miththa zaytenne woyne cajje madunththaa bolla gussidi qachchides; addeza ba Hare togisidi imaththi shempizaso efidi lo7eththi xeellides. <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>Wonteththa gallas imaththi shempiza keeththa godaas nam7u dinaare immidi, ‹Nena hara miish kessisiko ta simmashe nees immana; neeppe kessada lo7eththa naaga› gides.<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>«Histtiko ha heedzdzu asatappe pangatan qoxettidi hayqoppenne paxappe giddon yegettidaades keehi mata laggey nees awayssa misatizee?» gides.<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>Muse wogaa tamaarsizayssika, «Hessi izas ne mishettidayssanne maaddidayssa!» gides. Yesusikka izas, «Nekka baada izayssaththo ooththa» gides.<verse eid="LUK 10:37"/></para>
  <para style="s1">Yesusi Martanne Maarami Soo Bides</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>Yesusinne iza kaallizayti oge bishin Yesusi issi guta gelides; Marta geetettiza issi maccassaya bason Yesusa mokka ekkadus. <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>Izis Maaramo geetettiza issi michcheya dawus. Maaramakka izappe qaala siyashe Godaa toho garsan uttadus.<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">Yoha 11:1</ref></char></note> <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>Gido attiin Martay ooso daroppe dendidayssan daaburada Yesusaakko shiiqada, «Godoo! Ta michchiya ooso ubbaa ta bolla aggada uttishin neni co7u gay? Iza tana maaddana mala izis yoota attiin» gadus.<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>Gido attiin Goday izis, «Hanne Martaa! Neni daro miishsha gishshas qofa daraasa; dirbataasa; tuggataasa. <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>Koshshizay gidikko issi miish xalla; Maaramakka lo7o exa dooradus; hessika izippe ekettenna» gides.<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">Yesusi Tamaarsida Woosa</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mato 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>Issi gallas Yesusi issison woossides; izi woosaa wursishin iza kaallizaytappe issoy, «Godoo! Xammaqiza Yohannisi bana kaallizayta woosa tamaarsidayssaththo nekka nuna woosa tamaarsa!» gides.<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>Izikka isttas,</para>
  <para style="q1" vid="LUK 11:2">«Woossishe, ‹Nu Aawawu!</para>
  <para style="q2" vid="LUK 11:2">Ne sunththi anjjetto;</para>
  <para style="q2" vid="LUK 11:2">ne kawoteththi haa yo.<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>Hachchis gidiza quma nuus imma.<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>Nuna qohidayta nu maariza mala</para>
  <para style="q2" vid="LUK 11:4">nuna maara;</para>
  <para style="q2" vid="LUK 11:4">paacenkka nuna gelththofa›</para>
  <para style="q2" vid="LUK 11:4">gi woossite» gides.<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 11:5-6"/>Qasseka, «Inttefe issaades laggey diikko leela giddoth he laggezaso biidi, ‹Taas issi imaththi ogeppe yiin mizana kaththi baynda gishshas heedzdzu solloy diikko taas tal7arkkii?› <verse eid="LUK 11:5-6"/><verse number="7" style="v" sid="LUK 11:7"/>Laggezikka zaaridi, ‹Tana waayisoppa; kareykka gordettides; tanikka naytara ichchadis. Ha7i dendada immanaas dandaykke› gaandee? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>Tanikka inttes yootays; laggeteththaa gishshas dendidi immontta aggikokka izi oyshon saleththida gishshas dendidi koyzayssa ubbaa immides.<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>«Hessa gishshas tani inttes gizay woossite inttes imettana; koyite intte demmana; kare qoxxite inttes doyettana. <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>Ays giikko woossizay wuri ekkana; koyzaykka demmana; kare qoxxizaadeska doyettana.<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>«Inttefe aawaa gidi uttidi izi yelida nay mole oychchiko shoosh immizay daandee? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>Woykko phuuphphulle oychchiko masimaso immizay daandee? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>Intte iitata gidishe intte naytas lo7o imota imo erikko salon diza intte Aaway bana woossizaytas Xillo Ayana wostti darssi immennee?» gides.<verse eid="LUK 11:13"/></para>
  <para style="s1">Yesusanne Bi7elizeebula</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mato 12:22-30</ref>; <ref loc="MRK 3:20-27">Mar 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>Issi gallas Yesusi haasayssontta duude daydanth kessides. Daydanththazikka kezidaappe guye doona duude addezi haasaydes; be7ida asatikka darssi malalettida. <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>Gido attiin issi issi asati, «Bi7elizeebula geetettiza daydanththata halaqan daydanththata kessees» gida.<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mato 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="LUK 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16"/>Issi issi asay iza paaccanaas, «Saloppe malata bessa» giidi oychchides.<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mato 12:38</ref>; <ref loc="MAT 16:1">16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref></char></note> <verse eid="LUK 11:16"/><verse number="17" style="v" sid="LUK 11:17"/>Gido attiin Yesusi istta qofaa eridi, «Ba giddon shaakettiza kawoteththi wuri dhayana; ba giddon sigay baynda keeththika kundana. <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>Intte tana, ‹Bi7elizeebulan daydanththata kessees› giidi haasayeeta shin Xala7eykka ba giddon issoy issaafe shaakettiko iza kawoteththi waani minnanee? <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>Histtiko tani daydanththata Bi7elizeebulan kessiko intte nayti oonan kessandettoo? Hessa gishshas intte nayti intte bolla pirdizayta gidana. <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>Gido attiin tani daydanththata kessizay Xoossa wolqqan gakkides; Xoossa Kawoteththay intteko matidaaro erite.<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>«Mino asi lo7eththi gixettidi ba keeththe naagikko keeththaan diza miishshi lo7on naagettees. <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>Gido attiin izappe hara mino asi yiidi xoonikko izi ammanettida ola miishshata woththi ekkidi izas diza haarozakka wursi haras gishana.<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>«Tanara gidonttay tanara eqettees; tanarakka shiishshonttaadey laallees,<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mar 9:40</ref></char></note><verse eid="LUK 11:23"/></para>
  <para style="s1">Iita Ayanay Aggi Bidaso Simmi Yuus</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mato 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>«Tuna ayanay asappe kezida wode shemposo koyishe haaththi baynda melason waayettees; shemposoy dhaykko, ‹Tani kase kezidaso guye simmana› gees. <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>Izappe simmidi yishin kase izi aggi bida keeththay pitettidinne giigi uttidayssa demmees. <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>Hessafe simmi biidi baappe iitiza hara laappun daydanththata banara ekkidi yees; isttika gelidi heen daana; hessaadeska koyroyssafe guyeyssi keehi iita gidana» gides.<verse eid="LUK 11:26"/></para>
  <para style="s1">Tumu Anjjo</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>Yesusi hessa haasayza wode asaa giddofe issi maccas dizaara ba qaala dhoqqu ooththada, «Nena tookkida qanththinne ne dhammida dhanththati anjjettidayta» gadus.<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>Gido attiin izi, «Anjjettidayti Xoossa qaala siyidi azazettizayta» gides.<verse eid="LUK 11:28"/></para>
  <para style="s1">Yoonaasi Malata Gideth</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mato 12:38-42</ref>; <ref loc="MRK 8:12">Mar 8:12</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>Daro derey Yesusaakko shiiqida wode Yesusi, «Hayssi yeletay iita yeleta; gita malata beyanaas koyees; gido attiin Yoonaasa malaatappe hara dumma malatay imettenna. <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>Gaasoykka Yoonaasi Nannawe asaas malata gidida mala asa nay tani ha yeletas malaata gidana.<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">Yoha 3:4</ref></char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>Dugeha dere macca kawoya Solomoone erateth beyanaas biitta gaxappe dendada yida gishshas pirda wode iza ha yeletara dendada pirdana; hekko Solomooneppe aadhdhizaadey haan dees.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1Kawo 10:1-10</ref>; <ref loc="2CH 9:1-12">2Taari 9:1-12</ref></char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>Yoonaasi sabbakishin siyidi Nannawe asay ba nagarappe maarettida gishshas ha yeletara issife dendidi pirdana; gido attiin Yoonaasappe aadhdhizay haan dees.<verse eid="LUK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>«Xomppe oyththidi kareppe geliza asas poo7ana mala qoncceson woththeettes attiin geemason woththiza asi deenna. <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>Ne asateththas poo7oy ne ayfe; ne ayfey paxa gidikko ne kumeththa asateththayka poo7o gidana; ne ayfey sakettiko ne kumeththa asateththay dhuma gidana. <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>Hessa gishshas nenan diza poo7oy dhumontta mala naagetta. <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>Histtiko ne asateththay poo7o gidikko dhumida asateththi deenna aggiko ne kumeththa asateththay xomppey lo7eththi poo7iza mala lo7i beettana» gides.<verse eid="LUK 11:36"/></para>
  <para style="s1">Yesusi Walassida Farsaawetanne Wogaa Tamaarsizayta</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mato 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>Yesusi haasaya wursida mala issi Farsaawey banara quma maanaas Yesusa xeygides. <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>Yesusi quma maana kushe meecettontta aggidayssa be7idi malalettida.<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>Goday izas, «Ha7i intte Farsaaweti xuu7assinne keres bolla bagga meecci geeshsheeta; inttes giddo baggazi uuzeteththaninne iitateththan kumides. <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>Intteno eeyatoo! Kare bagga medhdhiday giddo bagga medhdhibeennee? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>Yo7on gidikko giddon dizayssa muxuwaata immite; he wode wurikka inttes geesh gidana.<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>«Intteno Farsaawetoo! Inttes aayye ana! Aanugappenne xalotappe qasseka dumma dumma kaththafe tammaafe issino kesseeta; gido attiin tumu pirdanne Xoos dosanayssa aggi aadhdheeta; gidikkoka intte aggi aadhdhanaas bessenna; hankkoyssa aggontta intte ooththana bessizaytikka hayta.<verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>«Intteno Farsaawetoo! Inttes aayye ana! Ayhuda Woosa Keeththan uttanaas bonchcho oyde koyeeta; giya giddonkka asay intte sinththan hokkana mala doseeta. <verse eid="LUK 11:43"/><verse number="44" style="v" sid="LUK 11:44"/>Asi erontta iza bollara biza qotetti diza duufo intte misatiza gishshas inttes aayye ana!» gides.<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>Muse wogaa erizaytappe issoy zaaridi, «Astamaaree! Ne hessaththo haasayza wode nunakka cayaasa» gides.<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>Yesusikka zaaridi, «Intteno Muse wogaa erizaytoo intteska aayye ana! Asi tookkanaas dandayontta deexo tooho as toosseeta; intte gidikko biradhdhe xeerankka bochcheketa.<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>«Intte Aawati wodhida nabeta duufo intte lo7eththiza gishshas inttes aayye ana. <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>Histtiko intte intte aawata ooso minththiza markkatta; istti nabeta wodhida; intteka istta duufo lo7eththeeta.<verse eid="LUK 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 11:49"/>«Hessa gishshas Xoossa erateththi, ‹Nabetanne Hawaareta ta isttas yeddana; isttika isttafe issaa issaa wodhana; haratakka gooddana. <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>Hessa gishshas ha yeletay biittay medhettoosofe ha7i gakkanaas gukkida nabeta ubbaa suuththaa gishshas oyshettana. <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>Aabeele suuththafe doommidi yarshizasoppenne Xoossa Keeththa giddon gukkida Zakaraasa suuththa gakkanaas koyeettes› gadus. Ee ta inttes gizay ha yeletay hayssas oyshettana.<verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>«Intteno woga erizaytoo! Inttes aayye ana! Erateththa penge qulpe wolqqara woththi ekkidi intteska gelibeekketa; gelanaytakka diggeeta» gides.<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>Yesusi heeppe kezidaappe guye Xaafetinne Farsaaweti eqettishe oyshan shempo diggida. <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>Iza doonappe keziza qaalan iza qaxxanaas naagettida.<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">Qoodheppe Qommo Hanoteththa Gishshas Yesusa Qofiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>He wode daro derey ba giddon issoy issaara yedhettana gakkanaas shiiqi uttidaashe Yesusi bana kaallizayta, «Farsaaweta irshofe naagettite; hessika qoodheppe qommo hano.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">Mato 16:6</ref>; <ref loc="MRK 8:15">Mar 8:15</ref></char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>Qonccontta kamettidi attanaynne erettontta qotan attana miishshi deenna.<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luqa 8:17</ref></char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>Hessa gishshas intte geeman haasaydaazi wuri qoncce kezana; qasseka intte qol7an hayththan saasuketti haasaydaazi wuri dere sinththan yootettana.<verse eid="LUK 12:3"/></para>
  <para style="s1">Oonas Babbanaas Bessizaakko</para>
  <para style="r">(<ref loc="MAT 10:28-31">Mato 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>«Ta laggetoo! Ta inttes gizay asho xalla wodhanaappe attiin hara aykkoka ooththanaas dandayonttaytas babbofte. <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>Gido attiin intte babbanaas bessizay oonakko ta inttena bessana; asho wodhidaappe guye ashonne shempo issife gaththi Gaanname taman yegganaas dandayzayssas babbite; ee izas babbite gays.<verse eid="LUK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6"/>«Siine kafo ichchashati nam7u santes bayzetteettes; gido attiin isttafe issineyokka Xoossi dogenna. <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>Intte hu7e binanay kumeth taybon dees; hessa gishshas babbofte; daro Siine kafotappe intte aadhdheeta.<verse eid="LUK 12:7"/></para>
  <para style="s1">Kirstoosa Gishshas Markkateth</para>
  <para style="r">(<ref loc="MAT 10:32-33">Mato 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>«Ta inttes yootays; ta gishshas asa sinththan markkattiza asa ubbaas Asa Nay qasseka Xoossa kiitanchcha sinththan iza gishshas markkattana. <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>Gido attiin asa sinththan tana kaddidaadey Xoossa Kiitanchcha sinththan kaddettana.<verse eid="LUK 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10"/>«Asa Naa bolla kawushsha qaala haasayzaades nagaray wuri maarettanashin Xillo Ayana cayizaadey maarettenna.<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mato 12:32</ref>; <ref loc="MRK 3:29">Mar 3:29</ref></char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>«Asay inttena oykkidi dere haarizaytakkonne godatizaytakko; Ayhuda Woosa Keeththe oykki efikko, ‹Ay gi zaarinoo? Ay giinoo?› giidi hirgofte. <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>Ays giikko intte haasayanaas bessizayssa Xillo Ayanay he wode inttena tamaarsana» gides.<verse eid="LUK 12:12"/></para>
  <para style="s1">Dure Addeza Eeyateth</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>Daro asaa giddofe issaadey, «Astamaaree! Ta ishay nu aawaa laata miishshaafe tana gakkizayssa taas immana mala izas yoota» gides.<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>Yesusikka, «Haysso! Tana intte bolla pirdiza daanna ooththiday oonee?» gides. <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>Qasseka isttas, «Asas daro miishshi diikkoka shemppoy he dureteththan dontta gishshas naagettite; yiiqeteththafe inttena keehi naagite» gides.<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>Zaareththidikka isttas, «Lo7eththi kath immiza gade godaa gidida issi dure asi dees. <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>He addezikka ba wozinan, ‹Ta kaththaa shiishshada woththizasoy baynda gishshas ay ooththoo?› gi qoppides.<verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>«Addezikka, ‹Taas diza gootarata laallada hara aakkizayssa keexxana; histtada taas diza kaththaanne taas dizaaz ubbaa izan shiishshana. <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>Ta shemppoyee! Daro wodes gidiza kath shiishshida gishshas shempa uttada ma; uya; ufayetta› gaana gides.<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>«Gido attiin, ‹Xoossi haysso eeyazoo! Ne shemppoyo hach omars neeppe ekkana koyeettes; hessa gishshas ne nees shiishshidayssi oonas gidanee?› gides.<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>«Hessa gishshas Xoossa achchan dure gidontta baas miishshe shiishshiza asa wurseththika hessa mala» gi leemison yootides.<verse eid="LUK 12:21"/></para>
  <para style="s1">Xoossan Ammaneteth</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mato 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>Hessafe guye Yesusi bana kaallizaytas, «Inttes ta yootays; intte duussas, ‹Ay maanaakko woykko intte bollas ay may7anaakko› giidi ceecopite. <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>Ays giikko shemppoy kaththafe asateththi qasse may7ofe aadhdhees. <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>Quurota xeellite zerettenna; maxettenna; kath shiishshiza gootaray isttas baa shin Xoossi istta mizees. Histtiko intte isttafe keehi aadhdheketii? <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>Gido attiin inttefe darssi qoppidi ba layththa bolla issi gallas gujjana dandayzay oonee? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>Histtiko guuththa miish oosoy inttes dandayettonttaashe ays hara miishshas keehi qoppeetii?<verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>«Ciishshati waanidi diccizaakko ane xeellite; waayettenna; suqettenna; gido attiin ta inttes yootays; Solomooneykka gita asa shin isttafe issineyththo may7ibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1Kawo 10:4-7</ref>; <ref loc="2CH 9:3-6">2Taari 9:3-6</ref></char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>Histtiko Xoossi hach beettidi wonto taman wodhdhana maata hayssaththo mayzizaa gidikko intteno ammanoy paccidaytoo! Inttena wostti aaththi mayizennee?<verse eid="LUK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29"/>«Hessa gishshas, ‹Ay miinoo? Ay may7inoo?› giidi intte wozinay darssi qoppofo. <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>Biitta bollan diza asi wuri hayssa koyees; gido attiin hayssi wuri inttes koshshizayssa intte Salo Aaway erees. <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>Ubbaafekka koyroththidi Xoossa kawoteth koyite; hayssi wuri inttes gujetti imettana.<verse eid="LUK 12:31"/></para>
  <para style="s1">Sa7a Bolla Miish Shiishshanaas Bessenna</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mato 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>«Intteno guuththa wude mehe mala gididaytoo! Kawoteth inttes immanaas intte Aawaas lo7o qofa gidida gishshas babbofte. <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>Inttes dizayssa bayzidi manqotas immite; kaysoy ekkonttason, bilay monttason, cimmontta korojon wurontta miish salon shiishshite. <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>Intte wozinay intte miishshi dizason daana» gides.<verse eid="LUK 12:34"/></para>
  <para style="s1">Oosanchchata Minoteth</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>«Qaanththan gixxidi giigettite; intte poo7oykka poo7o,<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">Mato 25:1-13</ref></char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>Istta goday bullachcha diggisappe simmidi yaanaashe naagettizaytanne izi yiidi penge qoxxishin elle doyanaas giigi uttida asata misatite.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">Mar 13:34-36</ref></char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>Istta goday yiza wode dhiskontta naagi uttida ashkarati istti anjjettidayta; ta inttes tumu gays; istta goday baas qaanththan gixxi eqqidi istta maaddan utissidi mizana. <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>Omars woykko leela giddoththan yiidi istti dhiskontta dishin demmiko he ashkarati anjjettidayta. <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>Kaysoy ay wode yaanaakko erizaa gididaakko keeththaa goday kaysoy bookkishin co7u giidi bessonttayssa erite.<note caller="-" style="x"><char style="xo" closed="false">12:39-40 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">Mato 24:43-44</ref></char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>Asa Nay intte qoppontta woden yaanayssa eridi intteka giigettidi naagite» gides.<verse eid="LUK 12:40"/></para>
  <para style="s1">Iita Oosanchchatanne Lo7o Oosanchchata Leemiso</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mato 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>Phexroosikka, «Godoo! Hayssa leemisoza ne yootizay nuus xallayee? Ubba asaassaraa?» gides.<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>Godaykka, «Histtiko baso asaas koshshiza woden quma immana mala keeththaadey keeththa asaa bolla woththiza ammanettida wozinama asi oonee? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>Goday simmishin hessaththo ooththishe beettizaadey izi anjjettidaade. <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>Ta inttes tumu gays; baas diza miish ubbaa bolla hessaade godasana. <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>Gido attiin, ‹Izaadey ta goday elle yeenna gam7ana› gi qoppidi adde ashkaratanne macca ashkarata bukkiko, qasseka koyida mala miidinne uyidi maththottiko, <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>hessaade goday izi qoppontta gallassan yaana giidi ezgontta saaten yaana; histtidi iza qanxxereththi yeggidi iza exa ammanonttaytara issife ooththana.<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>«Ba godaa qofaa eridi giigettonttaynne godaa shene ooththontta ashkaray iita shoch shocettana. <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>Gido attiin erontta dishe shochchas bessiza mooro ooththida ashkaray guuththara shocettana; daro imettida asa ubbaafe daroy koyettees; daro hadara ekkidaadefe daroy koyettees.<verse eid="LUK 12:48"/></para>
  <para style="s1">Ubbaa Aggidi Yesusa Kaalo</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mato 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>«Tani yiday biitta bollan tama eeththanaassa; he tamay ha7i eexxi kezidaakko tana daro ufayssana. <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>Gido attiin tani xammaqettana xinqatay dees; he xinqatay polettanaashe tani keeha metotettadis.<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">Mar 10:38</ref></char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>Inttes tani biitta bolla saro ehana yidaa misatizee? Gidenna; ta inttes yootays; tani yiday issaa issaafe shaakkanaassa. <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>Hayssafe sinththan issi keeththan ba giddon shaakettida ichchashu asati daana. Nam7ati heedzdzata bolla heedzdzati nam7ata bolla dendidi ba giddon shaakettana. <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>Aaway ba attuma naa bolla, attuma naykka ba aawaa bolla, aaya ba macca nay bolla, macca nayakka ba aayey bolla, bollota ba naa machchi bolla, naa machchaka ba bolloti bolla dendidi ba giddon shaakettana» gides.<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Miki 7:6</ref></char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">Wodeza Hanota Ero</para>
  <para style="r">(<ref loc="MAT 16:2-3">Mato 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>Qasseka derezas, «Intte arshey mokkiza baggara shaaray kezishin be7idi, ‹Ellerakka iray yaana gees› geeta; intte gida malakka hanees. <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>Dugeha baggara pudeha carkishin, ‹Gallassay ho7o gidana› geeta; intte gida malakka hanees. <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>Intteno Lo7o misatiza iitatoo; saloyssanne sa7a medha be7idi hananayssa ereeta shin ha wodeza eroy inttena waani xoonizee?»<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>«Histtiko intte ays tuma pirdeketii?<verse eid="LUK 12:57"/></para>
  <para style="s1">Morkkera Sigeteth</para>
  <para style="r">(<ref loc="MAT 5:25-26">Mato 5:25-26</ref>)</para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 12:58"/>«Ne morkkera daanna sinththan eqqana bishin buro oge bollan dashe izara giigana oge koya; ne histtontta aggiko izi nena goochchidi daanna sinth efana; daannayka nena aaththidi halaqas immana; halaqaykka nena woynen yeggana. <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>Ta nees yootays; daannay pirdida wurseththa santiyo qanxxa wursana gakkanaas ne heeppe kezakka» gides.<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">Nagarappe Simmonttay Wuri Dhayana</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>He wode issi issi asati Yesusaakko yiidi, «Philaxoosi istta suuth istta yarshora gaththi walakkida Galila asata» gishe Yesusas yootida. <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>Izikka zaaridi, «Histtiin hessa mala metoy istta bolla gakkida asati hankko waayey gakkontta attida Galila asaa ubbaafe aadhdhida nagaranchcha gidida gishshas gi qoppeetii? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>Gidenna! Ta inttes yootays; intte maarettontta ixxiko intte wurikka he asata mala dhayana. <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>Woykko Selihoomen gimbey istta bolla kundiin hayqqida tammanne osppun asati Yerusalaamen diza asaa ubbaafe nagaranchcha gidida gishshas giidi qoppeetii? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>Gidenna! Ta inttes yootays; intte maarettontta ixxiko intte wurikka he asata mala dhayana» gides.<verse eid="LUK 13:5"/></para>
  <para style="s1">Ayfontta Balase Miththay Leemiso</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>Qasseka isttas, «Issi asi woyne tokkizasohon tokettida issi balase miththi dawus; he balase miththayko ayfe koyana yiidi issi ayfekka demmibeenna. <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>Woyne atakilte ooththizayssas, ‹Hekko tani ayfe demmana gaada hachchira heedzdzu layth ha balaseykko simeretta yaada issi ayfekka demmabeekke; hessa gishshas izo qanxxa digga! Aazas coo biittaa xunxazee?› giidi leemiso yootides. <verse eid="LUK 13:7"/><verse number="8" style="v" sid="LUK 13:8"/>Izikka zaaridi, ‹Godoo! Tani izi xaphon osha yeggada ooseththa xeellana mala ha layththas aggaagarkkii? <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>Yiza layththas iza ayfikko lo7o; ayfontta ixxiko qanxxandasa› » gides.<verse eid="LUK 13:9"/></para>
  <para style="s1">Yesusi Sambata Gallas Paththida Quuna Maccassiyo</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>Yesusi Sambata gallas issi Ayhuda Woosa Keeththan tamaarsishin, <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>tammanne osppun layth kumeth iita ayanay oykkidi asateththaa pacisida issi maccassaya heen dawus; izakka zokkoy quunnida gishshas mulekka dhoqqu gaanaas dandayukku. <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>Yesusi izo be7idaappe guye xeygidi, «Hanne maccassayee! Neni nena sakkiza hargezappe paxadasakko!» gides. <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>Yesusi ba kushe izi bolla woththiin iza heerakka sitti gaada eqqadus; Xoossaaka galatadus.<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>Ayhudata Woosa Keeththa halaqazikka Sambata gallas paththidayssas Yesusa bolla hanqettidi izakko yiza dereza, «Oosos bessiza usuppun gallassati diza gishshas he ooso gallassatan yiidi paxite attiin Sambata gallas yoopite» gides.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">Kessa 20:9-10</ref>; <ref loc="DEU 5:13-14">Zaare 5:13-14</ref></char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>Godaykka zaaridi, «Intteno qoodheppe qommon haasayzaytoo! Intte giddofe issaadey ba boora woykko ba hare Sambata gallas bason qashettidasoppe birshidi haaththe ushshanaas efi erennee? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>Histtiin hanna maccassaya Abrahaame naa gidada tammanne osppun layth kumeth Xala7ey qachchiin dizasoppe Sambata gallas birshettanaas izis bessennee?» gides. <verse eid="LUK 13:16"/><verse number="17" style="v" sid="LUK 13:17"/>Yesusi hizgi oychchida wode izara eqettizayti wurikka yeellatida; gido attiin derey wurikka izi oychchida malalisiza oyshan ufayettides.<verse eid="LUK 13:17"/></para>
  <para style="s1">Sanafice Geetettiza Miththay Zereththa Leemiso</para>
  <para style="r">(<ref loc="MAT 13:31-33">Mato 13:31-33</ref>; <ref loc="MRK 4:30-32">Mar 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>Qasseka Yesusi zaaridi, «Xoossa Kawoteththi ay misatizee? Ta izo aazara leemisoo? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>Issi asi Sanafice geetettiza miththa ayfe ba gaden tokkiin mokka diccada gita gidiin kafoti izi hagga<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="fqa" closed="false">Hagga: </char><char style="ft" closed="false">Hagga geetettizayssa issi issi bagga Gamoththo qaalan hange geettes.</char></note> giddon duussaso giigsana gakkanaas diccida sanafice mith misatawus» gides.<verse eid="LUK 13:19"/></para>
  <para style="s1">Irsho Leemiso</para>
  <para style="r">(<ref loc="MAT 13:33">Mato 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>Qasseka, «Xoossa Kawoteth aazara leemisoo? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>Issi maccassi munuqa caalisanaas daro dhiillera walakkida guuththa irsho misatawus» gides.<verse eid="LUK 13:21"/></para>
  <para style="s1">Xunththa Penge</para>
  <para style="r">(<ref loc="MAT 7:13-14">Mato 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>Hessafe guye Yesusi Yerusalaame bishe kanththi biza katamaninne gutatan asaa tamaarsishe aadhdhishin, <verse eid="LUK 13:22"/><verse number="23-24" style="v" sid="LUK 13:23-24"/>issaadey izakko shiiqidi, «Godoo! Pirdafe guuththa asati xalla attanee?» gi oychchides. Izikka zaaridi, «Xunththa pengeyra gelanaas baaxetite; daroti gelanaas koyeettes shin isttas hanenna. <verse eid="LUK 13:23-24"/><verse number="25" style="v" sid="LUK 13:25"/>Keeththaa goday dendidi ba kare gordi gidiin intte karen eqqidi, ‹Godoo! Kare doyarkkii!› giidi penge qoxxana shin izi zaaridi, ‹Intte oonakkonne awappe yidaakko ta inttena erikke› gaana gides.<verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>«Intteka izas zaaridi, ‹Nuni nenara issife midossinne issife uyidos; nu dubbushan ne nuna tamaarsadasa› gaana.<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>«Izikka zaaridi, ‹Inttena intte oonakkonne intte awappe yidaakko ta inttena erikke; intte makkallati wurikka taappe haakkite› gaana gides.<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Maza 6:8</ref></char></note><verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>«Intte Abrahaame, Yisaaqa, Yaaqoobenne nabeta ubbata Xoossa Kawoteththan be7iza wode intte karen yegetti attiko he wode inttes yeehonne achcha garccech gidana.<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mato 22:13</ref>; <ref loc="MAT 25:30">25:30</ref></char></note> <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>Asay arshey mokkiza baggafenne wulliza baggafe pudehappenne dugehappe yiidi Xoossa Kawoteththa maaddan uttana. <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>Hekko guyen dizaytappe baggayti sinththe aadhdhana, sinththan dizaytappe baggayti guye aadhdhanayti deettes» gides.<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mato 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">Mar 10:31</ref></char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">Yesusi Yerusalaame Walassides</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>He wode Farsaawetappe issi issi asi yiidi, «Herdoosi nena wodhanaas koyza gishshas hayssafe denda kichcha» gida.<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>Yesusi isttas, «Tani buro, ‹Hachchinne wonto daydanththata asappe kessana; hargizaytakka paththana; heedzdzanththo gallas ta qofaso ta gaththana› gides giidi he worakanaas yootite. <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>Gido attiin nabey Yerusalaameppe harason hayqqanaas bessontta gishshas hachchinne wonto wontoppeynka ta sinththe buus gujjana.<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>«Hanne Yerusalaame nabeta wodhizaaree! Neekko kiitettidayta shuchchara caddizaaree! Kuttoy ba ciyeta ba qefe gars shiishshiza mala ne nayta shiishshanaas aappun wode koyadinaashin ne gidikko akkay gadasa. <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>Hekko intte keeththay kayzides; ta inttes yootays, ‹Godaa sunththan yizaadey anjjettides› intte gaana wodey gakkanaashe nam7anththo tana beyekketa» gides.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Maza 118:26</ref></char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">Qasseka Yesusi Issi Harganchcha Sambata Gallas Paththides</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>Issi gallas Yesusi quma maanaas Farsaaweta halaqatappe issaa soo gelida wode asay wuri Yesusi ay ooththanaakko giidi ayfe iza bolla tokki xeellides. <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>Heenkka izas asateththay puuriin waayettiza issi asi iza sinththan dees. <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>Yesusikka Muse wogaa erizaytanne Farsaaweta, «Sakettizaade Sambata gallas paththanaas koshshizeyee? Koshshennee?» giidi oychchides.<verse eid="LUK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4"/>Isttika co7u gida; izikka addeza bochchidi paththi yeddides. <verse eid="LUK 14:4"/><verse number="5" style="v" sid="LUK 14:5"/>Qasseka, «Inttefe issi asas Sambata gallas nay woykko booray kundidi ollan gelikko eeson heerakka kessonttaadey oonee?» gides.<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">Mato 12:11</ref></char></note><verse eid="LUK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6"/>Isttika oyshaas aykko zaarokka demmanaas dandaybeettenna.<verse eid="LUK 14:6"/></para>
  <para style="s1">Bana Ziqqi Histteththinne Imaththa Moko</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>Xeygettida asati uttanaas bonchchoso koyishin Yesusi be7idi leemisora isttas, <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>«Issi asi nena sarges xeygikko bonchchoson uttofa; neeppe bollara bonchchettizaadey xeygettiko, <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>inttena nam7atakka xeygidaadey yiidi, ‹Ne uttidasohoza hayssaades yedda› gaana; nenikka yeellatashe ziqqaso baandasa. <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>Gido attiin ne xeygettida wode ziqqaso xeellada utta; nena xeygidaadey yiidi, ‹Ta laggezoo! Haa ya dhoqqasohon utta› gaandes; nenikka he wode nenara maaddan uttida asaa ubbaa sinththan bonchchettana. <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>Gaasoykka bana dhoqqu histtizaadey wuri ziqqi gaana; bana ziqqi histtizaadey wuri dhoqqu gaana» gides.<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mato 23:12</ref>; <ref loc="LUK 18:14">Luqa 18:14</ref></char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>Yesusikka xeygida addeza, «Quma woykko kawo mizanaas xeyssiko neyssaththo nena xeyssidi mizontta mala ne laggeta woykko ne ishata, ne dabbota woykko dureta woykko dure gutata xeygoppa. <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>Gido attiin asaa xeyssada mizana koykko manqota, kushey, tohoy baynda wobbetanne qooqeta xeyssa; neni anjjettana. <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>Xeygettidayti kushe zaaranaas dandayontta gishshas xillota denththa wode nees kushey zaarettana» gides.<verse eid="LUK 14:14"/></para>
  <para style="s1">Wogga Gibira Leemiso</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mato 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>Maaddan Yesusara issife uttidaytappe issoy hayssa siyidi, «Xoossa Kawoteththan shiiqidi maaddaafe miza asi anjjettidaade» gides.<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>Yesusikka, «Issi asi wolqqama gibira giigsidi daro as xeygides.<verse eid="LUK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 14:17"/>«Gibira maana wodeykka gakkiin xeygettida imaththata, ‹Wurikka giigida gishshas haa yiite!› giidi xeygana mala ba ashkara yeddides. <verse eid="LUK 14:17"/><verse number="18" style="v" sid="LUK 14:18"/>Gido attiin wurikka baas hara gaaso shiishshidi issoy, ‹Ha7i gade shammadis; ta baada beyanaas bessees; hachchis tana lanccofa› gides.<verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>«Hankkoyssika, ‹Tani ichchashu waaxa boora shammadis; istta paacca xeellana gishshas hach tana lanccofa› gides.<verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>«Qasse hara issaadeyka, ‹Tani buro mishirateththan days; baanaas dandaykke› gides.<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>«Oosanchchazi kiitettidasoppe simmidi heedzdzati gidayssa ba godaas yootides; he wodekka gibira giigsidayssi hanqettidi oosanchchaza, ‹Elle oyddu oge kezada manqota, kusheynne tohoy baynda wobbeta, qomaaxatanne ayfey baynda qooqeta haa gelththa› gides.<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>«Oosanchchazikka zaaridi, ‹Ta Godoo! Ne tana azazidayssa ubbaa poladis; ha7ikka hara uteththasoy dees› gides.<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>«Godazikka oosanchchaza, ‹Gede oyddu oge kezada ta keeththe kumana mala pudenne duge aadhdhizayta wolqqara haa gelththa. <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>Tani tuma gays; gibiraa maana xeygettidaytappe issaadeyka doonan gelththenna› » gides.<verse eid="LUK 14:24"/></para>
  <para style="s1">Yesusa Kaaloy Bana Yarsho Koyees</para>
  <para style="r">(<ref loc="MAT 10:37-38">Mato 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>Daro derey izara issife bizayssa Yesusi be7idi guye simmi, <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>«Taakko yizay wuri ba aawaa, ba machchonne nayta, ba ishatanne michcheta, ba shemppo gidiin ixxontta aggiko tana kaallizaade gidanaas dandayenna.<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">Mato 10:37</ref></char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>Ba masqale tookkidi tana kaallonttay tana kaallizaade gidanaas dandayenna.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mato 10:38</ref>; <ref loc="MAT 16:24">16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luqa 9:23</ref></char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>«Inttefe issi asi keeththe keexxanaas koykko polanaas dandayanaakkonne dandayonttaakko koyrottidi baas diza bira qopponttay oonee? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>Keeththaa keexxana doommidi wursanaas hanontta ixxiko be7ida asi wuri iza bolla miiccana. <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>Isttika, ‹Hayssi addezi keeththe keexo oykkides shin polibeenna› gi miiccana.<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>«Woykko issi kawoy hara kawora olas giigettidi nam7u tammu shii as ekki yiza kawo zaaranaas tammu shii ola asara zaaranaakko uttidi qopponttay oonee? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>Ola zaaranaas dandayetontta misatidi beettiko buro haahon dishin maqaynnanaas gaanna yeddees. <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>Hessaththoka inttefe oonakka gidiin baas dizayssa aggonttay tana kaallizaade gidanaas dandayenna.<verse eid="LUK 14:33"/></para>
  <para style="s1">Mal7ontta Maxine Leemiso</para>
  <para style="r">(<ref loc="MAT 5:13">Mato 5:13</ref>; <ref loc="MRK 9:50">Mar 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>«Maxiney lo7oshin ba maxineteththaa mal7o yeddiko zaaridi waani mal7ana dandayzee? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>Gaden yeggiin aradisontta gishshas coo kare wora yegettees; siyiza hayththi diza asi siyo!» gides.<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">Dhaydi Beettida Dorsa Leemiso</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mato 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>Issi gallas qaraxa shiishshizaytinne nagaranchchati wuri Yesusappe siyanaas iza achchi shiiqida. <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>Farsaawetinne Xaafeti, «Hayssi addezi nagaranchchata ixxenna; isttarakka mees» giidi ba giddon zuuzumettida.<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>Yesusikka isttas leemiso hizgi yootides;<verse eid="LUK 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4"/>«Intte giddofe issaades xeetu dorsi diikko he xeetu dorsatappe issina dhaykko attida uddufun tammanne uddufunata demban yeggidi dhaydayssa demmana gakkanaas koyana bonttay oonee? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>Demmidi ufayssara hashen tookki ekkidi, <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>baso simmees; ba laggetanne guta asata issi bolla xeygidi, ‹Dhayda ta dorsayo demmadis; tanara issife ufayettite› gaana. <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>Ta inttes yootays, ‹Hessaththoka maaroteth koshshontta uddufun tammanne uddufun xillotappe maareteththan geliza issi nagaranchchan salon ufays gidana.›<verse eid="LUK 15:7"/></para>
  <para style="s1">Dhaydi Beettida Booththa Shilinge Leemiso</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>«Woykko issi tammu bira santey diza maccassaya he tammaafe issineya dhaykko xomppe oyththada demmana gakkanaas keeththa gars pittada lo7eththa koyontta maccassi oonee? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>Izakka demmida wode ba laggetanne ba gutata issife xeygada, ‹Taappe dhayda bira santiyo demmida gishshas tanara issife ufayettite› gaandus. <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>Ta inttes yootays; ‹Hessaththoka maarotan geliza issi nagaranchcha asan Xoossa kiitanchchata achchan ufays gidana.›<verse eid="LUK 15:10"/></para>
  <para style="s1">Dhaydi Beettida Naaza Leemiso</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>«Issaades nam7u nayti deettes. <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>Isttafekka kaalo naazi ba aawaa, ‹Aabboo! Nees diza miishshaafe ta gishaa taas imma› gides. Aawaykka baas diza miishshaa ba naytas gishides.<verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>«Daro wode gam7ontta dishe kaalo naazi ba miishshaa ubbaa shiishshi ekkidi haaho biitta bides; heenkka baas diza miishshaa go7ay baynda coo mela dhayssides. <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>Izikka baas dizayssa ubbaa dhayssidaappe guye he biittan iita koshay dendiin daro waayettides. <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>Hessa gishshas he deren diza asaappe issaadeko shiiqides; izaadeyka ba guddunth heemmana mala guddunth heemmizasoho yeddides. <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>Naazikka guddunththati miza harqqozappe maanaas amottides shin hessaka immizaadey beettibeenna.<verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>«Gido attiin iza wozinay simmida wode, ‹Ta aawa ashkarata aappunatappe kaththi palahizee shin tani hayssan gafan hayqqana matadinaa? <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>Dendada ta aawa soo baada aabboo! Salon Xoossaa, sa7an ta nena qohadis.› <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>Hayssafe guye, ‹Tani ne naa geetettada xeygettanaas taas bessenna; ne ashkaratappe issaa mala tana qooda› gides. <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>Hessa gishshas dendidi ba aawaakko bides; gido attiin buro izi haahora yishin aaway beyi mishettidinne izakko woxxi biidi idimmi oykkidi yeerides.<verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>«Naazikka, ‹Aabboo! Salon Xoossaa, sa7an ta nena qohadis; hayssafe guye ta ne naa geetettada xeygettanaas taas bessenna› gides.<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>«Gido attiin aaway ashkaratas, ‹Eesotidi ubbaafe doorettida may7o ehidi mayzite; iza biradhdhen migido, iza tohonkka caamma aaththite. <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>Modhdho mirgo boora ehidi shukkite; ane miidi ufayettoos. <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>Hayssi ta naazi hayqqides shin paxides; dhaydes shin beettides› gides; hessafe guye ufayeteth oykkida.<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>«Hessi haniza wode bayra naazi goshshason dees; heeppeka simmidi soo matida wode diiththa duris siyides. <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>Izikka ashkaratappe issaa xeygidi, ‹Hessi aazee?› gi oychchides. <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>Ashkarazikka, ‹Ne ishay yides; izi saroninne lo7on simmida gishshas ne aaway modhdho mirgo boora shukkides› gides.<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>«Bayra ishazikka hanqettidi soo gelanaaska koyibeenna. Aawaykka kare kezidi izi soo gelana mala woossides. <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>Gido attiin izikka zaaridi aawaas, ‹Hekko tani hayssa gakkanaas nees aylle mala ooththadis; ne azazoppe issinokka pacisabeekke; gido attiin tani ta laggetara ufayettana mala ne taas issi deysha laaqqaka immabeekka. <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>Gido attiin hayssi ne naazi nees dizayssa ubbaa laymatizaytara wursidi yishin modhdho mirgo boora izas shukkadasa› gides.<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>«Aawaykka, ‹Ta naazoo ne ubba wode tanara daasa; taas gididay wurikka neessa. <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>Hayssi ne ishay hayqqides shin paxides; dhaydes shin beettides; hessa gishshas nuni ufayettanaas bessees› gides.»<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">Cincca Heenththanchcha Leemiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>Yesusi bana kaallizaytas, «Issi dure adde dayssas iza keeththaa ayssiza issi asi dees; izi he dure addeza miishshaa ogey baynda laallizayssa worey dure addeza hayththan wodhdhides. <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>Dure addezi he addeza xeygidi, ‹Haysso ta siyizayssi hessi aazee? Hayssafe doommada ne ta keeththaa ayssizaade gidanaas dandayontta gishshas ne alaafeteththan giddon diza miishshaa oykkida mazgabaa taas zaara› gides.<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>«Keeththaa ayssiza addezi ba wozinara, ‹Ta goday tana ta alaafeteththaafe gooddana gees; goya maanaas taas wolqqay baa; woossanaas yeellatays; hessa gishshas ay ooththoo?› giidi, <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>tani alaafeteththaafe kezikko asay tana mokki ekkana mala ooththana oge ta erays.<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>«Hessa gishshas iza godaa acoy istta bolla diza asata issaa issaa xeygides. Koyro yidayssa, ‹Ne bolla godaa acoy aappunee?› gides.<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>« ‹Issi xeetu xaaro kumeththa zaytey ta bolla dees› gides; alaafezi zaaridi kase ne faramida waraqataa hey ekka uttada elle ichchashu tammu xaaro gaada xaafa gides.<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>«Kaallidi hankkoyssa, ‹Nech, ne bolla aappuni dizee?› gides. ‹Xeetu ogoro gisttey dees› gides; alaafezi zaaridi, ‹Kase ne tal7ashe faramida waraqataa hey osppun tammu ogoro gaada xaafa› gides.<verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>«Godazikka shocechchiza alaafezi ooththida cinccateththaa gishshas iza nashshides; hayssabha alameza nayti bana misatizaytara diza gaagoteththan poo7o naytappe aadhdhida cinccata.<verse eid="LUK 16:8"/></para>
  <para style="s1">Miishshe Bessizason Peysho</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>«Hessa gishshas tani inttena gizay ha biittaa miishshay wurida wode mernaa keeththan intte ekettana mala ha7i inttes diza miishshaara inttes lagge medhdhite gays. <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>Guuththa miishshan ammanettizaadey daro miishshankka ammanettana; guuththa miishshan ammanettonttaadey daro miishshankka ammanettenna. <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>Histtiko intte ha biittaa miishshan ammanettontta ixxiko tuma miishsha hadara oykkite giidi ooni inttes immanee? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>Asa miishshan intte ammanettontta ixxiko inttes buzo gidana miish ooni immanee?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>«Nam7u godaas issito azazettana dandayzaadey oonikka deenna; woykko issaa dosidi issaa ixxees woykko issaakko shiiqidi hankkoyssa leqqees; Xoossassinne miishshas issife gaththi haarettanaas dandayekketa» gides.<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">Mato 6:24</ref></char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>Miish darssi siiqiza Farsaaweti hessa ubbaa siyidi Yesusa qidhida. <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>Yesusikka isttas, «Intte inttena asa achchan xilliseeta; gido attiin Xoossi intte wozina erees; asa achchan bonchchettidaadey Xoossa sinththan tuna» giidi yootides.<verse eid="LUK 16:15"/></para>
  <para style="s1">Muse Wogaanne Eko Gelo Gishshas</para>
  <para style="r">(<ref loc="MAT 5:31-32">Mato 5:31-32</ref>; <ref loc="MAT 11:12-13">11:12-13</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>«Muse wogaynne nabeti Yohannisi yaana gakkanaas yootishe gam7ida. Hessa kaallidi qasse Xoossa Kawoteththa Mishiraachcho qaalay sabbakettides. Asi wurikka hee gelanaas wadhettees.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">Mato 11:12-13</ref></char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>Gido attiin Muse wogappe issi qeerina kunda attanayssafe saloynne sa7ay aadhdhanayssi kawushshe gidana.<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mato 5:18</ref></char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>«Ba machcho anjji yeddidi hara macca ekkiza asi wurikka laymatees; ba azinappe anjjetta bidaaro ekkidayssika laymatees.<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mato 5:32</ref>; <ref loc="1CO 7:10-11">1Qoro 7:10-11</ref></char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">Dure Addezanne Manqo Alazaare</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>«Qasseka Yesusi isttas, ‹Lo7o may7o may7idi gallas gallas lo7o duussa ufayssan diza issi dure asi dees› gides. <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>He addeza pengen kumeththa bollay madunth xalla gidida issi Alazaare geetettiza manqo adde dizayssi ichchi dees. <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>Izikka he dure addeza keeththan asay kath mishin maaddafe gaden wodhdhiza suuppa maxi maanaas amottees; kanatikka iza madunththaa laacceettes.<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>«He manqo addezi hayqqiin Salo Kiitanchchati Abrahaame ki7o ekki bida; qasse dure addezikka hayqqidi moogettides. <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>Izi Si7oolen waayettishe dhoqqu giidi haahon Abrahaame xeellides; Alazaarekka ba ki7on oykki dishin be7ides.<verse eid="LUK 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 16:24"/>«Dure addezi, ‹Aawaa Abrahaamee! Hayssan waayettiza taas mishettarkkii! gi Alazaarey ba biradhdhe xeera irxxa haaththan bochchidi ta inxars irxxisana mala haa yeddarkkii!› gi waassides.<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>«Gido attiin Abrahaamey, ‹Ta naazoo neni biitta bolla dashe lo7o duus de7idayssa mala Alazaarey kase waaye be7idayssa ne qoppa; gido attiin ha7i izi ufayettishin neni waayettaasa. <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>Hessi wuri hanishin haan diza asi haappe hee intteko aadhdhontta mala qasseka inttekon dizay haa nuukko aadhdhana koyzaadey haa aadhdhontta mala inttessinne nuus giddon gita aafoy giigettides› gides.<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27-28" style="v" sid="LUK 16:27-28"/>«Dure addezi qasse, ‹Aabboo! Hessi hessa gidikko neni Alazaare duge ta aawa soo yeddana mala ta nena woossays; taas ichchashu ishati deettes; hayti haa waayeso yontta mala biidi isttas lo7eththi yootana mala Alazaare yeddarkkii!› gides.<verse eid="LUK 16:27-28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>«Abrahaamey izas zaaridi, ‹Museynne nabeti heen istta achchan diza gishshas isttafe siyetto› gides.<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>«Izikka zaaridi, ‹Aawaa Abrahaame, hessa mala gidenna; hayqqida asaappe issaadey hayqoppe dendi biikko istti Xoossa maaroteththan gelana› gides.<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>«Abrahaameykka zaaridi, ‹Museynne nabeti gizayssa siyontta ixxiko hayqqida asaappe issaadey dendidaakkoka istti ammanettenna› » gides.<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">Asas Dhuphe Gidanaappe Naageteth</para>
  <para style="r">(<ref loc="MAT 18:6-7">Mato 18:6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Mar 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>Yesusi bana kaallizayta, «Asa dhuphidi nagaran yeggiza miishshi yontta aggenna; gido attiin yaana dhuphezas gaaso gidizaades aayye ana! <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>He addezi ha guuththatappe issaas dhuphe gidanaappe woxa shuchchi iza qoodhen qashettiin abba giddo izi yegettizaakko izas lo7o gidana. <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>Hessa gishshas intte hu7es naagettite. ‹Ne ishay nena qohikko hanqetta; izi ba mooro eridi simmiko maara.›<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mato 18:15</ref></char></note> <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>Issi gallassan laappunto zaari zaari qohidi laappuntokka zaari zaari, ‹Maara› giikko maara» gides.<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>Hawaaretikka, «Godoo! Nuus ammano gujja» gida.<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>Godaykka, «Gaashe ayfe lagge ammanoy inttes diikko hayssa, ‹Eththaa dhoqalletta baada abban gela toketta› intte giikko izi inttes azazettana» gides.<verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" sid="LUK 17:7-8"/>Qasseka Yesusi, «Intte giddofe issi asas goshshanchchay woykko dors heemmiza ashkaray diikko izi goshshasoppe simmishin, ‹Taas maana kawo giigsa; ta maada uyana gakkanaas gixettada taas ooththa; hessafe guye maandasanne uyandassa› gees attiin ha7i quma maana haa aadhdha gizee? <verse eid="LUK 17:7-8"/><verse number="9" style="v" sid="LUK 17:9"/>Histtiko he ashkaraa goday izi iza azazo polida gishshas iza galati erizee? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>Hessa gishshas inttenikka intte azazettidayssa wursi polida wode, ‹Nuni go7ay baynda oosanchchata nuus ooththanaas bessizayssa poli ooththidos› gite» gides.<verse eid="LUK 17:10"/></para>
  <para style="s1">Yesusi Inchchirachcha Hargefe Paththida Tammu Asata</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>Hessafe guye Yesusi Yerusalaame bishe Samaariyaranne Galila achchara aadhdhides. <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>Issi guta gelida wode inchchirachcha hargiza tammu asati iza demmida. Isttika haahon eqqidi <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ba qaala dhoqqu histtidi, «Yesusaa! Godoo! Nuus mishettarkkii!» gida.<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>Izikka istta be7idi, «Biite! Inttena qeesetas bessite» gides; isttika buro bishe oge bolla paxida.<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lewe 14:1-32</ref></char></note> <verse eid="LUK 17:14"/><verse number="15" style="v" sid="LUK 17:15"/>Isttafe issoy ba paxidayssa be7idi ba qaala dhoqqu histtidi Xoossaa bonchchishe simmides. <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>Izaadeyka Yesusa toho bolla kundidi galatides; izikka Samaariya biitta asa.<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>Yesusikka addeza, «Paxidayti tammu as deettennee? Histtiin uddufunati awa bidoo? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>Hayssa dumma dere addezappe attiin Xoossa galatizay baa guussee?» giidi oychchides. <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>Addezakka zaaridi «Dendada ba! Nena ne ammanoy paththides» gides.<verse eid="LUK 17:19"/></para>
  <para style="s1">Xoossa Kawoteththa Yuussa Gishshas</para>
  <para style="r">(<ref loc="MAT 24:23-28">Mato 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>«Xoossa Kawoteththi ayde yaanee?» giidi Farsaaweti Yesusa oychchida wode Yesusi, «Xoossa kawoteththi beettiza malatatan yuukku. <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>Asay Xoossa kawoteththi haan dawus woykko heen dawus gaanaas dandayettenna; Xoossa kawoteththi intte giddon dawus» giidi zaarides.<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>Bana kaallizaytaska, «Asa Naa gallassatappe issi gallassayo beyanaas intte amottana wodey yaana; gido attiin intte beyekketa. <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>Asay inttes, ‹Haan dawus› woykko, ‹Heen dawus› gaana shin intte istta kaallidi boopite. <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>Gaasoykka wolqqanththi wolqqamidi ha gaxappe he gaxa gakkanaas poo7isiza mala Asa Nay yiza gallas iza mala hanana. <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>Gido attiin hayssi wuri hananaappe koyro Asa Nay daro meto ekkanaassinne hayssa ha yeletaan kadhettanaas bessees.<verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>«Nohe wode hanidayssa mala Asa Naa wodenkka hessaththo hanana.<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Medhe 6:5-8</ref></char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>Nohey markaben gelana gallas gakkanaas asay mishininne uyishin, ekkishininne gelishin dhayssiza haaththi yiidi wursika dhayssides.<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Medhe 7:6-24</ref></char></note><verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>«Looxe wodekka iza mala hanides; asay meessinne uyees; bayzeessinne shammees; tokkizaaz tokkees; keeththika keexxees. <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>Gido attiin Looxey Sodoomeppe kezida gallas shuchchinne mith qorontta diine tamay saloppe bukkidi ubbaa dhayssides.<verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>«Asa Nay qoncciza gallas hessaththo hanana. <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/>He wode ba keeththa bolla dizaadey oonikka keeththa giddon diza miish ekkana giidi duge wodhdhofo; hessaththoka goshsha soon diza asi guye soo simmofo.<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">Mato 24:17-18</ref>; <ref loc="MRK 13:15-16">Mar 13:15-16</ref></char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>Looxe machcho qopite.<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">Medhe 19:26</ref></char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>Ba de7o gam7isana koyzay wuri dhayssana; ba shempo aaththi immizaadey gam7isana.<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mato 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luqa 9:24</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref></char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>Ta inttes gizay he wode omars nam7u asi issi hiixan ichchana; issoy ekettana; issoy attana. <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>Nam7u maccassati issife gaaccishin issineya ekettana; hankkoora attana. <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>Nam7u asi issife goshshason daana; issoy ekettana; issoy attana.<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafatan taybo 36 bolla diza qofaa gujjeettes; qofazikka Mato 24:40 dizayssa misatees.</char></note><verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>«Isttika zaaridi, ‹Godoo! Istti awa ekettanee?› gida; izikka ahay dizason ankkoti shiiqana» gides.<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">Am7eyonne Makkalla Daannaza</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>Bana kaallizayti azallontta ubba wode woossanaas bessizayssa erisanaas Yesusi ha leemisoza isttas yootides. <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>«Issi kataman Xoossas yayyontta asinne bonchchontta issi daannay dees. <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>He katamankka issi am7eya dawus. Izakka, ‹Ta balgaarara taas mootoy diza gishshas pirdarkkii!› gashe izakko simerettadus.<verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>«Daannazikka daro wode gakkanaas izis pirdibeenna; gido attiin guyeppe ba wozinan, ‹Xoossas yayyontta asekka bonchchontta aggiko, <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>hanna am7eya tana waayisiza gishshas ta izis pirdana› qoppides; hessa histtontta aggiko ubba wode simerettada iza tana daabursana» gides.<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>Godaykka, «Makkallanchcha daannay gidayssa siyite; <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>Xoossi qamma, gallassinne omars izakko waassiza doorettidaytas pirdenneyee? Tana ay metidee! giidi ba maado gam7isandee? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>Ta inttes gays; izi isttas elle pirdana; gido attiin Asa Nay yiza wode biitta bolla ammano demmandeshaa?» gides.<verse eid="LUK 18:8"/></para>
  <para style="s1">Otoranchcha Farsaawenne Ashke Gidida Qaraxa Shiishshizaade Leemiso</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>Bana xillo asa mala qoodidi ceeqettizaytassinne harata leqo ayfen xeellizaytas leemisora, <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>«Nam7u asati woossanaas Xoossa Keeththe bida; issoy Farsaawe, hinkoyssi qaraxa shiishshizaade. <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>Farsaawezikka eqqidi ba gishshas, ‹Xoossoo! Tani hara asa mala bonqqizaade, makkallizaade, laymatizaade harappeka hayssa qaraxa shiishshizaade mala gidontta aggida gishshas ta nena galatays. <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>Saaminttan nam7aa xoomays; taas diza tammaafe issaa immays› giidi woossides.<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>«Gido attiin qaraxa shiishshiza addezi haahon eqqidi pude salo dhoqqu gi xeellanaas koyibeenna; gido attiin ba tira iccishe, ‹Xoossoo! Tana nagaranchchaza maararkkii!› gides.<verse eid="LUK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14"/>«Ta inttes yootays; Xoossa sinththan Farsaawezi xilloteth demmibeenna; hayssi qaraxizayssi gidikko xillidi baso simmides; bana dhoqqisizay wuri ziqqi gaana; bana ziqqisizay gidikko dhoqqu gaana» gides.<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mato 23:12</ref>; <ref loc="LUK 14:11">Luqa 14:11</ref></char></note><verse eid="LUK 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>Yesusi boshereththana mala asay guuththa nayta izakko ehides. Iza kaallizaytikka hessa be7idi hanqettida. <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>Gido attiin Yesusi guuththa nayta baakko xeygidi, «Guuththa nayti taakko yaanayssa diggofte; Xoossa kawoteththi haytantta malassa. <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>Ta inttes tumu gays; Xoossa kawoteth guuththa naa mala ekkonttay wuri izin gelenna» gides.<verse eid="LUK 18:17"/></para>
  <para style="s1">Ha Biitta Haaronne Salo Kawoteth</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mato 19:16-30</ref>; <ref loc="MRK 10:17-31">Mar 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>Ayhudata halaqatappe issoy, «Kiya astamaaree! Mernaa de7o laattanaas ta ay ooththoo?» gi oychchides.<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>Yesusikka, «Aazas tana kiya gay? Issi Xoossaafe attiin kiyay haray deenna. <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>‹Laymatoppa; wodhoppa; kaysotoppa; wordo markkattofa; ne aawaa bonchcha› giza azazota ne eraasa» gi zaarides.<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kessa 20:12-16</ref>; <ref loc="DEU 5:16-20">Zaare 5:16-20</ref></char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>Addezikka, «Hayta gidikko guuth naateteththafe doommada naagadis» gides.<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>Yesusikka hessa siyidi, «Histtiko nees issi miishshi paccees; nees dizaaz wursa bayzada manqotas imma; salo mazgaban demmandasa; izappe guye yaada tana kaalla» gides. <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>Gido attiin addezi hessa siyida wode daro haaroy izas diza gishshas keehi mishettides.<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>Yesusikka addeza xeellidi, «Daro miishshi diza asati Xoossa kawoteth gelanayssi ay mala metoo! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>Durey Xoossa kawoteth gelanayssafe gaamellay narpe lukora aadhdhanayssi matana» gides.<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>Hessa siyida asay, «Histtiin ooni attana dandayzee?» gides.<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>Yesusikka, «Asa achchan dandayettonttay Xoossa achchan dandayettees» gides.<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>Phexroosikka, «Hekko nuni nuus dizaaz ubbaa aggidi nena kaallidos» gides.<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>Yesusikka isttas, «Ta inttes tumu gays; Xoossa Kawoteththa gishshas giidi ba keeththe, ba machcho, ba ishantta woykko bana yelidayta woykko ba nayta aggidaadey, <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>ha7i wode daro dakko kushe ekkonttaynne yiza wode qasse mernaa de7o ekkonttay oonikka deenna» gides.<verse eid="LUK 18:30"/></para>
  <para style="s1">Yesusi Ba Hayqo Gishshassinne Denththaa Gishshas Heedzdzanththo Yootides</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mato 20:17-19</ref>; <ref loc="MRK 10:32-34">Mar 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>Yesusikka bana kaalliza tammanne nam7ata dumma efidi, «Ha7i nuni Yerusalaame kezana goos; nabeti asa naa gishshas xaafidayssi wuri polettana. <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>Ayzaabetas aaththi immana; isttika iza qidhi kaa7ananne waayisana; iza bolla cuttana. <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>Garafana; hessafekka zaaridi wodhana; izikka heedzdzanththo gallas hayqoppe dendana» gides.<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>Iza kaallizayti gidikko hessa ubbaafe issinokka eribeettenna; izi gizayssika isttas gelibeenna. Izi aaza gishshas haasaydaakko eribeettenna.<verse eid="LUK 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>Yesusi Iyarkko geetettizaso matida wode issi qooqe addey oge doonan uttidi woossees. <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>He qooqe addezikka daro asay ogera aadhdhizayssa siyidi, «Hessi aazee?» gi oychchides. <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>Isttika izas, «Naazirete Yesusi hayssara aadhdhees» gi yootida.<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>Izikka, «Dawite naa Yesusa taas qadhetta!» gi waassides.<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>Yesusappe sinththati bizayti, «Co7u ga!» giidi hanqettida. Gido attiin izi, «Dawite nawu! Taas qadhetta!» giidi darssi waassides. <verse eid="LUK 18:39"/><verse number="40" style="v" sid="LUK 18:40"/>Yesusikka eqqidi addeza izakko ehana mala azazides; izikka izakko shiiqida mala, <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>«Ta nees ay ooththana mala koyay?» giidi oychchides. Qooqezikka, «Godoo xeellanaas koyays» gides.<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>Yesusikka, «Nena ne ammanoy paththides xeella» gides. <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>Addezi heerakka xeellides; Xoossaaka bonchchishe Yesusa kaallides; hessa be7ida derey wuri Xoossaa galatides.<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">Yesusanne Zekkiyoosa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>Yesusi Iyarkko geetettizasora aadhdhi bishin, <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>Zekkiyoosa geetettiza issi asi heen Yesusi biza oge bolla dees. Izikka qaraxa qanxxisizaytas halaqanne keehi dure asa. <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>Izi Yesusa geetettizayssi awayssako beyanaas koyishin qaanththa asa gidida gishshassinne daro derey Yesusa kaalliza gishshas Yesusa beyanaas dandaybeenna. <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>Yesusi he ogera aadhdhishin sinththe aadhdhidi oge bolla diza issi eththa miththa bolla kezides.<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Issi issi bagga Gamoththo qaalan eththa mith gizayssa boobba geettes.</char></note><verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>Yesusi eththaa gars gakkidi dhoqqu histti xeellidi, «Zekkiyoosaa! Hach ta ne keeththan pe7anaas bessees; elela wodhdha» gides.<verse eid="LUK 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6"/>Izikka eleli wodhdhidi ufayssan mokki ekkides. <verse eid="LUK 19:6"/><verse number="7" style="v" sid="LUK 19:7"/>He wode heen izara diza asay hessa be7idi, «Nagaranchcha keeththan imato maana gees» giidi wurikka ba giddon zuuzumettida.<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>Gido attiin Zekkiyoosi eqqidi, «Godoo! Tani taas diza miishshe ubbaafe bagga shaakkada manqotas immana; tani oonappeka wordora bonqqa ekkidaazi diikko oyddu kushe gujjada izaades immana» gides.<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>Yesusikka, «Ha addezi Abrahaame naa gidida gishshas hach ha keeththaas paxateththi yides» gides.<verse eid="LUK 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 19:10"/>Hayssas gaasoykka Asa Nay haa yiday dhaydayssa koyanaassinne ashshanaassa.<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">Mato 18:11</ref></char></note> <verse eid="LUK 19:10"/><verse number="11" style="v" sid="LUK 19:11"/>Asay hayssa siyishin leemisora haasaya oykkides; gaasoykka izi Yerusalaame gakkanaas matida gishshassinne asatas Xoossa Kawoteththi qonccana haniza misatida gishshassa.<note caller="-" style="x"><char style="xo" closed="false">19:11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Mato 25:14-30</ref></char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>Hessa gishshas, «Issi kawoy ba kawoteththa shuumeteth ekki yaanaas haaho biitta bides. <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>Ba ashkarata giddofe tammata xeygidi tammu minaane<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fqa" closed="false">Minaane: </char><char style="ft" closed="false">Minaaney miishshati ay lagge deexxizaakko eranaas maaddiza miishsha; qasseka miish gididi zal7eska maaddees; issi minaaney he wode issaades heedzdzu gallassas ooso damoza likke gidana.</char></note> isttas immidi, ‹Ta simmada yaana gakkanaas hayssa miishshaan zal7ite› gides.<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>«He dere asati qasse iza ixxida gishshas, ‹Hayssi addezi nu bolla kawotana mala koyokko› giidi as iza geedora kiita aaththi yeddida.<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>«Gido attiin ha kawo naazi kawo gididi guye ba dere simmides. Kase bishe tammu minaane immida tammu ashkarati izi immida biraan zal7idi ay keena tirfisidaakko eranaas istta xeygides.<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>«Isttafe koyrozi shiiqidi, ‹Godoo! Ne taas immida tammu minaaney hara tammu yelides› gides.<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>«Godazikka iza, ‹Ne ammanettida ashkara; lo7o ooththadasa. Guuththa miishshan ne ammanettida gishshas tammu katamata ne haarana mala nees immadis› gides.<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>«Nam7anththozikka izakko shiiqidi, ‹Godoo! Ne taas immida minaaneppe hara ichchashu minaaney wodhdhides› gides.<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>«Iza godazi izas zaaridi, ‹Neni ayssana mala tammu katamati nees imettida› gides.<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="LUK 19:20-21"/>«Qasseka hankko oosanchchay shiiqidi, ‹Godoo! Neni woththonttasoppe ekkizaade; zeronttasoppe maxizaadenne menxe iita as gidida gishshas ta nees babbada carqqan xaaxa woththida ne minaaneyo hey ekka› gides.<verse eid="LUK 19:20-21"/></para>
  <para style="p">
    <verse number="22-23" style="v" sid="LUK 19:22-23"/>«Iza godazi zaaridi izas, ‹Haysso iita oosanchchazoo! Ta ne qaalan nena zaara pirdays. Tani woththonttasoppe ekkizaadenne zeronttasoppe maxiza menxe iita as gididayssa eraasashin tani ta miishshaa yelora ekkana mala he miishshaan ooththana asatas aazas immabeekkii?› gides.<verse eid="LUK 19:22-23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>«Iza godazikka heen eqqida asata, ‹Iza kusheppe minaaneza ekkidinne tammu minaaney dizayssas immite› gides.<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>«Isttika zaaridi, ‹Godoo! Izas tammu minaaney deesko› gida.<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26-27" style="v" sid="LUK 19:26-27"/>«Izikka, ‹Dizaades ubbaas haray gujettana; bayndaades kase dizayssi izappe ekettichchana.<note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mato 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luqa 8:18</ref></char></note> Gido attiin tani istta bolla kawotontta mala koyidayta hayta ta morkketa taakko haa ehidi ta sinththan shukkite› gi zaarides» gides.<verse eid="LUK 19:26-27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>Hessa haasayi simmidi Yesusi Yerusalaame kezanaas isttafe sinththati bides. <verse eid="LUK 19:28"/><verse number="29-31" style="v" sid="LUK 19:29-31"/>Dabrazayte geetettiza zumaa bolla diza Betefaagenne Bitaaniya geetettiza katamatakko matida wode bana kaallizaytappe nam7ata, «Heen intte sinththan diza qeeri katamayo biite; biidi katamayo intte gelishin oonikka toggi erontta issi qashetti diza hare gutte intte demmana; iza birshidi haa taas ekki yiite; inttena oonikka, ‹Aazas birsheetii?› giidi oychchiko, ‹Godaas koshshees giite› » gi kiittides.<verse eid="LUK 19:29-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>Kiitettidaytikka biidi izi isttas yootida mala hare gutteza demmida. <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>Istti gutteza birshiin gutteza godati be7idi, «Aazas birsheetii?» giidi oychchida.<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>Isttika, «Godaas koshshees» gida. <verse eid="LUK 19:34"/><verse number="35" style="v" sid="LUK 19:35"/>Hare gutteza Yesusaakko ehidi ba may7o ubbaa gutteza bolla yeggidi hare gutteza bolla Yesusa togisida. <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>Asay wurikka ba afala Yesusi biza oge bolla miccides.<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37-38" style="v" sid="LUK 19:37-38"/>Dabrazayte zumaa bollara duge woththiza ogezakko matida wode qooday baynda derey ba be7ida malaata gishshas wurikka ufayssara ba qaala dhoqqu histtidi, «Godaa sunththan yiza kawoy anjjettidayssa; saroy salon, bonchchoy saloppe bolla salon gido» gides.<note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Maza 118:26</ref></char></note><verse eid="LUK 19:37-38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>Deraappe issi issi Farsaaweti Yesusa, «Astamaaree! Ha nena kaalliza asay gizayssa gontta mala hanqa» gides.<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>Izikka isttas zaaridi, «Hayti co7u gidaakko shuchchatikka waassana» gides.<verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41-43" style="v" sid="LUK 19:41-43"/>Yesusi Yerusalaame matishe katamayo be7idi izis yeekkides. «Nees saro gidizaaz hach ne eridaakko aazee dizay? Ha7i ne ayfeppe qotettida gishshas ne morkketi heera haara nena giddoththidi un7eththana wodey yaana. <verse eid="LUK 19:41-43"/><verse number="44" style="v" sid="LUK 19:44"/>Nenanne ne gibbe giddon nenara diza ne nayta ubbaa biitta kessana; shuchchaaka shuchcha bollafe laallontta aggettenna. Hessi wurikka Xoossi nena koyishin neni erontta aggida gishshassa» gides.<verse eid="LUK 19:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>Hessafe kaallidi Yesusi Xoossa Keeththe gelidi Xoossa Keeththa giddon zal7izayta kessides. <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>Qasseka, «Ta keeththay Woosa Keeth gidana geetetti xaafettides; intte gidikko pangay diza gongolo histtideta» gides.<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Er 7:11</ref></char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>Wontiin wontiin Xoossa Keeththan izi tamaarsishin xaafetinne dere halaqati iza wodhanaas koyida.<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">Luqa 21:37</ref></char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>Gido attiin derey wurikka izara oykettidi izi tamaarsizayssa kaalliza gishshas ooththanaazi isttas kirqi gides.<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">Yesusa Wolqqa Paaccana Shiiqida Oysha</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mato 21:23-27</ref>; <ref loc="MRK 11:27-33">Mar 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>Issi gallas Yesusi asaa Xoossa Keeththan tamaarsishininne Mishiraachcho qaala sabbakishin qeese halaqati, xaafetinne dere Cimati shiiqettidi izakko yida. <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>«Hayssa ne ooththizay oona shenenee? Nees shene immiday oonee?» giidi iza oychchida.<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>Izikka isttas, «Tanikka inttena issi oysho oychchays; ane taas zaarite. <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>Yohannisa xinqatay saloppeyee? Asappee?» gides.<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>Isttika ba giddon issoy issaara, «Nu, ‹Yohannisa xinqatay saloppe› giikko izi nuna, ‹Histtiin aazas ammanibeekketii?› gaana. <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>‹Asappe› giikko asay wuri Yohannisi nabe gididayssa ammaniza gishshas nuna shuchchara caddana» gi zorettida.<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>Hessa gishshas, «Izi awappeko nu erokko» giidi zaarida.<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>Yesusikka histtiko, «Tanikka aaza wolqqan ooththizaakko inttes yootikke» gides.<verse eid="LUK 20:8"/></para>
  <para style="s1">Woyne Atakilte Goshshanchchata Leemiso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mato 21:33-46</ref>; <ref loc="MRK 12:1-12">Mar 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>Qasseka Yesusi asaas leemisora, «Issaadey woyne mith tokkides; gade goyizaytas kira immidi hara dere biidi heen gam7ides.<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa 5:1</ref></char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>Kaxxiza bone wode kaththaafe ekki yaana mala ba ashkaratappe issaade gadeza goyida asataakko yeddiin gadaa goyizayti kiitetti bidayssa qoxxidi mela kushe yeddida. <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>Kaaleththidikka hara ashkara yeddiin goshshanchchati ha7ikka oykki qoxxidinne kawushshidi mela yeddida. <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>Ha7ikka kaaleththidi heedzdzanththo ashkaraa yeddiin goshshanchchati izakka qoxereththi madunththidi kare kessi yeggida.<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>«Woyne miththaa goday, ‹Ha7i ay ooththoo? Oonee erizay ta keeha siiqiza ta naaza yeddidaakko iza bonchchandettoshaa?› gides.<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>«Gido attiin biitta goyizayti naaza be7ida mala ba giddon, ‹Hayssi iza laattana naaza gidennee? Haa yiite; iza wodhidi biittaa laattoos› giidi zorettida. <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>Woyne miththaa tokkidasoppe kare kessidi naaza wodhida. Histtiko ha7i woyne miththaa goday ha asata wosttanee? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>Yiidinne he goshshanchchata dhayssana; woyne mith tokkizasohoza haratas immana» gides; dereykka hessa izi gidayssa siyidi, «Hayssa malay hanoppo» gides.<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>Yesusikka, «Isttako xeellidi, ‹Histtiin shuchchan keeththe keexxiza asati leqqi aggida shuchchay keeththas waanna hu7e gidana geetettidi xaafettida leemisozas birsheththay aazee?›<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Maza 118:22</ref></char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>Ha shuchchaa bolla kundiday wuri shuchchaan qoxettana; shuchchayka iza bolla wodhdhidaadey wurikka liiqana» gides.<verse eid="LUK 20:18"/></para>
  <para style="s1">Giira Qanxxo Gishshas Shiiqida Oysha</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>Xaafetinne qeeseta halaqati hessi leemisozi istta bolla haasayettidayssa eridi heerakka iza oykkanaas koyida shin derezas babbida. <verse eid="LUK 20:19"/><verse number="20" style="v" sid="LUK 20:20"/>Yesusa wolqqara haarizaytas aaththi immanaas iza doonappe keziza bala qaala demmidi oykkanaas kaalli kaalli naagidanne xillo asa misatidi iza kaalli iza doonappe yo7o naagiza asata izakko yeddida. <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>Iza doonappe yo7o koyza asati Yesusa, «Astamaaree! Neni tumaa haasayzayssanne tumaa tamaarsizayssa; qasseka Xoossa oge ne tumu tamaarsizayssanne oonakka shaakka maaddonttayssa nu eroos. <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>Gido attiin Qeesaares giira giiranaas bessizee? Bessennee?» giidi oychchida.<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>Izikka isttas diza gene qofaa eridi, <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>«Ane issi dinaare tana bessite, hayssi iza bolla diza medhazinne xaafettoyssi oonayssee?» gides. Isttika, «Qeesaareyssa» gida.<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>Izikka zaaridi isttas, «Qeesaareyssa Qeesaares, Xoossayssa Xoossas immite» gides.<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>Hessa gishshas izi haasayda qaalappe ekkidi asaa sinththan iza qaxxanaas dandaybeettenna; izi immida qaalan malalettidi co7u gida.<verse eid="LUK 20:26"/></para>
  <para style="s1">Hayqqidayta Denththa Gishshas</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mato 22:23-33</ref>; <ref loc="MRK 12:18-27">Mar 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>Hayqqidayta denththi baa giza Saduqaawetappe issi issi asati Yesusaakko yiidi oysha shiishshida.<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa 23:8</ref></char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>«Godoo! ‹Issaadey machcho ekkidi naa yelontta hayqqiko he hayqqidayssa machcheyo iza ishay ekkidi ba ishaa laattana naa izas yelo› giidi Musey nuus xaafides.<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref></char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>Histtiin laappun ishati deettes shin isttafe bayrazi machchidi naa yelontta hayqqides. <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>Iza kaalozikka izaththo hayqqides; <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>heedzdzanththozikka izo ekkides; laappunati wurikka he maccassayo ekkidi wurikka naa yelontta hayqqida. <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>Wurseththan maccassaya hayqqadus. <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>Laappunatikka ha maccassayo ekkidashin ha maccassaya wurseththan hayqqidayti dendiza wode iza awayssa machcho gidanee?»<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>Yesusi isttas, «Ha alame nayti geleettessinne ekkeettes. <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>Buro yaana alamen hayqqidayta denththaa demmanaas bessizayti gidikko gelettenanne ekkettenna. <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>Istti kiitanchchata mala gidana gishshas hessafe guye hayqqettennanne hayqoppe denththa nayta gidida gishshas istti Xoossa nayta. <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>Musey qeeri wora gishshas xaafettida taarikezan Godaa, ‹Abrahaame Xoossaa, Yisaaqa Xoossaa Yaaqoobe Xoossaa› guussan hayqqidayti dendanayssa bessees.<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref></char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>Wurikka izas de7oy diza gishshas izi paxata Xoossafe attiin hayqeththata Xoos gidenna» gides.<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>Issi issi xaafeti, «Astamaaree! Lo7o gadasa» gida. <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>Hessafe guye ay asikka iza oychchanaas xalibeenna.<verse eid="LUK 20:40"/></para>
  <para style="s1">Xoossay Tiydayssa Gishshas Shiiqida Oysha</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mato 22:41-46</ref>; <ref loc="MRK 12:35-37">Mar 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>Hessafe guye Yesusi, «Asay Masihe waanidi izi Dawite naa gizee? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>Gaasoykka Dawiti ba xaafida mazamure maxaafatan, ‹Ta ne morkketa ne toho gars aaththana gakkanaas Goday ta Godaa, ne ta ushachchan utta› waanidi gidee?<note caller="-" style="x"><char style="xo" closed="false">20:42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maza 110:1</ref></char></note> <verse eid="LUK 20:42-43"/><verse number="44" style="v" sid="LUK 20:44"/>Histtiko Dawiti iza, ‹Godaa› gi xeygishe waani izas naa gidanee?» gides.<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>Derey wuri siyishin bana kaallizaytas, <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>«Gooshettiza adussa qamisa may7idi yuushshe dosizaytappe giyay dizason saroketeth koyzaytappenne Ayhuda Woosa Keeththan dhoqqa oydenne diggisason bonchchoso koyza xaafetappe naagettite. <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>Haytanti am7eta keeth kallosizayta; asi istta beyana mala woosa adusseettes; heytantta iita pirday naagees» gides.<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">Am7ey Imota</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>Yesusi dhoqqu gi xeellishin dure asati Xoossa Keeththen muxuwaata izan shiishshizayssa giddon muxuwaata yeggishin be7ides. <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>Qasseka issi am7o dizaara nam7u sikkina gidiza nam7u xarqimala he muxuwaata izan shiishshizayssan yeggishin xeellidi, <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>«Ta inttes tumu gays; hanna am7eya ubba asaappe bollara aadheth immadus. <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>Hayti asati immiday baas diza tirpafe gidishin iza gidikko baas baynda wolqqaafe baas dizaaronne ba duussas koshshizaaro wursa yeggadus» gides.<verse eid="LUK 21:4"/></para>
  <para style="s1">Xoossa Keeththi Laalettanayssa Yesusi Kaseti Yootida Qaala</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mato 24:1-2</ref>; <ref loc="MRK 13:1-2">Mar 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5-6" style="v" sid="LUK 21:5-6"/>Iza kaallizaytappe issi issi asati Xoossa Keeththay lo7o shuchchaninne asay immida imotan ay mala lo7i keexettidaakko giidi ba giddon haasayettishin Yesusi siyidi, «Hayssi intte be7izayssi wuri laalettontta shuchchi shuchcha bolla keelettida mala attontta wodey yaana» gides.<verse eid="LUK 21:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>Isttika iza, «Astamaaree! Hayssi wuri ayde hananee? Qasse hayssi hananayssas malatay aazee?» giidi oychchida.<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>Izikka isttas, «Intte balettontta mala naagettite; daroti bana, ‹Ta Kirstoosakko! Wodeykka matides› gishe ta sunththara yaana shin intte istta kaallofte. <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>Ola gishshassinne dere makkallateththa gishshas siyiza wode dagammofte. Hessi wuri kasetidi hananaas bessees; wurseththi gakkides; gido attiin heerakka hanenna» gides.<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>Qasse, «Derey dere bolla, kawoy kawo bolla dendana. <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>Biittay wolqqama qaath qaaxxana; koshaynne boshay dumma dummason hanana; daro babisizaazinne saloppe gita malatay beettana.<verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>«Hessi wuri hananaappe kasetidi asay inttena oykkananne gooddana; Ayhuda Woosa Keeththinne qasho keeth gelththana; kawota sinththinne daannata sinth shiishshana. Hessi wuri ta sunththa gishshas intte bolla gakkana. <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>Hessi wurikka markkattanaas lo7o qaada gidana. <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>Hessa gishshas nuna oychchizaytas nu ay zaarinoo? giidi kasetidi hirgontta mala hayssa wozinan woththite.<note caller="-" style="x"><char style="xo" closed="false">21:14-15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">Luqa 12:11-12</ref></char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>Intte morkketappe oonikka inttenara eqettanaassinne baleththanaas dandayontta qaalanne cinccateth ta inttes immana. <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>Inttena yelidaytinne intte ishati, intte dabbotinne intte laggeti wuri inttena aaththi immana; inttefe baggata wodhana. <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>Ta sunththaa gishshas ubba asaa achchan intte ixettana. <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>Gido attiin intte hu7e binanatappe issinakka dhayukku. <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>Intte minni eqqiko intte shempo ashshana.<verse eid="LUK 21:19"/></para>
  <para style="s1">Yesusi Yerusalaame Dhayo Gishshas Kasetidi Yootida Qaala</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mato 24:15-21</ref>; <ref loc="MRK 13:14-19">Mar 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>«Ola asay Yerusalaame giddoththishin beyikko izis dhayza wodey matidayssa erite. <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>He wode Yuhudan dizayti pude zuma bolla gangetto; kataman dizaytikka katamappe kezite; dere giddon dizaytikka he katamayo geloppetto. <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>Xaafettidayssi wuri polettanaas hanna halo kessiza wode.<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">Hose 9:7</ref></char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>Biitta bolla gita metoy hanana; hayssa dereza bolla hanqoy yaana; hessa gishshas he wode qanththara diza maccassatassinne dhanththiza aayetas aayye ana! <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>Bagga asay mashshan hayqqana; ba dereppe hara dere di7ettana; Yerusalaameykka Xoos erontta dereta wodey polettana gakkanaas, Xoos erontta asatan yedhettidaaro gidana.<verse eid="LUK 21:24"/></para>
  <para style="s1">Asa Naas Nam7anththo Yuus</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mato 24:29-31</ref>; <ref loc="MRK 13:24-27">Mar 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>«Arshe bolla, agina bollanne xoolintte bolla malatay beettana; abbaafenne abba dambala giirissafe dendidayssan biitta bolla diza derey hirgananne metotana.<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="EZK 32:7">Hizi 32:7</ref>; <ref loc="JOL 2:31">Iyu 2:31</ref>; <ref loc="REV 6:12-13">Ajju 6:12-13</ref></char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>Salo wolqqamati qaaxxiza gishshas asay biitta bolla aazee hananeeshaa guussaninne naagon xalla daaburana. <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>He wode Asa Nay wolqqara, gita bonchchoranne shaarara yishin beyana.<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>; <ref loc="REV 1:7">Ajju 1:7</ref></char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>Intteka hayti ha ta gidayti poleteth oykkishin inttes ateththa wodey matida gishshas sitti gi eqqite; intte ayfe pude dhoqqu histtite» gides.<verse eid="LUK 21:28"/></para>
  <para style="s1">Godaa Yuussaa Malatiza Balase Miththay Leemiso</para>
  <para style="p">
    <verse number="29-30" style="v" sid="LUK 21:29-30"/>Kaaleththidi, «Balase miththinne hara miththata ubbaa xeellite; he miththati hayth kessishin intte be7iza wode boney matidayssa intte ereeta. <verse eid="LUK 21:29-30"/><verse number="31" style="v" sid="LUK 21:31"/>Hessaththoka haytanti geetettidayti polettishin intte be7iza wode Xoossa Kawoteththi intteko matidayssa erite.<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>«Ta inttes tumu gays; hayssi wuri polettana gakkanaas ha yeletay aadhdhenna. <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>Saloynne sa7ay aadhdhana shin ta qaalay aadhdhenna.<verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>«Histtiko wogay baynda duussan, daro ushshaninne duussas hirgan intte wozinay daaburoppo; hessa ooththontta ixxiko he gallassay intte qoppontta narxa mala intte bolla gakkontta mala naagettite. <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>Hayssi biitta bollan diza asaa ubbaa bolla gakkana. <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>Hessa gishshas buro yaanayssafe intte kessi ekkana malanne Asa Naa sinththan eqqanaas dandayana mala ubba gallas minnidi woossite» gides.<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>Yesusi gallas gallas Xoossa Keeththan tamaarsi tamaarsidi omars omars Dabrazayte geetettiza zuma bolla kezi kezi aqees.<note caller="-" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref></char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>Asay wurikka izappe siyanaas maalado wonttara Yesusaakko Xoossa Keeththe yees.<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">Yesusa Bolla Maqeteth</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mato 26:1-5</ref>; <ref loc="MAT 14:16">14:16</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>He wode Paaziga geetettiza ukeththara bonchchettiza ba7aaley mati uttides.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref></char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>Qeeseta halaqatinne xaafeti hankko dere asaas babbiza gishshas Yesusa dhayssana oge koyida.<verse eid="LUK 22:2"/></para>
  <para style="s1">Yesusa Aaththi Immanaas Yuhuda Zoreteth</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mato 26:14-16</ref>; <ref loc="MRK 14:10-11">Mar 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3"/>Yesusa kaalliza tammanne nam7atappe Asqoronto dere as Yuhuda geetettizayssan Xala7ey gelides. <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>Yuhudaykka qeeseta halaqataakkonne Xoossa Keeththa alaafetakko biidi isttas Yesusa wostti aaththi immanakko isttara zorettides. <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>Isttika hessan ufayettidi miishshe immanaas izara giigida. <verse eid="LUK 22:5"/><verse number="6-7" style="v" sid="LUK 22:6-7"/>Yuhudaykka istta qofaa dosides; Yesusa isttas asi be7ontta aaththi immanaas injje wode naagishin Paaziga dorsaa shukkidi ukeththara bonchchiza ba7aale gallassi gakkides.<verse eid="LUK 22:6-7"/></para>
  <para style="s1">Yesusi Bana Kaallizaytara Paaziga Kawo Muus</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mato 26:17-25</ref>; <ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="JHN 13:21-30">Yoha 13:21-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 22:8"/>Yesusikka bana kaallizayta, «Paaziga kawo maanaas biidi nuus giigsite» giidi Phexroosanne Yohannisa kiittides.<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>Isttika, «Nu awan giigsana mala koyay?» gida.<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>Izikka zaaridi, «Intte gede Yerusalaame katama gelishin haaththa oto tookkida asi inttena demmana; intteka izi biidi geliza keeththe gakkanaas iza kaallite. <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>Keeththaades, ‹Astamaarey tana kaallizaytara Paaziga kawo maanaas imaththa keeththi awan dizee?› gees giite. <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>Izikka imaththas giigettida aahoso inttena bessana; izi bessizason giigsite» gides. <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>Isttika biidi Yesusi gida mala keeththaa demmidi Paaziga heen giigsida.<verse eid="LUK 22:13"/></para>
  <para style="s1">Godaa Kawo Eko Woga</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mato 26:26-30</ref>; <ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="1CO 11:23-25">1Qoro 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14-15" style="v" sid="LUK 22:14-15"/>Wodey gakkida mala Yesusi Hawaaretara quma maaddan uttidi, «Tani waaye beyanaappe kasetada hayssa Paazigaa inttenara issife maanaas keeha amottadis. <verse eid="LUK 22:14-15"/><verse number="16" style="v" sid="LUK 22:16"/>Ta inttes tumu gays; Xoossa Kawoteththan hayssa birsheththi polettana gakkanaas hayssa Paazigaa nam7anththo ta inttenara miikke» gides.<verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>Woyneppe oosettida ushshaa xuu7ara ekkidi Xoossaa galati simmidi, «He7ite; wurikka izappe uyite» giidi isttas immides. <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>«Ta inttes tumu gays; hayssafe guye Xoossa Kawoteththi yaana gakkanaas nam7anththo ha woyne ushshaafe uyikke» gides.<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>Ukeththaa ekkidi Xoossaa galatides; izappe isttas menththi immidi, «Hayssi intte gishshas imettana ta asho leemiso gidiza gishshas hayssa ubba wode tana qoppanaas ooththite» gides. <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>Izaththoka kawoppe guye ushshaa xuu7a denththidi, «Hayssi ushshay intte gishshas ta suuththaan hanana ooraththa caaqo woga.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Er 31:31-34</ref></char></note><verse eid="LUK 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21"/>«Gido attiin tana aaththi immanaade kushey ta kushera issife maaddan dees.<note caller="-" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maza 41:9</ref></char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>Asa Nay kasetidi iza gishshas hananayssi wuri uttida mala izi baana; gido attiin iza aaththi immizaades aayye ana!» gides.<verse eid="LUK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23"/>Isttika hessa ooththanay oonee? giidi ba giddon issoy issaa oyshereththida.<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>Qasseka, «Ooni oonappe aadhdhizaakko» giidi ba giddon issoy issaara palamettida.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">Mato 18:1</ref>; <ref loc="MRK 9:34">Mar 9:34</ref>; <ref loc="LUK 9:46">Luqa 9:46</ref></char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>Yesusikka istta, «Dere haariza kawoti ba dere asaa wolqqara haareettessinne isttika lo7o kawota geetettidi xeygetteettes.<note caller="-" style="x"><char style="xo" closed="false">22:25-26 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">Mato 20:25-27</ref>; <ref loc="MRK 10:42-44">Mar 10:42-44</ref></char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>Intte gidikko hessaththo hanopite; inttefe gita gididaadey woykko ta ooppeka aadhdhays giza asi ubbaafe qeeri naa mala gido; haarizaadey haarettizaade mala gido.<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mato 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref></char></note> <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>Quma eqqidi mizidaadefenne uttidi mizaadefe ooni aadhdhizee? Uttidi mizaade gidennee? Tani qasse intte giddon ashkara mala days.<note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">Yoha 13:12-15</ref></char></note><verse eid="LUK 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28"/>«Intte gidikko taappe shaakettontta ta waayishin ta matan eqqidayta. <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/>Ta Aaway tana kawoththidayssa mala tanikka ta kawoteththaan inttena kawoththana. <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/>Hessika ta kawoteththan ta maaddafe intte maana malanne uyana mala; qasseka ta kawoteththa algan uttidi tammanne nam7u Isra7eele nayta bolla pirdanaassa» gides.<note caller="-" style="x"><char style="xo" closed="false">22:30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mato 19:28</ref></char></note><verse eid="LUK 22:30"/></para>
  <para style="s1">Phexroosi Iza Kaddanayssa Yesusi Kasetidi Yootides</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mato 26:31-35</ref>; <ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="JHN 13:36-38">Yoha 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>Qasseka Yesusi Simoona xeygidi, «Simoonaa! Xala7ey inttena gistte mala suragganaas woossides. <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>Gido attiin tani neeppe ammanoy dhayontta mala ne gishshas Xoossaa woossadis; nekka simmida wode ne ishata minththeththa» gides.<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>Simoonikka zaaridi, «Godoo! Ta nenara qashettanaassinne hayqqanaas giiga uttadis» gides.<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>Yesusikka zaaridi, «Phexroosaa! Hach kuttoy issito waassanaas, ‹Ta iza erikke› gaada heedzdzuto ne tana kaddana» gides.<verse eid="LUK 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>Qasseka Yesusi istta, «Ta inttena kase caammay, korojoynne qaraxiitey baynda kiittida wode inttes aazi paccidee?» gi oychchides. Isttika, «Aykkoyka paccibeenna» gida.<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">Mato 10:9-10</ref>; <ref loc="MRK 6:8-9">Mar 6:8-9</ref>; <ref loc="LUK 9:3">Luqa 9:3</ref>; <ref loc="LUK 10:4">10:4</ref></char></note><verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>Izikka zaaridi, «Ha7i gidikko korojoykka, qaraxiiteykka dizaadey oykko; giththa mashshay bayndaadey ba may7o bayzidi shammo. <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>Ta inttes tuma gays; ‹Makkallatara izi issife taybettides› geetetti kase xaafettida qaalay ta bolla polettana bessees; ta gishshas xaafettidayssas poloy tumappe gakkides» gides.<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref></char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>Iza kaallizayti qasse, «Godoo! Hekko nam7u giththa mashshati hayssan deettes» gida. Izikka iza gishshas, «Hayssi gidana» gides.<verse eid="LUK 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>Kase izas lose gidida mala pude Dabrazayte geetettiza zuma bolla kezi bides. Iza kaallizaytikka iza kaalli bida. <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>Hee gakkida mala, «Intte paacen gelontta mala woossite» gides. <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>Yesusi bana kaallizaytappe asi shuch olidi gaththanaaso mala haakki biidi gulbati woossides. <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>«Ta Aawawu! Ne shene gidikko hanno metoyo taappe digga; gido attiin ne sheney hanoppe attiin ta sheney hanoppo» giidi woossides. <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>Saloppe Kiitanchchay qonccidi Yesusa minththeththides. <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>Izikka keehi xuugettidi woossishin iza asateththaafe caway suuththa mala gukkides.<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>Woosappe dendidi bana kaallizaytakko bides. Isttika izas mishettidi qoppishin dhiskoy efidaashe Yesusi isttako yiidi, <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>«Ays dhiskeetii? Intte paacen gelontta mala ha7i dendidi woossite» gides.<verse eid="LUK 22:46"/></para>
  <para style="s1">Yesusi Aadhdhi Imeteththinne Oyketeth</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mato 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="JHN 18:3-11">Yoha 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>Izi buro haasayan dishin Yesusa kaallizaytappe issoy Yuhuda geetettizayssi banara daro asaa kaaleththi ekki yiidi Yesusa yeeranaas izakko shiiqides. <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>Gido attiin Yesusi iza, «Yuhudaa! Tana Asa Naa yeeron aaththa immay?» gides.<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>Yesusa yuuyi aadhdhi diza asay hanoza lo7eththi xeellidi, «Godoo! Haytantta mashshara buththinoo?» gida. <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>Isttafe issoy qeeseta alaafe ashkaraza ushachcha hayth mashshara qanxxides.<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>Yesusi istta, «Intte ha7i taas aggite!» giidi ashkaraza hayth bochchidi paththides.<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>Qasseka iza oykkana yida qeeseta halaqata Xoossa Keeththa alaafetanne cimata, «Panga oykkiza asa mala giththa mashshanne durqqa ekkidi yidetii? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>Gallas gallas ta inttenara Xoossa Keeththan dishin ta bolla kushe woththibeekketa; hayssi dhumay kawotida intte wode» gides.<verse eid="LUK 22:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>Hessafe guye Yesusa oykki ekkidi qeeseta halaqaso gelida; Phexroosikka Yesusa haahora kaallides. <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>Asay qeeseta halaqa gibbe giddon tama eeththidi ho7ishe issi bolla uttidaashe Phexroosikka isttara issife uttides. <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>Issi garadeya Phexroosi tama ho7izaytara uttidayssa beyadanne tishshi histta xeellada, «Hayssi addezikka Yesusara dees!» gadus.<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>Phexroosikka, «Hanne maccassayee! Ta iza erikke» giidi kaddides.<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>Guuth gam7ishin hara issaadey iza be7idi, «Nekka izara dizaytappe issaa gidikkii?» gides. Phexroosikka, «Haysso tani isttara diikke!» gides.<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>Issi saate mala gam7ishin hara asi qasseka, «Galila as gidiza gishshas sidhey baynda hayssi izara dees» gides.<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>Phexroosikka qasse, «Haysso ne gizaade ta erikke!» gides. Hinno gi kessontta dishin kuttoy waassides. <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>Godaykka Phexroosakko yishe xeelliin Phexroosi, «Hach kuttoy waassanaas ne tana heedzdzuto kaddana» giidi Goday kase yootoo qaalay iza wozinan karppi gides. <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>Phexroosikka kare kezidi hiqimi yeekkides.<verse eid="LUK 22:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>Yesusa qachchidi naagiza asatikka iza bolla qidhi qidhi kaa7ishe shocereththida. <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>Iza ayfe goozidi, «Ne nabe gidikko nena shociday oonakko ane era!» giidi oychchida. <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>Hara daro cashsha qaalara kawushshida.<verse eid="LUK 22:65"/></para>
  <para style="s1">Yesusa Ayhudata Pirda Duulata Sinth Efida</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mato 26:59-66</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="JHN 18:19-24">Yoha 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>Gadey wontiin dere Cimati, qeeseta halaqatinne Muse wogaa tamaarsizayti duulata shiiqidi Yesusa duulatakko shiishshida. <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>Isttika Yesusa, «Ne Kirstoosaa? Ane nuus yoota» gida. Yesusikka, «Ta inttes yootidaakkoka tana ammanekketa. <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>Ta inttena oychchidaakko taas zaarekketa. <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>Gido attiin ha7ippe doommidi Asa Nay wolqqama Xoossa ushachchan uttana» gides.<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>He wode wurikka, «Histtiin ne Xoossa Naa?»<note caller="+" style="f"><char style="fr" closed="false">22:70 </char><char style="ft" closed="false">Xoossa Naa? giza oyshay issi issi bagga Gamoththo qaalan Xoossa nay? geetetti oyshettees.</char></note> giidi oychchida. Izikka, «Ta Xoossa Naa gididayssa intteka geeta» gides.<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>Isttika, «Hekko izi ba doonara markkattishin nu hayththara siyidos; hayssafe hara markka aazas koshshizee?» gida.<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">Philaxoosa Sinth Yesusa Shiiqo</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mato 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="JHN 18:28-38">Yoha 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>Heen shiiqida asay wuri dendidi Yesusa Philaxoosakko ekki bides. <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>«Hayssi addezi nu asay Qeesaares giira giirontta mala baleththishenne bana, ‹Tani Kirstoosi kawo› giidi baleththishin demmidos» giidi mootida.<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>Philaxoosikka Yesusa, «Neni Ayhudata kawoo?» giidi oychchides. Yesusikka zaaridi, «Ne gida mala» gides.<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>Philaxoosikka qeeseta halaqatassinne shiiqida asaas, «Hayssa addeza bolla iza mootisiza iita yo7o demmabeekke» gides.<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>Istti zaaridi, «Hayssi addezi Galilappe hayssa gakkanaas kumeththa Yuhuda waayiso bolla dees» giidi minththi yootida.<verse eid="LUK 23:5"/></para>
  <para style="s1">Herdoosa Sinth Yesusa Shiiqo</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>Philaxoosi asay gizayssa siyidi, «Yesusi Galila asakkonne» giidi lo7eththi eranaas oychchides. <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>Yesusi Herdoosa Kawoteththa giddon dizayssa shaakki eridi he wode Herdoosi Yerusalaamen diza gishshas izakko Yesusa yeddides.<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>Herdoosikka kase Yesusa beyanaas daro koyishe diza gishshas Yesusa be7idi keehi ufayides; iza gishshas kase siyidi izi ooththishin beyanaas koyidi ufayettides. <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>Daro oyshatakka iza oyshereththides; gido attiin Yesusi iza oyshaa zaaribeenna. <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>Qeese halaqatinne xaafeti heen iza matan eqqidi keehi wordo mooto mootida. <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>Herdoosikka ba wottadaratara issife iza kadhida; kawo may7o mayzidi Philaxoosakko zaari yeddides. <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>Herdoosinne Philaxoosi kase ba giddon issoy issaara ooshsha shin he gallas giigida.<verse eid="LUK 23:12"/></para>
  <para style="s1">Yesusa Bolla Pirdettida Hayqo Pirda</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mato 27:15-26</ref>; <ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="JHN 18:39-40">Yoha 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>Philaxoosi qeeseta halaqatara, dere daannataranne dere asaa shiishshidi, <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>«Hayssi addezi asay wuri makkallana mala denththeththees giidi intte taakko ehiin ta qorada iza oyththiza issi iita miishshika demmabeekke. <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>Qasseka Herdoosi issi iita miishshika iza bolla demmontta aggida gishshas haa nuukko zaari yeddides. Ha7i intte be7iza mala iza hayqos gaththiza issi iita miishshika ooththibeenna. <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>Hessa gishshas qaxxayada ta iza yeddana» gides. <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>Izi hessa giday istta ba7aale gallas qashettida asappe issaade birshiza wogay diza gishshassa.<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 17 bolla diza qofa gujjeettes; qofazikka Marqoosan shempo 15:6 dizayssa misatees.</char></note><verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>Derey wurikka issi bolla, «Barbaane birshada hayssa addeza digga!» giidi waassides. <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>Barbaaney katama giddon asaa makkalla yo7on denththeththidi as wodhi qashettida asa.<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>Philaxoosikka Yesusa birshanaas koyida gishshas qasseka zaaridi oychchides. <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>Asay zaaridi iza, «Kaqqa! Kaqqa!» giidi waassides.<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>Philaxoosi heedzdzanththoka, «Aazas kaqqoo? Hayssi addezi ay iita ooththidee? Iza hayqos gaththiza iita ooso tani iza bolla beyabeekke; hessa gishshas qaxxayada ta iza birsha yeddana» gides.<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>Asaykka qaalaa dhoqqu histtidi Yesusi kaqettana mala Philaxoosa keehi woossishe waassides. <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>Hessa gishshas Philaxoosi istta oyshoy polettana mala azazides. <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>Asaa makkallisidi shempo wodhida gishshas qashettidayssa birshana mala istti woossidaade birshidi qasseka Yesusa istti dosida mala ooththetto giidi deraas aaththi immides.<verse eid="LUK 23:25"/></para>
  <para style="s1">Yesusa Kaqeteth</para>
  <para style="r">(<ref loc="MAT 27:31-44">Mato 27:31-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>Isttika Yesusa oykki ekki bishin Qareena geetettiza katamappe issi Simoona geetettiza addey haahoppe yizayssa demmida; Yesusi kaqettana masqale kocaa izi tookkidi Yesusa kaallana mala wolqqaththida.<verse eid="LUK 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27"/>Daro dereynne ba tira icci icci yeekkiza maccassati, <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>Yesusappe guyera iza kaallida. Yesusi isttako simmi xeellidi, «Intte Yerusalaame maccassay inttessinne intte naytas yeekkite attiin taas yeekkofte. <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‹Sinththafe intte hekko maynne gidida maccassati, yelontta ulotinne nay dhammontta dhanththati anjjettidayta!› gaana wodey sinththara yees. <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>He wode asay, ‹Zumatoo! Nu bolla woddite; zumbullatikka nuna qottite!› gaana.<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hose 10:8</ref>; <ref loc="REV 6:16">Ajju 6:16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>Histtiin qaye miththa bolla hayssaththo ooththidayti mela miththa bolla wosttaneesha?» gides.<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>Izara issife hayqqana mala hara nam7u iita ooththida asata izara efida. <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>Qaaraniyo geetettizaso gaththidi kaqqida; iita ooththidaytappe issaa ushachcha baggara, issaa hadirsa baggara kaqqida. <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>Yesusikka, «Ta Aawawu! Hayti ba ooththizayssa eridi ooththontta gishshas isttas atto ga!» gides; isttika iza may7oza saama yeggidi ba giddon gishetti ekkida.<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Maza 22:18</ref></char></note> <verse eid="LUK 23:34"/><verse number="35" style="v" sid="LUK 23:35"/>Hessi hanishin asay wuri eqqi xeellides; daannatikka, «Izi hara asaa ashshides shin Xoossafe doorettida Kirstoosi iza gidikko ane ha7i bana ashsho» giidi qidhida.<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maza 22:7</ref></char></note><verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>Wottadaratikka shiiqidi woyneppe agettida caala ushshu ushshidi iza qidhida.<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maza 69:21</ref></char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>«Neni Ayhuda kawo gidikkii? Ane ha7i nena ashsha» gida.<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>Iza hu7eppe bolla baggara masqale koca bolla, «Hayssi Ayhudata kawo» giza qaala xaafi qaaphida.<verse eid="LUK 23:38"/></para>
  <para style="s1">Nam7u Pangatara Yesusa Kaqeteth</para>
  <para style="r">(<ref loc="MAT 27:38-44">Mato 27:38-44</ref>; <ref loc="MRK 15:27-32">Mar 15:27-32</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>Iita ooththidi kaqettida asatappe issoy cashsha qaala Yesusa bolla qoqofides. «Ne Kirstoosa gidikkii? Ane nenakka nunakka ashsha» gides.<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>Iita ooththidaytappe issoy, «Neni nees bessiza pirda ekkashe Xoossas babbikii? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>Nuni nu ooththida iita oosos bessizayssa ekkoos; hayssi addezi gidikko issi iitakka ooththibeenna» gides.<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>Yesusa, «Neni ne kawoteththara yiza wode tana qoppa!» gides.<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>Yesusikka zaaridi, «Ta nees tumu gays; hach ne tanara Gannaten daana» gides.<verse eid="LUK 23:43"/></para>
  <para style="s1">Yesusa Hayqo</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mato 27:45-56</ref>; <ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>He wode gadey seeta gallas gidishin biidi uddufun saate gakkanaas kumeththa biitta bolla dhumay dhumides. <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>Arshe poo7oy digettides. Xoossa Keeththa magalashaykka daakettidi nam7u kezides.<note caller="-" style="x"><char style="xo" closed="false">23:45 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Kessa 26:31-33</ref></char></note> <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>Yesusikka keehi waassidi, «Ta aawawu! Tani ta shempo ne kushen immays» gida mala shempo kezides.<note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">Maza 31:5</ref></char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>Mato halaqay hessa be7idi, «Hayssi addezi tumappe xillo asakkoshin» giidi Xoossaa galatides.<verse eid="LUK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48"/>Hessa beyanaas heen shiiqidi derey wuri he hanidayssa be7idi tira icci iccidi simmides. <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>Gido attiin Yesusa kase lo7eththi erizayti wuri qasseka Galilappera iza kaalliza maccassati hessa xeellishe haakki eqqida.<note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luqa 8:2-3</ref></char></note><verse eid="LUK 23:49"/></para>
  <para style="s1">Yesusa Moogeteth</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mato 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>Ayhudata duulata asaappe issoy izikka Yooseefe geetettizayssi daro kiyanne xillo asa. <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>Izikka kase asay Yesusa bolla duulatishin he duulatan deenna; izikka Armatiyase geetettiza Ayhudata katama asa shin Xoossa Kawoteththi yaanayssa naagishe gam7ides. <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>Izikka Philaxoosakko biidi Yesusa ahaa baas immana mala Philaxoosa woossides. <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>Philaxoosi izas ero giin Yooseefey ahaa masqale kocappe woththida mala xaaxidi shuchchafe woocettida kase hara asi moogettontta duufon efidi woththides.<verse eid="LUK 23:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 23:54"/>He gallassay asay Sambatas giigettiza gallas gidida gishshas Sambatay gelana hanees.<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>Galilappe dendidi Yesusara yida maccassatikka Yooseefe kaalli biidi duufoza be7ida. Yesusa ahaa wostti woththidaakko be7ida. <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>Heeppe simmidi shittonne tiyiza miish giigsida. Wogay giza mala Sambata gallas shempida.<note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">Kessa 20:10</ref>; <ref loc="DEU 5:4">Zaare 5:4</ref></char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">Hayqoppe Yesusa Denth</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mato 28:1-10</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>Wogga wontta maaladora maccassati ba giigsida shittoza ekkidi Yesusa woththida duufozakko bida. <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>Shuchchayka duufoza doonappe genderidi dizayssa be7ida. <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>Gido attiin giddo gelidi Yesusa ahaa demmontta aggida gishshas, <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>isttas hanzaazi dhayiin istti tollu gidaashe qoppontta xolqettiza may7o may7ida nam7u asati istta achchan eqqida. <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>Maccassatikka keehi babbidi duge biitta xeellishin, «He asati paxidi dendidayssa hayqeththata giddon ays koyeetii? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>Izi dendides! Haan baa. Qasseka izi Galilan dishe inttes kase ay gidaakko ane qopite. <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/>Asa Nay nagaranchchata kushen aadhdhi imettanaassinne kaqettanaas, hayqoppeka heedzdzanththo gallas dendanaas bessees» giidi yooti woththides.<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mato 16:21</ref>; <ref loc="MAT 17:22-23">17:22-23</ref>; <ref loc="MAT 20:18-19">20:18-19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luqa 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref></char></note><verse eid="LUK 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>Maccassatikka he wode kase izi gida qaalaa akeekida. <verse eid="LUK 24:8"/><verse number="9" style="v" sid="LUK 24:9"/>Maccassati duufosoppe simmidi hessa ubbaa Yesusa kaalliza tammanne issinetassinne haratas yootida. <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>Hessaka Hawaaretas yootiday Magdale gizasoppe yida Maaramonne Yohaano geetettizaarira Yaaqoobe Maaramonne isttara issife diza hara maccassata. <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>Gido attiin isttas maccassati yootidayssi agumo misatiin ammanibeettenna. <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>Gido attiin Phexroosi woththan Yesusa duufokko gakki hokkidi duufoza giddo xeellishin iza ahaza xaaxida may7oy xalla dizayssa be7idi keehi malalettishe baso simmides.<verse eid="LUK 24:12"/></para>
  <para style="s1">Bana Kaalliza Nam7atas Yesusa Qoncceth</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mar 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>He gallas iza kaallizaytappe nam7ati Yerusalaameppe tammanne issi kilo metire haakkiza Emahoose geetettiza katama beettes. <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>Bishe istti he wode hanida Yesusa hayqo gishshas ba giddon haasayetteettes. <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>Istti haasayettishin Yesusi isttako shiiqidi isttara issife bishin, <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>istti iza erontta mala istta ayfey oykettides.<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>Yesusi istta, «Hayssi oge hemettishe intte intte giddon haasayettizayssi aazee?» gides. Isttika dagamara modhettishe sitti gi eqqaa gida. <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>Istta giddofe issoy Qaliyopha geetettizayssi zaaridi, «Ha mata gallassatan Yerusalaamen hanidayssa erontta imaththa asi nena xallaa?» gides.<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>Izikka isttas zaaridi, «Aazi hanidee?» giin istti qasse zaaridi, «Xoossa sinththaninne asa ubba sinththan oosoninne qaalan mino nabe gidida Naazirete Yesusa gishshassa» gida. <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>Izakka qeeseta halaqatinne daannati hayqo pirdas aaththi immidanne kaqqida. <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>Nuni gidikko, « ‹Isra7eele wozzanay iza› giidi ufayettidosishin harappeka hessi haniin qasse hach heedzdzanththo gallassa. <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>Qasse nu giddofe issi issi maccassati nuna keehi malalisida; isttika maalado wonttara gede iza duufokko biidi, <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>iza ahay beettontta ixxiin yiidi izi paxa dizayssa isttas yootiin Kiitanchchata be7idayssa nuus yootida. <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>Nuuppeka issi issi asati iza duufokko biidi maccassati gida mala be7ida attiin Yesusa demmibeettenna» gida.<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>Izikka isttas, «Intteno wozinan woththonttaytoo! Intte wozinay kase nabeti yootidayssa ammananaappe takkidaytoo! <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>Xoossafe kiitettidayssi ha metoza ekkanaassinne gede ba bonchchoso gelanaas bessennee?» gides. <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>Museppenne nabetappe doommidi Geeshsha Maxaafatan iza gishshas xaafettidayssa isttas lo7eththi yootides.<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>Istti ba bizaso matida wode Yesusi aadhdhi bizaa misatides. <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>Isttika qasse, «Gadey qammiza gishshas nunara aqa» giidi iza keehi woossiin isttara aqanaas gelides. <verse eid="LUK 24:29"/><verse number="30" style="v" sid="LUK 24:30"/>Isttara issife maaddan uttidi uketh ba kushen oykkidi isttas menththi menththi immides. <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>He wode istta ayfey doyettiin iza gididayssa erida; izikka istta ayfeppe geemmides. <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>Isttika, «Nu yishe oge bolla dishin nuna haasayssidi Geeshsha Maxaafatakka qonccisidi nuus gelanaashe yootiin nu wozinay tama mala xuugettibeennee?» giidi issoy issaara haasayettida.<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>Heerakka dendidi Yerusalaame simmi bida; tammanne issinetinne isttara issife dizaytikka issi bolla shiiqi dizayta demmida. <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>Isttika ba giddon issoy issaas, «Goday tumu dendides! Simoonaska beettides» gida.<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>Iza kaallizaytappe nam7ati oge bolla hanidayssanne Yesusi ukeththaa menththi menththi immida wode istti wostti eridaakko isttas yootida.<verse eid="LUK 24:35"/></para>
  <para style="s1">Yesusi Bana Kaallizaytas Qoncceth</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mato 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>Hessa gishshas istti ba giddon haasayettishin Yesusi istta giddon eqqidi, «Saroy inttes gido!» gides.<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>Gido attiin istti moytille be7idaa misatiin keehi dagammida. <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>Izikka isttas, «Aazas daro qoppeetii? Aazas intte wozinara sidheetii? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>Ta kushetanne ta tohota haa xeellite; tanakko; qasseka tana oykki be7ite; tana intte be7izayssa mala moytilles ashoynne meqeththi deenna» gides.<verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>Hessa gi simmidi ba tohotanne ba kusheta istta bessides. <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>Isttika ufayssa daroppenne malaleteththafe dendidayssan buro ammanontta dishin Yesusi, «Hessan aykko mizaazi dizee?» giidi istta oychchides. <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>Isttika mole xiixa issi bars izas immida. <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>Izikka ekkidi istta sinththan mides.<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>Izikka, «Inttenara ta diza wode, ‹Muse wogan nabetaninne yeththa Maxaafatan ta gishshas xaafettidayssi wurikka polettanaas bessees› gaada ta inttes yootida ta qaalay hayssako» gides.<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>He wode Geeshsha Maxaafata istti erana mala wozina isttas doydes. <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>Isttaskka, «Kirstoosi waaye beyana; heedzdzanththo gallas hayqoppe dendana geetetti xaafettides. <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>Yerusalaameppe doommidi ubba deres nagarappe simoynne maaroteththi iza sunththan yootettana. <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>Intteka hayssas markkatta. <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>Tanikka ta Aaway immida ufayssaa inttes yeddana; intte qasse wolqqa bollafe may7ana gakkanaas Yerusalaame kataman takkite» gides.<note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">Hawa 1:4</ref></char></note><verse eid="LUK 24:49"/></para>
  <para style="s1">Pude Salo Yesusa Buus</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16:19-20</ref>; <ref loc="ACT 1:9-11">Hawa 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>Hessafe guye istta ekkidi Bitaaniya geetettizaso kezides. Ba kushetakka denththidi istta anjjides.<note caller="-" style="x"><char style="xo" closed="false">24:50-51 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">Hawa 1:9-11</ref></char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>Istta anjjishe isttafe shaakettidi pude salo bides. <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>Isttika izas hokki goynnida; keehi ufayettishe Yerusalaame simmida. <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>Ubba wode Xoossa Keeththan Xoossaa galatishe gam7ida.<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
