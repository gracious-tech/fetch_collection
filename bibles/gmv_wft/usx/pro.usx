<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Gamo Full Bible final version</book>
  <para style="h">Leemiso Maxaafa</para>
  <para style="toc1">Leemiso Maxaafa</para>
  <para style="toc2">Leemiso Maxaafa</para>
  <para style="toc3">Leemi</para>
  <para style="mt1">Leemiso Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Leemiso Maxaafay tosseninne Leemiso haasayan giigida oosonne ammano timirte. Izappe dariza baggay asaa de7on hach hach gayttiza hanota gishshas yootees. Koyroppe doommishe, «Aadho erateththas koyroy Xoossas yashshateth» giza qofa hassa7isson doommees. Izikka tamaarsizayssi ammano wogan asi ooththanayssa xalla gidontta, asi baas hach hach de7on hananaas bessiza lo7o kandonne ooththanaas bessiza lo7o ooso gujjidi tamaarssees. Ha maxaafa giddon ashketeththa gishshas, dandaya gishshas, asas qadheteththa gishshassinne ammaneteththa gishshas daro timirtey leemison imettides.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Leemisota wostti go7ettanaakko bessiza oge <char style="ior"><ref loc="PRO 1:1-7">1:1-7</ref> </char></para>
  <para style="io1">Aadho erateth koyana mala imettida zore <char style="ior"><ref loc="PRO 1:8-7:27">1:8—7:27</ref> </char></para>
  <para style="io1">Erateth sabbanaas yexettida mazamure <char style="ior"><ref loc="PRO 8:1-9:18">8:1—9:18</ref> </char></para>
  <para style="io1">Solomoone leemisota <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref> </char></para>
  <para style="io1">Agurey haasayda yo7ota <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref> </char></para>
  <para style="io1">Limu7eele aaya ba naaza tamaarsida timirte <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Leemisota Wostti Go7ettanaakko Bessiza Oge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 1:1" />Hayti Isra7eele Kawo Dawite naa</para>
  <para style="q2" vid="PRO 1:1">Solomoone leemisota.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1Kawo 4:32</ref></char></note><verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Leemisoti asay aadho erateththa,</para>
  <para style="q2" vid="PRO 1:2">seeranne erateththa haasaya</para>
  <para style="q2" vid="PRO 1:2">akeekanaas maaddeettes.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Isttika de7ana de7on</para>
  <para style="q2" vid="PRO 1:3">aadho erateth,</para>
  <para style="q2" vid="PRO 1:3">xilloteth, suure pirdanne</para>
  <para style="q2" vid="PRO 1:3">suure hano tamaarsizayta.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Erateththi paccidaytas akeeka,</para>
  <para style="q2" vid="PRO 1:4">naateththatas erateththinne</para>
  <para style="q2" vid="PRO 1:4">wozinamateth immizayta.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Aadho eranchchati</para>
  <para style="q2" vid="PRO 1:5">ha leemisota siyidi</para>
  <para style="q2" vid="PRO 1:5">erateth gujjeettes;</para>
  <para style="q2" vid="PRO 1:5">akeekanchcha asatikka</para>
  <para style="q2" vid="PRO 1:5">lo7o zoreta ekkeettes.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Hessa malan leemisotanne</para>
  <para style="q2" vid="PRO 1:6">istta birsheththata,</para>
  <para style="q2" vid="PRO 1:6">aadho eranchchata haasayanne</para>
  <para style="q2" vid="PRO 1:6">istta maaleththo</para>
  <para style="q2" vid="PRO 1:6">akeekanaas dandayeettes.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Aadho erateththas koyroy</para>
  <para style="q2" vid="PRO 1:7">GODAAS yashshateththa;</para>
  <para style="q2" vid="PRO 1:7">eeyati gidikko</para>
  <para style="q2" vid="PRO 1:7">aadho erateththinne</para>
  <para style="q2" vid="PRO 1:7">seera kadheettes.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo 28:28</ref>; <ref loc="PSA 111:10">Maza 111:10</ref>; <ref loc="PRO 9:10">Leemi 9:10</ref></char></note><verse eid="PRO 1:7" /></para>
  <para style="b" />
  <para style="s1">Yelaga Naytas Imettida Zore</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Ta naazoo!</para>
  <para style="q2" vid="PRO 1:8">Ne aawa zore ezga;</para>
  <para style="q2" vid="PRO 1:8">ne aaya tamaarsizayssaka aggofa.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Hessi ne hu7es</para>
  <para style="q2" vid="PRO 1:9">bonchcho kallachcha;</para>
  <para style="q2" vid="PRO 1:9">nees qoodhen aaththiza</para>
  <para style="q2" vid="PRO 1:9">alleqo mala gidana.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Ta naazoo!</para>
  <para style="q2" vid="PRO 1:10">Nena nagaranchchati</para>
  <para style="q2" vid="PRO 1:10">baleththiko eeno gooppa.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Istti nena, «Ane haa ya;</para>
  <para style="q2" vid="PRO 1:11">issife biidi</para>
  <para style="q2" vid="PRO 1:11">suuth gussanaas zuggoos;</para>
  <para style="q2" vid="PRO 1:11">xillotakka wodhanaas</para>
  <para style="q2" vid="PRO 1:11">qotetti uttoos.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Duufoy mittiza mala</para>
  <para style="q2" vid="PRO 1:12">nunikka ane istta</para>
  <para style="q2" vid="PRO 1:12">paxa dishin mittoos;</para>
  <para style="q2" vid="PRO 1:12">nuni istta ciimma ollan</para>
  <para style="q2" vid="PRO 1:12">olettiza asa mala</para>
  <para style="q2" vid="PRO 1:12">ane ooththoos.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Nuni al7o miish</para>
  <para style="q2" vid="PRO 1:13">ubbaa demmana;</para>
  <para style="q2" vid="PRO 1:13">histtidi nu keeththa</para>
  <para style="q2" vid="PRO 1:13">bonqqi ekkida</para>
  <para style="q2" vid="PRO 1:13">miishshan kunththana.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Nunara zuppeta;</para>
  <para style="q2" vid="PRO 1:14">demmidaaz issife</para>
  <para style="q2" vid="PRO 1:14">go7ettana» gaana.<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Ta naazoo!</para>
  <para style="q2" vid="PRO 1:15">Isttara issife</para>
  <para style="q2" vid="PRO 1:15">oge hemettofa;</para>
  <para style="q2" vid="PRO 1:15">istti biza oge baana gaada</para>
  <para style="q2" vid="PRO 1:15">ne toho denththofa.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Gaasoykka istti iita miish</para>
  <para style="q2" vid="PRO 1:16">ooththanaas woxxeettes;</para>
  <para style="q2" vid="PRO 1:16">asaa suuth gussanaaskka</para>
  <para style="q2" vid="PRO 1:16">jaameettes.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Kafoy xeellishin</para>
  <para style="q2" vid="PRO 1:17">iza oykkanaas</para>
  <para style="q2" vid="PRO 1:17">yarde woththiko</para>
  <para style="q2" vid="PRO 1:17">aykkoka maaddenna.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Hayti ha asati bantta</para>
  <para style="q2" vid="PRO 1:18">suuth gussanaas zuggeettes;</para>
  <para style="q2" vid="PRO 1:18">bantta shemppo wodhanaas</para>
  <para style="q2" vid="PRO 1:18">qotetti utteettes.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Bessontta ogera go7a demmanaas</para>
  <para style="q2" vid="PRO 1:19">woxxiza ubbata wurseththay</para>
  <para style="q2" vid="PRO 1:19">hayssa mala;</para>
  <para style="q2" vid="PRO 1:19">istti shiishshida aqotay</para>
  <para style="q2" vid="PRO 1:19">istta shemppo ekki baana.<verse eid="PRO 1:19" /></para>
  <para style="s1">Aadho Erateth Kadhizaytas Imettida Seera</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Aadho erateththaya</para>
  <para style="q2" vid="PRO 1:20">oge bolla de7ashe xeygawus;</para>
  <para style="q2" vid="PRO 1:20">dubbushan ba qaala</para>
  <para style="q2" vid="PRO 1:20">dhoqqu histtada waassawus.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Aadho erateththaya cora asi</para>
  <para style="q2" vid="PRO 1:21">shiiqizason waassawus;</para>
  <para style="q2" vid="PRO 1:21">katama geliza pengen eqqada,<note caller="-" style="x"><char style="xo" closed="false">1:20-21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">Leemi 8:1-3</ref></char></note><verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />«Intteno wozina pacetoo!</para>
  <para style="q2" vid="PRO 1:22">Intte awude gakkanaas</para>
  <para style="q2" vid="PRO 1:22">eeyateththa oge kaallanee?</para>
  <para style="q2" vid="PRO 1:22">Qilccizaytoo! Intte qilccizayssan</para>
  <para style="q2" vid="PRO 1:22">awude gakkanaas ufayetteetii?</para>
  <para style="q2" vid="PRO 1:22">Eeyatoo! Erateththa</para>
  <para style="q2" vid="PRO 1:22">awude gakkanaas ixxanee?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Ta seeran intte simmidaakko,</para>
  <para style="q2" vid="PRO 1:23">tani ta qofa</para>
  <para style="q2" vid="PRO 1:23">inttes qonccisanakkoshin;</para>
  <para style="q2" vid="PRO 1:23">ta qaalakka</para>
  <para style="q2" vid="PRO 1:23">inttena tamaarsanakkoshin.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Tani xeygida wode</para>
  <para style="q2" vid="PRO 1:24">intte koyontta ixxideta;</para>
  <para style="q2" vid="PRO 1:24">tani ta kusheza micciin</para>
  <para style="q2" vid="PRO 1:24">oonikka wudu gibeenna.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Ta zore ubbaa kadhideta;</para>
  <para style="q2" vid="PRO 1:25">ta seerakka ekkibeekketa.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Hessa gishshas</para>
  <para style="q2" vid="PRO 1:26">inttena metoy gakkiza wode</para>
  <para style="q2" vid="PRO 1:26">tani intte bolla miiccana;</para>
  <para style="q2" vid="PRO 1:26">bashshi intte bolla gakkiza wode</para>
  <para style="q2" vid="PRO 1:26">tani intte bolla qilccana.<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Bashshi abba dambala mala</para>
  <para style="q2" vid="PRO 1:27">inttena qaaththiza wode,</para>
  <para style="q2" vid="PRO 1:27">metoy gote carko mala</para>
  <para style="q2" vid="PRO 1:27">inttena denththiza wode,</para>
  <para style="q2" vid="PRO 1:27">tuggaynne waayey</para>
  <para style="q2" vid="PRO 1:27">inttena mittiza wode</para>
  <para style="q2" vid="PRO 1:27">tani inttena qilccana.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />«He wode istti tana xeygana;</para>
  <para style="q2" vid="PRO 1:28">ta gidikko isttas koykke;</para>
  <para style="q2" vid="PRO 1:28">istti tana minththi koyana;</para>
  <para style="q2" vid="PRO 1:28">gido attiin tana demmettenna.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Istti erateth ixxida;</para>
  <para style="q2" vid="PRO 1:29">GODAAS yashshateth</para>
  <para style="q2" vid="PRO 1:29">dooribeettenna.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Ta zore ekkanaas koyibeettenna;</para>
  <para style="q2" vid="PRO 1:30">ta seera ubbaa kadhida.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Hessa gishshas</para>
  <para style="q2" vid="PRO 1:31">istti bantti ooththida</para>
  <para style="q2" vid="PRO 1:31">ooso ayfeza maana;</para>
  <para style="q2" vid="PRO 1:31">bantti qoppida</para>
  <para style="q2" vid="PRO 1:31">qofa ayfekka kallana.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Wozinay paccidayta</para>
  <para style="q2" vid="PRO 1:32">aadho erateththafe</para>
  <para style="q2" vid="PRO 1:32">haakoy istta wodhana;</para>
  <para style="q2" vid="PRO 1:32">balata wuda dhayoy</para>
  <para style="q2" vid="PRO 1:32">istta dhayssana.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Gido attiin tana siyizayti</para>
  <para style="q2" vid="PRO 1:33">ubbay saron daana;</para>
  <para style="q2" vid="PRO 1:33">aykko hirgay baynda</para>
  <para style="q2" vid="PRO 1:33">woppan daana» gawus.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Aadho Erateththafe Beettiza Anjjo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Ta naazoo! Neni ta qaala siyikko,</para>
  <para style="q2" vid="PRO 2:1">ta azazokka</para>
  <para style="q2" vid="PRO 2:1">neni ne wozinan woththiko,<verse eid="PRO 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 2:2" />ne hayth aadho erateththaako</para>
  <para style="q2" vid="PRO 2:2">zaarikko,</para>
  <para style="q2" vid="PRO 2:2">ne wozina akeekakko</para>
  <para style="q2" vid="PRO 2:2">ne zaarikko,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />shaakki erisiza erateth</para>
  <para style="q2" vid="PRO 2:3">ne koykko,</para>
  <para style="q2" vid="PRO 2:3">ne qaala dhoqqu histtada</para>
  <para style="q2" vid="PRO 2:3">akeeka xeygikko,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />izokka bira koyza mala</para>
  <para style="q2" vid="PRO 2:4">ne koykko,</para>
  <para style="q2" vid="PRO 2:4">qotan diza aqota mala</para>
  <para style="q2" vid="PRO 2:4">ne izo minththa koykko,<verse eid="PRO 2:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 2:5" />he wode neni</para>
  <para style="q2" vid="PRO 2:5">GODAAS yashshateth akeekana;</para>
  <para style="q2" vid="PRO 2:5">Xoossaaka lo7eththada erana.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />GODAY aadho erateth</para>
  <para style="q2" vid="PRO 2:6">immiza gishshas</para>
  <para style="q2" vid="PRO 2:6">izappe erateththinne</para>
  <para style="q2" vid="PRO 2:6">akeekay beettes.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Izi suuretas xoono minjjees;</para>
  <para style="q2" vid="PRO 2:7">istta bolla wosoy bayndaytas</para>
  <para style="q2" vid="PRO 2:7">gondalle gidees.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Suure pirda oge naagees;</para>
  <para style="q2" vid="PRO 2:8">baas ammanettizayta</para>
  <para style="q2" vid="PRO 2:8">hemeth minththees.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />He wode neni xilloteth,</para>
  <para style="q2" vid="PRO 2:9">suure pirda,</para>
  <para style="q2" vid="PRO 2:9">geellay baynda pirdanne</para>
  <para style="q2" vid="PRO 2:9">lo7o oge ubbaa shaakka erana.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Gaasoykka aadho erateththi</para>
  <para style="q2" vid="PRO 2:10">ne wozinan gelana;</para>
  <para style="q2" vid="PRO 2:10">erateththayka</para>
  <para style="q2" vid="PRO 2:10">ne shemppo ufayssana.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Shaakki eroy nees gondalle gidana;</para>
  <para style="q2" vid="PRO 2:11">akeekaykka nena naagana.<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Aadho erateththi nena</para>
  <para style="q2" vid="PRO 2:12">iita asata ogeppe ashshana;</para>
  <para style="q2" vid="PRO 2:12">geella haasayzaytappeka</para>
  <para style="q2" vid="PRO 2:12">nena naagana.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Istti dhuma ogen baanaas</para>
  <para style="q2" vid="PRO 2:13">suure oge aggizayta;<verse eid="PRO 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 2:14" />Istti iita ooson ufayettizayta;</para>
  <para style="q2" vid="PRO 2:14">geella ogen hombocizayta.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Istta ogey geella;</para>
  <para style="q2" vid="PRO 2:15">istta hemetay mirqqeththa.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Aadho erateththi</para>
  <para style="q2" vid="PRO 2:16">layma maccassafe naagana;</para>
  <para style="q2" vid="PRO 2:16">ba inxarsan cimmizaarippe</para>
  <para style="q2" vid="PRO 2:16">nena ashshana.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Iza ba yelagateththa</para>
  <para style="q2" vid="PRO 2:17">azina aggidaaro;</para>
  <para style="q2" vid="PRO 2:17">Xoossa sinththan gelida</para>
  <para style="q2" vid="PRO 2:17">caaqo qaala kadhidaaro.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Izi soo beeththi hayqos gaththees;</para>
  <para style="q2" vid="PRO 2:18">izi ogetikka</para>
  <para style="q2" vid="PRO 2:18">moytilleta duulatan gaththeettes.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Izikko gelida</para>
  <para style="q2" vid="PRO 2:19">oonikka guye simmenna;</para>
  <para style="q2" vid="PRO 2:19">de7o ogekka demmenna.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Hessa gishshas neni</para>
  <para style="q2" vid="PRO 2:20">lo7o asata leemiso kaalla;</para>
  <para style="q2" vid="PRO 2:20">xillota ogen hemetta.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Suure asati biitta bolla gam7ana;</para>
  <para style="q2" vid="PRO 2:21">wosoy baynda asatikka</para>
  <para style="q2" vid="PRO 2:21">izi bolla minni daana.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Gido attiin iitati biittafe dhayana;</para>
  <para style="q2" vid="PRO 2:22">ammanettonttaytikka dhoqallettana.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Godaan Ammaneteth</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Ta naazoo!</para>
  <para style="q2" vid="PRO 3:1">Tani nena tamaarsizayssa</para>
  <para style="q2" vid="PRO 3:1">dogoppa;</para>
  <para style="q2" vid="PRO 3:1">ta azazotakka</para>
  <para style="q2" vid="PRO 3:1">ne wozinan woththa.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Istti ne layth adussana;</para>
  <para style="q2" vid="PRO 3:2">ishalo de7onne</para>
  <para style="q2" vid="PRO 3:2">saroteth nees gujjana.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Siiqoynne tumateththi</para>
  <para style="q2" vid="PRO 3:3">neeppe haakkofetto;</para>
  <para style="q2" vid="PRO 3:3">istta ne qoodhen qachcha;</para>
  <para style="q2" vid="PRO 3:3">ne wozinankka xaafa.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Histtiko neni Xoossa sinththaninne</para>
  <para style="q2" vid="PRO 3:4">asaa sinththan sabettananne</para>
  <para style="q2" vid="PRO 3:4">lo7o sunth demmana.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luqa 2:52</ref></char></note><verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Neni polo wozinan</para>
  <para style="q2" vid="PRO 3:5">GODAAN ammanetta;</para>
  <para style="q2" vid="PRO 3:5">neni ne akeekan zemppofa.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Neni biza oge ubbaan</para>
  <para style="q2" vid="PRO 3:6">iza sinththasa;</para>
  <para style="q2" vid="PRO 3:6">izikka ne biza oge suurisana.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Nerkka nena</para>
  <para style="q2" vid="PRO 3:7">aadho eranchcha gooppa;</para>
  <para style="q2" vid="PRO 3:7">GODAAS yayya;</para>
  <para style="q2" vid="PRO 3:7">iitappeka haakka.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Oro 12:16</ref></char></note><verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Hessi ne bollaa payya woththana;</para>
  <para style="q2" vid="PRO 3:8">ne meqeththatakka xalisana.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />GODAA ne aqotan bonchcha;</para>
  <para style="q2" vid="PRO 3:9">biittay nees immiza ayfe ubbaafe</para>
  <para style="q2" vid="PRO 3:9">xeeraa izas imon bonchcha.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Ne hessaththo ooththiko</para>
  <para style="q2" vid="PRO 3:10">ne gootarati kumi palahana;</para>
  <para style="q2" vid="PRO 3:10">neni woyne ushshu agizasoti</para>
  <para style="q2" vid="PRO 3:10">cippi gi kumana.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Ta naazoo!</para>
  <para style="q2" vid="PRO 3:11">GODAA seera kadhoppa;</para>
  <para style="q2" vid="PRO 3:11">izi nena hanqiza</para>
  <para style="q2" vid="PRO 3:11">wodekka lanccofa.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 5:17">Iyo 5:17</ref></char></note><verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Aaway ba siiqiza naa</para>
  <para style="q2" vid="PRO 3:12">seerizayssaththo</para>
  <para style="q2" vid="PRO 3:12">GODAYKKA ba dosiza</para>
  <para style="q2" vid="PRO 3:12">naa seerees.<note caller="-" style="x"><char style="xo" closed="false">3:11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Ib 12:5-6</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">Ajju 3:19</ref></char></note><verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Aadho erateth demmanaas</para>
  <para style="q2" vid="PRO 3:13">woxxiza asi,</para>
  <para style="q2" vid="PRO 3:13">akeekakka baas miishshe</para>
  <para style="q2" vid="PRO 3:13">ooththiza asi anjjettidaade.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Gaasoykka izippe demmiza go7ay</para>
  <para style="q2" vid="PRO 3:14">birappe demmiza</para>
  <para style="q2" vid="PRO 3:14">go7appe aadhdhees;</para>
  <para style="q2" vid="PRO 3:14">izippe beettiza go7ay</para>
  <para style="q2" vid="PRO 3:14">worqqafe beettiza</para>
  <para style="q2" vid="PRO 3:14">go7appe aadhdhees.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Aadho erateththi zo7o inqqufe</para>
  <para style="q2" vid="PRO 3:15">keehi al7o;</para>
  <para style="q2" vid="PRO 3:15">neni demmanaas amottiza ubbay</para>
  <para style="q2" vid="PRO 3:15">izira ginattenna.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Iza ushachcha kushen adussa layth,</para>
  <para style="q2" vid="PRO 3:16">hadirsa kushen aqotanne</para>
  <para style="q2" vid="PRO 3:16">bonchcho oykkadus.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Izi ogeti ufayssiza ogeta;</para>
  <para style="q2" vid="PRO 3:17">iza hemettiza oge ubbayka saro.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Iza bana idimmizaytas</para>
  <para style="q2" vid="PRO 3:18">de7o miththa;</para>
  <para style="q2" vid="PRO 3:18">izo oykkizaytikka anjjettana.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />GODAY ba aadho erateththan</para>
  <para style="q2" vid="PRO 3:19">sa7a medhdhides;</para>
  <para style="q2" vid="PRO 3:19">ba akeekankka salota</para>
  <para style="q2" vid="PRO 3:19">istti dizason minththides.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Shaafati iza erateththan goggeettes;</para>
  <para style="q2" vid="PRO 3:20">shaarati ira immeettes.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Ta naazoo! Suure pirdanne</para>
  <para style="q2" vid="PRO 3:21">shaakki ero naaga;</para>
  <para style="q2" vid="PRO 3:21">istti ne sinththafe haakkofetto.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Istti nees de7o gidana;</para>
  <para style="q2" vid="PRO 3:22">ne qoodheskka aleqo gidana.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />He wode neni ogen</para>
  <para style="q2" vid="PRO 3:23">hirgay baynda hemettana;</para>
  <para style="q2" vid="PRO 3:23">ne tohoykka dhuphettenna.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Neni ichchida wode babbaka;</para>
  <para style="q2" vid="PRO 3:24">ichchadakka</para>
  <para style="q2" vid="PRO 3:24">mal7o dhisko dhiskana.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Akeekontta gakkiza metonne</para>
  <para style="q2" vid="PRO 3:25">iitata bolla gakkiza</para>
  <para style="q2" vid="PRO 3:25">dhayssas babbaka.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Ays giikko GODAY nees</para>
  <para style="q2" vid="PRO 3:26">ammanettizaade gidana;</para>
  <para style="q2" vid="PRO 3:26">ne tohoy</para>
  <para style="q2" vid="PRO 3:26">woximaden oykettontta mala</para>
  <para style="q2" vid="PRO 3:26">izi nena naagana.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Nees maaddana wolqqay dishin</para>
  <para style="q2" vid="PRO 3:27">maado bessizaytas</para>
  <para style="q2" vid="PRO 3:27">lo7o ooso aggofa.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Ha7i nees dishin ne shoorozas,</para>
  <para style="q2" vid="PRO 3:28">«Simmada ya;</para>
  <para style="q2" vid="PRO 3:28">tani nees wonto immana» gooppa.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Nenan ammanettidi ne matan dishin</para>
  <para style="q2" vid="PRO 3:29">ne shooroza bolla</para>
  <para style="q2" vid="PRO 3:29">iita miish ooththanaas halchchofa.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Nena qohontta as</para>
  <para style="q2" vid="PRO 3:30">gaasoy baynda coo mootoppa.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Gene ooththiza asata qullofa;</para>
  <para style="q2" vid="PRO 3:31">istta iita ogekka kaallofa.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Gaasoykka GODAY</para>
  <para style="q2" vid="PRO 3:32">iita ooththizayta ixxees;</para>
  <para style="q2" vid="PRO 3:32">gido attiin suuretas izi</para>
  <para style="q2" vid="PRO 3:32">ba wozina qofa qonccisees.<verse eid="PRO 3:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />GODAA qanggeththi</para>
  <para style="q2" vid="PRO 3:33">iita ooththizayta keeththanna;</para>
  <para style="q2" vid="PRO 3:33">gido attiin</para>
  <para style="q2" vid="PRO 3:33">iza anjjoy xillotasonna.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Otoreteththan qilccizayta bolla</para>
  <para style="q2" vid="PRO 3:34">GODAYKKA qilccees;</para>
  <para style="q2" vid="PRO 3:34">gido attiin banttana</para>
  <para style="q2" vid="PRO 3:34">kawushshizayta bonchchees.<note caller="-" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">Yaaqo 4:6</ref>; <ref loc="1PE 5:5">1Phex 5:5</ref></char></note><verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Aadho eranchchati</para>
  <para style="q2" vid="PRO 3:35">bonchcho laattana;</para>
  <para style="q2" vid="PRO 3:35">eeyati gidikko kawushshateththas</para>
  <para style="q2" vid="PRO 3:35">aadhdhi imettana.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Aadho Erateththa Go7a</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Ta naytoo! Intte aawa zore siyite;</para>
  <para style="q2" vid="PRO 4:1">wozinan woththi ezgite;</para>
  <para style="q2" vid="PRO 4:1">akeekakka inttes miish histtite.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Tani inttes lo7o timirte</para>
  <para style="q2" vid="PRO 4:2">immiza gishshas</para>
  <para style="q2" vid="PRO 4:2">ta timirte aggofte.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Tani ta hu7enkka</para>
  <para style="q2" vid="PRO 4:3">ta aawaas yelaga naa;</para>
  <para style="q2" vid="PRO 4:3">ta aayeyska mexi issi naa.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Ta aaway tana tamaarsishe,</para>
  <para style="q2" vid="PRO 4:4">«Ta qaala kumeththa</para>
  <para style="q2" vid="PRO 4:4">wozinan oykka;</para>
  <para style="q2" vid="PRO 4:4">ta azazotakka naaga;</para>
  <para style="q2" vid="PRO 4:4">ne histtiko paxa de7ana.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Aadho erateththinne akeeka oykka;</para>
  <para style="q2" vid="PRO 4:5">ta qaala dogoppa;</para>
  <para style="q2" vid="PRO 4:5">izippeka kare kezoppa.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Aadho erateth aggofa;</para>
  <para style="q2" vid="PRO 4:6">iza nees gondalle gidana;</para>
  <para style="q2" vid="PRO 4:6">izo siiqa;</para>
  <para style="q2" vid="PRO 4:6">izakka nena naagana.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Aadho erateththi bayra;</para>
  <para style="q2" vid="PRO 4:7">hessa gishshas izo demma.</para>
  <para style="q2" vid="PRO 4:7">Akeekay ne aqoza ubbaa</para>
  <para style="q2" vid="PRO 4:7">ekkizaa gidikkoka iza demma.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Neni aadho erateth bonchcha;</para>
  <para style="q2" vid="PRO 4:8">iza nena</para>
  <para style="q2" vid="PRO 4:8">dhoqqu dhoqqu ooththana;</para>
  <para style="q2" vid="PRO 4:8">neni izo idimma;</para>
  <para style="q2" vid="PRO 4:8">iza nena bonchchana.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Iza ne hu7en</para>
  <para style="q2" vid="PRO 4:9">saba akilile woththana;</para>
  <para style="q2" vid="PRO 4:9">bonchcho kallachchaka</para>
  <para style="q2" vid="PRO 4:9">immana» gees.<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Ta naazoo! Ta gizayssa ezga;</para>
  <para style="q2" vid="PRO 4:10">ta qaalaakka</para>
  <para style="q2" vid="PRO 4:10">ne wozinan woththa;</para>
  <para style="q2" vid="PRO 4:10">ne layththi aduqqana.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Tani nena aadho erateththa</para>
  <para style="q2" vid="PRO 4:11">oge kaaleththana;</para>
  <para style="q2" vid="PRO 4:11">suure ogekka bessana.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Ne hemettashe dhuphettaka;</para>
  <para style="q2" vid="PRO 4:12">woxxikokka kundaka.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Ta timirte lo7eththa oykka;</para>
  <para style="q2" vid="PRO 4:13">izo yeddofa;</para>
  <para style="q2" vid="PRO 4:13">iza nees de7o gidida gishshas</para>
  <para style="q2" vid="PRO 4:13">izo naaga.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Nagaranchchata oge yedhdhofa;</para>
  <para style="q2" vid="PRO 4:14">iita asata ogenkka hemettofa.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Izippe haakka; izin hemettofa;</para>
  <para style="q2" vid="PRO 4:15">izippe guye simma;</para>
  <para style="q2" vid="PRO 4:15">histtada ne ogeyra ba.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Istti iita ooththontta dishe</para>
  <para style="q2" vid="PRO 4:16">dhiski erettenna;</para>
  <para style="q2" vid="PRO 4:16">as dhupheththontta dishin</para>
  <para style="q2" vid="PRO 4:16">dhiskoy istta ayfen yeenna.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Istti iitateth kaththa mala meettes;</para>
  <para style="q2" vid="PRO 4:17">genekka ushsha mala uyeettes.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Xillota ogey seeta gallas gakkanaas</para>
  <para style="q2" vid="PRO 4:18">poo7i poo7i biza</para>
  <para style="q2" vid="PRO 4:18">mallado xalqqe mala.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Gido attiin nagaranchchata ogey</para>
  <para style="q2" vid="PRO 4:19">sakkanna dhuma mala;</para>
  <para style="q2" vid="PRO 4:19">istti aazan dhuphettanaakkoka</para>
  <para style="q2" vid="PRO 4:19">erettenna.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Ta naazoo! Ta gizayssa akeeka;</para>
  <para style="q2" vid="PRO 4:20">ta qaalaakka lo7eththa ezga.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Ne ayfe sinththafe haassofa;</para>
  <para style="q2" vid="PRO 4:21">ne wozinan woththa.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Gaasoykka istti demmiza asas</para>
  <para style="q2" vid="PRO 4:22">de7o immeettes;</para>
  <para style="q2" vid="PRO 4:22">istti asateththaska</para>
  <para style="q2" vid="PRO 4:22">payyateth immeettes.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Ubbaafekka bollara</para>
  <para style="q2" vid="PRO 4:23">neni ne wozina</para>
  <para style="q2" vid="PRO 4:23">minththada naaga;</para>
  <para style="q2" vid="PRO 4:23">ays giikko de7oy izappe pulttees.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Ne doonappe gene haasaya digga;</para>
  <para style="q2" vid="PRO 4:24">iita haasaya</para>
  <para style="q2" vid="PRO 4:24">ne metershafe haassa.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Ne ayfeti sitti giidi</para>
  <para style="q2" vid="PRO 4:25">sinth xeelletto;</para>
  <para style="q2" vid="PRO 4:25">tishshi histtada</para>
  <para style="q2" vid="PRO 4:25">ne sinththan dizayssa xeella.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Ne tohos oge giigsa;</para>
  <para style="q2" vid="PRO 4:26">suure oge xalla hemetta.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ib 12:13</ref></char></note><verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Ushach hadirsi gooppa;</para>
  <para style="q2" vid="PRO 4:27">ne toho iitappe naaga.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Laymateththafe Naageteth</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Ta naazoo! Ta aadho erateththaa</para>
  <para style="q2" vid="PRO 5:1">ne wozinan woththa;</para>
  <para style="q2" vid="PRO 5:1">tani akeekan yootiza qaala</para>
  <para style="q2" vid="PRO 5:1">lo7eththa ezga.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Hessika wozinamateththi</para>
  <para style="q2" vid="PRO 5:2">nees miish gidana malanne</para>
  <para style="q2" vid="PRO 5:2">ne metershati</para>
  <para style="q2" vid="PRO 5:2">erateth naagana malassa.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Layma maccassa inxarsafe</para>
  <para style="q2" vid="PRO 5:3">eessa ililoy xokkees;</para>
  <para style="q2" vid="PRO 5:3">izi haasayay oyssafekka</para>
  <para style="q2" vid="PRO 5:3">aadhdhi shuggees.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Gido attiin iza wurseththan</para>
  <para style="q2" vid="PRO 5:4">godare uuththa mala cammawus;</para>
  <para style="q2" vid="PRO 5:4">nam7u baggara qanxxiza</para>
  <para style="q2" vid="PRO 5:4">qara mashsha mala.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Izi tohoti duge hayqoso beettes;</para>
  <para style="q2" vid="PRO 5:5">izi tanggoy sitti histti</para>
  <para style="q2" vid="PRO 5:5">duge duufon kaaleththees.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Iza de7o oges wudu guukku;</para>
  <para style="q2" vid="PRO 5:6">izi ogeti geella;</para>
  <para style="q2" vid="PRO 5:6">gido attiin geella gididayssaka</para>
  <para style="q2" vid="PRO 5:6">iza erukku.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Ta naytoo! Tana ezgite;</para>
  <para style="q2" vid="PRO 5:7">ta yootiza qaalaappe ke7opite.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Intte oge izippe haassite;</para>
  <para style="q2" vid="PRO 5:8">izi pengerakka aadhdhofte.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Hessika intte intte</para>
  <para style="q2" vid="PRO 5:9">goobateththa haratas,</para>
  <para style="q2" vid="PRO 5:9">intte layththaaka menxe iitatas</para>
  <para style="q2" vid="PRO 5:9">intte immontta malassa.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Allagati intte aqotan</para>
  <para style="q2" vid="PRO 5:10">kaa7ontta malanne</para>
  <para style="q2" vid="PRO 5:10">intte daaburankka hara asasoy</para>
  <para style="q2" vid="PRO 5:10">duretontta malassa.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Intte ashoy wuriin,</para>
  <para style="q2" vid="PRO 5:11">intte meqeththi gilqiin</para>
  <para style="q2" vid="PRO 5:11">wurseththa layththan</para>
  <para style="q2" vid="PRO 5:11">intte goottarana.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Qasseka neni,</para>
  <para style="q2" vid="PRO 5:12">«Tani ays seera ixxadinaa!</para>
  <para style="q2" vid="PRO 5:12">Ta wozinaykka zore</para>
  <para style="q2" vid="PRO 5:12">ays kadhidee!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Tana tamaarsizayti</para>
  <para style="q2" vid="PRO 5:13">yootidayssa ekkabeekke;</para>
  <para style="q2" vid="PRO 5:13">tana zorizayta</para>
  <para style="q2" vid="PRO 5:13">zorezakka ezgabeekke.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Hessa gishshas tani</para>
  <para style="q2" vid="PRO 5:14">shiiqida duulata sinththafe</para>
  <para style="q2" vid="PRO 5:14">dhayana matadis» gaana.<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Neni eelissida ne pultto haaththafe</para>
  <para style="q2" vid="PRO 5:15">uyada aliza mala</para>
  <para style="q2" vid="PRO 5:15">ne machcheys ammanettada</para>
  <para style="q2" vid="PRO 5:15">izi siiqon ala.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Beetta beetta maccassi</para>
  <para style="q2" vid="PRO 5:16">uyiza pultto haath gidoppa.<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Nenateththaa ne machcheys naaga;</para>
  <para style="q2" vid="PRO 5:17">hara maccassara zin7ofa.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Ne machcheya nees</para>
  <para style="q2" vid="PRO 5:18">anjjettida pultto gidu;</para>
  <para style="q2" vid="PRO 5:18">yelagateththan neni ekkida</para>
  <para style="q2" vid="PRO 5:18">ne machcheyra ufayetta.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Lo7iza gaara malanne</para>
  <para style="q2" vid="PRO 5:19">ufayssiza genessa mala,</para>
  <para style="q2" vid="PRO 5:19">izi dhanththati ubba wode</para>
  <para style="q2" vid="PRO 5:19">nena aletto;</para>
  <para style="q2" vid="PRO 5:19">izi siiqoy nena ubbato oykko.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Ta naazoo!</para>
  <para style="q2" vid="PRO 5:20">Layma maccassay siiqon</para>
  <para style="q2" vid="PRO 5:20">ays maththottay?</para>
  <para style="q2" vid="PRO 5:20">Hara asa machchira</para>
  <para style="q2" vid="PRO 5:20">ays qoomettay?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Gaasoykka asi ooththiza ubbaa</para>
  <para style="q2" vid="PRO 5:21">GODAY beyees;</para>
  <para style="q2" vid="PRO 5:21">izi hemettiza hemetaa ubbaa</para>
  <para style="q2" vid="PRO 5:21">pilggi xeellees.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Nagaranchcha izi ooththida</para>
  <para style="q2" vid="PRO 5:22">nagaray zaari oykkees.</para>
  <para style="q2" vid="PRO 5:22">Iza nagara gitey iza qachchees.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Izi ba eeyateththa daron</para>
  <para style="q2" vid="PRO 5:23">oge balana;</para>
  <para style="q2" vid="PRO 5:23">bana haarana dandayontta</para>
  <para style="q2" vid="PRO 5:23">aggida gishshas</para>
  <para style="q2" vid="PRO 5:23">izi hayqqana.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Hachchas Hachchas Bessiza Zore</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Ta naazoo! Neni ne shoorozas</para>
  <para style="q2" vid="PRO 6:1">waase gelidaa gidikko,</para>
  <para style="q2" vid="PRO 6:1">hara asa gishshas neni</para>
  <para style="q2" vid="PRO 6:1">kushe baqqa caaqqidaa gidikko,<verse eid="PRO 6:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 6:2" />neni gelida qaalan</para>
  <para style="q2" vid="PRO 6:2">oykettidaa gidikko,</para>
  <para style="q2" vid="PRO 6:2">ne doonappe ke7ida qaalan</para>
  <para style="q2" vid="PRO 6:2">ne oykettidaa gidikko,<verse eid="PRO 6:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 6:3" />ta naazoo! Neni ne shooroza</para>
  <para style="q2" vid="PRO 6:3">kushen kundida gishshas</para>
  <para style="q2" vid="PRO 6:3">nena ashshanaas baada</para>
  <para style="q2" vid="PRO 6:3">iza sinththan kunda;</para>
  <para style="q2" vid="PRO 6:3">ne shoorozakko baada shoobba.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Hessaththo ooththontta</para>
  <para style="q2" vid="PRO 6:4">dashe dhiskofa;</para>
  <para style="q2" vid="PRO 6:4">ne siphinththati liphopetto.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Shankkanchchatappe genessi</para>
  <para style="q2" vid="PRO 6:5">kessi ekki attiza mala,</para>
  <para style="q2" vid="PRO 6:5">yarden oykettontta attida</para>
  <para style="q2" vid="PRO 6:5">kafo mala nena ashsha.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Nenoo azallazoo!</para>
  <para style="q2" vid="PRO 6:6">Cunccalletaakko ba;</para>
  <para style="q2" vid="PRO 6:6">histtada isttafe tamaarada</para>
  <para style="q2" vid="PRO 6:6">aadho eranchcha gida.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Cunccalletas azazizay deenna;</para>
  <para style="q2" vid="PRO 6:7">istta haarizay deenna.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Gido attiin banttas maana miish</para>
  <para style="q2" vid="PRO 6:8">bone shiishsheettes;</para>
  <para style="q2" vid="PRO 6:8">kath shiishshiza wode</para>
  <para style="q2" vid="PRO 6:8">banttas kath shiishsheettes.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Nenoo azallazoo!</para>
  <para style="q2" vid="PRO 6:9">Neni awude gakkanaas</para>
  <para style="q2" vid="PRO 6:9">dhiskanee?</para>
  <para style="q2" vid="PRO 6:9">Dhiskofekka</para>
  <para style="q2" vid="PRO 6:9">ne awude beegganee?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />«Tani guuththara dhiska ekkana;</para>
  <para style="q2" vid="PRO 6:10">guuththara liipha dendana;</para>
  <para style="q2" vid="PRO 6:10">ta kushe borkotada</para>
  <para style="q2" vid="PRO 6:10">guuththara shempa ekkana»</para>
  <para style="q2" vid="PRO 6:10">ne gishin,<verse eid="PRO 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 6:11" />he wode manqoteththi</para>
  <para style="q2" vid="PRO 6:11">panga mala,</para>
  <para style="q2" vid="PRO 6:11">pacey ola miishsha</para>
  <para style="q2" vid="PRO 6:11">oykkida asa mala</para>
  <para style="q2" vid="PRO 6:11">ne bolla puttu gaana.<note caller="-" style="x"><char style="xo" closed="false">6:10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Leemi 24:33-34</ref></char></note><verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Womaleynne menxe iita asi</para>
  <para style="q2" vid="PRO 6:12">yuuyi yuuyidi</para>
  <para style="q2" vid="PRO 6:12">iita qaala haasayzay,<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />ba ayfera qim7otizay,</para>
  <para style="q2" vid="PRO 6:13">ba tohon bessizay,</para>
  <para style="q2" vid="PRO 6:13">ba biradhdhetankka malatizay,<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />ba wozinan iita miish</para>
  <para style="q2" vid="PRO 6:14">woththi denththi qoppizay</para>
  <para style="q2" vid="PRO 6:14">ay wodekka oosh denththees.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Hessa gaason bashshi akeekontta</para>
  <para style="q2" vid="PRO 6:15">iza bolla yaana;</para>
  <para style="q2" vid="PRO 6:15">izi hassa7ay baynda meqqana;</para>
  <para style="q2" vid="PRO 6:15">meqqidikka paxenna.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />GODAY ixxiza usuppun</para>
  <para style="q2" vid="PRO 6:16">yo7oti deettes;</para>
  <para style="q2" vid="PRO 6:16">laappunththaza</para>
  <para style="q2" vid="PRO 6:16">keehi harasettees.<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />Otoreteththan xeelliza ayfe,</para>
  <para style="q2" vid="PRO 6:17">wordotiza inxars,</para>
  <para style="q2" vid="PRO 6:17">xillo asata wodhiza kushe,<verse eid="PRO 6:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18" />iita miish qoppiza wozina,</para>
  <para style="q2" vid="PRO 6:18">iitaso eesotiza tohota,<verse eid="PRO 6:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 6:19" />wordo bolla wordo gujji gujjidi</para>
  <para style="q2" vid="PRO 6:19">yootiza wordo markka,</para>
  <para style="q2" vid="PRO 6:19">ishantta giddon</para>
  <para style="q2" vid="PRO 6:19">oosh medhdhiza asa.<verse eid="PRO 6:19" /></para>
  <para style="s1">Laymappe Haako</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Ta naazoo! Ne aawa azazo pola;</para>
  <para style="q2" vid="PRO 6:20">ne aaya tamaarsidayssaka aggofa.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Istta ubbato ne wozinan oykka;</para>
  <para style="q2" vid="PRO 6:21">ne qoodhenkka qachcha.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Neni hemettiza wode</para>
  <para style="q2" vid="PRO 6:22">istti nena kaaleththana;</para>
  <para style="q2" vid="PRO 6:22">neni ichchiza wode</para>
  <para style="q2" vid="PRO 6:22">istti nena naagana;</para>
  <para style="q2" vid="PRO 6:22">neni beegottiza wodekka</para>
  <para style="q2" vid="PRO 6:22">istti nena zorana.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Ays giikko ha azazoti nees xomppe;</para>
  <para style="q2" vid="PRO 6:23">timirtetikka poo7o;</para>
  <para style="q2" vid="PRO 6:23">qasse seeraykka</para>
  <para style="q2" vid="PRO 6:23">de7okko efiza oge.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Ha azazoti iita maccassafe</para>
  <para style="q2" vid="PRO 6:24">nena naagana;</para>
  <para style="q2" vid="PRO 6:24">doonan cimmiza hawusha</para>
  <para style="q2" vid="PRO 6:24">maccassafekka naagana.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Izi lo7eteththa</para>
  <para style="q2" vid="PRO 6:25">ne wozinan amottofa;</para>
  <para style="q2" vid="PRO 6:25">izi qim7oteththan oykettofa.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Issi addey</para>
  <para style="q2" vid="PRO 6:26">bana bayza diza maccassayo</para>
  <para style="q2" vid="PRO 6:26">guuththa miishshan</para>
  <para style="q2" vid="PRO 6:26">demmanaas dandayees;</para>
  <para style="q2" vid="PRO 6:26">asa machchi geedo kaaloy</para>
  <para style="q2" vid="PRO 6:26">nees shemppo dhayssana.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Issi asi tama idimmiin</para>
  <para style="q2" vid="PRO 6:27">iza may7oy</para>
  <para style="q2" vid="PRO 6:27">meetettontta attanaas dandayzee?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Issi asi bonqo tama yedhdhi bishin</para>
  <para style="q2" vid="PRO 6:28">iza tohoy</para>
  <para style="q2" vid="PRO 6:28">xuugettontta attana dandayzee?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Asa machcho laggeththiza asi</para>
  <para style="q2" vid="PRO 6:29">hessa mala;</para>
  <para style="q2" vid="PRO 6:29">izo bochchiza ubbay</para>
  <para style="q2" vid="PRO 6:29">qaxxayettontta attenna.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Kaysoy gafa attanaas kaysikko</para>
  <para style="q2" vid="PRO 6:30">asay iza kadhenna.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Gido attiin izas diza aqota</para>
  <para style="q2" vid="PRO 6:31">ubbaa oychchikokka</para>
  <para style="q2" vid="PRO 6:31">izi oykettidaa gidikko</para>
  <para style="q2" vid="PRO 6:31">laappun kushe qanxxana bessees.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Layma laymatiza asas</para>
  <para style="q2" vid="PRO 6:32">wozinay pace;</para>
  <para style="q2" vid="PRO 6:32">hessaadey barkka</para>
  <para style="q2" vid="PRO 6:32">ba shemppo dhayssees.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Bukaynne kawushshateththi</para>
  <para style="q2" vid="PRO 6:33">izas qaada;</para>
  <para style="q2" vid="PRO 6:33">yeellateththi izappe</para>
  <para style="q2" vid="PRO 6:33">mulekka qucettenna.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Qanaatey azina hanqettana mala denththeththees;</para>
  <para style="q2" vid="PRO 6:34">izi halo kessiza wode</para>
  <para style="q2" vid="PRO 6:34">izas qadhettenna.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Izi ay edakka ekkenna;</para>
  <para style="q2" vid="PRO 6:35">ay keena imotaykka</para>
  <para style="q2" vid="PRO 6:35">iza hanqo doshisenna.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Laymappe Naagettana Mala Imettida Seera</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Ta naazoo! Ta qaala naaga;</para>
  <para style="q2" vid="PRO 7:1">ta azazokka ne wozinan</para>
  <para style="q2" vid="PRO 7:1">qum7a oykka.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Ne paxa de7ana mala</para>
  <para style="q2" vid="PRO 7:2">ta azazota naaga;</para>
  <para style="q2" vid="PRO 7:2">ta timirtezakka</para>
  <para style="q2" vid="PRO 7:2">ne ayfe ciro mala naaga.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Hayta ne biradhdhetan qachcha;</para>
  <para style="q2" vid="PRO 7:3">ne wozinankka xaafa.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Aadho erateth ne taas michcho ga;</para>
  <para style="q2" vid="PRO 7:4">akeekakka ne taas dabbo ga.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Istti nena layma maccassafenne</para>
  <para style="q2" vid="PRO 7:5">ba qaalan baleththiza</para>
  <para style="q2" vid="PRO 7:5">hawusha maccassafe naagana.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Issi gallas tani</para>
  <para style="q2" vid="PRO 7:6">ta keeththa maskootezara</para>
  <para style="q2" vid="PRO 7:6">kare xeelladis.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Akeekay paccida yelagata be7adis.</para>
  <para style="q2" vid="PRO 7:7">Istta giddofe issoy keehi eeya.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />He wodallay izi soo efiza</para>
  <para style="q2" vid="PRO 7:8">oge baggara oykki bishe</para>
  <para style="q2" vid="PRO 7:8">izi keeththa achchara</para>
  <para style="q2" vid="PRO 7:8">aadhdhi bishin,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />he wode sa7ay qammanaas</para>
  <para style="q2" vid="PRO 7:9">lankilankishin,</para>
  <para style="q2" vid="PRO 7:9">dhumay ayfe oykkishin,<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="10" style="v" sid="PRO 7:10" />issi maccassaya</para>
  <para style="q2" vid="PRO 7:10">iza demmanaas kezadus;</para>
  <para style="q2" vid="PRO 7:10">layma maccassa may7o may7ada</para>
  <para style="q2" vid="PRO 7:10">baleththanaas murtta kezadus.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Iza xalanne</para>
  <para style="q2" vid="PRO 7:11">yeellay baynda maccassa;</para>
  <para style="q2" vid="PRO 7:11">sohon woppu gaada uttuku.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Iza issito ogen, issito gulan,</para>
  <para style="q2" vid="PRO 7:12">issito dubbushan eqqada naagawus.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Iza he naaza</para>
  <para style="q2" vid="PRO 7:13">shiishsha oykkada yeerawus;</para>
  <para style="q2" vid="PRO 7:13">yeellay baynda iza ayfe</para>
  <para style="q2" vid="PRO 7:13">tishshi histta xeellashe,<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="14" style="v" sid="PRO 7:14" />«Tani tason issifeteththa yarsho</para>
  <para style="q2" vid="PRO 7:14">yarshanaas bessees;</para>
  <para style="q2" vid="PRO 7:14">tani ta adina hach poladis.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Histtada nena xeellanawu ke7adis;</para>
  <para style="q2" vid="PRO 7:15">nena keeha koyadis;</para>
  <para style="q2" vid="PRO 7:15">ha7i beya nena demmadis.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Tani Gibxeppe yida</para>
  <para style="q2" vid="PRO 7:16">alleqissiza ansolakka</para>
  <para style="q2" vid="PRO 7:16">ta hiixan yeggadis.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Tani karbbe, almmuniyemenne</para>
  <para style="q2" vid="PRO 7:17">qarafa geetettiza</para>
  <para style="q2" vid="PRO 7:17">sawotappe oosettida</para>
  <para style="q2" vid="PRO 7:17">shitto ta hiixan cacafadis.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Haa ya; ane wonttana gakkanaas</para>
  <para style="q2" vid="PRO 7:18">siiqo aloos;</para>
  <para style="q2" vid="PRO 7:18">qoomettidikka ufayettoos.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Ta keeththaaway soon deenna;</para>
  <para style="q2" vid="PRO 7:19">haako dere bides.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Miish karaxiite kunththi</para>
  <para style="q2" vid="PRO 7:20">ekki bida gishshas</para>
  <para style="q2" vid="PRO 7:20">aginay dors daganththontta</para>
  <para style="q2" vid="PRO 7:20">simmenna» gadus.<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Histtada ba mal7o haasayan</para>
  <para style="q2" vid="PRO 7:21">iza baleththadus;</para>
  <para style="q2" vid="PRO 7:21">ba liiqo inxarsankka cimmadus.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Shukas laagetti biza boora mala,</para>
  <para style="q2" vid="PRO 7:22">woximaden oykettana</para>
  <para style="q2" vid="PRO 7:22">biza cofosho mala</para>
  <para style="q2" vid="PRO 7:22">heerakka aamusontta</para>
  <para style="q2" vid="PRO 7:22">izo kaallidi bides.<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />Wondafe yiishshi</para>
  <para style="q2" vid="PRO 7:23">iza tire caddana gakkanaas,</para>
  <para style="q2" vid="PRO 7:23">iza shemppo dhayssanayssa</para>
  <para style="q2" vid="PRO 7:23">erontta dishe piradhdhidi yarden</para>
  <para style="q2" vid="PRO 7:23">geliza kafo mala gidides.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Ta naazoo! Ane ha7i siya;</para>
  <para style="q2" vid="PRO 7:24">ta doonappe keziza</para>
  <para style="q2" vid="PRO 7:24">qaalaakka ezga.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Ne wozinay izikko booppo;</para>
  <para style="q2" vid="PRO 7:25">iza biza bala ogen geloppa.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Iza kawushshada olidayti undenna;</para>
  <para style="q2" vid="PRO 7:26">iza wodhidayta qooday</para>
  <para style="q2" vid="PRO 7:26">keehi daro.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Izi soy duufon efiza oge;</para>
  <para style="q2" vid="PRO 7:27">he ogey duge hayqoso gaththees.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Aadho Erateththa Saba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Siyite! Aadho erateththaya ba qaala</para>
  <para style="q2" vid="PRO 8:1">doqqu histta xeygekkee?</para>
  <para style="q2" vid="PRO 8:1">Akeekaykka ba cenggurssaa</para>
  <para style="q2" vid="PRO 8:1">dhoqqu histta sissekee?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Oge doonan de7iza</para>
  <para style="q2" vid="PRO 8:2">zumbullata bollanne</para>
  <para style="q2" vid="PRO 8:2">daggala ogetan eqqawus.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Gimbeza lanqen katamata</para>
  <para style="q2" vid="PRO 8:3">geliza pengen eqqada</para>
  <para style="q2" vid="PRO 8:3">ba qaala dhoqqu histtada,<note caller="-" style="x"><char style="xo" closed="false">8:1-3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Leemi 1:20-21</ref></char></note><verse eid="PRO 8:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 8:4" />hayto asatoo! Tani inttena xeygays;</para>
  <para style="q2" vid="PRO 8:4">tani asa zereth ubbaa xeygays.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Intteno akeekay paccidaytoo!</para>
  <para style="q2" vid="PRO 8:5">wozinama gidite;</para>
  <para style="q2" vid="PRO 8:5">intteno eeyatoo akeeka demmite.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Tani go7iza miish</para>
  <para style="q2" vid="PRO 8:6">yootiza gishshas ezgite;</para>
  <para style="q2" vid="PRO 8:6">ta doonappe suure yo7oy kezees.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Ta doonay tuma haasayees;</para>
  <para style="q2" vid="PRO 8:7">ta metershatikka</para>
  <para style="q2" vid="PRO 8:7">iita miish ixxeettes.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Ta doonappe keziza qaalati</para>
  <para style="q2" vid="PRO 8:8">ubbay tuma;</para>
  <para style="q2" vid="PRO 8:8">geella woykko bokka gidettenna.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Akeekay diza asas</para>
  <para style="q2" vid="PRO 8:9">ta haasayay likke;</para>
  <para style="q2" vid="PRO 8:9">erateththi dizaytas</para>
  <para style="q2" vid="PRO 8:9">ta haasayan wordoy deenna.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Birappe aaththidi ta zore ekkite;</para>
  <para style="q2" vid="PRO 8:10">muuruta worqqafe aaththidi</para>
  <para style="q2" vid="PRO 8:10">erateth doorite.<verse eid="PRO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Ays giikko, «Tani aadho erateththi</para>
  <para style="q2" vid="PRO 8:11">zo7o inqqufekka keeha al7ays;</para>
  <para style="q2" vid="PRO 8:11">neni amottiza miish ubbayka</para>
  <para style="q2" vid="PRO 8:11">tanara ginattanaas dandayenna.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Tani aadho erateththi</para>
  <para style="q2" vid="PRO 8:12">akeekara days;</para>
  <para style="q2" vid="PRO 8:12">erateththinne wozinamateththi</para>
  <para style="q2" vid="PRO 8:12">ta miishshata.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Godaas yashshateththi iita ixo;</para>
  <para style="q2" vid="PRO 8:13">tani otoronne hallaca,</para>
  <para style="q2" vid="PRO 8:13">menxe iitateththinne</para>
  <para style="q2" vid="PRO 8:13">geella haasaya ixxays.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Zoreynne lo7o pirday tayta;</para>
  <para style="q2" vid="PRO 8:14">taas akeekaynne wolqqay dees.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Kawoti tanan kawoteettes;</para>
  <para style="q2" vid="PRO 8:15">dere ayssizayti</para>
  <para style="q2" vid="PRO 8:15">suure woga kesseettes.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Daannati tani maaddiin</para>
  <para style="q2" vid="PRO 8:16">deraa aysseettes;</para>
  <para style="q2" vid="PRO 8:16">deraa haariza gita asati</para>
  <para style="q2" vid="PRO 8:16">ubbay haareettes.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Tana siiqizayta tani siiqays;</para>
  <para style="q2" vid="PRO 8:17">minni koyzayti tana demmana.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Dureteththinne bonchchoy</para>
  <para style="q2" vid="PRO 8:18">ta matan deettes;</para>
  <para style="q2" vid="PRO 8:18">wurontta aqotaynne</para>
  <para style="q2" vid="PRO 8:18">injjey ta matanna.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Intte taappe demmiza go7ay</para>
  <para style="q2" vid="PRO 8:19">muuruta worqqafe aadhdhees;</para>
  <para style="q2" vid="PRO 8:19">ta imotaykka</para>
  <para style="q2" vid="PRO 8:19">seerisi kessida birappe darees.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Tani xilloteththa ogen hemettays;</para>
  <para style="q2" vid="PRO 8:20">suure pirda kaallays.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Tana siiqizaytas</para>
  <para style="q2" vid="PRO 8:21">tani dureteth immana;</para>
  <para style="q2" vid="PRO 8:21">istta minjja keeththaaka</para>
  <para style="q2" vid="PRO 8:21">tani kunththana.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />«GODAY tana ba ooso ubbaafe</para>
  <para style="q2" vid="PRO 8:22">koyro medhdhides;</para>
  <para style="q2" vid="PRO 8:22">benippeka iza oosaas</para>
  <para style="q2" vid="PRO 8:22">koyroy tana.<note caller="-" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">Ajju 3:14</ref></char></note><verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Saloynne sa7ay</para>
  <para style="q2" vid="PRO 8:23">medhettanaappe kase</para>
  <para style="q2" vid="PRO 8:23">Beni mernaasofe</para>
  <para style="q2" vid="PRO 8:23">tani shuumettadis.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Wogga gita abbati baynda wode,</para>
  <para style="q2" vid="PRO 8:24">haaththa pulttoti</para>
  <para style="q2" vid="PRO 8:24">dhuuqqanaappe kase</para>
  <para style="q2" vid="PRO 8:24">tani yelettadis.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Zumatinne zumbullati</para>
  <para style="q2" vid="PRO 8:25">medhettanaappe</para>
  <para style="q2" vid="PRO 8:25">kase tani yelettadis.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />GODAY sa7anne</para>
  <para style="q2" vid="PRO 8:26">sa7a bolla diza dembata</para>
  <para style="q2" vid="PRO 8:26">woykko alame bolla diza gudullata</para>
  <para style="q2" vid="PRO 8:26">medhdhanaappe kase tani yelettadis.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />GODAY salota miccida wodenne</para>
  <para style="q2" vid="PRO 8:27">gita abbatappe bollara</para>
  <para style="q2" vid="PRO 8:27">salo gufanththo giigsida wode</para>
  <para style="q2" vid="PRO 8:27">tani heen de7ays.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />GODAY shaarata bollan</para>
  <para style="q2" vid="PRO 8:28">woththida wode,</para>
  <para style="q2" vid="PRO 8:28">gita abbaa pulttota</para>
  <para style="q2" vid="PRO 8:28">dhuussida wode,<verse eid="PRO 8:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="PRO 8:29" />abbaa haaththati</para>
  <para style="q2" vid="PRO 8:29">banttas imettida zawappe</para>
  <para style="q2" vid="PRO 8:29">pinnidi aadhdhontta mala</para>
  <para style="q2" vid="PRO 8:29">zawa woththida wode,</para>
  <para style="q2" vid="PRO 8:29">sa7as yoch yeggida wode,<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />he wode tani iza matan</para>
  <para style="q2" vid="PRO 8:30">waanna oosanchcha;</para>
  <para style="q2" vid="PRO 8:30">ubbaa gallas tani</para>
  <para style="q2" vid="PRO 8:30">ufayssan kumays;</para>
  <para style="q2" vid="PRO 8:30">tanikka iza sinththan ufayettays.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Izas gidida alame ubbaan</para>
  <para style="q2" vid="PRO 8:31">ta ufayettays;</para>
  <para style="q2" vid="PRO 8:31">asaa naytankka ta ufayettays.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />«Ha7ikka ta naytoo!</para>
  <para style="q2" vid="PRO 8:32">Tani gizayssa ezgite;</para>
  <para style="q2" vid="PRO 8:32">ta oge naagizayti anjjettidayta.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Ta timirte siyite;</para>
  <para style="q2" vid="PRO 8:33">aadho eranchchata gidite;</para>
  <para style="q2" vid="PRO 8:33">wuda dhayopite.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Tani yootizayssa siyiza asi,</para>
  <para style="q2" vid="PRO 8:34">hach hach ta pengen beettiza asi,</para>
  <para style="q2" vid="PRO 8:34">taso gelizasonkka</para>
  <para style="q2" vid="PRO 8:34">naagiza asi anjjettidaade.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Tana demmiday de7o demmees;</para>
  <para style="q2" vid="PRO 8:35">GODAAPPE izi saba demmees.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Gido attiin tana</para>
  <para style="q2" vid="PRO 8:36">demmontta aggida asi</para>
  <para style="q2" vid="PRO 8:36">bana qohees;</para>
  <para style="q2" vid="PRO 8:36">tana ixxiza ubbati</para>
  <para style="q2" vid="PRO 8:36">hayqo siiqeettes» gadus.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Aadho Erateththinne Eeyateth</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Aadho erateththaya</para>
  <para style="q1" vid="PRO 9:1">baas keeth keexxadus;</para>
  <para style="q2" vid="PRO 9:1">keeththas laappun</para>
  <para style="q2" vid="PRO 9:1">tuussata essadus.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Iza modhdho mehe shukkadus;</para>
  <para style="q2" vid="PRO 9:2">woyne ushshu aggadus;</para>
  <para style="q2" vid="PRO 9:2">maaddaka giigsadus.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Histtada asaa xeyganaas</para>
  <para style="q2" vid="PRO 9:3">ba macca aylleta kiittadus.</para>
  <para style="q2" vid="PRO 9:3">Iza katamayppe dhoqqa soon</para>
  <para style="q2" vid="PRO 9:3">eqqada xeygadus;<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />«Inttenoo! Eray paccidayto</para>
  <para style="q2" vid="PRO 9:4">haa gelite!» gadus.</para>
  <para style="q2" vid="PRO 9:4">Eeyatakka iza,<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />«Haa yiidi ta qumaa miite;</para>
  <para style="q2" vid="PRO 9:5">tani aggida</para>
  <para style="q2" vid="PRO 9:5">woyne ushshaaka uyite!<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Intte eeyateththa ogeza aggite;</para>
  <para style="q2" vid="PRO 9:6">intte shemppora paxa de7ana;</para>
  <para style="q2" vid="PRO 9:6">akeeka ogen hemettite» gadus.<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Qilcciza as seeriza asi ubbay</para>
  <para style="q2" vid="PRO 9:7">baas cashshe kallana;</para>
  <para style="q2" vid="PRO 9:7">iita as zorizaadeyka</para>
  <para style="q2" vid="PRO 9:7">baas kawuyana.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Qilcciza as zoroppa;</para>
  <para style="q2" vid="PRO 9:8">ne iza zorikko izi nena ixxana.</para>
  <para style="q2" vid="PRO 9:8">Aadho eranchcha as seera;</para>
  <para style="q2" vid="PRO 9:8">ne iza seerikko izi nena dosana.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Aadho eranchcha as tamaarsa;</para>
  <para style="q2" vid="PRO 9:9">histtiko izi kaseyssafekka</para>
  <para style="q2" vid="PRO 9:9">aadho eranchcha gidana.</para>
  <para style="q2" vid="PRO 9:9">Xillo as tamaarsa;</para>
  <para style="q2" vid="PRO 9:9">histtiko izi erateth gujjana.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Aadho erateththas koyroy</para>
  <para style="q2" vid="PRO 9:10">GODAAS yashshateththa;</para>
  <para style="q2" vid="PRO 9:10">Geeshshaza eroykka akeeka.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo 28:28</ref>; <ref loc="PSA 111:10">Maza 111:10</ref>; <ref loc="PRO 1:7">Leemi 1:7</ref></char></note><verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Ta gaason nees barey aduqqana;</para>
  <para style="q2" vid="PRO 9:11">nees de7o layththayka gujettana.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Neni aadho eranchcha gidikko</para>
  <para style="q2" vid="PRO 9:12">go7ettana;</para>
  <para style="q2" vid="PRO 9:12">ne qilccizaade gidikko qohettana.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Eeya maccassi wocama darawus;</para>
  <para style="q2" vid="PRO 9:13">iza bana haarukku;</para>
  <para style="q2" vid="PRO 9:13">iza aykkoka erukku.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Iza ba karen utta pe7awus;</para>
  <para style="q2" vid="PRO 9:14">katama giddon dhoqqaso</para>
  <para style="q2" vid="PRO 9:14">keza uttawus.<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Heera aadhdhi</para>
  <para style="q2" vid="PRO 9:15">ba oge bizayta xeygawus.<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />Izakka wozina pacetas,</para>
  <para style="q2" vid="PRO 9:16">«Inttenoo! akeekay paccidayto</para>
  <para style="q2" vid="PRO 9:16">taakko haa yiite.<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />Kaysi uyiza haaththi mal7ees;</para>
  <para style="q2" vid="PRO 9:17">geeman miza qumaykka</para>
  <para style="q2" vid="PRO 9:17">suukesees» gawus.<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Gido attiin hayqqida asay</para>
  <para style="q2" vid="PRO 9:18">heen de7izayssa,</para>
  <para style="q2" vid="PRO 9:18">izi imaththatikka duufo giddon</para>
  <para style="q2" vid="PRO 9:18">dizayssa istti erettenna.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Solomoone Leemisota</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1" />Hayti Solomoone leemisota.</para>
  <para style="q2" vid="PRO 10:1">Aadho erateththi diza nay</para>
  <para style="q2" vid="PRO 10:1">ba aawa ufayssees;</para>
  <para style="q2" vid="PRO 10:1">gido attiin eeya nay</para>
  <para style="q2" vid="PRO 10:1">ba aayo ceecisees.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Bessontta ogera yida</para>
  <para style="q2" vid="PRO 10:2">aqotay go7enna;</para>
  <para style="q2" vid="PRO 10:2">gido attiin xilloteththi</para>
  <para style="q2" vid="PRO 10:2">hayqoppe ashshees.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />GODAY xillota gafisenna;</para>
  <para style="q2" vid="PRO 10:3">gido attiin nagaranchchata</para>
  <para style="q2" vid="PRO 10:3">amo calqamissana.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Azallateththi manqisees;</para>
  <para style="q2" vid="PRO 10:4">minni oosoy gidikko duresees.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Aadho eranchchay</para>
  <para style="q2" vid="PRO 10:5">kath wodera shiishshees;</para>
  <para style="q2" vid="PRO 10:5">kath shiishshiza wode dhiskiza</para>
  <para style="q2" vid="PRO 10:5">asi gidikko kawuyees.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Xillo asi anjjettees;</para>
  <para style="q2" vid="PRO 10:6">iita asa doona</para>
  <para style="q2" vid="PRO 10:6">makkallateththi gordees.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Xillota sunththay</para>
  <para style="q2" vid="PRO 10:7">anjjon xeygettishe daana;</para>
  <para style="q2" vid="PRO 10:7">iitata sunththi gidikko dogettana.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Aadho eranchchay</para>
  <para style="q2" vid="PRO 10:8">azazo ero gi ekkees;</para>
  <para style="q2" vid="PRO 10:8">lom7ulom7iza eeyati gidikko</para>
  <para style="q2" vid="PRO 10:8">bashshaso beettes.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Suure asi hirgay baynda dees;</para>
  <para style="q2" vid="PRO 10:9">geella oge biza asi gidikko</para>
  <para style="q2" vid="PRO 10:9">ba mooron oykettana.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Gene oosos qim7otiza asi</para>
  <para style="q2" vid="PRO 10:10">meto ehees;</para>
  <para style="q2" vid="PRO 10:10">lom7ulom7iza eeyaykka</para>
  <para style="q2" vid="PRO 10:10">meto ehees.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Xillota haasayay de7o pultto;</para>
  <para style="q2" vid="PRO 10:11">iitata haasayay gidikko</para>
  <para style="q2" vid="PRO 10:11">makkallateth genththees.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Ixoy palama denththeththees;</para>
  <para style="q2" vid="PRO 10:12">siiqoy gidikko</para>
  <para style="q2" vid="PRO 10:12">bala ubbaa kammi aadhdhees.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">Yaaqo 5:20</ref>; <ref loc="1PE 4:8">1Phex 4:8</ref></char></note><verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Wozinama asay</para>
  <para style="q2" vid="PRO 10:13">aadho eran haasayees;</para>
  <para style="q2" vid="PRO 10:13">eeya zokkon gidikko</para>
  <para style="q2" vid="PRO 10:13">xam7ay meqqees.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Aadho eranchchati</para>
  <para style="q2" vid="PRO 10:14">erateth dagaseettes;</para>
  <para style="q2" vid="PRO 10:14">eeya haasayay gidikko bash xeygees.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Dureta aqotay isttas</para>
  <para style="q2" vid="PRO 10:15">gimbettida katama;</para>
  <para style="q2" vid="PRO 10:15">manqota manqoteththi</para>
  <para style="q2" vid="PRO 10:15">isttas dhayoso.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Xillo asa damozay de7o;</para>
  <para style="q2" vid="PRO 10:16">iita asatas</para>
  <para style="q2" vid="PRO 10:16">wodhey gidikko qixaate.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Seera ekkiza asi</para>
  <para style="q2" vid="PRO 10:17">de7o ogen hemettees;</para>
  <para style="q2" vid="PRO 10:17">seera ixxiza asi gidikko</para>
  <para style="q2" vid="PRO 10:17">meto bolla wodhdhees.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ixxishe ba ixxizayssa</para>
  <para style="q2" vid="PRO 10:18">qottiza asi wordanchcha;</para>
  <para style="q2" vid="PRO 10:18">zigirs zigirza</para>
  <para style="q2" vid="PRO 10:18">asi gidikko eeya.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Daro haasaya giddon</para>
  <para style="q2" vid="PRO 10:19">mooroy dhayenna;</para>
  <para style="q2" vid="PRO 10:19">ba doona shiishshi ekkiza</para>
  <para style="q2" vid="PRO 10:19">asi gidikko</para>
  <para style="q2" vid="PRO 10:19">aadho eranchcha.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Xillota haasayati</para>
  <para style="q2" vid="PRO 10:20">geeshsha bira mala;</para>
  <para style="q2" vid="PRO 10:20">iita asa qofas gidikko</para>
  <para style="q2" vid="PRO 10:20">go7ay deenna.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Xillota haasayay darota go7ees;</para>
  <para style="q2" vid="PRO 10:21">eeyati gidikko</para>
  <para style="q2" vid="PRO 10:21">ba wozina pacen hayqqeettes.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />GODAA anjjoy dure kessees;</para>
  <para style="q2" vid="PRO 10:22">izi he dureteththan</para>
  <para style="q2" vid="PRO 10:22">meto gujjenna.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Eeya asi iita ooson ufayeettes;</para>
  <para style="q2" vid="PRO 10:23">wozinama asi gidikko</para>
  <para style="q2" vid="PRO 10:23">aadho erateththan ufayeettes.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Iita as hirgiza miish</para>
  <para style="q2" vid="PRO 10:24">iza bolla gakkana;</para>
  <para style="q2" vid="PRO 10:24">gido attiin xillo amoy</para>
  <para style="q2" vid="PRO 10:24">izas polettana.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Gote carkoy dendishin</para>
  <para style="q2" vid="PRO 10:25">iitati pitetti dhayana;</para>
  <para style="q2" vid="PRO 10:25">xilloti gidikko</para>
  <para style="q2" vid="PRO 10:25">mernaas minni daana.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Caalay ach zil7issiza malanne</para>
  <para style="q2" vid="PRO 10:26">cuway ayfe qohiza mala</para>
  <para style="q2" vid="PRO 10:26">azalla asi kiittidaadenttas</para>
  <para style="q2" vid="PRO 10:26">hessa mala.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />GODAAS yashshi layth adussees;</para>
  <para style="q2" vid="PRO 10:27">iitata barey gidikko qaanththa.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Xillota hidotay ufayssan gaththees;</para>
  <para style="q2" vid="PRO 10:28">iitata hidotay gidikko</para>
  <para style="q2" vid="PRO 10:28">hada gidi attees.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />GODAA ogey xillotas</para>
  <para style="q2" vid="PRO 10:29">baqati attizasoho;</para>
  <para style="q2" vid="PRO 10:29">iita ooththizaytas gidikko bashsha soho.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Xilloti mulekka dhoqallettettenna;</para>
  <para style="q2" vid="PRO 10:30">iitati gidikko biitta bolla</para>
  <para style="q2" vid="PRO 10:30">de7ettenna.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Xillota doonay</para>
  <para style="q2" vid="PRO 10:31">aadho erateth haasayees;</para>
  <para style="q2" vid="PRO 10:31">geellata inxarsi gidikko qanxxettana.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Xillota metershay</para>
  <para style="q2" vid="PRO 10:32">bessiza yo7o haasayees;</para>
  <para style="q2" vid="PRO 10:32">iita doonay gidikko</para>
  <para style="q2" vid="PRO 10:32">bokka yootees.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />GODAY wordo geeddara ixxees;</para>
  <para style="q2" vid="PRO 11:1">gido attiin suure</para>
  <para style="q2" vid="PRO 11:1">geeddaran ufayettees.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Otoroteththi kawushshateth kaaleththees;</para>
  <para style="q2" vid="PRO 11:2">ashketeththi gidikko</para>
  <para style="q2" vid="PRO 11:2">aadho erateth ehees.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Xillota istta suureteththi kaaleththees;</para>
  <para style="q2" vid="PRO 11:3">gido attiin wordanchchata</para>
  <para style="q2" vid="PRO 11:3">istta wordoteththi dhayssees.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Hanqo gallas dureteththi go7enna;</para>
  <para style="q2" vid="PRO 11:4">gido attiin xilloteththi</para>
  <para style="q2" vid="PRO 11:4">hayqoppe ashshees.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Borey baynda asata</para>
  <para style="q2" vid="PRO 11:5">istta xilloteththi</para>
  <para style="q2" vid="PRO 11:5">isttas oge suurisees;</para>
  <para style="q2" vid="PRO 11:5">gido attiin iitati bantta</para>
  <para style="q2" vid="PRO 11:5">iitateththan kundeettes.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Suureta istta xilloteththi ashshees;</para>
  <para style="q2" vid="PRO 11:6">gido attiin malteti</para>
  <para style="q2" vid="PRO 11:6">bantta iita</para>
  <para style="q2" vid="PRO 11:6">amon oykettana.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Iita asi hayqqiza wode</para>
  <para style="q2" vid="PRO 11:7">iza hidotay hada gidees;</para>
  <para style="q2" vid="PRO 11:7">ba wolqqan izi ceeqettizaazi</para>
  <para style="q2" vid="PRO 11:7">ubbayka dhayees.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Xilloy metoppe attees;</para>
  <para style="q2" vid="PRO 11:8">gido attiin metoy</para>
  <para style="q2" vid="PRO 11:8">iita asa bolla gakkees.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Iita asi ba doonan</para>
  <para style="q2" vid="PRO 11:9">ba laggeza dhayssees;</para>
  <para style="q2" vid="PRO 11:9">gido attiin xilloti erateththan</para>
  <para style="q2" vid="PRO 11:9">kessi ekki atteettes.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Xillotas injjetiza wode</para>
  <para style="q2" vid="PRO 11:10">katamay ufayettees;</para>
  <para style="q2" vid="PRO 11:10">qasse iitati dhayza wode</para>
  <para style="q2" vid="PRO 11:10">hashshu gees.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Suureta anjjo gaason</para>
  <para style="q2" vid="PRO 11:11">katamay diccees;</para>
  <para style="q2" vid="PRO 11:11">iita haasayan gidikko</para>
  <para style="q2" vid="PRO 11:11">katamay dhayees.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Wozina pace asi</para>
  <para style="q2" vid="PRO 11:12">ba shooroza kadhees;</para>
  <para style="q2" vid="PRO 11:12">akeekanchcha asi gidikko</para>
  <para style="q2" vid="PRO 11:12">ba doona shiishshi ekkees.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Zigirza asi xuura laallees;</para>
  <para style="q2" vid="PRO 11:13">ammanettiza asi gidikko</para>
  <para style="q2" vid="PRO 11:13">xuura naagees.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Kaaleththo pacen</para>
  <para style="q2" vid="PRO 11:14">kawoteththi kundees;</para>
  <para style="q2" vid="PRO 11:14">daro zoranchchati de7ikko</para>
  <para style="q2" vid="PRO 11:14">saroy dees.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Erontta asas waasettizay</para>
  <para style="q2" vid="PRO 11:15">meton gelees;</para>
  <para style="q2" vid="PRO 11:15">waase gelanaas caaqqonttaade</para>
  <para style="q2" vid="PRO 11:15">aykkoyka bochchenna.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Ulo kiya maccassaya</para>
  <para style="q2" vid="PRO 11:16">bonchchettawus;</para>
  <para style="q2" vid="PRO 11:16">wolqqaththiza asati</para>
  <para style="q2" vid="PRO 11:16">dureteth xalla duretteettes.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Kiya asi bana go7ees;</para>
  <para style="q2" vid="PRO 11:17">menxe iita asi gidikko</para>
  <para style="q2" vid="PRO 11:17">ba bolla meto ehees.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Iita asi demmiza wodhey deenna;</para>
  <para style="q2" vid="PRO 11:18">xilloteth zeriza asi gidikko</para>
  <para style="q2" vid="PRO 11:18">suure woyto ekkana.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Xilloy de7o demmana;</para>
  <para style="q2" vid="PRO 11:19">gido attiin iitateth</para>
  <para style="q2" vid="PRO 11:19">kaalliza asi hayqqana.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />GODAY iita qofay</para>
  <para style="q2" vid="PRO 11:20">de7iza asata shaatettees;</para>
  <para style="q2" vid="PRO 11:20">gido attiin suure</para>
  <para style="q2" vid="PRO 11:20">hemettizaytan ufayettees.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Iita asi qaxxayettontta attenna;</para>
  <para style="q2" vid="PRO 11:21">gido attiin xilloti</para>
  <para style="q2" vid="PRO 11:21">qaxxayettettenna.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Akeekay paccida</para>
  <para style="q2" vid="PRO 11:22">maccassa puulateththi</para>
  <para style="q2" vid="PRO 11:22">guddunththa siidhen</para>
  <para style="q2" vid="PRO 11:22">aaththida worqqa mala.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Xillota amos wurseththi lo7o xalla;</para>
  <para style="q2" vid="PRO 11:23">gido attiin iitata amos</para>
  <para style="q2" vid="PRO 11:23">wurseththi hanqo xalla.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Issi issi asati</para>
  <para style="q2" vid="PRO 11:24">coo kiyateth immeettes;</para>
  <para style="q2" vid="PRO 11:24">gido attiin isttas aqoy</para>
  <para style="q2" vid="PRO 11:24">haa haa darees.</para>
  <para style="q2" vid="PRO 11:24">Baggati keehi uuzetteettes;</para>
  <para style="q2" vid="PRO 11:24">gido attiin istti</para>
  <para style="q2" vid="PRO 11:24">manqi manqi beettes.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Kiya asi durettana;</para>
  <para style="q2" vid="PRO 11:25">haratas immizay</para>
  <para style="q2" vid="PRO 11:25">baas woppa demmees.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Geemara kath dagasizaade</para>
  <para style="q2" vid="PRO 11:26">derey qanggees;</para>
  <para style="q2" vid="PRO 11:26">kessi bayzizaadey gidikko</para>
  <para style="q2" vid="PRO 11:26">anjjettees.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Lo7o miish minththi koyzaade</para>
  <para style="q2" vid="PRO 11:27">lo7o miishshi naagees;</para>
  <para style="q2" vid="PRO 11:27">gido attiin iita miish koyzaade</para>
  <para style="q2" vid="PRO 11:27">iita miishshi gakkees.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Ba dureteththan</para>
  <para style="q2" vid="PRO 11:28">ammanettiza asi kundana;</para>
  <para style="q2" vid="PRO 11:28">xilloti gidikko</para>
  <para style="q2" vid="PRO 11:28">lo7o miththa mala cililana.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Soo asaa bolla shiro denththiza</para>
  <para style="q2" vid="PRO 11:29">asi go7ay baynda attana;</para>
  <para style="q2" vid="PRO 11:29">Eeyatikka aadho eranchchatas</para>
  <para style="q2" vid="PRO 11:29">aylle gidana.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Xillo asi de7o ayfe</para>
  <para style="q2" vid="PRO 11:30">ayfiza miththa mala;</para>
  <para style="q2" vid="PRO 11:30">shemppota ashshizay</para>
  <para style="q2" vid="PRO 11:30">aadho eranchcha.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Xilloti sa7an</para>
  <para style="q2" vid="PRO 11:31">bantta ooso waaga</para>
  <para style="q2" vid="PRO 11:31">ekkizaa gidikko,</para>
  <para style="q2" vid="PRO 11:31">iitatinne nagaranchchati</para>
  <para style="q2" vid="PRO 11:31">bantta oosos ekkana waagay</para>
  <para style="q2" vid="PRO 11:31">waani darandeeshaa!<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1Phex 4:18</ref></char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Seera dosiza asi erateth dosees;</para>
  <para style="q2" vid="PRO 12:1">gido attiin seera ixxiza</para>
  <para style="q2" vid="PRO 12:1">asi damma.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Lo7o asi GODAAPPE saba demmees;</para>
  <para style="q2" vid="PRO 12:2">gido attiin GODAY</para>
  <para style="q2" vid="PRO 12:2">genanchchata pirdees.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Asi iitateththan eqqidi</para>
  <para style="q2" vid="PRO 12:3">minni kanththanawu dandayenna;</para>
  <para style="q2" vid="PRO 12:3">xilloti gidikko</para>
  <para style="q2" vid="PRO 12:3">ba dizasoppe qaaxxettenna.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Wozinama maccassaya</para>
  <para style="q2" vid="PRO 12:4">ba keeththaawas</para>
  <para style="q2" vid="PRO 12:4">kallachcha mala;</para>
  <para style="q2" vid="PRO 12:4">yeellachchiza machcha</para>
  <para style="q2" vid="PRO 12:4">ba azinaas</para>
  <para style="q2" vid="PRO 12:4">meqeththa garsan diza</para>
  <para style="q2" vid="PRO 12:4">woyzazire harge mala.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Xillota qofay suure;</para>
  <para style="q2" vid="PRO 12:5">iitata zorey gidikko cimo.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Iitata haasayay as wodhees;</para>
  <para style="q2" vid="PRO 12:6">xillota haasayay gidikko</para>
  <para style="q2" vid="PRO 12:6">as ashshees.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Iita asati kundana;</para>
  <para style="q2" vid="PRO 12:7">isttas zereththika attenna;</para>
  <para style="q2" vid="PRO 12:7">xillota zereththi gidikko</para>
  <para style="q2" vid="PRO 12:7">minni daana.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Asi ba aadho erateththa mala</para>
  <para style="q2" vid="PRO 12:8">galateettes;</para>
  <para style="q2" vid="PRO 12:8">gido attiin geella qofay</para>
  <para style="q2" vid="PRO 12:8">de7iza asi kadhettees.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Aykkoy baynda dishin</para>
  <para style="q2" vid="PRO 12:9">dure asa mala ceeqettiza asappe</para>
  <para style="q2" vid="PRO 12:9">bana ziqqi histti</para>
  <para style="q2" vid="PRO 12:9">baas ooththi aqiza asi kiya.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Xillo asi ba mehes qadhettees;</para>
  <para style="q2" vid="PRO 12:10">iita asi kiyattees giikkoka</para>
  <para style="q2" vid="PRO 12:10">menxe iita.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Ba biittaa minththi ooththiza asi</para>
  <para style="q2" vid="PRO 12:11">kath kallees;</para>
  <para style="q2" vid="PRO 12:11">akeekay paccida asi</para>
  <para style="q2" vid="PRO 12:11">go7ay baynda hidota gooddees.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Nagaranchchati iitati</para>
  <para style="q2" vid="PRO 12:12">di7i ehidayssa amotteettes;</para>
  <para style="q2" vid="PRO 12:12">xillota zereththi gidikko daayana.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Iita asi ba haasayda</para>
  <para style="q2" vid="PRO 12:13">iita haasayan oykettees;</para>
  <para style="q2" vid="PRO 12:13">xilloy gidikko metoppe</para>
  <para style="q2" vid="PRO 12:13">kessi ekki attees.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Asi ba doonappe ke7iza qaalan</para>
  <para style="q2" vid="PRO 12:14">lo7o miish kallees;</para>
  <para style="q2" vid="PRO 12:14">ba ooththida ooso</para>
  <para style="q2" vid="PRO 12:14">waagakka demmees.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Eeya asas izi biza ogey</para>
  <para style="q2" vid="PRO 12:15">izas lo7o misatees;</para>
  <para style="q2" vid="PRO 12:15">aadho eranchchay zore siyees.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Eeya asa hanqoy heerakka erettees;</para>
  <para style="q2" vid="PRO 12:16">cincca asi gidikko</para>
  <para style="q2" vid="PRO 12:16">cashshe wudu geenna.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Suure markkay tuma markkattees;</para>
  <para style="q2" vid="PRO 12:17">wordoy gidikko</para>
  <para style="q2" vid="PRO 12:17">wordo markkattees.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Akeekontta haasayza haasayay</para>
  <para style="q2" vid="PRO 12:18">toora mala caddees;</para>
  <para style="q2" vid="PRO 12:18">aadho eranchcha</para>
  <para style="q2" vid="PRO 12:18">inxarsi gidikko paththees.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Wordo haasayay guuththa wodessa;</para>
  <para style="q2" vid="PRO 12:19">tuma haasayay gidikko</para>
  <para style="q2" vid="PRO 12:19">mernaassa.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Iita qoppizayta wozinan</para>
  <para style="q2" vid="PRO 12:20">baleththoy dees;</para>
  <para style="q2" vid="PRO 12:20">gido attiin saro miish qoppizayta</para>
  <para style="q2" vid="PRO 12:20">wozinan ufayssi dees.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Xillota qohoy gakkenna;</para>
  <para style="q2" vid="PRO 12:21">iitati gidikko meto kallana.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />GODAY wordo haasaya harasettees;</para>
  <para style="q2" vid="PRO 12:22">tumanchchatan gidikko</para>
  <para style="q2" vid="PRO 12:22">ufayettees.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Akeekara diza asi</para>
  <para style="q2" vid="PRO 12:23">ba erateth qottees;</para>
  <para style="q2" vid="PRO 12:23">wozinay baynda asi</para>
  <para style="q2" vid="PRO 12:23">ba eeyateththaa nashshees.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Minni ooththiza asi dere haarees;</para>
  <para style="q2" vid="PRO 12:24">azallay aylle gidees.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Hirgan kumida wozinay</para>
  <para style="q2" vid="PRO 12:25">as ceecen yeggees;</para>
  <para style="q2" vid="PRO 12:25">shongara diza haasayay gidikko</para>
  <para style="q2" vid="PRO 12:25">ufayssees.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Xillo asi ba lagge</para>
  <para style="q2" vid="PRO 12:26">lo7o zore zorees;</para>
  <para style="q2" vid="PRO 12:26">iitata zorey gidikko</para>
  <para style="q2" vid="PRO 12:26">tuma ogeppe haassees.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Azalla asi shankkatidi</para>
  <para style="q2" vid="PRO 12:27">ehida ashoza xiixenna;</para>
  <para style="q2" vid="PRO 12:27">minni ooththiza asi gidikko</para>
  <para style="q2" vid="PRO 12:27">ba aqotas mishettees.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Xilloteththa ogen de7oy dees;</para>
  <para style="q2" vid="PRO 12:28">he ogen hayqoy deenna.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Era nay ba aawa zore</para>
  <para style="q2" vid="PRO 13:1">wozinappe siyees;</para>
  <para style="q2" vid="PRO 13:1">qilccizay gidikko seera siyenna.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Asi ba doonappe ke7iza qaalan</para>
  <para style="q2" vid="PRO 13:2">lo7o miish demmees;</para>
  <para style="q2" vid="PRO 13:2">ammanettonttayti gidikko</para>
  <para style="q2" vid="PRO 13:2">makkallateth amotteettes.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Ba doona naagiza asi</para>
  <para style="q2" vid="PRO 13:3">ba shemppo naagees;</para>
  <para style="q2" vid="PRO 13:3">doonan yida mala haasayza asi</para>
  <para style="q2" vid="PRO 13:3">bana dhayssees.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Azallay keehi amottees shin</para>
  <para style="q2" vid="PRO 13:4">aykkoka demmenna;</para>
  <para style="q2" vid="PRO 13:4">minni ooththizayta</para>
  <para style="q2" vid="PRO 13:4">amoy gidikko kumana.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Xillo asati wordo haasaya ixxeettes;</para>
  <para style="q2" vid="PRO 13:5">iita asata haasayay gidikko</para>
  <para style="q2" vid="PRO 13:5">yeellaseessinne kawushshees.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Xilloteththi Suure as naagees;</para>
  <para style="q2" vid="PRO 13:6">iitateththi gidikko</para>
  <para style="q2" vid="PRO 13:6">nagaranchcha dhayssees.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Aykkoy baynda</para>
  <para style="q2" vid="PRO 13:7">bana dure misatissiza asi dees;</para>
  <para style="q2" vid="PRO 13:7">hara baggara baas</para>
  <para style="q2" vid="PRO 13:7">daro aqotay dishin</para>
  <para style="q2" vid="PRO 13:7">manqo misati beettiza asi dees.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Asi ba dureteththan</para>
  <para style="q2" vid="PRO 13:8">ba shemppo wozzana gidana;</para>
  <para style="q2" vid="PRO 13:8">manqoy gidikko</para>
  <para style="q2" vid="PRO 13:8">hirgay baynda uttees.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Xillota poo7oy keehi poo7ees;</para>
  <para style="q2" vid="PRO 13:9">iitata xomppey gidikko to7ana.<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Otoroy oosh yelees;</para>
  <para style="q2" vid="PRO 13:10">aadho erateththi gidikko</para>
  <para style="q2" vid="PRO 13:10">zore ekkizayta matan dees.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Bessontta ogera demmida miishshi</para>
  <para style="q2" vid="PRO 13:11">dhayi dhayi bees;</para>
  <para style="q2" vid="PRO 13:11">ba cawa gussidi demmida aqotay</para>
  <para style="q2" vid="PRO 13:11">dari dari bees.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Hidotay polettontta gam7iko</para>
  <para style="q2" vid="PRO 13:12">wozinay meqqees;</para>
  <para style="q2" vid="PRO 13:12">gido attiin amottidayssi</para>
  <para style="q2" vid="PRO 13:12">polettishin ufayssees.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Zore kadhiza asi meton gelees;</para>
  <para style="q2" vid="PRO 13:13">azazo bonchchiza asi gidikko</para>
  <para style="q2" vid="PRO 13:13">ba waaga ekkana.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Aadho eranchchay immiza timirtey</para>
  <para style="q2" vid="PRO 13:14">de7o pultto;</para>
  <para style="q2" vid="PRO 13:14">hessi asi hayqo woximaden</para>
  <para style="q2" vid="PRO 13:14">gelontta mala naagees.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Akeekay de7iza asi bonchchettees;</para>
  <para style="q2" vid="PRO 13:15">ammanettontta agoy</para>
  <para style="q2" vid="PRO 13:15">bashsha oge efees.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Akeekiza asi eran ooththees;</para>
  <para style="q2" vid="PRO 13:16">eeyay gidikko</para>
  <para style="q2" vid="PRO 13:16">ba eeyateththa qonccisees.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Iita asi kiitettiko meton gelees;</para>
  <para style="q2" vid="PRO 13:17">ammanettida asi kiitettiko</para>
  <para style="q2" vid="PRO 13:17">saroteth ehees.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Seera ixxiza asi</para>
  <para style="q2" vid="PRO 13:18">manqeessinne kawuyees;</para>
  <para style="q2" vid="PRO 13:18">hanqo siyiza asi gidikko</para>
  <para style="q2" vid="PRO 13:18">bonchchettees.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Amoy polettiko keehi ufayssees;</para>
  <para style="q2" vid="PRO 13:19">eeyati gidikko</para>
  <para style="q2" vid="PRO 13:19">iitappe haakkanaas koyettenna.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Aadho eranchchatara hemettiza asi</para>
  <para style="q2" vid="PRO 13:20">aadho eranchcha gidees;</para>
  <para style="q2" vid="PRO 13:20">gido attiin eeyatara hemettiza asi</para>
  <para style="q2" vid="PRO 13:20">meton gelees.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Nagaranchchata</para>
  <para style="q2" vid="PRO 13:21">iita qaaday kaallees;</para>
  <para style="q2" vid="PRO 13:21">dureteththi gidikko</para>
  <para style="q2" vid="PRO 13:21">xillotas imettiza woyto.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Lo7o asi baas</para>
  <para style="q2" vid="PRO 13:22">naa nayta gakkanaas laatisees;</para>
  <para style="q2" vid="PRO 13:22">nagaranchcha aqotay gidikko</para>
  <para style="q2" vid="PRO 13:22">xillotas dagattees.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Manqo gadey</para>
  <para style="q2" vid="PRO 13:23">daro kath immana dandayees;</para>
  <para style="q2" vid="PRO 13:23">gido attiin suure pirday dhaykko</para>
  <para style="q2" vid="PRO 13:23">pitetti dhayees.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Seerontta dichchizay ba naa ixxees;</para>
  <para style="q2" vid="PRO 13:24">gido attiin seeri dichchizay</para>
  <para style="q2" vid="PRO 13:24">ba naa dosees.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Xilloy kallanaashe gakkanaas mees;</para>
  <para style="q2" vid="PRO 13:25">iitati gidikko gafida mala daana.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Aadho erateththi diza maccassaya</para>
  <para style="q2" vid="PRO 14:1">ba keeth keexxawus;</para>
  <para style="q2" vid="PRO 14:1">eeyaya gidikko ba keeth</para>
  <para style="q2" vid="PRO 14:1">ba kushen laallawus.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Suure hemettiza asi</para>
  <para style="q2" vid="PRO 14:2">GODAAS yayyees;</para>
  <para style="q2" vid="PRO 14:2">geella oge hemettizay gidikko</para>
  <para style="q2" vid="PRO 14:2">iza kadhees.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Eeya haasayay iza zokkos</para>
  <para style="q2" vid="PRO 14:3">gatuma ehees;</para>
  <para style="q2" vid="PRO 14:3">aadho eranchchata</para>
  <para style="q2" vid="PRO 14:3">inxarsay gidikko</para>
  <para style="q2" vid="PRO 14:3">istta naagees.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Booray bayndason</para>
  <para style="q2" vid="PRO 14:4">gootaray mela dees;</para>
  <para style="q2" vid="PRO 14:4">gido attiin nees boorata wolqqan</para>
  <para style="q2" vid="PRO 14:4">daro kaththi beettees.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Ammanettiza markkay ubbato</para>
  <para style="q2" vid="PRO 14:5">tuma markkattees;</para>
  <para style="q2" vid="PRO 14:5">wordo markkay gidikko</para>
  <para style="q2" vid="PRO 14:5">wordo markkattees.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Qilccizay aadho erateth</para>
  <para style="q2" vid="PRO 14:6">koykkoka demmenna;</para>
  <para style="q2" vid="PRO 14:6">akeekay diza asi waayettontta</para>
  <para style="q2" vid="PRO 14:6">erateth demmees.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Eeya asappe haakka;</para>
  <para style="q2" vid="PRO 14:7">ays giikko neni iza haasayappe</para>
  <para style="q2" vid="PRO 14:7">erateth demmaka.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Akeekanchcha asas</para>
  <para style="q2" vid="PRO 14:8">aadho erateththi</para>
  <para style="q2" vid="PRO 14:8">ba oge naago;</para>
  <para style="q2" vid="PRO 14:8">eeyata eeyateththi gidikko</para>
  <para style="q2" vid="PRO 14:8">istta cimmees.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Eeyati nagara ooththidi</para>
  <para style="q2" vid="PRO 14:9">modhettanayssa aggidi</para>
  <para style="q2" vid="PRO 14:9">qilcceettes;</para>
  <para style="q2" vid="PRO 14:9">suure asatappe gidikko</para>
  <para style="q2" vid="PRO 14:9">lo7o qofay beettees.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Issoy issoy ba wozinan diza</para>
  <para style="q2" vid="PRO 14:10">ceece erees;</para>
  <para style="q2" vid="PRO 14:10">iza ufayssaa</para>
  <para style="q2" vid="PRO 14:10">oonikka izara koxxenna.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Iitata keeththay laalettana;</para>
  <para style="q2" vid="PRO 14:11">suureta keeththay gidikko</para>
  <para style="q2" vid="PRO 14:11">minni de7ana.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Asas likke misatiza ogey dees;</para>
  <para style="q2" vid="PRO 14:12">wurseththan gidikko</para>
  <para style="q2" vid="PRO 14:12">hayqos gaththees.<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">Leemi 16:25</ref></char></note><verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Miichchankka wozinay</para>
  <para style="q2" vid="PRO 14:13">meqqi erees;</para>
  <para style="q2" vid="PRO 14:13">muuzoteththan ufayssi</para>
  <para style="q2" vid="PRO 14:13">polettana dandayees.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Ba wozina xilloteththafe haassizayti</para>
  <para style="q2" vid="PRO 14:14">ba ooso waaga ekkana;</para>
  <para style="q2" vid="PRO 14:14">lo7o asikka ba lo7o ooso</para>
  <para style="q2" vid="PRO 14:14">waaga ekkana.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Eeya asi ubbaa miish ammanees;</para>
  <para style="q2" vid="PRO 14:15">cinccay gidikko</para>
  <para style="q2" vid="PRO 14:15">akeekidi tanggees.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Aadho eranchchay</para>
  <para style="q2" vid="PRO 14:16">GODAAS yayyeessinne</para>
  <para style="q2" vid="PRO 14:16">saatti tanggees;</para>
  <para style="q2" vid="PRO 14:16">iitappeka haakkees;</para>
  <para style="q2" vid="PRO 14:16">eeyay gidikko</para>
  <para style="q2" vid="PRO 14:16">wuday baynda bichcharees.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Elle hanqettiza asi</para>
  <para style="q2" vid="PRO 14:17">eeya ooso ooththees;</para>
  <para style="q2" vid="PRO 14:17">yo7o qachchiza asi dosettenna.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Wozina paceti eeyateth laattana;</para>
  <para style="q2" vid="PRO 14:18">akeekanchchati gidikko</para>
  <para style="q2" vid="PRO 14:18">erateth kallachcha mala goxxana.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Iitati lo7ota sinththan gulbatana;</para>
  <para style="q2" vid="PRO 14:19">nagaranchchati</para>
  <para style="q2" vid="PRO 14:19">xillota pengen hokkana.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Manqota istta laggetikka ixxeettes;</para>
  <para style="q2" vid="PRO 14:20">duretas gidikko</para>
  <para style="q2" vid="PRO 14:20">daro laggeti deettes.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ba shooro kadhiza asi</para>
  <para style="q2" vid="PRO 14:21">nagara ooththees;</para>
  <para style="q2" vid="PRO 14:21">gido attiin manqo maaddizay</para>
  <para style="q2" vid="PRO 14:21">anjjettidayssa.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Iita halchchizayti</para>
  <para style="q2" vid="PRO 14:22">suure ogeppe</para>
  <para style="q2" vid="PRO 14:22">kare kezeettes dettenee?</para>
  <para style="q2" vid="PRO 14:22">Lo7o qoppizayti gidikko</para>
  <para style="q2" vid="PRO 14:22">siiqonne ammaneteth eheettes.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Minni ooson ubbaan wodhey dees;</para>
  <para style="q2" vid="PRO 14:23">hada yo7oy gidikko manqisees.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Aadho eranchchatas</para>
  <para style="q2" vid="PRO 14:24">istta dureteththi</para>
  <para style="q2" vid="PRO 14:24">isttas kallachcha;</para>
  <para style="q2" vid="PRO 14:24">eeyata eeyateththi gidikko</para>
  <para style="q2" vid="PRO 14:24">coo hada.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Tumu markkay shemppo ashshees;</para>
  <para style="q2" vid="PRO 14:25">wordo markkay gidikko baleththees.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />GODAAS yayyiza asas</para>
  <para style="q2" vid="PRO 14:26">mino miixay dees;</para>
  <para style="q2" vid="PRO 14:26">iza naytaska</para>
  <para style="q2" vid="PRO 14:26">baqati attiza sohoy dees.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />GODAAS yashshi de7o pultto;</para>
  <para style="q2" vid="PRO 14:27">hayqo woximadeppe as ashshees.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Dere corateththay kawos bonchcho;</para>
  <para style="q2" vid="PRO 14:28">dere guuththateththi</para>
  <para style="q2" vid="PRO 14:28">kawos bash gidees.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Dandayanchcha asas</para>
  <para style="q2" vid="PRO 14:29">gita akeekay dees;</para>
  <para style="q2" vid="PRO 14:29">elle hanqettiza asi gidikko</para>
  <para style="q2" vid="PRO 14:29">ba eeyateth qonccisees.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Woppu gida wozinay</para>
  <para style="q2" vid="PRO 14:30">bollas payyateth immees;</para>
  <para style="q2" vid="PRO 14:30">qanaatey gidikko</para>
  <para style="q2" vid="PRO 14:30">meqeththa giddon gelida</para>
  <para style="q2" vid="PRO 14:30">woyzazire mala.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Manqota naaqqiza asi</para>
  <para style="q2" vid="PRO 14:31">istta medhdhidayssa cayees;</para>
  <para style="q2" vid="PRO 14:31">metotanchchatas</para>
  <para style="q2" vid="PRO 14:31">qadhettizaa gidikko</para>
  <para style="q2" vid="PRO 14:31">Xoossa bonchchees.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Iitati bantta iita ooson kundana;</para>
  <para style="q2" vid="PRO 14:32">gido attiin xilloti</para>
  <para style="q2" vid="PRO 14:32">hayqo wodekka</para>
  <para style="q2" vid="PRO 14:32">baqati attizasoy dees.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Akeekanchcha asaa wozinan</para>
  <para style="q2" vid="PRO 14:33">aadho erateththi kumides;</para>
  <para style="q2" vid="PRO 14:33">gido attiin eeyati</para>
  <para style="q2" vid="PRO 14:33">aadho erateththa gishshas</para>
  <para style="q2" vid="PRO 14:33">aykkoka erettenna.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Xilloteththi kawoteththaa</para>
  <para style="q2" vid="PRO 14:34">dhoqqu dhoqqu ooththees;</para>
  <para style="q2" vid="PRO 14:34">gido attiin nagaray</para>
  <para style="q2" vid="PRO 14:34">ay asikka kawushshees.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Aadho erateththi diza aylley</para>
  <para style="q2" vid="PRO 14:35">kawo ufayssees;</para>
  <para style="q2" vid="PRO 14:35">gido attiin yeellachchiza aylley</para>
  <para style="q2" vid="PRO 14:35">ba bolla hanqo ehees.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Liiqo zaaroy hanqo irxxisees;</para>
  <para style="q2" vid="PRO 15:1">pordolo qaalay gidikko</para>
  <para style="q2" vid="PRO 15:1">hanqo denththeththees.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Aadho eranchcha inxarsafe</para>
  <para style="q2" vid="PRO 15:2">erateththi pulttees;</para>
  <para style="q2" vid="PRO 15:2">gido attiin dogata doonappe</para>
  <para style="q2" vid="PRO 15:2">eeyateththi pulttees.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />GODAA ayfeti ubbaso xeelleettes;</para>
  <para style="q2" vid="PRO 15:3">iitatanne lo7ota ubbaa</para>
  <para style="q2" vid="PRO 15:3">lo7eththi be7eettes.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Shongay de7iza lo7o haasayay</para>
  <para style="q2" vid="PRO 15:4">de7o miththa mala;</para>
  <para style="q2" vid="PRO 15:4">gido attiin baleththo haasayay</para>
  <para style="q2" vid="PRO 15:4">ayana qohees.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Eeyay ba aawa seera kadhees;</para>
  <para style="q2" vid="PRO 15:5">gido attiin zore ekkizay</para>
  <para style="q2" vid="PRO 15:5">ba akeekateththaa qonccisees.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Xillo asa keeththan</para>
  <para style="q2" vid="PRO 15:6">daro aqotay dees;</para>
  <para style="q2" vid="PRO 15:6">gido attiin iitatas</para>
  <para style="q2" vid="PRO 15:6">geliza miishshi meto ehees.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Aadho eranchchata doonay</para>
  <para style="q2" vid="PRO 15:7">erateth zerees;</para>
  <para style="q2" vid="PRO 15:7">eeyata wozinay gidikko</para>
  <para style="q2" vid="PRO 15:7">hessa mala deenna.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />GODAY iitata yarsho shaatettees;</para>
  <para style="q2" vid="PRO 15:8">suureta woosay gidikko</para>
  <para style="q2" vid="PRO 15:8">iza ufayssees.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />GODAY iita asata oge shaatettees;</para>
  <para style="q2" vid="PRO 15:9">gido attiin xilloteth</para>
  <para style="q2" vid="PRO 15:9">kaallizayta dosees.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Suure oge aggidi kare ke7idaade</para>
  <para style="q2" vid="PRO 15:10">hanqoy naagees;</para>
  <para style="q2" vid="PRO 15:10">seera ixxiza asi hayqqees.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Duufoninne dhayo giddon dizayssi</para>
  <para style="q2" vid="PRO 15:11">GODAA sinththan qoncce;</para>
  <para style="q2" vid="PRO 15:11">histtiin asa wozina qofay</para>
  <para style="q2" vid="PRO 15:11">waani izappe geemmanee?<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Qilcciza asi seera dosenna;</para>
  <para style="q2" vid="PRO 15:12">aadho eranchchatappekka</para>
  <para style="q2" vid="PRO 15:12">zore oychchenna.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Wozina ufayssi sinth poo7isees;</para>
  <para style="q2" vid="PRO 15:13">wozina ceecey gidikko</para>
  <para style="q2" vid="PRO 15:13">ayana qohees.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Akeekiza wozinay erateth koyees;</para>
  <para style="q2" vid="PRO 15:14">gido attiin dogata doonay</para>
  <para style="q2" vid="PRO 15:14">eeyateth banchikees.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Manqota de7oy</para>
  <para style="q2" vid="PRO 15:15">ubbaa gallassika baaxe.</para>
  <para style="q2" vid="PRO 15:15">Ufayettiza asati ubbatokka</para>
  <para style="q2" vid="PRO 15:15">bantta de7on ufayetteettes<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Ooshshi dizason diza gita aqotappe</para>
  <para style="q2" vid="PRO 15:16">GODAA yashshateththara diza</para>
  <para style="q2" vid="PRO 15:16">guuththa aqotay aadhdhees.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Ooshshi dizason</para>
  <para style="q2" vid="PRO 15:17">modhdho asho maanaappe</para>
  <para style="q2" vid="PRO 15:17">siiqoy dizason</para>
  <para style="q2" vid="PRO 15:17">santh muusi aadhdhees.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Eeson hanqettiza asi oosh kessees;</para>
  <para style="q2" vid="PRO 15:18">dandayza asi gidikko</para>
  <para style="q2" vid="PRO 15:18">oosh irxxisees.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Azalla asa ogey</para>
  <para style="q2" vid="PRO 15:19">agunththan diretti uttides;</para>
  <para style="q2" vid="PRO 15:19">suure asa ogey gidikko</para>
  <para style="q2" vid="PRO 15:19">baasa gidees.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Aadho erara diza nay</para>
  <para style="q2" vid="PRO 15:20">ba aawa ufayssees;</para>
  <para style="q2" vid="PRO 15:20">gido attiin eeya nay</para>
  <para style="q2" vid="PRO 15:20">ba aayo kadhees.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Wozina pace asi</para>
  <para style="q2" vid="PRO 15:21">ba eeyateththan ufayettees;</para>
  <para style="q2" vid="PRO 15:21">gido attiin akeeki</para>
  <para style="q2" vid="PRO 15:21">suure oge kaallees.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Zorey dhaykko</para>
  <para style="q2" vid="PRO 15:22">halchchoy ogen attees;</para>
  <para style="q2" vid="PRO 15:22">daro zoranchchati dizason</para>
  <para style="q2" vid="PRO 15:22">halchchoy polettees.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Asi bessiza zaaro immidi</para>
  <para style="q2" vid="PRO 15:23">ufays demmees;</para>
  <para style="q2" vid="PRO 15:23">koshshiza woden imettida qaalay</para>
  <para style="q2" vid="PRO 15:23">ay mala lo7oo!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Duge duufon woththiza</para>
  <para style="q2" vid="PRO 15:24">oge bontta mala</para>
  <para style="q2" vid="PRO 15:24">de7o ogey aadho eranchcha</para>
  <para style="q2" vid="PRO 15:24">pude kaaleththawus.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />GODAY otoranchchata</para>
  <para style="q2" vid="PRO 15:25">keeththa laallees;</para>
  <para style="q2" vid="PRO 15:25">gido attiin am7ey zawa naagees.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />GODAY iitata qofa shaatettees;</para>
  <para style="q2" vid="PRO 15:26">geeshshata qofay gidikko</para>
  <para style="q2" vid="PRO 15:26">iza ufayssees.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Uuze asi baso asa bolla</para>
  <para style="q2" vid="PRO 15:27">meto ehees;</para>
  <para style="q2" vid="PRO 15:27">gido attiin matta7e ixxiza asi</para>
  <para style="q2" vid="PRO 15:27">paxa daana.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Xillo asi haasayanaappe</para>
  <para style="q2" vid="PRO 15:28">kasetidi qoppees;</para>
  <para style="q2" vid="PRO 15:28">gido attiin iita asa doonappe</para>
  <para style="q2" vid="PRO 15:28">iita qaalay goggees.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />GODAY iitatappe haakon dees;</para>
  <para style="q2" vid="PRO 15:29">gido attiin xillota woosa siyees.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Pashka hanoy wozina ufayssees;</para>
  <para style="q2" vid="PRO 15:30">mishiraachcho qaalay</para>
  <para style="q2" vid="PRO 15:30">meqeth cililisees.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />De7o immiza seera ekkiza asi</para>
  <para style="q2" vid="PRO 15:31">aadho eranchchatara</para>
  <para style="q2" vid="PRO 15:31">issife daana.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Seera ixxiza asi bana kadhees;</para>
  <para style="q2" vid="PRO 15:32">seera ekkiza asi gidikko</para>
  <para style="q2" vid="PRO 15:32">akeeka demmees.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />GODAAS yashshi</para>
  <para style="q2" vid="PRO 15:33">aadho erateth tamaarssees;</para>
  <para style="q2" vid="PRO 15:33">bonchchettana koyida asi</para>
  <para style="q2" vid="PRO 15:33">koyro bana</para>
  <para style="q2" vid="PRO 15:33">kawushshanaas koshshees.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Asi ba wozinan halchchees;</para>
  <para style="q2" vid="PRO 16:1">gido attiin zaaroy</para>
  <para style="q2" vid="PRO 16:1">GODAAPPE beettees.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Asi biza oge ubbay</para>
  <para style="q2" vid="PRO 16:2">izas lo7o misatees;</para>
  <para style="q2" vid="PRO 16:2">GODAY koyro denththa qofaa</para>
  <para style="q2" vid="PRO 16:2">caddi xeellees.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Ne ooththiza ubbaa hadara</para>
  <para style="q2" vid="PRO 16:3">GODAAS imma;</para>
  <para style="q2" vid="PRO 16:3">histtiko ne halchchoy polettana.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />GODAY ubbaa miish</para>
  <para style="q2" vid="PRO 16:4">medhdhida gaasoykka dees;</para>
  <para style="q2" vid="PRO 16:4">makkallanchchata gidikkoka</para>
  <para style="q2" vid="PRO 16:4">bashsha gallassas</para>
  <para style="q2" vid="PRO 16:4">giigsi woththides.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />GODAY otorettiza</para>
  <para style="q2" vid="PRO 16:5">ubbaa shaatettees;</para>
  <para style="q2" vid="PRO 16:5">istti qaxxayettontta attettenna.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Siiqoninne ammaneteththan</para>
  <para style="q2" vid="PRO 16:6">nagaray atto geetettees;</para>
  <para style="q2" vid="PRO 16:6">GODAAS yashshateththan</para>
  <para style="q2" vid="PRO 16:6">asi iitappe haakkees.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Asa hemetay</para>
  <para style="q2" vid="PRO 16:7">GODAA ufayssizaaz gidikko</para>
  <para style="q2" vid="PRO 16:7">iza morkketi</para>
  <para style="q2" vid="PRO 16:7">izara saro daana mala ooththees.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Xilloteththan beettiza</para>
  <para style="q2" vid="PRO 16:8">guuththa miishshi</para>
  <para style="q2" vid="PRO 16:8">wordora demmiza</para>
  <para style="q2" vid="PRO 16:8">daro wodheppe aadhdhees.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Asi ba wozinan</para>
  <para style="q2" vid="PRO 16:9">ba ooththana miish halchchees;</para>
  <para style="q2" vid="PRO 16:9">halchchozi GODAY giikko</para>
  <para style="q2" vid="PRO 16:9">polettees.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Kawo metershati</para>
  <para style="q2" vid="PRO 16:10">Xoossafe ekkida maatan</para>
  <para style="q2" vid="PRO 16:10">haasayeettes;</para>
  <para style="q2" vid="PRO 16:10">iza inxarsi</para>
  <para style="q2" vid="PRO 16:10">pirda geellasanaas bessenna.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Suure geeddaratinne</para>
  <para style="q2" vid="PRO 16:11">maka miishshati GODAAPPE;</para>
  <para style="q2" vid="PRO 16:11">karaxiite giddon diza geeddarati</para>
  <para style="q2" vid="PRO 16:11">ubbay iza oosota.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Kawoti iita ooso harassetteettes;</para>
  <para style="q2" vid="PRO 16:12">ays giikko kawoteththa araatay</para>
  <para style="q2" vid="PRO 16:12">xilloteththan eqqees.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Xillo haasayan kawoti ufayetteettes;</para>
  <para style="q2" vid="PRO 16:13">tuma haasayzaytakka doseettes.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Kawo hanqoy</para>
  <para style="q2" vid="PRO 16:14">hayqo kiitanchcha mala;</para>
  <para style="q2" vid="PRO 16:14">aadho eranchchay gidikko</para>
  <para style="q2" vid="PRO 16:14">hanqo irxxisees.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Kawoy pashki gishin de7oy dees;</para>
  <para style="q2" vid="PRO 16:15">izas kiyateththi</para>
  <para style="q2" vid="PRO 16:15">ira tookkida badhdhesa</para>
  <para style="q2" vid="PRO 16:15">shaara mala.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Aadho erateththa demoy</para>
  <para style="q2" vid="PRO 16:16">worqqa demmizayssafe aadhdhees;</para>
  <para style="q2" vid="PRO 16:16">akeeka demoy</para>
  <para style="q2" vid="PRO 16:16">bira demoppeka aadhdhees.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Suureta ogey iitatappe haakon dees;</para>
  <para style="q2" vid="PRO 16:17">ba hemeta naagiza asi</para>
  <para style="q2" vid="PRO 16:17">ba shemppo naagees.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Otoro geedo bashshi kaallees;</para>
  <para style="q2" vid="PRO 16:18">hallaca geedokka</para>
  <para style="q2" vid="PRO 16:18">kundeththi kaallees.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Otoranchchatara zuppetidi</para>
  <para style="q2" vid="PRO 16:19">di7i ehida miish</para>
  <para style="q2" vid="PRO 16:19">shaaketti ekkanaappe</para>
  <para style="q2" vid="PRO 16:19">manqotara manqeteththan</para>
  <para style="q2" vid="PRO 16:19">duussi kiya.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Zore ekkiza asi duretees;</para>
  <para style="q2" vid="PRO 16:20">GODAAN ammanettiza asi</para>
  <para style="q2" vid="PRO 16:20">anjjettidaade.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Wozinan aadho eranchcha gidida</para>
  <para style="q2" vid="PRO 16:21">asati akeekanchcha</para>
  <para style="q2" vid="PRO 16:21">geetetteettes;</para>
  <para style="q2" vid="PRO 16:21">lo7o qaalay erateth gujjees.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Baas miish ooththidaades</para>
  <para style="q2" vid="PRO 16:22">akeekay de7o pultto;</para>
  <para style="q2" vid="PRO 16:22">dogatas gidikko</para>
  <para style="q2" vid="PRO 16:22">eeyateththi hanqo ehees.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Aadho eranchcha wozinay</para>
  <para style="q2" vid="PRO 16:23">iza doona kaaleththees;</para>
  <para style="q2" vid="PRO 16:23">iza metershatikka</para>
  <para style="q2" vid="PRO 16:23">erateth gujji gujji beettes.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Lo7o qaalay</para>
  <para style="q2" vid="PRO 16:24">eessa ililo mala mal7ees;</para>
  <para style="q2" vid="PRO 16:24">bollaka maaddeessinne</para>
  <para style="q2" vid="PRO 16:24">paththees.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Asas suure misatiza ogey dees;</para>
  <para style="q2" vid="PRO 16:25">gido attiin wurseththan</para>
  <para style="q2" vid="PRO 16:25">hayqos gaththees.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">Leemi 14:12</ref></char></note><verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Kaththa koshshi</para>
  <para style="q2" vid="PRO 16:26">asi minni ooththana mala</para>
  <para style="q2" vid="PRO 16:26">denththeththees;</para>
  <para style="q2" vid="PRO 16:26">gafaykka oosos minththeththees.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Iita asi iitateth qoppees;</para>
  <para style="q2" vid="PRO 16:27">iza haasayaykka xuuggiza tama mala.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Geella asi oosh denththees;</para>
  <para style="q2" vid="PRO 16:28">zigirsi ammanettiza</para>
  <para style="q2" vid="PRO 16:28">laggeta shaakkees.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Gene asi ba shooroza cimmees;</para>
  <para style="q2" vid="PRO 16:29">lo7o gidontta oge</para>
  <para style="q2" vid="PRO 16:29">iza kaaleththees.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ayfera qim7oti bessiza asi</para>
  <para style="q2" vid="PRO 16:30">geellateth qoppees;</para>
  <para style="q2" vid="PRO 16:30">ba mettershaa saxxiza asi</para>
  <para style="q2" vid="PRO 16:30">iitaso bees.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Pulunththi bonchcho kallachcha;</para>
  <para style="q2" vid="PRO 16:31">hessi xilloteththa</para>
  <para style="q2" vid="PRO 16:31">duussan beettees.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Wolqqama as gidanaappe</para>
  <para style="q2" vid="PRO 16:32">dandaya as gideth lo7o;</para>
  <para style="q2" vid="PRO 16:32">bana haarizaadey</para>
  <para style="q2" vid="PRO 16:32">katama wolqqan</para>
  <para style="q2" vid="PRO 16:32">haarizaadefe aadhdhees.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Asi saama yeggees;</para>
  <para style="q2" vid="PRO 16:33">gido attiin wurseththa polo</para>
  <para style="q2" vid="PRO 16:33">immizay GODAA.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Ooshshi de7izason de7iza</para>
  <para style="q2" vid="PRO 17:1">gita gibira maanaappe</para>
  <para style="q2" vid="PRO 17:1">saroynne woppay de7izason</para>
  <para style="q2" vid="PRO 17:1">ukeththa mela meeththi kiya.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Akeekanchcha aylles shufuro gidida</para>
  <para style="q2" vid="PRO 17:2">ba goda naa bolla maatay dees;</para>
  <para style="q2" vid="PRO 17:2">histtidi ishantta mala</para>
  <para style="q2" vid="PRO 17:2">isttara issife laattees.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Worqqaynne biray</para>
  <para style="q2" vid="PRO 17:3">taman paacettizayssa mala</para>
  <para style="q2" vid="PRO 17:3">GODAY asaa wozina pilggi xeellees.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Iita asi iita haasaya siyees;</para>
  <para style="q2" vid="PRO 17:4">wordanchchayka</para>
  <para style="q2" vid="PRO 17:4">genanchcha haasaya ezgees.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Hiyeesata bolla qilcciza asi</para>
  <para style="q2" vid="PRO 17:5">istta medhdhidayssa cayees;</para>
  <para style="q2" vid="PRO 17:5">hara as gakkiza meton</para>
  <para style="q2" vid="PRO 17:5">ufayettiza asi</para>
  <para style="q2" vid="PRO 17:5">qaxxayettontta attenna.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Nayta nayti</para>
  <para style="q2" vid="PRO 17:6">cimmida asatas kallachcha;</para>
  <para style="q2" vid="PRO 17:6">yelidayti bantta naytas bonchcho.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Lo7o haasayay eeyas giigenna;</para>
  <para style="q2" vid="PRO 17:7">wordo haasayay dere ayssizaades</para>
  <para style="q2" vid="PRO 17:7">ay mala deexo!<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Matta7ey immizaades bita mala;</para>
  <para style="q2" vid="PRO 17:8">izi bida soho ubbaan izas</para>
  <para style="q2" vid="PRO 17:8">injjetana misatees.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Qohettidi ba qohoza genththiza asi</para>
  <para style="q2" vid="PRO 17:9">siiqo koyees;</para>
  <para style="q2" vid="PRO 17:9">gido attiin yo7o</para>
  <para style="q2" vid="PRO 17:9">zaari zaaridi piqqiza asi</para>
  <para style="q2" vid="PRO 17:9">ammanettiza laggeta shaakkees.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Eeyay xeetuto</para>
  <para style="q2" vid="PRO 17:10">lisson shociin erizayssafe</para>
  <para style="q2" vid="PRO 17:10">akeekay de7iza asi coo seeriin</para>
  <para style="q2" vid="PRO 17:10">erizayssi aadhdhees.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Iita asi makkalla miish xalla koyees;</para>
  <para style="q2" vid="PRO 17:11">hessa gishshas iza bolla</para>
  <para style="q2" vid="PRO 17:11">menxe iita asi kiitettana.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Eeya asara</para>
  <para style="q2" vid="PRO 17:12">iza eeyateththa mala</para>
  <para style="q2" vid="PRO 17:12">gayttanaappe</para>
  <para style="q2" vid="PRO 17:12">marata bonqqi ekkichchida</para>
  <para style="q2" vid="PRO 17:12">maaheyra gayteththi kiya.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Lo7o ooththidaades iita</para>
  <para style="q2" vid="PRO 17:13">zaarizaadesoppe</para>
  <para style="q2" vid="PRO 17:13">iitay mulekka dhayenna.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Oosh doomeththi eele haath</para>
  <para style="q2" vid="PRO 17:14">pogi yeddo mala;</para>
  <para style="q2" vid="PRO 17:14">hessa gishshas ooshshi</para>
  <para style="q2" vid="PRO 17:14">medhettanaappe</para>
  <para style="q2" vid="PRO 17:14">kasetada kichchaycha.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Wordanchcha xillo</para>
  <para style="q2" vid="PRO 17:15">xilloza wordo guussi</para>
  <para style="q2" vid="PRO 17:15">nam7ayka GODAA sinththan</para>
  <para style="q2" vid="PRO 17:15">ixettida ooso.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Aadho erateththi demmanaas</para>
  <para style="q2" vid="PRO 17:16">izi koyontta gishshas</para>
  <para style="q2" vid="PRO 17:16">eeya kushen gelida miish</para>
  <para style="q2" vid="PRO 17:16">iza ay go7anee?<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Laggey ay wodekka lagge;</para>
  <para style="q2" vid="PRO 17:17">ishaykka meto wodes yelettees.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Akeekay paccida asi baqqi caaqqidi</para>
  <para style="q2" vid="PRO 17:18">hara asas waase gelees.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Oosh dosiza asi nagara dosees;</para>
  <para style="q2" vid="PRO 17:19">ubbato bana dhoqqu histtizaadey</para>
  <para style="q2" vid="PRO 17:19">ba bolla bash xeygees.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Geella qofay de7izaades injjetenna;</para>
  <para style="q2" vid="PRO 17:20">wordo haasayza asikka</para>
  <para style="q2" vid="PRO 17:20">meton gelees.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Eeya naa yeloy ceecisees;</para>
  <para style="q2" vid="PRO 17:21">eeya naa aawaas ufayssi deenna.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Ufayettiza wozinay lo7o dhale;</para>
  <para style="q2" vid="PRO 17:22">gido attiin meqqida wozinay</para>
  <para style="q2" vid="PRO 17:22">asas wolqqa dhayssees.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Iita asi pirda geellasanaas</para>
  <para style="q2" vid="PRO 17:23">geeman matta7e ekkees.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Akeekay de7iza asi</para>
  <para style="q2" vid="PRO 17:24">aadho erateth</para>
  <para style="q2" vid="PRO 17:24">ba sinththafe dhayssenna;</para>
  <para style="q2" vid="PRO 17:24">gido attiin eeya ayfey</para>
  <para style="q2" vid="PRO 17:24">sa7a gaxa gakkanaas yuuyees.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Eeya nay ba aawa ceecisees;</para>
  <para style="q2" vid="PRO 17:25">bana yelida aayokka xuuggees.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Xillo as qaxxayo bessenna;</para>
  <para style="q2" vid="PRO 17:26">suure as shocoy lo7o gidenna.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Amarda qaala haasayza asi</para>
  <para style="q2" vid="PRO 17:27">aadho eranchcha;</para>
  <para style="q2" vid="PRO 17:27">woppa ayanay de7iza</para>
  <para style="q2" vid="PRO 17:27">asikka akeekanchcha.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Eeya asi co7u giikko</para>
  <para style="q2" vid="PRO 17:28">aadho eranchcha misatees;</para>
  <para style="q2" vid="PRO 17:28">ba doonakka shiishshi oykkiko</para>
  <para style="q2" vid="PRO 17:28">akeekanchcha misatees.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Laggeteth koyontta asi</para>
  <para style="q2" vid="PRO 18:1">ba amo kaallees;</para>
  <para style="q2" vid="PRO 18:1">suure pirdaka ubbaa palqqees.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Eeyay ba qofa</para>
  <para style="q2" vid="PRO 18:2">qonccisanaaro xalla dosees;</para>
  <para style="q2" vid="PRO 18:2">gido attiin hara asappe</para>
  <para style="q2" vid="PRO 18:2">era ekkanaas dosenna.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Iitateththi kadhe kaaleththees;</para>
  <para style="q2" vid="PRO 18:3">yeellateththi yishin</para>
  <para style="q2" vid="PRO 18:3">kawushshateththi yees.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Asa doonappe ke7iza haasayay</para>
  <para style="q2" vid="PRO 18:4">ciimma haaththa mala;</para>
  <para style="q2" vid="PRO 18:4">aadho erateththa pulttoyka</para>
  <para style="q2" vid="PRO 18:4">xongettiza piissa haaththaa mala.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Iita as maaddidi,</para>
  <para style="q2" vid="PRO 18:5">xilloza pirda geellasizayssi</para>
  <para style="q2" vid="PRO 18:5">lo7o gidenna.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Eeya asa doonay iza bolla</para>
  <para style="q2" vid="PRO 18:6">oosh denththees;</para>
  <para style="q2" vid="PRO 18:6">iza doonappe ke7iza qaalay</para>
  <para style="q2" vid="PRO 18:6">iza bolla durqqa xeygees.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Eeya asa haasayay iza dhayssees;</para>
  <para style="q2" vid="PRO 18:7">iza metershati izas</para>
  <para style="q2" vid="PRO 18:7">woximade gideettes.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Zigiranchcha qaalay mal7o quma mala;</para>
  <para style="q2" vid="PRO 18:8">asas duge marace gakkees.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Azalla asi dhayssiza asas isha.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />GODAA sunththi mino gimbe mala;</para>
  <para style="q2" vid="PRO 18:10">xillo asi hee woxxidi</para>
  <para style="q2" vid="PRO 18:10">iitappe attees.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Dureta dureteththi</para>
  <para style="q2" vid="PRO 18:11">isttas yuushoy</para>
  <para style="q2" vid="PRO 18:11">gimbettida katama mala;</para>
  <para style="q2" vid="PRO 18:11">istti bantta dureteththa</para>
  <para style="q2" vid="PRO 18:11">ke7ettontta</para>
  <para style="q2" vid="PRO 18:11">adussa gimbe mala qoodettees.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Asi kundanaappe kase</para>
  <para style="q2" vid="PRO 18:12">iza wozinay otorettees;</para>
  <para style="q2" vid="PRO 18:12">ashketeththi bonchchofe</para>
  <para style="q2" vid="PRO 18:12">sinththatees.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Lo7eththi siyontta dishe zaaroy,</para>
  <para style="q2" vid="PRO 18:13">izaades eeyateththinne</para>
  <para style="q2" vid="PRO 18:13">yeella gidees.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Asa ayanay</para>
  <para style="q2" vid="PRO 18:14">harge dandayana mala maaddees;</para>
  <para style="q2" vid="PRO 18:14">gido attiin ayanay</para>
  <para style="q2" vid="PRO 18:14">meqerettichchiko</para>
  <para style="q2" vid="PRO 18:14">iza ooni dandayanee?<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Akeekanchcha wozinay</para>
  <para style="q2" vid="PRO 18:15">erateth koyees;</para>
  <para style="q2" vid="PRO 18:15">aadho eranchcha hayththi</para>
  <para style="q2" vid="PRO 18:15">minththi koyees.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Imotay immizaades oge doyees;</para>
  <para style="q2" vid="PRO 18:16">iza gita asatarakka erisees.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Baalgaaray yiidi</para>
  <para style="q2" vid="PRO 18:17">ba qaala immana gakkanaas</para>
  <para style="q2" vid="PRO 18:17">kasetidi yo7o haasaydaadey</para>
  <para style="q2" vid="PRO 18:17">xillo misatees.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Saama yessi palama teqqees;</para>
  <para style="q2" vid="PRO 18:18">nam7u wolqqama</para>
  <para style="q2" vid="PRO 18:18">baaligaaratakka shaakkees.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Qohettida ishay</para>
  <para style="q2" vid="PRO 18:19">gimbettida katamappe</para>
  <para style="q2" vid="PRO 18:19">aadhdhi minnees;</para>
  <para style="q2" vid="PRO 18:19">iza palamaykka gimbe penge</para>
  <para style="q2" vid="PRO 18:19">gordiza mino kolata mala.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Ba doonan haasaydaazappe</para>
  <para style="q2" vid="PRO 18:20">asi ba ulo kunththees;</para>
  <para style="q2" vid="PRO 18:20">ba inxarsafe ke7ida</para>
  <para style="q2" vid="PRO 18:20">yo7on kallees.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Inxarsa bolla hayqoynne</para>
  <para style="q2" vid="PRO 18:21">de7o wolqqay dees;</para>
  <para style="q2" vid="PRO 18:21">izo dosizayti izi ayfe meettes.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Machcho demmida asi</para>
  <para style="q2" vid="PRO 18:22">lo7o miish demmees;</para>
  <para style="q2" vid="PRO 18:22">hessaadey GODAAPPE</para>
  <para style="q2" vid="PRO 18:22">bonchcho ekkees.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Hiyeesa asi aadashidi haasayees;</para>
  <para style="q2" vid="PRO 18:23">gido attiin durey</para>
  <para style="q2" vid="PRO 18:23">dhechchi zaarees.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Lagge darssiza asi</para>
  <para style="q2" vid="PRO 18:24">baas meto darsees;</para>
  <para style="q2" vid="PRO 18:24">gido attiin ishappe aadhdhidi</para>
  <para style="q2" vid="PRO 18:24">ammanettiza laggey dees.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Geella yo7o haasayza iita asappe</para>
  <para style="q2" vid="PRO 19:1">ba de7on borey baynda</para>
  <para style="q2" vid="PRO 19:1">hiyeesa asi lo7o.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Erateththi baynda zil7eteththi</para>
  <para style="q2" vid="PRO 19:2">lo7o gidenna;</para>
  <para style="q2" vid="PRO 19:2">eeso hemetay oge baleththees.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Issi issi asay ba eeyateththan</para>
  <para style="q2" vid="PRO 19:3">ba de7o moorees;</para>
  <para style="q2" vid="PRO 19:3">histtidi GODAA bolla yiillotees.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Dureteththi daro lagge medhdhees;</para>
  <para style="q2" vid="PRO 19:4">gido attiin manqoteththi</para>
  <para style="q2" vid="PRO 19:4">kase diza lagge haassees.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Wordo markkay</para>
  <para style="q2" vid="PRO 19:5">qaxxayettontta attenna;</para>
  <para style="q2" vid="PRO 19:5">wordo puukkizaykka</para>
  <para style="q2" vid="PRO 19:5">qaxxayettontta attenna.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Daro asay lo7o misatanaas</para>
  <para style="q2" vid="PRO 19:6">daanna sinththan alaanththees;</para>
  <para style="q2" vid="PRO 19:6">coo immiza asara</para>
  <para style="q2" vid="PRO 19:6">asi ubbay dabbotees.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Manqo iza dabbo ubbay ixxees;</para>
  <para style="q2" vid="PRO 19:7">histtiin iza laggeti ay keena</para>
  <para style="q2" vid="PRO 19:7">izappe baqatanee!</para>
  <para style="q2" vid="PRO 19:7">Kaalli aadashidikka</para>
  <para style="q2" vid="PRO 19:7">izi istta demmenna.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Aadho erateth</para>
  <para style="q2" vid="PRO 19:8">baas miish ooththizay</para>
  <para style="q2" vid="PRO 19:8">bana siiqees;</para>
  <para style="q2" vid="PRO 19:8">akeeka siiqizaades injjetees.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Wordo markkay</para>
  <para style="q2" vid="PRO 19:9">qaxxayettontta attenna;</para>
  <para style="q2" vid="PRO 19:9">wordo puukkizaykka dhayana.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Eeyati ishalo duus</para>
  <para style="q2" vid="PRO 19:10">daanaas bessenna;</para>
  <para style="q2" vid="PRO 19:10">aylley godaa bolla godatikko</para>
  <para style="q2" vid="PRO 19:10">hessi ay keena iitaa!<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Aadho erateththi</para>
  <para style="q2" vid="PRO 19:11">as dandayanchcha kessees;</para>
  <para style="q2" vid="PRO 19:11">qoho yedhdhi aadheththi bonchchon gaththees.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Kawo hanqoy gaammo xaago mala;</para>
  <para style="q2" vid="PRO 19:12">gido attiin iza sinththan</para>
  <para style="q2" vid="PRO 19:12">saba demoy</para>
  <para style="q2" vid="PRO 19:12">maata cililissiza ira mala.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Eeya nay ba aawa</para>
  <para style="q2" vid="PRO 19:13">bashshas aaththi immees;</para>
  <para style="q2" vid="PRO 19:13">oosh ehiza machcha</para>
  <para style="q2" vid="PRO 19:13">ira aaththiza keeththa mala.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Keeththinne aqotay</para>
  <para style="q2" vid="PRO 19:14">yelidaytappe laatteettes;</para>
  <para style="q2" vid="PRO 19:14">akeekara diza machcha GODAAPPE beettawus.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Azallateththi deexo dhisko ehees;</para>
  <para style="q2" vid="PRO 19:15">ooso ooththontta asi gafees.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Azazo naagizay</para>
  <para style="q2" vid="PRO 19:16">ba shemppo naagees;</para>
  <para style="q2" vid="PRO 19:16">gido attiin</para>
  <para style="q2" vid="PRO 19:16">izo ixxizaadey hayqqees.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Manqos kiyiza asi</para>
  <para style="q2" vid="PRO 19:17">GODAAS tal7ees;</para>
  <para style="q2" vid="PRO 19:17">GODAY he lo7o ooso</para>
  <para style="q2" vid="PRO 19:17">waaga qanxxana.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Wodera ne naa seera;</para>
  <para style="q2" vid="PRO 19:18">izi hayqos bishin</para>
  <para style="q2" vid="PRO 19:18">co7u ga xeellofa.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Eeson yiillotiza asi</para>
  <para style="q2" vid="PRO 19:19">qaxxayettanaas bessees;</para>
  <para style="q2" vid="PRO 19:19">neni agga aadhdhiko</para>
  <para style="q2" vid="PRO 19:19">hara wodekka</para>
  <para style="q2" vid="PRO 19:19">nees hessaththo oosoy attenna.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Zore siya; seerakka ekka.</para>
  <para style="q2" vid="PRO 19:20">Histtiko neni wurseththan</para>
  <para style="q2" vid="PRO 19:20">aadho eranchcha gidana.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Asa wozinan daro halchchoy dees;</para>
  <para style="q2" vid="PRO 19:21">gido attiin</para>
  <para style="q2" vid="PRO 19:21">GODAA qofay polettees.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Asappe koyettizay mino siiqo;</para>
  <para style="q2" vid="PRO 19:22">wordanchcha gidanaappe</para>
  <para style="q2" vid="PRO 19:22">manqoteththi lo7o.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />GODAAS yashshi de7os kaaleththees;</para>
  <para style="q2" vid="PRO 19:23">hessa mala asi woppan dees;</para>
  <para style="q2" vid="PRO 19:23">iitaykka iza bochchenna.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Azallay ba kushe maaddan yeddees;</para>
  <para style="q2" vid="PRO 19:24">gido attiin pude ba doonan</para>
  <para style="q2" vid="PRO 19:24">zaaranawu waayettees.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Qilccizaade shocikko</para>
  <para style="q2" vid="PRO 19:25">wozina pacey akeeka taamarana;</para>
  <para style="q2" vid="PRO 19:25">akeekanchcha asa seerikko</para>
  <para style="q2" vid="PRO 19:25">izi erateth demmana.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ba aawa bonqqiza nay,</para>
  <para style="q2" vid="PRO 19:26">ba aayokka kessi yedeththiza nay</para>
  <para style="q2" vid="PRO 19:26">izi yeellateththinne</para>
  <para style="q2" vid="PRO 19:26">kawushshateth ehiza naa.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Ta naazoo!</para>
  <para style="q2" vid="PRO 19:27">Ta zore ne siyontta aggiko,</para>
  <para style="q2" vid="PRO 19:27">ne eriza qaalaakka balana.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Wordo markkay</para>
  <para style="q2" vid="PRO 19:28">suure pirda bolla qilccees;</para>
  <para style="q2" vid="PRO 19:28">iita asa doonay</para>
  <para style="q2" vid="PRO 19:28">iitateth banchikees.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Qilccizaytas pirday,</para>
  <para style="q2" vid="PRO 19:29">eeyata zokkos lissoy</para>
  <para style="q2" vid="PRO 19:29">giigi uttides.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Maththosiza ushshi uyizay</para>
  <para style="q2" vid="PRO 20:1">qilccizaadenne eeya gidees;</para>
  <para style="q2" vid="PRO 20:1">haytanttan balettida ubbay</para>
  <para style="q2" vid="PRO 20:1">aadho eranchcha gidenna.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Kawo hanqoy gaammo xaago mala;</para>
  <para style="q2" vid="PRO 20:2">iza yiillochchizay</para>
  <para style="q2" vid="PRO 20:2">ba shemppo bolla pirdees.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Palamappe haakoy</para>
  <para style="q2" vid="PRO 20:3">izaades bonchcho;</para>
  <para style="q2" vid="PRO 20:3">gido attiin eeya asi ubbay</para>
  <para style="q2" vid="PRO 20:3">ooshshas eesotees.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Azalla goshshanchchay</para>
  <para style="q2" vid="PRO 20:4">wodera goyenna;</para>
  <para style="q2" vid="PRO 20:4">kath shiishshiza wode</para>
  <para style="q2" vid="PRO 20:4">shiishshanaas koyees;</para>
  <para style="q2" vid="PRO 20:4">gido attiin aykkoka demmenna.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Asa wozina halchchoy</para>
  <para style="q2" vid="PRO 20:5">ciimma ollan de7iza</para>
  <para style="q2" vid="PRO 20:5">haaththa mala;</para>
  <para style="q2" vid="PRO 20:5">gido attiin wozinama asi</para>
  <para style="q2" vid="PRO 20:5">heeppe duuqqi kessees.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Daro asati bantta</para>
  <para style="q2" vid="PRO 20:6">kiyateththa yooteettes;</para>
  <para style="q2" vid="PRO 20:6">gido attiin ammanettiza as</para>
  <para style="q2" vid="PRO 20:6">ooni demmanaas dandayzee?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Xillo asi borey baynda de7o dees;</para>
  <para style="q2" vid="PRO 20:7">izappe kaallidi</para>
  <para style="q2" vid="PRO 20:7">iza naytikka anjjettidayta.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Kawoy pirdanaas ba kawoteththa</para>
  <para style="q2" vid="PRO 20:8">algan uttiza wode</para>
  <para style="q2" vid="PRO 20:8">iita ubbaa ba ayfetan</para>
  <para style="q2" vid="PRO 20:8">harqidi kessees.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />«Ta wozinaa geeshshadis;</para>
  <para style="q2" vid="PRO 20:9">ta geeshsha;</para>
  <para style="q2" vid="PRO 20:9">tanan nagaray baawa»</para>
  <para style="q2" vid="PRO 20:9">gaanay oonee?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />GODAY wordo meezaanenne</para>
  <para style="q2" vid="PRO 20:10">nam7u qommo geeddara</para>
  <para style="q2" vid="PRO 20:10">miish ixxees.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Nay geeshshinne suure gidizayssi</para>
  <para style="q2" vid="PRO 20:11">izi ooththiza ooson erettees.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Siyiza hayththinne xeelliza ayfe,</para>
  <para style="q2" vid="PRO 20:12">isttaka GODAY medhdhides.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Dhisko siiqoppa!</para>
  <para style="q2" vid="PRO 20:13">Ne histtontta aggiko ne manqana.</para>
  <para style="q2" vid="PRO 20:13">Minnada ooththa;</para>
  <para style="q2" vid="PRO 20:13">histtiko neni kath kallana.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Shammiza asi,</para>
  <para style="q2" vid="PRO 20:14">«Hayssi al7o! Qohees!» gees;</para>
  <para style="q2" vid="PRO 20:14">gido attiin shammi</para>
  <para style="q2" vid="PRO 20:14">simmidaappe guyen,</para>
  <para style="q2" vid="PRO 20:14">«Hiraysson shammadis»</para>
  <para style="q2" vid="PRO 20:14">giidi ceeqettees.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Eray kumida qaala haasayza</para>
  <para style="q2" vid="PRO 20:15">metershati worqqafenne</para>
  <para style="q2" vid="PRO 20:15">zo7o inqqufekka</para>
  <para style="q2" vid="PRO 20:15">aadho geexe.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Erontta asas</para>
  <para style="q2" vid="PRO 20:16">waase geliza asa may7o</para>
  <para style="q2" vid="PRO 20:16">qaari ekkite;</para>
  <para style="q2" vid="PRO 20:16">hawusha maccassas</para>
  <para style="q2" vid="PRO 20:16">waase geliza as oykkite.<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Hawusha maccas gizayssas birsheththay kawushsha guussa.</char></note><verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Wordon demmida kaththi mal7ees;</para>
  <para style="q2" vid="PRO 20:17">gido attiin aqi pe7idi</para>
  <para style="q2" vid="PRO 20:17">doonan ace gidees.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Zore ekkada halchcho halchcha;</para>
  <para style="q2" vid="PRO 20:18">zore ekkontta de7ashe</para>
  <para style="q2" vid="PRO 20:18">olas booppa.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Zigiranchchay xuura laallees;</para>
  <para style="q2" vid="PRO 20:19">hessa gishshas lom7ulom7a</para>
  <para style="q2" vid="PRO 20:19">asappe haakka.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Ba aawa woykko</para>
  <para style="q2" vid="PRO 20:20">ba aayo cayizaades,</para>
  <para style="q2" vid="PRO 20:20">xomppey sakkanna</para>
  <para style="q2" vid="PRO 20:20">dhuman to7ana.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Koyrora eeson beettida aqotas</para>
  <para style="q2" vid="PRO 20:21">wurseththan anjjoy deenna.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Neessi iita ooththida asas,</para>
  <para style="q2" vid="PRO 20:22">«tani izas halo kessana» gooppa;</para>
  <para style="q2" vid="PRO 20:22">GODAAN ammanettada naaga;</para>
  <para style="q2" vid="PRO 20:22">izi nena ashshana.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />GODAY wordo meezaanen</para>
  <para style="q2" vid="PRO 20:23">ufayettenna</para>
  <para style="q2" vid="PRO 20:23">nam7u qommo geeddara</para>
  <para style="q2" vid="PRO 20:23">miish ixxees.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Asay baanaas bessiza oge</para>
  <para style="q2" vid="PRO 20:24">GODAY kaaleththees;</para>
  <para style="q2" vid="PRO 20:24">histtiin asi barkka</para>
  <para style="q2" vid="PRO 20:24">ba baana oge</para>
  <para style="q2" vid="PRO 20:24">wostti akeekanaas dandayzee?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Issi miish Eesotidi,</para>
  <para style="q2" vid="PRO 20:25">«Hayssa tani Xoossas immana»</para>
  <para style="q2" vid="PRO 20:25">giidi adinettidaappe guye</para>
  <para style="q2" vid="PRO 20:25">zil7eteththi as oykkiza yarde.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Aadho erateththi diza kawoy</para>
  <para style="q2" vid="PRO 20:26">makkallanchchata shaakki erees;</para>
  <para style="q2" vid="PRO 20:26">izi istta qadhettontta qaxxayees.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Asa ayanay GODAA xomppe;</para>
  <para style="q2" vid="PRO 20:27">hessa gishshas</para>
  <para style="q2" vid="PRO 20:27">giddo asateth ubbaa</para>
  <para style="q2" vid="PRO 20:27">izi pilggi xeellees.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Kiyateththinne tumateththi</para>
  <para style="q2" vid="PRO 20:28">kawo naagettees;</para>
  <para style="q2" vid="PRO 20:28">iza kawoteththa araataykka</para>
  <para style="q2" vid="PRO 20:28">siiqon minnees.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Yelagata wolqqay isttas bonchcho;</para>
  <para style="q2" vid="PRO 20:29">cimata pulunththi</para>
  <para style="q2" vid="PRO 20:29">isttas bonchcho.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Mino qixaatey iitateth diggees;</para>
  <para style="q2" vid="PRO 20:30">wadhay iita wozina laammees.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Kawo wozinay</para>
  <para style="q2" vid="PRO 21:1">GODAA kushen dees;</para>
  <para style="q2" vid="PRO 21:1">izi iza wozinaa</para>
  <para style="q2" vid="PRO 21:1">goggiza haaththa mala</para>
  <para style="q2" vid="PRO 21:1">ba dosidaso zaarees.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Asi biza ogey izaades</para>
  <para style="q2" vid="PRO 21:2">suure misatees;</para>
  <para style="q2" vid="PRO 21:2">GODAY gidikko</para>
  <para style="q2" vid="PRO 21:2">wozinaa pilggi xeellees.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Yarshofe bollara xillonne</para>
  <para style="q2" vid="PRO 21:3">suure pirda GODAY dosees.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Otoroynne hallacay</para>
  <para style="q2" vid="PRO 21:4">iita asata bessiza malata;</para>
  <para style="q2" vid="PRO 21:4">hessika nagara.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Mino oosanchcha</para>
  <para style="q2" vid="PRO 21:5">halchchoy duresees;</para>
  <para style="q2" vid="PRO 21:5">gido attiin bichcharisi manqisees.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Wordotidi dagasida aqotay</para>
  <para style="q2" vid="PRO 21:6">dhayza pentta mala;</para>
  <para style="q2" vid="PRO 21:6">qasseka wodhiza woximade mala.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Iitati suure ooso dosontta gishshas</para>
  <para style="q2" vid="PRO 21:7">iitata istta makkallateththi</para>
  <para style="q2" vid="PRO 21:7">dhayssana.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Mooranchchati</para>
  <para style="q2" vid="PRO 21:8">geella ogera hemetteettes;</para>
  <para style="q2" vid="PRO 21:8">gido attiin geeshshati</para>
  <para style="q2" vid="PRO 21:8">suure haneettes.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Duunama machchira daanaappe</para>
  <para style="q2" vid="PRO 21:9">keeththa daaranchchan</para>
  <para style="q2" vid="PRO 21:9">aqoy lo7o.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Iitati iita miish ooththanaas</para>
  <para style="q2" vid="PRO 21:10">keehi amotteettes.</para>
  <para style="q2" vid="PRO 21:10">Iza laggey izappe</para>
  <para style="q2" vid="PRO 21:10">qadheta demmenna.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Qilccizaadey qaxxayettida wode</para>
  <para style="q2" vid="PRO 21:11">wozinay paccida asi</para>
  <para style="q2" vid="PRO 21:11">aadho erateth tamaarees;</para>
  <para style="q2" vid="PRO 21:11">wozinama asikka tamaardi</para>
  <para style="q2" vid="PRO 21:11">erateth demmees.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Xillo Xoossay iitatason</para>
  <para style="q2" vid="PRO 21:12">oosettiza ubbaa caddi xeellees;</para>
  <para style="q2" vid="PRO 21:12">istta mulera dhayssees.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Manqo waaso siyanaappe giidi</para>
  <para style="q2" vid="PRO 21:13">ba hayth tucciko</para>
  <para style="q2" vid="PRO 21:13">izikka waassiza wode</para>
  <para style="q2" vid="PRO 21:13">alliza asi dhayana.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Geeman immiza imotay</para>
  <para style="q2" vid="PRO 21:14">hanqo doshisees;</para>
  <para style="q2" vid="PRO 21:14">afala giddora immida matta7ey</para>
  <para style="q2" vid="PRO 21:14">suule hanqo irxxisees.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Suure pirday xillota ufayssees;</para>
  <para style="q2" vid="PRO 21:15">iita ooththizayta gidikko</para>
  <para style="q2" vid="PRO 21:15">shirosees.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Akeeka ogeppe kare keziza asi</para>
  <para style="q2" vid="PRO 21:16">moytille duulatan shemppees.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Hallaca duus daana</para>
  <para style="q2" vid="PRO 21:17">koyza asi manqees;</para>
  <para style="q2" vid="PRO 21:17">ushshinne muus</para>
  <para style="q2" vid="PRO 21:17">gooddiza asi durettenna.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Xillota bolla yida metoy</para>
  <para style="q2" vid="PRO 21:18">iitata bolla simmana;</para>
  <para style="q2" vid="PRO 21:18">suure asata bolla yida metoy</para>
  <para style="q2" vid="PRO 21:18">ammanettonttayta bolla gakkana.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Wocamizanne doonatiza</para>
  <para style="q2" vid="PRO 21:19">machchira daanaappe</para>
  <para style="q2" vid="PRO 21:19">bazzon duussi kiya.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Wozinama asa soon</para>
  <para style="q2" vid="PRO 21:20">mal7o qumaynne</para>
  <para style="q2" vid="PRO 21:20">zaytey dagatti dees;</para>
  <para style="q2" vid="PRO 21:20">gido attiin eeya asi</para>
  <para style="q2" vid="PRO 21:20">baas dizayssa, bayndaa</para>
  <para style="q2" vid="PRO 21:20">ubbaa dippi histti mees.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Xilloteththinne siiqo</para>
  <para style="q2" vid="PRO 21:21">kaallizaadey de7o,</para>
  <para style="q2" vid="PRO 21:21">dureteththinne</para>
  <para style="q2" vid="PRO 21:21">bonchcho demmees.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Wozinama asi</para>
  <para style="q2" vid="PRO 21:22">wolqqama olanchchati diza</para>
  <para style="q2" vid="PRO 21:22">katama menththi gelees;</para>
  <para style="q2" vid="PRO 21:22">istti ammanettida miixatakka</para>
  <para style="q2" vid="PRO 21:22">laalli yeggees.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ba doonanne ba inxars naagiza asi</para>
  <para style="q2" vid="PRO 21:23">bana boshappe naagees.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Otoranchchaynne hallaca asi</para>
  <para style="q2" vid="PRO 21:24">qidhanchcha geetettees;</para>
  <para style="q2" vid="PRO 21:24">izi otoro hano hanees.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Azalla amoy wodhees;</para>
  <para style="q2" vid="PRO 21:25">ays giikko</para>
  <para style="q2" vid="PRO 21:25">izi ooththanaas koyenna.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Azallay gallas kumeth</para>
  <para style="q2" vid="PRO 21:26">amottishe pe7ees;</para>
  <para style="q2" vid="PRO 21:26">xilloy gidikko uuzettontta immees.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Iita asa yarshoy harassees;</para>
  <para style="q2" vid="PRO 21:27">iita qofan shiishshizaa gidikko</para>
  <para style="q2" vid="PRO 21:27">ay mala iita gidanee?<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Wordo markkay dhayana;</para>
  <para style="q2" vid="PRO 21:28">gido attiin tumu markkattizay</para>
  <para style="q2" vid="PRO 21:28">minnidi de7ana.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Iita asi bessonttaz xala xalees;</para>
  <para style="q2" vid="PRO 21:29">gido attiin suure asi</para>
  <para style="q2" vid="PRO 21:29">yuushshi qoppees.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Asi ba eran, akeekaninne</para>
  <para style="q2" vid="PRO 21:30">halchchon GODAARA</para>
  <para style="q2" vid="PRO 21:30">eqettanaas dandayenna.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Ola gallassas para giigssees;</para>
  <para style="q2" vid="PRO 21:31">gido attiin xoonoy GODAAPPE yees.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Lo7o sunththi</para>
  <para style="q2" vid="PRO 22:1">daro dureteththafe aadhdhees;</para>
  <para style="q2" vid="PRO 22:1">asa matan bonchcheteththika</para>
  <para style="q2" vid="PRO 22:1">birappenne worqqafe aadhdhees.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Durenne manqo ubbaa</para>
  <para style="q2" vid="PRO 22:2">GODAY medhdhides;</para>
  <para style="q2" vid="PRO 22:2">hessan istta naykka issi gina.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Akeekanchcha asi iita be7idi</para>
  <para style="q2" vid="PRO 22:3">attanaas baqatees;</para>
  <para style="q2" vid="PRO 22:3">gido attiin akeekay paccida asi</para>
  <para style="q2" vid="PRO 22:3">meton gelidi qohettees.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ashketeththinne GODAAS yashshi,</para>
  <para style="q2" vid="PRO 22:4">dureteth, bonchchonne</para>
  <para style="q2" vid="PRO 22:4">de7o immees.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Iita asa ogen agunththinne</para>
  <para style="q2" vid="PRO 22:5">yardey dees;</para>
  <para style="q2" vid="PRO 22:5">gido attiin bana naagiza asi</para>
  <para style="q2" vid="PRO 22:5">hessafe haakkees.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Nayi waanidi de7ana bessizaakko</para>
  <para style="q2" vid="PRO 22:6">tamaarsa;</para>
  <para style="q2" vid="PRO 22:6">histtiko izi cimmidikka</para>
  <para style="q2" vid="PRO 22:6">hessafe haakkenna.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Durey manqo haarees;</para>
  <para style="q2" vid="PRO 22:7">tal7e ekkidaadey tal7e</para>
  <para style="q2" vid="PRO 22:7">immidaades aylle gides.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Iitateth zeriza asi waaye cakkees;</para>
  <para style="q2" vid="PRO 22:8">iza hanqo guufey dhayana.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Kiya asi anjjettees;</para>
  <para style="q2" vid="PRO 22:9">ba qumappeka hiyeesas immees.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Qilcciza as digga;</para>
  <para style="q2" vid="PRO 22:10">histtiko palamay attana;</para>
  <para style="q2" vid="PRO 22:10">ooshshinne cashshika dhayana.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Wozina geeshshateth dosiza asinne</para>
  <para style="q2" vid="PRO 22:11">doonappe lo7o haasayza asara</para>
  <para style="q2" vid="PRO 22:11">kawoy laggetees.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />GODAA ayfeti erateth naagettees;</para>
  <para style="q2" vid="PRO 22:12">gido attiin wordanchchata qaala</para>
  <para style="q2" vid="PRO 22:12">hada kessees.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Azalla asi,</para>
  <para style="q2" vid="PRO 22:13">«Gaammoy karen dees;</para>
  <para style="q2" vid="PRO 22:13">tana ogen wodhana» gees.<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Layma maccassa doonay</para>
  <para style="q2" vid="PRO 22:14">ciimma olla mala;</para>
  <para style="q2" vid="PRO 22:14">GODAY hanqettida asi</para>
  <para style="q2" vid="PRO 22:14">izin wullees.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Naa wozina eeyateththi</para>
  <para style="q2" vid="PRO 22:15">baqqi oykkees;</para>
  <para style="q2" vid="PRO 22:15">gido attiin seera shoch</para>
  <para style="q2" vid="PRO 22:15">izappe haassees.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Baas aqota gujjana giidi</para>
  <para style="q2" vid="PRO 22:16">hiyeesa naaqqizaynne</para>
  <para style="q2" vid="PRO 22:16">duresi imota immizay</para>
  <para style="q2" vid="PRO 22:16">naykka manqana.<verse eid="PRO 22:16" /></para>
  <para style="b" />
  <para style="s1">Aadho Eranchcha Zore Heedzdzu Tammata</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Aadho eranchcha zore</para>
  <para style="q2" vid="PRO 22:17">wozinappe siya;</para>
  <para style="q2" vid="PRO 22:17">ne wozinaykka</para>
  <para style="q2" vid="PRO 22:17">ta timirtekko simmo!<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Ays giikko</para>
  <para style="q2" vid="PRO 22:18">istta ne wozinan woththiko,</para>
  <para style="q2" vid="PRO 22:18">ne doonanka</para>
  <para style="q2" vid="PRO 22:18">istta ubbaa haasaykko</para>
  <para style="q2" vid="PRO 22:18">ne ufayettana.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Ne ammanoy</para>
  <para style="q2" vid="PRO 22:19">GODAAN gidana mala</para>
  <para style="q2" vid="PRO 22:19">tani nena hach tamaarsays.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Tani neessi zorenne</para>
  <para style="q2" vid="PRO 22:20">erateth immiza</para>
  <para style="q2" vid="PRO 22:20">lo7o timirteta xaafabeekkinaa?<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Nena kiittidayssas bessiza</para>
  <para style="q2" vid="PRO 22:21">zaaro zaarana mala,</para>
  <para style="q2" vid="PRO 22:21">tani nena tumanne</para>
  <para style="q2" vid="PRO 22:21">ammanettida qaalata</para>
  <para style="q2" vid="PRO 22:21">tamaarsana mala gidennee?<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Hiyeesatasi aykkoyka baynda</para>
  <para style="q2" vid="PRO 22:22">gishshas istta bonqofa;</para>
  <para style="q2" vid="PRO 22:22">shilotankka metotanchchata</para>
  <para style="q2" vid="PRO 22:22">waayisoppa.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Ays giikko GODAY</para>
  <para style="q2" vid="PRO 22:23">istta gishshas mootettana;</para>
  <para style="q2" vid="PRO 22:23">istta bonqqidaytakka</para>
  <para style="q2" vid="PRO 22:23">izi bonqqana.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Hanqettiza asara laggetoppa;</para>
  <para style="q2" vid="PRO 22:24">hanqettanaas eesotiza</para>
  <para style="q2" vid="PRO 22:24">asarakka zuppetoppa.<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Neni iza hanoza meezetikko,</para>
  <para style="q2" vid="PRO 22:25">guyeppe agganawu dandayakka.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Waase gelanaas caaqqofa;</para>
  <para style="q2" vid="PRO 22:26">asa aco qanxxanaas</para>
  <para style="q2" vid="PRO 22:26">waase geloppa.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Neessi qanxxizaazi dhaykko,</para>
  <para style="q2" vid="PRO 22:27">ne ichchiza algayka</para>
  <para style="q2" vid="PRO 22:27">attontta ekettana.<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Ne aawati essida</para>
  <para style="q2" vid="PRO 22:28">beniisofe diza zawaa shoddofa.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Ba ooson loohida as beyadii?</para>
  <para style="q2" vid="PRO 22:29">Izi kawotas ooththeesippe attiin</para>
  <para style="q2" vid="PRO 22:29">bessontta asatas ooththenna.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Neni dere haarizayssara</para>
  <para style="q2" vid="PRO 23:1">kath maanaas uttida wode,</para>
  <para style="q2" vid="PRO 23:1">ne sinththan de7izayssa</para>
  <para style="q2" vid="PRO 23:1">lo7eththada akeeka.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Neni daro yora as gidikko,</para>
  <para style="q2" vid="PRO 23:2">keehippe naagetta.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Izi nena paaccanaas</para>
  <para style="q2" vid="PRO 23:3">dandayza gishshas,</para>
  <para style="q2" vid="PRO 23:3">shiiqida mal7o qumas yiiqetoppa.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Duretana gaada daaburoppa;</para>
  <para style="q2" vid="PRO 23:4">hayssa mala qofa agganaas</para>
  <para style="q2" vid="PRO 23:4">akeekanchcha gida.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Hessa mala dureteththa bolla</para>
  <para style="q2" vid="PRO 23:5">neni ne ayfe woththiko</para>
  <para style="q2" vid="PRO 23:5">heera dhayana;</para>
  <para style="q2" vid="PRO 23:5">qefe kessida golle kafo mala</para>
  <para style="q2" vid="PRO 23:5">salora paallana.<verse eid="PRO 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Uuze asa kath mooppa;</para>
  <para style="q2" vid="PRO 23:6">mal7iza iza kath</para>
  <para style="q2" vid="PRO 23:6">maanaas amottofa.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Qoodheppe qommon izi nena,</para>
  <para style="q2" vid="PRO 23:7">«Ma; uya» geesippe attiin</para>
  <para style="q2" vid="PRO 23:7">iza wozinay nenara de7enna.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Neni mida guuththa kaththayka</para>
  <para style="q2" vid="PRO 23:8">nena cooshshana;</para>
  <para style="q2" vid="PRO 23:8">ne galataykka hada gidana.<verse eid="PRO 23:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Eeyara haasayoppa;</para>
  <para style="q2" vid="PRO 23:9">ays giikko</para>
  <para style="q2" vid="PRO 23:9">ne aadho era haasaya</para>
  <para style="q2" vid="PRO 23:9">izi kadhana.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Beniisofe diza dhassaa shoddofa.</para>
  <para style="q2" vid="PRO 23:10">Qasse yi7o nayta gade sugoppa;<verse eid="PRO 23:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PRO 23:11" />ays giikko istta</para>
  <para style="q2" vid="PRO 23:11">ashshiza GODAY mino;</para>
  <para style="q2" vid="PRO 23:11">izi istta gishshas nenara mootettana.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Ne wozina zores,</para>
  <para style="q2" vid="PRO 23:12">ne hayththaka erateththa</para>
  <para style="q2" vid="PRO 23:12">qaalaakko zaara.<verse eid="PRO 23:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Ne naa seeranaappe guye gooppa;</para>
  <para style="q2" vid="PRO 23:13">neni qircunchchan shocikko</para>
  <para style="q2" vid="PRO 23:13">izi hayqqenna.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Neni qircunchchan shoca;</para>
  <para style="q2" vid="PRO 23:14">iza shemppo hayqoppe ashsha.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Ta naazoo!</para>
  <para style="q2" vid="PRO 23:15">Ne wozinay aadho</para>
  <para style="q2" vid="PRO 23:15">eranchcha gidikko</para>
  <para style="q2" vid="PRO 23:15">ta wozinaykka ufayettees.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Ne inxarsay suure haasayza wode</para>
  <para style="q2" vid="PRO 23:16">ta wozinay ufayettees.<verse eid="PRO 23:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Nagaranchchata bolla qanaatoppa;</para>
  <para style="q2" vid="PRO 23:17">gido attiin ubbato GODAAS</para>
  <para style="q2" vid="PRO 23:17">yashshateth aggofa.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Histtiko nees sinththafe kiyana;</para>
  <para style="q2" vid="PRO 23:18">ne hidotay hada gidenna.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Ta naazoo! Siya; wozinama gida;</para>
  <para style="q2" vid="PRO 23:19">ne wozinay suure ogeppe</para>
  <para style="q2" vid="PRO 23:19">kare kezoppo.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Daro woyne ushshu uyizaytaranne</para>
  <para style="q2" vid="PRO 23:20">asho muussas</para>
  <para style="q2" vid="PRO 23:20">yaaretizaytara zuppetoppa.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Ays giikko maththottizaytinne</para>
  <para style="q2" vid="PRO 23:21">yorati manqana;</para>
  <para style="q2" vid="PRO 23:21">dhisko daroy carqqa mayzees.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Nena yelida aaway yootizayssa siya;</para>
  <para style="q2" vid="PRO 23:22">ne aayiyakka</para>
  <para style="q2" vid="PRO 23:22">ceeggida wode kadhoppa.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Tumaa shammafe attiin</para>
  <para style="q2" vid="PRO 23:23">mulekka bayzoppa;</para>
  <para style="q2" vid="PRO 23:23">aadho erateth, seeranne</para>
  <para style="q2" vid="PRO 23:23">akeeka nees miishshe ooththa.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Xillo naa aaway</para>
  <para style="q2" vid="PRO 23:24">keehippe ufayettees;</para>
  <para style="q2" vid="PRO 23:24">wozinama naa yelida asikka</para>
  <para style="q2" vid="PRO 23:24">izan ufayettees.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Ne aawaynne ne aaya ufayettetto;</para>
  <para style="q2" vid="PRO 23:25">nena yelidaarakka ufayettu.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Ta naazoo!</para>
  <para style="q2" vid="PRO 23:26">Ne wozina ha taakko zaara;</para>
  <para style="q2" vid="PRO 23:26">ne ayfeti ta ogeppe</para>
  <para style="q2" vid="PRO 23:26">kare kezoppetto.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Ays giikko layma maccassaya</para>
  <para style="q2" vid="PRO 23:27">ciimma olla mala;</para>
  <para style="q2" vid="PRO 23:27">laggeththo machcha</para>
  <para style="q2" vid="PRO 23:27">xunththa olla mala.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Iza panga mala zamada naagawus;</para>
  <para style="q2" vid="PRO 23:28">ammanettontta addeta</para>
  <para style="q2" vid="PRO 23:28">dere giddon darsawus.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />«Woo!» giza waasoy oossee?</para>
  <para style="q2" vid="PRO 23:29">Ceecey oossee? Ooshshi oossee?</para>
  <para style="q2" vid="PRO 23:29">Zuuzunththi oossee?</para>
  <para style="q2" vid="PRO 23:29">Gaasoykka baynda</para>
  <para style="q2" vid="PRO 23:29">madunththi oossee?</para>
  <para style="q2" vid="PRO 23:29">Ayfey zo7izay oossee?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Woyne ushshu uyishe</para>
  <para style="q2" vid="PRO 23:30">gam7izaytas gidennee?</para>
  <para style="q2" vid="PRO 23:30">Walakettida woyne ushshu</para>
  <para style="q2" vid="PRO 23:30">yuuyi yuuyi</para>
  <para style="q2" vid="PRO 23:30">ganxizaytas gidennee?<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Woyne ushshi zo7ida wode,</para>
  <para style="q2" vid="PRO 23:31">iza medhay birille giddon</para>
  <para style="q2" vid="PRO 23:31">phoolliza wode,</para>
  <para style="q2" vid="PRO 23:31">duuqqishin cororu gi geliza wode</para>
  <para style="q2" vid="PRO 23:31">iza tishshi histta xeellofa.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Wurseththan izi</para>
  <para style="q2" vid="PRO 23:32">shooshsha mala dukkees;</para>
  <para style="q2" vid="PRO 23:32">goppe shooshsha malakka</para>
  <para style="q2" vid="PRO 23:32">ba yiishsha puukkees.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ne ayfey beyi eronttaaz beyana;</para>
  <para style="q2" vid="PRO 23:33">ne wozinaykka elumettana.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Neni abbaa giddon diza</para>
  <para style="q2" vid="PRO 23:34">markabe xeeran</para>
  <para style="q2" vid="PRO 23:34">ichchida asa mala gidana.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Neni, «Istti tana dechchida;</para>
  <para style="q2" vid="PRO 23:35">gido attiin tani qohettabeekke;</para>
  <para style="q2" vid="PRO 23:35">istti tana wadhdhida;</para>
  <para style="q2" vid="PRO 23:35">gido attiin taas erettibeenna.</para>
  <para style="q2" vid="PRO 23:35">Hara ushsha uyanaas</para>
  <para style="q2" vid="PRO 23:35">tani awude</para>
  <para style="q2" vid="PRO 23:35">dendandinaashaa?» gaana.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Ta naazoo! Iita asata mala</para>
  <para style="q2" vid="PRO 24:1">gidarkina gooppa;</para>
  <para style="q2" vid="PRO 24:1">Isttara laggeteththika</para>
  <para style="q2" vid="PRO 24:1">nena lo7oppo.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Istti ubbato makkalla</para>
  <para style="q2" vid="PRO 24:2">miish maqetteettes;</para>
  <para style="q2" vid="PRO 24:2">bantta inxarsankka</para>
  <para style="q2" vid="PRO 24:2">gene haasayeettes.<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Keeththi aadho erateththan</para>
  <para style="q2" vid="PRO 24:3">keexettees;</para>
  <para style="q2" vid="PRO 24:3">akeekankka minnees.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Eray de7ikko,</para>
  <para style="q2" vid="PRO 24:4">keeththi al7oninne</para>
  <para style="q2" vid="PRO 24:4">lo7o miishshan kumees.<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Wozinama asas gita wolqqay dees;</para>
  <para style="q2" vid="PRO 24:5">eranchcha asikka</para>
  <para style="q2" vid="PRO 24:5">minoteth gujjees.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Ola olettanaas nees lo7o zore</para>
  <para style="q2" vid="PRO 24:6">xoono demmanaaskka</para>
  <para style="q2" vid="PRO 24:6">daro zoranchchata koshshees.<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Eeya asi aadho erateththafe</para>
  <para style="q2" vid="PRO 24:7">keehi haahon dees;</para>
  <para style="q2" vid="PRO 24:7">duulata sinththan eqqidi</para>
  <para style="q2" vid="PRO 24:7">haasayana dandayenna.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Iita ooththanaas halchchiza asi</para>
  <para style="q2" vid="PRO 24:8">«Genanchcha» geetettees.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Eeyateththa qofay nagara;</para>
  <para style="q2" vid="PRO 24:9">qilccizaade asi ixxees.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Neni meto gallas laafikko,</para>
  <para style="q2" vid="PRO 24:10">ne wolqqay ay mala guuththee?<verse eid="PRO 24:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Hayqos laagetti bizayta ashsha;</para>
  <para style="q2" vid="PRO 24:11">shukettanaas gooshetti</para>
  <para style="q2" vid="PRO 24:11">bizayta ashsha.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Neni, «Ta hayssa erikke» giikko,</para>
  <para style="q2" vid="PRO 24:12">wozina pilggi erizayssi</para>
  <para style="q2" vid="PRO 24:12">izi akeekennee?</para>
  <para style="q2" vid="PRO 24:12">Ne shemppo naagizayssi erennee?</para>
  <para style="q2" vid="PRO 24:12">As ubbaas iza</para>
  <para style="q2" vid="PRO 24:12">ooso ooso mala immennee?<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Ta naazoo!</para>
  <para style="q2" vid="PRO 24:13">Lo7o gidida gishshas eessa ma;</para>
  <para style="q2" vid="PRO 24:13">ililo eessi doonan mal7ees.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Aadho erateththika hessa mala;</para>
  <para style="q2" vid="PRO 24:14">izi ne shemppos</para>
  <para style="q2" vid="PRO 24:14">mal7o gididayssa era.</para>
  <para style="q2" vid="PRO 24:14">Neni izo demmizaa gidikko</para>
  <para style="q2" vid="PRO 24:14">wonto nees zemppo gidana;</para>
  <para style="q2" vid="PRO 24:14">ne hidotaykka hada gidenna.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Xillo asa keeth bonqqanaas</para>
  <para style="q2" vid="PRO 24:15">panga mala zamadoppa;</para>
  <para style="q2" vid="PRO 24:15">iza keeththa bolla meto gaththofa.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Xillo asi</para>
  <para style="q2" vid="PRO 24:16">laappunto kundikokka dendees;</para>
  <para style="q2" vid="PRO 24:16">gido attiin iitati</para>
  <para style="q2" vid="PRO 24:16">meton dhayeettes.<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Ne morkkey</para>
  <para style="q2" vid="PRO 24:17">kundiza wode ufayettofa;</para>
  <para style="q2" vid="PRO 24:17">izi dhuphettiza wodekka</para>
  <para style="q2" vid="PRO 24:17">ne wozinan, «Hashshu!» gooppa.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Ne histtontta aggiko</para>
  <para style="q2" vid="PRO 24:18">GODAY hessa be7idi ufayettenna;</para>
  <para style="q2" vid="PRO 24:18">izi ba hanqoza</para>
  <para style="q2" vid="PRO 24:18">ne morkkeza bollafe zaarana.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Iita asata ooson ceecoppa;</para>
  <para style="q2" vid="PRO 24:19">istta mala gidarkina gooppa.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Iita asas hidotay baawa;</para>
  <para style="q2" vid="PRO 24:20">iitata xomppey tippi giidi to7ana.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Ta naazoo! GODAASSINNE</para>
  <para style="q2" vid="PRO 24:21">kawaas yayya;</para>
  <para style="q2" vid="PRO 24:21">makkallizaytarakka zuppetoppa.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Ays giikko hessa mala asata</para>
  <para style="q2" vid="PRO 24:22">qoppontta metoy gakkees;</para>
  <para style="q2" vid="PRO 24:22">kawoppenne GODAAPPE yaana</para>
  <para style="q2" vid="PRO 24:22">meto oonee erizay?<verse eid="PRO 24:22" /></para>
  <para style="s1">Aadho Eranchchay Gujji Yootida Hara Leemisota</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Aadho eranchchati</para>
  <para style="q2" vid="PRO 24:23">gujjidikka hayssaththo gida;</para>
  <para style="q1" vid="PRO 24:23">Pirdishe maado pirday</para>
  <para style="q2" vid="PRO 24:23">lo7o gidenna.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Mooranchcha, «Neni xillo» gizaade</para>
  <para style="q2" vid="PRO 24:24">derey qanggees;</para>
  <para style="q2" vid="PRO 24:24">kawoteththatikka iza hileettes.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Gido attiin Mooranchcha,</para>
  <para style="q2" vid="PRO 24:25">«Neni mooradasa» gizayta</para>
  <para style="q2" vid="PRO 24:25">isttara lo7o miishshi gayttana;</para>
  <para style="q2" vid="PRO 24:25">isttas keehi daro anjjoy yaana.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Suure zaaro imoy</para>
  <para style="q2" vid="PRO 24:26">doona yeereteththa mala.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Kasetada ne karen diza</para>
  <para style="q2" vid="PRO 24:27">ooso ooththa;</para>
  <para style="q2" vid="PRO 24:27">ne goshsha giigsa;</para>
  <para style="q2" vid="PRO 24:27">hessafe guye ne keeth keexxa.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Ne shooroza bolla</para>
  <para style="q2" vid="PRO 24:28">gaasoy baynda markkattofa;</para>
  <para style="q2" vid="PRO 24:28">ne doonanka cimmofa.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Izi taas ooththida mala</para>
  <para style="q2" vid="PRO 24:29">tani izas ooththana;</para>
  <para style="q2" vid="PRO 24:29">«Tani izas iza ooso</para>
  <para style="q2" vid="PRO 24:29">kushe zaarana» gooppa.<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Tani azalla asa gadera aadhdhadis;</para>
  <para style="q2" vid="PRO 24:30">akeekay paccida asa</para>
  <para style="q2" vid="PRO 24:30">woyne tura giddora kanththadis.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Ubbason agunththi mokkides;</para>
  <para style="q2" vid="PRO 24:31">gadaa sharafay goozides;</para>
  <para style="q2" vid="PRO 24:31">gimbeyka laalettides.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Tani be7idayssa yuushsha qoppadis;</para>
  <para style="q2" vid="PRO 24:32">tani beyooysafe</para>
  <para style="q2" vid="PRO 24:32">timirte demmadis.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Neni, «Guuththara liphiphi gays;</para>
  <para style="q2" vid="PRO 24:33">guuththara dhiska ekkays;</para>
  <para style="q2" vid="PRO 24:33">ne kushezakka shiishshada</para>
  <para style="q2" vid="PRO 24:33">guuththara shempa</para>
  <para style="q2" vid="PRO 24:33">ekkays» giikko,<verse eid="PRO 24:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="PRO 24:34" />manqoteththi ne bolla</para>
  <para style="q2" vid="PRO 24:34">panga mala yaana;</para>
  <para style="q2" vid="PRO 24:34">paceykka ola miishsha</para>
  <para style="q2" vid="PRO 24:34">oykkida asa mala puttu gaana.<note caller="-" style="x"><char style="xo" closed="false">24:33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">Leemi 6:10-11</ref></char></note><verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Solomooney Xaafida Hara Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Yuhuda Kawo Hizqiyaasa asati duuqqidi xaafida Solomoone leemisoti hayssafe kaallizayta.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Xuura genththoy Xoossas bonchcho;</para>
  <para style="q2" vid="PRO 25:2">xuura pilggidi kesoy</para>
  <para style="q2" vid="PRO 25:2">kawotas bonchcho.<verse eid="PRO 25:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Salota dhoqqateththanne</para>
  <para style="q2" vid="PRO 25:3">sa7a ciimmateththa</para>
  <para style="q2" vid="PRO 25:3">asi gakkonttayssa mala,</para>
  <para style="q2" vid="PRO 25:3">kawota qofaakka asi pilggi</para>
  <para style="q2" vid="PRO 25:3">eranaas dandayenna.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Birappe qita diggaycha;</para>
  <para style="q2" vid="PRO 25:4">wogaceykka qoxxidi</para>
  <para style="q2" vid="PRO 25:4">lo7o miish kessana.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Kawo sinththafe iitata diggaycha;</para>
  <para style="q2" vid="PRO 25:5">histtiko iza kawoteththa araatay</para>
  <para style="q2" vid="PRO 25:5">xilloteththan minni eqqana.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Kawo sinththan nena</para>
  <para style="q2" vid="PRO 25:6">dhoqqu dhoqqu histtofa;</para>
  <para style="q2" vid="PRO 25:6">gita asata giddon</para>
  <para style="q2" vid="PRO 25:6">beettanaas amottofa.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Gita asa sinththan</para>
  <para style="q2" vid="PRO 25:7">nena kawushshanaappe</para>
  <para style="q2" vid="PRO 25:7">izi barkka nena,</para>
  <para style="q2" vid="PRO 25:7">«Haysso dhoqqu ga»</para>
  <para style="q2" vid="PRO 25:7">giikko nees lo7o.<note caller="-" style="x"><char style="xo" closed="false">25:6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">Luqa 14:8-10</ref></char></note><verse eid="PRO 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Ne ayfezan be7ida ubbaa</para>
  <para style="q2" vid="PRO 25:8">markkattanaas dubbusha</para>
  <para style="q2" vid="PRO 25:8">baanaas eesotoppa;</para>
  <para style="q2" vid="PRO 25:8">ays giikko</para>
  <para style="q2" vid="PRO 25:8">neni markkatta simmiin,</para>
  <para style="q2" vid="PRO 25:8">hara asi ne markkateththay</para>
  <para style="q2" vid="PRO 25:8">bala gididayssa qonccisikko</para>
  <para style="q2" vid="PRO 25:8">neni yeellatana.<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Neessinne ne laggezas giddon</para>
  <para style="q2" vid="PRO 25:9">palamay medhettiko,</para>
  <para style="q2" vid="PRO 25:9">he palama garsan</para>
  <para style="q2" vid="PRO 25:9">hara asa xuura qonccisoppa.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Histtontta aggiko</para>
  <para style="q2" vid="PRO 25:10">neni yootizayssa siyida asi</para>
  <para style="q2" vid="PRO 25:10">nena kawushshana;</para>
  <para style="q2" vid="PRO 25:10">hessan ne sunththay</para>
  <para style="q2" vid="PRO 25:10">nam7anththo simmidi</para>
  <para style="q2" vid="PRO 25:10">lo7ontta mala moorettana.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Koshshiza wodezan</para>
  <para style="q2" vid="PRO 25:11">haasayettida likke</para>
  <para style="q2" vid="PRO 25:11">qaalay bira bolla tigettida</para>
  <para style="q2" vid="PRO 25:11">worqqa alleqo mala.<verse eid="PRO 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Aadho erateththi diza asi</para>
  <para style="q2" vid="PRO 25:12">zoriza zorey ezgiza asas</para>
  <para style="q2" vid="PRO 25:12">hayththan aaththiza worqqa mala;</para>
  <para style="q2" vid="PRO 25:12">woykko muuruta worqqafe</para>
  <para style="q2" vid="PRO 25:12">oosettida alleqo mala.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Kath shiishshiza wode irxxa haaththi</para>
  <para style="q2" vid="PRO 25:13">uyiin aliza mala;</para>
  <para style="q2" vid="PRO 25:13">ammanettiza kiitanchchay</para>
  <para style="q2" vid="PRO 25:13">bana kiittizayta ufayssees.<verse eid="PRO 25:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Immonttayssa, «Immana» giidi</para>
  <para style="q2" vid="PRO 25:14">coo paapottiza asi</para>
  <para style="q2" vid="PRO 25:14">iray baynda shaaranne carko mala.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Dandayanchcha asi</para>
  <para style="q2" vid="PRO 25:15">dere haarizaade</para>
  <para style="q2" vid="PRO 25:15">yooti mayzees;</para>
  <para style="q2" vid="PRO 25:15">liiqo qaalay</para>
  <para style="q2" vid="PRO 25:15">meqeth kanththi gelees.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Ees demmiko ginara ma;</para>
  <para style="q2" vid="PRO 25:16">gido attiin darssiko</para>
  <para style="q2" vid="PRO 25:16">nena xuuggana.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Nena uufidi ixxontta mala</para>
  <para style="q2" vid="PRO 25:17">ne lagge soo ubbato booppa.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ba laggeza bolla wordora</para>
  <para style="q2" vid="PRO 25:18">markkattiza asi koxey,</para>
  <para style="q2" vid="PRO 25:18">giththa mashshaynne wondafey</para>
  <para style="q2" vid="PRO 25:18">as qohiza mala qohees.<verse eid="PRO 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Metto wode ammanettontta</para>
  <para style="q2" vid="PRO 25:19">asan zemppoy,</para>
  <para style="q2" vid="PRO 25:19">qaaxxiza achchan</para>
  <para style="q2" vid="PRO 25:19">coommiza malanne</para>
  <para style="q2" vid="PRO 25:19">silida tohon hemettiza mala.<verse eid="PRO 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Ceeci uttida asas mazamure yexeththi</para>
  <para style="q2" vid="PRO 25:20">meego gallas</para>
  <para style="q2" vid="PRO 25:20">may7o qaariza malanne</para>
  <para style="q2" vid="PRO 25:20">madunththa bolla xuuggiza miish</para>
  <para style="q2" vid="PRO 25:20">tigiza mala.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Ne morkkey gafikko miza;</para>
  <para style="q2" vid="PRO 25:21">saamettiko ushsha.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Neni hessaththo ooththiko</para>
  <para style="q2" vid="PRO 25:22">iza hu7en tama bonqo kaashidi</para>
  <para style="q2" vid="PRO 25:22">qolizaade mala.</para>
  <para style="q2" vid="PRO 25:22">GODAYKKA ne oosos</para>
  <para style="q2" vid="PRO 25:22">waaga immana.<note caller="-" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">Oro 12:20</ref></char></note><verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Arshey mokkiza bagga carkoy</para>
  <para style="q2" vid="PRO 25:23">ira ehiza mala,</para>
  <para style="q2" vid="PRO 25:23">zigirsi hanqo ehees.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Duunama machchira</para>
  <para style="q2" vid="PRO 25:24">issi keeththan de7anaappe</para>
  <para style="q2" vid="PRO 25:24">keeththa daaranchchan</para>
  <para style="q2" vid="PRO 25:24">deeththi lo7o.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Daaburda asi irxxa haath</para>
  <para style="q2" vid="PRO 25:25">uyidi aliza mala</para>
  <para style="q2" vid="PRO 25:25">haakko biittafe yiza</para>
  <para style="q2" vid="PRO 25:25">lo7o qaalay ufayssees.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Iita asa sinththan</para>
  <para style="q2" vid="PRO 25:26">kundiza xillo asi</para>
  <para style="q2" vid="PRO 25:26">bulqottida pulttonne</para>
  <para style="q2" vid="PRO 25:26">moorettida olla haaththa mala.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Daro eessa muusi lo7o gidenna;</para>
  <para style="q2" vid="PRO 25:27">hessaththoka baas bonchcho</para>
  <para style="q2" vid="PRO 25:27">koshshi bonchchisenna.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Bana haarontta asi</para>
  <para style="q2" vid="PRO 25:28">gimbey laalettida katama mala.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Bonen shach, kath shiishshiza wodenkka</para>
  <para style="q2" vid="PRO 26:1">iray koshshonttayssa mala,</para>
  <para style="q2" vid="PRO 26:1">eeyas bonchchoy koshshenna.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Kafoti yaanne haa paallishe</para>
  <para style="q2" vid="PRO 26:2">as qohonttayssa mala,</para>
  <para style="q2" vid="PRO 26:2">gaasoykka baynda</para>
  <para style="q2" vid="PRO 26:2">qanggiza qanggeththi</para>
  <para style="q2" vid="PRO 26:2">as gakkenna.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Parasi lisso,</para>
  <para style="q2" vid="PRO 26:3">hares ancafa koshshizayssa mala,</para>
  <para style="q2" vid="PRO 26:3">eeya zokkozas durqqa koshshees.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Eeya asas</para>
  <para style="q2" vid="PRO 26:4">iza eeyateththa mala zaaroppa;</para>
  <para style="q2" vid="PRO 26:4">zaarikko nenikka</para>
  <para style="q2" vid="PRO 26:4">iza mala gidana.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Gidikkoka eeyas</para>
  <para style="q2" vid="PRO 26:5">iza eeyateththaa bessa;</para>
  <para style="q2" vid="PRO 26:5">histtontta aggiko izi bana</para>
  <para style="q2" vid="PRO 26:5">eranchcha mala qoodana.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Eeya asa bolla kiita yedoy</para>
  <para style="q2" vid="PRO 26:6">barkka ba tohota</para>
  <para style="q2" vid="PRO 26:6">qanxxizayssa mala;</para>
  <para style="q2" vid="PRO 26:6">woykko wodhiza</para>
  <para style="q2" vid="PRO 26:6">marze ushsha mala.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Eeya asa leemisoy</para>
  <para style="q2" vid="PRO 26:7">silida toho mala.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Eeya asas bonchcho imoy</para>
  <para style="q2" vid="PRO 26:8">yanbarsha bolla</para>
  <para style="q2" vid="PRO 26:8">qachchi woththidi</para>
  <para style="q2" vid="PRO 26:8">yuushshiza shuchcha mala.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Eeya asa leemisoy</para>
  <para style="q2" vid="PRO 26:9">maththottida asa kushen eqqida</para>
  <para style="q2" vid="PRO 26:9">agunththa mala.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Eeya as woykko</para>
  <para style="q2" vid="PRO 26:10">baas ogera kanththi biza as</para>
  <para style="q2" vid="PRO 26:10">oosos qaxariza asi</para>
  <para style="q2" vid="PRO 26:10">ba wondafen coo demmida as</para>
  <para style="q2" vid="PRO 26:10">dukki madunththiza asa mala.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Kanay ba cooshshi</para>
  <para style="q2" vid="PRO 26:11">simmi laacciza mala,</para>
  <para style="q2" vid="PRO 26:11">eeyay ba eeyateththa ooso</para>
  <para style="q2" vid="PRO 26:11">zaari zaari yeggees.<verse eid="PRO 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Barkka bana,</para>
  <para style="q2" vid="PRO 26:12">«Tani aadho eranchcha»</para>
  <para style="q2" vid="PRO 26:12">giza as beyadii?</para>
  <para style="q2" vid="PRO 26:12">Izappe eeya asas</para>
  <para style="q2" vid="PRO 26:12">lo7o qaaday dees.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Azallay, «Ogen gaammoy dees;</para>
  <para style="q2" vid="PRO 26:13">yashshiza gaammoy</para>
  <para style="q2" vid="PRO 26:13">wogga ogen yuuyees» gees.<verse eid="PRO 26:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Pengey ba maaxafa bollan</para>
  <para style="q2" vid="PRO 26:14">yaanne haa qaaxxiza mala</para>
  <para style="q2" vid="PRO 26:14">azallaykka ba hiixan yaanne haa</para>
  <para style="q2" vid="PRO 26:14">shiretti shiretti wodhdhees.<verse eid="PRO 26:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Azallay ba kushe maaddan yeddees;</para>
  <para style="q2" vid="PRO 26:15">gido attiin pude ba doonan</para>
  <para style="q2" vid="PRO 26:15">zaaranaas waayettees.<verse eid="PRO 26:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Azalla asi akeekan yootiza</para>
  <para style="q2" vid="PRO 26:16">laappun eranchchatappe</para>
  <para style="q2" vid="PRO 26:16">bana aadho eranchcha</para>
  <para style="q2" vid="PRO 26:16">giidi qoppees.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Bana gaththontta asa yo7on</para>
  <para style="q2" vid="PRO 26:17">guppi geliza asi</para>
  <para style="q2" vid="PRO 26:17">kana hayth oykkiza asa mala.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Gooyiza asi tamaa xiifa oliza mala</para>
  <para style="q2" vid="PRO 26:18">woykko wondafe dukkiza mala;<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />«Tani kaassas ooththadis» gishe</para>
  <para style="q2" vid="PRO 26:19">ba laggeza cimmiza asikka</para>
  <para style="q2" vid="PRO 26:19">hessa mala.<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Miththi wurikko tamay to7ees;</para>
  <para style="q2" vid="PRO 26:20">zigirssi dhaykko ooshshi attees.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Xiixinththi bonqo</para>
  <para style="q2" vid="PRO 26:21">darssizayssa malanne</para>
  <para style="q2" vid="PRO 26:21">miththi tamaa darssizayssa mala,</para>
  <para style="q2" vid="PRO 26:21">doonama asi oosh darssees.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Zigirsanchcha qaalay</para>
  <para style="q2" vid="PRO 26:22">mal7o qumaa mala</para>
  <para style="q2" vid="PRO 26:22">asas duge marace gakkees.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Wozinan iita miishshi dishin,</para>
  <para style="q2" vid="PRO 26:23">ba inxarsan liiqo qaala</para>
  <para style="q2" vid="PRO 26:23">haasayza asi</para>
  <para style="q2" vid="PRO 26:23">biran meeshettida</para>
  <para style="q2" vid="PRO 26:23">mana miishsha mala.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Gene asi ba doonan cimees;</para>
  <para style="q2" vid="PRO 26:24">gido attiin ba wozinan</para>
  <para style="q2" vid="PRO 26:24">iitateth xunttees.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Iza wozinan laappun tunateththi</para>
  <para style="q2" vid="PRO 26:25">kumi uttides;</para>
  <para style="q2" vid="PRO 26:25">hessa gishshas izi</para>
  <para style="q2" vid="PRO 26:25">lo7o qaala haasaykkoka</para>
  <para style="q2" vid="PRO 26:25">ammanoppa.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Izi ba gene baleththon</para>
  <para style="q2" vid="PRO 26:26">genththanaas dandayees;</para>
  <para style="q2" vid="PRO 26:26">gido attiin izi ooththida</para>
  <para style="q2" vid="PRO 26:26">iitateththi duulatan qonccana.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Haratas olla bookkiza asi</para>
  <para style="q2" vid="PRO 26:27">he ollan baas kundana;</para>
  <para style="q2" vid="PRO 26:27">harata bolla shuch</para>
  <para style="q2" vid="PRO 26:27">bululiza asa bolla</para>
  <para style="q2" vid="PRO 26:27">he shuchchay simmi</para>
  <para style="q2" vid="PRO 26:27">iza bolla kundana.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Wordotiza inxarsi</para>
  <para style="q2" vid="PRO 26:28">ba qohida asata ixxawus;</para>
  <para style="q2" vid="PRO 26:28">cimmiza metershika bash ehawus.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Wontoyssan ceeqettofa;</para>
  <para style="q2" vid="PRO 27:1">wonto aazi hananaakko</para>
  <para style="q2" vid="PRO 27:1">ne erakka.<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Yaaqo 4:13-16</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Nena hara asi galatoppe attiin</para>
  <para style="q2" vid="PRO 27:2">nerkka nena galatoppa;</para>
  <para style="q2" vid="PRO 27:2">hara asi nena sabbofe attiin</para>
  <para style="q2" vid="PRO 27:2">neni nerkka nena sabbofa.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Shuchchi deexo;</para>
  <para style="q2" vid="PRO 27:3">anccoy tooko;</para>
  <para style="q2" vid="PRO 27:3">gido attiin eeya asi</para>
  <para style="q2" vid="PRO 27:3">denththiza ooshshi</para>
  <para style="q2" vid="PRO 27:3">nam7atappeka deexxees.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Sheney menxe iita;</para>
  <para style="q2" vid="PRO 27:4">hanqoy menxe iita;</para>
  <para style="q2" vid="PRO 27:4">qanaate sinththan eqqi</para>
  <para style="q2" vid="PRO 27:4">dandayanay oonee?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Geemmida siiqoppe</para>
  <para style="q2" vid="PRO 27:5">qonccen seeriza seeray lo7o.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Morkkey nena daroto yeeranaappe</para>
  <para style="q2" vid="PRO 27:6">siiqoy nena dechchizayssi kiya.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Kallida as eessa ililoy iitees;</para>
  <para style="q2" vid="PRO 27:7">gido attiin gafida as</para>
  <para style="q2" vid="PRO 27:7">gara mala cammiza</para>
  <para style="q2" vid="PRO 27:7">miishshika mal7ees.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Ba soo aggidi yuuyiza asi,</para>
  <para style="q2" vid="PRO 27:8">ba keeththafe haakka paalliza</para>
  <para style="q2" vid="PRO 27:8">kafo mala.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Shittoynne exaaney</para>
  <para style="q2" vid="PRO 27:9">as ufayssizayssa mala,</para>
  <para style="q2" vid="PRO 27:9">siiqo lagge zoreykka ufayssees.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ne laggenne ne aawa lagge aggofa;</para>
  <para style="q2" vid="PRO 27:10">nena metoy gakkiza wode</para>
  <para style="q2" vid="PRO 27:10">ne ishaakko booppa.</para>
  <para style="q2" vid="PRO 27:10">Haahon diza ishappe</para>
  <para style="q2" vid="PRO 27:10">nees matan diza</para>
  <para style="q2" vid="PRO 27:10">shooroy kiya.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Ta naazoo!</para>
  <para style="q2" vid="PRO 27:11">Neni aadho eranchcha gida;</para>
  <para style="q2" vid="PRO 27:11">ta wozina ufayssa;</para>
  <para style="q2" vid="PRO 27:11">histtiko tana kadhizayta</para>
  <para style="q2" vid="PRO 27:11">oyshakka zaarana.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Cincca asi metoy yiza wode</para>
  <para style="q2" vid="PRO 27:12">be7idi qotettees;</para>
  <para style="q2" vid="PRO 27:12">gido attiin akeekay paccida asi</para>
  <para style="q2" vid="PRO 27:12">meto gars bi gelees;</para>
  <para style="q2" vid="PRO 27:12">histtidi guyeppe qohettees.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Erontta asas hurbuta geliza</para>
  <para style="q2" vid="PRO 27:13">asa may7o qaara ekka;</para>
  <para style="q2" vid="PRO 27:13">hawusha maccassas waase geliza</para>
  <para style="q2" vid="PRO 27:13">asa may7o oykka.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Maalado wonttara</para>
  <para style="q2" vid="PRO 27:14">ba qaala dhoqqu histtidi</para>
  <para style="q2" vid="PRO 27:14">ba shooro anjjoy</para>
  <para style="q2" vid="PRO 27:14">qanggeththa mala qoodettees.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Ubbaa wode oosh ooyettiza machcha</para>
  <para style="q2" vid="PRO 27:15">ira gallas pacey baynda</para>
  <para style="q2" vid="PRO 27:15">aaththiza keeththa mala.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Carko teqqanaas woykko</para>
  <para style="q2" vid="PRO 27:16">zayte cucumidi oykkanaas</para>
  <para style="q2" vid="PRO 27:16">dandayettonttayssa mala</para>
  <para style="q2" vid="PRO 27:16">izo co7u ooththanaas</para>
  <para style="q2" vid="PRO 27:16">dandayettenna.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Biratay birata qarasiza mala</para>
  <para style="q2" vid="PRO 27:17">asikka issoy issaa qarasees.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Balase miththayo</para>
  <para style="q2" vid="PRO 27:18">ishalsidi naagida asi</para>
  <para style="q2" vid="PRO 27:18">izi ayfe maana;</para>
  <para style="q2" vid="PRO 27:18">ba godaas ooththiza</para>
  <para style="q2" vid="PRO 27:18">asi bonchchettana.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Haaththay heregaththo</para>
  <para style="q2" vid="PRO 27:19">sinth bessiza mala</para>
  <para style="q2" vid="PRO 27:19">asa wozinay</para>
  <para style="q2" vid="PRO 27:19">izaade kando bessees.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Hayqoynne Bashshi kalli erettenna;</para>
  <para style="q2" vid="PRO 27:20">hessaththoka asa ayfey kallenna.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Biraynne worqqay taman paacettidi</para>
  <para style="q2" vid="PRO 27:21">geeyza mala</para>
  <para style="q2" vid="PRO 27:21">asikka ba ekkiza</para>
  <para style="q2" vid="PRO 27:21">galatan paacettees.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Eeya as kaththa mala</para>
  <para style="q2" vid="PRO 27:22">udulan yeggada,</para>
  <para style="q2" vid="PRO 27:22">udula miththan caddizaakkoka</para>
  <para style="q2" vid="PRO 27:22">izappe eeyateththi kichchenna.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Ne dorsati de7iza hanota</para>
  <para style="q2" vid="PRO 27:23">lo7eththada era;</para>
  <para style="q2" vid="PRO 27:23">ne wudekka wozinappe heemma.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Ays giikko</para>
  <para style="q2" vid="PRO 27:24">dureteththi mernaas de7enna;</para>
  <para style="q2" vid="PRO 27:24">kallachchayka yeletappe</para>
  <para style="q2" vid="PRO 27:24">yeleta gakkanaas</para>
  <para style="q2" vid="PRO 27:24">minni de7enna.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Mela maatay buucettidaappe,</para>
  <para style="q2" vid="PRO 27:25">aaca maatay ke7idaappe,</para>
  <para style="q2" vid="PRO 27:25">zumbullata bollan de7iza maatay</para>
  <para style="q2" vid="PRO 27:25">shiiqidaappe guyen,<verse eid="PRO 27:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 27:26" />dorsata iskefe</para>
  <para style="q2" vid="PRO 27:26">neni nees</para>
  <para style="q2" vid="PRO 27:26">may7o kessana;</para>
  <para style="q2" vid="PRO 27:26">deyshatan nees</para>
  <para style="q2" vid="PRO 27:26">goshsha gade shammana.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Attida deyshata maaththi</para>
  <para style="q2" vid="PRO 27:27">neessinne ne soo asas,</para>
  <para style="q2" vid="PRO 27:27">ne macca aylletaskka</para>
  <para style="q2" vid="PRO 27:27">quma gidanaas</para>
  <para style="q2" vid="PRO 27:27">kumi palahana.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Iita asi oonikka</para>
  <para style="q2" vid="PRO 28:1">yedeththontta baqatees;</para>
  <para style="q2" vid="PRO 28:1">gido attiin xilloy</para>
  <para style="q2" vid="PRO 28:1">gaammo mala wozina kumeththa.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Derey makkalliko</para>
  <para style="q2" vid="PRO 28:2">haarizay corattees;</para>
  <para style="q2" vid="PRO 28:2">Gido attiin era asinne</para>
  <para style="q2" vid="PRO 28:2">akeekiza asi woga essees.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Hiyeesata un7eththiza daannay</para>
  <para style="q2" vid="PRO 28:3">kath dhayssiza</para>
  <para style="q2" vid="PRO 28:3">wolqqama ira mala.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Woga bonchchontta asi</para>
  <para style="q2" vid="PRO 28:4">mooranchchata sabbees;</para>
  <para style="q2" vid="PRO 28:4">gido attiin wogaa bonchchizay</para>
  <para style="q2" vid="PRO 28:4">istta qofa palqqees.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Iita asatas suure pirday gelenna;</para>
  <para style="q2" vid="PRO 28:5">gido attiin GODAAS goynnizayti</para>
  <para style="q2" vid="PRO 28:5">ubbaaka ereettes.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Geella as gidi uttidi</para>
  <para style="q2" vid="PRO 28:6">dure gidanaappe</para>
  <para style="q2" vid="PRO 28:6">borey baynda hiyeesa</para>
  <para style="q2" vid="PRO 28:6">gideththi lo7o.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Wogaa naagiza nay akeekanchcha;</para>
  <para style="q2" vid="PRO 28:7">gido attiin</para>
  <para style="q2" vid="PRO 28:7">ganjamatara zuppetizay</para>
  <para style="q2" vid="PRO 28:7">ba aawa yeellasees.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Bessontta dishon</para>
  <para style="q2" vid="PRO 28:8">ba aqota dagasiza asi</para>
  <para style="q2" vid="PRO 28:8">he aqota hiyeesas</para>
  <para style="q2" vid="PRO 28:8">kiyiza asas shiishshees.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Wogaa siyanaappe ba hayth</para>
  <para style="q2" vid="PRO 28:9">wora zaariza asa woosay</para>
  <para style="q2" vid="PRO 28:9">Xoossa harassees.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Suureta iita oge kaaleththiza asi</para>
  <para style="q2" vid="PRO 28:10">ba bookkida ollan kundana;</para>
  <para style="q2" vid="PRO 28:10">gido attiin geeshsha asi</para>
  <para style="q2" vid="PRO 28:10">lo7o miish laattana.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Dure asi bana</para>
  <para style="q2" vid="PRO 28:11">aadho eranchcha giidi qoppees;</para>
  <para style="q2" vid="PRO 28:11">gido attiin akeekay de7iza</para>
  <para style="q2" vid="PRO 28:11">hiyeesay iza paaccees.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Xilloti xoonida wode asay</para>
  <para style="q2" vid="PRO 28:12">ubbay ufayettees;</para>
  <para style="q2" vid="PRO 28:12">gido attiin iitati maata</para>
  <para style="q2" vid="PRO 28:12">oykkida wode asay baqatees.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Ba nagara genththiza asi aacenna;</para>
  <para style="q2" vid="PRO 28:13">gido attiin paaxizaynne</para>
  <para style="q2" vid="PRO 28:13">nagara aggizay maarettana.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />GODAAS ubbato</para>
  <para style="q2" vid="PRO 28:14">yayyiza asi anjjettidaade;</para>
  <para style="q2" vid="PRO 28:14">gido attiin ba wozina dammasiza</para>
  <para style="q2" vid="PRO 28:14">asi meton gelana.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Hiyeesa haariza iita daannay</para>
  <para style="q2" vid="PRO 28:15">xaaggiza gaammonne</para>
  <para style="q2" vid="PRO 28:15">guppi oykkiza zardo mala.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Wozinay paccida daannay</para>
  <para style="q2" vid="PRO 28:16">menxe iitees;</para>
  <para style="q2" vid="PRO 28:16">gido attiin bessontta</para>
  <para style="q2" vid="PRO 28:16">go7a ixxizaadey</para>
  <para style="q2" vid="PRO 28:16">daro layth de7ees.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />As wodhida asi hayqqana</para>
  <para style="q2" vid="PRO 28:17">gakkanaas toylattishe dees;</para>
  <para style="q2" vid="PRO 28:17">iza oonikka shiishshi ekkenna.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Borey baynda hemettiza asi</para>
  <para style="q2" vid="PRO 28:18">qohettontta attana;</para>
  <para style="q2" vid="PRO 28:18">gido attiin geella asi</para>
  <para style="q2" vid="PRO 28:18">issi gallas kundana.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Ba gade goyiza mino asi</para>
  <para style="q2" vid="PRO 28:19">kath kallees;</para>
  <para style="q2" vid="PRO 28:19">gido attiin hada yo7o kaalliza asi</para>
  <para style="q2" vid="PRO 28:19">manqoteththaafe ke7enna.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ammanettida asi keehi anjjettana;</para>
  <para style="q2" vid="PRO 28:20">gido attiin durettanaas jaamizay</para>
  <para style="q2" vid="PRO 28:20">qaxxayettontta attenna.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Shaakkidi maadoy lo7enna;</para>
  <para style="q2" vid="PRO 28:21">gido attiin asi guuththa kaththas</para>
  <para style="q2" vid="PRO 28:21">giidi mooro ooththees.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Uuzettiza asi durettanaas jaamees;</para>
  <para style="q2" vid="PRO 28:22">bana hiyeesateththi</para>
  <para style="q2" vid="PRO 28:22">oykkanayssaka erenna.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />As coo sabbiza asappe</para>
  <para style="q2" vid="PRO 28:23">seeriza asi guyeppe dosettees.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ba aawappenne ba aayppe kaysidi,</para>
  <para style="q2" vid="PRO 28:24">«Tani aykkoka nagara</para>
  <para style="q2" vid="PRO 28:24">ooththabeekke» giza asi</para>
  <para style="q2" vid="PRO 28:24">bashshiza asara issi mala.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Yiiqey asi oosh denththees;</para>
  <para style="q2" vid="PRO 28:25">gido attiin GODAAN</para>
  <para style="q2" vid="PRO 28:25">ammanettizay anjjettees.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Banan ammanettiza asi eeya;</para>
  <para style="q2" vid="PRO 28:26">gido attiin aadho erateththan</para>
  <para style="q2" vid="PRO 28:26">hemettizay saron de7ees.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Hiyeesas immiza asas paccenna;</para>
  <para style="q2" vid="PRO 28:27">gido attiin istti</para>
  <para style="q2" vid="PRO 28:27">be7ishe be7onttaththo</para>
  <para style="q2" vid="PRO 28:27">hanizaade qanggeththi gakkana.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Iita asati maata demmiza wode</para>
  <para style="q2" vid="PRO 28:28">derey baqatees;</para>
  <para style="q2" vid="PRO 28:28">gido attiin istti dhayza wode</para>
  <para style="q2" vid="PRO 28:28">xilloti coratteettes.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Daro wode seeriin ixxidi</para>
  <para style="q2" vid="PRO 29:1">ba morge zoodisida asi</para>
  <para style="q2" vid="PRO 29:1">hassa7ontta meqqana;</para>
  <para style="q2" vid="PRO 29:1">hessaades paxeteththika deenna.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Xillo asati maata oykkiza wode</para>
  <para style="q2" vid="PRO 29:2">asay ufayettees;</para>
  <para style="q2" vid="PRO 29:2">gido attiin iita asati</para>
  <para style="q2" vid="PRO 29:2">biitta haariza wode asay oolees.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Aadho erateth dosiza asi</para>
  <para style="q2" vid="PRO 29:3">ba aawa ufayssees;</para>
  <para style="q2" vid="PRO 29:3">gido attiin laymatara laggetizay</para>
  <para style="q2" vid="PRO 29:3">ba aqota dhayssees.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Tumaa pirdiza kawoy</para>
  <para style="q2" vid="PRO 29:4">ba dere woppu histtees;</para>
  <para style="q2" vid="PRO 29:4">gido attiin matta7e</para>
  <para style="q2" vid="PRO 29:4">maanaas yiiqetizay</para>
  <para style="q2" vid="PRO 29:4">ba deraa laallees.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ba laggezas cimo haasayza asi</para>
  <para style="q2" vid="PRO 29:5">iza tohos woximade waaxees.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Iita asi barkka</para>
  <para style="q2" vid="PRO 29:6">ba nagaran oykettees;</para>
  <para style="q2" vid="PRO 29:6">gido attiin xillo asi</para>
  <para style="q2" vid="PRO 29:6">ufayetteessinne yexxees.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Xillo asi hiyeesatas</para>
  <para style="q2" vid="PRO 29:7">suure pirday</para>
  <para style="q2" vid="PRO 29:7">pirdettana mala qoppees;</para>
  <para style="q2" vid="PRO 29:7">gido attiin iita asi</para>
  <para style="q2" vid="PRO 29:7">hessa mala wudukka geenna.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Miirizayti kataman</para>
  <para style="q2" vid="PRO 29:8">shiro denththeettes;</para>
  <para style="q2" vid="PRO 29:8">gido attiin aadho erateththi diza</para>
  <para style="q2" vid="PRO 29:8">asati hanqo irixiseettes.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Aadho erateththi diza asi</para>
  <para style="q2" vid="PRO 29:9">eeya asara pirdaso biikko</para>
  <para style="q2" vid="PRO 29:9">eeyay hanqetteessinne qidhees;</para>
  <para style="q2" vid="PRO 29:9">izas saroykka deenna.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Suuth gussanaas jaamiza asati</para>
  <para style="q2" vid="PRO 29:10">suure as ixxeettes;</para>
  <para style="q2" vid="PRO 29:10">qasse xillo asaakka</para>
  <para style="q2" vid="PRO 29:10">wodhanaas koyeettes.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Eeya asi zaway baynda hanqeettes;</para>
  <para style="q2" vid="PRO 29:11">gido attiin aadho eranchchay</para>
  <para style="q2" vid="PRO 29:11">ba hanqo mittees.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Dere haarizaadey</para>
  <para style="q2" vid="PRO 29:12">wordo yo7o ekkiko</para>
  <para style="q2" vid="PRO 29:12">iza shuumeti ubbay</para>
  <para style="q2" vid="PRO 29:12">iita gideettes.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Hiyeesaynne as naaqqizaades</para>
  <para style="q2" vid="PRO 29:13">koththa miishshi dees;</para>
  <para style="q2" vid="PRO 29:13">GODAY nam7ataska</para>
  <para style="q2" vid="PRO 29:13">xeelliza ayfe immides.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Issi kawoy hiyeesas suure pirdiko</para>
  <para style="q2" vid="PRO 29:14">iza kawoteththa araatay</para>
  <para style="q2" vid="PRO 29:14">mernaas minni daana.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Xunduqi dishoy naytas</para>
  <para style="q2" vid="PRO 29:15">aadho erateth immees;</para>
  <para style="q2" vid="PRO 29:15">gido attiin yeda diccida nay</para>
  <para style="q2" vid="PRO 29:15">ba aayo kawushshees.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Iita asati maata oykkiza wode</para>
  <para style="q2" vid="PRO 29:16">nagaray darees;</para>
  <para style="q2" vid="PRO 29:16">gido attiin xilloti</para>
  <para style="q2" vid="PRO 29:16">istta kundeththaa be7ana.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Ne naa seera;</para>
  <para style="q2" vid="PRO 29:17">histtiko neni saro demmana;</para>
  <para style="q2" vid="PRO 29:17">izi nena ufayssana.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Ajjuutay bayndason</para>
  <para style="q2" vid="PRO 29:18">derey yeda daana;</para>
  <para style="q2" vid="PRO 29:18">gido attiin wogaa naagiza</para>
  <para style="q2" vid="PRO 29:18">asi anjjettidaade.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Ashkaray coo doonan yootiin</para>
  <para style="q2" vid="PRO 29:19">xalla erenna;</para>
  <para style="q2" vid="PRO 29:19">yo7oy izas gelizaakkoka</para>
  <para style="q2" vid="PRO 29:19">izi azazettenna.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Eeson haasayza as beyay?</para>
  <para style="q2" vid="PRO 29:20">Izappe eeya asas hidotay dees.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Asi ba aylle</para>
  <para style="q2" vid="PRO 29:21">naateteththafe doommidi</para>
  <para style="q2" vid="PRO 29:21">al7ison dichchiko</para>
  <para style="q2" vid="PRO 29:21">wurseththan izaade bolla</para>
  <para style="q2" vid="PRO 29:21">ceecey gakkana.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Hanqettiza asi</para>
  <para style="q2" vid="PRO 29:22">oosh denththeththees;</para>
  <para style="q2" vid="PRO 29:22">elle yiillotiza asi</para>
  <para style="q2" vid="PRO 29:22">daro nagara ooththees.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Otoroy as kawushshees;</para>
  <para style="q2" vid="PRO 29:23">gido attiin</para>
  <para style="q2" vid="PRO 29:23">ashketeththi bonchchisees.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Kaysora zuppetiza asi</para>
  <para style="q2" vid="PRO 29:24">bana ixxiza asa;</para>
  <para style="q2" vid="PRO 29:24">qanggi caaqisishin siyishekka</para>
  <para style="q2" vid="PRO 29:24">izi co7u gees.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Asas yayyizayssi</para>
  <para style="q2" vid="PRO 29:25">izaades woximade gidees;</para>
  <para style="q2" vid="PRO 29:25">gido attiin</para>
  <para style="q2" vid="PRO 29:25">GODAAN ammanettiza asi</para>
  <para style="q2" vid="PRO 29:25">saron de7ees.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Daroti dere haarizayta sinththan</para>
  <para style="q2" vid="PRO 29:26">erettana koyeettes;</para>
  <para style="q2" vid="PRO 29:26">gido attiin asas suure pirday</para>
  <para style="q2" vid="PRO 29:26">GODAA achchafe beettees.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Xilloti as baleththizayta</para>
  <para style="q2" vid="PRO 29:27">shaatetteettes;</para>
  <para style="q2" vid="PRO 29:27">Iitati suure asata ixxeettes.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Agurey Haasayda Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Hayssafe kaallidi xaafettidayssi Yaaqe naa Agurey haasayda leemisota.</para>
  <para style="q2" vid="PRO 30:1">Agurey Itti7eelessinne</para>
  <para style="q2" vid="PRO 30:1">Ukaalas hayssa haasaydes.<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />«Tani asa ubbaafekka eeya darays;</para>
  <para style="q2" vid="PRO 30:2">asas de7iza akeekay taas baawa.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Tani aadho erateth tamaarabeekke;</para>
  <para style="q2" vid="PRO 30:3">Geeshshaza gishshassika</para>
  <para style="q2" vid="PRO 30:3">tani eriza miishshi deenna.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Salo pude ke7idi</para>
  <para style="q2" vid="PRO 30:4">duge wodhdhiday oonee?</para>
  <para style="q2" vid="PRO 30:4">Carko ba kushen oykkiday,</para>
  <para style="q2" vid="PRO 30:4">haath ba afalan yiiciday</para>
  <para style="q2" vid="PRO 30:4">sa7a gaxa iza soon soon</para>
  <para style="q2" vid="PRO 30:4">woththiday oonee?</para>
  <para style="q2" vid="PRO 30:4">Ane erikko iza sunth taas yoota;</para>
  <para style="q2" vid="PRO 30:4">Iza naaza sunththi</para>
  <para style="q2" vid="PRO 30:4">oona geetettizee?<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />«Xoossay yootiza qaalay</para>
  <para style="q2" vid="PRO 30:5">ubbay tuma;</para>
  <para style="q2" vid="PRO 30:5">Izan ammanettiza ubbaas</para>
  <para style="q2" vid="PRO 30:5">izi gondalle.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Iza qaala bolla aykkoka gujjofa;</para>
  <para style="q2" vid="PRO 30:6">gujjiko izi nena seerana;</para>
  <para style="q2" vid="PRO 30:6">neni wordanchcha gididayssaka</para>
  <para style="q2" vid="PRO 30:6">izi qonccisana.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />«GODAWU! Tani nena</para>
  <para style="q2" vid="PRO 30:7">nam7u miish oychchays;</para>
  <para style="q2" vid="PRO 30:7">tani hayqqana gakkanaas</para>
  <para style="q2" vid="PRO 30:7">istta tana diggofa.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Tani as cimmontta malanne</para>
  <para style="q2" vid="PRO 30:8">wordo haasayontta mala</para>
  <para style="q2" vid="PRO 30:8">tana naaga;</para>
  <para style="q2" vid="PRO 30:8">tana dure woykko</para>
  <para style="q2" vid="PRO 30:8">manqo histtofa;</para>
  <para style="q2" vid="PRO 30:8">gido attiin hachchis hachchis</para>
  <para style="q2" vid="PRO 30:8">gidiza kath taas imma.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Histtontta aggiko</para>
  <para style="q2" vid="PRO 30:9">tani keeha kallada nena kaddana;</para>
  <para style="q2" vid="PRO 30:9">‹GODAY izi oonee?› gaana;</para>
  <para style="q2" vid="PRO 30:9">woykko manqada kaysana;</para>
  <para style="q2" vid="PRO 30:9">histtada tani Xoossa</para>
  <para style="q2" vid="PRO 30:9">sunththaa caysana.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />«Nena qanggontta malanne</para>
  <para style="q2" vid="PRO 30:10">izi qanggiin nees</para>
  <para style="q2" vid="PRO 30:10">gometontta mala,</para>
  <para style="q2" vid="PRO 30:10">aylle iza goda sinththan</para>
  <para style="q2" vid="PRO 30:10">iitan denththofa.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Ba aawa qanggizanne</para>
  <para style="q2" vid="PRO 30:11">ba aayokka anjjontta</para>
  <para style="q2" vid="PRO 30:11">yeletay dees.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Tuna gidi uttidi</para>
  <para style="q2" vid="PRO 30:12">banttana geeshsha mala</para>
  <para style="q2" vid="PRO 30:12">qoodiza asati deettes.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Otoron kumida asatinne</para>
  <para style="q2" vid="PRO 30:13">as kadhidi xeelliza asati deettes.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Hiyeesatanne metotanchchata</para>
  <para style="q2" vid="PRO 30:14">dere giddofe dhayssanaas</para>
  <para style="q2" vid="PRO 30:14">istta achchay mashsha mala gidida</para>
  <para style="q2" vid="PRO 30:14">istta gaaginay biillama mala</para>
  <para style="q2" vid="PRO 30:14">gidida asati deettes.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />«Ulos nam7u macca nayti deettes.</para>
  <para style="q2" vid="PRO 30:15">Istti, ‹Nuus imma! Nuus imma!›</para>
  <para style="q2" vid="PRO 30:15">giidi waasseettes.</para>
  <para style="q2" vid="PRO 30:15">Mulekka kalli erontta</para>
  <para style="q2" vid="PRO 30:15">heedzdzati deettes;</para>
  <para style="q2" vid="PRO 30:15">oydanththozi qasse mulera,</para>
  <para style="q2" vid="PRO 30:15">‹Gidana› gi erenna.<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Hessanttika duufo, maynida ulo,</para>
  <para style="q2" vid="PRO 30:16">haaththi kalli erontta</para>
  <para style="q2" vid="PRO 30:16">mela biittanne,</para>
  <para style="q2" vid="PRO 30:16">‹Taas gidana!› gi erontta tama.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />«Ba aawa qidhiza naa ayfenne,</para>
  <para style="q2" vid="PRO 30:17">ba aayo kadhiza naa ayfe</para>
  <para style="q2" vid="PRO 30:17">kelkan de7iza quuroti woocana;</para>
  <para style="q2" vid="PRO 30:17">iza ashoza ankkoti maana.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Tana keehi malalisiza</para>
  <para style="q2" vid="PRO 30:18">heedzdzu miishshati deettes;</para>
  <para style="q2" vid="PRO 30:18">oydanththozi</para>
  <para style="q2" vid="PRO 30:18">ubbaarakka taas gelenna.<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Hessanttika golleti</para>
  <para style="q2" vid="PRO 30:19">salora paalliza paalo,</para>
  <para style="q2" vid="PRO 30:19">shooshshi shuchcha bollara</para>
  <para style="q2" vid="PRO 30:19">sololu gi buus,</para>
  <para style="q2" vid="PRO 30:19">markabey abbaa bollara biza</para>
  <para style="q2" vid="PRO 30:19">buus addey macca naa siiqo</para>
  <para style="q2" vid="PRO 30:19">demmanaas haniza hanota.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />«Layma maccassaya</para>
  <para style="q2" vid="PRO 30:20">haniza hanoykka</para>
  <para style="q2" vid="PRO 30:20">hessa mala.</para>
  <para style="q2" vid="PRO 30:20">Iza muussa mawus;</para>
  <para style="q2" vid="PRO 30:20">gido attiin midaappe guyen,</para>
  <para style="q2" vid="PRO 30:20">ba doona quccada,</para>
  <para style="q2" vid="PRO 30:20">‹Tani aykkoka</para>
  <para style="q2" vid="PRO 30:20">moorabeekke› gawus.<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />«Heedzdzu yo7otan</para>
  <para style="q2" vid="PRO 30:21">biittay qaaxxees;</para>
  <para style="q2" vid="PRO 30:21">oydanththoza ubbaaka</para>
  <para style="q2" vid="PRO 30:21">tookkanaas dandayenna.<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Hessanttika aylley kawotida wode,</para>
  <para style="q2" vid="PRO 30:22">eeyay kath kallida wode,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />asi ixxida maccassaya</para>
  <para style="q2" vid="PRO 30:23">adde gelida wodenne</para>
  <para style="q2" vid="PRO 30:23">macca ashkariya ba godatteyo</para>
  <para style="q2" vid="PRO 30:23">laattida wode haniza hanota.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />«Sa7a bolla oyddu</para>
  <para style="q2" vid="PRO 30:24">guuththa medhetati deettes;</para>
  <para style="q2" vid="PRO 30:24">gido attiin istti</para>
  <para style="q2" vid="PRO 30:24">keehi aadho eranchchata.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Hessanttika cunccalleti</para>
  <para style="q2" vid="PRO 30:25">wolqqay baynda medheta;</para>
  <para style="q2" vid="PRO 30:25">gido attiin banttas miza miish</para>
  <para style="q2" vid="PRO 30:25">bone shiishshi dagaseettes.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Guppaleti guuththa</para>
  <para style="q2" vid="PRO 30:26">wolqqay de7izayta;</para>
  <para style="q2" vid="PRO 30:26">gido attiin bantta keeth</para>
  <para style="q2" vid="PRO 30:26">zaalla giddon keexxeettes.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Booletas kawoy deenna;</para>
  <para style="q2" vid="PRO 30:27">gido attiin istti ubbayka</para>
  <para style="q2" vid="PRO 30:27">maaran maaran zatteettes.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Zareti kushen</para>
  <para style="q2" vid="PRO 30:28">oykkiinkka oyketteettes;</para>
  <para style="q2" vid="PRO 30:28">gido attiin istti</para>
  <para style="q2" vid="PRO 30:28">kawo keeththankka de7eettes.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />«Bantta maata bessishe hemettiza,</para>
  <para style="q2" vid="PRO 30:29">heedzdzu medhetati deettes;</para>
  <para style="q2" vid="PRO 30:29">oydanththozikka</para>
  <para style="q2" vid="PRO 30:29">puulattidi hemettees.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Hessanttika do7a ubbaafe</para>
  <para style="q2" vid="PRO 30:30">wolqqamanne</para>
  <para style="q2" vid="PRO 30:30">aykkoska yayyidi</para>
  <para style="q2" vid="PRO 30:30">baqati erontta gaammo.<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Maccassata giddon kososi</para>
  <para style="q2" vid="PRO 30:31">hemettiza adde kutto,</para>
  <para style="q2" vid="PRO 30:31">deysha orgenne</para>
  <para style="q2" vid="PRO 30:31">ba olanchchatan</para>
  <para style="q2" vid="PRO 30:31">ajjabettida kawo.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />«Neni eeyada</para>
  <para style="q2" vid="PRO 30:32">otorettidaa gidikkonne</para>
  <para style="q2" vid="PRO 30:32">iita miish ooththanaas</para>
  <para style="q2" vid="PRO 30:32">halchchidaa gidikko</para>
  <para style="q2" vid="PRO 30:32">ane takki gaada qoppa.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Maaththi bukkiin oysi ke7iza mala,</para>
  <para style="q2" vid="PRO 30:33">siidhe iccinkka</para>
  <para style="q2" vid="PRO 30:33">suuththi yiza mala</para>
  <para style="q2" vid="PRO 30:33">hanqo denththeththiko</para>
  <para style="q2" vid="PRO 30:33">oosh medhdhees.»<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Kawo Limu7eele Aaya Ba Naazas Immida Timirte</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Kawo Limu7eele aaya kawo Limu7eele tamaarsida timirtey hayssafe kaallidayssa.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />«Ta naazoo!</para>
  <para style="q2" vid="PRO 31:2">Ta uloppe wodhdhida ta naazoo!</para>
  <para style="q2" vid="PRO 31:2">Tani adinetta yelida ta naazoo!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Maccassan ne wolqqa wursofa;</para>
  <para style="q2" vid="PRO 31:3">kawota bashshiza miishshan</para>
  <para style="q2" vid="PRO 31:3">ne akata dhayssofa.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />«Limu7eele hayssi kawotas</para>
  <para style="q2" vid="PRO 31:4">bessenna;</para>
  <para style="q2" vid="PRO 31:4">kawoti woyne ushshu</para>
  <para style="q2" vid="PRO 31:4">uyanaas bessenna;</para>
  <para style="q2" vid="PRO 31:4">dere ayssizayti</para>
  <para style="q2" vid="PRO 31:4">maththosiza ushshu</para>
  <para style="q2" vid="PRO 31:4">yaaretanaas bessenna.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Istti uyiza wode wogaa baletteettes;</para>
  <para style="q2" vid="PRO 31:5">qohettidayta maata sugeettes.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Hayqqana hanizaytas</para>
  <para style="q2" vid="PRO 31:6">maththosiza ushshu</para>
  <para style="q2" vid="PRO 31:6">meto bolla dizaytas</para>
  <para style="q2" vid="PRO 31:6">woyne ushshu immite.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Istti uyidi</para>
  <para style="q2" vid="PRO 31:7">bantta manqoteththa dogetto;</para>
  <para style="q2" vid="PRO 31:7">bantta tuggaka zaari qoppofetto.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />«Bantta gishshas haasayanaas</para>
  <para style="q2" vid="PRO 31:8">dandayonttaytas</para>
  <para style="q2" vid="PRO 31:8">neni haasaya;</para>
  <para style="q2" vid="PRO 31:8">metotanchchata maata gishshas</para>
  <para style="q2" vid="PRO 31:8">neni mootetta.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Haasayada isttas suure pirda pirda;</para>
  <para style="q2" vid="PRO 31:9">hiyeesatanne</para>
  <para style="q2" vid="PRO 31:9">metotanchchata maata</para>
  <para style="q2" vid="PRO 31:9">bonchchisa» gaada tamaarsadus.<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="s1">Wozinama Machcho</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Wozinama machcho</para>
  <para style="q2" vid="PRO 31:10">ooni demmanawu dandayzee?</para>
  <para style="q2" vid="PRO 31:10">Iza zo7o inqqufekka</para>
  <para style="q2" vid="PRO 31:10">keeha aadhdhawus.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Izi keeththa aaway</para>
  <para style="q2" vid="PRO 31:11">izo ubbaa miishshankka</para>
  <para style="q2" vid="PRO 31:11">ammanees;</para>
  <para style="q2" vid="PRO 31:11">izas aykkoyka paccenna.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Iza ba de7o layth ubbaan</para>
  <para style="q2" vid="PRO 31:12">izas lo7o attiin</para>
  <para style="q2" vid="PRO 31:12">iita miish ooththuku.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Dorsa iskefenne</para>
  <para style="q2" vid="PRO 31:13">talbba buuxa ekkada,</para>
  <para style="q2" vid="PRO 31:13">ooso dosiza ba kushen suqawus.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Iza zal7anchchata markabe mala;</para>
  <para style="q2" vid="PRO 31:14">ba kath haakko biittafe ehawus.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Iza ba soo asas</para>
  <para style="q2" vid="PRO 31:15">quma kaththanaassinne</para>
  <para style="q2" vid="PRO 31:15">ba macca aylletas</para>
  <para style="q2" vid="PRO 31:15">ooso shaakka immanaas,</para>
  <para style="q2" vid="PRO 31:15">sa7ay buro wonttana gishin</para>
  <para style="q2" vid="PRO 31:15">dendawus.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Iza barkka qoppada</para>
  <para style="q2" vid="PRO 31:16">goshsha gade shammawus;</para>
  <para style="q2" vid="PRO 31:16">ba demmida miishshan</para>
  <para style="q2" vid="PRO 31:16">woyne tokkawus.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Iza minnada ba ooso polawus;</para>
  <para style="q2" vid="PRO 31:17">izi qesetikka oosos mino.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Iza ba oosos</para>
  <para style="q2" vid="PRO 31:18">wodhey dizayssa akeekawus;</para>
  <para style="q2" vid="PRO 31:18">omarsika izi xomppey to7enna.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Iza ba liqaqan suqawus,</para>
  <para style="q2" vid="PRO 31:19">ba afala daddawus.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Iza hiyeesatas ba kushe miccawus;</para>
  <para style="q2" vid="PRO 31:20">metotanchchatas</para>
  <para style="q2" vid="PRO 31:20">kiyateth immawus.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Izi soo asay ubbay</para>
  <para style="q2" vid="PRO 31:21">ho7iza may7o may7ida;</para>
  <para style="q2" vid="PRO 31:21">hessa gishshas iza</para>
  <para style="q2" vid="PRO 31:21">shachchi bukkikokka hirguku.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Hiiththan ongiza</para>
  <para style="q2" vid="PRO 31:22">may7o ooththawus;</para>
  <para style="q2" vid="PRO 31:22">laynonne ochcha teera misatiza</para>
  <para style="q2" vid="PRO 31:22">may7o may7awus.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Dere cimati dubbusha shiiqizason</para>
  <para style="q2" vid="PRO 31:23">izi keeththa aaway</para>
  <para style="q2" vid="PRO 31:23">bonchchettida asa.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Laynoppe seelo may7ota</para>
  <para style="q2" vid="PRO 31:24">ooththada bayzawus;</para>
  <para style="q2" vid="PRO 31:24">zal7anchchataskka dancco</para>
  <para style="q2" vid="PRO 31:24">dadda shiishshawus.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Iza minonne puulara diza maccassa;</para>
  <para style="q2" vid="PRO 31:25">iza yiza layththata</para>
  <para style="q2" vid="PRO 31:25">ufayssan mokkawus.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Aadho eran iza haasayawus;</para>
  <para style="q2" vid="PRO 31:26">izi inxarsafe</para>
  <para style="q2" vid="PRO 31:26">suure zorey ke7ees.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Iza ba soo asaa hano</para>
  <para style="q2" vid="PRO 31:27">lo7eththa kaallawus;</para>
  <para style="q2" vid="PRO 31:27">azalla hanoy izi bollan</para>
  <para style="q2" vid="PRO 31:27">beetti erenna.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Izi nayti izo,</para>
  <para style="q2" vid="PRO 31:28">«Anjjettidaree» geettes;</para>
  <para style="q2" vid="PRO 31:28">izi keeththa aawaykka</para>
  <para style="q2" vid="PRO 31:28">izo galatishe,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />«Lo7o miish ooththida</para>
  <para style="q2" vid="PRO 31:29">daro maccassati deettes;</para>
  <para style="q2" vid="PRO 31:29">gido attiin neni istta</para>
  <para style="q2" vid="PRO 31:29">ubbaafe aadhdhaasa» gees.<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Mala lo7oy baleththees;</para>
  <para style="q2" vid="PRO 31:30">puulaykka qokkees;</para>
  <para style="q2" vid="PRO 31:30">gido attiin GODAAS yayyiza</para>
  <para style="q2" vid="PRO 31:30">maccassi iza anjjettidaaro.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Izis bessiza imota immite;</para>
  <para style="q2" vid="PRO 31:31">iza ooththida oosoy ubbay</para>
  <para style="q2" vid="PRO 31:31">dubbushan izo galatisso.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>