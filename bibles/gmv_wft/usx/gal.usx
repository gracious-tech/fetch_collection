<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Gamo Full Bible final version</book>
  <para style="h">Galatiya Asaas</para>
  <para style="toc1">Phawuloosi Galatiya Asaas Xaafida Kiita</para>
  <para style="toc2">Galatiya Asaas</para>
  <para style="toc3">Gala</para>
  <para style="mt2">Phawuloosi</para>
  <para style="mt1">Galatiya Asaas</para>
  <para style="mt2">Xaafida Kiita</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Yesusi ashshizaade gididayssa yootiza Mishiraachcho qaalay ubbason Ayzaabetas sabbakettiin asay ammani ammani darshin, «Ammanizaade gidanaas kase Muse wogaa poli naaganaas koshshizeyee? Koshshennee?» giza oyshay dendides; qeeri Iisiya geetettizason Oroome kawoy haarizason Galatiyan diza ammaniza asaa garsan, «Asi Xoossa achchan xillo gidanaas Yesusan ammano xalla gidontta Muse baggara imettida wogaza polo koshshees» giidi Phawuloosara eqettizayti deettes.</para>
  <para style="ip">Phawuloosi qasse Galatiya kiitaa xaafiday hayssa ha timirtezan balettida asati tuma timirtekkonne tuma ammanookko zaaranaassa; Phawuloosi Yesus Kirstoosa Hawaare gididayssa qoncciseththan doommees; iza Hawaareteththas xeygiday Xoossa attiin izi asa xeyssan kiitettonttayssanne qasse izi kiitettiday Ayhuda asaakko gidontta Ayzaabetas gididayssa ubbaa birshi yootees. Wurseththa shempota garsan ammano duussi Yesusa ammanon beettiza siiqoppe gididayssa lo7eththi yootees.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref> </char></para>
  <para style="io1">Phawuloosas imettida Hawaareteththa maata <char style="ior"><ref loc="GAL 1:11-2:21">1:11—2:21</ref> </char></para>
  <para style="io1">Xoossa kiyateththa Mishiraachcho qaala <char style="ior"><ref loc="GAL 3:7-4:31">3:7—4:31</ref> </char></para>
  <para style="io1">Ammanizayta goqateththinne ammano <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref> </char></para>
  <para style="io1">Kuushsha qofa <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>Asi kiittidaade gidontta Yesus Kirstoosa hayqoppe denththida iza Aawaa Xoossaafe kiitettida Phawuloosappe, <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>tanara diza ishata ubbaafe Galatiyan diza Woosa Keeththatas, <verse eid="GAL 1:2"/><verse number="3" style="v" sid="GAL 1:3"/>nu Aawaa Xoossaafe Godaa Yesus Kirstoosappe Xoossa kiyateththinne saroy inttes gido. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>Nu Aawaa Xoossaa shene gidiin iita alamezappe nuna ashshanaas bana aaththi immidayssas, <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>merippe mernaa gakkanaas izas bonchchoy gido.<verse eid="GAL 1:5"/></para>
  <para style="s1">Mishiraachcho Qaalay Mexi Issino</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>Intte Kirstoosa kiyateththan xeygidayssa aggaagidi hara dumma shaako Mishiraachcho qaalaakko simmidayssi tana daro malalisees. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>Ta hessa gida gaasoykka inttena baleththizaytinne Kirstoosa Mishiraachcho qaalaa mirqqiza issi issi asati diza gishshassa; tumappe giikko Mishiraachcho qaalay issino xalla. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>Gido attiin nuna gidiin woykko salo kiitanchcha gidiinkka nu inttes sabbakida Mishiraachcho qaalaappe hara dumma Mishiraachcho qaala sabbakikko hessaadey mernaas qanggettidaade gido. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Ta kase gida malakka ha7ikka zaaradakka kase intte ekkida Mishiraachcho qaalaappe hara dumma Mishiraachcho qaalaa sabbakikko izaadey mernaas qanggettidaade gido gays.<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>Ha7i tani asi tana eroshsho! Hashshu gaana mala koyazinayee? Xoossi hashshu gaana mala koyazinaa? Woykko as ufayssana koyazinaa? Ta as ufayssana koyzaakko Kirstoosa oosanchcha gidikke.<verse eid="GAL 1:10"/></para>
  <para style="s1">Xoossan Phawuloosa Xeygeteth</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>Ta ishatoo! Ta inttes sabbakida Mishiraachcho qaalay asa ooso gidonttayssa intte erana mala koyays. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>Hayssa ha Mishiraachcho qaalaza Yesus Kirstoosi taas qonccisides attiin ta oonappeka ekkabeekke; woykko oonikka tana tamaarsibeenna.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>Tani kase Ayhudata ammanon waana dizaakkonne Xoossa Woosa Keeth ta ay mala gooddidaakko qasse mulera dhayssanaas ta ay mala dafettidaakko intte siyideta.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 22:4-5">22:4-5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>Kase ta diza woden diza daro Ayhuda asata darotappe ammanon aadhdhays; kase nu aawata wogaa naaganaas daro dafettayssishin.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">Hawa 22:3</ref></char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>Gido attiin kase koyro tani ta aayi ulon dishin baas dooridi ba kiyateththan tana xeygida Xoossay, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>Ayzaabeta giddon iza naaza gishshas ta sabbakana mala ba naaza tanan qonccisanaas dosida gishshas tani oonarakka zorettabeekke. <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>Taappe kase Hawaare gididaytakko Yerusalaame babeekke shin ammanida mala heerakka Arabe biitta badis; heeppeka Damasqo simmadis. <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>Heeppeka heedzdzu layththafe guye Phexroosara gaagganaas Yerusalaame badis; izara gaaggada tammanne ichchashu gallas gakkanaas heen gam7adis.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">Hawa 9:26-30</ref></char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>Gido attiin Godaa ishaa Yaaqoobeppe attiin Hawaaretappe oonakka beyabeekke.<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>Hayssa ta inttes xaafizayssan ta wordo haasayonttayssa Xoossa sinththan yootays. <verse eid="GAL 1:20"/><verse number="21" style="v" sid="GAL 1:21"/>Hessafe guye Sooriyanne Kilqiya geetettiza dere badis. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>Yuhuda deren diza Kirstoosan ammaniza asay tana beyibeenna. <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>Gido attiin, «Beni nuna ammano gishshas gooddi dhayssana koyza addezi ha7i he ammanoza zaari sabbakees» giza wore xalla siyida. <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>He asay ta gaason Xoos galatides.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">Phawuloosa Hawaareti Mokki Ekkida</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>Tammanne oyddu layththafe guye qasseka Yerusalaame badis; he wode Barnabaasara days; Titoosakka tanara ekka badis.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">Hawa 11:30</ref>; <ref loc="ACT 15:2">15:2</ref></char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>Taas qonccida gishshas hee badis; Ayzaabeta giddon ta sabbakiza Mishiraachcho qaalaakka isttas yootadis; gido attiin ta kase mela woxxidaakko gaadanne qasseka sinththafe coo mela woxxontta mala hirgada waannatizaytas dumma erisadis. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>Haray attoshin tanara diza Titoosi izi Girike as shin izi qaxxarettana mala wolqqaththibeettenna. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>Hayssi ha yo7ozi dendiday issi issi wordo ammanizayti nuni Yesus Kirstoosan demmida geeshshateththaa yuuyi yuuyi paacci beyanaassinne nuna aylleteththan zaari gelththanaas loddara nuukko salli gelida gishshassa. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>Heyta he asatas nuni issitokka haarettibeekko; hessika intte Mishiraachcho qaalaa tumateththan eqqi daana mala giidikko.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>Waanna misatiza asati taas aykkoka misatettenna; Xoossi asa ayfeso be7idi maado ooththi erenna; heyti he asati ta kiittiza yo7otas taas aykkoka gujjibeettenna.<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Zaare 10:17</ref></char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>Gido attiin Phexroosi qaxxarettidaytas Mishiraachcho qaalaa sabbakanaas hadara ekkidayssa mala tanikka qaxxarettonttaytas Mishiraachcho qaalaa sabbakanaas hadara ekkidayssa istti erida. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>Phexroosi Ayhudatas Hawaare gidi ooththana mala ooththida Xoossay tanikka Ayzaabetas Hawaare gida ooththana mala taas ooththides. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>Waannati Yaaqoobey, Phexroosinne Yohannisikka taas imettida Xoossa imotaa akeekidi taassinne Barnabaasas ba ushachcha kushe immida; hessafe guye nuni Ayzaabetas istti qasse Ayhudatas qaala yootanaas qaalaa ero gi ekkida. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>Istti nuus hadara giday manqotas qofa nu aggontta mala; ta amoykka hessa ooththanaassa.<verse eid="GAL 2:10"/></para>
  <para style="s1">Phawuloosi Phexroosa Qopheth</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Phexroosi Anxokiya yida wode erettida bala ooththida gishshas ta iza qonccen qophadis. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>Issi issi asati Yaaqoobe achchafe yaanaappe kase Phexroosi Ayzaabetara issife kath mizayssa aggidi asati yidaappe guye qaxxarettida asatas babbidi Ayzaabetappe shaaketti guye guye guus oykkides. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>Barnabaasikka isttaththo qoodheppe qommon hanon ekettana gakkanaas hara Ayhuda baggafe ammanida asaykka izara issifettides. <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>Istta oosoy Mishiraachcho qaalaa tuman gidonttayssa ta erada kumeththa asaa achchan Phexroosa, «Ne Ayhuda as shin Ayzaabeta wogan attiin Ayhudata wogan dabeekka; histtiin Ayzaabeti Ayhudata woga kaallana mala aazas wolqqaththay?» gadis.<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>«Nuni nu yeleteththan Ayhudatappe attiin Ayzaabeta mala nagaranchcha gidokko. <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>Asi Yesus Kirstoosan ammanon xillana attiin woga naagon xillonttayssa nu eroos; hessa gishshas woga naagon gidontta Kirstoosa ammanon nu xillana mala nunikka qasse Yesus Kirstoosa ammanidos; woga naagon oonikka xillenna.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">Maza 143:2</ref>; <ref loc="ROM 3:20">Oro 3:20</ref>,<ref loc="ROM 3:22">22</ref></char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>«Nu Kirstoosan xillana koykko nuni nagaranchchata gididayssi qoncci erettides; histtiin Kirstoosi nagaray dari dari baana mala koyzee? Koyenna. <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>Tani laallidayssa zaarada tarkka ta kushera keexxiko tanikka woga mooridaade gididayssa ammanettays. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>Tani Xoossas daana mala wogaa baggara he wogaas hayqqadis. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>Tani Kirstoosara kaqettadis; hayssafe guye tani taas diikke; gido attiin Kirstoosi ta giddon dees; ha7ikka ta ashon diza duussay tana dosidi bana ta gishshas aaththi immida Xoossa Naa bolla diza ammanon diza duussa. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>Tani Xoossa kiyateth kawushshike; xilloteththi woga naagon beettiza miish gidikko Kirstoosi hada hayqqides guussakaa!»<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">Ammanon Duus Woykko Woga Naago</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Intteno yuushshi qoppontta Galatiya asatoo! Inttes balettontta mala iza kaqeteththaa ta intte sinththan misle mala giigsa bessadisko shin inttena oonee bitiday? <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>Intte Xillo Ayana ekkiday woga naagoneyee? Sabbakettida qaala ammanonee? Ta hanno issiniyo inttefe erana koyays. <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>Intte hessa mala qoppi erontta asee? Xoossa Ayanan oykkidayssa zaaridi asho hanon polanaas waayetteetii? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>Tumu intte hanno gakkanaas daaburda daabursay coo melaa? Coo mela gidikko hada daaburdeta. <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>Xoossi inttes Ayana immidaynne intte achchan malaata ooththiday intte woga naagida gishshasseyee? Woykko intte siyida qaalaan ammanida gishshasseyee?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>Ane intte Abrahaame gishshas qopite; geeshsha Maxaafan, «Izi Xoos ammaniin ammanoy izas xilloteththan qoodettides» geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe 15:6</ref>; <ref loc="ROM 4:3">Oro 4:3</ref></char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>Hessa gishshas ammanizayti Abrahaame nayta gididayssa wozinan woththite.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">Oro 4:16</ref></char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>Ayzaabey ammanon attanayssa eridi Xoossi kase Geeshsha Maxaafan, «Derey wuri ne baggara anjjettana» giidi Mishiraachcho qaalaa Abrahaames yooti woththides.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">Medhe 12:3</ref></char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>Hessa gishshas ammanizayti wuri ammaniza Abrahaamera issife anjjettidayta.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>«Woga naagon ammanettizayti wurikka qanggeththa garsan deettes; woga maxaafatan xaafettidayssa ubbaa ooththonttaadey izi qanggettidaade» geetetti xaafettides. <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>«Xillo asi ammanon de7ees» giza gishshas oonikka Xoossa sinththan wogan attonttayssi geeshsha.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">Ib 2:4</ref></char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>Wogay ammanon xaphibeenna; gido attiin, «Wogata wursi naagizaadey izi naagidayssan de7on daana» geetettides.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lewe 18:5</ref></char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>«Miththa bolla kaqettiza asi qanggettidaade» geetetti xaafettida gishshas Kirstoosi nu gishshas qanggettidaade gididi nuna woga qanggeththafe wozzides.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">Zaare 21:23</ref></char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>Abrahaames imettida anjjoy Yesus Kirstoosa baggara deres gakkana mala nuna wozzides; hessika nuni ammanon Xillo Ayana ekkana mala hanides.<verse eid="GAL 3:14"/></para>
  <para style="s1">Woganne Hidota Qaala</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>Ta ishatoo! Ane ta inttes asi ba duussan haniza miish leemiso immays; haray attoshin asi issito caaqqida qaala issito caaqqidaappe guye oonikka shaaranaas woykko hara iza bolla gujjana dandayonttayssa mala hayssika hessa mala. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>Xoossi Abrahaames yootida qaalay Abrahaamessinne iza zereththassa; Geeshsha Maxaafay daro asas yootiza mala, «Iza zereththatas» geenna; gido attiin issi asas yootettiza mala, «Ne zereththas» gees; hessika Kirstoosa.<verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>Ta gizaykka hayssa; 430 layththafe guyen imettida wogay kasetidi Xoossi minththida caaqoza laallidi buro hanana hidota qaalaa shaarenna.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">Kessa 12:40</ref></char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>Laatay wogan hanizaakko hidota qaalan gelanaas koshshennashin; Xoossi ba kiyateththa qaalan Abrahaames immides.<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">Oro 4:14</ref></char></note> <verse eid="GAL 3:18"/><verse number="19" style="v" sid="GAL 3:19"/>Histtiin wogay aazas imettidee? Wogay imettiday asay woga yedhdhi aadhdhiza gishshas he ufayssay bessiza zereththay yaana gakkanaassa; wogay yidaykka kiitanchchata baggara gaanna gidiza issaade baggara yides. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>Gidikkoka gaannazi issaa bagga xalla xeellizaade gidenna; Xoossi gidikko issaa xalla.<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>Histtiin wogay sinththafe Xoossi woththana qaalaa diggizaazee? Mulekka diggenna; wogay imettiday asi izan de7o demmanaas gididaakko tumukka xilloteththi woga baggara beettanakkoshin. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>Qasse Geeshsha Maxaafay hayssi alamey wurikka nagaran qashettidayssa awajjees; hessika asi wurikka Yesus Kirstoosa ammanon beettiza hidotay ammanizaytas ubbaas imettanaassa.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Hayssi ammanoy yaanaappe kase nuni wogan qashettidi gordan doos. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>Hessa gishshas nu ammanon xillana mala wogay nuna Kirstoosakko gaththanaas naagizaade mala gididi naagides. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>Ha7i qasse he ammanoy yida gishshas hayssafe guye nuni woga garsan dookko.<verse eid="GAL 3:25"/></para>
  <para style="s1">Xoossa Nayta</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>Intte wurikka Yesus Kirstoosa ammanon Xoossa nayta. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>Intte Kirstoosara issino gidanaas xammaqettidayti wurikka Kirstoosa may7o mala may7ideta. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>Intte wurikka Yesus Kirstoosan issino attiin Ayhudanne Girike, Ayllenne goqa, maccanne adde giza dummateththi deenna; intte wurikka Yesus Kirstoosan issino. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>Intte Kirstoosayta gidikko intte Abrahaame zereththata; kase imettida hidota qaalaa mala intte laattanayta.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">Oro 4:13</ref></char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Ta gizay yelettida nay laatay izas gidikkoka izi biidi laattana gakkanaas ayllefe dumma gidenna. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>Iza aaway gida wodey gakkanaas izi bana dichchizayta, tamaarsizayta kushen gam7ees. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>Nunikka kase Ayana yo7os guuththa naa mala diza wode hayssa ha alameza wogaa garsan haaretti de7idos. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>Gido attiin kase ba qoppi woththida wodey gakkiin Xoossay maccassafe yelettidi wogaa naagida ba naaza nuus yeddides. <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>Hessika nuni iza nayta gidana malanne woga garsan dizayta wozzana mala hanides.<note caller="-" style="x"><char style="xo" closed="false">4:5-7 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">Oro 8:15-17</ref></char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>Intte iza nayta gidida gishshas Xoossaa, «Aabboo» giidi xeygiza ba naaza Ayana nu wozinan yeddides. <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>Hessa gishshas hayssafe guye ne naappe attiin aylle gidakka; neni naa gidida gishshas Xoossi nena bayssa laattizaade histtides.<verse eid="GAL 4:7"/></para>
  <para style="s1">Galatiya Asaas Phawuloosa Qofa</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>Intte Xoos eranaappe kase Xoos gidontta eeqatas aylleta. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>Ha7i gidikko Xoos erideta; qasseka Xoossan erettideta; histtiin qasseka guye simmidi gede go7ay baynda coo daabursiza timirteko waani simmidetii? Simmidi qasseka aylleteththa qambaran waaxettana koyeetii? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>Dumma gallassata, aginata, wodetanne layththata intte bonchcheeta. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>Ta inttenara daaburdayssi coo mela gidandee gaada babbays.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>Ta ishatoo! Ta inttena misatida mala intteka tana misatana mala ta inttena woossays; intte tana aykkoka qohibeekketa. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>Intte eriza mala ta inttes koyro Mishiraachcho qaala sabbakiday sako gaasonna. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>Ta sakoy inttes meto gidiinkka tana salettibeekketa woykko tana harasettibeekketa; gido attiin intte tana Xoossa kiitanchcha malanne hessafekka bollara Yesus Kirstoosa mala mokki ekkideta.<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>Histtiin ha7i he intte ufayssay awa bidee? Inttes hanizaaz gididaakko intte intte ayfe taas kessi immanaas guye gonttayssa ta inttes markkattays. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>Tani tumaa inttes kessa yootida gishshas inttes morkke gidadinaasha?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>Heyti asati inttena baakko ekkanaas daabureettes attiin lo7os daaburettenna; istti koyzay inttena nuuppe shaakkidi ba as histtanaassa. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>Lo7os mindateththi lo7o; hessika hananaas bessizay ubba wode gidikkofe attiin ta inttenara diza wode xalla gidoppo. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>Ta naytoo! Kirstoosi intte wozinan xaafettiin ta beyana gakkanaas intte gishshas ta miixattays. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>Ta intte gishshas qofan metotadis; ta dandayzaakko ha7i intte giddon beettada inttena lo7eththa tamaarsizaakko ay mala dosazinaa!<verse eid="GAL 4:20"/></para>
  <para style="s1">Agaaronne Saara</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Intteno Woga garsan aqana koyzayto ane taas yootite; wogay ay gizaakko siyibeekketii? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>Abrahaames issoy aylleyfe issoy qasse goqayppe yelettida nam7u nayti dizayssi Geeshsha Maxaafan xaafettides. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>Aylleyfe yelettida naazi asho wogaa mala yelettides; hankko goqayppe yelettidayssi ufayssa qaalaa mala yelettides.<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Hayti nam7u maccassati nam7u caaqota bessizayta gidida gishshas hayssi leemisos imettides; koyro caaqoya Siina zumaa bolla gidashe aylleteththas gidiza nayta yelizaaro; izakka Aggaaro. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>Hessa gishshas Aggaara Arabe biittan diza Siina zumaa gishshas gidada ha7i diza Yerusalaame katamayo misatawus; iza ba naytara aylleteththan dawus. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>Pude bolla salon diza Yerusalaamey gidikko goqa gidada dawus; izakka nu aayo. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>«Neni yelontta maynneye ufayetta! Hanne miixatta eronttaaree! ‹Ilili› ga waassa; azinay dizaarippe azinay bayndaari nayti darida» geetetti Geeshsha Maxaafan xaafettides.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">Isa 54:1</ref></char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Hessa gishshas ta ishatoo! Intteka Yisaaqa mala ufayssa qaalaa naytakko. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>Asho shene mala yelettidayssi Ayana wolqqan yelettidayssa gooddides; ha7ikka goodeththon dees.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">Medhe 21:9</ref></char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>Gido attiin Geeshsha Maxaafay qasse ay gizee? «Aylleyo izi naazara digga; aylley nay goqay naara laattenna» gees.<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">Medhe 21:10</ref></char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>Hessa gishshas ta ishatoo! Nuni goqay nayta attiin aylley nayta gidokko.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Nuna Kirstoosi geeshshiday nuni geeshshateththan daanaassa; hessa gishshas minni eqqite; nam7anththo aylleteththa qambaran gelopite. <verse eid="GAL 5:1"/><verse number="2" style="v" sid="GAL 5:2"/>Ta inttes gizayssa wozinan woththite; intte qaxxarettana koykko Kirstoosi inttena aykkoka go7enna gaada ta Phawuloosi inttes yootays. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>Qaxxarettana koyzayti wuri wogaa ubbaa polanayssi dosa gidonttayssa ta inttes issaas issaas qonccen yootays. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>Intteno Woga naagon xillana waayettizaytoo! Intte Kirstoosappe shaakettideta; iza kiyateththafekka haakkideta. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>Nu qasse ufayssan naagettiza xilloteththaa Xoossa Ayana baggara ammanon laamoteththan naagon doos. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>Asi Yesus Kirstoosan diikko qaxxarettiin woykko qaxxarettontta aggiin aykkoka go7enna; go7ay dizay siiqon qoncciza ammano xalla.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>Kase lo7o woth woxxeeta shin; ha7i inttes dhuphe gididi tumaas intte azazettontta mala inttena diggiday oonee? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Hessa mala baleththoy inttena xeygida Xoossaafe gidenna. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>«Guuththa irshoy liixe ubbaa denththees» geetettiza mala.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1Qoro 5:6</ref></char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>Inttes hara qofay deenna gaada tani Godaan ammanettays; inttes tikki gizaaz ooththizay oona gidikko izi ba pirda ekkana.<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>Ta ishatoo! Hanno gakkanaas ta sabbakizayssi asi attanaas qaxxarettana bessees gizaaz gididaakko histtiin hanno gakkanaas aazas tana gooddizoo? Hessa mala gididaakko Kirstoosa masqaley asas dhuphe gidennakoshin. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>Inttes tikki gizaaz ooththiza asati coo wogara qaxxareteth aggidi mulera qanxxi yegetto. <verse eid="GAL 5:12"/><verse number="13" style="v" sid="GAL 5:13"/>Ta ishatoo! Intte geeshshateththas xeygettideta; intte intte geeshshateththaa zaaridi inttes asho amo polanaas go7ettofte; hessafe intte intte garsan siiqon issoy issaa maaddite. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>Wogay wuri shiiqettidi issi qaalan qashettees; hessika, «Neni ase ne mala dosa!» gizayssa.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lewe 19:18</ref></char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>Gido attiin intte issoy issaara saxettizayta gidikko intte intte garsan wurontta mala naagettite.<verse eid="GAL 5:15"/></para>
  <para style="s1">Ayanan Simereteth</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Hessa gishshas ta inttena Ayanan simerettite; qasseka asho amokka polopite gays. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>Ashoy Ayanay koyonttaaz amottees; Ayanaykka ashoy koyonttaaz amottees; hayti issoy issaara ba garsan ixettiza gishshas intte intte koyida mala ooththeketa.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">Oro 7:15-23</ref></char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>Intte Ayanan dizayta gidikko wogas haarettizayta gidekketa.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>Asho oosoy qonccen erettees; hessika laymateth, tunateth, layma kaas, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>Eeqas goyno, bita, ixeteth, oosh, qanaateteth, hanqo, bana xalla doso, shaaketeth, zuppeteth, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>miqqayneteth, maththoteth, alame mazamure yexeththinne heytantta misatizayta. Tani inttes kase yootida mala ha7ikka intte naagettana mala qofsays; hessa mala duus dizayti wurikka Xoossa kawoteth laattettenna.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Ayana ayfey gidikko siiqo, ufays, saroteth, dandaya, kiyateth, lo7eteth, ammaneteth, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ashketeth, barkka bana haaro; haytantta mala diggiza wogay baa. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>Yesus Kirstoosas gididayti asho iza iita qofaaranne iza iita amoteththaara issife kaqqida. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>Nu Ayanan daana koykko ane Ayanan simerettoos. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>Nuni issoy issaa iitas denththeththishenne qanaatettishe coo mela ceeqettizayssa ane aggoos.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">As Ubbaas Lo7o Ooso</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>Ta ishatoo! Issi asi nagara ooththi beettiko intte qasse Ayanan lo7o dizayti iza ashketeththara zaaranaas bessees; gido attiin nekka izaade mala paacettontta mala ne hu7es naagetta. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>Intte issoy issaa deexo tooho tookkite; hessa mala ooson Kirstoosa wogaa poleeta. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>Issaadey aykkoka hanontta dishe bana gitasizaa misatikko hessaadey barkka bana baleththees. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>Issi issi asi ba ooso barkka paacci xeello; hessafe guye hara asara bana ginasontta dishe izi bana ceeqisizaaz demmana. <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>Issi issi asi barkka ba tooho tookkanaas bessees.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Qaala tamaarzay oonikka ba tamaarda lo7o miishshaa ba astamaarezara gishetto.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>Balettofte; Xoossi qilcca erenna; asi ba zeridaaro izo zaari maxana. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>Ba asho amo kunththanaas zerizaadey ashoppe dhayo maxana; Ayana ufayssanaas zeridaadey gidikko ayanappe mernaa de7o maxana. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>Ane nu lo7o ooso ooththanaas azalloko; nu ufays qanxxontta aggiko wodey gakkishin gakkida kath nu maxana. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>Hessa gishshas nuus dandayettiko asa ubbaas harappeka ammaniza asaas ane lo7o ooththoos.<verse eid="GAL 6:10"/></para>
  <para style="s1">Wurseththa Zorenne Saroka</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Tani ta kushera inttes ay mala gita pidalen xaafidaakko ane xeellite. <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>Coo kare baggara beettana koyza asati intte qaxxarettana mala wolqqaththana koyeettes; istti hessa ooththizay Kirstoosa masqale gishshas giidi goodettontta malassa. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>Istti intte qaxxarettana mala koyzay intte ashon ceeqettanaas koyza gishshas attiin qaxxarettidayti wogaa naagizayta gidettenna. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>Qasse alamey taas, tanikka alames kaqettida Godaa Yesus Kirstoosa masqalenppe attiin haran ceeqoy taappe haakko. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>Qaxxarettiin woykko qaxxarettontta aggiin izas go7ay baa; go7ay ooraththa medheteth gideththa. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Hayssa ha azazoza kaalliza ubbatassinne Xoossa dere gidida Isra7eele asatas saroteththinne maareteththi gido.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>Tani Yesusa malaata ta asateththan tookkadis; hessa gishshas ha7i tana oonikka waayisenna.<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>Ta ishatoo! Godaa Yesus Kirstoosa aadho kiyateththi inttenara gido! Amiin.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
