<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gamo Full Bible final version</book>
  <para style="h">Yaaqoobe Kiita</para>
  <para style="toc1">Yaaqoobey Xaafida Kiita</para>
  <para style="toc2">Yaaqoobe Kiita</para>
  <para style="toc3">Yaaqo</para>
  <para style="mt1">Yaaqoobey</para>
  <para style="mt2">Xaafida Kiita</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Hayssi Yaaqoobe kiitazi asi hach hach daana duussa gishshas yootizaaz gidishin izi xaafettiday dumma dumma deren laaletti diza tammanne nam7u Isra7eele zarkketassa; hessa xaafidaadey nuni nu erateth ooson peyshshana oge gishshas ammaniza asa moko gishshassinne amale lo7eththana oge bessiza yo7ota qonccisiza haasayata leemisora bessees. Manqoteththa gishshas, paace gishshas, lo7o amale gishshas, qanggeteththa gishshas, ammano gishshassinne lo7o ooso gishshas inxarsa iitateththaa gishshassinne lo7eteththa gishshas, aadho erateththa gishshas issoy issaara ooshsha gishshas, otoreteththa gishshassinne ashketeththa gishshas, hara asa bolla pirda gishshas, ceeqeteththa gishshas, dandaya gishshassinne woosa gishshas, ammanizayti ooththanaas bessiza miishshata hu7en hu7en xaafides.</para>
  <para style="ip">Ha kiitazi ammanoy ammano duussan oosettana bessiza ogeta lo7eththi qonccisees.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">Ammanonne aadho erateth <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Manqoteththinne dureteth <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">Paace <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">Xoossa qaala siyidi ooson peysho <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">Ogey baynda maado maaddontta mala imettida qofso <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Ammanonne ooso <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">Ammanizaadenne iza haasaya <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">Ammanizaadenne hayssa ha alameza <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Dumma dumma hanota gishshas imettida zore <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Xoossa oosanchchanne Yesus Kirstoosa oosanchcha gidida Yaaqoobeppe biitta bolla laalettida tammanne nam7u kochchatas saroteththi inttes gido.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Mato 13:55</ref>; <ref loc="MRK 6:3">Mar 6:3</ref>; <ref loc="ACT 15:13">Hawa 15:13</ref>; <ref loc="GAL 1:19">Gala 1:19</ref></char></note><verse eid="JAS 1:1" /></para>
  <para style="s1">Metonne Paace</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Ta ishatoo! Intte bolla dumma dumma waayey gakkiko hessa wursi ufayssan qoodite. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />Gaasoykka intte ammano paaceteththi inttes dandaya immizayssa intte ereeta. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Intte dandayan minni eqqanayssi inttes issi miishshika paccontta kumeththa asinne wosoy bayndayta gidana mala ooththo. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Intte giddofe oonaska erateththi pacciko oonakka leqqontta ba kiyateththaara ubbaas immiza Xoossaa woosso; izaadeska imettana. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Gido attiin sidhey baynda ammanon woosso; gaasoykka sidhizaadey abba qaaththiza dambala carko mala. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Hessaadey Godaappe aykkoka demmana giidi qoppofo. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />Hessaadey nam7u qofan oykettidi ba biza oge bolla yaanne haa giza asa mala.<verse eid="JAS 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Kase ziqqa duussan dizaade Xoossi dhoqqu histtana gishshas ufayetto. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Asa dureteththi maata ciishsha mala qokkana gishshas duussan dhoqqu gidaadey Xoossi iza ziqqi histtiko ufayetto. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Arshey xuuggidi maata shullisees; maata ciishshayka shullees; iza lo7eteththika dhayees; hessaththoka durey hach hach daabursan dishin iza dureteththi dhayees.<verse eid="JAS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Paacen minni eqqidaadey izi anjjettidaade; gaasoykka izi paacera eqettishin Xoossi bana dosizaytas immida hidota de7o akilile izi ekkana. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Oonikka paacettizaa gidikko tana Xoossi paaccees gooppo; gaasoykka Xoossi ase iitan paaccenna; izi oonakka paacci erenna. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Gido attiin issi issi asi paacettizay barkka ba iita amo kaallishenne balettishe paacettees. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Amoy qanththatidi nagara yelees; nagaraykka diccidaappe guye hayqo yelees.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Ta siiqo ishatoo! Intte balettofte. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Lo7o imoteththinne kumeththa anjjoy wuri bolla salo poo7ota Aawappe wodhdheettes; iza achchan yaanne haa yuuyiza eeshoykka deenna. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Nu iza medheteththaas koyro bayrata gidana mala ba sheneninne ba tuma qaalaan nuna yelides.<verse eid="JAS 1:18" /></para>
  <para style="s1">Siyidayssa Ooso</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Dosettida ta ishatoo! Hayssa yuushshi qopite; asi wurikka siyanaas eesoto; haasayassinne hanqos eesotoppo. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Asa hanqoy Xoossa xilloteth ooththenna. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Hessa gishshas tunateththinne dalgida iitateththi inttefe kessi yeggidi intte shemppo ashshanaas dandayza intte giddon tokettida qaalaa ashketeththara ekkite.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Qaalay gizayssa ooththite attiin mela sis xalla siyizaadentta gididi intterkka inttena baleththofte. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Qaalaa siyishe siyida qaalay gizayssa ooththonttaadey ba ayfeso mastootera xeelliza asa mala. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />Bana xeelli be7idi bees; izi ay misatizaakko heerakka balettichchees. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Gido attiin bana geeshshiza lo7o wogaa xeelli be7idi izan minnizaadey ba siyidayssa ooththizaadeynne balonttaadey izi ba ooson anjjettidaade gidana.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Ba doona naagontta barkka ba wozina baleththishe ta ammanays gizaadey barkka bana baleththees; iza ammanoykka hada ammano. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Xoossaa Aawaa sinththan iitateththi baynda lo7o ammanoy aayanne aaway hayqqida nayta, istta azinati hayqqida maccassata metotettishin maadonne hayssa alameza tunateththaafe bana naago.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s1">Ogey Baynda Maado Koshshenna</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Ta ishatoo! Intte bonchchettida Godaa Yesus Kirstoosa ammanizayta gidida mala ase bessontta ogera maaddofte. <verse eid="JAS 2:1" /><verse number="2-3" style="v" sid="JAS 2:2-3" />Worqqa yiich biradhdhen aaththidi lo7o may7o may7ida asi intte shiiqizaso yiikko hessaththoka qita may7o may7idaadey he shiiqizasoza yiikko qasseka hara qita may7o may7ida manqo asi gelikko lo7o may7idayssa dumma bonchcho bonchchidi, «Nees bessiza lo7o uttizaso hessa beya» giidi hankko manqoza qasse, «Ne heen hessan eqqa; woykko haa ya; ta garsan wugen utta» intte giikko, <verse eid="JAS 2:2-3" /><verse number="4" style="v" sid="JAS 2:4" />intte intte giddon bessontta maado ooththeeta gidekketii? Qasseka intte iita qofan oykettida iita pirda pirdizayta gidekketii?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Ta siiqo ishatoo! Ane siyite; istti ammanon dureta gidana mala Xoossi bana dosizaytas hidota isttas immida kawoteththaa istti laattana mala hayssa ha alamezan diza manqota dooribeennee? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Intte qasse manqota kawushsheeta; inttena waayisizay dureta gidettennee? Inttena pirdaso goochchizay istta gidettennee? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Inttenan xeygettida bonchcho Xoossaa sunth zigirzayti istta gidettennee?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Geeshsha Maxaafan, «Ne lagge ne hu7e mala siiqa» geetetti xaafettida kawo wogaa intte polikko lo7o ooththeeta. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Intte bessontta maado maaddiko nagara ooththeeta; wogaa sinththankka intte woga yedhdhidaade gidi qoodettana. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Gaasoykka wogaa ubbaa polizaadey qasseka wogappe issineyn dhuphettiza asi ubbaaka mooridaade mala qoodettees. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />«Laymatoppa» gidaadey izikka zaaridi, «Wodhoppa» gides. Ne laymatontta aggikokka neni as wodhikko wogappe aadhdhidaade gidaasa.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Kessa 20:13-14</ref>; <ref loc="DEU 5:17-18">Zaare 5:17-18</ref></char></note> <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Intte haasaya haasayshe woykko issi miish ooththishe inttena xillisiza asa mala gidite. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Gaasoykka maaronttay wurikka maaroy baynda pirdettana; maaroy pirda Xoonees.<verse eid="JAS 2:13" /></para>
  <para style="s1">Ammanonne Ooso</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Ta ishatoo! Issi asi taas ammanoy dees giikko qasse ooson bessonttaade gidikko iza ay maaddanee? Hessa mala ammanoy iza ashshanee? <verse eid="JAS 2:14" /><verse number="15-16" style="v" sid="JAS 2:15-16" />Ane qopite; issi ishay woykko issi michchiya may7oy woykko mizayssi baynda aggiko inttefe issaadey, «Intte saron biite! Inttena meeggofo! Kallite!» giikko istta ashos koshshizayssa immontta aggiko ay maaddanee? <verse eid="JAS 2:15-16" /><verse number="17" style="v" sid="JAS 2:17" />Hessaththoka oosoy baynda ammanoykka baas hayqqidayssa.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Gido attiin issaadey, «Taas oosoy dees; nees ammanoy dees; neni ne ammano oosoppe shaakkada tana bessa; ta qasse ta ammano ooson nena bessana» giikko <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />ne, «Issi Xoossi dizayssa ammanaasa» hessika lo7o; daydanththatikka hessa mala ammaneettessinne keehi kokkoreettes. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Nenoo eeyazoo! Oosoy baynda ammanos go7ay bayndayssa eranaas markka koyay? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Nu aawaa Abrahaamey ba naa Yisaaqa yarshizasoza bolla shiishshida wode ooson xillibeennee?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medhe 22:1-14</ref></char></note> <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Hessan ba ammanoza oosora gaththi ooththizayssa ne beyaasa; ammanoykka ooson polettides. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />«Abrahaamey Xoos ammanides; he ammanoy izas xilloteththan qoodettides» giza maxaafaa qaalay polettides; izikka Xoossi dosidaade geetettides.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe 15:6</ref>; <ref loc="2CH 20:7">2Taari 20:7</ref>; <ref loc="ISA 41:8">Isa 41:8</ref></char></note> <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Hessa gishshas asi ammanon xalla gidontta oosonkka xillizayssa intte beyeeta.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Hessaththoka layman diza Era7aaba kiitetti bida asata mokka ekkada hara ogera moyza yeddida gishshas ba ooson xillabeekkee?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1">Iya 2:1</ref></char></note> <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Shemppofe shaakettida ashoy hayqeth gidida mala oosoppeka shaakettida ammanoy hayqeththa.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s1">Ba Doona Naago</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Ta ishatoo! Inttefe daroti astamaareta gidoppetto; gaasoykka nu astamaare gididayti aadheththa pirda ekkanayssa intte ereeta. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Nu wurikka daro miishshan dhuphettoos. Haasayan dhuphettonttaadey diikko izi ba asateth lo7eththi naaganaas dandayza kumeththa asa. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Nuni parata azazanaas bixala barsidi nu koyida mala istta azazoos. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Woykko ane markabeta xeellite; istti ay gitatanne carkon sugetti bizayta gidikkoka markabe laaggizaadey qeeri laafa laaggiza miishshara ba koyzaso efees. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Hessaththoka asateththa garsan inxarsi guuth gida uttada gita wolqqama otoro otorettawus; qeeri tamay gita wora wostti xuuggi dhayssizaakko ane yuushshi qopite. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Inxarsika ba baggara tama mala; qasse nu asateththaa giddon diza iita alame. Asateththaa wursa tunisawussinne asateththaa bolla tama gujjawus; baaska gaanname taman xuugettana.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />Mehe, do7a, kafota, biitta bolla gooshettizaytanne abba giddon diza medheteththata ubbaa asi haarana dandayees; isttika haarettida. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Gido attiin inxars haaranaas dandaydaadey oonikka deenna; wodhiza marzey izin kumidaaronne iza shempa ekkontta iita miishsha. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />Nuni nu inxarsayra Godaanne Aawaa anjjoos; izinkka Xoossa leemison medhettida asa nayta zaaridi qanggoos.<note caller="-" style="x"><char style="xo" closed="false">3:9,10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe 1:26</ref></char></note> <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Anjjoynne qanggeththi issi doonara kezees. Ta ishatoo! Hessi hessaththo hananaas bessenna. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Issi pultto ollafe mal7o haaththinne camo haaththi pultti erizee? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Ta ishatoo! Balase geetettiza miththi wogara ayfe woykko woyne miththi balase miththa ayfe ayfanaas dandayzee? Hessaththoka cammiza haaththafe mal7iza haaththi beettana dandayenna.<verse eid="JAS 3:12" /></para>
  <para style="s1">Nam7u Qommo Erateth</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Intte garsafe akeekara diza era asi oonee? Eray dizaa gidikko ane ba ooso ashketeththaninne aadho erateththara ba lo7o duussan besso. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Qasse camonne qanaatey, inttena xalla dosiza hanoy intte wozinan dizaa gidikko otoreteththi inttes siyettofo; tumaakka kaddofte. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Hinni mala erateththaya saloppe gidikku; hinna qasse biittafe, ashoppenne Xala7eppeko! <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Qanaateynne barkka bana siiqoy dizason waasoynne iita oosoy wuri dees.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />Saloppe gidida erateththaya gidikko koyro geeshsha; guyeppeka saroteth dosizaaro, dandayzaaro, ero gizaaro, maaroteththinne lo7o ayfey kumidaaro; qasse wordo maaddonttaaronne ulon geney bayndaaro. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Saroteth dosiza asati saroteth zeridi xilloteththa ayfe maxeettes.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s1">Inttenateththaa Xoossas Haarisite</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Intte giddon diza olaynne ooshshi awappe yidee? Intte wozinan diza amoteththaafe dendida ola gidennee? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Intte amotteeta shin demmeketa; intte as wodheetanne keehi amotteeta shin demmana dandayekketa; intte intte garsan ooyettiza gishshassanne olettiza gishshas qasse woossontta gishshas inttes imettenna. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Intte intte asho ufayssanaas iita qofan woossiza gishshas woossidayssa intte ekkeketa. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Intteno laymatizaytoo! Alamera siiqeteththi Xoossara morkketeth gididayssa erekketii? Hessa gishshas hayssa alamezara siiqeteth koyzay wurikka Xoossas morkke. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Woykko Geeshsha Maxaafa giddon, «Nunan izi ayssida Ayanay nu izayta gidana mala daro amottees» gizayssi inttes coo mela gidaa misatizee? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Gido attiin izi ba kiyateth nuus gujji immees; Maxaafaykka, «Xoossi otoranchchatara eqettees; ashketas gidikko ba kiyateth immees» giday hessassa.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Leemi 3:34</ref></char></note><verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Hessa gishshas inttena Xoossas haarisite; Daabulosara eqettite; izi inttefe baqatana. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Xoossako shiiqite; izikka intteko shiiqana; intteno nagaranchchatoo! Intte intte kushe geeshshite; intteno nam7u qofan qaaxxizaytoo! Intte intte wozina geeshshite. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Darssi qopite; muuzottite; yeekkite; intte miichchay yeehon, ufayssay qasse muuzoteththan simmo. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Godaa sinththan intte inttena kawushshite; izi inttena dhoqqu dhoqqu histtana.<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Ta ishatoo! Intte intte garsan issoy issaa mootopite; ba ishaa mootizaadeynne ba ishaa bolla pirdizaadey wogaa bolla iita haasayeessinne wogaa bolla pirdees; histtiko neni wogaa bolla pirdizaade attiin wogaa naagizaade gidakka. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Woga woththidaadeynne pirdizaadey issaade xalla; izikka dhayssanaassinne ashshanaas dandayzaade; gido attiin ne lagge bolla pirdizaadey ne oonee?<verse eid="JAS 4:12" /></para>
  <para style="s1">Ceeqettanaas Bessenna</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />«Intte hach woykko wonto hanno ha katamayo woykko hinno he katamayo nu baana; histtidi heen izin issi layth uttananne zal7i wodhisana» gizaytoo! Ane haa siyite. <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Wonto hananayssa intte erekketa; intte shemppoy iza aazee? Intte guuththa wode ayfen beettidi dhayza haaththa pentta mala. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Hessa gaanaappe, «Godaa shene gidikkonne nu paxa diikko hessaka hayssaka ooththana» gaanaas inttes bessees. <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Ha7i gidikko intte otoreteththan ceeqetteeta; hessa mala otoreteththi wurikka iita. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Hessa gishshas lo7o gidizayssa ooththanaas bessizayssa erishe ooththonttaades nagara gidana.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s1">Duretas Imettida Zore</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Histtiko intteno dure asatoo! Ane siyite. Buro intte bolla gakkana metoza gishshas yeekkite; «Wu! Wuy» gi waassite. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Intte haaroy buuqqides; intte may7oka bilay mides. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Intte worqqaynne intte biray shiydes; he shiydayssika intte bolla markkatteessinne intte asho tama mala xuuggees; wode wurseththas miishshe intte shiishshideta. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Intte intte wozinan woththite; intte kath maxishe peydaytas istta wolqqa waagaa intte qanxxontta aggida gishshas intte bolla waassishe intte achchan deettes. Kath maxizayta waasoy ubba dandayza Godaa hayththan gakkides.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Zaare 24:14-15</ref></char></note> <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Intte biitta bolla ishaloninne al7eteththan de7ideta; intte wozina shukas dhiikkida mehe mala modhdhisideta. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Intte inttenara eqettontta xillo asata bolla wordo woththidi wodhideta.<verse eid="JAS 5:6" /></para>
  <para style="s1">Meto Dandayo</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Hessa gishshas ta ishatoo! Goday haa yaana gakkanaas dandayte; goshshe goyizaadey biittay lo7o kaththi kaxxana gakkanaas waani dandayzaakko koyro iranne wurseththa ira izi wostti naagizaakko ane akeekite. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Intteka hessaththo dandayte; intte wozina minththite; gaasoykka Godaa yuussa gallassi matides.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Ta ishatoo! Intte intte giddon zigirettofte; intte zigirettiko intte bolla pirdettana; pirdanaadey hekko intte penge bolla eqqides. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Ta ishatoo! Godaa sunththan inttes yootida nabeta waayeteththinne istta dandayaa inttes leemiso histti xeellite. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Dandayan genccida asata nu istta, «Istti anjjettidayta» gi qoodizayssa intte ereeta. Iyoobi waani dandaydaakko intte iza gishshas siyideta. Goday iza wurseththan ay ooththidaakko intte beyideta; Goday asas keehi mishettizaadenne maarizaade.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyo 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Maza 103:8</ref></char></note><verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Harappeka ta ishatoo! Salon gidiin woykko sa7an gidiin woykko ay miishshankka caaqqofte; «Ee» gaanaas bessiza miish gidikko, «Ee» giite. «Akkay» gaanaas gidikko, «Akkay» giite; hessafe hara giikko intte bolla pirdettana.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Mato 5:34-37</ref></char></note><verse eid="JAS 5:12" /></para>
  <para style="s1">Ammano Woosa</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Intte garsan metotiza asi dizee? Dizaa gidikko izi woosso. Ufayettizaadey dizee? Dizaa gidikko ufayssa mazamure yexxo. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Intte giddon sakettiza asi dizee? Diikko Woosa Keeththa cimata xeygo; isttika Godaa sunththan zayte iza bolla tiydi izas woossetto.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">Mar 6:13</ref></char></note> <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Ammanon woossida woosay hargidaade paththana; Godaykka iza denththana; izi nagara ooththidaade gidikkoka Xoossi iza maarana. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Hessa gishshas intteka intte garsan issoy issaara intte nagara paaxettite; paxana mala issoy issaas woossite; xillo asa woosay wolqqara dees; wolqqama oosokka ooththees. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Eelaasi nu malakka asa; izi iray bukkontta mala minththi woossiin biitta bolla heedzdzu layththinne bagga gakkanaas iray bukkibeenna.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1Kawo 17:1</ref>; <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Qasseka zaari woossiin iray saloppe biitta bolla bukkides; biittayka kath immides.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1Kawo 18:42-45</ref></char></note><verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19-20" style="v" sid="JAS 5:19-20" />Ta ishatoo! Inttefe issaadey tumappe balettiin hara asi iza zaarikko hessa wozinan woththite; nagaranchcha izi balettida ogeppe zaaridaadey hessaade shemppo hayqoppe ashsheessinne izaade nagara darozakka kammees.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Leemi 10:12</ref>; <ref loc="1PE 4:8">1Phex 4:8</ref></char></note><verse eid="JAS 5:19-20" /></para>
  <chapter eid="JAS 5" />
</usx>