<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Gamo Full Bible final version</book>
  <para style="h">2Ximtoosas</para>
  <para style="toc1">Phawuloosi Ximtoosas Xaafida Nam7anththo Kiita</para>
  <para style="toc2">2Ximtoosas</para>
  <para style="toc3">2Xim</para>
  <para style="mt2">Phawuloosi</para>
  <para style="mt1">Ximtoosas</para>
  <para style="mt2">Xaafida Nam7anththo Kiita</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Phawuloosi Ximtoosas xaafida ha nam7anththo kiitay Phawuloosi baas daro maado gidi bana maaddiza ooso lagge gidida naateththa naa Ximtoosas yeddida zore qaala oykkides; Phawuloosi Ximtoosa izi daro dandayan minnana mala zorides; Ximtoosi Phawuloosappe ekkida mino zore qaalay Yesus Kirstoosa gishshas ammanettidi markkattana mala Mishiraachcho qaalaa, kase gal7a caaqo garsan diza timirtezakka minththi oykkana malanne izas aykko waayey darikkoka tamaarsoninne Mishiraachcho qaalaa sabbako aggontta minnana malassa.</para>
  <para style="ip">Ximtoosas imettida mino yo7oy coo mela eeyateththan asay palamettiza yo7oppe izi haakkana malassa; hessa mala yo7oy siyizayta moorees attiin izi immiza hara go7ay deenna.</para>
  <para style="ip">Hayssa ubbaan Ximtoosi yuushshi qoppanaas bessizay Phawuloosi ammanon waani de7idaakko, izi ay mala genccidaakko iza siiqoza, iza minoteththaanne iza bolla gakkida waayeza leemiso izi kaallana malassa. Phawuloosi hayssa ha kiitaa xaafiday ba layththa wurseththan hayqo pirday iza bolla pirdetti uttiin izi hayqo naagiza wodekko. (2Xim 4:6-8)</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">Ximtoosas imettida zore <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref> </char></para>
  <para style="io1">Asay kaddiza wode minni eqo <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref> </char></para>
  <para style="io1">He wode diza hanotanne heyta gishshas imettida zoreta <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref> </char></para>
  <para style="io1">Kuushsha qofa <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Yesus Kirstoosara issifeteththan diza de7o hidota qaala gishshas yootana mala Xoossa shenen Yesus Kirstoosa Hawaare gidida Phawuloosappe, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />dosettida ta naa Ximtoosas kiyateththi, maaroteththinne saroteththi Xoossaa Aawappe Godaa Yesus Kirstoosappe nees gido.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Hawa 16:1</ref></char></note><verse eid="2TI 1:2" /></para>
  <para style="s1">Ximtoosas Imettida Zore</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Pacey baynda gallassinne qamma ne gishshas woosan qofsashe kase Aawati ooththida mala geeshsha wozinara ta goynniza Xoossaa ta galatays. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Kase ne afunththaa qoppa ekkada ta nena beyada ufayettana laamotays. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />Qoodheppe qommon gidontta ne ammanoza ta qoppays; he ammanoykka koyro ne aayey aayin Loydininne qasseka ne aayeyin Ewonqen dees; ha7i qasse ne bolla dizayssaka ta eradis.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Hawa 16:1</ref></char></note> <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Hessa gishshas tani ta kushe ne bolla woththiin ne ekkidayssa ne bolla diza Xoossa imotaa ne denththeththana mala ta nena qofsays. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Xoossi nuus nuni nu hu7e haaranaas Xoossa wolqqa eranaassinne siiqettana Ayana immides attiin babo ayana immibeenna.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Hessa gishshas Godaa gishshas markkattanaas woykko Godaa gishshas qashettida tanan yeellatoppa; gido attiin Xoossa wolqqara mishiraachcho qaalaa gishshas ne tanara meto ekka. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Nu aykkoka ooththida gishshas gidontta dishin ba qofaa malanne ba kiyateththaa mala nuna ashshidessinne nuna baas dummasidi xeygides. He iza kiyateththi mernaa wodeppe kase Yesus Kirstoosa baggara nuus imettides. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Ha7i qasse izi hayqo ubbaa dhayssidi mishiraachcho qaalaa baggara nuna poo7on kessida nu dhale Yesus Kirstoosa yuussaan qonccides.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Tanikka hayssa ha mishiraachcho qaalaa yootizaade, kiitettidaadenne astamaare gidada shuumettadis.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1Xim 2:7</ref></char></note> <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Tani meto be7izaykka hessa gishshassa; gidikkoka ta oona ammanizaakko tani ta ammanizaade shaakka eriza gishshas izan yeellatikke. Ta izas immida hadaraa he gallassiya gakkanaas izi naaganaas dandayzayssa ta shaakka eradis.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Ne taappe siyida timirteza Yesus Kirstoosara issifeteththan diza ammanoninne siiqon leemiso histta oykka. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Nees imettida lo7o hadaraa nunan diza Xillo Ayanan naaga. <verse eid="2TI 1:14" /><verse number="15" style="v" sid="2TI 1:15" />Iisiya awuraajja giddon dizayti wurikka tana aggidayssa ne eraasa; Filgoosinne Hermogeneesi tana aggida asaara deettes. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />Henesifoore soo asaa Goday maaro; ays giikko izi tana daro wode minththeththidessinne tani sansalatan qashetta dishin tana be7idi yeellatibeenna. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />Harappeka izi Oroome yida wode tana koyi koyidi demmides. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Wurseththa pirda gallas Goday iza pirdafe ashsho; izi tana Efesoonen ay mala maaddidaakko ne lo7eththa eraasa.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Hessa gishshas ta naazoo neni Godaa Yesus Kirstoosa kiyateththan minna. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Daro markkatta sinththan ne taappe siyidayssa harata tamaarsanaas dandayzaytassinne ammanettida asatas hadara imma.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Yesus Kirstoosas ammanettida lo7o wottadara mala tanara meto ekka. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Wottadarateththan ooththizaadey ba halaqaa ufayssanaas dafettees attiin hara bana qaxeththiza ooson geli erenna. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Hessaththoka gaadde woxxizaadey woththa woga naagontta woxxiko xoono akilile ekkenna. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Gooba goshshanchchay ba goyi kessida kaththa xeera mizaade gidanaas bessees. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Ta nees gizayssa ne wozinan woththa siyikko Goday nees yo7o ubbaan akeeka immana.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Hayqoppe dendida Dawite zereth gidida Yesus Kirstoosa qoppa; ta yootiza mishiraachcho qaalaykka hessa. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Hessa gaason iita ooththida asa mala qashettana gakkanaas waaye beyays; gido attiin Xoossa qaalay qashettenna. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Hessa gishshas Kirstoosa baggara diza atoteththinne mernaa bonchcho demmana doorettidayta gishshas gaada wursaka dandayadis.<verse eid="2TI 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2TI 2:11" />«Nu izara issife hayqqiko</para>
  <para style="q2" vid="2TI 2:11">nu izara de7on daana.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Dandayan minniko</para>
  <para style="q2" vid="2TI 2:12">nu izara kawotana.</para>
  <para style="q2" vid="2TI 2:12">Nu iza kaddiko</para>
  <para style="q2" vid="2TI 2:12">izikka nuna kaddana.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">Mato 10:33</ref>; <ref loc="LUK 12:9">Luqa 12:9</ref></char></note><verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Nu izas ammanettonttayta gidikko</para>
  <para style="q2" vid="2TI 2:13">izi mernaas</para>
  <para style="q2" vid="2TI 2:13">ammanettida mala daana.</para>
  <para style="q2" vid="2TI 2:13">Izi barkka bana</para>
  <para style="q2" vid="2TI 2:13">kaddana dandayenna»</para>
  <para style="m" vid="2TI 2:13">geetettida qaalay ammanettidayssa.<verse eid="2TI 2:13" /></para>
  <para style="s1">Mino Oosanchcha</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Hayta ha yo7ota gishshas asaa qofso aggofa; asay ba giddon issoy issaara qaalaa gaason palamettontta mala Xoossa sunththan zora; hessa mala yo7oy siyizayta moorees. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Tumu Xoossaa qaala yootizaade, yeellachchontta oosanchchanne asi ne gishshas lo7o markkattizaade gidada nenateththaa wursa Xoossa sinth shiishshanaas minna. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Coo mela doona lallabeteththafe haakka; hessa mala yo7on waaxettida asati Xoossafe haakki haakki beettes. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Istta timirtey sakkidi paxontta gede gujji gujji daaketti biza madunththa mala; Hemenewoosinne Qasse Filxoosa geetettizayti hessa mala timirte tamaarzayta giddon deettes. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Heyti tumateththafe haakkidi coo mela waayeettes; isttika, «Hayqoppe denththi hayssafe kase hani aadhdhides» giidi issi issi asaa ammano shiri yeggeettes.<verse eid="2TI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19" />Gido attiin, «Goday baas gidizayta erees.» Qasseka, «Godaa sunth xeygizay wuri iitappe haakko» giza maatamey iza bolla diza laamettontta Xoossaa yochchay laamettibeenna.<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Issi gita keeththan worqqafenne birappe xalla gidontta miththafenne urqqafe oosettidayti dizayssaththo heytanttafekka baggayti bonchcho oosos, baggayti qasse hiraysso oosos eketteettes. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Hessa gishshas oonikka hayta ta gida iita yo7otappe bana geeshshiko; hessaadey bonchcho oosos gidizaadenne anjjettidaade; Godaa go7izaadenne lo7o oosos giigettidaade gidana.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Panththateththa iita amoteththafe baqata; geeshsha wozinara Godaa xeygiza asatara xilloteth, ammano, siiqonne saroteth kaalla.<verse eid="2TI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23" />Go7aynne hidotay baynda eeyata palamappe haakka; gaasoykka hessantta malay oosh kaaleththizayssa ne eraasa. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Godaa oosanchchay asara ooyettanaas bessenna; hessafe bollara asa ubbaa achchan kiya, as tamaarsanaas dandayzaadenne mino as gidanaas bessees. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />Izi banara eqettiza asata ashketeththara oykkizaade gidanaas bessees; oonee erizay istti tumaa erana mala Xoossi isttas maarettanaas wode immana dandayees. <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />Hessika istti yuushshi qoppi simmidi iza shene kunththana mala istta di7i efida Xala7e narxafe istti kessi ekkana.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">Wurseththa Woden Yaana Metota</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Gido attiin wode wurseththan as metiza wodey yaanayssa ne era. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Asay bana dosizaade gidana; miish siiqizayta, banan ceeqettizayta, otoranchchata, cashshanchchata, bana yelidaytas azazettonttayta, galatonttaytanne geeshshateththi bayndayta, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />siiqoy bayndayta, atto gi maaronttayta, asa sunth moorizayta, barkka bana haaronttayta, menxe iitata, lo7o miish dosonttayta, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />kaddizayta, naagettonttayta, coo mela otoreteththan kumidayta, Xoossafe aaththidi lo7o deeth dosizayta gidana. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />Ammaniza as misatana shin ammanos diza wolqqaa kaddana; heyta malatappe ne haakka.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Heytantti issi issi keeththe kalxi gelidi daro deexo nagaraninne dumma dumma iita amoteththa gars gelidi yaanne haa qaaxxiza ammanon laafa maccassata qaxi oykkeettes. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Heyta mala maccassati ubba wode tamaareettes shin tumaa erettenna. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Iyaneessinne Iyanbaraasi Muse bolla dendida mala haytikka istta qofay moorettiin baas ammanoppe kundida gishshas tumateth ixxeettes.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">Kessa 7:11</ref></char></note> <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Gido attiin istta qofay kumenna; gaasoykka Iyaneesanne Iyanbaraasa eeyateththi asaas qonccida malakka hayta hanoykka ubbaas qonccana.<verse eid="2TI 3:9" /></para>
  <para style="s1">Phawuloosi Ximtoosas Immida Hadara</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Ne gidikko ta timirteza, ta duussaa, ta waanna qofaa, ta ammanoza, ta dandayaa, ta siiqozanne ta minoteththaa ubbaa eraasa. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />Ta goodeteththaanne ta waayeza Anxokiyan, Iqoniyooninne Listtirankka ta bolla gakkidayssa ubbaa tani dandayan ekkidayssa ne eraasa; gidikkoka Goday hessa ubbaafe tana ashshides.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">Hawa 13:14-52</ref>; <ref loc="ACT 14:1-20">14:1-20</ref></char></note> <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Tumappe Yesus Kirstoosa geeshsha wozinappe ammani daana gizayti wurikka goodettizayta gidana. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Iita gidida baleththiza asati baas balettidi asaa baleththishe iitateththaa bolla iitateth gujji gujji baana.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Ne gidikko kase ne tamaarada erida ogen minna; hessa oonappe tamaardaakko ne eraasa. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />Ne guuththa naateththafe ha7i gakkanaas Yesus Kirstoosa ammanon atoteththi beettiza timirte immiza Geeshsha Maxaafata lo7eththa eradasa. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Geeshsha Maxaafati wurikka Xoossa Ayanay kaaleththiin xaafettidayta; isttika as tamaarsanaas, hanqanaas, suurisanaas qasseka xilloteththa ogen kaaleththanaas go7eettes. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />Hessika Xoossa asi lo7o ooso ubbaas bessizaade gidana malassa.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Xoossa sinththaninne hessaththoka paxa dizayta bollanne hayqqidayta bolla pirdanaas diza Yesus Kirstoosa sinththan iza qoncceththaanne iza kawoteththaa qofara hayssa nees hadara gays. <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Qaalaa sabbaka; nees giigiin woykko giigontta aggiin neni ne baggara giigetta utta; daro dandayara tamaarson asaa suurisa; hanqanne zora. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Gaasoykka asay wuri suure gidida timirte ekkontta ixxana wodey yaana; hessafe bollara asay ba amora gaaggizayssa istta hayththi siyana koyzayssa xalla isttas yootana mala bana tamaarsana daro astamaareta ba ach shiishshana. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Tumaa siyanaappe ba hayth haraso zaaridi haysi7e bagga simmana. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Neni gidikko haniza yo7o ubbaan loddu ga; meto dandaya; mishiraachcho qaalaa yooto nees ooso histta; ne oosozakka pola.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Ta qasse yarshettanaas mata uttadis; hayssa ha alamezappe shaaketta buussa wodey taas gakkides. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Lo7o baaxe ta baaxetadis; ta woxxana woth wursadis; ammanokka naagadis. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Sinththafe taas akililey giigi uttides; hessika xilloteththa; hessaka tumu pirdiza Goday he gallas taas immana; hessika taas xalla gidontta iza yuussaa laamotizaytas ubbaasikka immana.<verse eid="2TI 4:8" /></para>
  <para style="s1">Phawuloosi Azazida Wurseththa Azazo</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Taakko elela yaanaas nees dandayettida mala ooththa. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Deemaasi hayssa alameza siiqidi tana yeggi aggidi Tasolonqe bides. Qarqisi Galatiya bides; Titoosi gede Dalmaaxiya bides.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">Qola 4:14</ref>; <ref loc="PHM 1:24">Pilm 24</ref>; <ref loc="2CO 8:23">2Qoro 8:23</ref>; <ref loc="GAL 2:3">Gala 2:3</ref>; <ref loc="TIT 1:4">Tito 1:4</ref></char></note> <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Luqaasi xalla tanara dees; Marqoosi tana ooson maaddiza gishshas iza nenara ekka ya.<note caller="-" style="x"><char style="xo" closed="false">4:11</char><char style="xt" closed="false"><ref loc="COL 4:14">Qola 4:14</ref>; <ref loc="PHM 1:24">Pilm 24</ref>; <ref loc="ACT 12:12">Hawa 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Qola 4:10</ref>; <ref loc="PHM 1:24">Pilm 24</ref></char></note> <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Tiqiqoosa Efesoone yeddadis.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="EPH 6:21-22">Efe 6:21-22</ref>; <ref loc="COL 4:7-8">Qola 4:7-8</ref></char></note> <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Ne haa yashe ta Xiro7aadan Karpuse achchan woththida ta Maaqanne maxaafata harappeka galban xaafettida maxaafata taas ekka ya.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">Hawa 20:6</ref></char></note><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Xarqimala qoxxiza Iskindiroosi ta bolla daro qoho gaththides shin Goday izas iza ooso mala immana.<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1Xim 1:20</ref>; <ref loc="PSA 62:12">Maza 62:12</ref>; <ref loc="ROM 2:6">Oro 2:6</ref></char></note> <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Izi nu yootiza qaalaa keehi ixxides; nekka izappe naagetta.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Tana mootiza yo7ozas koyro tana ashshana markka ta shiishshiin oonikka tana maaddana yibeenna; gido attiin wurikka tana yeggidi bida. Hessaka istta bolla Xoossi qoho histti qoodoppo. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Gido attiin qaalaa kiitay ta baggara kumeth yootettana malanne dere asay wuri siyana mala Goday ta achchan eqqidi tana minththides; Gaammo doonappeka tana ashshides. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Goday iita yo7o ubbaafe tana ashshana; gede ba salo kawoteththas tana sarora gaththana; izas mernaappe mernaa gakkanaas bonchchoy gido. Amiin.<verse eid="2TI 4:18" /></para>
  <para style="s1">Wurseththa Saroka</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Phirsiqillas, Aqilas, Henesifoore soo asaasikka ta sarokaa gaththa.<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Hawa 18:2</ref>; <ref loc="2TI 1:16-17">2Xim 1:16-17</ref></char></note> <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erisxoosi Qorontoosen attides; Xirofomoosi sakettida gishshas iza ta Miliixen aggadis.<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">Hawa 19:22</ref>; <ref loc="ROM 16:23">Oro 16:23</ref>; <ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="ACT 21:29">21:29</ref></char></note> <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Balgoy gakkanaappe sinththetada taakko haa gakkanaas nees dandayettida mala ooththa. Ewuguloosi, Phudeesi, qasseka Linoosi, Qilawudiyaynne ammanizayti wurikka nena saro saro gida. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />Goday nenara gido; Godaa kiyateththi inttenara gido.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>