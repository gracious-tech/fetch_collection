<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Gamo Full Bible final version</book>
  <para style="h">Eranchchata Maxaafa</para>
  <para style="toc1">Eranchchata Maxaafa</para>
  <para style="toc2">Eranchchata Maxaafa</para>
  <para style="toc3">Era</para>
  <para style="mt1">Eranchchata Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Eranchchata maxaafan xaafettiday biitta bolla asa duussi qaanth gidoyssafekka bollara daro metoy, qaxa pirdaynne daaburay kumidayssa erida gishshas «Asa de7oy coo hada» giidi qachchida issi era asa qofata. He eranchchazas asa de7o hanota kaalettiza Xoossa ooso xuuray erettontta ixxides. Gido attiin asi ba diza layth ubbaan, baas dandayettida keena minni ooththana malanne Xoossi asaas immida imotatan asi ufayettana mala bessizayssa zorees. Eranchchaza qofatappe dariza baggay misaton qofaninne hidota qanxxon kumidayta; gido attiin<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="ft" closed="false">Misenna giza qaalaza issi issi baggan xuse gishin hara baggan xussa woykko palqqe geetettees.</char></note> hayssi ha maxaafay Geeshsha Maxaafa garsan beetoy geeshsha maxaafan xaphida ammano haray attoshin hayssa hara dumma qofaynne sidhey izan kumida maxaafaakka gaththi issi bolla oykkana gakkanaas izi aaho gididayssa erisees. Ha maxaafazi asa de7o herega mala bessiza gishshas daro asay hayssa ha maxaafazappe bana minththeththiza miish demmides. Hessaththoka hayta ha qofata bessizay, ha issi geeshsha maxaafay de7os gita birsheth immiza Xoossaan ufays ooththana mala zorizayssa asay erides.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Duussa birsheth <char style="ior"><ref loc="ECC 1:1-2:26">1:1—2:26</ref> </char></para>
  <para style="io1">Ubbaas wodey dees <char style="ior"><ref loc="ECC 3:1-8">3:1-8</ref> </char></para>
  <para style="io1">De7oy ubba wode lo7o gidontta gishshas akeekan duus <char style="ior"><ref loc="ECC 3:9-6:12">3:9—6:12</ref> </char></para>
  <para style="io1">De7oso kaaleththiza oge <char style="ior"><ref loc="ECC 7:1-8:17">7:1—8:17</ref> </char></para>
  <para style="io1">Sinththafe aazi hananaakko erizay deenna <char style="ior"><ref loc="ECC 9:1-11:6">9:1—11:6</ref> </char></para>
  <para style="io1">Xoos bonchchonne izas azazeteth <char style="ior"><ref loc="ECC 11:7-12:14">11:7—12:14</ref> </char></para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s1">Ubbayka Hada</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 1:1"/>Hayssi Dawite naa</para>
  <para style="q2" vid="ECC 1:1">Yerusalaamen kawotida</para>
  <para style="q2" vid="ECC 1:1">eranchchaza qaala.<verse eid="ECC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2"/>He eranchchay,</para>
  <para style="q2" vid="ECC 1:2">«Ubbaa miishshi hada;</para>
  <para style="q2" vid="ECC 1:2">hadappeka aadhdhida hada;</para>
  <para style="q2" vid="ECC 1:2">ubbaa miishshika hada» gees.<verse eid="ECC 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>Alame bolla asa nay</para>
  <para style="q2" vid="ECC 1:3">daaburza daabura ubbaas</para>
  <para style="q2" vid="ECC 1:3">ay wodhey dizee?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>Yeletay aadhdhi bishin</para>
  <para style="q2" vid="ECC 1:4">hara yeletay yees;</para>
  <para style="q2" vid="ECC 1:4">gido attiin biittaya mernaaskka</para>
  <para style="q2" vid="ECC 1:4">minna de7awus.<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>Arshey mokkeessinne wullees;</para>
  <para style="q2" vid="ECC 1:5">qasseka ba mokkizaso baanaas eesotees.<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>Carkoy dugeha bagga carkees;</para>
  <para style="q2" vid="ECC 1:6">hara wode pudeha bagga</para>
  <para style="q2" vid="ECC 1:6">simmees;</para>
  <para style="q2" vid="ECC 1:6">qasse yuuyi yuuyi aadhdhidi</para>
  <para style="q2" vid="ECC 1:6">ba losida ogen gelees.<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>Shaafa haath ubbay</para>
  <para style="q2" vid="ECC 1:7">biidi abban gelees;</para>
  <para style="q2" vid="ECC 1:7">gido attiin abbay mulekka</para>
  <para style="q2" vid="ECC 1:7">kumi erenna;</para>
  <para style="q2" vid="ECC 1:7">shaafa haaththati kase ba yidaso</para>
  <para style="q2" vid="ECC 1:7">simmi beettes.<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>Asi haasayanaas</para>
  <para style="q2" vid="ECC 1:8">dandayzaazappe bollara</para>
  <para style="q2" vid="ECC 1:8">yo7oti ubbay saleththizaaza;</para>
  <para style="q2" vid="ECC 1:8">ayfey xeellidi kalli erenna;</para>
  <para style="q2" vid="ECC 1:8">hayththika siyidi,</para>
  <para style="q2" vid="ECC 1:8">«Taas gidides» gi erenna.<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>Kase haniday simmi izi hanana;</para>
  <para style="q2" vid="ECC 1:9">qasse ha7i hanishe dizaykka</para>
  <para style="q2" vid="ECC 1:9">kase hanidayssa.</para>
  <para style="q2" vid="ECC 1:9">Hessa gishshas salo gufanththon</para>
  <para style="q2" vid="ECC 1:9">aykkoyka ooraththa</para>
  <para style="q2" vid="ECC 1:9">miishshi deenna.<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>Oonikka, «Be7ite!</para>
  <para style="q2" vid="ECC 1:10">Hayssi ooraththa miishsha» giikko</para>
  <para style="q2" vid="ECC 1:10">hessi ooraththa miish gidenna;</para>
  <para style="q2" vid="ECC 1:10">hessi nuni yelettanaappe</para>
  <para style="q2" vid="ECC 1:10">kasekka diza miishsha.<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>Beni wode hanida hanota</para>
  <para style="q2" vid="ECC 1:11">zaaridi hassa7issiza</para>
  <para style="q2" vid="ECC 1:11">miishshi deenna;</para>
  <para style="q2" vid="ECC 1:11">sinththafe yaanaytikka</para>
  <para style="q2" vid="ECC 1:11">isttafe kaalli yaanaytan</para>
  <para style="q2" vid="ECC 1:11">qofettettenna.<verse eid="ECC 1:11"/></para>
  <para style="s1">Eranchchazi De7o Loseppe Demmida Timirte</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 1:12"/>Tani eranchchazi Yerusalaamen</para>
  <para style="q2" vid="ECC 1:12">Isra7eeles kawo gidada de7adis.<verse eid="ECC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 1:13"/>Tani salo gufanththon diza ubbaa</para>
  <para style="q2" vid="ECC 1:13">shaakka eranaassinne</para>
  <para style="q2" vid="ECC 1:13">aadho erateththan</para>
  <para style="q2" vid="ECC 1:13">pilgga xeellanaas</para>
  <para style="q2" vid="ECC 1:13">ta qofaa qachchadis;</para>
  <para style="q2" vid="ECC 1:13">Xoossi asa nayta toossida toohoy</para>
  <para style="q2" vid="ECC 1:13">ay mala deexoo!<verse eid="ECC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 1:14"/>Salo gufanththon hanida hanota</para>
  <para style="q2" vid="ECC 1:14">ubbaa ta be7adis;</para>
  <para style="q2" vid="ECC 1:14">gido attiin ubbayka hada;</para>
  <para style="q2" vid="ECC 1:14">carko oykkana yedeththiza mala.<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>Geellattida miishshi</para>
  <para style="q2" vid="ECC 1:15">sitti gaanawu dandayenna;</para>
  <para style="q2" vid="ECC 1:15">qasse baynda miishshi</para>
  <para style="q2" vid="ECC 1:15">qoodettana dandayenna.<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>Tanikka ta wozinan, «Taappe kase Yerusalaame haarida ubbatappe tani gitanne aadho eranchcha gidadis; tani aadho erateththaninne eran keeha loohadis» ga qoppadis.<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1KI 4:29-31">1Kawo 4:29-31</ref></char></note> <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>Qasse tani aadho erateth, gooshshateththinne eeyateth shaakka eranaas keeha baaxetadis; gido attiin wurseththan hessika carko oykkanaas yedeththiza mala hada gididayssa eradis.<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>Aadho erateththi darshin</para>
  <para style="q2" vid="ECC 1:18">ceecey darees;</para>
  <para style="q2" vid="ECC 1:18">eray dariza wodekka</para>
  <para style="q2" vid="ECC 1:18">metoy darees.<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s1">Bana Xalla Siiqoy Hada</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>Tani ta wozinan, «Ane taas gita ufays immizay aazakko, qasse lo7o miishshi aazakko eranaas koyays» ga qoppadis; gido attiin hessi hada. <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>Qasseka, «Miichchi eeyateththa; ishalossinne ufayssas ay go7ay dizee?» gadis. <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>Hessi wuri haniinkka aadho erateth demmanaas ta wozinan amottada tana woyne ushshan ufayssanaassinne eeyateth oykkanaas baaxetadis; qasse asay sa7a bolla diza qaanththa layththan salo gufanththon diza miish ubbaa bolla ooththidaakko istta go7izaazi aazakko ta erana koyadis.<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>Hessa gishshas hara issi gita miishshata ooththadis; taas keeththatakka keexxadis; woyne turakka tokkadis.<note caller="-" style="x"><char style="xo" closed="false">2:4-8 </char><char style="xt" closed="false"><ref loc="1KI 10:23-27">1Kawo 10:23-27</ref>; <ref loc="2CH 9:22-27">2Taari 9:22-27</ref></char></note> <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>Dumma dumma atakilteta, dumma dumma ayfe ayfiza miththata tokkadis; yuuyi ufayettizaso giigsadis. <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>He dicciza miththata ushshanaas haath eelissizaso zeera giigsadis. <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>Attumanne macca aylleta shammadis; taas soon yelettida hara aylletikka deettes; taappe kase Yerusalaamen de7ida oonappeka bollara daro mehe, deyshinne dorsa wude haaradis.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1Kawo 4:23</ref></char></note> <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>Tani dumma dumma biittatappe gita asatappenne kawotappe aqota, worqqanne bira taas dagasadis. Qasse addenne macca yeththanchchata shiishshadis; gujjadakka asaa ufayssanaas daro macca nayta ehadis.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:10">1Kawo 10:10</ref>; <ref loc="1KI 14:22">14:22</ref></char></note><verse eid="ECC 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9"/>Hessa gishshas tani taappe kase Yerusalaamen de7ida ooppenne aadhdhida gita as gidadis; ta aadho erateththayka tanara de7ides.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1CH 29:25">1Taari 29:25</ref></char></note><verse eid="ECC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10"/>Ta ayfey xeellidayssa diggabeekke;</para>
  <para style="q2" vid="ECC 2:10">ta wozinay amottidayssa</para>
  <para style="q2" vid="ECC 2:10">ubbaa diggabeekke;</para>
  <para style="q2" vid="ECC 2:10">tani ooththida ubbaan</para>
  <para style="q2" vid="ECC 2:10">ta wozinay ufayettides;</para>
  <para style="q2" vid="ECC 2:10">ta daaburaas wodhey hessa.<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>Gido attiin hessa ubbaa</para>
  <para style="q2" vid="ECC 2:11">ooththa simmada</para>
  <para style="q2" vid="ECC 2:11">tani akeekiza wode</para>
  <para style="q2" vid="ECC 2:11">tani keeha demmana gaada</para>
  <para style="q2" vid="ECC 2:11">daaburda daabura ubbaa</para>
  <para style="q2" vid="ECC 2:11">ta qoppiza wode ubbayka hada;</para>
  <para style="q2" vid="ECC 2:11">salo gufanththon</para>
  <para style="q2" vid="ECC 2:11">ay wodheykka deenna;</para>
  <para style="q2" vid="ECC 2:11">ubbayka carko oykkanaas</para>
  <para style="q2" vid="ECC 2:11">yedeththiza mala.<verse eid="ECC 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>Hessafe guye</para>
  <para style="q2" vid="ECC 2:12">tani aadho erateththi,</para>
  <para style="q2" vid="ECC 2:12">eeyateththinne gooshshateththi</para>
  <para style="q2" vid="ECC 2:12">aazakko pilgga eranaas</para>
  <para style="q2" vid="ECC 2:12">qofa doommadis;</para>
  <para style="q2" vid="ECC 2:12">kawo sohon kawotida</para>
  <para style="q2" vid="ECC 2:12">hara kawoy</para>
  <para style="q2" vid="ECC 2:12">kase oosettidayssafe</para>
  <para style="q2" vid="ECC 2:12">hara ay ooththanee?<verse eid="ECC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13"/>Tumukka poo7oy</para>
  <para style="q2" vid="ECC 2:13">dhumappe lo7iza mala</para>
  <para style="q2" vid="ECC 2:13">aadho erateththika eeyateththafe</para>
  <para style="q2" vid="ECC 2:13">aadhdhizayssa be7adis.<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>Era asa ayfey</para>
  <para style="q2" vid="ECC 2:14">izaades hu7e bolla dees;</para>
  <para style="q2" vid="ECC 2:14">eeyay gidikko</para>
  <para style="q2" vid="ECC 2:14">dhuma giddora hemettees;</para>
  <para style="q2" vid="ECC 2:14">gido attiin</para>
  <para style="q2" vid="ECC 2:14">istta nam7aa qaadaykka</para>
  <para style="q2" vid="ECC 2:14">issino gididayssa akeekadis.<verse eid="ECC 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 2:15"/>Tani ta wozinan,</para>
  <para style="q2" vid="ECC 2:15">«Eeya gakkiza qaaday</para>
  <para style="q2" vid="ECC 2:15">tanakka gakkana;</para>
  <para style="q2" vid="ECC 2:15">histtiin tani</para>
  <para style="q2" vid="ECC 2:15">aadho eranchcha gidoyssas</para>
  <para style="q2" vid="ECC 2:15">wodhey aazee?» gaada qoppadis.</para>
  <para style="q2" vid="ECC 2:15">Qasse tani ta wozinan,</para>
  <para style="q2" vid="ECC 2:15">«Hayssi ubbayka hada» gadis.<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>Aadho eranchchayka eeyaza mala</para>
  <para style="q2" vid="ECC 2:16">mernaas hassa7ettenna;</para>
  <para style="q2" vid="ECC 2:16">sinththafe yaana layththatan</para>
  <para style="q2" vid="ECC 2:16">nam7ayka dogettana;</para>
  <para style="q2" vid="ECC 2:16">eeyay hayqqiza mala</para>
  <para style="q2" vid="ECC 2:16">aadho eranchchasikka</para>
  <para style="q2" vid="ECC 2:16">hayqoy attenna.<verse eid="ECC 2:16"/></para>
  <para style="s1">Asa Dafeteththi Hada</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>Salo gufanththon haniza miishshi ubbay iitiza gishshas ha sa7a duussay tana iitees; hessi ubbayka hada; carko oykkanaas yedeththiza mala. <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>Salo gufanththon tani keeha daabura demmida ubbaa taappe guyen yiza yeletas yeggada biza gishshas tani daabura demmida ubbay tana iitees. <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>Taappe guyera yaanayssi izi aadho eranchcha gidiin woykko eeya gidiin oonee erizay? Izi oona gidikkoka tani keeha daaburdayssanne ta aadho erateththan tani demmida ubbaa bolla goda gidana; hessika hada.<verse eid="ECC 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 2:20"/>Hessa gishshas salo gufanththon hayssa keena ays daaburadinaa gaada ta wozinan hidota qanxxo doommadis. <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>Gaasoykka asi ba ubbaa aadho erateththan, eraninne hiillan daaburdi demmidaa ubbaa aykkoka daaburontta asas aggi bees; hessika hadanne gita qoho. <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>Hessa gishshas salo gufanththon asi keehi dafettikonne daaburkko izas ay wodhey dizee? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>Izi ba de7o layththan daaburza daaburay ubbay waayenne meto xalla; omarsika iza guuggey shempo demmenna; hessi ubbayka hada.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="JOB 5:7">Iyo 5:7</ref>; <ref loc="JOB 14:1">14:1</ref></char></note><verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>Asas muussafenne ushshafe qasse ba ooththida ooson ufayeteththafe hara lo7iza miishshi deenna; hessika Xoossa kusheppe imettizayssa ta beyadis.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ECC 3:13">Era 3:13</ref>; <ref loc="ECC 5:18">5:18</ref>; <ref loc="ECC 9:7">9:7</ref>; <ref loc="LUK 12:19">Luqa 12:19</ref>; <ref loc="1CO 15:32">1Qoro 15:32</ref></char></note> <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>Iza achchafe imettontta aggiko ooni maanaassinne ufayettanaas dandayzee? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>Xoossi bana ufayssiza asas aadho erateth, erateththinne ufays immees; gido attiin nagaranchchay Xoossa ufayssizaytas yeggi baana mala aqota dagasanaassinne ooththanaas wolqqa immees; hessika hadanne carko oykkanaas yedeththiza mala.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">Iyo 32:8</ref>; <ref loc="PRO 2:6">Leemi 2:6</ref></char></note><verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s1">Ubbaa Miishshaska Wodey Dees</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1"/>Ubbaasikka wodey dees;</para>
  <para style="q2" vid="ECC 3:1">saloppe garsa baggara</para>
  <para style="q2" vid="ECC 3:1">oosettizayssas</para>
  <para style="q2" vid="ECC 3:1">ubbaas wodey dees.<verse eid="ECC 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2"/>Hessa gishshas yelettanaas</para>
  <para style="q2" vid="ECC 3:2">wodey dees;</para>
  <para style="q2" vid="ECC 3:2">hayqqanaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:2">tokkanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:2">shoddanaaskka wodey dees.<verse eid="ECC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3"/>Wodhanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:3">ashshanaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:3">laallanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:3">gimbanaaskka wodey dees.<verse eid="ECC 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4"/>Yeekkanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:4">miiccanaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:4">kayottanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:4">qasse ufayettishe guppanaaskka wodey dees.<verse eid="ECC 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5"/>Shuch laallanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:5">shuch shiishshanaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:5">Idimettanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:5">shaakettanaaskka wodey dees.<verse eid="ECC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6"/>Koyanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:6">agganaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:6">Shiishshi oykkanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:6">kessi olanaaska wodey dees.<verse eid="ECC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7"/>Daakkanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:7">sikkanaaska wodey dees.</para>
  <para style="q2" vid="ECC 3:7">Co7u gaanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:7">haasayanaaskka wodey dees.<verse eid="ECC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8"/>Dosanaas wodey dees;</para>
  <para style="q2" vid="ECC 3:8">ixxanaaskka wodey dees.</para>
  <para style="q2" vid="ECC 3:8">Olas wodey dees;</para>
  <para style="q2" vid="ECC 3:8">saron daanaaskka wodey dees.<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>Histtiin oosanchchay ba dafetti daaburdayssafe ay wodhe demmanee? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>Tani qasse asaa nayti daaburdi ooththana mala Xoossi immida toohoy keehi deexo gididayssa be7adis. <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>Ubbaa miish iza woden woden lo7eththidi ooththides. Xoossi asaa wozinan mernateth woththides; gidikkoka Xoossi ooththidayssa ubbaa koyroppe wurseth gakkanaas asi ubbaa eranaas dandayenna. <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>Hessa gishshas asi ba de7o layththan lo7o ooso ooththizayssafenne ufayssizaaz ooththizaazappe aadhdhiza hara miishshi bayndayssa tani eradis. <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>Qasse asas izas iza daaburaas waaga gidizay miidinne uyidi bana ufayssizayssa; hessika izas Xoossafe imettida imota.<verse eid="ECC 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14"/>Xoossay ooththidayssi ubbay mernaas de7anayssa ta erays; izi ooththidayssa bolla gujjanaas woykko izappe guuththanaas dandayettenna. Xoossi hessa ooththiday asay iza bonchchana malassa.<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>Ha7i dizayssi</para>
  <para style="q2" vid="ECC 3:15">hayssafe kasekka dizayssa;</para>
  <para style="q2" vid="ECC 3:15">sinththafe hananayssi</para>
  <para style="q2" vid="ECC 3:15">benikka dizayssa;</para>
  <para style="q2" vid="ECC 3:15">Xoossi kase aadhdhidayssa</para>
  <para style="q2" vid="ECC 3:15">zaari koyees.<verse eid="ECC 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 3:16"/>Qasseka tani salo gufanththon</para>
  <para style="q2" vid="ECC 3:16">hara miish be7adis;</para>
  <para style="q2" vid="ECC 3:16">pirda sohon</para>
  <para style="q2" vid="ECC 3:16">makkallateththi dees;</para>
  <para style="q2" vid="ECC 3:16">suure pirda sohon geney dees.<verse eid="ECC 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 3:17"/>Tanikka ta wozinan,</para>
  <para style="q2" vid="ECC 3:17">«Ubbaa yo7ossinne oosos</para>
  <para style="q2" vid="ECC 3:17">wodey diza gishshas</para>
  <para style="q2" vid="ECC 3:17">Xoossi xillozanne wordanchchaza</para>
  <para style="q2" vid="ECC 3:17">pirdas shiishshana»</para>
  <para style="q2" vid="ECC 3:17">gaada qoppadis.<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>Qasse tani ta wozinan, «Asi mehe mala gididayssa istti erana mala Xoossi paaccees. <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>Asa qaadaykka meheyssa mala; nam7aa qaadaykka issino; issoy hayqqiza mala hankkoyssika hayqqees; nam7aaska issi qommo peenoy dees; hessa gishshas izi meheppe dummatenna; hessika hada. <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>Nam7ayka issi soho beettes; nam7ayka biittafe medhettida gishshas biittan simmeettes. <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>Histtiin asaa shemppoy pude salo kezizayssa, meheta shemppoyka duge biittan gelizayssa oonee erizay?» gaada qoppadis.<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>Hessa gishshas asi ba ooththida ooson ufayssafe hara aadhdhiza miishshi bayndayssa ta be7adis; hessika asas imettida qaada; izi hayqqidaappe guye oosettida oosota iza zaari ehidi bessanay oonee?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s1">Qoho, Dafeteth, Bizzateth</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 4:1"/>Tani qasseka salo gufanththon diza</para>
  <para style="q2" vid="ECC 4:1">qoho ubbaa</para>
  <para style="q2" vid="ECC 4:1">be7adissinne akeekadis;</para>
  <para style="q2" vid="ECC 4:1">qohettidayta afunth be7adis;</para>
  <para style="q2" vid="ECC 4:1">istta minththeththiza</para>
  <para style="q2" vid="ECC 4:1">asikka deenna;</para>
  <para style="q2" vid="ECC 4:1">wolqqay istta qohiza asata</para>
  <para style="q2" vid="ECC 4:1">kushen dees;</para>
  <para style="q2" vid="ECC 4:1">istta minththeththiza</para>
  <para style="q2" vid="ECC 4:1">asikka deenna.<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>Hessa gishshas tani,</para>
  <para style="q2" vid="ECC 4:2">«Ha7i shemppora</para>
  <para style="q2" vid="ECC 4:2">paxa dizaytappe</para>
  <para style="q2" vid="ECC 4:2">kase hayqqidayti kiya» gadis.<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>Gido attiin ha nam7atappeka bollara</para>
  <para style="q2" vid="ECC 4:3">mulekka yelettonttayta</para>
  <para style="q2" vid="ECC 4:3">qaaday lo7o;</para>
  <para style="q2" vid="ECC 4:3">gaasoykka istti salo gufanththon</para>
  <para style="q2" vid="ECC 4:3">oosettiza qohoza</para>
  <para style="q2" vid="ECC 4:3">mulekka be7ibeettenna.<verse eid="ECC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 4:4"/>Hessaththoka asay</para>
  <para style="q2" vid="ECC 4:4">ba amottidayssa demmanaas</para>
  <para style="q2" vid="ECC 4:4">keehi daaburdi ooththees;</para>
  <para style="q2" vid="ECC 4:4">gido attiin he daaburay</para>
  <para style="q2" vid="ECC 4:4">ba lagge bolla</para>
  <para style="q2" vid="ECC 4:4">qanaateteththan dendon</para>
  <para style="q2" vid="ECC 4:4">gididayssa tani akeekadis.</para>
  <para style="q2" vid="ECC 4:4">Hessika hada;</para>
  <para style="q2" vid="ECC 4:4">carko oykkanaas</para>
  <para style="q2" vid="ECC 4:4">yedeththiza mala.<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>Azallay ba kushe idimmi uttees;</para>
  <para style="q2" vid="ECC 4:5">barkka bana wodhees.<verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>Coo daaburaninne carko kaalon</para>
  <para style="q2" vid="ECC 4:6">nam7u kushe demmanaappe</para>
  <para style="q2" vid="ECC 4:6">woppan beettiza</para>
  <para style="q2" vid="ECC 4:6">issi kuphphay kiyees.<verse eid="ECC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 4:7"/>Qasseka tani salo gufanththon diza</para>
  <para style="q2" vid="ECC 4:7">miishshi hada gididayssa be7adis.<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>Yeloy woykko ishay baynda</para>
  <para style="q2" vid="ECC 4:8">bizza asi dees;</para>
  <para style="q2" vid="ECC 4:8">iza dafeteththaas zaway deenna;</para>
  <para style="q2" vid="ECC 4:8">iza ayfey izas diza</para>
  <para style="q2" vid="ECC 4:8">aqota kallibeenna;</para>
  <para style="q2" vid="ECC 4:8">izikka, «Tani hayssa</para>
  <para style="q2" vid="ECC 4:8">oosi daaburazinaa?</para>
  <para style="q2" vid="ECC 4:8">Tani ta hu7e ufayssanayssa</para>
  <para style="q2" vid="ECC 4:8">ays uuzettazinaa?» gides.</para>
  <para style="q2" vid="ECC 4:8">Hessika hadanne tugga de7o.<verse eid="ECC 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>Istta oosoy lo7o ayfe immanaas</para>
  <para style="q2" vid="ECC 4:9">dandayza gishshas</para>
  <para style="q2" vid="ECC 4:9">issino gidanaappe</para>
  <para style="q2" vid="ECC 4:9">nam7u gideththi lo7o.<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>Qasse nam7aafe</para>
  <para style="q2" vid="ECC 4:10">issoy kundiko issoy denththees;</para>
  <para style="q2" vid="ECC 4:10">gido attiin kundiko denththiza</para>
  <para style="q2" vid="ECC 4:10">laggey bayndaadey</para>
  <para style="q2" vid="ECC 4:10">ay mala qadheththizee!<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>Nam7ay issife ichchiko ho7ees;</para>
  <para style="q2" vid="ECC 4:11">gido attiin barkka ichchidaade</para>
  <para style="q2" vid="ECC 4:11">waani ho7ana dandayzee?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>Asi bizza qohana dandayees;</para>
  <para style="q2" vid="ECC 4:12">nam7u gidikko</para>
  <para style="q2" vid="ECC 4:12">izara eqettana dandayeettes;</para>
  <para style="q2" vid="ECC 4:12">Heedzdzan dooqettida wodoroy</para>
  <para style="q2" vid="ECC 4:12">elle duuxxenna.<verse eid="ECC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>Zore ekkontta eeyanne cima kawo gidanaappe aadho erateththi diza naateththa manqoy lo7o. <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>Ays giikko izi he hiyeesa gidida sohoppe dendidi woykko qasho keeththafe kezidi ba biittan kawotanaas dandayees. <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>Tani salo gufanththon dizaytinne simerettizayti ubbay kawo araata laattiza yelagaa kaallizayssa be7adis. <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>Iza sinththan qooday baynda derey dees; kawoteththafe izi kichchiza wode izi ooththidayssas oonikka iza galatenna. Hessika hada; carko oykkanaas yedeththiza mala.<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s1">Adinas Eesotoppa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1"/>Xoossa Keeth gelashe ne toho shiishsha ekka; siyanaas shiiqoy eeyata yarshofe aadhdhees; ays giikko istti bantta oosoy iita gididayssa erettenna.<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>Haasayanawu eesotoppa;</para>
  <para style="q2" vid="ECC 5:2">qasse issi miish Xoossas</para>
  <para style="q2" vid="ECC 5:2">immana gaada eeson geppofa;</para>
  <para style="q2" vid="ECC 5:2">ays giikko Xoossi salon dees;</para>
  <para style="q2" vid="ECC 5:2">neni gidikko sa7an daasa;</para>
  <para style="q2" vid="ECC 5:2">hessa gishshas ne haasayana</para>
  <para style="q2" vid="ECC 5:2">qaalay ginara gido.<verse eid="ECC 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3"/>Ooso daron agumoy beettiza mala</para>
  <para style="q2" vid="ECC 5:3">haasaya daron</para>
  <para style="q2" vid="ECC 5:3">eeyateththa qaalay qonccees.<verse eid="ECC 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4"/>Xoossas neni adinida adina gam7ontta gaththa; eeson polontta attiko izi ufayettenna; hessa gishshas neni adinettidayssa ubbaa pola.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 66:13-14">Maza 66:13-14</ref></char></note> <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>Issi miish Xoossas adinettidi he adinettidayssa gaththontta agganaappe kase adinettontta agoy lo7o. <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>Nena ne doonay nagaran yeggontta mala ne doona shiishsha; qasse Xoossa Keeththa oosanchcha sinth shiiqada, «Ta hayssa qoppontta adinettadis» gooppa. Xoossa hanqeththada ne ooso ays dhayssisay? <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>Daro agumoynne daro haasayay hada; hessa gishshas neni Xoossas yayya.<verse eid="ECC 5:7"/></para>
  <para style="s1">Dureteththi Hada</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>Dere garsan manqoy sugettiin, pirday pacciin, maatay yedhettiin ne be7ikko heytanttan keeha malalettofa. Issi issi halaqaas izappe bollara halaqay dees; qasse ubbatappe bollara hara halaqati deettes. <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>Biittafe beettiza go7ay ubbaassa; kawoykka ba hu7es hessafe go7ettees.<verse eid="ECC 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>Bira siiqiza asas</para>
  <para style="q2" vid="ECC 5:10">biray gidi erenna;</para>
  <para style="q2" vid="ECC 5:10">dureteth koyza asi</para>
  <para style="q2" vid="ECC 5:10">duretidikka kalli erenna;</para>
  <para style="q2" vid="ECC 5:10">hessi ubbayka hada.<verse eid="ECC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>Aqotay dari dari bishin</para>
  <para style="q2" vid="ECC 5:11">mizay darees;</para>
  <para style="q2" vid="ECC 5:11">haaridaades ayfen be7oppe</para>
  <para style="q2" vid="ECC 5:11">hara aaza go7ay dizee?<verse eid="ECC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12"/>Ooso ooththiza asi guuth miikko,</para>
  <para style="q2" vid="ECC 5:12">daro miikko saro dhisko</para>
  <para style="q2" vid="ECC 5:12">dhiski aqees;</para>
  <para style="q2" vid="ECC 5:12">gido attiin dure as</para>
  <para style="q2" vid="ECC 5:12">dureteththi dhisko diggees.<verse eid="ECC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 5:13"/>Salo gufanththon keehi ceecesiza</para>
  <para style="q2" vid="ECC 5:13">iita miish ta be7adis;</para>
  <para style="q2" vid="ECC 5:13">hessika iita woden</para>
  <para style="q2" vid="ECC 5:13">bana maaddo giidi</para>
  <para style="q2" vid="ECC 5:13">asi guye yeggi dagasida miishshi</para>
  <para style="q2" vid="ECC 5:13">izaades meto;<verse eid="ECC 5:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14"/>woykko issi gaason</para>
  <para style="q2" vid="ECC 5:14">coo dhayza dureteththa.</para>
  <para style="q2" vid="ECC 5:14">Izi naa yelikkoka</para>
  <para style="q2" vid="ECC 5:14">he yelettidayssas</para>
  <para style="q2" vid="ECC 5:14">laatissiza miishshi deenna.<verse eid="ECC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15"/>Asi ba aayi uloppe kallo</para>
  <para style="q2" vid="ECC 5:15">yelettida mala kallo bees;</para>
  <para style="q2" vid="ECC 5:15">ay keena daaburkkoka</para>
  <para style="q2" vid="ECC 5:15">izi ba daaburdayssafe</para>
  <para style="q2" vid="ECC 5:15">aykkoka ekkibeenna.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JOB 1:21">Iyo 1:21</ref>; <ref loc="PSA 49:17">Maza 49:17</ref>; <ref loc="1TI 6:7">1Xim 6:7</ref></char></note><verse eid="ECC 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 5:16"/>Hessika keehippe iita;</para>
  <para style="q2" vid="ECC 5:16">asi ba yida mala simmi bees;</para>
  <para style="q2" vid="ECC 5:16">iza daabura ubbay</para>
  <para style="q2" vid="ECC 5:16">carko oykkiza mala</para>
  <para style="q2" vid="ECC 5:16">hada gidizaa gidikko</para>
  <para style="q2" vid="ECC 5:16">izas ay go7ay dizee?<verse eid="ECC 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17"/>Izi ba layth ubbaa ceecen, waayen,</para>
  <para style="q2" vid="ECC 5:17">yiilloninne dhuma</para>
  <para style="q2" vid="ECC 5:17">duussan wursees.<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>Asa qaaday hessa gidida gishshas salo gufanththon Xoossi asi de7ana mala immida qaanththa layththa garsan asi ba daaburda daaburappe muussinne ushshi lo7onne bessizayssa gididayssa ta akeekadis. <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>Xoossay asas dureteththinne aqo immizay ba daaburda waaga demmidi miidinne uyidi ufayettanaassa. Hessi Xoossafe izas imettida imota. <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>Xoossay iza wozinan ubba wode ufays kunththi woththiza gishshas izi ba de7o layththas daro hirgenna.<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>Salo gufanththon hara iita miish tani be7adis; hessika asas keehi deexo. <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>Asi ba wozinan amottida miish demmana mala Xoossi asas aqota, dureteththinne bonchcho immees; gido attiin keeththaaway isttan ufayettana mala kumeththa maata izas immenna; izi daaburi demmidayssan haray ufayettees; hessika hadanne keehi iita miishsha.<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>Issi asi xeetu nayta gakkanaas yeli cimmidi adussa layth de7anawu dandayees; gido attiin izi ba aqotan ufayettontta aggikonne hayqqidi wogara moogettontta aggiko izappe awucayay kiya. <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>Gaasoykka coo hada yiidi dhuman bees; iza sunththika dhuman kamettides. <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>Izi eronttanne poo7o be7ontta aggikokka he addezappe izas aadho woppay dees. <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>Ufayssi baynda dishin nam7u shii layth de7ikkoka izas aaza go7ay dizee? Wurseththan nam7ayka issi soho baana deettennee?<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>Asi daaburdi ooththiza</para>
  <para style="q2" vid="ECC 6:7">ubbay ulossa;</para>
  <para style="q2" vid="ECC 6:7">gido attiin iza amoy</para>
  <para style="q2" vid="ECC 6:7">mulekka kalli erenna.<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>Histtiin aadho eranchchay</para>
  <para style="q2" vid="ECC 6:8">eeyappe aazan aadhdhizee?</para>
  <para style="q2" vid="ECC 6:8">Manqoy harata sinththan</para>
  <para style="q2" vid="ECC 6:8">waani simerettanaakko eroy</para>
  <para style="q2" vid="ECC 6:8">iza ay maaddizee?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>Amon toylattanaappe</para>
  <para style="q2" vid="ECC 6:9">ayfen be7oy kiya;</para>
  <para style="q2" vid="ECC 6:9">hessika hadanne carko oykkanaas</para>
  <para style="q2" vid="ECC 6:9">yedeththiza mala<verse eid="ECC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>Ha7i diza ubbaas</para>
  <para style="q2" vid="ECC 6:10">kaseti sunththi</para>
  <para style="q2" vid="ECC 6:10">imetti uttides;</para>
  <para style="q2" vid="ECC 6:10">asi hananaazi eretti uttides;</para>
  <para style="q2" vid="ECC 6:10">asi baappe minnizayssara</para>
  <para style="q2" vid="ECC 6:10">baaxettenna.<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>Haasayay darshin</para>
  <para style="q2" vid="ECC 6:11">hada yo7oy darees;</para>
  <para style="q2" vid="ECC 6:11">histtiin hessi as ay go7anee?<verse eid="ECC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 6:12"/>Hadanne eesho mala elle aadhdhiza</para>
  <para style="q2" vid="ECC 6:12">guuththa layththatan</para>
  <para style="q2" vid="ECC 6:12">asas lo7o miishshi hananayssa</para>
  <para style="q2" vid="ECC 6:12">erizay oonee?</para>
  <para style="q2" vid="ECC 6:12">Qasseka izi hayqqidaappe guye</para>
  <para style="q2" vid="ECC 6:12">salo gufanththon haniza miish</para>
  <para style="q2" vid="ECC 6:12">izas yootana dandayzay oonee?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s1">De7o Gishshas Qofa</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1"/>Lo7o shittofe</para>
  <para style="q2" vid="ECC 7:1">lo7o sunththi aadhdhees;</para>
  <para style="q2" vid="ECC 7:1">yeleta gallassafe</para>
  <para style="q2" vid="ECC 7:1">hayqo gallassi lo7o.<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PRO 22:1">Leemi 22:1</ref></char></note><verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>Gibira keeth buussafe</para>
  <para style="q2" vid="ECC 7:2">yeeho keeth buussi lo7o;</para>
  <para style="q2" vid="ECC 7:2">gaasoykka hayqoy</para>
  <para style="q2" vid="ECC 7:2">as ubbaas wurseththa;</para>
  <para style="q2" vid="ECC 7:2">shemppora paxa diza</para>
  <para style="q2" vid="ECC 7:2">asi ubbay</para>
  <para style="q2" vid="ECC 7:2">hessa ba wozinan</para>
  <para style="q2" vid="ECC 7:2">woththanaas bessees.<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>Miichchafe kayoy kiya;</para>
  <para style="q2" vid="ECC 7:3">gaasoykka kayoy</para>
  <para style="q2" vid="ECC 7:3">sinth kareththikokka</para>
  <para style="q2" vid="ECC 7:3">wozina poo7isees.<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>Aadho eranchcha wozinay</para>
  <para style="q2" vid="ECC 7:4">kayo keeththan dees;</para>
  <para style="q2" vid="ECC 7:4">eeyata wozinay gidikko</para>
  <para style="q2" vid="ECC 7:4">ufayssa keeththan dees.<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>Eeyati sabbishe yexxiza</para>
  <para style="q2" vid="ECC 7:5">yeth siyanaappe</para>
  <para style="q2" vid="ECC 7:5">aadho eranchchay seeriza</para>
  <para style="q2" vid="ECC 7:5">seera ezgoy lo7o.<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>Eeyata miichchi</para>
  <para style="q2" vid="ECC 7:6">oto garsan eexxishe</para>
  <para style="q2" vid="ECC 7:6">dhuuqettiza agunththa mala;</para>
  <para style="q2" vid="ECC 7:6">hessika hada.<verse eid="ECC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>Gene oosoy aadho eranchcha</para>
  <para style="q2" vid="ECC 7:7">eeya kessees;</para>
  <para style="q2" vid="ECC 7:7">maganxoy asas wozina moorees.<verse eid="ECC 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>Issi miishshas doomeththafe</para>
  <para style="q2" vid="ECC 7:8">wurseththi kiya;</para>
  <para style="q2" vid="ECC 7:8">qasse otoranchchafe</para>
  <para style="q2" vid="ECC 7:8">dandayanchchay kiya.<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>Eeyata hanqoy</para>
  <para style="q2" vid="ECC 7:9">istta ki7o garsan diza gishshas</para>
  <para style="q2" vid="ECC 7:9">neni hanqos eesotoppa.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JAS 1:19">Yaaqo 1:19</ref></char></note><verse eid="ECC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>Neni, «Ha wodey</para>
  <para style="q2" vid="ECC 7:10">kase aadhdhida wodetappe</para>
  <para style="q2" vid="ECC 7:10">ays lo7idee?» ga oychchofa;</para>
  <para style="q2" vid="ECC 7:10">heytantta mala oyshata oyshoy</para>
  <para style="q2" vid="ECC 7:10">aadho erateth gidenna.<verse eid="ECC 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>Aadho erateththi lo7o xinxxo mala;</para>
  <para style="q2" vid="ECC 7:11">iza go7ay</para>
  <para style="q2" vid="ECC 7:11">poo7o be7iza as ubbaassa.<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>Miishshi as iitappe</para>
  <para style="q2" vid="ECC 7:12">kammi ashshiza mala</para>
  <para style="q2" vid="ECC 7:12">aadho erateththi ashshees.</para>
  <para style="q2" vid="ECC 7:12">Hessafe bollarakka</para>
  <para style="q2" vid="ECC 7:12">aadho erateththi</para>
  <para style="q2" vid="ECC 7:12">keeththa aawa shemppo naagees.<verse eid="ECC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 7:13"/>Ane Xoossay ooththidayssa</para>
  <para style="q2" vid="ECC 7:13">wozinan woththa!</para>
  <para style="q2" vid="ECC 7:13">Izi bokkasidayssa</para>
  <para style="q2" vid="ECC 7:13">ooni luulisana dandayzee?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>Nees wodey lo7ishin ufayetta;</para>
  <para style="q2" vid="ECC 7:14">gido attiin wodey iitishin</para>
  <para style="q2" vid="ECC 7:14">hayssa wozinan woththa;</para>
  <para style="q2" vid="ECC 7:14">Xoossi issaa ooththida mala</para>
  <para style="q2" vid="ECC 7:14">harakka ooththides;</para>
  <para style="q2" vid="ECC 7:14">hessa gishshas asi</para>
  <para style="q2" vid="ECC 7:14">sinththafe hanana miish</para>
  <para style="q2" vid="ECC 7:14">aykkoka pilggidi</para>
  <para style="q2" vid="ECC 7:14">erana dandayenna.<verse eid="ECC 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 7:15"/>Nagaranchchay ba nagaraara</para>
  <para style="q2" vid="ECC 7:15">adussa layth de7ishin,</para>
  <para style="q2" vid="ECC 7:15">xilloy ba xilloteththara</para>
  <para style="q2" vid="ECC 7:15">eeson hayqqishin</para>
  <para style="q2" vid="ECC 7:15">hada gidida ta de7o layththatan</para>
  <para style="q2" vid="ECC 7:15">hayta be7adis.<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>Hessa gishshas ne dhayontta mala</para>
  <para style="q2" vid="ECC 7:16">keeha xillo,</para>
  <para style="q2" vid="ECC 7:16">woykko keeha</para>
  <para style="q2" vid="ECC 7:16">aadho eranchcha gidoppa.<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>Qasse keeha iita as,</para>
  <para style="q2" vid="ECC 7:17">woykko ubbaa eeya as gidoppa;</para>
  <para style="q2" vid="ECC 7:17">ne ays wodey baynda hayqqay?<verse eid="ECC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18"/>Issaa oykkidi hankkoyssaka</para>
  <para style="q2" vid="ECC 7:18">yeddontta agoy lo7o;</para>
  <para style="q2" vid="ECC 7:18">Xoossas yayyiza asi</para>
  <para style="q2" vid="ECC 7:18">shikkalateth ixxees.<verse eid="ECC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>Aadho erateththi aadho eranchchas</para>
  <para style="q2" vid="ECC 7:19">immiza wolqqay</para>
  <para style="q2" vid="ECC 7:19">issi kataman dere haariza</para>
  <para style="q2" vid="ECC 7:19">tammatappe aadhdhees.<verse eid="ECC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>Nagara ooththontta</para>
  <para style="q2" vid="ECC 7:20">mulera suure oosoninne</para>
  <para style="q2" vid="ECC 7:20">xilloteththan xalla kanththiza asi</para>
  <para style="q2" vid="ECC 7:20">biitta bolla deenna.<verse eid="ECC 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>Haasayettiza qaala ubbaa hayth</para>
  <para style="q2" vid="ECC 7:21">yegga siyoppa;</para>
  <para style="q2" vid="ECC 7:21">ne histtontta aggiko</para>
  <para style="q2" vid="ECC 7:21">ne ashkaray nena qanggishin</para>
  <para style="q2" vid="ECC 7:21">ne siyandasa.<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>Qasse nenikka ne hu7en</para>
  <para style="q2" vid="ECC 7:22">harata qanggoyssa</para>
  <para style="q2" vid="ECC 7:22">ne wozinay erees.<verse eid="ECC 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ECC 7:23"/>Hayssa ubbaa tani</para>
  <para style="q2" vid="ECC 7:23">aadho erateththan</para>
  <para style="q2" vid="ECC 7:23">pilgga xeellada,</para>
  <para style="q2" vid="ECC 7:23">«Tanikka aadho eranchcha</para>
  <para style="q2" vid="ECC 7:23">gidanaas qachchadis» gadis.</para>
  <para style="q2" vid="ECC 7:23">Gido attiin tani</para>
  <para style="q2" vid="ECC 7:23">gida mala hanibeenna.<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>Aadho erateththi ay gidikkoka</para>
  <para style="q2" vid="ECC 7:24">keehi ciimmanne haako;</para>
  <para style="q2" vid="ECC 7:24">histtiin ooni gakki</para>
  <para style="q2" vid="ECC 7:24">erana dandayzee?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>Hessa gishshas aadho erateththinne</para>
  <para style="q2" vid="ECC 7:25">yo7oti hanizayssa pilgga eranaas,</para>
  <para style="q2" vid="ECC 7:25">xanna7anaas nagara</para>
  <para style="q2" vid="ECC 7:25">iitateththinne</para>
  <para style="q2" vid="ECC 7:25">eeyateththi gooshshateth</para>
  <para style="q2" vid="ECC 7:25">gididayssa</para>
  <para style="q2" vid="ECC 7:25">akeekanaas ta wozinan</para>
  <para style="q2" vid="ECC 7:25">yuushsha qoppadis.<verse eid="ECC 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>Izis wozinay woximade mala,</para>
  <para style="q2" vid="ECC 7:26">izi kusheti agrimooqe malanne</para>
  <para style="q2" vid="ECC 7:26">yarde mala gidida</para>
  <para style="q2" vid="ECC 7:26">hayqoppe iita</para>
  <para style="q2" vid="ECC 7:26">maccas be7adis;</para>
  <para style="q2" vid="ECC 7:26">izippe kessi ekkanay</para>
  <para style="q2" vid="ECC 7:26">Xoossas yayyiza as xalla;</para>
  <para style="q2" vid="ECC 7:26">nagaranchcha as gidikko</para>
  <para style="q2" vid="ECC 7:26">yarden oykkawus.<verse eid="ECC 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ECC 7:27"/>Aadho eranchchazi,</para>
  <para style="q2" vid="ECC 7:27">«Tani kaalla pilgga</para>
  <para style="q2" vid="ECC 7:27">xeellada demmida</para>
  <para style="q2" vid="ECC 7:27">hara miishshi</para>
  <para style="q2" vid="ECC 7:27">hayssafe kaallizayssa.</para>
  <para style="q2" vid="ECC 7:27">Yo7oti hanizayssa</para>
  <para style="q2" vid="ECC 7:27">hiillateththan pilggidi</para>
  <para style="q2" vid="ECC 7:27">demmanaas</para>
  <para style="q2" vid="ECC 7:27">issaa issaa bolla gujjo;<verse eid="ECC 7:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28"/>Hessika tani hach gakkanaas</para>
  <para style="q2" vid="ECC 7:28">pilggashe dhaydayssa</para>
  <para style="q2" vid="ECC 7:28">shii attumasappe</para>
  <para style="q2" vid="ECC 7:28">issi suure as demmadis.</para>
  <para style="q2" vid="ECC 7:28">Gido attiin haytantta giddofe</para>
  <para style="q2" vid="ECC 7:28">issi suure maccas demmabeekke.<verse eid="ECC 7:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29"/>Tani hayssa ubbaafe</para>
  <para style="q2" vid="ECC 7:29">issi miish tamaaradis;</para>
  <para style="q2" vid="ECC 7:29">Xoossi as suure</para>
  <para style="q2" vid="ECC 7:29">histti medhdhides;</para>
  <para style="q2" vid="ECC 7:29">gido attiin asi</para>
  <para style="q2" vid="ECC 7:29">daro gitettidaaz giigsides» gides.<verse eid="ECC 7:29"/></para>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>Yo7ota birshana dandayza</para>
  <para style="q2" vid="ECC 8:1">aadho eranchcha mala</para>
  <para style="q2" vid="ECC 8:1">asi oonee?</para>
  <para style="q2" vid="ECC 8:1">Yo7ota ubbaa birsheth</para>
  <para style="q2" vid="ECC 8:1">erizay oonee?</para>
  <para style="q2" vid="ECC 8:1">Aadho erateththi</para>
  <para style="q2" vid="ECC 8:1">asa ayfeso poo7isees;</para>
  <para style="q2" vid="ECC 8:1">xirphotida sinththika birshees.<verse eid="ECC 8:1"/></para>
  <para style="s1">Kawos Azazeteth</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>Ne kase Xoossaa sinththan caaqqida gishshas kawos azazetta.<verse eid="ECC 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 8:3"/>Kawo sinththafe eeson kezoppa; izi ba dosidayssa ooththanaas dandayza gishshas iita oosos zuppetoppa. <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>Ubbaa miish ooththanaas kawos maatay diza gishshas, «Hayssa ays ooththay?» giidi iza oychchanaas dandayzay oonee?<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>Izas azazettiza asi</para>
  <para style="q2" vid="ECC 8:5">ubbay qohettenna;</para>
  <para style="q2" vid="ECC 8:5">aadho erateththi diza wozinay</para>
  <para style="q2" vid="ECC 8:5">likke wodenne bessiza ooso oge</para>
  <para style="q2" vid="ECC 8:5">shaakki erees.<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>As metoy keehi un7eththikokka</para>
  <para style="q2" vid="ECC 8:6">ubbaa miishshaska</para>
  <para style="q2" vid="ECC 8:6">likke wodeynne</para>
  <para style="q2" vid="ECC 8:6">bessiza ooso ogey dees.<verse eid="ECC 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>Sinththafe hananayssa</para>
  <para style="q2" vid="ECC 8:7">erizay deenna;</para>
  <para style="q2" vid="ECC 8:7">hessa gishshas</para>
  <para style="q2" vid="ECC 8:7">sinththafe hananayssa</para>
  <para style="q2" vid="ECC 8:7">yootanaas dandayzay oonee?<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>Asi ba shemppo</para>
  <para style="q2" vid="ECC 8:8">naagi ashshanaas dandayenna;</para>
  <para style="q2" vid="ECC 8:8">woykko ba hayqqana</para>
  <para style="q2" vid="ECC 8:8">gallassa bolla</para>
  <para style="q2" vid="ECC 8:8">maatay diza asi deenna;</para>
  <para style="q2" vid="ECC 8:8">ola gallas oonikka ola yeggidi</para>
  <para style="q2" vid="ECC 8:8">guye simmonttayssa mala</para>
  <para style="q2" vid="ECC 8:8">iita oosoykka</para>
  <para style="q2" vid="ECC 8:8">banara meezetidayta yeddenna.<verse eid="ECC 8:8"/></para>
  <para style="s1">Iita Asata Hanotanne Kiya Asata Hanota</para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 8:9"/>Salo gufanththon</para>
  <para style="q2" vid="ECC 8:9">haniza miish ubbaa</para>
  <para style="q2" vid="ECC 8:9">tani pilgga be7adis;</para>
  <para style="q2" vid="ECC 8:9">asi as qohanaas</para>
  <para style="q2" vid="ECC 8:9">daannatiza wodey dees.<verse eid="ECC 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 8:10"/>Qasse iitati bonchchon</para>
  <para style="q2" vid="ECC 8:10">moogettishininne</para>
  <para style="q2" vid="ECC 8:10">geeshsha kataman sabettishin,</para>
  <para style="q2" vid="ECC 8:10">Xoossa asati geeshsha kataman</para>
  <para style="q2" vid="ECC 8:10">dogettishin ta be7adis;</para>
  <para style="q2" vid="ECC 8:10">hessi ubbayka hada.<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>Iita ooththida asa bolla eeson pirdontta aggiko asa wozinay iita ooththana halchchon kumees. <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>Nagaranchchay xeetuto iita miish ooththishin iza layththay aduqqikokka, Xoossa bonchchizaytassinne Xoossa yayyizaytas lo7oy hananayssa ta erays. <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>Gido attiin iitati Xoossas yayyontta gishshas lo7o miishshi isttas hanenna; istta layththi eesho mala elle aadhdhana.<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>Sa7a bolla oosettiza haray hada miishshi dees; hessika xilloti iitatas bessiza qixaate, iitati xillotas bessiza lo7o miish ekkeettes. Heyti ubbayka hada. <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>Salo gufanththon asas muussafe, ushshafenne ufayeteththafe aadhdhiza hara miishshi baynda gishshas ba de7o layththan ufayeteththi lo7o gadis; hessa gishshas Xoossi salo gufanththon izas immida layththatan izi ba ooson ufayettana.<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>Tani aadho erateth eranaassinne asi ha sa7a bollan omarsinne gallas dhiskoy baynda daaburza daaburaa eranaas ta wozinan pilggadis. <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>Hessafe guye Xoossi ooththida ubbaa be7adis; salo gufanththon oosettiza miish oonikka erenna; asi keehi dafettidi pilggi xeellikokka iza birsheththaa demmanaas dandayenna. Aadho eranchchay, «Ta erays» giikkoka ubbaa eranaas dandayenna.<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s1">Ubbaas Diza Wurseththa Qaada</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>Hessa gishshas ha ubbaa yo7ota ta wozinan qoppada aadho eranchchatinne xilloti ooththiza oosoy Xoossa kushenna; gido attiin asi sinththafe bana naagizayssi siiqo gidiin woykko ixo gidiin erenna. <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>Xillota woykko nagaranchchata gidiin, suureta woykko iitata gidiin, geeshshata woykko tunata gidiin, yarsho shiishshizayta woykko yarsho shiishshonttayta gidiin ubbatasikka wurseththa qaaday issino.</para>
  <para style="q2" vid="ECC 9:2">Lo7o asas hanzayssa mala</para>
  <para style="q2" vid="ECC 9:2">nagaranchchaska hanees;</para>
  <para style="q2" vid="ECC 9:2">caaqqizayssas</para>
  <para style="q2" vid="ECC 9:2">hanizayssa malakka</para>
  <para style="q2" vid="ECC 9:2">caaqos babbizaytas hanees.<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>Salo gufanththon ubbaa bolla gakkiza iitateththi hayssa; ubbaas wurseththa qaaday issino; hessafe bollarakka asa wozinay iitateththan kumidessinne gooyides; wurseththankka hayqqida asan gayttees. <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>Hayqqida gaammofe paxa diza kanay kiya; hessaththoka shemppora paxa dizayta giddon diza asas hidotay dees.<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>Shemppora paxa diza asi</para>
  <para style="q2" vid="ECC 9:5">ba hayqqanayssa erees;</para>
  <para style="q2" vid="ECC 9:5">gido attiin hayqqidayti</para>
  <para style="q2" vid="ECC 9:5">aykkoka erettenna;</para>
  <para style="q2" vid="ECC 9:5">istta qofsiza miishshi</para>
  <para style="q2" vid="ECC 9:5">ubbay dogettees;</para>
  <para style="q2" vid="ECC 9:5">istti go7ettana miishshika deenna.<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>Istta siiqoy, ixoynne</para>
  <para style="q2" vid="ECC 9:6">qanaatey ubbay</para>
  <para style="q2" vid="ECC 9:6">isttara issife dhaydes.</para>
  <para style="q2" vid="ECC 9:6">Hessa gishshas salo gufanththon</para>
  <para style="q2" vid="ECC 9:6">haniza miish ubbaan</para>
  <para style="q2" vid="ECC 9:6">aykko qaadaykka isttas deenna.<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>Baada ne kath ufayssan ma; ne woyne ushshaaka ne wozinay ufayettishin uya; ays giikko Xoossi ne ooththida ooson ufayettees. <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>Ubbaa wode ne may7oy booth gido; ne hu7eykka zayten tiyetto. <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>Salo gufanththon Xoossi nees immida guuth gidida ne de7o layththata ubbaan ne siiqiza ne machcheyra ufayssan de7a; ays giikko salo gufanththon ne de7oninne ne daaburda daabura ubbaan hayssi nees qaada. <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>Ne kushey ooththanaas demmidayssa ubbaa ne kumeththa wolqqan ooththa; ays giikko neni baana duufon oosoy, halchchoy, erateththinne aadho erateththi deenna.<verse eid="ECC 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 9:11"/>Tani salo gufanththon</para>
  <para style="q2" vid="ECC 9:11">hara miish be7adis;</para>
  <para style="q2" vid="ECC 9:11">woththan xoonoy pilatatas</para>
  <para style="q2" vid="ECC 9:11">olan xoonoy wolqqamatas gidenna;</para>
  <para style="q2" vid="ECC 9:11">kaththi aadho eranchchatas,</para>
  <para style="q2" vid="ECC 9:11">dureteththi kiphatanchchatas,</para>
  <para style="q2" vid="ECC 9:11">sabay eranchchatas gidenna;</para>
  <para style="q2" vid="ECC 9:11">gido attiin ubbatikka wodeynne</para>
  <para style="q2" vid="ECC 9:11">qaaday gaththida mala haneettes.<verse eid="ECC 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 9:12"/>Qasseka ba wode eriza asi deenna;</para>
  <para style="q2" vid="ECC 9:12">kafoy yarden geliza mala,</para>
  <para style="q2" vid="ECC 9:12">moley giten oykettiza mala,</para>
  <para style="q2" vid="ECC 9:12">asikka qoppontta dishin yiza</para>
  <para style="q2" vid="ECC 9:12">iita wodetan oykettees.<verse eid="ECC 9:12"/></para>
  <para style="s1">Aadho Erateththinne Eeyateth</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>Hessaththoka tana keehi malalisida hayssa aadho leemiso salo gufanththon be7adis. <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>Hessika issi biittan amarda asati de7iza qeeri katamay dawus; he katamayo olanaas issi wolqqama kawoy worajji dooddides; izi yuushon miixa giigsides. <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>He katamayn aadho eranchcha gidida issi manqo asi dees; izi ba aadho erateththan he katamayo ashshides. Gido attiin he manqozas oonikka qoppibeenna. <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>Hessa gishshas tani, «Aadho erateththi wolqqafe aadhdhees» gadis. Gidikkoka he manqozas diza aadho erateththazi kadhettides; iza qaalaykka siyettibeenna.<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>Eeyata ayssiza daanna waasoppe</para>
  <para style="q2" vid="ECC 9:17">aadho eranchchay</para>
  <para style="q2" vid="ECC 9:17">liiqon haasayza</para>
  <para style="q2" vid="ECC 9:17">qaalay seetettees.<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>Aadho erateththi</para>
  <para style="q2" vid="ECC 9:18">ola miishshafe aadhdhees;</para>
  <para style="q2" vid="ECC 9:18">gido attiin issi nagaranchchay</para>
  <para style="q2" vid="ECC 9:18">daro lo7o miish dhayssees.<verse eid="ECC 9:18"/></para>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>Hayqqida udunxxeti</para>
  <para style="q2" vid="ECC 10:1">shitto zeeqeththeettes;</para>
  <para style="q2" vid="ECC 10:1">hessaththoka guuththa eeyateththi</para>
  <para style="q2" vid="ECC 10:1">aadho erateththinne</para>
  <para style="q2" vid="ECC 10:1">bonchcho kawushshees.<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>Aadho eranchcha wozinay</para>
  <para style="q2" vid="ECC 10:2">iza ushach kaaleththees;</para>
  <para style="q2" vid="ECC 10:2">gido attiin eeya wozinay</para>
  <para style="q2" vid="ECC 10:2">hadirs kaaleththees.<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>Eeyay oge bishin</para>
  <para style="q2" vid="ECC 10:3">izas akeekay paccees;</para>
  <para style="q2" vid="ECC 10:3">ba eeyateththa oonaska qonccisees.<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>Ne goday ne bolla hanqettiko</para>
  <para style="q2" vid="ECC 10:4">ne soho yeddofa;</para>
  <para style="q2" vid="ECC 10:4">gaasoykka dandayay</para>
  <para style="q2" vid="ECC 10:4">gita hanqo</para>
  <para style="q2" vid="ECC 10:4">co7u histtees.<verse eid="ECC 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5"/>Salo gufanththon tani be7ida</para>
  <para style="q2" vid="ECC 10:5">iita miishshi dees;</para>
  <para style="q2" vid="ECC 10:5">hessika dere haarizaadefe</para>
  <para style="q2" vid="ECC 10:5">keziza bala.<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>Eeyati keehi dhoqqasohon uttiin</para>
  <para style="q2" vid="ECC 10:6">dureti hirki ziqqa sohon uttida.<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>Aylleti daannata mala togan bishin</para>
  <para style="q2" vid="ECC 10:7">daannati qasse aylleta mala</para>
  <para style="q2" vid="ECC 10:7">tohon bishin be7adis.<verse eid="ECC 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>Olla bookkiza asi he ollan</para>
  <para style="q2" vid="ECC 10:8">izi kundana;</para>
  <para style="q2" vid="ECC 10:8">qasse dirsa laalliza as</para>
  <para style="q2" vid="ECC 10:8">shooshshi dukkana.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 7:15">Maza 7:15</ref>; <ref loc="PRO 26:27">Leemi 26:27</ref></char></note><verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>Shuch dhoqallizay</para>
  <para style="q2" vid="ECC 10:9">he shuchchaan deshettees;</para>
  <para style="q2" vid="ECC 10:9">qasse mith qerizay</para>
  <para style="q2" vid="ECC 10:9">he miththaan qohettees.<verse eid="ECC 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>Dun7e kaltta leefontta ooththiko</para>
  <para style="q2" vid="ECC 10:10">daro wolqqa wursees;</para>
  <para style="q2" vid="ECC 10:10">gido attiin hiillan ooththiko</para>
  <para style="q2" vid="ECC 10:10">oosoza ayfisees.<verse eid="ECC 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>Shooshshi muurennon</para>
  <para style="q2" vid="ECC 10:11">jallanaappe sinththan dukkiko</para>
  <para style="q2" vid="ECC 10:11">muurennizaade aykkoka go7enna.<verse eid="ECC 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>Aadho eranchchaa doonappe</para>
  <para style="q2" vid="ECC 10:12">keziza qaalay</para>
  <para style="q2" vid="ECC 10:12">puulan kumidaaza;</para>
  <para style="q2" vid="ECC 10:12">gido attiin eeyay barkka</para>
  <para style="q2" vid="ECC 10:12">ba inxarsan dhayees.<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>Koyroppe doommidi</para>
  <para style="q2" vid="ECC 10:13">iza qaalay eeyateththa;</para>
  <para style="q2" vid="ECC 10:13">wurseththankka iita goosh gidees.<verse eid="ECC 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14"/>Eeyay haasaya darssees;</para>
  <para style="q2" vid="ECC 10:14">buroppe hananayssa</para>
  <para style="q2" vid="ECC 10:14">erizay deenna;</para>
  <para style="q2" vid="ECC 10:14">hayqqidaades izappe</para>
  <para style="q2" vid="ECC 10:14">guyen hananayssa</para>
  <para style="q2" vid="ECC 10:14">oonee izas yootana dandayzay?<verse eid="ECC 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>Eeya oosoy</para>
  <para style="q2" vid="ECC 10:15">ooththizaade daaburssees;</para>
  <para style="q2" vid="ECC 10:15">izi katama</para>
  <para style="q2" vid="ECC 10:15">gaththiza oge erenna.<verse eid="ECC 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>Hanne ne kawoy</para>
  <para style="q2" vid="ECC 10:16">yelaga gididaaree!</para>
  <para style="q2" vid="ECC 10:16">Ne daannati wonttara</para>
  <para style="q2" vid="ECC 10:16">gibira giigsiza biittayee</para>
  <para style="q2" vid="ECC 10:16">nees aayye ana!<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>Hanne ne kawoy bonchchettida</para>
  <para style="q2" vid="ECC 10:17">zareppe gididaaree!</para>
  <para style="q2" vid="ECC 10:17">maththottanaas</para>
  <para style="q2" vid="ECC 10:17">gidontta minettanaas</para>
  <para style="q2" vid="ECC 10:17">koshshiza wode miza daannati</para>
  <para style="q2" vid="ECC 10:17">diza biittayee!</para>
  <para style="q2" vid="ECC 10:17">Neni anjjettidaaro.<verse eid="ECC 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>Addey azalla gidikko</para>
  <para style="q2" vid="ECC 10:18">kaaray yarphattees;</para>
  <para style="q2" vid="ECC 10:18">iza kusheti daaburkko</para>
  <para style="q2" vid="ECC 10:18">keeththi aaththees.<verse eid="ECC 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>Gibiray miicisees;</para>
  <para style="q2" vid="ECC 10:19">woyne ushshi as ufayssees;</para>
  <para style="q2" vid="ECC 10:19">miishshi diikko miishshi hanees.<verse eid="ECC 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>Qofankka gidiin kawo kadhoppa;</para>
  <para style="q2" vid="ECC 10:20">ne aqiza kifilen dashe</para>
  <para style="q2" vid="ECC 10:20">dure qanggofa;</para>
  <para style="q2" vid="ECC 10:20">qefen piradhdhizaara</para>
  <para style="q2" vid="ECC 10:20">ne gizayssa</para>
  <para style="q2" vid="ECC 10:20">efa gaththana dandayawus.<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s1">Aadho Eranchchay Ooththana Bessiza Ooso</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1"/>Ne kath haaththan yegga;</para>
  <para style="q2" vid="ECC 11:1">daro gallassatappe guye</para>
  <para style="q2" vid="ECC 11:1">neni zaara demmana.<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>Nees diza aqo laappun woykko</para>
  <para style="q2" vid="ECC 11:2">osppun sohon</para>
  <para style="q2" vid="ECC 11:2">shaakereththa woththa;</para>
  <para style="q2" vid="ECC 11:2">ays giikko biitta bolla</para>
  <para style="q2" vid="ECC 11:2">ay iitay yaanaakko neni erakka.<verse eid="ECC 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>Shaaray karexxiko</para>
  <para style="q2" vid="ECC 11:3">biittaa bolla iray bukkees.</para>
  <para style="q2" vid="ECC 11:3">Miththi pudeha woykko</para>
  <para style="q2" vid="ECC 11:3">dugeha kundiko</para>
  <para style="q2" vid="ECC 11:3">ba kundidason ichchi attees.<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>Carko hanota naagizay zerenna;</para>
  <para style="q2" vid="ECC 11:4">qasse shaara mallizay</para>
  <para style="q2" vid="ECC 11:4">ba kath shiishshenna.<verse eid="ECC 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>Carkoy awara bizaakko</para>
  <para style="q2" vid="ECC 11:5">iza oge erakka;</para>
  <para style="q2" vid="ECC 11:5">qasse shemppoy woykko ayanay</para>
  <para style="q2" vid="ECC 11:5">aayi ulon diza medheta giddon</para>
  <para style="q2" vid="ECC 11:5">waani gelizaakko ne erakka.</para>
  <para style="q2" vid="ECC 11:5">Hessaththoka ubbaa</para>
  <para style="q2" vid="ECC 11:5">medhdhida Xoossa ooso</para>
  <para style="q2" vid="ECC 11:5">ne shaakka erana dandayakka.<verse eid="ECC 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>Maaladora ne zereth zera;</para>
  <para style="q2" vid="ECC 11:6">omarsika ne kushey</para>
  <para style="q2" vid="ECC 11:6">ooso birshofo;</para>
  <para style="q2" vid="ECC 11:6">gaasoykka hayssi woykko hessi,</para>
  <para style="q2" vid="ECC 11:6">woykko nam7ay lo7anaakko,</para>
  <para style="q2" vid="ECC 11:6">woykko awayssi ayfanaakko</para>
  <para style="q2" vid="ECC 11:6">ne erakka.<verse eid="ECC 11:6"/></para>
  <para style="s1">Yelagateththan Nena Medhdhidayssa Qoppa</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>Poo7oy lo7o;</para>
  <para style="q2" vid="ECC 11:7">awa ayfe be7oy</para>
  <para style="q2" vid="ECC 11:7">ayfe ufayssees.<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>Asi keehi adussa layth</para>
  <para style="q2" vid="ECC 11:8">ha sa7an de7ikko</para>
  <para style="q2" vid="ECC 11:8">he ubbaankka ufayetto.</para>
  <para style="q2" vid="ECC 11:8">Gido attiin dhuma gallassati</para>
  <para style="q2" vid="ECC 11:8">dariza gishshas qoppo;</para>
  <para style="q2" vid="ECC 11:8">buro yaana miishshi</para>
  <para style="q2" vid="ECC 11:8">ubbayka hada.<verse eid="ECC 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9"/>Haysso yelagazoo!</para>
  <para style="q2" vid="ECC 11:9">Ne naateteththa</para>
  <para style="q2" vid="ECC 11:9">layththan ufayetta;</para>
  <para style="q2" vid="ECC 11:9">ne naateteththa layththan</para>
  <para style="q2" vid="ECC 11:9">ne wozinan ufayetta;</para>
  <para style="q2" vid="ECC 11:9">ne ayfey xeellida ubbaanne</para>
  <para style="q2" vid="ECC 11:9">ne wozinay amottida ubbaa pola;</para>
  <para style="q2" vid="ECC 11:9">gido attiin ne ooththida ooso</para>
  <para style="q2" vid="ECC 11:9">ubbaa gishshas Xoossi nena</para>
  <para style="q2" vid="ECC 11:9">pirdas shiishshanayssa era.<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>Hessa gishshas ne wozinappe</para>
  <para style="q2" vid="ECC 11:10">ceece haassa;</para>
  <para style="q2" vid="ECC 11:10">iita miishshika neeppe digga;</para>
  <para style="q2" vid="ECC 11:10">gaasoykka naateteththinne yelagateththi</para>
  <para style="q2" vid="ECC 11:10">elle aadhdhana.<verse eid="ECC 11:10"/></para>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>Meto gallassati yontta dishin</para>
  <para style="q2" vid="ECC 12:1">neni, «Tana ufayssettenna»</para>
  <para style="q2" vid="ECC 12:1">giza wodeti gakkontta dishin</para>
  <para style="q2" vid="ECC 12:1">ne yelagateththa layththan</para>
  <para style="q2" vid="ECC 12:1">nena Medhdhidayssa qoppa.<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>Awaynne poo7oy,</para>
  <para style="q2" vid="ECC 12:2">aginaynne xoolinttey</para>
  <para style="q2" vid="ECC 12:2">dhumontta dishin,</para>
  <para style="q2" vid="ECC 12:2">iray bukki simmiin</para>
  <para style="q2" vid="ECC 12:2">shaaray kichchontta dishin</para>
  <para style="q2" vid="ECC 12:2">nena Medhdhidayssa qoppa.<verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>Keeth naagizayti kokkoriza wode,</para>
  <para style="q2" vid="ECC 12:3">minoti kuunniza wode,</para>
  <para style="q2" vid="ECC 12:3">gaaccizayti qoodan guuth gidida</para>
  <para style="q2" vid="ECC 12:3">gishshas gaachche aggiza wode,</para>
  <para style="q2" vid="ECC 12:3">maskootera xeellizayti</para>
  <para style="q2" vid="ECC 12:3">doljumiza wode,<verse eid="ECC 12:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 12:4"/>dubbushaso efiza ogeti</para>
  <para style="q2" vid="ECC 12:4">gordettiza wode,</para>
  <para style="q2" vid="ECC 12:4">woxay loocetidi</para>
  <para style="q2" vid="ECC 12:4">giireth aggiza wode,</para>
  <para style="q2" vid="ECC 12:4">kafo waasoy as denththiza wode,</para>
  <para style="q2" vid="ECC 12:4">istta yeththika daaburza wode,<verse eid="ECC 12:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 12:5"/>pudunth kessi xooniza wode,</para>
  <para style="q2" vid="ECC 12:5">oge buussi babisiza wode,</para>
  <para style="q2" vid="ECC 12:5">ochcholooney ciiyiza wode,</para>
  <para style="q2" vid="ECC 12:5">booley barkka bana</para>
  <para style="q2" vid="ECC 12:5">goochchiza wode,</para>
  <para style="q2" vid="ECC 12:5">asappe amoy dhayza wode</para>
  <para style="q2" vid="ECC 12:5">asi ba mernaa keeth baana;</para>
  <para style="q2" vid="ECC 12:5">yeekkizaytikka balen yuuyana.<verse eid="ECC 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>Bira sansalatay</para>
  <para style="q2" vid="ECC 12:6">duuxxontta dishin,</para>
  <para style="q2" vid="ECC 12:6">worqqa saaney</para>
  <para style="q2" vid="ECC 12:6">meqqontta dishin,</para>
  <para style="q2" vid="ECC 12:6">haaththa otoy pultto achchan</para>
  <para style="q2" vid="ECC 12:6">meqqontta dishin,</para>
  <para style="q2" vid="ECC 12:6">haath ollafe kessiza waagumboy</para>
  <para style="q2" vid="ECC 12:6">meqerettontta dishin,<verse eid="ECC 12:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 12:7"/>biittay duge biittan</para>
  <para style="q2" vid="ECC 12:7">simmontta dishin,</para>
  <para style="q2" vid="ECC 12:7">shemppoy immida Xoossako</para>
  <para style="q2" vid="ECC 12:7">simmontta dishin,</para>
  <para style="q2" vid="ECC 12:7">nena Medhdhida</para>
  <para style="q2" vid="ECC 12:7">Xoossako simma.<verse eid="ECC 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8"/>Eranchchazi, «Hada!</para>
  <para style="q2" vid="ECC 12:8">Hadappeka hada!</para>
  <para style="q2" vid="ECC 12:8">Ubbayka hada!» gees.<verse eid="ECC 12:8"/></para>
  <para style="s1">Kuushsha Qofa</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>Eranchchazi ba hu7es aadho eranchcha xalla gidontta asaakka erateth tamaarsides. Daro leemisota pilggi xeellidaappe guyen maaran maaran giigsides. <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>Eranchchazi suure qaala demmanaas pilggides; izi xaafidayssi suurenne tuma.<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>Aadho eranchcha qaalay cikka mala hoxe; qasse iza tossetikka addafe dhishkettida dhishke mala; heytikka issi heenththanchchafe imettidayta.<verse eid="ECC 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 12:12"/>Ta naazoo! Ha ubbaafe bollara</para>
  <para style="q2" vid="ECC 12:12">ay miishshafekka naagetta;</para>
  <para style="q2" vid="ECC 12:12">aykkoka gujjofa;</para>
  <para style="q2" vid="ECC 12:12">daro maxaafata xaafikkoka</para>
  <para style="q2" vid="ECC 12:12">wurseththi deenna;</para>
  <para style="q2" vid="ECC 12:12">xinaate daroy bolla daaburssees.<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>Hekko ubbaa miishshi yootettides;</para>
  <para style="q2" vid="ECC 12:13">yo7o ubbaas kuushshi hayssa;</para>
  <para style="q2" vid="ECC 12:13">Xoossas yayya; iza azazo naaga;</para>
  <para style="q2" vid="ECC 12:13">hessika asa naas</para>
  <para style="q2" vid="ECC 12:13">imettida kumeththa ooso.<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>Xoossay ooso ubbaa bolla,</para>
  <para style="q2" vid="ECC 12:14">geemmida yo7o ubbaa bolla,</para>
  <para style="q2" vid="ECC 12:14">lo7o gidiin</para>
  <para style="q2" vid="ECC 12:14">iita gidiinkka pirdana.<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
