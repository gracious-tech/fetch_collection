<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Gamo Full Bible final version</book>
  <para style="h">Iyu7eele Tinbite</para>
  <para style="toc1">Iyu7eele Tinbite</para>
  <para style="toc2">Iyu7eele Tinbite</para>
  <para style="toc3">Iyu</para>
  <para style="mt1">Iyu7eele Tinbite</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Nabe Iyu7eeli hayssa biitta bolla aydeppe ayde gakkanaas de7idaakko iza duussa gishshas erettiza daro miishshi deenna; gido attiin maxaafazi beettiday Kirstoosi yelettanaappe kase 500 layththa heeran woykko 400 layththa heeran gidana geetetti qofettees. Hessi he wodezikka Paarise kawoteththa wodenna; Iyu7eeli Isra7eele deren wolqqama booley dendidi daro miish mooriin koshay biitta bolla dendidayssa yootees; heyti he hanoti Godaa yuussa gallassay matishin iza geeshsha qofaara eqettizayta ubbaa izi qaxxayanayssa gujjidi erisees. Nabezi derey maaroteththan gelana mala Xoossi asaa xeygizayssa qoncciseththan asay maaroteththan gelikko izikka beni dereza hanoteththaako simmidi deraa anjjanayssa asaa qofsees; iza tinbiteza giddofe keehi qoncci beettiza ufayssa qaalay Xoossi maccanne attuma naateththata bolla, cimata bolla, dereza ubbaa bollaka ba Ayana yeddanayssa qonccisees.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Boolenne morkke ola <char style="ior"><ref loc="JOL 1:1-2:17">1:1—2:17</ref> </char></para>
  <para style="io1">Godaa gallas <char style="ior"><ref loc="JOL 2:18-32">2:18-32</ref> </char></para>
  <para style="io1">GODAY kawoteththata qaxxayana qaxxayo <char style="ior"><ref loc="JOL 3:1-21">3:1-21</ref> </char></para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="s1">Booley Gaththida Qoho</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Sinththafe hananayssa Xoossi Iyu7eeles yootida qaalay hayssa;<verse eid="JOL 1:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 1:2" />intte cimati hayssa siyite;</para>
  <para style="q2" vid="JOL 1:2">Yuhuda deren dizayti wurikka</para>
  <para style="q2" vid="JOL 1:2">hayssa ezgi siyite.</para>
  <para style="q1" vid="JOL 1:2">Hayssa mala hanoy kase</para>
  <para style="q2" vid="JOL 1:2">intte wode gidiin woykko</para>
  <para style="q2" vid="JOL 1:2">kase intte aawata wode</para>
  <para style="q2" vid="JOL 1:2">hani erizee?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Intte hayssa intte naytas yootite;</para>
  <para style="q2" vid="JOL 1:3">intte nayti qasse</para>
  <para style="q2" vid="JOL 1:3">bantta naytas yootetto;</para>
  <para style="q2" vid="JOL 1:3">nayta naytikka</para>
  <para style="q2" vid="JOL 1:3">kaalliza yeletas yootetto.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Gondoy mishin attida kaththaa</para>
  <para style="q2" vid="JOL 1:4">biitta maate</para>
  <para style="q2" vid="JOL 1:4">booley mides;</para>
  <para style="q2" vid="JOL 1:4">izappe attidayssa uusho carkoththo</para>
  <para style="q2" vid="JOL 1:4">shociza di7o mala booley dhayssides;</para>
  <para style="q2" vid="JOL 1:4">izappe attidayssa qasse</para>
  <para style="q2" vid="JOL 1:4">gumbaroy mides.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Hessafe guye woyne ushshu</para>
  <para style="q2" vid="JOL 1:5">intte demmontta</para>
  <para style="q2" vid="JOL 1:5">gishshas yeekkite;</para>
  <para style="q2" vid="JOL 1:5">intteno maththottizaytoo!</para>
  <para style="q2" vid="JOL 1:5">Intte dhiskizasoppe</para>
  <para style="q2" vid="JOL 1:5">beeggidi waassite;</para>
  <para style="q2" vid="JOL 1:5">intteno wonttan wonttan</para>
  <para style="q2" vid="JOL 1:5">woyne ushshu uyizaytoo!</para>
  <para style="q2" vid="JOL 1:5">Camo yeeho yeekkite.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Qooday baynda booley</para>
  <para style="q2" vid="JOL 1:6">ola asa mala</para>
  <para style="q2" vid="JOL 1:6">ta dereza bolla yides;</para>
  <para style="q2" vid="JOL 1:6">iza achchay</para>
  <para style="q2" vid="JOL 1:6">gaammo achcha mala;</para>
  <para style="q2" vid="JOL 1:6">iza gaagina achchay</para>
  <para style="q2" vid="JOL 1:6">macca gaammo</para>
  <para style="q2" vid="JOL 1:6">gaagina achcha mala.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 9:8">Ajju 9:8</ref></char></note><verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Ta woyne miththa ayfeza</para>
  <para style="q2" vid="JOL 1:7">mulera dhayssides;</para>
  <para style="q2" vid="JOL 1:7">balase geetettiza miththa</para>
  <para style="q2" vid="JOL 1:7">ubbaa menththereththides;</para>
  <para style="q2" vid="JOL 1:7">miththa haggati</para>
  <para style="q2" vid="JOL 1:7">mulera booxxana gakkanaas</para>
  <para style="q2" vid="JOL 1:7">poqoza mulera poqqi</para>
  <para style="q2" vid="JOL 1:7">denththichides.<verse eid="JOL 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Hessa gishshas izo ekkana</para>
  <para style="q2" vid="JOL 1:8">giigsidayssi hayqqiin</para>
  <para style="q2" vid="JOL 1:8">maaqa may7ada yeekkiza</para>
  <para style="q2" vid="JOL 1:8">geela7oy mala intteka yeekkite.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />GODAA Keeththan yarshos shiiqana</para>
  <para style="q2" vid="JOL 1:9">kath gidiin woykko</para>
  <para style="q2" vid="JOL 1:9">woyne ushshay baynda gishshas</para>
  <para style="q2" vid="JOL 1:9">GODAAS ooththiza qeeseti</para>
  <para style="q2" vid="JOL 1:9">yeekkeettes.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Goyidi zerida kaththay meli dhayiin</para>
  <para style="q2" vid="JOL 1:10">woyne miththay tokettidi</para>
  <para style="q2" vid="JOL 1:10">melida gishshas zaytey dhaydes;</para>
  <para style="q2" vid="JOL 1:10">hessa gishshas</para>
  <para style="q2" vid="JOL 1:10">biittaya yeekkawus.<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Gistteynne banggay haraykka</para>
  <para style="q2" vid="JOL 1:11">bone kaththi wurikka</para>
  <para style="q2" vid="JOL 1:11">dhayda gishshas</para>
  <para style="q2" vid="JOL 1:11">intteno goshshanchchatoo</para>
  <para style="q2" vid="JOL 1:11">ceecite;</para>
  <para style="q2" vid="JOL 1:11">intteno, woyne miththata</para>
  <para style="q2" vid="JOL 1:11">godatikka yeekkite.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Woyne miththatinne balase</para>
  <para style="q2" vid="JOL 1:12">miththati shullida;</para>
  <para style="q2" vid="JOL 1:12">oroomaanenne temire miththati,</para>
  <para style="q2" vid="JOL 1:12">laadeynne hara ayfe ayfiza</para>
  <para style="q2" vid="JOL 1:12">miththati wurikka melida;</para>
  <para style="q2" vid="JOL 1:12">hessa gaason addafe</para>
  <para style="q2" vid="JOL 1:12">ufayssi asappe haakkides.<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fqa" closed="false">Laade: </char><char style="ft" closed="false">Laade geetettizayssi issi issi bagga gamoththo qaalan dhano geetettees.</char></note><verse eid="JOL 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Intte intte Xoossa</para>
  <para style="q2" vid="JOL 1:13">yarsho shiishshiza kath gidiin</para>
  <para style="q2" vid="JOL 1:13">woykko woyne ushshi</para>
  <para style="q2" vid="JOL 1:13">baynda gishshas</para>
  <para style="q2" vid="JOL 1:13">intteno ta Godaa</para>
  <para style="q2" vid="JOL 1:13">oosanchchata gidida</para>
  <para style="q2" vid="JOL 1:13">qeesetoo! Ane haa yiidi</para>
  <para style="q2" vid="JOL 1:13">maaqa may7idi</para>
  <para style="q2" vid="JOL 1:13">kumeththa omars yeekkite.</para>
  <para style="q2" vid="JOL 1:13">Intteno yarsho yarshizason</para>
  <para style="q2" vid="JOL 1:13">ooththizaytoo!</para>
  <para style="q2" vid="JOL 1:13">Intte, «Wuu! Wuy!» gi waassite.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Dumma xooma gallas awajjite;</para>
  <para style="q2" vid="JOL 1:14">ayana shiiqos asa xeygite;</para>
  <para style="q2" vid="JOL 1:14">deren diza cimatanne asaa ubbaa</para>
  <para style="q2" vid="JOL 1:14">nu GODAA keeththan shiishshidi</para>
  <para style="q2" vid="JOL 1:14">pude GODAAKKO waassite.<verse eid="JOL 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Aye ana! GODAA gallassi matides.</para>
  <para style="q2" vid="JOL 1:15">Ubbaa dandayza Xoossay</para>
  <para style="q2" vid="JOL 1:15">dhayssizaaz ehiza</para>
  <para style="q2" vid="JOL 1:15">gallassi gakkides.</para>
  <para style="q2" vid="JOL 1:15">He gallassays aayye ana!<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">Isa 13:6</ref></char></note><verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Kaththi nu sinththafe dhaydes;</para>
  <para style="q2" vid="JOL 1:16">ufayssinne ilisi nu Xoossa</para>
  <para style="q2" vid="JOL 1:16">Keeththafe mule dhaydes.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Zerettida kaththay wuri</para>
  <para style="q2" vid="JOL 1:17">biitta garsan</para>
  <para style="q2" vid="JOL 1:17">wooqqi dhaydes;</para>
  <para style="q2" vid="JOL 1:17">kaththi biittafe dhayda gishshas</para>
  <para style="q2" vid="JOL 1:17">kase kath woththiza miishshati</para>
  <para style="q2" vid="JOL 1:17">wurikka mela deettes.</para>
  <para style="q2" vid="JOL 1:17">Gootaratikka laalettida.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Mehey miza maatay gaden</para>
  <para style="q2" vid="JOL 1:18">baynda gishshas</para>
  <para style="q2" vid="JOL 1:18">meheti koshattidi waasseettes;</para>
  <para style="q2" vid="JOL 1:18">dorsa wudetikka maatay dhayiin</para>
  <para style="q2" vid="JOL 1:18">daro waaye bolla deettes.<verse eid="JOL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />GODAWU! Demba maata ubbaa</para>
  <para style="q2" vid="JOL 1:19">tamay mida gishshas</para>
  <para style="q2" vid="JOL 1:19">wora miththaaka</para>
  <para style="q2" vid="JOL 1:19">tamay mida gishshas</para>
  <para style="q2" vid="JOL 1:19">ta neekko waassays.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Shaafati melida gishshas</para>
  <para style="q2" vid="JOL 1:20">demban diza maatay wurikka</para>
  <para style="q2" vid="JOL 1:20">xuugettida gishshas</para>
  <para style="q2" vid="JOL 1:20">wora do7atikka</para>
  <para style="q2" vid="JOL 1:20">neekko waasseettes.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Xoossa Yuussa Gallas Bessiza Malata</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Xiyoonen zaye zayite;</para>
  <para style="q2" vid="JOL 2:1">geeshsha zuma bolla waassite!</para>
  <para style="q2" vid="JOL 2:1">GODAA yuussa</para>
  <para style="q2" vid="JOL 2:1">gallassi gakkida gishshas</para>
  <para style="q2" vid="JOL 2:1">biitta bolla dizay</para>
  <para style="q2" vid="JOL 2:1">wurikka kokkoro.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />He gallassay dhumanne</para>
  <para style="q2" vid="JOL 2:2">tulala gallassa;</para>
  <para style="q2" vid="JOL 2:2">shaaranne sakkanna</para>
  <para style="q2" vid="JOL 2:2">dhuma gallassa;</para>
  <para style="q2" vid="JOL 2:2">wontta poo7oy eeson</para>
  <para style="q2" vid="JOL 2:2">zumata gakkiza mala</para>
  <para style="q2" vid="JOL 2:2">wolqqama booley</para>
  <para style="q2" vid="JOL 2:2">biitta ubbaan may7ana;</para>
  <para style="q2" vid="JOL 2:2">hessa malay</para>
  <para style="q2" vid="JOL 2:2">hayssafe kase hanibeenna;</para>
  <para style="q2" vid="JOL 2:2">hayssafe guyenkka</para>
  <para style="q2" vid="JOL 2:2">wodenkka hanenna.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />He booleti ba sinththan beettidaazi</para>
  <para style="q2" vid="JOL 2:3">ubbaa tama mala maana;</para>
  <para style="q2" vid="JOL 2:3">tama laco mala xuuggana;</para>
  <para style="q2" vid="JOL 2:3">buro istta gakkontta biittay</para>
  <para style="q2" vid="JOL 2:3">Edene gannate mala</para>
  <para style="q2" vid="JOL 2:3">cilila biitta shin</para>
  <para style="q2" vid="JOL 2:3">istti gakki aadhdhida biittay</para>
  <para style="q2" vid="JOL 2:3">aykkoy baynda</para>
  <para style="q2" vid="JOL 2:3">bazzo biitta gidana;</para>
  <para style="q2" vid="JOL 2:3">booleti mishin attida</para>
  <para style="q2" vid="JOL 2:3">miishshika beettenna.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Isttas medhay para mala;</para>
  <para style="q2" vid="JOL 2:4">istta buussay</para>
  <para style="q2" vid="JOL 2:4">ola para buussa mala.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Para-gaare giirissa mala</para>
  <para style="q2" vid="JOL 2:5">giiris sissishe</para>
  <para style="q2" vid="JOL 2:5">zumata bollara guppeettes;</para>
  <para style="q2" vid="JOL 2:5">tamay buura miza mala</para>
  <para style="q2" vid="JOL 2:5">beettida miishsha</para>
  <para style="q2" vid="JOL 2:5">ubbaa xuuggana;</para>
  <para style="q2" vid="JOL 2:5">giigettida mino olanchchata</para>
  <para style="q2" vid="JOL 2:5">salfe mala giireettes.<note caller="-" style="x"><char style="xo" closed="false">2:4-5 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">Ajju 9:7-9</ref></char></note><verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Istta be7idi derey kokkorana;</para>
  <para style="q2" vid="JOL 2:6">asa ayfesoy wurikka</para>
  <para style="q2" vid="JOL 2:6">babon boottana.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Ola qarata mala</para>
  <para style="q2" vid="JOL 2:7">gede sinththe beettes;</para>
  <para style="q2" vid="JOL 2:7">olanchchata mala</para>
  <para style="q2" vid="JOL 2:7">dirsa bollara guppi aadhdhana;</para>
  <para style="q2" vid="JOL 2:7">wurikka sitti giidi</para>
  <para style="q2" vid="JOL 2:7">gede sinththe baana;</para>
  <para style="q2" vid="JOL 2:7">ba biza ogeppe hara oge beettenna.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Issoy issaara sugetettenna;</para>
  <para style="q2" vid="JOL 2:8">issoy issoy ba oge yeddenna;</para>
  <para style="q2" vid="JOL 2:8">ba morkke ola miish ubbaa</para>
  <para style="q2" vid="JOL 2:8">dhayssidi aadhdhi baana;</para>
  <para style="q2" vid="JOL 2:8">aykkoyka istta teqqenna.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Istti katamaza worajjana;</para>
  <para style="q2" vid="JOL 2:9">katama gimbeza bolla</para>
  <para style="q2" vid="JOL 2:9">istti woxxana;</para>
  <para style="q2" vid="JOL 2:9">guppi guppidi</para>
  <para style="q2" vid="JOL 2:9">keeththata bolla kezana;</para>
  <para style="q2" vid="JOL 2:9">kayso mala maskootera</para>
  <para style="q2" vid="JOL 2:9">soo gelana.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Biittay istta sinththan kokkorana</para>
  <para style="q2" vid="JOL 2:10">saloykka qaaxxana;</para>
  <para style="q2" vid="JOL 2:10">awa ayfeynne aginay dhumana;</para>
  <para style="q2" vid="JOL 2:10">xoolintteyka poo7o immenna.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 8:12">Ajju 8:12</ref></char></note><verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />GODAY ba olanchchata</para>
  <para style="q2" vid="JOL 2:11">sinththan dada mala guummana;</para>
  <para style="q2" vid="JOL 2:11">iza olanchchati ay mala daroo!</para>
  <para style="q2" vid="JOL 2:11">Iza azazo ooththizayti</para>
  <para style="q2" vid="JOL 2:11">ay mala wolqqamaa!</para>
  <para style="q2" vid="JOL 2:11">tumappeka GODAA gallassay</para>
  <para style="q2" vid="JOL 2:11">keehi wolqqama;</para>
  <para style="q2" vid="JOL 2:11">keehi babisiza he gallassaa</para>
  <para style="q2" vid="JOL 2:11">danday eqqanay oonee?<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 6:17">Ajju 6:17</ref></char></note><verse eid="JOL 2:11" /></para>
  <para style="s1">Maareteththa Xeys</para>
  <para style="p">
    <verse number="12" style="v" sid="JOL 2:12" />GODAY, «Ha7ikka gidikko</para>
  <para style="q2" vid="JOL 2:12">xooman yeehoninne ceecen intte</para>
  <para style="q2" vid="JOL 2:12">kumeththa wozinappe</para>
  <para style="q2" vid="JOL 2:12">ha taakko simmite.<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Intte intte kayo bessanaas</para>
  <para style="q2" vid="JOL 2:13">may7o daaketh xalla gidenna;</para>
  <para style="q2" vid="JOL 2:13">hessafe bollara intte wozinay</para>
  <para style="q2" vid="JOL 2:13">meqqiin maarettite;</para>
  <para style="q2" vid="JOL 2:13">GODAA intte Xoossay</para>
  <para style="q2" vid="JOL 2:13">kiyanne maariza Xoossa,</para>
  <para style="q2" vid="JOL 2:13">hanqoska eesotenna;</para>
  <para style="q2" vid="JOL 2:13">mernaa siiqon izi durenne</para>
  <para style="q2" vid="JOL 2:13">qaxxayanaas eesotontta Xoossa;</para>
  <para style="q2" vid="JOL 2:13">hessa gishshas</para>
  <para style="q2" vid="JOL 2:13">intte izakko simmite.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Oonee erizay GODAA intte Xoossay</para>
  <para style="q2" vid="JOL 2:14">ba hanqoza zaaridi</para>
  <para style="q2" vid="JOL 2:14">inttena anjjanaakko,</para>
  <para style="q2" vid="JOL 2:14">intteka he wode</para>
  <para style="q2" vid="JOL 2:14">GODAA intte Xoossas</para>
  <para style="q2" vid="JOL 2:14">kaththa yarshonne</para>
  <para style="q2" vid="JOL 2:14">ushsha yarsho shiishshandeta.<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Xiyoone zuma bolla zaye punnite;</para>
  <para style="q2" vid="JOL 2:15">dereza ayana shiiqos xeygite;</para>
  <para style="q2" vid="JOL 2:15">xoomakka awajjite.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Dereza ubbaa issi soo shiishshite;</para>
  <para style="q2" vid="JOL 2:16">geeshsha duulatas giigsite;</para>
  <para style="q2" vid="JOL 2:16">cimata xeygite;</para>
  <para style="q2" vid="JOL 2:16">naytanne buro dhammiza</para>
  <para style="q2" vid="JOL 2:16">naytakka ubbaa shiishshite;</para>
  <para style="q2" vid="JOL 2:16">mishiratikka mishira keeththafe</para>
  <para style="q2" vid="JOL 2:16">attontta kezetto.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />GODAAS ooththiza qeesetikka</para>
  <para style="q2" vid="JOL 2:17">yarsho yarshizasozassinne</para>
  <para style="q2" vid="JOL 2:17">asi simerettizaso</para>
  <para style="q2" vid="JOL 2:17">giddon eqqidi yeekketto;</para>
  <para style="m" vid="JOL 2:17">GODAWU! Neni ne derezas qadhetta;</para>
  <para style="q2" vid="JOL 2:17">kawoteththati istta Xoossay</para>
  <para style="q2" vid="JOL 2:17">awan dizee?</para>
  <para style="q2" vid="JOL 2:17">giidi nuna kadhanaassinne</para>
  <para style="q2" vid="JOL 2:17">istti nu bolla</para>
  <para style="q2" vid="JOL 2:17">miicci kaa7ana mala</para>
  <para style="q2" vid="JOL 2:17">ne istta ooththofa» getto.<verse eid="JOL 2:17" /></para>
  <para style="s1">Goday Ba Deraas Immida Hidota</para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />GODAY biittays diza</para>
  <para style="q2" vid="JOL 2:18">misheteththafe dendidayssan</para>
  <para style="q2" vid="JOL 2:18">ba derezas qadhettides.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />Hessa gishshas GODAY,</para>
  <para style="q2" vid="JOL 2:19">«Intte kath, woyne ushshinne</para>
  <para style="q2" vid="JOL 2:19">wogara zayte kallana gakkanaas</para>
  <para style="q2" vid="JOL 2:19">ta inttes immanaas</para>
  <para style="q2" vid="JOL 2:19">hayssafe guye</para>
  <para style="q2" vid="JOL 2:19">kawoteththati inttena</para>
  <para style="q2" vid="JOL 2:19">baas kaassa miish histtana mala</para>
  <para style="q2" vid="JOL 2:19">ta isttas aaththa immike.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />Pudehappe yaana olanchchata</para>
  <para style="q2" vid="JOL 2:20">ta inttefe haassana;</para>
  <para style="q2" vid="JOL 2:20">duge bazzo zaara gooddana;</para>
  <para style="q2" vid="JOL 2:20">sinththati yizayta duge</para>
  <para style="q2" vid="JOL 2:20">hayqo abban yeddana;</para>
  <para style="q2" vid="JOL 2:20">guyera yizayta Mediteraane</para>
  <para style="q2" vid="JOL 2:20">abban yeddana;</para>
  <para style="q2" vid="JOL 2:20">heen istta ahay zeeqqana;</para>
  <para style="q2" vid="JOL 2:20">tumappe tani GODAY</para>
  <para style="q2" vid="JOL 2:20">gita miish ooththadis.<verse eid="JOL 2:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="JOL 2:21" />Biittayee babbofa;</para>
  <para style="q2" vid="JOL 2:21">GODAY nees ooththida</para>
  <para style="q2" vid="JOL 2:21">gita miishsha gishshas ufayetta!<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Intteno biitta bolla diza</para>
  <para style="q2" vid="JOL 2:22">do7atoo babbofte;</para>
  <para style="q2" vid="JOL 2:22">kase intte izan heemettiza</para>
  <para style="q2" vid="JOL 2:22">gadey cililides;</para>
  <para style="q2" vid="JOL 2:22">miththatikka ayfida; balaseynne</para>
  <para style="q2" vid="JOL 2:22">woyne miththay</para>
  <para style="q2" vid="JOL 2:22">keehi daro ayfides.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Intteno Xiyoone deretoo,</para>
  <para style="q2" vid="JOL 2:23">GODAAN intte Xoossan</para>
  <para style="q2" vid="JOL 2:23">ufayssi ooththite;</para>
  <para style="q2" vid="JOL 2:23">izi tumu pirdidi</para>
  <para style="q2" vid="JOL 2:23">badhdhesa iranne</para>
  <para style="q2" vid="JOL 2:23">ofinththa ira wogara immides.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Intte kase kath bukkiza balen</para>
  <para style="q2" vid="JOL 2:24">kaththi kumana;</para>
  <para style="q2" vid="JOL 2:24">woyne ushshinne</para>
  <para style="q2" vid="JOL 2:24">wogara miththa zaytey</para>
  <para style="q2" vid="JOL 2:24">kase isttan gum7ettiza</para>
  <para style="q2" vid="JOL 2:24">ollata kumi palahana.<verse eid="JOL 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Hayssafe kase wolqqama olanchcha</para>
  <para style="q2" vid="JOL 2:25">misatiza ta yeddida uusho</para>
  <para style="q2" vid="JOL 2:25">carkoththo shociza booleti,</para>
  <para style="q2" vid="JOL 2:25">gumbarotinne gondoti,</para>
  <para style="q2" vid="JOL 2:25">kase mida kaththaa gishshas</para>
  <para style="q2" vid="JOL 2:25">ta inttes zaara immana.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Intte buro daro miidi kallana;</para>
  <para style="q2" vid="JOL 2:26">inttes malalisiza miishshata</para>
  <para style="q2" vid="JOL 2:26">ta ooththida gishshas</para>
  <para style="q2" vid="JOL 2:26">intte tana GODAA</para>
  <para style="q2" vid="JOL 2:26">intte Xoossaa galatana;</para>
  <para style="q2" vid="JOL 2:26">hayssafe guye ta deraa</para>
  <para style="q2" vid="JOL 2:26">yeellay gakkenna.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Isra7eele asatoo</para>
  <para style="q2" vid="JOL 2:27">tani intte giddon dizayssanne</para>
  <para style="q2" vid="JOL 2:27">GODAA intte Xoossi</para>
  <para style="q2" vid="JOL 2:27">tana xalla gididayssanne</para>
  <para style="q2" vid="JOL 2:27">taappe haray bayndayssa</para>
  <para style="q2" vid="JOL 2:27">intte erana;</para>
  <para style="q2" vid="JOL 2:27">hessafe guye ta dereza</para>
  <para style="q2" vid="JOL 2:27">yeellay gakkenna» gides.<verse eid="JOL 2:27" /></para>
  <para style="s1">Godaa Gallassa</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28" />GODAY, «Hayssafe guye</para>
  <para style="q2" vid="JOL 2:28">tani asa ubbaa bolla</para>
  <para style="q2" vid="JOL 2:28">ta Ayana gussana;</para>
  <para style="q2" vid="JOL 2:28">intte macca naytinne attuma</para>
  <para style="q2" vid="JOL 2:28">nayti tinbite haasayana;</para>
  <para style="q2" vid="JOL 2:28">cima asaykka agumo agumettana;</para>
  <para style="q2" vid="JOL 2:28">yelaga naateththati ajjuuta beyana.<note caller="-" style="x"><char style="xo" closed="false">2:28-32 </char><char style="xt" closed="false"><ref loc="ACT 2:17-21">Hawa 2:17-21</ref></char></note><verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Hessaththoka he gallassatan</para>
  <para style="q2" vid="JOL 2:29">taas ooththiza maccassa bollanne</para>
  <para style="q2" vid="JOL 2:29">attumasa bolla tani</para>
  <para style="q2" vid="JOL 2:29">ta Ayana gussana.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Saloninne sa7an malalisiza</para>
  <para style="q2" vid="JOL 2:30">miishshata ta bessana;</para>
  <para style="q2" vid="JOL 2:30">suuththi, tamaynne</para>
  <para style="q2" vid="JOL 2:30">cuwa tuussi beettana.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Gita babisiza Godaa gallassay</para>
  <para style="q2" vid="JOL 2:31">yaanaappe kasetidi</para>
  <para style="q2" vid="JOL 2:31">arshey dhumana;</para>
  <para style="q2" vid="JOL 2:31">aginaykka suuth aaththana.<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">Mato 24:29</ref>; <ref loc="MRK 13:24-25">Mar 13:24-25</ref>; <ref loc="LUK 21:25">Luqa 21:25</ref>; <ref loc="REV 6:12-13">Ajju 6:12-13</ref></char></note><verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />GODAA sunth xeygizay</para>
  <para style="q2" vid="JOL 2:32">wurikka attana;</para>
  <para style="q2" vid="JOL 2:32">GODAY kase</para>
  <para style="q2" vid="JOL 2:32">yootida mala</para>
  <para style="q2" vid="JOL 2:32">Xiyoone zuma bollafenne</para>
  <para style="q2" vid="JOL 2:32">Yerusalaameppe</para>
  <para style="q2" vid="JOL 2:32">atoteththi beettana;</para>
  <para style="q2" vid="JOL 2:32">attanayta garsan GODAY</para>
  <para style="q2" vid="JOL 2:32">xeygidayti daana» gides.<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">Oro 10:13</ref></char></note><verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Kawoteththata Bolla Yida Pirda</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1" />Xoossi,</para>
  <para style="q1" vid="JOL 3:1">«He wode tani Yerusalaameppenne</para>
  <para style="q2" vid="JOL 3:1">Yuhudappe di7etti ekettida</para>
  <para style="q2" vid="JOL 3:1">miish ubbaa zaarana.<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Tani kawoteththata</para>
  <para style="q2" vid="JOL 3:2">ubbaa shiishshada</para>
  <para style="q2" vid="JOL 3:2">duge Iyoosaafixe<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Ibraaweta qaalara Iyoosaafixe guussi Xoossi pirdees guussa.</char></note></para>
  <para style="q2" vid="JOL 3:2">zulle woththana;</para>
  <para style="q2" vid="JOL 3:2">heenkka ta istta bolla pirdana;</para>
  <para style="q2" vid="JOL 3:2">gaasoykka ta dere Isra7eele asaa</para>
  <para style="q2" vid="JOL 3:2">kawoteththata giddon laallidi</para>
  <para style="q2" vid="JOL 3:2">istti biitta gishetti</para>
  <para style="q2" vid="JOL 3:2">ekkida gishshassa.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Istti ba di7i ehida</para>
  <para style="q2" vid="JOL 3:3">ta dereta gishetti ekkanaas</para>
  <para style="q2" vid="JOL 3:3">istta bolla saama yeggida;</para>
  <para style="q2" vid="JOL 3:3">layma maccassata demmanaas</para>
  <para style="q2" vid="JOL 3:3">attuma nayta aaththi immida;</para>
  <para style="q2" vid="JOL 3:3">woyne ushshu uyanaas</para>
  <para style="q2" vid="JOL 3:3">macca nayta</para>
  <para style="q2" vid="JOL 3:3">aylleteththas bayzida.<verse eid="JOL 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 3:4" />Intteno Xiroose,</para>
  <para style="q2" vid="JOL 3:4">Sidoonanne Filisxeeme asatoo!</para>
  <para style="q2" vid="JOL 3:4">Intte ay ooththishe deetii?</para>
  <para style="q2" vid="JOL 3:4">Intte ta bolla</para>
  <para style="q2" vid="JOL 3:4">halo kessana qoppeetii?</para>
  <para style="q2" vid="JOL 3:4">Intte hessa mala qoppiko</para>
  <para style="q2" vid="JOL 3:4">tanikka kasetada intte bolla</para>
  <para style="q2" vid="JOL 3:4">halo kessana.<note caller="-" style="x"><char style="xo" closed="false">3:4-8 </char><char style="xt" closed="false"><ref loc="JER 47:1-7">Er 47:1-7</ref>; <ref loc="EZK 25:15-28:26">Hizi 25:15—28:26</ref>; <ref loc="AMO 1:6-10">Amo 1:6-10</ref>; <ref loc="ZEP 2:4-7">Sofo 2:4-7</ref>; <ref loc="ZEC 9:1-7">Zaka 9:1-7</ref>; <ref loc="MAT 11:21-22">Mato 11:21-22</ref>; <ref loc="LUK 10:13-14">Luqa 10:13-14</ref></char></note><verse eid="JOL 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 3:5" />Ta bira, worqqanne</para>
  <para style="q2" vid="JOL 3:5">taas diza al7o miish</para>
  <para style="q2" vid="JOL 3:5">ubbaa intte bonqqi ekkidi</para>
  <para style="q2" vid="JOL 3:5">intte eeqa keeth gelththideta.<verse eid="JOL 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 3:6" />Yuhudanne Yerusalaame yeletata</para>
  <para style="q2" vid="JOL 3:6">istta dere dhassafe haassi efidi</para>
  <para style="q2" vid="JOL 3:6">Girike asas bayzideta.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />«Hekko tani ha7i istti bayzetti dizasoppe istta denththeththada zaarana; intte istta bolla gaththida qohoza ta intte bolla zaara ehana. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Intte macca naytinne attuma nayti Yuhuda asaas bayzettana mala ta ooththana; isttika haaho deren diza Saabaane asaas aaththi bayzana; hayssa wursa yootiday tana GODAA.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />«Hayssa ubbaa</para>
  <para style="q2" vid="JOL 3:9">kawoteththatas awajjite!</para>
  <para style="q2" vid="JOL 3:9">olas giigettite!</para>
  <para style="q2" vid="JOL 3:9">ola qarata denththeththite!</para>
  <para style="q2" vid="JOL 3:9">Intte olanchchati ubbay</para>
  <para style="q2" vid="JOL 3:9">kezidi morkketa oletto!<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Maarasha giththa mashsha qoxxite;</para>
  <para style="q2" vid="JOL 3:10">baaca qasse toora qoxxite;</para>
  <para style="q2" vid="JOL 3:10">laafaykka bana,</para>
  <para style="q2" vid="JOL 3:10">‹Tani mino asa› go.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="ISA 2:4">Isa 2:4</ref>; <ref loc="MIC 4:3">Miki 4:3</ref></char></note><verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Intteno yuuyi aadhdhanaas diza kawoteththatoo!</para>
  <para style="q2" vid="JOL 3:11">Intte wurikka eeson kezite!</para>
  <para style="q2" vid="JOL 3:11">Hirki shoobban issi bolla shiiqite.</para>
  <para style="q2" vid="JOL 3:11">GODAWU, neni</para>
  <para style="q2" vid="JOL 3:11">ne olanchchata kiita!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />«Kawoteththati ubbay dendidi</para>
  <para style="q2" vid="JOL 3:12">duge Iyoosaafixe shoobba betto;</para>
  <para style="q2" vid="JOL 3:12">tani Xoossay intte yuushon diza</para>
  <para style="q2" vid="JOL 3:12">kawoteththata bolla pirdanaas</para>
  <para style="q2" vid="JOL 3:12">ta heen uttana.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Istta iitateththi keehi darides;</para>
  <para style="q2" vid="JOL 3:13">hessa gishshas kaxxida kaththi</para>
  <para style="q2" vid="JOL 3:13">baacan cakettiza mala</para>
  <para style="q2" vid="JOL 3:13">istta cakkite;</para>
  <para style="q2" vid="JOL 3:13">woyne miththa ayfey</para>
  <para style="q2" vid="JOL 3:13">gum7ettizason kumidi</para>
  <para style="q2" vid="JOL 3:13">yedhettiza mala</para>
  <para style="q2" vid="JOL 3:13">intte istta yedhettite» gides.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">Ajju 14:14-16</ref>,<ref loc="REV 14:19-20">19-20</ref>; <ref loc="REV 19:15">19:15</ref></char></note><verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Yo7o pirdiza zullen</para>
  <para style="q2" vid="JOL 3:14">GODAY pirdiza gallassi gakkides;</para>
  <para style="q2" vid="JOL 3:14">hessa gishshas daro derey</para>
  <para style="q2" vid="JOL 3:14">heen shiiqi uttides.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />He gallas arsheynne</para>
  <para style="q2" vid="JOL 3:15">aginay dhumana;</para>
  <para style="q2" vid="JOL 3:15">xoolintteyka poo7enna.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />GODAY Xiyoone zumaa bolla</para>
  <para style="q2" vid="JOL 3:16">Yerusalaamen dishe</para>
  <para style="q2" vid="JOL 3:16">babisiza ba qaala giiris sissana;</para>
  <para style="q2" vid="JOL 3:16">saloynne sa7ay qaaxxana;</para>
  <para style="q2" vid="JOL 3:16">GODAY gidikko</para>
  <para style="q2" vid="JOL 3:16">ba dere Isra7eeles</para>
  <para style="q2" vid="JOL 3:16">shiiqi attizaso gidana.<verse eid="JOL 3:16" /></para>
  <para style="s1">Xoossa Deraa Anjjeteth</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />«Isra7eele asawu! He wode tani</para>
  <para style="q2" vid="JOL 3:17">GODAA intte Xoossa gididayssa</para>
  <para style="q2" vid="JOL 3:17">intte erana;</para>
  <para style="q2" vid="JOL 3:17">tani geesh gidida ta zuma</para>
  <para style="q2" vid="JOL 3:17">Xiyoone bolla de7ana;</para>
  <para style="q2" vid="JOL 3:17">Yerusalaamey anjjettida</para>
  <para style="q2" vid="JOL 3:17">katama gidana;</para>
  <para style="q2" vid="JOL 3:17">hessafe guye hara allaga wottadaray</para>
  <para style="q2" vid="JOL 3:17">izo worajjenna.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />«He wode zumati wurikka</para>
  <para style="q2" vid="JOL 3:18">woyne miththan kumana;</para>
  <para style="q2" vid="JOL 3:18">zumbullan daro maaththa miizati</para>
  <para style="q2" vid="JOL 3:18">heemettana;</para>
  <para style="q2" vid="JOL 3:18">GODAA Keeththafe</para>
  <para style="q2" vid="JOL 3:18">pulttoy pulttana;</para>
  <para style="q2" vid="JOL 3:18">Yuhuda deren diza shaafata</para>
  <para style="q2" vid="JOL 3:18">ubbaa haaththi kumana;</para>
  <para style="q2" vid="JOL 3:18">Shiixime shoobbay haath kallana.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Gibxe asaynne Eedoome asay</para>
  <para style="q2" vid="JOL 3:19">Yuhuda asaa bolla</para>
  <para style="q2" vid="JOL 3:19">gene ooththida gishshas</para>
  <para style="q2" vid="JOL 3:19">qasseka xillo asaa wodhida gishshas</para>
  <para style="q2" vid="JOL 3:19">Gibxey bazzo gidana;</para>
  <para style="q2" vid="JOL 3:19">Eedoomey asi bayndaso gidana.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20-21" style="v" sid="JOL 3:20-21" />Hessa gakkanawu tani</para>
  <para style="q2" vid="JOL 3:20-21">halo kessontta aggida</para>
  <para style="q2" vid="JOL 3:20-21">xillota suuththa gishshas</para>
  <para style="q2" vid="JOL 3:20-21">halo kessana;</para>
  <para style="q2" vid="JOL 3:20-21">Yuhudaynne Yerusalaamey</para>
  <para style="q2" vid="JOL 3:20-21">qasse mernaas ta derey</para>
  <para style="q2" vid="JOL 3:20-21">de7izaso gidana;</para>
  <para style="q2" vid="JOL 3:20-21">tanikka Xoossay</para>
  <para style="q2" vid="JOL 3:20-21">Xiyoone zuma bolla</para>
  <para style="q2" vid="JOL 3:20-21">de7ana» gides.<verse eid="JOL 3:20-21" /></para>
  <chapter eid="JOL 3" />
</usx>