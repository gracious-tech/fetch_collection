<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gamo Full Bible final version</book>
  <para style="h">2Yohannisa Kiita</para>
  <para style="toc1">Yohannisi Xaafida Nam7anththo Kiita</para>
  <para style="toc2">2Yohannisa Kiita</para>
  <para style="toc3">2Yoha</para>
  <para style="mt1">Yohannisi</para>
  <para style="mt2">Xaafida Nam7anththo Kiita</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Nam7anththo kiitazi xaafettiday cima gidida Hawaare Yohannisan gidishin kiitazi xaafettiday issi doorettida godatteyssinne izi naytassa; oonee erizay issi Woosa Keeththan diza ammanizaytas xaafettontta aggenna. Hayssi ha qaanththa kiitazi xaafettiday asay ba garsan issoy issaara siiqettana mala qofsanaassinne wordo astamaaretappe istta timirtefekka asay naagettana malakko.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">Siiqoy ubbaafe aadheth <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">Wordo timirtefe naagettana mala qofso <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">Kuushsha qofa <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Taappe cimazappe, tumappe ta dosiza doorettida godatteyssinne izi naytas,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Godatteyssinne izi naytas gizayssi Woosa keeththan diza abaaleta (ammaniza asa) bessees. Taybo 4-5 xeella.</char></note> tana xalla gidontta tumaa erizayti wuri dosizaaris kiitettida kiita. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Gaasoykka hayssi tumay ha7ikka nu giddon dizayssanne sinththafekka mernaas daanayssa.<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>Xoossaa Aawappenne iza Naa Yesus Kirstoosappe kiyateththi, maaroteththinne saroy tumaninne siiqon nunara gido.<verse eid="2JN 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Ne naytappe baggayti Aawappe nuus imettida azazoza mala tumaan minni dizayta ta be7ida gishshas daro ufayettadis. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>Ha7ikka godatteyee! Kaseppeka dizaaro attiin ta nees hara ooraththa azazo xaafikke; hessika nuni nu giddon siiqettanayssa.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoha 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>He siiqoykka nu iza azazoza mala daanayssa; azazozikka intte koyro siyida mala siiqon daanaassa.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Yesus Kirstoosi asa asho may7idi yibeenna giza ammanontta daro baleththizayti alame bolla laalettida; heyta malay ay asikka as baleththizaadenne Kirstoosara eqettizaade. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Intte gidikko intte daabura waagaappe mela attontta malanne kumeththa woyto ekkana mala intte hu7es naagettite. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Kirstoosa timirte mala dontta asinne iza timirtefe balettidi kare keziza asan oonankka Xoossi deenna; Kirstoosa timirten dizaadey gidikko izas Aawaynne Aawaa Nay deettes. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>Oonikka intteko yishe hessa he timirteza ekki yontta as mokki ekkoftenne saroka goopite. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Mokki ekkidi baso gelththizaadey hessaade ooson izara issino gidees.<verse eid="2JN 1:11"/></para>
  <para style="s1">Wurseththa Saroka</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Ta inttes xaafanaas koyza daro miishshi deessishin waraqataninne qalamen xaafana mala koykke; gidikkoka nu ufayssay kumeth gidana mala ta intteko baada intte sinththan inttenara haasayanaas hidota ooththays. <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>Doorettida ne michchey nayti nena saro geettes.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
