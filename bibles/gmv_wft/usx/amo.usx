<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Gamo Full Bible final version</book>
  <para style="h">Amoxe Tinbite</para>
  <para style="toc1">Amoxe Tinbite</para>
  <para style="toc2">Amoxe Tinbite</para>
  <para style="toc3">Amo</para>
  <para style="mt1">Amoxe Tinbite</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Amoxes tinbite haasaya erateththi deenna; izi tinbite haasayo timirte tamaarbeenna. [7:14] Gido attiin izi pude haan diza kawoteththa garsan diza derezas izi kiita gaththana mala kiitettida wode Amoxey Yuhudan diza Tequhe geetettiza kase izi diza gutayo yeggidi bides. Izi heeppeka dendidi Isra7eele asaas erettida goynoso gidida gede Beetele katama bides. Hayssa ha maxaafazan koyro bolla Amoxey dereza Amatees; hessafe Isra7eele asa harappeka lo7o duussi diza dureta amatees. He dureti dereza bonqqidi baas aylle histti haaranaas isttas gita wolqqay dees. Isttafe daroti goynnanaas hara eeqa Xoossati diikkoka istta naagizay GODAA gididayssa ba wozinan qoppeettes. Amoxey gidikko istti ba nagara gishshas qaxxayettanayssa isttas yootides. «Iita miish ixxite lo7o gididaazi siiqite. Pirda pirdizason pirda tuccofte. Medheteththa GODAY attida Isra7eele deraa izi maarontta aggenna.» [5:15]</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Dereti ba mooron qaxxayeteth <char style="ior"><ref loc="AMO 1:1-3:2">1:1—3:2</ref> </char></para>
  <para style="io1">Isra7eeleynne Samaariyay dhayana dhays <char style="ior"><ref loc="AMO 3:3-6:14">3:3—6:14</ref> </char></para>
  <para style="io1">Isra7eele qixaate gishshas Amoxey be7ida ichchashu ajjuutata <char style="ior"><ref loc="AMO 7:1-9:10">7:1—9:10</ref> </char></para>
  <para style="io1">Isra7eeles diza lo7o hidota <char style="ior"><ref loc="AMO 9:11-15">9:11-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>Ooziyay Yuhuda kawo; hessaththoka Iyo7aasa naa Iyorba7aamey Isra7eele kawo gidi dishin hessika biittay qaaxxanaappe nam7u layththafe sinththan Isra7eele gishshas Tequhen mehe heemmizayta giddofe Amoxey be7idi yootida qaalay hayssafe kaalli dizayssa;<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:1-7">2Kawo 15:1-7</ref>; <ref loc="2CH 26:1-23">2Taari 26:1-23</ref>; <ref loc="2KI 14:23-29">2Kawo 14:23-29</ref></char></note><verse eid="AMO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>Amoxey,</para>
  <para style="q1" vid="AMO 1:2">«GODAY Xiyooneppe</para>
  <para style="q2" vid="AMO 1:2">ba qaala dhoqqu histti sissees;</para>
  <para style="q2" vid="AMO 1:2">Yerusalaameppe giirees;</para>
  <para style="q2" vid="AMO 1:2">mehey heemettizasoti melana;</para>
  <para style="q1" vid="AMO 1:2">Qarmeloose zuman diza</para>
  <para style="q2" vid="AMO 1:2">cililati shullana» gides.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOL 3:16">Iyu 3:16</ref></char></note><verse eid="AMO 1:2"/></para>
  <para style="s1">Isra7eele Heeran Diza Dereta Bolla Yaana Pirda</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>GODAY Aaraames,</para>
  <para style="q1" vid="AMO 1:3">«Damasqo asay zaari zaaridi</para>
  <para style="q2" vid="AMO 1:3">ooththida nagara gishshas</para>
  <para style="q2" vid="AMO 1:3">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 1:3">istti Gala7aade asaa</para>
  <para style="q2" vid="AMO 1:3">birata achchara diza kath</para>
  <para style="q2" vid="AMO 1:3">bukkiza lodan bukkida.<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>Kawo Azaheele keeththan</para>
  <para style="q2" vid="AMO 1:4">tama yeddana;</para>
  <para style="q2" vid="AMO 1:4">he tamay Kawo Beeni-Hadaade</para>
  <para style="q2" vid="AMO 1:4">miixata maana.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>Damasqo katama pengeta</para>
  <para style="q2" vid="AMO 1:5">ta menththereththana;</para>
  <para style="q2" vid="AMO 1:5">Beeti-Edene dere kawozanne</para>
  <para style="q2" vid="AMO 1:5">Awe zullaan diza asaa</para>
  <para style="q2" vid="AMO 1:5">ta dhayssana;</para>
  <para style="q2" vid="AMO 1:5">Aaraame dere asaykka di7ettidi</para>
  <para style="q2" vid="AMO 1:5">gede Qiire dere baana» gees.<note caller="-" style="x"><char style="xo" closed="false">1:3-5 </char><char style="xt" closed="false"><ref loc="ISA 17:1-3">Isa 17:1-3</ref>; <ref loc="JER 49:23-27">Er 49:23-27</ref>; <ref loc="ZEC 9:1">Zaka 9:1</ref></char></note><verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>GODAY Filisxeemes,</para>
  <para style="q1" vid="AMO 1:6">«Gaaza asay zaari zaaridi ooththida</para>
  <para style="q2" vid="AMO 1:6">nagara gishshas</para>
  <para style="q2" vid="AMO 1:6">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 1:6">istta dereza ubbaa di7i efidi</para>
  <para style="q2" vid="AMO 1:6">Eedoomes bayzida.<note caller="-" style="x"><char style="xo" closed="false">1:6-8 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">Isa 14:29-31</ref>; <ref loc="JER 47:1-7">Er 47:1-7</ref>; <ref loc="EZK 25:15-17">Hizi 25:15-17</ref>; <ref loc="JOL 3:4-8">Iyu 3:4-8</ref>; <ref loc="ZEP 2:4-7">Sofo 2:4-7</ref>; <ref loc="ZEC 9:5-7">Zaka 9:5-7</ref></char></note><verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>Izi gimbeta maana mala</para>
  <para style="q2" vid="AMO 1:7">Gaaza miixan tani tama yeddana.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>Asqeloona dere kawozanne</para>
  <para style="q2" vid="AMO 1:8">Ashdoode dere asaa</para>
  <para style="q2" vid="AMO 1:8">ta pitta dhayssana;</para>
  <para style="q2" vid="AMO 1:8">Filisxeemen dizayti</para>
  <para style="q2" vid="AMO 1:8">wuri wurana gakkanaas</para>
  <para style="q2" vid="AMO 1:8">tani ta kushe Aqaroone bolla</para>
  <para style="q2" vid="AMO 1:8">denththana» gees.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>GODAY Xirooses, «Xiroose asay</para>
  <para style="q2" vid="AMO 1:9">zaari zaaridi</para>
  <para style="q2" vid="AMO 1:9">ooththida nagaraa gishshas</para>
  <para style="q2" vid="AMO 1:9">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 1:9">istti ba ishateththa</para>
  <para style="q2" vid="AMO 1:9">caaqo qaala laallidi</para>
  <para style="q2" vid="AMO 1:9">ba di7ida dereza</para>
  <para style="q2" vid="AMO 1:9">ubbaa Eedoomes bayzida.<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>Hessa gishshas tani Xiroose katama</para>
  <para style="q2" vid="AMO 1:10">gimbeta bolla tama yeddana;</para>
  <para style="q2" vid="AMO 1:10">he tamay</para>
  <para style="q2" vid="AMO 1:10">izi miixataka maana» gees.<note caller="-" style="x"><char style="xo" closed="false">1:9-10 </char><char style="xt" closed="false"><ref loc="ISA 23:1-8">Isa 23:1-8</ref>; <ref loc="EZK 26:1-28:19">Hizi 26:1—28:19</ref>; <ref loc="JOL 3:4-8">Iyu 3:4-8</ref>; <ref loc="ZEC 9:1-4">Zaka 9:1-4</ref>; <ref loc="MAT 11:21-22">Mato 11:21-22</ref>; <ref loc="LUK 10:13-14">Luqa 10:13-14</ref></char></note><verse eid="AMO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 1:11"/>GODAY Eedoomes,</para>
  <para style="q2" vid="AMO 1:11">«Eedoome asay</para>
  <para style="q2" vid="AMO 1:11">zaari zaaridi ooththida</para>
  <para style="q2" vid="AMO 1:11">nagara gishshas</para>
  <para style="q2" vid="AMO 1:11">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 1:11">istti ba ishata</para>
  <para style="q2" vid="AMO 1:11">Isra7eele naytas</para>
  <para style="q2" vid="AMO 1:11">qadhettontta mashshan gooddida;</para>
  <para style="q2" vid="AMO 1:11">ba hanqo doshisontta eexxidi</para>
  <para style="q2" vid="AMO 1:11">isttas mishettontta</para>
  <para style="q2" vid="AMO 1:11">ubbaa dippi histtida.<note caller="-" style="x"><char style="xo" closed="false">1:11-12 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Er 49:7-22</ref>; <ref loc="EZK 25:12-14">Hizi 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="OBA 1:14">Ab 14</ref>; <ref loc="MAL 1:2-5">Mil 1:2-5</ref></char></note><verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>Hessa gishshas tani</para>
  <para style="q2" vid="AMO 1:12">Temaane gimbeta bolla</para>
  <para style="q2" vid="AMO 1:12">tama yeddana;</para>
  <para style="q2" vid="AMO 1:12">he tamay</para>
  <para style="q2" vid="AMO 1:12">Booxira miixataka maana» gees.<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>GODAY Amoones,</para>
  <para style="q2" vid="AMO 1:13">«Amoone asay zaari zaaridi</para>
  <para style="q2" vid="AMO 1:13">ooththida nagara gishshas</para>
  <para style="q2" vid="AMO 1:13">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 1:13">istti dere zawa aassanaas</para>
  <para style="q2" vid="AMO 1:13">Gala7aade dere</para>
  <para style="q2" vid="AMO 1:13">shaara maccassata</para>
  <para style="q2" vid="AMO 1:13">ulo daakkida.<note caller="-" style="x"><char style="xo" closed="false">1:13-15 </char><char style="xt" closed="false"><ref loc="JER 49:1-6">Er 49:1-6</ref>; <ref loc="EZK 21:28-32">Hizi 21:28-32</ref>; <ref loc="EZK 25:1-7">25:1-7</ref>; <ref loc="ZEP 2:8-11">Sofo 2:8-11</ref></char></note><verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>Hessa gishshas Eraaba katama</para>
  <para style="q2" vid="AMO 1:14">gimbeta bolla</para>
  <para style="q2" vid="AMO 1:14">tani tama yeddana;</para>
  <para style="q2" vid="AMO 1:14">he tamay istta miixata maana.</para>
  <para style="q2" vid="AMO 1:14">Hessafe guye ola gallassan</para>
  <para style="q2" vid="AMO 1:14">waasoy darana;</para>
  <para style="q2" vid="AMO 1:14">olazikka gote carko mala</para>
  <para style="q2" vid="AMO 1:14">eesotana.<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>Istta kawoynne</para>
  <para style="q2" vid="AMO 1:15">daannati di7ettana» gees.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>GODAY Mo7aabes,</para>
  <para style="q1" vid="AMO 2:1">«Mo7aabe asay zaari zaaridi</para>
  <para style="q2" vid="AMO 2:1">ooththida nagara gishshas</para>
  <para style="q2" vid="AMO 2:1">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 2:1">istti Eedoome kawo meqeththi</para>
  <para style="q2" vid="AMO 2:1">Bidinth gidana gakkanaas xuuggida.<note caller="-" style="x"><char style="xo" closed="false">2:1-3 </char><char style="xt" closed="false"><ref loc="ISA 15:1-16:14">Isa 15:1—16:14</ref>; <ref loc="ISA 25:10-12">25:10-12</ref>; <ref loc="JER 48:1-47">Er 48:1-47</ref>; <ref loc="EZK 25:8-11">Hizi 25:8-11</ref>; <ref loc="ZEP 2:8-11">Sofo 2:8-11</ref></char></note><verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>Hessa gishshas tani Mo7aabe bolla</para>
  <para style="q2" vid="AMO 2:2">tama yeddana;</para>
  <para style="q2" vid="AMO 2:2">he tamay Qiriyaate</para>
  <para style="q2" vid="AMO 2:2">miixata maana.</para>
  <para style="q2" vid="AMO 2:2">Olanchchati maggulth,</para>
  <para style="q2" vid="AMO 2:2">waasonne zaye giiris sissishe</para>
  <para style="q2" vid="AMO 2:2">Mo7aabe asaa wodhi wursana.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>Tani istta haariza kawozanne</para>
  <para style="q2" vid="AMO 2:3">daannata ubbaa dhayssana» gees.<verse eid="AMO 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 2:4"/>GODAY Yuhuda,</para>
  <para style="q1" vid="AMO 2:4">«Yuhuda asay</para>
  <para style="q2" vid="AMO 2:4">zaari zaaridi</para>
  <para style="q2" vid="AMO 2:4">ooththida nagara gishshas</para>
  <para style="q2" vid="AMO 2:4">ta istta qaxxayontta aggike;</para>
  <para style="q2" vid="AMO 2:4">istti ta woga kadhida;</para>
  <para style="q2" vid="AMO 2:4">ta azazotakka naagontta ixxida;</para>
  <para style="q2" vid="AMO 2:4">kase istta aawati goynnida eeqa</para>
  <para style="q2" vid="AMO 2:4">xoossata kaallidi istti balettida.<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>Hessa gishshas tani Yuhuda bolla</para>
  <para style="q2" vid="AMO 2:5">tama yeddana;</para>
  <para style="q2" vid="AMO 2:5">he tamay Yerusalaame</para>
  <para style="q2" vid="AMO 2:5">miixata maana» gees.<verse eid="AMO 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>GODAY Isra7eeles,</para>
  <para style="q1" vid="AMO 2:6">«Isra7eele asay</para>
  <para style="q2" vid="AMO 2:6">zaari zaaridi ooththida</para>
  <para style="q2" vid="AMO 2:6">nagara gishshas</para>
  <para style="q2" vid="AMO 2:6">ta istta qaxxayontta aggike.</para>
  <para style="q2" vid="AMO 2:6">Xillo asata biras,</para>
  <para style="q2" vid="AMO 2:6">metotidayssa toho</para>
  <para style="q2" vid="AMO 2:6">caammas bayzida.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>Istti manqota gudulla bolla</para>
  <para style="q2" vid="AMO 2:7">genderisidi istta</para>
  <para style="q2" vid="AMO 2:7">hu7e yedhetteettes;</para>
  <para style="q2" vid="AMO 2:7">qohettidaytas geella pirdeettes;</para>
  <para style="q2" vid="AMO 2:7">aawaynne nay</para>
  <para style="q2" vid="AMO 2:7">issi maccassayra laymateettes;</para>
  <para style="q2" vid="AMO 2:7">istti hessaththo ooththi ooththidi</para>
  <para style="q2" vid="AMO 2:7">ta sunth tuniseettes.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>Asappe oyso ekettida</para>
  <para style="q2" vid="AMO 2:8">may7o hiixxidi</para>
  <para style="q2" vid="AMO 2:8">Yarsho yarshizasoza</para>
  <para style="q2" vid="AMO 2:8">garsan aqeettes;</para>
  <para style="q2" vid="AMO 2:8">istti bantta xoossa keeththan</para>
  <para style="q2" vid="AMO 2:8">edasi ekkidi woyne ushshu</para>
  <para style="q2" vid="AMO 2:8">izan uyeettes.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>«Isttas adussateththay</para>
  <para style="q2" vid="AMO 2:9">ziga miththa mala;</para>
  <para style="q2" vid="AMO 2:9">minoteththayka xiidda mala</para>
  <para style="q2" vid="AMO 2:9">gidida Amoore asaa tani</para>
  <para style="q2" vid="AMO 2:9">intte sinththafe dhayssadis;</para>
  <para style="q2" vid="AMO 2:9">ayfontta mala</para>
  <para style="q2" vid="AMO 2:9">xaphoppe shodda diggadis.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">Zaare 3:8-11</ref></char></note><verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>Tani inttes Amoore dere</para>
  <para style="q2" vid="AMO 2:10">biitta immanaas</para>
  <para style="q2" vid="AMO 2:10">inttena Gibxeppe kessadis;</para>
  <para style="q2" vid="AMO 2:10">oyddu tammu layth kumeth</para>
  <para style="q2" vid="AMO 2:10">bazzora kaaleththa</para>
  <para style="q2" vid="AMO 2:10">ehada laatissadis.<verse eid="AMO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>Qasseka tani intte</para>
  <para style="q2" vid="AMO 2:11">attuma nayta garsafe nabeta,</para>
  <para style="q2" vid="AMO 2:11">naateththata giddofe</para>
  <para style="q2" vid="AMO 2:11">naaziraaweta denththadis.</para>
  <para style="q2" vid="AMO 2:11">Isra7eele derezoo!</para>
  <para style="q2" vid="AMO 2:11">Hessi tumu gidennee?» gees.<verse eid="AMO 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 2:12"/>Xoossay, «Intte gidikko Naaziraaweta</para>
  <para style="q2" vid="AMO 2:12">woyne ushshu ushshideta;</para>
  <para style="q2" vid="AMO 2:12">nabetakka tinbite</para>
  <para style="q2" vid="AMO 2:12">yootontta mala azazideta.<verse eid="AMO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>Be7ite daro kath deexetti</para>
  <para style="q2" vid="AMO 2:13">caanettida gaarey</para>
  <para style="q2" vid="AMO 2:13">garsara diza miish liiqisiza mala</para>
  <para style="q2" vid="AMO 2:13">tanikka inttena liiqisana.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>Pilata asi kessi ekki attenna;</para>
  <para style="q2" vid="AMO 2:14">minoykka ba minoteththan</para>
  <para style="q2" vid="AMO 2:14">maadettenna;</para>
  <para style="q2" vid="AMO 2:14">wolqqamaykka</para>
  <para style="q2" vid="AMO 2:14">ba shemppo ashshenna.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>Wondafe oykkidaadey ba dizason</para>
  <para style="q2" vid="AMO 2:15">minni eqqidi ola zaarenna;</para>
  <para style="q2" vid="AMO 2:15">pilata olanchchayka</para>
  <para style="q2" vid="AMO 2:15">woxxi attenna;</para>
  <para style="q2" vid="AMO 2:15">toganchchayka ba shemppo ashshenna.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>Ola qaratikka he gallas</para>
  <para style="q2" vid="AMO 2:16">gooro kallo baqatana» gees.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">Isra7eele Asaa Bolla Gakkana Hanqo</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>Isra7eele asawu! Gibxeppe kezida Isra7eele asaas inttes GODAY yootida qaala hayssa siyite.<verse eid="AMO 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 3:2"/>Xoossay,</para>
  <para style="q1" vid="AMO 3:2">«Kumeththa alamen diza dere</para>
  <para style="q2" vid="AMO 3:2">ubbaafe ta inttena xalla dooradis;</para>
  <para style="q2" vid="AMO 3:2">intte ooththiza</para>
  <para style="q2" vid="AMO 3:2">nagara ubbaa gishshas</para>
  <para style="q2" vid="AMO 3:2">ta inttena qaxxayays» gees.<verse eid="AMO 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>Nam7u asati oge issife baana giidi</para>
  <para style="q2" vid="AMO 3:3">qachchontta aggiko</para>
  <para style="q2" vid="AMO 3:3">issife baanaas dandayzoo?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>Gaammoy wora giddon</para>
  <para style="q2" vid="AMO 3:4">aykko miza miish</para>
  <para style="q2" vid="AMO 3:4">shankkati demmontta dishe</para>
  <para style="q2" vid="AMO 3:4">coo mela xaaggi erizee?</para>
  <para style="q2" vid="AMO 3:4">Wodalla gaammoy</para>
  <para style="q2" vid="AMO 3:4">aykko miza miish</para>
  <para style="q2" vid="AMO 3:4">demmontta dishe ba dizason</para>
  <para style="q2" vid="AMO 3:4">coo mela ba qaala sissi erizee?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>Yardey woykko gitey bayndason</para>
  <para style="q2" vid="AMO 3:5">coo mela gaden</para>
  <para style="q2" vid="AMO 3:5">kafoy oyketti erizee?</para>
  <para style="q2" vid="AMO 3:5">Woykko diizay issi miishshi bana</para>
  <para style="q2" vid="AMO 3:5">bochchontta dishin</para>
  <para style="q2" vid="AMO 3:5">coo mela piri erizee?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>Katama giddon olas</para>
  <para style="q2" vid="AMO 3:6">zayey punettishin</para>
  <para style="q2" vid="AMO 3:6">babon kokkorontta asi di erizee?</para>
  <para style="q2" vid="AMO 3:6">GODAA sheney baynda dishin</para>
  <para style="q2" vid="AMO 3:6">katama bolla iita miishshi</para>
  <para style="q2" vid="AMO 3:6">gakki erizee?<verse eid="AMO 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>GODAY ba xuura ba oosanchcha</para>
  <para style="q2" vid="AMO 3:7">nabetas koyrotti yootontta dishe</para>
  <para style="q2" vid="AMO 3:7">aykkoka ooththenna.<verse eid="AMO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>Gaammoy xaaggiin siyidi</para>
  <para style="q2" vid="AMO 3:8">dagammonttay oonee?</para>
  <para style="q2" vid="AMO 3:8">GODAY ba xuura izas yootiin</para>
  <para style="q2" vid="AMO 3:8">tinbite haasayonttay oonee?<verse eid="AMO 3:8"/></para>
  <para style="s1">Samaariya Kundeth</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9"/>Ashdoodeninne Gibxen diza</para>
  <para style="q2" vid="AMO 3:9">miixatan diza ubbaas,</para>
  <para style="q2" vid="AMO 3:9">«Samaariya zumata bolla shiiqite;</para>
  <para style="q2" vid="AMO 3:9">heen isttan oosettiza</para>
  <para style="q2" vid="AMO 3:9">gene oosonne</para>
  <para style="q2" vid="AMO 3:9">bul7aketizayssa xeellite»</para>
  <para style="q2" vid="AMO 3:9">gi awajjite.<verse eid="AMO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10"/>GODAY,</para>
  <para style="q1" vid="AMO 3:10">«Hayti dereti lo7o</para>
  <para style="q2" vid="AMO 3:10">ooso erettenna.</para>
  <para style="q2" vid="AMO 3:10">Makkallaninne</para>
  <para style="q2" vid="AMO 3:10">genen ekkida miishshan</para>
  <para style="q2" vid="AMO 3:10">ba miixa kunththeettes.<verse eid="AMO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 3:11"/>Hessa gishshas intte dere</para>
  <para style="q2" vid="AMO 3:11">morkkey worajjana;</para>
  <para style="q2" vid="AMO 3:11">intte miixata laallidi</para>
  <para style="q2" vid="AMO 3:11">intte keeththaaka bonqqana» gees.<verse eid="AMO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 3:12"/>GODAY,</para>
  <para style="q2" vid="AMO 3:12">«Heenththanchchay</para>
  <para style="q2" vid="AMO 3:12">gaammo doonappe</para>
  <para style="q2" vid="AMO 3:12">dors woththi ekkiza wode</para>
  <para style="q2" vid="AMO 3:12">dorsas nam7u gedata woykko</para>
  <para style="q2" vid="AMO 3:12">duuxa hayththata</para>
  <para style="q2" vid="AMO 3:12">woththi ekkiza mala</para>
  <para style="q1" vid="AMO 3:12">Samaariya biittan ishalon uttida</para>
  <para style="q2" vid="AMO 3:12">Isra7eele asaappe guuththati</para>
  <para style="q2" vid="AMO 3:12">xalla attana» gees.<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>Salo GODAY,</para>
  <para style="q1" vid="AMO 3:13">«Hekko ane hayssa siyite!</para>
  <para style="q2" vid="AMO 3:13">Yaaqoobe zereththa bolla</para>
  <para style="q2" vid="AMO 3:13">markkattite.<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>Istti ooththida nagara gishshas</para>
  <para style="q2" vid="AMO 3:14">tani Isra7eele</para>
  <para style="q2" vid="AMO 3:14">asaa qaxxayiza wode</para>
  <para style="q2" vid="AMO 3:14">Beetelen diza</para>
  <para style="q2" vid="AMO 3:14">yarsho yarshizasohota</para>
  <para style="q2" vid="AMO 3:14">tani laallana;</para>
  <para style="q2" vid="AMO 3:14">yarshizasohota bolla diza</para>
  <para style="q2" vid="AMO 3:14">kaceti meqeretti kundana.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2Kawo 23:15</ref></char></note><verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>Istti izan bonenne balgo diza</para>
  <para style="q2" vid="AMO 3:15">keeththata ubbaa</para>
  <para style="q2" vid="AMO 3:15">ta laalla dhayssana;</para>
  <para style="q2" vid="AMO 3:15">danggarsa zaalen</para>
  <para style="q2" vid="AMO 3:15">lo7eththi alleqissida</para>
  <para style="q2" vid="AMO 3:15">keeththati wurikka laalettana;</para>
  <para style="q2" vid="AMO 3:15">gita keeththati</para>
  <para style="q2" vid="AMO 3:15">wurikka dhayana» gees.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1"/>Dhiikettida Baasaane miizata mala intte asateththa ordisida Samaariya maccassatoo! Hayssa qaala siyite! Intte daaburanchchata kawushsheeta; manqota bollaka godateeta; intte azinata, «Nuus maththosiza ushshu ehite» geeta.<verse eid="AMO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 4:2"/>Hessa gishshas GODAY ba geeshshateththan, «Inttes siidhen dafoy aadhdhiin intte baana wodey yaana; inttefe heen biitta bolla attidayti qasse manxakon oyketti biza mole mala oyketti baana.<verse eid="AMO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 4:3"/>«Inttefe issoy issoy intte matan diza lukora gooshetti gooshetti kezidi gede Herimoonen yegettana» gi caaqqides.<verse eid="AMO 4:3"/></para>
  <para style="s1">Isra7eele Asay Bantta Balappe Simmibeettenna</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4"/>GODAY, «Isra7eele derezoo!</para>
  <para style="q2" vid="AMO 4:4">Beetele biidi nagara ooththite!</para>
  <para style="q2" vid="AMO 4:4">Gelgelakka biidi</para>
  <para style="q2" vid="AMO 4:4">nagara gujji ooththite!</para>
  <para style="q2" vid="AMO 4:4">gallas gallas</para>
  <para style="q2" vid="AMO 4:4">intte yarsho yarshite!</para>
  <para style="q2" vid="AMO 4:4">heedzdzanththo gallas gallas</para>
  <para style="q2" vid="AMO 4:4">intte asraata immite.<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>Intte ooththanaas koyzay</para>
  <para style="q2" vid="AMO 4:5">hessa gidida gishshas</para>
  <para style="q2" vid="AMO 4:5">irshoy izan diza uketh</para>
  <para style="q2" vid="AMO 4:5">galata yarsho shiishshite;</para>
  <para style="q2" vid="AMO 4:5">intte hessa intte shene mala</para>
  <para style="q2" vid="AMO 4:5">shiishshiza gishshas</para>
  <para style="q2" vid="AMO 4:5">izan ceeqettite» gees.<verse eid="AMO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6"/>«Inttes doonan baadhana kaththara ta dhayssada intte katamatan ubbaan kosha yeddadis. Intte gidikko haa taakko simmibeekketa. <verse eid="AMO 4:6"/><verse number="7" style="v" sid="AMO 4:7"/>Intte kaththay gakkanaappe buro heedzdzu aginay dishin sinththata ta inttes iray bukkontta mala diggadis; issi kataman bukkishin hara kataman bukkontta mala diggadis; issi gaden bukkishin hankko issaa gaden iray dhayiin melides. <verse eid="AMO 4:7"/><verse number="8" style="v" sid="AMO 4:8"/>Asay haath uyanaas koyishe ha katamappe he katama bides; gido attiin baas gidiza haaththe demmontta aggida gishshas uyidi alanaas dandaybeettenna; intteka taakko simmibeekketa.<verse eid="AMO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9"/>«Intte kaththa melissiza harge ta kiittadis; intte intte atakiltenne woyne miththata, balasenne wogara miththata ubbaa booley mides; gido attiin intte haa taakko simmibeekketa» gees.<verse eid="AMO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10"/>«Ta kase Gibxe biitta bolla yeddida iita hargeza mala harge intte bolla yeddadis; intte naateththa nayta mashshan hayqqana mala ooththadis; intte paratakka di7ettana mala ta ooththadis; intte dizason hayqqida asa aha xinqqoy intte siidhe tuccides; intte gidikko haa taakko simmibeekketa. <verse eid="AMO 4:10"/><verse number="11" style="v" sid="AMO 4:11"/>Sodoomenne Gamoora kase ta dhayssida mala inttefe darotakka ta dhayssadis; intte attidaytikka tamay mishin attida miththa durca mala gidideta shin intte haa taakko simmibeekketa.<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Medhe 19:24</ref></char></note><verse eid="AMO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>«Intteno Isra7eele asatoo</para>
  <para style="q2" vid="AMO 4:12">tanikka intte bolla</para>
  <para style="q2" vid="AMO 4:12">hessaththo ooththana;</para>
  <para style="q2" vid="AMO 4:12">hessa gishshas intte tanara</para>
  <para style="q2" vid="AMO 4:12">intte GODAARA gayttanaas</para>
  <para style="q2" vid="AMO 4:12">ane giigettite!» gees.<verse eid="AMO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>Zumata ooththidaadey</para>
  <para style="q2" vid="AMO 4:13">carkota medhdhidaadey</para>
  <para style="q2" vid="AMO 4:13">ba qoppidayssa asas qonccisizay</para>
  <para style="q2" vid="AMO 4:13">gallassa poo7o</para>
  <para style="q2" vid="AMO 4:13">gede dhuman laammizay</para>
  <para style="q2" vid="AMO 4:13">biitta bolla dhoqqasohon</para>
  <para style="q2" vid="AMO 4:13">hemettizayssa</para>
  <para style="q2" vid="AMO 4:13">sunththay GODAA Salo Xoossa.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">Isra7eele Asaa Maareteth</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 5:1"/>Isra7eele asawu! Intte gishshas</para>
  <para style="q2" vid="AMO 5:1">ta zilaliza zilas siyite.<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>«Geela7oya Isra7eeley kundadus;</para>
  <para style="q2" vid="AMO 5:2">nam7anththo dendanaas</para>
  <para style="q2" vid="AMO 5:2">dandayukku;</para>
  <para style="q2" vid="AMO 5:2">izo maaddi denththanay</para>
  <para style="q2" vid="AMO 5:2">baynda gishshas</para>
  <para style="q2" vid="AMO 5:2">iza barkka ba deren</para>
  <para style="q2" vid="AMO 5:2">kunda attana.»<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>Ubbaa Haariza GODAY,</para>
  <para style="q2" vid="AMO 5:3">«Isra7eele katama issineyppe</para>
  <para style="q2" vid="AMO 5:3">1,000 olanchchati olas baanashin</para>
  <para style="q2" vid="AMO 5:3">isttafe hayqqontta paxa attanay</para>
  <para style="q2" vid="AMO 5:3">100 asata xalla gidana;</para>
  <para style="q2" vid="AMO 5:3">hara katamappeka 100</para>
  <para style="q2" vid="AMO 5:3">ola asati olas baanashin</para>
  <para style="q2" vid="AMO 5:3">isttafe 10 asi xalla</para>
  <para style="q2" vid="AMO 5:3">simmi yaana» gides.<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>GODAY Isra7eele asaas,</para>
  <para style="q1" vid="AMO 5:4">«Isra7eele asawu!</para>
  <para style="q2" vid="AMO 5:4">Haa taakko simmite;</para>
  <para style="q2" vid="AMO 5:4">intte hayqqontta de7ana.<verse eid="AMO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5"/>Intte Bersaabehe boopite;</para>
  <para style="q2" vid="AMO 5:5">Beeteley laalettada</para>
  <para style="q2" vid="AMO 5:5">mulera dhayana;</para>
  <para style="q2" vid="AMO 5:5">Gelgelan diza asay di7ettana;</para>
  <para style="q2" vid="AMO 5:5">hessa gishshas Beetele gidiin</para>
  <para style="q2" vid="AMO 5:5">woykko Gelgela boopite» gides.<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>Haa Xoossaako simmite;</para>
  <para style="q2" vid="AMO 5:6">histtiko intte shemppora</para>
  <para style="q2" vid="AMO 5:6">paxa de7ana;</para>
  <para style="q2" vid="AMO 5:6">akkay giikko Xoossi</para>
  <para style="q2" vid="AMO 5:6">tama mala</para>
  <para style="q2" vid="AMO 5:6">Isra7eele deraa maana;</para>
  <para style="q2" vid="AMO 5:6">Beetelen dizaytakka</para>
  <para style="q2" vid="AMO 5:6">tamay maana;</para>
  <para style="q2" vid="AMO 5:6">he tama toyssanay</para>
  <para style="q2" vid="AMO 5:6">isttas beettenna.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>Intteno pirda geellasizaytoo!</para>
  <para style="q2" vid="AMO 5:7">Tumakka gede wordon</para>
  <para style="q2" vid="AMO 5:7">laammizayto</para>
  <para style="q2" vid="AMO 5:7">inttes aayye ana!<verse eid="AMO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>Piliyaadise geetettiza laappun</para>
  <para style="q2" vid="AMO 5:8">xoolinttetanne</para>
  <para style="q2" vid="AMO 5:8">Oryoone geetettiza</para>
  <para style="q2" vid="AMO 5:8">issi bolla diza</para>
  <para style="q2" vid="AMO 5:8">xoolintteta medhdhiday</para>
  <para style="q2" vid="AMO 5:8">gallassaa omarsan,</para>
  <para style="q2" vid="AMO 5:8">omarsa gallassan laammizay,</para>
  <para style="q2" vid="AMO 5:8">abba haath azazidi</para>
  <para style="q2" vid="AMO 5:8">biitta bolla gogissizay,<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="JOB 9:9">Iyo 9:9</ref>; <ref loc="JOB 38:31">38:31</ref></char></note><verse eid="AMO 5:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="AMO 5:9"/>wolqqamatanne istta miixata</para>
  <para style="q2" vid="AMO 5:9">laalli dhayssizay iza;</para>
  <para style="q2" vid="AMO 5:9">izas sunththayka Xoossa.<verse eid="AMO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>Intte qasse inttena pirdason</para>
  <para style="q2" vid="AMO 5:10">hanqizaade ixxeeta;</para>
  <para style="q2" vid="AMO 5:10">tumu haasayzaadekka kadheeta.<verse eid="AMO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>Manqota un7eththeeta;</para>
  <para style="q2" vid="AMO 5:11">istta wolqqara kath giiriseeta;</para>
  <para style="q2" vid="AMO 5:11">inttes masettida shuchchafe</para>
  <para style="q2" vid="AMO 5:11">keeth keexxideta shin</para>
  <para style="q2" vid="AMO 5:11">he keeththan deekketa.</para>
  <para style="q2" vid="AMO 5:11">Aradda biittan woyne miththa</para>
  <para style="q2" vid="AMO 5:11">tokkideta shin izappe</para>
  <para style="q2" vid="AMO 5:11">agettida woyne ushshu uyekketa.<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>Intte qohoy ay mala darokkonne</para>
  <para style="q2" vid="AMO 5:12">intte nagaray ay mala deexokko</para>
  <para style="q2" vid="AMO 5:12">ta erays;</para>
  <para style="q2" vid="AMO 5:12">intte xillo asata un7eththeeta;</para>
  <para style="q2" vid="AMO 5:12">matta7e ekkidi pirdason</para>
  <para style="q2" vid="AMO 5:12">manqotas geella pirdeeta.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>Hessa gishshas he wode</para>
  <para style="q2" vid="AMO 5:13">wodey iita gidida gishshas</para>
  <para style="q2" vid="AMO 5:13">akeekay diza asi co7u gees.<verse eid="AMO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14"/>Intte shemppora paxa de7ana mala lo7oppe attiin iita ooththofte; intte hessaththo ooththiko intte gida mala GODAY Salo Xoossay inttenara gidana. <verse eid="AMO 5:14"/><verse number="15" style="v" sid="AMO 5:15"/>Iita miish ixxite; lo7o gididaaz dosite; pirda pirdizason tumu pirda geellasopite. GODAY Salo Xoossay attida Isra7eele asaa maaranaakko oonee erizay?<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>Hessa gishshas GODAY Salo Xoossay,</para>
  <para style="q1" vid="AMO 5:16">«Oge bollanne dubbushay dizason</para>
  <para style="q2" vid="AMO 5:16">ubbaan waasoynne yeehoy</para>
  <para style="q2" vid="AMO 5:16">siyettana;</para>
  <para style="q2" vid="AMO 5:16">goshshanchchati koyssas</para>
  <para style="q2" vid="AMO 5:16">zilalizayti yeehos xeygettana.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>Woyne miththi tokettizason</para>
  <para style="q2" vid="AMO 5:17">ubbaan yeeho xalla gidana;</para>
  <para style="q2" vid="AMO 5:17">hessika wuri hananay ta intte</para>
  <para style="q2" vid="AMO 5:17">giddora aadhdhiza gishshassa» gees.<verse eid="AMO 5:17"/></para>
  <para style="s1">Xoossa Pirda Gallassa</para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>Intteno GODAA gallas naagizaytoo!</para>
  <para style="q2" vid="AMO 5:18">Inttes aayye ana!</para>
  <para style="q2" vid="AMO 5:18">He gallassay dhumappe attiin</para>
  <para style="q2" vid="AMO 5:18">poo7o gallas gidontta gishshas</para>
  <para style="q2" vid="AMO 5:18">intte ays he gallassa koyeetii?<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>He gallassay asi gaammofe attanaas</para>
  <para style="q2" vid="AMO 5:19">qotettishe zardora gaaggiza mala</para>
  <para style="q2" vid="AMO 5:19">woykko kessi ekki baso gelidi</para>
  <para style="q2" vid="AMO 5:19">ba kushen keeththa goda oykkiin</para>
  <para style="q2" vid="AMO 5:19">shooshshi dukkida mala hanana.<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>GODAY pirdiza gallassay</para>
  <para style="q2" vid="AMO 5:20">inttes dhumappe attiin</para>
  <para style="q2" vid="AMO 5:20">poo7o gidenna;</para>
  <para style="q2" vid="AMO 5:20">he gallassay izan</para>
  <para style="q2" vid="AMO 5:20">aykko poo7oykka baynda</para>
  <para style="q2" vid="AMO 5:20">girdi gida dhuma gidana.<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>«Tani intte layththan</para>
  <para style="q2" vid="AMO 5:21">layththan bonchchiza</para>
  <para style="q2" vid="AMO 5:21">ba7aaleza kadhayssinne ixxays;</para>
  <para style="q2" vid="AMO 5:21">intte goynos shiiqiza shiiqoykka</para>
  <para style="q2" vid="AMO 5:21">tana ufayssenna.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>Taman xuugettiza yarshonne</para>
  <para style="q2" vid="AMO 5:22">kaththa yarsho</para>
  <para style="q2" vid="AMO 5:22">intte taas shiishshikokka</para>
  <para style="q2" vid="AMO 5:22">ta hessa inttefe ekkike;</para>
  <para style="q2" vid="AMO 5:22">dhiikettida intte mehetappe</para>
  <para style="q2" vid="AMO 5:22">intte taas issifeteththa</para>
  <para style="q2" vid="AMO 5:22">yarshos shiishshiko</para>
  <para style="q2" vid="AMO 5:22">ta iza ayfenka xeellike.<note caller="-" style="x"><char style="xo" closed="false">5:21-22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">Isa 1:11-14</ref></char></note><verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>Intte yexxishe</para>
  <para style="q2" vid="AMO 5:23">ta hayththan kaccofte;</para>
  <para style="q2" vid="AMO 5:23">intte diiththa giiris</para>
  <para style="q2" vid="AMO 5:23">ta siyanaas koykke.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>Gido attiin tumu pirday</para>
  <para style="q2" vid="AMO 5:24">goggiza haaththa mala;</para>
  <para style="q2" vid="AMO 5:24">xilloteththika miccontta</para>
  <para style="q2" vid="AMO 5:24">pultto mala goggo.<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>«Isra7eele asawu!</para>
  <para style="q2" vid="AMO 5:25">Tumappe intte oyddu tammu</para>
  <para style="q2" vid="AMO 5:25">layth bazzo biittan diza wode</para>
  <para style="q2" vid="AMO 5:25">tumu yarshonne kaththa xeera</para>
  <para style="q2" vid="AMO 5:25">taas shiishshidetii?<note caller="-" style="x"><char style="xo" closed="false">5:25-27 </char><char style="xt" closed="false"><ref loc="ACT 7:42-43">Hawa 7:42-43</ref></char></note><verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>Intte inttes ooththida,</para>
  <para style="q2" vid="AMO 5:26">‹Kawo Zakute› geetettiza</para>
  <para style="q2" vid="AMO 5:26">eeqa xoossaza;</para>
  <para style="q2" vid="AMO 5:26">qasseka, ‹Kewene› geetettiza</para>
  <para style="q2" vid="AMO 5:26">intte medhdhi kessida xoolintte</para>
  <para style="q2" vid="AMO 5:26">misatiza eeqa xoossata tookkideta.<verse eid="AMO 5:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="AMO 5:27"/>Tani inttena Damasqofe gede haassa gooddana» gees GODAY Salo Xoossay.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">Isra7eele Qaxxayeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1"/>Xiyoonen badhdhi gi uttidaytoo! Samaariya zuma bolla hirgay baynda dizaytoo! Isra7eele asay maado koyidi intteko yizaytoo! Intteno dere halaqatoo! Inttes aayye ana! <verse eid="AMO 6:1"/><verse number="2" style="v" sid="AMO 6:2"/>Ane intte gede Kalanahe katama biidi xeellite; heeppeka aadhdhidi Hamaate geetetti xeygettiza gita katamayonne duge Filisxeeme katama Geete wodhdhite; istti intte nam7u kawoteththatappe lo7izoo? Istta biittay intte biittafe aakkizee? <verse eid="AMO 6:2"/><verse number="3" style="v" sid="AMO 6:3"/>Intte qasse, «Iita gallassi elle gakkenna» giza qofan intte daannateththan gene ooso eesoseeta. <verse eid="AMO 6:3"/><verse number="4" style="v" sid="AMO 6:4"/>Intte danggarsa zaaleppe oosettida algan ichcheeta; ohala laaqqa ashonne mara asho mishe soofa bolla utti shempeeta. <verse eid="AMO 6:4"/><verse number="5" style="v" sid="AMO 6:5"/>Dawite mala yeththa miish inttes giigsidi bagananinne dumma dumma mazamure yexxizaytoo! <verse eid="AMO 6:5"/><verse number="6" style="v" sid="AMO 6:6"/>Woyne ushshu birillera gidontta otora uyizaytoo! Keehi al7o gidida shitto tiyettizaytoo! Isra7eele deraa bolla gakkida meto gishshas qadhettonttayto inttena aayye ana!<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>Hessa gishshas heera asappe</para>
  <para style="q2" vid="AMO 6:7">koyro intte di7ettana;</para>
  <para style="q2" vid="AMO 6:7">he wode intte kase ufayssan</para>
  <para style="q2" vid="AMO 6:7">guppiza gufaynne</para>
  <para style="q2" vid="AMO 6:7">badhdhi gi diza duussi attana.<verse eid="AMO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>GODAY Salo Xoossay,</para>
  <para style="q1" vid="AMO 6:8">«Isra7eele asa otoreteththaa</para>
  <para style="q2" vid="AMO 6:8">tani harassettadis;</para>
  <para style="q2" vid="AMO 6:8">istta miixatikka</para>
  <para style="q2" vid="AMO 6:8">tana shuunneettes;</para>
  <para style="q2" vid="AMO 6:8">hessa gishshas tani katamayonne</para>
  <para style="q2" vid="AMO 6:8">izin dizayta ubbaa</para>
  <para style="q2" vid="AMO 6:8">morkkes aaththa immana» giidi</para>
  <para style="q2" vid="AMO 6:8">barkka banan caaqqides.<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>Issi keeththan tammati attiko he attidaytikka hayqqana. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>Hayqqidaytappe issaades mata dabbo gididaadeynne moogo woga polizaadey ahaza keeththafe kessi efana; he wode izaadey soon diza issi as xeygidi, «Nenara attida hara asi dizee?» giidi iza oychchana shin izaadey qasse, «Attida asi oonikka deenna» gaana. Oychchizayssika zaaridi, «GODAA nu Xoossa sunth xeyganaas bessontta gishshas co7u ga!» gaana.<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>GODAA azazon</para>
  <para style="q2" vid="AMO 6:11">wogga keeththati laalettana;</para>
  <para style="q2" vid="AMO 6:11">guuththa keeththatikka</para>
  <para style="q2" vid="AMO 6:11">laaletti attana.<verse eid="AMO 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>Paray shuchcha bolla togettizee?</para>
  <para style="q2" vid="AMO 6:12">Goshshanchchay abba giddon</para>
  <para style="q2" vid="AMO 6:12">boora waaxi goyanaas</para>
  <para style="q2" vid="AMO 6:12">dandayzee?</para>
  <para style="q2" vid="AMO 6:12">Intte gidikko</para>
  <para style="q2" vid="AMO 6:12">pirda marzen laammideta;</para>
  <para style="q2" vid="AMO 6:12">tumakka gede camon shirdeta.<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>Intte Lodibaare katama</para>
  <para style="q2" vid="AMO 6:13">xoonida gishshas ufayettideta;<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Lodibaare geetettizayssi katama sunth gidishin Ibraaweta qaalara hada miish guussa.</char></note></para>
  <para style="q2" vid="AMO 6:13">«Qarnayme katamayo</para>
  <para style="q2" vid="AMO 6:13">nuni nu wolqqan oykkidos»</para>
  <para style="q2" vid="AMO 6:13">gidi ceeqetteeta.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Qarnayme geetettizayssi guuththa katama sunththa; Ibraaweta qaalara kacey wolqqa leemiso gidi beettees.</char></note><verse eid="AMO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14"/>GODAY Salo Xoossay,</para>
  <para style="q1" vid="AMO 6:14">«Isra7eele asawu!</para>
  <para style="q2" vid="AMO 6:14">Tani intte bolla</para>
  <para style="q2" vid="AMO 6:14">hara wolqqama dere denththana;</para>
  <para style="q2" vid="AMO 6:14">hessika pudeha baggafe</para>
  <para style="q2" vid="AMO 6:14">Hamaate pengefe doommidi</para>
  <para style="q2" vid="AMO 6:14">dugeha baggara Arabe</para>
  <para style="q2" vid="AMO 6:14">shoobba gakkanaas inttena</para>
  <para style="q2" vid="AMO 6:14">un7eththana» gees.<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">Amoxey Ajjuutan Be7ida Boole</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>GODAY ajjuutan booley yaanayssa tana bessides; hekko kawo kaththi maxetti wuridaappe guye geedora caarida azabba kaththa bolla Xoossi maate booley kezana mala ooththides. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>Boolezikka biitta bolla diza cilila ubbaa pitti midayssa tani beyada, «Ubbaafe Wolqqama GODAWU! Ne dere qohoza maararkkii! Ne dere Isra7eeles wolqqay baynda gishshas izi hayssa wostti eqetti dandayanee?» ga woossadis.<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>GODAYKKA isttas mishettidi, «Hayssi ne be7izayssi polettenna» giidi taas yootides.<verse eid="AMO 7:3"/></para>
  <para style="s1">Amoxey Ajjuutan Be7ida Pirda Tama</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>Ubbaafe Wolqqama GODAY tana ajjuuta bessides; GODAY qaxxayanaas tama pirda yeddides; tamazikka wogga gita abbaa miichchidi biitta muus oykkides. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>He wode tani, «Ubbaafe Wolqqama GODAWU! Hayssa tamaa toyssarkkii! Ne dere Isra7eeles wolqqay baynda gishshas izi hayssa wostti eqetti dandayanee?» ga woossadis.<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>GODAYKKA isttas mishettidi, «Hayssi ne be7izayssi polettenna» giidi taas yootides.<verse eid="AMO 7:6"/></para>
  <para style="s1">Amoxey Ajjuutan Be7ida Tumbe</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>GODAY tana hara ajjuuta bessides; tumben sitti gi oosettida gimbe achchan Xoossi ba kushen tumbe oykki eqqidayssa beyadis.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Tumbey gimbe gimbizayti gimbeza sitti histti gimbanaas go7ettiza miish.</char></note> <figure style="fig" alt="Builder using plumbline" file="HK00126B.TIF" size="span" ref="7:7">Gimbe gimbiza tumbe</figure> <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>Izikka, «Amoxe! Hessi ne be7izayssi izi aazee?» gi oychchides. Tanikka, «Tumbeko!» gadis. GODAY zaaridi taas, «Tumben sitti gi oosettontta gimbe mala ta dere Isra7eeley geellattides; hessa gishshas hayssi tumbezi Isra7eele nayta geellateththaa bessiza leemiso; tanikka istta qaxxayontta aggike. <verse eid="AMO 7:8"/><verse number="9" style="v" sid="AMO 7:9"/>Yisaaqinne izas naaza nayti goynniza dhoqqasohoti laalettana; Isra7eele nayti goynnizasohoti laalettana; Iyorba7aame kawoteth tani mulera dhayssana» gides.<verse eid="AMO 7:9"/></para>
  <para style="s1">Amoxenne Amasiyaase</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>Beetele qeese gidida Amasiyaasi Isra7eele kawo Iyorba7aamekko, «Hekko Amoxey Isra7eele asaa giddon uttidi ne bolla asaa denththeththees; hessa mala ooson biitta shiri yeggees. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>Izikka, ‹Iyorba7aameykka olan hayqqana; Isra7eele derey ba dereppe di7etti baana› gees» gi kiittides.<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>Amasiyaasi Amoxes, «Nenoo ajjuuta be7izayssoo! Hayssafe denda kichcha; duge Yuhuda biitta baada heen tinbite yootashe nees miza miish demma. <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>Beeteley gidikko kawoy goynnizasonne kawo duussaso gidida gishshas tinbite yootoppa» gides.<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>Amoxey Amasiyaasas, «Tani wude mehe heemmizaadenne eththa ayfe maxizaade attiin ta hu7es nabe woykko nabe naa gidikke.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fqa" closed="false">Eththa ayfe: </char><char style="ft" closed="false">Eththa ayfe geetettizayssa issi issi bagga gamoththo qaalan boobba ayfe geetettees.</char></note> <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>Gido attiin GODAY mehe heemmizasohoppe tana xeygidi, ‹Ba! Ta dere Isra7eeles tinbite yoota› giidi azaziday GODAA.<verse eid="AMO 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 7:16"/>«Ha7ikka GODAY nena gizayssa siya;</para>
  <para style="q2" vid="AMO 7:16">neni tana, ‹Isra7eele asaa bolla</para>
  <para style="q2" vid="AMO 7:16">tinbite yootoppa;</para>
  <para style="q2" vid="AMO 7:16">Yisaaqa zereth gidida Isra7eele</para>
  <para style="q2" vid="AMO 7:16">derezakka sabbakoppa›</para>
  <para style="q2" vid="AMO 7:16">ga diggadasa.<verse eid="AMO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17"/>Hessa gishshas amasiyaasa!</para>
  <para style="q2" vid="AMO 7:17">Ne gishshas GODAY,</para>
  <para style="q2" vid="AMO 7:17">‹Ne machcheya katama giddon</para>
  <para style="q2" vid="AMO 7:17">layma maccas gidana;</para>
  <para style="q2" vid="AMO 7:17">nees macca naytinne attuma</para>
  <para style="q2" vid="AMO 7:17">naytikka olan hayqqana;</para>
  <para style="q2" vid="AMO 7:17">allagati ne biitta</para>
  <para style="q2" vid="AMO 7:17">wodoron wadhdhi</para>
  <para style="q2" vid="AMO 7:17">gishetti ekkana;</para>
  <para style="q2" vid="AMO 7:17">nenikka allaga biittan hayqqana;</para>
  <para style="q2" vid="AMO 7:17">Isra7eele asay ba biittafe</para>
  <para style="q2" vid="AMO 7:17">di7ettidi allaga</para>
  <para style="q2" vid="AMO 7:17">dere baana› gees» gi yootides.<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">Amoxey Ajjuutan Be7ida Teeray Kumida Keeshe</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>Ubbaafe Wolqqama GODAY tana hara ajjuuta bessides; hessika teeray izan kumi diza keeshe. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>GODAY tana, «Hessi ne be7izayssi aazee?» gi oychchides; tanikka izas, «Teerara diza daachcho beyays» gadis; qasseka Xoossi taas, «Ta dere Isra7eeles wurseththi gakkides; hayssafe guyen tani istta qaxxayontta aggike.<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>«Istti Xoossa Keeththan sissiza yeththay he wode yeehon laamettana; daro asa ahay awan awanka kundi attana; awanka coo yegetti attana» gees.<verse eid="AMO 8:3"/></para>
  <para style="s1">Isra7eele Kundeth</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>Intteno metotida asa qohizaytoo!</para>
  <para style="q2" vid="AMO 8:4">Qasse manqota biittafe dhayssana</para>
  <para style="q2" vid="AMO 8:4">koyzaytoo! Hayssa siyite!<verse eid="AMO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5"/>Intte, «Nuni nu kaththa</para>
  <para style="q2" vid="AMO 8:5">bayzana mala</para>
  <para style="q2" vid="AMO 8:5">agina xeeron bonchchiza</para>
  <para style="q2" vid="AMO 8:5">ba7aaley ayde aadhdhaneeshaa!</para>
  <para style="q2" vid="AMO 8:5">Nuni kath giya gelththanaas</para>
  <para style="q2" vid="AMO 8:5">sambataykka nuus ayde</para>
  <para style="q2" vid="AMO 8:5">aadhdhaneeshaa!</para>
  <para style="q2" vid="AMO 8:5">He ba7aaley aadhdhiko</para>
  <para style="q2" vid="AMO 8:5">nuni maka</para>
  <para style="q2" vid="AMO 8:5">miishsha guuththidi</para>
  <para style="q2" vid="AMO 8:5">al7o waagan bayzana;</para>
  <para style="q2" vid="AMO 8:5">qasseka wordo meezaanen</para>
  <para style="q2" vid="AMO 8:5">asaa baleththana.<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>Gistte harqqoka muuruta</para>
  <para style="q2" vid="AMO 8:6">gistte waagan bayzana;</para>
  <para style="q2" vid="AMO 8:6">manqota biran, metotidaytakka</para>
  <para style="q2" vid="AMO 8:6">toho caamman shammana» geeta.<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>Yaaqoobeynne iza zereththati izan ceeqettiza GODAY, «Istti ooththida ooso ubbaa tani balikke. <verse eid="AMO 8:7"/><verse number="8" style="v" sid="AMO 8:8"/>Hayssa geedon biittay buro qaaxxana; biittay bolla dizay wurikka yeekkana; Abbaye shaafay kixxidi guummizayssaththo biitta ubbay qaaththi yoshikuyoshikana» giidi barkka banan caaqqides.<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>Ubbaafe Wolqqama GODAY, «He wode tani gallassa seetan awa arshe wulsana; gallassa seetan gade dhumisana. <verse eid="AMO 8:9"/><verse number="10" style="v" sid="AMO 8:10"/>Intte layththan layththan bonchchiza ba7aaleza yeehon laammana; intte yexxiza yeththaaka waason laammana; diza pexi issi nay hayqqiin camo yeeho yeekkiza asa mala intte intte hu7e binana buucidi maaqa may7ana mala tani inttena ooththana; he wurseththa gallassay camo gallas gidana.<verse eid="AMO 8:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="AMO 8:11"/>Hekko tani biitta bolla kosha ehana wodey yaana;</para>
  <para style="q2" vid="AMO 8:11">hessika asay Xoossa qaala</para>
  <para style="q2" vid="AMO 8:11">siyana gafanne</para>
  <para style="q2" vid="AMO 8:11">saamo attiin kaththa gafanne</para>
  <para style="q2" vid="AMO 8:11">haaththa saamo gidenna.<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>Derey wuri pudehappe</para>
  <para style="q2" vid="AMO 8:12">dugeha gakkanaas</para>
  <para style="q2" vid="AMO 8:12">arshey mokkizasoppe</para>
  <para style="q2" vid="AMO 8:12">wullizaso gakkanaas</para>
  <para style="q2" vid="AMO 8:12">GODAA qaala kosh</para>
  <para style="q2" vid="AMO 8:12">yaanne haa yeemottanashin</para>
  <para style="q2" vid="AMO 8:12">demmenna.<verse eid="AMO 8:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="AMO 8:13"/>He wode lo7o geela7otinne</para>
  <para style="q2" vid="AMO 8:13">mino panththati</para>
  <para style="q2" vid="AMO 8:13">saamoppe dendanayssan</para>
  <para style="q2" vid="AMO 8:13">daaburana.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>Samaariya deren, ‹Ashamo›</para>
  <para style="q2" vid="AMO 8:14">geetetta xeygettiza</para>
  <para style="q2" vid="AMO 8:14">eeqa xoossayn caaqqizayti,</para>
  <para style="q2" vid="AMO 8:14">‹Daane xoossay beyiin›</para>
  <para style="q2" vid="AMO 8:14">woykko, ‹Bersaabehe</para>
  <para style="q2" vid="AMO 8:14">xoossay beyiin›</para>
  <para style="q2" vid="AMO 8:14">gi caaqqizayti wurikka kundana;</para>
  <para style="q2" vid="AMO 8:14">ba kundidasohoppe mulekka</para>
  <para style="q2" vid="AMO 8:14">dendanaas dandayettenna» gees.<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">Isra7eele Bolla Yaana Pirda</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>GODAY yarsho yarshizasoza millen eqqi dishin ta beyadis;</para>
  <para style="q2" vid="AMO 9:1">izikka tana,</para>
  <para style="q2" vid="AMO 9:1">«Xoossa Keeththaa yochchay</para>
  <para style="q2" vid="AMO 9:1">qaaxxana gakkanaas</para>
  <para style="q2" vid="AMO 9:1">keeththa qustte</para>
  <para style="q2" vid="AMO 9:1">shoca laalladanne</para>
  <para style="q2" vid="AMO 9:1">asaa bolla kundana mala ooththa;</para>
  <para style="q2" vid="AMO 9:1">hessafekka attidayta</para>
  <para style="q2" vid="AMO 9:1">tani istta mashshara</para>
  <para style="q2" vid="AMO 9:1">wodha dhayssana;</para>
  <para style="q2" vid="AMO 9:1">isttafe oonikka baqatenna;</para>
  <para style="q2" vid="AMO 9:1">baqatikkoka taappe</para>
  <para style="q2" vid="AMO 9:1">kessi ekki attenna.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>Istti duufo bookki gelidaakkoka</para>
  <para style="q2" vid="AMO 9:2">ta kushey</para>
  <para style="q2" vid="AMO 9:2">istta heeppe shoddi haa kessana;</para>
  <para style="q2" vid="AMO 9:2">istti pude salo kezidaakkoka</para>
  <para style="q2" vid="AMO 9:2">tani istta heeppe</para>
  <para style="q2" vid="AMO 9:2">haa duge goochcha woththana.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>Istti pude Qarmeloose zumaa bolla</para>
  <para style="q2" vid="AMO 9:3">kezi qotettidaakkoka</para>
  <para style="q2" vid="AMO 9:3">ta kaaletta baada</para>
  <para style="q2" vid="AMO 9:3">istta heeppe woththana;</para>
  <para style="q2" vid="AMO 9:3">istti duge ciimma abba giddo</para>
  <para style="q2" vid="AMO 9:3">gelidi taappe qotettizaakkoka</para>
  <para style="q2" vid="AMO 9:3">heen istta shooshshi dukkana mala</para>
  <para style="q2" vid="AMO 9:3">ta azazana.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>Istti ba morkketa kushen</para>
  <para style="q2" vid="AMO 9:4">di7etti biikkoka</para>
  <para style="q2" vid="AMO 9:4">heen istti mashshan</para>
  <para style="q2" vid="AMO 9:4">hayqqana mala</para>
  <para style="q2" vid="AMO 9:4">ta azazana;</para>
  <para style="q2" vid="AMO 9:4">tani istta bolla</para>
  <para style="q2" vid="AMO 9:4">ta ayfe lo7os gidontta</para>
  <para style="q2" vid="AMO 9:4">iitas zaarana» gi azazides.<verse eid="AMO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>Ubbaa Haariza GODAY</para>
  <para style="q2" vid="AMO 9:5">izi biittayo bochchees;</para>
  <para style="q2" vid="AMO 9:5">izakka seerawus;</para>
  <para style="q2" vid="AMO 9:5">izin diza ubbay yeekkees;</para>
  <para style="q2" vid="AMO 9:5">Nayle shaafay</para>
  <para style="q2" vid="AMO 9:5">kixxi guummiza mala</para>
  <para style="q2" vid="AMO 9:5">biitta ubbay qaaxxees;</para>
  <para style="q2" vid="AMO 9:5">qasse zaaridi kixa haaththi</para>
  <para style="q2" vid="AMO 9:5">wodhdhiza mala wodhdhana.<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>Ba duussaso salo ooththiday,</para>
  <para style="q2" vid="AMO 9:6">salokka sa7appe bollan</para>
  <para style="q2" vid="AMO 9:6">minththiday,</para>
  <para style="q2" vid="AMO 9:6">abba haath azazidi</para>
  <para style="q2" vid="AMO 9:6">biitta bolla gogissizay</para>
  <para style="q2" vid="AMO 9:6">izas sunththay GODAA.<verse eid="AMO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7"/>GODAY, «Isra7eele asawu!</para>
  <para style="q2" vid="AMO 9:7">Intte taas</para>
  <para style="q2" vid="AMO 9:7">Tophphiya asa mala gidekketii?</para>
  <para style="q2" vid="AMO 9:7">Tani inttena</para>
  <para style="q2" vid="AMO 9:7">Gibxeppe kessoyssaththo</para>
  <para style="q2" vid="AMO 9:7">Filisxeeme asaa Qarxeeseppe</para>
  <para style="q2" vid="AMO 9:7">qasse Sooriya as</para>
  <para style="q2" vid="AMO 9:7">Qiireppe kessabeekkinaa?<verse eid="AMO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>Tani Ubbaa Haariza GODAY</para>
  <para style="q2" vid="AMO 9:8">gede nagaranchcha</para>
  <para style="q2" vid="AMO 9:8">Isra7eele asaa</para>
  <para style="q2" vid="AMO 9:8">kawoteththaako xeellays;</para>
  <para style="q2" vid="AMO 9:8">ta iza biittafe mulera dhayssana;</para>
  <para style="q2" vid="AMO 9:8">gido attiin Yaaqoobe zereth</para>
  <para style="q2" vid="AMO 9:8">ubbaa dhayssike» gees.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>«Be7ite kath</para>
  <para style="q2" vid="AMO 9:9">zayzaren zayzariza mala</para>
  <para style="q2" vid="AMO 9:9">Isra7eele asaa</para>
  <para style="q2" vid="AMO 9:9">Ayzaabe kawoteththa</para>
  <para style="q2" vid="AMO 9:9">giddon zayzarana mala</para>
  <para style="q2" vid="AMO 9:9">ta azazana;</para>
  <para style="q2" vid="AMO 9:9">gido attiin isttafe issaadeyka</para>
  <para style="q2" vid="AMO 9:9">wora wodhdhi dhayenna.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>‹Nu bolla aykko iitaykka gakkenna</para>
  <para style="q2" vid="AMO 9:10">woykko nuna bochchenna› giza</para>
  <para style="q2" vid="AMO 9:10">ta dere asaa garsan diza</para>
  <para style="q2" vid="AMO 9:10">nagaranchchati ubbay</para>
  <para style="q2" vid="AMO 9:10">olan hayqqana» gees GODAY.<verse eid="AMO 9:10"/></para>
  <para style="s1">Isra7eele Asaa Simo Hidota</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>«Coo kundi laalettida keeththa mala gidida</para>
  <para style="q2" vid="AMO 9:11">Dawite zereththata kawoteththas</para>
  <para style="q2" vid="AMO 9:11">tani zaara essana wodey yaana;</para>
  <para style="q2" vid="AMO 9:11">tani gimbeza zaara gimbana;</para>
  <para style="q2" vid="AMO 9:11">laalettidayssaka ooraxissana;</para>
  <para style="q2" vid="AMO 9:11">kaseyssaththo zaara ooththana.<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>Hessaththoka Eedoome deren</para>
  <para style="q2" vid="AMO 9:12">attidaytanne</para>
  <para style="q2" vid="AMO 9:12">ta sunththan xeygettida dereta</para>
  <para style="q2" vid="AMO 9:12">ubbaa istti laattana»</para>
  <para style="q2" vid="AMO 9:12">gees GODAY.<note caller="-" style="x"><char style="xo" closed="false">9:11-12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">Hawa 15:16-18</ref></char></note><verse eid="AMO 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13"/>«Kath maxizayti maxi wursontta</para>
  <para style="q2" vid="AMO 9:13">dishin goshsha wodey gakkees;</para>
  <para style="q2" vid="AMO 9:13">woyne ayfe gum7izaadey</para>
  <para style="q2" vid="AMO 9:13">gum7i giigontta dishin</para>
  <para style="q2" vid="AMO 9:13">woyne puute</para>
  <para style="q2" vid="AMO 9:13">tokkiza wodey gakkees;</para>
  <para style="q2" vid="AMO 9:13">he wode mal7iza lo7o woyne</para>
  <para style="q2" vid="AMO 9:13">ushshi zumaappe pulttana;</para>
  <para style="q2" vid="AMO 9:13">zumbullatappeka goggana.<verse eid="AMO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14"/>Di7etti bida Isra7eele asaa</para>
  <para style="q2" vid="AMO 9:14">haa istta dere zaara ehana;</para>
  <para style="q2" vid="AMO 9:14">laalettida katamata zaari</para>
  <para style="q2" vid="AMO 9:14">keexxidi izan de7ana;</para>
  <para style="q2" vid="AMO 9:14">istti woyne tokkidi</para>
  <para style="q2" vid="AMO 9:14">izappe agettida ushshu uyana;</para>
  <para style="q2" vid="AMO 9:14">dumma dumma ayfiza mith</para>
  <para style="q2" vid="AMO 9:14">tokkidi iza ayfe maana.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>Ta dere Isra7eele asaa</para>
  <para style="q2" vid="AMO 9:15">tani kase istta biittan</para>
  <para style="q2" vid="AMO 9:15">zaarada tokkana;</para>
  <para style="q2" vid="AMO 9:15">tani isttas immida biittafe</para>
  <para style="q2" vid="AMO 9:15">istti nam7anththo dhoqalletti</para>
  <para style="q2" vid="AMO 9:15">dhayettenna»</para>
  <para style="q2" vid="AMO 9:15">gees GODAY salo Xoossay.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
