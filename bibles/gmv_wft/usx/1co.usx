<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Gamo Full Bible final version</book>
  <para style="h">1Qorontoose Asaas</para>
  <para style="toc1">Phawuloosi Qorontoose Asaas Xaafida Koyro Kiita</para>
  <para style="toc2">1Qorontoose Asaas</para>
  <para style="toc3">1Qoro</para>
  <para style="mt2">Phawuloosi</para>
  <para style="mt1">Qorontoose Asaas</para>
  <para style="mt2">Xaafida Koyro Kiita</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Phawuloosi Qorontoose asaas xaafida koyro kiitay xaafettiday izi kase Qorontoosen essida Woosa Keeththaa giddon diza ammanon duussa gishshassinne ammano gishshas dendida metota birshanaas giidikko. He wode Qorontoose katamaya kumeththa alamen erettida Girike asaa katama gidoyssafekka bollara Akaya geetettiza Oroome kawoy haariza waanna katama. Hinna he katamaya izin daro gita zal7ey zal7ettizaso; hankko dere woga baggara gidikko daro dichcha bolla dawussinne iita hanoninne dumma dumma miishshe ammanon daro erettidaaro.</para>
  <para style="ip">Hawaarey harappeka lo7eththi xeelliday Woosa Keeththay giddon diza shaaketeththaa gishshas, istta iita ooso gishshas, layma gishshassinne ekonne gelo gishshas, Woosa Keeththa gishshas, Xillo Ayana imotata gishshassinne hayqoppe denththa gishshassa; hessaththoka Hawaarey Mishiraachcho qaalaza hayta ha oyshata bolla isttas lo7eththi minththi zaaro immees.</para>
  <para style="ip">«Siiqoy» Xoossi ba asaas immida imota ubbaafe aadheth gididayssa qonccisizay tammanne heedzdzanththo shempoy hayssa ha maxaafa giddon daro erettida kifile giidi qopeettes.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">Ammanizayta garsan medhettida shaaketeth <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">Iita oosonne soo asa duus <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">Ammanizaytanne ammanontta asa <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">Ammanizayta duussinne Xoos goyno woga <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">Hayqoppe Kirstoosa denththinne ammanizayta denth <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">Yuhudan waaye bolla diza ammanizayta maaddanaas keso miish shiisho <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">Kuushsha qofa <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Xoossa shenen Yesus Kirstoosas kiitettanaas xeygettida Phawuloosappenne nu ishaa Sostineeseppe,<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Qorontoosen diza Xoossa Woosa Keeththaas, Godaa Yesus Kirstoosas dummatidaytassinne isttassara nuussara Godaa gidida Godaa Yesus Kirstoosa sunththaa awanka xeygiza ammanizaytara gidanaas xeygettida asa ubbaas, <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />nu Aawa Xoossafenne Godaa Yesus Kirstoosappe kiyateththinne saroy inttes gido.<verse eid="1CO 1:3" /></para>
  <para style="s1">Xoossas Galata</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Godaa Yesus Kirstoosa baggara inttes imettida Xoossa kiyateththaa gishshas ubba wode intte gishshassika tani Xoossaa galatays. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Gaasoykka ay yo7onkka, hessika haasayan gidiin erateth ubbaan intte duretideta. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Kirstoosa gishshas nu inttes markkattidayssi intte achchan minnides. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Hessa gishshas intte Yesus Kirstoosi qonccana gallas naagishin Ayana imotatappe aykkoyka inttes paccenna. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Godaa Yesus Kirstoosi nam7anththo yaana gallassan intte intte bolla borey baynda beettana mala wurseth gakkanaas izi inttena lo7eththi naagana. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Izi ba naaza nu Godaa Yesus Kirstoosa issifeteththaako inttena xeygida Xoossi izi ammanettida Xoossa.<verse eid="1CO 1:9" /></para>
  <para style="s1">Woosa Keeththan Medhettida Shaaketeth</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Ta ishatoo! Intte garsan shaaketeththi dontta mala inttes issi wozinaynne issi qofay daana malanne intte intte garsan issino gidana mala Godaa Yesus Kirstoosa sunththan ta inttena woossays. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Ta ishatoo! Intte garsan palamay dizayssa ta Qaalo7e soo asaappe siyadis. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Yo7ozikka hayssa mala; intte garsan issi issi asati, «Ta Phawuloosa bagga» geettes; baggay qasse, «Ta Aphiloosa bagga» geettes; baggay qasse, «Ta Keefa bagga» gishin haray qasse, «Ta Kirstoosa bagga» geettes.<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Keefa guussi Phexroosa guussa.</char></note><note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">Hawa 18:24</ref></char></note> <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Histtiko Kirstoosi shaaketti wodhdhidee? Intte gishshas Phawuloosi kaqettidee? Woykko Phawuloosa sunththan xammaqettidetii? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Intte giddofe Qerisphoosappenne Gayiyoosappe attiin hara oonakka ta xammaqontta gishshas Xoossaa galatays.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">Hawa 18:8</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ROM 16:23">Oro 16:23</ref></char></note> <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Hessa gishshas oonikka, «Ta Phawuloosa sunththan xammaqettadis» gaana asi deenna. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Tumukka Isttifaanose soo asaa xammaqadis; heytappe hara ta xammaqidaakko ta erizaadey deenna.<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1Qoro 16:15</ref></char></note> <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kirstoosi tana kiittiday Mishiraachcho qaalaa yootanaas attiin xammaqanaas gidenna; Kirstoosa masqaley hada gidontta mala tani asappe gidida cinccateththan sabbakikke.<verse eid="1CO 1:17" /></para>
  <para style="s1">Xoossa Wolqqanne Erateth Gidida Kirstoosa</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Masqaleza kiitay dhayana dizaytas eeyateththa; gido attiin attana diza nuus gidikko Xoossa wolqqa. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />«Cinccata cinccateth ta isttafe dhayssana; eranchchata erateththaa ta hada ooththana» geetetti Geeshsha Maxaafan xaafettides.<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">Isa 29:14</ref></char></note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Cinccay awan dizee? Tamaarda eray awan dizee? Hayssa wodeza pilggi erizay awan dizee? Xoossi ha alameza erateth eeyateth ooththibeennee?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">Iyo 12:17</ref>; <ref loc="ISA 19:12">Isa 19:12</ref>; <ref loc="ISA 33:18">33:18</ref>; <ref loc="ISA 44:25">44:25</ref></char></note> <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Xoossa erateththafe dendidayssan alamey ba erateththan Xoos eroy xooniin sabbako eeyateththan ammanizayta ashshanaas Xoossa shene gidides. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ay wodekka Ayhudati dumma malaata koyeettes; Girike asati qasse erateth koyeettes. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Nuni gidikko kaqettida Kirstoosa sabbakoos; hessika Ayhudatas dhuphe; Ayzaabetas qasse eeyateththa. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Xoossi xeygidaytas istti Ayhudata gidiin woykko Girike dere as gidikkoka Kirstoosi Xoossa wolqqanne Xoossa erateththa. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Gaasoykka asa erappe Xoossa eeyateththi aadhdhida erateththa; asa minoteththafe Xoossa laafateththi aadhdhees.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Ta ishatoo! Kase intte xeygettiza wode intte ay mala asakko ane qopite; asa qofa mala gidikko inttefe darizayti erata gidekketa. Inttefe daroti wolqqay bayndayta; darotikka gita keeththa asappe yelettibeekketa. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Gido attiin Xoossi erata yeellachchanaas deraappe eeyata doorides; Xoossi minota yeellachchanaas alamezappe daaburanchchata doorides. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Xoossi hankko ammanontta asaa achchan deettes geetetti erettiza miishshata baynda miishsha mala ooththana hayssa alamezan leqettidaytanne kawuyidayta laafata doorides. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Hessaka izi ooththiday oonikka iza sinththan ceeqettontta malassa. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Inttena qasse Xoossi Yesus Kirstoosara issifeteththi daana mala ooththides; hessa gishshas Xoossi Yesus Kirstoosa nu erateth, nu xilloteth, nu geeshshateththinne nuna ashshizaade gidana mala ooththides. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Hessa gishshas kase Geeshsha Maxaafan xaafettida mala, «Ceeqettiza asi Godaan ceeqetto.»<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">Kaqettida Kirstoosa Gishshas Tamaarso</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Ta ishatoo! Ta intteko Xoossa xuura qonccisana biday taas doona qarateththi woykko era daroy diza gishshas gidenna. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Ta intte giddon diza wode kaqettida Yesus Kirstoosappe attiin hara erontta mala ta baggara murttadis. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Ta intteko daro daaburan, yashshateththaninne daro kokkorashe badis. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Ta qaalaynne sabbakoykka Ayana wolqqa qoncciseththanpe attiin cimoninne era daron gidenna. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Hessika intte ammanoy Xoossa wolqqanppe attiin asa cinccateththa bolla xaphontta mala hanides.<verse eid="1CO 2:5" /></para>
  <para style="s1">Xillo Ayanappe Imettida Erateth</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Nu kaha kunththida asata achchan era haasaya haasayoos; gido attiin hayssa ha alameza erateth gidenna; woykko dhayana diza ha alameza haarizayta erateth gidenna. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Gido attiin nu haasayzay kase qotetti diza Xoossa xuura erateththa; he erateththay Xoossi daro wodeppe kase nuna bonchchos kasetidi giigsi woththidayssa. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Ha alameza haarizaytappe oonikka ha erateththaa eribeenna; eridaakko istti bonchcho Godaa kaqqettenna. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Gido attiin Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 2:9">«Asa ayfey be7onttaaz,</para>
  <para style="q2" vid="1CO 2:9">asa hayththi siyonttaaz,</para>
  <para style="q2" vid="1CO 2:9">asa wozinaykka qopponttaaz</para>
  <para style="q2" vid="1CO 2:9">Xoossi ba dosizaytas</para>
  <para style="q2" vid="1CO 2:9">giigsides» gees.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">Isa 64:4</ref></char></note><verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Xoossi gidikko hessa ba Ayana baggara nuus qonccisides; Ayanaykka Xoossas diza ciimma yo7o ashshontta ubbaa pilggi xeellees. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Asa garsan izaades diza ayanappe attiin izaade wozina erizay oonee? Hessaththoka Xoossa Ayanappe attiin Xoossa qofaa erizay oonikka deenna. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Xoossafe nuus imettidayssa nuni erana mala Xoossa Ayanay nuus imettides attiin nuni hayssa ha alameza ayana ekkibeekko.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Nu yootizay hayssa; nuni asappe tamaarda qaala gidontta Ayanappe tamaarda qaala haasayoos; Ayana tumateththaaka nu qonccisizay Ayana qaalanna. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Xoossa Ayanay izan baynda asi Xoossa Ayanappe gididaaz ekkanaas dandayenna; gaasoykka hessa mala yo7oy izas eeyateththa; izi baas Ayanan paacettizaade gidida gishshas izi eranaas dandayenna. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Xoossa Ayanay izan dizaadey qasse ubbaaka paaccees attiin baas oonankka paacettenna. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Hessika,</para>
  <para style="q1" vid="1CO 2:16">«Godaa qofaa eranaas</para>
  <para style="q2" vid="1CO 2:16">dandayzay oonee?</para>
  <para style="q2" vid="1CO 2:16">Iza zoranaas dandayzay oonee?»</para>
  <para style="m" vid="1CO 2:16">geetetti kase Geeshsha Maxaafan xaafettida mala; nuus gidikko Kirstoosa wozinay dees.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">Isa 40:13</ref></char></note><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">Woosa Keeththa Giddon Medhettida Shaaketeth</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Ta ishatoo! Ta inttena intte Kirstoosan buro guuththa nayta malanne buro ammanoy gelontta asa malappe attiin Ayanan kumida asa mala gaada inttes haasayanaas dandayabeekke. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Intte buro minnontta gishshas ta inttena maath paahadis attiin buro mino kath mizabeekke; ha7ikka gidikko intte burokko!<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">Ib 5:12-13</ref></char></note> <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Intte ha7ikka buro ammanon minnonttayta gidida gishshas intte giddon qanaateteththinne palamay dees; histtiin intte buro ammanon minnontta asa mala gidekketii? Intte oosoy coo mela asi ooththizayssa mala gidennee? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Gaasoykka intte garsafe issoy, «Ta Phawuloosassa» hankkoyssi qasse, «Ta Aphiloosassa» giikko intte coo asho qofan xalala diza asa mala gidekketii?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1Qoro 1:12</ref></char></note><verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Ero! Gido attiin Aphiloosi aazee? Phawuloosikka aazee? Istti Goday isttas issaas issaas immida mala ooththiza oosanchchata; intteka istta baggara ammanideta. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ta tokkadis; Aphiloosi haaththe ushshides; dichchiday gidikko Xoossa.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">Hawa 18:4-11</ref></char></note> <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Hessa gishshas dichchizay Xoos attiin tokkizaadeyka, haaththe ushshizaadeyka aykkoka gidettenna. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Tokkizaade gidiin woykko ushshizaade gidiin istti issino; isttafe issaadey issaadey ba ooso mala woyto ekkana. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Gaasoykka nu Xoossara issife ooththizayta; intteka Xoossa goshsha gadenne Xoossa Keeththata.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Xoossafe taas imettida imoteththaa gina Keeththe keexxiza hiilla mala keeththay eqqanaas lo7eththa giigsadis; iza bolla hara asi keeth keexxana; gido attiin keeth keexxizaadey wostti keexxanaakko naagettanaas bessees. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Gaasoykka keeththay keexeteth oykettidaappe guye hara woththi qasse keexxana dandayzaadey oonikka baa; hessika keeththaas yochchay Yesus Kirstoosa. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Oonikka keeththay koyro keexettidayssa bolla worqqan woykko biran bonchchettida shuchchan woykko miththaninne maatan woykko maqan keexxiko, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />issaade issaade oosoy ay malakko pirda gallas qonccana; gaasoykka he gallas issaade issaade oosoy ay malakko taman paacetti erettana. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Oonikka keexxida keeththi minni eqqizaa gidikko hessaadey ba woyto ekkana. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Iza oosoy xuugettidaadey gidikko woytoy izas deennashin izaadey ba hu7es attana; gido attiin izaade ateththi tamappe asi waaydi attiza ateththa mala gidana.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Intte intte hu7es Xoossa Keeththe gididayssanne Xoossa Ayanay intte giddon dizayssa erekketii?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1Qoro 6:19</ref>; <ref loc="2CO 6:16">2Qoro 6:16</ref></char></note> <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Oonikka Xoossa Keeththe laalliko Xoossi izaade laallana; Xoossa Keeththi geeshsha; hessika inttenakko!<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Oonikka barkka bana baleththofo; inttefe oonikka hayssa ha alamezan bana eranchcha mala qoppiko izaadey eranchcha gidana mala bana barkka eeya mala qoodo. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Hayssa ha dereza erateththi Xoossa achchan eeyateththa; kase Geeshsha Maxaafan, «Izi eranchchata istta gene ooso gaason zaaridi oykkana» geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">Iyo 5:13</ref></char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Qasseka harason, «Eranchchata qofay hada gididayssa Goday erees» geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">Maza 94:11</ref></char></note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Hessa gishshas wurikka inttes gidida gishshas oonikka asan ceeqettofo. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Phawuloosa gidiin, Aphiloosa gidiin, woykko Keefa gidiin, alame gidiin, de7o gidiin, woykko hayqo gidiin, ha7i dizaaz gidiin, woykko buro yaana miish gidiin, wurikka inttessa. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />Intteka Kirstoosayta; Kirstoosikka Xoossayssa.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">Kirstoosa Hawaareta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Hessa gidida gishshas asi wurikka nuna Kirstoosa oosanchchata malanne Xoossa xuura qonccisanaas hadara ekkida asa mala qoodanaas bessees. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Hadara ekkidaytikka ammanettidayta gidanaas bessees. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ta bolla intte pirdinkka woykko duulata asay pirdinkka ta baggara taas aykkoy baa; haray attoshin tarkka ta bolla pirdike. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />«Ta eriza mala tani ta wozinara sidhiza miishshi baa; gido attiin hessa guussi ta bolla mooroy baa» guus gidenna. Buro ta bolla pirdanay Godaa. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Hessa gishshas pirdana wodey gakkontta haara ay yo7okka pirdofte; Goday yaana gakkanaas naagite; izi dhuma giddon qotettidayssa buro qoncce kessana. Asa wozina giddon diza qofaakka qoncce kessana; he wode issi issi asi baas bessiza galata Xoossa achchafe ekkana.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Hessa gishshas ta ishatoo! Ta inttena go7ana mala ha yo7ozan tananne Aphiloosa inttes leemiso shiishshadis; ta hayssa ooththiday, «Xaafettidayssafe aadhdhofa» gizayssa intte nuuppe taamarana malassa. Hessa gishshas intte issaade sabbidi hara as kadhanaas bessenna. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Neni aazan aadhdhay? Neni harappe ekkontta attida miishshi aazee? Histtiin ne wursaka ekkiday hara asappe gidikko hara asappe ekkontta asa mala aazas ceeqettay?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Ha7i gidikko inttes koshshizaaz intte ubbaa demmidetanne duretideta; nuuppeka shaakettidi kawotideta; intte tumukka kawotidaakko nunikka inttenara kawotanakko shin. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Gaasoykka Xoossi nuna Hawaareta nu bolla hayqo pirday pirdettida asata mala asa ubbaafe wurseth ooththidaaz taas misatees; hessa gishshas alames, kiitanchchatassinne asa ubbaas kaassa miish gididos. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Nu Kirstoosa gishshas eeyata gididos; intte qasse Kirstoosan eranchchata; nuni daaburanchchata; intte gidikko minota; intte bonchchettidayta; nuni gidikko kawushshata. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Hanno gakkanaas nu gafoos; saamettoos; kallottoos; bukettoos; aqizasoy dhayiin waayettoos. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Nu kushera ooththi daaburi aqoos; nuna qanggishin nu qasse anjjoos; nuna gooddishin nu dandayoos.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">Hawa 18:3</ref></char></note> <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Nu sunth istti moorishin nu qasse lo7o zaaroos; hanno gakkanaas nuni biittafe pitettida buura gididos.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ta hayssa inttes xaafizay inttena ta dosiza ta nayta mala zoranaas gaada attiin inttena yeellachchanaas gidenna. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Inttena Kirstoosan dichchiza daro asati diikkoka inttes daro Aawati deettenna; tani qasse Yesus Kirstoosa Mishiraachcho qaalan inttena yeladis. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Hessa gishshas intte tana misatana mala ta inttena woossays. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Godaan daro dosettidayssanne ammanettida ta naa Ximtoosa ta intteko kiittiday hessa gaasonna. Izikka dumma dummason diza Woosa Keeththa asaa wursi ta tamaarsida timirtezara gaaggizayssa Yesus Kirstoosan diza de7o oge gishshas inttena izi qofsana.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Inttefe issi issi asati ta nam7anththo inttena beyanaas bonttaaz isttas misatiin otorettida. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Gido attiin Godaa shene gidikko matara ta intteko baana; hee baada he otoranchchati haasayzaaz xalala gidontta isttas aaza wolqqay dizaakko beyana koyays. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Gaasoykka Xoossa kawoteththi coo doona xalala gidontta doonappe bollara Xoossa wolqqa. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Ero! Intte koyzay awayssee? Durqqa ekka booyee? Woykko siiqoranne ashketeththa Ayanara booyee?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">Woosa Keeththan Oosettida Yeellachchiza Nagara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Intte garsan yeellachchiza laymay dizayssi woretees; hessa mala tunateththi ammanontta dereta achchanka deenna; ba aawa machcho ekkida asi inttekon dees.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">Zaare 22:30</ref></char></note> <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Histtiin hessa mala yeellachchiza miishshi intte giddon dishin aazas otoreteetii? Hessafe he yo7ozan intte muuzottanaas inttes bessennee? Hessa mala ooththidaade intte garsafe diggite.<verse eid="1CO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3" />Ta inttenara ashon issife dontta aggikokka ayanan qasse inttenara days; ta ha7i inttenara diza mala hessa ooththidaade bolla pirdadis. <verse eid="1CO 5:3" /><verse number="4-5" style="v" sid="1CO 5:4-5" />Intte shiiqizason ta inttenara diza gishshas Godaa Yesusa sunththaninne intte giddon diza nu Godaa Yesusa wolqqan he mooranchchaza ashoy dhayiin iza shemppoy Godaa gallassan attana mala hessa mala asi Xala7es aadhdhi imetto.<verse eid="1CO 5:4-5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Intte ceeqettizayssi lo7os gidenna; guuththa irshoy daro bukeeso denththeththizaa erekketii?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">Gala 5:9</ref></char></note> <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Intte ha7i irshoy baynda ooraththa bukeeso gidana mala kase caala irshoza intte giddofe diggite; nu Paaziga dors gidida Kirstoosi nuus yarshettides.<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">Paaziga bonchchiza wode asay caala irsho gidida miish kaththan yeggenna.</char></note><note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">Kessa 12:5</ref></char></note> <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Hessa gishshas ane nuni Paaziga ba7aaleza qohoynne iitateththi izan kumida kase caala irsho bolla gidontta irshoy baynda ukeththan suureteththaninne tuman bonchchoos.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">Kessa 13:7</ref>; <ref loc="DEU 16:3">Zaare 16:3</ref></char></note><verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Inttes laymatiza asatara issifeteththi dontta mala ta inttes kase dabdaabe xaafadiskoshin. <verse eid="1CO 5:9" /><verse number="10-11" style="v" sid="1CO 5:10-11" />Intte ammanoos gishe laymatiza asaara gidontta woykko coo gaphigaphizaytara, kaysotizaytara, eeqas goynnizaytara gaaggofte guus gidontta dishin ha7i ta xaafiday ammanays gishe laymatizaytara woykko maththottizaytara, gaphigaphizaytara, eeqas goynnizaytara, asa sunth moorizaytara woykko cayizaytara, asa miish bonqqizaadenttara inttes issifeteththi dooppo; heytantta malara haray attoshin kaththika issife moopite.<verse eid="1CO 5:10-11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Hankko ammanontta asaa bolla pirdanaas tana aazi gaththizee? Woosa keeththan dizayta bolla intte pirdeketii? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Woosa keeththafe karera dizayta bolla gidikko Xoossi pirdana, «Intte intte giddofe iita as diggite» geetetti Geeshsha Maxaafan xaafettides.<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">Ammanizayta Garsan Dendida Mooto</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Intte garsafe issaades hara ammanizaadera yo7oy diikko he yo7oza ammanizayta ach shiishshanayssa wostti ammanontta asa sinththan pirdettana shiishshizee? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Ammaniza asay ammanontta asaa bolla pirdanayssa intte erekketii? Intte buro alame bolla pirdandeta; gidikkoka hessa guuththa yo7o bolla pirdanaas dandayekketii? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Hayssa biittaa bolla diza pirday attoshin intte buro kiitanchchata bolla pirdanayssa erekketii? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Intte intte garsan ooyettiko ammanizayta maabarappe karen dizaytaninne kadhettida asata sinththan wostti intte yo7o shiishsheetii? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Ta hessa inttes gizay inttena yeellachchanaassa; intte garsan ammanizayta giigsanaas dandayza wozinama asi deennee? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Gido attiin ammanizaadey hara ammanizaade mootanaas alame pirda keeththe baanaas bessizee?<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Intte garsan issoy issaa mootoy intte kundeththaas malata bessees. Intte qohanaappe qohettiko lo7ennee? Qasseka intte as baleththanaappe inttena asi baleththiko lo7ennee? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Intte haa qohettanaappe gede qoheetanne baleththeeta; hessika intte ishata,<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />Makkallanchchati Xoossa kawoteth gelonttayssa erekketii? Hessa mala yo7on balettofte. Laymatana qaaqqatizayti, eeqa eqqizaytinne addey addera laymatizayti, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />woykko kaysoti, gaphigaphizayti, maththottizayti, as cayizaytinne bonqqizayti Xoossa kawoteth laattettenna. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Inttefe issi issi asati heytantta mala shin ha7i qasse Godaa Yesus Kirstoosa sunththaninne nu Xoossaa Ayanan meecettideta; dummatidetanne xillideta.<verse eid="1CO 6:11" /></para>
  <para style="s1">Ba Asateththan Xoossa Bonchcho</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Haray wurikka taas imettides; Gido attiin wurikka go7izaaz gidenna. Wurikka taas imettides gido attiin ay miishshika tana haarenna.<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1Qoro 10:23</ref></char></note> <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Qasse Kaththi ulossa; uloykka kaththassa; gido attiin Xoossi nam7aakka dhayssana; asateththi Godaassafe attiin laymas gidenna; Godaykka asateththassa. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Xoossi Godaa hayqoppe denththida mala nunakka qasse izi ba wolqqan hayqoppe denththana.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Intte asateththay Kirstoosa asateththa billite gididayssa intte erekketii? Histtiin ta Kirstoosa asateththaafe issaa layman aqiza asatara issino histtoo? Mulekka bessenna. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Woykko laymatizaarira aqizaadey izira issi asho gidizayssa intte erekketii? «Nam7ay issi asho gideettes» geetettides.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref></char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Gido attiin Godaara issino gidizaadey izara issi Ayana gidees.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Laymappe haakkite; asi ooththiza hara nagaray wuri izaade ashoppe karera hanees; layma laymatizaadey gidikko barkka ba asateththaa bolla nagara ooththees. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Intte asateththay intte gaaththan diza Xillo Ayanas duussaso gididayssa intte erekketii? He Ayanaykka intte Xoossafe ekkidayssa; intteka inttes gidekketa.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1Qoro 3:16</ref>; <ref loc="2CO 6:16">2Qoro 6:16</ref></char></note> <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Intte miishshan shamettideta; hessa gishshas intte intte asateththan Xoos bonchchite.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">Ekko Gishshassinne Gelo Gishshas Shiiqida Oyshonne Zaaro</para>
  <para style="p">
    <verse number="1-2" style="v" sid="1CO 7:1-2" />Intte taas xaafida mala asi maccassako gakkontta aggizaakko lo7okko! Gido attiin laymappe naagettanaas attumasaas issaas issaas machcha du. Maccassaska issineys issineys azinay do. <verse eid="1CO 7:1-2" /><verse number="3" style="v" sid="1CO 7:3" />Azinay ba machcheys koshshizaaz ubbaa ooththo; machchaka ba azinaas koshshizaaz wursa ooththu. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Machchi asateththi izis xalala gidontta azinaassara koththa; hessaththoka azinaa asateththi izas xalala gidontta machcheyssara koththa. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Nam7ay dosan woosas giidi zoren gido giidi qachchida gallassatappe attiin hara gallas issoy issaas akkay gooppetto; hessa gaason inttes inttena haaroy xooniin Xala7ey inttena paaccontta mala nam7ay issife aqite.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ta hessa gizay coo azazo mala gidontta zore zorays. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Asi wuri ta mala machcho ekkontta dizaakko ta dosays; gido attiin issi issi asaas Xoossafe imettida dumma dumma imotay dees; issaas issi qommo imotay dees; hankkoyssas qasse hara qommo imotay dees.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Buro ekkonttaytanne gelonttayta gishshas qasseka azinay hayqqida maccassata gishshas ta gizay istti gelonttanne ekkontta ta mala dizaakko isttas lo7o gays. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Gido attiin istti bana naaganaas dandayonttayta gidikko gelettonne ekketto; coo amon xuugetanaappe ekoynne geloy lo7o.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Ekkidaytassinne gelidaytas ta immiza azazoy hayssa; hessika Godaa azazoppe attiin ta azazo gidenna; azina gelida maccassaya ba azinappe shaakettufu. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Shaakettizaa gidikko hara azina gelontta uttu; akkay giikko ba azinara giigu; azinaykka ba machcho anjji yeddofo.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Hankko asaas qasse ta hizgays; hessa gizaykka tana attiin Godaa gidenna; ammanontta machcha diza ammanizaadey machcheya izara daana dosikko izi izo anjji yeddanaas bessenna. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Ammanontta azinay diza ammaniza maccassaya he ammanontta azinay izira daanaas koykko iza izappe anjjetta baanaas bessenna. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Gaasoykka ammanontta azinay ammaniza ba machcheyin anjjettees; ammanontta maccassayakka ammaniza ba azinaan anjjettawus; hessaththo hanontta aggiko intte yelida nayti tunata gidanashin ha7i qasse anjjettidayta.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />Gido attiin nam7atappe issoy ammanonttaadey shaakettana koykko shaaketto; adde gidiin macca gidiin ammanizaadey hessa mala wogaan qashettenna; Xoossi nuna saron daana mala xeygides. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Hanne neni ne azinaa ashshanaakko ay eray? Woykko haysso neni ne machcho ashshanaakko ay eray?<verse eid="1CO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Coo issi issi asi Xoossi xeygida malanne Goday woththida mala de7o; woosa keeththatas ta woththiza wogay hessa. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Issaadey ammananaappe kase qaxxarettida gidikko qaxxarettontta asa mala hanoppo. Qasse qaxxarettontta dishe ammanidaadeyka qaxxarettofo. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Qaxxarettiin qaxxarettontta aggiin nam7aanka go7ay deenna; waanna ayfe yo7oy Xoossa azazo polo. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Issi issi asi ba xeygettida xeygeteththan minni de7o. <verse eid="1CO 7:20" /><verse number="21-22" style="v" sid="1CO 7:21-22" />Ammaniza wode ne ayllee? Ne hessas daro metotoppa; wozzettana dandaykko wozzeta; gaasoykka aylle gidi dishe Godaa ammanidaadey izi Godaa goqa; hessaththoka ammaniza wode goqa gididaadey izi Kirstoosas aylle. <verse eid="1CO 7:21-22" /><verse number="23" style="v" sid="1CO 7:23" />Intte miishshan shamettideta; hessa gishshas asa aylle gidopite. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Ta ishatoo! Inttefe issi issi asi ba xeygettida mala Xoossara minni de7o.<verse eid="1CO 7:24" /></para>
  <para style="s1">Geela7ota, Panththatanne Am7eta Gishshas Shiiqida Oysho</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Geela7otanne panththata gishshas taas Godaappe imettida azazoy deenna; gido attiin Godaa maaroteththafe dendidayssan ta inttes ammanettidaade gidada inttena zorays. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Hayssa ha7i wode meto gaason intte ha7i diza mala dizaakko taas lo7o misatees. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Ne machcho ekkidaade gidikko anjja yeddanaas koyoppa; machcho ekkonttaade gidikko machcho ekkanaas koyoppa. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Machcho ekkikokka nagara gidenna. Geela7oyakka gelikko nagara gidenna; gido attiin ekkiza asatanne gelizayta bolla hayssa alamezan istta daro metoy gakkana; ta qasse hessi intte bolla gakkontta agganayssa dosays.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Ta ishatoo! Ta qofay hayssa mala; wodezi qaanth gidida gishshas machcha dizaadey machcha bayndaade mala de7o. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Yeekkizayti yeekkontta asa mala, ufayettizayti ufayettontta asa mala gidetto; miishshe shammidaadenti shamettida miishshaa baas gi qoppofetto. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Hayssa alameza miishshan go7ettizayti ubbay go7ettontta asa mala gidi detto. Gaasoykka hayssa alameza hanoy aadhdhanaas dees.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Intte hirgay baynda daana mala ta koyays; machchonttaadey Godaa ufayssanaas Godaa gishshas qoppees. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Machchidaadey qasse ba machchiyo ufayssanaas hayssa alameza miish qoppees. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Hayssan iza qofay nam7u kezi shaakettees; gelontta maccassaya woykko geela7oya Godaaz xalla qoppawus; izis gita qofaykka ashonkka, ayanankka Godaas dummateththa; gelidaara gidikko ba azinaa ufayssanaas hayssa alameza hano xalla qoppawus.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Ta hessa gizay inttes lo7anaaz qoppadappe attiin inttena daro qofan yegganaas gidenna; taas diza gita qofay intte wozinay shaaketti nam7u kezontta intte Godaan minnidi wogara de7anaassa.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Issaadey ba oychchida geela7oyo wogara oykkontta aggiko izi wodeykka cimmi cimmi biikko ekkana koykko ba koyida mala ekko; ekkikonne gelikko lo7o; nagara gidenna. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Gido attiin hayssa ha yo7ozan iza wozinay qaaxxontta bana haaridi geela7oyo ekkike giidi murttida asi lo7o ooththides. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Hessa gishshas geela7oyo ekkidaadey lo7o ooththides; ekkonttaadeyka aadheththa lo7o ooththides.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Issi maccassi azinay paxa diza wode kumeththan ba azinara qashettadus; azinazi hayqqiko ba koyida as gelana dandayawus; iza gelanaadey ammanizaade gido attiin gelu. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ta qofa mala gidikko iza gelontta dizaakko daro ufayssan de7andus; taaska tanan Xoossa Ayanay dizaa misatees.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">Eeqas Yarshettida Asho Muussa Gishshas</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Eeqas shukettida asho gishshas intte taas xaafidayssa mala gidikko tumukka nu wurikka eriza miishshi dees; eroy otorisees; siiqoy gidikko go7ees. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Ta erays giza asi eranaas bessiza mala buro eribeenna. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Xoos siiqizaadey gidikko izi Xoossa achchan erettidaade.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Hessa gishshas eeqas yarshettida asho muussa gishshas ta inttes gizay hayssa alamezan eeqay hada gididayssanne issi Xoossaafe attiin hara Xoossi bayndayssa nu eroos. <verse eid="1CO 8:4" /><verse number="5-6" style="v" sid="1CO 8:5-6" />Aydekka gidikko daro eeqatinne daro godati deettes shin salon gidiin sa7a bolla Xoos geetettiza daro eeqati diikkoka nuus gidikko haniday wurikka izan hanides. Nunikka izas gidida issi Xoossi Aaway dees; qasseka hanidaazi wurikka izan haniday nunikka izan hanida issi Goday Yesus Kirstoosi xalala nuus dees.<verse eid="1CO 8:5-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Gido attiin hessa asi wuri erenna; issi issi asati hanno gakkanaas eeqa goyno dosida gishshas hessa mala asho mishe addaka eeqas shukettidayssa qoppeetes; isttas qofay laafa gidida gishshas istti tuneettes. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Gido attiin kaththi nuna Xoossa ach gaththenna; nu montta aggikokka nuus paccizay deenna; nu miikkoka nuus wodhey deenna.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Gido attiin intte metoy baa guussan ooththizayssi ammanon minnontta asaas dhuphe gidontta mala naagettite. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Nees hessa misatiza erateththi diza gishshas hinko ammanon minnonttaadey eeqa keeththan ne mizayssa be7idi eeqas shukettidayssa maanaas xalennee? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Hessa gishshas Kirstoosi iza gishshas hayqqida he ammanon minnontta ishay ne erateththa gaason dhayees guussa. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Hessaththoka intte intte ishata qohoninne istta laafa qofaa madunththon Kirstoosa qoheeta. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Hessa gishshas ta miza miishshi ta ishaa dhuphizaaz gidikko ta ishaa ta dhupheththontta mala mulekka asho miikke.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">Hawaaretas Diza Maata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Tani goqa as gidikkinaa? Ta Hawaare gidikkinaa? Nu Godaa Yesusa tani ta ayfera beyabeekkinaa? Intteka Godaan ta ooson beettida ayfe gidekketii? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Haratas ta Hawaare gidontta aggikokka ta inttes tumappe Hawaare; gaasoykka Godaan ta Hawaareteththaa bessiza maatamey inttena.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Tana paaccizaytas ta immiza zaaroy hessa. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Ero! Maanaassinne uyanaas nuus bessennee? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Hara Hawaareta mala Godaa ishata malanne keefantta mala nunikka ammaniza nu machcheta ekki yuuyana dandayokkonii? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Woykko waayetti daaburdi daanaas bessizay tananne Barnabaasa xallaa?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Ero! Ba miishshara wottadarateth ooththizay oonee? Woyne mith tokkidi he tokkida miththaa ayfe monttay oonee? Mehe heemmishe ba heemmiza meheza maath uyonttay oonee?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Ta hayssa gizay coo asa qofa mala xallaa? Muse wogay hessaththo geennee? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Muse wogaa garsan, «Kath bukkiza mehe doona qachchofa» geetetti xaafettides; histtiin Xoos metiday he meheza qanththee?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Zaare 25:4</ref>; <ref loc="1TI 5:18">1Xim 5:18</ref></char></note> <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Izi hessa giday tumappe nu gishshas gidennee? Hessi xaafettiday addafe nu gishshassa; goshshanchchaynne qasseka bukkizayssi ba ooso ayfeppe bana gakkizayssa ekkanaas hidota ooththees.<verse eid="1CO 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 9:11" />Nu intte giddon Ayana zereth zeridayti ashos gidizaaz maxikko hessi gita miishshee?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">Oro 15:27</ref></char></note> <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Hara asati inttefe hessa mala go7a ekkanaas dandaykko nu qasse hessafe daro demmanaas bessennee? Gido attiin nuni nuus bessiza mala go7ettibeekko; harappeka nu Kirstoosa Mishiraachcho qaalaas dhuphe gidontta mala hanizaaz ubbaaka dandayoos. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Xoossa Keeththan ooththizayti ba maanayssa Xoossa keeththafe ekkizayssa mala yarshoson ooththizaytikka he ba yarshizayssafe mizayssa intte erekketii?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">Zaare 18:1</ref></char></note> <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Hessaththoka Mishiraachcho qaalaa sabbakizayti baas koshshizayssa Mishiraachcho qaalaa ooththizasoppe ekkana mala Goday woga woththides.<note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">Mato 10:10</ref>; <ref loc="LUK 10:7">Luqa 10:7</ref></char></note><verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Tani gidikko hessa ubbaafekka aykkoka go7ettabeekke; ha7ikka ta inttes hayssa xaafizay heytantta mala miish taas ooththetto gaada gidenna. Ays giikko oonikka tani ta Godaan ceeqettizaaro taappe woththi ekkanaappe taas hayqoy lo7o. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Mishiraachcho qaalaa sabbakidayssi tana ceeqissenna; ta sabbakizay dosan gidontta wolqqara tana gakkida gishshassa; ta Mishiraachcho qaalaa sabbakontta aggiko taas aayye ana! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Mishiraachcho qaalaa tani ta dosan sabbakikko taas woytoy dees; tani ta dosan gidontta wolqqara ooththizayssa gidikko hadara polana mala ooso xalala gidana. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Histtiin taas aaza woytoy dizee? Taas woytoy daanay Mishiraachcho qaalaa sabbakashe taas bessizayta ta go7ettontta aggikokko.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ta goqappe attiin oonaska aylle gidikke; gido attiin darota Godaakko zaarana gishshas asa ubbaas aylle mala gidadis. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Ayhudata ashshanaas Ayhudatara istta misatadis; tani ta baggara Muse wogaappe garsara gidontta dashe Muse wogaappe garsara dizayta ashshanaas istta misatadis. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Tani ta baggara Xoossa wogay dizaadenne Kirstoosa wogaas haarettizaade gidikkoka wogay bayndayta ashshanaas istta mala wogay bayndaade gidadis. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Daaburanchchata ashshanaas gaada tanikka daaburanchchatara istta mala daaburanchcha gidadis; taas dandayettida mala ubbaan issi issi asata ashshanaas asa ubbaara istti hanizaaz hanadis. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Ta hayssa wursa ooththizay Mishiraachcho qaalaa anjjo isttara gishettanaas Mishiraachcho qaalaa gishshas ooththadis.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Gaadde woth woxxizayti daro shin xoonidi woyto demmizay issaade xalala gididayssa intte erekketii? Hessa gishshas woyto ekkanaas woxxizaade mala intteka woxxite. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Gaadden woxxi aadhdhanaas giigettizaadey oonikka hano ubbaan barkka bana naagees. Heytantti aadhdhananne dhayana akilile ekkanaas daabureettes shin nu qasse mernaas dhayontta akilile demmanaas daaburoos. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Hessa gishshas ta qasse poloy baynda coo mela woxxizaade mala woxxike; qasseka carkora baaxetizaade mala coo mela gaden baaxetikke. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Ta qasse haratas sabbaka pe7ada taas kunda attontta mala ta asateth shiishsha oykkada haarays.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">Isra7eele Nayta Bolla Gakkidayssi Gakkontta Mala Naageteth</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Ta ishatoo! Kase nu Aawati shaaray isttafe bollara gididi kaaleththidayssa malanne istti wurikka zo7o abba pinnidayssa ta inttena qofsanaas koyays.<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kessa 13:21-22</ref>; <ref loc="EXO 14:22-29">14:22-29</ref></char></note> <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Istti Musera gidanaas giidi shaaraninne abban xammaqettida. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Wurikka issi ayana quma mida.<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">Kessa 16:35</ref></char></note> <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />Wurikka issi ayana ushshu uyida; istti uyidaykka bana kaalliza ayana zaallafe pulttidayssafe; he zaallayka Kirstoosa.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">Kessa 17:6</ref></char></note> <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Gido attiin Xoossi darotan ufayettibeenna; hessa gishshas istta ahay bazzon kundi attides.<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">Tay 14:29-30</ref></char></note><verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Istti iita miish amottidayssaththo nunikka amottontta mala istta hanoy nu naagettana mala nuus leemiso gidides.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">Tay 11:4</ref></char></note> <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />«Derey maanaassinne uyanaas uttides; yexxanaaska dendides» geetetti kase Geeshsha Maxaafan xaafettida mala istta garsafe issi issi asati ooththoyssaththo intteka eeqa goynnizayta gidopite.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">Kessa 32:6</ref></char></note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Istta garsafe issi issi asati laymatidi issi gallas 23,000 asay dippi gi wuroyssaththo wurontta mala nunikka ane laymatokko.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">Tay 25:1-18</ref></char></note> <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Istta garsafe issi issi asati Godaa paaccidi shooshshan duketti hayqqi dhaydayssa mala nunikka ane Godaa paaccoko.<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">Tay 21:5-6</ref></char></note> <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Istta garsafe issi issi asati zuuzumidi dhayssiza bosha kiitanchchan dhaydayssaththo intteka dhayontta mala zuuzumopite.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">Tay 16:41-49</ref></char></note><verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Hessi wuri nuus leemiso gidana mala istta bolla gakkides; wode wurseththan diza nuus timirte gidana mala nuus xaafettides. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Hessa gishshas ta minna eqqa days gizaadey diikko kundontta mala baas naagetto. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Asa bolla gakkida paaceppe hara aadhdhiza paacey intte bolla gakkibeenna; Xoossi ammanettiza Xoos gidida gishshas intte dandayontta intte wolqqafe bollara intte paacettenna mala izi inttena aggaagenna; gido attiin intte paacettiza wode he paaceza intte dandayana mala wolqqa immidi paaceppe intte kessi ekkana oge izi inttes giigsana.<verse eid="1CO 10:13" /></para>
  <para style="s1">Eeqara Issifeteththi Daanaas Bessenna</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Hessa gishshas ta siiqotoo! Eeqas goynnofte; izappe haakkite. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ta inttes hayssa gizay wozinama gidida gishshassa; hessa gishshas ta yootizayssa ane intte intterkka pirdite. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Nuni Xoossa galatidi ekkiza ushshay Kirstoosa suuththara gaagoteththi dizayssa gidennee? Hessaththoka nu baththi baththi gishetti miza ukeththay Kirstoosa ashora gaagoteththi dizayssa gidennee?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">Mato 26:26-28</ref>; <ref loc="MRK 14:22-24">Mar 14:22-24</ref>; <ref loc="LUK 22:19-20">Luqa 22:19-20</ref></char></note> <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Ukeththay issino gidida mala nunikka daro gidi uttidi wurikka issi asho; nu wurikka issi ukeththaza gishetti moos.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Ane intte Isra7eele nayti ooththidayssa qopite; shiiqiza yarshozappe mizaytas yarshoy shiiqizasora gaagoteththi deennee?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">Lewe 7:6</ref></char></note> <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Histtiin eeqas yarshettida yarsho gidiin woykko eeqay ba baggara go7ara dees gazinaa? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Gidenna! Ammanontta asay shiishshiza yarshoy Xoossas gidontta Xala7essa; inttes Xala7era issifeteththi daana mala ta koykke.<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">Zaare 32:17</ref></char></note> <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Xala7e ushshinne Godaa ushshu intte issife gaththi uyana dandayekketa; Godaa maaddafenne Xala7e maaddafe gaththi maana dandayekketa. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Nuni Godaa hanqeththinoo? Nu izappe minnizonii?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Zaare 32:21</ref></char></note><verse eid="1CO 10:22" /></para>
  <para style="s1">Ubbaaka Xoossa Bonchchos Ooso</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />Wurikka taas imettides shin wurikka tana go7izaaz gidenna; wurikka taassa shin wurikka tana maaddenna.<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1Qoro 6:12</ref></char></note> <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Asi wurikka ba lagge go7anaaz gaththi xeello attiin bana go7anaaz xalala koyoppo.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Giyan bayzettiza asho ubbaa sidhey baynda miite. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Biittaynne biitta bolla dizay wurikka Godayssa.<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Ammanontta asi inttena baso xeygidi shiishshida kath wursi aykkoka sidhontta miite. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Gido attiin issaadey, «Hayssi eeqas yarshettida kaththa» giikko he kaththaa he addeza qofaa gishshassinne inttena sidhiskko moopite. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Ta inttes hessa gizay he yootidaade qofaa gishshas gadis attiin intte qofaa gishshas gabeekke; ta xillo gida dishin aazas hara asa qofaa gaason ta bolla pirdettizee? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Ta Xoos galatada mizaade gida uttada aazas hara asan pirdettoo?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Histtiko intte ay miikkoka, ay uyikkoka woykko aykko ooththiko wursika Xoossa bonchchos ooththite. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Ayhuda asaas gidiin Ayzaabetas gidiin woykko Xoossa Woosa Keeththas oonaska dhuphe gidopite. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Ta as wursaka ay ogerakka ufayssana koyza mala intteka hessaththo ooththite; daroti attana mala ta tana go7izaaz gidontta istta go7izaaz koyays.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Tani Kirstoosa leemiso kaalliza mala intteka ta leemiso kaallite.<verse eid="1CO 11:1" /></para>
  <para style="s1">Xoossa Goyno Woga</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Intte taas wursi qoppiza gishshassinne taappe ekkida timirteza lo7eththi oykkida gishshas ta inttena galatays. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Gido attiin ta intte erana mala koyzay attumasaas ubbaas hu7ey Kirstoosa gididayssa mala attumasay maccas ubbaas hu7e; qasse Xoossi Kirstoosas hu7e. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Ba hu7e gullunttidi Xoos woossizaadey woykko qaala yootizaadey oonikka barkka bana kawushshees.<verse eid="1CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 11:5" />Ba hu7e goozontta woossiza maccassaya woykko tinbite qaala yootiza ay maccasika barkka bana kawushshawus; hessi iza ba hu7e bulisidaadera gina. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Maccassi ba hu7e goozontta aggiko meedettu woykko qanxxisu; izis hu7e meedeteththi woykko qanxxiseththi yeellachchizaaz gidikko goozu. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Addey ba hu7e gullunttanaas bessenna; attumasi Xoossa leemisonne Xoossa bonchcho; maccassi gidikko addes bonchcho.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">Medhe 1:26-27</ref></char></note> <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Gaasoykka maccassi addefe medhettadus attiin attumasi maccassafe medhettibeenna. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Qasseka maccassi addes medhettadus attiin addey maccassas medhettibeenna. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Hessa gishshas kiitanchchati beyanaas naagiza maccassas imettida maata bessiza goosse ba hu7en goozu.<verse eid="1CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11" />Godaa achchan gidikko maccassi addey baynda, addeyka maccassi baynda de7ettenna. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Maccassi addefe beettidayssaththo addeyka maccassafe yelettees; gido attiin nam7ayka Xoossafe beettida.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Maccassi ba hu7e goozontta Xoos woossanaas bessizaakko ane intte pirdite. <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Attumasi ba hu7e adussi dichchiko borso gididayssa inttena medheteththa hanoteththi erisuwee? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Maccay gidikko ba hu7e binana dichchiko hessi izis bonchcho gidennee? Izis adussa hu7e binanay imettiday izis seelo gidanaassa. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Hessa gishshas oonikka hayssa ha yo7ozan palamettana koykko nuus gidiinkka Xoossa Woosa Keeththatas hayssafe hara wogay deenna.<verse eid="1CO 11:16" /></para>
  <para style="s1">Godaa Kawo Eko Woga</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Intte issi soo shiiqettiza wode qohos attiin go7as gidontta gishshas ta hayssa azazoza inttes aaththizay inttena galatashe gidenna. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Intte Woosa Keeththan shiiqiza wode intte garsan shaaketeththi dizayssa ta kaseta siyadis; ta siyoyssafe baggay tumu gidanayssa ta ammanays. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Intte giddofe tumanchchati shaaketti erettana mala hessa mala shaakoy intte giddon daanayssi dosa gidenna. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Intte issife shiiqettidi mizay Godaa kawo gidenna. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Intte shiiqettidi issoy issaa naagontta dishe kath meeta; inttefe issaadey gafan dishin hankkoyssi qasse maththottees. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Histtiin inttes uyanasoynne maanasoy baawee? Woykko Xoossa Keeththe leqqidi aykkoyka bayndayta yeellachcheetii? Histtiin ta inttena ay goo? Hayssa ha hanozas inttena galatoo? Mulekka galatikke.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23-24" style="v" sid="1CO 11:23-24" />Tani Godaappe ekkidayssa inttes aaththadis; hessika Godaa Yesusi aadhdhi imettida omars uketh denththidinne Xoos galati baththidi, «He7ite! Miite! Hayssi inttes gidiza ta asho; tana qoppanaas intte hayssa ooththite» gides. <verse eid="1CO 11:23-24" /><verse number="25" style="v" sid="1CO 11:25" />Hessaththoka kawoppe guye ushshaa denththidi, «Hayssi ushshay ta suuththan haniza ooraththa caaqo; hessa gishshas ushshaafe intte uyiza wode hayssa tana qoppana mala ooththite» gides.<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Kessa 24:8</ref>; <ref loc="JER 31:31-34">Er 31:31-34</ref></char></note><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Hayssa ukeththaa intte miza wodenne hayssa ushshaaka uyiza ubba wode Goday yaana gakkanaas intte iza hayqo yootana. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Hessa gishshas oonikka bessontta dishin hayssa ukeththaa miikko woykko Godaa ushshaa uyikko izaadey Godaa ashonne iza suuththaa kawushshida gishshas izi oyshettana. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Oonikka hayssa ha ukeththaa maanaappenne ushshaafe uyanaappe kaseti barkka bana paacco. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Gaasoykka oonikka Godaa asho baas gelontta dishin miikkonne Godaa ushshaa uyikko izaadey barkka ba bolla pirda ehees. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Intte garsan daro asay daaburdaynne sakettiday qasseka baggay hayqqiday hessa gaasonna. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Nuni nurkka nu bolla pirdizaakko izi nu bolla pirdenna. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Gido attiin Goday pirdiza wode nu hankko ammanontta asaara pirdettontta mala izi nuna kaseti murees.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Hessa gishshas ta ishatoo! Intte maana shiiqiza wode issoy issaara naagettite. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Intte shiiqiza shiiqoy pirdas gidontta mala inttefe oonikka gafidaadey diikko kasetidi ba soon mo; hankko attidayssa tani hara wode hee intteko baada woga woththana.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">Xillo Ayana Imotata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Ta ishatoo! Ayanay immiza imota gishshas intte issi miish erana mala ta koyays. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Intte ammananaappe kase coo mela yaanne haa guussan intte erontta kaallidi doona duude gidida eeqatakko bidayssa intteka ereeta. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Hessa gishshas oonikka Xoossa Ayanan haasayshe, «Yesusi qanggettidaade» geenna. Hessaththoka Xillo Ayanan gididi attiin oonikka, «Yesusi Godaa» gaana asi donttayssa ta inttes yootays.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Asas imoteththi dumma dumma gidishin Ayanay gidikko issino. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Oosoykka dumma dumma gidishin Goday gidikko issino. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Dumma dumma ooso ogeti diikkoka wursika ooththizay issi Xoossaa.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />Gido attiin Xillo Ayana qoncciso imotay issaades imettizay issife go7ettanaassa. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Issaades hiillan haasayana erateththi imettees; hara asas qasse he Ayanankka erateththa qaalan haasayana qaalay imettees. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Issaades he Ayanan ammanoy imettees; hara asas qasse he Ayanankka hargizayta paththiza imotay imettees. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Issaades malalisiza ooso ooththiza imotay, hara asas tinbite qaala<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="fqa" closed="false">Tinbite qaala: </char><char style="ft" closed="false">Tinbite qaala Xoossa qaala birsheth woykko qonccisi yooto.</char></note> haasaya imotay, hara asas qasseka ayanata shaakki eroy, hara asas dumma dumma qaalan haasayay, qasseka hara asas hara dumma dumma qaalan haasayettidayssa birshana imotay imettees. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Heyti wurikka he issi Ayanay immiza imota gidishin issi issi asas ba koyida mala immees.<verse eid="1CO 12:11" /></para>
  <para style="s1">Issi Asateththa Bolla Dumma Dumma Billiteta</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Issi asateththa bolla daro billiteti diikkoka asateththay issino; gido attiin billiteti daro gidikkoka asateththay issino xalla; Kirstoosikka hessa mala.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">Oro 12:4-5</ref></char></note> <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ayhuda asata gidiinkka Girike asata gidiinkka, aylle gidiinkka woykko goqa asata gidiinkka nu wurikka issino gidanaas issi Ayanan xammaqettidos; nu wurikka ha issi Ayanappe uyidos.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Asateththi medhettiday daro billitetappe attiin issi billitefe xalala gidenna. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Tohoy, «Tani kushe gidontta gishshas asateththaa giddon diikke» giikko izi hizgida gishshas izas asateththaan duussi attanee? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Hayththi, «Ta ayfe gidontta gishshas asateththaa giddon diikke» giikko hessa gishshas asateththaan duussi izas attanee? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Asateththi wurikka ayfe xalla gididaakko aazan siyanee? Asateththi wurikka hayth xalla gididaakko aazan singanee? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Gido attiin Xoossi issaa issaa ba koyida mala asateththaa giddon daanaas bessizason woththides. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Billitey wurikka issino gididaakko kumeththa asateththi awappe beettanee? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Hessa gishshas billiteti daro shin asateththi gidikko issino xalla.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Ayfey kushe, «Nena ta koykke» gaanaas dandayenna; hu7ey toho, «Nena ta koykke» gaana dandayenna. <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Haray attoshin ubbaafe laafa misatiza billiteti daro koshshizayta. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Nuni laafa gi leqqiza billiteta hankkoytappe aaththi bonchchoos; qasseka nu isttan yeellatiza billiteta harappe aaththi naagoos. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Nu isttan yeellatontta billitetas gidikko hessa mala bonchcho koshshenna; Xoossi gidikko asateththa billiteta issi bolla oyseththidi bonchchoy paaccizaytas aadheththa bonchcho immides. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Izi hessa ooththiday asateththa billiteta garsan shaaketeththi dontta istti ba garsan issoy issaa banara gina gi qoppanaassa. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Issi billitey sakettiko hankko billiteti wurikka izara issife saketteettes; issi billitey bonchchettiko billiteti wurikka issife ufayetteettes.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Histtiko intte wurikka Kirstoosa asateth; intte issoy issoy iza asateththa billiteta. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Xoossi Woosa Keeththa giddon koyro Hawaareta, nam7anththo qasse nabeta, heedzdzanththo astamaareta, kaaleththidi malaata ooththizayta, paththiza imoteththi dizayta, haratakka as maaddiza imotay dizayta, dere ayso erateththi dizaytanne dumma dumma qaala haasayana imoteththi diza asata woththides. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Wurikka hawaaretee? Wurikka nabetee? Wurikka astamaaretee? Wurikka malalisiza miish ooththizoo? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Ubbaasikka hargizayta paththiza imotay dizee? Asi wurikka dumma qaalan haasayzee? Dumma qaalan haasayettoyssa asi wuri birshizee? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Gido attiin intte wurikka ubbaafe aadhdhiza imota lo7eththi koyite.</para>
  <para style="p" vid="1CO 12:31">Qasseka hara ubbaafe aadhdhiza oge ta inttena bessana.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">Tumu Siiqo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Ta asa qaalaninne salo kiitanchchata qaalan haasaykkoka taas siiqoy baynda aggiko coo mela birata giirissa mala woykko daala giirissa mala. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Tinbite haasayza imotay taas diikkoka, woykko xuura yo7otanne erateth wursa ta erikkoka, zumay izi dizasoppe dhoqallada haraso diggiza ammanoy taas diikkoka hessa wursaka siiqoy baynda ta ooththiko hessi hada.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mato 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref></char></note> <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Taas dizaaz wursa manqotas ta immikokka, ta asateth ta taman xuuggikokka,<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="fqa" closed="false">Taman xuuggikokka: </char><char style="ft" closed="false">Taman xuuggikokka gizayssa issi issi Geeshsha Maxaafati otoreteththas geettes.</char></note> siiqoy baynda aggiko tana hessi aykkoka maaddenna.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Siiqoy dandaya, qasseka kiya; siiqoy miqqaynenna; ceeqettenna; otorettenna; <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />bessonttaaz ooththenna; ba go7a xalla xeellenna; qoho qoodan yeggenna. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Siiqoy tumanppe attiin makkallan ufayettenna. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Siiqoy ubba wode dandayees; ubba wodekka ammanees; ufays ooththeessinne minni eqqees.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Siiqoy mulekka kundenna; tinbitey gidikko attana; hara qaalan haasayaykka attana; erateththika shaarettana. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Gaasoykka nu erizay ubbaa gidontta shaakki eroos; tinbite haasaya gidikkoka bagga haasayoos. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Gido attiin wurseththi gakkiza wode kumeth gidontta imotay he wode shaarettana.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Ta guuththa naateteththan dashe naa mala haasayayssinne naa mala qoppays; naa malakka yuushsha qoppays; kaha kunththidaappe guye kase naateththan hanizayssa wursaka yegga aggadis. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Nuni ha7i be7izayssi haaththan xeelliza mala coo bozhi bozhees shin he wode gidikko nu iza ayfeso lo7eththi beyana; ta ha7i kumeth gidontta bagga xalala erays; he wode gidikko tani ta hu7es erettidayssa mala erana.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Hessa gishshas ammanoy, hidotaynne siiqoy hayti heedzdzati eqqi daana; hayta ubbaafe aadhdhizay siiqo.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">Imotatan Bessiza Mala Go7eteth</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Siiqo kaallite; ayana imotata harappeka tinbite haasayza imotata lo7eththi koyite. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Hara qaalan haasayzaadey Xoossas attiin asas haasayenna; xuura gidida yo7o Ayanan haasayza gishshas izi gizay asas gelenna. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Tinbite haasayzaadey as minththeththanaas, denththeththanaassinne go7anaas haasayees. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Hara qaalan haasayzaadey qasse barkka bana minththeththees; tinbite haasayzaadey gidikko Woosa Keeththaa go7ees.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Intte wurikka hara qaalan haasayzaakko ta dosays shin hessafekka bollara intte tinbite qaalan haasayzaakko ta dosays; Woosa keeththay minnana mala hara qaalara haasayzaadey ba haasayzayssa birshontta izi hara qaalara haasayzayssafe tinbite haasayzaadey aadhdhees. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Hessa gishshas ta ishatoo! Ta intteko biza wode ta inttes qoncciseththan woykko erateththan woykko tinbiten, woykko timirten yootontta hara qaalara yootikko hessi inttena ay go7anee?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Hessi coo susul7e malanne diiththa mala shemppoy baynda istta giirissas dummateththi shaaketti erettontta aggiko iza wostti eranee? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Qasseka xurumbay aazas punettizaakko woykko zayey aazas zayettizaakko shaakki erettontta ogera punettiko ooni olas giigettanee?<verse eid="1CO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 14:9" />Intteka hessa mala; intte doonappe erettiza qaalay kezontta aggiko intte gizayssa ooni eranee? Coo mela carkon dhayana. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Alame bolla daro dumma dumma qaalay dees shin birsheththi baynda qaalay baa. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Hessa gishshas issaadey haasayza qaalaa birsheth ta erontta aggiko haasayzaades tani imath gidays; izaadeyka taas imath gidees. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Intteka hessa mala Ayanan imoteththata demmanaas koyza gishshas Woosa Keeththa go7iza imotata demmanaas lo7eththi koyite.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Hessa gishshas hara qaalan haasayza asi ba haasaydayssa birsheth erana mala baas woosso. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Tani hara qaalara woossiza wode ta Ayanan woossays attiin ta izappe aykkoka erikke. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Histtiin ta ay ooththana mala taas bessizee? Tani ta Ayanankka woossana; wozinan woththadakka woossana; ta Ayanankka yexxana. Wozinarakka yexxana. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Hessaththo gidontta aggiko ne Xoos Ayanan galatiza wode hessa erontta issi imaththa asi ne galata woosaa wostti, «Amiin» gaanaas dandayzee? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ne bessiza mala galatanaas dandayaasa; hankkoyssi gidikko izan go7ettenna.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Tani inttefe bollara hara qaalan haasayza gishshas Xoos galatays. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Gido attiin Woosa Keeththan erettontta daro shii qaalata haasayanaappe hara asata tamaarsanaas asay eriza ichchash qaalan haasayana dosays.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Ta ishatoo! Intte intte qofan guuththa nayta mala gidopite; iita oosos gidikko guuththa nayta mala gidite; qofan gidikko kaha kunththida asata gidite. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Kase wogaankka,</para>
  <para style="q1" vid="1CO 14:21">« ‹Istta qaalay imath gidida</para>
  <para style="q2" vid="1CO 14:21">allaga asata qaalara</para>
  <para style="q2" vid="1CO 14:21">ta hayssa asaas yootana.</para>
  <para style="q2" vid="1CO 14:21">Hessaththo yootiinkka ta gizaaz</para>
  <para style="q2" vid="1CO 14:21">istti siyettenna› gees Goday»</para>
  <para style="m" vid="1CO 14:21">geetetti kase Geeshsha Maxaafan xaafettides.<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">Isa 28:11-12</ref></char></note><verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Hessa gishshas hara qaalan haasayay ammanontta asaas malata gidees attiin ammanizaytas malata gidenna; tinbitey gidikko ammanizaytas attiin ammanonttaytas gidenna.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Histtiko Woosa Keeththan ammaniza asay issife shiiqidason wurikka erontta hara qaalan haasayshin hessa erontta asati woykko ammanontta asay shiiqidi haasayzaaso gelikko, «Hayti gooyeettes» geettennee? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Gido attiin asay wuri tinbite qaala haasayettishin imaththi woykko ammanonttaadey gelikko ba siyidayssa ubbaa erananne he qaalan pirdettana. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Izaadey ba wozinan qotti woththidaazi wuri qonccananne izikka ba baggara, «Tumappe Xoossi inttenara dees» giidi gufanni Xoossas goynnana.<verse eid="1CO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Hessa gishshas ta ishatoo! Histtiin ay giinoo? Intte issife shiiqiza wode inttefe issi issi asas mazamure qasse issi issi asas timirtey dees; issi issi asas qonccontta xuura miishshata qonccisiza imotay dees; hara asas dumma qaalan haasayana imotay dees; haras qasse he qaalaa birshiza imotay dees; hessi he imotay wurikka ammanizayta go7anaas bessees. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Hara qaalara haasayzay diikko nam7u as woykko dari darikko heedzdzu gididi taran taran yootetto; hara asi qasse birsho. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Birshizaadey baynda aggiko shiiqida asaa giddon co7u giidi baas xallanne Xoossas xalla yooto.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />Tinbite haasaya imotay diza nabeti nam7ati woykko heedzdzati tinbite haasayetto; hankko asay yootettidayssa lo7eththi paacco. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Uttida asaa garsafe issaadey issi miishshi qoncciko koyro haasayzayssi co7u go. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Intte garsafe issi issi asi taamarana malanne minettana mala intte wurikka taran taran tinbite yootanaas dandayeeta. <verse eid="1CO 14:31" /><verse number="32-33" style="v" sid="1CO 14:32-33" />Nabeta ayanay nabetas azazettees; gaasoykka Xoossi saroteththa Xoossafe attiin wocama Xoos gidenna; ammanizayta Woosa Keeth ubbasonkka hessa mala. <verse eid="1CO 14:32-33" /><verse number="34" style="v" sid="1CO 14:34" />Ammaniza asay goynos shiiqizason maccassati co7u getto; Muse wogay kase gida mala istti azazetteto attiin shiiqoson istti haasayana mala isttas imettibeenna. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Maccassati eranaas koyza issi issi yo7oti diikko ba keeththan ba azinata oychchetto; gaasoykka maccassi shiiqoson haasayay yeellachchizaaza.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Xoossa qaalay inttefe kezidee? Woykko intteko xalla gakkidee? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Oonikka bana, «Nabe» giikko woykko, «Taas Xillo Ayanappe imotay dees» gizaadey diikko hayssi ta inttes xaafidayssi Godaa azazo gididayssa ero. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Hayssa erontta asi diikko izi ba hu7es erettenna.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Hessa gishshas ta ishatoo! Buro tinbite haasayanaas lo7eththi koyite; dumma dumma qaalan haasayakka diggofte. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Gidikkoka wurikka maararanne wogara gido.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">Kirstoosa Dendo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Ha7ikka ta ishatoo! Ta inttena sabbakiin intte ekkidi izan minni eqqida Mishiraachcho qaalaa ha7i qofsana koyays. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Ta inttes sabbakida qaalaa intte lo7eththi oykkiko he Mishiraachcho qaalaan intte attana; hessa mala gidontta aggiko intte ammanoy hada.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Tani taas ekkidayssanne ubbaafe aadhdhizayssa inttes aaththa immadis; Geeshsha Maxaafati gizayssa mala Kirstoosi nu nagara gishshas hayqqides.<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">Isa 53:5-12</ref></char></note> <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Moogettides; Geeshsha Maxaafatan xaafettidayssa mala heedzdzanththo gallas hayqoppe dendides.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">Maza 16:8-10</ref>; <ref loc="MAT 12:40">Mato 12:40</ref>; <ref loc="ACT 2:24-32">Hawa 2:24-32</ref></char></note> <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Hessafe kaallidi Phexroosas beettides; qasseka Yesusa kaalliza tammanne nam7atas beettides.<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="LUK 24:34">Luqa 24:34</ref>,<ref loc="LUK 24:36">36</ref>; <ref loc="MAT 28:16-17">Mato 28:16-17</ref>; <ref loc="MRK 16:14">Mar 16:14</ref>; <ref loc="JHN 20:19">Yoha 20:19</ref></char></note> <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Hessafe guye ichchashu xeetuppe bollara diza ammanizaytas issito beettides; iza be7ida asaappe dariza baggay paxa dees; baggay qasse hayqqides. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Hessafe guye Yaaqoobes beettides; kaallidikka kumeththa Hawaaretas beettides.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8-9" style="v" sid="1CO 15:8-9" />Tani Hawaareta ubbaafe laafanne kase Xoossa Woosa Keeththe gooddida gishshas Hawaare geetettanaas bessonttaadeko shin as ubbaafe awucaya misatiza taaska beettides.<note caller="-" style="x"><char style="xo" closed="false">15:8-9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 9:3-6">9:3-6</ref></char></note> <verse eid="1CO 15:8-9" /><verse number="10" style="v" sid="1CO 15:10" />Gido attiin Xoossa kiyateththan ha7i ta hananayssa hanadis; taaska imettida Xoossa kiyateththi hada gidibeenna; tani oonappeka bollara daro minna ooththadis. Gido attiin hessa ooththiday tana gidontta Xoossa aadho kiyateth. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Hessa gishshas tana gidiin isttaka gidiin nu wurikka sabbakizay hessa; intteka ammaniday hessa.<verse eid="1CO 15:11" /></para>
  <para style="s1">Hayqqida Asa Denth</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Kirstoosi hayqoppe dendidayssa nu tamaarsiko histtiin intte garsafe issi issi asati waanidi hayqoppe dendoy baa gizoo? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Hayqqida asas denththi donttaa gidikko Kirstoosikka dendibeenna guussakaa? <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Kirstoosikka hayqoppe dendonttaa gidikko nu sabbakos go7ay baa; intte ammanoykka hada. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Hessafekka bollara, «Xoossi Kirstoosa hayqoppe denththides» giidi nu markkattida markkayka nuna wordo Xoossa markkatta kessideskkaa? Hayqqida asay hayqoppe dendonttaa gidikko Xoossi Kirstoosakka denththibeenna guussa. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Gaasoykka hayqqidayti dendonttaaz gidikko Kirstoosikka hayqoppe dendibeenna. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Kirstoosi hayqoppe dendonttaa gidikko intte ammanoy hada; intteka hanno gakkanaas intte intte nagarara deeta guussa. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Hanoy hessa mala gidikko Kirstoosa ammanidi hayqqidayti wurikka dhayda guussa. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Nuni Kirstoosan ufays ooththizay hanno biittay bolla duussas xalla gidikko nu asaa ubbaafe laafata.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Gido attiin Kirstoosi hayqqidaytas ubbaas bayra gididi hayqoppe tumu dendides. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Hayqoy issi as Addaame baggara yida mala hayqqidayta denththi Kirstoosa baggarakko. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Asi wurikka Addaame baggara hayqqida mala hessaththoka asi wurikka Kirstoosa baggara hayqoppe dendana. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Gido attiin wurikka ba tarara tarara dendana; koyro bayra gidida Kirstoosi dendides; izappe kaallidi izi yiza wode Kirstoosas gidizayti dendana. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Hessafe guye haarettiza dereta godateththinne wolqqamata wursi dhayssidaappe guye kawota Xoossa Aawaas aaththi immiza wode he wode wurseth gidana.<verse eid="1CO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 15:25" />Izi ba morkke wursika ba toho gars aaththana gakkanaas izi kawotanaas bessees.<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maza 110:1</ref></char></note> <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Buro wurseththan xoonetti dhayana morkkey hayqo. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />«Xoossi wursika iza godateththafe garsan woththides» gizaazi Geeshsha Maxaafan xaafettides; gido attiin, «Wurikka iza Godateththa garsan gidides» gishin wurikka iza godateththa garsan ooththida Xoossaa Aawaa gujjenna.<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Maza 8:6</ref></char></note> <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Wurikka izas haarettidayssafe guye Xoossi ubbaafe bolla gidana mala Xoossa nay qasse ubbaa baas haarisidayssas Xoossa Aawaas haarettana.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Hayqoppe denththi dontta aggiko histtiin hayqqida asaa gishshas giidi xammaqettiza ubbaas go7ay aazee? Hayqqidayti mulekka dendonttaa gidikko histtiin asay istta gishshas aazas xammaqettizee? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Nu qasse ubba wode iita metos aadhdhi imettizay aazassee? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Ta ishatoo! Hach hach hayqoy tanara gaaggees; hessaka nu Godaa Yesus Kirstoosa gaason intte bolla diza ammaneteth ta inttes qonccisays. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Tani Efesoonen do7a misatiza asatara baaxetidayssi asi beyana mala xalala gidikko taas izan aaza wodhey dizee? Hayqqidaytas denththi dontta aggiko, «Nu wonto hayqqana gishshas ane moos; ane uyoos» gizayta mala nunikka istta mala gidoos.<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">Isa 22:13</ref></char></note><verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Intte balettofte! Iita laggeteththi lo7o amalera dizayta moorees. <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Wozinama gidite; nagara ooththofte; Xoos eronttayti issi issi asati intte garsan diza gishshas ta hessa inttena yeellachchanaas gays.<verse eid="1CO 15:34" /></para>
  <para style="s1">Hayqoppe Dendana Asateth</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />«Hayqqidayti waani dendanee? Ay mala ashora dendanee?» gizaadey daana dandayees. <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Nenoo eeyazoo! Ne zeriza zereththay hayqqontta dishe caarenna. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Neni zeriza kaththa modheya gistte woykko hara kaththa ayfe gidikkoka guyeppe ne ekkanaara ha7i ne zerooro gidukku. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Xoossi qasse ba koyida mala he zereththaas iza mala medho immees; zereththaa qommotas issaas issaas iza misatiza asateth immees.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Ashoy wurikka issi mala gidenna; asa ashoy issaa gidishin mehe ashoy qasse hara; kafo ashoy hara; mole ashoykka hara qommo.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Hessa malakka salon dizaytaska istta misatiza medhoy dees; biitta bolla dizaytaska istta misatiza medhoy dees; gido attiin saloyta bonchchoy issi mala; biitta bolla dizayta medho bonchchoyka dumma. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Arshe bonchchoy issino; gido attiin agina bonchchoy qasse dumma; xoolintteta bonchchoyka hara; issi xoolintte bonchchoy hara xoolintte bonchchofe dummatees.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Hayqqida asa denththika hessa mala; wooqqiza medhoy zerettiin wooqqontta medhoy dendana. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Kawushshateththan zerettana shin bonchchon dendana; daabursan zerettana shin wolqqama gididi dendana. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Medheteththa asateththi zerettana shin Ayana asateththi dendana; medheteththa asateththi diikko qasseka Ayana asateththika dees.<verse eid="1CO 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45" />Hessa gishshas, «Koyro as Addaamey de7oy diza medheteth gidides» geetetti Geeshsha Maxaafan xaafettides. Nam7anththo Addaame gidida Kirstoosi gidikko asas de7o immiza Ayana.<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">Medhe 2:7</ref></char></note> <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Gido attiin koyro yiday Ayanayssa gidontta medheteththayssa; Ayanayssi qasse guyeppe yidayssa. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Koyro yida Addaamey biittafe medhettida gishshas izi biittafe. Nam7anththo yidayssi saloppe. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Biittafe gididayti istti biittafe medhettidayssa mala. Saloppe gididayti saloppe yidayssa mala. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Nuni biitta asa medha may7oyssaththoka saloyssa medhakka may7ana.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ta ishatoo! Ta hayssa inttes yootays ashoynne suuththi Xoossa kawoteth laattettenna; dhayanayssi dhayonttayssa laattenna.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Ane ta inttes issi xuura yo7o yootays; nuni wurikka hayqqoko; gido attiin nu wurikka laamettana. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />Hessika hananay nu qoppontta dishin wurseththa xurumbay punettiza wode qiphida ayfey xeelliza mala issito hanana; xurumbay punettana; hayqqida asay wooqqonttayta gididi dendana; nunikka laamettana. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Dhayzayssi dhayonttayssa may7anaas, hayqqizay hayqqonttayssa may7anaas bessees.<verse eid="1CO 15:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54" />Dhayzay dhayonttaaz, hayqqizay hayqqonttaaz may7iza wode, «Hayqoy xoonetti mitettides» geetetti kase Geeshsha Maxaafan xaafettida qaalay polettana.<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">Isa 25:8</ref></char></note> <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />Hessaththoka,</para>
  <para style="q1" vid="1CO 15:55">«Hayqoo! Kase ne xoonoy awan dizee?</para>
  <para style="q2" vid="1CO 15:55">Hayqoo! Ne izara caddiza yiishshay</para>
  <para style="q2" vid="1CO 15:55">awan dizee?»</para>
  <para style="m" vid="1CO 15:55">geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">Hose 13:14</ref></char></note> <verse eid="1CO 15:55" /><verse number="56" style="v" sid="1CO 15:56" />Hayqoy izara dukkiza wolqqay nagara; nagara wolqqay woga. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Gido attiin Godaa Yesus Kirstoosa baggara nuus xoono immiza Xoossas galatay gido.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Hessa gishshas ta siiqo ishatoo! Minni eqqite; ay miishshankka yark yarkofte; Godaa oosos intte daaburza daabursay hada gidonttayssa eridi ubba wode pacey baynda Godaas ooththanaas minettite.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">Yerusalaamen Ammano Gaason Waayettizaytas Miishsha Keso</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ha7i qasse ammanizaytas miishsha keso gishshas Galatiyan diza Woosa Keeththatas tani immida azazo mala intteka ooththite.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">Oro 15:25-26</ref></char></note> <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Miishshay kezanay buro ta hee biin gidontta mala inttefe issi issi asi baas diza mala saaminttan saaminttan wogga gallas kessi woththo. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Ta hee biza wode intte doorida asatas ta moyzo dabdaabe xaafa immada, istti intte immida imotaa Yerusalaame gaththana mala haappe ta kiittana. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Ta isttara baanaas koshshizaaz gidikko tanara bandettes.<verse eid="1CO 16:4" /></para>
  <para style="s1">Oge Baanaas Phawuloosa Qofa</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Tani bashe Maqidooniyara aadhdha buussi taas attontta gishshas ta Maqidooniya gakkada heera intteko baana.<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">Hawa 19:21</ref></char></note> <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Ta awakka bishin tana ogey waayisontta mala intte tana maaddana mala bashe ta intte achchan gam7ontta aggike. Oonee erizay balgoy aadhdhana gakkanaas ta intte achchan balgoza aaththontta waaya aggana. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ta intte achchan daro wode gam7anaas koyza gishshas inttena coo ogera aadhdha bashe beyanaas koykke; Godaa shene gidikko intte achchan adussa wode gam7anaas koyays.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Gido attiin Phenxeqoste geetettiza ba7aale gallas gakkanaas ta Efesoonen gam7ana.<note caller="-" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">Lewe 23:15-21</ref>; <ref loc="DEU 16:9-11">Zaare 16:9-11</ref></char></note> <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Ta heen gam7ana gaasoykka taas heen gita ooso pengey doyettides shin tanara eqettizayti daroti deettes.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ximtoosi intteko biikko izi ta mala Godaa oosanchcha gidida gishshas izi baboy baynda daana mala intte iza maaddite.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1Qoro 4:17</ref></char></note> <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Hessa gishshas oonikka iza kadhoppo; izi taakko saron simmana mala intte iza maaddite; nunikka hara ammanizaytara iza yuussaa naagon doos.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Nu isha Aphiloosi hara ammanizaytara intteko baana mala keeha woossadis shin izi qasse ha7i intteko baanaas koyibeenna; gido attiin baana ogey izas giigshin izi intteko baana.<verse eid="1CO 16:12" /></para>
  <para style="s1">Wurseththa Zorenne Saroka</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Beeggite! Ammanon minni eqqite; minnite; goobite. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Intte ooththizaaz wursika siiqon ooththite.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Ta ishatoo! Akaya biittan koyro ammaniday Isttifaanoseso asaa gididayssanne ammaniza asaa maaddanaas istti bana aaththi immidayssa intteka ereeta.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1Qoro 1:16</ref></char></note> <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Istta misatiza asatassinne isttara issife daaburza asatas ubbaas azazettana mala ta inttena woossays.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Isttifaanosi, Ferdonaxoosinne Akayqoosi yida gishshas ta daro ufayettays; gaasoykka intte haan tanara dontta gishshas istti taas paccizaaz wursi kunththida. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Ta wozinanne intte wozina wursi shempisida; hessa gishshas hessantta mala asata mule balopite.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Iisiya biittan diza Woosa Keeththati inttena saro geettes; Aqilaynne Phirsiqillayka istta soon shiiqiza ammaniza asay Godaa sunththan bonchcho sarota inttes shiishsheettes.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Hawa 18:2</ref></char></note> <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Haan ammanizayti wurikka inttena saro geettes; intte intte giddon issoy issaara siiqo yeereteth yeerettite.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Hayssa sarokaa ta kushera xaafiday tana Phawuloosa.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Godaa dosonttaadey diikko izi qanggettidaade gido! Godoo haa ya! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Godaa Yesusa kiyateththi inttenara gido.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Ta siiqoy Godaa Yesus Kirstoosa baggara inttes ubbaas gido! Amiin.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>