<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Gamo Full Bible final version</book>
  <para style="h">Hawaareta Ooso</para>
  <para style="toc1">Hawaareta Ooso</para>
  <para style="toc2">Hawaareta Ooso</para>
  <para style="toc3">Hawa</para>
  <para style="mt1">Hawaareta Ooso</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Hawaareta ooso maxaafazi Luqaasa Mishiraachcho qaalaappe kaallizayssa; ha maxaafazas ayfe qofay koyro Yesusa kaallizayti Xillo Ayanay kaaleththiin iza gishshas yootiza Mishiraachcho qaalaa, «Yerusalaamen, Yuhuda dere ubbaan, Samaariyaninne biitta gaxa gakkanaas» 1:8 Mishiraachcho qaalaa istti wostti ubbaa gaththidaakko hessa yootanaassa; maxaafazi ammanoy Ayhudata garsan doommidi kumeththa alame asay ammanana gakkanaas izi waani waani aakki aakki bidaakko yootizayssa. Hayssa maxaafaa xaafidayssi ammanizayti Oroome kawora eqettanaas garsara yo7o qachchizayta gidonttayssanne ammanizayta ammanoy hankko Ayhudata ammano polokko gaththizaaz gididayssa erisanaas daro baaxetides.</para>
  <para style="ip">Hawaareta Ooso maxaafay Yesusa gishshas Mishiraachcho qaalay gakkizasoy woden woden aakki aakki bizayssanne Woosa Keeththey minni xaphidayssa bessiza heedzdzu gita kifiletan shaakettanaas dandayees.</para>
  <para style="ili">1. Ammanizayta ammanoy Yesusi dendidi pude salo bidaappe guye Yerusalaamen doommides.</para>
  <para style="ili">2. Isra7eele dere kumeth gakkides.</para>
  <para style="ili">3. Oroome gujji ekkidi Mediteraane abbaa yuushon diza deraa gakkanaas oykkoyssa yootees.</para>
  <para style="ip">Hawaareta Ooso maxaafan keehi qoncci beettizay Xillo Ayana ooso gidishin Phenxeqoste ba7aale gallas Yerusalaamen ammaniza asaa bolla wolqqara wodhdhoyssa, hessaththoka he maxaafazan yootettida yo7otan ubbaan qonccida mala Xillo Ayanay Woosa Keeththanne Woosa Keeththa kaaleththizayta kaaleththidayssanne minththeththidayssa gujjees. Beni wode yootettiza ammano qaalay dumma dumma ogera sabbakettides. Hawaareta ooso maxaafan polettida oosotikka kiitazi ammanizayta de7onne istta issifeteththaan diza wolqqay ay mala minokkonne eriseettes.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Markkateththas giigeteth <char style="ior"><ref loc="ACT 1:1-26">1:1-26</ref> </char></para>
  <para style="io1">Yerusalaamen yootettida markkateth <char style="ior"><ref loc="ACT 2:1-8:3">2:1—8:3</ref> </char></para>
  <para style="io1">Yuhudaninne Samaariyan yootettida markkateth <char style="ior"><ref loc="ACT 8:4-12:25">8:4—12:25</ref> </char></para>
  <para style="io1">Phawuloosa Hawaareteththa ooso <char style="ior"><ref loc="ACT 13:1-28:31">13:1—28:31</ref> </char></para>
  <para style="io2">Mishiraachcho qaalaa yootanaas Phawuloosas koyro buus <char style="ior"><ref loc="ACT 13:1-14:28">13:1—14:28</ref> </char></para>
  <para style="io2">Yerusalaame shiiqo <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref> </char></para>
  <para style="io2">Mishiraachcho qaalaa yootanaas Phawuloosas nam7anththo buus <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref> </char></para>
  <para style="io2">Mishiraachcho qaalaa yootanaas Phawuloosas heedzdzanththo buus <char style="ior"><ref loc="ACT 18:23-21:16">18:23—21:16</ref> </char></para>
  <para style="io2">Yerusalaamen, Qisaariyaninne Oroomen Phawuloosa qasheteth <char style="ior"><ref loc="ACT 21:17-28:31">21:17—28:31</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s1">Yesusi Salo Dendi Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Tofiloosaa! Yesusi ooththanaassinne tamaarsanaas oykkidayssa wursa ta nees koyro maxaafaan xaafadis.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">Luqa 1:1-4</ref></char></note> <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />Hessika izi pude denththa gallas gakkanaas ba doori kiittidaytas Xillo Ayana baggara izi isttas immida azazokko. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Izi daro waaye be7idaappe guye isttako shiiqidi hayqoppe dendanayssa isttas daro markkara qonccisishe oyddu tammu gallas gakkanaas isttas gallas gallas beettishe Xoossa Kawoteththa gishshas yootides. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Isttara issife maaddan utti dishe istta, «Yerusalaameppe kezopite; gido attiin ta inttes yootishin intte siyidayssa ta Aaway immida ufayssaa naagite.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">Luqa 24:49</ref></char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yohannisi haaththan xammaqides; intte gidikko guuththa wodeppe guye Xillo Ayanan xammaqettana» giidi yootides.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mato 3:11</ref>; <ref loc="MRK 1:8">Mar 1:8</ref>; <ref loc="LUK 3:16">Luqa 3:16</ref>; <ref loc="JHN 1:33">Yoha 1:33</ref></char></note><verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Isttika issi bolla shiiqetti dishe, «Godoo! Ne Isra7eeleta kawoteth zaarada ha7i essanee?» gi oychchida.<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Izikka isttas, «Aaway ba shenen woththida wode eroy inttes imettibeenna. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Gido attiin Xillo Ayanay intte bolla wodhdhida wode intte wolqqa ekkana. Yerusalaamenkka, Yuhudankka, Samaariyankka ubbason biitta gaxa gakkanaas intte taas markkatta gidana» gides.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">Mato 28:19</ref>; <ref loc="MRK 16:15">Mar 16:15</ref>; <ref loc="LUK 24:47-48">Luqa 24:47-48</ref></char></note><verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Hessa gi yootidaappe guye istti xeellishin pude salo dendides; shaaraykka istta ayfeppe iza genththides.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">Mar 16:19</ref>; <ref loc="LUK 24:50-51">Luqa 24:50-51</ref></char></note><verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Izi bishin istti iza tishshi histti pude salo xeellishin booththa may7o may7ida nam7u asati qoppontta istta achchan eqqidi, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />«Intteno Galila asatoo! Intte pude salo xeellishe hayssan aazas eqqidetii? Hayssi intte matappe pude salo dendishin intte be7iza Yesusi salo kezishin intte be7ida mala hessaththoka izi haa simmi yaana» gida.<verse eid="ACT 1:11" /></para>
  <para style="s1">Yuhuda Sohon Maatiyaasa Dooreteth</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Hessafe guye Dabrazayte geetettiza zuma bollafe wodhdhidi Yerusalaame simmida. He zumaykka Yerusalaameppe issi kilo metire mala haakkees. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Gede katamayo gelidi kase ba diza keeththaa pooqe bolla kezida; heytikka Phexroosa, Yohannisa, Yaaqoobe, Indiraasa, Piliphoosa, Toomaasa, Bartelemoosa, Matoosa, Ilfiyoosa naa Yaaqoobe, ba baggas mishettiza Simoonanne Yaaqoobe naa Yuhuda.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Mato 10:2-4</ref>; <ref loc="MRK 3:16-19">Mar 3:16-19</ref>; <ref loc="LUK 6:14-16">Luqa 6:14-16</ref></char></note> <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Heyti wurikka maccassatappe Yesusa aayo Maaramira hessaththoka iza ishatara issi wozinan issi bolla qanxxontta minni woossida.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />He gallassatan Phexroosi xeetanne nam7u tammu ammaniza asaa giddon eqqidi, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«Ta ishatoo! Yesusa oykkida asata kaaleththi ehida Yuhuda gishshas Xillo Ayanay kasetidi Dawite doonan haasayda Geeshsha maxaafa qaalay polettana koshshees. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Izikka nuuppe issaade mala taybettidi hayssa ha oosozan gelanaas qaada demmides» gides.<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />Gidikkoka hayssaadey ba iita ooson demmida miishshan gade shammides; heenkka ba liiphen gufanni kundiin iza asateththay giddofe phalqetti wodhdhides; iza maracey biitta bolla zaazettides.<note caller="-" style="x"><char style="xo" closed="false">1:18-19 </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">Mato 27:3-8</ref></char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Hessika Yerusalaamen diza asaa ubbaas siyettides; biittayka istta qaalara, «Akeldaama» geetettides; hessas birsheththayka suuththa biitta guussa.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Gujjidikka Phexroosi,</para>
  <para style="q1" vid="ACT 1:20">«Yeththa maxaafan,</para>
  <para style="q1" vid="ACT 1:20">‹Iza gadey mela atto;</para>
  <para style="q2" vid="ACT 1:20">izan ay asikka dooppo;</para>
  <para style="q2" vid="ACT 1:20">qasseka iza daannateth</para>
  <para style="q2" vid="ACT 1:20">hara asi ekko›</para>
  <para style="q2" vid="ACT 1:20">geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">Maza 69:25</ref>; <ref loc="PSA 109:8">109:8</ref></char></note><verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />«Hessa gishshas Godaa Yesusi nunara diza wode ubbaan nunara issife dizayta giddofe nu issaade dooranaas koshshees. <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />Hessika Yohannisa xinqatappe haa simmiin Yesusi nuuppe shaaketti dendi baana gakkanaas nunara dizaade gidanaas bessees; gaasoykka ha asatappe issaadey nunara Yesusa denththaas markka gidana koshshees» gides.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">Mato 3:16</ref>; <ref loc="MRK 1:9">Mar 1:9</ref>; <ref loc="MRK 16:19">16:19</ref>; <ref loc="LUK 3:21">Luqa 3:21</ref>; <ref loc="LUK 24:51">24:51</ref></char></note><verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Hessa gishshas Barsabaasa woykko Yosxoosa geetettiza Yooseefenne Maatiyaasa nam7ata shiishshidi, <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />«Godoo! Neni asa ubbaa wozina eraasa; hayta nam7ata giddofe ne oona dooridaakko izaade nuna bessa. <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />Yuhuday yeggi bidason ha oosaa ooththanaadenne Hawaare gidanaade ne doora» gi woossida. <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Hessafe saama yeggiin saamay Maatiyaasas kezides; izikka tammanne issi Hawaaretara issife taybettides.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">Ammaniza Asaa Bolla Xillo Ayana Wodheth</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Phenxeqoste geetettiza ba7aale gallassi gakkida wode asay wurikka issi soon shiiqi dishin, <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />qofay baynda daro mino gote carko mala giirissi yides; asay diza keeththaaka kumides. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Tama laco misatiza qaalay asaas beettidi shaaketti shaaketti issaa issaa bolla uttides. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Ammanizayti wuri Xillo Ayanan kumidi Ayanay isttas haasayanaas immidayssa keena hara qaalara haasaya oykkida.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />He wode salo gufanththon diza dereppe yida Xoossas babbiza Ayhudati Yerusalaamen deettes. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />He giirissaa siyidi derey shiiqides; issoy issoy ba qaalara haasayzayssa siyidi malalettida. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Malalettidi gaanaazi dhayiin, «Hayti haasayzayti wurikka Galila as deettennee? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Histtiin nuni nu yelettida nu dere qaalara istti haasayshin wostti siyizonii? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Nuni Phartaane asay, Meede asay, Eelaame asay, Mesphexoomiyan, Yuhudan, Qophodooqiyan, Phanxoosan, Iisiyan, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Pirgiyan, Phinfiliyan, Gibxen, Qareena achchan diza Liibiyappenne Oroomeppe yidayti <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ayhudatinne gede Ayhudateththan gelida Qarxeese asaanne Arabe asata gidishin wolqqama ooso Xoossayssa hayti nu qaalara haasayshin nu siyoos» gida.<verse eid="ACT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12" />Wurikka keehi malalettidinne gaanaazi dhayiin ba giddon, «Hayssi aazeeshaa?» geetettida. <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Bagga asay, «Hayti daro woyne cajje uyida» giidi istta qidhida.<verse eid="ACT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />He wode Phexroosi tammanne issinetara eqqidi ba qaala dhoqqu histtidi deraas, «Intteno Yuhuda asatoo! Yerusalaamen dizaytoo! Intte wurikka hayssa issi miish eritenne ta gizayssa siyite. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Ha7i gadey wontiin buro heedzdzu saate gidida gishshas intte qoppiza mala hayti asati maththottibeettenna. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Gido attiin hayssi kase nabe Iyu7eelen hizgi yootettida qaalay polettanaassa,<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />« ‹Xoossi Wurseththa gallas</para>
  <para style="q2" vid="ACT 2:17">ta Ayana</para>
  <para style="q2" vid="ACT 2:17">asho may7ida ubbaa bolla</para>
  <para style="q2" vid="ACT 2:17">tani gussana;</para>
  <para style="q2" vid="ACT 2:17">intte macca naytinne</para>
  <para style="q2" vid="ACT 2:17">intte attuma nayti</para>
  <para style="q2" vid="ACT 2:17">tinbite haasayana;</para>
  <para style="q2" vid="ACT 2:17">yelaga nayti ajjuuta beyana;</para>
  <para style="q2" vid="ACT 2:17">cimati agumo agumettana.<note caller="-" style="x"><char style="xo" closed="false">2:17-21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">Iyu 2:28-32</ref></char></note><verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />He wode ta macca</para>
  <para style="q2" vid="ACT 2:18">ashkarata bollanne</para>
  <para style="q2" vid="ACT 2:18">ta attuma ashkarata bolla</para>
  <para style="q2" vid="ACT 2:18">ta Ayanappe ta gussana.</para>
  <para style="q2" vid="ACT 2:18">Isttika tinbite haasayana.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Bolla Salon malalisiza hanota</para>
  <para style="q2" vid="ACT 2:19">ta bessana,</para>
  <para style="q2" vid="ACT 2:19">garsa sa7an malaatata ta bessana;</para>
  <para style="q2" vid="ACT 2:19">suuththi, tamaynne</para>
  <para style="q2" vid="ACT 2:19">tulalay hanana.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Gitanne bonchcho gidida</para>
  <para style="q2" vid="ACT 2:20">Godaa gallassi</para>
  <para style="q2" vid="ACT 2:20">yaanaappe kasetidi</para>
  <para style="q2" vid="ACT 2:20">arshey dhumana;</para>
  <para style="q2" vid="ACT 2:20">aginaykka suuth misatana.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Godaa sunth xeygizay</para>
  <para style="q2" vid="ACT 2:21">wuri attana› gides.<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />«Isra7eele naytoo! Hayssa qaala siyite; intte intte baggara erizayssa mala intte giddon malatanne asi siyi erontta miishshata iza kushen ooththidi Xoossi Naazirete Yesusas markkattides. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Xoossi kase ba qachchidayssa izas beni erateththaa mala hayssaade intte kushen aaththi immides. Intteka iita asata kushen kaqetti hayqqana mala ooththideta.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mato 27:35</ref>; <ref loc="MRK 15:24">Mar 15:24</ref>; <ref loc="LUK 23:33">Luqa 23:33</ref>; <ref loc="JHN 19:18">Yoha 19:18</ref></char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Gido attiin Xoossi iza bollafe hayqo wolqqa diggidi hayqoppe denththides; hayqoykka iza oykki ashshanaas dandaybeenna.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">Mato 28:5-6</ref>; <ref loc="MRK 16:6">Mar 16:6</ref>; <ref loc="LUK 24:5">Luqa 24:5</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Dawitikka iza gishshas,</para>
  <para style="q1" vid="ACT 2:25">« ‹Tani Godaa ubba wode</para>
  <para style="q2" vid="ACT 2:25">ta sinththan beyays;</para>
  <para style="q2" vid="ACT 2:25">izi ta ushachchan dees;</para>
  <para style="q2" vid="ACT 2:25">mulekka hirgike.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Hessa gishshas ta wozinay ufayettees;</para>
  <para style="q2" vid="ACT 2:26">ta doonaykka galatees;</para>
  <para style="q2" vid="ACT 2:26">ta ashoy ufayssan daana.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Ne ta shemppoyo duufon aggaka;</para>
  <para style="q2" vid="ACT 2:27">ne naa geeshshaza</para>
  <para style="q2" vid="ACT 2:27">wooqqana mala aggaagakka.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Ne de7o oge</para>
  <para style="q2" vid="ACT 2:28">ta erana mala ooththadasa.</para>
  <para style="q2" vid="ACT 2:28">Ne tanara diza gishshas</para>
  <para style="q2" vid="ACT 2:28">ta ufayssay kumeththa.›<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />«Ta ishatoo! Beni aawatappe Dawiti hayqqi moogettidayssanne iza duufoy hach gakkanaas nu achchan dizayssa babbontta ta inttes yootana dandayays. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Izi nabe gidida gishshas Xoossi iza zereththafe issaade iza kawoteththa alga bolla woththanayssa kase caaqo qaalaan yootidayssa erides.<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">Maza 132:11</ref>; <ref loc="2SA 7:12-13">2Same 7:12-13</ref></char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Hessa kasetidi erida gishshassinne iza ashoy wooqqi duufon attontta doorettida Kirstoosa denththa gishshas haasaydes. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />He Yesusa Xoossi hayqoppe denththides; nunikka wuri hayssas markkatta. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Hessa gishshas izi Xoossa ushachchan dhoqqu dhoqqu gidaappe guye Xillo Ayana ufayssaa ba aawappe ekkidi ha7i intte be7izayssanne siyizayssa duge gussides. <verse eid="ACT 2:33" /><verse number="34-35" style="v" sid="ACT 2:34-35" />Dawiti pude salo kezibeenna; izi ba doonan,</para>
  <para style="q1" vid="ACT 2:34-35">«Goday ta Godaas,</para>
  <para style="q2" vid="ACT 2:34-35">‹Ta ne morkketa ne toho garsan</para>
  <para style="q2" vid="ACT 2:34-35">yedhisana gakkanaas</para>
  <para style="q2" vid="ACT 2:34-35">ta ushachchan utta› gides.<note caller="-" style="x"><char style="xo" closed="false">2:34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maza 110:1</ref></char></note><verse eid="ACT 2:34-35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />«Hessa gishshas Xoossi intte kaqqida Yesusa Godaanne Kirstoosa histtidayssa Isra7eele asay wuri lo7eththi ero» gides.<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Derey hessa siyida mala wozinay boshettides; Phexroosanne hankko Yesusi kiittidayta, «Histtiin nu ishatoo! Nu ay ooththinoo?» gida.<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Phexroosikka, «Maaroteththan gelite; intte nagaray maarettana mala inttefe issi issi asi Yesus Kirstoosa sunththan xammaqettite; izi immiza Xillo Ayana intte ekkana. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Ufayssa qaalay inttessinne intte naytassa; qasseka Godaa Xoossi baakko xeygiza haahon dizaytassara ubbaassa» gides.<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Hara daro qaalara isttas markkattishe, «Hayssa geella yeletaappe inttena ashshite» giidi istta qofsides. <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />He gallas qaalaa ekkidaytinne xammaqettidayti heedzdzu shii mala asay kaseyta bolla gujettides. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Isttika Hawaareta timirten, issife quma muussaninne woosan minnida.<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Hawaareta kushen daro malaatati oosettida gishshas asi ubbay isttas babbides. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Ammanidayti wurikka issife de7ida; baas dizaazikka ubbaa issi bolla go7ettida.<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">Hawa 4:32-35</ref></char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Baas diza miishshenne mehe bayzi bayzi ba giddon koshshida mala gishechchida. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Gallas gallas Xoossa Keeththan issife shiiqeettes; ba keeththankka quma issife ufayssaninne suure wozinan issifeteththan meettes. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Istti Xoossaa galatishe dere sinththan bonchchettida. Godaykka istta bolla gallas gallas oorath ammanizayta gujjides.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">Phexroosi Paththida Toho Sila Addeza</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Issi wode gallassafe uddufun saate bolla Phexroosinne Yohannisi woosa saaten Xoossa Keeththe baana kezida. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Issi yelettoosoppe doommidi tohoy silidaade Xoossa Keeththe geliza asappe miishshe woossana mala asay gallas gallas tookki efidi woththiin, «Lo7o» geetettiza Xoossa Keeththa pengen woossizaadey dees.<verse eid="ACT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 3:3" />Izikka Phexroosinne Yohannisi Xoossa Keeththe gelishin be7idi isttafe miishshe woossides. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Phexroosinne Yohannisi iza tishshi histti xeellida. Phexroosikka iza, «Ane haa nuna xeella» gides. <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Addezikka isttafe aykko demmana giidi istta tishshi histti xeellides. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Gido attiin Phexroosi izas zaaridi, «Taas biraynne worqqay deenna; gidikkoka taas dizaaz ta nees immays; Naazirete Yesus Kirstoosa sunththan dendada ne tohora hemetta» gides. <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Izas ushachcha kushe oykkidi denththides. Heerakka addeza tohoynne toho qirphey minnides. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Guppi dendi eqqidi hemeth oykkides. Yaanne haa hemettishenne guppishe Xoossaka galatishe isttara issife Xoossa Keeththa gibbe gelides. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Izi Xoossa galatishe yaanne haa simerettishin asay be7ides. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Hayssaadey hayssafe kase, «Lo7o» geetettiza Xoossa Keeththa pengen uttidi miishshe woossizay iza gididayssa erides. Iza bolla hanidayssafe dendidayssan asay keehi malalettides.<verse eid="ACT 3:10" /></para>
  <para style="s1">Phexroosa Haasaya</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Ha paxida woosanchchay Phexroosakkonne Yohannisakko shiphphi giidi isttara oyketti dishin derey wuri malalettidi isttako, «Solomoone simereteththaso» geetettizaso woththan yides. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Phexroosi he asaa be7idi, «Intteno Isra7eele deretoo! Hayssan aazas malaletteetii? Qasseka hayssa addeza nuni nu wolqqan woykko nuni nu xilloteththan paththidi hemettissida mala qoodidi nuna aazas tishshi histti xeelleetii? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Nu aawantta Abrahaamentta, Yisaaqantta, Yaaqoobentta Xoossi ba naaza Yesusa bonchchides. Intte qasse iza hayqos aaththi immideta; Philaxoosi iza birshana koyiinkka intte, ‹Koyokko› gideta.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">Kessa 3:15</ref></char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Geeshshanne xilloza intte kaddidi shempo wodhizayssi birshettana mala woossideta.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">Mato 27:15-23</ref>; <ref loc="MRK 15:6-14">Mar 15:6-14</ref>; <ref loc="LUK 23:13-23">Luqa 23:13-23</ref>; <ref loc="JHN 19:12-15">Yoha 19:12-15</ref></char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />De7o immizaade intte wodhideta; gido attiin Xoossi iza hayqoppe denththides; hessas nuni markka. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Hayssi intte be7izayssinne intte erizayssi minni eqqiday Yesusa sunththan ammanida gishshassa; intte wurikka be7iza mala izi kumeththa paxateth demmiday Yesusa sunththaninne iza sunththan beettiza ammanonna.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />«Ha7ikka ta ishatoo! Intte hessa ooththiday intte halaqata mala erontta gididayssa ta erays. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Gidikkoka Kirstoosi waaye ekkanayssa Xoossi kase nabeta doonan haasaydayssa polides. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Hessa gishshas intte nagaray qucetti dhayana mala maaroteththan gelite; intte biza ogeppe simmite; Godaa matappe intte ooraxana wodey inttes yaana. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Qasseka Xoossi kase inttes doori woththida Yesus Kirstoosa izi inttes yeddana. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Xoossi kase geeshsha nabeta doonan haasaydayssa mala hanizayssa ubbaa ooraxissana wodey gakkanaas izi salon gam7anaas koshshees. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Museykka, ‹Intte Godaa Xoossay intte giddofe ta mala nabe inttes denththana. Izi inttes yootizayssa siyite.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">Zaare 18:15</ref>,<ref loc="DEU 18:18">18</ref></char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />He nabeza siyontta ixxida shemppoy wuri dere giddofe shaaketti dhayo.›<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />«Tumappe Sameelappe haa simmiin dendida nabeti wuri hayta wodeta gishshas haasayda. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Intteka nabeta nayta; qasseka Xoossi Abrahaames, ‹Ne zereththan biitta bolla diza asi wuri anjjettana› giidi izi caaqqida caaqoza intte laattana.<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">Medhe 22:18</ref></char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Xoossi naaza denththida wode inttena issaa issaa intte iitateththaafe zaaridi anjjana mala kasetidi intteko kiittides» gides.<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">Phexroosinne Yohannisi Ayhuda Duulataso Shiiqo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Phexroosinne Yohannisi asaas haasayan dishin qeeseta<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fqa" closed="false">Qeeseta: </char><char style="ft" closed="false">Qeeseta issi issi Geeshsha Maxaafati qeeseta halaqa geettes.</char></note> Halaqatinne Xoossa Keeththaa naagizayta halaqay qasseka Saduqaaweti isttako yida. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Histtidi Hawaareti asaa tamaarsizayssassinne Yesusa baggara beettida hayqqidayta denththaa gishshas sabbakizayssas keehi hanqettida. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Phexroosanne Yohannisa gadey qammishin oykkidi wonttana gakkanaas qasho keeththan ayssida. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Gido attiin qaalaa siyida asaappe dariza baggay ammanides; ammanida attuma asaa qooday gede ichchashu shii gakkanaas dhoqqu gides.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Wonteththa gallas istta halaqatinne cimati qasseka Muse wogaa tamaarsizayti Yerusalaamen shiiqida. <figure style="fig" alt="Part of the Sanhedrin council in session" file="LB00284B.TIF" size="span" ref="4:5">Ayhuda halaqata, cimatanne woga tamaarsizayta duulata</figure> <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Istta qeeseta halaqa Haannaynne Qayafay, Yohannisi, Iskindiroosinne qeeseta halaqaso asay wuri heen beettida. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Isttika Phexroosanne Yohannisa ba giddon aaththi essidi, «Hayssa intte ooththizay aaza wolqqanee? Woykko oona sunththanee?» giidi oychchida.<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />He wode Phexroosi Xillo Ayanan kumidi, «Intteno dere halaqatoo! Dere cimatoo! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Intte hach ha toho sila addezas oosettida lo7o oosoy waani izi paxidaakko intte nuna oychchizaa gidikko, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />intte kaqqiin Xoossi hayqoppe denththida Naazirete Yesus Kirstoosa sunththan izi paxidayssanne intte sinththan izi eqqidayssa intteka Isra7eele dere asay wuri hayssa erite. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Izikka intte keeththa hiillati leqqi aggida shuchchay gimbe keeththas gula<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="fqa" closed="false">Gula: </char><char style="ft" closed="false">Gula gizayssa issi issi bagga gamoththo qaalan magala woykko yochcha shuch geettes.</char></note> bolla bollara woththiza shuch gidides.<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Maza 118:22</ref></char></note> <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Atoteththi hara oonankka baa; saloppe garsa baggara nu asa nayti attana mala nuus imettiday hayssafe hara sunththi deenna» gides.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Ayhudata duulata asaykka Phexroosinne Yohannisi hessaththo xali haasayzayssa be7idi istti tamaarontta as gididayssa eridi malalettidanne istti kase Yesusara dizayta gididayssa akeekida. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />He paxida addezi isttara eqqi dishin be7ida gishshas isttas hara ooththanaas gaasoykka dhaydes. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Hessa gishshas istta duulataappe kessana mala azazida. Hessafe qasseka shiiqettidi ba giddon zorettida. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Ba giddon, «Hayta asata wosttinoo? Yerusalaamen diza asay wuri istta kushen hanida gita malaataa erides. Hessa gishshas nu ha yo7oza asaa baleththanaas dandayokko. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Gido attiin hayssi yo7ozi dere giddon keehi aakkontta malanne hayti asati nam7anththo hayssa ha sunththaan hara oonaska yootontta mala isttas lo7eththi yootana» gida.<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Istta xeygidinne mulekka Yesusa sunththan haasayontta malanne tamaarsontta mala azazida. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Phexroosinne Yohannisi qasse zaaridi, «Nuni Xoossafe bollara inttes azazettanaas bessizaakko ane intte Xoossa sinththan pirdite. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Nuni nu be7idayssanne nu siyidayssa haasayanaappe guye gookko» gida.<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />Qasseka istta bolla mandidi yeddida; gaasoykka hankko derey wuri hanida yo7oza gaason wurikka Xoos galatiza gishshas istta qaxxayanaas dandaybeettenna. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />He gita malaataan paxida addezas layththay oyddu tammaafe bolla.<verse eid="ACT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Phexroosinne Yohannisi qashoppe birshettidi ba asataakko simmidi qeeseta Halaqatinne Dere cimati istta gidayssa ubbaaka yootida. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Isttika hessa siyida mala ba qaala dhoqqu histtidi issife Xoossaako, «Wogga Godawu! Neni salonne sa7a, abbanne abba giddon dizayta wursa medhdhadasa.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref>; <ref loc="NEH 9:6">Nahi 9:6</ref>; <ref loc="PSA 146:6">Maza 146:6</ref></char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Ne ashkaraa nu aawaa Dawite doonara Xillo Ayanan,</para>
  <para style="q1" vid="ACT 4:25">« ‹Kawoteththay aazas</para>
  <para style="q2" vid="ACT 4:25">hanqetti dendidee?</para>
  <para style="q2" vid="ACT 4:25">Derey aazas mela maqettizee?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Biitta kawoti issife gaaggidi</para>
  <para style="q2" vid="ACT 4:26">biitta haarizayti</para>
  <para style="q2" vid="ACT 4:26">issi bolla shiiqettidi</para>
  <para style="q2" vid="ACT 4:26">Godaa bollanne dooretti</para>
  <para style="q2" vid="ACT 4:26">tiyettidayssa bolla duulatida›</para>
  <para style="q2" vid="ACT 4:26">gi waassida.<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />«Tumappe Herdoosinne Phanxoosa Philaxoosi Isra7eeletaranne hara dere asaara hanno katamayn ne doora tiyda geeshsha naaza Yesusa bolla yo7o qachchanaas shiiqettida.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="LUK 23:1">Luqa 23:1</ref>,<ref loc="LUK 23:7-11">7-11</ref>; <ref loc="MAT 27:1-2">Mato 27:1-2</ref>; <ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="JHN 18:28-29">Yoha 18:28-29</ref></char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Hayssanka ne wolqqaninne ne shenen kase ne qoppidayssa istti polida. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Godoo! Ha7ikka istta mandeza ne beya; nuni ne aylleti ne qaala babbontta kumeththa xalateththara yootana mala dandayssa. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Paththanaas ne kushe micca. Ne naa geeshshaza sunththan gita malaata ooththa» gida.<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Istti woossidaappe guye istti dizasoy qaaxxides; wurikka Xillo Ayanan kumidi Xoossa qaala xalateththan yootida.<verse eid="ACT 4:31" /></para>
  <para style="s1">Ammanizayta Issifeteththa Duus</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ammanizayti wurikka issi wozinaninne issi qofan gaaggi deettes. Isttas dizay wuri issi bolla dees attiin baas dizaaz, «Hayssi taas buzo miishsha» gizaadey deenna.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">Hawa 2:44-45</ref></char></note> <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Hawaaretikka Godaa Yesusa denththaa gita wolqqan markkateth oykkida; ubbaa bolla gita Xoossa kiyateththi dees. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Istta giddon metotanchchay issaadeyka deenna; gaasoykka gade gidiin, keeththe gidiin baas dizaa ubbaa bayzi bayzi shiishshida miish, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Hawaareta kushen woththidi issaades issaades izas koshshiza mala gisheettes.<figure style="fig" alt="Money of Juwish and Romans" file="HK00163B.TIF" size="span" ref="4:35">Ayhudata miishshinne Oroometa miish</figure><verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Qophiroose geetettizason diza Yooseefe geetettizaadey issi Lewe bagga asi dees; izikka Hawaaretan, «Barnabaasa» geetetti summides. Hessas birsheththay, «Minththeththo naa» guussa. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Izikka ba gade bayzida miishshaa ehidi Hawaareta kushen woththides.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">Hanaaniyanne Saphphira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Issi Hanaaniya geetettiza asi Saphphira geetettiza ba machcheyra ba gade bayzides. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Machcheya Saphphiray lo7eththa erishin gadeza bayzida miishshaafe baggaa shaakki ashshidi baggaa ehidi Hawaareta kushen immides. <verse eid="ACT 5:2" /><verse number="3-4" style="v" sid="ACT 5:3-4" />Qasse Phexroosi, «Haysso Hanaaniya! Neni Xillo Ayana bolla wordotanaassinne gadeza miishshaafe ashshana mala Xala7ey ays ne wozinan gelidee? Bayzanaappe kase gadezi neyssa gidennee? Ne bayzidaappe guye qasse miishshay ne kushen deennee? Histtiin ne hayssa mala wostta ne wozinan qoppadii? Neni Xoossa bolla wordotadasa attiin asa bolla gidenna» gides.<verse eid="ACT 5:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Hessa siyida mala Hanaaniyay kundi hayqqides; hessa siyida asay wuri daro babbides.<verse eid="ACT 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 5:6" />Attumasay dendidi ahaa xaaxidi heerakka efidi moogides.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Heedzdzu saateppe guye machcheya izi waanidaakko erontta dashe yadus. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Phexroosikka, «Ane taas yoota; intte gadeza bayzida waagay hanno xallaa?» gides. Izakka, «Ee hanno ha waagayn bayzidos» gadus.<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Phexroosikka, «Intte Xoossa Ayana paaccanaas ays issi doona gididetii? Hekko ne azinaa moogida asati moogi simmidi karen penge bolla deettes. Istti nenakka kessi ekki efana» gides. <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Iza siyida mala heerakka iza toho bolla kundada hayqqadus. Attumasaykka soo gelida mala hayqqidaaro be7idi kessi efidi izi azinaa achchan izo moogida. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Kumeththa Woosa Keeththa asaynne hessa siyida asay wuri daro babbides.<verse eid="ACT 5:11" /></para>
  <para style="s1">Hawaareta Kushen Paxida Daro Asaa</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Hawaaretikka dere giddon daro malaatatanne malalisiza miish ooththida; ammanizayti wuri, «Solomoone simereteththaso» geetettiza pengen shiiqeettes. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Isttas babbida gishshas oonikka isttara walakettanaas koyibeenna; gido attiin derey istta keehi bonchchees. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Daro maccassatinne addeti wodeppe woden Godaan ammani ammani istta bolla gujettida. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Hessa gaason Phexroosi aadhdhishin haray attiin iza eeshoy harganchchatappe bagga harganchchata bolla wodhdhana mala hargizayti ichchiza alga bollanne hala bolla karen ishiseettes. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Yerusalaame yuushon diza katamatappe hargizaytanne tuna ayanay waayisizayta ehiin wuri paxida.<verse eid="ACT 5:16" /></para>
  <para style="s1">Hawaareta Bolla Gakkida Goodeteththinne Waaye</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />He wode qeeseta halaqaynne izara diza Saduqaaweta baggayti wurikka qanaate qanaatizayta xalla gidida. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Hawaareta oykkidi qasho keeththe gelththida. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Gido attiin Godaa kiitanchchay qammara qasho keeththaza kare doydi istta kessidi, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«Biidi Xoossa Keeththaa gibbe giddon eqqidi hayssa de7o qaalaa ubba deraas yootite» gides.<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />Gadey wontida mala isttas yootidayssa Xoossa Keeththaa gibbe gelidi dereza tamaarso oykkida; qeeseta halaqaynne izara dizayti yiidi Ayhudata duulataanne Isra7eele dere cimata kumeth issi bolla shiishshida; Hawaareta qasho keeththafe ekki yaana mala as yeddida. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Kiitetti bida asati biidi istta qasho keeththan demmibeettenna; simmidi, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />«Qasho keeththay lo7i qulpeti dees; naagizaytikka penge bolla eqqi dishin nu be7idos; gido attiin nu doyi gelishin keeththan oonikka baa» gida. <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Xoossa Keeth naagizayta halaqaynne qeeseta halaqatikka hessa siyida mala hanozan daro malalettidanne isttas hanoy wuri tikki gides. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Heerakka issi asi yiidi, «Hekko intte qasho keeththe gelththida asati Xoossa Keeththa gibbe giddon eqqidi dere tamaarson deettes» gides. <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Xoossa Keeththe naagizayta halaqay ba oosanchchatara biidi istta oykki ekki yides; oykki ehidayti asay bana shuchchara caddontta mala babbidi wolqqaththontta loddara ehida.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27-28" style="v" sid="ACT 5:27-28" />Hawaareta ehidi Ayhudata duulata sinththan essida; qeeseta halaqaykka istta, «Hayssa ha sunththaan intte tamaarsontta mala inttes lo7eththi yootidoskoshin intte intte timirteza Yerusalaame ubbaan kunththeeta; qasse nunakka ha addeza suuththas oyshettizayta histtanaas gixxi dendideta» gides.<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">Mato 27:25</ref></char></note><verse eid="ACT 5:27-28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Phexroosinne hankko hawaaretikka zaaridi, «Nuni asappe aaththidi Xoossas azazettanaas bessees.<verse eid="ACT 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 5:30" />«Intte iza miththa bolla kaqqi wodhida Yesusa nu aawantta Xoossay iza hayqoppe denththides. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Izikka Isra7eele naytas nagarappe simmidi maarettana mala Xoossi iza ubbaafe bollanne ashshizaade histtidi ba ushachchan dhoqqu dhoqqu histtides. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Nunikka hayssas markkatta; qasseka Xoossi baas azazettiza oonaska immida Xillo Ayanaykka markka» gida.<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Asati hessa siyidi iita hanqo hanqettida; wodhanakka koyida. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Gido attiin dere achchan keehi bonchchettida issi woga astamaare, izikka Gamalyaale geetettiza Farsaaweta baggay dere cimata giddon dendi eqqidi Hawaareti guuththa wode karen gam7ana mala azazides. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Dere cimatas, «Isra7eele asatoo! Intte hayta asata bolla ooththanayssa daro akeekara ooththanaas bessees. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Hayssafe kase issi Tewodaasa geetettizaadey bana gita as histti qoodi dendiin oyddu xeetu derey iza kaallides; gido attiin izi asa kushen hayqqides; iza kaallizaytikka coo laalettiin iza hanoy coo mela attides. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Izappe guyekka derey taybettiza wode Galila Yuhuday dendidi daro dere banara kaaleththides. Bana kaallizaytakka demmides; gido attiin izikka dhaydes; iza kaallizaytikka wuri dhayda.<verse eid="ACT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 5:38" />«Hessa gishshas ta ha7i inttena gizay hayta asata aggite, bochchofte; istta qofay woykko istta oosoy asappe gidikko dhayana. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Xoossafe gidikko qasse intte istta teqqanaas dandayekketa; oonee erizay intte Xoossara ooyettishe beettanakko» gides.<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Isttika iza zoreza ekkidi Hawaareta xeygidi garafissida; nam7anththo Yesusa sunththan haasayontta mala azazidi yeddida. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Hawaaretikka iza sunththa gishshas kawuyanaas bessiza gishshas daro ufayettishe dere cimata achchafe kezi bida. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Gallas gallas Xoossa Keeththaninne issaa issaa keeththan Yesusi izi Xoossi dooridaade gididayssa tamaarsofenne sabbakoppe mulekka guye gibeettenna.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s1">Laappun Daaqoneta Dooreteth</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Ammanizayta qooday dari dari biza wode Girike biittafe yida Ayhuda asati Yuhudan diza Ayhuda asaa guyera zigirettida; gaasoykka ubba wode miza kath gishashe am7eta wudettontta aggida gishshassa. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Hessa gishshas nu tammanne nam7u Hawaareti ammaniza harata issi bolla shiishshidi, «Nuni kaththa gishason gelidi Xoossa qaalaa tamaarso agganaas bessenna. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Hessa gishshas nu ishatoo! Intte giddofe eranchchata, Xillo Ayanan kumidaytanne lo7o markkateththi diza laappun asata doorite; hayssa alaafeteth nu isttas immana. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Nuni gidikko woosaninne qaalaa yooton minnana» gida.<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Istti gida yo7oy siyidayta ufayssides; Ammanoninne Xillo Ayanan kumidayti Isttifaanose, Piliphoosa, Phirosqoroosa, Niqaroona, Ximoona, Pharmenanne Yuhudateththan gelida Anxokiya dere as Niqoloosa doorida. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Heyta ehidi Hawaareta sinth shiishshida. Isttika ba kushe istta bolla woththidi isttas woossida.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Xoossa qaalay aakki aakki bides; ammanizayta qooday Yerusalaamen dari dari bides; qeesetappe daroti ammanida.<verse eid="ACT 6:7" /></para>
  <para style="s1">Isttifaanose Oyketeth</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />He wode Isttifaanosi Xoossa imoteththaninne wolqqan kumidi dereza giddon gita malalisiza malaatata ooththides. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />«Wozzetti kezida» geetetti xeygettizasoppe Ayhudata Woosa Keeththafe yida as gidida Qareenappenne Iskindiriyappe; qasseka Kilqiyappenne Iisiya awuraajjatappe yida asatikka wuri Isttifaanosera marshettida. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Gido attiin erateththan izi haasayza haasayanne izan diza Ayanaa eqettanaas dandaybeettenna. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Hessa gishshas, «Isttifaanosi Musenne Xoos cayishin nu siyidos» giza asata guyera giigsida.<verse eid="ACT 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12" />He wode dereza, dere cimatanne wogaa tamaarsizayta, denththeththidi Isttifaanose oyththidi dere duulataakko shiishshida. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Iza bolla «Hayssi addezi hayssa Xoossa Keeththaa bollanne wogaa bolla cashsha qaala haasaya mulekka aggibeenna. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Gaasoykka hayssi addezi, ‹Naazirete Yesusi hayssa Xoossa Keeththaa dhayssana› gishininne ‹Nu Museppe ekkida wogaa laammana› gi haasayshin nu siyidos» gi wordora markkattiza asata shiishshidi markkasida.<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />Duulata uttida asay wuri Isttifaanose tishshi histti xeellishin iza ayfesoy isttas kiitanchcha ayfeso misati beettides.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Qeeseta halaqay Isttifaanose, «Hayssi ne bolla shiiqida yo7ozi tumee?» gi oychchides.<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Isttifaanosikka, «Ta ishatoo! Ta aawatoo! Ta gizayssa siyite! Nu aawa Abrahaamey Kaaraane geetettizaso yaanaappe kase buro Mesphexoomiyan dishin bonchcho Goday izas qonccidi, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />‹Ne dereppenne ne dabbofe shaakettada ta nena bessizaso ba› gides. <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Izikka Kaladaaweta biittafe kezidi Kaaraane geetettiza biittan uttides. Iza aaway hayqqidaappe guye intte ha7i dizaso ha dere iza ehides.<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">Medhe 11:31</ref>; <ref loc="GEN 12:4">12:4</ref></char></note> <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Haray attoshin issi tohoy eqqiza gadey izas hayssafe imettibeenna; gido attiin he wode izas issi naykka baynda dishin izinne izappe guyen iza zereththi biittayo laattana mala Xoossi izas caaqqides.<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Medhe 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 15:18">15:18</ref>; <ref loc="GEN 17:8">17:8</ref></char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Qasseka Xoossi izas, ‹Ne zereththi allaga biittan bete as gidana. Oyddu xeetu layth aylleteththa qambara giddon waayettana.<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">Medhe 15:13-14</ref></char></note> <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Gido attiin istta aylle mala haariza dere ta qaxxayana; hessafe guye istti he biittafe kezidi hanno ha sohoyin taas goynnana› gides.<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">Kessa 3:12</ref></char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Hessafe guye qaxxara woga caaqo izas immides; Abrahaameykka Yisaaqa yelidi iza osppunththa gallas qaxxarides; Yisaaqaykka Yaaqoobe yelides; Yaaqoobeykka tammanne nam7u qommota yelides.<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">Medhe 17:10-14</ref>; <ref loc="GEN 21:2-4">21:2-4</ref>; <ref loc="GEN 25:26">25:26</ref>; <ref loc="GEN 29:31-35:18">29:31—35:18</ref></char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />«He qommota aawati Yooseefe bolla qanaatidi iza aylleteththas duge Gibxe bayzida; gido attiin Xoossi izara dees.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">Medhe 37:11</ref>; <ref loc="GEN 37:28">37:28</ref>; <ref loc="GEN 39:2">39:2</ref>,<ref loc="GEN 39:21">21</ref></char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />Meto ubbaafe iza ashshides; Gibxe kawo Paaroone sinththan bonchcho immides; Paarooney iza Gibxe biittaninne ba keeththa asa ubbaa bolla alaafeteththan shuumides.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Medhe 41:39-41</ref></char></note><verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />«He wode Kanaaneninne Gibxen daro meto ehida gita koshay dendides. Nu aawataska miza kaththi dhaydes.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 42:1-2">Medhe 42:1-2</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Yaaqoobey Gibxe deren kaththi dizayssa siyidi nu aawata koyro Gibxe yeddides. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Istti nam7anththo biza wode Yooseefey izi oonakko bana ba ishatas qonccisides. Paarooneykka Yooseefe ishata erides.<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">Medhe 45:1</ref>; <ref loc="GEN 45:16">45:16</ref></char></note> <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Hessafe guye Yooseefey kiittidi ba aawa Yaaqoobenne laappun tammanne ichchashu gidiza ba dabbota kumeth ehisides.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">Medhe 45:9-10</ref>,<ref loc="GEN 45:17-18">17-18</ref>; <ref loc="GEN 46:27">46:27</ref></char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Yaaqoobey duge Gibxe wodhdhides. Izikka nu aawatikka wuri heen hayqqida.<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">Medhe 46:1-7</ref>; <ref loc="GEN 49:33">49:33</ref></char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Istta ahaykka Seekeeme geetettizaso efiin Abrahaamey Emoore naytappe ba miishshan shammida duufon moogettides.<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">Medhe 23:3-16</ref>; <ref loc="GEN 33:19">33:19</ref>; <ref loc="GEN 50:7-13">50:7-13</ref>; <ref loc="JOS 24:32">Iya 24:32</ref></char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />«Xoossi Abrahaames caaqqida qaalay polettiza wodey matishin Gibxen diza nu asaa qooday dari dari bides. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Hessafe guye Gibxe biittan Yooseefe erontta hara kawoy kawotides. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Izikka nu asaa ba gene ooson metoththides; buro yelettida guuththa nayti hayqqana malanne asay yelida nayta kare kessi wora yeggana mala wolqqaththides.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">Kessa 1:10-11</ref>; <ref loc="EXO 1:22">1:22</ref></char></note> <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />He wode Musey yelettides; izikka Xoossa achchan dosettida mala lo7o naa gidides; ba aawaa keeththan heedzdzu agina al7ison diccides.<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Kessa 2:2</ref></char></note> <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Izi wora yegettida wode kawo Paaroone macca naya demmada baas ekkadus; ba naa mala ooththada dichchadus.<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">Kessa 2:3-10</ref></char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Museykka Gibxeta aadho erateththaa ubbaa tamaardes; Yo7on era; oosonkka mino gidides.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />«Muse layththay oyddu tammu gidida wode Musey ba ishata Isra7eele nayta beyanaas ba wozinan qoppides.<note caller="-" style="x"><char style="xo" closed="false">7:23-29 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">Kessa 2:11-15</ref></char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Izikka issi Gibxe asi Muse bagga asaappe issaade bolla qoho gaththishin be7idi ba bagga addeza maaddides; Gibxe addeza wodhidi qohettidayssa halo kessides. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Muses Xoossi iza kushen istta wozzanayssa iza asay akeekizaa misatides; gido attiin istti hessa yuushshi qoppibeettenna. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Wonteththa gallas qasseka Isra7eele naytappe nam7ati ba giddon ooyettishin gakkidi ooyettizayta giigsanaas koyidi, ‹Hayto asatoo! Intte intte garsan issoy issaara ishantta; intte waanidi issoy issaa qoheetii?› gides.<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27-28" style="v" sid="ACT 7:27-28" />«Ba laggeza bolla qoho gaththidayssi Muse sugi yeggidi, ‹Nena nu bolla nuna haarizaadenne nu bolla pirdizaade ooththi shuumiday oonee? Woykko qamma Gibxe addeza wodhoyssaththo tanakka wodhana koyay?› gides. <verse eid="ACT 7:27-28" /><verse number="29" style="v" sid="ACT 7:29" />Musey hessa siyida mala Midiyaame biitta betidi heen bete as gidi de7ides; Yaankka nam7u attuma nayta yelides.<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">Kessa 18:3-4</ref></char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />«Hessafe oyddu tammu layththafe guye Siina zumaa achchan diza bazzo biittan qeeri wora giddon eexxiza tama lacon kiitanchchay izas beettides. <verse eid="ACT 7:30" /><verse number="31-32" style="v" sid="ACT 7:31-32" />Museykka iza be7ida mala malalettides; aazakko shaakki eranaas izi hee izakko shiiqishin Godaa qaalay, ‹Tani ne aawantta Xoossaa; Abrahaame, Yisaaqanne Yaaqoobe Xoossa› gishin siyides. Museykka daro dagammides; xeellanaaska xalibeenna.<verse eid="ACT 7:31-32" /></para>
  <para style="p">
    <verse number="33-34" style="v" sid="ACT 7:33-34" />«Godaykka izas, ‹Hayssi ne eqqidasoy geeshshasoho gidida gishshas ne tohoppe caamma shodda; Gibxen diza ta dereta waaye ta tumappe beyadis; istti waassiza waaye waasoza ta siyada istta ashshanaas wodhdhadis; ha7ikka ne haa ya; ta nena duge Gibxe zaarada kiittana› gides.<verse eid="ACT 7:33-34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />«Histtiin heyti, ‹Nu bolla nena haarizaadenne pirdizaade histti ooni shuumidee?› giidi asay kase kadhida Muse Xoossi qeeri wora giddon izas beettida kiitanchchaza baggara istta haarizaadenne ashshizaade histtidi isttako zaari yeddides. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Izikka istta kaaleththidi Gibxeppe kessides; Gibxen, Zo7o abbaninne bazzo biittan oyddu tammu layth daro malalisiza miishshatanne gita malaatata isttas ooththides.<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:3">Kessa 7:3</ref>; <ref loc="EXO 14:21">14:21</ref>; <ref loc="NUM 14:33">Tay 14:33</ref></char></note><verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />«Isra7eele naytas, ‹Ta mala nabe Xoossi intte giddofe denththana› gidayssi hayssa Musekko!<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15">Zaare 18:15</ref>,<ref loc="DEU 18:18">18</ref></char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Izikka Siina zuma bolla haasayda kiitanchcharanne bazzo biittan nu aawatara dere duulata giddon dees; de7o qaalakka haa nuus aaththanaas ekkides.<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-20:17">Kessa 19:1—20:17</ref>; <ref loc="DEU 5:1-33">Zaare 5:1-33</ref></char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />«Nu Aawati gidikko izara eqettida attiin izas azazettanaas koyontta gishshas ba wozinara guye Gibxe simmida. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Aarooneska, ‹Nu sinththara biza eeqa nuus giigsa! Nuna Gibxeppe kaaleththi kessida Musey waanidaakko nu erokko› gida.<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">Kessa 32:1</ref></char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />He wode mara misle medhdhidi eeqas yarsho shiishshida; barkka medhdhida ba kushe ooson ufayettidi guppida.<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">Kessa 32:2-6</ref></char></note><verse eid="ACT 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 7:42" />«Gido attiin Xoossi isttas zokko zaarides; istti salo xoolinttetas goynnana mala aaththi immides; hessika nabeta maxaafan,</para>
  <para style="q1" vid="ACT 7:42">« ‹Intteno Isra7eele naytoo!</para>
  <para style="q2" vid="ACT 7:42">Intte bazzo biittan oyddu tammu</para>
  <para style="q2" vid="ACT 7:42">layth diza wode</para>
  <para style="q2" vid="ACT 7:42">inttefe yarshonne muxuwaata</para>
  <para style="q2" vid="ACT 7:42">taas shiishshi ereetii?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Harappeka intte goynnanasoho</para>
  <para style="q2" vid="ACT 7:43">ooththida</para>
  <para style="q2" vid="ACT 7:43">eeqa Molooke dunkaananne</para>
  <para style="q2" vid="ACT 7:43">intte eeqa Erafaane geetettiza</para>
  <para style="q2" vid="ACT 7:43">xoolintte misleza</para>
  <para style="q2" vid="ACT 7:43">dhoqqu dhoqqu histti oykkideta.</para>
  <para style="q2" vid="ACT 7:43">Hessa gishshas ta inttena</para>
  <para style="q2" vid="ACT 7:43">intte dizasoppe denththada</para>
  <para style="q2" vid="ACT 7:43">Baabiloonera aaththa yeddana›</para>
  <para style="q2" vid="ACT 7:43">geetettidi xaafettides.<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />«Xoossi Muse bessida leemisoza malanne azazidayssa mala oosettida Xoossi asara gaaggiza dunkaaneya nu aawatara bazzo biittan de7adus.<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">Kessa 25:9</ref>,<ref loc="EXO 25:40">40</ref></char></note> <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Nu Aawati dunkaaneyo ekkidayssafe guye Xoossi Iyaaso kaaleththiin kase istta gooddida dereta laattida wode dunkaaneyo ekki gelida; Dawite wode gakkanaas dunkaaneya he biittan de7adus.<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">Iya 3:14-17</ref></char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Dawitikka Xoossa sinththan bonchcho demmidi Yaaqoobe Godaas aqoso giigsanaas woossides.<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2Same 7:1-16</ref>; <ref loc="1CH 17:1-14">1Taari 17:1-14</ref></char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Gido attiin Solomooney izas aqoso keexxides.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48-50" style="v" sid="ACT 7:48-50" />«Gido attiin wogga Goday asa kushey keexxida keeththan deenna; hessika nabey kase Geeshsha maxaafan xaafida mala,</para>
  <para style="q2" vid="ACT 7:48-50">« ‹Saloy ta uttiza alga;</para>
  <para style="q2" vid="ACT 7:48-50">biittayka tani tohon yedhdhizaso;</para>
  <para style="q2" vid="ACT 7:48-50">histtiin intte taas</para>
  <para style="q2" vid="ACT 7:48-50">ay mala keeththe keexxeetii?</para>
  <para style="q2" vid="ACT 7:48-50">Woykko ta shempanasoy</para>
  <para style="q2" vid="ACT 7:48-50">awayssee?<note caller="-" style="x"><char style="xo" closed="false">7:49-50 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">Isa 66:1-2</ref></char></note></para>
  <para style="q2" vid="ACT 7:48-50">Hayssa ubbaa ta kushey</para>
  <para style="q2" vid="ACT 7:48-50">ooththibeennee?›</para>
  <para style="m" vid="ACT 7:48-50">gees Godaa Xoossay.<verse eid="ACT 7:48-50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />«Intteno wozina muumetoo! Hayththa tulletoo! Intteka intte aawata mala ubba wode Xillo Ayanara eqetteeta.<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="ISA 63:10">Isa 63:10</ref></char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Nabetappe intte Aawati gooddontta nabey oonee? Xilloza Yohannisa kaseti yootida nabetakka wodhida; intteka ha7i iza aaththi immidetanne wodhideta. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Kiitanchcha baggara inttes imettida woga ekkideta attiin naagibeekketa» gides.<verse eid="ACT 7:53" /></para>
  <para style="s1">Shuchchan Cadetti Isttifaanose Hayqo</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Duulatan diza asay hessa siyida mala daro hanqettidi iza bolla ba achchi garccides. <verse eid="ACT 7:54" /><verse number="55-56" style="v" sid="ACT 7:55-56" />Gido attiin Isttifaanosi Xillo Ayanan kumidi pude salo tishshi histti xeellishin Xoossa bonchchon Yesusi Xoossa ushachchan eqqidayssa be7idi, «Hekko ta saloy doyettidayssanne Asa Nay Xoossa ushachchan eqqidayssa beyays» gides.<verse eid="ACT 7:55-56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />He wode asay qaala dhoqqu histti waassishe ba hayth tucci oykkidi izakko issife woxxides. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Isttifaanose oykkidi katamappe kare olida; shuchchan cach oykkida; hessi wuri hanishin markkatikka ba may7o Sa7oole geetettiza panththaza achchan woththida. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Istti shuchchara iza caddishin Isttifaanosi, «Ta Godaa Yesusaa! Ta shemppoyo neekko ekka» giidi woossides. <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Qasseka gulbatidi dhoqqa qaalan «Godoo! Haytantta nagara qoodoppa» giidi waassides; hessa gidaappe guye hayqqides.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sa7oolikka Isttifaanose hayqon isttara qofan gaaggides; he wode Yerusalaamen diza ammanizayta bolla wolqqama goodeteththi dendides. Hawaareti attaafe ammanizayti wuri Yuhuda awuraajjaninne Samaariya awuraajja ubbaan laalettida. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Ayana ooson minni eqqida asati Isttifaanose moogidi izas daro yeekkida. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Sa7ooli qasse Woosa Keeth dhayssanaas gixxi dendides; ammaniza asaa issaa issaa keeththe gelidi maccassatanne addeta goochchi goochchi kessidi qasho keeth gelththides.<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">Hawa 22:4-5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note><verse eid="ACT 8:3" /></para>
  <para style="s1">Piliphoosi Samaariya Deren Markkattida Mishiraachcho Qaala</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Laalettidayti wuri ba bidason bidason Xoossa qaala yootida. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Piliphoosikka Samaariya geetettiza katamaa wodhdhidi asaas Kirstoosa sabbakides. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Daro derey Piliphoosi ooththiza malaata be7idi izi yootiza qaalaa wozinappe lo7eththi siyides. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Tuna ayanatikka daro asappe waassi waassi kezida; daro toho silatinne wobbetikka paxida. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Hessa gishshas he katamaa asay daro ufayettides.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Gido attiin hessafe kase he katamayin maro marotidi Samaariya asaa daro malalisizaaz ooththiza issi Simoona geetettiza maroy dees; izikka bana gita asa mala qoodizaade. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Asay wuri guuththatappe gitata gakkanaas wurikka, «Hayssi addezi gita wolqqama geetettiza Xoossa wolqqa» gishe izi gizayssa wursi wozinappe siyees. <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Daro wode ba maroteththa ooson asaa malalisida gishshas asay iza wozinappe kaallishe gam7ides. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Gido attiin Piliphoosi Xoossa Kawoteththa gishshassinne Yesus Kirstoosa gishshas sabbakidayssa siyidi ammanida maccassaynne attumasay xammaqettides. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Simoonikka ammanidi xammaqettides; Piliphoosakka kaalli biidi haniza gita malaataa be7idi malalettides.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Yerusalaamen diza Hawaareti Samaariya asay Xoossa qaala ekkidi ammanidayssa siyidi Phexroosanne Yohannisa isttako kiittida. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Isttika Samaariya gakkidi ammanida asay Xillo Ayana ekkana mala asaas woossida. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Gaasoykka he wode istti coo Yesusa sunththan xammaqettida attiin buro Xillo Ayanay isttafe issaade bollaka wodhdhibeenna. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Hessa gishshas Phexroosinne Yohannisi ba kushe asaa bolla woththiin asay Xillo Ayana ekkides.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Simoonikka Hawaareti kushe woththi woossiin Xillo Ayanay imettizayssa be7idi Phexroosassinne Yohannisas miishshe ekki yiidi, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />«Ta iza bolla ta kushe woththizaadey wuri Xillo Ayana ekkana mala hayssa mala godateth taaska immite» giin,<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Phexroosi izas zaaridi, «Xoossa imota ne miishshan shammana qoppida gishshas neni ne miishshara issife dhaya. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Ne wozinay Xoossa sinththan suure gidontta gishshas nees hayssa ha oosozan gishay woykko qaaday deenna. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Hayssa ne iitateththaa gishshas ha7i elle maaroteththan gela; ne wozina qofaa nees atto gaanaakko nees Goda woossa. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Gaasoykka neni iitateththan kumidayssinne makkallan qashetta uttidayssi taas beettees» gides.<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Simoonikka zaaridi, «Intte gida yo7otappe aykkoyka ta bolla gakkontta mala taas Godaa woossite» gides.<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Phexroosinne Yohannisi Godaa qaala markkattidayssafenne qonccisi yootidayssafe guye daro Samaariya gutatan mishiraachcho qaalaa sabbakishe Yerusalaame simmida.<verse eid="ACT 8:25" /></para>
  <para style="s1">Piliphoosi Xammaqida Tophphiya Gundula Addeza</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Godaa kiitanchchay Piliphoosa «Denda! Yerusalaameppe duge baggara gede Gaaza efiza bazzo ogera ba» gides. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Izikka dendi bides; Hindeko geetettiza Tophphiyappe gidida kawoya ba keeththaninne ba kawoteththan diza ubba miishshaa bolla alaafeteththan woththida issi Tophphiya dere gundula asi izara gaaggides; he addezi Xoossas goynnana Yerusalaame bides. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Izi heeppe simmishe para-gaaren uttidi nabe Isayaasa maxaafa nababees. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Ayanay Piliphoosa, «Ba! Gede para-gaarezakko shiiqa» gides.<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />Piliphoosikka eesotidi para-gaarezakko biidi addezi nabe Isayaasa maxaafa nababishin siyidi «Hessi ne nababizayssi nees gelizee?» gides. <figure style="fig" alt="Philip with the Ethiopian eunuch" file="LB00331B.TIF" size="span" ref="8:26">Piliphoosanne Tophphiya dere gundulaza</figure><verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Gundula addezikka «Tana erisiza asi baynda ta wostta eroo?» gides. Izikka gede iza gaarezan gelidi iza achchan uttana mala woossides. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Izi nababiza maxaafay,</para>
  <para style="q1" vid="ACT 8:32">«Izi dorsa mala</para>
  <para style="q2" vid="ACT 8:32">shukettana laagettides;</para>
  <para style="q2" vid="ACT 8:32">dorsa laaqqay iske qanxxizayssa</para>
  <para style="q2" vid="ACT 8:32">sinththan co7u giza mala</para>
  <para style="q2" vid="ACT 8:32">hessaththoka izi ba doona</para>
  <para style="q2" vid="ACT 8:32">pogibeenna.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Bana kawushshidi pirday</para>
  <para style="q2" vid="ACT 8:33">bayndaade gidides.</para>
  <para style="q2" vid="ACT 8:33">Iza shemppoy</para>
  <para style="q2" vid="ACT 8:33">biitta bollafe digettides.</para>
  <para style="q1" vid="ACT 8:33">Iza yeletaa gishshas</para>
  <para style="q2" vid="ACT 8:33">haasayana dandayzay</para>
  <para style="q2" vid="ACT 8:33">oonee?» gees.<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Gundula addezikka zaaridi Piliphoosa, «Nabezi hayssa oona gishshas gizee? Ba gishshas gizeyee? Woykko hara asa gishshas gizee? Hayyana, taas yootarkkii!» gides. <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Piliphoosikka ba doona doydi he maxaafappe doommidi Yesusa Mishiraachcho qaala gishshas markkattides.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Istti issife bishe haaththi dizaso gakkida; addezikka, «Hekko haaththi hayssan dees; histtiin ta xammaqettontta mala tana diggizay aazee?» gides.<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />Piliphoosikka, «Ne kumeththa wozinappe ammanikko xammaqettana dandayaasa» gides. Addezikka, «Yesus Kirstoosi Xoossa Naa gididayssa ta ammanays» gides.<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 37 bolla diza qofaa gujjeettes; issi issoti qasseka qofaa oykkibeettenna.</char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />Addezi para-gaarezi eqqana mala azaziin nam7ay issife haaththan wodhdhiin Piliphoosi addeza xammaqides. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Istti haaththaafe kezishin Xoossa Ayanay Piliphoosa denththi efides; addezi hessafe guye iza beyibeenna; gido attiin ufayssan ba oge bides. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Hessafe guye Piliphoosi Azaxoone geetettizason beettides; Qisaariya geetettizaso gakkanaas izi biza oge bolla katama ubbaan mishiraachcho qaala sabbakides.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s1">Sa7oole Ammano</para>
  <para style="r">(<ref loc="ACT 22:6-16">Hawa 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Sa7ooli Godaa ammaniza asaa wodhanaas ceeqettishe qeeseta halaqaakko bides. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Godaa oge kaallizayta maccassatanne addeta demmi qachchidi Yerusalaame ekki yaanaas Damasqo geetettizason diza Ayhudata Woosa Keeththas dabdaabe xaafana mala qeeseta halaqaa woossides.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Damasqo gakkana matishin qoppontta saloppe poo7oy iza yuushon pol7u gides. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Izikka heerakka biitta bolla kundidi saloppe, «Sa7oole, Sa7oole, tana aazas goodday?» giza qaala siyides.<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Sa7oolikka, «Godoo! Ne oonee?» gides. Izikka izas, «Tani ne goodeththiza Yesusaakko!<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafata birsheththay, «Qara mashsha bolla ne eqqiko qohettana» gishin harati qasse, «Caddiza biratara ne eqettiko nees haa darana» gees.</char></note><note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafa birsheththati Sa7ooli kokkoridinne yashshateththan malalettidi, «Godoo! Ta nees ay ooththana mala dosay?» gides giza qofaa gujjeettes. Hessika shempo 22:10nne 26:14 bolla xaafetti beettees.</char></note> <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Ne ha7i dendada gede katama gela; ne ooththanaas bessizaaz nees ta yootana» gides.<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Sa7oolera issife biza asati qaala giiris sissafe attiin oonakka be7ontta gishshas ba doona oykki eqqida. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sa7ooli ba kundidasohoppe dendidi ayfe doyi xeelliza wode aykkoka demmanaas dandaybeenna; hessa gishshas izara diza asati iza kushe oykkidi kaaleththi ekkidi Damasqo efida. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Heedzdzu gallas gakkanaas qooqidi kath haath beyibeenna.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Damasqon issi Hanaaniya geetettiza ammanizaadey dees; izas Goday ajjuutan, «Hanaaniya» giidi xeygides; izikka, «Yee Godoo!» gides.<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Godaykka iza, «Denda! Suure geetettiza ogeyra Yuhuda geetettizaso ba. Heen Sa7oole geetettiza issi Xarseese asi woossishe dees; ne iza koya demma. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Gaasoykka Hanaaniya geetettizayssi Sa7ooli dizaso yiidi izi xeellana mala iza bolla ba kushe woththishin ajjuutan be7ides.»<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Hanaaniyaykka zaaridi, «Godoo! Hayssaadey Yerusalaamen diza geeshshata bolla ay mala iita meto gaththidaakko ta daro asappe siyadis. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Izi haa yiday ne sunththaa xeygizayta ubbaa qachchanaas qeeseta halaqatappe godateth ekkidikko» gides.<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Godaykka izas, «Ne ba! Hayssi addezi Ayzaabeta sinththaninne kawota sinththan hessaththoka Isra7eele dere sinththan ta sunth tookkana mala izi taas doorettidayssa. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Izi ta sunththaa gishshas ay mala waaye beyanaakko ta iza bessana» gides.<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Hanaaniyay biidi izas yootettidaso gelides. Sa7oole bolla ba kushe woththidi, «Ta isha Sa7oole ne haa yishin nees oge bolla qonccida Godaa Yesusi ne ayfey xeellana malanne neni Xillo Ayanan kumana mala tana neekko kiittides» gides. <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Heerakka Sa7oole ayfeppe poqo malay poqetti wodhdhiin izi xeellana dandaydessinne dendidi xammaqettides. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Kaththika miidi minnides; undenna wode ammanizaytara Damasqon gam7ides.<verse eid="ACT 9:19" /></para>
  <para style="s1">Sa7ooli Damasqoninne Yerusalaamen Tamaarsida Timirte</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />Heerakka Yesusi Xoossa Naa gididayssa Ayhudata Woosa Keeththatan tamaarso oykkides.<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Siyida asay wuri, «Hayssi Yerusalaamen ha sunththaa xeygizayta dhayssiza addeza gidennee? Qasse izi haa yiday he asata qachchi ekki qeeseta halaqataakko efanaas deennee?» gishe malalettida.<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Sa7ooli kaseppe minni minni bides; Damasqon diza Ayhudatas Yesusi izi Xoossi kiittidaade gididayssa ammanththishe asaa doona oyththides.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Daro gallassatappe guye Ayhudati Sa7oole wodhanaas duulatida.<note caller="-" style="x"><char style="xo" closed="false">9:23-25 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2Qoro 11:32-33</ref></char></note> <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Izikka istta qofaa erides; isttika iza wodhanaas katamaa gelththiza ogen gallassinne qamma naagida. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Ammanizayti gidikko iza giddoth katamaa yuushon diza maskootezara keeshen duge woththida.<figure style="fig" alt="Throwing Paul by basket though window" file="HK00332B.TIF" size="span" ref="9:25">Phawuloosa gimbe giddora keeshen yeggishin</figure><verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Sa7ooli Yerusalaame yiidi ammanizaytara walakettana koyiin izi tumu ammanizaade gididayssa istti ammanettontta gishshas izas babbida. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Gido attiin Barnabaasi iza Hawaaretakko efiin Sa7ooli izi Damasqo oge bolla Godaa wostti be7idaakko, Godaykka izas ay yootidaakkonne Damasqon dishe izi ay mala xalateththara Yesusa sunththan sabbakidaakko isttas yootides.<verse eid="ACT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 9:28" />Hessa gishshas Sa7ooli isttara dides; Yerusalaamen yuuyi yuuyi asas babbontta Godaa sunththan tamaarsides. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Girike dereppe yida Ayhudatara haasayshe palamettides; gido attiin asaykka iza wodhanaas koyides. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Ammanizayti hessa eridi duge Qisaariya geetettizaso woththidi Xarseese yeddida.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />He wode Yuhudaninne Galilan, Samaariyankka diza ammanizayti saron diidi kaseppe minnida; qasseka Xoossa yashshateththan simerettishe Xillo Ayanan minettidanne kaseppe qoodan dari dari bida.<verse eid="ACT 9:31" /></para>
  <para style="s1">Eeniyanne Dorqa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Phexroosi dereppe deren yuuyishe Liida kataman diza ammanizayta beyanaas duge wodhdhides. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Heen Eeniya geetettizayssa osppun layth hiixan qashetti uttida issi gunda as demmides. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Phexroosikka, «Haysso Eeniya! Yesus Kirstoosi nena paththana; dendada ne hiixa denththa!» gides; Eeniyay heerakka pusuku gi dendides. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Liidaninne Saroonan diza asay wuri iza be7idi Godaan ammanides.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Iyophphe geetettizason Xaabita geetettiza issi ammanizaara dawus; izi sunththaa birsheththi Girike qaalara, «Dorqa» geetettees; iza ubba wode lo7o ooso minna ooththashenne manqota maaddashe dawus.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="fqa" closed="false">Dorqa </char><char style="ft" closed="false">Guussi Girike qaalara, «Genessa guussa»</char></note> <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />He wode iza hargada hayqqiin asay ahaza meecci pude pooqen kessi woththides. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Liiday Iyophphes mata gidida gishshas ammanizayti Phexroosi Liidan dizayssa siyidi nam7u asata kiittidi, «Elle haa yarkkii!» gi woossida.<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />Phexroosikka dendidi kiitettida asatara gakkida wode iza pude pooqe bolla kessida; am7etikka wuri iza yuuyi aadhdhi eqqidi Dorqay paxa dashe isttara ooththida qamisatanne may7ota bessishe yeekkida.<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />Phexroosikka ubba asaa kifilezappe kessidi gulbati woossides. Ahaakko simmidi, «Hanne Xaabita denda!» gides. Izakka ba ayfe doyada xeelladus; Phexroosakka beyada denda uttadus. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Izikka izi kushe oykki denththides. Ammanizaytanne am7eta xeygidi izo isttas paththi immides. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />He hanoy kumeththa Iyophphen erettidessinne daro asaykka Godaa ammanides. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Phexroosikka issi Simoona geetettiza galba qaacizaadera Iyophphen daro wode de7ides.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s1">Qornoloosanne Phexroosa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Qisaariya geetettiza deren, «Xaalaane wottadarata» geetettiza ola asaa garsan mato halaqa Qornoloosa geetettizayssi dees. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Izikka ba keeththa asaa kumeththaara Ayana hanon minonne Xoos babbizaade; manqotaska daro muxuwaata immizaadenne daro wode Xoos woossiza asa. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Issi gallas gallassafe uddufun saate bolla Xoossa kiitanchchay izas ajjuutan beettidi izakko yiidi, «Qornoloosaa!» gi xeygishin qonccen be7ides.<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Qornoloosikka dagamara tishshi histti xeellishe, «Godoo hayssi aazee?» gides. Kiitanchchayka zaaridi, «Ne woosaynne ne muxuwaatay qofettanaas pude Xoossa sinth gakkides. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ne ha7i as Iyophphe yeddada Phexroosa geetettiza Simoona xeygisa. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Izikka abba matan diza galba qaaciza Simoonason imaththateth dees» gides.<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Qornoloosa haasayssida kiitanchchay izappe shaakettidi bidaappe guye ba ashkaratappe nam7ata qasse Ayana yo7os minonne izas daro ammanettiza wottadaratappe issaa xeygisidi, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />izi be7idayssa ubbaa isttas yootidi Iyophphe kiittides.<verse eid="ACT 10:8" /></para>
  <para style="s1">Phexroosi Be7ida Ajjuuta</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Kiitettida asati wonteththa gallas gede katamaykko matishin Phexroosi usuppun saate bolla woossana pude Pooqe bolla kezides. <verse eid="ACT 10:9" /><verse number="10-11" style="v" sid="ACT 10:10-11" />He wode izi gafida gishshas qumay buro kaxxishin dhisko mala liphiphi histtiin ajjuutara saloy doyettiin issi gita xaaxettida may7o malay oyddu baggara oykettidi duge biittan wodhdhishin be7ides. <verse eid="ACT 10:10-11" /><verse number="12" style="v" sid="ACT 10:12" />He may7oza bolla oyddu tohoy diza dumma dumma do7ati biittara gooshettiza medheteththatinne salo bolla piradhdhiza kafoti deettes. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />He wode, «Phexroosa denda hayta shukkada ma!» giza qaala siyides.<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Phexroosi qasse, «Godoo hayssi hanenna! Geesh gidonttayssa woykko tuna miish ta mulerakka ma erikke» gides.<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />He kase qaalay qasseka nam7anththo izakko yiidi, «Xoossi geeshshidayssa ne tuna mala qoodoppa» gides. <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Hessika heedzdzuto shiretti shiretti izakko yidaappe guye may7o misatizayssi heerakka pude salo bides.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Phexroosikka ba be7ida ajjuutaza birsheththaa eranaas daro metotidi keehi qofa bolla dishin Qornoloosi kiittida asati Simoona keeththe koyishe demmidi pengen eqqida. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Qaala dhoqqu histtidi, «Phexroosa geetettiza Simooni dizasoy hayssan awanee?» gi oychchida.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19-20" style="v" sid="ACT 10:19-20" />Phexroosi ba be7idayssa keehi qoppishin Xillo Ayanay iza, «Hekko heedzdzu asati nena koyeettes; denda! Duge wodhdhada istta yeddiday tana gidida gishshas sidhey baynda isttara ba» gides.<verse eid="ACT 10:19-20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />Phexroosikka duge wodhdhidi, «Hekko intte koyzaadey tanakko! Intte yiday aazassee?» gides. <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Isttika izas, «Nuni mato halaqa Qornoloosa matappe yidos; izikka Xoossas babbiza xillo asanne Ayhuda asa ubbaa matan daro bonchchettida asa; nekka iza soo baana malanne ne gizayssa izi siyana mala geeshsha kiitanchchay izas yootides» gida.<verse eid="ACT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23" />Phexroosikka asata ba dizason mokki ekkidi ayssides.</para>
  <para style="s1" vid="ACT 10:23">Qornoloosa Keeththan Phexroosa</para>
  <para style="p" vid="ACT 10:23">Phexroosikka wonteththa gallas dendidi isttara bides; Iyophphefe yida issi issi ammaniza asati izara issife bida. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Qornoloosikka ba dabbotanne mata laggeta ba soon shiishshidi naago bolla dishin izi nam7anththo gallas Qisaariya gakkides. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Phexroosikka Qornoloosa keeththe geliin Qornoloosi iza mokki ekkidi iza toho bolla hokki goynnides. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Gido attiin Phexroosi, «Tanikka ne mala asakko! Denda» giidi denththides.<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />Phexroosikka iza haasayssishe izara soo gelishin daro derey shiiqi uttidayssa be7ides. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Izikka isttas, «Ayhuda asi hara dere asara gaaggontta mala woykko hara dere as gididayta mata shiiqontta mala nu wogay diggizayssa intte ereeta; gido attiin ta oonakka tuna woykko izi geesh deenna gontta mala Xoossi taas qonccisides. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Hessa gishshas ta xeygettida wode hekko sidhontta yadis; histtiin intte tana aazas xeygidaakko erana koyays» gides.<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Qornoloosikka, «Oyddu gallassafe kase likke hanni wode gallassaafe uddufun saaten tani tason woossishin qoppontta booththa may7o may7ida asi yiidi ta sinththan eqqidi <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />tana, ‹Qornoloosaa! Ne woosay siyettides; ne manqotas immiza muxuwaatay Xoossa sinth gakkides. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Hessa gishshas Iyophphe katama as kiittada Phexroosa geetettiza Simoona ehisa; izi abba achchan galba qaaciza Simoona keeththan imaththateth dees› gides. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Tanikka heerakka neekko as kiittadis; ne yuussayka lo7o; histtiko Goday nena azazidayssa ne nuus yootikko Xoossi yootidayssa neeppe siyanaas nu wurikka hayssan Xoossa sinththan doos» gides.<verse eid="ACT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Phexroosikka, «Xoossi oonakka shaakki maaddonttayssa tumappe ta eradis.<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Zaare 10:17</ref></char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Gido attiin Xoossas babbizaytanne xillo ooththizayta ubbaa oona baggafe gidiinkka izi ekkees. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Xoossi ubbaas Godaa gidida Yesus Kirstoosa baggara Isra7eele asas kiittida saroteththa Mishiraachcho kiitay hayssa. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Yohannisi xinqata gishshas sabbakidaappe guye Galilappe doommidi kumeththa Yuhudan hanidayssa intte ereeta. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Xoossi Naazirete Yesusa Xillo Ayananinne wolqqan tiydes; izikka Xoossi izara diza gishshas ba gakkidason ubbaan lo7o ooththishe Xala7e godateththa giddon dizayta ubbaa paththides.<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />«Izi Ayhudata dereninne Yerusalaame kataman ooththidayssa ubbaas nu markka; qasseka asay iza miththa bolla kaqqi wodhides. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Gido attiin Xoossi iza heedzdzanththo gallas hayqoppe denththidessinne asi iza beyana mala ooththides. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Izi qoncciday asa ubbaas gidontta hayqoppe dendiin izara midaytassinne izara uyidaytas Xoossi koyro doorida nuus iza markkatassa. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Izi nu derezas sabbakana malanne hayqqidayta bollanne paxa dizayta bolla pirdanaas Xoossi shuumiday iza gididayssa nu markkattana mala nuna azazides. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Iza ammanidaadey wuri iza sunththan nagara maarettidi geeyanayssa nabeti izas markkatteettes» gi yooto doommides.<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Phexroosi hessa haasayshin qaalaa siyizayta ubbaa bolla Xillo Ayanay wodhdhides. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Qaxxarettidayta baggafe Phexroosara yida ammanizayti Xillo Ayana imoteththi Ayzaabeta bolla wodhdhishin be7idi malalettida. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Hessika istti dumma qaalan haasayshininne Xoossa galatishin siyida gishshassa. He wode Phexroosi,<verse eid="ACT 10:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 10:47" />«Hayti asati nu mala Xillo Ayana ekkida gishshas istti haaththan xammaqettontta mala istta digganay oonee?» gides. <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Hessa gishshas Yesus Kirstoosa sunththan xammaqettana mala azazides; hessafe guye Phexroosi guuththa wode isttara daana mala woossida.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">Phexroosa Bolla Shiiqida Walassa Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Hawaaretinne Yuhudan diza ammanizayti Ayzaabeti Xoossa qaala ekkidayssa siyida. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Hessa gishshas Phexroosi pude Yerusalaame keziin qaxxarettida Ayhudappe ammanizayti Phexroosa, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />«Ne qaxxarettontta asata keeth gelada isttara kath madasa» giidi walassida.<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Phexroosi qasse isttas gelana mala maarara hizgi yootides. <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />«Tani Iyophphe kataman woossishin dhisko mala tana liphiphi histtidi ajjuutan gita may7o misatiza miishshi oyddu baggara oykettidi saloppe ta dizaso wodhdhishin beyadis. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Ta tishshi histta xeellishin oyddu tohora diza meheta, wora do7ata, biitta bolla gooshettiza medheteththatanne salo bolla piradhdhiza kafota beyadis. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Heerakka tana, ‹Phexroosa denda! Hayssa shukkada ma› giza qaala siyadis.<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />«Tanikka, ‹Godoo hessi hanenna; tani tuna woykko geesh gidonttayssa mulekka ta doonaakko shiishsha erikke› gadis.<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />«He kase qaalay qasseka, ‹Xoossi geeshshidayssa ne tunisoppa› giidi saloppe taas yootides. <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Hessika heedzdzuto shiretti shiretti yootettidaappe guye wurikka simmidi pude salo bides.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />«Qisaariyappe taakko kiitettida heedzdzu asati heerakka he saateyin yi gakkidi ta diza keeththa karen eqqida. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ta aynne sidhontta isttara baana mala Xillo Ayanay taas yootides. He usuppun ishati tanara issife biidi addeza keeththe gelidos. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Izikka Xoossa kiitanchchay iza keeththan eqqidi izas beettidayssa, ‹Iyophphe geetettizaso as yeddada Phexroosa geetettiza Simoona xeygisa. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Izi yiidi nenanne neso asaa ubbaa ashshana qaala yootana› gidayssa nuus yootides.<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />«Tanikka baada buro yooto oykkishin koyro Xillo Ayanay kase nu bolla wodhdhoyssaththo istta bollaka wodhdhides. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Kase Goday nuus yootishe, ‹Yohannisi haaththan xammaqides; intte gidikko Xillo Ayanan xammaqettana› gida qaalay heerakka taas qofettides.<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">Hawa 1:5</ref></char></note> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Hessa gishshas nuni Godaa Yesus Kirstoosa ammanishin nuus immida Xillo Ayana Xoossi isttas immiko histtiin Xoossara eqettanaas tani oonee?» gides.<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Istti hessa siyida wode isttas gizaazi dhayiin co7u gi simmidi, «Hayssa mala gidikko Ayzaabetikka ha ooraththa de7okko yaana mala Xoossi asas maaroteth immides guussa» giidi Xoossaa galatida.<verse eid="ACT 11:18" /></para>
  <para style="s1">Anxokiyan Diza Woosa Keeththayo</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Isttifaanose bolla dendida goodeteththa gaason laalettida ammaniza asay qaalaa Ayhudatas xalala yootishe Pinqe, Qophiroosenne Anxokiya geetettizaso gakkanaas kanththi bida.<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">Hawa 8:1-4</ref></char></note> <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Qophirooseppenne Qareenappe yida issi issi asati Anxokiya biidi Giriketaska Godaa Yesusa Mishiraachcho qaalaa yootida. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Godaa maadoykka isttara dees; qoodan keehi daro asay ammanidi Godaakko simmides.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Hessa woreykka Yerusalaamen diza Woosa Keeththa asaa hayththan wodhdhiin Woosa Keeththaya Barnabaasa Anxokiya yeddadus. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Izikka hee bi gakkidi Xoossi ba aadho kiyateth deraas immidayssa be7idi ufayettidessinne asay wurikka kumeththa wozinappe Godaa ammanon minnana mala zorides. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Izikka Xillo Ayananinne ammanon kumida lo7o asa. Daro derey Godaa ammanidi gujettides.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Hessafe kaallidi Barnabaasi Sa7oole koyana Xarseese bides. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Iza demmidi Anxokiya ekki yides; nam7ayka heen diza Woosa Keeththa asaara gididi layth kumeth daro dere tamaarsida. Heen Anxokiyan ammanizayti koyro, «Kirsaane» geetetti xeygettida.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />He wode issi issi nabeti Yerusalaameppe duge Anxokiya wodhdhida. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Istta giddofe issoy Agaboosa geetettizayssi dendi eqqidi Xillo Ayanay iza bessiin alame ubbaan gita koshay dendanayssa yootides. Hessika Oroome kawo Qalawodoosa Qeesaare geetettizayssa kawoteththa wode polettides.<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">Hawa 21:10</ref></char></note> <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ammanizayti wuri issoy issoy ba wolqqa keena miishshe kesettidi Yuhudan diza ammaniza ishata maaddanaas qachchida. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Maado miish kesettidi Barnabaasanne Sa7oole kushen cimatas gaththana mala yeddida.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">Ammanizayta Bolla Gakkida Gita Metonne Goodeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />He wode kawo Herdoosi issi issi ammaniza asaa gooddi gooddi metoththides. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Yohannisa isha Yaaqoobe mashshan wodhisides. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Izi hessa ooththiday Ayhudata ufayssidayssa be7idi Phexroosakka oyththides; hessika haniday Ayhudatas ukeththa ba7aale geetettiza ba7aale gallassa. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Phexroosakka qasho keeth gelththidaappe guye oyddu oyddu wottadarati taran taran naagana mala giigettida wottadaratas immides. Izi hessaththo ooththiday Paaziga ba7aaley aadhdhida mala kessidi derey pirdana mala shiishshanaassa.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref></char></note> <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Hessa gishshas Phexroosa qasho keeththe gelththidi naageettes; gido attiin Woosa Keeththa asay izas keehi mino woosa woossides.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Herdoosi Phexroosa dereza sinth shiishshana qoppi utti dishin he qamma giddoth nam7u sansalatan qashettidi nam7u wottadarata giddon ichchides; qasho keeththa naagizayti keeththaa penge bolla eqqi naagishin, <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Godaa kiitanchchay ezgontta beettides; istti diza kifilen poo7oy poo7ides; kiitanchchazikka Phexroosa mille bochchi beegoththidi, «Elle denda!» gides; heerakka sansalatay iza kusheppe gaden wodhdhides.<verse eid="ACT 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8" />Kiitanchchazi iza, «Ne may7o may7a! Caammaka aaththa!» giin Phexroosikka azazettida mala ooththides; qasseka kiitanchchay, «Ne gaabe may7ada tana kaalla» gides. <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Phexroosikka qasho keeththaafe iza kaalli kezides; gido attiin izas agumo be7izaa misatides attiin kiitanchchazi ooththizayssi tumu gididayssa eribeenna. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Koyro zabetappenne nam7anththo zabetappe aadhdhidi gede katama kessiza oge bolla diza birata pengaako gakkida; pengeyka barkka doyetti wodhdhides; istti kezi bida; istti qeeri oge dizaaro aadhdhida mala kiitanchchazi izappe shaakettides.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Phexroosas kahay simmishin, «Goday ba kiitanchcha kiittidi tana Herdoosa kusheppenne Ayhudati ta bolla qoppida ubbaafe tana kessidayssa ta ha7i tumappe eradis» gides.<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Hessa akeeki eridaappe guye daro asay issi bolla shiiqettidi woossiza Marqoosa geetettiza Yohannisa aayo Maaramiso bides. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Izi hee biidi kare penge qoxxiin issi Eroodo geetettiza garadeya kare ooni qoxxizaakko eranaas kare mata badus. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Qaalay Phexroosayssa gididayssa erada keeha ufayettida gishshas kareza doyontta woththan guye simmada, «Phexroosi Karen penge bolla eqqides» gadus.<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />Asaykka izo, «Hanne gooyay!» gida; iza qasse zaara zaara isttas yootiin, «Histtiko hessi iza naagiza kiitanchchaa gidontta aggenna» gida.<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Phexroosi qasseka penge qoth gujjides; isttika pengaa doydi iza be7ida mala malalettida. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Izikka istti co7u gaana mala ba kushen malati bessidi Goday iza qashosoppe wostti kessidaakko lo7eththi yootides. «Hayssa wursi Yaaqoobessinne hankko ammanizaytas yootite» gides. Hessafekka haraso bides.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Wonteththa gallas wonttara wottadarati, «Phexroosi waanidee?» gishe ba giddon bul7akettida. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Herdoosi as yeddi Phexroosa koyisidi izi dhayda gishshas naagizayta lo7eththi oychchidaappe guye istta wodhana mala azazides. Hessafe guye Herdoosi Yuhudappe duge Qisaariya wodhdhidi heen uttides.<verse eid="ACT 12:19" /></para>
  <para style="s1">Herdoosa Hayqo</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Herdoosikka Xiroose asaaranne Sidoona asaara ooshsha; he dere asay kath demmizay Herdoosa dereppe gidida gishshas he dere kawo xeellizaade Bilasxoosappe maado qaala demmida mala issi bolla gididi Herdoosara maqayinththanaas oychchida.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Giigana barettida gallas Herdoosi kawoteththa may7o may7idi kawoteththa algan uttidi deraas haasaydes. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Derezikka, «Hayssi Xoossa qaalappe attiin asa qaala deenna!» gi waassides. <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Herdoosikka Xoossas bonchcho immontta aggida gishshas Godaa kiitanchchay heerakka Herdoosa shoci yeggiin guxuni hayqqides.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Xoossa qaalay gidikko diccidi aakki aakki bides. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Barnabaasinne Sa7ooli ba ekki bida kiitaa polidi Yerusalaame simmidi Marqoosa geetettiza Yohannisakka banara ekki simmida.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s1">Barnabaasanne Sa7oole Kiiteteth</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Anxokiyan diza Woosa Keeththan nabetinne astamaareti deettes; heytikka Barnabaasinne Negere geetettiza Simoonara, Qareena dere as Luqiyoosara, Herdoosara issife diccida Minaheranne Sa7oolera wuri issife deettes.<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Negerey Laatine qaala gidishin birsheththay kareth guussa.</char></note> <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Heyti wuri Godaas goynnishenne xoomishe dishin Xillo Ayanay, «Barnabaasanne Sa7oole ta istta xeygida oosos taas shaakki kessite» gides. <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Isttika xoomi woossidi ba kushe istta bolla woththidaappe guye moyzida.<verse eid="ACT 13:3" /></para>
  <para style="s1">Barnabaasinne Sa7ooli Qophiroose Geetettizason</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Barnabaasinne Sa7ooli Xillo Ayana kiitan duge Selawuqiya wodhdhida; heeppeka markaben gelidi Qophiroose bida. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Salmise geetettizaso gakkidi Ayhudata Woosa Keeththatan Xoossa qaala sabbakida; Marqoosa geetettiza Yohannisikka isttara biidi istta maaddides.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Abba giddon diza biitta Qophiroose geetettiza dereyo ha gaxappe he gaxa gakkanaas kanththi kezidi Phaafa geetettizaso gakkishin issi Ayhuda asa shin maronne wordo nabe Baar-Yesusa geetettiza as demmida. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Izikka issi Sarggoosa Phawuloosa geetettiza wozinama dere ayssizayssara issife dees; hessi dere ayssiza addezi Xoossa qaala siyana koyidi Barnabaasanne Sa7oole xeygisides. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Marozi Elimaasi ba sunththaa birsheththa mala dere ayssizayssi ammanontta mala dhuphanaas koyidi isttara eqettides. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Phawuloosa geetettida Sa7ooli Xillo Ayanay izan kumiin maroza tishshi histti xeellidi, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />«Nenoo xilloteth ubbaas morkkezoo! Geneynne iitateththi nenan kumidaysso haysso daabulosa nawu! Godaa suure oge geellaseththafe shempikii? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Hekko ha7i Godaa kushey ne bolla dees; ne qooqana; hannife guye arshe poo7o issinokka beyakka» gides.</para>
  <para style="p" vid="ACT 13:11">Heerakka shaarumaynne dhumay iza bolla wodhdhides; kushe oykki bana kaaleththanaade koshshi yaanne haa gides. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Dere ayssizayssi ha hanida yo7oza be7idi Godaa gishshas siyida timirtezan malalettidi ammanides.<verse eid="ACT 13:12" /></para>
  <para style="s1">Phissidiya Geetettiza Deren Barnabaasanne Sa7oole</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Phawuloosinne izara dizayti Phaafappe dendidi Phinfiliya geetettizason diza Phergene geetettizaso markaben geli bida; Yohannisi isttafe shaakettidi guye Yerusalaame simmides. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Istti gidikko Phergeneppe dendidi Phissidiya giddon diza Anxokiya bida; Sambata gallas Ayhudata woosa keeth geli uttida. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Muse woga maxaafatinne nabeta maxaafati nababettidaappe guye Ayhudata Woosa Keeththa halaqati, «Nu ishatoo! Inttes hayssa asaa zorana qaalay diikko haasayte» giidi isttako ase yeddida.<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Phawuloosikka dendi eqqidi ba kushera malatidi, «Intteno Isra7eele asatoo! Qasseka intteno Xoossas yayyiza Ayzaabetoo! siyite. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ha Isra7eele dere Xoossay kase nu aawata doorides; istti Gibxe deren dishin istta dhoqqu dhoqqu histtides; ba wolqqama qesera heeppe istta kessides.<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">Kessa 1:7</ref>; <ref loc="EXO 12:51">12:51</ref></char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Oyddu tammu layth kumeth istta bazzo biittan dandaydes.<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="fqa" closed="false">Dandaydes: </char><char style="ft" closed="false">Dandaydes issi issi Geeshsha Maxaafati istta lo7eththi oykkides geettes.</char></note><note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">Tay 14:34</ref>; <ref loc="DEU 1:31">Zaare 1:31</ref></char></note> <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Kanaane biittan dizayta laappun kawota dhayssidi istta biittaa ba deretas gade histti laatissides.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">Zaare 7:1</ref>; <ref loc="JOS 14:1">Iya 14:1</ref></char></note> <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Hessi wuri polettiday oyddu xeetanne ichchashu tammu layththata giddona; hessafe guye nabe Sameela wode gakkanaas istta bolla pirdiza daannata immides.<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="DAN 2:16">Daane 2:16</ref>; <ref loc="1SA 3:20">1Same 3:20</ref></char></note><verse eid="ACT 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21" />«Hessafe guye derey ba bolla kawo kawoththana mala Sameela woossides; Xoossayka Biniyaame baggafe Qiise naa Sa7oole isttas immides; izikka istta oyddu tammu layth haarides.<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1Same 8:5</ref>; <ref loc="1SA 10:21">10:21</ref></char></note> <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Sa7oole shaaridaappe guye Dawite kawoththides; iza gishshas, ‹Ta wozina mala hanizayssanne ta koyidayssa ubbaa ooththiza Isseye naa Dawite ta demmadis› giidi Dawite gishshas Xoossi markkattides.<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1Same 13:14</ref>; <ref loc="1SA 16:12">16:12</ref>; <ref loc="PSA 89:20">Maza 89:20</ref></char></note> <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Xoossika ba caaqo qaalaaththo ha addeza zereththafe as ashshizayssa Yesusa Isra7eeles ehides. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Yesusi yaanaappe kase Yohannisi Isra7eele derey wuri maaroteththan gelidi xammaqettana mala sabbakides.<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">Mar 1:4</ref>; <ref loc="LUK 3:3">Luqa 3:3</ref></char></note> <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Yohannisi ba kiitettidayssa polo bolla dishe, ‹Ta inttes oona misatazinaa? Ta kiitettidayssa gidikke; haray attoshin ta izas toho caamma kire birshanaas bessonttayssi taappe guyera yaana› gides.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="JHN 1:20">Yoha 1:20</ref>; <ref loc="MAT 3:11">Mato 3:11</ref>; <ref loc="MRK 1:7">Mar 1:7</ref>; <ref loc="LUK 3:16">Luqa 3:16</ref>; <ref loc="JHN 1:27">Yoha 1:27</ref></char></note><verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />«Intteno Abrahaame zereththafe yelettida nu ishatoo! Qasseka intte giddonkka Xoossas yayyizayti wuri hayssi atoteththa kiitay kiitettiday nuus ubbatassa! <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Yerusalaame asatinne istta halaqati Yesusa eribeettenna; gido attiin istti iza bolla pirdida; hessankka sambatan sambatan nababettiza kase nabeta qaalay iza bolla polettides. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Iza hayqos gaththiza issi gaasokka istti demmontta aggikokka Philaxoosi iza bolla hayqo pirda pirdana mala woossida.<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">Mato 27:22-23</ref>; <ref loc="MRK 15:13-14">Mar 15:13-14</ref>; <ref loc="LUK 23:21-23">Luqa 23:21-23</ref>; <ref loc="JHN 19:15">Yoha 19:15</ref></char></note> <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Iza gishshas xaafettidayssa istti ubbaa polidaappe guye iza kaqettida miththaa bollafe gaden woththidi duufon moogida.<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">Mato 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luqa 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref></char></note> <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Gido attiin Xoossi iza hayqoppe denththides. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Galilappe Yerusalaame gakkanaas banara dizaytas daro wode beettides; heytikka ha7i iza gishshas deretas markkatta.<note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">Hawa 1:3</ref></char></note><verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />«Nunikka kase Xoossi nu Aawatas caaqqida Mishiraachcho qaalaa inttes sabbakoos. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Yesusa kiittidi isttas caaqqida qaalaa nuus istta naytas polides; hessika mazamure maxaafan nam7anththo shempon, ‹Ne ta naaza; ta nena hach yeladis› geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Maza 2:7</ref></char></note> <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />Qasseka izi wooqqonttayssanne Xoossi iza hayqoppe denththidayssa shaakki erana mala,</para>
  <para style="q1" vid="ACT 13:34">« ‹Anjjettidayssanne ammanettida</para>
  <para style="q2" vid="ACT 13:34">Dawite anjjo ta inttes</para>
  <para style="q2" vid="ACT 13:34">immana› gides.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">Isa 55:3</ref></char></note><verse eid="ACT 13:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 13:35" />Hessa gishshas harasonkka,</para>
  <para style="q2" vid="ACT 13:35">‹Ne geeshshay</para>
  <para style="q2" vid="ACT 13:35">hayqqi wooqqana mala</para>
  <para style="q2" vid="ACT 13:35">ne koyakka› gees.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">Maza 16:10</ref></char></note><verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />«Dawiti ba woden Xoossa shene mala ooththidaappe guye hayqqides; kase ba aawatara moogettiin iza ashoy wooqqides. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Xoossi iza hayqoppe denththidayssi izi gidikko wooqqibeenna. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Hessa gishshas ta ishatoo! Nagaras maaroteththi beettizay Yesusa baggara gididayssi inttes sabbakettidayssa erite. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Iza ammanizaadey wuri kase Muse wogaa baggara demmontta xilloteth demmana. <verse eid="ACT 13:39" /><verse number="40-41" style="v" sid="ACT 13:40-41" />Hessa gishshas kase nabeti,</para>
  <para style="q1" vid="ACT 13:40-41">« ‹Intteno qidhizayto xeellite,</para>
  <para style="q2" vid="ACT 13:40-41">malalettitenne dhayte,</para>
  <para style="q2" vid="ACT 13:40-41">inttes oonikka yootiin</para>
  <para style="q2" vid="ACT 13:40-41">ammananaas</para>
  <para style="q2" vid="ACT 13:40-41">inttena metiza miish</para>
  <para style="q2" vid="ACT 13:40-41">ta intte woden</para>
  <para style="q2" vid="ACT 13:40-41">ooththana› gida qaalay</para>
  <para style="q2" vid="ACT 13:40-41">intte bolla gakkontta mala</para>
  <para style="q2" vid="ACT 13:40-41">naagettite» gides.<verse eid="ACT 13:40-41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Phawuloosinne Barnabaasi Ayhudata Woosa Keeththafe kezishin asay istta hessa istti yootida qaalaa kaalliza Sambata gallas zaari yootana mala woossides. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Shiiqoy laalettidaappe guye daro Ayhudatinne Ayhudata ammanon gelidi Xoos goynniza asati Phawuloosanne Barnabaasa kaallida. Phawuloosanttika istta qofsishe istti Xoossa kiyateththan minni daana mala zorida.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Kaalliza Sambata gallas katama asappe guuththati xalala attiin dariza baggay wuri Godaa qaalaa siyana shiiqides. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ayhudatikka daro dere be7idi qanaateteththan kumida; Phawuloosa haasaya eqettishe iza cayida.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46-47" style="v" sid="ACT 13:46-47" />Phawuloosinne Barnabaasi babbontta xalateththan, «Xoossa qaalay koyro inttes yootettanaas bessees; gido attiin intte qaalaa leqqideta. Inttes mernaa de7oy bessonttayssa intterkka intte bolla pirdida gishshas ha7i nuni gede Ayzaabetakko baana koyoos; qasseka Goday nuna, ‹Asas atoteththa qaala biitta gaxa gaththana mala ta nena Ayzaabetas poo7o histta kiittadis› gi azazides» gida.<verse eid="ACT 13:46-47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Ayzaabeti hessa siyidi daro ufayettida; Godaa qaalaska bonchcho immida; mernaa de7os giigettida derey wuri ammanides. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Godaa qaalay heeran diza dere ubbaso gakkides. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Ayhudati qasse Ayana hanon kaseppe minnizaytanne duussan bonchchettida maccassata hessaththoka kataman diza gita asata denththeththidi Phawuloosa bollanne Barnabaasa bolla goodeteth denththidi ba dereppe kessi gooddida. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Phawuloosinne Barnabaasi asay istta ixxidayssa bessanaas ba toho bolla diza gudulla pittidi Iqoniyoone geetettizaso bida.<note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">Mato 10:14</ref>; <ref loc="MRK 6:11">Mar 6:11</ref>; <ref loc="LUK 9:5">Luqa 9:5</ref>; <ref loc="LUK 10:11">10:11</ref></char></note> <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Ammanizayti ufayssaninne Xillo Ayanan kumida.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">Iqoniyoonen Phawuloosanne Barnabaasa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Iqoniyoonen Phawuloosinne Barnabaasi issife Ayhudata Woosa Keeththe gelida; heenkka istti asaa lo7eththi tamaarsida gishshas Girike asaappenne Ayhuda asappe daroy ammanides. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Hinko ammanontta Ayhuda asay Ayzaabeta istta bolla denththeththidi asay ammanizayta ixxana mala ooththides. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Phawuloosinne Barnabaasi Godaa gishshas xalateththara asas yootishe heen daro wode gam7ida; Godaykka istti yootiza qaalaa gita malataranne wolqqama ooson qonccisi markkattides. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Katamaa asay ba giddon nam7u kezi shaakettidi baggay Ayhudata bagga, baggay Phawuloosantta bagga gidides.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />He wode Ayhudatinne Ayzaabeti bana kaaleththizaytara issife gididi istta waayisanaassinne shuchchan caddanaas koyida. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Isttika hessa erida mala Listtiranne Darbeene geetettizaso Liqa7ooniya katamatanne he heeran diza dere baqatida. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Heenkka mishiraachcho qaalaa sabbako doommida.<verse eid="ACT 14:7" /></para>
  <para style="s1">Listtiraninne Darbeenen Phawuloosanne Barnabaasa</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Listtiran yelettoosoppe ba tohora hemetti erontta issi toho sila addey dees. <verse eid="ACT 14:8" /><verse number="9-10" style="v" sid="ACT 14:9-10" />Hessaadey Phawuloosi sabbakishin utti siyees; Phawuloosikka izakko tishshi histti xeellidi addeza paththana ammanoy iza bolla dizayssa be7idinne qaala dhoqqu histtidi, «Sitti gaada ne tohon eqqa!» gides. Addezi heerakka guppi dendidi hemeth oykkides.<verse eid="ACT 14:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Asay Phawuloosi ooththidayssa be7idi Liqa7ooniya qaalara, «Eeqa Xoossati as misatidi haa nuukko wodhdhida» giidi waassides. <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Barnabaasa, «Diya» gida Phawuloosakka haasayza waannay iza gidida gishshas, «Hermeene» gida. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Katamaappe asi bayndason diza Diya geetettiza eeqa keeththa qeesey kormatanne xaaxetti giigida ciish gede katama geliza oge bolla efidi derezara issife gididi Phawuloosassinne Barnabaasas yarshana koyides.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Hawaareti Barnabaasinne Phawuloosi hessa siyida mala ba may7o daakkidi gede dereza giddo woxxida; ba qaala dhoqqu histtidi hizgida; <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«Hayto asatoo! Hayssa aazas ooththeetii? Nunikka intte mala asakko! Intteka qasse hayssa mela hada yo7oppe haakkidi salonne sa7a, abbaka, abbata giddon dizayta ubbaa medhdhida de7o Xoossaako intte simmana mala inttes mishiraachcho qaala sabbakoos.<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref>; <ref loc="PSA 146:6">Maza 146:6</ref></char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Izi kase aadhdhida yeletaynne derey wurikka ba koyida mala hananaas yeddi bessides. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Gido attiin Xoossi saloppe iranne hessaththoka kaththi kaxxiza wodeta immidi intte wozina kaththaninne ufayssan kunththides; ufayssaaka inttena kalssidi lo7o ooson bana markkay baynda aggibeenna» gida. <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Hessa ubbaa haasaydi asay isttas yarshontta mala waaydi diggida.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Ayhudati qasse Anxokiyappenne Iqoniyooneppe yida asay asaa zoridi Phawuloosa shuchchan caddana mala ammanththida; Phawuloosakka shuchchan caddidi hayqqides gi goochchidi katamappe gede kare kessida. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Gido attiin ammanizayti iza yuuyi aadhdhi naagishin Phawuloosi dendidi gede katama gelides; wonteththa gallas Barnabaasara issife Darbeene geetettizaso bida.<verse eid="ACT 14:20" /></para>
  <para style="s1">Sooriyan Diza Anxokiya Phawuloosanne Barnabaasa Simo</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Phawuloosinne Barnabaasi Darbeenen mishiraachcho qaalaa sabbakidi daro asaa ammanththidaappe guye gede Listtira, Iqoniyoonenne Anxokiya simmida. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Ammanizayta wozina minththeththishe istti ammanon minni daana mala zorishe, «Nu Xoossa kawoteth gelanaas daro meto giddora aadhdhanaas koshshees» gida. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Hessafe guye dumma dumma Woosa Keeththatan cimata dooridaappe guye xoomaninne woosan ammanettida Godaas hadara aaththi immida.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Phissidiyara aadhdhidi Phinfiliya simmida. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Phergenen qaala sabbakidi duge Axaaliya geetettizaso wodhdhida. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Axaaliyappeka ha7i gakkanaas istti ooththida oosoza hadara isttas imettida katama Sooriyan diza Anxokiya markaben gelidi simmida.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Hee gakkida mala Woosa Keeththa asaa ubbaa shiishshidi Xoossi isttara ooththidayssa qasseka Ayzaabetas ammano pengey waani doyettidaakko wursi yootida. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Heen ammanizaytara daro wode gam7ida.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s1">Yerusalaame Duulata</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Issi issi asati Yuhudappe duge Anxokiya wodhdhidi, «Intte Muse wogaa mala qaxxarettontta aggiko oonikka attanaas dandayekketa» giidi ammanizayta tamaarso doommida.<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Lewe 12:3</ref></char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Hessika Phawuloosanne Barnabaasa gita palamaninne ooshsha giddo gelththides; hessa gishshas Phawuloosinne Barnabaasi hara issi issi ammaniza asatara Yerusalaame kezidi ha yo7oza gishshas cimatanne Hawaareta oychchana mala geetettides.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Hessa gishshas Woosa Keeththaya istta Yerusalaame baana mala kiittiin istti Pinqeranne Samaariyara aadhdhi bishe heen diza Ayzaabeti ammanon simmidayssa yootida; he wode ammanizayti hessa siyidi keehi ufayettida. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Istti Yerusalaame gakkiin Woosa Keeththa asay Hawaaretinne cimati istta mokki ekkida; kiitetti bidaytikka Xoossi isttara gididi ooththidayssa ubbaa isttas yootida. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Farsaaweta bagga asatappe ammanida issi issi asati dendidi, «Ayzaabeti qaxxarettanaassinne Muse wogaa naagana mala isttas yootanaas bessees» gida.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Hawaaretinne cimati he yo7oza giddo lo7eththi xeellanaas shiiqida. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Daro palamappe guye Phexroosi dendi eqqidi, «Ta ishatoo! Guuththa wodeppe kase Xoossi tana intte giddofe dooridi Ayzaabeti ta doonappe mishiraachcho qaala siyidi ammanana mala ooththidayssa intte ereeta. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Asa wozina eriza Xoossi nuus immidayssa mala isttaskka Xillo Ayana immidi istta baas ekkidayssa markkattides.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 10:44">Hawa 10:44</ref></char></note> <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Istta wozinakka ammanon geeshshidi nu giddoninne istta giddon aykko shaakokka ooththibeenna. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Hessa gishshas nu aawatinne nunikka tookkanaas dandayontta qambara ammanizayta toossanaas intte aazas Xoos paacceetii? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Nu attiday likke isttaththoka Godaa Yesusa aadho kiyateththan gididayssa ammanoos» gides.<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Shiiqida asay wurikka co7u giin Barnabaasinne Phawuloosi Xoossi istta baggara Ayzaabeta giddon ooththida gita malaatata gishshas yootishin malalettidi lo7eththi siyida. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Istti yooti wursishin Yaaqoobey dendi eqqidi, «Ta ishatoo! Ta gizayssa siyite; <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Xoossi Ayzaabetappe baas gidana dere kasetidi izi wostti xeygi woththidaakko Simooni nuus lo7eththi yootides. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Kase nabetan hizgi xaafettida qaalay hayssara gaaggees.<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />« ‹Hayssafe guye ta simmada</para>
  <para style="q2" vid="ACT 15:16">laalettida Dawite</para>
  <para style="q2" vid="ACT 15:16">keeththe keexxana;</para>
  <para style="q2" vid="ACT 15:16">laalettidayssa zaara essana;</para>
  <para style="q2" vid="ACT 15:16">zaaradakka keexxana.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Hessika attida asay</para>
  <para style="q2" vid="ACT 15:17">Godaa koyana malanne</para>
  <para style="q2" vid="ACT 15:17">ta sunththaan</para>
  <para style="q2" vid="ACT 15:17">xeygettida Ayzaabeti</para>
  <para style="q2" vid="ACT 15:17">tana koyana mala gees</para>
  <para style="q2" vid="ACT 15:17">ubbaa ooththida Xoossay.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Hayssa koyroppeka erisida Xoossi</para>
  <para style="q2" vid="ACT 15:18">tana› gees.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />«Hessa gishshas ha Xoossaako simmida Ayzaabeta nu metoththontta mala hayssi ta baggara taas qasho. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Gido attiin eeqas yarshettidi tunida kath moopite; laymappe haakkite; bawuti hayqqida mehe asho moopite; suuth uyopite giidi nu isttas xaafana bessees.<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">Kessa 34:15-17</ref>; <ref loc="LEV 18:6-23">Lewe 18:6-23</ref></char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Muse wogay gidikko beniisofe Sambata Sambata gallas Ayhudata Woosa Keeththan nababettishenne katamay dizason sabbakettishe dees» gides.<verse eid="ACT 15:21" /></para>
  <para style="s1">Ammaniza Ayzaabetas Hawaaretappe Xaafettida Dabdaabe</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />He wode Hawaaretinne cimati kumeththa Woosa Keeththa asaara gididi ba giddofe issi issi asata dooridi Phawuloosaranne Barnabaasara gaththi Anxokiya yeddanaas qachchida. Ammaniza asaa giddofe waannatizayta Barsabaasa geetettiza Yuhudanne Sillaase doorida. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Istta kushen immi yeddida dabdaabezi, «Intte ishatappe, Hawaaretappe, cimatappe, Ayzaabetappe ammanida Anxokiyaninne Sooriyan, Kilqiyankka diza ammanizaytas nu sarokay inttena gakko.<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />«Issi issi asati nuuppe gidontta ba baggara nu achchafe biidi ba haasayan intte wozina yaanne haa qaaththidayssanne inttena bul7akidayssa nu siyidos. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Hessa gishshas guuththa asata dooridi dosettida Barnabaasaranne Phawuloosara intteko yeddanaas nu wurikka qaala gaaggidos. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Istti Godaa Yesus Kirstoosa gishshas ba shemppo aaththi immidayta. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Hessa gishshas nu inttes xaafidayssa istti inttes ba doonara lo7eththi yootana mala Yuhudanne Sillaase intteko yeddidos. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Hayta inttes koshshiza yo7otappe hara deexo tooho nu intte bolla woththontta mala nuussinne Xillo Ayanas lo7o misati beettides. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Hessika eeqas shukettida ashoppe, suuththafe, bawuti hayqqida mehe ashoppenne laymappe intte haakkana malassa; intte hayta misatizaytappe haakkiko inttes lo7o; saron diite» gees.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Kiitettida asati moyzettidi duge Anxokiya wodhdhida; heen ammanizayta wursi shiishshidi ehida dabdaabeza isttas immida. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Dereykka nababidi minththeththiza qaalan ufayettides. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yuhudaynne Sillaasi nabeta gidida gishshas daro zoridi ammanizayta minththeththida. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Heen guuththa wode gam7idi ammaniza asay moyziin guye bana kiittidaytakko simmida. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Sillaasi qasse heen attanaas koyides.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 34 bolla diza qofaa gujjettenna.</char></note> <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Phawuloosinne Barnabaasi hara daro asatara gididi Godaa qaalaa tamaarsishenne sabbakishe Anxokiyan gam7ida.<verse eid="ACT 15:35" /></para>
  <para style="s1">Phawuloosanne Barnabaasa Shaaketeth</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Phawuloosi guuththa wode gam7idi Barnabaasa, «Nu kase Godaa qaalaa yootida ubba katamata biidi ammanizayti ay mala dizaakko ane yuuyi beyoos, denda» gides. <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Barnabaasikka Marqoosa geetettiza Yohannisi isttara baana mala koyides. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Phawuloosi qasse iza ekki baanaas koyibeenna; gaasoykka kase Marqoosi isttafe shaakettidi Phinfiliya geetettizason guye attidi isttara oosos sinth kezontta aggida gishshassa.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">Hawa 13:13</ref></char></note> <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Histtiin daro palamay istta giddon medhettida gishshas ba giddon shaaketti wodhdhida; hessa gishshas Barnabaasi Marqoosa ekkidi markaben gelidi Qophiroose bides. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Phawuloosi qasse Sillaase doorides; ammanizaytikka Godaa aadho kiyateththaas Phawuloosa hadara immidaappe guye izi isttafe shaakettidi bides. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Ammanizayta minththeththishe Sooriyaranne Kilqiyara aadhdhi bides.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s1">Ximtoosi Phawuloosaranne Sillaasera Issife Gideth</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Phawuloosi Darbeene geetettizasonne Listtira gakkidi iza aaway Girike as, aayeya qasse Ayhuda as gidida Ximtoosa geetettiza issi ammanizaade heen demmides. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Izikka Listtiraninne Iqoniyoonen ammaniza asaa achchan lo7o markkateththi dizaade. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phawuloosikka Ximtoosa banara ekki baanaas koyides; hessa gishshas he heeran Ayhudata gishshas giidi Ximtoosa qaxxarides; gaasoykka Ayhudati Ximtoosa aaway Girike as gididayssa eriza gishshassa.<verse eid="ACT 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 16:4" />Istti issi katamappe hara katama aadhdhi aadhdhi bishe Hawaaretinne Yerusalaame Woosa Keeththa cimati yeddida kiitaa asay ekkidi naagana mala ammaniza asaas immi immi aadhdhida. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Woosa keeththa asay ammanon minni minni bides; qasse asaykka qoodan gallas gallas gujetti gujetti bides.<verse eid="ACT 16:5" /></para>
  <para style="s1">Phawuloosi Maqidooniya Gishshas Be7ida Ajjuuta</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Phawuloosinne izara diza zatati qaalaa Iisiyan sabbakontta mala Xillo Ayanay diggida gishshas Pirgiyaranne Galatiya derera aadhdhi bida. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Istti Miisiya geetettizaso gakkana matishe Bitiniya geetettizaso gelana qoppiin Yesusa Ayanay istta diggides. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Hessa gishshas Misiyara aadhdhidi Xiro7aada geetettizaso wodhdhida. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Issi Maqidooniya asi eqqidi Phawuloosa Maqidooniya pinnada nuna maadda gishin Phawuloosi omars ajjuutan be7ides. <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Izikka he ajjuutaa beyiin nuni heerakka Maqidooniya baana koyidos; Xoossi nuni isttas Mishiraachcho qaalaa yootana mala xeygides gi qoppida gishshassa.<verse eid="ACT 16:10" /></para>
  <para style="s1">Liidiya Ammano</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Markabera Xiro7aada geetettizasoppe dendidi sitti giidi Samotiraaqe geetettizaso bidos; wonteththa gallas Naaphule geetettizaso sinth hemeth gujjidos. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Heeppeka Oroome asay tooran haarida dere gidida Maqidooniya dere waanna katama gidida Piliphisiyoose geetettizaso gelidos; heenkka undenna wode uttidos.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Sambata gallas woosa woossizaso koyishe katamaa gelizaso penge kezidi duge shaafa wodhdhoos; nu heen uttidi shiiqi diza maccassatas qaalaa yootidos. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Qaala lo7eththi siyiza maccassatappe issi Liidiya geetettizaara izakka Xoos goynnizaaronne Tiyaxiroone katamaappe yaada zo7o Haare may7o zal7izaaro Phawuloosi yootiza qaalaa iza wozinan woththa siyana mala Goday izi wozina doydes. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Izanne iziso asaykka xammaqettidaappe guye, «Tani Xoos ammanidayssa intte tumu eridaa gidikko haa taso yiidi guuththa wode diishshite» gaada istta minththa woossadus.<verse eid="ACT 16:15" /></para>
  <para style="s1">Phawuloosinne Sillaasi Qasho Keeththan</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Issi gallas nu woosaso bishin kaayo kayotta marotiza issi garade naa dizaara nuna demmadus; izakka ba maroteththaan bana ayssizaytas daro miish gelththawus. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Hanna garade naya Phawuloosanne nuna kaalla kaalla, «Hayti asati inttes intte attana oge yootizayti wogga Xoossa oosanchchata» ga ga waassadus. <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Hessaka daro gallas shira shira gadus; gido attiin Phawuloosi izi qaalaan daro metotida gishshas izikko simmidi izi doonara haasayza tuna ayanaza, «Ne izippe kezana mala ta nena Godaa Yesus Kirstoosa sunththan azazays» gides. He ayanay heerakka yeggi izippe kezides.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Izo ayssiza asati isttas miishshe demmiza ogey duuxxiin istta hidotay qanxxettidayssi isttas geliin Phawuloosanne Sillaase oykkidi biittara goochchidi waannati dizaso giya giddo efida. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Dere ayssiza waannatakko shiishshidi, «Hayti asati baas Ayhuda as gidi uttidi nu katamaa bul7akeettes; <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />qasse nu Oroome asati ekkanaas woykko ooththanaas nuus bessontta woga nu asaa giddon laalleettes» gida.<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Dereykka issi bolla gididi Phawuloosa bollanne Sillaase bolla dendides; deraa ayssizayti Phawuloosantta may7o qaari ekkidi durqqara qoxxana mala azazida. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Iita buka bukkidi qasho keeththan yeggida; qasho keeththaa naagizayssika istta lo7eththi naagana mala azazida. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Izikka hessa mala mino azazo ekkidi qasho keeththaas waanna giddo kifile gelththidi istta toho gita durumara shiishshi qachchides.<figure style="fig" alt="Paul and Silas in stocks" file="LB00337B.TIF" size="span" ref="16:24">Phawuloosa tohotinne Sillaase tohoti duruma giddon waaxetti dishin</figure><verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Giddi giddoth gidishin Phawuloosinne Sillaasi woosaninne mazamuren Xoossaa galatishin qasho asay istta yeththaanne galataa ezgi siyides. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Hassa7ay baynda dingate qasho keeththaa xaphoppe qaaththiza mino biitta qaaththi hanides; heerakka qasho keeththaa pengeti doyettida; qashettida ubba asaa qashoy birshettides. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Qasho keeththaa naagizayssi dhiskofe beeggidi qasho keeththaa pengeti doya dizayssa be7idi qasho asay wuri kessi ekkida misatiin bana wodhana mashsha shoddides. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Phawuloosi qasse ba qaalaa dhoqqu histtidi, «Nu wuri haan doos! Ne bolla ayne iita ooththofa» gi waassides.<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Qasho keeththaa naagizayssi xomppe woossi ekkidi giddo guppi gelides; kokkorishe Phawuloosa toho bollanne Sillaase toho bolla kundides. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Istta ekki kare kezidi, «Ha asatoo! Ta attana mala ay ooththoo?» gides.<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Isttika izas, «Godaa Yesusa ammana; nekka neso asaykka intte wuri attana» gida. <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Hessafe guye izassinne izason diza asaas ubbaas Godaa qaalaa yootida. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Qasho keeththaa naagizayssi heerakka he gallas qammara efidi istta madunththaa meeccides; heerakka izinne izaso asay wuri xammaqettida. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Qasho keeththaa naagizayssika istta ba keeththe efidi isttas kath aaththides; baso asaa ubbaara Xoossaa ammanida gishshas addezi daro ufayides.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Gadey wontishin dere ayssizayti, «Heyta asata birsha yedda» giidi ba shuumeta qasho keeththaa naagizayssako yeddida. <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Qasho keeththaa naagizayssika isttas, «Dere ayssizayti intte birshettana mala azazida; hessa gishshas ha7i saron kezi biite» giidi Phawuloosas yootides. <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Phawuloosi qasse, «Nu Oroome yeleteth gidishin pirday baynda dere sinththan durqqara bukkidi qasho keeththan yeggida; histtiin ha7i qasse nuna qotara asi erontta kessana koyizoo? Hessi hanenna; istti yiidi barkka birshetto!» gides.<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Shuumeti he izi gida qaalaa dere ayssizaytas yootida; isttika Phawuloosinne Sillaasi Oroome yeleta gididayssa siyidi dagammida. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Yiidi isttafe maareteth oychchidi woyneppe kessida; istti he katamayo aggidi haraso baana mala istta woossida.<verse eid="ACT 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40" />Phawuloosinne Sillaasi qasho keeththaafe kezidi Liidiyaso bida; heenkka diza ammanizayti istta keehi minththeththidi heeppe kezi bida.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">Tasolonqen Phawuloosanne Sillaase</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Phawuloosinne Sillaasi Anfiphoolanne Apholooniya geetettiza derera aadhdhidi Tasolonqe geetettiza dere bida; heenkka Ayhudata Woosa Keeththi dees. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Phawuloosikka izas lose gidida mala Ayhudata Woosa Keeth gelides; heedzdzu saamintta kumeth qaalappe ekki ekki isttara haasayettides. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Kirstoosi waaye ekkanaassinne hayqqi dendanaas bessizayssa qonccisi ammanththon, «Hayssi ta sabbakiza Yesusi izi kiitetti yaana geetettidayssako!» gides. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Ayhudatappe issi issi asay ba siyidayssa ammanidi Phawuloosaranne Sillaasera issife gidides; qasseka daro derey Xoossas yayyiza Giriketappe daro erettida maccassati ba siyida qaalaan ammanidi isttara issino gidida.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Ayhudati qasse istta qanaatidi giyan diza wordo asata shiishshidi kumeththa dereza istta bolla denththeththidi katamaan shiro medhdhida. Phawuloosanne Sillaase shiishshidi deraa sinththan essanaas issi Iyaasoone geetettizayssaso koyanaas eleli bida. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Gido attiin istta Iyaasoone keeththan demmontta aggida gishshas Iyaasoonenne hara ammaniza asata katama daannata sinththara goochchishe, «Hayti asati dere wursi bul7akishe gam7idi qasse ha7i haa yida. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Iyaasooneykka istta ba keeththan woththides; hayti asati wuri, ‹Yesusa geetettiza hara kawoy dees› giidi Qeesaare woga ekkettenna» gishe waassida. <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Dereynne he katamaa daannati hessa siyidi ba giddon buqettida. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Iyaasoonenne haratakka waase xeygisidi yeddida.<verse eid="ACT 17:9" /></para>
  <para style="s1">Beeriyan Phawuloosanne Sillaase</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Ammanizayti heerakka Phawuloosanne Sillaase qammara Beeriya yeddida; isttika hee gakkida mala Ayhudata Woosa Keeththe gelida. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Beeriya asay Tasolonqe asaappe aadhdhidi akeekara diza asa. Gaasoykka hayssi yo7ozi tumeesha? gi giidi Geeshsha Maxaafata qaalaa wontiin wontiin pilggi xeellidi ufayssan ekkides. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Hessa gishshas isttafe daro asay ammanides; qasseka isttara qoodan daroti bonchchettida Girike dere maccassatinne addetikka ammanida.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />Tasolonqen diza Ayhuda asati Phawuloosi Xoossa qaalaa Beeriyankka sabbakizayssa erida mala dereza denththeththanaas qasseka isttako bida. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />He wode ammanizayti Phawuloosa ellesidi gede abba achchi yeddida; Sillaasinne Ximtoosi heen attida. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Phawuloosa moyzida asati iza Ateena gaththida; qasseka Sillaasinne Ximtoosi izakko eleli gakkana mala giza kiita Phawuloosappe ekkidi simmida.<verse eid="ACT 17:15" /></para>
  <para style="s1">Ateenan Phawuloosa</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Phawuloosi Ateenan istta naagishin Ateena kataman eeqati kumidayssa be7idi daro shenetides. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Hessa gishshas Ayhudata Woosa Keeththan Ayhudataranne Xoossas yayyiza Girike asaara qasseka giyay dizason gallas gallas banara gaaggiza asaara haasayettides. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Efiqoroosenne Isttoyko geetettiza eranchchata bagga gididayti Phawuloosakko shiiqidi izara haasayettida; isttafe issi issi asati, «Hayssi lom7ulom7ay ay gaana koyzee?» gida; baggayti qasse Yesusa gishshassinne hayqoppe iza denththaa mishiraachcho izi sabbakishin siyidi, «Hessi hara ooraththa eeqata gishshas yootiza misatees» gida.<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />Iza oykkidi Ariyosfaagoose geetettiza dere duulata sinth efidi, «Ha ne tamaarsiza ooraththa timirtey aazakko nu erana mala ne koyay?» gida.<figure style="fig" alt="Areopagus" file="HK00355B.TIF" size="span" ref="17:16">Ariyosfaagoose</figure> <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Qasse ne nuna nu hayththan sissiza yo7oy nu erontta oorath gidida gishshas izi aazakko nu erana koyoos. <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Ateena asay kumeth qasseka haan diza hara dere asaykka baas wode aaththanaas ooraththa yo7o haasayaninne sissan attiin hara miishshan wode aaththettenna.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Hessa gishshas Phawuloosi Ariyosfaagoose geetettiza duulatan shiiqida dereza sinththan eqqidi, «Hayto Ateena asatoo! Intte beettoo miish ubbaa ammanizayta gididayssa ta beyays. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Ta yaanne haa yuuyishin intte isttas goynniza miishshata ta xeellishin, ‹Erettontta Xoos› geetetti xaafettidayssa issi yarshosoho demmadis; hessa gishshas hessa intte erontta goynnizayssa ta inttena erisana. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Hayssa alamezanne iza giddonkka dizayssa ubbaa medhdhida Xoossi izi salonne sa7a Godaa; hessa gishshas izi asa kushen keexettida keeththan deenna. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Izi as ubbaas de7onne shempo; qasseka hara wursi immizayssa gidida gishshas izas paccizaazi baynda gishshas izi asa kusheppe maado ekkenna. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Asa zereth ubbaa issaadefe medhdhidi asi biitta bolla daana mala ooththides; asay daana wodenne wurseththa dhas woththides. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Hessika asi Xoos koyidinne pilggidi demmanaakko giidi woththides; hessi hessa gidikkoka izi nuuppe issi issaadefe haakki diza gishshas gidenna. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Nu de7o demmiday, dizaynne qaaxettizay izanna; intte deren yeth kessiza issi issi asati, ‹Nunikka iza nayta› gida mala.<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />«Histtiko nu Xoossa nayta gidikko Xoossi as erateththan medhdhi kessida worqqa woykko bira woykko shuch misatees giidi nu qoppanaas bessenna. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Kasetidi Xoossi hayssa mala hanota asay erontta ooththidayssa dandayan aadhdhides; ha7i gidikko asi wuri ba dizason dizason maaroteththan gelana mala azazees» gides. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Izi ba dosidaade baggara biitta bolla xilloteththan pirdana gallas bare woththides. Izakka hayqoppe denththidi as ubbaas hayssa tumateththa erisides.<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Isttika hayqqidayta denththaa gishshas siyida mala issi issi asati iza qidhida; baggayti qasse, «Hayssa qasseka nu neeppe hara gallas siyana koyoos» gida. <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Heerakka Phawuloosi istta giddofe kezi bides. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Issi issi asati qasse Phawuloosa kaallidanne ammanida; heytappeka Diyonassiyoosa geetettiza Ariyosfaagoose duulata keeththa Abaale gidida Deemarso geetettiza maccassayanne haratikka issife deettes.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">Qorontoosen Phawuloosa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Hessafe guye Phawuloosi Ateenappe dendidi Qorontoose katama bides. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Heenkka Phanxoosan yelettida Aqila geetettiza Ayhuda as demmides; izikka Ayhudati wuri Oroomeppe kezana mala Qalawodoosa geetettiza Oroome kawoy azazida mala ba machcheyo Phirsiqillara mata wode Ixaaliya dereppe yidayssa beyanaas Phawuloosi hee isttako bides. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Izikka isttaththo dunkaane sikkizaade gidida gishshas istta achchan uttidi dunkaane sikon gelides. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Sambata Sambata gallas Ayhudata Woosa Keeththan Ayhudataranne Girike asatara haasayettishe istta ammanththanaas baaxetides.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Sillaasinne Ximtoosi Maqidooniyappe duge izakko wodhdhiin Phawuloosi sabbakon minnidi Yesusi izi Kirstoosa gididayssa Ayhudatas markkattides. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Gido attiin istti izara eqettidi iza cayida gishshas Phawuloosi ba may7o qoqofidi, «Ta inttefe xillo; intte pirdettanay intte mooron gidida gishshas ta intte suuththa gomen oyshettike; hessa gishshas ta Ayzaabetakko bays» gides.<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />Heeppe kezidi Titoosa Iyosxoosa geetettiza Xoos woossizayssaso bides; he addeza keeththay Ayhudata Woosa Keeththa achchan dees. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Ayhudata Woosa Keeththa halaqay Qerisphoosi baso asa ubbaara Godaa ammanides; Phawuloosi yootishin siyida daro Qorontoose katama asay ammanidi xammaqettides.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Goday qammaara ajjuutan Phawuloosa, «Babbofa; yoota; co7u gooppa; <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />ta nenara days; oonikka ne bolla dendi nena qohanaas dandayenna; hanno ha katamayn taas daro asi dees» gides.<verse eid="ACT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 18:11" />Hessa gishshas Phawuloosi Xoossa qaala asaa tamaarsishe issi layththinne bagga isttara uttides.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Galyoosa geetettiza dere ayssizayssi Akayan diza wode Ayhudati issife gididi Phawuloosa bolla dendida; pirda wombora sinth shiishshidi, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />«Hayssi addezi wogappe karera asay Xoossas goynnana mala asaa baleththees» gida.<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Phawuloosi haasayana buro doona doyshin Galyoosi Ayhudata, «Intteno Ayhuda asatoo! Intte shiishshida yo7oy dere denththeththo woykko dere gita meton yeggiza yo7o gididaakko ta wozinappe siyanashin. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Gido attiin intte palamay issi issi qaalata gishshassinne issi issi sunththata gishshas qasseka intte woga gishshas gidida gishshas intte heen intte baggara wursite; ta hessa mala yo7o pirdanaas koykke» gides. <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Hessa gishshas pirda wombora sinththafe istta kessides. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />He wode wurikka Ayhuda Woosa Keeththa halaqa Sostineese geetettizayssa oykkidi pirda keeththaa sinththan bukkida; Galyoosi gidikko hessa wudankka yeggibeenna.<verse eid="ACT 18:17" /></para>
  <para style="s1">Phirsiqilla, Aqilanne Aphiloosa</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Hessafe guye Phawuloosi Qorontoose kataman daro wode gam7ides; heeppeka ammaniza asay moyziin Phirsiqillaranne Aqilara issife markaben gelidi Sooriya geetettizaso bides; adina<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="fqa" closed="false">Adina: </char><char style="ft" closed="false">Adina gizayssa issi issi bagga Gamoththo qaalan, «Tasala woykko galatas imettiza imota» geettes.</char></note> gaththanaas Kinkira7oose geetettizason ba hu7e meedettides.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">Tay 6:18</ref></char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Efesoone gakkida mala Phirsiqillanne Aqila heen aggidi Phawuloosi Ayhudata Woosa Keeththe gelidi Ayhudatara haasayettides. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Banara gam7ana mala istti oychchiin izi, «Akkay» giidi ixxides. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Gido attiin izi isttafe shaakettishe, «Xoossa shene gidikko ta simmada yaana» gides; Efesooneppe dendidi markaben gelidi bides.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Qisaariya geetettizaso gakkidaappe guye kezidi ammanizayta saro giidi heeppe Anxokiya wodhdhides. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Anxokiyan guuththa wode takkidaappe guye heeppe dendidi Galatiya baggaranne Pirgiya geetettiza deretara yuuyi aadhdhidi ammanizayta minththeththides.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />He wode issi Iskindiriya kataman yelettida Aphiloosa geetettiza issi Ayhuda asi Efesoone yides; izikka tamaardaadenne Geeshsha Maxaafata lo7eththi erizaade. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Izi Godaa oge tamaardaadenne Yesusa gishshas balay baynda haasayzaadenne Xillo Ayanan xuugettishe tamaarsizaade; gido attiin izi lo7eththi erizay Yohannisa xinqata xalala. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Izikka Ayhuda Woosa Keeththan babbontta yooto oykkides; Phirsiqillaynne Aqilay izi gizayssa siyidi iza baso efidi Xoossa oge iza kaseppe lo7eththi erisida.<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />Aphiloosi Akaya baanaas koyiin ammanizayti iza minththeththida; heen diza ammaniza asaykka iza mokki ekkana mala izas dabdaabe xaafida; izi hee gakkida mala izas diza imotaappe dendidayssan ammanizayta daro maaddizaade gidides. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Geeshsha Maxaafata yayssa hayssara gaththi markkasi markkasi Yesusi izi Kirstoosa gididayssa Ayhudatara daro palamettidi dere sinththan istta laththides.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">Efesoonen Phawuloosa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Aphiloosi Qorontoosen diza wode Phawuloosi pudeha bagga derera kanththidi Efesoone yiidi heen diza issi issi ammaniza asata demmidi, <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />«Intte ammanida wode Xillo Ayana ekkidetii?» gides; isttika «Ekkibeekko haray attoshin Xillo Ayanay dizaakko nu siyibeekko» gida.<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Phawuloosikka istta, «Histtiin intte aazan xammaqettidetii?» gides; isttika izas, «Yohannisa xinqatan xammaqettidos» gida.<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Phawuloosikka isttas, «Yohannisa xinqatay gidikko asay maaroteththan simmidayssa bessiza xinqatakko! Yohannisi ba baggara asay izappe guyera yiza Yesusa ammanana mala yootides» gides.<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mato 3:11</ref>; <ref loc="MRK 1:4">Mar 1:4</ref>,<ref loc="MRK 1:7">7</ref>,<ref loc="MRK 1:8">8</ref>; <ref loc="LUK 3:4">Luqa 3:4</ref>,<ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26-27">Yoha 1:26-27</ref></char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Isttika hessa siyidaappe guye Godaa Yesusa sunththan xammaqettida. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Phawuloosikka istta bolla ba kushe woththida mala Xillo Ayanay istta bolla wodhdhiin istti dumma dereta qaalara haasayda; tinbitekka yootida. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />He asati wurikka tammanne nam7u gidizayta.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Phawuloosi Ayhudata Woosa Keeththe gelidi Xoossa Kawoteththaa gishshas haasayettishenne istta ammanththishe heedzdzu agina kumeth oonaska babbontta asaas qonccisi yootides. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Issi issi asay palama xin7i giidi ammananaas koyibeenna; Godaa oge qonccen ixxida; hessa gishshas Phawuloosi istta aggidi haraso bides; ammanizaytakka dumma shaakki kessidi Xiranoose timirte keeththan gallas gallas isttara haasayettides. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Hessa mala ooson nam7u layth gam7ida gishshas Iisiya awuraajjan diza Ayhudatinne Girike asay wuri Godaa qaala siyana dandaydes.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Xoossi Phawuloosa baggara daro malalisiza malaata ooththides. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Maarabe woykko iza asateth bochchida carqqa efidi harganchchata bochchiko hargey yeddees; tuna ayanatikka ba oykkida asappe kezeettes. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Yuuyi yuuyi asappe daydanth kessiza issi issi Ayhuda asati, «Phawuloosi sabbakiza Yesusa sunththan intte kezana mala azazays» giidi Godaa sunth tuna ayanati oykkida asata bolla xeygana paaccida. <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Issi Ayhudatappe gidida qeeseta halaqa Asqewes attuma naa laappunati hessaththo ooththida.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />Tuna ayanaykka, «Ta Yesusakka erays; Phawuloosakka erays shin intte qasse oonanttee?» gides.<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Qasseka tuna ayanay iza oykkidaadey guppidi asata oykkides; istta bolla wolqqatidi daro minniin madunxidi keeththafe mela kallo baqatida. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Hessika Efesoonen diza Ayhudata achchaninne Girike asa ubbaa achchan erettiin wurikka babbida; hessankka Godaa Yesusa sunththi bonchchettides. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Ammanida asaappe daroy shiiqidi ba iita ooso qonccen paaxides. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Maro marotizaytappe daroti ba marotiza maxaafaa shiishshidi dere sinththan taman xuuggida; maxaafaa waagay shiishshi qoodiin ichchashu tammu shii bira mala gidides. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Hayssa malan Godaa qaalay keehi diccishenne xooni xooni bides.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Hayssi wuri handaappe guye Phawuloosi Maqidooniyaranne Akaya baggara aadhdhidi Yerusalaame baanaas qofa qachchidi, «Ta hee gakkidaappe guye ta Oroome qasseka beyana koshshees» gides. <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Bana maaddizaytappe nam7ata Ximtoosanne Erisxoosa gede Maqidooniya geetettizaso kiittidi baas Iisiya awuraajjan guuththa wode heen de7ides.<verse eid="ACT 19:22" /></para>
  <para style="s1">Efesoonen Dendida Shiro</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />He wode Godaa oge gishshas daro shiroy medhettides. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Dimexiroosa geetettiza issi bira qoxxizayssi Arxemise geetettiza eeqa misle birappe seerisi medhdhi medhdhi hiillanchchatas wodhe miishshe demisees. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Izikka he hiillanchchatan hessa mala ooson aqiza hara asata issi bolla shiishshidi, «Asoo! Hayssi oosozi nuus miish kessizayssa intte ereeta. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Hayssi Phawuloosa geetettizayssi Efesoonen xalla gidontta kumeththa Iisiya awuraajjan diza daro dereza ammanththi ammanththi baleththizayssa intte wurikka be7izayssa malanne siyizayssa mala, ‹Asa kushen oosettida eeqati mulekka Xoos gidettenna› gi yootees. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Hayssa nu oosozas lo7o sunththaa hirayssizayssafe bollara kumeththa Iisiyaynne kumeththa alamey goynniza wogga Arxemise eeqa keeththayka go7ay bayndayssa gidana; qasseka keehi dhoqqu gida izi bonchchoyka kawuyana» gides.<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Asay hessa siyidi iita hanqo hanqettidi, «Efesoone Arxemisa wogga gita!» giidi waaso doommides.<figure style="fig" alt="Goddess Diana or Artemis of the Ephesians" file="HK00286B.TIF" size="span" ref="19:28">Arxemiso geetettiza Efesoone eeqa xoos</figure> <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Heerakka kumeththa katamay shirotides; dereykka wuri issi bolla gididi Maqidooniya asa gididaytanne Phawuloosara issife yuuyiza iza laggeta Gayiyoosanne Arisxirokoosa oykkidi derey kase kaa7izaso woththan gelida. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Phawuloosikka kare kezidi asaa sinth shiiqana koyiin ammanizayti diggida. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />He awuraajja daannatappe issi issi Phawuloosa laggeti Phawuloosi asay kase kaa7izaso xalidi gelontta mala as kiittidi woossida.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />Shiiqida asay un7ettidi issaadey issi miish haasayshin haray qasse hara haasayeessinne asay wuri waassees; dariza bagga asay aazas heen shiiqidaakko erenna. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Ayhuda asay Iskindiroosa geetettizayssa deraa giddofe sugereththi sinth kessida wode issi issi asati ba gishshas izi haasayana mala waassida; izikka istta gishshas palamettana koyidi asay co7u gaana mala malati bessides. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Gido attiin izi Ayhuda as gididayssa erida wode wurikka issi bolla, «Efesoone Arxemisa wogga gita!» gishe nam7u saate mala asay waassides.<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />He katamaas waanna xaafey asaa co7u histtidi, «Intteno Efesoone asatoo! Gita Arxemisi eeqa keeththayonne saloppe wodhdhida izi misle naagizay Efesoone katama as gididayssa eronttay oonee? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Hessa gishshas hayssi ha tumay kaddettana dandayettonttayssa mala intte guuth yuushshi qoppanaassinne loddu gaanaas bessees. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Hayta asata Xoossa Keeththa bonqqontta woykko nu xoos gididayssa bolla cashsha qaala denththontta dishin intte oykkidi haa gaththanaas coo ehideta.<verse eid="ACT 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 19:38" />«Hessa gishshas Dimoxiroossinne izara diza bira seerisi ooththiza hiillanchchati oona bollaka mootiza yo7oy diikko pirda keeththay isttas doya dees; daannatikka deettes; ba koyidaade mootanaas dandayees. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Hayssafe hara gaanaas intte koykko wogay diza shiiqoson beyetto. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Hessi attiko hach hanida shiroy nuna mootisontta mala hirgisees; mootos gaththiza gaasoykka baynda gishshas ha hanida shiroza gishshas nu oyshettiko gaanaazi nuus deenna» gides. <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Izi hessa gidaappe guye shiiqoy laalettides.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">Phawuloosi Maqidooniyanne Girike Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Asay co7u gidaappe guye Phawuloosi ammanizayta issi bolla xeygidi istta minththeththiza qaalara zoridaappe guye istta sarokkidi Maqidooniya baana kezides. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Izi aadhdhi biza deren diza ammaniza asaa lo7eththi zoren minththeththishe Girike dere bides. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Giriken heedzdzu agina takkidaappe guye markabera Sooriya geetettiza dere baanaas qoppides shin Ayhuda asati iza bolla iita miish ooththana zorettidayssa eridi Maqidooniya baggara baana qofa qachchides.<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />Beeriyappe Phariyoosa naa Sophaxiroosi, Tasolonqefe Arisxirokoosinne Sikondoosi, Darbeeneppe Gayiyoosinne Ximtoosi, Iisiyappe Xirofimoosinne Tiqiqoosi Phawuloosara issife bida. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Heyti wuri nuuppe kasetidi Xiro7aadan nuna naagida. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Nu qasse ukeththa ba7aaleppe guye Piliphisiyooseppe markaben istti dizaso Xiro7aada geetettizaso ichchashanththa gallas gakkidi heen laappun gallas gam7idos.<verse eid="ACT 20:6" /></para>
  <para style="s1">Phawuloosi Wurseththan Xiro7aada Buus</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Saaminttafe koyro wogga gallas issife kath maanaas nu shiiqi dishin Phawuloosi wonto baanaas koshshiza gishshas shiiqida asaas qaala yootishin izi yo7oza leela giddoth gakkanaas adussides.<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">«Saaminttafe koyro gallassan» qeera omars woggay wonttanawu guussa.</char></note> <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Bolla fooqen daro poo7oy dizason nu shiiqidos. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Awuxekise geetettiza issi naateththa nay maskoote bolla utti dishin Phawuloosi yo7oza adussidayssafe dendidayssan iza dhiskoy ekki bides; wolqqama dhiskon xoonettidi bolla heedzdzanththo fooqeppe duge kundiin asay denththiza wode hayqqi beettides. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Gido attiin Phawuloosi duge wodhdhidi naaza bolla hokki idimmidi, «Hayqqibeenna paxa dees, dagammofte!» gides. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Phawuloosi hessafe pude fooqe kezidi ukeththaa menththidi ammanizaytara mides; gadey wonttana gakkanaas asatara haasayettishe gam7i bides. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Asaykka hayqoppe paxida naaza izaso efidi wurikka ufayettides.<verse eid="ACT 20:12" /></para>
  <para style="s1">Phawuloosi Xiro7aadafe Milixine Geetettizaso Buus</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Nuni Phawuloosa Markaben gelththana koyida gishshas kasetidi markaben Asosa geetettizaso bidos; nu hessa ooththiday Phawuloosi Asosa gakkanaas tohora baana koyida gishshassinne nu sinth baana mala izi azazida gishshassa. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Nu izara Asosan gaaggidi izi markaben geliin izara issife Mixiline bidos. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Wonteththa gallas heeppe dendidi sinththara diza Ki7oose geetettizaso gakkidos; qasse wonteththa gallas Saamoose geetettizaso pinnidi heeppe wonteththa gallas Miliixe gakkidos. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Phenxeqoste geetettiza Ayhudata Paaziga ba7aale baas dandayettida mala bonchchana Yerusalaamen beettana koyidi izi Iisiyan wodey aadhdhontta dishin Efesoone aadhdhi baanaas koyides. Izi hessaththo ooththana koyiday Phenxeqoste ba7aales Yerusalaamen beettanaas koyida gishshassa.<verse eid="ACT 20:16" /></para>
  <para style="s1">Phawuloosi Efesoone Woosa Keeththa Cimatara Wurseththa Moyzo Saroka Saroketeth</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Phawuloosi Miliixeppe Efesoone Woosa Keeththa cimata ase kiittidi xeygisides. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Isttika yiin Phawuloosi istta, «Ta Iisiya gelida gallassafe haa simmiin ubba wode ta inttenara waana waana de7idaakko intte ereeta. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ayhudati ta bolla asaa denththidi hilida gaason daro metoy ta bolla gakkikokka tani kumeththa ashketeththaranne afunththara Godaas ooththadis. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Coo dembankka, intteson intteson tani inttena tamaarsashe go7izayssa wursa inttes yootadis attiin inttena go7iza miishshaafe aykkoka ashshabeekke. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Ayhuda asata gidiinkka Girike asaa gidiinkka maaroteththan gelidi Xoossaako simmana malanne Godaa Yesusan ammanana mala lo7eththa yootadis.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />«Ha7ikka ta hee gakkishin ta bolla aazi gakkanaakko erikke shin Xillo Ayanay tana azazida mala Yerusalaame bays. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Heen tana dumma dumma qashoynne metoy naagizayssa Xillo Ayanay taas yootides. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Gido attiin Godaa Yesusi taas immida woththaa woxxa wursana gakkanaassinne oosoza ta polana gakkanaas tani ta shemppos mishettike; taas imettida oosoykka Xoossaa mishiraachcho qaalaa yootokko.<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2Xim 4:7</ref></char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />«Ha7i gakkanaas ta intte giddon simerettashe Xoossa kawoteth sabbakadis; hayssafe guye inttefe oonikka mule ta ayfeso be7onttayssa ta erays. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Hessa gishshas inttefe issaadeyka dhaykko ta oyshettonttayssa hach ta inttena erisays. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Ays giikko ta Xoossa qofaa wursa inttes yootadis attiin aykkoka ta yootontta ashshiday deenna. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Xillo Ayanay inttena Xoossa dorsata heemmanaas shuumides; hessa gishshas intte hu7essinne Xoossa dorsatas naagettite; Goday ba suuththan wozzida Woosa Keeththayo naagite. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ta bidaappe guye Xoossa dorsatas mishettontta iita asati intte gars gelanayssa ta erays. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Hessaththoka issi issi asati intte giddofe dendidi geella yo7o inttena tamaarsidi ammaniza asaappe darota gede baakko zaarana. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Hessa gishshas inttena issaa issaa heedzdzu layth qammanne gallas afunththan zoridayssa yuushshi qopitenne naagettite.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />«Ha7ikka inttena Xoossas minththi essanaassinne ammanizayta giddon inttes laataso immanaas dandayza iza aadho kiyateththa qaalaas ta hadara immadis. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ta oona biraakka worqqaka woykko may7o ammotabeekke. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Tani ta kushen ooththa ooththada taas maadettada tanara dizaytakka maaddidayssa intteka ereeta. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />‹Haa ekkizaadefe gede immizaadey anjjettidaade› giza Godaa Yesusa qaalaa nu yuushshi qoppidi nurkka nu kushera nu ooththi demmidi hara daaburanchchata gede maaddanaas nuus bessizayssa ta inttena daro dumma dumma ogera bessadis» gides.<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Hessafe guye Phawuloosi ubba asaara gulbatidi woossides. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Asay wuri yeekkishe Phawuloosa idimmi oykkidi yeerides. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Harappeka istti daro mishettiday izi, «Hayssafe guye intte nam7anththo tana beyekketa» gida gishshassa; heeppeka iza markabekko gakkanaas moyzida.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">Phawuloosi Yerusalaame Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Nu isttafe shaakettidinne markaben gelidi sitti giidi Qoose geetettiza abbaa giddon diza dere bidos; wonteththa gallas hara Erodoose geetettiza abba giddon diza dere gakkidos; heeppeka issi Phaxira geetettiza katama bidos. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Heen Pinqe geetettizaso biza markabe dizaaro demmidi izin gelidi bidos. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Abba giddon diza Qophiroose geetettiza dere hadirsa baggan yeggidi Sooriya geetettiza dere biidi Xiroose geetettiza abba achchan diza dere bidos; hessas gaasoykka markabeya ba caanettida caana heen woththanaas koshshiza gishshassa. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Heen ammanizayta koyi demmidi isttara laappun gallas gam7idos; isttika Xillo Ayana kaaleththon Phawuloosa, «Yerusalaame booppa» giidi yootida. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Nu heen gam7ana wodey wuriin isttafe shaakettidi nu oge bidos; istti wuri ba machchetaranne ba naytara issife katamaappe kare kezana gakkanaas nuna moyzida; abba achchan nu wuri gulbatidi woossidaappe guye dendidi issoy issaara sarokettidi shaakettidos. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Hessafe guye nu markaben geliin istti baso simmida.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Nu Xirooseppe dendidi gede Phixilamayse geetettizaso gakkidos; heenkka ammaniza asaara gaaggi sarokettidi heen istta achchan issi gallas gam7idos. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Wonteththa gallas heeppe kezidi Qisaariya geetettizaso bidos; Qisaariyan laappun daaqonetappe issaa wongelaawe Piliphoosaso gelidi iza achchan shempidos.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">Hawa 6:5</ref>; <ref loc="ACT 8:5">8:5</ref></char></note> <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Izas nabe gidida oyddu gelontta geela7oti deettes.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />Daro gallas nu heen gam7iin issi Agaboosa geetettiza nabezi Yuhuda dereppe yides. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />He nabey nuukko shiiqidi Phawuloosa dancco ekkidi ba tohonne ba kushe qachchidi, «Xillo Ayanay hayssa danccaa godaa Yerusalaamen diza Ayhuda asati hayssaththo qachchidi Ayzaabetas aaththi immana gees» gides.<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Hessa siyidi nunikka nunara diza asaykka Phawuloosi Yerusalaame bontta mala woossidos. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Qasse Phawuloosi, «Intte ays yeekki yeekkidi ta wozina aazas menththeetii? Tani Godaa Yesusa sunththaa gishshas Yerusalaamen qasho xalala gidontta hayqqanaaska giigettadis» gides.<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Izi nu zore ekkontta ixxiin, «Histtiko Godaa sheney hano» giidi aggaagidos.<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Nu heen guuththa gallassata gam7idaappe guye nu miishshe ubbaa giigsi ekkidi Yerusalaame bidos. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Qisaariyan diza issi issi ammanizayti nunara issife yida; isttika nuni Minasoone keeththan daana mala nuna izaso kaaleththida; Minasooni kasetidi ammanida Qophiroose dere asa.<verse eid="ACT 21:16" /></para>
  <para style="s1">Phawuloosi Yerusalaamen Yaaqoobe Beyides</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Nu Yerusalaame gakkida mala ammanizayti nuna ufayssan mokki ekkida. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Wonteththa gallas Phawuloosi nunara Yaaqoobekko bides; he wode Woosa Keeththa cimati heen deettes. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Phawuloosi asaa wursi sarokkidaappe guye Xoossi iza baggara Ayzaabeta giddon ooththidayssa ubbaa issino ashshontta yootides.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />Hessa siyidi asay wuri Xoos galatides; Phawuloosikka, «Nu ishazoo daro shiyan qoodettiza ammanizayti Ayhudata giddon dizayssanne wurikka Muse wogaa wozinappe naagizayta gididayssa nekka eraasa. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Neni Ayzaabeta giddon diza Ayhudata, ‹Intte nayta qaxxaropite woykko wogata ooththofte› gaada ne tamaarsida asay Muse wogaa shaarana mala ooththees giza wore asay siyides. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Histtiin ha7i aazee lo7oy? Ha7i ne yuussa asay siyontta aggenna. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Hessa gishshas nu nena gizayssa ooththa; nu achchan tasala gaththana yida oyddu asati deettes.<note caller="-" style="x"><char style="xo" closed="false">21:23-24 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">Tay 6:13-21</ref></char></note> <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Ne istta nenara ekkada isttara gidada nena geeshsha; asati ba hu7e meedettana malanne Xoossa Keeththan imettiza muxuwaata miishshaa ne isttas qanxxa; ne hessaththo ooththiko ne bolla woretidayssi wuri coo hada gididayssanne nekka Muse wogaa pola naagizaade gididayssa asay wuri erana. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Hinko Ayzaabetappe ammanidayta gishshas gidikko, ‹Eeqas shukettidi tunidayssa moopite; suuththika uyopite; bawuta hayqqida mehe asho moopite; laymappe haakkite› giidi cimati qachchida qaalaa dabdaabe xaafidi nu isttas yeddidos.»<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">Hawa 15:29</ref></char></note><verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Hessafe guye Phawuloosi he oyddu asata banara ekkidi wonteththa gallas isttara bana geeshshides; istti geeyza gallassati aappun gallassikonne issaade issaade gishshas imettiza miish immiza wodey aydekko erisanaas Xoossa Keeththe gelides.<verse eid="ACT 21:26" /></para>
  <para style="s1">Xoossa Keeththan Phawuloosa Oyketeth</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Laappun gallas kumana matishin Iisiya dereppe yida Ayhuda asay Phawuloosa Xoossa Keeththan be7idi deraa iza bolla denththeththidi iza oykkida. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />«Isra7eele asatoo! Nuna maaddite! Nu asaanne nu wogaa hayssa nu dizasoza cayishenne derey dizason ubbaan asaa tamaarsizayssi hayssi izakko! Hessika gidenna giidi Ayzaabeta Xoossa Keeth gelththidi hayssa geeshshasohoza tunisides» gishe waassida. <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Istti hessa gida gaasoykka hayssafe kase Efesoone yeleta Xirofimoosa izara issife katama giddon be7ida gishshas iza Phawuloosi Xoossa Keeththe ekki gelida misatida gishshassa.<note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref></char></note><verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Kumeththa katamay ba giddon shirotides; derey wuri issife woxxi koyidi Phawuloosa oykki ekki Xoossa Keeththa gibbefe gooshechchi kessides; Xoossa Keeththa pengeti heerakka gordettida. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Asay Phawuloosa wodhana koyishin, «Yerusalaamen diza kumeththa derey ba giddon shirotides» giza kiitay Oroome wottadarata azazizayssako gakkides. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Hessa gishshas izi wottadaratanne mato halaqata kaaleththidi eeson woxxishe asay dizaso bides; asay olanchchata azazizayssa be7idi Phawuloosa bukaa aggides.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />Mato halaqazi izakko shiiqidi Phawuloosa oykkidi nam7u sansalatan qashettana mala azazidi izi oonakkonne ay ooththidaakko eranaas iza oychchides. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Dereykka ba giddon baggay hessa, baggay hayssa gides; Mato halaqazi dereza waasoppe dendidayssan tumay awayssakonne eranaas dandayettontta ixxiin Phawuloosa gede wottadarati dizaso efana mala azazides. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Phawuloosi pude dhoqqaso gakkishin derey daro hanqon iza bolla meto gaththanaas koyida gishshas wottadarati iza hashen tookki efida. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Dereykka, «Izi hayqqo! Hayqqo» gi waassishe iza kaallides.<verse eid="ACT 21:36" /></para>
  <para style="s1">Phawuloosi Bana Ashshana Maaddiza Yo7o Yootides</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Wottadarati Phawuloosa ba dizaso gelththana matishin Phawuloosi wottadarata azazizayssa, «Ta nees issi miish yootana mala dosay?» gides. Mato halaqazikka, «Ne Girike qaala eray? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Histtiin ha7i mata wode dere giddon meto denththeththada shemppo wodhida oyddu shii asaa ekkada bazzo baqatida Gibxe addezi nena diikkii?» gides.<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Phawuloosikka, «Tani Kilqiya giddon daro erettida Xarseese kataman yelettida Ayhuda asa; hayssa asaas tana yoochcharkkii!» gides.<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Izi haasayana mala ero giin Phawuloosi dhoqqasohon eqqidi asay co7u gaana mala ba kushera malatides; asay co7u giin Isra7eeleta qaalara,<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«Ta ishatoo! Ta aawatoo! Ta bolla wordo woththidayssas ta inttes immiza zaaro siyite!» <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Izi Ayhudata qaalara haasayshin siyidi kaseppe asay co7u gides; Phawuloosikka haasayaa gujjidi,<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />«Tani Kilqiya giddon diza Xarseese kataman yelettida Ayhuda asa; tani dicciday gidikko hannin Yerusalaamena; ta nu aawata wogaa wursa Gamalyaaleppe lo7eththa tamaaradissenne intte hach ooththizayssaththo Xoossas suure wozinappe ooththashe de7adis.<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">Hawa 5:34-39</ref></char></note> <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Hayssa ha ogeza kaalliza asata ubbaa wodhana gakkanaas goodaththiza asakkoshin; maccassatanne addeta qachcha qachcha qasho keeth yeddizaadekoshin. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Hayssi wuri tumu gididayssa qeeseta halaqatinne dere cimatikka wuri taas markkattana; haray attoshin Damasqon diza ammaniza asaa qachcha Yerusalaame ehada qaxxayssanaas Damasqon dizaytas xaafettida dabdaabe qeeseta halaqatappenne dere cimatappe ekkadis.<verse eid="ACT 22:5" /></para>
  <para style="s1">Phawuloosi Kirstoosa Wostti Ammanidaakko Yootides</para>
  <para style="r">(<ref loc="ACT 9:1-19">Hawa 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />«Tani Damasqo bishininne katamaa gelana matishin seeta gallas ta qoppontta dishin saloppe wolqqama poo7oy tana yuuyi aadhdhi poo7ides. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />He wode tani biitta bolla kundada, ‹Sa7oolee! Sa7oolee! Ne tana aazas goodday?› giza qaala siyadis. <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Tanikka, ‹Godoo, ne oonee?› gadis; izikka, ‹Ta neni gooddiza Naazirete Yesusa› gides. <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Tanara issife diza asati poo7oza be7ida attiin izi tanara haasayshin qaalaa siyibeettenna. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Tanikka, ‹Godoo, ta ay ooththoo?› gadis; Godaykka, ‹Dendada Damasqo ba; ne ooththanayssa istti nees heen yootana› gides. <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Poo7oza xolqeteththa daroppe dendidayssan ta xeellanaas dandayabeekke; tanara diza asati ta kushe oykki goochchidi tana Damasqo gaththida.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />«Hanaaniya geetettiza issaadey heen dees; Hanaaniyay Damasqon diza Ayhudata achchan daro galatettidayssanne wogaa bonchchiza asa. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Izi ta ach shiiqi eqqidi, ‹Ta isha Sa7oolee! Ne ayfey qasseka xeello› gides; heerakka ta ayfey iza xeellides. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Izikka tana, ‹Nu aawantta Xoossi ne iza shene erana mala, iza xilloza ne beyana malanne izi gizayssa ne siyana mala nena kaseti doorides. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Izi hessa ooththiday ne be7idayssanne siyidayssa asa ubbaa sinththan izas ne markkattanaassa. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Histtiin ha7i aazas gam7ay? Dendada iza sunth xeygada xammaqetta; ne nagarappeka meecetta› gides. <verse eid="ACT 22:16" /><verse number="17" style="v" sid="ACT 22:17" />Hessafe guye ta Yerusalaame simmada Xoossa keeththan woossishin ajjuutay taas beettides. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Godaykka taas qonccidi, ‹Ne ta gishshas immana markkateth istti ekkontta gishshas ne gam7ontta dashe Yerusalaameppe elela keza!› gides. <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Tanikka izas, ‹Godoo! Ta Ayhudata Woosa Keeththati dizaso baada nena ammanizayta ubbaa qachchada istta bukkidayssa ba baggara isttika ereettes. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Ne gishshas markkattiza Isttifaanose asay wodhiza wode tanikka he wodhiza asata achchan eqqada istti wodhizayssa tanikka dosadissenne wodhizayta may7oka naagadis› gides.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">Hawa 7:58</ref></char></note> <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Godaykka, ‹Haahon diza Ayzaabetakko ta nena kiittiza gishshas dendada ba!› » gides.<verse eid="ACT 22:21" /></para>
  <para style="s1">Phawuloosi Oroome Dere As Gididayssa Qoncciseth</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Asay hinno gakkanaas Phawuloosa haasaya wozinappe lo7eththi siyishe aggidi ba qaala dhoqqu histtidi, «Hayssa mala asi nu biittaafe dhayo; hayssa mala asi nu biittaan shemppora paxa daanaas bessenna» gishe waassides. <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Asay waassishe ba may7o qaari qaari wuxxishenne biittaa pude salo dharccides. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Mato halaqazi hessa be7idi Phawuloosa wottadarati dizaso gelththana mala azazides; dereykka iza bolla aazas hessa mala waassizaakko erana mala iza garafidi paaxisana mala azazides. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Gido attiin dafon waaxi qachchidi iza garafana giigettishin Phawuloosi ba achchan eqqida issi mato halaqaas, «Oroome as pirday baynda garafanaas inttes piqaadey dizee?» gides. <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Mato halaqay hessa siyida mala halaqata azazizayssako biidi, «Ay ooththana gay? Hayssi addezi Oroome asakko!» gides. <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Hessa gishshas halaqata azazizayssi Phawuloosakko shiiqidi, «Ane taas yoota, ne Oroome asee?» gides; izikka, «Ee ta Oroome asa» gides. <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Azazizayssika, «Ta Oroome as gidanaas daro miish qanxxada shammadis» giin Phawuloosi, «Tani gidikko Oroomen yelettadis» gides. <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Hessa gishshas iza pilggi xeellanaas giigettida asati heerakka iza achchafe haakkida; azazizayssika izi Oroome as sansalatan qachchidayssa yuushshi qoppidi babbides.<verse eid="ACT 22:29" /></para>
  <para style="s1">Ayhudata Duulata Sinth Phawuloosa Shiiqo</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Wonteththa gallas azazizayssi Ayhudati Phawuloosa mootiza ayfe yo7oy aazakko erana koyides; qeeseta halaqatinne Ayhudata shango duulata asay wuri issaadeyka attontta kumeth shiiqana mala azazides; Phawuloosakka qashoppe birshidi shiiqida asaa sinth shiishshi essides.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Phawuloosi duulata asaa tishshi histti xeellidi, «Ta ishatoo! Hach gakkanaas ta Xoossa sinththan lo7o qofara days» gides. <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Qeeseta halaqa Hanaaniyay qasse Phawuloosa doonan shocana mala iza achchan eqqidayta azazides. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Heerakka Phawuloosi Hanaaniya, «Haysso aannora tiyettida keeththazoo! Nenakka Xoossi shocana; wogara pirdana uttada wogay baynda tana shocana mala azazay?» gides.<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">Mato 23:27-28</ref></char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />He wode heen diza asay Phawuloosa, «Xoossa qeeseta halaqa cayay?» gides. <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Phawuloosikka isttas, «Ta ishatoo! Izi qeeseta halaqa gididayssa ta erabeekke; gaasoykka, ‹Ne dere halaqa bolla iita qaala gooppa› gizayssi xaafettides» gides.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">Kessa 22:28</ref></char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Phawuloosi heen diza asaappe baggay Saduqaaweta, baggay Farsaaweta gididayssa eridi, «Ta ishatoo! Ta Farsaaweppe yelettadis; tanikka Farsaawe; hekko ha7i ta pirdettana shiiqiday hayqqidayti dendanayssa ta ufays ooththiza gishshassa» giidi ba qaalaa dhoqqu histtidi duulata asaa sinththan yootides.<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">Hawa 26:5</ref>; <ref loc="PHP 3:5">Pili 3:5</ref></char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Phawuloosi hessa yootida mala Farsaaweta giddoninne Saduqaaweta giddonkka ooshshi dendiin duulatay nam7u kezi shaaketti wodhdhides. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Gaasoykka Saduqaaweti, «Hayqqidaytas denththi deenna; kiitanchchayka baa; Ayanaykka deenna gizayta; Farsaaweti gidikko heyti wurikka deettes» gi ammanizayta.<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">Mato 22:23</ref>; <ref loc="MRK 12:18">Mar 12:18</ref>; <ref loc="LUK 20:27">Luqa 20:27</ref></char></note><verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />He wode daro shiroy asaa giddon hanides; Farsaaweta baggata gidida issi issi Muse wogaa tamaarzayti dendidi, «Nu hayssa addeza bolla aykkoka iita miish demmibeekko; ayanay woykko kiitanchchay izas yootidaa gidana; nu ay erizonii?» giidi palamettida.<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Palamay minni minni bida gishshas asay Phawuloosa tarshereththontta mala babbidi halaqata azazizayssi, «Duge wodhdhidi Phawuloosa asaa giddofe haa kessi ekki yiidi wottadarati dizaso efte!» giidi wottadarata halaqata azazides. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />Wonteththa gallas leela giddoth Goday Phawuloosa achchan eqqidi, «Aykkoy baa; ne Yerusalaamen taas markkattidayssaththo Oroomenkka ne taas markkattanaas bessees» gides.<verse eid="ACT 23:11" /></para>
  <para style="s1">Phawuloosa Wodhanaas Asaa Maqeteth</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Gadey wontiin Ayhuda asati shiiqettidi, «Nu Phawuloosa wodhontta dishe kath mookko; haaththika uyokko» gi caaqettida. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Hessa he maqqozan issife gidida asaa qooday oyddu tammaafe bollara dees. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Isttika qeeseta halaqataakkonne dere cimataakko biidi isttas, «Nu Phawuloosa wodhontta dishe kath montta mala minththi caaqqidos. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Hessa gidida gishshas intte dere cimatara zorettidi iza keehi pilggi xeellizaa misatidi istti inttes Phawuloosa ehana mala azazizayssa oychchite; nunikka izi haa hanno gakkanaappe kasetidi iza wodhana giigettidos» gida.<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Gido attiin issi Phawuloosas michchi nay hessa istta maqqoza siyida gishshas wottadarati dizaso bi gelidi yo7oza Phawuloosas yootides. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Phawuloosikka Mato halaqatappe issaa baakko xeygidi, «Hayssi naazi wottadarata azazizayssas yootiza yo7oy diza gishshas izakko efa» gides. <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Mato halaqay naaza waanna azazizayssako ekki gelidi, «Qashettida Phawuloosi tana baakko xeygidi hayssi naazi nees yootiza yo7oy diza gishshas ta iza neekko shiishshana mala tana woossides» gides.<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Azazizayssika naaza kushe oykki ekkidi haraso pooqqidi, «Ne taas yootanayssi aazee?» giidi iza dumma oychchides.<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Naazikka, «Ayhuda asati Phawuloosa yo7oza lo7eththi maramarizaade misatissidi wonto ne iza isttas shiishshana mala oychchanaas qachchi woththida. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Gido attiin ne isttas ero gooppa; gaasoykka, ‹Nu iza wodhontta dishe kath mookko; haaththika uyokko› giidi caaqettidayti oyddu tammaafe bolla gidiza asi iza wodhanaas oge bolla zuggees; ha7i istti naagizay ne zaaro xalala» gides.<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Azazizayssika, «Ne hayssa taas yootidayssa hara oonakka erisofa» giidi naaza moyzides.<verse eid="ACT 23:22" /></para>
  <para style="s1">Dere Haariza Filkise Sinth Phawuloosa Shiiqo</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Hessafe guye wottadarata azazizayssi mato halaqatappe nam7ata xeygidi, «Qammaafe heedzdzu saate gidishin Qisaariya geetettizaso baana mala nam7u xeetu wottadarata, laappun tammu toganchchatanne nam7u xeetu tooranchchata giigsite; <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Phawuloosasikka para giigsidi dere haariza Filkisekko lo7on gakkana mala ooththite» gides.<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />Dabdaabe hizgi xaafides; <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />«Dere haariza bonchcho Filkises, Qalawodoosa Lusiyoosappe, saroy nees gido. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Hayssa addeza Ayhuda asati oykki wodhana gishin izi Oroome as gididayssa ta gakka erida gishshas wottadaratara gakkada ashshadis. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Istti iza aazas mootizaakko ta erana koyada dere duulataakko shiishshadis. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Istti iza bolla shiishshida mootoy ba wogaa gishshas gididayssa eradis; gido attiin iza hayqos woykko qashos gaththiza miishshi deenna. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Hayssa addeza wodhanaas asay maqettidayssa ta siyida mala heerakka neekko yeddadis; mootizaytikka heen ne sinththan ba mooto shiishshana mala isttas yootadis» gides.<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Hessa gishshas wottadarati ba azazettida mala Phawuloosa qammara efidi Antiphaxiroose geetettizaso gaththida. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Wonteththa gallas toganchchati Phawuloosara baana mala ooththidi istti qasse guye soo simmida. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Toganchchati Qisaariya gakkidi dabdaabeza dere haarizayssas immidi Phawuloosa iza sinth shiishshida. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Dere haarizayssi dabdaabeza nababidinne Phawuloosa, «Ne awa dereppe yadii?» gi oychchides. Izi Kilqiya dere as gididayssa eridi, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />«Nena mootizayti yishin ta ne yo7o siyana» gides; Herdoosa gibbe gaaththan izi naagettana mala azazides.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">Ayhuda Asay Phawuloosa Mootides</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Ichchashu gallassafe guye qeeseta halaqa Hanaaniyay issi issi cimataranne Xarxuloosa geetettiza xabaqaara Qisaariya bides; isttika dere ayssiza Filkisekko shiiqidi Phawuloosa mootida. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Phawuloosi xeygetti shiiqiin Xarxuloosi iza, «Bonchcho Filkisee! Nuni ne baggara daro saroteth demmidos; ne lo7o aysonka nu deres lo7eteththi beettides.<verse eid="ACT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 24:3" />«Hessa ne lo7o oosoza nu awan gidiin aydekka dhoqqu gida bonchchoranne galatara ekkoos. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ta ha7i nena gam7isonttanne daaburssontta qaanththara nees yootizayssa kiyateththan nu gizayssa ne siyana mala woossoos.<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />«Hayssi addezi nuus iita harge gidides; alamen diza Ayhudata ubbaa bolla meto medhdhees; Naaziraawe geetettiza wordo asata kaaleththiza waannay iza. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Izi Xoossa Keeththe tunisana gishin nu iza oykkidos. [Nu wogaa mala nu iza bolla pirdana qoppidos; <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />gido attiin wottadarata halaqata azazizayssi Lusiyoosi gakkidi nu kusheppe iza wolqqara woththi ekkides. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Iza mootiza asaykka neekko yaana mala azazides.] Hayssi nu iza bolla shiishshida mootozi wuri tumu gididayssa neni ne baggara iza oychcha gakkanaas dandayaasa» gi mootides.<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />Hinko Ayhuda asatikka, «Ee hayssi yo7ozi wurikka tumukko» giidi ammanettida.<verse eid="ACT 24:9" /></para>
  <para style="s1">Phawuloosi Bana Ashshana Oge Medhdhides</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Dere ayssiza Filkisey Phawuloosi haasayana mala ba kushera malati bessides; Phawuloosikka, «Neni daro layth hayssa dereza ayssizaade gididayssa ta eriza gishshas ta bolla shiiqida mootozas ta nees ufayssan zaaro shiishshays. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Ta Xoossas goynnanaas Yerusalaame biin hach tammanne nam7u gallassafe daronttayssa neni ne baggara eranaas dandayaasa. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Xoossa Keeththan gidiin Ayhudata Woosa Keeththan woykko katama giddon ta oonarakka palamettishin woykko dere giddon meto medhdhishin tana demmibeettenna. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Ha7i ta bolla istti shiishshida mootozas ay markkaka shiishshanaas dandayettenna.<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />«Gido attiin ta nees qonccisana koyzay istti wordo giza Godaa ogera nu aawantta Xoossaas goynnayssinne Muse wogaaninne nabeta maxaafan xaafettidayssaka ubbaa ammanays. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Isttika ufays ooththiza mala tanikka nagaranchchatinne xilloti hayqoppe dendanayssa Xoossan ammanettays. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Hessa gishshas Xoossa sinththaninne asa sinththan sidhey baynda hanoy taas daana mala ubba wode minnays.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />«Ta Yerusalaameppe keziin taas daro layth gididaappe guye ta dere asaas maado miishshenne Xoossas imettiza miishshe ekka yadis. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Tana istti Xoossa Keeththan demmiday ta hessa gaththishinna; he wode ta geeyza wogaa polishin tanara daro asi deenna; ooshshinne shiroykka deenna. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Gido attiin Iisiyappe yida issi issi Ayhuda asati deettes; isttaskka tana mootos gaththizaazi dizaa gidikko ne sinththan tana mootetto. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Hessafe guye tani duulataa sinth shiiqikko ta ooththida qohoy diikko he asati yootetto. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Tana hayssas gaththida gaasoykka ta istta giddon eqqada, ‹Hayqqidaytas denththi dees› ga yootida gishshas, ‹Hach pirdas intte sinth shiiqadis› gaada ta qaalaa dhoqqu histta yootadis attiin hara tani ooththida miishshi deenna» gides.<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Hawa 23:6</ref></char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Filkisey Godaa oge lo7eththi eriza gishshas, «Wottadarata halaqata azazizayssi Lusiyoosi yiza wode ta intte yo7oza gishshas qasho gidiza yo7o immana» giidi istta yeddides. <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Phawuloosa naagiza mato halaqay, «Iza daro waayisontta lo7eththa naaga; iza laggeti izas koshshiza miish ekki yiikko diggofa» gides.<verse eid="ACT 24:23" /></para>
  <para style="s1">Filkise Sinththinne Dirussilla Sinth Phawuloosa Shiiqo</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Guuththa wodeppe kaallidi Filkisey Ayhuda as gidida ba machcheyo Durissillara yides; Phawuloosakka xeygidi Yesus Kirstoosan ammano gishshas izi yootishin siyides. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Phawuloosi xilloteththa gishshas, asi barkka bana haaro gishshassinne buroppe yaana pirdaa gishshas yootiin Filkisey babbidi, «Ha7i ne ba; hara wode taas giigshin ta nena xeyga ekkana» gides. <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Filkisey Phawuloosappe gubbo ekkanaas ufays ooththi naagida gishshas daro wode gakkanaas xeygi xeygi haasayssides.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Nam7u layththafe guye Phorqiyoosa Fisxoosi Filkise sohon shuumettides; Filkisey Ayhudata ufayssanaas koyidi Phawuloosa qashoson aggaagides.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s1">Phawuloosi Ba Yo7oza Oroome Kawoy Beyana Mala Oychchides</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Fisxoosi ba ayssiza dere Qisaariya gelidi heedzdzu gallas aqettidi heeppe Yerusalaame bides. <verse eid="ACT 25:1" /><verse number="2-3" style="v" sid="ACT 25:2-3" />Heen diza qeeseta halaqatinne issi issi Ayhudata giddofe gita gita asati Phawuloosa bolla ba mooto shiishshida; «Phawuloosa haa Yerusalaame ehidi, ‹Nuus lo7o ooso ooththarkkii!› » giidi woossida; istti hessa giday Phawuloosa naagidi oge bolla wodhanaas koyida gishshassa. <verse eid="ACT 25:2-3" /><verse number="4" style="v" sid="ACT 25:4" />Gido attiin Fisxoosi, «Phawuloosi Qisaariyan qasho keeththan naagettees; tanikka ha7i elle simmada hee izakko baana. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Intte giddofe daannateththi dizayti tanara Qisaariya betto; Phawuloosi ooththida qohoy dizaa gidikko heen mootetto» gides.<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Fisxoosi osppun woykko tammu gallassafe darontta wode isttara gam7idaappe guye Qisaariya bides; hee gakkida mala wonteththa gallas pirda wombora bolla uttidi Phawuloosa baakko shiishshana mala azazides. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Phawuloosi iza sinth shiiqiin Yerusalaameppe yida Ayhudati Phawuloosa giddoththidi markkay baynda daro deexo mooto iza bolla shiishshida.<verse eid="ACT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8" />Phawuloosikka, «Tani Ayhuda wogaa bolla gidiin Xoossa Keeththa bolla woykko Oroome Kawo Qeesaare bollaka gaththida qohoy deenna» giidi istta mootoza shaariza zaaro isttas immides.<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Gido attiin Fisxoosi Ayhudata ufayssanaas koyidi Phawuloosa, «Neni Yerusalaame baada hayssa yo7oza heen ta sinththan pirdettana koyay?» gides. <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Phawuloosi qasse izas, «Hekko ta pirdettanaas taas bessiza Qeesaare pirda wombora sinththan eqqadis; nekka lo7eththa eriza mala ta Ayhudata bolla ooththida aykko qohoykka deenna. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Ta qohidaa gidikko woykko tana hayqos gaththiza qoho ta ooththidaa gidikko ta hayqoppe attana giikke; gido attiin istti shiishshiza mootoy hada gidikko oonikka tana isttas aaththi immanaas dandayenna; tanikka ta yo7oy Qeesaare sinth shiiqana mala, ‹Yigibayne› gadis» gi zaarides.<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />He wode Fisxoosi bana zorizaytara haasayettidi, «Ne Qeesaarekko, ‹Yigibayne› gizaa gidikko Qeesaarekko baandasa» gides.<verse eid="ACT 25:12" /></para>
  <para style="s1">Phawuloosi Agirpha Sinththinne Barniqe Sinth Shiiqides</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Guuththa gallassatappe guye kawo Agirphaynne Barniqey Fisxoosa, «Hashshu lo7on yadasa» gi mokkanaas Qisaariya bida. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Istti heen daro gallas uttida gishshas Fisxoosi Phawuloosa yo7oza Kawo Agirphas, «Filkisey qasho keeththan yeggi aggida issaadey haan dees. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Ta Yerusalaamen diza wode qeeseta halaqatinne Ayhudata cimati ha addeza yo7o taakko ehidi ta iza bolla pirdana mala oychchida. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Ta qasse, ‹Mootettidaadey mootizayta sinththan eqqidi bana mootiza yo7ozas bessiza zaaro immontta dishin mootettidaade aaththi imoy Oroome kawoteththaas woga gidenna› gaada zaaradis.<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />«Hessa gishshas iza mootizayti shiiqettidi yida mala heerakka wonteththa gallas pirda womboran uttada Phawuloosa ta sinth shiishshana mala azazadis. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Iza mootizayti iza achchan eqqida wode istti iza bolla shiishshida mootoy ta baggara izi iita ooththontta aggenna gaada qoppida mala gidibeenna. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Gido attiin istti izara mootettizay ba ammano gishshassinne Phawuloosi hayqqidayssa, ‹Paxa dees› giza Yesusa gishshas gidides. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Tanikka hessa mala yo7o qora xeellanaas tana metida gishshas Phawuloosa, ‹Ne Yerusalaame baada hessa yo7oza heen pirdettana koyay?› gadis. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Histtiin izi yo7ozi Oroome kawo sinththan beyettana mala koyidi, ‹Ta yo7oy Qeesaare sinth shiiqana mala oychchays› gida gishshas iza yo7o Qeesaarekko ta yeddana gakkanaas izi qasho keeththan gam7ana mala azazadis» gi yootides.<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Agirphay Fisxoosa, «Tanikka izi gizaa siyana koyays» gides. Fisxoosikka, «Wonto siyandasa» gides.<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Hessa gishshas wonteththa gallas Agirphaynne Barniqey kawoti may7iza may7o may7idinne daro bonchchora wottadarata halaqataranne he kataman diza gita asatan azhabetti yiidi pirda keeth gelida; hessafe guye Fisxoosi Phawuloosa xeygisides. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Fisxoosi, «Kawo Agirphaa! Nunara diza asatoo! Ayhuda asati wuri, ‹Hayssi addezi hayssafe guye paxa daana bessenna› giidi waassishe Yerusalaamenkka haankka iza bolla pirdettana mala istti tana oychchizay hayssa intte be7iza addeza gishshassa. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Tahi ta baggara iza hayqos gaththiza issi balakka iza bolla demmabeekke; izi, ‹Ta yo7oy Oroome kawo sinth shiiqi beyetto› gida gishshas ta iza hee yeddanaas qachchadis.<verse eid="ACT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 25:26" />«Gido attiin iza gishshas tani ta godaas xaafana giza erettida yo7oy deenna; hessa gishshas iza issi issi paace oyshata oychchiko taas xaafanayssi daanakkonne gaada intteko, harappeka kawo Agirpha neekko shiishshadis. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Gaasoykka qasho asi pude bollatiza dhoqqa daannako bishin izi mootettiza yo7o qonccisontta agoy asa eeya kessizayssi taas beettides» gides.<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s1">Phawuloosi Kawo Agirpha Sinththan Yootida Yo7o</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agirphay Phawuloosa, «Neni ne gishshas haasayanaas dandayaasa» gides; Phawuloosikka ba kushe denththidi zaaro immides. <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«Kawo Agirphaa! Tana Ayhudati mootiza yo7o ubbaas hach ta ne sinththan tana maaddana zaaro immiza gishshas tana daro ufayssees. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Gaasoykka ne Ayhudata wogaanne istta palama ubbaa lo7eththa eraasa; hessa gishshas ne ta gizaa ubbaa dandayada siyana mala ta nena woossays.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />«Tani guuththa naateththa wodeppe doommada waana de7idaakko Ayhuda asati ereettes; koyroppe ha7i gakkanaas tani ta dere asaa giddoninne Yerusalaamen ta de7ida duus asay erees. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Qasseka istti markkattana koykko nu ammano gishshas ta keeha minththa wogaa naagiza Farsaawe bagga gidada gam7idaade gididayssa istti koyroppe denththidi ereettes.<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Hawa 23:6</ref>; <ref loc="PHP 3:5">Pili 3:5</ref></char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Ha7i qasse pirdas tana hayssan essiday Xoossi kase nu aawatas immida caaqo qaalaa ufayssa gishshassa. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ha ufayssaako gakkanaas nu zarkketi tammanne nam7ati gallassinne qamma Xoos goynnishe naagida; kawo inttes hoola! Ayhudati tana mootizay ha yo7oza gishshassa. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Xoossi hayqqidayta denththanayssi waanidi Ayhuda gidida intte achchan ammanettibeennee?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />«Tanikka ta baggara Naazirete Yesusa sunththas eqettanaas bessees gaada qoppadis shin;<note caller="-" style="x"><char style="xo" closed="false">26:9-11 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 22:4-5">22:4-5</ref></char></note> <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />tani Yerusalaamen ooththidaykka hessakoshin; qeeseta halaqatappe ta ekkida godateththara ammanizaytappe darota qasho keeththan yegisadis; istta wodhishin wodhizaytara issife days. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Daro wode Ayhudata Woosa Keeththati dizason awanka istti qaxxayettana malanne ba ammano kaddana mala ooththadis; istta bolla daro hanqettadakka Isra7eeleppe karen diza hara katamatakka baada ammanizayta gooddadis.<verse eid="ACT 26:11" /></para>
  <para style="s1">Phawuloosi Kirstoosakko Waani Simmidaakko Yootides</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />«Hayssa ha yo7ozas qeeseta halaqatappe kumeththa godateththinne azazo ekkada Damasqo geetettizaso ta bishin, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Kawo inttes hoola! Buro ta ogen dishin gadey seeta gallas gidishin arshe poo7oppe aadhdhiza poo7o beyadis; he poo7oy tananne tanara biza asata yuuyi aadhdhidi saloppe poo7ides. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Nu wurikka biitta bolla kundi dishin Ayhudata qaalara, ‹Sa7oole! Sa7oole! Tana aazas goodday? Neni qara mashsha bolla eqqiko nerkka nena qohaasa› giza qaala siyadis.<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />«Tanikka, ‹Godoo! Ne oonee?› gadis; Godaykka, ‹Tani ne, gooddiza Yesusaakko! <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Ha7i dendada ne tohon eqqa; ta nees qoncciday ne tana ha7i be7idayssaninne sinththafe ta nena bessanayssan ne taas markkattizaade gidana mala ta nena shuumana koyadis. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Isra7eele asaa kusheppenne ta nena isttako kiittiza Ayzaabeta kusheppeka ashshana. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Ne istta ayfe doyana malanne dhumappe poo7on kessana mala qasseka Xala7es haarettizasoppe Xoossako ne zaarana mala ooththana; isttika tana ammanida gishshas ba nagarappe maarettana; qasse doorettidayta giddon istti xinxxo demmana› gides.<verse eid="ACT 26:18" /></para>
  <para style="s1">Phawuloosi Ba Ooso Gishshas Yootides</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />«Hessa gishshas kawo Agirphaa! Saloppe taas imettida ajjuutaas ta azazettadis. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Gido attiin ta kasetada Damasqon diza asaa kaaleththada Yerusalaameninne Yuhuda dere ubbaan dizayta qasseka Ayzaabetikka nagara ogeppe Xoossako simmidi maarettana mala erisadis; istti nagarappe simmidayssa bessizaaz ooththana mala ta isttas yootadis.<note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">Hawa 9:20</ref>,<ref loc="ACT 9:28-29">28-29</ref></char></note> <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Hessa gaason Ayhudati tani Xoossa Keeththan dishin tana oykkidi wodhana koyida. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Hach gakkanaaska taas Xoossafe maadoy pacci erenna; hessa gishshas guuththaska gitaska markkattashe hayssan eqqadis; nabetinne Musey kasetidi hayssa malay hanana gidayssa yootoppe attiin ta hara aykkoka yootabeekke. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Isttika yootidayssi, ‹Xoossi kiittidaadey meto beyana; hayqoppe dendon koyro gididi asi attana poo7oy Isra7eele deresinne Ayzaabetas qonccana› gizayssa» gides.<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">1Qoro 15:20</ref>; <ref loc="ISA 42:6">Isa 42:6</ref>; <ref loc="ISA 49:6">49:6</ref></char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Phawuloosi hessa yootishin Fisxoosi, «Phawuloosaa! Ha7i ne gooyontta aggaka; ne daro tamaardayssi nena gooshshides» gi waassides.<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Phawuloosi gidikko izas, «Bonchcho Fisxoosaa! Ta nees tumaa erada yootays attiin gooyabeekke. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Ta iza sinththan qonccera yootida kawoy hayssa yo7oza erees; hayssika qotara oosettonttayssa gidida gishshas kawoy eranayssa ta ammanettays. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Kawo Agirphaa! Nabeta ammanaasa gidikkii? Ne ammanizayssa ta erays» gi zaarides.<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Agirphayka Phawuloosa, «Hekko ne tana hanno guuththa wode giddon ammanththana koyaasa» gides. <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Phawuloosikka izas zaaridi, «Guuththa woden gidiinkka woykko daro woden ne xalla gidontta dishin hach ta yootidayssa siyiday wuri hanno ta qasheteththaya attaa wurikka ta mala gidana mala tani Xoossaa woossays» gides.<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Hessafe guye kawoy, dere ayssizayssi, Barniqeynne isttara uttida asaykka wuri dendides. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Istti heeppe kezi bishe ba giddon, «Hayssi addezi hayqos woykko qashos gaththiza miishshe aykkoka ooththibeenna» gida. <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Agirphayka Fisxoosa, «Hayssi addezi yo7oza Qeesaares shiiqo gonttaako aykko wosoy baynda mela yedettanaakko shin» gides.<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s1">Phawuloosi Oroome Bides</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Nuni Xaalaane dere markaben baana mala geetetti qashettida gishshas Phawuloosanne hara qasho asatakka kawo Awugisxoossa wottadaratappe gidida Yuuliyoosa geetettiza mato halaqaas aaththi immida. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Iisiya abba achchan diza dereta biza markaben gelidi bidos. Tasolonqen diza issi Maqidooniya as Arisxirokoosa geetettizayssi nunara dees.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />Wonteththa gallas Sidoona geetettizaso gakkidos; Yuuliyoosi Phawuloosas lo7o gidida gishshas Phawuloosi ba laggetakko biidi asay izas koshshiza maado ooththana mala piqaade immides. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Heeppe dendi nu bishin sinththa baggara carkoy nu bolla carkiza gishshas abba giddon diza Qophiroose deren geemettidi sinththe bidos. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Kilqiya geetettizasonne Phinfiliya geetettiza dere achchan diza abbaa pinnidi Looqiya deren diza Muura geetettiza katama gakkidos. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Heen mato halaqay Xaalaane dere biza Iskindiriya dere markabe demmidi nuna izan gelththides.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Daro gallas loddu gi biidi daro waayettidi Qandoose geetettiza katamaa ach gakkidos; carkoyka nu sinth bontta mala diggiin Salmmoona achchara aadhdhidi Qarxeese geetettiza abbaa giddon diza deren geemettidi bidos. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Daro waayettidi lanqe lanqe<note caller="+" style="f"><char style="fr" closed="false">27:8 </char><char style="fqa" closed="false">Lanqe: </char><char style="ft" closed="false">Lanqe gizayssi abba giddon diza Qarxeese gaxa bessees.</char></note> oykki nu aadhdhidaappe guye Laasiya geetettiza katama achchan diza, «Lo7o» geetettiza markabey eqqizaso gakkidos.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Nu biza oge bolla daro daaburan xooma wodey aadhdhida gishshas ha7i abba bollara baanaas daro meto gidida gishshas Phawuloosi banara diza asay naagettana mala hizgides; <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«Asoo! Hayssafe nu kaallidi baana buussay daro metora dizayssi taas beettees; markabezan diza caanaza bollanne markabeza bolla xalala gidontta asa shemppo bollaka gita qohoy gakkana.» <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Mato halaqay qasse Phawuloosa zoreppe bollara markabeza laaggiza waannazinne markabeza goday gizayssa siyides. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />He markabey eqqizasoy balgoy aadhdhana gakkanaas markabes lo7o shemposo gidontta gishshas dariza bagga asay, «Hemeth sinth gujjanaas dandayettiko arshey wullizasoppe dugeha baggaranne pudeha baggara diza Pinqe geetettizaso Qarxeese markabe shemposo nu gakkidi balgo heen aaththoos» giidi ba qofaa shiishshida.<verse eid="ACT 27:12" /></para>
  <para style="s1">Abba Bolla Dambala Denth</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Dugeha baggara guuththa carkoy carkishin be7idi istti qoppida mala hananaa misatiin baana kezida; markabey eqqizasoppe baana dendidi Qarxeese achchara lanqe lanqe oykkidi aadhdhi bida. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Gido attiin guuththa wodeppe guye, «Arshey mokkizasoppe pudehappe yiza gote carko» geetettiza iita wolqqama carkoy abba giddon diza dereyppe dendidi isttako abba giddo yides. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Markabeza carkoy sugiin carkaara eqettanaas dandayontta ixxiin nu co7u giidi carkoy efizaso bidos. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Qeedda geetettiza abba giddon diza dere dizaarin geemettidi nu bishin daro waayettidi markabeza qeeri wogoloyin oykkidi essanaas dandaydos. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Markabeza laaggizayti qeeri wogoloyo markabezaakko goochchi kessidi markabeza wodorora xaaxida; markabezikka Sirtise geetettiza abba acey dari dizason kundontta mala babbidi iza bolla diza sharaa woththidi carkon laagetti bida. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Gote carkoy minni bida gishshas wonteththa gallas markabezan caanettida miishshata issaa issaa abba giddo yegeth oykkida. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Heedzdzanththo gallas markabezas koshshiza miishshatakka ba kushera kessi kessi yeggida. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Daro wode gakkanaas arsheka, xoolintteka be7ontta aggida gishshassinne carkoyka kaseppe minni minni biza gishshas hayssafe guye nu attana dandayokko giza qofan ufays qanxxidos.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Asay kath montta daro gallas uttides; hessa gishshas Phawuloosi asaa giddon eqqidi, «Ha asatoo! Intte ta gizayssa siyidi Qarxeeseppe dendonttaako ha qohoynne dhayoy intte bolla gakkennakoshin. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Ha7ikka markabezi xalla qohettana attiin inttefe issaade shemppoyka dhayenna; hessa gishshas aykkoy baa; babbofte gaada tani inttena zorays. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Qamma omars ta izas gidida ta goynniza Xoossay kiittida kiitanchchay ta achchan eqqidi, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‹Phawuloosaa! Babbofa! Ne Qeesaare sinththan eqqana bessees; hekko nenara issife bizayta wursi Xoossi ne gishshas hayqoppe ashshana› giidi taas yootides. <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Hessa gishshas intteno ha asatoo aykkoy baa; Xoossi taas hayssa yootidayssa polanayssa ta ammanays. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Gidikkoka hayssi gote carkozi gede issi abba giddon diza dere ach efidi nuna yeggana» gides.<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Tammanne oydanththo qamma Andirya Abba<note caller="+" style="f"><char style="fr" closed="false">27:27 </char><char style="fqa" closed="false">Andirya Abba: </char><char style="ft" closed="false">Andirya Abba Mediteraane abbafe issi baggara diza abba.</char></note> giddon carkoy nuna waayisishin bishe leela giddoth markabeza laaggizaytas abbaafe biitta bolla gakkidaa misatides. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Hessa gishshas abbaa ciimmateth eranaas abbaan yeggi xeelliza wodoro istti yeggi xeellishin abbaa ciimmateththi oyddu tammu metire keena gidi beettides; gam7ishe ha7ikka yeggiin heedzdzu tammu metire keena ciimma gididayssa demmida. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Nu diza markabey abbaa gaxan diza zaalla shuchchara icetontta mala babbidi markabezappe guye baggara markabezi qaaxxontta mala naagiza dhishke duge abbaa giddo yeggida; hessafe guye isttas qammay wonttana mala woosa oykkida. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Markabeza laaggizayti markabezappe kezidi baqatana koyida gishshas markabezappe sinththa baggara markabe naagiza dhishke yeggizaa misatidi markabeza bolla diza qeeri wogoloyo duge abbaa giddo yeggida. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />He wode Phawuloosi mato halaqaanne wottadarata, «Hayti markabezan diza asati markabeza bolla shempidi uttontta aggiko intteka attana dandayekketa» gides. <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Hessa gishshas wottadarati wogoloyo oykkida wodoroza qanxxi yeggiin iza abbaa bolla tookettana mala yeddi aggida.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Gadey wonttana gishin wurikka kath maana mala Phawuloosi istta, «Intte aazi hananeeshaa giidi hirgan kath montta aggiin hach tammanne oydanththo gallassa. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Hessa gishshas intte kath maana mala ta inttena woossays; intte miikko minnana; mulekka aykko qohoykka intte bolla gakkenna» gi woossides. <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Izi hessa gidaappe guye kath ekkidi Xoos galatidi ubba asaa sinththan kath muus oykkides. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />He wode wurikka minettidi kath mida. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Markabeza giddon diza asay wuri nam7u xeetanne laappun tammanne usuppuna. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Wurikka mi kaallidaappe guye markabaan caanettida gistteza duge abbaa giddo yeggidi markabeza deexo kawushshida.<verse eid="ACT 27:38" /></para>
  <para style="s1">Markabeza Meqo</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Gadey wontiin ba dizaso eribeettenna; gido attiin acey dizaso abba kurqunthu demmida; isttas dandayettizaakko markabeza hee sugi shiishshana qoppida. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Markabeza oykkiza dhishke qanxxidi abba giddo yeggida; he wode markabe laggeza miishshaa oykkida wodorota birshida. Ha baggara diza sharaa carko bagga dhoqqu histtidi kezana abba gaxa bida. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Gido attiin markabezi daro acey koretti uttidayssara icettidi duge gufannides; sinththa bolla duge gufanni dhishkettidi qaaxxonttayssa gidides; qasse abba dambalay daroppe dendidayssan guye baggara meqereteth oykkides.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Qasho asaappe issaadeyka abbaan wodhdhidi kessi ekkontta mala wottadarati wodhana qoppida. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Mato halaqay qasse Phawuloosa ashshanaas koyida gishshas istta qofaa ekkana koyibeenna; gido attiin haaththe wadhdhi erizayti markabezappe duge abbaan guppi guppi wodhdhidi biitta bolla kezana mala azazides.<verse eid="ACT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 27:44" />Hankko attidayti sanqqataninne markabe meqotan abbaa pinnana mala azazides; hessaththo hanidi wurikka saron abbaa giddofe biittaa bolla gakkida.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s1">Melaaxiya Biittan Phawuloosa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Nu biittay dizaso saroteththan gakkidaappe guye nu gakkida abbaa giddon diza derey Melaaxiya geetettiza dere gididaaro eridos. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />He dereyin diza asay daro malalisiza kiyateth nuus ooththides; he wode iray bukkida gishshassinne meego gidida gishshas tama eeththidi nuna mokki ekkida. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Phawuloosi afira<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="fqa" closed="false">Afira geetettiza mith: </char><char style="ft" closed="false">Ha miththay issi issi Gamoththo qaalan qayxare, hunxe geetettees.</char></note> geetettiza mith shiishshidi taman gujjiin tama seelappe dendidayssan shooshshi kezidi iza kushe bolla xaaxettides. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Malta asay shooshshi Phawuloosa kushe bolla xaaxettidayssa be7idi, «Hayssi addezi shemppo wodhidaade; gaasoykka abba dambalaappe izi attidi yiikkoka pirdiza Xoossafe kessi ekki paxa daana dandaybeenna» giidi ba giddon haasayettida <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Phawuloosi qasse shooshshaa duge taman qoqofi yeggidi aykkoka hanibeenna. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Asaykka, «Aydeppe ayde iza asateththay kixxaneesha; woykko izi qoppontta kundidi hayqqana» giidi naagides; gido attiin istti daro wode naagishin iza bolla aykkoyka hanonttayssa be7idi ba qofaa laammidi, «Hayssi addezi xoossa!» gides.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />He nu dizaso matan abbaa giddon diza dereyo ayssiza Pupulyoosa geetettizaades gadey dees; he addezi nuna mokki ekkidi bason heedzdzu gallas gakkanaas lo7eththi imattides. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Heen Pupulyoosa aawa miishshaynne guso hargey sakkiin ichchidi dees; Phawuloosi izakko gelidi izas woossidessinne iza bolla ba kushe woththidi paththides. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Hessi hessaththo handaappe guye he dereyin diza hara harganchchati yiidi paxida. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Asaykka nuus daro miish ehidi nuna bonchchizayssa nuna bessides; nuni markaben baana dendiin nuus koshshizayssa markaben ubbaa caanida.<verse eid="ACT 28:10" /></para>
  <para style="s1">Milixineppe Oroome Phawuloosa Buus</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Nu Milixinen heedzdzu agina gam7idaappe guye balgoy aadhdhana gakkanaas abba giddon diza dereyin gam7idi Iskindiriyappe yiza markaben gelidi baana dendidos; he markabeza bolla Diyosiqoroosa geetettiza nam7u mentte eeqata misley dees. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Sirakuuse geetettiza katama gakkidi heen heedzdzu gallas gam7idos. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Heeppe abbaa bollara biidi Eregiyoome geetettiza katama gakkidos; heen issi gallas aqidi duge baggara yiza carkoy carkida gishshas nam7anththo gallas Puttiyoloose geetettizaso bidos. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Heen ammanizayta demmidi isttara nu laappun gallas gakkanaas uttana mala nuna woossida; heeppe qasse Oroome bidos. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Oroomen diza ammaniza asay nu gishshas siyidi Apiyoose geetettiza giyanne «Heedzdzu Aqosota» geetettizaso gakkanaas nuna mokkana yida; Phawuloosaykka istta be7idi Xoos galatidessinne minettides.<verse eid="ACT 28:15" /></para>
  <para style="s1">Oroomen Phawuloosa</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Nuni Oroome gelida wode Phawuloosa naaganaas issi wottadaray izas imettiin Phawuloosi barkka daana mala izas Piqaadey imettides.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Heedzdzu gallassafe guye Phawuloosi Oroomen diza Ayhudatappe gita asata baakko xeygisides; isttika izakko shiiqiin, «Ta ishatoo! Tani Isra7eele dere bollanne nu aawata wogaa bolla ooththida issi qohoykka deenna; gido attiin Yerusalaamen tana qachchidi Oroome asatas aaththi immida. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Oroome asati tana qori oychchidaappe guye tana hayqos gaththiza miish demmontta aggida gishshas birshi yeddana koyida. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Gido attiin Ayhuda asay ta bolla issi wosoy baynda yeddetontta mala eqettiin ta yo7oy Qeesaare sinth shiiqidi beetto gaanaas taas gidde gidides; gido attiin tani ta dereta mootiza gaasoykka taas deenna. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ta qasse ha7i inttena xeygisiday inttena beyanaassinne hanno inttes yootanaassa; hayssa sansalatan tani qashettiday Isra7eele naytas imettida ufayssaa gaasonna» gides.<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Isttika izas, «Ne gishshas Yuhuda dereppe xaafettida dabdaabey nuna gakkibeenna; haa yida asatappe oonikka ne gishshas iita haasayday baa. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Hayssa ne kaalliza ammanoza gishshas awanka asay iita haasayzayssa nu eroos; hessa gishshas ne qofay aazakko nu siyana koyoos» gi zaarida.<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Bare izas immidi hara gallas kushe kumidi izi diza keeththe yida; izikka malladoppe omars gakkanaas Xoossa Kawoteththaa gishshas markkateththan ba qofaa isttas qonccisides. Muse wogappenne nabeta maxaafatappe xaqqasi xaqqasi Yesusa gishshas isttas qonccisi yootides. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Isttafe issi issi asati izi yootida qaalaa ammanida; baggayti qasse ammanibeettenna. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Isttika ba giddon issoy issaara qofan gaaggontta shaakettida; Phawuloosi wurseththan yootishe, «Xillo Ayanay nabe Isayaasa baggara kase intte aawatas yootidayssi tumakko! <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />Izi yootida qaalay,</para>
  <para style="q1" vid="ACT 28:26">« ‹Hayssa deraakko baada</para>
  <para style="q2" vid="ACT 28:26">intte sis siyanashin</para>
  <para style="q2" vid="ACT 28:26">yuushshi qoppeketa,</para>
  <para style="q2" vid="ACT 28:26">ayfera beyanashin</para>
  <para style="q2" vid="ACT 28:26">wozinan woththeketa</para>
  <para style="q2" vid="ACT 28:26">gaada yoota.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Gaasoykka he asata</para>
  <para style="q2" vid="ACT 28:27">wozinay muumides;</para>
  <para style="q2" vid="ACT 28:27">istta hayththayka tullides;</para>
  <para style="q2" vid="ACT 28:27">istta ayfey qooqides.</para>
  <para style="q2" vid="ACT 28:27">Hessaththo hanonttaako</para>
  <para style="q2" vid="ACT 28:27">istti ba ayfera be7idi,</para>
  <para style="q2" vid="ACT 28:27">ba hayththara siyidi</para>
  <para style="q2" vid="ACT 28:27">ba wozinan yuushshi qoppidi,</para>
  <para style="q2" vid="ACT 28:27">taakko haa simmananne</para>
  <para style="q2" vid="ACT 28:27">tanikka istta paththanashin› gides.<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />«Histtiko Xoossi as ashshiza kiitay Ayzaabetaska kiitettidayssa intte erite; isttika ero giidi ekkeettes» gides. <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Phawuloosi hessa yootidaappe guye Ayhuda asati ba giddon daro palamettishe kezi bida.<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafatan taybo 29 bolla diza qofay gujettibeenna.</char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Phawuloosi kiratida keeththaan nam7u layth kumeth de7ides; baakko yiza as ubbaa mokki ekkides. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Xoossa kawoteth sabbakon Godaa Yesus Kirstoosa gishshas oonikka iza diggontta xalateththara asaa tamaarsides.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>