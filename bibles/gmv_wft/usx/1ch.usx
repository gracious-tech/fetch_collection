<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Gamo Full Bible final version</book>
  <para style="h">1Taarike Maxaafa</para>
  <para style="toc1">1Taarike Maxaafa</para>
  <para style="toc2">1Taarike Maxaafa</para>
  <para style="toc3">1Taari</para>
  <para style="mt1">1Taarike Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Koyro taarike maxaafay Sameela maxaafaninne kawota maxaafatan diza taariketa hara ogera zaari yootees; taarike maxaafati Isra7eele kawota taarike gishshas ayfe gidida nam7u qofata yooteettes.</para>
  <para style="ili">1. Isra7eele kawoteththatinne Yuhuda kawoteththati mooron kundidaa gidikkoka Xoossi ba derezas immida hidota qaala ubbaa naagidayssa Yuhudan diza asaa baggara izi ba deraas qoppidayssi ooso bolla pe7oyssa bessanaassa; hessi tumu gididayssa erisanaas ha maxaafaa xaafida Dawitinne Solomooney ooththida gita oosota, Iyoosaafixey Hizqiyaasinne Iyosiyaasi ooththida ooraxiso oosotanne Xoossas istta ammaneteththi minnida deraa lo7eththi bessees (1-12).</para>
  <para style="ili">2. Yerusalaamen diza Xoossa Keeththan Xoossas goynoy waani doomettidaakko qonccisanaassa; qasse he wode goyno wogaa kaaleththizayti qeeseta gidida gishshas istti kaaleththiza ooso keeththay waanidi doomettidaakko qonccisanaassa; Xoossa Keeththaa keexxiday Solomoone gidikkoka koyro Xoossa Keeththan goyno woga essiday Dawite gidayssa erisanaassa. (13-29)</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Addaame zareppe biidi kawo Sa7oole gakkanaas <char style="ior"><ref loc="1CH 1:1-9:44">1:1—9:44</ref> </char></para>
  <para style="io1">Sa7oole hayqonne iza nayta hayqo <char style="ior"><ref loc="1CH 10:1-14">10:1-14</ref> </char></para>
  <para style="io1">Dawiti kawotidi Yerusalaame oyth <char style="ior"><ref loc="1CH 11:1-9">11:1-9</ref> </char></para>
  <para style="io1">Dawite wottadara minota <char style="ior"><ref loc="1CH 11:10-12:40">11:10—12:40</ref> </char></para>
  <para style="io1">Taabotaa Yerusalaame efo <char style="ior"><ref loc="1CH 13:1-16:43">13:1—16:43</ref> </char></para>
  <para style="io1">Xoossa Keeththa keexxanay Solomoone <char style="ior"><ref loc="1CH 17:1-27">17:1-27</ref> </char></para>
  <para style="io1">Dawite wottadarata xoono <char style="ior"><ref loc="1CH 18:1-20:8">18:1—20:8</ref> </char></para>
  <para style="io1">Dawiti deraa qoodiin gakkida hanqo <char style="ior"><ref loc="1CH 21:1-30">21:1-30</ref> </char></para>
  <para style="io1">Xoossa Keeththaa keexxanaas giigeteth <char style="ior"><ref loc="1CH 22:1-28:21">22:1—28:21</ref> </char></para>
  <para style="io1">Xoossa Keeththaa keexxanaas imettida imota <char style="ior"><ref loc="1CH 29:1-20">29:1-20</ref> </char></para>
  <para style="io1">Solomoone kawoteth <char style="ior"><ref loc="1CH 29:21-25">29:21-25</ref> </char></para>
  <para style="io1">Dawite hayqo <char style="ior"><ref loc="1CH 29:26-30">29:26-30</ref> </char></para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Addaameppe Biidi Abrahaame Gakkanaas Diza Yeleta</para>
  <para style="r">(<ref loc="GEN 5:1-32">Medhe 5:1-32</ref>; <ref loc="GEN 10:1-32">10:1-32</ref>; <ref loc="GEN 11:10-26">11:10-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Addaamey Seete yelides; Seetey Heenoose yelides; Heenoosey Qaynaane yelides. <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Qaynaaney Malal7eele yelides; Malal7eeley Yaareede yelides. <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Yaareedey Heenooke yelides; Heenookey Maatusaala yelides; Maatusaalay Laameeke yelides. <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />Laameekey Nohe yelides; Nohey Seeme, Kaamenne Yaafeete yelides.<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />Yaafeetey, Goomere, Maagooge, Maadaye, Yaawaane, Tubaale, Mesheekenne Tiraase geetettiza attuma nayta yelides. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Goomere nayti Ashkenaaze, Erefasitenne Togarma. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Yaawaane nayti Elishe, Tarseese, Kiitimenne Oroodahime. <verse eid="1CH 1:7" /><verse number="8" style="v" sid="1CH 1:8" />Kaame attuma nayti Kuushe, Mixirayme, Puuxenne Kanaane. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Kuushe nayti Seeba, Hawila, Saaba, Eraa7imenne Sabiteka; Eraa7ime attuma nayti Saabanne Dadaane. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />Kuushey Namuruude yelides; Namuruudeyka alame bolla erettida wolqqama olanchcha gidides. <verse eid="1CH 1:10" /><verse number="11" style="v" sid="1CH 1:11" />Mixiraymey Luudimeta, Anaameta, Lahaabeta, Naftuheta, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Phaxirooseta, Kaasiluhetanne Filisxeeme zareta yelida Kaftooreta yelides. <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />Kanaaney bayra naa Sidoonassinne iza kaalo Hiites aawa; <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />qasseka Kanaaney Yaabusetas, Amooretas, Gergesetas, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Hiiwetas, Arqetas, Siinetas, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Arwaadetas, Xamaaretassinne Hamaatetas aawa.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />Seeme nayti, Elaame, Asoore, Arfaakiside, Luude, Aaraame, Uuxe, Huule, Geterenne Mesheeke; <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />Arfaakisidey Sheelahe yelides; Sheelahey Eboore yelides; <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Eboorey nam7u attuma nayta yelides; issoy yelettida wode sa7ay shaakettida gishshas iza sunththi Peeleege geetettides; nam7anththozi Yoqixaane geetettides. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Yoqixaaney Almodaade, Shelefe, Haxarmaawete, Yerahe <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoraame, Uzaale, Diiqile <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Eebaale, Abima7eele, Saaba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofire, Hawilanne Yobaabe yelides; hayti wurikka Yoqixaane nayta.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />Seemeppe biidi Abrahaame gakkanaas diza yeleta zarkkey hayssafe kaalli dizayta oykkees; isttika Seeme, Arfaakiside, Sheelahe, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Eboore, Peeleege, Era7e, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Saruge, Naakoore, Taaranne <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />guyeppe Abrahaame geetettida Abraame.<verse eid="1CH 1:27" /></para>
  <para style="s1">Abrahaame Soo Asata</para>
  <para style="r">(<ref loc="GEN 25:12-16">Medhe 25:12-16</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />Abrahaamey Yisaaqanne Isma7eele yelides.<verse eid="1CH 1:28" /></para>
  <para style="s1">Aggaara Abrahaames Yelida Nayta</para>
  <para style="p">
    <verse number="29-30" style="v" sid="1CH 1:29-30" />Abrahaamey Aggaarippe Isma7eele yelides; Isma7eeley yelida bayra naaza sunththi Nebayoote gidishin iza kaaloti Qeedaare, Adibi7eele, Mibisaame, Mishima7e, Duuma, Maasa, Hadaade, Teema, <verse eid="1CH 1:29-30" /><verse number="31" style="v" sid="1CH 1:31" />Yixure, Nafishaanenne Qeedima geetetteettes.<verse eid="1CH 1:31" /></para>
  <para style="s1">Keexuray Abrahaames Yelida Nayta</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />Keexuray Abrahaames yelida usuppun attuma nayti Zimiraane, Yoqishaane, Maadda, Midiyaane, Yishibaaqenne Shuha geetetteettes. Yoqishaaney Saabanne Dadaane geetettiza nam7u attuma nayta yelides. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Midiyaaneykka Eefa, Efere, Heenooke, Abida7enne Elda7e geetettiza ichchashu attuma nayta yelides; hayti ubbay Keexura zereththata.<verse eid="1CH 1:33" /></para>
  <para style="s1">Abrahaamey Saarappe Yelida Zareta</para>
  <para style="r">(<ref loc="GEN 36:1-19">Medhe 36:1-19</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />Abrahaamey Saarappe Yisaaqa yelides; Yisaaqi Eesawenne Isra7eele yelides. <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />Eesawey Elfaaze, Era7u7eele, Ya7uushe, Ya7ilaamenne Qoore yelides. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Elfaazey Temaane, Omaare, Xaafe, Ga7itaame, Qenaaze, Teminaa7enne Amaaleeqe geetettiza attuma nayta yelides. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Era7u7eeley Nahaate, Zaraahe, Shammahanne Miizahe geetettiza attuma nayta yelides.<verse eid="1CH 1:37" /></para>
  <para style="s1">Eedoomen Koyro De7ida Asata</para>
  <para style="r">(<ref loc="GEN 36:20-30">Medhe 36:20-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Eedoomen koyro de7ida Seyre attuma nayti Looxa, Shobaale, Xiba7oone, Aana, Diisho, Exeerenne Dishaane. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Looxaane attuma nayti Hoorenne Homaame; Teminaa7a Looxaanes michcho. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Shobaale attuma nayti Aliwa, Manahaate, Eebaale, Sheefenne Oonname.</para>
  <para style="p" vid="1CH 1:40">Xiba7oone attuma nayti Aayanne Aana. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Aanay Dishoone yelides; Dishoone attuma nayti Hemda, Eshibaane, Yitiraanenne Kaaraane. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Exeere attuma nayti Bilihaane, Za7iwaanenne Yaqine.</para>
  <para style="p" vid="1CH 1:42">Dishaane attuma nayti Uuxenne Araane.<verse eid="1CH 1:42" /></para>
  <para style="s1">Eedoome Dere Kawota</para>
  <para style="r">(<ref loc="GEN 36:31-43">Medhe 36:31-43</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Isra7eelen ay kawoykka kawotanaappe kase Eedoome biittan kawotida kawoti hayssafe kaalli xaafettidayta.</para>
  <para style="p" vid="1CH 1:43">Bi7oore naa Beelay kawotides; iza katamaa sunththay Dinaabe.<verse eid="1CH 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 1:44" />Beelay hayqqiin izappe kaallidi Booxira dere as Zaraahe naa Yobaabey kawotides.<verse eid="1CH 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CH 1:45" />Yobaabey hayqqiin izappe kaallidi Temaane dere as Hushamey kawotides.<verse eid="1CH 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 1:46" />Hushamey hayqqiin izappe kaallidi Mo7aabe deren Midiyaameta xoonida Badaade naa Hadaadey kawotides; iza katamaya Awite geetettawus.<verse eid="1CH 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 1:47" />Hadaadey hayqqiin izappe kaallidi Maasireeqe dere as Sha7uley kawotides.<verse eid="1CH 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 1:48" />Sha7uley hayqqiin izappe kaallidi Efiraaxise shaafa matan diza Erahoobote dere as Sa7ooli kawotides. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Sa7ooli hayqqiin izappe kaallidi Akiboore naa Ba7aali-Hanaaney kawotides.<verse eid="1CH 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 1:50" />Ba7aali-Hanaaney hayqqiin izappe kaallidi Paa7u dere as Hadaadey kawotides; iza machcheyakka Mahexabi7eela Mezahaabe naa Maxireeda biyo; hessafe guye Hadaadey hayqqides. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Eedoomen keehi erettiza halaqati Teminaa7e, Aliwa, Yeteete, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibaame, Eela, Pinoone, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Qenaaze, Temaane, Mibizaare, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magidi7eelenne Iraame geetetteettes.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Yaaqoobe Nayta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Yaaqoobey 12 attuma nayta yelides; heytikka Oroobeele, Simoona, Lewe, Yuhuda, Yisakoore, Zaabiloone, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Daane, Yooseefe, Biniyaame, Niftaaleme, Gaadenne Aaseere.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yuhuda Nayta</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />Yuhuday Kanaane dere as Shu7a biype Eera, Oonaanenne Seela geetettiza heedzdzu attuma nayta yelides; izas bayra naazi Eeray GODAA sinththan iita as gidida gishshas GODAY iza boshan wodhides. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Yuhudaykka ba naaza machcho Ti7imaarippe Paareesenne Zaraahe geetettiza nam7u attuma nayta yelides; Yuhuday ichchash attuma nayta yelides.<verse eid="1CH 2:4" /></para>
  <para style="s1">Paarise Attuma Nayta</para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />Paareeseykka Hexiroomenne Hamule geetettiza nam7u attuma nayta yelides.<verse eid="1CH 2:5" /></para>
  <para style="s1">Zaraahe Nayta</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 2:6" />Zaraahey ichchashu attuma nayta yelides; heytikka Zimire, Etaane Hemaane, Kalkolenne Daara. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />Zaraahe zereththafe gidida Karme naa Akaaney Xoossas dummatida di7o miishshafe kaysotidi qottida gishshas Isra7eele deraa bolla meto ehides.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JOS 7:1">Iya 7:1</ref></char></note> <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />Etaaneykka Azaariya geetettiza issi attuma naa yelides.<verse eid="1CH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />Hexiroomey heedzdzu attuma nayta yelides; heytikka Yerahim7eele, Aaraamenne Kaalube.<verse eid="1CH 2:9" /></para>
  <para style="s1">Kawo Dawite Yeleta Zarkke</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 2:10" />Aaraamey Aminadaabe yelides; Aminadaabey Yuhuda naytas halaqa gidida Ne7asoone yelides. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Ne7asooney Salamo yelides; Salamoykka Boo7eeze yelides. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boo7eezey Iyoobeede yelides; Iyoobeedeykka Isseye yelides.<verse eid="1CH 2:12" /></para>
  <para style="s1">Isseye Attuma Nayta</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 2:13" />Isseye bayra naazi Elyaabe; Elyaabe kaaloti Abinadaabe, Shim7a, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Natina7eele, Eraade, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Oxeemenne Dawite. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Istta michcheti Xuriyanne Abigaalo geetetteettes; Xuriyay Abisaye, Iyo7aabenne Asaheele geetettiza heedzdzu attuma nayta yeladus. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigaala Isma7eele zereththafe gidida Yootores Amasa geetettiza attuma naa yeladus.<verse eid="1CH 2:17" /></para>
  <para style="s1">Hexiroome Naa Kaalebe Zereththata</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />Hexiroome naa Kaalebey Azubbo geetettizaaro machcho ekkidi Yir7aato geetettiza macca naa yelides; Yir7aatakka Yeshere, Shoobaabenne Ardoone geetettiza heedzdzu attuma nayta yeladus. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Azubba hayqqidaappe guye Kaalebey Efraato machcho ekkidi Huure geetettiza attuma naa yelides. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Huureykka Uure geetettiza attuma naa yelides; Uurey Basli7eele yelides.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />Hexiroomey izas 60 layth kumishin Gala7aade aawa Maakire nayo machcho ekkidi Sagube yelides. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Sagubeykka Ya7ire yelides; Ya7irey Gala7aade deren diza 23 katamata ayssees. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Gido attiin Geeshureynne Aaraamey Qenaateninne izi heeran diza 60 qeeri katamatanne Ya7ire katamata oli oykkida; heyti ubbayka Gala7aade aawa Maakire zereththata. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />Hexiroomey Kaalebe Efraata geetettizason hayqqidaappe guye iza machcha Abiyay Tequhe aawa Ashihuure izas yeladus.<verse eid="1CH 2:24" /></para>
  <para style="s1">Hexiroome Naa Yirahim7eele Zereththata</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Hexiroomes bayra naazi Yerahim7eeley 5 attuma nayta yelides; heytappe bayrazi Eraama, iza kaaloti Buna, Oore, Oxeemenne Akaya geetetteettes.<verse eid="1CH 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 2:26" />Yerahim7eeles Axaaro geetettiza hara machcha dawus; iza Oonname aayo. <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />Yerahim7eeles bayra naa Eraamay Maaxe, Yaaminenne Eqere geetettiza attuma nayta yelides.<verse eid="1CH 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 2:28" />Oonnamey Shamayenne Yaadda geetettiza attuma nayta yelides; Shamayey Nadaabenne Abishuure geetettiza attuma nayta yelides.<verse eid="1CH 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 2:29" />Abishuureykka Abihaylo geetettizaaro machcho ekkidi Ahibaanenne Moolide yelides. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />Nadaabey Seledenne Afayme yelides; Seledey gidikko naa yelontta hayqqides.<verse eid="1CH 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 2:31" />Afaymey Yushi7e yelides; Yushi7ey Sheshaane yelides; Sheshaaney Ahilaye yelides. <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />Shamaye isha Yaadday Yootorenne Yoonataane yelides; Yootorey gidikko naa yelontta hayqqides. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Yoonataaney Paletenne Zaaza geetettiza 2 attuma nayta yelides; heyti wurikka Yerahim7eele zereththata. <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />Sheshaanes macca naytappe attiin hara attuma nay deenna; izas ooththiza Gibxe dere as Yaraha geetettiza oosanchchay dees. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sheshaaney ba macca nayo Yarahas machcho gidana mala immides; izakka izas Attaye geetettiza attuma naa yeladus. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Attayey Naataane yelides; Naataaney Zabaade yelides; <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />Zabaadey Efilaale yelides; Efilaaley Iyoobeede yelides; <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Iyoobeedey Iyu yelides; Iyuy Azaariyaasa yelides; <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Azaariyaasi Heleexe yelides; Heleexey El7aasa yelides; <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />El7aasay Sismaye yelides; Sismayey Shaloome yelides; <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Shaloomey Yiqaamiyanne Elshama yelides.<verse eid="1CH 2:41" /></para>
  <para style="s1">Hankko Attida Kaalebe Yeleta Zarkketa</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Yerahim7eele isha Kaalebey bayra naaza Mesha yelides; Meshay Ziife yelides; Ziifey Mareesha yelides; Mareeshayka Kebroone yelides. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Kebrooneykka Qoore, Taaphphuhe, Ereqeemenne Shema7e geetettiza attuma nayta yelides. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Shema7eykka Erahaame yelides; Erahaamey Ereqeeme yelides; Ereqeemey Shamaye yelides. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Shamayey Ma7oone yelides; Ma7ooneykka Beeti-Xuure yelides.<verse eid="1CH 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 2:46" />Kaalebes Eefo geetettiza laggeththo machcha dawus; Kaalebey izippe Kaaraane, Moozanne Gazaze geetettiza hara 3 attuma nayta yelides; Haaraaneykka Gazaze geetettiza hara attuma naa yelides.<verse eid="1CH 2:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47" />Yaahiday Ergeme, Iyo7aatame, Geshaane, Paleexe, Eefanne Sha7aafe geetettiza attuma nayta yelides. <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />Kaalebes Ma7ika geetettiza laggeththo machcha dawus; izakka Sheberenne Tirihaana geetettiza attuma nayta yeladus. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Qasseka Ma7ika Sha7aafenne Shawa yeladus; Sha7aafey Madimaana yelides; Shaway Makibaanenne Gibi7a yelides. Kaalebes Akisa geetettiza macca nay dawus.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />Kaalebey yelida hara nayti hayssafe kaalli dizayta; Kaalebey Efraatippe bayra naaza Uure yelides; Uurey Qiriyaate-Yi7aarime aawa Shobaale. <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Beeteliheeme aawaa Salamonne Beeti-Gadera aawaa Hareefe yelides.<verse eid="1CH 2:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1CH 2:52" />Qiriyaate-Yi7aarime aawa Shobaale zereththati, Heroheetenne Manahaate qommotappe baggata. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />Qasseka Qiriyaate-Yi7aarime zarkketi Yatireta, Puuteta, Shumaateta, Mishiirata, Xora7aatanne Eshtta7ooleta.<verse eid="1CH 2:53" /></para>
  <para style="s1">Salma Zereththata</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54" />Salamo nayti Beeteliheeme, Naxoofeta, Axiroota, Beet Iyo7aabe, Manahaatetappe baggatanne Haxooreta. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />Yaabexe katamaan diza xaafizayta zareti qasse Tir7ata, Shim7aatanne Sukoote; hayti Erekaabeta aawaa Hamaateppe yelettida Qenaaweta.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">Kawo Dawite Nayta Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Dawiti Kebroonen dishe yelida attuma nayta sunththi hayssafe kaalli dizayta;</para>
  <para style="q2" vid="1CH 3:1">bayra naa Aminoone</para>
  <para style="q2" vid="1CH 3:1">Izra7eele dere maccas</para>
  <para style="q2" vid="1CH 3:1">Ahinahoomppe yelides;</para>
  <para style="q2" vid="1CH 3:1">iza kaalo Daaneela</para>
  <para style="q2" vid="1CH 3:1">Qarmeloose dere maccas</para>
  <para style="q2" vid="1CH 3:1">Abigaalippe yelides.<verse eid="1CH 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 3:2" />Heedzdzanththoza Abeseloome</para>
  <para style="q2" vid="1CH 3:2">Geeshure kawo Talimaye naa</para>
  <para style="q2" vid="1CH 3:2">Ma7ikippe yelides.</para>
  <para style="q2" vid="1CH 3:2">Oydanththoza Adoniyaasa</para>
  <para style="q2" vid="1CH 3:2">Hagitippe yelides.<verse eid="1CH 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 3:3" />Ichchashanththoza Shafaaxiya</para>
  <para style="q2" vid="1CH 3:3">Abixaalippe yelides</para>
  <para style="q1" vid="1CH 3:3">Usuppunththoza Yitiraame</para>
  <para style="q2" vid="1CH 3:3">Eglippe yelides.<verse eid="1CH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 3:4" />Hayti usuppunati Dawiti Kebroonen laappun layththinne bagga deraa ayssiza wode yelettida; Dawiti Yerusalaamen 33 layth kawotides.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2Same 5:4-5</ref>; <ref loc="1KI 2:11">1Kawo 2:11</ref>; <ref loc="1CH 29:27">1Taari 29:27</ref></char></note> <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />Izi heen dishe yelida attuma nayti hayssafe kaalli dizayta;</para>
  <para style="p" vid="1CH 3:5">Am7eele naa Bersaabeha Shim7a, Shoobaabe, Naataanenne Solomoone geetettiza oyddu attuma nayta izas yeladus.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="2SA 11:3">2Same 11:3</ref></char></note><verse eid="1CH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 3:6" />Qasse hara uddufun attuma nayti izas deettes; heytikka Iyabeheere, Elsu7e, Elfaleexe <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Nogahe, Nefege, Naafiya, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elshama, El7aadanne Elfaleexe geetettizayta. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Heytappeka hara Dawiti garadetappe yelida attuma nayti deettes; isttaskka Ti7imaaro geetettiza michcha dawus.<verse eid="1CH 3:9" /></para>
  <para style="s1">Kawo Solomoone Nayta Zarkke</para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 3:10" />Kawo Solonooney</para>
  <para style="q2" vid="1CH 3:10">Erobi7aame yelides;</para>
  <para style="q2" vid="1CH 3:10">Erobi7aamey Abiya yelides;</para>
  <para style="q2" vid="1CH 3:10">Abiyay Aasa yelides;</para>
  <para style="q2" vid="1CH 3:10">Aasay Iyoosaafixe yelides;<verse eid="1CH 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 3:11" />Iyoosaafixey Iyoraame yelides;</para>
  <para style="q2" vid="1CH 3:11">Iyoraamey Akaziyaasa yelides;</para>
  <para style="q2" vid="1CH 3:11">Akaziyaasi Iyo7aasa yelides;<verse eid="1CH 3:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="1CH 3:12" />Iyo7aasi Amasiyaase yelides;</para>
  <para style="q2" vid="1CH 3:12">Amasiyaasi Azaariyaase yelides;</para>
  <para style="q2" vid="1CH 3:12">Azaariyaasi Iyo7aatame yelides;<verse eid="1CH 3:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="1CH 3:13" />Iyo7aatamey Akaaze yelides;</para>
  <para style="q2" vid="1CH 3:13">Akaazey Hizqiyaasa yelides;</para>
  <para style="q2" vid="1CH 3:13">Hizqiyaasi Minaase yelides;<verse eid="1CH 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="1CH 3:14" />Minaasey Amoone yelides;</para>
  <para style="q2" vid="1CH 3:14">Amooney Iyosiyaasa yelides,<verse eid="1CH 3:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="1CH 3:15" />Iyosiyaasi oyddu</para>
  <para style="q2" vid="1CH 3:15">attuma nayta yelides;</para>
  <para style="q2" vid="1CH 3:15">bayrazi Yohanaane,</para>
  <para style="q2" vid="1CH 3:15">iza kaaloti Iyo7aaqeme,</para>
  <para style="q2" vid="1CH 3:15">Sedeqiyaasanne Shaloome;<verse eid="1CH 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="1CH 3:16" />Iyo7aaqemey Ikoniyaanenne</para>
  <para style="q2" vid="1CH 3:16">Sedeqiyaasa yelides.<verse eid="1CH 3:16" /></para>
  <para style="s1">Kawo Ikoniyaane Nayta Zarkke</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />Baabiloone di7etti bida Ikoniyaane nayti Salatiyaale, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malikraame, Paddaya, Shenaxaare, Yiqaamiya, Hoshamenne Nadabiya geetettizayta. <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />Paddayay Zerubaabelenne Shim7e yelides; Zerubaabeleykka Mashulaame, Hanaaniyanne istta michcho Shalomito yelides. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Qasseka hara ichchash attuma nayti izas deettes; heytikka Hashube, Ohele, Baraakaye, Hasadiyanne Yoshaabi-Hesside.<verse eid="1CH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21" />Hanaaniyay Palaaxiyanne Yesha7iya geetettiza nam7u attuma nayta yelides; Yesha7iyaykka Erafaya yelides; Erafayay Ornaane yelides; Ornaaney Abdiyu yelides; Abdiyuy Shakaaniya yelides. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />Shakaaniyaykka Shama7e yelides; Shama7ey Haxushe, Yigi7aale, Baaryahe, Narayanne Saafaaxe geetettizayta 5 attuma nayta yelides; Shakaaniya zereththati kumeththi usuppuna. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />Narayay Elyo7enaye, Hizqiyaasanne Azirqaame geetettiza 3 attuma nayta yelides. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />Elyo7enayey Hoddaye, Elyaasheebe, Pelaaya, Aqube, Yohanaane, Dallayanne Anaane geetettiza 7 attuma nayta yelides.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">Yuhuda Yeleta Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Yuhuda zereththati Paareese, Hexiroome, Karme, Huurenne Shobaale. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />Shobaaley Era7aye yelides; Era7ayeykka Yahaate yelides; Yahaateykka Xora7aatas koyro aawa gididayta Ahumayenne Lahade yelides. <verse eid="1CH 4:2" /><verse number="3-4" style="v" sid="1CH 4:3-4" />Huurey ba aayo Efraatas bayra naa; Huurey Beeteliheeme yelides; Exaame attuma nayti Izra7eele, Yushimanne Yidibaashe; isttas michcha Haxilelipoono geetettawus; Panu7eeley Gadoore yelides. Ezeerey Huushe yelides; hayti Huure zareta.<verse eid="1CH 4:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5" />Tequhe aawa Ashihuures Heelonne Na7iro geetettiza nam7u machcheti deettes. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Ashihuurey Na7iro geetettiza ba machcheyfe Ahuzaame, Hefeere, Temenanne Ahashitaare geetettiza attuma nayta yelides. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Qasseka Heelippe Xerete, Xoohaare, Etinanne Qoxe yelides. <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />Haqoxey Anuube, Xobaabenne Haruume naa Aharheele zereththatas aawa.<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Yabeexey ba ishata giddon keehi bonchchettida as gidides; iza aaya, «Tani iita miixan yelidayssa» gashe iza, «Yaabexe» ga sunththadus. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yabeexeykka, «Abeet Godawu! Ne tana anjja; ne ta deraa aassa; ne kushey tanara de7o; tana metoppenne qohoppe ashsha» giidi Isra7eele Xoossaa woossides; Xoossika izi woossidayssa izas immides.<verse eid="1CH 4:10" /></para>
  <para style="s1">Hara Asata Yeleta Zarkke</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />Shuhaha isha Kaalubey Mahire yelides; Mahirey Eshtoone yelides. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshtooney Beeti-Rafa, Fasahenne Ir-Nahaashe aawa Tahina geetettiza attuma nayta yelides; Tahinay Na7aashe geetettiza katama essides; heyta zereththati kase Arakka geetettiza deren deettes.<verse eid="1CH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13" />Qanaazey Otin7eelenne Saraya geetettiza nam7u attuma nayta yelides; Otin7eeleykka Hataatenne Ma7onotaye geetettiza nam7u attuma nayta yelides.<verse eid="1CH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 4:14" />Ma7onotayey Oofira yelides.</para>
  <para style="p" vid="1CH 4:14">Sarayaykka kushe hiillanchchati diza Geharishimo geetettiza katamayo essida Iyo7aabe yelides.<verse eid="1CH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 4:15" />Yoofine naa Kaalebey Iro, Eelanne Na7ema geetettiza attuma nayta yelides; Eelay Qenaaze yelides.<verse eid="1CH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16" />Yuhalel7eeley Ziife, Ziifa, Tiriyanne Asar7eele geetettiza attuma nayta yelides. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />Eziray Yootore, Mereede, Eferenne Yaloone yelides; Mereedey Gibxe kawo nayo Bityo machcho ekkidi Maaramo geetettiza macca nayo, Shamayenne Eshttamo7a aawa Yishiba yelides. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Mereedey Gadoore aawa Yaareede, Sooko aawa Heebere, Zaanohe aawa Yiquti7eele Ayhuda dere maccassayfe yelides; heytikka Gibxe kawo nayo Bitya Mereedes yelida zareta.<verse eid="1CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 4:19" />Hoddiyay Nahaamo michcho ekkides; iza Garimite dere as Qi7ila aawaanne Ma7ikate dere as Eshttamo7a aawa yeladus.<verse eid="1CH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 4:20" />Shimooni Aminoone, Eraane, Beeni-Hanaanenne Tilone yelides;</para>
  <para style="p" vid="1CH 4:20">Yishi7ey Zoheetenne Beeni-Zoheete yelides.<verse eid="1CH 4:20" /></para>
  <para style="s1">Seela Nayta Zarkke</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />Yuhuda naa Seela zareti Lekka aawaa Eera, Mareesha aawaa Laadanne Beeti-Ashibe7a katamaan de7iza layno daddizayta qommotas aawa.<verse eid="1CH 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 4:22" />Harati qasse Yoqiime, Iyo7aasa, Yashubiliheeme, Mo7aabe biitta haarida Saraafanne Kozeebe katama asata; (ha yeletata taarike mazgabay beniisofe dees.) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Istti kawo keeththa oosos urqqa medhdhizayta gididi kase Naxaamenne Gadeere geetettiza katamatan de7ida.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simoona Nayta Zarkke</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />Simooni Namu7eele, Yaamine, Yaribe, Zaraahenne Sha7ule yelides. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />Sha7uleykka Shaloome yelides; Shaloomey Mibisaame yelides; Mibisaamey Mishima7e yelides. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />Mishima7ey Hamu7eele yelides; Hamu7eeley Zakure yelides; Zakurey Shim7e yelides;<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Shim7ey tammanne usuppun attuma naytanne usuppun macca nayta yelides; iza ishati gidikko daro nayta yelibeettenna; hessa gishshas Simoona zarkketi Yuhuda zarkketa mala daribeettenna.<verse eid="1CH 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 4:28" />Simoona zareti Bersaabehe katamaninne Molaade, Haxaare-Shu7aale, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Biliha, Exeeme, Tolaade, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Baatu7eele, Horma, Xigilaage, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Beeti-Markaboote, Haxaare-Susiime, Beeti-Baarenne Shaa7irayme katamatan de7ida; Dawiti kawotana gakkanaas heyti istta katamata gidida. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Qasse istta mooththati Exaame, Ayine, Armoone, Tokeenenne Ashaane; istti mulera ichchash katamata. <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />Ba7aala gakkanaas ha katamata yuushon diza mooththati ubbay istta bolla gujetteettes; heyti istti de7idasohotanne istta yeletata maaran mazgaban xaafi oykkida.<note caller="-" style="x"><char style="xo" closed="false">4:28-33 </char><char style="xt" closed="false"><ref loc="JOS 19:2-8">Iya 19:2-8</ref></char></note><verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />Simoona zareta halaqati hayssafe kaalli xaafettidayta; isttika Mashobaabe, Yaamlaake, Amasiyaase naa Yooshsha, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Iyu7eele, Yoshiibiya naa Iyu, (Saraya naa Yoshiibiya, Asa7eele naa Saraya,) <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />Elyo7enaye, Yaakoobe, Shohaaya, Asaaya, Adi7eele, Yashim7eele, Bannayanne Ziiza.<verse eid="1CH 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 4:37" />Ziizay Shif7a naa, Shif7ay Aloone naa, Alooney Yeddaya naa, Yeddayay Shimire naa, Shimirey Shama7e naa.<verse eid="1CH 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />Hayssafe bollan xaafettida asati bantta zarkketas zarkketas korapinneta; isttaso asata zereththi keehippe coratti coratti bides. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />Istti bantta mehetas heenththasoho koyanaas Gadoore gelizaso matan diza shoobbaafe arshey mokkiza baggara dizasota gakkanaas bida. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Istti heen keehippe araddanne lo7o heenththasoho demmida; he biittaya woppaynne saroy kumida aaho biitta; kase heen Kaame zereththati deettes.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Hayssafe bollara istta sunththay xaafettida Simoona zareti Yuhuda Kawo Hizqiyaasa wode Gadoore biitta biidi heen diza Kaame zereththatanne Ma7uune asata olidi dhayssidayta; histtidi he biittan istta mehetas heemmizasohoy diza gishshas Simoona zareti hach gakkanaas heen uttida. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Simoona zaretappe 500 asati Seyre zumaakko bida; istta halaqati Palaaxiya, Naraya, Erafayanne Uzi7eele; heytantti Yishi7e nayta. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Kase baqati attida Amaaleeqe asata Simoona zareti dhayssida; istti hach gakkanaas he biittan deettes.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Oroobeele Nayta Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Yaaqoobes koyro bayra naa Oroobeele zereththati hayssafe kaalli dizayta; Oroobeeley ba aawa hiixa tunisida gishshas iza bayrateththa maatay Yooseefe zereththatas imettides; hessafe dendoyssan iza zereththati bayrateththa maaran xaafettibeettenna.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="GEN 35:22">Medhe 35:22</ref>; <ref loc="GEN 49:3-4">49:3-4</ref></char></note> <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Bayrateththa maatay Yooseefe zereththatas imettikokka Yuhuday ba ishata giddon mino gidida gishshas dere ayssizaadey iza zereththafe kezides.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="GEN 49:8-10">Medhe 49:8-10</ref></char></note> <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Yaaqoobes bayra naa Oroobeele attuma nayti Heenooke, Paalu, Hexiroomenne Karme geetettizayta.<verse eid="1CH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 5:4" />Iyu7eele nay Shama7e, Shama7e nay Googe, Googe nay Shim7e, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Shim7e nay Mikiyaasa, Mikiyaasa nay Era7aye, Era7aye nay Ba7aale, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />Ba7aale nay Be7eera. Oroobeele qommos korapinne gidida Be7eera Asoore Kawo Teligelitelifelisoorey di7i ekki bides.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="2KI 15:29">2Kawo 15:29</ref></char></note><verse eid="1CH 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 5:7" />Ba7eera zareti bantta yeleta mazgaban xaafettida Oroobeele zereththata halaqati Yi7i7eele, Zakaraasanne Beela. <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />Beelay Azaaza naa; Azaazi Shema7e naa; Shema7ey Iyu7eele naa; Iyu7eele zareti Aaro7eereppe biidi Nebonne Ba7aali-Me7oone gakkanaas dunkaani uttida.<verse eid="1CH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 5:9" />Oroobeele zareta mehey Gala7aaden corattida gishshas istti heeppe arshey mokkiza baggan diza Efiraaxise Shaafappe biidi bazzaas gaxa gakkanaas dunkaani uttida. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />Sa7oole kawoteththa layththan Aggaari zareti Oroobeele zaretara olettiin Oroobeele zareti xoonida; histtidi Gala7aadeppe arshey mokkiza baggara diza Aggaari zareta biittan dunkaani uttida.<verse eid="1CH 5:10" /></para>
  <para style="s1">Gaade Nayta Zarkke</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Gaade zareti Oroobeele zaretappe pudeha baggara biidi Salaaka gakkanaas diza Baasaane biittan dunkaani uttida. <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Koyro zereththata halaqay Iyu7eele; nam7anththo zereththata halaqay Shafaame; qasseka Baasaanen dunkaani uttidayta halaqay Ya7inayenne Saafaaxe. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Hankko attida laappun zarkketa halaqati, Mika7eele, Mashulaame, Sheba7e, Yooraye, Yikaane, Zi7anne Eboore. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />Hayti Abi7eele nayti Buuze zareta; Buuzey Yaahida yelides; Yaahiday Yeshishaaye yelides; Yeshishaayey Mika7eele yelides; Mika7eeley Gala7aade yelides; Gala7aadey Yaarooha yelides; Yaaroohay Huure yelides; Huurey Abihayle yelides. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Istta zarkketa halaqay Gune naaza Abi7eele naa Ahi. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />Hayti wurikka Baasaaneninne Gala7aaden he dere katamataninne Lasharoone biitta mehe heemmizasoho ubbaan dunkaani uttida. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />Hayta ubbata zereththati Yuhuda Kawo Iyo7aatame wodeninne Isra7eele Kawo Iyorba7aame wode zareta mazgaban xaafettida.<verse eid="1CH 5:17" /></para>
  <para style="s1">Yordaanoose Shaafappe Arshey Mokkiza Baggara Uttida Qommota</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Oroobeelesi, Gaade qommotassinne Minaase qommofe baggatas 44,760 mino olanchchati deettes; isttika gondalle oyth, mashsha oyththinne wondafen oleteth eriza mino olanchchata. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Heytikka Aggaaretara, Yixuretara, Nafishaaneranne Nadaabe dere asaara olettanaas worajjida. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Ba ammano Xoossa bolla yeggidi izi istta maaddana mala Xoossa woossida. Xoossika istta woosaa siyidi Aggaaretanne isttara diza harata istta kushen aaththi immides. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Istti bantta morkketa kusheppe 50,000 gaamella, 250,000 dorsinne 2,000 hareta di7ida; hessaththoka 100,000 as di7i ekkida. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Olazi Xoossaafe gidida gishshas daroti hayqqida; xoonidayti guyeppe di7eteththa layththi wurana gakkanaas he asata soon uttida.<verse eid="1CH 5:22" /></para>
  <para style="s1">Arshey Mokkiza Baggara Diza Minaase Qommota</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Minaase qommotappe bagga zareti Baasaaneppe doommidi Ba7aali-Hermoone, Sanirenne Hermoone zumaa gakkanaas diza deren dunkaani uttida; istti heen coratti coratti bida. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Istta zarkketa halaqati Efere, Yishi7e, El7eele, Azari7eele, Ermaasa, Hoddayenne Yahida7eele; heyti wurikka ba zarkken zarkken erettida asata, halaqatanne ola qarata.<verse eid="1CH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />Gido attiin istti bantta aawata Xoossaas ammanettibeettenna; Xoossi istta sinththafe dhayssida he biitta asati goynniza eeqa xoossatas goynon laymatida. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Hessa gishshas Isra7eele Xoossay Asoore kawo Puule woykko Teligelitelifelisoore denththeththidi Oroobeele qommota, Gaade qommotanne Minaase qommotappe baggaa di7i efana mala ooththides; izi heytantta Alahe, Haboore, Haaranne Gozaane shaafa heeran de7ana mala ooththides; istti hach gakkanaas heen deettes.<note caller="-" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="2KI 15:19">2Kawo 15:19</ref>,<ref loc="2KI 15:29">29</ref>; <ref loc="2KI 17:6">17:6</ref></char></note><verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Lewe Nayta Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Lewe nayti Gershoone, Qa7aatenne Meraare.<verse eid="1CH 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="1CH 6:2" />Qa7aate nayti</para>
  <para style="q2" vid="1CH 6:2">Amiraame, Yixihaare,</para>
  <para style="q2" vid="1CH 6:2">Kebroonenne Uzi7eele.<verse eid="1CH 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="1CH 6:3" />Amiraame nayti Aaroone,</para>
  <para style="q2" vid="1CH 6:3">Musenne Maaramo.</para>
  <para style="q2" vid="1CH 6:3">Aaroone attuma nayti</para>
  <para style="q2" vid="1CH 6:3">Nadaabe, Abihu,</para>
  <para style="q2" vid="1CH 6:3">El7ezeerenne Itamaare.<verse eid="1CH 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 6:4" />El7ezeerey Finihaase yelides;</para>
  <para style="q2" vid="1CH 6:4">Finihaasi Abishu7a yelides;<verse eid="1CH 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="1CH 6:5" />Abishu7ay Buuqa yelides;</para>
  <para style="q2" vid="1CH 6:5">Buuqay Uuze yelides;<verse eid="1CH 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="1CH 6:6" />Uuzey Zarahiya yelides;</para>
  <para style="q2" vid="1CH 6:6">Zarahiyay Marayoote yelides;<verse eid="1CH 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="1CH 6:7" />Marayootey Amaariya yelides;</para>
  <para style="q2" vid="1CH 6:7">Amaariyay Ahixuube yelides;<verse eid="1CH 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 6:8" />Ahixuubey Saadooqe yelides;</para>
  <para style="q2" vid="1CH 6:8">Saadooqey Akimaase yelides;<verse eid="1CH 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 6:9" />Akimaasi Azaariyaase yelides;</para>
  <para style="q2" vid="1CH 6:9">Azaariyaasi Yohanaane yelides;<verse eid="1CH 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanaaney Azaariyaase yelides;</para>
  <para style="q2" vid="1CH 6:10">Azaariyaasi kawo Solomooney</para>
  <para style="q2" vid="1CH 6:10">Yerusalaamen keexisida</para>
  <para style="q2" vid="1CH 6:10">Xoossa Keeththaan</para>
  <para style="q2" vid="1CH 6:10">qeeseteththan ooththides.<verse eid="1CH 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 6:11" />Azaariyaasi Amaariya yelides;</para>
  <para style="q2" vid="1CH 6:11">Amaariyay Ahixuube yelides;<verse eid="1CH 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 6:12" />Ahixuubey Saadooqe yelides;</para>
  <para style="q2" vid="1CH 6:12">Saadooqey Shaloome yelides;<verse eid="1CH 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 6:13" />Shaloomey Kilqiyaasa yelides;</para>
  <para style="q2" vid="1CH 6:13">Kilqiyaasi Azaariyaase yelides;<verse eid="1CH 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 6:14" />Azaariyaasi Saraya yelides;</para>
  <para style="q2" vid="1CH 6:14">Sarayay Iyosaadoqe yelides.<verse eid="1CH 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 6:15" />GODAY Yuhuda asaanne</para>
  <para style="q2" vid="1CH 6:15">Yerusalaame asaa</para>
  <para style="q2" vid="1CH 6:15">Nabukadanaxooren di7issida wode</para>
  <para style="q2" vid="1CH 6:15">Iyosaadoqeykka isttara</para>
  <para style="q2" vid="1CH 6:15">di7etti bides.<verse eid="1CH 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 6:16" />Lewe attuma nayti Gershoone,</para>
  <para style="q2" vid="1CH 6:16">Qa7aatenne Meraare.<verse eid="1CH 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 6:17" />Gershoone nayti</para>
  <para style="q2" vid="1CH 6:17">Libinanne Shim7e;<verse eid="1CH 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 6:18" />Qa7aate nayti</para>
  <para style="q2" vid="1CH 6:18">Amiraame, Yixihaare,</para>
  <para style="q2" vid="1CH 6:18">Kebroonenne Uzi7eele;<verse eid="1CH 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 6:19" />Meraare nayti Mahilenne Mushe; bantta aawa keeththan keeththan xaafettida Lewe zarkketi hayssafe kaalli dizayta;<note caller="-" style="x"><char style="xo" closed="false">6:16-19 </char><char style="xt" closed="false"><ref loc="EXO 6:16-19">Kessa 6:16-19</ref></char></note><verse eid="1CH 6:19" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="20" style="v" sid="1CH 6:20" />Gershoone zereththata;</para>
  <para style="q2" vid="1CH 6:20">Gershooney Libina yelides;</para>
  <para style="q2" vid="1CH 6:20">Libinay Yahaate yelides;</para>
  <para style="q2" vid="1CH 6:20">Yahaatey Ziima yelides;<verse eid="1CH 6:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="1CH 6:21" />Ziimay Yo7aaha yelides;</para>
  <para style="q2" vid="1CH 6:21">Yo7aahi Iddo yelides;</para>
  <para style="q2" vid="1CH 6:21">Iddoy Zaraahe yelides;</para>
  <para style="q2" vid="1CH 6:21">Zaraahey Ye7atire yelides;<verse eid="1CH 6:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="1CH 6:22" />Qa7aate zereththata;</para>
  <para style="q2" vid="1CH 6:22">Qa7aatey Aminadaabe yelides;</para>
  <para style="q2" vid="1CH 6:22">Aminadaabey Qoore yelides;</para>
  <para style="q2" vid="1CH 6:22">Qoorey Assire yelides;<verse eid="1CH 6:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="1CH 6:23" />Assirey Hilqaana yelides;</para>
  <para style="q2" vid="1CH 6:23">Hilqaanay Abiyaasaafe yelides;</para>
  <para style="q2" vid="1CH 6:23">Abiyaasaafey Assire yelides;<verse eid="1CH 6:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="1CH 6:24" />Assirey Tahaate yelides;</para>
  <para style="q2" vid="1CH 6:24">Tahaatey Ur7eele yelides;</para>
  <para style="q2" vid="1CH 6:24">Ur7eeley Ooziya yelides;</para>
  <para style="q2" vid="1CH 6:24">Ooziyay Sa7oole yelides.<verse eid="1CH 6:24" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="25" style="v" sid="1CH 6:25" />Hilqaana zereththata;</para>
  <para style="q2" vid="1CH 6:25">Hilqaanay Amasayenne</para>
  <para style="q2" vid="1CH 6:25">Ahimoote yelides;<verse eid="1CH 6:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="1CH 6:26" />Ahimootey Hilqaana yelides;</para>
  <para style="q2" vid="1CH 6:26">Hilqaanay Xoofaye yelides;</para>
  <para style="q2" vid="1CH 6:26">Xoofayey Nahaate yelides;<verse eid="1CH 6:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="1CH 6:27" />Nahaatey Elyaabe yelides;</para>
  <para style="q2" vid="1CH 6:27">Elyaabey Yirohaame yelides;</para>
  <para style="q2" vid="1CH 6:27">Yirohaamey Hilqaana yelides.<verse eid="1CH 6:27" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="28" style="v" sid="1CH 6:28" />Sameeli nam7u</para>
  <para style="q2" vid="1CH 6:28">attuma nayta yelides;</para>
  <para style="q2" vid="1CH 6:28">bayrazi Iyu7eele;</para>
  <para style="q2" vid="1CH 6:28">iza kaalozi Abiya.<verse eid="1CH 6:28" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="29" style="v" sid="1CH 6:29" />Meraare zereththata;</para>
  <para style="q2" vid="1CH 6:29">Meraarey Mahile yelides;</para>
  <para style="q2" vid="1CH 6:29">Mahiley Libina yelides;</para>
  <para style="q2" vid="1CH 6:29">Libinay Shim7e yelides;</para>
  <para style="q2" vid="1CH 6:29">Shim7ey Uuzahe yelides;<verse eid="1CH 6:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 6:30" />Uuzahey Shim7a yelides;</para>
  <para style="q2" vid="1CH 6:30">Shim7ay Haggiya yelides;</para>
  <para style="q2" vid="1CH 6:30">Haggiyay Asaaya yelides.<verse eid="1CH 6:30" /></para>
  <para style="s1">Xoossa Keeththan Yexxizayta</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Dawiti Caaqo Qaala Taabotaa Yerusalaame ehidaappe guye Godaa Xoossa Keeththan mazamure yexxizaytas halaqata shuumides. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Kawo Solomooney Yerusalaamen Godaa Xoossaa Keeththa keexxanaashe gakkanawu Gaytoteththa Dunkaane pengen mazamure yexxishe gam7ida; baas imettida ooso maaran maaran ooththi polishe de7ida.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Bantta naytara issife yexxizayti hayssafe kaalli xaafettidayta;</para>
  <para style="q1" vid="1CH 6:33">Qa7aate zarkketappe yexxizay Hemaane;</para>
  <para style="q2" vid="1CH 6:33">Hemaaney Iyu7eele naa;</para>
  <para style="q2" vid="1CH 6:33">Iyu7eeley Sameela naa;<verse eid="1CH 6:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="1CH 6:34" />Sameeli Hilqaana naa;</para>
  <para style="q2" vid="1CH 6:34">Hilqaanay Yirohaame naa;</para>
  <para style="q2" vid="1CH 6:34">Yirohaamey El7eele naa;</para>
  <para style="q2" vid="1CH 6:34">El7eeley Tooha naa;<verse eid="1CH 6:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="1CH 6:35" />Toohi Zuufe naa;</para>
  <para style="q2" vid="1CH 6:35">Zuufey Hilqaana naa;</para>
  <para style="q2" vid="1CH 6:35">Hilqaanay Mahaate naa;</para>
  <para style="q2" vid="1CH 6:35">Mahaati Amaasaye naa;<verse eid="1CH 6:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="1CH 6:36" />Amaasayey Hilqaana naa;</para>
  <para style="q2" vid="1CH 6:36">Hilqaanay Iyu7eele naa;</para>
  <para style="q2" vid="1CH 6:36">Iyu7eeley Azaariyaase naa;</para>
  <para style="q2" vid="1CH 6:36">Azaariyaasi Sofonaasa naa;<verse eid="1CH 6:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 6:37" />Sofonaasi Tahaate naa;</para>
  <para style="q2" vid="1CH 6:37">Tahaatey Assire naa;</para>
  <para style="q2" vid="1CH 6:37">Asirey Abiyaasaafe naa;</para>
  <para style="q2" vid="1CH 6:37">Abiyaasaafi Qoore naa;<verse eid="1CH 6:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="1CH 6:38" />Qoorey Yixihaare naa;</para>
  <para style="q2" vid="1CH 6:38">Yixihaarey Qa7aate naa;</para>
  <para style="q2" vid="1CH 6:38">Qahaatey Lewe naa;</para>
  <para style="q2" vid="1CH 6:38">Lewey Isra7eele naa.<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />Emaane dabbo Aasaafey izas ushachcha baggara eqqidi ooththees;</para>
  <para style="q1" vid="1CH 6:39">Aasaafey Baraakaye naa;</para>
  <para style="q2" vid="1CH 6:39">Baraakayey Shim7a naa;<verse eid="1CH 6:39" /></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 6:40" />Shim7ay Mika7eele naa;</para>
  <para style="q2" vid="1CH 6:40">Mika7eeley Ba7aseya naa;</para>
  <para style="q2" vid="1CH 6:40">Ba7aseyay Malkiya naa;<verse eid="1CH 6:40" /></para>
  <para style="q2">
    <verse number="41" style="v" sid="1CH 6:41" />Malkiyay Etaane naa;</para>
  <para style="q2" vid="1CH 6:41">Etaaney Zaraahe naa;</para>
  <para style="q2" vid="1CH 6:41">Zaraahey Addaya naa;<verse eid="1CH 6:41" /></para>
  <para style="q2">
    <verse number="42" style="v" sid="1CH 6:42" />Addayay Etaane naa;</para>
  <para style="q2" vid="1CH 6:42">Etaaney Ziima naa;</para>
  <para style="q2" vid="1CH 6:42">Ziimay Shim7e naa;<verse eid="1CH 6:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="1CH 6:43" />Shim7ay Yahaate naa;</para>
  <para style="q2" vid="1CH 6:43">Yahaatey Gershoome naa;</para>
  <para style="q2" vid="1CH 6:43">Gershoomey Lewe naa.<verse eid="1CH 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44" />Isttas hadirsa baggara istta dabbo Meraare zarkketi eqqeettes;</para>
  <para style="q1" vid="1CH 6:44">Etaaney Qiisha naa;</para>
  <para style="q2" vid="1CH 6:44">Qiishi Abide naa;</para>
  <para style="q2" vid="1CH 6:44">Abdey Maallukke naa;<verse eid="1CH 6:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="1CH 6:45" />Maallukkey Hashaabiya naa;</para>
  <para style="q2" vid="1CH 6:45">Hashaabiyay Amasiyaasa naa;</para>
  <para style="q2" vid="1CH 6:45">Amasiyaasi Kilqiyaasa naa;<verse eid="1CH 6:45" /></para>
  <para style="q2">
    <verse number="46" style="v" sid="1CH 6:46" />Kilqiyaasi Amoze naa;</para>
  <para style="q2" vid="1CH 6:46">Amozey Baane naa;</para>
  <para style="q2" vid="1CH 6:46">Baaney Shemere naa;<verse eid="1CH 6:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="1CH 6:47" />Shemerey Mahile naa;</para>
  <para style="q2" vid="1CH 6:47">Mahiley Mushe naa;</para>
  <para style="q2" vid="1CH 6:47">Mushey Meraare naa;</para>
  <para style="q2" vid="1CH 6:47">Meraarey Lewe naa.<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Isttas ishantta gidida hankko Lewe qommoti Xoossa Keeththan Gaytoteththa Dunkaanen oosettiza hara ooso ubbaas doorettida.<verse eid="1CH 6:48" /></para>
  <para style="s1">Aaroone Nayta Zarkke</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />Aarooneynne iza nayti gidikko Xoossa aylle Musey azazida mala Isra7eele deraa nagara wursanaas ubbaafe dummatida giddo qol7aan oosettiza oosota ubbaas, yarsho yarshizasoza bolla xuugettiza yarsho yarshanaassinne Exaane cuwasi yarshizasoza bolla exaane cuwasanaas isttas aawateththi imettides. <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />Aaroone nayta zarkketi hayssafe kaalli xaafettidayta;</para>
  <para style="q1" vid="1CH 6:50">Aaroone nay El7ezeere;</para>
  <para style="q2" vid="1CH 6:50">El7ezeere nay Finihaase;</para>
  <para style="q2" vid="1CH 6:50">Finihaase nay Abishu7a;<verse eid="1CH 6:50" /></para>
  <para style="q2">
    <verse number="51" style="v" sid="1CH 6:51" />Abishu7a nay Buuqa;</para>
  <para style="q2" vid="1CH 6:51">Buuqa nay Uuze;</para>
  <para style="q2" vid="1CH 6:51">Uuze nay Zarahiya;<verse eid="1CH 6:51" /></para>
  <para style="q2">
    <verse number="52" style="v" sid="1CH 6:52" />Zarahiya nay Marayoote;</para>
  <para style="q2" vid="1CH 6:52">Marayoote nay Amaariya;</para>
  <para style="q2" vid="1CH 6:52">Amaariya nay Ahixuube;<verse eid="1CH 6:52" /></para>
  <para style="q2">
    <verse number="53" style="v" sid="1CH 6:53" />Ahixuube nay Saadooqe;</para>
  <para style="q2" vid="1CH 6:53">Saadooqe nay Akimaase.<verse eid="1CH 6:53" /></para>
  <para style="s1">Lewe Qommoti Daana Mala Imettida Sohota</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Aaroone naytas imettida duussa sohoti hayssafe kaalli xaafettida; koyro saamay Qa7aate baggatas kezides; <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Isttas Yuhuda biittan diza Kebroonenne iza heeran diza mehe heemmizasohota immida. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Kebroone yuushon diza goshsha gadetinne mooththati Yoofine naa Kaalebes imettida. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Aaroone naytas shemppo wodhidaadey baqati biidi attiza katamata, Kebroone, Yetire, Libinanne mehe heemmizasohota, Eshttamo7anne mehe heemmizasohota, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hiilenenne mehe heemmizasohota, Dabirenne mehe heemmizasohota, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashaanenne mehe heemmizasohota, Beeti-Shemishenne mehe heemmizasohota immida. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Qasse Biniyaame qommota gadeppe Geebanenne mehe heemmizasohota, Alemeetenne mehe heemmizasohota, Anatootenne mehe heemmizasohota immida; Aaroone naytas imettida katamati mulera tammanne heedzdza.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Arshey wulliza baggara diza Minaase zarkke baggati oykkida gadezappe 10 katamati hankko attida Qa7aate zarkketas imettida.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />Yisakoore zarkketa biittafe, Aaseere zarkketa biittafe, Niftaaleme zarkketa biittafenne Baasaanen diza Minaase zarkketa biittafe 13 katamata Gershoone zarkketas immida. <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />Oroobeele zarkketa biittafe, Gaade zarkketa biittafenne Zaabiloone zarkketa biittafe 12 katamata Meraare zarkketas saaman immida. <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />Hessaththo ooththidi Isra7eele asay Lewetas ha katamatanne istta heeran diza mehe heenththasohota immides. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Hayssafe bollara sunththay isttas xeygettida katamata Yuhuda zarkketappe, Simoona zarkketappe, Biniyaame zarkketappe hara katamatan ooththoyssa mala Saama yeggidi istta gakkidayssa gisha immida.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />Qa7aate zarkketa giddofe issi keeththa asatas Efreeme zarkketa gakkida biittaafe katamatanne mehe heemmizasoho immida. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Isttas shemppo wodhidaadey baqati biidi attiza katamata, Efreeme deren gezze biittan diza Seekeemenne mehe heemmizasohota, Gezeerenne mehe heemmizasohota, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yoqima7aamenne mehe heemmizasohota, Beeti-Horoonenne iza mehe heemmizasohota, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayaaloonenne mehe heemmizasohota, Geet-Ermoonenne mehe heemmizasohota immida. <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />Minaase zarkketa baggafe Aneerenne mehe heemmizasohotanne Balaamanne mehe heemmizasohota ekkidi Qa7aate zarkketappe attidaytas immida.<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />Minaase zarkketa baggafe Baasaanen diza Golaanenne mehe heemmizasohotanne Astarootenne mehe heemmizasohota ekkidi Gershoone zarkketas immida. <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />Qasse Yisakoore zarkketappe Qaadeesenne mehe heemmizasohota, Dabiraatenne mehe heemmizasohota, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Eramootenne mehe heemmizasohotanne Aneemanne mehe heemmizasohota ekkidi isttas immida. <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />Aaseere zarkketappe Mashaalanne mehe heemmizasohota, Abdoonenne mehe heemmizasohota, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Huqooqenne mehe heemmizasohotanne Erahoobenne mehe heemmizasohota ekkidi isttas immida. <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />Hessaththoka Niftaaleme zarkketappe Galilan diza Qaadeesenne mehe heemmizasohota, Hamoonenne mehe heemmizasohotanne Qiriyaataymenne mehe heemmizasohota ekkidi isttas immida.<verse eid="1CH 6:76" /></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />Attida Meraare zarkketas Zaabiloone zarkketappe Armoonenne mehe heemmizasohotanne Taaboorenne mehe heemmizasohota ekkidi immida. <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />Qasse Oroobeele zarkketappe Iyarkko ginan, Yordaanooseppe he pinththan arshey wulliza baggara, bazzon diza Baxiranne mehe heemmizasohota, Yahaaxenne mehe heemmizasohota, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Qidimootenne mehe heemmizasohotanne Mefa7aatenne mehe heemmizasohota ekkidi isttas immida. <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />Gaade zarkketappe Gala7aaden diza Eramootenne mehe heemmizasohota, Mahanaymenne mehe heemmizasohota, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Haseboonenne mehe heemmizasohotanne Iyaazeerenne mehe heemmizasohota ekkidi isttas immida.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Yisakoore Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Yisakoores oyddu attuma nayti deettes; heytikka Tola, Puuwa, Yaashubenne Shimiroone geetettizayta.<verse eid="1CH 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2" />Tola nayti Uuze, Erafaya, Yiri7eele, Yahimaye, Yibisaamenne Sameela; isttika Tola zarkketa halaqata; istti wolqqamanne mino olanchchata; kawo Dawite wode istta qooday 22,600.<verse eid="1CH 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3" />Uuzey Yiziraaheya yelides; Yiziraaheyay Mika7eele yelides; Mika7eeley Abdiyu yelides; Abdiyuy Iyu7eele yelides; Iyu7eeley Yishiya yelides; ha ichchashatikka baso asatas halaqa. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Isttas daro machchetinne nayti diza gishshas isttaso asaa zarkketappe olas gakkida olanchchata qooday 36,000 gidides.<verse eid="1CH 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5" />Yisakoore zarkketappe olas gakkida olanchchati mazgaban qoodettidi 87,000 gidida.<verse eid="1CH 7:5" /></para>
  <para style="s1">Biniyaame Zarkkenne Daane Zarkke</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Biniyaames heedzdzu nayti deettes; isttika Beela, Bekerenne Yidi7eele.<verse eid="1CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7" />Beela nayti Exiboone, Uuze, Uzi7eele, Yarmootenne Iire; ha ichchashatikka baso asatas halaqata; ba yeleta zarkketa mazgaban 22,034 wolqqamanne mino olanchchati mazgabettida.<verse eid="1CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8" />Bekere nayti Zimira, Iyo7aasa, El7ezeere, Elyo7enaye, Omire, Yarmoote, Abiya, Anatootenne Alemeete; hayti ubbati Bekere nayta. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Istti ubbay baso asatas halaqata; ba yeleta zarkketa mazgaban 20,200 wolqqamanne mino olanchchati mazgabettida.<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />Yidi7eele nay Bilihaane; Bilihaane nayti Ya7uushe, Biniyaame, Ehuude, Kin7aane, Zettaane, Tarseesenne Akishahoore; <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />hayti ubbati Yidi7eele nayta; istti baso asatas halaqata; ba yeleta zarkketa mazgaban 17,200 wolqqamanne mino olanchchati mazgabettida.<verse eid="1CH 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 7:12" />Shufimeynne Huppiimey Ire zereththata; Hushimey Aheere zereththa.<verse eid="1CH 7:12" /></para>
  <para style="s1">Niftaaleme Nayta Zarkke</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Niftaaleme nayti Yahixele, Gune, Yexirenne Shaloome; hayti Biliha zereththata.<verse eid="1CH 7:13" /></para>
  <para style="s1">Minaase Nayta Zarkke</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Minaase zareti hayssafe kaalli xaafettidayta; Minaasey Aaraame biittafe ekkida garadeya yelida attuma nayti Asira7eelenne Gala7aade aawa Maakire. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Maakirey Huppimenne Shufime baggafe Ma7ikko machcho ekkides; iza michchey sunththika Ma7ikko geetettees; Maakire zare Xilofaadey macca nayta xalla yelides.<verse eid="1CH 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 7:16" />Maakire machcha Ma7ikay attuma nayta yeladus; bayra naaza Pareesha, iza kaaloza Shereeshe ga sunththadus. Pereesha nayti Ulaamenne Ereqeeme. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />Ulaame nay Badaane; hayti Minaase naa Maakire naa Gala7aade zareta.<verse eid="1CH 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 7:18" />Gala7aade michchiya Hamoleketa Ishawu, Abi7eezerenne Mahile yeladus.<verse eid="1CH 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 7:19" />Shamida nayti Ahiyaane, Seekeeme, Liiqihanne An7aame.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efreeme Nayta Zarkketa</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Efreeme nay Shutula; Shutula nay Baareede; Baareede nay Tahaate; Tahaate nay El7aade; El7aade nay Tahaate; <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Tahaate nay Zabaade; Zabaade nay Shutula.</para>
  <para style="p" vid="1CH 7:21">Efreeme naa Ezeereynne Elaadey mehe kaysana Geete dere biin he biitta asati istta wodhida. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Hessa gishshas istta aawa Efreemey daro wode kayottides; histtiin iza dabboti yiidi iza minththeththida.<verse eid="1CH 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 7:23" />Hessafe guye izi ba machcheyra gayttides; histtiin iza shaarada attuma naa yeladus; iza keeththan gakkida iita metoza gaason naaza Barihe gi sunththides.<verse eid="1CH 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24" />Efreemes She7iro geetettiza macca nay dawus; izakka pude Beeti-Horoone, duge Beeti-Horoonenne Uuzen-She7ira geetettiza katamata essadus.<verse eid="1CH 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 7:25" />Efreemes Erfaha geetettiza hara attuma nay dees; Erfaha nay Eresheefa; Eresheefa nay Telaahe; Telaahe nay Tahaane; <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />Tahaane nay Laadaane; Laadaane nay Amihuude; Amihuude nay Elshama; <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Elshama nay Nawe; Nawe nay Iyaaso.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Efreeme zareta duussasoynne istta biittay Beetele yuushon diza katamata, arshey mokkiza baggara Na7iraane, arshey wulliza baggara Gezeere, Seekeeme, Aayenne istta yuushon diza katamata.<verse eid="1CH 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 7:29" />Qasseka Minaase zareta biitta zawan Beeti-Sha7aane, Ta7inaake, Magiddo, Doorenne istta yuushon diza katamata; Isra7eele naa Yooseefe zareti ha katamatan de7ida.<verse eid="1CH 7:29" /></para>
  <para style="s1">Aaseere Nayta Zarkke</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Aaseere nayti Yimine, Yishiwe, Yishiwanne Barihe; istta michcha Seraho geetettawus.<verse eid="1CH 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 7:31" />Barihe nayti Heeberenne Birizawaate aawa Malkki7eele.<verse eid="1CH 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 7:32" />Heebere nayti Yaafaleexe, Shomerenne Hoottamo; istta michcha Shuu7o geetettawus.<verse eid="1CH 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33" />Yaafaleexe nayti Paasaake, Bimihaalenne Ashiwaate; hayti Yaafaleexe nayta.<verse eid="1CH 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34" />Yaafaleexe isha Shemere nayti Ahi, Erohiiga, Yahuubenne Aaraame.<verse eid="1CH 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 7:35" />Iza isha Hoottamo nayti Xofaaha, Yimine, Sheleeshenne Amale.<verse eid="1CH 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 7:36" />Xofaaha nayti Suuha, Harnefere, Shu7aale, Beere, Yimire, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bexere, Hooda, Shaama, Shilashe, Yitiraanenne Ba7eera.<verse eid="1CH 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38" />Yootore nayti Yoofine, Pispanne Aare. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Uule nayti Arahe, Han7eelenne Erixiya.<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />Hayti ubbay Aaseere zareta; istti baso asatas halaqata; ba yeleta zarkketa mazgaban 26,000 wolqqamanne mino olanchchati mazgabettida.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Biniyaame Nayta Zarkke</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Biniyaames bayra naazi Beela; iza kaaloti Ashibeele, Ahirahe, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Noha, Erafe.<verse eid="1CH 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 8:3" />Beela zareti Adaare, Geera, Abihuude, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abishu7a, Na7imaane, Ahoowa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Geera, Shafaamenne Huraame.<verse eid="1CH 8:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1CH 8:6-7" />Ehuude zareti Na7imaane, Akayanne Geera; istti Geeban diza bantta keeththa asatas halaqata; hessafe guye istti Manahaate biitta di7etti bida; Oozanne Ahihuude aawa Geeray isttas halaqa.<verse eid="1CH 8:6-7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 8:8" />Shaharaymey ba machcheta Hushimonne Ba7iro anjji yeddidaappe guye Mo7aabe biittan attuma nayta yelides. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Shaharayme ba machcho Hodeeshippe Yobaabe, Ziibiya, Meeshe, Malkaame, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Ya7uuxe, Saakiyanne Mirma yelides; iza nayti ubbay baso asatas halaqa gidida. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Qasse ba machcho Hushimippe Ahixuubenne Elpa7eele yelides.<verse eid="1CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12" />Elpa7eele nayti Eboore, Mishaamenne Shemede; Shemedi Oonno katamata, Looda katamatanne istta yuushon diza qeeri katamata essides.<verse eid="1CH 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13" />Bariheynne Shema7ey Ayaaloone katamaan diza bantta keeththa asatas halaqa gidida; istti Geete katamaan diza asaa yedeththida. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Barihe zareti Ahiyo, Shaashaqe, Yarmoote,<verse eid="1CH 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 8:15" />Zabaadiya, Araade, Edeere, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mika7eele, Yishiphanne Yooha geetetteettes.<verse eid="1CH 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 8:17" />Elpa7eele zareti Zabaadiya, Mashulaame, Hizqa, Heebere, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Yishimaraye, Yuzila7enne Yobaabe.<verse eid="1CH 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 8:19" />Shim7e zareti Yaaqime, Zikire, Zabde, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />El7enaaye, Elnaye, El7eele, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Birayenne Shimiraate.<verse eid="1CH 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 8:22" />Shaashaqe zareti Yishipha, Eboore, El7eele, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdoone, Zikire, Hanaane, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanaaniya, Elaame, Antooteya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Yifidayenne Panu7eele.<verse eid="1CH 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 8:26" />Yirohaame zareti Shaamisharaye, Shahaariya, Attaaliya, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Ya7ireeshe, Eelaasanne Zikire.<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />Hayti ubbati ba keeththa asatas halaqata; ba zereththa zarkketi xaafetti diza Yerusalaamen deettes.<verse eid="1CH 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />Geba7oone aawa Yi7i7eeley Geba7oone kataman dees; iza machchey sunththika Ma7ikko. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Izas bayra naazi Abdoone geetettees; iza kaaloti Xuure, Qiise, Ba7aale, Neerey Nadaabe, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gadoore, Ahiyo, Zekurenne <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />Shime7e aawa Miqiloote; hayti ubbati ba dabbota matan Yerusalaamen deettes.<verse eid="1CH 8:32" /></para>
  <para style="s1">Sa7oole Zarkketa</para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 8:33" />Neerey Qiise yelides;</para>
  <para style="q2" vid="1CH 8:33">Qiisey Sa7oole yelides;</para>
  <para style="q2" vid="1CH 8:33">Sa7ooli Yoonataane, Malkeshu7a,</para>
  <para style="q2" vid="1CH 8:33">Abinadaabenne</para>
  <para style="q2" vid="1CH 8:33">Eshiba7aale yelides.<verse eid="1CH 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 8:34" />Yoonataane nay Mariiba-Ba7aale;<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Mariiba-Ba7aaley Memfeboste geetettides; 2Same 4:4 xeella.</char></note></para>
  <para style="q2" vid="1CH 8:34">Mariiba-Ba7aaley</para>
  <para style="q2" vid="1CH 8:34">Mikiyaasa yelides.<verse eid="1CH 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 8:35" />Mikiyaasa attuma nayti Pitoone, Meleeke, Tare7anne Akaaze.<verse eid="1CH 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 8:36" />Akaazey Yaho7aade yelides;</para>
  <para style="q2" vid="1CH 8:36">Yaho7aadi Alemeete,</para>
  <para style="q2" vid="1CH 8:36">Azimootenne Zimire yelides;</para>
  <para style="q2" vid="1CH 8:36">Zimirey Mooza yelides;<verse eid="1CH 8:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 8:37" />Moozay Bini7e yelides;</para>
  <para style="q2" vid="1CH 8:37">Bini7ey Erafaye yelides;</para>
  <para style="q2" vid="1CH 8:37">Erafayey El7aasa yelides;</para>
  <para style="q2" vid="1CH 8:37">El7aasi Azeele yelides.<verse eid="1CH 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 8:38" />Azeeles 6 attuma nayti deettes; heytikka Azirqaame, Bookere, Isma7eele, Sha7aariya, Abdiyunne Hanaane; hayti ubbay Azeele nayta.<verse eid="1CH 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 8:39" />Azeele isha Esheeqes heedzdzu attuma nayti deettes; bayrazi Ulaame kaaloti Ya7uushenne Elfaleexe.<verse eid="1CH 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 8:40" />Ulaame nayti wolqqamanne mino olanchchata; isttika wondafen duko erizayta; Ulaames 150 attuma naytinne nayta nayti deettes.</para>
  <para style="p" vid="1CH 8:40">Hayti ubbati Biniyaame zareta.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s1">Di7eteththafe Simmida Isra7eele Asaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Isra7eele asay ubbay ba yeleta zarkken zarkken xaafettides; ha taarikey Isra7eele Kawota Maxaafan xaafetti uttides.</para>
  <para style="p" vid="1CH 9:1">Yuhuda asay ba nagara gaason Baabiloone biitta di7etti bides. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Di7etti bidasoppe Koyro simmidi bantta biittan uttidayti qeeseta, Leweta, Xoossa Keeththan wolqqa ooso ooththizaytanne Isra7eele asaappe guuththata.<verse eid="1CH 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3" />Yuhuda zaretappe, Biniyaame zaretappe, Efreeme zaretappenne Minaase zaretappe guuththati Yerusalaamen de7ida.<verse eid="1CH 9:3" /></para>
  <para style="s1">Yuhuda Nayta Zarkke</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 9:4" />Yuhuda naa Paareese zarkkefe Uutayey Yerusalaamen uttidaytas halaqa; Uutayey Amihuude naa; Amihuudey Imire naa; Imirey Baane naa.<verse eid="1CH 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 9:5" />Yuhuda naa Seelo zaretappe Asaayaynne iza nayti Yerusalaamen dizaytas halaqata.<verse eid="1CH 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 9:6" />Yuhuda naa Zaraahe zaretappe Yi7i7eeley Yerusalaamen dizaytas halaqa.</para>
  <para style="p" vid="1CH 9:6">Yuhuda zareti qoodiin mulera 690.<verse eid="1CH 9:6" /></para>
  <para style="s1">Biniyaame Nayta Zarkke</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 9:7" />Yerusalaamen de7ida Biniyaame zarkke halaqati hayssafe kaalli xaafettida;</para>
  <para style="q1" vid="1CH 9:7">Halaqa Saaluy Mashulaame naa;</para>
  <para style="q2" vid="1CH 9:7">halaqa Mashulaamey</para>
  <para style="q2" vid="1CH 9:7">Hoddaye naa;</para>
  <para style="q2" vid="1CH 9:7">halaqa Hoddayey Hasanu7e naa.<verse eid="1CH 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 9:8" />Halaqa Yibenayey Yirohaame naa.</para>
  <para style="q2" vid="1CH 9:8">Halaqa Eelay Uuze naa;</para>
  <para style="q2" vid="1CH 9:8">Uuzi Mikire naa.</para>
  <para style="q1" vid="1CH 9:8">Halaqa Mashulaamey</para>
  <para style="q2" vid="1CH 9:8">Shafaaxiya naa;</para>
  <para style="q2" vid="1CH 9:8">Shafaaxiya Era7u7eele naa;</para>
  <para style="q2" vid="1CH 9:8">Era7u7eeley Yibinaye naa.<verse eid="1CH 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 9:9" />Biniyaame zareta qooday mulera 956; heyti ubbay ba keeththa asatas halaqata.<verse eid="1CH 9:9" /></para>
  <para style="s1">Yerusalaamen De7ida Qeeseta</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />Yerusalaamen de7ida qeeseti hayssafe kaallidi xaafettidayta;</para>
  <para style="q2" vid="1CH 9:10">istti Yaddaya, Yoharibe, Yaakinenne<verse eid="1CH 9:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 9:11" />Xoossa Keeththan</para>
  <para style="q2" vid="1CH 9:11">halaqatida Azaariyaasa;</para>
  <para style="q2" vid="1CH 9:11">Azaariyaasi Kilqiyaasa naa;</para>
  <para style="q2" vid="1CH 9:11">Kilqiyaasi Mashulaame naa;</para>
  <para style="q2" vid="1CH 9:11">Mashulaamey Saadooqe naa;</para>
  <para style="q2" vid="1CH 9:11">Saadooqey Marayoote naa;</para>
  <para style="q2" vid="1CH 9:11">Marayootey Ahixuube naa.<verse eid="1CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 9:12" />Harati qasse Yirohaame naa Adayanne Adi7eele naa Ma7isaya; Yirohaamey Pashkure naa;</para>
  <para style="q1" vid="1CH 9:12">Pashkurey Malkiya naa.</para>
  <para style="q2" vid="1CH 9:12">Adi7eeley Yahizeere naa;</para>
  <para style="q2" vid="1CH 9:12">Yahizeerey Mashulaame naa;</para>
  <para style="q2" vid="1CH 9:12">Mashulaamey Mashilemite naa;</para>
  <para style="q2" vid="1CH 9:12">Mashilemitey Imere naa.<verse eid="1CH 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 9:13" />Banttaso asatas halaqatida qeeseti 1,760; hayti Xoossa Keeththan oosettiza oosos gakkida asata.<verse eid="1CH 9:13" /></para>
  <para style="s1">Yerusalaamen De7ida Leweta</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />Yerusalaamen de7ida Leweti hayssafe kaalli xaafettidayta;</para>
  <para style="q1" vid="1CH 9:14">Hashube naa Shama7ey</para>
  <para style="q2" vid="1CH 9:14">Meraare zarkke;</para>
  <para style="q2" vid="1CH 9:14">Hashubey Azirqaame naa;</para>
  <para style="q2" vid="1CH 9:14">Azirqaamey Hashaabiya naa.<verse eid="1CH 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 9:15" />Baqibaqire, Hereeshe, Galaalenne Maataaniya; Maataaniyay Mikka naa; Mikiyaasi Zikire naa; Zikirey Aasaafe naa.<verse eid="1CH 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 9:16" />Harati qasse Naxoofeta mooththatan uttida Abdiyunne Barakaye. Abdiyuy Shama7e naa;</para>
  <para style="q1" vid="1CH 9:16">Shama7ey Galaale naa;</para>
  <para style="q2" vid="1CH 9:16">Galaaley Edotaane naa.</para>
  <para style="q2" vid="1CH 9:16">Barakayey Aasa naa;</para>
  <para style="q2" vid="1CH 9:16">Aasi Hilqaana naa.<verse eid="1CH 9:16" /></para>
  <para style="s1">Xoossa Keeththa Penge Naagiza Zabeta</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />Xoossa Keeththa Penge naagiza zabeti Shaloome, Aqube, Xalmoone, Ahimaanenne istta dabbota; Shaloomey isttas halaqa. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Ha zereththati arshey mokkiza baggara diza kawo Penge geetettizasoza naageettes; hayssafe kase istti Leweti dunkaani uttidaso gelththiza penge naageettes.<verse eid="1CH 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19" />Shaalumey Abiyaasaafe naaza Qoore naa; izi Qoraaha zarkke asa. Qoore zereththati kase Godaa Xoossa Dunkaane naagida mala Shaloomeynne Qoraaha zarkke gidida iza dabboti Xoossa Keeththa naageettes.<verse eid="1CH 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 9:20" />El7ezeere naa Finihaasi beni wode Qoraaha zarkketa halaqa; GODAY izara dees.<verse eid="1CH 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21" />Qasseka Mashelemiya naa Zakaraasi Dunkaane penge naagees.<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />Pengaa naaganaas doorettidayti mulera 212; haytanti bantta kataman kataman qoodettidi xaafettida; istta zaretas ha aawateththaa immiday kawo Dawitenne nabe Sameela. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Hessa gishshas isttinne istta nayti Xoossa Keeththa dunkaane pengeza naageettes. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Zabeti arshey wulliza baggara, mokkiza baggara, pudeha baggaranne dugeha baggara eqqidi naageettes. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />He katamatan diza istta dabboti laappunththa gallas laametti laametti naagishe istta maaddanaas bessees.<verse eid="1CH 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 9:26" />Penge naagiza zabeta halaqatappe oyddu Leweti Xoossa Keeththaa, iza giddon diza kifiletanne minjja keeththa aawateththan naageettes. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Xoossa Keeththa naagizaynne qasse maalado maalado kare doyzayti istta gidida gishshas heen aqeettes.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Isttafe guuththati Xoossa Keeththa oosos go7ettiza miishshata aawateththan naageettes; he miishshata kare kessiza wodenne soo gelththiza wode istti qoodeettes. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Qasse isttafe issoti issoti Xoossa Keeththa giddon go7ettiza hara miishshata, liiqo dhiilleza, woyne ushshaza, zayteza, exaanezanne sawota aawateththan naageettes. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Gido attiin qeeseta naytappe issoti issoti sawoza geeddari geeddari walakkeettes.<verse eid="1CH 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 9:31" />Qoore zarkkefe Shaloomes bayra naa Lewe Matitiyas yarsho uketh uukkanaas aawateththi dees. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Qa7aate zarkke gidida istta dabbotappe guuththatas Sambatan Sambatan xaraphpheeza bolla woththiza yarsho giigsana aawateththi dees.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Lewe zaretappe amarda halaqati Xoossa Keeththan yexxizayta; istti omarsinne gallas ooththiza gishshas hara ooso oosettenna; istti Xoossa Keeththa gibbe giddon diza keeththatan de7eettes.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Hayti ubbay Lewe qommotas halaqati bantta zarkken zarkken xaafettidi Yerusalaamen deettes.<verse eid="1CH 9:34" /></para>
  <para style="s1">Kawo Sa7oole Yeleta</para>
  <para style="r">(<ref loc="1CH 8:29-38">1Taari 8:29-38</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />Geba7oone aawa Yi7i7eeley Geba7oone kataman de7ides; iza keeththa aayey sunththi Ma7ikko. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Izas bayra naazi Abdoone; iza kaaloti Xuure, Qiise, Ba7aale, Neere, Nadaabe, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gadoore, Ahiyo, Zakaraasanne Miqiloote. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Miqilootey Shime7e yelides; isttika bantta dabbota matan Yerusalaamen de7ida.<verse eid="1CH 9:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="1CH 9:39" />Neerey Qiise yelides;</para>
  <para style="q2" vid="1CH 9:39">Qiisey Sa7oole yelides.</para>
  <para style="q2" vid="1CH 9:39">Saa7ooley Yoonataane, Malkeshu7a, Abinadaabenne</para>
  <para style="q2" vid="1CH 9:39">Eshiba7aale yelides;<verse eid="1CH 9:39" /></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 9:40" />Yoonataane nay Mariiba-Ba7aale;<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">Mariiba-Ba7aaley Memfeboste geetettides. 1 Same 4:4 xeella.</char></note></para>
  <para style="q2" vid="1CH 9:40">Mariiba7aaley Mikiyaasa yelides.<verse eid="1CH 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 9:41" />Mikiyaasa nayti Pitoone, Meleeke, Tere7anne Akaaze. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Akaazey Ya7ire yelides;</para>
  <para style="q1" vid="1CH 9:42">Ya7irey Alemeete, Azimootenne Zimire yelides;</para>
  <para style="q2" vid="1CH 9:42">Zimirey Mooza yelides;<verse eid="1CH 9:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="1CH 9:43" />Moozay Bini7e yelides;</para>
  <para style="q2" vid="1CH 9:43">Bini7ey Erafaya yelides;</para>
  <para style="q2" vid="1CH 9:43">Erafayay El7aasa yelides;</para>
  <para style="q2" vid="1CH 9:43">El7aasi Azeele yelides.<verse eid="1CH 9:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 9:44" />Azeeles usuppun attuma nayti deettes; heytikka Azirqaame, Bookere, Isma7eele, Sha7aariya, Abdiyunne Hanaane; hayti ubbay Azeele nayta.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Kawo Sa7oole Hayqo</para>
  <para style="r">(<ref loc="1SA 31:1-13">1Same 31:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Filisxeeme asati Isra7eele asatara olettida; Isra7eele asati Filisxeeme asata sinththafe baqatida; Isra7eeletappe daroti Gilbo7a zuma hu7en hayqqida. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Filisxeeme asati Sa7oolenne iza nayta yedeththi gakkidi iza nayta Yoonataane, Abinadaabenne Malkeshu7a wodhida. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Olay Sa7oole yuuyi aadhdhidi un7eththides; olanchchati iza wondafen dukki madunththida.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Sa7ooli ba ola massara tookkiza wottadaraza, «Ha qaxxarettontta Filisxeeme asati yiidi ta bolla kaa7ontta mala ne giththa mashshan tana wodha» gides.</para>
  <para style="p" vid="1CH 10:4">Gido attiin iza ola massaraa tookkiza wottadarazi keehi yayyida gishshas ixxides; histtiin Sa7ooli ba giththa mashsha bolla kundidi hayqqides. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Iza ola massara tookkizayssi Sa7ooli hayqqidayssa be7idaappe guye izikka ba giththa mashsha sa7an essidi iza bolla kundi hayqqides. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Hessaththo hanidi Sa7ooli, iza nayti heedzdzatinne izaso asati ubbay he gallas issife hayqqida.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Zullezan de7iza Isra7eele asati ubbay bantta olanchchati baqatidayssa, Sa7oolinne iza nayti hayqqidayssa be7idi isttika bantta katamata aggidi gangida; Filisxeeme asati yiidi he katamata oykkida.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Wonteththa gallas Filisxeemeti ola massarata hayqqidayta bollafe qaari ekkanaas yiidi Sa7oolinne iza nayti Gilbo7a zuma hu7en hayqqidayssa demmida. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Histtidi istti Sa7oole hu7e qanxxi ekkidinne iza ola massara qaari ekkida; hessafe guye bantta eeqa xoossatassinne bantta deraas ha xoono mishiraachchoza awajjana mala Filisxeeme biitta ubbaas as kiitti yeddida. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Istti Sa7oole ola massarata bantta eeqa xoossata keeththatan woththida; iza hu7eza bantta eeqa xoossaa Daagone Keeththan kaqqida.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Filisxeeme asati Sa7oole bolla ooththidayssa ubbaa Gala7aaden diza Yaabuse katama asati siyida wode, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />mino asati biidi Sa7oole ahaanne iza nayta ahaa ekkidi Yaabuse katama ehida; histtidi Yaabusen diza gita miththa garsan moogida; hessafe guye 7 gallas xoomida.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Sa7ooli GODAAS ammanettibeenna; iza qaalaakka naagontta ixxidi moytille xeygizayta zore oychchida gishshas hayqqides. <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />Hessa gaason GODAY iza wodhidi iza kawoteththaa Isseye naa Dawites aaththi immides.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="LEV 19:31">Lewe 19:31</ref>; <ref loc="LEV 20:6">20:6</ref>; <ref loc="1SA 13:8-14">1Same 13:8-14</ref>; <ref loc="1SA 15:1-24">15:1-24</ref>; <ref loc="1SA 28:7-8">28:7-8</ref></char></note><verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Dawite Kawoteth</para>
  <para style="r">(<ref loc="2SA 5:1-10">2Same 5:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Hessafe guye Isra7eele asay ubbay issife Dawitekko Kebroone biidi, «Nuni issi ashonne issi meqeththa; <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Kase Sa7oole kawoteththa wodekka Isra7eele asaa olas kaaleththiday nena; GODAA ne Xoossay nena, ‹Ta deraa Isra7eele neni heemmana; istta bollaka neni kawotana› gides» gida.<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Hessa gishshas Isra7eele cimati ubbay Kawo Dawitekko Kebroone katama yida; izi isttara Kebroonen GODAA sinththan caaqettides; GODAY Sameela baggara haasayda qaalaa mala Dawiti Isra7eele bolla kawotana mala tiyda.<verse eid="1CH 11:3" /></para>
  <para style="s1">Dawiti Yerusalaame Oykkides</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Dawitinne Isra7eele asay ubbay Yerusalaame katama bida; he wode Yaabuse asati heen diza gishshas he katamaya Yaabuse geetettawus.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="JOS 15:63">Iya 15:63</ref>; <ref loc="JDG 1:21">Daanna 1:21</ref></char></note> <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Yaabuse asati Dawite, «Neni ha katama mulekka gelakka» gida; gidikkoka Dawiti Xiyoonen diza istta miixaa oykkides; histtiin iza Dawite Katama geetettadus. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />Dawiti, «Koyrotti biidi Yaabuse asata shocizaadey ola gadawa gidana» gides; histtiin Xuriya naa Iyo7aabey koyrotti bi olida gishshas ola gadawa gidides. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Dawiti he miixayo baas duussaso histtida gishshas miixaya Dawite katama geetettadus.<verse eid="1CH 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 11:8" />Dawiti he katamay yuushon kechchata keccidi katamayo zaari keexxides; attida katamaa qasse Iyo7aabey zaaridi keexxides.<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">Kechchata, kechchati katamaa gimbey kundontta mala naages go7eettes.</char></note> <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Ubbaafe Wolqqama GODAY izara diza gishshas Dawiti minni minni bides.<verse eid="1CH 11:9" /></para>
  <para style="s1">Mino Gidida Dawite Olanchchata</para>
  <para style="r">(<ref loc="2SA 23:8-39">2Same 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Mino gidida Dawite olanchchati hayssafe kaallidi xaafettida; isttika hankko Isra7eele asatara gididi GODAY izas immida hidota qaala mala iza kawoteththay aakkana mala keehi maaddidanne minththeththida.<verse eid="1CH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11" />Mino gidida Dawite olanchchatappe koyroyssi Hakimoone zarkkefe gidida Yashobi7aame; izi ola gadawa heedzdzatas halaqa; izi issito olan 300 as wodhides. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />He heedzdzu mino olanchchatappe nam7anththozi Ahihohe zarkkefe Doode naa El7ezeere. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Filisxeeme asati olettanaas Efsi-Deemime geetettizaso shiiqida wode Alazaarey Dawitera issife dees; banggay kumida goshsha gade giddon Isra7eele olanchchati Filisxeemeta sinththafe baqatida. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Gido attiin izinne iza kaallizayti heen soho oykkidi Filisxeeme asatara eqettida; GODAY isttas wolqqama xoono immides.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Filisxeeme olanchchati Erafayme shoobban dunkaani diza wode 30 halaqatappe heedzdzati Dawiti dizaso Adulaame gongolo matan diza zaallaako wodhdhida. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />He wode Dawiti miixaa giddon dees; Filisxeeme olanchchata buttey Beeteliheemen dees. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Dawiti haath uyanaas amottidi, «Beeteliheeme katama penge lanqen diza pultto haaththaafe tana oonee ushshanay!» gides. <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Heedzdzu mino Dawite olanchchati Filisxeeme asati dunkaani uttidasohora kanththi biidi Beeteliheeme katamaa pengen diza pulttozappe haath duuqqidi Dawites ehida; gido attiin Dawiti uyontta ixxidi he haaththaa GODAA sinththan gussides. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Histtidi, «Hayssa mala oosoppe tana Xoossi naago! Ta hayssa uykko ba shemppo bayzidi ehida asata suuth ushsha mala gidennee?» gides; hessa gishshas Dawiti he haaththaa uyibeenna; he heedzdzu mino olanchchati hessa ooththida.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Iyo7aabe isha Abisayey heedzdzatas halaqa; izi ba tooran 300 asata oli wodhides; hessa gaason izikka heedzdzata<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">Heedzdzata gizayssi heedzdzu tammata geetettana dandayettees.</char></note> mala erettides. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Izi heedzdzatara qoodettontta aggikokka isttafe aadhdhida bonchcho demmides; isttaskka halaqa gidides.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Qabxi7eeleppe yida Yoodahe naa Bannayay erettida olanchchanne wolqqama miish ooththida asa; izi nam7u erettida Mo7aabe biitta asata wodhides; qasse shachchi darida issi gallas gongolo giddo gelidi gaammo wodhides. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Bannayay izas geesay ichchashu wadha gidiza Gibxe biitta as wodhides; he Gibxe addeza kushen shemmaane wondiraashe keena tooray dees; Bannayay gidikko guufe oykki biidi iza kushen diza tooraa dafi ekkidi iza tooran iza zaari wodhides. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Yoodahe naa Bannayay haytantta ooththides; izikka heedzdzata mala erettida as gidides. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Izi heedzdzatara qoodettontta aggikokka 30 olanchchatappe aadhdhi bonchchettides; Dawiti iza bana naagizayta bolla halaqa histti shuumides.<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />Asaa giddon diza mino olanchchati hayssafe kaalli dizayta,</para>
  <para style="q1" vid="1CH 11:26">Iyo7aabe isha Asaheele,</para>
  <para style="q2" vid="1CH 11:26">Beeteliheeme as</para>
  <para style="q2" vid="1CH 11:26">Doode naa Elyaane,<verse eid="1CH 11:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="1CH 11:27" />Haroode as Shaamote,</para>
  <para style="q2" vid="1CH 11:27">Piloone as Heleexe,<verse eid="1CH 11:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="1CH 11:28" />Tequhe as Iqesha naa Ira,</para>
  <para style="q2" vid="1CH 11:28">Anatoote as Abi7eezere,<verse eid="1CH 11:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 11:29" />Huushe as Sibikaye,</para>
  <para style="q2" vid="1CH 11:29">Ahihohe as Eelaye,<verse eid="1CH 11:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 11:30" />Naxoofe as Mahiraye,</para>
  <para style="q2" vid="1CH 11:30">Naxoofe as Ba7aana naa Heleede,<verse eid="1CH 11:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="1CH 11:31" />Biniyaame zarkkefe Gibi7a as</para>
  <para style="q2" vid="1CH 11:31">Eribaye naa Ittaye,</para>
  <para style="q2" vid="1CH 11:31">Piraatoone as Bannaya,<verse eid="1CH 11:31" /></para>
  <para style="q2">
    <verse number="32" style="v" sid="1CH 11:32" />Ga7aashe shoobba as Huraye,</para>
  <para style="q2" vid="1CH 11:32">Arabe as Abi7eele,<verse eid="1CH 11:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="1CH 11:33" />Bahiruume as Azimoote,</para>
  <para style="q2" vid="1CH 11:33">Shaalboone as Eliyaahibe,<verse eid="1CH 11:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="1CH 11:34" />Gizoone as Hasheeme,</para>
  <para style="q2" vid="1CH 11:34">Harare dere as</para>
  <para style="q2" vid="1CH 11:34">Shaage naa Yoonataane,<verse eid="1CH 11:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="1CH 11:35" />Harare dere as</para>
  <para style="q2" vid="1CH 11:35">Sakkare naa Ahi7aame,</para>
  <para style="q2" vid="1CH 11:35">Uure naa Elfaale,<verse eid="1CH 11:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="1CH 11:36" />Makeere dere as Hefeere,</para>
  <para style="q2" vid="1CH 11:36">Piloone dere as Akaya,<verse eid="1CH 11:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="1CH 11:37" />Qarmeloose as Hexire,</para>
  <para style="q2" vid="1CH 11:37">Ezbaye naa Na7iraye,<verse eid="1CH 11:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="1CH 11:38" />Naataane isha Iyu7eele,</para>
  <para style="q2" vid="1CH 11:38">Aggaare naa Mibihaare,<verse eid="1CH 11:38" /></para>
  <para style="q2">
    <verse number="39" style="v" sid="1CH 11:39" />Amoone as Zallaqa,</para>
  <para style="q2" vid="1CH 11:39">Xuriya naa Iyo7aabe</para>
  <para style="q2" vid="1CH 11:39">ola massara tookkiza</para>
  <para style="q2" vid="1CH 11:39">Bi7oroote as Nahiraye,<verse eid="1CH 11:39" /></para>
  <para style="q2">
    <verse number="40" style="v" sid="1CH 11:40" />Yatire as Ira,</para>
  <para style="q2" vid="1CH 11:40">Yatire as Gaareebe,<verse eid="1CH 11:40" /></para>
  <para style="q2">
    <verse number="41" style="v" sid="1CH 11:41" />Hiite as Ooriyo,</para>
  <para style="q2" vid="1CH 11:41">Ahilaye naa Zabaade,<verse eid="1CH 11:41" /></para>
  <para style="q2">
    <verse number="42" style="v" sid="1CH 11:42" />Oroobeele zarkkefe</para>
  <para style="q2" vid="1CH 11:42">Shiiza naa Adiine;</para>
  <para style="q2" vid="1CH 11:42">izi Oroobeele zarkketassinne</para>
  <para style="q2" vid="1CH 11:42">banara issife diza 30</para>
  <para style="q2" vid="1CH 11:42">asatas halaqa.<verse eid="1CH 11:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="1CH 11:43" />Ma7ika naa Hanaane,</para>
  <para style="q2" vid="1CH 11:43">Mitaane as Iyoosaafixe,<verse eid="1CH 11:43" /></para>
  <para style="q2">
    <verse number="44" style="v" sid="1CH 11:44" />Ashtaarote as Uuziya,</para>
  <para style="q2" vid="1CH 11:44">Aaro7eere dere as Hoottamo</para>
  <para style="q2" vid="1CH 11:44">nayta Shaamenne Yi7i7eele,<verse eid="1CH 11:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="1CH 11:45" />Shimire naa Yidi7eelenne</para>
  <para style="q2" vid="1CH 11:45">iza isha Tizeete dere as Yooha,<verse eid="1CH 11:45" /></para>
  <para style="q2">
    <verse number="46" style="v" sid="1CH 11:46" />Mahaawe as El7eele,</para>
  <para style="q2" vid="1CH 11:46">Elnaame nayta</para>
  <para style="q2" vid="1CH 11:46">Yiribayanne Yooshaya,</para>
  <para style="q2" vid="1CH 11:46">Mo7aabe dere as Yitima,<verse eid="1CH 11:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1CH 11:47" />El7eele, Iyoobeedenne</para>
  <para style="q2" vid="1CH 11:47">Xoobe dere as Ya7isi7eele.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Biniyaame Zarkkefe Dawitekko Yida Ola Asata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Dawiti Qiise naa Sa7ooleppe baqatidi Xigilaagen uttida wode izakko yida asati hayssafe kaallizayta; isttika kase iza ola wode iza maaddida ola qarata giddon deettes. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Istti ushachcha kusheninne hadirsa kushen wondafe dukkanaassinne yanbarshe dhayqanaas dandayza olanchchata; isttika Biniyaame zare gidida Sa7ooles asho dabbota. <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />Istta halaqay Gibi7a as Shama7e naa Ahi7ezeerenne Iyo7aasa.</para>
  <para style="p" vid="1CH 12:3">Harati qasse Azimoote naa Yizi7eelenne Paleexe, Baraake, Anatoote as Iyu, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />erettida 30 olanchchatas halaqanne erettida olanchcha Geba7oone dere as Yishima7e, Ermaasa, Yahazi7eele, Yohanaane, Gadeere dere as Yozabaade, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />El7uzaye, Yarmoote, Ba7aaliya, Shamaariya, Harife as Shafaaxiya, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Qoore as Hilqaana, Yishiya, Azari7eele, Yo7eezerenne Yashobi7aame, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />Gadoore as Yirohaame naa Yo7eelenne Zabaadiya.<verse eid="1CH 12:7" /></para>
  <para style="s1">Gaade Zarkkefe Dawitekko Yida Ola Asata</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Dawiti bazzon baqati attizason diza wode Gaade zarkketappe olanchchati izakko yida; isttika minonne olas giigettida asata; qasseka gondallenne toora oyth dandayzayta; istta ayfesoy gaammo mala babisees; istti zuma bolla guppiza genessa mala pilateettes. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Istta halaqay koyroyssi Eezere,</para>
  <para style="q2" vid="1CH 12:9">nam7anththozi Abdiyu,</para>
  <para style="q2" vid="1CH 12:9">heedzdzanththozi Elyaabe,<verse eid="1CH 12:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="1CH 12:10" />oydanththozi Mishimaane,</para>
  <para style="q2" vid="1CH 12:10">ichchashanththozi Ermaasa,<verse eid="1CH 12:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="1CH 12:11" />usuppunththozi Attaye,</para>
  <para style="q2" vid="1CH 12:11">laappunththozi El7eele,<verse eid="1CH 12:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="1CH 12:12" />osppunththozi Yohanaane;</para>
  <para style="q2" vid="1CH 12:12">uddufunththozi Elzabaade;<verse eid="1CH 12:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="1CH 12:13" />tammanththozi Ermaasa;</para>
  <para style="q2" vid="1CH 12:13">tammanne issinththozi Makibaanaye.<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Hayti Gaade zarkketa garsan olanchchata halaqata; isttafe daroti shaalaqata mala, amardayti mato halaqata mala qoodettida. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Yordaanoose shaafay kixa salo shempida koyro aginan pinnidi zullaafe arshey mokkiza baggaranne arshey wulliza baggara dunkaani uttida asaa ubbaa yedeththida.<verse eid="1CH 12:15" /></para>
  <para style="s1">Biniyaame Zarkketappenne Yuhuda Zarkketappe Dawitekko Bida Olanchchata</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Biniyaame zarkketappenne Yuhuda zarkketappe amarda asati Dawiti dizaso miixa yida. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Histtiin Dawiti isttara gayttana ke7idi, «Intte tana maaddanaas saron taakko yidaa gidikko ta inttena ufayssan mokka ekkana; gido attiin intte tana ta morkketas aaththi immanaas yidaa gidikko nu aawata Xoossay hayssa be7idi pirdo!» gides.<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Hessafe guye 30 asata halaqa Amasaye bolla Xoossa Ayanay wodhdhiin</para>
  <para style="q2" vid="1CH 12:18">izi, «Dawitee! Nuni neyta!</para>
  <para style="q2" vid="1CH 12:18">Isseye naa Dawitee!</para>
  <para style="q2" vid="1CH 12:18">Nuni nenara issife doos!</para>
  <para style="q2" vid="1CH 12:18">Neessinne nena maaddizaytas</para>
  <para style="q2" vid="1CH 12:18">saroy gido!</para>
  <para style="q2" vid="1CH 12:18">Ne Xoossay nena</para>
  <para style="q2" vid="1CH 12:18">maaddana» gides.</para>
  <para style="m" vid="1CH 12:18">Hessa gishshas Dawiti mokki ekkidi ba olanchchata bolla halaqa histtides.<verse eid="1CH 12:18" /></para>
  <para style="s1">Minaase Zarkkefe Dawitekko Yida Asata</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Dawiti Filisxeemetara issife gididi Sa7oole olanaas bida wode Minaase zarkkefe amarda asati Dawitekko biidi iza qoommida; gido attiin, «Dawitinne iza olanchchati istta kawoza Sa7ooles aaththi immanaakko» gi hirgida gishshas Filisxeeme asati keehi zorettidaappe guyen istta guye Xigilaage zaarida. <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Dawiti Xigilaage katama simmishin iza maaddanaas Minaase zarkketappe kezi yida shaalaqati Adinahe, Yozabaade, Yidi7eele, Mika7eele, Yozabaade, Eelihunne Xiltaye. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Istti ubbatikka erettida mino olanchchata gidida gishshas Dawite ola wottadarata bolla halaqata gidida; Dawite morkketa olidi iza maaddida. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Dawite olanchchati Xoossa olanchchata mala corattana gakkanaas iza maaddiza asay gallas gallas gujettees.<verse eid="1CH 12:22" /></para>
  <para style="s1">Kebroonen Dawite Qoommida Olanchchata Qooda</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />GODAY immida hidota qaalaa mala Sa7oole kawoteththaa Dawites zaaranaas Dawitekko Kebroone yida ola tamaarda wottadarata qooday hayssafe kaallizayssa; <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />Gondallenne toora oykkidi olas giigettida Yuhuda zarkketi usuppun shiyanne osppun xeeta. <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Simoona zarkkefe olas giigida minonne wolqqama olanchchati laappun shiyanne issi xeet. <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Lewe zarkkefe oyddu shiyanne usuppun xeet, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Aaroone zarkketa halaqa Yoodahe gujjiin heedzdzu shiyanne laappun xeet. <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />Erettida olanchcha Saadooqe dabbota giddofe izara gujjiin nam7u tammanne nam7a. <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />Biniyaame zarkkefe Sa7oole dabboti heedzdzu shiya.</para>
  <para style="p" vid="1CH 12:29">Gido attiin Biniyaame zarkkefe dariza baggati Sa7oole keeththa asaas he wodey gakkanaas ammanettizayta. <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />Efreeme zarkkefe bantta aawata keeththan erettida minoti nam7u tammu shiyanne osppun xeet. <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />Dawite kawoththanaas doorettida Minaase zarkke baggaafe tammanne osppun shiya. <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />Isra7eele asay ay ooththanaas bessizaakko wodeza shaakki eriza aadho eranchchatinne Yisakoore zarkke halaqati nam7u xeet; isttara yida istta dabboti ubbay isttas azazetteettes. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Ola meezetidayti, ola massara ubbaan olettanaas dandayzaytinne wozinay ballatontta Dawite maaddanaas yida Zaabiloone baggati ichchash tammu shiya. <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />Niftaaleme zarkketas issi shiya halaqati deettes; gondallenne toora oykkida heedzdzu tammanne laappun shii asati isttara issife deettes. <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />Daane zarkkefe olas giigettida asati nam7u tammanne osppun shiyanne usuppun xeet. <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />Aaseere zarkkefe ola meezetidi giigettida olanchchati oyddu tammu shiya. <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />Yordaanoose shaafappe arshey mokkiza baggan diza Oroobeele zarkketappe, Gaade zarkketappenne Minaase zarkke baggaafe dumma dumma qommo massara oykkidi yida asati xeetanne nam7u tammu shiya.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Ha olas giigida olanchchati ubbay Dawite Isra7eele bolla kawoththanaas bantta qofaa issi bolla qachchidi Kebroone katama yida; qasse hankko attida Isra7eele dere ubbay Dawite kawoththanaas issi wozinan gidides. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Istta dabboti isttas koshshizayssa giigsi woththida gishshas mishenne uyishe Dawitekkon heedzdzu gallas gam7ida. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Isra7eele asaas gita ufays gidiza gishshas istta shooroppe doommidi haakon diza Yisakooreppe, Zaabilooneppenne Niftaalemeppe asay attontta kath, dhiille, balasenne zabibe kompa, woyne ushshinne wogara zayte haren, baqulon, gaamellaninne booran caanidi ehides; qasseka istti shukki maana mala miizatanne dorsata ekki yida.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Taabotaa Zaari Eho</para>
  <para style="r">(<ref loc="2SA 6:1-11">2Same 6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Hessafe guye Dawiti shaalaqatara, mato halaqataranne olanchcha halaqata ubbatara zorettides. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Histtidi Isra7eele asaa ubbaas, «Inttes lo7o misatizayssa gidikkonne GODAA nu Xoossaa shene gidikko Isra7eele biittan mataninne haakon diza nu ishati qasseka bantta katamataninne bantta mehe heemmizasohotan diza qeesetinne Leweti nunara issife shiiqana mala ane kiita yeddoos. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Sa7oole kawoteththa wode nuni yeggi aggida nu Xoossa Taabotaa ane zaaridi ehoos» gides. <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Dawiti yootidayssi ammanththizaaz gidida gishshas asay iza qofaa ekkides.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Hessa gishshas Dawiti Xoossaa Taabotaa Qiriyaate-Yi7aarimeppe ehana mala Gibxe zawappe doommidi Hamaate purde gakkanaas diza Isra7eele asaa ubbaa shiishshides.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1Same 7:1-2</ref></char></note> <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Dawitinne Isra7eele asay ubbay kirubetappe giddon ba araata bolla uttida GODAA sunththan xeygettida Xoossa Taabotaa ehanaas Yuhuda biittan diza Ba7aala geetettiza Qiriyaate-Yi7aarime katama bida.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kessa 25:22</ref></char></note> <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Xoossa Taabotaza Abinadaabe sooppe ooraththa para-gaare bolla woththi ehida; para-gaareza laaggizayti Oozanne Ahiyo. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Dawitinne Isra7eele asay ubbay diiththan maasinqon, karaben, daalaninne xurumban bantta kumeththa wolqqan Xoossa sinththan ufayettidi bonchchida.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Istti Kiidoona geetettizason diza kaththa balezakko gakkida wode caanida boorati bargagi dhuphettiin Oozay Taabotaza ashshanaas kushe yeddides. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Iza kushey Taabotaza bochchida gishshas GODAA hanqoy Ooza bolla eexxi kezides; hessa gishshas izi heen GODAA sinththan hayqqides. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />GODAY hanqettidi Ooza wodhida gishshas Dawiti kayottides; hach gakkanaas he sohoy Ooza meqoso geetettees.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />He gallas Dawiti Xoossas yayyida gishshas, «Xoossa Taabotaa taakko wostta ehanaas dandayazinaa?» gides. <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Hessa gishshas Dawiti Taabotaza banara efanaappe Geete dere as Abidaareso efides. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Xoossa Taabotay Abidaareson izaso asatara heedzdzu agina gam7ides; GODAY iza keeththa asaanne izas diza miish ubbaa anjjides.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1Taari 26:4-5</ref></char></note><verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Yerusalaamen Dawite Oosota</para>
  <para style="r">(<ref loc="2SA 5:11-16">2Same 5:11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Xiroose Kawo Huraamey Dawites kawo keeth keexxana mala kiita asata, shuch massizaytanne anaaxeta ziga miththara Dawitekko yeddides. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />GODAY Isra7eele bolla iza kawoththidayssanne ba asaa Isra7eele gishshas iza kawoteththa dhoqqu histti bonchchidayssa Dawiti akeekides.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Hessafe guye Dawiti Yerusalaamen hara machcheta gujji ekkidi attuma naytanne macca nayta yelides. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Dawiti Yerusalaamen yelida attuma nayti Shaamu7e, Shoobaabe, Naataane, Solomoone, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Iyabeheere, Elshu7e, Elpaleexe, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Nogahe, Nefege, Naafiya, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elshama7e, Be7elyaadenne Elfaleexe.<note caller="+" style="f"><char style="fr" closed="false">14:4-7 </char><char style="ft" closed="false">Dawites Yerusalaamen yelettida attuma nayta sunththi 2Same 5:14-16, 1Taari 3:5-7nne 14:4-7 xaafettides; gido attiin Ibraaweta maxaafan issota issota sunththay ubbason issi mala gidenna.</char></note><verse eid="1CH 14:7" /></para>
  <para style="s1">Filisxeeme Asaa Xooneteth</para>
  <para style="r">(<ref loc="2SA 5:17-25">2Same 5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Dawiti Isra7eele ubbaa bolla kawo gididi tiyettidayssa Filisxeeme asay siyidi ubbay Dawite oykkanaas ke7ides; Dawiti hessa siyidi isttara olettanaas kezides. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Filisxeeme asay Erafayme zulleza yiidi worajjides. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Dawitikka, «Tani baada Filisxeemeta oloo? Neni istta ta kushen aaththa immanee?» gi Xoossaa oychchides.</para>
  <para style="p" vid="1CH 14:10">Histtiin GODAY izas, «Ee baada ola; tani istta nees aaththa immana» gides.<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Histtiin Dawitinne izara diza asay Ba7aali-Paraaxime geetettizaso biidi heen istta oli xoonida; Dawiti, «Di7o haaththi shoddi efiza mala Xoossi ta morkketi ta kushen shodettana mala ooththides» gides; hessa gishshas he sohoza sunththi Ba7aali-Paraaxime geetettides. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Filisxeemeti bantta eeqa xoossata heen yeggi bida. Histtiin Dawiti istta eeqa xoossata taman xuuggana mala azazides.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Filisxeeme asay nam7anththo yiidi he shoobbaa worajjides. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Dawiti Xoossaa nam7anththo zaari oychchides; histtiin Xoossi izas, «Neni istta bolla sitti gaada booppa. Istta giddoththada eththa miththas sinththa baggara istta olanaas giigetta. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Eththaa miththaza xeeran salfe giiris neni siyida wode olanaas elle keza; gaasoykka hessi Filisxeeme olanchchata shocanaas Xoossay neeppe sinththan kezida gishshassa guussa» gides.<verse eid="1CH 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 14:16" />Hessa gishshas Xoossay azazida mala Dawiti ooththides. Geba7ooneppe biidi Gezeere gakkanaas Isra7eele asay Filisxeeme olanchchata dippi histtides.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Hessa gaason Dawite goobateththi biitta ubbaan nashettides. GODAY kawoteththati ubbay Dawites yayyana mala ooththides.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Taabotaza Yerusalaame Eho</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Dawiti ba sunththan xeygettida kataman baas keeththata keexxides; Xoossa Taabotasikka soho giigsidi dunkaane essides. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Hessafe guye Dawiti, «Xoossa Taabotaa tookkanaassinne mernaas Xoossaas haggazana mala GODAY doorida Lewetappe attiin hara asi oonikka Xoossa Taabotaa tookkofo» gi azazides.<note caller="-" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="DEU 10:8">Zaare 10:8</ref></char></note> <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />Dawiti GODAA Taabotaas giigsida soho Taabotaza ehana mala Isra7eele asaa ubbaa Yerusalaamen shiishshides.<verse eid="1CH 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 15:4" />Qasseka Aaroone zaretanne Leweta xeygi shiishshides; <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />Qa7aate zereththatappe halaqa gidida Ur7eelenne iza dabbotappe issi xeetanne nam7u tamma; <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />Meraare zereththatappe halaqa Asaayanne iza dabbotappe nam7u xeetanne nam7u tamma; <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />Gershoone zereththatappe halaqa Iyu7eelenne iza dabbotappe issi xeetanne heedzdzu tamma; <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />Elxafaane zereththatappe halaqa Shama7enne iza dabbotappe nam7u xeeta; <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />Kebroone zereththatappe halaqa El7eelenne iza dabbotappe osppun tamma; <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />Uzi7eele zereththatappe halaqa Aminadaabenne iza dabbotappe issi xeetanne tammanne nam7a.<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Hessafe guye Dawiti qeeseta Saadooqenne Abiyaataare, qasse Leweta Ur7eele, Asaaya, Iyu7eele, Shama7e, El7eelenne Aminadaabe xeygides. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Histtidi isttas, «Intte Lewe keeththa asatas halaqata gidida gishshas inttena geeshshite; hessafe GODAA Isra7eele Xoossa Taabotaa ta izas giigsidaso ehite. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Kasekka intte Lewe qommoti Xoossa Taabotaa tookkontta aggida gishshassinne nunikka iza woga mala wostti efanaakko Xoossa oychchontta aggida gishshas GODAA nu Xoossay nuna qaxxaydes» gides.<verse eid="1CH 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14" />Hessa gishshas GODAA Isra7eele Xoossa Taabotaa ehanaas qeesetinne Leweti banttana geeshshida. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />GODAY Muse baggara kase azazida mala Leweti Xoossa Taabotaa tooho miththara bantta hashen tookkida.<note caller="-" style="x"><char style="xo" closed="false">15:15 </char><char style="xt" closed="false"><ref loc="EXO 14">Kessa 14</ref></char></note><verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Hessafe guye diiththinne maasinqo diixxishe, daala qaaththishe, ufayssa mazamure yexxana mala Leweta kaaleththizayti bantta dabbota garsafe as doorana mala Dawiti azazides.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Hessa gishshas Leweti Iyu7eele naa Hemaane, iza dabbotappe Baraakaye naa Aasaafenne istta ishanttafe Meraare zarkke Qiisiya naa Etaane shuumida. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Qasse nam7anththo maaran Zakaraasa, Ya7izi7eele, Shamiramoote, Yihi7eele, Uune, Elyaabe, Bannaya, Ma7isaya, Matitiya, Elfaalehu, Miqineyanne penge naagizayta Obeed-Eedoomenne Yi7i7eele sunththida.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Xarqimala daala dhoqqu histti giirissi sissana mala Hemaane, Aasaafenne Etaane sunththida. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Qasse maasinqo kaa7ana mala Zakaraasa, Ya7izi7eele, Shamiramoote, Yihi7eele, Uune, Elyaabe, Ma7isayanne Bannaya sunththida. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Diith ordera shocana mala Matitiya, Elfaalehu, Miqineya, Obeed-Eedoome, Yi7i7eelenne Azaaziya sunththida.<verse eid="1CH 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 15:22" />Leweta halaqa Kanaaniya yeththas imotay izas diza gishshas yexxizayta tamaarsana mala sunththida. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Baraakayeynne Hilqaanay Taabotaa dunkaane penge naaganaas doorettida. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Qasse qeeseti Shebaaniya, Iyoosaafixey, Natina7eeley, Amasayey, Zakaraasi, Bannayaynne El7ezeerey Xoossa Taabotaa sinththan xurumba punnanaas doorettida; Obeed-Eedoomeynne Yihiyay Taabotaa naaganaas doorettida.<verse eid="1CH 15:24" /></para>
  <para style="r">(<ref loc="2SA 6:12-22">2Same 6:12-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Hessafe guye Dawiti, Isra7eele cimatinne shaalaqati GODAA Taabotaa Obeed-Eedoome sooppe ehanaas ufayettidi bida. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Caaqo Qaala Taabotaa tookkida Leweta Xoossay maaddida gishshas istti laappun korma booratanne laappun dharshota yarshida. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Dawiti, Taabotaa tookkida Leweti ubbay, mazamure yexxizaytinne istta halaqa Kanaaniya qacinappe dadettida layno may7ida; qasseka Dawiti lee7e qacinappe dadettida eefude may7ides. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Histtidi Isra7eele ubbay hombocishe xurumbanne zaye punnishe, daala giirissishe, diiththinne maasinqo diixxishe GODAA Taabotaa ehida.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Caaqo Qaala Taabotay Dawite katama gelishin kawo Dawiti ufayettidi durishininne kaa7ishin Sa7oole naya Milkoola maskootera mokka xeellada kawo Dawite ba wozinara kadhadus.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Istti Xoossa Taabotaa ehidi Dawiti Taabotaa woththanaas tolida dunkaaneza giddon woththida; histtidi xuugettiza yarshonne issifeteththa yarsho Xoossas yarshida. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Dawiti xuugettiza yarshozanne issifeteththa yarsho yarshidaappe guye GODAA sunththan dereza anjjides. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Hessafe guye Isra7eele asa ubbaas, maccassaassinne attumasaas, hu7en hu7en issi issi guuththa uketh, issi issi qanxxo ashonne issi issi zabibe kompa<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Kompa geetettizayssi issi issi bagga gamoththo qaalan dhebbo woykko lichchako geetettees.</char></note> gishides.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />GODAA Taabotaa sinththan ooththana malanne GODAA Isra7eele Xoossa woossanaas, sabbanaassinne galatanaas Dawiti Lewe qommotappe guuththata sunththides. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Leweta halaqay Aasaafe; izappe garsara Zakaraasa; Zakaraasara dizayti Yi7i7eele, Shamiramoote, Yihi7eele, Matitiya, Elyaabe, Bannayanne Obeed-Eedoomenne Yi7i7eele; heyti maasinqonne diith diixxana mala summida; Asaafi gidikko daala qaaththanaas summides.<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">Daala gizayssi xinaaxile gizayssa bessees.</char></note> <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Qeese Bannayaynne Yahazi7eeley Xoossaa Taabotaa sinththan ubba wode zaye punnana mala summida.<verse eid="1CH 16:6" /></para>
  <para style="s1">Galata Yeththa</para>
  <para style="r">(<ref loc="PSA 105:1-15">Maza 105:1-15</ref>; <ref loc="PSA 96:1-13">96:1-13</ref>; <ref loc="PSA 106:1">106:1</ref>,<ref loc="PSA 106:47-48">47-48</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />He gallas Dawiti kasetidi Aasaafessinne izara ooththiza laggetas GODAA galatiza mazamure immides.<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />GODAA galatite;</para>
  <para style="q2" vid="1CH 16:8">iza sunththaa xeygite;</para>
  <para style="q2" vid="1CH 16:8">izi ooththida ubbaa</para>
  <para style="q2" vid="1CH 16:8">kawoteththatas yootite.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Iza sabbite;</para>
  <para style="q2" vid="1CH 16:9">galata mazamurekka izas yexxite;</para>
  <para style="q2" vid="1CH 16:9">izi ooththida malalisiza ooso</para>
  <para style="q2" vid="1CH 16:9">ubbaa yootite.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Iza geeshsha sunththaan</para>
  <para style="q2" vid="1CH 16:10">bonchchite;</para>
  <para style="q2" vid="1CH 16:10">GODAA koyzayta</para>
  <para style="q2" vid="1CH 16:10">wozinay ufayetto.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />GODAANNE iza wolqqa xomosite;</para>
  <para style="q2" vid="1CH 16:11">ubba wode iza koyite.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Izi ooththida malalisiza oosota,</para>
  <para style="q2" vid="1CH 16:12">malaatatanne iza pirdaa akeekite.<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Intteno Xoossa aylle</para>
  <para style="q2" vid="1CH 16:13">Isra7eele zereththatoo!</para>
  <para style="q2" vid="1CH 16:13">Intteno doorettida</para>
  <para style="q2" vid="1CH 16:13">Yaaqoobe naytoo!<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Izi GODAY nu Xoossa;</para>
  <para style="q2" vid="1CH 16:14">iza pirday ubbaa bollanna.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Ba caaqqida qaalaa mernaas,</para>
  <para style="q2" vid="1CH 16:15">ba azazidayssaka shii yeleta</para>
  <para style="q2" vid="1CH 16:15">gakkanaas qoppees.<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />Abrahaames caaqqida caaqaa,</para>
  <para style="q2" vid="1CH 16:16">Yisaaqas immida hidota qaalaa,<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Medhe 12:7</ref>; <ref loc="GEN 26:3">26:3</ref></char></note><verse eid="1CH 16:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="1CH 16:17" />Yaaqoobes woga gidana mala,</para>
  <para style="q2" vid="1CH 16:17">Isra7eelesikka mernaa caaqo</para>
  <para style="q2" vid="1CH 16:17">qaala gidana mala minththides.<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />«Kanaaney nees</para>
  <para style="q2" vid="1CH 16:18">xinxxo gidana mala</para>
  <para style="q2" vid="1CH 16:18">ta nena laatissana» gides.<note caller="-" style="x"><char style="xo" closed="false">16:17-18 </char><char style="xt" closed="false"><ref loc="GEN 18:13">Medhe 18:13</ref></char></note><verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Istti qoodan guuth gidi diza wode,</para>
  <para style="q2" vid="1CH 16:19">deraasikka imath gidi diza wode,<verse eid="1CH 16:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="1CH 16:20" />issi dereppe hara dere,</para>
  <para style="q2" vid="1CH 16:20">issi kawoteththafe</para>
  <para style="q2" vid="1CH 16:20">hara kawoteth toylattida.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Oonikka istta un7eththana mala</para>
  <para style="q2" vid="1CH 16:21">aaththi immibeenna;</para>
  <para style="q2" vid="1CH 16:21">istta gishshas kawota seerides;<verse eid="1CH 16:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="1CH 16:22" />«Ta tiydayta bochchofte;</para>
  <para style="q2" vid="1CH 16:22">ta nabeta qohopite» gides.<note caller="-" style="x"><char style="xo" closed="false">16:21-22 </char><char style="xt" closed="false"><ref loc="GEN 20:3">Medhe 20:3</ref></char></note><verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Biitta ubbay GODAAS yexxite;</para>
  <para style="q2" vid="1CH 16:23">izi ashshizayssa</para>
  <para style="q2" vid="1CH 16:23">hach hach yootite.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Kawoteththatas</para>
  <para style="q2" vid="1CH 16:24">iza bonchcho awajjite;</para>
  <para style="q2" vid="1CH 16:24">izi ooththida malalisiza</para>
  <para style="q2" vid="1CH 16:24">miishshata dere</para>
  <para style="q2" vid="1CH 16:24">ubbaas yootite.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />GODAY gita;</para>
  <para style="q2" vid="1CH 16:25">izas bessiza galataykka dhoqqa;</para>
  <para style="q2" vid="1CH 16:25">xoossata ubbaafe aadhdhees;</para>
  <para style="q2" vid="1CH 16:25">izas yayyanaas bessees.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Ayzaabeta xoossati</para>
  <para style="q2" vid="1CH 16:26">ubbay eeqa xoossata;</para>
  <para style="q2" vid="1CH 16:26">GODAY gidikko</para>
  <para style="q2" vid="1CH 16:26">salota medhdhida Xoossa.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Bonchchoynne teemay izas dees;</para>
  <para style="q2" vid="1CH 16:27">minoteththinne ufayssi</para>
  <para style="q2" vid="1CH 16:27">iza Keeththan dees.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Intteno asa zare ubbatoo!</para>
  <para style="q2" vid="1CH 16:28">GODAA sabbite;</para>
  <para style="q2" vid="1CH 16:28">«Bonchchoynne wolqqay</para>
  <para style="q2" vid="1CH 16:28">GODAASSA» gi yootite.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />GODAA sunththaas bessiza</para>
  <para style="q2" vid="1CH 16:29">bonchcho immite;</para>
  <para style="q2" vid="1CH 16:29">yarsho ekkidi iza sinth shiiqite;</para>
  <para style="q2" vid="1CH 16:29">iza geeshshateththa bonchcho</para>
  <para style="q2" vid="1CH 16:29">gishshas GODAAS goynnite.<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />Biittan diza as ubbay</para>
  <para style="q2" vid="1CH 16:30">iza sinththan kokkorite;</para>
  <para style="q2" vid="1CH 16:30">Sa7ay minni eqqides;</para>
  <para style="q2" vid="1CH 16:30">mulekka qaaxxenna.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Saloti ufayetetto!</para>
  <para style="q2" vid="1CH 16:31">sa7aykka hashshu go!</para>
  <para style="q2" vid="1CH 16:31">Kawoteththata giddon isttas,</para>
  <para style="q2" vid="1CH 16:31">«GODAY kawotides!» getto.<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Abbaynne iza giddon diza</para>
  <para style="q2" vid="1CH 16:32">ubbay guummetto;</para>
  <para style="q2" vid="1CH 16:32">dembatinne istta bolla diza</para>
  <para style="q2" vid="1CH 16:32">ubbati ufayetetto.<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Izi biitta bolla pirdanaas yaana.</para>
  <para style="q2" vid="1CH 16:33">He wode wora miththati</para>
  <para style="q2" vid="1CH 16:33">Godaa Xoossaa</para>
  <para style="q2" vid="1CH 16:33">sinththan ufayssan yexxana.<verse eid="1CH 16:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />GODAY kiya;</para>
  <para style="q2" vid="1CH 16:34">iza maaroteththayka mernaassa;</para>
  <para style="q2" vid="1CH 16:34">hessa gishshas GODAA galatite.<note caller="-" style="x"><char style="xo" closed="false">16:34 </char><char style="xt" closed="false"><ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 100:5">Maza 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />«Abeet nuna ashshiza GODAWU!</para>
  <para style="q2" vid="1CH 16:35">Nuna ashsha;</para>
  <para style="q2" vid="1CH 16:35">ne geeshsha sunththaa</para>
  <para style="q2" vid="1CH 16:35">nu galatana mala,</para>
  <para style="q2" vid="1CH 16:35">nu nena galatan</para>
  <para style="q2" vid="1CH 16:35">bonchchana mala</para>
  <para style="q2" vid="1CH 16:35">kawoteththata giddofe nuna</para>
  <para style="q2" vid="1CH 16:35">shiishshada ashsha» giite.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />GODAA Isra7eele Xoossay</para>
  <para style="q2" vid="1CH 16:36">mernaappe mernaa gakkanaas galatetto!</para>
  <para style="p" vid="1CH 16:36">Hessafe guye dere ubbay, «Amiin» giidi GODAA galatides.<verse eid="1CH 16:36" /></para>
  <para style="s1">Yerusalaameninne Geba7oonen Hanida Goyno Maara</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />GODAA Taabotaa sinththan hach hach goynos koshshizaaz ubba wode istti ooththana mala Dawiti Aasaafenne iza dabbota woththides. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Qasseka Obeed-Eedoomenne iza dabbota usuppun tammanne osppunata isttara ooththana mala woththides; Edotaane naa Obeed-Eedoomenne Hoosa dirsaa penge naagana mala woththides.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Qeese Saadooqenne izara ooththiza qeeseti Geba7oonen dhoqqasohon diza GODAA Dunkaaneza sinththan ooththana mala heen woththides. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />Gaasoykka GODAY Isra7eeles immida wogaa mala istti ubba wode xuugettiza yarshoy yarshettizason maaladonne omars xuugettiza yarsho yarshanaassa. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Iza maarotay mernaas gidida gishshas GODAA galatana mala Hemaane, Edotaanenne doorettida harata Dawiti isttara issife essides. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Hemaanessinne Edotaanes xurumba punnanaas, daala giirissanaasinne mazamure yexxishe go7ettiza hara massarata bolla aawateththi isttas imettides; Edotaane nayti dirsa penge naagana mala alaafeteththi imettides.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Hessafe guye ubba asay baso baso bides; Dawitikka baso asaa anjjanaas soo simmides.<note caller="-" style="x"><char style="xo" closed="false">16:43 </char><char style="xt" closed="false"><ref loc="2SA 6:19-20">2Same 6:19-20</ref></char></note><verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Naataane Baggara Xoossi Dawites Yootida Qaala</para>
  <para style="r">(<ref loc="2SA 7:1-17">2Same 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Dawiti ba kawoteththa keeththan de7ishe, nabe Naataanes, «Tani zigappe keexettida keeththan de7ays; gido attiin Xoossa Caaqo Qaala Taabotay gidikko dunkaane giddon dees» gides.<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Naataaney qasse Dawites, «Ooththanaas ne wozinan ne qoppidayssa ubbaa ooththa; Xoossi nenara dees» gides.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Gido attiin he gallassa omars Xoossa qaalay Naataanekko yiidi, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />«Ba; baada ta aylle Dawites GODAY nees gizayssi ta izan de7ana keeth keexxanay nena gidakka. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Tani Isra7eeleta Gibxeppe kessida gallassaafe doommada hach gakkanaas, dunkaanaappe dunkaanen, qasse issi sohoppe hara soho yuuyada de7ays attiin keeththan de7abeekke. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Tani Isra7eele asaa ubbaara yuuyida soho ubbaan ta deraa heemmanaas tani azazida Isra7eele daannatappe oonaska, ‹Taas ziga miththafe keeth ays keexxibeeketii?› gaada oychchida wodey dizee?<verse eid="1CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7" />«Hessa gishshas ha7ikka neni ta aylle Dawites, Ubbaafe Wolqqama Xoossi nena, ‹Ta deraa Isra7eele ayssana mala neni dorsa heemmizasohoppe ta nena denththa ekkadis. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Neni bida soho ubbaan tani nenara issife gidadis; ne morkketa ubbaa ne sinththafe diggadis; ha7ikka tani ha sa7an erettida gita asata sunththaa mala ne sunththaa gitasana. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Tani ta asaa Isra7eeles daanasoho immana; isttas duussasoho immidaappe guye istti qaaxxontta mala ta ooththana; iita asati kase istta un7eththidayssaththo hayssafe guye istta un7eththettenna. <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />Hayssafe kase ta deraa Isra7eele kaaleththizayta ta sunththida wode kase iitati un7eththidayssaththo hayssafe guye un7eththettenna; intte morkketa ubbaa ta kawushshana; tani Xoossay nees keeth keexxanayssa yootays. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Ne cimmada kase hayqqida ne aawatan gayttiza wode tani ne naytappe issaa denththada ne sohon kawoththana; iza kawoteththaaka ta minththana. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Taas keeth keexxanay iza; tani iza kawoteththa araataa mernaas minththa essana. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Tani izas aawa gidana; izikka taas naa gidana; neeppe kase kawotida Sa7ooleppe tani ta maaroteththaa denththida mala izappe mulekka denththike.<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="2CO 6:18">2Qoro 6:18</ref>; <ref loc="HEB 1:5">Ib 1:5</ref></char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Tani iza ta asaa bollanne ta kawoteththaa bolla mernaas sunththana; iza kawoteththa araataykka mernaas minni eqqana› gaada yoota» gides.<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Naataaney Xoossay izas ajjuutan qonccisida qaala ubbaa Dawites yootides.<verse eid="1CH 17:15" /></para>
  <para style="s1">Dawite Woosa</para>
  <para style="r">(<ref loc="2SA 7:18-29">2Same 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Hessafe guye Kawo Dawiti dunkaanen gelidi GODAA sinththan uttides; histtidi, «Abeet GODAWU, Xoossawu! Neni hayssa ubbaa taas ooththanaas tani oonee? Taso asaykka aazee? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Abeet Xoossawu! Hayssi ne ayfe sinththan guuththa misatiin ne aylle zareti sinththafe yaana layththatan hananayssa yootadasa; neni tana gita asatappe dhoqqu histta xeelladasa. <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Neni tana ne aylleza bonchchida gishshas tani Dawiti hayssafe bollara ay gaana dandayazinaa? Neni tana ne aylleza eraasa. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Abeet GODAWU! Ne aylleza gishshas ne wozina qofaa mala ha gita miishshata ubbaa ooththada ha gitateththaa ubbaa tana erisadasa.<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />«Abeet GODAWU! Ne malay haray baawa; nuni nu hayththan siyida mala neeppe attiin hara Xoossi deenna. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Neni Xoossi Gibxe biittafe kessida ne deraa sinththafe kawoteththata gooddada gitanne yashissiza miish ne sunththas ooththana mala, deraakka nees wozzana mala ne isttas ooththidayssaththo ne dere Isra7eele mala derey biitta bolla haray dizee? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Neni ne deraa Isra7eele mernaas nees histtadasa; abeet GODAWU nenikka istta Xoossa gidadasa.<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />«Abeet GODAWU! Neni ne ayllezasinne iza zereththatas immida hidotaa mernaas minththa; neni immida hidota qaalaakka pola. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Hessa ne ooththanay ne sunththi minni daana malanne mernaas gita gidana malassa; hessafe guye asay, ‹Ubbaafe Wolqqama Xoossay tumukka Isra7eele Xoossa› gaana gees; ne aylle Dawite zareti ne sinththan minni eqqana.<verse eid="1CH 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 17:25" />«Abeet ta Xoossawu, ‹Neni taas ne ayllezas keeth keexxana ga yootadasa; hessa gishshas tani ne aylley nena woossanaas xaladis. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Abeet GODAWU! Neni tumu Xoossa; ha lo7o hidota qaala ne ayllezas immadasa. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Ne sinththan mernaas daana mala ne aylleza keeth anjjanaas ne koyadasa; Abeet GODAWU! Neni anjjiday mernaas anjjettidaade gidana› gi woossees» gides.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Dawiti Xoonida Xoonota</para>
  <para style="r">(<ref loc="2SA 8:1-18">2Same 8:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Hessafe guye Dawiti Filisxeemeta xooni haarides; histtidi Geete katamanne iza yuushon diza mooththata Filisxeeme asata kusheppe woththi ekkides. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Histtiin Mo7aabe dere asay izas haarettidi giira ehides.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Hessafe guye Dawiti Efiraaxise shaafa heeran diza dereta oykkana bida wode Xoobba Kawo Hadaadi7eezere oli xoonidi Hamaate gakkanaas diza biitta oykkides. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Dawiti Hadaadi7eezereppe 1,000 para-gaareta, 7,000 toga asatanne 20,000 tohon bi olettiza wottadarata di7ides; Dawiti 100 gaaretas gidiza parata ashshidi hara parata ubbaas gaade xapho gildaydes.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Damasqo kataman diza Aaraame asati Xoobba dere Kawo Hadaadi7eezere maaddanaas yida wode Dawiti isttafe 22,000 as wodhides. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Hessafe guye Aaraame biittan Damasqo kataman olanchchati dunkaani uttanaaso giigsides; histtiin Aaraame dere asati Dawites haarettidi giirida; Dawiti bidaso ubbaan GODAY izas xoono immides.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Kawo Dawiti Hadaadi7eezere olanchchata halaqati oykkida worqqa gondalleta woththi ekkidi Yerusalaame efides. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Qasseka Dawiti Hadaadi7eezerey haariza Xibahaaneppenne Kuna katamappe keehi daro xarqimala ekkides; Solomooney he xarqimalata gita gabate, tuussatanne dumma dumma miishshata medhissides.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="1KI 7:40-47">1Kawo 7:40-47</ref>; <ref loc="2CH 4:11-18">2Taari 4:11-18</ref></char></note><verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Dawiti Xoobba dere Kawo Hadaadi7eezere olanchchata ubbaa xoonidayssa Hamaate kawo Too7uyi siyides. <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />Histtidi banara olettishe gam7ida Hadaadi7eezere Dawiti oli xoonida gishshas iza hashshu gaanaassinne sarokkanaas Too7uyi ba naaza Hadoraame kawo Dawitekko kiittides; Hadoraamey worqqafe, birappenne xarqimalappe oosettida miishshata izas ekki yides. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />Kawo Dawiti Eedoomeppe, Mo7aabeppe, Amoone asatappe, Filisxeemetappenne Amaaleeqe asatappe di7i ekkida biranne worqqa ha miishshatara issife gaththi GODAAS dummasides.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Xuriya naa Abisayey Eedoome asaappe 18,000 as Maxine Shoobban wodhides.<note caller="-" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="PSA 60">Maza 60</ref></char></note> <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Hessafe guye Dawiti Eedoomen olanchchati dunkaani uttanaaso giigsides; histtiin he biitta asati ubbay Dawites haarettidi giiri aqida; Dawiti bidaso ubbaan GODAY izas xoono immides.<verse eid="1CH 18:13" /></para>
  <para style="s1">Dawiti Shuumida Asata</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Dawiti Isra7eele deraa ubbaa bolla kawotides; deraa ubbaa xilloteththaninne suure pirdan ayssides. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Xuriya naa Iyo7aabey ola gadawa; Ahiluude naa Iyoosaafixey mazgaba keeththa alaafe. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Ahixuube naa Saadooqeynne Abiyaataare naa Abimelekkey qeese; Susahay waanna xaafe; <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Yoodahe naa Bannayay Kelitetassinne Pelitetas halaqa; kawo Dawite attuma nayti iza kawoteththan dhoqqa shuumeta.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Sooriyata Xooneteth</para>
  <para style="r">(<ref loc="2SA 10:1-19">2Same 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Hessafe guye Amooneta kawo Na7oosey hayqqiin iza naazi izasohon kawotides. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Dawiti, «Iza aawa Na7oosey taas lo7o ooththida mala tani iza naa Haanoones lo7o ooththana» gi qoppides; hessa gishshas iza aawaa hayqoza gishshas iza minththeththanaas Dawiti as kiittides.</para>
  <para style="p" vid="1CH 19:2">Dawiti kiittidayti Haanoone minththeththanaas Amoone biitta gakkida wode, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Amoone dere shuumeti Haanoone, «Dawiti ha asata kiittiday ne aawa bonchchidi nena minththeththanaas misatizee? Izi ha asata kiittiday biittayo xomosi xeellanaassinne oli oykkanaassa» gida.<verse eid="1CH 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4" />Histtiin Haanooney Dawiti kiittida asata oykkidi istta buuchchaa meedides; istta may7oka istta kalloy beettanaashe gakkanaas daakkidi istta dere zaari yeddides. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Istti keehi yeellatida gishshas Dawiti hessa siyidi isttara gayttana mala hara as isttako kiittidi, «Intte buuchchi diccana gakkanaas Iyarkko kataman de7iishshite; hessafe guye haa yiite» gides.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Amooneti Dawite matan ba ixettidayssa erida wode Haanooneynne Amooneti Mesphexoomiyappe, Aaraame dere Ma7ikafenne Xoobbafe para-gaaretanne toganchchata qaxxaranaas 34,000 kilo giraame gidiza saqile bira yeddida. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Histtidi 32,000 para-gaareta, toga asata, Ma7ika kawonne iza olanchchata qaxxarida; isttika yiidi Medeban dunkaani uttida; qasse Amooneti bantta katamatappe shiiqettidi olas kezida.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Dawiti hessa siyidi Iyo7aabenne olanchchata ubbaa yeddides. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Amooneti katamaa pengen ke7idi olas yaaddida; istta maaddanaas yida kawotikka banttarkka baas soho oykkidi demban dunkaanida.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Iyo7aabey olay sinththaranne guyera dooddi uttidayssa be7idi Isra7eele asaa ubbaafe erettida ola qarata doori ekkidi Aaraame dere olanchchata sinththan salfissides. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Attida asata iza isha Abisayey kaaleththana mala azazidi Amooneta sinththan salfisides. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Iyo7aabey ba isha Abisayes, «Aaraame asati ta bolla minniko neni yaada tana maadda; Amoone asati ne bolla minnizaa gidikko tani yaada nena maaddana. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Ha7i neni minna! Nu deraa gishshassinne nu Xoossaa katamata gishshas ane minni olettoos; GODAY bana lo7oyssa ooththo» gides.<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Hessafe guye Iyo7aabeynne izara diza olanchchati Aaraame wottadaratara olettanaas biin Aaraame wottadarati istta sinththafe baqatida. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Aaraame wottadarati baqatidayssa Amoone wottadarati be7ida wode isttika iza isha Abisaye sinththafe guye baqatidi katama gelida; hessafe guye Iyo7aabey Yerusalaame simmides.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Aaraame asati Isra7eele asatan xoonettoyssa erida wode qasttanne kiittidi Efiraaxise Shaafappe he pinththan diza Aaraame asata ehisida; Xoobba kawo Hadaadi7eezeres ola gadawa gidida Shobaakey istta kaaleththees.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Dawiti hessa siyida wode Isra7eele olanchchata ubbaa shiishshidi Yordaanoose shaafa pinnidi Aaraame asatara olettanaas istta sinththan salfides; histtiin istti izara olettida. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Gido attiin Aaraame asati Isra7eeleta sinththafe baqatida; Dawiti 7,000 para-gaaretanne 40,000 tohon bi olettiza wottadarata wodhides; istta ola gadawa Shobaakekka wodhides. <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Hadaadi7eezere asay Isra7eeletan xoonettidayssa eridi Dawitera sigettidi izas haarettides; hessafe simmiin Aaraame asay Amoone asaa maaddanaas dosibeenna.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Dawiti Eraaba Katama Oli Oyth</para>
  <para style="r">(<ref loc="2SA 12:26-31">2Same 12:26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Ofinththan kawoti olas keziza wode Iyo7aabey olanchchata kaaleththi biidi Amoone dere dhayssides; Eraabe katamaakka dooddi uttides; gido attiin Dawiti Yerusalaamen takkides; Iyo7aabey Eraaba katama oli laallides.<note caller="-" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="2SA 11:1">2Same 11:1</ref></char></note> <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Hessafe guye Dawiti yiidi istta kawoza hu7eppe worqqa kallachcha ekkides; kallachchazi 34 kilo giraame gidides; iza giddon inqqu geetettiza al7o shuchchi dees; he kallachchaa ekkidi Dawite hu7en goxxida; qasse Dawiti he katamaappe keehi daro miish di7i ekkides. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Heen de7iza deraa kessidi magaaze, xoyllenne kaltta oyththi oosisides; Amoonen diza hara katamatan diza asatakka Dawiti hessaththo oosisides; hessafe guye Dawitinne iza olanchchati ubbay Yerusalaame simmida.<verse eid="1CH 20:3" /></para>
  <para style="s1">Filisxeeme Asatara Olettida Ola</para>
  <para style="r">(<ref loc="2SA 21:15-22">2Same 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Hessafe simmiin Filisxeeme asatara Gezeeren olay dendides; he wode Huushe dere as Sibikayey Erafayme zere gidida Sifaye wodhides; histtiin Filisxeemeti xoonettida.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Hessafe guye Filisxeemetara hara olay dendides; he wode izi oykkiza tooraa toomay shammaane wondiraashe keena gidida Geete katamappe yida Golyaade isha Lahiime Ya7ire naa Elyaaney wodhides.<note caller="-" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="1SA 17:4-7">1Same 17:4-7</ref></char></note><verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Qasseka hara olay Geete kataman dendides; heen izas kusheninne tohon usuppun usuppun biradhdheti issi bolla 24 biradhdheti diza Erafaye zereththafe gidida gubbanne geesa adussa asi dees. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />He addezi Isra7eeleta bolla eqettida wode Dawite isha Shim7a naa Yoonataaney iza wodhides. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Haytanti Geete kataman diza Erafaye zareta; istti ubbay Dawite kusheninne iza asaa kushen hayqqida.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Isra7eele Deraa Dawiti Qoodiseth</para>
  <para style="r">(<ref loc="2SA 24:1-25">2Same 24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Xala7ey Isra7eele asaa bolla meto ehanaas koyidi Dawiti Isra7eele asaa qoodana mala denththeththides. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Dawiti Iyo7aabenne olanchchata halaqata, «Daaneppe biidi Bersaabehe gakkanaas diza Isra7eele asaa qoodite; histtidi asaa qooday aappunakko tana erisite» gides.<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Iyo7aabey gidikko izas, «GODAY ha7i diza Isra7eele asaa bolla xeetu kushe gujjo! Ta godaa kawoo! istti ubbay ta godaa aylleta deettennee? Ta goday hayssa mala ooththanaas ays koyidee? Isra7eele kawoteththaa ays mooranchcha kessizee?» gides.<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Gido attiin kawoza qaalay Iyo7aabe xoonides; histtiin Iyo7aabey kezi Isra7eele biitta ubbaa yuuyi aadhdhi Yerusalaame simmides. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Iyo7aabey qoodida asaa qooda Dawites immides; Isra7eeleppe 1,100,000 Yuhudappe 47,000 olanaas dandayzayta demmides. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />Iyo7aabey kawoza azazon harasettida gishshas Leweta qommotanne Biniyaame qommota qoodibeenna.<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />He azazozi Xoossa matan iita gidida gishshas Xoossi Isra7eele asaa qaxxaydes.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Hessafe guye Dawiti Xoossas, «Tani ha oosozan nena keeha qohadis; tani bala ooththida gishshas tana ne aylleza qoho atto gaana mala ta nena woossays» gides.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />GODAY Dawite nabe Gaades, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />«Baada Dawite, ‹GODAY nena tani ne doorana mala ne sinththan heedzdzu miishshata woththadis; tanikka ne dooridayssa ooththana› gides» gaada yoota.<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Histtiin Gaadey Dawitekko biidi, «GODAY ne sinththan woththoyssafe issaa doora; <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />heedzdzu layththa kosha, woykko heedzdzu agina kumeth ne morkketan goodeteth, woykko heedzdzu gallas iita harge ehiza Xoossa mashshay biitta bolla yiin Isra7eele ubbaa bolla hayqo ehiza Xoossa kiitanchcha yuus, hessa gishshas tana kiittida Xoossaas ta ay zaara yootanaakko heytanttafe ne dooroyssa taas yoota» gides.<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Dawiti Gaades, «Ta dooranaas keeha metotadis; gidikkoka Godaa Xoossa maarotay keehi gita gidida gishshas asa kushen kundanaappe Xoossa kushen kundeththi taas lo7o» gides.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Hessa gishshas GODAY iita harge yeddiin Isra7eeleppe 70,000 asi hayqqides. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Hessafe guye GODAY Yerusalaame dhayssanaas kiitanchcha kiittides; gido attiin kiitanchchazi Yerusalaame dhayssanaas shiiqi uttidaashin GODAY be7idi mishettides; dhayssana yida kiitanchchaa, «Agga! Istta bolla gakkida bashshay gidana» gides. He wode Godaa Xoossaa kiitanchchay Yaabuse dere as Orna bale matan eqqides.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Kiitanchchazi ba giththa mashsha kushen oykkidi Yerusalaame dhayssanaas saloppenne sa7appe giddon eqqidayssa Dawiti dhoqqu gi be7ides; hessafe guye Dawitinne cimati maaqa may7idi biitta bolla gufannida. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Dawiti Xoossaas, «Asay qoodettana mala ooththiday tana gidikkinaa? Nagara ooththidaynne qohiday tana; histtiin hayti dorsati ay ooththidoo? Abeet ta Godaa Xoossawu! Ne kushey ta bollanne ta keeththa asaa bolla gido attiin ha boshaza ne deraa bolla yeddofa» gides.<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Hessafe guye Godaa Xoossaa kiitanchchay Gaades, «Dawiti pude Yaabuse dere as Orna bale biidi Godaa Xoossaas yarsho yarshizaso ooththana mala yoota» gi azazides. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Dawiti Gaadey Godaa Xoossaa sunththan yootoyssaththo ooththanaas bides.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />He wode Ornaynne iza nayti balen gistte bukkishe guye simmi xeellidi kiitanchchaa be7ida; histtidi izara diza oyddu attuma nayti qotettida. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Dawiti Ornako yiin Ornay iza be7idi balezappe gaxa ke7idi Dawites ziggides.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Hessafe guye Dawiti Ornas, «Deraa bolla yida boshay kichchana mala tani Godaa Xoossaas yarsho yarshizaso ooththanaas ne baleza taas bayzarkkii! Tani nees kumeththa waaga qanxxana» gides.<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Histtiin Ornay Dawites, «Nees ekka; ta goday kawoy bana ufayssizayssa ooththo; hekko xuugettiza yarshos boorata, eesos kath bukkiza lodata, kaththa yarsho gidana mala gistte immana; hayta ubbatakka ta nees immana» gides.<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Gido attiin kawo Dawiti Ornas, «Hessi hanenna! Tani kumeththa waaga qanxxada shammana; tani neyssa coo mela ekkada Godaa Xoossaas yarsho shiishshike; qasse ta shammontta miish xuugettiza yarsho ooththa shiishshike» gides.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Hessa gishshas Dawiti he balezas 600 worqqafe oosettida bira immides. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Hessafe guye Dawiti heen Godaa Xoossas yarsho yarshizaso ooththidi xuugettiza yarshonne issifeteththa yarsho shiishshides; izi Godaa Xoossaa woossiin xuugettiza yarsho yarshizasoza bolla saloppe tama yeddidi iza oyshaa zaarides.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Histtiin GODAY kiitanchchaa azaziin kiitanchchazi ba giththa mashshaa koohaan gelththides. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Dawiti GODAY Yaabuse dere as Orna kaththa balen izas zaaridayssa be7idi heen yarsho shiishshides. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Musey bazzon giigsida Godaa Xoossaa Dunkaaneynne xuugettida yarsho yarshizasozi Geba7oone zumbullaa bolla dees. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Dawiti Xoossa kiitanchchay oykkida giththa mashshaas yayyida gishshas hee biidi GODAA oychchanaas dandaybeenna.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Hessa gishshas Dawiti, «Godaa Xoossaa keeththinne Isra7eele asay xuugettiza yarsho yarshizasoy hayssan dees» gides.<verse eid="1CH 22:1" /></para>
  <para style="s1">Xoossa Keeth Keexxanaas Giigeteth</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Kawo Dawiti Isra7eele biittan diza hara dere asay issi bolla shiiqana mala azazides; istta giddofe Xoossa Keeththaa keexxanaas masettida shuch giigsanaas shuch qerizayta giigsides. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Dawiti gimbaa pengetas misimaarenne maaxafa gidana mala daro biratanne meezaaneppe bolla gidida keehi daro xarqimala giigsides. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Sidoona asaynne Xiroose asay daro ziga mith ehiza gishshas qooday baynda keehi daro ziga mith giigsides.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Dawiti, «Ta naa Solomooney yelaganne oosaara meezetonttayssa; Godaa Xoossaas keexettana keeththay biitta ubbaan erettida lo7onne puula keeth gidanaas bessees; hessa gishshas izas koshshizayssa tani giigsana» gides; Dawiti hayqqanaappe sinththan daro miish giigsides.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Hessafe guye Dawiti ba naa Solomoone xeygidi GODAA Isra7eele Xoossa Keeththaa keexxana mala azazides. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Dawiti Solomoone, «Ta naazoo, tani GODAA ta Xoossaa bonchchos Keeththe keexxanaas ta wozinan qoppadis. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Gido attiin Godaa Xoossaa qaalay tana, ‹Neni daro suuth gussadasa; daro olakka olettadasa; neni sa7a bolla ta sinththan daro suuth gussida gishshas neni taas Keeththe keexxana mala koykke› gides. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Gidikkoka, ‹Saroninne woppan ayssiza naa ne yelana; ubbaa baggara diza morkketappe ta iza shempisana; iza sunththika Solomoone geetettana; iza kawoteththa layth ubbaan tani Isra7eeles saronne woppa immana. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Izi ta bonchchos Keeththe keexxana; izi taas naa gidana; tanikka izas aawa gidana; iza kawoteththa araatay Isra7eele bolla mernaas minni daana› giidi hidota immides.<note caller="-" style="x"><char style="xo" closed="false">22:7-10 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2Same 7:1-16</ref>; <ref loc="1CH 17:1-14">1Taari 17:1-14</ref></char></note><verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />«Ha7ikka ta naazoo! GODAY nenara gido; izi nees immida hidota qaalaa mala GODAA ne Xoossaa keeth keexxanaassinne polanaas nena gaththo. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />GODAY nena Isra7eele bolla kawoththida wode GODAA ne Xoossaa wogaa neni naagana mala Xoossi nees aadho erateththinne akeeka immo. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />GODAY Muse baggara Isra7eeles immida wogaanne maaraa ne naagikko ubbayka nees injje gidana; aykkoy baa, yayyofa, minna, murtta, hidota qanxxofa.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />«Tani ta wolqqay gaththida mala Godaa Xoossaa Keeththe keexxanaas 3,400 kilo giraame gidiza worqqanne 34,000 kilo giraame gidiza bira shiishshadis; qasseka keehi daro xarqimalanne birata, miththinne shuch giigsadis; hessa bolla gujissizayssa neni gujja. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Ne matan dumma dumma ooso eriza hiillati deettes; shuch qerizaytinne massizayti, anaaxetinne ubba ooso ooththanaas dandayza hiillati deettes. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />Worqqa, bira, xarqimalanne birata ooson erettida dumma dumma hiillati nees deettes; ha7i neni oosoza doomma; GODAY nenara gido» gides.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Dawiti Isra7eele deraa kaaleththizayta ubbaa ba naa Solomoone maaddana mala, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />«GODAA intte Xoossay hayssa gakkanaas inttenara dees gidennee? Izi inttena ubbasora shempisibeennee? Ha biittan diza asaa izi ta kushen aaththi immida gishshas ha biittaya Godaa Xoossassinne iza deraas haarettadus. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Hessa gishshas GODAA intte Xoossaa koyanaas intte wozinanne intte shemppo immite; GODAA Xoossaa bonchchos keexettida keeththaan Xoossa Taabotaanne Xoossas dummatida miishshata ehidi woththana mala intte dendidi GODAA Keeththe keexxite» gi azazides.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Dawiti ceeggida wode ba naa Solomoone Isra7eele bolla kawoththides.<note caller="-" style="x"><char style="xo" closed="false">23:1 </char><char style="xt" closed="false"><ref loc="1KI 1:1-40">1Kawo 1:1-40</ref></char></note><verse eid="1CH 23:1" /></para>
  <para style="s1">Leweta Ooso</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Dawiti Isra7eele kaaleththiza ubbata, qeesetanne Leweta issife shiishshides. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Isttas layththay heedzdzu tammanne hessafekka bollara gidida attuma asata Lewetappe qoodides; istta qooday kumeth 38,000 gidides. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Haytanttafe 24,000 Xoossaa Keeththa ooso kaaletti xeellana mala aawateth isttas immides; qasse 6,000 asatas shuumetanne pirda daannata histti woththides. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Oyddu shiyatas gimbeza penge naagana mala aawateth immides; attida oyddu shiyatas ba ooththida yeththa massaratan GODAA Xoossa galatana mala sunththides.<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />Dawiti Lewey yelida attuma nayta Gershoone, Qa7aatenne Meraare istta zarkken zarkken heedzdzu kessi shaakkides.<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />Gershooney yelida attuma nayti Laadaanenne Shim7e. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />Laadaane attuma nayti heedzdza; isttika Yihi7eele, Zettaamenne Iyu7eele. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Shim7e attuma nayti heedzdza; isttika Shalomite, Hazi7eelenne Haaraane; heyti Laadaane zarkketas halaqata. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Shim7e attuma nayti, Yahaate, Ziina, Ya7uushenne Barihe. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Bayrazi Yahaate, kaalozi Ziina; Ya7uushessinne Barihes daro attuma nayti baynda gishshas issi keeththa asa mala qoodettida.<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />Qa7aates oyddu attuma nayti deettes; heytikka Amiraame, Yixihaare, Kebroonenne Uzi7eele. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />Amiraame attuma nayti Aaroonenne Muse; Aarooneynne iza zereththati Xoossa Keeththan go7ettiza miishshata mernaas dummasana mala, Xoossas yarsho shiishshana mala, Xoossa sinththan haggazana malanne iza sunththan deraa mernaas anjjana mala dummatida.<note caller="-" style="x"><char style="xo" closed="false">23:13 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Kessa 28:1</ref></char></note> <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Xoossa as Muse attuma naytikka Lewe qommota mala qoodettida. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />Muse nayti Gershoomenne El7ezeere. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />Gershoome naytas halaqay bayra naaza Shuba7eele. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />El7ezeeres issi attuma nay xalla dees; izikka Erahaabiya; Erahaabiyas gidikko daro attuma nayti deettes.<verse eid="1CH 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 23:18" />Yixihaare naytas halaqay bayra naaza Shalomite. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />Kebroone naytappe bayrazi Yiriya, nam7anththozi Amaariya, heedzdzanththozi Yahazi7eele, oydanththozi Yoqima7aame. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Uzi7eele attuma naytappe bayrazi Mikiyaasa, kaalozi Yishiya.<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />Meraare attuma nayti Mahilenne Mushe; Mahile attuma nayti El7ezeerenne Qiise. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />El7ezeerey macca naa xalla yelidi attuma naa yelontta hayqqides; hessa gishshas istti bantta aawa isha Qiise nayta gelida. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Mushe attuma nayti heedzdza; heytikka Mahile, Edeerenne Yarmoote.<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />Haytanti ubbay baso asataninne ba zarkketan xeygettida; Lewe zareti issoy issoy ba sunththan mazgabettida; isttas layththay nam7u tammanne hessafe bolla gididayti Xoossa Keeththan ooththeettes. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Dawiti, «Isra7eele Godaa Xoossi ba asaa shempisides; Yerusalaamen mernaas de7ana. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Hayssafe guye Leweti Dunkaanezanne iza giddon go7ettiza miishshata tookkanaas bessenna» gides.<note caller="-" style="x"><char style="xo" closed="false">23:26 </char><char style="xt" closed="false"><ref loc="DEU 10:8">Zaare 10:8</ref></char></note> <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Dawiti wurseththan immida azazo mala isttas layththay nam7u tammanne hessafe bollara gidida Leweti qoodettida.<verse eid="1CH 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Leweta oosoy Xoossa Keeththan Aaroone zereththata ooson ooththi maado, Xoossa Keeththa giddozanne gibbeza lo7eththi naago, Xoossa Keeththa oosos dummatida miishshata lo7eththi oyththinne Xoossa Keeththan diza hara oosotakka lo7eththi ooso. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Qasseka Xoossa sinththan woththiza ukeththas, kaththa yarshos shiishshiza dhiilles, munuqanaas, irshoy baynda uukettiza uketh uukkanaas, makkizaazassinne meezaanizaazas alaafeteththi isttas imettides. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Hessaththoka istti ubbaa gallas maaladonne omars Godaa Xoossa sinththan eqqidi galatanaasinne bonchchanaas, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />sambata gallas, aginay doommiza koyro gallassatan, ba7aale gallassatan wogaa qooda mala Godaa Xoossa sinththan ubba wode xuugetti shiiqiza yarsho shiishshanaas, <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />Gaytoteththa Dunkaanenne Xoossa Keeth naaganaas, iza giddon oosettiza goyno wogata polishin ba dabbo Aaroone zereththata maaddanaas aawateththi imettides.<note caller="-" style="x"><char style="xo" closed="false">23:28-32 </char><char style="xt" closed="false"><ref loc="NUM 3:5-9">Tay 3:5-9</ref></char></note><verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Qeeseta Ooso</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Aaroone nayta cugay hayssafe kaallizayssa; Aaroone nayti Nadaabe, Abihu, El7ezeerenne Itamaare. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Nadaabeynne Abihuy naa yelontta ba aawappe kaseti hayqqida; hessa gishshas El7ezeereynne Itamaarey qeese gidida. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Dawiti El7ezeere zarkkefe Saadooqenne Itamaare zarkkefe Ahimelekera gididi Aaroone zareta istta ooson ooson maaddana mala shaakki woththides. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />El7ezeere zare halaqati Itamaare zare halaqatappe daro gidida gishshas El7ezeere zareti tammanne usuppun cugan shaakettiin, Itamaare zareti osppun cugan shaakettida. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Xoossa Keeththaa kaaleththizaytinne Xoossa cimati El7ezeere zareta giddoninne Itamaare zareta giddon diza gishshas oonakka maaddontta oosoza saaman shaakkida. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />Lewe zare Natina7eele naa xaafezi Shama7ey kawoza sinththaninne iza shuumeta sinththan, qeese Saadooqe sinththaninne Abiyaataare naa Ahimeleke sinththan, qeeseta sinththaninne Lewetaso asaa halaqata sinththan istta sunththaa xaafides; histtiin El7ezeere keeththa asata halaqatappe issoynne Itamaare keeththa asata halaqatappe issoy bantta taran taran saama kessida.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />Ha asati saama kessiin</para>
  <para style="q2" vid="1CH 24:7">koyro saamay Yoharibe gakkides;</para>
  <para style="q2" vid="1CH 24:7">nam7anththozi</para>
  <para style="q2" vid="1CH 24:7">Yaddaya gakkides;<verse eid="1CH 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 24:8" />Heedzdzanththozi</para>
  <para style="q2" vid="1CH 24:8">Harime gakkides;</para>
  <para style="q2" vid="1CH 24:8">Oydanththozi</para>
  <para style="q2" vid="1CH 24:8">Sa7oorime gakkides.<verse eid="1CH 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 24:9" />Ichchashanththozi</para>
  <para style="q2" vid="1CH 24:9">Malkiya gakkides;</para>
  <para style="q2" vid="1CH 24:9">Usuppunththozi</para>
  <para style="q2" vid="1CH 24:9">Miyaamine gakkides;<verse eid="1CH 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 24:10" />Laappunththozi</para>
  <para style="q2" vid="1CH 24:10">Haqoxe gakkides;</para>
  <para style="q2" vid="1CH 24:10">osppunththozi</para>
  <para style="q2" vid="1CH 24:10">Abiya gakkides;<verse eid="1CH 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 24:11" />Uddufunththozi</para>
  <para style="q2" vid="1CH 24:11">Iyaaso gakkides;</para>
  <para style="q2" vid="1CH 24:11">tammanththozi</para>
  <para style="q2" vid="1CH 24:11">Shakaaniya gakkides;<verse eid="1CH 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 24:12" />Tamman issinththozi</para>
  <para style="q2" vid="1CH 24:12">Elyaasheebe gakkides;</para>
  <para style="q2" vid="1CH 24:12">tamman nam7anththozi</para>
  <para style="q2" vid="1CH 24:12">Yaaqime gakkides;<verse eid="1CH 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 24:13" />Tamman heedzdzanththozi</para>
  <para style="q2" vid="1CH 24:13">Huppa gakkides;</para>
  <para style="q2" vid="1CH 24:13">tamman oydanththozi</para>
  <para style="q2" vid="1CH 24:13">Yasheba7aabe gakkides;<verse eid="1CH 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 24:14" />Tamman ichchashanththozi</para>
  <para style="q2" vid="1CH 24:14">Bilga gakkides;</para>
  <para style="q2" vid="1CH 24:14">Tamman usuppunththozi</para>
  <para style="q2" vid="1CH 24:14">Imere gakkides;<verse eid="1CH 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 24:15" />Tamman laappunththazi</para>
  <para style="q2" vid="1CH 24:15">Hezire gakkides;</para>
  <para style="q2" vid="1CH 24:15">tamman osppunththozi</para>
  <para style="q2" vid="1CH 24:15">Hafixeexe gakkides;<verse eid="1CH 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 24:16" />Tamman uddufunththozi</para>
  <para style="q2" vid="1CH 24:16">Pattaya gakkides;</para>
  <para style="q2" vid="1CH 24:16">nam7u tammanththazi</para>
  <para style="q2" vid="1CH 24:16">Hiziqeela gakkides;<verse eid="1CH 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 24:17" />Nam7u tamman issinththozi</para>
  <para style="q2" vid="1CH 24:17">Yaakine gakkides;</para>
  <para style="q2" vid="1CH 24:17">nam7u tamman nam7anththozi</para>
  <para style="q2" vid="1CH 24:17">Gaamule gakkides;<verse eid="1CH 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 24:18" />Nam7u tamman heedzdzanththozi</para>
  <para style="q2" vid="1CH 24:18">Dallaya gakkides;</para>
  <para style="q2" vid="1CH 24:18">Nam7u tamman oydanththozi</para>
  <para style="q2" vid="1CH 24:18">Ma7aaziya gakkides.<verse eid="1CH 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Isra7eele GODAY istta azazida malanne kase istta aawa Aarooney isttas woththida waaga mala istti Xoossaa keeth geliza wode ooththana mala imettida wogay hayssa.<verse eid="1CH 24:19" /></para>
  <para style="s1">Attida Hara Leweta Ooso</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />Attida hara Lewe zareti</para>
  <para style="q1" vid="1CH 24:20">Amiraame naytappe Shebu7eele,</para>
  <para style="q2" vid="1CH 24:20">Shebu7eele naytappe Yehidaye.<verse eid="1CH 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 24:21" />Erahaabiya naytappe bayra naaza Yishiya.<verse eid="1CH 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 24:22" />Yixihaaretappe Shalomite;</para>
  <para style="q2" vid="1CH 24:22">Shalomite naytappe Yahaate.<verse eid="1CH 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 24:23" />Kebroone naytappe koyrozi Yiriya, nam7anththozi Amaariya, heedzdzanththozi Yahazi7eele, oydanththozi Yoqima7aame.<verse eid="1CH 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 24:24" />Uzi7eele naytappe Mikiyaasa naa Shamire.<verse eid="1CH 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 24:25" />Mikiyaasa isha Yishiya naytappe Zakaraasa.<verse eid="1CH 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 24:26" />Meraare attuma nayti Mahile, Mushenne Yaa7ize. <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Yaa7ize attuma nayti Benno, Shohaame, Zakurenne Ibire. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />Mahile attuma nayti El7ezeerenne Qiise; El7ezeeres attuma nay deenna. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />Qiises Yerahim7eele geetettiza issi attuma nay dees. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />Mushes Mahile, Edeerenne Yarmoote geetettiza heedzdzu attuma nayti deettes.</para>
  <para style="p" vid="1CH 24:30">Haytanti baso asan asan qoodettida Lewe zareta.<verse eid="1CH 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />Istta isha Aaroone nayti ooththoyssaththo kawo Dawite sinththan, Saadooqe sinththan, Ahimeleke sinththan, hessaththoka qeesetaso asata halaqatinne Lewetaso asata halaqati dizason saama yeggida; bayrazappe biidi wurseth gakkanaas dizaytas issi gina saama yeggida.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Xoossa Keeththan Yexxizayta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Dawitinne ola gadawati Aasaafe naytappe, Hemaane naytappenne Edotaane naytappe maasinqon, diiththaninne daalan awajjishe tinbite yootizayta doori woththida; hayssa ha oosoza ooththana mala doorettida asata sunththi hayssafe kaalli dizayssa.<verse eid="1CH 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2" />Aasaafe naytappe Zakure, Yooseefe, Nataniyanne Asher7eele; hayti Aasaafe nayti kawoy azaziin tinbite yootiza Aasaafeppe garsara azazetteettes.<verse eid="1CH 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3" />Edotaane naytappe Godoliyaasa, Xeere, Yesha7iya, Shim7e, Hashaabiyanne Matitiya; ha usuppunati maasinqon GODAA galatishenne bonchchishe tinbite yootiza ba aawa Edotaaneppe garsara azazetteettes.<verse eid="1CH 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4" />Hemaane naytappe Buuqiya, Maataaniya, Uzi7eele, Shuba7eele, Yarmoote, Hanaaniya, Hanaane, El7aata, Gidolte, Eromaamte-Eezere, Yoshibaqaashe, Maalota, Hotirenne Mahizi7oote. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Hayti ubbatikka kawozas tinbite yootiza Hemaane nayta; Xoossay izas immana gida mala Hemaane dhoqqu dhoqqu histtanaas ha 14 attuma naytanne 3 macca nayta izas immides. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />Hayti ubbay GODAA keeththan daala giirissishe, maasinqonne diith diixxishe bantta aawappe garsara Xoossa Keeththan ooththeettes.</para>
  <para style="p" vid="1CH 25:6">Aasaafey, Edotaaneynne Hemaaney kawozappe garsara azazettishe deettes. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Hayti ba dabbotara gididi GODAA sinththan shiiqiza mazamure tamaari loohidayta; istta qooday mulera nam7u xeetanne osppun tammanne osppuna. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Istti bantta ooso shaakki eranaas cimanne naa, astamaarenne tamaare gi shaakkontta issi gina saama yeggida.<verse eid="1CH 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 25:9" />Koyro saamay</para>
  <para style="q2" vid="1CH 25:9">Aasaafe baggafe gidida</para>
  <para style="q2" vid="1CH 25:9">Yooseefe naytassinne</para>
  <para style="q2" vid="1CH 25:9">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:9">isttas qooday 12;</para>
  <para style="q2" vid="1CH 25:9">nam7anththo</para>
  <para style="q2" vid="1CH 25:9">saamay Godoliyaasas,</para>
  <para style="q2" vid="1CH 25:9">iza naytassinne</para>
  <para style="q2" vid="1CH 25:9">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:9">isttas qooday 12.<verse eid="1CH 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 25:10" />Heedzdzanththo</para>
  <para style="q2" vid="1CH 25:10">saamay Zakures,</para>
  <para style="q2" vid="1CH 25:10">iza naytassinne</para>
  <para style="q2" vid="1CH 25:10">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:10">isttas qooday 12.<verse eid="1CH 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 25:11" />Oydanththo</para>
  <para style="q2" vid="1CH 25:11">saamay Yexires,</para>
  <para style="q2" vid="1CH 25:11">iza naytassinne</para>
  <para style="q2" vid="1CH 25:11">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:11">isttas qooday 12.<verse eid="1CH 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 25:12" />Ichchashanththo</para>
  <para style="q2" vid="1CH 25:12">saamay Nataniyas,</para>
  <para style="q2" vid="1CH 25:12">iza naytassinne</para>
  <para style="q2" vid="1CH 25:12">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:12">isttas qooday 12.<verse eid="1CH 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 25:13" />Usuppunththo</para>
  <para style="q2" vid="1CH 25:13">saamay Buuqiyas,</para>
  <para style="q2" vid="1CH 25:13">iza naytassinne</para>
  <para style="q2" vid="1CH 25:13">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:13">isttas qooday 12.<verse eid="1CH 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 25:14" />Laappunththo</para>
  <para style="q2" vid="1CH 25:14">saamay Asher7eeles,</para>
  <para style="q2" vid="1CH 25:14">iza naytassinne</para>
  <para style="q2" vid="1CH 25:14">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:14">isttas qooday 12.<verse eid="1CH 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 25:15" />Osppunththo</para>
  <para style="q2" vid="1CH 25:15">saamay Yesha7iyas,</para>
  <para style="q2" vid="1CH 25:15">iza naytassinne</para>
  <para style="q2" vid="1CH 25:15">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:15">isttas qooday 12.<verse eid="1CH 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 25:16" />Uddufunththo</para>
  <para style="q2" vid="1CH 25:16">saamay Maataaniyas,</para>
  <para style="q2" vid="1CH 25:16">iza naytassinne</para>
  <para style="q2" vid="1CH 25:16">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:16">isttas qooday 12.<verse eid="1CH 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 25:17" />Tammanththo</para>
  <para style="q2" vid="1CH 25:17">saamay Shim7es,</para>
  <para style="q2" vid="1CH 25:17">iza naytassinne</para>
  <para style="q2" vid="1CH 25:17">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:17">isttas qooday 12.<verse eid="1CH 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 25:18" />Tammanne issinththo</para>
  <para style="q2" vid="1CH 25:18">saamay Azari7eeles,</para>
  <para style="q2" vid="1CH 25:18">iza naytassinne</para>
  <para style="q2" vid="1CH 25:18">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:18">isttas qooday 12.<verse eid="1CH 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 25:19" />Tammanne nam7anththo</para>
  <para style="q2" vid="1CH 25:19">saamay Hashaabiyas,</para>
  <para style="q2" vid="1CH 25:19">iza naytassinne</para>
  <para style="q2" vid="1CH 25:19">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:19">isttas qooday 12.<verse eid="1CH 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 25:20" />Tammanne heedzdzanththo</para>
  <para style="q2" vid="1CH 25:20">saamay Shebu7eeles,</para>
  <para style="q2" vid="1CH 25:20">iza naytassinne</para>
  <para style="q2" vid="1CH 25:20">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:20">isttas qooday 12.<verse eid="1CH 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 25:21" />Tammanne oydanththo</para>
  <para style="q2" vid="1CH 25:21">saamay Matitiyas,</para>
  <para style="q2" vid="1CH 25:21">iza naytassinne</para>
  <para style="q2" vid="1CH 25:21">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:21">isttas qooday 12.<verse eid="1CH 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 25:22" />Tammanne ichchashanththo</para>
  <para style="q2" vid="1CH 25:22">saamay Yarmootes,</para>
  <para style="q2" vid="1CH 25:22">iza naytassinne</para>
  <para style="q2" vid="1CH 25:22">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:22">isttas qooday 12.<verse eid="1CH 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 25:23" />Tammanne usuppunththa</para>
  <para style="q2" vid="1CH 25:23">saamay Hanaaniyas,</para>
  <para style="q2" vid="1CH 25:23">iza naytassinne</para>
  <para style="q2" vid="1CH 25:23">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:23">isttas qooday 12.<verse eid="1CH 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 25:24" />Tammanne laappunththa</para>
  <para style="q2" vid="1CH 25:24">saamay Yoshibaqaashes,</para>
  <para style="q2" vid="1CH 25:24">iza naytassinne</para>
  <para style="q2" vid="1CH 25:24">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:24">isttas qooday 12.<verse eid="1CH 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 25:25" />Tammanne osppunththa</para>
  <para style="q2" vid="1CH 25:25">saamay Hanaanes,</para>
  <para style="q2" vid="1CH 25:25">iza naytassinne</para>
  <para style="q2" vid="1CH 25:25">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:25">isttas qooday 12.<verse eid="1CH 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 25:26" />Tammanne uddufunththo</para>
  <para style="q2" vid="1CH 25:26">saamay Maalotas,</para>
  <para style="q2" vid="1CH 25:26">iza naytassinne</para>
  <para style="q2" vid="1CH 25:26">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:26">isttas qooday 12.<verse eid="1CH 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 25:27" />Nam7u tammanththo</para>
  <para style="q2" vid="1CH 25:27">saamay El7aatas,</para>
  <para style="q2" vid="1CH 25:27">iza naytassinne</para>
  <para style="q2" vid="1CH 25:27">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:27">isttas qooday 12.<verse eid="1CH 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 25:28" />Nam7u tammanne issinththo</para>
  <para style="q2" vid="1CH 25:28">saamay Hotires,</para>
  <para style="q2" vid="1CH 25:28">iza naytassinne</para>
  <para style="q2" vid="1CH 25:28">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:28">isttas qooday 12.<verse eid="1CH 25:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 25:29" />Nam7u tammanne nam7anththo</para>
  <para style="q2" vid="1CH 25:29">saamay Gidoltes,</para>
  <para style="q2" vid="1CH 25:29">iza naytassinne</para>
  <para style="q2" vid="1CH 25:29">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:29">isttas qooday 12.<verse eid="1CH 25:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 25:30" />Nam7u tammanne heedzdzanththo</para>
  <para style="q2" vid="1CH 25:30">saamay Mahizi7ootes,</para>
  <para style="q2" vid="1CH 25:30">iza naytassinne</para>
  <para style="q2" vid="1CH 25:30">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:30">isttas qooday 12.<verse eid="1CH 25:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 25:31" />Nam7u tammanne oydanththo</para>
  <para style="q2" vid="1CH 25:31">saamay Eromaamte-Eezeres,</para>
  <para style="q2" vid="1CH 25:31">iza naytassinne</para>
  <para style="q2" vid="1CH 25:31">iza dabbotas kezides;</para>
  <para style="q2" vid="1CH 25:31">isttas qooday 12.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Xoossa Keeththa Penge Naagizayta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Xoossa Keeththaa penge naagizayti hayssafe kaallizayta.</para>
  <para style="p" vid="1CH 26:1">Qoore baggafe Aasaafe nayta garsan Qoore naa Mashelemiya. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Mashelemiya nayti,</para>
  <para style="q2" vid="1CH 26:2">koyroy Zakaraasa,</para>
  <para style="q2" vid="1CH 26:2">nam7anththozi Yidi7eele,</para>
  <para style="q2" vid="1CH 26:2">heedzdzanththozi Zabaadiya,</para>
  <para style="q2" vid="1CH 26:2">oydanththozi Yaatin7eele,<verse eid="1CH 26:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="1CH 26:3" />ichchashanththozi Elaame,</para>
  <para style="q2" vid="1CH 26:3">usuppunththozi Yihohanaane,</para>
  <para style="q2" vid="1CH 26:3">laappunththozi Elho7enaye.<verse eid="1CH 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="1CH 26:4" />Xoossi Obeed-Eedoome</para>
  <para style="q2" vid="1CH 26:4">anjjida gishshas</para>
  <para style="q2" vid="1CH 26:4">izi osppun attuma nayta yelides;</para>
  <para style="q2" vid="1CH 26:4">koyrozi Shama7e,</para>
  <para style="q2" vid="1CH 26:4">nam7anththozi Yihozabaade,</para>
  <para style="q2" vid="1CH 26:4">heedzdzanththozi Yo7aaha,</para>
  <para style="q2" vid="1CH 26:4">oydanththozi Sakkare,</para>
  <para style="q2" vid="1CH 26:4">ichchashanththozi Natina7eele,<verse eid="1CH 26:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="1CH 26:5" />usuppunththozi Am7eele,</para>
  <para style="q2" vid="1CH 26:5">laappunththozi Yisakoore,</para>
  <para style="q2" vid="1CH 26:5">osppunththozi Pilate.<note caller="-" style="x"><char style="xo" closed="false">26:4-5 </char><char style="xt" closed="false"><ref loc="2SA 6:11">2Same 6:11</ref>; <ref loc="1CH 13:14">1Taari 13:14</ref></char></note><verse eid="1CH 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 26:6" />Qasse Obeed-Eedoome naa Shama7eykka attuma nayta yelides; istti erettida mino as gidida gishshas bantta aawa keeththan halaqa gidida. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Shama7e nayti Ootine, Erafa7eele, Iyoobeedenne Elzabaade; istta ishati Eelihuynne Samaakey erettida mino asata. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Hayti ubbati Obeed-Eedoome zareta; isttas, istta naytinne istta dabboti oosos keehi mino asata; Obeed-Eedoome zareti mulera usuppun tammanne nam7a.<verse eid="1CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9" />Mashelemiyas erateththi kumida mino naytinne dabboti deettes; istti mulera tammanne osppuna.<verse eid="1CH 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 26:10" />Meraare baggafe gidida Hoosaskka attuma nayti deettes; issoy Shimire; izi bayra gidontta aggikokka iza aaway iza bayrasides. <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />Nam7anththozi Kilqiyaasa,</para>
  <para style="q2" vid="1CH 26:11">heedzdzanththozi Xabaaliya,</para>
  <para style="q2" vid="1CH 26:11">oydanththozi Zakaraasa;</para>
  <para style="q2" vid="1CH 26:11">Hoosa naytinne iza dabboti mulera</para>
  <para style="q2" vid="1CH 26:11">tammanne heedzdza.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Xoossa Keeththa penge naagizayti bantta keeththa asaa halaqata garsan cugan cugan shaakettidi istta dabboti ooththoyssaththo Xoossa Keeththa ooso ooththanaas ba taran taran uttida. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Pengeta ubbaa naaganaas bantta keeththan keeththan cimanne yooga gontta issi bolla saama kessida. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Arshey mokkiza baggara diza pengeza naaganaas saamay Shelemiyas kezides; pudeha baggara diza pengeza naaganaas saamay lo7o zoriza iza naa Zakaraasas kezides. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Dugeha baggara diza pengeza naaganaas saamay Obeed-Eedoomes kezides; minjja keeththaa naaganaas saamay iza nayta gakkides. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Arshey wulliza baggara diza pengezanne ganna oge baggara diza Shelekete penge naaganaas saamay Shufimessinne Hoosas kezides.<verse eid="1CH 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 26:17" />Issi baggara naagiza zabeta ginara hara zabey dees; hach hach arshey mokkiza baggara usuppun zabeti, pudeha baggara oyddu zabeti, minjja keeththa naaganaas nam7u zabeti, <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />arshey wulliza baggara diza dubbusha demban nam7u zabe qasseka oge bolla oyddu zabe gididi naageettes.<verse eid="1CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19" />Qoore zaretasinne Meraare zaretas penge naaganaas imettida istta ooso gishay hessa.<verse eid="1CH 26:19" /></para>
  <para style="s1">Xoossa Keeththan Ooththiza Hara Shuumeta</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Lewe baggafe Akayay Xoossa Keeththa giddon diza minjja keeththanne Xoossas dummasi woththida imotata naaganaas aawateththi izas imettides. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Yihi7eele aawa Laadaaney Gershoone baggafe gidida iza nayti baso keeththa asatas halaqata. <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />Yihi7eele naa Zettaamessinne iza isha Iyu7eeles Xoossa Keeththa giddon diza minjja keeththaa naaganaas aawateththi imettides.<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />Amiraame zaretas, Yixihaare zaretas, Kebroone zaretasinne Uzi7eele zaretas istta gisha oosoy imettides. <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />Muse naa Gershoome zareppe gidida Shuba7eeles minjja keeththa naagizayta bolla alaafeteththi imettides. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Izi Gershoome isha El7ezeere baggara Shalomites dabbotees; El7ezeerey Erahaabiya yelides; Erahaabiyay Yesha7iya yelides; Yesha7iyay Iyoraame yelides; Iyoraamey Zikire yelides; Zikirey Shalomite yelides. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Kawo Dawiti, izaso asata halaqati, shaalaqati, mato halaqatinne ola gadawati Xoossas dummasi woththida miishshata ubbaa naaganaas Shalomitessinne iza dabbotas aawateththi imettides. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Kase olan di7i ehida miishshafe baggaa Xoossa Keeththa giigsanaas dummasi woththida. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Qasse nabe Sameeli, Qiise naa Sa7ooli, Neere naa Abineerinne Xuriya naa Iyo7aabey kase dummasi woththida miish ubbaanne hara Xoossa Keeththa miishshata ubbaa Shalomiteynne iza dabboti naageettes.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />Yixihaare zaretappe Kanaaniyassinne iza naytas Xoossa Keeththafe kare baggara diza oosotan Isra7eele asaa aassanaassinne istta bolla pirdanaas aawateththi imettides.<verse eid="1CH 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30" />Kebroone zareppe Hashaabiyaynne iza dabboti 1,700 mino asati Yordaanoose shaafappe he pinththan arshey wulliza baggara diza Isra7eele asaa bolla GODAA oososinne kawo oosos shuumettida. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Kebroone zaretappe isttaso asaa mazgabezan xaafettida mala Yiiriyay isttas halaqa gidides; kawo Dawiti kawotida oyddu tammanththa layththan mazgabe pilggi xeellishin Gala7aade deren Iyaazeere geetettizason Kebroone asatappe mino asati beettida. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yiriyas minonne soo asatas halaqa gidida 2,700 dabboti deettes; kawo Dawiti istti Xoossa ooso ooththanaassinne kawo ooso ooththana mala Oroobeele qommota bolla, Gaade qommota bollanne Minaase qommotappe baggata bolla shuumides.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Isra7eele Olanchchata Kaaleththizayta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Bantta butten butten layth kumeth aginan aginan kawozasinne deraas taran taran ooththiza Isra7eele keeththa asata halaqati, shaalaqatinne mato halaqati, ola gadawati hayssafe kaallizayta; issi issi butten 24,000 asi dees.<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />Koyro aginan ooththiza buttezas alaafey Zabdi7eele naa Yashobi7aame; iza buttezan 24,000 asi dees. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Yashobi7aamey Paareese zare; izi koyro aginan olas ke7iza halaqatas gadawa.<verse eid="1CH 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 27:4" />Nam7anththo aginan ooththiza buttezas alaafey Ahihohe dere as Doodeya; iza buttezan 24,000 asi dees; ha butteza izappe garsara kaaleththizay Miqiloote.<verse eid="1CH 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 27:5" />Heedzdzanththo aginan ooththiza buttezas alaafey qeese Yoodahe naa Bannaya; iza buttezan 24,000 asi dees. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Bannayay 30 asatappe aadhdhi erettida mino as gidida gishshas izi istta bolla halaqa gidides; iza naa Amizabaadey izappe garsara azazizaade gidides.<verse eid="1CH 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 27:7" />Oydanththo aginan ooththiza buttezas alaafey Iyo7aabe isha Asaheele; iza buttezan 24,000 asi dees; izasohon alaafetiday iza naa Zabaadiya.<verse eid="1CH 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 27:8" />Ichchashanththo aginan ooththiza buttezas alaafey Yixira as Shamihuute; iza buttezan 24,000 asi dees.<verse eid="1CH 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 27:9" />Usuppunththo aginan ooththiza buttezas alaafey Tequhe as Iqesha naa Ira; iza buttezan 24,000 asi dees.<verse eid="1CH 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 27:10" />Laappunththo aginan ooththiza buttezas alaafey Efreeme zareppe Piloone dere as Heleexe; iza buttezan 24,000 asi dees.<verse eid="1CH 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 27:11" />Osppunththo aginan ooththiza buttezas alaafey Huushe as Sibikaye; izi Zaraahe zareppe yides; iza buttezan 24,000 asi dees.<verse eid="1CH 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 27:12" />Uddufunththo aginan ooththiza buttezas alaafey Biniyaame zareppe Anatoote as Abi7eezere; iza buttezan 24,000 asi dees.<verse eid="1CH 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 27:13" />Tammanththo aginan ooththiza buttezas alaafey Zaraahe zareppe Naxoofe dere as Mahiraye; iza buttezan 24,000 asi dees.<verse eid="1CH 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 27:14" />Tammanne issinththo aginan ooththiza buttezas alaafey Efreeme zareppe Piraatoone as Bannaya; iza buttezan 24,000 asi dees.<verse eid="1CH 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 27:15" />Tammanne nam7anththo aginan ooththiza buttezas alaafey Otin7eele zareppe Naxoofe dere as Heldaye; iza buttezan 24,000 asi dees.<verse eid="1CH 27:15" /></para>
  <para style="s1">Isra7eele Asaa Garsan Qommota Qommota Kaaleththiza Ola Gadawata</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Isra7eele asaa garsan qommota qommota bolla shuumettida ola gadawati hayssafe kaallidi xaafettidayta.</para>
  <para style="q2" vid="1CH 27:16">Oroobeele qommo bolla</para>
  <para style="q2" vid="1CH 27:16">summiday Zikire naa El7ezeere.</para>
  <para style="q2" vid="1CH 27:16">Simoona qommo bolla summiday</para>
  <para style="q2" vid="1CH 27:16">Ma7ika naa Shafaaxiya.<verse eid="1CH 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 27:17" />Lewe qommo bolla summiday</para>
  <para style="q2" vid="1CH 27:17">Qamu7eele naa Hashaabiya.</para>
  <para style="q2" vid="1CH 27:17">Aaroone zarkke bolla</para>
  <para style="q2" vid="1CH 27:17">summiday Saadooqe.<verse eid="1CH 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 27:18" />Yuhuda qommo bolla summiday</para>
  <para style="q2" vid="1CH 27:18">Dawite isha Eelihu.</para>
  <para style="q2" vid="1CH 27:18">Yisakoore qommo bolla</para>
  <para style="q2" vid="1CH 27:18">summiday Mika7eele</para>
  <para style="q2" vid="1CH 27:18">naa Omire.<verse eid="1CH 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 27:19" />Zaabiloone qommo bolla</para>
  <para style="q2" vid="1CH 27:19">summiday Abdiyu</para>
  <para style="q2" vid="1CH 27:19">naa Yishima7e.</para>
  <para style="q2" vid="1CH 27:19">Niftaaleme qommo bolla</para>
  <para style="q2" vid="1CH 27:19">summiday Azari7eele</para>
  <para style="q2" vid="1CH 27:19">naa Yarmoote.<verse eid="1CH 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 27:20" />Efreeme qommo bolla</para>
  <para style="q2" vid="1CH 27:20">summiday Azaaziya</para>
  <para style="q2" vid="1CH 27:20">naa Hose7e.</para>
  <para style="q2" vid="1CH 27:20">Yordaanoose shaafappe arshey wulliza baggan diza Minaase qommo baggata bolla summiday Paddaya naa Iyu7eele.<verse eid="1CH 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 27:21" />Yordaanoose shaafappe arshey mokkiza baggan Gala7aaden diza Minaase qommo baggata bolla summiday Zakaraasa naa Iddo.</para>
  <para style="p" vid="1CH 27:21">Biniyaame qommo bolla summiday Abineere naa Ya7isi7eele.<verse eid="1CH 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 27:22" />Daane qommo bolla summiday Yirohaame naa Azari7eele.</para>
  <para style="p" vid="1CH 27:22">Hayti Isra7eele asaa garsan qommota qommota kaaleththiza ola gadawata.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />GODAY, «Tani Isra7eele asaa salo xoolintte mala corasana» giidi hidota qaala immida gishshas Dawiti nam7u tammanne hessafe garsara gidida asaa qoodibeenna.<note caller="-" style="x"><char style="xo" closed="false">27:23 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Medhe 15:5</ref>; <ref loc="GEN 22:17">22:17</ref>; <ref loc="GEN 26:4">26:4</ref></char></note> <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Xuriya naa Iyo7aabey asaa qooda doommides shin polibeenna; asaa qoodida gaason GODAY Isra7eele asaa bolla hanqettides; hessa gishshas istta qooday Kawo Dawite taarike mazgaban xaafettibeenna.<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="2SA 24:1-15">2Same 24:1-15</ref>; <ref loc="1CH 21:1-14">1Taari 21:1-14</ref></char></note><verse eid="1CH 27:24" /></para>
  <para style="s1">Kawo Aqota Bolla Aawateththan Summidayta</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Kawo keeththan buqura woththiza minjja keeththa alaafey Adi7eele naa Azimoote. Gaxaretan, katamatan, mooththataninne naageso miixatan diza minjja keeththata alaafey Ooziya naa Yoonataane. <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />Goshshanchchata alaafey Kaalube naa Eezire. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />Woyne mith tokkizasohota alaafey Eramaate dere as Shim7e; woyne ushshu minjjizasota alaafey Shafaame dere as Zabde.<verse eid="1CH 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28" />Shaara menththotan zumbullata xaphon diza wogara miththinne wola miththata naaganaas alaafeteththi Gadeere dere as Ba7aali-Hanaanes imettides; zayte minjjiza keeththa alaafeteththi Iyo7aasas imettides. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />Lasharoone demban heemettiza wude meheta alaafeteththi Saaroone as Shiixirayas imettides; shoobban heemettiza wude meheta alaafeteththi Adilaya naa Saafaaxes imettides. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Gaamellata bolla alaafeteththi Isma7eele as Obilas imettides. Hareta bolla alaafeteththi Meronoote as Yehidayes imettides. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Dorsa wudetanne deysha wudeta naagana alaafeteththi Aggaari zareppe gidida Yaazizes imettides; hayti ubbay kawo Dawite aqota naaganaas alaafeteth ekkida.<verse eid="1CH 27:31" /></para>
  <para style="s1">Kawo Dawite Zorizayta</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Dawite aawaa ishay Yoonataaney xaafe, akeekanchcha asanne zoriza asa; Hakimoone naa Yihi7eeley kawo nayta dichchizaade. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />Akxofeeley qasse kawoza zorizaade; Arkke dere as Hushey kawos siiqo lagge. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Akxofeeleppe guye Bannaya naa Yoodaheynne Abiyaataarey kawo zoranchcha gidida; Iyo7aabey kawo olanchchata halaqatas gadawa gidides.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Dawiti Xoossa Keeththaa Keexxanaas Kessida Halchcho</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Isra7eele bolla alaafeteththi diza asatinne erettida asati ubbay Yerusalaamen shiiqana mala kawo Dawiti azazides; hessa gishshas ola asaa qommon qommon kaaleththiza halaqati, kawaa olanchchata kaaleththiza ola gadawati, shaalaqati, mato halaqati, kawo aqotanne meheta, iza nayta aqotanne meheta bolla alaafeteththi dizayti, kawo keeththa shuumeti, erettida ola qaratinne gita asati ubbay Yerusalaamen shiiqida.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Histtiin kawo Dawiti dendi eqqidi, «Ta ishanttoo, ta asatoo, siyite! Nu GODAA Taabotay uttizasonne nu Xoossaa tohoy shempizaso Xoossa keeth keexxanaas ta wozinan qoppada halchcho kessadis; keexxanaas koshshiza miishshatakka giigsadis. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Gido attiin Xoossay tana, ‹Neni olanchchanne suuth gussida as gidida gishshas ta sunththaas keeth keexxaka› gides. <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />Tani Isra7eele bolla mernaas kawotana mala GODAA Isra7eele Xoossay ta aawaa keeththa asaa ubbaafe tana doorides; Kaaleththana mala koyro Yuhuda qommo doorides; Yuhuda qommofe ta aawa soo asaa doorides; ta aawa nayta giddofe tana dooridi Isra7eele ubbaa bolla ta kawotana mala izas shene gidides. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />GODAY taas cora nayta immides; ta nayta ubbaafe Godaa Xoossa kawota araatan uttidi Isra7eele bolla kawotana mala ta naa Solomoone doorides.<verse eid="1CH 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 28:6" />«Qasseka GODAY tana, ‹Ta Keeththaa keexxanaynne ta zagoza giigsanay ne naa Solomoone; izi taas naa gidana mala ta iza dooradis; tanikka izas aawa gidana. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Izi ha7i ooththizayssaththo sinththafekka ta azazonne ta wogaa minni naagikko ta iza kawoteththaa mernaas minththana› gides.<note caller="-" style="x"><char style="xo" closed="false">28:2-7 </char><char style="xt" closed="false"><ref loc="2SA 7:1-6">2Same 7:1-6</ref>; <ref loc="1CH 17:1-14">1Taari 17:1-14</ref></char></note><verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />«Hessa gishshas ha7ikka GODAA dere duulatay, Isra7eele asay ubbay be7ishininne nu Xoossay siyishin, intte GODAA azazo ubbaa intte minththidi naagana mala tani inttes yootays; histtiko intte ha lo7o biittaa laattananne intte naytakka mernaas laatissana.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />«Ta naa Solomoone, ne aawaa Xoossaa era! Neni kumeththa wozinaninne lo7o qofan izas ooththa; GODAY wozina ubbaa pilggi xeellees; giddo qofa ubbaa izi erees; neni iza koykko izi nees beettana; gido attiin ne iza aggizaa gidikko izikka nena mernaas aggaagana. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Xoossaa keeth keexxanaas GODAY nena dooridayssa dogoppa; minnada oosoza ooththa» gides.<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Hayssafe guye Dawiti ba naa Solomoones Xoossa Keeththa keexxanaas giigsida halchchoza immides; daaranchcha, buqura woththiza minjja keeththa, pooqezanne giddo kifileta, nagara wursizasoza wostti keexxanaakko bessiza halchchoza immides. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Qasseka Dawiti ba wozinan diza qofaa Xoossa Keeththa zago, iza yuushon diza kifileta, Xoossa Keeththa buqura miishshata woththiza minjja keeththata halchchoza immides.<verse eid="1CH 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 28:13" />Hessaththoka Dawiti qeeseta gisha oosonne Leweta gisha ooso, Xoossa Keeththan ooththiza oosotas go7ettiza miishshata wostti go7ettanaakko bessiza azazo immides.<verse eid="1CH 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 28:14" />Qasseka Dawiti dumma dumma miishshata medhdhanaas ay keena worqqanne ay keena bira koshshizaakko xaafidi Solomoones immides. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />Heytikka worqqa xomppeta woththiza ballanne worqqa xomppeta, bira xomppeta woththiza ballanne bira xomppeta, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />Xoossa sinththan uketh woththiza worqqa xaraphpheezata, bira xaraphpheezata, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />worqqa qapheta, worqqa kereta, worqqa wancata, worqqa xaarota, bira xaarotanne <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />exaane cuwasanaas muuruta worqqa, GODAA Taabotaa bolla bantta qefe miccidi kammiza kirubeta woththiza worqqa gaare bessiza halchcho immides. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />Dawiti, «GODAY ba kushe ta bolla woththidi ha xaafettida halchcho ubbaa tana erisides» gides.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Hayssafe guye Dawiti ba naa Solomoone, «Aykkoy baawa minna! Oosoza doomma! GODAA ta Xoossay nenara diza gishshas yayyofa; hidotakka qanxxofa! Xoossa Keeththa oosoy polettana gakkanaas Xoossay nena yeggennanne aggenna. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Xoossa Keeththa oosos qeesetinne Leweti giigetti uttida; ubba hiillateth eriza asati nena ooso ubbaan maaddana; shuumetinne asay ubbay nees ubba miishshankka azazettana» gides.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Xoossa Keeththaa Keexxanaas Imettida Imota</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Hayssafe guye kawo Dawiti shiiqida as ubbaas, «Xoossay dooriday ta naa Solomoone; izi yelaganne oosos imaththa; ha keexettana keeththay asa keeth gidontta Xoossaa Keeth gidida gishshas oosozi deexo. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Tani taas diza wolqqa keena ta Xoossa Keeththaas worqqan oosettanayssas worqqa, biran oosettanayssas bira, xarqimalan oosettanayssas xarqimala, biratan oosettanayssas biratanne miththan oosettanayssas mith giigsa woththadis; qasse margide, imneberede, dumma dumma medhay diza alleqo shuchchata, al7o shuchchatanne inqquta giigsa woththadis.<note caller="-" style="x"><char style="xo" closed="false">29:1-2 </char><char style="xt" closed="false"><ref loc="1CH 22:5">1Taari 22:5</ref></char></note> <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Ta Xoossa Keeththaa tani keehippe siiqiza gishshas tani ta Xoossaa Keeththazas giigsidayssafe hara taas buzo diza worqqafenne birappe geeshsha keeththas immadis. <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Xoossa Keeththa gimbeza alleqissanaas 100,000 kilo giraame gidiza muuruta worqqanne 240,000 kilo giraame gidiza muuruta bira immadis. <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />Oosaa ooththana hiillatas koshshiza miish, worqqan oosettanayssas worqqa, biran oosettanayssas bira immadis; histtiin hach inttefe bana ba shenen GODAAS aaththi immanay oonee?» gides.<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Histtiin Isra7eele asaas qommota korapinneti, qommotas qommotas ola gadawati, shaalaqati, mato halaqatinne kawo oosanchchata halaqati bantta shenen baas dizayssa immida. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Istti Xoossa Keeththa oosos 170,000 kilo giraame gidiza worqqa, 340,000 kilo giraame gidiza bira, 670,000 kilo giraame xarqimalanne 3,400,000 kilo giraame gidiza birata immida. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Al7o shuchchi diza asay ubbay buqura miishshata naagiza Lewe Gershoone zare gidida Yihi7eele baggara GODAA minjja keeth ehi immida. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Asay ba shenen ba kumeththa wozinappe GODAAS immida gishshas ufayettides; kawo Dawitikka keehi ufayettides.<verse eid="1CH 29:9" /></para>
  <para style="s1">Dawiti Xoossas Shiishshida Galata</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Hessa gishshas Dawiti duulata shiiqida asaa sinththan,</para>
  <para style="q2" vid="1CH 29:10">«Abeet nu aawa GODAA</para>
  <para style="q2" vid="1CH 29:10">Isra7eele Xoossawu!</para>
  <para style="q2" vid="1CH 29:10">Merippe mernaa gakkanaas nees</para>
  <para style="q2" vid="1CH 29:10">galatay gido.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Abeet GODAWU!</para>
  <para style="q2" vid="1CH 29:11">Saloninne sa7an diza</para>
  <para style="q2" vid="1CH 29:11">ubbay neessa;</para>
  <para style="q2" vid="1CH 29:11">gitateththi, wolqqay,</para>
  <para style="q2" vid="1CH 29:11">bonchchoy, teemaynne</para>
  <para style="q2" vid="1CH 29:11">puulateththi neessa.<note caller="-" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="MAT 6:13">Mato 6:13</ref></char></note><verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Dureteththinne bonchchoy</para>
  <para style="q2" vid="1CH 29:12">neeppe beettees;</para>
  <para style="q2" vid="1CH 29:12">ubbayka nees haarettees.</para>
  <para style="q2" vid="1CH 29:12">Wolqqaynne minotay</para>
  <para style="q2" vid="1CH 29:12">ne kushenna;</para>
  <para style="q2" vid="1CH 29:12">neni asaa ubbaa gitasanaassinne</para>
  <para style="q2" vid="1CH 29:12">minththanaas dandayaasa.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Ha7ikka nu Xoossawu!</para>
  <para style="q2" vid="1CH 29:13">Nuni nena galatoos;</para>
  <para style="q2" vid="1CH 29:13">ne bonchcho sunththaaka sabboos» giidi</para>
  <para style="q2" vid="1CH 29:13">GODAA galatides;<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />Dawiti, «Ubbay neeppe beettides; nu nees zaari immiday ne kusheppe ekkidayssa; histtiin nuni hayssa mala imota immanaas taninne ta asay oonee? <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Kase nu aawata mala nunikka ne sinththan betenne imaththata; ha sa7aa bollan nu de7o layththay hidotay baynda kuwa mala elle aadhdhees. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Abeet GODAA nu Xoossawu! Ne geeshsha sunththaas Keeththe keexxanaas shiishshida ubbay neeppe beettidaaza; hayssi ubbay neessa.<verse eid="1CH 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 29:17" />«Ta Xoossawu! Neni wozina pilgga xeellizayssanne suureteth dosizayssa tani erays; tani ta suure wozinaninne lo7o shenen hayssa ubbaa immadis; hayssan diza ne asaykka nees ba lo7o shenen immidi ufayettidayssa tani be7adis. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Abeet GODAWU! Nu aawa Abrahaame, Yisaaqanne Isra7eele Xoossawu! Ne asaa wozinan ha gita siiqoza mernaas naaga; istta wozinay nees ammanetti daana mala naaga. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Ne wogaa, ne azazonne maarata naagana mala tani giigsa woththida miishshatan Xoossa Keeththaa izi keexxana mala ta naa Solomoones kumeththa wozina imma» gi woossides.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Hessafe guye Dawiti duulata shiiqida asaas, «GODAA intte Xoossaa galatite» gides; histtiin ubba asay GODAA bantta aawata Xoossaa galatida; GODAA sinththan gufannidi goynnidanne kawaa bonchchida.<verse eid="1CH 29:20" /></para>
  <para style="s1">Solomoone Kawoteth</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Wonteththa gallas asay GODAAS yarsho shiishshida; xuugettiza yarshoka yarshida; hessika 1,000 kormata, 1,000 dharshota, 1,000 dorsa laaqqata, ushsha yarshonne hara yarshotara issife Isra7eele asaa gishshas shiishshida. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Asay he gallas GODAA sinththan keehippe ufayettishe midessinne uyides; histtidi asay kawo Dawite naa Solomooney kawotidayssa nam7anththo qonccera erida; izi deraa ayssana mala Godaa Xoossa sinththan zayten tiyda; Saadooqekka isttas qeese gidana mala GODAA sinththan tiyda.<verse eid="1CH 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 29:23" />Hessafe guye Solomooney ba aawa Dawite sohon GODAA kawoteththa araatan uttides; izas ubba miishshi eeno gides; Isra7eele ubbayka izas azazettides.<note caller="-" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="1KI 2:12">1Kawo 2:12</ref></char></note> <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Ola gadawati, erettida mino asatinne kawo Dawite nayti kawo Solomoones azazettanaas qaala gelida. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />GODAY Solomoone Isra7eele asaa ubbaa sinththan dhoqqu dhoqqu histtides; izappe kase Isra7eele kawotas imettibeenna; bonchcho Solomoones immides.<verse eid="1CH 29:25" /></para>
  <para style="s1">Dawite Hayqo</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Isseye naa Dawiti Isra7eele ubbaa haarides. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Dawiti Kebroonen 7 layth, Yerusalaamen 33 layth kawotides; issi bolla Isra7eele 40 layth haarides.<note caller="-" style="x"><char style="xo" closed="false">29:27 </char><char style="xt" closed="false"><ref loc="2SA 5:4-5">2Same 5:4-5</ref>; <ref loc="1CH 3:4">1Taari 3:4</ref></char></note> <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Dawiti daro layth de7idi duretidi, bonchchettidi, lo7o cima cimmidi hayqqides; izasohon iza naa Solomooney kawotides. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Dawite kawoteththa layththan koyroppe doommidi wurseth gakkanaas oosetidayssa nabe Sameeli, nabe Naataaneynne nabe Gaadey xaafida taarike Maxaafatan xaafetti uttides. <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />Izi wostti haaridaakko, izi waanida wolqqama asakko, izi ay hanidaakko, Isra7eele asaynne heeran diza kawoteththati ubbay ay hanidaakko he maxaafatan xaafetti dees.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>