<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Gamo Full Bible final version</book>
  <para style="h">Leweta</para>
  <para style="toc1">Leweta Maxaafa</para>
  <para style="toc2">Leweta Maxaafa</para>
  <para style="toc3">Lewe</para>
  <para style="mt1">Leweta Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Leweta Maxaafay beni Isra7eele asaas diza Xoossas goyno woga gishshassinne istta ammano wogata gishshas hessaththoka he wogata ooson polana alaafeteththi isttas diza qeeseta gishshas yootees. He maxaafaas waanna qofay Xoossa geeshshateththa gishshas yootonne hessaththoka Xoossa derey hayssa gishshas Isra7eele GODAARA mata gaytoteththi daana mala istti izas wostti wostti goynnanaakko isttas birshi yootees. Maxaafaza garsan keehi erettida azazotappe issoy, Yesusi Ooraththa Caaqo Maxaafan, «Nam7anththo bayra azazo» gi sunththidayssi shemppo 19:18 bolla dizayssa; hessika, «Neni asa ubbaa ne hu7e mala siiqa» gizayssa.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Muxuwaatanne yarsho woga <char style="ior"><ref loc="LEV 1:1-7:38">1:1—7:38</ref> </char></para>
  <para style="io1">Qeeseteththan Aaroonenne iza nayta shuumeteth <char style="ior"><ref loc="LEV 8:1-10:20">8:1—10:20</ref> </char></para>
  <para style="io1">Geeshshinne tuna miish qasse geesho woga <char style="ior"><ref loc="LEV 11:1-15:33">11:1—15:33</ref> </char></para>
  <para style="io1">Nagara digo gallas <char style="ior"><ref loc="LEV 16:1-34">16:1-34</ref> </char></para>
  <para style="io1">Dummateththinne goyno woga <char style="ior"><ref loc="LEV 17:1-27:34">17:1—27:34</ref> </char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s1">Xuugettiza Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />GODAY Gaytoteththa Dunkaaneza giddon dishe Muse xeygidi hizgi azazides, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />«Isra7eele asay GODAAS yarsho shiishshiza wode istti naagana wogay hayssafe kaallizayssa; issi issi asi miizappe gidiin dorsafe woykko deyshafe gidiin ay qommo yarshoka shiishshiza wode, <verse eid="LEV 1:2" /><verse number="3" style="v" sid="LEV 1:3" />hessika miizappe issaa xuugettiza yarshos shiishshanaas koykko issi boreykka iza bolla baynda mirgo boora dooridi eho; histtiko izi GODAA ufayssiza yarsho gidana mala Gaytoteththa Dunkaaneza pengen shiishsho. <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />Xuugettiza yarsho shiishshizaadey ba shiishshiza booraa hu7e bolla ba kushe woththo; he yarshozikka iza nagaraa wursanaas GODAY ekkiza lo7o yarsho gidana. <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />Hessaadey mirgoza heen GODAA sinththan<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">GODAA sinththan geetettizayssi Gaytoteththa dunkaanen guussa.</char></note> shukko; histtiko Aaroone zereththatappe gidida qeeseti booraza suuththaa GODAAS shiishshetto; Gaytoteththa Dunkaanen geliza penge baggara diza yarsho yarshizasoza bolla lanqera yuuyi aadhdhanaas suuththaa wuxxetto. <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />Hessafe guye he yarshoza shiishshizayssi he shukettida meheza galbaa shooqidi kesso; ashoza qommon qommon qanxxereththo. <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />Qeese Aaroone zereth gidida qeeseti yarsho yarshizasoza bolla mith gophidi tama eeththetto. <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />Qeeseza Aaroone zereth gidida qeeseti he meheza ashoza qommon qommon shaakkidi hu7ezanne handaza gujjidi yarsho shiishshizason korettida miththaa bolla woththetto. <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />He yarshoza shiishshizayssi he meheza qanththa ashozanne guye gedata haaththan meecco; qeesezi yarshoza ubbaa yarshizasoza bolla xuuggo; hayssa mala taman xuugettiza yarsho sawoy GODAA ufayssees.<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />«Izaadey ba dorsafe woykko ba deyshafe issaa xuugettiza yarshos shiishshana koykko issi borey iza bolla baynda dharsho woykko orge gido. <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />Hessaka yarsho shiishshizasozappe pudeha baggara Xoossa sinththan shukko; Aaroone zereth gidida qeeseti suuththaa ekkidi yarsho yarshizasoza bolla yuuyi aadhdhanaas wuxxetto. <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />He yarshaa shiishshizaadey he shukkida ashoza qommon qommon qanxxi kessidaappe guye he oosozas doorettida qeesey he kessida ashoza ubbaa hu7ezanne handazakka issife yarsho yarshizason gophettidi taman eexxiza miththaa bolla woththo; <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />Addezi he mehezas qanththa ashozanne nam7u gedata haaththan meecco; qeesezikka hessa ubbaa GODAAS yarsho ooththi shiishshidi yarsho shiishshizasoza bolla ubbaa xuuggo; hessa mala taman xuugettiza yarsho sawoy Xoossaa ufayssees.<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />«Issaadey GODAAS xuugettiza yarsho kafoppe shiishshana koykko haraphphe ciye woykko waanose geetettiza kafoppe gidanaas dandayees. <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />Qeesezikka he kafoza ekkidi gede yarshozaso shiishshidi kafoza qoodhe mirqqo; yarshoza shiishshida tamaan iza xuuggo; suuththika yarshoy iza bolla shiiqizayssa millera duge xoketto. <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />Baallezanne qanththa ashoza dumma shaakkidi yarsho iza bolla shiishshizasozappe arshey mokkiza baggara bidinththi qolettizason yegetto. <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />Qefeta oykkidi nam7u kessi phalqidi ashoza mulera shaakki yeggontta dishe yarsho shiishshizasoza bolla diza tamaan mulera xuuggo; hessa mala taman xuugettiza yarsho sawoy GODAA ufayssees.<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s1">Kaththa Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />«Ay asikka Xoossas kaththa yarsho shiishshiza wode liiqo dhiille shiishshana bessees; he dhiilleza bolla wogara zaytenne exaane gujjo; <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />Aaroone zereththafe gidida qeesetakko ekki yo; he wode iza ooso taray gakkida qeesey he dhiillezappe ba kuphpha kumeththa zaytezanne exaaneza ekkidi wurikka Xoossas shiiqidayssa erisanaas yarsho shiishshizayssa bolla taman xuuggo; hessa mala kaththa yarsho sawoy Xoossaa ufayssees. <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />Kaththa yarshofe attida dhiilley Aaroone zereththafe gidida qeesetas imetto; hessika Xoossas shiiqida yarshofe shaaketti ekettida gishshas haratappe keehi dummatees.<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />«Yarshozi ukeththi uukettiza bashen uukettidaa gidikkoka irshoy bochchonttaaz gido; izikka wogara miththa zaytera walakettidi liiqo dhiillera uukettida qeeri uketh woykko zayten gindetti uukettida uketh gidanaas bessees.<verse eid="LEV 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5" />«Yarshozi tama coocen kompettidaaz<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="fqa" closed="false">Kompa: </char><char style="ft" closed="false">Kompa geetettizayssi tama coocen woykko bonqo tama garsan kaththiza uketh.</char></note> gidikko irshoy bochchontta wogara miththa zaytey gujettidi liiqo dhiillefe giigettidaaz gido. <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />Ne ukeththaza basereththada iza bolla wogara miththa zayte gussada kaththa yarsho shiishsha.<verse eid="LEV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7" />«Yarshozi qeeri bashen uukettida ukeththa mala gidikko wogara miththa zaytey izan gujetti munuqettida liiqo dhiillefe giigidaaz gido. <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />Kaththa Yarsho Xoossas imettiza yarsho histta qeesezas imma; qeesezikka yarsho yarshizason yarsho. <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />Qeesezi hessa he yarshozappe baggaa ekkidi ubbaa GODAY izi shiishshidayssa yuushshi qoppana mala yarsho yarshizason diza tamaan xuuggo; hayssa mala taman xuugettiza yarsho sawoy GODAA ufayssees. <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />Yarshishin attidayssi qasse qeesetas imetto; hessika GODAAS shiiqida yarshofe shaaketti ekettida gishshas haratappe keehi dummatees.<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />«GODAAS xuugetti yarshettiza kaththa yarshora shiiqiza irsho gidiin woykko ees gidikkoka ne taman xuugganaas bessontta gishshas ne GODAAS shiishshiza kaththa yarshon ubbaan aykko irshoyka izan geloppo. <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />Layththan layththan kath shiishshiza wode koyro maxettida kaththaafe xeera yarsho ooththidi GODAAS ekki yiite; he yarshozi yarsho yarshizasozan taman xuugettofo. <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />Ay qommo kaththa yarshonkka maxiney dhayoppo; hessi neni ne Xoossaara caaqettida caaqo qaalaas malata; hessa gishshas ne shiishshiza kaththa yarsho ubbaa maxinera mal7inththa ooththa. <verse eid="LEV 2:13" /><verse number="14" style="v" sid="LEV 2:14" />Kath shiishshiza koyro aginan kaththa xeera ne shiishshiza wode caacettidi shigechchettida tiya gido. <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />Hayssi kaththa yarsho gidida gishshas iza bolla wogara miththa zaytenne exaane gujja. <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />Qeesezikka he yarshozappe bagga ekkidi izi GODAAS shiiqidaaz gididayssa akeekissana mala zaytezakka, exaanezakka ubbaa kaththara issife xuuggo.<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s1">Issifeteththa Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />«Ay asikka saroteththa gishshas ba meheppe GODAAS issifeteththa yarsho shiishshiza wode iza bolla wosoy baynda mirgo woykko macca miiz dooridi eho. <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />Yarsho ehizaadey yarshos izi shiishshiza meheza bolla ba kushe woththidi Gaytoteththa Dunkaane penge matan shukko; Aaroone zereth gidida qeeseti suuththaa izappe ekkidi yarshoy yarshettizasoza milleza bolla yuuyi aadhdhanaas wuxxetto. <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />Issifeteththa yarshos shiiqiza yarshozappe GODAAS taman xuugettiza yarsho gidi shiiqanayti qanththa ashota goozi oykkida handaa kumeth, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />kilahotanne istta bolla diza handaa hessaththoka tire goozi oykkida handatappe doorettidayta. <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />Qeeseti hessa ubbaa hara xuugettiza yarshora gaththi yarsho yarshizason xuugetto; hessa mala taman xuugettiza yarsho sawoy GODAA ufayssees.<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />«Issifeteththas shiiqiza yarshoy dorsafe woykko deyshafe gidikko adde woykko macca gididi istta bolla wosoy bayndayta gidetto. <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />Issi asi GODAAS shiishshiza yarshoy dorsa laaqqa gidikko, <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />ba kusheza laaqqaa hu7e bolla woththidi Dunkaaneza penge bolla shukko; qeeseti suuththaa izappe ekkidi yarsho yarshizasoza bolla milleza yuuyi aadhdhanaas wuxxetto. <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />Issifeteththa yarshos shiiqiza yarshozappe GODAAS taman xuugettiza yarsho gidi shiiqanayti handazanne zokko meqeththa garsafe qanxxettida goyna ubbaa, qanththa asho goozi oykkida handa ubbaa, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />kilahotanne istta goozi oykkida handa ubbaa qasse tire kammi oykkida lo7o handa ubbaa, <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />qeesezikka hessa ubbaa GODAAS kaththa yarsho histti shiishshidi yarsho yarshizasoza bolla xuuggo.<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />«Issi asi GODAAS yarsho deyshe shiishshizaa gidikko, <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />ba kushe deyshaza hu7e bolla woththidi Dunkaaneza sinththan shukko; qeeseti suuththaa izappe ekkidi yarshoy yarshettizasoza bolla milleza yuuyi aadhdhanaas wuxxetto. <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />He shukettida ashozappe hayssafe kaalliza asho qommota kaththa yarsho ooththidi GODAAS shiishshetto; heytikka qanththa asho kammiza handa ubbaa, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />kilahotanne istta goozi oykkida handaa, qasseka tire kammi oykkida lo7o handazappe ekketto. <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />Qeesezikka hessa taman xuugetti sawiza yarsho ooththidi yarsho yarshizason xuuggo; handay wuri GODAAS shaakettidi dummato. <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />Isra7eele naytappe handa mizaadey woykko mehe suuth uyizaadey dooppo; hessi wuri Isra7eele nayti dizasoninne istti diza wode ubbaan mernaas eqqi diza woga gido.»<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s1">Erontta Ooththida Nagara Gishshas Shiiqiza Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />Xoossi Muse hizgi azazides; <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />«Neni Isra7eele naytas yootanayssi hayssa; oonikka erontta baleteththan nagara ooththiko woykko erontta GODAA azazotappe issaa moorikko hayssafe kaalliza wogaa naago!<verse eid="LEV 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3" />«He wode tiyettida qeesey nagara ooththidi derezi nagara ooththidaa misatissi beettiko iza bolla issi wosoykka baynda issi mirgo boora ehidi ba nagaraa gishshas GODAAS yarsho shiishsho. <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />Kormaza dunkaaneza penge ehidi ba kushe iza hu7e bolla woththidi GODAA sinththan shukko. <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />Hessafe guye qeeseta halaqay he booraza suuththaafe guuththara ekkidi gede dunkaaneza giddo gelo; <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />GODAA Keeththa magalashaas sinththa baggara eqqidi ba biradhdhe suuththaan gelththi gelththi kessidi laappunto gakkanaas wuxxo. <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />Izappe guuththa suuth ekkidi Dunkaaneza giddon exaane yarshizasozan oyddu baggara diza dhemota bolla woththo; hankko attida suuththaa dunkaanezan geliza penge baggara xuugettiza yarshoy yarshettizaso garsan gusso. <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />He mirgoza handaza ubbaa, qanththa asho kammi oykkida handazakka, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />kilahotakka istta goozi oykkida handazanne hessaththoka tire kammi oykkida moodhezappe doorettidayssa ekko. <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />Qeeseta halaqay hessa ubbaa ekkidi xuugettiza yarshoy shiiqiza yarshosoza bolla xuuggo; oosozikka issifeteththas yarshoy shiiqiza meheza handafe ekkidi xuugettiza yarshos shiiqiza mala hano. <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />Gido attiin galbaza, ashoza, hu7ezanne tohota, maracezaranne qanththa asho, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />heeraappe gede kare kesso; gede bidinth kessi qolizaaso, tunonttaso efidi miththi shiishshidi taman xuuggo.<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />«Isra7eele asay erontta bala ooththiko woykko erontta GODAA azazoppe issino mooridaa gidikko he nagaraykka asaappe geemmiko, <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />he oosettida nagaray erettida mala heerakka derezi he nagaraa gishshas yarshos issi mirgo eho; izakka asay Gaytoteththa Dunkaane sinththe shiishsho. <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />Deraa halaqati bantta kushe mirgoza hu7e bolla woththiin heen boorazi GODAA sinththan shuketto. <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />Tiyettida qeesey he mirgoza suuththafe guuththara ekkidi gede Dunkaanezan gelo; <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />GODAA Keeththa magalashaas sinththa baggara gididi ba kushe biradhdheta laappunto suuththan gelththi gelththi kessidi Xoossa sinththan wuxxo. <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />Qasseka guuththa suuth ekkidi Dunkaane giddon diza exaane iza bolla yarshizasozas oyddu baggara diza dhemota bolla woththo; attida suuththaa qasse gede Dunkaanen gelizason xuugettiza yarshoy yarshettizasoza garsan gusso. <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />Hessafe qasse he mirgo moodheza ubbaa ekkidi yarsho yarshizasoza bolla xuuggo. <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />Oosozi wurikka nagara gishshas shiiqiza mirgo yarshizayssaththo ooththetto; tiyettida Qeesezi deraappe nagara diggana; deraasikka atto geetettana. <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />Hessafe guye mirgoza asay dizasoppe gede kare kessidi ba nagaraa gishshas shiishshida mirgoza kase xuuggoyssaththo xuuggo; hessika dereza nagarappe geeshshiza yarsho gidana.<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />«Nagara ooththidaadeynne erontta dishe baleteththan GODAA ba Xoossaa azazotappe issiniyo mooridaadey izi dere kaaleththizaade gidikko, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />ba ooththida nagara izi erida mala heerakka issi borey iza bolla baynda deysha orge ba nagarappe maarettanaas yarsho shiishsho. <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />Ba kushe deyshaa hu7e bolla woththidi yarsho yarshizasozappe pudeha baggara xuugettiza yarshos shiiqiza meheti shukettizason GODAA sinththan shukko. Hessika nagara diggiza yarsho gidana. <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />Qeesezi he shukettida meheza suuththan ba biradhdheta gelththi gelththi kessidi oyddu baggara diza dhemota tiyo; izappe attida suuththa yarshoy yarshettizasoza garsan gusso. <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />Handaza ubbaa yarsho yarshizasoza bolla xuuggo; he oosoy kase issifeteththa yarshos shiishshida meheta handa xuuggoyssaththo ooththetto; hessaththo qeesezi dereza kaaleththizaade nagara wursanaas yarsho shiishsho; izaskka atto geetettana.<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />«Nagara ooththidaadeynne erontta dishe baleteththan GODAA azazotappe issiniyo mooridaadey hankko deraa giddofe gidikko, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />ba ooththida nagara izi erida mala heerakka izi bolla issi boreykka baynda macca deysh ba nagaraa gishshas shiishsho. <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />Ba kushe he deyshay hu7e bolla woththo; yarsho yarshizasoppe pudeha baggara xuugettiza yarshos shiiqiza meheti shukettizason shukko. <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />Qeesezikka he shukettida deyshay suuththan ba biradhdheta gelththi gelththi kessidi oyddu baggara diza dhemota tiyo; izappe attida suuththaa yarshoy yarshettizasoza garsan gusso. <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />Issifeteththas shiiqiza yarshos shiiqiza meheta moodhe bollara shooqi kessizayssaththo hayssa ha meheza moodheka ubbaa bollara shooqi digo; sawozi GODAA ufayssiza yarsho ooththidi yarshizasoza bolla xuuggo; hessaththo qeesezi he addeza nagara izappe digganaas yarsho shiishsho; izaadeska atto geetettana.<note caller="-" style="x"><char style="xo" closed="false">4:31 </char><char style="xt" closed="false"><ref loc="NUM 15:27-28">Tay 15:27-28</ref></char></note><verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />«He addezi ba nagarappe maarettanaas yarshos dors shiishshana koykko izi bolla aykko borey baynda macca dors shiishsho. <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />Izaadeyka dorsay hu7e bolla ba kushe woththo; yarsho yarshizasoppe pudeha baggan xuugettiza yarshos shiiqiza meheti shukettizason shukko. <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />Qeesezi qasse dorsay suuththan ba biradhdhe gelththi gelththi kessidi yarsho yarshizasozas oyddu baggara diza dhemota suuththara tiyo; izappe attida suuththaa yarsho yarshizaso garsan gusso. <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />Hessafe kaallidi issifeteththa yarshos shiiqiza meheta moodhe shooqi ekkizayssa mala ha dorsay moodheka ubbaa shooqi digo; hessaka GODAAS shiiqiza kaththa yarshos shiishshizasoza bolla xuuggo; hessaththo qeesezi he addeza nagara izappe digganaas yarsho shiishsho; izaadeska atto geetettana.<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s1">Qoho Yarshoy Shiiqiza Gaasota</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />«Issaadey ba be7ida miishshe markkattana mala pirda pirdizaso xeygettidi ba be7idayssa woykko ba erizayssa markkattontta ixxiko hessi izas nagara gidana; hessa gishshas izaadey oyshettana.<verse eid="LEV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2" />«Ay asikka erontta dishe wogan digettida do7ata bawuta, meheta bawuta woykko tiran biittara gooshettiza medheteththata bawuta bochchidaadey tunees; hessika izaades nagara gidees.<verse eid="LEV 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3" />«Ay asikka erontta dishin asappe goggi kezidi tunisiza miish bochchiko izaadey hessa erida gallassafe doommidi izas nagara gidees.<verse eid="LEV 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4" />«Ay asikka iitas gidiin kiyas gidiin yuushshi qoppontta coo mela adina adinettiko izaadey ooththida mooroza zaari akeekida wodeppe doommidi izaades nagara gidana.<verse eid="LEV 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5" />«Ay asikka hayta ha miishshatappe issaan qohi beettiko ba nagara qonccisi paaxanaas bessees. <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />Izaadey ba nagaraa gishshas macca dors woykko macca deysh yarshanaas eho; qeeseykka izappe ekkidi izaade nagara wursanaas GODAA sinththan yarsho.<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />«Ay asikka ba ooththida nagara gishshas dors woykko deyshe shiishshanaas dandayonttaaz gidikko nam7u haraphpheta woykko haraphphe ciyeta ehidi issiniyo nagara yarshos nam7anththayokka xuugettiza yarshos Xoossa sinth shiishsho. <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />Ehidi qeesezas immo; qeesezikka qoho yarshos shiiqiza kafoy qoodhe qanxxontta mirqqidi qoho yarshos shiishsho. <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />Suuththaafe guuththara ekkidi yarsho yarshozasoza bolla yuuyi aadhdhanaas wuxxo; attida suuththaa yarsho yarshizaso garsan wuxxo; hessika nagara wurso yarsho gidana. <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />Hankko attida kafoyo diza wogaa mala xuugettiza yarsho histti shiishsho; hessaththo ooththidi qeesezi izaade nagaraa wursanaas yarsho; iita ooththidaades iza nagaray atto geetettana. <verse eid="LEV 5:10" /><verse number="11" style="v" sid="LEV 5:11" />Izaadey nam7u haraphpheta shiishshanaas dandayonttayssa gidikko ba nagaraa gishshas issi kilo liiqo dhiille eho; hessika nagara yarshos gidiza gishshas wogara zaytey woykko exaaney izan gujettofo. <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />Izakka ehidi qeesezas immo; qeesezikka he dhiillezappe ba kushen kuphphati ekkidi GODAAS shiiqiza kaththa yarshora issife gaththi hassa7issanaas yarsho yarshizasoza bolla xuuggo; hessika nagara gishshas shiiqiza yarsho. <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />Ay asikka haytantta mala nagaratappe issaa ooththiko qeesezi hessa mala ooththidi izaadey ooththida nagaraa wursanaas yarsho shiishsho; hessaadeska atto geetettana; hankko attida dhiilley kaththa yarshoy qeesezas attiza mala izas gido.»<verse eid="LEV 5:13" /></para>
  <para style="s1">Qoho Gishshas Shiiqiza Yarsho Shiisho Maara</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />GODAY Muses hizgides, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />«Ay asikka GODAAS immanaas bessizayssa erontta aggidi immontta aggiko izas nagara gidida gishshas issi wosoy iza bolla baynda dharsho qohos gidiza yarsho GODAAS shiishsho; iza waaga heregaykka kase Xoossa Keeththan erettida herega mala gido; hessika qoho gishshas shiiqiza yarsho. <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />GODAAS immanaas bessishin izaadey immontta aggidayssa ciggo; hessafekka bollara hayssa ha heregaas ichchashaappe issi kushe gujjidi qeesezikka izi ehida dharshaara gaaggidi nagara yarsho ooththidi ehidaade nagara wursana; he mooro ooththidayssi atto geetettana.<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />«Ay asikka erontta dishe GODAY ooththofte gida azazotappe issiniyo moorikko izaades nagara; he nagaraa gishshas izaadey oyshettana. <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />Izaadeyka ba moorida mooroza gishshas ba meheta giddofe iza bolla issi wosoy baynda dharsho qeesezakko eho; izi ehidayssa wogay kase qoho yarshos ciggiza waaga kessizaaz gido; qeesezikka hessaththo asi erontta ooththida mooroza geeshsho; izaadeyka maarettana. <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />Hessika qoho gishshas shiiqiza yarsho; izaadeyka GODAA sinththan mooro ooththida gishshas nagaranchcha.»<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />GODAY Muses hizgides, <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />«Oonikka asi izas hadara woykko tal7e immida miish kaddidi ba lagge baleththon nagara ooththidi hessan GODAA mishisikko woykko asa miishshe bonqqi ekkiko woykko baleththiko, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />woykko asappe wodhdhi dhayda miishshe demmi ekkidi ta beyabeekke gi wordora caaqqiko asi ooththiza ha moorota ubbaafe issineyn qohikko, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />ay asikka hayssa mala nagara ooththiko izi kayson ekkidayssa izas hadara imettidayssa woykko dhayiin demmi ekkidayssa zaaro. <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />Wordora caaqqi ekkidayssa ubbaa qoho yarsho shiishshiza wode kase ba ekkoyssa bolla ichchashaappe issi kushe gujjidi zaaro. <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />Ba qohidayssas eda gidana mala iza bolla issi wosoy baynda dharsho GODAAS yarshana mala qeesekko eho; iza wogaykka kase qoho yarshos cigettiza waaga kessizaaz gido. <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />Qeesezikka he addeza nagara diggana mala GODAA sinththan yarsho; izaadeska atto geetettana.»<note caller="-" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="NUM 5:5-8">Tay 5:5-8</ref></char></note><verse eid="LEV 6:7" /></para>
  <para style="s1">Xuugettiza Yarsho</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />GODAY Muse hizgides, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />«Neni Aaroonessinne iza naytas istti naagana mala ne isttas immana azazoy hayssafe kaallizayssa; xuugettiza yarshoy pacey baynda gadey wonttana gakkanaas yarshizasoza bolla ubba wode tamay eexxishe aqo. <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />Qeesezi laynoppe dadettida qamisanne sure may7idi xuugettiza yarshoza tamay midayssafe guye attida bidinththaa heeppe yarsho yarshizasozappe mille baggara qolo. <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />Hessafe guye ba may7ida may7o laammidi bidinththaza tookki ekkidi asi dizasoppe gede kare kessidi maarara lo7oson qolo. <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />Yarshizaso bolla diza tamay to7ontta ubba wode eexxishe do; aydekka to7oppo; qeesezikka wontta wontta taman mith gujjo; iza bolla xuugettiza yarsho ubba wode giigsi woththidi issifeteththa yarshos shiiqiza handa xuuggo. <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />Yarsho yarshizasoza bolla diza tamay ubba wode to7ontta eexxanaas bessees.<verse eid="LEV 6:13" /></para>
  <para style="s1">Kaththa Yarsho</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />«Kaththa yarsho shiisho gishshas woththida wogati hayssafe kaallizayta; Aaroone baggafe gidida qeesezi kaththa yarsho yarshizaso sinththa baggara Xoossas yarsho. <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />Kaaleththidi zaytera diza liiqo dhiille kuphphati ekkidinne kaththa yarsho bolla diza exaaneza ubbaa denththidi GODAAS shiishshidayssa erisana mala yarsho shiishshizaso bolla xuuggo; hessa sawoykka GODAA ufayssiza yarsho gidana. <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />Hessafe attidayssa qeeseti metto; izankka irshoy gelontta dishin uukkidi GODAY woosettiza geeshsha dunkaanaasi sinththa baggara diza dembaa bolla metto. <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />Hessika izan irshoy gelontta uukettanaas bessees; tani GODAY taman xuugettiza kaththa yarshofe hayssa istta gisha histta immadis; hessika nagara gishshassinne qoho gishshas shiishshiza yarsho mala wurikka keehi dummatidaaza. <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />Wode wodenaas Aaroone zereththaafe attuma gidi yelettiday wuri GODAAS shiiqiza yarshofe shaakettidi dumma izas gisha imettidayssi hessi izas gisha gidida gishshas izi ba gisha maanaas dandayees; oonikka hessa he yarshoza bochchidaadey GODAAS dummatidaade gidana bessees.»<verse eid="LEV 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />GODAY Muses hizgides, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />«Aarooney woykko iza zereththati qeeseteththan shuumettiza gallas istti Xoossas shiishshana kaththa yarshoy ubba wode issi kilo gidiza liiqo dhiille kaththa yarsho ooththidi GODAAS shiishshetto; hessafe baggaa maalado, baggaa omars yarshetto. <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />Zayten lo7eththi munuqettidi bashen uuketto. Hessafe guye kaththa yarshoza basereththidi sawozi GODAA ufayssiza sawo gidana mala Xoossas shiiqo. <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />Hayssafe yaana layththatan qeese gididi ooththiza Aaroone zereththi wurikka hayssa ha wogaa polo; hayssi Xoossas shiiqiza yarsho gididi mulera xuugetto. <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />Qeesezi shiishshiza kaththa yarshozi kumeth xuugetto attiin asi izappe mooppo.»<verse eid="LEV 6:23" /></para>
  <para style="s1">Nagara Gishshas Shiiqiza Yarsho</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />GODAY Muse hizgi azazides, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />«Aaroonessinne iza naytas ne hizga yoota, ‹Nagara gishshas yarshettiza yarsho wogay hayssafe kaallizayssa, Xuugettiza yarsho mehey shukettizason nagara gishshas yarshettiza yarsho meheykka heen GODAA sinththan shuketto; hessika keehi dumma yarsho. <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />He yarshozakka shiishshiza qeesezi dummatidason Gaytoteththa Dunkaanezi diza gibbeza giddon diza dembaan ashoza mo. <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />As gidiin hara ay miishshika he ashoza bochchiko dummatana; he meheza suuththi iza bolla pinxida ay may7oyka Xoossas dummatidason meecetto. <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />He ashoy izan doysettida mana miishshi meqqo; ashoy xarqimala biratan doysettiko he xarqimala biratazi qiicettidi haaththan meecetto. <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />Qeeseta zereththafe gidida attuma naa ubbay hessa he yarshozappe mo; hessika keehi dumma yarsho. <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />Gido attiin nagara geeshos oosettiza wogan suuththay Gaytoteththa Dunkaane giddo gelidaa gidikko he meheza ashozi taman xuugetto attiin meetettofo.<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s1">Qoho Gishshas Shiiqiza Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />« ‹Keehi dumma gidida gishshas qoho gaason shiiqiza yarsho wogay hayssafe kaallizayssa, <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />qoho Yarshos shiiqida mehey xuugettiza yarshos shiiqiza meheti shukettizason heen shuketto; suuththaaka yarsho yarshizasoza bolla yuuyi aadhdhanaas wuxetto. <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />Moodhe ubbaa shiishsho; hessika goyna handa, qanththa asho goozi oykkida moodhey, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />kilahota, istta kammi oykkida moodhetanne hessaththoka tire kammi oykkida moodheta issi bolla yarshetto. <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />Yarsho yarshizason diza moodhe ubbaa qeesezi Xoossas taman xuuggi yarsho; hessika qoho gishshas shiiqiza yarsho. <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />Qeeseta zereth gidida attuma asi ubbay he yarshoza asho mo; gido attiin he yarshozi dumma gidida gishshas izas dumma giigettidaason mo.<verse eid="LEV 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7" />« ‹Nagara wursanaas shiiqiza yarshossinne qohos shiiqiza yarsho giddon nam7ataska ooththiza issi wogay dees; hessika he shukettiza meheza ashoy yarshoza shiishshiza qeesezas maana mala izas imettees. <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />Xuugettiza yarshos shiiqiza meheza galbay shooqettidi yarshoza yarshida qeesezas imettees. <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />Tama coocen kompettida kaththa yarshoy wuri woykko doyssiza miishshan doysettidaazinne bashen uukettida kaththa yarsho ubbay yarsho shiishshiza qeesezas imetto. <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />Zayten munuqettidaaz gidikko woykko coo munuqettontta kaththa yarsho ubbay Aaroone zereththatappe gidida qeesetas ubbaas imetto; isttika iza ba garsan issi gina gishetti ekketto.<verse eid="LEV 7:10" /></para>
  <para style="s1">Issifeteththa Gishshas Shiiqiza Yarsho</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />« ‹Asi GODAAS shiishshiza issifeteththa yarsho wogay hayssafe kaallizayssa; <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />issi asi GODAAS galata yarsho shiishshana koykko ba ehiza galata yarshozara irshoy izan gelontta zayten munuqetti uukettida uketh, irshoy izan gelontta lee7en uukettidi zayten tiyettida uketh, liiqo dhiillefe zayten munuqettida uketh yarsho. <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />Galatas shiiqiza issifeteththa yarshozara gaththi imotas gidana mala irshon munuqetti uukettida uketh shiishsho. <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />Uukettida dumma dumma qommo ukeththatappe issi issi uketh GODAAS dumma yarsho histti shiishsho; he issifeteththa yarshos shiiqiza suuththaa ekkidi yarsho shiishshizasoza yuuyi aadhdhanaas wuxxiza qeesezas gisha gido. <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />Galatas shiiqiza issifeteththa yarshozas shiiqiza ashoy he yarshettiza gallas meetetto attiin hara gallassas attofo. <verse eid="LEV 7:15" /><verse number="16" style="v" sid="LEV 7:16" />Issi asi shiishshiza yarshoy adina gaso woykko ba dosan coo immiza issifeteththa yarsho gidikko he yarshozi shiiqida gallas meetetto; izappe attida ubbay wonteththa gallas meetetto. <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />Hessafekka tirpidi heedzdzanththo gallas gakkanaas attida ashoy taman xuugetto; <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />Heedzdzanththo gallas gakkanaas attida ay ashoykka meetettizaa gidikko he yarshoza shiishshidaade yarshozi ekettenna; yarshozi yarshettida mala qoodettenna; he yarshoyka tuna gidi qoodettana; he ashoza midaadey ba nagaran oyshettana.<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />« ‹Tuna gididaazara boshettida ashoy taman xuugetto attiin meetettofo; hankko tunontta attida ashoza woga mala bana geeshshateththan naagidaaddey mo. <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />Gido attiin geesh gidontta ay asikka Xoossas shiiqiza issifeteththa yarsho ashoza miikko GODAA deraa giddofe shaaketti kichcho. <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />Ay asikka geesh gidontta miish woykko medosatanne goggiza tuna miish bochchidi issifeteththas shiiqiza yarsho asho miikko hessaadey GODAA deraa giddofe shaaketti dhayo.› »<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">Medosata gizayssas birsheththay meheta, do7atanne asata guussa.</char></note><verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />GODAY Muses, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />«Neni Isra7eele asaas, ‹Boora woykko miiza moodhe, dorsa moodhe woykko deysha moodhe moopite. <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />Bawuta hayqqida mehe moodhey woykko do7ay wodhida mehe moodhey hara oosos eketto attiin ay asikka iza mooppo. <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />Xuugetti GODAAS yarsho shiiqiza mehe moodhe mizaadey oonikka Xoossa deraa giddofe shaaketti dhayo. <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />Intte awan diikkoka intte dizason kafo suuth woykko mehe suuth uyopite; <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />Suuth uyizaadey oonikka Xoossa dere giddofe shaaketti dhayo› gi yootides» gides.<note caller="-" style="x"><char style="xo" closed="false">7:26-27 </char><char style="xt" closed="false"><ref loc="GEN 9:4">Medhe 9:4</ref>; <ref loc="LEV 17:10-14">Lewe 17:10-14</ref>; <ref loc="LEV 19:26">19:26</ref>; <ref loc="DEU 12:16">Zaare 12:16</ref>; <ref loc="DEU 23:16">23:16</ref>,<ref loc="DEU 23:23">23</ref></char></note><verse eid="LEV 7:27" /></para>
  <para style="s1">Qeeseta Gakkiza Gisha</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />GODAY Muses, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />«Neni Isra7eele asaas, ‹Ay asikka issifeteththa yarsho shiishshizaa gidikko izappe baggaa shaakkidi GODAAS dumma yarsho histti eho. <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />He izi ehoyssaka GODAAS xuugettiza yarsho histti shiishsho; moodhezakka angasozara GODAA sinththan yaanne haa qaaseththi shiishshiza yarsho histti shiishsho. <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />Qeesezi qasse moodheza yarsho yarshizasoza bolla xuuggo; angasozi gidikko qeesetas imetto. <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />Intte issifeteththa yarshozappe ushachcha missaa qeesezas gisha histti immite; <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />issifeteththa yarshoza suuththaanne moodheza shiishshiza qeesezi ushachcha missaa ba gisha histti ekko. <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />Isra7eele asaa issifeteththa yarshofe yaanne haa qaaseththida angasozanne yarshos shiishshida missaa ekkada qeese Aaroonessinne iza attuma naytas immadis; hessika ubba wode Isra7eele asaappe isttas gisha gidana mala immadis› gaada yoota» gides.<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />Hayssika GODAY Aaroonenne iza nayta qeese histti shuumida gallas GODAAS shiiqidi xuugettiza yarshofe qeeseta gisha gidana mala shaakkidaaza. <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />He gallassika istti tiyettida; GODAY hessa he yarshettizayssafe qeesetas immana mala Isra7eele asaa azazides; hessika guyeppe yaana wode ubbaan Isra7eele naytas istta gisha histti immana mala ooththides.<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />Hessa gishshas xuugettiza yarsho gishshassinne kaththa yarsho gishshas, nagarappe maaroteththas shiiqiza yarsho gishshassinne qoho gishshas, eda yarsho gishshas, qeeseteththa gishshas shiiqiza yarshonne issifeteththa yarsho polanaas woththida wogati haytantta. <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />Heytikka bazzon Siina zuma bolla Isra7eele nayti yarsho shiishshana mala azazida wode he gallas GODAY Muses hayta azazota immides.<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s1">Aarooneynne Iza Nayti Qeeseteththa Oosos Sumeth</para>
  <para style="r">(<ref loc="EXO 29:1-37">Kessa 29:1-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />GODAY Muses, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />«Aaroonenne iza attuma nayta, qeeseteththa may7ozakka, tiyettiza zayteza, nagara geeshos shiiqiza korma boora, nam7u dharshonne irshoy gelontta uukettida ukeththi izan diza leemateza isttara ekka ya. <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />Kumeththa Isra7eele nayta xeygada Gaytoteththa Dunkaaneza pengen shiishsha» gides.<verse eid="LEV 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4" />Museykka GODAY izas yootida mala ooththides; dereykka Gaytoteththa Dunkaane pengen shiiqides. <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />Museykka deraas, «Oosettana mala GODAY azazoyssi hayssako!» gides. <verse eid="LEV 8:5" /><verse number="6" style="v" sid="LEV 8:6" />Museykka Aaroonenne iza attuma nayta deraa sinth shiishshidi haaththan meeccides. <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />Aaroone qamisaa mala adussa may7o mayzidi, kabborteka iza bolla gophi mayzidi dancco danccisides; hessa bollaka eefude geetettiza may7o mayzidi izakka dumma hiillateththan oosettida qabatton oyseththidi danccides. <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />Eefude geetettiza may7ozas tira bolla kiisey sikettidi Urimenne Tumime geetettizayta iza giddon woththides. <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />Iza hu7e bollaka goosse xaaxi woththidi he xaaththa goossa bolla sinththa baggara GODAY Muses yootida mala worqqafe oosettida seeloy geeshshateththas malata gidana mala kallachcha iza bolla woththides. <verse eid="LEV 8:9" /><verse number="10" style="v" sid="LEV 8:10" />Hessafe guye Musey tiyettiza zayteza ekkidi Gaytoteththa Dunkaanezanne izan diza ubbaa tiydi GODAA oosos dummasides. <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />Zaytezappe guuththara ekkidi yarsho yarshizasoza bolla laappunto wuxxides; qasseka GODAA oosos dummatana mala yarsho yarshizasozanne iza oosos giigettida miishshata kumeththaa bolla hessaththoka izan meecettiza saanezanne saaneza iza bolla woththizayssa bollaka wuxxides. <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />Tiyettiza zayteza Aaroone hu7en gussidi GODAA oosos iza dummasides. <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />Kaaleththidikka Musey GODAY iza azazida mala Aaroone attuma nayta sinth shiishshidi adussa may7o mayzides; xeessan qabatto danccisidi istta hu7en qoobe woththides.<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />Hessafe guye Musey nagara gishshas yarshanaas korma boora ehides; Aarooneynne iza nayti korma booraza bolla ba kushe woththida. <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />Museykka booraza shukkides; booraa suuththan ba biradhdhe gelththidi yarsho yarshizasozas oyddu baggan diza dhemota tiydi geeshshides; hessafe attida suuththaa yarsho yarshizasoza garsan gussides; hessa malan yarsho yarshizasoza GODAAS shaakki dummasides. <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />Musey shukettida meheza qanththa ashoza bolla diza moodheza ubbaa, tire kammi oykkida moodheza, kilahotanne istta kammi oykkida moodheza ubbaa ekkidi yarsho yarshizasoza bolla xuuggides. <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />Kormaza ashoppe attidayssanne maraceza ekkidi GODAY iza azazida mala asay dizasoppe gede haassidi xuuggides.<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />Hessafe guye Musey xuugettiza yarshos shiiqiza dorsa dharsho ehiin Aarooneynne iza nayti dharshoza hu7e bolla ba kushe woththida. <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />Museykka dharshaa shukkides; suuththaaka yarsho yarshizasoza bolla yuuyi aadhdhanaas wuxxides. <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />Dharshoza ashaa qommon qommon qanxxidi kessides; hu7eza, qommon qommon qanxxettida ashotanne moodheza xuuggides. <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />GODAY iza azazida mala Musey qanththa ashotanne tohota haaththan meeccides; he dharshoza asho ubbaa GODAAS taman xuugetti sawiza yarsho ooththidi yarsho yarshizasoza bolla xuuggides.<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />Hessafe kaallidi Musey qeeseteththa sunththas nam7anththo dharshoza ehides; Aarooneynne iza attuma nayti ba kushe dharshaa hu7e bolla woththida. <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />Musey dharshaa shukkides; suuththaafe guuththara ekkidi Aaroones ushachcha hayththa xeera, ushachcha manththa biradhdhenne ushachcha toho manththa biradhdhe<note caller="+" style="f"><char style="fr" closed="false">8:23 </char><char style="fqa" closed="false">Manththa biradhdhe: </char><char style="ft" closed="false">Manththa biradhdhe gizayssa issi issi bagga gamoththo qaalan adde biradhdhe geetettees.</char></note> tiydes. <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />Qasseka Aaroone nayta deraa sinth shiishshidi istta ushachcha hayththata xeeranne ushachcha kushe manththa biradhdhetanne ushachcha tohota manththa biradhdheta tiydes; hessafe tirpida suuththaa yarsho yarshizasoza bolla yuuyi aadhdhanaas wuxxides. <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />Handa, goyna, qanththa asho kammi oykkida moodhe ubbaa, tire kammi oykkida moodhe, kilahotakka, kilahota bolla diza moodhezanne ushachcha misseza ekkides. <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />Irshoy bochchontta GODAAS dumma ukeththi izan diza leematezappe issi daabbo ekkides; hessaththoka zayten munuqetti uukettida daabboy izan diza leematezappe issi daabbonne lee7e uketh ekkidi moodheza bollanne ushachcha missaa bolla woththides. <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />He kaththaa ubbaa ekkidi Aaroone kusheninne iza nayta kushen oyththides; isttika oykkidi yaanne haa qaaseththidi GODAAS yarsho shiishshida. <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />Hessafe qasse Musey istta kusheppe ekkidi qeeseteththa yarsho gidana mala shiiqidi xuugettiza yarshofe bollara woththidi yarsho yarshizasoza bolla woththidi xuuggides; hessika iza sawoy GODAA ufayssiza kaththa yarsho. <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />Musey qasseka angasoza ekkidi yaanne haa qaaseththidi GODAAS shiishshides; Musey ubbaaka GODAY iza azazida mala qeeseteththa sunth summanaas shiishshiza dharshofe Muse gishay hessa.<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />Musey tiyettiza zayteppenne yarsho yarshizasozan diza suuththaafe guuththara ekkidi Aaroone bolla, Aaroone nayta bollanne qasseka istta may7o bolla wuxxides; hessa malan Musey isttanne istta may7o ubbaa GODAAS dummasides.<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />Musey Aaroonenne iza attuma naytas, «Ashoza Gaytoteththa Dunkaane pengen doyssite; Aarooneynne iza nayti maana mala GODAY azazidayssa qeeseteththa sunth summiza wode yarsho izara shiishshiza leematen diza ukeththaara heen miite. <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />Ashozappe woykko ukeththazappe tirpiko taman xuuggite. <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />Intte qeeseteththa sunth summiza wogay polettanaas laappun gallas ekkiza gishshas he laappun gallassay wurana gakkanaas Gaytoteththa Dunkaaneza pengefe kichchofte. <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />Inttena nagarappe geeshshanaas hayssa hach nu ooththida wogaa polana mala Xoossay nuna azazides. <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />Hessa gishshas GODAY azazidayssa polanaas laappun gallas kumeth gallassinne omars Gaytoteththa Dunkaaneza pengefe kichchofte; GODAA wogaakka naagite; histtontta aggiko intte hayqqana; tana GODAY azazida wogay hayssa» gides. <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />Aarooneynne iza nayti Muse baggara GODAY azazidayssa ubbaa polida.<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s1">Aarooney Godaas Shiishshida Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />Osppunththa gallassan Musey Aaroone, iza attuma naytanne Isra7eele asaa kaaleththiza cimata xeygides; <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />Aaroonekka, «Issi wosoykka istta bolla baynda issi mirgonne issi dharsho ekkada mirgoza nagara gishshas yarshiza yarsho dharshoza xuugettiza yarsho histta GODAAS yarsha. <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />Hessafe guye Isra7eele nayta nagara gishshas shiiqiza yarshos deysha orgenne istta bolla aykko wosoy baynda issi layththa mararanne issi layththa dorsa laaqqa xuugettiza yarshos ehana mala yoota. <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />Qasseka issi kormanne issi dorsa laaqqa issifeteththa yarshos ehetto; heytantta zayten gindettida kaththa yarshora GODAAS yarsho shiishshetto; hessa ubbaa ooththetto; gaasoykka Xoossi isttas hach qonccana» gides. <verse eid="LEV 9:4" /><verse number="5" style="v" sid="LEV 9:5" />Isttika Musey istta azazidayssa ubbaa Dunkaaneza penge ehida; asay wurikka GODAA sinththan shiiqi eqqides. <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />Musey isttas, «GODAA bonchchoy inttes qonccana mala intte ooththanaas GODAY inttena azazida azazoy hayssa» gides. <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />Qasseka Musey Aaroones, «Gede yarshoy yarshettizaso shiiqada ne nagaranne dereza nagara wursanaas shiiqiza yarshonne xuugettiza yarsho yarsha; hessa ubbaa GODAY dereza nagara wursana mala izi nena azazida mala shiishsha» gides.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="HEB 7:27">Ib 7:27</ref></char></note><verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />Aarooneykka yarsho yarshizaso biidi koyro ba nagaraa gishshas shiiqiza yarshos shiiqiza mirgoza shukkides. <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />Iza nayti suuththaa izas ehida; izikka suuththaan ba biradhdhe gelththi kessidi yarsho yarshizasoza bolla diza dhemota suuth tiydes; attida suuththaa yarsho yarshizaso garsan gussides. <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />Hessafe kaaleththidi moodheza, kilahotanne tire kammi oykkida moodheta ekkidi GODAY Muse azazida mala yarsho yarshizasoza bolla xuuggides. <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />Ashozanne galbaza qasse asay dizasoppe gede haraso haassidi xuuggides.<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />Hessafe guye Aarooney xuugettiza yarshos shukkides; histtiin iza nayti suuththaa izas ehida; izikka suuththaza ekkidi yarsho yarshizasoza bolla yuuyi aadhdhanaas wuxxides. <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />Iza nayti xuugettiza yarshos shukettida ashoza qommon qommon hu7ezara gaththi izas ehi immida; izikka hessa ubbaa yarsho yarshizasoza bolla xuuggides. <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />Hessafe qasseka qanththa ashozanne guye tohota haaththan meeccidi yarsho yarshizasoza bolla xuugettiza yarshozara issife gaththi xuugettizason xuuggides. <verse eid="LEV 9:14" /><verse number="15" style="v" sid="LEV 9:15" />Hessafe kaaleththidi Aarooney dereza nagaraa gishshas shukettiza deysha orge ekki shukkidi ba nagara gishshas yarshidayssaththo yarshides. <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />Xuugettiza yarshoza ehidi kase diza wogaa mala yarshides. <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />Kaththa yarshozakka shiishshides; dhiillezappe kuphpha kumeth ekkidi yarsho yarshizasoza bolla xuuggides; hessika xuugettiza yarshos maalado maalado shiiqiza yarshoza bolla gujettidi shiiqides.<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />Korma booraanne dharshoza shukkidi dereza gishshas issifeteththa yarsho shiishshides; iza naytikka suuththaa izas ehida; izikka suuththaa ekkidi yarsho yarshizasoza yuuyi aadhdhanaas wuxxides.<note caller="-" style="x"><char style="xo" closed="false">9:18 </char><char style="xt" closed="false"><ref loc="LEV 3:1-11">Lewe 3:1-11</ref></char></note> <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />Aarooneykka korma booraa moodheza, dharshaa moodheza, ubbaaka goyna tolthoza, qanththa asho kammi oykkida moodhezanne tire kammi oykkida moodheza doorettidayssa tiretanne istta bolla diza moodheza ekkidi, <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />he meheta angaso xeera bolla woththida; Aarooney moodheza ubbaaka yarsho yarshizasoza bolla xuuggides. <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />Angasotanne ushachcha geda ashota Musey azazida mala yaanne haa qaaseththidi GODAAS dumma yarsho histti shiishshides.<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />Aarooney nagara gishshas shiiqiza yarsho, xuugettiza yarshonne issifeteththa gishshas shiiqiza yarsho yarshidaappe guye ba kushe dhoqqu histtidi deraa anjjidi wodhdhides.<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="NUM 6:22-26">Tay 6:22-26</ref></char></note> <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />Museynne Aarooney Gaytoteththa Dunkaane giddo gelida; heeppe kezishe dereza anjjida; GODAA bonchchoy asa ubbaas qonccides. <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />Asay qoppontta dishin GODAA achchafe kiitettida tamay yiidi yarsho yarshizasoza bolla diza yarshos shiiqida handaza ubbaa mides; derezikka wuri hessa be7idi ilili gidessinne wurikka hokki goynnides.<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s1">Nadaabeynne Abyoy Ooththida Mooro</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />Nadaabeynne Abihu geetettiza Aaroone naa nam7ati issoy issoy baas baas exaane cuwasiza xinna ekkidi bonqo tama izan gujjida; qasseka exaanekka izan gujjidi GODAAS shiishshida; he istti ekkida tamay GODAAS dummatida tama gidontta gishshas istti hessa mala tama shiishshana mala GODAY istta azazibeenna.<figure style="fig" alt="Incense brining cencer" file="HK00268B.TIF" size="span" ref="10:1">Exaane izan cu7asiza xinna</figure> <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />Istti qoppontta Xoossa achchafe yida tamay istta mida gishshas istti GODAA sinththan hayqqida. <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />Musey qasse Aaroones, «GODAY, ‹Ta sinththe shiiqidi taas ooththizaytas tani ta geeshshateththaa qonccisana; tanikka ta dereza achchan bonchchettidaade gidana› giidi izi asaa kase qofsidayssi hayssa» gides. Aarooneykka ay zaarokka immontta co7u gides.<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />Museykka Aaroones aawaa isha Uzi7eele nayta Misha7eelenne Elxafaane xeygidi, «Haa yiite! Hayssa intte ishata ahaa geeshsha Dunkaaneppe denththidi asi dizasoppe gede haraso efte» gides. <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />Isttika qeeseteththa may7oza hayqqidayta aha bollafe kessontta dishe biidi Musey azazida mala asata ahaa asay dizasoppe gede haraso efida. <verse eid="LEV 10:5" /><verse number="6" style="v" sid="LEV 10:6" />Hessafe kaallidi Musey Aaroones, iza naa El7ezeeressinne Itamaares, «Intte hayqqontta malanne GODAA hanqoy deraa bolla yontta mala hayqqidaytas mishettidi intte hu7e buucofte; intte may7oka daakkofte; gido attiin hankko Isra7eele nayti GODAA achchafe yida taman hayqqidaytas yeekkana dandayeettes. <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />Intte GODAY azaziin tiyettiza tiyo zayten tiyettida gishshas intte hayqqontta mala Gaytoteththa Dunkaane pengefe kare kezopite» gides. Isttika Musey azazida mala hanida.<verse eid="LEV 10:7" /></para>
  <para style="s1">Qeesetas Wodhdhida Woga</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />GODAY Aaroones hizgides, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />«Neninne ne nayti woyneppe oosettida ushshu woykko hara maththosiza ushshu uyidi Gaytoteththa Dunkaanezan intte gelontta mala naagettite; histtontta aggiko intte hayqqana; hayssi ha wogazi inttefekka guyen yaana yeleta ubbaa matankka mernaas naagettanaas bessees. <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />Intte dummatidaytanne dummatonttayta, geeshshinne tuna gididayta giddon diza dummateththaa shaakki eranaas bessees. <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />Ta inttes Muse baggara immida woga ubbaa Isra7eele nayta tamaarsite.»<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />Museykka Aaroonenne attida iza naa nam7ata El7ezeerenne Itamaares, «GODAAS taman xuugetti shiiqida kaththaafe ekkidi irshoy bochchontta uketh uukkite; izikka keehi dummatida yarsho gidida gishshas yarsho yarshizasoza achchan miite. <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />GODAAS taman xuugetti shiiqiza kaththa yarshofe shaakettidi inttessinne intte naytas imettida gisha gidida gishshas intte iza GODAAS dummatidason miite; intte hessaththo histtana mala Xoossi tana azazides.<note caller="-" style="x"><char style="xo" closed="false">10:12-13 </char><char style="xt" closed="false"><ref loc="LEV 6:14-18">Lewe 6:14-18</ref></char></note> <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />Gido attiin yaanne haa qaaseththon dumma yarsho gididi GODAAS shiiqidaappe guye qeeseta gisha gidana mala geetettida gishshas angasozanne misseza neninne ne keeththan diza ne macca nayti maandeta; hessa he wogaakka GODAAS dummatidason maandeta; hessika Isra7eele asay issifeteththaa gishshas shiishshiza yarsho ubbaafe shaaketti neessinne ne naytas imettides. <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />Shiiqida missezanne angasoza GODAA sinththan yaanne haa qaaseththi shiishshiza yarshoza mala qaaseththanaas ehetto; hessika GODAY azazida mala mernaas neessinne ne naytas gisha gido» gides.<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />Musey nagara gishshas shiiqida yarshos shiiqida deyshaa oychchi siyidi izi xuugettidayssa erides; hessa gishshas Musey El7ezeere bollanne Itamaare bolla hanqettidi, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />«Intte nagaraa gishshas shiiqida yarshoza Xoossas dummatidason aazas mibeekketii? Yarshozi GODAAS keehi dumma; izi derezappe nagaranne qoho wursana mala GODAY hessa inttes immidaaza. <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />Suuththazi gede GODAAS dummatida dunkaanezan gelontta gishshassinne ta inttena azazida mala intte he dummatidason shiiqida yarshoza intte maanaas bessees» gides. <verse eid="LEV 10:18" /><verse number="19" style="v" sid="LEV 10:19" />Aarooneykka Muses, «Nagara gishshas shiiqiza xuugettiza yarsho hekko hach asay Xoossa sinth ekki yides; tanakka hayssa mala metoy gakkides; histtiin hach nagara gishshas shiiqiza yarshoza ta midaakko GODAY ufayettanashin attidee?» gides; <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />Museykka hessa siyidi izi zaarida qaalan ufayettides.<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s1">Meetettizanne Meetettontta Mehetanne Do7ata</para>
  <para style="r">(<ref loc="DEU 14:3-21">Zaare 14:3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />GODAY Musessinne Aaroones hizgides, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />«Hayssa Isra7eele naytas yootite, ‹Biitta bolla diza do7atappenne mehetappe intte maanayti hayssafe kaalli dizayta, <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />Toho qinccifilley phalqeththatanne banchikizayta miite.<verse eid="LEV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 11:4" />« ‹Gido attiin banchikizayta gidi uttidi qinccifilley phalqettonttayta woykko banchikonttayta gidi uttidi qinccifilley phalqettidayta moopite; gaamellay banchikees shin qinccifilley phalqettontta gishshas izi inttes tuna gido. <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />Guppaley banchikees shin qinccifilley phalqettontta gishshas izi inttes tuna gido. <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />Harbaynoy<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="fqa" closed="false">Harbayno: </char><char style="ft" closed="false">Harbaynoy issi issi bagga gamoththo qaalan eche geetettees.</char></note> banchikeessishin qinccifilley phalqettontta gishshas izi inttes tuna gido. <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />Guddunththika moopite; iza qinccifilley phalqeth gidikkoka izi banchikontta gishshas inttes tuna gidi qoodetto. <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />Heytantti tuna gidida gishshas istta asho moopite; haray attoshin istta ahakka bochchofte.<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />« ‹Abba giddoninne shaafa haaththata giddon diza medheteththata abba giddofe qefeynne poqo mala galbay diza ubbaa miite. <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />Abba giddoninne shaafa haaththa giddon diza medheteththatappenne shemppora paxa diza hara medheteththata ubbaa giddofe qefeynne poqettiza galbay baynda ubbay inttes tuna gidida gishshas moopite. <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />Heytantti tuna gidida gishshas istta asho moopite; haray attoshin istta ahakka bochchofte. <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />Hessa gishshas haaththa giddon diza qefeynne poqettiza galbay istta bolla baynda medheteththati wurikka intte achchan ixettidayta gidetto.<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />« ‹Kafotappe hayssafe kaallizayti tuna gidida gishshas moopite. Heytanttika golle, qoollo, wole<note caller="+" style="f"><char style="fr" closed="false">11:13 </char><char style="fqa" closed="false">Wole: </char><char style="ft" closed="false">Woley issi issi bagga gamoththo qaalan wodda woykko wuukko geetettees.</char></note> <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />Xilo, dumma dumma qommo phircota. <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />Dumma dumma quurota <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />Yanchcha, cancce gutto, haaththa kafo, gace zare ubbaa, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />Gutto, biya, yindare<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="fqa" closed="false">Yindare: </char><char style="ft" closed="false">Yindarey issi issi bagga gamoththo qaalan hazo woykko oy7are woykko hoqqa geetettees.</char></note> <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />woyno, haaththa kafo, ankko, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />zigile, saabissa geetettiza haaththa kafo zare ubbaa, jinjilaate geetettiza kafonne wurkawurkko.<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />« ‹Qefey dishin oyddu tohora qaaxxiza medheteththati wurikka tunata; <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />Heytantta giddofe guppanaas maaddiza geday diza medheteththata miite; <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />Heytikka boole zareta, xingota zaretanne gumbaro zare ubbaa. <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />Hinko qefey dishin oyddu tohora hemettiza medheteththata intte tuna mala qoodite.<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />« ‹Hayssafe kaalli dizayta bochchidaadey wuri omars gakkanaas tuna gidana.<verse eid="LEV 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 11:25" />« ‹Heytantta aha denththidaadey wurikka ba may7o haaththan meecco; meeccikokka omars gakkanaas izaadey tuna gido.<verse eid="LEV 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 11:26" />« ‹Qinccifilley isttas dishin phalqettonttaytinne banchikontta mehey wurikka inttes tuna gidana; heytantta bochchidaadey wurikka tunees. <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />Oyddu tohora dizaytappe qinccifilley baynda kanten hemettizayti wurikka intte achchan tunata gidetto; istta ahaa bochchidaadey omars gakkanaas tuna gido; <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />Heytantta aha denththidaadey wurikka ba may7o haaththan meecco; meeccikokka omars gakkanaas izaadey tuna gido; isttika intte achchan tuna.<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29-30" style="v" sid="LEV 11:29-30" />« ‹Biittara gooshettizayta giddofe hayssafe kaallizayti inttes tuna gidetto; giroy, ecerey, zarey, korchchey, haylashoy, geeggey, wakkalaynne,<note caller="+" style="f"><char style="fr" closed="false">11:29-30 </char><char style="fqa" closed="false">Wakkala: </char><char style="ft" closed="false">Wakkalay issi issi bagga gamoththo qaalan yaro geetettees.</char></note> shaaqanchchay inttes tuna gidetto. <verse eid="LEV 11:29-30" /><verse number="31" style="v" sid="LEV 11:31" />Biittara gooshettiza ubbatappe tuna gididayti haytantta; istta gidiin woykko istta aha bochchizaadey wuri omars gakkanaas tuna gido. <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />Istta ahay iza bolla wodhdhida miishshi wurikka tunees; hessika miththafe oosettida miishshati, may7oti, galba, karaxiite, ogoronne heytantta misatiza haratakka gujjees; istta aha bochchida miishshi wurikka haaththan gelidi gam7o; omars gakkanaas tuna gididi hessafe guye geesh gido. <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />Heytantta ahay mana miishshaa giddon gelikko he miishshaa giddon diza miishshi wurikka tuniza gishshas he mana miishshaza wodhite. <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />He mana miishshaafe haaththi iza bolla xokettida kaththi wurikka tuna gidees; izan diza uyettiza miishshika tuna gidees. <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />Ay ahaykka bochchida miishshi wurikka tuna gidida gishshas iza ixxite; mani medhdhida cooce gidiin otoy meqqo. <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />Heytantta ahay hara ubbaa tunisizaaz gidikkoka pultto haaththenne haaththi diza olla tunisenna. <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />Zereththas uttida kaththa bolla wodhdhiko zereththay tunenna. <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />Gidikkoka zereththa bolla haaththi gukki simmiin ahay bochchiko he zereththay hessafe guye tuna gidees.<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />« ‹Meetettiza mehe garsafe awaysikka hayqqiin he hayqeththaa bochchidaadey omars gakkanaas tuna. <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />Ay asikka he hayqeththaafe miikko ba may7o meecco; omars gakkanaas tuna gido; ay asikka he hayqeththa ahaa tookkiko ba may7o meecco; gidikkoka omars gakkanaas izaadey tuna gido.<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />« ‹Biittara gooshettiza ay medheteththati wurikka intte achchan meetettonttaazinne ixettidaaz gidetto. <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />Tiran gooshettiza, oyddu tohora bizayta, woykko daro tohoy dizayta ubbaaka moopite; istti intte matankka ixettidayta gidetto. <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />Heytanttafe awayssaka miidi inttena tunisopite. <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />Tani GODAA intte Xoossaa; tani harappe dumma gidida gishshas intteka dumma gidite; ba tiran gooshettizayta miidi intterkka inttena tunisopite.<note caller="-" style="x"><char style="xo" closed="false">11:44 </char><char style="xt" closed="false"><ref loc="LEV 19:2">Lewe 19:2</ref>; <ref loc="1PE 1:16">1Phex 1:16</ref></char></note> <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />Inttes GODAA gidanaas Gibxeppe inttena kaaleththa kessiday intte Xoossay tana; hessa gishshas tani dumma gidida mala intteka dumma gidite.<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />« ‹Meheta, do7ata, kafota, haaththa giddoninne biitta bolla tiran gooshettiza medheteththata ubbaa gishshas imettida wogay hayssa; <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />Wodhdhida wogaa mala geeshshatanne geesh gidonttayta giddon diza dummateth shaakki eranaas hessika meetettizaytanne meetettonttayta giddon diza dummateththaa shaakki eranaas intte lo7eththi naagettite.› »<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s1">Maccassay Yelidaappe Guye Geesho Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />GODAY Muses hizgides, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />«Isra7eele asaas, ‹Maccassi shaarada attuma naa yelikko kase maccassa wogay izi bolla beettida wode hanizayssaththo laappun gallas gakkanaas iza tuna gidawus. <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />Yelettida naazi osppunththa gallas qaxxarettanaas bessees.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 17:12">Medhe 17:12</ref>; <ref loc="LUK 2:21">Luqa 2:21</ref></char></note> <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />Hessafe guye gacino suuththay izippe eqqana gakkanaassinne iza yeloosofe 33 gallas gakkanaas Xoossas dummatida ay miishshika bochchanaas bessenna; hessika iza geeyza wodey wurontta dishin Gaytoteththa Dunkaane giddo geluppu.<verse eid="LEV 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5" />« ‹Hessaththoka issi maccassi macca naa yelikko kase bolla qitay izi bolla beettida wode hanizayssatho 14 gallas gakkanaas tuna gidawus; hessafe guye suuththay izippe simmiin iza yeloosofe 66 gallas gakkanaas gam7u.<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />« ‹Iza geeyza gallassati wuriza wode attuma naa gishshas gidiin woykko macca naa gishshas xuugettiza yarshos issi layththa laaqqanne nagarappe geeyanaas shiiqiza yarshos haraphphe woykko haraphphe ciye Gaytoteththa Dunkaane penge ehada heen ooththiza qeeses immu. <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />Qeesezikka iza immizayssa izippe ekkidi GODAAS yarsho shiishsho; maccassayakka iza yelishin izippe gukkida suuththaafe geeyawus; hayssi attuma naa woykko macca naa yeliza maccassas wodhdhida woga.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="LUK 2:24">Luqa 2:24</ref></char></note> <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />Yelida maccassaya dorsa laaqqa ehanaas dandayonttaaro gidikko nam7u haraphpheta woykko nam7u waanoseta ehu; nam7atappe issoy xuugettiza yarshos, hankkoyssi nagara geeshos yarsho shiiqo; qeesezikka izo nagarappe geeshsho; hessafe guye iza geesh gidana› gees.»<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s1">Asas Galba Bolla Keziza Harge Gishshas Imettida Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />GODAY Musessinne Aaroones hizgides, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />«Ay asikka izaade bolla kixay woykko shimpey woykko illiway izaade bolla beettidi qaachcha harge mala kaseppe gede dari dari biikko izaade gede qeese Aaroonekko woykko qeese gidida iza naytappe issaakko efetto. <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />Qeesezikka he madunththaa lo7eththi xeello; he madunththaa heeran diza iskey booxxizaaz gidikkonne madunththazi duge ollati beettiko hessi daro iita hara asa bolla aadhdhiza galba harge; qeesezi kase wogaa mala izaadey tuna gididayssa asaas eriso. <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />Gido attiin madunththazi booxxidi duge ollatontta aggikonne iza heeran diza iskezikka booxxontta aggiko qeesezi hessaade laappun gallas gakkanaas soon kare ba bolla gordi barkka gam7ana mala ooththo. <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />Laappunththo gallas qeesezi iza qasseka paacci xeello; izi iza paaccishin madunththay kaseppe aykkoka dummateth bessontta aggiko ha7ikka hara laappun gallas izi ba keeththan kare ba bolla gordi uttana mala ooththo. <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />Laappun gallassafe guye qeesezi iza qasseka paacci xeello; izi paacci xeellishin madunththay gede dich aggidi kaseppe guuxxi beettiko he madunththay deexo gidonttayssa izas yootidi wogaan dizayssa mala izi geesh gididayssa iza eriso; izaadeyka wogay giza mala geeyanaas ba may7oza haaththan meecco. <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />Hessika qeesezi izi geesh gididayssa paaccidi izaades erisidaappe guye qasseka madunththay kaseppe aakki aakki biikko hessaadey qasseka qeesezakko shiiqo. <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />Qeesezi qasseka paacco; madunththay kaseppe aakkiko iita galba harge gidida gishshas wogan diza mala izaadey iita galba harganchcha gididayssa eriso.<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />«Oonikka izaade ashoza galba bolla keziza hargey oykkiko hessaade qeesekko ehetto. <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />Qeesezikka he izaade bollay uzazizaakko lo7eththi xeellidi izaade asateththa bolla diza isketa booththiza kixa gidikko kixazi uzazidinne he uzassay dizason dizaa gidikko, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />hessi iita bolla galba harge gidiza gishshas qeesey he harganchchazi tuna gididayssa izas yooto; izi tunidayssi erettida gishshas hessa mala asi karey gordettiin keeththan gam7anaas bessenna. <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />He galba hargezi izaade bolla toho xugunththafe biidi hu7e iske gakkanaas ubbaa gakkiko, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />qeesezi qasseka paacci xeellidi hargezi izaades kumeththa asateththaa gakki may7idaa gidikko qeesezi hessaade woga mala geesh gididayssa eriso; gaasoykka iza bollay kumeth laamettidi booth gidida gishshas izaadey geeshsha. <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />Gido attiin madunththay zaari uzazidi zo7o asho giddofe bessiko hessaadey tuna gidees. <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />Qeesey qasseka zaari paacci xeellishin madunththay uzazishin zo7o asho beykko izaadey tuna; izi tuna gididayssa izas eriso; gaasoykka hargezi hara asa bolla aadhdhiza harge gidida gishshas hessaadey tuna. <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />Madunththay paxidi boottizaaz gidikko hessaadey qasseka qeesekko bo. <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />Qeeseykka paacci xeellidi madunththay booxxi bessiko qeeseykka hessaadey geesh gididayssa izas yooto; izaadeyka geesh gidana.<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />«Issaadey kase kixay iza bolla kezidi paxikko, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />qasse gam7ishe kase madunththay dizason booththa kixay woykko zo7o illiway keziko izaadey qeesekko bo. <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />Qeesezi lo7eththi xeellidi madunththay duge asho giddo geli beettiko iza heeran diza iskey booxxi bessiko hessaadey tuna gididayssa iza eriso; gaasoykka hessi kixa oykkidayssi ba baggara iita galba harge. <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />Gidikkoka qeesezi paacci xeelliin galba bolla diza iskey boottontta aggikonne hankko asateththaa galbaafe ollati bessonttaaz gidikko qalame dummateththa gishshas qeesey hessaadey laappun gallas gakkanaas karey gordettiin keeththan gam7ana mala ooththo. <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />Madunththay dizasoy kaseppe aakki aakki biikko hessaadey asa bolla aadhdhiza iita hargen oykettida gishshas izi tuna gididayssa izas qeesezi yooto. <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />Gido attiin illiwazi kaseppe aakki aakki bontta aggidi kase ba dizason diikko kase kixay paxidaso attiin harge deenna; qeesezi izi geesh gididayssa eriso. <verse eid="LEV 13:23" /><verse number="24" style="v" sid="LEV 13:24" />Kase iza tamay midaadey diikko he izi taman meetettidasoy booththa illiwa woykko zo7anaadan hani bessiko, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />Qeesezi iza paacci xeello; he illiway dizason mokkida iskey booth gidikkonne hankko iza achchan diza galbaafe duge ashon gelikko hessi taman xuugeteththa gaason asappe asan aadhdhiza iita galba harge; hessa gishshas qeesey hessaadey tunidayssa izas eriso. <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />Iza bolla mokkida iskezi booththa isken laamettontta aggikonne madunththazi duge ashon gelontta aggidi shoolloti shoolloti biikko qeesezi lo7eththi be7idi laappun gallas gakkanaas kare iza bolla gordi woththo. <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />Qasseka laappunththa gallas paacci xeello; izi kaseppe aakki aakki biikko hessi iita galba harge; hessa gishshas hessaadey tuna gididayssa qeesezi iza eriso. <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />Madunththay dizasoy qasse kaseppe aykkoka aakkontta aggikonne paxi paxi biikko izi tamay midaso attiin hara gidenna; hessa gishshas hessaadey wogaa mala geesh gididayssa qeesey iza eriso.<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />«Adde gidiin maccas gidiin hu7e bolla woykko shagala bolla madunththi diikko, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />qeesezi he madunththaa paacci xeellishin madunththay duge ashon gelikko iza bolla diza iskey galal7o mala gididi lee7i bessiko hessi hu7e woykko buuchcha qaacisi goo7issiza daro iita galba harge gidida gishshas hessaadey tuna gididayssa qeesezi iza eriso. <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />Qasseka qeesey paacci xeellishin madunththay hankko iza achchan diza galbaafe duge ollati bessontta aggiko, iza bolla diza iskey lo7o gidontta aggiko hessaade laappun gallas gakkanaas kare gordidi keeththan woththo. <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />Laappunththo gallas qasseka qeesezi izaade paacci xeello; kaseppe aakki aakki bontta aggiko qooruma misatiza iskeyka baynda aggikonne madunththazi duge ashon gelontta aggiko, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />Hessaadey madunththaa yuuyi aadhdhi diza iskeza ubbaa meedetto; qeeseykka iza qasseka laappun gallas gakkanaas karey iza bolla gordettiin gam7ana mala ooththo. <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />Laappunththo gallas qeesezi qasseka he madunththaa paacci xeello; madunththay kaseppe aakki aakki bontta aggikonne asho mi ollasontta aggiko hessaadey diza wogaa mala gididayssa iza eriso; izaadeyka ba may7o meeccidi geesh gido. <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />Gido attiin izi geesh gididayssa qonccisidaappe guye madunththay kaseppe aakki aakki biikko, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />qeesezi qasseka paacci xeello; madunththay addaka kaseppe aakkidaa gidikko iskey qoorumikko woykko qoorumontta aggikokka izaadey tuna. <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />Gido attiin qeesezi beyishin madunththay kaseppe aakki aakki bontta aggikonne lo7o iskey mokkiko madunththay paxidayssanne izaadey geeyidayssa qeesezi iza eriso.<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />«Maccas gidiin woykko adde gidiin issaade bolla illiway kezikko, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />qeesezi he illiway dizaadeza paacci xeello; illiway dizasoy coo mela puqqa booth gidontta aggiko iza daro qohontta coo mela bollara galba bolla kezida shimpe gidida gishshas hessaadey diza wogaa mala izi geeshsha.<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40-41" style="v" sid="LEV 13:40-41" />«Issaades hu7e iskey guye baggara woykko sinththa baggara bo7atikko hessaade bo7ay iza tunisenna. <verse eid="LEV 13:40-41" /><verse number="42" style="v" sid="LEV 13:42" />Gido attiin iza bo7aa bolla woykko liiphe bolla zo7i bessiza booththa madunththi beettiko hessi iita hara asa bolla aadhdhiza galba harge. <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />Qeesezi hessaade paacci xeellishin hessi hara asa bolla aadhdhiza galba harge misatidi zo7i bessiza booththa madunth gidikko, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />Hessaadey hara asa bolla aadhdhiza iita hargen oykettida gishshas izaadey tuna gididayssa qeesezi izaade eriso. <verse eid="LEV 13:44" /><verse number="45" style="v" sid="LEV 13:45" />Hessa mala hargey iza bolla dizaadey daakeththa may7o may7o; ba hu7ekka pixoppo; ba doona kammidi, ‹Tani tunakko! Tani tunakko!› gishe waasso. <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />He hargezi iza bolla diza wode ubbaan izi tuna; hessa gishshas izi asi dizasoppe gede haraso haakkidi barkka de7o.<verse eid="LEV 13:46" /></para>
  <para style="s1">Asa Bolla Harge Gaththiza Buuqa</para>
  <para style="p">
    <verse number="47-48" style="v" sid="LEV 13:47-48" />«Asa bolla harge gaththiza buuqay dorsa iskefe oosettida may7o bolla woykko ay qommo may7o bollaka harpan dadettida may7o bolla woykko kushen oosettida galba may7o woykko galbafe oosettida may7o bolla beettiko, <verse eid="LEV 13:47-48" /><verse number="49" style="v" sid="LEV 13:49" />he hargezas malay maata mala cilili bessiko woykko zo7i bessiko hessi issaafe issaan aadhdhiza harge gidida gishshas qeesezi iza beyo. <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />Qeesezi he hargeza lo7eththi xeellidi he may7ota ubbaaka laappun gallas gakkanaas issi keeththan gelththi dumma woththo. <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />Laappunththo gallas qasseka paacci xeellishin asa bolla harge gaththiza buuqazi kaseyssafe dari beettiko hessa mala may7ozi tuna. <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />Hessa mala may7o buuqay asa bolla harge gaththiza gishshas qeesezi shiishshidi he buuqa may7ota taman xuuggo.<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53-54" style="v" sid="LEV 13:53-54" />«Qeesezi zaari paacci xeellishin buuqazi kaseppe ha darontta aggiko may7oza haaththan meeccana mala azazo; he meecettida may7oza laappun gallas gakkanaas shaakki woththo. <verse eid="LEV 13:53-54" /><verse number="55" style="v" sid="LEV 13:55" />Hessafe qasseka xeellishin kaseppe buuqay gujettontta aggikonne buuqaza medhay kaseppe laamettontta aggiko ha7ikka izi tuna; kaseyssa bolla giddora, karera buuqazi gujettiko he may7ozi taman xuugetto. <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />Gido attiin may7oza meecci simmidaappe qeesezi qasseka zaari be7iza wode buuqazi kaseppe duge guuxxiko buuqazi dizasoyo xalla iita may7ofe gidiin woykko afala gidiin daakki kesso. <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />Buuqazi qasseka beettiko hessi gede dari dari biza gishshas he may7ozi xuugetto. <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />Ay may7onne galbafe oosettida ay miish meeccishin buuqazi izappe dhaykko qasseka meecco; hessafe guye wogay giza mala may7ozi geesh gidana.»<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />Hayssi dorsa iskefe oosettida may7o bolla woykko ay qommo may7o bolla woykko harpan dadettida woykko kushen oosettida may7o bolla, galba woykko galbafe oosettida may7o bolla asa bolla harge gaththiza buuqay beettiko he may7ozi geesh woykko tuna gididayssa erisiza wogay hayssafe bollan dizayssa.<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s1">Galba Bolla Keziza Iita Hargefe Geeyza Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />GODAY Muses hizgides, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />«Issaadey asateththa bolla diza iita galba hargefe paxidaappe guye geesho wogay hayssafe kaallizayssa; izi geesh gididayssa izaades yootettiza gallas hessaadey qeesekko baana mala izas yootetto.<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="MAT 8:4">Mato 8:4</ref>; <ref loc="MRK 1:44">Mar 1:44</ref>; <ref loc="LUK 5:14">Luqa 5:14</ref>; <ref loc="LUK 17:14">17:14</ref></char></note> <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />He izas yootettida qeesezi asi dizasoppe gede haraso kessidi baakko yidayssa lo7eththi xeello; izaadey hargezappe paxidaa gidikko, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />qeesezi paxa diza nam7u geeshsha kafotanne ziga mith, zo7o xilata, hisophphe miththa hayth gujji ekki yaana mala azazo. <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />Hessafe guye qeesezi kafotappe issaa pultto haaththi izan diza guuqa kere bolla shukettana mala azazo. <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />Hankko paxa diza kafoza efidi ziga miththara, zo7o xilataranne hisophphe miththa bonccora issife gaththi kase shukettida kafoza suuththan gelththi kesso. <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />Suuththaaka asateththa bolla diza galba hargefe paxizaade bolla laappunto wuxxo; hessafe guye izi geesh gididayssa iza eriso; hankko paxa diza kafozakka gede haraso kessidi demban piradhdhana mala yeddo.<verse eid="LEV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8" />«Iita galba hargefe paxidaadey ba may7o meecco; ba bolla diza iske ubbaa meedetto; ba bollaka meecetto; wogay giza mala izi geesh gidana; hessafe guye asi dizaso gelanaas dandayees; gido attiin laappun gallas gakkanaas izi ba dunkaanaappe karen de7o. <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />Laappunththo gallas qasseka ba hu7e, ba buuchchinne ba deemo, hara awanka ba asateththa bolla diza iske ubbaa meedetto; ba may7o haaththan meecconne ba bollaka meecetto; hessafe guye izi geesh gidana.<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />«Osppunththa gallas issi wosoykka istta bolla baynda nam7u dorsa laaqqatanne issi layththa uzzo eho; kaththa yarsho gishshas wogara miththa zayten munuqettida heedzdzu kilo dhiillenne issi litiro zaytes heedzdzanththo kushe wogara miththa zayte eho. <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />Qeesezikka addezi izi ehida ubbaara issi bolla Gaytoteththa Dunkaaneza pengen GODAA sinth shiishsho.<verse eid="LEV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12" />«Hessafe guye nam7u qeeri dharshotappe issaa ekkidi issi litiros heedzdzanththo kushe gidiza wogara zaytera issife gaththi ekkidi qoho gishshas shiiqiza yarsho histti shiishsho; qeesezi he yarshozakka yaanne haa qaaseththiza yarsho histti GODAA sinththan qaaseththi shiishsho. <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />Laaqqazakka nagara yarshossinne xuugettiza yarshos shukkiza geeshshasohon shukko; gaasoykka qoho gishshas yarshoy nagara wursanaas shiiqiza yarsho mala qeesezas gisha gidana; izikka keehi dumma. <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />Qeesezi qoho yarshos shiiqiza suuththafe guuththara ekkidi he geeyzaades ushachcha hayththa xeera izas ushachcha kushe manththa biradhdhenne ushachcha toho manththa biradhdhe tiyo. <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />Qeesezi wogara miththa zaytezappe guuththara ekkidi ba hadirsa kushe qaa7an tigo. <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />Ba ushachcha kushe xeeran guuththara ekkidi Xoossa sinththan laappunto wuxxo. <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />Ba kushe qaa7an attida zaytezappe guuththara ekkidi geeyzaades ushachcha hayththa xeera, ushachcha kushe manththa biradhdhenne ushachcha toho manththa biradhdhe tiyo. <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />Ba kushe qaa7an attida zaytezakka geeyzaade hu7en gusso; qeesey izaade nagara geeshsho.<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19" />«Hessafe guye qeesezi ba tunateththafe geeyzaade nagara wursanaas shiiqida mehe shukko. <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />Qasseka qeesezi he xuugettiza yarshoza kaththa yarshozara issife yarsho yarshizasoza bolla woththidi xuuggo; hessa mala ooson izaade nagarappe maarisees; izaadeyka geesh gidees.<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />«Izaadey hessa ubbaa ehanaas dandayontta manqo gidikko Godaa sinththan yaanne haa qaaseththidi ba nagara wursanaas issi dharsho laaqqa ehidi qoho yarsho gishshas shiishsho; qasse kaththa yarshozaska wogara miththa zayten munuqettida issi kilo liiqo dhiille kaththa yarshos eho; hessaththoka issi litiros heedzdzanththo kushe gidiza zayte eho. <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />Qasseka iza wolqqay dandayda mala nam7u haraphpheta woykko nam7u waanosetappe issaa nagara gishshas yarshos, nam7anththoza qasse xuugettiza yarshos eho.<verse eid="LEV 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23" />«Geesho wogay polettiza osppunththa gallas heyta ubbaa ehidi Gaytoteththa Dunkaane pengen GODAA sinththan qeeses immo. <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />Qeesezikka qoho yarshos shiiqiza dorsa laaqqanne wogara miththa zayteza ekkidi yaanne haa qaaseththiza yarsho ooththi GODAA sinththan yarsho. <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />Qoho gishshas shiiqiza yarshos shiiqida dorsa laaqqa shukko; suuththaafe guuththara ekkidi geeyzaades ushachcha kushe manththa biradhdhe, ushachcha toho manththa biradhdhenne ushachcha hayththa xeera tiyo. <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />Qeesezi zaytezappe guuththara ba hadirsa kushe qaa7an tigo. <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />Ba ushachcha kushe biradhdhen guuththara bochchidi Xoossa sinththan laappunto wuxxo. <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />Ba kushe qaa7an tigida zayteppe guuththara ekkidi qoho yarsho suuththan bochchidaason hessika geeyzaades ushachcha hayththa xeera, ushachcha kushe manththa biradhdhe xeera, ushachcha toho manththa biradhdhe xeera boshiso. <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />Qeesezi ba kushen attida zayteza addeza hu7en gusso; hessaththo ooththidi geesho woga GODAA sinththan polo. <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />Hessafe guye haraphpheta woykko waanoseta geeyzaade wolqqay gaththida keena qeesezi yarsho. <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />Heytanttafe issaa nagaras shiiqiza yarshos nam7anththoza qasse xuugettiza yarshos kaththa yarshora gaththi shiishsho; qeesezi ubbaaka hayssa malan geeyzaade nagarappe geeshsho. <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />Asappe gede hara asan aadhdhiza iita galba hargefe geeyanaas koshshiza woga polanaas dandayontta manqo asas diza wogay hayssa» gides.<verse eid="LEV 14:32" /></para>
  <para style="s1">Buuqay Beettida Keeth Geesho Woga</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />GODAY Musessinne Aaroones hizgides, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />«Tani inttes immiza Kanaane biitta intte geliza wode issi keeththan tani buuqa yeggiko, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />he keeththaadey biidi qeeseza, ‹Tason ay iita hargey dizaakko› giidi yooto. <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />Soon diza miish ubbay tuna geetettontta mala qeesezi he iita hargaa beyanaas gelanaappe kasetidi soon diza miish ubbaa kare kessana mala azazo; hessafe guye qeesezi xeellanaas keeththaa giddo gelo. <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />Hargeza lo7eththi paacci xeelliza wode keeththaa lukki lukki miza hargezas medhay maata mala cilila woykko zo7o woykko puncarka misati beettiko, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />qeesezi he keeththaafe kezidi keeththay laappun gallas gakkanaas gordettana mala ooththo. <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />Qeesezi laappunththa gallas simmidi qasseka xeello; hargezi kaseppe gede dari dari biikko, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />hargey istta bolla beettida shuchchati keeththaafe woocetti kezidi katamappe gede karen diza tuna miish yegettizason yegettana mala azazo. <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />Hessafe guye keeththaas soo bagga giiridi he giireththaza katamappe kare baggara tuna miish yeggizason yeggana mala azazo. <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />Hessafe guye kase shuchchata sohon hara ooraththa shuchchi geliin he keeththan hara ooraththa urqqay meeshetto.<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />«Shuchchati digettiin qasseka urqqaaka qoqofidi hara urqqan meeshi ooraththidaappe guye he hargeza malatay qasseka simmi beettiko, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />qeesezi simmi biidi beyo; hargezi kaseppe gede aakki aakki biza mala gidikko he hargey issaafe issaan aadhdhiza iita harge gidida gishshas he keeththay tuna. <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />Hessa gishshas he keeththay laalettanaas bessees; he keeththaa shuchchay, miththaynne miishshi, urqqay wurikka katamappe gede kare tuna miishshi yegettizason yegetto. <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />Gordettidaappe guye he keeththan gelida asi wurikka omars gakkanaas tuna gidees. <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />He keeththan ichchidaadey woykko kath midaadey ba may7o meecco.<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />«Keeththay qasseka ooraxidi meeshettidaappe guye qeesezi yiidi xeellishin hargezi kaseppe aakki aakki bontta aggiko, hargeza malatay dhayda gishshas, he keeththay geesh gidida gishshas qeesezi keeththa aawaa eriso. <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />He keeththaa geeshshanaas nam7u kafo, Libaanoose ziga, zo7o xilatanne hisophphe geetettiza miththa hayth eho. <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />Kafotappe issaa pultto haaththi izan diza guuqa keren shukko; <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />hessafe guye ziga mith, hisophphe miththa hayth, zo7o xilatanne paxa diza kafoza issife gaththi ekkidi guuqa keren diza pultto haaththaninne hankko shukettida kafoza suuththan gelththi kessidi keeththaza laappunto araco. <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />Qeesezi hessaththo histtidi he keeththaa kafoza suuththan, pultto haaththan, paxa diza kafon, ziga miththan, hisophphe miththa hayththaninne zo7o xilatan geeshsho. <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />Hessafe guye paxa diza kafoza izi piradhdhi baana mala gede demba kessi yeddo; hessaththo ooththidi keeththaa geeshshiza wogaa polikko keeththayka geesh gidees.» <verse eid="LEV 14:53" /><verse number="54" style="v" sid="LEV 14:54" />Hayssi ha wogazi issaafe issaan aadhdhiza galba bolla keziza ay harges, qaachcha harges, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />may7o bollanne keeththa bolla issaafe issaan aadhdhi aadhdhi yiza harges, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />kixa harges, badhinttessinne illiwa harges, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />hayssi ay miishshika tuna woykko geesh gididayssa shaakki erisanaassinne issaafe issaan aadhdhiza iita harge woykko buuqa geeshshanaas diza woga.<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s1">Asappe Goggi Kezidi As Tunisiza Miish</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />GODAY Musessinne Aaroones hizgides, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />«Ay asaska izaade asateththafe goggiza miishshi diikko hessaadey tuna gaada Isra7eele asaas yoota. <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />Asateththafe goggi kezizayssi aggontta ixxiko woykko gogeththaa aggikokka hessaadey tuna.<verse eid="LEV 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4" />«Hessaadey iza bolla ichchida hiiththi, uttida ay miishshika tuna gidees. <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />Hiixaza bochchida ay asikka ba may7onne ba bolla haaththan meecco; gidikkoka hessaadey omars gakkanaas tuna gido. <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />Asateththafe tunisiza miishshi goggi keziza asi uttidasohon uttida ay asikka ba may7onne ba bolla haaththan meecco; gidikkoka hessaadey omars gakkanaas tuna gido.<verse eid="LEV 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7" />«Asateththafe tunisiza miishshi goggi keziza as bochchiday ay asikka ba may7onne ba bolla haaththan meecco; gidikkoka omars gakkanaas tuna gido.<verse eid="LEV 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8" />«Asateththafe tunisiza miishshi goggi keziza asi hankko paxa diza asa bolla cuch cuttiko he cuchchay iza bochchida asi ba may7onne ba bolla haaththan meecco; gidikkoka hessaadey omars gakkanaas tuna gido.<verse eid="LEV 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9" />«Asateththafe tunisiza miishshi goggi keziza asi uttida koora ubbay tuna; <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />hessaadey iza bolla uttida miish bochchida asi ubbay omars gakkanaas tuna; gido attiin he tunida issi miishshatappe issaa denththida ay asikka ba may7onne ba bolla meecco; gidikkoka izi omars gakkanaas tuna gido.<verse eid="LEV 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11" />«Asateththafe tunisiza miishshi goggi keziza asi ba kushe meecettontta dishe hara bochchiko he boshettidaadey ba may7onne ba bolla haaththan meecco; gidikkoka omars gakkanaas tuna gido. <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />Asateththafe tunisiza miishshi goggi keziza as bochchida mana miishshi meqqo; miththafe oosettida miishshi wurikka haaththan meecetto.<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />«Asateththafe tunisiza miishshi goggi keziza asi he hargezappe paxikko kase diza mala ba paxidayssa erisanaas laappun gallas gakkanaas gam7iishsho; hessafe guye ba may7o meecco; qasseka ba bolla xillo gidida pultto haaththan meecetto; histtidi geesh gido. <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />Osppunththa gallas nam7u haraphpheta woykko nam7u haraphphe ciyeta Gaytoteththa Dunkaane penge efidi GODAA sinththan qeesezas immo. <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />Qeesezikka haraphpheta ekkidi issaa nagara wursos yarsho, hankkoyssa qasse xuugettiza yarsho histti yarsho; hessaththo histtidi qeesezi hessaade goggi keziza miishshas geeyza wogaa GODAA sinththan polo.<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />«Ay asikka iza attumateththafe zereththi gukkiko izi ba bolla meecetto; gidikkoka omars gakkanaas tuna gido. <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />Zereththay iza bolla gukkida ay may7o gidiin woykko galba gidikko haaththan meecetto; gidikkoka omars gakkanaas tuna gido. <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />Addey maccassara zin7i dendidaappe guye nam7ayka bantta bolla haaththan meecettetto; gidikkoka omars gakkanaas tuna gidetto.<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />«Maccassas aginan aginan yiza wogay beettiko laappun gallas gakkanaas iza tuna gidu; izo bochchiza ay asikka omars gakkanaas tuna gido. <verse eid="LEV 15:19" /><verse number="20" style="v" sid="LEV 15:20" />Maccassas aginan aginan diza wogay yiza wode iza uttizasoynne ichchidasoy ubbay tuna gido. <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />Iza ichchida hiixa bochchida ay asikka ba may7onne ba bolla meecco; gidikkoka omars gakkanaas tuna gido; <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />iza uttida ay miishshika bochchidaadey ba may7onne ba bolla meecco; gidikkoka omars gakkanaas tuna gido. <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />Iza ichchidaso woykko uttidaso miish bochchida ay asikka omars gakkanaas tuna gido. <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />Aginan aginan beettiza maccassa wogay yiza wode izira zin7iza ay addeyka izi mala tuna gidiza gishshas laappun gallas gakkanaas tuna gido; izi ichchiza hiixay tuna gidees. <verse eid="LEV 15:24" /><verse number="25" style="v" sid="LEV 15:25" />Issi maccassas aginan aginan beettiza maccassa wogay gukkiza wodeppe daro gallas gukkiko woykko aginan aginan beettiza wodezappe bollara aggontta suuththi gukkiko he suuththay eqqana gakkanaas iza tuna gidawus. <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />He wode iza ichchida hiixa gidiin woykko iza iza bolla uttida miishshi aginan aginan beettiza maccassa wogay diza wode haniza mala ubba wode tuna. <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />Heyta bochchida ay asikka tunida gishshas ba may7onne ba bolla meecco; gidikkoka omars gakkanaas tuna gido.<verse eid="LEV 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28" />«Izippe gukkiza suuththay eqqiko he suuththay eqqoo gallassafe biidi laappun gallas gakkanaas gam7ada hessafe guye wogay giza mala geeyu. <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />Osppunththa gallas nam7u haraphpheta woykko nam7u waanoseta Gaytoteththa Dunkaane penge ekka yaada qeesezas immu. <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />Qeesezikka issaa nagarappe geeshshiza yarshos nam7anththozakka xuugettiza yarshos shiishsho; histtidi he maccassayo tunateththafe geeshshiza woga polo.<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />«Heen istta giddon diza Gaytoteththa Dunkaane tunisidi hayqqontta mala Isra7eele nayta tunisiza miishshafe naagite.»<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />Tunisiza miishshi iza asateththafe goggi kezizaadessinne iza attumateththafe zereththi gukkizaades, <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />qasseka aginan aginan beettiza maccassa wogay beettiza maccassas woykko adde gidiin macca gidiin tunisiza miishshi istta asateththafe goggiza wode woykko geeyontta maccassara zin7iza attumasaas wodhdhida wogay hessa.<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s1">Geesho Gallas</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />Aaroone attuma naa nam7ati bessontta tama GODAA sinth ekki shiiqida gishshas hayqqida; hessafe guye GODAY Muses hizgides, <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />«Ne isha Aarooney Taabotaa bollan diza atto gizasoza kammizayssa sinththan magalashaappe guye baggara diza keehi dumma geetettizasoza ba shene mala ubba wode gelontta mala izas yoota; izi ubba wode ba shenen gelizaa gidikko hayqqana; gaasoykka tani shaara giddora atto gizasoza kamaa bolla qonccays.<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="HEB 6:19">Ib 6:19</ref></char></note><verse eid="LEV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 16:3" />«Aarooney nagarappe maareththiza yarshos issi mirgo booranne qasse xuugettiza yarshos issi dharsho ekkidi keehi dumma geetettizasoza gelo.<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="HEB 9:7">Ib 9:7</ref></char></note> <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />Aarooney keehi dumma geetettizaso gelanaappe kase may7oti dumma gidida gishshas ba bolla meecettidi qeeseteththa may7o may7o; hessika laynoppe oosettida qamisanne sure may7o; hessaththoka laynoppe oosettida qabatton gixxo; laynoppe oosettida goosseka goozo.<verse eid="LEV 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5" />«Isra7eele nayta maabaray nagara gishshas shiishshiza yarshos nam7u deysha orgenne xuugettiza yarshos issi dharsho Aaroones ehetto. <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />Aarooney baassinne baso asaa nagara wursanaas issi korma boora yarshos shiishsho. <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />Hessafe guye he nam7u deysha orgeta gede Gaytoteththa Dunkaaneza pengen GODAA sinth efo. <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />Histtidi he nam7u orgeta bolla izi saama yeggo; heytappe issoy, ‹GODAA› nam7anththozi, ‹Azazeele›<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fqa" closed="false">Azazeele: </char><char style="ft" closed="false">Azazeele gizayssas Ibraawe qaalara birsheththi erettenna; bazzon diza Xala7e gidontta aggenna geettes.</char></note> giza malatay diza shuchchata orgeta bolla yeggo. <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />GODAAS giza malatay iza bolla wodhdhida deyshaza nagarappe geeshshiza yarshos shukko. <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />Azazeeles giza malatay iza bolla wodhdhida deyshazi shukettontta paxa GODAAS shiiqo; dereza nagara tookkidi duge bazzo yedetto.<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />«Aarooneykka korma booraza ba nagara wursanaassinne baso asaa nagara wursanaas yarsho shukko. <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />Qasse GODAA sinththan diza yarsho yarshizasoppe exaane cuwasiza miishsha<note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="fqa" closed="false">Exaane cuwasiza miishsha: </char><char style="ft" closed="false">Exaane cuwasiza miishsha gizayssi amaraththo qaalara xinna geetettees.</char></note> kumeththa bonqonne liiqi gaacettida nam7u zolle sawiza exaane ekkidi magalasha giddon diza keehi dumma gidida kifile eho. <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />Exaaneza heen GODAA sinththan taman yeggo; izi iza be7idi hayqqontta mala exaaneza cuway Taabotaa kammizayssa ubbaa genththo. <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />Kormaza suuththaafe guuththara ekkidi izan ba biradhdhe gelththi gelththidi Taabotaa kamaza bolla sinththa baggara araco; hessaththoka izappe guuththara Caaqo Qaala Taabotaa sinththan laappunto wuxxo.<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />«Hessafe guye hankko dereza nagaraa gishshas shukettiza deyshaa shukko; iza suuththaa keehi dumma geetettiza kifileza gelththidi kase kormaza suuththaa ooththoyssaththo atto gizaso Taabotaa kamaza bollaninne izas sinththa baggara laappunto wuxxo.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="HEB 9:12">Ib 9:12</ref></char></note> <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />Hessaththoka ooththidi keehi dumma gidida kifileza Isra7eele nayta tunateththafenne istta nagara ubbaafe geeshshanaas geesho woga polo; kase istti tuna miish ooththishin istta giddon diza Gaytoteththa Dunkaanezakka hessaththo geeshsho. <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />Geesho woga polanaas Aarooney keehi dumma geetettiza kifileza gelidi ba nagara gishshas, baso asaa nagara gishshassinne Isra7eele dere nagaraa gishshas yarsho shiishshi maarisidi kezana gakkanaas ay asikka Gaytoteththa Dunkaaneza giddon dooppo. <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />Hessafe kaallidi izi GODAA sinththan yarsho yarshizaso kezidi geeshsho; korma suuththafenne deysha suuththafe guuththara ekkidi yarsho yarshizasozan yuuyi aadhdhanaas diza dhemota tiyo. <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />Qasse Isra7eele nayta tunateththafe yarsho yarshizasoza geeshshanaassinne dummasanaas suuththaafe guuththara ekkidi ba biradhdhe xeeran yarsho yarshizasoza bolla laappunto wuxxo.<verse eid="LEV 16:19" /></para>
  <para style="s1">Bazzo Goodettiza Deysh</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />«Aarooney keehi dumma geetettizaso, Gaytoteththa Dunkaanenne yarsho yarshizasoza geesho woga polidaappe guye shukettontta attida baqa deyshaa ekkidi GODAAS shiishsho. <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />Ba kushe nam7ata deyshaa hu7e bolla woththidi dereza nagaraa, iitateththaanne makkallateththaa ubbaa paaxo; deyshaza hu7e bolla yuushshi pittishe deraa nagara iza bolla woththo; hessafe guye kase deyshaza efanaas giigetti uttidaade bolla duge bazzo yeddetto. <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />Hessika deyshay asa ubbaa nagara ubbaa tookkidi ay asikka bayndaso duge bazzo haassi yeddo.<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />«Aarooneykka gaytoteththa dunkaanaa giddo gelo; gede keehi dumma geetettiza kifileza gelanaappe kasetidi izi kase may7ida qeeseteththa may7oza heen qaari woththo.<note caller="-" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="EZK 44:19">Hizi 44:19</ref></char></note> <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />Ba bolla heen geeshshasohon meecettidi ba kase may7iza may7o; heeppe kezidi ba nagara wursanaassinne deraa nagara wursanaas xuugettiza yarsho shiishsho. <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />Nagara wursanaas shiiqida meheza moodhe yarsho yarshizasoza bolla xuuggo.<verse eid="LEV 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26" />«Bazzo yedettiza deyshaa duge bazzo laaggi efidaadey guye asay dizaso simmi gelanaappe kasetidi ba may7o meecco; ba bollaka meecetto; hessafe guye asay dizaso gelo. <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />Nagara gishshas yarshettana shiiqidaytanne nagara geeshshanaas istta suuththi keehi dumma kifile geetettizaso gelida kormazanne deyshaza ashoy, galbazinne tocey attontta asi dizasoppe gede haraso biidi xuugetto. <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />Hessa ubbaa xuuggizaadey xuuggidi asi dizaso simmi gelanaappe kasetidi ba may7o haaththan meecco; ba bollaka meecetto.<verse eid="LEV 16:28" /></para>
  <para style="s1">Geesho Gallas Bonchchanaas Imettida Woga</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />«Hayssafe kaallidi inttes imettiza wogata hayssafe guye yaana layththatan ubbaan laamettontta eqqi diza woga histtidi naagite; layththafe laappunththa aginay gelida tammanththo gallas Isra7eele dere asaynne istta garsan diza hara dere asay xooma xoomanaas bessees; he gallas ay oosoykka oosettofo.<note caller="-" style="x"><char style="xo" closed="false">16:29-34 </char><char style="xt" closed="false"><ref loc="LEV 23:26-32">Lewe 23:26-32</ref>; <ref loc="NUM 29:7-11">Tay 29:7-11</ref></char></note> <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />He gallas intte nagaray kichchana malanne intte geeyana mala geesho wogay polettiza gishshas intte GODAA sinththan intte nagara ubbaafe geeyidayta gidana. <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />He gallassay xooma gallassinne shempo shempiza sambata gallas gido; hessika mernaa woga gido; <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />Ba aawa sohon qeeseta halaqa gidanaas tiyettidanne shuumettida qeesey nagara ubbaa woga polanaas ba qeeseteththa may7oza may7idi polo. <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />Izikka keehi dumma kifileza, yarsho yarshizasoza, Gaytoteththa Dunkaaneza; qeesetanne Isra7eele asaa ubbaa nagara wurso. <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />Isra7eele asaa nagara ubbaa woga intte layththan layththan issito polana mala hessi inttes mernaas laamettontta woga gido.»</para>
  <para style="p" vid="LEV 16:34">Hessaththo GODAY iza azazida mala Musey ooththides.<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s1">Suuththi Uyettontta Mala Imettida Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />GODAY Muses hizgides, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />« ‹GODAY azazida azazoy hayssa› gaada Aaroones, iza naytassinne Isra7eele asi ubbay diza heeran yoota; <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />woykko ba diza heerappe karen boora woykko dors woykko deyshe yarsho shukkidi, <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />GODAAS dummatidason Xoossas yarshanaas Gaytoteththa Dunkaane penge ehontta aggiko hessaadey suuththaa coo hada gussida mala qoodettidi dere giddofe shaaketti goodetto. <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />Hessa gishshas Isra7eele nayti ay mehe gidiin coo demban shukkontta GODAA sinth Gaytoteththa Dunkaane penge ehetto; meheta Dunkaane penge ehidi qeesezas immetto; qeesezikka issifeteththa yarsho histti shukko. <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />Qeesezikka suuththaa Gaytoteththa Dunkaane pengen diza GODAAS yarsho yarshizasoza bolla wuxxo; GODAA ufayssiza lo7o sawo gidana mala moodheza taman xuuggo. <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />Isra7eele nayti istta ammanoppe haassiza daydanththatas yarsho ooththidi ba mehe beettooson beettooson yarshos shukkanaas bessenna; hessika isttassinne isttafe guye yeleta ubbaas mernaa woga gidi de7o.<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8-9" style="v" sid="LEV 17:8-9" />«Ne isttas, ‹Isra7eele naytappe gidiin woykko isttara diza hara dere as gidiin Dunkaaneza pengefe attiin harason awanka GODAAS xuugettiza yarsho woykko hara yarsho yarshiko hessaadey GODAA deretara qoodettanaas bessenna› ga yoota.<verse eid="LEV 17:8-9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />«Isra7eele as gididay oonikka woykko Isra7eele naytara issife diza hara dere asi suuth uyikko hessaadey ta achchan ixettidaade gidees; tani hessaade iza dere garsafe shaakka dhayssana.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="GEN 9:4">Medhe 9:4</ref>; <ref loc="LEV 7:26-29">Lewe 7:26-29</ref>; <ref loc="LEV 19:26">19:26</ref>; <ref loc="DEU 12:16">Zaare 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref></char></note> <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />Shemppora paxa diza medheteth ubbaas shemppoy suuththa giddon dees; hessa gishshas asa nagara wursanaas gukkiza suuththi wurikka yarsho yarshizasoza bolla gukkana mala immadis; asa shemppo nagarappe maarisizay suuththa.<note caller="-" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="HEB 9:22">Ib 9:22</ref></char></note> <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />Hessa gishshas Isra7eele asaa, ‹Inttefe woykko intte giddon diza hara dere asappe oonikka suuth uyoppo› gays.<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />«Isra7eele naytappe woykko isttara diza hara dere asappe oonikka ashoy meetettana mala imettida mehe gidiin woykko wora do7a woykko kafo shankkati oykkidi iza suuththaa biitta bolla gussidi biitta iza bolla kammo. <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />Gaasoykka asho may7ida ubbaa shemppoy suuththa giddon dees; hessa gishshas tani Isra7eele asaa, ‹Asho may7ida medheta ubbaa shemppoy iza suuththa giddon diza gishshas suuth moopite; midaadey oonikka ba dere giddofe shaaketti dhayo› gays.<verse eid="LEV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15" />«Isra7eele naytappe woykko hara dere asappe oonikka bawuti hayqqidaaz woykko do7ay wodhida mehe asho miikko ba may7o meecco; ba bolla meecetto; gidikkoka omars gakkanaas tuna gido; hessafe guye geesh gido. <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />Ba may7o meeccontta aggikonne ba bolla meecettontta aggiko hessaadey nagara ooththida gishshas ba nagaran oyshettana.»<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s1">Wogan Digettida Zin7o</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />GODAY Muses hizgi yootides; <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />«Isra7eele naytas, ‹Tani GODAA intte Xoossaa; <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />kase intte heen de7ida Gibxe biitta asay woykko buro ta inttena gelththana Kanaane biittan diza dere asay ooththiza shaattiza ooso intte ooththoftenne istta hano kaallofte. <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />Ta wogata naagite; ta azazotakka polite; tani GODAA intte Xoossaa. <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />Ta azazotanne wogata naagite; hessantta naagiza asi ba shemppo ashshana; tani GODAA› ga yoota.<note caller="-" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="NEH 9:29">Nahi 9:29</ref>; <ref loc="EZK 18:9">Hizi 18:9</ref>; <ref loc="EZK 20:11-13">20:11-13</ref>; <ref loc="LUK 10:28">Luqa 10:28</ref>; <ref loc="ROM 10:5">Oro 10:5</ref>; <ref loc="GAL 3:12">Gala 3:12</ref></char></note><verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />«Inttefe oonikka baas asho dabbora laymatoppo; tani GODAA.<verse eid="LEV 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7" />«Ne aayeyra laymatada ne aawa kawushshofa; nees aayo gidida gishshas izira laymatoppa.<verse eid="LEV 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8" />«Ne aawaas hara machchetarakka laymatada ne aawa yeellachchofa.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="LEV 20:11">Lewe 20:11</ref>; <ref loc="DEU 22:30">Zaare 22:30</ref>; <ref loc="DEU 27:20">27:20</ref></char></note><verse eid="LEV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9" />«Ne michcheyra laymatoppa; hessaththoka nenara issife diccidaaro gidiin woykko harason diccidaaro gidiin ne aaway yelida hara machchi naa woykko ne aaya hara azinas yelida macca nayra laymatoppa.<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="LEV 20:17">Lewe 20:17</ref>; <ref loc="DEU 27:22">Zaare 27:22</ref></char></note><verse eid="LEV 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10" />«Nees yeella gidontta mala nees naaza nayra, woykko nees nay nayra laymatoppa.<verse eid="LEV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11" />«Ne aawaas hara machcha yelida ne michcheyra zin7ofa; gaasoykka iza nees michcho.<verse eid="LEV 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12" />«Ne aawa michcheyra zin7ofa; gaasoykka iza nees michcho. <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />Ne aayey michcheyrakka zin7ofa; gaasoykka iza ne aayeys asho dabbo.<verse eid="LEV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14" />«Ne aawa isha machchira zin7ofa; gaasoykka iza nees aawa machchi mala.<note caller="-" style="x"><char style="xo" closed="false">18:12-14 </char><char style="xt" closed="false"><ref loc="LEV 20:19-20">Lewe 20:19-20</ref></char></note><verse eid="LEV 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 18:15" />«Ne naaza machcheyra zin7ofa; iza nees naaza machcho gidida gishshas izira zin7ofa.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LEV 20:1">Lewe 20:1</ref></char></note> <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />Ne isha machcheyra zin7ofa; gaasoykka iza nees isha machcho; hessi ne isha kawushshiza miishsha.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="LEV 20:21">Lewe 20:21</ref></char></note><verse eid="LEV 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17" />«Aayeyranne nayra zin7ofa; izis nay naaza nayranne nays nay nayra zin7ofa; isttika izas mata dabbo gidida gishshas hessaththo hanoy kawushshateththa.<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="LEV 20:14">Lewe 20:14</ref>; <ref loc="DEU 27:23">Zaare 27:23</ref></char></note><verse eid="LEV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18" />«Ne machchiya paxa dishin izi michchiyo dawuth ekkofa; izirakka laymatoppa.<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />«Aginan aginan beettiza maccassa wogay yiza wode maccassara zin7ofa.<verse eid="LEV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20" />«Hara asa machchira zin7ada nerkka nena tunisoppa.<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="LEV 20:10">Lewe 20:10</ref></char></note><verse eid="LEV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21" />«Ne naytappe oonakka molooke geetettiza eeqas xuugettiza yarsho ooththa immofa; gaasoykka ne Xoossaa sunth tunisoppa; tani GODAA.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LEV 20:1-5">Lewe 20:1-5</ref></char></note><verse eid="LEV 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22" />«GODAA sinththan ixettida miish gidida gishshas maccassara zin7iza mala addera zin7ofa.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">Lewe 20:13</ref></char></note><verse eid="LEV 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23" />«Adde gidiin woykko maccassi mehera parattidi banateththaa tunisoppo; hessa mala hanoy kawushshateththa.<note caller="-" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="EXO 22:19">Kessa 22:19</ref>; <ref loc="LEV 20:15-16">Lewe 20:15-16</ref>; <ref loc="DEU 27:21">Zaare 27:21</ref></char></note><verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />«GODAY nena istta dere gelththanaas ne sinththafe diggana; hankko asay barkka ba ooson bana tunisidayssa mala istti ooththiza iita oosotappe issineynka inttena tunisopite. <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />Istta oosoy biitta tunisida gishshas tani he biittayo izi nagara gishshas qaxxayadis; biittayakka ba giddon diza asaa kessa cuttadus. <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />Intte gidikko ta azazotanne ta woga naagite; Isra7eele asaappe woykko intte giddon diza hara biitta asappe oonikka hayssa mala ay oosokka ooththofte. <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />Inttefe kase he biittayn diza asati heyta mala harassiza miish ooththida gishshas biittaya tunadus. <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />Intte hessaththo ooththiko biittaya kase inttefe sinththan diza kawoteththata cuttidayssaththo inttenakka cuttana.<verse eid="LEV 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 18:29" />«Hayta harassiza iita oosotappe issineyokka ooththizaadey ba dere asaa giddofe shaaketti dhayo. <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />Hessa gishshas inttefe kase sinththan biitta bolla diza asati ooththida tuna oosota ubbaa ooththidi intte tunontta mala ta azazota naagite; tani GODAA intte Xoossaa.»<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s1">Dumma Dumma Wogata</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />GODAY Muse hizgides, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />«Hayssa Isra7eele naytas yoota, ‹Tani GODAY intte Xoossay dumma gidida mala intteka dumma gidite.<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">Lewe 11:44-45</ref>; <ref loc="1PE 1:16">1Phex 1:16</ref></char></note><verse eid="LEV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3" />« ‹Inttefe oonikka attontta ba aawaanne ba aayo bonchcho; ta inttena azazida mala Sambata gallassata bonchcho; tani GODAA intte Xoossaa.<note caller="-" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="EXO 20:8">Kessa 20:8</ref>,<ref loc="EXO 20:12">12</ref>; <ref loc="DEU 5:12">Zaare 5:12</ref>,<ref loc="DEU 5:16">16</ref></char></note><verse eid="LEV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4" />« ‹Tana aggidi eeqatas goynnofte; woykko eeqa Xoossata biratappe seerisidi inttes medhdhofte; tani GODAA intte Xoossaa.<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="LEV 20:15-16">Lewe 20:15-16</ref>; <ref loc="DEU 5:19-20">Zaare 5:19-20</ref></char></note><verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />« ‹Intte issifeteththa yarsho GODAAS shiishshiza wode he yarshoy intte gishshas ekettana bessiza mala yarshite. <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />Yarshoza shiishshida gallas woykko wonteththa gallas meetettanaas bessees; heedzdzanththo gallas gakkanaas gam7ida yarshoy wurikka taman xuugetto. <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />Heedzdzanththo gallassan iza miikko hessi tuna; hessa gishshas tani he yarshoza ekkike. <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />Izappe midaadey oonikka taas dummatidayssa hada miishsha mala qoodida gishshas izi ba nagaran oyshettana; hessaadey ba dere asaa giddofe shaaketti dhayo.<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />« ‹Intte maxa wode intte kath maxishin gaxa bolla diza kath maxopite; intte maxishin geedon attida puushechcho maxanaas guye simmofte. <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />Neni ne woyne miththa ayfe maxishin hagga giddon qotetti attidayssa woykko gaden qoqofettidayssa qora ekkanaas guye simmofa; heytantta ubbaa manqotassinne bete yidaytas aggaaga; tani GODAA intte Xoossaa.<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />« ‹Kaysotopite; as baleththofte; wordo haasayopite;<verse eid="LEV 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12" />« ‹Ta sunththan wordora caaqqofte; wordo caaqqidi intte Xoossa sunththaa tunisopite; tani GODAA intte Xoossaa.<note caller="-" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="EXO 20:7">Kessa 20:7</ref>; <ref loc="DEU 5:11">Zaare 5:11</ref>; <ref loc="MAT 5:33">Mato 5:33</ref></char></note><verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />« ‹As baleththofa; woykko asa miishshe bonqqa ekkofa; miishshe immana gaada ne ooso oosisidaades miishshaa immontta dashe ne achchan issi qammaka ayssofa.<note caller="-" style="x"><char style="xo" closed="false">19:13 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Zaare 24:14-15</ref></char></note><verse eid="LEV 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14" />« ‹Siyenna gaada tulle cayoppa; qooqey dhuphettidi kundana mala iza sinththan dhuphizaaz woththofa; ne Xoossas yayya; tani GODAA ne Xoossa.<note caller="-" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="DEU 27:18">Zaare 27:18</ref></char></note><verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />« ‹Neni pirda pirdiza wode pirda geellasoppa; manqo iza manqoteththa gishshas maadda pirdofa; gita asatas dumma bonchcho immofa; dere asaakka dumma maadda pirdofa; asa ubbaas tumu pirda pirda.<verse eid="LEV 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16" />« ‹Neni asa giddon zigirs ekkada yuuyoppa; ne shooroza hayqos gaththiza ay miishshika ooththofa; tani ne GODAA.<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />« ‹Ne isha ne wozinan ixxofa; iza gaason nees nagara gidontta mala ne shooroza hanqa.<note caller="-" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mato 18:15</ref></char></note><verse eid="LEV 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18" />« ‹As ubbaa ne nena siiqiza mala siiqa attiin ay asa bollaka ne ulon lancce oykkada halo kessofa; tani GODAA.<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="MAT 5:43">Mato 5:43</ref>; <ref loc="MAT 19:19">19:19</ref>; <ref loc="MAT 22:39">22:39</ref>; <ref loc="MRK 12:31">Mar 12:31</ref>; <ref loc="LUK 10:27">Luqa 10:27</ref>; <ref loc="ROM 13:9">Oro 13:9</ref>; <ref loc="GAL 5:14">Gala 5:14</ref>; <ref loc="JAS 2:8">Yaaqo 2:8</ref></char></note><verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />« ‹Ta azazota naagite; dumma dumma qommo meheta issi bolla gaththi mehetisofte; nam7u qommo kaththa zereth walakkidi issi bolla zeropite; nam7u qommo miishshafe dadettida may7o may7ofte.<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="DEU 22:9-11">Zaare 22:9-11</ref></char></note><verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />« ‹Issaadey hara asara giigetta uttida aylleyra laymatikko izakka ba aylleteththafe wozzettonttaaro gidikko izaadey qaxxayetto; gidikkoka iza wozzettontta gishshas nam7ayka hayqqofetto. <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />Hessa mala qoho gaththidaadey qoho gishshas shiiqiza yarshos issi dharsho gaytoteththa dunkaane penge GODAA sinth eho. <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />Qeesezikka hessaade nagara wursanaas Xoossa sinththan qoho yarshos imettida dharshoza shiishsho; izaade nagaraykka atto geetettana.<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />« ‹Intte Kanaane gelidi ayfe ayfiza mith tokkiko he ayfe ayfiza miththaya ayfe doommoosofe biidi heedzdzu layth gakkanaas immiza ayfey meetettontta digettidayssa erite; he layththatan he miththata ayfe moopite. <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />Oydanththo layththa bolla he miththaa ayfey ubbay GODAAS galatas shiishshiza yarsho gido. <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />Ichchashanththo layththan qasse miththaa ayfeza inttes miite; intte hessaththo histtiko ayfe ayfiza intte miththay woden woden inttes immiza ayfey kaseppe gede gujetti gujetti baana; tani GODAA intte Xoossaa.<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />« ‹Suuththara diza ay ashokka moopite; maroththoftenne bita bitopite.<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="GEN 9:4">Medhe 9:4</ref>; <ref loc="LEV 7:26-27">Lewe 7:26-27</ref>; <ref loc="LEV 17:10-14">17:10-14</ref>; <ref loc="DEU 12:16">Zaare 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref>; <ref loc="DEU 18:10">18:10</ref></char></note><verse eid="LEV 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27" />« ‹Intte hu7e binana garsara yuushshi aaththidi qanxxofte; intte buuchchaaka qaanththan qanxxofte.<verse eid="LEV 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28" />« ‹Intte asateththa bolla niqse cach caddofte; woykko asi hayqqiko izas mishettidi intte bolla qanxxi madunththofte; tani GODAA.<note caller="-" style="x"><char style="xo" closed="false">19:27-28 </char><char style="xt" closed="false"><ref loc="LEV 21:5">Lewe 21:5</ref>; <ref loc="DEU 14:1">Zaare 14:1</ref></char></note><verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />« ‹Biittaya laymaninne tunateththan kumontta mala ne nayo laymateththa oosos aaththa immada kawushshofa.<note caller="-" style="x"><char style="xo" closed="false">19:29 </char><char style="xt" closed="false"><ref loc="DEU 23:17">Zaare 23:17</ref></char></note> <verse eid="LEV 19:29" /><verse number="30" style="v" sid="LEV 19:30" />Ta Sambata gallassata naagite; ta keeththaa bonchchite; tani GODAA.<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="LEV 26:2">Lewe 26:2</ref></char></note><verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />« ‹Moytille haasayssizayta woykko iita ayanata haasayssizayta zore oychchofa; intte tunontta mala istta koyopite; tani GODAY intte Xoossa.<note caller="-" style="x"><char style="xo" closed="false">19:31 </char><char style="xt" closed="false"><ref loc="DEU 18:11">Zaare 18:11</ref>; <ref loc="1SA 28:3">1Same 28:3</ref>; <ref loc="2KI 23:4">2Kawo 23:4</ref>; <ref loc="ISA 8:19">Isa 8:19</ref></char></note><verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />« ‹Neeppe cimmidaade beykko ne uttidasohoppe denda eqqada bonchcha; taas Xoossas yashshateththan azazetta; tani GODAA.<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />« ‹Hara biittafe yiidi intte giddon diza asata qohopite. <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />Intte intte dere asas ooththiza mala isttaskka lo7o ooththite; intte inttena siiqiza mala isttaka siiqite; kase intteka Gibxe biittan beteta gididayssa yuushshi qopite; tani GODAA intte Xoossaa.<note caller="-" style="x"><char style="xo" closed="false">19:33-34 </char><char style="xt" closed="false"><ref loc="EXO 22:21">Kessa 22:21</ref>; <ref loc="DEU 24:17-18">Zaare 24:17-18</ref>; <ref loc="DEU 27:19">27:19</ref></char></note><verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />« ‹Maka miishshen gidiin woykko meezaanen woykko wadha miishshan as cimmofte. <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />As cimmontta tumu meezaaney, maka miishshinne mixe miishshi inttes de7o; tani inttena Gibxeppe kessida GODAA intte Xoossa.<note caller="-" style="x"><char style="xo" closed="false">19:34-36 </char><char style="xt" closed="false"><ref loc="DEU 25:13">Zaare 25:13</ref>,<ref loc="DEU 25:16">16</ref>; <ref loc="PRO 20:10">Leemi 20:10</ref>; <ref loc="EZK 45:10">Hizi 45:10</ref></char></note><verse eid="LEV 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 19:37" />« ‹Ta inttes immida ta azazotanne ta wogata ubbaa naagitenne ooththite; tani intte GODAA.› »<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s1">Azazettonttayssa Bolla Gakkiza Qixaate</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />GODAY Muse hizgides, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />«Isra7eele nayta, ‹Inttena gidikkonne intte giddon diza hara dere asatappe oonikka molooke geetetti xeygettiza eeqa xoossas ba naytappe issaa aaththi immi beettiko kumeththa Isra7eele dere asay hessaade shuchchan caddi wodho. <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />Oonikka ba naytappe issaade molookes aaththi immidi ta keeththaa tunisida gishshassinne geeshshaa sunththaa tayssa kawushshida gishshas ta hessaade bolla qixaate yeddana; hessafe guye ta izaades morkke gidada dere giddofe iza shaakka dhayssana. <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />Iza dere asay izaadey ooththoyssa ubbaaka wudettontta bessi aggikonne wodhontta aggiko, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />tani ta baggara hessaadenne izaadeso asaa qasseka taas ammanettontta molookes goynnon izara issife gididayta ubbaa bolla iita hanqo yeddana; hessafe guye heytantta tani istta istta dereza giddofe shaakka dhayssana.<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />« ‹Oonikka isttafe zore oychchanaas moytille xeygizaytakkonne marotakko biikko hessaade bolla ta iita hanqo yeddana; hessafe guye hessaade tani iza dere giddofe shaakka dhayssana.<verse eid="LEV 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7" />« ‹Intte asateth ubbaa geeshshite; dummatite; gaasoykka tani GODAA intte Xoossaa. <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />Ta azazoyo naagitenne polite; gaasoykka tani inttena taas dummasida intte GODAA.<verse eid="LEV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />« ‹Ba aawa woykko ba aayo cayizaadey hayqon qaxxayetto; izi hayqon qaxxayettizay ba mooronna.<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="DEU 21:17">Zaare 21:17</ref>; <ref loc="MAT 15:4">Mato 15:4</ref>; <ref loc="MRK 7:10">Mar 7:10</ref></char></note><verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />« ‹Issi asi hara asa machchira laymatikko he laymatida addezaranne maccassayra nam7ayka hayqon qaxxayettetto.<note caller="-" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Kessa 20:14</ref>; <ref loc="LEV 18:20">Lewe 18:20</ref>; <ref loc="DEU 5:18">Zaare 5:18</ref></char></note> <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />Issi asi ba aawa machchira laymatikko ba aawa kawushshida gishshas he laymatidayti nam7ayka hayqon qaxxayettetto; istti hayqon qaxxayettizay ba moorida mooronna. <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />Issi asi baas naaza machchira laymatikko he laymatidayti nam7ayka hayqon qaxxayettetto; asho dabboteth layman tunisida gishshas istti hayqon qaxxayettizay ba moorida mooronna.<verse eid="LEV 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13" />« ‹Issi asi maccara zin7iza mala addey addera zin7iko nam7ayka yeellachchiza miish ooththida gishshas hayqon qaxxayettetto; istti hayqon qaxxayettizay ba moorida mooronna.<verse eid="LEV 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 20:14" />« ‹Issi asi aayeyonne nayo machcho ekkiko heytantti ooththida harassiza hanoza gishshas heedzdzayka taman xuugetti hayqqetto; heytantta mala iita hanoy intte giddon polettanaas bessenna.<note caller="-" style="x"><char style="xo" closed="false">20:14 </char><char style="xt" closed="false"><ref loc="LEV 18:17">Lewe 18:17</ref>; <ref loc="DEU 27:23">Zaare 27:23</ref></char></note><verse eid="LEV 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15" />« ‹Ay asikka mehera paratikko izaadeynne he mehezi nam7ay hayqqetto.<verse eid="LEV 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 20:16" />« ‹Issi maccassi mehera paratikko izanne he iza parattida mehey nam7ay hayqqetto; istti hayqqizay ba moorida mooronna.<note caller="-" style="x"><char style="xo" closed="false">20:15-16 </char><char style="xt" closed="false"><ref loc="EXO 22:19">Kessa 22:19</ref>; <ref loc="LEV 18:23">Lewe 18:23</ref>; <ref loc="DEU 27:21">Zaare 27:21</ref></char></note><verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />« ‹Issi asi ba michchiyo, baas aayi nayo woykko aawa nayo machcho ekkiko hessi yeellachchizaaza; hessa gishshas istti bantta dere giddofe shaaketti dhayetto; ba ooththida mooro gishshas ba qixaate ekketto.<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="LEV 18:9">Lewe 18:9</ref>; <ref loc="DEU 27:22">Zaare 27:22</ref></char></note><verse eid="LEV 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 20:18" />« ‹Issi asi aginan aginan beettiza maccassa wogay beettida maccassara zin7iko izaadey izi kalloteth qaarida gishshassinne izakka ba kalloteththaa qaara bessida gishshas nam7ayka bantta dere giddofe shaaketti dhayetto.<note caller="-" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="LEV 18:19">Lewe 18:19</ref></char></note><verse eid="LEV 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19" />« ‹Ay asikka ba aawa michchira woykko ba aayi michchira zin7ofo; hessaththo ooththizaa gidikko nam7ayka bantta dabboteththa kawushshiza gishshas ba moorida mooron oyshettana.<verse eid="LEV 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 20:20" />« ‹Ay asikka ba aawa isha machchira woykko ba aayey isha machchira laymatikko ba aawa isha machcho woykko ba aayi isha yeellasida gishshas laymatidayti nam7ayka oyshettananne yeloy baynda attana.<note caller="-" style="x"><char style="xo" closed="false">20:19-20 </char><char style="xt" closed="false"><ref loc="LEV 18:12-14">Lewe 18:12-14</ref></char></note> <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />Ay asikka ba isha machcho ekkizaa gidikko hessi tuna ooththees; ba ishaza bonchcho kawushshida gishshas nam7ayka naa yelontta attana.<note caller="-" style="x"><char style="xo" closed="false">20:21 </char><char style="xt" closed="false"><ref loc="LEV 18:16">Lewe 18:16</ref></char></note><verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />« ‹Ta inttena izin gelththana Kanaane biittaya inttena cutta diggontta mala intte ta azazotanne ta wogata naagitenne polite. <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />Tani intte sinththafe dhayssiza kawoteththata lose woga kaallofte; istti heytantta ubbaa ooththida gishshas ta istta shaatettadis. <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />Ta qasse izippe maaththinne eessi goggiza he cilila biittayo inttena gelththanaas caaqqadis; izokka ta inttes immana; hankko dereppe intte taas shaakettidayta gidana mala ooththiday tana GODAA intte Xoossaa.<verse eid="LEV 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25" />« ‹Hessa gishshas intte geesh gidida mehetanne kafota tuna gididaytappe lo7eththidi shaakki erite; tani haytanti inttes tuna ga woththida mehetan, kafotaninne biitta bolla qaaxxiza ay miishshankka inttena tunisopite. <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />Intte taas dumma shaakettidayta gidite; gaasoykka tani GODAY dumma Xoossa; intte ta dereta gidana mala Ayzaabeta giddofe tani inttena taas dummasa shaakkadis.<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />« ‹Ay asikka intte giddofe moytille xeygizaa woykko marotizaade gidikko izi shuchchan cadetti hayqo; hessaththo ooththizaadey ay asikka hayqon qaxxayettizay ba ooththida mooronna› ga yoota.»<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s1">Qeeseti Kaallana Mala Imettida Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />GODAY Muses, «Aaroone naytas qeesetas, ‹Inttefe oonikka ba dabbota garsafe asi hayqqiko izaade aha bochchidi bana tunisoppo. <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />Mata dabbotappe aaya woykko aaway woykko ba nay woykko ba ishay hayqqiko, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />hessaththoka azina gelontta ixxada diza michcheya hayqqiko istta aha bochchanaas dandayees. <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />Gido attiin geloninne ekon dabbotidayti aha bochchidi bana tunisopetto.<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5" />« ‹Qeesetappe oonikka hayqqidaades mishettidi ba hu7e binana buucoppo; ba buuchcheka buucoppo; ba bollaka qaaci madunththofo.<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="LEV 19:27-28">Lewe 19:27-28</ref>; <ref loc="DEU 14:1">Zaare 14:1</ref></char></note> <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />Qeesey wurikka taas dumma gido; bantta Xoossaa sunththaa tunisopetto; gaasoykka istti Xoossas taman xuugettiza yarshonne GODAAS kaththa yarsho shiishshizayta gidida gishshas istti geesh gidetto.<verse eid="LEV 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7" />« ‹Qeese gididaadey layma maccas woykko geela7oteththi ekettida geela7oyo woykko gela kezida maccas machcho ekkofo; gaasoykka qeeseti Xoossas dummatidayta; <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />qeesey intte Xoossas kaththa yarsho shiishshizayssa gidida gishshas izi hara asappe dumma gido; tani inttena geeshshiza intte GODAY geeshsha; izikka geesh gido. <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />Qeese macca nay laymatikko iza ba aawaa kawushshida gishshas taman xuugetta hayqqu.<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />« ‹Qeeseta halaqay izi ba hu7e tiyettiza zaytey tiyettida gishshassinne qeeseteththa may7o may7ana mala dummatidaade gidida gishshas asi hayqqiko hayqqidaades izi mishettizayssa erisanaas ba hu7e binana buucoppo; ba may7oka daakkofo. <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />Ahay dizasokka izi geloppo; haray attoshin ba aawa woykko ba aayey ahakka bochchidi bana tunisoppo. <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />Iza dummasanaas tiyda Xoossa zaytey iza bolla diza gishshas qeesey Xoossa Keeththafe kezi biidi Xoossa Keeththaa tunisoppo.<verse eid="LEV 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13" />« ‹Qeesey ekkana machcha geela7o gidu. <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />Azinay hayqqidaaro woykko gela kezidaaro woykko layma maccas ekkofo; gelontta geela7o xalla ba dere asaa giddofe doori ekko. <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />Hessaththo histtontta aggiko izi ba dere giddon ba nayta tunisana; iza dumma shaakkida GODAY tana Xoossaa› ga yoota» gides.<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />GODAY Muse hizgi azazides; <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />«Aaroones, ‹Ne qommotappe iza asateththaa bolla wosoy dizaadey oonikka taas yarsho shiishshofo; hayssi ha wogay buro sinththafe yaana yeletan ubbaan naagetti de7o. <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />Pace asateththi dizaadey oonikka hessika qooqey woykko wobbey woykko medho iitay woykko asateththay borsizaadey, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />kushey woykko tohoy silidaadey, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />zokko quunay woykko dinkey, ayfey sakkizaadey woykko iza bolla uzazizaazi dizaadey woykko shuufay kaththa yarsho taas shiishshanaas bessenna. <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />Aaroone zereth kumeththaa giddofe asateththa bolla wosoy diza asi oonikka xuugettiza yarshonne yarsho ba GODAAS yarshanaas yooppo. <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />Hessa mala asi nam7u qommo kaththa yarshota maanaas dandayees; heytikka dummatida kaththinne keehi dummatida yarsho kaththa. <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />Gidikkoka iza asateththan borey diza gishshas ta keeththaa tunisontta mala izaadey gede yarsho yarshizaso woykko gede magalashakko shiiqoppo; gaasoykka istta dumma ooththa shaakkiday tana Xoossa› gaada yoota.» <verse eid="LEV 21:23" /><verse number="24" style="v" sid="LEV 21:24" />Museykka hessa ubbaa Aaroonessinne Aaroone naytas kumeththa Isra7eele dere asaas yootides.<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />GODAY Muse hizgides, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />«Aaroonessinne iza naytas, ‹Intte harappe dumma gidida ta sunththaa tunisontta mala Isra7eele nayti taas dummasidi shiishshiza yarsho ubbaa bonchchora ekkidi geeshshateththan naagite; tani GODAA.<verse eid="LEV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3" />« ‹Intte zereththafe tunidaadey Isra7eele nayti taas dumma shaakki immida miish xalateththan bochchidaadey ta sinththafe dhayana; hayssi ha wogay hayssafe guye sinththara yaana yeleta ubbaan naagetto; tani GODAA.<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />« ‹Aaroone zereththatappe ay asikka iza bolla asappe asan aadhdhiza galba hargey dizaadey woykko iza asateththafe goggi keziza miishshi dizaadey oonikka geeyana gakkanaas Xoossas dummatida miish mooppo; ahay bochchiin tunida miish bochchidaadey woykko iza bollafe zereththa haaththi xokettizaade bochchidaadey, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />hessaththoka biittara gooshettizaytanne ay miishshankka tunida as bochchidaadey, <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />hessa mala ay tuna miishshika bochchidaadey omars gakkanaas tuna gidees; hessafe guye izi ba bolla haaththan meecettontta dishe Xoossas dummatida kath mooppo. <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />Arshey wullidaappe guye qasse izi geesh gidees; hessafe guye dumma gidida kaththa yarshoza izas quma gidida gishshas maanaas dandayees. <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />Bawuti hayqqidaazinne do7ay wodhida mehe asho mooppo; izi hessa mizaaz gidikko tunees; tani GODAA.<verse eid="LEV 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9" />« ‹Qeeseti tani isttas immida wogaa naagetto; istti naagontta aggiko geesh gidida ta azazotas azazettontta ixxida gishshas isttas qoho gidiin istti hayqqana; istta dummasa shaakkiday tana GODAA.<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />« ‹Taas dummatida yarshofe maanaas dandayzay qeesetanne isttaso as xalla attiin hara asi izappe mooppo; qeesera imaththi woykko oosos qaxxarettidi izara dizaadeyka mooppo. <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />Gido attiin qeesey ba miishshan shammida aylley woykko soon yelettida aylley qeeseza gishaappe mo. <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />Qeese gidontta hara as gelida qeeseza naya Xoossas dummatida yarshofe muuppu. <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />Gido attiin naa yelontta dishin izi azinay hayqqidaara woykko ba azinappe anjjettada ba aawa soo simmada diza qeese naya kase iza naateteththa wode ooththiza mala ba aawa gishaappe mu; gidikkoka qeeseso asappe attiin hara asi dummatida yarsho kaththaafe mooppo.<verse eid="LEV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14" />« ‹Qeeseso as gidonttaadey oonikka erontta dishe GODAAS dummatidi imettida miish miikko he izi midayssa kumeththa wogaa xeetappe nam7u kushe gujjidi qeesezas qanxxo. <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />Isra7eele nayti Xoossas immiza dumma yarshota qeeseti tunisanaas bessenna. <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />Hessika izappe maanaas bessonttaades qeeseti immiko he midaades mooro gididi izaade bolla hanqo gaththana; imotata ubbaa taas dummasiday tana GODAA› ga yoota.»<verse eid="LEV 22:16" /></para>
  <para style="s1">Godaas Shiiqanaas Bessontta Yarsho</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />GODAY Muse hizgides, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />«Aaroones iza naytassinne Isra7eele dere ubbaas, ‹Isra7eele as gididay woykko Isra7eele nayta giddon diza imaththa asi adina gaththanaas woykko izi coo ufayssan mela immiza xuugettiza yarsho shiishshiko, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />iza yarshoy ekettana mala issi borey iza bolla baynda korma boorappe, dharshofenne deysha orgefe gido. <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />Iza bolla wosoy diza mehe intte shiishshiko GODAY hessa ekkenna.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="DEU 17:1">Zaare 17:1</ref></char></note><verse eid="LEV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 22:21" />« ‹Qasse oona gidikkoka ba adina gaththanaas issifeteththa yarsho GODAAS yarshiza wode woykko ba dosan ba mehetappe kiyateththa imota immizaa gidikko he imotaa ekkana mala izi immiza meheza bolla aykko wosoy bayndaaz gido. <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />Qooqe woykko meqo woykko qiisha woykko giiyza madunththara dizaa woykko gaaranda woykko shattora diza mehe GODAAS yarsho shiishshofa; hessantta mala mehe yarsho yarshizasozan xuugettiza yarsho histta yarshofa. <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />Izas medheteththi wogay baynda adussa woykko qaanth gidida mehe ba dosan immiza kiyateththa imota gididi shiiqanaas dandayees; gido attiin adina gasos shiishshanaas dandayenna. <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />Sangettida woykko dhiiqettida mehe GODAAS yarsho shiishshofte; intte biittan heytantta mala yarshofte. <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />Allaga asappe imettida mehe Xoossas yarsho shiishshofte; heytantta mala meheti borey diza mala qoodettiza gishshas istti ekkettettenna› ga yoota.»<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />GODAY Muses hizgides, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />«Miiza mari woykko dorsa laaqqay woykko deysha laaqqay yelettiko laappun gallas gakkanaas ba aayppe shaakettofo; gido attiin osppunththa gallassafe oykkidi xuugettiza yarshos shiiqanaas dandayees. <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />Miiz izi marara, dors izi laaqqara issi gallas yarshos shukkofte.<verse eid="LEV 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29" />«Intte GODAAS galata yarsho yarshiza wode intte shiishshiza galatazi ekettana mala ooththi shiishshite. <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />Intte shiishshidayssafe aykkoka wontos ashshontta he gallas ubbaa michchite; tani GODAA.<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />«Intte ta azazota naagitenne ooththite; tani GODAA. <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />Ta geeshsha sunththaa tunisopite; ta geeshshateththaa kumeththa Isra7eele asay eridi tana bonchcho; inttena dummasiday tana GODAA. <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />Intte Xoossaa gidanaas inttena Gibxe biittafe kessiday tana; tani GODAA intte Xoossaa.»<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s1">Ayhudati Bonchchiza Ba7aale</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />GODAY Muse hizgides, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />«Isra7eele asaas Dumma shiiqo gi awajjidi intte bonchchanaas bessiza doorettida ba7aaleti hayssafe kaalli dizayta;<verse eid="LEV 23:2" /></para>
  <para style="s1">Sambata</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3" />«Intte inttes ooththanaas usuppun gallassati deettes; laappunththa gallassay gidikko inttes shempiza Sambata gallassa; he gallas intte Xoossa goynnanaas shiiqite attiin ay oosokka ooththofte; intte dizaso ubbaan hessi intte Xoossa bonchchana Sambata gallassa.<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="EXO 20:8-10">Kessa 20:8-10</ref>; <ref loc="EXO 23:12">23:12</ref>; <ref loc="EXO 31:15">31:15</ref>; <ref loc="EXO 34:21">34:21</ref>; <ref loc="EXO 35:2">35:2</ref>; <ref loc="DEU 5:12-14">Zaare 5:12-14</ref></char></note><verse eid="LEV 23:3" /></para>
  <para style="s1">Paaziga Ba7aalenne Ukeththa Ba7aale</para>
  <para style="r">(<ref loc="NUM 28:16-25">Tay 28:16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />«Isttas wodhdhida woden geeshsha shiiqo ooththi awajjidi intte bonchchanaas bessiza GODAA ba7aaleti hayssafe kaallizayta, <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />GODAY izan bonchchettiza paaziga ba7aaley koyro aginay gelida tammanne oydanththo gallas arshey wulliin gadey lem7i lem7ishin oykettees.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">Kessa 12:1-13</ref>; <ref loc="DEU 16:1-2">Zaare 16:1-2</ref></char></note> <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />He aginazan tammanne ichchashanththo gallas ukeththa ba7aaley oykettees; hessafe guye laappun gallas gakkanaas irshoy gelontta uketh miite. <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />He gallassatappe koyro gallas Xoossa goynnanaas shiiqite; he gallas intte ooso ooththofte. <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />Laappun gallas gakkanaas xuugettiza yarsho GODAAS shiishshite; intte ooso aggidi laappunththa gallas GODAA goynnanaas shiiqite.»<note caller="-" style="x"><char style="xo" closed="false">23:6-8 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">Kessa 12:14-20</ref>; <ref loc="EXO 23:15">23:15</ref>; <ref loc="EXO 34:18">34:18</ref>; <ref loc="DEU 16:3-8">Zaare 16:3-8</ref></char></note><verse eid="LEV 23:8" /></para>
  <para style="s1">Kaththa Xeera Ba7aale Gallas</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />GODAY Muse hizgides, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />«Isra7eele asaas tani inttes immiza biittaa gelidi intte kath shiishshiza wode kaththa xeera qeesekko ehite. <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />GODAA sinththan intte shiishshizayssi ekettana mala qeesezi qasse kaththaa xeeraa ekkidi yaanne haa qaaththiza yarsho histti Xoossas shiishsho; qeesezi he xeera kaththaa yaanne haa qaaseththiza yarsho histti shiishshanaas bessizay Sambata gallassafe wonteththa gallas gido. <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />Intte he yarsho shiishshiza gallas iza bolla borey baynda issi layththa dharsho laaqqa xuugettiza yarsho ooththidi issi bolla Xoossas shiishshite. <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />Izara issife wogara miththa zayten munuqettida nam7u kilo gidiza liiqo dhiille kaththa yarsho histti shiishshite; hessika iza sawoy GODAA ufayssiza xuugettiza yarsho gidana; izara issife issi litiro gidiza woyne ushshu imota shiishshite. <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />Intte heyta GODAAS immanaappe koyro gakkida kaththa ayfe qaye gidiin woykko shaash woykko uketh uukkidi moopite; hayssa ha wogaza intte dizaso ubbaan guyeppe yaana intte yeletas eqqi diza mernaa woga gido.<verse eid="LEV 23:14" /></para>
  <para style="s1">Kaththa Shiisho Ba7aale</para>
  <para style="r">(<ref loc="NUM 28:26-31">Tay 28:26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />«Intte GODAAS yaanne haa qaaseththi shiishshiza yarsho yarshida Sambata gallassa wonteththafe doommidi laappun Sambata qoodite; <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />Laappunththa sambatappe guye ichchash tammanththo gallas qasseka hara ooraththa kaththa yarsho GODAAS shiishshite. <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />Nam7u kilo gidiza liiqo dhiille intte sooppe irshon munuqetti uukettida nam7u uketh yaanne haa qaaseththiza yarsho histti ekki yiite; hessika oorath shiiqiza kaththaa gishshas Xoossas shiiqiza kaththa yarsho gido. <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />He ukeththaarakka issife istta bolla wosoy baynda issi layth gidiza laappun dharsho laaqqata issi korma boorara nam7u dharshota shiishshite; kaththa yarshozaranne woyne ushsha yarshozara issife GODAAS xuugettiza yarshonne sawo tunnu giza yarsho histti shiishshite.<note caller="-" style="x"><char style="xo" closed="false">23:15-18 </char><char style="xt" closed="false"><ref loc="EXO 23:16">Kessa 23:16</ref>; <ref loc="EXO 34:22">34:22</ref>; <ref loc="DEU 16:9-12">Zaare 16:9-12</ref></char></note> <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />Qasseka nagara gishshas shiiqiza yarshos issi deysha orge, issifeteththa yarshos issi layth dharsho laaqqa nam7ata yarshos shiishshite. <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />Qeesey ukeththaa nam7u laaqqatara yaanne haa qaaseththidi GODAAS dumma yarsho histti shiishsho; hessika qeeseta gisha gido; heyti he imotati harappe dumma imota. <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />He gallas awajja awajjidi GODAA goynnanaas issi bolla shiiqite attiin hara ooso ooththofte; hayssi intte dizaso ubbaan inttefe guyera yiza yeletas mernaas eqqi diza woga gido. <verse eid="LEV 23:21" /><verse number="22" style="v" sid="LEV 23:22" />Intte intte biittan kath shiishshiza wode dhassa bolla diza kaththaa maxopite; maxishin guyen attidayssa maxanaas guye simmofte; guyen attidayssi manqotassinne hara biittafe bete yida asatas atto; tani GODAA intte Xoossaa.»<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="LEV 19:9-10">Lewe 19:9-10</ref>; <ref loc="DEU 24:19-22">Zaare 24:19-22</ref></char></note><verse eid="LEV 23:22" /></para>
  <para style="s1">Zayey Punettiza Ba7aale</para>
  <para style="r">(<ref loc="NUM 29:1-6">Tay 29:1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />GODAY Muses hizgides, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />«Isra7eele asaas laappunththa aginay gelida koyro gallassay inttes shempo gallas gido; he wode zayey punettishin intte GODAA goynnanaas shiiqiza dumma shiiqo gido. <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />He gallas GODAAS taman xuugettiza kaththa yarsho shiishshite attiin he gallas aykkoka ooththofte.»<verse eid="LEV 23:25" /></para>
  <para style="s1">Nagara Wurso Gallas</para>
  <para style="r">(<ref loc="NUM 29:7-11">Tay 29:7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />GODAY Muses hizgides, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />«Laappunththo aginay gelidaappe guye tammanththa gallassay nagarappe maareteththa gallassa; he gallas ay kaththika moopite; GODAA goynnanaas shiiqite; Xoossas taman xuugettiza yarsho shiishshite. <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />He gallassay GODAA intte Xoossa sinththan asa nagara wurso gallas gidida gishshas he gallas aykkoka ooththofte. <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />He gallas banateththaa kawushshidi maarettontta ay asikka deraa giddofe shaaketti dhayo. <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />He gallas ay ooso gidiin ooththizaade tani iza iza deraa giddofe shaakka dhayssana; <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />Hessa gishshas he gallas intte ay oosokka ooththofte; hayssi ha wogazi intte dizaso ubbaan inttefe guye yaana intte yeletaas eqqi diza mernaa woga gido. <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />He aginay gelida uddufunththo gallassa omarsafe biidi tammanththo gallassa omars gakkanaas inttenateththaa kawushshidi he gallassaa Sambata histti bonchchite.»<note caller="-" style="x"><char style="xo" closed="false">23:26-32 </char><char style="xt" closed="false"><ref loc="LEV 16:29-34">Lewe 16:29-34</ref></char></note><verse eid="LEV 23:32" /></para>
  <para style="s1">Daase Ba7aale</para>
  <para style="r">(<ref loc="NUM 29:12-40">Tay 29:12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />GODAY Muses hizgides, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />«GODAAS Daase ba7aaley laappunththa aginay gelida tammanne ichchashanththo gallassafe doommidi laappun gallas gakkanaas bonchchetto. <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />He gallassatappe koyro gallas GODAA goynnanaas shiiqite attiin ay oosokka ooththofte. <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />Laappun gallassatan issaan issaan GODAAS xuugettiza yarsho shiishshite; osppunththa gallas qasseka GODAA goynnanaas shiiqite; GODAAS xuugettiza kaththa yarsho yarshite; he gallassay intte shiiqoza wursiza gallas gidida gishshas he gallas aykkoka ooththofte.<note caller="-" style="x"><char style="xo" closed="false">23:33-36 </char><char style="xt" closed="false"><ref loc="DEU 16:13-15">Zaare 16:13-15</ref></char></note><verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />«Intte taman xuugettiza yarshonne kaththa yarsho qasse hara yarshota ubbaanne ushsha yarsho koshshiza keena woththida gallassan GODAAS shiishshanaas intte geeshsha shiiqo ooththidi awajjanaas bessiza GODAAS doorettida ba7aaleti haytantta. <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />Hayti ha yarshoti GODAA Sambata gallassatan intte shiishshizaytappe Xoossas immiza imotatappe adina gaththizaytappenne intte intte dosan coo immizaytappe bollara gujjidi intte immiza imotata.<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />«Intte kath shiishshidaappe guye laappunththa aginay gelida tammanne ichchashanththa gallas koyrora hayssa ufayssa ba7aaleza GODAA sinththan laappun gallas gakkanaas bonchchite; koyro gallassinne osppunththa gallassay inttes dumma shemppo gallas gido. <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />He koyro gallas intte biittan kaxxiza lo7o miththa ayfeppe, zamba hayth, cilila miththa hagganne haaththinaage<note caller="+" style="f"><char style="fr" closed="false">23:40 </char><char style="fqa" closed="false">Haaththinaage: </char><char style="ft" closed="false">Haaththinaage gizayssa issi issi bagga gamoththo qaalan haaththinaago geetettees.</char></note> miththa hagga oykkidi GODAA intte Xoossaa sinththan ufayettishe laappun gallas gakkanaas ba7aale ooththite. <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />Hayssaka layththan layththan laappunththa aginan laappun gallas gakkanaas GODAA sinththan bonchchite; hayssi ha wogay inttes naa naa gakkanaas mernaa woga gidi bonchchetto. <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />Kumeththa Isra7eele derey laappun gallas gakkanaas daasen utto. <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />Hayssanka tani Isra7eele nayta Gibxe biittafe kessida wode istti daasen uttana mala ta ooththidayssa inttefe guye yiza yeletay erana. Tani GODAA intte Xoossaa.»<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />Musey hayssaththo ooththidi GODAA ba7aaleta bonchchiza wogaa Isra7eele asaa erisides.<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s1">Xomppeta Gishshas Naageteth</para>
  <para style="r">(<ref loc="EXO 27:20-21">Kessa 27:20-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />GODAY Muses hizgides, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />«Dunkaanezan pacey baynda poo7ana mala ooththanaas wogara miththafe gum7i xillisi kessida zayte Isra7eele dere asay nees ehana mala azaza. <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />Aarooney omars omars xomppeza oyseththo; hessika Gaytoteththa Dunkaaneza giddon diza Caaqo Qaala Taabotazappe sinththa baggara diza magalashaappe kare baggara GODAA sinththan gadey wonttana gakkanaas poo7ishe aqo; hayssi ha wogazi sinththafe yaana yeletaas mernaa woga gido. <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />Aarooney he xomppeta woththiza walakay baynda worqqafe oosettida ballaza bolla diza xomppeti pacey baynda GODAA sinththan poo7ana mala naago.<verse eid="LEV 24:4" /></para>
  <para style="s1">Xoossas Shiiqiza Kaththa Yarsho</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />«Tammanne nam7u kilo gidiza liiqo dhiille ekkada tammanne nam7u uketh uukka. <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />Ukeththatappe usuppunata bollara walakay baynda worqqan tiyettida xaraphpheeza bolla issi baggara woththa; qasse hankko usuppunata hankko baggara diza maaddaa bolla maaran maaran woththa.<note caller="-" style="x"><char style="xo" closed="false">24:5-6 </char><char style="xt" closed="false"><ref loc="EXO 25:30">Kessa 25:30</ref></char></note> <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />GODAAS taman xuugetti yarshettiza kaththa yarsho gididayssa qofsanaas muuruta exaane nam7u baggarakka woththa. <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />Hayssa ha ukeththaza Sambatan Sambatan ubba wode Aarooney GODAA sinththan Isra7eele asaa gishshas woththo; hayssi Isra7eele asay pacey baynda ooththana mala bessiza caaqo qaala. <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />Ukeththay Aaroonessinne iza zereththatas gisha gido; istti ukeththaa GODAAS dummatidason metto; hessika GODAAS taman xuugetti shiiqiza yarshotappe keehi dummatida Aaroonessinne iza zereththatas imettida gisha gido.»<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 12:4">Mato 12:4</ref>; <ref loc="MRK 2:26">Mar 2:26</ref>; <ref loc="LUK 6:4">Luqa 6:4</ref></char></note><verse eid="LEV 24:9" /></para>
  <para style="s1">Qoho Gaason Gakkiza Qixaate</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />Aayi baggara Isra7eele, aawa baggara Gibxe dere as gidida issaadey dees; izikka issi gallas ba diza heeran diza issi Isra7eele as gididaarira ooyettides. <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />He aayey baggara Isra7eele as gididayssi ooyettishe GODAA sunth cayides; histtiin izaade Musekko ehida; he addeza aaya Daane baggafe gidida Dibraye naa Shalomito geetettawus. <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />Istti iza bolla ay qixaate yegganaas bessizaakko GODAY isttas yootana gakkanaas iza qasho keeththan yeggida.<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />GODAY Muses hizgides, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />«He addeza asay dizasoppe gede haraso kessa; izi Xoossa cayishin siyida ubbay hessaadey mooro ooththidayssa markkattanaas issoy issoy ba kushe he addeza hu7e bolla woththo; hessafe kaallidi kumeththa Isra7eele derey iza shuchchan caddi wodho. <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />Tana Xoossaa cayida ay asikka hessaththoka ba qixaate ekko. <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />GODAA cayida ay as gidiinkka derey ubbay iza shuchchan caddi wodho; Isra7eele as gidiin woykko Isra7eele dere garsan diza hara dere as gidiin GODAA cayidaadey shuchchan cadetti hayqqo.<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />«Ase wodhidaadey oonikka hayqon qaxxayetto.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="EXO 21:12">Kessa 21:12</ref></char></note> <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />Asa mehe wodhidaadey iza mala mehe qanxxo; hessi he waagazi shemppo gishshas shemppo qanxxiza woga.<verse eid="LEV 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19" />«Ay asikka hara asa bolla qoho gaththiko izaadey qoho gaththidayssa mala qohoy he gaththidaade bolla gakko. <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />Meqeth menththidaades meqeththi meqqo; ayfe toyssidaades ayfey to7o; ach menththidaades achchi meqqo; hara asa bolla ay qohokka gaththidaades izi gaththida qohoza malay iza bolla gakko.<note caller="-" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="EXO 21:23-25">Kessa 21:23-25</ref>; <ref loc="DEU 19:21">Zaare 19:21</ref>; <ref loc="MAT 5:38">Mato 5:38</ref></char></note> <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />Mehe wodhidaadey mehe qanxxo; ase wodhidaadey gidikko hayqon qaxxayetto. <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />Hayssi wogazi inttes Isra7eele naytas gidiin woykko intte giddon diza hara dere asaa ubbaassa; gaasoykka tani GODAA intte Xoossaa.»<note caller="-" style="x"><char style="xo" closed="false">24:22 </char><char style="xt" closed="false"><ref loc="NUM 15:16">Tay 15:16</ref></char></note><verse eid="LEV 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23" />Musey hessa ubbaa derezas yooti polidaappe guye he Xoossaa cayida addeza asi dizasoppe haraso kessidi shuchchara caddi wodhida; hessaththoka Isra7eele asay GODAY Muse azazida mala ooththida.<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s1">Laappunththa Layththa Shempo</para>
  <para style="r">(<ref loc="DEU 15:1-15">Zaare 15:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />GODAY Siina zuma bollan Muse hizgi azazides, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />«Ne Isra7eele asaas, ‹Tani inttes immiza biitta intte geliza wode laappunththa laappunththa layththan biitta goyontta shaachchi shempison Xoossa bonchchite. <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />Usuppun layath kumeth goyitenne zerite; woyne miththay lo7eththi ayfana mala qirxite; ayfekka maxi shiishshite. <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />Gido attiin laappunththa layththay taas Xoossaas dumma gidiin biittay shemppo demmiza layth gido; he layth biitta goyopite; woyne miththayka ayfana mala qirxofte. <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />Intte zerontta azabba caarida kaththaa inttes maxi shiishshofte; he layththay biittaya mulera shempiza layththa. <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />He layth iza aykkoka goyontta aggikokka biittaya inttes intte aylletasinne inttes miishshara ooththizaytas; qasseka hara dereppe yiidi inttenara diza hara yeletatas mizaaz gido. <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />Intte mehetassinne intte biitta bolla diza do7atassara meetettizaaz biittaya immana; he iza immizayssi ubbay isttas meetettizaaz gido.<note caller="-" style="x"><char style="xo" closed="false">25:1-7 </char><char style="xt" closed="false"><ref loc="EXO 23:10-11">Kessa 23:10-11</ref></char></note><verse eid="LEV 25:7" /></para>
  <para style="s1">Wozzo Layth</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />« ‹Laappunto laappun layth qooda; he layththata qooday oyddu tammanne uddufun layth gidees; <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />Laappunththo aginay gelidaappe tammanththa gallas bonchchettiza nagarappe maareteththa gallas kumeththa biittaa bolla zaye zayanaade yeddite. <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />Hessaththoka ichchash tammanththo layththaa dummasi shaakkidi biittay bolla dizaytas ubbaas wozzeteth awajjite; hayssafe kase bayzettida gadey kase bayzidaades woykko izaade qommos simmo; aylleteththan bayzettida aylleyka kase ba asaakko simmo. <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />He layth goshshe goyidi zereth zeropite; zereth zerontta coo azabba kaxxida kath woykko qirxettontta ayfida woyne miththa ayfe maxi shiishshofte. <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />He layththay kumeth inttes dumma shaakettida layth gido; kase intte zerontta coo barkka kaxxida kath xalla miite.<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />« ‹Hayssafe kase bayzettida gadey ubbay he wozzo layththan gadaades simmo. <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />Hessa gishshas ne asho gidida Isra7eele asaa neni gade bayzidaaz gidikko woykko ne haa nees shammidaaz gidikko gene ooso ooththofa. <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />Gadeza waagay heregettanaas bessizay sinththafe biittay simmiza layththay gakkanaappe kase he gadey immana dandayza kaththa qoppi hereganaas bessees. <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />Layththay daro gidikko heregaykka daro gido; layththay guuth gidikko heregaykka guuth gido; gadey bayzettiza waagay gadezi immiza kaththaa mala gido. <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />Issi Isra7eele asi hara Isra7eele as qohoppo; intte intte Xoossaas yayyite; tani GODAA intte Xoossaa.<verse eid="LEV 25:17" /></para>
  <para style="s1">Laappunththa Layththan Yaana Meto</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />« ‹Intte intte biittaa bolla saron de7ana mala Xoossa woga ubbaa bonchchite. <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />Biittaya inttes gidana kath immana; intteka izippe kallana gakkanaas maana; saroteththanka de7ana.<verse eid="LEV 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 25:20" />« ‹Gido attiin laappunththa layththan goshshe goyonttanne kath zerontta maxontta ay maanee?› giidi oychchiza asi dontta aggenna. <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />Usuppunththa layththatan biittayo anjjana; histtiko iza inttes heedzdzu layththas gidana kath immana. <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />Osppunththa layththankka goshshe goyishe intte kase shiishshida kaththaa maana; hessa he kaththaa uddufunththa layththan bone kath intte shiishshana gakkanaas izappe maana.<verse eid="LEV 25:22" /></para>
  <para style="s1">Bayzettida Aqota Wozzo</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />« ‹Gadey wozzettontta mala bayzanaas bessenna; gaasoykka biittay taassa attiin iza inttes gidukku; intte imaththatanne bete asata mala.<verse eid="LEV 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 25:24" />« ‹Biittay bayzettiko he bayzizaadey he biittaa zaari wozzanayssi erettidaaz gido. <verse eid="LEV 25:24" /><verse number="25" style="v" sid="LEV 25:25" />Isra7eele asaappe issaadey metoppe attanaas ba gade bayzikko izas matiza dabboy he bayzettida gadaa wozzo. <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />Izas wozziza mata dabboy dontta aggiko izaadey gam7ishe miishshe demmidi zaari wozzanaas dandayees. <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />Hessa wozzanaas izi dandayza wode ba bayzida wodezappe doommidi diza layththaa qoodidi attida layththata miishshaa shammidaades zaaro; hessafe guye kase ba gadeza zaari ekko. <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />Qasseka gadeza wozzanaas gidiza miishshi izas dontta aggiko izi bayzida gadey wozzettiza layththay gakkanaas shammidaade kushen de7o; wozzettiza layththay gakkishin gadey gadaades simmo; gadaadeyka gede ba gaden simmo.<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />« ‹Issi asi gimbey gimbettida katama giddon diza keeth bayzidaa gidikko izi bayzidaappe issi layththa garsan zaari wozzanaas dandayees; izi zaari wozzana dandayzay issi layththa garsan xalla. <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />Gidikkoka issi layththa garsan zaari wozzanaas dandayontta aggiko hara wode zaari wozzisiza wogay izas deenna; keeththay shammidaades woykko iza naa naas haaro gidi attees; bayzettida miishshay wozzettiza layththankka bayzidaades keeththay simmenna. <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />Gimbey gimbettontta coo dere garsan diza keeththati bayzettidaappe guye goshsha biitta mala qoodettidi keeththa goday zaari wozzanaas dandayees.<verse eid="LEV 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32" />« ‹Gido attiin Lewe nayti baas imettida katamatan diza ba keeththata ba koyida ay wodekka wozzanaas dandayeettes. <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />Hayti katamatan issi Lewe qommoy keeth bayzikko qasse zaari wozzanaas izi dandayontta aggiko bayzettida miish wozzo layththan izas simmo; gaasoykka Lewe qommoti ba katamatan keexxida keeththati Isra7eele nayta giddon ay wode gakkanaaska isttassa. <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />Qasseka istti katamata yuushon diza mehey heemettiza biittay mulekka bayzettofo; he biittay ay wodekka isttassa.<verse eid="LEV 25:34" /></para>
  <para style="s1">Manqotas Tal7e Imo Woga</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />« ‹Ne bagga Isra7eele asaappe issaadey manqidi bana ayssanaas dandayonttaade gidikko imaththa gidida woykko bete asi ne achchan daana mala ne maaddizayssaththo izakka maadda.<note caller="-" style="x"><char style="xo" closed="false">25:35 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">Zaare 15:7-8</ref></char></note> <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />Ne bagga gidida Isra7eele asi nenara daana mala izappe dich mooppa; ne Xoossas yayya. <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />Ne izas tal7e immiko izappe dich oychchofa; ne kath izas wodhera bayzoppa.<note caller="-" style="x"><char style="xo" closed="false">25:37 </char><char style="xt" closed="false"><ref loc="EXO 22:25">Kessa 22:25</ref>; <ref loc="DEU 23:19-20">Zaare 23:19-20</ref></char></note> <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />Nena Kanaane biitta laatissanaas nees GODAA gidanaas Gibxe biittafe kessida Xoossay tana.<verse eid="LEV 25:38" /></para>
  <para style="s1">Aylleteththafe Wozzeteth</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />« ‹Ne bagga gidida Isra7eele asaappe issaadey manqoteththaafe dendidayssan aylle mala nees haarettanaas bana bayzikko ne iza aylle mala oosisoppa. <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />Ne iza ne matan diza imaththa mala woykko miishshas ooththiza oosanchcha mala qooda; izikka ichchashu tammu layth gakkanaas nees ooththo. <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />Hessafe guye ba naytara neeppe shaaketti gede baso asakkonne ba duussaso simmo. <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />Isra7eele asaa ta Gibxe biittafe kessida ta oosanchchata gidida gishshas istti aylle mala bayzettofetto. <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />Ne istta wolqqara haaroppa; ne Xoossaas yayya.<verse eid="LEV 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44" />« ‹Nees attumanne macca aylleti de7ana mala koykko ne yuushon diza Ayzaabeta giddofe shamma ekka. <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />Qasseka intte biittan diza bete asatappenne intte biittan yelettida asatappe shammanaas dandayeeta; istti inttes haaro gidetto. <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />Heytan intte intte nayta laatissanaas dandayeeta; istti de7iza layththa ubbaan intte naytas ooththizayta gidana; intte qommo gidida Isra7eele as wolqqara haaropite.<note caller="-" style="x"><char style="xo" closed="false">25:39-46 </char><char style="xt" closed="false"><ref loc="EXO 21:2-6">Kessa 21:2-6</ref>; <ref loc="DEU 15:12-18">Zaare 15:12-18</ref></char></note><verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />« ‹Intte giddon diza hara dere asaappe issaadey dure gidikko intte bagga gidida Isra7eele naytappe manqo gididay bana hara dere dures woykko izaso asaappe issaades bana aylleteththas aaththi immiko, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />izi bayzettidaappe guye simmidi nam7anththo wozzettanaas dandayees; hessa gishshas iza ishatappe issaadey iza wozzo. <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />Iza aawaa ishay woykko iza aawaa isha nay woykko izas mata dabbotappe issaadey iza zaari wozzanaas dandayees; izaadey baas gidiza miishshe shiishshidaa gidikko ba miishshara wozzettanaas dandayees. <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />Izi bana haaridaadera issife gididi izi bana barkka bayzida layththaafe doommidi wozzeteththa layththaa gakkanaas diza layththaa qoodo; iza wozzisiza miishshay he layththata qooda gido; izi bana haarizayssara gam7ida wode waagay issi asi ooththidi demmiza kira miishsha keena gido. <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />Wozzo layththay gakkanaas buro daro layththati attidaa gidikko ba bayzettida waagaappe he attida layththaa qoodan bana wozziza waagaa qanxxo. <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />He attida layththati guuth gidikko ba haarettiin attida layththaa qoodidi bana wozziza waaga qanxxo. <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />Izi layththafe layth gakkanaas une<note caller="+" style="f"><char style="fr" closed="false">25:53 </char><char style="fqa" closed="false">Une: </char><char style="ft" closed="false">Une gizayssa kira gi go7ettana dandayettees.</char></note> ooththiza asa mala bana haaridaadera de7oppe attiin iza wolqqara haaranaas bessenna.<verse eid="LEV 25:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54" />« ‹Hessaththo hanidi wozzettanaas dandayontta aggiko sinththafe yaana aylleteththafe wozzettiza layththan izinne iza nayti mela yedettetto. <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />Isra7eele asay taas aylletanne tani Gibxe biittafe kessida ta oosanchchata; tani GODAA intte Xoossaa.<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s1">Azazeteththan Beettiza Anjjo</para>
  <para style="r">(<ref loc="DEU 7:12-24">Zaare 7:12-24</ref>; <ref loc="DEU 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />« ‹Intte izas goynnana mala inttes aykkoka eeqa medhdhofte; hessaththoka misle woykko hawulte woykko shuchchafe masetti kezida tuus essofte; tani GODAA intte Xoossaa.<note caller="-" style="x"><char style="xo" closed="false">26:1 </char><char style="xt" closed="false"><ref loc="EXO 20:4">Kessa 20:4</ref>; <ref loc="LEV 19:4">Lewe 19:4</ref>; <ref loc="DEU 5:8">Zaare 5:8</ref>; <ref loc="DEU 16:21-22">16:21-22</ref>; <ref loc="DEU 27:1">27:1</ref></char></note><verse eid="LEV 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 26:2" />« ‹Sambata gallassata naagite; ta keeththaa bonchchite; tani GODAA.<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />« ‹Intte ta wogan diikkonne ta azazotakka naagikko, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />tani inttes ira wodera bukisana; biittayakka kath darsa immana; ayfe immiza miththatikka darssi ayfana. <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />Intte kaththay keehi daro gidida gishshas intte buro shiisho bolla dishin woyne miththa ayfe qanxxiza wodey gakkana; intte woyne miththa ayfe qanxxidi shiishshi wursontta dishin kath zeriza wodey gakkana; intte kath kalli maana; intte biittankka saroteththan daana.<note caller="-" style="x"><char style="xo" closed="false">26:3-5 </char><char style="xt" closed="false"><ref loc="DEU 11:13-15">Zaare 11:13-15</ref>; <ref loc="DEU 28:1-14">28:1-14</ref></char></note><verse eid="LEV 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6" />« ‹Intte biittas saroteth immana; oonaska babbontta intte woppu gi aqana; iita do7ata intte dereppe ta diggana; hayssafe guye intte deren olay deenna. <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />Intte intte morkketa gooddana; isttika intte sinththan mashshan hayqqana. <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />Inttefe ichchash asi xeetu as, xeetay qasse 10,000 as gooddana; intte morkkey intte sinththan mashshan wurana.<verse eid="LEV 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9" />« ‹Tani ta sinth intteko zaarana; histtada inttena darsana; ta inttes gelida caaqo qaalaa naagana. <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />Kaththay inttes layththafe layth gaththana; hessafe dendidayssan oorath gakkida kath gelththanaas zilayththa kaththaafe attidayssa haraso kesseeta. <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />Tani intte giddon deyana; ta inttena shaatettike. <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />Tani ubba wode intte giddon simerettana; tani intte Xoos gidana; intteka ta dereta gidana.<note caller="-" style="x"><char style="xo" closed="false">26:12 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2Qoro 6:16</ref></char></note> <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />Intte aylleteththan haarettontta mala Gibxe biittafe inttena kessiday tani GODAA intte Xoossaa; tani intte aylleteththa qambara menththada intte dhoqqu giidi baana mala ooththadis.<verse eid="LEV 26:13" /></para>
  <para style="s1">Azazettontta Ixoy Gaththiza Meto</para>
  <para style="r">(<ref loc="DEU 28:15-28">Zaare 28:15-28</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />« ‹Gido attiin intte ta gizaaz siyontta ixxiko ha azazota ubbaa ooththontta aggiko, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />ta wogaanne ta azazota intte kadhizaa gidikko ta inttenara caaqettida caaqoza intte laalliko, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />he wode tani intte bolla hayssa ehana; gita dagama, gilqateth, ayfe boljesizaaz, asateththa gilqisizaaz qoxo harge ta intte bolla ehana; intte zereth zeranaashin coo mela hada gidana; gaasoykka intte zeridayssa intte morkketi maana. <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />Tani intte bolla hanqon dendiza gishshas intte xoonettana; intte ixxiza intte morkketi inttena haarana; oonikka inttena gooddontta intte intterkka baqatana.<verse eid="LEV 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18" />« ‹Hessi wurikka intte bolla gakkidaappe guyekka intte taas azazettontta ixxiko ta intte bolla yeggana qixaateza laappun kushe darsana. <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />Intte otoroteththaa wolqqa ta menththana; inttefe bollara saloza birata mala ooththana; intte biittaaka xarqimalaththo ooththana. <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />Intte wolqqay coo hada wurana; gaasoykka intte biittay kath immenna; miththatikka ayfettenna.<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />« ‹Ha7ikka intte taas ixxis giidi azazettontta aggiko tani intte bolla intte nagaraa keena qixaateza laappun kushe darsana. <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />Iita do7ata ta intte giddo yeddana; he do7ati intte nayta wadhdhana; intte miizatakka ubbaa dhayssana; inttefe guuththa asati xalla attana; kase intte hemettiza ogey samana.<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />« ‹Hayssi ha qixaatezi intte bolla gakkidaappe guyekka intte ta gizayssa siyontta ixxidi ta bolla intte eqeteth darssiko, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />he wode tanikka inttes morkke gidana; intte nagara gishshas ta inttena laappun dakko qaxxayana. <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />Intte tanara caaqqida qaalaa laallida gishshas ta inttena qaxxayanaas intte bolla ola yeddana; intte intte katamatan shiiqiza wode ta intte giddon iita harge kiittana; intte morkketas intte aadhdhi imettana. <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />Intte kaththaa tani dhayssiza wode tammu maccassati wuri issi bashen uukkana; izokka maka miishshan geeddari geeddari ekkana; intteka miidi kalleketa.<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />« ‹Hayssi ubbay intte bolla gakkiin intte taas azazettontta ixxidi ta bolla makkalli makkalli biikko, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />ta intte bolla hanqon dendana; intte nagaraa gishshas ta inttena laappun dakko qaxxayana. <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />Intte kosha daroppe dendidayssan intte nayta asho maana. <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />Dhoqqasohon diza intte goynniza eeqa xoossata tani dhayssana; intte exaane yarsho izan shiishshizasoza ta laallana; intte ahaa intte eeqata bolla ta yeggana; ta shemppiya inttena shaatettana. <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />Ta intte katamata laallana; intte goynnizasota ta kays histtana; sawiza intte yarshoza ta ekkike. <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />Intte biittaa mulera ta dhayssana; heen diza intte morkketi malalettana gakkanaas biittayo ta asi bayndaso histtana. <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />Ta intte bolla ola ehada inttena Ayzaabeta giddon laallana; tani ta mashsha kessada inttena gooddana; intte kawoteththay asi baynda biitta gidana; intte katamatikka laalettana. <verse eid="LEV 26:33" /><verse number="34" style="v" sid="LEV 26:34" />Intte intte morkketa biittan diza wode intte biittay kays gidiza gishshas shemppo demmada Sambata layththatan ufayettana. <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />Intte biittaya kase intte izin dishin Sambata demmonttaara asay dhayda wode iza shemppo demmana.<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36" />« ‹Intte bete biittan dizayti wurikka carkoy qaaththiza qonashe giiris siyidi dagaman piradhdhi baqatana mala ta ooththana; morkkey olason gooddiin woxxiza mala intte woxxana; ay morkkeyka intte achchan baynda intte dhuphetti kundana. <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />Oonikka inttena gooddontta intte intterkka issoy issaara qaxetti kundana; intte intte morkketara eqetti olettanaas dandayekketa. <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />Intte bete biidi he deren hayqqana; intte intte morkketa kawoteththan mitetti attana. <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />Intte morkketa deren hayqqontta attidayti qasse intte nagaraninne kase intte aawata nagara geedon heen gilqi attana.<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />« ‹Gido attiin intte taas ammanettontta aggidayssanne ta bolla makkallida intte nagaraanne intte aawata nagaraa intte paaxikko, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />tani inttes morkke gidada inttena gede intte morkketa biitta yeddana mala tana oosisida intte nagaraa intte paaxikko muumida intte wozinaa intte kawushshidi intte nagaraappe intte simmiko, <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />Abrahaamera, Yisaaqaranne Yaaqoobera ta caaqqida caaqo qaalaa qoppana; biittayokka ta qoppana.<note caller="-" style="x"><char style="xo" closed="false">26:42 </char><char style="xt" closed="false"><ref loc="GEN 17:7-8">Medhe 17:7-8</ref>; <ref loc="GEN 26:3-4">26:3-4</ref>; <ref loc="GEN 28:13-14">28:13-14</ref></char></note> <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />Istti yeggi bida gishshas biittaya asi baynda bazzo gidadus; he wode izin asi baynda bazzo gidada ba Sambata ufayssan bonchchana; istti ta wogaanne ta azazoza kawushshida gishshas istti ooththida nagaraa gishshas qaxxayettana. <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />Gidikkoka istti ba morkketa deren diza wode istta mulera dhayssike gaada ta caaqqida qaalaa mabeekke; ta inttena aggaagikke; ta inttena harassetike; tani GODAA intte Xoossaa. <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />Tani istta Xoossaa gidana gaada Ayzaabe asay beyishin Gibxe biittafe kessida istta aawatara caaqqida caaqoza ta qoppana; tani GODAA› gees.»<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />Isra7eele deraas yootana mala Musey Siina zumaa bolla dishin Xoossi izas immida wogati, maaratinne azazoti haytantta.<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s1">Imotata Gishshas Wodhdhida Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />GODAY Muses hizgides, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />«Isra7eele asaas, ‹Ay asikka GODAAS as immanaas adinettiin he adinay polettiko he immana gi adinettidayssa wozzanaas adina wogay, <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />hessaade layththay nam7u tammaafe biidi usuppun tammu kumida attuma as gidikko GODAA Keeththan erettida meezaanen meezaanettidi ichchash tammu gidiza saqile<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="fqa" closed="false">Saqile: </char><char style="ft" closed="false">Issi saqiley tammanne issinonne bagga giraame bira oykkees.</char></note> bira qanxxo. <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />Macca gidikko heedzdzu tammu saqile bira gido; <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />qasseka ichchash layththafe biidi nam7u tammu layth gakkanaas diza attuma naa gidikko nam7u tammu saqile bira, macca naa gidikko tammu saqile bira qanxxo; <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />issi aginappe biidi ichchash layth gakkanaas diza attuma naa gidikko ichchash saqile bira qanxxo; he layththata giddon diza macca naas gidikko heedzdzu saqile bira qanxxo. <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />Hessaththoka layththay usuppun tammaafe bollara diza attuma as gidikko tammanne ichchash saqile bira, macca gidikko tammu saqile bira qanxxo. <verse eid="LEV 27:7" /><verse number="8" style="v" sid="LEV 27:8" />Adina adinettidaadey hayssa ha heregettoyssa qanxxanaas dandayontta keehi manqo gidikko izi ba immana gi adinidayssa qeeseza sinth ekki yo; qeesezikka adinettidaade xeelli be7idi izaade wolqqa keena herego.<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />« ‹Adina adinettidayssi Xoossas yarshanaas bessiza mehe gidikko hessa mala mehey Xoossas dumma gidida gishshas wozzettenna. <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />Adina adinettidaadey ba adinettida meheza hara mehen laammofo; gido attiin iitazakka lo7o mehen laammizaa gidikko izi kase ehoyssara nam7ayka Xoossas dummatidayta gidetto. <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />Izaadey immizayssi Xoossas yarshettanaas bessontta mehe gidikko he meheza ehidaadey meheza qeesekko eho. <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />Qeesezi he meheza iitateththinne iza lo7eteth caddi xeellidi izi kessana waaga yooto; he izi gida waagay izi gida mala hano. <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />He meheza goday meheza zaari miishshara shammana koykko he meheza waaga bolla xeetappe nam7u tammu kushe gujjidi shammo.<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />« ‹Issaadey ba keeth GODAAS dumma imota immiko qeeseta halaqay keeththay iitakkonne lo7okko iza hanoteth caddi xeelli heregidi waaga yooto; he qeesezi heregida waagay keeththaas herega gido. <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />Kase keeththaa goday he keeththaa zaari wozzana koykko heregettida waaga xeetappe nam7u tammu kushe bollara gujjidi keeththaa baas ekko.<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />« ‹Issaadey ba gadeppe shaakki GODAAS dumma imota immiko biittay immiza kaththaa mala heregetto; hessika issi kilo bangga gishshas ichchash tammu saqile biray qanxxetto. <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />Gadeza goday kase gadeza immiday wozzo layththa ba7aaleppe guye gidikko gades kase wodhdhida wogay laamettenna. <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />Izaadey gadaa immiday ichchash tammanththo layththaafe guye gidikko qeesezi hereganay yiza ichchash tammanththo layth gakkanaas diza attida layththaa qoodidi herego; miishshaafe ashshi ciggo.<note caller="-" style="x"><char style="xo" closed="false">27:18 </char><char style="xt" closed="false"><ref loc="NUM 18:14">Tay 18:14</ref></char></note> <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />Gadeza immidaadey zaari wozzana koykko kase gadezi heregettida waaga bolla xeetappe nam7u kushe gujjidi zaari wozzo. <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />Kase gadey ba gadaa Xoossafe miishshan wozzanaappe sinththan hara asas bayzidaa gidikko qasse he gadeza nam7anththo zaari wozzana wogay izas deenna. <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />Wozzo layththan gadey simmiza wode he gadezi gidikko GODAAS dummatidi qeeseta laata gade gidi atto.<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22" />« ‹Issaadey hara asappe shammi ekkida gade Xoossas immana koykko, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />kaalli yiza wozzo layth gakkanaas gadezi kessana waaga qeesezi herego; he gallas he heregettida miish gadaadey qanxxo; he miishshayka Xoossa oosos dummatidaaz gidana. <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />Wozzo layththa ba7aaley gakkiza wode he gadeza koyro laatan ekkidi bayzidaades gadezi simmo. <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />He heregaza waagay GODAA Keeththan erettida meezaanen meezaanettidi nam7u tammu saqile gido.<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />« ‹Koyro bayra yelettida mehey izi kasekka GODAAS gidida gishshas oonikka iza Xoossas mela kiyateth immanaas dandayenna; galo mar gidiin woykko dorsanne deysha laaqqati kasetidi Xoossas dummatidayta. <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />Iza bolla wosoy diza mehenne yarsho shiishshanaas bessontta mehe gidikko he meheza goday iza heregettida waagaa bolla xeetaappe nam7u tammu kushe gujjidi zaari wozzi ekkanaas dandayees; iza goday wozzi ekkanaas koyontta ixxiko he heregettida waagaan hara asas bayzetto.<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />« ‹Issaadey ba godaas baas dizayssafe as gidiin woykko mehe, gidiin woykko gade gidiin kumeththara dumma shaakkidaappe guye mulekka bayzanaassinne zaari wozzanaas bessenna.<verse eid="LEV 27:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 27:29" />« ‹Asa giddofe shaakettidi deyana mala pirdettidaadey wozzettofo; izaadey hayqqanaas bessees.<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />« ‹Biittafe mokkiza kath gidiin woykko miththa ayfe gidiin tammaafe issoy Xoossas dummatida asraata. <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />Hessafe awayssaka baas wozzi ekkanaas koyzaadey he miishshay bayzettiza waagaas xeetappe nam7u tammu kushe gujjidi shammanaas dandayees. <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />Soo mehetappe tammaafe issay Xoossa gisha; mehey taybettishin tammanththay tammanththay GODAAS dumma shaakettidaaza. <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />Tammanththa mehey iita gidiin woykko lo7o gidiin dooroppo; woykko harara laammofo; laammizaa gidikko koyroyssinne laame imettidayssara nam7ayka GODAAS dummatidaaz gideettes attiin zaari wozzanaas dandayenna› ga yoota.»<note caller="-" style="x"><char style="xo" closed="false">27:30-33 </char><char style="xt" closed="false"><ref loc="NUM 18:21">Tay 18:21</ref>; <ref loc="DEU 14:22-29">Zaare 14:22-29</ref></char></note> <verse eid="LEV 27:33" /><verse number="34" style="v" sid="LEV 27:34" />Siina zumaa bolla GODAY Muse baggara Isra7eele asaa azazida azazoti haytantta.<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>