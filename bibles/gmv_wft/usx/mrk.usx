<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Gamo Full Bible final version</book>
  <para style="h">Marqoosa Mishiraachcho</para>
  <para style="toc1">Marqoosa Mishiraachcho</para>
  <para style="toc2">Marqoosa Mishiraachcho</para>
  <para style="toc3">Mar</para>
  <para style="mt1">Marqoosi Xaafida</para>
  <para style="mt2">Nu Godaa Yesus Kirstoosa Mishiraachcho Qaala</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Marqoosa Mishiraachcho qaalay, «Hayssi Xoossa Naa Yesus Kirstoosa Mishiraachcho qaalaas koyro» guussan doommees. Hayssa ha Mishiraachcho qaalaza giddon Yesusi oosanchchanne izi godateththara dizaade gidi shiiqides. Godateththika iza timirten, daydanththata bolla diza wolqqaninne izi asa nagara atto gidayssan erettides. Yesusi, «Nagara aylleteththafe asaa kessi ekkanaas ta shemppo asa gishshas aaththa immanaas yida Asa Nay tana» giidi barkka yootides.</para>
  <para style="ip">Marqoosi Yesusa taarike shiishshiday qoncceninne wolqqay kumida ogera gidishin izi tishshi histti xeelliday Yesusa qaalanne iza timirteza gidontta izi ooththida gita malaata oosota. Izi xammaqiza Yohannisa gishshas, Yesusa xinqata gishshassinne izi ekkida metoza gishshas qaanththara yootidaappe guye Yesusi tamaarsida timirteza gishshassinne izi harganchchata paththidayssa birshi yootees. Yesusa kaallizayti guyeppe Yesusa lo7eththi eri eri bida mala Yesusara eqettizayti qasse Yesusa kaseppe aaththi ixxi ixxi bida. Maxaafaas wurseththa shempoti Yesusi biitta bolla de7ida wurseththa layththan wurseththa saaminttan polettida oosota, harappeka iza kaqeteththaa gishshassinne iza denththaa gishshas yooteettes.</para>
  <para style="ip">Marqoosa Mishiraachcho qaalaas wurseththan diza nam7u kifileti issi issi maxaafatan xalla deettes.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Mishiraachcho qaalas koyro doometh <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Yesusi ba ooso koyro Galilan doommides <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Yerusalaamen Yesusa ooso <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Yerusalaameninne he heeran wurseththa saaminttan Yesusa gakkida meto <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">Hayqoppe Godaa denth <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Hayqoppe dendida Godaa qoncceththinne pude salo buus <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Xammaqiza Yohannisa Markkateth</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mato 3:1-12</ref>; <ref loc="LUK 3:1-18">Luqa 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Xoossa Naa Yesus Kirstoosa koyro Mishiraachchoy hayssa;<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafatan Xoossa Naa giza qaalazi xaafettibeenna.</char></note> <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />nabe Isayaasa baggara,</para>
  <para style="q1" vid="MRK 1:2">«Hekko nees oge lo7eththanaas</para>
  <para style="q2" vid="MRK 1:2">ta kiittanaade</para>
  <para style="q2" vid="MRK 1:2">neeppe sinththara yeddana.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil 3:1</ref></char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />‹Godaas oge giigsite;</para>
  <para style="q2" vid="MRK 1:3">izi baana oge suurisidi ooththite›</para>
  <para style="q2" vid="MRK 1:3">gishe bazzo biittan</para>
  <para style="q2" vid="MRK 1:3">waassiza giiris»</para>
  <para style="q2" vid="MRK 1:3">geetetti xaafettides.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Hessaththoka Xammaqiza Yohannisi asaa xammaqishe, «Intte nagarappe simmidi xammaqettite, Xoossi intte nagara atto gaana» gi awajjishe bazzora kezi wodhdhides. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Yuhuda derey kumeth Yerusalaame asay wuri Yohannisakko bi biidi ba nagara nagara paaxi paaxi Yordaanoose Shaafan Yohannisa kushen xammaqettides. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />He wode Yohannisi may7izay gaamella iskefe oosettida may7o; qasse ba xeessan dafo gixxees; izi miza qumay boolenne degera eessa.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2Kawo 1:8</ref></char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Izi, «Tani hokkada iza caamma qasho birshanaas bessonttaadey, taappe aadhdhizaadey taappe guyera yaana. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Tani inttena haaththan xammaqays; izi gidikko inttena Xillo Ayanan xammaqana» gi sabbakides.<verse eid="MRK 1:8" /></para>
  <para style="s1">Yesusa Xammaqeteththinne Paaceteth</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />He wode Yesusi Galila giddon diza Naazirete geetettiza katamayppe Yordaanoose Shaafa yiidi Yohannisa kushen xammaqettides. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yesusi xammaqettidi haaththaafe kezida mala saloy doyettiin Xillo Ayanay iza bolla haraphphe misatidi wodhdhishin be7ides. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Qasseka, «Ta dosiza Nay nena, nenan ta ufayettays» giza qaala giirissi pude saloppe seetettides.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maza 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Mato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar 9:7</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref></char></note><verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Heerakka Xillo Ayanay iza duge bazzo kaaleththi efides. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Heen bazzonkka oyddu tammu gallas gakkanaas Xala7era paacettishe gam7ides; do7atara issife de7ides; kiitanchchatikka iza maaddida.<verse eid="MRK 1:13" /></para>
  <para style="s1">Yesusa Kaallana Mala Oyddu Asata Xeygeteth</para>
  <para style="p">
    <verse number="14-15" style="v" sid="MRK 1:14-15" />Yohannisi qasho keeth gelidaappe guye Yesusi Xoossa Mishiraachcho qaalaa sabbakishe Galila biidi, «Wodey gakkides; Xoossa Kawoteththi matides; nagarappe simmite; Mishiraachcho qaalan ammanite» giidi sabbakides.<verse eid="MRK 1:14-15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yesusi Galila abbaa achchara aadhdhiin Simooninne iza isha Indiraasi mole oykkizayta gidida gishshas istti mole oykkiza gite abban yeggishin be7ides. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesusi istta, «Haa yiite! Tana kaallite; intte mole oykki shiishshiza mala ta inttena as oykkizayta ooththana» gides. <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Istti heerakka mole giteza yeggi aggidi Yesusa kaallida.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Guuth gede sinththe aadhdhidi Zabdoosa naa Yaaqoobeynne iza isha Yohannisi wogolon uttidi mole gite giigsishin be7idi heerakka istta xeygides. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Isttika ba aawaa Zabdoosanne izas qaxxaretti ooththiza asatara issife wogoloza giddon aggidi Yesusa kaalli bida.<verse eid="MRK 1:20" /></para>
  <para style="s1">Yesusi Paththida Tuna Ayanay Iza Bolla Dizaade</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Heeppeka Qifirnahoome bida. Heerakka Yesusi Ayhudata Sambata gallas Ayhudata Woosa Keeth<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ayhudata Woosa Keeth geetettizayssi amaraththo qaalan «Mikuraabe» geetettees.</char></note> gelidi tamaarso oykkides. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Xaafeta mala gidontta godateththara diza asa mala izi tamaarsiin asay wuri iza timirtezan malalettides.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />He wode Ayhudata Woosa Keeththan tuna ayanay iza bolla diza issaadey, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />«Naazirete Yesusa ne nuuppe ay koyay? Nuna dhayssana yadii? Ne oonakko ta nena erays; neni Xoossa geeshshaza» giidi waassides.<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesuska tuna ayanaza, «Co7u gaada izappe keza!» gi hanqides.<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Tuna ayanay addeza genderisidi izi qakettishin izappe waassishe kezides. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Derey wuri, «Aso hayssi aaza palaa? Hayssi godateththara diza ooraththa timirte; tuna ayanatakka azazees; isttika izas azazetteettes» gi malalettishe asay ba giddon issoy issaa oyshechcho oykkides.<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Heerakka iza ooso worey Galila yuushon diza dere ubbaan siyettides.<verse eid="MRK 1:28" /></para>
  <para style="s1">Yesusi Daro Harganchchata Paththides</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Ayhudata Woosa Keeththafe kezida mala Yaaqooberanne Yohannisara issife gede Simoonasonne Indiraasaso gelida. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Hee gelida mala Simoona bolloteya misha harge sakettada ichchidayssa izas yootida. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Hessa gishshas Yesusi izikko shiiqidi izi kushe oykki denththides. Mishay aggiin iza dendada istta mokkadus.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Arshey wullidaappe guye gadey dhumishin asay harganchchatanne daydanththi oykkida asaa wursi Yesusaakko ekki yides. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />He katamayin diza asay wuri keeththa karen shiiqides. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Izikka dumma dumma hargen sakettidayta darota paththides; daro daydanththatakka kessides; gido attiin daydanththati Yesusi oonakko eriza gishshas istti haasayana mala Yesusi koyibeenna.<verse eid="MRK 1:34" /></para>
  <para style="s1">Yesusi Galilan Tamaarsida Mishiraachcho Qaala</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Bazzoy zo7ontta Yesusi maalado wonttara dendidi asi bayndaso biidi heen woosa oykkides. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simooninne izara dizayti Yesusa koyana kezi bida. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Istti iza demmidi, «Asi wuri nena koshshan dees» gida.<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesusikka, «Ta yiday tamaarsanaas gidida gishshas Mishiraachcho qaala yootanaas matan diza gutata ane boos» gides.<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Hessa gishshas Ayhudata Woosa Keeththan geli geli sabbakishenne daydanth kessishe Galila katama kumeththaan yuuyides.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yesusi Inchchirachcha Hargizaade Paththides</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Issi inchchirachcha hargizaadey Yesusaakko shiiqidinne iza sinththan gulbatidi, «Ne shene gidikko ne tana paththana dandayaasa» gi woossides.<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesusikka addezas mishettidi ba kushe yeddi iza bochchidi, «Ne paxana mala ta koyays; paxa!» gides.<verse eid="MRK 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 1:42" />Heerakka addeza inchchirachcha hargey aggiin addezi paxides. <verse eid="MRK 1:42" /><verse number="43-44" style="v" sid="MRK 1:43-44" />Yesusikka addezas, «Oonaska hayssa ne yootontta mala naagetta; gido attiin baada qeeses nena bessa. Derezas markka gidana mala ne paxidayssas Musey azazida yarsho shiishsha» giidi keehi minththi yootides.<verse eid="MRK 1:43-44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Gido attiin addezi kezi biidi ba bida ubbason wore darssi dharccides. Hessa gaason Yesusi ay katamankka qonccera gelanaas dandaybeenna. Hessafe dendidayssan katamaappe karera asi bayndason duus oykkides. Asay gidikko dumma dummasoppeka izakko yides.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yesusi Toho Sila Addeza Paththides</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mato 9:1-8</ref>; <ref loc="LUK 5:17-26">Luqa 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Guuththa gallassafe guye, «Yesusi Qifirnahoome simmidi soon dees» giza wore asay siyides. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Hessa gishshas keeththara, karera uttizasoy dhayana gakkanaas daro derey shiiqides. Izikka Xoossa qaala asaas sabbakides. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Oyddu as dayti issi tohoy silida issi as tookkidi izakko ehida. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Asaa daroteththafe dendidayssan Yesusi dizaso gaththanaas dandayontta gishshas Yesusi diza ginara kaara qaaridi harganchchaza izi ichchida halaara<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fqa" closed="false">Halara: </char><char style="ft" closed="false">Halara gizayssa issi issi bagga Gamoththo qaalan zaphphara geettes.</char></note> Yesusa sinth duge woththida. <figure style="fig" alt="The roof of Juwish" file="LB00234B.TIF" size="span" ref="2:4">Ayhudata keeththa kaara</figure> <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesusi asata ammano be7idi tohoy silida addeza, «Ta naazoo! Ne nagaray atto geetettides» gides.<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="MRK 2:6-7" />Heen gadaan uttida issi issi Muse woga xaafeti ba wozinara hayssi addezi wostti hayssaththo gizee? «Xoossa bolla cashsha qaala haasayees. Issi Xoossaafe attiin nagara maarana dandayzay oonee?» giidi qoppida.<verse eid="MRK 2:6-7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Yesusi heerakka istti ba wozinan qoppidayssa ba Ayanan eridi, «Intte wostti hayssaththo qoppeetii? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Tohoy silida addeza, ‹Ne nagaray atto geetettides› guussafenne ‹Dendada ne hala tookkada ba› guussafe awayssi matizee? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Gido attiin Asa Naas biitta bollan nagara maarana godateththi dizayssa intte erana mala» giidi toho sila addeza, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />«Dendada ne tooketta yida halaa tookkada neso ba» gides.<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Izikka dendidi asay wuri beyishin halaa tookkidi bides. Heen gadaan diza asay wuri hanozan malalettidi, «Kase hayssa malay haniin beyibeekko» giidi Xoos galatides.<verse eid="MRK 2:12" /></para>
  <para style="s1">Lewe Xeygeteth</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mato 9:9-13</ref>; <ref loc="LUK 5:27-32">Luqa 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Qasseka Yesusi Galila Abba lanqe bides. Daro derey izakko yiin izikka yida asaa tamaarsides. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Izi ogera aadhdhi bishin Ilfiyoosa naa Lewey qaraxa shiishshizason uttidayssa be7idi, «Haa ya tana kaalla» gides. Izikka dendidi Yesusa kaallides.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Hessafe guye Lewe soon kaththa maaddan utti dishin qaraxa shiishshiza daro asatinne nagaranchchati izara kaalli yida gishshas istti Yesusaranne iza kaallizaytara issife maaddaan uttida. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Farsaaweta baggafe gidida Muse woga tamaarsizayti Yesusi nagaranchchataranne qaraxa shiishshizaytara mishin be7idi iza kaallizayta, «Qaraxa qanxxisizaytaranne nagaranchchatara aazas mizee?» giidi oychchida.<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesusikka istti gizayssa siyidi, «Aakimey harganchchatas koshshees attiin hargonttaytas gidenna. Tanikka nagaranchchata xeyganaas yadis attiin xillota xeyganaas yabeekke» gides.<verse eid="MRK 2:17" /></para>
  <para style="s1">Xooma Gishshas Shiiqida Oysho</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mato 9:14-17</ref>; <ref loc="LUK 5:33-39">Luqa 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Yohannisa kaallizaytinne Farsaaweti xooma xoomeettes. Issi issi asati Yesusaakko yiidi, «Yohannisa kaallizaytinne Farsaaweta kaallizayti xoomeettes shin nena kaallizayti aazas xoomettennee?» gi oychchida.<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesusikka isttas, «Mishiray isttara dishin mishira laggeti xoomi erizoo? Mishiray isttara dishin xoomi erettenna. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Mishiray isttafe ekettana wodey yaana. He wode istti xoomana.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />«Gal7a may7o bolla ooraththa woso woththi sikkizaadey oonikka deenna; hessaththo ooththiko ooraththazi gal7aa daakki daakki yeggees; daakeththayka kaseppe gede aadhdhi iitees. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Hessaththoka ooraththa woyne cajje gal7a lukkamon woththizaadey deenna. Woththizaa gidikko woyne cajjezi gal7a lukkamoza dhuussees; woyne cajjezinne lukkamozi nam7ay mooretteettes. Hessa gishshas ooraththa woyne cajjey daanaas bessizay ooraththa lukkamonna» gides.<verse eid="MRK 2:22" /></para>
  <para style="s1">Sambata Gishshas Shiiqida Oysho</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mato 12:1-8</ref>; <ref loc="LUK 6:1-5">Luqa 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Yesusi Ayhudata Sambata gallas gistte tiya giddora aadhdhishin iza kaallizayti izara issife bishe tiya xupho oykkida.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref></char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Farsaaweti, «Nena kaallizayti Sambata gallas digettida miish aazas ooththizoo?» giidi Yesusa oychchida.<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Izikka isttas, «Dawiti gafidi miza miish koyida wode izara issife dizaytara izi ooththidayssa nababibeekketii?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Same 21:1-6</ref></char></note> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Abiyaataarey qeeseta halaqateththan dishin izi Xoossa Keeththe gelidi qeeseti xalala maana bessiza dumma kaththaa baas miidinne banara dizaytas immides» gides.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lewe 24:9</ref></char></note><verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Qasseka Yesusi isttas, «Sambatay asas medhettides attiin asi Sambatas medhettibeenna. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Hessa gishshas ta Asa Nay Sambata godaa» gides.<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">Kushe Silida Addeza Paxateth</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mato 12:9-14</ref>; <ref loc="LUK 6:6-11">Luqa 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Hara gallas Yesusi Ayhuda Woosa Keeththe gelides. Heenkka kushey silidaadey dees. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Yesusa mootanaas gaaso koyza asati izi Ayhudata Sambata gallas paththanaakkon giidi paththishin beyana koyida.<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />Izikka kushey silida addeza, «Heen shiiqi uttida asaa sinththan denda eqqa» gides. <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Hessafe guye Yesusi asaa, «Sambata gallas bessizay lo7o oosoyee? Iita oosoo? Asa shempo ashoyee? Woykko shempo wodhoo?» giidi oychchides. Isttika co7u gida.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Istta wozina shuchchateththan mishettidi iza giddoththidi yuuyi aadhdhi eqqida asaa hanqora xeellidi addeza, «Ne kusheza piddisa!» gides. Addezikka ba kushe piddisiin kushezi mulera paxides. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Farsaaweti kezi biidi iza wostti dhayssanaakko Herdoosa bagga gidida asatara zorettida.<verse eid="MRK 3:6" /></para>
  <para style="s1">Abbaa Lanqen Daro Asaa Shiiqo</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesusi bana kaallizaytara abbaako bides. Galilappenne Yuhudappe yida daro derey iza kaallides. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Izi ooththizayssa siyidi asay Yuhudappe, Yerusalaameppe, Eedoomeppe, Yordaanoose pinththan diza deretappe qasse Xirooseppenne Sidoona heerappe izakko yides. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Asay darida gishshas iza un7eththontta mala guuththa wogolo istti giigsana mala bana kaallizayta azazides. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Izi daro harganchchata paththida gishshas sakoy waayisizayti wuri iza ba kushera bochchanaas dafettida.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar 4:1</ref>; <ref loc="LUK 5:1-3">Luqa 5:1-3</ref></char></note> <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Tuna ayanatikka Yesusa be7ida mala iza sinththan kundidi, «Neni Xoossa Naa» giidi waassida.<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Gido attiin izi oonakko tuna ayanati qonccisontta mala keehippe hanqides.<verse eid="MRK 3:12" /></para>
  <para style="s1">Yesusa Kaalliza Tammanne Nam7ata Dooreteth</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mato 10:1-4</ref>; <ref loc="LUK 6:12-16">Luqa 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesusi pude zuma bolla kezidi ba koyzayta baakko yaana mala xeygides; isttika izakko yida. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Izara issife gidana malanne sabbakanaas yeddana mala tammanne nam7ata, «Hawaareta» gi sunththides. <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Asaappe daydanththata kessana mala isttas godateth immides.<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Izi sunththida tammanne nam7ata sunththi hayssafe kaallizayssa; Phexroosa geetettida Simoona, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Bi7orinegeese woykko daada nayta geetettida Zabdoosa nayta Yaaqoobenne Yohannisa, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Indiraasa, Piliphoosa, Bartelemoosa, Matoosa, Toomaasa, Ilfiyoosa naa Yaaqoobe, Tadoosa, ba baggas mishettiza Simoona, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Yesusa aaththi immida Asqoronto Yuhuda.<verse eid="MRK 3:19" /></para>
  <para style="s1">Yesusanne Bi7elizeebula</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mato 12:22-32</ref>; <ref loc="LUK 11:14-23">Luqa 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Hessafe guye Yesusi issi soo gelides. Izinne iza kaallizayti kath maana wodey isttas dhayana gakkanaas derey qasseka dari shiiqides. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Iza hanotaa siyida iza dabboti, «Gooyontta aggenna» giidi banara ekki baanaas izi dizaso gakkida.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Yerusalaameppe yida xaafetikka, «Bi7elizeebula geetettiza daydanththata halaqay iza bolla dees. Izi daydanththata kessizay daydanththata halaqa wolqqankko!» gida.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Izikka istta xeygidi leemisora, «Xala7ey asappe Xala7e wostti kessanee? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Ba giddon shaakoy diza kawoteththi minnanaas dandayenna. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Issi keeththa asikka ba giddon shaakettiko eqqanaas dandayenna. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Hessaththoka Xala7ey ba garsan issoy issaara shaakettikonne ixettiko minni eqqanaas dandayenna. Hessika izas wurseth gidana.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />«Hessa gaason issaadey koyrottidi wolqqama as qachchontta dishe wolqqamaza soo gelanaassinne iza miishshe bonqqanaas dandayenna; iza aqo bonqqanaas dandayettizay wolqqamaza qachchiko xalala.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />«Ta inttes tumu gays; asa naytas nagaraynne cashshi wuri maarettana. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Gido attiin Xillo Ayana bolla cashsha qaala haasayza asa ubbaas mernaas nagara aco gidana attiin maarettenna» gides.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luqa 12:10</ref></char></note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Hessa izi giday istti iza, «Ne bolla tuna ayanay dees» gida gishshassa.<verse eid="MRK 3:30" /></para>
  <para style="s1">Yesusa Aayeyonne Iza Ishata</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mato 12:46-50</ref>; <ref loc="LUK 8:19-21">Luqa 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Hessafe guye iza aayeyanne iza ishati kare yi eqqidinne ase izakko kiitti xeygisida. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Iza giddoththi uttida daro asay, «Hekko ne aayeyanne ne ishati karen eqqidi nena koyeettes» gida.<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Izikka zaaridi, «Ta aaya oonee? Ta ishati oonanttee?» gides. <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Iza yuuyi uttida asaakko xeellidi, «Ta aayeyanne ta ishati haytanttako! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Xoossa shene ooththizay wuri izi ta isha, ta michchonne ta aayo» gides.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">Zereth Zerizaade Leemiso</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mato 13:1-9</ref>; <ref loc="LUK 8:4-8">Luqa 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Qasse Yesusi hara wode abbaa achchan tamaarso oykkides. Izakko keehi daro derey shiiqida gishshas abbaa giddon diza wogolo dizaarin gelidi uttides; asaykka wuri abbaa achchan shiiqides.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luqa 5:1-3</ref></char></note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Izikka daro yo7ota leemison hizgi tamaarsides. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />«Siyite! Issaadey zereth zeranaas kezides. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Izi zerishin issi issi zereththi oge bolla wodhdhides. Oge bolla wodhdhida zereththaa kafoti maxi mida. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Baggay mela biittan wodhdhides. He biittay mela gidida gishshas heerakka caarides. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Gido attiin arshey kezida mala shullidi xapho yeddontta gishshas melides. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Qasse issi zereththi agunththa giddon wodhdhides; agunththayka diccidi cuullida gishshas ayfibeenna. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Hara zereththi qasse lo7o orde biitta bolla wodhdhida gishshas caaridi diccides; ayfekka ayfides; Issoy heedzdzu tammu, issoy qasse usuppun tammu, issoy qasse xeetu ayfides.»<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Yesusi qasseka, «Siyiza hayththi dizaadey siyo!» gides.<verse eid="MRK 4:9" /></para>
  <para style="s1">Yesusi Leemisora Yootiza Gaaso</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mato 13:10-17</ref>; <ref loc="LUK 8:9-10">Luqa 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Yesusi barkka dishin tammanne nam7atinne kase izara diza asay izi yootida leemisoza gishshas iza zaari oychchida. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Izikka isttas, «Inttes Xoossa Kawoteththa xuura eroy gelides shin karen dizaytas gidikko yo7oy wuri leemisora yootettees. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Hessika kase, ‹Istti be7idi be7idayssa akeekontta malanne simmontta mala, qasseka istta nagaray maarettontta malakko› » gides.<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Qasseka Yesusi, «Hayssi leemisoy inttes gelibeennee? Histtiin hara leemiso intte wostti eranee? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Zerizaadey qaala zerees. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Issi issi asati oge bolla wodhdhida zereththaa misateettes; istti qaala siyiza wode Xala7ey yiidi heerakka istti siyida qaalaa istta wozinappe ekkichchees. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Hessaththoka harati mela biitta bolla wodhdhida zereththaa misateettes. Istti qaala siyidi ufayssan ekkeettes. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Gido attiin istti xapho yeddontta gishshas guuththa wode gam7ishin qaalaa gaason metoy woykko goodetay asata bolla yiza wode heerakka dhuphetteettes. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Harati qasse agunththa giddon wodhdhida zereththaa misateettes; istti qaalaa sis siyeettes. <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Gido attiin ha biitta metoy, miishsha siiqoynne hara amoy istti siyida qaala cuullidi ayfe ayfontta mala diggees. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Hankkoyti lo7o biittan zerettida zereththaa misateettes; heytikka qaalaa siyidi ekkizaadenne heedzdzu tammu ayfe, usuppun tammu ayfenne xeetu ayfe ayfizayta» gides.<verse eid="MRK 4:20" /></para>
  <para style="s1">Geeman Diza Xomppe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luqa 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Qasseka Yesusi, «Xomppe oyththidi geemason woykko arsa garsan woththi ereetii? Poo7ana mala qoncceson woththeeta gidennee?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mato 5:15</ref>; <ref loc="LUK 11:33">Luqa 11:33</ref></char></note> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Hessa gishshas qotettidi qoncce kezonttay, poo7on kezontta geeman attanay baa.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mato 10:26</ref>; <ref loc="LUK 12:2">Luqa 12:2</ref></char></note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Hessa gishshas siyiza hayththi dizaadey siyo!» gides.<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Gujjidikka, «Intte siyizayssa wozinan woththite; intte makkiza miishshara inttes makettana; hessafekka daroy gujettana.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mato 7:2</ref>; <ref loc="LUK 6:38">Luqa 6:38</ref></char></note> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Dizaades gujettana shin bayndaadefe izas dizaarakka ekketaychchana» gides.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mato 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luqa 19:26</ref></char></note><verse eid="MRK 4:25" /></para>
  <para style="s1">Dicciza Zereththa Leemiso</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Qasseka Yesusi, «Xoossa kawoteththiya zereth zeriza issi as misatawus. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Zeridaadey omars dhiskees. Wontishin dendees; gido attiin izi erontta dishin zerettida kaththay mokkidi diccees. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Gadeyakka koyro caarech, kaaleththada pudhe, qasseka pudheza bolla lo7o ayfe immawus. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Kaththay kaxxidaappe guye boney gakkiin keeththa aaway heerakka maxa oykkees» gides.<verse eid="MRK 4:29" /></para>
  <para style="s1">Sanafice Miththa Ayfe Leemiso</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesusi, «Xoossa Kawoteth nu aazara ginisanee? Aazara leemisanee? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Biitta bolla ubbaafe laafa gidida sanafice ayfe misatawus. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Zerettada diccidaappe guye qasse atakilteta ubbaafe aadhdhiza gishshas kafoti yiidi he atakiltey haggata kuwa giddon shempeettes» gides.<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesusikka asay ekkanaas dandayzayssa keena hayta misatiza hara daro leemisora isttas yootides. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Ay miish gidikkoka asaas leemisoy baynda yooti erenna. Izinne iza kaallizayti xalla diza wode gidikko wursi birshi yootees.<verse eid="MRK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />He gallas gadey qammishin bana kaallizayta, «Ane gede he pinth pinnoos» gides. <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Istti asaa heen aggaagidi izi utti diza wogolozara Yesusa ekki bida. Hara wogolotikka isttara issife deettes. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />He wode wolqqama dambalay abbaa bolla dendidi wogoloza haaththi kumana gakkanaas shocechchides. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Gido attiin Yesusi borkoth borkotidi wogolozas guye baggan ichchides. Isttika iza denththidi, «Astamaaree! Nuni dhayshin nena meettennee?» gida.<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Izikka dendidi carkoza, «Co7u ga!» abbaaka, «Woppu ga!» gides; carkoyka co7u gides; mulekka co7u gides. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Bana kaallizaytakka, «Hayssaththo aazas babbidetii? Hayssa gakkanaas inttes ammanoy baawee?» gides.<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Isttika keehi babbidi ba giddon issoy issaara, «Carkoynne abbay izas azazettizay hayssi oonee?» geetettida.<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Yesusi Tuna Ayanappe Paththidaade</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mato 8:28-34</ref>; <ref loc="LUK 8:26-39">Luqa 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Abbaa pinnidi gede Gergesenoone geetettizaso bida. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Yesusi wogoloyppe wodhdhida mala tuna ayanay iza bolla dizaadey duufoppe kezidi Yesusara gaaggana izakko yides. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Hayssi addezi duufoson dizaadenne haray attoshin oonikka iza sansalatankka qachchanaas dandaybeenna. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Daro wode toho birataranne sansalatara qashettees. Gido attiin kushe sansalata duuseththi yeggees; toho biratakka menththereththi yeggees; oonikka iza oykkidi teqqanaas dandaybeenna. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Gallassinne qamma duufota giddoninne zumata bolla yuuyi yuuyi waassishe ba bolla shuchchara qanxxereththidi madunththees.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Izikka Yesusa haahon be7ida mala woththan izakko yiidi iza sinththan gulbatidi goynnides. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Keehi waassidi, «Haysso wogga Xoossa Naa Yesusa, nees tanara aazi dizee? Xoossa sunththan ta nena woossays tana waayisoppa» gides. <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Izi hessa giday Yesusi kase, «Neni tuna ayanay hayssafe keza» gida gishshassa.<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Hessafe qasse Yesusi iza, «Ne sunththi oonee?» giidi oychchides. Izikka, «Nuni darota gidida gishshas ta sunththi Leegoone<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fqa" closed="false">Leegoone: </char><char style="ft" closed="false">Leegoone guussi daro wottadarata butte [cifra] guussa.</char></note> geetettees» gides.<verse eid="MRK 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10" />He dereppe kessi yeddontta mala Yesusa keehi woossides.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Heen matan zuma bolla daro guddunththi heemettees. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Tuna ayanati, «Nu guddunththatan gelana mala nuus ero garkkii?» giidi Yesusa woossida. <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Izikka isttas, «Ero» gides. Tuna ayanatikka addezappe kezidi guddunththatan gelida. Nam7u shii gidiza guddunththati wuri aafozara duguththaa genderetti wodhdhidi abban mitettida.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Guddunththa heemmizayti baqatidi hanidayssa katamaninne dere giddon yootida. Dereykka hanidayssa beyanaas ba dizasoppe dizasoppe kezides. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Yesusaakko yiidi daro daydanththi iza bolla diza addeza wozinay izas simmiin may7o may7idinne wogara uttidayssa yida asay be7idi babbides. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Hayssa be7ida asay daydanththi iza bolla diza addeza gishshassinne guddunththati hanoyssa derezas yootides.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Hessafe guye he dere asay Yesusi istta dere yeddidi baana mala woossides.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Yesusi wogolon gelishin daydanththati izappe kezida addezi Yesusara daanaas woossides.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Yesusi qasse izi oychchidayssa akkay giidi, «Neni gede neso ba; Goday nees ay mala gita miish ooththidaakkonne izi nees ooththida maaroteththaa neso asaas yoota» gides.<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Addezikka baso biidi Yesusi izas ooththida gita miish wursi tammu katama geetettiza deren yootiin siyiday wurikka malalettides.<verse eid="MRK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Qasseka Yesusi wogolon gelidi gede pinth pinnidi abbaa achchan dishin daro asay iza ach shiiqidinne iza giddoththides. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Ayhudata Woosa Keeththa halaqatappe issoy Iya7iroosa geetettizayssi izi dizaso biidi Yesusa demmida mala iza toho bolla kundidi <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />«Taas guuththa naa dizaara hayqqana gawus. Iza hayqqontta paxa daana mala ne haa yaada ne kushe izi bolla woththarkii?» giidi keehi woossides.<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Yesusikka izara issife bides. Daro asay iza un7eththana gakkanaas kaallides.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Tammanne nam7u layth kumeth suuththi izi bollafe gukkiza maccas dizaara heen asaara dawus.<verse eid="MRK 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 5:26" />Iza baas diza miish wursana gakkanaas aakimeppe aakime laamon daro daaburadus. Gido attiin sakoy izis gede darides attiin aykkoka lo7ibeenna. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Iza Yesusa gishshas siyida mala asaa giddora Yesusa guyera kaallada iza may7o bochchadus. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Gaasoykka, «Ta ay hanadakka iza may7o kushera bocho bochchidaakkoka paxana» gaada qoppida gishshassa.<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Gukkiza suuththay heerakka eqqi aggides; izakka paxidayssa ba asateththan eradus. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Baappe wolqqay kezidayssa Yesusi eridi gede asaakko simmidi, «Ta may7o oonee bochchiday?» gides.<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Iza kaallizayti qasse, «Hayssi derey un7ettidi sugettishin beyashe waanada, ‹Tana bochchiday oonee?› gay» gida.<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Yesusi hessa ooththiday oonakkonne beyanaas yuushshi xeellides. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Maccassayakka baas aazi waanidaakko erada babbashenne kokkorashe yaada Yesusa sinththan gufannada tumaa wursa izas yootadus. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Izikka, «Ta nayee! Ne ammanoy nena ashshides. Saron ba! Ne waayeppe paxa!» gides.<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yesusi buro haasayan dishin Ayhudata Woosa Keeththa halaqa Iya7iroosa sooppe yiidi Iya7iroosas, «Ne naya hayqqadus; Godaa mela aazas daabursay?» gida.<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Gido attiin Yesusi istta haasayaa leppi histtidi Ayhudata Woosa Keeththaa halaqaza, «Ne ammano xalla ammana attiin babbofa!» gides. <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Phexroosa, Yaaqooberanne Yaaqoobe isha Yohannisappe attiin haray oonikka iza kaallana mala koyibeenna. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Gede Ayhudata Woosa Keeththa halaqazaso gakkida mala asay waassishe camo yeeho yeekkizayssa be7ides. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Soo gelidi, «Hayssi wuri aaza waasonne aaza yeehoo? Naya dhiskadus attiin hayqqabeekku» gides.<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Qasse asay wuri iza bolla miiccides; asaa wursika keeththaafe kessidi nayi aawaanne nayi aayiyo qasseka izara issife yidayta iza kaallizayta xalla kaaleththidi naya dizaso gelides. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Nay kushekka oykkidi, «Xaabita kum!» gides. «Xaabita kum!» guussas birsheththi, «Hanne nayee denda» guussa.<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Nayakka heerakka denda eqqadus; yaanne haa hemettadus. Iziska layththay tammanne nam7a; asaykka he hanozan daro malalettides. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesusi hayssa oonikka erontta mala keehi minththi yootides; «Nays maana quma immite» gides.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">Naazirete Asay Yesusa Ekkibeenna</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mato 13:53-58</ref>; <ref loc="LUK 4:16-30">Luqa 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Hessafe guye Yesusi heeppe dendidi gede ba dere bides. Iza kaallizaytikka izara bida. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Ayhudata Sambatay gakkiin Ayhudata Woosa Keeththe gelidi tamaarsishin siyida asay, «Hayssi addezi hayssa wursi awappe ekkidee? Hayssi izas imettida erateththay aazee? Qasse hayti izi ooththiza malaatati waani iza kushen hanizoo?» gishe malalettida. <figure style="fig" alt="Man reading inside synagogue" file="LB00244B.TIF" size="span" ref="6:2">Ayhudata woosa keeththan timirtey imettishin</figure> <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />«Hayssi anaaxeza gidennee? Maarami naa Yaaqoobentta Yoosantta, Yuhudanttanne Simoonantta isha gidennee? Iza michcheti nunara haan nu matan dizayta dettenee?» giidi hessafe dendidayssan izan ufayettibeettenna.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Yesusikka isttas, «Nabey bonchchettonttay ba deren ba dabbota giddoninne baso asaa achchan xalla» gides.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoha 4:44</ref></char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Heen guuththa harganchchata bolla kushe woththi paththoriippe attiin hara aykko malaatakka ooththanaas dandaybeenna. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Isttas ammanoy bayndayssa be7idi malalettides. Hessafekka Yesusi gutan gutan yuuyi yuuyi tamaarsides.<verse eid="MRK 6:6" /></para>
  <para style="s1">Yesusi Kiitti Yeddida Tammanne Nam7ata</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mato 10:5-15</ref>; <ref loc="LUK 9:1-6">Luqa 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Tammanne nam7ata baakko xeygidi nam7u nam7u histti kiittishe tuna ayanata bolla isttas godateth immides. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Izi, «Oges gidiza guufe attiin oge shinqe woykko korojo woykko miishshe oykkofte.<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luqa 10:4-11</ref></char></note> <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Caamma aaththite gido attiin laammana may7o oykkofte. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Issi keeththe intte gelikko he katamaappe intte kezana gakkanaas he keeththaan diite. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Awanka oonikka inttena mokki ekkontta ixxiko heeppe kezishe he dereta bolla markka gidana mala intte toho bolla diza gudulla qoqofte» giidi azazides.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Gi7ize Ooraththa Caaqo Maxaafaynne 1,947 maaroteththa layththan xaafettida Amaraththo Geeshsha Maxaafay hayssafe kaallidi diza qofa gujjeettes; «Inttes tuma gays; he katamayppe Sodoomessinne Gamooras pirda gallas lo7ana.» Hayssa ha qofay Girike qaalan birshettida maxaafatan deenna.</char></note><note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Hawa 13:51</ref></char></note><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Isttika heeppe kezidi derey maaroteththan gelana mala sabbakida. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Daro daydanththata kessida; daro harganchchata zayte tiyi tiydi paththida.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yaaqo 5:14</ref></char></note><verse eid="MRK 6:13" /></para>
  <para style="s1">Xammaqiza Yohannisa Hayqo</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mato 14:1-12</ref>; <ref loc="LUK 9:7-9">Luqa 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Yesusa sunththi kaseppe eretti eretti bishin kawo Herdoosi hessa siyides. Issi issi asati, «Hayssa mala malaatata ooththizay Xammaqiza Yohannisi hayqoppe dendiina» gida.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Baggayti, «Eelaasa» geettes; bagga asay qasse, «Kase nabetappe issaa misatees» geettes.<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Herdoosi yo7oza siyidi, «Ta iza qoodhe qanxxisida Yohannisi hayqoppe paxi dendides» gides. <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Herdoosi ba isha Piliphoosa machcho Herodiyaado ekkida gaason oykettidi qashettana mala azazidi Yohannisa qasho keeththe gelththides. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohannisi Herdoosa, «Ne isha machcho ne ekkontta mala wogay nena diggees» gida gishshas qachchides.<note caller="-" style="x"><char style="xo" closed="false">6:17-18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luqa 3:19-20</ref></char></note><verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Herodiyaada hessa gishshas hoollottada iza wodhisanaas koyadus shin dandayabeekku. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Gaasoykka Yohannisi xillonne geeshsha as gididayssa Herdoosi eriza gishshas Yohannisas babbeessinne iza naagees. Yohannisi yootizayssa Herdoosi siyidi hirgizaa gidikkoka izi yootizayssa wozinappe siyees.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Herdoosa yeleta gallas bonchchanaas dhoqqa shuumetas, ola wottadarata azaziza waannatassinne Galila biittan keehi erettiza gita asatas gibira kessides; hessika Herodiyaadis giiga gallas gidides. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Herodiyaadi macca naya gelada asaa sinththan mazamure yexxiin Herdoosanne izi xeygida asaa izi yeththay ufayssides. Kawozikka nayo, «Ne koyza miish ubbaa tana oychcha; ta nees immana» gides. <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Qasseka ta kawoteththa baggaa gididaakkoka ne oychchiko ubbaa ta nees immana giidi izis caaqqides.<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Naya elela kezada ba aayeyo, «Kawoza ay oychchoo?» gadus. Aayiyakka, «Xammaqiza Yohannisa hu7e qanxxada imma ga» gadus.<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Nayakka elela kezada kawozaakko gelada, «Xammaqiza Yohannisa hu7e keren woththada ne taas immana mala koyays» ga oychchadus.<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Kawoy he yo7ozan daro modhettides; gido attiin xeygettida imaththaa gishshassinne caaqqida qaalaa gishshas izis akkay gaanaas koyibeenna. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Hessa gishshas wottadaratappe issaa eeson kiittidi Yohannisa qoodhe qanxxidi iza hu7e ekki yaana mala azazides; izikka biidi qasho keeththaa giddon Yohannisa qoodhe qanxxides. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Hu7eza kerera ehidi nays immides; nayakka ba aayeys immadus. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Yohannisa kaallizaytikka hessa siyida mala yiidi Yohannisa aha ekki efidi moogida.<verse eid="MRK 6:29" /></para>
  <para style="s1">Yesusi Mizida Ichchashu Shii Asaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mato 14:13-21</ref>; <ref loc="LUK 9:10-17">Luqa 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Hessafe guye Hawaareti simmidi Yesusa achchan yuuyi aadhdhi ba ooththidayssanne ba tamaarsidayssa ubbaa izas yootida. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Daro asay yishenne bishe giza gishshas quma miza wodeykka beettibeenna; «Ane intte xalla tanara asi bayndaso biidi guuth shempi ekkite» gides. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Hessa gishshas istti barkka wogolon gelidi issi asikka bayndaso bida.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Istti bishin daroti be7idi tohora woththan isttafe sinththe aadhdhida. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesusi wogolozappe wodhdhiza wode daro derey shiiqi uttidayssa be7ides. Heemmizaadey baynda mehe mala gidida gishshas asaas qadhettides; daro yo7okka tamaarso oykkides.<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Tay 27:17</ref>; <ref loc="1KI 22:17">1Kawo 22:17</ref>; <ref loc="2CH 18:16">2Taari 18:16</ref>; <ref loc="EZK 34:5">Hizi 34:5</ref>; <ref loc="MAT 9:36">Mato 9:36</ref></char></note><verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />He wode gadey qammi qammi biza gishshas iza kaallizayti izakko shiiqidi, «Hayssi nu dizasoy bazzoko; gadeykka qammides. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Hayssa heeran asi dizaso biidi asay baas miza kath shammi maana mala asaa yedda» gida.<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Izi isttas zaaridi, «Asaas miza miish intte immite» gides. Isttika malalettidi, «Nuni biidi nam7u xeetu dinaarera kath shammidi hayssa asaas immizaakko gidandee?» gida.<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">He wode 200 dinaare demmanaas issi asi 200 gallas ooththanaas koshshees.</char></note><verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Izikka isttas, «Inttes ay keena ukeththi dizaakko ane biidi xeellite» giin istti bi xeellidi, «Ichchashu ukeththinne nam7u moley dees» gida.<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Hessafe kaallidi asaa cilila maata bolla butten butten utisana mala azazides. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Asaykka xeetu xeetunne ichchashu tammu ichchashu tammu gididi butten uttides. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Izikka ichchashu ukeththatanne nam7u moleta ba kushen oykkidi pude salo xeellidi anjjidinne ukeththaa menththi menththi asaas gishana mala bana kaallizaytas immides; nam7u moletakka ubba asaas shaakereththides. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Asay wurikka miidi kallides. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Yesusa kaallizayti asay kalli miin attidayssa tammanne nam7u leemate kumeth shiishshides. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Kaththaa mida asaappe attumasay xalla ichchashu shii.<verse eid="MRK 6:44" /></para>
  <para style="s1">Abba Bollara Yesusa Hemeta</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mato 14:22-33</ref>; <ref loc="JHN 6:15-21">Yoha 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Heerakka izi asaa moyzishe iza kaallizayti sinththatidi gede pinth Betesayda geetettizaso pinnana mala azazides. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Heeppeka istta aggaagidi woossanaas pude zuma bolla kezides.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Gadey qammiin wogoloy abbaa giddon dishin izi barkka biitta bolla dees. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Abbaa bolla carkoy keehi metida gishshas iza kaallizayti abbaa shiri shiri wogolo laaggiza miishshaara baaxetishin Yesusi be7ides. Wontta bolla isttako yides; yiidinne istta achchara aadhdhi baanaaththo hanides. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Gido attiin aadhdhi baana hanishin iza be7ida mala moytille be7ida misatiin wurikka waassida. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Wurikka iza be7idi dagammida; izikka heerakka istta yoochchidi, «Aykkoy baa; tanakko dagammofte!» gides. <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Izikka wogolon isttako geliin carkoy co7u gides, isttika daro malalettida. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Kase izi ukeththan ooththida malaata birsheth istti erontta gishshas istta wozinay doccides.<verse eid="MRK 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Abbaa pinnidi Gensereexe geetettizaso gakkida; wogolaappe wodhdhidi wogoloza heen qachchidi aggi bida. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Istti wogoloppe wodhdhida mala asay Yesusa erides. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Wurikka ba dizaso dizaso woxerettidi harganchchata halan tookki tookki ekkidi Yesusi dizaso ehida. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Izi gakkida gutan woykko katama giddon woykko dere giddon gidiin harganchchati izi aadhdhishin iza woossidinne iza may7o bochchidi paxana mala shiishshi shiishshi dubbushay dizason woththida. Izi aadhdhi bishin iza may7o bochchidayti wuri paxida.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">Kase Ayhuda Aawata Woga</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mato 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Hessafe guye Farsaawetinne Yerusalaameppe yida issi issi xaafeti Yesusa lanqen yuuyi aadhdhida. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Yesusa kaallizaytappe baggayti meecettontta qita kushera kath mishin be7ida.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Farsaawetinne kase cima Ayhuda asati kase dere woga naaganaas kushe lo7eththi meecettontta kath mi erettenna. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Giya bi simmikokka bolla meecetti geeyontta dishe kath mi erettenna. Hessaththoka wancaka, otokka, kerekka, ichchiza hiiththeka meechcha mala hara wogatakka naageettes.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Farsaawetinne xaafeti Yesusa, «Nena kaallizayti kase aawata wogaa mala duus aggidi aazas kushe meecettontta kath mizoo?» giidi oychchida.<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Izikka isttas,</para>
  <para style="q2" vid="MRK 7:6">«Isayaasi qoodheppe qommon</para>
  <para style="q2" vid="MRK 7:6">haniza intte gishshas,</para>
  <para style="q2" vid="MRK 7:6">‹Hayssi derey</para>
  <para style="q2" vid="MRK 7:6">ba metershan xalala</para>
  <para style="q2" vid="MRK 7:6">tana bonchchees;</para>
  <para style="q2" vid="MRK 7:6">wozinay gidikko</para>
  <para style="q2" vid="MRK 7:6">taappe haakkides.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Taas mela hada goynnees;</para>
  <para style="q2" vid="MRK 7:7">istta timirteyka</para>
  <para style="q2" vid="MRK 7:7">asi woththida woga xalla›</para>
  <para style="q2" vid="MRK 7:7">giidi yootidayssi tuma» gides.<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Xoossa wogaa aggidi asi woththida wogaa naageettes. <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />Qasseka, «Intte wogaas giidi Xoossa wogaa intte aggaagiza cinccateththa ogey inttes dees. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Ays giikko Musey, ‹Ne aayonne ne aawaa bonchcha; ba aayonne ba aawaa cayizaadey mulekka hayqqo› gides.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>; <ref loc="LEV 20:9">Lewe 20:9</ref></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Gido attiin intte qasse, ‹Issi asi ba aawaa woykko ba aayo intte taappe demmanaas koshshiza maado ta Xoossas immadis› giikko, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />intte qasse hayssaadey ba aawaska ba aayeysi hara aykkoka ooththana mala koyekketa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Hessa gishshas intte wogaa naagana giidi Xoossa qaalaa laammeeta. Heytantta misatiza darota ooththeeta» gides.<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Qasseka Yesusi asaa baakko xeygidi, «Wurikka ta gizaa siyitenne wozinan woththite. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kareppe ulo gido gelidi as tunisiza issi miishshika deenna; harappeka ase tunisizay keeththa aawappe gede kare keziza miishsha. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Siyiza hayththi dizay siyo!» gides.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 16 bolla diza qofa gujjeettes.</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Izi asaa karen aggidi keeththe geliin iza kaallizayti izi yootida leemisoza birsheth Yesusa oychchida. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Izikka istta, «Intteska yo7oy gelennee? Kareppe gelidi ase tunisiza miishshi aazikka deenna. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kareppe gelizay gede wozinan gidontta duge qanththa giddo gelees; qasse heeppe izaade asateththaafe gede kare kezees» gides; Yesusi hessa giday asi miza kaththi wurikka geesh gididayssa qonccisanaassa.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Kaaleththidikka, «Asappe kezizaazi ase tunisees. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Asa wozina giddofe kezizay iita qofata, layma amonne kaysoteth, ase wodho, laymateth, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Yiiqeteth, iitateth, baleththo, layma kaas, qanaateteth, asa sunth mooro, otoreteththinne azalla. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Hayti iita hanoti wuri asappe kezeettessinne ase tuniseettes» gides.<verse eid="MRK 7:23" /></para>
  <para style="s1">Issi Maccassay Ammano</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mato 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesusi heeppe kezidi Xiroose geetettiza dere bides; heen issaade keeththe gelidi izi heen dizayssa asi erontta mala koyides. Gido attiin izi heen iza duussay qotettanaas dandayettibeenna.<verse eid="MRK 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 7:25" />Heerakka issi tuna ayanay oykkida guuththa naa dizaari aaya Yesusi heen dizayssa siyada izakko yaada iza toho bolla kundadus. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Maccassaya Girike qaala haasayza maccas shin iza yelettidasoy Sirofinqe geetettees. Izakka Yesusi nayppe tuna ayana kessana mala woossadus. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesusi zaaridi izis, «Nayta quma ekki kanas yegganaas bessontta gishshas koyro nayti mi kalletto» gides.<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Izakka zaarada, «Ee Godoo! Kanatikka maadda matan de7idi nayta kusheppe gaden wodhdhidayssa meettes» gadus.<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Izikka, «Histtiko neni hessa gida gishshas ba! Daydanththay ne nayppe kezides» gides. <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Iza simmada soo bishin naya daydanththay yeddiin paxada hiixan ichchidaaro demmadus.<verse eid="MRK 7:30" /></para>
  <para style="s1">Yesusi Paththida Doona Duudenne Hayththa Tulle Addeza</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Hessafe Yesusi Xiroose biittafe dendidi Sidoona geetettizasora aadhdhi tammu katama geetettizasora kanththidi gede Galila Abbaako gakkides. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Asay issi hayththa tullenne doona duude as izakko hee ekki yiidi Yesusi iza bolla ba kushe woththana mala woossida.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yesusikka iza asaappe shaakki ekki biidi ba kushe biradhdheta addeza hayththan gelththides; qasseka cuch cuttidi addeza inxars bochchides. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Pude salo xeellidinne tookki shempidi, «Efta» gides. Hessika, «Pogetta» guussa. <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Heerakka addeza hayththati pogettida; inxarsayka birshettiin geeshshi haasaydes.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Yesusi hayssa be7idayti oonaska yootontta mala azazides; gido attiin asay izi azazizadayssafe bollara keehi gujjidi yootides. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Derezikka keehi malalettidi, «Izi ooththidayssi wuri lo7o; tulleti siyana mala, doona duudeti haasayana mala ooththides» gida.<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">Yesusi Oyddu Shii As Mizides</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mato 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />He wode qasse daro asi shiiqides. Shiiqida asaas miza kaththi baynda gishshas Yesusi bana kaallizayta xeygidi, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />«Hayti asati tanara heedzdzu gallas gakkanaas gam7ida gishshassinne qasseka isttas miza kaththi baynda gishshas tana miichcheettes. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Isttafe issi issi asati haahoppe yida gishshas hayssa gafara ta istta soo yeddiko daaburdi oge bolla kundana» gides.<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Iza kaallizaytikka zaaridi, «Hayssa bazzon hayssa mala dere mizana quma awappe demmanee?» gida.<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Izikka istta, «Inttekon aappun ukeththi dizee?» gi oychchides. Isttika, «Laappun ukeththi dees» gida.<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Izikka asay gaden uttana mala azazides; laappun ukeththaa ba kushen oykki galatidinne menththidi asaas gishechchana mala bana kaallizaytas immiin isttika derezas gishida. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Qasseka heen diza qeeri guuththa moleta gishshas Xoossaa galatidi guuththa moleta asaas gishechchana mala bana kaallizayta azazides. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Dereykka miidi kallides. Hessafekka iza kaallizayti maaddaafe palahida kath laappun leemate kumeth denththida. <verse eid="MRK 8:8" /><verse number="9-10" style="v" sid="MRK 8:9-10" />Hessa mida asay oyddu shii gidana. He asaa moyzidi bana kaallizaytara wogolon gelidi gede Dalmanuuta geetettizaso bides.<verse eid="MRK 8:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Farsaaweti yiidi Yesusara palameteth oykkida; iza paaccanaas koyidi banttana saloppe malaata bessana mala oychchida.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mato 12:38</ref>; <ref loc="LUK 11:16">Luqa 11:16</ref></char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Izikka tookki shempidi, «Hayssi yeletazi aazas malaata koyzee? Ta inttes tuma gays; hayssa yeletaas issi malataykka imettenna» gides.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mato 12:39</ref>; <ref loc="LUK 11:29">Luqa 11:29</ref></char></note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Istta heen aggidinne wogolon gelidi he pinth pinnides.<verse eid="MRK 8:13" /></para>
  <para style="s1">Farsaaweta Irshonne Herdoosa Irsho</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mato 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Iza kaallizayti kath oykkontta balettida gishshas issi ukeththi attiin wogolo giddon hara ay kaththika deenna. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesusi istta, «Farsaaweta irshofenne Herdoosa irshofe naagettite» giidi azazides.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luqa 12:1</ref></char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Istti qasse ba giddon issoy issaara, «Izi nuna hayssa gizay nuus kaththi baynda gishshassa» gi haasayettida.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Qasse Yesusi istta qofaa eridi, «Nuus kaththi baynda gishshas gaasa giidi intte giddon aazas haasayetteetii? Ha7ikka yuushshi qoppeketii? Wozinankka woththekeetii? Woykko intte wozinay shuchchatidee? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Inttes ayfey dees shin xeelleketii? Hayththi dees shin siyekketii? Akeekekketii?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Er 5:21</ref>; <ref loc="EZK 12:2">Hizi 12:2</ref>; <ref loc="MRK 4:12">Mar 4:12</ref></char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Ichchashu ukeththaa ichchashu shii asaas ta menththa immiin aappun leemate kumeththa kath denththidetii?» gides.</para>
  <para style="p" vid="MRK 8:19">Isttika zaaridi, «Tammanne nam7u» gida. <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />Izikka, «Laappun ukeththaa oyddu shii asaas ta menththa immiin aappun leemate kumeththa kath denththidetii?» gi oychchiin isttika, «Laappun» gida.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Izikka isttas, «Histtiin ha7i gakkanaas yuushshi qoppibeekketakkaa!» gides.<verse eid="MRK 8:21" /></para>
  <para style="s1">Yesusi Betesaydan Paththida Qooqe Addeza</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Hessafe gede Betesayda geetettizaso bida; guuththa asatikka ayfe qooqe as Yesusaakko ehidi Yesusi iza bochchana mala woossida. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Izikka he qooqeza kushe oykki goochchidi asi dizasoppe gede kare kessidi addeza ayfen cuttidinne ba kushe iza bolla woththidi, «Ha7i nees aazi beettizee?» gi oychchides.<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Izikka dhoqqu gi xeellidi, «Asay mith misatidi qaaxettishe beettes» gides.<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Qasseka Yesusi ba kusheta iza ayfeta bolla woththides; heerakka iza ayfeti xeellida; poo7oykka izas simmiin wursika geeshshi xeellides. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Qasse, «Ha gutata giddo geloppanne oonaska yootoppa» giidi iza gede izaso yeddides.<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Gi7ize Caaqo Ooraththa Maxaafazi 1,947 maaroteththa layththan xaafettida Amaraththo Geeshsha maxaafazinne issi issi beni Girike qaalan xaafettida Geeshsha Maxaafati hayssafe kaalliza qofaa gujjeettes; histtiko hayssa oonaska yootoppa.</char></note><verse eid="MRK 8:26" /></para>
  <para style="s1">Yesusi Xoossafe Kiitettidaade Gididayssas Phexroosa Markkateth</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mato 16:13-20</ref>; <ref loc="LUK 9:18-21">Luqa 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesusi bana kaallizaytara Qisaariya Piliphisiyoose geetettiza dere achchan diza gutata bides; istti oge bolla dishin bana kaallizayta, «Tana asay oona gizee?» giidi oychchides.<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Isttika zaaridi nena, «Xammaqiza Yohannisa gizaytikka deettes, baggayti qasse Eelaasa geettes; harati qasse nabetappe issaade geettes» giidi yootida.<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">Mar 6:14-15</ref>; <ref loc="LUK 9:7-8">Luqa 9:7-8</ref></char></note><verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Kaaleththidikka, «Inttech tana oona geetii?» giidi oychchides. Phexroosi, «Neni Kirstoosa» gides.<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Yesusikka ba gishshas oonaska istti yootontta mala minththi yootides.<verse eid="MRK 8:30" /></para>
  <para style="s1">Yesusi Ba Hayqqanayssa Kasetidi Yootides</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mato 16:21-28</ref>; <ref loc="LUK 9:22-27">Luqa 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Hessafe Yesusi bana kaallizayta, «Asa Nay daro waaye beyanayssanne dere cimatan, qeeseta halaqaninne xaafetan kadhettana; asa kushen hayqqana, hayqoppe heedzdzanththo gallas dendana bessees» giidi tamaarso oykkides. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Izikka hessa isttas qonccisi yootides, Phexroosikka iza dumma shaakki efidi, «Hessaththo gooppa!» giidi hanqides.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Yesusi qasse bana kaallizayta yuushshi xeellishe Phexroosa, «Haysso Xala7e ne taappe gede guye ba! Neni asazaappe attiin Xoossaaz qoppaka!» giidi hanqides.<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Hessafe guye asaa bana kaallizaytara issife baakko xeygidi, «Tana kaallanaas dosizaadey diikko bana kaddo; ba masqale tookkidi tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mato 10:38</ref>; <ref loc="LUK 14:27">Luqa 14:27</ref></char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Ba shempo ashshana dosizaadey dhayssana shin ta gishshassinne ta Mishiraachcho qaalaa gishshas ba shempo dhayssizaadey wurikka ashshana.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mato 10:39</ref>; <ref loc="LUK 17:33">Luqa 17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref></char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Asi alame kumeth haarikkonne ba shemppo dhayssiko iza ay go7anee? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Woykko asi ba shempo gishshas laame ekkanay aazi dizee?<verse eid="MRK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 8:38" />«Hayssa laymanne nagaranchcha yeleta giddon dishe tananinne ta qaalan yeellatiza asi wuri ta Asa Nay ta Aawaa bonchchoranne Geeshsha Kiitanchchatara yiza wode izan yeellatana» gides.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Kaaleththidikka Yesusi «Ta inttes tuma gays; hayssan eqqida asaappe Xoossa kawoteththi wolqqara yishin beyana gakkanaas hayqqontta gam7ana issi issi asati deettes» gides.<verse eid="MRK 9:1" /></para>
  <para style="s1">Yesusa Medha Laameteth</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Usuppun gallassafe guye Yesusi Phexroosa, Yaaqoobenne Yohannisa banara kaaleththi ekkidi issi gita zuma bolla kezides. Istti barkka dishin istta sinththan iza medhay laametti wodhdhides.<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2Phex 1:17-18</ref></char></note> <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Izi may7ida may7oy biitta bolla oonikka may7o meeccidi hessa mala booththanaas dandayontta booth boottides. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />He wode Eelaasinne Musey Yesusara haasayettishe isttas beettida.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Phexroosi Yesusa, «Astamaaree! Nuni haan hayssan dizaakko nuus lo7o; nees issi daase, Muses issi daase, qasse Eelaasas issi daase, heedzdzu daaseta nu ooththikochchii?» gides. <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Daro babbida gishshas Phexroosi ba gizayssa eridi gibeenna.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Heerakka shaaray istta kammiin shaara giddora, «Hayssi ta dosiza ta naazakko! Izi gizaa siyite» giza qaala giirissi yides.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mato 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref></char></note><verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Heerakka istti yuushshi xeelliin Yesusappe attiin oonikka hara asi isttara deenna.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Istti zuma bollafe duge wodhdhishin Asa Nay hayqoppe dendana gakkanaas hayssa istti be7idayssa oonaska yootontta mala azazides. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Isttika baas yootida qaala ba wozinan oykkida shin, «Hayqoppe dendo guussi ay guussee?» giidi ba giddon haasayettida.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Qasse istti Muse wogaa tamaarsizayti, «Kasetidi Eelaasi yaana koshshees aazas gizoo?» giidi iza oychchida.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil 4:5</ref>; <ref loc="MAT 11:14">Mato 11:14</ref></char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesusi isttas, «Tumukka Eelaasi kaseti yiidi wursika giigsana. Histtiinkka Asa Nay daro waaye ekkanaassinne kadhettanaas bessees geetetti xaafettidayssi inttes ay misatizee? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Gido attiin ta inttes gizay Eelaasi gidikko yides shin asaykka iza gishshas xaafettida mala bana koshshida mala iza bolla ooththides» gides.<verse eid="MRK 9:13" /></para>
  <para style="s1">Yesusi Iita Ayanappe Paththida Naaza</para>
  <para style="r">(<ref loc="MAT 17:14-20">Mato 17:14-20</ref>; <ref loc="LUK 9:37-43">Luqa 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Geedon attida Yesusa kaallizaytakko istti simmi yishin daro asay istta giddoththiin Muse wogaa tamaarsizayti isttara palamettizayssa be7ida. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Derey iza demmida mala malalettidi sarokkanaas izakko woxxides.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Izikka istta, «Intte isttara aaza gishshas palameteetii?» giidi oychchides.<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Asaa giddofe issaadey, «Astamaaree! Tuna ayanay izan geliin doona duudida ta naa dayssa ta neekko ekka yadis. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ayanazi dendiza wode bollafe yeggees; doonara goppontto kessi kessi yeggees; achchaaka garccees; asateththaaka zoodisees; tuna ayana kessetto gaada nena kaallizayta ta yootiin isttika dandaybeettenna» gides.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesusikka isttas zaaridi, «Intteno ammanontta yeletatoo, ayde gakkanaas ta inttenara daanee? Qasse ayde gakkanaas ta inttena dandayanee? Ane naaza haa ehite» gides. <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Asaykka naaza izakko ehides, tuna ayanay Yesusa be7ida mala naaza heerakka gaden genderisidi kokkorisidinne doonara goppontto coppu histtides.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yesusi naaza aawaa, «Hayssi hargey iza ayidesappe oykkidee?» gides. Naaza aawaykka, «Naateththafe doommidi» gides. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />«Iza wodhanaas koyidi daro wode tamankka haaththankka yeggees. Nees dandayettiko nuus mishettanne nuna maadda» gides.<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesusi qasse, « ‹Nees dandayettiko› gay? Ammanizaades wurikka dandayettees» gides.<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Naaza aaway heerakka, «Ta ammanays shin ta ammanoy laafa, tana maaddarkkii!» giidi waassides.<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Asay wocamishe buuretti ekkidi izakko yizayssa Yesusi be7idi, «Haysso tullenne duude ayanazoo! Hayssa naazappe keza, ne qasse simmada gelontta mala ta nena azazays» giidi tuna ayanaa seerides.<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Tuna ayanazikka keehi waassides; naazikka keehi qakettidaappe guye naazappe kezides. Daroti hayqqides gaana gakkanaas naazi aha misatides. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Gido attiin Yesusi naaza kushe oykki denththides; naazikka dendi eqqides.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Yesusi soo gelidaappe guye iza kaallizayti, «Nu izappe tuna ayana kessanaas aazas dandaybeekkonii?» giidi iza oychchida.<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Izikka isttas, «Hayssa malay kezana dandayzay woosaninne xooman xalla» gides.<verse eid="MRK 9:29" /></para>
  <para style="s1">Yesusi Ba Hayqo Gishshassinne Ba Dendo Gishshas Qasseka Yootides</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mato 17:22-23</ref>; <ref loc="LUK 9:43-45">Luqa 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Heeppe dendidi Galila baggara aadhdhi bida; Yesusi ba dizaso oonikka erana mala koyibeenna. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />Gaasoykka Yesusi bana kaallizaytas, «Asa Nay asa kushen aadhdhi imettana; isttika iza wodhana, heedzdzanththo gallassafe guye izi dendana» giidi istta tamaarsiza gishshassa. <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Gido attiin izi gizayssi isttas gelibeenna; iza oychchanaaska babbida.<verse eid="MRK 9:32" /></para>
  <para style="s1">Ubbaafe Aadhdhizay Oonee?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mato 18:1-5</ref>; <ref loc="LUK 9:46-48">Luqa 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Hessafe guye Qifirnahoome bida; izi keeththe gelidi, «Intte yishe oge bolla aaza gishshas palamettidetii?» gi oychchides.<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Istti qasse oge bolla, «Nu giddon nuuppe ubbaafe aadhdhizay oonee?» giidi palamettida gishshas wurikka co7u gida.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa 22:24</ref></char></note><verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Izi uttidaappe guye tammanne nam7ata xeygidi, «Koyro gidana koyzaadey ubbaafe wurseththinne ubbatas ashkara gido» gides.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mato 20:26-27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43-44">Mar 10:43-44</ref>; <ref loc="LUK 22:26">Luqa 22:26</ref></char></note><verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Qii guuththa naa ehidi istta giddon essides. Idimmidi, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />«Hayta guuththa naytappe issaade ta sunththan mokki ekkizaadey tanakka mokki ekkees; tana mokki ekkizaadey wuri tana xalala gidontta tana kiittidayssaka mokki ekkees» gides.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mato 10:40</ref>; <ref loc="LUK 10:16">Luqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref></char></note><verse eid="MRK 9:37" /></para>
  <para style="s1">Nuna Ixxonttay Wuri Nu Bagga</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luqa 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohannisikka, «Astamaaree! Issaadey ne sunththan daydanth kessishin nu beydos. Izi nuna kaallontta gishshas kessontta mala diggidos» gides.<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yesusi qasse, «Diggofte; oonikka ta sunththan malaata ooththidi eesotidi ta bolla iita haasayanaas dandayenna. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Nunara eqettonttay wuri nunara dees.<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mato 12:30</ref>; <ref loc="LUK 11:23">Luqa 11:23</ref></char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ta inttes tumu gays; intte tiyettida Kirstoosas gidida gishshas ta sunththan issi wanca haath inttena ushshidaadey wuri ba oosoys waaga dhayenna.<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mato 10:42</ref></char></note><verse eid="MRK 9:41" /></para>
  <para style="s1">Asas Dhuphe Gidanaappe Naageteth</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mato 18:6-9</ref>; <ref loc="LUK 17:1-2">Luqa 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />«Hayta tana ammaniza ha guuththatappe issaades dhuphe gidizay wuri deexo woxa shuchchi iza qoodhen qashettiin duge abba gido olettidaakko izas lo7o gidana. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Hessa gishshas ne kushey nena baleththiko neeppe qanxxa yegga; nam7u kushera daada gede Gaanname taman ne baanayssafe kushe duuxa gidada gede de7on geloy nees lo7o gidana.<note caller="-" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mato 5:30</ref></char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Gaannamen guxuney hayqqenna, tamaynne to7enna.<note caller="+" style="f"><char style="fr" closed="false">9:44,46 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 44nne 46 bolla diza qofa gujjeettes; qofazikka taybo 48 bolla dizayssa misatees.</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nena ne tohoy baleththiko neeppe qanxxa digga; nam7u tohora daada gede Gaanname tamaan yegettanaappe ne wobbe gidada gede de7oso geloy nees lo7o. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Gaannamen guxuney hayqqenna, tamaynne to7enna. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nena ne ayfey baleththiko wooca kessada neeppe digga; nam7u ayfera daada gede Gaannamen yegettanaappe issi ayfera Xoossa Kawoteth geloy nees lo7o.<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mato 5:29</ref></char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Gaannamen guxuney hayqqenna tamaynne to7enna.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66:24</ref></char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />«Buro asi wuri taman paacettana.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />«Maxiney lo7o; gido attiin maxiney ba maxineteththaa yeddiko intte wostti iza mal7o eranee? Intte asateththan maxiney de7o. Intte intte giddon dosettite» gides.<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Mato 5:13</ref>; <ref loc="LUK 14:34-35">Luqa 14:34-35</ref></char></note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Machcho Anjji Yeddanaas Bessenna</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mato 19:1-12</ref>; <ref loc="LUK 16:18">Luqa 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesusi heeppe dendidi gede Yuhuda geetettiza derenne Yordaanoose shaafappe pinththan diza dere bides. Dereykka qasse iza yuuyi aadhdhiin izi kase ba ooththiza mala asaa tamaarsides.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Issi issi Farsaaweti izakko yiidi, «Asi ba machcho anjji yeddanaas bessizee?» giidi iza paace oysho oychchida.<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Izikka isttas, «Musey inttena ay gi azazidee?» giidi zaari oychchides.<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Isttika izas, «Musey ta izo anjja yeddadis giza waraqata xaafi immidi anjjo gides» gida.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Zaare 24:1-4</ref>; <ref loc="MAT 5:31">Mato 5:31</ref></char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesusikka zaaridi istta, «Musey hayssa mala woga xaafidayssi intte wozinay minnida gishshassa. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Gido attiin koyro Xoossi medhdhishe maccanne adde ooththi medhdhides.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medhe 1:27</ref>; <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Hessa gishshas asi ba aawaanne ba aayo aggidi ba machchira waaxettees. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Nam7ay issi asho gideettes; hessa gishshas istti nam7ay issinoppe attiin nam7u deettenna. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Hessa gishshas Xoossi gaththi waaxidayta asi shaakkofo» gides.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Qasseka istti soo geliin iza kaallizayti he yo7oza gishshas zaari iza oychchida. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Izi isttas, «Oonikka ba machcho anjji yeddidi hara maccas ekkiko he maccassay bolla layma ooththees. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Maccassayakka ba azina aggada hara adde gelikko izakka laymatawus» gides.<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mato 5:32</ref>; <ref loc="1CO 7:10-11">1Qoro 7:10-11</ref></char></note><verse eid="MRK 10:12" /></para>
  <para style="s1">Yesusi Guuththa Nayta Anjjides</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mato 19:13-15</ref>; <ref loc="LUK 18:15-17">Luqa 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Yesusi ba kushe woththana mala asay nayta izakko ehides. Iza kaallizayti qasse ehida asaa bolla hanqettida. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesusi hessa beyi hanqettidi, «Nayti taakko yetto; diggofte; Xoossa Kawoteththi haytantta malassa. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ta inttes tumu gays; Xoossa Kawoteth hayssa guuththa nayta mala ekkonttaadey izin mulekka gelenna» gides.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mato 18:3</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Nayta idimmidi istta bolla ba kushe woththidi anjjides.<verse eid="MRK 10:16" /></para>
  <para style="s1">Issi Dure Adde</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mato 19:16-30</ref>; <ref loc="LUK 18:18-30">Luqa 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Heeppe buro oge kezishin issaadey woxxishe izakko gakkidinne iza sinththan gulbatidi, «Kiya astamaarentoo! Tani mernaa de7o demmana mala ay ooththana taas bessizee?» gi oychchides.<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesusikka, «Aazas tana kiya gay? Issi Xoossafe attiin kiyay baa» gides. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />«Neni azazota eray? ‹Wodhoppa; laymatoppa; kaysotoppa; wordo markkattofa; as baleththofa; ne aawaanne ne aayo bonchcha› gizayta» gides.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kessa 20:12-16</ref>; <ref loc="DEU 5:16-20">Zaare 5:16-20</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Addezikka zaaridi, «Astamaaree! Ta hayta wursa naateththafe oykkada naagadis» gides.<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesusi iza xeellidinne dosidi, «Histtiko ha7i nees issi miishshi paccees. Baadanne nees dizaa wursa bayza; miishshaa manqotas imma; neni salon shiiqida miish demmandasa; histtadanne haa yaada tana kaalla» gides. <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Addezikka hessa siyidi daro yiillotides; izas daro aqotay diza gishshas muuzottishe bides.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesusi yuushshi aaththi xeellidi bana kaallizayta, «Duretas Xoossa Kawoteth geloy ay mala deexoo!» gides.<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Iza kaallizaytikka iza haasayan malalettida; Yesusi qasse zaaridi, «Naytoo! Xoossa Kawoteth geloy ay mala deexo miishshee! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Durey Xoossa kawoteth gelanayssafe gaamellay narpe lukora aadhdhanayssi kawuyana!» gides.<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Iza kaallizaytikka darssi malalettidi ba giddon issoy issaa, «Histtiin ooni attana dandayzee?» gida.<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesusi istta xeellidi, «Hayssi asas dandayettenna; Xoossa matan gidikko hessa mala gidenna. Xoossas wurikka dandayettees» gides.<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Phexroosi qasse, «Hekko; nuni wursika aggidi nena kaallidos» gides.<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesusikka zaaridi, «Ta inttes tumu gays; ta gishshassinne Mishiraachcho qaalaa gishshas giidi ba keeththe, woykko ba ishata, woykko ba michcheta, woykko ba aayo, woykko ba aawaa, ba nayta, woykko ba gade aggida asi wuri, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />hayssa ha wodezan ha7i goodeteththara keeththata, ishata, michcheta, aayeta, naytanne gadekka xeetu kushe aaththi ekkonttaynne buro yaana alamezankka mernaa de7o laattonttaadey deenna. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Gido attiin sinththatida daroti guyetana; guyetidayti sinththatana» gides.<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mato 20:16</ref></char></note><verse eid="MRK 10:31" /></para>
  <para style="s1">Yesusi Ba Hayqqi Dendanayssa Heedzdzanththo Yootides</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Istti Yerusalaame efiza oge bolla dishin Yesusi isttafe sinththe sinththe bees. Iza kaallizayti iza buussaan malalettida. Hankko iza gaason diza asay qasse izas babbides; qasseka tammanne nam7ata derezappe dumma shaakkidi ba bolla aazi gakkanaakkon isttas hizgi yootides; <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />«Nuni Yerusalaame kezana; Asa Nay qeeseta halaqatassinne Muse wogaa tamaarsizaytas aadhdhi imettana; isttika iza bolla hayqo pirda pirdananne dere asaas aaththi immana. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Iza bolla qidhi kaa7ana; iza bolla cuttana; izakka garafananne wodhanashin izi heedzdzu gallassafe guye hayqoppe dendana.»<verse eid="MRK 10:34" /></para>
  <para style="s1">Yaaqoobeynne Yohannisi Woossida Woosa</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mato 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Qasse Zabdoosa nayti Yaaqoobeynne Yohannisi izakko shiiqidi, «Astamaaree! Nuni nena woossidayssa ne nuus wursa ooththana mala nu koyoos» gida.<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Izikka isttas, «Ta inttes ay ooththana mala koyeetii?» gides. <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Isttika, «Neni ne kawoteththa bonchchon diza wode nuuppe issaadey ne ushachchan, issaadey ne hadirsan uttana mala nuus ero garkkii?» gida.<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yesusikka, «Intte oychchizayssa erekketa; tani uyana ushshaa uyanaassinne tani xammaqettiza xinqataa intte xammaqettanaas dandayandetii?» gides.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luqa 12:50</ref></char></note> <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Isttika zaaridi, «Ee, dandayoos» gida. Yesusikka, «Ta uyiza ushshaa intte uyananne ta xammaqettiza xinqataa intte xammaqettana. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Gido attiin ta ushachchara woykko ta hadirsara uteththi Xoossi isttas giigsidaytas attiin ta immana miish gidenna» gides.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Tammati hessa siyidi Yaaqoobenne Yohannisa bolla hanqettida. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesusikka istta issi bolla shiishshidi, «Dere halaqa geetettizayti dere haarizayssa mala istta shuumeti istta bolla ba godateth bessizayssa intte ereeta. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Gido attiin intte giddon gita gidana koyza ubbay ashkara gido.<note caller="-" style="x"><char style="xo" closed="false">10:42-43 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luqa 22:25-26</ref></char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Sinththe aadhdhana koyzay wurikka ubbaas aylle gido. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Asa Nay gidikko asas ooththanaassinne ba shempo darota gishshas aaththi immanaas yides attiin ase oosisanaas yibeenna» gides.<verse eid="MRK 10:45" /></para>
  <para style="s1">Barxemoosa Ayfe Paxeteth</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mato 20:29-34</ref>; <ref loc="LUK 18:35-43">Luqa 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Heeppe gede Iyarkko bida; Yesusinne iza kaallizayti hara daro asatara Iyarkkofe kezishin Ximoosa naa Barxemoosa geetettiza ayfe qooqey oge bolla uttidi woossees. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Izikka yizay Naazirete Yesusa gididayssa siyidi, «Dawite naa Yesusa tana maara» giidi keehi waassides.<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Daroti izi co7u gaana mala hanqida; gido attiin izi, «Dawite nawu! Tana maara» giidi keehi waassides.<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesusikka eqqidi, «Iza haa xeygite» gides. Isttika qooqeza, «Aykkoy baa denda nena xeygees» gida. <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Izikka ba may7o qaari yeggidi pusukku gi dendi eqqidi Yesusaakko yides.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesusikka, «Ta nees ay ooththana mala koyay?» gides. Qooqezikka, «Astamaarentoo! Ta xeellana koyays» gides.<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesusikka zaaridi, «Ba nena ne ammanoy paththides» gides. Heerakka iza ayfey xeellides. Izikka Yesusa kaalli bides.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">Gita Bonchchora Yesusi Yerusalaame Buus</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mato 21:1-11</ref>; <ref loc="LUK 19:28-40">Luqa 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoha 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Istti gede Yerusalaamen Dabrazayte geetettiza zuma achchan diza Betefaagenne Bitaaniya geetettizaso matida wode Yesusi bana kaallizaytappe nam7ata, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />«Gede intte sinththan diza gutayo biite. Intte he gelida mala heen asi toggi erontta qashon diza hare gutte intte demmana; birshidi iza haa ekki yiite. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Oonikka inttena, ‹Hayssa ays ooththeetii?› giikko Godaas koshshees giidi yootite; izikka inttes eeson zaari yeddana» gi kiittides.<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Isttika biidi issi keeththa karen oge bolla qashetti diza hare gutte demmidi birshida. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Heen eqqida issi issi asati, «Hare gutteza aazas birsheetii?» gi oychchida.<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Yesusa kaallizayti Yesusi isttas gida mala asatas yootiin ero ekki biite gida. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Guttezakka Yesusaakko ehidi ba may7o iza zokko bolla yeggiin Yesusi iza toggides. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Daro asay ba may7o kessi kessi oge bolla miccides. Bagga asay cilila miththa hayth qanxxi qanxxidi oge bolla laallides. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Yesusappe sinththaranne guyera diza asay qaala dhoqqu histtidi,</para>
  <para style="q1" vid="MRK 11:9">«Hoosa7inna;</para>
  <para style="q2" vid="MRK 11:9">Godaa sunththan</para>
  <para style="q2" vid="MRK 11:9">yizaadey anjjettidaade.<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Hanna yizaara nu aawaa</para>
  <para style="q2" vid="MRK 11:10">Dawite kawoteththaya</para>
  <para style="q2" vid="MRK 11:10">anjjettidaaro;</para>
  <para style="q2" vid="MRK 11:10">hoosa7inna!</para>
  <para style="q2" vid="MRK 11:10">Bolla salon</para>
  <para style="q2" vid="MRK 11:10">Xoossi bonchchetto»</para>
  <para style="q2" vid="MRK 11:10">gishe waassides.<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesusi Yerusalaame gakkidi hessafekka Xoossa Keeththe gelides. He heeran dizayssa ubbaa xeellidi gadey qammida gishshas tammanne nam7atara gede Bitaaniya kezides.<verse eid="MRK 11:11" /></para>
  <para style="s1">Yesusi Qanggida Balase Miththayo</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mato 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Wonteththa gallas istti Bitaaniyappe kezi bishin Yesusi gafides. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Izi issi hayththi cililida balase geetettiza miththi haahon be7idi ayfey daanakkon giidi izikko yides. Gido attiin balase miththi ayfontta wode gidida gishshas hayththafe attiin issi ayfekka izippe demmibeenna. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Hessa gishshas miththayo, «Hannife guye mernaas oonikka neeppe ayfe mooppo!» gides. Iza kaallizaytikka izi gizayssa siyida.<verse eid="MRK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Gede Yerusalaame bida; heeppeka Xoossa Keeththe gelidi heen bayzizaytanne shammizayta kessi goodo oykkides. Miishshe laammizayta xaraphpheezanne haraphphe bayzizayta oyde gufanththi gufanththi yeggides. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Oonikka ay miish tookkidi Xoossa Keeththa gibbe giddora aadhdhontta mala diggides. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Isttaka tamaarsishe, «Ta keeththi dere ubbaas Woosa Keeththe gidana geetetti xaafettibeennee? Gido attiin intte kaysota gongolo kessideta» gides.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Er 7:11</ref></char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Qeeseta halaqatinne Muse wogaa tamaarsizayti hessa siyidi iza wostti dhayssanakkon oge kosh oykkida. Gido attiin dereykka iza timirtezan malalettida gishshas izas babbida.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Isttika gadey qammiin katamayppe kezi bida.<verse eid="MRK 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Wonteththa gallas maalado istti ogera aadhdhi bishin balase miththaya xaphoppe melidaaro be7ida. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Yo7ozi iza wozinan akeekettiin Phexroosi Yesusa, «Astamaaree! Hekko, hanna ne qanggida balaseya meladus» gides.<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Izikka zaaridi, «Xoossa ammanite. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ta inttes tumu gays; ‹Oonikka hayssa zumaza ne dhoqallettada abban gela› gizaakko hessaka wozinan sidhontta ammanidaakko izaades hanana.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mato 17:20</ref>; <ref loc="1CO 13:2">1Qoro 13:2</ref></char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Hessa gishshas intte woosan oychchidaaz ubbaa ekkida mala ammanikko inttes hanana. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Hessaththoka intte woosas eqqiza wode intte Salo Aaway intte nagara atto gaana mala intteka inttena qohidayta nagara ubbaa atto giite. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Intte atto gontta ixxiko intte salo aawaykka intte nagaraa atto geenna» gides.<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 26 bolla diza qofaa gujjeettes.</char></note><note caller="-" style="x"><char style="xo" closed="false">11:25-26 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">Mato 6:14-15</ref></char></note><verse eid="MRK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Qasseka Yerusalaame yida; Yesusi Xoossa Keeththa kare giddon yaanne haa yuuyettishin qeeseta halaqati, Muse wogaa tamaarsizaytinne dere cimati izakko shiiqidi, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />«Hayssa ne ooththizay ay godateththaraa? Hayta ne ooththana mala hayssa mala godateth nees ooni immidee?» gida.<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesusikka isttas zaaridi, «Ane tanikka inttena issi oysho oychchays; intteka taas zaarikko tanikka ha yo7ota ay godateththara ooththizaakko inttes yootana. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Yohannisa xinqatay Xoossafeyee? Asappee? Ane taas zaarite» gides.<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Isttika ba giddon issoy issaara, «Nu saloppe giikko izi nuna, ‹Histtiin aazas iza ammanibeekketii?› gaana; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />‹Nu asappe› giikko» Yohannisi tumu nabe gididayssa derey wuri ammaniza gishshas hessaththo gaana babbida.<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Hessa gishshas, «Nu erokko» giidi Yesusas zaarida. Yesusikka, «Histtiko ta hayta aaza godateththara ooththizaakko tanikka inttes yootikke» gides.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">Woyne Mith Tokkiza Goshsha Asata Leemiso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mato 21:33-46</ref>; <ref loc="LUK 20:9-19">Luqa 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Qasse isttas leemisora yootishe, «Issaadey ba woyne mith tokkides. Keela yuushshi aaththi keelides; woyne miththa ayfe gum7ana olla bookkides. Naage keeththeka keexxides. Hessafe goshshanchchatas kira immidi hara dere bides. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Miththay ayfiza wode woyne miththaa ayfe ekkada ya giidi ashkaratappe issaade goshshanchchatakko yeddides.<figure style="fig" alt="Woman with child bringing grapes to wine press" file="LB00103B.TIF" size="span" ref="12:2">Maccassi ba naara woyne gum7izasoho woyne ayfe ehishin</figure> <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Goshshanchchati ashkaraza oykki shocidi coo mela kushe yeddida. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Nam7anththoka hara ashkara yeddides. Goshshanchchati ha7ikka ashkaraa oykkidi izas hu7etara qoo7idinne kawushshidi zaari yeddida. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Ha7ikka zaaridi hara ashkara yeddides. He yeddoyssaka wodhida; hara darota giddofe issi issi asata qoxxida; baggayta wodhida.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />«Ha7ikka kiitettontta attida haray dees; izikka aaway dosiza ba naaza. ‹Ta naaza istti boossana› gi qoppidi wurseththan ba naaza yeddides. <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Goshshanchchati qasse ba giddon, ‹Hayssi waanna iza laattana naaza; haa yiite nu iza wodhikko biittay nuus gidana› gida. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Hessa gishshas heen oykki wodhidi woyne miththay dizasoppe haraso kessi yeggida.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />«Histtiin woyne miththaa goday ay ooththana inttes misatizee? Izi yaana; goshshanchchatakka wodhana; woyne miththaa haratas immana. <verse eid="MRK 12:9" /><verse number="10-11" style="v" sid="MRK 12:10-11" />Geeshsha Maxaafan,</para>
  <para style="q2" vid="MRK 12:10-11">‹Shuchcha keeththe keexxizayti</para>
  <para style="q2" vid="MRK 12:10-11">hanenna giidi</para>
  <para style="q2" vid="MRK 12:10-11">wora yeggida shuchchay</para>
  <para style="q2" vid="MRK 12:10-11">keeththa gulas bolla hu7e gidides;</para>
  <para style="q2" vid="MRK 12:10-11">hessaka Goday ooththides.</para>
  <para style="q2" vid="MRK 12:10-11">Hessika nu ayfes malalisizaaz</para>
  <para style="q2" vid="MRK 12:10-11">geetettidi xaafettidayssa</para>
  <para style="q2" vid="MRK 12:10-11">nababibeekketii?› » gides.<note caller="+" style="f"><char style="fr" closed="false">12:10-11 </char><char style="ft" closed="false">Yochcha shuchchay, tuussi keeththe naagizayssa mala shuchcha keeththi kundontta mala naagizayssa.</char></note><note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Maza 118:22-23</ref></char></note><verse eid="MRK 12:10-11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Izi isttas leemisoza yootiday istta gishshas gididayssa Ayhuda halaqati erida gishshas iza oykkanaas koyida; gido attiin asaas babbida gishshas aggi bida.<verse eid="MRK 12:12" /></para>
  <para style="s1">Giira Gishshas Shiiqida Oysho</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mato 22:15-22</ref>; <ref loc="LUK 20:20-26">Luqa 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Yesusa yo7on qaxxana mala Farsaawetappenne Herdoosa baggatappe guuththa asata dooridi izakko yeddida. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Isttika izakko yiidi, «Astamaaree! Neni mooroy baynda as gididayssa nu eroos; ne oonaska babbada wordo maaddaka; Xoossa oge xalala tumu tamaarsaasa. Oroome kawo Qeesaares giira qanxxanaas bessizeyee? Bessennee? Nu qanxxinoyee? Qanxxofinoo?»<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Yesusi istta oyshay qoodheppe qommo gididayssa eridi, «Aazas tana qaxxana koyeetii? Ane issi dinaare hammite ta beyays» gides.<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Isttika miishshaa ehiin, «Hayssi iza bolla diza mislezi oona mislee? Iza bolla xaafettidayssi oona gizee?» gides. Isttika, «Qeesaareyssa» gida. <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Yesusikka, «Qeesaareyssa Qeesaares, Xoossayssa Xoossas immite» gides. Isttika iza zaaron malalettida.<verse eid="MRK 12:17" /></para>
  <para style="s1">Hayqoppe Denththa Gishshas Shiiqida Oysho</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mato 22:23-33</ref>; <ref loc="LUK 20:27-40">Luqa 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Hessafe guye hayqqidaytas hayqoppe denththi baa giza Saduqaaweti izakko yiidi iza hizgi oychchida.<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa 23:8</ref></char></note> <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />«Astamaaree! Issi asi machcho ekkidi naa yelontta hayqqiko hayqqidayssa ishay iza machcheyo ekkidi izas laata naa yelana mala kase Musey nuus xaafides.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref></char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Gido attiin laappun ishantti deettes; isttafe bayray machcho ekkidi naa yelontta hayqqides. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Kaalozi he maccassayo ekkidi ha7ikka naa yelontta hayqqides; heedzdzanththoyka yelontta hayqqides. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Laappunatikka he maccassayo ekkidi laata yelibeettenna; wurseththan maccassayakka hayqqadus. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Histtiin laappunatikka izo ekkidashin hayqoppe dendoy dizaa gidikko ha maccassaya isttafe oona machcho gidanee?» gida.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesusikka isttas, «Intte balettizay Geeshsha Maxaafatanne Xoossa wolqqa erontta gishshassa. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Hayqqidayti dendiza wode Salo Kiitanchchata mala gidana attiin ekettettenanne gelettenna. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Hayqqidayta denththa gishshas gidikko Muse maxaafan hessika qeeri wora giddon eexxiza tama giddofe Xoossi, ‹Tani Abrahaame Xoossaa; Yisaaqa Xoossaa; Yaaqoobe Xoossaa› gizayssa nababibeekketii?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref></char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Xoossi paxata Xoossa attiin hayqeththata Xoos gidenna; hessa gishshas intte daro balettideta» gides.<verse eid="MRK 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Istti palaman dishin xaafetappe issaadey istta palamaa siyidinne Yesusi oyshettidayssas lo7eththi zaaridayssa akeekidi, «Ero! Azazota ubbaafe aadhdhizay awayssee?» giidi oychchides.<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesusi izas, «Ubbaafe aadhdhizay hayssa, ‹Isra7eele siya! Godaa nu Xoossi issi Godaa, <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Nekka Godaa ne Xoossaa ne kumeththa wozinappe, ne kumeththa shemppofe, ne kumeththa qofappe, ne kumeththa wolqqafe dosa.› <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Nam7anththoyka, ‹Ne lagge ne hu7e mala dosa› ha nam7atappe aadhdhiza azazoy baa.»<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lewe 19:18</ref></char></note> <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Xaafezikka, «Astamaaree! Lo7o gadasa, ‹Xoossi issino gididayssanne izappe haray bayndayssa› ne yootidayssi likke.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">Zaare 4:35</ref></char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Iza ne kumeththa wozinappe ne kumeththa qofappe ne kumeththa wolqqafe dosoy qasseka ne lagge ne hu7e mala dosoy xuugettiza yarshofenne hara yarsho ubbaafe aadhdhees» gides.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hose 6:6</ref></char></note> <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Yesusikka addezi yuushshi qoppidi zaaridayssa be7idi, «Neni Xoossa Kawoteththafe haahon daakka» gides. Hessafe guye iza oychchanaas xalidaadey beettibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa 10:25-28</ref></char></note><verse eid="MRK 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yesusi Xoossa Keeththa gaaththan tamaarsishe, «Muse wogaa tamaarsizayti aazas, ‹Kirstoosa Dawite naa› gizoo? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dawiti Xillo Ayanan haasayshe, ‹Goday ta Godaa, ne morkketa ta ne toho gars aaththana gakkanaas ta ushachchan utta› gides.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maza 110:1</ref></char></note> <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />Histtiin Dawiti ba doonara iza, ‹Godaa› giikko waanidi simmi izas naa gidanee?» gides. Daro dereykka izi gizayssa ufayssara siyides.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Izi tamaarsishe, «Muse wogaa tamaarsizaytappe naagettite, gadera gooshettiza adussa may7o may7idi yuushshe yuuyana doseettes; awanka aadhdhi aadhdhi asi isttas bonchcho sarota immana mala koyeettes. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Ayhudata Woosa Keeththan dhoqqaso, gibirasonkka bonchchoso koyeettes. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Istti azinay baynda maccassa keeth kalloseettes; qasseka bana bessanaas adussa woosa woosseettes. Haytanti iita pirda pirdettana» gides.<verse eid="MRK 12:40" /></para>
  <para style="s1">Am7ey Muxuwaata</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luqa 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesusikka asay muxuwaata yeggizason uttidi daro asati immizayssa Xoossa Keeththa miishsha shiishshiza saaxinen yeggizayssa xeellides. Daro dureti daro miish yeggida. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Issi azinay baynda am7e dizaara issi sikkinnafe darontta xarqimala biratappe oosettida nam7u miish yeggadus. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Yesusi bana kaallizayta xeygidi, «Ta inttes tumu gays; saaxinezan yeggida ubbaafe hanna manqo am7eya aadheth yeggadus. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Hayti wuri baas diza tirpa miishshaafe yeggidashin hanna qasse ba manqoteththaafe baas dizayssa sinththafe izo koshshizayssara wursa immadus» gides.<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">Yesusi Kaseti Yootida Xoossa Keeththaa Laaleteth</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mato 24:1-2</ref>; <ref loc="LUK 21:5-6">Luqa 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Izi Xoossa Keeththaafe kezishin iza kaallizaytappe issoy, «Astamaaree! Hayssi keeththaynne keeththay keexettida shuchchay ay mala lo7izaakko hayssa beyay?» gides. <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Yesusikka zaaridi, «Hayta gita keeththata xeellay? Shuchchati issoy issaa bolla diza mala deettenna; wurikka laalettana» gides.<verse eid="MRK 13:2" /></para>
  <para style="s1">Wode Wurseththa Malaatata</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mato 24:3-14</ref>; <ref loc="LUK 21:7-19">Luqa 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesusi Xoossa Keeththa ginara Dabrazayte zumaa bolla utti dishin Phexroosi, Yaaqoobey, Yohannisinne Indiraasi xalla izakko shiiqidi, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />«Hayssi ayde hananaakko nuus yoota. Hayssi wurseththan polettanaas malatay aazee?» gi oychchida.<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesusikka isttas, «Oonikka inttena baleththontta mala naagettite. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Buro daroti, ‹Ta Kirstoosa› gishe ta sunththan yaana; darotakka baleththana. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Intte olanne ola wore siyiza wode dagammofte; hessi hananayssi attenna; wurseththi gidikko buroona. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Derey dere bolla, kawoy kawo bolla dendana, daroson biitta qaaththinne koshay hanana; heyti wuri miixas leesso mala.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />«Intte inttes naagettite. Buro inttena dere duulatan aaththi immana. Istti inttena Ayhudata Woosa Keeththan garafana. Intte ta markkatta gidana mala ta gishshas dere daannata sinththaninne kawota sinththan eqqana. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Koyrottidi Mishiraachcho qaalay dere ubbaas sabbakettana bessees. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Intte oykettidi pirdas shiiqiza wode hinno he saateyin inttes imettizaaro haasayte attiin biidi, ‹Nu ay giinoo?› giidi kaseti hirgofte; haasayanay Xillo Ayanappe attiin inttena gidekketa.<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Mato 10:17-20</ref></char></note><verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />«Ishay ishaa, aaway ba naa hayqos aaththi immana; nayti bana yelidayta bolla makkallananne wodhana. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ta gaason intte asa ubbaan ixettidayta gidana; wurseth gakkanaas minni eqqidaadey gidikko attana.<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mato 10:22</ref></char></note><verse eid="MRK 13:13" /></para>
  <para style="s1">Yerusalaame Bolla Gakkana Gita Meto</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mato 24:15-21</ref>; <ref loc="LUK 21:20-24">Luqa 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />«Intte harassiza tunateth izas bessonttason eqqidaashe beykko nababizaadey wozinan woththo; Yuhudan dizayti pude zuma bolla baqatetto.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Daane 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Keeththa karen dizaadey soo geloppo; ba miish kessana giidi keeththe geloppo. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Goshshason dizaadey ba may7o ekkanaas guye simmofo.<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luqa 17:31</ref></char></note> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />He gallassatan shaara maccassatassinne naa dhanththizaytas aayye ana! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Hessika balgon gidontta mala Xoos woossite. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Xoossi koyro medheteth ubbaa medhdhoosofe ha7i gakkanaas woykko hayssafe guye iza misatizay baynda gita metoy hanana.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Daane 12:1</ref>; <ref loc="REV 7:14">Ajju 7:14</ref></char></note> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Goday he gallassata qaanththonttaako oonikka attenna shin baas doorettidayta gishshas izi he gallassata qaanththides.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />«He wode oonikka, ‹Hekko Kirstoosi hayssan dees› giikko woykko, ‹Hekko heen dees› giikko ammanopite. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Wordo Kirstoosatinne wordo nabeti buro dendidi malaatatanne kase hani erontta pala miish ooththana; isttas dandayettiko haray attoshin doorettidaytakka baleththana. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Hessa gishshas naagettite; he wodey gakkontta dishin haara hayssa wursa ta inttes yootadis.<verse eid="MRK 13:23" /></para>
  <para style="s1">Kirstoosas Nam7anththo Yuus</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mato 24:29-31</ref>; <ref loc="LUK 21:25-28">Luqa 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />«He wode he metozappe kaallidi arshey dhumana;</para>
  <para style="q2" vid="MRK 13:24">aginaykka poo7isuku.<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Xoolintteti saloppe qoqofettana,</para>
  <para style="q2" vid="MRK 13:25">salon diza wolqqamati qaaxxana.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="REV 6:13">Ajju 6:13</ref>; <ref loc="JOL 2:10">Iyu 2:10</ref></char></note><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />«He wode Asa Nay gita wolqqaranne bonchchora salo shaarara yishin asay iza beyana.<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>; <ref loc="REV 1:7">Ajju 1:7</ref></char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Izikka kiitanchchata yeddidi oyddu baggafe biitta gaxappe gaxa gakkanaas diza baas doorettidayta shiishshana.<verse eid="MRK 13:27" /></para>
  <para style="s1">Balase Miththay Leemiso</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mato 24:32-35</ref>; <ref loc="LUK 21:29-33">Luqa 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />«Leemisoza balase miththafe tamaarte. Unquloy cililiza wode hayth kessishin boney matidayssa intte ereeta.<note caller="+" style="f"><char style="fr" closed="false">13:28 </char><char style="ft" closed="false">Hayssi ha qofay bessizayssi istta deren diza miththati aacizaynne hayththati cililizay bone gididayssa bessanaassa.</char></note> <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Hessaththoka hayti ta gidayti polettishin intte beykko wodey mati yiidi penge gakkidayssa erite. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ta inttes tumu gays; ha yo7oti polettana gakkanaas hayssi ha yeletay aadhdhenna. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Saloynne sa7ay aadhdhana shin ta qaalay gidikko aadhdhenna.<verse eid="MRK 13:31" /></para>
  <para style="s1">Goday Yaana Gallassayonne Saateyo Oonikka Erenna</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mato 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />«Qasse he gallassay gishshas woykko he saatey gishshas ta Aawappe attiin Salo Kiitanchchata gidiinkka Naaza gidiinkka oonikka erenna. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Hessa gishshas wodey aydekko intte erontta gishshas naagettite, minnitenne woossite. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Hessika ba keeth ashkaratas aggidi ashkarata issaa issaa ooso oyththidi penge naagizayssi beeggidi naagana mala azazidi bida asa misatees.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Luqa 12:36-38</ref></char></note><verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />«Histtiko keeththa aaway ayde yaanaakko woykko leela giddoth yaanaakko woykko koyro kuttoy baqqishin yaanaakko woykko wontta bolla bazzoy zo7ishin yaanaakko intte erontta gishshas beeggidi naagite. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Intte qoppontta dishin izi yiidi intte dhiskidishin inttena demmofo.<verse eid="MRK 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 13:37" />«Ta inttes yootizayssa as ubbaas yootays; minnidi naagite! gays» gides.<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">Yesusa Wodhanaas Asaa Maqeteth</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mato 26:1-5</ref>; <ref loc="LUK 22:1-2">Luqa 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Paaziganne ukeththa muussa ba7aale gallassay bonchchettanaas nam7u gallassi attishin qeeseta halaqatinne Muse wogaa tamaarsizayti Yesusa baleththi oykkidi wodhana oge koyida.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref></char></note> <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Gido attiin, «Asay meto medhdhontta mala ba7aale gallassatan gidoppo» gida.<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Izi Bitaaniya geetettizason issi inchchirachcha harganchcha gidida Simoonason quma bolla dishin waagay daro al7o gidida nardoose geetettiza shittoy kumi uttida albasxiroose bilqaaxe oykkida issi maccassaya bilqaaxeza menththada shittoza Yesusa hu7e bolla gussadus.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">Luqa 7:37-38</ref></char></note> <figure style="fig" alt="Alabaster jars" file="HK00142B.TIF" size="span" ref="14:3">Albasxiroose bilqaaxeta</figure><verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Heen diza asatappe issi issi asati, «Hayssi shittozi aazas wogay baynda gukkizee?» giidi ba giddon hanqettida. <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />«Shittozi bayzettidaakko heedzdzu xeetu dinaareppe bollara bayzettidi manqotas imettenneeshin!» giidi maccassayokka kadhida.<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">Heedzdzu xeetu Dinaare guussi beni wode asas layththa damoza.</char></note><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Gido attiin Yesusi isttas, «Aggite! Hanno maccassayo aazas waayiseetii? Iza taas lo7o miish ooththadus. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Manqoti ay wodekka inttenara deettes. Intte koyida wode aydekka istta maaddanaas dandayeeta; ta gidikko ubba wode inttenara diikke.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Zaare 15:11</ref></char></note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Hanna ba ooththanaas dandayzaari keena ooththadus. Taas moogos gidana mala ta asho kaseta tiyadus. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ta inttes tumu gays; hayssi Mishiraachcho qaalay alame kumeththaan sabbakettizason awanka iza ooththidayssi izo hassa7issizaaz gididi haasayettana» gides.<verse eid="MRK 14:9" /></para>
  <para style="s1">Yesusa Aaththi Immanaas Yuhuda Giigeteth</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mato 26:14-16</ref>; <ref loc="LUK 22:3-6">Luqa 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Hessafe guye tammanne nam7atappe issoy Asqoronto Yuhuday Yesusa aaththi immanaas qeeseta halaqataakko bides. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Isttika hessa siyidi ufayettida; izas miishshe immanaas izara giigida; hessa gishshas Yesusa aaththi immanaas injje wode naagishe gam7ides.<verse eid="MRK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Paaziga dorsi shukettiza uketh muussa bonchchiza koyro gallas Yesusa kaallizayti Yesusaakko shiiqidi, «Paaziga kawo maanaso awan giigsana mala koyay?» gi oychchida.<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Izikka bana kaallizaytappe nam7ata, «Katama biite; intte bishin haaththe otora tookkida issaadey inttenara gaaggana. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Izi biidi gelizaso gakkanaas iza kaallite. Keeththaadezas, ‹Astamaarey nena, tana kaallizaytara Paaziga kawo maanaas taas gidiza imaththa shemposoy awayssee? gides› giite. <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Izikka bolla pooqe bolla diza giigi uttida aahoso inttena bessana; heen izan giigsite» gi kiittides.<figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.TIF" size="span" ref="14:15">Pooqe bolla diza nam7u kifileta</figure><verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Iza kaallizaytikka kezidi katama bida. Wurikka Yesusi gida mala hani beettides; Paazigakka heen giigsida.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Gadey qammishin Yesusi bana kaalliza tammanne nam7atara gakkides. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Istti maaddan dishin, «Ta inttes tumu gays; intte giddofe issoy izikka tanara issife mizayssi tana aaththi immana» gides.<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maza 41:9</ref></char></note><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Isttika muuzottidi, «Taneeshaa? Taneeshaa?» giidi issoy issoy Yesusa oychchida.<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Izikka isttas, «Tammanne nam7atappe issoy tanara ba kushe keren yeddizaade. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Kase xaafettida mala Asa Nay iza gishshas hayqqana shin asa naa aaththi immizaades aayye ana! Hessaadey kase yelettontta attidaakko izas lo7okkoshin!» gides.<verse eid="MRK 14:21" /></para>
  <para style="s1">Godaa Kawo Eko Woga</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mato 26:26-30</ref>; <ref loc="LUK 22:14-23">Luqa 22:14-23</ref>; <ref loc="1CO 11:23-25">1Qoro 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Istti mishin ukeththaa ekki anjjidinne menththidi bana kaallizaytas, «Hayssa ta asho he7ite» gi immides.<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ushshaaka denththi galatidi isttas immiin istti wurikka uyida. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Qasse Yesusi, «Hayssi darota gishshas gukkana ta ooraththa caaqo suuththaa.<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Kessa 24:8</ref>; <ref loc="JER 31:31-34">Er 31:31-34</ref></char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Ta inttes tumu gays; ooraththa woyneppe giigida ushshaa Xoossa Kawoteththan ta uyana wode gakkanaas nam7anththo hayssa uyikke» gides.<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Hessafe guye mazamure issife yexxidi pude Dabrazayte zuma bolla kezida.<verse eid="MRK 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesusi, « ‹Ta heemmizayssa shocana; he wode iza dorsati laalettana› geetetti xaafettidayssa mala intte wurikka tanan dhuphettana.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zaka 13:7</ref></char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Ta dendidaappe guye gidikko ta inttefe kasetada Galila baana» gides.<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mato 28:16</ref></char></note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Phexroosikka, «Asay wuri dhuphettikokka tani dhuphettike!» gides.<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesusikka, «Ta nees tumu gays; hach omars kuttoy nam7uto waassana gakkanaas neni tana heedzdzuto kaddana» gides.<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Phexroosi qasse, «Ta nenara hayqqizaakkoka mulekka nena kaddike» giidi keehi minththi yootides. Hankkoytikka wuri izayssaththo gida.<verse eid="MRK 14:31" /></para>
  <para style="s1">Getesemaanen Yesusa Woosa</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mato 26:36-46</ref>; <ref loc="LUK 22:39-46">Luqa 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Hessafe guye Getesemaane geetettizaso bida; Yesusikka bana kaallizayta, «Tani woossishin intte hayssan gam7iishshite» gides. <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Phexroosa, Yaaqoobenne Yohannisa banara ekki bides. Keehi qoppidessinne metotides. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Qasseka isttas, «Ta shemppoya daro metotadus intte haan diishshite. Dhiskontta naagite» gides.<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Istta achchafe guuth haakki bi biitta bolla gufannidi he saateya izappe aadhdhana mala woossides. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />«Ta Aawawu! Nees wuri dandayettees; hayssa waaye xuu7a taappe haassa. Gidikkoka ne sheneppe attiin ta sheney hanoppo» gides.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Izi heeppe simmi yishin iza kaallizayti dhiskidayta be7ides. Phexroosakka, «Simoona dhiskadii? Haray attoshin issi saatekka minnada naagoy nena xoonidee? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Intte paacen gelontta mala beeggidi woossitenne minnite. Ayanay giigetti uttides shin ashoy gidikko daaburanchcha» gides.<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Qasseka biidi koyroyssaththo woossides. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Izi nam7anththo simmi yishin istta ayfen dhiskoy deexxiin dhiskidayta demmides shin istti izas ay zaaranakkon eribeettenna.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Heedzdzanththo yiidi, «Ha7ikka intte ichchidi shempeetii? Ha7i gidana; saateyakka gakkadus; hekko Asa Nay nagaranchchata kushen aadhdhi imettana. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ane eqqite boos; tana aaththi immanaadey yides» gides.<verse eid="MRK 14:42" /></para>
  <para style="s1">Yesusa Oyketeththinne Aadhdhi Imeteth</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mato 26:47-56</ref>; <ref loc="LUK 22:47-53">Luqa 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoha 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesusi buro haasayan dishin tammanne nam7atappe issoy Yuhuday yides. Izara issife qeese halaqatappenne Muse wogaa tamaarsizaytappe kiitettida daro asay giththa mashshanne durqqa oykkidi yides. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Iza aaththi immana Yuhuday isttas, «Asa giddofe ta yeerizaadey iza gidida gishshas oykkidi lo7eththi naagi efte» giidi kaseti malata immi woththides.<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Gakkida mala Yuhuday Yesusaakko shiiqidi, «Astamaaree!» giidi yeerides. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Asatikka Yesusa oykkida. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Iza achchan eqqida issoy mashsha koohoppe shoddi qeeseta halaqaza ashkara hayth qanxxides. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesusikka isttas, «Panga mala tana oykkana mashshanne durqqa oykkidi yeetii? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Wontiin wontiin Xoossa Keeththan tamaarsashe ta inttenara dishin oykkibeekketa shin kase xaafettidayssi polettana mala hayssi hanides» gides.<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />He wode iza kaallizayti wuri iza yeggi aggi bida. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Ba kalloteth qeeri naxalan kammida issi nay Yesusa kaallishin asay iza oykkiin, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Naazi naxalaa yeggidi kallo kichchides.<verse eid="MRK 14:52" /></para>
  <para style="s1">Pirda Duulatakko Yesusa Shiiqo</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mato 26:57-68</ref>; <ref loc="LUK 22:54-55">Luqa 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoha 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Yesusakka gede qeeseta halaqaakko efida; qeeseta halaqati, dere cimatinne Muse wogaa tamaarsizayti heen issife wuri shiiqida. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Phexroosikka Yesusa haahora kaallishe qeeseta halaqaza gibbe gakkanaas bides. Izi heen uttidi hara asatara tama ho7ishin, <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />qeeseta halaqatinne dere cimati wuri Yesusa wodhanaas markkattana as koyida shin demmanaas dandaybeettenna. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Daroti iza bolla wordora markkattikokka markkatta qaalay oykettibeenna.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Issi issi markkati dendidi wordora, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />«Hayssi addezi, ‹Ta asa kushen keexettida Xoossa Keeththaa laallada asa kushey bochchonttaaz hara heedzdzu gallassara ta keexxana› gishin nu siyidos» gi markkattida.<note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoha 2:19</ref></char></note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Gido attiin istta markkateththi issi bolla wodhdhibeenna.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Qeeseta halaqaykka istta sinththan eqqidi, «Hayti ne bolla markkattizayssi aazee? Ne aazas doona zaarikkii?» giidi Yesusa oychchides.<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Gido attiin Yesusi isttas aykkoka zaarontta co7u gides; qeeseta halaqay qasseka, «Anjjettida Xoossa Nay Kirstoosi nenee?» gi oychchides.<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesusikka zaaridi, «Ee; tanakko! Asa Nay wolqqama Xoossa ushachchan uttishininne salo shaarara yishin intte iza beyana» gides.<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref></char></note><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Qeeseta halaqay ba may7o daakkidi, «Nuus hara aaza markka koshshizee? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Izi cashsha qaala Xoossa bolla haasayshin intte siyideta; ha7ich inttes ay misatizee?» gides. Isttika, «Izas hayqoy bessees» giidi wurikka issi qaalan pirdida.<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lewe 24:16</ref></char></note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />He wode issi issi asati iza bolla cuch cuttida; iza ayfe goozi oykkidi iccishe, «Ane tinbite yoota» gida. Baggayti qasse shagalan baqqishe efida.<verse eid="MRK 14:65" /></para>
  <para style="s1">Phexroosi Yesusa Kaddides</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mato 26:69-75</ref>; <ref loc="LUK 22:56-62">Luqa 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoha 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Phexroosi duge baggara heen gibbe giddon dishin qeeseta halaqa garadetappe issiniya yadus. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Phexroosi tama ho7ishin tishshi histta xeellada, «Neni Naazirete Yesusara daasa gidikkii?» gadus.<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Izi qasse, «Ne gizayssaade ta erikke; ne gizayssi taas gelenna» giidi kaddides. Hessafe gede penge pooqqi eqqi dishin heerakka kuttoy waassides.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />He garadeya iza be7ida mala heen eqqida asatas, «Hayssi addezi izara diza asatappe issaadeko!» gaada qasseka haasayadus. <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Izi qasseka kaddides. Guuththa wode gam7ishin heen eqqida asati Phexroosa, «Neni Galila asa, hessa gishshas tumappe ne isttafe issaade» gida.<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Gido attiin izi qasse, «Intte gizaade ta erikke!» gishe caaqonne bana qanggeth oykkides.<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Heerakka kuttoy nam7anththo waassides. Phexroosikka, «Kuttoy nam7aa waassanaas ne tana heedzdzaa kaddana» gida Yesusa qaalay izas qofettiin hiqimi yeekkides.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">Yesusa Philaxoosakko Efida</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mato 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luqa 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoha 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Maalado wonttara qeeseta halaqati, dere cimatinne Muse wogaa tamaarsizayti kumeththa shango alaafetara issife zorettidi Yesusa qachchi ekki efidi Philaxoosas aaththi immida.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Philaxoosikka Yesusa, «Ne Ayhudata kawoo?» gi oychchides. Yesusikka, «Ee, ne gida mala» giidi izas zaarides.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Qeeseta halaqatikka daro yo7o iza bolla shiishshi mootida. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Philaxoosi qasse, «Ne aazas oyshaa zaarikkii? Hekko nena daro yo7on mooteettes» giidi qasseka oychchides.<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Gido attiin Yesusi ha7ikka izas aykkoka zaaro immontta gishshas Philaxoosikka malalettides.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Paaziga ba7aale gallas Philaxoosi derey birshana mala oychchidaade birshi yeddiza wogay kase dees. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Iita ooson dere bolla dendidi shempo wodhida asatara issife qashettida Barbaane geetettiza issaadey dees. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Dereykka yiidi kase lose gididayssa izi ooththana mala Philaxoosa woossides.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Philaxoosikka isttas, «Ta inttes Ayhuda kawo birshana mala koyeetii?» gi oychchides. <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Philaxoosi hessaththo oychchiday kase qeeseta halaqati Yesusa qanaaten aaththi immidayssa eriza gishshassa.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Qeeseta halaqati qasse, «Iza exa Barbaaney birshetto!» gi oychchana mala dereza denththeththida. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Philaxoosi, «Histtiko intte Ayhuda kawo giza addeza wosttana mala koyeetii?» gides.<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Istti qasseka, «Kaqqa! Kaqqa!» gi waassida.<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Philaxoosikka, «Ay iita ooththidee?» gi istta oychchides. Istti qasse, «Kaqqa! kaqqa!» giidi kaseppe aaththi waassida.<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Philaxoosikka dereza ufayssana giidi Barbaane isttas birshides. Yesusa garafidi kaqqanaas aaththi immides.<verse eid="MRK 15:15" /></para>
  <para style="s1">Wottadarati Yesusa Bolla Qilccida</para>
  <para style="r">(<ref loc="MAT 27:27-30">Mato 27:27-30</ref>; <ref loc="JHN 19:2-3">Yoha 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Wottadarati Yesusa dere haarizayssa gibbe ekki biidi attida wottadarata ubbaa shiishshida. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Yesusa zo7o may7o mayzida; agunththa akilile xaaxidi iza hu7en woththida. <figure style="fig" alt="Head of Jesus wearing crown of thorns" file="LB00321B.TIF" size="span" ref="15:17">Yesusa hu7e bolla wodhdhida agunththa akilile</figure> <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Hessafekka, «Ayhuda kawo saroy nees gido!» gishe iza saroththida. <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Iza hu7e guufera shocida; iza bollaka cuttida; gulbatidi izas goynnida. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Iza bolla qidhi kaa7idaappe guye kase mayzida zo7o may7oza qaari ekkidi kase iza may7oza zaari mayzidi kaqqanaaso ekki bida.<verse eid="MRK 15:20" /></para>
  <para style="s1">Yesusa Kaqeteth</para>
  <para style="r">(<ref loc="MAT 27:31-44">Mato 27:31-44</ref>; <ref loc="LUK 23:27-43">Luqa 23:27-43</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Alakisandrosanne Erufoosa aawa Simoona geetettiza issi Qareena dere asi dereppe katama yizayssa Yesusa masqale wolqqara oykki toossida.<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">Oro 16:13</ref></char></note> <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Hessafe guye Yesusa Golgota geetettizaso efida; izas birsheththay, «Asa hu7e guugge» guussa. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Karbbe geetettiza camora walakettida woyne cajje uyana mala izas immiin izi ekkontta ixxides. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Hessafe guye iza kaqqida; iza may7o issaade issaade awayssi gakkanaakko giidi saama yeggidi gishettida.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Istti iza kaqqishin wonttafe heedzdzu saate gidides. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Istti masqale bolla xaafi shiishshida mooto qaalay, «Ayhuda kawo» giza qaala. <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Izara issife nam7u pangata issaa izappe ushachchara issaa hadirsara kaqqida. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Hessankka kase maxaafay, «Iitatara issife taybettides» gida tinbite qaalay polettides.<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Issi issi Geeshsha Maxaafati taybo 28 bolla diza qofaa gujjeettes; qaalazikka Luqaasan 22:37 bolla dizayssa misatees.</char></note><note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref></char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Ogera aadhdhi bizaytikka ba hu7e qaaththishe, «Oy! Oy! Xoossa Keeththaa laallada heedzdzu gallassan keexxanay nenee?» giidi iita cashshe cayishe,<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maza 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="JHN 2:19">Yoha 2:19</ref></char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />«Ane ha7i masqale bollafe wodhdhada nena ashsha» gida.<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Hessaththoka qeeseta halaqatinne Muse wogaa tamaarsizayti ba giddon issoy issaas, «Harata ashshides shin bana ashshana dandaybeenna» giidi iza qidhida. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />«Nu iza be7idi ammanana mala ane hayssi Kirstoosi Isra7eeleta kawoy ha7i masqaleppe wodhdho» gida. Izara kaqettidaytikka iza bolla cashshe korida.<verse eid="MRK 15:32" /></para>
  <para style="s1">Yesusa Hayqo</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mato 27:45-56</ref>; <ref loc="LUK 23:44-49">Luqa 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Usuppun saateppe doommidi uddufun saate gakkanaas biittay wuri dhumides. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Uddufun saate bolla Yesusi, «Eelohe! Eelohe! Lama sabaqitane» giidi qaala dhoqqu histtidi waassides. Hessas birsheththay «Ta Xoossoo! Ta Xoossoo! Ne tana aazas aggadii?» guussa.<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maza 22:1</ref></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Heen eqqida asaappe issi issi asati hessa siyidi, «Eelaasa xeygeeskko!» gida. <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Hessafe issi asi eleli biidi caalida woyne cajje<note caller="+" style="f"><char style="fr" closed="false">15:36 </char><char style="ft" closed="false">Caalida woyne cajje kaqettida asi ba waaye balana mala ushsheettes.</char></note> isponje mala miishshan gelththi kessidi miththa xeeran oyththidi uyana mala Yesusas shiishshides. Hessafe qasse, «Ane aggaagite; Eelaasi yiidi iza kaqoppe woththishin nu beyana» gides.<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Hessafe Yesusi qaala dhoqqu histti waassidi shempo kezides.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Xoossa Keeththe magalashay hu7era duge nam7u kezi daakettides.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Kessa 26:31-33</ref></char></note> <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Yesusa ginara eqqida issi mato halaqay Yesusi hessaththo gita qaalara waassidi shempo kezishin be7idi, «Hayssaadey tumu Xoossa naakkoshin» gides. <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />He wode maccassati hanizayssa haahon diidi xeellida. Istta giddofe Magdaleppe yida Maaramanne kaalotiza Yaaqoobe Yoosa aayo Maaramira qasseka Saloomira issife deettes. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Heyti maccassati Galilan Yesusa kaallishenne izas ooththishe gam7idayta. Isttarakka issife hara daro maccassati Yerusalaame bida.<note caller="-" style="x"><char style="xo" closed="false">15:40-41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luqa 8:2-3</ref></char></note><verse eid="MRK 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Gadey qammi qammi bishin Sambatas giigettiza gallassi gakkides. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Dere cimata giddon bonchchettida issi Armatiyase dere as Yooseefe geetettizayssi Xoossa Kawoteth naagishe dizaadey babbontta Philaxoosakko biidi Yesusa aha woossides. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Philaxoosikka izi hinni wode ellera hayqqidayssa siyidi malalettides. Mato halaqa xeygisidi, «Izi hayqqi gam7idee?» giidi oychchides. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Izi hayqqidayssa mato halaqay geeshshi eridaappe guye Yesusa aha Yooseefes immides. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yooseefeykka moogo may7o shammidi ahaa masqaleppe woththidi moogo may7on xaaxidi shuchchafe woocettida duufon moogides. Duufaa doona shuchchara gordides. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Magdaleppe yida Maaramiranne Yooseefe aayo Maaramira Yesusa aha awan moogidaakko be7ida.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">Hayqoppe Yesusa Denth</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mato 28:1-8</ref>; <ref loc="LUK 24:1-12">Luqa 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Sambatay aadhdhidaappe guye Magdale Maarama, Yaaqoobe aayo Maaramiranne Saloomira issife biidi Yesusa aha tiyanaas shitto shammida. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Saaminttafe koyro gallas maalado wonttara buro arshey kezida mala Yesusa duufokko buro bishin, <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />«Duufoza doonappe shuchchaa nuus ooni genderisanee?» giidi ba giddon haasayettida.<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Istti dhoqqu gi xeellishin daro gita shuchchay duufoza doonappe genderidayssa be7ida. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Duufoza giddo gelida mala issi booththa may7o may7ida panththi ushachcha baggara uttidayssa be7idi dagammida.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Izi qasse isttas, «Dagammofte! Intte kaqettida Naazirete Yesusa koyeeta; izi dendides; haan deenna; istti iza woththidaso hayssa be7ite. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Gido attiin intte biidi iza kaallizaytassinne Phexroosas kase inttes yootida mala inttefe kasetidi izi Galila baana. Intte iza heen demmana giidi isttas yootite» gides.<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mato 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref></char></note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Maccassatikka malalettishenne kokkorishe duufaappe kezi baqatida. Babbida gishshas oonaska aykkoka qaattibeettenna.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Issi issi beni Geeshsha Maxaafatan taybo osppunappe guye diza qofay hayssafe kaallidi xaafettides. Maccassati Phexroosakkonne ba laggetakko biidi kiitanchchazi isttas yootidayssa ubba isttas yootida. Hessafe guye Yesusi ashshiza laamettontta Geeshsha Mishiraachcho qaala arshey mokkizasoppe wullizaso gakkanaas bana kaalliza tamaareta baggara kiittides.</char></note><verse eid="MRK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Saaminttafe koyro gallas Wogga wontta maaladora izi hayqoppe dendidaappe guye Yesusi izippe laappun daydanth kessida Magdale Maaramis koyro beettides.<note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="ft" closed="false">Issi issi birsheththataninne issi issi haratappe duuqettida Geeshsha Maxaafatan taybo 9-20 gakkanaas diza qofay xaafettibeenna.</char></note> <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Izakka baada kase izara dizayti kayottishenne yeekkishe dishin demmada yootadus. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Istti Yesusi paxa dizayssanne iza ta Yesusa beyadis gidayssa siyidi ammanibeettenna.<verse eid="MRK 16:11" /></para>
  <para style="s1">Yesusi Bana Kaalliza Nam7atas Beettides</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luqa 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Hessafe guye iza kaallizaytappe nam7ati gede dere gars bishin Yesusi isttas hara as misati beettides. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Isttika simmidi hessa iza kaallizaytappe attidaytas yootida; gido attiin iza kaallizayti siyidi ammanibeettenna.<verse eid="MRK 16:13" /></para>
  <para style="s1">Yesusi Bana Kaalliza Tammanne Issinetas Beettides</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mato 28:16-20</ref>; <ref loc="LUK 24:36-49">Luqa 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Hessafe guye tammanne issineti maadda bolla dishin Yesusi isttas qonccides. Izi hayqoppe dendiin iza be7ida asati isttas yootiin siyidi ammanontta aggida gishshas isttas ammanoy bayndayssanne istta wozina muumeteththa gishshas istta borides. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Isttaskka, «Alame ubbaso biite, Mishiraachcho qaala medheteth ubbaas sabbakite.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Hawa 1:8</ref></char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Ammanidaynne xammaqettiday attana. Ammanonttay gidikko pirdettana. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Tana ammanizayta hayti malatati kaallana. Istti ta sunththan daydanththata kessana; ooraththa qaalankka haasayana. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Istti shooshshata ba kushera oykkana; wodhiza marze uyikkoka istta qohenna. Ba kushe harganchchata bolla woththi woossiko harganchchati paxana» gides.<verse eid="MRK 16:18" /></para>
  <para style="s1">Pude Salo Yesusa Buus</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luqa 24:50-53</ref>; <ref loc="ACT 1:9-11">Hawa 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Godaa Yesusi hessa yootidaappe guye pude salo dendi biidi Xoossa ushachchan uttides. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Iza kaallizayti hessafe kezidi ubbason aadhdhi aadhdhi sabbakida. Godaykka isttara ooththides. Istta timirteza ekkidi ooththizaytas ba yootida qaalakka malaata ooththi ooththi minththides.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>