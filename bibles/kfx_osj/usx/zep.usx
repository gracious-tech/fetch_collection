  <para style="h">सपन्याह</para>
  <para style="toc1">बिधातो गूर सपन्याह</para>
  <para style="toc2">सपन्याह</para>
  <para style="toc3">सप.</para>
  <para style="mt1">सपन्याह</para>
  <para style="mt2">सपन्याह गूरै लिखी दी कताब</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: सपन्याह</para>
  <para style="ili">सन: 640 का 607 ईसा आजी</para>
  <para style="ip">यहूदा मुल्खे परज़ा सोठअ इहअ कि आजू एछणअ तिन्‍नां लै इहअ बगत ज़ेभै बिधाता तिंयां बलबान बणाणैं अर तिन्‍नें दुशमणो करनअ नाअं नशाण ई खतम। ज़ेभै सह बगत एछणअ सह हणअ नसाफ, ज़ीत अर खुशी मनाऊंणेओ बगत, तेता लै बोला, “प्रभूए धैल़ी।”</para>
  <para style="ip">पर सपन्याह खोज़ा लोगा का इहअ कि सह प्रभूए धैल़ी कधू एछणी अर बिधाता दैणीं तिन्‍नां सोभी लै सज़ा ज़ुंणीं तेही ज़िन्दगी नांईं ज़िऊई ज़ेही बिधाता च़ाहा। सह सज़ा भेटणीं यहूदी मुल्खे परज़ा संघी सोभी देशा लै। ज़ै यहूदा मुल्ख बिधाते कोप अर सज़ा का बच़णअ च़ाहा, तै करा ज़िहअ बिधाता बोला तिहअ अर सिधी बिधाते पूज़ा अर च़ाकरी:</para>
  <para style="imq">“ज़ै तम्हैं तत्त दिला का तेही ज़िन्दगी ज़िऊए ज़िहअ बिधाता च़ाहा, तै एछा! संघा टेक्‍का बिधाता सेटा माथअ। ज़ै तम्हैं भलअ करे अर मानदार रही ज़िन्दगी ज़िऊए, तै झ़ाणीं बिधाता तम्हां तैहा धैल़ी बच़ाऊई डाहे ज़ेभै संसारा लै तेऊ आपणअ रोश्श तरैल़ी दैणअ।”</para>
  <para style="ipr">(2:3)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">यहूदा अर एरुशलेम नगरीए परज़ा लै सज़ा 1:1-18</para>
  <para style="io1">बिधाता बाखा फिरा 2:1-3</para>
  <para style="io1">संसारे सोभी देशा लै सज़ा 2:4-15</para>
  <para style="io1">यहूदा अर होर देश फिरनैं बिधाता बाखा 3:1-20</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />हुंह आसा कूशीओ शोहरू सपन्याह, मेरअ दादू त गदाली अर अमर्या त मेरअ पल़दादू, अर मेरै पल़दादूओ बाब आसा त हिजकिया।</para>
  <para style="p" vid="ZEP 1:1">ज़धू यहूदा मुल्खै अमोनो शोहरू जोशिया राज़अ थिअ, बिधाता दैनअ मुखा समाद। बिधाता बोलअ इहअ,<verse eid="ZEP 1:1" /></para>
  <para style="s">यहूदा लै नसाफ</para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />“मुंह करनी धरती दी सोभ च़िज़ा खतम,</para>
  <para style="q" vid="ZEP 1:2">अह डाहअ मंऐं बिधाता बोली।<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />मुंह करनै मणछ, पशू, च़ेल्‍लू अर म्हाछ़ली सोभ खतम।</para>
  <para style="q" vid="ZEP 1:3">कदुष्ट मणछ झेचणैं मुंह धरनीं,</para>
  <para style="q" vid="ZEP 1:3">मणछ करनै मुंह धरती का ज़ात पठी खतम।</para>
  <para style="q" vid="ZEP 1:3">अह डाहअ मंऐं बिधाता बोली।<verse eid="ZEP 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />मुंह दैणीं यहूदा मुल्ख अर एरुशलेम नगरीए परज़ा लै सज़ा।</para>
  <para style="q" vid="ZEP 1:4">बाल देअए पूज़ा करने गान-स्तान ढुशणै पठ पोर्ही।</para>
  <para style="q" vid="ZEP 1:4">तिन्‍नें च़ाकरी करनै आल़ै पज़ैरैओ निं मुंह नाअं नशाण ई डाहणअ।<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />ज़ुंण मणछ छ़ाप्परै उखल़ी सुरज़, ज़ोथ अर ग्रहा पूज़दै हअ लागै दै,</para>
  <para style="q" vid="ZEP 1:5">तिंयां मणछ करनै मुंह ज़ाथी सोभ खतम।</para>
  <para style="q" vid="ZEP 1:5">ज़ुंण मणछ मुंह बिधाते सोह खाआ अर बाल देअए सोह बी खाआ,</para>
  <para style="q" vid="ZEP 1:5">तिंयां बी करनै मुंह खतम।<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />तिंयां मणछ निं मुंह ज़िऊंदै छ़ाडणैं ज़ुंण मुंह बिधाता का दूर हुऐ,</para>
  <para style="q" vid="ZEP 1:6">ज़ुंण मुंह सेटा पुछ़दै नांईं आऐ कि हुंह किज़ै च़ाहा।</para>
  <para style="q" vid="ZEP 1:6">तिंयां बी निं मुंह ज़िऊंदै डाहणैं आथी।<verse eid="ZEP 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />च़ुपच़ाप रहा! हुंह आसा सोभिओ मालक बिधाता,</para>
  <para style="q" vid="ZEP 1:7">मेरी सह धैल़ी आसा नेल़, मंऐं हेरअ बल़ीदान तैर करी,</para>
  <para style="q" vid="ZEP 1:7">मंऐं हेरै मेरै प्राहुंणैं पबित्र करी।<verse eid="ZEP 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />तैहा बल़ीदाने धैल़ी दैणीं मुंह राज़ै, टिक्‍कै, कार-करिंदै अर</para>
  <para style="q" vid="ZEP 1:8">तिन्‍नां सोभी लै सज़ा ज़ुंण पराऐ देशो रिती-रबाज़ मना।<verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />मुंह दैणीं तिन्‍नां लै सज़ा ज़ुंण बृथा देअआ-देबतै पूज़ा।</para>
  <para style="q" vid="ZEP 1:9">ईंयां बणाआं आपणैं मालका उपद्रभ अर धोखे कमाई करै सेठ।<verse eid="ZEP 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />मंऐं बिधाता डाहअ बोली कि तैहा धैल़ी शुण्हनै तम्हां</para>
  <para style="q" vid="ZEP 1:10">नगरीए म्हाछ़ली नाओंए प्रऊल़ी का हाक्‍का लांदै।</para>
  <para style="q" vid="ZEP 1:10">दुजी प्रऊल़ी का शुण्हनै तम्हां का लेरा लांदै अर</para>
  <para style="q" vid="ZEP 1:10">धारा का शुण्हनी ज़ोरै ढिम्हां-गल़िम्हीं लागी दी।<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />तम्हां लै आसा आफ़त! ज़ुंण तम्हैं</para>
  <para style="q" vid="ZEP 1:11">एरुशलेम नेल़ नगरी हाट्टै-बज़ारै आसा बस्सै दै,</para>
  <para style="q" vid="ZEP 1:11">मुंह करनै एरुशलेम नगरी का बपारी खतम,</para>
  <para style="q" vid="ZEP 1:11">ज़ुंणीं च़ंदीए ढब्बे भढार आसा भरी डाहै दै, तिंयां निं ज़िऊंदै बच़णैं।<verse eid="ZEP 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />तैहा धैल़ी लोल़णअ मुंह एरुशलेम न्हैरी कुंणी बी लाटूए प्रैश्शै करै,</para>
  <para style="q" vid="ZEP 1:12">मुंह दैणीं तिन्‍नां लै सज़ा ज़ुंण ज़मैं दै घणैं दाखे शराबा ज़िहै</para>
  <para style="q" vid="ZEP 1:12">भांडे थाल्‍लै निहंचै आसा बेठै दै। तिंयां बोला इहअ,</para>
  <para style="q" vid="ZEP 1:12">‘बिधाता नां भलअ करदअ अर नां बूरअ करदअ!’<verse eid="ZEP 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />तिन्‍नें धन-माया लुटणीं पठी अर तिन्‍नें घअर हणैं शुन्‍नैं।</para>
  <para style="q" vid="ZEP 1:13">तिन्‍नां च़िणनै आप्पू लै घअर पर तिन्‍नां निं तेथ रहणअ भेटणअ।</para>
  <para style="q" vid="ZEP 1:13">तिन्‍नां डाहणैं दाखे बाग लाई पर तेता का निं तिन्‍नां रस काढणअ भेटणअ।<verse eid="ZEP 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />मेरी महान धैल़ीओ बगत आसा पुजणैं आल़अ,</para>
  <para style="q" vid="ZEP 1:14">सह धैल़ी जाणीं तेतरी छ़ेक्‍कै पुजी।</para>
  <para style="q" vid="ZEP 1:14">तैहा धैल़ी पुजणें शणांईं शुण्हुंई लागणै बडै-बडै शूरबीर लेरा लांदै।<verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />सह हणीं मेरी रोश्शे धैल़ी, ज़ेभै घोर खरी अर आफ़त पल़णीं।</para>
  <para style="q" vid="ZEP 1:15">सह धैल़ी हणीं उज़र अर बनाशे धैल़ी।</para>
  <para style="q" vid="ZEP 1:15">तैहा धैल़ी हणअ नटिप्प न्हैरअ फेरा-फेर हणैं घणैं काल़ै बादल़ घोर्हुऐ दै।<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />लोगा का शुण्हनै तैहा धैल़ी जुधा लै नर्शिंगै बाज़दै</para>
  <para style="q" vid="ZEP 1:16">अर दुशमण सैने हाक्‍का-भ्रुका।</para>
  <para style="q" vid="ZEP 1:16">सह छ़ेल़ शुण्हनी एही कि दुशमण आसा नगरीए गहल़-कोटा ढोल़दै लागै दै।<verse eid="ZEP 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />मुंह दैणीं मणछा लै एही आफ़त पल़णै,</para>
  <para style="q" vid="ZEP 1:17">तिंयां हणैं इहै मणछा ज़िहै तोफदै लागै दै ज़हा आछी का किछ़ै निं शुझदअ।</para>
  <para style="q" vid="ZEP 1:17">किल्हैकि तिन्‍नैं किअ मुंह बिधाता लै पाप,</para>
  <para style="q" vid="ZEP 1:17">तिन्‍नों लोहू पोछणअ धरनीं पाणीं ज़िहअ,</para>
  <para style="q" vid="ZEP 1:17">तिन्‍नें ल्हासा रहणीं धरनीं कज़ेस्सी पल़ी।<verse eid="ZEP 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />मेरी बिधाते रोश्शे धैल़ी निं तिन्‍नों सुन्‍नअ-च़ंदी तिन्‍नां बच़ाऊई सकदअ।</para>
  <para style="q" vid="ZEP 1:18">मेरै रोश्शे आगी करै हणीं सारी पृथूई खतम।</para>
  <para style="q" vid="ZEP 1:18">एथ बस्सै दै हणैं सोभ हेरा-हेरी खतम।”<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">बिधाता बाखा फिरा</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 2:1" />नबिज़तै देशो! सोभ हअ कठा!<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />बिधातो नसाफ एछणैं का आजी करा झाल़अ।</para>
  <para style="q" vid="ZEP 2:2">थारअ बापस फिरनेओ बगत आसा बागरी करै डैऊंदै</para>
  <para style="q" vid="ZEP 2:2">किशा ज़िहअ दूर लागअ द डेऊंदअ।</para>
  <para style="q" vid="ZEP 2:2">बिधातो कोप पल़णै का आजी लआ एऊ कामां करी।<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />ज़ै तम्हैं तत्त दिला का तेही ज़िन्दगी ज़िऊए ज़िहअ बिधाता च़ाहा,</para>
  <para style="q" vid="ZEP 2:3">तै एछा! संघा टेक्‍का बिधाता सेटा माथअ।</para>
  <para style="q" vid="ZEP 2:3">ज़ै तम्हैं भलअ करे अर मानदार रही ज़िन्दगी ज़िऊए,</para>
  <para style="q" vid="ZEP 2:3">तै झ़ाणीं बिधाता तम्हां तैहा धैल़ी बच़ाऊई डाहे ज़ेभै</para>
  <para style="q" vid="ZEP 2:3">संसारा लै तेऊ आपणअ रोश्श तरैल़ी दैणअ।<verse eid="ZEP 2:3" /></para>
  <para style="s">पलिश्तीओ नसाफ</para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 2:4" />गाज़ा नगरीओ मुल्ख हणअ शुन्‍नअ,</para>
  <para style="q" vid="ZEP 2:4">अशकलोन नगरीओ मुल्ख हणअ उज़र।</para>
  <para style="q" vid="ZEP 2:4">अशदोद नगरी बशिंदै खद्रेल़णैं धैल़ी-दपहरै,</para>
  <para style="q" vid="ZEP 2:4">अक्रोन नगरीए बशिंदै करनै तिन्‍नें नगरी का नबारसै।<verse eid="ZEP 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />तम्हां पलिश्ती लै आसा घोर आफ़त!</para>
  <para style="q" vid="ZEP 2:5">ज़ुंण तम्हैं समुंदरे बाढै आसा बस्सै दै।</para>
  <para style="q" vid="ZEP 2:5">करेती देशा ताल्है आसा लानत! कनान बिधाता बोला ताल्है इहअ,</para>
  <para style="q" vid="ZEP 2:5">“तेरअ करनअ मुंह पठी बनाश! तेरै निं कोह बच़णअ।”<verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />समुंदरे बाढै तेरी ज़ैगा हणीं घाहे घैहण,</para>
  <para style="q" vid="ZEP 2:6">तेथ हणीं फुआलै आपणीं भेडा-बाकरीए हेल़्ही लै शाल़ा डाही दी बणाईं।<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />बिधाता निं तिन्‍नां बिस्सरुअ आथी ज़ुंण</para>
  <para style="q" vid="ZEP 2:7">यहूदे आद लुआदा मांझ़ै ज़ुंण ज़िऊंदै आसा,</para>
  <para style="q" vid="ZEP 2:7">तिन्‍नां गिम्मणी सह ज़ैगा आप्पू लै अर तिन्‍नां</para>
  <para style="q" vid="ZEP 2:7">रहणअ अशकलोन नगरी शुन्‍नैं छ़ुटै दै घअरै सुत्ती।</para>
  <para style="q" vid="ZEP 2:7">तिन्‍नां परमेशर बिधाता हणअ तिन्‍नां संघै अर तेऊ करनै तिंयां भिई भरै-पूरै।<verse eid="ZEP 2:7" /></para>
  <para style="s">मोआब अर अमोनी लै नसाफ</para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 2:8" />बिधाता बोला इहअ,</para>
  <para style="q" vid="ZEP 2:8">“मंऐं हेरअ शूणीं कि मोआबी अमोनी आसा</para>
  <para style="q" vid="ZEP 2:8">मेरी परज़े बेइज़ती करदै लागै दै, तिंयां आसा</para>
  <para style="q" vid="ZEP 2:8">मेरी परज़े सुहांगा करदै अर मेरी सिऊंआं भितरी एछी डिंगा मारदै लागै दै।<verse eid="ZEP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9" />तैही बोला हुंह स्वर्गे सारी सैनो मालक ज़ुंण इज़राईलो परमेशर आसा,</para>
  <para style="q" vid="ZEP 2:9">मंऐं खाऐ आपणैं सोह कि मुंह करनअ मोआब देश अर अमोन नगरीओ</para>
  <para style="q" vid="ZEP 2:9">सदोम अर अमोरा नगरी ज़िहअ बनाश।</para>
  <para style="q" vid="ZEP 2:9">तिंयां हणैं सदा लै लूंणे खात्ती अर उज़र ज़ेथ सिधै बाण-भेखल़ लागा।</para>
  <para style="q" vid="ZEP 2:9">ज़ुंण मेरी परज़ा मांझ़ै ज़िऊंदै हणैं, तिन्‍नां लुटणीं तिन्‍नें ज़ैदात पठी</para>
  <para style="q" vid="ZEP 2:9">संघा करनअ तिन्‍नें ज़ैगा कबज़अ।”<verse eid="ZEP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 2:10" />इहअ करै भेटणअ मोआब अर अमोने घमंड अर शरेरी गल्‍लो फल।</para>
  <para style="q" vid="ZEP 2:10">तिंयां करा तै स्वर्गे सारी सैने मालक बिधाते परज़ा बेइज़त अर शर्मिंदै।<verse eid="ZEP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 2:11" />बिधाता पाणीं तिन्‍नां लै डअर-भगैर।</para>
  <para style="q" vid="ZEP 2:11">तेऊ मारनै सारी पृथूईए देअ भुखै!</para>
  <para style="q" vid="ZEP 2:11">तेखअ टेक्‍कणअ सोभी देशे लोगा आपणीं-आपणीं नगरी</para>
  <para style="q" vid="ZEP 2:11">बिधाता सेटा माथअ।<verse eid="ZEP 2:11" /></para>
  <para style="s">कूश देशा लै नसाफ</para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />बिधाता बोला इहअ, “मुंह दैणीं कूश देशे लोगा लै सज़ा,</para>
  <para style="q" vid="ZEP 2:12">तिंयां पाणै होरी तलबारा करै काटी-फणाटी।”<verse eid="ZEP 2:12" /></para>
  <para style="s">अश्शूर देशा लै नसाफ</para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />बिधाता करनअ आपणैं महान बाहे बला करै</para>
  <para style="q" vid="ZEP 2:13">उतर दिशा बाखा अश्शूर देशो बनाश।</para>
  <para style="q" vid="ZEP 2:13">निनबे नगरी करनीं तेऊ पठी शुन्‍नीं अर</para>
  <para style="q" vid="ZEP 2:13">सह हणीं उज़र रेगीस्ताना ज़ेही शुक्‍की ज़ैगा।<verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />तेथ रहणैं नगरी भितरी बणें पशूए हेल़्ही अर कई रंगे बणें ज़ीबे छ़ुंढ बेशी।</para>
  <para style="q" vid="ZEP 2:14">थाम्हा तिन्‍नें थाम्हा प्रैंदै हणैं राची हुहल़ू अर काऊड़ै बेठै दै,</para>
  <para style="q" vid="ZEP 2:14">तिन्‍नें ताक्‍की हणैं छैंछलै लागै दै बाशदै।</para>
  <para style="q" vid="ZEP 2:14">तिन्‍नें डेहल़ हणैं शुन्‍नैं पल़ै दै अर बिधाता पाणै तिन्‍नें</para>
  <para style="q" vid="ZEP 2:14">केल़ुईए काठा करै बणाऐं दै घअर पठ ढोल़ी।<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />अह आसा सह ई नगरी ज़हा आपणीं शगतीओ खास्सअ घमंड थिअ,</para>
  <para style="q" vid="ZEP 2:15">तिंयां तै निहंचै कि तिन्‍नां निं कधि किछ़ै हंदअ।</para>
  <para style="q" vid="ZEP 2:15">ऐहा नगरीए परज़ा सोठा ती इहअ कि तिन्‍नें नगरी आसा संसारै सोभी का महान!</para>
  <para style="q" vid="ZEP 2:15">ऐबै आसा सह पठी उज़र अर शुन्‍नीं!</para>
  <para style="q" vid="ZEP 2:15">तेस्सी बाती एछदै-हांढदै बी करा खाखा अर हाथा करै शारै</para>
  <para style="q" vid="ZEP 2:15">कि भली हुई! ईंयां फिरा तै आपणैं आप पठी।<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">एरुशलेम नगरीओ पाप</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />एरुशलेम नगरी लै आसा घोर आफ़त!</para>
  <para style="q" vid="ZEP 3:1">ज़ुंण भ्रष्ट, द्रोही अर आपणीं परज़ा प्रैंदै ज़ुल्म करा।<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />अह निं कोहिए शुणदी, नैरी करै बी निं एथ सधेर आथी,</para>
  <para style="q" vid="ZEP 3:2">अह निं बिधाता दी बी भरोस्सअ करदी नां</para>
  <para style="q" vid="ZEP 3:2">आपणैं परमेशरे भबनै डेऊई तेऊए च़ाकरी करदी।<verse eid="ZEP 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />ऐहा नगरीए कार-करिंदै क्रुंगा सिहा ज़िहै,</para>
  <para style="q" vid="ZEP 3:3">एते पांच़ आसा सान्हां शकारी निखल़ै दै रुहलै ज़िहै</para>
  <para style="q" vid="ZEP 3:3">ज़ुंण राच भैणै का आजी पठ छ़ेक्‍का खाई।<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />ऐहा नगरीए गूर आसा ठगणै आल़ै, तिन्‍नों भरोस्सअ निं करी सकदै।</para>
  <para style="q" vid="ZEP 3:4">प्रोहते लाई पबित्र ज़ैगा, बिधाते बधाना दी छ़ोत ज़ेता तिंयां होरी का खोज़ा,</para>
  <para style="q" vid="ZEP 3:4">आप्पू तिंयां तेते साबै ज़िन्दगी ज़िऊंदै ई आथी!<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />पर बिधाता आसा नगरी दी परज़ा जैंदरी,</para>
  <para style="q" vid="ZEP 3:5">सह आसा धर्मीं पांच़ अर तेऊ करनअ भलअ ई, सह निं कधि बूरअ करदअ।</para>
  <para style="q" vid="ZEP 3:5">सह करा हर धैल़ै मणछो नसाफ, पर कदुष्ट मणछ ज़ुंण पाप करदै रहा, तिन्‍नां निं शरम एछदी!<verse eid="ZEP 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />बिधाता बोला इहअ, “मंऐं किऐ सोभ देश खतम,</para>
  <para style="q" vid="ZEP 3:6">तिन्‍नें नगरीओ किअ मंऐं बनाश अर तिन्‍नें गहल़-कोट डाहै मंऐं उज़र करी।</para>
  <para style="q" vid="ZEP 3:6">तिन्‍नें नगरी डाही मंऐं पठ शुन्‍नीं करी, तेथ निं कोह ज़िऊंदअ बच़अ।<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />मंऐं सोठअ इहअ, ‘ऐबै हेरनअ एरुशलेम नगरीए मेरी परज़ा मेरअ अदर करी!</para>
  <para style="q" vid="ZEP 3:7">तिन्‍नां हेरनी मेरी चतैनगी ज़िहअ हुंह बोला तेही मनी।’</para>
  <para style="q" vid="ZEP 3:7">तै निं तिन्‍नें घअर उज़र हणैं अर मुंह निं तिन्‍नां लै सज़ा दैणें ज़रुरत पल़णीं।</para>
  <para style="q" vid="ZEP 3:7">पर तिंयां रहै तज़ी बी कदुष्ट कामां करदै लागी।”<verse eid="ZEP 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />तैही बोला बिधाता इहअ, “तूह रह तैहा धैल़ी न्हैल़अ लागी,</para>
  <para style="q" vid="ZEP 3:8">ज़ेभै मुंह ज़ोरा ज़ोरी मणछा का सोभ च़िज़ा दूर करनीं।</para>
  <para style="q" vid="ZEP 3:8">मंऐं आसा सोठी हेरअ द कि मुंह करनै सोभ देश अर सोभ राज़ कठा,</para>
  <para style="q" vid="ZEP 3:8">संघा दैणअ मुंह पूरअ ज़ोर लाई आपणअ सारअ कोप तिन्‍नां प्रैंदै तरैल़ी।</para>
  <para style="q" vid="ZEP 3:8">सारी पृथूई हणीं मेरै रोश्शे आगी करै दझ़ी खतम।<verse eid="ZEP 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />तेखअ करनी मुंह मणछे बोली-भाषा च़ोखी,</para>
  <para style="q" vid="ZEP 3:9">तेखअ हणैं तिंयां मुंह बिधाता सेटा पूज़ा अर अरज़ करनै जोगी।<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />मेरी छिंगी डाही दी परज़ा ज़ुंण कूश देशे दरैऊआ पार दूर आसा बस्सै दै,</para>
  <para style="q" vid="ZEP 3:10">तिंयां एछणैं मुंह सेटा लै अरज़ करदै संघा आणनीं तिन्‍नां मुंह सेटा भैंट।<verse eid="ZEP 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />तैहा धैल़ी निं तम्हां एरुशलेम नगरीए मेरी परज़ा</para>
  <para style="q" vid="ZEP 3:11">तेता लै शर्मिंदै पल़णअ हणअ ज़ुंण तम्हैं मुल्है द्रोह किअ।</para>
  <para style="q" vid="ZEP 3:11">मुंह करनै सोभ घमंडी अर शरेरै खतम, तेखअ निं तम्हां</para>
  <para style="q" vid="ZEP 3:11">मेरी पबित्र धारा मुल्है कधि द्रोह करनअ।<verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />एरुशलेम, मुंह डाहणैं ताह दी तिंयां मानदार अर भोल़ै मणछ बच़ाऊई,</para>
  <para style="q" vid="ZEP 3:12">तिंयां रहणैं मेरै आसरै कि बिधाता सका तिन्‍नें फाज़त करी।<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />इज़राईला मांझ़ै ज़ुंण ज़िऊंदै हणैं बच़ै दै, तिन्‍नां निं झ़ुठअ बोल़णअ नां धोखअ करनअ।</para>
  <para style="q" vid="ZEP 3:13">तिंयां रहणैं राज्ज़ी-मौज़ी खांदै-पिंदै अर निहंचै सुत्ती।</para>
  <para style="q" vid="ZEP 3:13">तिन्‍नां डरैऊंणै आल़अ निं कोह हणअ।”<verse eid="ZEP 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />सियोन नगरीए लोगो, ज़ोरै-ज़ोरै बोला खुशीए गिहा!</para>
  <para style="q" vid="ZEP 3:14">इज़राईलीओ, ज़ोरै-ज़ोरै करा ज़ै-ज़ैकार!</para>
  <para style="q" vid="ZEP 3:14">एरुशलेम नगरीए लोगो, दिला का मनाऊंआं खुशी!<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />बिधाता किई थारी सज़ा माफ अर तेऊ किऐ थारै दुशमण खतम।</para>
  <para style="q" vid="ZEP 3:15">तम्हां इज़राईलीओ राज़अ बिधाता आसा तम्हां संघै।</para>
  <para style="q" vid="ZEP 3:15">खरीए धैल़ै छ़ेक्‍कै तम्हैं काटी, ऐबै निं डरने ज़रुरत ई आथी।<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />सह बगत गअ पुजी ज़ेभै एरुशलेम नगरी लै इहअ समाद एछणअ,</para>
  <para style="q" vid="ZEP 3:16">“ऐबै निं डरी आथी! ऐबै निं ज़ोर-ज़ाहण चुटणैं दैई!<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />थारअ परमेशर बिधाता आसा तम्हां संघै।</para>
  <para style="q" vid="ZEP 3:17">सह आसा बलबान अर तेऊ हेरनै तम्हैं बच़ाऊई।</para>
  <para style="q" vid="ZEP 3:17">तेऊ हणीं तम्हां करै खास्सी खुशी! सह झ़ूरा च़ुपच़ाप तम्हां लै।</para>
  <para style="q" vid="ZEP 3:17">तेऊ बोल़णीं गिह किल्हैकि सह आसा तम्हां करै खास्सअ खुश।”<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />बिधाता बोला इहअ, “ज़ुंण तम्हां मांझ़ै एता लै खास्सै दुखी रहा कि</para>
  <para style="q" vid="ZEP 3:18">तिन्‍नां निं मेरै तिह थैर मनाऊंणै भेटै, तम्हैं करनै मुंह कठा,</para>
  <para style="q" vid="ZEP 3:18">तेखअ निं तम्हैं कधि शर्मिंदै हणैं।<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />भाल़ा! तेभै दैणीं मुंह तिन्‍नां सोभी लै सज़ा ज़ुंणीं तम्हां लै दुख दैनै।</para>
  <para style="q" vid="ZEP 3:19">मुंह बच़ाऊंणै तिंयां ज़ुंण लाट्टै आसा,</para>
  <para style="q" vid="ZEP 3:19">मुंह आणनैं तिंयां बापस झाल़ी ज़ुंण दुशमणै दूर आसा निऐं दै।</para>
  <para style="q" vid="ZEP 3:19">मुंह करनअ इहअ कि सोभी देशे लोग थारै बारै ज़ाणें</para>
  <para style="q" vid="ZEP 3:19">थारी शान-शोभा अर मशूरी पजैल़णीं सारै संसारै।<verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />तैहा धैल़ी झाल़णैं मुंह तम्हैं कठा संघा आणनैं घअरा लै बापस।</para>
  <para style="q" vid="ZEP 3:20">तम्हैं करनै मुंह सारै संसारै मशूर संघा करनै मुंह तम्हैं भिई भरै-पूरै।”</para>
  <para style="q" vid="ZEP 3:20">ईंयां गल्‍ला डाही बिधाता बोली।<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>