  <para style="h">2 जोहन्‍ना</para>
  <para style="toc1">जोहन्‍ना लिखी दी दुजी च़िठी</para>
  <para style="toc2">2 जोहन्‍ना</para>
  <para style="toc3">2 जोह.</para>
  <para style="mt1">2 जोहन्‍ना</para>
  <para style="mt2">जोहन्‍ना लिखी दी दुजी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जोहन्‍ना</para>
  <para style="ili">पहल़णैं आल़ै: एकी यहूदी विश्वासी बैहणी अर तेसो शोहरू</para>
  <para style="ili">सन: 80-95</para>
  <para style="ip">जोहन्‍ने दुजी च़िठी आसा “टोलीए सैणैं” अर छ़ांटी दी परमेशरे भगत दास ज़नानी अर तेसे “लान्हैं” लै लिखी दी। एतो मतलब सका इहअ हई कि एक देसी विश्वासी टोलीए लोग। लिखणैं आल़अ बोला धख ज़ेही गल्‍ला दी इहअ लिखी करै आप्पू मांझ़ै डाहणीं झ़ूरी अर झ़ुठी गूरू अर तिन्‍नें शिक्षा का दूर।</para>
  <para style="imq">“असली झ़ूरी आसा एही कि हाम्हां लागा तिहअ करनअ ज़िहअ प्रभू हुकम करा। शुरू ओर्ही आसा तम्हैं अह हुकम शूणअ द अर ज़िन्दगी बी लागा तम्हां एही ई ज़िऊंणीं कि तम्हैं झ़ूरी करे।”</para>
  <para style="ipr">(1:6)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1-3</para>
  <para style="io1">झ़ूरीए पैहली ज़ैगा 4-6</para>
  <para style="io1">झ़ुठै धर्म बधाने बारै चतैनगी 7-11</para>
  <para style="io1">नचोल़ 12,13</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />हुंह मसीही टोलीओ सैणअ जोहन्‍ना लिखा ऐहा च़िठी तैहा बैहणी लै ज़ुंण परमेशरै आसा छ़ांटी दी अर तेसे लान्हैं लै। हुंह करा मसीहा दी तिन्‍नां लै झ़ूरी किल्हैकि हाम्हैं सोभै करा परमेशरे सत्ता दी विश्वास अर सिधअ हुंह, निं तिंयां सोभै बी करा झ़ूरी ज़हा का सत्तो थोघ आसा। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />हाम्हैं करा तम्हां लै झ़ूरी तै कि हाम्हैं सोभै करा शुची शिक्षा दी विश्वास अर हाम्हां डाहणीं तिंयां शुची शिक्षा सदा ढाकी।<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />जश, झींण अर शांती ज़ुंण बाब परमेशरा अर तेऊए पूत ईशू मसीहा का एछा, सह लोल़ी कबल्‍ली हाम्हां संघै रही ज़हा का सत्त अर झ़ूरी आसा।<verse eid="2JN 1:3" /></para>
  <para style="s">सत्त अर झ़ूरी</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />हुंह हुअ खास्सअ खुशी किल्हैकि मंऐं शूणअ तेरै कई लान्हें बारै कि तिंयां आसा परमेशरे शुची बाता ज़िन्दगी ज़िऊंदै। तिंयां आसा तिहअ करदै लागै दै ज़िहअ म्हारै बाब परमेशरै बोलअ कि हाम्हैं करे। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />ऐबै मेरी बैहण, मंऐं निं ताल्है नऊंअ किछ़ै हुकम लाई दैई, हुंह करा ताखा अरज़ कि हाम्हां लागा एकी-दुजै लै झणैल़ू हणअ। अह निं नऊंअ हुकम आथी पर अह आसा सह ई हुकम ज़ेतो हाम्हां का तधा ओर्ही आसा थोघ ज़धू हाम्हैं मसीहा दी विश्वास किअ। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />असली झ़ूरी आसा एही कि हाम्हां लागा तिहअ करनअ ज़िहअ प्रभू हुकम करा। शुरू ओर्ही आसा तम्हैं अह हुकम शूणअ द अर ज़िन्दगी बी लागा तम्हां एही ई ज़िऊंणीं कि तम्हैं झ़ूरी करे।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />हुंह बोला इहअ एते तैणीं कि कई ज़ुंण होरी आपणीं झ़ुठी शिक्षा करै कबाता पाआ, तिंयां आसा सारै दी पुजी गऐ दै। तिंयां बोला इहअ कि ईशू मसीहा निं एऊ संसारै मणछे देही दी आअ ई आथी। ज़ै कुंण मणछ इहअ बोला, सह ई मणछ आसा मसीहो बरोधी, ज़ुंण होरी लोगा कबल्‍लै कबाता डाहा पाई। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />तैही बोला हुंह कि तम्हैं डाहै आपणअ धैन कि तम्हां इहै मणछ कबाता नां पाए ताकि ज़ुंण मैन्थ हाम्हैं सोभी आसा किई दी, तेता निं बरैबाद दैई हणैं। पर तम्हां जाणीं तिंयां सोभै बर्गता भेटी ज़ेता दैणें परमेशरै ज़बान आसा दैनी दी। <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />हुंह बोला तम्हां लै इहअ कि ज़ुंण मसीहा खोज़ी दी शिक्षा दी किज़ै आपणीं बाखा राल़े अर तिन्‍नां शिक्षा दी कबल्‍लअ विश्वास नांईं करदअ, तेऊओ निं परमेशरा संघै किछ़ै रिश्तअ आथी। ज़ै कुंण कबल्‍लअ मसीहा खोज़ी दी शिक्षा दी विश्वास करा, तेऊ का आसा म्हारअ बाब परमेशर अर तेऊए पूत मसीहा ईशू दुहै।<verse eid="2JN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2JN 1:10" />ज़ै कुंण तम्हां सेटा एछे, अर मसीहा खोज़ी दी इना ई शिक्षा नांईं दैए, तेऊ नां घअरै दैई एछणैं अर नां तेऊ लै राज्ज़ी-खुशी पुछ़ी। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />किल्हैकि ज़ुंण इहै मणछो सुआगत बी करा, सह हआ तेऊए कदुष्ट कामां दी बी साझ़ू।<verse eid="2JN 1:11" /></para>
  <para style="s">खिरी अदर करनअ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />होर बी आसा कई गल्‍ला ज़ुंण हुंह तम्हां लै बोल़णअ च़ाहा, पर हुंह निं तिन्‍नां च़िठी दी लिखणअ च़ाहंदअ। पर मुंह आसा आशा कि हुंह एछणअ तम्हां सेटा लै छ़ेक्‍कै अर तेभै करनी मुंह तम्हां सम्हनै गल्‍ला ताकि तम्हां बी खुशी होए।<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="1JN 1:4">1 जोह. 1:4</ref>; <ref loc="JHN 1:13">जोह. 1:13</ref></char></note><verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />इधी तेरी बैहण ज़ुंण परमेशरै आसा छ़ांटी दी तेसे शोहरू बी दैआ ताल्है राज्ज़ी-खुशी।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>