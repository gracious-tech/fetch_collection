  <para style="h">जोना</para>
  <para style="toc1">बिधातो गूर जोना</para>
  <para style="toc2">जोना</para>
  <para style="toc3">जोन.</para>
  <para style="mt1">जोना</para>
  <para style="mt2">बिधातो गूर जोना</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जोना</para>
  <para style="ili">सन: 793 का 450 ईसा आजी</para>
  <para style="ip">जोना गूरे अह कताब निं होरी गूरे कताबा ज़ेही आथी, किल्हैकि एथ आसा सिधअ इहअ खोज़अ द कि बिधाते एकी जोना नाओंए गूरै किज़ै प्रच़ार किअ। अह कताब खोज़ा तेऊए बारै इहअ कि जोना किहअ हुअ बिधाता लै नशूण अर सह निं निनबे नगरीए लोगा लै चतैनगी दैंदअ डेऊअ, ज़सरअ बनाश त हणैं आल़अ। जोना च़ाहा त इहअ कि अश्शूर देशे राज़धानी निनबे नगरीओ बनाश लोल़ी हुअ, किल्हैकि तिंयां तै इज़राईलीए दुशमण। पर बिधाता नैरअ जोना अर खिरी पजैल़अ सह निनबे नगरी संघा खोज़अ तेऊ बिधातो समाद सोभी का।</para>
  <para style="ip">ऐहा कताबा पहल़दी समझ़ा कई लोग सिधअ एचल़ी कि जोना किहअ पाअ बडी म्हाछ़ली घुटी, पर ऐहा कताबो समाद आसा इहअ कि बिधाता करा सोभी लै झींण अर सह च़ाहा सोभी बच़ाऊंणअ, ज़िहअ जोना बोला बी:</para>
  <para style="imq">“तूह आसा खास्सअ झणैल़ू अर तूह करा सबर। तूह करा कबल्‍ली झ़ूरी अर तूह निं कोही लै सज़ा दैणीं च़ाहंदअ।”</para>
  <para style="ipr">(4:2)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">जोना निं हुकम मनअ 1:1-14</para>
  <para style="io1">बडी म्हाछ़ली घुटअ जोना 1:15, 16</para>
  <para style="io1">निनबे नगरी खोज़अ जोना समाद 3:1-10</para>
  <para style="io1">परमेशरे झींण भाल़ी हुअ जोना नराज़ 4:1-11</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">बिधाता ज़िहअ हुकम किअ, जोना निं तिहअ किअ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />इज़राईल त एक जोना नाओं मणछ, तेऊओ बाब त अमाती। एकी बारी बोलअ बिधाता जोना लै इहअ, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“तूह डेऊ एभी बडी नगरी निनबे लै, संघा दै तैहा नगरीए लोगा लै मेरअ समाद खोज़ी चतैनगी कि मंऐं लाअ तिन्‍नों बनाश करी, किल्हैकि मुखा आसा शुझदअ लागअ द कि निनबे नगरीए लोग आसा खास्सै कदुष्ट हुऐ दै।”<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />पर जोना निं निनबे लै डेऊअ! सह ठुर्हअ बिधाता सेटा का पोर्ही उंबल़ी बाता तरशीश नगरी बाखा लै। सह पुजअ जोपा नगरी, तिधी भेटअ तेऊ तरशीश नगरी लै डेऊंदअ एक समुंदरो ज़हाज़। तेऊ दैनअ तेथ आपणअ कराऊअ संघा बेठअ तेथ होरी लोगा संघै। ताकि सह बिधाता सेटा का दूर ठुर्ही तरशीश नगरी लै डेओए।<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />पर बिधाता छ़ाडी समुंदरे पाणीं दी बडी ढिश-बागर अर समुंदरै लागी एही उछ़टी छ़ाल्‍ली लागी ज़हाज़ा दी एही ज़ोरै लागदी कि ज़हाज़ च़ाल्‍लअ त चुटी! <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ज़हाज़ा दी बेठै दै सोभ लोग लागै डरै आपणैं देअआ-देबतै संज़रदै। ज़हाज़ा दी शुंआर सोभी लोगै शोटअ आपणअ ज़हाज़ा दी लादअ द समान समुंदरे पाणीं जैंदरी ताकि ज़हाज़ो बोझ़अ हल़कअ होए अर ज़हाज़ नां डुबे।</para>
  <para style="p" vid="JON 1:5">पर जोना डेऊअ ज़हाज़ा भितरी सोभी का थाल्‍ले मज़ला संघा रहअ तिधी घणीं निंजा सुत्ती! <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />ज़हाज़े कप्ताना भेटअ सह तेथ सुत्तअ द, अर तेऊ बोलअ जोना लै, “लै तूह किज़ू आसा इधी नकैंस्सअ रहअ द सुत्ती? खल़अ उझ़ू संघा कर आपणैं देअआ का अरज़! हई सका कि तेरअ देअ तेरी अरज़ शुणें अर हाम्हां सोभी डुबणै का बच़ाऊई हेरे!”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />खिरी लागै ज़हाज़ा दी शुंआर सोभ लोग एकी-दुजै लै बोल्दै, “हाम्हां पुछ़णै परच़ी पाई आपणैं देअ कि अह आफ़त हाम्हां मांझ़ै कहा करै पल़ी।” तेखअ पाई तिन्‍नैं परच़ी अर तेथ निखल़अ जोनो नाअं! <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />तेखअ लागै तिंयां लोग जोना लै बोल्दै, “ऐबै खोज़ तूह, अह आफ़त हाम्हां लै कुंणी पाई? तूह किज़ै काम करा? तूह आअ किधा का? तूह केऊ देशा का आअ? तेरी ज़ात किज़ै आसा?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />जोना दैनअ तिन्‍नां लै ज़बाब, “हुंह आसा इब्रानी, हुंह मना स्वर्गे परमेशर बिधाता ज़ुंणी धरती अर समुंदर आसा बणाअं द।”<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />जोना खोज़अ तिन्‍नां का इहअ कि सह आसा बिधाता सेटा का ठुर्ही आअ द। ऐहा गल्‍ला शूणीं डरै ज़हाज़े सोभ लोग होर बी खास्सै! तिन्‍नैं बोलअ जोना लै, “अह डाहअ तंऐं बिधाता लै बेघै कबध खटी!” <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ढिश-बागर अर छ़ाल्‍ली उझ़ुई होर बी खास्सी! तेखअ लागै लोग जोना पुछ़दै, “हाम्हां ताल्है किज़ै हुअ करनअ कि हाम्हैं ऐहा आफ़ता का बच़े?”<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />जोना दैनअ ज़बाब, “मुंह शोटा ज़हाज़ा का बागै समुंदरै! तेखअ जाणी अह ढिश-बागर शांत हई। किल्हैकि मुखा आसा थोघ कि अह ढिश-बागर आफ़त आसा तम्हां लै मुंह ई करै पल़ी दी।”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />पर लोग निं जोना समुंदरै शोटणअ च़ाहंदै तै। तिन्‍नैं किई पूरअ ज़ोर लाई कोशिश कि ज़हाज़ा किधी समुंदरे बाढै पजैल़ी टकैल़ै, पर तिंयां निं इहअ करी सकै! ढिश-बागरी आणै तिंयां होर बी खास्सै हारी-मारी। <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />तिंयां लागै बिधाता लै पकार पाई अरज़ करदै, “हे बिधाता, तूह निं हाम्हां एऊ मणछा मरनै पिछ़ू सज़ा दैई! एऊ नर्दोश मणछे हत्या करनैओ दोश निं हाम्हां लोल़ी लागअ। इना सोभी गल्‍ले ज़िम्मैंबार आसा तूह ई, अह किअ तंऐं आप्पै।”<verse eid="JON 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JON 1:15" />तेखअ च़कअ तिन्‍नैं जोना संघा शोटअ समुंदरै, अर हेरा-हेरी हुअ समुंदरो ढिश-बागर अर छ़ाल्‍ली शांत। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ज़ांऊं इहअ हंदअ शुझुअ, ज़हाज़े सोभी लोगा पल़ी बिधाते डअर, अर तिन्‍नैं किऐ बिधाता लै बल़ीदान अर आजू लै बी मनी तिन्‍नैं एही मानत कि तिन्‍नां करनी सिधी बिधाते च़ाकरी।<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />ज़ांऊं जोना समुंदरै पल़अ, बिधाता छ़ाडी एक बडी म्हाछ़ली कि सह जोना घुटी पाए। जोना रहअ चिई धैल़ी अर चिई राची तैणीं तैहा म्हाछ़लीए पेटै।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">जोना किई अरज़</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />म्हाछ़लीए पेटा भितरी लागा जोना परमेशर बिधाता का अरज़ करदअ,<verse eid="JON 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JON 2:2" />“हे बिधाता, ज़ेभै मुल्है आफ़त पल़ा, हुंह पाआ ताह सेटा पकार</para>
  <para style="q" vid="JON 2:2">अर तूह हेरा मेरी अरज़ शूणीं।</para>
  <para style="q" vid="JON 2:2">ज़ेभै मंऐं मौते डुघी खात्ती का बी ताह सेटा अरज़ करी मज़त मांगी,</para>
  <para style="q" vid="JON 2:2">तंऐं शूणीं तेता का बी मेरी अरज़।<verse eid="JON 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JON 2:3" />तंऐं शोटअ हुंह डुघै समुंदरै,</para>
  <para style="q" vid="JON 2:3">तंऐं पजैल़अ हुंह घर्होहल़ी करै समुंदरे थाल्‍लै।</para>
  <para style="q" vid="JON 2:3">समुंदरे छ़ाल्‍ली घ्रोस्सअ हुंह फेरा-फेर,</para>
  <para style="q" vid="JON 2:3">तेरी दैंत्तर छ़ाल्‍ली हेठै दाभूअ हुंह पठी।<verse eid="JON 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JON 2:4" />तेखअ सोठअ मंऐं, ‘ओ बिधाता, तंऐं शोटअ हुंह आप्पू का दूर!</para>
  <para style="q" vid="JON 2:4">ऐबै निं हुंह कधि ताह सेटा बापस पुजी सकदअ!</para>
  <para style="q" vid="JON 2:4">ऐबै निं मुंह तेरअ पबित्र भबन भिई भाल़णअ भेटणअ!’<verse eid="JON 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JON 2:5" />हुंह त छ़ाल्‍ली जैंदरी समुंदरै डुबअ द</para>
  <para style="q" vid="JON 2:5">मेरी ज़िन्दगी लै ती आफ़त पल़ी दी,</para>
  <para style="q" vid="JON 2:5">मुंह फेर त पाणीं ई पाणीं, मेरै मुंडै त शबाल़ शाचअ द।<verse eid="JON 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JON 2:6" />हुंह डुबअ समुंदरै पर्बते थाल्‍लै तैणीं,</para>
  <para style="q" vid="JON 2:6">मंऐं हेरअ त सोठी कि हुंह हुअ तैहा ज़ैगा कैद अर ऐबै निं हुंह तेता का कधि छ़ुटदअ!</para>
  <para style="q" vid="JON 2:6">पर ओ बिधाता, तेता का बी बच़ाऊई तंऐं मेरी ज़िन्दगी!</para>
  <para style="q" vid="JON 2:6">तंऐं बच़ाऊअ हुंह तैहा मौता का बी।<verse eid="JON 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JON 2:7" />हुंह त ज़िक्‍की दैंदअ गअ द लागी,</para>
  <para style="q" vid="JON 2:7">तेखअ लागअ हुंह ताह बिधाते बारै सोठदअ,</para>
  <para style="q" vid="JON 2:7">मंऐं किई ताखा अरज़ अर मेरी पकार पुजी तेरी पबित्र ज़ैगा</para>
  <para style="q" vid="JON 2:7">ज़िधी तूह बस्सअ द आसा।<verse eid="JON 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JON 2:8" />ज़ुंण लोग बृथा मुहुर्तीए पूज़ा करा, तिंयां समझ़ा ताह नकदरै</para>
  <para style="q" vid="JON 2:8">ज़ुंण तिन्‍नां लै झींण च़ाहा करनी।<verse eid="JON 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JON 2:9" />पर मुंह बोल़णीं तेरअ शूकर करना लै गिह, मुंह करनअ ताल्है बल़ीदान,</para>
  <para style="q" vid="JON 2:9">मुंह करनअ तिहअ ई ज़िहअ करने मंऐं मानत आसा मनी दी।</para>
  <para style="q" vid="JON 2:9">ओ बिधाता, सह आसा तूह ई ज़ुंण हाम्हां बच़ाऊई सका।”<verse eid="JON 2:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />तेखअ किअ बिधाता तैहा बडी म्हाछ़ली लै हुकम कि जोना हुकर समुंदरे बाढै पजैल़ी पोर्ही अर म्हाछ़ली बी किअ तिहअ ई।<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">खिरी किअ जोना ज़िहअ बिधाता बोलअ तिहअ ई</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />बिधाता किई जोना संघै भिई गल्‍ला, <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“तूह डेऊ बडी नगरी निनबे लै। ज़ुंण समाद मुंह ताखा दैणअ, तूह खोज़ै तेता तिन्‍नां का।”<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />जोना शूणअ ज़िहअ बिधाता बोलअ तिहअ संघा डेऊअ सह निनबे नगरी लै।</para>
  <para style="p" vid="JON 3:3">निनबे ती बडी नगरी, सह ती एतरी बडी नगरी कि तेते एकी पुंझ़ा का दुजै पुंझ़ा तैणीं डेऊंणा लै लागा तै पैदल हांढी चअन धैल़ै। <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />जोना लागअ तैहा नगरी हांढदअ, एकी धैल़ी हांढी लागअ सह सोभी का इहअ समाद खोज़दअ, “सिधै च़ाल़्ही धैल़ै रहै, तेखअ हणअ निनबे नगरीओ बनाश!” <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />निनबे नगरी बस्सै दै लोगै शूणअ परमेशरो समाद संघा किअ तिन्‍नां गल्‍ला दी विश्वास। तेखअ डाही तिन्‍नैं प्राश्त करना लै धैल़ी संघा रहै ब्रतू। निनबे नगरी होछ़ै का प्रोढै तैणीं ज़ेतरै बी मणछ थिऐ, तिन्‍नैं डाहै शोग करना लै घेरी खिंथल़ै बान्हीं।<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ज़ांऊं अह खबर निनबे नगरीए राज़ै सेटा बी पुजी। सह उझ़ुअ आपणीं राज़गाद्दी का तेभी, आपणअ राज़ैओ सुआब खोल्हअ पोर्ही संघा बेठअ घेरी खिंथल़ै बान्हीं छ़ारे रूल़ी प्रैंदै। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />राज़ै किअ निनबे नगरीए आपणीं सारी परज़ा लै इहअ हुकम ज़ारी, “राज़ै अर सोभी कार-करिंदै बाखा आसा सारी परज़ा लै इहअ हुकम कि तम्हैं निं नाज़ो दाणअ बी खाखा पाई, च़ाऐ सह मणछ होए, पशू होए, भेडा-बाकरी होए, गाऊई-बल्द होए ज़ाथी निं कोह किछ़ै खाई अर नां पाणीं झुटी।<verse eid="JON 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JON 3:8" />“सोभ मणछ डाहै घेरी खिंथल़ै बान्हीं, आपणैं पशू अर डागै-धणा लै बी डाहै खिंथल़ै पल़ेटी। सोभ मणछ लाऐ हिक्‍का पटाक्‍की लेरा संघा करै परमेशरा सेटा अरज़। तम्हैं सोभ छ़ाडा कदुष्ट काम अर पाप करनअ। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />तै झ़ाणीं इहअ होए कि परमेशर हाम्हां लै माफी छ़ाडे! अर सह आपणअ रोश्श फांभअ करे! झ़ाणीं इहअ करै सह म्हारअ बनाश करनै का पिछ़ू हटी जाए!”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />ज़ांऊं परमेशरै भाल़अ कि निनबे नगरीए सोभी मणछै किअ प्राश्त, तिन्‍नैं हेरै कदुष्ट अर पापी काम करनै छ़ाडी। तेखअ सोठअ परमेशरै इहअ कि ऐबै निं तेऊ निनबे नगरी लै आफ़त पाणीं ज़िहअ तेऊ बोलअ त कि निनबे नगरीओ करनअ बनाश।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s1">जोना किऐ रोश्श अर परमेशरै किई झींण</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />जोना हुअ एता लै खास्सअ नराज़ अर तेऊ आई रोश्शै। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />संघा किई तेऊ बिधाता सेटा एही अरज़, “बिधाता, ज़ेभै हुंह आपणैं घअरा का निखल़अ, तेभी हेरअ त मंऐं सोठी कि ताह करनअ इहअ ई कि ताह निं निनबे नगरीओ बनाश करनअ! तैही समझ़अ मंऐं तरशीश नगरी बाखा ठुहर्नअ भलअ! किल्हैकि मुखा त थोघ कि तूह आसा खास्सअ झणैल़ू अर तूह करा सबर। तूह करा कबल्‍ली झ़ूरी अर तूह निं कोही लै सज़ा दैणीं च़ाहंदअ। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />बिधाता, एता का दै तूह मुल्है मौत! ज़िऊंदै रहणैं का आसा मेरअ मरनअ खरअ!”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />बिधाता दैनअ जोना लै ज़बाब, “तेरअ इहअ रोश्श करनअ निं ठीक आथी!”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />जोना लागअ निनबे नगरी हांढदअ, संघा डेऊअ नगरीए पुर्बा बाखा। तेऊ बणाईं आप्पू लै होछ़ी ज़ेही छ़ान संघा रहअ तेथ हेठै छ़ैल्‍ली बेठी। सह रहअ तिधा का भाल़अ लागी कि निनबे नगरी लै किज़ै हणअ। <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />तेखअ पज़ेरी बिधाता तिधी बडै-बडै पाचा आल़ी लऊंण अर सह बझ़ी उझै संघा फुआरुऐ जोने मुंडा प्रैंदै ताकि जोना लै चटाक धुप्पै का छ़ैल्‍ली दी राम होए। जोना हुअ तैहा लऊंणीं लै खास्सअ राज्ज़ी।<verse eid="JON 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 4:7" />पर दुजै धैल़ै दोत्ती-दोत्थी छ़ाडी बिधाता एक गाल़्ही अर तैहा गाल़्ही खाई सह लऊंण एही कि सह शुक्‍की! <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />ज़ांऊं धुप्पअ लागअ, बिधाता छ़ाडी पुर्बा बाखे तात्ती बागरी अर धुप्पअ लागअ जोने मुंडा प्रैंदै इहअ कि तेऊ निं तराण ई रहै। सह लागअ इहअ बोली आप्पू लै मौत मांगदअ, “ऐहा ज़िन्दगी का आसा मरनअ खरअ!”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />पर बिधाता बोलअ जोना लै इहअ, “ऐहा लऊंणीं शुक्‍कणैं पिछ़ू तेरअ रोश्श करनअ कै ठीक आसा?”</para>
  <para style="p" vid="JON 4:9">जोना दैनअ ज़बाब, “मेरअ रोश्श करनअ आसा ठीक, हुंह आसा नराज़, हुंह च़ाहा मरनअ।”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />बिधाता बोलअ जोना लै इहअ, “तंऐं च़ेती ऐहा लऊंणीं लै बडी भारी खास्सी माल़ी ज़ेता लै तंऐं किछ़ै मैन्थ निं आथी ती किई दी! ज़ुंण लऊंण झ़ट च़ार एकी राची भितरी बझ़ी अर दुजी राची लै गई शुक्‍की! <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />तै ईंयां निनबे नगरीए मणछो मोल कै ऐहा लऊंणीं का खास्सअ निं आथी ज़ेथ एक लाख बिह हज़ार मणछ आसा, ज़ुंण अज़ी भलै अर बूरैओ भेद ई निं समझ़दै! एता का लाऊआ आसा एथ खास्सै नर्दोश पशू बी। तै मुंह कै ऐहा एतरी बडी नगरी लै माल़ी निं च़ेतणी?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>