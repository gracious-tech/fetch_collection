  <para style="h">दानिएल</para>
  <para style="toc1">दानिएल गूरै खोज़ी दी गल्‍ला ज़ुंण आजू निभणी</para>
  <para style="toc2">दानिएल</para>
  <para style="toc3">दान.</para>
  <para style="mt1">दानिएल</para>
  <para style="mt2">दानिएल गूरै खोज़ी दी गल्‍ला ज़ुंण आजू निभणी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: दानिएल</para>
  <para style="ili">सन: 605 का 530 ईसा आजी</para>
  <para style="ip">दानिएल ज़धू ज़ुआन आसा त, सह निंयं बाबेल देशे सैना यहूदा मुल्खे सैणैं अर कार-करिंदै संघै कैद करी बाबेल देशा लै अर एरुशलेम नगरी हेरअ त बाबेल देशे राज़ै कबज़अ करी। ऐहा कताबे पैहलै छ़ह धैऊआ दी खोज़ा दानिएल कि सह अर तेऊए होर साथी बणैं बाबेल देशे राज़ दरबारै खास अफसर। पर तिंयां रहै खास्सै खातरै जैंदरी तोही बिधाता लै पठी शुचै-पाक्‍कै।</para>
  <para style="ip">आगलै साता का बारा धैऊआ दी खोज़ा दानिएल गूर आपणैं कई धैनै-सुपने बारै ज़ुंण तेऊ बिधाता बाखा स्वर्ग दूता बाती बाबेल देशै हुऐ।</para>
  <para style="ip">ऐहा कताबा दी लागा हाम्हां का थोघ कि मणछे हर गल्‍ला आसा परमेशरे बशै। सह दैआ बडअ राज़ हणैं अर बादा का दैआ सह तेऊ राज़ा प्रैंदै कहा होरीओ राज़ हणैं। ज़ुंण मणछ बिधाता लै शुचअ-पाक्‍कअ रहा, सह डाहा तेऊओ बी धैन-खैल। खिरी करा सह संसारो नसाफ संघा दैआ आपणीं शुची-पाक्‍की परज़ा लै ज़ीत। दानिएल खोज़ा इधी इहअ कि खिरी बिधाता तिन्‍नां लै केही ज़ीत दैणीं:</para>
  <para style="imq">“मंऐं भाल़अ राची एऊ सुपनै दी इहअ सरगा का आसा बादल़ा संघै कुंण मणछा ज़िहअ मुंह बाखा एछदअ लागअ द। सह डेऊअ तेऊ सेटा ज़ुंण सदा ज़िऊंदअ आसा अर लोगै किअ सह परमेशरा सेटा खल़अ। परमेशरै किअ तेऊओ अदर अर तेऊ दैनअ तेऊ मणछा लै राज़ करनैओ हक, सोभी देशै अर सोभी बोली-भाषा बोल़णैं आल़ै हुऐ तेऊए च़ाकरी करना लै सैहमत। सह हणअ सदा लै राज़अ अर तेऊओ राज़ निं कोह खतम करी सकदअ।”</para>
  <para style="ipr">(7:13,14)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">दानिएलै खोज़अ महान करारे सुपनैओ फल 1:1—2:49</para>
  <para style="io1">शदराक, मेशक, अबेदनागू बच़ाऊऐ आगी जैंदरा का 3:1-30</para>
  <para style="io1">नबूकदनेसर राज़ैओ सुपनअ 4:1-37</para>
  <para style="io1">बनाश हणें बारै गल्‍ला 5:1-31</para>
  <para style="io1">सिहे जुहल़ी दी दानिएल 6:1-28</para>
  <para style="io1">च़ऊ पशूओ सुपनअ 7:1-28</para>
  <para style="io1">गाभ, बाकरै अर होछ़ै शींगो सुपनअ 8:1-27</para>
  <para style="io1">दानिएल गूरे बिधाता सेटा अरज़ 9:1-27</para>
  <para style="io1">खिरीओ घोर जुध 10:1—12:13</para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानिएल अर तेऊए चअन साथी</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />ज़धू यहूदा मुल्खै जेहोकीम राज़अ थिअ, तेऊए राज़ा दी चिऊथी साला छ़ेल़अ बाबेल देशे राज़ै नबूकदनेसरै एरुशलेम नगरी संघै जुध।<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 राज़. 24:1</ref>; <ref loc="2CH 36:5-7">2 इति. 36:5-7</ref> </char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 राज़. 20:17</ref>,<ref loc="2KI 20:18">18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 इति. 36:10</ref>; <ref loc="ISA 39:7">ईशा. 39:7</ref>,<ref loc="ISA 39:8">8</ref> </char></note>बिधाता दैनअ नबूकदनेसर राज़ै यहूदा मुल्खे राज़ै जेहोकीमा कैद करनै संघा निंईं म्हारै मालक बिधाते भबना का कई च़िज़ा होरी कैदी संघै बाबेल देशा लै। तिधी पुजी डाही तेऊ तिंयां च़िज़ा आपणैं देअए देहुरै।<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2CH 36:7">2 इति. 36:7</ref></char></note><verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />नबूकदनेसर राज़ैओ थिअ गुंझी मांझ़ै एक बडअ बज़ीर अर तेऊ नाअं त अशपनाज़, राज़ै किअ तेऊ लै हुकम, “तूह आण इज़राईली कैदी मांझ़ै ज़ुआन यहूदी मणछ ज़ुंण राज़ घरानै अर खास मशूर घरानै का होए। <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />तिन्‍नां मांझ़ै आणै तूह इहै ज़ुंण नरोगै अर हेरनै बित्तै होए, तिंयां समझ़कार अर छ़ल़ैघ होए ताकि हर गल्‍ला झ़ट च़ारै समझ़े अर शिखल़े। तिंयां लोल़ी मुंह नबूकदनेसर राज़े च़ाकरी करनै जोगी हुऐ ज़ुंण बाबेल देशे भाषा दी गल्‍ला करी, तेता पहल़ी अर लिखी सका।” <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />इहअ बी किअ राज़ै हुकम कि हर धैल़ै दैऐ तिन्‍नां लै तिहअ ई खाणां-पिणां लै ज़ुंण राज़ दरबारै राज़ै लै हआ बणाअं द। चिई साला तैणीं सखाऊंणी तिन्‍नां का हर गल्‍ला अर तेखअ करै तिन्‍नां राज़े च़ाकरी करना लै पेश। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />ज़ुंण बाबेल देशे राज़े च़ाकरी लै छ़ांटै, तिंयां तै यहूदा गोत्रा का दानिएल, हनानी, मिशेल अर अजर्याह। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />राज़े तेऊ गुंझी मांझ़ै बडै बज़ीरै डाहै तिन्‍नें नऊंऐं नाअं: दानिएला नाअं डाहअ बेलतेशर, हनानी नाअं डाहअ शदराक, मिशेला नाअं डाहअ मेशक अर अजर्याह नाअं डाहअ तेऊ अबेदनागू।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पर दानिएलै ती दिलै एही डाही दी कि तेऊ निं राज़ दरबारो भोज़ खाई अर तेऊ नशै आल़ै दाखे रसा झुटी आप्पू छ़ोतलै हणअ ज़ेता राज़अ झुटा। तैही किई तेऊ अशपनाज़ बज़ीरा सेटा अरज़ कि सह तेऊए ऐहा गल्‍ला लै मज़त करे। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />मालके हुणाकार हुई एही कि अशकनाज़ बज़ीर हुअ दानिएला लै खास्सअ झणैल़ू। <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />अशपनाज़ बज़ीर डरा त राज़ै का अर तैही बोलअ तेऊ दानिएला लै, “अह आसा राज़ेए मरज़ी कि तम्हैं एता खाए, ज़ै तूह तेऊ का होरी ज़ुआन मर्धा का दुबल़अ अर रोगी शुझिए, तेऊ पाणअ तूह रोश्शै मारी अर ताह पिछ़ू सका सह मुंह बी मारी पाई।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />अशपनाज़ गुंझी बज़ीरै त एक भढारी डाहअ द कि सह दानिएल, हनानी, मिशेल अर अजर्याह लै खाणैं-पिणैंओ इंतज़ाम सभाल़े। दानिएलै बोलअ तेऊ लै, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“मेरी आसा ताखा अरज़ कि तूह परख हाम्हां दसा धैल़ै तैणीं अर एतरै धैल़ै दै तूह हाम्हां लै खाणां लै भाज़ी अर झुटणा लै सिधअ पाणीं। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />तेखअ भाल़ै तूह कि हाम्हैं तिन्‍नें मकाबलै किहै हणैं ज़ुंण राज़ दरबारो भोज़ खांदै आसा लागै दै।”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />सह भढारी हुअ दानिएल अर तेऊए साथीए गल्‍ला लै सैहमत संघा रहअ दसा धैल़ी तैणीं तिन्‍नां ज़ाच़दअ लागी। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />ज़ांऊं दस धैल़ी बिति, तिंयां शुझुऐ तिन्‍नां होरी का खास्सै मोट्टै-धोटै खुब ज़ुंण राज़ दरबारो खास भोज़ पै खाआ तै। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तधा पोर्ही लागअ सह भढारी तिन्‍नां लै तिन्‍नें मरज़ीए शाग-भाज़ी खाणां लै दैंदअ अर तेखअ निं तेऊ तिन्‍नां सेटा राज़ दरबारो खास भोज़ अर दाखो रस तिन्‍नां लै दैनअ।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />परमेशरै दैनी दानिएल, हनानी, मिशेल अर अजर्याह लै खास्सी समझ़-बुध अर तिन्‍नैं शिखल़ी कई बोली-भाषा पहल़णीं लिखणी। एता का लाऊआ दैनअ दानिएला लै इहअ बरदान कि सह सका त धैनै-सुपनैओ फल बी खोज़ी।<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="JAS 1:5">याक. 1:5</ref>,<ref loc="JAS 1:17">17</ref></char></note><verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />राज़ै नबूकदनेसरै त हुकम किअ द कि ज़ांऊं चिई साला तैणीं तिंयां सोभै गल्‍ला शिखल़ी मुक्‍के, तेखअ करै तिन्‍नां तेऊ सेटा पेश। ज़ांऊं चअन साला बिति, अशपनाज़ बज़ीरै निंयैं तिंयां नबूकदनेसर राज़ै सेटा। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राज़ै किई तिन्‍नां सोभी संघै गल्‍ला अर तेऊ गम्मै दानिएल, हनानी, मिशेल अर अजर्याह कि तिंयां तै होरी सोभी ज़ुआन शोहरू का हर गल्‍ला लै बधिया। तेखअ बणाऐं तिंयां च़ार ज़ण्हैं राज़ेए च़ाकरी करनै आल़ै। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />ज़िहै बी राज़ै सुआल पुछ़ै अर ज़ेऊ बी साबै सह तिन्‍नां परखणअ च़ाहा त, तिन्‍नैं च़ऊ ज़ण्हैं दैनअ बडी समझ़-बुध डाही हर ज़बाब। राज़ै भाल़अ कि तिंयां ज़ेतरै देशा प्रैंदै सह राज़ करा, तेथ आसा तिंयां सोभी च़लैई करनै आल़ै अर जोतषी का दस गुणा राम्बल़ै। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />ज़ेभै तैणीं फारस देशे माहा राज़ै कुस्रू बाबेल देशा दी कबज़अ निं किअ, तेभै तैणीं रहअ दानिएल बाबेल देशै राज़ दरबारै च़ाकरी दी।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबूकदनेसर राज़ैओ सुपनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />माहा राज़ै नबूकदनेसरा ती राज़अ बणी दुजी साल लागी दी। तैहा साला हुअ एकी राची तेऊ एक सुपनअ, तेता करै पल़अ तेऊ खास्सअ फिकर अर तेऊ निस्सी राची नींज बी पल़ी। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />तेऊ शादै आपणैं दास संघा किअ इहअ हुकम कि तिंयां कसदी लोगा मांझ़ै ज़ाण-प्रबीण जोतषी, ज़ादू अर च़लैई करनै आल़ै शादी आणे अर तिंयां तेऊए सुपनैओ फल अर समाधान खोज़े। ज़ांऊं तिंयां राज़ै सेटा पजैल़ै, <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />राज़ै बोलअ तिन्‍नां लै इहअ, “मुंह हुअ एक सुपनअ अर तेता करै आसा मुंह खास्सअ फिकर पल़अ द। हुंह च़ाहा इहअ कि तम्हैं तेतो फल खोज़े।”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तिन्‍नैं कसदी दैनअ राज़ै लै अरामी बोली दी ज़बाब, “माहा राज़, तेरी अमर लोल़ी खास्सी हुई! तूह खोज़ आपणअ सुपनअ हाम्हां का अर हाम्हैं तेरै दास खोज़ूं तेतो फल।”<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />राज़ै बोलअ तिन्‍नां कसदी लै, “नां, सुपनअ निं हुंह तम्हां का खोज़दअ! हुंह च़ाहा इहअ कि तेता बी खोज़ा तम्हैं ई कि मुंह किज़ै सुपनअ हुअ अर तेतो फल बी खोज़ा तम्हैं ई। ज़ै तम्हैं नांईं खोज़े, तै समझ़ै तम्हैं इहअ कि मुंह करनै थारै काटी करै ठोर-ठोर अर थारै घअर बी करनै मुंह इहै बरैबाद कि तेथ बच़णीं सिधी पात्थरे डिंगरी! <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />पर ज़ै तम्हैं खोज़े कि मुंह किहअ सुपनअ हुअ अर तेतो फल किज़ै आसा, तै करनअ मुंह थारअ खास्सअ अदर अर तम्हैं दैणैं मुंह सुन्‍नैं-च़ंदी करै लादी। ऐबै खोज़ा तम्हैं मेरअ सुपनअ अर तेतो फल।”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />तिन्‍नैं दैनअ राज़ै लै भिई ज़बाब, “माहा राज़, ज़ीबाण, तूह खोज़ सिधअ इहअ कि ताह किज़ै सुपनअ हुअ? तेखअ हेरनअ हाम्हां तेतो फल खोज़ी।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राज़ै बोलअ तिन्‍नां लै, “तम्हां का आसा थोघ कि ज़ुंण मंऐं बोली हेरअ, हुंह करा तिहअ ई। हुंह गअ समझ़ी कि तम्हैं आसा ऐबै एते तैणीं गल्‍ला करदै कि तम्हां एता लै खास्सअ बगत भेटे। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />ज़ै तम्हैं मुखा सुपनअ नांईं खोज़े, तम्हां लै दैणीं मुंह अह ई सज़ा। तैही आसा तम्हैं आप्पू मांझ़ै जोग किअ द कि तम्हां रहणअ मुंह संघै ओर्ही-पोर्हीए गल्‍ला करी गप्पा मारदै लागी अर तेखअ जाणै तम्हैं मेरी सज़ा का किहअ करै बच़ी! पैहलै लआ तम्हैं मुखा मेरअ सुपनअ खोज़ी! तेखअ समझ़ूं हुंह कि तम्हैं सका तेतो फल बी खोज़ी।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />तिन्‍नैं कसदी दैनअ राज़ै लै ज़बाब, “माहा राज़अ, धरती दी निं इहअ कोह मणछ आथी ज़ुंण तेरी ऐहा गल्‍ला पूरी करी सके। बडै-बडै राज़ै अर माहा राज़ै बी निं आझ़ तैणीं जोतषी अर पंडता का एही गल्‍ल पुछ़ी ई आथी। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />माहा राज़, ज़ुंण गल्‍ल तंऐं पुछ़ी; सह आसा हाम्हां लै कठण, ऐहा गल्‍ला सका सिधै देअ-देबी ई खोज़ी ज़ुंण मणछा जैंदरी रहंदै ई निं आथी।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />ऐहा गल्‍ला शूणीं आई राज़ै खास्सी रोश्शै अर तेऊ दैनअ हुकम कि बाबेल देशे राज़ा दी ज़ेतरै बी जोतषी अर पंडत आसा, तिन्‍नां सोभी पाआ मारी। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />ज़ांऊं अह हुकम ज़ारी हुअ अर सैना तै सोभ जोतषी अर पंडत मारी लाऐ दै। तिंयां तै दानिएल अर तेऊए साथी लोल़ै बी लागै दै कि तिन्‍नां बी मारे।<verse eid="DAN 2:13" /></para>
  <para style="s">बिधाता खोज़अ दानिएला का राज़ैओ सुपनअ</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />राज़ेए फाज़त करनै आल़ै सपाहीए सैनापति त आर्योक ज़हा लै बाबेल देशै जोतषी अर पंडता मारनैओ हुकम त भेटअ द। दानिएल डेऊअ तेऊ सेटा लै संघा किई तेऊ संघै बडी अक्ल अर शांत लैहज़ै दी गल्‍ला। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />दानिएलै पुछ़अ आर्योक, “राज़ै इहअ नर्दैई हुकम किल्है किअ ज़ारी?” एता लै खोज़ी आर्योक सैनापति राज़ै हुऐ दै सुपनै आल़ी सारी गल्‍ला कि इहअ-इहअ हुअ। <verse eid="DAN 2:15" /><verse number="16" style="v" sid="DAN 2:16" />इना गल्‍ला शूणीं डेऊअ दानिएल तेभी नबूकदनेसर राज़ै सेटा, संघा बोलअ इहअ, “माहा राज़, तूह डाह मुखा एक धैल़ी खोज़ी, तैहा धैल़ी दैंऊं हुंह ताखा तेरअ सुपनअ अर तेतो फल खोज़ी।”<verse eid="DAN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17" />तेखअ डेऊअ दानिएल तिधा का आपणैं घअरा लै फिरी अर तेखअ खोज़ी आपणैं साथी हनानी, मिशेल अर अजर्याह का तिंयां सोभै गल्‍ला कि इहअ-इहअ हुअ। <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />दानिएलै बोलअ तिन्‍नां लै, “ऐहा गल्‍ला लै करा स्वर्गे महान परमेशरा सेटा अरज़ कि सह हाम्हां लै झींण करे, हाम्हैं निं बाबेल देशै सोभी दरबारी अर पंडता संघै मारै लोल़ी।” दानिएलै साथी किअ इहअ ई। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />एता बाद खोज़अ तैहा ई राची परमेशरै दानिएला का धैनै सुपनै सह भेद प्रगट अर दानिएलै किअ स्वर्गे महान परमेशरो शूकर।<verse eid="DAN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 2:20" />दानिएलै बोलअ इहअ,</para>
  <para style="q" vid="DAN 2:20">“परमेशर, तेरै नाओंए लोल़ी जुगै-जुगै तैणीं ज़ै-ज़ैकार हंदी रही,</para>
  <para style="q" vid="DAN 2:20">तूह आसा सोभी का बलबान अर तूह ज़ाणा सोभै गल्‍ला।<verse eid="DAN 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="DAN 2:21" />मणछे हर गल्‍ला आसा तेरै बशै,</para>
  <para style="q" vid="DAN 2:21">राज़ै लै बल दैआ तूह ई अर तिन्‍नों राज़ खतम बी करा तूह ई,</para>
  <para style="q" vid="DAN 2:21">मणछा लै अक्ल अर समझ़ दैआ तूह ई।<verse eid="DAN 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="DAN 2:22" />समझ़णैं कठण अर गुप्त भेद करा तूह ई प्रगट,</para>
  <para style="q" vid="DAN 2:22">ताखा हआ तिन्‍नां गल्‍लो बी थोघ ज़ुंण नटिप्प न्हैरै बी हआ,</para>
  <para style="q" vid="DAN 2:22">किल्हैकि ताह संघै रहा सदा प्रैश्शअ।<verse eid="DAN 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="DAN 2:23" />परमेशर, तूह आसा सह ज़हा मेरै दाद-बाब मना तै,</para>
  <para style="q" vid="DAN 2:23">हुंह करा तेरी स्तोती अर तेरअ शूकर।</para>
  <para style="q" vid="DAN 2:23">मुल्है अक्ल अर बल दैणैं आल़अ आसा तूह ई।</para>
  <para style="q" vid="DAN 2:23">ऐबै हेरअ तंऐं हाम्हां का सह भेद खोज़ी</para>
  <para style="q" vid="DAN 2:23">ज़ुंण हाम्हैं ताखा पुछ़अ त।</para>
  <para style="q" vid="DAN 2:23">तंऐं हेरअ हाम्हां का राज़ैओ सुपनअ खोज़ी।”<verse eid="DAN 2:23" /></para>
  <para style="s">दानिएलै खोज़अ सुपनअ अर तेतो फल</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />एता बाद डेऊअ दानिएल आर्योक सैनापति सेटा लै ज़हा लै नबूकदनेसर राज़ै बाबेल देशे सोभी पंडत अर जोतषी मारनैओ हुकम किअ त। दानिएलै बोलअ तेऊ का, “बाबेल देशे पंडत अर जोतषी निं मारी आथी। तूह निंऊं मुंह राज़ै सेटा लै अर हुंह खोज़ूं तेऊ का तेऊओ सुपनअ अर तेतो फल।”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />आर्योक सैनापति निंयं तेभी दानिएल राज़ै सेटा लै संघा बोलअ राज़ै लै इहअ, “माहा राज़, मुंह भेटअ यहूदा मुल्खा का इधी गलामी दी आणै दै मणछा मांझ़ै अह मणछ ज़ुण तेरअ सुपनअ अर तेतो फल खोज़ी सका।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राज़ै पुछ़अ दानिएला का ज़हा नाअं बेलतेशर थिअ डाहअ द, “तूह कै मेरअ सुपनअ अर तेतो फल खोज़ी सका?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानिएलै दैनअ ज़बाब,</para>
  <para style="p" vid="DAN 2:27">“माहा राज़अ, ज़ुंण गल्‍ल तंऐं पुछ़ी तेतो ज़बाब निं संसारे बडै का बडै पंडत अर जोतषी का बी आथी! <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पर स्वर्गै आसा परमेशर, सह खोज़ा इना सोभी गल्‍लो भेद। माहा राज़, तेऊ खोज़अ ताखा सुपनै कि आजू किज़ै च़ाल्‍लअ हई। ऐबै खोज़ूं हुंह ताखा कि तंऐं निंजा दी किज़ै सुपनअ भाल़अ। <verse eid="DAN 2:28" /><verse number="29" style="v" sid="DAN 2:29" />माहा राज़, ज़ेभै तूह आपणैं पलगा प्रैंदै सुत्तअ, तूह त इहअ सोठदअ लागअ द कि आजू किज़ै हणअ। परमेशर ज़ुंण भेद खोज़ा, तेऊ रहैऊअ ताखा कि आजू किज़ै च़ाल्‍लअ हई।<note caller="-" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="AMO 4:13">आम. 4:13</ref></char></note> <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />माहा राज़, इहअ निं आथी कि हुंह आसा सोभी मणछा का अक्ली आल़अ अर तै खोज़अ परमेशरै मुखा ऐहा गल्‍लो भेद। परमेशरै किई मुखा ईंयां गल्‍ला एते तैणीं प्रगट कि हुंह ताखा एतो फल खोज़ी सकूं अर तूह तिन्‍नां गल्‍ला समझ़े ज़ुंण तंऐं सोठअ।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />“माहा राज़अ, ताखा शुझुअ सुपनै कि ताह आजू आसा मणछे शक्ला ज़ेही एक बडी मुहुर्ती। सह मुहुर्ती ती खास्सी उछ़टी अर तेता का थिअ च़लकार लागअ द अर भाल़णा लै ती सह बेघै डरैऊंणी। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />तैहा मुहुर्तीओ मूंड थिअ च़ोखै सुन्‍नैं करै बणाअं द। तेते हिक्‍का अर बाहा ती च़ंदी करै बणाईं दी, पेटा उंधै ज़ान्हूं तैणीं थिई सह कांस्सै, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />तेते ज़ांघा ती लोहै अर तेते खूर तै धख लोहै अर धख माट्टै करै बणाऐं दै।<verse eid="DAN 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 2:34" />“तूह त तेता भाल़अ लागअ द अर एक बडी टोल्ह छ़ुटी उझै का आप्पै, सह पल़ी तैहा मुहुर्तीए खूरा प्रैंदै ज़ुंण धख लोहै अर धख माट्टै करै तै बणाऐं दै, अर तिन्‍नों हुअ तेता करै धरनीं च़ूरअ। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तेभी हुअ हेरा-हेरी लोहै, कांस्सै, च़ंदी अर सुन्‍नेंओ बी हुअ धरनीं च़ूरअ! सह हुअ ज़ेठै खहल़ा का नाज़ा पूणीं निखल़ै दै किशा ज़िहअ। सह किशो रूल़ फर्ल़ाऊअ बागरी दूर अर तिधी निं एक कणीं बी बच़ी। इहअ निं कुंण बोली ई सकदअ त कि तिधी बी थिई होर मुहुर्ती! ज़हा टोल्हा करै तैहा मुहुर्ती ढेस्सअ लागअ, तेतो बणअ एक बडअ पर्बत अर तेता करै भर्हुई सारी धरती।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“माहा राज़अ, अह ता त सुपनअ ज़ुंण तंऐं भाल़अ। ऐबै लाअ मंऐं एतो फल खोज़ी। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />माहा राज़, तूह आसा सोभी राज़ै प्रैंदै माहा राज़अ। परमेशर ज़ुंण स्वर्गै आसा बेठअ द, तेऊ दैनअ ताल्है राज़, बल अर शगती। तेऊ किअ तूह मशूर। <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />तेऊ सभाल़ै ताखा पृथूईए सोभै मणछ, बणैं-बूटै अर सरगै डैऊंदै सोभै ज़िऊंदै ज़ीब। इना सोभी प्रैंदै राज़ करना लै बल दैनअ ताल्है परमेशरै ई। माहा राज़, तूह आसा तैहा मुहुर्तीओ मूंड। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तेरै राज़ा बाद निखल़णअ दुजअ राज़, पर तेरै राज़ा ज़िहअ महान निं सह हणअ, तेता बाद एछणअ चिअ कांस्सै ज़िहअ राज़ अर सह राज़ हणअ सारी पृथूई दी। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />तेता बाद एछणअ च़ौथअ इहअ राज़ कि सह हणअ लोहै ज़िहअ पाक्‍कअ। ज़िहअ लोहअ हर गल्‍लो च़ूरअ दैआ बणाईं, तिहअ ई करनअ तेऊ राज़ा सोभिओ च़ूरअ।<verse eid="DAN 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="DAN 2:41" />“माहा राज़अ, ज़ेही तंऐं भाल़ी कि तैहा मुहुर्तीए खूर गुंठअ त खमारे माट्टै अर लोहै करै बणअ द, तिहअ ई हणअ अह च़ौथअ राज़ ज़ुदअ-ज़ुदअ बांढुअ द। ज़िहअ तंऐं भाल़अ कि खमारे तेऊ माट्टै जैंदरी थिअ लोहअ राल़अ द, अर सह माट्टअ बी थिअ लोहै ज़िहअ पाक्‍कअ। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />खूरे गुंठी भाल़ी तंऐं कि धख आसा तिंयां लोहै अर धख आसा माट्टै करै बणाईं दी, एतो मतलब आसा इहअ कि सह राज़ कई ज़ैगा ता हणअ बलबान पर कई ज़ैगा हणअ सह खास्सअ कमज़ोर। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />माहा राज़, तंऐं भाल़अ कि खमारे माट्टै जैंदरी थिअ लोहअ राल़अ द, तिहै ई रहणैं तेऊ राज़ा दी लोग आप्पू मांझ़ै बैह करी मिल़ी-ज़ुल़ी। पर ज़िहअ लोहअ अर माट्टअ एकी-दुजै संघै नांईं ज़ुल़दअ, तिहै ई निं तेऊ राज़ा दी लोग आप्पू मांझ़ै एक रही बोल़णैं।<verse eid="DAN 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="DAN 2:44" />“ज़ेऊ ज़मानै सह राज़ हणअ, तेऊ ज़मानै करनअ स्वर्गै बेठै दै परमेशरा एक इहअ राज़ खल़अ ज़ुंण कधि खतम निं हणअ। तेऊ राज़ा का निं कोह ज़ितणअ अर तेऊ राज़ा करनअ संसारै सोभिओ राज़ खतम अर सह राज़ रहणअ जुगै-जुगै तैणीं बणी।<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रका. 11:15</ref></char></note> <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />माहा राज़अ, तंऐं भाल़अ कि सह टोल्ह छ़ुटी उझै धारा का आप्पै उंधै! अर तैहा टोल्हा किअ सुन्‍नअ, च़ंदी, कांस्सै, लोहै अर माट्टैओ च़ूरअ। महान परमेशरै किई ताखा अह गल्‍ल प्रगट कि आजू किज़ै आसा हणैं आल़अ। माहा राज़, तेरअ सुपनअ आसा असली अर तेतो फल बी निभणअ आजू इहअ ई।”<verse eid="DAN 2:45" /></para>
  <para style="s">राज़ै बशैल़अ दानिएल बडी पदबी दी</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />इना गल्‍ला शूणीं पल़अ राज़अ नबूकदनेसर दानिएलो अदर करना लै धरनीं उटअ। तेऊ किअ हुकम कि दानिएला लै दैआ भैंट अर तेऊ सेटा ज़ाल़ा धूप-दपोत। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />राज़ै बोलअ दानिएला लै, “तेरअ परमेशर आसा सोभी देअआ का महान, सह आसा सोभी राज़ै प्रैंदै माहा राज़अ ज़ुंण सोभै भेद प्रगट करा। ऐबै समझ़अ हुंह कि तैही निखल़अ सिधअ तूह ई ज़ुंण मेरै सुपनै अर तेतो फल खोज़ी सकअ।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />नबूकदनेसर राज़ै दैनी दानिएला लै बडी पदबी अर तेऊ लै दैनी खास्सी किम्मती च़िज़ा बी भैंट। सह बणाअं तेऊ कई मुल्खा लै बज़ीर ज़ेथ बाबेल देशो राज़ आसा त। बाबेल देशे राज़ दरबारै सोभी बज़ीरा प्रैंदै सैणअ बी बणाअं सह ई। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />दानिएले बोलै सभाल़अ नबूकदनेसर राज़ै तेऊए साथी शदराक, मेशक अर अबेदनागू का बाबेल देशे कई मुल्खे सरकारी काम-काज़। पर दानिएल रहा त आप्पू राज़ दरबारै ई।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">नबूकदनेसरे बडी मुहुर्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />एकी धैल़ै ती नबूकदनेसर राज़ै एक सुन्‍नें बडी मुहुर्ती डाही दी बणाईं। सह मुहुर्ती ती कोई शाठ हाथ लाम्मी अर छ़ह हाथ बिरली। तेऊ ती सह मुहुर्ती बाबेल देशै दूरा नाओंए सरलै मुल्खै डाही दी खल़ी करी स्तापी। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />नबूकदनेसर राज़ै दैनअ आपणीं सोभी मुल्खे सैणैं, कार-करिंदै, राज़पाल, बज़ीर, भढारी, जज, शास्त्री अर सोभी सरकारी अफसरा लै समाद कि तिंयां सोभ लोल़ी तैहा मुहुर्तीए प्रतिष्ठा लै आऐ। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />ज़ांऊं तिंयां सोभ सैणैं, कार-करिंदै, राज़पाल, बज़ीर, भढारी, जज, शास्त्री अर सोभी सरकारी अफसर प्रतिष्ठा लै आऐ, तिंयां सोभ खल़्हुऐ नबूकदनेसर राज़ै खल़ी किई दी तैहा मुहुर्ती आजू तेतो अदर करना लै।<verse eid="DAN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 3:4" />तेखअ बोलअ ज़ेल़तै ज़ोरै-ज़ोरै इहअ, “देशा-देश, ज़ाती-ज़ाती अर ज़ुदी-ज़ुदी भाषा-बोली बोल़णैं आल़ै लोगो, तम्हां लै किअ माहा राज़ै हुकम ज़ारी कि <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />ज़ेभै तम्हां का नर्शिंगै, बींन, कतारै, सरनाई अर होर गाज़ै-बाज़ै शुण्हिंए, तम्हैं टेक्‍कै तेभै सोभ ऐहा मुहुर्ती सेटा उटै पल़ी माथअ ज़ुंण नबूकदनेसर माहा राज़ै आसा खल़ी किई दी। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />ज़ुंण बी उटै पल़ी ऐहा मुहुर्ती सेटा माथअ नांईं टेक्‍के, सह पाणअ राज़ै तेभी बडै आगीए ज़ल़दै भैठै दी।”<verse eid="DAN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7" />इहअ करै ज़िहअ ई तिन्‍नां देशा-देशे अर ज़ुदी-ज़ुदी भाषा-बोलीए लोगा का नर्शिंगै, बींन, कतारै, सरनाई अर होर गाज़ै-बाज़ै बाज़दै शुण्हिंआं तै, तिंयां करा तै धरनीं उटी बाखा माथअ टेक्‍की तैहा सुन्‍नें मुहुर्तीए स्तोती ज़ुंण नबूकदनेसर राज़ै ती स्तापी दी।<verse eid="DAN 3:7" /></para>
  <para style="s">दानिएले साथी निं राज़ैओ हुकम मनअ</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />तेखअ डेऊऐ कोऐ कसदी शास्त्री राज़ै सेटा लै संघा लागै तेऊ सेटा यहूदीए निंदा करदै, किल्हैकि तिंयां डाहा तै तिन्‍नां संघै ज़ीद। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />तिन्‍नैं बोलअ नबूकदनेसर राज़ै लै, “माहा राज़अ, तेरी अमर लोल़ी खास्सी हुई! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />पर माहा राज़अ, तंऐं किअ त इहअ हुकम ज़ारी कि ज़ेभै नर्शिंगै, बींन, कतारै, सरनाई अर होर गाज़ै-बाज़ै बाज़दै शुण्हिंए, तेभै लोल़ी सोभी ऐहा सुन्‍नें मुहुर्ती सेटा उटै पल़ी माथअ टेक्‍की एते स्तोती किई! <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />अर ज़ै कुंण उटै पल़ी ऐहा मुहुर्ती सेटा माथअ नांईं टेक्‍के, सह पाणअ राज़ै तेभी बडै आगीए ज़ल़दै भैठै दी। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />माहा राज़, यहूदी मणछा मांझ़ै आसा इधी इहै बी ज़ुंण तेरअ हुकम मंदै ई निं आथी! तंऐं आसा तिन्‍नां यहूदी का बाबेल देशे कई मुल्खो सरकारी काम तोही सभाल़अ द! ईंयां आसा शदराक, मेशक अर अबेदनागू ज़ुंणीं तेरअ हुकम नांईं मनअ। ईंयां निं तेरै देअआ मंदै अर नां इनै तैहा सुन्‍नें मुहुर्ती सेटा माथअ टेक्‍कअ ज़ुंण तंऐं आसा स्तापी दी।”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />इना गल्‍ला शूणीं आई नबूकदनेसर राज़ै खास्सी रोश्शै अर तेऊ किअ हुकम कि शदराक, मेशक अर अबेदनागू आणा मुंह सेटा लै। ज़ांऊं तिंयां राज़ै सेटा हाज़र किऐ, <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबूकदनेसर राज़ै पुछ़अ शदराक, मेशक अर अबेदनागू का, “ईंयां गल्‍ला सच्च़ी आसा कि तम्हैं निं मेरै देअआ मंदै अर नां तम्हैं तैहा सुन्‍नें मुहुर्ती सेटा माथअ टेक्‍कदै ज़ुंण मंऐं आसा स्तापी दी? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />ऐबै ज़ै तम्हैं नर्शिंगै, बींन, कतारै, सरनाई अर होर गाज़ै-बाज़ै बाज़दै शूणीं मंऐं स्तापी दी सुन्‍नें मुहुर्ती सेटा माथअ टेक्‍की स्तोती करे, तै आसा ठीक। पर ज़ै तम्हैं माथअ नांईं टेक्‍के, तै पाणै तम्हैं तैहा ई घल़ी बडै आगीए ज़ल़दै भैठै दी। तेखअ भाल़ूं हुंह कि तम्हां बच़ाऊंदअ कुंण भगबान एछणअ?”<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="2KI 18:35">2 राज़. 18:35</ref></char></note><verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />शदराक, मेशक, अबेदनागू बोलअ नबूकदनेसर राज़ै लै, “माहा राज़, ऐहा गल्‍ला लै निं हाम्हैं ताल्है किछ़ै बोल़णअ च़ाहंदै। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />माहा राज़अ, ज़हा परमेशरे च़ाकरी अर स्तोती हाम्हैं करा, सह सका हाम्हां बडै ज़ल़दै आगीए भैठै का बच़ाऊई अर ताखा बी छ़ड़ैऊई। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पर ए माहा राज़अ, ज़ै सह इहअ नांईं बी करे, तैबी लअ तूह ऐहा गल्‍ला समझ़ी कि हाम्हैं निं तेरै देअआ-देबीए पूज़ा करदै, नां हाम्हां ऐहा सुन्‍नें मुहुर्ती सेटा माथअ टेक्‍कणअ ज़ुंण तंऐं आसा स्तापी दी।”<verse eid="DAN 3:18" /></para>
  <para style="s">दानिएले साथी पाऐ आगीए भैठै दी</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />इना गल्‍ला शूणीं आई नबूकदनेसर राज़ै खास्सी रोश्शै, तेऊ काढै शदराक, मेशक अर अबेदनागू लै बडै-बडै टैंडै। संघा किअ तेऊ हुकम कि एऊ बडै आगीए भैठै ज़ाल़ा इहै कि एथ लोल़ी एता का सात गुणा खास्सी आग भकी। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />तेखअ किअ तेऊ आपणीं सैना मांझ़ै सोभी का जोधै लै हुकम कि शदराक, मेशक अर अबेदनागू पाआ इने हाथ-खूर बान्हीं करै बडै आगीए ज़ल़दै भैठै दी। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तिन्‍नैं बान्हैं तिंयां च़ोल़ै, सदरी टोप सुथणीं अर तिन्‍नैं बान्हैं दै सोभी झिकल़ै संघी, संघा शोटै तेऊ बडै ज़ल़दै भैठै दी। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />नबूकदनेसर राज़ै त काठअ हुकम ज़ारी किअ द अर भैठै दी थिई खास्सी आग भकी दी अर तेता का थिऐ उझै तैणीं आगीए लुपल़ै लागै दै। ज़ुंण सपाही शदराक, मेशक, अबेदनागू च़की करै आगीए तेऊ भैठै दी शोटै; तिंयां मूंऐं भैठै का निखल़ै दै आगीए लुपल़ै करै बागै ई। <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />शदराक, मेशक, अबेदनागू तै भैठै दी घणीं आगी जैंदरी शोटी हेरै दै अर तिंयां तै सारी घेरी का पिड्डै बान्हैं दै।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />राज़अ नबूकदनेसर त तिन्‍नां भाल़अ लागअ द कि तिंयां आगी जैंदरी किहै दझ़णैं, पर सह हुअ तेता भाल़ी रहैन अर तेऊ बुल़्हअ गाद्दी प्रैंदा का उझै त्रुपल़अ संघा हुअ खल़अ। तेऊ पुछ़अ आपणैं बज़ीरा का, “हाम्हैं पाऐ तै तिंयां ई चअन ज़ण्हैं बान्हीं करै आगी जैंदरी भाल़ी?”</para>
  <para style="p" vid="DAN 3:24">तिन्‍नैं दैनअ ज़बाब, “हाँ माहा राज़अ, तिंयां ई चअन पाऐ एथ।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />राज़ै बोलअ, “तै मुखा किल्है शुझिआ इहअ कि आगीए बडै कूंडा जैंदरी आसा च़ार मणछ हांढदै लागै दै? नां ईंयां बान्हैं दै शुझदै अर नां इना आगी करै किछ़ हान्‍नी हुई! अह च़ौथअ मणछ शुझिआ मुखा स्वर्ग दूता ज़िहअ<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="fq" closed="false">स्वर्ग दूता ज़िहअ </char><char style="ft" closed="false">ज़िहअ कि सह आसा परमेशरो शोहरू</char></note>!”<verse eid="DAN 3:25" /></para>
  <para style="s">नबूकदनेसर राज़ै किऐ चिहै ज़ण्हैं आज़ाद</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />तेखअ डेऊअ नबूकदनेसर राज़अ तेऊ ज़ल़दै भैठै नेल़ मोहरै दी संघा लाई ज़ोरै हाक्‍का, “शदराक! मेशक! अबेदनागू! बागा लै एछा! परम प्रधान परमेशरे दासो! आगी जैंदरा का एछा बागै!”</para>
  <para style="p" vid="DAN 3:26">तिंयां निखल़ै चिहै ज़ण्हैं राज़ेए हाक्‍का शूणीं तेभी बागै। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />सैणैं, कार-करिंदै, राज़पाल, बज़ीर, भढारी, जज, शास्त्री अर राज़ेए सोभ सरकारी अफसर झाल़्हुऐ तिन्‍नां चिई ज़ण्हैं भाल़ै ज़हा ज़ल़दै भैठै दी आगी जैंदरी किछ़ हान्‍नी निं हुई। तिन्‍नें निं देहीओ एक शराल़ बी झल़ुशुअ! नां तिन्‍नें झिकल़ै दझ़ै अर तिन्‍नां दी निं आगी जैंदरा का निखल़ी धूँए बास्स बी आथी ती लागी दी।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />नबूकदनेसर राज़ै बोलअ, “ज़ुंण शदराक, मेशक अर अबेदनागूओ परमेशर आसा, हुंह करा तेऊए ज़ै-ज़ैकार। तेऊ छ़ाडै आपणैं स्वर्ग दूत इना मणछा बच़ाऊंदै ज़ुंण तेऊए च़ाकरी करा अर तेऊ परमेशरे आसरै रहा। इनै निं तेऊ परमेशरा लै मेरअ हुकम मनअ अर होरी देअआ-देबीए पूज़ा करनै का समझ़अ इनै आप्पू मरनअ ई खरअ।<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />“ऐबै करा हुंह इहअ हुकम ज़ारी कि देशा-देशे अर हर भाषा-बोली बोल़णैं आल़ै लोग ज़ुंण शदराक, मेशक, अबेदनागूए परमेशरे खलाफ किज़ै बोले, तेऊए करनै मुंह काटी करै ठोर-ठोर। तिन्‍नें घअर पाणै ढोल़ी कि तेथ रहणअ सिधअ माट्टै-गट्टैओ रूल़। किल्हैकि इने परमेशरा ज़िहअ निं कुंण देअ नां देबतअ आथी ज़ुंण इहअ बच़ाऊई सका।”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />नबूकदनेसर राज़ै किई शदराक, मेशक अर अबेदनागूए खास्सी इज़त अर तेऊ बशैल़ै तिंयां बाबेल देशे मुल्खै बडी-बडी पदबी दी।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबूकदनेसर राज़ै हुअ एक होर सुपनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबूकदनेसर राज़ै दैनअ देश-देश, ज़ाती-ज़ाती अर संसारे सोभी भाषा-बोली बोल़णैं आल़ै लै इहअ समाद,</para>
  <para style="p" vid="DAN 4:1">“तम्हैं लोल़ी राज्ज़ी-राम्बल़ै रहै अर सदा खुश रहै।<verse eid="DAN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 4:2" />“हुंह आसा खुश हुअ द कि मंऐं लाई तम्हां का तेऊ महान परमेशरे बारै गल्‍ला खोज़ी ज़ुंण सोभी गल्‍ला प्रैंदै राज़ करा। तेऊ किऐ मुल्है महान काम अर बडै-बडै च़मत्कार।<verse eid="DAN 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="DAN 4:3" />परमेशरे च़मत्कारा भाल़ी लागा थोघ कि</para>
  <para style="q" vid="DAN 4:3">तेऊ का केही महान शगती आसा!</para>
  <para style="q" vid="DAN 4:3">तेऊओ राज़ रहणअ सदा अर</para>
  <para style="q" vid="DAN 4:3">सह रहणअ पोस्ती दर पोस्ती राज़अ।<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />“हुंह नबूकदनेसर त आपणैं राज़ मैहला दी राज्ज़ी-खुशी अर मेरै ती सोभी गल्‍ला लै मौज़। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />पर मुंह हुअ एकी राची एक सुपनअ अर तेता करै डरअ हुंह खास्सअ। तेते बारै सोठी-सोठी निं मुंह पलगा प्रैंदै नींज ई एछदी ती। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />मंऐं किअ हुकम संघा शादै मंऐं बाबेल देशे सोभ दरबारी अर बज़ीर आप्पू सेटा लै कि तिंयां मुखा मेरै सुपनैओ फल खोज़े। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />तेखअ आणै कसदी मांझ़ै सोभ जोतषी, शास्त्री अर पंडत मुंह सेटा मेरै मैहलै। मंऐं खोज़अ तिन्‍नां का आपणैं सुपने बारै पर तिंयां निं तेते बारै मुखा किछ़ खोज़ी सकै। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />खिरी आअ दानिएल नाओं यहूदी मणछ मुंह सेटा लै, मंऐं बोलअ तेऊ लै बेलतेशर ज़िहअ मेरै कुल़ज देअआ नाअं आसा। तेऊ मणछा दी आसा पबित्र परमेशरे आत्मां। तेऊ का बी बोलअ मंऐं तिहअ ई कि मुंह हुअ एक सुपनअ।<verse eid="DAN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 4:9" />“मंऐं बोलअ तेऊ लै, ‘बेलतेशर, तूह आसा तेरै सोभी जोतषी अर पंडता प्रैंदै सैणअ। मुखा आसा थोघ कि पबित्र परमेशरे आत्मां आसा ताह दी अर तूह सका सोभै भेद समझ़ी। मंऐं भाल़अ एक सुपनअ, तूह खोज़ तेतो किज़ै फल हणअ।<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />“‘हुंह त आपणैं पलगा प्रैंदै सुत्तअ द, मुखा शुझुअ सुपनै कि पृथूई दी आसा मांझ़ा-मांझ़ी एक बडअ बूट अर सह त उझै खास्सअ लाम्मअ। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />सह बूट रहअ उझै सरगै तैणीं बझ़दअ ई लागी अर खास्सअ मोट्टअ हंदअ लागी। तेऊ बूटा सका तै संसारे सोभी ज़ैगा का भाल़ी। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />तेऊ बूटे पाच तै बेघै बित्तै अर तेथ थिऐ एतरै खास्सै फल़ लागै दै कि संसारे सोभ ज़ीब सका तै तेता फल़ खाई करै रज्ज़ी। बणें सोभ ज़ीब तै तेते छ़ैल्‍ली दी बस्सै दै अर तेते शाण्हीं दी थिऐ च़ेल्‍लू-पखीरू कोल्ह बणाऐं दै अर सोभी ज़िऊंदै ज़ीब खाआ तै तेऊ बूटे फल़।<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 13:32">मोत्त. 13:32</ref></char></note><verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />“‘हुंह त पलगा प्रैंदै सुत्तअ ई द अर एऊ सुपने बारै सोठदअ लागअ द कि मुखा शुझुअ धैनै-सुपनै इहअ कि स्वर्गा का होथअ एक स्वर्ग दूत उंधै। <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />सह त ज़ोरै-ज़ोरै इहअ बोल्दअ लागअ द कि एऊ बूटा पाआ ढोल़ी, एते शाण्हीं एते सोभ शाण्हीं छ़ांबा पठी, एते पाच झ़णाटा धरनीं अर एते फल़ छिंगा ओर्ही-पोर्ही। एते शाण्हीं दी बस्सै दै च़ेल्‍लू-पखीरू अर एता हेठै सोभी ज़ीबा दरल़ाऊआ दूर। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />एते घेर अर ज़लैल़ै दैऐ धरनीं रहणैं, तेता डाहै लोहै अर पितल़े शांघल़ी करै बान्हीं अर धरनीं घाह जैंदरी शोटी।</para>
  <para style="p" vid="DAN 4:15">“‘अह लोल़ी सरगा का पल़ी दी ओशा करै भिज़अ। सह लोल़ी बणें ज़ीबा ज़िहअ घाहा च़रदअ रहअ लागी। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />तेऊ निं मणछा ज़िहअ सोठणअ ई, तेऊओ दमाग हणअ बणें ज़ीबा ज़िहअ। साता साला तैणीं रहणीं तेऊए एही ई दशा। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />अह थिअ पबित्र स्वर्ग दूतो हुकम ज़ुंण पृथूईओ पहरी आसा। ऐहा गल्‍लो लोल़ी सोभी का थोघ लागअ कि मणछे सोभी राज़ा प्रैंदै करा सह महान परमेशर राज़ ज़हा का सारअ बल आसा। सह दैआ तेऊ लै राज़ करनैओ हक ज़हा सह आप्पै छ़ांटा। ज़हा लोग किछ़ बी निं समझ़दै, तेऊ तोही बणाआं सह राज़अ।’<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />“हुंह नबूकदनेसर लागअ तेखअ बोल्दअ, ‘बेलतेशर, इहअ-इहअ शुझुअ मुखा सुपनै! ऐबै खोज़ तूह मुखा कि एऊ सुपनैओ किज़ै फल आसा। मेरै राज़ दरबारे सलाहकारा मांझ़ै निं एक बी एतो फल खोज़ी सकअ। पर तूह सका एतो फल खोज़ी किल्हैकि पबित्र परमेशरे आत्मां आसा ताह दी।’<verse eid="DAN 4:18" /></para>
  <para style="s">दानिएलै खोज़अ सुपनैओ फल</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />“दानिएल, ज़हा नाअं बेलतेशर बी आसा, सह रहअ इना गल्‍ला शूणीं थोल़ी घल़ी नड़क्‍क खल़्हुई। सह लागअ दिलै कई गल्‍ला सोठदअ अर तेता करै पल़अ तेऊए मन्‍नैं खास्सअ झाख। तेखअ बोलअ मंऐं तेऊ लै, ‘बेलतेशर, तूह निं एऊ सुपनै अर एतो फल समझ़ी करै डरी आथी।’</para>
  <para style="p" vid="DAN 4:19">“बेलतेशरै बोलअ, ‘माहा राज़अ, मेरै मालक! हुंह च़ाहा त इहअ कि अह सुपनअ अर एतो फल लोल़ी तेरै दुशमणा लै हुअ! अह नांई त ताल्है लोल़ी हुअ! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />ज़ुंण ताखा सुपनै सरगै तैणीं उछ़टअ बूट शुझुअ, ज़ेता लोग संसारे सोभी ज़ैगा का भाल़ी सका, <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />ज़ेते पाच बेघै बित्तै आसा अर ज़ेथ एतरै फल़ आसा कि तेता करै सका संसारे सोभ ज़ीब रज्ज़ी, ज़ेते शाण्हीं दी च़ेल्‍लू-पखीरू कोल्ह बणाईं आसा बस्सै दै अर धरनीं ज़ेते छ़ैल्‍ली दी बणें सोभ ज़ीब आसा बस्सै दै, <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />माहा राज़अ, सह लाम्मअ बूट आसा तूह। तेरअ बल बझ़अ उझै सरगै तैणीं अर तूह करा धरती दी हर ज़ैगा राज़।<verse eid="DAN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 4:23" />“‘माहा राज़, ज़ुंण तंऐं सुपनै स्वर्गा का स्वर्ग दूत उंधै एछदअ अर इहअ बोल्दअ शूणअ, “एऊ बूटा पाआ ढोल़ी, एते शाण्हीं एते सोभ शाण्हीं छ़ांबा पठी, एते पाच झ़णाटा धरनीं अर एते फल़ छिंगा ओर्ही-पोर्ही। एते घेर अर ज़लैल़ै दैऐ धरनीं रहणैं, तेता डाहै लोहै अर पितल़े शांघल़ी करै बान्हीं अर धरनीं घाह जैंदरी शोटी। अह लोल़ी सरगा का पल़ी दी ओशा करै भिज़अ। सह लोल़ी बणें ज़ीबा ज़िहअ घाहा च़रदअ रहअ लागी। साता साला तैणीं रहणीं तेऊए एही ई दशा।”<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />“‘माहा राज़, एतो मतलब आसा इहअ कि परम परमेशर ज़ुंण सोभी प्रैंदै माहा राज़अ आसा, अह आसा तेऊओ हुकम, सह च़ाहा इहअ कि आजू लोल़ी ताल्है ईंयां गल्‍ला निभी। <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />तूह काढणअ मणछे राज़-समाज़ा का दूर अर ताह लागणअ बणें ज़ीबा संघै रहणअ। ताह लागणअ बल्दा ज़िहअ घाह च़रनअ अर तूह भिज़णअ सरगा का पल़ी दी ओशा करै। साता साला तैणीं रहणीं तेरी एही ई दशा। तेखअ लागणअ ताखा थोघ कि परम प्रधान परमेशर ज़ुंण सोभी का बडअ आसा, सह ई दैआ मणछा राज़ करनै, ज़हा सह छ़ांटा, सह दैआ तेऊ लै राज़। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />पर ज़ुंण तेऊ स्वर्ग दूतै तेऊ बूटे घेर ज़लैल़ै संघी धरनीं घाहा जैंदरी शोटी डाहणां लै बोलअ, तेतो मतलब आसा इहअ कि ज़ेभै ताह समझ़ एछी जाए कि स्वर्गै बेठअ द परमेशर ई करा मणछा प्रैंदै राज़, तेभै जाणअ ताह आपणअ राज़ बापस भेटी। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />माहा राज़, मेरी आसा ताखा अरज़ कि तूह मन मेरी अह सलाह कि तूह हट पाप करनै का पिछ़ू, भलअ कर अर रैनै-गरीबा लै कर झींण। हई सका कि तूह खास्सै धैल़ै तैणीं राज्ज़ी-मौज़ी रहे।’<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />“ईंयां सोभै गल्‍ला निभी मुंह नबूकदनेसर राज़ै लै पठी ज़ाथी एही ई। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />इना गल्‍ला हणें एकी साला बाद त हुंह बाबेल देशै आपणैं राज़ मैहलै च़ाऊल़ी हांढदअ लागअ द। <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />हुंह लागअ सोठदअ, ‘अह बाबेल नगरी आसा महान! एता बणाणां लै आसा मंऐं आप्पै बडी मैन्थ किई दी, ताकि अह मेरी राज़धानी होए अर एता करै सारै दी मेरी मशूरी होए!’<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />“ज़ेतरी हुंह इहअ सोठी निं मुक्‍कअ, मुखा शुण्हुंअ इहअ कि स्वर्गा का आसा कुंण हाक्‍का लांदअ लागअ द, ‘नबूकदनेसर, राज़ैआ, हुंह आसा ताल्है ई लागअ द बोल्दअ, अह राज़ किअ ऐबै ताखा दूर। <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />तूह काढणअ मणछे राज़-समाज़ा का दूर, ताह लागणअ बणें ज़ीबा जैंदरी रहणअ। ताह लागणअ बल्दा ज़िहअ घाह च़रनअ। साता साला तैणीं रहणीं तेरी एही ई दशा। तेखअ लागणअ ताखा थोघ कि परम प्रधान परमेशर ई करा मणछा प्रैंदै राज़। ज़हा सह छ़ांटा, सह दैआ तेऊ लै राज़।’<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />“ईंयां गल्‍ला निभी मुल्है हेरा-हेरी ज़ेही बोली ती तेही ई। हुंह नबूकदनेसर दरल़ाऊअ मणछा जैंदरी राज़-समाज़ा का दूर। हुंह रहअ बणैं बल्दा ज़िहअ घाहा च़रदअ लागी। हुंह भिज़अ सरगा का पल़ी दी ओशा करै। मेरै शराल़ बझ़ै गरलीए फैंखा ज़िहै अर मेरै न्हश हुऐ च़ेल्‍लू-पखीरूए थूंज़ा ज़िहै।<verse eid="DAN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />“ज़ांऊं तिंयां सात साला निभी, तेखअ किई मंऐं नबूकदनेसर राज़ै खिरी स्वर्गा बाखा भाल़ी परमेशरा सेटा अरज़। तेखअ हुअ मेरअ दमाग नरोगअ। मंऐं किअ इहअ बोली परमेशरो शूकर:</para>
  <para style="q" vid="DAN 4:34">‘हुंह करा सोभी का बडै परमेशरो शूकर, ज़ुंण सदा ज़िऊंदअ आसा।</para>
  <para style="q" vid="DAN 4:34">तेऊओ राज़ निं कधि खतम हणअ अर</para>
  <para style="q" vid="DAN 4:34">तेऊ करनअ पोस्ती दर पोस्ती राज़।<note caller="-" style="x"><char style="xo" closed="false">4:34 </char><char style="xt" closed="false"><ref loc="PSA 145:13">भज. 145:13</ref>; <ref loc="1TI 1:17">1 तिम. 1:17</ref> </char></note><verse eid="DAN 4:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="DAN 4:35" />संसारे सोभ लोग निं तेऊ लै किछ़ बी आथी!</para>
  <para style="q" vid="DAN 4:35">ज़िहअ तेऊओ दिल बोलअ, सह करा स्वर्गे सैना जैंदरी तिहअ,</para>
  <para style="q" vid="DAN 4:35">धरती दी मणछा जैंदरी बी करा सह ज़िहअ सह च़ाहा तिहअ।</para>
  <para style="q" vid="DAN 4:35">तेऊ निं कोहै रोक्‍की सकदअ अर नां तेऊ कुंण पुछ़ी सकदअ,</para>
  <para style="q" vid="DAN 4:35">“तंऐं इहअ किल्है किअ?”’<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />“तेखअ आई मुंह तेभी सोर-समझ़ अर हुंह हुअ नरोगअ। तेखअ बणअ हुंह महान राज़ा दी भिई राज़अ। मेरै बज़ीर अर कार-करिंदै बी आऐ मुंह सेटा लै बापस फिरी। अर मेरअ राज़ अर बल हुअ पैहलै का बी खास्सअ। <verse eid="DAN 4:36" /><verse number="37" style="v" sid="DAN 4:37" />तैही करा ऐबै हुंह नबूकदनेसर राज़अ स्वर्गे महान परमेशरे ज़ै-ज़ैकार। सह करा सदा भलअ अर नसाफ। ज़ेभै मणछा घमंड एछा, सह जुंघा तिन्‍नां उंधै ताकि तिंयां निऊंऐं फिरे।”<note caller="-" style="x"><char style="xo" closed="false">4:37 </char><char style="xt" closed="false"><ref loc="DEU 32:4">बधा. 32:4</ref></char></note><verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलशेसर राज़ै दैनी धाम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />ज़ांऊं बेलशेसर बाबेल देशो राज़अ बणअ, तेऊ दैनी आपणैं एक हज़ार कार-करिंदै लै बडी धाम आप्पू बी झुटी तेऊ तिन्‍नां संघै शराब। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />ज़ांऊं तेऊ खास्सी शराब झुटी, तेऊ किअ आपणैं दासा लै हुकम कि तिन्‍नां सुन्‍नें किम्मती कऊली अर गलासा आणा ज़ुंण तेऊए बाब नबूकदनेसर राज़ै एरुशलेम नगरी बिधाते भबना का थिऐ लुटी आणै दै।<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="2KI 25:15">2 राज़. 25:15</ref></char></note> राज़अ बेलशेसर च़ाहा त तेऊए खास कार-करिंदै अर सह आप्पू आपणीं सोभी राणीं अर डाही दी बेटल़ी संघी तिन्‍नां भांडै दी शराब झुटणअ।<verse eid="DAN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 5:3" />दासै किअ ज़िहअ राज़ै हुकम किअ तिहअ ई। ज़ुंण सुन्‍नैं-च़ंदीए भांडै एरुशलेम बिधाते भबना का लुटी तै आणै दै, तिंयां आणै तिन्‍नैं बेलशेसर राज़ै सेटा। तेखअ झुटी राज़ै, तेऊए खास कार-करिंदै अर तेऊए सोभी राणीं अर डाही दी बेटल़ी तिन्‍नां भांडै दी शराब। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />शराब झुटी लागै तिंयां आपणैं देअआ-देबीए ज़ै-ज़ैकार करदै ज़ुंण सुन्‍नैं, च़ंदी, पितल़, लोहै, काठा अर पात्थरे थिऐ बणाऐं दै।<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">भज. 135:15-18</ref></char></note><verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />तिधी शुझुअ नच़ानक राज़ै का मणछे हाथा ज़िहअ। सह हाथ लागअ गुंठी करै सदीऐ पिछ़ू च़ुन्‍नैं लाई दी भित्ती दी लिखदअ अर राज़अ लागअ तेता भाल़अ। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />एता भाल़ी फिरअ राज़ैओ मुंह शेफल़अ अर तेऊ छ़ुटी डरै हाथै-खूरै एही काम्मणीं कि तेऊए ज़ान्हूं लागै जल़ाखदै।<verse eid="DAN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 5:7" />राज़ै पाई तेभी आपणैं दासा लै हाक संघा किअ हुकम कि जोतषी, कसदी पंडत अर मणशाण झ़ैऊंणै आल़ै आणा मुंह सेटा लै शादी। ज़ांऊं तिंयां राज़ै सेटा हाज़र किऐ, तेऊ पुछ़अ तिन्‍नां का, “ज़ुंण अह भित्ती दी लिखअ द पहल़े अर तेतो मतलब बी मुखा खोज़े, तेऊ लै बन्हैऊंणैं मुंह तिंयां किम्मती झिकल़ै ज़ुंण राज़अ बान्हां, गल़ै पाणीं तेऊए सुन्‍नें कंठी अर तेऊ लै दैणीं मुंह आपणैं राज़ा दी बाबेल देशै चिऊथी सोभी का बडी पदबी।”<verse eid="DAN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 5:8" />राज़ै बेलशेसरे सोभ कार-करिंदै आऐ तेऊ सेटा लै, पर तिंयां निं भित्ती दी लिखअ द पहल़ी सकै, नां तेतो मतलब खोज़ी सकै। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तेखअ डरअ राज़अ बेलशेसर होर बी खास्सअ अर तेऊओ मुंह फिरअ होर बी शेफल़अ। तेऊए कार-करिंदै निस्सी समझ़ ई पल़ी कि ऐबै किज़ै करनअ!<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राज़ माता शूणैं राज़अ अर कार-करिंदै गल्‍ला करदै अर तेता शूणीं आई सह भितरा लै संघा बोलअ आपणैं शोहरू बेलशेसर राज़ै लै,</para>
  <para style="p" vid="DAN 5:10">“राज़अ, तेरी लोल़ी लाम्मी अमर हुई! तूह निं डरै आथी नां इना गल्‍ला पिछ़ू आपणअ मुंह शेऊई। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तेरै देशै आसा एक इहअ मणछ ज़हा दी परमेशरे आत्मां आसा। तेरै बाब नबूकदनेसरे राज़ा दी हुई ती एही ई गल्‍ला, तेता करै लागअ त थोघ कि सह आसा खास्सअ ज़ाणकार अर तेऊ आसा देअआ ज़ेही अक्ल अर समझ़। तेरै बाब राज़ै नबूकदनेसरै बणाअं त सह सोभी जोतषी, कसदी पंडता प्रैंदै बडअ बज़ीर। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />तेऊ नाअं आसा दानिएल पर राज़ै त तेऊ नाअं बेलतेशर डाहअ द। सह आसा खास्सअ अक्ली आल़अ अर खास्सी गल्‍लो ज़ाणकार। सह सका सुपनैओ फल बी खोज़ी, सह भुझ़ा हर गल्‍ला अर सह सका हर परशैनी का बागै काढी। तूह छ़ाड कहा, संघा आण दानिएला इधा लै शादी। तेऊ हेरनअ ताखा खोज़ी कि अह भित्ती दी किज़ै आसा लिखअ द।”<verse eid="DAN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />ज़ांऊं दानिएल राज़ै सेटा हाज़र किअ, राज़ै पुछ़अ तेऊ का,</para>
  <para style="p" vid="DAN 5:13">“तूह सह ई मणछ आसा ज़ुंण मेरै बाबै यहूदा मुल्खा का इधा लै कैद करी आसा आणअ द? ताह नाअं दानिएल आसा? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मंऐं शूणीं एही गल्‍ला कि ताह दी आसा परमेशरे आत्मां अर तूह आसा अक्ली आल़अ अर खास्सी गल्‍ला ज़ाणनै आल़अ। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />मंऐं शादै आपणैं देशे जोतषी अर पंडत आपणैं राज़ मैहला लै कि तिंयां खोज़े कि भित्ती दी किज़ै आसा लिखअ द अर तेतो किज़ै मतलब आसा? पर तिन्‍नां मांझ़ै निं कोह निखल़अ ज़ुंण एता खोज़ी सके! <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />मंऐं शूणअ इहअ कि तूह खोज़ा सुपनैओ फल अर तूह भुझ़ा हर गल्‍ला अर तूह सका हर परशैनी का बागै काढी। ज़ै तूह खोज़े कि अह भित्ती दी किज़ै आसा लिखअ द, संघा एतो मतलब बी खोज़े, ताल्है बन्हैऊंणैं मुंह तिंयां किम्मती झिकल़ै ज़ुंण राज़अ बान्हां। गल़ै पाणीं तेरै सुन्‍नें कंठी अर ताल्है दैणीं मुंह आपणैं राज़ा दी चिऊथी सोभी का बडी पदबी।”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />दानिएलै दैनअ ज़बाब,</para>
  <para style="p" vid="DAN 5:17">माहा राज़अ, मुंह हेरनअ ताखा खोज़ी कि अह भित्ती दी किज़ै आसा लिखअ द अर एतो मतलब बी समझ़ाऊं हुंह ताखा। पर ज़ुंण तूह मुल्है भैंट दैणी च़ाहा, तैहा डाहै आप्पू का अर तेता दैऐ कहा होरी लै। <verse eid="DAN 5:17" /><verse number="18" style="v" sid="DAN 5:18" />माहा राज़अ, परमेशर ज़ुंण सोभी का बडअ आसा, तेऊ बणाअं तेरअ बाब नबूकदनेसर बलबान राज़अ, सह किअ तेऊ सारै दी मशूर अर लोग करा तै तेऊओ अदर कि सह त महान राज़अ। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />परमेशरै बणाअं सह एतरअ महान एते तैणीं कि देशा-देशे लोग, ज़ुदी-ज़ुदी भाषा-बोली बोल़णैं आल़ै लोग डरा तै तेऊ का खास्सै। तेरअ बाब ज़हा मारनअ च़ाहा त, तेऊ पाआ त सह मारी, ज़हा सह ज़िऊंदअ डाहणअ च़ाहे, तेऊ डाहा त सह ज़िऊंदै। ज़हा लै तेऊओ दिल बोलअ, तेऊ बशैल़ा त सह बडी पदबी दी अर ज़हा लै तेऊओ दिल बोला थिअ, तेऊ काढा त सह पदबी का पोर्ही।<verse eid="DAN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 5:20" />“ज़ांऊं सह खास्सअ काठअ अर आपणैं बलबान अर महान हणैंओ खास्सअ घमंड हुअ, परमेशरै किई तेऊए शोभा-शान अर तेऊओ राज़ तेऊ का दूर।<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 16:15">सैणीं. 16:15</ref></char></note> <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />सह काढअ मणछे राज़-समाज़ा का दूर अर तेऊओ दमाग हुअ पशू ज़िहअ। सह लागअ बणें गाधै ज़िहअ ज़ीबा संघै रहंदअ अर बल्दा ज़िहअ घाहा च़रदअ। तेऊए देही भिज़ा ती सरगा का पल़ी दी ओशा करै। तेखअ ज़ाण्हुंअ तेऊ का बी कि परमेशर ज़ुंण सोभी का बडअ आसा, सह करा मणछे सोभी राज़ा प्रैंदै राज़। ज़हा सह आप्पै छ़ांटा, तेऊ बणाआं सह राज़अ।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“पर माहा राज़अ बेलशेसर, तूह आसा तेऊओ शोहरू अर ताखा आसा इना सोभी गल्‍लो थोघ। तंऐं निं अज़ी बी आपणअ घमंड छ़ाडअ। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />तूह सोठा इहअ कि तूह आसा तेऊ मालका का महान ज़ुंण स्वर्गै आसा बेठअ द! तंऐं बझ़ैल़ै बिधाते भबने पबित्र भांडै आप्पू सेटा पेश करनै। तंऐं, तेरी सोभी राणीं अर तेरै खास कार-करिंदै झुटी तिन्‍नां भांडै करै शराब! तेखअ फिरै तम्हैं आपणैं तिन्‍नां देअआ-देबीए ज़ै-ज़ैकार करदै ज़ुंण सुन्‍नैं-च़ंदी, पितल़, लोहै काठ अर पात्थरे आसा बणाऐं दै! ज़ुंण मुहुर्ती नां भाल़ी सकदी, नां शूणीं सकदी अर किज़ै समझ़ी सकदी! बेलशेसर! ज़हा परमेशरे हाथै तेरअ शाह आसा, ज़सरै बशै तेरी ज़िन्दगी आसा, तंऐं निं तेऊओ धख बी अदर किअ।<note caller="-" style="x"><char style="xo" closed="false">5:23 </char><char style="xt" closed="false"><ref loc="JOB 12:10">आयू. 12:10</ref>; <ref loc="PSA 115:4-8">भज. 115:4-8</ref></char></note> <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />तैही छ़ाडअ तेऊ हाथ कि सह भित्ती दी ताल्है एऊ समादा लिखे।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“भित्ती दी आसा लिखअ द, ‘मेने, मेने, तकेल अर पर्सीन।’ <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />एतो मतलब आसा, ‘मेने’ मतलब गणी डाहै दै। परमेशरै आसा तेरै राज़ करने धैल़ै गणी डाहै दै अर ऐबै गऐ ईंयां धैल़ै मुक्‍की अर तेरअ राज़ हणअ खतम। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />‘तकेल’ मतलब तोली डाहअ द। परमेशरै तोलअ तूह! पर तराकल़ी दी निखल़अ तेरअ बज़न बेघै हल़कअ। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />‘पर्सीन’ मतलब बांडी डाहअ द। परमेशरै बांडअ तेरअ राज़ दूई बाखा लै ज़ुदअ-ज़ुदअ। आधअ राज़ दैनअ तेऊ मादी लोगा लै अर आधअ दैनअ फारसी लोगा लै।”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />इहअ शूणीं किअ बेलशेसर राज़ै हुकम कि दानिएला लै बन्हैऊंआं तिहै किम्मती झिकल़ै ज़ुंण राज़अ बान्हां, एऊए गल़ै पाआ सुन्‍नें कंठी। ज़िहअ राज़ै हुकम किअ तिन्‍नैं किअ तिहअ ई। बाबेल सारै देशै किअ हुकम ज़ारी कि दानिएल का आसा देशा प्रैंदै राज़ करना लै चिऊथी बडी पदबी।<verse eid="DAN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 5:30" />तैहा ई राची पाअ कसदीओ<note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="fq" closed="false">कसदीओ </char><char style="ft" closed="false">बाबेल देशो</char></note> राज़अ बेलशेसर मारी। <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />तेखअ बेठअ मादी लोगा मांझ़ै दारा बाबेल देशे राज़गाद्दी दी। तेऊए अमर ती कोई बाहठा साले।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानिएल जुहल़ी दी सिहा जैंदरी</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />कई साला बाद बांडअ माहा राज़ै दारा आपणअ राज़ एक शौ बिह मुल्खा दी अर तिन्‍नां सोभी मुल्खा प्रैंदै राज़ करदै डाहै आपणैं राज़पाल। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />इना एक शौ बिह मुल्खा लै डाहै राज़ै चअन बज़ीर कि तिंयां एक शौ बिह राज़पाले सरकारी कामों धैन खैल डाहे। इना चिई मांझ़ै त एक दानिएल बी। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />दानिएलो काम-काज़ त होरी राज़पाल अर बज़ीरा का खास्सअ बधिया। तेखअ बणाअं राज़ै दारा सह सोभी कार-करिंदै प्रैंदै प्रधान बज़ीर कि सह तेऊए राज़ो सारअ काम-काज़ सभाल़े।<verse eid="DAN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 6:4" />होर कार-करिंदै अर अफसर हआ तै दानिएले सरकारी कामां लै गलती लोल़ै लागै दै, पर तिंयां निं तेऊ लै धख ज़ेही गलती करनैओ दोश बी लाई सकै। किल्हैकि सह त शुचअ-पाक्‍कअ अर मानदार। सह करा त हर काम ज़िहअ बोलअ ठीक तिहअ ई। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />खिरी लागै सोभ कार-करिंदै आप्पू मांझ़ै गल्‍ला करदै, “हाम्हैं निं दानिएले सरकारी कामां लै किछ़ गलती काढी सकदै। ऐबै हुई हाम्हां तेऊ लै किज़ै एही गलती लाणीं कि ज़ुंण एऊए परमेशरो बधान मनणे बारै होए।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />तिंयां डेऊऐ सोभै ज़ण्हैं राज़ै दारा सेटा लै संघा बोलअ इहअ, “माहा राज़अ, तेरी लोल़ी लाम्मी अमर हुई! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />माहा राज़अ, सोभ कार-करिंदै, सैणैं, बज़ीर अर हर मुल्खे राज़पाले आसा ताल्है एही सलाह कि तूह कर इहअ हुकम ज़ारी ज़ुंण तिहा धैल़ी तैणीं ताह सुआई कहा होरी देअआ सेटा अरज़ करे, सह पाणअ सिहे जुहल़ी दी। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />माहा राज़अ, तूह कर हुकम ज़ारी, एता डाह तूह मादी अर फारसी बधाना दी आपणैं दसकत करी लिखी। इहअ करै हणअ अह बधान सदा लै अर तेखअ निं तेता कोह बदल़ी अर रद्द करी सकदअ।”<verse eid="DAN 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 6:9" />राज़ै दारा किअ सह हुकम आपणैं दसकत करी ज़ारी।<verse eid="DAN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 6:10" />इना गल्‍ले बारै हेरअ कुंणी दानिएला का खोज़ी कि राज़ै किअ नऊंअ हुकम ज़ारी अर तेथ हेरै राज़ै दारा दसकत करी। सह डेऊअ तेखअ आपणैं घअरा लै। तेऊए घअरे प्रैंधल़ी पांडे ताक्‍की ती एरुशलेम नगरी बाखा। सह करा त कबल्‍लअ धैल़ी चिई बारी परमेशरा सेटा अरज़ अर तेऊओ शूकर। तधू बी किअ तेऊ तिहअ ई।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />होर कार-करिंदै अर राज़पाल ज़ुंणीं एक्‍कअ त किअ द, तिन्‍नैं भाल़अ कि दानिएल आसा आपणैं परमेशरा सेटा अरज़ करदअ लागअ द। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />तिंयां डेऊऐ माहा राज़ै दारा सेटा एते बारै खोज़दै फिरी संघा बोलअ, “तूह कर आद कि तंऐं आसा नऊंअ बधान बणाअं द कि ज़ुंण तिहा धैल़ी तैणीं ताह सुआई कहा होरी देअआ सेटा अरज़ करे, सह पाणअ सिहे जुहल़ी दी।” राज़ै बोलअ, “हाँ, अह हुकम आसा मादी अर फारसी बधाना दी मंऐं आपणैं दसकत करी लिखी डाहअ द अर एता निं ऐबै कोह बदल़ी अर रद्द करी सकदअ।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तेखअ बोलअ तिन्‍नैं कार-करिंदै राज़ै दारा लै, “माहा राज़अ, सह दानिएल ज़ुंण यहूदा मुल्खा का कैद करी आणै दै मणछा मांझ़ै आसा, ज़ुंण तंऐं आपणैं दसकत करी हुकम ज़ारी किअ, सह निं तेता मंदअ ई आथी! सह करा अज़ी बी आपणैं परमेशरा सेटा धैल़ी चिई बारी कबल्‍लअ अरज़।” <verse eid="DAN 6:13" /><verse number="14" style="v" sid="DAN 6:14" />राज़अ दारा हुअ इना गल्‍ला शूणीं खास्सअ दुखी। सह लागअ सोठदअ कि दानिएल त तेऊ किहअ करै बच़ाऊंणअ।<verse eid="DAN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 6:15" />तिन्‍नैं सोभी कार-करिंदै किअ भिई एक्‍कअ संघा डेऊऐ उडै राज़ै सेटा लै फिरी। तिन्‍नैं बोलअ, “माहा राज़अ, ऐहा गल्‍ला डाहै आद कि ज़ुंण बधान मादी अर फारसी बधाना दी लिखी हेरअ डाही, तेता निं कोह बदल़ी सकदअ। तेऊ निं राज़अ आप्पू बी रद्द करी सकदअ।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तेखअ दैनअ राज़ै दारा हुकम कि दानिएला करा कैद। सपाही आणअ दानिएल ढाकी संघा शोटअ सिहे जुहल़ी दी। राज़ै बोलअ तेऊ लै, “तूह करा शुचअ-पाक्‍कअ रही आपणैं परमेशरे च़ाकरी, मेरी आसा एही अरज़ कि तेऊ परमेशरै लोल़ी तूह बच़ाऊअ।”<verse eid="DAN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 6:17" />जुहल़ीए मोहरै डाही तिन्‍नैं बडी टोल्ह बदल़ी अर सह टोल्ह डाही शांघल़ी करै सील करी। प्रैंदै लाई राज़ै आपणीं मुंदल़ी करै मोहर। होरी कार-करिंदै बी लाई तेथ आपणीं-आपणीं मुंदल़ी करै मोहर। ताकि कुंण दानिएला तैहा जुहल़ी का बागै निं काढे। <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />तेखअ डेऊअ राज़अ दारा आपणैं मैहला लै फिरी। तेऊ निं बैल़ी रोटी बी खाई। आप्पू सेटा गाणैं-बज़ाणैं आल़ै लै बी किअ तेऊ एछणा लै नांह। तेऊ निं सारी राची नींज पल़ी।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />भैणीं दोत्ती गअ राज़अ उझ़ुई संघा ठुर्हअ तैहा सिहे जुहल़ी सेटा लै ज़िधी दानिएल त पाई डाहअ द। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जुहल़ी नेल़ पुजी लाई राज़ै बडै दुखी दिलै दानिएला लै हाक्‍का, “दानिएल, ए दानिएल, तूह करा त शुचअ-पाक्‍कअ रही आपणैं परमेशरे च़ाकरी! तूह तेऊ इना सिहा का बच़ाऊअ बी?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />दानिएलै दैनअ ज़बाब, “माहा राज़अ, तेरी लोल़ी लाम्मी अमर हुई! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मेरै परमेशरा का आसा थोघ कि हुंह आसा नर्दोश, तेऊ छ़ाडअ मुंह सेटा लै आपणअ एक स्वर्ग दूत, तेऊ डाहै सिहे दांद किल्‍ली अर इहअ करै निं ईंयां सिह मेरी किछ़ हान्‍नी करी सकै। माहा राज़अ, मंऐं निं ताल्है बी इहअ किछ़ किअ कि ज़ेता करै तेरी हान्‍नी हुई होए।”<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="ISA 63:9">ईशा. 63:9</ref>; <ref loc="PSA 34:7">भज. 34:7</ref></char></note><verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />तेखअ हुअ जुहल़ी भितरा का दानिएला गल्‍ला करदअ शूणीं राज़अ दारा खुश अर तेऊ किअ हुकम कि दानिएला काढा जुहल़ी सिहा जैंदरा का बागै। सपाही काढअ दानिएल जुहल़ी का बागै अर तेऊए घेरी निं किधी पेहुश बी आथी त लागअ द। किल्हैकि दानिएल रहा त आपणैं परमेशरे आसरै अर परमेशरै निं तेऊए किछ़ हान्‍नी दैनी हणैं। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तेखअ किअ राज़ै आपणैं सपाही लै हुकम कि तिन्‍नां कार-करिंदै आणा शादी ज़ुंणी दानिएला संघै ज़ीद डाही तेऊ लै अह दोश लाअ त। राज़ै बझ़ैल़ै तिंयां सोभै तिन्‍नें बेटल़ी-माठै संघी तैहा ई सिहे जुहल़ी दी पाणै। ज़ेतरी तिंयां जुहल़ी भितरी शोटै, भुखै सिह पल़ै तिन्‍नां लै चुटी अर तिंयां खाऐ तिन्‍नें हाडकै संघी पठ।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />एता बाद दैनअ माहा राज़ै दारा संसारे सोभी देश, ज़ाती अर सोभी भाषा-बोली बोल़णैं आल़ै लै समाद,</para>
  <para style="q" vid="DAN 6:25">“तम्हैं लोल़ी राज्ज़ी-राम्बल़ै रहै अर सदा खुश रहै!<verse eid="DAN 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="DAN 6:26" />ज़हा-ज़हा देशै मेरअ राज़ आसा,</para>
  <para style="q" vid="DAN 6:26">तिन्‍नां सोभी लै आसा मेरअ हुकम कि</para>
  <para style="q" vid="DAN 6:26">सोभ लोग करै तेऊ परमेशरो अदर ज़सरी च़ाकरी दानिएल करा।</para>
  <para style="q" vid="DAN 6:26">सोभ रहै तेऊ परमेशरे डरा हेठै! किल्हैकि</para>
  <para style="q" vid="DAN 6:26">सह ई आसा ज़िऊंदअ परमेशर अर</para>
  <para style="q" vid="DAN 6:26">जुगै-जुगै तैणीं आसा सह ई।</para>
  <para style="q" vid="DAN 6:26">तेऊओ राज़ निं कधि खतम हणअ अर सह आसा</para>
  <para style="q" vid="DAN 6:26">सोभी प्रैंदै सदा लै राज़अ।<note caller="-" style="x"><char style="xo" closed="false">6:26 </char><char style="xt" closed="false"><ref loc="DAN 7:27">दान. 7:27</ref>; <ref loc="PSA 99:1-3">भज. 99:1-3</ref></char></note><verse eid="DAN 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="DAN 6:27" />खरी का बच़ाऊआ सह ई अर</para>
  <para style="q" vid="DAN 6:27">ज़िन्दगी बी सका सह ई बच़ाऊई।</para>
  <para style="q" vid="DAN 6:27">सह करा सरगै अर धरती दी महान अर नुआहरै च़मत्कार।</para>
  <para style="q" vid="DAN 6:27">तेऊ ई परमेशरै बच़ाऊअ दानिएल बलबान सिहा का।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />इहअ करै बिति फारसी माहा राज़ै दारा अर तेऊ बाद माहा राज़ै कुस्रूए राज़ा दी दानिएल ज़िन्दगी राज्ज़ी-मौज़ी।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानिएला का शुझुऐ सुपनै च़ार ज़ीब</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बाबेल देशै बणअ बेलशेसर राज़अ। तेऊए राज़ा दी पैहली साला हुऐ दानिएला धैन अर सुपनै ज़ेभै सह राची सुत्तअ द आसा त। ज़ुंण गल्‍ला तेऊ धैनै-सुपनै भाल़ी, तिंयां डाही तेऊ लिखी। <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानिएलै आसा इहअ लिखी डाहअ द:</para>
  <para style="p" vid="DAN 7:2">“मुंह हुअ राची इहअ सुपनअ कि मुखा शुझुई सरगै आसा च़ऊ दिशा बाखा ढिश-बागरी लागी दी। तेता करै उझ़ुई मांझ़ समुंदरै बडी-बडी छ़ाल्‍ली। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तेखअ शुझुऐ मुखा नच़ानक कि समुंदरा का निखल़ै च़ार बडै-बडै ज़ीब अर हेरनै तै तिंयां होरी-होरी रंगे।<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">प्रका. 13:1</ref>; <ref loc="REV 17:8">17:8</ref></char></note> <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" /><note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="REV 13:2">प्रका. 13:2</ref></char></note>पैहलअ ज़ीब त सिहा ज़िहअ अर तेऊ तै मुक्षरलै ज़िहै फैंख। हुंह त तेऊ भाल़अ ई लागअ द कि तेऊए फैंख पाऐ पोर्ही पेच़ी! सह किअ धरना का खल़अ संघा डाहअ मणछा ज़िहअ दूई खूरा दी खल़अ करी। तेऊ ज़ीबा लै दैनअ मणछा ज़िहअ मन्‍न।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />“दुजअ ज़ीब शुझुअ मुखा भाल्‍लू ज़िहअ, सह त आपणीं ज़ांघे थूंज़ा प्रैंदै आज़रअ खल़्हुअ द। मुखा शुझुअ कि तेऊ दांदा बाती आसा चअन शल़्है बागा लै निखल़ै दै। तेऊ लै त इहअ बोलअ द, ‘तूह पल़ चुटी! तिन्‍नां सोभी ल्हासा खा ज़हा तूह च़ाहा।’<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />“चिऊथअ ज़ीब शुझुअ मुखा च़राघा ज़िहअ, पर एऊ ज़ीबे पिठी थिऐ च़ेल्‍लू ज़िहै च़ार फैंख। एऊ ज़ीबे मूंड बी थिऐ च़ार अर एऊ भेटअ राज़ करनैओ हक।<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />“हुंह त सुपनै भाल़अ लागअ द, मुखा शुझुअ सह च़ौथअ ज़ीब। सह ज़ीब त हेरनअ होरी का करबैऊंणअ। तेऊए खाखा तै लोहे बडै-बडै दांद। सह ज़ीब खाआ त सोभै च़िज़ा अर तेते करा त सह ठोर-ठोर। ज़ुंण तेऊए खाखा का छ़ुटा थिअ, तेता जैंटा त सह आपणैं खूरा करै। सह त मंऐं पैहलै भाल़ै दै तिन्‍नां ज़ीबा का होरी रंगो, तेऊए मुंडै तै दस शींग।<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="REV 12:3">प्रका. 12:3</ref>; <ref loc="REV 13:1">13:1</ref></char></note> <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />हुंह त तेऊए तिन्‍नां शींगे बारै सोठदअ लागअ द कि मुखा शुझुअ इहअ कि एक शींग टिप्पअ होर अर तेता करै पेछ़ुऐ चअन शींग पोर्ही। अह शींग त होछ़अ ज़िहअ अर तेथ थिई मणछे आछी ज़ेही आछी अर तेऊ दी थिई खाख बी अर सह त बडी शरेरी गल्‍ला करदअ लागअ द।<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="REV 13:5">प्रका. 13:5</ref>,<ref loc="REV 13:6">6</ref></char></note><verse eid="DAN 7:8" /></para>
  <para style="s">नसाफ</para>
  <para style="q">
    <verse number="9" style="v" sid="DAN 7:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:4">प्रका. 20:4</ref>
      </char>
    </note>तेखअ शुझुअ मुखा सुपनै इहअ कि</para>
  <para style="q" vid="DAN 7:9">कोऐ आणी तिधा लै राज़गाद्दी अर</para>
  <para style="q" vid="DAN 7:9">तैहा राज़गाद्दी दी बेठअ सह ज़ुंण</para>
  <para style="q" vid="DAN 7:9">जुगा-जुगा ओर्ही सदा<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="fq" closed="false">जुगा-जुगा ओर्ही सदा </char><char style="ft" closed="false">अटल़ परमेशर</char></note> राज़ करदी आअ।</para>
  <para style="q" vid="DAN 7:9">तेऊए झिकल़ै तै हिंऊंआं ज़िहै शेतै अर</para>
  <para style="q" vid="DAN 7:9">तेऊए मुंडे शराल़ बी थिऐ शेती ऊना ज़िहै।</para>
  <para style="q" vid="DAN 7:9">तेऊए तैहा राज़गाद्दी अर तेते घरेटा का थिई आग भकी दी।<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 1:14">प्रका. 1:14</ref></char></note><verse eid="DAN 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="DAN 7:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:11">प्रका. 5:11</ref>
      </char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:14">प्रका. 1:14</ref>
      </char>
    </note>ज़हा राज़गाद्दी दी सह बेठअ द थिअ, तेता का बगअ आगीओ दरैअ!</para>
  <para style="q" vid="DAN 7:10">हज़ारो स्वर्ग दूत तै तेऊए च़ाकरी लै तेऊ सेटा हाथ ज़ोल़ी खल़्हुऐ दै।</para>
  <para style="q" vid="DAN 7:10">सह त नसाफ करना लै दरबार लागअ द अर</para>
  <para style="q" vid="DAN 7:10">तिधी खोल्ही बधाने कताबा कि तेथ किज़ै आसा लिखअ द।<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 20:12">प्रका. 20:12</ref></char></note><verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />“हुंह त तेऊ राम्बल़ै करै भाल़अ लागअ द कि तेऊ होछ़ै ज़िहै शींगा लै किज़ै हणअ होए, किल्हैकि सह त बडी शरेरी गल्‍ला करदअ लागअ द। तेतरी शुझुअ मुखा इहअ कि सह च़ौथअ ज़ीब पाअ मारी अर सह पाअ तेऊ ज़ल़दी आगीए दरैऊआ दी। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />ज़ुंण तिंयां चअन ज़ीब होर आसा तै, तिन्‍नां का छ़ड़ैऊअ राज़ करनैओ हक पोर्ही। पर तिन्‍नां लै दैनअ एक बगत कि तिंयां तेभै तैणीं ज़िऊंदै रहे।<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />“मंऐं भाल़अ राची एऊ सुपनै दी इहअ कि सरगा का आसा बादल़ा संघै कुंण मणछा ज़िहअ मुंह बाखा एछदअ लागअ द। सह डेऊअ तेऊ सेटा ज़ुंण सदा ज़िऊंदअ आसा अर लोगै किअ सह परमेशरा सेटा खल़अ।<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">मोत्त. 24:30</ref>; <ref loc="MAT 26:64">26:64</ref>; <ref loc="MRK 13:26">मार्क. 13:26</ref>; <ref loc="MRK 14:62">14:62</ref>; <ref loc="LUK 21:27">लूक. 21:27</ref>; <ref loc="REV 1:7">प्रका. 1:7</ref>,<ref loc="REV 1:13">13</ref>; <ref loc="REV 14:14">14:14</ref></char></note> <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />परमेशरै किअ तेऊओ अदर अर तेऊ दैनअ तेऊ मणछा लै राज़ करनैओ हक, सोभी देशै अर सोभी बोली-भाषा बोल़णैं आल़ै हुऐ तेऊए च़ाकरी करना लै सैहमत। सह हणअ सदा लै राज़अ अर तेऊओ राज़ निं कोह खतम करी सकदअ।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रका. 11:15</ref></char></note><verse eid="DAN 7:14" /></para>
  <para style="s">एऊ सुपनैओ फल</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />“एऊ सुपनै भाल़ी तबझ़ुअ हुंह दानिएल पठी अर मुंह छ़ुटअ दर्छ़णअ। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तेखअ डेऊअ हुंह एकी नेल़ ज़िहअ ज़ुंण परमेशरे राज़गाद्दी सेटा त खल़्हुअ द। मंऐं बोलअ तेऊ लै कि तूह समझ़ाऊ मुखा कि इना गल्‍लो किज़ै मतलब आसा। तेऊ खोज़अ मुखा तेऊ सुपनैओ फल। <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />तेऊ बोलअ इहअ, ‘ईंयां च़ार बडै ज़ीब आसा च़ार राज़ ज़ुंण धरती दी हणैं। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पर राज़ करनैओ हक भेटणअ परम प्रधान परमेशरे पबित्र परज़ा अर तिन्‍नों राज़ रहणअ जुगै-जुगै तैणीं सारी सदा।’<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">प्रका. 22:5</ref></char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />“तेखअ च़ाहा त हुंह तेऊ च़ौथै ज़ीबे बारै पुछ़णअ। सह ज़ीब निं तिन्‍नां होरी ज़ीबा ज़िहअ आथी त। सह त करबैऊंणअ ज़ीब, तेऊ भाल़ी छ़ुटअ मुंह दर्छ़णअ। तेऊ ज़ीबे तै लोहे दांद अर न्हश थिऐ पितल़े। सह ज़ीब खाआ त सोभै च़िज़ा अर तेते करा त सह ठोर-ठोर। ज़ुंण तेऊए खाखा का छ़ुटा थिअ, तेता जैंटा त सह आपणैं खूरा करै। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />हुंह च़ाहा त तेते बारै बी पुछ़णअ ज़ुंण तेऊ ज़ीबे मुंडै दस शींग थिऐ अर तेऊ होछ़ै शींगे बारै ज़ुंण तिन्‍नां शींगा जैंदरा का टिप्पअ त अर ज़ेता करै चअन शींग गोधी का पोर्ही पेछ़ुऐ तै, ज़हा मणछा ज़ेही आछी अर खाख थिई अर ज़ुंण बडी शरेरी गल्‍ला करदअ त लागअ द। सह होछ़अ शींग ज़ाण्हिंआं त तिन्‍नां होरी शींगा का खास्सअ डरैऊंणअ।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="DAN 7:8">दान. 7:8</ref></char></note><verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />“हुंह त भाल़अ लागअ कि सह होछ़अ शींग पल़अ परमेशरे पबित्र परज़ा मारदअ चुटी अर सह ज़ितअ तिन्‍नां का।<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">प्रका. 13:7</ref></char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />तेखअ आअ सह जुगा-जुगा ओर्ही सदा राज़ करदी आअ। तेऊ किअ परमेशरे पबित्र परज़े पक्षा दी नसाफ कि तिंयां आसा भलै अर शुचै। ऐबै गअ सह बगत एछी कि अह राज़ दैणअ परमेशरे पबित्र परज़ा लै।<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="REV 20:4">प्रका. 20:4</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="MAT 19:28">मोत्त. 19:28</ref></char></note><verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />“ज़हा का मंऐं पुछ़अ, तेऊ खोज़अ मुखा इहअ, ‘च़ौथअ बडअ ज़ीब आसा धरती दी ज़ुंण च़ौथअ राज़ एछणअ। अह राज़ हणअ तिन्‍नां चिई राज़ा का होरी साबो। एऊ राज़ा करनी सारी धरती पृथूई बरैबाद। एऊ राज़ा चेल्हणीं धरती ज़ेही नां केही अर एते सोभी च़िज़े करनै तेऊ ठोर-ठोर। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />ईंयां दस शींग आसा एऊ राज़ा दी राज़ करनै आल़ै दस राज़ै। तेखअ एछणअ एक होर राज़अ राज़ करदअ। तेऊओ बभार हणअ इना होरी राज़ै का ज़ुदअ अर शुरू ई दी हेरनै तेऊ इना दसा राज़ै मांझ़ै चअन राज़ै खतम करी।<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">प्रका. 17:12</ref></char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />तेऊ बोल़णअ परम प्रधान परमेशरा लै बूरअ अर तेऊए पबित्र परज़ा हंतणी तेऊ ज़ेही नां केही। सह हणअ तिन्‍नां लै खास्सअ नर्दैई कि तेऊ करनी तिन्‍नें तिह-थैर, बिधी-बधान खतम करने कोशिश। साढै चिई साला तैणीं करनअ तेऊ परमेशरे पबित्र परज़ा प्रैंदै राज़।<note caller="-" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="REV 12:14">प्रका. 12:14</ref>; <ref loc="REV 13:5">13:5</ref>,<ref loc="REV 13:6">6</ref></char></note> <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />तेखअ लागणअ नसाफ करना लै परमेशरो दरबार, परमेशरा छ़ड़ैऊंणअ तेऊ का राज़ पोर्ही अर सह करनअ तेऊ पठी खतम। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />तेखअ दैणअ धरती दी सोभी देशो महान राज़ परमेशरे पबित्र परज़ा लै। तिन्‍नों राज़ निं तेखअ कधि खतम हणअ, धरती दी राज़ करनै आल़ै करनी तेखअ तिन्‍नें च़ाकरी अर तिन्‍नां मनणअ ज़िहअ तिंयां बोले तिहअ हुकम।’<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रका. 11:15</ref>; <ref loc="REV 20:4">20:4</ref>; <ref loc="REV 22:5">22:5</ref></char></note><verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />“ईंयां एतरी गल्‍ला भाल़ी मंऐं सुपनै। एता करै तबझ़ुअ हुंह दानिएल खास्सअ। मेरअ फिरअ त मुंह बी शेफल़अ, पर मंऐं निं इना गल्‍ले बारै कोही का खोज़अ आथी।”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">बाकरै अर गाभो सुपनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बाबेल देशे राज़ा दी त बेलशेसर माहा राज़अ, तेऊए राज़ा दी चिऊथी साला हुअ मुंह दानिएला एक होर सुपनअ।<verse eid="DAN 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 8:2" />सुपनै शुझुअ मुखा इहअ कि हुंह आसा एलाम मुल्खै शुशन नाओंए गहल़ा आल़ी नगरी। तिधी आसा हुंह ऊलाई नाओंए गाडे बाढै खल़्हुअ द। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />हुंह लागअ उझै बाखा भाल़अ अर तेथ शुझुअ मुखा एक गाभ अर तेऊए आसा बडै-बडै शगैठ। एक शगैठ त दुजै शगैठा का लाम्मअ अर सह लाम्मअ शगैठ ज़ाण्हिंआं त इहअ कि सह आसा तेऊ होछ़ै शगैठा बाद टिप्पअ द। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />तेखअ शुझुअ मुखा कि सह गाभ लागअ आपणैं शींगा करै पछ़म, उतर अर दखण दिशा बाखा जल़ाखदअ। तेऊओ मकाबलअ निं कोह ज़ीब करी सकअ अर तेऊए ज़ोरा का निं कोह आप्पू बच़ाऊई सकदअ। तेऊ किअ ज़िहअ तेऊओ दिल बोलअ तिहअ अर तेऊ त आपणैं ज़ोरो बडअ घमंड।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />हुंह त तेते बारै सोठदअ समझ़दअ ई लागअ द कि एतो किज़ै मतलब आसा। मुखा शुझुअ एक बाकरअ आअ पछ़म दिशा बाखा, सह आअ इहअ बागरी ज़िहअ ठुर्ही कि तेऊए छ़ल़ू निं धरनीं बी लागदै तै। तेऊ बाकरे दूई आछी मांझ़ै त एक बडअ शींग। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />सह आअ कोहरअ तेऊ दूई शींगा आल़ै गाभा सेटा लै ठुर्ही ज़ुंण मंऐं गाडे बाढै भाल़अ त। तेऊ बाकरै ती खास्सी रोश्शै आई दी अर सह पल़अ पूरै ज़ोरा संघी तेऊ गाभा लै चुटी। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />मुखा शुझुअ कि सह बाकरअ पल़अ तेऊ गाभा लै चुटी, खास्सै रोश्शा संघी बाही तेऊ बाकरे दूई शींगा आल़ै गाभा लै एही जडराल़ कि तेऊए तिंयां शींग पाऐ चोल़ी। गाभा निं तेखअ तेऊ बाकरैओ मकाबलअ करनै जोगी ज़ोर रहअ। बाकरै बदल़अ सह गाभ धरनीं संघा दघोस्सअ सह आपणैं छ़ल़ू करै। इहअ निं कोह निखल़अ ज़ुंण गाभा तेऊ बाकरै का बच़ाऊई सके।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />तेऊ बाकरै त आपणैं ज़ोरो बडअ घमंड अर तेखअ हुअ सह होर बी शरेरअ। पर ज़ांऊं सह खास्सअ बलबान हुअ, तेऊओ सह शींग चुटअ पोर्ही अर तेते ज़ैगा टिप्पै च़ार शींग ज़ुंण भाल़णा लै नुआहरै आसा तै! तिंयां शींगे च़ुंज़ी फिरी उझै बझ़ी करै ज़ुदी-ज़ुदी च़ऊ दिशा बाखा।<verse eid="DAN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9" />इना च़ऊ शींगा मांझ़ै टिप्पअ एकी शींगा का एक होछ़अ ज़िहअ होर शींग। सह बझ़अ दखण-पुर्ब दिशा बाखा अर म्हारै शोभलै देशा बाखा। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />सह शींग हुअ एतरअ बलबान कि तेऊ छ़ेल़अ स्वर्गे सैना अर तारै संघै बी जुध। तिन्‍नां मांझ़ै शोटै तेऊ कई तारै धरनीं संघा जैंटै धरनीं।<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">प्रका. 12:4</ref></char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />सह लागअ आप्पू इहअ समझ़दअ कि सह आसा तेऊ का बी बडअ ज़ुंण स्वर्गे सैनो सैनापति आसा! परमेशरा लै धैल़ ज़ुंण हूम अर बल़ीदान हआ तै, लोग रोक्‍कै तेऊ तेता करनै का। ज़ुंण परमेशरो बसेरअ आसा थिअ, सह पबित्र भबन बी किअ तेऊ ढोल़ी पठ खतम, <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />परमेशरे परज़ा बी मनअ आप्पू प्रैंदै तेऊ शींगो राज़, किल्हैकि तिंयां तै परमेशरा का दूर हुऐ दै। तिन्‍नैं किऐ परमेशरा छ़ाडी तेऊ शींगा लै हूम अर बल़ीदान करी पाप। तेऊ शींगै डाहै तिंयां सत्ता दी विश्वास करनै का रोक्‍की। सह हुअ तिहअ करना लै सफल ज़िहअ सह करनअ च़ाहा त।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />तेखअ शूणअ मंऐं एक स्वर्ग दूत दुजै स्वर्ग दूता लै, “एऊ सुपनै दी ज़ुंण गल्‍ला शुझुई, ईंयां केभै तैणीं रहणीं शुझदी लागी? धैल़ हूम बल़ीदाना दी अह घोर पाप केभै तैणीं रहणअ हंदअ लागी? स्वर्गे सारी सैना अर पबित्र भबनो बनाश कधू तैणीं रहणअ हंदअ लागी?”<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="REV 11:12">प्रका. 11:12</ref></char></note><verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />तेखअ शूणअ मंऐं सह दुजअ स्वर्ग दूत बोल्दअ, “ज़ेभै तैणीं त्रेई शौ सान्हां अर दोत्ती बिति निं जाए, तेभै तैणीं रहणअ अह पाप हंदअ लागी। तेता बाद करनअ बिधातो भबन भिई शुचअ।”<verse eid="DAN 8:14" /></para>
  <para style="s">गब्रीएल स्वर्ग दूतै खोज़अ सुपनैओ फल</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />मुंह दानिएला ज़ुंण अह सुपनअ हुअ, हुंह त एता समझ़णें कोशिश करदअ लागअ द कि एतो कै मतलब आसा। तेभै शुझुअ मुखा नच़ानक कि मुंह आजू आसा कुंण खल़्हुअ द। सह ज़ाण्हिंआं त ज़ात मणछा ज़िहअ।<verse eid="DAN 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 8:16" />तेखअ शुण्हुंअ मुखा ऊलाई गाडा बाखा कुंण हाक्‍का लाई बोल्दअ, “गब्रीएल, एऊ मणछा का समझ़ाऊ तेतो मतलब ज़ुंण एऊ भाल़अ।”<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूक. 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note><verse eid="DAN 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 8:17" />गब्रीएल आअ मुंह नेल़ ज़िधी हुंह खल़्हुअ द त। मुंह छ़ुटअ डरै दर्छ़णअ अर हुंह पल़अ धरनीं उटी बाखा।</para>
  <para style="p" vid="DAN 8:17">तेऊ बोलअ मुल्है इहअ, “मणछा, ज़ुंण सुपनअ तंऐं भाल़अ, तूह समझ़ एतो मतलब। अह सुपनअ आसा तेभा लै ज़ेभै संसार खतम हणअ।”<verse eid="DAN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 8:18" />ज़ेभै सह गल्‍ला करदअ त लागअ द, तेभै त हुंह धरनीं उटी बाखा पल़अ द अर मुंह निं हैल़ी-हांस ई आथी त रहअ द। पर तेऊ छ़ुंहंअ हुंह संघा किअ हुंह मेरी ज़ांघा आज़रअ खल़अ। <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />तेखअ बोलअ तेऊ इहअ, “मंऐं लाअ ताखा रहैऊई कि परमेशरे रोश्शो नतिज़अ किज़ै निखल़ा। अह सुपनअ आसा तेरअ तेऊ बगते बारै ज़ेभै सोभै गल्‍ला खतम हणीं।<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />“ज़ुंण तंऐं गाभे दूई शींग भाल़ै, तिंयां आसा मादी अर फारसी लोगे दूई राज़ै। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />सह बाकरअ आसा यूनान देशे लोगो राज़। तेऊ बाकरे दुही आछी मांझ़ै शींग आसा यूनानी राज़ो पैहलअ राज़अ। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />तेऊ शींगा चुटी ज़ुंण तेते ज़ैगा च़ार शींग टिप्पै, सह आसा इहअ कि यूनानी राज़ बांढणअ च़ऊ ज़ुदै-ज़ुदै देशा दी। पर तिंयां निं पैहलै राज़ा ज़िहै बलबान हणैं।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“इना च़ऊ देशे राज़ैओ राज़ खतम हणैं खिरीए साला हणैं लोग पठी कदुष्ट। तेखअ निखल़णअ एक नर्दैई राज़अ, सह हणअ च़लाक अर ठग। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />सह हणअ खास्सअ बलबान, तेऊ करनअ हर ज़ैगा घोर बनाश। सह हणअ तेऊए हर कामां लै सफल। तेऊ करनै बडै-बडै बलबान मणछ अर तिंयां पबित्र मणछ बरैबाद ज़ुंण परमेशरे खास परज़ा आसा। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />सह हणअ इहअ च़लाक कि तेऊ ठगणै लोग पठी। तेऊ हणअ आपणैं बलबान हणैंओ खास्सअ घमंड। लोगा सोठणअ इहअ कि तिंयां आसा तेऊए राज़ा दी राज्ज़ी-राम्बल़ै बच़ै दै, पर तेऊ पाणै तिन्‍नां मांझ़ै खास्सै मारी। सह हणअ सोभी राज़ै प्रैंदै माहा राज़ैओ बी बरोधी। पर खिरी करनअ सह परमेशरा आप्पै खतम, तेऊ मारनै आल़अ निं कोह मणछ हणअ।<verse eid="DAN 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 8:26" />“ज़ुंण तंऐं सुपनै सान्हां अर दोत्तीए बारै शूणअ, सह गल्‍ल आसा शुची। पर तूह डाहै ऐहा गल्‍लो छ़पाअ, एता निं कोही का खोज़ी, किल्हैकि इना गल्‍ला पूरी हणां लै लागणीं अज़ी खास्सी साला।”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />एऊ सुपनै भाल़णैं का बाद फिरअ हुंह दानिएल बाख दुबल़अ। हुंह रहअ खास्सै धैल़ै तैणीं बमार। ज़ांऊं हुंह बिज़रअ, तेखअ उझ़ुअ हुंह खल़अ संघा डेऊअ हुंह राज़ेए च़ाकरी करदअ फिरी। पर ज़ुंण मंऐं भाल़अ थिअ, तेता करै त हुंह खास्सअ झाखुअ द, किल्हैकि मुंह निस्सी ती तिंयां गल्‍ला समझ़ एछी।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानिएलै किई आपणैं लोगा लै अरज़</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />क्षयर्ष माहा राज़अ ज़ुंण मादी लोगा मांझ़ै आसा त, तेऊओ शोहरू दारा लागअ बाबेल देशे राज़ा दी राज़ करदअ। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />तेऊए राज़ा दी पैहली साला लागअ हुंह दानिएल पबित्र शास्त्र कताबा पहल़दअ। मंऐं पहल़अ तेऊ समादे बारै ज़ुंण बिधाता आपणैं गूर जेरमयाह का दैनअ त। हुंह त तेऊ समादे बारै बच़ार करदअ लागअ द, ज़ुंण बिधाता जेरमयाह का खोज़ी त डाहअ द कि सत्तर साला तैणीं रहणीं एरुशलेम नगरी सिधी पात्थरे डिंगरी।<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">जेर. 25:11</ref>; <ref loc="JER 29:10">29:10</ref></char></note> <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />तेखअ किई मंऐं आपणैं मालक बिधाता सेटा अरज़ कि सह मेरी मज़त करे। हुंह रहअ ब्रतू, घेरी डाहै मंऐं खिंथल़ै बान्हीं, संघा रहअ हुंह छ़ारा जैंदरी बेशी। <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />मंऐं मनी आपणैं मालक बिधाता सेटा अह गल्‍ल कि हाम्हैं किअ पाप, संघा किई मंऐं तेऊ सेटा एही अरज़:</para>
  <para style="p" vid="DAN 9:4">“ए परमेशर बिधाता, तूह आसा महान, हाम्हैं करा तेरअ अदर। तूह आसा आपणीं करार पूरी करना लै शुचअ-पाक्‍कअ। तेरी झ़ूरी आसा तिन्‍नां लै अटल़ ज़ुंण ताल्है झ़ूरा अर तेरअ हुकम मना।<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />“हाम्हैं किऐ पाप, हाम्हैं हुऐ खास्सै कदुष्ट अर हाम्हैं किअ खास्सअ बूरअ। हाम्हैं निं तेरै बधाने साबै ज़िन्दगी ज़िऊई। इहअ करै किअ हाम्हैं ताल्है द्रोह। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />हाम्हैं निं तिन्‍नें बी शूणीं ज़ुंण तंऐं आपणैं दास अर गूर हाम्हां सेटा लै छ़ाडै। तिन्‍नैं खोज़अ तेरअ समाद म्हारै राज़ै, म्हारै दाद-बाब अर म्हारै सारै देशा का।<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NEH 9:34">नहे. 9:34</ref></char></note><verse eid="DAN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 9:7" />“ए मेरै मालक, तूह करा सदा भलअ, पर हाम्हैं किअ सदा इहअ ज़ेता करै हाम्हां शर्मिंदै पल़अ हणअ। अह गल्‍ल आसा शुची कि हाम्हैं यहूदा मुल्ख अर एरुशलेम नगरीए परज़ा किअ ताल्है विश्वास घात। तंऐं आसा हाम्हैं इज़राईली देशै-देशै डाहै दै छिंगी। नेल़ अर दूर देशै हाम्हैं ज़िधी बी आसा बस्सै दै, हाम्हैं आसा सोभ शर्मिंदै हुऐ दै, किल्हैकि हाम्हैं हुऐ ताखा दूर। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />म्हारै राज़ै, सैनापति अर म्हारै दाद-बाब हुऐ पाप करनै पिछ़ू ताह बिधाता का दूर। तैही आसा हाम्हैं शर्मिंदै हुऐ दै। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />म्हारै मालक बिधाता, हाम्हैं किअ ताल्है द्रोह! पर तूह आसा झणैल़ू अर तूह करा हाम्हां माफ। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />ए म्हारै मालक बिधाता, हाम्हैं निं तेरै बधान अर बिधीए साबै ज़िन्दगी ज़िऊई ज़ुंण तंऐं आपणैं दास अर गूरा बाती हाम्हां लै दैनी ती।<verse eid="DAN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 9:11" />“मालक, हाम्हैं सोभ इज़राईली हुऐ तेरै बधाना का दूर। हाम्हैं हुधूऐ तिहअ करना लै ज़िहअ तंऐं खोज़अ त! हाम्हैं किअ ताल्है पाप अर तंऐं पाऐ हाम्हां लै तिंयां फिटक ज़ुंण तेरै दास मोसा लिखै दै बधाना दी आसा खोज़ै दै। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तंऐं किअ हाम्हां अर म्हारै राज़ै लै तिहअ ई ज़िहअ तंऐं बोली त डाहअ द। परमेशर, तंऐं दैनी पृथूई दी राज़धानी एरुशलेम नगरी लै होरी नगरी का सात गुणा खास्सी सज़ा। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />तंऐं पाई तिंयां सोभ आफ़ता हाम्हां लै ज़ुंण तेरै गूर मोसा तेरी बधाने कताबा दी आसा लिखी दी। पर हाम्हैं निं अज़ी बी तिहअ करदै ज़ेता करै तूह म्हारअ मालक बिधाता खुश होए। हाम्हैं निं अज़ी बी पाप करनै छ़ाडै। हाम्हैं निं अज़ी बी तेरी शिक्षा अर सत्त समझ़अ आथी। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />ए म्हारै मालक बिधाता, तूह त हाम्हां लै सज़ा दैंदअ तैर्हुई रहअ द अर खिरी किअ बी तंऐं तिहअ ई। तूह आसा धर्मीं अर तेरी हाम्हां लै सज़ा दैणीं ती ठीक किल्हैकि हाम्हैं निं ज़िहअ तंऐं बोलअ तिहअ किअ आथी।<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />“ए म्हारै मालक बिधाता, तंऐं रहैऊअ त तधू आपणअ महान बल ज़धू तंऐं आपणीं परज़ा मिसर देशे गलामी का आज़ाद किई ती। तेरै तेऊ महान बला निं आझ़ बी कोह बिस्सरुऐ। पर हाम्हैं किऐ पाप अर अह आसा म्हारअ कशूर। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />ए म्हारै मालक, ज़ीबाण, ऐबै निं हाम्हां लै रोश्श करै आथी। ऐबै निं आपणीं पबित्र धारा एरुशलेम नगरी लै होर सज़ा दैई। म्हारै दादै-बाबै ज़ुंण पाप अर बूरै काम किऐ, तेता पिछ़ू करा होर लोग बी म्हारअ सुहांग। फेर बस्सै दै लोग हआ हाम्हां तेरी परज़ा अर एरुशलेम नगरी लै हास्सदै लागै दै। ज़ीबाण, तूह कर हाम्हां लै तिहअ ई भलअ ज़िहअ तूह करदी आअ।<verse eid="DAN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 9:17" />“ए म्हारै मालका, तूह शुण मेरी अरज़ अर लेर-पकार। तेरै पबित्र भबना कर भिई खल़ै ज़ुंण पठी ढोल़ी आसा पाअ द, तेता लै दै भिई बर्गत ताकि सोभी का थोघ लागे कि तूह किहअ महान परमेशर आसा। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />ए म्हारै मालक, म्हारी नगरी आसा पठ ढूल़ी-पल़ी दी, तेथ आसा सिधी पात्थरे डिंगरी रही दी। तूह भाल़ आप्पै कि तैहा नगरी लै किज़ै हुअ ज़हा लै तेरी नगरी बोला। इहअ निं आथी कि हाम्हैं आसा धर्मीं अर तै आसा हाम्हैं ताह सेटा अरज़ करदै लागै दै। हाम्हैं करा ताह सेटा अरज़ किल्हैकि तूह आसा खास्सअ झणैल़ू। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />ए म्हारै मालक, ज़ीबाण, म्हारी अरज़ शुण! मालक, ज़ीबाण, हाम्हां लै छ़ाड माफी! तूह कर तिहअ ज़ेही हाम्हैं ताह सेटा अरज़ किई अर ईंयां गल्‍ला लोल़ी छ़ेक्‍कै पूरी बी हुई! ताकि लोग तेरअ अदर करे। अह नगरी अर ऐहा नगरीए लोग आसा तेरै।”<verse eid="DAN 9:19" /></para>
  <para style="s">गब्रीएल स्वर्ग दूतै खोज़ी आजू हणीं ईंयां गल्‍ला पूरी</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />हुंह रहअ एही अरज़ करदअ लागी अर मंऐं मनी अह गल्‍ल आपणैं मालक बिधाता सेटा कि मंऐं किऐ पाप अर मेरै भाई-बंध इज़राईली बी किऐ पाप। मंऐं किई आपणैं परमेशर बिधाता सेटा लेर-पकार एही अरज़ कि सह आपणीं पबित्र धारा एरुशलेम नगरी भिई खल़ी करे। <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />हुंह त इना गल्‍ला बिधाता सेटा बोल्दअ लागअ द अर मुखा शुझुअ गब्रीएल नाओं स्वर्ग दूत आप्पू बाखा लै उंधै एछदअ। अह त सह ई ज़ुंण मुखा पैहली बारी सुपनै दी शुझुअ त। तेऊ बाहअ उपरा का कोहरअ डैअ मुंह बाखा लै। सह त सान्हां बिधाता लै नाज़ बल़ी भैंट करनैओ बगत।<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूक. 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />सह लागअ मुल्है बोल्दअ, “दानिएल, हुंह आअ इधी ताल्है सोर अर समझ़ दैंदअ।<verse eid="DAN 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 9:23" />“तूह त लेर-पकार पाई परमेशरा सेटा अरज़ करदअ लागअ द, तेऊ हेरी तेरी अरज़ शूणीं। सह झ़ूरा ताल्है खास्सअ अर तैही आसा हुंह ताह सेटा लै तेऊओ समाद खोज़दअ आअ द। तूह शूणैं मेरी गल्‍ला धैन दैई ताकि ताह समझ़ एछे कि ज़ुंण ताह धैन हुअ, तेतो किज़ै मतलब आसा। <verse eid="DAN 9:23" /><verse number="24" style="v" sid="DAN 9:24" />बिधाता आसा तम्हां अर थारी नगरीए सज़ा खतम करना लै बगत डाहअ द। ज़ेभै सात साला सत्तर बारी<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="fq" closed="false">सात साला सत्तर बारी </char><char style="ft" closed="false">490 साला </char></note> निभी जाणीं, तेखअ हणीं तिन्‍नें पापे सज़अ खतम। तेखअ निं लोगा बिधाता का दूर हणअ। तिन्‍नें पाप हणैं माफ अर तेखअ हणअ इहअ नसाफ ज़ुंण सदा रहणअ। ताकि गूरै खोज़ी दी गल्‍ला अर धैनै-सुपनै भाल़ी दी गल्‍ला तेही ई निभे। बिधाते पबित्र भबने प्रतिष्ठा बी हणीं भिई।<verse eid="DAN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 9:25" />“दानिएल, हुंह च़ाहा इहअ कि तूह ऐहा गल्‍ला समझ़े कि ज़हा घल़ी एरुशलेम नगरी भिई च़िणनेओ हुकम ज़ारी हणअ, अर ज़ेभै बिधाता अभिषेक किअ द राज़अ एछणअ, तेभै जाणीं सात साला सत्तर बारी निभी। तेता बाद निभणी सात साला बाहठा बारी होर, इना एतरी साला हणीं घोर आफ़त, एऊ ज़मानै च़िणनी एरुशलेम नगरी भिई अर तेथ हणीं भिई तेही ई बाता-च़फै अर फेर उछ़टअ गहल़। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />अह बगत ज़ांऊं खतम हणअ, तेभै पाणअ परमेशरै अभिषेक किअ द बाझ़ी कशूरै राज़अ मारी। एक बलबान राज़अ एछणअ इहअ कि तेऊ करनी एरुशलेम नगरी अर पबित्र भबन ढोल़ी बरैबाद। तेऊ पल़णअ तिन्‍नां लै बडै दरैऊआ ज़िहै चुटी संघा करनै झ़ट च़ारै खतम। अह जुध रहणअ खिरी तेभै तैणीं हंदअ लागी ज़ुंण बगत परमेशरै एता लै डाहअ द आसा।<verse eid="DAN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 9:27" />“तेता बाद करनी तेऊ राज़ै खास्सै लोगा संघै साता साले करार पाक्‍की, ज़ांऊं साढै चअन साला निभी जाणीं, तेऊ करनै बिधाते भबनै बल़ीदान अर भैंट करनी बंद। तेऊ डाहणीं बिधाते पबित्र भबनै छ़ोतली मुहुर्ती ज़ेता घोर आफ़त पाणीं। सह रहणीं खिरी तेभै तैणीं तिधी ज़ेभै तैणीं सह बनाश करनै आल़ै राज़ैओ परमेशर बनाश करे। तेऊओ बनाश हणअ तेभै ज़ुंण धैल़ी परमेशरै आसा काढी दी।”<note caller="-" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">दान. 11:31</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मोत्त. 24:15</ref>; <ref loc="MRK 13:14">मार्क. 13:14</ref></char></note><verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दजला गाडे बारै सुपनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस देशै बणअ कुस्रू माहा राज़अ। तेऊए राज़ा दी चिऊथी साला किई परमेशरै दानिएला का धैनै-सुपनै एक गल्‍ल प्रगट। दानिएला नाअं त बेलतेशर बी। सह ती शुची गल्‍ल अर एही कि आजू हणअ एक घोर जुध। दानिएला हुअ एक सुपनअ अर तेता करै आई तेऊ सह गल्‍ल समझ़। <verse eid="DAN 10:1" /><verse number="2" style="v" sid="DAN 10:2" />दानिएलै आसा तिन्‍नां धैल़ै तेते बारै इहअ लिखी डाहअ द:</para>
  <para style="p" vid="DAN 10:2">“हुंह त तिन्‍नां धैल़ै चिई हबतै तैणीं शोग करदअ बेठअ द। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />मंऐं नां खास भोज़ खाअ, नां शिखा खाई अर नां दाखो रस झुटअ। ज़ेभै तैणीं चअन हबतै निं बितै, तेभै तैणीं निं मंऐं घेरी अर मुंडै तेल बी मल़अ।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />“तैहा साल च़ौबी च़ैत्रै त हुंह दजला नाओंए दरैऊए बाढै खल़्हुअ द। <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />हुंह लागअ उझै भाल़अ अर मुखा शुझुअ इहअ कि तेऊ आसा बाछे झिकल़ै अर कुछी आसा च़ोखै उपाज़ देशे च़ोखै सुन्‍नैं करै बणाईं दी गाची बान्हीं दी।<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">प्रका. 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:12">19:12</ref></char></note> <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />तेऊए देही ती पेरोज़ नाओंए किम्मती मणीं ज़ेही। तेऊए मुंहां का थिअ धुप्पै ज़िहअ झ़ामण लागअ द। तेऊए आछी ती ज़ल़दी आगी ज़ेही। तेऊए ज़ांघा-बाहा ती कांस्सै ज़ेही। गल्‍ला करदअ ज़ाण्हिंआं त सह इहअ कि खास्सै लोग आसा ज़ोरै-ज़ोरै हाल्‍लै पांदै लागै दै।<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 1:14">प्रका. 1:14</ref></char></note><verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />“ईंयां गल्‍ला शुझुई धैनै-सुपनै सिधी मुंह दानिएला का। तिधी मुंह संघै ज़ुंण होर मणछ थिऐ, तिन्‍नां का निं इहअ किछ़ शुझुअ। पर तिन्‍नां छ़ुटी डरै काम्मणीं अर तिंयां ठुर्है तिधा का दूर संघा रहै किधी लुक्‍की। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />खिरी रहअ हुंह एऊ महान धैनै-सुपनै भाल़अ एक्‍कै। मुंह निं आप्पू बी तराण ई रहै, मेरी बधल़ूई मुंहाशण एही कि मुंह निं कुंण बछ़ैणीं सकदअ त। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />ज़ांऊं मुखा तेऊ मणछो बैण शुण्हुंअ, हुंह बधल़ुअ धरनीं उटी बाखा अर मुंह निं होश-बाश ई रही। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />तेखअ छ़ुंहंअ हुंह कुंण हाथा करै संघा बशैल़अ हुंह मेरै हाथ अर ज़ान्हूंए बला दी। मुंह ती हाथै अर ज़ान्हूं दी काम्मणीं छ़ुटी दी।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />“तेऊ स्वर्ग दूतै बोलअ मुल्है इहअ, ‘भाई दानिएल, परमेशर झ़ूरा ताल्है खास्सअ। खल़अ उझ़ू संघा शुण मेरी गल्‍ला धैन दैई ज़ुंण मंऐं ताखा खोज़ी लाई। हुंह आसा ताह सेटा लै छ़ाडअ द।’ ज़ांऊं तेऊए इना गल्‍ला बाद हुंह खल़अ, उझ़ुअ, पर हुंह त तज़ी बी काम्बदअ लागअ द।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />“तेखअ बोलअ तेऊ मुल्है इहअ, ‘दानिएल, तूह निं डरै आथी। ज़धू पैहली धैल़ी तूह सोर-समझ़ मांगणा लै परमेशरा सेटा अरज़ करदअ लागअ अर सोभै गल्‍ला आपणैं परमेशरा का सभाल़ी, तधू ई हेरी तेरी अरज़ स्वर्गै शूणीं। हुंह आसा तेतो ज़बाब दैंदअ आअ द। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारसी राज़ा प्रैंदै राज़ करनै आल़ै स्वर्ग दूतै डाहअ हुंह इक्‍की धैल़ै तैणीं रोक्‍की, तै निं हुंह तधू एछी सकअ। तेखअ आअ मिकाईल ज़ुंण परमेशरे प्रधान स्वर्ग दूता मांझ़ै एक आसा, तेऊ किई मेरी मज़त अर सह आसा मंऐं फारसी राज़ा प्रैंदै राज़ करनै आल़ै स्वर्ग दूता संघै मकाबलै करदअ तिधी डाहअ द।<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">प्रका. 12:7</ref></char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />हुंह आअ ताखा तिन्‍नां गल्‍ला समझ़ाऊंदअ ज़ुंण तेरै लोगा लै आजू हणीं। ज़ुंण ताखा धैनै-सुपनै शुझुअ, तिंयां गल्‍ला आसा ज़ुंण आजू हणीं।’<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />“ज़ेभै तेऊ ईंयां गल्‍ला बोली, मंऐं किअ उंधै उटअ मूंड संघा रहअ च़ुप्पी खल़्हुई। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />सह स्वर्ग दूत ज़ुंण हेरनअ मणछा ज़िहअ आसा थिअ, तेऊ छ़ुंहैं मेरै होठ। तेखअ बोलअ मंऐं तेऊ लै, ‘मालक, एऊ धैनै-सुपनै करै हुअ हुंह खास्सअ दुबल़अ, हुंह आसा एता का खास्सअ डरअ द। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />हुंह आसा गलामा ज़िहअ ज़ुंण आपणैं मालका सेटा आसा खल़्हुअ द। हुंह किहअ करै सका ताह संघै गल्‍ला करी? मुंह निं नां मुंह एतरअ ज़ोर आथी रहअ द अर नां एतरअ शाह आथी रहअ द।’<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />“सह ज़ुंण मणछा ज़िहअ शुझिआ त, तेऊ छ़ुंहंअ हुंह भिई, तेखअ आई मुंह धख तनक। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />तेऊ बोलअ इहअ, ‘परमेशर झ़ूरा ताल्है खास्सअ, तूह निं किछ़ी गल्‍ला का डरी नां हैअ चोल़ी।’</para>
  <para style="p" vid="DAN 10:19">“ज़ांऊं तेऊ इहअ बोलअ, मुखा ज़ाण्हुंअ आप्पू दी कि मुंह फिरै तराण। तेखअ बोलअ मंऐं तेऊ लै, ‘मालक, ऐबै खोज़ मुखा, तूह किज़ै बोला। तंऐं हेरै मुंह दी भिई तराण पाई।’<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="ISA 41:10">ईशा. 41:10</ref></char></note><verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="DAN 10:20-21" />“तेऊ बोलअ इहअ, ‘हुंह खोज़ूं ताखा कि हुंह ताह सेटा लै किज़ू आसा आअ द। तिंयां गल्‍ला बी समझ़ाऊंणी मुंह ताखा बाढै ज़ुंण परमेशरे सत्ते कताबा दी आसा लिखी दी। पर एभै हुअ मुंह फारसी राज़ा प्रैंदै राज़ करनै आल़ै स्वर्ग दूता संघै जुधा करदै बापस डेऊणअ। तेऊ का ज़िती करै निखल़णअ यूनानी राज़ा प्रैंदै राज़ करनै आल़अ स्वर्ग दूत, तेता लै सका मेरी मज़त सिधअ मिकाईल करी ज़ुंणीं तेरै लोगे फाज़त करा। तेऊ का सुआई निं तिधी मुंह संघै परमेशरे दुशमणा संघै मकाबलै करदअ कोह आथी।’”<verse eid="DAN 10:20-21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />तेऊ स्वर्ग दूतै बोलअ मुल्है इहअ, “ज़धू दारा बाबेल देशो राज़अ बणअ, तेऊए राज़ा दी पैहली साला दैनअ त मंऐं मिकाईल स्वर्ग दूतो साथ, मंऐं किअ त तेऊ बाखा तेऊए दुशमणा संघै जुध। <verse eid="DAN 11:1" /><verse number="2" style="v" sid="DAN 11:2" />ऐबै लाअ मंऐं ताखा सत्त खोज़ी कि आजू किज़ै हणअ।”</para>
  <para style="s" vid="DAN 11:2">स्वर्ग दूतो दानिएला लै समाद</para>
  <para style="p" vid="DAN 11:2">तेखअ बोलअ स्वर्ग दूतै, “फारसी राज़ा दी करनअ चिई राज़ै राज़, ज़ुंण च़ौथअ राज़अ एछणअ, सह हणअ तिन्‍नां चिई का खास्सअ सेठ। तेता करै हणअ सह खास्सअ बलबान। तेखअ डाहणैं होर देश बी ज़गाऊई कि तिंयां यूनानी राज़ा संघै जुध छ़ेल़े।<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />“तेखअ निखल़णअ एक होर राज़अ, सह हणअ खास्सअ जोधअ। तेऊ बढेरनअ आपणअ राज़ सारै दी अर तेऊ करनअ ज़िहअ तेऊए दिल बोलअ तिहअ। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />पर ज़ांऊं सह खास्सअ बलबान हणअ, तेऊए राज़ा दी पल़णीं फूट अर सह हणअ च़ऊ बाखा लै। आजू निं तेऊए आद-लुआदो मांझ़ै राज़अ बणनअ नां तिंयां तेऊ ज़िहै जोधै हणैं ज़िहअ सह आसा त।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“तेखअ हणअ दखण रेगीस्ताना बाखा मिसर देशो राज़अ खास्सअ बलबान। पर तेऊए सैनापति मांझ़ै हणअ एक ज़ण्हअ तेऊ का बी खास्सअ बलबान अर तेऊ करनअ नऊंअ राज़ खल़अ अर सह राज़ हणअ खास्सअ बडअ। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />खास्सी साला बाद करनी दखणा बाखा मिसर देशे राज़ै, उतरा बाखा सिरीया देशे राज़ै संघै आपणीं सैना साझ़ू। मिसर देशे राज़ै करनअ आपणीं शोहरीओ बैह सिरीया देशे राज़ै संघै ताकि तिन्‍नों साथ शुचअ-पाक्‍कअ रहे। पर सह साझ़ निं खास्सी च़लणीं, तैहा शोहरीओ हक बी छ़ुटणअ तैहा का पोर्ही, नां तेसो मर्ध राज़अ रहणअ। सह शोहरी, तेसो मर्ध, तेसे शोहरू माठै अर तेसे च़ाकरी लै तैहा संघा डेऊऐ दै दास-दासी पाणै कहा सोभ मारी।<verse eid="DAN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7" />“तेखअ निखल़णअ तैहा शोहरीए आद-लुआदा मांझ़ै एक राज़अ। तेऊ पल़णअ सिरीया देशे राज़ेए सैना लै चुटी। तेऊ डेऊणअ संघा करनअ सिरीया देशे राज़े गहल़ा दी कबज़अ संघा पाणअ सह हारी। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तिन्‍नें देअ-देबते मुहुर्ती अर तिन्‍नें देअए देहुरै सुन्‍नैं-च़ंदीए किम्मती भांडै निंणै तेऊ राज़ै मिसर देशा लै। तेखअ निं तेऊ कई साला तैणीं उतरा बाखा सिरीया देशा संघै जुध करनअ। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />सिरीया देशे राज़ै छ़ेल़णअ दखण दिशा दी मिसर देशा संघै जुध पर खिरी पल़णअ तेऊ पिछ़ू हटी आपणैं देशा लै बापस फिरनअ।<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />“तेखअ छ़ेल़णअ सिरीया देशे राज़ेए सोभी शोहरू जुध। तिन्‍नां झाल़णीं जुधा लै बडी भारी खास्सी सैना। तिन्‍नें सह सैना च़लणीं जुधा लै बडै दरैऊआ ज़ेही। तिन्‍नां पल़णअ दुशमणे बडै-बडै गहल़ा लै चुटी। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />दखणा बाखा मिसर देशे राज़ै एछणी एता लै खास्सी रोश्शै। तेऊ निखल़णअ आपणीं बडी सैना पाई उतर सिरीया देशा संघै जुधा लै। सिरीया देशा का बी हणीं बडी सैना पर मिसर देशे राज़ै हेरनअ सह जुध तिन्‍नां का ज़िती। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />मिसर देशे राज़ै हणअ एतो घमंड कि सह ज़ितअ सिरीया देशे एतरी बडी सैना का अर तेऊ पाऐ तिन्‍नें सैना मांझ़ै खास्सै मारी। पर सह ज़ीत रहणीं तेऊए थोल़ी घल़ी लै।<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />“सिरीया देशे राज़ै झाल़णीं पैहलै का बी खास्सी बडी सैना। थोल़ी साला बाद डेऊणअ तेऊ खास्सै अस्त्र-शस्त्रा पाई आपणीं बडी सैना संघी मिसर देशा संघै जुधा लै। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />तेऊ ज़मानै करनअ दखण मिसर देशै राज़ै लै कई द्रोह। तम्हां इज़राईली मांझ़ै ज़ुंण उपद्रभी हणैं, तिन्‍नां बी करनअ द्रोह। इहअ करै हणअ अह सुपनअ पूरअ ज़ुंण तंऐं भाल़अ। तिन्‍नां करनअ तेऊ संघै जुध पर तिंयां निं सफल हणैं। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />उतर बाखा सिरीया देशो राज़ै डेऊणअ दखण मिसर देशा संघै जुधा लै बडी सैना पाई। तेऊ दैणअ एकी बडी गहल़ा आल़ी नगरी फेर गोट संघा करनअ तेथ कबज़अ। मिसर देशे सैना हणअ तेऊओ मकाबलअ करनअ कठण। तिन्‍नें सैना मांझ़ै ज़ुंण सोभी का बडअ जोधअ बी हणअ, तेऊ बी निं सिरीया देशे सैना संघै मकाबलै जोगी ज़ोर हणअ। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />सिरीया देशे राज़ै करनअ तिन्‍नां संघै ज़िहअ तेऊओ मन्‍न किअ तिहअ। तेऊओ मकाबलअ निं कोही बोल़णअ करी। सह डेऊणअ तेऊ रज़दै-पज़दै बित्तै देशा बाती संघा करनअ तेथ कबज़अ।<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />“तेखअ झाल़णीं उतर देशे राज़ै आपणीं सारी सैना कि सह दखण बाखा सारै मिसर देशै राज़ करे। तेता लै करनी तेऊ मिसर देशा संघै सुल्हअ अर तेऊ करनअ आपणीं शोहरीओ बैह बी मिसर देशे राज़ै संघै। पर अह च़ाल बी निं तेऊए सफल हणीं।<verse eid="DAN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 11:18" />“एता बाद छ़ेल़णअ तेऊ तिन्‍नां देशा संघै जुध ज़ुंण मांझ़ समुंदरे बाढै आसा बस्सै दै। तिन्‍नां मांझ़ै करनअ तेऊ कई नगरी दी कबज़अ। पर होरी देशे सैनापति पाणअ सह जुधा दी हारी अर तेखअ हणीं तेऊए शरेरी गल्‍ला खतम अर सह हणअ शर्मिंदअ। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तेखअ फिरनअ सह बापस कि आपणैं देशै गहल़ा आल़ी नगरी पुजे। पर सह पाणअ पठी हारी अर इहअ करै हणअ सह अर तेऊओ राज़ खतम।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“तेऊ बाद बणअ उतर सिरीया देशै एक होर राज़अ। तेऊ छ़ाडणैं आपणैं अफसर लोगा हंतदै कि तिंयां लोगा का खास्सअ कारअ झाल़े अर तेऊए राज़ खज़ानै दी खास्सै ढब्बै कठा होए। सह राज़अ हेरनअ तेतरी मारी। पर इहअ निं हणअ कि सह मारअ जुधा दी, नां इहअ हणअ कि लोग तै तेऊ का नराज़, तै पाअ सह मारी।<verse eid="DAN 11:20" /></para>
  <para style="s">सिरीया देशो नर्दैई राज़अ</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />“ज़ुंण उतर देशै सिरीया एऊ राज़ै बाद राज़गाद्दी दी बेशणअ, सह हणअ खास्सअ नर्दैई। सह निं राज़ परिबारे खिंबा का हणअ, तैही निं सह राज़अ बणअ तेऊए बशै हणअ। पर सह बणनअ लोगा ठगी करै राज़अ। ईंयां गल्‍ला हणीं तेऊ ज़मानै ज़ेभै लोग निहंचै हणैं कि तिंयां आसा राज्ज़ी-राम्बल़ै। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />ज़ुंण बी तेऊ संघै मकाबलै लै एछे, तेऊ करनै तिंयां झ़ट च़ारै खतम। तेऊ पाणै परमेशरो बधान सखाऊंणै आल़ै सैणैं तोही मारी। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />ज़ुंणीं देशै तेऊ संघै मेल़-ज़ोल़े करार बी होए किई दी, तिन्‍नां संघै बी करनअ तेऊ धोखअ। सह हणअ होर बी खास्सअ बलबान, पर तेऊओ राज़ हणअ होछ़ै ज़िहै देशा प्रैंदै। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />ज़ुंण मुल्ख सेठ हणैं, तिन्‍नां लै पल़णअ तेऊ नभैऊशै चुटी। तेऊ राज़ै करनै इहै-इहै काम ज़ुंण तेऊए दाद-बाब बी कधि निं करदै तै। ज़हा दुशमणा संघै बी सह जुध छ़ेल़े, तेऊ लुटणीं तिन्‍नें किम्मती च़िज़ा पठी संघा बांडणी तिन्‍नां संघै ज़ुंण तेऊओ जुधा लै साथ दैनअ। सह रहणअ बडी-बडी गहल़ा आल़ी नगरी दी कबज़ै करने बारै सोठदअ लागी। पर तेऊओ अह बगत जाणअ छ़ेक्‍कै खतम हई।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“उतर सिरीया देशे तेऊ नर्दैई राज़ै झाल़णीं खास्सी बडी सैना कि सह दखण मिसर देशा संघै जुध छ़ेल़े। पर मिसर देशे राज़ै का हणीं तेऊए मकाबलै करना लै तेऊ का बी खास्सी बलबान सैना। पर तज़ी बी निं सह सिरीया देशे राज़ै का जुध ज़ितणअ, किल्हैकि तेऊ लै हणैं तेऊए आपणैं ई लोग द्रोही। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />तेऊओ सोभी का खास बज़ीर ज़ुंण तेऊ संघा खाआ-पिआ, सह बी रहणअ तेऊ मारदअ ताखुई। सिरीया देशे नर्दैई राज़ै पाणीं तेऊए खास्सी सैना जुधा दी मारी अर ज़खमी करी।<verse eid="DAN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 11:27" />“तेखअ बेशणै सिरीया अर मिसर देशे ईंयां दुहै राज़ै खांदै-पिंदै कठा। पर दिलै हणीं तिन्‍नैं बूरी ई सोठ डाही दी। तिन्‍नां करनी दुही एकी-दुजै संघै झ़ुठी ई गल्‍ला। पर ज़िहअ तिंयां च़ाहा, तिहअ निं हणअ। किल्हैकि तिन्‍नों राज़ खतम हणैंओ आसा परमेशरै बगत डाहअ द। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />तेखअ डेऊणअ सिरीया देशो राज़अ आपणैं देशा लै फिरी। तेऊ निंणीं लुटी दी कई किम्मती च़िज़ा आप्पू संघै। पर फिरदा पाणीं तेऊ परमेशरो बधान मनणै आल़ै लोगा लै आफ़त। तेऊ करनअ तिन्‍नां संघै ज़िहअ तेऊओ दिल बोलअ तिहअ बभार। संघा पुजणअ सह आपणैं देशै बापस।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“बादा का डेऊणअ सह भिई दखण मिसर देशा संघै जुधा करदअ, पर तैहा बारी तेऊ जुधो नतिज़अ निं तेऊ लै तिहअ हणअ ज़िहअ पिछ़ली बारी हुअ त। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />समुंदरे बाढै बस्सै दै कित्ती<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="fq" closed="false">कित्ती </char><char style="ft" closed="false">रोमी</char></note> लोगे समुंदरे ज़हाज़ा करै जुधा करदी सैना एछणी दखण रेगीस्तानै तेऊए मकाबलै करदी अर तिन्‍नां डरै फिरनअ सह आपणैं देशा लै बापस। बापस फिरदा काढणअ तेऊ सह रोश्श परमेशरो बधान मनणै आल़ै लोगा लै। तेऊए सलाहकार हणैं तिंयां ज़ुंणी परमेशरो बधान मनणअ छ़ाडअ। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />तेऊ छ़ाडणअ आपणीं सैनो दल एरुशलेम नगरीए गहल़ा लै। तिन्‍नां करनी बिधाते भबनै पबित्र ज़ैगा पेशी सह छ़ोतली। तिन्‍नां लाणीं बिधाता लै बल़ीदान अर भैंट करना लै रोक ज़ेता लोग हर धैल़ै करा। तिन्‍नां डाहणीं तेथ च़िल़्हखरी मुहुर्त ज़ेता करै सह ज़ैगा उज़र पल़णीं।<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दान. 9:27</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मोत्त. 24:15</ref>; <ref loc="MRK 13:14">मार्क. 13:14</ref></char></note> <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />तेऊ राज़ै ठगणै तिंयां लोग ज़ुंणी पापा दी पल़ी परमेशरो बधान मनणअ छ़ाडी आसा हेरअ द। पर ज़ुंण लोग परमेशरा लै शुचै-पाक्‍कै रहणैं, तिन्‍नां करनी तेऊ रोक्‍कणा लै खास्सी मैन्थ।<verse eid="DAN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 11:33" />“ज़हा मणछा अक्ल हणीं, तिन्‍नां समझ़ाऊंणैं होर लोग बी। पर थोल़ी साला हणीं तिन्‍नां लै खास्सी आफ़त। तिन्‍नां मांझ़ै पाणै कई जुधा दी मारी अर कई पाणै आगी जैंदरी दहई अर कई डाहणैं कैद करी। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />ज़ांऊं सारै दी एही काट-मार हणीं मच़ी दी, तेखअ जाणीं परमेशरे लोगा थोल़ी मज़त भेटी। तिन्‍नां संघै ज़ुल़णै कई ठग लोग, असली दी निं तिंयां तिन्‍नें साथी हणैं। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />अक्ली आल़ै सैणैं मांझ़ै बी पाणै कई मारी, पर एतो नतिज़अ निखल़णअ इहअ कि लोगे हणीं शुधी। अह रहणअ खिरी तेभै तैणीं हंदअ लागी ज़ुंण बगत परमेशरै डाहअ द आसा।<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />“सिरीया देशे राज़ै करनअ ज़िहअ तेऊओ दिल बोलअ तिहअ बभार। तेऊ करनी एही शरेरी गल्‍ला कि सह आसा सोभी देअआ का बडअ! तेऊ बोल़णअ इहअ तोही कि सह आसा परमेशरा का बी बडअ। सह रहणअ खिरी तेभै तैणीं इहअ करदअ लागी ज़ेभै तैणीं कि परमेशर तेऊ लै सज़ा नां दैए। परमेशरा करनअ ज़ाथी तिहअ ई ज़िहअ तेऊ सोठी आसा डाहअ द।<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="2TH 2:3">2 थिस. 2:3</ref>,<ref loc="2TH 2:4">4</ref>; <ref loc="REV 13:5">प्रका. 13:5</ref>,<ref loc="REV 13:6">6</ref></char></note> <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />तेऊ राज़ै निं तिन्‍नां देअए बी परबाह करनी ज़हा तेऊए दाद-बाब पूज़ा तै। नां आपणीं बेटल़ीए कुल़ज देअ अदर करनअ ज़ेता लै तिंयां बेटल़ी झ़ूरा। तेऊ निं कोह देअ-देबी किछ़ समझ़णैं, किल्हैकि तेऊ सोठणअ इहअ कि सह आसा सोभी का बडअ। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />इना छ़ाडी करनअ तेऊ तिन्‍नां अदर देअ ज़ुंण गहल़ा-कोटे फाज़त करा। तेऊ करनअ सुन्‍नअ-च़ंदी, ढब्बै अर होर किम्मती मणीं तिन्‍नां देअआ लै भैंट ज़सरी पूज़ा-गाज़ा तेऊए दादै-बाबै बी निं कधू किई। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />आपणैं गहल़े फाज़त करना लै डाहणैं तेऊ तिंयां लोग ज़ुंण परदेसी देअआ मना। तेऊ दैणी तिन्‍नां लै खास्सी इज़त ज़ुंण तेऊ राज़अ मने अर तिन्‍नां लै दैणीं तेऊ बडी-बडी पदबी अर बस्सणा लै ज़ैगा-ज़िम्मीं।<verse eid="DAN 11:39" /></para>
  <para style="s">नर्दैई राज़ेए मौत</para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“ज़ांऊं सिरीया देशे राज़ेए मरने घल़ी पुजणीं, दखण दिशा दी मिसर देशे राज़ै छ़ेल़णअ तेऊ संघै जुध, अर सिरीया देशे राज़ै करनअ आपणैं खास्सै रथ, घोल़ै अर कई पाणींए ज़हाज़ा आल़ी सैना करै पूरअ ज़ोर लाई तेऊओ मकाबलअ। तेऊ छ़ेल़णअ कई देशा संघै जुध, तेऊए सैना डेऊणी कई देशा बाती पाणींए बडै दरैऊआ ज़ेही। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />तेऊ पल़णअ थारै रज़दै-पज़दै शोभलै देशा<note caller="+" style="f"><char style="fr" closed="false">11:41 </char><char style="fq" closed="false">देशा </char><char style="ft" closed="false">इज़राईल देश</char></note> लै बी चुटी, तेथ पाणै तेऊ कई हज़ार लोग मारी। पर एदोम, मोआब अर अमोन देश जाणैं तेऊए बनाशा का बच़ी।<verse eid="DAN 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="DAN 11:42" />“इहअ करै पल़णअ सह कई देशा लै चुटी अर मिसर देश बी निं तेऊ का छ़ुटणअ आथी। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />तेऊ लुटणीं मिसर देशे च़ंदी, सुन्‍नअ अर सोभ किम्मती च़िज़ा। लिबिया अर कूश देशे लोगा प्रैंदै बी करनअ तेऊ राज़। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />तेखअ एछणी तेऊ लै पुर्ब अर उतर दिशा बाखा एही खबर कि तेऊ छ़ुटणअ तेता शूणीं दर्छ़णअ। तेऊ रोश्शै डेऊणअ तेऊ आपणीं सैना पाई संघा पाणै खास्सै लोग मारी। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />तेऊ करनै समुंदर अर पबित्र धारा मांझ़ा-मांझ़ी आपणैं राज़ दरबारो खिम्भ खल़अ। पर सह मरनअ तिधी अर तिधी निं तेऊ बच़ाऊंणै आल़अ बी हणअ।”<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">संसार खतम हणें बारै</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />तेखअ बोलअ तेऊ स्वर्ग दूतै मुल्है इहअ ज़ुंणी बाछे झिकल़ै तै बान्हैं दै, <note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="REV 12:7">प्रका. 12:7</ref></char></note>“तेखअ एछणअ मिकाईल ज़ुंण परमेशरो महान स्वर्ग दूत आसा। सह आसा तिन्‍नां प्रैंदै प्रधान सैनापति ज़ुंण स्वर्ग दूत तेरै लोगे फाज़त करा। ज़ेभै सह प्रगट हणअ, तेभै हणीं खास्सी आफ़त। थारअ देश बणनैं ओर्ही तैहा धैल़ी तैणीं निं तेही आफ़त कधि पल़ी। पर थारै आपणैं लोगा मांझ़ै जाणैं कई लोग तैहा आफ़ता का बच़ी। ईंयां बच़णैं तिंयां ई ज़सरै नाअं परमेशरे कताबा<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">कताबा </char><char style="ft" closed="false">जंतरी</char></note> दी आसा दर्ज़ किऐ दै।<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">मोत्त. 24:21</ref>; <ref loc="MRK 13:19">मार्क. 13:19</ref>; <ref loc="REV 7:14">प्रका. 7:14</ref>; <ref loc="REV 12:7">12:7</ref></char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />कई ज़ुंण मरी हणैं गऐ दै, तिंयां हणैं भिई। कोऐ भेटणीं सदा लै ज़िन्दगी अर कोऐ हणैं सदा लै शर्मिंदै।<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">ईशा. 26:19</ref>; <ref loc="MAT 25:46">मोत्त. 25:46</ref>; <ref loc="JHN 5:29">जोह. 5:29</ref></char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />ज़ुंण अक्ली आल़ै मणछ होए तिन्‍नां का लागणअ सरगे तारै ज़िहअ च़लकार। ज़ुंणीं धर्मीं सोभी का धर्म करनअ सखाऊअ, तिंयां बी च़मकणै सदा तिहै ई।<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="MAT 13:43">मोत्त. 13:43</ref></char></note><verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />“दानिएल, तूह डाह ऐहा कताबा दी सील लाई एता बुदरी, अह निं संसार खतम हणैं तैणीं कोही लोल़ी खोल्ही। कई लोगा करनी इना गल्‍ला समझ़णें कोशिश, तिन्‍नां दैणीं एतो थोघ करना लै सारै दी हांढा कि आजू किज़ै च़ाल्‍लअ हई।”<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">प्रका. 22:10</ref> </char></note><verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />ज़ांऊं स्वर्ग दूत इना गल्‍ला खोज़ी मुक्‍कअ, हुंह दानिएल लागअ उझै भाल़अ। मुखा शुझुऐ दूई होर मणछ। एक त दरैऊआ आर बाखा ज़िधी हुंह त, अर दुजअ त दरैऊआ पार बाखा।<verse eid="DAN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 12:6" />तिन्‍नां मांझ़ै लागअ एक ज़ण्हअ तेऊ स्वर्ग दूता संघै गल्‍ला करदअ ज़ुंणीं बाछे झिकल़ै थिऐ बान्हैं दै, ज़ुंण ऐबै दरैऊआ प्रैंदै त खल़्हुअ द, “इना नुआहरै कामां पूरै हणां लै केतरअ बगत लागणअ।”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />तेखअ ज़ुंण बाछे झिकल़ै बान्हअ द स्वर्ग दूत दरैऊआ प्रैंदै त खल़्हुअ द, तेऊ किऐ आपणैं हाथ उझै सरगा बाखा लै खल़ै। मंऐं शूणअ सह सदा ज़िऊंदै परमेशरे सोह खाई इहअ बोल्दअ, “ईंयां गल्‍ला रहणीं साढै चिई साला तैणीं हंदी लागी, तेखअ हणअ परमेशरे परज़े दुशमणो बल खतम अर ईंयां गल्‍ला जाणीं निभी मुक्‍की।”<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5-7">प्रका. 10:5-7</ref>; <ref loc="REV 12:14">12:14</ref></char></note><verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />मंऐं शूणअ सह इहअ बोल्दअ पर मुंह निं समझ़ पल़ी कि अह तेऊ किज़ै बोलअ। तेखअ पुछ़अ मंऐं सह स्वर्ग दूत, “मालक, खिरी इना गल्‍लो कै नतिज़अ निखल़णअ।”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />तेऊ दैनअ ज़बाब, “दानिएल, एभै डेऊ तूह इधा का, ईंयां गल्‍ला डाहणीं तेभै तैणीं गुप्त ज़ेभै तैणीं संसार खतम हणैंओ बगत निं एछे। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />ज़ेभै आफ़त पल़णीं, तेभै हणीं खास्सै लोगे शुधी। पर कदुष्ट मणछ रहणैं कबल्‍लै बूरअ ई करदै लागी, तिन्‍नां निं ईंयां गल्‍ला समझ़ एछणी। ज़हा अक्ल हणीं, तिन्‍नां जाणीं ईंयां गल्‍ला समझ़ एछी।<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">प्रका. 22:11</ref></char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />“ज़ेभै पबित्र भबनै धैल़ हणैं आल़ै हूम बल़ीदान करना लै रोक लागणीं अर पबित्र ज़ैगा बनाश करनै आल़ी च़िल़्हखरी मुहुर्त डाहणीं स्तापी, तैहा धैल़ी पोर्ही निभणी एक हज़ार दूई शौ नबै धैल़ी।<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दान. 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">मोत्त. 24:15</ref>; <ref loc="MRK 13:14">मार्क. 13:14</ref></char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />तिन्‍नां मणछा लै दैणी परमेशरा बर्गत ज़ुंण एक हज़ार चअन शौ पैंईंती धैल़ी निभणैं तैणीं शुचै-पाक्‍कै रहे!<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“दानिएल, तूह रहै खिरी तैणीं शुचअ-पाक्‍कअ। तूह जाणअ मरी पर संसार खतम हणें बेला हणअ तूह भिई ज़िऊंदअ। तेखअ जाणी ताह सह नांम भेटी ज़ुंण ताल्है परमेशरै तेरै हेस्सै आसा डाही दी।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>