  <para style="h">जोएल</para>
  <para style="toc1">जोएल गूरै खोज़ी दी गल्‍ला</para>
  <para style="toc2">जोएल</para>
  <para style="toc3">जोए.</para>
  <para style="mt1">जोएल</para>
  <para style="mt2">जोएल गूरै खोज़ी दी गल्‍ला</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जोएल</para>
  <para style="ili">सन: 835 का 600 ईसा आजी</para>
  <para style="ip">जोएल थिअ बिधातो गूर। तेऊए बारै निं खास्सअ थोघ आथी। जोएल खोज़ा आप्पै कि सह आसा पतूएलो शोहरू अर तेऊ खोज़अ यहूदा मुल्खे परज़ा लै कि तिन्‍नां लै आजू किज़ै हणअ। ऐहा कताबा दी लागा हाम्हां का थोघ कि जोएल गूरा आसा एरुशलेम नगरीओ खास्सअ फिकर, तेऊ आसा बिधाते भबनै च़ाकरी करनै आल़ै प्रोहते बारै बी गल्‍ला खोज़ी दी, तेता का लागा थोघ कि सह त बिधाते भबने च़ाकरी करने बिधी-बधानो बी खास्सअ ज़ाणकार।</para>
  <para style="ip">तेऊ ज़मानै त फारसी राज़। तेऊ ज़मानै छ़ाडै तै फारसी राज़ै थोल़ै यहूदी तिन्‍नें देशा लै बापस अर एरुशलेम हेरअ त बिधातो भबन भिई च़िणीं अर जोएल गूर बी ज़ाणा त बिधाते भबने बारै पठी।</para>
  <para style="ip">जोएल गूरा का शुझुअ सुपनै कि इज़राईल मुल्खै भर्हुऐ सारै दी रैट्टै ई रैट्टै अर तिन्‍नैं किई साल-फसल पठी बरैबाद। तिन्‍नां रैट्टैओ मतलब त इहअ कि आजू करनअ दुशमण सैना इज़राईल देशै बनाश। पर अह निं खास्सी बडी गल्‍ल आथी ती, एता का बडी गल्‍ल थिई एही कि तैहा धैल़ी किज़ै हणअ ज़ेभै बिधाता नसाफ करनअ। तेभै लागणअ सोभी देशा बिधाता सेटा खल़ै हणअ अर ज़ुंण बी तिन्‍नें लोगै किअ तेतो फल भुगतणअ। ज़ुंण दोशी निखल़े, तिन्‍नां भेटणीं घोर सज़ा।</para>
  <para style="imq">“फैंसलै करने खागै आसा हज़ारो-लाखों लोग झाल़्हुऐ दै! तिंयां आसा तिधी आऐ दै कि सह धैल़ी गई एछी ज़ेभै बिधाता नसाफ करनअ। तेभै फिरनअ सुरज़ अर ज़ोथ न्हैरै, अर तारै दी निं किछ़ च़मक रहणीं। बिधाता पाणीं सियोन धारा का क्रुंगा, एरुशलेम नगरी का शुण्हनै तेऊए बोल गुल़ूबिज़ल़ू ज़िहै। तेता करै हणीं सारै भ्रमंडै ज़ाज़री, पर बिधाता करनी आपणीं परज़े फाज़त, सह हणअ तिन्‍नां लै उछ़टै गहल़ा ज़िहअ ज़ेथ पिछ़ू इज़राईली शरण लआ।”</para>
  <para style="ipr">(3:14-16)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">रैट्टै अर दुशमणे सैना 1:1—2:17</para>
  <para style="io1">बिधाता दैणीं आपणीं परज़ा लै बर्गत 2:18-32</para>
  <para style="io1">बिधाता दैणी सोभी देशा लै सज़ा 3:1-21</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />बिधाता दैनअ पतूएले शोहरू जोएल गूरा का आपणीं परज़ा लै अह समाद:<verse eid="JOL 1:1" /></para>
  <para style="s">रैट्टै किअ सारै देशै बनाश</para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />“सैणैंओ, शूणां! मेरी गल्‍ला दी दैआ धैन,</para>
  <para style="q" vid="JOL 1:2">यहूदा मुल्खे सोभ लोग शूणां कि हुंह किज़ै बोला।</para>
  <para style="q" vid="JOL 1:2">थारी ज़िऊंदी ज़िता निं आझ़ तैणीं कधि इहअ हुअ!</para>
  <para style="q" vid="JOL 1:2">नां थारै दादा-बाबे ज़मानै कधू इहअ हुअ।<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />ऐहा आफ़ते बारै डाहा आपणैं शोहरू-माठै का खोज़ी अर</para>
  <para style="q" vid="JOL 1:3">तिन्‍नैं लोल़ी आजू आपणैं शोहरू-माठै का खोज़अ अर</para>
  <para style="q" vid="JOL 1:3">तिंयां खोज़ै आजू तिन्‍नां बाद एछणैं आल़ी पोस्ती का।<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />ज़ुंण साल-फसल कतोच़ी करै खाणैं आल़ै रैट्टे छ़ुंढा का छ़ुटी,</para>
  <para style="q" vid="JOL 1:4">तेता खांदै आऐ बडै डैअ दैणैं आल़ै रैट्टे छ़ुंढ!</para>
  <para style="q" vid="JOL 1:4">ज़ुंण डैअ दैणैं आल़ै रैट्टै का छ़ुटी, तेता लै आऐ पटिक्‍कल़ै दैणैं आल़ै रैट्टे छ़ुंढ,</para>
  <para style="q" vid="JOL 1:4">ज़ुंण तिन्‍नां का बच़अ तेता लै आऐ च़लोऊई करै खाणैं आल़ै रैट्टे छ़ुंढ।<verse eid="JOL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />शराबीओ! खल़ै उझ़िआ, संघा लाआ ऐबै लेरा,</para>
  <para style="q" vid="JOL 1:5">तम्हैं दाखे रसा झुटणैं आल़ै लाआ हिक्‍का-पटाक्‍की लेरा,</para>
  <para style="q" vid="JOL 1:5">दाखे फसल हुई पठ बरैबाद ज़ेता का नऊंअ दाखो रस काढणअ त।<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />रैट्टे सैना पल़ी म्हारै देशे ज़ैगा लै चुटी,</para>
  <para style="q" vid="JOL 1:6">तिंयां रैट्टै आसा बलबान अर खास्सै ज़ेता कुंण गणी निं सकदअ,</para>
  <para style="q" vid="JOL 1:6">तिन्‍नें दांद आसा सिहा ज़िहै लाम्मै अर दाल़्हा आसा सिहणीं ज़ेही।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 9:8">प्रका. 9:8</ref></char></note><verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />तिन्‍नैं रैट्टै किऐ म्हारै दाखे बाग पठी बरैबाद</para>
  <para style="q" vid="JOL 1:7">अर म्हारै फेडूए बूट कतोच़ै पठी!</para>
  <para style="q" vid="JOL 1:7">तिन्‍नैं शोटै डाल़ा-बूटे तरोल़ै च़लोऊई करै धरनीं</para>
  <para style="q" vid="JOL 1:7">अर तेते शाण्हीं किई शेती अर पठ बरैबाद।<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />कुंआरी शोहरी ज़िहअ करा शोग ज़ुंणीं शोग करना लै खिंथल़ै आसा बान्हैं दै,</para>
  <para style="q" vid="JOL 1:8">किल्हैकि सह शोहरू मूंअ ज़हा संघै तेसे बरनीं ती लाई दी।<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />बिधाते भबनै हूम करना लै निं कोह नाज़ आणदै,</para>
  <para style="q" vid="JOL 1:9">नां अर्घै दैणा लै दाखो रस भैंट करदै,</para>
  <para style="q" vid="JOL 1:9">बिधाते च़ाकरी करनै आल़ै प्रोहत आसा खास्सअ शोग पल़अ द।<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />खेच आसा शुक्‍कै-रुखै अर शणैहतै पल़ै दै,</para>
  <para style="q" vid="JOL 1:10">नाज़ हुअ पठी बरैबाद, दाखे बेला मछैंईं गोधी का,</para>
  <para style="q" vid="JOL 1:10">जैतूने तेला काढणा लै बूट बी शुक्‍कै ज़ात पठी।<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />कृषाणो, लेरा लाआ, तम्हैं हआ दुखी ज़ुंण तम्हैं दाखे बागे फाज़त करा,</para>
  <para style="q" vid="JOL 1:11">किल्हैकि ज़ौ कणका संघी हुई सारी साल-फसल बरैबाद।<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />दाखे बेला अर फेडूए बूट मछैंऐं पठी,</para>
  <para style="q" vid="JOL 1:12">नारदाणैं, खज़ूर, सेओए बूट अर सोभ डाल़-बूट शुक्‍कै पठी।</para>
  <para style="q" vid="JOL 1:12">सोभी मणछे मुंह आसा फिकै पल़ै दै।<verse eid="JOL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />घेरी बान्हां खिंथल़ै संघा लाआ हिक्‍का पटाक्‍की लेरा!</para>
  <para style="q" vid="JOL 1:13">बेदीए च़ाकरी करनै आल़ै प्रोहतो!</para>
  <para style="q" vid="JOL 1:13">बिधाते पबित्र भबनै डेऊई रहा सारी राची घेरी खिंथल़ै बान्हीं शोगा दी बेठी।</para>
  <para style="q" vid="JOL 1:13">किल्हैकि परमेशरा लै निं ऐबै कोह हूम करना लै नाज़ अर अर्घै लै दाखो रस भैंट करदअ।<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />सोभी लै बोला इहअ कि ब्रतू रहा, सोभ करा झाल़अ!</para>
  <para style="q" vid="JOL 1:14">यहूदा सारै देशा का झाल़ा सोभी सैणैं अर सोभी लोगा</para>
  <para style="q" vid="JOL 1:14">परमेशर बिधाते भबना लै, संघा पाआ तेऊ सेटा लेर-पकार।<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />बिधाते सह धैल़ी गई ऐबै पुजी, ज़हा धैल़ी</para>
  <para style="q" vid="JOL 1:15">तेऊ बिधाता बनाश करनअ ज़हा का सारअ बल आसा।</para>
  <para style="q" vid="JOL 1:15">सह धैल़ी भाल़ा केही डरैऊंणी हणीं।<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 13:6">ईशा. 13:6</ref></char></note><verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />हाम्हैं भाल़ी आपणीं आछी आपणीं खाणें-पिणें च़िज़ा बरैबाद हंदी!</para>
  <para style="q" vid="JOL 1:16">म्हारै परमेशरे भबनै बी निं ऐबै खुशी रही।<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />खेचै शुक्‍कअ माट्टे भेल्‍ली हेठै बेज़अ पठी,</para>
  <para style="q" vid="JOL 1:17">खहल़ आसा शुन्‍नैं अर खुडी आसा नाज़ा बाझ़ी रित्ती,</para>
  <para style="q" vid="JOL 1:17">किल्हैकि साल-फसल हुई पठ बरैबाद।<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />डागै बी आसा धकदै लागै दै,</para>
  <para style="q" vid="JOL 1:18">किल्हैकि तिन्‍नां निं खाणां लै किछ़ घाह आथी,</para>
  <para style="q" vid="JOL 1:18">भेडा-बाकरीए हेल़्ही लै बी आसा भुखै आफ़त पल़ी दी।<verse eid="JOL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />ए बिधाता, हुंह पाआ ताह सेटा लेर-पकार,</para>
  <para style="q" vid="JOL 1:19">किल्हैकि घाहे घैहणीं अर डाल़-बूट शुक्‍कै पठी,</para>
  <para style="q" vid="JOL 1:19">तेथ आसा ज़ेही आग शाची दी।<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />बणें ज़ीब बी आसा भुखै-नचिशै, तिंयां बी आसा तेरै आसरै,</para>
  <para style="q" vid="JOL 1:20">किल्हैकि गाडा-नाल़ी शुक्‍की पठी, बणें घाहे घैहणीं बी दझ़ी ऐहा आगी दी।<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">ईंयां रैट्टै आसा चतैनगी</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />सियोन धारा बाज़ा नर्शिंगै!</para>
  <para style="q" vid="JOL 2:1">पबित्र धारा बस्सै दै मणछा लै दैआ चतैनगी!</para>
  <para style="q" vid="JOL 2:1">यहूदा मुल्खै बस्सै दै सोभी लोगा लोल़ी दर्छ़णअ छ़ुटअ,</para>
  <para style="q" vid="JOL 2:1">किल्हैकि बिधाते धैल़ी आई नेल़, सह धैल़ी गई पुजी।<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />तैहा धैल़ी हणअ नटिप्प न्हैरअ!</para>
  <para style="q" vid="JOL 2:2">तैहा धैल़ी घोर्हनै घणैं काल़ै बादल़।</para>
  <para style="q" vid="JOL 2:2">एक बडी सैना एछणी, तिन्‍नां करै हणीं धार भरी,</para>
  <para style="q" vid="JOL 2:2">ज़िहअ दोत्ती धुप्पअ धारा छिंघिआ।</para>
  <para style="q" vid="JOL 2:2">एतरी खास्सी सैना निं पैहलकै ज़मानै बी कधि भाल़ी अर</para>
  <para style="q" vid="JOL 2:2">नां आजू एछणैं आल़ी कोही पोस्ती दी कधू हणीं।<verse eid="JOL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />तिन्‍नैं पाऐ आगी ज़िहै डाल़ी-बुटी खाई।</para>
  <para style="q" vid="JOL 2:3">तिन्‍नां आजू आसा ज़ैगा अदने बागा ज़ेही अर</para>
  <para style="q" vid="JOL 2:3">तिन्‍नां पिछ़ू हआ सह ज़ैगा उज़र रेगीस्ताना ज़ेही।</para>
  <para style="q" vid="JOL 2:3">तेथ निं तिन्‍नां का किछ़ छ़ुटदअ।<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />तिंयां शुझिआ घोल़ै ज़िहै अर</para>
  <para style="q" vid="JOL 2:4">तिंयां ठुर्हा जुधे घोल़ै ज़िहै छ़ेक्‍कै।<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="REV 9:7-9">प्रका. 9:7-9</ref></char></note><verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />धारा तिन्‍नें छ़ाहल़ा दैणें छ़ेल़ ज़ाण्हिंआं खास्सै रथा घुर्हनै ज़ेही,</para>
  <para style="q" vid="JOL 2:5">अर आगीए बडै कूंडा दी चटराल़्हदी झ़ुका ज़ेही।</para>
  <para style="q" vid="JOL 2:5">तिंयां ज़ाण्हिंआं बडी भारी खास्सी सैना ज़िहै ज़ुंण जुधा लै हआ तैर्हुई दी।<verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />ज़हा बी देशा का तिंयां शुझिआ, तिन्‍नां छ़ुटा दर्छ़णअ,</para>
  <para style="q" vid="JOL 2:6">सोभिए मुंह फिरा तिन्‍नां भाल़ी न्हैरै!<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />तिंयां पल़ा जोधै ज़िहै चुटी, अर सपाही ज़िहै उखल़ा तिंयां गहल़ा प्रैंदा लै।</para>
  <para style="q" vid="JOL 2:7">तिंयां रहा एकी लगैगा दी हांढदै लागी।</para>
  <para style="q" vid="JOL 2:7">तिंयां निं आपणीं लगैगा छ़ाडी ओर्ही-पोर्ही डेऊंदै अर<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />नां तिंयां एकी-दुजै लै धाक्‍कअ दैंदै।</para>
  <para style="q" vid="JOL 2:8">तिंयां रहा सोभ आज़रै हांढदै लागी।</para>
  <para style="q" vid="JOL 2:8">तिन्‍नां आजू ज़ै किज़ै शस्त्र बी डाहे,</para>
  <para style="q" vid="JOL 2:8">तज़ी बी रहा तिंयां एकी लगैगा दी आज़रै हांढदै लागी।<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />नगरी दी पल़ा तिंयां सारै दी चुटी।</para>
  <para style="q" vid="JOL 2:9">तिंयां ठुर्हा गहल़े दुआली प्रैंदै,</para>
  <para style="q" vid="JOL 2:9">तिंयां उखल़ा उझै घअरे भित्ती बाती संघा डेओआ</para>
  <para style="q" vid="JOL 2:9">च़ोरा-डाकू ज़िहै ताकि बाती भितरा लै।<verse eid="JOL 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />तिन्‍नां आजू हआ धरती दी ज़ाज़री,</para>
  <para style="q" vid="JOL 2:10">सुरज़ अर ज़ोथ फिरा न्हैरी अर तारे च़मक मुक्‍का पठी।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 8:12">प्रका. 8:12</ref></char></note><verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />बिधाता दैआ आजू का आपणीं सैना लै हुकम ज़ेही गुल़ूबिज़ल़ूए छ़ेल़ हआ।</para>
  <para style="q" vid="JOL 2:11">सैना ज़ुंण बिधातो हुकम मना, तिंयां आसा एतरी खास्सी ज़ेता कुंण गणी निं सकदअ।</para>
  <para style="q" vid="JOL 2:11">बिधाते सह धैल़ी भाल़ा केही बलबान अर डरैऊंणी हणीं।</para>
  <para style="q" vid="JOL 2:11">तैहा धैल़ी निं कोह ज़िरी सकदअ।<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 6:17">प्रका. 6:17</ref></char></note><verse eid="JOL 2:11" /></para>
  <para style="s">बिधाता करा झींण</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />बिधाता बोला इहअ, ‘ब्रतू रही, लेरा लांदी अर</para>
  <para style="q" vid="JOL 2:12">शोग करदी फिरा मुंह सेटा लै तत्त दिला का बापस।<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />सिधै घेरीए झिकल़ै धेल़ी निं दुख रहैऊंदै लागा,</para>
  <para style="q" vid="JOL 2:13">मुखा लोल़ी शुझुअ कि तम्हैं आसा दिला का दुखी।’</para>
  <para style="q" vid="JOL 2:13">आपणैं परमेशर बिधाता बाखा फिरा!</para>
  <para style="q" vid="JOL 2:13">सह आसा खास्सअ झ़ूरनै अर झींण करनै आल़अ।</para>
  <para style="q" vid="JOL 2:13">सह करा सबर अर आपणीं ज़बान करा सह पूरी।</para>
  <para style="q" vid="JOL 2:13">सह निं झ़ट च़ारै रोश्श करदअ, हाम्हां लै आफ़त पल़दी भाल़ी हआ सह बी दुखी।<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />झ़ाणीं बिधाता माल़ी च़ेती हेरे अर आपणीं सोठ बदल़े अर</para>
  <para style="q" vid="JOL 2:14">तम्हां लै खास्सी बर्गत दैए?</para>
  <para style="q" vid="JOL 2:14">तेखअ सका तम्हैं तेऊ लै नाज़ो हूम करी अर अर्घअ दैई।<verse eid="JOL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />सियोन धारा बाज़ा नर्शिंगै, सोभी लोगा लै बोला ब्रतू रहा,</para>
  <para style="q" vid="JOL 2:15">सोभै करा आपणीं शुधी संघा करा बिधाता सेटा झाल़अ!<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />सारी परज़ो करा झाल़अ,</para>
  <para style="q" vid="JOL 2:16">तिन्‍नां सोभिए करा पबित्र सभा करना लै शुधी।</para>
  <para style="q" vid="JOL 2:16">सोभी सैणैं शादा, सोभी शोहरू माठै बी शादा अर</para>
  <para style="q" vid="JOL 2:16">च़ूई झुटणैं आल़ै लान्हैं बी आणा शादी।</para>
  <para style="q" vid="JOL 2:16">सोभी मर्धा-बेटल़ी आणा तिन्‍नें घअरा का शादी</para>
  <para style="q" vid="JOL 2:16">च़ाऐ ज़सरअ बैह एभै पै होए हुअ द, तिंयां बी एछा सोभ आपणैं घअरा का।<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />प्रोहत ज़ुंण भबने प्रऊल़ी अर बेदी मांझ़ै खल़्हुई बिधाते च़ाकरी करा,</para>
  <para style="q" vid="JOL 2:17">तिंयां लाऐ ज़रूर लेरा संघा करै एही अरज़,</para>
  <para style="q" vid="JOL 2:17">‘बिधाता, हाम्हां तेरी परज़ा लै कर झींण!</para>
  <para style="q" vid="JOL 2:17">हाम्हां निं होरी देशा जैंदरी हास्सणां अर सुहांगा लै दैई हणैं कि तिंयां हाम्हां लै बोले,</para>
  <para style="q" vid="JOL 2:17">“थारअ परमेशर आसा किधी?”’<verse eid="JOL 2:17" /></para>
  <para style="s">बिधाता दैआ ज़ैगा-ज़िम्मीं लै भिई बर्गत</para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />तेखअ दैणअ बिधाता आपणीं ज़ैगा लै धैन</para>
  <para style="q" vid="JOL 2:18">अर तेऊ करनी आपणीं परज़ा लै झींण।<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />बिधाता दैणअ आपणीं परज़ा लै ज़बाब अर तेऊ बोल़णअ इहअ,</para>
  <para style="q" vid="JOL 2:19">‘ऐबै लाई मंऐं तम्हां लै नाज़, दाखे रस अर जैतूने तेले एही खास्सी बर्गत दैई कि</para>
  <para style="q" vid="JOL 2:19">तम्हैं दैणैं मुंह तेता करै रज़ैऊई।</para>
  <para style="q" vid="JOL 2:19">ऐबै निं आजू तम्हैं होरी देशा जैंदरी कधि शर्मिंदै हणैं।<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />उतर दिशा बाखा आऐ दै रैट्टे सैना करनी मुंह तम्हां सेटा का दूर,</para>
  <para style="q" vid="JOL 2:20">तिंयां दरल़ाऊंणै मुंह शुक्‍कै अर शुन्‍नैं रेगीस्ताना लै,</para>
  <para style="q" vid="JOL 2:20">तिन्‍नों आगलअ दल डबेऊंणअ मुंह खार समुंदरै अर</para>
  <para style="q" vid="JOL 2:20">पिछ़लअ दल डबेऊंणअ मुंह मांझ़ समुंदरै।</para>
  <para style="q" vid="JOL 2:20">तिन्‍नें ल्हासा का लागणीं बास्स-शल़ैन्ह,</para>
  <para style="q" vid="JOL 2:20">किल्हैकि मंऐं बिधाता किऐ बडै महान काम!<verse eid="JOL 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />मेरअ देश! तूह निं डरी आथी, तूह मनाऊं खुशी अर नंद,</para>
  <para style="q" vid="JOL 2:21">ज़ुंण मंऐं बिधाता महान काम किऐ, तेता लै रह तूह निहंचै।<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />बणें ज़ीबो, तम्हैं बी निं डरी आथी।</para>
  <para style="q" vid="JOL 2:22">घैहणीं जाणअ हरअ घाह लागी,</para>
  <para style="q" vid="JOL 2:22">डाल़ा-बूटा दी जाणै फल़ लागी,</para>
  <para style="q" vid="JOL 2:22">दाख अर फेडू हणैं बतेर्है।<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />सियोन बस्सै दै लोगो, तम्हैं हआ तेता लै खुश</para>
  <para style="q" vid="JOL 2:23">ज़ुंण तम्हां लै मंऐं थारै परमेशर बिधाता किअ।</para>
  <para style="q" vid="JOL 2:23">मंऐं बरशाऊअ तम्हां लै ज़ेतरअ लोल़ी तेतरअ पाणीं।</para>
  <para style="q" vid="JOL 2:23">मंऐं दैनअ पैहलै ज़िहअ हिंऊंद अर भराल़ हणैं।<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />थारी ताटी हणीं नाज़ा करै भरी,</para>
  <para style="q" vid="JOL 2:24">दाखे रसा अर जैतूने तेला करै रहणीं कोफरी टिरा बहूंदी।<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />ज़ेतरी साला मेरी डैअ दैणैं आल़ी, पटिक्‍कल़ै दैणैं आल़ी,</para>
  <para style="q" vid="JOL 2:25">करोप्पी अर च़लोऊई करै खाणैं आल़ी मेरी रैट्टे सैना थारी साल-फसल खाई,</para>
  <para style="q" vid="JOL 2:25">सह दैणीं मुंह तम्हां लै दुगणीं बापस।<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />ऐबै हणीं तम्हां का ज़िणस बतेर्ही अर रज्ज़ी खाणां लै।</para>
  <para style="q" vid="JOL 2:26">तम्हां करनअ मेरअ आपणैं परमेशर बिधातो शूकर अर ज़ै-ज़ैकार</para>
  <para style="q" vid="JOL 2:26">ज़ुंणी तम्हां लै नुआहरै काम किऐ।</para>
  <para style="q" vid="JOL 2:26">ऐबै निं मेरी परज़ा कधि बेइज़त हणीं।<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />तेखअ लागणअ तम्हां इज़राईली का थोघ कि हुंह आसा तम्हां जैंदरी,</para>
  <para style="q" vid="JOL 2:27">हुंह आसा बिधाता अर हुंह ई आसा परमेशर</para>
  <para style="q" vid="JOL 2:27">अर मुखा सुआई निं होर कोह आथी।</para>
  <para style="q" vid="JOL 2:27">तेखअ निं मेरी परज़ा कधि बेइज़त हणीं।<verse eid="JOL 2:27" /></para>
  <para style="s">बिधाते धैल़ी</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:28 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:17-21">शधा. 2:17-21</ref>
      </char>
    </note>इना गल्‍ला हणैं बाद दैणीं मुंह आपणीं आत्मां सोभी लै,</para>
  <para style="q" vid="JOL 2:28">थारै शोहरू-शोहरी करनी मेरी गल्‍ला प्रगट,</para>
  <para style="q" vid="JOL 2:28">थारै प्रोढै मणछा हणैं सुपनै</para>
  <para style="q" vid="JOL 2:28">अर ज़ुआन मणछा हणैं धैन।<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />तेऊ ज़मानै ज़ुंण दास अर दासी बी होए,</para>
  <para style="q" vid="JOL 2:29">तिन्‍नां लै बी दैणीं मुंह आपणीं आत्मां।<verse eid="JOL 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />सरगै अर धरती दी करनै मुंह चतैनगी दैणा लै च़मत्कार,</para>
  <para style="q" vid="JOL 2:30">मुंह छ़ाडणैं लोहू, आग अर धूँए बादल़।<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />ज़ेभै मुंह बिधाते सह महान अर डरैऊंणी धैल़ी एछणी,</para>
  <para style="q" vid="JOL 2:31">सुरज़ फिरनअ न्हैरअ अर ज़ोथ हणीं लोहू ज़ेही लाल।<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="MAT 24:29">मोत्त. 24:29</ref>; <ref loc="MRK 13:24">मार्क. 13:24</ref>,<ref loc="MRK 13:25">25</ref>; <ref loc="LUK 21:25">लूक. 21:25</ref>; <ref loc="REV 6:12">प्रका. 6:12</ref>,<ref loc="REV 6:13">13</ref></char></note><verse eid="JOL 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />तेभै ज़ुंण बी मुंह बिधाता का मज़त मांगे, सह जाणअ बच़ी,</para>
  <para style="q" vid="JOL 2:32">ज़िहअ मंऐं बिधाता आसा बोलअ द कि</para>
  <para style="q" vid="JOL 2:32">एरुशलेम नगरी का जाणैं थोल़ै बच़ी,</para>
  <para style="q" vid="JOL 2:32">ज़ुंण मंऐं आसा छ़ांटै दै, तिंयां रहणैं ज़िऊंदै।’”<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ROM 10:13">रोम. 10:13</ref></char></note><verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">बिधाता करनअ देशो नसाफ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />बिधाता बोला इहअ, “ज़ेभै मुंह यहूदा मुल्ख अर</para>
  <para style="q" vid="JOL 3:1">एरुशलेम नगरी भिई भरपूर करनै,<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />तेभै करनै मुंह सोभ देश कठा,</para>
  <para style="q" vid="JOL 3:2">संघा पजैल़णैं मुंह जहोशापात खागै।</para>
  <para style="q" vid="JOL 3:2">तिधी करनअ मुंह तेता लै तिन्‍नों नसाफ</para>
  <para style="q" vid="JOL 3:2">ज़ुंण तिन्‍नैं मेरी परज़ा इज़राईली संघै किअ।</para>
  <para style="q" vid="JOL 3:2">तिन्‍नैं दरल़ाऊई ती मेरी परज़ा देशा-देशा जैंदरी</para>
  <para style="q" vid="JOL 3:2">अर मेरै देशै बी पाई ती तिन्‍नैं फूट।<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />तिन्‍नैं पाई मेरी परज़ा बांडणां लै परच़ी</para>
  <para style="q" vid="JOL 3:3">कि मेरी परज़ा मांझ़ै कुंण ज़ण्हअ हणअ तिन्‍नों गलाम।</para>
  <para style="q" vid="JOL 3:3">कंज़रैई करना अर नशिलै दाखे रसा लै बेच़ै तिन्‍नैं मेरी परज़ा मांझ़ै शोहरू-शोहरी।<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 23:1-18">ईशा. 23:1-18</ref>; <ref loc="EZK 26:1-28:6">एज. 26:1—28:6</ref>; <ref loc="AMO 1:9">आम. 1:9</ref>,<ref loc="AMO 1:10">10</ref>; <ref loc="ZEC 9:1-4">जक. 9:1-4</ref>; <ref loc="MAT 11:21">मोत्त. 11:21</ref>,<ref loc="MAT 11:22">22</ref>; <ref loc="LUK 10:13">लूक. 10:13</ref>,<ref loc="LUK 10:14">14</ref></char>
    </note>“सूर अर सदोन नगरीए लोगो! पलिश्ती देशे लोगो! तम्हैं मुल्है किज़ू करदै आसा लागै दै? तम्हैं कै मुल्है मेरै कामों बदल़अ लाअ दैई? ज़ै इहअ आसा, तै दैंऊं हुंह थारै कामों बदल़अ झ़ट च़ारै तम्हां लै बापस! <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />तम्हैं निंयं मेरअ सुन्‍नअ-च़ंदी अर मेरअ किम्मती खज़ानअ संघा डाही तिंयां च़िज़ा आपणैं कई देहुरै दी। <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />तम्हैं किऐ यहूदा मुल्ख अर एरुशलेम नगरीए लोग तिन्‍नें आपणैं देशा का दूर संघा बेच़ै यूनानी<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fq" closed="false">यूनानी </char><char style="ft" closed="false">ज़ाबणे आद-लुआद</char></note> लोगा का। <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />ज़ेथ-ज़ेथ देशै तम्हैं तिंयां बेच़ै दै आसा, ऐबै लाऐ मंऐं तिंयां तेता का बापस आणी। ज़िहअ तम्हैं मेरी परज़ा लै किअ, तिहअ ई लाअ मंऐं ऐबै तम्हां लै करी। <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />थारै शोहरू-शोहरी पाणै मुंह यहूदा मुल्खे लोगा का बेच़ी। तिन्‍नां पाणै तिंयां सदूर देशे लोगा का बेच़ी ज़ुंण खास्सअ दूर आसा। अह गल्‍ल डाही मंऐं बिधाता बोली।<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">ईशा. 14:29-31</ref>; <ref loc="JER 47:1-7">जेर. 47:1-7</ref>; <ref loc="EZK 25:15-17">एज. 25:15-17</ref>; <ref loc="AMO 1:6-8">आम. 1:6-8</ref>; <ref loc="ZEP 2:4-7">सप. 2:4-7</ref>; <ref loc="ZEC 9:5-7">जक. 9:5-7</ref></char></note><verse eid="JOL 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9" />देशा-देशा का खोज़ा इहअ समाद,</para>
  <para style="q" vid="JOL 3:9">‘जुधा लै तैर्हिआ, जोधै लै पाआ हाक्‍का,</para>
  <para style="q" vid="JOL 3:9">आपणीं सारी सैना झाल़ा संघा लागा जुधा लै हांढदै!<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:4">ईशा. 2:4</ref>; <ref loc="MIC 4:3">मिक. 4:3</ref></char>
    </note>आपणैं हल़े लुहाल़ा गाल़ी बणाआं तलबारा,</para>
  <para style="q" vid="JOL 3:10">दाची गाल़ी करै बणाआं बर्छ़ै, बाख दुबल़अ मणछ बी बोलै,</para>
  <para style="q" vid="JOL 3:10">“हुंह आसा जोधअ।”’<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />फेर-फिरदै देशो! छ़ेक्‍कै एछा,</para>
  <para style="q" vid="JOL 3:11">तेऊ खागै हआ कठा।”</para>
  <para style="q" vid="JOL 3:11">बिधाता, आपणैं जोधै छ़ाड तिधा लै!<verse eid="JOL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />बिधाता बोला इहअ, “देशा-देशे मणछो, उझ़िआ,</para>
  <para style="q" vid="JOL 3:12">संघा डेओआ जहोशापात खागा लै।</para>
  <para style="q" vid="JOL 3:12">तिधी हणअ हुंह बिधाता नसाफ करदअ बेठअ द।</para>
  <para style="q" vid="JOL 3:12">मुंह करनअ तिधी फेर-फिरदै सोभी देशो नसाफ।<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />तिंयां आसा खास्सै कदुष्ट,</para>
  <para style="q" vid="JOL 3:13">तिन्‍नां काटा धरनीं ज़िहअ फसल पाक्‍की करै नाज़ दाची करै लऊआ।</para>
  <para style="q" vid="JOL 3:13">तिन्‍नां पिल्‍ला कोफरी दाखा ज़िहै ज़ेभै तैणीं दाखा का रस पठी निं निखल़अ।”<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:14-16">प्रका. 14:14-16</ref>; <ref loc="REV 19:15">19:15</ref>,<ref loc="REV 19:19">19</ref>,<ref loc="REV 19:20">20</ref></char></note><verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />फैंसलै करने खागै आसा हज़ारो-लाखों लोग झाल़्हुऐ दै!</para>
  <para style="q" vid="JOL 3:14">तिंयां आसा तिधी आऐ दै कि सह धैल़ी गई एछी</para>
  <para style="q" vid="JOL 3:14">ज़ेभै बिधाता नसाफ करनअ।<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />तेभै फिरनैं सुरज़ अर ज़ोथ न्हैरै,</para>
  <para style="q" vid="JOL 3:15">अर तारैओ झ़ामण मुक्‍कणअ पठी।<verse eid="JOL 3:15" /></para>
  <para style="s">बिधाता दैणीं आपणीं परज़ा लै बर्गत</para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:2">आम. 1:2</ref>
      </char>
    </note>बिधाता पाणीं सियोन धारा का क्रुंगा,</para>
  <para style="q" vid="JOL 3:16">एरुशलेम नगरी का शुण्हनै तेऊए बोल गुल़ूबिज़ल़ू ज़िहै।</para>
  <para style="q" vid="JOL 3:16">तेता करै हणीं सारै भ्रमंडै ज़ाज़री, पर बिधाता करनी</para>
  <para style="q" vid="JOL 3:16">आपणीं परज़े फाज़त, सह हणअ तिन्‍नां लै उछ़टै गहल़ा ज़िहअ</para>
  <para style="q" vid="JOL 3:16">ज़ेथ पिछ़ू इज़राईली शरण लआ।<verse eid="JOL 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />बिधाता बोला इहअ, “तेखअ लागणअ तम्हां इज़राईली का थोघ कि</para>
  <para style="q" vid="JOL 3:17">हुंह आसा बिधाता ज़ुंण थारअ परमेशर आसा।</para>
  <para style="q" vid="JOL 3:17">हुंह रहा आपणीं पबित्र सियोन धारा।</para>
  <para style="q" vid="JOL 3:17">एरुशलेम हणीं पबित्र नगरी अर एथ निं ऐबै कधि परदेसीओ कबज़अ हणअ।<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />तेऊ ज़मानै हणीं धारा दाखे बागा करै भरी,</para>
  <para style="q" vid="JOL 3:18">धारठी हणीं हर ज़ैगा गाऊई, अर पाणीं हणअ यहूदा मुल्खै बतेर्हअ।</para>
  <para style="q" vid="JOL 3:18">बिधाते भबना का निखल़णीं गाड अर</para>
  <para style="q" vid="JOL 3:18">तेता करै दैणअ शितीम खागै पाणीं।<verse eid="JOL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />मिसर देश हणअ शुन्‍नअ रेगीस्तान,</para>
  <para style="q" vid="JOL 3:19">एदोम देश हणअ पठी उज़र, किल्हैकि</para>
  <para style="q" vid="JOL 3:19">तिंयां पल़ै तै यहूदा मुल्खा लै चुटी अर</para>
  <para style="q" vid="JOL 3:19">तिन्‍नैं किई ती नर्दोश मणछे हत्या।<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />यहूदा मुल्ख रहणअ सदा आबाद,</para>
  <para style="q" vid="JOL 3:20">एरुशलेम नगरी रहणीं मेरी परज़ा पोस्ती दर पोस्ती सदा।<verse eid="JOL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21" />ज़ुंणीं-ज़ुंणी देशै तिन्‍नें हत्या किई,</para>
  <para style="q" vid="JOL 3:21">तिन्‍नां का लणअ मुंह ज़रूर बदल़अ।</para>
  <para style="q" vid="JOL 3:21">तिन्‍नें हत्या करनैओ पाप निं हुंह माफ करदअ।</para>
  <para style="q" vid="JOL 3:21">मुंह बिधाता बस्सणअ सियोन धारा।”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>