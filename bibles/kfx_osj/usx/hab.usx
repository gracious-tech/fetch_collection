  <para style="h">हबकूक</para>
  <para style="toc1">बिधातो गूर हबकूक</para>
  <para style="toc2">हबकूक</para>
  <para style="toc3">हब.</para>
  <para style="mt1">हबकूक</para>
  <para style="mt2">बिधातो गूर हबकूक</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: हबकूक</para>
  <para style="ili">सन: 612 का 605 ईसा आजी</para>
  <para style="ip">ऐहा कताबे पैहलै दूई धैअ खोज़ा हबकूक अर बिधाते हुई दी गल्‍ले बारै। हबकूक खोज़ा बिधाता का खरी कि यहूदा मुल्खै आसा ज़ुल्म अर पाप भर्हुअ द। बिधाता दैआ ज़बाब कि तेऊ लाऐ बाबेल देशे सैना यहूदा मुल्खा लै सज़ा दैंदी छ़ाडी। तेखअ खोज़ा हबकूक एही खरी कि अह हणीं बेनसाफी किल्हैकि बाबेल देशे लोग तै यहूदा मुल्खे परज़ा का होर बी खास्सै पाप अर ज़ुल्म करनै आल़ै! तेखअ खोज़ा बिधाता कि बाबेल देशा बी लागणीं सज़ा भुगतणी।</para>
  <para style="ip">हबकूक सोठा त इहअ कि परमेशरै ज़ुंण आप्पू लै आसा छ़ांटै दै, तिन्‍नां निं सह तिन्‍नें दुशमणे हाथै कष्ट भुगतणै दैंदअ। पर परमेशर दैआ तेऊ लै ज़बाब संघा करा तेऊओ विश्वास पाक्‍कअ। ऐहा कताबो मकसद आसा इहअ कि मणछे फाज़त करनै आल़अ आसा बिधाता अर ज़ुंण बिधाते आसरै रहे, तिन्‍नां डाहा बिधाता बच़ाऊई:</para>
  <para style="imq">“कदुष्ट मणछ हणैं खतम, पर धर्मीं मणछ रहणैं तिन्‍नें विश्वासा करै ज़िऊंदै।”</para>
  <para style="ipr">(2:4)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">हबकूके बिधाता सेटा खरी 1:1—2:20</para>
  <para style="io1">हबकूके बिधाता सेटा अरज़ 3:1-19</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />अह आसा बिधातो समाद ज़ुंण बिधाता हबकूक गूरा का धैनै खोज़अ। हबकूक बोला बिधाता का इहअ,<verse eid="HAB 1:1" /></para>
  <para style="s">हबकूक गूरै खोज़ी बिधाता का खरी</para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />“ए बिधाता, हुंह केभै तैणीं रहूं ताखा</para>
  <para style="q" vid="HAB 1:2">लेर-पकार पाई मज़त मांगदअ लागी? ताह केभै तैणीं निं मेरी शुणनी?</para>
  <para style="q" vid="HAB 1:2">हुंह रहअ ज़ोरै-ज़ोरै बोल्दअ, ‘ज़ुल्म हुअ, ज़ुल्म हुअ!’</para>
  <para style="q" vid="HAB 1:2">तूह निस्सअ हाम्हां बच़ाऊई आथी!<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />तंऐं किल्है रहैऊऐ मुखा ईंयां घोर उपद्रभ?</para>
  <para style="q" vid="HAB 1:3">बूरअ करनै आल़ै कदुष्ट मणछा लै तूह सज़ा किल्है निं दैंदअ?</para>
  <para style="q" vid="HAB 1:3">तूह किल्है दैआ इहअ हणैं?</para>
  <para style="q" vid="HAB 1:3">मणछ आसा नर्दैई हुऐ दै! सारै दी आसा ज़ुल्म अर उपद्रभ!</para>
  <para style="q" vid="HAB 1:3">हर ज़ैगा आसा झ़गल़ै अर काट-मार!<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />बधाने डअर निं रही ई आथी अर</para>
  <para style="q" vid="HAB 1:4">दालता दी निं नसाफ भेटदअ!</para>
  <para style="q" vid="HAB 1:4">कदुष्ट मणछै गोटै धर्मीं फेरा-फेर!</para>
  <para style="q" vid="HAB 1:4">नसाफ निं रहअ ई आथी।”<verse eid="HAB 1:4" /></para>
  <para style="s">बिधाता दैनअ हबकूका लै ज़बाब</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />बिधाता बोलअ इहअ,</para>
  <para style="q" vid="HAB 1:5">“देशा-देशा दैआ तम्हैं सोभ नदर,</para>
  <para style="q" vid="HAB 1:5">तेता भाल़ी हणैं तम्हैं रहैन ज़ुंण तेथ हंदअ आसा लागदअ।</para>
  <para style="q" vid="HAB 1:5">थारी ज़िऊंदी ज़िता ई करनै मुंह इहै नुआहरै काम कि</para>
  <para style="q" vid="HAB 1:5">तम्हां निं विश्वास ई हणअ कि इहअ बी आसा हंदअ लागअ।<verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />मंऐं लाअ कसदी लै होर बी बल दैई ज़ुंण</para>
  <para style="q" vid="HAB 1:6">ज़ुंण दैंत्तर अर नर्दैई देश आसा।</para>
  <para style="q" vid="HAB 1:6">तिन्‍नां हांढणअ सारी पृथूई दी संघा करनअ</para>
  <para style="q" vid="HAB 1:6">तिन्‍नां हर ज़ैगा कबज़अ ज़ुंण तिन्‍नें नांईं आथी तै।<verse eid="HAB 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />तिंयां पाआ लोगा जैंदरी डअर-भगैर,</para>
  <para style="q" vid="HAB 1:7">तिन्‍नों बधान अर सूल हआ ज़ेही तिन्‍नें मरज़ी बेठी तिहअ।<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />तिन्‍नें घोल़ै ठुर्हा च़राघा का बी छ़ेक्‍कै,</para>
  <para style="q" vid="HAB 1:8">तिंयां आसा राची शकार करनै आल़ै रुहलै का बी करबैऊंणैं।</para>
  <para style="q" vid="HAB 1:8">तिंयां पल़ा भुखै मुक्षरलै ज़िहै चुटी</para>
  <para style="q" vid="HAB 1:8">ज़ुंण भ्रिंऊं करदअ उटअ डैअ बाही शकारा लै झ़ाफ़ली बाहा।<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />तिंयां एछा काट-मार करदै रेगीस्ताने ढिश-बागरी ज़िहै हेरा-हेरी,</para>
  <para style="q" vid="HAB 1:9">लाखों लोग कैद करनै आसा तिन्‍नां लै इहै सान</para>
  <para style="q" vid="HAB 1:9">ज़िहअ धरना का रेतो अंदल़ू च़कणअ।<verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />बडै-बडै राज़ै अर कार-करिंदैओ करा खेल-तमास्सअ,</para>
  <para style="q" vid="HAB 1:10">तिन्‍नें दुशमणे बडै-बडै गहल़ा भाल़ी लागा तिंयां हास्सदै,</para>
  <para style="q" vid="HAB 1:10">तेते दुआली लै च़िणां तिंयां चेच संघा करा तिन्‍नें नगरी कबज़अ।<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />तेखअ डेओआ तिन्‍नें सैना बागरी ज़ेही होर्ता लै,</para>
  <para style="q" vid="HAB 1:11">तिंयां सोठा इहअ कि तिन्‍नों बल ई आसा तिन्‍नों देअ ज़ेते तिंयां पूज़ा करा,</para>
  <para style="q" vid="HAB 1:11">तैही आसा तिंयां दोशी।”<verse eid="HAB 1:11" /></para>
  <para style="s">हबकूक खोज़ा भिई बिधाता का खरी</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />तेखअ बोलअ मंऐं इहअ,</para>
  <para style="q" vid="HAB 1:12">“बिधाता, जुगा-जुगा ओर्ही आसा सदा तूह ई,</para>
  <para style="q" vid="HAB 1:12">मेरै परमेशर, तूह आसा पबित्र अर तूह रहणअ सदा ज़िऊंदअ।</para>
  <para style="q" vid="HAB 1:12">हे मेरै मालक, तूह आसा हाम्हां लै शरण लणें टोल्हा ज़िहअ,</para>
  <para style="q" vid="HAB 1:12">अर ऐबै आसा तंऐं म्हारी गलती पिछ़ू हाम्हां नैरदै कसदी छ़ांटै दै</para>
  <para style="q" vid="HAB 1:12">कि तिन्‍नां करै तूह हाम्हां लै सज़ा दैए!<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />तूह आसा पठी शुचअ अर तूह निं बूरअ मंदअ ई आथी,</para>
  <para style="q" vid="HAB 1:13">तूह निं बूरै करनै आल़ै मणछा साखदअ ई आथी,</para>
  <para style="q" vid="HAB 1:13">तै किल्है दैआ तूह इना कदुष्ट मणछा ज़िऊंणै?</para>
  <para style="q" vid="HAB 1:13">ज़ेभै कदुष्ट मणछ आप्पू का खास्सै धर्मीं मणछा मारा,</para>
  <para style="q" vid="HAB 1:13">तेभै किल्है निं हैनूं तूह किज़ै बोल्दअ?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />अह ज़ाण्हिंआं इहअ कि तंऐं आसा मणछ समुंदरे म्हाछ़ली ज़िहै बणाऐं दै!</para>
  <para style="q" vid="HAB 1:14">तिंयां आसा हांढणै-फिरनैं इहै ज़ीबा ज़िहै</para>
  <para style="q" vid="HAB 1:14">ज़सरअ राज़अ ई निं आथी ज़ुंण तिन्‍नां प्रैंदै राज़ करे!<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />दुशमण खिंच़ा तिन्‍नां म्हाछ़ली कुंगल़ै कांडै करै!</para>
  <para style="q" vid="HAB 1:15">तिंयां चैल़ा तिन्‍नां आपणैं ज़ज़ाल़ा दी संघा निंयां आपणैं ज़ज़ाल़ा संघी घिशी,</para>
  <para style="q" vid="HAB 1:15">दुशमणा हआ एता लै खास्सै राज्ज़ी अर खुश।<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />तिन्‍नें ज़ज़ाल़ा करै भेटा तिन्‍नां ज़िहअ लोल़ी तिहअ,</para>
  <para style="q" vid="HAB 1:16">तैही करा तिंयां तेता लै बल़ीदान।</para>
  <para style="q" vid="HAB 1:16">तिन्‍नें ज़ज़ाल़ दैआ तिन्‍नां लै भांती-भांतीओ खाण रज्ज़ी खाणां लै,</para>
  <para style="q" vid="HAB 1:16">तैही ज़ाल़ा तिंयां तेता लै धूप।<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />बिधाता, ताह इहअ कबल्‍लअ दैणअ हणैं?</para>
  <para style="q" vid="HAB 1:17">तिन्‍नां आपणैं ज़ज़ाल़ सदा डाहणैं म्हाछ़ली करै भरी?</para>
  <para style="q" vid="HAB 1:17">तिन्‍नां इहै ई रहणैं कबल्‍लै होरी देशो बनाश करदै?</para>
  <para style="q" vid="HAB 1:17">तिन्‍नें अह नर्दैई काट-मार कधि निं मुक्‍कणीं?”<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />“मुंह उखल़णअ उछ़टै कोटै, तिधी रहणअ मुंह पहरी ज़िहै खल़्हुई,</para>
  <para style="q" vid="HAB 2:1">मुंह रहणअ न्हैल़ै लागी कि बिधाता मुल्है किज़ै हुकम करा,</para>
  <para style="q" vid="HAB 2:1">मंऐं आसा बिधाता का खरी खोज़ी दी,</para>
  <para style="q" vid="HAB 2:1">मुंह भाल़णअ कि बिधाता मुल्है किज़ै ज़बाब दैणअ।”<verse eid="HAB 2:1" /></para>
  <para style="s">हबकूका लै बिधातो ज़बाब</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />बिधाता दैनअ मुल्है ज़बाब,</para>
  <para style="q" vid="HAB 2:2">“ज़ुंण मुंह ताखा रहैऊंणअ, तेता डाहै तूह शिला दी इहअ पटाघअ खेल़ी कि</para>
  <para style="q" vid="HAB 2:2">ज़ै कुंण ठुर्ही-ठुर्हदी बी एछे, तेऊ लोल़ी सह समाद झ़ट च़ारै समझ़ आअ।</para>
  <para style="q" vid="HAB 2:2">ताकि सह तेता होरी लोगा का बी खोज़े।<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />ज़ुंण गल्‍ला ताह धैनै-सुपनै भाल़णीं, तिंयां निभणी आजू तेभै तेही ई</para>
  <para style="q" vid="HAB 2:3">ज़ेभा लै मंऐं तिंयां सोठी हणीं डाही दी।</para>
  <para style="q" vid="HAB 2:3">ईंयां गल्‍ला रहणीं हई, ईंयां निं टल़दी।</para>
  <para style="q" vid="HAB 2:3">ज़ै एता लै पूरी हणां लै बल़ैग बी पल़े, तूह लऐ न्हैल़ी।</para>
  <para style="q" vid="HAB 2:3">ईंयां गल्‍ला हणीं ज़रूर अर एता लै निं खास्सी बल़ैग पल़णीं।<verse eid="HAB 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />ऐबै भाल़! कदुष्ट मणछ हणैं खतम, पर</para>
  <para style="q" vid="HAB 2:4">धर्मीं मणछ रहणैं तिन्‍नें विश्वासा करै ज़िऊंदै।<verse eid="HAB 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />शराबा करनअ शरेरै दुशमणो बनाश।</para>
  <para style="q" vid="HAB 2:5">तिन्‍नों निं होरी मारना लै हुअ नाअं आथी अर</para>
  <para style="q" vid="HAB 2:5">तिंयां निं मेर्हअ करना लै केही रज़दै।</para>
  <para style="q" vid="HAB 2:5">तिंयां आसा मौता ज़िहै भुखै ई भुखै अर</para>
  <para style="q" vid="HAB 2:5">मुल्दे दाबणे डुघी घोरी ज़िहै ज़ेथ ज़ेतरै मुल्दै दाबै तेतरै थोल़ै।</para>
  <para style="q" vid="HAB 2:5">तिंयां नर्दैई दुशमण आसा इहै ई! तिंयां च़ाहा सोभी देशा आप्पू लै गिम्मणअ।</para>
  <para style="q" vid="HAB 2:5">तिंयां डाहा सोभी आप्पू सेटा कैद करी।<verse eid="HAB 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />पर एक बगत एछणअ इहअ कि ज़ुंण तिन्‍नैं कैद आसा किऐ दै,</para>
  <para style="q" vid="HAB 2:6">तिंयां लागणै तिन्‍नां लै हास्सदै, तिन्‍नां बोल़णअ इहअ,</para>
  <para style="q" vid="HAB 2:6">‘बाबेल, तंऐं आसा आप्पू लै किम्मती च़िज़ा डाही दी झाल़ी ज़ुंण तेरी आथी ई निं!</para>
  <para style="q" vid="HAB 2:6">ताल्है पल़णीं घोर आफ़त! सेठ हणां लै लुटै तंऐं होर देश,</para>
  <para style="q" vid="HAB 2:6">ताह केभै तैणीं रहणअ इहअ करदै लागी?<verse eid="HAB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 2:7" />तेरै दैणदार पल़णै ताल्है नच़ानक चुटी,</para>
  <para style="q" vid="HAB 2:7">तिन्‍नां निंणीं तेरी सोभ गल्‍ला अर सारी धन-माया लुटी,</para>
  <para style="q" vid="HAB 2:7">तूह हणअ डरै काम्बदअ भाल़ा-भाल़ी।<verse eid="HAB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 2:8" />तंऐं लुटै देश-देश, पृथूई दी डाहै तंऐं ज़ैगै-ज़ैगै मणछ मारी,</para>
  <para style="q" vid="HAB 2:8">तंऐं किअ बतेर्ही नगरी अर तेथ बस्सै दै मणछो बनाश।</para>
  <para style="q" vid="HAB 2:8">ऐबै एछणैं बच़ै दै लोग ताह लुटदै।<verse eid="HAB 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />ताल्है पल़णीं घोर आफ़त! तंऐं किऐ आपणैं टबर</para>
  <para style="q" vid="HAB 2:9">होरी लै उपद्रभ अर ज़ुल्म करी सेठ।</para>
  <para style="q" vid="HAB 2:9">तूह समझ़ा इहअ कि धन-माया करनी तेरी फाज़त,</para>
  <para style="q" vid="HAB 2:9">तूह समझ़ा इहअ कि उछ़टै दी बस्सी निं ताह सेटा आफ़त पुजणीं।<verse eid="HAB 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 2:10" />पर ज़ुंण नर्दैई काम तंऐं किऐ दै आसा,</para>
  <para style="q" vid="HAB 2:10">तेता करै हणैं तेरै ई टबर शर्मिंदै,</para>
  <para style="q" vid="HAB 2:10">तंऐं पाऐ देशे-देशे लोग मारी, तेता पिछ़ू लागणीं ताह आपणीं ज़िन्दगी दैणीं।<verse eid="HAB 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 2:11" />तेरै घअरै भित्तीए पात्थरा बी लाणअ ताल्है हाक्‍का पाई दोश,</para>
  <para style="q" vid="HAB 2:11">तेरी पांडे भ्रैहणी दैणअ इहअ ई ज़बाब।<verse eid="HAB 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />ताल्है आसा घोर आफ़त! ज़ुल्म करी पाआ तूह नगरीए आथरी,</para>
  <para style="q" vid="HAB 2:12">नगरी बसाऊआ तूह लोगे हत्या करी।’<verse eid="HAB 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 2:13" />पर स्वर्गे सारी सैने मालक बिधाता करनअ तिन्‍नां च़िज़ो दहई छ़ार,</para>
  <para style="q" vid="HAB 2:13">ज़ेते तैणीं मणछ अर देश खास्सी मैन्थ करा</para>
  <para style="q" vid="HAB 2:13">कि तिंयां च़िज़ा लोल़ी तिन्‍नां भेटी।<verse eid="HAB 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 2:14" />ज़िहअ समुंदर पाणीं करै हआ भर्हुअ द,</para>
  <para style="q" vid="HAB 2:14">तेही हणीं धरती तिन्‍नां मणछा करै भरी</para>
  <para style="q" vid="HAB 2:14">ज़ुंण बिधातो अदर करा।<verse eid="HAB 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />बाबेल! ताल्है आसा घोर आफ़त!</para>
  <para style="q" vid="HAB 2:15">तूह पणैऊंआं आपणैं संघी-साथी का ज़बरी खास्सी शराब,</para>
  <para style="q" vid="HAB 2:15">ताकि तिंयां नांगै-बल़िंगै शुझिए अर तिंयां बेइज़त होए।<verse eid="HAB 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 2:16" />पर ऐबै हणअ तूह शर्मिंदअ, तेरअ निं अदर हणअ।</para>
  <para style="q" vid="HAB 2:16">बिधाता पणैऊंणअ ऐबै ताखा रज्ज़ी शराब,</para>
  <para style="q" vid="HAB 2:16">तेखअ भाल़णअ तूह होरी नांगअ-बल़िंगअ।</para>
  <para style="q" vid="HAB 2:16">तेरी निं कोही इज़त करनी।<verse eid="HAB 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 2:17" />तंऐं शोटै लाबानोन बणें डाल़-बूट काटी धरनीं,</para>
  <para style="q" vid="HAB 2:17">पर ऐबै शोटणअ तूह काटी करै धरनीं।</para>
  <para style="q" vid="HAB 2:17">तंऐं पाऐ एऊ बणें ज़ीब मारी पर ऐबै डरैऊंणअ बणें ज़ीबा तूह।</para>
  <para style="q" vid="HAB 2:17">ताल्है हणअ इहअ ई, किल्हैकि तंऐं किई खास्सी हत्या,</para>
  <para style="q" vid="HAB 2:17">तंऐं किऐ पृथूई दी देशा-देशे नगरी अर मणछा लै ज़ुल्म अर उपद्रभ।<verse eid="HAB 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />मुहुर्तीओ किज़ै काम आसा? सह सिधी एही निं आथी कि</para>
  <para style="q" vid="HAB 2:18">मणछै आसा आपणैं हाथै बणाईं दी अर</para>
  <para style="q" vid="HAB 2:18">शल़ैघा का सुआई निं सह होर किछ़ खोज़दी!</para>
  <para style="q" vid="HAB 2:18">ज़ेभै सह बणाणैं आल़अ तैहा मुहुर्ती दी विश्वास करा,</para>
  <para style="q" vid="HAB 2:18">तेभै सह मुहुर्ती तेऊ लै किज़ै भलअ करा ज़ुंण गल्‍ला ई निं करी सकदी?<verse eid="HAB 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />ताल्है आसा आफ़त! तूह ज़ुंण काठे मुहुर्ती लै बोला, ‘ज़ाग।’</para>
  <para style="q" vid="HAB 2:19">ज़ुंण पात्थर गल्‍ला निं करी सकदअ तेऊ लै बोला तूह, ‘उझ़ू।’</para>
  <para style="q" vid="HAB 2:19">सह कै ताल्है अक्ल दैई सका? निं कधि दैई सकदअ!</para>
  <para style="q" vid="HAB 2:19">सह सुन्‍नैं-च़ंदी करै महल़ी दी ता आसा पर</para>
  <para style="q" vid="HAB 2:19">तेथ निं शाह आथी!<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />बिधाता आसा आपणैं पबित्र भबनै,</para>
  <para style="q" vid="HAB 2:20">पृथूई सोभ ज़ीब रहा तेऊ सेटा च़ुप्पी।”<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">हबकूके बिधाता का अरज़</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />हबकूक गूरै किई खास शिगनोत<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">शिगनोत </char><char style="ft" closed="false">शोगे गिहा</char></note> रागा दी गिह बोली बिधाता सेटा अरज़।<verse eid="HAB 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />“हे बिधाता, मंऐं आसा होछ़ी उझै तेरै बारै शूणअ द,</para>
  <para style="q" vid="HAB 3:2">तेरै महान अर नुआहरै कामां शूणीं हआ हुंह रहैन, हुंह करा तेरै महान बलो अदर।</para>
  <para style="q" vid="HAB 3:2">ज़ीबाण, तिहै ई महान काम कर ऐबै भिई ताकि हाम्हैं भाल़े।</para>
  <para style="q" vid="HAB 3:2">ज़ेभै ताह हाम्हां लै रोश्श बी होए फिरै दै,</para>
  <para style="q" vid="HAB 3:2">तज़ी बी डाहै हाम्हां लै झींण करनी आद।<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />तूह आसा सह ई पबित्र परमेशर ज़ुंण हाम्हां बच़ाऊंदअ</para>
  <para style="q" vid="HAB 3:3">तेमान देश अर परान पर्बता का एछा।</para>
  <para style="q" vid="HAB 3:3">तेरै प्रतप्पा करै भर्हिया सारअ सरग।</para>
  <para style="q" vid="HAB 3:3">मणछ करा सारी पृथूई तेरी ज़ै-ज़ैकार।<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />तेरअ प्रतप्प च़मका सुरज़ा ज़िहअ,</para>
  <para style="q" vid="HAB 3:4">तेरै हाथा का लागा धुप्पअ! तेथ हआ तेरअ महान बल लुक्‍कअ द।<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />ताह संघै एछा दूई डरैऊंणी गल्‍ला,</para>
  <para style="q" vid="HAB 3:5">नबिज़री बमारी अर मौत।<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />ज़ेभै तूह खल्हिआ, तेभै हआ पृथूई दी ज़ाज़री,</para>
  <para style="q" vid="HAB 3:6">ज़ेभै तूह नदर दैआ, देशा-देशा का छ़ुटा डरै दर्छ़णअ,</para>
  <para style="q" vid="HAB 3:6">ज़ेभै तूह हांढा, जुगा-जुगा ओर्ही खल़ै बडै-बडै पर्बतो हआ धरनीं च़ूरअ,</para>
  <para style="q" vid="HAB 3:6">बडी-बडी पराणीं धारा बी बेठा धरनीं निंऊंईं।<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />मुखा शुझुअ कुशान टोलीए डेरै पल़ी आफ़त,</para>
  <para style="q" vid="HAB 3:7">मिद्यान देशे लोगा आसा दर्छ़णअ छ़ुटअ द।<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />हे बिधाता, ताह कै इना पाणींए दरैऊआ लै ती रोश्शै आई दी?</para>
  <para style="q" vid="HAB 3:8">ताह कै इना समुंदरा लै आसा त कोप आअ द?</para>
  <para style="q" vid="HAB 3:8">ज़ेभै तूह आपणैं दुशमणा का ज़ितणा लै घोल़ै आल़ै रथा दी बेशी आअ?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />तंऐं हेरी ती आपणैं धणशा दी डोर लाई,</para>
  <para style="q" vid="HAB 3:9">तेरै कतीरै तै तेरै हुकम पूरै करने सोह खाऐ दै।</para>
  <para style="q" vid="HAB 3:9">तंऐं पाऐ धरती दी पाणींए गाडा अर दरैऊआ करै नाल़-खोहल़।<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />ताह भाल़ी लागै बडै-बडै पर्बत काम्बदै,</para>
  <para style="q" vid="HAB 3:10">सरगा का फुटै पाणींए बादल़ अर</para>
  <para style="q" vid="HAB 3:10">डुघै समुंदरे पाणीं बी दैनअ उझै बुआल़,</para>
  <para style="q" vid="HAB 3:10">तेते छ़ाल्‍ली लागी उझै उछ़टै तैणीं।<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />तंऐं छ़ाडै आपणैं च़मकिल्‍लै कतीर कि सुरज़ अर ज़ोथ खल़्हुऐ तिधी,</para>
  <para style="q" vid="HAB 3:11">तेरै बर्छ़ै का च़मकी एही बिज़ल़ी कि सुरज़ अर ज़ोथ निं आजू सिक्‍कै।<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />तंऐं दैनी रोश्शै सारी पृथूई दी हांढ,</para>
  <para style="q" vid="HAB 3:12">देशा-देशे लोगा कदुष्ट लोगो किअ तंऐं बनाश।<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />तूह निखल़अ आपणीं परज़ा उद्धार करदअ,</para>
  <para style="q" vid="HAB 3:13">अर आपणैं छ़ांटै दै राज़ै बच़ाऊंदअ।</para>
  <para style="q" vid="HAB 3:13">कदुष्ट देशो राज़अ झेचअ तंऐं धरनीं,</para>
  <para style="q" vid="HAB 3:13">सह किअ तंऐं मुंडा का घुंढी तैणीं नांगअ।<verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />तंऐं खभेहुअ तेऊओ बर्छ़अ तेऊए ई मुंडै अर तेऊए सैना किई खतम।</para>
  <para style="q" vid="HAB 3:14">ज़ेभै तेऊए सैना हाम्हां लै ढिश-बागरी ज़िहै चुटी पल़ी, तिंयां लागा तै हास्सदै,</para>
  <para style="q" vid="HAB 3:14">तिंयां सोठा तै इहअ कि तिन्‍नों हाम्हां का ज़ितणअ आसा सान,</para>
  <para style="q" vid="HAB 3:14">किल्हैकि हाम्हैं तै गरीब अर बाख दुबल़ै।<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />पर तंऐं झेचअ समुंदर आपणैं घोल़ै करै,</para>
  <para style="q" vid="HAB 3:15">अर प्रल़या करनै आल़ै पाणीं का काढी तंऐं शेफा।<verse eid="HAB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />ज़ांऊं मंऐं अह शूणअ, मुखा छ़ुटअ डरै दर्छ़णअ।</para>
  <para style="q" vid="HAB 3:16">तेरी छ़ेल़ शूणीं छ़ुटी मेरी खाख बी ल्हिथल़ी</para>
  <para style="q" vid="HAB 3:16">अर मेरै हाडकै लागै गल़दै, मेरी ज़ांघा चुटी पठी।</para>
  <para style="q" vid="HAB 3:16">पर मुंह करनअ सबर, मुंह रहणअ तैहा आफ़ते धैल़ी न्हैल़ै लागी,</para>
  <para style="q" vid="HAB 3:16">ज़हा धैल़ी हाम्हां हंतणैं आल़ै दुशमणा लै सज़ा भेटणीं।<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />च़ाऐ ज़िहअ बी होए, मुंह करनअ बिधातो शूकर।</para>
  <para style="q" vid="HAB 3:17">च़ाऐ फेडूए बूट नांईं फूले, च़ाऐ दाखे बेला दी दाणैं नांईं लागे,</para>
  <para style="q" vid="HAB 3:17">च़ाऐ जैतूने बूट नांईं फल़े अर खेचा का किछ़ै नाज़ निं पज़े,</para>
  <para style="q" vid="HAB 3:17">च़ाऐ भेडा-बाकरी ढेक्‍का पल़े अर खुढे गाऊई-बल्द किछ़ नांईं रहे,<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />तज़ी बी करनअ मुंह बिधातो शूकर!</para>
  <para style="q" vid="HAB 3:18">मुंह रहणअ खुश किल्हैकि सह आसा परमेशर ज़ुंण मेरी फाज़त करा।<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />मुल्है बल दैणैं आल़अ आसा बिधाता,</para>
  <para style="q" vid="HAB 3:19">सह बणाआं मेरै खूरा हरनी ज़िहै,</para>
  <para style="q" vid="HAB 3:19">सह नढैऊआ मुंह उछ़टी धारा अर ढेक्‍कै-ढुंखरै बी राज्ज़ी-राम्बल़ै।”</para>
  <para style="p" vid="HAB 3:19">अह गिह आसा एक नुआहरै बाज़ै संघै बोली दी।<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>