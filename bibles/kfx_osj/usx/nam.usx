  <para style="h">नहूम</para>
  <para style="toc1">बिधातो गूर नहूम</para>
  <para style="toc2">नहूम</para>
  <para style="toc3">नहू.</para>
  <para style="mt1">नहूम</para>
  <para style="mt2">नहूम गूरै लिखी दी कताब</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: नहूम</para>
  <para style="ili">सन: 620 का 612 ईसा आजी</para>
  <para style="ip">ऐहा कताबा दी खोज़ा नहूम गूर कि बिधाता लाअ नसाफ करी अर अश्शूर देशा लै सज़ा दैई। किल्हैकि अश्शूर देश आसा होरी देशा लै खास्सअ नर्दैई हुअ द। कई पराणैं बधान खोज़ा इहअ कि अह आसा बिधाते झींण ज़ेभै बिधाते नसाफ करने बारै गल्‍ला करा। पर ऐहा कताबा दी आसा बिधाता सिधअ तिन्‍नां लै झणैल़ू ज़ुंण तेऊ बाखा फिरा।</para>
  <para style="ip">नहूम गूर खोज़ा इहअ बी कि बिधाता रहैऊआ आपणीं परज़ा लै तिन्‍नें दुशमणा लै सज़ा दैई झींण संघा करा तिन्‍नें गलामी का आपणीं परज़ा आज़ाद ज़िहअ बिधाता अश्शूरी लै किअ। बिधाता सका इहअ करी किल्हैकि सह करा पृथूई प्रैंदै राज़:</para>
  <para style="imq">“बिधाता करा ज़ल़न, सह आसा परमेशर ज़ुंण बदल़अ लआ बिधाता छ़ाडा बदल़अ लणा लै आपणअ महान कोप संघा करा नसाफ। सह मालक दैआ तिन्‍नां लै सज़ा ज़ुंण तेऊ का नफरत करा तिन्‍नां लै पाआ सह आपणअ कोप। बिधाता का आसा महान बल, पर तज़ी बी करा सह सबर। दोशी लोगा निं सह सज़ा दैणैं बाझ़ी छ़ाडदअ। तेऊए एछणैं करै एछा बडी कुर्लू बागरी अर तफान, बादल़ आसा तेऊए खूरा हेठै धूल़ै ज़िहै।”</para>
  <para style="ipr">(1:2,3)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">निनबे नगरी लै सज़ा 1:1-6</para>
  <para style="io1">अश्शूर देशो बनाश बिधाते परज़ा लै आशा 1:7-15</para>
  <para style="io1">अश्शूर देशे राज़धानी निनबे नगरीओ बनाश 2:1—3:19</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />हुंह आसा एलकोश नगरीओ नहूम गूर, अह समाद आसा मंऐं निनबे नगरीए बारै लिखअ द।<verse eid="NAM 1:1" /></para>
  <para style="s">निनबे नगरी लै बिधातो रोश्श</para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />बिधाता करा ज़ल़न, सह आसा परमेशर ज़ुंण बदल़अ लआ</para>
  <para style="q" vid="NAM 1:2">बिधाता छ़ाडा बदल़अ लणा लै आपणअ महान कोप संघा करा नसाफ।</para>
  <para style="q" vid="NAM 1:2">सह मालक दैआ तिन्‍नां लै सज़ा ज़ुंण तेऊ का नफरत करा,</para>
  <para style="q" vid="NAM 1:2">तिन्‍नां लै पाआ सह आपणअ कोप।<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />बिधाता का आसा महान बल, पर तज़ी बी करा सह सबर।</para>
  <para style="q" vid="NAM 1:3">दोशी लोगा निं सह सज़ा दैणैं बाझ़ी छ़ाडदअ।</para>
  <para style="q" vid="NAM 1:3">तेऊए एछणैं करै एछा बडी कुर्लू बागरी अर ढिश-बागर,</para>
  <para style="q" vid="NAM 1:3">बादल़ आसा तेऊए खूरा हेठै धूल़ै ज़िहै।<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />सह सका एकी बैणै बडै-बडै दरैअ शकेऊई!</para>
  <para style="q" vid="NAM 1:4">तेखअ हणीं बाशान मुल्खे रज़दी-पज़दी ज़ैगा शुक्‍की,</para>
  <para style="q" vid="NAM 1:4">कर्मेल धारा बी पल़णअ शुक्‍कअ!</para>
  <para style="q" vid="NAM 1:4">लाबानोन हरै-भरै बणैं शुक्‍कणैं खील-फूल पठ।<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />ज़ांऊं बिधाता एछा, बडै-बडै पर्बता छ़ुटा काम्मणीं अर धारा गल़ा पठ,</para>
  <para style="q" vid="NAM 1:5">पृथूई दी हआ ज़ाज़री अर तेथ बस्सै दै सोभी ज़ीबा छ़ुटा दर्छ़णअ।<verse eid="NAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />ज़ेभै तेऊ रोश्श हुई आई दी,</para>
  <para style="q" vid="NAM 1:6">तेभै निं तेऊ सेटा कोह ज़िऊंदअ बच़ी सकदअ।</para>
  <para style="q" vid="NAM 1:6">तेऊओ कोप निं कोह ज़िरी सकदअ!</para>
  <para style="q" vid="NAM 1:6">तेऊओ कोप पल़ा आगीए दरैऊआ ज़िहअ,</para>
  <para style="q" vid="NAM 1:6">बडी-बडी टोल्हा दी पल़ा बिधाता सम्हनै द्रटा।<verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />बिधाता आसा भलअ,</para>
  <para style="q" vid="NAM 1:7">सह करा आफ़ते पलका आपणीं परज़े फाज़त।</para>
  <para style="q" vid="NAM 1:7">सह दैआ तिन्‍नां लै शरण ज़ुंण तेऊ बाखा फिरा।<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />सह पल़ा बडै दरैऊआ ज़िहअ चुटी संघा करा दुशमणा पठी खतम।</para>
  <para style="q" vid="NAM 1:8">सह दरल़ाऊआ आपणैं दुशमणा तेथ बाखा ज़ेथ बाखा न्हैरअ अर मौत आसा।<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />तम्हैं बिधाता लै किज़ै बिक्री सोठदै आसा लागै दै?</para>
  <para style="q" vid="NAM 1:9">तेऊ करनअ थारअ बनाश।</para>
  <para style="q" vid="NAM 1:9">सह निं आपणैं दुशमणा दुजी बारी खल़ै उझ़दै ई छ़ाडदअ।<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />सह हणअ इहअ कि तिंयां हणैं घणैं कांडे झ़ाकल़ै शाचै दै,</para>
  <para style="q" vid="NAM 1:10">तिंयां हणैं खास्सी शराब झुटै दै शराबी ज़िहै।</para>
  <para style="q" vid="NAM 1:10">तिंयां हणैं शुक्‍कै ज़ोल़्ठै ज़िहै झ़ट च़ारै दझ़ी खतम।<verse eid="NAM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 1:11" />निनबे माहा नगरी! तेरअ राज़अ आसा बिधाता लै कदुष्ट बिक्री सोठदअ लागअ द! <verse eid="NAM 1:11" /><verse number="12" style="v" sid="NAM 1:12" />बिधाता बोला यहूदा मुल्खे परज़ा लै, “निनबे नगरीए लोग च़ाऐ ज़ेतरै बी खास्सै अर ज़िहै बी बलबान होए, मुंह करनअ तिन्‍नों बनाश अर तिंयां हणैं पठी खतम। तम्हां यहूदा मुल्खे मेरी परज़ा लै दैनी मंऐं सज़ा, पर ऐबै निं हुंह तम्हां लै भिई सज़ा दैंदअ। <verse eid="NAM 1:12" /><verse number="13" style="v" sid="NAM 1:13" />ऐबै काढणअ मुंह थारै कैल़ै का अश्शूर देशे गलामीओ जूँ पोर्ही, थारै हाथा-खूरा का शांघल़ी लोहै चोल़ी करनै मुंह तम्हैं आज़ाद।”<verse eid="NAM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NAM 1:14" />अश्शूर देशे राज़धानी निनबे नगरीऐ! बिधाता बोला ताल्है इहअ, “तेरी निं आजू आद-लुआद किछ़ै हणीं अर तेरै खिंबो हणअ नाअं ई खतम। मुंह करनी ज़ैगै-ज़ैगै त देहुरै तेरी काठ, पात्थर अर धातू करै बणाईं दी मुहुर्ती खतम। मंऐं लाई ताल्है डुघी घोर डाही कोती किल्हैकि तूह आसा कदुष्ट।”<verse eid="NAM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NAM 1:15" />यहूदा मुल्खे परज़ा! उझै दैआ धारा बाखा नदर! तेथ बाखा आसा खुशीए समादा खोज़णैं आल़अ दूत एछदअ लागअ द। तेऊ करनअ मेल़-ज़ोल़। आपणअ खास थैर मनाऊंआं अर बिधाता लै करा आपणीं मानत पूरी। ऐबै निं कदुष्ट थारै मुल्खा बाती एछणैं, तिंयां हेरै पठी खतम करी।<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">निनबे नगरीओ बनाश</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1" />निनबे नगरीए लोगो! दुशमण पल़णअ तम्हां लै चुटी।</para>
  <para style="q" vid="NAM 2:1">नगरीए गहल़ा फेर डाह पहरी लाई!</para>
  <para style="q" vid="NAM 2:1">नगरीए फाज़त करना लै करा सैना तैर।</para>
  <para style="q" vid="NAM 2:1">बाता बाखा रहा भाल़ै लागी अर</para>
  <para style="q" vid="NAM 2:1">मकाबलै करना लै रहा सारअ ज़ोर लाई तैर्हुई!<verse eid="NAM 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NAM 2:2" />थारी सैना किअ त महान यहूदा अर इज़राईल देश बरैबाद। तिन्‍नें खेच अर दाखे बाग किऐ तै तिन्‍नैं खतम। पर बिधाता करनै याकबे आद-लुआद भिई महान।<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3" />दुशमण सैने हारदै-मारदै जोधै च़ाल्‍लै निनबे नगरी लै चुटी पल़ी!</para>
  <para style="q" vid="NAM 2:3">तिन्‍नां का आसा हाथै लाल ढाल़ा अर घेरी लाल बर्दी बान्हीं दी।</para>
  <para style="q" vid="NAM 2:3">सैना किऐ तिन्‍नें बर्छ़ै उझै खल़ै,</para>
  <para style="q" vid="NAM 2:3">तिंयां गऐ जुधा लै तैर्हुई अर तिन्‍नें रथा का आसा</para>
  <para style="q" vid="NAM 2:3">आगी ज़िहअ च़लकार लागअ द, अर<verse eid="NAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4" />रथ लागै सल़का ढिश-बागरी ज़िहै ठुर्हदै,</para>
  <para style="q" vid="NAM 2:4">तिंयां ज़ाण्हिंआं आगीए मसाल्‍लै ज़िहै अर</para>
  <para style="q" vid="NAM 2:4">च़फै ओर्ही-पोर्ही ठुर्हा तिंयां सरगै बिज़ल़ीए च़पराल़ै ज़िहै छ़ेक्‍कै।<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5" />अश्शूरी राज़ै शादै आपणैं सोभी का बलबान जोधै,</para>
  <para style="q" vid="NAM 2:5">पर तिंयां लागै ठोहल़ लागी बाता धरनीं बधल़दै!</para>
  <para style="q" vid="NAM 2:5">तिंयां ठुर्है नगरीए दुआली बाखा लै पर दुशमणै आसा</para>
  <para style="q" vid="NAM 2:5">पैहलै ई तिन्‍नां बाखा आपणीं ढाल़ा डाही दी करी।<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6" />दुशमणै खोल्है दरैऊआ दी लाऐ दै रोक्‍कै,</para>
  <para style="q" vid="NAM 2:6">पाणीं करै भर्हुई सारी नगरी अर सोभ ज़ैगा किई बरैबाद।<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7" />निनबे नगरीए लोग निऐं होरी देशै गलाम बणाईं, तिंयां हुऐ शर्मिंदै।</para>
  <para style="q" vid="NAM 2:7">तिन्‍नें दासी आसा पालल़ी ज़ेही चाछल़दी अर हिक्‍का पटाक्‍की लेरा लांदी लागी दी।<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8" />निनबे नगरी आसा कोफरी ज़ेही,</para>
  <para style="q" vid="NAM 2:8">ज़ेतो पाणीं द्रटा बाती बागा लै निसरअ!</para>
  <para style="q" vid="NAM 2:8">तिहै ई लागै तेसे लोग नगरी का बागा लै ठुर्हदै।</para>
  <para style="q" vid="NAM 2:8">लोगै लाई हाक्‍का, “धिरअ हआ! डेओआ निं आथी!”</para>
  <para style="q" vid="NAM 2:8">पर तेथ निं कोह बापस फिरअ।<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9" />लुटणैं आल़ै बोला एकी दुजै लै, “सुन्‍नअ-च़ंदी लुटा ज़ोरा ज़ोरी!</para>
  <para style="q" vid="NAM 2:9">नगरी दी आसा खज़ानै ई खज़ानै,</para>
  <para style="q" vid="NAM 2:9">किम्मती च़िज़े आसा भढारै रूल़ लागै दै।”<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10" />निनबे नगरी लुटी पठी, सह डाही उज़र अर बरैबाद करी।</para>
  <para style="q" vid="NAM 2:10">निनबे नगरीए लोगे हिक्‍का लागअ शाण-शाफल़,</para>
  <para style="q" vid="NAM 2:10">तिन्‍नां आसा ज़ांघा दर्छ़णअ छ़ुटअ द।</para>
  <para style="q" vid="NAM 2:10">तिन्‍नां निं देही दी तराण ई रहै अर तिन्‍नें मुंह पल़ै फिकै।<verse eid="NAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11" />निनबे नगरी ती सिहे जुहल़ी ज़ेही,</para>
  <para style="q" vid="NAM 2:11">ज़ेथ ज़ुआन सिह हआ तै!</para>
  <para style="q" vid="NAM 2:11">ज़हा जुहल़ी लै सह शकार आणा त ढाकी,</para>
  <para style="q" vid="NAM 2:11">ज़ेथ सिहै बच्च़ै निहंचै हआ तै रहै दै कि तिन्‍नां</para>
  <para style="q" vid="NAM 2:11">तेथ हान्‍नी करनै आल़अ कोह आथी!<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12" />सिह आणा त तिधी आपणैं बच्च़ै धाचणा लै खास्सै शकार करी,</para>
  <para style="q" vid="NAM 2:12">आपणीं सिहणीं लै क्सोप्पअ त सह शकारा गल़ा का ढाकी,</para>
  <para style="q" vid="NAM 2:12">सिह डाहा त आपणीं जुहल़ी मास्स अर शकारा करै भरी।<verse eid="NAM 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NAM 2:13" />स्वर्गे सारी सैनो मालक बिधाता बोला निनबे नगरी लै इहअ, “हुंह निं ताह बाखा आथी। मुंह पाणै तेरै रथ दहई अर तेरै खारकै सिह पाणै तलबारा करै मारी। तिंयां ज़ीब निंणै मुंह ताखा दूर ज़हा शकारी तूह चुटी पल़ा त। तेरै दूतो समाद निं तेखअ कोही शुणनअ।”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 3:1" />निनबे नगरीऐ! तेरअ बनाश हणअ पाक्‍कै दी!</para>
  <para style="q" vid="NAM 3:1">तेरै लोग आसा हत्या करनै आल़ै अर तिंयां बोला झ़ुठअ ई।</para>
  <para style="q" vid="NAM 3:1">नगरी आसा एही किम्मती च़िज़ा करै भरी दी ज़ुंण तिन्‍नैं होरी का लुटी।<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />कोल़े छ़ेल़ शुण, रथे थरेटा घुर्हने छ़ेल़ शुण!</para>
  <para style="q" vid="NAM 3:2">घोल़ै आसा ठुर्हदै लागै दै अर रथ आसा सल़का उछ़ल़दै लागै दै।<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />घोल़े शुंआर आसा आपणैं घोल़ै दरल़ाऊंदै लागै दै।</para>
  <para style="q" vid="NAM 3:3">तलबारा आसा च़मकदी लागी दी अर बर्छ़ै का आसा च़लकार लागअ द।</para>
  <para style="q" vid="NAM 3:3">हज़ारो लोग मूंऐं, ल्हासे आसा रूल़ लागै दै!</para>
  <para style="q" vid="NAM 3:3">धरनीं आसा ल्हासा ई ल्हासा पल़ी दी!</para>
  <para style="q" vid="NAM 3:3">लोग लागै ल्हासा दी ठोहल़ लागी धरनीं बधल़दै।<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />अह बनाश हुअ निनबे नगरी करै!</para>
  <para style="q" vid="NAM 3:4">निनबे नगरी आसा मोहणैं आल़ी कंज़री बेटल़ी ज़ेही</para>
  <para style="q" vid="NAM 3:4">ऐहा बेटल़ी किई खास्सी कंज़रैई!</para>
  <para style="q" vid="NAM 3:4">ऐहा मोहै ज़ादू करै देश-देश!<verse eid="NAM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NAM 3:5" />स्वर्गे सारी सैनो मालक बिधाता बोला निनबे नगरी लै इहअ, “भाल़! तैही निं हुंह ताह बाखा आथी। तेरै घाघरेओ पाल्‍लअ च़कणअ मुंह उझै तेरै नाका तैणीं। तेरी नांगी घेर रहैऊंणीं मुंह सोभी देशा का! देशा-देशा भाल़णैं तेरै गुप्त आंग। <verse eid="NAM 3:5" /><verse number="6" style="v" sid="NAM 3:6" />ताह प्रैंदै शोटणअ मुंह छ़ार-नार, कि तूह आसा बृथा। तेरअ रहैऊंणअ मुंह तमास्सअ। <verse eid="NAM 3:6" /><verse number="7" style="v" sid="NAM 3:7" />ज़ुंण बी ताह भाल़े तिंयां ठुर्हनै इहअ बोली ताखा दूर, ‘निनबे नगरीए शोभा हुई खतम, तेसो हुअ बनाश! एता लै कहा करनअ शोग? हाम्हैं किधा का आणू झेठू शादी ज़ुंण ऐहा लै हैअ दैए?’<verse eid="NAM 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NAM 3:8" />“आद कर कि नील नदीए बाढै बस्सी दी तेबेस नगरीए दशा केही हुई ती। तैहा नगरी फेर-फिरदअ त पाणीं। नील नदीओ दरैअ त तेता लै गहल़ा ज़िहअ। निनबे नगरी निं तेबेस नगरी का राम्बल़ी आथी। <verse eid="NAM 3:8" /><verse number="9" style="v" sid="NAM 3:9" />कूश देश अर मिसर देशे ती आप्पू मांझ़ै पाक्‍की साथ। पुत अर लिबिया देश बी तै आप्पू मांझ़ै पाक्‍कै साथी। <verse eid="NAM 3:9" /><verse number="10" style="v" sid="NAM 3:10" />तज़ी बी निंयैं तेबेस नगरीए दुशमणै तिधे लोग ढाकी संघा बणाऐं गलाम। तिन्‍नें शोहरू माठै डाहै बाता-बणैं काटी-फणाटी ठोर-ठोर करी! तेबेस नगरीए मशूर लोगा लै पाई तिन्‍नैं परच़ी संघा डाहै तिंयां शांघल़ी-लोहै करै बान्हीं।<verse eid="NAM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NAM 3:11" />“निनबे नगरीऐ, तूह हणीं खास्सी शराब झुटै दै मणछा ज़ेही, ताह लागणअ लुक्‍कदै, अर ताह लागणअ दुशमणा का ठुर्ही किधी शरण लोल़ै। <verse eid="NAM 3:11" /><verse number="12" style="v" sid="NAM 3:12" />तेरै सोभै गहल़ आसा फल़ा करै भरी फेडूए बूटा ज़िहै। ज़ांऊं तिंयां तेरै दुशमणा झ़णाऊंणैं, तिंयां जाणै झ़ट च़ारै धरनीं आल़ी। तेरी किम्मती च़िज़ा हणीं फेडू ज़ेही ज़ुंण लोगे खाखा लै अल़ा। <verse eid="NAM 3:12" /><verse number="13" style="v" sid="NAM 3:13" />भाल़! तेरी सैने शूरबीर हुऐ बेटल़ी ज़िहै! तेरै दुशमणै चैल़ी तेरी प्रऊल़ी आग अर तिंयां डाही दहई करै घुआल़ी शोटी। <verse eid="NAM 3:13" /><verse number="14" style="v" sid="NAM 3:14" />गोटणैं का आजी च़ाऐ तूह पाणींओ खास्सअ इंतज़ाम बी डाहे करी, दुआली होर बी उछ़टी डाहे च़िणीं, नगरीए सोभी घअरे राम्बल़ी मराम्मत बी डाहे करी, <verse eid="NAM 3:14" /><verse number="15" style="v" sid="NAM 3:15" />तज़ी पाणीं तूह आगी करै पठी दहई। तूह पाणीं तलबारा करै एही मारी ज़िहअ रैट्टैओ छ़ुंढ हेरा-हेरी फसल खतम करा।</para>
  <para style="p" vid="NAM 3:15">“तेरै लोग च़ाऐ रैट्टे छ़ुंढा ज़िहै खास्सै किल्है निं होए, <verse eid="NAM 3:15" /><verse number="16" style="v" sid="NAM 3:16" />तेरै बपारी होए च़ाऐ सरगे तारै का बी खास्सै, पर तिंयां गऐ डेऊई, तिंयां आसा इहै रैट्टै ज़िहै ज़ुंण फैंख लागदी डैअ दैई दूर डेओआ। <verse eid="NAM 3:16" /><verse number="17" style="v" sid="NAM 3:17" />तेरी सैना अर कार करिंदै बी आसा रैट्टै ज़िहै खास्सै। ठांढै धैल़ै रहा रैट्टै भित्ती दी बेशी। पर धुप्पअ निखल़दी दैआ तिंयां दूर डैअ। तेखअ निं तिन्‍नों कोही का थोघ लागदअ कि तिंयां केस्सी डेऊऐ।<verse eid="NAM 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NAM 3:18" />“अश्शूर देशे राज़ैआ, ज़ुंण तेरी परज़े फाज़त करा, तिन्‍नां आसा उंघी लागी दी। तेरै शूरबीर-जोधै आसा सुत्तै दै। तेरै लोग ठुर्है धारा-धारा अर ऐबै निं तिन्‍नां कठा करनै आल़अ कोह आथी। <verse eid="NAM 3:18" /><verse number="19" style="v" sid="NAM 3:19" />तेरै ज़खम निं ऐबै किछ़ै लाज़ आथी। तेरअ ज़खम आसा खास्सअ डुघअ। लोगै हेरअ शूणीं कि ताल्है किज़ै हुअ। सोभ आसा ताल्है खुश हई ताल़ी बाज़दै लागै दै। किल्हैकि तिन्‍नैं आसा कबल्‍लै तेरै ज़ुल्म भुगते दै।”<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>