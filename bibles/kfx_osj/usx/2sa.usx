  <para style="h">2 शमूएल</para>
  <para style="toc1">इज़राईला दी महान राज़अ दाबेद</para>
  <para style="toc2">2 शमूएल</para>
  <para style="toc3">2 शमू.</para>
  <para style="mt1">2 शमूएल</para>
  <para style="mt2">इज़राईला दी महान राज़अ दाबेद</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: खास थोघ निं आथी</para>
  <para style="ili">सन: 1050 का 722 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">शमूएले अह दुजी कताब आसा असली तै शमूएले पैहली कताबो दुजअ भाग। अह ती एक्‍कै कताब अर अह आसा बादा का दूई बाखा बांडी 1 शमू. अर 2 शमू. किअ द, किल्हैकि कठा ती अह बेघै बडी कताब। 2 शमूएले कताबा दी आसा खासकर राज़ै दाबेदे बारै कि तेऊओ राज़ किअ त।</para>
  <para style="ip">इज़राईले पैहलै राज़ै शाऊला मरनै बाद बणाअं यहूदा गोत्रा आल़ै आपणअ राज़अ। बादा का बणअ दाबेद सारै इज़राईलीओ राज़अ।</para>
  <para style="ip">दाबेदै कि एरुशलेम नगरी दी जबेशी लोगा का छ़ड़ैऊई कबज़अ संघा बणाईं एरुशलेम नगरी तेऊ आपणीं नऊंईं राज़धानी। बादा का आणअ तेऊ बिधातो करारो मणशू बी तिधा लै। ज़िधी तेऊ बिधाते करारो मणशू त डाहअ द, सह च़ाहा त तिधी एक बडअ भबन बणाणअं ताकि बिधातो खास्सअ अदर होए। पर बिधाता निं तेऊ इहअ करनै दैनअ। पर बिधाता त तेऊ लै बोलअ द कि सह हणअ एक महान राज़अ अर आजू बी रहणअ तेऊए आद-लुआदो सदा राज़।</para>
  <para style="ip">दाबेदै ज़ितै इज़राईले दुशमणा का कई जुध संघा किअ तेथ राज़। सह हुअ खास्सअ मशूर अर महान राज़अ। पर तेऊए भलै हुअ पाप बी अर तेता पिछ़ू पल़ी तेऊ लै खास्सी आफ़त बी। मतलब इहअ निं आथी कि दाबेद त हर गल्‍ला लै पूरअ, पर सह थिअ बिधाता लै शुचअ-पाक्‍कअ अर सह निं तेऊ छ़ाडी होरी किछ़ू गल्‍ले पूज़ा-गाज़ा करदअ त। ज़ेभै तैणीं यहूदा मुल्ख रहअ, बिधाते दाबेदा संघै करार रही तेभै तैणीं बणी।</para>
  <para style="ib" />
  <para style="imq">“मंऐं आसा आपणीं परज़ा इज़राईली लै एक ज़ैगा डाही दी अर तिंयां बसाऊंणै मुंह तैहा ज़ैगा। तिधी निं तेखअ तिंयां कोही हंतणैं। तैहा ज़ैगा पुजणैं बाद आऐ खास्सी बारी उपद्रभी लोग तिन्‍नां हारदै-मारदै, पर ऐबै निं इहअ भिई हणअ। मेरी रही ताल्है ज़बान कि तूह डाहणअ मुंह तेरै दुशमणा का बच़ाऊई अर ताल्है दैणीं मुंह खास्सी आद-लुआद। ज़ांऊं तूह खास्सअ प्रोढअ जाणअ हई, तेखअ डाहणअ तूह तेरै दादा-बाबा ई ज़िहअ दाबी। तेरअ एक शोहरू बणाणअं मुंह ताह बाद तेरी ज़ैगा राज़अ अर तेऊओ राज़ करनअ मुंह होर बी बलबान। तेरअ सह शोहरू ई हणअ ज़हा मुल्है भबन बणाणअं अर तेरै खिंबै हणअ एक इहअ ज़सरअ राज़ सारी सदा रहणअ। तेऊओ बाब हणअ हुंह आप्पै अर सह हणअ मेरअ शोहरू। ज़ै सह गलती करे, तेऊ लै दैणीं मुंह आप्पै सज़ा ज़िहअ एक बाब करा।”</para>
  <para style="ipr">(7:10-14)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">दाबेद यहूदा मुल्खो राज़अ 1:1—4:12</para>
  <para style="io1">सारै इज़राईला दी दाबेदो राज़ 5:1—24:25</para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s">दाबेदा का लागअ शाऊले मरनैओ थोघ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />राज़अ शाऊल गअ त ऐबै मरी, दाबेद त गअ द अमोलकी का जुध ज़िती सकाल़ग नगरी एछी अर तिधी गऐ तै तेऊ एछी दूई धैल़ै हई। <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />दुजै धैल़ै आअ राज़ै शाऊले सैना मांझ़ा का एक ज़ुआन मणछ बच़ी। तेऊ धेल़ै शोग रहैऊंणा लै आपणैं झिकल़ै संघा पाअ आपणैं मुंडै धूल़अ-माट्टअ। सह पुजअ दाबेदा सेटा संघा टेक्‍कअ धरनीं उटी बाखा माथअ। <verse eid="2SA 1:2" /><verse number="3" style="v" sid="2SA 1:3" />दाबेदै पुछ़अ तेऊ का, “तूह किधा का आअ?”</para>
  <para style="p" vid="2SA 1:3">तेऊ बोलअ इहअ, “हुंह आअ इज़राईली सैने दला जैंदरा का बच़ी।”<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />दाबेदै पुछ़अ सह, “ओर्ही खोज़ मुखा किज़ै हुअ?”</para>
  <para style="p" vid="2SA 1:4">तेऊ दैनअ ज़बाब, “म्हारी सैना ठुर्ही जुधा का पिछ़ू अर म्हारै पाऐ खास्सै मणछ मारी। राज़अ शाऊल अर तेऊओ शोहरू जोनातान बी पाऐ मारी!”<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />दाबेदै पुछ़अ तेऊ का, “तूह किहअ करै सका बोली कि राज़अ शाऊल अर तेऊओ शोहरू जोनातान गऐ मरी?”<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 31:1-6">1 शमू. 31:1-6</ref>; <ref loc="1CH 10:1-6">1 इति. 10:1-6</ref></char>
    </note>तेऊ दैनअ ज़बाब, “मालक, हुंह त कुदरती तिधी गिलबा धारा, मंऐं भाल़अ कि शाऊल आसा आपणैं बर्छ़ै दी नील़ लाअ द। दुशमणे रथ अर शुंआर तै तेऊ पिछ़ू पल़ै दै अर सह थिअ तेतरी ठिमकी आणअ द। <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />तेऊ भाल़अ फेर, तेथ शुझुअ तेऊ का हुंह संघा लाई तेऊ मुल्है हाक्‍का अर मंऐं बोलअ, ‘माहा राज़अ किज़ै हुकम आसा?’<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />“तेऊ पुछ़अ हुंह, ‘तूह कुंण आसा?’ मंऐं बोलअ इहअ, ‘हुंह आसा अमोलकी।’<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />“तेखअ बोलअ शाऊल राज़ै मुल्है, ‘ओर्ही एछ मुंह सेटा छ़ेक्‍कै, संघा मार मुंह! हुंह आसा खास्सअ ज़खमी हुअ द, अह दाह निस्सी मेरै ज़िर्हुई!’ <verse eid="2SA 1:9" /><verse number="10" style="v" sid="2SA 1:10" />तेखअ पाअ मंऐं सह इहअ सोठी मारी कि धरनीं बधल़ूई करै निं ऐबै अह केही बी बच़दअ आथी, तेता का पाऊं हुंह एऊ आपणैं हाथै मारी। तेखअ आअ हुंह तेऊओ मुगट अर बाहे सनांगणूं लई इधी ताह आपणैं मालका सेटा लै।”<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />दाबेद हुअ खास्सअ दुखी अर तेऊ धेल़ै दुखै आपणैं झिकल़ै अर तिन्‍नैं होरी सोभी मणछै बी किअ तिहअ ई शोग। <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />तिंयां रहै सारी धैल़ी हिक्‍का पटाक्‍की लेरा लाई शोग मनाऊंदै अर शाऊल, जोनातान रहै बिधाते परज़ा इज़राईली लै उडै तैणीं कहतू, किल्हैकि जुधा दी पाऐ तै खास्सै इज़राईली मारी।<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />दाबेदै पुछ़अ खबर पजैल़णैं आल़ै तेऊ खारकै मणछा का, “तूह किधो आसा?”</para>
  <para style="p" vid="2SA 1:13">तेऊ दैनअ ज़बाब, “हुंह आसा अमोलकी, हुंह आसा परदेसी, पर हुंह रहा थारै देशै।”<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />दाबेदै पुछ़अ तेऊ का, “ताह किधा का आई एतरी हिम्मत कि तंऐं मारअ सह राज़अ ज़सरअ अभिषेक बिधाता आसा किअ द! ताह धख बी डअर निं लागी? <verse eid="2SA 1:14" /><verse number="15-16" style="v" sid="2SA 1:15-16" />इहअ करै आणी तंऐं आप्पू लै आप्पै मौत! तंऐं बोलअ इधी आप्पै कि तंऐं मारअ सह मणछ आपणैं हाथै ज़ुंण बिधाता आप्पै अभिषेक करी राज़अ आसा बणाअं द!”</para>
  <para style="p" vid="2SA 1:15-16">तेखअ बोलअ दाबेदै आपणैं एकी आदमी लै, “मार एऊ!” तेऊ आदमी बाही तेऊ अमोलकी मणछा लै एही कि सह हुअ तिधी मरी हक्‍क।<verse eid="2SA 1:15-16" /></para>
  <para style="s">शाऊल अर जोनाताना लै गांठी दाबेदै शोगे एक गिह</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />दाबेदै गांठी शाऊल अर तेऊए शोहरू जोनाताना लै शोगे एक गिह। <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" /><note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="JOS 10:13">ज़ैह. 10:13</ref></char></note>संघा किअ हुकम कि ऐहा गिहा शखैल़ा यहूदा मुल्खे सोभी लोगा का। तैहा गिहा नाअं डाहअ, “कबाणे गिह” अर अह गिह आसा जशार नाओंए कताबा दी लिखी दी। गिहे बोल आसा इहै,<verse eid="2SA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="2SA 1:19" />“हे इज़राईल, तेरअ मशूर प्रधान पाअ तेरी उछ़टी धारा मारी!</para>
  <para style="q" vid="2SA 1:19">म्हारै शूरबीर बदल़ै धरनीं!<verse eid="2SA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="2SA 1:20" />गात नगरी निं खोज़ी,</para>
  <para style="q" vid="2SA 1:20">अशकलोन नगरीए बाता निं ऐहा खबरा फणाऊंई,</para>
  <para style="q" vid="2SA 1:20">पलिश्ती ज़ुंण बिधाता निं मंदै अर ज़ुंण खतैर निं करदै,</para>
  <para style="q" vid="2SA 1:20">तिन्‍नें बेटल़ी अर शोहरी हणीं नाच़णै जोगी खुश!<verse eid="2SA 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="2SA 1:21" />गिलबा धारा प्रैंदै निं लोल़ी सरग हुअ नां ओश लोल़ी पल़ी,</para>
  <para style="q" vid="2SA 1:21">तेथ निं खेचै कधि किछ़ लोल़ी पज़अ कि बिधाता लै भैंट आणे!</para>
  <para style="q" vid="2SA 1:21">किल्हैकि तैहा ज़ैगा हुई महान जोधे ढाल़ा नकदरी,</para>
  <para style="q" vid="2SA 1:21">राज़ै शाऊले ढाल़ रही तिधी च़िक्‍करै जैंदरी पल़ी,</para>
  <para style="q" vid="2SA 1:21">तधा बाद निं तेथ कधि तेल लेस्सअ!<verse eid="2SA 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="2SA 1:22" />जोनाताने कबाणा का निखल़ै दै कतीरा करै हआ तै जोधै च़ित्त,</para>
  <para style="q" vid="2SA 1:22">अर शाऊले तलबार करा ती शूरबीर दुशमणे धुआल़!<verse eid="2SA 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="2SA 1:23" />शाऊल अर जोनातान तै आपणीं अमरा</para>
  <para style="q" vid="2SA 1:23">लोग झ़ूरा तै शाऊल अर जोनाताना लै खास्सै,</para>
  <para style="q" vid="2SA 1:23">ज़िन्दगी बी ज़िऊई तिन्‍नैं संघा अर</para>
  <para style="q" vid="2SA 1:23">मूंऐं बी दुहै संघा,</para>
  <para style="q" vid="2SA 1:23">तेज़ तै तिंयां मुक्षरलै का बी खास्सै अर ज़ोर त तिन्‍नां सिहा ज़िहअ।<verse eid="2SA 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="2SA 1:24" />इज़राईली बेटल़ीओ, शाऊले तैणीं लाआ सोभै लेरा!</para>
  <para style="q" vid="2SA 1:24">तेऊ बन्हैऊंऐं तै तम्हां का बाछे लाल किम्मती झिकल़ै,</para>
  <para style="q" vid="2SA 1:24">अर तेऊ बन्हैऊंऐं तै तम्हां लै सुन्‍नें हार-शंगार।<verse eid="2SA 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="2SA 1:25" />आईओ! बडै जुधा दी भाल़ महान जोधै किहै डाहै धरनीं बदल़ी,</para>
  <para style="q" vid="2SA 1:25">तिंयां भाल़ दुशमणै किहै पाऐ मारी,</para>
  <para style="q" vid="2SA 1:25">जोनातान डाहअ गिलबा धारा धरनीं बदल़ी!<verse eid="2SA 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="2SA 1:26" />जोनातान, मेरै भाईआ! आझ़ भाल़ तंऐं मुल्है केही दाह लाई!</para>
  <para style="q" vid="2SA 1:26">मुंह गम्मा त सिधअ तूह ई!</para>
  <para style="q" vid="2SA 1:26">तूह भाल़ मुल्है किहअ खास्सअ झ़ूरा त,</para>
  <para style="q" vid="2SA 1:26">एतरी निं कुंण बेटल़ी बी झ़ूरदी आथी।<verse eid="2SA 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="2SA 1:27" />आईओ, शूरबीर जोधै डाहै धरनीं बदल़ी!</para>
  <para style="q" vid="2SA 1:27">तिन्‍नें अस्त्र-शस्त्र डाहै शोटी! तिंयां हुऐ बृथा।”<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s">दाबेद बणाअं यहूदी प्रैंदै राज़अ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />तेखअ पुछ़अ बादा का दाबेदै बिधाता, “हुंह किधी यहूदा मुल्खे नगरी लै डेऊं फिरी?”</para>
  <para style="p" vid="2SA 2:1">बिधाता दैनअ ज़बाब, “हाँ, डेऊंदअ लाग।”</para>
  <para style="p" vid="2SA 2:1">दाबेदै पुछ़अ, “तेथ हुंह कहा नगरी लै डेऊं?”</para>
  <para style="p" vid="2SA 2:1">बिधाता दैनअ ज़बाब, “तूह डेऊ हेब्रोन नगरी लै।” <verse eid="2SA 2:1" /><verse number="2" style="v" sid="2SA 2:2" /><note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="1SA 25:42">1 शमू. 25:42</ref>,<ref loc="1SA 25:43">43</ref></char></note>दाबेद डेऊअ हेब्रोन नगरी लै, आपणीं बेटल़ी जज्रेला का आणी दी आहीनोम अर कर्मेल नगरी का आणी दी नबाले बिधबा अबीगेल बी निंईं तेऊ दुहै आप्पू संघा। <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />आपणैं सोभ आदमी बी निंयैं दाबेदै तिन्‍नें बेटल़ी माठै संघी आप्पू संघै। तेखअ लागै तिंयां हेब्रोन नगरी बागै एकी गराऊंऐं रहंदै। <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />तेखअ आऐ हेब्रोन नगरीए लोग दाबेदा सेटा संघा किअ दाबेदे मुंडै जैतूनो तेल तरैल़ी करै अभिषेक कि ऐबै आसा यहूदे खिंबो नऊंअ राज़अ।<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1SA 31:11-13">1 शमू. 31:11-13</ref></char></note></para>
  <para style="p" vid="2SA 2:4">तेखअ खोज़अ दाबेदा का तिन्‍नैं कि गलाद मुल्खे जबेश नगरीए लोगै डाहै शाऊले हस्तू दाबी। <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />दाबेदै छ़ाडै जबेश नगरीए लोगा सेटा लै दूत अर तिन्‍नां का दैनअ इहअ समाद, “बिधाता लोल़ी ऐहा गल्‍ला पिछ़ू तम्हां लै खास्सी बर्गत दैनी कि तम्हैं रहै आपणैं राज़ै शाऊला लै खास्सै भरोस्सैमंद अर झणैल़ू कि तम्हैं डाहै बडअ अदर करी तेऊए हस्तू दाबी। <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />मेरी आसा बिधाता का एही अरज़ कि सह बी लोल़ी तम्हां लै तिहअ ई झणैल़ू अर भरोस्सैमंद रहअ। हुंबी निं थारी ऐहा भलाई बिस्सरदअ अर मुंह दैणअ तम्हां लै एतो फल ज़रूर। <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />हिम्मत डाहा, तम्हैं निं आपणअ हैअ चोल़ी! थारअ मालक राज़अ शाऊल गअ मरी, यहूदा गोत्रा आल़ै किअ मेरअ अभिषेक कि ऐबै आसा तिन्‍नों राज़अ हुंह।”<verse eid="2SA 2:7" /></para>
  <para style="s">इशबशेत बणाअं इज़राईलो राज़अ</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />राज़ै शाऊलो सैनापति त नेरीओ शोहरू अबनेर, तेऊ निंयं शाऊलो शोहरू इशबशेत जरदण पार माहानीम नगरी लै। <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />तिधी किअ तिन्‍नैं इशबशेतो अभिषेक कि सह आसा अशूरीए देशै गलाद मुल्खै, आशेर, जज्रेल, एप्रैम, बिन्यामीन अर सारै इज़राईला प्रैंदै राज़अ। <verse eid="2SA 2:9" /><verse number="10" style="v" sid="2SA 2:10" />शाऊले शोहरू इशबशेते अमर ती च़ाल़्ही साले ज़धू सह इज़राईलो राज़अ बणअ। तेऊ किअ दूई साला तैणीं राज़।</para>
  <para style="p" vid="2SA 2:10">पर यहूदा गोत्रा आल़ै रहै दाबेदे पक्षा लै पाक्‍कै, <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />दाबेदै किअ हेब्रोन नगरी यहूदे खिंबा प्रैंदै सात साल छ़हा भिन्‍नैं तैणीं राज़।<verse eid="2SA 2:11" /></para>
  <para style="s">यहूदा अर इज़राईलो हुअ आप्पू मांझ़ै जुध</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />नेरीओ शोहरू अबनेर, शाऊलो शोहरू इशबशेत अर तिन्‍नें आदमी डेऊऐ माहानीम नगरी का गबोन नगरी लै। <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />दाबेदे आदमी बी पुजै गबोन सअरा सेटा अर तिन्‍नों सैनापति त जोआब ज़सरी ईज सरूयाह आसा। इहअ करै बेठै दुही सैने दल सअरा आर-पार स्मोहरै। <verse eid="2SA 2:13" /><verse number="14" style="v" sid="2SA 2:14" />पारा बाखा बोलअ अबनेरै जोआबा लै, “हाम्हां छ़ांटणैं आप्पू मांझ़ा का सोभी का छ़ल़ैघ जोधै मणछ संघा करनअ तिन्‍नों मकाबलअ, हैनूं कुंण ज़िता!”</para>
  <para style="p" vid="2SA 2:14">जोआबै दैनअ ज़बाब, “ठीक आ, छ़ाड आदमी, एथ बाखा छ़ाडूं हुंह।”<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />पारा बाखा निखल़ै बिन्यामीन गोत्रा का शाऊले शोहरू इशबशेते पक्षा लै बारा शूर-बीर अर दाबेदे आदमी मांझ़ा बी निखल़ै बारा शूरबीर मकाबलै लै। <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />ज़ांऊं तिन्‍नों मकाबलअ हुअ, तिन्‍नें ढाकै एकी दुजे मूंड अर आपणीं-आपणीं तलबारा करै बाही एकी दुजे पेटे एही कि तिंयां दोहरी बाखे च़ौबी शूरबीर मूंऐं तिधी। तैही आसा तैहा गबोन ज़ैगा नाअं, “तलबारो खेच” पल़अ द।<verse eid="2SA 2:16" /></para>
  <para style="s">असाहेल मारअ</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />तेखअ हुअ तिधी घणअ जुध शुरू, दुही बाखा हुअ ज़बर मकाबलअ पर खिरी हारै अबनेर अर इज़राईले आदमी दाबेदे आदमी का। <verse eid="2SA 2:17" /><verse number="18" style="v" sid="2SA 2:18" />दाबेदे आदमी मांझ़ै तै सरूयाहे चअन शोहरू जोआब, अबीशै, असाहेल। असाहेल ठुर्हा त बणें हरनी ज़िहअ छ़ेक्‍कै। <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />असाहेल ठुर्हअ इज़राईली सैनापति अबनेरा पिछ़ू कोहरअ, तेऊ निं ओर्ही नां पोर्ही भाल़अ। <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />अबनेरै भाल़अ पिछ़ू संघा बोलअ इहअ, “तूह असाहेल आसा?”</para>
  <para style="p" vid="2SA 2:20">तेऊ बोलअ, “हाँ, असाहेल ई आसा हुंह।”<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />अबनेरै बोलअ, “मुंह पिछ़ू ठुहर्ने पा छ़ाड, तूह फिर ओर्ही-पोर्ही कहा होरी सपाही बाखा संघा छ़ड़ैऊ तेऊ का आप्पू लै अस्त्र-शस्त्र अर कवच।” पर असाहेल रहअ तेऊ ठिमकणा लै पिछ़ू ठुहर्दअ लागी। <verse eid="2SA 2:21" /><verse number="22" style="v" sid="2SA 2:22" />अबनेरै बोलअ असाहेला लै भिई, “मुंह पिछ़ू ठुहर्ने पा छ़ाड़! तूह किल्है च़ाल्‍लअ ज़बरी मेरै हाथै मरी? मुंह तेरै भाई जोआबा सेटा केऊ मुंहैं डेऊणअ?” <verse eid="2SA 2:22" /><verse number="23" style="v" sid="2SA 2:23" />पर असाहेल निं पिछ़ू हटअ! अबनेरै किअ आपणअ बर्छ़अ पिछ़ू बाखा अर बर्छ़अ खुभअ असाहेले पेटै इहअ कि सह निखल़अ तेऊए पिठी बाती पिछ़ू बाखा अर असाहेल हुअ तिधी मरी खतम। ज़ुंण बी तिधी आऐ, तिंयां रहै तिधी खल़्हुई ज़िधी असाहेले ल्हास ती पल़ी दी।<verse eid="2SA 2:23" /></para>
  <para style="s">अबनेर अर जोआब</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />पर जोआब अर अबीशै रहै अबनेरा पिछ़ू पल़ी अर धैल़अ उडी पुजै तिंयां अमाह धारा गियाह नगरी सम्हनै गबोन रेगीस्ताने बाता। <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />बिन्यामीनी आदमी हुऐ अबनेरा संघै कठा संघा हुऐ भिई धारे च़ुंडी दी खल़ै। <verse eid="2SA 2:25" /><verse number="26" style="v" sid="2SA 2:26" />अबनेरै लाई जोआबा लै हाक्‍का संघा बोलअ इहअ, “हाम्हां कै सदा रहणअ एकी-दुजै मारदै लागी? ताखा निं शुझदअ कि एऊ झ़गल़ैओ नतिज़अ हणअ नज़िरन अर कल़ुअ ई? हाम्हैं थारै ई भाई-बंध निं आथी? ताह केभै तैणीं निं आपणैं आदमी लै हुकम करनअ कि म्हारअ पिछ़अ करनअ छ़ाडा?”<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />जोआबै दैनअ ज़बाब, “हुंह काढा ज़िऊंदै बिधाते सोह, ज़ै तंऐं गल्‍ला निं किई हंदी तै हणैं तै मेरै आदमी काल्‍ला दोत्ती तैणीं तम्हां पिछ़ू पल़ै दै।” <verse eid="2SA 2:27" /><verse number="28" style="v" sid="2SA 2:28" />तेखअ बाज़अ जोआबै नर्शिंगअ संघा खल़्हुऐ सोभ अर तेखअ निं तिंयां इज़राईली पिछ़ू डेऊऐ अर सह जुध बी मुक्‍कअ।<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />अबनेर अर तेऊओ दल डेऊअ तधू ई राचो-राच अराबा बाती आपणैं आदमी जरदण नदी पार टपी अर दुजै धैल़ै दोत्ती पुजै तिंयां माहानीम।<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />ज़ांऊं जोआब अबनेरो पिछ़अ करनअ छ़ाडी बापस फिरअ, तेऊ शादै आपणैं सोभ आदमी अर तेऊ भाल़अ कि दाबेदे आदमी मांझ़ै निं उन्‍नीं ज़ण्हैं आथी अर असाहेल बी निं आथी। <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />पर दाबेदे आदमी मारै बिन्यामीन गोत्रा आल़ै अबनेरे चअन शौ शाठ आदमी। <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />जोआब अर तेऊए आदमी निंईं असाहेले ल्हास आप्पू संघै, संघा डाही बेतलेम नगरी तैहा घोरी दाबी ज़िधी तेऊओ बाब त दाबी डाहअ द। तेखअ रहै तिंयां सारी राची हांढदै लागी, संघा पुजै तिंयां दुजै धैल़ै दोत्ती हेब्रोन नगरी बापस फिरी।<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />शाऊले खिंबे पक्षे लोगा अर दाबेदे पक्षे लोगा मांझ़ै रहअ अह झ़गल़अ खास्सी साला तैणीं पल़ी। दाबेद रहअ बलबान हंदअ लागी अर शाऊले खिंबो बल रहअ धैल़ी-धैल़ी उंधै घटदअ लागी।<verse eid="2SA 3:1" /></para>
  <para style="s">दाबेदे शोहरू</para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />हेब्रोन नगरी रहंदी हुऐ दाबेदे खास्सै शोहरू, तेऊओ सोभी का ज़ेठअ शोहरू त तेऊए जज्रेला का आणी दी बेटल़ी आहीनोमा का हुअ द, तेऊ नाअं त अमनोन। <verse eid="2SA 3:2" /><verse number="3" style="v" sid="2SA 3:3" />तेऊ कान्हअ त कर्मेल नगरी का आणी दी नबाले बिधबा अबीगेला का हुअ द, तेऊ नाअं त किलाब। दाबेदै ती गशूर नगरीए राज़ै तलमाईए शोहरी माकाहा बी आणी दी, चिऊथअ शोहरू त तैहा का हुअ द। तेऊ नाअं त अबशलोम। <verse eid="2SA 3:3" /><verse number="4" style="v" sid="2SA 3:4" />च़ौथअ शोहरू हुअ तेऊए हागीता नाओंए बेटल़ी का, तेऊ नाअं त अदोनियाह। पांज़ूऐ शोहरू नाअं त शपताह अर तेऊए ईज थिई अबीताल। <verse eid="2SA 3:4" /><verse number="5" style="v" sid="2SA 3:5" />छ़हुअ शोहरू त ईतराम अर तेऊए ईजा नाअं त एगला। हेब्रोन नगरी हुऐ दाबेदे ईंयां छ़ह शोहरू।<verse eid="2SA 3:5" /></para>
  <para style="s">शाऊलो सैनापति अबनेर फिरअ दाबेदा बाखा</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />शाऊल अर दाबेदे खिंबा त आप्पू मांझ़ै झ़गल़अ लागअ ई द। शाऊले पक्षे लोगा मांझ़ै त अबनेर होर बी बलबान हंदअ लागअ द।<verse eid="2SA 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 3:7" />शाऊले ती एक डाही दी बेटल़ी, तैहा नाअं त रिज़पा अर सह थिई अईयाहे शोहरी। अबनेर रहअ-बस्सअ तैहा संघै अर शाऊले शोहरू इशबशेतै बोलअ अबनेरा लै, “तूह मेरै बाबे डाही दी बेटल़ी संघै किल्है सुत्तअ?” <verse eid="2SA 3:7" /><verse number="8" style="v" sid="2SA 3:8" />ऐहा गल्‍ला पिछ़ू आई अबनेरा इशबशेता लै रोश्शै संघा लागअ इहअ बोल्दअ, “तेरअ कै मतलब? मंऐं कै इहअ करै शाऊला लै धोखअ दैनअ? तंऐं कै हुंह कुक्‍कर समझ़अ कि हुंह आसा यहूदा मुल्खा आल़ेए टुकरै खांदअ लागअ द? आझ़ तैणीं रहअ हुंह तेरै बाब शाऊल, तेऊए भाई अर तेऊए सोभी साथी लै शुचअ-पाक्‍कअ! ताह निं मंऐं दाबेदे हाथै पल़णै दैनअ। तूह आसा लागअ द आझ़ धख ज़ेही गल्‍ला लै ऐहा बेटल़ी पिछ़ू मुंह दी खोट लोल़अ! <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="1SA 15:18">1 शमू. 15:18</ref></char></note>बिधाता लोल़ी तै मुल्है घोर आफ़त पाई! कि लोल़ी हुंह पठी मारअ ज़ै हुंह दाबेदा लै तिन्‍नां सोभी गल्‍ला पूरी हणां लै मज़त निं करूं ज़ेते बिधाता तेऊ लै करार आसा किई दी। <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />बिधाता आसा बोलअ द कि शाऊले खिंबा का निं आजू तेऊ ऐबै भिई राज़अ बणाणअं अर तेऊए ज़ैगा बेशणअ आजू दाबेद इज़राईल अर यहूदा दुही मुल्खो राज़अ। तेऊओ हणअ उतरा बाखा दान अर दखण बेर्शेबा तैणीं राज़। <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />इना गल्‍ला शूणीं डरअ अबनेरा का इशबशेत खास्सअ अर तेऊ निं तेता आजू एक बैण बी बोलअ।”<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />अबनेरै छ़ाडै दाबेदा सेटा हेब्रोन नगरी लै दूत, तिन्‍नां का दैनअ तेऊ इहअ समाद, “सारै देशा प्रैंदै लोल़ी तूह एक्‍कै राज़अ हुअ, ज़ै तूह मुंह संघै करार करे, तै फरेऊंणै मुंह सारै इज़राईली ताह बाखा कि तूह आसा सोभिओ राज़अ।”<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />दाबेदै दैनअ तेऊ लै ज़बाब, “राम्बल़ी गल्‍ल आसा! हुंह करूं ताह संघै करार पर तेता लै हुई ताह एक गल्‍ल करनी कि ज़ेभै तूह मुंह सेटा लै मिलदअ एछे, तेभै लोल़ी तंऐं शाऊले शोहरी मिकल आप्पू संघै मुंह सेटा लै ज़रूर आणी।” <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />राज़ै शाऊले शोहरू इशबशेता सेटा लै बी छ़ाडै दाबेदै दूत इहअ समाद पजैल़ै, “मेरी लाल़ी मिकला दैऐ मुल्है बापस, तैहा संघै बैह करनै पिछ़ू आसा मंऐं एक शौ पलिश्ती मर्धे खतैर करी एक शौ खलेफ़ल़ी मोल दैनी दी।”<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="1SA 18:27">1 शमू. 18:27</ref></char></note> <verse eid="2SA 3:14" /><verse number="15" style="v" sid="2SA 3:15" />इशबशेतै छ़ाडै आपणैं आदमी लैशे शोहरू पलतीएला सेटा संघा आणी तेऊ का मिकल बापस छ़ड़ैऊई।<verse eid="2SA 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 3:16" />पलतीएल आअ लेरा लांदी-लांदी तैहा पिछ़ू बहूरीम नगरी तैणीं। तेखअ बोलअ अबनेरै तेऊ लै, “घअरा लै डेऊ फिरी,” इहअ करै फिरअ सह तेखअ आपणैं घअरा लै बापस।<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />अबनेर डेऊअ इज़राईली सैणैं सेटा संघा किई तिन्‍नां संघै एही गल्‍ला, “कधू ओर्ही आसा तम्हैं इहअ बोल्दै लागै दै कि दाबेद लोल़ी तम्हां प्रैंदै राज़अ हुअ। <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />ऐबै आसा तम्हां लै मोक्‍कअ, आद करा कि बिधाता आसा दाबेदे बारै इहअ बोलअ द, ‘आपणैं दास दाबेदा करै छ़ड़ैऊंणी मुंह आपणीं इज़राईली परज़ा पलिश्ती अर तिन्‍नें सोभी दुशमणा का।’” <verse eid="2SA 3:18" /><verse number="19" style="v" sid="2SA 3:19" />अबनेरै किई बिन्यामीन गोत्रा आल़ै संघै बी गल्‍ला, संघा डेऊअ सह हेब्रोन नगरी लै दाबेदा सेटा इहअ खोज़दअ कि बिन्यामीन गोत्रा आल़ै अर सोभै इज़राईली आसा राज्ज़ी।<verse eid="2SA 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 3:20" />ज़ांऊं अबनेर आपणैं खास बिह आदमी संघा निंईं दाबेदा सेटा हेब्रोन नगरी पुजअ, दाबेदै दैनी तिन्‍नां लै धाम। <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />अबनेरै खोज़अ दाबेदा का, “माहा राज़अ, मेरै मालक, ऐबै दै मुंह एभी डेऊणैं, मुंह करनअ ताल्है सोभी इज़राईलीओ झाल़अ, ताकि तिंयां ताह संघै करार करे। तूह हणअ तेखअ सोभी इज़राईली प्रैंदै राज़अ ज़िहअ तूह च़ाहा बी।” तेखअ दैनअ दाबेदै अबनेर इहअ बोली सबाही कि ताह निं हुंह किछ़ हणैं दैंदअ अर सह बी डेऊअ राज्ज़ी-राम्बल़अ बापस फिरी।<verse eid="2SA 3:21" /></para>
  <para style="s">अबनेरे हत्या</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />अबनेर गअ त हेब्रोन नगरी का राज्ज़ी-राम्बल़अ बापस फिरी, जोआब अर दाबेदे सैनो एक दल पुजअ दुशमणे गराऊंआं खास्सै लुटी बापस। <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />जोआबा का हेरअ पुजदी कुंणी खोज़ी, “नेरीओ शोहरू अबनेर आअ त राज़ै सेटा अर राज़ै छ़ाडअ सह राज्ज़ी-राम्बल़अ बापस कि तेऊ निं सह किछ़ हणैं दैंदअ।”<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />जोआब डेऊअ राज़ै दाबेदा सेटा संघा बोलअ इहअ, “तंऐं अह कै किअ? अबनेर आअ ताह सेटा अर तंऐं दैनअ तेऊ डेऊणैं! ऐबै गअ सह खास्सअ दूर निखल़ी! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />ताखा नेरीए शोहरू अबनेरो थोघ बी आसा? तेऊ किअ ताह संघै धोखअ! सह आअ ताह सेटा इहअ भाल़अ कि तूह किज़ै करा अर तेरी सैना दी केचल़अ बल आसा।”<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />ज़ांऊं जोआब दाबेदा सेटा का निखल़अ, तेऊ छ़ाडै अबनेरा सेटा लै दूत अर तिन्‍नैं आणअ सह सीरा नाओंए कुहै सेटा का बापस फरेऊई, पर दाबेदा का निं इना गल्‍लो थोघ आथी त। <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />ज़ांऊं अबनेर हेब्रोन नगरी पुजअ, जोआबै निंयं सह नगरीए प्रऊल़ी सेटा का पोर्ही ज़िहअ कांगनरांगै गल्‍ला करना लै। तिधी बाही तेऊए पेटै एही कि सह मूंअ तिधी। सह मारअ तेऊ एता पिछ़ू कि अबनेरै थिअ जोआबो भाई असाहेल मारअ द। <verse eid="2SA 3:27" /><verse number="28" style="v" sid="2SA 3:28" />ज़ांऊं दाबेदा का ऐहा गल्‍लो थोघ लागअ, तेऊ बोलअ, “ऐहा गल्‍लो शाजत आसा बिधाता आप्पै कि नेरीए शोहरू अबनेरे हत्या करनै पिछ़ू निं मेरअ धख ज़िहअ दोश बी आथी। <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />एते सज़ा लोल़ी जोआब अर तेऊए टबरा भेटी! जोआबे लोल़ी आजू हर पोस्ती दी कहा नां कहा मणछा कोहल़ निखल़ी, धात रोग हुअ, लाट्टअ हुअ, कुंण लोल़ी तलबारा करै मारअ अर कहा लोल़ी भुखै ब्रत लागै!” <verse eid="2SA 3:29" /><verse number="30" style="v" sid="2SA 3:30" />इहअ करै लअ जोआब अर तेऊए भाऊ अबीशै अबनेरा मारी आपणैं भाई असाहेला मारनैओ बदल़अ ज़ुंण गबोन जुधा लै मारअ द।<verse eid="2SA 3:30" /></para>
  <para style="s">अबनेरा लै किअ शोग</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />तेखअ बोलअ दाबेदै जोआब अर तेऊ संघै सोभी लोगा लै, “आपणैं झिकल़ै धेल़ी अर कुछी खिंथल़ै बान्हीं करा अबनेरा लै शोग।” आप्पू लागअ राज़अ दाबेद अबनेरे ल्हासा पिछ़ू-पिछ़ू हांढदअ। <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />तेखअ डाहअ तिन्‍नें अबनेर हेब्रोन नगरी एकी ज़ैगा दाबी। राज़अ दाबेद लागअ तिधी ज़ोरै-ज़ोरै लेरा लांदअ अर तिधी आऐ दै होरी सोभी लोगै बी लाई खास्सी लेरा। <verse eid="2SA 3:32" /><verse number="33" style="v" sid="2SA 3:33" />राज़ै दाबदै गांठी अबनेरे बारै शोग प्रगट करना लै एही गिह,</para>
  <para style="q" vid="2SA 3:33">“अबनेर इहअ ऐडै ज़िहअ किल्है मूंअ आरो?<verse eid="2SA 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="2SA 3:34" />नां तेऊए हाथ तै बान्हैं दै,</para>
  <para style="q" vid="2SA 3:34">नां तेऊए पिल्‍ली शांघल़ी-लोहै आथी तै लाऐ दै!</para>
  <para style="q" vid="2SA 3:34">सह मारअ इहअ ज़िहै ज़ुल्म करनै आल़ै मारा!”</para>
  <para style="p" vid="2SA 3:34">तेखअ लागै भिई तिधी सोभ लोग लेरा लांदै।<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />दाबेद रहअ भुखअ अर होर लागै तेऊ लै बोल्दै कि धख रोटी ता खा, पर दाबेदै खाऐ इहै सोह, “ज़ै हुंह धैल़अ उडणैं का आजी रोटीओ म्हार बी खाऊं तै लोल़ी बिधाता मुल्है इहअ ई बूरअ किअ, मुल्है लोल़ी मौत ई आई!” <verse eid="2SA 3:35" /><verse number="36" style="v" sid="2SA 3:36" />तेखअ दैनअ सोभी राज़ै दाबेदे तैहा गल्‍ला दी धैन अर संघा मनै सोभै, ज़िहै तिंयां हर बगत तेऊए गल्‍ला मना तै। <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />तेखअ गअ यहूदा अर इज़राईल सोभी लोगा का थोघ लागी कि नेरीए शोहरू अबनेरे हत्या करनै पिछ़ू निं राज़अ दाबेद धख बी आथी। <verse eid="2SA 3:37" /><verse number="38" style="v" sid="2SA 3:38" />तेखअ बोलअ राज़ै दाबेदै आपणैं कार-करिंदै लै, “तम्हां निं ज़ाण्हुंअ कि आझ़ मूंअ इज़राईला जैंदरी एक महान प्रधान अर जोधअ? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />एही ता आसा हुंह बिधाता अभिषेक करी राज़अ बणाअं द, पर मुखा ज़ाण्हिंआं कि आझ़ घटअ मेरअ बल। ईंयां सरूयाहे दूई शोहरू जोआब अर अबीशै आसा काबू करनै मेरै बशा का बागै। बिधाता लए ऐबै इना का ऐहा हत्या करनैओ बदल़अ आप्पै ज़िहअ बूरअ इनै किअ तिहअ ई।”<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s">इशबशेते हत्या</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />ज़ांऊं शाऊले शोहरू इशबशेता का थोघ लागअ कि अबनेर पाअ हेब्रोन नगरी मारी, सह डरअ खास्सअ अर इज़राईल मुल्खे लोगा बी पल़अ सोभी हैल़अ। <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />शाऊले शोहरू इशबशेता संघै तै दूई ज़ण्हैं दूई दले सैणैं बानाह अर रकाब। ईंयां दुहै तै बरोत नगरी का रमोने शोहरू बिन्यामीन गोत्रा का। बरोत नगरी थिई बिन्यामीन गोत्रे हेस्सै। <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />बरोत रहणैं आल़ै लोग तै बरोत नगरी छ़ाडी गतैम नगरी लै ठुर्है दै अर तेखअ बस्सै तिधी।<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 9:3">2 शमू. 9:3</ref>
      </char>
    </note>शाऊले शोहरू जोनातानो बी थिअ एक शोहरू, सह थिअ लाट्टअ अर तेऊ नाअं त मोपीबशेत, ज़धू जोनाताने मौत हुई, तधू त सह पांज़ा सालो शोहरू। ज़ांऊं जज्रेला का जोनातान मरने खबर पुजी, तेऊ शोहरू धाचणै आल़ी बेटल़ी ठुर्ही तेऊ शोहरू च़की तुआखुई करै संघा बधल़ूई धरनीं अर सह शोहरू हुअ इहअ करै लाट्टअ।<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />बरोत नगरीए रमोने शोहरू रकाब अर बानाह आऐ खरै दपहरै इशबशेते घअरा लै अर सह थिअ घणीं निंजा सुत्ती राम करदअ लागअ द। <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />तिंयां दुहै डेऊए पांडा भितरा लै कणका आणने भान्‍नै, भितरी बाही तिन्‍नैं इशबशेते पेटै संघा पाअ मारी। संघा ठुर्है रकाब अर तेऊओ भाई बानाह तिधा का दुहै। <verse eid="2SA 4:6" /><verse number="7" style="v" sid="2SA 4:7" />हुअ इहअ कि ज़ांऊं तिंयां पांडा भितरी डेऊऐ, इशबशेत त भितरी घणीं निंजा सुत्तअ द अर तिन्‍नैं पाअ सह मारी। तिन्‍नैं निंयं तेऊओ मूंड काटी आप्पू संघा। तेखअ निखल़ै राचो-राच जरदण अराबा का हांढी दूर। <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />तिन्‍नैं निंयं इशबशेतो मूंड हेब्रोन नगरी राज़ै दाबेदा सेटा संघा लागै इहअ बोल्दै, “इधी आणअ भाल़ हाम्हैं तेरै दुशमण शाऊले शोहरू इशबशेतो मूंड काटी। मेरै मालक, शाऊल त ताह मारदअ तेरै पिछ़ै पल़अ द। आझ़ लअ बिधाता शाऊल अर तेऊए लुआदा का बदल़अ।”<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />दाबेदै दैनअ बरोती रमोने शोहरू रकाब अर तेऊए भाई बानाह लै ज़बाब, “ज़िऊंदअ परमेशर बिधाता ज़ुंण मुंह हर खरी अर आफ़ता का बच़ाऊआ, हुंह खाआ तेऊए सोह! <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />सकाल़ग नगरी का आअ त मुंह सेटा एक शाऊले मौते खबर इहअ सोठी कि अह हणीं मुल्है खुशीए खबर। सह मणछ किअ मंऐं तेभी कैद संघा पाअ मारी। सह भेटअ तेऊ तैहा खुशीए खबरो फल!<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2 शमू. 1:1-16</ref></char></note> <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />तै ऐबै तिन्‍नां मणछे केही बूरी दशा हणीं ज़ुंणीं एक निंजा सुत्तअ द नर्दोश मणछ तेऊए ई घअरा भितरी पाअ मारी! ऐहा हत्या करनैओ बदल़अ लणअ मुंह तम्हां का लई अर थारअ निं मुंह धरती दी नाअं-नशाण ई डाहणअ!” <verse eid="2SA 4:11" /><verse number="12" style="v" sid="2SA 4:12" />तेखअ किअ दाबेदै हुकम संघा पाऐ रकाब अर बानाह मारी। सपाही काटै तिन्‍नें हाथ खूर अर तिन्‍नें ल्हासा डाही हेब्रोन नगरी सअरा सेटा छ़ड़ाऊई। तिन्‍नें निंयं इशबशेतो मूंड संघा डाहअ हेब्रोन नगरी तिधी दाबी ज़िधी अबनेर थिअ दाबअ द।<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s">दाबेद बणअ इज़राईल अर यहूदा दुही मुल्खो राज़अ</para>
  <para style="r">(<ref loc="1CH 11:1-9">1 इतिहास 11:1-9</ref>; <ref loc="1CH 14:1-7">14:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />इज़राईले सोभ गोत्र हुऐ हेब्रोन नगरी दाबेदा सेटा कठा संघा लागै तेऊ लै बोल्दै, “हाम्हैं सोभै आसा एकी हाड-खिंबे। <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />ज़धू शाऊल राज़अ थिअ, तधू बी थिअ जुधे बगती इज़राईली लै सोभी का आजू तूह ई अर बिधाता आसा ताल्है इहअ बोलअ द, ‘मेरी परज़ा इज़राईलीओ फुआल अर तिन्‍नां प्रैंदै राज़अ हणअ तूह ई।’”<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />तैहा सभा दी किअ इज़राईली सोभी सैणैं अर दाबेदै आप्पू मांझ़ै करार अर बिधाता डाहअ तेतो शाजत। तेखअ किअ इज़राईली सैणैं दाबेदे मुंडै जैतूनो तेल तरैल़ी हेब्रोन नगरी अभिषेक कि ऐबै आसा सह सोभी इज़राईलीओ राज़अ। <verse eid="2SA 5:3" /><verse number="4" style="v" sid="2SA 5:4" /><note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="1KI 2:11">1 राज़. 2:11</ref>; <ref loc="1CH 3:4">1 इति. 3:4</ref>; <ref loc="1CH 29:27">29:27</ref></char></note>तधू ती दाबेदे अमर तिहा साले अर तेऊ किअ आजू च़ाल़्ही साला तैणीं राज़। <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />साता साला तैणीं किअ तेऊ हेब्रोन नगरी का यहूदा प्रैंदै राज़ अर तेत्ती साला किअ तेऊ एरुशलेम नगरी का सोभी इज़राईली प्रैंदै राज़।<verse eid="2SA 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="JOS 15:63">ज़ैह. 15:63</ref>; <ref loc="JDG 1:21">पांच़ 1:21</ref></char>
    </note>एरुशलेम नगरी तै जबेशी लोग बस्सै दै, राज़ै दाबेदै छ़ेल़अ आपणीं सैना लई तिन्‍नां संघै जुध। जबेशी सोठअ इहअ कि दाबेद निं म्हारी नगरी ज़िती सकदअ अर तिन्‍नैं बोलअ दाबेदा लै इहअ, “तूह निं म्हारी नगरी भितरी कधि एछी सकदअ! ज़ै हाम्हैं कांणै अर लाट्टै बी हंदै, तैबी काढणअ त तूह हाम्हां इधा का दरल़ाऊई।”<verse eid="2SA 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 5:7" />पर दाबेदै ज़ितअ तिन्‍नों सियोन नाओं गहल़ अर तेता नाअं आसा आझ़ तैणीं बी दाबेदपूर<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="fq" closed="false">दाबेदपूर </char><char style="ft" closed="false">दाबेदे नगरी</char></note> पल़अ द। <verse eid="2SA 5:7" /><verse number="8" style="v" sid="2SA 5:8" />दाबेदै बोलअ त तधू आपणैं आदमी लै इहअ, “इना जबेशी मारदै उखल़ा तम्हैं गहल़ा का पाणीं बागै निखल़णें नाल़ा बाती उझै। मुंह आसा इना लाट्टै अर कांणै मणछा का खास्सी नफरत।” तधा पोर्ही च़ली एही कहाबत, “कांणै अर लाट्टै निं मैहला भितरी एछी सकदै।”<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />सियोन गहल़ा गिम्मी बस्सअ दाबेद तिधी अर तैहा नगरी नाअं पल़अ, “दाबेदे नगरी।” तेऊ च़िणअ तैहा नगरी फेर भिई धारे पुर्बा बाखा बढेरी करै बडी गहल़। <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />दाबेद रहअ बलबान अर मशूर हंदअ लागी किल्हैकि स्वर्गे सारी सैने मालक बिधाता थिअ तेऊ संघा ज़हा का सारअ बल आसा।<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />सूर नगरीए राज़ै हिरामै छ़ाडै दाबेदा सेटा दूत अर तिन्‍नां संघै छ़ाडै तेऊ काठे अर पात्थरे कारीगीर अर राज़ै दाबेदे मैहल बणाणां लै केल़ुईए काठ। <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />तेखअ हेरअ दाबेदै ज़ाणीं कि बिधाता किअ इज़राईली प्रैंदै तेऊओ राज़ पाक्‍कअ अर आपणीं परज़ा इज़राईलीए तैणीं बढेरअ तेऊ मेरअ राज़।<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />हेब्रोन नगरी का एरुशलेम एछी डाही दाबेदै आप्पू लै होर बी बेटल़ी अर तेऊए हुऐ होर बी खास्सै शोहरू-शोहरी। <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />एरुशलेम हुऐ तेऊए लुआद, शम्मू, शोबाब, नातान, सुलैमान <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />ईभार, एलीशू, नपेग, ज़ापी, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />एलीशामा, एल्यादा अर एलीपेलेत।<verse eid="2SA 5:16" /></para>
  <para style="s">पलिश्ती का ज़ीत</para>
  <para style="r">(<ref loc="1CH 14:8-17">1 इतिहास 14:8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />पलिश्ती का गअ थोघ लागी कि दाबेद बणअ सारै इज़राईला प्रैंदै राज़अ। तिन्‍नैं डाही आपणीं सैना दाबेदा ढाकणा लै छ़ाडी। ज़ांऊं दाबेदा का ऐहा गल्‍लो थोघ लागअ, सह रहअ तेखअ गहल़ै। <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />पलिश्ती आऐ रपाईम खागै संघा गिम्मी सह सारी ज़ैगा।<verse eid="2SA 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 5:19" />दाबेदै पुछ़अ बिधाता, “हुंह पलिश्ती संघै मकाबलै लै डेऊं? ताह मुल्है तिन्‍नां का ज़ीत दैणीं?”</para>
  <para style="p" vid="2SA 5:19">बिधाता दैनअ ज़बाब, “हाँ, डेऊ, मुंह हेरनअ तूह तिन्‍नां का ज़ताऊई!” <verse eid="2SA 5:19" /><verse number="20" style="v" sid="2SA 5:20" />तेखअ डेऊअ दाबेद बाल-परज़ीम अर तिधी पाऐ तेऊ पलिश्ती मारी। दाबेदै बोलअ इहअ, “बिधाता घ्रोहल़ै मेरै दुशमणा लै पाणीं हर्हला ज़िहै।” तैही डाहअ तेऊ तैहा ज़ैगा नाअं बाल-परज़ीम<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">बाल-परज़ीम </char><char style="ft" closed="false">घर्होहल़ै</char></note> <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />बच़ै दै पलिश्ती ठुर्है तिधा का अर तिन्‍नां का छ़ुटै तिन्‍नें देअआ-देबीए मैहरै तेतै अर दाबेद अर तेऊए आदमी आणै तिंयां झाल़ी।<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />तेखअ डेऊऐ पलिश्ती भिई रपाईम खागा लै संघा गिम्मी सह ज़ैगा भिई। <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />तेखअ डेऊअ दाबेद भिई बिधाता पुछ़दअ अर बिधाता बोलअ तेऊ लै इहअ, “तिन्‍नें मकाबलै लै निं मोहरै बाखा डेऊई, तूह मार तिन्‍नां लै घेरअ संघा रहअ बलसामे बूटा नेल़ तिन्‍नां लै ताखुई। <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />ज़ांऊं तूह बलसामे बूटा जैंदरी सैना हांढणे छ़ेल़ शुणें, तिधी पल़ै तम्हैं तिन्‍नां लै नभैऊशै चुटी। तम्हां आजू हणअ हुंह बिधाता आप्पै हांढदअ लागअ द अर तम्हैं हेरनै मुंह पलिश्ती का ज़ताऊई।” <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />ज़िहअ बिधाता हुकम किअ, दाबेदै किअ तिहअ ई अर पलिश्ती दरल़ाऊऐ तिन्‍नैं मारदी-मारदी गिबा नगरी पोर्ही गज़ेर नगरी तैणीं।<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s">बिधाते करारो मणशू आणअ एरुशलेम नगरी लै</para>
  <para style="r">(<ref loc="1CH 13:1-14">1 इतिहास 13:1-14</ref>; <ref loc="1CH 15:25-16:6">15:25—16:6,43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />दाबेदै शादै एकी बारी भिई इज़राईला मांझ़ै खास-खास शूरबीर, तिंयां थिऐ पठी कोई तिह हज़ार मर्ध। <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />दाबेदै निंयैं तिंयां यहूदा मुल्खै बाला नगरी लै कि स्वर्गे सारी सैने मालक बिधाता ज़हा का सारअ बल आसा अर ज़सरअ आसन करूब नाओंए फैंखा आल़ै स्वर्ग दूता प्रैंदै आसा, तेऊओ करारो मणशू आणनअ एरुशलेम नगरी लै।<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EXO 25:22">लुआ. 25:22</ref></char></note> <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />तिन्‍नैं काढअ बिधाते करारो मणशू धारठी प्रैंदै अबीनादाबे घअरा का बागै संघा बशैल़अ सह कोरी बैल गाड्डी प्रैंदै। अबीनादाबे शोहरू उज्ज़ा, आहीऊ लागै बैल गाड्डी आजू नढैऊंदै,<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 7:1">1 शमू. 7:1</ref>,<ref loc="1SA 7:2">2</ref></char></note> <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />आहीऊ त करारे मणशू संघै आजू लागअ द हांढदअ। <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />दाबेद अर तिधी आऐ दै होर सोभ इज़राईली लागै बिधातो अदर करना लै गिहा बोल्दै अर नाच़दै। तिंयां थिऐ कैलीए काठा करै बणाऐं दै बींन, बशूरी, ढोल नगारै, गुझू अर डफाला बाज़ी नाच़दै लागै दै।<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />ज़ांऊं तिंयां नाकोन नाओंए मणछे खहल़ै पुजै, तिधी लागी बल्दा ठोहल़ अर उज्ज़ा दैनी बिधाते करारे मणशू आपणैं हाथा करै थम्हणीं कि ढूल़अ निं लोल़ी। <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />तेऊ लै पल़अ तेभी बिधातो कोप अर सह मूंअ तिधी हेरा-हेरी करारे मणशू सेटा किल्हैकि तेऊ लाअ त आपणअ हाथ करारे मणशू दी<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="fq" closed="false">करारे मणशू दी </char><char style="ft" closed="false">करारे मणशू सका तै सिधै लेबी गोत्रे प्रोहत ई च़की अर छ़ुंहीं</char></note>। इहअ करै मूंअ उज्ज़ा तिधी बिधाता सम्हनै। <verse eid="2SA 6:7" /><verse number="8" style="v" sid="2SA 6:8" />दाबेद हुअ खास्सअ नराज़ किल्हैकि बिधातो कोप पल़अ उज्ज़ा लै, तिधा का बोला तैहा ज़ैगा लै आझ़ तैणीं बी फिरिस-उज्ज़ा।<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />तधू डरअ दाबेद बिधाता का खास्सअ संघा लागअ इहअ बोल्दअ, “ऐबै मुंह बिधाते करारो मणशू आप्पू संघै किहअ करै निंणअ?” <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />तेखअ सोठअ दाबेदै इहअ कि अह बिधाते करारो मणशू निं एरुशलेम नगरी लै निंणअ ई आथी अर सह फिरअ तिधा का गात नगरीए ओबेद-एदोमे घअरा बाखा लै संघा पजैल़अ करारो मणशू तिधी। <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />तिधी रहअ बिधाते करारो मणशू चिई भिन्‍नैं तैणीं अर बिधाता दैनी ओबेद-एदोम अर तेऊए टबरा लै खास्सी बर्गत।<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="1CH 26:4">1 इति. 26:4</ref>,<ref loc="1CH 26:5">5</ref></char></note><verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />ज़ांऊं राज़ै दाबेदै शूणअ कि बिधाते करारे मणशू करै हुई ओबेद-एदोमे घअरै सोभी गल्‍ला दी खास्सी बर्गत। तेखअ डेऊअ दाबेद संघा आणअ करारो मणशू दाबेदपूर नगरी लै, तैहा खुशी मनाऊंईं तिन्‍नैं बडी जाच। <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />ज़ांऊं बिधाते करारे मणशू च़कणै आल़ै लेबी छ़ह गंईं आजू हांढै, दाबेदै किअ एक बल्द अर आपणअ आप्पै धाचअ द बाछ़ू बल़ीदान। <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />दाबेदै त घेरी बाछो च़ोल़अ अर गाची बान्हीं दी संघा त बिधाते अदर करना लै नाच़दअ लागअ द। <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />इहअ करै आणअ दाबेदै अर होरी सोभी इज़राईली बिधाते करारो मणशू एरुशलेम नगरी लै ज़ै-ज़ैकार करदी अर नर्शिंगै बाज़दी।<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />ज़ांऊं बिधाते करारो मणशू दाबेदपूर नगरी बाखा लै एछदअ त लागअ द, राज़ै शाऊले शोहरी मिकल ती तीरू बाती बागै दाबेदा नाच़दै भाल़ी लागी दी, तैहा समझ़अ दाबेदो सह तिहअ करनअ बृथा। <verse eid="2SA 6:16" /><verse number="17" style="v" sid="2SA 6:17" />तिन्‍नैं आणअ बिधातो करारो मणशू तैहा ज़ैगा लै ज़िधी दाबेदै तेता लै खिम्भ त डाहअ द खल़अ करी। तेखअ किऐ दाबेदै तिधी बिधाता लै हूम अर मेल़-ज़ोल़े बल़ीदान। <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />ज़ांऊं दाबेद हूम अर मेल़-ज़ोल़े बल़ीदान दैई मुक्‍कअ, तेखअ दैनी तेऊ स्वर्गे सारी सैने मालक बिधाते नाओंऐं सारी परज़ा लै बर्गत ज़हा का सारअ बल आसा। <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />तेखअ बांडअ तेऊ इज़राईली सारी परज़ा लै मर्ध-बेटल़ी संघी एक-एक रोटी भोज़न, एक-एक शिखे टांक अर एक-एक दाखे टिक्‍की। संघा डेऊऐ सोभै आपणैं-आपणैं घअरा लै।<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CH 16:43">1 इति. 16:43</ref></char></note><verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />एता बाद ज़ांऊं दाबेद आपणैं नातै-रिश्तैदारा लै बर्गत दैंदअ फिरअ, तेखअ आई शाऊले शोहरी मिकल दाबेदा सेटा मिलदी संघा लागी एही टाभा बाहंदी, “इज़राईले राज़ै किई आपणीं आझ़ खास्सी मशूरी! तंऐं रहैऊई ऐडै-बेगरै ज़ेही आपणीं नांगी घेर आपणैं कार-करिंदै अर गलाम बेटल़ी का! तिहअ करै भाल़ तेरअ किहअ प्रतप्प शुझुअ!”<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />दाबेदै दैनअ मिकला लै ज़बाब, “हुंह त बिधातो अदर करना लै नाच़दअ लागअ द, ज़ुंणीं बिधाता हुंह तेरै बाबे अर तेऊए खिंबे बदल़ै इज़राईलीओ राज़अ बणाअं। मुंह रहणअ बिधातो अदर करना लै नाच़दै लागी। <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />मुंह बणनअ एता का बी खास्सै च़िल़्हखरै अर ज़हा गलाम शोहरीए तूह गल्‍ला करा, तिन्‍नां बी करनअ मेरअ अदर।”<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />शाऊले शोहरी मिकले निं कधि आद-लुआद हुई अर सह मूंईं बांढी ई।<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s">नातान गूरो दाबेदा लै समाद</para>
  <para style="r">(<ref loc="1CH 17:1-15">1 इतिहास 17:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />राज़अ दाबेद रहा त आपणैं मैहलै अर बिधाता त सह तेऊए सोभी दुशमणा का बच़ाऊई डाहअ द। <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />तेखअ बोलअ राज़ै नातान नाओंए गूरा लै, “इधी भाल़, हुंह आसा आप्पू केल़ुईए काठा करै बणाऐं दै मैहलै लागअ द रहंदअ पर बिधाते करारो मणशू आसा खिम्भा हेठै डाहअ द!”<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />नातान गूरै दैनअ राज़ै लै ज़बाब, “ज़िहअ तेरअ दिल बोला तिहअ कर, किल्हैकि बिधाता आसा ताह संघै।”<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />पर तैहा ई राची बोलअ बिधाता नातान गूरा लै, <verse eid="2SA 7:4" /><verse number="5" style="v" sid="2SA 7:5" />“डेऊ, तूह एछ मेरै दास दाबेदा लै बोली कि हुंह बिधाता बोला इहअ, ‘सह निं तूह आथी ज़हा मुंह रहणा लै भबन बणाणअं! <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />ज़हा धैल़ी मंऐं इज़राईली मिसर देशा का काढी आणै, तधा ओर्ही आझ़ तैणीं रहअ हुंह खिम्भा दी एछदअ डेऊंदअ लागी, हुंह निं कोई खास भबनै रहअ। <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />हुंह ज़िधी-ज़िधी बी आपणीं परज़ा इज़राईली संघै रहअ, मंऐं ज़ेतरै बी इज़राईली प्रैंदै प्रधान छ़ांटै, मंऐं निं तिन्‍नें कोही टोली का एही किछ़ै खरी खोज़ी कि तिन्‍नैं मुल्है केल़ुईए काठा करै भबन किल्है निं बणाअं।’<verse eid="2SA 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 7:8" />“तूह खोज़ मेरै दास दाबेदा का, ‘स्वर्गे सारी सैने मालक बिधाता ज़हा का सारअ बल आसा, सह बोला इहअ कि मंऐं आणअ तूह भेडा-बाकरीए हेल़्ही फुआला बणां का एते तैणीं शादी, संघा बणाअं मंऐं तूह राज़अ कि मेरी परज़ा इज़राईली प्रैंदै राज़ करे। <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />ज़िधी बी तूह एछदअ डेऊंदअ रहअ, हुंह रहअ कबल्‍लअ ताह संघै। मंऐं किऐ ताखा आजी तेरै दुशमण खतम। मंऐं किअ तूह संसारै बडै-बडै महान लोगा ज़िहअ मशूर। <verse eid="2SA 7:9" /><verse number="10-11" style="v" sid="2SA 7:10-11" />मंऐं बिधाता आसा आपणीं परज़ा इज़राईली लै एक ज़ैगा डाही दी अर तिंयां बसाऊंणै मुंह तैहा ज़ैगा। तिधी निं तेखअ तिंयां कोही हंतणैं। तैहा ज़ैगा पुजणैं बाद आऐ खास्सी बारी उपद्रभी लोग तिन्‍नां हारदै-मारदै, पर ऐबै निं इहअ भिई हणअ। मेरी रही ताल्है ज़बान कि तूह डाहणअ मुंह तेरै दुशमणा का बच़ाऊई अर ताल्है दैणीं मुंह खास्सी आद-लुआद। <verse eid="2SA 7:10-11" /><verse number="12" style="v" sid="2SA 7:12" />ज़ांऊं तूह खास्सअ प्रोढअ जाणअ हई, तेखअ डाहणअ तूह तेरै दादा-बाबा ई ज़िहअ दाबी। तेरअ एक शोहरू बणाणअं मुंह ताह बाद तेरी ज़ैगा राज़अ अर तेऊओ राज़ करनअ मुंह होर बी बलबान।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="PSA 89:3">भज. 89:3</ref>,<ref loc="PSA 89:4">4</ref>; <ref loc="PSA 132:11">132:11</ref>; <ref loc="JHN 7:42">जोह. 7:42</ref>; <ref loc="ACT 2:30">शधा. 2:30</ref></char></note> <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />तेरअ सह शोहरू ई हणअ ज़हा मुल्है भबन बणाणअं अर तेरै खिंबै हणअ एक इहअ ज़सरअ राज़ सारी सदा रहणअ। <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />तेऊओ बाब हणअ हुंह आप्पै अर सह हणअ मेरअ शोहरू। ज़ै सह गलती करे, तेऊ लै दैणीं मुंह आप्पै सज़ा ज़िहअ एक बाब करा।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="PSA 89:26">भज. 89:26</ref>,<ref loc="PSA 89:27">27</ref>; <ref loc="2CH 6:18">2 इति. 6:18</ref>; <ref loc="HEB 1:5">इब्रा. 1:5</ref></char></note> <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />पर हुंह निं तेऊ झ़ूरनै का पिछ़ू हटदअ ज़िहअ हुंह राज़ै शाऊला का पिछ़ू हटअ ज़ुण ताखा आजी राज़अ थिअ अर ऐबै किअ मंऐं सह दूर। <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />तेरी आद-लुआद रहणीं बढदी लागी अर तेरअ राज़ हणअ सदा लै अटल़।’”<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="PSA 89:36">भज. 89:36</ref>,<ref loc="PSA 89:37">37</ref></char></note><verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />नातान गूरै खोज़ी दाबेदा का पठी गल्‍ला ज़ुंण बिधाता तेऊ का प्रगट किई ती।<verse eid="2SA 7:17" /></para>
  <para style="s">दाबेदे प्राथणां</para>
  <para style="r">(<ref loc="1CH 17:16-27">1 इतिहास 17:16-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />तेखअ डेऊअ राज़अ दाबेद बिधाते खिम्भा भितरी अर करारे मणशू सेटा बेशी बोलअ इहअ, “मेरै मालक, तूह आसा पबित्र परमेशर, ज़ुंण बी तंऐं मुल्है किअ, हुंह निं तेता जोगी आथी त, नां मेरअ खिंब तेता जोगी आथी त। <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />बिधाता, मेरै मालक, मेरै साबै किअ तंऐं मुल्है खास्सअ। पर तंऐं डाही आजू मेरी आद-लुआदा लै बी करार करी। पबित्र परमेशर बिधाता, तंऐं रहैऊई अह गल्‍ल मणछा का। <verse eid="2SA 7:19" /><verse number="20" style="v" sid="2SA 7:20" />हुंह ताल्है होर किज़ै सका बोली! ए बिधाता, मेरै मालक, हुंह आसा तेरअ दास अर ताखा आसा मेरै बारै पठी थोघ। <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />अह किअ तंऐं तिहअ ज़िहअ तेरै दिलै त अर तंऐं किअ तिहअ, ज़िहअ तंऐं बोलअ त। तंऐं किऐ ईंयां महान काम कि मुखा थोघ लागे।<verse eid="2SA 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 7:22" />“बिधाता, मेरै मालक तूह आसा पबित्र परमेशर, तूह आसा सोभी का महान! ताह ज़िहअ शुचअ निं कोहै आथी तूह आसा एक्‍कै परमेशर होर निं आथी ई। <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />नां सारी धरती दी इज़राईला ज़िहअ होर देश आथी ज़ुंण तंऐं गलामी का छ़ड़ैऊई आपणीं खास परज़ा बणाऐं। ज़ुंण महान अर नुआहरै काम तंऐं तिन्‍नां लै किऐ, तेता करै हुअ तूह सारै संसारै मशूर। तंऐं काढै होरी देशे लोग अर तिन्‍नें देअ आपणीं परज़ा पजैल़णैं का आजी दरल़ाऊई ताकि तिधी तेरै आपणैं लोग बस्से ज़ुंण तंऐं मिसर देशे गलामी का आज़ाद करी आणै।<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="DEU 4:3">बधा. 4:3</ref></char></note> <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />तंऐं बणाऐं इज़राईली सदा लै आपणीं खास परज़ा अर हे बिधाता, तूह हुअ सदा लै तिन्‍नों परमेशर।<verse eid="2SA 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 7:25" />“ऐबै हे परमेशर बिधाता, ज़ुंण करार तंऐं मुंह अर मेरी आद-लुआदा संघै किई, तेता कर तूह सदा लै पाक्‍की अर तूह करै तिहअ ई ज़िहअ तंऐं बोलअ द आसा। <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />तै रहणअ तेरअ नाअं सदा अर लोगा बोल़णअ सदा इहअ, ‘इज़राईला प्रैंदै आसा सह स्वर्गे सारी सैने मालक बिधाता ज़हा का सारअ बल आसा।’ मुंह तेरै दास दाबेदो खिंब डाहै तूह सदा अटल़। <verse eid="2SA 7:26" /><verse number="27" style="v" sid="2SA 7:27" />ए स्वर्गे सारी सैने मालक बिधाता, इज़राईले परमेशर, मुंह हुई ताखा एही अरज़ करने हिम्मत किल्हैकि तंऐं आसा मुंह तेरै दासा का सोभै गल्‍ला खोज़ी हेरी दी अर इहअ बी कि ताह बणाणैं मेरै खिंबा का राज़ै।<verse eid="2SA 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 7:28" />“ऐबै हे मेरै मालक बिधाता, तूह आसा पबित्र परमेशर, तूह निं आपणीं ज़बानी का हुधदअ अर तंऐं आसा मुल्है अह ज़बान दैनी दी। <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />ऐबै आसा ताखा मेरी अरज़ कि ऐबै दै खुशी-खुशी मेरै खिंबा लै बर्गत ताकि तूह सदा मुंह बाखा रहे। हे मेरै मालक बिधाता, तंऐं हेरअ इहअ ई करी अर तेरी बर्गत रहणीं मेरी आद-लुआदा लै सदा।”<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s">दाबेदे ज़ीत</para>
  <para style="r">(<ref loc="1CH 18:1-17">1 इतिहास 18:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />थोल़ै धैल़ै बाद छ़ेल़अ राज़ै दाबेदै पलिश्ती संघै भिई जुध अर तिंयां हारै दाबेदा का भिई। तिन्‍नों राज़ किअ इज़राईलीए तिन्‍नां ज़ैगा का बी पठी खतम ज़ेथ तिन्‍नों कबज़अ अज़ी बी थिअ।<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />तेखअ ज़ितअ दाबेद मोआबी का। तेऊ सताऊऐ तिन्‍नें सपाही धरनीं लाम्मी बाखा संघा नापै तिंयां राश्शी करै, ज़ेतरी लाम्मी राश्शी हआ ती तेते दुगणैं पाऐ तिंयां मारी अर एक राश्शी बराबर छ़ाडै तेऊ ज़िऊंदै। तेखअ किअ दाबेदै मोआबी प्रैंदै राज़ अर तिंयां दैआ तै तेऊ लै कारअ।<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />एता बाद छ़ेल़अ दाबेदै सिरीया देशे सोबा नगरीए राज़ै हदादेज़ेरा संघै हमात मुल्खा नेल़ जुध, किल्हैकि रहोबो शोहरू हदादेज़ेर त फरात दरैऊआ प्रैंधल़ै मुल्खै कबज़ै करदअ लागअ द। तेतरी हेरअ सह राज़ै दाबेदै जुधा दी हारी। <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />तेऊ जुधा दी किऐ दाबेदै हदादेज़ेरे एक हज़ार रथ, सात हज़ार घोल़े शुंआर, बिह हज़ार पैदल सपाही आपणैं कबज़ै दी। तेता का डाहै दाबेदै एक शौ रथा लै घोल़ै बच़ाऊई अर बाकी किऐ तेऊ ज़ान्हूं पिछ़ूए नस काटी बरैबाद।<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />ज़ांऊं दमिश्क नगरीए अरामी<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">अरामी </char><char style="ft" closed="false">सिरीया</char></note> लोगै आपणीं सैना सोबा नगरीए राज़ै हदादेज़ेरे मज़त करदी छ़ाडी, दाबेदे सैना पल़ी तिन्‍नां लै चुटी अर तिन्‍नां मांझ़ै पाऐ बाई हज़ार सपाही मारी। <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />तेखअ बशैल़ी दाबेदै अरामी मुल्खै आपणीं सैने च़ौकी, तिन्‍नां प्रैंदै बी हुअ दाबेदो राज़ संघा लागै तिंयां बी दाबेदा लै कारै दैंदै। ज़िधी बी दाबेद डेऊअ, बिधाता दैनी तेऊ लै ज़ीत। <verse eid="2SA 8:6" /><verse number="7" style="v" sid="2SA 8:7" />हदादेज़ेर राज़ै का थिई सुन्‍नें ढाल़ा अर तिंयां किई राज़ै दाबेदै आपणैं कबज़ै दी संघा आणी एरुशलेम नगरी लै। <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />तेता संघै आणअ दाबेद राज़ै हदादेज़ेर राज़े तेबा अर बेरोताई नगरी का खास्सअ कांस्सअ बी।<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />हमात नगरीए राज़ै तोई का लागअ थोघ कि दाबेदे सैना का हारी हदादेज़ेर राज़े सारी सैना, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />तेखअ छ़ाडअ तेऊ आपणअ शोहरू जोराम राज़ै दाबेदा सेटा राज्ज़ी-खुशी अर हदादेज़ेर राज़ै का ज़ितणें बधाई दैंदअ। किल्हैकि हदादेज़ेर राज़ै छ़ेल़अ त तोई संघै कई बारी जुध। जोरामै आणै दाबेदा लै भैंट दैणा लै सुन्‍नैं, च़ंदी अर कांस्से भांडै। <verse eid="2SA 8:10" /><verse number="11" style="v" sid="2SA 8:11" />राज़ै दाबेदै डाहै तिंयां भांडै बिधाता लै मणसी ज़ुदै ज़िहै अर सह सुन्‍नअ, च़ंदी अर कांस्सअ बी डाहअ तेऊ बिधाता लै तिहअ ई ज़ुदअ ज़ुंण तेऊ <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />अराम, मोआब, अमोन, पलिश्ती अर अमोलकी ज़ाती का जुध ज़िती आणअ त अर रहोबे शोहरू सोबा नगरीए राज़ै हदादेज़ेरा का लुटी दी ज़ैदात बी डाही तेऊ बिधाता लै ज़ुदी।<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />ज़ांऊं दाबेद लूंणै खागा का ठारा हज़ार अरामी मारी बापस फिरअ, तेखअ हुअ सह होर बी मशूर। <verse eid="2SA 8:13" /><verse number="14" style="v" sid="2SA 8:14" />दाबेदै बशैल़ी आपणीं सैना सारै एदोम अर तिंयां बी लागै दाबेदा लै कारै दैंदै। ज़िधी-ज़िधी बी दाबेद डेऊअ बिधाता दैनी तेऊ लै सोभी ज़ैगा ज़ीत।<verse eid="2SA 8:14" /></para>
  <para style="s">दाबेदे कार-करिंदै</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />दाबेदै किअ सारै इज़राईला प्रैंदै राज़ अर सह डाहा त धैन कि सारी परज़ा लोल़ी एकी रंगो बभार अर नसाफ भेटअ। <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />अबीशैओ भाई जोआब ज़सरी ईज सरूयाह थिई, सह थिअ राज़ै दाबेदो सैनापति। दाबेदो इतिहास लिखणैं आल़अ त आहीलूदो शोहरू जहोशापात, <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />आहीतूबो शोहरू सदोक अर अबतारो शोहरू आहीमोलक तै बडै प्रोहत। दाबेदो काईथ थिअ सरयाह, <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />जहोयादा प्रोहतो शोहरू बेनियाह थिअ राज़ै दाबेदे आपणीं फाज़त करनै आल़ै शूरबीरो प्रधान अर दाबेदे आपणैं शोहरू बी थिऐ बडी-बडी पदबी दी।<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s">दाबेद अर मोपीबशेत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />एकी धैल़ै सोठअ दाबेदै इहअ, “राज़ै शाऊले आजू लुआद रही बी कि किछ़ै निं? ज़ै रही दी होए, तिन्‍नां लै हणअ मुंह खास्सै झणैल़ू ज़ेही मंऐं आपणैं साथी जोनाताना लै कऊंलै बच़न आसा दैनै दै।”<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1 शमू. 20:15-17</ref></char></note><verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />शाऊले खिंबा का थिअ सिबू नाओं एक मणछ ज़ुंण राज़ै दाबेदा सेटा काम करा त, तेऊ लै बोलअ दाबेदा सेटा डेऊंणा लै। ज़ांऊं सह आअ, राज़ै दाबेदै पुछ़अ तेऊ का, “तूह आसा सिबू?”</para>
  <para style="p" vid="2SA 9:2">तेऊ दैनअ ज़बाब, “हाँ माहा राज़अ, हुंह तेरअ दास ई आसा।”<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />राज़ै दाबेदै पुछ़अ सिबू का, “शाऊले टबरा मांझ़ै कुंण आजू आसा बच़अ द कि हुंह तेऊ लै खास्सी झींण करी सकूं?”<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="2SA 4:4">2 शमू. 4:4</ref></char></note></para>
  <para style="p" vid="2SA 9:3">सिबू दैनअ ज़बाब, “मेरै मालक, जोनातानो आसा एक शोहरू बच़अ द, सह आसा पठी लाट्टअ।”<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />राज़ै दाबेदै पुछ़अ, “सह आसा किधी?”</para>
  <para style="p" vid="2SA 9:4">सिबू दैनअ ज़बाब, “सह रहअ लोदबेर नगरी अमीएले शोहरू माकीरे घअरै।” <verse eid="2SA 9:4" /><verse number="5" style="v" sid="2SA 9:5" />राज़ै दाबेदै छ़ाडै अमीएले शोहरू माकीरे घअरा का तेऊ आणदै आदमी।<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />ज़ांऊं जोनातानो शोहरू राज़ै शाऊलो पोचअ मोपीबशेत राज़ै दाबेदा सेटा पजैल़अ, तेऊ टेक्‍कअ धरनीं उटअ पल़ी दाबेदा सेटा माथअ। दाबेदै बोलअ, “मोपीबशेत,” तेऊ दैनअ ज़बाब, “बोल माहा राज़अ, आपणैं दासा लै तेरअ किज़ै हुकम आसा?”<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />दाबेदै बोलअ, “तूह निं डरी आथी, मुंह करनीं तेरै बाब जोनाताना पिछ़ू ताल्है खास्सी झींण। तेरै दादू शाऊले ज़ैगा-ज़िम्मीं दैणीं मुंह तेरै नाओंऐं ताल्है बापस करी। तूह खाऐ धैल़ मुंह संघै मेरै पलगा दी रोटी।”<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />मोपीबशेत बेठअ जान्हूंए बलै भिई धरनीं, संघा बोलअ इहअ, “हुंह तेरअ दास आसा मूंऐं दै कुक्‍करा ज़िहअ बृथा! तूह किल्है फिरअ मुल्है एतरअ झणैल़ू?”<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />तेखअ शादअ राज़ै दाबेदै सिबू ज़ुंण राज़ै शाऊला सेटा काम करा त, संघा बोलअ इहअ, “ज़ुंण शाऊल अर तेऊए टबरो थिअ, सह लाअ मंऐं तेरै मालके पोचै मोपीबशेता लै दैई। <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />तूह, तेरै शोहरू अर तेरै दास-दासी बऊऐ-बचऊऐ तैहा ज़िम्मीं आपणैं मालके टबरा लै संघा करै तेता का तिन्‍नां लै साल-फसल आणी ताकि तिन्‍नां रोटी भेटे। पर तेरै मालको पोचअ मोपीबशेत रहणअ मुंह संघै अर एऊ खाणीं मेरै पलगा प्रैंदै धैल़ मुंह संघै रोटी।” सिबूए तै पंद्रा शोहरू अर बिह च़ाकर।<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />सिबू बोलअ राज़ै दाबेदा लै इहअ, “माहा राज़अ! मेरै मालक, ज़िहअ तूह हुकम करा, मुंह करनअ तिहअ ई।”</para>
  <para style="p" vid="2SA 9:11">मोपीबशेत रहअ एरुशलेम नगरी दाबेदा संघै तिधी। सह खाआ त राज़े पलगा दी राज़े टिक्‍कै ज़िहअ ठाहठा दी रोटी। <verse eid="2SA 9:11" /><verse number="12" style="v" sid="2SA 9:12" />मोपीबशेतो बी थिअ मिका नाओं एक शोहरू। सिबूए सारै टबर लागै मोपीबशेते च़ाकरी करदै। <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />मोपीबशेत त दुही ज़ांघो लाट्टअ, अर सह रहअ एरुशलेम नगरी राज़ै दाबेदे मैहलै अर राज़े पलगा दी खाआ त सह धैल़ रोटी।<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s">दाबेद ज़ितअ अमोनी अर अरामी का</para>
  <para style="r">(<ref loc="1CH 19:1-19">1 इतिहास 19:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />पिछ़ू मूंअ अमोनी लोगो राज़अ नहाश अर आजू बणअ तेऊओ शोहरू हनून तेऊए ज़ैगा राज़अ। <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />दाबेदै सोठअ इहअ कि ज़िहअ मुल्है नहाश झ़ूरा त, तिहअ ई रहणअ आजू मुंह संघै तेऊओ शोहरू हनून बी। दाबेदै छ़ाडै आपणैं कार-करिंदै हनूना सेटा लै अमोनी देशै चिंजदै कि दाबेदा हुअ राज़ै नहाशा मरनैओ खास्सअ दुख। <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />पर अमोनी राज़े कार-करिंदै लागै हनूना लै इहअ बोल्दै, “तूह कै सोठा, आपणैं कार-करिंदै चिंजदै छ़ाडी कै दाबेदै तेरै बाबो अदर किअ? ज़ाथी निं किछ़! तेऊ आसा ईंयां म्हारी नगरी लै भेख लंदै छ़ाडै दै ताकि बादा का सह एथ कबज़अ करी सके!”<verse eid="2SA 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 10:4" />हनूनै किऐ दाबेदे कार-करिंदै कैद संघा डाही तिन्‍नें एकी बाखा दाल़्ही-मुछ़ा काटी अर पिछ़ू बाखा गूल़ी पाऐ तिन्‍नें च़ोल़ै अर ज़ांघिऐ दी छिझै पाई नांगै! तेखअ दैनअ तिन्‍नां डेऊणैं! <verse eid="2SA 10:4" /><verse number="5" style="v" sid="2SA 10:5" />तिन्‍नें निस्सअ शरमैं आपणैं देशा अर घअरा बाखा हांढुई बी। ज़ांऊं ऐहा गल्‍लो थोघ राज़ै दाबेदा का लागअ कि इहअ हुअ, तेऊ छ़ाडै जेरिहो नगरी तैणीं तिन्‍नां लै समाद पजैल़ै, “ज़ेभै तैणीं थारी दाल़्ही निं बझ़े, तेभै तैणीं रहै तम्हैं इधी जेरिहो नगरी अर तेता बाद लागै तम्हैं एछदै।”<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />अमोनी का गअ ज़ाण्हुंई कि ऐबै पाई तिन्‍नैं दाबेदा संघै ज़ीद, तिन्‍नें शदाऊऐ बेथ-रहोब अर सोबा नगरी का बिह हज़ार अरामी<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="fq" closed="false">अरामी </char><char style="ft" closed="false">सिरीया</char></note> सपाही, तोब नगरी का बारा हज़ार अर माकाहा नगरीओ राज़अ आअ एक हज़ार सपाही संघा लई। <verse eid="2SA 10:6" /><verse number="7" style="v" sid="2SA 10:7" />दाबेदा का गअ इना गल्‍लो थोघ लागी अर तेऊ छ़ाडअ तिन्‍नें मकाबलै लै जोआब सारी सैना संघी। <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />अमोनी निखल़ै जुधा लै बागै संघा बान्हीं आपणीं राज़धानी रबाह नगरीए प्रऊल़ी आजू जुधा लै लगैग अर सोबा अर रहोब नगरीए अरामी बान्हीं आपणीं लगैगा आजू खुल्ही-बिरली सऊंई ज़ैगा। तोब अर माकाहा नगरीए सैना बी थिई तिन्‍नां का ज़ुदी ज़ेही लगैग बान्हीं दी।<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />ज़ांऊं जोआबै भाल़अ कि तिन्‍नां आजू-पिछ़ू आसा दुही बाखा दुशमणे सैने लगैग, जोआबै छ़ांटै इज़राईली मांझ़ै खास-खास जोधै संघा बान्हीं तिन्‍नें लगैग अरामी बाखा स्मोहरी। <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />बाकी सैनो दलपति बणाअं तेऊ आपणअ भाई अबीशै अर तिन्‍नें लगैग लाई तेऊ अमोनी बाखा। <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />जोआबै बोलअ अबीशै लै, “ज़ै अरामी का हुंह हारदअ शुझिए, तै लोल़ी तूह मेरी मज़त करदअ आअ, अर ज़ै मुखा अमोनी का तूह हारदअ शुझिए, तै आअ हुंह तेरी मज़त करदअ कि तेरअ बल बढे। <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />तूह डाहै हैअ, हिम्मत निं हारी! हाम्हां करनअ आपणैं लोगा अर आपणैं परमेशरे नगरी लै पूरअ ज़ोर लाई जुध। आजू आसा बिधाते मरज़ी, तेऊ ज़िहअ करनअ होए हणअ सह तिहअ।”<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />जोआब अर तेऊए सैना डेऊई अरामी संघै मकाबलै करना लै नेल़ अर अरामी ठुर्है तिन्‍नां सेटा का दूर! <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />अमोनी भाल़अ कि अरामी गऐ जुधा का ठुर्ही, तिंयां बी ठुर्है अबीशै सम्हनै का पिछ़ू संघा पेठै नगरी भितरी। तेखअ आअ जोआब आपणीं सैना संघी बापस एरुशलेम नगरी लै फिरी।<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />ज़ांऊं अरामी का ज़ाण्हुंअ कि तिंयां हारै इज़राईली का, तिन्‍नैं झाल़ी भिई आपणीं सारी सैना। <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />राज़ै हदादेज़ेरै छ़ाडै दूत संघा शादै फरात दरैऊआ पार पुर्बा बाखा बस्सै दै अरामी, तिन्‍नैं बणाअं आपणअ सैनापति शबाक संघा पुजै हेलाम। सह थिअ राज़ै हदादेज़ेरो सैनापति।<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />ज़ांऊं दाबेदा का इना सोभी गल्‍लो थोघ लागअ, तेऊ झाल़ी आपणीं इज़राईली सैना संघा डेऊअ जरदण पार टपी हेलाम। तिधी आई अरामी सैना लगैग बान्हीं दाबेदा संघै जुधा लै, <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />पर इज़राईली खद्रेल़ै अरामी पिछ़ू। तधू पाऐ दाबेद अर तेऊए सैना अरामीए सात शौ रथ, च़ाल़्ही हज़ार शुंआर मारी अर तिन्‍नों सैनापति शबाक किअ इहअ ज़खमी कि सह मूंअ तिधी। <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />ज़ेतरै राज़ै हदादेज़ेरे गलामी करा तै, ज़ांऊं तिन्‍नैं भाल़अ कि तिंयां हारै इज़राईली का, तिन्‍नैं किई तेखअ इज़राईली संघै मेल़-ज़ोल़े करार संघा लागै दाबेदे गलामी करदै। तेखअ डरै अरामी खास्सै संघा निं तिंयां अमोनीए मज़त करदै भिई आऐ।<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s">दाबेदे भलै हुअ पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />ईंयां आसा च़ैत्रे गल्‍ला, खासकर ज़ेभै राज़ै जुधा लै निखल़ा तै। दाबेदै छ़ाडी आपणीं इज़राईले सारी सैना अर तिन्‍नें ज़िम्मैंबारी दैनी जोआब अर तेऊ संघे कार-करिंदै लै। तिन्‍नैं किई अमोनी लोगे सैना पठी बरैबाद संघा डाही तिन्‍नें राज़धानी रबाह नगरी फेर-फिरदी गोटी। दाबेद त आप्पू आपणीं राज़धानी एरुशलेम नगरी।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CH 20:1">1 इति. 20:1</ref></char></note><verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />एकी धैल़ै हुअ इहअ कि सान्हां उझ़ुअ राज़अ दाबेद संघा निखल़अ आपणैं मैहलै बागै च़बारू लै संघा त तिधी हांढदअ-फिरदअ लागअ द। तिधा का शुझुई तेऊ का एक बेटल़ी आसा आपणैं घअरै बागा बाखा न्हैऊंदी लागी दी अर सह थिई हेरनी शुणनी बेघै बित्ती। <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />दाबेदै छ़ाडअ आपणअ आदमी एही पुछ़-ज़ाच़ करना लै कि अह बेटल़ी कुंण आसा? तेथ खोज़अ कुंणी कि सह बेटल़ी आसा एलीआमे शोहरी बेतशेबा अर हित्ती उरियाहे लाल़ी। <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />दाबेदै छ़ाडै तैहा आणदै दूत, तिन्‍नैं पजैल़ी सह राज़ै सेटा संघा सुत्तअ दाबेद तैहा संघै। सह थिई अज़ी तधू पै ज़ुठै झिकल़ै धोई शुची हुई दी। तेखअ डेऊई सह आपणैं घअरा लै बापस फिरी। <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />तेखअ ज़ाण्हुंअ तैहा कि सह हुई सुंदी अर तैहा दैनअ राज़ै दाबेदा लै समाद।<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />दाबेदै दैनअ आपणैं सैनापति जोआबा लै समाद, “हित्ती उरियाह छ़ाडै ओर्ही मुंह सेटा लै।” जोआबै छ़ाडअ उरियाह जुधा का घअरा लै। <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />ज़ांऊं उरियाह दाबेद राज़ै सेटा पुजअ, दाबेदै पुछ़अ सह राज्ज़ी-खुशी, जोआब अर सारी सैनो अर जुधो हाल। <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />तेखअ बोलअ उरियाह लै इहअ, “तूह डेऊ आपणैं घअरा लै संघा कर राम।” उरियाह निखल़अ राज़े मैहला का बागै अर पिछ़ू दैनी दाबेदै उरियाहे घअरा लै भैंट बी। <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />पर उरियाह निं आपणैं घअरा लै डेऊअ, सह रहअ राज़े मैहलै प्रऊल़ी बागै पहरी संघै सुत्ती। <verse eid="2SA 11:9" /><verse number="10" style="v" sid="2SA 11:10" />ज़ांऊं दाबेदा का थोघ लागअ कि उरियाह निं आपणैं घअरै बेटल़ी सेटा डेऊअ, तेऊ पुछ़अ सह, “तूह आसा दूरा का खास्सै धैल़ै बाद घअरा लै आअ द! तूह आपणैं घअरा लै किल्है निं डेऊंदअ?”<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />उरियाह दैनअ राज़ै दाबेदा लै ज़बाब, “इज़राईल अर यहूदा का आसा सैना जुधा लै खिम्भा हेठै रहंदी लागी दी, करारो मणशू बी आसा खिम्भा दी। मेरअ सैनापति जोआब अर तेऊ संघै होर कार-करिंदै बी आसा सऊंई ज़ैगा डेरै पाई जुधा लै। मेरै मालक, तै हुंह किहअ करै सका आपणैं घअरै डेऊई खाई-पिई आपणीं बेटल़ी संघै सुत्ती मौज़ करी? मंऐं खाऐ तेरै सोह कि हुंह निं इहअ करी ई सकदअ।”<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />तेखअ बोलअ दाबेदै उरियाह लै, “तै रह आझ़ इधी अर काल्‍ला छ़ाडूं हुंह ताह बापस।” तैहा राची अर दुजै धैल़ै रहअ उरियाह एरुशलेम तिधी। <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />तेखअ शादअ दाबेदै सह आप्पू सेटा संघा दैनअ तेऊ लै खास्सअ खाणां-पिणां लै एतरी शराब झुटणा लै कि तेऊ लागअ खास्सअ नशअ। पर तैहा बैल़ी बी निं उरियाह आपणैं घअरै बेटल़ी सेटा डेऊअ! सह सुत्तअ तिधी राज़े मैहले पहरी संघै आपणैं दोहल़ू प्रैंदै।<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />दुजै धैल़ै लिखी दाबेदै च़िठी संघा दैनी उरियाहे हाथै कि एता दैऐ सैनापति जोआबा का। <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />दाबेदै त तैहा च़िठी दी लिखअ द, “उरियाह डाहै जुधा लै सोभी का आगली लगैगा दी, ज़िधी घणअ जुध होए लागअ द अर आप्पू हटै होर तिधा का पिछ़ू, एऊ छ़ाडै कल्ही कि अह ज़खमी हई मरे।” <verse eid="2SA 11:15" /><verse number="16" style="v" sid="2SA 11:16" />जोआबै किई नगरी फेर राम्बल़ै करै ज़ाच़-भाल़ अर ज़िधी तेऊ का थोघ थिअ कि इधी आसा दुशमणे खास्सै बलबान शूरबीर, तिधी डाहअ तिन्‍नैं उरियाह। <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />दुशमणे सैना निखल़ी नगरी बागै अर संघा लागअ जोआबे सैना संघै घणअ जुध। तिधी पाऐ दाबेदे कई जोधै दुशमणै मारी अर हित्ती उरियाह बी त तिन्‍नां मरनै आल़ै मांझ़ै।<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />तेखअ छ़ाडअ जोआबै दाबेदा सेटा लै दूत कि जुधो पूरअ हाल खोज़े, <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />तेऊ डाहअ दूता का इहअ खोज़ी, “ज़ेभै तूह राज़ै का जुधो पूरअ हाल खोज़ी मुक्‍के, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />ज़ै ताखा राज़अ इहअ पुछ़े, ‘तम्हैं दुशमणा संघै जुधा करदै तिन्‍नें नगरी खास्सै नेल़ किल्है डेऊऐ? तम्हां एही समझ़ निं आथी कि तिंयां सका गहल़ा पिछ़ू का तम्हां लै कतीरै बाही? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />तम्हां आद निं रही कि जेरूबशेतो शोहरू अबीमोलक तेबेस नगरी कुंणी मारअ त? तेऊ प्रैंदा लै शोटअ त एकी बेटल़ी उझै कोठी का नाज़ा पिशणैंओ थरेट संघा हुअ सह तिधी मरी हक्‍क। तेखअ किल्है डेऊऐ तम्हैं नगरी एतरै नेल़?’ तै बोलै तूह राज़ै लै इहअ, ‘तेरअ दास हित्ती उरियाह बी मूंअ तेऊ जुधा दी।’”<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="JDG 9:53">पांच़ 9:53</ref></char></note><verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />सह दूत पुजअ दाबेद राज़ै सेटा तेखअ खोज़ी तिंयां पठी गल्‍ला ज़िहअ जोआबै तेऊ का खोज़ी त डाहअ द। <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />तेऊ दूतै बोलअ दाबेदा का इहअ, “म्हारै दुशमण तै तिधी हाम्हां का खास्सै बलबान, तिंयां आऐ हाम्हां संघै मकाबलै लै नगरी बागै सरलै दी अर हाम्हैं खद्रेल़ै तिंयां पिछ़ू नगरीए प्रऊल़ी तैणीं। <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />माहा राज़अ, तिधी बाही तिन्‍नैं हाम्हां लै गहल़ा पिछ़ू का कतीरै अर म्हारै पाऐ कई जोधै मारी अर तिन्‍नां संघै पाअ तेरअ दास हित्ती उरियाह बी मारी!”<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />दाबेद राज़ै दैनअ तेऊ दूता का जोआबा लै बापस समाद, “जोआबा लै दैऐ इहअ हैअ, ‘ऐहा गल्‍ला पिछ़ू निं दुखी हई, एतो थोघ निं हंदअ कि जुधा दी कुंण मरनअ। तूह लाऐ नगरीए गहल़ा ढोल़णा लै दुगणअ ज़ोर संघा कर तेथ कबज़अ।’”<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />ज़ांऊं उरियाहे बेटल़ी बेतशेबा का थोघ लागअ कि तेसो मर्ध मूंअ जुधा दी, सह लागी तेऊ लै हिक्‍का पटाक्‍की लेरा लांदी। <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />ज़ांऊं तेसे शोगे धैल़ै मुक्‍कै, दाबेदै शादी सह आपणैं मैहला लै संघा डाही सह आप्पू लै बेटल़ी। तैहा का हुअ एक शोहरू पर बिधाता निं दाबेदे एऊ कामां का खुश आथी त।<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s">दाबेदा लै नातान गूरो समाद<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="PSA 51">भज. 51</ref></char></note></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />बिधाता छ़ाडअ आपणअ गूर नातान दाबेद राज़ै सेटा। तेऊ सेटा डेऊई बोलअ नातान गूरै इहअ, “एकी नगरी थिऐ दूई मणछ, एक त सेठ अर दुजअ त गरीब। <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />सेठ मणछा का थिई खास्सी भेडा-बाकरी अर गाऊई-बल्दे हेल़्ही, <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />पर तेऊ गरीब मणछा का थिई होछ़ी ज़ेही एक्‍कै गाभी अर सह थिई तेऊ मोलै आणी दी लई। सह धाची-पाल़ी तेऊ आपणैं घअरै आपणैं लान्हैं-सुन्हैं संघै। सह दैआ त तैहा लै आपणैं थाल़ू का रोटी अर आपणैं प्रिहै का पाणीं झुटणा लै। सह रहा ती तेऊए भोसल़ै सुत्ती। सह गाभी ती तेऊ लै तेऊए शोहरी ज़ेही। <verse eid="2SA 12:3" /><verse number="4" style="v" sid="2SA 12:4" />एकी धैल़ै आअ एक मसाफर सेठ मणछे घअरै। सह निं आपणैं घअरे चैणें हेल़्ही मांझ़ै कोही खोणअ च़ाहंदअ त कि तेऊ प्राहुणैं लै शिखा लै काटे। तेऊ निंईं तेऊ गरीब मणछे सह गाभी संघा बणाईं आपणैं प्राहुंणैं लै तेते शिखा!”<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />इना गल्‍ला शूणीं हुअ दाबेद तेऊ सेठ मणछा लै रोश्शै लाल-पिंऊंल़अ अर तेऊ बोलअ नातान गूरा लै इहअ, “हुंह खाआ ज़िऊंदै परमेशर बिधाते सोह, ज़ुंणीं अह इहअ किअ सह निं मुंह ज़िऊंदअ छ़ाडणअ! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />तैहा गाभीए बदल़ै बी लागणअ तेऊ च़ार गुणा दैणअ भरी, तेऊ भाल़ किहअ घोर कदुष्ट काम किअ, तेऊ धख झींण बी निं फिरी!”<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />तेखअ बोलअ नातान गूरै दाबेदा लै, “सह मणछ आसा तूह ई। इज़राईलो परमेशर बिधाता बोला ताल्है इहअ, ‘मंऐं बच़ाऊअ तूह राज़ै शाऊला का संघा बणाअं अभिषेक करी इज़राईला प्रैंदै राज़अ। <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />तेऊओ राज़, तेऊए बेटल़ी दैनी मंऐं ताल्है! तूह बणाअं मंऐं यहूदा अर इज़राईल दुही मुल्खा प्रैंदै राज़अ। ज़ै ताह अह थोल़अ गअ त, तै दैंदअ हुंह ताल्है एतो दुगणअ होर! <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />ज़िहअ मंऐं बोलअ तंऐं तिहअ किल्है निं किअ, मेरअ बैण किल्है पाअ तंऐं बृथा? तंऐं अह कदुष्ट काम किल्है किअ? तंऐं बझ़ैल़अ हित्ती उरियाह जुधा दी अमोनी लोगे हाथै ज़ोरा-ज़ोरी मारनै! <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />एतो दोश लागणअ तेरै खिंबा लै अर तेरी आद-लुआदा मांझ़ै बी मरनै कई इहै ई तलबारा करै किल्हैकि तंऐं समझ़अ हुंह बृथा अर हित्ती उरियाहे लाल़ी आप्पू लै डाही किअ तंऐं बूरअ। <verse eid="2SA 12:10" /><verse number="11" style="v" sid="2SA 12:11" /><note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2 शमू. 16:22</ref></char></note>ऐबै शुण, बिधाता बोला इहअ कि तेरै ई टबरा मांझ़ै हणअ कुंण इहअ ज़हा ताल्है आफ़त करनीं खल़ी। एतो थोघ लागणअ ताखा तेभै, ज़ेभै मुंह तेरी आछी सम्हनै तेरी बेटल़ी कहा होरी लै दैणीं अर तिंयां करनीं तिन्‍नां धैल़ी दपहरै नांगी-बल़िंगी। <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />तंऐं ता किअ अह काम च़ुप्प-च़ुप्पै, पर मुंह दैणअ ताल्है इहअ धैल़ी दपहरै सोभी इज़राईली नदरी हणैं।’”<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />तेखअ बोलअ दाबेदै नातान गूरा लै, “मंऐं किअ बिधाता लै पाप!”</para>
  <para style="p" vid="2SA 12:13">नातानै दैनअ ज़बाब, “हाँ, पर बिधाता किअ तूह पापा का दूर, मरनै का जाणअ तूह बच़ी। <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />पर एऊ कामां करै रहैऊअ तंऐं इहअ कि ताह निं बिधाते परबाह आथी कि सह किज़ै च़ाहा! तैही ज़ुंण तेरअ शोहरू हणअ, सह मरनअ।”<verse eid="2SA 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />तेखअ लागअ नातान आपणैं घअरा लै हांढदअ।</para>
  <para style="s" vid="2SA 12:15">दाबेदो शोहरू मूंअ</para>
  <para style="p" vid="2SA 12:15">तेखअ ज़ुंण उरियाहे बेटल़ी बेतशेबा का दाबेदो शोहरू हुअ, बिधातो दोश लागअ तेऊ शोहरू लै अर सह शोहरू हुअ बाख दुबल़अ अर रोगी। <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />दाबेदै किई बिधाता सेटा खास्सी अरज़ कि सह शोहरू लोल़ी नरोगअ हुअ। सह रहअ ब्रतू अर हर धैल़ै सारी राची रहा त सह आपणीं पांडा धरनीं बधल़ूई। <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />तेऊए मैहलै रहणैं आल़ै कार-करिंदै डेऊए तेऊ धरना का खल़ै झ़ैऊंदै तेऊ सेटा, पर सह निस्सअ उझ़ुई अर नां तेऊ तिन्‍नां संघै रोटी खाई। <verse eid="2SA 12:17" /><verse number="18" style="v" sid="2SA 12:18" />खिरी मूंअ सह शोहरू सातुऐ धैल़ै अर दाबेदे कार-करिंदै डरै दाबेदा का ऐहा गल्‍ला खोज़णैं। तिन्‍नैं बोलअ इहअ, “ज़ेभै शोहरू ज़िऊंदअ थिअ, तेभै निं एऊ म्हारी गल्‍ला शूणीं ज़बाब दैनअ! ऐबै किहअ करै खोज़णअ हाम्हां कि एऊओ शोहरू गअ मरी? इहअ शूणीं निं लोल़ी एऊ लै किज़ै होर आफ़त पल़ी!”<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />दाबदै भाल़ै कि तेऊए कार-करिंदै आसा एकी-दुजै संघै च़ुप्प-च़ुप्पै गल्‍ला करदै लागै दै अर तेऊ हेरअ ज़ाणीं कि शोहरू गअ हणअ मरी। तेखअ लागअ दाबेद तिन्‍नां का पुछ़दअ, “शोहरू मूंअ भाल़ी?”</para>
  <para style="p" vid="2SA 12:19">तिन्‍नैं दैनअ ज़बाब, “हाँ माहा राज़अ, शोहरू गअ ज़ांऐं।”<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />दाबेद उझ़ुअ धरना का खल़अ संघा न्हैऊअ, मुंडे शराल़ करिशै संघा बदल़ै आपणैं झिकल़ै। तेखअ डेऊअ सह बिधाते भबना लै संघा टेक्‍कअ माथअ। ज़ांऊं सह आपणैं मैहला लै बापस फिरअ, तेऊ मांगी खाणां लै रोटी। ज़ेही तेऊ लै रोटी दैनी तेऊ खाई तिंयां। <verse eid="2SA 12:20" /><verse number="21" style="v" sid="2SA 12:21" />तेखअ लागै तेऊए कार-करिंदै इहअ बोल्दै, “हाम्हां निं अह गल्‍ल समझ़ ई आई कि ज़ेभै तेरअ शोहरू ज़िऊंदअ थिअ, तूह रहअ भुखअ-नचिशअ तेऊ लै लेरा लांदअ लागी, पर ज़ेतरी सह मूंअ निं तूह उझ़ुअ खल़अ संघा लागअ रोटी खांदअ!”<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />दाबेदै दैनअ ज़बाब, “हाँ, ज़ेभै तैणीं शोहरू ज़िऊंदअ थिअ, हुंह रहअ भुखअ-नचिशअ लेरा लांदअ लागी। मंऐं ज़ाणअ झ़ाणीं बिधाता मुल्है झींण फिरे अर तेऊ शोहरू मरनै नांईं दैए। <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />ऐबै गअ सह मरी, तै ऐबै किल्है रहूं हुंह ब्रतू? हुंह निं तेऊ शोहरू भिई ज़िऊंदै करी सकदअ! ज़िधा लै सह डेऊअ, एकी धैल़ै डेऊणअ हुंह बी तिधी तेऊ सेटा पर सह निं ऐबै मुंह सेटा बापस फिरदअ।”<verse eid="2SA 12:23" /></para>
  <para style="s">सुलैमानो ज़ल्म</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />तेखअ हैऊई-बतैऊई दाबेदै आपणीं लाल़ी बेतशेबा, संघा डेऊअ तैहा सेटा भिई संघा हुई सह सुंदी अर बादा का हुअ तेसो एक शोहरू, दाबेदै डाहअ तेऊ शोहरू नाअं सुलैमान। तेऊ शोहरू लै झ़ूरअ बिधाता खास्सअ <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />अर बिधाता किअ नातान गूरा लै हुकम कि तेऊ शोहरू नाअं डाहै जदिदयाह, किल्हैकि बिधाता झ़ूरा त तेऊ लै खास्सअ।<verse eid="2SA 12:25" /></para>
  <para style="s">दाबेदै किअ रबाह नगरी कबज़अ</para>
  <para style="r">(<ref loc="1CH 20:1-3">1 इतिहास 20:1-3</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />एसी त जोआब रबाह नगरी जुधा लै आपणीं सैना संघी टेक्‍की रहअ द। सह थिई अमोनीए राज़धानी अर तेता त जोआब तेतरी ज़ितणैं ई आल़अ। <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />जोआबै छ़ाडै दाबेदा सेटा जुधे हाल खोज़णा लै दूत, “मंऐं आसा रबाह नगरी लै गोट दैनअ द, ज़िधा का नगरी लै पाणीं डेओआ सह ज़ैगा हेरी मंऐं आपणैं कबज़ै करी। <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />ऐबै करै झाल़ै आपणीं बाकी सैना संघा कर नगरी मारी तेथ कबज़अ। हुंह निं च़ाहंदअ कि ऐहा नगरी दी मेरै नाओंऐं ज़ीत होए।” <verse eid="2SA 12:28" /><verse number="29" style="v" sid="2SA 12:29" />दाबेदै झाल़ी आपणीं सैना संघा डेऊअ रबाह नगरी लै, तिंयां पल़ै नगरी मारदै चुटी संघा किअ तेथ कबज़अ। <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />तेखअ काढअ तिन्‍नैं अमोनी राज़ै मोलके बडी मुहुर्तीए मुंडा का तेऊओ मुगट उंधै सह थिअ तोली करै कोई पैंईंती किलू सुन्‍नेंओ अर तेथ ती किम्मती मणीं लागी दी। दाबेदै लाई तेता का तिंयां मणीं आपणैं मुगटा दी संघा लुटी तिन्‍नैं सह नगरी पठी। <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />तिधी बस्सै दै लोगा का बझ़ैल़अ दाबेदै नगरी फेरो गहल़ आरै, कदाल़ी अर खराल़ै करै ढोल़णैं। तेखअ डाहै तिंयां ईंटा बणाणें कामां लाई। अमोनी लोगे होरी नगरी संघै बी किअ तेऊ इहअ ई। तेखअ आऐ तिंयां एरुशलेम नगरी लै बापस फिरी।<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s">अमनोन अर तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />राज़ै दाबेदे ती तामार नाओंए एक शोहरी हेरनी बेघै बित्ती, तेसो भाई त अबशलोम। अमनोन त दाबेदे एकी होरी लाल़ी का शोहरू हुअ द, सह लोभणूंअ तैहा लै। <verse eid="2SA 13:1" /><verse number="2" style="v" sid="2SA 13:2" />अमनोन लोभणूंअ तामारा लै इहअ कि सह च़ाल्‍लअ तैहा पिछ़ू मरी कि सह हुअ बमार किल्हैकि सह शोहरी ती अज़ी कुंआरी अर सह निं तैहा संघै किछ़ करी सकदअ त। <verse eid="2SA 13:2" /><verse number="3" style="v" sid="2SA 13:3" />पर अमनोनो त जोनादाब नाओं एक साथी, सह थिअ दाबेदे भाई शिमेहो शोहरू। सह थिअ खास्सअ छ़लैघ। <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />जोनादाबै बोलअ अमनोना लै, “तूह आसा राज़ैओ शोहरू, मुखा शुझिआ कि तूह हुअ धैल़ी-धैल़ी दुबल़अ ई! मुखा खोज़ ताह किज़ै खरी आसा?”</para>
  <para style="p" vid="2SA 13:4">अमोनै बोलअ, “हुंह झ़ूरा आपणैं भाई अबशलोमे बैहण तामारा लै!”<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />जोनादाबै बोलअ तेऊ लै, “तूह रह आपणैं कऊंचा प्रैंदै सुत्ती संघा कर इहअ दखाअ कि तूह आसा खास्सअ बमार, ज़ेभै तेरअ बाब ताह भाल़अ एछे, तेभै बोलै तेऊ लै इहअ, ‘ज़ीबाण, मेरी च़ेई तामारा लै बोल मुखा खैऊ रोटी, तैहा लै बोल कि इधी बणाऊं मुंह सम्हनै रोटी संघा खैऊए मुखा सह आपणैं हाथै।’” <verse eid="2SA 13:5" /><verse number="6" style="v" sid="2SA 13:6" />अमनोनै किअ बमार हणैंओ दखाअ संघा रहअ कऊंचा प्रैंदै सुत्ती।</para>
  <para style="p" vid="2SA 13:6">राज़अ दाबेद आअ तेऊ भाल़अ अर अमोनै बोलअ तेऊ का इहअ, “ज़ीबाण, मेरी च़ेई तामारा लै बोल मुखा खैऊ रोटी, तैहा लै बोल कि इधी बणाऊं मुंह सम्हनै रोटी संघा खैओए सह मुखा आपणैं हाथै।”<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />दाबेदै दैनअ मैहला लै तामारा सेटा समाद, “आपणैं भाई अमनोने घअरै डेऊई दै तेऊ लै रोटी चाणी।” <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />तामार डेऊअ अमनोने घअरै अर तैहा भाल़अ कि सह आसा च़ैन्‍नै पल़अ द। तैहा मुछ़अ पिठअ संघा बणाऐं तेला जैंदरी तिधी तेऊ सम्हनै रोटू। <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />तेखअ डेऊई सह तेता थाल़ू दी पाई अमनोना सेटा खाणां लै दैंदी पर तेऊ किअ खाणां लै नांह। तेखअ बोलअ अमोनै आपणैं दासा लै, “मुंह सेटा का डेओआ सोभ बागै।” सोभ दास डेऊऐ बागै। <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />तेखअ बोलअ अमनोनै तामारा लै, “रोटीओ थाल़ू आण ओर्ही मुंह सेटा लै, संघा खैऊ मुखा आपणैं हाथा करै।” तामारै निंयं रोटूओ थाल़ू हाथै संघा डेऊई तेऊ सेटा लै। <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />ज़ांऊं सह तेऊ का रोटीए म्हारा खैऊंदी लागी, तेऊ ढाकी सह संघा बोलअ इहअ, “इधी सुत्त मुंह संघै मेरै च़ैन्‍नै!”<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />तामारै बोलअ लेरा पाई, “नांईं, मेरै भाई, मुंह संघै निं इहअ कदुष्ट काम करै! अह आसा घोर पाप! इहअ ऐडअ काम निं इज़राईला दी कधि लोल़ी हुअ! <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />मेरै बारै ता सोठ, मेरी हणीं सदा लै इज़त खतम! आपणैं बारै सोठ, इज़राईला दी करनीं तेरी सोभी बेइज़ती। ज़ीबाण, तूह कर राज़ै संघै गल्‍ला, सह जाणअ ताल्है मुंह संघै बैह करना लै मनी।” <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />पर अमोनै निं तेसे एक गल्‍ल बी शूणीं, तेऊ त तैहा का खास्सअ ज़ोर अर तेऊ किअ तैहा संघै ज़ोरा-ज़ोरी कदुष्ट काम संघा लाअ तैहा लै दाग।<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />ज़ांऊं अमनोन तैहा संघै भोग करी मुक्‍कअ, तेखअ हुई तेऊ तैहा लै एतरी नफरत कि ज़ेतरअ सह पैहलै तैहा लै झ़ूरा त, तेता का खास्सी हुई तेऊ नफरत। तेखअ बोलअ तेऊ तैहा लै, “खल़ी उझ़ू, इधा का डेऊ!”<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />तैहा दैनअ ज़बाब, “हुंह निं च़ाल्‍ली डेऊई, ऐबै हुंह इधा का बागै काढणीं आसा तेता का बी खास्सअ बडअ ज़ुल्म ज़ुंण तंऐं मुंह संघै एभै किअ।”</para>
  <para style="p" vid="2SA 13:16">पर अमोनै निं तेसे गल्‍ल मनी, <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />तेऊ शादै आपणैं दास संघा बोलअ इहअ, “ऐहा बेटल़ी करा मेरी आछी सेटा का दूर! ऐहा शोटा दुआरा बागै संघा लाआ भितरा बाखा दुआरै आगल़।” <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />तिन्‍नैं काढी तामार दुआरा बागै संघा लाई पिछ़ू दुआरै आगल़।</para>
  <para style="p" vid="2SA 13:18">तामारै त पूरी बाहो रंग-बरंगअ लाम्मअ घाघरअ बान्हअ द, किल्हैकि राज़े देई ज़ुंण कुंआरी हआ ती, तिंयां बान्हां तेऊ ज़मानै इहै ई झिकल़ै। <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />तैहा तरैल़अ आपणैं मुंडै छ़ार संघा पाअ आपणअ सह रंग बरंगअ घाघरअ धेल़ी संघा डेऊई आपणैं मुंहैं हाथ लाई लेरा लांदी-लांदी। <verse eid="2SA 13:19" /><verse number="20" style="v" sid="2SA 13:20" />ज़ांऊं सह तेसे भाई अबशलोमै भाल़ी, तेऊ पुछ़ी सह, “शुची गल्‍ला खोज़ अमनोन रहअ-बस्सअ ताह संघै भाल़ी? पर ऐबै रहअ तूह च़ुप्पी च़ेईऐ लेरा निं लाऐ। सह आसा तेरअ काक्‍कअ भाई, एते बारै निं होरी का खोज़ी आथी।” तेखअ रही तामार आपणैं भाई अबशलोमा सेटा तिधी तेऊए घअरै दुखी अर तिंयां गल्‍ला डाही तैहा आपणैं दिलै दाबी।<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />ज़ांऊं राज़ै दाबेदा का थोघ लागअ कि इहअ हुअ, तेऊ निस्सअ रोश्शै उझ़ुई नां बेशी राम हई। <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />अबशलोमै बी डाही अमनोना लै खास्सी ज़ीद किल्हैकि तेऊ किई ती ज़ोरा-ज़ोरी तेऊए च़ेई तामारे कुंआरी ज़िन्दगी खतम। सह निं तेऊ संघै तेखअ चिंजदअ ई आथी त।<verse eid="2SA 13:22" /></para>
  <para style="s">अमनोन पाअ मारी</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />दूई साला बाद हुअ इहअ कि अबशलोमै मुनी एप्रैम नगरी नेल़ बाल-हसोर ज़ैगा आपणीं भेडा, तेऊ शादै राज़े सोभ टिक्‍कै तिधा लै। <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />अबशलोम डेऊअ राज़ै दाबेदा सेटा लै संघा बोलअ इहअ, “माहा राज़अ, मेरै दास आसा मेरी भेडा मुनदै लागै दै। तम्हैं आपणैं कार-करिंदै संघै तेऊ थैरा लै एछणैं?”<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />राज़ै दाबेदै बोलअ अबशलोमा लै, “नांई बेटैआ, ज़ै हाम्हैं सोभै एछे, सह हणअ ताल्है खास्सअ सैप्पअ।” अबशलोमै लाअ खास्सअ ज़ोर पर राज़ै किअ एछणा लै नांईं अर तेखअ बोलअ राज़ै अबशलोम लै डेऊ।<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />पर अबशलोमै बोलअ इहअ, “ज़ै तम्हां नांईं एछणअ, तै मेरअ भाई अमनोन ता लाअ मुंह संघै छ़ाडी?”</para>
  <para style="p" vid="2SA 13:26">दाबेद राज़ै बोलअ इहअ, “अह किल्है लाअ ताह संघै छ़ाडी?” <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />पर अबशलोमै लाअ खास्सअ ज़ोर कि दाबेदै छ़ाडै खिरी अमनोन अर होर शोहरू अबशलोमा संघै।</para>
  <para style="p" vid="2SA 13:27">अबशलोमै बणाईं राज़ै लै धाम। <verse eid="2SA 13:27" /><verse number="28" style="v" sid="2SA 13:28" />अबशलोमै डाहअ आपणैं नोकर-च़ाकरा का खोज़ी, “तम्हैं रहै चतैन, ज़ेभै अमनोन दाखो नशअ झुटी खास्सअ नशै दी होए, तेभै दैंऊं हुंह तम्हां लै शारअ कि एऊ पाआ मारी। तम्हैं निं फिकर करी, हुंह लऊं तेऊ मारने ज़िम्मैंबारी आप्पै। तम्हां लै बोलअ मंऐं, हिम्मत करै पिछ़ू निं हटी!” <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />ज़िहअ अबशलोमै खोज़ी त डाहअ द, तेऊए नोकर-च़ाकरै किअ तिहअ ई संघा पाअ अमनोन मारी। होर राज़े टिक्‍कै ठुर्है तिधा का आपणीं-आपणीं खच़रा प्रैंदै बेशी बापस।<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />तिंयां थिऐ अज़ी बाता ई घअरा बाखा एछदै लागै दै, राज़ै दाबेदा का हेरअ कुंणी इहअ खोज़ी, “अबशलोमै पाऐ तेरै सोभ शोहरू मारी, तिन्‍नां मांझ़ै निं एक बी बच़अ!” <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />दाबेद उझ़ुअ खल़अ अर तेऊ दुखै पाऐ तेऊ आपणैं झिकल़ै धेल़ी संघा बधल़ुअ आप्पू धरनीं। ज़ुंण राज़ै दाबेदा संघै तेऊए नोकर-च़ाकर थिऐ, तिन्‍नैं बी धेल़ै आपणैं झिकल़ै। <verse eid="2SA 13:31" /><verse number="32" style="v" sid="2SA 13:32" />पर दाबेदे भाई शिमेहे शोहरू जोनादाबै बोलअ, “राज़अ, मेरै मालक, तेरै सोभ शोहरू निं मारै आथी, तेऊ मारअ सिधअ अमनोन। ज़हा धैल़ी अमोनै ज़ोरा-ज़ोरी तामारा संघै सुत्ती तैहा लै दाग लाअ त, तधा ई ओर्ही ती अबशलोमै आपणैं दिलै अमनोना मारने डाही दी। <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />माहा राज़अ, मेरै मालक, तैही निं ऐहा गल्‍ला दी विश्वास करी कि तेरै पाऐ सोभ शोहरू मारी, हुंह बोला भाल़ सिधअ अमनोन पाअ मारी।”<verse eid="2SA 13:33" /></para>
  <para style="s">अबशलोम ठुर्हअ दाबेदे डरै</para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />तेतरी गअ अबशलोम आप्पू ठुर्ही।</para>
  <para style="p" vid="2SA 13:34">ज़ुंण सपाही एरुशलेम नगरीए गहल़ा सेटा पहरी थिऐ, तिन्‍नां का शुझुऐ उझै पछ़मा बाखा होथै धारे बाता खास्सै मणछ। तिन्‍नां मांझ़ै ठुर्हअ एक सपाही राज़ै का खोज़दअ, “माहा राज़अ, हाम्हां का शुझुऐ पिछ़िए बाता धारा बाती खास्सै मणछ एछदै।” <verse eid="2SA 13:34" /><verse number="35" style="v" sid="2SA 13:35" />तेखअ बोलअ जोनादाबै राज़ै लै, “भाल़ी बी, तिंयां आऐ तेरै शोहरू ज़िहअ मंऐं बोलअ त तिहअ ई हुअ।” <verse eid="2SA 13:35" /><verse number="36" style="v" sid="2SA 13:36" />ज़ेतरी जोनादाब गल्‍ला करी निं मुक्‍कअ, दाबेदे तिंयां शोहरू गऐ भितरी पुजी अर तिंयां लागै ज़ोरै-ज़ोरै लेरा लांदै अर राज़अ दाबेद अर तेऊए कार-करिंदै बी लागै हिक्‍की-सल़िक्‍की लेरा लांदै।<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37-38" style="v" sid="2SA 13:37-38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:37-38 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 3:3">2 शमू. 3:3</ref>
      </char>
    </note>अबशलोम ठुर्हअ बच़णा लै संघा पुजअ गशूर नगरीए राज़ै अमीहूदे शोहरू तलमाई सेटा संघा रहअ चिई साला तैणीं तिधी। दाबेद रहअ आपणैं शोहरू अमनोना लै खास्सै धैल़ै तैणीं शोग करदअ लागी। <verse eid="2SA 13:37-38" /><verse number="39" style="v" sid="2SA 13:39" />पर ज़ांऊं अमनोने मौत हई मुक्‍की ती, ऐबै च़ाहा त राज़अ दाबेद आपणैं शोहरू अबशलोमा सेटा दिला का डेऊणअ।<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s">जोआबै आणअ अबशलोम बापस</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />सरूयाहे शोहरू जोआबै हेरअ फैल़ी कि राज़ै दाबेदा आसा आपणैं शोहरू अबशलोमे सोठ पल़ी दी, <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />तेऊ छ़ाडै तकोआ नगरी लै दूत संघा शादी एक छ़ल़ैघ बेटल़ी। तैहा लै बोलअ जोआबै इहअ, “तूह बान्ह शोगे झिकल़ै, नां तूह मुंडै तेल लाई अर नां मूंड करिशी आथी। तूह कर इहअ दखाअ कि तूह आसा खास्सै धैल़ै ओर्ही लेर-पकार पाई शोग करदी लागी दी। <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />तेखअ डेओऐ राज़ै सेटा संघा बोलै ज़िहअ हुंह खोज़ूं तिहअ।” तेखअ डाहअ जोआबै तैहा का खोज़ी कि किज़ै बोल़णअ।<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />सह बेटल़ी डेऊई राज़ै सेटा लै संघा टेक्‍कअ राज़ै सेटा उटी बाख पल़ी माथअ। तेखअ बोलअ, “माहा राज़अ, मेरी मज़त कर!”<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />राज़ै बोलअ, “ताह किज़ै लोल़ी?”</para>
  <para style="p" vid="2SA 14:5">तैहा बोलअ, “माहा राज़अ, मेरअ मर्ध मूंअ, हुंह हुई बिधबा। <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />माहा राज़अ, मेरै तै दूई शोहरू, एकी धैल़ै झ़घल़ुऐ तिंयां खेचै अर तिन्‍नां निं तिधी कुंण धरैल़णै आल़अ बी आथी त, मेरै एकी शोहरू पाअ दुजअ शोहरू मारी। <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />मेरै मालक, ऐबै हुअ इहअ कि मेरी टोलीए सोभ लोग बोला मुल्है इहअ-इहअ, ‘ज़ुंणीं आपणैं भाईए हत्या किई तेऊ शोहरू दै ओर्ही म्हारै हाथै, सह पाणअ हाम्हां तैहा हत्या करनै पिछ़ू मारी।’ ज़ै तिंयां इहअ करे, मेरअ निं एक शोहरू बी रहणअ! खिरी ज़ुंण धख आशा मुंह रही दी बी आसा, सह लाई तिन्‍नैं खतम करी अर तिन्‍नैं लाअ इहअ करै मेरै मर्धो नाअं-नशाण ई खतम करी।”<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />राज़ै बोलअ तैहा लै, “तूह डेऊ घअरा लै, हुंह भाल़ूं आप्पै कि एता लै किज़ै करनअ।”<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />तैहा बोलअ, “मेरै मालक, ज़िहअ बी तूह करे, तेतो दोश लोल़ी मुल्है अर मेरी टोली लै लागअ, तूह अर तेरअ राज़ परिबार लोल़ी तेता का नर्दोश रहअ।”<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />राज़ै बोलअ, “ज़ै कुंण ताल्है धमकी दैए, तेऊ आणै मुंह सेटा लै, तेखअ निं तूह तेऊ कधि तंग करनी।”<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />तैहा बोलअ, “माहा राज़अ, ज़ीबाण, तूह काढ आपणैं परमेशर बिधाते नाओंऐं सोह कि ताह निं हत्या करने बदल़ै लणैं आल़ै मेरै रिश्तैदारे हाथै मेरै दुजै शोहरू मारनैओ घोर ज़ुल्म हणैं दैणअ।”</para>
  <para style="p" vid="2SA 14:11">राज़ै बोलअ तैहा लै, “मेरी रही ताल्है ज़बान, तेरै दुजै शोहरू निं हुंह किछ़ दैंदअ हणैं।”<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />तैहा बेटल़ी बोलअ भिई, “माहा राज़अ! मेरै मालक, ज़ीबाण, मुंह दै ताह सेटा एक गल्‍ल होर बोल़णैं।”</para>
  <para style="p" vid="2SA 14:12">राज़ै बोलअ, “बोल, तूह किज़ै बोला।”<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />तैहा बोलअ राज़ै लै, “मेरै मालक, ज़ेही ज़बान तंऐं मुल्है दैनी, तिहअ तूह सोभी लोगा लै किल्है निं करदअ? तेरै एऊ फैंसलै करै लागअ ताल्है ई दोश! किल्हैकि आपणैं शोहरू, तूह परदेसा का घअरै एछणैं निस्सअ दैई! <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />एकी नां एकी धैल़ै मरनै हाम्हैं सोभै अर हाम्हैं मुक्‍कणैं धरनीं पोछै दै पाणीं ज़िहै ज़ेता कुंण झाल़ी निं सकदअ। ज़ुंण मरी गअ, तेऊ निं परमेशर बी बापस फरेऊंदअ, पर तूह सका किज़ै एही तरकीब काढी कि बागै काढअ द मणछ घअरा लै बापस फिरे। <verse eid="2SA 14:14" /><verse number="15" style="v" sid="2SA 14:15" />माहा राज़अ, हुंह आई इधी ताह मेरै मालका सेटा आपणीं खरी खोज़दी, किल्हैकि हुंह ती लोगा का एही डरी दी कि झ़ाणीं लोग मुल्है किज़ै करे। तै सोठअ मंऐं इहअ, ‘मुंह डेऊणअ राज़ै सेटा लै अर तेऊ हेरनी मेरी मज़त करी।’ <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />मुखा त थोघ कि ताह शुणनी मेरी अर ताह हेरनअ मेरअ शोहरू तिन्‍नां बदल़ै लणैं आल़ै का बच़ाऊई ज़ुंण परमेशरै दैनी दी ज़ैगा का मेरै दुही शोहरू खतम करनअ च़ाहा। <verse eid="2SA 14:16" /><verse number="17" style="v" sid="2SA 14:17" /><note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="2SA 19:27">2 शमू. 19:27</ref></char></note>हुंह लागी इहअ सोठदी, ‘ज़ुंण माहा राज़अ, मेरअ मालक फैंसलअ करे, तेता करै जाणीं हुंह बच़ी,’ किल्हैकि राज़अ हआ परमेशरे स्वर्ग दूता ज़िहअ अर तेऊ का हआ थोघ कि कै भलअ आसा अर कै बूरअ आसा। मेरी आसा बिधाता का एही ई अरज़ कि सह लोल़ी सदा ताह संघै रहअ!”<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />राज़ै दाबेदै दैनअ ज़बाब, “मंऐं लाई ताखा एक गल्‍ल पुछ़ी, तूह खोज़ै मुखा शुची गल्‍ला।”</para>
  <para style="p" vid="2SA 14:18">तैहा बेटल़ी बोलअ, “हाँ, मेरै मालक, तूह पुछ़ मुखा।”<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />राज़ै बोलअ, “तूह मुखा इना गल्‍ला बोल्दी जोआबै आसा छ़ाडी दी?”</para>
  <para style="p" vid="2SA 14:19">तैहा दैनअ ज़बाब, “मेरै मालक, हुंह काढा तेरै सोह, ताखा निं कोहै किछ़ू गल्‍लो टवारअ करी सकदअ। हुंह खोज़ा शुचअ कि हाँ, ईंयां गल्‍ला आसा मुखा जोआबै डाही दी खोज़ी कि इहअ बोलै। <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />पर जोआबै किअ इहअ एते तैणीं कि तेरअ धैन तेथ बाखा डेओए कि असली गल्‍ल किधी आसा शाची दी। मेरै मालक, ताह हुई परमेशरे स्वर्ग दूता ज़ेही अक्ल डाहणीं, तिन्‍नां का हआ हर गल्‍लो थोघ कि धरती दी किज़ै आसा हंदअ लागअ द।”<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />बादा का बोलअ राज़ै दाबेदै जोआबा लै इहअ, “ज़िहअ तूह च़ाहा, मंऐं आसा लाअ द तिहअ ई करी। तूह डेऊ संघा आण शोहरू अबशलोमा घअरा लै बापस।”<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />जोआब पल़अ धरनीं उटी बाखा संघा टेक्‍कअ राज़ै दाबेदा सेटा माथअ, तेखअ बोलअ इहअ, “बिधाता लोल़ी ताल्है खास्सी बर्गत दैनी। मेरै मालक! ऐबै ज़ाण्हुंअ मुखा कि तूह आसा मुखा खुश। किल्हैकि तंऐं दैनी मुल्है ज़ाज़त।” <verse eid="2SA 14:22" /><verse number="23" style="v" sid="2SA 14:23" />तेखअ उझ़ुअ जोआब खल़अ संघा डेऊअ गशूर अर तिधा का आणअ तेऊ अबशलोम एरुशलेम नगरी लै बापस। <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />राज़ै किअ इहअ हुकम, “अबशलोमा निंयां तेऊए घअरा लै, तेऊ निं इधी मेरै मैहला लै आणी, हुंह निं तेऊ भाल़णअ च़ाहंदअ।” अबशलोम डेऊअ आपणैं घअरा लै अर सह निं राज़ै दाबेदे मोहरै लागअ आथी।<verse eid="2SA 14:24" /></para>
  <para style="s">अबशलोमो राज़ै दाबेदा संघै मेल़-ज़ोल़</para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />अबशलोम त सारै इज़राईला दी हेरनअ बेघै बित्तअ, तेऊ सान निं होर कोहै आथी त, तेऊ निं मुंडा का घुंढी तैणीं किछ़ै नुक्श आथी ई ती। <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />तेऊए मुंडे शराल़ तै घणैं, ज़ांऊं तेऊए मुंडे शराल़ खास्सै लाम्मै हआ तै, सह करा त हर साल आपणअ मूंड छाम्बी निखल़अ। तिंयां शराल़ निखल़ा तै बाटा करै तोली कोई ढाई किलू। <verse eid="2SA 14:26" /><verse number="27" style="v" sid="2SA 14:27" />अबशलोमे तै चअन शोहरू अर एक ती शोहरी अर तैहा नाअं बी त तेऊ तामार डाहअ द अर सह बी ती हेरनी बेघै बित्ती।<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />अबशलोम रहअ दूई साला तैणीं एरुशलेम नगरी अर सह निं राज़े मोहरै डेऊअ ई आथी। <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />तेखअ शादअ तेऊ जोआब कि राज़ै सेटा डेऊई करे सह तेऊए बारै गल्‍ला, पर जोआब निं आअ ई आथी। तेखअ दैनअ अबशलोमै जोआबा लै भिई फैल़अ पर सह निं आअ ई आथी। <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />तेखअ बोलअ अबशलोमै आपणैं दासा का, “म्हारै खेचा पोर्ही आसा भाल़ै एक खेच जोआबो, तेथ आसा ज़ौ पाकदै लागै दै, तम्हैं डेओआ संघा चैल़ा तेऊ खेचै आग।” तिंयां डेऊऐ संघा डाही जोआबे खेचै आग चैल़ी।<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />जोआब डेऊअ अबशलोमे घअरै संघा बोलअ, “तेरै नोकर-च़ाकरै मेरै खेचै आग किल्है चैल़ी?”<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />अबशलोमै बोलअ जोआबा लै, “हुंह थक्‍कअ ताह शादी-शादी, तूह निस्सअ एछी! हुंह च़ाहा इहअ कि तूह डेऊ राज़ै सेटा संघा कर मेरै बारै गल्‍ला, ‘हुंह गशूर नगरी का इधा लै किज़ू आणअ, एता का थिअ हुंह तिधी ठीक?’ हुंह च़ाहा इहअ कि तूह कर मेरअ राज़ै सेटा डेऊणेओ इंतज़ाम, ज़ै मेरअ किज़ै दोश आसा, तै पाए सह मुंह मारी बी।”<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />तेखअ डेऊअ जोआब राज़ै दाबेदा सेटा संघा खोज़ी पठी गल्‍ला कि अबशलोम बोला इहअ। तेखअ छ़ाडै राज़ै अबशलोमा शाददै आदमी संघा डेऊअ सह राज़ै दाबेदा सेटा, तेऊ सेटा टेक्‍कअ धरनीं उटअ पल़ी माथअ। राज़ै दैनी तेऊ लै मल़्हैची अर च़ुंज़ी माख्खी।<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s">अबशलोमै किअ द्रोह</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />थोल़ै धैल़ै बाद हुअ इहअ कि अबशलोमै डाहै आप्पू लै रथ, घोल़ै अर आप्पू आजू-आजू ठुहर्नै आल़ै पज़ाह सपाही। <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />अबशलोम उझ़िआ त धैल़ दोत्ती-दोत्थी संघा खल़्हिया त नगरीए प्रऊल़ी सेटे सल़का। ज़ेभै बी तिधी कुंण आपणैं झ़गल़ैओ राज़ै सेटा नसाफ करदअ एछा त, अबशलोम करा त तिन्‍नां पुछ़ी, “तूह कहा नगरी का आअ?” ज़ांऊं तिंयां मणछ इहअ खोज़ा तै कि तिंयां आसा इज़राईला मांझ़ै फलाणै गोत्रा का, <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />अबशलोम करा त तिन्‍नां लै इहअ बोली, “भाल़, बधान ता आसा तेरै पक्षा दी, पर राज़ै बाखा निं तेरै मकदमैं शुणनै आल़अ कोहै आथी!” <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />तेखअ बोला त अबशलोम इहअ बी, “तै भाल़ किहअ हणअ त ज़ै हुंह एऊ देशो पांच़ हंदअ! तै ज़ेतरै मकदमैं मुंह सेटा एछदै तिन्‍नां लै दैणअ त मुंह नसाफ करी।” <verse eid="2SA 15:4" /><verse number="5" style="v" sid="2SA 15:5" />तेखअ ज़ै कुंण तेऊ सेटा एछी माथअ टेक्‍का त, अबशलोम डेओआ त तेऊ सेटा मल़्हैची माख्खू दैंदअ। <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />ज़ेतरै बी इज़राईली तिधी राज़ै सेटा आपणैं मकदमें नसाफ करदै एछा तै, अबशलोम करा त तिन्‍नां सोभी संघै इहअ ई। इहअ करै गम्मअ इज़राईली अबशलोम दाबेद राज़ै का खास्सअ।<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />एही ई ज़ांऊं च़ार साला बिति, अबशलोमै बोलअ आपणैं बाब राज़ै दाबेदा लै इहअ, “मुल्है दै हेब्रोन नगरी डेऊणे ज़ाज़त, मंऐं आसा बिधाता लै मानत मनी दी, तिधी डेऊई करनी मुंह सह पूरी। <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />ज़धू हुंह अराम देशे गशूर नगरी त रहंदअ लागअ द, तधू मनी ती मंऐं बिधाता लै एही मानत, ज़ै हुंह एरुशलेम आपणैं घअरा लै फिरी डेओए, तेखअ एछणअ मुंह बिधाता सेटा माथै टेक्‍कदै हेब्रोन नगरी।”<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />राज़ै बोलअ इहअ, “तूह लाग राज्ज़ी-मौज़ी डेऊंदअ।”</para>
  <para style="p" vid="2SA 15:9">अबशलोम डेऊअ हेब्रोन नगरी लै, <verse eid="2SA 15:9" /><verse number="10" style="v" sid="2SA 15:10" />पर तेऊ छ़ाडै सोभी इज़राईली गोत्रा लै इहअ समाद दैई दूत, “ज़ेभै तम्हैं नर्शिंगे बाज़णें छ़ेल़ शुणें, तेभै बोलै तम्हैं, ‘अबशलोम बणअ हेब्रोन नगरीओ राज़अ।’”<verse eid="2SA 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 15:11" />अबशलोमा संघै डेऊऐ एरुशलेम नगरी का दूई शौ ज़ण्हैं ज़ुंण तेऊ आप्पू संघै एछणा लै शादै। तिंयां डेऊऐ तेऊ संघै भलै मन्‍नैं अर तिन्‍नां का निं थोघ आथी त कि अबशलोमे दिलै किज़ै आसा। <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />हेब्रोन नगरी किअ अबशलोमै बल़ीदान संघा छ़ाडअ कुंण गीलो नगरी लै आहीतपेला शधाणूं ज़ुंण दाबेद राज़ैओ सलाहकार थिअ। इहअ करै हुऐ अबशलोमा संघै खास्सै आदमी अर अबशलोमा लै लागअ राज़ द्रोह करना लै बल भेटदअ।<verse eid="2SA 15:12" /></para>
  <para style="s">राज़अ दाबेद ठुर्हअ एरुशलेम नगरी का</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />राज़ै दाबेदा का हेरअ कुंणी खोज़ी, “ऐबै गऐ सोभ इज़राईली ताह छ़ाडी अबशलोमा बाखा फिरी!”<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />दाबेदै बोलअ तेखअ आपणैं सोभी कार-करिंदै लै ज़ुंण तेऊ संघै तिधी एरुशलेम थिऐ, “हाम्हां हुअ अबशलोमा का बच़दै इधा का दूर डेऊणअ! छ़ेक्‍कअ करा! इहअ निं हआ कि सह तेतरी इधी पुजी जाए अर सह हाम्हां गोटे अर सारी नगरीए लोगा मारी पाए!”<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />तिन्‍नैं बोलअ, “हाँ, माहा राज़अ, म्हारै मालक, ज़िहअ ताखा राम्बल़अ ज़ाण्हिंआं हाम्हैं आसा तिहअ करना लै तैर।” <verse eid="2SA 15:15" /><verse number="16" style="v" sid="2SA 15:16" />राज़अ दाबेद डेऊअ एरुशलेम नगरी छ़ाडी, तेऊ पिछ़ू डेऊऐ तेऊए सारै टबर अर सारै कार-करिंदै। पिछ़ू डाही मैहलै फाज़त करना लै दाबेदै आपणीं डाही दी बेटल़ी मांझ़ै दस ज़ण्हीं।<verse eid="2SA 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 15:17" />राज़अ लागअ हांढदअ अर तेऊ पिछ़ू डेऊऐ तेऊए सोभ आदमी। खिरी बेतमेहक नगरीए पुंझ़ै ज़ुंण घअर थिअ, तिंयां खल़्हुऐ तिधी। <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />सोभ कार-करिंदै खल़्हुऐ राज़ै नेल़ अर फाज़त करनै आल़ै डेऊऐ लगैग लाई तेऊए मुंहां आजू बाती पोर्ही। छ़ह शौ सपाही ज़ुंण गात नगरी का तेऊ पिछ़ू तै आऐ दै, तिंयां बी लागै राज़ै आजू बाती आजू हांढदै, <verse eid="2SA 15:18" /><verse number="19" style="v" sid="2SA 15:19" />अर गात नगरीओ ईताई त तिन्‍नों प्रधान, तेऊ लै बोलअ राज़ै दाबेदै, “तूह किल्है च़ाल्‍लअ हाम्हां संघै? तूह डेऊ फिरी संघा रह नऊंऐं राज़ै संघै। तूह आसा परदेसी अर आपणैं देशा का आसा तूह दूर लागअ द रहंदअ। <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />ताह निं इधी एछी खास्सअ बगत हुअ, तूह किल्है डाहणअ मुंह आप्पू संघै धाक्‍कै खांदअ लाई? मुखा निं आपणअ ई थोघै कि मुंह केत बाखा डेऊणअ! तै बोला हुंह ताल्है कि तूह डेऊ फिरी अर आपणैं सोभी आदमी बी निंऊं संघा। मेरी आसा बिधाता का एही अरज़ कि ताल्है लोल़ी तेऊए खास्सी झींण अर ज़श भेटअ।”<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />पर ईताई दैनअ राज़ै लै ज़बाब, “मेरै मालक, हुंह खाआ बिधाते अर तेरै सोह, ज़िधा लै बी तूह डेओए, मुंह डेऊणअ कबल्‍लै ताह ई संघै, च़ाऐ तूह मरदअ डेओए च़ाऐ ज़िऊंदअ।”<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />राज़ै दाबेदै बोलअ, “ज़ेही तेरी मरज़ी, तै लाग पारा बाखा लै हांढदअ!” इहअ करै डेऊअ ईताई आपणैं सोभी आदमी अर तिन्‍नें शोहरू-माठै संघी, संघा निखल़ै किद्रोन गाडा पार। <verse eid="2SA 15:22" /><verse number="23" style="v" sid="2SA 15:23" />ज़ांऊं दाबेद अर तेऊए आदमी नगरी छ़ाडी डेऊऐ, सोभ लोग लागै लेरा लांदै। राज़अ दाबेद बी डेऊअ किद्रोन गाडा पार, तेऊए आदमी बी डेऊऐ तेऊ संघै संघा लागै तिंयां रेगीस्ताना बाखा आजू हांढदै।<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />तिंयां लागै भाल़ै कि सदोक प्रोहत अर तेऊ संघै होर लेबी गोत्रे लोग आऐ बिधाते करारे मणशू च़की। तिन्‍नैं बशैल़अ करारो मणशू धरनीं अर ज़ांऊं तैणीं नगरी छ़ाडी सोभ लोग निं आऐ तेभै तैणीं डाहअ तिन्‍नैं सह तिधी। अबतार प्रोहत बी थिअ तिधी अर सह रहअ तेभै तैणीं बल़ीदान करदअ लागी। <verse eid="2SA 15:24" /><verse number="25" style="v" sid="2SA 15:25" />तेखअ बोलअ राज़ै दाबेदै सदोक प्रोहता लै, “बिधाते करारो मणशू निंऊं नगरी लै बापस। ज़ै बिधाता मुल्है खुश होए, तेऊ हेरनअ हुंह बापस आपणीं ज़ैगा पजैल़ी ज़िधी अह डाहअ द हआ। <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />पर ज़ै बिधाता इहअ बोले, ‘हुंह निं ताखा खुश आथी,’ तैबी आसा ठीक, तेखअ ज़िहअ बिधाता च़ाहे सह करे मुंह संघै तिहअ बभार।” <verse eid="2SA 15:26" /><verse number="27" style="v" sid="2SA 15:27" />तेखअ बोलअ राज़ै दाबेदै सदोक प्रोहता लै इहअ, “तूह आसा आप्पै समझ़कार! तूह डेऊ राज्ज़ी-मौज़ी आपणीं नगरी घअरा लै, आपणैं शोहरू आहीमास अर अबतारे शोहरू जोनाताना बी निंऊं दुही आप्पू संघै। <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />मुंह निं तेभै तैणीं जरदण नदीए बाढा का रेगीस्ताना भितरी डेऊणअ, ज़ेभै तैणीं मुंह तम्हां बाखा समाद निं भेटे कि एरुशलेम नगरी पिछ़ू किज़ै-किज़ै हुअ।”<verse eid="2SA 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 15:29" />तेखअ छ़ाडअ सदोक अर अबतार प्रोहतै परमेशरे करारो मणशू एरुशलेम नगरी लै बापस आप्पू रहै तिधी।<verse eid="2SA 15:29" /></para>
  <para style="s">दाबेद अर हुशाई</para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />तेखअ लागअ दाबेद उझै जैतूने धारा प्रैंदा लै मडेस्की बान्हीं नगाही लेरा लांदी-लांदी उझै उखल़दअ। तेऊ संघै ज़ेतरै लोग थिऐ, तिंयां बी लागै मडेस्की बान्हीं लेरा लांदै। <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />तेखअ पुजअ दाबेदा सेटा इहअ समाद, “अबशलोमे द्रोही छ़ुंढा संघै ज़ुल़अ आहीतपेल बी।” दाबेदै बोलअ इहअ, “हे बिधाता, आहीतपेलै लोल़ी ती अबशलोमा लै ऐडी सलाह दैनी।”<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />ज़ांऊं दाबेद धारे च़ुंडी पुजअ ज़िधी बिधाता लै बल़ीदान करने बेदी थिई, तिधी आअ हुशाई ज़ुंण अरेकी ज़ातीओ अर दाबेदो साथी थिअ। सह आअ आपणअ च़ोल़अ धेल़ी, मुंडै माट्टअ पाई दाबेदा सेटा मिलदअ। <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />दाबेदै बोलअ तेऊ लै, “ज़ै तूह बी मुंह संघै एछे, ताह करै पल़णअ मुल्है होर पै खास्सअ बोझ़, <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />पर नगरी लै बापस फिरी सका तूह मेरी इहअ करै मज़त करी ज़ै तूह अबशलोमा लै इहअ बोले, ‘माहा राज़अ, मुंह करनीं आझ़ा बाद आपणीं सलाह करै तेरी च़ाकरी, ज़िहअ हुंह तेरै बाबा लै भरोस्सैमंद थिअ।’ हुशाई, इहअ करै सका तूह आहीतपेल बरैबाद करना लै मेरी मज़त करी। <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />तिधी हणैं सदोक अर अबतार प्रोहत बी ताह संघै, ज़ुंण बी गल्‍ला राज़े मैहलै होए, तिन्‍नां खोज़ै पठी तिन्‍नां का। <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />तिन्‍नां संघै हणैं तिन्‍नें दूई शोहरू सदोको शोहरू आहीमास अर अबतारो शोहरू जोनातान बी, तिन्‍नां सका तूह मुंह सेटा लै पूरअ हाल खोज़ी समादा पजैल़ै छ़ाडी।”<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />तेखअ डेऊअ दाबेदो साथी हुशाई एरुशलेम नगरी लै फिरी अर अबशलोम बी पुजअ एरुशलेम नगरी।<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s">दाबेद अर सिबू</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 9:9">2 शमू. 9:9</ref>,<ref loc="2SA 9:10">10</ref></char>
    </note>ज़ांऊं दाबेद जैतून धारे च़ुंडी पोर्ही ज़िहअ डेऊअ, तेऊ भेटअ तिधी नच़ानक मोपीबशेतो दास सिबू, तेऊ तै आप्पू संघै ज़ोल़ी गाधै दी दूई शौ रोटी, एक शौ दाखे टिक्‍की, ताज़ै फल़े शौ गांठल़ी अर एक खाल्हल़अ दाखे रसो लादी आणै दै। <verse eid="2SA 16:1" /><verse number="2" style="v" sid="2SA 16:2" />राज़ै पुछ़अ सिबू का, “तंऐं किज़ू आणी ईंयां च़िज़ा?”</para>
  <para style="p" vid="2SA 16:2">सिबू दैनअ ज़बाब, “माहा राज़अ, ईंयां गाधै आसा तेरै टबरा लै शुंआरी, रोटी अर ताज़ै फल़ आसा ताह संघै मणछा लै खाणां लै अर अह दाखे रसे खाल्हल़ी आसा एते तैणीं, ज़ै तम्हैं रेगीस्तानै हांढदी थके, तै हणअ तम्हां एता का झुटणा लै।”<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="2SA 19:25-27">2 शमू. 19:25-27</ref></char></note><verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />दाबेदै पुछ़अ तेऊ का, “तेरअ मालक मोपीबशेत किधी आसा?” सिबू बोलअ, “सह रहअ एरुशलेम नगरी ई, किल्हैकि तेऊ आसा ऐबै एही आशा कि इज़राईली हेरनअ ऐबै मेरै दादू शाऊलो राज़ मुल्है बापस दैई।”<verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />राज़ै दाबेदै बोलअ सिबू लै, “ज़ुंण बी ज़ैदात मोपीबशेते आसा, सह आसा ऐबै तेरी।”</para>
  <para style="p" vid="2SA 16:4">सिबू बोलअ इहअ, “मेरै मालक, हुंह आसा तेरअ दास, मुंह करै लोल़ी तूह सदा खुश रहअ!”<verse eid="2SA 16:4" /></para>
  <para style="s">दाबेद अर शिमी</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />ज़ांऊं राज़अ दाबेद बहूरीम पुजअ, शाऊलो एक टबर गेरो शोहरू शिमी आअ दाबेदा सेटा तेऊ लै फिटक दैंदी मिलदअ। <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />शिमी लागअ राज़ै दाबेद अर तेऊए कार-करिंदै लै पात्थरै बाहंदअ, दाबेदा फेर त सपाही घेरअ डाहअ द पाई। <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />शिमी लागअ दाबेदा लै बखर्दअ अर एही गाल़ी दैंदअ, “इधा का डेऊ दूर! तूह कदुष्ट हअ दूर! डेऊ इधा का तूह पापी! तूह हत्या करनै आल़अ! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />तंऐं खाअ शाऊलो राज़, ऐबै आसा बिधाता ताल्है शाऊले सारै खिंबे हत्या करने सज़ा दैंदअ लागअ द। ताह हुई भली! बिधाता छ़ड़ैऊअ तेरै हाथा का राज़ संघा दैनअ तेरै शोहरू अबशलोमा लै, किल्हैकि तूह आसा खुंनी, तंऐं पाई आप्पू लै आफ़त आप्पै।”<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />अबीशै ज़सरी ईज सरूयाह थिई, तेऊ बोलअ राज़ै दाबेदा लै, “मेरै मालक, तूह किल्है आसा एऊ कुक्‍करे खाखा का आप्पू लै गाल़ी शुणदअ लागअ द? मुल्है दै ज़ाज़त एऊओ लाअ मंऐं एभी तलबारा करै मुंडकअ धरनीं शोटी!”<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />राज़ै दाबेदै दैनअ ज़बाब, “नां, सरूयाहे शोहरूओ, तम्हां का कुंणी मांगी सलाह? ज़ै एऊ लै बिधाता बोलअ होए, ‘दाबेदा लै एछ फिटक दैई,’ तै निं एऊ का इहअ पुछ़णेंओ कोही हक आथी कि तंऐं इहअ किल्है किअ!”<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />तेखअ बोलअ दाबेदै अबीशै अर आपणैं सोभी कार-करिंदै लै, “ज़ै मेरअ आपणअ ई शोहरू मुंह मारदअ मेरै पिछ़ै आसा पल़अ द, तै निं ऐहा गल्‍ला लै रहैन हआ कि एऊ बिन्यामीन गोत्रे मणछै किअ इहअ। एऊ दैआ रहणैं, एऊ दैआ ज़िहअ एऊओ दिल बोला तेही गाल़ी दैणैं। हई सका कि एऊ लै बिधाता होए बोलअ द कि अह मुल्है फिटक दैए। <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />इहअ बी सका हई कि बिधाता मुंह संघै हंदै एऊ उपद्रभा भाल़ी मुल्है फिटक पल़णें बदल़ै धख बर्गत दैई हेरे।” <verse eid="2SA 16:12" /><verse number="13" style="v" sid="2SA 16:13" />तेखअ लागै दाबेद अर तेऊ संघै तिंयां सोभ ज़ण्हैं बाता आजू हांढदै। शिमी रहअ तिन्‍नां उझै धारठी प्रैंदी पोर्ही तिन्‍नां ई संघै हांढदी-हांढदी गाल़ी दैई फिटक दैंदअ लागी अर तिन्‍नां लै पात्थर अर धूल़अ-माट्टअ शोटदअ लागी। <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />तेखअ पुजै राज़अ अर तेऊ सोभ आदमी आजू जरदण नदी नेल़, तिंयां थिऐ खास्सै थकै दै, तेखअ किअ तिन्‍नैं तिधी राम।<verse eid="2SA 16:14" /></para>
  <para style="s">अबशलोम पुजअ एरुशलेम नगरी</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />अबशलोम अर तेऊ संघै ज़ेतरै इज़राईली थिऐ, तिंयां पुजै एरुशलेम नगरी अर आहीतपेल बी थिअ तिन्‍नां संघै। <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />ज़ांऊं दाबेदो खास साथी अरेकी ज़ातीओ हुशाई अबशलोमा सेटा मिलदअ डेऊअ, तेऊ बोलअ ज़ोरै-ज़ोरै, “राज़े लोल़ी लाम्मी अमर हुई! राज़े लोल़ी लाम्मी अमर हुई!”<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />अबशलोमै पुछ़अ तेऊ का इहअ, “इहअ करै नभाऊई तंऐं आपणैं साथी दाबेदा संघै साथ? तूह तेऊ संघै किल्है निं डेऊअ?”<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />हुशाई दैनअ अबशलोमा लै ज़बाब, “हुंह किहअ करै सका डेऊई? हुंह आसा तेऊ संघै ज़ुंण बिधाता अर इज़राईली आप्पू लै राज़अ छ़ांटअ। मुंह रहणअ ताह ई संघै। <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />एही बी मुंह किल्है निं करनीं तेरी च़ाकरी? ज़िहअ हुंह तेरै बाबा लै सलाहकार थिअ, तिहअ ई हणअ हुंह ऐबै तेरअ सलाहकार!”<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />तेखअ फिरअ अबशलोम आहीतपेला बाखा संघा बोलअ इहअ, “तम्हैं बी आसा इधी हैनूं, एता लै थारी कै सलाह आसा?”<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />आहीतपेलै दैनअ अबशलोमा लै ज़बाब, “तूह डेऊ संघा ज़ुंण तेरै बाबै आपणीं डाही दी बेटल़ी मैहलै फाज़त करदी पिछ़ू आसा छ़ाडी दी, तूह सुत्त तिन्‍नां सोभी संघै। ज़ांऊं सोभी इज़राईली ऐहा गल्‍लो थोघ लागणअ कि तेरअ बाब समझ़ा ताह आपणअ दुशमण, तेखअ एछणी तेरै आदमी खास्सी हिम्मत।” <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />तिन्‍नैं किअ मैहला प्रैंदै अबशलोमा लै एक खिम्भ खल़अ। संघा सुत्तअ अबशलोम तिधी तेऊ संघै सोभी इज़राईली नदरी आपणैं बाबे डाही दी बेटल़ी संघै बारी-बारी!<note caller="-" style="x"><char style="xo" closed="false">16:22 </char><char style="xt" closed="false"><ref loc="2SA 12:11">2 शमू. 12:11</ref>,<ref loc="2SA 12:12">12</ref></char></note><verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />तिन्‍नां धैल़ै ज़ुंण सलाह आहीतपेल दैआ त, तेऊए सलाह मना तै एही कि ज़िहै तिंयां बैण आसा परमेशरे। दाबेद बी मना तै तिहअ ई अर अबशलोम बी।<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="s">आहीतपेले अबशलोमा लै सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />खास्सै धैल़ै निं हुऐ तै कि आहीतपेलै बोलअ अबशलोमा लै, “मुंह दै बारा हज़ार मणछ छ़ांटणैं अर हुंह च़ाल्‍लअ आझ़ ई राची दाबेदे पिछ़ै करदअ डेऊई। <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />ज़िधी तेऊओ हैअ चुटे अर खास्सअ थक्‍कअ द होए, तिधी ढाकणअ मुंह सह। तेऊ छ़ुटणअ डरै दर्छ़णअ अर तेऊ संघे आदमी ठुहर्नै तिधा का डरै। तिधी निं मुंह राज़ै दाबेदा का सुआई होर कोहै मारनअ, <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />तेखअ आणनैं मुंह तेऊए सोभ आदमी ताह सेटा लै। तूह बी च़ाहा सिधअ एकी ई मणछा मारनअ अर बाकी सारी परज़ा रहणीं राज्ज़ी राम्बल़ी।” <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />अह गल्‍ल ज़ाण्हुंई अबशलोम अर तिन्‍नां संघै तिधी होरी इज़राईली का बेघै राम्बल़ी!<verse eid="2SA 17:4" /></para>
  <para style="s">हुशाईए सलाह</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />अबशलोमै बोलअ, “अरेकीए हुशाई आणा ओर्ही शादी, हुंह भाल़ूं हैनूं एते बारै तेऊए किज़ै सलाह आसा।” <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />ज़ांऊं हुशाई आअ अबशलोमै बोलअ तेऊ लै इहअ, “आहीतपेलै दैनी हाम्हां लै एऊ साबै सलाह, तूह बी एऊ ई साबै बोला कि तेरी किज़ै होर सलाह आसा? तै बोल।” <verse eid="2SA 17:6" /><verse number="7" style="v" sid="2SA 17:7" />हुशाई दैनअ अबशलोमा लै ज़बाब, “ज़ुंण सलाह तम्हां लै एभै आहीतपेलै दैनी, मेरै साबै निं सह ठीक आथी! <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />ताखा आसा आप्पै थोघ कि तेरअ बाब दाबेद अर तेऊए आदमी आसा ज़बर शूरबीर। एभै आसा तिंयां रोश्शै एही भाल्‍लणी ज़िहै करबैऊंणैं हुऐ दै ज़सरअ बच़अ हआ लुक्‍कअ द। तेरअ बाब आसा आप्पू ज़ाण-प्रबीण जोधअ अर सह डेओआ राची सुत्तदअ बी आपणीं सैना का दूर। <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />ऐहा बेला हणअ सह किधी खात्ती या किधी होर्ती डुआरै लुक्‍कअ द। ज़ै दाबेद पैहलै ई थारै आदमी गोटे अर तिन्‍नां मांझ़ै खास्सै मारी पाए, इना गल्‍ला शूणीं बोल़णअ लोगा, ‘अबशलोमे आदमी हारै!’<verse eid="2SA 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 17:10" />“तेखअ पल़णीं तेऊ शूरबीरा बी भितरी डअर ज़ुंण सिहा ज़ेही हिम्मत डाहा किल्हैकि सोभी इज़राईली का आसा थोघ कि तेरअ बाब आसा महान जोधअ अर तेऊ संघै आदमी बी आसा शूरबीर। <verse eid="2SA 17:10" /><verse number="11" style="v" sid="2SA 17:11" />मेरी सलाह आसा ताल्है एही कि दान मुल्खा उंधै बेर्शेबा तैणीं सारै देशै बस्सै दै इज़राईलीओ कर झाल़अ, तिंयां लोल़ी समुंदरे रेता ज़िहै खास्सै हुऐ संघा डेऊ तूह आप्पै जुधा लै। <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />तेखअ दाबेद ज़िधी बी होए सह हेरनअ हाम्हां लोल़ी अर तेऊ मारदै पल़णअ हाम्हां नच़ानक चुटी ज़िहअ ज़िम्मीं दी ओश पल़ा, तेखअ नां सह बच़णअ अर नां तेऊए साथी मांझ़ै कुंण बच़णअ। <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />तेखअ ज़ै सह कहा नगरी दी होए लुक्‍कअ द, तेता लै निंणै हाम्हां इज़राईली राश्शै संघा पाणअ हाम्हां नगरी फेरो गहल़ उंधै गाडा लै ढोल़ी। तेथ निं हाम्हां एक होछ़अ ज़िहअ पात्थर बी खल़अ छ़ाडणअ।”<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />अबशलोम अर होरी इज़राईली बोलअ, “अरेकी हुशाईए सलाह आसा आहीतपेला का राम्बल़ी।” अह किअ बिधाता ई कि आहीतपेले राम्बल़ी सलाह बी लागी तिन्‍नां निक्‍की, ताकि अबशलोमा लै आफ़त पल़े।<verse eid="2SA 17:14" /></para>
  <para style="s">हुशाई हेरी दाबेदा लै चतैनगी दैई</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />तेखअ खोज़अ हुशाई सदोक अर अबतार प्रोहता का, “आहीतपेलै दैनी ती अबशलोम अर इज़राईली सैणैं लै एही-एही सलाह अर मंऐं दैनी एही सलाह। <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />ऐबै करा तम्हैं छ़ेक्‍कअ! राज़ै दाबेदा लै दैआ समाद, ‘आझ़ राची निं दरैऊए बाढै रेगीस्तानै रही, तिधा का निखल़ै पार बाखा लै, इहअ निं हआ कि तिंयां ताह अर तेरै सारै आदमी ढाकी मारी पाए।’”<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />अबतार प्रोहतो शोहरू जोनातान अर सदोक प्रोहतो शोहरू आहीमास रहै नगरी का दूर अनरोगल़ कुहै नेल़ न्हैल़ै लागी, किल्हैकि तिंयां निं सोभी नदरी नगरी भितरी डेऊई सकदै तै। एक दासी करा ती तिन्‍नां सेटा खोज़दी एछदी कि इहअ-इहअ हुअ अर तेखअ डेओआ तै तिंयां राज़ै दाबेदा सेटा खोज़दै। <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />पर एकी धैल़ै हेरै तिंयां एकी शोहरू भाल़ी अर तेऊ खोज़अ अबशलोमा का। पर तिंयां दुहै निखल़ै तिधा का छ़ेक्‍कै-छ़ेक्‍कै संघा पुजै एकी मणछे घअरै ज़ुंण बहूरीम नगरी का थिअ, तेऊए खोल़ै त एक कुहअ अर तिंयां होथै तेथ भितरा लै उंधै। <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />तेऊए लाल़ी ढोप्पअ कुहैओ मोहरअ च़ादरू करै संघा डाहअ तेथ प्रैंदै दल़अ द नाज़ शुक्‍कणैं पाई अर इहअ करै निं कोही का थोघ लागअ। <verse eid="2SA 17:19" /><verse number="20" style="v" sid="2SA 17:20" />अबशलोमे आदमी पुजै तेऊ घअरै संघा लागै तैहा बेटल़ी पुछ़दै, “आहीमास अर जोनातान किधी आसा?”</para>
  <para style="p" vid="2SA 17:20">तैहा बोलअ, “मंऐं भाल़ै तिंयां गाडा पार टपदै।”</para>
  <para style="p" vid="2SA 17:20">तिंयां रहै तिन्‍नां लोल़ै लागी पर तिन्‍नां निं तिंयां भेटै, खिरी डेऊऐ तिंयां एरुशलेम नगरी लै बापस फिरी। <verse eid="2SA 17:20" /><verse number="21" style="v" sid="2SA 17:21" />ज़ांऊं अबशलोमे आदमी तिधा का डेऊऐ, तेखअ निखल़ै आहीमास अर जोनातान कुहै का उझै संघा डेऊऐ राज़ै दाबेदा सेटा, तिन्‍नैं खोज़अ, “आहीतपेलै दैनी ती एही सलाह, ऐबै करा तम्हैं छ़ेक्‍कअ, तम्हैं डेओआ दरैऊआ पार।” <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />दाबेद अर तेऊ संघै तिंयां सोभ आदमी लागै जरदण नदी पार टपदै अर राच भैणै का आजी गऐ तिंयां दरैऊआ पार निखल़ी।<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />ज़ांऊं आहीतपेलै भाल़अ कि ज़ेही तेऊ सलाह दैनी, तेऊ साबै निं इनै किअ, तेऊ लाई आपणैं गाधै दी ज़ीन काठी संघा डेऊअ आपणीं नगरी लै बापस फिरी। संघा ज़ेही-ज़ेही गल्‍ला तेऊ आपणैं टांडै-टबरा का खोज़णीं ती, तिंयां डाही तेऊ खोज़ी अर आप्पू दैनी तेऊ फांसी संघा मूंअ! सह डाहअ तिन्‍नैं तिधी दाबी ज़िधी तेऊए दाद-बाब तै दाबै दै।<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />दाबेद त गअ द माहानीम नगरी पुजी अर अबशलोम अर तेऊ संघै इज़राईली बी आऐ जरदण नदी पार टपी दाबेदा पिछ़ू। <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />अबशलोमै बणाअं जोआबे ज़ैगा अमासा सैनापति। अमासो बाब च़ितरु त इशमाईली अर ईज ती राज़ै नहाशे शोहरी अबीगेल ज़ुंण जोआबे ईज सरूयाहे दाई थिई।<verse eid="2SA 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 17:26" />अबशलोम अर तेऊए इज़राईली सैना पाऐ गलाद पुजी डेरै। <verse eid="2SA 17:26" /><verse number="27" style="v" sid="2SA 17:27" />दाबेद पुजअ माहानीम नगरी, तिधी आऐ दाबेदा सेटा लै नहाशो शोहरू शोभी अमोन मुल्खे रबाह नगरी का, लोदबेर नगरी का अमीएलो शोहरू माकीर, रोगल़ीमा का आअ गलादो बर्ज़िलै। <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />तिन्‍नैं आणी मांदरी, डबरै, माट्टे भांडै, ज़ौ, कणक, मैदअ, भरठे मोल़ी, मसर, भुझ़ै दै छ़ोल्‍लै, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />मखीर, काच़अ घिऊ, भेडा-बाकरीए हेल़्ह अर गाऊईए दुधे दैंहीं अर पनीर। तिन्‍नां का थिअ थोघ कि दाबेद अर तेऊ संघै सोभ आदमी हणैं रेगीस्तानै भुखै-नचिशै अर थकै दै।<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s">अबशलोमे हार अर मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />राज़ै दाबेदै गणै आप्पू संघे सोभ आदमी, तेखअ बांडै तिंयां शौ अर हज़ारे छ़ुंढा दी संघा डाहै तिन्‍नां प्रैंदै दलपति अर प्रधान। <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />तेखअ छ़ाडै दाबेदै तिंयां चिई दला दी, एक दल सरूयाहे शोहरू जोआब अर दुजअ तेऊए भाई अबीशै संघै, चिऊथअ दल गात नगरीए ईताई संघै। तेखअ बोलअ राज़ै आपणैं आदमी लै, “हुंह हणअ आप्पू बी जुधा लै तम्हां संघै।”<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />दाबेदे सैना बोलअ इहअ, “तूह निं हाम्हां संघै जुधा लै एछी! हाम्हैं च़ाऐ सोभ ठुर्हे, च़ाऐ तिंयां हाम्हां मांझ़ै आधै मारी पाए, तेता करै निं दुशमणा फरक पल़दअ! पर तूह आसा हाम्हां ज़िहै दस हज़ारा बराबर एक्‍कै। तैही आसा म्हारअ मतलब कि तूह रहै नगरी दी संघा करै हाम्हां लै ज़ेही हाम्हां लोल़ी तेऊ साबै मज़त दैई।”<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />तेखअ बोलअ राज़ै दाबेदै, “ज़िहअ तम्हां का राम्बल़अ ज़ाण्हिंआं, हुंह करूं तिहअ ई।” संघा खल़्हुअ दाबेद नगरीए प्रऊल़ीए काछ़ा अर तेऊए मुंहां आजू बाती डेऊऐ शौ-शौ अर हज़ार-हज़ार सपाहीओ दल जुधा लै। <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />राज़ै दाबेदै किअ जोआब, अबीशै अर ईताई लै ज़ोरै-ज़ोरै हाक पाई हुकम, “मेरै शोहरू अबशलोमा लै निं किछ़ै हान्‍नी करी, तेऊ लै करै मेरी तैणीं धख झींण।” दाबेदो अह हुकम शूणअ सोभी दलै।<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />तेखअ निखल़ै दाबेदे आदमी इज़राईली संघै मकाबलै करदै सऊंई ज़ैगा लै अर एप्रैम नाओंए बणैं लागअ घणअ जुध। <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />तिधी ज़ितै दाबेदे आदमी इज़राईली का, सह थिई इज़राईली लै डरैऊंणी हार अर तैहा धैल़ी पाऐ बिह हज़ार मणछ मारी। <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />सह जुध छिंघूअ तेथ सारै बणैं अर दाबेदे सैना ती ज़ितदी लागी दी, ज़ेतरी सैना जुधा दी तलबारा करै मारी तेता का खास्सै मूंऐं न्हैरै बणैं आप्पै।<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />नच़ानक शुझुऐ अबशलोमा का दाबेदे आदमी, सह थिअ आपणीं खच़रा प्रैंदै बेशी डेऊंदअ लागअ द, सह डेऊअ बडै महरूए घणीं शाहणी हेठी अर तेऊओ मूंड शाचअ तेऊ बूटे शाण्हीं दी, खच़र ठुर्ही हेठी बाती पोर्ही अर सह रहअ शाण्हीं दी च़ुंढुई। <verse eid="2SA 18:9" /><verse number="10" style="v" sid="2SA 18:10" />दाबेदे एकी आदमी हेरअ सह भाल़ी अर तेऊ खोज़अ सैनापति जोआबा का, “मंऐं भाल़अ अबशलोम महरूए शाण्हीं दी च़ुंढुअ द!”<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />जोआबै दैनअ ज़बाब, “ज़ै ताखा शुझुअ थिअ, तंऐं सह तिधी किल्है निं किअ मारी हक्‍क? ताल्है दैणैं तै मुंह च़ंदीए दस सिक्‍कै अर एक खास च़ाम्भल़े गाची नांम।”<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />पर तेऊ बोलअ जोआबा लै इहअ, “ज़ै तूह मुल्है च़ंदीए हज़ार सिक्‍कै बी दैए, तैबी निं हुंह राज़े शोहरू लै हाथ बी च़कदअ। हाम्हैं सोभी आसा शूणीं डाहअ द कि ताल्है, अबीशै अर ईताई लै राज़ै किज़ै हुकम आसा किअ द, ‘मेरै शोहरू अबशलोमा लै निं किछ़ै हान्‍नी करी, तेऊ लै करै मेरी तैणीं धख झींण।’ <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />पर ज़ै हुंह राज़ैओ हुकम नांईं मनी तेऊ मारी बी पांदअ अर एतो थोघ राज़ै का लागदअ, तेभै लाणअ त ताह बी मुल्है दोश कि एऊ किअ गलत!”<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />जोआबै बोलअ, “मंऐं निं लाअ इधी ताह संघा होर बगत ज़ांऐं करी!” जोआबै भाल़अ अबशलोम त शाण्हीं दी शाची तिहअ ई च़ुंढुअ द अर अज़ी त सह ज़िऊंदअ। तेऊ च़कै चअन तिछै काठ संघा खभेऊऐ अबशलोमे हिक्‍का। <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />तेखअ आऐ जोआबे दस अस्त्र-शस्त्र ढोणै आल़ै सपाही संघा खल़्हुऐ अबशलोमा फेर अर सह किअ तिन्‍नैं पठी मारी हक्‍क।<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />तेखअ बाज़अ जोआबै जुध खतम करना लै नर्शिंगअ अर संघा फिरै दाबेदै सोभै छ़ुंढ पिछ़ू ज़ुंण इज़राईली पिछ़ू दरल़ाऊंदै तै डेऊऐ दै। <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />तिन्‍नैं शोटी अबशलोमे ल्हास बणैं डुघी खाल़्ही दी अर पिछ़ू भरी टोल्हा संघा लाअ तेथ प्रैंदै पात्थरो बडअ रूल़। सोभ इज़राईली ठुर्है आपणैं-आपणैं डेरै लै।<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />आपणीं ज़िऊंदी ज़िता किअ अबशलोमै राज़े खागै आपणीं आदगारी लै पात्थरो एक बडअ थाम्ह खल़अ। सह बोला त इहअ, “मेरी निं आजू लुआद ई आथी हुई दी ज़ेता करै मेरअ नाअं रहणअ त।” तेऊ थाम्हा नाअं बी डाहअ तेऊ अबशलोमे आदगारी अर आझ़ तैणीं बी बोला तेता लै अबशलोमो थाम्ह।<verse eid="2SA 18:18" /></para>
  <para style="s">दाबेदा का लागअ थोघ कि अबशलोम मूंअ</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />तेखअ बोलअ सदोक प्रोहते शोहरू आहीमासै जोआबा लै, “हुंह डेऊं ठुर्हदा, संघा एछूं राज़ै का खोज़ी कि बिधाता किअ ताल्है नसाफ अर तूह हेरअ तेरै दुशमणा का बच़ाऊई।”<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />जोआबै बोलअ, “नां, आझ़ निं तूह किछ़ै खबर खोज़दअ डेऊई। तूह खोज़ै एता होरी धैल़ै पर आझ़ निं! किल्हैकि ज़ुंण मूंअ सह आसा राज़ैओ टिक्‍कअ।” <verse eid="2SA 18:20" /><verse number="21" style="v" sid="2SA 18:21" />तेखअ बोलअ जोआबै एकी कूश देशे गलाम मणछा लै, “ज़िहअ तंऐं भाल़अ, तूह एछ राज़ै का खोज़ी।” तेऊ गलाम मणछै टेक्‍कअ उटी बाखा माथअ संघा ठुर्हअ।<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />तेखअ बोलअ सदोके शोहरू आहीमासै जोआबा लै भिई, “च़ाऐ ज़िहअ बी होए, ज़ीबाण मुंह बी दै एऊ कूशी मणछा पिछ़ू खबर पजैल़ै डेऊणैं।”</para>
  <para style="p" vid="2SA 18:22">जोआबै बोलअ, “मेरै लान्हैंआ, तंऐं लाअ किल्है इहअ करी? एते निं ताह किछ़ै नांम च़ाल्‍ली भेटी।”<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />आहीमासै बोलअ भिई, “च़ाऐ ज़िहअ बी होए, हुंह च़ाल्‍लअ ठुर्ही।”</para>
  <para style="p" vid="2SA 18:23">जोआबै बोलअ, “ठुर्ही च़ाल्‍लअ तै ठुहर!” तेखअ ठुर्हअ आहीमास उंधै जरदण खागे बाता अर सह गअ तेतरी तेऊ कूशी गलाम मणछा का आजू निखल़ी।<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />राज़अ दाबेद त नगरीए गहल़ा दी भितरली अर बाघली प्रऊल़ी मांझ़ै ज़ैगा बेठअ द। ज़ुंण पहरी प्रऊल़ी प्रैंदै छ़ाप्परै थिअ खल़्हुअ द, तेऊ का शुझुअ कि उपरा उंधै आअ एक मणछ कल्ही ठुर्ही। <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />तेऊ पहरी खोज़अ उंधै राज़ै का हाक्‍का लाई अर राज़ै बोलअ, “ज़ै अह कल्ही आसा, तै आणी ज़रूर एऊ किज़ै खुशीए खबर।” सह मणछ आअ ठुहर्दी-ठुहर्दी नेल़।<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />तेखअ भाल़अ तेऊ पहरी पिछ़ू एक होर मणछ कल्ही ठुर्ही एछदअ अर तेऊ पहरी खोज़अ उझै का राज़ै लै हाक्‍का लाई प्रऊल़ीए पहरी का ज़ुंण तोल़ धरनीं थिअ, “लै उपर भाल़! एथ आअ पिछ़ू एक होर मणछ ठुर्ही!”</para>
  <para style="p" vid="2SA 18:26">तोल़ा का बोलअ राज़ै, “अह बी आअ हणअ खुशीए खबर पजैल़अ।”<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />तेखअ बोलअ उपरा का पहरी इहअ, “मुखा शुझिआ ज़ुंण मणछ आजू ठुर्ही आअ, सह ज़ाण्हिंआं सदोके शोहरू आहीमासा ज़िहअ।”</para>
  <para style="p" vid="2SA 18:27">राज़ै बोलअ, “अह आसा भलअ मणछ, एऊ आणनीं खुशीए ई खबर।”<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />आहीमासै बोलअ राज़ै लै ज़ोरै, “सोभै आसा राज्ज़ी-खुशी।” संघा टेक्‍कअ तेऊ राज़ै सेटा धरनीं उटअ पल़ी माथअ तेखअ बोलअ, “मेरै मालक! तेरै परमेशर बिधाता ज़ुंण तेरै द्रोही का ताल्है ज़ीत दैनी, तेऊए लोल़ी सदा ज़ै-ज़ैकार हुई।” <verse eid="2SA 18:28" /><verse number="29" style="v" sid="2SA 18:29" />राज़ै पुछ़अ, “सह ज़ुआन शोहरू अबशलोम बी आसा राज्ज़ी-राम्बल़अ?”</para>
  <para style="p" vid="2SA 18:29">आहीमासै दैनअ ज़बाब, “माहा राज़अ, ज़ेभै तेरै सैनापति जोआबै हुंह इधा लै छ़ाडअ, मंऐं भाल़ै तिधी तै खास्सै मणछो झाल़अ हुअ द, पर इहअ निं मुखा थोघै कि तिधी किज़ै हुअ!”<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />राज़ै बोलअ तेऊ लै, “इधी रह पोर्ही ज़िहअ खल़्हुई।” आहीमास रहअ तिधी पोर्ही ज़िहअ खल़्हुई।<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />तेतरी गअ पिछ़ू सह कूश देशो गलाम एछी संघा बोलअ राज़ै लै, “मेरै मालक, हुंह आअ ताह सेटा खुशीए समादा पजैल़अ! ज़ुंण तेरै द्रोही तै हुऐ दै, बिधाता हेरी ताल्है तिन्‍नां प्रैंदै ज़ीत दैई!”<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />राज़ै पुछ़अ तेऊ कूशी मणछा का, “सह ज़ुआन शोहरू अबशलोम बी आसा राज्ज़ी-राम्बल़अ?”</para>
  <para style="p" vid="2SA 18:32">तेऊ गलाम मणछै दैनअ ज़बाब, “मेरै मालक, हुंह बोला इहअ कि ताल्है द्रोह करनै आल़ै अर तेरै दुशमणे दशा लोल़ी ती तेही ई हुई ज़ेही बूरी दशा अबशलोमे हुई।”<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />तेखअ हुअ राज़अ दाबेद खास्सअ दुखी, संघा उखल़अ सह प्रऊल़ी प्रैंदै उझै कमरू लै लेरा लांदी-लांदी। सह थिअ लेरा लांदी इहअ बोल्दअ लागअ द, “हे मेरै बेटैआ! अबशलोम मेरै काल़ज़ैआ! तेरी ज़ैगा लोल़ी त हुंह मूंअ! आईओ, अबशलोम मेरै शोहरूआ, आझ़ केस्सी डेऊअ तूह!”<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s">जोआबै हैऊअ-बतैऊअ दाबेद</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />जोआबा का हेरअ कुंणी खोज़ी कि दाबेद राज़ै आसा शोग पल़अ द अर सह आसा अबशलोमा लै लेरा लांदअ लागअ द। <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />तैहा धैल़ी निं तेखअ राज़ै दाबेदे सोभ आदमी जुधा ज़ितणें खुशी बी मनाऊंईं सकै किल्हैकि तिन्‍नैं शूणअ कि दाबेद आसा आपणैं शोहरू मरनै पिछ़ू खास्सअ दुखी हुअ द। <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />तेखअ डेऊऐ तिंयां इहै च़ुप्प-च़ुप्पै नगरी लै बापस फिरी ज़िहै कुंण जुधा का ठुर्ही शर्मिंदै हई आपणअ मुंह च़ोरा। <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />राज़अ दाबेद रहअ आपणअ मुंह ढोपी ज़ोरै-ज़ोरै लेरा लांदअ लागी, “हे मेरै शोहरूआ! ओ अबशलोम मेरै काल़ज़ैआ! तूह केस्सी डेऊअ आझ़!”<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />जोआब डेऊअ राज़ै दाबेदे घअरै संघा लागअ तेऊ लै इहअ बोल्दअ, “तंऐं लाऐ आझ़ आपणैं शूरबीर शर्मिंदै करी! ज़ुंणीं आझ़ तूह, तेरै शोहरू-शोहरी अर तेरी लाल़ी अर तेरी सोभी डाही दी बेटल़ीए ज़ान बच़ाऊई! <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />आझ़ ज़ाण्हुंअ इहअ कि ज़ुंण ताल्है झ़ूरा, तिन्‍नां संघै डाहा तूह ज़ीद अर आप्पू झ़ूरा तूह तिन्‍नां लै ज़ुंण ताल्है नफरत करा! आझ़ रहैऊअ तंऐं इहअ कि तूह निं आपणैं कार-करिंदै अर आपणैं आदमीए परबाह करदअ। मुखा ज़ाण्हिंआं इहअ कि आझ़ ज़ै हाम्हैं सोभै मूंऐं हंदै अर तेरअ शोहरू अबशलोम एक्‍कै ज़िऊंदअ बच़दअ, तै हणअ त तूह खुश! <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />ऐबै उझ़ू संघा निखल़ बागै! आपणैं कार-करिंदै लै हैअ-विश्वास ता दै। हुंह काढा बिधाते सोह, ज़ै तूह बागै नांईं निखल़अ, ईंयां निं हेरे काल्‍ला दोत्ती पोर्ही ताह संघै एक बी च़ाल्‍लै रही। सह एछणी ताल्है एही खरी ज़ुंण तंऐं आपणीं सारी ज़िन्दगी निं भाल़ी।” <verse eid="2SA 19:7" /><verse number="8" style="v" sid="2SA 19:8" />तेखअ उझ़ुअ राज़अ दाबेद खल़अ, बागै निखल़ी बेठअ नगरीए प्रऊल़ी नेल़। तेऊए आदमी शूणअ कि सह आसा तिधी, तेखअ हुऐ तिंयां सोभ तिधी कठा।</para>
  <para style="s" vid="2SA 19:8">दाबेद फिरअ एरुशलेम नगरी लै बापस</para>
  <para style="p" vid="2SA 19:8">इज़राईली ज़ुंण अबशलोमा संघै आऐ तै, तिंयां ठुर्है सोभ आपणैं-आपणैं डेरै लै। <verse eid="2SA 19:8" /><verse number="9" style="v" sid="2SA 19:9" />इज़राईले सोभ गोत्रे लागै सारै देशै आप्पू मांझ़ै झ़घल़दै अर इहअ बोल्दै, “सह थिअ राज़अ दाबेद ई ज़ुंणीं हाम्हैं पलिश्ती अर म्हारै सोभी दुशमणा का बच़ाऊऐ। हाम्हैं रहै अबशलोमा आप्पू प्रैंदै राज़ै बणाणां लै अभिषेक करदै! दाबेदा पल़अ नगरी छ़ाडी बणैं-बूटै लुक्‍कणअ! <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />ऐबै अबशलोम ज़ुंण हाम्हैं अभिषेक राज़अ बणाअं, सह गअ जुधा दी मरी। ऐबै किल्है आसा तम्हैं सोभ नड़क्‍क हुऐ दै? तम्हां मांझ़ै कुंण राज़ै दाबेदा बापस आणने बारै किल्है निं गल्‍ला करदै?”<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />अह खबर गई राज़ै दाबेदा सेटा पुजी कि इज़राईली आसा इहअ-इहअ बोल्दै लागै दै। तेऊ छ़ाडै सदोक अर अबतार प्रोहत यहूदा लै इज़राईलीए सैणैं का इहअ पुछ़दै, “तम्हैं किल्है आसा राज़ै दाबेदा घअरा आणना लै सोभी का पिछ़ू रहै दै। होर इज़राईली आसा राज़ै घअरा लै आणने गल्‍ला करदै लागै दै। <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />तम्हैं ता मेरै आपणैं हाड-खिंबे आसा! तै तम्हैं किल्है आसा राज़ै बापस आणनैं का पिछ़ू हटै दै?” <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />दाबेदै डाहअ तिन्‍नां का खोज़ी कि अमासा का खोज़ै इहअ, “तम्हैं आसा मेरै आपणैं हाड-खिंबे। मंऐं लाअ तूह ऐबै जोआबे ज़ैगा सैनापति बणाईं। बिधाता लोल़ी मुल्है मौत दैनी ज़ै हुंह इहअ निं करे!” <verse eid="2SA 19:13" /><verse number="14" style="v" sid="2SA 19:14" />राज़ै दाबेदे इनै गल्‍लै ज़ितै यहूदा रहणैं आल़ै सोभिए दिल, तिन्‍नैं दैनअ तेऊ लै समाद, “तूह एछ आपणैं सोभी कार-करिंदै संघी बापस फिरी।”<verse eid="2SA 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 19:15" />तेखअ आअ राज़अ दाबेद जरदण नदी तैणीं बापस फिरी, यहूदी डेऊऐ गिलगाल मुल्खा तैणीं कि सह आणनअ जरदण नदी आर टपाऊई।<verse eid="2SA 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 19:16" />बहूरीम नगरी का बिन्यामीन गोत्रो गेरो शोहरू शिमी बी आअ छ़ेक्‍कै-छ़ेक्‍कै यहूदी संघै राज़ै दाबेदा सेटा मिलदअ। <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />तेऊ संघै तै बिन्यामीन गोत्रा का एक हज़ार मणछ बी। शाऊलो दास सिबू बी थिअ आपणैं सोभी टबर, आपणैं पंद्रा शोहरू अर बिह दासा संघी। तिंयां आऐ जरदण नदी पार पैदल राज़ै दाबेदा सेटा मिलदै। <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />तिन्‍नैं टपी जरदण नदी पारा बाखा लै कि तिंयां राज़े टबर आर टपाओए अर ज़िहअ राज़अ किज़ै होर काम खोज़े तेऊ करना लै। गेरो शोहरू शिमी पल़अ दाबेदे खूरा सेटा उटी बाखा, <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />संघा बोलअ राज़ै का इहअ, “मेरै मालक, ज़ीबाण, ज़धू तूह एरुशलेम नगरी छ़ाडी आअ त, तधू हुई मेरै भलै गलती, तेता लै छ़ाड ऐबै मुल्है माफी। तेता निं ऐबै आपणैं दिलै डाही। <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />माहा राज़अ, मेरै मालक, हुंह ज़ाणा कि मंऐं किअ पाप! भाल़, तैही आसा हुंह आझ़ उतरा बाखा बस्सै दै युसुफे<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="fq" closed="false">युसुफे </char><char style="ft" closed="false">सोभै इज़राईली</char></note> गोत्रा मांझ़ै पैहलअ मणछ ज़ुंण ताह सेटा मिलदअ आअ।”<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />सरूयाहे शोहरू अबीशै बोलअ, “शिमीए सज़ा आसा मौत किल्हैकि एऊ दैनअ तेऊ मणछा लै फिटक ज़ुंण बिधाता अभिषेक करी राज़अ आसा बणाअं द।”<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />पर दाबेदै बोलअ सरूयाहे शोहरू अबीशै अर तेऊए भाई जोआबा लै, “तम्हां का कुंणी मांगी सलाह? तम्हैं कै मुल्है आफ़त लाई पाई? आझ़ आसा इज़राईलीओ राज़अ हुंह, आझ़ निं कोही लै मौते सज़ा भेटणीं।” <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />तेखअ बोलअ राज़ै दाबेदै शिमी लै, “मेरी रही ताल्है ज़बान, ताल्है निं मौते सज़ा हणीं।”<verse eid="2SA 19:23" /></para>
  <para style="s">मोपीबशेता लै दाबेदे झींण</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />शाऊलो पोचअ मोपीबशेत बी आअ राज़ै दाबेदा सेटा मिलदअ। ज़धकअ राज़अ दाबेद एरुशलेम छ़ाडी डेऊअ, तधा ओर्ही राज़ै दाबेदे ज़िती करै राज्ज़ी-राम्बल़अ फिरी एछणैं तैणीं निं तेऊ नां आपणैं खूर धोऐ, नां न्हश काटै नां दाल़्ही छाम्बी नां तेऊ आपणैं झिकल़ै धोऐ तै! <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />ज़ांऊं मोपीबशेत एरुशलेम नगरी का दाबेदा मिलदअ आअ, राज़ै बोलअ, “मोपीबशेत, तूह निं मुंह संघै आअ आथी त! किल्है?”<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />तेऊ दैनअ ज़बाब, “मेरै मालक, ताखा आसा थोघ भाल़, हुंह आसा दुही ज़ांघो लाट्टअ। मंऐं बोलअ त आपणैं दास सिबू लै, ‘मेरै गाधै दी ज़ीन काठी लाई दैआ मुंह बशैल़ी, तै डेऊणअ मुंह बी राज़ै संघै!’ पर तेऊ दैनअ मुल्है धोखअ। <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />माहा राज़अ, मेरै मालक, ज़ुंण तेऊ मेरै बारै ताखा गल्‍ला खोज़ी, तिंयां आसा झ़ुठी। पर तूह आसा परमेशरे स्वर्ग दूता ज़िहअ, ऐबै ज़िहअ तेरअ दिल बोला, तूह कर मुल्है तिहअ। <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />मेरै बाबो त सारअ खिंब मौते सज़ा जोगी, तूह माहा राज़अ आसा मेरअ मालक अर तंऐं आसा मुल्है आपणैं पलगा प्रैंदै आप्पू संघै रोटी खाणेंओ हक दैनअ द। मुंह निं ताखा आपणीं ज़िन्दगी दान मांगणेओ हक बी आथी?”<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />राज़ै दाबेदै दैनअ तेऊ लै ज़बाब, “हुअ तंऐं बोलअ बतेर्हअ, मंऐं आसा हेरअ द सोठी कि शाऊले ज़ैदात दैणीं मुंह ताह अर सिबू दुही लै बांडी।”<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />मोपीबशेतै बोलअ राज़ै लै, “मुल्है आसा अह ई बतेर्हअ कि मेरअ मालक आअ राज्ज़ी-राम्बल़अ घअरा लै फिरी। ज़ैदात दै तूह पठी सिबू लै तेते निं मुंह शाची।”<verse eid="2SA 19:30" /></para>
  <para style="s">दाबेदै किई बर्ज़िलै लै झींण</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />गलाद मुल्खो बर्ज़िलै बी आअ रोगल़ीम नगरी का उंधै दाबेद राज़ै जरदण नदी पार टपाऊंदअ।<note caller="-" style="x"><char style="xo" closed="false">19:31 </char><char style="xt" closed="false"><ref loc="2SA 17:27-29">2 शमू. 17:27-29</ref></char></note> <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />बर्ज़िलै त खास्सअ प्रोढअ गअ द हई। तेऊए अमर ती अश्शी साले गई दी हई, सह थिअ सेठ मणछ अर ज़धू राज़अ माहानीम नगरी थिअ, सह रहअ त राज़ै लै खाण-पींण दैंदअ लागी। <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />राज़ै बोलअ बर्ज़िलै लै, “तूह च़ाल्‍ल मुंह संघै एरुशलेम नगरी लै, तेरी हेर-सभाल़ करूं हुंह आप्पै।”<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />पर बर्ज़िलै बोलअ इहअ, “मेरी निं ऐबै खास्सी अमर रही, माहा राज़अ, मंऐं किज़ै लाअ ताह संघै एरुशलेम डेऊई करी? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />मेरी अमर गई अश्शी साले हई, खाखा निं मेरै सुआद रहअ, नां कानै गिहा शुण्हदी अर नां मुंह खाणें पिणें शौक रही! मेरअ राज़अ, मेरै मालक, हुंह हणअ ताल्है थोघै बाझ़ी बोझ़। <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />एतरै बडै नांमो हकदार निं हुंह आथी। मुंह टपणअ ताह संघै जरदण नदी पार संघा दैणअ मुंह तूह धख आजू तैणीं संघी। <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />तेखअ दैऐ तूह मुंह आपणैं घअरा लै बापस फिरी डेऊणैं ताकि हुंह आपणीं नगरी तैहा ज़ैगा नेल़ मरूं ज़िधी मेरै दाद-बाब आसा दाबी डाहै दै। इधी आसा मेरअ शोहरू किमहाम, अह सका तेरी च़ाकरी करी, मेरै मालक! एऊ निंऊं तूह आप्पू संघै अर ज़िहअ ताह ठीक लागे, तूह करै एऊ लै तिहअ।”<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />राज़ै दैनअ ज़बाब, “हुंह निंऊं किमहामा आप्पू संघै अर एऊ लै करनअ मुंह तिहअ ज़िहअ तूह च़ाहा। मुंह करनअ तिहअ ज़िहअ तूह बोले।” <verse eid="2SA 19:38" /><verse number="39" style="v" sid="2SA 19:39" />तेखअ टपै राज़अ दाबेद अर तेऊ संघै सोभ आदमी जरदण नदी पार। दाबेदै दैनी बर्ज़िलै लै मल़्हैची अर च़ुंज़ी-माख्खी अर बर्गत संघा लागअ बर्ज़िलै आपणैं घअरा लै हांढदअ।<verse eid="2SA 19:39" /></para>
  <para style="s">राज़ै पिछ़ू झ़घल़ुऐ यहूदा अर इज़राईले लोग</para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />ज़ांऊं राज़अ जरदण नदी पार टपी गिलगाल मुल्खा बाखा लै डेऊअ, यहूदा का सोभै अर इज़राईला का आधै लोग तै तिधी दाबेदा जरदण नदी पार टपाऊंदै आऐ दै। किमहाम डेऊअ दाबेदा संघै। <verse eid="2SA 19:40" /><verse number="41" style="v" sid="2SA 19:41" />तेखअ आऐ सोभ इज़राईली दाबेद राज़ै सेटा लै संघा लागै इहअ बोल्दै, “माहा राज़अ, एथ कै राज़ आसा कि म्हारै यहूदी भाई-बंध डेऊऐ च़ोरी करै जरदण नदी पारा का ताह, तेरै राज़ टबर अर ताह संघै सोभी आदमी आणदै अर हाम्हां का निं खोज़अ बी आथी?”<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />यहूदी मांझ़ै बोलअ इज़राईली लै, “इहअ किअ हाम्हैं तै कि राज़अ आसा म्हारै गोत्रा का, तम्हैं किज़ू रुश्शै ऐहा गल्‍ला का? हाम्हैं निं राज़ै का किछ़ै खाअ अर नां राज़ै हाम्हां लै एते बदल़ै किज़ै दैनअ।”<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />इज़राईली दैनअ ज़बाब, “इज़राईला दी आसा दस गोत्र होर बी, ज़ेतरअ दाबेदा दी थारअ हक आसा, तेता का दस गुणा खास्सअ हक आसा म्हारअ! तम्हैं समझ़ै हाम्हैं बृथा! राज़ै घअरा लै आणने बारै गल्‍ला बी किई ती पैहलै हाम्हैं ई!”</para>
  <para style="p" vid="2SA 19:43">पर यहूदी मणछै दैनअ राज़ै दी आपणअ बडअ हक डाहणां लै होर बी ज़ोर दैई ज़बाब कि इज़राईलीए निस्सी तिन्‍नां संघै पांच़ी लै पुघुई।<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s">शेबा हुअ दाबेदे खलाफ खल़अ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:1 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 12:16">1 राज़. 12:16</ref>; <ref loc="2CH 10:16">2 इति. 10:16</ref></char>
    </note>तिधी त गिलगाल मुल्खा का एक शेबा नाओं मणछ आअ द। सह थिअ बिन्यामीन गोत्रा का बिकरी नाओंए मणछो शोहरू। सह थिअ बेघै निक्‍कअ उपद्रभी मणछ। तेऊ बाज़अ तिधी नर्शिंगअ संघा बोलअ ज़ोरै-ज़ोरै इहअ, “एऊ ईशैईए शोहरू दाबेदे राज़ा दी निं म्हारअ किछ़ आथी! अह निं म्हारअ राज़अ आथी! इज़राईलीओ, एछा, आपणैं-आपणैं घअरा लै लागा हांढदै!” <verse eid="2SA 20:1" /><verse number="2" style="v" sid="2SA 20:2" />इज़राईली डेऊऐ दाबेदा छ़ाडी बिकरीए शोहरू शेबा पिछ़ू! पर यहूदे लोग रहै दाबेदा संघै पाक्‍कै अर तिंयां आऐ जरदण नदी ओर्ही एरुशलेम तैणीं राज़ै संघा।<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />राज़अ दाबेद पुजअ एरुशलेम आपणैं मैहलै, ज़ुंण तेऊ तिंयां आपणीं दस डाही दी बेटल़ी पिछ़ू मैहलै फाज़त लै ती डाही दी, तेऊ डाही तिंयां एकी ज़ुदै घअरै पहरै दी। सह रहअ तिन्‍नें हर ज़रुरती पूरी करदअ लागी पर तेखअ निं सह तिन्‍नां कोही संघै भिई सुत्तअ-बेठअ आथी। तिन्‍नें ज़िन्दगी निभी तधा बाद बिधबा बेटल़ी ज़ेही।<note caller="-" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2 शमू. 16:22</ref></char></note><verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />राज़ै बोलअ अमासा लै इहअ, “यहूदे सोभी लोगा झाल़ पर्शी तैणीं इधी मुंह सेटा अर तूह आप्पू बी लोल़ी बगती पुजअ।” <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />अमासा डेऊअ यहूदी शधाणूं, पर तेऊ लागअ तेता का खास्सअ बगत ज़ुंण राज़ै तेऊ लै दैनअ त। <verse eid="2SA 20:5" /><verse number="6" style="v" sid="2SA 20:6" />तेखअ बोलअ दाबेद राज़ै अबीशै लै, “बिकरीए शोहरू शेबा पाणीं हाम्हां लै अबशलोमा का बी खास्सी आफ़त। तूह निंऊं मेरै आदमी संघा कर तेऊओ पिछ़अ, इहअ निं हआ कि सह म्हारी गहल़ा आल़ी नगरी दी कबज़अ करे अर म्हारै हाथा का छ़ुटे।” <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />तेखअ डेऊऐ जोआब आदमी अर राज़ै दाबेदे खास-खास आदमी अर एरुशलेम नगरी का सैनो खास दल अबीशै संघै बिकरीए शोहरू शेबा लोल़ै पिछ़ू। <verse eid="2SA 20:7" /><verse number="8" style="v" sid="2SA 20:8" />ज़ांऊं तिंयां गबोन बडी टोल्हा सेटा पुजै, तिधी गअ तिन्‍नां सेटा अमासा पुजी। जोआब त कुछी च़ाम्भल़े गाची अर तेथ तलबार बान्हीं जुधा लै तैर्हुअ द, ज़ांऊं सह आजू हांढदअ लागअ, तेऊए तलबार पल़ी धरनीं। <verse eid="2SA 20:8" /><verse number="9" style="v" sid="2SA 20:9" />जोआबै बोलअ अमासा लै, “लै साथी राज्ज़ी-राम्बल़अ आसा तूह?” तेखअ लाअ जोआबै तेऊए दाल़्ही दी च़ुंज़ी माख्खू दैणा लै दैहणअ हाथ। <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />अमासा निं जोआबे दुजै हाथै कटारो धैन किअ! जोआबै बाही कटारा करै अमासे पेटै कि तेऊए काढै बागै अर सह हुअ तिधी मरी खतम अर दुजी बाहणें निं जोआबा ज़रुरत ई पल़ी। तेखअ डेऊऐ जोआब अर तेऊओ भाई अबीशै बिकरीए शोहरू शेबे पिछ़ै करदै। <verse eid="2SA 20:10" /><verse number="11" style="v" sid="2SA 20:11" />जोआबो एक आदमी खल़्हुअ अमासे ल्हासा सेटा संघा बोलअ ज़ोरै इहअ, “ज़ुंण बी जोआब अर दाबेदा बाखा आसा, सह एछै जोआबा पिछ़ू!”<verse eid="2SA 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 20:12" />अमासे ल्हास ती लोधल़ै करै लत्त-पथ हुई दी अर मांझ़ बाता पल़ी दी। जोआबे आदमी भाल़अ कि सोभ लोग लागै तैहा ल्हासा सेटा खल़ै हंदै, तेऊ निंईं सह ल्हास घिशी करै संघा डाही सरलै खेचै शोटी अर तेऊ प्रैंदै डाहअ एक झिकल़अ पाई। <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />ज़ांऊं ल्हास मांझ़ बाता का पोर्ही काढी हेरी, तेखअ लागै सोभ जोआबा पिछ़ू बिकरीए शोहरू शेबा लोल़ै हांढदै।<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />शेबा दैनी इज़राईल मुल्खे सोभी गोत्रा बाती हांढ अर खिरी पुजअ सह बेरीए देशै अबेल-बेथ-माकाहा नगरी अर बिकरीए टोलीए सोभ लोग हुऐ तिधी कठा संघा डेऊऐ शेबा पिछ़ू। <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />एसी गअ जोआबे आदमी का थोघ लागी कि शेबा आसा तिधी। तिन्‍नैं गोटी पिछ़ू का अबेल-बेथ-माकाहा नगरी, तेखअ बणाअं तिन्‍नैं नगरीए गहल़े नील़ै पात्थर अर माट्टैओ चेच लाई एक टाप्पअ अर गहल़े आथरी बी लाई तिन्‍नें हेठै खार ताकि तेते भीत धाक्‍कअ दैई ढुल़े। <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />तैहा नगरी ती एक बेटल़ी बडी अक्ली आल़ी, तैहा लाई नगरीए गहल़ा पिछ़ू का हाक्‍का, “शूणां! मेरी गल्‍ल शूणां! जोआबा लै बोला ओर्ही एछ, मुंह करनीं तेऊ संघै किज़ै गल्‍ला।” <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />जोआब डेऊअ तैहा नेल़ ज़िहअ अर तैहा पुछ़अ, “तूह आसा जोआब?”</para>
  <para style="p" vid="2SA 20:17">तेऊ बोलअ, “हाँ, हुंह ई आसा।”</para>
  <para style="p" vid="2SA 20:17">तैहा बोलअ, “मालक, मेरी गल्‍ला शुण।”</para>
  <para style="p" vid="2SA 20:17">जोआबै बोलअ, “बोल तूह, हुंह आ शूणअ लागअ द।”<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />सह लागी इहअ बोल्दी, “सैणैं प्रोढै बोला तै म्हारै इहअ, ‘अबेल नगरी का लआ सलाह,’ ज़ुंण सलाह अबेल नगरी का तिन्‍नां भेटा ती, तेता करै हआ तै तिन्‍नें झ़गल़ै खतम। <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />अह नगरी आसा सारै इज़राईला लै ईजा ज़ेही, अह आसा इज़राईला मांझ़ै शुची-पाक्‍की अर मेल़-ज़ोल़ च़ाहणैं आल़ी नगरी। तंऐं किल्है लाई अह खोई? ज़ुंण बिधातो आसा, तेता बरैबाद करदअ किल्है आसा तूह लागअ द?”<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />जोआबै दैनअ ज़बाब, “इहअ निं कधि लोल़ी हुअ! हुंह निं थारी नगरी खोंदअ अर बरैबाद करदअ आथी आअ द! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />म्हारै दिलै निं एही गल्‍ल आथी। एप्रैम देशा का आसा एथ बिकरीओ शोहरू शेबा नाओं मणछ आअ द, सह आसा दाबेद राज़ैओ द्रोही हुअ द। तम्हैं दैआ तेऊ हाम्हां का सभाल़ी अर तेखअ लागणअ हाम्हां ऐहा नगरी का हांढदै।”</para>
  <para style="p" vid="2SA 20:21">तैहा बोलअ जोआबा लै, “तेऊओ मूंड दैणअ हाम्हां गहल़ा प्रैंदी बाती ताह सेटा लै उंधै शोटी।” <verse eid="2SA 20:21" /><verse number="22" style="v" sid="2SA 20:22" />तेखअ डेऊई सह आपणीं नगरीए सैणैं सेटा अक्ल सोठी, तिन्‍नैं मनी तेसे गल्‍ला अर तिन्‍नैं पाअ बिकरीओ शोहरू शेबा काटी अर तेऊओ मूंड शोटअ नगरीए प्रैंदी बाती बागै जोआबा सेटा। तेखअ किअ जोआबै आपणैं लोगा लै नर्शिंगै बाज़ी शारअ कि नगरी छ़ाडा। तिंयां डेऊऐ आपणैं-आपणैं डेरै लै अर खिरी पुजअ जोआब एरुशलेम दाबेद राज़ै सेटा बापस।<verse eid="2SA 20:22" /></para>
  <para style="s">दाबेदे कार-करिंदै</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />जोआब त इज़राईली सारी सैनो सैनापति, जहोयादे शोहरू बेनियाह त दाबेदे फाज़त करनै आल़ै सपाहीओ प्रधान, <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />अदोराम त सैना लै मज़दूर मणछो प्रधान। आहीलूदो शोहरू जहोशापात त सारी हुई-बिति दी गल्‍ला लिखणैं आल़अ, <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />शबा त काईथ, सदोक अर अबतार तै प्रोहत, <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />याईर नगरीओ ईरा बी थिअ दाबेदो निज़ी प्रोहत।<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s">शाऊले लुआद पाई मारी</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />दाबेद त राज़अ अर तिन्‍नां धैल़ै पल़अ चिई साला तैणीं सारै इज़राईल देशै घोर नकाल़ अर नाज़-पाणीं निं किछ़ै रहअ। दाबेद डेऊअ एते बारै बिधाता पुछ़दअ, बिधाता बोलअ तेऊ लै इहअ, “शाऊल अर तेऊए खिंबा लै आसा हत्या करनैओ दोश लागअ द, किल्हैकि तेऊ बझ़ैल़ै तै गबोन नगरीए लोग मारनै।” <verse eid="2SA 21:1" /><verse number="2" style="v" sid="2SA 21:2" />गबोनी लोग निं इज़राईली आथी तै, तिंयां थिऐ अमोरी लोगा मांझ़ै एक छ़ुंढ, इज़राईली त तिन्‍नां लै बच़न दैनअ द कि तिन्‍नां निं तिंयां किछ़ दैंदै हणैं। पर राज़अ शाऊल उझ़ुअ त तिन्‍नां खतम करदअ किल्हैकि सह च़ाहा त इज़राईली अर यहूदा सोभी ज़ैगा काबू करनअ।<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="JOS 9:3-15">ज़ैह. 9:3-15</ref></char></note> <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />दाबेदै शादै गबोनी लोग संघा पुछ़अ तिन्‍नां का, “तम्हैं बोला हुंह तम्हां लै किज़ै करूं? ज़ुंण गलती शाऊलै किई, तेतो किज़ै प्राश्त आसा ताकि तम्हैं बिधाते परज़ा लै भिई बर्गत दैए?”<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />गबोनी लोगै दैनअ दाबेदा लै ज़बाब, “शाऊला संघै म्हारै झ़गल़ैओ फैंसलअ निं सुन्‍नैं-च़ंदी दैई मुक्‍कदअ अर नां हाम्हैं कहा इज़राईली मारनअ च़ाहंदै।”</para>
  <para style="p" vid="2SA 21:4">राज़ै बोलअ, “तै खोज़ा ओर्ही, ज़िहअ तम्हैं बोले मुंह करनअ तिहअ ई।”<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />तिन्‍नैं बोलअ राज़ै लै, “शाऊल च़ाहा त हाम्हां पठी खतम करनअ कि इज़राईला मांझ़ै निं लोल़ी त म्हारअ एक मणछ बी ज़िऊंदअ रहअ। <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />तूह दै आजू तेऊए लुआदा मांझ़ै सात ज़ण्हैं हाम्हां का सभाल़ी। तिंयां निंणै हाम्हां बिधाता छ़ांटै दै राज़ै शाऊले नगरी गिबा धारा लै। तिधी दैणीं हाम्हां तिन्‍नां लै बिधाता सम्हनै फांसी।”</para>
  <para style="p" vid="2SA 21:6">राज़ै बोलअ, “हुंह दैंऊं तिन्‍नां तम्हां का।”<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />पर राज़ै दाबेदै डाहअ शाऊलो पोचअ मोपीबशेत बच़ाऊई किल्हैकि दाबेदै ती जोनाताना लै बिधाते सोह खाई ज़बान दैनी दी।<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1 शमू. 20:15-17</ref>; <ref loc="2SA 9:1-7">2 शमू. 9:1-7</ref></char></note> <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" /><note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="1SA 18:19">1 शमू. 18:19</ref></char></note>राज़ै शाऊले ती एक डाही दी बेटल़ी अईयाहे शोहरी रिज़पा, तेसे तै दूई शोहरू हुऐ दै, एकी नाअं त अर्मोनी अर तेसे दुजै शोहरू नाअं बी थिअ मोपीबशेत, शाऊले ज़ेठी शोहरी मिराब ती मेहोलाह नगरीए बर्ज़िले शोहरू आद्रीएला संघै बैही दी, तेसे तै पांज़ शोहरू। दाबेदै बझ़ैल़ै ईंयां सात ज़ण्हैं ढाकणैं <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />संघा दैनै तिंयां गबोनी लोगा का सभाल़ी। गबोनी दैनी तिन्‍नां लै धारा प्रैंदै बिधाता सम्हनै फांसी अर तिंयां सात ज़ण्हैं मूंऐं एकी बारी। ईंयां गल्‍ला हुई पैहलै ज़ेठै ज़ेभै ज़ौआ लऊंदै जाआ लागी।<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />शाऊले डाही दी बेटल़ी अईयाहे शोहरी रिज़पा बणाईं तिधी नेल़ टोल्हा प्रैंदै खिंथा करै आप्पू लै छ़ान संघा रही तिधी ज़ेठा पोर्ही शाऊंणै खास्सअ भराल़ लागणै तैणीं पहरी बेशी। तैहा निं धैल़ी तिन्‍नां आपणैं शोहरूए ल्हासा प्रैंदै कहा च़ेल्‍लू-पखीरू बेशणै दैनअ अर नां राची कहा बणें ज़ीबा दैनअ खाणैं।<verse eid="2SA 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 21:11" />ज़ांऊं राज़ै दाबेदा का कुंणी खोज़अ कि अईयाहे शोहरी रिज़पा ज़ुंण शाऊले डाही दी बेटल़ी आसा, तैहा किअ इहअ-इहअ, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />दाबेद डेऊअ गलाद जबेश नगरीए लोगा सेटा संघा आणै शाऊल अर तेऊए शोहरू जोनाताने हस्तू मांगी। तिन्‍नैं तै तिंयां बेथ-शान तेऊ च़फै का च़ोरी आणै दै ज़िधी तिंयां पलिश्ती तैहा धैल़ी च़ुंढदै डाहै तै लाई ज़हा धैल़ी तिंयां गिलबा धारा जुधा दी मारै तै।<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="1SA 31:8-13">1 शमू. 31:8-13</ref></char></note> <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />राज़ै दाबेदै झाल़ै शाऊल अर जोनाताने हस्तू संघै तिन्‍नां साता ज़ण्हैं हस्तू बी ज़ुंण ज़हा लै तिधी फांसी दैनी ती। <verse eid="2SA 21:13" /><verse number="14" style="v" sid="2SA 21:14" />तेखअ डाहै तिन्‍नैं शाऊल अर तेऊए शोहरू जोनाताने हस्तू बिन्यामीन मुल्खै जेला नाओंए ज़ैगा दाबी ज़िधी शाऊलो बाब कीश त दाबअ द। ज़िहअ दाबेद राज़ै हुकम त किअ द, सोभ काम हुअ तिहअ ई। तेखअ शूणीं खिरी बिधाता देशा लै तिन्‍नें अरज़।<verse eid="2SA 21:14" /></para>
  <para style="s">पलिश्ती जोधै संघै मकाबलअ</para>
  <para style="r">(<ref loc="1CH 20:4-8">1 इतिहास 20:4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />पलिश्ती हेरअ भिई इज़राईली संघै जुध छ़ेल़ी अर दाबेद अर तेऊए सैना डेऊऐ तिन्‍नां संघै मकाबलै लै। दाबेद गअ छ़ेक्‍कै थकी। <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />पलिश्ती मांझ़ै रपाईए खिंबो एक जोधअ इशबनोब, तेऊए हाथै त कांस्सैओ एक बडअ बर्छ़अ कोई साढै चिई किलूओ अर कुछी ती तिछी तलबार अर सह आअ राज़ै दाबेदा मारदअ। <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />सरूयाहे शोहरू अबीशै गअ तेतरी दाबेदे मज़त करदअ एछी, तेऊ बाही तेऊ पलिश्ती लै एही कि सह मूंअ तिधी। तेखअ बोलअ दाबेदे आदमी सोह खाई दाबेदा लै इहअ, “तूह निं हाम्हां आझ़ा पोर्ही जुधा लै आणनअ, इज़राईलीए आशा आसा तूह ई, हाम्हैं निं ताह बाझ़ी हणअ च़ाहंदै!”<note caller="-" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 राज़. 11:36</ref>; <ref loc="PSA 132:17">भज. 132:17</ref></char></note><verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />एता बाद हुअ पलिश्ती संघै गोब ज़ैगा भिई जुध, तेऊ जुधा लै पाअ हुशाई नगरीए सिबकै रपाईए खिंबो सप नाओं जोधअ मारी।<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />ज़ांऊं गोब भिई पलिश्ती संघै जुध हुअ, तेऊ जुधा दी पाअ बेतलेम नगरीए याईरे शोहरू एलहानै गात नगरीए गोलियाथो भाई लेहमी जोधअ मारी ज़सरी बर्छ़े डैंढी राछ़े लाठै ज़ेही मोट्टी थिई।<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />तेखअ हुअ पलिश्ती संघै गात नगरी एक होर जुध, तेथ त रपाईओ एक दैंत्तर जोधअ, तेऊए ती हाथै-खूरै छ़ह-छ़ह गुंठी पठी गणी करै च़ौबी। <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />तेऊ पाई इज़राईली संघै मकाबलै लै हाक, अर सह पाअ दाबेदे भाई शिमेहे शोहरू जोनातानै मारी। <verse eid="2SA 21:21" /><verse number="22" style="v" sid="2SA 21:22" />ईंयां च़ार पलिश्ती ज़ुंण दाबेद अर तेऊए आदमी मारै, ईंयां तै गात नगरी रपाईए आद-लुआद।<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s">राज़ै दाबेदै गांठी बिधाता लै गिह</para>
  <para style="r">(<ref loc="PSA 18">भज़न 18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />ज़ांऊं दाबेद बिधाता तेऊए दुशमण अर राज़ै शाऊला का बच़ाऊअ, दाबेदै गांठी बिधाता लै एही गिह:<verse eid="2SA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="2SA 22:2" />मुंह बच़ाऊंणै आल़अ आसा बिधाता,</para>
  <para style="q" vid="2SA 22:2">सह आसा मुल्है उछ़टै गहल़ा ज़िहअ।<verse eid="2SA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="2SA 22:3" />मेरअ परमेशर आसा मुल्है बडी टोल्हा ज़िहअ</para>
  <para style="q" vid="2SA 22:3">ज़ेथ पिछ़ू हुंह शरण लआ।</para>
  <para style="q" vid="2SA 22:3">सह बच़ाऊआ मुंह ढाल़ा ज़िहअ</para>
  <para style="q" vid="2SA 22:3">सह करा मुंह संघै रही मेरी फाज़त।</para>
  <para style="q" vid="2SA 22:3">सह करा मेरअ उद्धार,</para>
  <para style="q" vid="2SA 22:3">सह डाहा मुंह उपद्रभा का राज्ज़ी-राम्बल़ै बच़ाऊई।<verse eid="2SA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="2SA 22:4" />मुंह करनी बिधाता सेटा अरज़,</para>
  <para style="q" vid="2SA 22:4">तेऊ बच़ाऊअ हुंह मेरै दुशमणा का,</para>
  <para style="q" vid="2SA 22:4">हे बिधाता, तेरी लोल़ी सदा ज़ै-ज़ैकार हुई।<verse eid="2SA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="2SA 22:5" />हुंह त मौतै दरैऊए छ़ाल्‍ली ज़िहअ गोटअ द,</para>
  <para style="q" vid="2SA 22:5">बनाश करनै आल़ी गाडे हर्हला जैंदरी च़ाल्‍लअ त हुंह डुबी।<verse eid="2SA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="2SA 22:6" />मेरै मुंडा प्रैंदै थिई मौत रिंगदी लागी दी,</para>
  <para style="q" vid="2SA 22:6">अर मौतै थिई मुल्है बाता गंईं-गंईं दी फाही डाही दी ढोही!<verse eid="2SA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="2SA 22:7" />हुंह त आफ़ता दी पल़अ द,</para>
  <para style="q" vid="2SA 22:7">मंऐं मांगी बिधाता सेटा पकार पाई मज़त।</para>
  <para style="q" vid="2SA 22:7">तेऊ शूणीं आपणैं भबनै मेरी गल्‍ला</para>
  <para style="q" vid="2SA 22:7">तेऊ शूणीं मेरी पकार कि हुंह आसा मज़त मांगदअ लागअ द।<verse eid="2SA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="2SA 22:8" />सारी धरती बी लागी डरै काम्मणीं,</para>
  <para style="q" vid="2SA 22:8">भ्रमंडे आथरी बी हुई ज़ाज़री संघा सिक्‍की आजू-पिछ़ू!</para>
  <para style="q" vid="2SA 22:8">किल्हैकि बिधाता आई एही खास्सी रोश्शै कि<verse eid="2SA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="2SA 22:9" />तेऊए नाके ढुंण्हीं का लागअ धूँ निखल़दअ</para>
  <para style="q" vid="2SA 22:9">अर खाखा का आगीए लुपल़ै संघै ज़ल़दै-ज़ल़दै कोयलै निखल़दै।<verse eid="2SA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="2SA 22:10" />तेऊ खोल्हअ स्वर्ग धुंघरा ज़िहअ संघा होथअ उंधै,</para>
  <para style="q" vid="2SA 22:10">तेऊए खूरा हेठै तै घणैं काल़ै बादल़।<verse eid="2SA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="2SA 22:11" />सह आअ फैंखा आल़ै करूबा प्रैंदै बेशी,</para>
  <para style="q" vid="2SA 22:11">संघा आअ बागरी ज़िहअ छ़ेक्‍कै डैअ दैई।<verse eid="2SA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2SA 22:12" />तेऊ फेर हुअ न्हैरअ!</para>
  <para style="q" vid="2SA 22:12">सरगे काल़ै घणैं न्हैरै बादल़ हुऐ तेऊ फेर कठा,<verse eid="2SA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2SA 22:13" />तेऊ सेटा लागै गुल़ूबिज़ल़ू हंदै अर ज़ल़दै कोयलै ज़ेही आग भकदी।<verse eid="2SA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="2SA 22:14" />परम प्रधान परमेशर बिधातो बोल लागअ सरगा का गुल़ूबिज़ल़ू ज़िहअ शुण्हदअ।<verse eid="2SA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="2SA 22:15" />बिधाता खद्रेल़ै आपणैं दुशमण कतीर बाही ओर्ही-पोर्ही,</para>
  <para style="q" vid="2SA 22:15">तिन्‍नां लै शोटी सरगा का बीज अर तिन्‍नां जैंदरी पल़अ घणअ झाख।<verse eid="2SA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="2SA 22:16" />ज़ांऊं बिधाता आपणैं दुशमणा लै एक झांश काढी,</para>
  <para style="q" vid="2SA 22:16">धरनीं लागअ समुंदरो थाल्‍लअ शुझदअ,</para>
  <para style="q" vid="2SA 22:16">ज़ांऊं बिधाता रोश्शै क्रुंगअ,</para>
  <para style="q" vid="2SA 22:16">पृथूईए गाडा नाल़ी हुई पठी नांगी!<verse eid="2SA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="2SA 22:17" />बिधाता खिंच़अ हुंह स्वर्गा का आपणीं बाह करै</para>
  <para style="q" vid="2SA 22:17">डुघै समुंदरे पाणीं जैंदरा का उझै।<verse eid="2SA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="2SA 22:18" />तेऊ बच़ाऊअ हुंह मेरै बलबान दुशमणा का</para>
  <para style="q" vid="2SA 22:18">ज़ुंण मुंह संघै ज़ीद डाहा तै। किल्हैकि तिंयां</para>
  <para style="q" vid="2SA 22:18">तै बेघै खास्सै बलबान।<verse eid="2SA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="2SA 22:19" />खरीए पलका गोटअ हुंह तिन्‍नैं फेरा-फेर,</para>
  <para style="q" vid="2SA 22:19">पर तेभै किई बिधाता मेरी फाज़त।<verse eid="2SA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="2SA 22:20" />तेऊ किअ हुंह आफ़ता का दूर,</para>
  <para style="q" vid="2SA 22:20">हुंह छ़ड़ैऊअ तंऐं किल्हैकि सह झ़ूरा मुल्है खास्सअ।<verse eid="2SA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="2SA 22:21" />बिधाता दैनअ मुल्है धर्मीं हणैंओ पुआज़अ</para>
  <para style="q" vid="2SA 22:21">अर तंऐं दैनी मुल्है बर्गत किल्हैकि मेरै दिलै निं किछ़ै खोट आथी।<verse eid="2SA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="2SA 22:22" />हुंह करा तिहअ ई ज़िहअ बिधाता मुल्है बोला,</para>
  <para style="q" vid="2SA 22:22">तेऊ छ़ाडी निं हुंह कधि कबाता डेऊअ, मंऐं निं इहअ पाप किअ।<verse eid="2SA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="2SA 22:23" />हुंह डाहा बिधातो बधान सदा आद,</para>
  <para style="q" vid="2SA 22:23">तंऐं ज़ेही बिधी खोज़ी, तिंयां किई मंऐं तेही ई पूरी।<verse eid="2SA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="2SA 22:24" />ऐहा गल्‍ला ज़ाणा बिधाता आप्पै कि मुखा निं किछ़ै खोट आथी,</para>
  <para style="q" vid="2SA 22:24">हुंह रहा कदुष्ट कामां का दूर ई।<verse eid="2SA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="2SA 22:25" />बिधाता आसा मुल्है भलअ किल्हैकि मंऐं ज़िऊई धर्मीं ज़िन्दगी,</para>
  <para style="q" vid="2SA 22:25">तेऊ दैनी मुल्है बर्गत किल्हैकि हुंह रहअ</para>
  <para style="q" vid="2SA 22:25">ज़िहअ सह च़ाहा तिहअ ई नर्दोश।<verse eid="2SA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="2SA 22:26" />हे बिधाता, ज़ुंण ताल्है शुचै-पाक्‍कै आसा,</para>
  <para style="q" vid="2SA 22:26">तिन्‍नां लै आसा तूह बी तिहअ ई।</para>
  <para style="q" vid="2SA 22:26">ज़ुंण शुचै-पाक्‍कै रहा तिन्‍नां लै बी रहअ तिहअ ई शुचअ।<verse eid="2SA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="2SA 22:27" />शुचै लै रहा तूह शुचअ, पर ज़ुंण कदुष्ट काम करा,</para>
  <para style="q" vid="2SA 22:27">तिन्‍नां लै फिरा तूह क्रुखअ।<verse eid="2SA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="2SA 22:28" />भोल़ै मणछ बच़ाऊऐ तंऐं;</para>
  <para style="q" vid="2SA 22:28">पर घमंडी मणछ किऐ तंऐं शर्मिंदै।<verse eid="2SA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="2SA 22:29" />हे बिधाता, मुल्है किअ प्रैश्शअ तंऐं ई,</para>
  <para style="q" vid="2SA 22:29">तंऐं किअ मेरअ न्हैरअ मुखा दूर।<verse eid="2SA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="2SA 22:30" />तंऐं दैनअ मुल्है दुशमणा का ज़ितणा लै बल</para>
  <para style="q" vid="2SA 22:30">अर ताह करै सका हुंह कई नगरी ज़िती।<verse eid="2SA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="2SA 22:31" />परमेशरे बात आसा शुची-पाक्‍की,</para>
  <para style="q" vid="2SA 22:31">बिधाते बैणा दी आसा सत्त। ज़ुंण तेऊ सेटा शरण लआ,</para>
  <para style="q" vid="2SA 22:31">सह करा तिन्‍नें फाज़त।<verse eid="2SA 22:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="2SA 22:32" />बिधाता छ़ाडी निं होर कोहै परमेशर आथी!</para>
  <para style="q" vid="2SA 22:32">म्हारी शरण लणें बडी टोल्ह आसा सह ई।<verse eid="2SA 22:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="2SA 22:33" />परमेशर आसा मुल्है शरण लणा पाक्‍कै गहल़ा ज़िहअ,</para>
  <para style="q" vid="2SA 22:33">मुखा राम्बल़ी बात खोज़णैं आल़अ बी आसा सह ई।<verse eid="2SA 22:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="2SA 22:34" />सह दैआ मेरी ज़ांघा लै हरनी ज़िहअ ठुर्हनेओ ज़ोर</para>
  <para style="q" vid="2SA 22:34">अर सह ई करा मुंह उछ़टी धारा प्रैंदै खल़अ।<note caller="-" style="x"><char style="xo" closed="false">22:34 </char><char style="xt" closed="false"><ref loc="HEB 3:19">इब्रा. 3:19</ref></char></note><verse eid="2SA 22:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="2SA 22:35" />सह शखैल़ा मुखा जुध बिद्या,</para>
  <para style="q" vid="2SA 22:35">तैही सका हुंह कांस्से बडै धणशा दी डोर लाई।<verse eid="2SA 22:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="2SA 22:36" />हे बिधाता, तूह ई आसा एक्‍कै मेरी बच़ाऊंणै आल़ी ढाल़,</para>
  <para style="q" vid="2SA 22:36">तूह एछा मेरी मज़त करदअ, तंऐं किअ हुंह मशूर।<verse eid="2SA 22:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="2SA 22:37" />तंऐं बणाईं मुंह हांढणा लै बिरली बात,</para>
  <para style="q" vid="2SA 22:37">तेथ निं मेरै खूर फिशल़दै।<verse eid="2SA 22:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="2SA 22:38" />मंऐं काढै आपणैं दुशमण दरल़ाऊई अर तिंयां हारै मुखा।</para>
  <para style="q" vid="2SA 22:38">ज़ेभै तैणीं मंऐं तिंयां खतम निं किऐ,</para>
  <para style="q" vid="2SA 22:38">तेभै तैणीं निं हुंह पिछ़ू फिरदअ।<verse eid="2SA 22:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="2SA 22:39" />मंऐं बदल़ै तिंयां धरनीं अर</para>
  <para style="q" vid="2SA 22:39">तिंयां निं खल़ै उझ़णै जोगी डाहै,</para>
  <para style="q" vid="2SA 22:39">तिंयां चेल्है मंऐं आपणैं खूरा हेठै।<verse eid="2SA 22:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="2SA 22:40" />तूह दैआ मुल्है जुधा करनैओ बल,</para>
  <para style="q" vid="2SA 22:40">अर मेरै दुशमणा प्रैंदै ज़ीत।<verse eid="2SA 22:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="2SA 22:41" />तूह ठर्राऊआ मुखा मेरै दुशमणा दूर,</para>
  <para style="q" vid="2SA 22:41">ज़ुंण मुंह संघै ज़ीद डाहा, तिंयां किऐ मंऐं पठी मारी खतम।<verse eid="2SA 22:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="2SA 22:42" />तिंयां लागा मज़ती न्हैल़ै, पर तिन्‍नां बच़ाऊंदअ निं कोहै एछदअ।</para>
  <para style="q" vid="2SA 22:42">तिन्‍नैं पाई ताह बिधाता सेटा बी लेर-पकार पर तिन्‍नां निं किछ़ै ज़बाब भेटअ।<verse eid="2SA 22:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="2SA 22:43" />तिंयां चकोल्‍लै मंऐं धरनीं माट्टै जैंदरी,</para>
  <para style="q" vid="2SA 22:43">मंऐं जैंटै तिंयां धरनीं च़िक्‍करै ज़िहै।<verse eid="2SA 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="2SA 22:44" />तंऐं बच़ाऊअ हुंह मेरै द्रोही लोगा का,</para>
  <para style="q" vid="2SA 22:44">तंऐं दैनअ मुल्है तिन्‍नां होरी ज़ाती प्रैंदै राज़</para>
  <para style="q" vid="2SA 22:44">ज़हा हुंह बछ़ैणदअ बी नांईं त,</para>
  <para style="q" vid="2SA 22:44">तिंयां बी लागै मेरी च़ाकरी करदै।<verse eid="2SA 22:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="2SA 22:45" />परदेसी बी टेक्‍कणअ मुंह सेटा माथअ,</para>
  <para style="q" vid="2SA 22:45">मेरै बारै शूणीं मनणी तिन्‍नां मेरी हर गल्‍ला।<verse eid="2SA 22:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="2SA 22:46" />तिन्‍नां निं हिम्मत ई रहणीं, तिन्‍नों चुटणअ हैअ ई अर</para>
  <para style="q" vid="2SA 22:46">तिंयां एछणैं आपणैं गहल़ा का काम्बदी-काम्बदी।<verse eid="2SA 22:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="2SA 22:47" />हे बिधाता, तूह आसा ज़िऊंदअ परमेशर!</para>
  <para style="q" vid="2SA 22:47">मुंह करनी तेरी ज़ै-ज़ैकार!</para>
  <para style="q" vid="2SA 22:47">मुंह बच़ाऊंणै आल़अ आसा तूह</para>
  <para style="q" vid="2SA 22:47">अर मुंह करनी तेरी सारै दी बड़ैई।<verse eid="2SA 22:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="2SA 22:48" />हे परमेशर, तंऐं ज़ताऊअ हुंह मेरै दुशमणा का</para>
  <para style="q" vid="2SA 22:48">अर तंऐं किऐ देशा-देशे लोग मेरै बशै।<verse eid="2SA 22:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="2SA 22:49" />तंऐं बच़ाऊअ हुंह मेरै कदुष्ट दुशमणा का,</para>
  <para style="q" vid="2SA 22:49">तंऐं किहअ हुंह तिन्‍नां सोभी का खास्सअ महान।<verse eid="2SA 22:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="2SA 22:50" />हे बिधाता, मुंह करनअ देशा-देशे लोगा जैंदरी तेरअ शूकर,</para>
  <para style="q" vid="2SA 22:50">मुंह बोल़णीं तेरी ज़ै-ज़ैकार करना लै गिह।<note caller="-" style="x"><char style="xo" closed="false">22:50 </char><char style="xt" closed="false"><ref loc="ROM 15:9">रोम. 15:9</ref></char></note><verse eid="2SA 22:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="2SA 22:51" />हुंह ज़ुंण राज़अ तंऐं आप्पै हुअ छ़ांटअ द,</para>
  <para style="q" vid="2SA 22:51">मुल्है दैआ तूह बडी ज़ीत,</para>
  <para style="q" vid="2SA 22:51">तूह झ़ूरा मुंह राज़ै दाबेद अर</para>
  <para style="q" vid="2SA 22:51">मेरी आद-लुआदा लै पोस्ती दर पोस्ती सदा।<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s">मरनै का आजी दाबेदे बोल</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />ईशैईओ शोहरू दाबेद त सह मणछ ज़ुंण परमेशरै महान बणाअं, सह छ़ांटअ याकबे परमेशर बिधाता संघा बणाअं राज़अ। सह थिअ इज़राईला दी इहअ ज़ुंण दिला लोभणैं आल़ी गिहा गांठा त। मरनै का आजी बोलै दाबेदै ईंयां बोल:<verse eid="2SA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="2SA 23:2" />बिधाते पबित्र आत्मां बोलअ मुंह बाती,</para>
  <para style="q" vid="2SA 23:2">तेऊए पाऐ आपणैं बैण मेरै होठै।<verse eid="2SA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="2SA 23:3" />इज़राईले परमेशर,</para>
  <para style="q" vid="2SA 23:3">इज़राईले फाज़त करनै आल़ै बोलअ मुल्है इहअ,</para>
  <para style="q" vid="2SA 23:3">“ज़ुंण राज़अ परमेशरे डरा हेठै रहा,</para>
  <para style="q" vid="2SA 23:3">ज़ुंण शुचअ नसाफ करा,<verse eid="2SA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="2SA 23:4" />सह आसा दोत्ती बिझै सरगै निखल़दै सुरज़ा ज़िहअ,</para>
  <para style="q" vid="2SA 23:4">सह धुप्पअ ज़ेता करै पाणीं हणैं बाद घाह च़लकार छ़ाडा।”<verse eid="2SA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="2SA 23:5" />तैही दैणीं परमेशरा मेरी आद-लुआदा लै बर्गत,</para>
  <para style="q" vid="2SA 23:5">किल्हैकि तेऊ आसा मुंह संघै सदा लै करार किई दी,</para>
  <para style="q" vid="2SA 23:5">सह करार निं कधि चुटदी आथी,</para>
  <para style="q" vid="2SA 23:5">एही ज़बान ज़ेता का सह पिछ़ू निं हटदअ।</para>
  <para style="q" vid="2SA 23:5">हुंह बी च़ाहा इहअ ई,</para>
  <para style="q" vid="2SA 23:5">सह ई आसा मेरी ज़ीत अर</para>
  <para style="q" vid="2SA 23:5">बिधाता करनअ सह ई ज़ेते मुंह आशा आसा।<verse eid="2SA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="2SA 23:6" />कदुष्ट मणछ आसा कांडै-रिंडै ज़िहै ज़ुंण गोधी का पेच़ी शोटणै,</para>
  <para style="q" vid="2SA 23:6">तिन्‍नां निं कुंण हाथा करै ढाकी सकदअ,<verse eid="2SA 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="2SA 23:7" />तिंयां लागा बर्छ़ै अर मिंहडी करै पेच़णैं</para>
  <para style="q" vid="2SA 23:7">संघा लागा तिधी तेता दी आग चैल़ी पठी खतम करनै।<verse eid="2SA 23:7" /></para>
  <para style="s">दाबेदे मशूर जोधै</para>
  <para style="r">(<ref loc="1CH 11:10-41">1 इतिहास 11:10-41</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />राज़ै दाबेदे मशूर जोधै थिऐ ईंयां: एक जोधअ थिअ तकमोना का थिअ जोशेब-बाश-बेथ सह थिअ चिई दले सरदारा प्रैंदै प्रधान। तेऊ मारै तै एकी जुधा लै आपणैं बर्छ़ै करै दुशमणे आठ शौ शूरबीर एकी ज़ण्हैं। <verse eid="2SA 23:8" /><verse number="9" style="v" sid="2SA 23:9" />दुजअ मशूर जोधअ थिअ दाबेदे चिई जोधै मांझ़ै अहोह टोली का दोदैओ शोहरू एलीआजर। एकी बारी तै पलिश्ती जुधा लै झाल़्हुऐ दै, दाबेदै बोलअ पलिश्ती लै ज़ै तम्हैं तिहै फिरा तै एछा हाम्हां संघै मकाबलै लै! ज़ै कि होर इज़राईली तै गऐ दै जुधा करनै का पिछ़ू ठुर्ही! <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />पर एलीआजर रहअ टेक्‍की, सह रहअ पलिश्ती मारदअ लागी ज़ेभै तैणीं तेऊ का थकी करै तलबार धरनीं निं छ़ुटी। तैहा धैल़ी दैनी ती बिधाता इज़राईला लै बडी ज़ीत। बादा का आऐ तिंयां पिछ़ू ठुर्है दै इज़राईली सिधै तिन्‍नां मारै दै सैने अस्त्र-शस्त्र अर होरी च़िज़ा लुटदै अर जुध ज़ताऊअ एकी एलीआजरे।<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />चिऊथअ त हरार नगरी का आगिहो शोहरू शमाह। पलिश्ती तै लेई ज़ैगा मसरे खेचै जुधा लै आपणीं लगैग लाई दी। तधू बी ठुर्है इज़राईली पलिश्ती डरै पिछ़ू। <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />पर शमाह रहअ खेचै मांझ़ा-मांझ़ी एक्‍कै खल़्हुई अर तेऊ मारै खास्सै पलिश्ती अर खिरी ज़ितअ सह! अर तधू बी दैनी बिधाता इज़राईली लै एक बडी ज़ीत।<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />एकी साला डेऊऐ ज़ेठै नाज़ा लऊंणे ऋता तिह जोधै मांझ़ै चअन जोधै राज़ै दाबेदा सेटा अदुलाम डुआरै। पलिश्ती तै रपाईम खागै जुधा लै डेरै पाऐ दै। <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />दाबेद त उझै धारा गहल़ै अर पलिश्ती त बेतलेम नगरी कबज़अ हेरअ द करी। <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />दाबेदा फिरी घरकी आद संघा बोलअ, “तै भाल़ किहअ हणअ त ज़ै कुंण बेतलेम नगरीए प्रऊल़ी सेटे कुहै का मुल्है झुटणा लै पाणीं दैंदअ आणी!” <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />तिंयां चअन जोधै पलिश्ती डेरै, संघा आणअ बेतलेम नगरीए प्रऊल़ी सेटे कुहै का पाणीं भरी राज़ै दाबेदा सेटा। पर तेऊ निं सह पाणीं झुटअ अर तेऊ दैनअ तेऊ पाणीं करै बिधाता लै अर्घअ, <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />संघा बोलअ इहअ, “हे बिधाता, अह निं एता झुटी सकदअ! अह हणअ तिन्‍नां मणछे लोहू झुटणैं ज़िहअ ज़ुंणीं एता मुल्है आणना लै आपणीं ज़िन्दगी बी पाई खातरै दी।” तेखअ निं दाबेदै सह पाणीं झुटअ।</para>
  <para style="p" vid="2SA 23:17">इना चिई मशूर जोधे तै इहै हिम्मती आल़ै काम।<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />जोआबो भाई अबीशै, इने ईज थिई सरूयाह। अबीशै थिअ तिन्‍नां चिई जोधै मांझ़ै एक। एकी जुधा लै मारै तै तेऊ एकी ज़ण्हैं आपणैं बर्छ़ै करै चअन शौ दुशमण संघा हुअ तिहा जोधै मांझ़ै तेऊओ नाअं मशूर। <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />सह हुअ इहअ मशूर कि तेखअ बणाअं सह तिन्‍नां ई तिह मशूर जोधैओ दलपति। पर अज़ी बी निं सह खास चिई जोधै ज़िहअ मशूर हुअ त।<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />कबसेल नगरी का थिअ जहोयादो शोहरू बेनियाह मशूर सपाही, तेऊ किऐ बडै-बडै नुआहरै काम। एकी बारी पाऐ तै तेऊ मोआबीए दूई सोभी का तगल़ै जोधै मारी। सह होथअ हिंऊंदै उंधै एकी जुहल़ी लै संघा पाअ एक बडअ सिह मारी। <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />एकी बारी मारअ तेऊ मिसर देशो एक बडअ दैंत्तर जोधअ। मिसर देशे तेऊ जोधे हाथै थिअ बर्छ़अ, पर बेनियाह डेऊअ तेऊए मकाबलै करदअ शोठी पाई संघा छ़ड़ैऊअ तेऊए ई हाथा का बर्छ़अ संघा पाअ सह तेता ई करै मारी। <verse eid="2SA 23:21" /><verse number="22-23" style="v" sid="2SA 23:22-23" />जहोयादे शोहरू बेनियाह किऐ इहै-इहै ज़बर काम। खास चिई जोधै मांझ़ै ता निं तेऊ ज़ैगा भेटी पर सह थिअ खास तिह जोधै जैंदरी मशूर। दाबेदै बणाअं सह तेखअ आपणीं फाज़त करनै आल़ै शूर-बीरो दलपति।<verse eid="2SA 23:22-23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 23:24" />तिंयां तिह जोधै तै ईंयां:</para>
  <para style="li" vid="2SA 23:24">जोआबो भाई असाहेल,</para>
  <para style="li" vid="2SA 23:24">बेतलेम नगरीए दोदो शोहरू एलहान,<verse eid="2SA 23:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="2SA 23:25" />हरोदा का शमाह अर एलिका,<verse eid="2SA 23:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="2SA 23:26" />पलती का हेलेस,</para>
  <para style="li" vid="2SA 23:26">तकोआ का इकेशो शोहरू ईरा,<verse eid="2SA 23:26" /></para>
  <para style="li">
    <verse number="27" style="v" sid="2SA 23:27" />अनातोता का एबीएजेर,</para>
  <para style="li" vid="2SA 23:27">हुशाई नगरी का मबुनाई,<verse eid="2SA 23:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="2SA 23:28" />अहोहा का सलमोन,</para>
  <para style="li" vid="2SA 23:28">नतपाह का महरै<verse eid="2SA 23:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="2SA 23:29" />नतपाह ई का एक होर हेलेबो शोहरू बानाह</para>
  <para style="li" vid="2SA 23:29">बिन्यामीने गिबा नगरी का रिबैओ शोहरू ईताई<verse eid="2SA 23:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="2SA 23:30" />पिरातोना का बेनियाह,</para>
  <para style="li" vid="2SA 23:30">गाश धारे गाडा नेल़ रहणैं आल़अ हिदाई,<verse eid="2SA 23:30" /></para>
  <para style="li">
    <verse number="31" style="v" sid="2SA 23:31" />बेथ-अराबा का एबी-अल्बोन</para>
  <para style="li" vid="2SA 23:31">बहूरीमा का अज़मबेथ<verse eid="2SA 23:31" /></para>
  <para style="li">
    <verse number="32" style="v" sid="2SA 23:32" />एलीआबा का शालबोनी</para>
  <para style="li" vid="2SA 23:32">याशेने खिंबा का जोनातान<verse eid="2SA 23:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="2SA 23:33" />हरार नगरी का शमाह,</para>
  <para style="li" vid="2SA 23:33">शरारो शोहरू आहीआम,<verse eid="2SA 23:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="2SA 23:34" />मकात नगरी का आहसोबैओ शोहरू एलीपेलेत,</para>
  <para style="li" vid="2SA 23:34">गीलो नगरी का आहीतपेलो शोहरू एलीआम<verse eid="2SA 23:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="2SA 23:35" />कर्मेल नगरी का हेस्रो,</para>
  <para style="li" vid="2SA 23:35">अराबा का परेई<verse eid="2SA 23:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="2SA 23:36" />सोबा नगरी का नातानो शोहरू ईगाल,</para>
  <para style="li" vid="2SA 23:36">गाद गोत्रा का बैनी<verse eid="2SA 23:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="2SA 23:37" />अमोन नगरी का सेलेक</para>
  <para style="li" vid="2SA 23:37">बरोत नगरी का नहारी, सह थिअ सरूयाहे शोहरू जोआबे अस्त्र-शस्त्रा ढोणै आल़अ।<verse eid="2SA 23:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="2SA 23:38" />इतेरा का ईरा अर गारेब</para>
  <para style="li" vid="2SA 23:38">हित्ती उरियाह।<verse eid="2SA 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 23:39" />ईंयां सोभै तै पठी गणी करै सैईंती ज़ण्हैं दाबेदे खास जोधै।<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s">दाबेदै किई आपणीं परज़े गणांई</para>
  <para style="r">(<ref loc="1CH 21:1-27">1 इतिहास 21:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />बिधाता त इज़राईली का खास्सअ रुश्शअ द, तेऊ दैनअ दाबेदा करै तिन्‍नां लै आफ़त पल़णै। बिधाता बोलअ तेऊ लै, “तूह लाग डेऊंदअ, संघा कर इज़राईल अर यहूदा बस्सै दै सोभी इज़राईलीए गणांई ज़िहअ तूह च़ाहा।” <verse eid="2SA 24:1" /><verse number="2" style="v" sid="2SA 24:2" />राज़ै दाबेदै किअ आपणैं सैनापति जोआबा लै हुकम, “तूह डेऊ आपणैं कार-करिंदै संघा निंईं उतरा बाखा दान मुल्खा उंधै दखण बेर्शेबा तैणीं सारै इज़राईली गोत्रा सेटा संघा करा सारी परज़े गणांई। हुंह च़ाहा इहअ भाल़णअ कि तिन्‍नां मांझ़ै केतरै मणछ आसा सैना दी डाहणैं जोगी।”<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />पर जोआबै दैनअ दाबेदा लै ज़बाब, “माहा राज़अ, च़ाऐ एभै ज़ेतरै बी होए, तेरै परमेशर बिधाता बढेरनीं तेरी सैना शौ गुणा खास्सी, हई सका कि तूह इहअ हंदअ आपणीं ज़िऊंदी ज़िता आपणीं आछी भाल़े। पर हे मेरै मालक, तूह इहअ किल्है च़ाहा करनअ?” <verse eid="2SA 24:3" /><verse number="4" style="v" sid="2SA 24:4" />पर राज़ै बोलअ जोआब अर तेऊए कार-करिंदै लै, “ज़िहअ मंऐं हुकम किअ तिहअ ई करा।” तेखअ लागै तिंयां राज़ै सेटा का इज़राईली परज़े गणांई करदै हांढदै।<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />तिंयां टपै जरदण नदी पार बाखा संघा पाऐ अरोर नगरीए दखणा बाखा आपणैं डेरै। अरोर नगरी थिई गाद मुल्खै मांझ़ खागा दी। तिधा का डेऊऐ तिंयां गाद अर उतरा बाखा ज़जार नगरी तैणीं। <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />तिधा का डेऊऐ तिंयां गलाद अर कादेश हित्ती लोगे मुल्खै। तेखअ डेऊऐ तिंयां दान-ज़ान अर फेरअ बाही पुजै पछ़म सदोन। <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />तिधा का पुजै तिंयां सूर नाओंए पाक्‍कै गहल़ै अर तेखअ डेऊऐ तिंयां हिब्बी अर कनानीए सोभी नगरी दी। खिरी पुजै तिंयां यहूदा मुल्खै दखण रेगीस्ताना बाखा बेर्शेबा अर इहअ करै मुक्‍कै तिंयां सारै इज़राईल देशै फेरी दैई। <verse eid="2SA 24:7" /><verse number="8" style="v" sid="2SA 24:8" />इहअ करै पुजै तिंयां नौ भिन्‍नैं अर बिहा धैल़ै बाद सारै देशै फेरी दैई एरुशलेम नगरी बापस फिरी। <verse eid="2SA 24:8" /><verse number="9" style="v" sid="2SA 24:9" />तेखअ दैनअ जोआब अर तेऊए कार-करिंदै राज़ै का परज़े गणांईओ पठी साब खोज़ी, “माहा राज़अ, इज़राईला दी आसा कोई आठ लाख मणछ ज़ुंण सैना दी च़ाकरी सका दैई अर यहूदा मुल्खै आसा कोई पांज़ लाख।”<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />पर इज़राईली परज़े ऐहा गणांई करनै का बाद हुअ दाबेद राज़अ दुखी संघा बोलअ तेऊ बिधाता लै, “इहअ करी किअ मंऐं घोर पाप! ज़ीबाण, मेरै एऊ ऐडै कामां लै छ़ाड तूह मुल्है माफी।” <verse eid="2SA 24:10" /><verse number="11" style="v" sid="2SA 24:11" />राज़ै दाबेदो त आपणअ एक गूर तेऊ नाअं त गाद। बिधाता बोलअ तेऊ का, “तूह डेऊ दाबेद राज़ै सेटा संघा बोल तेऊ लै इहअ, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />‘मंऐं लाई ताल्है पल़णै आल़ी चअन आफ़ता रहैऊई, तूह छ़ांट तेता मांझ़ै एक कि हुंह ताह प्रैंदै तेथ मांझ़ै किज़ै आफ़त पाऊं?’” ज़ांऊं दुजै धैल़ै दाबेद राज़अ उझ़ुअ, <verse eid="2SA 24:12" /><verse number="13" style="v" sid="2SA 24:13" />गाद डेऊअ तेऊ सेटा, संघा खोज़अ तेऊ कि बिधाता बोला ताल्है इहअ-इहअ। तेखअ पुछ़अ दाबेदा का इहअ, “ताह आप्पू लै कुंण ज़ेही सज़ा लोल़ी? आपणैं देशै चिई साला तैणीं घोर नकाल़? कि चिई भिन्‍नैं तैणीं तेरै दुशमण ताह पिछ़ू रहे पल़ी? कि चिई धैल़ै तैणीं तेरै देशै माहा-मरी लोल़ी पल़ी? ऐबै कर तूह राम्बल़ै करै बच़ार संघा खोज़ मुखा कि हुंह बिधाता लै किज़ै ज़बाब दैंऊं बापस?”<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />दाबेद राज़ै बोलअ गाद गूरा लै, “मुल्है पल़ी अह बेघै बूरी आफ़त! हुंह निं च़ाहंदअ कि कुंण मणछ मुल्है सज़ा दैए। बिधाता दै हाम्हां लै आप्पै सज़ा दैणैं, तेऊए झींण आसा महान।” <verse eid="2SA 24:14" /><verse number="15" style="v" sid="2SA 24:15" />बिधाता पाई तेखअ तैहा दोत्ती पोर्ही इज़राईला मांझ़ै माहा-मरी। सह रही चिई धैल़ै तैणीं पल़ी। उतरा बाखा दान उंधै दखण बेर्शेबा तैणीं मूंऐं सारै इज़राईल देशै सत्तर हज़ार मणछ। <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />ज़ांऊं बिधातो स्वर्ग दूत एरुशलेम नगरी पठी खतम करनै आल़अ त, बिधाता किअ सह मारनै आल़अ स्वर्ग दूत पिछ़ू, “ऐबै हुअ बतेर्हअ!” तेभै त सह स्वर्ग दूत अरोना नाओंए एकी जबेशी मणछे खहल़ै।<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />दाबेदा का शुझुअ सह स्वर्ग दूत आपणीं आछी ज़ुंण परज़ा मारदअ त लागअ द, तेखअ बोलअ दाबेदै बिधाता लै, “अह आसा पठी मेरअ कशूर, मेरै भलै हुई गलती, इनै रैनै-गरीब मणछो निं किछ़ै कशूर आथी! बिधाता, मेरै परमेशर, तूह दै मुल्है अर मेरै टबरा लै सज़ा, इना होरी लोगा निं मारी आथी”<verse eid="2SA 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />तैहा ई धैल़ी डेऊअ तेखअ गाद दाबेदा सेटा लै संघा बोलअ तेऊ लै इहअ, “अरोना जबेशीए खहल़ा लै डेऊ संघा बणा तिधी बिधाता लै एक बेदी।”<verse eid="2SA 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 24:19" />ज़िहअ बिधाता हुकम किअ, दाबेदै किअ तिहअ ई संघा डेऊअ तिधा लै ज़िहअ गाद गूरै तेऊ का खोज़अ। <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />अरोना भाल़अ उंधै अर तेऊ का शुझुऐ कि राज़अ दाबेद अर तेऊए कार-करिंदै आसा तेऊ बाखा लै उझै एछदै लागै दै। सह पल़अ दाबेदा सेटा उटी बाखा धरनीं माथै टेक्‍कदअ, <verse eid="2SA 24:20" /><verse number="21" style="v" sid="2SA 24:21" />संघा पुछ़ा अरोना राज़ै का इहअ, “मेरै मालक, आझ़ किहअ हुअ तेरअ इधा लै एछणअ?”</para>
  <para style="p" vid="2SA 24:21">दाबेदै दैनअ तेऊ लै ज़बाब, “मंऐं लाअ ताखा तेरअ खहल़ मोलै लई, संघा लाई बिधाता लै इधी बेदी बणाईं ताकि सह परज़ा मांझ़ा का ऐहा माहा-मरी दूर करे।”<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />अरोना बोलअ राज़ै दाबेदा लै, “मेरै मालक, तूह लाग निंदअ, संघा दै बिधाता लै ज़िहअ तूह च़ाहा तिहअ। इधी आसा भाल़ मेरै बल्द हूम बल़ी करना लै, खहल़ा मांडणे चाण अर हल़-जूँ हणैं बेदी दी आगी ज़ाल़णा लै।” <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />अरोना दैनी ईंयां सोभै गल्‍ला राज़ै दाबेदा लै संघा बोलअ इहअ, “मेरी आसा बिधाता का एही अरज़ कि बिधाता लोल़ी त तेरी हूम बल़ी करै खुश हुअ।”<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />पर राज़ै दाबेदै बोलअ अरोना लै, “मुंह निं ईंयां एही लोल़ी, मुंह दैणअ ताल्है एतो मोल। मुंह निं बिधाता लै इहअ हूम बल़ीदान करनअ ज़ेतो मंऐं मोल ई निं आथी दैनअ द।” तेखअ दैनअ अरोना लै बल्दो अर खहल़े ज़ैगो पज़ाह च़ंदीए सिक्‍कै मोल। <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />तेखअ च़िणीं तिधी तेऊ बिधाता लै एक बेदी संघा किअ तेथ हूम अर मेल़-ज़ोल़ो बल़ीदान। बिधाता शूणीं दाबेद राज़े अरज़ संघा किई इज़राईला मांझ़ा का माहा मरी दूर।<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>