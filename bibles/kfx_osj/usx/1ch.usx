  <para style="h">1 इतिहास</para>
  <para style="toc1">राज़ै दाबेदो महान राज़</para>
  <para style="toc2">1 इतिहास</para>
  <para style="toc3">1 इति.</para>
  <para style="mt1">1 इतिहास</para>
  <para style="mt2">राज़ै दाबेदो महान राज़</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: खास थोघ निं आथी पर कोऐ बोला अह आसा एज्रा लिखी दी</para>
  <para style="ili">सन: 450 का 400 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">1 इतिहास अर 2 इतिहासे कताबा थिई शुरू दी एक्‍कै कताब। इना दुही कताबा दी आसा पैहलै मणछ आदमी पोर्ही इज़राईलीए 538 ईसा आजी बाबेल देशे गलामी का बापस फिरनैं तैणीं बिधाते परज़ो इतिहास खोज़अ द। ऐहा कताबा लिखणैं आल़ै किई इब्रानी अर होरी इतिहासे कताबा का लोल़ी-ज़ोल़ी करै गल्‍ला कठा संघा डाही खास्सी मैन्थ करी एक कताब लिखी।</para>
  <para style="ip">ऐहा कताबा दी आसा खास मणछ दाबेदे बारै ज़ुंण बिधाता लै खास्सअ झ़ूरा त। एथ आसा खासकर यहूदा मुल्ख, बिन्यामीन अर प्रोहतो काम करनै आल़ै लेबी गोत्रे बारै खोज़अ द। बिधाता दैनी राज़ै दाबेदा लै एही बर्गत कि तेऊओ राज़ किअ सदा लै पाक्‍कअ। राज़अ दाबेद रहअ बिधाता लै इहअ शुचअ-पाक्‍कअ कि संसारै राज़अ बणी तिहअ रहणअ हआ बेघै कठण। एरुशलेम नगरी बिधाता लै भबन बणाणें सोठ बी थिई राज़ै दाबेदे अर आजू दैनअ बिधाता राज़ै सुलैमाने हाथै एता पूरअ हणैं। ज़ांऊं राज़अ दाबेद खास्सअ प्रोढअ हुअ, तेऊ किई खिरी सोभी परज़ा नदरी बिधाते एही ज़ै-ज़ैकार:</para>
  <para style="imq">“बिधाता, मुंह करनीं तेरी सदा ज़ै-ज़ैकार! तूह आसा सह परमेशर ज़हा मेरअ दाद-बाब याकब मना त। तेरअ बल आसा महान अर तेरअ झ़ामण शुझिआ सारै भ्रमंडै। माहा राज़अ आसा तूह ई अर सोभी प्रैंदै आसा तेरअ ई राज़। तूह करा आपणैं बल अर ज़ोरा करै राज़। मणछा करा सेठ, बलबान अर मशूर तूह ई।”</para>
  <para style="ipr">(29:10-12)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">राज़ै शाऊला तैणीं पैहलै आदमीए आद-लुआद 1:1—9:44</para>
  <para style="io1">राज़ै शाऊल अर तेऊए शोहरूए मौत 10:1-14</para>
  <para style="io1">दाबेद राज़अ इज़राईलो राज़अ 11:1—29:30</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">आबरामा तैणीं आदमो खिंब</para>
  <para style="r">(<ref loc="GEN 5:1-32">मूल़ 5:1-32</ref>; <ref loc="GEN 10:1-32">10:1-32</ref>; <ref loc="GEN 11:10-26">11:10-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />आदम, शेत, एनोश, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />कनान, महलेल, जेरेद, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />हणोक, मतूशेलह, लेमेक, <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />नूह, शेम, हाम, ज़बेद।<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />ज़बेदे शोहरू: गोमेर, मागोग, मादी, ज़ाबण, तूबल, मेशक, तीरस।<verse eid="1CH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 1:6" />गोमेरे शोहरू: अशकनाज, दीपत अर तोगर्मा।<verse eid="1CH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 1:7" />ज़ाबणे शोहरू: एलीशाह, तरशीश, कित्ती, रोदानी।<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />हामे शोहरू: कूश, मिसर, पुत अर कनान।<verse eid="1CH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 1:9" />कूशे शोहरू: सबा, हबीला, सेबता, रामाह अर सबतका।</para>
  <para style="p" vid="1CH 1:9">रामाहे शोहरू: शेबा अर ददान।<verse eid="1CH 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 1:10" />कूशो हुअ निम्रोद नाओं शोहरू, सह थिअ पृथूई दी पैहलअ जोधअ।<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />मिसरे आद-लुआद आसा, लूदी, अनामी, लहाबी, नपतूही, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पत्रूसी, कसलूही ज़हा का पलिश्ती निखल़ै अर कप्तोरी।<verse eid="1CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 1:13" />कनानो ज़ेठअ शोहरू थिअ सदोन अर तेखअ हुऐ हित्ती, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />जबेशी, अमोरी, गिर्गाशी <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिब्बी, अरेकी, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अर्बादी, समारी अर हमाती बी थिऐ कनाने ई आद-लुआद।<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />शेमे शोहरू: एलाम, अश्शूर, अर्पक्षद, लूद, अराम, ऊज़, हूल, गतेर अर मेशक।<verse eid="1CH 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 1:18" />अर्पक्षदो शोहरू त शेलाह अर तेऊओ शोहरू त एबेर। <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />एबेरे हुऐ आजू दूई शोहरू। ज़ेठै शोहरू नाअं थिअ पेलेग किल्हैकि अह त सह ज़मानअ, ज़धू धरती दी लोग बांढुऐ। एबेरो कान्हअ शोहरू थिअ ज़गतान।<verse eid="1CH 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 1:20" />ज़गताना का हुऐ अलमोदाद, शेलप, हसरामाबेथ, ज़ारा, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हादोराम, उजेल, दिकला, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />एबल, अबीमीएल, शेबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओपीर, हबीला अर जोबाब। ईंयां सोभै तै ज़गताने आद-लुआद।<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />शेमे खिंबा दी थिऐ अब्रामा तैणीं ईंयां: शेम, अर्पक्षद, शेलाह, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />एबेर, पेलेग, रऊ, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेराह अर <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />अब्राम ज़हा लै आबराम बी बोला।<verse eid="1CH 1:27" /></para>
  <para style="s">आबरामे आद-लुआद</para>
  <para style="r">(<ref loc="GEN 25:12-16">मूल़ 25:12-16</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />आबरामे शोहरू तै इशमाईल अर इसहाक। <verse eid="1CH 1:28" /><verse number="29" style="v" sid="1CH 1:29" />दासी हागारा का हुऐ दै इशमाईले आद-लुआद आसा एही: तेऊओ सोभी का ज़ेठअ थिअ नबयोत, तेऊ बाद हुऐ कदार, अदबेल, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिशमा, दुमा, मासा, हदाद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />जतूर, नपीश अर कदमा।<verse eid="1CH 1:31" /></para>
  <para style="s">कतूरा का आबरामे लुआद</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />आबरामे ती कतूरा नाओंए एक होर डाही दी बेटल़ी तैहा का हुऐ तेऊए छ़ह शोहरू: ज़िमरान, जोकशान, मदान, मिद्यान, ईशबाक अर शूहा। जोकशाने तै आजू दूई शोहरू शेबा अर ददान। <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />मिद्याने हुऐ पांज़ शोहरू: एपा, एपेर, हणोक, अबीदा अर एल्दा। ईंयां सोभै तै कतूरा का आजू लुआद।<verse eid="1CH 1:33" /></para>
  <para style="s">साराईए आद-लुआद</para>
  <para style="r">(<ref loc="GEN 36:1-9">मूल़ 36:1-9</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />आबरामे शोहरू इसहाके थिऐ दूई शोहरू एसाब अर याकब ज़हा लै इज़राईल बी बोला। <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />एसाब ज़हा लै एदोम बी बोला, तेऊए आद-लुआद तै: एलीपज, रूएल, जेऊश, ज़ालम अर कोराह। <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />एलीपजे आद-लुआद तै: तेमान, ओमार, सपो, गताम, कनज, तिम्ना अर अमोलक। <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />रूएले शोहरू तै, नाहत, जेराह, शमाह अर मिज़ा।<verse eid="1CH 1:37" /></para>
  <para style="s">सेईरे आद-लुआद</para>
  <para style="r">(<ref loc="GEN 36:20-30">मूल़ 36:20-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />सेईरे तै छ़ह शोहरू लोतान, शोबाल, सबोन, अना, दशोन, एसार अर दशान।<verse eid="1CH 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 1:39" />लोताने शोहरू तै हूरी अर होमाम अर लोताने बैहण ती तिम्ना।<verse eid="1CH 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 1:40" />शोबाले तै पांज़ शोहरू अलियान, मनाहत, एबल, शेपी, ओनाम। सबोने हुऐ दूई शोहरू आया अर अना।<verse eid="1CH 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 1:41" />अनो त एक शोहरू दशोन। दशोने हुऐ आजू च़ार शोहरू हम्रान, एशबान इतरान अर करान।<verse eid="1CH 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 1:42" />एसारे तै चअन शोहरू बिल्हान, जाबण, जाकान। दशोने शोहरू तै ऊज़ अर अरान।<verse eid="1CH 1:42" /></para>
  <para style="s">एदोम देशे राज़ै</para>
  <para style="r">(<ref loc="GEN 36:31-43">मूल़ 36:31-43</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />ज़हा ज़मानै इज़राईली प्रैंदै कोहै राज़अ निं हंदअ त, तेऊ ज़मानै तै एदोम देशै ईंयां राज़ै शोहरू बेला-बेन-बोर राज़अ, तेऊए राज़धानी ती दिन्हाबा नगरी। <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />ज़ांऊं बेला राज़अ मूंअ, तेऊ बाद बणअ बोज़रा नगरीओ जेराहो शोहरू जोबाब तेऊए ज़ैगा राज़अ। <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />जोबाबा मरनै का बाद बणअ तेऊए ज़ैगा, तेमानी ज़ातीए मांझ़ा का हुशाम राज़अ। <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />ज़ांऊं राज़अ हुशाम मूंअ, तेखअ बणअ बदादो शोहरू हदाद राज़अ, ज़ुंण मोआब देशै मिद्यानी ज़ातीए लोग जुधा दी हारै तै। तेऊए राज़धानी ती अबीत नगरी। <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />हदादा बाद बणअ मसरेका नगरीओ समला सदोमो राज़अ। <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />समला मरनै बाद बणअ फरात दरैऊए बाढै रोहबोत नगरीओ रहणैं आल़अ शाऊल तेऊए ज़ैगा राज़अ। <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />शाऊला मरनै का बाद किअ अकबोरे शोहरू बालहानणै तेऊए ज़ैगा राज़। <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />अकबोरे शोहरू बालहानणा मरनै का बाद बणअ हदाद राज़अ। तेऊए राज़धानी ती पाऊ नगरी। तेऊए लाल़ी महेटबेल थिई मटरेदे शोहरी अर मेजाहबे पोची।<verse eid="1CH 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CH 1:51" />ज़ांऊं हदाद मूंअ, तेऊ बाद हुऐ एदोमे खिंबा का ईंयां सैणैं: तिम्ना, अल्बा, ज़तेत, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />आलीबामा, एला, पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />कनज, तेमान, मिबसार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />मगदीएल अर ईरम।</para>
  <para style="p" vid="1CH 1:54">ईंयां टोली आसा एदोमे खिंबा का।<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">इज़राईले शोहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />इज़राईले हुऐ बारा शोहरू रूबेन, शमौन, लेबी, यहूदा, इस्साकार, ज़बलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, युसुफ, बिन्यामीन, नप्ताली, गाद अर आशेर।<verse eid="1CH 2:2" /></para>
  <para style="s">राज़ै दाबेदा तैणीं यहूदो खिंब</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदे तै पठी पांज़ शोहरू। तेऊ ती बेथ-शुआ नाओंए एक कनानी बेटल़ी बैही दी, तैहा का हुऐ तेऊए चअन शोहरू: एर, ओनान अर शेलाह। इना मांझ़ै त एर बेघै कदुष्ट अर सह निं बिधाता खास्सअ ज़िऊंदअ डाहअ। <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />तामार ज़ुंण यहूदे नुश थिई, तैहा का हुऐ तेऊए दूई शोहरू फिरिस अर जेराह।<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />फिरिसे हुऐ आजू दूई शोहरू हिस्रोन अर हामल। <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />जेराहे हुऐ पांज़ शोहरू ज़िम्री, एतान, हमान, कलकोल अर दारा। <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />जेराहे आद-लुआदा मांझ़ै थिअ आजू कर्मींओ शोहरू अकार, तेऊ पाई ती बिधाता लै मानत मनी दी च़िज़ा आप्पू लै च़ोरी डाही करै इज़राईली लै घोर आफ़त।<verse eid="1CH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 2:8" />जेराहे शोहरू एतानो त आजू एक्‍कै शोहरू अजर्याह।<verse eid="1CH 2:8" /></para>
  <para style="s">राज़ै दाबेदो खिंब</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />यहूदा अर तामारे पोचै हिस्रोने हुऐ चअन शोहरू: जर्मेल, राम अर कालूब।<verse eid="1CH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 2:10" />रामो खिंब त ईशैई तैणीं इहअ: रामो शोहरू त अमीनादाब, तेऊओ हुअ आजू नहशोन ज़ुंण यहूदे आद-लुआदा मांझ़ै सैणअ बणअ। <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />नहशोना का हुअ सल्मा, तेऊओ शोहरू त बोआज़ अर तेऊओ हुअ आजू <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />ओबेद अर तेऊ का हुअ ईशैई।<verse eid="1CH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 2:13" />ईशैईए थिऐ सात शोहरू। तिंयां थिऐ ज़ेठै का कान्हैं तैणीं ईंयां: सोभी का ज़ेठअ एलीआब, तेऊ का कान्हअ अबीनादाब, तेखअ तिसरा, शिमा, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />नतनेल, रदाई, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />ओसेम अर सोभी का कान्हअ दाबेद। <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />ईशैईए थिई सरूयाह अर अबीगेल नाओंए दूई शोहरी बी।</para>
  <para style="p" vid="1CH 2:16">सरूयाहे तै चअन शोहरू अबीशै, जोआब अर असाहेल। <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />अबीगेलो बैह त इशमाईले खिंबा दी जतेरा संघै हुअ द। तिन्‍नों त एक शोहरू तेऊ नाअं त अमासा।<verse eid="1CH 2:17" /></para>
  <para style="s">हिस्रोने आद-लुआद</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />हिस्रोने शोहरू कालेबै त अजूबा नाओंए बेटल़ी संघै बैह किअ द अर तिन्‍नें हुई एक शोहरी तैहा नाअं त जेरीओत। तेसे हुऐ चअन शोहरू जशेर, शोबाब अर अर्दोन। <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />ज़ांऊं अजूबा मूंईं, कालेबै किअ एप्रात नाओंए बेटल़ी संघै बैह। तिन्‍नों हुअ एक शोहरू तेऊ नाअं त हूर। <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />हूरो हुअ शोहरू तेऊ नाअं त ऊरी अर आजू हुअ हूरो पोचअ बसलेल।<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />शाठी साले अमरा किअ हेस्रोनै माकीरे शोहरी संघै बैह ज़ुंण गलादे बैहण थिई। तैहा का हुअ हिस्रोनो एक शोहरू तेऊ नाअं त सगूब अर <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />सगूबो हुअ आजू शोहरू तेऊ नाअं त याईर। याईर थिअ गलाद मुल्खै त्रेई नगरी प्रैंदै राज़अ। <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />पर गशूर अर अराम देशै किअ तिन्‍नां मांझ़ै सोल़ा नगरी दी याईर अर कनाते गराऊंआं संघी कबज़अ। तेथ बस्सै दै सोभ लोग थिऐ गलादे बाब माकीरे आद-लुआद। <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />ज़ांऊं हिस्रोन कालेब-एप्रात नगरी मूंअ, तेऊए शोहरू कालेबै किअ तेऊए बिधबा बेटल़ी अबियाह संघै बैह। तिन्‍नां दूई का हुअ एक शोहरू तेऊ नाअं त अशहूर ज़ुंण बादा का तकोआ नगरी बस्सअ।<verse eid="1CH 2:24" /></para>
  <para style="s">जर्मेले आद-लुआद</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />जर्मेल थिअ हिस्रोनो ज़ेठअ शोहरू तेऊए हुऐ आजू पांज़ शोहरू: सोभी का ज़ेठअ राम, तेऊ कान्हअ बूना, ओरेन, ओसेम अर आहिजा। <verse eid="1CH 2:25" /><verse number="26-27" style="v" sid="1CH 2:26-27" />रामे हुऐ आजू चअन शोहरू माज़, जामीन अर एकेर। जर्मेले ती एक होर बेटल़ी, तैहा नाअं त अतारा, तैहा का हुअ तेऊओ एक शोहरू तेऊ नाअं त ओनाम। <verse eid="1CH 2:26-27" /><verse number="28" style="v" sid="1CH 2:28" />ओनामे तै दूई शोहरू शमाई अर जादा। शमाईए बी हुऐ आजू दूई शोहरू नादाब अर अबीशूर।<verse eid="1CH 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 2:29" />अबीशूरै किअ अबिहेल नाओंए बेटल़ी संघै बैह अर तिन्‍नें हुऐ दूई शोहरू आहबान अर मोलीद। <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />नादाबे बी हुऐ दूई शोहरू सेलेद अर अपैम, पर सेलेदे निं आजू किछ़ै लुआद हुई, सह मूंअ तिहअ ई। <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />अपैमो शोहरू त ईशी, ईशीओ शोहरू त शेशान अर तेऊओ शोहरू त अहलाई।<verse eid="1CH 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 2:32" />शमाईए भाऊ जादे थिऐ दूई शोहरू जतेर अर जोनातान, जतेर मूंअ आद-लुआदा बाझ़ी। <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />जोनाताने बी थिऐ दूई शोहरू पलेत अर जाजा। ईंयां एतरै थिऐ जर्मेले आद-लुआद।<verse eid="1CH 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 2:34" />शेशाने हुई निरी शोहरी, तेऊओ निं शोहरू हुअ। तेऊ सेटा थिअ मिसर देशा का जराहा नाओं एक दास। <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />तेऊ किअ आपणीं एकी शोहरीओ बैह जराहा संघै। तिन्‍नों हुअ एक शोहरू तेऊ नाअं त अताई। <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />एलीशामा तैणीं अताईओ खिंब निखल़अ इहअ: अताई, नातान, जाबाद, <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />एपलाल, ओबेद, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />जेहू, अजर्याह, <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />हेलेज़, एलासा, <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />सिसमी, शलूम, <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />जकमिया अर खिरी तेऊओ शोहरू एलीशामा।<verse eid="1CH 2:41" /></para>
  <para style="s">कालेबे होर आद-लुआद</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />जर्मेले कान्हैं भाई कालेबो ज़ेठअ शोहरू थिअ मेशा। तेऊओ शोहरू हुअ आजू जीप, तेऊओ शोहरू त मारेशा ज़ुंण हेब्रोनो बाब थिअ।<verse eid="1CH 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 2:43" />हेब्रोने तै च़ार शोहरू: कोराह, तपूह, रकेम अर शेमा। <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />शामाई थिअ रहामो बाब अर जोरकीमो दादू। शेमो भाई रकेम थिअ शमाईओ बाब। <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />शामाई त मिऊनो बाब अर मिऊनो शोहरू त बेथ-सूर।<verse eid="1CH 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1CH 2:46" />कालेबे ती एपा नाओंए एक डाही दी बेटल़ी। तैहा का हुऐ कालेबे चअन शोहरू: हारान, मोजा अर गाजेज। हारानो बी थिअ एक शोहरू हुअ द, तेऊ नाअं बी थिअ गाजेज।<verse eid="1CH 2:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47" />एपा थिई जादाईए शोहरी। जदाईए थिऐ पांज़ शोहरू बी: रगेम, जताम, गशान, पलेत अर शाप।<verse eid="1CH 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 2:48" />कालेबै ती माकाहा नाओंए एक होर बेटल़ी डाही दी, तैहा का हुऐ तेऊए दूई शोहरू शबेर अर तिर्हाना। <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />बादा का हुऐ तेसे दूई होर शोहरू शाप अर शेबा। शाप थिअ मदमन्‍नो बाब अर शेबा आसा मकबेना अर गिबो बाब।</para>
  <para style="p" vid="1CH 2:49">इना का लाऊआ थिई कालेबे एक शोहरी तैहा नाअं त अकसा।<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />ईंयां एतरै थिऐ कालेबे आद-लुआद:</para>
  <para style="p" vid="1CH 2:50">कालेब अर तेऊए लाल़ी एप्रातो शोहरू हूर थिअ सोभी का ज़ेठअ। हूरे शोहरू त शोबाल ज़ुंणीं आपणैं शोहरूए नाओंऐं किर्यात-ज़रीम नगरी बसाऊई। <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />हूरो दुजअ शोहरू सल्मा ज़ुंणीं आपणैं शोहरूए नाओंऐं बेतलेम नगरी बस्साऊई। हूरो चिऊथअ शोहरू थिअ हारेप ज़ुंणीं आपणैं शोहरूए नाओंऐं बेथ-गदेरा नगरी बस्साऊई।<verse eid="1CH 2:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1CH 2:52" />हारोए अर मनूहोते आधी टोली बी थिई किर्यात-ज़रीमे बाब शोबाले खिंबा का अर <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />किर्यात-ज़रीम नगरी बस्सी दी टोली बी थिई तेऊए ई आद-लुआद। तिधी बस्सी दी टोली आसा ती: इतेरी, पुती, शमाती अर मिश्री। जोराह अर एश्तोल नगरीए लोग थिऐ मिश्री टोली का निखल़ै दै।<verse eid="1CH 2:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54" />सल्मे आद-लुआद तै बेतलेम, नतपाह, अतरोत-बेथ-जोआब सूर नगरी अर मनाहत नगरीए आधै लोग।<verse eid="1CH 2:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1CH 2:55" />जबेश नगरी बस्सी दी टोली बी थिई सल्मा का निखल़ी दी, तिंयां थिऐ दालत अर राज़ दरबारे काईथ। तिंयां ती तिराती, शमाती, सकाती। ईंयां थिऐ कैनी टोली का हमाते आद-लुआद ज़ुंण रकाबी संघै बैहुऐ अर इहअ करै गण्हिंआं तिंयां रकाबे खिंबा का बी।<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">दाबेदो खिंब</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />राज़ै दाबेदे राज़धानी ती पैहलै हेब्रोन नगरी, तिधी रहंदी हुऐ तेऊए छ़ह शोहरू: अमनोन हुअ जज्रेल नगरी का आणी दी आहीनोमा का, दुजअ शोहरू दानिएल हुअ कर्मेल नगरी का आणी दी अबीगेला का। <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />चिऊथअ शोहरू अबशलोम हुअ गशूर देशे राज़ै तलमाईए शोहरी माकाहा का अर च़ौथअ शोहरू त अदोनियाह अर तेऊए ईज ती हागीता। <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />पांज़ूअ शोहरू त शपताह अर तेऊए ईज ती अबीताल। छ़हुअ शोहरू त ईतराम ज़सरी ईज एगला थिई।<verse eid="1CH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 3:4" />राज़अ दाबेद रहअ हेब्रोन नगरी साढै साता साला तैणीं।</para>
  <para style="p" vid="1CH 3:4">तेखअ बणाईं तेऊ आपणीं राज़धानी एरुशलेम अर तिधा का किअ तेऊ तेत्ती साला तैणीं इज़राईली प्रैंदै राज़ अर <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />एरुशलेम नगरी बी हुऐ तेऊए खास्सै शोहरू।</para>
  <para style="p" vid="1CH 3:5">तेऊए लाल़ी अमीएले शोहरी बेथ-शुआ का हुऐ च़ार शोहरू: शिमा, शोबाब, नातान, सुलैमान।<verse eid="1CH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 3:6" />राज़ै दाबेदे थिऐ नौ होर शोहरू बी: ईभार, एलीशू, एलीपेलेत, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगह, नपेग, ज़ापी, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीशामा, एल्यादा, एलीपेलेत। <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />इना शोहरू का लाऊआ तै राज़ै दाबेदे होर डाही दी बेटल़ीए बी शोहरू। राज़ै दाबेदे ती एक शोहरी बी तैहा नाअं त तामार।<verse eid="1CH 3:9" /></para>
  <para style="s">सुलैमाने आद-लुआद</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />राज़ै सुलैमानो खिंब डेऊअ बाबा का शोहरू लै पोस्ती-दर पोस्ती इहअ: सुलैमान, रहबाम, अबियाह, आसाह, जहोशापात, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />जोराम, अहाजया, जोआश, <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />अमास्या, उज़ियाह, जताम, <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />अहाज, हिजकिया, मनिश्शे, <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />अमोन, जोशिया।<verse eid="1CH 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 3:15" />जोशिया राज़े थिऐ च़ार शोहरू: सोभी का ज़ेठअ जोहनान, जेहोकीम, सिदकिया अर शलूम। <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />जेहोकीमे थिऐ दूई शोहरू जकोनया अर सिदकिया।<verse eid="1CH 3:16" /></para>
  <para style="s">जकोनया राज़े आद-लुआद</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />जकोनया राज़अ ज़ुंण बाबेल देशे माहा राज़ै कैद करी बाबेल देशा लै निंयं, तेऊए तै सात शोहरू: शालतीएल, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />मल्कीराम, पदायाह, शेनसर, जकमिया, होशामा अर नेदाबिया। <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />जेहोकीने शोहरू पदाये तै दूई शोहरू जरूबाबेल अर शिमी। जरूबाबेले तै आजू मशूलाम अर हनन्याह शोहरू अर इना दूई संघै ती एक शोहरी हुई दी तैहा नाअं त शेलोमीत। <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />जरूबाबेले तै पांज़ होर शोहरू बी: हशूबा, ओहेल, बरेक्याह, हसादया अर जूशब-हेसद।<verse eid="1CH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21" />जरूबाबेले शोहरू हनन्याहे बी थिऐ दूई शोहरू पलतीया अर जेशाईया। जेशाईयो थिअ रपाया नाओं एक शोहरू, रपाया त अर्नानो बाब, अर्नानो शोहरू त ओबेदियो अर ओबेदियो शोहरू त शकनया।<verse eid="1CH 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 3:22" />शकनयो त आजू एक शोहरू तेऊ नाअं त शमयाह अर शमयाहे तै आजू पांज़ शोहरू: हतूश, ईगाल, बरीया, नेरीया अर शापात। <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />नेरीए तै आजू चअन शोहरू हुऐ दै: एलोनाई, हिजकिया अर अज्रीकाम। <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />एलोनाईए तै सात शोहरू हुऐ दै: होदाबया, एलियाशिब, पेलिया, अकूब, जोहनान, दलाया अर अनानी।<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">यहूदो खिंब</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदे थिऐ पांज़ शोहरू: फिरिस, हिस्रोन, कर्मीं, हूर अर शोबाल। <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />शोबाल त रायाहो बाब अर जहातो दादू। जहातो हुअ आहूमाई अर लाहाद, जोराह नगरी बस्सी दी टोली थिई आजू इने आद-लुआद। <verse eid="1CH 4:2" /><verse number="3-4" style="v" sid="1CH 4:3-4" />हूर थिअ कालेब अर एप्राता का हुअ द सोभी का ज़ेठअ शोहरू। तेऊए आद-लुआदा मांझ़ै बस्सै कई बेतलेम नगरी। हूरे थिऐ चअन शोहरू: एताम, पनूएल, एजेर। एतामे शोहरू तै जज्रेल, इशमा अर इदबाश। इने ती एक बैहण बी तैहा नाअं त हसलेलपूनी।</para>
  <para style="p" vid="1CH 4:3-4">पनूएलै बस्साऊई आपणैं शोहरूए नाओंऐं गदोर नगरी अर एजेरै बस्साऊई आपणैं शोहरू हुशाहे नाओंऐं हुशाई नगरी।<verse eid="1CH 4:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5" />अशहूर ज़ुंणीं आपणैं शोहरूए नाओंऐं तकोआ नगरी बस्साऊई, तेऊ ती दूई बेटल़ी आणी दी, हेला अर नारा। <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />नारा का हुऐ अशहूरे च़ार शोहरू: आहुजाम, हेपेर, तेमनी, हाहाशतारी। <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />हेला का हुऐ अशहूरे चअन शोहरू: सेरेत, सोहार अर एतनान।<verse eid="1CH 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 4:8" />कोज़ थिअ अनूब अर सोबेबो बाब अर हारूमे शोहरू अहारहेले टोली बी थिई कोज़े ई आद-लुआद।<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />तिन्‍नां मांझ़ै त जबेश नाओं एक मणछ, तेऊओ हआ त टोली दी तेऊए सोभी भाई-बंधा का खास्सअ अदर। तेऊए ईजा डाहअ तेऊ नाअं जबेश किल्हैकि तैहा हुई ती तेऊ सुंदा बारी खास्सी दाह। <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />पर जबेशै किई इज़राईले परमेशर बिधाता सेटा एही अरज़, “परमेशर, तंऐं लोल़ी ती मुल्है खास्सी बर्गत दैनी, हुंह च़ाहा त इहअ कि तूह मुल्है खास्सअ देश दैए। हुंह च़ाहा त इहअ कि तूह लोल़ी मुंह संघा रहअ अर तंऐं लोल़ी त हुंह इहै बूरै करनै का बच़ाऊई डाहअ ज़ेता करै मुल्है दाह-दुख एछी सका।” बिधाता दैनअ तेऊ लै तिहअ ई बरदान ज़िहअ तेऊ मांगअ।<verse eid="1CH 4:10" /></para>
  <para style="s">होर खिंब</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />शूहे भाई कालूबो शोहरू त मेहर। बादा का हुअ मेहरो शोहरू एशतोन। <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एशतोने हुऐ चअन शोहरू: बेथ-रापा, पसेह अर तेहीना। तेहीना बसाऊई आपणैं शोहरूए नाओंऐं नहाश नगरी। इने आद-लुआद रहा ती रेका नगरी।<verse eid="1CH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 4:13" />कनजीए तै दूई शोहरू ओतनिएल अर सरयाह। आजू हुऐ ओतनिएले बी दूई शोहरू हातात अर मेनतैई। <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मेनतैई थिअ ओफरो बाब।</para>
  <para style="p" vid="1CH 4:14">सरयाह थिअ जोआबो बाब। ज़िधी जोआब बस्सअ, तेऊ बसाऊअ गेहरशीम खाग किल्हैकि तिधी बस्सै दै थिऐ सोभ काठे कारीगीर।<verse eid="1CH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 4:15" />यपुन्‍नें शोहरू कालेबे थिऐ चअन शोहरू: ईरू, एला अर नांम। एलो शोहरू त कनज।<verse eid="1CH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 4:16" />जहलेले तै च़ार शोहरू: जीप, जिपा, तिरिया अर असरेल।<verse eid="1CH 4:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="1CH 4:17-18" />एज्रे थिऐ च़ार शोहरू: जतेर, मेरेद, एपेर अर जलोन। मेरेदै किअ मिसर देशे माहा राज़ेए देई बितिया संघै बैह अर तिन्‍नें हुई एक शोहरी तैहा नाअं त मिर्याम अर दूई हुऐ शोहरू शमाई अर इशबा। इशबा बसाऊई एश्तमो नगरी। मेरेदै किअ यहूदा गोत्रे एकी शोहरी संघै बैह अर तिन्‍नें हुऐ चअन शोहरू: जेरेद ज़ुंणीं गदोर नगरी बसाऊई, हेबेर ज़ुंणीं सोको नगरी बसाऊई अर ज़गतीएल ज़ुंणीं जानोह नगरी बसाऊई।<verse eid="1CH 4:17-18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 4:19" />होदिया किअ नाहामे बैहणी संघै बैह। होदिये खिंबा का निखल़ी गरेम टोली ज़ुंण केलाह नगरी बस्सै अर मकात टोली ज़ुंण एश्तमो नगरी बस्सै।<verse eid="1CH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 4:20" />शमौने तै च़ार शोहरू: अमनोन, रिना, बेन-हनान अर तिलोन।</para>
  <para style="p" vid="1CH 4:20">ईशीए थिऐ दूई शोहरू जोहेत अर बेन-जोहेत।<verse eid="1CH 4:20" /></para>
  <para style="s">शेलाहे आद-लुआद</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />यहूदो बी थिअ शेलाह नाओं एक शोहरू, शेलाहे तै दूई शोहरू लादा अर एर। एरै बसाऊई आपणैं शोहरू लिके नाओंऐं लिका नगरी, लादा बसाऊई आपणैं शोहरूए नाओंऐं मारेशा नगरी। बेथ-अशबे नगरी बस्सै दै लोग बी थिऐ शेलाहे खिंबा का, तैहा टोलीए लोग करा तै बाछे झिकल़ै बुणणेओ काम। <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />जोकीम अर कोज़बा नगरी बस्सै दै, जोआश अर साराप ज़ुंणीं मोआबी बेटल़ी संघै बैह किअ त, तिंयां थिऐ बेतलेम नगरी बस्सै दै। इने नाओं थोघ लागा पैहलकै ज़मानें इतिहासा दी। <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />ईंयां तै खमार अर ईंयां करा तै राज़ै लै काम अर ईंयां तै नताईम अर गदेरा नगरी बस्सै दै।<verse eid="1CH 4:23" /></para>
  <para style="s">शमौने आद-लुआद</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />शमौने तै पांज़ शोहरू: नमूएल, ज़ामन, जारीब, जेराह अर शाऊल। <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />शाऊलो शोहरू त शलूम, मिबसाम पोचअ अर मिशमा त शाऊलो पल़पोचअ। <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />मिशमो शोहरू त हमूएल, जक्‍कूर त पोचअ अर शिमी थिअ मिशमो पल़पोचअ।<verse eid="1CH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />शिमीए ती आजू सोल़ा शोहरी अर छ़ह शोहरू पर तेऊए होरी भाईए निं खास्सै शोहरू-माठै आथी तै। तैही निं शमौन गोत्र यहूदा गोत्रा ज़िहअ खास्सअ बढअ।<verse eid="1CH 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 4:28" />दाबेदे इज़राईल देशे राज़ै बणनैं का आजी शमौन गोत्रे टोली ज़हा-ज़हा नगरी तै बस्सै दै तिंयां ती ईंयां: बेर्शेबा, मोलदा, हसर्शूआल़, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिल्हा, एसेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बतूएल, होर्मा, सकाल़ग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेथ-मकारबोत, हसरसूसीम, बेथ-बिरी अर शारेम नगरी। <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />तिंयां थिऐ होर्ती बी पांज़ा ज़ैगा बस्सै दै तिंयां नगरी ती: एताम, ऐन, रमोन, तोकेन अर आशान नगरी अर <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />इना नगरी फेर गराऊंऐं दखणा बाखा बाल नगरी तैणीं। ईंयां तै एथ बस्सै दै अर इने आद-लुआद बी थिई ईंयां एतरी।<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 4:34" />शमौन गोत्रे टोलीए सैणैं थिऐ ईंयां: मशोबाब, जमोलक, अमास्यो शोहरू जोशा, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />जोएल, जोशिबीयो शोहरू जेहू ज़ुंण सरयाहो पोचअ अर असीएलो पल़पोचअ थिअ। <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />एलोनाई, जाकोबा, जेहोहया, असाया, आदीएल, जसीमिएल, बेनियाह अर <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />शिपीओ शोहरू जीजा ज़ुंण अलोनो पोचअ अर जदायो पल़पोचअ। जदाया थिअ शिम्रीओ शोहरू अर शमयाहो पोचअ।<verse eid="1CH 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />ईंयां एतरै तै शमौन गोत्रा का आपणीं-आपणीं टोलीए मूल़ अर सैणैं। शमौन गोत्रे टोली रही बढदी लागी अर <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />तिंयां डेऊए पछ़मा बाखा गदोर नगरी तैणीं। तैहा नगरी पुर्बा बाखा खागै रहै तिंयां आपणीं भेडा-बाकरीए हेल़्ही च़राऊंदै लागी। <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />तेथ भेटी तिन्‍नां डागै-चैणैं लै खास्सै घाह-पाचा आल़ी ज़ैगा अर अह ज़ैगा बी थिई फेर-फिरदी खास्सी अर शांत। तिन्‍नां का आजी तै तैहा ज़ैगा हामे आद-लुआदा मांझ़ा का बस्सै दै।<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />ज़ेऊ ज़मानै यहूदा मुल्खै राज़ै हिजकियो राज़ थिअ, तेऊ ज़मानै डेऊऐ ईंयां आदमी इना नगरी लै ज़सरै नाअं उपर आसा लिखै दै। तिधी तै मुनी लोग बस्सै दै अर इनै किऐ तिन्‍नें डेरै पठी बरैबाद अर तिंयां लोग पाऐ इहै मारी कि तिन्‍नों निं नाअं-नशाण ई डाहअ अर आप्पू बस्सै तिन्‍नें ज़ैगा तिधी। किल्हैकि तेथ त तिन्‍नें भेडा-बाकरीए हेल़्ही च़ारना लै खास्सअ घाह-पाच। <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />बादा का डेऊऐ शमौन गोत्रा का कोई पांज़ शौ मणछ एदोम देशा लै, तिन्‍नां प्रैंदै सैणैं थिऐ ईशीए शोहरू पलतीया, नारिया, रपाया अर उज्जीएल। <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />तिन्‍नैं पाऐ तिधी बस्सै दै अमोलकी मारी अर आप्पू आसा आझ़ तैणीं बी तिधी बस्सै दै।<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">रूबेने आद-लुआद</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />रूबेन थिअ इज़राईलो ज़ेठअ शोहरू, पर तेऊ लाई आपणैं बाबे डाही दी बेटल़ी संघै सुत्ती छ़ोत अर इहअ करै पाअ तेऊ आपणअ ज़ेठै हणैंओ हक ज़ांऐं अर तेऊओ हक भेटअ युसुफा। <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />एही ता थिअ यहूदा गोत्र सोभी का बलबान अर तेऊ किअ सोभी गोत्रा प्रैंदै राज़ पर ज़ेठै हणैंओ हक भेटअ युसुफा। <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इज़राईले ज़ेठै शोहरू रूबेने तै च़ार शोहरू: हणोक, पालू, हिस्रोन अर कर्मीं।<verse eid="1CH 5:3" /></para>
  <para style="p">
    <verse number="4-6" style="v" sid="1CH 5:4-6" />कर्मींए शोहरू जोएले आद-लुआद तै बाबा बाद शोहरू पोस्ती दर पोस्ती इहै: जोएल, शमयाह, गोग, शिमी, मिका, रायाह, बाल अर बेरा। अश्शूरी राज़ै तिगला-पेल़सरै निंयं बीराह कैद करी, सह थिअ रूबेन गोत्रो सैणअ।<verse eid="1CH 5:4-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 5:7" />रूबेन गोत्रे खिंबा दी थिऐ आपणीं-आपणीं टोली दी ईंयां सैणैं: जेइल, जकर्या, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />अजाजो शोहरू बेला ज़ुंण शेमो पोचअ अर जोएलो पल़पोचअ थिअ। अह टोली ती अरोर नगरी बस्सी दी ज़ुंण नेबो अर बाल-मिऊन मुल्खे उतरा बाखा आसा। <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />तिन्‍नें ती गलाद मुल्खै डागै-चैणें खास्सी हेल़्ही अर ज़ैगा पल़ी थोल़ी, तैही किअ तिन्‍नैं पुर्बा बाखा रेगीस्तानै फरात दरैऊआ तैणीं कबज़अ।<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />ज़ेऊ ज़मानै इज़राईल देशै राज़अ शाऊल थिअ, रूबेन गोत्रा आल़ै छ़ेल़अ हागारी लोगा संघै जुध अर तिन्‍नें पाऐ तेऊ जुधा दी हागारी मारी अर तिन्‍नें ज़ैगा किअ गलाद मुल्खै पुर्बा बाखा कबज़अ।<verse eid="1CH 5:10" /></para>
  <para style="s">गादे आद-लुआद</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />गाद गोत्रा आल़ै तै रूबेन गोत्रे उतरा बाखा बाशान मुल्खा पोर्ही सल्का नगरी पुर्बा बाखा तैणीं बस्सै दै। <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />तिन्‍नें सोभी का बडी टोलीओ मूल़ थिअ जोएल, दुजी बडी टोलीओ मूल़ थिअ शापाम। इना बाद थिऐ जानाई अर शापात आपणीं-आपणीं टोलीए मूल़। ईंयां तै बाशान बस्सै दै। <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />गाद गोत्रे होर भाई-बंध थिऐ इना साता टोली का: मिकाईल, मशूलाम, शेबा, जोराई, जाकन, ज़िआ अर एबेर टोली का। <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />ईंयां थिऐ हूरीए शोहरू अबिहेले आद-लुआद। तेऊओ खिंब त इहअ: अबिहेलो बाब त हूरी, जारोह त दादू अर गलाद त पल़दादू। गलाद त मिकाईलो शोहरू जशिशैओ पोचअ जाहदो पल़पोचअ। जाहद त बूज़ो शोहरू। <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />इने खिंबे मूल़ थिअ गूनीओ पोचअ अबदीएलो शोहरू आही। <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />तिंयां थिऐ बाशान अर गलाद मुल्खे नगरी अर शारोन मुल्खे घैहणीं दुजी बाखा तैणीं बस्सै दै। <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />इना सोभिओ इतिहास आसा तेऊ ज़मानै लिखअ द ज़धू यहूदा मुल्खै जताम अर इज़राईल मुल्खै जरोबाम राज़अ थिअ।<verse eid="1CH 5:17" /></para>
  <para style="s">पुर्बा बाखा बस्सै दै गोत्रा संघै अरामी</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />रूबेन, गाद अर कनान देशै पुर्बा बाखा बस्सै दै मनिश्शे गोत्रा दी थिऐ पठी चरताल़ी हज़ार सात शौ शाठ जोधै सपाही। तिंयां थिऐ जुध बिद्ये ज़ाण-प्रबीण ज़ुंण ढाल़-तलबार अर कतीर-कबाणा करै जुध ज़ाणा तै करी। <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />तिन्‍नैं किअ हागारी, जतूर, नपीश अर नोदाब ज़ाती संघै जुध। <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />तिंयां डेओआ तै बिधाता का अरज़ करी जुधा लै कि सह तिन्‍नें मज़त करे अर बिधाता बी रहअ तिन्‍नां संघै अर तिन्‍नां लै दैनी हागारी अर तिन्‍नें साथी ज़ाती का ज़ीत। <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />तिन्‍नें किअ इना ज़ातीए डागै-चैणें हेल़्ही दी कबज़अ। तिंयां थिऐ कोई पज़ाह हज़ार ऊँट, दूई लाख पज़ाह हज़ार भेडा-बाकरी, दूई हज़ार गाधै। एक लाख किऐ तिन्‍नें आदमी जुधा दी कैद। <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />तेऊ जुधा लै मारै तै तिन्‍नैं खास्सै दुशमण, किल्हैकि तेऊ जुधा लै थिअ बिधाता तिन्‍नां संघै। तेखअ रहै तिंयां तिन्‍नें ज़ैगा अश्शूर देशे गलामी दी डेऊणैं का आजी तैणीं तिधी बस्सी।<verse eid="1CH 5:22" /></para>
  <para style="s">पुर्बा बाखा बस्सै दै मनिश्शे आधै गोत्रे आद-लुआद</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />मनिश्शे गोत्रा मांझ़ै तै जरदण नदी आर पुर्बा बाखा बाशान पोर्ही बाल-हर्मोन, सनीर, हर्मोन धारा बस्सै दै। तिंयां हुऐ आजू खास्सै। <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />तिन्‍नें टोलीए मूल़ तै ईंयां: एपेर, ईशी, एलीएल, अजरीएल, जेरमयाह, होदाबया अर जदीएल। ईंयां सोभै तै खास्सै शूरबीर अर आपणीं-आपणीं टोलीए मशूर सैणैं।<verse eid="1CH 5:24" /></para>
  <para style="s">पुर्बा बाखा मनिश्शे गोत्र डेऊअ गलामी दी</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />पर जरदण नदी आर पुर्बा बाखा मनिश्शे आधै गोत्रा आल़ै निं आपणैं दादा-बाबे परमेशर बिधाता लै शुचै-पाक्‍कै रहै! तिंयां लागै तिन्‍नां ज़ातीए देअआ पूज़दै ज़ुंण परमेशरै तेऊ देशा का दूर काढै तै। <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />बिधाता दैनअ तिन्‍नें देशा लै अश्शूर देशे राज़ै तिगला-पेल़सरा एछणैं अर कबज़अ करनै। तेऊ किऐ रूबेन, गाद अर पुर्बा बाखा बस्सै दै मनिश्शे गोत्रा आल़ै कैद संघा बसाऊऐ तिंयां तिधा का गोजान नदी नेल़ हालाह, हाबोर अर हारा नगरी।<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">माहा प्रोहतो खिंब</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />लेबी थिअ गर्शोन, कहात अर मरारीओ बाब। <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />कहाते हुऐ आजू च़ार शोहरू: अमराम, इसहार, हेब्रोन अर उज्जीएल।<verse eid="1CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 6:3" />अमरामे हुऐ आजू दूई शोहरू एक शोहरी: हारण, मोसा अर शोहरी नाअं त मिर्याम।</para>
  <para style="p" vid="1CH 6:3">हारणे तै आजू च़ार शोहरू: नादाब, अबीहू, एलीआजर अर ईतामार।<verse eid="1CH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 6:4" />एलीआजरे लुआद थिई आजू पोस्ती दर पोस्ती एही: एलीआजर, पिनहास, अबीशू, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />बूकी, ऊज्जी, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />जेराह, मरयोत, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />अमर्या, आहीतूब, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />सदोक, आहीमास, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />अजर्याह, जोहनान, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />जोहनाना का हुअ अजर्याह ज़ुंण एरुशलेम नगरी राज़ै सुलैमानै बिधाता लै बणाऐं दै भबनै प्रोहतो काम करा त। <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />अमर्या, आहीतूब, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />सदोक, शलूम, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />हिलकिया, अजर्याह, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />अजर्याह का सरयाह अर सरयाह का जेहोसादक। <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />राज़ै नबूकदनेसरै निंयं त जेहोसादक माहा प्रोहत बी होरी यहूदी अर एरुशलेम नगरीए लोगा संघै कैद करी बाबेल देशा लै, तिन्‍नां दैनअ त बिधाता आपणीं ज़ैगा छ़ाडी होरी देशे गलामी दी डेऊणैं।<verse eid="1CH 6:15" /></para>
  <para style="s">लेबीए होर आद-लुआद</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />लेबीए तै चअन शोहरू: गर्शोन, कहात अर मरारी। <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />इना सोभिए बी थिई आजू लुआद। गर्शोने तै दूई शोहरू: लिब्नी अर शिमी। <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />कहाते तै आजू च़ार शोहरू हुऐ दै: अमराम, इसहार, हेब्रोन अर उज्जीएल। <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />लेबीए शोहरू मरारीए थिऐ दूई शोहरू: महली अर मूशी।<verse eid="1CH 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 6:20" />गर्शोने आद-लुआद ती बाब अर शोहरूए साबै पोस्ती दर पोस्ती एही: गर्शोम, लिब्नी, जहात, ज़िमा, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />जोआह, ईदू, जेराह, जितराई।<verse eid="1CH 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 6:22" />कहाते आद-लुआद ती पोस्ती दर पोस्ती एही: कहात, अमीनादाब, कोराह, आशीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />एलकाना, एबियासाप, आशीर, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />ताहात, ऊरीएल, उज़ियाह अर शाऊल।<verse eid="1CH 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 6:25" />एलकाना का थिऐ दूई शोहरू हुऐ दै, अमासा अर आहीमोत। <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />आहीमोते आद-लुआद ती आजू पोस्ती दर पोस्ती एही: एलकाना, सोपी, नाहत, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />एलीआब, जेरोहाम अर एलकाना।<verse eid="1CH 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 6:28" />शमूएले बी थिऐ दूई शोहरू हुऐ दै: ज़ेठअ जोएल अर कान्हअ अबियाह।<verse eid="1CH 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 6:29" />मरारीए आद-लुआद थिई पोस्ती दर पोस्ती एही: महली, लिब्नी, शिमी, उज्ज़ा, <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />शिमा, हागाया, असाया।<verse eid="1CH 6:30" /></para>
  <para style="s">बिधाते भबनै गाज़ै-बाज़ै आल़ै</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />ज़ांऊं बिधाते करारो मणशू एरुशलेम बिधाते खिम्भा दी पजैल़अ, राज़ै दाबेदै डाहै तिधी लेबी गोत्रा का गाज़ै-बाज़ै आल़ै। <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />तिंयां करा तै धैल़ बारी-बारी बिधाते मेल़-ज़ोल़े खिम्भा दी च़ाकरी करी अर बादा का बणाअं राज़ै सुलैमानै राज़धानी एरुशलेम बिधाता लै भबन अर तेखअ दैआ तै ईंयां तिधी बारी-बारी हाज़री। <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />तिंयां थिऐ आपणीं-आपणीं टोलीए साबै पोस्ती-दर पोस्ती ईंयां:</para>
  <para style="p" vid="1CH 6:33">कहाती टोली का: जोएलो शोहरू हमान थिअ गाणैं-बज़ाणैं आल़ैओ सैणअ। तेऊओ खिंब त पिछ़ू याकबा तैणीं इहअ: हमान, जोएल, शमूएल, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />एलकाना, जेरोहाम, एलीएल, तोह, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />सूप, एलकाना, महात, अमासा, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />एलकाना, जोएल, अजर्याह, सपन्याह, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />ताहात, आशीर, एबियासाप, कोराह, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />इसहार, कहात, लेबी अर लेबी त याकबो शोहरू ज़हा लै इज़राईल बी बोला।<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />असाप थिअ हमानो ई टबर ज़ुंण तेऊ बाद गाज़ै-बाज़ै आल़ैओ सैणअ थिअ। तेऊओ खिंब डेऊअ तेऊए दाद-बाब लेबी तैणीं पिछ़ू इहअ: असाप, बरेक्याह, शिमा, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />मिकाईल, बासेया, मलकिजा, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />एतनी, जेराह, अदाया, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />एतान, ज़िमा, शिमी, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />जहात, गर्शोन अर तेऊओ बाब लेबी।<verse eid="1CH 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44" />मरारी टोलीओ एतान बी थिअ हमानो टबर अर सह थिअ तेऊ बाद असापा बाद गाज़ै-बाज़ै आल़ैओ सैणअ। तेऊओ खिंब डेऊअ तेऊए दाद-बाब लेबी तैणीं पिछ़ू इहअ: एतान, किशी, अबदी, मलूक, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />हशाबिया, अमास्या, हिलकिया, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />अमसी, बैनी, शमेर, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />महली, मूशी, मरारी अर तेऊओ बाब त लेबी।<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />लेबी गोत्रे होरी लोगा लै थिई बिधाते भबने होरी कामां-काज़े ज़िम्मैंबारी सभाल़ी दी।<verse eid="1CH 6:48" /></para>
  <para style="s">हारणे आद-लुआद</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />बिधाता लै बेदी दी हूम बल़ीदान, धूप बेदी दी धूपा दैणैंओ हक थिअ सिधअ हारण अर आजू तेऊए आद-लुआदो। खास पबित्र ज़ैगा डेऊणे अर पूज़ा-गाज़ा करने अर सोभी इज़राईलीए पापे प्राश्त करने ज़िम्मैंबारी ती तिन्‍नें। तिंयां करा तै एऊ कामां ठीक तेऊ साबै ज़िहअ बिधाते गूर मोसा तिन्‍नां लै हुकम त किअ द। <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />हारणे आद-लुआद ती आजू पोस्ती दर-पोस्ती एही: एलीआजर, पिनहास, अबीशू, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />बूकी, ऊज्जी, जेराह, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />मरयोत, अमर्या, आहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />सदोक अर तेऊओ शोहरू त आहीमास।<verse eid="1CH 6:53" /></para>
  <para style="s">तिंयां नगरी ज़िधी-ज़िधी लेबी तै बस्सै दै</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />कनान देशै ज़ुंण-ज़ुंण नगरी लेबी गोत्रे हेस्सै ती आई दी, तिन्‍नैं पाई तेता बांडणां लै परच़ी अर सोभी का आजी निखल़अ हारणे खिंबा दी कहात टोलीओ नाअं अर तिन्‍नां भेटअ हेस्सअ। <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />कहात टोलीए हेस्सै आई यहूदा मुल्खै हेब्रोन नगरी तेते फेर फिरदी घैहणीं संघी। <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />पर तैहा नगरीए खेच अर गराअं दैनै यपुन्‍नें शोहरू कालेबे हेस्सै। <verse eid="1CH 6:56" /><verse number="57-59" style="v" sid="1CH 6:57-59" />हारणे खिंबे हेस्सै आई शरण नगरी हेब्रोन, फेर-फिरदी घैहणीं संघी जतीर, लिब्ना अर एश्तमो नगरी, हीलेन, दबीर, अशान अर बेथ-शमेश नगरी तिन्‍नां फेर-फिरदी घैहणीं संघी। <verse eid="1CH 6:57-59" /><verse number="60" style="v" sid="1CH 6:60" />ज़ुंण ज़ैगा बिन्यामीन गोत्रे बांडै ती आई दी, तेता मांझ़ै भेटी तिन्‍नां लै गबोन, गिबा, अलमेथ, अनातोत नगरी तेता फेर-फिरदी घैहणीं संघी। इहअ करै भेटी तिन्‍नां पठी तेर्हा नगरी कि तिंयां तेथ बस्से। <verse eid="1CH 6:60" /><verse number="61" style="v" sid="1CH 6:61" />लेबी गोत्रे कहाती टोली का ज़ुंण बाकी बच़ै, तिन्‍नां भेटी परच़ी पाई दस नगरी जरदण नदी पछ़मा बाखा बस्सै दै मनिश्शे गोत्रे हेस्सै मांझ़ा का।<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />लेबी गोत्रे गर्शोन टोली आल़ै भेटी तिन्‍नें खिंबे साबै परच़ी पाई तेर्हा नगरी इस्साकार, आशेर, नप्ताली अर जरदण नदी पुर्बा बाखा बाशान बस्सै दै मनिश्शे आधै गोत्रे हेस्सै मांझ़ा का। <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />लेबी गोत्रा का मरारी टोली आल़ै भेटी रूबेन, गाद अर ज़बलून गोत्रे हेस्सै आई दी ज़ैगा मांझ़ै परच़ी पाई पठी बारा नगरी। <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />इहअ करै दैनी सोभी इज़राईली लेबी गोत्रा आल़ै लै ईंयां सोभै नगरी तेता फेर-फिरदी घैहणीं संघी कि तिंयां तेथ बस्से। <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />लेबीए बांडै दैनी ईंयां सोभै नगरी बिधाता सेटा परच़ी पाई अर यहूदा, शमौन अर बिन्यामीन गोत्रे हेस्सै का बी दैनी तिन्‍नां एही ई परच़ी पाई बांड।<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />कहाती टोली मांझ़ै भेटी थोल़ै एप्रैम गोत्रे हेस्सै मांझ़ा का नगरी बांडै। <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />तिंयां नगरी थिई एप्रैम गोत्रे हेस्सै आऐ दै धारा बाखे मुल्खै शरण नगरी शकेम, गज़ेर, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />जोकमाम, बेथ-हारोन, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अजालोन अर गात-रमोन नगरी अर इना सोभी नगरी फेर-फिरदी घैहणीं बी भेटी तेता संघै। <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />जरदण नदी पछ़मा बाखा बस्सै दै मनिश्शे आधै गोत्रे बांडै ज़ुंण ज़ैगा ती आई दी, तेता मांझ़ै आई तिन्‍नां अनेर अर बिलेम नगरी तेते फेर-फिरदी घैहणीं संघी बच़ै दै कहाती टोलीए बांडै।<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />जरदण नदी पुर्बा बाखा बस्सै दै मनिश्शे आधै गोत्रे हेस्सै आई दी नगरी मांझ़ा का भेटी गर्शोनी टोली आल़ै दूई नगरी तेते फेर-फिरदी घैहणीं संघी, बाशान मुल्खै गोलान अर अशतरोत नगरी।<verse eid="1CH 6:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="1CH 6:72" />इस्साकार गोत्रे हेस्सै मांझ़ा का भेटी तिन्‍नां कादेश, दाबरत, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोत अर आनीम नगरी तेते फेर-फिरदी घैहणीं संघी।<verse eid="1CH 6:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="1CH 6:74" />आशेर गोत्रे हेस्सै मांझ़ा का भेटी तिन्‍नां माशाल, अबदोन, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हुकोक अर रहोब नगरी तेता फेर फिरदी घैहणीं संघी।<verse eid="1CH 6:75" /></para>
  <para style="p">
    <verse number="76" style="v" sid="1CH 6:76" />नप्ताली गोत्रे हेस्सै मांझ़ा का भेटी तिन्‍नां गलील मुल्खै कादेश, हामोन अर किर्यातैम नगरी तेते फेर-फिरदी घैहणीं संघी।<verse eid="1CH 6:76" /></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />तेखअ ज़ुण मरारी टोली मांझ़ै रहै, तिन्‍नां लै दैनी ईंयां नगरी:</para>
  <para style="p" vid="1CH 6:77">ज़बलून गोत्रे हेस्सै मांझ़ा का दैनी तिन्‍नां लै रमोन अर तबोर नगरी तेते फेर-फिरदी घैहणीं संघी।<verse eid="1CH 6:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="1CH 6:78" />जरदण नदी पुर्बा बाखा जेरिहो नगरी नेल़ दैनी तिन्‍नां लै रूबेन गोत्रे हेस्सै मांझ़ा का रेगीस्तानै बेसेर, जहास, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />कदमोत अर मेपात नगरी तेते फेर-फिरदी घैहणीं संघी।<verse eid="1CH 6:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="1CH 6:80" />गाद गोत्रे हेस्सै मांझ़ा का दैनी तिन्‍नां लै गलाद मुल्खै रामोत, माहानीम, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेशबोन अर ज़जार नगरी तेते फेर-फिरदी घैहणीं संघी।<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">इस्साकारे आद-लुआद</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साकारे तै च़ार शोहरू: तोला, पूआ, जशूब अर शिम्रोन।<verse eid="1CH 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2" />तोला का हुऐ आजू छ़ह शोहरू: ऊज्जी, रपाया, जरीएल, जहमी, ईबसाम अर शमूएल। ईंयां तै आपणीं-आपणीं टोलीए मूल़ अर ईंयां तै आपणैं ज़मानै मशूर जोधै। ज़धू राज़ै दाबेदे ज़मानै गणांई हुई, तधू तै ईंयां बाई हज़ार छ़ह शौ।<verse eid="1CH 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3" />ऊज्जीओ थिअ एक शोहरू तेऊ नाअं त ईजराह। ईजराहे तै आजू च़ार शोहरू: मिकाईल, ओबेदियो, जोएल अर इशिया। ईंयां तै आपणैं-आपणैं खिंबे मूल़। <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />इनै ती खास्सी बेटल़ी आणी दी अर शोहरू-माठै बी थिऐ इने खास्सै। तैही निखल़ै इने आद-लुआदा मांझ़ै सैना लै छत्ती हज़ार मर्ध।<verse eid="1CH 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5" />इस्साकार गोत्रे सोभी टोली मांझ़ै निखल़ै आपणैं-आपणैं खिंबा का पठी स्तास्सी हज़ार मर्ध ज़ुंण सैना दी डेऊई जुध सका तै करी।<verse eid="1CH 7:5" /></para>
  <para style="s">बिन्यामीन अर दान गोत्रे आद-लुआद</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />बिन्यामीने तै चअन शोहरू: बेला, बेकेर अर जदीएल।<verse eid="1CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 7:7" />बेला का हुऐ आजू पांज़ शोहरू: एसबोन, ऊज्जी, उज्जीएल, जरमोत अर ईरा। ईंयां तै सोभै आपणीं-आपणीं टोलीए मूल़ मणछ अर ईंयां तै सोभै शूरबीर जोधै। इने आद-लुआदा मांझ़ै निखल़ै बाई हज़ार चऊती मर्ध ज़ुंण सैना दी डेऊई जुध सका तै करी।<verse eid="1CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8" />बेकेरे तै नौ शोहरू: ज़मीरा, जोआश, एलीआजर, एलोनाई, ओमरी, जरमोत, अबियाह, अनातोत अर अलमेथ। <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />इने आद-लुआदा मांझ़ै निखल़ै आपणैं-आपणैं खिंबा का पठी बिह हज़ार दूई शौ मर्ध ज़ुंण सैना दी डेऊई जुध सका तै करी।<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />जदीएलो त बिल्हान नाओं एक शोहरू हुअ द। बिल्हाने तै आजू सात शोहरू: जेऊश, बिन्यामीन, एहूद, कनानाह, जतान, तरशीश अर आहीशहार। <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />ईंयां तै आपणीं-आपणीं टोलीए मूल़ अर सोभै तै मशूर जोधै। इने आद-लुआदा मांझ़ै निखल़ै पठी सतारा हज़ार दूई शौ मर्ध ज़ुंण सैना दी डेऊई जुध सका तै करी। <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />ईरा थिअ शुप्पी अर हुप्पीओ बाब।</para>
  <para style="p" vid="1CH 7:12">दानो त एक शोहरू तेऊ नाअं त हूशीम।<verse eid="1CH 7:12" /></para>
  <para style="s">नप्तालीए आद-लुआद</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />नप्तालीए थिऐ च़ार शोहरू: जसेल, गूणी, ज़जार अर शलूम। दान अर नप्ताली थिऐ याकबे बेटल़ी बिल्हा का हुऐ दै।<verse eid="1CH 7:13" /></para>
  <para style="s">जरदण पछ़मा बाखा बस्सै दै मनिश्शे आद-लुआद</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />मनिश्शे ती अराम देशा का एक बेटल़ी डाही दी, तैहा का हुऐ तेऊए दूई शोहरू अजरीएल अर माकीर ज़ुंण गलादो बाब थिअ। <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />माकीरै दैनी बिन्यामीन गोत्रे शुप्पी-हुप्पी लै लाल़ी लोल़ी ज़सरी बैहण माकाहा थिई। माकीरो दुजअ शोहरू त सलफोद अर तेऊए ती सिधी पांज़ शोहरी।<verse eid="1CH 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 7:16" />माकीरै त माकाहा संघै बैह किअ द अर तैहा का हुऐ तेऊए दूई होर शोहरू तिन्‍नां नाअं डाहअ तिन्‍नैं परेश अर सरेश। परेशे तै दूई शोहरू ऊलाम अर रकेम। <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />ऊलामो त एक शोहरू तेऊओ नाअं त बदान। ईंयां सोभै गण्हिंआं मनिश्शे पोचै माकीरे शोहरू गलादे आद-लुआदा संघै।<verse eid="1CH 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 7:18" />गलादे ती एक बैहण बी, तैहा नाअं त हामोलकेत अर तेसे तै चअन शोहरू: इशोद, एबीएजेर अर मेहला। <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />शमीदे थिऐ च़ार शोहरू: आहीआन, शकेम, लिखी अर आनीअम।<verse eid="1CH 7:19" /></para>
  <para style="s">एप्रैमे आद-लुआद</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />एप्रैमे आद-लुआद ती बाबा का आजू शोहरू पोस्ती दर पोस्ती एही: एप्रैम, शतूलेह, बेरेद, ताहात, एलीदा, ताहात, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />जाबाद अर शतूलेह। एप्रैमे तै शतूलेहा बाद दूई होर शोहरू एजेर अर एलाद, तिंयां पाऐ तै गात नगरीए लोगै मारी किल्हैकि तिंयां डेऊऐ तै तिन्‍नें डागै-चैणें हेल़्ही लुटदै। <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />तिन्‍नें बाब एप्रैमा पल़अ त तिन्‍नां मरनै पिछ़ू खास्सै धैल़ै तैणीं शोग अर तेऊए भाई-बंध आऐ तै तेऊ चिंजदै अर हैअ दैंदै। <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />तेखअ डेऊअ सह आपणीं बेटल़ी सेटा भिई संघा हुई सह सुंदी अर तैहा का हुअ एक होर शोहरू तेऊ नाअं डाहअ तिन्‍नैं बरीया<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="fq" closed="false">बरीया </char><char style="ft" closed="false">इब्रानी बोली दी मतलब आफ़त</char></note>, कि तिन्‍नां लै पल़ी ती आफ़त।<verse eid="1CH 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24" />एप्रैमे ती एक शोहरी बी, तैहा नाअं त शीरा। तैहा च़िणैं तै उंधलै बेथ-हारोन, उझलै बेथ-हारोन अर ऊजेन-शीरा नगरी फेर-फिरदै गहल़।<verse eid="1CH 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 7:25" />एप्रैमो त रेपा नाओं एक होर शोहरू तेऊए आद-लुआद ती बाबा का आजू शोहरू पोस्ती-दर पोस्ती एही: रेसेप, तेलाह, ताहान, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />लादान, अमीहूद, एलीशामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />नून, ज़ैहसू।<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />एप्रैमे आद-लुआद तै बेतेल सारै मुल्खै, पुर्बा बाखा नारान अर गज़ेर नगरी तैणीं बस्सै दै। ईंयां तै एथ सोभी गराऊंऐं, शकेम अर आया नगरी अर तेथ संघी सोभी गराऊंऐं बस्सै दै।<verse eid="1CH 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 7:29" />मनिश्शे गोत्रे आद-लुआद बस्सी बेथ-शान, तनाक, मगिदो, दोर अर तेता ओरी-पोरी सोभी गराऊंऐं।</para>
  <para style="p" vid="1CH 7:29">ईंयां एतरी आसा तिंयां ज़ैगा ज़िधी इज़राईले शोहरू युसुफे आद-लुआद बस्सी।<verse eid="1CH 7:29" /></para>
  <para style="s">आशेरे आद-लुआद</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />आशेरे तै च़ार शोहरू एक शोहरी: इमना, इशबा, ईशबी अर बरीया। शोहरी नाअं त सेराह।<verse eid="1CH 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 7:31" />बरीये थिऐ दूई शोहरू हुऐ दै: हेबेर अर मोल्कीएल ज़ुंण बर्जातो बाब थिअ।<verse eid="1CH 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 7:32" />हेबेरे तै चअन शोहरू अर एक शोहरी हुई दी: जपलेत, शोमेर, होताम अर तिन्‍नें बैहण शूआ।<verse eid="1CH 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 7:33" />जपलेते बी थिऐ चअन शोहरू हुऐ दै: पासाक, बिमहाल अर अशबात।<verse eid="1CH 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 7:34" />जपलेते कान्हैं भाई शमेरे थिऐ च़ार शोहरू: आही, रोहगा, जेहूबा अर अराम।<verse eid="1CH 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 7:35" />हेबेरे शोहरू हेलेमे<note caller="+" style="f"><char style="fr" closed="false">7:35 </char><char style="fq" closed="false">हेलेमे </char><char style="ft" closed="false">होताम</char></note> बी थिऐ च़ार शोहरू हुऐ दै: सोपाह, इमना, शेलेश अर अमाल।<verse eid="1CH 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CH 7:36" />सोपाहे शोहरू आसा तै: सूह, हरनेपर, शूआल़, बेरी, इमरा, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, शामा, शिलशा, इतरान अर बेरा।<verse eid="1CH 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 7:38" />जतेरे शोहरू आसा तै: यपुन्‍नें, पिसपा अर अरा। <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />ऊले शोहरू आसा तै: आराह, हनिएल अर रिसया।<verse eid="1CH 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40" />ईंयां सोभै थिऐ आशेरे आजू आद-लुआद। तिंयां थिऐ आपणीं-आपणीं टोली अर खिंबे सैणैं, मूल़ अर मशूर जोधै। आशेरे गोत्रा का निखल़ै तै पठी छब्बी हज़ार मर्ध ज़ुंण सैना दी जुध सका तै करी।<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">बिन्यामीने होर आद-लुआद</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />बिन्यामीने तै पांज़ शोहरू ज़ेठै का कान्हैं तैणीं ईंयां: बेला, अशबेल, अहारा, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />नोहा अर रापा।<verse eid="1CH 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 8:3" />बेले आद-लुआद तै ईंयां: अदार, गेरा, अबिहूद, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीशू, नामान, अहोह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, शपूपान अर हूराम।<verse eid="1CH 8:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1CH 8:6-7" />एहूदे आद-लुआद नामान, आहिजा अर गेरा थिऐ तिन्‍नें मूल़ ज़ुंण गिबा नगरी थिऐ बस्सै दै। पर तिंयां काढै तिधा का पोर्ही संघा बसाऊऐ मनाहत नगरी। तिन्‍नां गलामी दी पाणै आल़अ थिअ उज्ज़ा अर आहीहूदो बाब।<verse eid="1CH 8:6-7" /></para>
  <para style="p">
    <verse number="8-9" style="v" sid="1CH 8:8-9" />शहरैमै दैनी आपणीं दूई बेटल़ी हूशीम अर बारा छ़ाडी। बादा का बस्सअ सह मोआब देशै अर तिधी किअ तेऊ होदेश नाओंए बेटल़ी संघै बैह अर तैहा का हुऐ तेऊए सात शोहरू: जोबाब, ज़िबिया, मेशा, मलकाम, <verse eid="1CH 8:8-9" /><verse number="10" style="v" sid="1CH 8:10" />जेऊज़, साक्या अर मिर्मा। ईंयां सोभै हुऐ आपणैं-आपणैं खिंबे मूल़ मणछ।<verse eid="1CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 8:11" />शहरैमे तै तेऊए लाल़ी हूशीमा का दूई शोहरू हुऐ दै: अबितूब अर एलपाल।<verse eid="1CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 8:12" />एलपाले तै आजू चअन शोहरू हुऐ दै: एबेर, मिशाम अर शमेद। सह थिअ शमेद ज़ुंणीं ओनो, लूद नगरी अर तेता ओरी-पोरी गराअं बसाऊऐ।<verse eid="1CH 8:12" /></para>
  <para style="s">बिन्यामीन गोत्रा मांझ़ै ज़ुंण गात अर अजालोन नगरी बस्सै</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13" />बरीया अर शेमा थिऐ तिन्‍नां टोलीए मूल़ ज़ुंण अजालोन नगरी थिऐ बस्सै दै। तिन्‍नैं काढै गात नगरी बस्सै दै लोग तिधा का पोर्ही। <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />बरीया का थिई आजू आद-लुआद ईंयां: आहीऊ, शशाक, जरमोत, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबदीया, अराद, एदेर <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मिकाईल, ईशपा अर जोहा।<verse eid="1CH 8:16" /></para>
  <para style="s">बिन्यामीन गोत्रा मांझ़ै ज़ुंण एरुशलेम तै बस्सै दै</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 8:17" />एलपाले आद-लुआद थिई आजू: जबदीया, मशूलाम, हिजकी, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />ईशमेरी, इजलिया अर जोबाब।<verse eid="1CH 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 8:19" />शिमीए आद-लुआद आसा तै: जाकीम, ज़िक्री, जबदी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />एलीनाई, ज़िलेताई, एलीएल, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदाया, बराया अर शिम्रात।<verse eid="1CH 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 8:22" />शशाके आद-लुआद आसा तै: इशपान, एबेर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अबदोन, ज़िक्री, हनान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हनन्याह, एलाम, अनातोत, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />इपदेया अर पनूएल।<verse eid="1CH 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 8:26" />जेरोहामे आद-लुआद थिऐ शमशरी, शहर्या, अताल्या, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />जारेशिया, एलियाह अर ज़िक्री।<verse eid="1CH 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28" />ईंयां सोभै तै बिन्यामीन गोत्रा का आपणैं-आपणैं खिंब अर टोलीए मूल़ मणछ ज़ुंण एरुशलेम नगरी तै बस्सै दै।<verse eid="1CH 8:28" /></para>
  <para style="s">बिन्यामीन गोत्रा मांझ़ै ज़ुंण गबोन नगरी तै बस्सै दै</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 9:35">1 इति. 9:35</ref>
      </char>
    </note>जेइलै<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="fq" closed="false">जेइलै </char><char style="ft" closed="false">इब्रानी दी निं अह नाअं आथी पर धैअ 9:35 दी आसा लिखअ द।</char></note> बसाऊई आपणैं शोहरूए नाओंऐं गबोन नगरी संघा बस्सअ तिधी। तेऊए लाल़ी नाअं थिअ माकाहा। <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />तेऊओ ज़ेठअ शोहरू त अबदोन अर तेऊए होर शोहरू तै सूर, कीश, बाल, नेरी, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर, आहीऊ, जेकेर अर <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />मिकलोत ज़ुंण शिमेहो बाब थिअ। तिन्‍नें आद-लुआदा मांझ़ै बी तै कई एरुशलेम नगरी तिन्‍नें खिंबे होरी टोली संघै बस्सै दै।<verse eid="1CH 8:32" /></para>
  <para style="s">राज़ै शाऊले आद-लुआद</para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 8:33" />कीशे शोहरू राज़ै शाऊले तै च़ार शोहरू: जोनातान, मोलकीशूआ, अबीनादाब अर इशबशेत। <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />जोनातान थिअ मोपीबशेतो बाब अर तेऊओ शोहरू त आजू मिका।<verse eid="1CH 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 8:35" />मिके थिऐ च़ार शोहरू हुऐ दै: पिथोन, मोलक, तारअ अर अहाज। <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />अहाज त जहोयादो बाब अर तेऊए तै आजू चअन शोहरू: एलीमेथ, अज़मबेथ अर ज़िम्री। ज़िम्रीओ शोहरू त मोसा <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मोसा का हुअ बिनी, बिनी का हुअ रापा अर रापा का हुअ एलासा अर एलासो शोहरू त अजेल।<verse eid="1CH 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 8:38" />अजेले तै छ़ह शोहरू: अज्रीकाम, बोकरू, इशमाईल, शराया, ओबेदियो अर हनान। <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />बिन्यामीन गोत्रा का अजेले भाई-बंध एशेके थिऐ चअन शोहरू: ऊलाम, जेऊश अर एलीपेलेत।<verse eid="1CH 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 8:40" />ऊलामे आद-लुआद तै मशूर सपाही अर कतीर-कबाणे ज़बर ज़ाणकार। तेऊए हुऐ एक शौ पज़ाह पोचै अर पल़पोचै। ईंयां सोभै थिऐ बिन्यामीन गोत्रा का।<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />सोभै इज़राईली तै तिन्‍नें खिंबे साबै इज़राईले राज़ेए इतिहासे कताबा दी लिखी डाहै दै।</para>
  <para style="s" vid="1CH 9:1">बाबेल देशे गलामी का ज़ुंण बापस फिरै</para>
  <para style="p" vid="1CH 9:1">यहूदा मुल्खे लोग तै बाबेल देशे गलामी दी डेऊऐ दै किल्हैकि तिंयां निं बिधाता लै शुचै-पाक्‍कै रहै आथी तै। <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />ज़ुंण इज़राईली गलामी का फिरी बापस एछी आपणीं-आपणीं नगरी बस्सै, तिन्‍नां संघै आऐ प्रोहत, थोल़ै लेबी गोत्रे लोग अर बिधाते भबनै च़ाकरी करनै आल़ै। <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />यहूदा, बिन्यामीन, एप्रैम अर मनिश्शे गोत्रा मांझ़ै डेऊऐ थोल़ै एरुशलेम नगरी लै।<verse eid="1CH 9:3" /></para>
  <para style="p">
    <verse number="4-6" style="v" sid="1CH 9:4-6" />यहूदा गोत्रा का आऐ पठी छ़ह शौ नबै ज़ण्हैं आपणैं टांडै-टबरा संघी एरुशलेम नगरी लै फिरी।</para>
  <para style="li" vid="1CH 9:4-6">यहूदे शोहरू फिरिसे आद-लुआदा मांझ़ै, तिन्‍नों सैणअ त अमीहूदो शोहरू अर ओमरीओ पोचअ ऊताई। इम्री अर बैनी थिऐ तेऊए दाद-बाब।</para>
  <para style="li" vid="1CH 9:4-6">यहूदे शोहरू शेलाहे आद-लुआद, तिन्‍नों सैणअ आसा सैणअ त तिन्‍नें टबरा मांझ़ै सोभी का बडअ असाया।</para>
  <para style="li" vid="1CH 9:4-6">यहूदे शोहरू जेराहे आद-लुआद, तिन्‍नें टोलीओ सैणअ त जूएल।<verse eid="1CH 9:4-6" /></para>
  <para style="p">
    <verse number="7-8" style="v" sid="1CH 9:7-8" />बिन्यामीन गोत्रा का ज़ुंण बाबेल देशे गलामी का फिरी आऐ तिन्‍नां मांझ़ै बस्सै ईंयां एरुशलेम:</para>
  <para style="li" vid="1CH 9:7-8">मशूलामो शोहरू सल्‍लू ज़ुंण होदाबयो पोचअ अर हसोनो पल़पोचअ थिअ।</para>
  <para style="li" vid="1CH 9:7-8">जेरोहामो शोहरू इबनिजा,</para>
  <para style="li" vid="1CH 9:7-8">ऊज्जीओ शोहरू मिकरीओ पोचअ एला,</para>
  <para style="li" vid="1CH 9:7-8">शपताहो शोहरू रूएलो पोचअ अर इबनीजो पल़पोचअ मशूलाम।<verse eid="1CH 9:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 9:9" />ईंयां तै एऊ गोत्रा का इने भाई-बंधा संघी नौ शौ छफुंजा ज़ण्हैं आपणीं-आपणीं टोली अर खिंबे सैणैं ज़ुंण एरुशलेम नगरी बस्सै।<verse eid="1CH 9:9" /></para>
  <para style="s">प्रोहत ज़ुंण एरुशलेम नगरी बस्सै</para>
  <para style="p">
    <verse number="10-12" style="v" sid="1CH 9:10-12" />एरुशलेम नगरी ज़ुंण प्रोहत एरुशलेम नगरी बस्सै:</para>
  <para style="li" vid="1CH 9:10-12">जदाया, जेहोयारीब, जाकीन,</para>
  <para style="li" vid="1CH 9:10-12">हिलकियो शोहरू अजर्याह ज़ुंण एरुशलेम बिधाते भबनै कारदार ज़ुंण सोभिओ सैणअ हआ।</para>
  <para style="li" vid="1CH 9:10-12">एऊए दाद-बाब थिऐ मशूलाम<note caller="+" style="f"><char style="fr" closed="false">9:10-12 </char><char style="fq" closed="false">मशूलाम </char><char style="ft" closed="false">मशूलाम त हिलकियो बाब</char></note>, सदोक, मरयोत अर आहीतूब।</para>
  <para style="li" vid="1CH 9:10-12">जेरोहामो शोहरू अदाया। एऊए दाद-बाब थिऐ पशहूर तेऊओ बाब मलकिजा,</para>
  <para style="li" vid="1CH 9:10-12">तेऊओ बाब मासाई, तेऊओ बाब आदीएल, तेऊओ बाब जहजेरा, तेऊओ बाब त मशूलाम, तेऊओ मेशलमीत अर तेऊओ बाब थिअ इमेर।<verse eid="1CH 9:10-12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 9:13" />प्रोहत ज़ुंण आपणैं-आपणैं खिंबे सैणैं थिऐ, तिंयां थिऐ पठी एक हज़ार सात शौ शाठ ज़ण्हैं। तिंयां ज़ाणा तै तिन्‍नां सोभी कामां करी कि बिधाते भबनै किहअ-किहअ लागा करनअ।<verse eid="1CH 9:13" /></para>
  <para style="s">लेबी गोत्रा मांझ़ै होर ज़ुंण एरुशलेम बस्सै</para>
  <para style="p">
    <verse number="14-16" style="v" sid="1CH 9:14-16" />एरुशलेम नगरी लेबी गोत्रा मांझ़ै ज़ुंण होर बस्सै तिंयां थिऐ:</para>
  <para style="li" vid="1CH 9:14-16">मरारी टोली का हशूबो शोहरू, अज्रीकामो पोचअ अर हशाबियो पल़पोचअ शमयाह।</para>
  <para style="li" vid="1CH 9:14-16">बकबाकर, हेरेश अर गालाल अर असापे खिंबा का मिको शोहरू अर ज़िक्रीओ पोचअ मतानियाह।</para>
  <para style="li" vid="1CH 9:14-16">शमयाहो शोहरू, गालालो पोचअ अर जदूतूनो पोचअ ओबेदियो,</para>
  <para style="li" vid="1CH 9:14-16">आसाहो शोहरू, एलकानो पोचअ बरेक्याह ज़ुंण नतपाह नगरीए मुल्खै गराऊंआं दै थिअ बस्सअ द।<verse eid="1CH 9:14-16" /></para>
  <para style="s">बिधाते भबने पहरी ज़ुंण एरुशलेम नगरी बस्सै</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />बिधाते भबने पहरी ज़ुंण एरुशलेम नगरी आपणैं-आपणैं टांडै-टबरा संघी बस्सै तिंयां थिऐ: शलूम, अकूब, तलमोन अर आहीमान। शलूम थिअ इना सोभी प्रैंदै सैणअ। <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />तिन्‍नें टोली का रहै पोस्ती दर-पोस्ती नगरीए पुर्बा बाखा प्रऊल़ीए पहरी ज़ेसी राज़अ बिधाते भबना लै एछा त। तिन्‍नें दाद-बाब हआ तै तैहा प्रऊल़ीए पहरी ज़िधी लेबीए डेरै हआ तै।<verse eid="1CH 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19" />कोरो शोहरू, एबियासापो पोचअ शलूम अर तेऊ संघै तेऊए कोराह टोलीए भाई-बंधा लै थिई बिधाते खिम्भा बागै प्रऊल़ीए पहरै करने ज़िम्मैंबारी ज़िहै तिन्‍नें दाद-बाब बिधाते खिम्भ अर प्रऊल़ीए पहरी हआ तै। <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />एकी ज़मानै हआ त एलीआजरो शोहरू पिनहास तिन्‍नों सैणअ। तेऊ संघै थिअ बिधाता।<verse eid="1CH 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 9:21" />मशेलमियो शोहरू जकर्या बी थिअ बिधाते मेल़-ज़ोल़े खिम्भे प्रऊल़ीओ पहरी।<verse eid="1CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />प्रऊल़ी पहरी तै ईंयां पठी दूई शौ बारा ज़ण्हैं शुचै-पाक्‍कै मणछ छ़ांटै दै। इने नाअं तै इने टोली अर गराऊंए साबै लिखी डाहै दै ज़िधी-ज़िधी ईंयां थिऐ बस्सै दै। अह ज़िम्मैंबारी ती तिन्‍नां लै राज़ै दाबेद अर बिधाते गूर शमूएलै दैनी दी। <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />ईंयां अर इने आजू आद-लुआद रहै पोस्ती दर पोस्ती बारी-बारी बिधाते भबने प्रऊल़ी पहरी। <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />प्रऊल़ी थिई पुर्बा, पछ़मा, उतरा अर दखण च़ऊ दिशा बाखा अर हरेकी प्रऊल़ी दी हआ तै एक-एक प्रधान पहरी ज़ुंण कबल्‍लै तिधी रहा तै। <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />तिन्‍नें भाई-बंध ज़ुंण गराऊंऐं रहा तै, तिन्‍नां लागा त साता-साता धैल़ी तैणीं तिन्‍नां संघै बारी-बारी प्रऊल़ीए पहरै लै एछणअ। <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />तिंयां च़ार प्रधान पहरी तै लेबी मांझ़ा का शुचै-पाक्‍कै मणछ अर तिन्‍नां लै थिई होरी पहरीए अर बिधाते भबने भढारे पहरै करने ज़िम्मैंबारी सभाल़ी दी। <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />तिंयां काटा तै बिधाते भबना फेर राच किल्हैकि राची पहरै करने अर दोत्ती प्रऊल़ी घुआल़णे ज़िम्मैंबारी थिई तिन्‍नें।<verse eid="1CH 9:27" /></para>
  <para style="s">होरी लेबीए ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />होरी लेबी का थिई बिधाते भबनै पूज़ा-गाज़ा करने भांडे ज़िम्मैंबारी सभाल़ी दी। तिंयां काढा तै तेता गणी करै बागा लै अर तिहै ई डाहा तै गणी करै भढारै। <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />तिन्‍नां मांझ़ै थिई कोई लै बिधाते भबनै पूज़ा लै लागणै आल़ी च़िज़े ज़िम्मैंबारी सभाल़ी दी ज़िहअ कि पिठअ, दाखो रस, जैतूनो तेल, धूप अर होर खुशबूदार मसालै बगैरा। <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />पर खुशबूदार मसालै राल़णैंओ काम करा तै प्रोहत आप्पै।<verse eid="1CH 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 9:31" />एक त मतियाह नाओं लेबी, सह थिअ कोराह टोली का शलूमो ज़ेठअ शोहरू। सह थिअ भोज़ना बणाणें आल़ै प्रैंदै सैणअ डाहअ द। सह बी थिअ शुचअ-पाक्‍कअ मणछ। <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />तिन्‍नें भाई-बंध कहाती टोली आल़ै लै थिई हर बशैघे धैल़ी लै रोट-लुच़ी बणाणें ज़िम्मैंबारी।<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />लेबी मांझ़ै ती कोई लै गिहा बोल्दै अर साज़-बाज़ बाज़णें ज़िम्मैंबारी सभाल़ी दी इने टोलीए सैणैं रहा तै बिधाते भबनै अर इना का निं होर काम कराऊंदै तै, किल्हैकि ईंयां रहा तै धैल़-राच एऊ ई कामां लागी।<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />ईंयां सोभै थिऐ लेबी गोत्रा का अर ईंयां आसा आपणीं-आपणीं पोस्ती दी आपणीं टोलीए सैणैं अर ईंयां तै एरुशलेम बस्सै दै।<verse eid="1CH 9:34" /></para>
  <para style="s">राज़ै शाऊले दाद-बाब अर आजू आद-लुआद</para>
  <para style="r">(<ref loc="1CH 8:29-38">1 इतिहास 8:29-38</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />जेइलै बसाऊई आपणैं शोहरूए नाओंऐं गबोन नगरी संघा बस्सअ तिधी। तेऊए लाल़ी नाअं थिअ माकाहा। <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />तेऊओ ज़ेठअ शोहरू त अबदोन अर तेऊए होर शोहरू तै सूर, कीश, बाल, नेरी, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, आहीऊ, जकर्या अर <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />मिकलोत ज़ुंण शमामो बाब थिअ। तिन्‍नें आद-लुआदा मांझ़ै बी तै कई एरुशलेम नगरी तिन्‍नें खिंबे होरी टोली संघै बस्सै दै।<verse eid="1CH 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 9:39" />नेरीओ शोहरू त कीश अर कीशे शोहरू राज़ै शाऊले तै च़ार शोहरू: जोनातान, मोलकीशूआ, अबीनादाब अर इशबशेत। <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />जोनातान थिअ मोपीबशेतो बाब अर तेऊओ शोहरू त आजू मिका। <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />मिके थिऐ च़ार शोहरू हुऐ दै: पिथोन, मोलक, ताहरी अर अहाज। <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />अहाज त जाराहो बाब अर तेऊए तै आजू चअन शोहरू: एलीमेथ, अज़मबेथ अर ज़िम्री। ज़िम्रीओ शोहरू त मोसा <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />मोसा का हुअ बिनी, बिनी का हुअ रपाया अर रपाया का हुअ एलासा अर एलासो शोहरू त अजेल।<verse eid="1CH 9:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 9:44" />अजेले तै छ़ह शोहरू: अज्रीकाम, बोकरू, इशमाईल, शराया, ओबेदियो अर हनान।<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">राज़ै शाऊले मौत</para>
  <para style="r">(<ref loc="1SA 31:1-13">1 शमूएल 31:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />पलिश्ती किअ इज़राईली संघै गिलबा नाओंए धारा मकाबलअ। तिधी पाऐ पलिश्ती कई इज़राईली मारी। बाकी ज़ुंण बच़ै, तिंयां ठुर्है तिधा का राज़ै शाऊल अर तेऊए शोहरू संघी दूर। <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />पर पलिश्ती निं शाऊल अर तेऊए शोहरूओ पिछ़अ छ़ाडअ, पलिश्ती पाऐ शाऊले चअन शोहरू जोनातान, अबीनादाब अर मोलकीशूआ मारी। <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />राज़ै शाऊला फेर लागअ घणअ जुध अर तेऊ लै खुभै दुशमणे कतीर, तेता करै हुअ सह खास्सअ ज़खमी। <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />तेखअ बोलअ शाऊलै आपणैं अस्त्र-शास्त्रा ढोणै आल़ै लै, “तूह खिंच़ आपणीं तलबार संघा मार मुंह आप्पै! इहअ निं हआ कि ईंयां पलिश्ती ज़सरअ खतैर निं हंदअ हुअ द, तलबार मेरी देही आर-पार करी मुंह मारे! तेखअ हणअ हुंह सुहांगा लै!” पर सह ज़ुआन मणछ डरअ खास्सअ संघा किअ तेऊ मारना लै नांह। तेखअ काढी शाऊलै आपणीं तलबार संघा किई धरनीं खल़ी अर तेखअ दैनअ ज़ोरै तेते च़ुंज़ी प्रैंदा लै जुंघू। <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />ज़ांऊं तेऊ अस्त्र-शस्त्रा ढोणै आल़ै ज़ुआन मणछै भाल़अ कि शाऊल गअ मरी, तेऊ बी दैनअ शाऊला ई ज़िहअ आपणीं तलबार खल़ी करी तेथ प्रैंदै जुंघू संघा मूंअ तिधी राज़ै शाऊला संघै। <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />इहअ करै मूंऐं शाऊल, तेऊए चअन शोहरू अर तेऊए लुआद पठी ज़ुंण आजू तेऊ बाद राज़ सका तै करी। <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />ज़ुंण इज़राईली जज्रेल खागै जरदण नदीए दुजै बाढै थिऐ, ज़ांऊं तिन्‍नां का इहअ थोघ लागअ कि इज़राईली सैना ठुर्ही जुधा का, शाऊल अर तेऊए शोहरू बी पाऐ पलिश्ती मारी, तिंयां ठुर्है तेखअ आपणीं-आपणीं नगरी छ़ाडी। तेखअ आऐ पिछ़ू पलिश्ती संघा गिम्मी तिंयां नगरी आप्पू लै।<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />दुजै धैल़ै ज़ांऊं पलिश्ती मारै दै इज़राईलीए माला लुटदै आऐ, तिन्‍नां भेटी शाऊल अर तेऊए चिई शोहरूए ल्हासा गिलबा धारा पल़ी दी। <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />तिन्‍नैं काटअ शाऊलो मूंड, तेऊए अस्त्र-शस्त्र बी लुटै, संघा छ़ाडै तिन्‍नैं सारै पलिश्ती देशै दूत कि ऐहा खुशीए खबरा खोज़ा सोभी देअए देहुरै अर सोभी आम लोगा का। <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />तेखअ डाहै तिन्‍नैं शाऊले अस्त्र-शस्त्र आपणैं देहुरै अर तेऊओ मूंड डाहअ आपणैं दगोन देअए देहुरै छ़ड़ाऊई। <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />ज़ांऊं गलाद मुल्खे जबेश नगरीए लोगा का इहअ थोघ लागअ कि पलिश्ती किअ शाऊला संघै इहअ-इहअ, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />तिन्‍नें शूरबीर डेऊऐ राचो-राच, संघा आणी शाऊल अर तेऊए शोहरूए ल्हासा जबेश नगरी लै। तिधी डाहै तिन्‍नैं शाऊल अर तेऊए शोहरूए ल्हासा दहई करै तिन्‍नें हाडकै एकी महरूए बूटा हेठै दाबी, संघा मनाऊंअ तिन्‍नैं साता धैल़ै तैणीं कहतू रही शोग।<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />शाऊल मूंअ किल्हैकि तेऊ किअ बिधाता लै विश्वास घात। तेऊ निं ज़िहअ बिधाता बोलअ तिहअ हुकम मनअ अर सह रहअ बिधाता छ़ाडी डांऊं-च़ेल्‍लै अर मणशाण झ़ैऊंणै आल़ै पुछ़दअ लागी। <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />तैही दैनअ बिधाता तेऊ मरनै अर तेऊए ज़ैगा बणाअं ईशैईओ शोहरू दाबेद इज़राईल मुल्खो राज़अ।<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">दाबेद बणअ सारै इज़राईलो राज़अ</para>
  <para style="r">(<ref loc="2SA 5:1-10">2 शमूएल 5:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />इज़राईले सोभ गोत्र हुऐ हेब्रोन नगरी दाबेदा सेटा कठा संघा लागै तेऊ लै बोल्दै, “हाम्हैं सोभै आसा एकी हाड-खिंबे। <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />ज़धू शाऊल राज़अ त, तधू बी थिअ जुधे बगती इज़राईली लै सोभी का आजू तूह ई अर बिधाता आसा ताल्है इहअ बोलअ द, ‘मेरी परज़ा इज़राईलीओ फुआल अर तिन्‍नां प्रैंदै राज़अ हणअ तूह ई।’” <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />हेब्रोन तैहा सभा दी किई इज़राईली सोभी सैणैं अर दाबेदै आप्पू मांझ़ै करार अर बिधाता डाहअ तेतो शाजत। तेखअ किअ इज़राईली सैणैं दाबेदे मुंडै जैतूनो तेल तरैल़ी अभिषेक अर दाबेद बणअ इज़राईलीओ राज़अ ज़िहअ बिधाता आपणैं गूर शमूएला का पैहलै ई त बोली हेरअ द।<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />राज़ै दाबेद अर सोभी इज़राईली छ़ेल़अ एरुशलेम नगरी संघै जुध। तेऊ ज़मानै बोला तै तैहा नगरी लै जबेश नगरी किल्हैकि तैहा ज़ैगे मूल़ बशिंदै तै जबेशी अर तिंयां थिऐ तेऊ ज़मानै बी तिधी बस्सै दै। <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />जबेशी बोलअ दाबेदा लै इहअ, “तूह निं म्हारी नगरी भितरी कधि एछी सकदअ!” पर दाबेदै ज़ितअ तिन्‍नों सियोन नाओं गहल़ अर तेता नाअं आसा आझ़ तैणीं बी दाबेदपूर पल़अ द। <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />दाबेदै बोलअ आपणीं सैना लै इहअ, “ज़ुंण इना जबेशी मारी एछे, सह बणाणअं मुंह सैनापति!” जोआब ज़सरी ईजा नाअं सरूयाह थिअ, सह डेऊअ सैना संघी जुधा लै आजू संघा बणअ सह इज़राईली सैनो सैनापति। <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />सियोन गहल़ा गिम्मी बस्सअ दाबेद तिधी अर तैहा नगरी नाअं पल़अ, “दाबेद नगरी।” <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />तेऊ बणाअं तैहा नगरी फेर भिई धारे पुर्बा बाखा बढेरी करै बडअ गहल़ अर बाकी सारी नगरी भिई च़िणनेओ काम किअ जोआबै पूरअ। <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />दाबेद रहअ बलबान अर मशूर हंदअ लागी किल्हैकि स्वर्गे सारी सैने मालक बिधाता ज़हा का सारअ बल आसा सह थिअ तेऊ संघा।<verse eid="1CH 11:9" /></para>
  <para style="s">राज़ै दाबेदे मशूर जोधै</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 शमूएल 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />ज़िहअ बिधाता पैहलै ई त बोली हेरअ द कि दाबेद बणनअ राज़अ अर ऐहा गल्‍ला पूरी हणां लै दैनअ सोभी इज़राईली दाबेदो साथ। राज़ै दाबेदे सैना दी थिऐ ईंयां मशूर जोधै:<verse eid="1CH 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 11:11" />एक जोधअ थिअ राज़ै दाबेदो हाकमोनी टोली का जाशोबीम ज़ुंण चिई दले सरदारा प्रैंदै दलपति थिअ। तेऊ मारै तै एकी जुधा लै आपणैं बर्छ़ै करै दुशमणे चअन शौ सपाही। <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />दुजअ मशूर जोधअ थिअ दाबेदे चिई जोधै मांझ़ै अहोह टोली का दोदैओ शोहरू एलीआजर। <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />एकी बारी तै पलिश्ती जुधा लै दमीम खागै झाल़्हुऐ दै ज़िधी ज़ौओ खेच थिअ, दाबेदै बोलअ पलिश्ती लै ज़ै तम्हैं तिहै फिरा तै एछा हाम्हां संघै मकाबलै लै! ज़ै कि होर इज़राईली तै गऐ दै जुधा करनै का पिछ़ू ठुर्ही! <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />पर एलीआजर अर तेऊए आदमी रहै पलिश्ती संघै मकाबलै करदै लागी। तैहा धैल़ी दैनी ती बिधाता तेऊ अर इज़राईला लै बडी ज़ीत।<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />एकी धैल़ै डेऊऐ तिहा-तिहा जोधै प्रैंदै चअन दलपति अदुलाम डुआरा नेल़ तैहा बडी टोल्हा सेटा ज़िधी दाबेद थिअ अर पलिश्ती तै रपाईम खागै डेरै पाऐ दै। <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />दाबेद त उझै धारा गहल़ै अर पलिश्ती सैने एकी दलै किअ बेतलेम नगरी कबज़अ। <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />दाबेदा फिरी घरकी आद संघा बोलअ, “तै भाल़ किहअ हणअ त ज़ै कुंण बेतलेम नगरीए प्रऊल़ी सेटे कुहै का मुल्है झुटणा लै पाणीं दैंदअ आणी!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />तिंयां चअन मशूर जोधै डेऊऐ पलिश्ती डेरै बाती, संघा आणअ बेतलेम नगरीए प्रऊल़ी सेटे कुहै का पाणीं भरी राज़ै दाबेदा सेटा। पर तेऊ निं सह पाणीं झुटअ अर तेऊ दैनअ तेऊ पाणीं करै बिधाता लै अर्घअ! <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />संघा बोलअ इहअ, “हे बिधाता, अह निं एता झुटी सकदअ! अह हणअ तिन्‍नां मणछे लोहू झुटणैं ज़िहअ ज़ुंणीं एता मुल्है आणना लै आपणीं ज़िन्दगी बी पाई खातरै दी।” तेखअ निं दाबेदै सह पाणीं झुटअ।</para>
  <para style="p" vid="1CH 11:19">इना चिई मशूर जोधे तै इहै हिम्मती आल़ै काम।<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />जोआब अर तेऊए भाई अबीशे ईज थिई सरूयाह। अबीशै थिअ तिन्‍नां तिहा जोधै प्रैंदै प्रधान अर मशूर जोधअ। एकी जुधा लै मारै तै तेऊ एकी ज़ण्हैं आपणैं बर्छ़ै करै चअन शौ दुशमण संघा हुअ तिहा जोधै मांझ़ै तेऊओ नाअं मशूर। <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />सह हुअ इहअ मशूर कि तेखअ बणाअं सह तिन्‍नां ई तिहा मशूर जोधैओ दलपति। पर अज़ी बी निं सह खास चिई जोधै ज़िहअ मशूर हुअ त।<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />कबसेल नगरी का थिअ जहोयादो शोहरू बेनियाह मशूर सपाही, तेऊ किऐ बडै-बडै नुआहरै काम। एकी बारी पाऐ तै तेऊ मोआबीए सोभी का तगल़ै जोधै मारी। सह होथअ हिंऊंदै उंधै एकी जुहल़ी लै संघा पाअ एक बडअ सिह मारी। <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />एकी बारी मारअ तेऊ मिसर देशो एक सात फुट लाम्मअ दैंत्तर जोधअ। मिसर देशे तेऊ जोधे हाथै थिअ राछ़े लाठै ज़िहअ एक बर्छ़अ, पर बेनियाह डेऊअ तेऊए मकाबलै करदअ शोठी पाई संघा छ़ड़ैऊअ तेऊए ई हाथा का बर्छ़अ संघा पाअ सह तेता ई करै मारी। <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />जहोयादे शोहरू बेनियाह किऐ इहै-इहै ज़बर काम। खास चिई जोधै मांझ़ै ता निं तेऊ ज़ैगा भेटी <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />पर सह थिअ खास तिह जोधै जैंदरी मशूर। दाबेदै बणाअं सह तेखअ आपणीं फाज़त करनै आल़ै शूर-बीरो दलपति।<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />राज़ै दाबेदे मशूर जोधै तै ईंयां:</para>
  <para style="li" vid="1CH 11:26">जोआबो भाई असाहेल,</para>
  <para style="li" vid="1CH 11:26">बेतलेम नगरीए दोदो शोहरू एलहान,<verse eid="1CH 11:26" /></para>
  <para style="li">
    <verse number="27" style="v" sid="1CH 11:27" />हारोरा का शमोत अर एलिका,</para>
  <para style="li" vid="1CH 11:27">पेलोन नगरी का हेलेस,<verse eid="1CH 11:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="1CH 11:28" />तकोआ नगरी का इकेशो शोहरू ईरा,</para>
  <para style="li" vid="1CH 11:28">अनातोत नगरी का एबीएजेर,<verse eid="1CH 11:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="1CH 11:29" />हुशाई नगरी का सिबकै,</para>
  <para style="li" vid="1CH 11:29">अहोह नगरी का ईलाई,<verse eid="1CH 11:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="1CH 11:30" />नतपाह नगरी का महरै</para>
  <para style="li" vid="1CH 11:30">नतपाह ई नगरी का एक होर बानाहो शोहरू हेलेद<verse eid="1CH 11:30" /></para>
  <para style="li">
    <verse number="31" style="v" sid="1CH 11:31" />बिन्यामीन मुल्खे गिबा नगरी का रिबैओ शोहरू ईताई</para>
  <para style="li" vid="1CH 11:31">पिरातोन नगरी का बेनियाह,<verse eid="1CH 11:31" /></para>
  <para style="li">
    <verse number="32" style="v" sid="1CH 11:32" />गाश धारे गाडा नेल़ रहणैं आल़अ हूराई,</para>
  <para style="li" vid="1CH 11:32">बेथ-अराबा का एबीएल,<verse eid="1CH 11:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="1CH 11:33" />बहूरीम नगरी का अज़मबेथ</para>
  <para style="li" vid="1CH 11:33">एलीआबा का शालबोनी<verse eid="1CH 11:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="1CH 11:34" />हाशेमे खिंबा का थिऐ गज़ोन नगरीओ जोनातान</para>
  <para style="li" vid="1CH 11:34">हरार नगरी का शागी,<verse eid="1CH 11:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="1CH 11:35" />साकारो शोहरू आहीआम,</para>
  <para style="li" vid="1CH 11:35">ऊरो शोहरू हरारो शोहरू एलीपाल,<verse eid="1CH 11:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="1CH 11:36" />मकात नगरी का हेपेर</para>
  <para style="li" vid="1CH 11:36">पेलोन नगरी का आहिजा,<verse eid="1CH 11:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="1CH 11:37" />कर्मेल नगरी का हेस्रो,</para>
  <para style="li" vid="1CH 11:37">अजाबीओ शोहरू नाराई,<verse eid="1CH 11:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="1CH 11:38" />नातानो भाई जोएल,</para>
  <para style="li" vid="1CH 11:38">हागारीओ शोहरू मिभार<verse eid="1CH 11:38" /></para>
  <para style="li">
    <verse number="39" style="v" sid="1CH 11:39" />अमोन नगरी का सेलेक,</para>
  <para style="li" vid="1CH 11:39">बरोत नगरी का नहारी सह थिअ सरूयाहे शोहरू जोआबे अस्त्र-शस्त्रा ढोणै आल़अ।<verse eid="1CH 11:39" /></para>
  <para style="li">
    <verse number="40" style="v" sid="1CH 11:40" />इतेरा नगरी का ईरा अर गारेब<verse eid="1CH 11:40" /></para>
  <para style="li">
    <verse number="41" style="v" sid="1CH 11:41" />हित्ती उरियाह</para>
  <para style="li" vid="1CH 11:41">अहलाईओ शोहरू जाबाद।<verse eid="1CH 11:41" /></para>
  <para style="li">
    <verse number="42" style="v" sid="1CH 11:42" />रूबेन गोत्रा का शिजो शोहरू अदीना, सह थिअ तिहा जोधै प्रैंदै दलपति।<verse eid="1CH 11:42" /></para>
  <para style="li">
    <verse number="43" style="v" sid="1CH 11:43" />माको शोहरू हनान,</para>
  <para style="li" vid="1CH 11:43">मतान नगरी का जोशापात<verse eid="1CH 11:43" /></para>
  <para style="li">
    <verse number="44" style="v" sid="1CH 11:44" />अशतरोत नगरी का उज़ियाह,</para>
  <para style="li" vid="1CH 11:44">अरोर नगरी का होतामे शोहरू शामा अर जेइल।<verse eid="1CH 11:44" /></para>
  <para style="li">
    <verse number="45" style="v" sid="1CH 11:45" />शिम्रीओ शोहरू जदीएल,</para>
  <para style="li" vid="1CH 11:45">तीज़ नगरी का जोहा अर तेऊओ भाऊ।<verse eid="1CH 11:45" /></para>
  <para style="li">
    <verse number="46" style="v" sid="1CH 11:46" />महावा का एलीएल,</para>
  <para style="li" vid="1CH 11:46">एलनामे शोहरू जरबाई अर जोशबा,</para>
  <para style="li" vid="1CH 11:46">मोआबा का ईतमा,<verse eid="1CH 11:46" /></para>
  <para style="li">
    <verse number="47" style="v" sid="1CH 11:47" />एलीएल अर ओबेद,</para>
  <para style="li" vid="1CH 11:47">जोबाह का जासीएल।<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">दाबेदे सैना दी ज़ुंण होर जोधै ज़ुल़ै</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />दाबेद त कीशे शोहरू राज़ै शाऊले डरै ठुर्ही सकाल़ग नगरी पुजअ द। तिधी ज़ुल़ै तेऊ संघै कई जोधै ज़ुंणीं जुधा लै तेऊओ साथ दैनअ। <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />बिन्यामीन गोत्र ज़ेता का राज़अ शाऊल बी थिअ, तिन्‍नां मांझ़ै ज़ुल़ै तिंयां शूरबीर ज़ुंण दोहरै हाथै कतीर-कबाण अर फर्णैक्‍की ज़ाणा तै बाही। <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />इने दलपति थिऐ गिबा नगरी का शमाहो शोहरू आहीजेर अर तेऊ बाद तेऊओ भाऊ जोआश। तिन्‍नां बाद होर जोधै आसा तै:</para>
  <para style="li" vid="1CH 12:3">अज़मबेथे शोहरू जजेल अर पलेत,</para>
  <para style="li" vid="1CH 12:3">बराका,</para>
  <para style="li" vid="1CH 12:3">अनातोता का जेहू<verse eid="1CH 12:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="1CH 12:4" />गबोन नगरी का इशमाया ज़ुंण तिहा जोधै मांझ़ै मशूर जोधअ अर सैणअ थिअ।</para>
  <para style="li" vid="1CH 12:4">गदेरा नगरी का जेरमयाह, जाहजील, जोहनान अर जोजबाद।<verse eid="1CH 12:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="1CH 12:5" />हारूप नगरी का एलुजी, जरमोत, बिल्या, शेमारीया अर शपताह।<verse eid="1CH 12:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="1CH 12:6" />कोराह टोली का एलकाना, इशिया, अजरेल, जोएजर अर जाशोबीम।<verse eid="1CH 12:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="1CH 12:7" />गदोर नगरी का जेरोहामे शोहरू जोएला अर जबदीया।<verse eid="1CH 12:7" /></para>
  <para style="s">गाद गोत्रा का ज़ुंण जोधै दाबेदा संघै ज़ुल़ै</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />ज़धू दाबेद रेगीस्तानै गहल़ै रहा त, तधू ज़ुल़ै गाद गोत्रा मांझ़ै जुधा लै मनै-तनै दै मशूर जोधै। तिंयां थिऐ ढाल़, बर्छ़ै च़लाऊंदै लै मशूर अर मुंहां का फ्रिशिआ तै तिंयां सिहा ज़िहै अर ठुहर्दै थिऐ तिंयां धारे हरना ज़िहै छ़ल़ैघ। तिंयां थिऐ पठी गैरा ज़ण्हैं:<verse eid="1CH 12:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="1CH 12:9" />एजेर त तिन्‍नां सोभी प्रैंदै सैणअ,</para>
  <para style="li" vid="1CH 12:9">तेऊ बाद त ओबेदियो,</para>
  <para style="li" vid="1CH 12:9">चिऊथअ त एलीआब,<verse eid="1CH 12:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="1CH 12:10" />च़ौथअ त मिशमन्‍ना,</para>
  <para style="li" vid="1CH 12:10">पांज़ूअ त जेरमयाह,<verse eid="1CH 12:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="1CH 12:11" />छ़हुअ त अताई,</para>
  <para style="li" vid="1CH 12:11">सातुअ थिअ एलीएल,<verse eid="1CH 12:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="1CH 12:12" />आठुअ थिअ जोहनान,</para>
  <para style="li" vid="1CH 12:12">नहुअ एलजाबाद,<verse eid="1CH 12:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="1CH 12:13" />दसुअ जेरमयाह अर</para>
  <para style="li" vid="1CH 12:13">मकबानी थिअ गैर्हुअ।<verse eid="1CH 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />गाद गोत्रा का तै ईंयां खास-खास जोधै अर ईंयां सोभै तै सोभै आपणैं-आपणैं दले दलपति। इना मांझ़ै ज़ुंण सोभी का होछ़ै दलो दलपति त शौआ शूरबीरा प्रैंदै अर सोभी का बडै दलो दलपति त एक हज़ार शूरबीरा प्रैंदै। <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />ईंयां तै तिंयां जोधै ज़ुंणीं च़ैत्रै ज़ेभै जरदण नदी भर्हुई दी हआ ती, तेभै पार टपी संघा काढै तेथ दोहरै बाढै सऊंऐं मुल्खै बस्सै दै लोग दरल़ाऊई।<verse eid="1CH 12:15" /></para>
  <para style="s">बिन्यामीन अर यहूदा गोत्रा का ज़ुंण दाबेदा संघै ज़ुल़ै</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />एकी बारी डेऊअ बिन्यामीन अर यहूदा गोत्रो एक दल गहल़ा लै ज़िधी दाबेद थिअ। <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />दाबेद बी निखल़अ तिन्‍नां सेटा लै मिलदअ संघा बोलअ तिन्‍नां लै, “ज़ै तम्हैं मेरै साथ दैंदै आऐ, तै रहा इधी, संघा ज़ुल़ा हाम्हां संघै। पर ज़ै थारै दिलै इहअ आसा कि हुंह बझ़ैल़णअ तम्हां मेरै दुशमणा का ढाकणैं, तै लोल़ी थारै दादा-बाबे तेऊ परमेशरै तम्हां लै आप्पै सज़ा दैनी, किल्हैकि मंऐं निं थारी किछ़ हान्‍नी किई।”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />ज़ुंण दाबेदा सेटा लै थिऐ आऐ दै, तिन्‍नां आदमी संघै त अमासा बी ज़ुंण बादा का तिहा शूरबीरा प्रैंदै दलपति बणअ। तेऊ दी आई बिधाते पबित्र आत्मां संघा लागअ सह इहअ बोल्दअ,</para>
  <para style="q" vid="1CH 12:18">“दाबेद, ईशैई शोहरूआ, हाम्हैं आसा दिला का ताह संघै,</para>
  <para style="q" vid="1CH 12:18">तूह अर तेरअ साथ दैणैं आल़ै हणैं सदा सफल,</para>
  <para style="q" vid="1CH 12:18">किल्हैकि ताह बाखा जुध करनै आल़अ आसा बिधाता आप्पै।”</para>
  <para style="p" vid="1CH 12:18">दाबेदै किअ तिन्‍नों खूब अदर संघा डाहै तिंयां आप्पू संघै अर तिंयां बणाऐं तेऊ एकी-एकी दले सैणैं।<verse eid="1CH 12:18" /></para>
  <para style="s">मनिश्शे गोत्रा का ज़ुंण दाबेदा संघै ज़ुल़ै</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />मनिश्शे गोत्रा का ज़ुल़ै थोल़ै शूरबीर दाबेदा संघै। ईंयां आऐ तै तधू दाबेदा सेटा लै ठुर्ही ज़धू तेऊ इज़राईले राज़ै शाऊला संघै जुध करना लै पलिश्ती राज़े सैना बाखा जुध करना लै हाँ किअ त। पर पलिश्ती राज़ै निं दाबेद अर तेऊए आदमी आप्पू संघै जुधा लै एछणैं दैनअ। पलिश्ती राज़ै तै ऐहा गल्‍ला का डरै दै कि दाबेद सका तिन्‍नां लै धोखअ करी अर आपणैं पराणैं मालक शाऊला खुश करना लै सका सह हाम्हां ई मारी! तेखअ छ़ाडअ तिन्‍नैं दाबेद तेऊए आदमी संघी सकाल़ग नगरी लै बापस। <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />दाबेद त सकाल़ग नगरी लै बापस एछदअ लागअ द अर मनिश्शे गोत्रा मांझ़ै आऐ तै थोल़ै शूरबीर दाबेदे साथ दैंदै, तिंयां थिऐ: अदना, जोजबाद, जदीएल, मिकाईल, जोजबाद, एलीहू अर सिलताई। ईंयां सोभ थिऐ हज़ार-हज़ार सपाहीए दला प्रैंदै दलपति अर <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />ईंयां तै ज़बर शूरबीर अर दाबेदै बणाऐं ईंयां बादा का आपणीं सैना दी एकी-एकी दले दलपति। ज़ेभै बी दुशमण जुध छ़ेल़ा तै, ईंयां करा तै दाबेदा बाखा जुध। बादा का बणै ईंयां दाबेदे सैना दी दलपति। <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />हर धैल़ै रहा त दाबेदा संघै कुंण नां कुंण दाबेदे सैना दी ज़ुल़दअ लागी अर इहअ करै हुई दाबेदे सैना परमेशरे सैना ज़ेही खास्सी अर बलबान।<verse eid="1CH 12:22" /></para>
  <para style="s">दाबेदे पठी सैना</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />ज़धू दाबेद हेब्रोन नगरी थिअ, तेऊए सैना दी ज़ुल़ै खास्सै जुध बिद्ये मशूर शूरबीर। तिन्‍नैं दैनअ दाबेदो साथ कि सह शाऊले ज़ैगा राज़अ बणें, ज़िहअ बिधाता पैहलै ई त बोली डाहअ द कि इहअ हणअ। तिंयां थिऐ हर गोत्रा का गणी करै पठी एतरै:<verse eid="1CH 12:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="1CH 12:24" />यहूदा गोत्रा का थिऐ, छ़ह हज़ार आठ शौ ढाल़ अर बर्छ़ै संघै जुध करनै आल़ै जोधै।<verse eid="1CH 12:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="1CH 12:25" />शमौन गोत्रा का थिऐ सात हज़ार एक शौ शूरबीर।<verse eid="1CH 12:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="1CH 12:26" />लेबी गोत्रा का थिऐ च़ार हज़ार छ़ह शौ जोधै। <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />हारणे खिंबा का थिऐ चअन हज़ार सात शौ आऐ दै, तिन्‍नां प्रैंदै सैणअ थिअ जहोयादा। <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />तिन्‍नां संघै आअ सदोक नाओं एक ज़ुआन जोधअ अर तेऊ संघै आऐ तेऊए टोली का बाई ज़ण्हैं ज़ुंण आपणैं-आपणैं दले सैणैं थिऐ।<verse eid="1CH 12:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="1CH 12:29" />बिन्यामीन गोत्रा का आऐ राज़ै शाऊले भाई-बंधा मांझ़ै चअन हज़ार जोधै। बाकी बिन्यामीन गोत्रे रहै सोभ शाऊले पक्षा लै तेऊओ साथ दैंदै लागी।<verse eid="1CH 12:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="1CH 12:30" />एप्रैम गोत्रा का आऐ बिह हज़ार आठ शौ जोधै ज़ुंण आपणीं-आपणीं टोली दी मनै-तनै दै थिऐ।<verse eid="1CH 12:30" /></para>
  <para style="li">
    <verse number="31" style="v" sid="1CH 12:31" />जरदण नदी पछ़मा बाखा बस्सै दै मनिश्शे आधै गोत्रा मांझ़ै आऐ छ़ांटी करै ठारा हज़ार मर्ध कि तिंयां दाबेदा राज़ै बणाणां लै साथ दैए।<verse eid="1CH 12:31" /></para>
  <para style="li">
    <verse number="32" style="v" sid="1CH 12:32" />इस्साकार गोत्रा का आऐ दूई शौ सैणैं आपणैं सोभी भाई-बंधा संघी। ईंयां मणछ हेरा तै समझ़ी कि बगत किज़ै बोल बोला अर केऊ बगती किज़ै लागा करनअ।<verse eid="1CH 12:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="1CH 12:33" />ज़बलून गोत्रा का आऐ पज़ाह हज़ार जुध बिद्या लै मशूर अर तिंयां ज़ाणा तै कई रंगे अस्त्र-शस्त्र च़लाऊई।<verse eid="1CH 12:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="1CH 12:34" />नप्ताली गोत्रा का आऐ एक हज़ार सैणैं अर सैईंती हज़ार जोधै ज़ुंण ढाल़ अर बर्छ़ै करै जुध करना लै मशूर थिऐ।<verse eid="1CH 12:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="1CH 12:35" />दान गोत्रा का आऐ ठाई हज़ार छ़ह शौ शूरबीर।<verse eid="1CH 12:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="1CH 12:36" />आशेर गोत्रा का आऐ च़ाल़्ही हज़ार जुध बिद्ये ज़ाणकार जोधै।<verse eid="1CH 12:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="1CH 12:37" />इज़राईली मांझ़ै जरदण नदी पुर्बा बाखा बस्सै दै रूबेन, गाद अर मनिश्शे आधै गोत्रा मांझ़ै आऐ एक लाख बिह हज़ार अस्त्र-शस्त्रा च़लाऊंणैं आल़ै मशूर जोधै।<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />ईंयां सोभै शूरबीर तै जुधा लै तैर। ईंयां आऐ हेब्रोन नगरी कि दाबेदा इज़राईली प्रैंदै राज़अ बणांए। इना का लाऊआ बाकी इज़राईली बी च़ाहा तै इहअ ई कि दाबेद ई लोल़ी राज़अ बणअ। <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />तिंयां रहै हेब्रोन नगरी दाबेदा सेटा चिई धैल़ै तैणीं खांदै-पिंदै लागी। किल्हैकि तिधी ती तिन्‍नें भाई-बंधै तिन्‍नां लै धामा लाई दी। <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />होर इज़राईली बी आऐ दूरा-दूरा का ज़ुंण इस्साकार, ज़बलून अर नप्ताली गोत्रे मुल्खै तैणीं बी रहा तै, तिन्‍नैं आणी आपणैं गाधै, ऊँट, खच़रा, बल्दा प्रैंदै ज़िणस लादी। तेथ आणै तिन्‍नैं, पिठअ, फेडू अर दाखे टिक्‍की, दाखो रस अर जैतूनो तेल। शिखा लै आणी तिन्‍नैं होर भेडा-बाकरी अर पशूए हेल़्ही। किल्हैकि इज़राईल देशै तै सोभ खुश हुऐ दै।<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">बिधाते करारो मणशू आणअ एरुशलेम नगरी लै</para>
  <para style="r">(<ref loc="2SA 6:1-11">2 शमूएल 6:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />राज़ै दाबेदै शादै सैनापति अर खास-खास शूरबीर ज़ुंण शौ-शौ अर हज़ार-हज़ारे दला प्रैंदै दलपति थिऐ। <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />तेखअ बोलअ तैहा सभा दी दाबेदै इहअ, “ज़ै थारी ज़ाज़त आसा, ज़ै म्हारअ परमेशर बिधाता बी इहअ ई च़ाहा होए, तै खोज़ा एऊ समादा प्रोहत, लेबी गोत्रा आल़ै ज़ुंण तिन्‍नें नगरी अर घैहणीं आसा बस्सै दै अर सारै देशै सोभी इज़राईली का। तिन्‍नां लै बोला इहअ कि सोभ लोल़ी आऐ अर इधी करनअ हाम्हां बडअ झाल़अ। <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />तेखअ डेऊणअ हाम्हां बिधाते करारो मणशू आणदै, ज़ुंण राज़ै शाऊले राज़ा दी नकदरअ आसा किअ द।” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />सभा दी बेठै दै सोभ लोग हुऐ ऐहा गल्‍ला लै राज्ज़ी कि इहअ ई करनअ आसा ठीक।<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />दाबेदै किऐ मिसर देशे दखणा बाखा शिहोर गाडा ओर्ही उतरा बाखा हमात नगरी तैणीं सोभ इज़राईली कठा कि तिंयां किर्यात-ज़रीम नगरी का बिधाते करारो मणशू आणे। <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />तेखअ डेऊऐ दाबेद अर तेऊ संघै आऐ दै सोभ इज़राईली यहूदा मुल्खै बाला नगरी ज़ेता लै किर्यात-ज़रीम बी बोला, बिधाते करारे मणशू बापस आणदै ज़सरअ आसन फैंखा आल़ै स्वर्ग दूता प्रैंदै आसा। <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />तिन्‍नैं बशैल़अ बिधाते करारो मणशू कोरी बैल गाड्डी दी संघा आणअ अबीनादाबे घअरा का आप्पू संघै। उज्ज़ा अर आहीऊ लागै बैल गाड्डी आजू नढैऊंदै। <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दाबेद अर तिधी आऐ दै होर सोभ इज़राईली लागै बिधातो अदर करना लै गिहा बोल्दै अर नाच़दै। तिंयां थिऐ कैलीए काठा करै बणाऐं दै बींन, बशूरी, ढोल नगारै, गुझू अर डफाला बाज़ी नाच़दै लागै दै।<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />ज़ांऊं तिंयां कदोन नाओंए मणछे खहल़ै पुजै, तिधी लागी बल्दा ठोहल़ अर उज्ज़ा दैनी बिधाते करारे मणशू आपणैं हाथा करै थम्हणीं कि ढूल़अ निं लोल़ी। <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />तेऊ लै पल़अ तेभी बिधातो कोप अर सह मूंअ तिधी हेरा-हेरी करारे मणशू सेटा किल्हैकि तेऊ लाअ त आपणअ हाथ करारे मणशू दी। इहअ करै मूंअ उज्ज़ा तिधी बिधाता सम्हनै धरनीं। <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />दाबेद हुअ खास्सअ नराज़ किल्हैकि बिधातो कोप पल़अ उज्ज़ा लै, तिधा का बोला तैहा ज़ैगा लै आझ़ तैणीं बी फिरिस-उज्ज़ा।<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />तधू डरअ दाबेद बिधाता का खास्सअ संघा लागअ इहअ बोल्दअ, “ऐबै मुंह बिधाते करारो मणशू आप्पू संघै किहअ करै निंणअ?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />तेखअ निं दाबेदै बिधाते करारो मणशू दाबेदपूर नगरी लै निंयं आथी अर सह फिरअ तिधा का गात नगरीए ओबेद-एदोमे घअरा बाखा लै संघा पजैल़अ करारो मणशू तिधी। <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />तिधी रहअ बिधाते करारो मणशू चिई भिन्‍नैं तैणीं अर बिधाता दैनी ओबेद-एदोम अर तेऊए टबरा लै खास्सी बर्गत।<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">एरुशलेम नगरी राज़ै दाबेदो मैहल</para>
  <para style="r">(<ref loc="2SA 5:11-16">2 शमूएल 5:11-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />सूर नगरीए राज़ै हिरामै छ़ाडै आपणैं कार-करिंदै राज़ै दाबेदा सेटा लै। आप्पू संघै आणै तिन्‍नैं काठे अर पात्थरे कारीगीर अर राज़ै दाबेदो मैहल बणाणां लै केल़ुईए काठ। <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />तेखअ हेरअ दाबेदै ज़ाणीं कि बिधाता किअ इज़राईली प्रैंदै तेऊओ राज़ पाक्‍कअ अर आपणीं परज़ा इज़राईलीए तैणीं बढेरअ बिधाता तेऊओ राज़।<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />हेब्रोन नगरी का एरुशलेम एछी डाही दाबेदै आप्पू लै होर बी बेटल़ी अर तेऊए हुऐ होर बी खास्सै शोहरू-शोहरी। <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />एरुशलेम हुऐ तेऊए ईंयां शोहरू: शम्मू, शोबाब, नातान, सुलैमान, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />ईभार, एलीशू, एलपेलेत, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगह, नपेग, ज़ापी, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />एलीशामा, बेल्यादा अर एलीपेलेत।<verse eid="1CH 14:7" /></para>
  <para style="s">राज़ै दाबेदे पलिश्ती प्रैंदै ज़ीत</para>
  <para style="r">(<ref loc="2SA 5:17-25">2 शमूएल 5:17-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />पलिश्ती का गअ थोघ लागी कि दाबेद बणअ सारै इज़राईला प्रैंदै राज़अ। तिन्‍नैं डाही आपणीं सैना दाबेदा ढाकणा लै छ़ाडी। ज़ांऊं दाबेदा का ऐहा गल्‍लो थोघ लागअ, सह निखल़अ तिन्‍नें मकाबलै करदअ। <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />पलिश्ती आऐ रपाईम खागै संघा गिम्मी सह सारी ज़ैगा। <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />दाबेदै पुछ़अ बिधाता, “हुंह पलिश्ती संघै मकाबलै लै डेऊं? ताह मुल्है तिन्‍नां का ज़ीत दैणीं?”</para>
  <para style="p" vid="1CH 14:10">बिधाता दैनअ ज़बाब, “हाँ, डेऊ, मुंह हेरनअ तूह तिन्‍नां का ज़ताऊई!”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />तेखअ डेऊअ दाबेद बाल-परज़ीम अर तिधी पाऐ तेऊ पलिश्ती मारी। दाबेदै बोलअ इहअ, “ज़िहअ पाणीं बडै रोक्‍कै चोल़ा, तिहै ई चोल़ै बिधाता मुंह करै मेरै दुशमण।” तैही डाहअ तेऊ तैहा ज़ैगा नाअं बाल-परज़ीम <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />बच़ै दै पलिश्ती ठुर्है तिधा का अर तिन्‍नां का छ़ुटै तिन्‍नें देअआ-देबीए मैहरै तेथै अर दाबेदै दैनअ तेता लै हुकम कि इना सोभी पाआ आगी जैंदरी दहई।<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />तेखअ गऐ थोल़ै धैल़ै बाद पलिश्ती भिई रपाईम खागा लै एछी संघा गिम्मी सह ज़ैगा भिई। <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />तेखअ डेऊअ दाबेद भिई बिधाता पुछ़दअ, “हुंह पलिश्ती संघै मकाबलै लै स्मोहरअ डेऊं?” बिधाता बोलअ तेऊ लै इहअ, “तिन्‍नें मकाबलै लै निं स्मोहरअ डेऊई, तूह मार तिन्‍नां लै घेरअ संघा रहअ बलसामे बूटा नेल़ तिन्‍नां लै ताखुई। <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />ज़ांऊं तूह बलसामे बूटा जैंदरी सैना हांढणे छ़ेल़ शुणें, सह हणअ ताल्है नछ़ैण कि हुंह बिधाता आसा पलिश्ती संघै जुधा लै ताह आजू-आजू आप्पै लागअ त हांढदअ, तिधी पल़ै तम्हैं तिन्‍नां लै नभैऊशै चुटी!” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />ज़िहअ बिधाता हुकम किअ, दाबेदै किअ तिहअ ई अर पलिश्ती दरल़ाऊऐ तिन्‍नैं मारदी-मारदी गबोन नगरी पोर्ही गज़ेर नगरी तैणीं।<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />इहअ करै हुअ राज़अ दाबेद सारै दी मशूर अर बिधाता किअ इहअ कि सोभ देश लागै दाबेदा का डरदै।<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">करारे मणशू एरुशलेम आणने तैरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />राज़ै दाबेदै बणाऐं आप्पू लै एरुशलेम नगरी कई मैहल अर भबन। तेऊ डाही तिधी छ़ांटी करै बिधाते करारे मणशू लै बी ज़ैगा संघा किअ तिधी खास खिम्भ खल़अ। <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />तेखअ बोलअ राज़ै दाबेदै इहअ, “लेबी का सुआई निं होर कोहै बिधाते करारो मणशू च़की, किल्हैकि बिधाता आसा तिंयां ई छ़ांटै दै कि तिंयां एऊ कामां करे अर सदा तेऊए च़ाकरी करे। <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />तेखअ किअ राज़ै दाबेदै एरुशलेम नगरी इज़राईलीओ बडअ झाल़अ कि बिधातो करारो मणशू आणनअ तैहा ज़ैगा लै ज़ुंण तेऊ छ़ांटी करै ज़ुदी आसा डाही दी बणाईं।” <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />तेखअ शादै राज़ै दाबेदै हारणे आद-लुआद अर होर लेबी। <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />लेबी गोत्रे टोली मांझ़ै ज़ुंण तिधी आऐ, तिंयां थिऐ कहाती टोली का एक शौ बिह ज़ण्हैं अर तिन्‍नां प्रैंदै सैणअ थिअ ऊरीएल। <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />मरारी टोली का आऐ दूई शौ बिह ज़ण्हैं अर तिन्‍नां प्रैंदै सैणअ थिअ असाया। <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />गर्शोनी टोली का आऐ एक शौ तिह ज़ण्हैं अर तिन्‍नां प्रैंदै सैणअ थिअ जोएल। <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />एलीसापान टोली मांझ़ै आऐ दूई शौ अर तिन्‍नों सैणअ थिअ शमयाह। <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />हेब्रोनी टोली का आऐ अश्शी ज़ण्हैं अर तिन्‍नों सैणअ थिअ एलीएल। <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />उज्जीएले टोली मांझ़ा का आऐ एक शौ बारा ज़ण्हैं अर तिन्‍नों सैणअ थिअ अमीनादाब।<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />राज़ै दाबेदै शादै सदोक प्रोहत, अबतार अर लेबी मांझ़ै छ़ह सैणैं ऊरीएल, असाया, जोएल, शमयाह, एलीएल अर अमीनादाब। <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />तेखअ बोलअ तिन्‍नां लै इहअ, “तम्हैं आसा लेबी गोत्रा मांझ़ै आपणीं-आपणीं टोलीए सैणैं। तम्हैं करा आप्पू अर आपणैं भाई-बंधा शुचै, संघा आणा इज़राईले परमेशर बिधातो करारो मणशू तैहा ज़ैगा लै ज़ुंण मंऐं तेता लै आसा डाही दी बणाईं। <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />किल्हैकि पिछ़ली बारी निं तम्हैं तेता च़कदै आथी तै अर म्हारै परमेशर बिधाता दैनी हाम्हां लै तेते सज़ा कि हाम्हैं निं सह काम तैहा बिधीए साबै किअ ज़िहअ हुअ लोल़ी त।”<verse eid="1CH 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 15:14" />तेखअ हुऐ सोभ प्रोहत अर लेबी च़ांगै-च़ोखै कि इज़राईले परमेशर बिधातो करारो मणशू आणी सके। <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />लेबी च़कअ करारो मणशू लोहल़ी लाई करै आपणीं कान्हा प्रैंदै ज़िहअ बिधाता आपणैं गूर मोसा बाती खोज़ी बोली त डाहअ द।<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />राज़ै दाबेदै किअ लेबी मांझ़ै सोभी सैणैं लै हुकम कि गाज़ै-बाज़ै आल़ैओ एक छ़ुंढ छ़ांटा ज़ुंण, दंतारै, बींन, छ़छ़ाल़ा बाज़दी ज़ोरै-ज़ोरै खुशीए गिहा बोल्दै होए। <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />लेबी सैणैं छ़ांटअ मरारी टोली का जोएलो शोहरू हमान तेऊए होरी साथी-संघी। बरेक्याहो शोहरू असाप अर कुशायो शोहरू एतान। <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />तिन्‍नां पिछ़ू गिहा बोल्दै छ़ांटै तिन्‍नें भाई-बंधा मांझ़ै: जकर्या, बेन, जाजीएल, शमीरामोत, जेहीएल, ऊनी, एलीआब, बेनियाह, मासेया, मत्तितियाह, एलीपलेह, मिकनेया अर ओबेद-एदोम अर जेइल ज़ुंण करारे मणशूए फाज़त करनै आल़ै पहरी थिऐ।<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />हमान, असाप अर एतान छ़ांटै कांस्से छ़छ़ाल़ा बाज़दै। <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />जकर्या अजीएल, शमीरामोत, जेहीएल ऊनी, एलीआब, मासेया अर बेनियाह छ़ांटै कि तिंयां अलमोत नाओंए रागा दी दंतारअ बाज़े। <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />मत्तितियाह, एलीपलेह, मिकनेया अर ओबेद-एदोम, जेइल अर अजाया छ़ांटै बींना बाज़दै।<verse eid="1CH 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 15:22" />कननया त लेबी मांझ़ै सैणअ, राग-बाज़ा दी सज़ाण कलाकार। सह छ़ांटअ तिन्‍नें सोभी घैरी अर साज़-बाज़ बाज़णैं आल़ै प्रैंदै प्रधान।<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23-24" style="v" sid="1CH 15:23-24" />तेखअ छ़ांटै लेबी ओबेद-एदोम अर जेइला संघै बिधाते करारे मणशूए फाज़त करनै आल़ै दूई होर पहरी बरेक्याह अर एलकाना।</para>
  <para style="p" vid="1CH 15:23-24">शेबानयाह, जोशापात, नतनेल, अमासा, जकर्या, बेनियाह, एलीआजर, ईंयां सोभै तै प्रोहत। ईंयां लागै करारे मणशू आजू-आजू नर्शिंगै बाज़दी-बाज़दी हांढदै। ओबेद-एदोम अर जेहीया थिऐ करारे मणशूए पहरी।<verse eid="1CH 15:23-24" /></para>
  <para style="s">बिधाते करारो मणशू आणअ एरुशलेम नगरी लै</para>
  <para style="r">(<ref loc="2SA 6:12-22">2 शमूएल 6:12-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />तेखअ डेऊऐ राज़अ दाबेद, इज़राईली सैणैं अर सैने सैनापति अर दलपति ओबेद-एदोमे घअरा लै बिधाते करारे मणशू आणदै अर तिन्‍नें मनाऊंईं तैहा खुशी बडी जाच। <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />तिन्‍नैं किऐ तिधी सात बाछ़ू अर सात गाभू बल़ीदान कि लेबी ज़ुंण बिधाते करारे मणशू च़कदै आसा लागै दै, तिन्‍नां बिधाता राज्ज़ी-राम्बल़ै डाहे। <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />राज़ै दाबेदै त किम्मती बाछो च़ोल़अ बान्हअ द, तिहै ई च़ोल़ै थिऐ गाज़ै-बाज़ै आल़ै अर तिन्‍नां प्रैंदै प्रधान कननया, करारे मणशू च़कणै आल़ै लेबी बान्हैं दै। दाबेदै थिई बाछे सदरी बी बान्हीं दी। <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />इहअ करै आणअ दाबेदै अर होरी सोभी इज़राईली बिधाते करारो मणशू ज़ै-ज़ैकार करदी, नर्शिंगै, छ़छ़ाल़ा, बींन बाज़दी अर खुशी-खुशी गांदी-बज़ांदी एरुशलेम नगरी लै।<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />ज़ांऊं बिधाते करारो मणशू दाबेदपूर नगरी बाखा लै एछदअ त लागअ द, राज़ै शाऊले शोहरी मिकल ती तीरू बाती बागै दाबेदा नाच़दै-खेल्हदै भाल़ी लागी दी, तैहा समझ़अ दाबेदो सह तिहअ करनअ बृथा।<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />तेखअ डाहअ बिधाते करारो मणशू तैहा ज़ैगा तेऊ खिम्भा भितरी ज़ुंण ज़ैगा राज़ै दाबेदै ती डाही दी बणाईं। संघा किऐ तिन्‍नैं बिधाता लै हूम अर मेल़-ज़ोल़े बल़ीदान। <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />ज़ांऊं राज़अ दाबेद हूम अर बल़ीदान करी मुक्‍कअ, तेखअ दैनी तेऊ बिधाते नाओंऐं सारी परज़ा लै बर्गत। <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />संघा बांडी तेऊ इज़राईली सोभी लोगा लै रोटी। तेऊ दैनी मर्ध-बेटल़ी संघी एक-एक रोटी भोज़न, एक-एक शिखे टांक अर एक-एक दाखे टिक्‍की।<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />तेखअ डाहै राज़ै दाबेदै लेबी मांझ़ै छ़ांटी करै करारे मणशूए च़ाकरी करदै। तिन्‍नों काम त तिधी साज़-बाज़ अर गिहा बोली इज़राईले परमेशर बिधाते ज़ै-ज़ैकार करनअ। <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />तिन्‍नां सोभी प्रैंदै सैणअ डाहअ असाप, तेऊ संघै दुजअ डाहअ जकर्या। तिन्‍नां संघै होर तै जीए, शमीरामोत, जेहीएल, मतियाह, एलीआब, बेनियाह, ओबेद-एदोम अर जेइल बींना बाज़दै। असाप बाज़ा त छ़छ़ाल़ा दी राग। <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बेनियाह अर जहजीएल दूई प्रोहत रहा तै बिधाते करारे मणशू आजू कबल्‍लै नर्शिंगै बाज़दै लागी। <verse eid="1CH 16:6" /><verse number="7" style="v" sid="1CH 16:7" />अह त पैहली बारी ज़धू राज़ै दाबेदै असाप अर होरी लेबी लै बिधाते ज़ै-ज़ैकार अर शूकर करने ज़िम्मैंबारी सभाल़ी।<verse eid="1CH 16:7" /></para>
  <para style="s">बिधातो शूकर करना लै राज़ै दाबेदो भज़न</para>
  <para style="r">(<ref loc="PSA 105:1-15">भज़न 105:1-15</ref>; <ref loc="PSA 96:1-13">96:1-13</ref>; <ref loc="PSA 106:1">106:1</ref>,<ref loc="PSA 106:47">47</ref>,<ref loc="PSA 106:48">48</ref>)</para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />बिधातो करा शूकर अर सोभी का खोज़ा कि सह किहअ महान आसा,</para>
  <para style="q" vid="1CH 16:8">देशा-देशे लोगा का खोज़ा कि तेऊ किज़ै-किज़ै आसा किअ द।<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />बिधाते ज़ै-ज़ैकार करना लै बोला गिहा!</para>
  <para style="q" vid="1CH 16:9">तेऊ ज़ुंण महान नुआहरै काम किऐ, तेता खोज़ा सोभी का।<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />खुश हआ कि हाम्हैं आसा तेऊ बिधाते।</para>
  <para style="q" vid="1CH 16:10">तेऊए सोभै भगत रहा नंद।<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />मज़त मांगा बिधाता का,</para>
  <para style="q" vid="1CH 16:11">कबल्‍लै रहणअ तेऊए ज़ै-ज़ैकार करदै लागी।<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12-13" style="v" sid="1CH 16:12-13" />याकबे लुआद तम्हैं ज़ुंण तेऊए च़ाकरी करा,</para>
  <para style="q" vid="1CH 16:12-13">इज़राईले लुआद, ज़ुंण तेऊ छ़ांटै दै आसा,</para>
  <para style="q" vid="1CH 16:12-13">तम्हैं करा तिन्‍नां च़मत्कारा आद ज़ुंण तेऊ रहैऊऐ,</para>
  <para style="q" vid="1CH 16:12-13">तेता बी करा आद ज़ुंण तेऊ नसाफ किअ।<verse eid="1CH 16:12-13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />सह बिधाता ई आसा म्हारअ परमेशर,</para>
  <para style="q" vid="1CH 16:14">तेऊओ नसाफ आसा सारै संसारा लै।<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />सह डाहा आपणीं करार सदा लै अटल़,</para>
  <para style="q" vid="1CH 16:15">ज़ुंण तेऊ ज़बान दैनी, सह रहा हज़ारो पोस्ती तैणीं।<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />ज़ुंण करार तेऊ आबराम, इसहाका संघै किई अर</para>
  <para style="q" vid="1CH 16:16">ज़ुंण ज़बान तेऊ याकबा लै दैनी सह आसा अटल़।<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />बिधाता दैनअ याकबे आद-लुआदा लै बधान,</para>
  <para style="q" vid="1CH 16:17">इज़राईली संघै किई तेऊ अटल़ करार।<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />तेऊ बोलअ त इहअ, “मुंह दैणीं तम्हां लै कनान देशे ज़ैगा,</para>
  <para style="q" vid="1CH 16:18">तैहा ज़ैगे मालक हणैं तम्हैं सदा लै।”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />तधू तै तिंयां परमेशरे लोग धख ज़िहै मणछ,</para>
  <para style="q" vid="1CH 16:19">अर कनान देशै तै तिंयां पाखलै।<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />तिंयां रहा तै देशै-देशै हांढदै लागी,</para>
  <para style="q" vid="1CH 16:20">एकी मुल्खा का दुजै मुल्खै।<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />पर बिधाता निं तिन्‍नां कोही मणछा हंतणैं दैनअ,</para>
  <para style="q" vid="1CH 16:21">तिन्‍नें फाज़त करना लै नैरा त बिधाता राज़ै इहअ बोली,<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />“मेरी छ़ांटी दी परज़ा निं छ़ुंहीं छ़ेल़ी आथी,</para>
  <para style="q" vid="1CH 16:22">नां मेरै गूरा लै हान्‍नी करी।”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />संसारे सोभै लोग बोला बिधाते गिह!</para>
  <para style="q" vid="1CH 16:23">तेऊ हेरै हाम्हैं बच़ाऊई, एऊ खुशीए समादा खोज़ा धैल़ सोभी का।<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />होरी देशा का बी खोज़ा ऐहा गल्‍ला कि बिधातो प्रतप्प किहअ आसा अर</para>
  <para style="q" vid="1CH 16:24">इहअ कि तेऊए काम किहै महान आसा।<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />बिधाता आसा इहअ महान कि तेऊए स्तोती लागा करनी ई।</para>
  <para style="q" vid="1CH 16:25">सह आसा परमेशर एक्‍कै अर हाम्हां लागा तेऊओ सोभी देअआ का खास्सअ अदर करनअ।<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />होरी देशे देअ-देबी आसा सिधी मुहुर्ती,</para>
  <para style="q" vid="1CH 16:26">पर सह आसा बिधाता ई ज़ुंणी सारअ भ्रमंड आसा बणाअं द।<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />तेऊ फेर आसा अदर अर प्रतप्प,</para>
  <para style="q" vid="1CH 16:27">तेऊए पबित्र ज़ैगा आसा बल अर शोभा करै भरी।<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />पृथूई दी करा सोभी देशे लोग तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="1CH 16:28">ऐहा गल्‍ला मना सोभै कि बिधाता आसा महान अर सोभी का बलबान।<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />पृथूईए सोभ लोग करा बिधाते ज़ै-ज़ैकार, एता जोगी आसा सह ई।</para>
  <para style="q" vid="1CH 16:29">सोभ एछा भैंट लई तेऊए दुआरै।</para>
  <para style="q" vid="1CH 16:29">ज़ेभै सह पबित्र प्रगट होए तेऊ महान अर पबित्र बिधाता सेटा टेक्‍का माथअ,<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />तेऊए डरै लोल़ी पृथूई दी सोभै झ़ील़ै-काम्बै!</para>
  <para style="q" vid="1CH 16:30">पृथूई आसा बिधाता एकी ज़ैगा टकैल़ी डाही दी, सह निं च़ुक्‍कदी आथी,<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />पृथूई अर सरग हुऐ खुश!</para>
  <para style="q" vid="1CH 16:31">देशा-देशे लोगा का खोज़ा इहअ, “बिधाता आसा माहा राज़अ!<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />समुंदर अर तेते सोभी च़िज़ा लाई क्रुंगा,</para>
  <para style="q" vid="1CH 16:32">ज़ैगा-ज़िम्मीं अर तेते सोभ गल्‍ला लागी नंद अर<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />बण-बूट लागै ज़ै-ज़ैकार करदै</para>
  <para style="q" vid="1CH 16:33">ज़ांऊं बिधाता आप्पै धरती दी राज़ करदअ एछणअ।<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />बिधातो करा शूकर किल्हैकि सह आसा भलअ</para>
  <para style="q" vid="1CH 16:34">सह झ़ूरा हाम्हां लै सदा।<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />तेऊ सेटा करा एही अरज़,</para>
  <para style="q" vid="1CH 16:35">‘हे म्हारै परमेशर बिधाता, हाम्हां बच़ाऊ,</para>
  <para style="q" vid="1CH 16:35">हाम्हां पजैल़ देशा-देशा का झाल़ी करै बापस,</para>
  <para style="q" vid="1CH 16:35">ताकि हाम्हैं तेरअ शूकर करी सके अर</para>
  <para style="q" vid="1CH 16:35">तेरै पबित्र नाओंए ज़ै-ज़ैकार करी सके।’<verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />इज़राईले परमेशर बिधाते करा ज़ै-ज़ैकार!</para>
  <para style="q" vid="1CH 16:36">तेऊए करा आझ़ा पोर्ही सदा ज़ै-ज़ैकार!</para>
  <para style="q" vid="1CH 16:36">सोभै बोला, ‘एवमस्तू!’ बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई।”<verse eid="1CH 16:36" /></para>
  <para style="s">एरुशलेम अर गबोन बिधाते पूज़ा-गाज़ा</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />राज़ै दाबेदै सभाल़ी असाप अर होरी लेबी का तैहा ज़ैगे ज़िम्मैंबारी ज़िधी बिधाते करारो मणशू थिअ डाहअ द। तिन्‍नों काम त हर धैल़ै बिधी-बधाने साबै पूज़ा-गाज़ा करनी। <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />जदूतूनो शोहरू ओबेद-एदोम अर तेऊए टोली का ठाहठ आदमी तै तिन्‍नां संघै च़ाकरी करनै आल़ै। होसाह अर ओबेद-एदोमा का थिई दुआरे पहरै करने ज़िम्मैंबारी सभाल़ी दी।<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />सदोक प्रोहत अर तेऊ संघै होरी प्रोहते ज़िम्मैंबारी थिई बिधाते पबित्र ज़ैगा गबोन पूज़ा-गाज़ा करने ज़िम्मैंबारी। <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />हर धैल़ै दोत्ती अर उडै लागा त तेऊ साबै बेदी दी हूम बल़ीदान करनअ ज़िहअ बिधाता इज़राईली लै बधान थिअ दैनअ द। <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />तिन्‍नां संघै हआ तै तिधी हमान, जदूतून अर होर खास-खास छ़ांटै दै बिधाते अटल़ झ़ूरीए गिहा बोली ज़ै-ज़ैकार करदै लागै दै। <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />नर्शिंगै, छ़छ़ाल़ा अर होरी साज़-बाज़े ज़िम्मैंबारी बी थिई हमान अर जदूतूना का। तिंयां अर तिन्‍नें साथी करा तै तेता तेभै बाज़ी ज़ेभै खिम्भा भितरी बिधाते पूज़ा-गाज़ा हआ ती। दुआरे पहरै करने ज़िम्मैंबारी बी थिई जदूतून टोलीए।<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />तेखअ डेऊऐ सोभ आपणैं-आपणैं घअरा लै अर राज़अ दाबेद बी डेऊअ आपणैं घअरा लै फिरी कि सह आपणैं टबरा लै बर्गत दैए।<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">नातान गूरो राज़ै दाबेदा लै समाद</para>
  <para style="r">(<ref loc="2SA 7:1-17">2 शमूएल 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />राज़अ दाबेद रहा त ऐबै आपणैं मैहलै। एकी धैल़ै शादअ तेऊ नातान गूर संघा बोलअ तेऊ लै इहअ, “इधी भाल़, हुंह आसा आप्पू केल़ुईए काठा करै बणाऐं दै मैहलै लागअ द रहंदअ पर बिधातो करारो मणशू आसा खिम्भा हेठै डाहअ द!”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />नातान गूरै दैनअ राज़ै दाबेदा लै ज़बाब, “ज़िहअ तेरअ दिल बोला तिहअ कर, किल्हैकि बिधाता आसा ताह संघै।”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />पर तैहा ई राची बोलअ बिधाता नातान गूरा लै, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />“डेऊ, तूह बोल मेरै दास दाबेदा लै कि हुंह बिधाता बोला इहअ, ‘सह निं तूह आथी ज़हा मुंह रहणा लै भबन बणाणअं! <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />ज़हा धैल़ी मंऐं इज़राईली मिसर देशा का काढी आणै, तधा ओर्ही आझ़ तैणीं रहअ हुंह खिम्भा दी एछदअ डेऊंदअ ज़ैगै-ज़ैगै हांढदअ लागी, हुंह निं कोई खास भबनै रहअ। <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />हुंह ज़िधी-ज़िधी बी आपणीं परज़ा इज़राईली संघै रहअ, मंऐं ज़ेतरै बी इज़राईली प्रैंदै प्रधान छ़ांटै, मंऐं निं तिन्‍नें कोही टोली का एही किछ़ै खरी खोज़ी कि तिन्‍नैं मुल्है केल़ुईए काठा करै भबन किल्है निं बणाअं?’<verse eid="1CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7" />“तूह खोज़ मेरै दास दाबेदा का, ‘स्वर्गे सारी सैने मालक बिधाता बोलअ इहअ कि मंऐं आणअ तूह भेडा-बाकरीए हेल़्ही फुआला बणां का एते तैणीं शादी, अर मंऐं बणाअं तूह राज़अ कि मेरी परज़ा इज़राईली प्रैंदै राज़ करे। <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />ज़िधी बी तूह एछदअ डेऊंदअ रहअ, हुंह रहअ कबल्‍लअ ताह संघै। मंऐं किऐ ताखा आजी तेरै दुशमण खतम। मंऐं किअ तूह संसारै बडै-बडै महान लोगा ज़िहअ मशूर। <verse eid="1CH 17:8" /><verse number="9-10" style="v" sid="1CH 17:9-10" />मंऐं बिधाता आसा आपणीं परज़ा इज़राईली लै एक ज़ैगा डाही दी अर तिंयां बसाऊंणै मुंह तैहा ज़ैगा। तिधी निं तेखअ तिंयां कोही हंतणैं। तैहा ज़ैगा पुजणैं बाद आऐ खास्सी बारी उपद्रभी लोग तिन्‍नां हारदै-मारदै, पर ऐबै निं इहअ भिई हणअ। मेरी रही ताल्है ज़बान कि तूह डाहणअ मुंह तेरै दुशमणा का बच़ाऊई अर ताल्है दैणीं मुंह खास्सी आद-लुआद। <verse eid="1CH 17:9-10" /><verse number="11" style="v" sid="1CH 17:11" />ज़ांऊं तूह खास्सअ प्रोढअ जाणअ हई, तेखअ डाहणअ तूह तेरै दादा-बाबा ई ज़िहअ दाबी। तेरअ एक शोहरू बणाणअं मुंह ताह बाद तेरी ज़ैगा राज़अ अर तेऊओ राज़ करनअ मुंह होर बी बलबान। <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />तेरअ सह शोहरू ई हणअ ज़हा मुल्है भबन बणाणअं अर तेरै खिंबै हणअ एक इहअ, ज़सरअ राज़ सारी सदा रहणअ। <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />तेऊओ बाब हणअ हुंह आप्पै अर सह हणअ मेरअ शोहरू। ज़ै सह गलती करे, तेऊ लै दैणीं मुंह आप्पै सज़ा ज़िहअ एक बाब करा। मुंह झ़ूरनअ तेऊ लै सदा। <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />आपणीं परज़ा अर राज़ सभाल़णअ मुंह सदा लै तेऊ का अर तेऊओ राज़ हणअ सदा लै अटल़।’”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />नातान गूरै खोज़ी दाबेदा का पठी गल्‍ला ज़ुंण बिधाता तेऊ का प्रगट किई ती।<verse eid="1CH 17:15" /></para>
  <para style="s">दाबेदै किअ बिधातो शूकर</para>
  <para style="r">(<ref loc="2SA 7:18-29">2 शमूएल 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />तेखअ डेऊअ राज़अ दाबेद बिधाते खिम्भा भितरी अर करारे मणशू सेटा बेशी बोलअ इहअ, “हे मेरै पबित्र परमेशर बिधाता, ज़ुंण बी तंऐं मुल्है किअ, हुंह निं तेता जोगी आथी त, नां मेरअ खिंब तेता जोगी आथी त। <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />मेरै साबै किअ तंऐं मुल्है खास्सअ। पर तंऐं डाही आजू मेरी आद-लुआदा लै बी करार करी। पबित्र परमेशर बिधाता, तंऐं किअ मुंह संघै इहअ बभार कि हुंह आसा होए कोई महान मणछ। <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />हे मेरै मालक बिधाता, हुंह दाबेद ताल्है एता का खास्सअ होर किज़ै सका बोली! हुंह आसा तेरअ दास अर तंऐं किअ मेरअ अदर? <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />बिधाता, तूह च़ाहा त इहअ ई कि ताह करनै मुल्है ईंयां महान काम। तूह च़ाहा त तेता पूरअ करनअ ज़ुंण तंऐं पैहलै ई त बोलअ द।<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />“हे पबित्र परमेशर बिधाता, हाम्हां सोभी का आसा थोघ कि ताह ज़िहअ शुचअ निं कोहै आथी तूह आसा एक्‍कै परमेशर होर निं ताह ज़िहअ कोहै आथी। <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />नां सारी धरती दी इज़राईला ज़िहअ होर देश आथी ज़ुंण तंऐं गलामी का छ़ड़ैऊई आपणीं खास परज़ा बणाऐं। ज़ुंण महान अर नुआहरै काम तंऐं तिन्‍नां लै किऐ, तेता करै हुअ तूह सारै संसारै मशूर। तंऐं काढै होरी देशे लोग अर तिन्‍नें देअ आपणीं परज़ा पजैल़णैं का आजी दरल़ाऊई ताकि तिधी तेरै आपणैं लोग बस्से ज़ुंण तंऐं मिसर देशे गलामी का आणै आज़ाद करी। <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />तंऐं बणाऐं इज़राईली सदा लै आपणीं खास परज़ा अर हे बिधाता, तूह हुअ सदा लै तिन्‍नों परमेशर।<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />“ऐबै हे परमेशर बिधाता, ज़ुंण करार तंऐं मुंह अर मेरी आद-लुआदा संघै किई तेता कर तूह सदा लै पाक्‍की अर तूह करै तिहअ ई ज़िहअ तंऐं बोलअ द आसा। <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />तै रहणअ तेरअ नाअं सदा अर लोगा बोल़णअ सदा इहअ, ‘इज़राईलो परमेशर आसा सह स्वर्गे सारी सैनो मालक बिधाता।’ मुंह तेरै दास दाबेदो खिंब डाहै तूह सदा अटल़। <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />तूह आसा असली दी इज़राईलो परम प्रधान परमेशर बिधाता ज़हा का सारअ बल आसा! मुंह हुई ताखा एही अरज़ करने हिम्मत किल्हैकि तंऐं आसा मुंह आपणैं दासा का सोभै गल्‍ला खोज़ी हेरी दी अर इहअ बी आसा बोली डाहअ द कि ताह बणाणैं मेरै खिंबा का राज़ै।<verse eid="1CH 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 17:26" />“तूह बिधाता आसा परमेशर, तंऐं आसा मुल्है शुची ज़बान दैनी दी। <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />ऐबै आसा ताखा मेरी अरज़ कि ऐबै दै खुशी-खुशी मेरै खिंबा लै बर्गत ताकि तूह तिन्‍नां बाखा सदा रहे। पबित्र परमेशर बिधाता, तंऐं हेरी तिन्‍नां लै बर्गत दैई अर तेरी बर्गत रहणीं मेरी आद-लुआदा लै सदा।”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">राज़ै दाबेदै ज़ितै जुध</para>
  <para style="r">(<ref loc="2SA 8:1-18">2 शमूएल 8:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />थोल़ै धैल़ै बाद छ़ेल़अ राज़ै दाबेदै पलिश्ती संघै भिई जुध अर तिंयां हारै दाबेदा का भिई। तेऊ छ़ड़ैऊई तिन्‍नां का गात नगरी अर तेता ओरी-पोरीए गराअं ज़ेथ तिन्‍नैं कबज़अ त किअ द। <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />तेखअ ज़ितअ दाबेद मोआबी का। तेखअ किअ दाबेदै मोआबी प्रैंदै राज़ अर तिंयां दैआ तै तेऊ लै कारअ।<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />एता बाद छ़ेल़अ दाबेदै सिरीया देशे सोबा नगरीए राज़ै हदादेज़ेरा का हमात मुल्खा नेल़ जुध, किल्हैकि हदादेज़ेर च़ाहा त फरात दरैऊआ प्रैंधल़ै मुल्खै कबज़अ करदअ लागअ द। <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />तेऊ जुधा दी किऐ दाबेदै हदादेज़ेरे एक हज़ार रथ, सात हज़ार घोल़े शुंआर, बिह हज़ार पैदल सपाही आपणैं कबज़ै दी। तेता का डाहै दाबेदै एक शौ रथा लै घोल़ै बच़ाऊई अर बाकी किऐ तेऊ ज़ान्हूं पिछ़ूए नस काटी बरैबाद।<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />ज़ांऊं दमिश्क नगरीए अरामी लोगै आपणीं सैना सोबा नगरीए राज़ै हदादेज़ेरे मज़त करदी छ़ाडी, दाबेदे सैना पल़ी तिन्‍नां लै चुटी अर तिन्‍नां मांझ़ै पाऐ बाई हज़ार सपाही मारी। <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />तेखअ बशैल़ी दाबेदै अरामी मुल्खै आपणीं सैने च़ौकी, तिन्‍नां प्रैंदै बी हुअ दाबेदो राज़ संघा लागै तिंयां बी दाबेदा लै कारै दैंदै। ज़िधी बी दाबेद डेऊअ, बिधाता दैनी तेऊ लै ज़ीत। <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />हदादेज़ेर राज़ै का थिई सुन्‍नें ढाल़ा अर तिंयां किई राज़ै दाबेदै आपणैं कबज़ै दी संघा आणी एरुशलेम नगरी लै। <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />तेता संघै आणअ दाबेद राज़ै हदादेज़ेर राज़े तिभात अर कून नगरी का खास्सअ कांस्सअ बी। बादा का बणाअं त राज़ै सुलैमानै तेऊ कांस्सै करै बिधाते भबना लै कांस्सैओ बडअ कल़ाह, थाम्ह अर कांस्सैओ होर समान।<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />हमात नगरीए राज़ै तोई का लागअ थोघ कि दाबेदे सैना का हारी सोबा नगरीए हदादेज़ेर राज़े सारी सैना, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />तेखअ छ़ाडअ तेऊ आपणअ शोहरू हादोराम राज़ै दाबेदा सेटा राज्ज़ी-खुशी अर हदादेज़ेर राज़ै का ज़ितणें बधाई दैंदअ। किल्हैकि हदादेज़ेर राज़ै छ़ेल़अ त तोई संघै कई बारी जुध। जोरामै आणै दाबेदा लै भैंट दैणा लै सुन्‍नैं, च़ंदी अर कांस्से भांडै। <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />राज़ै दाबेदै डाहै तिंयां भांडै बिधाता लै मणसी ज़ुदै ज़िहै अर सह सुन्‍नअ, च़ंदी अर कांस्सअ बी डाहअ तेऊ बिधाता लै तिहअ ई ज़ुदअ ज़ुंण तेऊ एदोम, मोआब, अमोन, पलिश्ती अर अमोलकी ज़ातीए लोगा का जुध ज़िती आणअ त।<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />अबीशै ज़सरी ईज सरूयाह थिई, तेऊ ज़ितअ लूंणै खागा दी एदोमी का जुध अर तिन्‍नें पाऐ तेऊ ठारा हज़ार आदमी मारी। <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />तेखअ डाही तेऊ आपणीं सैने च़ौकी एदोम अर इहअ करै हुअ एदोमी प्रैंदै बी राज़ै दाबेदो राज़। ज़हा संघै बी राज़ै दाबेदो जुध हुअ, बिधाता दैनी तेथ तेऊ लै ज़ीत।<verse eid="1CH 18:13" /></para>
  <para style="s">राज़ै दाबेदे खास कार-करिंदै</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />दाबेदै किअ सारै इज़राईला प्रैंदै राज़ अर सह डाहा त धैन कि सारी परज़ा संघै लोल़ी एक बराबर बभार हुअ अर सोभी लोल़ी शुचअ नसाफ भेटअ। <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />अबीशैओ भाई जोआब ज़सरी ईज सरूयाह थिई, सह थिअ राज़ै दाबेदो सैनापति। दाबेदो इतिहास लिखणैं आल़अ त आहीलूदो शोहरू जहोशापात, <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />आहीतूबो शोहरू सदोक अर अबतारो शोहरू अबीमोलक तै बडै प्रोहत। शाबशा थिअ राज़ै दाबेदो काईथ, <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />जहोयादा प्रोहतो शोहरू बेनियाह थिअ राज़ै दाबेदे आपणीं फाज़त करनै आल़ै शूरबीरो प्रधान अर दाबेदे आपणैं शोहरू बी थिऐ बडी-बडी पदबी दी।<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">दाबेद ज़ितअ अमोनी अर अरामी का</para>
  <para style="r">(<ref loc="2SA 10:1-9">2 शमूएल 10:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />तेखअ हुअ इहअ कि बादा का मूंअ अमोनी लोगो राज़अ नहाश अर आजू बणअ तेऊओ शोहरू हनून तेऊए ज़ैगा राज़अ। <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />दाबेदै सोठअ इहअ कि ज़िहअ मुल्है नहाश झ़ूरा त, तिहअ ई रहणअ आजू मुंह संघै तेऊओ शोहरू हनून बी। दाबेदै छ़ाडै आपणैं कार-करिंदै हनूना सेटा लै अमोनी देशै चिंजदै कि दाबेदा हुअ राज़ै नहाशा मरनैओ खास्सअ दुख।</para>
  <para style="p" vid="1CH 19:2">पर ज़ांऊं तिंयां राज़ै हनूना सेटा मिलदै अमोन नगरी पुजै, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />तेऊए कार-करिंदै लागै राज़ै हनूना लै इहअ बोल्दै, “तूह कै सोठा, आपणैं कार-करिंदै चिंजदै छ़ाडी कै दाबेदै तेरै बाबो अदर किअ? ज़ाथी निं किछ़! तेऊ आसा ईंयां म्हारी नगरीए भेख लंदै छ़ाडै दै! ताकि बादा का सह एथ कबज़अ करी सके!”<verse eid="1CH 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 19:4" />हनूनै किऐ दाबेदे कार-करिंदै कैद संघा डाही तिन्‍नें एकी बाखा दाल़्ही-मुछ़ा काटी अर पिछ़ू बाखा गूल़ी का बझ़ैल़ै तिन्‍नें च़ोल़ै दी काटी छिझै पाणै ताकि तिंयां पिछ़ू का नांगै शुझिए! तेखअ दैनअ तिन्‍नां डेऊणैं! <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />तिन्‍नें निस्सअ शरमैं आपणैं देशा घअरा बाखा हांढुई बी। ज़ांऊं ऐहा गल्‍लो थोघ राज़ै दाबेदा का लागअ कि इहअ हुअ, तेऊ छ़ाडै जेरिहो नगरी तैणीं तिन्‍नां लै इहअ समाद पजैल़ै, “ज़ेभै तैणीं थारी दाल़्ही निं बझ़े, तेभै तैणीं रहै तम्हैं इधी जेरिहो नगरी अर तेता बाद लागै तम्हैं एछदै।”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />तेखअ गअ राज़ै हनून अर अमोनी का ज़ाण्हुंई कि ऐबै पाई तिन्‍नैं दाबेदा संघै ज़ीद, तिन्‍नैं दैनी चऊती हज़ार किलू च़ंदी उझलै मेसोपोटामिया अर सिरीया देशे माकाहा अर सोबा नगरी लै। <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />तेते बदल़ै शदाऊऐ तिन्‍नैं बत्ती हज़ार रथ अर माकाहा नगरीए राज़े सैना आई जुधा लै तिन्‍नें साथ दैंदी अर तिन्‍नैं पाऐ मेदबा नेल़ डेरै। अमोनी बी निखल़ै तिन्‍नें सोभी नगरी का संघा हुऐ जुधा लै मकाबलै करदै तैर।<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />दाबेदा का गअ इना गल्‍लो थोघ लागी अर तेऊ छ़ाडअ तिन्‍नें मकाबलै लै आपणअ सैनापति जोआब सारी सैना संघी। <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />अमोनी निखल़ै जुधा लै बागै संघा बान्हीं आपणीं राज़धानी रबाह नगरीए प्रऊल़ी आजू जुधा लै लगैग अर ज़ुंण राज़ै तिन्‍नें साथ दैंदै आऐ तै, तिन्‍नैं लाई खुल्ही सऊंई ज़ैगा आपणीं-आपणीं लगैगा।<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />ज़ांऊं जोआबै भाल़अ कि तिन्‍नां आजू-पिछ़ू आसा दुही बाखा दुशमणे सैने लगैग अर तिंयां सका कज़ेथी बाखा मारदै एछी, जोआबै छ़ांटै इज़राईली मांझ़ै खास-खास जोधै संघा लाई तिन्‍नें लगैग अरामी बाखा स्मोहरी। <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />बाकी सैनो दलपति बणाअं तेऊ आपणअ भाई अबीशै अर तिन्‍नें लगैग लाई तेऊ अमोनी बाखा स्मोहरी। <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />जोआबै बोलअ अबीशै लै, “ज़ै अरामी का हुंह हारदअ शुझिए, तै लोल़ी तूह मेरी मज़त करदअ आअ, अर ज़ै मुखा अमोनी का तूह हारदअ शुझिए, तै आअ हुंह तेरी मज़त करदअ। <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />तूह डाहै हैअ, हिम्मत निं हारी! हाम्हां करनअ आपणैं लोगा अर आपणैं परमेशरे नगरी लै पूरअ ज़ोर लाई जुध। आजू आसा बिधाते मरज़ी, तेऊ ज़िहअ करनअ होए, हणअ सह तिहअ।”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />जोआब अर तेऊए सैना पल़ी पैहलै ई अरामी संघै मकाबलै करना लै चुटी अर अरामी ठुर्है तिन्‍नां सेटा का दूर! <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />अमोनी भाल़अ कि अरामी गऐ जुधा का ठुर्ही, तिंयां बी ठुर्है अबीशै सम्हनै का पिछ़ू संघा पेठै नगरी भितरी। तेखअ आअ जोआब आपणीं सैना संघी बापस एरुशलेम नगरी लै फिरी।<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />ज़ांऊं अरामी का ज़ाण्हुंअ कि तिंयां हारै इज़राईली का, तिन्‍नैं झाल़ी भिई आपणीं सारी सैना। तिन्‍नैं शादै तिन्‍नां सैनो दल ज़ुंण फरात दरैऊआ पुर्बा बाखा थिऐ, तिन्‍नैं बणाअं आपणअ सैनापति शोपाक ज़ुंण राज़ै हदादेज़ेरो सैनापति थिअ। <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />ज़ांऊं दाबेदा का इना सोभी गल्‍लो थोघ लागअ, तेऊ झाल़ी आपणीं इज़राईली सैना संघा डेऊअ जरदण पार संघा किई आपणीं सैना अरामीए मकाबलै करना लै स्मोहरी खल़ी। ज़ांऊं जुध लागअ, <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />इज़राईली खद्रेल़ै अरामी पिछ़ू। तधू पाऐ दाबेद अर तेऊए सैना अरामीए सात शौ रथ, च़ाल़्ही हज़ार शुंआर मारी अर तिन्‍नों सैनापति शोपाक बी पाअ तिन्‍नैं मारी। <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />ज़ेतरै राज़ै हदादेज़ेरे गलामी करा तै, ज़ांऊं तिन्‍नैं भाल़अ कि तिंयां हारै इज़राईली का, तिन्‍नैं किई तेखअ इज़राईली संघै मेल़-ज़ोल़े करार संघा लागै दाबेदे गलामी करदै। तेखअ डरै अरामी खास्सै संघा निं तिंयां अमोनीए मज़त करदै भिई आऐ।<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">दाबेदै किअ रबाह नगरी कबज़अ</para>
  <para style="r">(<ref loc="2SA 12:26-31">2 शमूएल 12:26-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />च़ैत्रै ज़ेभै राज़ै जुधा लै निखल़ा तै, राज़ै दाबेदो सैनापति जोआब निखल़अ आपणीं सैना संघी अमोनी संघै जुधा लै अर राज़अ दाबेद त एरुशलेम नगरी। जोआब अर तेऊए सैना गोटी अमोनीए राज़धानी रबाह नगरी संघा किई पठी बरैबाद। <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />अमोनी देअए मोलके मुहुर्तीए मुंडै थिअ सुन्‍नेंओ मुगट। सह थिअ तोली करै कोई पैंईंती किलू अर तेथ ती किम्मती मणीं लागी दी। राज़ै दाबेदै लाई तेता का तिंयां मणीं आपणैं मुगटा दी संघा लुटी तिन्‍नैं सह नगरी पठी। <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />तिधी बस्सै दै लोग डाहै तिन्‍नैं आरै, कदाल़ी अर खराल़ै करै नगरी दी कामां लाई। अमोनी लोगे होरी नगरी संघै बी किअ दाबेदै इहअ ई। तेखअ आऐ तिंयां एरुशलेम नगरी लै बापस फिरी।<verse eid="1CH 20:3" /></para>
  <para style="s">पलिश्तीए दैंत्तर जोधै संघै जुध</para>
  <para style="r">(<ref loc="2SA 21:15-22">2 शमूएल 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />थोल़ै धैल़ै बाद हुअ भिई गज़ेर ज़ैगा पलिश्ती संघै जुध। तेऊ जुधा लै पाअ हुशाई नगरीए सिबकै पलिश्तीओ रपाईए लुआदा मांझ़ै एक सिपाई नाओं जोधअ मारी अर पलिश्ती हारै एऊ जुधा लै बी बाख।<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />पलिश्ती संघै एकी होरी जुधा दी पाअ बेतलेम नगरीए याईरे शोहरू एलहानै गात नगरीए गोलियाथो भाई लाहमी जोधअ मारी, तेऊए बर्छ़े डैंढी ती राछ़े लाठै ज़ेही मोट्टी।<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />तेखअ हुअ पलिश्ती संघै गात नगरी एक होर जुध, तेथ त एक दैंत्तर जोधअ, तेऊए ती हाथै-खूरै छ़ह-छ़ह गुंठी पठी गणी करै च़ौबी। सह थिअ रपाईए खिंबा का। <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />तेऊ पाई इज़राईली संघै मकाबलै लै हाक, अर सह पाअ दाबेदे भाई शिमे शोहरू जोनातानै मारी।<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />ईंयां चअन पलिश्ती ज़ुंण दाबेद अर तेऊए आदमी मारै, ईंयां तै गात नगरी रपाईए आद-लुआद।<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">दाबेदै किई आपणीं परज़े गणांई</para>
  <para style="r">(<ref loc="2SA 24:1-25">2 शमूएल 24:1-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />परमेशरो बरोधी स्वर्ग दूत च़ाहा त इहअ कि इज़राईली लै लोल़ी आफ़त पल़ी, तेऊ पाई राज़ै दाबेदे मन्‍नैं एही गल्‍ल कि इज़राईल अर यहूदा बस्सै दै सोभी इज़राईलीए गणांई करनी! <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />राज़ै दाबेदै किअ आपणैं सैनापति जोआबा लै हुकम, “तूह डेऊ आपणैं कार-करिंदै संघा निंईं उतरा बाखा दान मुल्खा उंधै दखण बेर्शेबा तैणीं सारै इज़राईली गोत्रा सेटा संघा करा सारी परज़े गणांई। हुंह च़ाहा इहअ भाल़णअ कि तिन्‍नां मांझ़ै केतरै मणछ आसा सैना दी डाहणैं जोगी।”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />पर जोआबै दैनअ दाबेदा लै ज़बाब, “माहा राज़अ, च़ाऐ एभै ज़ेतरै बी होए, तेरै परमेशर बिधाता बढेरनीं तेरी सैना शौ गुणा खास्सी! तिन्‍नां सोभी प्रैंदै आसा तेरअ ई राज़, पर हे मेरै मालक, तूह इहअ किल्है च़ाहा करनअ? इहअ करै किल्है लाऐ तंऐं ज़ोरा-ज़ोरी सारै इज़राईली दोशी बणाईं?” <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />पर राज़ै बोलअ जोआब अर तेऊए कार-करिंदै लै कि ज़िहअ हुकम किअ तिहअ ई करा। तिंयां आऐ सारै इज़राईल देशै हांढी संघा फिरै सोभिए गणांई करी एरुशलेम नगरी लै बापस। <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />जोआबै खोज़अ राज़ै दाबेदा का इज़राईली परज़े गणांईओ पठी साब कि इज़राईला दी आसा सैना जोगी कोई गैरा लाख मर्ध अर यहूदा दी आसा च़ार लाख सत्तर हज़ार मर्ध ज़ुंण सैना दी आपणीं च़ाकरी सका दैई। <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />लेबी अर बिन्यामीन गोत्रा मांझ़ै निं जोआबै गणै आथी, किल्हैकि सह निं राज़े तेऊ हुकमा लै सैहमत आथी त।<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />इज़राईले गणांई करनै का थिअ बिधाता नराज़, अर बिधाता दैनी इज़राईला लै तेते सज़ा। <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />तेखअ किई राज़ै दाबेदै बिधाता सेटा अरज़, “हे बिधाता, हुंह आसा तेरअ दास, पर गणांई करी हुअ मेरै भलै घोर पाप! ज़ीबाण, मेरै एऊ ऐडै कामां लै छ़ाड तूह मुल्है माफी।”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />बिधाता बोलअ गाद नाओंए गूरा लै ज़ुंण राज़ै दाबेदो गूर थिअ, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“दाबेद राज़ै सेटा डेऊ, संघा बोल तेऊ लै इहअ कि मंऐं लाई ताल्है पल़णै आल़ी चअन आफ़ता रहैऊई, तूह छ़ांट तेता मांझ़ै एक कि हुंह ताह प्रैंदै कहा पाऊं?”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />गाद डेऊअ तेऊ सेटा, संघा खोज़अ तेऊ कि बिधाता बोला ताल्है इहअ-इहअ। तेखअ पुछ़अ दाबेदा का इहअ, “ताह आप्पू लै कुंण ज़ेही सज़ा लोल़ी? <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />आपणैं इज़राईल देशै चिई साला तैणीं घोर नकाल़? कि चिई भिन्‍नैं तैणीं तेरै दुशमण तलबारा पाई ताह पिछ़ू रहे पल़ी? कि चिई धैल़ै तैणीं तेरै देशै माहा-मरी लोल़ी पल़ी कि बिधातो स्वर्ग दूत सारै देशो बनाश करे? ऐबै कर तूह राम्बल़ै करै बच़ार संघा खोज़ मुखा कि हुंह बिधाता लै बापस किज़ै ज़बाब खोज़ूं?”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />दाबेद राज़ै बोलअ गाद गूरा लै, “मुल्है पल़ी अह बेघै बूरी आफ़त! हुंह निं च़ाहंदअ कि कुंण मणछ मुल्है सज़ा दैए। बिधाता दै हाम्हां लै आप्पै सज़ा दैणैं, किल्हैकि सह आसा खास्सअ झणैल़ू।”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />बिधाता पाई तेखअ तैहा दोत्ती पोर्ही इज़राईला मांझ़ै माहा-मरी। सारै इज़राईल देशै मूंऐं सत्तर हज़ार मर्ध। <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />तेखअ छ़ाडअ बिधाता एक स्वर्ग दूत तेऊ लाई ती एरुशलेम नगरी पठी खतम करी, पर बिधाता किअ सह मारनै आल़अ स्वर्ग दूत पिछ़ू, “ऐबै हुअ बतेर्हअ!” तेभै त सह स्वर्ग दूत अरोना नाओंए एकी जबेशी मणछे ताटी।<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />दाबेदा का शुझुअ आपणीं आछी कि सरगै आसा बिधातो सह स्वर्ग दूत खल़्हुअ द अर तेऊए हाथै आसा तलबार अर तेऊ लाई एरुशलेम नगरी पठी खतम करी। राज़ै दाबेद अर सोभी इज़राईली सैणैं तै तैहा खरी घेरी खिंथल़ै पल़ेटै दै, तिन्‍नैं टेक्‍कअ धरनीं उटै पल़ी माथअ। <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />राज़ै दाबेदै किई बिधाता का एही अरज़, “हे परमेशर, अह आसा पठी मेरअ कशूर, सह थिअ हुंह ज़ुंणीं गणांई करनैओ हुकम किअ। ईंयां रैनै-गरीब मणछ ज़ुंण भेडा-बाकरीए हेल़्ही ज़िहै आसा, इनो निं एथ किछ़ै कशूर आथी! बिधाता, मेरै परमेशर, तूह दै मुल्है अर मेरै टबरा लै सज़ा, इना होरी लोगा निं मारी आथी।”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />बिधाते स्वर्ग दूतै बोलअ गाद गूरा लै, “दाबेदा लै कर इहअ हुकम कि अरोना जबेशीए ताटी बणाऐं बिधाता लै बेदी।” <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />ज़िहअ बिधाता हुकम किअ, दाबेदै किअ तिहअ ई संघा डेऊअ तिधा लै ज़िहअ गाद गूरै तेऊ का खोज़अ। <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />अरोना अर तेऊए च़ार शोहरू तै खहल़ै कणका मांडदै लागै दै। ज़ांऊं तिन्‍नैं स्वर्ग दूत भाल़अ, तिंयां शोहरू ठुर्है तिधा का संघा रहै लुक्‍की। <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />अरोना भाल़अ कि राज़अ दाबेद आअ अर तेऊ पाई ताटी दी नाज़ा मांडणे छ़ाड़ अर सह पल़अ धरनीं उटी बाखा संघा टेक्‍कअ राज़ै दाबेदा सेटा माथअ। <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />राज़ै दाबेदै बोलअ अरोना लै, “ऐहा ताटी दै तूह मुल्है, हुंह दैंऊं ताल्है एतो ज़ेतरअ तूह बोले तेतरै ढब्बै मोल। मंऐं लाई बिधाता लै इधी बेदी बणाईं ताकि सह परज़ा मांझ़ा का ऐहा माहा-मरी दूर करे।”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />अरोना बोलअ राज़ै दाबेदा लै, “मेरै मालक, तूह लाग निंदअ, संघा दै बिधाता लै ज़िहअ तूह च़ाहा तिहअ। इधी आसा भाल़ मेरै बल्द हूम बल़ी करना लै, खहल़ा मांडणे चाण अर हणैं बेदी दी आगी ज़ाल़णा लै। नाज़ बल़ी करना लै आसा इधी कणक। मंऐं दैनै ईंयां सोभै ताल्है।”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />पर राज़ै दाबेदै बोलअ अरोना लै, “मुंह निं ईंयां बाझ़ी ढब्बै लोल़ी, मुंह दैणअ ताल्है एतो मोल। मुंह निं बिधाता लै सह हूम बल़ीदान करनअ ज़ुंण तेरअ आसा अर ज़ेतो मंऐं मोल ई निं आथी दैनअ द।” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />राज़ै दाबेदै दैनै अरोना लै छ़ह शौ सुन्‍नें सिक्‍कै<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="fq" closed="false">छ़ह शौ सुन्‍नें सिक्‍कै </char><char style="ft" closed="false">कोई सात किलू सुन्नअ</char></note> तैहा खहल़े ज़ैगो मोल। <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />तेखअ च़िणीं तिधी तेऊ बिधाता लै एक बेदी संघा किअ तेथ हूम अर मेल़-ज़ोल़ो बल़ीदान। बिधाता शूणीं दाबेद राज़े अरज़ संघा किई इज़राईला मांझ़ा का माहा मरी दूर।<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />बिधाता किअ स्वर्ग दूता लै हुकम कि आपणीं तलबार डाह पिछ़ू अर तेऊ किअ ज़िहअ बिधाता बोलअ तिहअ ई। <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />ज़ांऊं राज़ै दाबेदै भाल़अ कि बिधाता हेरी तेऊए अरज़ शूणीं, तेखअ किअ तेऊ अरोना जबेशीए ताटी बणाईं दी तैहा बेदी प्रैंदै बल़ीदान। <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />बिधाता लै खिम्भ ज़ुंण मोसा रेगीस्तानै बणाअं त अर हूम बल़ीदान करने बेदी ती अज़ी बी गबोन ज़िधी बिधाते पूज़ा-गाज़ा करा तै करी। <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />पर राज़अ दाबेद निं तिधी बिधाता सेटा माथै टेक्‍कदअ डेऊअ किल्हैकि सह थिअ बिधाते स्वर्ग दूते तलबारा का खास्सअ डरअ द।<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />राज़ै दाबेदै बोलअ इहअ, “इधी ऐहा खहल़े ज़ैगा ई बणाणअं बिधाता लै भबन। इज़राईली परज़ा लै हूम बल़ीदान करने बेदी बी हणीं इधी।”<verse eid="1CH 22:1" /></para>
  <para style="s">बिधाता लै भबन बणाणें तैरी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />राज़ै दाबेदै किअ हुकम कि ज़ेतरै बी परदेसी इज़राईल देशै आसा बस्सै दै, तिन्‍नां सोभी शादा एरुशलेम नगरी लै। ज़ांऊं तिंयां आऐ, राज़ै दाबेदै डाहै तिंयां कामां लाई, तिन्‍नां मांझ़ै डाहै थोल़ै बिधाते भबन बणाणां लै पात्थरा काढदै अर छ़िणीं करै च़कोर बणाऊंदै लाई। <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />तेखअ आणअ राज़ै दाबेदै प्रऊल़ीए पाल्‍लै दी लागणै आल़ै कील अर कबज़ै बणाणां लै एतरअ खास्सअ लोहअ अर कांस्सअ कि तेता निं तोली ई सकदै तै। <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />सूर अर सदोने लोगा का डाहै खास्सै केल़ुईए काठ आणी। <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />राज़ै दाबेदै सोठअ इहअ, “मेरै शोहरू सुलैमाना ज़ुंण बिधाता लै भबन बणाणअं, सह लोल़ी महान अर सारै संसारै मशूर हुअ, तेते तैरी डाहणीं मुंह आप्पै करी।” तैही डाही तेता लै राज़ै दाबेदै आपणीं ज़िऊंदी ज़िता खास्सी च़िज़ा आप्पै आणी।<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />तेखअ शादअ राज़ै दाबेदै आपणअ शोहरू सुलैमान संघा किअ तेऊ लै हुकम कि तूह बणाऐं इज़राईले परमेशर बिधाता लै भबन। <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />दाबेदै बोलअ सुलैमाना लै इहअ, “हुंह च़ाहा त इहअ कि मुंह बणाणअं आपणैं परमेशर बिधाता लै भबन ज़िधी तेऊओ अदर होए। <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />पर बिधाता बोलअ मुल्है इहअ, ‘तंऐं किऐ खास्सै जुध अर तंऐं मारै खास्सै मणछ। ताल्है लागअ धरती दी लोधल़े छेरा लाणैंओ दोश अर तैही निं ताह तेरी ज़िऊंदी ज़िता मुल्है भबन बणाणेंओ मोक्‍कअ भेटणअ। <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />पर ज़ेभै आजू तेरअ शोहरू राज़अ बणें, मुंह डाहणीं तेऊए राज़ा दी शांती। तेऊ नाअं हणअ सुलैमान किल्हैकि तेऊए ज़मानै डाहणीं मुंह इज़राईला देशै शांती अर तिन्‍नां निं दुशमणे डअर-भगैर हणीं। <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />सुलैमाना ई बणाणअं मुल्है भबन अर तेऊए ई आद-लुआदा मांझ़ै एछणअ एक इहअ ज़ुंण इज़राईला प्रैंदै सदा लै राज़अ हणअ। सह हणअ मुल्है मेरै शोहरू ज़िहअ अर तेऊ लै हणअ हुंह बाबा ज़िहअ।’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“सुलैमान, मेरै शोहरूआ, हुंह करा ऐबै एही अरज़ कि म्हारअ परमेशर बिधाता लोल़ी ताह संघै रहअ अर तेऊ लोल़ी तूह आपणैं भबन बणाणां लै सफल किअ ज़िहअ तेऊ बोलअ द आसा। <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />बिधाता लोल़ी ती ताल्है एही अक्ल अर समझ़ दैनी कि तूह बिधाते बधाने साबै इज़राईला प्रैंदै राज़ करे। <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />ज़ै तूह बधाने तिन्‍नां सोभी बिधी मने ज़ुंण बिधाता आपणैं दास मोसा का दैनअ, तै जाणअ तूह सफल हई। तूह डाहै हिम्मत, हैअ निं चोल़ी अर नां किछ़ी गल्‍ला का डरदअ लागी। <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />मंऐं आसा भाल़ै बिधाते भबना बणाणां लै सोभै गल्‍ला डाही दी कठा करी। चअन शौ कुंटल़ आसा सुन्‍नअ, चऊती हज़ार कुंटल़ आसा च़ंदी डाही दी झाल़ी। एता का लाऊआ आसा लोहअ अर कांस्सअ एतरअ कि तेता निं कुंण तोली सकदअ। काठ अर पात्थर बी आसा बतेर्है डाहै दै आणी, तिन्‍नां आणै तूह होर बी। <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />कारीगीरे काम्मी निं ताह पल़णीं, पात्थरे मिस्त्री बी आसा, काठे कारीगीर बी आसा अर होरी कामां लै बी आसा ज़ाण-प्रबीण मणछ बतेर्है। <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />सुन्‍नैं, च़ंदी, कांस्सै अर लोहे कामां करनै आल़ै आसा सनार, ठठार अर लुहार खास्सै। ऐबै कर तूह आपणअ काम शुरू अर बिधाता लोल़ी ताह संघै सदा रहअ।”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />राज़ै दाबेदै किअ सोभी इज़राईली टोलीए सैणैं लै हुकम कि तिंयां सोभै करै सुलैमाने मज़त। <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />दाबेदै बोलअ तिन्‍नां लै इहअ, “थारअ परमेशर बिधाता आसा तम्हां संघै अर तेऊ आसा तम्हां लै दुशमणा का फेर-फिरदी शांती डाही दी करी। तेऊ किऐ तिंयां सोभ मेरै बशै ज़ुंण एऊ देशै हाम्हां का आजी तै बस्सै दै। ऐबै आसा एऊ देशे मालक बिधाता अर तेऊए परज़ा। <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />ऐबै करा तम्हैं तन-मन्‍न लाई आपणैं परमेशर बिधाते च़ाकरी। ज़ोर-ज़ाहण लाई बणाआं बिधाता लै भबन, संघा डाहै बिधाते करारो मणशू अर सोभी चाण-भांडै तेथ ज़ुंण तेऊए पूज़ा-गाज़ा लै कामैं एछा।”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />ज़ांऊं राज़अ दाबेद खास्सअ प्रोढअ हुअ, तेऊ बणाअं आपणअ शोहरू सुलैमान इज़राईलो राज़अ।<verse eid="1CH 23:1" /></para>
  <para style="s">लेबी लै ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />राज़ै दाबेदै किऐ सोभ इज़राईली सैणैं, प्रोहत अर लेबी कठा। <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />तेखअ गणै तिंयां लेबी ज़ुंण तिहा साले अर तेता का खास्सी अमरे थिऐ। तिंयां निखल़ै पठी ठत्ती हज़ार। <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />तिन्‍नां मांझ़ै दैनी बिह हज़ार मणछा लै बिधाते भबने च़ाकरी करने ज़िम्मैंबारी अर छ़ह हज़ार बणाऐं दरोगै अर पांच़। <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />च़ार हज़ार ज़ण्हैं लै सभाल़अ पहरै करनैओ काम अर च़ार हज़ारा लै सभाल़अ तिन्‍नां साज़-बाज़ बाज़णैंओ काम ज़ुंण बिधाते स्तोती करना लै थिऐ बणाऐं दै।<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />राज़ै दाबेदै बांडै लेबी तिन्‍नें टोलीए साबै चिई दला दी: गर्शोन, कहात अर मरारी।<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />गर्शोने तै दूई शोहरू: लादान अर शिमी। <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />लादाने तै आजू चअन शोहरू: जेहीएल, जताम अर जोएल ज़ुंण लादाना का निखल़ी दी आजू टोलीए मूल़ थिऐ। <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />शिमीए थिऐ चअन शोहरू: शेलोमीत, हज़ीएल अर हारान। लादाने आद-लुआदे मूल़ तै ईंयां ई। <verse eid="1CH 23:9" /><verse number="10-11" style="v" sid="1CH 23:10-11" />इना बाद तै शिमीए च़ार होर शोहरू हुऐ दै तिंयां थिऐ बडै का होछ़ै तैणीं ईंयां: जहात, ज़ीना, जेऊश, बरीया।<verse eid="1CH 23:10-11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />कहाते तै च़ार शोहरू: अमराम, इसहार, हेब्रोन अर उज्जीएल। <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />तेऊओ ज़ेठअ शोहरू अमराम थिअ हारण अर मोसो बाब। हारण अर तेऊए आद-लुआद तै सदा लै ज़ुदै किऐ दै कि तिंयां खास पबित्र च़िज़े प्रतिष्ठा करे, बिधाता सेटा धूप ज़ाल़े, बल़ीदान करे अर तेऊए नाओंऐं लोगा लै बर्गत दैए अर सदा तेऊए च़ाकरी करे। <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />पर परमेशरे गूर मोसे शोहरू बी गणै आजू होरी लेबीए टोली संघै ई। <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />मोसे थिऐ दूई शोहरू: गर्शोम अर एलीआजर।<verse eid="1CH 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 23:16" />गर्शोमो ज़ेठअ शोहरू त शबूएल। <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />एलीआजरो त एक्‍कै शोहरू तेऊ नाअं त रहाबयाह। पर रहाबयाहे थिई आजू खास्सी आद-लुआद।<verse eid="1CH 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 23:18" />कहाते दुजै शोहरू इसहारो थिअ शेलोमीत नाओं एक शोहरू, सह हुअ तैहा टोलीओ मूल़। <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />कहाते चिऐ शोहरू हेब्रोने थिऐ च़ार शोहरू: जरीयाह, अमर्या, जहजीएल अर जकमाम। <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />कहाते च़ौथै शोहरू उज्जीएले थिऐ दूई शोहरू: मिका अर इशिया।<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />मरारीए थिऐ दूई शोहरू महली अर मूशी। महलीए बी थिऐ आजू दूई शोहरू हुऐ दै: एलीआजर अर कीश। <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />पर एलीआजरे निं शोहरू हुऐ, तेऊए ती सिधी शोहरी, इहअ करै मूंअ सह बाझ़ी शोहरू। तेऊए सोभी शोहरी बैहूई आपणैं च़ाच़ू कीशे शोहरू संघै। <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />मरारीए दुजै शोहरू मूशीए थिऐ आजू चअन शोहरू हुऐ दै: महली, एदेर अर जरमोत।<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />ईंयां तै लेबी गोत्रा का आजू आद-लुआद, ज़ुंण आजू तिन्‍नें खिंब अर टोलीए सैणैं थिऐ। इना सोभिए नाअं डाहै लिखी, ज़ुंण बिहा साले अर तेता का उझे अमरे थिऐ, तिन्‍नां सोभी लै सभाल़अ बिधाते भबनै च़ाकरी करनैओ काम।<verse eid="1CH 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 23:25" />राज़ै दाबेदै बोलअ इहअ, “इज़राईले परमेशर बिधाता दैनी आपणीं परज़ा लै शांती, सह रहणअ एरुशलेम नगरी सदा। <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />तेखअ निं लेबी पबित्र खिम्भ अर बिधाते पूज़ा-गाज़ा करने च़िज़ा ज़ैगै-ज़ैगै च़कणें ज़रुरत आथी। <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />राज़ै दाबेदे खिरी ज़ुंण सलाह दैनी, तेऊ साबै गणै तिंयां सोभ लेबी ज़सरी अमर बिहा साले ती हई गई दी। <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />तिन्‍नां का सभाल़ी ईंयां ज़िम्मैंबारी: हारणे आद-लुआदा का ज़ुंण प्रोहत हणैं, तिन्‍नां संघै करनी ज़ेही ज़रुरत पल़ी तेही च़ाकरी। बिधाते भबना बागै भितरी, भढारे, सोभी पबित्र च़िज़े साफ-सफाई अर पूज़ा-गाज़ा करने च़िज़ा डाहणीं धोई-शोई शुची करी। <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />एता का लाऊआ बिधाता लै भोज़न, भैंट छ़ाडणा लै पिठअ, लुच़ी, रोट जैतूनो तेल राल़अ द पिठअ, इना सोभी च़िज़ा नापी-तोली करै दैणैंओ काम थिअ तिन्‍नां का सभाल़अ द। <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />हर धैल़ै दोत्ती अर उडै लागा त तिन्‍नां प्रोहता संघै खल़्हुई बिधातो शूकर करनअ अर गिहा बोल़णीं। <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />बशैघे, पुनूंईए अर होरी तिह-थैरे धैल़ी बी लागा त तिन्‍नां प्रोहता संघै रही बिधातो हूम अर मेल़-ज़ोल़ो बल़ीदान करी शूकर करनअ। तिन्‍नां लै थिअ सूल बणाअं द कि तेभै केतरै लेबी किधी लोल़ी अर तिन्‍नां किज़ै लागा करनअ। <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />बिधाते मेल़-ज़ोल़े खिम्भे हेर-सभाल़ करने ज़िम्मैंबारी थिई पैहलै बी तिन्‍नें ई अर ऐबै सभाल़ी तिन्‍नां का बिधाते भबने अर हारणे आद-लुआदा संघै च़ाकरी करने ज़िम्मैंबारी।”<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">प्रोहता लै ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />हारणे आद-लुआदा मांझ़ै तै प्रोहते ज़ुदै-ज़ुदै दल। हारणे तै च़ार शोहरू: अबीहू, नादाब, एलीआजर अर ईतामार। <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />पर हारणे दूई शोहरू नादाब अर अबीहू तै हारणे ज़िऊंदी ज़िता मरी गऐ दै अर तिन्‍नें लुआद बी निं आथी ती किछ़ै हुई दी। तेखअ रहै एलीआजर अर ईतामार प्रोहते कामां करदै। <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />राज़ै दाबेदै बांडै तिंयां ज़ुदै-ज़ुदै दला दी संघा सभाल़अ तिन्‍नां का तिन्‍नों काम। एलीआजरे आद-लुआदा मांझ़ै छ़ांटअ तेऊ सदोक अर ईतामारे आद-लुआदा मांझ़ै छ़ांटअ तेऊ आहीमोलक।<verse eid="1CH 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 24:4" />एलीआजर प्रोहते आद-लुआदा मांझ़ै बणाऐं तेऊ सोल़ा दल अर ईतामारे आद-लुआदा मांझ़ै बणाऐं आठ दल। किल्हैकि एलीआजरे खिंबा दी थिई आजू खास्सी टोली। <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />एलीआजर अर ईतामार दुहीए आद-लुआदा मांझ़ै छ़ांटै बिधाता सेटा परच़ी पाई, पबित्र ज़ैगा लै कार-करिंदै अर प्रोहत। <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />लेबी गोत्रा का थिअ नतनेलो शोहरू शमयाह, सह थिअ शास्त्री अर काईथ, तेऊ डाहै तिन्‍नां सोभी दले सैणें नाअं लिखी अर तेते शाजत तै राज़अ दाबेद, तेऊए कार-करिंदै, सदोक प्रोहत, अबतारो शोहरू आहीमोलक, प्रोहत अर लेबी गोत्रे सोभी टोलीए सैणैं। एलीआजर अर ईतामारे आद-लुआदा मांझ़ै निखल़ै परच़ी पाई इने नाअं:<verse eid="1CH 24:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="1CH 24:7" />पैहली परच़ी दी निखल़अ जेहोयारीबो नाअं।</para>
  <para style="li" vid="1CH 24:7">दुजी परच़ी दी निखल़अ जदायो नाअं।<verse eid="1CH 24:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="1CH 24:8" />चिऊथी परच़ी दी निखल़अ हारीमो नाअं।</para>
  <para style="li" vid="1CH 24:8">च़ौथी परच़ी दी निखल़अ सोरीमो नाअं।<verse eid="1CH 24:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="1CH 24:9" />पांज़ूई परच़ी दी निखल़अ मलकिजो नाअं</para>
  <para style="li" vid="1CH 24:9">छ़हुई परच़ी दी निखल़अ मिजामीनो नाअं।<verse eid="1CH 24:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="1CH 24:10" />सातुई परच़ी दी निखल़अ हकोज़ो नाअं।</para>
  <para style="li" vid="1CH 24:10">आठुई परच़ी दी निखल़अ अबियाहो नाअं।<verse eid="1CH 24:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="1CH 24:11" />नहुई परच़ी दी निखल़अ जेशूओ नाअं।</para>
  <para style="li" vid="1CH 24:11">दसुई परच़ी दी निखल़अ शकनयो नाअं।<verse eid="1CH 24:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="1CH 24:12" />गैर्हूई परच़ी दी निखल़अ एलियाशिबो नाअं।</para>
  <para style="li" vid="1CH 24:12">बार्हूई परच़ी दी निखल़अ जाकीमो नाअं।<verse eid="1CH 24:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="1CH 24:13" />तेर्हुई परच़ी दी निखल़अ हुप्पो नाअं।</para>
  <para style="li" vid="1CH 24:13">च़ौदुई परच़ी दी निखल़अ जेशबेबो नाअं।<verse eid="1CH 24:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="1CH 24:14" />पंद्रुई परच़ी दी निखल़अ बिलगो नाअं।</para>
  <para style="li" vid="1CH 24:14">सोल़्हुई परच़ी दी निखल़अ इमेरो नाअं।<verse eid="1CH 24:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="1CH 24:15" />स्तार्हुई परच़ी दी निखल़अ हेजीरो नाअं।</para>
  <para style="li" vid="1CH 24:15">ठार्हुई परच़ी दी निखल़अ हापीसेसो नाअं।<verse eid="1CH 24:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="1CH 24:16" />उन्हुंई परच़ी दी निखल़अ पथाहो नाअं।</para>
  <para style="li" vid="1CH 24:16">बिहुई परच़ी दी निखल़अ एजकेलो नाअं।<verse eid="1CH 24:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="1CH 24:17" />इक्‍कुई परच़ी दी निखल़अ जाकीनो नाअं।</para>
  <para style="li" vid="1CH 24:17">बाहुई परच़ी दी निखल़अ गामूलो नाअं।<verse eid="1CH 24:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="1CH 24:18" />त्रेहुई परच़ी दी निखल़अ दलायो नाअं।</para>
  <para style="li" vid="1CH 24:18">च़ौबुई परच़ी दी निखल़अ माजीओ नाअं।<verse eid="1CH 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />इना सोभी दले सैणैं तै ईंयां अर इने नाअं डाहै लिखी अर इना का डाहअ बिधाते भबनै इनो काम सभाल़ी ज़िहअ इज़राईले परमेशर बिधाता तिन्‍नें दादा-बाबे मूल़ हारणा लै हुकम त किअ द।<verse eid="1CH 24:19" /></para>
  <para style="s">लेबी गोत्रे होर लोग</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />लेबीए होरी आद-लुआदा मांझ़ै थिऐ ईंयां आपणीं-आपणीं टोलीए सैणैं:</para>
  <para style="p" vid="1CH 24:20">अमरामे टोली दी त आजू शूबाएले आद-लुआदा मांज़ै जेहदीया।<verse eid="1CH 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 24:21" />रहाबयाहे आद-लुआदा मांझ़ै त इशिया।<verse eid="1CH 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 24:22" />इसहारे टोली दी थिअ शेलोमीते आद-लुआदा मांझ़ै जहात।<verse eid="1CH 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 24:23" />हेब्रोने टोली दी थिऐ ज़ेठै का कान्हीं अमरे साबै जरीयाह, अमर्या, जहजीएल अर जकमाम सैणैं।<verse eid="1CH 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 24:24" />उज्जीएले टोली दी थिअ मिके आद-लुआदा मांझ़ै शामीर,<verse eid="1CH 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 24:25" />उज्जीएले ई टोली दी मिके भाऊ इशिये आद-लुआदा मांझ़ै जकर्या सैणअ।<verse eid="1CH 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 24:26" />मरारी टोली दी थिऐ महली, मूशी अर जजीयाह। <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />जजीयाहे शोहरू आसा तै: शोहाम, जक्‍कूर अर इबरी। <verse eid="1CH 24:27" /><verse number="28-29" style="v" sid="1CH 24:28-29" />महलीए तै दूई शोहरू: एलीआजर अर कीश। एलीआजरे निं शोहरू आथी तै हुऐ दै पर कीशा का थिअ एक शोहरू तेऊ नाअं त जेहरमील। <verse eid="1CH 24:28-29" /><verse number="30" style="v" sid="1CH 24:30" />मूशीए थिऐ चअन शोहरू: महली, एदेर अर जरमोत।</para>
  <para style="p" vid="1CH 24:30">ईंयां ती लेबीए आजू आद-लुआद।<verse eid="1CH 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />हारणे आद-लुआदा ज़िहअ दैनअ इना होरी लै बी बिधाता सेटा परच़ी पाई काम बांडी। सह निं होछ़ै-बडै भाल़ी किअ। परच़ी पाआ तै राज़ै दाबेद, तेऊए, कार-करिंदै, सदोक प्रोहत, अबतारो शोहरू आहीमोलक अर प्रोहत अर लेबी गोत्रे सोभी टोलीए सैणें आछी सम्हनै ताकि तिंयां तेते शाजत होए।<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">राज़ै दाबेदे गाज़ै-बाज़ै आल़ै</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />राज़ै दाबेद अर बिधाते भबने कार करिंदै दैनी इना टोली लै गाज़ै-बाज़े ज़िम्मैंबारी: असाप, हमान अर जदूतून। तिन्‍नों काम त बींन अर छ़छ़ाल़ा बाज़ी बिधाते गल्‍ला प्रगट करनीं। बिधाता सेटा गाज़ै-बाज़ै आल़ै अर तिन्‍नें ज़ुदै-ज़ुदै काम थिऐ ईंयां:<verse eid="1CH 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 25:2" />असापे च़ार शोहरू: जक्‍कूर, युसुफ, नतानिया अर असरेला। तिंयां करा तै असापे ढेओऐ च़ाकरी। ज़ेभै-ज़ेभै राज़ैओ हुकम हआ त, तेभै-तेभै करा त असाप गाज़ै-बाज़ै संघै बिधाते गल्‍ला प्रगट करी।<verse eid="1CH 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 25:3" />जदूतूने तै छ़ह शोहरू: गदाली, सरी, ईशायाह, शिमी, हशाबिया अर मत्तितियाह। तिंयां करा तै आपणैं बाब जदूतूने ढेओऐ च़ाकरी। तिन्‍नों त बिधाते शूकर करना लै बींन अर गाज़ै-बाज़ै संघै गिहा बोल़णैंओ काम।<verse eid="1CH 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 25:4" />हमाने तै च़ौदा शोहरू: बुकियाह, मतानियाह, उज्जीएल, शबूएल, जरमोत, हनन्याह, हनानी, एलीआता, गदालती, रोमामती-एजेर, जोशबकाशा, मलोथी, होतीर अर महजीओत। <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />परमेशरे बढेरअ हमान इहअ कि सह थिअ राज़ैओ गूर बी। तेऊए तै ईंयां च़ौदा शोहरू अर चअन ती तेऊए शोहरी बी। <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />तेऊए सोभ शोहरू बाज़ा तै तेऊ पिछ़ू खल़ै हई बिधाते स्तोती करना लै बींन अर छ़छ़ाल़ा। असाप, जदूतून अर हमान करा तै ज़िहअ राज़ै हुकम किअ तेऊ साबै काम।<verse eid="1CH 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 25:7" />ईंयां च़ौबी ज़ण्हैं तै गाज़ै-बाज़े खास्सै ज़ाण-प्रबीण अर तिन्‍नां संघै होर लेबी बी थिऐ बिधाते गिहा बोल़णा लै ताल-बाल शिखल़ै दै। ईंयां तै पठी दूई शौ ठास्सी ज़ण्हैं।<verse eid="1CH 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 25:8" />राज़ै दाबेदै बांडी इना सोभी लै च़ाकरी बिधाता सेटा परच़ी पाई। तेता लै निं होछ़अ-बडअ, गूरू-च़ेल्‍लअ, सज़ाण-कज़ाण भाल़अ।<verse eid="1CH 25:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="1CH 25:9" />पैहली परच़ी दी निखल़अ असापे टोली मांझ़ै युसुफो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।</para>
  <para style="li" vid="1CH 25:9">दुजी परच़ी दी निखल़अ गदालीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="1CH 25:10" />चिऊथी परच़ी दी निखल़अ जक्‍कूरो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="1CH 25:11" />च़ौथी परच़ी दी निखल़अ ईसरीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="1CH 25:12" />पांज़ूई परच़ी दी निखल़अ नतानियो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="1CH 25:13" />छ़हुई परच़ी दी निखल़अ बुकियाहो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="1CH 25:14" />सातुई परच़ी दी निखल़अ जसरेलो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="1CH 25:15" />आठुई परच़ी दी निखल़अ ईशायाह गूरो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="1CH 25:16" />नहुई परच़ी दी निखल़अ मतानियाहे नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="1CH 25:17" />दसुई परच़ी दी निखल़अ शिमीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="1CH 25:18" />गैर्हूई परच़ी दी निखल़अ अजरेलो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="1CH 25:19" />बार्हूई परच़ी दी निखल़अ हशाबिओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="1CH 25:20" />तेर्हुई परच़ी दी निखल़अ शूबाएलो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:20" /></para>
  <para style="li">
    <verse number="21" style="v" sid="1CH 25:21" />च़ौदुई परच़ी दी निखल़अ मत्तितियाहो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="1CH 25:22" />पंद्रुई परच़ी दी निखल़अ जरमोतो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="1CH 25:23" />सोल़्हुई परच़ी दी निखल़अ हनन्याहो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="1CH 25:24" />स्तार्हुई परच़ी दी निखल़अ जोशबकाशो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="1CH 25:25" />ठार्हुई परच़ी दी निखल़अ हनानीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="1CH 25:26" />उन्हुंई परच़ी दी निखल़अ मलोथीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:26" /></para>
  <para style="li">
    <verse number="27" style="v" sid="1CH 25:27" />बिहुई परच़ी दी निखल़अ एलीआतो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="1CH 25:28" />इक्‍कुई परच़ी दी निखल़अ होतीरो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:28" /></para>
  <para style="li">
    <verse number="29" style="v" sid="1CH 25:29" />बाहुई परच़ी दी निखल़ा गदालतीओ नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:29" /></para>
  <para style="li">
    <verse number="30" style="v" sid="1CH 25:30" />त्रेहुई परच़ी दी निखल़अ महजीओतो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:30" /></para>
  <para style="li">
    <verse number="31" style="v" sid="1CH 25:31" />च़ौबुई परच़ी दी निखल़अ रोमामती-एजेरो नाअं अर तेऊ संघै तै तेऊए शोहरू अर भाई-बंधा संघी बारा ज़ण्हैं।<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">बिधाते भबने पहरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />लेबी गोत्रा मांझ़ै तै तिन्‍नें टोलीए साबै पहरीए ज़ुदै-ज़ुदै दल। कोराह टोली का थिअ असापे आद-लुआदा मांझ़ै कोरो शोहरू मशलेमयाह। <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />मशलेमयाहे तै सात शोहरू तिंयां थिऐ तिन्‍नें अमरे साबै ज़ेठै का कान्हैं तैणीं ईंयां: जकर्या, जदीएल, जबदीया, जतनीएल, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />एलाम, जहोहनान अर एलीहोना।<verse eid="1CH 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 26:4" />ओबेद-एदोमा लै दैनी बिधाता खास्सी बर्गत अर तेऊए हुऐ आठ शोहरू तिंयां थिऐ तिन्‍नें अमरे साबै ज़ेठै का कान्हैं तैणीं ईंयां: शमयाह, जोजबाद, जोआह, साकार, नतनेल, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />अमीएल, इस्साकार अर पलती।<verse eid="1CH 26:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1CH 26:6-7" />ओबेद-एदोमे ज़ेठै शोहरू शमयाहे थिऐ छ़ह शोहरू: ओतनी, रपाएल, ओबेद, एलजाबाद एलीहू अर समाकयाह। इना सोभिओ त तिन्‍नें टोली दी खास्सअ अदर किल्हैकि ईंयां मशूर शूरबीर अर खिरीए दूई ज़ण्हैं तै होर बी खास्सै छ़ल़ैघ।<verse eid="1CH 26:6-7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 26:8" />ओबेद-एदोमे आद-लुआदा मांझ़ै तै बाहठ ज़ण्हैं पहरै लै बलबान मणछ।<verse eid="1CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 26:9" />मशलेमयाहे आद-लुआदा मांझ़ै तै ठारा बलबान मणछ।<verse eid="1CH 26:9" /></para>
  <para style="p">
    <verse number="10-11" style="v" sid="1CH 26:10-11" />मरारी टोली का थिअ होसाह अर तेऊए तै च़ार शोहरू: शिम्री, हिलकिया, तबलयाह अर जकर्या। शिम्री निं होसाहो ज़ेठअ शोहरू आथी त पर सह थिअ तेऊ आपणैं टबरो सैणअ बणाअं द। होशे टबरा मांझ़ै छ़ांटै पठी तेर्हा ज़ण्हैं बिधाते भबने पहरी।<verse eid="1CH 26:10-11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />भबने पहरी बी थिऐ तिन्‍नें टोलीए सैणें साबै ज़ुदै-ज़ुदै दला दी बांडै दै अर तिन्‍नां लै बी दैनअ होरी लेबी ज़िहअ बिधाते भबने पहरै करनैओ काम बांडी। <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />सोभी लै दैनअ बिधाता सेटा परच़ी पाई काम बांडी। तेथ निं तिन्‍नैं होछ़अ-बडअ भाल़अ। <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />पुर्बा बाखा प्रऊल़ीए पहरै करने परच़ी निखल़ी शेलेमयाहे नाओंऐं। तेऊओ शोहरू जकर्या त बडअ समझ़कार बज़ीर अर तेखअ निखल़ी तेऊए नाओंऐं परच़ी उतरा बाखा प्रऊल़ीए पहरै करना लै। <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />दखणा बाखा प्रऊल़ीए पहरै करने परच़ी निखल़ी ओबेद-एदोमे नाओंऐं अर तेऊए शोहरू छ़ांटै भढारा पहरी। <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />तेखअ निखल़ी शुप्पी अर होसाहे नाओंऐं परच़ी, तिन्‍नां लै सभाल़ी पछ़मा बाखे प्रऊल़ अर प्रैंधल़ी बाता शलकेत नाओंए प्रऊल़ी दी पहरै करने ज़िम्मैंबारी। पहरी लागा त एकी बाद दुजै बारी-बारी आपणैं-आपणैं बगता दी पहरअ करनअ। <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />हर धैल़ै हआ तै लेबी मांझ़ा का बिधाते भबनै पुर्बा बाखा छ़ह पहरी, उतरा बाखा च़ार, दखणा बाखा च़ार पहरी। दूई भढारै हआ तै दूई-दूई पहरी डाहै दै। <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />पछ़मा बाखा हआ तै च़ार पहरी डाहै दै। दूई धरनीं प्रऊल़ी आजू बाता अर दूई हआ तै प्रैंदै च़बारू दी। <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />एही थिई कोराह अर मरारी टोली लै पहरै करने ज़िम्मैंबारी सभाल़ी दी।<verse eid="1CH 26:19" /></para>
  <para style="s">बिधाते भबनै होर च़ाकरी</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />कोराह अर मरारी टोली मांझ़ै ज़ुंण होर लेबी थिऐ, तिन्‍नां मांझ़ै बणाअं आहिजा बिधाते भबनै भैंट किई दी च़िज़ा अर दुही भढारो दरोगअ।<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />लादान थिअ गर्शोनी टोली का, सह थिअ जेहीएलो बाब। तैहा टोली दी थिऐ तेऊए आद-लुआदा मांझ़ै आपणैं-आपणैं खिंबे कई सैणैं। <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />जेहीएलै तै दूई शोहरू: जताम अर जोएल। तिंयां थिऐ भढारे दरोगै बणाऐं दै।<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />होर थिऐ बिधाते भबने भढारै च़ाकरी करनै आल़ै कहात, अमराम, इसहार, हेब्रोन अर उज्जीएले टोली मांझ़ै।<verse eid="1CH 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 26:24" />शबूएल थिअ मोसे शोहरू गर्शोमे टोली का। सह थिअ बिधाते भढारो सैणअ। <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />गर्शोमे भाई एलीआजरे आद-लुआद थिऐ बाबा का आजू शोहरू इहै: रहाबयाह, ईशायाह, जोराम, ज़िक्री अर शेलोमीत। <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />शेलोमीत अर तेऊए भाई-बंध थिऐ राज़ै दाबेदै, सैनापति, दलपति, खिंबे खास-खास मणछ अर टोलीए सैणैं बिधाता लै भैंट किई दी सोभी च़िज़े भढारी डाहै दै। <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />ज़ेभै बी जुधा का किज़ै किम्मती च़िज़ा ज़िती आणा तै, तेता मांझ़ै डाहा तै ईंयां बिधाते भबने मराम्मती करना लै धख-धख ज़ुदअ। <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />ज़ुंण च़िज़ा शमूएल गूरै, कीशे शोहरू राज़ै शाऊलै, नेरीए शोहरू अबनेरै अर सरूयाहे शोहरू जोआबै ज़ुंण च़िज़ा बिधाते भबने कामां लै ज़ुदी पबित्र थिई डाही दी, तिन्‍नां च़िज़े भढारी बी थिऐ शेलोमीत अर तेऊए भाई-बंध।<verse eid="1CH 26:28" /></para>
  <para style="s">होरी लेबीए ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />इसहारी टोली का थिऐ कननया अर तेऊए शोहरू, तिंयां थिऐ राज़े दरोगै अर पांच़। तिन्‍नां लै हआ त इज़राईली परज़ा मांझ़ै झ़गल़े फैंसलै करनै अर तिन्‍नां सोभी गल्‍ला लिखी डाहणेंओ काम।<verse eid="1CH 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 26:30" />हेब्रोन टोली का थिअ हशाबिया, तेऊए भाई-बंधा मांझ़ै थिऐ एक हज़ार सात शौ। तिंयां थिऐ सोभ ज़ाण-प्रबीण अर राज़े पांच़। तिन्‍नां लै थिई जरदण नदी पछ़मा बाखा परज़े फैंसलै अर इज़राईले परमेशर बिधाते होर काम काज़ करने ज़िम्मैंबारी सभाल़ी दी। <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेब्रोन टोली दी आसा जरीयाह सैणअ। राज़ै दाबेदे राज़ा दी च़ाल़्हुई साला पल़ी हेब्रोने आद-लुआदे पुछ़ अर गलाद मुल्खै ज़जार भेटै तिन्‍नें खास्सै शूरबीर। <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />जरीयाहे भाई-बंधा मांझ़ै निखल़ै तै दूई हज़ार सात शौ शूरबीर। राज़ै दाबेदै छ़ाडै तिंयां जरदण नदी पुर्बा बाखा संघा सभाल़ी तिन्‍नां का तिधी बस्सै दै बिधाते सोभी कामां लै रूबेन, गाद अर आधै मनिश्शे गोत्रे ज़िम्मैंबारी।<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">सैने दल अर सैनापति</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />इज़राईले सैना ती बारा दला दी बांडी दी। हर भिन्‍नैं करा त च़ौबी हज़ार पल़टणो एक-एक दल आपणीं-आपणीं बारी दी राज़े च़ाकरी। इज़राईली टोलीए सैणैं अर कार-करिंदै मांझ़ै हआ तै तिन्‍नां दला प्रैंदै एकी-एकी भिन्‍नैं लै ज़ुदै-ज़ुदै सैनाध्यक्ष:<verse eid="1CH 27:1" /></para>
  <para style="li">
    <verse number="2" style="v" sid="1CH 27:2" />च़ैत्रे भिन्‍नैं ती च़ौबी हज़ार पल़टणें दला प्रैंदै जबदीएलो शोहरू जाशोबीमे बारी। <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />सह थिअ यहूदा गोत्रे फिरिस टोली का अर च़ैत्रे भिन्‍नैं सोभी दलपति अर सैनापति प्रैंदै सैनाध्यक्ष।<verse eid="1CH 27:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="1CH 27:4" />बशाहे भिन्‍नैं लै थिअ च़ौबी हज़ार पल़टणें दुजै दला प्रैंदै अहोह टोली का दोदी सैणअ। मिकलोत थिअ तेऊ दलो सैनापति।<verse eid="1CH 27:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="1CH 27:5" />ज़ेठै भिन्‍नैं लै थिअ च़ौबी हज़ार पल़टणें चिऐ दला प्रैंदै जहोयादा प्रोहतो शोहरू बेनियाह सैनाध्यक्ष। <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />बेनियाह त राज़ै दाबेदे तिहा जोधै प्रैंदै प्रधान अर तेऊओ शोहरू अमीजाबाद थिअ तेऊ दलो सैनापति।<verse eid="1CH 27:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="1CH 27:7" />जोआबो भाई असाहेल थिअ च़ौबी हज़ार पल़टणें च़ौथै दलो सैनाध्यक्ष ज़सरी बारी शाल़्है एछा ती। असाहेलो शोहरू जबदीया थिअ तेऊ दलो सैनापति।<verse eid="1CH 27:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="1CH 27:8" />इज्राही टोली का शमहूत थिअ च़ौबी हज़ार पल़टणें पांज़ूऐ दलो सैनाध्यक्ष ज़सरी बारी शाऊंणैं एछा ती।<verse eid="1CH 27:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="1CH 27:9" />तकोआ नगरी का इकेशो शोहरू ईरा थिअ च़ौबी हज़ार पल़टणें छ़हुऐ दलो सैनाध्यक्ष ज़सरी बारी भदरै एछा ती<verse eid="1CH 27:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="1CH 27:10" />एप्रैमे आद-लुआदा मांझ़ै पेलोन नगरी का हेलेस थिअ च़ौबी हज़ार पल़टणें सातुऐ दलो सैनाध्यक्ष ज़सरी बारी शऊजै एछा ती।<verse eid="1CH 27:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="1CH 27:11" />जेराह टोलीओ हुशाई नगरी का सिबकै थिअ च़ौबी हज़ार पल़टणें आठुऐ दलो सैनाध्यक्ष ज़सरी बारी काती एछा ती।<verse eid="1CH 27:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="1CH 27:12" />बिन्यामीने आद-लुआदा मांझ़ै अनातोत नगरी का एबीएजेर थिअ च़ौबी हज़ार पल़टणें नहुऐ दलो सैनाध्यक्ष ज़सरी बारी मकशीरै एछा ती।<verse eid="1CH 27:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="1CH 27:13" />नतपाह नगरी का जेराह टोलीओ महरै थिअ च़ौबी हज़ार पल़टणें दसुऐ दलो सैनाध्यक्ष ज़सरी बारी पोशै एछा ती।<verse eid="1CH 27:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="1CH 27:14" />एप्रैमे आद-लुआदा मांझ़ै पिरातोन नगरीओ बेनियाह थिअ च़ौबी हज़ार पल़टणें गैर्हुऐ दलो सैनाध्यक्ष ज़सरी बारी माघै एछा ती।<verse eid="1CH 27:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="1CH 27:15" />ओतनिएले आद-लुआदा मांझ़ै नतपाह नगरी का हेलदाई थिअ च़ौबी हज़ार पल़टणें बार्हूऐ दलो सैनाध्यक्ष ज़सरी बारी फागणै एछा ती।<verse eid="1CH 27:15" /></para>
  <para style="s">इज़राईले सोभी गोत्रा लै दरोगै</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />इज़राईली गोत्रा लै थिऐ ईंयां सैणैं दरोगै डाहै दै:</para>
  <para style="li" vid="1CH 27:16">रूबेन गोत्रा लै थिअ बेन-ज़िक्रीओ शोहरू एलीआजर दरोगअ।</para>
  <para style="li" vid="1CH 27:16">शमौन गोत्रा लै थिअ शपताहो शोहरू माकाहा दरोगअ।<verse eid="1CH 27:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="1CH 27:17" />लेबी गोत्रा लै थिअ बेन-कमूएलो शोहरू हशाबिया दरोगअ।</para>
  <para style="li" vid="1CH 27:17">हारणे आद-लुआदा लै थिअ सदोक दरोगअ।<verse eid="1CH 27:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="1CH 27:18" />यहूदा गोत्रा लै थिअ एलीहू दरोगअ ज़ुंण दाबेदो भाई थिअ।</para>
  <para style="li" vid="1CH 27:18">इस्साकार गोत्रा लै थिअ बेन-मिकाईलो शोहरू ओमरी दरोगअ।<verse eid="1CH 27:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="1CH 27:19" />ज़बलून गोत्रा लै थिअ बेन-ओबेदियो शोहरू इशमाया दरोगअ।</para>
  <para style="li" vid="1CH 27:19">नप्ताली गोत्रा लै थिअ बेन-अजरीएलो शोहरू जरमोत दरोगअ।<verse eid="1CH 27:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="1CH 27:20" />एप्रैम गोत्रा लै थिअ अजाज्यो शोहरू होशे दरोगअ।</para>
  <para style="li" vid="1CH 27:20">मनिश्शे गोत्रा मांझ़ै आधै ज़ुंण जरदण नदी पार पछ़मा बाखा बाढै तै बस्सै दै,</para>
  <para style="li" vid="1CH 27:20">तिन्‍नां लै थिअ पदायो शोहरू जोएल दरोगअ।<verse eid="1CH 27:20" /></para>
  <para style="li">
    <verse number="21" style="v" sid="1CH 27:21" />मनिश्शे गोत्रा मांझ़ै आधै ज़ुंण जरदण नदी आर पुर्बा बाखा बाढै गलाद तै बस्सै दै,</para>
  <para style="li" vid="1CH 27:21">तिन्‍नां लै थिअ बेन-जकर्यो शोहरू ईदू दरोगअ।</para>
  <para style="li" vid="1CH 27:21">बिन्यामीन गोत्रा लै थिअ अबनेरो शोहरू जासीएल दरोगअ।<verse eid="1CH 27:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="1CH 27:22" />दान गोत्रा लै थिअ बेन-जेरोहामो शोहरू अजरेल दरोगअ।</para>
  <para style="p" vid="1CH 27:22">ईंयां एतरै सैणैं थिऐ इज़राईली गोत्रा लै दरोगै छ़ांटै दै। <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" />इज़राईला दी ज़ुंण बिहा साला का होछ़ी अमरे थिऐ, तिन्‍नें निं राज़ै दाबेदै गणांई किई आथी। किल्हैकि बिधाता त इहअ बोलअ द कि इज़राईले आद-लुआद लोल़ी सरगे तारै ज़ेही खास्सी हुई। <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />सरूयाहो शोहरू जोआब त सोभी इज़राईलीए गणांई करदअ लागअ द पर सह निं तेता पूरी करी सकअ। तैहा गणांई करनै पिछ़ू पल़अ इज़राईली लै बिधातो कोप। इहअ करै निं राज़ै दाबेदै इतिहासे कताबा दी लिखअ द आथी कि पठी इज़राईली असली दी आसा केतरै थिऐ।</para>
  <para style="s" vid="1CH 27:24">राज़े ज़ैदाते दरोगै</para>
  <para style="p" vid="1CH 27:24">ईंयां एतरै थिऐ राज़े ज़ैदाता सभाल़दै ज़ुदै-ज़ुदै दरोगै बणाऐं दै:<verse eid="1CH 27:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />आदीएलो शोहरू अज़मबेथ राज़े मैहले भढारो दरोगअ।</para>
  <para style="li1" vid="1CH 27:25">राज़े ज़ुंण भढार सारै इज़राईल देशै नगरी, गहल़ै अर गराऊंऐं थिऐ, तेतो दरोगअ थिअ उज़ियाहो शोहरू जोनातान।<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />कालूबो शोहरू एज्री थिअ राज़े ज़िम्मीं दी काम करनै आल़ै बेठूओ दरोगअ।<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />रामाह नगरी का शिमी थिअ राज़े सोभी दाखे बागो दरोगअ।</para>
  <para style="li1" vid="1CH 27:27">शापाम नगरीओ जबदी थिअ तेऊ संघै दाखे रसे भढारो दरोगअ।<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />गदेरा नगरीओ बाल-हनान थिअ यहूदा दखण बाखा जैतून अर फेडूए बूटे बागो दरोगअ</para>
  <para style="li1" vid="1CH 27:28">जैतूने सोभी तेले भढारो दरोगअ थिअ जोआश।<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />शारोन सऊंऐं मुल्खै गाऊई-बल्दो दरोगअ थिअ शारोन नगरीओ शितराई।</para>
  <para style="li1" vid="1CH 27:29">शारोन धारा बाखा खागै डागै-धणों दरोगअ थिअ अदलाईओ शोहरू शापात।<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />सोभी ज़ैगा राज़े ऊँटो दरोगअ थिअ इशमाईली ओबील।</para>
  <para style="li1" vid="1CH 27:30">सोभी ज़ैगा राज़े ज़ेतरी गाधी थिई, तिन्‍नों दरोगअ थिअ मरनोत नगरीओ जेहदीया।<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />हागार नगरीओ जाजीज थिअ राज़ै दाबेदे सोभी भेडा-बाकरीए हेल़्हीओ दरोगअ।<verse eid="1CH 27:31" /></para>
  <para style="s">राज़ै दाबेदे आपणैं खास बज़ीर</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />राज़ै दाबेदे च़ाच़ूओ शोहरू जोनातान थिअ शास्त्री अर तेऊओ काईथ बी, सह दैआ त बडी सैणीं सलाह। सह अर हाकमोनीओ शोहरू जेहीएल थिऐ राज़ै दाबेदे बज़ीर अर राज़े शोहरू लै गूरू बी थिऐ तिंयां ई। <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />आहीतपेल बी थिअ राज़ैओ मंत्री अर अरेकी नगरीए हुशाई संघै थिई राज़ै दाबेदे साथ अर सह बी थिअ तेऊओ खास सलाह दैणैं आल़अ बज़ीर। <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />आहीतपेला मरनै का बाद तै बेनियाहो शोहरू जहोयादा अर अबतार राज़ै दाबेदे बज़ीर।</para>
  <para style="p" vid="1CH 27:34">जोआब थिअ इज़राईले सारी सैना प्रैंदै सैनापति।<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">बिधाते भबना बणाणें बारै डाहअ राज़ै दाबेदै खोज़ी बोली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />राज़ै दाबेदै किअ हुकम कि इज़राईले सोभ कार-करिंदै, हआ एरुशलेम नगरी कठा। तेखअ हुऐ सोभी गोत्रा प्रैंदै राज़ै डाहै दै दरोगै, इज़राईली सोभी टोलीए सैणैं, राज़ै अर राज़े शोहरूए ज़िम्मीं-ज़ैगा, डागै-चैणैं अर होर ज़ैदात सभाल़णैं आल़ै दरोगै, सोभी ज़ैगा का राज़े पांच़, सैना दी खास-खास जोधै, दलपति अर सैनापति एरुशलेम कठा।<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />ज़ांऊं सभा शुरू हुई, तेखअ उझ़ुअ राज़अ दाबेद खल़अ संघा बोलअ तिन्‍नां लै, “मेरै साथीओ! मेरी परज़े लोगो, मेरी गल्‍ल शूणां। बिधाते करारो मणशू ज़ुंण परमेशरे खूरा हेठै च़ौकी आसा, तेता लै च़ाहा हुंह बसेरअ बणाणअं कि सह सदा तिधी रहे। बिधाते तेऊ भबना बणाणां लै आसा मंऐं सोभै च़िज़ा झाल़ी हेरी दी। <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />पर बिधाता बोला मुल्है इहअ कि तेऊ निं मेरै हाथै आप्पू लै भबन बणनैं दैणअ किल्हैकि मंऐं किऐ खास्सै जुध अर तेथ मारै मंऐं खास्सै मणछ। <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />बिधाता छ़ांटअ यहूदा कि सह सोभी इज़राईली प्रैंदै राज़ करे। यहूदा गोत्रा मांझ़ै छ़ांटअ मेरै बाबो खिंब अर तेता मांझ़ै छ़ांटअ बिधाता हुंह कि सोभी इज़राईली प्रैंदै राज़अ होए अर आजू लै बी आसा तेऊ एही करार किई दी कि मेरी आद-लुआदा मांझ़ै रहणअ कुंण नां कुंण ज़रूर राज़अ। <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />बिधाता दैनी मुल्है एही बर्गत कि मेरै हुऐ खास्सै शोहरू, पर तिन्‍नां सोभी शोहरू मांझ़ै छ़ांटअ बिधाता मेरअ शोहरू सुलैमान कि सह मुंह बाद इज़राईला प्रैंदै राज़अ बणी बिधातो राज़ सभाल़े।<verse eid="1CH 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 28:6" />“बिधाता बोलअ मुल्है इहअ, ‘तेरै शोहरू सुलैमाना बणाणअं मुल्है मेरअ अदर करना लै भबन। सह हणअ मुल्है मेरै शोहरू ज़िहअ अर हुंह हणअ तेऊ लै बाबा ज़िहअ। <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />ज़ै सह मेरअ बधान अर तेते सोभै हुकम मने, तै रहणअ तेऊओ राज़ सदा बणी।’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“मेरै साथीओ, ऐबै बोला हुंह परमेशर अर सारी इज़राईली सभा शाजत मनी तम्हां बिधाते परज़ा लै इहअ कि बिधाते हुकम मनणा लै रहै शुचै-पाक्‍कै ताकि तम्हैं एऊ रज़दै-पज़दै देशै बस्सी अर तम्हां बाद आजू थारी आद-लुआद सदा एऊ देशे मालक रहे।”<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />तेखअ बोलअ राज़ै दाबेदै आपणैं शोहरू सुलैमाना लै, “मेरै शोहरूआ, आपणैं बाबे परमेशरे बारै शिखल़ सोभी गल्‍ला संघा रहै शुचअ-पाक्‍कअ रही कोहरै मनै तेऊए च़ाकरी करदअ लागी। तेऊ का आसा सोभी गल्‍लो थोघ कि तूह किज़ै सोठा अर किज़ै च़ाहा। ज़ै तूह बिधाता सेटा डेओए तेऊ हेरनी तेरी अरज़ शूणीं, पर ज़ै तूह तेऊ का उंबल़ी बाखा फिरे, तै डाहणअ हेरे तूह तेऊ बी सदा लै शोटी। <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />ऐहा गल्‍लो डाहै धैन हेरे आपणैं पबित्र भबना बणाणां लै आसा बिधाता तूह छ़ांटअ द। ऐबै कर हिम्मत संघा कर तेऊ कामां पूरै ज़ुंण ताखा सभाल़अ।”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />ज़ांऊं राज़अ दाबेद इना गल्‍ला बोली मुक्‍कअ, तेखअ दैनै तेऊ सुलैमाना लै बिधाते भबन, भढार, होरी कमरू, खास पबित्र ज़ैगा अर पापे प्राश्त करने ज़ैगे नक्षै कि किहै-किहै बणाणैं। <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />बिधाते भबने पांड, भबना ओर्ही-पोर्ही ताटी, कमरू, बिधाता लै भैंट किई दी च़िज़ा लै भढार किहै-किहै लोल़ी हुऐ तेते सोभ नक्षै बी दैनै दाबेदै सोभ सुलैमाना का। <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />प्रोहत अर लेबीए केतरै दल अर तिन्‍नां बिधाते भबनै किज़ै-किज़ै काम करनअ अर भबनै बिधाते च़ाकरी लै च़िज़े ज़िम्मैंबारी केही दैणीं तिंयां गल्‍ला बी समझ़ाऊई दाबेदै सुलैमाना का। <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />इहअ बी डाहअ दाबेदै सुलैमाना का खोज़ी कि बिधाते भबने भांडै बणाणां लै केतरअ-केतरअ सुन्‍नअ अर च़ंदी लागणीं। <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />तेता संघै सुन्‍नें दीऐ, सदीऐ, च़ंदीओ मेज़, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />सुन्‍नेंओ मेज़ ज़ेथ प्रैंदै बिधाता लै भैंट किई दी रोटी डाहा, तेता लै आसा सुन्‍नअ-च़ंदी तोली करै डाहअ द ज़ेतरअ-ज़ेतरअ तेथ लागणअ। <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />च़ोखै सुन्‍नें कांडैदार च़िमच़ा, प्रिहै, गलास, कऊली, तेता लै बी आसा सुन्‍नअ-च़ंदी तोली करै डाहअ द ज़ेतरअ-ज़ेतरअ तेथ लागणअ। <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />सुन्‍नें बेदी ज़ेथ धूप ज़ाल़ा अर बिधाते करारे मणशूए ढक्‍कणा प्रैंदै फैंख फुआरै दै सुन्‍नें करूब नाओंए स्वर्ग दूते मुहुर्ती बणाणां लै तोली करै केतरअ-केतरअ सुन्‍नअ लाणअ सह बी आसा डाहअ द।<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />राज़ै दाबेदै बोलअ इहअ, “ज़ेही-ज़ेही बिधाता मुल्है समझ़ दैनी, तेही-तेही आसा मंऐं ईंयां गल्‍ला समझ़ी करै लिखी डाही दी।”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />तेखअ बोलअ राज़ै दाबेदै आपणैं शोहरू सुलैमाना लै इहअ, “तूह निं हैअ चोल़ी, हिम्मत कर संघा कर आपणअ काम शुरू। एता का निं तूह किछ़ू गल्‍ला करै पिछ़ू हटी। परमेशर बिधाता ज़सरी च़ाकरी हुंह करा, सह हणअ ताह संघै आप्पै। सह निं ताह शोटी डाहंदअ। तेऊ करनी ताह संघै रही आपणैं भबने काम पूरै करना लै तेरी मज़त। <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />प्रोहत अर सोभी लेबी लै बी आसा बिधाते भबनै ज़ुदअ-ज़ुदअ काम सभाल़ी हेरअ द। सोभी कामें सज़ाण कारीगीर आसा न्हैल़ै बेठै दै कि काम केभै हआ शुरू कि तिंयां तेरी मज़त करे। सारी परज़ा अर तिन्‍नें सैणैं बी आसा ज़िहअ तूह बोला तिहअ करना लै तैर।”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">बिधाते भबना बणाणां लै भैंट</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />तेखअ बोलअ राज़ै दाबेदै सारी सभा लै, “आपणैं भबना बणाणां लै छ़ांटअ बिधाता मेरअ शोहरू सुलैमान, पर अह आसा अज़ी कज़ाण लान्हअ। अह काम करनअ निं सान आथी किल्हैकि अह निं मणछो आम घअर आथी लाअ द बणाईं अह आसा परमेशर बिधाता लै भबन। <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />तैही आसा मंऐं बिधाते भबना बणाणां ज़ेतरअ हुंह करी सका त तेतरअ समान झाल़ी डाहअ द। सुन्‍नें च़िज़ा बणाणां लै सुन्‍नअ, च़ंदीए च़िज़ा बणाणां लै च़ंदी, कांस्से च़िज़ा बणाणां लै कांस्सअ, ज़िधी लोहअ लागणअ तेता लै आसा लोहअ डाहअ द आणी। किम्मती मणीं, अर संगमरमरे पात्थर बी आसा आणी डाहै दै। <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />होर बी आसा डाही दी मंऐं खास्सी च़िज़ा झाल़ी। आपणीं ज़ैदाता मांझ़ै बी दैनअ मंऐं सुन्‍नअ-च़ंदी बिधाते भबना बणाणां लै किल्हैकि मेरअ दिल आसा बिधाते भबना बणाणां लै लागअ द। <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />मंऐं दैनअ आपणअ कोई गैरा शौ कुंटल़ च़ोखअ सुन्‍नअ अर कोई दूई हज़ार छ़ह शौ कुंटल़ च़ोखी च़ंदी बिधाते भबने भित्ती महल़णा लै। <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ज़िधी कारीगीरा सुन्‍नअ लाणअ तेता लै सुन्‍नअ अर ज़िधी तिन्‍नां च़ंदीए कारीगीरी करनी तेता लै डाही मंऐं च़ंदी दैई। ऐबै बोला हुंह आझ़ तम्हां लै, ‘इहअ कुंण आसा ज़ुंण मुंह ज़ेही बिधाता लै खुल्है हाथै भैंट दैणीं च़ाहा?’”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />तेखअ दैनै सोभी गोत्रा प्रैंदै दरोगै, इज़राईली सोभी टोलीए सैणैं, राज़ै अर राज़े शोहरूए ज़ैदात सभाल़णैं आल़ै दरोगै, सोभी ज़ैगा का राज़े पांच़, सैना दी खास-खास जोधै, दलपति अर सैनापति सोभी ज़ण्हैं ज़ेतरअ तिंयां दैई सका तै तत्त-दिला का बिधाता लै भैंट। <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />बिधाते भबना च़िणना लै दैनअ तिन्‍नैं सोभी कोई एक हज़ार आठ शौ अश्शी कुंटल़ सुन्‍नअ, दस हज़ार सुन्‍नें सिक्‍कै, चअन हज़ार सात शौ पज़ाह कुंटल़ च़ंदी, छ़ह हज़ार सात शौ पज़ाह कुंटल़ कांस्सअ अर सैईंती हज़ार पांज़ शौ कुंटल़ लोहअ। <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />एता का लाऊआ दैनै तिन्‍नैं खास किम्मती पात्थर, तिंयां डाहै तिन्‍नैं बिधाते भढारा बणाणां लै गर्शोनी टोलीए जेहीएला का सभाल़ी। <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />राज़अ दाबेद अर तिधी सारी परज़ा हुऐ खास्सै खुशी कि बिधाते भबना बणाणां लै दैनी तिन्‍नैं सोभी कार-करिंदै खुल्है दिलै भैंट।<verse eid="1CH 29:9" /></para>
  <para style="s">राज़ै दाबेदै किअ बिधातो शूकर</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />तेखअ किई राज़ै दाबेदै सारी परज़ा नदरी एही गिह बोली बिधाते ज़ै-ज़ैकार, “बिधाता, मुंह करनीं तेरी सदा ज़ै-ज़ैकार! तूह आसा सह परमेशर ज़हा मेरअ दाद-बाब इज़राईल मना त। <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />हे बिधाता, तेरअ बल आसा महान अर तेरअ झ़ामण शुझिआ सारै भ्रमंडै। माहा राज़अ आसा तूह ई अर सोभी प्रैंदै आसा तेरअ ई राज़। <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />तूह करा आपणैं बल अर ज़ोरा करै राज़। मणछा सेठ, बलबान अर मशूर करा तूह ई। <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />ऐबै हे परमेशर बिधाता, हाम्हैं करा तेरअ शूकर अर हाम्हां करनीं तेरै महान नाओंए ज़ै-ज़ैकार।<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“अज़ी बी निं मंऐं अर मेरी परज़ा ताल्है असली दी किछ़ बी दैनअ किल्हैकि ईंयां सोभ गल्‍ला आसा हाम्हां लै तंऐं ई दैनी दी। हाम्हैं दैनअ ताल्है सह ज़ुंण तेरअ ई थिअ। <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />बिधाता, ताखा आसा थोघ हाम्हैं आसा ऐहा पृथूई दी थोल़ै धैल़े प्राहुंणैं अर परदेसी, ज़िहै म्हारै दाद-बाब थिऐ। म्हारी अमर आसा छ़ैल्‍ली ज़ेही ज़ुंण हेरा-हेरी उडा।<verse eid="1CH 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 29:16" />“म्हारै परमेशर बिधाता, हाम्हैं झाल़ी अह ज़ैदात तेरै भबना बणाणां लै ताकि तेरै पबित्र नाओं अदर होए। पर ईंयां सोभै च़िज़ा आसा हाम्हां लै तंऐं ई दैनी दी अर ईंयां आसा तेरी ई। <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />मेरै परमेशर, मुखा आसा थोघ कि तूह परखा सोभिओ मन्‍न, तूह हआ तेऊ लै खुश ज़ुंण शुचअ-पाक्‍कअ रहा। मंऐं दैनी ईंयां च़िज़ा ताल्है तत्त-दिला का अर मंऐं भाल़अ कि ऐहा सभा मांझ़ै दैनी ताल्है सोभी मानदारी दी खुशी-खुशी भैंट।<verse eid="1CH 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 29:18" />“म्हारै दाद-बाब आबराम, इसहाक इज़राईले परमेशर बिधाता, तूह करै इहअ कि हाम्हैं लोल़ी सदा इहै ई खुल्है दिलै दैणैं आल़ै हुऐ अर इहै ई लोल़ी हाम्हैं ताल्है शुचै-पाक्‍कै रहै। <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />मेरै शोहरू सुलैमाने मन्‍नैं पाऐ तूह एही कि सह तेरै बधाने सोभी हुकम अर तेते शिक्षा मने अर तेऊए लोल़ी तेरअ भबन बणाहुंअ ज़ेता लै मंऐं एतरी च़िज़ो इंतज़ाम आसा डाहअ द करी।”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />तेखअ किअ राज़ै दाबेदै सारी सभा लै हुकम, “ऐबै करा तम्हैं सोभै आपणैं परमेशर बिधातो शूकर।” सभा दी बेठी दी सारी परज़ा किअ आपणैं दादा-बाबे परमेशर बिधातो शूकर। राज़ै अर सारी परज़ा टेक्‍कअ धरनीं उटै पल़ी बिधाते अदर करना लै माथअ।<verse eid="1CH 29:20" /></para>
  <para style="s">सुलैमानो किअ भिई अभिषेक</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />दुजै धैल़ै किऐ इज़राईली बिधाता लै पशू मेल़-ज़ोल़े बल़ीदान संघा बांडअ आप्पू मांझ़ै शकन। एता का लाऊआ किऐ तिन्‍नैं एक हज़ार बल्द, एक हज़ार रिठ अर एक हज़ार होछ़ै गाभू बल़ीदान अर तिंयां सोभ किऐ तिन्‍नैं बेदी दी पठी हूम अर दाखे रसे अर्घै बी दैनै। <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />तैहा धैल़ी तै सोभै खास्सै खुशी हुऐ दै तिन्‍नैं लाई तिधी बिधाता सेटा खाणां-पिणां लै धामा।</para>
  <para style="p" vid="1CH 29:22">तेखअ किअ तिधी भिई बिधाते नाओंऐं राज़ै सुलैमानो अर सदोको अभिषेक कि सुलैमान आसा ऐबै दाबेदा ज़ैगा राज़अ अर सदोक आसा प्रोहत। <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />इहअ करै बणअ सुलैमान आपणैं बाब राज़ै दाबेदे ज़ैगा राज़अ ज़ुंण राज़ बिधाता त दैनअ द अर सुलैमान हुअ राज़ करना लै सफल अर सारअ इज़राईल देश त तेऊ आपणैं बशै डाहअ द। <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />सोभी कार-करिंदै, शूरबीर अर दाबेदे होरी सोभी शोहरू बी दैनी ज़बान कि तिंयां रहणैं राज़ै सुलैमानो साथ दैणा लै शुचै-पाक्‍कै। <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />बिधाता बणाअं सुलैमान एक महान राज़अ, सोभ देश हआ तै रहैन कि राज़अ सुलैमान किहअ मशूर हुअ। इज़राईला दी निं इहअ मशूर राज़अ कोहै हुअ।<verse eid="1CH 29:25" /></para>
  <para style="s">राज़ै दाबेदे मौत</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />ईशैईए शोहरू राज़ै दाबेदै किअ सारै इज़राईला प्रैंदै <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />च़ाल़्ही साला तैणीं राज़। साता साला ती तेऊए राज़धानी हेब्रोन नगरी अर तेत्ती साला किअ तेऊ राज़धानी एरुशलेम नगरी का इज़राईला प्रैंदै राज़। <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />राज़अ दाबेद ज़िऊअ खास्सी अमरा अर सह मूंअ खास्सी प्रोढी अमरा। आपणअ शोहरू सुलैमान त तेऊए ज़िऊंदी ज़िता तेऊ बाद इज़राईला प्रैंदै राज़अ बेठी गअ द। <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />शुरू का खिरी तैणीं आसा राज़ै दाबेदे इतिहास शमूएल, नातान अर गाद गूरै लिखी डाहअ द। <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />तेऊ लिखै दै इतिहासा पहल़ी करै लागा हाम्हां का थोघ कि दाबेद किहअ बलबान थिअ, तेऊ लै किज़ै-किज़ै हुअ अर तेऊए राज़ा दी इज़राईल देशै अर ओरी-पोरीए होरी देशै किहअ हाल थिअ।<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>