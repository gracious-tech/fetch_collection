  <para style="h">मार्कुस</para>
  <para style="toc1">मार्कुसै लिखअ द खुशीओ समाद</para>
  <para style="toc2">मार्कुस</para>
  <para style="toc3">मार्क.</para>
  <para style="mt1">मार्कुस</para>
  <para style="mt2">मार्कुसै लिखअ द खुशीओ समाद</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: मार्कुस</para>
  <para style="ili">पहल़णैं आल़ै: रोम देशै रहणैं आल़ै विश्वासी</para>
  <para style="ili">सन: 67-69</para>
  <para style="ip">मार्कुसै लिखअ द अह खुशीओ समाद हआ इहअ बोली शुरू, “अह खुशीओ समाद आसा ईशू मसीहे बारै ज़ुंण परमेशरो पूत आसा।” एथ आसा ईशू एक सोभी च़िज़ा प्रैंदै हक डाहणैं आल़अ मालक अर च़ाकरी करनै आल़ै मणछे रुपै रहैऊअ द। तेऊओ हक आसा प्रगट हुअ तेऊए शिक्षा दी, बूरी आत्मां काढणैं अर सोभी लोगे पाप माफी करना लै। एथ बोला ईशू आप्पू लै, “हुंह मणछो पूत।” सह आअ एते तैणीं कि सोभी लोगा पापा का आज़ाद करना लै आपणैं प्राण दैए।</para>
  <para style="ip">मार्कुस निं ईशूए बैण अर शिक्षा दी ज़ोर दैंदअ पर सह दैआ तेऊए कामें बारै ज़ोर। तैही खोज़ा सह तेऊए कथ्या सुंबल़ी, सान अर असर करनै आल़ै साबै। जोहन्‍ना डुबकी दैणैं आल़अ, ईशूए पाणीं दी डुबकी अर तेऊए परिक्षा हणें बारै थोल़ी ज़ेही भेत दैणैं का बाद लागा लिखणैं आल़अ तेभी ईशूए लोग रोगी नरोगै करने च़ाकरीए बारै खोज़दअ। ज़िहअ-ज़िहअ बगत बितदअ लागा तिहै-तिहै लागै तेऊए च़ेल्‍लै तेऊ राम्बल़ै करै समझ़दै, पर ईशूए बरोधी हुऐ होर बी खास्सै दुशमण। खिरी खोज़ा ईशूए संसारे ज़िन्दगीए खिरीए धैल़ै हुई-बिति दी गल्‍ला, ज़ेता मांझ़ै खास तेऊओ क्रूसा दी मरनअ अर मरी करै ज़िऊंदै हणअ आसा।</para>
  <para style="ip">ईशू मसीहे च़ेल्‍लै मांझ़ै ज़ुंणीं सह घोर रित्ती भाल़ी ज़ेता भितरी ईशू क्रूसा दी मारनै का बाद त डाहअ द, तिंयां ती चअन बेटल़ी। स्वर्ग दूतै बोलअ तिन्‍नां लै:</para>
  <para style="imq">“तम्हैं किल्है हुई रहैन! तम्हैं ईशू नासरी लोल़ी आसा लागी दी ज़ुंण क्रूसा दी छ़ड़ाऊअ त? भाल़ा, सह हुअ ज़िऊंदअ अर सह निं इधी आथी। भाल़ा, अह आसा सह ई ज़ैगा, ज़िधी तेऊए ल्हास ती डाही दी।”</para>
  <para style="ipr">(16:6)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">खुशीए समादे शुरूआत 1:1-13</para>
  <para style="io1">गलील मुल्खै ईशूए च़ाकरी 1:14—9:50</para>
  <para style="io1">गलील मुल्खा का एरुशलेम तैणीं हांढ 10:1-52</para>
  <para style="io1">एरुशलेम नगरी खिरीओ हबतअ 11:1—15:47</para>
  <para style="io1">ईशूओ ज़िऊंदै हणअ 16:1-8</para>
  <para style="io1">ज़िऊंदै हई ईशू शुझणअ अर स्वर्गा लै डेऊणअ 16:9-20</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">जोहन्‍ना डुबकी दैणैं आल़ैओ प्रच़ार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मोत्ती 3:1-12</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>; <ref loc="JHN 1:19-28">जोहन्‍ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />अह खुशीओ समाद आसा ईशू मसीहे बारै ज़ुंण परमेशरो पूत आसा। एते शुरूआत हुई इहअ करै: <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />ज़िहअ परमेशरे गूर ईशायाहे कताबा दी आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAT 11:10">मोत्त. 11:10</ref>; <ref loc="MAL 3:1">मला. 3:1</ref>; <ref loc="ISA 40:3">ईशा. 40:3</ref></char></note></para>
  <para style="q" vid="MRK 1:2">“भाल़, मंऐं छ़ाडअ आपणअ दूत ताह आजू-आजू</para>
  <para style="q" vid="MRK 1:2">ताकि सह तेरै एछणें धैल़ी लै बात डाहे बणाईं।<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />शुन्‍नैं रेगीस्ताना का आसा कुंण हाक्‍का लांदअ अर इहअ बोल्दअ लागअ द,</para>
  <para style="q" vid="MRK 1:3">‘प्रभू एछणें धैल़ी लै डाहा बाता शुंहीं-शोधी,</para>
  <para style="q" vid="MRK 1:3">तेऊए सुआगत करना लै रहा सोभ तैर्हुई।’”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />अह दूत थिअ जोहन्‍ना डुबकी दैणैं आल़अ। सह रहा त शुन्‍नैं रेगीस्तानै, अर सह खोज़ा त लोगा का एही गल्‍ला, “आपणैं पापो प्राश्त करा, अर परमेशरा सेटा एछा फिरी, ताकि परमेशर तम्हां माफ करे अर तेखअ दैंऊं हुंह तम्हां लै डुबकी।”<verse eid="MRK 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 1:5" />यहूदा मुल्ख अर एरुशलेम नगरी रहणैं आल़ै खास्सै मणछ डेऊऐ तेऊ सेटा लै अर तिन्‍नैं लई आपणैं-आपणैं पाप मनी जरदण नदी दी तेऊ का डुबकी।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />जोहन्‍ना बान्हां त घेरी ऊँटे ऊने झिकल़ै अर आपणीं कुछी दी बान्हां त च़ाम्भल़ेओ गाचू अर खाणां लै खाआ त रैट्टै अर मखीर।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 राज़. 1:8</ref>; <ref loc="MAT 3:4">मोत्त. 3:4</ref></char></note><verse eid="MRK 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 1:7" />संघा करा त सह इहअ प्रच़ार, “ज़ुंण मुंह बाद एछणैं आल़अ आसा, सह आसा सोभी का महान। इधी तैणीं कि हुंह निं तेऊ सेटा एता जोगी बी आथी कि हुंह तेऊए पोलल़ै खोल्हणैं च़ाकरी करनै आल़अ दास बणी सकूं।<verse eid="MRK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 1:8" />“मंऐं ता दैनी तम्हां लै पाणीं दी डुबकी पर तेऊ दैणीं तम्हां लै पबित्र आत्मां दी डुबकी।”<verse eid="MRK 1:8" /></para>
  <para style="s">ईशूए पाणीं दी डुबकी अर परिक्षा</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">मोत्ती 3:13—4:11</ref>; <ref loc="LUK 3:21">लूका 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />तिन्‍नां धैल़ै आअ ईशू बी गलील मुल्खे नासरत गराऊंआं का जोहन्‍ना सेटा लै, संघा लई तेऊ का जरदण नदी दी डुबकी।<verse eid="MRK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 1:10" />ज़ांऊं ईशू पाणीं जैंदरा का डुबकी दैई उझै निखल़अ, तेभी खुल्हअ तेऊ लै सरग, ईशू भाल़ी सरगा का पबित्र आत्मां पालल़ी ज़ेही आप्पू प्रैंदै एछदी।<verse eid="MRK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 1:11" />परमेशरै बोलअ स्वर्गा का इहअ, “तूह आसा मेरअ पैरअ पूत, हुंह आसा ताखा खुश।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />पबित्र आत्मां निंयं तेभी ईशू शुन्‍नैं रेगीस्ताना लै। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />तिधी रहअ राख्स च़ाल़्ही धैल़ी तैणीं तेऊ परखदअ लागी अर ईशू रहअ शुन्‍नैं रेगीस्तानै बणें ज़ीबा संघै अर स्वर्ग दूत रहै तेऊए च़ाकरी करदै लागी।<verse eid="MRK 1:13" /></para>
  <para style="s">ईशूए च़ाकरीए शुरूआत</para>
  <para style="r">(<ref loc="MAT 4:12-17">मोत्ती 4:12-17</ref>; <ref loc="LUK 4:14">लूका 4:14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />जोहन्‍ना कैद करनै का बाद आअ ईशू गलील मुल्खा लै। तिधी खोज़अ लोगा का तेऊ परमेशरो खुशीओ समाद इहअ बोली, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><char style="wj">“ज़ेते बारै परमेशरै बोलअ त सह बगत गअ पुजी, स्वर्गो राज़ गअ नेल़ एछी। आपणैं पापो प्राश्त करा, परमेशरा सेटा एछा फिरी, अर एऊ खुशीए समादा दी करा विश्वास।” </char><verse eid="MRK 1:15" /></para>
  <para style="s">म्हाछ़ली ढाकणैं आल़ै शादणैं</para>
  <para style="r">(<ref loc="MAT 4:18-22">मोत्ती 4:18-22</ref>; <ref loc="LUK 5:1-11">लूका 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />गलील समुंदरे बाढै हांढदी-फिरदी भाल़ै ईशू शमौन अर तेऊओ भाऊ आन्दरू समुंदरा दी म्हाछ़ली ढाकणा लै ज़ज़ाल़ा पांदै, किल्हैकि तिंयां थिऐ म्हाछ़ली ढाकणैं आल़ै।<verse eid="MRK 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 1:17" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“ज़ेही तम्हैं म्हाछ़ली कठा करदै आसा लागै दै, मुंह संघै च़ाल्‍ला, हुंह सखाऊं तम्हां मेरै च़ेल्‍लै हणां लै मणछ कठा करनै।” </char> <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />तिंयां बी लागै तेभी ज़ज़ाल़ा छ़ाडी तेऊ संघै हांढदै।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />थोल़ै आजू डेऊई भाल़ै ईशू दूई होर भाई, याकब अर तेऊओ भाऊ जोहन्‍ना। तिंयां थिऐ लागै दै आपणैं बाब जबदी संघै किश्ती प्रैंदै बेशी ज़ज़ाल़ा सोहरदै। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />तेऊ शादै तेभी तिंयां बी अर तिंयां लागै आपणैं बाब जबदी होरी मज़दूरा संघै किश्ती दी छ़ाडी तेऊ संघै हांढदै।<verse eid="MRK 1:20" /></para>
  <para style="s">ईशू किअ भूत शाचअ द मणछ नरोगअ</para>
  <para style="r">(<ref loc="LUK 4:31-37">लूका 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />तिधा का पुजै तिंयां कफरनहूम नगरी अर ईशू डेऊअ बशैघे धैल़ी सभागृहा संघा लागअ शिक्षा दैंदअ। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />सोभ लोग हुऐ तिधी तेऊए शिक्षा शूणीं रहैन।</para>
  <para style="p" vid="MRK 1:22">किल्हैकि ईशू निं यहूदी शास्त्री अर फरीसी मणछा ज़ेही शिक्षा दैंदअ त ज़ुंण लोगा का बधाने तिन्‍नां ई गल्‍ला भिई-भिई खोज़ा तै ज़ुंण पैहलै होरी आसा बोली दी। पर सह दैआ त इहै गूरू ज़ेही शिक्षा ज़ेतो तेऊ हक अर आप्पू का थोघ हआ त।<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />तिन्‍नें सभागृहा थिअ तिधी एक मणछ, तेऊ दी थिअ भूत शाचअ द। <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />तेऊ पाई ज़ोरै-ज़ोरै हाक्‍का संघा लागअ इहअ बोल्दअ, “हे ईशू नासरी, हाम्हां भूता निं ताह संघै किछ़ै काम आथी! तूह कै हाम्हां खतम करदअ आसा आअ द? मुखा आसा थोघ कि तूह कुंण आसा, तूह आसा परमेशरै छ़ाडअ द पबित्र।”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ईशू लागअ तिन्‍नां भूता नैरदअ, <char style="wj">“च़ुप्पी रहा, अर एऊ मणछा का निखल़ पोर्ही।” </char> <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />तिंयां भूत निखल़ै तेभी तेऊ मणछा मरोक्‍की करै अर लैल़ा-क्रिंगा पांदी दूर।<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />ऐहा गल्‍ला भाल़ी हुई सोभी लोगा रहैनी अर आप्पू मांझ़ै लागै गल्‍ला करदै, “अह किज़ै गल्‍ल आसा? अह ता कोई नऊंईं शिक्षा आसा! एऊ ता एतरअ हक आसा कि भूता लै बी दैआ पोर्ही निखल़णेंओ हुकम! अर तिंयां बी मना ज़िहअ एऊ बोलअ तिहअ ई!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />इहअ करै लागअ ईशूए बारै ओरी-पोरी गलील मुल्खै सारै दी कई ज़ैगा थोघ।<verse eid="MRK 1:28" /></para>
  <para style="s">भांती-भांतीए रोगी किऐ नरोगै</para>
  <para style="r">(<ref loc="MAT 8:14-17">मोत्ती 8:14-17</ref>; <ref loc="LUK 4:38-41">लूका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />तेखअ डेऊअ ईशू सभागृहा का याकब अर जोहन्‍ना संघै शमौन अर आन्दरू च़ेल्‍ले घअरा लै।<verse eid="MRK 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 1:30" />शमौन पतरासे शाशुई त ज़अर आअ द अर तिन्‍नैं खोज़अ तेभी तेसे बारै ईशू का। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />तेखअ ढाकअ ईशू तैहा नेल़ डेऊई तेसो हाथ संघा झ़ैऊई सह खल़ी, तेसो ज़अर बेठअ तेभी अर सह लागी नढैऊऐ च़ाकरी करदी।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />ज़ांऊं सान्ह पल़ी, तेऊ सेटा लै आणै कई बमार अर भूत शाचै दै मणछ। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />तैहा नगरीए खास्सै मणछ हुऐ तिधी दुआरा आजू कठा। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />तेऊ किऐ खास्सै कई रंगे बमारी दी पल़ै दै दुखी मणछ नरोगै अर खास्सै भूत बी काढै।</para>
  <para style="p" vid="MRK 1:34">ईशू निं तिन्‍नां भूता बोल़णैं ई दैनअ त कि तिंयां तेऊए बारै लोगा का खोज़े, किल्हैकि तिन्‍नां का थिअ तेऊओ थोघ कि सह आसा परमेशरै छ़ाडअ द पबित्र।<verse eid="MRK 1:34" /></para>
  <para style="s">ईशूए कांगनरांगै प्राथणां करनी</para>
  <para style="r">(<ref loc="LUK 4:42-44">लूका 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ईशू उझ़ुअ राची भैणै का आजी अर तिधा का डेऊअ एक कांगनरांगी ज़ैगा लै प्राथणां करदअ। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />पिछ़ू आऐ शमौन अर तेऊए होर साथी तेऊ लोल़ै। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ज़ांऊं तिन्‍नां ईशू भेटअ, तिन्‍नैं बोलअ तेऊ लै, “कई लोग आसा नगरी ताह भाल़ै लागै दै।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“च़ाल्‍ला, हाम्हां डेऊणअ किधी ओरी-पोरी गराऊंआं दी ताकि हुंह प्रच़ार करी सकूं, किल्हैकि हुंह आसा एते ई तैणीं आअ द।”</char> <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />तेखअ डेऊअ ईशू गलील मुल्खै कई ज़ैगा, संघा रहअ सभागृहा प्रच़ार करदअ लागी अर भूत शाचै दै लोगा बी रहअ नरोगै करदअ लागी।<verse eid="MRK 1:39" /></para>
  <para style="s">कोहल़ा का किअ मणछ नरोगअ</para>
  <para style="r">(<ref loc="MAT 8:1-4">मोत्ती 8:1-4</ref>; <ref loc="LUK 5:12-16">लूका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />तिधी आअ एक मणछ ज़हा कोहल़ ती निखल़ी दी। तेऊ टेक्‍कअ ईशू सेटा माथअ संघा किई एही अरज़, “हे प्रभू, ज़ै तूह च़ाहे, तूह सका मुंह एऊ कोहल़ा का शुचअ करी।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ईशू फिरी तेऊए खास्सी झींण संघा छ़ुंअ सह आपणैं हाथा करै संघा बोलअ, <char style="wj">“हुंबी च़ाहा, तूह लोल़ी एभी शुचअ हुअ।” </char><verse eid="MRK 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 1:42" />सह मणछ हुअ तेभी कोहल़ा का नरोगअ अर शुचअ। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />ईशू छ़ाडअ सह एही चतैनगी दैई प्रोहता सेटा लै, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" /><note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेब. 14:1-32</ref></char></note> <char style="wj">“हेरे, ऐहा गल्‍ला निं होरी कोही का खोज़ी। हाँ, प्रोहता सेटा डेऊई एछ आप्पू रहैऊई अर कोहल़ा का शुचै हणें बारै ज़ुंण बधान परमेशरे गूर मोसा आसा खोज़अ द तेऊ साबै दै भैंट, ताकि तिंयां भाल़े कि तूह गअ कोहल़ा का शुचअ हई।”</char><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पर सह डेऊअ तिधा का बागै संघा लागअ कई लोगा का खोज़दअ कि ईशू सह किहअ करै किअ कोहल़ा का शुचअ।</para>
  <para style="p" vid="MRK 1:45">इहअ करै पुजी तिंयां गल्‍ला कई ज़ैगा अर ईशू बी निं लोगा सम्हनै नगरी दी डेऊई सकअ। सह रहअ नगरी बागै किधी कांगनरांगै, पर तेथ बी लागै फेरा-फेर हर ज़ैगा का लोग ईशू सेटा लै एछदै।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">दरंगे बमारी आल़अ ठीक करनअ</para>
  <para style="r">(<ref loc="MAT 9:1-8">मोत्ती 9:1-8</ref>; <ref loc="LUK 5:17-26">लूका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />खास्सै धैल़ै बाद आअ ईशू भिई कफरनहूम नगरी लै अर लोगै शूणअ कि सह आसा एऊ घअरै। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />तेखअ हुऐ तिधी एतरै लोग कठा कि दुआरा आजू निं सिऊंणी सहरनै जोगी ज़ैगा बी रही अर ईशू त तिन्‍नां का परमेशरे बैणा खोज़दअ लागअ द।<verse eid="MRK 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 2:3" />तिधी आणअ लोगै एक मणछ च़ऊ ज़ण्हैं ईशू सेटा लै च़की, तेऊ मणछा त दरंग हुअ द। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />तिधी दुआरा सेटा तै खास्सै मणछ झाल़्हुऐ दै। तिहअ करै निं तिंयां ईशू सेटा पुजी सकै। तिन्‍नैं पेच़अ तेऊ घअरो छ़ाप्पर तैहा सिधा ज़ेथ हेठै ईशू त बेठअ द। ज़ेथ सह दरंगो रोगी थिअ सताऊअ द, सह बछ़ाऊणअ छ़ड़ाऊअ तिन्‍नैं छ़ाप्परा बाती च़ऊ कूणैं राश्शी बान्हीं उंधै ईशूए मुंहां सेटा लै।<verse eid="MRK 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 2:5" />ईशू बोलअ तिन्‍नों विश्वास भाल़ी तेऊ दरंगे मरीज़ा लै,</para>
  <para style="p" vid="MRK 2:5">
    <char style="wj">“शोहरूआ, तेरै पाप हुऐ माफ।”</char><verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />तेखअ कई शास्त्री ज़ुंण तिधी सभा दी थिऐ बेठै दै तिंयां लागै सोठदै, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“अह मणछ इहअ किल्है बोला? अह ता परमेशरे कदर बी निं करदअ, परमेशरा छ़ाडी होर कुंण सका पाप माफ करी?”<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ISA 43:25">ईशा. 43:25</ref></char></note><verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ईशू हेरी तिन्‍नें मन्‍नें गल्‍ला भुझ़ी कि ईंयां किज़ै सोठा, तेखअ बोलअ तिन्‍नां लै,</para>
  <para style="p" vid="MRK 2:8">
    <char style="wj">“तम्हैं आपणैं मन्‍नैं इहअ किल्है आसा लागै दै सोठदै?</char><verse eid="MRK 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 2:9" />
    <char style="wj">“सान किज़ै आसा? एऊ दरंगे मरीज़ा लै इहअ बोल़णअ कि तेरै पाप हुऐ माफ या इहअ बोल़णअ उझ़ू आपणैं बछ़ाऊणैं च़क अर हांढदअ-फिरदअ लाग? </char> <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" /><char style="wj">ज़िहअ करै तम्हां का थोघ लागे कि मुंह मणछे पूता लै आसा पृथूई दी पाप माफ करनैओ हक।”</char></para>
  <para style="p" vid="MRK 2:10">तेखअ बोलअ ईशू तेऊ दरंगे मरीज़ा लै, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" /><char style="wj">“हुंह बोला ताल्है, उझ़ू आपणैं एऊ बछ़ाऊणैं च़क संघा डेऊ आपणैं घअरा लै।”</char><verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />सह मरीज़ उझ़ुअ तेभी सोभी नदरी खल़अ अर आपणैं बछ़ाऊणैं च़की डेऊअ सह आपणीं ज़ांघा हांढी घअरा लै। ऐहा गल्‍ला भाल़ी हुऐ सोभ लोग रहैन अर तिंयां लागै परमेशरे बड़ैई करदै कि हाम्हैं निं इहअ च़मत्कार आझ़ तैणीं कधि हेरअ।<verse eid="MRK 2:12" /></para>
  <para style="s">कारै गराहणै आल़अ लेबी शादणअ</para>
  <para style="r">(<ref loc="MAT 9:9-13">मोत्ती 9:9-13</ref>; <ref loc="LUK 5:27-32">लूका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ईशू बी तिधा का उझ़ुअ अर सह डेऊअ समुंदरे बाढै, तिधी आऐ खास्सै मणछ तेऊ सेटा अर सह लागअ तिन्‍नां लै शिक्षा दैंदअ।<verse eid="MRK 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 2:14" />तिधा का डेऊंदी बारी भाल़अ ईशू हलफीओ शोहरू लेबी नाओं मणछ कारै गराहणे च़ौकी दी बेठअ द, ईशू बोलअ तेऊ लै, <char style="wj">“मुंह संघै एछ।”</char> सह उझ़ुअ तेभी खल़अ संघा डेऊअ ईशू संघै।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />बादा का ज़ांऊं ईशू तेऊए घअरै रोटी खांदअ बेठअ, तिधी बेठै कई कारै गराहणै आल़ै अर पापी मणछ ईशू अर तेऊए च़ेल्‍लै संघै रोटी खांदै किल्हैकि तिधी थिऐ इहै खास्सै मणछ ज़ुंण ईशू संघा हआ तै।<verse eid="MRK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 2:16" />बधाना सखाऊंणै आल़ै शास्त्री ज़ुंण फरीसी मांझ़ा का थिऐ, तिन्‍नैं बोलअ एता भाल़ी कि अह आसा कारै गराहणै आल़ै अर पापी मणछा संघै रोटी खांदअ बेठअ द! तेखअ बोलअ तिन्‍नैं ईशूए च़ेल्‍लै लै,</para>
  <para style="p" vid="MRK 2:16">“अह कारै गराहणै आल़ै अर पापी मणछा संघै किल्है हआ खांदअ-पिंदअ बेठअ द?” <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />इना गल्‍ला शूणीं बोलअ ईशू तिन्‍नां लै, <char style="wj">“बैईद निं नरोगै मणछा सेटा एछदअ, पर रोगी मणछा सेटा लागा तेऊ ज़रूरी पुजणअ, हुंह निं धर्मीं लै आथी आअ द, पर हुंह आसा पापी शधाणूं आअ द।”</char><verse eid="MRK 2:17" /></para>
  <para style="s">ब्रत करनैओ सुआल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मोत्ती 9:14-17</ref>; <ref loc="LUK 5:33-39">लूका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />जोहन्‍ना डुबकी दैणैं आल़ेए च़ेल्‍लै अर फरीसी मणछ करा तै ब्रत। कई लोग आऐ ईशू सेटा लै संघा लागै इहअ बोल्दै, “जोहन्‍ने च़ेल्‍लै अर फरीसी मणछे च़ेल्‍लै करा ब्रत, पर तेरै च़ेल्‍लै निं ब्रत करदै?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“ज़ेभै तैणीं लाल़अ बरातू संघै रहा, तेभै निं तिंयां ब्रत करदै।</char> <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" /><char style="wj">एक बगत एछणअ इहअ बी कि लाल़अ करनअ तिन्‍नां का ज़ुदअ अर तेभै करनअ तिन्‍नां ब्रत।”</char><verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />
    <char style="wj">“नऊंऐं झिकल़े शाट्टी निं पराणैं झिकल़ै दी कोहै लांदअ, ज़ै इहअ करे, झिकल़ै धोंदी बारी धेल़ा सह नऊंईं शाट्टी तेऊ पराणैं झिकल़ै होर बी खास्सअ।</char><verse eid="MRK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 2:22" />
    <char style="wj">“इहअ ई निं कोह मणछ नऊंअ दाखो रस पराणैं खाल्हल़ै दी डाहंदै। किल्हैकि इहअ करी फुटा तिंयां खाल्हल़ै, संघा हआ दाखो रस अर तिंयां खाल्हल़ै दुहै च़िज़ा ज़ांऐं। पर नऊंअ दाखो रस भरा नऊंऐं खाल्हल़ै दी ज़िहअ करै तिन्‍नां दुही गल्‍लो बच़ाअ हआ।”</char><verse eid="MRK 2:22" /></para>
  <para style="s">बशैघे धैल़ीओ बी प्रभू</para>
  <para style="r">(<ref loc="MAT 12:1-8">मोत्ती 12:1-8</ref>; <ref loc="LUK 6:1-5">लूका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />एकी धैल़ै त ईशू बशैघे धैल़ी खेचा बाती लागअ द डेऊंदअ, अर तेऊए च़ेल्‍लै लागै बाता हांढदी खाणां लै कणके सीला चोल़दै।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">बधा. 23:25</ref></char></note><verse eid="MRK 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 2:24" />फरीसी मणछै बोलअ ईशू लै, “हेर, ईंयां बशैघे धैल़ी तेऊ कामां किल्है करा ज़ुंण तैहा धैल़ी करनअ मोसा गूरे बधाने साबै ठीक निं आथी?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं कै कधू इहअ निं पहल़अ कि ज़धू दाबेद राज़ै ज़रुरत पल़ी अर ज़ांऊं सह अर तेऊए साथी भुखै तै तेभै तेऊ किज़ै किअ?</char> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" /><char style="wj">तेऊ किहअ करै खाई अबतार माहा प्रोहते ज़मानैं परमेशरे खिम्भा भितरी डेऊई भैंट दैनी दी रोटी। ज़ेता मोसा गूरे बधाने साबै प्रोहता छ़ाडी होर कोहै निं खाई सकदअ त, अर तेऊ दैनी तिंयां आपणैं साथी लै बी?”</char><verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“बशैघो धैल़अ आसा मणछा लै बणाअं द, मणछ निं बशैघे धैल़ै लै आथी।</char> <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" /><char style="wj">तैही आसा हुंह मणछो पूत बशैघे धैल़ीओ बी मालक।”</char><verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">मछैंऐं दै हाथो मणछ किअ नरोगअ</para>
  <para style="r">(<ref loc="MAT 12:9-14">मोत्ती 12:9-14</ref>; <ref loc="LUK 6:6-11">लूका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />तेखअ डेऊअ एकी होरी बारी भिई ईशू यहूदी सभागृहा। तिधी थिअ एक मणछ इहअ, तेऊओ हाथ त मछैंअ द। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />फरीसी पंथे लोग थिऐ ईशू लै दोशा लाणें तैणीं ताखुऐ दै कि तिंयां भाल़े कि ईशू बशैघे धैल़ी एऊ मणछा नरोगै करा कि नांईं ज़ुंण मोसा गूरे बधाने साबै करनअ गलत आसा थिअ।<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />ईशू बोलअ तेऊ मछैंऐं दै हाथे मणछा लै, <char style="wj">“इधी खल़्हू सोभी नदरी।”</char> <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />तेखअ पुछ़अ ईशू तिन्‍नां का, <char style="wj">“बधाना दी किज़ै आसा लिखअ द? बशैघे धैल़ी भलअ करनअ ठीक आसा कि बूरअ करनअ? प्राण बच़ाऊंणै कि मारनअ?” पर तिंयां सोभ रहै च़ुप्पी।</char><verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />ईशू भाल़अ फेर संघा बोलअ तेऊ तिन्‍नें काठै मना का दुखी हई रोश्शा संघै तेऊ मणछा लै, <char style="wj">“आपणअ हाथ कर आजू।”</char> तेऊ बी किअ आपणअ हाथ आजू अर तेऊओ हाथ हुअ ताज़अ-नरोगअ।<verse eid="MRK 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 3:6" />तेखअ लागै फरीसी तिधा का बागै डेऊई तेभी हेरोदेस राज़ेए पक्ष लणैं आल़ै लोगा संघै एक्‍कअ करी इहअ बोल्दै, “अह पाणअ त हाम्हां किहअ करै मारी।”<verse eid="MRK 3:6" /></para>
  <para style="s">ईशू संघै डेऊऐ खास्सै मणछ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />कफरनहूम नगरी का डेऊअ ईशू आपणैं च़ेल्‍लै संघै गलील समुंदरा बाखा लै। <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />गलील, यहूदा, इदूमिआ मुल्खै, एरुशलेम नगरी अर जरदण नदी पार अर सूर अर सैदा नगरी ओरी-पोरी का आऐ खास्सै मणछ ईशू पिछ़ू। तिन्‍नैं शूणअ कि ईशू करा बडै-बडै नुआहरै काम अर तेता भाल़ै आऐ तिंयां सोभ ईशू सेटा लै।<verse eid="MRK 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 3:9" />ईशू बोलअ आपणैं च़ेल्‍लै का, “इधी हुअ लोगो खास्सअ झाल़अ एता लै करा तम्हैं मुल्है एक होछ़ी किश्ती तैर ताकि तेथ प्रैंदै बेशी हुंह इना लोगा संघै गल्‍ला करूं।”<verse eid="MRK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 3:10" />किल्हैकि ईशू किऐ तै तधू कई रोगी मणछ नरोगै अर ज़ेतरै बी रोगी थिऐ आऐ दै, तिंयां पल़ै ईशू छ़ुंहंदै एकी-दुजै प्रैंदी चुटी।<verse eid="MRK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 3:11" />भूता आल़ै मणछ बी ज़ांऊं ईशू भाल़ा तै, तिंयां बी पल़ा तै ईशू सेटा उटी बाखा अर लैल़ा-पकारा लाई करै बोला तै तिंयां इहअ, “तूह आसा परमेशरो पूत।” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />ईशू बोलअ तिन्‍नां भूता लै चतैनगी दैई इहअ, “मेरै बारै निं कोही का खोज़ी कि हुंह कुंण आसा।”<verse eid="MRK 3:12" /></para>
  <para style="s">ईशूए बारा खास च़ेल्‍लै</para>
  <para style="r">(<ref loc="MAT 10:1-4">मोत्ती 10:1-4</ref>; <ref loc="LUK 6:12-16">लूका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />तेखअ डेऊअ ईशू धारा प्रैंदा लै अर ज़ुंण तेऊ आप्पू संघै निंणै च़ाहै तिंयां शादै तेऊ आप्पू सेटा अर तिंयां डेऊऐ तेऊ संघै।<verse eid="MRK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 3:14" />तेखअ छ़ांटै ईशू बारा ज़ण्हैं संघा बोलअ तिन्‍नां लै तेऊ शधाणूं कि तिंयां तेऊ संघा-संघा रहे अर सह तिन्‍नां प्रच़ार करदै छ़ाडी सके, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />अर तिन्‍नां का इहअ हक बी होए कि तिंयां लोगा का भूत काढी सके। <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />तिंयां बारा ज़ण्हैं आसा ईंयां:</para>
  <para style="p" vid="MRK 3:16">शमौन ज़हा नाअं ईशू पतरास डाहअ,<verse eid="MRK 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 3:17" />जबदीए शोहरू याकब अर तेऊओ भाऊ जोहन्‍ना ज़हा नाअं ईशू गुल़ूबिज़ल़ूओ शोहरू डाहअ त।<verse eid="MRK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 3:18" />आन्दरू, फलिप्प, बरतुलमी, मोत्ती, थोमा, हलफीओ शोहरू याकब, तेदैई शमौन कनानी,<verse eid="MRK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 3:19" />करेती गराऊंओ यहूदा ज़ुंणी ईशू ढाकणैं बी बझ़ैल़अ त।<verse eid="MRK 3:19" /></para>
  <para style="s">ईशू अर भूतो राज़अ</para>
  <para style="r">(<ref loc="MAT 12:22-32">मोत्ती 12:22-32</ref>; <ref loc="LUK 11:14-23">लूका 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />तेखअ आऐ ईशू अर तेऊए च़ेल्‍लै कफरनहूम नगरी एकी घअरै अर तिधी हुऐ एतरै खास्सै मणछ कठा कि तिन्‍नां निं रोटी खाणेंओ बगत बी भेटअ।<verse eid="MRK 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 3:21" />ज़ांऊं ईशूए टबरै ईशूए बारै गल्‍ला शूणीं, तिंयां आऐ तेऊ घअरा लै निंदै। किल्हैकि कई लोगै बोलअ तिन्‍नां का, “सह आसा बेगरअ हुअ द।”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />एरुशलेम नगरी का थिऐ शास्त्री बी आऐ दै अर तिंयां बी बोला तै इहअ कि एऊ दी आसा, “राख्स” अर, “अह काढा भूते राज़ै राख्से शगती करै भूत।”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ऐहा गल्‍ला लै शादै ईशू तिंयां आप्पू सेटा लै अर तिंयां समझ़ाऊऐ एही कथ्या खोज़ी करै, <char style="wj">“राख्स किहअ करै सका भूत पोर्ही काढी! तिंयां ता तेऊए आपणैं आसा?</char><verse eid="MRK 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 3:24" />
    <char style="wj">“ज़हा राज़ा दी फूट पल़ा, सह हआ खतम। </char> <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" /><char style="wj">ठीक इहअ ई ज़िधी टबरा जैंदरी फूट पल़ा, तेऊ घअरो हआ बनाश।</char> <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" /><char style="wj">इहअ करै ज़ै राख्स आपणअ ई बरोधी हई आप्पू ई मांझ़ै फूट पाए, तेऊओ राज़ किहअ करै सका बणी रही? तेऊओ राज़ हआ खतम।</char><verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />
    <char style="wj">“पर कोहै निं जोधै मणछे घअरै पेशी तेऊओ धन तेभै तैणीं लुटी सकदअ ज़ेभै तैणीं किई सह तेऊ जोधै बान्हीं नां लऐ। तेखअ सका सह तेऊओ धन लुटी।</char><verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि मणछे सोभ पाप अर निंदा हणैं माफ, </char> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><char style="wj">पर ज़ुंण बी पबित्र आत्में खलाफ निंदा करे सह पाप निं कधि माफ हणअ। अह दोश रहणअ तेऊ लै सदा।”</char> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />तिंयां बोला तै इहअ, “एऊ दी आसा भूत शाचअ द।” तैही बोली ईशू ईंयां गल्‍ला।<verse eid="MRK 3:30" /></para>
  <para style="s">ईशूए ईज अर भाई</para>
  <para style="r">(<ref loc="MAT 12:46-50">मोत्ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तेखअ आऐ ईशूए ईज अर भाऊ तेऊ भाल़ै। तिंयां खल़्हुऐ घअरा बागै अर तिन्‍नैं दैनअ ईशू लै समाद कि बागै एछी कर हाम्हां संघै गल्‍ला।<verse eid="MRK 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 3:32" />ईशू फेर तै खास्सै मणछ कठा हुऐ दै, तिन्‍नां मांझ़ै बोलअ एकी ईशू लै, “भाल़, तेरी ईज, तेरै भाऊ अर बैहण आसा बागै ताह न्हैल़ै लागै दै, तिंयां च़ाहा ताह संघै गल्‍ला करनी।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“मेरी ईज अर मेरै भाई अर बैहण कुंण आसा?”</char> <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />तेखअ भाल़अ ईशू आप्पू फेर अर ज़ुंण तिधी थिऐ, तेऊ बोलअ तिन्‍नां लै, <char style="wj">“भाल़ा, मेरी ईज अर मेरै भाई अर बैहण आसा ईंयां।</char> <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" /><char style="wj">मेरी ईज, मेरै भाई बैहणी आसा तिंयां ज़ुंण ज़िहअ परमेशर बोला तेही ई ज़िन्दगी ज़िऊआ।”</char><verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">बेज़ै बऊंणैं आल़ेए कथ्या</para>
  <para style="r">(<ref loc="MAT 13:1-9">मोत्ती 13:1-9</ref>; <ref loc="LUK 8:4-8">लूका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />तेखअ लागअ भिई ईशू गलील समुंदरे बाढै लोगा लै शिक्षा दैंदअ। तिधी हुऐ खास्सै मणछ कठा अर ईशू बेठअ पाणीं प्रैंदै एकी किश्ती दी, सारै लोग रहै समुंदरे बाढै शुक्‍की ज़ैगा खल़्हुई। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ईशू लागअ तिन्‍नां का कथ्या खोज़ी कई गल्‍ला सखाऊंदअ, ईशू खोज़अ तिन्‍नां का इहअ,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />
    <char style="wj">“शूणां, एकी बारी निखल़अ एक कृषाण बेज़ै बऊंदअ।</char> <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" /><char style="wj">बेज़ै शोटदी बारी पल़अ धख बेज़अ बाते बाढै, सह च़ुंघअ च़ेल्‍लू-पखीरू।</char><verse eid="MRK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 4:5" />
    <char style="wj">“धख बेज़अ पल़अ शकरीली ज़िम्मीं दी, तिधी निं तेता खास्सअ माट्टअ भेटअ इहअ करै टिप्पअ सह जाऊअ।</char> <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" /><char style="wj">तिन्‍नां टिप्परूए ज़लैल़ै निं डुघै माट्टै दी आथी तै अर ज़ांऊं चटाक धुप्पअ लागअ, तिंयां टिप्परू दझ़ै संघा शुक्‍कै।</char><verse eid="MRK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 4:7" />
    <char style="wj">“धख बेज़अ पल़अ झ़ाकल़ै। ज़ांऊं कांडै बझ़ै, सह दाभूअ तेथ संघा तेथ निं नाज़ लागअ।</char><verse eid="MRK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 4:8" />
    <char style="wj">“पर धख बेज़अ पल़अ रज़दी-पज़दी ज़िम्मीं दी, तिन्‍नां दी लागी खास्सी फसल। कोई दी शौ गुणा, कोई दी शाठ गुणा अर कोई तिह गुणा पज़ैआ।”</char><verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“ज़ै तम्हैं एता समझ़णअ च़ाहा, तै दैऐ ऐहा गल्‍ला दी धैन कि मंऐं एभै तम्हां का किज़ै बोलअ।”</char><verse eid="MRK 4:9" /></para>
  <para style="s">कथ्या खोज़णेंओ मकसद</para>
  <para style="r">(<ref loc="MAT 13:10-17">मोत्ती 13:10-17</ref>; <ref loc="LUK 8:9">लूका 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />तेखअ ज़ांऊं ईशू आपणैं बारा च़ेल्‍लै अर तिधी होरी कठा हुऐ दै लोगा संघै थिअ, च़ेल्‍लै आऐ ईशू सेटा, संघा पुछ़अ तिन्‍नैं कथ्या खोज़णें बारै।<verse eid="MRK 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 4:11" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं सका परमेशरे राज़ो भेद समझ़ी। पर होर ज़ुंण परमेशरे राज़ो भेद नांईं समझ़दै, लागा कथ्या खोज़ी एते तैणीं समझ़ाऊंणअ,</char> <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" /><note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ईशा. 6:9-10</ref>; <ref loc="JER 5:21">जेर. 5:21</ref></char></note> <char style="wj">किल्हैकि</char></para>
  <para style="q" vid="MRK 4:12">
    <char style="wj">‘तिंयां निं मुंह भाल़ी शिखल़दै, </char></para>
  <para style="q" vid="MRK 4:12">
    <char style="wj">नां तिंयां मेरी गल्‍ला शूणीं समझ़दै।</char></para>
  <para style="q" vid="MRK 4:12">
    <char style="wj">ज़ै तिंयां समझ़दै, तै करनअ त तिन्‍नां प्राश्त संघा फिरनैं तै परमेशरा बाखा, </char></para>
  <para style="q" vid="MRK 4:12">
    <char style="wj">अर परमेशरा करनै तै तिन्‍नें पाप माफ।’”</char><verse eid="MRK 4:12" /></para>
  <para style="s">बेज़ै बऊंणैं आल़ेए कथ्यो मतलब</para>
  <para style="r">(<ref loc="MAT 13:18-23">मोत्ती 13:18-23</ref>; <ref loc="LUK 8:11-15">लूका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै, <char style="wj">“तम्हैं कै एता समझ़ै निं? तै तम्हां होर कथ्या किहअ करै समझ़णैं?</char> <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" /><char style="wj">बेज़ै बऊंणैं आल़अ कृषाण आसा परमेशरे बैणा खोज़णैं आल़ै ज़िहअ।</char><verse eid="MRK 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 4:15" />
    <char style="wj">“ज़ुंण बेज़अ बाते बाढै पल़अ, अह आसा तिन्‍नां मणछे बारै ज़ुंण परमेशरो बैण ता शूणां पर राख्स करा तिन्‍नां का तेता तेभी दूर।</char><verse eid="MRK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 4:16" />
    <char style="wj">“तिहअ ई शकरीली ज़िम्मीं दी पल़अ द बेज़अ आसा तिन्‍नां मणछे बारै ज़ुंण परमेशरो बैण शूणां अर नढैऊऐ मना तिंयां तेता खुशी-खुशी।</char> <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" /><char style="wj">पर आप्पू पाक्‍कअ विश्वास नांईं हणें बज़्हा रहा तिंयां थोल़ै ई धैल़ै लै। बैण मनणे बज़्हा ज़ांऊं तिन्‍नां लै मसीबता एछा, तिंयां छ़ाडा तेभै परमेशरा दी विश्वास करनअ।</char><verse eid="MRK 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 4:18" />
    <char style="wj">“ज़ुंण बेज़अ झ़ाकल़ै पल़अ सह आसा तिन्‍नां मणछे बारै ज़ुंण बैण ता शूणां, </char> <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" /><char style="wj">पर संसारै फिकर, धन-माया, मांण करनै ज़ेही संसारे गल्‍ला दी लाआ तिंयां आपणअ सारअ धैन मन्‍न। परमेशरे बैणा पाआ तिंयां बिस्सरी। तिंयां निं तिहअ करदै ज़िहअ परमेशर च़ाहा कि तिंयां करे।</char><verse eid="MRK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 4:20" />
    <char style="wj">“ज़ुंण बेज़अ रज़दी-पज़दी ज़िम्मीं दी पल़अ अह आसा तिन्‍नां मणछे बारै ज़ुंणी परमेशरो बैण शूणअ, मनअ अर विश्वास किअ। तिन्‍नैं किअ तिहअ ई ज़िहअ परमेशर च़ाहा कि तिंयां करे। तिंयां आसा एही बधिया फसला ज़िहै ज़ेथ तिह गुणा, शाठ गुणा कोई दी शौ गुणा फसल हुई।”</char><verse eid="MRK 4:20" /></para>
  <para style="s">दीऐ</para>
  <para style="r">(<ref loc="LUK 8:16-18">लूका 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“इहअ निं कोह आथी ज़ुंण दीअ ज़ाल़ी दरोठू भितरी डाहा कि पलगा हेठै डाहा पाई, तेता डाहा दीअदानी दी उछ़टै ताकि सारै घअरै प्रैश्शअ होए।</char> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><char style="wj">किल्हैकि ढोपी डाही दी च़ीज़ शुझणीं सोभी का अर एही निं किछ़ै गुप्त च़ीज़ आथी ज़ुंण सोभी नदरी निं एछे।</char><verse eid="MRK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 4:23" />
    <char style="wj">“ज़ै तम्हैं एता समझ़णअ च़ाहा, तै दैऐ ऐहा गल्‍ला दी धैन कि मंऐं एभै तम्हां का किज़ै बोलअ।”</char><verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“ज़ुंण हुंह तम्हां लै बोला तेता शूणां धैन लाई, ज़ेतरअ धैन दैई तम्हैं शुणें, तम्हां भेटणीं तेतरी खास्सी समझ़।</char><verse eid="MRK 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 4:25" />
    <char style="wj">“ज़ुंण मेरी शिक्षा शूणां, तिन्‍नां लै दैणीं होर बी खास्सी समझ़। पर ज़ुंण मेरी शिक्षा नांईं शूणां, तिन्‍नां का निंणअ सह बी पोर्ही ज़ुंण तिन्‍नां का धख समझ़ होए बी।”</char><verse eid="MRK 4:25" /></para>
  <para style="s">टिप्पणै आल़ै बेज़े कथ्या</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ईशू बोलअ तिन्‍नां लै भिई इहअ, <char style="wj">“परमेशरो राज़ आसा इहअ, ज़िहअ कृषाण ज़िम्मीं दी बेज़अ बऊआ।</char> <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" /><char style="wj">तेखअ रहा सह धैल़ आपणैं कामां लागी सह निं तेऊ बऊऐ दै बेज़ै बारै फिकर करदअ। बेज़ै का लागा टिप्परू अर बझ़ा तेतो निं तेऊ का थोघै हंदअ।</char><verse eid="MRK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 4:28" />
    <char style="wj">“अह ज़िम्मीं पज़ेरा नाज़ आप्पै। पैहलै लागा टिप्परू, तेखअ लागा सील, अर एता बाद हआ सीला दी दाणअ तैर।</char> <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" /><char style="wj">पर ज़ेभै फसल लऊंणा लै जाआ हई, तेभै छ़ाडा सह तेता दाची करै लऊंदै, किल्हैकि तेऊए फसला लऊंणेओ बगत गअ हई।”</char><verse eid="MRK 4:29" /></para>
  <para style="s">शाऊईए बेज़े कथ्या</para>
  <para style="r">(<ref loc="MAT 13:31">मोत्ती 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">लूका 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“हुंह परमेशरो राज़ किज़ू ज़िहअ खोज़ूं कि किहअ आसा? एता कहा कथ्या खोज़ी करै समझ़ाऊं?</char><verse eid="MRK 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 4:31" />
    <char style="wj">“शूणां, परमेशरो राज़ आसा शाऊईए दाणैं ज़िहअ। शाऊईओ दाणअ आसा पृथूईए सोभी बेज़ै का होछ़अ बेज़अ।</char> <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" /><char style="wj">एही ता आसा सह पृथूईए सोभी बेज़ै का होछ़अ, पर ज़ेभै तेऊ बऊआ, सह हआ सोभी शाग-पाचा का बडअ। ज़ांऊं तेते शाण्हीं बडी हआ, सरगे डैऊणै आल़ै च़ेल्‍लू-पखीरू बी सका तेते छ़ैल्‍ली दी कोल्ह बणाईं बसेरअ करी।”</char><verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ईशू खोज़ी तिन्‍नां का एही ई कई कथ्या अर तिन्‍नें समझ़े साबै खोज़ा त तिन्‍नां का बैण। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />एही गल्‍ला समझ़ाऊंणा लै करा त सह लोगा मांझ़ै कथ्या खोज़ी गल्‍ला, पर कांगनरांगै डेऊई खोज़ा त ईशू आपणैं च़ेल्‍लै का तिन्‍नां सारी गल्‍लो सारअ भेद।<verse eid="MRK 4:34" /></para>
  <para style="s">ढिश-बागर शांत करनअ</para>
  <para style="r">(<ref loc="MAT 8:23-27">मोत्ती 8:23-27</ref>; <ref loc="LUK 8:22-25">लूका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />तेऊ ई धैल़ै ज़ांऊं सान्ह च़ाल्‍ली ती पल़ी, ईशू बोलअ आपणैं च़ेल्‍लै लै, <char style="wj">“च़ाल्‍ला हाम्हां डेऊणअ गलील समुंदरा पारा लै।”</char><verse eid="MRK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 4:36" />ईशू त किश्ती का ई लागअ द लोगा संघै गल्‍ला करदअ अर च़ेल्‍लै डेऊऐ ईशू संघा निंईं लोगा छ़ाडी तिधा का पारा बाखा लै। होर बी डेऊऐ कई पिछ़ू तिन्‍नें आपणीं किश्ती दी बेठी दरैऊआ पार बाखा लै।<verse eid="MRK 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 4:37" />तेखअ हुअ इहअ कि तेथ आअ बेघै बडअ ढिश-बागर, अर छ़ाल्‍ली लागी एतरी कि किश्ती लागी पाणीं करै भरदी।<verse eid="MRK 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 4:38" />पर आप्पू त ईशू किश्तीए पिछ़ली कुछी शरैहण लाई दी सुत्तअ द। च़ेल्‍लै झ़ैऊअ ईशू संघा बोलअ, “हे गूरू, ताह हैल़अ-फिकर निं आथी कि हाम्हैं सोभै च़ाल्‍लै पाणीं जैंदरी डुबी खतम हई?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ईशू उझ़ुअ खल़अ संघा नैरी ढिश-बागर एक झांश काढी। समुंदरे छ़ाल्‍ली नैरी इहअ बोली, <char style="wj">“शांत हआ, इधी खल़्हिया।”</char> ढिश-बागर रुकअ तेभी अर समुंदर हुअ शांत, तैबै जाई करै हुई शांती। <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />तैबै बोलअ ईशू तिन्‍नां लै, <char style="wj">“तम्हैं किल्है डरा? तम्हां कै अज़ी बी विश्वास निं हुअ?”<note caller="+" style="f"><char style="fr" closed="false">4:40 </char><char style="ft" closed="false">भज. 107:29</char></note></char><verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />तिन्‍नां सोभी फिरअ खास्सअ हैल़अ अर तिंयां लागै आप्पू मांझ़ै इहअ बोल्दै, “अह कुंण आसा, एऊए हर गल्‍ला मना ढिश-बागर अर समुंदरे छ़ाल्‍ली बी?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">भूत शाचअ द मणछ ठीक करनअ</para>
  <para style="r">(<ref loc="MAT 8:28-34">मोत्ती 8:28-34</ref>; <ref loc="LUK 8:26-39">लूका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />तिंयां पुजै समुंदरा पार गरासेनी मुल्खै <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />अर ज़ांऊं ईशू किश्ती का होथअ, तेभी आअ एक मणछ तेऊ मणछा दी थिअ भूत शाचअ द। सह मणछ आअ मल्थाना का ईशू सेटा लै ठुर्ही। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />सह रहा त मल्थानै ई। तेऊ निं शांघल़ी करै बी बान्हीं सकदै तै।<verse eid="MRK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 5:4" />किल्हैकि लोगै बान्हअ त सह शांघल़ी करै बी, पर सह पाआ त तेता बी चोल़ी अर तेऊ निं कोहै काबू करी सकदअ त। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />सह रहा त धैल़ी-राची मल्थानै अर नाल़ै-धारा ज़ोरै-ज़ोरै हाक्‍का लैल़ा लांदी ठुल़्दअ लागी। आपणीं घेरी करा त सह तिछै पात्थरा करै क्रिंज़ा पाई छ़िन्ह-बिन्ह।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />ज़ांऊं तेऊ का ईशू शुझुअ, सह आअ दूरा का ठुर्ही। ईशू सेटा धरनीं उटअ पल़ी बोलअ तेऊ लैल़ा पाई इहअ <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />“हे ईशू परम प्रधान परमेशरे पूता, मेरअ ताह संघै कै मेल़-ज़ोल़? हुंह दैआ ताल्है परमेशरे कसम कि तूह निं मुल्है दुख दैई।”<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 8:29">मोत्त. 8:29</ref>; <ref loc="1KI 17:18">1 राज़. 17:18</ref></char></note> <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />किल्हैकि ईशू बोलअ त तेऊ लै इहअ, <char style="wj">“भूता, एऊ मणछा का निखल़ पोर्ही।”</char><verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ईशू पुछ़अ तेऊ का, <char style="wj">“ताह नाअं किज़ै आसा?”</char></para>
  <para style="p" vid="MRK 5:9">तेऊ दैनअ ईशू लै ज़बाब, “मुंह नाअं आसा सैना, किल्हैकि हाम्हैं आसा खास्सै।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />तेऊ किई ईशू का खास्सी अरज़ कि हाम्हां निं एऊ मुल्खा का बागै काढी।<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />तिधी धारठी थिअ खास्सै सुंगरो एक छ़ुंड च़रदअ लागअ द, <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />तिन्‍नैं भूतै किई ईशू का एही अरज़, “हाम्हां दै इना सुंगरा जैंदरी डेऊणैं, ताकि हाम्हैं इना भितरी पेशी सके।”<verse eid="MRK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 5:13" />तेखअ दैनी ईशू तिन्‍नां लै ज़ाज़त कि तिंयां सुंगरा दी पेठे। तिंयां भूत पेठै तेऊ मणछा का निखल़ी सुंगरा भितरी। तिन्‍नां सुंगरे छ़ुंडा दी तै खास्सै सुंगर कोई दूई हज़ार। तिंयां सुंगर हुऐ पठी बेगरै संघा पल़ै तिंयां धारठी प्रैंदा का समुंदरे पाणीं जैंदरी। इहअ करै हुऐ तिंयां सुंगर सोभ खतम।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />तिंयां सुंगरा गुआल़ै ठुर्है तिधा का आपणीं नगरी अर गराऊंआं लै संघा खोज़अ तिन्‍नैं इना गल्‍लो सारअ समाद नगरी दी, नगरी का आऐ खास्सै मणछ तिधी भाल़ै। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ईशू सेटा पुजी ज़ांऊं तिन्‍नैं सह भूते खास्सी सैना शाचअ द मणछ होश-बाशा दी झिकल़ै बान्हीं बेठअ द भाल़अ, तिंयां डरै सोभ।<verse eid="MRK 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 5:16" />तिधी ज़ुंणी तिंयां गल्‍ला आपणीं आछी भाल़ी ती, तिन्‍नैं खोज़अ तिन्‍नां होरी का तेऊ भूत शाचै दै मणछो अर तिन्‍नां सुंगरो पूरअ हाल। <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />तिंयां सोभ लोग लागै ईशू का एही अरज़ करदै “म्हारै एऊ मुल्खा का डेऊ बागै।”<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ज़ांऊं ईशू किश्ती दी बेशी च़ाल्‍लअ, ज़हा मणछा भूता का छ़ुटकारअ भेटअ त, सह लागअ ईशू का अरज़ करदअ, “मुंह बी दै तूह आप्पू संघै एछणैं।”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />पर ईशू निं तेऊए अह गल्‍ल मनी संघा बोलअ तेऊ मणछा लै, <char style="wj">“आपणैं घअरै डेऊ संघा खोज़ लोगा का इना गल्‍ला कि प्रभू ताल्है केही झींण किई अर ताल्है किहै बडै-बडै च़मत्कारे काम किऐ।”</char><verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />सह मणछ डेऊअ तिधा का दिकापुलिस मुल्खा लै संघा लागअ लोगा का इना गल्‍ले बारै खोज़दअ कि ईशू तेऊ लै किहै बडै-बडै च़मत्कारे का किऐ! तेऊए गल्‍ला शूणीं हुऐ सोभ लोग रहैन।<verse eid="MRK 5:20" /></para>
  <para style="s">मूंईं दी शोहरी अर एक बमार बेटल़ी</para>
  <para style="r">(<ref loc="MAT 9:18-26">मोत्ती 9:18-26</ref>; <ref loc="LUK 8:40-56">लूका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />ईशू डेऊअ भिई किश्ती दी बेशी समुंदरा पार। तिधी आऐ तेऊ सेटा खास्सै मणछ।<verse eid="MRK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 5:22" />ज़ेतरी ईशू तिधी पुजअ, तेतरी गअ तिधी याईर नाओं एक मणछ एछी, सह थिअ सभागृहो कारदार। ज़ांऊं तेऊ का ईशू शुझुअ, तेऊ टेक्‍कअ ईशू सेटा धरनीं उटै पल़ी माथअ। <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />तेऊ किई ईशू का एही अरज़, “मेरी होछ़ी शोहरी आसा मरनै आल़ी। तूह एछ संघा छ़ुंह तैहा आपणैं हाथा करै ताकि सह मरनै का बच़े।”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />ईशू लागअ तेखअ तेऊए अरज़ शूणीं तेऊ संघै हांढदअ। होर बी डेऊऐ पिछ़ू खास्सै मणछ।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />बाता हांढदी ती एक बेटल़ी, तैहा थिअ बारा साला ओर्ही लोहू बगणेंओ रोग। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />तैहा कराऊअ त खास्सै बैईदा का आपणअ लाज़ बी पर सह निस्सी ती केही बिज़री। तैहा किई आपणीं सारी ज़िन्दगीए कमाई बी तैहा बमारी पिछ़ू खतम पर रोगा का नरोगै हणें ज़ैगा दाहुई सह।<verse eid="MRK 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 5:27" />ईशूए गल्‍ला शूणीं डेऊई सह खास्सै मणछा जैंदरी ईशू पिछ़ू अर तैहा छ़ुंअ पिछ़ू का ईशूए झिकल़ैओ पाल्‍लअ। <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />किल्हैकि सह सोठा ती आपणैं मन्‍नैं इहअ, “ज़ै हुंह ईशूए झिकल़ै बी छुंए, तेता करै जाणीं हुंह एऊ रोगा का बिज़री।” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />ज़ांऊं तैहा ईशूए झिकल़ै छ़ूंऐं, तेभी हुअ तेसो लोहू बगणअ बंद।<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />ईशू का ज़ाण्हुंअ आप्पू बी कि तेऊ का निखल़ी शगती। ईशू पुछ़अ तेतरै लोगा जैंदरी पिछ़ू फिरी, <char style="wj">“मेरै झिकल़ै कुंणी छ़ूंऐं?”</char> <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />तेऊए च़ेल्‍लै बोलअ तेऊ लै, “तूह इना केही गल्‍ला करा, तूह भाल़ा बी हैनूं ताह पिछ़ू भाल़ केतरै लोग आसा हांढदै लागै दै! अर तूह बोला कि कुंणी हुंह छ़ुंअ!”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />ईशू भाल़अ फेर तेऊ भाल़णा ज़ुंणी अह काम किअ त। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />तेखअ सोठअ तैहा बेटल़ी इहअ कि मेरी भाल़ केही भलाई हुई, तैहा डरदी-काम्बदी ईशू सेटा माथअ टेक्‍की करै खोज़ी सारी गल्‍ला शुची-शुची।<verse eid="MRK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 5:34" />ईशू बोलअ तैहा लै, <char style="wj">“शोहरी, तंऐं किअ विश्वास कि हुंह सका ताह ठीक करी अर मंऐं हेरी तूह ऐहा बमारी का राम्बल़ी करी। ऐबै डेऊ शांती दी घअरा लै, तूह गई ऐबै ऐहा बमारी का छ़ुटी।”</char><verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ईशू त इहअ बोल्दअ ई लागअ द कि सभागृहे कारदारे घअरा का दैनअ लोगै समाद, “तेरी शोहरी, मरी गई, ऐबै तंऐं गूरू लै किल्है लाअ थोघै बाझ़ी इधा लै एछणेंओ कष्ट दैई?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ज़िना गल्‍ला करदै तिंयां थिऐ लागै दै, तिंयां गल्‍ला किई ईशू शूणीं नां शूणीं, अर सभागृहे कारदारा लै ईशू बोलअ, <char style="wj">“हैल़अ निं करी, तूह डाह सिधअ विश्वास।”</char><verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />ईशू निं पतरास, याकब अर तेऊए भाऊ जोहन्‍ना छ़ाडी होरी कोही आप्पू संघै एछणैं दैनअ।<verse eid="MRK 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 5:38" />सभागृहे कारदारे घअरै पुजी भाल़ै ईशू तिंयां लोग लेरदै-पकारदै। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />तेखअ तेऊ भितरी डेऊई तिन्‍नां लै बोलअ, <char style="wj">“तम्हैं किल्है आसा लागै दै लेरदै-पकारदै? शोहरी निं मूंईं दी आथी अह आसा सुत्ती दी।”</char><verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />तिंयां सोभ लागै ऐहा गल्‍ला शूणीं सुहांगा करदै, पर ईशू काढै तिधा का तिंयां सोभ लोग बागा लै अर शोहरीए ईज-बाब अर आपणैं चअन च़ेल्‍लै डाहै भितरी ज़िधी शोहरी ती डाही दी।<verse eid="MRK 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 5:41" />तेखअ ईशू शोहरीओ हाथ ढाकी करै बोलअ तेऊए आपणीं बोली दी, <char style="wj">“तलीता कूम्मीं”</char> एतो मतलब हआ, <char style="wj">“लान्हींऐ खल़ी उझ़ू।”</char> <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />ज़ांऊं ईशू इहअ बोलअ, सह शोहरी उझ़ुई तेभी खल़ी अर सह लागी हांढदी-फिरदी, किल्हैकि सह थिई बारा साले। ऐहा गल्‍ला भाल़ी हुऐ तिंयां रहैन।<verse eid="MRK 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 5:43" />तेखअ ईशू तिन्‍नां लै चतैनगी दैनी कि ऐहा गल्‍लो थोघ निं लोल़ी कोही का लागअ, तेखअ बोलअ तेऊ तिन्‍नां लै इहअ, <char style="wj">“ऐहा शोहरी लै दैआ किज़ै खाणां लै।”</char><verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरत नगरी ईशूओ अदर नांईं करनअ</para>
  <para style="r">(<ref loc="MAT 13:53-58">मोत्ती 13:53-58</ref>; <ref loc="LUK 4:16-30">लूका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />कफरनहूम नगरी का डेऊअ ईशू आपणैं घअर नासरत नगरी लै अर तेऊए च़ेल्‍लै बी डेऊऐ तेऊ संघा। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />तिधी लागअ बशैघे धैल़ी ईशू सभागृहा शिक्षा दैंदअ।</para>
  <para style="p" vid="MRK 6:2">खास्सै मणछ हुऐ तेऊए गल्‍ला शूणीं रहैन, तिंयां लागै इहअ बोल्दै,</para>
  <para style="p" vid="MRK 6:2">“एऊ ईंयां गल्‍ला किधा का शिखल़ी? अह कुंण ज़िहअ ज्ञैन आसा ज़ुंण सिधअ एऊ लै आसा दैनअ द? हेरे, अह भाल़ किहै-किहै च़मत्कारे काम करा! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />एऊ बछ़ैणा हाम्हैं सोभै! अह कै सह ई मिस्त्री निं आथी ज़ुंण मरिअमो शोहरू आसा? याकब, जोसेस, यहूदा, अर शमौनो आसा अह ज़ेठअ भाई अर एऊए बैहणी कै हाम्हां मांझ़ै निं रहंदी?” इना गल्‍ला पिछ़ू निं तिन्‍नैं सह मनअ आथी।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“परमेशरे गूरो हआ होरी सोभी ज़ैगा अदर पर आपणीं नगरी, रिश्तैदारा अर टबरा मांझ़ै निं तेऊओ अदर हंदअ।”</char> <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />ईशू निं तिधी किछ़ै खास्सै च़मत्कारे काम किऐ, तेऊ किऐ तिधी सिधै धख ज़िहै बमारा दी आपणैं हाथा करै छ़ुंहीं नरोगै।<verse eid="MRK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 6:6" />ईशू हुई ऐहा गल्‍ले रहैनी कि तिन्‍नैं निं विश्वास किअ! ईशू रहअ आपणैं च़ेल्‍लै संघै नगरी अर गराऊंऐं हांढी शिक्षा दैंदअ लागी।<verse eid="MRK 6:6" /></para>
  <para style="s">बारा च़ेल्‍लै छ़ाडणैं</para>
  <para style="r">(<ref loc="MAT 10:5-15">मोत्ती 10:5-15</ref>; <ref loc="LUK 9:1-6">लूका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />तेखअ शादै एकी धैल़ी ईशू आपणैं बारा च़ेल्‍लै आप्पू सेटा अर तेऊ छ़ाडै तिंयां दूई-दूई करै नगरी गराऊंऐं अर तिन्‍नां लै दैनअ भूता काढणेंओ हक।<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />संघा दैनअ तिन्‍नां लै इहअ हुकम, “बाता हांढणा लै शोठै का सुआई निं आप्पू संघा किछ़ पाई, नां रोटी, नां झ़ोल़ी नां ढबैओ थैल्‍लू। <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />खूरै बान्हां पोलल़ै अर दूई कुर्तै बी निं संघा निंईं।”<verse eid="MRK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 6:10" />होर बोलअ ईशू तिन्‍नां लै इहअ, <char style="wj">“ज़ै तम्हां कुंण आपणैं घअरा लै प्राहुंणैं शादे, तम्हैं डेओऐ तेऊ घअरा लै अर रोटी खाई सुत्तै तेऊ ई घअरै ज़ेभै तैणीं तम्हैं तैहा नगरी का बागै निं डेओए।</char><verse eid="MRK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 6:11" />
    <char style="wj">“ज़िधी लोग तम्हां नांईं मने अर थारी गल्‍ला नांईं शुणें, तैहा ज़ैगा ठुल़्हकै आपणैं खूरा का धूल़अ पोर्ही, ताकि तिन्‍नां लै शाजत होए कि तिन्‍नैं निं थारअ सुआगत किअ।”</char><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ईशूए च़ेल्‍लै बी डेऊऐ अर तिन्‍नैं बी किअ इहअ प्रच़ार कि आपणैं पापो प्राश्त करा, अर परमेशरा सेटा एछा फिरी। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />संघा काढै तिन्‍नैं कई मणछा का भूत पोर्ही अर खास्सै रोगी मणछा लै मल़अ प्राथणां करी तेल संघा किऐ नरोगै।<verse eid="MRK 6:13" /></para>
  <para style="s">जोहन्‍ना डुबकी दैणैं आल़ेए हत्या</para>
  <para style="r">(<ref loc="MAT 14:1-12">मोत्ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लूका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />ईशूए बारै लागअ हर ज़ैगा थोघ अर ईंयां गल्‍ला पुजी हेरोदेस राज़ै सेटा बी कई लोग बोला तै इहअ, “जोहन्‍ना डुबकी दैणैं आल़अ हुअ मरी करै ज़िऊंदअ, तैही हआ तेऊ का ईंयां शगती अर च़मत्कारे काम प्रगट।”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />कई होरी लोगै बोलअ इहअ बी, “अह आसा एलियाह।” पर कोई लोगै बोलअ इहअ, “अह आसा गूर, या पैहलकै ज़मानें गूरा मांझ़ै कुंण एक।”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />हेरोदेस राज़ै बोलअ इना गल्‍ला शूणीं इहअ, “ज़ुंण जोहन्‍ना डुबकी दैणैं आल़अ मंऐं मारी पाअ त, मेरै खैलै हुअ सह ई ज़िऊंदअ।”<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />ईंयां गल्‍ला हुई ती एही कि ज़धू जोहन्‍ना ज़िऊंदअ थिअ, हेरोदेस राज़ै किअ आपणैं भाई फलिप्पे ज़िऊंदी ज़िता तेऊए लाल़ी हेरोदियासा संघै नज़ायज़ बैह।<verse eid="MRK 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 6:18" />जोहन्‍ना बोलअ त हेरोदेस राज़ै लै इहअ, “आपणैं भाईए ज़िऊंदी ज़िता तेऊए लाल़ी डाही करै किअ तंऐं पाप।” हेरोदेस राज़ै छ़ाडै जोहन्‍ना ढाकणा लै सपाही अर सह पाअ कैद खानै दी।<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेब. 18:16</ref>; <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />एता पिछ़ू डाहा ती हेरोदियास जोहन्‍ना संघै ज़ीद अर सह च़ाहा ती तेऊ किहअ करै मारनअ, पर इहअ निं हई सकअ।<verse eid="MRK 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 6:20" />किल्हैकि हेरोदेस राज़ै लागा ती जोहन्‍ना का डअर किल्हैकि तेऊ का थिअ थोघ कि जोहन्‍ना आसा धर्मीं अर पबित्र मर्ध। सह करा त तेऊए हेर-सभाल़ बी अर तेऊ लागा ती तेऊए गल्‍ला शूणीं डअर पर तैबी बी हआ त सह तेऊए गल्‍ला शुणना लै खुशी।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ज़ेऊ मोक्‍कै लोल़ी हेरोदियास लागी दी थिई, सह मोक्‍कअ भेटअ तैहा तेभै ज़ांऊं हेरोदेस राज़ै आपणीं ज़ल्म धैल़ी दी आपणैं प्रधाना, सैनापति अर गलील मुल्खे बडै-बडै लोगा लै भोज़ दैनअ।<verse eid="MRK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 6:22" />हेरोदियासे शोहरी आई भितरा लै, अर आपणअ नाच़ रहैऊई करै किऐ हेरोदेस अर तेऊ संघै बेठै दै सोभ खुश, तैहा का खुश हई बोलअ राज़ै तैहा शोहरी लै, “तूह ज़ुंण बी मुखा मांगे, मुंह दैणअ ताल्है खुशी-खुशी।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />होर ता होर राज़ै दैनी सोभी नदरी तैहा लै ज़बान, “ज़ुंण बी तूह मुखा मांगे सह लाअ मंऐं ताल्है दैई, इधी तैणीं कि, ज़ै तूह मुखा आधअ राज़ बी मांगे, तेता बी दैंऊं हुंह ताल्है।”<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="EST 5:3">एस. 5:3</ref>,<ref loc="EST 5:6">6</ref>; <ref loc="EST 7:2">7:2</ref></char></note><verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />सह शोहरी डेऊई बागै आपणीं ईजा सेटा पुछ़दी, “हुंह किज़ै मांगूं?”</para>
  <para style="p" vid="MRK 6:24">तेसे ईजा बोलअ तैहा लै, “जोहन्‍ना डुबकी दैणैं आल़ैओ मूंड मांग।”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />सह आई तेभी राज़ै सेटा भितरा लै अर तैहा बोलअ राज़ै लै, “हुंह च़ाहा कि तूह दै मुल्है एभी जोहन्‍ना डुबकी दैणैं आल़ैओ मूंड काटी थाल़ा भितरी आणी।”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ऐहा गल्‍ला शूणीं हुअ राज़अ खास्सअ दुखी पर तिधी बेठै दै सोभी प्राहुंणैं बी शूणीं तेऊए तिंयां गल्‍ला अर तेता लै निं सह हुधणअ च़ाहंदअ त। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />इहअ करै दैनअ राज़ै बी तेभी आपणैं सपाही लै हुकम, “कैद खानै लै डेओआ संघा आणा तेऊओ मूंड एभी काटी।”<verse eid="MRK 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 6:28" />सपाही बी डेऊऐ अर थाल़ा भितरी दैनअ जोहन्‍ना डुबकी दैणैं आल़ैओ मूंड काटी तैहा शोहरी लै आणी अर तैहा शोहरी निंयं सह आपणीं ईजा सेटा लै। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />इहअ शूणीं आऐ जोहन्‍ने च़ेल्‍लै अर तेऊए ल्हास निंईं करै डाही तिन्‍नैं सह घोरी दाबी।<verse eid="MRK 6:29" /></para>
  <para style="s">ईशूए च़ेल्‍लेओ बापस फिरनअ अर ईशूओ कांगनरांगै डेऊणअ</para>
  <para style="r">(<ref loc="MAT 14:13">मोत्ती 14:13</ref>,<ref loc="MAT 14:14">14</ref>; <ref loc="LUK 9:10">लूका 9:10</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />बारा शधाणूं हुऐ सोभ ईशू सेटा कठा अर ज़िहअ-ज़िहअ तिन्‍नैं किअ अर ज़िहअ लोगा का सखाऊअ थिअ, तिन्‍नैं खोज़ी तेऊ सेटा पुजी तिंयां सारी गल्‍ला बाढै।<verse eid="MRK 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 6:31" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हाम्हां डेऊणअ किधी कांगनरांगी ज़ैगा लै थोल़ी घल़ी करनअ राम।”</char> किल्हैकि तिधी रहा तै खास्सै मणछ एछदै लागी अर तिन्‍नां निं रोटी खाणेंओ बगत बी भेटदअ त।<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />तेखअ डेऊऐ तिंयां किश्ती दी बेशी एकी कांगनरांगी ज़ैगा लै।<verse eid="MRK 6:32" /></para>
  <para style="s">पांज़ा हज़ारा मर्धा का रोटी खैऊंणी</para>
  <para style="r">(<ref loc="MAT 14:15-21">मोत्ती 14:15-21</ref>; <ref loc="LUK 9:11-17">लूका 9:11-17</ref>; <ref loc="JHN 6:1-14">जोहन्‍ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />लोगै हेरै तिंयां डेऊंदै भाल़ी अर बछ़ैणीं, लोग ठुर्है पिछ़ू आपणीं ज़ांघा हांढी अर तिंयां गऐ तैहा ज़ैगा पैहलै पुजी ज़िधा लै ईशू अर तेऊए च़ेल्‍लै पुजै। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ईशू तिधी पुजी किश्ती का होथअ अर तिधी आऐ खास्सै मणछ अर ईशू फिरी तिन्‍नां भाल़ी झींण। किल्हैकि तिंयां थिऐ एही भेडा ज़िहै ज़हा फुआल कोहै निं हंदअ। तेखअ लागअ ईशू कई गल्‍ले शिक्षा दैंदअ।<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="2CH 18:16">2 इति. 18:16</ref>; <ref loc="1KI 22:17">1 राज़. 22:17</ref></char></note><verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />ज़ांऊं सान्ह च़ाल्‍ली पल़ी, तेऊए च़ेल्‍लै आऐ तेऊ सेटा लै अर तिंयां लागै इहअ बोल्दै, “अह आसा बडी कराहणीं ज़ैगा, धैल़अ बी गअ उडी। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />इना लोगा लै बोल घअरा डेऊणा लै ताकि ओरी-पोरी गराऊंऐं डेऊई ईंयां आप्पू लै खाणैं-पिणैंओ इंतज़ाम करी सके।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />पर ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं दैआ इना लै खाणां लै।”</char></para>
  <para style="p" vid="MRK 6:37">तिन्‍नैं बोलअ ईशू लै, “हाम्हां कै इना सोभी लै दूई शौआ च़ंदीए सिक्‍कै दैई लाई रोटी आणी लई अर तेखअ खैऊंणी?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“डेओआ, अर भाल़णीं दैआ हेरुं तम्हां सेटा केतरी रोटी आसा?”</char></para>
  <para style="p" vid="MRK 6:38">तिन्‍नैं भाल़ी बोलअ, “हाम्हां का आसा सिधी पांज़ रोटी, अर दूई म्हाछ़ली।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />तेखअ बोलअ ईशू तिन्‍नां लै, “सोभी बशैल़ा धरनीं हरी घाहा प्रैंदै घेहल़ी दी।” <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />तिंयां सोभ बेठै शौ-शौ अर पज़ाह-पज़ाह करै एकी-एकी घेहल़ी दी।<verse eid="MRK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 6:41" />ईशू ढाकी तिंयां पांज़ रोटी अर दूई म्हाछ़ली हाथै अर सरगा बाखा लै भाल़ी किअ परमेशरो शूकर। तेखअ लागअ रोटी चोल़ी-चोल़ी करै च़ेल्‍लै का दैंदअ अर तिंयां लागै लोगा लै बांडदै, अर तिंयां दूई म्हाछ़ली बी दैनी सोभी लै बांडी करै।<verse eid="MRK 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 6:42" />इहअ करै खैऊई सोभी लोगा का रोटी अर तिंयां सोभ लोग रज्ज़ै। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />बारा च़ठै भर्हुऐ तिन्‍नां रोटीए ज़ुंण पिछ़ू बच़ी अर म्हाछ़लीए बी बच़ै कई च़ठै। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ज़ेतरै ज़ण्हैं रोटी खाई, तिंयां थिऐ गणी करै कोई पांज़ हज़ार मर्ध ई मर्ध। बेटल़ी अर माठै निं तिन्‍नैं गणै आथी।<verse eid="MRK 6:44" /></para>
  <para style="s">ईशूओ पाणीं प्रैंदै हांढणअ</para>
  <para style="r">(<ref loc="MAT 14:22-33">मोत्ती 14:22-33</ref>; <ref loc="JHN 6:15-21">जोहन्‍ना 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />तेखअ बोलअ तेभी ईशू आपणैं च़ेल्‍लै लै किश्ती दी बेशणा लै इहअ कि तम्हैं डेओआ आजू समुंदरा पार बैतसैदा नगरी लै हुंह एछूं इना सोभी लोगा घअरा लै छ़ाडणैं का बाद। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />तिन्‍नां मणछा घअरा लै छ़ाडी डेऊअ ईशू प्राथणां करदअ धारठी प्रैंदा लै।<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />ज़ांऊं सान्ह पल़ी, किश्ती ती समुंदरा मांझ़ै अर ईशू त कल्ही समुंदरे बाढै। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />ज़ांऊं तेऊ भाल़अ कि तिंयां च़ेल्‍लै डरै किश्ती च़लाऊंदी किल्हैकि समुंदरै आअ ढिश-बागर इहअ कि; तिंयां आणै हारी-मारी।</para>
  <para style="p" vid="MRK 6:48">ईशू बी आअ राचकै च़ौथै पहरै समुंदरे पाणीं प्रैंदै च़ेल्‍लै सेटा लै अर तिन्‍नां का च़ाहा ती ईशू आजू निखल़णअ। <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />तिन्‍नैं च़ेल्‍लै भाल़अ सह समुंदरे पाणीं प्रैंदै हांढदअ। तिन्‍नैं सोठअ इहअ कि अह आसा भूत। तिन्‍नैं पाई डरै मारै ज़ोरै-ज़ोरै लैल़ा-पकारा। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />तिंयां सोभै ज़ण्हैं डरै तेऊ भाल़ी करै। पर ईशू किई तेभी तिन्‍नां संघै गल्‍ला संघा बोलअ तिन्‍नां लै, <char style="wj">“हैअ डाहा, डरा निं आथी हुंह आसा।”</char><verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />ईशू उखल़अ तिन्‍नें किश्ती दी अर ढिश-बागर मुक्‍की तेभी। तिंयां सोभ हुऐ रहैन। <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />तिन्‍नें मन्‍न तै एतरै काठै हुऐ दै कि तिंयां निं पांज़ हज़ारा लोगा का रोटी खैऊणेंओ मतलब बी समझ़ै कि ईशू का केतरी शगती आसा।<verse eid="MRK 6:52" /></para>
  <para style="s">गन्‍नेसरत समुंदरे बाढै किऐ खास्सै रोगी नरोगै</para>
  <para style="r">(<ref loc="MAT 14:34-36">मोत्ती 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />तिंयां सोभ पुजै गलील समुंदरा पार डेऊई गन्‍नेसरत संघा खरैल़ी किश्ती बाढै। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ज़ांऊं तिंयां किश्ती का होथै, लोगै हेरअ ईशू तेभी बछ़ैणीं।<verse eid="MRK 6:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 6:55" />संघा ठुर्है तिंयां लोग ओरी-पोरीए गराऊंआं दी अर कई बमार मणछ आणै मांज़ै प्रैंदै च़की। ज़िधी तिन्‍नां का थोघ लागअ कि ईशू आसा, तिधा लै रहै तिंयां निंदै लागी।<verse eid="MRK 6:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="MRK 6:56" />ज़िधी बी ईशू घअरै, नगरी, च़ाऐ गराऊंआं दी डेओआ त, लोग निंयां तै बमार मणछ तेऊ सेटा लै।</para>
  <para style="p" vid="MRK 6:56">तिंयां करा तै एही अरज़ कि ए ईशू हाम्हां दै तेरै झिकल़ैओ पाल्‍लअ छ़ुंहंणै ताकि हाम्हैं इना बमारी का बच़े। ज़ेतरै तेऊ छ़ुंहां तै तिंयां छ़ुटै हर बमारी का।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">रिती-रबाज़ा मनणैओ सुआल</para>
  <para style="r">(<ref loc="MAT 15:1-9">मोत्ती 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />एकी धैल़ै तै फरीसी अर कई शास्त्री एरुशलेम नगरी का आऐ दै, तिंयां सोभ ज़ण्हैं हुऐ ईशू सेटा कठा। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />तिन्‍नैं भाल़ै ईशूए च़ेल्‍लै कि तिंयां निं रिती-रबाज़े साबै हाथ धोई रोटी खांदै।<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />किल्हैकि सारै यहूदी खासकर फरीसी मणछ धोआ तै आपणैं दादै-बाबै खोज़ै दै रिती-रबाज़े साबै रोटी खाणैं का आजी हाथ ज़रूरी ताऊं तैणीं निं तिंयां रोटी खांदै तै।<verse eid="MRK 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 7:4" />ओरी-पोरी हाट्टा का मोलै आणी दी च़िज़ा बी नांईं तै तिंयां रबाज़े साबै हाथ बाझ़ी धोऐ खांदै तै अर एही आसा होर बी कई गल्‍ला ज़ेता तिंयां ज़रूरी मना तै, ज़िहअ प्रिहअ, झ़ारी अर भांडै धोणैं।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />तैही पुछ़अ फरीसी अर शास्त्री ईशू का, “तेरै च़ेल्‍लै किल्है निं दादा-बाबे रिती-रबाज़ा मंदै? रोटी खाणैं का आजी म्हारै रबाज़े साबै हाथ धोई किल्है निं ईंयां रोटी खांदै?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ईशू बोलअ तिन्‍नां लै इहअ, <char style="wj">“ईशायाह गूरै आसा तम्हां कपटी मणछे बारै पबित्र शास्त्रा दी पैहलै ई ठीक बोलअ द, </char></para>
  <para style="q" vid="MRK 7:6">
    <char style="wj">
      <note caller="+" style="f">
        <char style="fr" closed="false">7:6 </char>
        <char style="ft" closed="false">ईशा. 29:13</char>
      </note>‘ईंयां मणछ होठा का ता करा मेरअ अदर, पर इनो मन्‍न आसा मुखा दूर।</char><verse eid="MRK 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MRK 7:7" />
    <char style="wj">ईंयां करा मेरी च़ाकरी फज़ूल ई, </char></para>
  <para style="q" vid="MRK 7:7">
    <char style="wj">किल्हैकि ईंयां सखाऊआ होरी लोगा का मणछे रिती-रबाज़ मेरअ बधान बोली।’</char><verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />
    <char style="wj">“किल्हैकि तम्हैं मना परमेशरे हुकमा का ज़ादै मणछै बणाऐं दै रिती-रबाज़ा।”</char><verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“तम्हैं आपणैं रिती-रबाज़ा मनणे तैणीं भाल़ा किहै राम्बल़ै करै करा परमेशरे हुकमा दूर!</char> <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" /><char style="wj">ज़िहअ कि मोसा गूरै आसा बोलअ द इहअ ‘आपणैं ईजा-बाबो करै अदर। ज़ुंण आपणैं ईजा-बाबा लै बूरअ बोले तेऊ पाऐ मारी।’<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">लुआ. 20:12; बधा. 5:16</char></note></char><verse eid="MRK 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 7:11" />
    <char style="wj">“पर तम्हैं बोला इहअ, ‘ज़ै कुंण मणछ आपणैं ईजा-बाबा लै इहअ बोले कि ज़ुंण किछ़ हाम्हां तम्हां लै दैणअ त सह हेरअ हाम्हैं परमेशरा लै अर्पण करी दैई। ऐबै निं हाम्हैं थारी मज़त करी सकदै।’</char><verse eid="MRK 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 7:12" />
    <char style="wj">“इहअ करै निं तम्हैं तेऊ मणछा आपणैं ईजा-बाबे च़ाकरी करनै दैंदै।</char> <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" /><char style="wj">इहअ करै ज़ुंण तम्हैं आपणैं रिती-रबाज़ आसा बणाऐं दै तेता करै छ़ाडा तम्हैं परमेशरो हुकम मनणअ अर तम्हैं करा इहै कई काम।”</char><verse eid="MRK 7:13" /></para>
  <para style="s">मणछा छ़ोत लाणैं आल़ी गल्‍ला</para>
  <para style="r">(<ref loc="MAT 15:10-20">मोत्ती 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />तेखअ शादै ईशू तिंयां लोग आप्पू सेटा लै संघा बोलअ इहअ, <char style="wj">“तम्हैं सोभ शूणां मेरी गल्‍ला अर समझ़ा।</char> <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" /><char style="wj">एही निं किछ़ै च़ीज़ आथी ज़ुंण बागा का मणछे पेटै पेशी करै छ़ोत लाआ, पर ज़ुंण मणछे मना का बागै निखल़ा तेता करै लागा तेऊ छ़ोत।</char><verse eid="MRK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 7:16" />
    <char style="wj">“ज़ै कुंण समझ़णअ च़ाहे सह शूणैं मेरी ऐहा गल्‍ला धैन लाई कि मंऐं एभै किज़ै बोलअ।”</char><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />ज़ांऊं ईशू लोगा जैंदरा का घअरा लै डेऊअ, तेऊए च़ेल्‍लै पुछ़अ तेऊ का ऐहा कथ्या खोज़णें बारै ज़ुंण तेऊ तेभै थोल़ी घल़ी पैहलै खोज़अ त।<verse eid="MRK 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 7:18" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं बी अज़ी समझ़ै निं आथी? तम्हां का थोघ निं आथी कि ज़ुंण च़ीज़ बागा का मणछा भितरी डेओआ, तेता करै निं तेऊ छ़ोत लागदी?</char> <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" /><char style="wj">किल्हैकि तिंयां निं तेऊए मन्‍नैं डेऊंदी, तिंयां डेओआ तेऊए पेटा भितरा लै अर दोत्ती दिशा डेऊई निखल़ा बागा लै।”</char> इहअ बोली किई तेऊ सारी खाणैं पिणें च़िज़ा शुची।<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />तेखअ इहअ बी बोलअ ईशू, <char style="wj">“ज़ुंण मणछे भितरा का निखल़ा तेता करै लागा मणछा छ़ोत।</char> <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" /><char style="wj">किल्हैकि भितरा का मतलब ज़ुंण मणछे मना का बूरै बच़ार निखल़ा ज़ुंण मणछा, </char></para>
  <para style="p" vid="MRK 7:21">
    <char style="wj">“कंज़रैई, च़ोरी, हत्या, पराई बेटल़ी संघै डेऊणअ, </char> <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" /><char style="wj">मांण, निक्‍की सोठ, कपट, धोखअ दैणअ, होरी बेटल़ी लै कंज़री सोठ, निंदा करनी, ज़ीद, झ़ुठअ बोल़णअ, घमंड अर ऐडी गल्‍ला बाखा निंयां।</char> <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" /><char style="wj">ईंयां सारी बूरी गल्‍ला निखल़ा भितरा का अर एता ई करै लागा मणछा छ़ोत।”</char><verse eid="MRK 7:23" /></para>
  <para style="s">कनानी बेटल़ीओ विश्वास</para>
  <para style="r">(<ref loc="MAT 15:21-28">मोत्ती 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ईशू लागअ तेखअ गलील मुल्खा का हांढदअ अर तेखअ पुजअ सह सूर सैदा मुल्खै। तिधी एकी घअरै पुजी च़ाहअ त ईशू इहअ कि मेरअ थोघ निं लोल़ी होरी कोही का लागअ कि इधी आसा, पर लोगा का गअ थोघ लागी।<verse eid="MRK 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 7:25" />तिधी गई तेभी एक बेटल़ी एछी, तेसे होछ़ी शोहरी दी त भूत शाचअ द, सह आई ईशूए बारै शूणीं तिधी अर सह पल़ी ईशूए च़रणैं। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />सह थिई यूनानी अर सिरीया मुल्खे सुरूफिनीकी नगरी का। तैहा किई ईशू सेटा अरज़ कि मेरी शोहरी आसा भूत शाचअ द तेऊ भूता काढ तैहा का पोर्ही।<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />ईशू बोलअ तैहा बेटल़ी लै, <char style="wj">“पैहलै दै लान्हैं रज्ज़ी लणैं, किल्हैकि अह गल्‍ल निं ठीक लागणीं कि लान्हैं लै चाणी दी रोटी कुक्‍करा लै दैए!”</char><note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="ft" closed="false">अह गल्‍ल निं ठीक लागणीं कि लान्हैं लै चाणी दी रोटी कुक्‍करा लै दैए!</char></note><verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />तैहा बोलअ ईशू लै, “अह गल्‍ल आसा ठीक, पर हे प्रभू; कुक्‍करा बी हआ लान्हैं खोल़ै शोटै दै ठोर म्हारा न्हैल़ै लागै दै।”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />तेखअ बोलअ ईशू तैहा लै, <char style="wj">“तंऐं दैनअ ठीक ज़बाब! तूह डेऊ ऐबै आपणैं घअरा लै, भूत गअ तेरी शोहरी का निखल़ी।”</char> <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />तैहा भाल़अ आपणैं घअरै पुजी कि भूत गअ तैहा शोहरी का निखल़ी शोहरी ती राम्बल़ी गई दी हई।<verse eid="MRK 7:30" /></para>
  <para style="s">टौणैं अर हंकलै मणछो ठीक हणअ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />तेखअ डेऊअ ईशू सूर अर सैदा मुल्खा का दिकापुलिस बाती हांढदी गलील समुंदरा सेटा। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ता, लोगै आणअ ईशू सेटा लै एक टौणअ अर सह करा त गल्‍ला बी थाभल़ी, संघा किई तिन्‍नैं लोगै ईशू का एही अरज़ कि एऊ छ़ुंह आपणैं हाथा करै ताकि सह राम्बल़अ होए।<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />ईशू निंयं सह मणछ लोगे जेल्ह-मरेल्ही जैंदरा का दूर ज़िहअ। तेऊ पाई आपणीं गुंठी तेऊए कानै। तेखअ आपणीं गुंठी दी धख ज़िहअ थूक लाई करै छ़ुंहीं तेऊए ज़िभ।<verse eid="MRK 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 7:34" />तेखअ सरगा बाखा लै भाल़ी प्राथणां करदी लाम्मअ शाह काढी बोलअ तेऊ मणछा लै आपणीं बोली दी, <char style="wj">“इप्फतह”</char> मतलब, <char style="wj">“खुल्ह”</char> <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />तेऊए काना का लागअ तेभी राम्बल़अ शुण्हदअ, तेऊए ज़िभ बी हुई ठीक अर संघा लागअ सह गल्‍ला करदअ।<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />ईशू बोलअ तिन्‍नां मणछा लै इहअ कि ऐहा गल्‍ला निं कोही का खोज़ी। तेऊ किअ तिन्‍नां लै नांईं पर तिन्‍नैं खोज़ी तिंयां गल्‍ला सारै दी। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />तिंयां लागै रहैन हई बोल्दै, “ज़ुंण बी तेऊ किअ सह किअ बधिया; सह दैआ टौणैं लै शुणने अर काल्‍लै लै दैआ बोल़णें शगती।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">च़ऊ हज़ारा लोगा का रोटी खैऊंणी</para>
  <para style="r">(<ref loc="MAT 15:32-39">मोत्ती 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />एकी बारी आऐ भिई खास्सै मणछ ईशू सेटा लै, संघा हुऐ तिंयां तेऊ फेर कठा। ज़ांऊं तिधी तिन्‍नां तेतरै लोगा का खाणां लै किछ़ै बच़अ,</para>
  <para style="p" vid="MRK 8:1">ईशू शादै आपणैं च़ेल्‍लै आप्पू सेटा लै संघा बोलअ तिन्‍नां लै, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" /><char style="wj">“मुंह लागी इना लोगे खास्सी झींण। किल्हैकि ईंयां आसा मुंह संघै चिई धैल़ी ओर्ही। ऐबै निं इना का खाणां लै बी किछ़ै बच़अ।</char> <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" /><char style="wj">इना मांझ़ै आसा कई दूरा-दूरा का आऐ दै, ज़ै हुंह इना भुखै घअरा लै छ़ाडूं, ईंयां रहणैं बाता पल़ी।”</char><verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ईशूए च़ेल्‍लै बोलअ तेऊ लै, “इधी दूर रेगीस्तानै किधा का लाई हाम्हैं एतरी रोटी आणी कि ईंयां एतरै लोग रज्ज़े।”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ईशू पुछ़अ तिन्‍नां का, <char style="wj">“तम्हां का केतरी रोटी आसा?”</char></para>
  <para style="p" vid="MRK 8:5">तिन्‍नैं बोलअ, “सात।”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />तेखअ बोलअ ईशू तिन्‍नां च़ेल्‍लै लै इहअ कि इना लोगा बशैल़ा धरनीं घेहल़ी दी। ईशू तिंयां सात रोटी ढाकी अर परमेशरो शूकर करी चोल़ी।</para>
  <para style="p" vid="MRK 8:6">तेखअ रहअ आपणैं च़ेल्‍लै हाथै दैंदअ लागी, च़ेल्‍लै लागै लोगा लै घेहल़ी बांडदै। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />तिन्‍नां सेटा ती धख ज़ेही होछ़ी म्हाछ़ली बी, ईशू किअ तेता लै बी परमेशरो शूकर संघा बोलअ तिन्‍नां बी बांडणां लै।<verse eid="MRK 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 8:8" />रोटी अर म्हाछ़ली खाई करै रज्ज़ै तिंयां सोभ लोग, च़ेल्‍लै भरै पिछ़ू बच़ी दी रोटीए सात च़ठै। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />तिधी खाणैं आल़ै लोग तै कोई च़ार हज़ार मर्ध ई मर्ध, संघा छ़ाडै ईशू तिंयां सोभ घअरा लै। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />तेखअ डेऊअ सह तेभी किश्ती दी बेशी आपणैं च़ेल्‍लै संघै दलमनूता नाओंए मुल्खा लै।<verse eid="MRK 8:10" /></para>
  <para style="s">स्वर्गो नछ़ैण मांगणअ</para>
  <para style="r">(<ref loc="MAT 16:1-4">मोत्ती 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />तिधी आऐ फरीसी अर शास्त्री, तिंयां लागै तेऊ संघा इहै हठल़दै अर तेऊ परखणैं तैणीं इहअ बोल्दै कि, ज़ै तूह हाम्हां सेटा लै परमेशरै आसा छ़ाडअ द, तै रहैऊ हाम्हां का सरगै कोई नछ़ैण।<verse eid="MRK 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12" />तेऊ बोलअ आपणीं आत्मां दी लाम्मअ शाह काढी तिन्‍नां लै, <char style="wj">“एऊ ज़मानें मणछ किल्है लोल़ा नछ़ैण? हुंह खोज़ा तम्हां का सत्त कि एऊ ज़मानें मणछा निं कोई बी नछ़ैण भेटणअ।”</char> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />तेखअ डेऊअ सह तिन्‍नां छ़ाडी आपणैं च़ेल्‍लै संघै किश्ती दी बेशी गलील समुंदरा पार।<verse eid="MRK 8:13" /></para>
  <para style="s">फरीसी मणछो अर हेरोदेस राज़ैओ सज़ेल़अ</para>
  <para style="r">(<ref loc="MAT 16:5-12">मोत्ती 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ईशूए च़ेल्‍लै बिस्सरुऐ रोटी आप्पू संघा निंणै अर किश्ती दी थिई तिन्‍नां का एक्‍कै रोटी, <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />तेऊ बोलअ तिन्‍नां लै चतैनगी दैई, <char style="wj">“हेरे, फरीसी मणछे अर हेरोदेस राज़ेए सज़ेल़ै का रहै दूर।”</char><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />तिंयां लागै आप्पू मांझ़ै सोठदै अर इहअ बोल्दै, “हाम्हां का निं सोभी लै रोटी आथी तै आसा अह लागअ द हाम्हां लै एही गल्‍ला बोल्दअ।”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ईशू हेरी तिन्‍नें मन्‍नें गल्‍ल भुझ़ी अर तेऊ तिन्‍नां लै बोलअ, <char style="wj">“तम्हैं आप्पू मांझ़ै इहअ किल्है सोठा कि हाम्हां सेटा निं रोटी आथी? कै तम्हां अज़ी बी थोघ निं लागअ अर अज़ी बी निं समझ़ै आथी? थारअ मन्‍न कै काठअ हुअ?</char> <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><char style="wj">कै तम्हां आछी करै बी निं शुझदअ, अर कान हंदी बी निं शुण्हदअ? तम्हां किछ़ै गल्‍ला निं रही आद?</char><verse eid="MRK 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 8:19" />
    <char style="wj">“ज़ेभै मंऐं पांज़ा हज़ारा मणछा लै रोटी चोल़ी करै दैनी ती, तम्हैं पिछ़ू बच़ी दी रोटीए केतरै च़ठै च़कै तै?”</char></para>
  <para style="p" vid="MRK 8:19">तिन्‍नैं बोलअ “बारा च़ठै”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“अर ज़धू मंऐं च़ार हज़ार मणछा लै सात रोटी चोल़ी करै दैनी ती, तम्हैं पिछ़ू बच़ी दी रोटीए केतरै च़ठै च़कै तै भरी?”</para>
  <para style="p" vid="MRK 8:20">तिन्‍नैं बोलअ, “सात च़ठै।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />तैबै तेऊ तिन्‍नां का बोलअ, “तम्हैं कै अज़ी बी निं समझ़ै?”<verse eid="MRK 8:21" /></para>
  <para style="s">बैतसैदा नगरी एक कांणअ ठीक करनअ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />तेखअ आऐ तिंयां बैतसैदा नगरी दी, लोगै आणअ एक कांणअ मणछ तेऊ सेटा लै अर तिन्‍नैं किई तेऊ का अरज़ कि एऊ छ़ुंह।<verse eid="MRK 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 8:23" />तेऊ निंयं सह कांणअ मणछ हाथा का ढाकी करै नगरी का बागा लै अर तेऊए आछी थूक लाई हाथ डाहै, अर तेऊ का पुछ़अ, <char style="wj">“ऐबै लागअ ताखा शुझदअ ऐ?”</char> <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />तेऊ मणछै बोलअ आछी घुआल़ी करै, “मुखा लागै लोग शुझदै पर राम्बल़अ निस्सअ शुझुई तिंयां शुझिआ मुखा ज़िहै मुंह फेर आसा डाल़ बूट लागै दै हांढदै।”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />तेखअ लाऐ भिई ईशू तेऊए आछी हाथ अर तेऊ कांणै का लागअ राम्बल़अ शुझदअ! अर सह हुअ ज़ाथी ताज़अ-नरोगअ। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ईशू छ़ाडअ सह इहअ बोली घअरा लै, <char style="wj">“ऐहा नगरी निं बापस डेऊई।”</char><verse eid="MRK 8:26" /></para>
  <para style="s">पतरासो ईशू लै “मसीहा” बोल़णअ</para>
  <para style="r">(<ref loc="MAT 16:13-20">मोत्ती 16:13-20</ref>; <ref loc="LUK 9:18-21">लूका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />बैतसैदा नगरी का डेऊऐ ईशू अर तेऊए च़ेल्‍लै कैसरिया मुल्खै अर फलिप्पी नगरी नेल़ गराऊंआं लै, बाता हांढदी पुछ़अ तेऊ आपणैं च़ेल्‍लै का इहअ, <char style="wj">“लोग मुल्है किज़ै बोला कि हुंह कुंण आसा?”</char><verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />तिन्‍नैं बोलअ इहअ, “कई लोग बोला ताल्है कि तूह आसा जोहन्‍ना डुबकी दैणैं आल़अ, पर कई लोग बोला ताल्है एलियाह गूर अर कई बोला ताल्है इहअ कि अह आसा परमेशरे गूरा मांझ़ै ई कोई एक।”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />तेऊ पुछ़अ तिन्‍नां का, <char style="wj">“तम्हैं किज़ै बोला? हुंह कुंण आसा?”</char></para>
  <para style="p" vid="MRK 8:29">पतरासै बोलअ, “तूह आसा मसीहा।”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />ईशू डाहै तिंयां नैरी कि हेरे धैन डाहै मेरै बारै ऐहा गल्‍ला निं कोही का खोज़ी।<verse eid="MRK 8:30" /></para>
  <para style="s">आपणीं मौते बारै ईशूओ पैहलै ई खोज़णअ</para>
  <para style="r">(<ref loc="MAT 16:21-23">मोत्ती 16:21-23</ref>; <ref loc="LUK 9:22">लूका 9:22</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />तेखअ लागअ सह तिन्‍नां का एही गल्‍ला समझ़ाऊंदअ कि मुंह मणछे पूता लै आसा ज़रूरी किई हुंह खास्सै दुख ज़िरे अर सैणैं, बडै प्रोहत अर शास्त्री मुंह बृथा समझ़ी मारी पाए, संघा हुंह चिऊथै धैल़ै ज़िऊंदअ होए।<verse eid="MRK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 8:32" />ईंयां गल्‍ला खोज़ी तेऊ तिन्‍नां का साफ-साफ। ऐहा गल्‍ला लै निंयं पतरासै सह ज़ुदअ ज़िहअ अर सह लागअ तेऊ लै इहअ बोल्दअ, “ताह निं लागा इहअ बोल़णअ मसीहा निं मरी सकदअ।”<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />पर ईशू भाल़अ पिछ़ू फिरी आपणैं च़ेल्‍लै बाखा, संघा बोलअ पतरासा लै, <char style="wj">“राख्स, मुंह सम्हनै का हट दूर। किल्हैकि तेरअ मन्‍न आसा परमेशरा छ़ाडी मणछे गल्‍ला दी।”</char><verse eid="MRK 8:33" /></para>
  <para style="s">ईशू पिछ़ू हांढणेओ मतलब</para>
  <para style="r">(<ref loc="MAT 16:24-28">मोत्ती 16:24-28</ref>; <ref loc="LUK 9:23-27">लूका 9:23-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ईशू शादै तिंयां लोग अर आपणैं च़ेल्‍लै, सोभै ज़ण्हैं आप्पू सेटा लै। तेऊ बोलअ तिन्‍नां लै, <char style="wj">“ज़ुंण बी मेरअ च़ेल्‍लअ बणनअ च़ाहे, सह निं तिन्‍नां गल्‍ला करी सकदअ ज़ुंण तेऊओ दिल च़ाहा। तेऊ लागणै अपराधी ज़िहै ज़ुल्म ज़िरी मेरी तैणीं मरना लै बी तैर रहणअ।</char><verse eid="MRK 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 8:35" />
    <char style="wj">“किल्हैकि ज़ुंण बी ऐहा पृथूई दी आपणीं ज़िन्दगी बच़ाऊंणी च़ाहे, सह पाआ परमेशरा संघै सदा रहणैं आल़ी ज़िन्दगी ज़ांऐं, पर ज़ुंण मेरै खुशीए समादा अर मुंह दी विश्वास करनै पिछ़ू आपणैं प्राण दैए, तेऊ भेटणीं परमेशरा संघै सदा लै ज़िन्दगी।</char><verse eid="MRK 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 8:36" />
    <char style="wj">“ज़ै कुंण मणछ सारै संसारा आपणैं बशै करी सेठ बणें पर आपणैं प्राण बरैबाद पाए, तेऊ किज़ै फाईदअ हणअ?</char> <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" /><char style="wj">ऐहा गल्‍ले बारै सोठा कि मणछा लै आपणीं ज़ानीं का ज़ादै किम्मती किज़ै आसा?</char><verse eid="MRK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 8:38" />
    <char style="wj">“ज़ै तम्हैं मुंह आपणअ प्रभू मनणै अर मेरी शिक्षा मनणै का इहअ ऐहा डरै हुधिए कि एऊ ज़मानें पापी अर कंज़रै लोगा करनअ थारअ सुहांग, तै हुधणअ तेभै मुंह मणछे पूता बी कि तम्हैं निं मेरै च़ेल्‍लै आथी ज़ेभै हुंह आपणैं पबित्र स्वर्ग दूता संघै पृथूई दी फिरी एछणअ। तेभै भाल़णअ सोभी मेरअ प्रतप्प ज़िहअ मेरै बाबो आसा।”</char><verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />तेखअ बोलअ ईशू तिन्‍नां मणछा अर आपणैं च़ेल्‍लै लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ुंण तम्हैं इधी आसा खल़्हुऐ दै, तम्हां मांझ़ै आसा कोऐ इहै बी, कि ज़ेभै तैणीं परमेशरो राज़ पूरी शगती संघै नांईं एछे, तेभै तैणीं निं तिन्‍नां लै मौत एछणी।”</char><verse eid="MRK 9:1" /></para>
  <para style="s">ईशूओ रूप बदल़णअ</para>
  <para style="r">(<ref loc="MAT 17:1-13">मोत्ती 17:1-13</ref>; <ref loc="LUK 9:28-36">लूका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />छ़हा धैल़ी बाद निंयैं ईशू पतरास अर याकब अर जोहन्‍ना सोभै ज़ण्हैं कांगनरांगै दी एकी धारा प्रैंदा लै संघा।</para>
  <para style="p" vid="MRK 9:2">तिधी बधल़ूई ईशूए काया तिन्‍नें सम्हनै एही कि <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />तेऊए झिकल़ै हुऐ इहै शेतै कि ऐहा पृथूईओ कोई बी धोबी निं तिहै झिकल़ै धोई सकदअ। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />तिधी शुझुऐ तिन्‍नां चिई च़ेल्‍लै का परमेशरो गूर मोसा अर एलियाह अर तिंयां दुहै लागै ईशू संघै गल्‍ला करदै।<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />एता लै बोलअ पतरासै ईशू लै, “हे गूरू, अह हुअ ठीक कि हाम्हैं आसा ताह संघै इधी। हाम्हां बणाणैं इधी चअन मंडप, एक ताल्है, एक परमेशरे गूर मोसा लै अर एक एलियाह लै।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />तिन्‍नां का निं थोघै त कि किज़ै बोल़णअ, अर तिंयां थिऐ खास्सै डरै दै।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />तैबै एक बादल़ घोर्हुअ तिन्‍नां प्रैंदै, बादल़ा पिछ़ू का शूणअ तिन्‍नैं कि परमेशर इहअ बोल्दअ, “अह आसा मेरअ पूत शोहरू हुंह करा एऊए बडी झ़ूरी एऊए शूणां ज़िहअ तम्हां लै बोले तिहअ।”<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2 पत. 1:17</ref>; <ref loc="PSA 2:7">भज. 2:7</ref></char></note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />तिन्‍नैं भाल़अ फेर अर ईशू छ़ाडी निं तिन्‍नां आप्पू संघै होर कोहै शुझुअ।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />धारा का उंधै होथदी बोलअ ईशू तिन्‍नां लै, “ज़ेभै तैणीं मुंह मणछे पूता परमेशर मरी करै भिई ज़िऊंदै निं करी हेरे, तेभै तैणीं निं इना गल्‍ला कोही का खोज़ी ज़ुंण तम्हैं आझ़ धारा प्रैंदै भाल़ी।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />तिन्‍नैं डाही ईंयां गल्‍ला आद अर आप्पू मांझ़ै लागै छफल़दै कि मूंऐं दै मणछो ज़िऊंदै हणैंओ मतलब किज़ै आसा होए?<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />तिन्‍नैं पुछ़अ ईशू का, “ईंयां शास्त्री, इहअ बोला, कि एलियाह गूरो आसा मसीहा का आजी एछणअ ज़रूरी?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“ईंयां गल्‍ला, आसा सच्च़ी, परमेशरै आसा आप्पै बोलअ द कि एलियाह एछणअ। तेऊ करनै कई लोग मसीहा एछणें धैल़ी लै तैर। पर मुंह मणछे पूता लै इहअ किल्है आसा लिखअ द कि तेऊ लै हणैं खास्सै दुख अर सह निं तिन्‍नां किछ़ू कामों समझ़णअ?</char><verse eid="MRK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 9:13" />
    <char style="wj">“पर हुंह खोज़ा तम्हां का सत्त कि एलियाह आसा मुक्‍कअ द एछी! ज़िहअ तिन्‍नें दिलै बोलअ तिहै किऐ तिन्‍नैं तेऊ लै दी ज़ुल्म ज़िहअ पबित्र शास्त्रा दी पैहलै ई आसा लिखअ द।”</char><verse eid="MRK 9:13" /></para>
  <para style="s">भूत शाचअ द शोहरू ठीक करनअ</para>
  <para style="r">(<ref loc="MAT 17:14-21">मोत्ती 17:14-21</ref>; <ref loc="LUK 9:37-43">लूका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ज़ांऊं ईशू अर तिंयां चअन च़ेल्‍लै होरी च़ेल्‍लै सेटा धारा का उंधै होथै, ईशू भाल़अ कि तिन्‍नां फेर आसा खास्सै मणछ कठा हुऐ दै अर शास्त्री आसा लागै दै तिन्‍नां संघै हठल़दै। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />अर ईशू भाल़ी हुई सोभी बडी रहैनी, अर तेऊ सेटा लै ठुर्ही एछी किअ नमस्ते।<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />ईशू पुछ़अ तिन्‍नां का, <char style="wj">“तम्हैं इना संघै किज़ू गल्‍ले बारै आसा हठल़दै लागै दै?”</char><verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />तिधी कठा हुऐ दै खास्सै मणछा मांझ़ा का बोलअ एकी ईशू लै, “हे गूरू, मंऐं आसा आपणअ शोहरू ताह सेटा लै आणअ द तेऊ दी आसा काल्‍लअ भूत शाचअ द। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />ज़िधी बी एऊ अह भूत एछा अह पल़ा तेभै धरनीं लाम्मअ, संघा निखल़ा एऊए खाखा का शेफा, अह कीला आपणैं दांद अर तेखअ फिरा अह ल़ेल़अ।</para>
  <para style="p" vid="MRK 9:18">“मंऐं बोलअ तेरै च़ेल्‍लै का बी कि एऊ भूता काढा एऊ का पोर्ही पर इने भलै निस्सअ अह निखल़ी।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />इहअ शूणीं बोलअ ईशू तिन्‍नां लै, <char style="wj">“हे बैहम करनै आल़ै लोगो! मुंह कधू तैणीं रहणअ तम्हां संघा कि तम्हैं विश्वास करे? मुंह केभै तैणीं रहणअ तम्हां न्हैल़ै लागी कि तम्हैं विश्वास करे? ओर्ही आणा एऊ लान्हैं मुंह सेटा लै!”</char><verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />तिन्‍नैं आणअ सह ईशू सेटा लै अर ज़ांऊं ईशू सह भाल़अ, तेऊ भूतै मरोक्‍कअ सह मणछ धरनीं माट्टै जैंदरी बदल़ी अर तेऊए खाखा का निखल़ी शेफा।<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />तिन्‍नैं पुछ़अ तेऊए बाब का, <char style="wj">“एऊए अह एही हालत कधू ओर्ही आसा?”</char> <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />तेऊए बाब बोलअ, “एऊओ आसा अह हाल होछ़ी उझै, एऊ भूतै, अह हारी-मारी आणअ, केभै शोटअ अह तेऊ भूतै पाणीं जैंदरी, केभै शोटअ आगी जैंदरी, ज़ै तूह किज़ै करी सका, हाम्हां लै कर झींण अर एऊ कर ठीक।”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ईशू बोलअ तेऊ लै, <char style="wj">“ज़ै तूह करी सका, अह कै गल्‍ल हुई? विश्वास करनै आल़ै लै सका सोभ गल्‍ला हई।”</char><verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />शोहरूए बाबा का छ़ुटै तेभी लेरा लाई आशू अर तेऊ बोलअ, “हे ईशू, मुंह आसा विश्वास कि तूह सका मेरी मज़त करी पर मेरअ विश्वास निं पाक्‍कअ आथी। तूह कर मेरी मज़त ताकि मेरअ विश्वास पाक्‍कअ होए।”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />ज़ांऊं ईशू भाल़अ कि तिधी झाल़्हुऐ खास्सै मणछ, तेखअ नैरअ सह भूत ईशू सह भूत इहअ बोली, <char style="wj">“काल्‍लै-टौणैं भूता, हुंह बोला ताल्है एऊ शोहरूए देही का निखल़ पोर्ही, एथ निं तूह भिई फिरी एछदअ लागी।”</char><verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />तेखअ पाई तेऊ भूतै ज़ोरै-ज़ोरै लैल़ा-क्रुंगा, संघा निखल़अ तेऊ शोहरू मरोक्‍की करै पोर्ही अर सह शोहरू रहअ धरनीं नर्तान पल़ी। तेऊ भाल़ी लागै लोग बोल्दै कि एऊ शोहरू शोटै प्राण। <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />पर ईशू ढाकअ तेऊ शोहरूओ हाथ, अर सह शोहरू उझ़ुअ खल़अ।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />ज़ांऊं ईशू अर तेऊए च़ेल्‍लै घअरा लै आऐ, तिंयां लागै ईशू का कांगनरांगै इहअ पुछ़दै, “हाम्हैं तेऊ भूता किल्है निं काढी सकै?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“इहै भूता सका तम्हैं सिधी प्राथणां करै काढी एतो निं होर किछ़ै लाज़ आथी।”</char><verse eid="MRK 9:29" /></para>
  <para style="s">ईशू खोज़अ आपणीं मौत हणें बारै पैहलै ई</para>
  <para style="r">(<ref loc="MAT 17:22-23">मोत्ती 17:22-23</ref>; <ref loc="LUK 9:43-45">लूका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />तेखअ डेऊऐ तिंयां तिधा का गलील मुल्खै बाती आजू। ईशू च़ाहा त इहअ कि ऐहा गल्‍लो थोघ निं लोल़ी कोही का लागअ।<verse eid="MRK 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 9:31" />किल्हैकि ईशू करा त आपणैं च़ेल्‍लै लै एही शिक्षा दैई अर इहअ बोली, <char style="wj">“हुंह मणछो पूत बझ़ैल़णअ धोखै करै मेरै दुशमणा का कैद करनै कि मुंह मारी पाए। पर हुंह हणअ चिऊथै धैल़ै भिई ज़िऊंदअ।”</char> <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />पर ईशूए ईंयां गल्‍ला निं तिन्‍नां समझ़ आई, इना गल्‍लो भेद पुछ़णै का बी लागा ती तिन्‍नां डअर।<verse eid="MRK 9:32" /></para>
  <para style="s">सोभी का बडअ कुंण</para>
  <para style="r">(<ref loc="MAT 18:1-5">मोत्ती 18:1-5</ref>; <ref loc="LUK 9:46-48">लूका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />तेखअ आऐ तिंयां कफरनहूम नगरी अर एकी मणछे घअरै पुजी ईशू तिन्‍नां का पुछ़अ, <char style="wj">“बाता तम्हैं किज़ू गल्‍ला पिछ़ू तै हठल़दै लागै दै?”</char><verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />तिंयां सोभ हुऐ च़ुप्पी, किल्हैकि तिंयां थिऐ बाता हांढदी इहअ हठल़दै लागै दै कि हाम्हां मांझ़ै बडअ कुंण आसा? <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />तेखअ बेठअ ईशू धरनीं अर तिंयां बारा च़ेल्‍लै शादै आप्पू सेटा, संघा बोलअ तिन्‍नां लै इहअ, <char style="wj">“ज़ै तम्हां मांझ़ै कुंण बडअ हणअ च़ाहा, तेऊ लागा पैहलै सोभी का होछ़अ सोभिओ दास हणअ।”</char><verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />तेखअ किअ ईशू तिन्‍नां मांझ़ा का एक लान्हअ खल़अ। सह आपणैं भोसल़ै बशैल़ी करै तिन्‍नां लै बोलअ,<verse eid="MRK 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 9:37" />
    <char style="wj">“ज़ुंण बी मेरै नाओंऐं इहै शोहरू लै झींण करे, सह करा मेरी कदर। ज़ुंण मेरी कदर करा सह निं सिधी मेरी कदर करदअ पर सह करा तेऊ परमेशरे कदर ज़ुंणी हुंह संसारा लै आसा छ़ाडअ द।”</char><verse eid="MRK 9:37" /></para>
  <para style="s">ज़ुंण खलाफ निं आथी सह आसा पक्षा दी</para>
  <para style="r">(<ref loc="LUK 9:49-50">लूका 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />तेखअ बोलअ जोहन्‍ना ईशू लै, “हे गूरू, हाम्हैं भाल़अ तेरै नाओंऐं एक मणछ भूता काढदअ हाम्हैं लागै तै तेऊ लै नांईं करदै बी कि इहअ निं करै, किल्हैकि सह हाम्हां संघै, एछदअ निं आथी।”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तेऊ रोक्‍कदै निं लागी किल्हैकि इहअ निं कोहै बी आथी ज़ुंण मेरै नाओंऐं च़मत्कारे काम करा अर तेभी बोले मुल्है बूरअ।</char><verse eid="MRK 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 9:40" />
    <char style="wj">“ज़ुंण म्हारै खलाफ निं आथी सह आसा म्हारै पक्षा दी।</char> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><char style="wj">ज़ुंण बी मसीहे समझ़ी तम्हां लै एक गलास पाणींओ पणैऊंए तेऊ भेटणअ परमेशरा का तेतो फल।”</char><verse eid="MRK 9:41" /></para>
  <para style="s">ज़ुंण होरी का पाप कराऊआ</para>
  <para style="r">(<ref loc="MAT 18:6-9">मोत्ती 18:6-9</ref>; <ref loc="LUK 17:1-2">लूका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />
    <char style="wj">“ज़ुंण मुंह दी विश्वास करनै आल़ै इना लान्हैं ज़िहै भोल़ै मणछा का पाप कराऊआ, तेऊ लै दैणीं परमेशरा सज़ा। तेऊ लै हणअ त इहअ भलअ कि तेऊए गल़ै बडअ थरेट बान्हीं पाणअ त सह समुंदरै डबेऊई</char><verse eid="MRK 9:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 9:43" />
    <char style="wj">“ज़ै तूह आपणैं हाथा करै पाप करा, तेता करै पाप करने पाआ छ़ाड, च़ाऐ ताह सह काटणअ किल्है निं पल़े। टुंडअ हई सदा रहणैं आल़ी ज़िन्दगी दी डेऊणअ आसा ताल्है एता का भलअ कि दुही हाथा संघै तूह जम्परीए आगी दी पल़े ज़ुंण आग कधि निं हिठदी।</char> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" /><char style="wj">जम्परी रहा तिन्‍नें देही खांदअ इहअ किल़अ लागी ज़ुंण कधि निं मरदअ अर नां कधि तिन्‍नां दहणैं आल़ी आग हिठदी।</char><verse eid="MRK 9:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 9:45" />
    <char style="wj">“ज़ै तूह आपणैं खूरा करै पाप करा, तेता बी कर आप्पू का दूर। च़ाऐ ताह सह काटणअ किल्है निं पल़े। किल्हैकि लाट्टअ हई सदा रहणैं आल़ी ज़िन्दगी दी डेऊणअ आसा ताल्है एता का भलअ कि तूह दुही खूरा संघै जम्परीए आगी दी पल़े।</char> <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" /><char style="wj">‘जम्परी रहा तिन्‍नें देही खांदअ इहअ किल़अ लागी ज़ुंण कधि निं मरदअ अर नां कधि तिन्‍नां दहणैं आल़ी आग हिठदी।’</char><verse eid="MRK 9:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 9:47" />
    <char style="wj">“ज़ै तेरी आछी का कई गल्‍ला भाल़ी तूह पाप करा, तिन्‍नां पापा दी पाणै आल़ी गल्‍ला भाल़णैं का रह दूर। च़ाऐ ताह सह आछ पोर्ही किल्है निं पल़े काढणीं। कांणअ हई ई परमेशरे राज़ा दी डेऊणअ आसा ताल्है भलअ कि तूह दूई आछी संघै जम्परी डेओए।</char> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><char style="wj">‘तिन्‍नां हणैं इहै किल़ै पल़ै दै ज़ुंण कधि निं मरदै अर तिन्‍नां हणीं एही आग लागी दी ज़ुंण कधि निं हिठणी।’<note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">ईशा. 66:24</char></note></char><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />
    <char style="wj">“परमेशरा करनअ हरेक मणछ आगी करै शुचअ ज़िहअ बल़ीदान किई दी च़िज़ा लूंण पाई शुचै करा तै।</char> <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" /><char style="wj">लूंण आसा ठीक पर ज़ै लूंणो सुआद लूंणअ नांईं होए, तै सह किज़ू करै करनअ लूंणअ? आप्पू मांझ़ै रहा लूंणा ज़ेही साथ डाही मेल़-ज़ोल़।”</char><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">बैईदाऊअ दैणें बारै ईशूए शिक्षा</para>
  <para style="r">(<ref loc="MAT 19:1-12">मोत्ती 19:1-12</ref>; <ref loc="LUK 16:18">लूका 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ईशू लागअ कफरनहूम नगरी का आपणैं च़ेल्‍लै संघी हांढदअ, संघा पुजै तिंयां यहूदा मुल्खै बाती हांढदी जरदण नदी पारा बाखा। ईशू फेर हुऐ भिई खास्सै मणछ कठा। ईशू लागअ आपणैं साबै तिन्‍नां लै शिक्षा दैंदअ।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />फरीसी मणछ आऐ ईशू सेटा संघा लागै तेऊ इहअ पुछ़ी परखदै, “अह गल्‍ल ठीक आसा कि मर्ध सका आपणीं बेटल़ी छ़ाडी?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ईशू दैनअ इहअ सुआल पुछ़ी तिन्‍नां लै ज़बाब, <char style="wj">“परमेशरे गूर मोसा तम्हां लै एते बारै किज़ै आसा लिखअ द?”</char><verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />तिन्‍नैं बोलअ, “मोसा आसा बैईदाऊअ लिखी करै छ़ाडी दैणा लै बोलअ द।”<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-3">बधा. 24:1-3</ref></char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“मोसा पल़अ एते तैणीं इहअ हुकम लिखणअ कि थारै मन्‍न तै काठै हुऐ दै।</char> <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" /><char style="wj">मणछ आसा पैहलै ई का परमेशरै मर्ध अर बेटल़ी ई बणाऐं दै।<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">मूल. 1:27; मोत्त. 19:4</char></note></char> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><char style="wj">तैही बोला परमेशर कि मर्ध रहणअ आपणैं ईजा-बाबा छ़ाडी आपणीं लाल़ी संघै एक। एही ता थिऐ बैह करनै आल़ै पैहलै दूई ज़ुदै-ज़ुदै मणछ, परमेशर मना तिन्‍नां दुही ऐबै एक मणछे रुपै, तैही च़ाहा सह कि तिंयां लोल़ी बैहा बाद सदा कठा रहै।</char><verse eid="MRK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 10:8" />
    <char style="wj">“तैही निं तिंयां ऐबै दूई देही आथी पर तिंयां रहा एक देही बणी।<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">मूल. 2:24</char></note></char> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" /><char style="wj">एतो मतलब आसा इहअ कि ज़ुंण परमेशरै ज़ोल़ै दै आसा, तिन्‍नां ज़ुदै करदै निं तम्हैं लागा।”</char><verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />च़ेल्‍लै लागै घअरै पुजी इना गल्‍ले बारै पुछ़दै। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ईशू बोलअ तिन्‍नां का, <char style="wj">“ज़ुंण आपणीं बेटल़ी छ़ाडी दुजी संघै बैह करा, सह करा तैहा छ़ाडी दी बेटल़ीए खलाफ कंज़रैई।</char> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" /><char style="wj">ठीक इहअ ई ज़ै कुंण बेटल़ी आपणैं मर्धा छ़ाडी कहा होरी संघै बैह करे, सह बी करा कंज़रैई।”</char><verse eid="MRK 10:12" /></para>
  <para style="s">लान्हैं लै बर्गत</para>
  <para style="r">(<ref loc="MAT 19:13-15">मोत्ती 19:13-15</ref>; <ref loc="LUK 18:15-17">लूका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />तेखअ लागै तिंयां लोग ईशू सेटा लै लान्हैं आणदै कि सह तिन्‍नां दी छ़ुंहीं करै बर्गत दैए पर च़ेल्‍लै लागै तिन्‍नां लै इहअ बोल्दै कि गूरू निं तंग करा।<verse eid="MRK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 10:14" />इहअ भाल़ी आई ईशू तिन्‍नां च़ेल्‍लै लै रोश्शै संघा बोलअ तिन्‍नां लै, <char style="wj">“इना लान्हैं दैआ मुंह सेटा लै एछणैं इना निं रोक्‍का! किल्हैकि परमेशरो राज़ आसा इना लान्हैं ज़िहै मणछो ई।</char> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि ज़ुंण बी परमेशरे राज़ा इना शोहरू ज़िहअ निं मने, सह निं तेथ कधि डेऊई सकदअ।”</char> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ईशू बशैल़ै तिंयां लान्हैं आपणैं भोसल़ै अर तिन्‍नें मुंडै हाथ फेरी करै दैनी तिन्‍नां लै बर्गत।<verse eid="MRK 10:16" /></para>
  <para style="s">सेठ ज़ुआन मणछ</para>
  <para style="r">(<ref loc="MAT 19:16-30">मोत्ती 19:16-30</ref>; <ref loc="LUK 18:18-30">लूका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />तेखअ ज़ांऊं ईशू बाता हांढदअ त लागअ द, एक मणछ आअ ठुर्ही अर तेऊ टेक्‍कै ईशू सेटा ज़ान्हूं संघा लागअ इहअ पुछ़दअ, “हे भलै गूरू, सदा रहणैं आल़ी ज़िन्दगी लै हुंह किज़ै करूं?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ईशू बोलअ तेऊ लै, <char style="wj">“तूह मुल्है भलअ किल्है बोला? परमेशरा सुआई निं होर कोहै बी भलअ आथी।</char> <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" /><char style="wj">ताखा परमेशरे इना हुकमो ता हणअ थोघ कि हत्या निं करनी, कंज़रै निं हणअ, च़ोरी निं करनी, झ़ुठी शाजत निं दैणीं, धोखअ निं दैणअ अर आपणैं ईजा-बाबे करनी च़ाकरी।”<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">लुआ. 20:12-16; रोम. 13:9</char></note></char><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />तेऊ मणछै बोलअ ईशू लै, “हे गूरू, इना गल्‍ला मना हुंह होछ़ी उझै!”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ईशू भाल़अ तेऊ बाखा लै संघा बोलअ तेऊ लै, बडी झ़ूरी करै, <char style="wj">“ताह दी आसा एकी गल्‍ले कामीं, डेऊ, ज़ुंण तेरअ आसा, तेऊ बांड गरीब मणछा लै अर ताल्है भेटणअ तेरअ धन स्वर्गै, अर तेखअ च़ाल्‍ल मुंह संघै।”</char><verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />ज़ांऊं ईशू तेऊ लै ईंयां गल्‍ला बोली, तेऊ हुअ तेतो खास्सअ दुख, अर सह लागअ तिधा का हांढदअ किल्हैकि सह थिअ खास्सअ सेठ।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ईशू भाल़अ फेर संघा बोलअ आपणैं च़ेल्‍लै लै, <char style="wj">“सेठा मणछो परमेशरे राज़ा दी डेऊणअ आसा बेघै कठण।”</char> <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />च़ेल्‍लै हुऐ ईशूए गल्‍ला शूणीं रहैन। ईशू बोलअ तिन्‍नां लै भिई, <char style="wj">“मेरै लान्हैंओ, ज़ुंण धन-माया दी विश्वास डाहा, तिन्‍नां आसा परमेशरे राज़ा दी डेऊणअ कठण।</char><verse eid="MRK 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 10:25" />
    <char style="wj">“ऊँट सका सिऊंणीए पाशी बाती निखल़ी पर सेठ मणछ निं परमेशरे राज़ा दी डेऊई सकदअ।”</char><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />च़ेल्‍लै हुऐ खास्सै रहैन अर तिंयां लागै आप्पू मांझ़ै गल्‍ला करदै, “ज़ै इहअ आसा, तै कुंण सका स्वर्गै डेऊई?” <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />ईशू बोलअ तिन्‍नां बाखा भाल़ी करै, <char style="wj">“ज़ुंण मणछे भलै नांईं हई सकदअ, सह सका परमेशरे भलै हई।”<note caller="+" style="f"><char style="fr" closed="false">10:27 </char><char style="ft" closed="false">आयू. 42:2; लूक. 1:37</char></note></char><verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पतरासै बोलअ ईशू लै, “भाल़, हाम्हैं ता आसा सोभ गल्‍ला छ़ाडी ताह पिछ़ू आऐ दै।”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि तिंयां सोभ ज़ुंणी मेरै अर खुशीए समादे तैणीं आपणैं भाई-बैहणी, आपणैं ईज-बाब, लान्हैं-सुन्हैं अर आपणैं घअर, खेचा-खहल़ा छ़ाडी मुंह पिछ़ू आअ द होए</char><verse eid="MRK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 10:30" />
    <char style="wj">“तिन्‍नां भेटणअ ऐहा ज़िन्दगी दी तेता का बी खास्सअ फल ज़ुंण तिन्‍नां का संसारै पिछ़ू छ़ुटअ। ज़ुंण तिन्‍नैं मुंह पिछ़ू टबर, भाई-बैहणी, ईज-बाब, शोहरू-माठै आल़ै अर खेचा-खहल़ा दी मुंह पिछ़ू दाह-दुख ज़िरे, काल्‍ला धैल़ी भेटणीं तिन्‍नां सदा रहणैं आल़ी ज़िन्दगी।</char><verse eid="MRK 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 10:31" />
    <char style="wj">“पर ज़ुंण एभै आप्पू बडै समझ़ा तिंयां हणैं काल्‍ला धैल़ी होछ़ै अर ज़ुंण एभै होछ़ै नकदरै आसा तिंयां करनै काल्‍ला धैल़ी बडै।”</char><verse eid="MRK 10:31" /></para>
  <para style="s">आपणीं मौते बारै ईशूए चिऊथी बारी खोज़णअ</para>
  <para style="r">(<ref loc="MAT 20:17-19">मोत्ती 20:17-19</ref>; <ref loc="LUK 18:31-34">लूका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />एरुशलेम नगरी लै डेऊंदी त बाता ईशू तिन्‍नां का आजू हांढदअ लागअ द। तेऊए च़ेल्‍लै तै रहैन हुऐ दै। ज़ुंण तेऊ संघै होर तै हांढदै लागै दै तिंयां थिऐ डरै दै। तेखअ निंयैं तेऊ आपणैं तिंयां बारा च़ेल्‍लै आप्पू संघै। तेऊ खोज़ी तिन्‍नां का तिंयां गल्‍ला ज़ुंण आजू ती हणैं आल़ी,<verse eid="MRK 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 10:33" />
    <char style="wj">“शूणां, हाम्हैं आसा च़ाल्‍लै दै एरुशलेम नगरी लै। हुंह मणछो पूत ढाकणअ बडै प्रोहता अर शास्त्री लोगे हाथै। तिन्‍नां लाणअ मुल्है मारी पाणै जोगी दोश अर तेखअ दैणअ तिन्‍नां होरी ज़ातीए हाथै।</char> <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" /><char style="wj">तिन्‍नां करनअ मेरअ सुहांग-मखौल। मुल्है पाणअ तिन्‍नां थुक्‍की अर तेखअ च़िक्‍कणअ कोल़ै करै। खिरी पाणअ तिन्‍नां हुंह मारी। पर हुंह हणअ चिऊथै धैल़ै मरी करै ज़िऊंदअ।”</char><verse eid="MRK 10:34" /></para>
  <para style="s">याकब अर जोहन्‍ने अरज़</para>
  <para style="r">(<ref loc="MAT 20:20-28">मोत्ती 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तेखअ आऐ जबदीए शोहरू याकब अर जोहन्‍ना तेऊ सेटा संघा लागै इहअ बोल्दै, “हे गूरू हाम्हैं च़ाहा तै इहअ कि ज़ुंण हाम्हैं ताखा मांगे तूह करै तेता हाम्हां लै।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं किज़ै च़ाहा, हुंह तम्हां लै कै करूं?”</char><verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />तिन्‍नैं बोलअ ईशू लै, “हाम्हैं च़ाहा तेरै राज़ा दी तेरी महान राज़गाद्दी दी तेरी दैहणीं अर बाऊंईं कुछी बेशणअ।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का निं थोघै कि तम्हैं किज़ै मांगा? ज़ुंण दुखो घुप्पू मुंह लागणअ झुटणअ तेता कै तम्हैं झुटी सका? तम्हां कै होरीए हाथै आपणीं मौत हणें डुबकी दैई सका ज़िहअ तिन्‍नां हुंह पाणअ मारी?”</char><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />तिन्‍नैं बोलअ ईशू लै, “हाम्हैं सका इहअ करी।”</para>
  <para style="p" vid="MRK 10:39">ईशू बोलअ तिन्‍नां लै, <char style="wj">“हाँ, अह आसा सच्च़ी कि तम्हां हेरनअ मुंह ज़िहअ दुखो घुप्पू बी झुटी अर होरीए हाथै मौत हणें डुबकी बी हेरनी तम्हां दैई।</char> <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" /><char style="wj">पर ज़ुंण तैहा ज़ैगा लै परमेशरै आसा छ़ांटै दै, तिन्‍नां छ़ाडी निं होरी आपणैं दैहणै अर बाऊंऐं अदरे ज़ैगा बशैल़णअ मेरअ काम आथी।”</char><verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />इहअ शूणीं आई तिन्‍नां होरी दस च़ेल्‍लै याकब अर जोहन्‍ना लै रोश्शै।<verse eid="MRK 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 10:42" />ईशू शादै तिंयां आप्पू सेटा लै संघा बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का आसा ऐहा गल्‍लो थोघ कि ज़ुंण होरी ज़ातीए सैणैं हआ, तिंयां करा तिन्‍नां दी राज़ अर तिन्‍नां मांझ़ै ज़ुंण बडै हआ तिंयां डाहा तिन्‍नां दी हक।</char> <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><char style="wj">पर तम्हां मांझ़ै निं इहअ आथी, ज़ै तम्हां मांझ़ै कुंण बडअ हणअ च़ाहे, सह बणें पैहलै थारअ दास।</char> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" /><char style="wj">ज़ुंण तम्हां मांझ़ै प्रधान हणअ च़ाहे, सह लोल़ी पैहलै सोभिओ दास बणअ।</char><verse eid="MRK 10:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 10:45" />
    <char style="wj">“हुंह मणछो पूत निं एते तैणीं आथी आअ द कि कुंण मेरी च़ाकरी करे पर हुंह आसा एते तैणीं आअ द कि हुंह होरीए च़ाकरी करे अर सोभी लोगे छ़ुटकारै लै आपणैं प्राण दैए।”</char><verse eid="MRK 10:45" /></para>
  <para style="s">बरतिमांई नाओं कांणअ मणछ किअ नरोगअ</para>
  <para style="r">(<ref loc="MAT 20:29-34">मोत्ती 20:29-34</ref>; <ref loc="LUK 18:35-43">लूका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />एरुशलेम नगरी लै डेऊंदी पुजै ईशू अर तेऊए च़ेल्‍लै जेरिहो नगरी। ईशू अर तेऊए च़ेल्‍लै लागै जेरिहो का आजू हांढदै। तिधी आऐ खास्सै मणछ।</para>
  <para style="p" vid="MRK 10:46">तिमांई नाओंए मणछो शोहरू बरतिमांई त एक कांणअ भिख मांगणै आल़अ बाते बाढै बेठअ द। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ज़ांऊं तेऊ कांणै मणछै शूणअ कि अह आसा नासरत नगरीओ ईशू, तेऊ बोलअ, “हे राज़ै दाबेदे लुआद ईशू, मुल्है कर झींण।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />सोभ लागै तेऊ कांणै मणछा लै नैरदै कि च़ुप्पी रह।</para>
  <para style="p" vid="MRK 10:48">पर सह रहअ तेतरअ खास्सअ बोल्दअ ई लागी, “हे राज़ै दाबेदे लुआद, ईशू मुल्है कर झींण।”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तेखअ खल़्हुअ ईशू संघा बोलअ लै, <char style="wj">“एऊ कांणै मणछा आणा ओर्ही मुंह सेटा लै।”</char></para>
  <para style="p" vid="MRK 10:49">तिन्‍नैं लोगै शादअ सह कांणअ मणछ संघा लागै इहअ बोल्दै, “हिम्मत डाह, खल़अ उझ़ू, ईशू शादा ताह आप्पू सेटा लै।” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />तेऊ शोटै आपणैं झिकल़ै तिधी अर सह आअ तेभी ईशू सेटा लै।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ईशू बोलअ तेऊ लै, <char style="wj">“तूह किज़ै च़ाहा कि हुंह ताल्है करूं?”</char></para>
  <para style="p" vid="MRK 10:51">कांणै बोलअ ईशू लै, “हे गूरू, मेरी आछी कर ठीक मुखा लोल़ी शुझुअ।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ईशू बोलअ तेऊ लै, <char style="wj">“डेऊ, तेरै विश्वासै किअ तूह नरोगअ।”</char> तेऊ का लागअ तेभी शुझदअ अर सह लागअ बातै ईशू पिछ़ू हांढदअ।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">एरुशलेम नगरी लै डेऊणअ</para>
  <para style="r">(<ref loc="MAT 21:1-11">मोत्ती 21:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>; <ref loc="JHN 12:12-19">जोहन्‍ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />तेखअ पुजै तिंयां एरुशलेम नगरी नेल़ जैतून धारा दी। सह ज़ैगा ती बेतफगे अर बेथनी गराऊंआं सेटा। तिधी शादै ईशू आपणैं च़ेल्‍लै मांझ़ै दूई ज़ण्हैं,</para>
  <para style="p" vid="MRK 11:1">संघा बोलअ तेऊ तिन्‍नां लै इहअ, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" /><char style="wj">“एऊ सम्हने घअरा लै डेओआ। तिधा का आणा एक गाधू ज़हा दी आझ़ तैणीं कोहै निं बेठअ द आथी। सह भेटणअ तिधी तम्हां बान्हअ द। तेऊ आणा खोल्ही।</char> <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" /><char style="wj">ज़ै तम्हां का कुंण पुछ़े कि तम्हैं अह किल्है लाअ निंईं? तम्हैं बोलै तिन्‍नां लै इहअ कि प्रभू पल़ी एते गरज़ तेखअ हेरनअ सह तेऊ तेभी तम्हां लै दैई।”</char><verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />तिंयां बी डेऊऐ अर तिन्‍नैं भाल़अ गाधू आसा खोल़ै दुआरे काछ़ा बान्हअ द, तिंयां लागै तेऊ खोल्हदै।<verse eid="MRK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 11:5" />ज़ुंण तिधी खल़्हुऐ दै तै, कई लागै तिन्‍नां मांझ़ै तिन्‍नां लै इहअ बोल्दै, “तम्हैं किल्है लाअ अह गाधू खोल्ही?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />ज़िहअ ईशू तिन्‍नां का बोली त डाहअ द, तिहअ ई खोज़अ तिन्‍नैं च़ेल्‍लै बी तिन्‍नां का, इना गल्‍ला शूणीं दैनअ तिन्‍नैं लोगै तिन्‍नां सह गाधू निंणै।<verse eid="MRK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 11:7" />च़ेल्‍लै पजैल़अ सह गाधू ईशू सेटा अर तेऊ प्रैंदै पाऐ आपणैं झिकल़ै अर ईशू हुअ तेऊ गाधू प्रैंदै शुंआर।<verse eid="MRK 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 11:8" />कई लोगै छ़ैऐ आपणैं झिकल़ै तेऊए सुआगत करना लै धरनीं बाता अर कई छ़ैई आपणैं खेचा का नरम डाल़ी आणी बाता। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ज़ुंण खास्सै मणछ तेऊ आजू-पिछ़ू हांढणै आल़ै थिऐ तिंयां लागै ज़ोरै-ज़ोरै बोल्दै,<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:26">भज. 118:26</ref>; <ref loc="MAT 23:39">मोत्त. 23:39</ref></char></note></para>
  <para style="q" vid="MRK 11:9">“परमेशरे ज़ै-ज़ैकार</para>
  <para style="q" vid="MRK 11:9">परमेशर दैआ तेऊ लै बर्गत ज़ुंण तेऊए नाओंऐं एछा।<verse eid="MRK 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MRK 11:10" />परमेशरा दैणीं ताल्है बर्गत ज़ेभै ताह म्हारै दाद-बाब दाबेद राज़ै ज़िहअ राज़ करनअ।</para>
  <para style="q" vid="MRK 11:10">स्वर्गै रहणैं आल़ै परमेशरे ज़ै-ज़ैकार।”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ईशू पुजअ एरुशलेम अर तिधी डेऊअ सह परमेशरे भबनै तेखअ सारी नगरी फेर भाल़ी सारी च़िज़ा भाल़ी डेऊअ आपणैं बारा च़ेल्‍लै संघै बेथनी गराऊंआं लै, किल्हैकि सान्ह गई ती पल़ी।<verse eid="MRK 11:11" /></para>
  <para style="s">फल़ा बाझ़ी फेडूओ बूट</para>
  <para style="r">(<ref loc="MAT 21:18">मोत्ती 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />दुजी धैल़ी ज़ांऊं तिंयां बेथनी गराऊंआं का डेऊऐ, ईशू आई भुखै। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />सह डेऊअ दूरा का एकी फेडूए हरै बूटा भाल़ी तेता सेटा इहअ सोठी करै कि एथ भेटणअ किज़ै खाणां लै, पर तेथ निं पाचा छ़ाडी होर किछ़ भेटअ। किल्हैकि तिंयां धैल़ै नांईं तै फेडू दी फल़ा लागणे आथी। <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />एता लै बोलअ ईशू इहअ, <char style="wj">“ताह निं आझ़ा पोर्ही कधि फल़ दैणअ।”</char> तेऊए च़ेल्‍लै तै शूणैं लागै दै।<verse eid="MRK 11:14" /></para>
  <para style="s">ईशू दरल़ाऊऐ परमेशरे भबना का बपारी</para>
  <para style="r">(<ref loc="MAT 21:12-17">मोत्ती 21:12-17</ref>; <ref loc="LUK 19:45-48">लूका 19:45-48</ref>; <ref loc="JHN 2:13-22">जोहन्‍ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />तेखअ आऐ तिंयां एरुशलेम नगरी। ईशू डेऊअ परमेशरे भबना लै, अर ज़ुंण तिंयां तिधी ढब्बै-धेल्‍लै बदल़ी लैण-दैण करदै तै लागै दै, तिंयां सोभ काढै तेऊ बागा लै। सुन्‍नैं-च़ंदी अर पालल़ी बेच़णैं आल़ेए थल़्ही पाई तेऊ ढोल़ी। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />भबने खोल़ै बाती निं तेऊ कोही किछ़ी च़िज़ा आणनैं अर निंणै दैनअ।<verse eid="MRK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 11:17" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का थोघ निं आथी कि बधाना दी आसा लिखअ द, ‘मेरअ भबन हणअ सोभी ज़ातीए लोगा लै प्राथणां करने ज़ैगा?’ पर तम्हैं आसा अह च़ोरा-डाकू लुक्‍की रहणें खोख बणाईं दी।”</char><note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="LUK 19:46">लूक. 19:46</ref>; <ref loc="JER 7:11">जेर. 7:11</ref></char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />इहअ शूणीं लागै बडै प्रोहत, शास्त्री तेऊ मारने मोक्‍कै लोल़ै, किल्हैकि तिंयां डरा तै तेऊ का इहअ करै कि तेऊए शिक्षा पाआ ती सोभी लोगा मांझ़ै असर।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />धैल़अ उडी करै डेऊऐ तिंयां नगरी का बागै।<verse eid="MRK 11:19" /></para>
  <para style="s">शुक्‍कै दै फेडूए बूटा का सीख</para>
  <para style="r">(<ref loc="MAT 21:20-22">मोत्ती 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ज़ेभै तिंयां दोत्ती तेस्सी बाती डेऊऐ, तिन्‍नैं भाल़अ सह फेडूओ बूट च़ुंडी का गोधै तैणीं शुक्‍कअ द। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />तैबै फिरी पतरासा सह गल्‍ल आद संघा बोलअ तेऊ ईशू लै, “हे गूरू, अह फेडूओ बूट ज़हा लै तंऐं फिटक दैनअ त सह शुक्‍कअ!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ईशू बोलअ पतरासा लै, <char style="wj">“तूह किल्है हुअ रहैन? परमेशरा दी डाहा विश्वास।</char><verse eid="MRK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 11:23" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ुंण विश्वास करी बोले अर बैहम नां करे कि अह धार लोल़ी पेछ़ुई करै समुंदरै पल़ी, सह पल़णीं समुंदरै। आपणैं मन्‍नैं बैहम निं करी विश्वासा संघै बोलै, तै ज़ुंण तूह बोले सह जाणअ हई।</char><verse eid="MRK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 11:24" />
    <char style="wj">“हुंह बोला तम्हां लै इहअ, ज़ेभै बी तम्हैं किज़ै प्राथणां करी परमेशरा का मांगे, तम्हैं करै इहअ विश्वास कि ज़ुंण मंऐं मांगअ सह गअ मुंह भेटी। ज़ै तम्हैं इहअ विश्वास करे, परमेशरा हेरनअ सह काम तम्हां लै करी।</char><verse eid="MRK 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 11:25" />
    <char style="wj">“ज़ेभै तम्हैं प्राथणां करे अर थारै मन्‍नैं कहा लै ज़ीद होए, तिन्‍नां लै करै माफ, तै करनै थारै बाब परमेशरा ज़ुंण स्वर्गै आसा, थारै पाप बी माफ।”</char><verse eid="MRK 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 11:26" />
    <char style="wj">“ज़ै तम्हैं कसरै ज़ुल्म माफ नांईं करे, थारअ बाब परमेशर ज़ुंण स्वर्गै आसा, तेऊ बी निं थारै पाप माफ करनै।”</char><verse eid="MRK 11:26" /></para>
  <para style="s">ईशूए हको सुआल</para>
  <para style="r">(<ref loc="MAT 21:23-27">मोत्ती 21:23-27</ref>; <ref loc="MAT 20:1-8">20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ज़ांऊं तिंयां एरुशलेम नगरी दी आऐ, अर तिंयां थिऐ भबने खोल़ै हांढदै-फिरदै लागै दै, बडै प्रोहत, शास्त्री अर सैणैं लागै ईशू का पुछ़दै, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“ताल्है इना कामां करना लै कुंणी बोलअ? अर अह हक ताल्है कुंणी दैनअ?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंबी पुछ़ा तम्हां का एक सुआल, ज़ै तम्हैं मेरी गल्‍लो ज़बाब दैए, तै खोज़णअ मुंह बी तम्हां का कि मुल्है इना कामां करनैओ हक कुंणी दैनअ।</char> <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" /><char style="wj">जोहन्‍ने डुबकी कहा बाखा का आसा ती? स्वर्गा बाखा का कि संसारे मणछा बाखा का? मेरी गल्‍लो ज़बाब दैआ!”</char><verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />तिंयां लागै तेखअ आप्पू मांझ़ै इहै हठल़दै, “ज़ै हाम्हैं इहअ बोले कि स्वर्गा का, तै एऊ बोल़णअ हाम्हां लै इहअ कि तै तम्हैं तेऊओ विश्वास किल्है निं किअ?<verse eid="MRK 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 11:32" />“ज़ै हाम्हैं इहअ बोले कि संसारे मणछा बाखा का, मणछे बोलै, लोगा का लागी डअर</para>
  <para style="p" vid="MRK 11:32">“किल्हैकि सोभ लोग मना तै इहअ कि जोहन्‍ना त परमेशरो असली गूर। <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />हाम्हां का निं थोघै कि जोहन्‍ना कहा का भेटअ तेतो हक।”</para>
  <para style="p" vid="MRK 11:33">ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं निं मेरै सुआलो ज़बाब दैनअ आथी! हुंबी निं तम्हां लै ऐहा गल्‍ला खोज़दअ कि मुल्है हिझ़ इना कामां करनैओ हक कुंणी दैनअ।”</char><verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">कदुष्ट कृषाणे कथ्या</para>
  <para style="r">(<ref loc="MAT 21:33-46">मोत्ती 21:33-46</ref>; <ref loc="LUK 20:9-19">लूका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />तेखअ खोज़ी ईशू तिन्‍नां का एक कथ्या, <char style="wj">“एकी मणछै लाअ एक दाखो बाग अर तेता फेर लाऐ बाल़। एक बणाईं दाखे रसा लै कोफर। बागे पहरै करना लै डाही तिधी उछ़टै एक छ़ान बणाईं।</char></para>
  <para style="p" vid="MRK 12:1">
    <char style="wj">“तेखअ डाहअ होरी कृषाणा का सह बाग ठेकै दी दैई अर आप्पू डेऊअ सह परदेसा लै।</char><verse eid="MRK 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 12:2" />
    <char style="wj">“तेखअ फल़ा दैणें सिज़नै छ़ाडअ तेऊ कृषाणा सेटा आपणअ एक दास इहअ बोली कि दाखे बागा दी ज़ुंण फसल लागी दी होए तेतो हेस्सअ आणै मांगी।</char> <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" /><char style="wj">पर तिन्‍नैं कृषाणै ढाकअ सह संघा छ़ाडअ च़िक्‍की-फणाटी रित्तअ बापस।</char><verse eid="MRK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 12:4" />
    <char style="wj">“तेखअ छ़ाडअ तिन्‍नां सेटा तेऊ एक होर दास पर तिन्‍नैं फाल़अ तेऊओ मूंड अर तेऊए निं कोई कदर किई।</char> <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" /><char style="wj">संघा तेऊ एक होर दास बी छ़ाडअ, पर तिन्‍नैं पाअ सह बी मारी। इहै ई छ़ाडै तेऊ मालकै तिन्‍नां सेटा लै होर बी कई, पर तिन्‍नैं कृषाणै पाऐ तिंयां कोई च़िक्‍की-फणाटी अर कई पाए तिन्‍नां मांझ़ै मारी।</char><verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />
    <char style="wj">“ऐबै त तेऊओ एक्‍कै पूत रहअ द, ज़हा लै सह सोभी का खास्सी झ़ूरी करा त। खिरी छ़ाडअ तेऊ सह आपणअ शोहरू बी। तेऊ सोठअ इहअ, ‘मेरै शोहरूए हेरनी तिन्‍नां कदर करी।’</char><verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />
    <char style="wj">“तिन्‍नैं कृषाणै बोलअ आप्पू मांझ़ै जोग करी, ‘अह ई ता आजू तेऊए लुआद आसा, एछा अह पाणअ हाम्हां मारी अर फसल हणीं सोभ म्हारी।’</char> <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" /><char style="wj">तिन्‍नैं पाअ सह मारी अर सह डाहअ दाखे बागा का पोर्ही शोटी।”</char><verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />ईशू पुछ़अ, <char style="wj">“तेखअ ऐबै तेऊ बागे मालका तिन्‍नां संघै किज़ै करनअ होए? हुंह खोज़ा तम्हां का कि तेऊ एछणअ अर तिंयां कृषाण निं तेऊ ज़िऊंदै छ़ाडणैं। दाखो बाग दैणअ होरी लै।”<note caller="+" style="f"><char style="fr" closed="false">12:9 </char><char style="ft" closed="false">भज. 118:23</char></note></char><verse eid="MRK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 12:10" />
    <char style="wj">“तम्हैं कै पबित्र शास्त्रा दी पहल़अ द निं आथी?</char></para>
  <para style="q" vid="MRK 12:10">
    <char style="wj">‘ज़ुंण पात्थर राज़ मिस्त्री बृथा समझ़अ त, </char></para>
  <para style="q" vid="MRK 12:10">
    <char style="wj">सह ई बणाईं तेऊ कूणींए ज़ान।</char><verse eid="MRK 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MRK 12:11" />
    <char style="wj">ईंयां गल्‍ला हुई प्रभू बाखा अर</char></para>
  <para style="q" vid="MRK 12:11">
    <char style="wj">ईंयां गल्‍ला शुझुई हाम्हां का नुआहरी।’”</char><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />तिंयां च़ाहा तै ईशू ढाकणअ, किल्हैकि तिंयां गऐ तै समझ़ी कि एऊ बोली ईंयां गल्‍ला हाम्हां लै। पर तिंयां डरै लोगा का कि इहअ निं हआ कि लोग म्हारअ बरोध करे अर तिन्‍नैं निं सह ढाकअ आथी अर तिंयां लागै तिधा का हांढदै।<verse eid="MRK 12:12" /></para>
  <para style="s">माहा राज़ै लै कारै दैणैंओ सुआल</para>
  <para style="r">(<ref loc="MAT 22:15-22">मोत्ती 22:15-22</ref>; <ref loc="LUK 20:20-26">लूका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />यहूदी छ़ाडै ईशू लै दोश लोल़णें तैणीं किछ़ फरीसी अर हेरोदेस राज़ेए पक्ष लणैं आल़ै लोग तेऊ सेटा लै तेऊ परखदै।<verse eid="MRK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 12:14" />तिन्‍नैं बोलअ तेऊ लै, “हे गूरू, हाम्हां का आसा थोघ कि तूह आसा शुचअ, अर तूह निं कोहिए परबाह करदअ, अर नां तूह मणछे मुंहां भाल़ी गल्‍ला करदअ, पर तूह खोज़ा परमेशरा सेटा डेऊणे बात बडी सत्त संघै। पर हाम्हां का खोज़ इहअ, माहा राज़ै लै कारअ दैणअ ठीक आसा कि गलत आसा? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />हाम्हां कारअ दैणअ लागा कि नांईं?”</para>
  <para style="p" vid="MRK 12:15">ईशू हेरअ तिन्‍नें दिलो कपट समझ़ी संघा बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं मुंह परखदै किल्है आसा लागै दै? एक च़ंदीओ सिक्‍कअ आणा मुंह सेटा लै, मुंह भाल़णअ सह।”</char> <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />तिन्‍नैं आणअ एक च़ंदीओ सिक्‍कअ, तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“एथ कसरी मुहुर्ती अर नाअं आसा।”</char></para>
  <para style="p" vid="MRK 12:16">तिन्‍नैं बोलअ, “माहा राज़ैओ नाअं अर मुहुर्ती।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“ज़ुंण माहा राज़ैओ आसा, तेऊ दैआ माहा राज़ै लै, ज़ुंण आसा परमेशरो तेऊ दैआ परमेशरा लै।”</char></para>
  <para style="p" vid="MRK 12:17">तिंयां हुऐ तेऊए गल्‍ला शूणीं रहैन।<verse eid="MRK 12:17" /></para>
  <para style="s">भिई ज़िऊंदै हणअ अर बैह</para>
  <para style="r">(<ref loc="MAT 22:23-33">मोत्ती 22:23-33</ref>; <ref loc="LUK 20:27-40">लूका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />तेखअ आऐ तिधी सदुकी पंथे लोग। तिंयां मना तै इहअ, “मूंऐं दै मणछो ज़िऊंदै हणैं आल़ी गल्‍ल आसा झ़ुठी।”</para>
  <para style="p" vid="MRK 12:18">तिन्‍नैं पुछ़अ ईशू का, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“हे गूरू, परमेशरे गूर मोसा आसा हाम्हां लै इहअ लिखअ द कि, ज़ै कसरअ भाई बाझ़ी लुआदी मरे अर तेऊए लाल़ी पिछ़ू कल्ही छ़ुटे, तेऊओ भाऊ सका तैहा संघै बैह करी। सह आपणैं भाई लै लुआद बी सका पैईदा करी।<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="GEN 38:8">मूल. 38:8</ref>; <ref loc="DEU 25:5">बधा. 25:5</ref></char></note><verse eid="MRK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 12:20" />“एकी ज़मानें गल्‍ल आसा एही कि एकी बारी तै सात भाई, पैहलअ भाई मूंअ बैहा बाद अर तेऊए निं आजू लुआद हुई, <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />अर दुजै भाई किअ तेऊए बेटल़ी संघै बैह अर सह बी मूंअ तेऊए बी निं लुआद हुई, इहअ ई चिऐ भाई बी किअ अर सह बी मूंअ।<verse eid="MRK 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 12:22" />“इहअ करै मूंऐं तिंयां सात भाई अर लुआद निं तिन्‍नां कोहिए हुई खिरी मूंईं सह बेटल़ी बी। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />ता, ऐबै ज़ेभै सह भिई ज़िऊंदी हणीं, सह तिन्‍नां साता भाई मांझ़ै कसरी बेटल़ी हणीं? किल्हैकि सह ता पैहलै साता ज़ण्हे बेटल़ी ती?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का नांईं ता पबित्र शास्त्रो थोघ आथी, अर नां परमेशरे शगतीओ थोघ आथी?</char> <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" /><char style="wj">ज़ेभै तिंयां मूंऐं दै मांझ़ै ज़िऊई उझ़णै, तेभै नां ता तिन्‍नां बैह करनअ। नां तिंयां बैहा लै दैणैं। पर स्वर्गै हणैं तिंयां स्वर्ग दूता ज़िहै।</char><verse eid="MRK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 12:26" />
    <char style="wj">“मरी करै ज़िऊंदै हणें बारै कै तम्हैं, मोसा गूरे कताबा दी ज़ल़दै झ़ाकल़ा आल़ी कथ्या निं शूणीं आथी कि परमेशरै आपणैं गूर मोसा लै किज़ै बोलअ, ‘हुंह आसा सह परमेशर ज़हा तेरै दाद-बाब आबराम, इसहाक अर याकब मना तै!’ </char><verse eid="MRK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 12:27" />
    <char style="wj">“इहअ बी बोलअ ‘परमेशर निं मूंऐं दै मणछो आथी, परमेशर आसा ज़िऊंदै मणछो।’ पर तम्हैं आसा बडी भूला दी पल़ै दै।”</char><verse eid="MRK 12:27" /></para>
  <para style="s">सोभी का खास हुकम</para>
  <para style="r">(<ref loc="MAT 22:34-40">मोत्ती 22:34-40</ref>; <ref loc="LUK 10:25-28">लूका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />शास्त्री मांझ़ै शुणें एकी तिंयां आप्पू मांझ़ै छफल़दै कि एऊ, ईंयां बडै बधिया करै समझ़ाऊऐ अर तेऊ पुछ़अ ईशू का, “सोभी का खास हुकम किज़ै आसा?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ईशू बोलअ तेऊ लै, <char style="wj">“सोभी का खास हुकम आसा अह, इज़राईलीओ, शूणां! म्हारअ परमेशर बिधाता आसा एक्‍कै ज़ुंण असली परमेशर आसा।</char><verse eid="MRK 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 12:30" />
    <char style="wj">“तम्हैं करै आपणैं परमेशर बिधाता लै आपणअ सारअ मन्‍न, प्राण अर आपणअ सारअ ज़ोर लाई झ़ूरी।</char> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" /><char style="wj">दुजअ हुकम आसा अह कि तूह करै आप्पू फेर रहणैं आल़ै होरी मणछा लै बी तेही झ़ूरी ज़िहअ तूह आप्पू लै झ़ूरा। एता का बडअ निं होर कोहै हुकम आथी।”</char><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />शास्त्री बोलअ ईशू लै, “हे गूरू, तंऐं बोली शुची गल्‍ला कि सह आसा एक्‍कै, अर तेऊ छ़ाडी निं होर कोहै परमेशर आथी।<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="ISA 45:18">ईशा. 45:18</ref>; <ref loc="DEU 4:35">बधा. 4:35</ref></char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />तेऊ संघै डाहणीं सारै दिला, मन्‍न, प्राण अर सारै कामां करै झ़ूरी।</para>
  <para style="p" vid="MRK 12:33">“आपणैं साथी-संघी लै बी झ़ूरै तिहअ ई ज़िहअ तूह आप्पू लै झ़ूरा, ईंयां गल्‍ला आसा सारी भैंट, हूम बल़ी अर सोभी बल़ीदाना का खास।”<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">बधा. 6:4-5</ref>; <ref loc="LEV 18:18">लेब. 18:18</ref>; <ref loc="HOS 6:6">होश. 6:6</ref></char></note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />ज़ांऊं ईशू भाल़अ कि तेऊ दैनअ बडी समझ़ा संघै ज़बाब, ईशू बोलअ तेऊ लै, <char style="wj">“तूह आसा परमेशरे राज़ा नेल़।”</char> तेखअ निं कोही बी तेऊ का पुछ़णें हिम्मत हुई।<verse eid="MRK 12:34" /></para>
  <para style="s">मसीहा कसरअ शोहरू आसा?</para>
  <para style="r">(<ref loc="MAT 22:41-46">मोत्ती 22:41-46</ref>; <ref loc="LUK 20:41-44">लूका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />तेखअ बोलअ ईशू परमेशरे भबनै शिक्षा दैंदी बारी इहअ, <char style="wj">“शास्त्री किल्है बोला इहअ कि मसीहा आसा दाबेद राज़ैओ शोहरू?</char> <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" /><char style="wj">दाबेद राज़ै आसा आप्पै ई पबित्र आत्मां दी भर्हुई करै बोलअ </char></para>
  <para style="q" vid="MRK 12:36">
    <char style="wj">
      <note caller="+" style="f">
        <char style="fr" closed="false">12:36 </char>
        <char style="ft" closed="false">भज. 110:1</char>
      </note>‘परमेशर बिधाता बोलअ मेरै प्रभू का, </char></para>
  <para style="q" vid="MRK 12:36">
    <char style="wj">मेरी दैहणै बेश, </char></para>
  <para style="q" vid="MRK 12:36">
    <char style="wj">ज़ेभै तैणीं हुंह तेरै दुशमणा तेरै खूरा हेठै निं करूं।’</char><verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />
    <char style="wj">“राज़अ दाबेद ता आप्पू बी तेऊ लै प्रभू बोला त! तेखअ मसीहा तेऊओ शोहरू केऊ साबै हुअ? अर लोग शूणां तै तेऊए गल्‍ला बडै धैन दैई करै।”</char><verse eid="MRK 12:37" /></para>
  <para style="s">शास्त्री का रहै चतैन</para>
  <para style="r">(<ref loc="MAT 23:1-36">मोत्ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लूका 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ईशू दैनी तिन्‍नां लै शिक्षा, <char style="wj">“इना शास्त्री का रहै चतैन, ज़ुंणी ईंयां लोगा रहैऊंणा लै लाम्मै च़ोल़ै हआ बान्हैं दै। कि तिंयां किहै महान आसा। ईंयां च़ाहा कि लोगै लोल़ी तिन्‍नां सेटा हाथ ज़ोल़ै।</char> <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" /><char style="wj">सभागृहा लोल़ी इना खास-खास ज़ैगा बेशणा लै। धामा दी च़ाहा तिंयां ज़ुदै ज़िहै खास ज़ैगा बेशणअ।</char> <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" /><char style="wj">ईंयां लुटा च़लाकी करै बिधबा बेटल़ीए घअर। होरी का रहैऊंणा लै फिरा ईंयां खास्सी घल़ी प्राथणां करदै। इना लै भेटणीं सोभी का खास्सी सज़ा।”</char><verse eid="MRK 12:40" /></para>
  <para style="s">गरीब बिधबा बेटल़ीओ दान</para>
  <para style="r">(<ref loc="LUK 21:1-4">लूका 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ईशू लागअ भबने भढारा सेटा भाल़अ कि ईंयां भबने भढारै ढब्बै-धेल्‍लै केऊ साबै पाआ, बडै-बडै सेठ मणछै पाऐ आपणैं साबै खास्सै ढब्बै। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />तेतरी आई एक गरीब बिधबा, सह भाल़ी ईशू दूई चाम्बे सिक्‍कै पांदी ज़ेते खास्सी किम्मत निं हंदी।<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />तेखअ शादै ईशू आपणैं च़ेल्‍लै आप्पू सेटा लै। तेऊ बोलअ तिन्‍नां लै इहअ, <char style="wj">“हुंह खोज़ा तम्हां लै सत्त कि भबने भढारै दान दैणैं आल़ै मांझ़ै दैनअ ऐहा गरीब बिधबा सोभी का खास्सअ दान।</char><verse eid="MRK 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 12:44" />
    <char style="wj">“किल्हैकि सोभी दैनअ आपणैं खास्सै ढब्बै मांझ़ै आपणीं खास्सी ज़ैदाता का। पर ऐहा गरीब बिधबा दैनअ आपणीं काम्मी-पेशी का आपणीं सारी कमाई।”</char><verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">परमेशरे भबनो बनाश</para>
  <para style="r">(<ref loc="MAT 24:1">मोत्ती 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">लूका 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />ज़ांऊं ईशू भबना का डेऊई च़ाल्‍लअ त, तेऊए च़ेल्‍लै मांझ़ै बोलअ एकी तेऊ लै, “हे गूरू, भाल़, केही बडी-बडी कोठी अर पात्थर आसा।”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“ज़ुंण तम्हैं इना बडी कोठी भाल़ा, एक बगत एछणअ इहअ बी कि ईंयां सोभ पाणै ढोल़ी। एथ निं पात्थरा प्रैंदै पात्थर बी टेक्‍कअ द रहणअ।”</char><verse eid="MRK 13:2" /></para>
  <para style="s">सांगट अर दुख</para>
  <para style="r">(<ref loc="MAT 24:3-14">मोत्ती 24:3-14</ref>; <ref loc="LUK 21:7-19">लूका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ज़ांऊं ईशू भबना सम्हनै जैतून धारा त बेठअ द, पतरास, याकब, जोहन्‍ना अर आन्दरू, तिन्‍नैं सोभी ईशू का पुछ़अ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“हाम्हां का खोज़ कि ईंयां गल्‍ला केभै हणीं, ज़ेभै सह बगत एछणअ तेतो कै नछ़ैण हणअ?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“भाल़ै तम्हैं रहै चतैन कि कुंण तम्हां धोखै दी नां पाए।</char> <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" /><char style="wj">कई लोगा एछणअ मेरै नाओंऐं अर तिन्‍नां बोल़णअ इहअ, ‘हाम्हैं आसा परमेशरै छ़ाडै दै मसीहा।’ तिन्‍नां पाणै इहअ करै कई लोग कबाता।</char> <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" /><char style="wj">कि ईंयां गल्‍ला हणीं आसा ज़रूरी, पर तैहा बेला बी निं अंत हणअ।</char><note caller="-" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="JER 6:24">जेर. 6:24</ref></char></note><verse eid="MRK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 13:8" />
    <char style="wj">“किल्हैकि एकी ज़ाती करनअ दुजी ज़ाती संघै जुध अर एकी मुल्खा करनअ दुजै मुल्खा संघै जुध। ज़ैगै-ज़ैगै हणीं ज़ाज़री अर देशै-देशै पल़णै नकाल़। अह हणीं दाह-दुखे शुरूआत ज़ेही कहा सूंणें दाहे शूल़ उझ़िआ।”</char><verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <char style="wj">“पर तम्हैं रहै आपणैं बारै दी चतैन। किल्हैकि लोगा निंणै तम्हैं सभागृहा अर तेथ च़िक्‍कणै तम्हैं सोभी नदरी, मुंह पिछ़ू करनै तम्हैं सैणैं अर राज़ै सेटा बी खल़ै। पर अह हणअ तम्हां का मेरै बारै खोज़णेंओ मोक्‍कअ।</char><verse eid="MRK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 13:10" />
    <char style="wj">“अह आसा ज़रूरी कि पैहलै लोल़ी खुशीओ समाद सोभी ज़ाती सेटा खोज़ी हेरअ।</char> <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" /><char style="wj">ज़ेभै तिंयां तम्हां कैद करे अर पेशी लै खल़ै करे, तेभै निं तम्हैं फिकर करी किई हाम्हां किज़ै बोल़णअ। तैहा घल़ी परमेशर ज़िहअ तम्हां का खोज़े तेभै बोलै तिहअ। किल्हैकि तैहा घल़ी निं बोल़णैं आल़ै तम्हैं हणैं, पर तेभै बोल़णैं आल़ी हणीं पबित्र आत्मां।”</char><verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />
    <char style="wj">“कई भाई-बैहणी पाणै आपणैं भाई-बैहण धोखै करै मारी अर बाब दैणैं शोहरू मारना लै। शोहरू हणैं आपणैं ईजा-बाबे खलाफ खल़ै ताकि लोग तिन्‍नां मारी पाए।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 21:16">लूक. 21:16</ref>; <ref loc="MIC 7:6">मिक. 7:6</ref></char>
    </note> <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><char style="wj">मुंह दी विश्वास करनै पिछ़ू हणैं खास्सै मणछ थारै दुशमण, पर ज़ुंण आपणीं मौत हणैं तैणीं सबर करे तेऊओ हणअ उद्धार।”</char><verse eid="MRK 13:13" /></para>
  <para style="s">सह बगत ज़ेभै खास्सी खरी हणीं</para>
  <para style="r">(<ref loc="MAT 24:15-28">मोत्ती 24:15-28</ref>; <ref loc="LUK 21:20-24">लूका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />
    <char style="wj">“एकी धैल़ै भाल़णीं तम्हां सह बनाश करनै आल़ी छ़ोतली च़ीज़ भबनै खल़ी ज़ेते बारै खास्सी साला पैहलै परमेशरो गूर दानिएल बी बोलअ त। तेतो तिधी हणअ निं राम्बल़ी गल्‍ल आथी। तेभै समझ़ै तम्हैं कि सह बगत गअ एछी।</char> पहल़णैं आल़अ दै ऐहा गल्‍ला लै धैन।</para>
  <para style="p" vid="MRK 13:14">
    <char style="wj">“तेभै ज़ुंण यहूदा मुल्खै होए तिंयां ठुर्है उझै धारा लै।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:27">दान. 9:27</ref>; <ref loc="DAN 12:11">12:11</ref></char>
    </note> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><char style="wj">ज़ुंण तेभै छ़ाप्परै होए, तिंयां निं घअरा भितरा का किछ़ी गल्‍ला निंणे तैणीं उंधै होथी अर नां घअरा भितरा लै डेऊई बगत ज़ांऐं करी।</char><verse eid="MRK 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 13:16" />
    <char style="wj">“ज़ुंण खेचै होए, सह बी निं आपणैं झिकल़ै निंणे तैणीं पिछ़ू हटी।”</char><verse eid="MRK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 13:17" />
    <char style="wj">“तिन्‍नां धैल़ी ज़ुंण सुंदी बेटल़ी अर आपणैं शोहरू लै दुधा पणैंऊंदी होए तैहा लै हणअ ठुहर्नअ बडी आफ़त!</char> <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" /><char style="wj">तम्हैं रहा ऐहा गल्‍ला लै प्राथणां करदै लागी कि ईंयां गल्‍ला निं हिंऊंदे धैल़ै लोल़ी हुई।</char><verse eid="MRK 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 13:19" />
    <char style="wj">“किल्हैकि ईंयां धैल़ै हणैं इहै दुखा सांगटे कि परमेशरे संसार बणाणैं ओर्ही निं आझ़ तैणीं कधि हुऐ अर नां कधि हणैं।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मोत्त. 24:21</ref>
      </char>
    </note><verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />
    <char style="wj">“परमेशरै आसा आपणैं विश्वास करने आल़ेए बारै सोठी करै ईंयां सांगटे धैल़ी घटाऊई दी, नांईं ता संसारै निं कोहै मणछ बच़णअ त।</char><verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />
    <char style="wj">“ज़ै कुंण तिन्‍नां धैल़ी तम्हां लै इहअ बोले, ‘भाल़ा मसीहा आसा इधी, अर मसीहा आसा तिधी,’ तिन्‍नां दी निं विश्वास करी।</char><verse eid="MRK 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 13:22" />
    <char style="wj">“किल्हैकि झ़ुठै मसीहा अर झ़ुठै गूर निखल़णैं अर तिन्‍नां पाणै ज़ादू करी बडै-बडै नछ़ैण अर च़मत्कार रहैऊई कबाता। ज़ै तिन्‍नों बश च़ले, तिन्‍नां पाणै परमेशरे छ़ांटै दै लोग बी कबाता।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:24">मोत्त. 24:24</ref>
      </char>
    </note><verse eid="MRK 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 13:23" />
    <char style="wj">“पर तम्हैं रहै चतैन अर इना गल्‍ला डाहै आद किल्हैकि मंऐं हेरी ईंयां गल्‍ला तम्हां का पैहलै ई खोज़ी।”</char><verse eid="MRK 13:23" /></para>
  <para style="s">मुंह मणछे पूतो फिरी एछणअ</para>
  <para style="r">(<ref loc="MAT 24:29-31">मोत्ती 24:29-31</ref>; <ref loc="LUK 21:25-28">लूका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <char style="wj">“इना दुख-सांगटे धैल़ी बाद हणअ इहअ कि</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:13">प्रका. 6:13</ref>; <ref loc="ISA 34:4">ईशा. 34:4</ref></char>
    </note></para>
  <para style="q" vid="MRK 13:24">
    <char style="wj">सुरज़ फिरनअ न्हैरअ</char></para>
  <para style="q" vid="MRK 13:24">
    <char style="wj">अर ज़ोथ हणीं काल़ी।</char><verse eid="MRK 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="MRK 13:25" />
    <char style="wj">सरगा का अल़णैं तारै धरनीं</char></para>
  <para style="q" vid="MRK 13:25">
    <char style="wj">अर सरगे सारी शगती बी सिक्‍कणी आजू-पिछ़ू।”</char><verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />
    <char style="wj">तेखअ भाल़णअ लोगा हुंह मणछो पूत महान शगती अर प्रतप्पा संघै बादल़ा दी एछदअ।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:26 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 7:13">दान. 7:13</ref>; <ref loc="REV 1:17">प्रका. 1:17</ref></char>
    </note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" /><char style="wj">तैहा बेला छ़ाडणैं मुंह आपणैं स्वर्ग दूत। पृथूई दी हर ज़ैगा का करनै आपणैं छ़ांटै दै लोग कठा।<note caller="+" style="f"><char style="fr" closed="false">13:27 </char><char style="ft" closed="false">बधा. 30:4; मोत्त. 24:31</char></note></char><verse eid="MRK 13:27" /></para>
  <para style="s">फेडूए बूटे कथ्या</para>
  <para style="r">(<ref loc="MAT 24:32-35">मोत्ती 24:32-35</ref>; <ref loc="LUK 21:29-33">लूका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />
    <char style="wj">फेडूए बूटा का शिखल़ा ऐहा गल्‍ला ज़ेभै तेते शाण्हटी नरम फिरा अर ज़ांऊं तेथ प्लीर एछा, तेता करै लागा तम्हां का थोघ कि बसंते ऋत आसा नेल़।</char> <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" /><char style="wj">ठीक इहअ ई ज़ांऊं तम्हां ईंयां गल्‍ला हंदी शुझणीं तम्हैं समझ़ै कि तिंयां धैल़ै आसा नेल़, मतलब सह बगत गअ दुआरे डेहल़ा बागै पुजी।</char><verse eid="MRK 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 13:30" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ेभै तैणीं ईंयां गल्‍ला निभी निं जाए, तेभै तैणीं निं ऐहा पोस्तीए लोग मरनै आथी।</char> <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" /><char style="wj">सरग अर पृथूई टल़णीं पर मंऐं ज़ुंण गल्‍ला बोली ईंयां हणीं सोभ पूरी।”</char><note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ISA 40:8">ईशा. 40:8</ref>; <ref loc="LUK 21:33">लूक. 21:33</ref></char></note><verse eid="MRK 13:31" /></para>
  <para style="s">बिऊंतै रहा</para>
  <para style="r">(<ref loc="MAT 24:36-44">मोत्ती 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <char style="wj">“ऐहा गल्‍लो निं कोही का थोघ आथी कि ईंयां केभै हणीं। नां एतो थोघ स्वर्ग दूता का आथी अर नां पूता का। पर ऐहा गल्‍लो थोघ आसा सिधअ परमेशर बाब का।</char> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" /><char style="wj">भाल़ा, बिऊंतै रहा अर प्राथणां करदै रहा लागी। किल्हैकि तम्हां का निं ऐहा गल्‍लो थोघ आथी कि सह साईत केभै हणीं। </char><verse eid="MRK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 13:34" />
    <char style="wj">“अह आसा तेऊ मणछा ज़ेही गल्‍ल ज़ुंण परदेसा लै डेऊअ, अर आपणअ घअर डाहअ सभाल़ी आपणैं दास का। संघा डाहअ सोभी दासा का तिन्‍नां लै काम सभाल़ी। दुआरे पहरी लै डाहअ इहअ बोली कि बिऊंतअ रहै।</char><verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />
    <char style="wj">“तैही बोला हुंह तम्हां लै बी कि बिऊंतै रहा। किल्हैकि तम्हां का निं इहअ थोघ आथी कि थारअ प्रभू कहा धैल़ी एछणअ। सह उडै एछणअ कि आधी राची। कि सह दोत्ती न्हैर प्रैश्शै एछे कि राच भैई करै एछे।</char><verse eid="MRK 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 13:36" />
    <char style="wj">“इहअ निं हआ कि तम्हैं होए सुत्तै दै अर मालक एछे तैहा ई बेला।</char> <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" /><char style="wj">ज़िहअ हुंह तम्हां लै बोला तिहअ ई बोला हुंह सोभी लै कि बिऊंतै रहा।”</char><verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ईशूए लै छ़ल़</para>
  <para style="r">(<ref loc="MAT 26:1-5">मोत्ती 26:1-5</ref>; <ref loc="LUK 22:1">लूका 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">जोहन्‍ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />दूई धैल़ै बाद थिअ ऊवार्णैओ थैर अर आखरी रोटीओ थैर हणैं आल़अ, अर बडै प्रोहत अर शास्त्री तै ऐहा गल्‍ला लोल़ै लागै दै कि किहअ करै छ़ल़-कपट करी पाणअ त ईशू मारी। <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />पर तिंयां बोला तै इहअ बी कि ऊवार्णे थैरे धैल़ी निं हाम्हां इहअ करनअ, इहअ निं हआ कि लोगा मांझ़ै उपद्रभ होए।<verse eid="MRK 14:2" /></para>
  <para style="s">बेथनी गराऊंऐं ईशूए सीख</para>
  <para style="r">(<ref loc="MAT 26:6-13">मोत्ती 26:6-13</ref>; <ref loc="JHN 12:1-8">जोहन्‍ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />ईशू थिअ बेथनी गराऊंऐं शमौने घअरै ज़ुंण ईशू कोहल़ा का शुचअ किअ त। ज़ांऊं सह रोटी खांदअ बेठअ, तिधी आई एक बेटल़ी। तैहा आणअ संगमरमरे भांडै दी जटामांसीओ किम्मती खुशबूदार तेल अर सह तरैल़अ ईशूए मुंडै।<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />पर कई लागै आपणैं मन्‍नें रोश्शै बोल्दै कि अह एतरअ किम्मती तेल किल्है किअ ऐहा बरैबाद? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />किल्हैकि एऊ खुशबूदार किम्मती तेला सका तै चिई शौआ च़ंदीए सिक्‍कै का बी खास्सी किम्मती बेच़ी गरीबा लै बांडी। तिंयां लागै तेसे बारै इहअ बोल्दै कि ऐहा किअ अह गलत।<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ईशू दैनअ ज़बाब, <char style="wj">“ऐहा छ़ाडा, ऐहा किल्है करा तम्हैं तंग? ऐहा किअ मुल्है भलअ।</char><verse eid="MRK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 14:7" />
    <char style="wj">“गरीब रहणैं कबल्‍लै तम्हां ई संघै तम्हैं ज़ेभै च़ाहे तेभै सका तिन्‍नां लै दैई, पर हुंह निं तम्हां संघै कबल्‍लअ च़ाल्‍लअ रहई।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:7 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 15:11">बधा. 15:11</ref>
      </char>
    </note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" /><char style="wj">ज़ुंण बी अह करी सका ती अर ज़ुंण ऐहा किअ, ऐहा मल़अ मुंह दाबणा लै पैहलै ई मेरी देही लै तेल।</char><verse eid="MRK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 14:9" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि सारै संसारै ज़िधी बी मेरै बारै खुशीओ समाद प्रच़ार होए तिन्‍नां मणछा खोज़णअ एसे बारै बी कि ऐहा मुल्है किज़ै किअ।”</char><verse eid="MRK 14:9" /></para>
  <para style="s">यहूदो छ़ल़-कपट</para>
  <para style="r">(<ref loc="MAT 16:14-16">मोत्ती 16:14-16</ref>; <ref loc="LUK 22:3-6">लूका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />तैबै करेती गराऊंओ यहूदा ज़ुंण तिन्‍नां बारा च़ेल्‍लै मांझ़ै एक त, सह डेऊअ बडै प्रोहता सेटा लै इहअ बोल्दअ कि हुंह करूं थारी ईशू ढाकणा लै मज़त। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />इहअ शूणीं हुऐ तिंयां खास्सै खुश अर तेऊ लै मनै तिन्‍नैं खास्सै ढब्बै दैणैं, सह रहअ तेऊ ढाकणें मोक्‍कै न्हैल़अ लागी।<verse eid="MRK 14:11" /></para>
  <para style="s">च़ेल्‍लै संघै खिरीओ भोज़</para>
  <para style="r">(<ref loc="MAT 26:17-25">मोत्ती 26:17-25</ref>; <ref loc="LUK 22:7-14">लूका 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">जोहन्‍ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />दूई धैल़ै बाद, आखरी रोटीए थैरे पैहली धैल़ी, ज़ेभै तिंयां ऊवार्णैओ मिम्मूं बल़ीदान करा तै, ईशूए च़ेल्‍लै पुछ़अ तेऊ का, “तूह किधी च़ाहा कि हाम्हैं ताल्है ऊवार्णे थैरो भोज़ बणांए?”<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="EXO 12:6">लुआ. 12:6</ref>; <ref loc="EXO 15">15</ref></char></note><verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />तेऊ छ़ाडै आपणैं च़ेल्‍लै मांझ़ै दूई ज़ण्हैं इहअ बोली, <char style="wj">“नगरी लै डेओआ तिधी भेटणअ तम्हां एक मणछ तेऊ हणअ पाणींओ घल़अ च़कअ द, तम्हैं लागै तेऊ पिछ़ू हांढदै।</char><verse eid="MRK 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 14:14" />
    <char style="wj">“तेखअ सह ज़हा घअरा लै डेओए तेऊ घअरे मालका लै बोलै तम्हैं कि गूरू बोला इहअ कि तेरी प्राहुंणें पांड किधी आसा? ज़िधी हुंह आपणैं च़ेल्‍लै संघै ऊवार्णे थैरो भोज़ खाई सकूं।</char> <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" /><char style="wj">तेऊ रहैऊंणीं तम्हां का एक सज़ाऊई दी पांड, तिधी बणाऐं तम्हैं ऊवार्णे थैरो भोज़।”</char><verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />च़ेल्‍लै बी पुजै नगरी अर ज़िहअ ईशू तिन्‍नां का बोलअ त तिन्‍नां भेटअ तिहअ ई अर तिन्‍नैं बणाअं ऊवार्णे थैरो भोज़।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />ज़ांऊं सान्ह पल़ी, ईशू आअ तिधा लै आपणैं बारा च़ेल्‍लै संघै। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ज़ांऊं तिंयां रोटी खांदै बेठै, ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि तम्हां मांझ़ै आसा एक इहअ ज़ुंण मुंह संघा इधी रोटी खांदअ बी आसा बेठअ द, तेऊ बझ़ैल़णअ हुंह ढाकणैं।”<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">भज. 41:9</char></note></char><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />तिंयां हुऐ खास्सै दुखी, अर तिंयां लागै एक-एक करी बारी-बारी तेऊ का पुछ़दै, “हे गूरू सह हुंह किनी आसा?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“सह आसा तम्हां बारा मांझ़ै एक, ज़ुंण मुंह संघै म्हार थाल़ू का डबेऊई करै खाआ।</char><verse eid="MRK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 14:21" />
    <char style="wj">“किल्हैकि हुंह मणछो पूत ता मरनअ तेऊ ई साबै ज़िहअ मेरै बारै पैहलै ई आसा लिखअ द। पर तेऊ मणछा लै आसा घोर आफ़त! ज़हा हुंह ढाकणैं बझ़ैल़णअ। तेऊ लै त भलअ इहअ ई कि तेऊओ ज़ल्म ई नांईं हंदअ।”</char><verse eid="MRK 14:21" /></para>
  <para style="s">प्रभू भोज़</para>
  <para style="r">(<ref loc="MAT 26:26-30">मोत्ती 26:26-30</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 करिन्थी 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ज़ांऊं तिंयां रोटी खांदै बेठै; ईशू परमेशरो शूकर करी रोटी चोल़ी अर तिन्‍नां लै दैई बोलअ, “हुंज़ा, अह आसा मेरी देही।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />तेखअ ईशू दाखे रसा करै भरअ द प्रिहअ हाथै लई करै परमेशरो शूकर किअ अर तिन्‍नां लै दैनअ अर तिन्‍नैं सोभी झुटअ तेता का।<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“अह आसा मेरअ लोहू, ज़ुंण खास्सै लै बहाऊंणअ अह आसा परमेशरे मणछा लै करार।</char><note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">लुआ. 24:8</ref>; <ref loc="ZEC 9:11">जक. 9:11</ref></char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि अह दाखो रस निं मुंह तेभै तैणीं झुटणअ, ज़ेभै तैणीं हुंह परमेशरे राज़ा दी नऊंअ दाखो रस निं झुटूं।”</char><verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />तेखअ डेऊऐ ईशू अर तेऊए च़ेल्‍लै ऊवार्णे थैरे गिहा बोल्दी बागै जैतून धारा लै।<verse eid="MRK 14:26" /></para>
  <para style="s">पतरासे हुधणें बारै गल्‍ला प्रगट करनी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मोत्ती 26:31-35</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>; <ref loc="JHN 13:36-38">जोहन्‍ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />तैबै बोलअ ईशू तिन्‍नां लै, “तम्हैं ठुहर्नै सोभ मुंह छ़ाडी, किल्हैकि शास्त्रा दी आसा मेरै बारै इहअ लिखअ द कि</para>
  <para style="q" vid="MRK 14:27">‘मुंह पाणअ फुआल मारी</para>
  <para style="q" vid="MRK 14:27">अर भेडा छिंघणीं ओरी-पोरी।’<verse eid="MRK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28" />
    <char style="wj">“पर हुंह डेऊणअ ज़िऊंदअ हई तम्हां का आजी गलील मुल्खा लै।”</char><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पतरासै बोलअ ईशू का, “होर लागे ताह छ़ाडी ठुहर्दै पर हुंह निं ताह छ़ाडदअ।” <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />ईशू बोलअ तेऊ लै, <char style="wj">“हुंह खोज़ा ताखा सत्त कि आझ़ ऐहा ई राची मुर्गै दूई बारी बाशणैं का आजी हुधणअ तूह मेरै बारै चिई बारी।”</char><verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />पर पतरासै बोलअ होर बी ज़ोर दैई कि, ज़ै मुंह ताह संघै मरनअ बी लागे, तैबी बी निं हुंह तेरै बारै हुधदअ। इहअ ई बोलअ तिन्‍नैं होरी सोभी ज़ण्हैं।<verse eid="MRK 14:31" /></para>
  <para style="s">गतसमनी नाओंए ज़ैगा ईशूए प्राथणां</para>
  <para style="r">(<ref loc="MAT 26:36-46">मोत्ती 26:36-46</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />तेखअ आऐ तिंयां गतसमनीं नाओंए एकी ज़ैगा लै अर ईशू बोलअ आपणैं च़ेल्‍लै लै, <char style="wj">“इधी रहा बेशी, ज़ेभै तैणीं हुंह प्राथणां करूं।”</char><verse eid="MRK 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33" />ईशू निंयैं पतरास, याकब अर जोहन्‍ना आप्पू संघा अर सह हुअ खास्सअ दुखी अर नर्तान। <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />तेऊ बोलअ इहअ, <char style="wj">“मेरअ ज़िऊ आसा बडअ दुखी इहअ कि मेरै च़ाल्‍लै ज़िहै प्राण निखल़ी, तम्हैं खल़्हिया इधी अर बिहुदै रहा।”</char><note caller="-" style="x"><char style="xo" closed="false">14:34 </char><char style="xt" closed="false"><ref loc="PSA 42:5">भज. 42:5</ref></char></note><verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />तेखअ डेऊअ ईशू धख आजू ज़िहअ। तिधी लागअ सह धरनीं उटअ पल़ी एही प्राथणां करदअ,</para>
  <para style="p" vid="MRK 14:35">
    <char style="wj">“हे परमेशर ज़ै हई सके ता, तै कर मुखा ऐहा घल़ी एऊ दुखा दूर।</char> <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" /><char style="wj">ए मेरै बाबा; ताखा सका सोभै गल्‍ला हई, एऊ दुखे प्रिहअ च़क मुंह सेटा का पोर्ही। पर तैबी बी ज़िहअ हुंह च़ाहा तिहअ निं लोल़ी हुअ। पर ज़िहअ तूह च़ाहा तिहअ लोल़ी हुअ।”</char><verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />तेखअ आअ ईशू तिन्‍नां चिई च़ेल्‍लै सेटा अर तिंयां सुत्तै दै भाल़ी करै, पतरासा लै बोलअ, <char style="wj">“शमौन, तूह सुत्तअ द आसा? तूह एकी घल़ी बी निं बिहुदअ रही सकअ?”</char> <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" /><char style="wj">बिहुदै रहा अर प्राथणां करदै रहा लागी, कि तम्हैं खरी दी पल़ी पाप नां करे, थारअ शाह ता बोला पर देही आसा कमज़ोर।</char><verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />तेखअ डेऊअ सह भिई प्राथणां करदअ तेऊ किई तेही ई प्राथणां ज़ेही तेऊ पैहलै किई ती। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />तेखअ आअ सह भिई आपणैं च़ेल्‍लै सेटा लै अर तेऊ भाल़ै तिंयां घणीं निंजा सुत्तै दै ज़ांऊं तेऊ तिंयां झ़ैऊऐ, तिन्‍नां निं समझ़ पल़ी कि तेऊ लै कै ज़बाब दैणअ।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />तेखअ आअ ईशू चिऊथी बारी प्राथणां करी तिन्‍नां सेटा लै संघा बोलअ, अज़ी बी तम्हैं सुत्तै दै आसा? बतेर्है सुत्तै ऐबै! भाल़ा, सह घल़ी गई एछी, हुंह मणछो पूत लाअ पापी मणछा का बझ़ैल़ी कैद करनै। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />खल़ै उझ़िआ, च़ाल्‍ला, हेरा, ज़ुंणी हुंह ढाकी आसा लाअ द सह गअ एछी।<verse eid="MRK 14:42" /></para>
  <para style="s">ईशू धोखै करै ढाकणअ</para>
  <para style="r">(<ref loc="MAT 26:47-56">मोत्ती 26:47-56</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>; <ref loc="JHN 18:3-12">जोहन्‍ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ईशू त इहअ बोल्दअ ई लागअ द कि यहूदा, ज़ुंण तिन्‍नां बारा मांझ़ै एक त, सह गअ आप्पू संघा बडै प्रोहत, शास्त्री, सैणैं संघै खास्सै मणछ तलबारा अर शोठै पाई तेभी तिधी पुजी।<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />करेती गराऊंओ यहूदा त तिन्‍नां लै इहअ डाहअ द बोली कि ज़हा लै हुंह माख्खी दैंऊं, सह ई आसा ईशू तेऊ करै तम्हैं कैद। <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />सह आअ तेभी अर तेऊ बोलअ ईशू सेटा डेऊई तेऊ लै, “हे गूरू,” संघा दैनअ तेऊ लै माख्खू।<verse eid="MRK 14:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 14:46" />तिन्‍नैं होरी किअ ईशू कैद। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />ईशू नेल़ खल़्हुऐ दै च़ेल्‍लै मांझ़ै काढी एकी आपणीं तलबार अर तेऊ बाही माहा प्रोहते दासा लै, तेऊओ कान शोटअ धरनीं।<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं कै हुंह डाकू समझ़अ कि मुंह ढाकदै आसा तलबारा अर शोठै पाई निखल़ै दै?”</char> <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><char style="wj">हुंह, हर धैल़ै तम्हां संघा भबनै शिक्षा दैआ त, तेभै किल्है निं हुंह तम्हैं ढाकअ? पर अह हुअ तै कि पबित्र शास्त्रा दी लिखी दी गल्‍ला पूरी होए।</char><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />ज़ुंण तिधी ईशू संघै तै तिंयां सोभ च़ेल्‍लै ठुर्है तिधा तेऊ छ़ाडी ओर्ही-पोर्ही। <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />एक ज़ुआन मणछ डेऊअ आपणीं घेरी सिधअ बाछो च़ादरू पल़ेटी तेऊ पिछ़ू-पिछ़ू, अर लोगै ढाकअ सह। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />पर सह छ़ुटअ तिन्‍नां का, संघा ठुर्हअ सह आपणैं च़ादरू तिधी छ़ाडी नांगअ ई।<verse eid="MRK 14:52" /></para>
  <para style="s">माहा सभा दी ईशू</para>
  <para style="r">(<ref loc="MAT 26:57-68">मोत्ती 26:57-68</ref>; <ref loc="LUK 22:54">लूका 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 16:13">जोहन्‍ना 16:13</ref>,<ref loc="JHN 16:14">14</ref>,<ref loc="JHN 16:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />तेखअ निंयं तिन्‍नैं ईशू माहा प्रोहता सेटा लै, अर होर बडै प्रोहत, शास्त्री अर सैणैं बी हुऐ तिधी सोभै ज़ण्हैं कठा। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पतरास डेऊअ तिन्‍नां पिछ़ू-पिछ़ू माहा प्रोहते खोल़ै तैणीं अर लोगा मांझ़ै बेठअ माहा प्रोहते घअरे पहरी संघै आगी नैथदअ।<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />बडै प्रोहत अर सारी यहूदी सभा आल़ै तै पैहलै ई इहै लोगा लोल़ै लागै दै ज़ुंण ईशूए खलाफ झ़ुठी शाजत दैए। ताकि तिंयां तेऊ मारी पाए पर तिंयां निं इहअ करी सकै।<verse eid="MRK 14:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="MRK 14:56" />किल्हैकि कई तै लागै दै तेऊए खलाफ झ़ुठी शाजत दैंदै, पर तिन्‍नें शाजत बी नांईं ती एकी रंगे आथी। <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />तैबै दैनी कई खल़ै उझ़ुई करै एही झ़ुठी शाजत कि <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“हाम्हैं शूणअ अह इहअ बोल्दअ कि मुंह पाणअ अह हाथा करै बणाअं द भबन ढोल़ी अर चिई धैल़ै बाद बणाणअं दुजअ भबन, ज़ुंण हाथा करै नांईं होए बणाअं द।” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />ऐहा गल्‍ला लै बी नांईं ती तिन्‍नें शाजत एकी रंगे ती।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तैबै माहा प्रोहतै मांझ़ै खल़ै हई ईशू का पुछ़अ, “तूह ज़बाब किल्है निं दैंदअ? ईंयां लोग भाल़ तेरै खलाफ किज़ै बोला?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />पर ईशू रहअ च़ुप्पी, अर तेऊ निं किछ़ै ज़बाब दैनअ। माहा प्रोहतै पुछ़अ तेऊ का एकी बारी भिई, “तूह कै परमेशरो पूत मसीहा आसा?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ईशू बोलअ, <char style="wj">“हाँ, हुंह आसा, तम्हां भाल़णअ हुंह मणछो पूत सर्वशक्तिमान परमेशरे दैहणै बेठअ द अर सरगै बादल़ा संघै एछदअ।”<note caller="+" style="f"><char style="fr" closed="false">14:62 </char><char style="ft" closed="false">दान. 7:13; भज. 110:1</char></note></char><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />तैबै माहा प्रोहतै आपणैं च़ोल़अ धैल़ी करै बोलअ, “ऐबै निं हाम्हां कोही शाजते ज़रुरत आथी?<note caller="-" style="x"><char style="xo" closed="false">14:63 </char><char style="xt" closed="false"><ref loc="MAT 26:65">मोत्त. 26:65</ref></char></note> <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />तम्हैं सोभी बी हेरी अह गल्‍ला शूणीं कि अह बोला आप्पू लै परमेशर अर इहअ करै किई एऊ परमेशरे निंदा! तम्हां होरीए कै राऐ आसा?”<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेब. 24:16</ref></char></note></para>
  <para style="p" vid="MRK 14:64">तिन्‍नैं होरी बोलअ, “अह आसा मारनै ई जोगी।”<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />तैबै कई पाअ तेऊए मुंहैं थुक्‍की, संघा लागै कोऐ तेऊए आछी ढोपी करै धमुक्‍कै बाहंदै। तेखअ लागै तेऊ लै इहअ बोल्दै, “ऐबै कर आजू हणैं आल़ी गल्‍ला प्रगट!” ज़ुंण तिधी जोधै मणछ तै, तिन्‍नैं बाही तेऊ लै च़ैंडै।<verse eid="MRK 14:65" /></para>
  <para style="s">पतरासो हुधणअ</para>
  <para style="r">(<ref loc="MAT 26:69-75">मोत्ती 26:69-75</ref>; <ref loc="LUK 22:56-62">लूका 22:56-62</ref>; <ref loc="JHN 18:15-18">जोहन्‍ना 18:15-18</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />पतरास थिअ भबने आजू ताटी बेठअ द, तिधी आई माहा प्रोहते दासी मांझ़े एक बेटल़ी। <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />पतरासा आगी सेटा नैथदअ भाल़ी लागी सह तेऊ कोहरी भाल़ी संघा बोलअ तेऊ लै, “तुबी त तेऊ नासरत गराऊंए ईशू संघै भाल़ी?”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />पतरास हुधूअ संघा लागअ इहअ बोल्दअ, “मुखा निं थोघै अर मुंह निस्सी समझ़ पल़ी कि तूह किज़ै बोला?” तेखअ डेऊअ सह बागै डेहल़ा सेटा अर मुर्गअ बी बाशअ।<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />तेखअ लागी सह दासी तेऊ भाल़ी तिन्‍नां का बोल्दी ज़ुंण तिधी नेल़ तै, “अह आसा तिन्‍नां मांझ़ै कोई एक ज़ण्हअ।” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />पर पतरास हुधूअ भिई।</para>
  <para style="p" vid="MRK 14:70">थोल़ी घल़ी बाद बोलअ तिन्‍नैं बी ज़ुंण तेऊ नेल़ तै खल़्हुऐ दै, “तूह आसा सच्च़ी तिन्‍नां ई मांझ़ै कुंण एक किल्हैकि तेरी गल्‍ला का ज़ाण्हिंआं कि तूह आसा गलील मुल्खा का?”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />पतरास लागअ हुधदअ अर सोह खाई करै बोल्दअ, “तम्हैं ज़हा मणछे गल्‍ला करा, हुंह निं तेऊ बछ़ैणदअ बी आथी।” <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />तेभी बाशअ दुजी बारी मुर्गअ अर</para>
  <para style="p" vid="MRK 14:72">पतरासा फिरी सह गल्‍ल आद ज़ुंण ईशू तेऊ लै बोली ती, <char style="wj">“मुर्गै दुजी बारी बाशणैं का आजी हुधणअ ताह मेरै बारै चिई बारी।”</char> ऐहा गल्‍ला सोठी करै लागअ सह लेरा लांदअ।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">राज़पाल पिलातुसे दरबारै ईशू</para>
  <para style="r">(<ref loc="MAT 27:1">मोत्ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">लूका 23:1-5</ref>; <ref loc="JHN 18:28-38">जोहन्‍ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />दोत्ती-दोत्थी सोभै बडै प्रोहत, सैणैं, अर शास्त्री अर सारी माहा सभा बेठै दै लोगै आप्पू मांझ़ै जोग किअ अर ईशू निंयं बान्हीं करै राज़पाल पिलातुसा सेटा लै।<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />पिलातुसै पुछ़अ ईशू का, “कै तूह यहूदी मणछो राज़अ आसा?”</para>
  <para style="p" vid="MRK 15:2">ईशू बोलअ तेऊ लै, <char style="wj">“तंऐं हेरअ आप्पै बोली।”</char><verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />बडै प्रोहतै लाऐ ईशू लै खास्सै दोश। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातुसै पुछ़अ ईशू का भिई, “तूह ज़बाब किल्है निं दैंदअ, भाल़ ईंयां लोग ताल्है केतरी गल्‍ले दोशा आसा लांदै लागै दै?” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />ईशू निं तिन्‍नां लै किछ़ ज़बाब दैनअ, पिलातुस हुअ बडअ रहैन।<verse eid="MRK 15:5" /></para>
  <para style="s">मौते सज़ा दैणीं</para>
  <para style="r">(<ref loc="MAT 27:15-26">मोत्ती 27:15-26</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">जोहन्‍ना 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />राज़पाल पिलातुसो त इहअ रबाज़ कि सह करा त तेऊ ऊवार्णे थैरे धैल़ी एकी कैदी आज़ाद ज़ुंण कैद खानै होए अर ज़हा लै लोग आज़ाद करने अरज़ करे। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बरोबा नाओं एक मणछ बी थिअ तिन्‍नां धैल़ै कैद। सह थिअ रोमी राज़े द्रोह करनै आल़ै संघै, अर सह थिअ राज़ द्रोह अर हत्या करनै पिछ़ू कैद किअ द। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />खास्सै मणछ डेऊऐ राज़पाला का अरज़ करदै कि ज़िहअ तूह हाम्हां लै आझ़ तैणीं करदअ आसा आअ द तिहअ ई कर।<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />राज़पाल पिलातुसै बोलअ तिन्‍नां लै, “तम्हैं कै इहअ च़ाहा कि तम्हां लै ‘यहूदी मणछे राज़ै’ करूं आज़ाद?”<verse eid="MRK 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 15:10" />पिलातुसा का थिअ थोघ कि बडै प्रोहत करा ईशू लै ज़ीद अर तै आसा अह इनै ढाकअ द। <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />पर बडै प्रोहतै तै तिंयां लोग शकाऊई डाहै दै। लोगै बोलअ ईशूए बदल़ै तेऊ बरोबा आज़ाद करना लै। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />ज़ांऊं पिलातुसै इहअ शूणअ, तेऊ पुछ़अ तिन्‍नां का एकी बारी भिई, “ज़ै हुंह एऊ बरोबा आज़ाद करूं, तै हुंह एऊ लै किज़ै करूं ज़हा लै तम्हैं यहूदी मणछो राज़अ बोला?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />तिन्‍नैं लोगै बोलअ भिई ज़ोरै-ज़ोरै, “एऊ छ़ड़ाऊआ क्रूसा दी।”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलातुसै बोलअ तिन्‍नां लै, “किल्है, एऊ किज़ै ज़ुल्म किअ?”</para>
  <para style="p" vid="MRK 15:14">पर तिन्‍नैं लाई होर भिई ज़ोरै-ज़ोरै लैल़ा, “एऊ छ़ड़ाऊआ क्रूसा दी।”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />तेखअ किअ पिलातुसै लोगा खुश करनै तैणीं बरोबा आज़ाद, अर ईशू दैनअ कोल़ै करै च़िक्‍की रोमी सपाही का क्रूसा दी छ़ड़ाऊंणा लै।<verse eid="MRK 15:15" /></para>
  <para style="s">सपाहीओ ईशू संघै बूरअ बर्ताअ</para>
  <para style="r">(<ref loc="MAT 27:27-31">मोत्ती 27:27-31</ref>; <ref loc="JHN 19:2">जोहन्‍ना 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सपाही निंयं ईशू गहल़ा भितरी राज़ भबनै अर सपाहीए पल़टण शादी तिधा लै। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />तेखअ बन्हैऊंअ तिन्‍नैं ईशू लै बैंज़णीं रंगो च़ोल़अ अर तेऊए मुंडै लाअ झ़रीलै कांडैओ मुगट।<verse eid="MRK 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 15:18" />तेखअ लागै इहअ बोली सुहांगा करदै, “हे यहूदीए राज़ैआ नमस्ते।” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />तिन्‍नैं पाअ तेऊए मुंहां लै थुक्‍की, शोठै करै बाही तेऊए मुंडै अर तेऊ सम्हनै ज़ान्हूंए बलै बेशी लागै तिंयां तेऊए सुहांगा करदै। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />तेखअ खोल्हअ तिन्‍नैं तेऊ का बैंज़णीं रंगो च़ोल़अ पोर्ही अर तेऊ का बन्हैऊंऐं तेऊए ई झिकल़ै, तेखअ निंयं क्रूसा दी मारना लै एरुशलेम नगरी बागै।<verse eid="MRK 15:20" /></para>
  <para style="s">ईशू क्रूसा दी छ़ड़ाऊंणअ</para>
  <para style="r">(<ref loc="MAT 27:32-44">मोत्ती 27:32-44</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>; <ref loc="JHN 19:28-30">जोहन्‍ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />सकंदर अर रुपसो बाब शमौन नाओं मणछ अर एक कुरेन नगरी का आअ द मणछ त लागअ द गराऊंआं का तेस्सी बाती एछदअ, तिन्‍नैं ढाकअ सह ज़ोरा-ज़ोरी कि सह क्रूसा बगारू च़ाले। ज़ांऊं सपाही ईशू नगरी का बागै तै निंदै लागै दै, तिन्‍नां का शुझुअ एक मणछ किधी गराऊंआं, तेऊ नाअं त शमौन, सह आसा त कुरेन नगरी का सकंदर अर रुपसो बाब। सपाही निंयं सह ज़ोरा-ज़ोरी ईशूए क्रूसा बगारू।<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />तिन्‍नैं निंयं ईशू गुलगुता नाओंए ज़ैगा लै ज़ेता लै “खोपल़ीए ज़ैगा हआ।” <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />तिधी लागै तिंयां तेऊ लै मुर्र नाओंए दुआई राल़अ द दाखे मिल्‍लै रसा दैंदै ज़ेता करै दाह का राम हआ पर ईशू निं सह झ़ुठअ।<verse eid="MRK 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 15:24" />तेखअ छ़ड़ाऊअ तिन्‍नैं सपाही ईशू क्रूसा दी अर तेऊए झिकल़ै बांडणां लै पाई आप्पू मांझ़ै परच़ी कि कहा लै कै लोल़ी भेटअ अर तिंयां बांडै।<note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भज. 22:18</ref></char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />दोत्ती पैहलै पहरै छ़ड़ाऊअ तिन्‍नैं सह क्रूसा दी। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />क्रूसे च़ुंडी टोक्‍की तिन्‍नैं एक तगती, अर तेथ त तेऊओ दोश लिखअ द, “यहूदी मणछो राज़अ।”<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />तिन्‍नैं छ़ड़ाऊऐ क्रूसा दी दूई डाकू बी एक ईशूए दैहणीं बाखा अर एक बाऊंईं बाखा। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />इहअ करै हुअ पबित्र शास्त्रा दी लिखअ द बैण बी पूरअ, “सह गणअ ज़ुल्म करनै आल़ै संघै।”<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ईशा. 53:12</ref></char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />तेस्सी बाती एछदै-डेऊंदै करा तै आपणैं मूंड झ़ल़ाऊई करै तेऊए इहअ बोली निंदा, “शाबाश! भबना ढोल़णैं आल़ैआ अर चिई धैल़ी भितरी बणाणैं आल़ैआ, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />एऊ क्रूसा का होथ धरनीं अर आप्पू ता बच़ हेरुं!”<note caller="-" style="x"><char style="xo" closed="false">15:30 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भज. 22:7</ref>; <ref loc="PSA 109:25">109:25</ref></char></note><verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />बडै प्रोहत अर शास्त्री सैणैं बी लागै सोभ सुहांग करी इहअ बोल्दै, “होर ता बच़ाऊऐ एऊ पर आप्पू निं बच़ी सकअ। <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ज़ै तूह मसीहा अर इज़राईली मणछो राज़अ थिऐ होथ एऊ क्रूसा का धरनीं, तै करनअ हाम्हां बी तेरअ विश्वास।”</para>
  <para style="p" vid="MRK 15:32">इहअ ई ज़ुंण तिंयां ईशू संघै डाकू बी तै क्रूसा दी छ़ड़ाऊऐ दै, तिंयां बी लागै ईशूए निंदा करदै।<verse eid="MRK 15:32" /></para>
  <para style="s">ईशूए प्राण शोटणै</para>
  <para style="r">(<ref loc="MAT 27:45-56">मोत्ती 27:45-56</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>; <ref loc="JHN 19:28-30">जोहन्‍ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />दपहरा पोर्ही चिऊथै पहरै तैणीं रहअ तेऊ देशै घोर न्हैरअ हई अर उडै तैणीं रही ज़ेही राच पल़ी। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />चिऊथै पहरै बोलअ ईशू बडै ज़ोरै एक बोल, <char style="wj">“इलोई, इलोई, लम्मा शबक्तनी?”</char> मतलब, <char style="wj">“हे मेरै परमेशर, हे मेरै परमेशर, तंऐं किल्है छ़ाडअ हुंह?”</char><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />ज़ुंण तिधी नेल़ तै खल़्हुऐ दै तिन्‍नां मांझ़ै बोलअ कई लोगै इहअ, “भाल़ा, अह आसा एलियाह गूरा लै हाक्‍का लांदअ लागअ द।”<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />एक आअ ठुर्ही, अर मिल्‍लै दाखे रसा दी डबेऊअ शाट्टअ अर नगाल़ीए च़ुंडी दी चैल़ी करै दैनअ तेऊ का च़ाखणा लै, होरी बोलअ इहअ बी कि खल़्हिया, “भाल़ा हेरुं, एलियाह गूर एऊ बच़ाऊंदअ एछणअ कि नांईं।”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />तेखअ शोटै ईशू ज़ोरै लैल़ पाई आपणैं प्राण। <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />परमेशरे भबनै लाअ द पल्दअ धेल़्हुअ प्रैंदा का थाल्‍लै तैणीं दूई बाखा लै।<verse eid="MRK 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 15:39" />तेखअ ज़ुंण सुबैदारै तिधी ईशू नेल़ पहरी थिअ, ज़ांऊं तेऊ सह ज़ोरै लैल़ पाई प्राण शोटदअ भाल़अ, तेऊ बोलअ, “अह मणछ आसा असली दी सच्च़ी परमेशरो पूत थिअ।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />कई बेटल़ी बी थिई दूर खल़्हुई करै भाल़ी लागी दी, तिन्‍नां मांझ़ै तै मगदल़ गराऊंए मरिअम, दुजी मरिअम ज़ुआन याकब अर जोसेसे ईज अर सलोमी थिऐ तिधी।<verse eid="MRK 15:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 15:41" />ज़धू ईशू गलील मुल्खै हआ त, ईंयां बी हआ ती ईशू संघै, अर तिंयां बी करा तै तेऊए च़ाकर, होर बी थिई ईशू संघै एरुशलेम नगरी लै खास्सी बेटल़ी आई दी।<verse eid="MRK 15:41" /></para>
  <para style="s">ईशू दाबी डाहणअ</para>
  <para style="r">(<ref loc="MAT 27:57-61">मोत्ती 27:57-61</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>; <ref loc="JHN 19:38-42">जोहन्‍ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />तेतरी च़ाल्‍ली ती सान्ह पल़ी अर बशैघो धैल़अ थिअ शुरू हणैं आल़अ।<verse eid="MRK 15:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 15:43" />अरमतियाह गराऊंओ रहणैं आल़अ युसुफ आअ अर सह थिअ यहूदी माहा सभा दी साझ़ू, अर सह थिअ आप्पू बी परमेशरे राज़ एछणैं न्हैल़अ लागअ द। सह डेऊअ हिम्मत करी राज़पाल पिलातुसा सेटा लै संघा मांगी तेऊ ईशूए ल्हास।<verse eid="MRK 15:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 15:44" />पिलातुस हुअ रहैन कि सह एतरअ छ़ेक्‍कै गअ मरी! पिलातुसै शादअ सुबैदार संघा पुछ़अ तेऊ का, “तेऊ मरी कै खास्सअ बगत गअ हई?”<verse eid="MRK 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 15:45" />ज़ांऊं पिलातुसा का इहअ थोघ लागअ कि ईशू हेरै प्राण शोटी, तेखअ दैनी तेऊ युसुफा लै तिधा का ल्हासा निंणे ज़ाज़त।<verse eid="MRK 15:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 15:46" />तेखअ पल़ेटी युसुफै ल्हास एकी बाछे च़ादरा दी संघा डाही सह तैहा घोरी दी ज़ुंण शाफल़ा दी थिई कोती दी। घोरीए मोहरै डाही एक बडी टोल्ह बदल़ी। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मगदल़ गराऊंए मरिअम अर जोसेसे ईज मरिअम ती लागी दी भाल़ी कि ईशू किधी आसा डाहअ द।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ईशूओ मरी करै ज़िऊंदै हणअ</para>
  <para style="r">(<ref loc="MAT 28:1-8">मोत्ती 28:1-8</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>; <ref loc="JHN 20:1-10">जोहन्‍ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />ज़ांऊं बशैघे धैल़ी-बिति, मगदल़ गराऊंए मरिअम अर याकबे ईज मरिअम अर सलोमी आणी बडी खुशबूदार च़िज़ा ताकि ईशूए ल्हासा दी मल़ी सके।<verse eid="MRK 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 16:2" />हबते पैहली धैल़ी दोत्ती-दोत्थी धुप्पै लागदी पुजी तिंयां तैहा घोरी सेटा ज़िधी ईशू त डाहअ द। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />तिंयां ती लागी दी आप्पू मांझ़ै गल्‍ला करदी, “हाम्हां लै घोरीए मोहरै लाई दी बडी टोल्ह कहा दैणीं बदल़ी?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ज़ांऊं तिन्‍नैं भाल़अ कि घोरी का आसा टोल्ह पोर्ही बदल़ी दी, अर सह थिई खास्सी बडी टोल्ह।<verse eid="MRK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 16:5" />ज़ांऊं तिंयां घोरी भितरी डेऊई, तिन्‍नां का शुझुअ एक शेतै झिकल़ै आल़अ ज़ुआन मणछ दैहणीं बाखा बेठअ द अर तिंयां हुई बडी रहैन।<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />तेऊ ज़ुआन मणछै बोलअ तिन्‍नां लै, “तम्हैं किल्है हुई रहैन! तम्हैं ईशू नासरी लोल़ी आसा लागी दी ज़ुंण क्रूसा दी छ़ड़ाऊअ त? तै शूणां, सह हुअ ज़िऊंदअ अर सह निं इधी आथी। भाल़ा, अह आसा सह ई ज़ैगा, ज़िधी तेऊए ल्हास ती डाही दी।<verse eid="MRK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 16:7" />“पर तम्हैं डेओआ पतरासा सेटा लै तेऊ का खोज़ै अर होरी च़ेल्‍लै का बी खोज़ै इहअ कि सह डेऊणअ तम्हां का आजी गलील मुल्खा लै। ज़िहअ तेऊ तम्हां लै बोलअ त तम्हां भेटणअ सह तिधी।”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />तिंयां बेटल़ी लागी डरै काम्बदी अर तिंयां ठुर्ही घोरी सेटा का अर तिन्‍नैं निं डरै कोही का खोज़अ।<verse eid="MRK 16:8" /></para>
  <para style="s">मगदल़ गराऊंए मरिअमा का ईशू शुझणअ</para>
  <para style="r">(<ref loc="MAT 28:9-10">मोत्ती 28:9-10</ref>; <ref loc="JHN 20:11-18">जोहन्‍ना 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />हबते पैहलै धैल़ै दोत्ती-दोत्थी शुझुअ ईशू ज़िऊंदै हणैं का बाद सोभी का आजी मगदल़ गराऊंए मरिअमा का, ज़हा का ईशू सात भूत काढै तै।<verse eid="MRK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 16:10" />सह डेऊई ईशूए च़ेल्‍लै सेटा लै, तिंयां थिऐ खास्सै दुखी लेरदै-पकारदै लागै दै। तैहा खोज़ी तिन्‍नां का सारी गल्‍ला। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ज़ांऊं तैहा तिन्‍नां का खोज़अ, “ईशू हुअ ज़िऊंदअ अर मंऐं भाल़अ सह आपणीं आछी।” पर तिन्‍नैं निं तेसे गल्‍लो विश्वास किअ।<verse eid="MRK 16:11" /></para>
  <para style="s">ईशू शुझुअ दूई च़ेल्‍लै का</para>
  <para style="r">(<ref loc="LUK 24:13-35">लूका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />इना एही गल्‍ला हणैं बाद शुझुअ ईशू दूई होरी च़ेल्‍लै का। तिंयां च़ेल्‍लै तै एरुशलेम नगरी का तिन्‍नें गराऊंआं लै डेऊंदै लागै दै, तिन्‍नैं निं ईशू बछ़ैणअ किल्हैकि तिन्‍नां का ज़ाण्हुंई ईशूए नर्हांग होरी रंगे। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />तिन्‍नैं बी खोज़अ होरी सोभी का ऐहा गल्‍लो समाद पर तिन्‍नैं होरी च़ेल्‍लै निं तिन्‍नें गल्‍ला दी बी विश्वास किअ।<verse eid="MRK 16:13" /></para>
  <para style="s">सोभी गैरा च़ेल्‍लै का ईशू शुझणअ</para>
  <para style="r">(<ref loc="MAT 28:16-20">मोत्ती 28:16-20</ref>; <ref loc="LUK 24:36-39">लूका 24:36-39</ref>; <ref loc="JHN 20:19-23">जोहन्‍ना 20:19-23</ref>; <ref loc="ACT 1:6-8">शधाणूं 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />तेखअ शुझुअ सह तिन्‍नां गैरा च़ेल्‍लै का बी, ज़ांऊं तिंयां रोटी खांदै तै बेठै दै। ईशू नैरै तिंयां किल्हैकि तिन्‍नैं मन्‍न तै एतरै काठै हुऐ दै कि ज़ुंणी ज़िऊंदअ हई ईशू भाल़अ त तिन्‍नैं निं तिन्‍नें गल्‍ला दी विश्वास किअ।<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं डेओआ सारै संसारै, अर सारै संसारे सोभी ज़ातीए लोगा का खोज़ा खुशीओ समाद।</char> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" /><char style="wj">ज़ुंण विश्वास करे अर पापो प्राश्त करने डुबकी लए, उद्धार भेटणअ तेऊ ई अर ज़ुंण विश्वास निं करे सह हणअ दोशी।</char><verse eid="MRK 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 16:17" />
    <char style="wj">“विश्वासा करनै आल़ेए हणैं ईंयां नछ़ैण, कि तिन्‍नां काढणैं मेरै नाओंआं करै मणछा का भूत पोर्ही अर तिन्‍नां बोल़णीं नऊंईं-नऊंईं भाषा।</char> <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" /><char style="wj">तिन्‍नां च़कणी दानुईं बी हाथै अर नज़ाणै दी तिंयां ज़ैहर बी झुटे ता, तैबी निं तिन्‍नां किछ़ हणअ, अर रोगी मणछा लै बी ज़ै तिंयां आपणैं हाथा करै छुंए तिंयां हणैं नरोगै।”</char><verse eid="MRK 16:18" /></para>
  <para style="s">ईशूओ स्वर्गा लै डेऊणअ</para>
  <para style="r">(<ref loc="LUK 24:50-53">लूका 24:50-53</ref>; <ref loc="ACT 1:9-11">शधाणूं 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />तिन्‍नां च़ेल्‍लै संघै गल्‍ला करनै का बाद च़कअ परमेशरै ईशू तिन्‍नें आछी सम्हनै उझै स्वर्गा लै। संघा बशैल़अ सह आपणीं दैहणीं बाखा सोभी का बडी पदबी दी।<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="1PE 3:22">1 पत. 3:22</ref></char></note><verse eid="MRK 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 16:20" />एता बाद लागै तिंयां एरुशलेम नगरी का हांढदै अर तिन्‍नैं खोज़ी ईंयां गल्‍ला सारै दी अर ज़िधी बी तिंयां डेऊऐ, ईशू रहअ तिन्‍नां करै नछ़ैण अर च़मत्कार करदअ लागी। एता करै रहैऊअ ईशू लोगा का कि परमेशरो खुशीओ समाद आसा शुचअ। एवमस्तू।<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>