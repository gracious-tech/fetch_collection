  <para style="h">1 शमूएल</para>
  <para style="toc1">इज़राईला दी राज़ैओ राज़</para>
  <para style="toc2">1 शमूएल</para>
  <para style="toc3">1 शमू.</para>
  <para style="mt1">1 शमूएल</para>
  <para style="mt2">इज़राईला दी राज़ैओ राज़</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: शमूएल, पर पाक्‍कअ थोघ निं आथी।</para>
  <para style="ili">सन: 1050 का 722 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">सोभी का आजी थिई 1 शमूएल अर 2 शमूएले कताबा दुहै ज़ोल़ी करै एक ई कताब। इना दुही कताबा दी आसा इज़राईला दी 1080 पिछ़ू 970 ईसा आजी इतिहासे बारै शमूएल गूरे ज़ल्म हणैं ओर्ही राज़ै दाबेदा मरनै तैणीं। अह कताब निं पठी शमूएलै आथी लिखी दी किल्हैकि ऐहा कताबा पूरी हणैं का आजी गअ त शमूएल मरी।</para>
  <para style="ip">अह कताब खोज़ा खासकर इज़राईल देशे शुरूआती चिई मशूर मणछ शमूएल, राज़अ शाऊल अर राज़ै दाबेदे ज़िन्दगीए बारै। एथ हाम्हां का इहअ थोघ बी लागा कि इज़राईली पांच़े ढिलै राज़ा का किहअ करै बणअ इज़राईल राज़े राज़ा दी बलबान देश।</para>
  <para style="ip">2 शमूएले कताब हआ शमूएल गूरे ज़ल्मां ओर्ही शुरू, तेखअ शादा तेऊ बिधाता आपणअ गूर हणां लै, बादा का बणा सह इज़राईलो प्रधान पांच़।</para>
  <para style="ip">बादा का करा लोग शमूएला का एही अरज़ कि सह छ़ांटे एक इहअ मणछ ज़ुंण इज़राईली प्रैंदै राज़अ होए। बिधाता बोलअ शमूएला लै कि बिन्यामीन गोत्रा का छ़ांट शाऊला इज़राईलै पैहलअ राज़अ। शाऊल राज़ै निं तिहअ किअ ज़िहअ बिधाता च़ाहा त। तेखअ बोलअ बिधाता शमूएल गूरा लै इहअ कि ईशैई कान्हीं-कान्हैं शोहरू छ़ांट इज़राईली लै राज़अ ज़ुंण फुआल आसा। एता पिछ़ू हुअ राज़अ शाऊल दाबेदो दुशमण। शमूएल रहअ राज़ै शाऊला का दाबेदा बच़ाऊंदअ लागी अर पलिश्ती संघै जुधा दी शाऊल अर तेऊए शोहरूए मौत हणें गल्‍ला संघै हआ 1 शमूएले कताब खतम।</para>
  <para style="ib" />
  <para style="imq">“ताह कधू तैणीं रहणअ शाऊले तैणीं हिक्‍का पटाक्‍कदै लागी? हुंह निं च़ाहंदअ कि शाऊल आजू इज़राईलीओ राज़अ रहे! शींगा दी निंऊं जैतूनो तेल भरी संघा डेऊ बेतलेम नगरी ईशैई नाओंए मणछा सेटा, किल्हैकि तेऊए शोहरू मांझ़ै आसा मंऐं एक ज़ण्हअ इज़राईलीओ राज़अ लाअ द बणाईं।”</para>
  <para style="ipr">(16:1)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">शमूएलो ज़ल्म अर च़ाकरी 1:1—8:22</para>
  <para style="io1">इज़राईलीओ पैहलअ राज़अ 9:1—12:25</para>
  <para style="io1">शाऊल हुअ बेघै निक्‍कअ राज़अ 13:1—15:35</para>
  <para style="io1">दाबेदे ज़िन्दगी 16:1—20:42</para>
  <para style="io1">इज़राईलीए राज़े रुपै दाबेद 21:1—31:13</para>
  <chapter number="1" style="c" sid="1SA 1" />
  <para style="s">हन्‍ना मांगी बिधाता का लुआद</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 1:1" />एप्रैम गोत्रे धारा बाखे मुल्खै त रामतैम-सोपीम<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">रामतैम-सोपीम </char><char style="ft" closed="false">रामाह नगरी </char></note> नगरी एलकाना नाओं एक मणछ। एलकाना त एप्रैम गोत्रा दी सूप खिंबा का जेरोहामो शोहरू, अर एलीहूओ पोचअ अर तोहू थिअ तेऊओ पल़दादू।<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1CH 6:34">1 इति. 6:34</ref>,<ref loc="1CH 6:35">35</ref>; <ref loc="1SA 1:19">1 शमू. 1:19</ref>; <ref loc="1SA 2:11">2:11</ref>; <ref loc="1SA 7:17">7:17</ref>; <ref loc="1SA 15:34">15:34</ref>; <ref loc="1SA 19:18">19:18</ref></char></note> <verse eid="1SA 1:1" /><verse number="2" style="v" sid="1SA 1:2" />एलकाने ती दूई बेटल़ी<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">दूई बेटल़ी </char><char style="ft" closed="false">तिन्‍नें ती दूई लाल़ी डाहणें ज़ाज़त </char></note> हन्‍ना<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">हन्‍ना </char><char style="ft" closed="false">बित्ती</char></note> अर पनिन्‍ना<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">पनिन्‍ना </char><char style="ft" closed="false">मोत्ती</char></note>। पनिन्‍ने हुई आजू लुआद पर हन्‍ने निं लुआद हुई।<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JDG 21:15">पांच़ 21:15</ref></char></note><verse eid="1SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 1:3" />एलकाना डेओआ त हर साल शिलोह<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">शिलोह </char><char style="ft" closed="false">रामतैम पुर्बा बाखा एप्रैम धारा बाखलै मुल्खै</char></note> नगरी लै कि सह स्वर्गे सारी सैने मालक बिधाता सेटा माथै टेक्‍कदअ अर मेल़-ज़ोल़ो बल़ीदान करदअ। शिलोह तै हुपनी अर पिनहास एलीए दूई शोहरू, तिंयां थिऐ तिधी बिधाते प्रोहत।<verse eid="1SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 1:4" />ज़ेभै बी एलकाना मेल़-ज़ोल़ो बल़ीदान करा त, सह दैआ तेभै-तेभै तेते शिखा आपणीं लाल़ी पनिन्‍ना अर तैहा का हुऐ दै आपणैं शोहरू-शोहरी लै बांडी। <verse eid="1SA 1:4" /><verse number="5" style="v" sid="1SA 1:5" />बिधाता निं अज़ी हन्‍नो ओदर खोल्हअ आथी त। तज़ी बी दैआ त एलकाना हन्‍ना लै बी दोगी किल्हैकि सह झ़ूरा त तैहा लै खास्सअ।<verse eid="1SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 1:6" />पर हन्‍ने दैणी पनिन्‍ना लागा ती तैहा लै टाभा बाहंदी कि तेसे निं किछ़ै हुअ-ज़ाअ आथी। <verse eid="1SA 1:6" /><verse number="7" style="v" sid="1SA 1:7" />इहअ हआ त हर साल, ज़ेभै बी तिंयां बिधाते पबित्र ज़ैगा डेओआ तै, पनिन्‍ना करा ती तैहा लै टाभ बाही अर हन्‍ना रहा ती फलिल्ही हई लेरा लांदी लागी अर तेखअ निं सह रोटी बी खांदी ती। <verse eid="1SA 1:7" /><verse number="8" style="v" sid="1SA 1:8" />तेसो लाल़अ एलकाना बोला त तैहा लै इहअ बी, “हन्‍ना, तूह किल्है हआ लेरदी लागी दी? तूह रोटी किल्है निं खांदी? तंऐं हआ धैल़ मुंह शेऊई डाहअ द! तेरै दस शोहरू हणैं का बी खास्सी बडी गल्‍ल आसा अह कि ताखा आसा हुंह भाल़ ज़ुंण ताल्है झ़ूरा।”<verse eid="1SA 1:8" /></para>
  <para style="s">हन्‍ना डाही बिधाता लै मानत</para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 1:9" />एकी बारी ज़ांऊं तिंयां शिलोह बिधाते पबित्र ज़ैगा भोज़ खाई-झुटी मुक्‍कै, हन्‍ना उझ़ुई तिधा का खल़ी संघा डेऊई बिधाता सेटा अरज़ करदी। खिम्भे दुआरा सेटा थिअ एली प्रोहत आपणीं गाद्दी दी बेठअ द। <verse eid="1SA 1:9" /><verse number="10" style="v" sid="1SA 1:10" />हन्‍ना ती भितरा का खास्सी दुखी अर हिक्‍की-सल़िक्‍की लेरा लाई बिधाता का एही अरज़ करदी लागी दी, <verse eid="1SA 1:10" /><verse number="11" style="v" sid="1SA 1:11" />“स्वर्गे सारी सैने मालक बिधाता, मुंह तेरी दासी बाखा भाल़! तूह भाल़ मेरी खरी, मुंह निं बिस्सरै आथी, ज़ै मेरै शोहरू होए, तै आसा मेरी तेता लै एही मानत कि सह शोहरू हणअ सारी ज़िन्दगी ताह बिधाता लै<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xq" closed="false">बिधाता लै </char><char style="xt" closed="false"><ref loc="NUM 6:1-21">गण. 6:1-21</ref></char></note> बांधअ<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">बांधअ </char><char style="ft" closed="false">ज़हा बिधाता लै अर्पण करा तै, तेऊए ज़ल़ू निं काटदै तै</char></note> अर मुंह निं तेऊए ज़ल़ू कधि काटणै।”<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="NUM 6:5">गण. 6:5</ref>; <ref loc="LUK 1:48">लूक. 1:48</ref></char></note><verse eid="1SA 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 1:12" />हन्‍ना ती बिधाता सेटा खास्सी घल़ी एही अरज़ करदी लागी दी, अर एली प्रोहत त तैहा बाखा भाल़अ लागअ द। <verse eid="1SA 1:12" /><verse number="13" style="v" sid="1SA 1:13" />हन्‍ना ती मन्‍नैं अरज़ करदी लागी दी, तेसे होठ ता शुझिआ तै च़ुक्‍कदै पर इहअ निं शुण्हदअ आथी त कि सह किज़ै बोला। एली ज़ाणअ इहअ कि ऐहा आसा नशअ झुटअ द! <verse eid="1SA 1:13" /><verse number="14" style="v" sid="1SA 1:14" />तैही बोलअ एली हन्‍ना लै, “ताह केभै तैणीं रहणअ इहै नशै दी? पोर्ही छ़ाड एता!”<verse eid="1SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 1:15" />हन्‍ना दैनअ एली प्रोहता लै ज़बाब, “मेरै मालक, हुंह निं शूर-शराब झुटदी! नां मंऐं कधू नशअ किअ आथी, मुंह आसा भितरी खास्सअ दुख, हुंह आसा तैहा खरी बिधाता सेटा दिल खोल्ही खोज़दी लागी दी। <verse eid="1SA 1:15" /><verse number="16" style="v" sid="1SA 1:16" />तूह निं मुल्है इहअ ज़ाणीं कि हुंह आसा बूरी बेटल़ी। मुंह त भितरी खास्सअ कोप फिरअ द, अर तैही ती हुंह एही अरज़ करदी लागी दी।”<verse eid="1SA 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 1:17" />एली प्रोहतै बोलअ इहअ, “राज्ज़ी-खुशी डेऊ घअरा लै, ज़िहअ तंऐं मांगअ इज़राईले परमेशर बिधाता लोल़ी ताल्है तिहअ ई दैनअ।”<verse eid="1SA 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 1:18" />हन्‍ना बोलअ इहअ, “मेरै मालक, थारी मुल्है ऐहा झींण करना लै करा हुंह थारअ शूकर।” तेखअ डेऊई सह तिधा का संघा खाई आपणैं रोटी। तधा पोर्ही रही हन्‍ना खुश।<verse eid="1SA 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 1:19" />दुजै धैल़ै दोत्ती-दोत्थी उझ़ुअ एलकाना तेऊए टबर, संघा डेऊऐ बिधाता सेटा माथअ टेक्‍की रामाह नगरी आपणैं घअरा लै फिरी। घअरै डेऊई डेऊअ एलकाना आपणीं लाल़ी हन्‍ना सेटा, अर बिधाता दैनअ तेतो ज़बाब ज़ुंण तैहा अरज़ किई ती, <verse eid="1SA 1:19" /><verse number="20" style="v" sid="1SA 1:20" />इहअ करै हुई हन्‍ना सुंदी अर तेसो हुअ एक शोहरू। तैहा डाहअ तेऊ शोहरू नाअं शमूएल, किल्हैकि सह रहा ती इहअ बोल्दी लागी, “अह आसा मेरै बिधाता का मांगी करै हुअ द।”<verse eid="1SA 1:20" /></para>
  <para style="s">शमूएलो ज़ल्मां ओर्ही बिधाता लै बांधअ</para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 1:21" />तेखअ गअ भिई साला बाद सह बगत एछी अर एलकाना डेऊअ आपणैं सोभी टबरा संघा निंईं बिधाते पबित्र ज़ैगा शिलोह। तिधी किअ तेऊ हर साल हणैं आल़अ मेल़-ज़ोल़ो बल़ीदान अर आपणीं मानत पूरी। <verse eid="1SA 1:21" /><verse number="22" style="v" sid="1SA 1:22" />पर ऐहा बारी निं हन्‍ना तिन्‍नां संघै शिलोह डेऊई, तैहा बोलअ आपणैं लाल़ै लै, “ज़ांऊं हुंह शोहरू का च़ूई चल़ाऊई मुक्‍के, तेभै निंणअ मुंह अह शिलोह बिधाता सेटा, अर तेभा पोर्ही रहणअ अह आपणीं सारी ज़िन्दगी तिधी।”<verse eid="1SA 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 1:23" />एलकाना बोलअ तैहा लै, “ज़िहअ तूह ठीक समझ़ा, तूह कर तिहअ, तै रह तूह एऊए च़ूई चल़ाऊंणैं तैणीं घअरै। पर बिधाता लै ज़ेऊ बांधै दैणें मानत तंऐं मनी दी आसा, सह गल्‍ल लोल़ी बिधाता पूरी किई।”</para>
  <para style="p" vid="1SA 1:23">ज़ांऊं तैणीं हन्‍ना तेऊ शोहरू का च़ूई निं चल़ाऊई, तेभै तैणीं निं सह शिलोह बिधाता सेटा डेऊई आथी सह रही तेऊ शोहरू धाचदी लागी। <verse eid="1SA 1:23" /><verse number="24" style="v" sid="1SA 1:24" />बादा का ज़ांऊं तेऊ शोहरू का च़ूई छ़ुटी, तेखअ निंयं हन्‍ना सह शोहरू शिलोह बिधाता सेटा, संघा निंयं चिई सालो बाछ़ू, कोई एक मण पिठअ, अर एक खाल्हल़ी दाखो रस। हन्‍ना पजैल़अ शमूएल शिलोह बिधाते पबित्र ज़ैगा, तधू त सह लान्हअ ई। <verse eid="1SA 1:24" /><verse number="25" style="v" sid="1SA 1:25" />तेऊ बाछ़ूओ बल़ीदान करी निंयं सह शोहरू एली प्रोहता सेटा। <verse eid="1SA 1:25" /><verse number="26" style="v" sid="1SA 1:26" />हन्‍ना बोलअ एली प्रोहता लै, “हे मेरै मालक, तेरै सोह! हुंह आसा सह ई बेटल़ी ज़ुंण एकी बारी इधी बिधाता सेटा अरज़ करदी ती लागी दी, <verse eid="1SA 1:26" /><verse number="27" style="v" sid="1SA 1:27" />अह आसा सह ई शोहरू ज़ेता लै मंऐं बिधाता सेटा अरज़ किई ती, अर बिधाता दैनअ मुल्है ज़िहअ मंऐं मांगअ तिहअ ई। <verse eid="1SA 1:27" /><verse number="28" style="v" sid="1SA 1:28" />मंऐं त अह शोहरू बिधाता लै बांधअ मनअ द कि अह सारी ज़िन्दगी इधी बिधाते च़ाकरी करे। ऐबै दैनअ मंऐं अह इधी पजैल़ी करै सभाल़ी।”</para>
  <para style="p" vid="1SA 1:28">तेखअ टेक्‍कअ तेऊ तिधी बिधाता सेटा माथअ।<verse eid="1SA 1:28" /></para>
  <chapter eid="1SA 1" />
  <chapter number="2" style="c" sid="1SA 2" />
  <para style="s">हन्‍ना किई बिधाते स्तोती</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:46-55">लूक. 1:46-55</ref>
      </char>
    </note>हन्‍ना किई बिधाता सेटा एही प्राथणां,</para>
  <para style="q" vid="1SA 2:1">“हे बिधाता, तंऐं दैनी हुंह खुशी करै भरी,</para>
  <para style="q" vid="1SA 2:1">हे बिधाता, तेरै एऊ कामां करै हुअ मेरअ अदर!</para>
  <para style="q" vid="1SA 2:1">ऐबै सका हुंह बी आपणैं दुशमणा लै ज़बाब दैई</para>
  <para style="q" vid="1SA 2:1">किल्हैकि मुंह हुई खास्सी खुशी कि तंऐं दैनअ मुल्है छ़ुटकारअ।<verse eid="1SA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="1SA 2:2" />ताह बिधाता सान पबित्र निं कोहै आथी,</para>
  <para style="q" vid="1SA 2:2">ताह ज़िहअ निं होर कोहै आथी,</para>
  <para style="q" vid="1SA 2:2">ताह म्हारै परमेशरा ज़ेही शरण दैणैं आल़अ निं कोहै आथी।<verse eid="1SA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="1SA 2:3" />हुंह सका तिन्‍नां घमंडी लोगा लै इहअ बोली,</para>
  <para style="q" vid="1SA 2:3">‘बडी-बडी डिंगा मारने पाआ छ़ाड़,</para>
  <para style="q" vid="1SA 2:3">बिधाता आसा परमेशर, तेऊ का निं किछ़ू गल्‍ले च़ोरी करी सकदै,</para>
  <para style="q" vid="1SA 2:3">सह करा म्हारै सोभी कामां भाल़ी तेतो नसाफ।’<verse eid="1SA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="1SA 2:4" />हे बिधाता, तंऐं पाऐ बडै-बडै शूरबीरे कतीर-कबाण चोल़ी,</para>
  <para style="q" vid="1SA 2:4">पर दुबल़ै आदमी करा तूह बलबान।<verse eid="1SA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="1SA 2:5" />ज़ुंण रज्ज़ै-पूज़ै दै थिऐ,</para>
  <para style="q" vid="1SA 2:5">तिंयां लागै आपणैं पेटा धाचणा लै मज़दूरी करदै!</para>
  <para style="q" vid="1SA 2:5">ज़ुंण भुखै थिऐ, तिन्‍नां दैनअ तंऐं रज्ज़ी खाणां लै।</para>
  <para style="q" vid="1SA 2:5">बांढी बेटल़ी लै दैनै तंऐं सात शोहरू,</para>
  <para style="q" vid="1SA 2:5">ज़सरै खास्सै शोहरू थिऐ तिंयां निं कोहै रहै।<verse eid="1SA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="1SA 2:6" />मारनै तारनै आल़अ तूह ई बिधाता</para>
  <para style="q" vid="1SA 2:6">तूह पजैल़ा लोगा तिधी, ज़िधी मरी करै डेओआ</para>
  <para style="q" vid="1SA 2:6">अर तेता का बापस बी आणा तिन्‍नां तूह ई।<verse eid="1SA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="1SA 2:7" />तूह बिधाता ई बणाआं कोई सेठ अर कोई मणछा गरीब,</para>
  <para style="q" vid="1SA 2:7">तूह ई दैआ कोई मणछा लै बडी ज़ैगा बशैल़ी अदर</para>
  <para style="q" vid="1SA 2:7">अर कोई करा नकदरै।<verse eid="1SA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1SA 2:8" />तूह करा रैनै-गरीबा धूल़ै-माट्टै जैंदरा का बी खल़ै,</para>
  <para style="q" vid="1SA 2:8">संघा दैआ तिन्‍नां लै सेठ अर बलबान लोगा संघै बशैल़ी अदर।</para>
  <para style="q" vid="1SA 2:8">पृथूईए आथरी आसा तंऐं बिधाता पाई दी</para>
  <para style="q" vid="1SA 2:8">अर तेथ प्रैंदै आसा तंऐं अह संसार बणाअं द।<verse eid="1SA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1SA 2:9" />तूह करा आपणीं परज़े फाज़त,</para>
  <para style="q" vid="1SA 2:9">पर कदुष्ट हणैं न्हैरै दी खतम,</para>
  <para style="q" vid="1SA 2:9">किल्हैकि कोहै मणछ निं आपणैं ज़ोरै ज़िती सकदअ।<verse eid="1SA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1SA 2:10" />ज़ुंण बिधाता संघै ज़ीद डाहा, तिंयां हणैं पठी खतम,</para>
  <para style="q" vid="1SA 2:10">तेऊ क्रुंगणअ तिन्‍नां लै स्वर्गा का।</para>
  <para style="q" vid="1SA 2:10">तेऊ करनअ सारै संसारो नसाफ,</para>
  <para style="q" vid="1SA 2:10">बिधाता दैणअ तेऊ राज़ै लै बल अर ज़ीत</para>
  <para style="q" vid="1SA 2:10">ज़ुंण तेऊ आप्पै आसा छ़ांटअ द।”<verse eid="1SA 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 2:11" />तेखअ डेऊऐ एलकाना अर तेऊए लाल़ी हन्‍ना रामाह नगरी आपणैं घअरा लै बापस फिरी अर शमूएल रहअ शिलोह बिधाते च़ाकरी करदअ, एली प्रोहत डाहा त तेऊओ धैन-खैल।<verse eid="1SA 2:11" /></para>
  <para style="s">एली प्रोहते शोहरू</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 2:12" />एली प्रोहते दुहै शोहरू तै बेघै कदुष्ट अर तिंयां निं बिधातो अदर ई करदै तै! <verse eid="1SA 2:12" /><verse number="13" style="v" sid="1SA 2:13" />प्रोहत करा तै इहअ कि ज़ेभै लोग मेल़-ज़ोल़े बल़ीदान किऐ दै पशूए शिखा सटेऊंदै हआ तै लागै दै, तेभै एछा त प्रोहतो दास, तेऊए हाथै हआ त चिई शल़ाहीओ एक कल़गैथू। ज़ांऊं शिखा सिटदी हआ ती लागी दी, <verse eid="1SA 2:13" /><verse number="14" style="v" sid="1SA 2:14" />सह दास पाआ त तेऊ कल़गैथू गोल़िऐ, हांडै, बल़ाही अर कनाल़ी भितरी, तेखअ ज़ेतरी शिखा तेऊ कल़गैथू दी शाचे सह हआ थिअ प्रोहतो भाग। ज़ुंण बी इज़राईली शिलोह मेल़-ज़ोल़े बल़ीदान करदै एछा तै तिन्‍नां सोभी का काढा तै प्रोहता लै भाग इहअ ई करै।<verse eid="1SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 2:15" />पर तिंयां प्रोहते दास बोला तै एता का लाऊआ च़र्बी भुज़णै का आजी मेल़-ज़ोल़े बल़ीदान करनै आल़ै सेटा एछी, “धख शिखा दैआ प्रोहता लै भुज़णा लै, तेऊ निं थारी सटेऊई दी शिखा लोल़ी, तेऊ लै दैआ काच़ी शिखा।” <verse eid="1SA 2:15" /><verse number="16" style="v" sid="1SA 2:16" />पर ज़ै लोग तिन्‍नां लै इहअ बोला तै, “अज़ी दै हाम्हां च़र्बी भुज़ी लणें, तेखअ निंयैं ज़ेतरअ लोल़ी तेतरअ।” तिंयां बोला तै इहअ, “नां, एभी दै, कि लाअ मंऐं छ़ड़ैऊई करै निंईं।”<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">एली प्रोहते शोहरू तै इहअ काम करदै लागै दै ज़ुंण बधाना दी आथी निं त!</char></note><note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="NUM 18:8-20">गण. 18:8-20</ref>; <ref loc="LEV 1:8">लेब. 1:8</ref>,<ref loc="LEV 1:9">9</ref>; <ref loc="LEV 3:3-5">3:3-5</ref></char></note><verse eid="1SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 2:17" />एऊ साबै निं एली प्रोहते शोहरू बल़ीदानो अदर करदै तै ज़ुंण लोग बिधाता लै करा तै। अह त बिधाता लै घोर पाप अर एता करै आई बिधाता खास्सी रोश्शै।<verse eid="1SA 2:17" /></para>
  <para style="s">शमूएले च़ाकरी</para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 2:18" />पर शमूएल त अज़ी लान्हअ ई अर सह रहा त बिधाते च़ाकरी बाछो खास च़ोल़अ अर गाची बान्हीं लागी। <verse eid="1SA 2:18" /><verse number="19" style="v" sid="1SA 2:19" />ज़ेभै तेऊए ईज आपणैं लाल़ै संघै मेल़-ज़ोल़े बल़ीदान करदी शिलोह एछा ती सह आणा ती हर साल तेऊ लै एक च़ोल़अ बणाईं। <verse eid="1SA 2:19" /><verse number="20" style="v" sid="1SA 2:20" />एली प्रोहत दैआ त एलकाना अर तेऊए लाल़ी हन्‍ना लै बर्गत। तेऊ बोलअ एलकाना लै इहअ, “ज़ुंण अह शोहरू तंऐं बिधाता लै बांधअ दैनअ, बिधाता लोल़ी एऊए बदल़ै तेरी लाल़ी हन्‍ना का होर लुआद दैनी।”</para>
  <para style="p" vid="1SA 2:20">तेखअ डेऊऐ तिंयां आपणैं घअरा लै फिरी। <verse eid="1SA 2:20" /><verse number="21" style="v" sid="1SA 2:21" />बिधाता दैनी हन्‍ना लै होर बी बर्गत अर तेसे हुऐ आजू चअन शोहरू अर दूई शोहरी होर। सह बडअ शोहरू शमूएल रहअ बिधाते पबित्र ज़ैगा च़ाकरी करदी ज़ुआन हंदअ लागी।<verse eid="1SA 2:21" /></para>
  <para style="s">एली प्रोहत अर तेऊए शोहरू</para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 2:22" />एली प्रोहत गअ त ऐबै प्रोढअ हई, तेऊ का खोज़ा तै होर लोग कि तेऊए शोहरू इज़राईली संघै किहअ बूरअ बभार करा! होर ता हुअ, तिंयां सुत्ता तै बिधाते मेल़-ज़ोल़े खिम्भे दुआरै च़ाकरी करनै आल़ी बेटल़ी संघै बी ज़ोरा-ज़ोरी! <verse eid="1SA 2:22" /><verse number="23" style="v" sid="1SA 2:23" />एली प्रोहतै बोलअ आपणैं तिन्‍नां शोहरू लै, “तम्हैं इहअ कदुष्ट काम किल्है करा? हुंह थक्‍कअ सोभी का थारी ऊआई शूणीं-शूणीं कि तम्हैं किज़ै-किज़ै कबध करा। <verse eid="1SA 2:23" /><verse number="24" style="v" sid="1SA 2:24" />मेरै शोहरूओ, ऐबै ता पाआ इहअ करने छ़ाड़! अह आसा बेघै च़िल़्हखरअ काम ज़ेते बारै बिधाते लोग खोज़दै आसा लागै दै कि तम्हैं लाअ इहअ करी! <verse eid="1SA 2:24" /><verse number="25" style="v" sid="1SA 2:25" />ज़ै एक मणछ दुजै मणछा लै पाप करे, हई सका कि परमेशर तेऊ गलती करनै आल़ै लै माफी छ़ाडे<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">माफी छ़ाडे </char><char style="ft" closed="false">इब्रानी दी निं एतो मतलब खास थोघ आथी</char></note>, पर सह मणछ कहा बच़ाऊंणअ ज़ुंण पाप ई बिधाता लै करे?”</para>
  <para style="p" vid="1SA 2:25">पर तिन्‍नैं निं आपणैं बाबा एलीए एक बी शूणीं, किल्हैकि बिधाता तै तिंयां ऐबै मारी लाऐ दै।<verse eid="1SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 2:26" />शमूएल रहअ ज़ुआन हंदअ लागी, बिधाता बी त तेऊ लै खुश अर मणछ बी थिऐ तेऊ लै खुश।<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LUK 2:52">लूक. 2:52</ref></char></note><verse eid="1SA 2:26" /></para>
  <para style="s">एली प्रोहता लै बिधातो समाद</para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 2:27" />एकी बारी आअ एक गूर एली प्रोहते घअरा लै, संघा खोज़अ तेऊ का बिधातो समाद, “ज़धू तेरै दाद-बाब हारण अर तेऊए टबर मिसर देशे माहा राज़ेए गलाम थिऐ, तधू हुअ त हुंह तिन्‍नां सेटा प्रगट। <verse eid="1SA 2:27" /><verse number="28" style="v" sid="1SA 2:28" />इज़राईले सोभी गोत्रा मांझ़ै छ़ांटअ मंऐं हारण ई आप्पू लै प्रोहत कि मेरी बेदी च़ाकरी करे, मुल्है धूप ज़ाल़े, मुंह सेटा प्रोहते सदरी बान्हीं मुंह पुछ़े। मंऐं दैनअ तिन्‍नां लै हक कि ज़ुंण बल़ीदान अर हूम लोग मुल्है भैंट करा, सह हणअ तिन्‍नों भाग।<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="EXO 28:1-4">लुआ. 28:1-4</ref>; <ref loc="LEV 7:35">लेब. 7:35</ref>,<ref loc="LEV 7:36">36</ref></char></note> <verse eid="1SA 2:28" /><verse number="29" style="v" sid="1SA 2:29" />ऐबै लोग ज़ुंण मेल़-ज़ोल़ अर नाज़ बल़ीए मेरी ज़ैगा धाम दैआ, तेथ किल्है आसा थारी आछ लागी दी? एली, तूह किल्है करा मुखा खास्सअ आपणैं शोहरूओ अदर? तिंयां च़ाल्‍लै द मेरी इज़राईली परज़ा का राम्बल़अ-राम्बल़अ खाई रुभा ज़िहै मोठुई। <verse eid="1SA 2:29" /><verse number="30" style="v" sid="1SA 2:30" />ऐबै बोला हुंह इज़राईलो परमेशर बिधाता, मंऐं तै डाहै तै थारै खिंबे लोग सदा लै आपणैं प्रोहत बणाईं, ऐबै निं आजू हुंह तम्हां डाहंदअ! ऐबै करनअ मुंह तिन्‍नों अदर ज़ुंण मेरअ अदर करा अर ज़ुंण मुंह बृथा समझ़ा, तिंयां आसा मुल्है बी बृथा।<verse eid="1SA 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 2:31" />“ऐबै शुण राम्बल़ै करै, ऐबै एछणअ तम्हां लै इहअ बगत कि मुंह पाणै तेरै खिंब अर तेरै टबरे मणछ खारकी अमरा मारी अर तम्हां मांझ़ै निं एक बी मणछ खास्सी प्रोढी अमरा तैणीं ज़िऊंणअ। <verse eid="1SA 2:31" /><verse number="32" style="v" sid="1SA 2:32" />तेरै खिंबा पल़णीं आफ़ता प्रैंदै आफ़त। च़ाऐ हुंह इज़राईला लै केतरअ बी खास्सअ झ़ूरूं, पर तेरै खिंबै जाणै सोभै खारकी अमरा मरी।<verse eid="1SA 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 2:33" />“पर तज़ी बी डाहणैं मुंह तेरै खिंबा का आपणीं च़ाकरी लै कुंण नां कुंण ज़रूर, ज़ुंण मुंह प्रोहतच़ारी लै ज़िऊंदअ डाहणअ बी, सह हणअ लेरा लाई-लाई कांणअ अर सारी अमरा दुखी अर तेरै खिंबे बाकी मणछ जाणैं खारकी अमरा मरी। <verse eid="1SA 2:33" /><verse number="34" style="v" sid="1SA 2:34" />ज़ांऊं तेरै दूई शोहरू पिनहास अर हुपनी दुहै एकी धैल़ै मरनै, सह हणअ ऐहा गल्‍लो नछ़ैण कि ज़ुंण मंऐं गल्‍ला बोली तिंयां रहणीं हई।<note caller="-" style="x"><char style="xo" closed="false">2:34 </char><char style="xt" closed="false"><ref loc="1SA 4:11">1 शमू. 4:11</ref></char></note><verse eid="1SA 2:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 2:35" />“मुंह छ़ांटणअ आप्पू लै सह प्रोहत ज़ुंण मुल्है शुचअ-पाक्‍कअ होए अर सह ज़िहअ हुंह बोले सह तिहअ ई करे। मुंह बढेरनीं तेऊए आद-लुआद अर तिन्‍नां करनीं मेरै तेऊ राज़ै सेटा च़ाकरी ज़ुंण मुंह छ़ांटणअ। <verse eid="1SA 2:35" /><verse number="36" style="v" sid="1SA 2:36" />तेखअ हणअ इहअ कि ज़ुंण तेरै खिंबा का बच़ै दै होए, तिन्‍नां लागणै तिन्‍नां प्रोहता सेटा डेऊई आप्पू ज़िऊंणां लै ढब्बै अर रोटी मांगणी अर ज़ीबाण करी लागणअ तिन्‍नां आप्पू लै काम मांगणअ ताकि तिन्‍नां टुकरै-म्हार खाणां लै भेटे।”<verse eid="1SA 2:36" /></para>
  <chapter eid="1SA 2" />
  <chapter number="3" style="c" sid="1SA 3" />
  <para style="s">बिधाता किई शमूएला संघै गल्‍ला</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 3:1" />शमूएल त लान्हअ अर बिधाते च़ाकरी करदअ लागअ द। एली प्रोहत करा त तेऊ का खोज़ी कि किहअ अर किज़ै करनअ। तेऊ ज़मानै निं बिधाता कोही का किछ़ै समाद दैंदअ त अर नां धैनै-सुपनै एछदअ त।<verse eid="1SA 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 3:2" />एली प्रोहत त आछिओ कांणअ गअ द हई, अर सह थिअ एकी बारी आपणीं पांडा सुत्तअ द। <verse eid="1SA 3:2" /><verse number="3" style="v" sid="1SA 3:3" />शमूएल थिअ बिधाते पबित्र ज़ैगा सुत्तअ द ज़िधी करारो मणशू थिअ। तिधी त सदीअ अज़ी ज़ल़दअ लागअ द, <verse eid="1SA 3:3" /><verse number="4" style="v" sid="1SA 3:4" />तेभै बोलअ बिधाता शमूएलो नाअं, “शमूएल!” तेऊ बोलअ, “किज़ै बोला!” <verse eid="1SA 3:4" /><verse number="5" style="v" sid="1SA 3:5" />शमूएल ठुर्हअ तेभी एली सेटा लै संघा पुछ़अ, “तंऐं शादअ हुंह, किज़ै बोला?”</para>
  <para style="p" vid="1SA 3:5">पर एली दैनअ ज़बाब, “मंऐं निं शादी तूह, डेऊ, सुत्त।” शमूएल डेऊअ, संघा रहअ सुत्ती।<verse eid="1SA 3:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="1SA 3:6-7" />बिधाता बोलअ शमूएला लै भिई, “शमूएल।” तेऊ शोहरू निं ज़ाणअ कि सह आसा बिधाता किल्हैकि तधू तैणीं निं बिधाता तेऊ संघै गल्‍ला किई आथी ती। सह उझ़ुअ तेभी खल़अ संघा बोलअ एली प्रोहता सेटा डेऊई, “तंऐं शादअ हुंह ऐ, किज़ै बोला?”</para>
  <para style="p" vid="1SA 3:6-7">पर एली दैनअ तेऊ लै ज़बाब, “मेरै शोहरूआ, मंऐं निं तूह शादअ, डेऊ संघा रहअ आपणैं च़ैन्‍नै सुत्ती।”<verse eid="1SA 3:6-7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 3:8" />चिई बारी बोलअ बिधाता शमूएला लै भिई, सह बी उझ़ुअ संघा बोलअ एली सेटा डेऊई, “तंऐं शादअ हुंह, तै किज़ै बोला?”</para>
  <para style="p" vid="1SA 3:8">तेखअ समझ़अ एली प्रोहत कि एऊ शोहरू शाददअ हणअ बिधाता लागअ द। <verse eid="1SA 3:8" /><verse number="9" style="v" sid="1SA 3:9" />तेखअ बोलअ एली शमूएला लै इहअ, “डेऊ आपणैं च़ैन्‍नै रहअ सुत्ती, ज़ै सह भिई ताल्है बोले, तूह बोलै, ‘हे बिधाता, बोल, तूह किज़ै बोला, हुंह तेरअ दास आसा शूणअ लागअ द।’” शमूएल डेऊअ संघा रहअ आपणैं च़ैन्‍नै सुत्ती।<verse eid="1SA 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 3:10" />तेखअ आअ बिधाता भिई, संघा बोलअ तिधी खल़्हुई तिहअ ई ज़िहअ तेऊ थोल़ी घल़ी आजी बोलअ त, “शमूएल! शमूएल!”</para>
  <para style="p" vid="1SA 3:10">शमूएलै दैनअ ज़बाब, “बिधाता, बोल, तूह किज़ै बोला? हुंह तेरअ च़ाकर आसा शूणअ लागअ द।”<verse eid="1SA 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 3:11" />बिधाता बोलअ तेऊ लै इहअ, “शमूएल, मंऐं लाअ इज़राईली लै किज़ै इहअ करी कि सह हणअ इहअ डरैऊंणअ कि तेते बारै ज़ुंण बी शुणें तिन्‍नां छ़ुटणअ दर्छ़णअ। <verse eid="1SA 3:11" /><verse number="12" style="v" sid="1SA 3:12" />तैहा धैल़ी करनी मुंह सह गल्‍ल पूरी ज़ुंण मंऐं एली अर तेऊए खिंबे बारै आसा बोली दी। तिंयां गल्‍ला हणीं ज़ेही मंऐं बोली तेही ई सोभ पूरी। <verse eid="1SA 3:12" /><verse number="13" style="v" sid="1SA 3:13" />मंऐं आसा एली का खोज़ी हेरअ द कि तेऊए खिंबा लै लाई मंऐं सदा लै सज़ा दैई किल्हैकि एलीए शोहरू समझ़अ हुंह बृथा अर एली का थिअ इहअ थोघ कि तेऊए शोहरू किज़ै किअ पर तेऊ निं तिंयां रोक्‍कै आथी। <verse eid="1SA 3:13" /><verse number="14" style="v" sid="1SA 3:14" />तैही काढा हुंह सोह कि ज़ुंण घोर पाप एली प्रोहते खिंबा दी हुअ, तेऊ पापो प्राश्त निं तिन्‍नें मेल़-ज़ोल़ अर नाज़ बल़ी दैई बी हणअ।”<verse eid="1SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 3:15" />शमूएल रहअ दोत्ती तैणीं च़ैन्‍नै सुत्ती, तेखअ ज़ांऊं सह खल़अ उझ़ुअ, तेऊ खोल्हअ बिधाते खिम्भो दुआर। पर तेऊ निं तिंयां धैनै-सुपनै बिधाता संघै हुई दी गल्‍ला एली प्रोहता का डरै खोज़ी बोल़ी।<verse eid="1SA 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 3:16" />एली शादअ सह संघा बोलअ इहअ, “शमूएल, बेटैआ!”</para>
  <para style="p" vid="1SA 3:16">शमूएलै बोलअ, “ज़ी, किज़ै बोला।”<verse eid="1SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 3:17" />एली पुछ़अ, “ताखा बिधाता किज़ै गल्‍ला किई? ज़ै तूह मुखा पठी गल्‍ला ज़ेही बोली तेही नांईं खोज़े, तै लोल़ी बिधाता ताल्है तेता का बी खास्सी सज़ा दैनी!” <verse eid="1SA 3:17" /><verse number="18" style="v" sid="1SA 3:18" />तेखअ खोज़ी शमूएलै सारी गल्‍ला बाढै ज़ेही बिधाता बोली ती तेही ई। एली बोलअ तेखअ इहअ, “सह आसा बिधाता, ज़िहअ सह करे सह आसा भलअ ई।”<verse eid="1SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 3:19" />शमूएल रहअ ज़ुआन हंदअ लागी अर बिधाता त आप्पै तेऊ संघै अर तेऊ किई तिंयां सोभै गल्‍ला पूरी ज़ुंण शमूएलै बोली दी। <verse eid="1SA 3:19" /><verse number="20" style="v" sid="1SA 3:20" />तेखअ गअ उतरा बाखा दान मुल्खा उंधै दखणा बाखा बेर्शेबा नगरी तैणीं सोभी इज़राईली का थोघ लागी कि बिधाता आसा शमूएल आप्पू लै गूर छ़ांटअ द। <verse eid="1SA 3:20" /><verse number="21" style="v" sid="1SA 3:21" />शमूएला रहै शिलोह बिधाते दर्शण हंदै लागी, बिधाता हआ त शमूएला लै प्रगट संघा करा त सह तिधी तेऊ संघै गल्‍ला। ज़ेभै शमूएल बोला थिअ, तेता शूणां तै सोभ इज़राईली।<verse eid="1SA 3:21" /></para>
  <chapter eid="1SA 3" />
  <chapter number="4" style="c" sid="1SA 4" />
  <para style="s">करारो मणशू निंयं पलिश्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 4:1" />तिन्‍नां धैल़ै हुअ इहअ कि पलिश्ती लोग हुऐ इज़राईली संघै जुधा लै कठा। शमूएल गूरै दैनअ इज़राईली लै समाद अर तिंयां बी निखल़ै पलिश्ती संघै जुधा लै, तिन्‍नैं पाऐ एबीनेज़र आपणैं डेरै अर पलिश्ती तै अपेक नाओंए ज़ैगा आपणैं डेरै पाऐ दै। <verse eid="1SA 4:1" /><verse number="2" style="v" sid="1SA 4:2" />पलिश्ती आऐ दल बणाईं इज़राईली संघै जुधा लै। अर तिधी हुअ खास्सअ घणअ जुध अर पलिश्ती पाऐ च़ार हज़ार इज़राईली मारी। <verse eid="1SA 4:2" /><verse number="3" style="v" sid="1SA 4:3" />ज़ांऊं इज़राईली सैना आपणैं डेरै बापस पुजी, इज़राईली सैणैं लागै इहअ बोल्दै, “आझ़ बिधाता पलिश्ती हाम्हां का किल्है दैनअ ज़ितणैं? डेओआ, बिधातो करारो मणशू आणा शिलोह का इधा लै ताकि बिधाता हाम्हां संघै रहे अर सह हाम्हां म्हारै दुशमणा का बच़ाऊए।”<verse eid="1SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 4:4" />तिन्‍नैं छ़ाडै समाद लई शिलोह लै दूत कि करारो मणशू आणा शिलोह का इधा लै। किल्हैकि स्वर्गे सारी सैने मालक बिधाता ज़हा का सारअ बल आसा, तेऊओ आसन थिअ करारे मणशू प्रैंदै फैंखा आल़ै करूब स्वर्ग दूता प्रैंदै। एली प्रोहते दूई शोहरू हुपनी अर पिनहास बी आऐ बिधाते करारे मणशू संघै।<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EXO 25:22">लुआ. 25:22</ref></char></note><verse eid="1SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 4:5" />ज़ांऊं बिधाते करारो मणशू तिधी पुजअ, इज़राईली किअ खुशी दी इहअ ज़ोरै ज़ै-ज़ैकार कि तिधी लागी धरती बी च़ुक्‍कदी। <verse eid="1SA 4:5" /><verse number="6" style="v" sid="1SA 4:6" />पलिश्ती लागै तेता शूणीं इहअ बोल्दै, “इना इब्रानीए डेरै शूणां केही लैल़ा लाई! एतो किज़ै मतलब होए?” तेखअ खोज़अ तिन्‍नां का कुंणी कि इनो आसा बिधाते करारो एक मणशू सह पुजअ इब्रानी सैने दला दी।<verse eid="1SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 4:7" />पलिश्ती पल़अ हैल़अ अर तिंयां लागै इहअ बोल्दै, “तिन्‍नें दला दी आअ ऐबै तिन्‍नों देअ बी! ऐबै हारै हाम्हैं! आईओ! इहअ निं आझ़ा का पैहलै कधि हुअ! <verse eid="1SA 4:7" /><verse number="8" style="v" sid="1SA 4:8" />आईओ! इने महान देअआ का निं हाम्हां कोहै बच़ाऊई सकदअ, अह आसा सह ई बेघै बलबान देअ ज़ुंणीं मिसरी लोगा लै खास्सी आफ़ता पाई सज़ा दैनी ती! <verse eid="1SA 4:8" /><verse number="9" style="v" sid="1SA 4:9" />भाईओ, हिम्मत करा! असली मर्धा ज़िहअ जुध करै, इहअ निं हआ कि हाम्हैं इब्रानी लोगे गलाम होए ज़िहै तिंयां म्हारै गलाम थिऐ। ऐबै करा जुध ज़बर ज़ोर लाई!”<verse eid="1SA 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 4:10" />तेखअ चुटै पलिश्ती जुधा लै इहै कि तिंयां ज़ितै इज़राईली का भिई, जुधा दी हुई घोर काट-फणाटी अर पलिश्ती पाऐ इज़राईली सैना मांझ़ै कोऐ तिह हज़ार मारी! बाकी बच़ै दै इज़राईली ठुर्है जुधा का हारी आपणैं डेरै लै बापस। <verse eid="1SA 4:10" /><verse number="11" style="v" sid="1SA 4:11" />बिधातो करारो मणशू बी निंयं पलिश्ती इज़राईली का लुटी आप्पू संघै अर एली प्रोहते दूई शोहरू हुपनी अर पिनहास बी पाए मारी।<verse eid="1SA 4:11" /></para>
  <para style="s">एली प्रोहते मौत</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 4:12" />एक सपाही ज़ुंण बिन्यामीन गोत्रो थिअ, सह ठुर्हअ जुधे ज़ैगा का, संघा पुजअ तैहा ई धैल़ी शिलोह। शोग प्रगट करना लै धेल़ै तेऊ आपणैं झिकल़ै अर मुंडै पाअ माट्टअ-गट्टअ। <verse eid="1SA 4:12" /><verse number="13" style="v" sid="1SA 4:13" />सह डेऊअ नगरी दी संघा खोज़अ तेऊ जुधो हाल कि किज़ै हुअ, तेता शूणीं लागै सोभ लेरा लांदै। एली प्रोहता गअ फिकर पल़ी कि करारे मणशू लै हुअ हणअ किज़ै! सह थिअ बाते बाढै आपणैं आसना दी बेठअ द अर न्हैल़अ लागअ द। <verse eid="1SA 4:13" /><verse number="14" style="v" sid="1SA 4:14" />लोगो हाल्‍लअ शूणीं बोलअ एली इहअ, “लोगै इहअ हाल्‍लअ अर लैल़ा-पकारा किल्है आसा लाई दी?” सह सपाही आअ झ़टपटै एली सेटा लै संघा खोज़ी तेऊ का सारी गल्‍ला।<verse eid="1SA 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 4:15" />एली प्रोहते अमर ती ठैनुऐं साल गई दी हई अर आछी का निं तेऊए ऐबै किछ़ शुझदअ त! <verse eid="1SA 4:15" /><verse number="16" style="v" sid="1SA 4:16" />तेऊ सपाही बोलअ इहअ, “हुंह आअ जुधे ज़ैगा का आझ़ ई किहअ करै बच़ी संघा पुजअ इधी।”</para>
  <para style="p" vid="1SA 4:16">एली पुछ़अ तेऊ का इहअ, “बेटैआ, ओर्ही खोज़ तेथ हुअ किज़ै?”<verse eid="1SA 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 4:17" />तेऊ सपाही दैनअ ज़बाब, “इज़राईली ठुर्है पलिश्ती सेटा का पिछ़ू, म्हारै पाऐ खास्सै आदमी मारी! तेरै दूई शोहरू हुपनी अर पिनहास बी पाऐ मारी अर बिधाते करारे मणशू बी किअ पलिश्ती आपणैं कबज़ै दी!”<verse eid="1SA 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 4:18" />ज़िहअ ई एली बिधाते करारे मणशूए बारै शूणअ, एली बुल़्हअ पिछ़ू बाखा लै धाक्‍कअ संघा पल़अ धरनीं। सह थिअ प्रऊल़ी सेटा दुआली पिछ़ू आपणीं गाद्दी बेठअ द। सह थिअ प्रोढअ अर मोट्टअ बी खास्सअ, सह बधल़ुअ मुंडे बलै धरनीं, तिहअ करै चुटअ तेऊओ कैल़अ अर सह हुअ तिधी मरी हक्‍क। सह थिअ च़ाल़्ही साला तैणीं इज़राईलीओ पांच़।<verse eid="1SA 4:18" /></para>
  <para style="s">पिनहास प्रोहते बेटल़ी बी मूंईं</para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 4:19" />एली प्रोहते नुश ज़ुंण पिनहास प्रोहते लाल़ी थिई, सह थिई सुंदी अर तेसे तै सूंणें धैल़ै सिक्‍कै दै। ज़ांऊं तैहा शूणअ कि बिधाते करारो मणशू किअ पलिश्ती आपणैं कबज़ै दी अर तेसो शौहरअ अर मर्ध बी गऐ मरी, तैहा उझ़ुई हेरा-हेरी सूंणें दाह संघा सूई। <verse eid="1SA 4:19" /><verse number="20" style="v" sid="1SA 4:20" />ज़ांऊं तैहा प्राण लाऐ तै शोटी, तैहा फेर खल़्हुई दी बेटल़ी लागी तैहा लै इहअ हैअ दैंदी, “हैअ डाह, भाल़ तेरै हुअ भाऊ।” तैहा नां ज़बाब दैनअ अर नां तिन्‍नां बेटल़ीए गल्‍ला दी धैन दैनअ। <verse eid="1SA 4:20" /><verse number="21-22" style="v" sid="1SA 4:21-22" />पर सह रही इहअ सोठदी लागी कि तेसो मर्ध अर तेसो शौहरअ गऐ मरी, तैही बोलअ तैहा, “मेरै शोहरू नाअं हणअ इकबोद, किल्हैकि बिधाते करारे मणशू दी किअ दुशमणै कबज़अ, ऐबै निं इज़राईला दी बिधातो जश रहअ।”<verse eid="1SA 4:21-22" /></para>
  <chapter eid="1SA 4" />
  <chapter number="5" style="c" sid="1SA 5" />
  <para style="s">करारो मणशू हुअ पलिश्ती लै आफ़त</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 5:1" />बिधाते करारो मणशू आपणैं कबज़ै करनै का बाद पजैल़अ पलिश्ती लोगै एबीनेज़र ज़ैगा का आपणीं नगरी अशदोद। <verse eid="1SA 5:1" /><verse number="2" style="v" sid="1SA 5:2" />तिधी डाहअ पलिश्ती करारो मणशू आपणैं देअ दगोने देहुरै संघा डाहअ दगोन देअए काछ़ा बशैल़ी।<verse eid="1SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 5:3" />दुजै धैल़ै दोत्ती भाल़अ अशदोद नगरीए पज़ैरै कि तिन्‍नें दगोन देअए सह मुहुर्ती आसा बिधाते करारे मणशू सेटा धरनीं उटी बाखा पल़ी दी। तिन्‍नैं डाही तेखअ सह मुहुर्ती तिधी भिई तेही ई खल़ी करी। <verse eid="1SA 5:3" /><verse number="4" style="v" sid="1SA 5:4" />पर चिऐ धैल़ै दोत्ती बी ज़ांऊं तिंयां उझ़ुऐ, तिन्‍नैं भाल़ी भिई सह मुहुर्ती तेही ई बिधाते करारे मणशू सेटा उटी बाखा पल़ी दी। ऐहा बारी थिई दगोन देअए मुहुर्तीए दुहै बाहा अर मूंड चुटी करै डेहल़ा सेटा पल़ै दै अर पिछ़ू ती सिधी घेर बच़ी दी। <verse eid="1SA 5:4" /><verse number="5" style="v" sid="1SA 5:5" />तैही निं आझ़ तैणीं बी दगोन देअए पज़ैरै अर अशदोद नगरी ज़ुंण तेऊ देअए मानता करा, देहुरै डेऊई डेहल़ टपदै अर नां तेथ गंईं डाहंदै।<verse eid="1SA 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 5:6" />बिधाता पाई अशदोद नगरीए लोगा अर तिन्‍नां ओरी-पोरी रहणैं आल़ै लोगा लै घोर आफ़ता। तिन्‍नां निखल़ी घेरी बडी-बडी गिल्टी। <verse eid="1SA 5:6" /><verse number="7" style="v" sid="1SA 5:7" />खिरी लागै अशदोद नगरीए लोग इहअ बोल्दै, “इज़राईलो देअ आसा हाम्हां अर म्हारै देअआ लै सज़ा दैंदअ लागअ द। एऊ मणशू निं इधी आप्पू जैंदरी डाहा, एऊ काढा पोर्ही।”<verse eid="1SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 5:8" />तेखअ शादै पलिश्ती सोभै पांज़ा राज़ै समाद दैई अशदोद नगरी लै, संघा पुछ़अ तिन्‍नां का इहअ, “इज़राईलीए देअए एऊ करारे मणशू लै ऐबै किज़ै करनअ?”</para>
  <para style="p" vid="1SA 5:8">तिन्‍नैं बोलअ, “एऊ डाहा गात नगरी पजैल़ी।” ज़ांऊं तिन्‍नैं करारो मणशू पिछ़ू फिरी गात नगरी पजैल़अ, <verse eid="1SA 5:8" /><verse number="9" style="v" sid="1SA 5:9" />तिधी पुजदी पाई बिधाता गात नगरीए लोगा लै बी घोर आफ़त। गात नगरी बी निखल़ी होछ़ै का प्रोढै तैणीं सोभी पलिश्ती गिल्टी। <verse eid="1SA 5:9" /><verse number="10" style="v" sid="1SA 5:10" />तेखअ निंयं तिन्‍नैं तिधा का करारो मणशू अक्रोन नगरी लै। ज़ेतरी तिधी पुजअ निं, तैहा नगरी रहणैं आल़ै पलिश्ती गऐ लैल़ा-पकारा लाई इहअ बोल्दै लागी, “ऐबै हेरअ अह इज़राईलीए देअओ मणशू हाम्हां अर म्हारै लोगा मारना लै इधी पजैल़ी!”<verse eid="1SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 5:11" />तेखअ शादै अक्रोन नगरीए पलिश्ती सोभै राज़ै भिई संघा बोलअ तिन्‍नां लै, “इज़राईलीए देअए एऊ मणशू काढा एता का पोर्ही, संघा पजैल़ा एता तैहा नगरी ज़िधी एऊए ज़ैगा आसा, तिहअ करै जाणैं हाम्हैं अर म्हारै लोग मरनै का बच़ी।” सारी नगरी ती लेर-पकार मच़ी दी किल्हैकि बिधाता पाई तिन्‍नां लै घोर आफ़त। <verse eid="1SA 5:11" /><verse number="12" style="v" sid="1SA 5:12" />ज़ुंण लोग ज़िऊंदै बी थिऐ बच़ै दै, तिंयां तै गिल्टी करै भरी धकदै लागै दै। तिंयां तै आपणैं देअआ लै लैल़ा-पकारा लाई मज़त मांगदै।<verse eid="1SA 5:12" /></para>
  <chapter eid="1SA 5" />
  <chapter number="6" style="c" sid="1SA 6" />
  <para style="s">करारो मणशू दैनअ बापस पजैल़ी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 6:1" />बिधाते करारो मणशू रहअ पलिश्ती देशै साता भिन्‍नैं तैणीं। <verse eid="1SA 6:1" /><verse number="2" style="v" sid="1SA 6:2" />तेखअ शादै पलिश्ती आपणैं देअए पज़ैरै अर मणशाण झ़ैऊंणै आल़ै संघा पुछ़अ तिन्‍नां का, “बिधाते करारे मणशूओ हाम्हां किज़ै करनअ? हाम्हां का खोज़ा कि अह एते आपणीं ज़ैगा केऊ साबै पजैल़णअ अर एते प्राश्त करना लै किज़ै लागणअ दैणअ?”<verse eid="1SA 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 6:3" />तिन्‍नैं बोलअ इहअ, “ज़ै तम्हैं इज़राईलीए देअओ करारो मणशू बापस छ़ाडे, तेता संघै लऐ मणशू इधा लै आणने पापो प्राश्त करना लै दोश बल़ी ज़रूर दैई। इहअ करै जाणैं तम्हैं बमारी का नरोगै हई। तेखअ जाणअ तम्हां का थोघ लागी कि इज़राईले देअऐ तम्हां लै एही घोर आफ़त किल्है पाई।”<verse eid="1SA 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 6:4" />पलिश्ती पुछ़अ इहअ, “हाम्हां दोश बल़ी लै किज़ै लागणअ दैणअ?”</para>
  <para style="p" vid="1SA 6:4">तिन्‍नैं बोलअ इहअ, “तम्हैं निंयैं पापे प्राश्त करना लै सुन्‍नें पांज़ गिल्टी अर पांज़ मुश्शै हरेकी पलिश्ती राज़े नाओंऐं एक-एक। किल्हैकि सारी परज़ा अर सोभी पांज़ा राज़ै लै थिई एकी ई रंगे बमारी। <verse eid="1SA 6:4" /><verse number="5" style="v" sid="1SA 6:5" />इना गिल्टी अर मुश्शे मुहुर्ती बणाऐं तम्हैं ऐहा गल्‍ला रहैऊंणा लै कि तम्हैं करा इज़राईलीए देअओ अदर। तै झ़ाणीं सह तम्हां अर थारै देअआ लै पल़ी दी ऐहा आफ़ता दूर करे। <verse eid="1SA 6:5" /><verse number="6" style="v" sid="1SA 6:6" />ज़िहै मिसर देशे लोगा अर तिन्‍नों माहा राज़अ हठू थिऐ, तम्हैं निं तिहै हआ। ज़ांऊं इज़राईलीओ देअ तिन्‍नां लै सबक दैई मुक्‍कअ, तेखअ पल़अ त तिन्‍नां इज़राईली डेऊणैं दैनअ।<verse eid="1SA 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 6:7" />“तम्हैं आणा एक कोरी गाड्डी, संघा छ़ांटा दूई गाऊई ज़ुंण लाहुदी सूई दी होए अर आझ़ तैणीं किधी निं ज़ुंडी, तिन्‍नां गाऊई ज़ुंडै तैहा गाड्डी दी पर तिन्‍नें होछ़ै बाछ़ू डाहै खुढै हूल़ी। <verse eid="1SA 6:7" /><verse number="8" style="v" sid="1SA 6:8" />तेखअ पाऐ एऊ बिधाते करारे मणशू तैहा गाड्डी दी, अर तम्हैं ज़ुंण पापो प्राश्त करना लै सुन्‍नें गिल्टी अर दोश बल़ी लै सुन्‍नें मुश्शै आसा बणाईं दी, तेता बी डाहै मणशू संघै गाड्डी दी। तेखअ छ़ेल़्है तैहा गाड्डी संघा दैऐ तेता आपणीं बाता आज़री डेऊणैं। <verse eid="1SA 6:8" /><verse number="9" style="v" sid="1SA 6:9" />तम्हैं रहै पिछ़ू का तैहा गाड्डी भाल़ै लागी कि सह गाड्डी बेथ-शमेश नगरी बाखा आपणैं मुल्खा लै डेऊई कि नांईं, तै समझ़ै तम्हैं इहअ कि अह आसा इज़राईलीओ देअ ज़ुंणीं हाम्हां लै घोर आफ़त पाई, ज़ै सह गाड्डी आपणैं मुल्खा बाखा नांईं डेओए, तै ज़ाणैं इहअ कि हाम्हैं पल़ै ऐहा घोर बमारी कुदरती अर अह आफ़त निं इज़राईलीए देअऐ पाई।”<verse eid="1SA 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 6:10" />ज़ेही तिन्‍नैं पज़ैरै अर मणशाण झ़ैऊंणै आल़ै सलाह दैनी, पलिश्ती किअ तिहअ ई। तिन्‍नैं आणी दूई लाहुदी सूई दी गाऊई संघा ज़ुंडी तैहा कोरी गाड्डी दी अर तिन्‍नें होछ़ै बाछ़ू डाहै खुढै हूल़ी। <verse eid="1SA 6:10" /><verse number="11" style="v" sid="1SA 6:11" />तेखअ बशैल़अ तिन्‍नैं बिधाते करारो मणशू तैहा गाड्डी दी अर तेथ संघै तिंयां सुन्‍नें पांज़ गिल्टी अर तेथ संघै तिंयां पांज़ मुश्शे मुहुर्ती बी डाही एकी होरी दरोठू भितरी गाड्डी दी। <verse eid="1SA 6:11" /><verse number="12" style="v" sid="1SA 6:12" />तेखअ छ़ेल़्ही सह गाड्डी बेथ-शमेश नगरीए बाता अर तिंयां गाऊई रही तैहा ई बाता आज़री हांढदी लागी अर तिंयां निं तैहा बाता का ओर्ही नां पोर्ही फिरी। तिंयां पांज़ पलिश्ती राज़ै डेऊऐ तैहा गाड्डी पिछ़ू-पिछ़ू बेथ-शमेश नगरीए सिऊंआं तैणीं भाल़ै।<verse eid="1SA 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 6:13" />बेथ-शमेश नगरीए लोग तै तेऊ खागै कणका लऊंदै लागै दै। ज़ांऊं तिंयां उझै बाखा भाल़अ, तिन्‍नां का शुझुअ करारो मणशू अर तेता भाल़ी हुऐ तिंयां खास्सै खुशी। <verse eid="1SA 6:13" /><verse number="14-15" style="v" sid="1SA 6:14-15" />सह गाड्डी आई बेथ-शमेश नगरीए ज़ैहसू नाओंए मणछे खेचा लै अर गाड्डी खल़्हुई तैहा ज़ैगा ज़िधी बडी टोल्ह आसा। तिधी झाल़्हुऐ नगरीए लोग अर तिन्‍नां संघै तै लेबी बी। लेबी डाहअ सह करारो मणशू गाड्डी का थुआल़ी तैहा बडी टोल्हा प्रैंदै अर तेता संघै ज़ुंण तिंयां सुन्‍नें गिल्टी अर सुन्‍नें मुश्शै बी डाही टोल्हा प्रैंदै। तिन्‍नां संघै थोल़ै आदमी फाल़ी सह गाड्डी झ़ुका लै अर तिंयां गाऊई किई बिधाता लै हूम बल़ी। तैहा ई धैल़ी किऐ बेथ-शमेश नगरीए लोगै बिधाता लै होर बी हूम अर मेल़-ज़ोल़े बल़ीदान।<verse eid="1SA 6:14-15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 6:16" />तिंयां पलिश्ती पांज़ राज़ै तै दूरा का इना सोभी गल्‍ला भाल़ै लागै दै कि किज़ै-किज़ै किअ अर तेखअ डेऊऐ तिंयां तैहा ई धैल़ी अक्रोन नगरी आपणैं घअरा लै बापस फिरी।<verse eid="1SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 6:17" />सुन्‍नें ज़ुंण तिंयां पांज़ गिल्टी पलिश्ती बिधाते करारे मणशू निंणे पापे प्राश्त करना लै दोश बल़ी दैनी ती, तिंयां ती अशदोद, गाज़ा, अशकलोन, गात अर अक्रोन नगरी बाखा एक-एक। <verse eid="1SA 6:17" /><verse number="18" style="v" sid="1SA 6:18" />तिंयां सुन्‍नें मुश्शै बी थिऐ सोभी फेर-फिरदै उछ़टै गहल़ा आल़ी नगरी अर गराऊंआं बाखा एक-एक ज़ेथ तिन्‍नां पांज़ पलिश्ती प्रैंदै राज़ करनै आल़ैओ राज़ थिअ। बेथ-शमेश नगरी ज़ैहसूए खेचै सह बडी टोल्ह ज़ेथ प्रैंदै बिधाते करारो मणशू बशैल़अ त, सह टोल्ह आसा आझ़ तैणीं बी<note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="fq" closed="false">आझ़ तैणीं बी </char><char style="ft" closed="false">ऐहा कताबा लिखणे ज़मानै तैणीं</char></note> तिधी ऐहा गल्‍ले शाजत कि इहअ-इहअ हुअ त।<verse eid="1SA 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 6:19" />बेथ-शमेश नगरीए मूंऐं तिधी सत्तर मणछ किल्हैकि तिन्‍नैं भाल़अ बिधाते करारो मणशू घुआल़ी करै भितरा का। तिधी पल़अ खास्सअ शोग किल्हैकि तिन्‍नां मांझ़ै पाऐ तिधी बिधाता एतरै खास्सै मणछ मारी।<verse eid="1SA 6:19" /></para>
  <para style="s">करारो मणशू निंयं किर्यात-ज़रीम</para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 6:20" />बेथ-शमेश नगरीए लोग लागै इहअ बोल्दै, “एऊ पबित्र परमेशर बिधाता नेल़ निं कोह डेऊई सकदअ! अह करारो मणशू हुअ हाम्हां किधी होर्ती डाहणअ पजैल़ी! पर अह किधा लै दैनअ?” <verse eid="1SA 6:20" /><verse number="21" style="v" sid="1SA 6:21" />तैही छ़ाडै तिन्‍नैं किर्यात-ज़रीम नगरी लै दूत, तिन्‍नां लै दैनअ इहअ समाद, “पलिश्ती हेरअ बिधाते करारो मणशू बापस दैई, तम्हैं लोल़ी उंधै आऐ संघा निंयैं एता आप्पू संघै।”<verse eid="1SA 6:21" /></para>
  <chapter eid="1SA 6" />
  <chapter number="7" style="c" sid="1SA 7" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 7:1" />तेखअ पुजै किर्यात-ज़रीम नगरी बस्सै दै इज़राईली बेथ-शमेश। तिधा का निंयं तिन्‍नैं बिधाते करारो मणशू उझै किर्यात-ज़रीम नगरी लै, संघा डाहअ अबीनादाब नाओंए मणछे घअरै, तेऊओ घअर त धारठी प्रैंदै। तिन्‍नैं किई अमीनादाबे शोहरू एलीआजरे शुधी संघा डाहअ करारो मणशू तेऊ का सभाल़ी।<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="2SA 6:2-4">2 शमू. 6:2-4</ref>; <ref loc="1CH 13:5-7">1 इति. 13:5-7</ref></char></note><verse eid="1SA 7:1" /></para>
  <para style="s">इज़राईला दी शमूएल पांच़</para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 7:2" />बिधाते करारो मणशू रहअ खास्सी साला किर्यात-ज़रीम कोई बिहा साला तैणीं। एतरी साला रहै इज़राईली बिधाता का लेर-पकार पाई मज़त मांगदै लागी।<verse eid="1SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 7:3" />एकी धैल़ै बोलअ शमूएल गूरै इज़राईली लै इहअ, “ज़ै तम्हैं असली दी आपणैं दिला का बिधाता बाखा फिरै, तै काढा आप्पू मांझ़ा का इना पराऐ देअआ अर अशतरोत देबीए मुहुर्ती पोर्ही। आप्पू रहा पठी बिधाते स्तोती दी लागी। तै हेरनै तम्हैं तेऊ पलिश्ती का बच़ाऊई।” <verse eid="1SA 7:3" /><verse number="4" style="v" sid="1SA 7:4" />तेखअ काढै इज़राईली तिंयां बाल देअए अर अशतरोत देबीए मुहुर्ती आप्पू मांझ़ा का पोर्ही संघा रहै सिधै बिधाते स्तोती दी लागी।<verse eid="1SA 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 7:5" />तेखअ बोलअ शमूएलै इहअ, “सोभै इज़राईली करा मिज़पा नगरी झाल़अ, हुंह करूं तिधी तम्हां सोभी लै बिधाता सेटा प्राथणां।” <verse eid="1SA 7:5" /><verse number="6" style="v" sid="1SA 7:6" />तेखअ किअ सोभी इज़राईली मिज़पा एछी झाल़अ। तिन्‍नैं आणअ कुहै का पाणीं संघा तरैल़अ सह पाणीं बिधाता सेटा, तिंयां रहै तैहा सारी धैल़ी ब्रतू, तिन्‍नैं बोलअ इहअ, “हाम्हां किअ बिधाता लै पाप।” शमूएलै किअ मिज़पा नगरी इज़राईलीओ नसाफ।<verse eid="1SA 7:6" /></para>
  <para style="s">पलिश्ती आऐ इज़राईली संघै जुधा लै</para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 7:7" />ज़ांऊं पलिश्तीए पांज़ा राज़ै का थोघ लागअ कि इज़राईली आसा मिज़पा झाल़अ, तिन्‍नें छ़ाडी सैना कि इज़राईली लै चुटी पल़े। ज़ांऊं इज़राईली का इहअ थोघ लागअ, तिंयां डरै खास्सै अर <verse eid="1SA 7:7" /><verse number="8" style="v" sid="1SA 7:8" />इज़राईली बोलअ शमूएला लै इहअ, “तूह रह बिधाता सेटा हाम्हां लै अरज़ करदअ लागी, तूह बोल बिधाता लै कि हाम्हां बच़ाऊ पलिश्ती का।”<verse eid="1SA 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 7:9" />शमूएलै काटअ एक च़ूई झुटणैं आल़अ मिम्मूं संघा किअ सह बेदी दी पठी दहई <note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xq" closed="false">पठी दहई </char><char style="xt" closed="false"><ref loc="LEV 6:23">लेब. 6:23</ref>; <ref loc="DEU 13:16">बधा. 13:16</ref>; <ref loc="DEU 33:10">33:10</ref></char></note>बिधाता लै हूम बल़ी। तेखअ किई शमूएलै बिधाता का अरज़ कि इज़राईली बच़ाऊ। बिधाता दैनअ शमूएले प्राथणों ज़बाब। <verse eid="1SA 7:9" /><verse number="10" style="v" sid="1SA 7:10" />ज़ांऊं शमूएल बिधाता लै हूम बल़ी करदअ त लागअ द, पलिश्ती सैना गई ती इज़राईली संघै जुधा करना लै खास्सी नेल़ एछी। पर बिधाता लाअ तैहा ई धैल़ी सरगै पलिश्ती प्रैंदै गुल़ूबिज़ल़ू इहअ ज़ोरै-ज़ोरै कि तिन्‍नां छ़ुटअ दर्छ़णअ, संघा झाखुऐ तिंयां आप्पू मांझ़ै पठी अर इहअ करै हारै पलिश्ती संघा ठुर्है बापस। <verse eid="1SA 7:10" /><verse number="11" style="v" sid="1SA 7:11" />इज़राईली ठुर्है मिज़पा का पलिश्ती पिछ़ू, तिन्‍नैं खद्रेल़ै तिंयां काटदी-मारदी धारा बाखा उंधै बेथ-कार तैणीं।<verse eid="1SA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 7:12" />शमूएलै किअ एक बडी ज़ान मिज़पा अर शेन मांझ़े ज़ैगा खल़ी अर तैहा ज़ानीं नाअं डाहअ तेऊ इहअ बोली एबीनेज़र<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">एबीनेज़र </char><char style="ft" closed="false">मज़तीओ ज़ान</char></note>, “बिधाता किई म्हारी इधी तैणीं मज़त।” <verse eid="1SA 7:12" /><verse number="13" style="v" sid="1SA 7:13" />इहअ करै हारै पलिश्ती अर तेखअ निं तिंयां इज़राईलीए देशै भिई आऐ। शमूएले ज़िऊंदी ज़िता डाहै बिधाता पलिश्ती रोक्‍की। <verse eid="1SA 7:13" /><verse number="14" style="v" sid="1SA 7:14" />अक्रोन उंधै गात तैणीं ज़ेतरी नगरी दी पलिश्ती कबज़अ थिअ किअ द, तिंयां नगरी बी भेटी इज़राईली बापस अर इना नगरी फेर ज़ेतरअ बी मुल्ख आसा, सह बी भेटअ इज़राईली बापस। इज़राईली अर अमोरी लोगा मांझ़ै बी हुअ मेल़-ज़ोल़।<verse eid="1SA 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 7:15" />आपणीं ज़िऊंदी ज़िता रहअ शमूएल इज़राईलीओ पांच़ अर सैणअ। <verse eid="1SA 7:15" /><verse number="16" style="v" sid="1SA 7:16" />सह डेओआ त हर साल बेतेल, गिलगाल अर मिज़पा मुल्खै संघा दैआ त इज़राईली लै नसाफ करी। <verse eid="1SA 7:16" /><verse number="17" style="v" sid="1SA 7:17" />तेखअ एछा त सह रामाह नगरी आपणैं घअरा लै अर तिधी बी करा त सह इज़राईलीओ नसाफ। रामाह नगरी बी थिई शमूएलै बिधाता लै एक बेदी डाही दी बणाईं।<verse eid="1SA 7:17" /></para>
  <chapter eid="1SA 7" />
  <chapter number="8" style="c" sid="1SA 8" />
  <para style="s">इज़राईली डाही राज़ेए मांग</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 8:1" />ज़ांऊं शमूएल प्रोढअ हुअ, तेऊ बणाऐं आपणैं शोहरू इज़राईली प्रैंदै पांच़। <verse eid="1SA 8:1" /><verse number="2" style="v" sid="1SA 8:2" />तेऊए तै तिंयां दूई ई शोहरू, ज़ेठै नाअं त जोएल अर कान्हैं नाअं त अबियाह। तिंयां करा तै बेर्शेबा नगरी रही लोगो नसाफ। <verse eid="1SA 8:2" /><verse number="3" style="v" sid="1SA 8:3" />पर तिन्‍नों सभाब निं आपणैं बाब शमूएला ज़िहअ आथी त। तिन्‍नां त सिधअ ढब्बैओ मांण अर तिंयां खाआ तै लोगा का रेशपत संघा निं शुचअ नसाफ करदै तै।<verse eid="1SA 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 8:4" />खिरी हुऐ सोभै इज़राईलीए सैणैं कठा संघा डेऊऐ रामाह नगरी शमूएला सेटा। <verse eid="1SA 8:4" /><verse number="5" style="v" sid="1SA 8:5" />तिन्‍नैं बोलअ शमूएला लै इहअ, “भाल़, तूह ता गअ ऐबै प्रोढअ हई अर तेरै शोहरूओ सभाब निं ताह ज़िहअ सभाब आथी! ऐबै छ़ांट तूह हाम्हां प्रैंदै राज़ करना लै एक राज़अ, तै हणअ म्हारै बी नसाफ करना लै राज़अ, ज़िहअ होरी देशै आसा।”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="DEU 17:14">बधा. 17:14</ref>; <ref loc="ACT 13:21">शधा. 13:21</ref></char></note><verse eid="1SA 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 8:6" />शमूएल त तिन्‍नें ऐहा गल्‍ला का नराज़ कि तिन्‍नैं पाई राज़े मांग। सह लागअ एते बारै बिधाता का प्राथणां करी पुछ़दअ। <verse eid="1SA 8:6" /><verse number="7" style="v" sid="1SA 8:7" />बिधाता बोलअ शमूएला लै इहअ, “शमूएल, ज़िहअ ईंयां बोला, तूह कर तिहअ ई। अह निं इहअ आथी कि ईंयां निस्सै ताह मनी! अह गल्‍ल बोली इनै मुल्है कि हुंह निं इना आप्पू प्रैंदै राज़अ लोल़ी! <verse eid="1SA 8:7" /><verse number="8" style="v" sid="1SA 8:8" />ज़धकै मंऐं ईंयां मिसर देशे गलामी का काढै, तधकै आऐ ईंयां कबल्‍लै मुंह छ़ाडी होरी देअआ पूज़दी! तिहअ ई लाअ इनै आझ़ तूह छ़ाडी। <verse eid="1SA 8:8" /><verse number="9" style="v" sid="1SA 8:9" />तैही बोला हुंह ताल्है, ज़िहअ ईंयां बोला तूह कर तिहअ ई, पर इना लै डाह पैहलै ई चतैनगी दैई कि राज़ै आजू इना संघै किहअ बभार करनअ।”<verse eid="1SA 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 8:10" />ज़ुंण इज़राईली सैणैं राज़े मांग करदै तै लागै दै, शमूएलै खोज़अ तिन्‍नां का इहअ कि बिधाता बोलअ इहअ-इहअ। <verse eid="1SA 8:10" /><verse number="11" style="v" sid="1SA 8:11" />शमूएलै खोज़अ इहअ, “राज़ैओ राज़ हणअ तम्हां प्रैंदै इहअ कि तेऊ राज़ै बणाणीं थारै शोहरू करै आपणीं सैना, तिन्‍नां मांझ़ै कोऐ हणैं जुधा लै रथा-घोल़ै च़लाऊंदै अर कोऐ हणैं तेऊए रथा आजू-आजू पैदल ठुहर्दै लागै दै, <verse eid="1SA 8:11" /><verse number="12" style="v" sid="1SA 8:12" />कोई हणैं हज़ार-हज़ार सपाही प्रैंदै दलपति अर कोऐ हणैं पज़ाह-पज़ाह सपाही प्रैंदै दरोगै। एता का लाऊआ डाहणैं तेऊ कोऐ राज़ै आपणैं खेचै हल़ा लांदै अर लऊंदै लाई। कोऐ डाहणैं तेऊ जुधा लै अस्त्र-शस्त्र अर रथे समाना बणाऊंदै लाई।<verse eid="1SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 8:13" />“थारी शोहरी डाहणीं तेऊ खुशबूदार तेला काढदी अर कोऐ राज़ दरबारै सोभी रंगे खाणैं-पिणैं बणाऊंदी मल़ेगी लाई। <verse eid="1SA 8:13" /><verse number="14" style="v" sid="1SA 8:14" />राज़ै दैणैं थारै रज़दै-पज़दै खेच, राम्बल़ै-राम्बल़ै जैतून अर दाखे बाग आपणैं कार-करिंदै लै। <verse eid="1SA 8:14" /><verse number="15" style="v" sid="1SA 8:15" />तेऊ निंणअ थारै नाज़ अर दाखो दसुअ निसब मांगी संघा दैणअ सह आपणैं बज़ीर अर होरी कार-करिंदै लै।<verse eid="1SA 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 8:16" />“थारै दास-दासी, राम्बल़ै-राम्बल़ै डागै अर गाधै निंणै राज़ै, संघा डाहणैं तेऊ तिंयां आपणैं कामां करदै लाई। <verse eid="1SA 8:16" /><verse number="17" style="v" sid="1SA 8:17" />थारी भेडा-बाकरीए हेल़्ही मांझ़ै बी हर दसा मांझ़ै एक आप्पू लै अर इहअ करै हणैं तम्हैं आप्पू ई राज़े गलाम। <verse eid="1SA 8:17" /><verse number="18" style="v" sid="1SA 8:18" />खिरी एछणी तम्हां गल़ै तैणीं घाटी अर तम्हैं लागणै तेऊ राज़ै का आज़ाद हणां लै बिधाता सेटा लेर-पकार पाई अरज़ करदै ज़ुंण तम्हैं आप्पै छ़ांटअ! पर बिधाता निं तेभै तम्हां लै किछ़ै ज़बाब दैणअ।”<verse eid="1SA 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 8:19" />इज़राईली निं शमूएले इना चतैनगी बाखा धैन दैनअ, तिन्‍नैं बोलअ इहअ पै, “हाम्हैं निं मंदै, हाम्हां लोल़ी राज़अ ई, <verse eid="1SA 8:19" /><verse number="20" style="v" sid="1SA 8:20" />तै हणैं हाम्हैं बी होरी देशा ज़िहै अर म्हारै बी हणअ नसाफ करनै आल़अ राज़अ ज़ुंण हाम्हां बाखा जुध करना लै हाम्हां आजू डेओए।”<verse eid="1SA 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 8:21" />शमूएलै शूणीं तिन्‍नें गल्‍ला पठी संघा खोज़ी तिंयां गल्‍ला बिधाता का। <verse eid="1SA 8:21" /><verse number="22" style="v" sid="1SA 8:22" />बिधाता दैनअ शमूएला लै ज़बाब, “ज़िहअ ईंयां बोला, तूह कर तिहअ ई, अर तिन्‍नां लै छ़ांट एक राज़अ।”</para>
  <para style="p" vid="1SA 8:22">तेखअ बोलअ शमूएलै इज़राईली लै, “ठीक आ बै, तम्हैं डेओआ आपणीं-आपणीं नगरी आपणैं घअरा लै फिरी।”<verse eid="1SA 8:22" /></para>
  <chapter eid="1SA 8" />
  <chapter number="9" style="c" sid="1SA 9" />
  <para style="s">शाऊल छ़ांटअ इज़राईलीओ राज़अ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 9:1" />बिन्यामीन मुल्खै गिबाह नगरी थिअ एक मणछ। तेऊ नाअं त कीश। तेऊए बाब-दादू तै ईंयां: एबीएल, सरोर, बकरात अर अपीह। कीश थिअ बिन्यामीन गोत्रा का। तेऊ का थिई खास्सी ज़ैदात। <verse eid="1SA 9:1" /><verse number="2" style="v" sid="1SA 9:2" />कीशो थिअ शाऊल नाओं एक ज़ुआन शोहरू। सह शोहरू त इज़राईली मांझ़ै सोभी का लाम्मअ कि होर लोग एछा तै तेऊए कान्हा तैणीं अर हेरनअ शुणनअ बी थिअ सह सोभी का बित्तअ।<verse eid="1SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 9:3" />कीशा का थिई गाधी अर एकी बारी लुक्‍की तिंयां, तेऊ बोलअ आपणैं शोहरू शाऊला लै, “तूह निंऊं आप्पू संघै एक दास संघा आण तिन्‍नां गाधी लोल़ी।” <verse eid="1SA 9:3" /><verse number="4" style="v" sid="1SA 9:4" />तिंयां डेऊऐ एप्रैम धारा बाखे मुल्खै अर सारै शलीशा नाओंए मुल्खै लोल़ै पर तिंयां गाधी निं तिन्‍नां भेटी। तेखअ डेऊऐ तिंयां शालीम मुल्खै। तिधी बी निं तिन्‍नां तिंयां गाधी भेटी अर तिधा का पुजै तिंयां बिन्यामीन गोत्रे मुल्खा बाखा अर तिधी बी निं तिन्‍नां तिंयां गाधी भेटी। <verse eid="1SA 9:4" /><verse number="5" style="v" sid="1SA 9:5" />खिरी डेऊऐ तिंयां सूप मुल्खा बाखा अर शाऊलै बोलअ आपणैं दासा लै इहअ, “च़ाल्‍ल ऐबै डेऊणअ घअरा लै फिरी, ज़ै हाम्हैं छ़ेक्‍कै घअरा लै नांईं फिरे, गाधी ता जाणअ बाब बिस्सरुई पर तेऊ पल़णअ म्हारअ हैल़अ-फिकर कि किधी रहै!”<verse eid="1SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 9:6" />तेऊ दासै बोलअ इहअ, “मालक, धिरअ भाल़ै! ऐहा सूप नगरी आसा एक बिधातो गूर मणछ अर तेऊओ करा सोभै अदर। ज़िहअ सह खोज़ा, तिंयां गल्‍ला निभा तेही ई। च़ाल्‍ल हाम्हां लणअ तेऊ सेटा डेऊई, हाम्हां पुछ़णअ तेऊ का, झ़ाणीं सह हाम्हां का खोज़ी हेरे कि हाम्हां म्हारी गाधी किधी भेटणीं।”<verse eid="1SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 9:7" />शाऊलै बोलअ तेऊ दासा का, “तेऊ पुछ़दै कै हाम्हां रित्तै हाथै डेऊणअ? नां हाम्हां का रोटी रही अर नां हाम्हां का तेऊ दैणा लै किज़ै होर आथी!” <verse eid="1SA 9:7" /><verse number="8" style="v" sid="1SA 9:8" />दासै बोलअ शाऊला लै भिई, “मालक, मुखा आसा च़ंदीए च़ुआन्‍नी, तेता सका हाम्हैं तेऊ लै दैई अर तेखअ हेरनअ तेऊ हाम्हां का खोज़ी कि हाम्हां केथ बाखा डेऊणअ लोल़ै।”<verse eid="1SA 9:8" /></para>
  <para style="p">
    <verse number="9-11" style="v" sid="1SA 9:9-11" />शाऊलै बोलअ, “अब्बी हुअ ठीक! तै च़ाल्‍ल।” तेखअ डेऊऐ तिंयां तैहा नगरी लै ज़िधी सह बिधातो गूर रहा त। ज़ांऊं तिंयां नगरी बाखा उझै कुआल़ी तै हांढदै लागै दै, तिन्‍नां भेटी बाता ज़ुआन बेटल़ी फणैरा लै डेऊंदी। तिन्‍नैं पुछ़अ तिन्‍नां बेटल़ी का, “ऐहा नगरी कुंण पीर आसा?” पराणैं ज़मानै बोला तै इज़राईली तिन्‍नां लै पीर। ज़ै कुंण परमेशरा का पुछ़णअ च़ाहा त, सह बोला त, “पीरा सेटा एछणअ डेऊई।” <verse eid="1SA 9:9-11" /><verse number="12-13" style="v" sid="1SA 9:12-13" />तिन्‍नैं बेटल़ी बोलअ, “हाँ, आसा, तम्हां सम्हनै भाल़ा पार आसा सह, ऐहा ई बाता डेओआ आजू, ज़ै तम्हैं छ़ेक्‍कै डेओए, तै हेरनअ तम्हां सह नगरीए प्रऊल़ी सेटा ठिमकी। ज़िहै ई तम्हैं नगरी भितरी डेओए, सह जाणअ तिधी तम्हां का शुझुई। आझ़ डेऊणैं सोभ लोग धारा प्रैंदै बेदी दी हूमा लै अर तैही आसा आझ़ सह बी आअ द। ज़ुंण प्राहुंणैं तै शादै दै, तिन्‍नां बी निं ताऊं तैणीं बल़ीदान किई दी शिखा खाणीं ज़ांऊं तैणीं सह तिधी निं पुजअ किल्हैकि बल़ीदाना लै बर्गत दैआ सोभी का आजी सह।”<verse eid="1SA 9:12-13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 9:14" />शाऊल अर तेऊओ दास डेऊऐ तेभी नगरी लै, ज़ांऊं तिंयां नगरीए प्रऊल़ी भितरी डेऊऐ, तिन्‍नैं भाल़अ शमूएल उझै धारा बाखा डेऊंणा लै तिन्‍नां बाखा एछदअ लागअ द। <verse eid="1SA 9:14" /><verse number="15" style="v" sid="1SA 9:15" />तैहा का पिछ़ली धैल़ी त बिधाता शमूएला का इहअ खोज़ी हेरअ द, <verse eid="1SA 9:15" /><verse number="16" style="v" sid="1SA 9:16" />“काल्‍ला छ़ाडणअ मुंह ऐहा ई बेला बिन्यामीन गोत्रा का ताह सेटा एक मणछ, तेऊओ करै तूह मेरी परज़ा इज़राईलीओ सैणअ हणां लै अभिषेक। तेऊ बच़ाऊंणै इज़राईली पलिश्ती का। मंऐं भाल़ी कि मेरी परज़ा आसा खास्सै दुख ज़िरदी लागी दी अर मंऐं हेरी तिन्‍नां लै झींण करी।”<verse eid="1SA 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 9:17" />ज़ांऊं शमूएला का शाऊल शुझुअ, बिधाता बोलअ तेऊ लै इहअ, “अह आसा सह ई मणछ ज़सरै बारै मंऐं ताखा खोज़अ त। अह ई हणअ मेरी परज़ा प्रैंदै राज़ करनै आल़अ।”<verse eid="1SA 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 9:18" />तेखअ लागअ शाऊल नगरीए प्रऊल़ी सेटा शमूएला का पुछ़दअ, “मुखा खोज़ इहअ कि इधी पीरो घअर किधी आसा?”<verse eid="1SA 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 9:19" />शमूएलै बोलअ, “हुंह आसा पीर, मुंह संघै च़ाल्‍ल उझै धारा लै, आझ़ खाणीं तम्हां दुही मुंह संघै रोटी। काल्‍ला दोत्ती दैंऊं हुंह थारै सोभी सुआलो ज़बाब ज़ुंण थारै दिलै आसा, संघा लागै तम्हैं डेऊंदै। <verse eid="1SA 9:19" /><verse number="20" style="v" sid="1SA 9:20" />ज़ुंण चिई धैल़ै आजी तेरी गाधी आसा लुक्‍की दी, तेतो बी निं तूह फिकर करै, तिंयां आसा भेटी गई दी। पर हुंह आसा इधी ऐहा गल्‍ला खोज़दअ कि सारै इज़राईले आशा आसा ऐबै ताह अर तेरै खिंबा दी लागी दी।”<verse eid="1SA 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 9:21" />शाऊलै दैनअ ज़बाब, “हुंह आसा बिन्यामीन गोत्रा का ज़ुंण इज़राईली दी सोभी का होछ़अ गोत्र आसा। मेरअ खिंब बी निं तेऊ गोत्रा दी खास मनअ-तनअ द आथी! तेखअ किल्है सोठा तूह मुल्है एही बडी गल्‍ल?”<verse eid="1SA 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 9:22" />तेखअ निंयं शमूएलै शाऊल अर तेऊओ दास एकी बडी पांडा लै ज़िधी सह पूज़ा-गाज़ा करा त, तिधी तै होर बी खास प्राहुणैं कोई तिह ज़ण्हैं बेठै दै अर शमूएलै बशैल़अ शाऊल तिधी सोभी का ज़ेठी ज़ैगा। <verse eid="1SA 9:22" /><verse number="23" style="v" sid="1SA 9:23" />शमूएलै बोलअ तिधी बोटिऐ लै, “ज़ुंण गुल़छ़ू मंऐं ताल्है डाही डाहणां बोलअ थिअ, तेऊ आण ओर्ही।” <verse eid="1SA 9:23" /><verse number="24" style="v" sid="1SA 9:24" />तेऊ बोटिऐ आणअ शिखा लै काटै दै पशूओ गुल़छ़ू संघा डाहअ शाऊले मुंहां आजू। तेखअ बोलअ शमूएलै इहअ, “एता भाल़, अह त ताल्है डाही डाहअ द। एऊ खा। अह त इधी तेरी ई तैणीं बच़ाऊई डाहअ द कि तूह एता इधी होरी प्राहुंणैं संघै खाए।”</para>
  <para style="p" vid="1SA 9:24">शाऊलै खाई तैहा धैल़ी शमूएला संघै रोटी। <verse eid="1SA 9:24" /><verse number="25" style="v" sid="1SA 9:25" />ज़ांऊं तिंयां धारा का उंधै नगरी लै होथै, शमूएलै निंयं शाऊल घअरा प्रैंदै दल़बै लै संघा छ़ैअ तेऊ लै च़ैन, तेऊ संघै किई गल्‍ला-बाता अर <verse eid="1SA 9:25" /><verse number="26" style="v" sid="1SA 9:26" />शाऊल सुत्तअ तिधी।</para>
  <para style="s" vid="1SA 9:26">शाऊलो अभिषेक</para>
  <para style="p" vid="1SA 9:26">दोत्ती-दोत्थी बोलअ शमूएलै शाऊला लै दल़बै प्रैंदै इहअ, “खल़अ उझ़ू, हुंह दैंऊं ताह सबाही।” शाऊल उझ़ुअ खल़अ संघा डेऊअ सह शमूएला संघा बागै।<verse eid="1SA 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 9:27" />ज़ांऊं तिंयां उंधै होथदी नगरीए पुंझ़ै पुजै, शमूएलै बोलअ शाऊला लै, “आपणैं दासा बोल हाम्हां का आजू डेऊंणा लै।” सह दास डेऊअ तिन्‍नां का आजू अर शमूएले बोलअ शाऊला लै, “थोल़ी घल़ी रह इधी खल़्हुई, हुंह खोज़ूं ताखा परमेशर किज़ै बोला।”<verse eid="1SA 9:27" /></para>
  <chapter eid="1SA 9" />
  <chapter number="10" style="c" sid="1SA 10" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 10:1" />शमूएलै पाअ शिंगी दी जैतूनो तेल संघा तरैल़अ शाऊले मुंडै, तेऊए माथै माख्खी दैई बोलअ शमूएलै इहअ, “बिधाता किअ तेरअ अभिषेक कि तूह हणअ तेऊए आपणीं खास परज़ा इज़राईलीओ सैणअ। <verse eid="1SA 10:1" /><verse number="2" style="v" sid="1SA 10:2" />मुंह सेटा का डेऊई ज़ांऊं तूह आझ़ बिन्यामीन गोत्रे मुल्खे सिऊंआं नेल़ ज़ेलज़ा नाओंए ज़ैगा, राहेले घोरी सेटा पुजणअ, तिधी भेटणैं ताह दूई मणछ। तिन्‍नां खोज़णअ तम्हां का इहअ कि ज़ुंण गाधी लुक्‍की ती, तिंयां गई भेटी अर तेरअ बाब आसा तिन्‍नां बिस्सरुई गअ द, ऐबै आसा तेऊ तेरअ हैल़अ-फिकर पल़अ द! सह रहा इहअ बोल्दअ लागी, ‘ऐबै हुंह आपणैं शोहरू केस्सी लोल़ूं!’<verse eid="1SA 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 10:3" />“तिधा का रहै आजू हांढदै लागी ज़ांऊं तैणीं ताबोर नाओंए बडै महरूए बूटा सेटा निं पुजे। तिधी भेटणैं तम्हां चअन मणछ। तिंयां हणैं बिधाता लै बल़ीदान करदै बेतेला लै च़ाल्‍लै दै। तिन्‍नां मांझ़ै एकी का हणैं चअन छ़ेल्हू, दुजै का हणैं चअन रोट अर चिऊथै हणीं दाखे रसे शिंगी च़की दी। <verse eid="1SA 10:3" /><verse number="4" style="v" sid="1SA 10:4" />तिन्‍नां पुछ़णी तम्हां का राज्ज़ी-खुशी संघा दैणैं दूई रोट तम्हां लै अर तम्हैं लागै तिन्‍नां ढाकदै। <verse eid="1SA 10:4" /><verse number="5" style="v" sid="1SA 10:5" />तेखअ पुजणैं तम्हैं बिधाते धारा ज़िधी गिबाह नाओंए ज़ैगा ज़िधी पलिश्ती सपाहीए च़ौकी आसा। तिधी भेटणैं ताह नगरी दी डेऊंदी बिधाते गूरे एक टोली। तिंयां हणैं धारा बेदी सेटा का कतारै, डफली, बींन बाज़दी नाच़दी-नाच़दी अर ज़ोरै-ज़ोरै परमेशरे गल्‍ला प्रगट करदी उंधै होथदै लागै दै। <verse eid="1SA 10:5" /><verse number="6" style="v" sid="1SA 10:6" />तेभै एछणी बिधाते आत्मां बडै बला संघै ताह दी अर तेरअ सभाब बदल़णअ पठी संघा डेऊणअ तूह बी तिन्‍नां जैंदरी अर तूह बी लागणअ परमेशरे गल्‍ला प्रगट करदअ। <verse eid="1SA 10:6" /><verse number="7" style="v" sid="1SA 10:7" />ज़ेभै ताह संघै इहअ होए, तेभै करै तूह तिहअ ज़ेही तेरै मन्‍नैं एछे अर बिधाता हेरनी तेरी मज़त करी। <verse eid="1SA 10:7" /><verse number="8" style="v" sid="1SA 10:8" />तेखअ डेओऐ तूह गिलगाल नगरी ज़रूर। थोल़ै धैल़ै बाद एछणअ हुंह बी, तूह रहै मुंह न्हैल़अ लागी। मुंह सका तिधी पुजणा लै सात धैल़ै बी लागी। तिधी एछी करनी मुंह बिधाता लै हूम बल़ी अर मेल़-ज़ोल़ो बल़ीदान। इहअ बी खोज़ूं हुंह ताखा तिधी पुजी कि ताह आजू किज़ै-किज़ै करनअ।”<verse eid="1SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 10:9" />ज़ांऊं शाऊल शमूएला सेटा का डेऊणा लै पिछ़ू फिरअ, बिधाता दैनअ शाऊला लै नऊंअ सभाब अर ज़िहअ-ज़िहअ नछ़ैण शमूएलै खोज़अ थिअ, तिंयां गल्‍ला निभी तेही ई तैहा ई धैल़ी। <verse eid="1SA 10:9" /><verse number="10" style="v" sid="1SA 10:10" />ज़ांऊं शाऊल अर तेऊओ दास गिबा पुजै, तेऊ भेटी बिधाते गूरे एक टोली एछदी, परमेशरे आत्मां बस्सी हेरा-हेरी शाऊला दी अर सह डेऊअ तिन्‍नां जैंदरी संघा लागअ तिन्‍नां ई ज़िहअ नाच़दी-नाच़दी ज़ोरै-ज़ोरै परमेशरे गल्‍ला प्रगट करदअ। <verse eid="1SA 10:10" /><verse number="11" style="v" sid="1SA 10:11" />तिन्‍नां मांझ़ै त कई शाऊल बछ़ैणअ द, ज़ांऊं तिन्‍नैं भाल़अ कि तेऊ आसा गूरा ज़ेही लहर लागी दी अर परमेशरे गल्‍ला प्रगट करदअ लागअ द! तिंयां लागै आप्पू मांझ़ै पुछ़दै, “ऐबै एऊ कीशे शोहरू किहअ गअ! शाऊल बी कै ऐबै गूर निखल़अ?” <verse eid="1SA 10:11" /><verse number="12" style="v" sid="1SA 10:12" />तिधी बोलअ एकी मणछै इहअ, “किल्है निं निखल़ी सकदअ? इना होरी गूरा निखल़णेंओ खिंब आसा त?” इहअ करै हुई कहाबत मशूर, “शाऊल बी कै ऐबै गूर निखल़अ?” <verse eid="1SA 10:12" /><verse number="13" style="v" sid="1SA 10:13" />ज़ांऊं शाऊले लहर मुक्‍की, तेखअ डेऊअ सह उझै धारा लै ज़िधी बेदी थिई बणाईं दी।<verse eid="1SA 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 10:14" />बादा का ज़ांऊं शाऊल अर तेऊओ दास घअरै पुजै, शाऊले च़ाच़ू पुछ़ै तिंयां, “लै तम्हैं एतरै धैल़ै किधी तै डेऊऐ दै?”</para>
  <para style="p" vid="1SA 10:14">शाऊलै दैनअ ज़बाब, “हाम्हैं तै गाधी लोल़ै लागै दै, ज़ांऊं हाम्हां तिंयां किधी निं भेटी, तेखअ डेऊऐ हाम्हैं शमूएला का पुछ़दै।”<verse eid="1SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 10:15" />शाऊले च़ाच़ू पुछ़अ, “तेखअ शमूएलै कै खोज़अ तम्हां का?”<verse eid="1SA 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 10:16" />शाऊलै खोज़अ, “तेऊ खोज़अ हाम्हां का इहअ कि तम्हैं रहा निहंचै तिंयां गाधी आसा भेटी गई दी।” पर शाऊलै डाहअ इना गल्‍लो टवारअ कि शमूएलै आसा सह इज़राईलीओ राज़अ हेरअ द छ़ांटी।<verse eid="1SA 10:16" /></para>
  <para style="s">शमूएलै खोज़अ इज़राईली का शाऊल आसा थारअ राज़अ</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 10:17" />तेखअ शादै शमूएलै सोभै इज़राईली मिज़पा नाओंए ज़ैगा बिधाता सेटा संघा किअ बडअ झाल़अ। <verse eid="1SA 10:17" /><verse number="18" style="v" sid="1SA 10:18" />तेऊ बोलअ इज़राईली लै इहअ, “इज़राईलो परमेशर बिधाता बोला इहअ, ‘मंऐं आणै तम्हैं मिसर देशे गलामी का काढी, मंऐं बच़ाऊऐ तम्हैं मिसरी लोगा अर तिन्‍नां होरी सोभी लोगा का ज़ुंणीं तम्हैं हंती-हंती मारी आणै तै। <verse eid="1SA 10:18" /><verse number="19" style="v" sid="1SA 10:19" />हुंह आसा थारअ परमेशर ज़ुंणीं तम्हैं थारी मसीबता अर आफ़ता का बच़ाऊऐ! पर आझ़ समझ़अ हुंह तम्हैं बृथा अर तम्हैं लागै आप्पू लै राज़ै मांगदै!’ तै करा ऐबै सोभै गोत्र अर इज़राईले सारी टोली बिधाते पबित्र ज़ैगा बडअ झाल़अ ताकि बिधाता तम्हां लै राज़अ छ़ांटे।”<verse eid="1SA 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 10:20" />शमूएलै शादै इज़राईले सोभै गोत्र अर परच़ी पाई निखल़अ बिन्यामीन गोत्रो नाअं। <verse eid="1SA 10:20" /><verse number="21" style="v" sid="1SA 10:21" />तेखअ शादी शमूएलै बिन्यामीन गोत्रे सोभै टोली आजू अर च़िठी निखल़ी मत्री खिंबे। तेखअ शादै मत्री खिंबे सोभी टोला मांझ़ै मणछ आजू अर तेथ निखल़ी कीशे शोहरू शाऊले नाओंऐं परच़ी। तेखअ लागै सोभ शाऊला लोल़ै पर तिन्‍नां निं सह तिधी भेटअ। <verse eid="1SA 10:21" /><verse number="22" style="v" sid="1SA 10:22" />तेखअ लागै तिंयां बिधाता का पुछ़दै, “हे बिधाता, सह कै इधी आअ द आसा?”</para>
  <para style="p" vid="1SA 10:22">बिधाता दैनअ तिन्‍नां लै ज़बाब, “पोर्ही दैआ समाना जैंदरी भाल़णीं, तेथ आसा शाऊल लुक्‍की रहअ द।”<verse eid="1SA 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 10:23" />तेखअ भेटअ तिन्‍नां सह तिधी संघा आणअ बागा लै। संघा किअ शाऊल लोगे झाल़ै जैंदरी खल़अ। तेऊ सका तै सोभ लोग भाल़ी किल्हैकि सह थिअ सोभी का लाम्मअ अर होर लोग एछा तै तेऊए कान्हा तैणीं। <verse eid="1SA 10:23" /><verse number="24" style="v" sid="1SA 10:24" />शमूएलै बोलअ सोभी लोगा लै, “सह मणछ आसा अह ज़ुंण बिधाता तम्हां लै राज़अ छ़ांटअ। सारै इज़राईला दी निं एऊ बराबर कोहै आथी!” सोभै लोग लागै तिधी ज़ोरै-ज़ोरै बोल्दै, “म्हारै राज़े लोल़ी खास्सी अमर हुई!”<verse eid="1SA 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 10:25" />तेखअ खोज़ी शमूएलै लोगा का सारी गल्‍ला कि राज़ैओ हक अर काम किज़ै हणअ। तेखअ डाही तिंयां बही दी लिखी पबित्र ज़ैगा बिधाता सेटा। तेखअ बोलअ शमूएलै सोभी लोगा लै कि ऐबै डेओआ आपणैं-आपणैं घअरा लै। <verse eid="1SA 10:25" /><verse number="26" style="v" sid="1SA 10:26" />शाऊल बी डेऊअ गिबा नगरी आपणैं घअरा लै। एक शूरबीर मणछे टोली बी डेऊई शाऊला संघै ज़सरै मन्‍नैं परमेशरै तेऊ संघै डेऊणे गल्‍ल पाई। <verse eid="1SA 10:26" /><verse number="27" style="v" sid="1SA 10:27" />पर कोई कदुष्ट मणछै बोलअ इहअ बी, “एऊ मणछै म्हारअ कै भलअ लाअ करी?” इहअ करै निं तिंयां शाऊला लै राज्ज़ी आथी तै अर नां तिन्‍नैं तेऊ लै किज़ै भैंट दैनी। पर शाऊलै निं तिन्‍नें इना गल्‍ला दी धैन ई दैनअ।<verse eid="1SA 10:27" /></para>
  <chapter eid="1SA 10" />
  <chapter number="11" style="c" sid="1SA 11" />
  <para style="s">शाऊलै ज़ितअ अमोरी का जुध</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 11:1" />थोल़ै धैल़ै बाद आअ अमोनी राज़अ नहाश आपणीं बडी सैना लई संघा पाअ गलाद मुल्खे नगरी जबेश फेर जुध छ़ेल़णा लै घेरअ। जबेश नगरीए सैणैं बोलअ अमोनी राज़ै नहाशा लै, “तूह कर हाम्हां संघै करार अर हाम्हैं आसा ताह आपणअ राज़अ मनणा लै तैर।”<verse eid="1SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 11:2" />अमोनी राज़ै नहाशै दैनअ तिन्‍नां लै ज़बाब, “हुंह सका तम्हां संघै सुल्हअ करी पर तेता लै लागणीं तम्हां मेरी एक गल्‍ल मनणी। सह आसा एही कि जबेश नगरी बस्सै दै सोभी मणछे दैहणीं आछी पाणीं मुंह फाल़ी ताकि सारै इज़राईलो अदर घटे।”<verse eid="1SA 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 11:3" />जबेश नगरीए सैणैं बोलअ नहाश राज़ै लै, “हाम्हां लै दै तूह साता धैल़ीओ बगत, ताकि हाम्हैं सारै इज़राईला दी दूत छ़ाडी समाद पजैल़ी सके। ज़ै हाम्हां बच़ाऊंदअ कोहै निं निखल़े, तै मनणी हाम्हां तेरी अह गल्‍ल बी।”<verse eid="1SA 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 11:4" />जबेश नगरीए दूत पुजै गिबा नगरी बी ज़हा नगरीओ शाऊल बी थिअ। ज़ांऊं तिन्‍नैं समाद खोज़अ, गिबा नगरी लागै सोभ लोग ज़ोरै-ज़ोरै लेरा लांदै। <verse eid="1SA 11:4" /><verse number="5" style="v" sid="1SA 11:5" />शाऊल त खेचा का हल़ लाई आपणैं बल्दा संघै घअरा बाखा एछदअ लागअ द, नगरी पुजी लागअ सह पुछ़दअ, “एथ किज़ै हुअ? सोभै किल्है आसा लेरा लांदै लागै दै?” तिन्‍नैं खोज़ी तेऊ का गल्‍ला कि जबेश नगरी का आसा इहअ-इहअ समाद आअ द! <verse eid="1SA 11:5" /><verse number="6" style="v" sid="1SA 11:6" />ज़ांऊं शाऊलै ईंयां गल्‍ला शूणीं, परमेशरे आत्मां किअ सह आपणैं काबू अर तेऊ आअ खास्सअ कोप। <verse eid="1SA 11:6" /><verse number="7" style="v" sid="1SA 11:7" />तेऊ पाऐ ज़ोल़ी बल्द काटी संघा किऐ तिन्‍नें ठोर-ठोर। संघा छ़ाडै सारै इज़राईल देशै दूत तिन्‍नां मास्से ठोरा रहैऊंदै अर इहअ बोल्दै, “शाऊल अर शमूएलै लाई जुधा लै सैना बणाईं, तेथ ज़ुल़ा तम्हैं सोभै। ज़ै तम्हैं नांईं ज़ुल़े, थारै बल्दे बी हणैं इहै हाल।”</para>
  <para style="p" vid="1SA 11:7">इज़राईली मणछ डरै खास्सै कि ऐबै बिधाता किज़ै लाअ होए करी, सोभी बणाअं एक मन्‍न संघा लागै ज़िहअ बोलअ तिहै ई हांढदै। <verse eid="1SA 11:7" /><verse number="8" style="v" sid="1SA 11:8" />शाऊलै किऐ तिंयां बेज़ेक नगरी कठा अर तिधी पुजै इज़राईला का चअन लाख मर्ध अर यहूदा गोत्रा का तिह हज़ार इज़राईली मर्ध। <verse eid="1SA 11:8" /><verse number="9" style="v" sid="1SA 11:9" />तेखअ बोलअ शाऊलै जबेश नगरी का आऐ दै तिन्‍नां दूता लै, “गलादा लै डेओआ बापस संघा बोला जबेश नगरी आपणैं लोगा लै कि काल्‍ला दपहरै तैणीं हेरनै तम्हैं हाम्हां बच़ाऊई।” ज़ांऊं तिन्‍नैं दूतै जबेश नगरीए लोगा का अह समाद खोज़अ, तिंयां हुऐ नाच़णै जोगी खुशी।<verse eid="1SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 11:10" />तेखअ बोलअ जबेश नगरीए सैणैं अमोनी राज़ै नहाशा लै, “काल्‍ला एछणअ हाम्हां ताह सेटा लै, तेखअ तेरअ दिल बोले, तूह करै तिहअ।”<verse eid="1SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 11:11" />तैहा राची किअ शाऊलै<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="fq" closed="false">शाऊलै </char><char style="ft" closed="false">शाऊल बणअ दूई बारी राज़अ, पैहली बारी मिज़पा अर दुजी बारी गिलगाल</char></note> इहअ कि तेऊ बांडै आपणैं आदमी चिई बाखा। दुजै धैल़ै दोत्ती पेठै तिंयां नच़ानक दुशमणे डेरै संघा दैनअ अमोनी लै फेरा-फेर गोट अर तिंयां रहै सारी दोत्ती पोर्ही दपहरै तैणीं तिन्‍नां मारदै लागी। ज़ुंण तेता का बच़ै, तिंयां छिंघुऐ इहै कि दूई ज़ण्हैं निं किधी कठा आथी ई तै। <verse eid="1SA 11:11" /><verse number="12" style="v" sid="1SA 11:12" />तेखअ लागै इज़राईली शमूएला लै बोल्दै, “ज़ुंणी इहअ बोलअ त, ‘शाऊलै किज़ै भलअ लाअ म्हारअ करी?’ तिन्‍नां आणा ओर्ही हाम्हां सेटा लै, तिंयां पाणै हाम्हां मारी।”<verse eid="1SA 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 11:13" />पर शाऊलै बोलअ इहअ, “आझ़की धैल़ी निं कोही मारी आथी, आझ़ दैनअ बिधाता इज़राईली लै छ़ुटकारअ।” <verse eid="1SA 11:13" /><verse number="14" style="v" sid="1SA 11:14" />शमूएलै बोलअ तिन्‍नां लै इहअ, “च़ाल्‍ला, हाम्हां सोभी डेऊणअ गिलगाल मुल्खा लै, तिधी बणाणअं हाम्हां भिई शाऊल राज़अ।” <verse eid="1SA 11:14" /><verse number="15" style="v" sid="1SA 11:15" />तेखअ डेऊऐ तिंयां सोभै गिलगाल, तिधी डेऊऐ पबित्र ज़ैगा बिधाता सेटा संघा बणाअं तिधी सोभी नदरी शाऊल राज़अ। तेखअ किऐ तिन्‍नैं तिधी मेल़-ज़ोल़े बल़ीदान अर इज़राईली मनाऊंईं तिधी जाच।<verse eid="1SA 11:15" /></para>
  <chapter eid="1SA 11" />
  <chapter number="12" style="c" sid="1SA 12" />
  <para style="s">शमूएलै दैनअ इज़राईली लै भाषण</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 12:1" />तेखअ बोलअ शमूएलै इज़राईली लै इहअ, “ज़िहअ तम्हैं मुखा मांगअ, मंऐं दैनअ तम्हां प्रैंदै राज़ करना लै राज़अ बणाईं। <verse eid="1SA 12:1" /><verse number="2" style="v" sid="1SA 12:2" />ऐबै हांढणअ तम्हां आजू-आजू सह राज़अ। रही मेरी गल्‍ल, हुंह गअ प्रोढअ पल़ू शेती हई। मेरै शोहरू बी आसा तम्हां ई संघै। हुंह रहअ होछ़ी उझै आझ़ तैणीं तम्हां लै सलाह दैंदअ लागी। <verse eid="1SA 12:2" /><verse number="3" style="v" sid="1SA 12:3" />हुंह आसा इधी, ज़ै मंऐं किज़ै गलत किअ होए, तेते शाजत निखल़ा तम्हैं आझ़ इधी बिधाता अर राज़ै सम्हनै ज़ुंण तेऊ छ़ांटअ। मंऐं कधू कसरअ गाधअ या बल्द किनी निंयं? मंऐं कुंण ठगअ किनी? मंऐं तम्हां मांझ़ै कुंण हंतअ किनी? मंऐं कहा का रेशपत किनी खाअ? ज़ै इना मांझ़ै मंऐं एक बी गलती किई होए, तेता दैंऊं हुंह बापस फरेऊई।”<verse eid="1SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 12:4" />लोगै दैनअ ज़बाब, “नांईं हेरे, तंऐं निं हाम्हैं ठगै अर नां हंतै आथी! तंऐं निं म्हारअ किछ़ै निंयं आथी, एही किल्है बोल़णअ!”<verse eid="1SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 12:5" />शमूएलै दैनअ ज़बाब, “बिधाता अर तेऊ छ़ांटअ द राज़अ आसा आझ़ ऐहा गल्‍ले शाजत कि मुंह दी निं किछ़ै खोट निखल़ी।”</para>
  <para style="p" vid="1SA 12:5">तिन्‍नैं दैनअ ज़बाब, “हाँ, बिधाता आसा म्हारअ शाजत।”<verse eid="1SA 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 12:6" />शमूएलै बोलअ आजू इहअ, “सह थिअ बिधाता ई ज़ुंणीं मोसा अर हारण छ़ांटअ अर ज़ुंणीं थारै दाद-बाब मिसर देशे गलामी का आणै काढी। <verse eid="1SA 12:6" /><verse number="7" style="v" sid="1SA 12:7" />ऐबै रहा तम्हैं इधी बिधाता सेटा च़ुपच़ाप खल़्हुई, हुंह फरेऊं तम्हां का आद कि बिधाता थारै दाद-बाब अर तम्हां बच़ाऊंणा लै किहै-किहै महान काम किऐ।<verse eid="1SA 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 12:8" />“ज़धू याकब अर तेऊए टबर मिसर देशा लै डेऊऐ, बादा का हंतै तिंयां मिसरी खास्सै, थारै दादै-बाबै पाई बिधाता सेटा लेर-पकार अर तेऊ छ़ाडै मोसा अर हारण, तिन्‍नैं आणै तिंयां मिसर देशा का काढी संघा पजैल़ै एऊ देशै बस्सदै इधी। <verse eid="1SA 12:8" /><verse number="9" style="v" sid="1SA 12:9" />पर तिंयां गऐ तेतरी आपणैं परमेशर बिधाता बिस्सरुई! बिधाता दैनअ हसोर नगरीए सैनापति सिसरा, पलिश्ती अर मोआबे राज़ै तिन्‍नां संघै जुध करनै अर थारै दाद-बाब डेऊऐ तिन्‍नें गलामी दी। <verse eid="1SA 12:9" /><verse number="10" style="v" sid="1SA 12:10" />तेखअ हुअ तिन्‍नां पछ़ताअ संघा पाई बिधाता सेटा लेर-पकार, ‘हे बिधाता, हाम्हैं किअ पाप, हाम्हैं डेऊऐ ताह छ़ाडी कबाता संघा लागै बाल देअआ अर अशतरोत देबीए मुहुर्ती पूज़दै। ऐबै बच़ाऊ हाम्हां तूह म्हारै दुशमणा का अर ऐबै करनीं हाम्हां सिधी तेरी ई पूज़ा!’<verse eid="1SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 12:11" />“बिधाता छ़ाडअ जरूबाबेल, बदान, जपताह अर खिरी छ़ाडअ हुंह शमूएल। हाम्हैं सोभी छ़ड़ैऊऐ तम्हैं थारै दुशमणा का अर तै रहै तम्हैं फाज़त दी। <verse eid="1SA 12:11" /><verse number="12" style="v" sid="1SA 12:12" />पर ज़ांऊं तम्हां का इहअ शुझुअ कि अमोनी लोगे राज़ै नहाशै आसा तम्हां संघै जुध लाअ द छ़ेल़ी, थारअ परमेशर बिधाता थिअ थारअ राज़अ पर तज़ी बी बोलअ तम्हैं मुल्है इहअ, ‘नांईं, हाम्हां लोल़ी एक राज़अ ज़ुंण हाम्हां प्रैंदै राज़ करे!’<verse eid="1SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 12:13" />“इधी आसा भाल़ा ऐबै थारअ राज़अ ज़ुंण तम्हैं छ़ांटअ। तम्हैं किई ती एते मांग अर बिधाता दैनअ तम्हां प्रैंदै राज़अ बशैल़ी। <verse eid="1SA 12:13" /><verse number="14" style="v" sid="1SA 12:14" />ऐबै ज़ै तम्हैं आपणैं परमेशर बिधातो अदर करे, तेऊए च़ाकरी करे, तेऊए शुणें, तेऊए हुकम मने अर द्रोह नां करे। ज़ै तम्हैं अर थारअ राज़अ ज़िहअ सह बोले तिहअ करे, तै हणअ थारअ भलअ। <verse eid="1SA 12:14" /><verse number="15" style="v" sid="1SA 12:15" />पर ज़ै तम्हैं बिधाते नांईं शुणें अर तेऊए हुकम नांईं मने अर द्रोह नां करे, तै हणअ सह तम्हां अर थारै राज़े खलाफ ज़िहअ थारै दादा-बाबा लै बी हुअ। <verse eid="1SA 12:15" /><verse number="16" style="v" sid="1SA 12:16" />ऐबै रहा तम्हैं ज़िधी खल़ै आसा तिधी खल़्हुई, संघा भाल़ा तेऊ महान कामां ज़ुंण ऐबै बिधाता लाअ करी। <verse eid="1SA 12:16" /><verse number="17" style="v" sid="1SA 12:17" />ईंयां आसा ज़ेठा-शाहल़े धैल़ै, बोला आसा कि नांईं? लोग आसा नाज़ लऊंदै लागै दै। पर मंऐं लाई आझ़ बिधाता सेटा प्राथणां करी कि गुल़ूबिज़ल़ू संघै लोल़ी पाणींओ हर्हल-खर्हल रिंगअ। तेखअ जाणअ तम्हां का आपणीं आछी शुझुई अर समझ़ी कि बिधाता का आप्पू लै राज़अ मांगी किअ तम्हैं घोर पाप।”<verse eid="1SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 12:18" />शमूएलै किई बिधाता सेटा प्राथणां अर तैहा ई धैल़ी लागी गुल़ूबिज़ल़ूए ढिम्हां अर सरगा का रिंगअ पाणींओ हर्हल-खर्हल अर सोभी लोगा फिरी शमूएल अर बिधाता का डअर। <verse eid="1SA 12:18" /><verse number="19" style="v" sid="1SA 12:19" />तिंयां लागै शमूएला लै इहअ बोल्दै, “ज़ीबाण, हाम्हैं आसा तेरै दास, हाम्हां लै कर बिधाता सेटा प्राथणां ताकि हाम्हैं मरे नांईं। ऐबै हेरअ हाम्हैं ज़ाणीं कि सोभी पापा का बडअ पाप किअ हाम्हैं अह ई कि हाम्हैं मांगअ आप्पू लै राज़अ।”<verse eid="1SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 12:20" />तेखअ बोलअ शमूएलै तिन्‍नां लै इहअ, “तम्हैं पाप ता किअ एही खास्सअ, पर ऐबै निं तम्हैं बिधाता छ़ाडी कबाता डेऊई, तम्हैं रहै तत्त-दिला का तेऊए च़ाकरी लागी। <verse eid="1SA 12:20" /><verse number="21" style="v" sid="1SA 12:21" />बिधाता छ़ाडी होरी देअआ पूज़दै निं ऐबै लागी आथी ज़ेता करै कधू थारअ भलअ हुअ नां हणअ अर नां तिंयां तम्हां किज़ू का छ़ड़ैऊई सकदै। किल्हैकि तिंयां आसा बृथा। <verse eid="1SA 12:21" /><verse number="22" style="v" sid="1SA 12:22" />बिधाता आसा तम्हां लै कऊंलै बच़न दैनै दै, सह निं तम्हां शोटी डाहंदअ। तेऊ आसा तम्हैं आपणीं खास परज़ा बणाऐं दै।<verse eid="1SA 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 12:23" />“रही मेरी गल्‍ल, इहअ पाप निं मेरै भलै कधि लोल़ी हुअ कि हुंह तम्हां लै बिधाता सेटा प्राथणां करनी छ़ाडूं। पर मुंह रहणअ तम्हां का खोज़दै लागी कि तम्हां लै केऊ साबै ज़िन्दगी ज़िऊंणीं आसा भली। <verse eid="1SA 12:23" /><verse number="24" style="v" sid="1SA 12:24" />पर तम्हैं रहै बिधाते डरा हेठै संघा रहै शुचै मन्‍नैं तेऊए च़ाकरी लागी। अह गल्‍ल डाहणीं सदा आद कि तेऊ तम्हां लै किहै बडै-बडै काम किऐ। <verse eid="1SA 12:24" /><verse number="25" style="v" sid="1SA 12:25" />पर ज़ै तम्हैं पाप करदै रहे, तै हणैं तम्हैं हेरे थारै राज़ै संघी पठी खतम।”<verse eid="1SA 12:25" /></para>
  <chapter eid="1SA 12" />
  <chapter number="13" style="c" sid="1SA 13" />
  <para style="s">पैहली बारी ज़धू शाऊलै बिधातो हुकम निं मनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 13:1" />शाऊल गअ त तिहा साले अमरा राज़अ बणी अर सह रहअ इज़राईली प्रैंदै दूई साला <note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="fq" closed="false">दूई साला </char><char style="ft" closed="false">कई दी आसा 42 साला तैणीं</char></note>तैणीं राज़अ। <verse eid="1SA 13:1" /><verse number="2" style="v" sid="1SA 13:2" />शाऊलै छ़ांटै इज़राईली मणछा मांझ़ा का चअन हज़ार मणछ अर तिन्‍नां बाकी छ़ाडै तेऊ घअरा लै बापस। दूई हज़ार आदमीओ दल डाहअ तेऊ आप्पू संघै मिकमाश नगरी अर बेतेल धारा बाती अर बाकी एक हज़ार लोग छ़ाडै तेऊ आपणैं शोहरू जोनाताना संघै बिन्यामीन गोत्रे मुल्खै गिबा नगरी लै। <verse eid="1SA 13:2" /><verse number="3" style="v" sid="1SA 13:3" />जोनातान पल़अ गिबा नगरी पलिश्तीए च़ौकी दी चुटी, अर अह खबर गई हेरा-हेरी सारै पलिश्ती लोगा का पुजी! शाऊलै छ़ाडै सारै इब्रानी देशै आपणैं दूत तिन्‍नैं किऐ सारै दी नर्शिंगै बाज़ी लोगै झाल़ै संघा खोज़अ लोगा का पठी कि किज़ै हुअ। <verse eid="1SA 13:3" /><verse number="4" style="v" sid="1SA 13:4" />दूतै खोज़अ सोभी इज़राईली का इहअ, “गिबा नगरी किऐ शाऊलै पलिश्ती डेरै खतम। ऐबै ज़िधूऐ पलिश्ती इज़राईली लै होर बी खास्सै। शाऊलै शादै नगरी अर गराऊंआं का खास्सै मणछ संघा हुऐ सोभ गिलगाल कठा।”<verse eid="1SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 13:5" />पलिश्ती हुऐ इज़राईली संघै जुध करना लै कठा, तिंयां आऐ चअन हज़ार रथ, छ़ह हज़ार शुंआर अर पैदल हांढणै आल़ी सैना ती समुंदरे रेता ज़ेही खास्सी। तिन्‍नैं पाऐ बेताबेन पुर्बा बाखा मिकमाश डेरै। <verse eid="1SA 13:5" /><verse number="6" style="v" sid="1SA 13:6" />तेखअ गअ इज़राईली का ज़ाण्हुंई कि तिन्‍नें लोगा लै पल़ी ऐबै बडी आफ़त अर तिंयां निं ऐबै पलिश्ती का ज़िती सकदै! तेखअ लुक्‍कै सोभै इज़राईली जुहल़ी, कोई डुआरै, कोई लुक्‍कै घणैं कांडे झ़ाकल़ै, कोई रहै बडी-बडी टोल्हा जैंदरी अर कोई रहै खात्ती अर घोरी लुक्‍की। <verse eid="1SA 13:6" /><verse number="7" style="v" sid="1SA 13:7" />बाकी होर इब्रानी डेऊए जरदण नदी पार टपी गाद अर गलाद नाओंए ज़ैगा लै। शाऊल रहअ आप्पू गिलगाल ई अर तेऊए लोगा बी ती डरै काम्मणीं लागी दी। <verse eid="1SA 13:7" /><verse number="8" style="v" sid="1SA 13:8" />शाऊल रहअ तिधी साता धैल़ी तैणीं शमूएला न्हैल़अ लागी, ज़िहअ शमूएलै बोली त डाहअ द। पर शमूएल निं अज़ी बी गिलगाल पुजअ आथी त। तेखअ गअ शाऊला का ज़ाण्हुंई कि तेऊए आदमी लागै तेऊ का ओर्ही-पोर्ही खिस्सकदै! <verse eid="1SA 13:8" /><verse number="9" style="v" sid="1SA 13:9" />खिरी बोलअ शाऊलै तिन्‍नां लै, “तम्हैं आणा हूम बल़ी अर मेल़-ज़ोल़े बल़ीदान करना लै मुंह सेटा चैणैं!” शाऊलै काटअ तिधी हूम बल़ीदान करना लै एक पशू अर <verse eid="1SA 13:9" /><verse number="10" style="v" sid="1SA 13:10" />ज़ेतरी शाऊल तिधी हूम बल़ी करी मुक्‍कअ, शमूएल बी गअ तिधी पुजी। शाऊल डेऊअ तेऊ सेटा तेऊए ज़ैकार अर सुआगत करदअ, <verse eid="1SA 13:10" /><verse number="11" style="v" sid="1SA 13:11" />पर शमूएलै पुछ़अ शाऊला का, “लै तंऐं अह कै किअ?”</para>
  <para style="p" vid="1SA 13:11">शाऊलै दैनअ ज़बाब, “लोग लागै मुखा ओर्ही-पोर्ही खिस्सकदै अर ज़ेभै एछणा लै तंऐं बोलअ थिअ, तेभै निं तूह बी पुजअ! एसी आसा पलिश्ती हाम्हां संघै जुधा लै मिकमाश कठा हुऐ दै! <verse eid="1SA 13:11" /><verse number="12" style="v" sid="1SA 13:12" />तेखअ सोठअ मंऐं इहअ, ‘पलिश्ती आसा तेतरी गिलगाल पुजणैं आल़ै अर मंऐं निं अज़ी बिधाता का मज़त ई मांगी!’ एही करनअ निं हुंह च़ाहंदअ त पर तेखअ पल़अ मुंह ताह पुजणैं का आजी हूम बल़ीदान करनअ ई।”<verse eid="1SA 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 13:13" />शमूएलै दैनअ शाऊला लै ज़बाब, “अह किअ तंऐं बेघै ऐडअ काम, तंऐं निं बिधातो हुकम मनअ! तै रहणअ त इज़राईली प्रैंदै तेरी आद-लुआदो बी सदा राज़। <verse eid="1SA 13:13" /><verse number="14" style="v" sid="1SA 13:14" />पर ऐबै निं तेरअ राज़ खास्सअ रहणअ नां आजू तेरी आद-लुआदा मांझ़ै आजू राज़अ बणनअ। किल्हैकि तंऐं निं बिधातो हुकम मनअ। ऐबै हेरअ बिधाता ज़िहअ सह च़ाहा तिहअ मणछ छ़ांटी ज़ुंण ताह बाद इज़राईली प्रैंदै राज़अ हणअ।”<verse eid="1SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 13:15" />शमूएल लागअ तिधा का हांढदअ। बाकी लोग रहै शाऊला संघै कि तेऊए सैना दी ज़ुल़े। तिंयां डेऊऐ गिलगाला मुल्खा का बिन्यामीन मुल्खै गिबा नगरी। तिधी गणै शाऊलै आपणैं आदमी तिंयां थिऐ छ़ह शौ।<verse eid="1SA 13:15" /></para>
  <para style="s">शाऊले सैना हुअ कठण</para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 13:16" />शाऊल अर तेऊओ शोहरू जोनातान पाऐ आपणैं डेरै बिन्यामीन गोत्रे मुल्खै गिबा नगरी अर पलिश्ती तै मिकमाश आपणैं डेरै पाऐ दै। <verse eid="1SA 13:16" /><verse number="17" style="v" sid="1SA 13:17" />पलिश्तीए सैना निखल़ी आपणैं डेरै का इज़राईली संघै जुधा लै दल बणाईं। तिन्‍नों एक दल आअ उतर दिशा दी शूआल़ देशा लै ओफरा नगरी बाखा लै। <verse eid="1SA 13:17" /><verse number="18" style="v" sid="1SA 13:18" />दुजअ दल आअ बेथ-हारोन बाखे बाता अर चिऊथअ आअ पुर्बा दिशा दी सबोईम खागा दी रेगीस्ताना बाखा।<verse eid="1SA 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 13:19" />इज़राईली मांझ़ै निं सारै देशै लुहार भेटदअ त, किल्हैकि पलिश्ती निं तिन्‍नां लोहेओ काम शिखल़णै ई दैंदै तै! तिंयां बोला तै इहअ, “इना इब्रानी निं हाम्हां तलबार बर्छ़ै बणाणैं दैणअ।” <verse eid="1SA 13:19" /><verse number="20" style="v" sid="1SA 13:20" />इज़राईली पल़ा आपणैं हल़ा लै लुहाल़, कदाल़ी, दाच, खराल़ै अर बर्छ़ै साज़णा लै पलिश्ती सेटा डेऊणअ, <verse eid="1SA 13:20" /><verse number="21" style="v" sid="1SA 13:21" />अर पलिश्ती मांगा तै तिन्‍नां का खास्सी साज़-पल़ैई। खेचे खहल़े होछ़ै समान दाच-खराल़ै, च़िखल़ी कदाल़ी लै साज़ पल़ैई लागा ती च़ंदीए च़ुआन्‍नी अर बडै समाने साज़-पल़ैई लागा ती च़ंदीए ठान्‍नीं दैणीं। <verse eid="1SA 13:21" /><verse number="22" style="v" sid="1SA 13:22" />तैही निं जुधे धैल़ै शाऊल अर जोनाताना का सुआई तिन्‍नें होरी इज़राईली साथी का नां तलबारा आथी ती अर नां बर्छ़ै थिऐ।<verse eid="1SA 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 13:23" />पलिश्ती छ़ाडअ आपणीं सैनो दल मिकमाश कुआल़ी लै कि तैहा ज़ैगा तैणीं आपणअ कबज़अ बणाईं डाहे।<verse eid="1SA 13:23" /></para>
  <chapter eid="1SA 13" />
  <chapter number="14" style="c" sid="1SA 14" />
  <para style="s">जोनाताने ज़ीत अर शाऊले हठ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 14:1" />एकी धैल़ै बोलअ जोनातानै आपणैं अस्त्र-शस्त्रा ढोणै आल़ै एकी ज़ुआन मणछा लै इहअ, “च़ाल्‍ल हाम्हां डेऊणअ पार बाखा पलिश्ती सैने च़ौकी बाखा लै।” पर जोनातानै निं एता लै आपणअ बाब शाऊल पुछ़अ। <verse eid="1SA 14:1" /><verse number="2" style="v" sid="1SA 14:2" />तेभै तै शाऊलै गिबा नगरी नेल़ मिग्रोन नाओंए ज़ैगा नारदाणें बूटा हेठै आपणैं डेरै पाऐ दै अर तेऊ संघै तै कोई छ़ह शौ आदमी। <verse eid="1SA 14:2" /><verse number="3" style="v" sid="1SA 14:3" />आहीयाह प्रोहत बी थिअ तिन्‍नां संघै। तेऊ त बाछे सह खास सदरी बान्हीं दी। सह थिअ इकबोदे भाई आहीतूबो शोहरू। आहीतूब त पिनहासो शोहरू अर एली त तेऊओ दादू। एली थिअ शिलोह बिधातो प्रोहत। कोही का निं थोघ आथी त कि जोनातान गअ डेऊई।<verse eid="1SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 14:4" />मिकमाश कुआल़ी पुजणा लै लागणअ त जोनाताना पलिश्तीए सैने च़ौकी बाती तैहा बाता बाती उंधै होथणअ ज़िधी दोहरी बाखा बडी-बडी टोल्हे भिल़ी दी खल़ी कुआल़ी थिई। एकी टोल्हा नाअं त बसेस अर दुजी नाअं त सेने। <verse eid="1SA 14:4" /><verse number="5" style="v" sid="1SA 14:5" />एकी टोल्हो मोहरअ त उतरा बाखा मिकमाश बाखा अर दुजी टोल्हो मोहरअ त दखणा बाखा गिबा नगरी बाखा।<verse eid="1SA 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 14:6" />जोनातानै बोलअ तेऊ अस्त्र-शस्त्रा ढोणै आल़ै ज़ुआन आदमी लै, “च़ाल्‍ल हाम्हां डेऊणअ इना पलिश्तीए च़ौकी सेटा ज़ुंण खतैर निं करदै। हई सका कि बिधाता म्हारी मज़त करे, किल्हैकि इहअ निं किछ़ै आथी ज़ुंण बिधाता करी निं सकदअ। तेऊ निं जुध ज़ताऊणैं का कोहै रोक्‍की सकदअ च़ाऐ हाम्हैं खास्सै होए या बेघै थोल़ै आदमी।”<verse eid="1SA 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 14:7" />तेऊ ज़ुआन आदमी दैनअ ज़बाब, “ज़िहअ तेरअ दिल बोला तिहअ कर, हुंह आसा ताह संघै।”<verse eid="1SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 14:8" />जोनातानै बोलअ, “हाम्हां लागणअ पलिश्ती नदरी खागा पारा लै आजू हांढदै अर तिन्‍नैं लोल़ी हाम्हैं भाल़ै। <verse eid="1SA 14:8" /><verse number="9" style="v" sid="1SA 14:9" />पर ज़ै पलिश्तीए सपाही इहअ बोले, ‘ज़िधी आसा, इधी खल़्हिया, नांईं ता हाम्हैं निं तम्हां ज़िऊंदै गऐ छ़ाडी।’ तै रहणअ हाम्हां तिधी खल़्हुई ज़िधी तिंयां रोक्‍के। <verse eid="1SA 14:9" /><verse number="10" style="v" sid="1SA 14:10" />पर ज़ै तिंयां इहअ बोले, ‘उझै एछा इधी हाम्हां सेटा लै।’ तेखअ डेऊणअ हाम्हां उझै धारठी प्रैंदा लै किल्हैकि तिन्‍नों इहअ बोल़णअ हणअ बिधाता बाखा हाम्हां लै नछ़ैण कि बिधाता हेरनै हाम्हैं तिन्‍नां का ज़ताऊई।”<verse eid="1SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 14:11" />तेखअ लागै जोनातान अर तेऊ संघै सह ज़ुआन आदमी पलिश्ती नदरी हांढदै कि तिंयां भाल़ै। पलिश्ती बोलअ तिन्‍नां भाल़ी, “भाल़ा, इब्रानी निखल़ै तिन्‍नां आपणीं खोखा का बागै ज़ेथ तिंयां लुक्‍कै दै थिऐ!” <verse eid="1SA 14:11" /><verse number="12" style="v" sid="1SA 14:12" />तेखअ लाई तिन्‍नैं जोनातान अर अस्त्र-शस्त्रा ढोणै आल़ै तेऊ आदमी लै हाक्‍का, “उझै एछा इधी हाम्हां सेटा लै, हाम्हैं खोज़ूं तम्हां का सबक भाल़ै!”</para>
  <para style="p" vid="1SA 14:12">जोनातानै बोलअ आप्पू संघै तेऊ अस्त्र-शस्त्रा ढोणै आल़ै आदमी लै, “तूह रह मुंह पिछ़ू हांढदअ लागी, बिधाता हेरै इज़राईली इना पलिश्ती का ज़ताऊई।”<verse eid="1SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 14:13" />जोनातान उखल़अ च़ऊ पाओऐ तेऊ शाफल़ा बाती उझै अर तेऊओ साथी सह अस्त्र-शस्त्र ढोणै आल़अ आदमी बी उखल़अ तेऊ पिछ़ू। ज़ुंण पलिश्ती आजू का जोनाताना सम्हनै आऐ तेऊ पाऐ तिंयां मारी अर ज़ुण पलिश्ती पिछ़ू बाखा मारदै आऐ तिंयां पाऐ जोनाताने तेऊ ज़ुआन सपाही मारी। <verse eid="1SA 14:13" /><verse number="14" style="v" sid="1SA 14:14" />पैहलै जुधा दी पाऐ एकी शाहै तिन्‍नैं दुही ज़ण्हैं तैहा आधै बिघै ज़ैगा बिह पलिश्ती सपाही मारी। <verse eid="1SA 14:14" /><verse number="15" style="v" sid="1SA 14:15" />हेरा-हेरी झघाहुई सारी पलिश्ती सैना। ज़ुंण सैना डेरै दी थिई अर ज़ुंण सैना दहल़ै ती अर च़ौकी दी ओर्ही-पोर्ही पहरै दी थिई, तिन्‍नां सोभी पल़ी डअर अर झाख अर तिंयां डरै खास्सै।<verse eid="1SA 14:15" /></para>
  <para style="s">इज़राईली ज़ितै पलिश्ती का</para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 14:16" />शाऊले आदमी लागै बिन्यामीन मुल्खे गिबा नगरी का भाल़ै कि पलिश्ती जैंदरी आसा झघाह पल़अ द अर तिन्‍नां आसा ओर्ही-पोर्ही ठुर्हा लागी दी। <verse eid="1SA 14:16" /><verse number="17" style="v" sid="1SA 14:17" />तेखअ बोलअ शाऊलै आपणैं आदमी लै, “सोभी लोगा दैआ गणनी, संघा करा थोघ कि हाम्हां जैंदरी कुंण निं आथी।” तिन्‍नैं गणै सोभ अर भाल़अ कि जोनातान अर तेऊ संघै अस्त्र-शास्त्रा ढोणै आल़अ सह ज़ुआन मणछ, तिंयां दूई ज़ण्हैं निं आथी। <verse eid="1SA 14:17" /><verse number="18" style="v" sid="1SA 14:18" />शाऊलै बोलअ आहीयाह प्रोहता लै, “बिधाते करारो मणशू आणा ओर्ही।<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">ताकि हाम्हां का थोघ लागे कि किज़ै आसा हंदअ लागअ द</char></note>” तधू काल्‍ला त बिधाते करारो मणशू इज़राईली संघै। <verse eid="1SA 14:18" /><verse number="19" style="v" sid="1SA 14:19" />शाऊल त प्रोहता संघै गल्‍ला लागअ ई द कि पलिश्तीए दला दी पल़अ होर बी खास्सअ झघाह अर शाऊलै बोलअ प्रोहता लै, “ऐबै दै बिधाता पुछ़णै रहणैं, ऐबै दै एता हणैं।”<verse eid="1SA 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 14:20" />तेखअ डेऊऐ शाऊल अर तेऊए आदमी पलिश्ती संघै जुधा लै। तिन्‍नां का शुझुअ इहअ कि पलिश्ती जैंदरी त इहअ झघाह पल़अ द कि तिंयां थिऐ आप्पू ई मांझ़ै एकी-दुजै मारदै लागै दै। <verse eid="1SA 14:20" /><verse number="21" style="v" sid="1SA 14:21" />ज़ुंण इब्रानी पैहलै पलिश्ती संघै तै मिलै दै, तिंयां बी फिरै जोनातान, शाऊल अर होरी इज़राईली बाखा। <verse eid="1SA 14:21" /><verse number="22" style="v" sid="1SA 14:22" />कई इज़राईली ज़ुंण एप्रैम गोत्रे धारा बाखे मुल्खै लुक्‍की तै रहै दै, ज़ांऊं तिन्‍नैं ईंयां गल्‍ला शूणीं कि पलिश्ती ठुर्है पिछ़ू, तेखअ आऐ तिंयां होरी इज़राईली संघै जुधा लै संघा ठुर्है पलिश्ती दरल़ाऊंदै। <verse eid="1SA 14:22" /><verse number="23" style="v" sid="1SA 14:23" />तिंयां पुजै तिन्‍नां च़िक्‍कदी मारदी-मारदी बेताबेन नगरी पोर्ही बाखा तैणीं अर इहअ करै दैनी बिधाता इज़राईली लै बडी ज़ीत।<verse eid="1SA 14:23" /></para>
  <para style="s">जुध ज़ितणैं का बाद खाण-पींण</para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 14:24" />इज़राईली आदमीए तै तैहा धैल़ी नीर ढल़ै दै, किल्हैकि शाऊलै तै तिन्‍नां का इहै सोह बझ़ैल़ै दै काढणैं, “तेऊ मणछा लै आसा फिटक ज़ुंण आझ़ मेरै दुशमणा का बदल़अ लणैं का आजी खाए-पिए।” तैही निं तिन्‍नैं सारी धैल़ी रोटी खाई आथी। <verse eid="1SA 14:24" /><verse number="25" style="v" sid="1SA 14:25" />तिंयां पुजै एकी बणैं, तिधी भेटी तिन्‍नां खास्सी मखीरे काशणीं, <verse eid="1SA 14:25" /><verse number="26" style="v" sid="1SA 14:26" />डाल़ा-बूटा का भाल़ै तिन्‍नैं कि मखीर आसा उंधै निटरदअ लागअ द पर तिन्‍नैं निं सह च़ाखअ बी आथी किल्हैकि तिन्‍नां का तै शाऊलै सोह खैऊऐ दै। <verse eid="1SA 14:26" /><verse number="27" style="v" sid="1SA 14:27" />पर जोनाताना का निं थोघ आथी त कि शाऊलै आसा सोभी का सोह खैऊऐ दै! तेऊ बिन्हीं आपणीं शोठी करै माहूँए काशण संघा खाअ तेता का धख मखीर अर तैबै जाई फिरै तेऊ तराण। <verse eid="1SA 14:27" /><verse number="28" style="v" sid="1SA 14:28" />तेथ बोलअ कुंणी तेऊ लै इहअ, “हाम्हैं सोभै आसा भुखै मरी च़ाल्‍लै दै, पर तेरै बाबै आसा हाम्हां का इहै सोह खैऊऐ दै, ‘तेऊ मणछा लागणअ फिटक ज़ुंण आझ़ खाए-पिए।’”<verse eid="1SA 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 14:29" />जोनातानै दैनअ ज़बाब, “अह भाल़ मेरै बाबै हाम्हां सोभी लै केही आफ़त डाही पाई! भाल़ा, मंऐं च़ाखअ धख ज़िहअ मखीर अर तेता करै तैबै जाई फिरै मुंह तराण। <verse eid="1SA 14:29" /><verse number="30" style="v" sid="1SA 14:30" />ज़ै सोभी लै दुशमणा का लुटी दी च़िज़ा मन्‍न-मरज़ी दी खाणें ज़ाज़त दैनी हंदी, तै सोठा एचल़ी कि हाम्हां होर बी केतरै खास्सै पलिश्ती मारनै तै!”<verse eid="1SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 14:31" />तधू रहै तिंयां सारी धैल़ी पलिश्ती पिछ़ू पल़ी मिकमाश नगरी पोर्ही अजालोन नगरी तैणीं मारदै लागी अर इहअ करै थकै तिंयां खास्सै, तिन्‍नां ती भुखै आई दी <verse eid="1SA 14:31" /><verse number="32" style="v" sid="1SA 14:32" />अर तेखअ पल़ै तिंयां दुशमणा का लुटी दी भेडा-बाकरी, गाऊई-बल्द अर बाछ़ूए हेल़्ही लै चुटी। तिन्‍नैं काटै तिधी कई पशू संघा लागै लोधल़ै संघी शिखा खांदै।<verse eid="1SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 14:33" />ईंयां गल्‍ला हेरी कुंणी शाऊला का खोज़ी, “भाल़णैं दै, लोग लागै बिधाते खलाफ लोधल़ै संघी शिखा खाई पाप करदै।”</para>
  <para style="p" vid="1SA 14:33">शाऊलै पाई ज़ोरै लैल़, “अह शोटअ नर्थ करी आरो, बडअ पचैथर लोल़ा संघा आणा तेता बदल़ी करै इधा लै।”<verse eid="1SA 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 14:34" />तेखअ किअ शाऊलै इहअ हुकम, “पोर्ही दैआ लोगा जैंदरी फेरी संघा बोला तिन्‍नां लै इहअ, ‘आपणैं-आपणैं बल्द अर भेडा आणा ओर्ही इधी मुंह सेटा लै। काटी काढा तेतो लोधल़अ पठी पोर्ही तेखअ लागा खांदै। लोधल़ै संघी शिखा खाई निं बिधाता लै पाप करा।’” तेखअ आणै तिन्‍नैं तैहा बैल़ी आपणैं डागै-चैणैं शाऊला सेटा लै संघा काटै तिधी। <verse eid="1SA 14:34" /><verse number="35" style="v" sid="1SA 14:35" />तिधी बणाईं शाऊलै बिधाता लै एक बेदी। अह किअ तेऊ पैहली बारी कि बिधाता लै बणाईं तेऊ बेदी।<verse eid="1SA 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 14:36" />तेखअ बोलअ शाऊलै आपणैं आदमी लै इहअ, “उंधै च़ाल्‍ला हाम्हां पल़णअ आझ़ राची ई पलिश्ती मारदै चुटी, हाम्हां रहणअ राच भैणै तैणीं तिन्‍नां लुटदै लागी अर तिंयां करनै हाम्हां सोभ मारी खतम।”</para>
  <para style="p" vid="1SA 14:36">तिन्‍नैं दैनअ ज़बाब, “ज़िहअ तेरअ दिल बोला तिहअ कर।”</para>
  <para style="p" vid="1SA 14:36">पर प्रोहतै बोलअ, “धिरअ हआ, बिधाता लऊंमै पुछ़ी।”<verse eid="1SA 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1SA 14:37" />शाऊल लागअ बिधाता का पुछ़दअ, “पलिश्ती मारदै डेऊणे ज़ाज़त आसा कि नांईं? ताह हाम्हैं इज़राईली ज़ताऊणैं कि नांईं?” पर बिधाता निं तैहा धैल़ी किछ़ै ज़बाब दैनअ। <verse eid="1SA 14:37" /><verse number="38" style="v" sid="1SA 14:38" />तेखअ बोलअ शाऊलै परज़ा मांझ़ै सैणैं मणछा लै, “तम्हैं सोभै एछा ओर्ही संघा ज़ाच़ा-भाल़ा कि आझ़ किहअ पाप हुअ। <verse eid="1SA 14:38" /><verse number="39" style="v" sid="1SA 14:39" />ज़ुंण ज़िऊंदअ बिधाता इज़राईला ज़ताऊंदी आअ, मंऐं खाऐ तेऊ बिधाते नाओंऐं सोह कि ज़ुंणी अह पाप किअ सह निं मुंह ज़िऊंदअ डाहणअ, च़ाऐ सह मेरअ शोहरू जोनातान ई किल्है निं होए।” पर तिन्‍नां मांझ़ै निं कोही दांदा बागै एक बैण बी बोलअ। <verse eid="1SA 14:39" /><verse number="40" style="v" sid="1SA 14:40" />तेखअ बोलअ शाऊलै तिधी सोभी इज़राईली लै, “तम्हैं सोभै खल्हिआ पार एकी बाखा अर हुंह अर जोनातान खल़्हूं इधी ओर्ही बाखा।”</para>
  <para style="p" vid="1SA 14:40">तिन्‍नैं दैनअ ज़बाब, “ज़िहअ तेरअ दिल बोला तिहअ कर।”<verse eid="1SA 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 14:41" />शाऊलै बोलअ इज़राईले परमेशर बिधाता लै, “हे बिधाता, तंऐं आझ़ मुल्है ज़बाब किल्है निं दैनअ? बिधाता, इज़राईले परमेशर आझ़ खोज़ हाम्हां का कि कुंण आसा दोशी अर कुंण आसा नर्दोश। तेखअ बाही तिन्‍नैं प्रशण<note caller="+" style="f"><char style="fr" closed="false">14:41 </char><char style="fq" closed="false">प्रशण </char><char style="ft" closed="false">ऊरीम अर तूरीम</char></note> अर तेथ निखल़अ जोनातान अर शाऊलो दोश अर बाकी सारी परज़ा निखल़ी नर्दोश।”<verse eid="1SA 14:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1SA 14:42" />तेखअ बोलअ शाऊलै, “मुंह अर जोनाताना मांझ़ै भाल़ा प्रशण पाई कुंण आसा दोशी।” तेथ निखल़अ जोनातानो दोश। <verse eid="1SA 14:42" /><verse number="43" style="v" sid="1SA 14:43" />तेखअ पुछ़अ शाऊलै जोनातान, “तूह खोज़ मुखा तंऐं किज़ै किअ?”</para>
  <para style="p" vid="1SA 14:43">जोनातानै दैनअ ज़बाब, “मंऐं खाअ धख ज़िहअ मखीर, सह काढअ मंऐं आपणैं हाथे शोठिए च़ुंडी करै धख ज़िहअ, तूह कै बोला तेता पिछ़ू हुंह मारी लाअ!”<verse eid="1SA 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1SA 14:44" />शाऊलै बोलअ तेऊ लै, “जोनातान, ताह हुअ मरनअ! बिधाता लोल़ी त तै हुंह ई मारअ ज़ै हुंह ताह निं मारूं!”<verse eid="1SA 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 14:45" />पर लोगै बोलअ शाऊला लै, “जोनातानै दैनी इज़राईला लै महान ज़ीत, अह कै ऐबै मारनअ? इहअ निं हाम्हैं हणैं दैंदै, हाम्हैं खाआ ज़िऊंदै परमेशर बिधाते सोह कि एऊ निं हाम्हैं पेऊश बी दैंदै लागणै किल्हैकि परमेशरै किई आझ़ तेऊए मज़त!” इहअ करै निं तिधी तिन्‍नैं सोभी लोगै जोनाताना मारनै दैनअ।<verse eid="1SA 14:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1SA 14:46" />तेखअ पाई शाऊलै पलिश्ती लोगे पिछ़ै करने छ़ाड संघा डेऊऐ तिंयां सोभै आपणैं-आपणैं मुल्ख आपणैं घअरा लै।<verse eid="1SA 14:46" /></para>
  <para style="s">शाऊलो मुल्ख अर तेऊओ खिंब</para>
  <para style="p">
    <verse number="47" style="v" sid="1SA 14:47" />आपणअ राज़ मज़बूत करनै बाद किअ शाऊलै इज़राईली फेर बस्सै दै सोभी दुशमणो मकाबलअ। तेऊ किअ मोआब, अमोन, एदोम, सोबा नगरीए राज़ै अर पलिश्ती लोगा संघै जुध। ज़िधी बी सह लल़अ तिधी भेटी तेऊ ज़ीत। <verse eid="1SA 14:47" /><verse number="48" style="v" sid="1SA 14:48" />घोर जुध लल़ी ज़ितअ सह अमोलकी लोगा का अर ज़ुंण इज़राईली लुटदै तै लागै दै तेऊ बच़ाऊऐ इज़राईली तिन्‍नां का।<verse eid="1SA 14:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1SA 14:49" />शाऊले तै चअन शोहरू जोनातान, ईशबी अर मोलकीशूआ। दूई ती तेऊए शोहरी, ज़ेठी नाअं थिअ मिराब अर कान्हीं नाअं आसा मिकल। <verse eid="1SA 14:49" /><verse number="50" style="v" sid="1SA 14:50" />शाऊले लाल़ी नाअं त आहीनोम अर सह थिई आहीमासे शोहरी। शाऊले सैनापति नाअं त अबनेर अर सह थिअ शाऊले च़ाच़ू नेरीओ शोहरू। <verse eid="1SA 14:50" /><verse number="51" style="v" sid="1SA 14:51" />शाऊले बाबा नाअं त कीश। अबनेरो बाब नेरी थिअ एबीएलो शोहरू।<verse eid="1SA 14:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1SA 14:52" />शाऊल रहअ आपणीं सारी ज़िन्दगी पलिश्ती संघै जुधा करदअ लागी। शाऊला का ज़ेभै बी इज़राईली मांझ़ै कहा शूरबीर मणछो थोघ लागअ त, सह डाहा त तेऊ आपणीं सैना दी।<verse eid="1SA 14:52" /></para>
  <chapter eid="1SA 14" />
  <chapter number="15" style="c" sid="1SA 15" />
  <para style="s">अमोलकी संघै जुध</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 15:1" />शमूएल गूरै बोलअ एकी धैल़ै शाऊला लै, “सह आसा हुंह ई ज़ुंण बिधाता इज़राईलीओ राज़अ बणाणां लै तेरअ अभिषेक करदअ ताह सेटा लै छ़ाडअ त। ऐबै शुण तूह कि बिधाता किज़ै बोला। <verse eid="1SA 15:1" /><verse number="2" style="v" sid="1SA 15:2" />स्वर्गे सारी सैने मालक बिधाता बोला इहअ, ‘मुंह आसा आद, ज़धू इज़राईली मिसर देशा का निखल़ी एछदै तै लागै दै, तधू रोक्‍कै तै बाता तिंयां अमोलकी संघा छ़ेल़अ त तिन्‍नैं इज़राईली संघै जुध। <verse eid="1SA 15:2" /><verse number="3" style="v" sid="1SA 15:3" />ऐबै डेऊ संघा पल़ अमोलकी मारदअ चुटी! तिन्‍नां अर तिन्‍नें ज़ैदात करै पठी खतम अर तिन्‍नां लै निं धख झींण बी करी। तिन्‍नां मांझ़ै निं मर्ध-बेटल़ी, च़ूई झुटदै लान्हैं, ऊँट, गाधै, गाऊई-बल्द अर भेडा-बाकरी मांझ़ै किछ़ बी ज़िऊंदै छ़ाडी।’”<verse eid="1SA 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 15:4" />शाऊलै दैनअ दूत छ़ाडी सारै दी समाद संघा किई सारी सैना तलीम नगरी कठा। इज़राईला का आऐ दूई लाख अर यहूदा गोत्रा का आऐ दस हज़ार सपाही। <verse eid="1SA 15:4" /><verse number="5" style="v" sid="1SA 15:5" />तेखअ छ़ाडै शाऊलै आपणैं धख आदमी अमोलकी लोगे नगरी नेल़ खागा लै संघा रहै तिंयां तिधी लुक्‍की करै ताखुई। <verse eid="1SA 15:5" /><verse number="6" style="v" sid="1SA 15:6" />तेथ नेल़ रहा तै कैनी लोग बी, इज़राईलीए मिसर देशा का एछदी किई ती कैनी लोगै इज़राईलीए झींण तिन्‍नां लै दैनअ शाऊलै इहअ समाद, “तम्हैं निखल़ा अमोलकी लोगा जैंदरा का पोर्ही, इहअ निं हआ कि तिन्‍नां संघै तम्हैं बी मरे।” तेखअ डेऊऐ कैनी अमोलकी जैंदरा का दूर।<verse eid="1SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 15:7" />तेखअ पल़ै शाऊल अर तेऊए सैना अमोलकी मारदै चुटी, तिंयां डेऊऐ हबीला नगरी पोर्ही तिन्‍नां मारदी-मारदी मिसर देशे पुर्बा बाखे सिऊंआं सूर नगरी तैणीं। <verse eid="1SA 15:7" /><verse number="8" style="v" sid="1SA 15:8" />तिन्‍नैं ढाकअ अमोलकीओ राज़अ आगाग ज़िऊंदअ अर होर पाऐ सोभ लोग मारी। <verse eid="1SA 15:8" /><verse number="9" style="v" sid="1SA 15:9" />पर शाऊल अर तेऊए सैना निं आगाग मारअ अर हेल़्ही मांझ़ै राम्बल़ै-राम्बल़ै डागै-भेडा, गाऊई-बल्द गाभू-छ़ेल्हू बी डाहै तिन्‍नैं ज़िऊंदै। शाऊल अर तेऊ सैना का ज़ुंण च़िज़ा राम्बल़ी किम्मती शुझुई तिंयां डाही तिन्‍नैं बच़ाऊई अर ज़ुण तिन्‍नां का कज़ेही शुझुई, तिंयां किई तिन्‍नैं पठी बरैबाद।<verse eid="1SA 15:9" /></para>
  <para style="s">शाऊल निं राज़ै जोगी रहअ</para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 15:10" />बिधाता बोलअ शमूएल गूरा लै, <verse eid="1SA 15:10" /><verse number="11" style="v" sid="1SA 15:11" />“मुंह हुई ऐहा गल्‍ले खास्सी माल़ी कि मंऐं बणाअं शाऊल राज़अ, ज़िहअ हुंह बोला, सह निं तिहअ शुणदअ आथी!” शमूएला आई रोश्शै, सह रहअ सारी राची बिधाता सेटा अरज़ करदअ लागी। <verse eid="1SA 15:11" /><verse number="12" style="v" sid="1SA 15:12" />दुजै धैल़ै दोत्ती डेऊअ शमूएल शाऊला सेटा लै मिलदअ, पर शमूएला का खोज़अ कुंणी इहअ, “शाऊल डेऊअ त कर्मेल नगरी लै अर तिधी किअ तेऊ एक बडअ डौंड खल़अ कि लोग तेऊ आद करे, तेता बाद डेऊअ सह तिधा का गिलगाल।”<verse eid="1SA 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 15:13" />खिरी भेटअ शमूएला शाऊल अर तेऊ किअ शमूएलो इहअ बोली सुआगत, “ताल्है लोल़ी बिधाता का खास्सी बर्गत हुई! मंऐं किई सोभै गल्‍ला तेही ई पूरी ज़िहअ बिधाता हुकम किअ त।”<verse eid="1SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 15:14" />शमूएलै पुछ़अ, “तै किल्है आसा मुखा हेल़्ही दी गाभू-छ़ेल्हू बाशदै अर गाऊई-बल्द गल़ंगा लांदै शुण्हदै लागै दै?”<verse eid="1SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 15:15" />शाऊलै दैनअ ज़बाब, “ईंयां आणै म्हारी सैना अमोलकी लोगे। तिन्‍नैं डाहै हेल़्ही मांझ़ा का राम्बल़ै-राम्बल़ै डागै-चैणैं एही ज़िऊंदै कि तेरै परमेशर बिधाता लै बल़ीदान करे अर इना का लाऊआ किऐ हाम्हैं पठी बरैबाद।”<verse eid="1SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 15:16" />शमूएलै बोलअ शाऊला लै, “च़ुप्पी रह, ऐबै निं तूह बोलै। ऐबै दै मुंह खोज़णैं कि बिधाता हिझ़ राची मुखा किज़ै खोज़अ।”</para>
  <para style="p" vid="1SA 15:16">शाऊलै बोलअ, “ओर्ही खोज़ किज़ै बोलअ बिधाता।”<verse eid="1SA 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 15:17" />शमूएलै दैनअ ज़बाब, “सह बी त एक बगत कि तूह सोठा त आप्पू लै कि तूह निं किछ़ू कामों आथी! पर तज़ी बणाअं तूह सोभी इज़राईली गोत्रा प्रैंदै प्रधान अर बिधाता किअ तेरअ इज़राईलीओ राज़अ हणां लै अभिषेक। <verse eid="1SA 15:17" /><verse number="18" style="v" sid="1SA 15:18" />बिधाता छ़ाडअ त तूह कि एक खास काम पूरअ करे कि तिन्‍नां पापी अमोलकी करै पठी बरैबाद। तेऊ बोलअ त ताल्है कि ज़ेभै तैणीं तिंयां पठी खतम निं होए तेता आजी निं जुध रोक्‍की आथी। <verse eid="1SA 15:18" /><verse number="19" style="v" sid="1SA 15:19" />तंऐं बिधातो अह हुकम किल्है निं तिहअ ई मनअ? तम्हैं किल्है उझ़ुऐ लुटदै-घशिट्टदै ज़ेता करै तम्हैं बिधाता लै रोश्श आणी?”<verse eid="1SA 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 15:20" />शाऊलै बोलअ शमूएल गूरा लै, “बिधाता ज़िहअ हुकम किअ मंऐं किअ तिहअ ई। ज़िधा लै तेऊ बोलअ हुंह डेऊअ तिधा लै संघा आणअ सोभी अमोलकी लोगा मारी तिन्‍नों राज़अ आगाग कैद करी इधा लै। <verse eid="1SA 15:20" /><verse number="21" style="v" sid="1SA 15:21" />रही डागै-चैणें गल्‍ल, तिंयां हणैं तै पठी बरैबाद, पर मेरी सैना आणै हेल़्ही मांझ़ै राम्बल़ै-राम्बल़ै छ़ांटी करै बच़ाऊई कि गिलगाल पुजी तेरै परमेशर बिधाता लै तिन्‍नों बल़ीदान करे।”<verse eid="1SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 15:22" />शमूएलै बोलअ शाऊला लै,</para>
  <para style="q" vid="1SA 15:22">“कैहा गल्‍ला करै हआ बिधाता खुश?</para>
  <para style="q" vid="1SA 15:22">हूम बल़ी अर मेल़-ज़ोल़े बल़ीदाना करै,</para>
  <para style="q" vid="1SA 15:22">कि बिधाता ज़िहअ बोले तिहअ करनै करै हआ खुश?</para>
  <para style="q" vid="1SA 15:22">ऐबै शुण! बिधातो शुणनअ अर तिहअ ई पूरअ करनअ हआ</para>
  <para style="q" vid="1SA 15:22">बल़ीदान करनै अर गाभूए च़र्बी भैंट करनै का बी खास्सअ बधिया।<verse eid="1SA 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1SA 15:23" />बिधातो बरोध करनअ अर मणशाण पुछ़दै</para>
  <para style="q" vid="1SA 15:23">डेऊणअ आसा दुहै पाप एक्‍कै ज़िहै,</para>
  <para style="q" vid="1SA 15:23">बिधाता संघै हठ करनी आसा मुहुर्ती पूज़णै ज़िहअ पाप।</para>
  <para style="q" vid="1SA 15:23">ज़ुंण बिधाता बोलअ, सह हुकम समझ़अ तंऐं बृथा,</para>
  <para style="q" vid="1SA 15:23">ऐबै समझ़अ तेऊ तूह बी बृथा कि</para>
  <para style="q" vid="1SA 15:23">तूह निं ऐबै आजू राज़ै जोगी आथी।”<verse eid="1SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 15:24" />इहअ शूणीं बोलअ शाऊलै शमूएल गूरा का, “ऐबै गअ मुखा ज़ाण्हुंई, मंऐं किअ पाप। मंऐं निं बिधातो हुकम पूरअ किअ अर नां तेरी चतैनगी आद डाही। मुंह ती सैने डअर तैही किअ मंऐं ज़िहअ तिन्‍नैं बोलअ तिहअ। <verse eid="1SA 15:24" /><verse number="25" style="v" sid="1SA 15:25" />पर ऐबै आसा मेरी ताखा हाथ ज़ोल़ी अरज़, मेरै पाप कर माफ संघा च़ाल्‍ल मुंह संघै फिरी कि हुंह बिधाता सेटा माथअ टेक्‍की सकूं।”<verse eid="1SA 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 15:26" />पर शमूएलै दैनअ शाऊला लै ज़बाब, “हुंह निं ताह संघै फिरी डेऊंदअ, किल्हैकि ज़ुंण बिधाता बोलअ, सह हुकम समझ़अ तंऐं बृथा! बिधाता किअ ऐबै तूह बृथा कि तूह निं ऐबै आजू इज़राईलीओ राज़अ हणैं जोगी आथी।”<verse eid="1SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 15:27" />ज़िहअ ई शमूएल डेऊंणा लै पिछ़ू फिरअ, शाऊलै ढाकअ पिछ़ू का तेऊए च़ोल़ैओ पाल्‍लअ अर सह धेल़्हुअ। <verse eid="1SA 15:27" /><verse number="28" style="v" sid="1SA 15:28" />शमूएलै बोलअ तेऊ लै, “आझ़ काढअ बिधाता इज़राईलो राज़ धेल़ी करै ताखा दूर संघा दैनअ तेरै साथी-संघी लै ज़ुंण ताखा राम्बल़अ आसा। <verse eid="1SA 15:28" /><verse number="29" style="v" sid="1SA 15:29" />इज़राईला लै प्रतप्प दैणैं आल़अ बिधाता नां झ़ुठअ बोल्दअ नां सह आपणीं गल्‍ल बदल़दअ अर नां सह मणछ आथी कि बादा का पचताए।”<verse eid="1SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 15:30" />शाऊलै दैनअ ज़बाब, “हुंह ज़ाणा कि मंऐं किअ पाप, पर मेरी इज़राईली परज़ा अर तिन्‍नें सैणैं नदरी ता कर मेरअ धख अदर। तूह च़ाल्‍ल मुंह संघै फिरी ताकि हुंह बिधाता सेटा माथअ टेक्‍की सकूं।” <verse eid="1SA 15:30" /><verse number="31" style="v" sid="1SA 15:31" />तेखअ डेऊअ शमूएल शाऊला संघै अर शाऊलै टेक्‍कअ बिधाता सेटा डेऊई माथअ।<verse eid="1SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 15:32" />तेखअ बोलअ शमूएलै इहअ, “अमोलकी लोगै राज़ै आगागा आणा ओर्ही मुंह सेटा लै।” तिन्‍नैं आणअ आगाग शमूएला सेटा लै। आगाग हुअ दिलै खुश अर सह लागअ इहअ सोठदअ, “ऐबै गई मौत मुखा टल़ी अर हुंह हेरनअ इना ज़िऊंदअ छ़ाडी।” <verse eid="1SA 15:32" /><verse number="33" style="v" sid="1SA 15:33" />शमूएलै बोलअ इहअ, “ज़िहै तंऐं आपणीं तलबारा करै कई माए अत्री किई तेही ई हणीं तेरी माए बी अत्री।” शमूएलै किऐ गिलगाल बिधाता सम्हनै अमोलकी राज़ै आगागे काटी ठोर-ठोर।<verse eid="1SA 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 15:34" />तेखअ डेऊअ शमूएल रामाह नगरी लै अर राज़अ शाऊल डेऊअ गिबा नगरी आपणैं घअरा लै। <verse eid="1SA 15:34" /><verse number="35" style="v" sid="1SA 15:35" />तधा बाद निं शमूएल आपणीं ज़िऊंदी ज़िता शाऊल का कधि मिलदअ आअ। पर सह रहअ शाऊला लै हिक्‍का पटाक्‍की शोग मनाऊंदअ लागी। बिधाता बी फिरी तेखअ माल़ी कि तेऊ बणाअं शाऊल इज़राईली प्रैंदै राज़अ।<verse eid="1SA 15:35" /></para>
  <chapter eid="1SA 15" />
  <chapter number="16" style="c" sid="1SA 16" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 16:1" />बिधाता बोलअ तेखअ शमूएला लै इहअ, “ताह कधू तैणीं रहणअ शाऊले तैणीं हिक्‍का पटाक्‍कदै लागी? हुंह निं च़ाहंदअ कि शाऊल आजू इज़राईलीओ राज़अ रहे! शींगा दी निंऊं जैतूनो तेल भरी संघा डेऊ बेतलेम नगरी ईशैई नाओंए मणछा सेटा, किल्हैकि तेऊए शोहरू मांझ़ै आसा मंऐं एक ज़ण्हअ इज़राईलीओ राज़अ लाअ द बणाईं।”<verse eid="1SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 16:2" />शमूएलै बोलअ इहअ, “मेरै भलै किधी च़ाल्‍लअ इहअ हई, ज़ै शाऊला का थोघ लागे, तेऊ पाणअ हुंह मारी!”</para>
  <para style="p" vid="1SA 16:2">बिधाता बोलअ शमूएला लै, “तूह निंयैं आप्पू संघै एक बाछ़ू संघै बोलै इहअ, ‘हुंह आसा बिधाता लै हूम करदअ आअ द।’ <verse eid="1SA 16:2" /><verse number="3" style="v" sid="1SA 16:3" />हूमा लै करै ईशैई लै बी छ़ांदअ अर तेखअ खोज़ूं हुंह कि ताह किज़ै करनअ। ज़हा हुंह खोज़ूं तूह करै मुंह बाखा तेऊओ राज़ै हणां लै अभिषेक।”<verse eid="1SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 16:4" />शमूएलै किअ ज़िहअ बिधाता बोलअ त तिहअ ई। सह डेऊअ बेतलेम नगरी लै, नगरीए सैणैं आऐ डरदी-काम्बदी तेऊ सेटा लै संघा पुछ़अ इहअ, “तूह राज्ज़ी-खुशी दी आअ कि किज़ै होर गल्‍ल आसा?”<verse eid="1SA 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 16:5" />शमूएलै दैनअ ज़बाब, “हुंह आअ बिधाता लै राज्ज़ी-खुशी दी हूमा करदअ, तम्हैं सोभै करा आप्पू शुचै संघा एछा मुंह संघै हूमा लै।” शमूएलै दैनअ ईशैई अर तेऊए शोहरू लै बी छ़ांदअ कि शुचै हई एछा हूमा लै।<verse eid="1SA 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 16:6" />ज़ांऊं ईशैई अर तेऊए शोहरू आऐ, शमूएले सोठअ तेऊए शोहरू एलीआबा लै, “अह ज़ुंण मणछ इधी आसा खल़्हुअ द, बिधाता हणअ अह ई छ़ांटअ द।” <verse eid="1SA 16:6" /><verse number="7" style="v" sid="1SA 16:7" />पर बिधाता बोलअ शमूएला लै, “तूह निं इहअ भाल़अ लागै कि अह आसा हेरनअ बित्तअ अर खास्सअ लाम्मअ। मंऐं अह आथी छ़ांटअ द किल्हैकि हुंह निं तेऊ साबै भाल़दअ ज़िहै मणछ भाल़ा। मणछ भाल़ा बाघलअ रूप पर हुंह भाल़ा मणछो दिल कि सह किहअ आसा।”<verse eid="1SA 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 16:8" />ईशैई शादअ आपणअ शोहरू अबीनादाब संघा छ़ाडअ सह शमूएला सेटा। शमूएलै बोलअ, “बिधाता निं अह बी छ़ांटअ आथी।” <verse eid="1SA 16:8" /><verse number="9" style="v" sid="1SA 16:9" />तेखअ शादअ ईशैई आपणअ शोहरू शमाह। शमूएलै बोलअ, “अह बी निं बिधाता छ़ांटअ आथी।” <verse eid="1SA 16:9" /><verse number="10" style="v" sid="1SA 16:10" />इहअ करै छ़ाडै ईशैई आपणैं सात शोहरू बारी-बारी शमूएला सेटा, पर शमूएलै बोलअ, “बिधाता निं इना मांझ़ै कोहै छ़ांटअ आथी!” <verse eid="1SA 16:10" /><verse number="11" style="v" sid="1SA 16:11" />तेखअ पुछ़अ शमूएलै ईशैई का, “सोभ एछी गऐ कि तेरै होर शोहरू बी आसा?”</para>
  <para style="p" vid="1SA 16:11">ईशैई दैनअ ज़बाब, “नांईं, सोभी का कान्हअ आसा एक होर, सह आसा भेडा-बाकरीए हेल़्ही फुआल डेऊअ द।”</para>
  <para style="p" vid="1SA 16:11">शमूएलै बोलअ ईशैई लै, “तेऊ आण ओर्ही शादी, ज़ेभै तैणीं सह इधी निं पुजे, तेभै तैणीं निं हाम्हां रोटी खांदै बेशणअ।” <verse eid="1SA 16:11" /><verse number="12" style="v" sid="1SA 16:12" />ईशैई छ़ाडै फुआला बणां लै आदमी संघा शादअ सोभी का कान्हअ शोहरू तेऊ नाअं त दाबेद। सह थिअ मोट्टअ-धोटअ अर हेरनअ बित्तअ, तेऊए आछी भाल़णेंओ बी लागा त लोभ। बिधाता बोलअ शमूएला लै, “अह आसा सह! उझ़ू जैतूनो तेल तरैल़ एऊए मुंडै।” <verse eid="1SA 16:12" /><verse number="13" style="v" sid="1SA 16:13" />शमूएलै तरैल़अ तेऊए मुंडै शींगा का जैतूनो तेल अर तेऊए होर भाई तै तिधी भाल़ै लागै दै। तेभी आई बिधाते पबित्र आत्मां दाबेदा लै संघा बस्सी तेऊ दी। तेखअ डेऊअ शमूएल रामाह नगरी लै फिरी।<verse eid="1SA 16:13" /></para>
  <para style="s">दाबेद शाऊला सेटा</para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 16:14" />बिधाते पबित्र आत्मां निखल़ी शाऊला का पोर्ही अर बिधाता दैनअ तेऊ दी भूत बस्सणै। <verse eid="1SA 16:14" /><verse number="15" style="v" sid="1SA 16:15" />शाऊले दास लागै तेऊ लै इहअ बोल्दै, “बिधाता दैनअ ताह दी भूत बस्सणै, सह लागअ ताह डरैऊंदअ। <verse eid="1SA 16:15" /><verse number="16" style="v" sid="1SA 16:16" />मेरै मालक, तूह कर हाम्हां लै हुकम, हाम्हैं आणू इहअ मणछ लोल़ी ज़ुंण बधिया बींन ज़ाणा बाज़ी। तेखअ ज़ेभै बी परमेशरा बाखा सह भूत ताह काबू करे, तेभै-तेभै बाज़णीं तेऊ बींन, संघा हणअ तूह राम्बल़अ।”<verse eid="1SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 16:17" />शाऊलै किअ तिन्‍नां लै हुकम, “ठीक आ, ज़ुंण सोभी का बधिया बींन ज़ाणा बाज़ी, तेऊ आणा लोल़ी मुंह सेटा लै।”<verse eid="1SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 16:18" />तिन्‍नां मांझ़ै बोलअ कुंणी इहअ, “शूणां, मंऐं भाल़अ द बेतलेम नगरीए ईशैईओ शोहरू दाबेद, सह बाज़ा बेघै बधिया बींन। सह हेरनअ बी आसा बित्तअ, गल्‍ला बी करा अक्लीए अर सह आसा बी शूरबीर। बिधाता रहा तेऊ संघा।”<verse eid="1SA 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 16:19" />शाऊलै छ़ाडै आपणैं दूत ईशैई सेटा इहअ समाद लई, “तेरअ शोहरू दाबेद ज़ुंण भेडा-बाकरीए हेल़्ही फुआल हआ, तेऊ छ़ाड मुंह सेटा लै।” <verse eid="1SA 16:19" /><verse number="20" style="v" sid="1SA 16:20" />ईशैई छ़ाडअ दाबेद शाऊला सेटा लै, तेऊ संघै दैनअ एक छ़ेल्हू, रोटी करै दैनअ एक गाधअ लादी अर एक खाल्हल़अ दैनअ दाखे रसो भरी। <verse eid="1SA 16:20" /><verse number="21" style="v" sid="1SA 16:21" />दाबेद पुजअ शाऊला सेटा संघा हआ त धैल़ तेऊए च़ाकरी लै खल़अ। शाऊला गम्मअ दाबेद अर तेऊ डाहअ सह आप्पू संघै तेऊए अस्त्र-शस्त्रा ढोणै आल़अ। <verse eid="1SA 16:21" /><verse number="22" style="v" sid="1SA 16:22" />शाऊलै दैनअ ईशैई लै इहअ समाद, “मुंह गम्मअ तेरअ शोहरू दाबेद, ऐबै दै एऊ मुंह ई सेटा रहणैं।” <verse eid="1SA 16:22" /><verse number="23" style="v" sid="1SA 16:23" />ज़ेभै-ज़ेभै परमेशर शाऊला लै तेऊ भूता शाचणैं दैआ थिअ, तेभै-तेभै बाज़ा त दाबेद बींन अर तेखअ निखल़ा त सह भूत पोर्ही अर तेखअ हआ त शाऊल राम्बल़अ।<verse eid="1SA 16:23" /></para>
  <chapter eid="1SA 16" />
  <chapter number="17" style="c" sid="1SA 17" />
  <para style="s">पलिश्ती जोधअ गोलियाथ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 17:1" />तिन्‍नां धैल़ै झाल़ी पलिश्ती आपणीं सैना संघा हुऐ इज़राईली संघै जुधा लै यहूदा मुल्खे सोको नगरी संघा पाऐ तिन्‍नैं अपेस-दमीम नाओंए ज़ैगा डेरै ज़ुंण सोको अर अज़ेका नगरी मांझ़ै आसा। <verse eid="1SA 17:1" /><verse number="2" style="v" sid="1SA 17:2" />शाऊलै अर इज़राईली सैना बी पाऐ एलाह नाओंए खागै आपणैं डेरै संघा हुऐ पलिश्ती सैना संघै जुधा लै तैर। <verse eid="1SA 17:2" /><verse number="3" style="v" sid="1SA 17:3" />इहअ करै एकी बाखा धारा तै पलिश्ती अर दुजी बाखा धारा तै इज़राईली अर दुही मांझ़ै त गाडा सरली ज़ैगा।<verse eid="1SA 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 17:4" />पलिश्ती दला दी त गात नगरी का गोलियाथ नाओं दैंत्तर मर्ध खास्सअ शूरबीर कोई नौ फुट लाम्मअ। तेऊ दैनी इज़राईली लै मकाबलै करने धमकी। <verse eid="1SA 17:4" /><verse number="5" style="v" sid="1SA 17:5" />तेऊ हआ त मुंडै कांस्सैओ टोप, हिक्‍का हआ त कांस्सैओ हीकबंद बान्हअ द, सह हआ त कोई पौणै चअन मण पाक्‍कअ गर्कअ। <verse eid="1SA 17:5" /><verse number="6" style="v" sid="1SA 17:6" />ज़ांघा बी हआ तै तेऊ कांस्से ज़ांघबंद बान्हैं दै अर कान्हा हआ त तेऊ कांस्सैओ बर्छ़अ डाहअ द। <verse eid="1SA 17:6" /><verse number="7" style="v" sid="1SA 17:7" />तेऊए बर्छ़े डैंढी ती राछ़े लाठै ज़ेही मोट्टी अर आजू का बर्छ़ेओ लोहअ त कोई सात किलू गर्कअ। एक सपाही हआ त तेऊ आजू-आजू एक बडी ढाल़ा च़की हांढदअ लागअ द। <verse eid="1SA 17:7" /><verse number="8" style="v" sid="1SA 17:8" />गोलियाथ हुअ धारा आपणीं सैना आजू खल़अ संघा पाई इज़राईली सैना लै हाक्‍का, “तम्हैं किज़ू आसा पार जुधा लै कठा हुऐ दै? हुंह आसा भाल़ पलिश्ती मर्ध, तम्हैं आसा राज़ै शाऊले गलाम! आप्पू मांझ़ै छ़ांटा एक सोभी का खास्सअ ज़ोरा आल़अ मर्ध ज़ुंण मुंह संघै जुध करी सके। <verse eid="1SA 17:8" /><verse number="9" style="v" sid="1SA 17:9" />ज़ै सह मुंह मारी करै ज़िते, तै हणैं म्हारै सोभ लोग थारै गलाम, पर ज़ै हुंह तेऊ मारी पाऊं, तै लागणीं तम्हां म्हारै गलाम हई म्हारी च़ाकरी करनीं। <verse eid="1SA 17:9" /><verse number="10" style="v" sid="1SA 17:10" />आझ़ बोला हुंह तम्हां सोभी इज़राईली लै, ज़ै तम्हां हिम्मत आसा, तै बोला हुंह एक मर्ध छ़ाडा ज़ुंण मेरअ मकाबलअ करी सके!” <verse eid="1SA 17:10" /><verse number="11" style="v" sid="1SA 17:11" />ज़ांऊं शाऊल अर इज़राईली तेऊ पलिश्ती जोधे ईंयां गल्‍ला शूणीं, तिन्‍नैं चोल़अ आपणअ हैअ ई अर तिन्‍नां पल़ी भितरी खास्सी डअर।<verse eid="1SA 17:11" /></para>
  <para style="s">दाबेद डेऊअ शाऊले डेरै जैंदरी</para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 17:12" />दाबेद त एप्राती टोली का ईशैई नाओंए मणछो शोहरू। सह रहा त यहूदा मुल्खै बेतलेम नगरी। ईशैई थिऐ आठ शोहरू, अर सह गअ त खास्सअ प्रोढअ हई ज़धू शाऊल राज़अ त। <verse eid="1SA 17:12" /><verse number="13" style="v" sid="1SA 17:13" />ईशैई चअन ज़ेठै शोहरू तै शाऊले सैना दी जुधा लै डेऊई गऐ दै। सोभी का ज़ेठै नाअं त एलीआब, तेऊ कान्हैं नाअं त अबीनादाब अर चिऊथै नाअं त शमाह। <verse eid="1SA 17:13" /><verse number="14" style="v" sid="1SA 17:14" />दाबेद थिअ सोभी का कान्हअ शोहरू, ज़ेठै चअन शोहरू तै शाऊला संघै डेऊई गऐ दै, <verse eid="1SA 17:14" /><verse number="15" style="v" sid="1SA 17:15" />तैही लागा त दाबेदा मांझ़ै-मांझ़ै बेतलेम नगरी आपणैं बाबे भेडा-बाकरीए हेल़्ही हेरा-सभाल़ा डेऊई करनअ संघा लागा त शाऊले डेरै लै फिरी एछणअ।<verse eid="1SA 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 17:16" />सह पलिश्ती गोलियाथ करा त धैल़ दोत्ती अर उडै इज़राईली लै हाक्‍का पाई, “ज़ै हिम्मत आसा, तै करा मेरअ मकाबलअ।” इहअ ई करै हुऐ कोई च़ाल़्ही धैल़ै।<verse eid="1SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 17:17" />एकी धैल़ै बोलअ ईशैई आपणैं कान्हैं शोहरू दाबेदा लै, “तूह निंऊं मण पाक्‍कअ भुज़अ द नाज़ अर इना दस रोटी आपणैं भाई लै तिन्‍नें खिम्भे दला दी एभी ठुर्हदा। <verse eid="1SA 17:17" /><verse number="18" style="v" sid="1SA 17:18" />पनीरे ईंयां दस टिक्‍की बी निंऊं, इना दै तिन्‍नें दले दलपति लै। संघा एछै आपणैं भाई भाल़ी कि तिंयां किहै आसा, फिरदा आणै ऐहा गल्‍ले नशाणी बी ज़ेता करै हुंह इहअ ज़ाणूं कि तिंयां आसा राज्ज़ी-राम्बल़ै। <verse eid="1SA 17:18" /><verse number="19" style="v" sid="1SA 17:19" />तिंयां तेरै भाई, राज़अ शाऊल अर सारी इज़राईली सैना आसा एला खागै पलिश्ती संघै जुधा लै डेरै पाऐ दै।”<verse eid="1SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 17:20" />दाबेद उझ़ुअ दुजै धैल़ै दोत्थी, आपणीं भेडा-बाकरीए हेल़्ही डाही तेऊ कहा होरी का सभाल़ी, आप्पू लागअ ज़िहअ ईशैई बोलअ थिअ, तिन्‍नां खाणैं-पिणें च़िज़ा च़की हांढदअ संघा पुजअ तैहा ज़ैगा सिऊंआं ज़िधी इज़राईली जुधा लै कठा तै हुऐ दै अर जुधे हाक्‍का ती लागी दी। <verse eid="1SA 17:20" /><verse number="21" style="v" sid="1SA 17:21" />पलिश्ती अर इज़राईली सैना ती आर पार स्मोहरी लगैग लाई खल़्हुई दी। <verse eid="1SA 17:21" /><verse number="22" style="v" sid="1SA 17:22" />दाबेदै दैनी तिंयां खाणें च़िज़ा तेऊ का ज़हा का सैना लै खाणैं पिणें ज़िम्मैंबारी थिई, आप्पू ठुर्हअ सह तैहा ज़ैगा सिऊंआं बाखा लै ज़िधी जुधा लै सैना ती खल़ी। तिधी पुजी पुछ़ै तेऊ आपणैं भाई राज्ज़ी-राम्बल़ै। <verse eid="1SA 17:22" /><verse number="23" style="v" sid="1SA 17:23" />दाबेद त आपणैं ज़ेठै भाई संघै गल्‍ला लागअ द, तेतरी गअ गात नगरीओ गोलियाथ पलिश्ती जोधअ पारा बाखा धारा आजू निखल़ी इज़राईली लै भिई हाक्‍का पाई तिहअ ई बोल्दअ लागी, दाबेदै शूणीं तेऊए गल्‍ला पठी कि सह किज़ै बोला। <verse eid="1SA 17:23" /><verse number="24" style="v" sid="1SA 17:24" />ज़ांऊं इज़राईली गोलियाथ भाल़अ, तिंयां लागै डरै तेऊ भाल़ी दूर ठुर्हदै। <verse eid="1SA 17:24" /><verse number="25" style="v" sid="1SA 17:25" />इज़राईली बोला तै एकी-दुजै लै इहअ, “एऊ भाल़ा! अह एछा हर धैल़ै इज़राईले बेइज़ती करदअ! राज़ै शाऊलै आसा तेऊ मणछा लै बडी नांम डाही दी ज़ुंण एऊ मारे! आपणीं शोहरीओ बैह बी करनअ राज़ै तेऊ ई संघै अर राज़ै करनअ सारी अमरा लै तेऊए टबरो कारअ माफ।”<verse eid="1SA 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 17:26" />दाबेदै पुछ़अ तिन्‍नां सपाही का ज़ुंण तेऊ नेल़ तै खल़्हुऐ दै, “एऊ पलिश्ती मारनै अर इज़राईला बेइज़त करनै का एऊ रोक्‍कणै आल़ै किज़ै भेटणअ? अह पलिश्ती ज़सरअ खतैर निं आथी हुअ द, अह आप्पू किज़ै समझ़ा? अह कुंण हआ ज़िऊंदै परमेशरे सैना लै सुहांगा करदअ!” <verse eid="1SA 17:26" /><verse number="27" style="v" sid="1SA 17:27" />तिन्‍नैं खोज़ी दाबेदा का तिंयां गल्‍ला कि ज़ुंण गोलियाथा मारे, तेऊ लै दैणअ राज़ै इहअ-इहअ।<verse eid="1SA 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 17:28" />दाबेद त तिन्‍नां संघै गल्‍ला करदअ लागअ द अर तेऊओ ज़ेठअ भाई एलीआब त शूणअ लागअ द। तेऊ आई दाबेदा लै रोश्शै संघा बोलअ इहअ, “तूह किज़ै करा ला इधी? थोल़ी ज़ेही भेडा-बाकरीए हेल़्ह बी तेरै भाल़्हुई निस्सी, तिंयां कहा सेटा डाही तंऐं रेगीस्तानै छ़ाडी? मुखा आसा थोघ कि तेरै दिलै केही खोट आसा! तूह च़ाहा सिधअ जुध भाल़णअ!”<verse eid="1SA 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1SA 17:29" />दाबेदै बोलअ, “ऐबै मंऐं कै किअ? हुंह एक गल्‍ल बी पुछ़ी निं सकदअ?” <verse eid="1SA 17:29" /><verse number="30" style="v" sid="1SA 17:30" />तेखअ फिरअ दाबेद दुजै सपाही बाखा संघा पुछ़ी तेऊ का सह ई गल्‍ल, ज़ेतरी बारी तेऊ ज़हा का बी सह सुआल पुछ़अ, तिन्‍नैं दैनअ तेऊ लै सह ई एक्‍कै ज़बाब कि राज़ै आसा इहअ-इहअ बोलअ द।<verse eid="1SA 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1SA 17:31" />तिन्‍नां मांझ़ै शूणअ कई कि दाबेद किज़ै बोला अर तिन्‍नैं खोज़ी तिंयां गल्‍ला राज़ै शाऊला का। शाऊलै शादअ दाबेद आप्पू सेटा। <verse eid="1SA 17:31" /><verse number="32" style="v" sid="1SA 17:32" />दाबेदै बोलअ शाऊला लै, “माहा राज़अ, तेऊ पलिश्ती मणछा पिछ़ू निं लोल़ी कोही हैअ चोल़अ! हुंह तेरअ दास डेऊं तेऊ संघै जुधा करदअ।”<verse eid="1SA 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 17:33" />शाऊलै दैनअ दाबेदा लै ज़बाब, “तूह किहअ करै सका तेऊ पलिश्ती जोधै संघै जुध करी? तूह आसा अज़ी होछ़अ अर सह आसा होछ़ी उझै शूरबीर जोधअ।”<verse eid="1SA 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1SA 17:34" />दाबेदै बोलअ शाऊला लै, “हुंह हआ बाबै भेडा-बाकरी फुआल डाहअ द। कई बारी निंयां सिह अर भाल्‍लू मेरी हेल़्ही का होछ़ै चैणैं च़की, <verse eid="1SA 17:34" /><verse number="35" style="v" sid="1SA 17:35" />हुंह डेओआ तिन्‍नां पिछ़ू संघा आणा हुंह आपणैं चैणैं तिन्‍नें खाखा का छ़ड़ैऊई। ज़ै सिह अर भाल्‍लू मुंह खांदै फिरै, तै ढाका हुंह तिन्‍नां कुकल़ी का संघा पाआ हुंह तिन्‍नां मारी। <verse eid="1SA 17:35" /><verse number="36" style="v" sid="1SA 17:36" />हुंह आसा भाल़ तेरअ दास ज़ुंणीं कई सिह अर भाल्‍लू तोही मारै, सह पलिश्ती ज़सरअ खतैर निं आथी हुअ द, सह बी मारनअ मुंह इहअ ई। किल्हैकि तेऊ दैनी ज़िऊंदै परमेशरे सैना लै मकाबलै करने धमकी। <verse eid="1SA 17:36" /><verse number="37" style="v" sid="1SA 17:37" />ज़ै बिधाता हुंह सिह अर भाल्‍लू का बच़ाऊअ, तेऊ हेरनअ हुंह एऊ पलिश्ती का बी बच़ाऊई।”</para>
  <para style="p" vid="1SA 17:37">शाऊलै बोलअ दाबेदा लै, “ठीक आ, तै डेऊ, बिधाता लोल़ी ताह संघै रहअ।”<verse eid="1SA 17:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1SA 17:38" />शाऊलै बन्हैऊंअ दाबेदा लै आपणअ सुआब, मुंडै दैनअ कांस्सैओ टोप हीकबंद संघी राज़ैओ च़ोल़अ। <verse eid="1SA 17:38" /><verse number="39" style="v" sid="1SA 17:39" />तेखअ बान्हीं दाबेदै कुछी बाखा शाऊले तलबार अर तेखअ लागअ हांढी करै भाल़अ, पर तेऊए निस्सअ तेऊ सभाबा दी हांढुई ई, किल्हैकि तिहअ निं तेऊ तधू तैणीं बान्हअ ई आथी त। तेखअ बोलअ दाबेदै राज़ै शाऊला लै, “हुंह निं एऊ सभाबा बान्हीं जुध करी सकदअ, मुंह निं एतो भैस्स आथी।” तेखअ खोल्है दाबेदै तिंयां झिकल़ै पोर्ही। <verse eid="1SA 17:39" /><verse number="40" style="v" sid="1SA 17:40" />दाबेदै च़की आपणीं फुआला बणें शोठी संघा होथअ उंधै गाडा लै, गाडा का च़कै तेऊ पांज़ च़िफलै गोल़ पात्थर संघा डाहै काछ़ा बाखा आपणैं थैल्‍लू दी। दुजै हाथै च़की पात्थरै बाहणें फर्णैक्‍की संघा डेऊअ गाडा पार एक्‍कै ज़ण्हअ पलिश्ती गोलियाथा बाखा।<verse eid="1SA 17:40" /></para>
  <para style="s">दाबेदै मारअ गोलियाथ</para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 17:41" />पलिश्ती जोधअ गोलियाथ बी लागअ हांढदी-हांढदी दाबेदा नेल़ एछदअ, तेऊ आजू-आजू त बडी ढाल़ च़की एक सपाही हांढदअ लागअ द। <verse eid="1SA 17:41" /><verse number="42" style="v" sid="1SA 17:42" />ज़ांऊं नेल़ पुजी पलिश्ती गोलियाथै दाबेद भाल़अ, दाबेद त अज़ी लान्हअ ई, सह लागअ तेऊए सुहांगा करदअ किल्हैकि दाबेद त लान्हअ ई हेरनअ बित्तअ अर अज़ी निं तेऊए थोथरा का लालगी बी डेऊई ती! <verse eid="1SA 17:42" /><verse number="43" style="v" sid="1SA 17:43" />पलिश्ती गोलियाथै बोलअ दाबेदा लै, “तंऐं किज़ू आसा हाथै शोठी आणी दी? तंऐं कै हुंह कुक्‍कर समझ़अ?” तेखअ लागअ गोलियाथ आपणैं देअआ-देबीए नाओंऐं दाबेदा लै गाल़ी दैई फिटक दैंदअ। <verse eid="1SA 17:43" /><verse number="44" style="v" sid="1SA 17:44" />पलिश्ती जोधै बोलअ दाबेदा लै, “एछ, एछ तूह ओर्ही! तेरी शिखा खैऊंणी मुंह सरगै डैऊंदै शकारी च़ेल्‍लू-पखीरू अर बणें शकारी ज़ीबा का।”<verse eid="1SA 17:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1SA 17:45" />दाबेदै दैनअ पलिश्ती गोलियाथा लै ज़बाब, “तूह आसा मुंह संघै जुधा लै तलबार, बर्छ़ै अर कटार पाई आअ द, पर हुंह आअ तेऊ स्वर्गे सारी सैने मालक बिधाता नाओंऐं ज़हा का सारअ बल आसा, ज़ुंण सारी इज़राईली सैनो परमेशर आसा, तंऐं आसा तेऊ ई लै मकाबलै करने धमकी दैनी दी। <verse eid="1SA 17:45" /><verse number="46" style="v" sid="1SA 17:46" />आझ़ दैणीं ऐहा धैल़ी बिधाता मुल्है ताह प्रैंदै ज़ीत। तूह बदल़णअ मुंह धरनीं संघा पाणअ तेरअ कैल़अ काटी। आझ़की धैल़ी दैणीं मुंह पलिश्ती सैने ल्हासा सरगै डैऊंदै च़ेल्‍लू-पखीरू अर बणें ज़ीबा खाणां लै। तेखअ लागणअ सारै संसारा का थोघ कि इज़राईला दी आसा एक्‍कै परमेशर। <verse eid="1SA 17:46" /><verse number="47" style="v" sid="1SA 17:47" />इधी बी जाणअ सोभी का थोघ लागी कि जुधा ज़ितणा लै निं बिधाता तलबार बर्छ़े ज़रुरत हंदी। अह जुध आसा बिधातो अर तेऊ ई करनअ तूह मेरै बशै।”<verse eid="1SA 17:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1SA 17:48" />पलिश्ती जोधअ गोलियाथ लागअ दाबेदा मारना लै आजू हांढदअ अर ओरा बाखा बाही दाबेदै तेऊ बाखा लै ठुहर। <verse eid="1SA 17:48" /><verse number="49" style="v" sid="1SA 17:49" />दाबेदै काढअ आपणीं काछ़ा बाखा थैल्‍लू का एक पात्थर संघा लाअ आजू फर्णैक्‍की दी। तेऊ लाअ फर्णैक्‍की फरेऊई करै पलिश्ती गोलियाथे माथै इहअ ज़ोरै नशाणअ कि पात्थर खुभअ माथै भितरी अर गोलियाथा बुल़्हअ फर्नैक्‍कअ धरनीं उटी बाखा। <verse eid="1SA 17:49" /><verse number="50" style="v" sid="1SA 17:50" />इहअ करै हारअ दाबेदै पलिश्ती जोधअ गोलियाथ फर्णैक्‍की करै एक्‍कै पात्थरै बाही! दाबेदा का नांईं ती तलबार आथी, <verse eid="1SA 17:50" /><verse number="51" style="v" sid="1SA 17:51" />दाबेद ठुर्हअ झ़ट-पटै संघा खल़्हुअ गोलियाथा प्रैंदै तेखअ घिशी तेऊए ई कुछी तलबार संघा बाही तेऊए कैल़ै अर तेऊओ मूंड काटी किअ सह मारी च़ित्त।</para>
  <para style="p" vid="1SA 17:51">ज़ांऊं पलिश्ती भाल़अ कि तिन्‍नों जोधअ हेरअ मारी अर तिंयां ठुर्है तिधा का। <verse eid="1SA 17:51" /><verse number="52" style="v" sid="1SA 17:52" />इज़राईली अर यहूदी पाई ज़ोरै-ज़ोरै हाक्‍का-क्रुंगा संघा ठुर्है पलिश्ती मारदै पिछ़ू, तिंयां दरल़ाऊऐ गात नगरीए सिऊंआं अर अक्रोन नगरी तैणीं। शारेम पोर्ही गात अर अक्रोन तैणीं पल़ी बाता पलिश्तीए खास्सी ल्हासा। <verse eid="1SA 17:52" /><verse number="53" style="v" sid="1SA 17:53" />ज़ांऊं पलिश्ती पिछ़ू पल़ै दै इज़राईली बापस फिरै, तिन्‍नैं लुटै तिन्‍नें डेरै सारअ समान पठी। <verse eid="1SA 17:53" /><verse number="54" style="v" sid="1SA 17:54" />दाबेदै आणअ पलिश्ती जोधै गोलियाथो मूंड एरुशलेम नगरी लै, पर तेऊए अस्त्र शस्त्र डाहै तेऊ आपणैं डेरै।<verse eid="1SA 17:54" /></para>
  <para style="s">दाबेद हुअ शाऊला सेटा पेश</para>
  <para style="p">
    <verse number="55" style="v" sid="1SA 17:55" />ज़ांऊं दाबेद पलिश्ती जोधै गोलियाथा संघै जुधा लै डेऊंदअ त लागअ द, शाऊलै पुछ़अ इज़राईली सैनापति अबनेरा का, “अबनेर, अह कसरअ शोहरू आसा?”</para>
  <para style="p" vid="1SA 17:55">अबनेरै बोलअ, “माहा राज़अ, तेरै सोह हुंह निं एऊ बछ़ैणदअ आथी।”<verse eid="1SA 17:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1SA 17:56" />शाऊलै राज़ै बोलअ, “पुछ़णी दै अह कसरअ शोहरू आसा।”<verse eid="1SA 17:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="1SA 17:57" />ज़ांऊं दाबेद गोलियाथा मारी डेरै लै बापस फिरअ, सैनापति अबनेरै निंयं सह शाऊला सेटा लै। पलिश्ती गोलियाथो मूंड त दाबेदे हाथै। <verse eid="1SA 17:57" /><verse number="58" style="v" sid="1SA 17:58" />शाऊलै पुछ़अ दाबेद, “ज़ुआन शोहरूआ, तूह कसरअ शोहरू आसा?”</para>
  <para style="p" vid="1SA 17:58">दाबेदै दैनअ ज़बाब, “हुंह आसा बेतलेम नगरी का तेरै दास ईशैईओ शोहरू।”<verse eid="1SA 17:58" /></para>
  <chapter eid="1SA 17" />
  <chapter number="18" style="c" sid="1SA 18" />
  <para style="s">दाबेद अर जोनाताने साथ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 18:1" />शाऊल अर दाबेद मुक्‍कै गल्‍ला करी। तेखअ बणअ शाऊलो शोहरू जोनातान दाबेदो पाक्‍कअ साथी। सह झ़ूरा त दाबेदा लै खास्सअ ज़िहअ सह आप्पू लै झ़ूरा। <verse eid="1SA 18:1" /><verse number="2" style="v" sid="1SA 18:2" />तैहा धैल़ी पोर्ही निं शाऊलै दाबेद आपणैं बाबे घअरा लै छ़ाडअ संघा डाहअ बैल़ी आप्पू संघै तिधी। <verse eid="1SA 18:2" /><verse number="3" style="v" sid="1SA 18:3" />जोनातान झ़ूरा त दाबेदा लै खास्सअ अर तिन्‍नैं ती आप्पू मांझ़ै करार किई दी कि तिन्‍नां निं आपणीं साथ कधि चोल़णी। <verse eid="1SA 18:3" /><verse number="4" style="v" sid="1SA 18:4" />जोनातानै दैनअ आप्पू बान्हअ द च़ोल़अ खोल्ही करै दाबेदा लै। आपणीं तलबार, हीकबंद, कबाण अर कुछी च़ाम्भल़े गाची बी दैनी तेऊ दाबेदा लै। <verse eid="1SA 18:4" /><verse number="5" style="v" sid="1SA 18:5" />राज़अ शाऊल ज़िधा लै बी दाबेदा छ़ाडा त, दाबेद हआ त तेथ आपणीं अक्ली करै सफल। खिरी बणाअं शाऊलै आपणीं सैना दी अफसर। शाऊले कार-करिंदै अर सारी परज़ा ती दाबेदा करै खुश।<verse eid="1SA 18:5" /></para>
  <para style="s">शाऊल लागअ दाबेदा संघै ज़ीद डाहंदअ</para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 18:6" />ज़ांऊं दाबेद पलिश्ती गोलियाथा मारी करै बापस त एछदअ लागअ द, इज़राईले हर नगरी का आई खास्सी बेटल़ी राज़ै शाऊले सुआगता करदी। तिंयां ती डफली, बींन बाज़दी नाच़दी अर गिहा बोल्दी लागी दी। <verse eid="1SA 18:6" /><verse number="7" style="v" sid="1SA 18:7" />तिंयां ती नाच़दी-नाच़दी एही गिहा बोल्दी लागी दी,</para>
  <para style="q" vid="1SA 18:7">“शाऊलै मारै हज़ार पर</para>
  <para style="q" vid="1SA 18:7">दाबेदै मारै दस हज़ार दुशमण।”<verse eid="1SA 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 18:8" />शाऊला निं अह गिह गम्मी अर तेऊ आई खास्सी रोश्शै। सह लागअ इहअ बोल्दअ, “दाबेदा लै बोला ईंयां दस हज़ार अर मुल्है बोला सिधअ एक हज़ार। ऐबै च़ाहा ईंयां एऊ इज़राईलो राज़अ बणाणअं!” <verse eid="1SA 18:8" /><verse number="9" style="v" sid="1SA 18:9" />इहअ करै डाही शाऊलै दिलै ई दिलै दाबेदा लै ज़ीद अर तधा बाद निं तेऊ दाबेदो भरोस्सअ किअ।<verse eid="1SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 18:10" />दुजै धैल़ै गअ शाऊल राज़ै भिई भूत शाची, सह लागअ आपणैं मैहलै गूरा ज़िहअ मिट्टदअ। दाबेद लागअ पैहलै ई ज़िहअ तेऊ सेटा बींन बाज़दअ अर शाऊले हाथै त बर्छ़अ। <verse eid="1SA 18:10" /><verse number="11" style="v" sid="1SA 18:11" />शाऊलै सोठअ इहअ, “मुंह बाहणीं दाबेदा लै एही ज़ोरै बर्छ़ै कि अह लोल़ी एऊए पेटा बाती पोर्ही पिछ़ू भित्ती दी खुभअ।” तेऊ शोटअ दाबेदा बाखा लै दूई बारी बर्छ़अ पर दाबेदै किअ दुही बारी तेते सिधा का पोर्ही सिक्‍की आपणअ बच़ाअ।<verse eid="1SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 18:12" />शाऊल त दाबेदा का डरअ द किल्हैकि बिधाता त तेऊ संघै अर शाऊला का थिअ बिधाता दूर गअ द हई। <verse eid="1SA 18:12" /><verse number="13" style="v" sid="1SA 18:13" />शाऊलै किअ दाबेद आप्पू का दूर, अर सह बणाअं तेऊ हज़ार सैना प्रैंदै सैनापति। दाबेद रहअ मानदारी दी आपणैं दला करै जुधा ज़ितदअ लागी। <verse eid="1SA 18:13" /><verse number="14" style="v" sid="1SA 18:14" />दाबेद अर तेऊए सैना हआ ती हर ज़ैगा तिन्‍नें अक्ली करै सफल किल्हैकि बिधाता त दाबेदा संघै। <verse eid="1SA 18:14" /><verse number="15" style="v" sid="1SA 18:15" />दाबेदा सफल हंदै भाल़ी डरअ शाऊल होर बी खास्सअ। <verse eid="1SA 18:15" /><verse number="16" style="v" sid="1SA 18:16" />पर यहूदा अर इज़राईले सारी परज़ा गम्मअ दाबेद होर बी खास्सअ किल्हैकि सह थिअ एक सफल सैनापति।<verse eid="1SA 18:16" /></para>
  <para style="s">दाबेदो बैह हुअ शाऊले शोहरी संघै</para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 18:17" />एकी धैल़ै बोलअ शाऊलै खिरी दाबेदा लै इहअ, “इधी भाल़ मेरी ज़ेठी शोहरी मिराब। मुंह करनअ ऐहा शोहरीओ बैह ताह संघै पर तेता लै रहैऊ मुखा तूह बिधाता बाखा जुध करी इहअ कि तूह आसा असली भरोस्सैमंद जोधअ।” शाऊलै सोठअ इहअ, “अह हेरनअ जुधा लै पलिश्ती मारी अर हुंह बी बच़अ तेखअ एऊ मारनै का।”<verse eid="1SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 18:18" />दाबेदै दैनअ शाऊला लै ज़बाब, “माहा राज़अ, हुंह निं ताह सेटा किछ़ बी आथी कि हुंह तेरअ ज़ुआंईं बणू! अर नां इज़राईला दी मेरै खिंबे मशूरी आथी।” <verse eid="1SA 18:18" /><verse number="19" style="v" sid="1SA 18:19" />पर ज़ांऊं शाऊले शोहरी मिराबो दाबेदा संघै बैह करनैओ बगत आअ, तेऊ दैनी आपणीं शोहरी मेहोलाह नगरीए आद्रीएला लै बैही।<verse eid="1SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 18:20" />शाऊले ती एक होर शोहरी, तैहा नाअं त मिकल, सह झ़ूरा ती दिलै ई दिलै दाबेदा लै खास्सी, ज़ांऊं ऐहा गल्‍लो थोघ शाऊला का लागअ, सह हुअ राज्ज़ी। <verse eid="1SA 18:20" /><verse number="21" style="v" sid="1SA 18:21" />शाऊलै सोठअ इहअ, “अह आसा दाबेदा पलिश्तीए हाथै मारनैओ होर मोक्‍कअ! मुंह बोल़णअ दाबेदा लै इहअ कि एभकी बारी करनअ मुंह आपणीं कान्हीं शोहरी संघै पाक्‍कै दी तेरअ बैह।” <verse eid="1SA 18:21" /><verse number="22" style="v" sid="1SA 18:22" />शाऊलै डाहै आपणैं कार-करिंदै शगरेऊई कि दाबेदा लै बोलै इहअ, “राज़अ आसा ताल्है खास्सअ खुश, अर हाम्हैं बी झ़ूरा ताल्है खास्सै, तूह मन्‍न राज़े गल्‍ल संघा कर तेऊए शोहरी संघै बैह।”<verse eid="1SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 18:23" />राज़ै शाऊले कार-करिंदै बोली ईंयां गल्‍ला दाबेदा लै अर दाबेदै दैनअ तिन्‍नां लै ज़बाब, “राज़ैओ ज़ुआंईं हणअ आसा खास्सी बडी अदरे गल्‍ल अर मुंह ज़िहै गरीब अर बृथा मणछा लै आसा होर बी बडी गल्‍ल।”<verse eid="1SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 18:24" />कार-करिंदै खोज़ी शाऊला का पठी गल्‍ला कि दाबेदै किज़ै बोलअ। <verse eid="1SA 18:24" /><verse number="25" style="v" sid="1SA 18:25" />शाऊलै किअ तिन्‍नां लै हुकम कि दाबेदा का खोज़ा इहअ, “शोहरीओ मोल ता निं राज़अ किछ़ै च़ाहंदअ पर सह च़ाहा इहअ कि तूह मार एक शौ पलिश्ती। तेखअ आण तिन्‍नें खतैर काटी गुप्त आंगे सोभी खलेफ़ल़ी मुंह सेटा लै। इहअ करै हणअ राज़ै शाऊलो आपणैं दुशमणा संघै बदल़अ पूरअ।” असली दी थिई शाऊले सोठ एही कि दाबेद लोल़ी पलिश्ती मारी पाअ। <verse eid="1SA 18:25" /><verse number="26" style="v" sid="1SA 18:26" />शाऊले कार-करिंदै खोज़ी दाबेदा का सारी गल्‍ला अर तेखअ हुअ दाबेद बी राज़ैओ ज़ुआंईं हणां लै राज्ज़ी। बैहा लै रहै तै थोल़ै धैल़ै, <verse eid="1SA 18:26" /><verse number="27" style="v" sid="1SA 18:27" />तैही डेऊऐ दाबेद अर तेऊए सैना संघा मारै दूई शौ पलिश्ती। तिन्‍नें खतैर काटी आणी तिन्‍नैं गुप्त आंगे दूई शौ खाल्हल़ी संघा दैनी राज़ै सेटा गणी करै कि सह ऐबै राज़ेए देई मिकला संघै बैह करी सके। तेखअ पल़अ शाऊला आपणीं कान्हीं शोहरीओ बैह दाबेदा संघै करनअ।<verse eid="1SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 18:28" />शाऊला का गअ ज़ाण्हुंई कि दाबेदा संघै आसा बिधाता अर तेऊए शोहरी मिकल बी झ़ूरा तेऊ लै खास्सी। <verse eid="1SA 18:28" /><verse number="29" style="v" sid="1SA 18:29" />तेखअ डरअ शाऊल दाबेदा का होर बी खास्सअ अर तेखअ डाही तेऊ सारी अमरा तेऊ संघै ज़ीद।<verse eid="1SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 18:30" />पलिश्ती सैना आई कई बारी जुधा लै, पर दाबेदा भेटी हर जुधा लै ज़ीत। तेऊ किअ शाऊले होरी कार-करिंदै का अक्ली करै काम अर इहअ करै हुअ दाबेद होर बी मशूर।<verse eid="1SA 18:30" /></para>
  <chapter eid="1SA 18" />
  <chapter number="19" style="c" sid="1SA 19" />
  <para style="s">शाऊलै हंतअ दाबेद खास्सअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 19:1" />शाऊलै बोलअ एकी धैल़ै आपणैं शोहरू जोनातान अर आपणैं कार-करिंदै लै कि दाबेद पाणअ हाम्हां मारी। पर शाऊलो शोहरू जोनातान झ़ूरा त दाबेदा लै खास्सअ अर <verse eid="1SA 19:1" /><verse number="2" style="v" sid="1SA 19:2" />तेऊ हेरी ईंयां गल्‍ला दाबेदा का खोज़ी, “मेरअ बाब च़ाहा ताह मारी पाणअ। काल्‍ला दोत्ती डाहै तूह धैन। तूह रह किधी एही ज़ैगा लुक्‍की ज़ेतो कोही का थोघ निं लागे, संघा रहै तिधी। <verse eid="1SA 19:2" /><verse number="3" style="v" sid="1SA 19:3" />मुंह आणनअ आपणअ बाब तेस्सी बाती संघा करनीं मुंह तेरै बारै तेऊ संघै गल्‍ला, ज़ै मुखा किज़ै होर बी थोघ लागे, तेता बी हेरुं हुंह ताखा खोज़ी।”<verse eid="1SA 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 19:4" />जोनातानै किई आपणैं बाब शाऊला सेटा दाबेदे सर्राफी, “माहा राज़अ, आपणैं दास दाबेदा लै निं ज़ुल्म करी! तेऊ निं तेरअ किछ़ै बूरअ किअ, तेऊ किई हर गल्‍ला लै तेरी ई मज़त ज़ेथ तेरअ ई भलअ होए। <verse eid="1SA 19:4" /><verse number="5" style="v" sid="1SA 19:5" />तेऊ निं आप्पू मरने परबाह बी किई। दाबेदै मारअ भाल़ पलिश्ती गोलियाथ अर तेऊ करै दैनी बिधाता इज़राईला लै बडी ज़ीत। तेता भाल़ी हुअ त तूह बी खुश। तै ऐबै किल्है च़ाहा तूह थोघै बाझ़ी दाबेदा मारनअ? नर्दोश मणछे हत्या करनैओ पाप किल्है लाअ आप्पू लै पाई?”<verse eid="1SA 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 19:6" />शाऊला गम्मी जोनाताने गल्‍ला संघा खाऐ तिधी तेऊ इहै सोह, “हुंह खाआ बिधाते सोह, मुंह निं दाबेदा मारनै दैणअ।” <verse eid="1SA 19:6" /><verse number="7" style="v" sid="1SA 19:7" />जोनातानै शादअ दाबेद संघा खोज़ी तेऊ का ईंयां पठी गल्‍ला। तेखअ निंयं तेऊ सह शाऊला सेटा। दाबेद लागअ तेखअ पैहलै ई ज़िहअ राज़ै शाऊले च़ाकरी करदअ।<verse eid="1SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 19:8" />तेतरी गअ पलिश्ती संघै भिई जुध लागी। दाबेद डेऊअ पलिश्ती संघै जुधा लै अर तेऊ मारै तिंयां इहै कि तिन्‍नां पल़अ पिछ़ू बापस ठुहर्नअ।<verse eid="1SA 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 19:9" />एकी धैल़ै दैनअ बिधाता भिई शाऊला दी भूत बस्सणै। सह थिअ आपणैं घअरै बेठअ द अर तेऊए हाथै त बर्छ़अ अर दाबेद त तेऊ सेटा बींन बाज़दअ लागअ द। <verse eid="1SA 19:9" /><verse number="10" style="v" sid="1SA 19:10" />शाऊलै सोठअ इहअ कि एऊ लै बाहणअ मुंह इहअ ज़ोरै बर्छ़अ कि एऊ बाती लोल़ी बर्छ़अ पिछ़ू भित्ती दी खुभअ। दाबेद ठुर्हअ तिधा का तैहा राची दूर अर इहअ करै बच़अ सह तधू।<verse eid="1SA 19:10" /></para>
  <para style="s">मिकलै बच़ाऊअ दाबेद</para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 19:11" />तैहा ई राची छ़ाडै शाऊलै आपणैं दूत दाबेदे घअरा लै कि काल्‍ला दोत्ती रहै तेऊ मारना लै ताखुई। दाबेदे लाल़ी मिकलै हेरअ दाबेदा का इहअ खोज़ी सह चतैन करी, “ज़ै तूह आझ़ राची इधा का बच़ी दूर निं डेओए, दोत्ती पाणअ तूह इना मारी।”<verse eid="1SA 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 19:12" />मिकलै थुआल़अ दाबेद ताक्‍की बाती उंधै बागा लै, संघा ठुर्हअ दाबेद तिधा का दूर अर सह बच़अ। <verse eid="1SA 19:12" /><verse number="13" style="v" sid="1SA 19:13" />मिकलै डाहै तेऊए कऊंचा प्रैंदै आपणैं घअरे देबते मुहुर्ती सताऊई, मुंडा बाखा डाही बाकरीए शेली करै बणाईं दी शरैहण अर प्रैंदी डाहअ च़ादरू छ़ैई। <verse eid="1SA 19:13" /><verse number="14" style="v" sid="1SA 19:14" />राज़ै शाऊलै छ़ाडै दाबेदा ढाकदै दूत, मिकलै बोलअ तिन्‍नां का, “तेऊ आसा दाह लागी दी।” <verse eid="1SA 19:14" /><verse number="15" style="v" sid="1SA 19:15" />शाऊलै छ़ाडै आपणैं दूत दाबेदा भाल़ै इहअ बोली भितरा लै, “तेऊ आणा कऊंचा संघी मुंह सेटा लै, मुंह मारनअ ई सह।” <verse eid="1SA 19:15" /><verse number="16" style="v" sid="1SA 19:16" />तिंयां डेऊऐ भितरा लै अर तिन्‍नैं भाल़अ कि कऊंचा प्रैंदै आसा कुल़ज देअए मैहरै डाहै दै सताऊई अर मुंडा बाखा आसा बाकरीए शेलीए शरैहण! <verse eid="1SA 19:16" /><verse number="17" style="v" sid="1SA 19:17" />शाऊलै पुछ़अ मिकला का, “तंऐं किल्है किअ मुंह संघै धोखअ? तंऐं किल्है दैनअ मेरै दुशमणा डेऊणैं कि सह बच़े?”</para>
  <para style="p" vid="1SA 19:17">तैहा दैनअ ज़बाब, “तेऊ बोलअ मुल्है, ‘तूह कर मेरी इधा का बच़णा लै मज़त, नांईं ता मुंह पाणीं तूह ई मारी।’”<verse eid="1SA 19:17" /></para>
  <para style="s">शमूएलै बच़ाऊअ दाबेद</para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 19:18" />तिधा का बच़ी डेऊअ दाबेद रामाह नगरी शमूएल गूरा सेटा संघा खोज़ी तेऊ का पठी गल्‍ला कि शाऊलै तेऊ संघै किहअ-किहअ किअ। तेखअ डेऊऐ तिंयां दुहै ज़ण्हैं नबाओत गराऊंऐं संघा रहै तिधी। <verse eid="1SA 19:18" /><verse number="19" style="v" sid="1SA 19:19" />शाऊला का हेरअ कुंणी खोज़ी कि दाबेद आसा रामाह नगरी नबाओत, <verse eid="1SA 19:19" /><verse number="20" style="v" sid="1SA 19:20" />तेऊ छ़ाडै आपणैं दूत दाबेदा ढाकदै। शाऊले आदमी भाल़अ तिधी कि गूरो छ़ुंढ आसा मिट्टदी-छ़ेर्हदी आजू हणैं आल़ी गल्‍ला प्रगट करदै लागै दै। शमूएल आसा तिन्‍नां सोभी गूरो सैणअ। शाऊले तिन्‍नां आदमी दी बी बस्सी परमेशरे आत्मां अर तिंयां बी लागै तिन्‍नां ई ज़िहै मिट्टदै-छ़ेर्हदै। <verse eid="1SA 19:20" /><verse number="21" style="v" sid="1SA 19:21" />ज़ांऊं इना गल्‍लो थोघ शाऊला का लागअ, तेऊ छ़ाडै आपणैं होर दूत अर तिंयां बी लागै तिहै ई मिट्टदै-छ़ेर्हदै। <verse eid="1SA 19:21" /><verse number="22" style="v" sid="1SA 19:22" />तेखअ आअ शाऊल आप्पै रामाह नगरी लै। ज़ांऊं सह सेकू बडै कुहै सेटा पुजअ, तिधी लागअ सह पुछ़दअ, “शमूएल अर दाबेद किधी आसा?” कुंणी खोज़अ तेऊ का, “तिंयां आसा नबाओत गराऊंऐं।” <verse eid="1SA 19:22" /><verse number="23" style="v" sid="1SA 19:23" />तेखअ डेऊअ अह रामाह नगरीए नबाओत गराऊंआं लै। बाता हेरअ सह बी परमेशरे पबित्र आत्मां बशै करी अर सह बी लागअ सारी बाता मिट्टदअ-छ़ेर्हदअ ज़ोरै-ज़ोरै बोल्दअ। <verse eid="1SA 19:23" /><verse number="24" style="v" sid="1SA 19:24" />तेऊ खोल्है आपणैं झिकल़ै पोर्ही संघा लागअ शमूएला सम्हनै मिट्टदअ-छ़ेर्हदअ। संघा रहअ तैहा सारी धैल़ी अर सारी राची धरनीं नांगअ बधल़ूई। तधा का निखल़ी एही कहाबत, “शाऊल बी ऐबै गूर निखल़अ?”<verse eid="1SA 19:24" /></para>
  <chapter eid="1SA 19" />
  <chapter number="20" style="c" sid="1SA 20" />
  <para style="s">जोनातानै नभाऊई दाबेदा संघै आपणीं पाक्‍की साथ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 20:1" />दाबेद निखल़अ रामाह नगरीए नबाओत गराऊंआं का बच़ी संघा डेऊअ जोनाताना सेटा। दाबेद लागअ तेऊ का इहअ पुछ़दअ, “मेरअ आस्सा किज़ै कशूर! मेरै भलै इहअ किज़ै पाप हुअ कि तेरअ बाब आसा मुंह मारदअ मेरै पिछ़ै पल़अ द?”<verse eid="1SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 20:2" />जोनातानै दैनअ ज़बाब, “परमेशर नां करे कि तूह मरे! मेरअ बाब लआ हर होछ़ै-बडै कामां करनै का आजी मुखा खोज़ी। तै ऐहा गल्‍लो टवारअ किल्है लाअ तेऊ मुखा करी? ऐबै निं ताह मारने गल्‍ल आथी ई!”<verse eid="1SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 20:3" />पर दाबेदै बोलअ, “जोनातान, हुंह खाआ बिधाते सोह, असली दी आसा इहअ ई! हुंह आसा मरनै का सिधअ हाथै-बैथै दूर! तेरै बाबा का आसा थोघ कि तूह झ़ूरा मुल्है खास्सअ। तैही निं सह ताखा खोज़ी ताह दुखी करनअ च़ाहंदअ।”<verse eid="1SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 20:4" />जोनातानै बोलअ दाबेदा लै, “ज़िहअ तूह बोले, ऐबै करूं हुंह तिहअ ई।”<verse eid="1SA 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 20:5" />दाबेदै खोज़अ जोनाताना का, “काल्‍ला आसा भाल़ पुनूंईओ थैर, हुंह बेशा ऐहा धैल़ी राज़ै संघै बैल़ी खांदअ ज़रूर, पर काल्‍ला रहणअ मुंह पर्शी उडै तैणीं किधी दूर खेचै लुक्‍की। <verse eid="1SA 20:5" /><verse number="6" style="v" sid="1SA 20:6" />ज़ै तेरअ बाब पुछ़े कि दाबेद किल्है निं आअ? तै खोज़ै तूह इहअ, ‘तेऊ मांगी ज़ीबाण करी मुखा छ़ुटी कि तेऊ शाचअ बेतलेम नगरी आपणैं घअरा लै डेऊणअ, तिन्‍नें खिंबे लोग करा हर साल हूम बल़ीदान।’ <verse eid="1SA 20:6" /><verse number="7" style="v" sid="1SA 20:7" />ज़ै सह इहअ बोले, ‘ठीक आ बै,’ तै समझ़ै तूह इहअ कि हुंह बच़अ, पर ज़ै सह रोश्श काढे, तै जाणअ तूह समझ़ी कि तेऊ आसा आपणैं दिलै मुंह मारने डाही दी। <verse eid="1SA 20:7" /><verse number="8" style="v" sid="1SA 20:8" />ज़ीबाण हेरे एऊ कामां करना लै निं तूह मेरअ भरोस्सअ चोल़ी, किल्हैकि तंऐं आसा बिधाते नाओंए सोह खाई करार किई दी कि ताह निं मुंह संघै कधि साथ चोल़णी। ज़ै ताह मुंह दी किज़ै खोट ज़ाण्हिंए, तै मारै मुंह तूह आपणैं हाथै! तेता लै निं लागदअ हुंह ताह आपणैं बाबा सेटा पजैल़णअ।”<verse eid="1SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 20:9" />जोनातानै बोलअ दाबेदा लै, “आरा एही गल्‍ल निं तूह सोठी बी आथी कि हुंह ताह संघै धोखअ करे! ज़ै मुखा पाक्‍कअ थोघ हंदअ कि मेरै बाबै आसा आपणैं दिलै अज़ी बी ताह मारने डाही दी, तै कै मुंह ताखा खोज़णअ निं आथी त?”<verse eid="1SA 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 20:10" />दाबेदै पुछ़अ जोनाताना का, “मुखा किहअ करै च़ाल्‍लअ थोघ लागी कि तेरै बाबा रोश्शै आई ती कि नांईं?”<verse eid="1SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 20:11" />जोनातानै बोलअ दाबेदा लै, “च़ाल्‍ल हाम्हां डेऊणअ दूर किधी खेचै।” तेखअ डेऊऐ तिंयां दुहै, <verse eid="1SA 20:11" /><verse number="12" style="v" sid="1SA 20:12" />जोनातानै बोलअ दाबेदा लै, “इज़राईलो परमेशर बिधाता आसा ऐहा गल्‍लो शाजत अर मेरी रही ताल्है ज़बान कि ऐहा ई बेला काल्‍ला कि पर्शी लणअ मुंह थोघ लाई कि मेरै बाबे दिलै किज़ै आसा। ज़ै मुखा ज़ाण्हिंए कि सह फिरअ ताल्है भलअ, तै दैंऊं ताल्है हुंह नढैऊऐ समाद। <verse eid="1SA 20:12" /><verse number="13" style="v" sid="1SA 20:13" />ज़ै मुखा ज़ाण्हिंए कि तेऊ आसा दिलै ताह मारने डाही दी, तै रही मेरी ताल्है ज़बान कि हुंह खोज़ूं ताखा आप्पै संघा काढूं ताह हुंह राज्ज़ी-राम्बल़अ बच़ाऊई। हुंह करा बिधाता सेटा एही अरज़ कि सह ताह संघै तिहअ ई रहे ज़िहअ मेरै बाबा संघै रहअ। <verse eid="1SA 20:13" /><verse number="14" style="v" sid="1SA 20:14" />ताल्है बी बोला हुंह ज़ीबाण करी कि ज़ेभै तैणीं आजू हुंह ज़िऊंदअ रहूं, तूह बी करै मुल्है आपणीं ज़बान पूरी अर तूह बी लोल़ी मुल्है तिहअ ई शुचअ-पाक्‍कअ रहअ। पर ज़ै हुंह मरी जाए, <verse eid="1SA 20:14" /><verse number="15" style="v" sid="1SA 20:15" />तिहअ ई मानदार रहै पिछ़ू मेरै टबरा लै बी। आजू ज़ेभै बिधाता तेरै सोभी दुशमणा खतम करे, <verse eid="1SA 20:15" /><verse number="16" style="v" sid="1SA 20:16" />तेभै बी लोल़ी तेरी-मेरी अह करार पाक्‍की रही। पर ज़ै तूह एता का हुधिए, तै लोल़ी बिधाता एते सज़ा आजू तेरी पोस्ती तैणीं दैनी।”<verse eid="1SA 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 20:17" />इहअ करै किई जोनातानै दाबेदा संघै भिई एकी-दुजै सोह खाई करै आपणीं साथ पाक्‍की। जोनातान झ़ूरा त दाबेदा लै खास्सअ ज़िहअ सह आप्पू लै झ़ूरा त। <verse eid="1SA 20:17" /><verse number="18" style="v" sid="1SA 20:18" />तेखअ बोलअ जोनातानै दाबेदा लै, “काल्‍ला पोर्ही हणअ पुनूंईओ थैर अर तिधी हेरनअ तेरै बारै पुछ़ी। किल्हैकि बैल़ी खाणें बगती हणअ तेरअ आसन रित्तअ किल्हैकि तूह ता एछणअ निं। <verse eid="1SA 20:18" /><verse number="19" style="v" sid="1SA 20:19" />पर्शी पल़णीं तेरी पुछ़ होर बी खास्सी। तूह डेओऐ तैहा ज़ैगा लै ज़िधी तूह एकी बारी पैहलै बी थिअ लुक्‍की रहअ द। तिधी रहै तूह एजेल नाओंए टोल्हा पिछ़ू लुक्‍की। <verse eid="1SA 20:19" /><verse number="20" style="v" sid="1SA 20:20" />तेता नेल़ एछी छ़ाडणअ मुंह एही एकी नशाणैं बाखा कतीर। <verse eid="1SA 20:20" /><verse number="21" style="v" sid="1SA 20:21" />मुंह बोल़णअ आपणैं दासा लै कि तेऊ कतीरा आण लोल़ी। तूह शूणैं ज़ै हुंह आपणैं तेऊ दासा लै इहअ बोले, ‘भाल़णीं दै कतीर आसा ताह पोर्ही बाखा पल़अ द तेऊ आण ओर्ही,’ तै समझ़ै तूह इहअ कि ताल्है निं किछ़ै खातरअ आथी अर तूह लागै मौज़ी ओर्ही एछदअ। हुंह काढा बिधाते सोह कि ताल्है निं किछ़ै बूरअ हणअ। <verse eid="1SA 20:21" /><verse number="22" style="v" sid="1SA 20:22" />पर ज़ै हुंह तेऊ दासा लै इहअ बोलूं, ‘पोर भाल़, पोर्ही डेऊ, कतीर आसा ताह आजू,’ तै समझ़ै तूह इहअ कि बिधाता च़ाहा ताल्है कि तूह डेओऐ तिधा का दूर अर तूह लागै तेखअ तिधा का हांढदअ। <verse eid="1SA 20:22" /><verse number="23" style="v" sid="1SA 20:23" />ज़ुंण ज़बान हाम्हां दूई मांझ़ै हुई, ऐहा गल्‍लो शाजत लोल़ी बिधाता सदा रहअ कि हाम्हैं एता पूरी करे।”<verse eid="1SA 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 20:24" />दाबेद रहअ दूर किधी खेचै लुक्‍की, पुनूंई धैल़ै आअ राज़अ शाऊल बैल़ी खांदअ, <verse eid="1SA 20:24" /><verse number="25" style="v" sid="1SA 20:25" />राज़अ शाऊल बेठअ भित्ती नेल़ आपणैं आसना दी ज़िधी सह बेशा त। तेऊ बाद बेठअ एकी बाखा अबनेर अर जोनातान बेठअ खाणें पलगा दी राज़ै सम्हनै दुजी बाखा। पर दाबेदे गाद्दी ती रित्ती। <verse eid="1SA 20:25" /><verse number="26" style="v" sid="1SA 20:26" />शाऊलै निं तैहा बैल़ी इहअ सोठी किछ़ै बोलअ, “किज़ू नां किज़ू करै हुअ होए दाबेद छ़ोतलअ, तैही निं सह आअ हणअ, ज़रूर हुअ हणअ किज़ै इहअ ई।” <verse eid="1SA 20:26" /><verse number="27" style="v" sid="1SA 20:27" />पुनूंईए दुजी धैल़ी बी रहअ दाबेदो आसन भिई रित्तअ, तेखअ लअ शाऊलै आपणैं शोहरू जोनाताना का पुछ़ी ई, “ईशैईओ शोहरू दाबेद नां थैरे भोज़ा करदअ हिझ़ थिअ नां आझ़ आथी! सह किल्है निं आअ होए?”<verse eid="1SA 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1SA 20:28" />जोनातानै दैनअ शाऊला लै ज़बाब, “दाबेदै मांगी मुखा बेतलेम नगरी आपणैं घअरा डेऊंणा लै छ़ुटी। <verse eid="1SA 20:28" /><verse number="29" style="v" sid="1SA 20:29" />सह रहअ भिई-भिई बोल्दअ लागी, ‘ज़ीबाण, मुंह दै डेऊणैं, म्हारै खिंबे लोग करा हर साल हूम बल़ीदान। मेरै भाई आसा हुंह तेता लै ज़रूर शादअ द, ज़ीबाण, तूह दै मुंह घअरै आपणैं टबरा सेटा डेऊई एछणैं।’ तैही निं सह राज़े पलगा दी भोज़ करदअ एछी सकअ।”<verse eid="1SA 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1SA 20:30" />शाऊल हुअ जोनाताना लै रोश्शै लाल-पिंऊंल़अ! तेऊ बोलअ इहअ, “तूह शोहरू हुअ द्रोही! तूह कै ज़ाणा मुखा थोघ निं आथी कि तूह च़ाहा ईशैईए शोहरू आपणीं ज़ैगा राज़अ बणाणअं, ताह शरम निं आथी! तेरी ईजे बी आसा बेइज़ती कि ताह ज़ेही लुआद किई पैईदा! <verse eid="1SA 20:30" /><verse number="31" style="v" sid="1SA 20:31" />ताखा इहअ बी निं ज़ाण्हदअ कि ईशैईए शोहरू दाबेदे ज़िऊंदी ज़िता निं तूह एऊ देशो राज़अ बणी सकदअ? ऐबै डेऊ, संघा आण तेऊ इधा लै, सह निं ज़िऊंदअ छ़ाडणअ आथी!”<verse eid="1SA 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 20:32" />जोनातानै दैनअ आपणैं बाब राज़ै शाऊला लै ज़बाब, “तूह आस्सा किज़ू तेऊ मारदअ लागअ द? तेऊ किज़ै बूरअ किअ?”<verse eid="1SA 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1SA 20:33" />शाऊलै शोटअ रोश्शै आपणअ बर्छ़अ जोनाताना बाखा कि तेऊ लै बाहे। इहअ करै हेरअ जोनातानै ज़ाणीं कि मेरै बाबै आसा आपणैं दिलै पाक्‍की डाही दी कि दाबेद पाणअ तेऊ मारी ई। <verse eid="1SA 20:33" /><verse number="34" style="v" sid="1SA 20:34" />जोनातान उझ़ुअ खाणें पलगा का रोश्शा संघी खल़अ अर तेऊ निं तैहा पुनूंई दुजी धैल़ी रोटी खाई। दाबेदे बारै सोठी त सह खास्सअ दुखी किल्हैकि शाऊलो बभार त दाबेदा लै बेघै बूरअ। <verse eid="1SA 20:34" /><verse number="35" style="v" sid="1SA 20:35" />दुजै धैल़ै दोत्ती डेऊअ जोनातान दूर खेचै दाबेदा सेटा मिलदअ ज़िधी तिन्‍नैं पैहलै ई त बोली डाहअ द। आप्पू संघै निंयं तेऊ एक दास बी। <verse eid="1SA 20:35" /><verse number="36" style="v" sid="1SA 20:36" />तेऊ बोलअ आपणैं दासा लै, “तूह ठुर्ह, ज़ुंण मुंह कतीर बाहणअ तेऊ आणै तूह लोल़ी।” सह शोहरू ठुर्हअ अर जोनातानै छ़ाडअ कबाणा का तेऊ का खास्सअ आजू एक कतीर। <verse eid="1SA 20:36" /><verse number="37" style="v" sid="1SA 20:37" />ज़ांऊं सह शोहरू तैहा ज़ैगा पुजअ ज़िधी कतीर पल़अ थिअ, जोनातानै लाई तेऊ लै हाक्‍का, “पोर भाल़, कतीर आसा ताह आजू! <verse eid="1SA 20:37" /><verse number="38" style="v" sid="1SA 20:38" />इधी निं खल़्हुई रहै, पोर्ही डेऊ, छ़ेक्‍कअ कर!” तेऊ दासै आणअ सह कतीर च़ुंघी संघा आअ जोनाताना सेटा फिरी। <verse eid="1SA 20:38" /><verse number="39" style="v" sid="1SA 20:39" />तेऊ शोहरू का निं थोघ आथी त कि किज़ै हुअ। एता ज़ाणा तै सिधै जोनातान अर दाबेद। <verse eid="1SA 20:39" /><verse number="40" style="v" sid="1SA 20:40" />आपणैं अस्त्र-शस्त्र तेऊ दासा का दैई बोलअ जोनातानै कि इना पजैल़ नगरी दी बापस।<verse eid="1SA 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 20:41" />ज़ांऊं सह शोहरू तिधा का डेऊअ, दाबेद निखल़अ दखण दिशा बाखा तैहा टोल्हा पिछ़ू का ओर्ही संघा बेठअ ज़ान्हूंए सारै धरनीं, तेऊ टेक्‍कअ चिई बारी धरनीं माथअ। तेखअ लागै जोनातान अर दाबेद दुहै ज़ण्हैं लेरा लांदै अर एकी-दुजै लै मल़्हैची दैंदै, दाबेद लागअ जोनाताना का बी खास्सअ हिक्‍की-सल़िक्‍की लेरा लांदअ। <verse eid="1SA 20:41" /><verse number="42" style="v" sid="1SA 20:42" />तेखअ बोलअ जोनातानै दाबेदा लै इहअ, “राज्ज़ी-खुशी संघै डेऊ, बिधाता लोल़ी हाम्हां संघै सदा रहअ कि हुंह अर तूह, तेरी लुआद अर मेरी लुआद हाम्हां दूई मांझ़ै बिधाता शाजत मनी आपणीं ज़बान पूरी करे।” तेखअ लागअ दाबेद तिधा का हांढदअ अर जोनातान डेऊअ नगरी लै बापस फिरी।<verse eid="1SA 20:42" /></para>
  <chapter eid="1SA 20" />
  <chapter number="21" style="c" sid="1SA 21" />
  <para style="s">दाबेद ठुर्हअ शाऊला का दूर</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 21:1" />दाबेद डेऊअ नोब<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="fq" closed="false">नोब </char><char style="ft" closed="false">प्रोहते नगरी</char></note> नगरी आहीमोलक प्रोहता सेटा। आहीमोलक आअ काम्बदी-काम्बदी दाबेदा सेटा मिलदअ संघा पुछ़अ, “तूह कल्ही किल्है आसा, ताह संघै होर किल्है निं आथी?”<verse eid="1SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 21:2" />दाबेदै बोलअ आहीमोलक प्रोहता लै, “हुंह आसा राज़े किज़ू कामां लै आअ द, राज़ै आसा मुल्है इहअ हुकम किअ द, ‘ज़ेऊ कामां लै मंऐं तूह छ़ाडअ, तेते बारै निं कोही का लोल़ी थोघ लागअ।’ तैही डाहै मंऐं आपणैं होर आदमी किधी होर्ती। <verse eid="1SA 21:2" /><verse number="3" style="v" sid="1SA 21:3" />ऐबै ताखा मुल्है किज़ै खाणां लै बी आसा? तूह दै मुल्है पांज़ रोटी। कि दै ज़िहअ बी ताखा आसा, तेता ओर्ही मुल्है खाणां लै।”<verse eid="1SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 21:4" />प्रोहतै बोलअ दाबेदा लै, “पबित्र रोटी का सुआई निं मुखा आम खाणें च़िज़ा किछ़ै आथी! ज़ै तम्हैं राची कहा बेटल़ी सेटा डेऊई छ़ोतलै निं आथी हुऐ दै, तै सका तम्हैं तेता खाई।”<verse eid="1SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 21:5" />दाबेदै दैनअ प्रोहता लै ज़बाब, “तैहा गल्‍लो डाह तूह निहंचअ, हाम्हां हुऐ घअरा का एछी चअन धैल़ै, हुंह निं आम हांढ-फेरा लै तोही आपणैं आदमी कहा बेटल़ी सेटा डेऊणैं दैंदअ! आझ़ आसा हाम्हैं खास कामैं पै आऐ दै, एता लै आसा हाम्हैं ज़ाथी पठी शुचै।”<verse eid="1SA 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 21:6" />तेखअ दैनी प्रोहतै बिधाता लै छ़ाडी दी तिंयां पबित्र रोटी दाबेदा लै, किल्हैकि तेता का सुआई निं खाणां लै तिधी होर किछ़ै आथी त। तिंयां ती तेऊ बिधाते पलगा प्रैंदा का ताज़ी रोटी डाहणैं बाद ओर्ही डाही दी च़की।<verse eid="1SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 21:7" />तधू त तिधी शाऊले कार-करिंदै मांझ़ै एक मणछ बिधाता लै पज़ाया दैंदअ आअ द। तेऊ नाअं त दोएग अर सह थिअ एदोम मुल्खा का अर सह थिअ शाऊले फुआला प्रैंदै सैणअ।<verse eid="1SA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 21:8" />दाबेदै बोलअ आहीमोलक प्रोहता लै, “ताखा बर्छ़अ कि तलबार किनी आसा? तै दै तेता ओर्ही मुल्है। हुंह आसा राज़े कामां लै इहअ छ़ेक्‍कै-छ़ेक्‍कै आअ द कि मुंह निं आप्पू संघै तलबार या होर अस्त्र-शस्त्र आणनेओ बगत ई भेटअ।”<verse eid="1SA 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 21:9" />आहीमोलक प्रोहतै दैनअ ज़बाब, “हाँ, पर मुखा आसा पलिश्ती गोलियाथे सह तलबार ज़ुंण तंऐं एली खागै मारअ त। सह आसा शाट्टै दी पल़ेटी सदरी पिछ़ू डाही दी। ज़ै ताह सह लोल़ी तै लाग निंदअ, तेता का सुआई निं इधी होर किछ़ै आथी।”</para>
  <para style="p" vid="1SA 21:9">दाबेदै बोलअ, “तैहा ई दै ओर्ही, तेते मकाबलै निं होर तलबार ई आथी!”<verse eid="1SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 21:10" />तेखअ लागअ दाबेद तिधा का हांढदअ, संघा ठुर्हअ शाऊले डरै तैहा ई धैल़ी गात नगरी लै। तिधी डेऊअ सह नगरीए राज़ै आकीशा सेटा। <verse eid="1SA 21:10" /><verse number="11" style="v" sid="1SA 21:11" />आकीश राज़े कार-करिंदै बोलअ राज़ै आकीशा लै इहअ, “अह इज़राईल देशो राज़अ दाबेद निं आथी? अह सह ई निं आथी ज़हा लै बेटल़ी नाच़दी-नाच़दी एही गिह बोला ती,</para>
  <para style="q" vid="1SA 21:11">‘शाऊलै मारै एक हज़ार,</para>
  <para style="q" vid="1SA 21:11">दाबेदै मारै दस हज़ार।’”<verse eid="1SA 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 21:12" />इना गल्‍ला शूणीं पल़अ दाबेदा मन्‍नैं हैल़अ अर तेखअ लागी तेऊ गात नगरीए राज़ै आकीशा का डअर। <verse eid="1SA 21:12" /><verse number="13" style="v" sid="1SA 21:13" />दाबेदै सोठी एक च़ाल अर तेऊ किअ सोभी नदरी इहअ दखाअ कि सह आसा बेगरअ हुअ द! सह रहअ दुआरे पाल्‍लै दी क्लीहरा दैंदअ अर आपणीं खाखा का थुके लाल़ा दाल़्ही दी छ़ाडदअ लागी। <verse eid="1SA 21:13" /><verse number="14" style="v" sid="1SA 21:14" />तेखअ बोलअ आकीश राज़ै आपणैं कार-करिंदै लै, “लै अह ता बेगरअ आसा! तम्हैं किज़ू आणअ अह मुंह सेटा लै? <verse eid="1SA 21:14" /><verse number="15" style="v" sid="1SA 21:15" />तम्हां कै मुंह सेटा बेगरै थोल़ै गऐ तै! कि तम्हैं पजैल़अ मेरै मैहलै बेगरी गल्‍ला करै मुंह हंतणा लै एक होर बेगरअ?”<verse eid="1SA 21:15" /></para>
  <chapter eid="1SA 21" />
  <chapter number="22" style="c" sid="1SA 22" />
  <para style="s">दाबेद रहअ जुहल़ी लुक्‍की</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 22:1" />दाबेद ठुर्हअ गात नगरी का दूर संघा रहअ अदुलाम नगरी नेल़ एकी जुहल़ी लुक्‍की। ज़ांऊं दाबेदे ईज-बाब, भाई अर होरी टबरा का थोघ लागअ कि सह आसा तिधी, तिंयां आऐ तिधी तेऊ सेटा लै। <verse eid="1SA 22:1" /><verse number="2" style="v" sid="1SA 22:2" />होर लोग बी आऐ तिधी दाबेदा सेटा। तिन्‍नां मांझ़ै तै कई इहै ज़हा खास्सी खरी ती पल़ी दी, ज़हा खास्सअ ऋण त पल़अ द अर ज़हा खास्सी घाटी ती आई दी। इहअ करै हुऐ तिधी कोई च़ार शौ मणछ दाबेदा संघै कठा अर तिन्‍नों प्रधान बणअ दाबेद।<verse eid="1SA 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 22:3" />तिधा का डेऊअ दाबेद मोआब मिज़पा नगरी लै संघा बोलअ मोआब देशे राज़ै लै, “ज़ीबाण, मेरै ईजा-बाबा दै तेभै तैणीं आपणैं देशै रहणैं ज़ेभै तैणीं मुखा थोघ जाए लागी कि बिधाता मुल्है किज़ै आसा लाअ द करी।” <verse eid="1SA 22:3" /><verse number="4" style="v" sid="1SA 22:4" />इहअ करै डाहै दाबेदै आपणैं ईज-बाब मोआब देशे राज़ै सेटा अर तिंयां रहै तधा बाद तेतरै धैल़ै तैणीं तिधी ज़ेतरै धैल़ै तैणीं दाबेद जुहल़ी लुक्‍की रहअ। <verse eid="1SA 22:4" /><verse number="5" style="v" sid="1SA 22:5" />तेखअ आअ गाद नाओं एक गूर दाबेदा सेटा लै संघा बोलअ इहअ, “तूह निं इधी जुहल़ी लुक्‍की रहै! तूह डेऊ एकी बारी यहूदा मुल्खा लै फिरी।” तेखअ डेऊअ दाबेद तिधा का संघा रहअ हेरेत नाओंए बणैं।<verse eid="1SA 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 22:6" />तेखअ हुअ इहअ कि शाऊल त गिबा नगरी मधनूंए बूटा हेठै आपणैं हाथै बर्छ़अ लई बेठअ द अर तेऊए कार-करिंदै तै तेऊ फेर खल़्हुऐ दै। तेऊ का खोज़अ कुंणी इहअ कि दाबेद अर तेऊए आदमीओ थोघ गअ लागी। <verse eid="1SA 22:6" /><verse number="7" style="v" sid="1SA 22:7" />तेखअ बोलअ शाऊलै आप्पू फेर खल़्हुऐ दै कार-करिंदै लै, “तम्हैं बिन्यामीन गोत्रा आल़ै शूणां मेरी गल्‍ल! तेऊ ईशैईए शोहरू दाबेदै कै तम्हां लै ज़ैगा-ज़िम्मीं अर दाखे बाग आसा दैणैं किऐ दै? तेऊ कै तम्हैं सैना दी दलपति कि सैनापति आसा लाऐ दै बणाईं? <verse eid="1SA 22:7" /><verse number="8" style="v" sid="1SA 22:8" />तैही आसा तम्हैं मुल्है द्रोह करी एक्‍कअ किअ द? तम्हां मांझ़ै निं मुखा एकी बी खोज़अ कि मेरै आपणैं ई शोहरू आसा ईशैईए शोहरू दाबेदा संघै सांठ-गांठ किई दी! नां तम्हां मांझ़ै मुखा कुंणी इहअ खोज़अ कि दाबेद ज़ुंण मेरअ ई आदमी थिअ, सह आसा आझ़ मुंह मारने मोक्‍कै लोल़अ लागअ द अर मेरअ आपणअ शोहरू आसा तेऊ लै च़ेही दैंदअ लागअ द कि तूह कर इहअ।”<verse eid="1SA 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 22:9" />एदोम खिंबो दोएग त तिधी शाऊले कार-करिंदै संघै खल़्हुअ द, तेऊ बोलअ इहअ, “मंऐं भाल़अ ईशैईओ शोहरू दाबेद नोब नगरी आहीतूबे शोहरू आहीमोलक प्रोहता सेटा डेऊंदअ। <verse eid="1SA 22:9" /><verse number="10" style="v" sid="1SA 22:10" />आहीमोलकै पुछ़अ दाबेदा लै बिधाता, संघा दैनी तेऊ दाबेदा लै खाणें च़िज़ा अर पलिश्ती जोधै गोलियाथे तलबार बी दैनी तेऊ लै।”<verse eid="1SA 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 22:11" />राज़ै शाऊलै छ़ाडै तोब नगरी लै दूत संघा किअ हुकम कि आहीतूबो शोहरू आहीमोलक अर नोब नगरी तेऊए खिंबे सोभै प्रोहत लोल़ी राज़ै सेटा लै आऐ। ज़ांऊं तिंयां सोभै आऐ, <verse eid="1SA 22:11" /><verse number="12" style="v" sid="1SA 22:12" />शाऊलै बोलअ, “आहीमोलक, आहीतूबे शोहरूआ, शुण।”</para>
  <para style="p" vid="1SA 22:12">आहीमोलकै बोलअ, “ज़ी मालक, कै हुकम आसा।”<verse eid="1SA 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 22:13" />शाऊलै पुछ़अ तेऊ का, “तूह अर ईशैईओ शोहरू दाबेद किल्है आसा मेरै द्रोही हुऐ दै? तंऐं किल्है दैनी तेऊ लै खाणें च़िज़ा अर तलबार? अर तंऐं किल्है पुछ़अ तेऊ लै बिधाता? आझ़ आसा सह मेरअ द्रोही हुअ द अर सह आसा तेऊ मोक्‍कै भाल़अ ताखुई रहअ द कि केभै पाणअ हुंह तेऊ मारी!”<verse eid="1SA 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 22:14" />आहीमोलकै दैनअ ज़बाब, “माहा राज़अ, तेरै सोभी कार-करिंदै मांझ़ै आसा दाबेद तेरअ सोभी का भरोस्सैमंद! सह आसा तेरअ आपणअ ज़ुआंईं अर तेरै खास सपाहीओ दलपति, तेरी सभा दी करा सोभै तेऊओ खास्सअ अदर। <verse eid="1SA 22:14" /><verse number="15" style="v" sid="1SA 22:15" />हाँ, मंऐं पुछ़अ दाबेदा लै बिधाता अर इहअ बी निं आथी कि अह किअ मंऐं पैहली बारी। रही ताल्है द्रोह करने गल्‍ल, माहा राज़अ, एही गल्‍लो दोश नां मुल्है लाई अर नां मेरै खिंबा लै लाई। किल्हैकि मुंह तेरै च़ाकरा का निं इना गल्‍ले बारै थोघ आथी हेरे कि किज़ै हुअ!”<verse eid="1SA 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 22:16" />शाऊल राज़ै बोलअ, “आहीमोलक, तूह पाणअ मुंह तेरै सारै खिंबा संघी मारी।”<verse eid="1SA 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 22:17" />तेखअ किअ राज़ै शाऊलै आप्पू नेल़ तिन्‍नां सपाही लै हुकम, “बिधाते इना सोभी प्रोहता पाआ मारी! इने बी आसा दाबेदा संघै सांठ-गांठ! इना का थिअ थोघ कि सह आसा मुखा दूर ठुर्हअ द, पर इनै निं मुखा खोज़अ!” पर शाऊले तिन्‍नां सपाही मांझ़ै निं कोह बिधाते प्रोहता मारना लै आजू आऐ। <verse eid="1SA 22:17" /><verse number="18" style="v" sid="1SA 22:18" />तेखअ बोलअ राज़ै शाऊलै दोएगा लै, “तूह मार इना!” एदोमी दोएगै पाऐ तिंयां सोभ मारी। तैहा धैल़ी पाऐ पजैस्सी प्रोहत मारी ज़ुंण बाछे खास च़ोल़ै बान्हीं बिधाते च़ाकरी करा तै। <verse eid="1SA 22:18" /><verse number="19" style="v" sid="1SA 22:19" />प्रोहते नोब नगरी बी बझ़ैल़ै राज़ै शाऊलै, प्रोहते ईज-बाब, मर्ध-बेटल़ी, शोहरू-शोहरी अर च़ूई झुटणैं आल़ै शोहरू संघी सोभ मारी पाणै। गाऊई-बल्द, गाधै, भेडा-बाकरी मांझ़ै बी निं तेऊ किछ़ ज़िऊंदै छ़ाडै।<verse eid="1SA 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 22:20" />पर आहीतूबो पोचअ आहीमोलको एक शोहरू अबतार छ़ुटअ तिन्‍नां का ज़िऊंदअ अर सह ठुर्हअ तिधा का संघा पुजअ दाबेदा सेटा। <verse eid="1SA 22:20" /><verse number="21" style="v" sid="1SA 22:21" />तेखअ खोज़ी अबतारै दाबेदा का पठी गल्‍ला कि शाऊलै किई बिधाते सोभी प्रोहते हत्या। <verse eid="1SA 22:21" /><verse number="22" style="v" sid="1SA 22:22" />दाबेदै बोलअ अबतारा का, “ज़धू मंऐं सह एदोमी दोएग आहीमोलका सेटा तिधी भाल़अ त, मंऐं हेरअ त ज़ाणीं कि एऊ हेरनअ ज़रूर शाऊला का खोज़ी। मुंह पिछ़ू हुई तेरै सारै खिंबे हत्या। <verse eid="1SA 22:22" /><verse number="23" style="v" sid="1SA 22:23" />तूह रहअ मुंह संघै, ताह निं डरने ज़रुरत आथी। शाऊल च़ाहा मुंह अर ताह दुही मारनअ। पर मुंह संघै रहणअ तूह बच़ी।”<verse eid="1SA 22:23" /></para>
  <chapter eid="1SA 22" />
  <chapter number="23" style="c" sid="1SA 23" />
  <para style="s">दाबेदै बच़ाऊई पलिश्ती का केलाह नगरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 23:1" />दाबेदै शूणअ इहअ कि पलिश्ती आऐ केलाह नगरीए परज़ा मारदै अर तिंयां आसा खेचा-खहल़ा का नऊंईं साल-फसला लुटदै लागै दै। <verse eid="1SA 23:1" /><verse number="2" style="v" sid="1SA 23:2" />दाबेदै पुछ़अ बिधाता, “हुंह पलिश्ती मारदअ डेऊ?” बिधाता दैनअ ज़बाब, “हाँ, डेऊ संघा बच़ाऊ केलाह नगरी।”<verse eid="1SA 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 23:3" />पर दाबेदे आदमी बोलअ तेऊ लै, “हाम्हां आसा इधी यहूदा मुल्खै तोही पलिश्ती का डअर लागी दी! केलाह नगरी डेऊई पलिश्ती संघै मकाबलअ सका हाम्हां लै होर बी डरैऊंणअ हई!” <verse eid="1SA 23:3" /><verse number="4" style="v" sid="1SA 23:4" />तेखअ पुछ़अ दाबेदै बिधाता भिई अर बिधाता दैनअ दाबेदा लै ज़बाब, “तूह डेऊ उंधै केलाह नगरी लै, संघा कर पलिश्ती संघै मकाबलअ, हुंह दैंऊं तिधी आप्पै ताल्है ज़ीत।” <verse eid="1SA 23:4" /><verse number="5" style="v" sid="1SA 23:5" />तेखअ डेऊअ दाबेद आपणैं आदमी संघा निंईं केलाह नगरी लै संघा छ़ेल़अ पलिश्ती संघै जुध। तिन्‍नैं मारै तिधी खास्सै पलिश्ती अर तिन्‍नें डागै-चैणैं आणै आप्पू लै छ़ेल़्ही। इहअ करै बच़ाऊई दाबेदै केलाह नगरी।<verse eid="1SA 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 23:6" />आहीमोलक प्रोहतो शोहरू अबतार ठुर्हअ संघा पुजअ केलाह नगरी दाबेदा सेटा अर आपणीं प्रोहते सदरी बी थिई तेऊ आप्पू संघै आणी दी।<verse eid="1SA 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 23:7" />शाऊला का गई अह खबर पुजी कि दाबेद आसा केलाह नगरी लै डेऊअ द, तेऊ बोलअ इहअ, “ऐबै किअ सह बिधाता मेरै बशै। फेर-फिरदै उछ़टै गहल़ा आल़ी नगरी भितरी डेऊई शाचअ सह ज़ज़ाल़ा दी आप्पै।” <verse eid="1SA 23:7" /><verse number="8" style="v" sid="1SA 23:8" />शाऊलै शादी आपणीं सैना जुधा लै कि केलाह नगरी डेऊई गोटणैं दाबेद अर तेऊए आदमी नगरी भितरी फेरा-फेर।<verse eid="1SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 23:9" />ज़ांऊं दाबेदा का थोघ लागअ कि शाऊल च़ाहा ऐबै इहअ करनअ, तेऊ बोलअ अबतार प्रोहता लै, “प्रोहते सदरी आण ओर्ही।” <verse eid="1SA 23:9" /><verse number="10" style="v" sid="1SA 23:10" />तेखअ बोलअ दाबेदै इहअ, “हे इज़राईले परमेशर बिधाता, मुखा शुण्हुंअ इहअ कि शाऊल आसा मुंह मारदअ केलाह नगरी लै च़ाल्‍लअ द एछी! मुंह पिछ़ू लाई तेऊ अह नगरी बी खतम करी, ऐबै हुंह किज़ै करूं? <verse eid="1SA 23:10" /><verse number="11" style="v" sid="1SA 23:11" />केलाह नगरीए सैणैं कै हुंह तेऊए हाथै दैणअ? ज़िहअ मंऐं शूणअ, शाऊल कै तिहअ ई च़ाल्‍लअ एछी? हे इज़राईले परमेशर बिधाता, ज़ीबाण, तूह खोज़ मुखा!”</para>
  <para style="p" vid="1SA 23:11">बिधाता दैनअ ज़बाब, “हाँ, सह एछणअ।”<verse eid="1SA 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 23:12" />तेखअ पुछ़अ दाबेदै बिधाता का इहअ, “केलाह नगरीए सैणैं कै हुंह अर मेरै आदमी शाऊले हाथै दैणैं?” बिधाता दैनअ ज़बाब, “हाँ, तिन्‍नां करनअ इहअ ई।”<verse eid="1SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 23:13" />दाबेद अर तेऊए आदमी तै पठी कोई छ़ह शौ अर तिंयां निखल़ै केलाह नगरी का दूर संघा रहै नगरी का दूर ज़िधी तिन्‍नां ज़ैगा भेटी तेथ लुक्‍की। ज़ांऊं शाऊला का थोघ लागअ कि दाबेद आसा गअ द केलाह नगरी का ठुर्ही, तेखअ निं सह केलाह नगरी लै आअ।<verse eid="1SA 23:13" /></para>
  <para style="s">दाबेद रहअ धारा जुहल़ी लुक्‍की</para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 23:14" />तेखअ रहअ दाबेद धारा बाखे मुल्खै जीप रेगीस्ताना नेल़ लुक्‍की। शाऊल त कबल्‍लअ तेऊ लोल़अ लागअ द, पर बिधाता निं शाऊला सफल हणैं दैनअ। <verse eid="1SA 23:14" /><verse number="15" style="v" sid="1SA 23:15" />दाबेदै बी हेरअ ज़ाणीं कि शाऊल निं तेऊ मारनै बाझ़ी पिछ़ू हटी गअ।</para>
  <para style="p" vid="1SA 23:15">दाबेद त जीप रेगीस्ताना नेल़ होरेश नाओंए ज़ैगा। <verse eid="1SA 23:15" /><verse number="16" style="v" sid="1SA 23:16" />राज़ै शाऊलो शोहरू जोनातान पुजअ दाबेदा सेटा होरेश, संघा लागअ इहअ बोली तेऊ हैऊंदअ-बतैऊंदअ कि परमेशरा करनी तेरी फाज़त आप्पै। <verse eid="1SA 23:16" /><verse number="17" style="v" sid="1SA 23:17" />जोनातानै बोलअ इहअ, “तूह निं डरदअ लागी, मेरअ बाब शाऊल निं तेरी हान्‍नी करी सकदअ। तेऊ का आसा थोघ कि तूह आसा सह ई ज़ुंण तेऊ बाद आजू इज़राईलो राज़अ हणअ अर ताह बाद दुजी पदबी हणीं मेरी।” <verse eid="1SA 23:17" /><verse number="18" style="v" sid="1SA 23:18" />तेखअ किई तिन्‍नैं दुही ज़ण्हैं बिधाते सोह खाई करार कि म्हारी साथ रहणीं सदा। दाबेद रहअ होरेश ई अर जोनातान डेऊअ आपणैं घअरा लै फिरी।<verse eid="1SA 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1SA 23:19" />जीप नगरी का डेऊए कुंण गिबा नगरी शाऊला सेटा संघा खोज़अ तेऊ का, “दाबेद आसा म्हारै मुल्खै होरेश गहल़ै हकीला धारा लुक्‍कअ द। सह ज़ैगा आसा जशमोन रेगीस्ताने दखणा बाखा। <verse eid="1SA 23:19" /><verse number="20" style="v" sid="1SA 23:20" />माहा राज़अ, हाम्हां का आसा थोघ कि तूह तेऊ लोल़अ किहअ आसा लागअ द, तूह एछ म्हारै मुल्खा लै अर दाबेद तेरै हाथै दैणअ आसा म्हारअ काम।”<verse eid="1SA 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 23:21" />शाऊलै बोलअ तिन्‍नां लै, “मुल्है इहै खास्सै झ़ूरना लै लोल़ी, बिधाता तम्हां लै खास्सी बर्गत दैनी! <verse eid="1SA 23:21" /><verse number="22" style="v" sid="1SA 23:22" />ऐबै डेओआ, संघा लआ राम्बल़अ थोघ करी कि सह किधी ज़िहअ आसा अर सह तिधी कुंणी भाल़अ। मुखा खोज़अ कुंणी कि सह आसा खास्सअ च़लाक मणछ। <verse eid="1SA 23:22" /><verse number="23" style="v" sid="1SA 23:23" />राम्बल़अ थोघ करा कि सह कैहा ज़ैगा आसा लुक्‍कअ द, सोभै गल्‍ला राम्बल़ी ज़ाच़ी-भाल़ी एछै मुंह सेटा फिरी। तेखअ एछूं हुंह तम्हां संघै। ज़ै अज़ी बी सह तेऊ ई मुल्खै होए, सह लणअ मुंह ढाकी, च़ाऐ मुंह तेता लै सारै यहूदा मुल्खै किल्है निं लागे लोल़ै डेऊणअ।”<verse eid="1SA 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1SA 23:24" />जीप नगरी आल़ै तिंयां मणछ आऐ शाऊला का आजू फिरी। दाबेद अर तेऊए आदमी तै अराबा मिऊन नाओंए रेगीस्तानै जशमोन दखणा बाखा गऐ दै पुजी। <verse eid="1SA 23:24" /><verse number="25" style="v" sid="1SA 23:25" />शाऊल डेऊअ आपणैं आदमी संघा निंईं दाबेदा लोल़अ। ज़ांऊं दाबेदा का एतो थोघ लागअ, तैही निखल़अ सह उझै धारा का उंधै मिऊन रेगीस्ताना लै। शाऊला का हेरअ कुंणी खोज़ी अर सह डेऊअ तेथ दाबेदा लोल़अ। <verse eid="1SA 23:25" /><verse number="26" style="v" sid="1SA 23:26" />ऐबै हुअ इहअ कि धारा ओर्ही बाखा थिअ शाऊल अर धारा पोर्ही बाखा तै दाबेद अर तेऊए आदमी। दाबेदा त शाऊल अर तेऊए आदमी का दूर ठुर्हनेओ छ़ेक्‍कअ लागअ द अर शाऊले आदमी तै दाबेद अर तेऊए आदमी फेरा का गोटी आणै दै। <verse eid="1SA 23:26" /><verse number="27" style="v" sid="1SA 23:27" />तेतरी आअ एक दूत शाऊला सेटा संघा बोलअ इहअ, “ओर्ही एछा छ़ेक्‍कै! पलिश्ती गऐ इज़राईली मारदै भिई एछी!” <verse eid="1SA 23:27" /><verse number="28" style="v" sid="1SA 23:28" />तेखअ पाई शाऊलै दाबेदे पिछ़ै करने छ़ाड़, संघा डेऊअ सह पलिश्तीए मकाबलै करदअ। तैही पल़अ तैहा ज़ैगा नाओं बच़णे टोल्ह। <verse eid="1SA 23:28" /><verse number="29" style="v" sid="1SA 23:29" />तिधा का डेऊअ दाबेद एनगाद मुल्खा लै संघा रहअ तिधी लुक्‍की।<verse eid="1SA 23:29" /></para>
  <chapter eid="1SA 23" />
  <chapter number="24" style="c" sid="1SA 24" />
  <para style="s">दाबेदै बच़ाऊई शाऊले ज़िन्दगी</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 24:1" />पलिश्ती का जुध ज़िती ज़ांऊं शाऊल बापस फिरअ, तेऊ का खोज़अ कुंणी इहअ कि दाबेद आसा एनगाद रेगीस्तानै। <verse eid="1SA 24:1" /><verse number="2" style="v" sid="1SA 24:2" />शाऊलै निंयैं इज़राईला मांझ़ै आपणैं चअन हज़ार खास सपाही आप्पू संघै, तेखअ डेऊअ दाबेदा अर तेऊए आदमी शाफल़े खोखा दी लोल़अ ज़ेथ बणें बाकरै रहा। <verse eid="1SA 24:2" /><verse number="3" style="v" sid="1SA 24:3" />सह पुजअ भेडा-बाकरीए हेल़्ही डाहणां लै शाल़ा नेल़ एकी डुआरै, तिधी ती एक जुहल़ अर शाऊल डेऊअ तेथ भितरी संघा बेठअ दिशा। तैहा ई जुहल़ी तै दाबेद अर तेऊए आदमी पिछ़ू लुक्‍की बेठै दै। <verse eid="1SA 24:3" /><verse number="4" style="v" sid="1SA 24:4" />तिन्‍नैं बोलअ दाबेदा लै, “आझ़ आसा बै ताल्है मोक्‍कअ! एते ई बारै बोलअ त बिधाता ताल्है इहअ, ‘मुंह करनअ तेरअ दुशमण तेरै बशै, ताकि ज़िहअ तेरअ दिल च़ाहे, तूह तेऊ संघै तिहअ बभार करी सके।’”</para>
  <para style="p" vid="1SA 24:4">दाबेद आअ शाऊला नेल़ पिछ़ू संघा काटअ तलबारा करै तेऊए च़ोल़ै का एक शाट्टअ। शाऊला का निं तेतो थोघ ई लागअ। <verse eid="1SA 24:4" /><verse number="5" style="v" sid="1SA 24:5" />पर दाबेदा हुई तेते बडी माल़ी बी कि शाऊले च़ोल़ै का काटअ शाट्टअ अर <verse eid="1SA 24:5" /><verse number="6" style="v" sid="1SA 24:6" />तेऊ बोलअ आपणैं आदमी का, “बिधाता ज़ाणा ऐहा गल्‍ला, मुंह निं आपणैं मालक राज़ै शाऊला संघै इहअ लागा करनअ। मेरी आसा बिधाता का एही अरज़ कि इहअ बूरअ निं मेरै भलै भिई लोल़ी हुअ। नां मुंह अह मारनअ किल्हैकि अह आसा बिधाता आप्पै अभिषेक करी राज़अ बणाअं द।” <verse eid="1SA 24:6" /><verse number="7" style="v" sid="1SA 24:7" />इहअ करै समझ़ाऊऐ दाबेदै तैहा धैल़ी आपणैं आदमी, संघा निं तिन्‍नां शाऊला मारनै दैनअ।</para>
  <para style="p" vid="1SA 24:7">दिशा करी उझ़ुअ शाऊल अर जुहल़ी बागै निखल़ी लागअ आपणीं बाता हांढदअ। <verse eid="1SA 24:7" /><verse number="8" style="v" sid="1SA 24:8" />तेऊ पिछ़ू निखल़अ दाबेद बागै संघा लाई पिछ़ू का शाऊला लै हाक्‍का, “माहा राज़अ! मेरै मालक!” शाऊलै भाल़अ पिछ़ू अर दाबेदै किअ धरनीं माथअ टेक्‍की राज़ैओ अदर, <verse eid="1SA 24:8" /><verse number="9" style="v" sid="1SA 24:9" />संघा बोलअ दाबेदै शाऊला लै इहअ, “तूह किल्है शूणां तिन्‍नां मणछे गल्‍ला ज़ुंण इहअ बोला कि हुंह च़ाहा तेरी हान्‍नी करनी? <verse eid="1SA 24:9" /><verse number="10" style="v" sid="1SA 24:10" />आझ़ सका तूह आप्पू लै आप्पै भाल़ी कि ज़ाथी एभै किअ त तूह जुहल़ी भितरी बिधाता मेरै बशै। मेरै आदमी हेरअ त ताह मारना लै बी बोली, पर मुंह हुई तेरी खास्सी माल़ी अर मंऐं बोलअ इहअ कि मुंह निं तेरी किछ़ै हान्‍नी करनी। किल्हैकि तूह आसा मेरअ मालक ज़सरअ राज़ै हणां लै बिधाता आप्पै अभिषेक आसा किअ द। <verse eid="1SA 24:10" /><verse number="11" style="v" sid="1SA 24:11" />भाल़ मेरै बाब! राम्बल़ै करै भाल़! तेरै च़ोल़ै का आसा एक शाट्टअ काढी मंऐं आपणैं हाथै ढाकअ द! हुंह सका त ताह मारी बी, पर मंऐं काटअ तेरै च़ोल़े पाल्‍लै का सिधअ अह शाट्टअ। एता करै ता आई होए ताह समझ़ कि नां हुंह ताल्है द्रोह करदअ आथी लागअ द, अर नां हुंह तेरी हान्‍नी च़ाहंदअ करनअ। मंऐं ता निं ताल्है किछ़ै बूरअ किअ पर तूह आसा मुंह मारदअ शकारी ज़िहअ पिछ़ू पल़अ द! <verse eid="1SA 24:11" /><verse number="12" style="v" sid="1SA 24:12" />ऐहा गल्‍लो नसाफ करे बिधाता कि ताह अर मुंह मांझ़ै कुंण आसा गलत! ज़ुंण तंऐं मुंह संघै किअ, बिधाता लोल़ी तेता लै ताल्है आप्पै सज़ा दैनी। पर मुंह निं आप्पू तेरी धख बी हान्‍नी करनी। <verse eid="1SA 24:12" /><verse number="13" style="v" sid="1SA 24:13" />प्रोढै खोज़ा एही सैणीं गल्‍ल,</para>
  <para style="q" vid="1SA 24:13">‘बूरअ करा कदुष्ट ई।’</para>
  <para style="p" vid="1SA 24:13">“पर मुंह निं आप्पू तेरी धख बी हान्‍नी करनी। <verse eid="1SA 24:13" /><verse number="14" style="v" sid="1SA 24:14" />इहअ ता भाल़ा, इज़राईलो राज़अ कहा च़ाहा मारनअ! सह कसरै पिछ़ै आसा पल़अ द! मुंह पिछ़ू ज़ुंण कहा मूंऐं दै कुक्‍करा अर पिर्शू ज़िहअ बृथा आसा! <verse eid="1SA 24:14" /><verse number="15" style="v" sid="1SA 24:15" />तैही बोला हुंह, बिधाता करनअ आप्पै नसाफ अर तेऊ खोज़णअ कि हाम्हां दूई मांझ़ै कुंण आसा गलत। मेरअ बकील आसा सह ई अर ताह अर तेरै बला का बच़ाऊंणअ हुंह तेऊ ई।”<verse eid="1SA 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 24:16" />ज़ांऊं दाबेद एतरअ बोली मुक्‍कअ, तेखअ बोलअ शाऊलै, “दाबेद, मेरै बेटैआ, अह असली दी तूह ई आसा बोल्दअ लागअ द?” तेखअ लागअ शाऊल लेरा लांदअ। <verse eid="1SA 24:16" /><verse number="17" style="v" sid="1SA 24:17" />तेखअ बोलअ शाऊलै दाबेदा लै, “तंऐं बोलअ ठीक, एथ आसा हुंह ई गलत। तंऐं किअ मेरअ भलअ पर मंऐं किअ तेरअ बूरअ ई! <verse eid="1SA 24:17" /><verse number="18" style="v" sid="1SA 24:18" />आझ़ रहैऊई तंऐं अह गल्‍ल कि तूह मुल्है केतरअ भलअ आसा! बिधाता हेरअ त हुंह तेरै बशै करी अर तेऊ हेरअ त ताल्है मुंह मारनैओ मोक्‍कअ दैई पर तंऐं निं हुंह मारअ आथी। <verse eid="1SA 24:18" /><verse number="19" style="v" sid="1SA 24:19" />इहअ निं कोहै हंदअ कि आपणैं दुशमणा ढाकी तेऊ ज़िऊंदै छ़ाडे! ज़ुंण आझ़ तंऐं मुंह संघै किअ, तेता लै लोल़ी बिधाता ताल्है खास्सी बर्गत दैनी! <verse eid="1SA 24:19" /><verse number="20" style="v" sid="1SA 24:20" />ऐबै गअ मुखा पाक्‍कअ ज़ाण्हुंई कि तूह हणअ मुंह बाद इज़राईलो राज़अ अर इज़राईला प्रैंदै रहणअ सदा तेरअ राज़। <verse eid="1SA 24:20" /><verse number="21" style="v" sid="1SA 24:21" />पर बिधाता शाजत मनी दै मुल्है तूह एही ज़बान कि तूह निं मुंह बाद मेरी आद-लुआदा मारी आथी। ताकि आजू मेरै खिंबो नाअं बी रहे।”<verse eid="1SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 24:22" />दाबेदै दैनी तेऊ लै ज़बान अर तेखअ डेऊअ शाऊल आपणैं घअरा लै अर दाबेद अर तेऊए आदमी डेऊऐ गहल़ै तिन्‍नां ज़ैगा लै ज़िधी तिंयां लुक्‍की रहा तै।<verse eid="1SA 24:22" /></para>
  <chapter eid="1SA 24" />
  <chapter number="25" style="c" sid="1SA 25" />
  <para style="s">शमूएल गूरे मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 25:1" />शमूएल गूर गअ ज़ांऐं, सारै इज़राईली हुऐ कठा संघा लागै हिक्‍का पटाक्‍की लेरा लांदै। सह डाहअ तिन्‍नैं रामाह नगरी दाबी ज़िधी तेऊओ घअर थिअ।</para>
  <para style="s" vid="1SA 25:1">दाबेद अर अबीगेल</para>
  <para style="p" vid="1SA 25:1">तेता बाद डेऊअ दाबेद परान नाओंए रेगीस्ताना लै। <verse eid="1SA 25:1" /><verse number="2-3" style="v" sid="1SA 25:2-3" />तिधी त कालेब टोली का नबाल नाओं एक मशूर मणछ। सह थिअ मिऊन नगरीओ अर तेऊ ती कर्मेल नगरी नेल़ आप्पू लै ज़िम्मीं-ज़ैगा लई दी अर सह थिअ खास्सअ सेठ। तेऊ का थिई चअन हज़ार भेडा अर एक हज़ार बाकरीए हेल़्ह। तेऊए लाल़ी नाअं त अबीगेल अर सह थिई हेरनी बेघै बित्ती अर अक्ली आल़ी। पर नबाल त मंडरोश्शी अर सह निं कोहिए शुणदअ त।</para>
  <para style="p" vid="1SA 25:2-3">एकी धैल़ै त नबाल कर्मेल आपणीं भेडा मुनदअ लागअ द, <verse eid="1SA 25:2-3" /><verse number="4" style="v" sid="1SA 25:4" />दाबेदा का हेरी कुंणी रेगीस्तानै अह गल्‍ल खोज़ी कि नबाल आसा भेडा-बाकरीए हेल़्ही मुनदअ लागअ द। <verse eid="1SA 25:4" /><verse number="5" style="v" sid="1SA 25:5" />दाबेदै छ़ाडै आपणैं आदमी मांझ़ा का दस खारकै मणछ इहअ बोली कर्मेल नगरी लै, “कर्मेल नगरी डेऊई पुछ़ै कि नबाल किधी आसा, संघा एछै तेऊ लै मुंह बाखा राज्ज़ी-खुशी दैई। <verse eid="1SA 25:5" /><verse number="6" style="v" sid="1SA 25:6" />तम्हैं बोलै तेऊ लै, ‘दाबेदै आसा ताल्है एही राज्ज़ी-खुशी दैनी दी, “तूह अर तेरअ टबर लोल़ी राज्ज़ी-राम्बल़ै रहै अर तेरै लोल़ी हर गल्‍ला लै खास्सी बर्गत हुई।” <verse eid="1SA 25:6" /><verse number="7" style="v" sid="1SA 25:7" />तेऊ शूणीं एही गल्‍ला कि तूह आसा आपणीं भेडा मुनदअ लागअ द, तेऊ बोलअ इहअ, “ताखा झ़ाणीं थोघ आसा कि ज़धू तेरै फुआल कर्मेल नेल़ हाम्हां संघै थिऐ, हाम्हैं निं तिन्‍नें किछ़ हान्‍नी किई अर नां तेतरै धैल़ै तिन्‍नें डागै-चैणैं मांझ़ै च़ोरी हुई। <verse eid="1SA 25:7" /><verse number="8" style="v" sid="1SA 25:8" />तूह लअ आपणैं तिन्‍नां फुआला पुछ़ी बी अर तिन्‍नां हेरनअ खोज़ी।” तेऊ आसा बोलअ द इहअ कि मेरै ईंयां आदमी आऐ ताह सेटा थैरे धैल़ै, तूह समझ़ै इना ज़िहै कि ईंयां आसा तेरै आपणैं अर मुल्है बी आसा तूह साथी ज़िहअ। ज़ेतरअ अर ज़िहअ तेरै भलै हई सके, तेता दैऐ तूह इना लै अर मुल्है।’”<verse eid="1SA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 25:9" />दाबेदे तिंयां आदमी पुजै नबाला सेटा संघा खोज़अ तेऊ का दाबेदो अह समाद, तेखअ रहै तिंयां न्हैल़ै लागी कि तेऊ किज़ै ज़बाब दैणअ। <verse eid="1SA 25:9" /><verse number="10" style="v" sid="1SA 25:10" />खिरी दैनअ नबालै ज़बाब, “ईशैईओ शोहरू दाबेद, अह कुंण आसा? मंऐं ता कधू एऊए बारै शूणअ ई निं आथी! सारअ देश आसा इहै गलामा करै भर्हुअ द ज़ुंण आपणैं मालका सेटा का ठुर्है दै हआ! <verse eid="1SA 25:10" /><verse number="11" style="v" sid="1SA 25:11" />थारअ कै मतलब आसा? हुंह कै आपणीं रोटी-पाणीं अर ज़ुंण मंऐं आपणीं भेडा मुनणै आल़ै लै शिखा आसा बणाईं दी, तेता हुंह तम्हां लै दैंऊं? ज़ै कि मुखा निं इहअ थोघ बी आथी कि तम्हैं आसा किधे!” <verse eid="1SA 25:11" /><verse number="12" style="v" sid="1SA 25:12" />दाबेदे तिंयां आदमी डेऊऐ फिरी संघा खोज़अ तिन्‍नैं दाबेदा का पठी कि सह बोला इहअ-इहअ। <verse eid="1SA 25:12" /><verse number="13" style="v" sid="1SA 25:13" />तेखअ बोलअ दाबेदै आपणैं आदमी लै इहअ, “आपणीं-आपणीं तलबारा च़का!” ज़िहअ ई दाबेदै हुकम किअ, तिन्‍नैं कशी आपणीं तलबारा अर दाबेद बी लागअ आपणीं तलबार कशी हांढदअ अर तेऊ पिछ़ू च़लै तेऊए कोई च़ार शौ आदमी अर दूई शौ रहै पिछ़ू समाना पहरी।<verse eid="1SA 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 25:14" />नबाले एकी दासै हेरअ नबाले लाल़ी अबीगेला का खोज़ी, “ताखा थोघ बी लागअ? दाबेदै छ़ाडै तै रेगीस्ताना का म्हारै मालका सेटा राज्ज़ी-खुशी दैंदै पर तेऊ छ़ाडै तिंयां बेइज़त करी बापस! <verse eid="1SA 25:14" /><verse number="15" style="v" sid="1SA 25:15" />पर तिंयां मणछ डाहा तै हाम्हां संघै बेघै बधिया बभार, तिन्‍नैं निं हाम्हैं कधि हंतै, ज़ेतरै धैल़ै हाम्हैं तिन्‍नां संघै फुआल संघा रहै, म्हारी नां किज़ै हान्‍नी हुई अर नां म्हारै डागै-चैणैं मांझ़ै च़ोरी हुई। <verse eid="1SA 25:15" /><verse number="16" style="v" sid="1SA 25:16" />ज़ेतरै धैल़ै हाम्हैं आपणीं भेडा-बाकरीए हेल़्ही च़राऊंदै तिन्‍नां संघै रहै, तेतरै धैल़ै किई तिन्‍नैं म्हारी फाज़त। <verse eid="1SA 25:16" /><verse number="17" style="v" sid="1SA 25:17" />ज़ीबाण, एते बारै लआ भिई राम्बल़ै करै सोठी संघा करा बच़ार कि ऐबै किज़ै करनअ। अह गल्‍ल सका म्हारै मालक अर म्हारै सारै खिंबा लै खास्सी आफ़त पाई। मालक आसा म्हारअ बेघै बूरअ अर नां सह कोहिए शुणदअ।”<verse eid="1SA 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 25:18" />अबीगेलै किई तेभी दूई शौ रोटी कठा, दूई खाल्हल़ी भरी दाखे रसा करै, हेल़्ही का पांज़ा भेडा काटी सटेऊई तेते शिखा भुज़ी करै, एक मण मोल़ी, एक शौ दाखे लुम्बरू अर दूई शौ अंदल़ू निंईं फेडूए रोई संघा लादअ सह सारअ समान गाधै दी। <verse eid="1SA 25:18" /><verse number="19" style="v" sid="1SA 25:19" />तेखअ बोलअ तैहा आपणैं दासा लै, “तम्हैं डेओआ आजू अर हुंह आई तम्हां पिछ़ू-पिछ़ू।” तैहा निं आपणैं मर्ध नबाला का किछ़ै खोज़अ आथी।<verse eid="1SA 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 25:20" />सह होथी आपणैं गाधै प्रैंदै शुंआर आरा बाखा उंधै अर दाबेद अर तेऊए आदमी तै पारा बाखा उंधै होथी तैहा बाखा एछदै लागै दै। <verse eid="1SA 25:20" /><verse number="21" style="v" sid="1SA 25:21" />दाबेद त आपणैं मन्‍नैं इहअ सोठदअ लागअ द, “एतरी किई हाम्हैं नबाले चैणें फाज़त कि एक चैणअ बी निं कहा च़ोरनै दैनअ! पर सह मानदारी डेऊई बृथा! मेरी तैहा भलाई करने बदल़ै भाल़ तेऊ आझ़ किहअ बूरअ बभार किअ! <verse eid="1SA 25:21" /><verse number="22" style="v" sid="1SA 25:22" />हुंह खाआ आझ़ सोह कि राच भैणै का आजी ज़ै हुंह नबाले खिंबा दी एक लान्हअ बी ज़िऊंदअ छ़ाडूं, तै लोल़ी बिधाता इहअ ई हुंह बी मारअ!”<verse eid="1SA 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 25:23" />ज़ांऊं अबीगेला का दाबेद शुझुअ, सह होथी झ़ट-पटै गाधै का उंधै संघा टेक्‍कअ धरनीं उटी पल़ी दाबेदे खूरा सेटा माथअ। <verse eid="1SA 25:23" /><verse number="24" style="v" sid="1SA 25:24" />तेखअ बोलअ तैहा दाबेदा लै इहअ, “हे मेरै मालक, ऐहा गलती करने सज़ा लोल़ी मुंह भेटी, ज़ीबाण, मेरी गल्‍ल शुण! <verse eid="1SA 25:24" /><verse number="25" style="v" sid="1SA 25:25" />ज़ीबाण मेरै मालक, नबालै ज़ुंण बूरअ किअ तेथ निं तूह धैन दैई। सह आसा पैहलै ई का इहअ ई मंडरोश्शी। सह आसा ज़िहअ तेऊओ नाअं आसा तिहअ ई ऐडअ। ज़ुंण तंऐं आदमी छ़ाडै तै, तिंयां निं मंऐं भाल़ै आथी, तै झ़ाणीं आझ़ इहअ नांईं हंदअ। <verse eid="1SA 25:25" /><verse number="26" style="v" sid="1SA 25:26" />ऐबै हे मेरै मालक, सह आसा बिधाता ज़ुंण ताह बदल़ै लणैं का रोक्‍की डाहा अर तेरै दुशमणा मारा। हुंह काढा ज़िऊंदै बिधाते नाओंऐं सोह कि तेरै दुशमण अर तिंयां सोभै ज़ुंण तेरी हान्‍नी च़ाहा, तिन्‍नां लोल़ी नबाला ज़ेही सज़ा भेटी।<verse eid="1SA 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1SA 25:27" />“ज़ीबाण मेरै मालक, मंऐं आणी ताल्है अह भैंट, तूह ढाक संघा दै आपणैं आदमी लै। <verse eid="1SA 25:27" /><verse number="28" style="v" sid="1SA 25:28" />मेरै मालक, ज़ुंण मेरै भलै गलती हुई, तेता लै छ़ाड तूह मुल्है माफी। बिधाता बणाणअं तूह राज़अ अर आजू करनअ तेरी आद-लुआदा राज़, किल्हैकि तूह आसा तेऊ लै जुधा लल़दअ लागअ द। मेरी आसा बिधाता का एही अरज़ कि तेरै भलै निं लोल़ी त तेरी सारी ज़िन्दगी किछ़ै बूरअ हुअ। <verse eid="1SA 25:28" /><verse number="29" style="v" sid="1SA 25:29" />मेरै मालक, ज़ै कुंण मणछ तेरै पिछ़ै पल़े अर ताह मारदअ एछे, तेता का बच़ाऊंणअ तूह बिधाता किम्मती खज़ानै ज़िहअ। पर तेरै दुशमण शोटणै तेऊ दूर, फर्णैक्‍की करै पात्थरा ज़िहै दूर। <verse eid="1SA 25:29" /><verse number="30" style="v" sid="1SA 25:30" />तैही बोला हुंह मेरै मालक, बिधाता करनी तिंयां सोभै भली गल्‍ला ताल्है पूरी ज़ेते तेऊ ज़बान आसा किई दी। तेऊ बणाणअं तूह इज़राईलीओ राज़अ। <verse eid="1SA 25:30" /><verse number="31" style="v" sid="1SA 25:31" />तेभै निं भाल़ ताह किछ़ू गल्‍लो पछ़ताअ हणअ, नां ताह किज़ू गल्‍ले माल़ी च़ेतणी, किल्हैकि ताह दी निं बदल़ै लणैं अर नर्दोश मणछे हत्या करनैओ दोश हणअ। हे मेरै मालक, ज़ेभै बिधाता ताल्है सोभी गल्‍ले बर्गत दैई हेरे, तेभै निं मुंह बिस्सरी आथी।”<verse eid="1SA 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1SA 25:32" />दाबेदै बोलअ अबीगेला लै, “इज़राईलो परमेशर बिधाता आसा ताल्है खुश, ज़ुंणीं तूह आझ़ मुंह सेटा लै छ़ाडी। <verse eid="1SA 25:32" /><verse number="33" style="v" sid="1SA 25:33" />हुंह करा बिधातो एता लै शूकर कि ताह भाल़ केही सोर-समझ़ आसा! ज़ुंण काम तंऐं आझ़ किअ, बिधाता लोल़ी तेता पिछ़ू ताल्है खास्सी बर्गत दैनी। किल्हैकि तंऐं बच़ाऊअ हुंह आझ़ हत्या करनै का अर आपणैं हाथै आपणअ बदल़अ लणें दोशा का। <verse eid="1SA 25:33" /><verse number="34" style="v" sid="1SA 25:34" />इज़राईले परमेशर बिधाता आसा हुंह सच्च़ी थारी हान्‍नी करनै का रोक्‍की डाहअ द। हुंह खाआ बिधाते सोह, ज़ै तूह मुंह सेटा छ़ेक्‍कै निं आई हंदी, राच भैणै का आजी निं नबाल अर तेऊए खिंबो एक लान्हअ बी ज़िऊंदअ छ़ुटणअ त!”<verse eid="1SA 25:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1SA 25:35" />तेखअ ढाकी दाबेदै तिंयां सोभै च़िज़ा ज़ुंण अबीगेलै आणी ती। संघा बोलअ तैहा लै इहअ, “तूह डेऊ राज्ज़ी-राम्बल़ी आपणैं घअरा लै, तूह निं फिकर करी, हुंह करूं ज़िहअ तंऐं बोलअ तिहअ ई।”<verse eid="1SA 25:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1SA 25:36" />अबीगेल डेऊई फिरी नबाला सेटा। तैहा भाल़अ घअरै कि नबाल आसा घअरै राज़ै ज़िहअ भोज़ करदअ लागअ द। तेऊ त खास्सअ नशअ किअ द अर तैही निं तेखअ तैहा दोत्ती राच भैणै तैणीं तेऊ लै किछ़ै बोलअ। <verse eid="1SA 25:36" /><verse number="37" style="v" sid="1SA 25:37" />दोत्ती ज़ांऊं नबालो नशअ मुक्‍कअ, तेखअ खोज़ी तैहा पठी गल्‍ला। तेऊ हाथुऐ नकैक्‍कै अर तेऊए गल़ै बाझ़अ शाण-शाफल़। <verse eid="1SA 25:37" /><verse number="38" style="v" sid="1SA 25:38" />कोई दसा धैल़ै बाद दैनी बिधाता नबाला लै एही मार कि सह हुअ मरी खतम।<verse eid="1SA 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1SA 25:39" />ज़ांऊं नबाला मरने गल्‍ला दाबेदै शूणीं, तेऊ बोलअ इहअ, “बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई! मेरी बेइज़ती करनैओ बदल़अ लअ तेऊ नबाला का आप्पै, हुंह अर मेरै आदमी डाहै तेऊ गलती करनै का बच़ाऊई। बिधाता दैनी नबाला लै तेऊए बूरै करने सज़ा।”</para>
  <para style="p" vid="1SA 25:39">तेखअ छ़ाडै बादा का दाबेदै आपणैं आदमी अबीगेला सेटा कि तिंयां अबीगेला संघै दाबेदे गल्‍ला लाए। <verse eid="1SA 25:39" /><verse number="40" style="v" sid="1SA 25:40" />दाबेदे आदमी पुजै कर्मेल अबीगेला सेटा संघा बोलअ इहअ, “दाबेदै आसा हाम्हैं ताह निंदै छ़ाडै दै कि तेऊ करनअ ताह संघै बैह।”<verse eid="1SA 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1SA 25:41" />अबीगेलै टेक्‍कअ धरनीं उटी बाखा माथअ संघा बोलअ इहअ, “मेरै मालक, हुंह आसा तेरी दासी, हुंह आसा दाबेदे दासीए खूरा धोणें च़ाकरी करना लै बी तैर।” <verse eid="1SA 25:41" /><verse number="42" style="v" sid="1SA 25:42" />अबीगेल उझ़ुई छ़ेक्‍कै खल़ी संघा हुई आपणैं गाधै प्रैंदै शुंआर, तेसे पांज़ साथणीं बी आई तैहा पिछ़ू-पिछ़ू, सह लागी दाबेदै छ़ाडै दै तिन्‍नां दूता पिछ़ू हांढदी। तेखअ हुई सह दाबेदे लाल़ी। <verse eid="1SA 25:42" /><verse number="43" style="v" sid="1SA 25:43" />दाबेदै त जज्रेल नगरीए आहीनोमा संघै बी बैह किअ द अर ऐबै किअ तेऊ अबीगेला संघै बैह। <verse eid="1SA 25:43" /><verse number="44" style="v" sid="1SA 25:44" />पर ज़ुंण शाऊलै आपणीं शोहरी मिकलो बैह दाबेदा संघै किअ द, तेऊ दैनी सह गलीम नगरीए लैशे शोहरू पलती लै।<verse eid="1SA 25:44" /></para>
  <chapter eid="1SA 25" />
  <chapter number="26" style="c" sid="1SA 26" />
  <para style="s">दाबेदै छ़ाडअ शाऊल भिई ज़िऊंदअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 26:1" />जीप नगरी का डेऊऐ भिई कोई आदमी शाऊला सेटा गिबा नगरी संघा बोलअ इहअ, “दाबेद हआ रेगीस्ताना पार जशमोन नेल़ हकीला धारा लुक्‍कअ द।” <verse eid="1SA 26:1" /><verse number="2" style="v" sid="1SA 26:2" />शाऊल डेऊअ जीप रेगीस्तानै दाबेदा लोल़अ, आप्पू संघा निंयैं इज़राईला का छ़ांटी करै चअन हज़ार शूरबीर खास जोधै। <verse eid="1SA 26:2" /><verse number="3" style="v" sid="1SA 26:3" />संघा पाऐ तिन्‍नैं जशमोन सम्हनै हकीला नाओंए धारा डेरै। पर दाबेद त अज़ी बी रेगीस्तानै लुक्‍की रहअ द। ज़ांऊं तेऊ का थोघ लागअ कि शाऊल आसा भिई तेऊ लोल़अ लागअ द, <verse eid="1SA 26:3" /><verse number="4" style="v" sid="1SA 26:4" />दाबेदै छ़ाडै आपणैं आदमी भेख लंदै कि तिंयां भाल़े कि शाऊल सच्च़ी आअ। <verse eid="1SA 26:4" /><verse number="5" style="v" sid="1SA 26:5" />तेखअ डेऊअ दाबेद एकी राची तैहा ई ज़ैगा लै ज़िधी शाऊल अर तेऊओ सैनापति नेरीओ शोहरू अबनेर सुत्तै दै थिऐ। शाऊल त डेरै भितरी सुत्तअ द अर तेऊए आदमी तै तेऊ फेर डेरै पाऐ दै। <verse eid="1SA 26:5" /><verse number="6" style="v" sid="1SA 26:6" />तेखअ पुछ़अ दाबेदै हित्ती आहीमोलका अर सरूयाहे शोहरू जोआबे भाई अबीशै का, “मुंह संघै शाऊले दला जैंदरी डेरै लै कहा एछणअ?”</para>
  <para style="p" vid="1SA 26:6">अबीशै दैनअ ज़बाब, “हुंह एछूं ताह संघै।”<verse eid="1SA 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 26:7" />तैहा राची डेऊअ तेखअ दाबेद अर अबीशै शाऊले दला नेल़ अर तिन्‍नैं भाल़अ कि शाऊल आसा आपणैं खिम्भा दी मांझ़ा-मांझ़ी आपणैं खिम्भा दी सुत्तअ द अर आपणअ बर्छ़अ आसा तेऊ शरैहणा सेटा धरनीं खबेहुई डाहअ द। अबनेर अर तेऊए जोधै सपाही आसा शाऊला फेर सुत्तै दै। <verse eid="1SA 26:7" /><verse number="8" style="v" sid="1SA 26:8" />अबीशै बोलअ दाबेदा लै, “आझ़ राची दैनअ बिधाता तेरअ दुशमण तेरै हाथै, मंऐं लाई एऊ लै एऊए ई बर्छ़ै करै उपरा बाखा एही ज़ोरै बाही कि बर्छ़अ लोल़ी तेऊए घेरी बाती उंधै धरनीं खुभअ अर दुजी बाहणें निं ज़रुरत ई लोल़ी पल़ी!”<verse eid="1SA 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 26:9" />पर दाबेदै बोलअ अबीशै लै इहअ, “तूह निं एऊ मारदअ लागी! ज़ुंण बिधाता अभिषेक किऐ दै राज़ै मारे, सह निं बिधाता का बच़ी सकदअ।” <verse eid="1SA 26:9" /><verse number="10" style="v" sid="1SA 26:10" />तेखअ बोलअ दाबेदै इहअ, “हुंह बोला बिधाते नाओंऐं कि बिधाता मारनअ शाऊल आप्पै। कि मरनअ अह जुधा दी, कि मरनअ खिरी आपणीं मौता। <verse eid="1SA 26:10" /><verse number="11" style="v" sid="1SA 26:11" />बिधाता लोल़ी हुंह ऐहा गल्‍ला का दूर डाहअ कि हुंह तेऊओ अभिषेक किऐ दै राज़ै मारे! हाम्हां करनअ इहअ कि एऊओ बर्छ़अ अर पाणीं झुटणें झ़ारी निंणीं हाम्हां च़की संघा लागणअ हांढदै।” <verse eid="1SA 26:11" /><verse number="12" style="v" sid="1SA 26:12" />दाबेदै च़कअ शाऊले शरैहणा सेटा का शाऊलो बर्छ़अ अर पाणीं झुटणें झ़ारी संघा लागै दाबेद अर अबीशै दुहै ज़ण्हैं तिधा का हांढदै। तिधी निं तिंयां कोही भाल़ै अर नां कहा का थोघ लागअ कि तिधी किज़ै हुअ। तिधी निं ओर्ही-पोर्ही कहा होरीए नींज बी डेऊई किल्हैकि बिधाता तै तिंयां सोभ घणीं निंजा डाहै दै सताऊई।<verse eid="1SA 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 26:13" />तेखअ डेऊअ तिधा का दाबेद तिन्‍नां सम्हनै पारा बाखा धारा लै, शाऊले सैना का थिअ ऐबै दाबेद खास्सअ दूर। <verse eid="1SA 26:13" /><verse number="14" style="v" sid="1SA 26:14" />धारे चुंडी खल़्हुई लाई दाबेदै शाऊले सैनापति नेरीए शोहरू अबनेरा लै ज़ोरै-ज़ोरै हाक्‍का, “हे अबनेरा! ताखा मेरी हाक बी शुण्हिंआं?”</para>
  <para style="p" vid="1SA 26:14">अबनेरै किअ होए, संघा पुछ़अ, “लै तूह कुंण आसा हाक्‍का लाई राज़ै निंजा का झ़ैऊंदअ लागअ द?”<verse eid="1SA 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 26:15" />दाबेदै दैनअ ज़बाब, “अबनेर, तूह कै इज़राईला दी महान शूरबीर निं आथी? तै तूह आपणैं मालके फाज़त किल्है निं बोल़अ करी। एभै डेऊअ त भाल़ कुंण सैने दला जैंदरी डेरै भितरी तेरै मालक राज़ै मारदअ। <verse eid="1SA 26:15" /><verse number="16" style="v" sid="1SA 26:16" />अबनेर, तंऐं निं आपणअ काम सुआंतीओ किअ! हुंह काढा ज़िऊंदै बिधाते सोह कि तम्हैं इहै आसा मारनै ई जोगी, किल्हैकि तम्हैं निं आपणैं मालके फाज़त बी करी बोल़दै ज़ुंण बिधाता अभिषेक करी राज़अ बणाअं! भाल़णीं दै! राज़ैओ बर्छ़अ अर शरैहणैं डाही दी पाणीं झुटणें झ़ारी किधी आसा?”<verse eid="1SA 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1SA 26:17" />शाऊलै हेरअ गल्‍ला का बछ़ैणीं कि अह आसा दाबेद, तेऊ बोलअ, “दाबेद, बेटैआ अह आसा तूह बोल्दअ लागअ द भाल़ी?”</para>
  <para style="p" vid="1SA 26:17">दाबेदै दैनअ ज़बाब, “हाँ, माहा राज़अ मेरै मालक हुंह आसा। <verse eid="1SA 26:17" /><verse number="18" style="v" sid="1SA 26:18" />हे मेरै मालक, हुंह आसा तेरअ दास, तूह किल्है आसा मेरै पिछ़ै पल़अ द? मेरअ किज़ै कशूर आसा? इहअ बी कै ज़ुल्म किअ मंऐं? <verse eid="1SA 26:18" /><verse number="19" style="v" sid="1SA 26:19" />माहा राज़अ! मेरै मालक, ज़ीबाण तूह शुण मेरी गल्‍ला कि हुंह किज़ै बोला। ज़ै तूह बिधाता आप्पै होए मेरै पिछ़ै करदअ लाअ द, सह ता सका हई कि बल़ीदान दैई बदल़ी जाए, पर ज़ै होए तूह कुंणी मणछै शगरेऊई डाहअ द, तिन्‍नां लोल़ी एता पिछ़ू बिधातो फिटक लागअ कि तिन्‍नैं काढअ हुंह बिधाते देश अर ज़ैगा का दूर कि हुंह परदेसै पराऐ देबतै पूज़दअ लागूं! <verse eid="1SA 26:19" /><verse number="20" style="v" sid="1SA 26:20" />मुंह निं बिधाते ज़ैगा का दूर पराऐ देशै मरनै दैऐ। इज़राईलो राज़अ किल्है आसा मुंह ज़िहै पिर्शू मारदअ आअ द? सह किल्है आसा मेरै पिछ़ै पल़अ द कि तित्तरा ज़िहअ मेरअ शकार करे।”<verse eid="1SA 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 26:21" />शाऊलै दैनअ ज़बाब, “मेरै भलै हुई बडी भूल, दाबेद, मेरै बेटैआ, तूह एछ घअरा लै फिरी! हुंह निं ऐबै ताल्है किछ़ै करदअ। आझ़ राची बी थिअ ताखा मुंह मारनैओ मोक्‍कअ पर तंऐं डाहअ हुंह ज़िऊंदअ। हुंह आसा ऐडअ! मंऐं किअ घोर पाप!”<verse eid="1SA 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1SA 26:22" />दाबेदै दैनअ ज़बाब, “माहा राज़अ, इधी आसा भाल़ तेरअ बर्छ़अ, आपणैं आदमी मांझ़ै छ़ाड कहा ओर्ही कि सह एता पोर्ही निंए। <verse eid="1SA 26:22" /><verse number="23" style="v" sid="1SA 26:23" />बिधाता दैआ तिन्‍नां लै तेतो फल ज़ुंण धर्मीं अर शुचै-पाक्‍कै रहा। बिधाता दैनअ त तूह आझ़ मेरै हाथै पर मंऐं निं तेरी किछ़ै हान्‍नी किई ज़ुंण बिधाता आप्पै अभिषेक करी आसा राज़अ बणाअं द। <verse eid="1SA 26:23" /><verse number="24" style="v" sid="1SA 26:24" />ज़िहअ मंऐं आझ़ तूह ज़िऊंदअ छ़ाडअ, तिहअ लोल़ी बिधाता मुल्है बी किअ अर ईंयां सारी आफ़ता लोल़ी मुखा दूर किई!”<verse eid="1SA 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1SA 26:25" />शाऊलै बोलअ दाबेदा लै, “मेरै बेटैआ, बिधाता लोल़ी ताल्है खास्सी बर्गत दैनी! तूह लोल़ी तेरै हर कामां लै सफल हुअ!”</para>
  <para style="p" vid="1SA 26:25">दाबेद लागअ तिधा का आपणीं बाता हांढदअ अर शाऊल डेऊअ घअरा लै फिरी।<verse eid="1SA 26:25" /></para>
  <chapter eid="1SA 26" />
  <chapter number="27" style="c" sid="1SA 27" />
  <para style="s">दाबेद डेऊअ पलिश्ती संघै</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 27:1" />दाबेद लागअ इहअ सोठदअ, “एकी नां एकी धैल़ै मारनअ हुंह शाऊला ज़रूर, ऐबै आसा मेरी भलाई एता ई दी कि हुंह ठुर्हूं पलिश्तीए देशा लै। हई सका कि तेखअ शाऊल इज़राईल देशै मुंह लोल़णें छ़ाड़ पाए अर हुंह बी रहणअ बच़ी।”<verse eid="1SA 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 27:2" />तेखअ डेऊऐ दाबेद अर तेऊए छ़ह शौ आदमी गात नगरीए राज़ै माओके शोहरू आकीशा सेटा। <verse eid="1SA 27:2" /><verse number="3" style="v" sid="1SA 27:3" />तेखअ लागै दाबेद अर तेऊए सोभ आदमी आपणैं टबरा संघी गात नगरी आकीश राज़ै सेटा रहंदै। दाबेदे बेटल़ी जज्रेला का आणी दी आहीनोम अर कर्मेल नगरी का आणी दी नबाले बेटल़ी अबीगेल बी थिई दुहै तेऊ संघा। <verse eid="1SA 27:3" /><verse number="4" style="v" sid="1SA 27:4" />ज़ांऊं शाऊला का थोघ लागअ कि दाबेद ठुर्हअ गात नगरी लै, तेखअ पाई तेऊ दाबेदा लोल़णें छ़ाड़।<verse eid="1SA 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 27:5" />दाबेदै बोलअ आकीश राज़ै लै, “ज़ै तूह मुल्है खास्सअ झ़ूरा, तै दै मुल्है आपणैं देशै एक होछ़ी ज़ेही नगरी ज़िधी हुंह आपणैं आदमी संघै बस्सी सकूं। ताह संघै राज़धानी दी रहणअ निं हुंह शोभदअ आथी।” <verse eid="1SA 27:5" /><verse number="6" style="v" sid="1SA 27:6" />तेखअ दैनी आकीशै दाबेदा लै सकाल़ग नगरी। तैही आसा आझ़ तैणीं बी सकाल़ग नगरीए मालक यहूदा मुल्खै राज़ै।<verse eid="1SA 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 27:7" />दाबेद रहअ एक साल च़ऊ भिन्‍नैं तैणीं पलिश्तीए देशै। <verse eid="1SA 27:7" /><verse number="8" style="v" sid="1SA 27:8" />एतरै भिन्‍नैं छ़ेल़अ दाबेदै अर तेऊए आदमी गशूरी, गिज़ी अर अमोलकी संघै जुध। ईंयां ज़ाती ती तेऊ देशै खास्सै ज़मानै ओर्ही सूर पोर्ही मिसर देशे सिऊंआं तैणीं बस्सी दी। <verse eid="1SA 27:8" /><verse number="9" style="v" sid="1SA 27:9" />दाबेदै किई तिन्‍नें नगरी पठी बरैबाद अर तिन्‍नां मांझ़ै निं मर्ध-बेटल़ी कोहै ज़िऊंदै छ़ाडै। तिन्‍नें भेडा-बाकरी, गाऊई-बल्द, गाधै, ऊँटे हेल़्ही, झिकल़ै अर किम्मती समान आणा त दाबेद लुटी संघा एछा त आकीश राज़ै सेटा फिरी। <verse eid="1SA 27:9" /><verse number="10" style="v" sid="1SA 27:10" />राज़अ आकीश करा त तेऊ का पुछ़ी, “आझ़ किनी डेऊअ त तूह कहा गोटदअ?” दाबेद बोला त इहअ कि हुंह डेऊअ यहूदा मुल्खै दखणा बाखा, केभै खोज़ा त जर्मेल टोलीए मुल्खै अर केभै बोला त हुंह डेऊअ तेऊ मुल्खै ज़ेथ कैनी आसा बस्सै दै। <verse eid="1SA 27:10" /><verse number="11" style="v" sid="1SA 27:11" />दाबेदै पाऐ तै तिंयां सोभ मारी, तेथ निं मर्ध-बेटल़ी मांझ़ै एक बी ज़िऊंदअ छ़ाडअ, इहअ करै निं गात नगरी पुजी राज़ै आकीशा का खोज़णैं आल़अ कोहै बच़अ कि दाबेदै असली दी किज़ै किअ। ज़धा पोर्ही सह पलिश्ती देशै रहअ, तधा बाद रहअ सह इहअ ई करदअ लागी।<verse eid="1SA 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 27:12" />आकीश राज़ै ज़ाणअ इहअ कि दाबेद आसा शुची गल्‍ला खोज़दअ लागअ द अर सह लागअ इहअ सोठदअ, “एऊ ता आपणैं लोगा इज़राईली संघै बेघै खास्सी ज़ीद पल़ी! ऐबै डाहणअ मुंह सदा लै अह आपणअ दास बणाईं।”<verse eid="1SA 27:12" /></para>
  <chapter eid="1SA 27" />
  <chapter number="28" style="c" sid="1SA 28" />
  <para style="p">
    <verse number="1" style="v" sid="1SA 28:1" />थोल़ै धैल़ै बाद हुअ इहअ कि पलिश्ती झाल़ी इज़राईली संघै जुध छ़ेल़णा लै आपणीं सैना अर आकीश राज़ै बोलअ दाबेदा लै, “मेरै साबै गई ताह समझ़ एछी कि ताह अर तेरै आदमी हुअ मुंह बाखा इज़राईली संघै जुध करनअ।”<verse eid="1SA 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1SA 28:2" />दाबेदै बोलअ, “हाँ, हुंह आसा तेरअ दास, ताखा बी जाणअ आप्पै शुझुई कि हुंह किज़ै सका करी।”</para>
  <para style="p" vid="1SA 28:2">आकीशै बोलअ, “ठीक आ, तूह डाहणअ मुंह तेखअ सदा आप्पू ई संघा मेरी फाज़त करनै आल़अ शूरबीर।”<verse eid="1SA 28:2" /></para>
  <para style="s">शाऊल डेऊअ मणशाण झ़ैऊंणै आल़ी बेटल़ी पुछ़दअ</para>
  <para style="p">
    <verse number="3" style="v" sid="1SA 28:3" />शमूएल गूर त मरी गअ द, सोभी इज़राईली लाई ती तेऊ लै आपणीं हिक्‍का पटाक्‍की लेरा संघा त सह रामाह नगरी दाबी हेरअ द ज़िधी तेऊओ घअर थिअ। शाऊलै तै मणशाण झ़ैऊंणै आल़ै आपणैं देशा का बागै काढै दै।<verse eid="1SA 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 28:4" />पलिश्ती हुऐ कठा संघा पाऐ शूनेम नगरी नेल़ जुधा लै आपणैं डेरै। शाऊलै बी झाल़ै इज़राईली संघा पाऐ पलिश्ती संघै मकाबलै करना लै गिलबा धारा डेरै। <verse eid="1SA 28:4" /><verse number="5" style="v" sid="1SA 28:5" />ज़ांऊं शाऊला का पलिश्तीए सैना शुझुई, तेऊ फिरअ तिन्‍नां भाल़ी डरै दर्छ़णअ। <verse eid="1SA 28:5" /><verse number="6" style="v" sid="1SA 28:6" />शाऊल लागअ बिधाता पुछ़दअ कि हुंह किज़ै करूं? पर बिधाता निं तेऊ लै किछ़ै ज़बाब दैनअ, नां धैनै-सुपनै बिधाता किज़ै खोज़अ, नां प्रशण बाही अर नां कहा गूरा का बाती तेऊ संघै बिधाता गल्‍ला किई। <verse eid="1SA 28:6" /><verse number="7" style="v" sid="1SA 28:7" />तेखअ किअ शाऊलै आपणैं कार-करिंदै लै हुकम, तम्हैं आणा कहा बेटल़ी लोल़ी ज़ुंण मणशाण झ़ैऊआ।</para>
  <para style="p" vid="1SA 28:7">तिन्‍नैं बोलअ, “एनदोर नगरी आसा एक बेटल़ी ज़ुंण मणशाण झ़ैऊआ।”<verse eid="1SA 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 28:8" />शाऊलै बदल़अ आपणअ भेश, घेरी बान्हैं आम झिकल़ै, आप्पू संघा निंयैं दूई मणछ संघा पुजअ राचो-राच तैहा बेटल़ी सेटा। तेऊ बोलअ तैहा लै, “तूह पुछ़ मुल्है मणशाण अर ज़सरअ नाअं हुंह खोज़ूं, तूह झ़ैऊ तेऊओ मणशाण?”<verse eid="1SA 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 28:9" />तैहा बेटल़ी दैनअ ज़बाब, “तूह किल्है आसा मुंह पटंकदअ लागअ द, तंऐं किल्है लाई हुंह मारनै बझ़ैल़ी? ताखा थोघ निं आथी कि शाऊलै काढै मुंह ज़िहै मणशाण झ़ैऊंणै आल़ै इज़राईल देशा का दूर!”<verse eid="1SA 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1SA 28:10" />शाऊलै काढै तैहा सेटा सोह संघा बोलअ इहअ, “ज़िऊंदै बिधाते नाओंऐं दैआ हुंह ताल्है ज़बान कि एता पिछ़ू निं ताल्है किछ़ै हंदअ।”<verse eid="1SA 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 28:11" />तेखअ पुछ़अ तैहा बेटल़ी, “हुंह ताल्है कहा मणछो मणशाण झ़ैऊं?”</para>
  <para style="p" vid="1SA 28:11">शाऊलै दैनअ ज़बाब, “शमूएलो!”<verse eid="1SA 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1SA 28:12" />ज़ांऊं तैहा बेटल़ी का शमूएल शुझुअ, तैहा पाई ज़ोरै लैल़ा संघा बोलअ शाऊला लै इहअ, “तंऐं किल्है दैनअ मुल्है धोखअ? तूह आसा राज़अ शाऊल!”<verse eid="1SA 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 28:13" />राज़ै बोलअ तैहा लै, “डरै निं आथी! खोज़, ताखा कै शुझिआ?”</para>
  <para style="p" vid="1SA 28:13">तैहा बोलअ राज़ै शाऊला लै, “मेरै मालक, मुखा शुझिआ एक देअ धरती का उझै निखल़दअ।”<verse eid="1SA 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1SA 28:14" />शाऊलै पुछ़अ तैहा का, “एऊए नर्हांग कहा ज़ेही आसा?”</para>
  <para style="p" vid="1SA 28:14">तैहा बेटल़ी बोलअ, “एक प्रोढअ मणछ शुझिआ मुखा च़ोल़अ बान्हीं उझै एछदअ।”</para>
  <para style="p" vid="1SA 28:14">तेखअ हेरअ शाऊलै ज़ाणीं कि अह आअ शमूएल, तेऊ टेक्‍कअ धरनीं उटी बाखा शमूएला लै माथअ।<verse eid="1SA 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 28:15" />शमूएलै बोलअ शाऊला लै, “तूह किल्है आसा मुंह हंतदअ लागअ द? तंऐं किल्है फरेऊअ हुंह बापस?”</para>
  <para style="p" vid="1SA 28:15">शाऊलै दैनअ ज़बाब, “मुल्है पल़ी खास्सी आफ़त! पलिश्ती आसा मुंह संघै जुधा लै डेरै पाऐ दै अर बिधाता बी डाहअ हुंह कल्ही शोटी! ऐबै नां सह मेरै धैनै-सुपनै एछदअ अर नां मुंह संघै कहा गूरा बाती गल्‍ला करदअ। तैही शादअ मंऐं तूह ताकि तूह मुखा खोज़े कि हुंह ऐबै किज़ै करूं?”<verse eid="1SA 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 28:16" />शमूएलै बोलअ इहअ, “ज़ै बिधाता ताह कल्ही शोटी तेरअ दुशमण आसा बणी गअ द, तै किज़ू आसा तूह मुंह पुछ़दअ लागअ द? <verse eid="1SA 28:16" /><verse number="17" style="v" sid="1SA 28:17" />बिधाता किअ ताल्है तिहअ ई ज़िहअ तेऊ मुखा पैहलै ई त खोज़ी हेरअ द। तेऊ दैनअ ताखा राज़ छ़ड़ैऊई दाबेदा लै। <verse eid="1SA 28:17" /><verse number="18" style="v" sid="1SA 28:18" />तंऐं निं ज़िहअ बिधाता बोलअ तिहअ किअ अर तंऐं निं अमोलकी अर तिन्‍नें ज़ैदात पठी खतम किऐ! तैही आसा बिधाता आझ़ तेरी एही दशा किई दी। <verse eid="1SA 28:18" /><verse number="19" style="v" sid="1SA 28:19" />बिधाता दैणअ इहअ हणैं कि काल्‍ला हारनै इज़राईली पलिश्ती का! अर तूह अर तेरअ शोहरू बी पुजणैं काल्‍ला इधी मुंह सेटा मूंऐं दै मणछे संसारै।”<verse eid="1SA 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1SA 28:20" />शाऊल पल़अ धरनीं उटी बाखा लाम्मअ संघा लागअ शमूएले गल्‍ला शूणीं डरै काम्बदअ। तेऊ निं तेखअ सारी धैल़ी नां राची रोटी खाई अर तेऊए मूंऐं तराण पठी। <verse eid="1SA 28:20" /><verse number="21" style="v" sid="1SA 28:21" />तेखअ डेऊई सह बेटल़ी शाऊला सेटा, ज़ांऊं तैहा भाल़अ कि तेऊ निं हैल़ी हांस ई रहै, तेखअ बोलअ तैहा तेऊ लै, “माहा राज़अ, तेरी गल्‍ला मनी मंऐं आपणीं ज़ान खातरै दी पाई। <verse eid="1SA 28:21" /><verse number="22" style="v" sid="1SA 28:22" />ऐबै आसा मेरी ताल्है ज़ीबाण करी अरज़ कि ज़िहअ हुंह बोला तूह कर तिहअ। हुंह आणू ताल्है धख रोटी संघा खा तेता। ताकि ताह बाता हांढणा लै तराण फिरे।”<verse eid="1SA 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 28:23" />शाऊलै किअ नांईं कि मुंह निं किछ़ै खाणअ। तेऊ संघै आऐ दै तिन्‍नैं आदमी बी किई तेऊ लै रोटी खाणें अरज़। ज़ांऊं तिन्‍नैं खास्सअ ज़ोर लाअ तै उझ़ुअ खिरी शाऊल धरना का खल़अ संघा बेठअ मांज़ै प्रैंदै। <verse eid="1SA 28:23" /><verse number="24" style="v" sid="1SA 28:24" />तेखअ बणाईं तैहा बेटल़ी झ़ट-पटै तेऊ लै धाचअ द बाछ़ू काटी शिखा तेखअ मुछ़अ धख ज़िहअ पिठअ संघा बणाईं बाझ़ी सज़ेल़े रोटी। <verse eid="1SA 28:24" /><verse number="25" style="v" sid="1SA 28:25" />तेखअ दैनी शाऊला सेटा खाणां लै अर तिन्‍नैं सोभी खाई रोटी संघा लागै तैहा ई राची हांढदै।<verse eid="1SA 28:25" /></para>
  <chapter eid="1SA 28" />
  <chapter number="29" style="c" sid="1SA 29" />
  <para style="s">पलिश्ती रहअ दाबेदो बैहम</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 29:1" />पलिश्ती ती आपणीं सारी सैना अपेक नगरी कठा किई दी अर इज़राईली तै जज्रेल खागै पाणींए सोबल़ा सेटा आपणैं डेरै पाऐ दै। <verse eid="1SA 29:1" /><verse number="2" style="v" sid="1SA 29:2" />पलिश्ती पांज़ राज़ै अर तिन्‍नें दल तै शौ-शौ अर हज़ार-हज़ार सैने छ़ुंढ बणाईं आजू हांढदै लागै दै। तिन्‍नें सैना पिछ़ू आऐ आकीश राज़ै संघै दाबेद अर तेऊए आदमी बी। <verse eid="1SA 29:2" /><verse number="3" style="v" sid="1SA 29:3" />तिन्‍नां भाल़ी लागै पलिश्ती सैनापति पुछ़दै, “ईंयां इब्रानी किज़ै करा एथ?”</para>
  <para style="p" vid="1SA 29:3">आकीश राज़ै दैनअ ज़बाब, “अह आसा दाबेद इज़राईली राज़ै शाऊलो दरोगअ। अह आसा शाऊला सेटा का ठुर्ही आअ द संघा आसा खास्सै भिन्‍नैं ओर्ही मेरी सैना संघै ज़ुल़अ द। ज़धा ओर्ही अह मुंह संघै आसा रहंदअ लागअ द, तधा ओर्ही निं मुखा एऊ दी किछ़ै खोट शुझुई।”<verse eid="1SA 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1SA 29:4" />पलिश्ती सैने तिंयां सैनापति हुऐ आकीश राज़ै लै रोश्शै लाल-पिंऊंल़ै संघा बोलअ इहअ, “एऊ छ़ाड एभी तैहा ज़ैगा लै बापस ज़ेथ तंऐं ईंयां डाहै दै आसा। एऊ निं हाम्हां संघै जुधा लै एछणैं दैई, इहअ निं हआ कि जुधा जैंदरी अह हाम्हां ई मारदअ लागे! एता का राम्बल़अ मोक्‍कअ निं एऊ आपणैं मालका संघै मेल़-ज़ोल़ करनैओ भेटणअ कि अह म्हारै आदमी मारी आपणैं मालका खुश करे! <verse eid="1SA 29:4" /><verse number="5" style="v" sid="1SA 29:5" />अह आसा सह ई दाबेद ज़सरै बारै बेटल़ी नाच़दी-गांदी एकी-दुजै का इहअ बोला तै,</para>
  <para style="q" vid="1SA 29:5">शाऊलै मारै हज़ार पर</para>
  <para style="q" vid="1SA 29:5">दाबेदै मारै दस हज़ार दुशमण!”<verse eid="1SA 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 29:6" />आकीश राज़ै शादअ तेखअ दाबेद संघा बोलअ इहअ, “हुंह खाआ इज़राईले ज़िऊंदै परमेशर बिधाते सोह कि हुंह निं ताल्है धख बी बैहम करदअ कि तूह सका मुल्है धोखअ दैई। ज़ै तूह मुंह संघै जुधा लै डेऊंदअ, तेते हणीं ती मुंह होर बी खास्सी खुशी। ज़धा ओर्ही तूह मुंह संघै रहंदअ लागअ, मुंह निं आझ़ तैणीं ताह दी किछ़ै खोट शुझुई। पर म्हारै होर राज़ै निं च़ाहंदै कि तूह हाम्हां संघै जुधा लै एछे। <verse eid="1SA 29:6" /><verse number="7" style="v" sid="1SA 29:7" />तै डेऊ तूह मज़ै करै घअरा लै, ज़ीबाण, तूह निं किज़ै इहअ करी ज़ेता करै ईंयां पलिश्ती राज़ै ताखा नराज़ होए।”<verse eid="1SA 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 29:8" />दाबेदै दैनअ आकीश राज़ै लै ज़बाब, “ऐबै मंऐं कै गलती किई माहा राज़अ? ज़िहअ तूह आप्पै आसा बोल्दअ लागअ द कि ज़धा ओर्ही हुंह तेरअ दास ताह संघै रहंदअ लागअ, आझ़ तैणीं निं ताखा मुंह दी किछ़ै खोट शुझुई, तै हुंह ताह मेरै मालक अर आपणैं राज़ै संघै जुधा लै डेऊई तेरै दुशमणा संघै मकाबलअ किल्है निं करूं?”<verse eid="1SA 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 29:9" />आकीशै दैनअ दाबेदा लै ज़बाब, “मंऐं मनी तेरी गल्‍ल, हुंह ज़ाणा कि तूह आसा परमेशरे स्वर्ग दूता ज़िहअ भरोस्सैमंद। पर म्हारै होर पलिश्ती राज़ै निं च़ाहंदै कि तूह हाम्हां संघै जुधा लै एछे। <verse eid="1SA 29:9" /><verse number="10" style="v" sid="1SA 29:10" />दाबेद, तम्हैं करै इहअ कि ज़ेतरै तम्हैं राज़ै शाऊला छ़ाडी मुंह सेटा लै आसा आऐ दै, तम्हैं सोभै उझ़िऐ काल्‍ला दोत्ती-दोत्थी संघा लागै राच भैंदी हांढदै।”<verse eid="1SA 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 29:11" />इहअ करै फिरअ दाबेद आपणैं आदमी संघी दुजै धैल़ै दोत्ती पलिश्ती देशा का बापस अर पलिश्ती डेऊए जज्रेला लै।<verse eid="1SA 29:11" /></para>
  <chapter eid="1SA 29" />
  <chapter number="30" style="c" sid="1SA 30" />
  <para style="s">दाबेदो अमोलकी संघै जुध</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 30:1" />चिऊथै धैल़ै पुजअ दाबेद आपणैं आदमी संघै सकाल़ग नगरी। अमोलकी त हेरदअ द तेभा लै दखण रेगीस्तान अर सकाल़ग लुटी अर सकाल़ग नगरी आसा तिन्‍नैं सारै दी आग चैल़ी दी। <verse eid="1SA 30:1" /><verse number="2" style="v" sid="1SA 30:2" />बेटल़ी-माठै निंयैं तिन्‍नैं सोभ कैद करी आप्पू संघै। तिन्‍नां मांझ़ै मारअ निं तिन्‍नैं कोहै पर तिंयां निंयैं तिन्‍नैं सोभ आप्पू संघै, संघा डेऊऐ फिरी। <verse eid="1SA 30:2" /><verse number="3" style="v" sid="1SA 30:3" />तैही ज़ांऊं दाबेद आपणैं आदमी संघै तिधी पुजअ, तिन्‍नैं भाल़अ कि सारी नगरी आसा आग चैल़ी दी अर तिन्‍नें बेटल़ी अर शोहरू-शोहरी निंयैं तिन्‍नैं आप्पू संघै गलाम बणाईं। <verse eid="1SA 30:3" /><verse number="4" style="v" sid="1SA 30:4" />दाबेद अर तेऊ संघै तेऊए तिंयां आदमी लागै ज़ोरै-ज़ोरै लैल़ा लाई लेरा लांदै, तिंयां रहै तेभै तैणीं लेरा लांदै लागी ज़ेभै तैणीं तिन्‍नों शाह पठी हल़कअ निं फिरअ। <verse eid="1SA 30:4" /><verse number="5" style="v" sid="1SA 30:5" />दाबेदे बेटल़ी, जज्रेला का आणी दी आहीनोम अर कर्मेल नगरी का आणी दी नबाले बेटल़ी अबीगेल बी निंईं तिन्‍नैं दुहै आप्पू संघै कैद करी।<verse eid="1SA 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1SA 30:6" />दाबेदा लै ती ऐबै खास्सी आफ़त पल़ी दी। किल्हैकि तेऊ संघै तेऊए आदमी बी तै आपणैं शोहरू-शोहरी डेऊणैं पिछ़ू खास्सै दुखी हुऐ दै। तिंयां थिऐ आप्पू मांझ़ै ऐबै एही गल्‍ला करदै लागै दै कि दाबेद ई पाणअ ऐबै पात्थरो ढो दैई मारी। पर दाबेदै डाही आपणैं परमेशर बिधाते आद करी खास्सी हिम्मत।<verse eid="1SA 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1SA 30:7" />तेखअ बोलअ दाबेदै आहीमोलके शोहरू अबतार प्रोहता लै, “आपणीं सदरी आण ओर्ही मुंह सेटा लै।” अबतारै आणी सदरी तेऊ सेटा लै। <verse eid="1SA 30:7" /><verse number="8" style="v" sid="1SA 30:8" />दाबेदै पुछ़अ बिधाता का, “हुंह एऊ अमोलकीए छ़ुंढा पिछ़ू डेऊं? मेरै तिंयां ढाखणैं बी?” बिधाता दैनअ तेऊ लै ज़बाब, “तूह डेऊ तिन्‍नां पिछ़ू, ताह हेरनै तिंयां ढाकी अर ताह आणनीं आपणीं सोभ गल्‍ला तिन्‍नां का बापस छ़ड़ैऊई।”<verse eid="1SA 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1SA 30:9" />तेखअ डेऊअ दाबेद तिधा का बसोर नाओंए गाडा तैणीं अर तेऊए छ़ह शौ आदमी तै तेऊ संघा। धख आदमी डाहै तेऊ तिधी। <verse eid="1SA 30:9" /><verse number="10" style="v" sid="1SA 30:10" />आप्पू डेऊअ दाबेद च़ार शौ आदमी संघा निंईं अमोलकी पिछ़ू अर दूई शौ आदमी गऐ तै इहै थकी कि तिंयां निं बसोर गाडा पार टपी बोल़ै संघा रहै तिंयां पिछ़ू तिधी। <verse eid="1SA 30:10" /><verse number="11" style="v" sid="1SA 30:11" />आजू भेटअ दाबेदे आदमी मिसर देशो एक ज़ुआन मणछ, तिन्‍नैं आणअ सह दाबेदा सेटा लै संघा दैनी तेऊ लै रोटी खाणां लै अर झुटणा लै पाणीं। <verse eid="1SA 30:11" /><verse number="12" style="v" sid="1SA 30:12" />तेखअ दैनै तिन्‍नैं फेडूए दूई डेलू अर दूई लुम्बरू दाखे। तेता खाई फिरअ तेऊओ शाह हरअ किल्हैकि तेऊ निं चिई धैल़ी-राची ओर्ही किछ़ै खाअ त नां पाणीं झुटअ त।<verse eid="1SA 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1SA 30:13" />तेखअ पुछ़अ दाबेदै तेऊ का, “तेरअ मालक कुंण आसा अर तूह किधो आसा?”</para>
  <para style="p" vid="1SA 30:13">तेऊ दैनअ ज़बाब, “हुंह आसा मिसर देशा का एकी अमोलकी मणछो गलाम, हुंह हुअ त बमार अर मेरै मालकै डाहअ हुंह इधी शोटी अर आझ़ हुऐ मुंह इधी चअन धैल़ै। <verse eid="1SA 30:13" /><verse number="14" style="v" sid="1SA 30:14" />हाम्हैं तै दखण यहूदा मुल्खे दखणा बाखा करेती, कालेब अर सकाल़ग लुटी अर तेथ आग चैल़ी बापस एछदै लागै दै।”<verse eid="1SA 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1SA 30:15" />दाबेदै बोलअ तेऊ लै, “तूह सका मुंह तिन्‍नां अमोलकी सेटा पजैल़ी?”</para>
  <para style="p" vid="1SA 30:15">तेऊ बोलअ इहअ, “ज़ै तूह मुल्है परमेशरे सोह खाई एही ज़बान दैए कि ताह निं हुंह मारनअ आथी अर नां मेरै मालके हाथै दैणअ आथी, तै दैंऊं तम्हां हुंह तिन्‍नां अमोलकीए छ़ुंढा सेटा पजैल़ी।”<verse eid="1SA 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1SA 30:16" />तेखअ पजैल़ै तेऊ मिसरी मणछै तिंयां लुटी मारी डेऊऐ दै अमोलकीए छ़ुंढा नेल़। तिंयां थिऐ तिधी ओर्ही-पोर्ही सारै दी छिंघुऐ दै, खुशी मनाऊंदै, खांदै-पिंदै अर नाच़दै लागै दै किल्हैकि तिन्‍नैं आणअ त पलिश्ती देशा अर यहूदा मुल्खा का खास्सअ माल लुटी। <verse eid="1SA 30:16" /><verse number="17" style="v" sid="1SA 30:17" />दाबेद अर तेऊए आदमी डेऊऐ तिन्‍नां मारदै राची अर तिंयां रहै दुजै धैल़ै सान्हां तैणीं तिन्‍नां मारदै लागी। तिन्‍नैं पाऐ तिंयां सोभ मारी अर तेथ निखल़ै तिन्‍नें सिधै तिंयां च़ार शौ ज़ुआन मणछ बच़ी ज़ुंण ऊँटा प्रैंदै बेशी तिधा का ठुर्है।<verse eid="1SA 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1SA 30:18" />इहअ करै ज़ुंण बी अमोलकी लुटी निंयं थिअ, दाबेदै आणी तिंयां सोभै गल्‍ला बापस छ़ड़ैऊई अर सोभी बेटल़ी-माठै संघी आणी तेऊ आपणीं दुहै बेटल़ी बी छ़ड़ैऊई। <verse eid="1SA 30:18" /><verse number="19" style="v" sid="1SA 30:19" />तिन्‍नें निं ज़ाथी धख ज़ेही च़ीज़ बी शोठुई। दाबेदै आणी आपणैं सोभी आदमीए बेटल़ी, शोहरू, शोहरी अर अमोलकी ज़ुंण समान लुटअ थिअ, तिंयां आणी तेऊ सोभ च़िज़ा डागै-चैणैं संघी बापस। <verse eid="1SA 30:19" /><verse number="20" style="v" sid="1SA 30:20" />डागै-चैणें हेल़्ही अमोलकी होर्ता का बी थिई लुटी दी, तिंयां बी छ़ेल़्है दाबेदे आदमी आप्पू आजू-आजू ज़ुदै ज़िहै। तिंयां सोभै बोला तै तेता लै इहअ, “ईंयां आसा पठी दाबेदे हेस्सै तेऊए मैन्थो फल!”<verse eid="1SA 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1SA 30:21" />तेखअ डेऊअ दाबेद तिन्‍नां दूई शौआ मणछा सेटा ज़ुंण थकी करै बसोर गाडा आर बाखा पिछ़ू तै छ़ुटै दै। तेखअ आऐ तिंयां बी आजू तैणीं दाबेद अर तिन्‍नां होरी सेटा लै अर दाबेद बी पुजअ तिन्‍नां सेटा संघा पुछ़ै तिंयां राज्ज़ी-खुशी। <verse eid="1SA 30:21" /><verse number="22" style="v" sid="1SA 30:22" />पर दाबेदा संघै डेऊए दै कई उपद्रभी अर मतलबी मणछै बोलअ दाबेदा लै इहअ, “ईंयां ता हाम्हां संघै आऐ ई निं आथी तै, हाम्हां निं इना लै लुटै दै माला मांझ़ा का किछ़ै दैणअ। आपणैं बेटल़ी-माठै लागा ईंयां घअरा लै निंदै।”<verse eid="1SA 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1SA 30:23" />तेखअ बोलअ दाबेदै तिन्‍नां लै इहअ, “मेरै भाईओ! बिधाता ज़ुंण हाम्हां लै दैनअ, तेता करै निं सिधअ आपणअ पूरअ करा। म्हारी फाज़त किई तेऊ ई बिधाता अर तेऊ ई किई म्हारी अमोलकी डाकूए छ़ुंढा खतम करना लै मज़त। <verse eid="1SA 30:23" /><verse number="24" style="v" sid="1SA 30:24" />थारी अह गल्‍ल निं कोही लाई मनी! सोभी भेटणअ बराबर हेस्सअ, ज़ुंण जुधा लै डेऊऐ तिन्‍नां बी अर ज़ुंण पिछ़ू समाना पहरी रहै तिन्‍नां लै बी भेटणअ तेतरअ ई।” <verse eid="1SA 30:24" /><verse number="25" style="v" sid="1SA 30:25" />दाबेदै बणाअं अह सूल अर तेखअ रहअ अह सूल इज़राईली मांझ़ै सदा।<verse eid="1SA 30:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1SA 30:26" />ज़ांऊं दाबेद सकाल़ग नगरी बापस पुजअ फिरी, तेऊ दैनअ लुटै दै माला मांझ़ै धख-धख यहूदी सैणैं लै ज़ुंण तेऊए पाक्‍कै साथी थिऐ, संघा दैनअ इहअ समाद, “अह आसा तम्हां लै मुंह बाखा भैंट ज़ुंण मंऐं बिधाते दुशमणा का आणी लुटी।” <verse eid="1SA 30:26" /><verse number="27" style="v" sid="1SA 30:27" />सह भैंट दैनी तेऊ बेतेल, यहूदा मुल्खै दखणा बाखा रामोत नगरी, जतीर नगरी, <verse eid="1SA 30:27" /><verse number="28" style="v" sid="1SA 30:28" />अरोर, सिपमोत, एश्तमो नगरी, <verse eid="1SA 30:28" /><verse number="29" style="v" sid="1SA 30:29" />रकाल़, जर्मेल टोलीए नगरी, कैनी टोलीए नगरी, <verse eid="1SA 30:29" /><verse number="30" style="v" sid="1SA 30:30" />होर्मा, बोर-अशान, अताक, <verse eid="1SA 30:30" /><verse number="31" style="v" sid="1SA 30:31" />हेब्रोन नगरीए सैणैं लै ज़ुंण दाबेदे पाक्‍कै साथी तै अर ज़ेसी-ज़ेसी दाबेद हांढा-फिरा त।<verse eid="1SA 30:31" /></para>
  <chapter eid="1SA 30" />
  <chapter number="31" style="c" sid="1SA 31" />
  <para style="s">शाऊल अर तेऊए शोहरूए मौत</para>
  <para style="r">(<ref loc="1CH 10:1-12">1 इतिहास 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1SA 31:1" />तेतरी किअ पलिश्ती इज़राईली संघै गिलबा नाओंए धारा मकाबलअ। तिधी पाऐ पलिश्ती कई इज़राईली मारी अर बाकी ज़ुंण बच़ै तिंयां ठुर्है तिधा का राज़ै शाऊल अर तेऊए शोहरू संघी। <verse eid="1SA 31:1" /><verse number="2" style="v" sid="1SA 31:2" />पर पलिश्ती निं शाऊल अर तेऊए शोहरूओ पिछ़अ छ़ाडअ, पलिश्ती पाऐ शाऊले चअन शोहरू जोनातान, अबीनादाब अर मोलकीशूआ मारी। <verse eid="1SA 31:2" /><verse number="3" style="v" sid="1SA 31:3" />शाऊला फेर लागअ घणअ जुध अर तेऊ लै खुभै दुशमणे कतीर अर तेता करै हुअ सह खास्सअ ज़खमी। <verse eid="1SA 31:3" /><verse number="4" style="v" sid="1SA 31:4" />तेखअ बोलअ शाऊलै आपणैं अस्त्र-शास्त्रा ढोणै आल़ै लै, “तूह खिंच़ आपणीं तलबार संघा मार मुंह आप्पै! ईंयां पलिश्ती ज़सरअ खतैर निं हंदअ हुअ द, हुंह निं इने तलबारा करै लोल़ी मूंअ! तेखअ हणअ हुंह लोगे सुहांगा लै!” पर सह ज़ुआन मणछ डरअ खास्सअ अर किअ तेऊ मारना लै नांह। तेखअ किई राज़ै शाऊलै आपणीं तलबार काढी धरनीं खल़ी संघा दैनअ तलबारे च़ुंज़ी प्रैंदा लै गल़िम्ह च़ारै लै जुंघू।<verse eid="1SA 31:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1SA 31:5" />ज़ांऊं तेऊ अस्त्र-शस्त्रा ढोणै आल़ै ज़ुआन मणछै भाल़अ कि राज़अ शाऊल गअ मरी, तेऊ बी दैनअ शाऊला ई ज़िहअ आपणीं तलबार खल़ी करी तेथ प्रैंदै जुंघू संघा मूंअ तिधी राज़ै ई संघै। <verse eid="1SA 31:5" /><verse number="6" style="v" sid="1SA 31:6" />इहअ करै मूंऐं शाऊल राज़अ, तेऊए चअन शोहरू, अस्त्र-शस्त्र ढोणै आल़अ सह ज़ुआन मणछ अर राज़ै शाऊले लुआद पठी ज़ुंण आजू तेऊ बाद राज़ सका तै करी। <verse eid="1SA 31:6" /><verse number="7" style="v" sid="1SA 31:7" />ज़ुंण इज़राईली जज्रेल खागै जरदण नदीए दुजै बाढै तै, ज़ांऊं तिन्‍नां का इहअ थोघ लागअ कि इज़राईली सैना ठुर्ही जुधा का, शाऊल अर तेऊए शोहरू बी पाऐ पलिश्ती मारी, तिंयां ठुर्है तेखअ आपणीं-आपणीं नगरी छ़ाडी। तेखअ आऐ पिछ़ू पलिश्ती संघा गिम्मी तिंयां नगरी आप्पू लै।<verse eid="1SA 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1SA 31:8" />दुजै धैल़ै ज़ांऊं पलिश्ती मारै दै इज़राईलीए माला लुटदै आऐ, तिन्‍नां भेटी शाऊल अर तेऊए चिई शोहरूए ल्हासा गिलबा धारा पल़ी दी। <verse eid="1SA 31:8" /><verse number="9" style="v" sid="1SA 31:9" />तिन्‍नैं काटअ शाऊलो मूंड, तेऊए अस्त्र-शस्त्र बी लुटै, संघा छ़ाडै तिन्‍नैं सारै पलिश्ती देशै दूत कि ऐहा खुशीए खबरा खोज़ा सोभी देअए देहुरै अर सोभी आम लोगा का। <verse eid="1SA 31:9" /><verse number="10" style="v" sid="1SA 31:10" />तेखअ डाहै तिन्‍नैं शाऊले अस्त्र-शस्त्र अशतरोत देबीए देहुरै अर तेऊए घेर डाही बेथ-शान नगरीए गहल़ै बागा बाखा भित्ती दी टोक्‍की।<verse eid="1SA 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1SA 31:11" />ज़ांऊं गलाद जबेश नगरीए लोगा का इहअ थोघ लागअ कि पलिश्ती किअ शाऊला संघै इहअ-इहअ, <verse eid="1SA 31:11" /><verse number="12" style="v" sid="1SA 31:12" />तिन्‍नें शूरबीर पुजै राचो-राच बेथ-शान। संघा आणी शाऊल अर तेऊए शोहरूए ल्हासा नगरीए गहल़ा का काढी जबेश नगरी लै संघा दहई तिन्‍नें ल्हासा तिधी। <verse eid="1SA 31:12" /><verse number="13" style="v" sid="1SA 31:13" />तेखअ डाहै तिन्‍नैं शाऊल अर तेऊए शोहरूए हस्तू जबेश नगरी मधनूंए बूटा हेठै दाबी। संघा रहै सोभै साता धैल़ी तैणीं कहतू।<verse eid="1SA 31:13" /></para>
  <chapter eid="1SA 31" />
</usx>