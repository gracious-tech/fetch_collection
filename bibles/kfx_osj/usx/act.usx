  <para style="h">शधाणूं</para>
  <para style="toc1">पबित्र आत्मां पजैल़अ शधाणूं करै संसारै खुशीओ समाद</para>
  <para style="toc2">शधाणूं</para>
  <para style="toc3">शधा.</para>
  <para style="mt1">शधाणूं</para>
  <para style="mt2">पबित्र आत्मां पजैल़अ शधाणूं करै संसारै खुशीओ समाद</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: लूका</para>
  <para style="ili">पहल़णैं आल़ै: होरी ज़ाती का आऐ दै विश्वासी</para>
  <para style="ili">सन: 61</para>
  <para style="ip">शधाणूंए काम कताबा दी आसा लूका लिखै दै खुशीए समादा का आजू हुई दी गल्‍ला खोज़ी दी। एतो खास मकसद आसा इहअ खोज़णअ कि ईशूए शुरूआती विश्वास करनै आल़ै च़ेल्‍लै पबित्र आत्में साबै हांढदी ईशूए बारै खुशीओ समाद “एरुशलेम, सारै यहूदा, सामरी अर पृथूई दी कई ज़ैगा तैणीं” 1:8 किहअ करै पजैल़अ। ईंयां आसा मसीही विश्वासे सारै दी पुजणें पूरी गल्‍ला ज़ेते शुरूआत पैहलै यहूदी मणछा मांझ़ै हुई अर बढदी-बढदी बणअ पूरै संसारे कई लोगो विश्वास। लिखणैं आल़अ डाहा ऐहा गल्‍लो बी धैन कि ऐहा कताबा पहल़णैं आल़ै इहअ बी निहंचअ होए कि मसीही विश्वास करनै आल़ै लोग नांईं तै रोमी राज़ा दी राज़े खलाफ द्रोही हणैं आल़ै लोग आथी अर मसीही विश्वास त यहूदी धर्मां पूरै करनै आल़अ।</para>
  <para style="ip">शधाणूंए काम कताबा सका चिई बाखा बांडी, ज़ुंण मसीही विश्वासा हर बगत बझ़दै रहैऊआ ज़ेथ ईशू मसीहे खुशीए समादो प्रच़ार हुअ अर टोली बस्सी</para>
  <para style="ili">1. ईशूए स्वर्गै डेऊणैं का बाद एरुशलेम नगरी मसीही समाज़े शुरूआत।</para>
  <para style="ili">2. पलिश्ती देशे होरी मुल्खै खुशीए समादो पुजणअ।</para>
  <para style="ili">3. पृथूईए बीच़ समुंदरे देशै एतो पुजणअ।</para>
  <para style="ip">शधाणूंए कामें एक खास ज़रूरी गल्‍ल आसा अह कि पबित्र आत्मां किहै-किहै काम किऐ। सह होथा पिन्तेकुस्त धैल़ी एरुशलेम नगरी कठा हुऐ दै विश्वासी प्रैंदै बडी शगती संघै, अर ऐहा कताबा दी हुई-बिति दी गल्‍ले बारै लिखदी बारी खोज़ी विश्वासीए टोली अर सैणैं का खोज़ी शगती दैई तिन्‍नां का आजू डेऊणे बात। शधाणूंए कामां दी दैनी दै कई शिक्षा दी आसा शुरूआती मसीही समादो सार खोज़अ द अर एथ दी खोज़ी दी गल्‍ला करा विश्वासीए ज़िन्दगी दी अर टोलीए काम-काज़ा दी एऊ खुशीए समादे शगती प्रगट।</para>
  <para style="ip">शधाणूं मांझ़ै ज़ुंण ईशू मसीहे बारै खुशीए समादा खोज़दअ सारै दी पुजअ, सह थिअ पल़सी। अह कताब खोज़ा ज़ादातर तेऊए बारै कि तेऊ किहअ पजैल़अ खुशीओ समाद, यहूदी छ़ाडी संसारे होरी ज़ाती सेटा। खिरी पजैल़अ तेऊ अह समाद रोम ज़ुंण तेऊ ज़मानै संसारे सोभी का मशूर अर खास नगरी थिई, लूका च़ाहा त ऐहा कताबा लिखणैं करै इहअ खोज़णअ कि मसीहे बारै खुशीए समादा सारै संसारै पुजणैं का निं एता कोह रोक्‍की सकदअ:</para>
  <para style="imq">“तेखअ रहअ पल़सी पूरी दूई साला तैणीं आपणैं कराऊऐ दैई एकी घअरा दी। ज़ुंण तेऊ सेटा एछा तै, सह रहअ तिन्‍नां संघै मिलदअ लागी अर नधड़क परमेशरे राज़ो प्रच़ार करदअ लागी अर मसीहा ईशू प्रभूए गल्‍ला सखाऊंदअ लागी, तेऊ निं तेता लै कोहै रोक्‍कदअ आथी त।”</para>
  <para style="ipr">(28:30,31)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">शाजत दैणा लै तैरी 1:1-26</para>
  <para style="io2">(1) ईशूए खिरी दैनअ द हुकम अर करार 1:1-14</para>
  <para style="io2">(2) यहूदो ज़ैगा दुजअ च़ेल्‍लअ 1:15-26</para>
  <para style="io1">एरुशलेम नगरी शाजत 2:1—8:3</para>
  <para style="io1">यहूदा अर सामरी दी शाजत 8:4—12:25</para>
  <para style="io1">पल़सीए च़ाकरी 13:1—28:3</para>
  <para style="io2">(1) पैहली प्रच़ार-हांढ 13:1—14:28</para>
  <para style="io2">(2) एरुशलेम नगरी कठा हणअ 15:1-35</para>
  <para style="io2">(3) दुजी प्रच़ार-हांढ 15:36—18:22</para>
  <para style="io2">(4) चिऊथी प्रच़ार-हांढ 18:23—21:16</para>
  <para style="io1">(5) एरुशलेम, कैसरिया अर रोम कैद खानै पल़सी 21:17—28:31</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">भेत</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />जनाब थियुफिलुस, मंऐं लिखी ती ताल्है पैहली कताब तिन्‍नां गल्‍ले बारै, ज़ुंण प्रभू ईशू शुरू ओर्ही किअ अर खिरी तैहा धैल़ी तैणीं सखाऊंदअ रहअ <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />ज़हा धैल़ी सह आपणैं छ़ांटै दै शधाणूं लै हुकम दैई पबित्र आत्मां करै परमेशरै उझै स्वर्गा लै निं च़कअ।<verse eid="ACT 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 1:3" />क्रूसा दी दुख ज़िरी ज़ान दैणैं का बाद रहअ ईशू च़ाल़्ही धैल़ै तैणीं शधाणूं संघै बगती-बगती तिन्‍नां सेटा डेऊंदअ अर तिन्‍नां लै परमेशरो राज़ एछणें बारै खोज़दअ लागी। तेऊ किई अह गल्‍ल कई पाक्‍कै सबूत रहैऊई प्रगट कि सह हुअ मरी करै भिई ज़िऊंदअ।<verse eid="ACT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 1:4" />ज़ेभै सह तिन्‍नां सेटा त, तेऊ दैनअ तिन्‍नां लै इहअ हुकम, <char style="wj">“एरुशलेम नगरी निं छ़ाडी, पर मेरै बाब परमेशरे तैहा करारा पूरी हणैं तैणीं रहै ऐहा ई नगरी न्हैल़ै लागी, ज़ेते बारै मंऐं तम्हां का पैहलै ई आसा खोज़अ द।<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">लूक. 24:49</char></note></char><verse eid="ACT 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 1:5" />
    <char style="wj">“किल्हैकि जोहन्‍ना, दैनी पाणीं दी डुबकी; पर परमेशरा दैणीं तम्हां लै पबित्र आत्मां दी डुबकी।”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">मोत्त. 3:11</char></note></char><verse eid="ACT 1:5" /></para>
  <para style="s">ईशूओ स्वर्गा लै डेऊणअ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />बादा का ज़ांऊं तिंयां सोभ प्रभू ईशू सेटा कठा हुऐ, तिन्‍नैं पुछ़अ प्रभू ईशू का, “हे प्रभू, दुशमणा का छ़ुटकारअ दैई कै ताह ऐबै इज़राईला दी आप्पै करनअ राज़?” <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />प्रभू ईशू बोलअ तिन्‍नां लै, <char style="wj">“तैहा ऋता अर तेऊ ज़मानें बारै थोघ हणें निं तम्हां किछ़ै ज़रुरत आथी तिन्‍नां गल्‍लो थोघ अर हक आसा सिधअ बाब परमेशरा का कि तिंयां गल्‍ला केभै हणीं।</char><verse eid="ACT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 1:8" />
    <char style="wj">“पर ज़ेभै पबित्र आत्मां तम्हां दी एछे, तेभै भेटणीं तम्हां शगती, तेखअ हणैं तम्हैं एरुशलेम नगरी, सारै यहूदा मुल्खै, सामरी मुल्खै अर सारी पृथूई दी हर ज़ैगा मेरै शाजत।”</char><verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />इना गल्‍ला बोली डेऊअ प्रभू तिन्‍नां सम्हनै उझै स्वर्गा लै अर बादल़ै च़ोरअ सह तिन्‍नें आछी का दूर।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 47:5">भज. 47:5</ref></char></note> <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />प्रभू डेऊंदी बारी तै तिंयां सोभ लागै दै सरगा बाखा लै भाल़ै, अर दूई स्वर्ग दूत शेतै झिकल़ै बान्हैं दै तिन्‍नां सेटा लै आऐ अर खल़्हुऐ।<verse eid="ACT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 1:11" />तिन्‍नैं स्वर्ग दूतै बोलअ तिन्‍नां लै, “हे गलीली मणछो, तम्हैं इधी खल़्हुई करै किल्है आसा लागै दै सरगा बाखा लै भाल़ै? अह ई ईशू ज़ुंण परमेशरै तम्हां सेटा का स्वर्गा लै च़कअ, ज़िहअ करै तम्हैं अह स्वर्गा लै डेऊंदअ भाल़अ, तिहअ ई एछणअ अह बापस फिरी।”<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TH 4:16">1 थिस. 4:16</ref></char></note><verse eid="ACT 1:11" /></para>
  <para style="s">करेती गराऊंए यहूदे ज़ैगा मतियाह लै पदबी भेटणीं</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तिन्‍नां स्वर्ग दूता डेऊणैं बाद फिरै तिंयां च़ेल्‍लै जैतून नाओंए धारा का बापस एरुशलेम नगरी लै सह ज़ैगा ती एरुशलेम नगरी नेल़ कोई एक मील दूर ज़ेतरै दूर यहूदी बशैघे धैल़ै डेऊई सका तै।<verse eid="ACT 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 1:13" />ज़ांऊं तिंयां एरुशलेम नगरी पुजै अर तिंयां रहै तिधी एकी घअरे एकी आटल़ू। तिधी थिऐ पतरास, जोहन्‍ना, याकब, आन्दरू, फलिप्प, थोमा, बरतुलमी, मोत्ती, हलफीओ शोहरू याकब, शमौन जेलोतेस अर याकबो शोहरू यहूदा।<verse eid="ACT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14" />ईंयां सोभै शधाणूं तै कबल्‍लै एक मन्‍न हई प्राथणां करदै लागै दै। तिन्‍नां मांझ़ै तै प्राथणां करदै होर च़ेल्‍लै बी अर कई बेटल़ी ज़ुंण प्रभू ईशू संघै हआ तै अर प्रभू ईशूए ईज मरिअम अर ईशूए दूई भाऊ।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />तिन्‍नां ई धैल़ै उझ़ुअ पतरास तिन्‍नां सोभी भाई मांझ़ै खल़अ, तिधी थिऐ तिंयां सोभ ईशू मसीहा दी विश्वास करनै आल़ै एक शौ बिह लोग बेठै दै। तेखअ बोलअ पतरासै,<verse eid="ACT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 1:16" />“भाईओ, यहूदे बारै ज़ुंण पबित्र शास्त्रा दी आसा लिखअ द, तेतो पूरअ हणअ त ज़रूरी अर अह गल्‍ल हुई बी आझ़ सच्च़ी।</para>
  <para style="p" vid="ACT 1:16">“ज़ुंण पबित्र आत्मां राज़ै दाबेदे खाखा का पैहलै ई खास्सी साला पैहलै आसा बोलअ द ज़ुंण प्रभू ईशू ढाकणैं आल़ै मांझ़ै सैणअ त।”<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भज. 41:9</ref></char></note><verse eid="ACT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 1:17" />“किल्हैकि सह थिअ हाम्हां संघै च़ाकरी लै साझ़ू। <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />तेऊ लअ पापे कमाई करै एक खेच मोलै। तेऊओ हुअ उटअ मूंड अर खल़ी ज़ांघा अर तेऊओ पेट फुटअ, अर तेऊए सारी आंजा निखल़ी बागै। <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ऐहा गल्‍लो थोघ लागअ एरुशलेम नगरी रहणैं आल़ै सोभी लोगा का, इधी तैणीं कि तेऊ खेचा लै बोला तिन्‍नें बोली दी ‘अकेलदामा’ मतलब लोहूओ खेच।”<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />“किल्हैकि भज़ने कताबा दी आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">भज. 69:25</ref>; <ref loc="PSA 109:8">109:8</ref></char></note></para>
  <para style="q" vid="ACT 1:20">‘तेऊओ घअर लोल़ी बरैबाद हुअ</para>
  <para style="q" vid="ACT 1:20">अर तेथ निं लोल़ी कोह बस्सअ,</para>
  <para style="q" vid="ACT 1:20">तेऊए पदबी लोल़ी कहा होरी भेटी।’<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“तै, ज़ेतरै धैल़ै प्रभू ईशू हाम्हां संघै एछदअ-डेऊंदअ रहअ, मतलब जोहन्‍ने डुबकी दैणैं ओर्ही प्रभूए स्वर्गै डेऊणैं तैणीं ज़ुंण लोग हर बगत हाम्हां संघै रहै। <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />सह ई गल्‍ल आसा अह कि जोहन्‍ना सेटा डुबकी लणैं ओर्ही स्वर्गा लै डेऊणैं तैणीं ज़ुंण तिन्‍नां ई मांझ़ा का एक मणछ हाम्हां संघै प्रभूए ज़िऊंदै हणैंओ शाजत होए।”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />तेखअ किऐ तिन्‍नैं दूई ज़ण्हैं खल़ै, एक युसुफ, ज़हा लै बरसबा बोला अर तेऊओ पल़णांअ आसा जस्तुस अर दुजअ किअ खल़अ मतियाह।<verse eid="ACT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 1:24" />तेखअ किई तिन्‍नैं सोभी एही प्राथणां “हे प्रभू, तूह ज़ुंण सोभिए मन्‍नें गल्‍ला ज़ाणा, ऐहा गल्‍ला कर प्रगट कि इना दूई मांझ़ै तंऐं कुंण आसा छ़ांटअ द, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />कि सह ऐहा च़ाकरी अर शधाणूंए पदबी लई सके। ज़हा पदबी छ़ाडी यहूदा आपणीं तैहा ज़ैगा लै डेऊअ ज़ेता सह च़ाहा त।”<verse eid="ACT 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 1:26" />तेखअ पाई तिन्‍नैं सोभी तिन्‍नां दुहीए नाओंए परच़ी अर परच़ी निखल़ी मतियाहे नाओंए, तेखअ गणअ सह तिन्‍नां गैरा शधाणूं संघै बार्हूऐ शधाणूंए रुपै।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पबित्र आत्मों एछणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />ज़ांऊं पिन्तेकुस्त धैल़ी आई, तिंयां सोभ तै हुऐ दै एकी ज़ैगा कठा।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15">लेब. 23:15</ref>; <ref loc="DEU 16:9-11">बधा. 16:9-11</ref></char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />हेरा-हेरी हुई सरगा का एक ढिश-बागरी ज़ेही छ़ेल़ अर ज़ेऊ घअरै तिंयां बेठै दै तै सह सारअ घअर बज़ेर्हूअ। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />तिन्‍नां का शुझुई आगीए लुपल़ै ज़ेही ज़िभा निखल़दी अर तिन्‍नां मांझ़ै हरेकी प्रैंदै एछदी। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />तिंयां सोभ भर्हुऐ पबित्र आत्मां करै, ज़ुंण बरदान पबित्र आत्मां तिन्‍नां लै दैनै तेते साबै लागै तिंयां होरी-होरी बोली दी गल्‍ला करदै।<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />तधू तै हरेक देशा का सोभी ज़ातीए भगत यहूदी एरुशलेम नगरी दी पिन्तेकुस्त जाचा लै आऐ दै। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />ज़ांऊं सह बडी छ़ेल़ हुई, ओरी-पोरी का आऐ खास्सै मणछ अर तिधी हुऐ खास्सै मणछ कठा अर लोग डरै। किल्हैकि तिन्‍नां शुण्हिंआं त हरेकी का इहअ कि ईंयां आसा लागै दै म्हारी ई बोली दी गल्‍ला करदै।<verse eid="ACT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 2:7" />तिंयां हुऐ रहैन अर तिंयां लागै एकी-दुजै का बोल्दै, “हेरा, ईंयां ज़ुंण बोल्दै आसा लागै दै, ईंयां गलील मुल्खा का निं आथी आऐ दै? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />तै किल्है लागी हाम्हां मांझ़ै हरेकी का आपणीं-आपणीं बोली शुणदी।<verse eid="ACT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 2:9" />“हाम्हैं ज़ुंण पारथी, मेदी, एलामी, मेसोपोटामिया, यहूदा, कप्पदुकिआ, पुंतुस, एशिया, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />फ्रूगिआ, पंफूलिआ, मिसर, लिबिया देशा का ज़ुंण कुरेन नगरी नेल़ आसा, इना सोभी देशे रहणैं आल़ै यहूदी अर रोमी देशे रहणैं आल़ै ज़ुंण होरी देशै रहा। <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />मतलब कै यहूदी अर कै यहूदी धर्मों पक्ष लणैं आल़ै, क्रेतै टापू का अर अरब देशे बी आसा पर आपणीं-आपणीं भाषा बोली दी आसा लागै दै इना का परमेशरे महान शगतीए कामें बारै शुणदै!”<verse eid="ACT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12" />तिंयां सोभ लोग हुऐ रहैन अर हैल़ुई करै लागै एकी-दुजै का बोल्दै, “अह किज़ै आसा लागअ द हंदअ”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />पर कई किअ सुहांग-मखौल, “इना आसा शराब लागी दी।”<verse eid="ACT 2:13" /></para>
  <para style="s">पतरासो प्रच़ार</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />तेखअ उझ़ुअ पतरास तिन्‍नां गैरा च़ेल्‍लै संघै खल़अ अर तेऊ बोलअ ज़ोरै-ज़ोरै, “हे यहूदा मुल्खै अर एरुशलेम नगरी रहणैं आल़ैओ, ऐहा गल्‍ला लआ समझ़ी अर कान लाई शूणां मेरी गल्‍ला। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />ज़िहअ तम्हैं आपणैं साबै सोठा किई ईंयां आसा नशै दी, ईंयां निं नशै दी आथी किल्हैकि एभै; अज़ी सुरज़ निखल़अ, <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पर अह गल्‍ल आसा सह ज़ुंण परमेशरे जोएल गूरै आसा बोली दी,<verse eid="ACT 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17" />परमेशर बोला इहअ ‘खिरीए धैल़ी’ हणअ इहअ,</para>
  <para style="q" vid="ACT 2:17">‘मुंह दैणीं आपणीं आत्मां सोभी लै,</para>
  <para style="q" vid="ACT 2:17">थारै शोहरू-शोहरी करनी मेरी गल्‍ला प्रगट,</para>
  <para style="q" vid="ACT 2:17">थारै प्रोढै मणछा हणैं सुपनै</para>
  <para style="q" vid="ACT 2:17">अर ज़ुआन मणछा हणैं धैन।<verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />तेऊ ज़मानै ज़ुंण दास अर दासी बी होए,</para>
  <para style="q" vid="ACT 2:18">तिन्‍नां लै बी दैणीं मुंह आपणीं आत्मां</para>
  <para style="q" vid="ACT 2:18">अर तिन्‍नां बी करनअ मेरी गल्‍लो प्रच़ार।<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />उझै सरगै अर उंधै धरती दी रहैऊंणै मुंह चतैनगी दैणा लै नछ़ैण,</para>
  <para style="q" vid="ACT 2:19">मुंह छ़ाडणैं लोहू, आग अर धूँए बादल़।<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />ज़ेभै मुंह बिधाते सह महान अर सिध्द धैल़ी एछणी,</para>
  <para style="q" vid="ACT 2:20">सुरज़ फिरनअ न्हैरअ अर ज़ोथ हणीं लोहू ज़ेही लाल।’<verse eid="ACT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 2:21" />“‘पर ज़ुंण बी प्रभू का मज़त मांगे, सह जाणअ बच़ी।’<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">जोए. 2:28-32</ref></char></note><verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“हे इज़राईली मणछो, इना गल्‍ला शूणां कि नासरत नगरी रहणैं आल़अ ईशू, ज़सरअ परमेशरा बाखा का हणें सबूत आसा शगतीए नुआहरै काम अर स्वर्गे नछ़ैणां करे प्रगट। ज़ुंण काम परमेशरै तम्हां मांझ़ै करी तेऊ करै रहैऊऐ अर ज़ुंण तम्हैं आपणीं आछी भाल़ै।<verse eid="ACT 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 2:23" />“परमेशरै थिअ एते बारै पैहलै ई सोठी डाहअ द कि ईशू दैणअ थारै हाथै अर तेऊ का थिअ इना सोभी गल्‍लो थोघ। तम्हैं बझ़ैल़अ ईशू तिन्‍नां पापी मणछे हाथै क्रूसा दी मारनै ज़ुंण परमेशरे बधाना निं मंदै। <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />पर सह ई ईशू किअ परमेशरै मौते शांघल़ी लोहै का छ़ड़ैऊई करै ज़िऊंदअ। किल्हैकि अह गल्‍ल निं हई सकदी ती कि मौत तेऊ आपणैं बशै करी सके।<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="2SA 22:6">2 शमू. 22:6</ref>; <ref loc="PSA 18:4">भज. 18:4</ref>; <ref loc="PSA 116:3">116:3</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />किल्हैकि राज़अ दाबेद लिखा तेऊए बारै इहअ कि</para>
  <para style="q" vid="ACT 2:25">‘मंऐं भाल़अ कि परमेशर आसा हर बगत मुंह संघै</para>
  <para style="q" vid="ACT 2:25">सह आसा मुंह नेल़ सह निं मुंह खरी दी पल़णै दैंदअ।<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />तैही रहा मेरअ मन्‍न खुश अर</para>
  <para style="q" vid="ACT 2:26">हुंह करा तेरअ शूकर!</para>
  <para style="q" vid="ACT 2:26">हुंह आसा निहंचै कि ताह करनी मेरी ज़िन्दगीए फाज़त।<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />किल्हैकि ताह निं मेरअ प्राण जम्परी शोटी डाहणअ,</para>
  <para style="q" vid="ACT 2:27">अर नां ताह आपणैं पबित्र मणछे देही चिजणैं दैणअ।<verse eid="ACT 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 2:28" />“‘तंऐं रहैऊई मुखा सह बात ज़ुंण ज़िन्दगी बाखा डेओआ, अर ताह करनअ हुंह आपणैं दर्शणा करै खुश।’<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">भज. 16:8-11</ref></char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“भाईओ, हुंह सका तेऊ दाद-बाब राज़ै दाबेदे बारै शाह डाही करै बोली कि सह ता डेऊअ मरी अर तेऊए क्रिया कर्म बी हुऐ अर ज़िधी सह दाबअ तेऊए घोर आसा आझ़ तैणीं तिधी।<note caller="-" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="1KI 2:10">1 राज़. 2:10</ref></char></note> <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />सह थिअ परमेशरो गूर अर तेऊ का थिअ थोघ कि परमेशरै आसा तेऊ संघा करार किई दी कि तेरी राज़गाद्दी प्रैंदै बशैल़णअ मुंह तेरी ई आद-लुआदा मांझ़ै एक राज़अ।<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 शमू. 7:12</ref>; <ref loc="PSA 132:11">भज. 132:11</ref></char></note><verse eid="ACT 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 2:31" />“दाबेद राज़ै का थिअ तेऊ ज़मानैं इहअ थोघ कि परमेशरा आजू किज़ै करनअ। तेऊ बोलअ इहअ कि परमेशरा करनअ मसीहा ईशू मरी करै भिई ज़िऊंदअ। परमेशरा निं तेऊए देही घोरी दी चिजणैं दैणीं अर नां तेऊए प्राण जम्परी डेऊणैं।<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भज. 16:10</ref></char></note><verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />“अह ई ईशू किअ परमेशरै ज़िऊंदअ ज़सरै हाम्हैं सोभ शाजत आसा। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />इहअ करै परमेशरे दैहणै हाथा का सोभी का बडी पदबी अर बाबा का सह पबित्र आत्मां पाई ज़सरी करार किई ती, सह दैनी तेऊ हाम्हां दी ज़ुंण तम्हैं भाल़ा अर शूणां। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />किल्हैकि राज़अ दाबेद, निं स्वर्गै उखल़अ, पर आप्पै बोला सह इहअ,<note caller="-" style="x"><char style="xo" closed="false">2:34 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भज. 110:1</ref></char></note></para>
  <para style="q" vid="ACT 2:34">‘परमेशर बिधाता बोलअ मेरै प्रभू का इहअ,</para>
  <para style="q" vid="ACT 2:34">“मेरै दैहणै बेश बडी पदबी दी<verse eid="ACT 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ACT 2:35" />ज़ेभै तैणीं कि हुंह तेरै दुशमणा</para>
  <para style="q" vid="ACT 2:35">तेरै खूरा हेठै निं करी लऊं।”’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“इज़राईले खिंबे सोभ लोग लऐ ऐबै ऐहा गल्‍ला समझ़ी कि ज़ुंण ईशू तम्हैं क्रूसा दी मारअ, सह बणाअं परमेशरै ‘प्रभू’ अर ‘मसीहा’ दुहै।”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />सोभी शुणनै आल़ेए लागी तिंयां गल्‍ला दिलै अर तिंयां लागै पतरास अर होरी शधाणूं का पुछ़दै, “भाईओ, ऐबै तै हाम्हैं किज़ै करूंमै?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पतरासै बोलअ तिन्‍नां लै, “आपणैं पापो प्राश्त करा संघा लआ तम्हैं सोभै आपणैं-आपणैं पाप माफी लै मसीहा ईशूए नाओंऐं डुबकी, तै भेटणीं तम्हां पबित्र आत्मां ज़ुंण परमेशरो दान आसा। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />किल्हैकि अह करार आसा तम्हां लै, थारी आदी-लुआदी लै अर तिन्‍नां सोभी दूर-दूर रहणैं आल़ै लोगा लै बी आसा ज़हा प्रभू म्हारअ परमेशर बाब आप्पू सेटा लै शादे।”<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="JOL 2:32">जोए. 2:32</ref></char></note><verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />पतरासै समझ़ाऊऐ खास्सी गल्‍ला करै इहअ बोली, “आप्पू रहा ऐहा कदुष्ट पोस्ती का बच़ी।”<note caller="-" style="x"><char style="xo" closed="false">2:40 </char><char style="xt" closed="false"><ref loc="DEU 32:5">बधा. 32:5</ref>; <ref loc="PSA 78:8">भज. 78:8</ref></char></note><verse eid="ACT 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 2:41" />ज़ुंणी पतरासे गल्‍ला दी विश्वास किअ, तिन्‍नैं लई पाणीं दी डुबकी अर तैहा ई धैल़ी मिलै कोई चअन हज़ार लोग विश्वास तिन्‍नां संघै। <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />तेखअ तिंयां सोभ लागै शधाणूं का शिक्षा लंदै, संगती, प्रभू भोज़ा करदै अर हर धैल़ै प्राथणां करदै लागी।<verse eid="ACT 2:42" /></para>
  <para style="s">विश्वासीए संगत</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />एरुशलेम नगरीए सोभी लोगा पल़ी डअर, अर खास्सै रहैन करनै आल़ै काम अर नछ़ैण हआ तै शधाणूं करै प्रगट। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />तिंयां सोभ विश्वास करनै आल़ै रहा तै कठा, अर तिन्‍नें सोभ च़िज़ा बी हआ ती कठा। <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />तिंयां करा तै आपणीं-आपणीं ज़ैदात अर समान बेच़ी-बेच़ी ज़ेही ज़सरी ज़रुरत हआ ती तेही बांडी।<verse eid="ACT 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 2:46" />हर धेल्‍लै हआ तै तिंयां भबनै कठा अर घअरै-घअरै प्रभू भोज़ करदी नंद अर भलै मन्‍नैं खाआ तै रोटी। <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />तिंयां सोभ करा तै परमेशरे स्तोती अर सोभ लोग तै तिन्‍नां करै खुश अर ज़सरअ उद्धार हआ त, तिन्‍नां ज़ोल़ा त हर धैल़ै प्रभू तिन्‍नां संघै।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लाट्टअ भिख मांगणै आल़अ किअ ठीक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />पतरास अर जोहन्‍ना तै लागै दै चिऊथै पहरै प्राथणां करने बगती दै भबना लै डेऊंदै। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />लोग तै लागै दै एकी ज़ल्मां ओर्ही लाट्टै च़की आणदै। तेऊ डाहा तै तिंयां धैल़ भबने तैहा प्रऊल़ी आजू बशैल़ी ज़ेता लै सुंदर प्रऊल़ बोला तै। ताकि सह एछदै डेऊंदै लोगा का भिख मांगे।<verse eid="ACT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 3:3" />ज़ांऊं तेऊ लाट्टै पतरास अर जोहन्‍ना भबना लै डेऊंदै भाल़ै, सह लागअ तिन्‍नां का भिख मांगदअ। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पतरासै अर जोहन्‍ना बोलअ तेऊ लाट्टै बाखा कोहरअ भाल़ी करै, “हाम्हां बाखा लै भाल़।” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />सह लागअ ऐहा आशा तिन्‍नां बाखा लै कोहरअ भाल़अ कि इनै लाअ मुल्है किज़ै दैई।<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />तेखअ बोलअ पतरासै, “सुन्‍नअ च़ंदी ता निं मुखा आथी। पर ज़ुंण मुखा आसा सह लाअ मंऐं ताल्है दैई। प्रभू ईशू मसीहा नासरीए नाओंऐं उझ़ू खल़अ अर हांढ-फिर।”<verse eid="ACT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7" />पतरासै झ़ैऊअ सह तेऊओ खाणअ हाथ ढाकी करै खल़अ अर तेभी हुऐ तेऊए ज़ान्हूं अर खूर राम्बल़ै किंडै अर <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />तेऊ दैनी उझै छ़ाहल़ अर सह उझ़ुअ खल़अ, सह लागअ हांढदअ-फिरदअ अर सह लागअ छ़ाहल़ा दैंदअ अर ठुहर्दअ अर परमेशरे स्तोती करदअ अर तिन्‍नां संघै डेऊअ भितरा लै भबने खोल़ै।<verse eid="ACT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9" />तेखअ होरी लोगै सह हांढदअ-फिरदअ भाल़ी अर परमेशरे स्तोती भाल़ी <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />सह बछ़ैणअ कि अह आसा सह ई ज़ुंण भबने सुंदर प्रऊल़ी आजू बेठी करै भिख मांगा त। ज़ुंण तेऊ लाट्टै लै हुअ, तेऊ च़मत्कारा भाल़ी हुऐ सोभ रहैन।<verse eid="ACT 3:10" /></para>
  <para style="s">भबनै पतरासो प्रच़ार</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />भबनै ज़ांऊं सह लाट्टअ पतरास अर जोहन्‍ना का थिअ ढाखुअ द, तेऊ भाल़ी हुऐ सोभ लोग हुऐ रहैन अर तिंयां आऐ भबने खोल़ै तैहा ज़ैगा लै ठुर्ही ज़ेता लै सुलैमानो च़ऊंरअ बोला तै।<verse eid="ACT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 3:12" />इहअ भाल़ी बोलअ पतरासै तिन्‍नां मणछा लै, “हे इज़राईली मणछो, तम्हैं किल्है हुऐ एऊ मणछा भाल़ी रहैन? अर हाम्हां बाखा लै किल्है आसा लागै दै इहअ करै भाल़ै कि ज़िहअ हाम्हैं ई किअ अह आपणीं शगती अर करै हांढदअ-फिरदअ? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />आबराम, इसहाक, याकब अर म्हारै दादा-बाबे परमेशरै रहैऊअ आपणैं दास ईशूओ प्रतप्प। ज़ुंण तम्हैं ढाकअ अर ज़ांऊं राज़पाल पिलातुसै तेऊ छ़ाडणेंओ बच़ार किअ, तेभै बोलअ तम्हैं सोभी-सोभी कि नांईं एऊ लोल़ी सज़ा भेटी।<verse eid="ACT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 3:14" />“तम्हैं निं सह पबित्र अर धर्मीं मणछ मनअ, तम्हैं किई राज़पाला का एही मांग कि एकी हत्या करनै आल़ै पापी करा कैद खानै का ईशूए बदल़ै थारी तैणीं आज़ाद। <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />तम्हैं पाअ ज़िन्दगी दैणैं आल़अ मारी, पर सह किअ परमेशरै मरी करै भिई ज़िऊंदअ अर एते शाजत आसा हाम्हैं ज़ुंणीं ईंयां गल्‍ला आपणीं आछी भाल़ी।<verse eid="ACT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 3:16" />“एऊ मणछा ज़हा तम्हैं धैल़ भाल़ा अर बछ़ैणा बी अर ज़हा तम्हैं एभै भाल़ै आसा लागै दै, एऊए देही दी आई मसीहा ईशूए नाओंऐं तागत। लाट्टअ मणछ लागअ मसीहा ईशू दी विश्वास करी हांढदअ-फिरदअ।<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“भाईओ, मुखा आसा थोघ कि थारै सैणैं पाअ नज़ाणै दी ईशू मारी किल्हैकि तिन्‍नां का निं थोघै त कि सह आसा मसीहा। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पर ज़ुंण गल्‍ला परमेशरै आपणैं सोभी गूरा बाती पैहलै ई हेरी ती खोज़ी कि मसीहा भुगतणअ दुख अर सह पाणअ मारी, ईंयां गल्‍ला हुई पूरी।<verse eid="ACT 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 3:19" />“तैही बोला हुंह आपणैं पापो प्राश्त करा, संघा फिरा परमेशरा बाखा, ताकि थारै पाप माफ होए। <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ज़ै तम्हैं इहअ करे, एक बगत एछणअ इहअ बी कि तम्हां का जाणअ थोघ लागी कि परमेशर आसा तम्हां संघै। परमेशरा छ़ाडणअ एकी धैल़ै मसीहा ईशू पृथूई लै बापस ज़ुंण तेऊ तम्हां लै पैहलै ई आसा छ़ांटअ द।<verse eid="ACT 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 3:21" />“अह आसा ज़रूरी कि ईशू स्वर्गै तेभै तैणीं रहे ज़ेभै तैणीं कि सह सोभी गल्‍ला ठीक निं मुक्‍के करी, ज़ेते बारै परमेशरै आझ़ा का पैहलै संसार शुरू हणैं ओर्ही आपणैं पबित्र गूरा बाती कई बारी आसा खोज़ी दी।<verse eid="ACT 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 3:22" />“ज़िहअ परमेशरे गूर मोसा बोलअ, ‘परमेशर बिधाता काढणअ थारै भाई-बंधा मांझ़ा का तम्हां लै मुंह ज़िहअ एक गूर, ज़िहअ सह गूर तम्हां का खोज़े, तम्हैं करै तिहअ ई।’<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">बधा. 18:15-18</ref></char></note><verse eid="ACT 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 3:23" />“पर तिंयां सोभ ज़ुंण तेऊ परमेशरे गूरे नांईं शुणें तिंयां करनै तिन्‍नां मणछा मांझ़ा का खतम।<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="LEV 23:29">लेब. 23:29</ref>; <ref loc="DEU 18:19">बधा. 18:19</ref></char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“परमेशरो गूर शमूएल अर तेऊ बाद निखल़ै दै सोभी परमेशरे गूरै आसा पैहलै ई हेरी दी ईंयां गल्‍ला खोज़ी कि एऊ ज़मानैं किज़ै हणअ। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तम्हैं आसा परमेशरे गूरे खिंबा का अर परमेशरे करारे साझ़ू ज़ुंण परमेशरै थारै दादा-बाबा संघा किई। ज़धू परमेशरै आबरामा का बोलअ, ‘तेरी लुआदा करै भेटणीं आजू पृथूईए सोभी खिंबा लै बर्गत।’<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 12:3">मूल. 12:3</ref>; <ref loc="GEN 18:18">18:18</ref>; <ref loc="GEN 22:18">22:18</ref>; <ref loc="GEN 26:4">26:4</ref></char></note><verse eid="ACT 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 3:26" />“परमेशरै छ़ाडअ आपणअ दास ईशू मरनै का बाद ज़िऊंदै हई सोभी का आजी तम्हां सेटा लै। ताकि तम्हां हरेक बूराई का दूर हई प्रभू का बर्गत भेटे।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">माहा सभा दी पतरास अर जोहन्‍ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />ज़ांऊं तिंयां प्रोहत लोगा का इहअ बोल्दै ई तै लागै दै, भबने पहरीए सरदार अर सदुकी पंथे लोग आऐ तिन्‍नां च़िक्‍कदै ठुर्ही। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />किल्हैकि तिन्‍नां आई तिन्‍नां लै रोश्शै कि तिंयां थिऐ लागै दै लोगा सखाऊंदै अर प्रभू ईशूए कथ्या खोज़ी-खोज़ी करै मरी करै ज़िऊंदै हणें बारै खोज़दै।<verse eid="ACT 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 4:3" />तिन्‍नैं ढाकै तिंयां संघा डाहै दुजै धैल़ै तैणीं कैद खानै पाई किल्हैकि तेभै गई ती सान्ह पल़ी। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पर परमेशरे बैण शुणनै आल़ै कई लोगै किअ ईशू दी विश्वास अर विश्वास करनै आल़ै रहै बझ़दै लागी अर तिंयां हुऐ कोई पांज़ हज़ारा।<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />दुजै धैल़ै हुअ इहअ कि तिन्‍नें हाकम, सैणैं, शास्त्री, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />प्रोहत, हन्‍ना, काईफा, जोहन्‍ना, सकंदर अर ज़ेतरै बी माहा प्रोहते घरानै का थिऐ तिंयां हुऐ सोभ एरुशलेम नगरीए कठा। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />तेखअ किऐ तिंयां दुहै सोभी नदरी खल़ै अर तेखअ लागै तिन्‍नां का पुछ़दै, “अह काम तम्हैं कसरी शगती करै अर कसरै नाओंए किअ?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />पबित्र आत्मां दैनी पतरासा लै बोल़णें शगती अर तेऊ तिन्‍नां लोगे सैणैं लै बोलअ, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />“हे लोगो, सरदारो अर सैणैं लोगो, एऊ दुबल़ै, लाट्टै मणछा संघै ज़ुंण भलाई हुई, ज़ै आझ़ हाम्हां का एते बारै आसा पुछ़-ज़ाच़ लाई दी करी कि अह ऐहा बमारी का किल्है अर किहअ करै बच़अ? <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />तै लआ तम्हैं सोभ अर सारै इज़राईली प्रभू ईशू मसीहा नासरीए नाओंए शूणीं।</para>
  <para style="p" vid="ACT 4:10">“ज़ुंण तम्हैं क्रूसा दी छ़ड़ाऊई करै मारअ सह किअ परमेशरै मरी करै भिई ज़िऊंदअ अर तेऊए शगती करै अर तेऊए नाओंए हुअ अह मणछ राम्बल़अ ज़ुंण तम्हां सम्हनै राज्ज़ी राम्बल़अ आसा खल़्हुअ द। <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />नासरत गराऊंओ ईशू आसा सह ई ज़ान ज़सरै बारै शास्त्रा दी पैहलै ई आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भज. 118:22</ref>,<ref loc="PSA 118:23">23</ref>; <ref loc="DAN 2:34">दान. 2:34</ref>,<ref loc="DAN 2:35">35</ref></char></note></para>
  <para style="q" vid="ACT 4:11">‘ज़ुंण पात्थर राज़ मिस्त्री किछ़ू कामों निं समझ़अ</para>
  <para style="q" vid="ACT 4:11">सह बणाईं कूणींए ज़ान।’<verse eid="ACT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 4:12" />“ईशू का सुआई निं होर कोहै उद्धार करी सकदअ, किल्हैकि सरगा हेठै निं एऊ संसारै मणछा लै परमेशरै होर कोहै नाअं आथी दैनअ द ज़हा करै हाम्हां उद्धार भेटी सके।”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />ज़ांऊं तिन्‍नैं पतरास अर जोहन्‍ने हिम्मत भाल़ी, अर इहअ थोघ लागअ कि ईंयां आसा नपहल़ अर आम मणछ, तिंयां हुऐ रहैन, अर तेखअ तिन्‍नैं बछ़ैणैं कि ईंयां आसा ईशू संघै रहै दै। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />सह मणछ ज़ुंण नरोगअ हुअ त, तेऊ मणछा पतरास अर जोहन्‍ना संघै खल़्हुऐ दै भाल़ी निं तिंयां तिन्‍नें खलाफ किछ़ै करी सकै। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />पर तिन्‍नां तैहा सभा का बागै डेऊणेओ हुकम दैई लागै तिंयां आप्पू मांझ़ै बच़ार करदै,<verse eid="ACT 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 4:16" />“इना मणछा संघै कै करनअ? किल्हैकि एरुशलेम नगरीए रहणैं आल़ै का गअ खास्सै मणछा का थोघ लागी कि इना करै हेरअ एक च़मत्कारो नछ़ैण रहैऊई अर हाम्हैं बी निं ऐहा गल्‍ला लै हुधूई सकदै। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पर इहअ करा कि अह गल्‍ल निं लोल़ी होरी लोगा मांझ़ै खास्सी छिंघुई। ईंयां डरैऊंणै हाम्हां, ताकि एऊ ईशू नाओंआं कहा होरी मणछा का नां खोज़े।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />तेखअ शादै यहूदी सैणैं पतरास अर जोहन्‍ना आप्पू सेटा भितरा लै अर तिन्‍नां दुही लै दैनी चतैनगी कि आझ़ा पोर्ही निं हाम्हां का तम्हैं ईशूए बारै कहा का सखाऊंदै या बोल्दै लोल़ी शुझुऐ।<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />पर पतरास अर जोहन्‍ना दैनअ ज़बाब, “तम्हैं ई करा ऐहा गल्‍लो फैंसलअ कि परमेशरा नेल़ रहणअ आसा भलअ कि परमेशरा का बढी करै हाम्हैं थारी गल्‍ला मनूं। <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />किल्हैकि इहअ, हाम्हां का हई निं सकदअ कि ज़ुंण हाम्हैं भाल़अ अर शूणअ, तेऊ हाम्हैं होरी का नांईं खोज़े।”<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />तेखअ छ़ाडै तिन्‍नैं तिंयां धमकी दैई करै, किल्हैकि लोगे बज़्हा निं तिन्‍नां सज़ा दैणा लै कोई दाअ-पेच़ भेटअ, अर इहअ बी हुअ कि ज़ुंण तिंयां गल्‍ला हुई-बिति ती तेता करै करा तै सोभ लोग परमेशरे बड़ैई। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />ज़हा मणछा लै अह च़मत्कार हुअ सह थिअ च़ाल़्ही साला का बी खास्सअ प्रोढअ अर तेऊए ज़ांघा ती हुऐ ज़ल्मां ओर्ही मूंईं दी।<verse eid="ACT 4:22" /></para>
  <para style="s">सोभी विश्वासीए प्राथणां</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />तिधा का छ़ुटी पुजै तिंयां आपणैं साथी सेटा बापस अर ज़ुंण बी बडै प्रोहत अर सैणैं तिन्‍नां का बोलअ सह खोज़अ तिन्‍नैं तिन्‍नां का। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />इहअ शूणीं तिन्‍नैं सोभी एक मन्‍न हई परमेशरा लै ज़ोरै-ज़ोरै बोलअ, “हे मालक, तूह आसा सह ई ज़ुंणी सरग, पृथूई, समुंदर अर ज़ुंण बी तेथ दी आसा, तिंयां सोभै गल्‍ला बणाईं।<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">लुआ. 20:11</ref>; <ref loc="PSA 146:6">भज. 146:6</ref></char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />तंऐं बोलअ पबित्र आत्मां करै आपणैं दास म्हारै दाद-बाब राज़ै दाबेदे खाखा का,<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="PSA 2:12">भज. 2:12</ref></char></note></para>
  <para style="q" vid="ACT 4:25">‘देशा-देशे लोग किल्है आसा रोश्शै लाल-पिंऊंल़ै हुऐ दै?</para>
  <para style="q" vid="ACT 4:25">तिन्‍नैं किल्है लाअ फज़ूल गल्‍ला सोठणा लै आपणअ बगत ज़ांऐं करी?<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />धरतीए सोभी राज़ै किअ बिधाता</para>
  <para style="q" vid="ACT 4:26">अर तेऊ राज़ै लै एक्‍कअ ज़ुंण परमेशरै आप्पै आसा छ़ांटअ द।’<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />“किल्हैकि सच्च़ी तेरै पबित्र दास ईशूए खलाफ ज़सरअ तंऐं अभिषेक किअ, हेरोदेस अर पुंतिउस पिलातुस बी हुऐ होरी ज़ाती अर इज़राईली संघै ऐहा नगरी कठा कि<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 61:1">ईशा. 61:1</ref></char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ज़ुंण किछ़ पैहलै ई का तेरी शगती अर अक्ल करै सोठअ त तिहअ ई करे।<verse eid="ACT 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 4:29" />“ऐबै हे प्रभू, तिन्‍नें धमकी शुण कि तिंयां आसा लागै दै बोल्दै कि तिन्‍नां हाम्हैं किहअ करै मारनै, अर हाम्हां तेरै दासा लै दै इहअ बरदान कि हाम्हां तेरै बारै सोभी का खोज़णें हिम्मत होए। <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />हे परमेशर आपणअ हाथ कर शगती संघै आजू ताकि हाम्हैं तेरै पबित्र दास ईशूए नाओंऐं लोगे हर रोगा का नरोगै हणें नछ़ैण अर च़मत्कार करी सके।”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />ज़ांऊं तिंयां प्राथणां करी मुक्‍कै, सह ज़ैगा ज़िधी तिंयां कठा तै हुऐ दै तिधी हुई ज़ेही ज़ाज़री अर तिंयां सोभ भर्हुऐ पबित्र आत्मां करै अर परमेशरे बैणा रहै हैअ संघै खोज़दै लागी।<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासीए कठा मिली करै ज़िन्दगी</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />विश्वास करनै आल़ी टोली ती तत्त-दिला का एक हुई दी। इधी तैणीं कि कोहै निं आपणीं ज़ैदाता लै बी आपणीं बोल्दअ त। पर तिन्‍नें ती सोभै गल्‍ला एकी-दुजै लै कठा।<verse eid="ACT 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 4:33" />शधाणूं रहै प्रभू ईशूए ज़िऊंदै हणें बारै खास्सै बला संघै खुशीओ समाद खोज़दै लागी अर तिन्‍नां लै दैआ त परमेशर महान जश। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />तिन्‍नां मांझ़ै नांईं तै कोहै विश्वासी गरीब आथी, किल्हैकि ज़हा का बी घअर अर ज़ैदात हआ ती, तेता पाआ तै तिंयां बेच़ी। ज़ैदात बेच़ी करा तै तिंयां सारै ढब्बै-धेल्‍लै शधाणूं सेटा कठा। <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />शधाणूं करा तै तिन्‍नां ढब्बै-धेल्‍लै करै हर विश्वासी लै तेऊए गरज़े साबै बांडी। इहअ करै हआ ती हर विश्वासीए गरज़ा पूरी।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />कुप्रास टापू का थिअ एक युसुफ नाओं मणछ, ज़ुंण लेबी गोत्रा मांझ़ै आसा त। शधाणूं डाहअ तेऊओ नाअं बरनबास मतलब इहअ मणछ ज़ुंण हर बगत होरी लै हैअ दैआ। <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />तेऊ का थिई धख ज़िम्मीं-ज़ैगा अर तेऊ सह बेच़ी अर तेते किम्मत ज़ुंण भेटी सह आणी तेऊ शधाणूं सेटा लै।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्याह अर सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्याह नाओं बी त एक मणछ अर तेऊए बेटल़ी सफीरा बी बेच़ी आपणीं ज़िम्मीं का धख ज़ेही। <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />तेता बेच़ी ज़ुंण किम्मत भेटी, तेता का डाही धख आप्पू का च़ोरी अर ऐहा गल्‍लो थोघ त तेऊए लाल़ी का बी अर तिंयां बाकी ढब्बै पजैल़ै तिन्‍नैं शधाणूं सेटा।<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />पर पतरासै बोलअ तेऊ लै, “हनन्याह, राख्सै तेरै मन्‍नैं अह गल्‍ल किल्है पाई कि तूह पबित्र आत्मां का झ़ुठअ बोले, कि ज़िम्मीं बेच़ी भेटै दै ढब्बै मांझ़ै तूह धख च़ोरी डाहे? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />ज़ेभै तैणीं सह ताह सेटा ती, सह कै तेरी निं ती? ज़ांऊं सह बिक्‍की गई ती, तेभै बी कै सह तेरै बशै निं ती? तंऐं आपणैं मन्‍नैं इहअ बच़ार किल्है किअ? तंऐं निं मणछा का झ़ुठअ बोलअ पर तंऐं बोलअ परमेशरा का झ़ुठअ।”<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />इना गल्‍ला शुणदी पल़अ हनन्याह धरनीं अर तेऊ शोटै प्राण। ज़ुंणी बी ईंयां गल्‍ला शूणीं तिंयां डरै। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />तेखअ बणाईं कई लोगै तेऊए खाट अर बागै निंईं करै लागै तेऊए क्रिया कर्म करना लै निंदै।<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />कोई एकी पहरा बाद आई तेऊए लाल़ी ज़ुंण किछ़ हुअ त इना गल्‍ला का नज़ाण तिधी भितरा लै। <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />तेखअ पुछ़अ पतरासै तैहा का, “मुखा खोज़ कि सह ज़िम्मीं तम्हैं तेतरी ई किम्मता दी बेच़ी ती?”</para>
  <para style="p" vid="ACT 5:8">तैहा बोलअ, “हाँ, सह बेच़ी तेतरी ई किम्मता दी।”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />पतरासै बोलअ तैहा लै, “अह कै गल्‍ल आसा कि तम्हैं दुही आसा किअ द प्रभूए आत्मां परखणां लै एक्‍कअ? भाल़ तेरै मर्धे क्रिया-कर्म करनै आल़ै आसा दुआरै खल़्हुऐ दै अर तुबी निंणीं इना बागा लै।”<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />सह पल़ी तेभी धरनीं अर तैहा बी शोटै प्राण, अर तिन्‍नैं ज़ुआन मणछै भाल़अ भितरी एछी कि सह गई मरी अर तिन्‍नैं निंईं सह बी बागै अर तेसो बी किअ तेसे लाल़ै संघै क्रिया-कर्म। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />एरुशलेम विश्वासीए टोली दी अर ज़ुंणी बी ईंयां गल्‍ला शूणीं तिंयां सोभ डरै।<verse eid="ACT 5:11" /></para>
  <para style="s">नछ़ैण अर नुआहरै काम</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />शधाणूं करै हआ तै लोगा मांझ़ै कई नछ़ैण अर च़मत्कार प्रगट अर भबनै हआ तै तिंयां सोभै मसीहा दी विश्वास करनै आल़ै सुलैमाने च़ऊंरै कठा। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पर होरी मांझ़ै निं कहा एही हिम्मत हंदी ती कि तिन्‍नां मांझ़ै डेओए, तैबी करा तै लोग तिन्‍नें खास्सी बड़ैई। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />विश्वास करनै आल़ै खास्सै बेटल़ी अर मर्ध रहै प्रभूए विश्वासीए टोली दी होर बी खास्सै एछदै लागी। <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />इधी तैणीं कि लोग आणा तै रोगी मणछा मांज़ै अर चकाठी दी च़की, संघा डाहा तै बाता सताऊई कि ज़ेभै पतरास एछे अर तेऊए छ़ैल्‍ली तिन्‍नां प्रैंदै पल़े अर तेता करै तिंयां नरोगै होए। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />एरुशलेम नगरी ओरी-पोरीए नगरी का बी हआ तै लोग खास्सै रोगी अर भूत शाचै दै मणछ आणी कठा अर तिन्‍नां सोभी करा तै शधाणूं नरोगै।<verse eid="ACT 5:16" /></para>
  <para style="s">शधाणूं कैद खानै पाणै</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />तेखअ ज़िधूऐ तिन्‍नां लै माहा प्रोहत अर तिन्‍नें साथी ज़ुंण सदुकी पंथे तै। <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />तिन्‍नैं ढाकै शधाणूं संघा डाहै तिंयां कैद खानै गोटी। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पर राची आअ परमेशरो एक स्वर्ग दूत, तेऊ घुआल़अ कैद खानेओ दुआर संघा काढै तिंयां बागा लै। तेऊ स्वर्ग दूतै बोलअ तिन्‍नां लै इहअ, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“डेओआ, अर भबने खल़्हुई करै खोज़ा ऐहा नऊंईं ज़िन्दगीए सोभी गल्‍ला लोगा का।”<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />तिंयां डेऊऐ इना गल्‍ला शूणीं राच भैंदी भबना लै संघा लागै लोगा लै शिक्षा दैंदै।</para>
  <para style="p" vid="ACT 5:21">पर माहा प्रोहत अर तेऊए साथी किऐ माहा सभा दी एछी इज़राईलीए सैणैं कठा अर कैद खानै लै दैनअ समाद कि तिन्‍नां आणा माहा सभा लै। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />पर तिन्‍नां सपाही निं तिंयां कैद खानै भितरी भेटै, यहूदी सैणैं सेटा बापस पुजी दैनअ तिन्‍नैं इहअ समाद, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“हाम्हैं आऐ कैदखाने का भाल़ी, तिधी भाल़अ हाम्हैं कि सपाही आसा दुआरै शाणै लाऐ दै, अर आप्पू आसा बागै राम्बल़अ पहरअ पाअ द। पर ज़ांऊं हाम्हैं कैद खानेओ दुआर घुआल़अ, तेथ निं भितरी हाम्हां कोह भेटअ!”<verse eid="ACT 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 5:24" />ज़ांऊं बिधाते भबने कारदारै अर बडै प्रोहतै ईंयां गल्‍ला शूणीं, तिन्‍नां पल़अ बडअ फिकर कि इना गल्‍लो आजू किज़ै हणअ? <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />तेतरी आअ कुंण तिधी, तेऊ बोलअ तिन्‍नां लै, “हेरा, ज़ुंण तम्हैं कैद खानै थिऐ हूल़ी डाहै दै, तिंयां आसा भबनै खल़्हुई लोगा लै शिक्षा दैंदै लागै दै!” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />तेखअ आणै भबने कारदार अर सपाही तिंयां शधाणूं माहा सभा लै। पर ज़ोरा-ज़ोरी घिशी निं तिन्‍नैं तिंयां आणै। किल्हैकि तिन्‍नां ती लोगे डअर कि इहअ निं हअ कि लोग तिन्‍नां लै पात्थरो ढो दैए।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />तेखअ किऐ तिंयां शधाणूं माहा सभा दी खल़ै अर माहा प्रोहतै पुछ़अ तिन्‍नां का, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“हाम्हैं कै तम्हैं पैहलै निं समझ़ाऊऐ तै कि तम्हैं निं ईशूए नाओंए शिक्षा दैई? तैबी छिंगी तम्हैं ईंयां गल्‍ला सारी एरुशलेम नगरी। तम्हैं किल्है च़ाहा तेऊ मणछे हत्या करनैओ दोश हाम्हां लै लाणअ?”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />तेखअ दैनअ पतरासै अर होरी शधाणूं ज़बाब, “थारी गल्‍ला का खास्सअ आसा परमेशरो हुकम मनणअ म्हारी ज़िम्मैंबारी अर कर्म। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />म्हारै दादा-बाबे परमेशरै किअ मसीहा ईशू मरी करै भिई ज़िऊंदअ ज़ुंण तम्हैं क्रूसा दी छ़ड़ाऊई करै मारअ त।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="DEU 21:22-23">बधा. 21:22-23</ref></char></note><verse eid="ACT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 5:31" />“परमेशरै दैनी ईशू लै सोभी का बडी पदबी। तेऊ बणाअं सह हाम्हां सोभिओ उद्धार करनै आल़अ ज़ुंण हाम्हां प्रैंदै राज़ करे। सह बोला हाम्हां इज़राईली लै कि पापो प्राश्त करा ताकि सह म्हारै पाप माफ करी सके।<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="LUK 24:47">लूक. 24:47</ref></char></note><verse eid="ACT 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 5:32" />“हाम्हैं आसा इना गल्‍ले शाजत ज़ुंणीं ईंयां गल्‍ला आपणीं आछी भाल़ी, पबित्र आत्मां बी, ज़ुंण परमेशरै आपणैं तिन्‍नां हुकम मनणै आल़ै लै आसा दैनी दी।”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />ज़ांऊं सभा दी बेठै दै लोगै ईंयां गल्‍ला शूणीं, तिंयां हुऐ शधाणूं लै रोश्शै लाल-पिंऊंल़ै अर तिंयां च़ाहा तै तिन्‍नां मारी पाणै। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />पर गमलिएल नाओं एक फरीसी मणछ ज़ुंण शास्त्रो ज़ाणकार त, तेऊए ती सोभी लोगा मांझ़ै खास्सी इज़त, तेऊ दैनअ दालता दी खल़्हुई करै तिन्‍नां शधाणूं थोल़ी घल़ी बागै करनैओ हुकम।<verse eid="ACT 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 5:35" />तेखअ बोलअ तेऊ माहा सभा दी बेठै दै लोगा लै, “हे इज़राईली मणछो, ज़ुंण बी तम्हैं इना मणछा संघै करनअ च़ाहा, तेता करै हेरे सोठी-समझ़ी।” <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />किल्हैकि इना धैल़ै का पैहलै निखल़अ त थिऊदास नाओं मणछ इहअ बोली कि हुंबी आसा किज़ै। कोई च़ार शौ मणछ हुऐ तेऊ संघै अर सह पाअ मारी अर ज़ेतरै लोग तेऊ मना तै, तिंयां छिंघुऐ ओरी-पोरी अर तिंयां बी मुक्‍कै।<verse eid="ACT 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 5:37" />“तेखअ आअ नाअं दर्ज़ करने धैल़ै गलील मुल्खो रहणैं आल़अ यहूदा बी अर धख लोग बी फरेऊऐ तेऊ आप्पू बाखा, पर सह बी हुअ बरैबाद अर ज़ेतरै लोग तेऊ पिछ़ू तै, तिंयां बी छिंघुऐ आपणीं-आपणीं बाता।<verse eid="ACT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 5:38" />“ऐबै बोला हुंह तम्हां लै इहअ कि इना मणछ का रहा दूर अर इना का निं किछ़ै मतलब डाहा, किल्हैकि, ज़ै अह धर्म या काम मणछा बाखा का होए, तै हणअ अह एकी धैल़ै खतम, <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पर ज़ै अह परमेशरा का आसा, तै निं तम्हैं इना कधि खतम करी सकदै, किधी इहअ निं हआ कि तम्हैं होए परमेशरा संघै जुधा करनै आल़ै!”<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />तेखअ तिन्‍नैं सोभी तेऊए गल्‍ला मनी, शधाणूं शादै अर तिंयां च़िक्‍कै अर इहअ बोली छ़ाडै कि ईशूए नाओंआं दी निं कोही का भिई गल्‍ला करी।<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />तिंयां शधाणूं डेऊऐ ऐहा गल्‍ला का खुश हई माहा सभा का कि हाम्हैं प्रभूए नाओंए बारै अर बेइज़ती ज़िरनै जोगी, हुऐ। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />इहअ करै रहै तिंयां धैल़ भबनै अर घअरै-घअरै लागी एही शिक्षा दैंदै, “प्रभू ईशू आसा मसीहा” अर तेऊए खुशीए समादा खोज़णैं का निं पिछ़ू हटै आथी।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">सात दास छ़ांटणैं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />तिन्‍नां धैल़ै ज़ांऊं खास्सै मणछै मसीहा दी विश्वास किअ, यूनानी बोली बोल़णैं आल़ै विश्वासी लागै इब्रानी बोली बोल़णैं आल़ै लै बोल्दै कि हर धैल़ै निं ढब्बै-धेल्‍लै अर खाणैं-पिणैं दी म्हारी बिधबा बेटल़ीओ ईंयां च़ेल्‍लै मांझ़ै कोहै धैन-खैल करदअ।<verse eid="ACT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 6:2" />तेखअ हुऐ तिंयां बारा च़ेल्‍लै आप्पू मांझ़ै कठा अर तेखअ बोलअ तिन्‍नैं एरुशलेम टोलीए होरी च़ेल्‍लै लै, “अह गल्‍ल निं ठीक हणीं कि हाम्हैं परमेशरे बैणा छ़ाडी खैऊंदै-पणैंऊंदै रहे लागी। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />भाईओ, तैही बोला हुंह, आप्पू मांझ़ा का छ़ांटा सात छ़ल़ैघ मणछ ज़ुंण पबित्र आत्मां अर अक्ली दी भरपूर होए, ताकि तिंयां एऊ काम-काज़ करे। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />पर हाम्हां रहणअ प्राथणां अर बैणे शिक्षा दैणें च़ाकरी लागी।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />अह गल्‍ल लागी सारी टोली बधिया अर तिन्‍नैं स्तिफनुस नाओं एक मर्ध ज़ुंण विश्वास अर पबित्र आत्मां दी भरपूर थिअ, अर फलिप्प, प्रखरुस, नीकानोर, तिमोन, परमनास अर अन्ताकिया रहणैं आल़अ निकूलस ज़ुंण यहूदी पक्षा का आअ त, तिंयां छ़ांटै। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />तिन्‍नैं आणै तिंयां सात ज़ण्हैं शधाणूं सेटा लै अर प्राथणां करी तिन्‍नां प्रैंदै हाथ डाही करै दैनअ तिन्‍नां लै च़ाकरी करनैओ हक।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />परमेशरो बैण लागअ सारै दी पुजदअ अर एरुशलेम हुऐ नगरी खास्सै च़ेल्‍लै अर कई यहूदी प्रोहत बी मनअ अह समाद अर तिन्‍नैं बी किअ मसीहा ईशू दी विश्वास।<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनुस कैद करनअ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनुस रहैऊआ त जश अर शगती दी भर्हुई करै लोगा मांझ़ै बडै-बडै च़मत्कार अर नछ़ैण। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />तेखअ लागै आज़ादी नाओंए सभागृहे कई लोग स्तिफनुसे बरोध करी हठल़दै ज़ुंण कुरेन नगरी, सकंदरीआ नगरी, किलकिआ अर एशिया मुल्खा का थिऐ। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पर तिंयां निं स्तिफनुसे अक्ल अर पबित्र आत्मां करै भेटै दै ज्ञैना सम्हनै टेक्‍की सकै।<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />एता लै शकाऊऐ तिन्‍नैं होर लोग अर तिंयां लागै इहअ बोल्दै, “हाम्हैं शूणीं मोसा गूरे बधाने अर परमेशरे बारै निंदा करने गल्‍ला।” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />तिन्‍नैं शकाऊऐ स्तिफनुसे खलाफ होर यहूदी सैणैं अर शास्त्री अर तिन्‍नैं किअ सह कैद संघा निंयं सह माहा सभा लै।<verse eid="ACT 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 6:13" />तेऊ लै आणै तिन्‍नैं झ़ुठी शाजत दैणैं आल़ै लोल़ी, तिन्‍नैं दैनी एही झ़ुठी शाजत, “अह मणछ निस्सअ ऐहा पबित्र ज़ैगा अर बधाने खलाफ बोल़णअ छ़ाडी।<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JER 26:11">जेर. 26:11</ref></char></note> <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />किल्हैकि हाम्हैं शूणअ अह इहअ बोल्दअ कि नासरत नगरीए ईशू पाणअ अह पबित्र भबन ढोल़ी अर तिंयां रबाज़ पाणै तेऊ बदल़ी ज़ुंण मोसा गूरै आसा हाम्हां लै खोज़ै दै।”<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />ज़ुंण माहा सभा दी तै बेठै दै तिंयां सोभ लागै स्तिफनुसा बाखा भाल़ै, तेऊओ मुंह त स्वर्ग दूता ज़िहअ च़मकदअ लागअ द।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनुसो प्रच़ार</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तेखअ पुछ़अ माहा प्रोहतै स्तिफनुसा का, “ज़ुंण गल्‍ला मंऐं एभै शूणीं ईंयां गल्‍ला कै सच्च़ी आसा?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />स्तिफनुसै दैनअ ज़बाब, “भाईओ अर अदर करनै जोगी सैणैं मणछो, मेरी गल्‍ला शूणां। म्हारअ दाद-बाब आबराम ज़धू हारान गराऊंऐं बस्सणै का आजी सह तेऊ मेसोपोटामिया मुल्खै थिअ, तधू दैनअ आपणैं प्रतप्पा दी भरपूर परमेशरै तेऊ लै दर्शण। <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />तेऊ लै बोलअ परमेशरै इहअ, ‘तूह डेऊ आपणैं देश अर आपणैं टबरा छ़ाडी तेऊ देशा लै ज़ुंण मुंह ताखा रहैऊंणअ।’<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">मूल. 12:1</ref></char></note><verse eid="ACT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4" />“तेखअ आअ सह कसदीए देशा का निखल़ी हारान गराऊंआं लै। तेऊए बाब मरनै का बाद बसाऊअ सह परमेशरे तिधा का आणी एऊ देशा दी ज़हा दी आझ़काला तम्हैं आसा बस्सै दै।<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 12:5">मूल. 12:5</ref></char></note><verse eid="ACT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 7:5" />“पर परमेशरै निं तेऊ लै इधी किछ़ ज़ैदात दैनी, इधी तैणीं कि खूरा टकैल़णा जोगी ज़ैगा बी निं तेऊ लै दैनी, पर परमेशरै किई करार, ‘मुंह करनअ अह देश ताह बाद तेरै आजू तेरी एछणैं आल़ी पोस्तीए हाथै।’ पर तेऊए निं तेभै तैणीं कोई बी आद-लुआद ती।<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 13:15">मूल. 13:15</ref>; <ref loc="GEN 15:18">15:18</ref>; <ref loc="GEN 16:1">16:1</ref>; <ref loc="GEN 24:7">24:7</ref>; <ref loc="DEU 2:5">बधा. 2:5</ref>; <ref loc="DEU 11:5">11:5</ref></char></note><verse eid="ACT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 7:6" />“परमेशरै बोलअ इहअ कि तेरी आद-लुआद हणीं पराऐ देशै परदेसी, अर तिन्‍नां डाहणैं तिंयां गलाम बणाईं, अर च़ऊ शौआ साला तैणीं दैणअ तिन्‍नां लै दुख।<verse eid="ACT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 7:7" />“तेखअ बोलअ परमेशरै इहअ, ‘ज़हा ज़ातीए तिंयां गलाम हणैं, तिन्‍नां लै दैणीं मुंह सज़ा। तेखअ करनी तिन्‍नां तिधा का छ़ुटी एऊ देशै मेरी च़ाकरी।’<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="GEN 15:14">मूल. 15:14</ref>; <ref loc="EXO 3:12">लुआ. 3:12</ref></char></note><verse eid="ACT 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 7:8" />“प्रभू किई तेऊ संघै खतैर करने करार। ज़ांऊं आबरामो शोहरू इसहाक पैईदा हुअ, तेऊ किअ आठुऐ धैल़ै तेऊओ खतैर। इसहाका का हुअ याकब अर याकबा का हुऐ बारा ज़ण्हैं पैईदा ज़हा लै हाम्हैं यहूदी दाद-बाब बोला।<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-11">मूल. 17:10-11</ref>; <ref loc="GEN 21:4">21:4</ref></char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“याकबे होरी शोहरू ज़ुंण म्हारै दाद-बाब थिऐ तिन्‍नैं डाही आपणैं भाई युसुफा संघै ज़ीद अर सह पाअ मिसर देशा लै डेऊणैं आल़ै का बेच़ी। पर परमेशरै किई हर ज़ैगा युसुफे मज़त।<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:28">मूल. 37:28</ref>; <ref loc="GEN 39:2-3">39:2-3</ref>; <ref loc="GEN 45:4">45:4</ref></char></note><verse eid="ACT 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 7:10" />“युसुफ बच़ाऊअ तेऊए सोभी दुखा का अर मिसर देशे माहा राज़ै सेटा दैनअ तेऊ लै जश अर अक्ल, सह बणाअं तेऊ सारै मिसर देशै अर सोभी गल्‍लो राज़पाल।<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 39:21">मूल. 39:21</ref>; <ref loc="GEN 41:40">41:40</ref>,<ref loc="GEN 41:43">43</ref>,<ref loc="GEN 41:46">46</ref>; <ref loc="PSA 105:21">भज. 105:21</ref></char></note><verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />“तेखअ पल़अ मिसर देशै अर कनान देशै नकाल़। ज़ेता करै भारी खरी पल़ी अर म्हारै दादा-बाबा निं रोटी निस्सी ती भेटी।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 41:54">मूल. 41:54</ref>,<ref loc="GEN 41:55">55</ref>; <ref loc="GEN 42:5">42:5</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />पर याकबै इहअ शूणीं कि मिसर देशै आसा नाज़, अर म्हारै दाद-बाब छ़ाडै पैहली बारी नाज़ा आणदै मिसर देशा लै।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="GEN 42:2">मूल. 42:2</ref></char></note><verse eid="ACT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 7:13" />“ज़ांऊं तिंयां दुजी बारी नाज़ा आणदै डेऊऐ, तेखअ आअ युसुफ आपणैं भाई सम्हनै अर तेखअ मिलै युसुफे टबर बी मिसर देशे माहा राज़ै का।<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">मूल. 45:1</ref>,<ref loc="GEN 45:3">3</ref>,<ref loc="GEN 45:16">16</ref></char></note><verse eid="ACT 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 7:14" />“तेखअ शादै युसुफै आपणअ बाब याकब अर सारै टबर मिसर देशा लै। तिंयां सोभै तै पझत्तर ज़ण्हैं।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-11">मूल. 45:9-11</ref>,<ref loc="GEN 45:18-19">18-19</ref>; <ref loc="EXO 1:5">लुआ. 1:5</ref>; <ref loc="DEU 10:22">बधा. 10:22</ref></char></note><verse eid="ACT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 7:15" />“याकब डेऊअ आपणैं टबरा संघा निंईं मिसर देशा लै। खास्सी साला बाद सह बी मूंअ तिधी अर तेऊए लान्हैं ज़ुंण म्हारै दाद-बाब आसा तिंयां बी मूंऐं तिधी।<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 45:5">मूल. 45:5</ref>,<ref loc="GEN 45:6">6</ref>; <ref loc="GEN 49:33">49:33</ref>; <ref loc="EXO 1:6">लुआ. 1:6</ref></char></note><verse eid="ACT 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 7:16" />“तिन्‍नें हस्तू पजैल़ै शकेम नगरी अर तिधी डाहै तिन्‍नैं तिंयां तैहा ज़ैगा घोरी दाबी, ज़ुंण आबरामै च़ंदी दैई शकेम नगरी हमोरे शोहरू का मोलै ती लई दी।<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:16">मूल. 23:16</ref>,<ref loc="GEN 23:17">17</ref>; <ref loc="GEN 33:19">33:19</ref>; <ref loc="GEN 49:29">49:29</ref>,<ref loc="GEN 49:30">30</ref>; <ref loc="GEN 50:13">50:13</ref>; <ref loc="JOS 24:32">ज़ैह. 24:32</ref></char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“पर ज़ांऊं तैहा करार पूरै हणैंओ बगत आअ ज़ुंण परमेशरै आबरामा संघै किई ती, मिसर देशै हुऐ इज़राईली खास्सै। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />ज़ांऊं मिसर देशै दुजअ राज़अ हुअ, तेऊ का निं युसुफे बारै थोघ आथी त।<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">लुआ. 1:7-8</ref></char></note><verse eid="ACT 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 7:19" />“तेऊ किई म्हारी ज़ाती संघै च़लाकी अर म्हारै दादा-बाबा लै दैनअ कष्ट कि तिन्‍नां पल़ै आपणैं शोहरू शोटणै अर तिंयां निं ज़िऊंदै रहै।<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:9">लुआ. 1:9</ref>,<ref loc="EXO 1:10">10</ref>,<ref loc="EXO 1:18">18</ref>,<ref loc="EXO 1:22">22</ref></char></note><verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />“तेऊ ज़मानैं हुअ मोसा पैईदा, सह शोहरू त, परमेशरा का शुझुअ सह हेरनअ-शुणनअ बधिया अर सह रह चिई भिन्‍नैं आपणैं बाबे घअरै गुप्त।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">लुआ. 2:2</ref> </char></note><verse eid="ACT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 7:21" />“ज़ांऊं तिंयां तेऊ शोहरू गुप्त डाही निं सकै, सह बहाऊअ तिन्‍नैं नदी दी। सह च़कअ मिसर देशे माहा राज़ेए देई, अर तैहा धाचअ सह आपणअ शोहरू बणाईं करै।<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:5">लुआ. 2:5</ref>,<ref loc="EXO 2:10">10</ref></char></note><verse eid="ACT 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 7:22" />“मोसा का सखाऊई मिसर देशे लोगे कई बिद्या, इहअ करै त सह गल्‍ला अर कामां दी शगती आल़अ। <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />ज़ांऊं सह च़ाल़्ही सालो हुअ, तेऊए मन्‍नैं आई एही कि हुंह डेऊं आपणैं इज़राईली भाई-बंधा सेटा मिलदअ,<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11">लुआ. 2:11</ref></char></note><verse eid="ACT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 7:24" />“तेऊ भाल़अ कि एक मिसर देशे मणछै किअ इज़राईली मणछा लै ज़ुल्म। सह बी डेऊअ तेऊ बच़ाऊंदअ अर मिसर देशे मणछा मारी करै लअ तेऊ इज़राईली मणछो बदल़अ।<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="EXO 2:12">लुआ. 2:12</ref></char></note> <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />तेऊ सोठअ कि मेरै इना भाई समझ़णअ कि परमेशरा करनै मेरै हाथै गलामी का आज़ाद, पर तिन्‍नैं निं समझ़अ।<verse eid="ACT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26" />“दुजै धैल़ै ज़ांऊं तिन्‍नां आप्पू मांझ़ै झ़गल़अ पल़अ, सह आअ तिधी अर तिन्‍नां लागअ आप्पू मांझ़ै मेल़-ज़ोल़ डाही रहणा लै समझ़ाऊंदअ, ‘ओ मणछो, तम्हैं ता आप्पू मांझ़ै भाई-भाई आसा, तम्हैं किल्है आसा एकी-दुजै लै ज़ुल्म करदै लागै दै?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पर ज़ुंणी आपणैं इज़राईली भाई लै बूरअ किअ, तेऊ किअ सह इहअ बोली दूर, ‘तूह कुंणी बणाअं म्हारअ पांच़? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />तूह कै मुंह बी तिहअ ई च़ाहा मारी पाणअ ज़िहअ तंऐं हिझ़ सह मिसर देशो मणछ पाअ मारी?’<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="EXO 2:13">लुआ. 2:13</ref>,<ref loc="EXO 2:14">14</ref></char></note><verse eid="ACT 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 7:29" />“ऐहा गल्‍ला शूणीं ठुर्हअ मोसा डरै तिधा का अर सह लागअ मिद्यान देशै परदेसी हई रहंदअ अर तिधी हुऐ तेऊए दूई शोहरू।<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 2:15-22">लुआ. 2:15-22</ref>; <ref loc="EXO 18:3-4">18:3-4</ref></char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“ज़ांऊं पूरी च़ाल़्ही साला बिति, मोसा भाल़अ एक स्वर्ग दूत अर परमेशरै किई तेऊ स्वर्ग दूता बाती मोसा संघा सीनाई धारा नेल़ रेगीस्तानै एकी ज़ल़दै झ़ाकल़ा का गल्‍ला।<note caller="-" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="EXO 3:1">लुआ. 3:1</ref></char></note> <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />मोसा हुअ एता तेऊ ज़ल़दै झ़ाकल़ा भाल़ी रहैन, ज़ांऊं सह तेता नेल़ डेऊअ, परमेशरै किई तेऊ संघै एही गल्‍ला,<note caller="-" style="x"><char style="xo" closed="false">7:31 </char><char style="xt" closed="false"><ref loc="EXO 3:2-3">लुआ. 3:2-3</ref></char></note><verse eid="ACT 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 7:32" />“‘हुंह आसा सह परमेशर ज़हा तेरै दाद-बाब आबराम, इसहाक अर याकब मना तै।’ मोसा का छ़ुटी काम्मणीं अर इधी तैणीं कि तेऊ निं तेऊ भाल़णें हिम्मत रही।<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“तेखअ बोलअ प्रभू तेऊ लै, ‘आपणैं खूरा का खोल्ह इना पोलल़ै पोर्ही किल्हैकि ज़हा ज़ैगा तूह खल़्हुअ द आसा, सह ज़ैगा आसा पबित्र।<note caller="-" style="x"><char style="xo" closed="false">7:33 </char><char style="xt" closed="false"><ref loc="EXO 3:5">लुआ. 3:5</ref></char></note> <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मंऐं हेरी आपणैं लोगे बूरी दशा मिसर देशै भाल़ी अर तिन्‍नें धका अर लेरनअ हेरअ मंऐं शूणीं। तैही आसा हुंह तिन्‍नां बच़ाऊंदअ होथअ द, ऐबै एछ तूह, मुंह छ़ाडणअ तूह मिसर देशा लै।’<note caller="-" style="x"><char style="xo" closed="false">7:34 </char><char style="xt" closed="false"><ref loc="EXO 2:24">लुआ. 2:24</ref>; <ref loc="EXO 3:7-10">3:7-10</ref></char></note><verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“ज़हा मोसा गूरो तिन्‍नैं इहअ बोली बरोध किअ, ‘तूह कुंणी बणाअं म्हारअ पांच़?’ सह ई बणाअं परमेशरे तिन्‍नां लै छ़ड़ैऊंणैं आल़अ सैणअ, अर स्वर्ग दूता बाती ज़हा झ़ाकल़ा दी तेऊ परमेशरे दर्शण हुऐ सह छ़ाडअ परमेशरै तिन्‍नां गलामी का छ़ड़ैऊंणा लै।<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">लुआ. 2:14</ref>; <ref loc="EXO 3:2">3:2</ref></char></note><verse eid="ACT 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 7:36" />“एऊ ई मणछै किऐ मिसर अर लाल समुंदर रेगीस्तानै च़ाल़्ही साला तैणीं नुआहरै काम अर नछ़ैण रहैऊई करै किऐ तिंयां मिसर देशे गलामी का आज़ाद।<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:3">लुआ. 7:3</ref>; <ref loc="EXO 14:21">14:21</ref>; <ref loc="NUM 14:33">गण. 14:33</ref></char></note><verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />“अह आसा सह ई परमेशरो गूर मोसा ज़ुंणी इज़राईली लै बोलअ, ‘परमेशर बिधाता काढणअ थारै भाई-बंधा मांझ़ा का तम्हां लै मुंह ज़िहअ एक गूर।’<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">बधा. 18:15-18</ref></char></note><verse eid="ACT 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 7:38" />“अह आसा सह ई ज़ुंणी रेगीस्तानै टोली मांझ़ै तेऊ स्वर्ग दूता संघै सीनाई धारा तेऊ का गल्‍ला किई अर म्हारै दादा-बाबा संघै थिअ। तेऊ ई भेटै ज़िऊंदै बैण कि हाम्हां सेटा लै पजैल़े।<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-6">लुआ. 19:1-6</ref>; <ref loc="EXO 20:1-17">20:1-17</ref>; <ref loc="DEU 9:10-11">बधा. 9:10-11</ref></char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“पर म्हारै दादै-बाबै निं तेऊए गल्‍ला मनणी च़ाही, पर तेता का उंबल़ै च़ाहा तै तिंयां मिसर देशा लै फिरी डेऊणअ।<note caller="-" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="EXO 23:20">लुआ. 23:20</ref>,<ref loc="EXO 23:21">21</ref>; <ref loc="NUM 14:3">गण. 14:3</ref>,<ref loc="NUM 14:4">4</ref></char></note><verse eid="ACT 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 7:40" />“तिन्‍नैं बोलअ मोसा गूरे भाई हारणा लै, ‘हाम्हां लै सैग इहअ देअ ज़ुंण हाम्हां आजू-आजू हांढी मिसर देशा लै बापस निंए। किल्हैकि अह मोसा ज़ुंणी हाम्हैं मिसर देशा का छ़ड़ैऊई आणै, कुंण ज़ाणें कि उझै धारा प्रैंदै तेऊ लै किज़ै हुअ होए!’<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">लुआ. 32:1</ref>,<ref loc="EXO 32:23">23</ref></char></note><verse eid="ACT 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 7:41" />“तधू बणाअं तिन्‍नैं एक सुन्‍नेंओ बाछ़ू अर तेऊए मुहुर्ती सम्हनै किअ बल़ीदान अर आपणैं तेऊ हाथे कामां लै दैनी तिन्‍नैं जाचा।<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:4">लुआ. 32:4</ref>,<ref loc="EXO 32:6">6</ref></char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />तैही फरेऊई परमेशरै तिन्‍नां बाखा पिठ अर तिन्‍नां दैनअ कज़ेही करनै कि तिंयां लागै सरगे ग्रहे पूज़ा करदै। ज़िहअ परमेशरे गूरै कताबा दी आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="JER 7:18">जेर. 7:18</ref>; <ref loc="JER 8:2">8:2</ref>; <ref loc="JER 19:13">19:13</ref></char></note></para>
  <para style="q" vid="ACT 7:42">‘इज़राईलीओ, थारै दाद-बाब नढैऊऐ मंऐं च़ाल़्ही साला उज़र रेगीस्तानै,</para>
  <para style="q" vid="ACT 7:42">तिन्‍नां तेतरी साला निं मंऐं तिन्‍नां का पशू बल़ी अर नाज़ बल़ी मांगी!<verse eid="ACT 7:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="ACT 7:43" />तम्हैं इज़राईली मणछै बुल़्ही आप्पू संघै मोलक देअए बेदी, थारै तारै रफान देअए मुहुर्ती</para>
  <para style="q" vid="ACT 7:43">अर तिंयां मुहुर्ती ज़ुंण तम्हैं आप्पू लै पूज़ा करना लै बणाईं ती।’</para>
  <para style="p" vid="ACT 7:43">“‘तैही, छ़ाडणैं मुंह तम्हैं गलामी दी बाबेल देशा का बी दूर।’<note caller="-" style="x"><char style="xo" closed="false">7:43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-26">आम. 5:25-26</ref></char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“ज़धू म्हारै दाद-बाब रेगीस्तानै थिऐ, तिन्‍नैं किई परमेशरे च़ाकरी तेऊ खिम्भा दी ज़िधी परमेशर एछा त। सह रहैऊआ त ऐहा गल्‍ला कि परमेशर आसा तिन्‍नां संघै। तिन्‍नैं बणाअं सह खिम्भ ठीक तिहअ ज़िहअ परमेशरै आपणैं गूर मोसा लै खोज़अ त। अह खिम्भ त ठीक तेऊ ई साबै बणाअं द ज़ुंण परमेशरै मोसा का धारा प्रैंदै रहैऊअ त।<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:1-40">लुआ. 25:1-40</ref>; <ref loc="EXO 27:21">27:21</ref>; <ref loc="NUM 1:50">गण. 1:50</ref></char></note><verse eid="ACT 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="ACT 7:45" />“सह ई खिम्भ आणअ म्हारै दादै-बाबै पराणैं ज़मानैं ज़ैहसू संघै इधा लै बी, ज़ेथ तिन्‍नैं तेऊ ज़मानैं होरी ज़ाती दी कबज़अ किअ त, ज़ुंण लोग परमेशरै म्हारै दादा-बाबे सेटा का दूर किऐ, अर सह रहअ राज़ै दाबेदे ज़मानैं तैणीं।<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">ज़ैह. 3:14-17</ref>; <ref loc="JOS 18:1">18:1</ref>; <ref loc="JOS 23:9">23:9</ref>; <ref loc="JOS 24:18">24:18</ref></char></note><verse eid="ACT 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 7:46" />“तेऊ लै किई परमेशरै क्रिप्पा; तैही किई तेऊ अरज़ कि मुंह बणाणअं याकबे परमेशरा लै भबन।<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:2-16">2 शमू. 7:2-16</ref>; <ref loc="1KI 8:17-18">1 राज़. 8:17-18</ref>; <ref loc="1CH 17:1-14">1 इति. 17:1-14</ref>; <ref loc="2CH 6:7-8">2 इति. 6:7-8</ref>; <ref loc="PSA 132:5">भज. 132:5</ref></char></note><verse eid="ACT 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 7:47" />“पर सुलैमानै बणाअं परमेशरा लै भबन।<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1">1 राज़. 6:1</ref>,<ref loc="1KI 6:2">2</ref>,<ref loc="1KI 6:14">14</ref>; <ref loc="1KI 8:19-20">8:19-20</ref>; <ref loc="2CH 3:1">2 इति. 3:1</ref>; <ref loc="2CH 5:1">5:1</ref>; <ref loc="2CH 6:2">6:2</ref>,<ref loc="2CH 6:10">10</ref></char></note><verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“पर परम प्रधान परमेशरै निं हाथा करै बणाऐं दै भबनै रहंदअ, ज़िहअ कि परमेशरे गूरै ईशायाह आसा बोलअ द,<verse eid="ACT 7:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="ACT 7:49" />‘प्रभू बोला इहअ, “स्वर्ग आसा मेरी राज़गाद्दी अर</para>
  <para style="q" vid="ACT 7:49">पृथूई आसा मेरै पैरा हेठे च़ौकी!</para>
  <para style="q" vid="ACT 7:49">तम्हैं मुल्है किहअ घअर सका बणाईं?</para>
  <para style="q" vid="ACT 7:49">सह कुंण ज़ैगा हणीं ज़िधी हुंह बस्सणअ?”’<verse eid="ACT 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 7:50" />“‘ईंयां सोभै गल्‍ला कै मंऐं आपणैं हाथै आप्पै निं आथी बणाईं दी?’<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">ईशा. 66:1-2</ref></char></note><verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“हे हठू अर काना-मन्‍नें टौणैं लोगो, तम्हैं करा सदा पबित्र आत्मों बरोध। ज़िहअ थारै दाद-बाब करा तै, तम्हैं बी करा तिहअ ई।<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="EXO 32:9">लुआ. 32:9</ref>; <ref loc="EXO 33:3-5">33:3-5</ref>; <ref loc="LEV 26:41">लेब. 26:41</ref>; <ref loc="NUM 27:14">गण. 27:14</ref>; <ref loc="ISA 63:10">ईशा. 63:10</ref>; <ref loc="JER 6:10">जेर. 6:10</ref>; <ref loc="JER 9:26">9:26</ref></char></note><verse eid="ACT 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="ACT 7:52" />“परमेशरे गूरा मांझ़ै कहा ज़ण्हैं लै निं थारै दादै-बाबै कष्ट दैनअ? तिन्‍नैं पाऐ पराणैं ज़मानैं ओर्ही तेऊ धर्मीं मणछ मसीहा एछणें समादा दैणैं आल़ै मारी अर ऐबै हुऐ तम्हैं बी तेऊ मसीहा ढाकणैं आल़ै अर मारनै आल़ै।<note caller="-" style="x"><char style="xo" closed="false">7:52 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 इति. 36:16</ref></char></note> <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तम्हैं आसा तिंयां ज़हा लै स्वर्ग दूतै बधान सभाल़अ, पर तेऊ साबै निं तम्हैं च़लै आथी।”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनुस पात्थरा करै मारनअ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />ज़ांऊं यहूदी मणछै अर तिन्‍नैं होरी स्तिफनुसे ईंयां गल्‍ला शूणीं तिन्‍नां आई बेघै खास्सी रोश्शै। तिंयां सोभै लागै रोश्शै तेऊ लै दांदा किल्‍लदै!<note caller="-" style="x"><char style="xo" closed="false">7:54 </char><char style="xt" closed="false"><ref loc="JOB 16:9">आयू. 16:9</ref>; <ref loc="PSA 35:16">भज. 35:16</ref>; <ref loc="PSA 37:12">37:12</ref>; <ref loc="PSA 112:10">112:10</ref></char></note><verse eid="ACT 7:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="ACT 7:55" />पर तेऊ भाल़अ पबित्र आत्मां करै भर्हुई स्वर्गा बाखा अर तेऊ का शुझुई परमेशरा का झ़ामण लागअ द अर प्रभू ईशू शुझुअ तेऊ का परमेशरे दैहणीं बाखा सोभी का बडी पदबी दी। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />तेऊ बोलअ, “भाल़ा, मुखा शुझिआ स्वर्ग घुआल़ी अर मणछो शोहरू ईशू परमेशरे दैहणीं बाखा सोभी का बडी पदबी दी।”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />तेखअ किऐ तिन्‍नैं ज़ोरै-ज़ोरै लैल़ा पाई आपणैं कान बंद अर रोश्शै पल़ै तिंयां सोभ तेऊ च़िक्‍कदै चुटी। <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />तिन्‍नैं काढअ सह एरुशलेम नगरी का बागै अर तेऊ लै लागै सोभ पात्थरै बाहंदै अर तिन्‍नैं शाजत डाहै आपणैं च़ोल़ै शाऊल नाओंऐं एकी मर्धे खूरा सेटा खोल्ही।<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />तिंयां सोभ रहै स्तिफनुसा लै पात्थरै बाहंदै लागी अर सह रहअ इहअ बोली प्राथणां करदअ लागी, “हे प्रभू ईशू, मेरी आत्मां ढाक आप्पू का।”<note caller="-" style="x"><char style="xo" closed="false">7:59 </char><char style="xt" closed="false"><ref loc="PSA 31:5">भज. 31:5</ref></char></note><verse eid="ACT 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="ACT 7:60" />तेखअ बोलअ तेऊ ज़ान्हूं टेक्‍की करै ज़ोरै, “हे प्रभू, एऊ पाप करनैओ दोश निं इना लोल़ी लागअ” अर इहअ बोली शोटै तेऊ प्राण।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाऊल नाओं मणछ बी त इना आपणीं आछी भाल़णैं आल़अ अर सह बी थिअ स्तिफनुस मारना लै राज्ज़ी।</para>
  <para style="s" vid="ACT 8:1">विश्वासीए टोली संघै उपद्रभ</para>
  <para style="p" vid="ACT 8:1">तैहा ई धैल़ी हुअ एरुशलेम नगरीए विश्वासीए टोली लै बडअ खास्सअ उपद्रभ अर शधाणूं छ़ाडी होर कई विश्वासी छिंघुऐ यहूदा अर सामरी मुल्खा लै। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />कई परमेशरे भगत मणछै डाहअ स्तिफनुस घोरी दी दाबी अर तेऊ लै लागै लेरदै-पकारदै। <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />शाऊल त विश्वासीए टोली बरैबाद करदअ लागअ द। सह थिअ लागअ द घअरै-घअरै पेशी करै विश्वासी मर्धा अर बेटल़ी घिशी-तल़िंगी करै कैद खानै पांदअ।<verse eid="ACT 8:3" /></para>
  <para style="s">सामरी मुल्खै फलिप्पो प्रच़ार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />ज़ुंण विश्वासी ओर्ही-पोर्ही छिंघुऐ, तिंयां डेऊऐ हर ज़ैगा खुशीए समादा खोज़दी। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />फलिप्प बी लागअ सामरी मुल्खै डेऊई सोभी लोगा मांझ़ै मसीहे बारै लोगा का खोज़दअ। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />ज़ुंण गल्‍ला फलिप्पै बोली अर ज़ुंण सह नछ़ैण सह रहैऊआ त तेता भाल़ी लागै सोभ लोग तेऊए गल्‍ला धैन-मन्‍न लाई शूणैं। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />किल्हैकि फलिप्प दैआ त हुकम अर कई का निखल़अ भूत लैल़ा-पकारा पाई बागा लै अर खास्सै दरंगे बमारी आल़ै, अर लाट्टै हुऐ नरोगै। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />तैहा नगरीए लोग हुऐ खास्सै खुश।<verse eid="ACT 8:8" /></para>
  <para style="s">शमौन ज़ादू करनै आल़अ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />तैहा नगरी त शमौन नाओं मणछ, सह करा त ज़ादू करी सामरी मुल्खै होरी ज़ातीए लोगा रहैन अर आप्पू लै खोज़ा त सह लोगा का कि सह आसा आप्पू एक महान मणछ। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />कई होछ़ै का बडै तैणीं तेऊ मनी बोला तै इहअ कि अह मणछ आसा परमेशरे एक शगती, ज़हा लै महान बोला। <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />तेऊ तै तिंयां खास्सै धैल़ै ओर्ही आपणैं ज़ादू करै डाहै दै रहैन करी। तैही मना तै तेऊ तिंयां खास्सै।<verse eid="ACT 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 8:12" />पर ज़ांऊं तिन्‍नैं फलिप्पे गल्‍ला दी विश्वास किअ ज़ुंण परमेशरे राज़ अर मसीहा ईशूए नाओं खुशीओ समाद खोज़ा त, सोभ लोग, कै मर्ध, कै बेटल़ी लागै पापो प्राश्त करी पाप माफी लै डुबकी लंदै। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />तेखअ शमौनै आप्पू बी विश्वास किअ अर डुबकी लई करै लागअ फलिप्पा संघै रहंदअ अर सह हआ त नछ़ैण अर बडै-बडै शगतीए कामां अर च़मत्कारा भाल़ी रहैन।<verse eid="ACT 8:13" /></para>
  <para style="s">सामरी मुल्खै पतरास अर जोहन्‍ना</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />ज़ुंण शधाणूं एरुशलेम नगरी तै आऐ दै तिन्‍नैं ज़ांऊं शूणअ कि सामरी मुल्खै हेरअ परमेशरो बैण मनी, तेखअ छ़ाडै तिन्‍नैं पतरास अर जोहन्‍ना तिन्‍नां सेटा लै। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />तिन्‍नैं किई तिधी पुजी तिन्‍नां लै प्राथणां कि पबित्र आत्मां करे भर्हिए। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />किल्हैकि पबित्र आत्मां निं अज़ी बी तिन्‍नां कोही दी आअ त, तिन्‍नैं ती अज़ी तैणीं सिधी प्रभू ईशू नाओंए डुबकी लई दी। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तेखअ डाहै तिन्‍नैं तिन्‍नां प्रैंदै हाथ अर तिन्‍नां दी आई पबित्र आत्मां।<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />ज़ांऊं शमौनै भाल़अ कि शधाणूंए हाथा लाणैं करै एछा पबित्र आत्मां, तेऊ तिन्‍नां सेटा ढब्बै आणी बोलअ, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ऐहा शगती दैआ तम्हैं मुल्है बी ताकि ज़हा प्रैंदै हुंह हाथ डाहूं, तेऊ लोल़ी पबित्र आत्मां भेटी।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />पतरासै बोलअ तेऊ लै इहअ, “तेरै ढब्बै लोल़ी ताह संघै बरैबाद हुऐ किल्हैकि तंऐं किअ परमेशरो दान ढब्बै करै मोल लणेंओ बच़ार! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />ऐहा च़ाकरी दी निं तेरअ हेस्सअ आथी अर नां किज़ै बांड, किल्हैकि तेरै मन्‍नैं निं परमेशरा सम्हनै सुंबल़ी सोर आथी।<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PSA 78:37">भज. 78:37</ref></char></note> <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />आपणैं पापो प्राश्त करा, अर बूरी गल्‍ला सोठणें पाआ छ़ाड़। प्रभू का कर प्राथणां ताकि सह तम्हां माफ करे। झ़ाणीं सह थारी बूरी सोठा लै तम्हां माफ करी हेरे। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />बूराईए बाता का हआ दूर, थारै मन्‍नैं आसा हाम्हां लै कल़बिश भरी दी। तम्हैं आसा सदा बूरै करदै रहणैं आल़ी सोठे बशै हुऐ दै! तम्हैं निं परमेशरे सज़ा का बच़ी सकदै।”<note caller="-" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="DEU 29:18">बधा. 29:18</ref>; <ref loc="LAM 3:15">लाम. 3:15</ref></char></note><verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />शमौनै दैनअ ज़बाब, “तम्हैं करा मुल्है प्रभू का प्राथणां कि ज़ुंण गल्‍ला तम्हैं बोली, तिन्‍नां मांझ़ै निं कोहै लोल़ी मुल्है हुई-बिति।”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />तेखअ फिरै तिंयां शाजत दैई अर प्रभू ईशूओ बैण खोज़ी एरुशलेम नगरी लै बापस। तिंयां डेऊऐ सामरी मुल्खे कई गराऊंआं बाती खुशीए समादा खोज़दी-खोज़दी।<verse eid="ACT 8:25" /></para>
  <para style="s">फलिप्प अर कूश देशो अफसर</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />तेखअ प्रभूए एकी स्वर्ग दूतै फलिप्पा लै बोलअ, “उझ़ू, अर दखणा बाखा लै तैहा बाता डेऊ ज़ुंण एरुशलेम नगरी का गाज़ा नगरी लै डेओआ, अह आसा उज़र कराहणीं बात।” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />फलिप्प उझ़ुअ अर डेऊअ, अर हेरा, कूश देशो एछदअ लागअ द, सह थिअ दपुर्षअ अर कूश देशे राणीं कंदाकेओ भढारी त सह थिअ परमेशरे च़ाकरी करदअ एरुशलेम नगरी लै आअ द। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />सह थिअ आपणैं रथा दी बेठअ द, अर परमेशरे गूर ईशायाहे कताबा पहल़दी त सह लागअ द आपणैं घअरा लै बापस डेऊंदअ।<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />तेखअ बोलअ पबित्र आत्मां फलिप्पा का, एऊ नेल़ डेऊ अर एऊए रथा संघा-संघा हांढ।<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />फलिप्पै पुजअ ठुर्ही तेऊए रथा सेटा अर सह मणछ शूणअ तेऊ परमेशरे गूर ईशायाहे कताबा पहल़दअ। फलिप्पै पुछ़अ तेऊ का, “तूह ज़ुंण पहल़ा, तेता तूह समझ़ा बी कि नांईं?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />तेऊ दैनअ ज़बाब, “ज़ेभै तैणीं मुंह कुंण नांईं समझ़ाऊए, तेभै तैणीं किधी च़ाल्‍लअ हुंह समझ़ी?” तेखअ किई तेऊ फलिप्पा का अरज़ कि मुंह संघै बेश मेरै रथा दी। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />पबित्र शास्त्रो ज़ुंण पाठ सह पहल़दअ त लागअ द सह थिअ अह,</para>
  <para style="q" vid="ACT 8:32">“सह रहअ इहै मिम्मूं ज़िहअ ज़ुंण डिलणा लै हआ काटी लाअ द</para>
  <para style="q" vid="ACT 8:32">अर एही भेडा ज़िहअ ज़ुंण मुनी हआ लाई दी,</para>
  <para style="q" vid="ACT 8:32">तेऊ निं एक बैण बी बोलअ।<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />सह किअ कैद संघा दैनी थोघै बाझ़ी तेऊ लै मौते सज़ा!</para>
  <para style="q" vid="ACT 8:33">तेऊ ज़मानै निं कोही तेऊए दशा दी धैन दैनअ</para>
  <para style="q" vid="ACT 8:33">म्हारै पापा पिछ़ू किई पृथूई का तेऊए ज़िन्दगी दूर!”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ज़ुंण दपुर्षअ अर कूश देशे राणीं कंदाकेओ भढारी त, तेऊ बोलअ फलिप्पा का एता लै इहअ, “ताह सेटा आसा मेरी एही अरज़ कि मुखा खोज़ इहअ कि अह परमेशरो गूर कसरै बारै बोला, आपणैं बारै, या कहा होरीए बारै?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तेखअ लागअ फलिप्प तेऊ का खोज़दअ, संघा खोज़अ एऊ ई पबित्र शास्त्रा का शुरू करी तेऊ का प्रभू ईशू मसीहो खुशीओ समाद।<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />बाता हांढदी-हांढदी पुजै तिंयां एही ज़ैगा ज़िधी पाणीं त। तेखअ बोलअ तेऊ दपुर्षै, “भाल़, इधी आसा पाणीं बी, ऐबै मुल्है डुबकी लणा लै कै अल़च़न आसा?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फलिप्पै बोलअ तेऊ लै, “ज़ै तूह सारै मना का विश्वास करा, तै सका हई। तेऊ दैनअ ज़बाब कि हुंह करा ऐहा गल्‍लो विश्वास कि मसीहा आसा परमेशरो पूत।” <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />तेखअ किअ तेऊ रथा खल़ै करनैओ हुकम अर फलिप्प अर सह दपुर्षअ होथै दुहै पाणीं दी अर तेखअ दैनी फलिप्पै तेऊ लै पाणीं दी डुबकी।<verse eid="ACT 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 8:39" />ज़ांऊं तिंयां पाणीं का उझै निखल़ै, प्रभूए आत्मां च़कअ फलिप्प उझै अर तेऊ दपुर्षै निं सह तेखअ भिई भाल़ी, अर सह डेऊअ नंद खुशी दी आपणीं बाता।<note caller="-" style="x"><char style="xo" closed="false">8:39 </char><char style="xt" closed="false"><ref loc="1KI 18:12">1 राज़. 18:12</ref></char></note><verse eid="ACT 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 8:40" />फलिप्प निखल़अ अशदोद नगरी का अर ज़ेभै तैणीं कैसरिया निं पुजअ तेभै तैणीं रहअ सह बाता हांढदी हर नगरी अर गराऊंऐं खुशीए समादा खोज़दअ लागी।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाऊलो दिल बदल़णअ</para>
  <para style="r">(<ref loc="ACT 22:6-16">शधाणूं 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल ज़ुंण नर्दैई हई प्रभू ईशू दी विश्वास करनै आल़ै च़ेल्‍लै मारा त, सह डेऊअ माहा प्रोहता सेटा लै, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />तेऊ अर तेऊए साथी मांगी दमिश्क नगरी सभागृहे नाओंऐं एऊ कामां करने हक भेटणें च़िठी कि कै मर्ध, कै बेटल़ी, ज़ुंण बी ईशू मनणै आल़अ होए, तिंयां आणनैं कैद करी एरुशलेम नगरी लै।<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />पर हांढदी-हांढदी ज़ांऊं सह दमिश्क नगरी नेल़ पुजअ, हेरा-हेरी च़मकी सरगा का बिज़ल़ी तेऊ फेर। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />सह बधल़ुअ धरनीं अर तेऊ शूणअ इहअ बैण, <char style="wj">“हे शाऊल, ए शाऊल, तूह किल्है आसा मुंह दुखी करदअ लागअ द?”</char><verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />शाऊलै पुछ़अ, “हे प्रभू, तूह कुंण आसा?”</para>
  <para style="p" vid="ACT 9:5">तेऊ दैनअ मुल्है ज़बाब, <char style="wj">“हुंह आसा ईशू नासरी ज़हा तूह दुखी करदअ आसा लागअ द।</char> <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" /><char style="wj">पर ऐबै उझ़ू तूह खल़अ संघा डेऊ नगरी लै अर ज़ुंण ताह आजू करनअ, सह हेरनअ ताखा खोज़ी।”</char><verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />ज़ुंण शाऊले तिंयां होरी साथी तै तिन्‍नैं निं किछ़ै बोलअ। किल्हैकि तिंयां बोल, शूणैं पर तिधी निं तिन्‍नां का कोहै शुझुअ! <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तेखअ उझ़ुअ शाऊल धरनीं माट्टै जैंदरा का खल़अ। पर ज़ांऊं आछी घुआल़ी, तेऊ का निं किछ़ै शुझुअ। तेखअ निंयं तिन्‍नें होरी सह हाथा ढाकी करै दमिश्क नगरी लै। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />तेखअ रहअ सह चिई धैल़ै तैणीं कांणअ, अर तेऊ निं तेतरै धैल़ै किछ़ खाअ-पिअ।<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमिश्क नगरी थिअ एक हनन्याह नाओं परमेशरे डरा हेठै रहणैं आल़अ च़ेल्‍लअ। प्रभू ईशू बोलअ तेऊ लै, दर्शण दैई करै, <char style="wj">“हनन्याह!”</char></para>
  <para style="p" vid="ACT 9:10">तेऊ दैनअ ज़बाब, “हाँ प्रभू हुंह आसा शूणअ लागअ द।”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />तेखअ बोलअ प्रभू तेऊ लै, <char style="wj">“उझ़ू, अर तैहा बाता डेऊ, ज़हा लै आज़री बात बोला, अर यहूदा नाओंए मणछे घअरै आसा शाऊल नाओं एक तरसुस नगरीओ मणछ। पुछ़ी लऐ, किल्हैकि भाल़ सह आसा लागअ द प्राथणां करदअ।</char> <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" /><char style="wj">मंऐं रहैऊअ तेऊ का दर्शणा दी हनन्याह नाओं एक मर्ध भितरा लै एछदअ अर तेऊ प्रैंदै हाथा डाहंदअ ताकि तेऊए आछी का भिई शुझदअ लागे।”</char><verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्याह दैनअ ज़बाब, “हे प्रभू, मंऐं आसा एऊ मणछे बारै कई लोगा का शूणअ द कि एऊ आसा एरुशलेम नगरी तेरै पबित्र लोगा संघै बडअ उपद्रभ किअ द। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />इधी बी आसा एऊ लै बडै प्रोहता का हक भेटअ द कि ज़ुंण लोग तेरअ नाअं लए, तिन्‍नां बी सह कैद करी एरुशलेम नगरी लै निंए।” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />पर प्रभू बोलअ तेऊ लै, <char style="wj">“तूह डेऊ, किल्हैकि अह आसा मंऐं होरी ज़ाती लै राज़ै, माहा राज़ै अर इज़राईली सम्हनै मेरै नाओंआं प्रगट करना लै मेरअ छ़ांटअ द भांडअ।</char> <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" /><char style="wj">मुंह खोज़णअ तेऊ का कि मेरै नाओंआं लै ताह किहअ-किहअ दुख लागणअ भुगतणअ।”</char><verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />तेखअ डेऊअ हनन्याह तिधा का तेऊ घअरा लै संघा ज़िधी शाऊल त। तेखअ शाऊला दी हाथ डाही करै तेऊ लै बोलअ, “भाई शाऊल, प्रभू, मतलब ईशू ज़ुंण ताह तैहा बाता, ज़हा बाता तूह आअ, ताखा शुझुअ त, तेऊ ई छ़ाडअ हुंह कि ताखा लोल़ी भिई शुझदअ लागअ अर तूह लोल़ी पबित्र आत्मां करै भर्हुअ।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />तेऊए आछी का होथै तेभी ज़िहै तरोल़ै अर तेऊ का लागअ शुझदअ अर सह उझ़ुअ तेभी खल़अ अर पाप माफी लै पापो प्राश्त करने डुबकी। <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />तेखअ खाई तेऊ रोटी अर तेखअ आअ तेऊए देही बल।</para>
  <para style="s" vid="ACT 9:19">दमिश्क नगरी शाऊलो प्रच़ार</para>
  <para style="p" vid="ACT 9:19">सह रहअ कई धैल़ै तैणीं तिन्‍नां च़ेल्‍लै संघै ज़ुंण दमिश्क नगरी तै। <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />तेखअ लागअ शाऊल तेभी सभागृहा प्रभू ईशूए बारै खोज़दअ कि सह ई आसा परमेशरो पूत।<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />तिधी ज़ुंण पल़सीए गल्‍ला शूणैं तै लागै दै, तिंयां हुऐ रहैन संघा लागै इहअ बोल्दै, “अह सह ई मणछ निं आथी, ज़ुंण एरुशलेम नगरी ईशू दी विश्वास करनै आल़ै लै खास्सअ ज़ुल्म करा थिअ? ऐबै आअ अह इधी दमिश्क नगरी कि इधे ईशू दी विश्वास करनै आल़ै कैद करी एरुशलेम नगरी लै निंए! अह च़ाहा तिन्‍नां सैणैं अर प्रोहता सेटा पेश करनअ।”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />पर शाऊल लागअ होर बी खास्सअ ईशूए बारै खोज़दअ अर ऐहा गल्‍लो सबूत दैई-दैई बोल्दअ कि ईशू ई आसा मसीहा। ज़ुंण सबूत तेऊ मसीहे बारै दैनै, तेते बारै निं दमिश्क रहणैं आल़ै यहूदी तेऊ लै ज़बाब दैई सकै।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />ज़ांऊं खास्सै धैल़ै बितै, यहूदी किअ आप्पू मांझ़ै एक्‍कअ कि शाऊल पाणअ हाम्हां मारी। <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />तिन्‍नैं पाअ राची धैल़ी शाऊला मारना लै पहरअ पर शाऊला का गअ ऐहा गल्‍लो थोघ लागी। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />तेखअ होरी विश्वासी भाई थुआल़अ शाऊल राची एकी बडै च़ठै भितरी बशैल़ी नगरीए दुआली बाती छ़ड़ाऊई करै उंधै अर सह काढअ बागा लै।<verse eid="ACT 9:25" /></para>
  <para style="s">एरुशलेम नगरी शाऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />एरुशलेम नगरी पुजी किई च़ेल्‍लै सेटा मिलणें शाऊलै कोशिश, पर तिंयां सोभै डरा तै तेऊ का, किल्हैकि तिन्‍नां निं इहअ भरोस्सअ ई हंदअ त कि अह बी आसा ऐबै प्रभू ईशूओ च़ेल्‍लअ। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पर बरनबास नाओंए प्रभूए एकी च़ेल्‍लै निंयं सह आप्पू संघै शधाणूं सेटा लै अर तिन्‍नां का सोभै गल्‍ला खोज़ी कि किहअ करै शाऊलै बाता प्रभू ईशू मसीहा भाल़अ अर एऊ संघै किई गल्‍ला, अर तेखअ दमिश्क नगरी केही हिम्मता संघै किअ प्रभूओ प्रच़ार।<verse eid="ACT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 9:28" />तेखअ रहअ तिन्‍नां संघै एरुशलेम नगरी एछदअ-डेऊंदअ लागी। <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />शाऊलै किअ नधड़क हई किअ प्रभूए नाओं प्रच़ार, अर यूनानी बोली बोल़णैं आल़ै यहूदी संघै रहअ हठल़दअ लागी, पर तिन्‍नें ती हर बगत एही सोठ कि शाऊल पाणअ त किहअ करै मारी। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />इहअ थोघ लागी करै आणअ सह होरी भाई कैसरिया नगरी लै अर तिधा का छ़ाडअ सह तेऊए आपणीं घअर तरसुस नगरी लै।<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />इहअ करै हुई सारै यहूदा, गलील अर सामरी मुल्खै टोली दी शांती। विश्वासी रहा तै प्रभूए डरा हेठै। पबित्र आत्मों हैअ भेटी करै लागी विश्वासीए गणांई होर बी खास्सी हंदी।<verse eid="ACT 9:31" /></para>
  <para style="s">लुदा अर जोपा नगरी दी पतरास</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />तेखअ हुअ इहअ कि पतरास पुजअ कई ज़ैगा हांढदी-फिरदी तिन्‍नां पबित्र लोगा सेटा बी ज़ुंण लुदा नगरी रहा तै। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />तिधी भेटअ तेऊ अनिआस नाओं दरंगे बमारी आल़अ मणछ ज़ुंण आठा साला ओर्ही च़ैन्‍नै त पल़अ द। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पतरासै बोलअ तेऊ लै, अनिआस! ईशू मसीहा किअ तूह ऐबै ठीक, उझ़ू, आपणअ च़ैन च़क। तेखअ सह तेभी खल़अ उझ़ुअ। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />इहअ करै फिरै लुदा अर शारोने रहणैं आल़ै कई प्रभू बाखा लै।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />जोपा नगरी दी रहा ती तबिता नाओंए एक च़ेल्‍ली, सह करा ती कई भलै काम अर गरीबा लै दान। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />तिन्‍नां ई धैल़ै हुई सह बमार अर मूंईं। तिन्‍नैं विश्वासी बी डाही सह न्हैऊई धोई करै पांडा। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुदा नगरी ती जोपा नगरी नेल़ तिन्‍नैं विश्वासी भाई शूणअ इहअ कि पतरास आसा तिधी आअ द। तिन्‍नैं छ़ाडै दूई मणछ एही अरज़ करदै, “ज़ेतरअ छ़ेक्‍कै हई सका, एभी एछै हाम्हां सेटा लै।”<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />तेखअ डेऊअ पतरास तिन्‍नां संघै अर ज़ांऊं तिधी पुजअ अर तिन्‍नैं निंयं सह पांडा लै अर सोभ बिधबा बेटल़ी ती लेरदी लागी दी अर तिंयां खल़्हुई पतरासा सेटा अर ज़ुंण झिकल़ै तैहा तिन्‍नां संघै रहंदी बणाऐं तै तिन्‍नां रहैऊंदी लागी। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />तेखअ काढै पतरासै तिंयां सोभ बागा लै अर ज़ान्हूं दी बेशी किई प्राथणां अर ल्हासा बाखा भाल़ी बोलअ, “हे तबिता, उझ़ू।” तैहा घुआल़ी आछी अर पतरासा भाल़ी उझ़ुई खल़ी। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />पतरासै झ़ैऊई सह हाथ ढाकी करै खल़ी अर तिंयां पबित्र लोग अर बिधबा शादी करै रहैऊई सह तिन्‍नां का ज़िऊंदी होश-बाशा दी।<verse eid="ACT 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42" />अह गल्‍ल पुजी सारी जोपा नगरी अर कई लोगै किअ प्रभू ईशू दी विश्वास। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />पतरास रहअ जोपा नगरी कहा शमौन नाओंऐं च़ाम्भल़े बपारा करनै आल़ै सेटा कई धैल़ै तैणीं।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">कुरनेलिस पतरासा सेटा लै शधाणूं छ़ाडणैं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरिया नगरी त कुरनेलिस नाओं एक मणछ, सह थिअ इतालिनी नाओंऐं सैने दलो सुबैदार। <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />सह थिअ धर्मीं मणछ अर आपणैं सारै घरानै संघी रहा त सह परमेशरे डरा हेठै, अर गरीब यहूदी मणछा लै दैआ त सह खास्सअ दान अर हर बगत करा त सह परमेशरा सेटा प्राथणां। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />धैल़ीए चिऊथै पहरा नेल़ भाल़अ तेऊ दर्शण कि परमेशरो एक स्वर्ग दूत आअ तेऊ सेटा भितरा लै अर तेऊ बोलअ, “हे कुरनेलिस।”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />तेऊ भाल़अ बडै धैन लाई करै अर हैल़ुई करै बोलअ, “हे प्रभू, किज़ै बोला?”</para>
  <para style="p" vid="ACT 10:4">स्वर्ग दूतै बोलअ, “तेरी प्राथणां अर तेरै दान पुजै परमेशरा सेटा, <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />अर जोपा नगरी लै छ़ाड मणछ शमौना शधाणूं ज़हा लै पतरास बोला। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />सह आसा, शमौन च़ाम्भल़े बपारा करनै आल़ै सेटा प्राहुंणअ ज़सरअ घअर समुंदरे बाढै आसा।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />ज़ांऊं सह स्वर्ग दूत ज़ुंणी तेऊ संघै गल्‍ला किई ती, सह डेऊअ, तेऊ दूई दास ज़ुंण तेऊ सेटा रहा तै तिन्‍नां मांझ़ै शादअ एक भगत सपाही आप्पू सेटा लै। <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />तिन्‍नां का सोभै गल्‍ला खोज़ी करै छ़ाडै तिंयां जोपा नगरी लै।<verse eid="ACT 10:8" /></para>
  <para style="s">पतरासो दर्शण</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />दुजी धैल़ी ज़ांऊं तिंयां हांढदी-हांढदी जोपा नगरी नेल़ पुजै, दपहरा नेल़ त पतरास प्रैंधल़ी मज़ला प्राथणां करदअ बेठअ द। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />पतरासा ती भुखै बी आई दी अर सह च़ाहा त रोटी खाणअ। पर ज़ांऊं तिंयां रोटी बणाऊंदै तै लागै दै, पतरासा निं सुध-बुध ई रही। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />तेऊ का शुझुअ कि सरग आसा घुआल़ी, अर एक बडी च़ादरा ज़िहअ बडअ तराणअ आसा च़ऊ कुंणी का राशै करै बान्हअ द। सह च़ुंढुअ सरगा बाती पृथूई बाखा लै। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />तेऊ तराणैं दी आसा संसारे सोभी रंगे च़ऊ ज़ांघा हांढदै, रिंगणै आल़ै सोभै ज़ीब अर सरगे च़ेल्‍लू-पखीरू। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />पतरासै शूणअ ज़ोरै एक बोल, “हे पतरास, उझ़ू इना मार अर खा।”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />पर पतरासै बोलअ, “प्रभू, हुंह निं छ़ोत लाणैं आल़ी च़िज़ा कधि खाई सकदअ, किल्हैकि ज़ुंण च़िज़ा शुची निं आथी तिंयां निं मंऐं आझ़ तैणीं कधि खाई।”<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="LEV 11:1-47">लेब. 11:1-47</ref>; <ref loc="EZK 4:14">एज. 4:14</ref></char></note><verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />तेखअ शूणअ तेऊ दुजी बारी परमेशरो इहअ बोल, “हुंह आसा परमेशर ज़ुंण मणछ मंऐं शुचै आसा किऐ दै, तिन्‍नां लै निं तूह छ़ोतलै बोलै।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />चिई बारी हुअ इहअ ई, तेखअ च़कअ सह बडअ तराणअ तेभी उझै सरगा लै।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />पतरास त आपणैं मन्‍नैं दबिधा दी कि ज़ुंण अह दर्शण मंऐं भाल़अ, एतो कै मतलब आसा? हेरा, तिधी आऐ तिंयां मणछ ज़ुंण कैसरिया नगरी का कुरनेलिस तै मुंह सेटा लै छ़ाडै दै, तिन्‍नैं शमौने घअरो थोघ पुछ़ी करै पुजै तिंयां तिधी दुआरे डेहल़ा बागै। <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />तिन्‍नैं लाई बागा का हाक्‍का कि शमौन, ज़हा लै पतरास बोला, सह इधी आसा प्राहुंणअ?<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />पतरास त लागअ द तेऊ दर्शणें बारै सोठदअ ई कि पबित्र आत्मां बोलअ तेऊ लै, “भाल़ चअन मणछ आसा ताह लोल़ै लागै दै।<verse eid="ACT 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 10:20" />“उझ़ू अर उंधै डेऊ तिंयां आसा ता होरी ज़ातीए, पर ऐहा गल्‍लो फिकर निं तूह करी, च़ुप्प-च़ुप्पै लाग तिन्‍नां पिछ़ू हांढदअ किल्हैकि तिंयां आसा मंऐं छ़ाडै दै।”<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />तेखअ आअ पतरास तिन्‍नां सेटा लै अर तिन्‍नां मणछा का पुछ़अ, “ज़हा लोल़ै तम्हैं आसा लागै दै, सह आसा हुंह ई। तम्हैं किज़ू कामैं आसा आऐ दै?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />तिन्‍नैं बोलअ, “हाम्हैं आसा छ़ाडै दै कुरनेलिस सुबैदारै, सह आसा धर्मीं अर परमेशरे डरा हेठै रहणैं आल़अ अर सारी यहूदी ज़ाती दी आसा तेऊओ थोघ कि सह किहअ भलअ मणछ आसा। तेऊ लै बोलअ एकी पबित्र स्वर्ग दूतै, ‘पतरासा शाद आपणैं घअरा लै अर तेऊ का शुण बैण।’” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तेखअ शादै पतरासै तिंयां घअरा भितरा लै संघा बोलअ तिन्‍नां लै, “आझ़ दैआ बैल़ी रहणैं।”</para>
  <para style="s" vid="ACT 10:23">कुरनेलिस मणछे घअरै पतरास</para>
  <para style="p" vid="ACT 10:23">दुजै धैल़ै डेऊअ सह तिन्‍नां संघै जोपा नगरी लै अर जोपा नगरीए भाई मांझ़ै हुऐ कई तेऊ संघा।<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />तेखअ पुजै तिंयां कैसरिया नगरी अर कुरनेलिस त आपणैं टबरा अर साथी-भाई संघै न्हैल़अ लागअ द। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />ज़ांऊं पतरास भितरा लै त लागअ द एछदअ, कुरनेलिस आअ तेऊ सेटा लै मिलदअ अर तेऊ सेटा टेक्‍कअ माथअ। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पर पतरासै बोलअ तेऊ लै, “खल़अ उझ़ू, हुंबी आसा ताह ई ज़िहअ मणछ ताह निं लागदअ मुंह सेटा माथअ टेक्‍कणअ।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />तेऊ संघै गल्‍ला करदी डेऊअ सह भितरा लै अर तिधी हुऐ खास्सै मणछ कठा।<verse eid="ACT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 10:28" />पतरासै बोलअ तिन्‍नां लै, “तम्हां का आसा ऐहा गल्‍लो थोघ कि होरी ज़ाती संघा रहणअ या तिन्‍नां सेटा डेऊणअ हआ यहूदी लै बधाने साबै बूरअ। पर परमेशरै खोज़अ मुखा इहअ, ‘कोही मणछा लै निं लागी ज़ुठै अर छ़ोतलै बोल्दै।’ <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />तैही तम्हैं ज़ांऊं हुंह शादअ, हुंह लागअ च़ुप्प-च़ुप्पै हांढदअ। पर ऐबै पुछ़ा हुंह कि तम्हैं हुंह इधी किज़ू कामैं शादअ?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />कुरनेलिस बोलअ, “ऐहा गल्‍ला हुऐ आझ़ पूरै च़ार धैल़ै कि हुंह त चिऊथै पहरै लागअ द प्राथणां करदअ। एक मणछ खल़्हुअ शेतै च़मकदै झिकल़ै बान्हीं मुंह सम्हनै। <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />सह लागअ मुल्है इहअ बोल्दअ, ‘ओ कुरनेलिस, तेरी प्राथणां हेरी शूणीं अर तेरै दान गऐ परमेशरा सेटा पुजी, <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />तूह छ़ाड कहा जोपा नगरी लै शमौना शधाणूं ज़हा पतरास बोला, अर सह आसा समुंदरे बाढै च़ाम्भल़े बपारा करनै आल़ेए घअरै प्राहुंणअ।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तेखअ छ़ाडै मंऐं तेभी ताह सेटा लै लोग अर अह हुई बडी बधिया गल्‍ल कि तम्हैं आऐ, अर ऐबै आसा हाम्हैं सोभै इधी परमेशरे सम्हनै, ताकि ज़ुंण ताखा परमेशरै आसा खोज़अ द, तेता हाम्हैं बी शूणीं सके।”<verse eid="ACT 10:33" /></para>
  <para style="s">पतरासे शिक्षा</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तेखअ बोलअ पतरासै, “ऐबै हुअ मुंह पूरअ भरोस्सअ कि परमेशर निं कोही संघै भेदभाब करदअ।<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">बधा. 10:17</ref>; <ref loc="2CH 19:7">2 इति. 19:7</ref></char></note><verse eid="ACT 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 10:35" />“इधी तैणीं कि हर ज़ाती दी ज़ुंण तेऊए डरा हेठै रहा, अर धर्में काम करा, तेऊ करै हआ सह खुश। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />ज़ुंण बैण तेऊ इज़राईली सेटा पजैल़अ, ईशू मसीहा ज़ुंण सोभिओ प्रभू आसा तेऊ करै खोज़अ शांती दैणैं आल़अ खुशीओ समाद।<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="PSA 107:20">भज. 107:20</ref>; <ref loc="PSA 147:18">147:18</ref>; <ref loc="ISA 52:7">ईशा. 52:7</ref>; <ref loc="NAM 1:15">नहू. 1:15</ref></char></note><verse eid="ACT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 10:37" />“तैहा गल्‍लो आसा तम्हां का थोघ कि ज़ुंण गल्‍ला जोहन्‍ने पाणीं दी डुबकी दैणें प्रच़ारा बाद गलील मुल्खा का शुरू हई सारै यहूदा मुल्खै कई ज़ैगा पुजी कि <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />परमेशरै किहअ करै किअ नासरत नगरीए ईशूओ पबित्र आत्मां अर शगती करै अभिषेक। सह रह भलाई करदअ अर ज़ुंण राख्सै बरैबाद तै किऐ दै तिन्‍नां ठीक करदअ। किल्हैकि परमेशर करा त हर गल्‍ला लै तेऊए मज़त।<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="ISA 61:1">ईशा. 61:1</ref></char></note><verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />“हाम्हैं आसा तिन्‍नां कामें शाजत ज़ुंण तेऊ यहूदा मुल्खै अर एरुशलेम नगरी बी किऐ अर तिन्‍नैं मारअ सह काठे क्रूसा दी छ़ड़ाऊई करै।<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="DEU 21:22-23">बधा. 21:22-23</ref></char></note><verse eid="ACT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 10:40" />“पर सह किअ परमेशरै चिऊथै धैल़ै ज़िऊंदअ, अर प्रगट बी किअ। <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सोभी लोगा का निं पर तिन्‍नां शाजत का ज़ुंण परमेशरै पैहलै ई का छ़ांटै दै तै, मतलब-हाम्हैं, ज़ुंण तेऊए ज़िऊंदै हणैं का बाद तेऊ संघै खांदै-पिंदै बेठै।<verse eid="ACT 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 10:42" />“तेऊ दैनअ हाम्हां लै इहअ हुकम कि सोभी लोगा का खोज़ा अर ऐहा गल्‍ले दैआ शाजत कि ज़ुंण परमेशरै ज़िऊंदै अर मूंऐं दै मणछो पांच़ बणाअं, सह आसा अह ई ईशू। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />तेऊए दैआ परमेशरे सोभै गूर शाजत कि ज़ुंण बी तेऊ दी विश्वास करे, तेऊ भेटणीं तेऊए नाओंआं करै पाप माफी।”<note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="ISA 33:24">ईशा. 33:24</ref>; <ref loc="ISA 53:5-6">53:5-6</ref>; <ref loc="JER 31:34">जेर. 31:34</ref>; <ref loc="DAN 9:24">दान. 9:24</ref></char></note><verse eid="ACT 10:43" /></para>
  <para style="s">होरी ज़ातीए लोगा लै पबित्र आत्मां एछणअ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पतरास त इना गल्‍ला करदअ ई लागअ द कि पबित्र आत्मां होथअ तिन्‍नां सोभी शुणनै आल़ै प्रैंदै, <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />ज़ेतरै यहूदी विश्वासी पतरासा संघै तै आऐ दै, तिंयां हुऐ रहैन कि होरी ज़ाती लै बी दैनअ पबित्र आत्मों दान! <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />किल्हैकि तिन्‍नैं शूणैं तिंयां भांती-भांतीए बोली बोल्दै अर परमेशरे बड़ैई करदै।<verse eid="ACT 10:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 10:47" />एता लै बोलअ पतरासै, “ऐबै कै इना कुंण पाणीं का रोक्‍की सका कि ईंयां डुबकी निं लऐ, ज़ुंणी हाम्हां ज़िहअ ई पबित्र आत्मों दान पाअ?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />तेऊ बोलअ इहअ कि इना लै दैआ ईशू मसीहे नाओंए डुबकी। तेखअ लागै तिंयां पतरासा लै अरज़ करदै कि थोल़ै धैल़ै रहअ तूह हाम्हां संघै इधी।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पतरासो आपणैं कामें बारै खोज़णअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />शधाणूं अर होरी विश्वासी भाई ज़ुंण यहूदा मुल्खै तै, तिन्‍नैं बी शूणअ कि परमेशरो बैण मनअ होरी ज़ातीए लोगै बी। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />ज़ांऊं पतरास एरुशलेम नगरी बापस पुजअ, यहूदी मांझ़ा का आऐ दै विश्वासी लागै तेऊ संघै हठल़दै, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तूह डेऊअ होरी ज़ातीए घअरै अर तंऐं तिन्‍नां संघै खाअ-पिअ बी!”<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />तेखअ खोज़ी पतरासै तिन्‍नां का शुरू का सारी गल्‍ला, <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“हुंह त लागअ द जोपा नगरी प्राथणां करदअ, अर नर्तान हई भाल़अ एक बडी च़ादरा ज़िहअ बडअ तराणअ आसा च़ऊ कुंणी का राशै करै बान्हअ द, सह च़ुंढुअ सरगा का पृथूई बाखा लै ज़िधी हुंह त। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />ज़ांऊं मंऐं धैन दैनअ कि तेऊ तराणैं दी आसा संसारे सोभी रंगे च़ऊ ज़ांघा हांढदै, रिंगणै आल़ै सोभै ज़ीब अर सरगे च़ेल्‍लू-पखीरू। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />मंऐं शूणअ इहअ बोल, ‘ओ पतरास, उझ़ू इना मार अर खा।’<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />“मंऐं बोलअ इहअ कि नांईं प्रभू, ‘हुंह निं छ़ोत लाणैं आल़ी च़िज़ा कधि खाई सकदअ! किल्हैकि ज़ुंण च़िज़ा शुची निं आथी तिंयां निं मंऐं आझ़ तैणीं कधि खाई।’<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />“एते ज़बाबा दी बोलअ सरगा का दुजी बारी परमेशरै इहअ, ‘हुंह आसा परमेशर ज़ुंण मणछ मंऐं शुचै आसा किऐ दै, तिन्‍नां लै निं तूह छ़ोतलै बोलै।’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />चिई बारी हुअ इहअ ई, तेखअ खिंच़अ सह तराणअ तेभी उझै सरगा लै।<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />“तेभी आऐ तिधी चअन मणछ तेऊ घअरा लै ज़िधी हुंह प्राहुंणअ त। ज़ुंण कैसरिया नगरी का थिऐ कुरनेलिस मुंह सेटा लै छ़ाडै दै। तिंयां खल़्हुऐ दुआरे डेहल़ा बागै। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तेखअ बोलअ पबित्र आत्मां मुल्है तिन्‍नां पिछ़ू च़ुप्प-च़ुप्पै डेऊणा लै। छ़ह भाई आऐ होर बी मुंह संघै अर हाम्हैं डेऊऐ तेऊ मणछे घअरा लै।<verse eid="ACT 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 11:13" />“तेऊ खोज़अ मुखा इहअ, ‘तेऊ भाल़अ एक स्वर्ग दूत आपणैं घअरै खल़्हुअ द अर तेऊ दूतै बोलअ इहअ कि जोपा नगरी का शाद शमौना ज़हा लै पतरास बोला। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />तेऊ खोज़णीं तम्हां का एही गल्‍ला, परमेशरा दैणअ ताल्है अर तेरै सोभी टबरा लै उद्धार।’<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />“ज़ांऊं हुंह तिन्‍नां संघै गल्‍ला लागअ, पबित्र आत्मां होथअ तिन्‍नां सोभी शुणनै आल़ै प्रैंदै, ज़िहअ करै हाम्हां लै आअ त। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />तेखअ आअ मुंह प्रभूओ सह बैण आद ज़ुंण तेऊ बोलअ त इहअ, <char style="wj">‘जोहन्‍ना, दैनी पाणीं दी डुबकी; पर तम्हां लै दैणीं पबित्र आत्मां दी डुबकी।’</char> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />ऐबै ज़ै परमेशरै तिन्‍नां लै बी दान दैनअ, ज़ुंण हाम्हां प्रभू ईशू मसीहा दी विश्वास करी भेटअ, तै हुंह कुंण त कि परमेशरा रोक्‍की सका त?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />इहअ शूणीं हुऐ तिंयां यहूदी मांझ़ा का विश्वासा का आऐ दै मणछ च़ुप्पी। तिंयां लागै परमेशरे ज़ै-ज़ैकार करदी इहअ बोल्दै, “ऐबै दैनी परमेशरै होरी ज़ाती लै बी सदा रहणैं आल़ी ज़िन्दगी, ज़ै तिंयां आपणैं पापो प्राश्त करे अर परमेशरा सेटा लै बापस फिरे।”<verse eid="ACT 11:18" /></para>
  <para style="s">अन्ताकिया नगरी विश्वासीए टोली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />तिंयां सोभ लोग स्तिफनुसा करै पल़ै दै तेऊ शोग सांगटे मारै गऐ तै सारै दी छिंघुई, कोई डेऊऐ तिन्‍नां मांझ़ै फिनाका नगरी, कुप्रास टापू अर कई पुजै सिरीया मुल्खे अन्ताकिया नगरी। पर यहूदी छ़ाडी निं तिंयां होरी कोही लै बैण खोज़दै तै।<verse eid="ACT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 11:20" />पर तिन्‍नां मांझ़ै तै कई विश्वासी कुप्रास टापू का अर कुरेन नगरी का तिंयां आऐ अन्ताकिया नगरी अर तिधी लागै कई यूनानी मणछा का बी प्रभू ईशूए खुशीए समादा खोज़दै। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />तिन्‍नां संघै ती प्रभूए क्रिप्पा अर होरी ज़ातीए कई लोगै किअ विश्वास अर तिंयां फिरै प्रभू बाखा लै।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />तिन्‍नें ईंयां गल्‍ला पुजी एरुशलेम नगरी विश्वासीए टोली का बी अर तिन्‍नैं छ़ाडअ बरनबास अन्ताकिया नगरी लै। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />तिधी पुजी हुअ सह परमेशरे जशा भाल़ी खुश अर सोभी लै दैनअ इहअ हैअ कि मन्‍न लाई करै रहा प्रभू दी पाक्‍कै टेक्‍की। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />बरनबास त एक भलअ मणछ अर पबित्र आत्मां करै अर विश्वासा दी त भरपूर। खास्सै मणछै किअ प्रभू मसीहा दी विश्वास।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />तेखअ डेऊअ बरनबास शाऊला लोल़अ तरसुस नगरी लै। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />ज़ांऊं तेऊ शाऊल भेटअ, सह आणअ अन्ताकिया नगरी लै। इहअ हुअ कि तिंयां रहै एकी साला तैणीं विश्वासी टोली संघै मिलदै अर कई लोगा लै शिक्षा दैंदै, अर प्रभू ईशू मसीहे च़ेल्‍लै लै बोलअ सोभी का पैहलै अन्ताकिया नगरी “मसीही।”<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />तिन्‍नां धैल़ै आऐ परमेशरे कई गूर एरुशलेम नगरी का अन्ताकिया नगरी लै। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />तिन्‍नां मांझ़ै एकी अगबुस नाओंए गूरै खोज़अ खल़ै हई पबित्र आत्मां करै इहअ कि संसारै पल़णअ कई ज़ैगा नकाल़, अर सह नकाल़ पल़अ रोम राज़ा दी क्लौदिउस माहा राज़ेए ज़मानैं।<verse eid="ACT 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 11:29" />तेखअ किअ च़ेल्‍लै इहअ फैंसलअ कि हरेक विश्वासी दैणअ यहूदा मुल्खै रहणैं आल़ै विश्वासी भाई-बंधा लै आपणीं गांठी का थोल़ै-थोल़ै ढब्बै सोभी ज़हा का ज़ेतरअ पुगे तेतरै। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />तिन्‍नैं किअ तिहअ ई अर बरनबास अर शाऊले हाथै छ़ाडै एरुशलेम नगरी टोलीए सैणैं लै ढब्बै-धेल्‍लै।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">पतरासो कैद खानै का छ़ुटणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />तेऊ ज़मानैं छ़ाडी हेरोदेस राज़ै सैना एरुशलेम नगरीए विश्वासी च़ेल्‍लै कैद खानै कैद करना लै। तेऊ किऐ कई विश्वासी टोलीए सैणैं कैद सह तिन्‍नां लै ज़ुल्म करे। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />तेऊ पाअ जोहन्‍ना शधाणूंओ भाई याकब बी तलबारा करै मारी।<verse eid="ACT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 12:3" />ज़ांऊं तेऊ भाल़अ कि यहूदी मणछ हआ एता करै खुशी, तेऊ ढाकअ पतरास बी, तिंयां थिऐ आखरी रोटीए थैरे धैल़ै। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />तेऊ बझ़ैल़अ पतरास ढाकणैं संघा डाहअ कैद खानै गोटी। बागै डाहै खास्सै धैल़ै तैणीं पहरै लै च़ऊ बाखा च़ार-च़ार सपाही इहअ सोठी लाई कि ऊवार्णे थैरा बाद निंणअ सह लोगा सम्हनै।<verse eid="ACT 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5" />कैद खानै बागै त पतरासा लै पहरअ पाअ द अर विश्वासी टोलीए सोभै भाई-बैहण तै एक मन्‍न हई कबल्‍लै परमेशरा का प्राथणां करदै लागै दै।<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />हेरोदेस राज़ै सम्हनै पतरासा लै मकदमैं हणैं धैल़ी का पैहली राची थिअ पतरास दूई शांघल़ी करै बान्हीं कैद किअ द, संघा त दूई सपाही मांझ़ै सुत्तअ द। पहरी तै राची दुआरै पहरै दैंदै लागै दै। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />हेरा, तिधी खुडी आअ एक प्रभूओ स्वर्ग दूत अर सह तिधी खल़्हुअ अर तैहा खुडी च़मकअ प्रैश्शअ। तेऊ बाही पतरासे कुछी हाथा करै संघा झ़ैऊअ खल़अ, तेखअ बोलअ इहअ, “उझ़ू, छ़ेक्‍कअ कर!” पतरासे हाथै बान्हीं दी शांघल़ी पल़ी धरनीं।<verse eid="ACT 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8" />तेखअ बोलअ स्वर्ग दूतै तेऊ लै, “आपणअ च़ोल़अ अर पोलल़ै बान्ह।” पतरासै किअ तिहअ ई। तेखअ बोलअ स्वर्ग दूतै, “आपणैं झिकल़ै बान्हीं एछ मुंह पिछ़ू।”<verse eid="ACT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9" />पतरास निखल़अ कैद खानै का तेऊ संघै बागै संघा लागअ तेऊ पिछ़ू हांढदअ। पर तेऊ का निं इहअ थोघ बी थिअ कि ज़ुंण अह स्वर्ग दूत आसा आअ द, अह सच्च़ी आसा कि नांईं। तेऊ सोठअ इहअ कि हुंह आसा सुपनै भाल़अ लागअ द? <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />तेखअ पुजै तिंयां दुजै पहरै निखल़ी लोहे प्रऊल़ी सेटा, ज़ुंण नगरी बाखा खुल्हा ती, सह खुल्ही तिन्‍नां लै आप्पै अर तिंयां डेऊऐ एकी घाटी बाता बाती आजू अर ज़ांऊं तिंयां तैहा बाता का आजू निखल़ै, स्वर्ग दूत डेऊअ पतरासा छ़ाडी।<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />तेखअ ज़ांऊं पतरासा शाह फिरअ, तेऊ बोलअ, “ऐबै गअ मुखा थोघ लागी कि प्रभू छ़ाडअ मुल्है हेरोदेस राज़ेए हाथा का बच़ाऊंणा लै स्वर्ग दूत अर यहूदी ज़िहअ हणें आशा थिऐ रहै दै, सह निं तिहअ हुअ।”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />तेखअ आअ सह इहअ सोठी करै परमेशरै बच़ाऊअ हुंह आझ़, जोहन्‍ने ईज मरिअमे घअरा लै, ज़हा लै मार्कुस बोला, तिधी थिऐ खास्सै ज़ण्हैं बेठै दै प्राथणां करदै। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />ज़ांऊं तेऊ दुआर टोक्‍कदअ लागअ, एक रुदा नाओंए दासी आई शूणीं। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पतरासे हाक शूणीं ठुर्ही सह बडी खुशी-खुशी भितरा लै अर खुशीए मारै बिस्सरुई सह दुआरा खोल्हणैं बी अर तैहा खोज़अ सोभी का, “पतरास आसा दुआरै खल़्हुअ द।”<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />तिन्‍नैं होरी बोलअ तैहा लै, “तूह निं होशा दी आथी।” पर तैहा बोलअ होर बी विश्वासा संघै, “पतरास ई आसा।” पर होरी बोलअ इहअ कि तेऊओ स्वर्ग दूत हणअ।<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />पर पतरास रहअ दुआरा टोक्‍कदअ लागी, ज़ांऊं तिन्‍नैं दुआर घुआल़अ, तिंयां हुऐ रहैन। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />तेखअ किअ पतरासै तिन्‍नां लै हाथा करै शारअ कि च़ुप्पी रहा अर तिन्‍नां का खोज़अ कि प्रभू किहअ करै काढअ हुंह कैद खानै का बागै। तेखअ बोलअ तेऊ इहअ, “याकब अर होरी भाई का बी खोज़ै ऐहा गल्‍ला।” तेखअ डेऊअ पतरास तिधा का दुजी ज़ैगा लै।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />दोत्ती-दोत्थी हुऐ सपाही परशैन कि पतरास केस्सी डेऊअ! <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />ज़ांऊं हेरोदेस तेऊ लोल़अ लागअ, तेऊ निं सह भेटअ। तेखअ दैनी तेऊ पहरीए ज़ाच़-भाल़ करी तिन्‍नां लै सज़ा अर तिंयां पाऐ मारी अर हेरोदेस डेऊअ थोल़ै धैल़ै यहूदा छ़ाडी कैसरिया मुल्खा लै।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदेस राज़ेए मौत</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोदेस राज़अ थिअ सूर अर सदोन नगरी रहणैं आल़ै लोगा का नराज़। तिंयां आऐ सोभै कठा हई तेऊ सेटा अर राज़ेए दरबारी बलास्तुसा मनैऊंईं करै च़ाहा तै तिंयां मेल़-ज़ोल़ करनअ। किल्हैकि नाज़ा लै लागा त तिन्‍नां हेरोदेस राज़ेए मुल्खे आसरै रहणअ।<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="1KI 5:11">1 राज़. 5:11</ref>; <ref loc="EZK 27:17">एज. 27:17</ref></char></note><verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />राज़ै खोज़ी डाहै दै धैल़ै बेठअ हेरोदेस राज़अ आपणअ सुआब अर हार-शंगार बान्हीं राज़गाद्दी दी संघा लागअ बोल्दअ।<verse eid="ACT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 12:22" />ज़ुंण तिधी शूणैं तै लागै दै, तिन्‍नैं बोली एही गल्‍ल, “अह निं मणछ आथी अह आसा परमेशर लागअ द बोल्दअ।”<verse eid="ACT 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 12:23" />किल्हैकि लोग लागै परमेशरा छ़ाडी हेरोदेस राज़ेए प्रतप्पा खोज़दै। तेभी परमेशरो स्वर्ग दूत आअ अर हेरोदेस हुअ खास्सअ बमार। तेऊ पल़ै किल़ै अर थोल़ै बाद मूंअ सह किर्ही-किर्ही करै।<note caller="-" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="DAN 5:20">दान. 5:20</ref></char></note><verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />पर परमेशरो बैण लागअ बढदअ अर सारै दी पुजदअ।<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />ज़ांऊं बरनबास अर शाऊल आपणीं च़ाकरी पूरी करी मुक्‍कै, जोहन्‍ना ज़हा लै मार्कुस बोला, तेऊ संघा आणी फिरै एरुशलेम नगरी लै बापस।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास अर शाऊल छ़ाडणैं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />सिरीया मुल्खे अन्ताकिया नगरीए विश्वासीए टोली दी थिऐ परमेशरे कई गूर अर गूरू, मतलब-बरनबास अर शमौन ज़हा लै निगर बोला, अर लुकियुस कुरेन नगरी का थिअ, गलील मुल्खे राज़ै हेरोदेस राज़ैओ दुधभाई मनहेन अर शाऊल। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />ज़ांऊं तिंयां ब्रता डाही करै प्रभूए च़ाकरी करदै तै लागै दै, पबित्र आत्मां बोलअ, “मुल्है करा बरनबास अर शाऊला मेरै तेऊ कामां लै ज़ुदै ज़ेता लै मंऐं तिंयां शादै दै आसा।”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />तेखअ डाहै तिन्‍नैं ब्रत अर प्राथणां करी तिन्‍नां दी हाथ अर तिंयां किऐ बिदा।<verse eid="ACT 13:3" /></para>
  <para style="s">खुशीए समादा खोज़णा लै पल़सीए पैहली हांढ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />तिंयां छ़ाडै पबित्र आत्मां सलुकिआ नगरी ज़िधी ज़हाज़ो आडअ थिअ अर तिधा का ज़हाज़ा दी बेशी डेऊऐ तिंयां कुप्रास टापू लै। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />सालामिस नगरी पुजी खोज़अ परमेशरो बैण यहूदी मणछे सभागृहा अर जोहन्‍ना मार्कुस त तिन्‍नों दास।<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />तेऊ सारै टापू फेर फिरी पुजै तिंयां पाफस नगरी। तिधी भेटअ तिन्‍नां बार ईशू नाओं एक यहूदी ज़ादू करदअ अर सह थिअ झ़ुठै गूर। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />सह थिअ सिरगिउस पल़सी सुबैदारा संघा, ज़ुंण समझ़कार मणछ त, अर सह च़ाहा त बरनबास अर शाऊला आप्पू सेटा शादी करै परमेशरो बैण शुणनअ। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पर इलिमास ज़ादू करनै आल़ै, अह आसा तेऊए नाओं मतलब, तेऊ किअ बरोध अर तेऊ किई खास्सी कोशिश कि राज़पाल ईशू दी विश्वास नां करी सके।<verse eid="ACT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9" />तेखअ शाऊलै, ज़सरअ नाअं पल़सी बी आसा, पबित्र आत्मां करै भर्हुई तेऊ लै कोहरअ भाल़ी बोलअ, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“तूह आसा राख्सा पिछ़ू डेऊअ द अर तूह आसा हर भली गल्‍लो दुशमण! तूह बोला हर बगत लोगा का झ़ुठअ अर तिन्‍नां लै करा तूह कई कदुष्ट काम। ज़ुंण तूह इहअ बोला कि परमेशर बिधातो बारै ईंयां गल्‍ला निं शुची आथी, एही झ़ुठी गल्‍ला पाआ लोगा का खोज़णें छ़ाड़। <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />परमेशरै लाई ताल्है ऐबै सज़ा दैई! अर तूह रहणअ थोल़ै धैल़ै कांणअ अर ताखा निं सुरज़ शुझणअ।”</para>
  <para style="p" vid="ACT 13:11">तेखअ हुई तेभी तेऊए आछी कांणी अर तेऊ का शुझुअ न्हैरअ अर सह लागअ ओर्ही-पोर्ही ठणाखदअ कि तेऊओ कुंण हाथ ढाके।<verse eid="ACT 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 13:12" />तेखअ सुबैदार हुअ प्रभूए शिक्षा शूणीं रहैन अर ज़ुंण तिधी हुअ त तेता भाल़ी किअ तेऊ प्रभू दी विश्वास।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसदिया मुल्खे अन्ताकिया दी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पल़सी अर तेऊए साथी पाफस नगरी का ज़हाज़ खोल्ही करै पुजै पंफूलिआ मुल्खै पिरगा नगरी अर जोहन्‍ना डेऊअ तिन्‍नां छ़ाडी एरुशलेम नगरी लै बापस फिरी। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पिरगा नगरी का आजू डेऊई पुजै तिंयां पिसदिया मुल्खे अन्ताकिया नगरी।</para>
  <para style="p" vid="ACT 13:14">बशैघे धैल़ी बेठै तिंयां सभागृहा डेऊई। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />परमेशरे बधान अर परमेशरे गूरे कताबा पहल़णैं बाद बोलअ तिधी सभागृहे कारदारै तिन्‍नां लै, “भाईओ, ज़ै तम्हां बोल़णा लै किज़ै इहअ आसा ज़ेता करै तिन्‍नां हैअ एछे, तै एछा संघा खोज़ा तिन्‍नां गल्‍ला।”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />तेखअ बोलअ पल़सी खल़ै उझ़ुई करै हाथा करै शारअ करी, “हे इज़राईली मणछो अर परमेशरा का डरनै आल़ैओ, शूणां।<verse eid="ACT 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 13:17" />“इना इज़राईलीए परमेशरै छ़ांटै म्हारै दाद-बाब अर ज़धू ईंयां मिसर देशै परदेसी हई रहा तै, तिन्‍नें किई खास्सी बढोतरी, अर आपणीं महान बाहे बला करै आणै तिधा का छ़ड़ैऊई।<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 6:1">लुआ. 6:1</ref>; <ref loc="EXO 12:51">12:51</ref></char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />च़ाल़्ही साला तैणीं रह सह रेगीस्तानै तिन्‍नां ज़िरदअ लागी।<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="EXO 16:35">लुआ. 16:35</ref>; <ref loc="NUM 14:34">गण. 14:34</ref>; <ref loc="DEU 1:31">बधा. 1:31</ref></char></note><verse eid="ACT 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 13:19" />“कनान देशै साता ज़ातीओ बरैबाद करी तिन्‍नों देश कोई 450 साला लै दैनअ इना लै रहणा लै।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">बधा. 7:1</ref>; <ref loc="JOS 14:1">ज़ैह. 14:1</ref></char></note><verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />“तेखअ बणाऐं परमेशरे शमूएल गूरा तैणीं पांच़।<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="JDG 2:16">पांच़ 2:16</ref>; <ref loc="1SA 2:16">1 शमू. 2:16</ref></char></note><verse eid="ACT 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21" />“तेखअ मांगअ तिन्‍नैं एक राज़अ। परमेशरै दैनअ च़ाल़्ही साला तैणीं बिन्यामीने गोत्रा का तिन्‍नां लै एक मणछ किशूओ शोहरू शाऊल तिन्‍नां लै राज़अ बणाईं।<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 शमू. 8:5</ref>,<ref loc="1SA 8:19">19</ref>; <ref loc="1SA 10:20-21">10:20-21</ref>,<ref loc="1SA 10:24">24</ref>; <ref loc="1SA 11:15">11:15</ref></char></note><verse eid="ACT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 13:22" />“तेखअ किअ सह दूर अर तेऊ बाद बणाअं दाबेद राज़अ, ज़सरै बारै परमेशरै इहअ बोलअ, ‘ईशैईओ शोहरू दाबेद शुझिआ मुखा राज़अ बणनैं जोगी, सह सोठा तिहअ ई ज़िहअ हुंह सोठा। तेऊ करनी सोभै गल्‍ला तेही ज़िहअ हुंह च़ाहा।’<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 शमू. 13:14</ref>; <ref loc="1SA 16:12-13">16:12-13</ref>; <ref loc="PSA 89:20">भज. 89:20</ref>; <ref loc="ISA 44:28">ईशा. 44:28</ref></char></note><verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />“राज़ै दाबेदे ई खिंबा संघै आसा परमेशरै करार किई दी अर तेते साबै छ़ाडअ इज़राईली मणछा सेटा एक उद्धार दैणैं आल़अ, मतलब ईशू मसीहा।<note caller="-" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 शमू. 7:12-13</ref>; <ref loc="ISA 11:1">ईशा. 11:1</ref></char></note><verse eid="ACT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 13:24" />“मसीहा का आजी दैनअ जोहन्‍ना सोभी इज़राईली लै समाद। तेऊ बोलअ सोभी लै, ‘आपणैं पापो प्राश्त करा, परमेशरा बाखा फिरा, तेखअ दैंऊं हुंह तम्हां लै थारै पाप माफी लै डुबकी।’ <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />ज़ांऊं जोहन्‍ना आपणैं तेऊ कामां पूरै करनै आल़अ त ज़ुंण परमेशरै तेऊ का सभाल़अ त, तेऊ बोलअ इहअ, ‘तम्हैं मुंह किज़ै समझ़ा? हुंह निं मसीहा आथी! हेरा, ज़ुंण मुंह बाद एछणैं आल़अ आसा, सह आसा सोभी का महान अर इधी तैणीं कि हुंह निं तेऊ सेटा एता जोगी बी आथी कि हुंह तेऊए पोलल़ै खोल्हणैं च़ाकरी करनै आल़अ दास बणी सकूं।’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“भाईओ, तम्हैं ज़ुंण आजू आबरामे लुआद आसा अर ज़ुंण तम्हैं परमेशरा का डरा, तम्हां सेटा आसा हेरअ द सह उद्धार दैणैं आल़अ बैण पजैल़ी। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />एरुशलेम नगरी दी रहणैं आल़ै अर सैणैं निं सह बछ़ैणअ, अर परमेशरे गूरै बोली दी गल्‍ला निं समझ़ी ज़ुंण तिंयां हर बशैघे धैल़ै पहल़ा। इहअ करै किई तिंयां गल्‍ला तेऊ लै दोश लाई पूरी। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />तिन्‍नां निं मारनै जोगी तेऊ दी किछ़ै दोश भेटअ, तैबी किई तिन्‍नैं राज़पाल पिलातुसा का अरज़ कि एऊ पाआ मारी।<verse eid="ACT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 13:29" />“ज़ांऊं तिन्‍नैं तेऊए बारै लिखी दी गल्‍ला पूरी किई, सह डाहअ तिन्‍नैं क्रूसा का थुआल़ी घोरी दी बुदरी। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पर परमेशरै किअ सह मरी करै भिई ज़िऊंदअ। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />सह रहअ तिन्‍नां आपणैं च़ेल्‍लै संघै खास्सै धैल़ै तैणीं खांदअ-पिंदअ अर शुझदअ लागी ज़ुंण गलील मुल्खा का तेऊ संघै तै एरुशलेम नगरी आऐ दै, ज़ुंणी ईंयां गल्‍ला आपणीं आछी भाल़ी तिंयां आसा ऐबै लोगा का इना गल्‍ला खोज़दै लागै दै।<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />“हाम्हैं आसा एभै परमेशरे खुशीए समादा खोज़दै लागै दै ज़ेते करार परमेशरै म्हारै दादा-बाबा का थिई किई दी। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />परमेशरै किई प्रभू ईशू ज़िऊंदै करी सह ई करार म्हारी लुआदा लै पूरी, ज़िहअ भज़ने कताबा दी मसीहे बारै आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भज. 2:7</ref></char></note></para>
  <para style="q" vid="ACT 13:33">‘तूह आसा मेरअ पूत</para>
  <para style="q" vid="ACT 13:33">आझ़ दैनअ मंऐं ताल्है ज़ल्म।’<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />“परमेशरै किअ मसीहा मरी करै ज़िऊंदअ अर सह निं तेऊ भिई कधि मरनै दैंदअ। परमेशरै आसा म्हारै दादा-बाबा का इहअ बोलअ द,<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">ईशा. 55:3</ref></char></note></para>
  <para style="q" vid="ACT 13:34">‘मुंह दैणीं तम्हां लै सोभ भली गल्‍ला अर बर्गत</para>
  <para style="q" vid="ACT 13:34">ज़ुंण मंऐं दाबेद राज़ै संघै करार किई ती।’<verse eid="ACT 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35" />“तैही आसा तेऊ एकी होरी भज़ना दी बी मसीहे बारै बोलअ द, ‘ताह निं आपणैं पबित्र मणछे देही चिजणैं दैणअ।’<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भज. 16:10</ref></char></note><verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />“दाबेद राज़ै किअ तिहअ ई ज़ेही परमेशरे मरज़ी ती। मरी करै डाही तेऊए देही घोरी दाबी अर ज़िहै तेऊए दाद-बाब दाबै अर तेऊए देही बी चिजी। भज़ना दी ईंयां गल्‍ला दाबेद राज़ै आपणैं बारै ता बोली निं आथी।<note caller="-" style="x"><char style="xo" closed="false">13:36 </char><char style="xt" closed="false"><ref loc="JDG 2:10">पांच़ 2:10</ref>; <ref loc="1KI 2:10">1 राज़. 2:10</ref></char></note> <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />पर ईशू ज़ुंण परमेशरै मरी करै ज़िऊंदअ किअ तेऊए देही निं चिजी आथी।<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />“तैही बोला हुंह भाईओ, ऐहा गल्‍ला लऐ तम्हैं समझ़ी! एऊ ई करै भेटा तम्हां पाप माफ हणैंओ खुशीओ समाद। <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />ज़हा गल्‍ला करै मोसा गूरे बधाना करै नर्दोश निं हई सकदै तै। तिन्‍नां सोभी का हआ ईशू दी विश्वास करनै आल़अ मणछ धर्मीं।<verse eid="ACT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 13:40" />“तैही रहा चतैन, इहअ निं हआ कि ज़ुंण परमेशरे गूरे कताबा दी आसा बोलअ द कि तेऊ तिन्‍नां लै किज़ै करनअ सह तम्हां लै बी होए,<note caller="-" style="x"><char style="xo" closed="false">13:40 </char><char style="xt" closed="false"><ref loc="HAB 1:5">हब. 1:5</ref></char></note><verse eid="ACT 13:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41" />‘ओ निंदा करनै आल़ैओ,</para>
  <para style="q" vid="ACT 13:41">भाल़ा, अर झशकिआ अर मरा।</para>
  <para style="q" vid="ACT 13:41">किल्हैकि मुंह करनअ थारै धैल़ै एक काम,</para>
  <para style="q" vid="ACT 13:41">इहअ काम कि, ज़ै तम्हैं तेते च़रच़ा शुणें,</para>
  <para style="q" vid="ACT 13:41">तम्हैं निं कधि तेतो भरोस्सअ करनअ।’”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />ज़ांऊं पल़सी अर बरनबास यहूदी सभा का बागै निखल़ै, लोग लागै एही अरज़ करदै कि आगलै बशैघे धैल़ै खोज़ै हाम्हां का इना गल्‍ला भिई। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />ज़ांऊं सभागृहा सभा मुक्‍की, यहूदी अर यहूदी पंथा दी आऐ दै होरी लोगा मांझ़ै हुऐ कई बरनबास अर पल़सी पिछ़ू। पल़सी अर बरनबासै बोलअ तिन्‍नां लै, “तम्हां लै लोल़ी परमेशरो जश हुअ, तेऊ दी डाहा सदा भरोस्सअ।”<verse eid="ACT 13:43" /></para>
  <para style="s">पल़सीओ होरी ज़ाती मांझ़ै प्रच़ार शुरू करनअ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />आगलै हबतै बशैघे धैल़ी हुऐ नगरीए सोभ लोग परमेशरे बैणा शूणैं कठा। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पर यहूदी सैणैं मन्‍नैं हुई तिन्‍नां खास्सै मणछे छ़ुंडा भाल़ी ज़ल़ण अर तिंयां लागै निंदा करदै अर पल़सीए खलाफ बोल्दै।<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />तेखअ बोलअ पल़सी अर बरनबासै नडरै हई करै, “अह थिअ ज़रूरी कि परमेशरो समाद खोज़णअ पैहलै तम्हां का। पर ज़ै तम्हैं तेता नांईं मना अर तम्हैं आप्पू सदा रहणैं आल़ी ज़िन्दगी जोगी शुचै नांईं होए, तेखअ डेऊणअ तम्हां यहूदी छ़ाडी होरी ज़ाती बाखा लै। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />किल्हैकि प्रभू आसा हाम्हां लै अह हुकम दैनअ द,<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 49:6">ईशा. 49:6</ref></char></note></para>
  <para style="q" vid="ACT 13:47">‘मंऐं आसा तूह होरी ज़ाती लै प्रैश्शअ बणाअं द,</para>
  <para style="q" vid="ACT 13:47">ताकि तूह पृथूई दी हर ज़ैगा उद्धार दैणैं आल़अ दुआर होए।’”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />इहअ शूणीं हुऐ होरी ज़ातीए लोग खुशी ज़ुंण यहूदी नांईं तै आथी, अर तिंयां लागै परमेशरे बैणे बड़ैई करदै अर ज़ेतरै सदा रहणैं आल़ी ज़िन्दगी लै छ़ांटै तै तिन्‍नैं किअ सोभी विश्वास। <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />तेखअ लागअ प्रभूओ बैण सारै देशै कई ज़ैगा पुजदअ।<verse eid="ACT 13:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 13:50" />पर यहूदी मणछा मांझ़ै भली भगत बेटल़ी, भगत अर नगरीए बडै लोगा लै दैनी कई एही च़ुघ कि ईंयां लोग निं ठीक आथी अर पल़सी अर बरनबास काढै उपद्रभ करी तेऊ मुल्खा का बागै।<verse eid="ACT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 13:51" />तेखअ डेऊऐ तिंयां तिन्‍नें सम्हनै खूरा का धूल़अ ठुल़्हकी करै इकुनिम नगरी लै <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />प्रभूए च़ेल्‍लै रहै नंद अर पबित्र आत्मां करै भरपूर हंदै लागी।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकुनिम नगरी पल़सी अर बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />इकुनिम नगरी हुअ इहअ कि तिंयां डेऊऐ यहूदी मणछे सभागृहा लै संघा-संघा। तिन्‍नैं किई एही गल्‍ला कि यहूदी अर यूनानी मांझ़ै किअ कई लोगै विश्वास। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पर ज़हा परमेशरो बैण नांईं मनणअ त, तिन्‍नैं यहूदी दैनी होरी ज़ातीए लोगा लै तिन्‍नां विश्वासी भाईए खलाफ च़ुघ अर तिन्‍नैं किऐ विश्वासीए खलाफ उपद्रभ।<verse eid="ACT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 14:3" />शधाणूं रहै कई धैल़ै तैणीं तिधी अर प्रभूए भरोस्सै बडी हिम्मता संघै लागै परमेशरे बैणा खोज़दै। प्रभू बी दैआ त तिन्‍नें हाथै बडै-बडै नछ़ैण रहैऊई करै अर नुआहरै काम करी परमेशरे जशे बैणो सबूत। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पर नगरीए लोगा मांझ़ै पल़ी फूट अर इहअ करै कई हुऐ यहूदी बाखा लै अर कई हुऐ शधाणूं बाखा लै।<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />यहूदी, तिन्‍नें सैणैं, अफसर अर होरी ज़ातीए कई लोगै किअ इहअ एक्‍कअ कि ईंयां पाणै हाम्हां पात्थरो ढो दैई मारी। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />पल़सी अर बरनबासा का गअ ऐहा गल्‍लो थोघ लागी अर तिंयां ठुर्है लुकानिआ मुल्खे लुस्रा अर दिरबे नगरी लै अर ओरी-पोरीए देशा लै। <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />तिधी रहै तिंयां खुशीए समादा खोज़दै लागी।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्रा अर दिरबे दी पल़सी</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्रा नगरी त एक मणछ बेठअ द, सह थिअ ज़ल्मां ओर्ही लाट्टअ अर तेऊए निं हांढदअ त अर आपणीं ज़िन्दगी निं सह किधी हांडअ-फिरअ त। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />सह थिअ पल़सी गल्‍ला करदै शूणअ लागअ द अर पल़सी भाल़अ तेऊ बाखा लै कोहरअ कि एऊ आसा पाक्‍कअ भरोस्सअ कि प्रभू ईशू सका मुंह ऐहा बमारी का बच़ाऊई। <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />पल़सी बोलअ ज़ोरै, “आपणीं ज़ांघा टेक्‍क खल़अ,” तेखअ लागअ सह मणछ उझै छ़ाहल़ दैई हांढदअ-फिरदअ।<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />लोगै बोलअ पल़सीए एऊ च़मत्कारा भाल़ी लुकानिआ बोली दी ज़ोरै-ज़ोरै, “देअ होथै सरगा का मणछे रुपै हाम्हां जैंदरा लै।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />तिन्‍नैं बोलअ बरनबास लै ज्यूस अर पल़सी लै हिरमेस देअ किल्हैकि सह थिअ गल्‍ला करना लै सैणअ। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />ज्यूस देअए देहुरे पज़ैरै ज़ुंण तैहा नगरी सम्हनै थिअ, तेऊ आणअ एक गाभू अर फूले हार नगरीए प्रऊल़ी सेटा तिन्‍नां लै बल़ीदान करना लै।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />पर ज़ांऊं बरनबास अर पल़सी शधाणूं का इहअ थोघ लागअ, तिन्‍नैं धेल़ै आपणैं झिकल़ै संघा ठुर्है लोगा जैंदरा लै। संघा बोलअ तिन्‍नैं ज़ोरै-ज़ोरै इहअ,<verse eid="ACT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 14:15" />“भाईओ, तम्हैं अह किज़ै लाअ करी? हाम्हैं बी आसा तम्हां ई ज़िहै दुखा-सुखा भुगतणै आल़ै मणछ, अर तम्हां का खोज़ा हाम्हैं अह खुशीओ समाद कि तम्हैं फिरा इना बृथा च़िज़ा का ज़ुदै हई तेऊ ज़िऊंदै परमेशरा बाखा लै, ज़ुंणी सरग, पृथूई, समुंदर अर ज़ुंण बी तेथ दी आसा, सोभै गल्‍ला बणाईं।<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">लुआ. 20:11</ref>; <ref loc="PSA 146:6">भज. 146:6</ref></char></note><verse eid="ACT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 14:16" />“आझ़ा कै पैहलै रहै तम्हैं होर सोभै ज़ाती आपणैं-आपणैं साबै कई देअ पिछ़ू हांढदै लागी। किल्हैकि तम्हां का निं तेऊ परमेशरे बारै थोघै त। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />तैबी निं सह आप्पू शाजत बाझ़ी रहअ, पर भलाई रहअ करदअ लागी अर सरग रहअ हंदअ लागी अर फल़ा-फल़ूटे ऋत दैई रहअ थारै मन्‍नां रोटी-पाणीं करै बडी खुशी दी भरदअ लागी।”<note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="PSA 147:8">भज. 147:8</ref>; <ref loc="JER 5:24">जेर. 5:24</ref></char></note><verse eid="ACT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 14:18" />इहअ बोली बी तिन्‍नैं तिंयां बडै मसा जाई करै रोक्‍कै बल़ीदान करनै का।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />पर कई यहूदी आऐ अन्ताकिया नगरी अर इकुनिम नगरी का तिन्‍नैं किऐ तिंयां लोग आप्पू बाखा लै, तेखअ पल़सी लै दैनअ पात्थरो ढो। तिन्‍नैं समझ़अ कि पल़सी गअ मरी अर सह निंयं तिन्‍नैं घिशी करै नगरी बागै। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पर ज़ांऊं होर च़ेल्‍लै आऐ अर तेऊ फेर खल़्हुऐ, सह उझ़ुअ खल़अ अर तेखअ डेऊअ नगरी भितरा लै। संघा डेऊअ दुजै धैल़ै बरनबासा संघै दिरबे नगरी लै।<verse eid="ACT 14:20" /></para>
  <para style="s">सिरीया मुल्खे अन्ताकिया नगरी लै बापस फिरनअ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />तेखअ फिरै पल़सी अर बरनबास दिरबे लोगा लै खुशीओ समाद खोज़ी करै, कई च़ेल्‍लै बणाईं करै लुस्रा अर इकुनिम बाती अन्ताकिया मुल्खा लै बापस। <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />सारै दी रहै तिंयां च़ेल्‍ले मना पाक्‍कै करी शिक्षा दैंदै कि विश्वासा दी रहा टेक्‍की। तिंयां बोला तै इहअ बी कि हाम्हां लागणअ बडै दुख ज़िरी परमेशरे राज़ा दी डेऊणअ। <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />तेखअ बणाऐं तिन्‍नैं हरेक विश्वासी टोली दी तिन्‍नां लै सैणैं, अर ब्रत डाही प्राथणां करी सभाल़ै तिंयां प्रभूए हाथै ज़हा दी तिन्‍नैं विश्वास किअ त।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />तेखअ पुजै तिंयां पिसदिया मुल्खै बाती हांढदी पंफूलिआ मुल्खै। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />तिधा का पुजै पिरगा नगरी बैण खोज़ी करै तिंयां इटल़ी देशै।<verse eid="ACT 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26" />तेखअ आऐ तिंयां तिधा का ज़हाज़ा दी बेशी अर अन्ताकिया नगरी लै ज़िधा का तिंयां तेऊ कामां लै निखल़ै तै ज़ुंण परमेशरे जशा दी तिन्‍नां का सभाल़अ त अर ज़ुंण तिन्‍नैं पूरअ किअ त। <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />तिधी पुजी किई तिन्‍नैं विश्वासीए टोली कठा अर तिन्‍नां सोभी का खोज़ी सोभ गल्‍ला कि परमेशरै किऐ तिन्‍नां संघै बडै-बडै काम अर होरी ज़ाती लै बी खोल्हअ परमेशरै दुआर ताकि तिंयां बी विश्वास करी सके। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />तेखअ रहै तिंयां च़ेल्‍लै संघै खास्सै धैल़ै तिधी।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">एरुशलेम नगरीए सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />पल़सी अर बरनबास थिऐ सिरीया मुल्खै अन्ताकिया नगरी अर कई लोग आऐ यहूदा मुल्खा का तिधा लै। संघा लागै तिंयां विश्वासी भाई का इहअ सखाऊंदै, “ज़ै मोसा गूरे रिती-रबाज़े साबै थारअ खतैर नांईं होए तै निं तम्हां उद्धार हई सकदअ।”<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">लेब. 12:3</ref></char></note><verse eid="ACT 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 15:2" />पल़सी अर बरनबास निं तिन्‍नें ऐहा गल्‍ला लै राज्ज़ी हुऐ अर तिन्‍नैं किई हठ कि अह गल्‍ल आसा गलत। खिरी हुऐ सोभ ऐहा गल्‍ला लै राज्ज़ी कि पल़सी, बरनबासा संघै डेओआ हाम्हां मांझ़ै कई होर भाई ऐहा गल्‍ले बारै फैंसलै लै एरुशलेम नगरी लै शधाणूं अर विश्वासी टोलीए सैणैं सेटा लै।<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />तेखअ छ़ाडै तिंयां विश्वासी टोली एरुशलेम नगरी लै अर तिंयां दैनै बाता खास्सै दूर तैणीं पजैल़ी। तेखअ डेऊऐ तिंयां फिनाका नगरी अर सामरी मुल्खै बाती विश्वासी भाई सेटा। तिन्‍नैं खोज़अ तिन्‍नां का इहअ कि खास्सी खुशीए गल्‍ल आसा कि होरी ज़ातीए लोग बी सका परमेशरा सेटा एछी।<verse eid="ACT 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 15:4" />ज़ांऊं तिंयां एरुशलेम नगरी पुजै, विश्वासीए टोली, शधाणूं अर विश्वासी टोलीए सैणैं मिलै तिन्‍नां संघै बेघै खुश हई। तिन्‍नैं बी खोज़अ कि परमेशरै तिन्‍नां संघै रही किहै-किहै काम किऐ। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />पर फरीसी मणछे पंथा का ज़ुंण विश्वासा दी आऐ तै, तिन्‍नां मांझ़ै बोलअ कई इहअ, “ज़ुंणी होरी ज़ाती मांझ़ै विश्वास किअ तिन्‍नां लै दैणअ खतैर करनै अर मोसा गूरे बधान मनणैओ हुकम ज़रूरी।”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />तेखअ हुऐ शधाणूं अर विश्वासी टोलीए सैणैं ऐहा गल्‍ले बारै बच़ारा करदै कठा। <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />खास्सै हठल़णैं का बाद बोलअ पतरासै खल़ै उझ़ुई करै तिन्‍नां सोभी लै,</para>
  <para style="p" vid="ACT 15:7">“भाईओ, तम्हां का आसा थोघ कि खास्सै धैल़ै गऐ तैहा गल्‍ला बिति कि परमेशरै छ़ांटअ तम्हां मांझ़ै हुंह कि मुखा होर ज़ाती बी खुशीओ समाद शूणीं विश्वास करे। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />मन्‍नें गल्‍ला परखणैं आल़ै परमेशरै दैनी तिन्‍नां लै बी हाम्हां ई ज़ेही पबित्र आत्मां दैई तिन्‍नें शाजत।<verse eid="ACT 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 15:9" />“विश्वासा करै तिन्‍नें मन्‍न शुचै करी निं परमेशरै हाम्हां अर तिन्‍नां दी किछ़ै फरक डाहअ। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ऐबै किल्है आसा तम्हैं लागै दै परमेशरा परखदै? तम्हैं किल्है लाअ होरी ज़ाती का आऐ दै इना विश्वासी भाईए कैल़ै इहअ जूँ पाई ज़हा नां म्हारै दाद-बाब च़की सकै अर नां हाम्हैं च़की सकदै?<verse eid="ACT 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 15:11" />“पर हाँ, म्हारअ आसा इहअ विश्वास कि ज़ेऊ साबै तिन्‍नां प्रभूए जशा दी उद्धार भेटणअ, तेऊ ई साबै भेटणअ हाम्हां बी मसीहा ईशू दी विश्वास करी! म्हारअ उद्धार निं बधाना करै हणअ।”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />सभा दी बेठै दै सोभ लोग लागै शांत हई बरनबास अर पल़सीए गल्‍ला शूणैं कि परमेशरै तिन्‍नां करै होरी ज़ाती दी किहै-किहै नछ़ैण अर नुआहरै काम किऐ। <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />पल़सी अर बरनबास ज़ांऊं बोली मुक्‍कै, याकब लागअ इहअ बोल्दअ,</para>
  <para style="p" vid="ACT 15:13">“भाईओ, <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />मेरी गल्‍ला शूणां, शमौन पतरासै आसा हेरअ द तम्हां का खोज़ी कि ज़धू सह पैहली बारी होरी ज़ाती सेटा डेऊअ तधू परमेशरै तिन्‍नां लै केही बर्गत दैनी कि तिन्‍नां मांझ़ै बी छ़ांटै आप्पू लै लोग। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />एता संघै ज़ुल़ा परमेशरे गूरै बोली दी ईंयां गल्‍ला, ज़िहअ शास्त्रा दी आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">15:15 </char><char style="xt" closed="false"><ref loc="JER 12:15">जेर. 12:15</ref>; <ref loc="ISA 45:21">ईशा. 45:21</ref>; <ref loc="AMO 9:9-12">आम. 9:9-12</ref></char></note><verse eid="ACT 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16" />‘आजू करनअ मुंह राज़ै दाबेदो राज़ भिई खल़अ,</para>
  <para style="q" vid="ACT 15:16">ज़ुंण ढूल़ै दै घअरा ज़िहअ आसा।</para>
  <para style="q" vid="ACT 15:16">मुंह करनी तेते भित्ती लेस्सी-टुशी राम्बल़ी</para>
  <para style="q" vid="ACT 15:16">संघा च़िणनअ मुंह सह भिई तिहअ ई ज़िहअ पैहलै थिअ।<verse eid="ACT 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17" />मुंह करनअ इहअ एते तैणीं कि,</para>
  <para style="q" vid="ACT 15:17">होरी ज़ातीए मणछ बी मुंह सेटा लै एछे ज़हा दी मेरै नाओंए छ़ाप आसा लागी दी।<verse eid="ACT 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18" />ऐहा गल्‍ला बोला सह ई प्रभू</para>
  <para style="q" vid="ACT 15:18">ज़ुंण संसार शुरू हणैं ओर्ही इना गल्‍लो समादा खोज़दअ आसा लागअ द।’<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“तै आसा मेरअ इहअ बच़ार कि होरी ज़ाती का बी ज़ुंण लोग परमेशरा बाखा लै फिरा, तिन्‍नां लै निं दुख दैआ। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />पर तिन्‍नां लै दैआ इहअ समाद लिखी कि तिंयां रहै छ़ोत लाणैं आल़ी च़िज़ा, मुहुर्ती लै बल़ी किऐ दै मास्स, लोहू, गअल़ मरोक्‍की करै मारै दै ज़ीबे शिखा अर कंज़रैई का दूर।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="GEN 9:4">मूल. 9:4</ref>; <ref loc="LEV 3:17">लेब. 3:17</ref>; <ref loc="LEV 17:10-14">17:10-14</ref></char></note><verse eid="ACT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 15:21" />“किल्हैकि पराणैं ज़मानैं ओर्ही आऐ नगरी-नगरी मोसा गूरे बधाने बारै खोज़दी अर हर बशैघे धैल़ै पहल़ा इना सभागृहा।”<verse eid="ACT 15:21" /></para>
  <para style="s">होरी ज़ातीए विश्वासी लै च़िठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तेखअ हुऐ ऐहा गल्‍ला लै सारी विश्वासीए टोली, शधाणूं, विश्वासी टोलीए सैणैं बी राज्ज़ी अर तिन्‍नैं छ़ांटै आप्पू मांझ़ा का कई मणछ, मतलब यहूदा ज़हा लै बरसबा बोला अर सिलास, ज़ुंण होरी भाई मांझ़ै सैणैं तै, तिंयां छ़ाडै पल़सी अर बरनबासा संघै अन्ताकिया लै। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />तिन्‍नें हाथै दैनअ इहअ लिखी कि अन्ताकिया, सिरीया अर किलकिआ मुल्खै रहणैं आल़ै विश्वासी भाई ज़ुंण होरी ज़ाती का आसा, एरुशलेम नगरी का शधाणूं अर विश्वासी टोलीए सैणैं बाखा तम्हां सोभी लै राज्ज़ी-खुशी!<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />“हाम्हैं शूणीं एही गल्‍ला कि म्हारै कई मणछ आऐ तम्हां सेटा लै अर तिन्‍नैं किऐ थारै मन्‍न गलत शिक्षा दैई उंबल़ै पर तिंयां निं हाम्हैं तम्हां सेटा लै छ़ाडै आथी। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />हाम्हैं सोभी किअ कठा हई आप्पू मांझ़ै जोग, संघा समझ़अ हाम्हैं सोभी इहअ ठीक कि हाम्हां छ़ाडणैं छ़ांटी करै धख मणछ तम्हां सेटा लै। संघा छ़ाडै हाम्हैं आपणैं पैरै भाई बरनबास अर पल़सी तम्हां सेटा लै। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ईंयां दूई मणछ आसा इहै ज़ुंणी आपणैं प्राण बी म्हारै प्रभू ईशू मसीहे नाओंआं लै खातरै दी पाऐ।<verse eid="ACT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 15:27" />“यहूदा अर सिलास बी छ़ाडै हाम्हैं तिन्‍नां संघै अर तिन्‍नां हेरनी सारी गल्‍ला आपणैं मुंहां का बी तम्हां का खोज़ी। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />पबित्र आत्मां, अर हाम्हां लागी एही ठीक कि किछ़ खास गल्‍ला छ़ाडी निं तम्हां लै होर किछ़ै बोझ़ पाणअ। <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />तिंयां गल्‍ला आसा एही कि तम्हैं रहै मुहुर्ती लै बल़ी किऐ दै मास्सा अर लोहू का अर गल़ा का मरोक्‍कै दै मास्सा का अर कंज़रैई का दूर। इना सोभी गल्‍ला का ज़ै तम्हैं दूर रहे, तै हणअ थारअ भलअ। खिरी हाम्हां सोभी बाखा तम्हां लै राज्ज़ी-खुशी।”<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="GEN 9:4">मूल. 9:4</ref>; <ref loc="LEV 3:17">लेब. 3:17</ref>; <ref loc="LEV 17:10-14">17:10-14</ref></char></note><verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />तेखअ पुजै तिंयां तिधा का बिदा हई अन्ताकिया नगरी। तेखअ पहल़ी सभा कठा करी च़िठी। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />तेखअ हुऐ तिंयां च़िठी पहल़ी करै शिक्षे गल्‍ला शूणीं खास्सै खुश। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा अर सिलास ज़ुंण आप्पू बी परमेशरे गूर तै, तिन्‍नैं बी किऐ कई गल्‍ला करै विश्वासी भाई-बैहणी शिक्षा दैई मज़बूत।<verse eid="ACT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 15:33" />तेखअ रहै तिंयां थोल़ै धैल़ै तिधी संघा छ़ाडै तिंयां विश्वासी भाई एरुशलेम टोली बर्गत अर शांती दी बापस। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />पर सिलासे मन्‍नैं बेठी एही कि तेऊ रहणअ तिधी अर यहूदा डेऊअ एरुशलेम नगरी लै। <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />पल़सी अर बरनबास रहै अन्ताकिया दी अर होर बी कई लोगा रहै प्रभूए बैणा सखाऊंदै अर खुशीए समादा खोज़दै लागी।<verse eid="ACT 15:35" /></para>
  <para style="s">बरनबास अर पल़सीओ ज़ुदअ हणअ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थोल़ै धैल़ै बाद बोलअ पल़सी बरनबासा लै, “ज़हा-ज़हा नगरी हाम्हैं परमेशरो बैण लोगा का खोज़अ द आसा, च़ाल्‍ला, हाम्हां एछणी तिन्‍नां विश्वासी भाईए हेर-सभाल़ करी कि तिंयां किहै आसा?”<verse eid="ACT 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 15:37" />तेखअ किअ बरनबासै जोहन्‍ना ज़हा लै मार्कुस बोला, संघा निंणैओ बच़ार <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />पर पल़सी किअ मार्कुस संघा निंणां लै नांईं किल्हैकि सह हुअ त पिछ़ली बारी पंफूलिआ मुल्खै पुजी ज़ुदअ अर कामां लै निं तिन्‍नां संघै डेऊअ त। <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />तिन्‍नां मांझ़ै हुई एही दूई रंगे गल्‍ला कि तिंयां हुऐ आप्पू ई मांझ़ै ज़ुदै। तेखअ डेऊअ बरनबास मार्कुसा संघा निंईं करै ज़हाज़ा दी कुप्रास टापू लै।<verse eid="ACT 15:39" /></para>
  <para style="s">खुशीए समादा खोज़णा लै पल़सीए दुजी हांढ</para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 15:40" />पर पल़सी छ़ांटअ सिलास अर होर विश्वासी भाई का परमेशरे झींण सभाल़ी करै लागअ तिधा का आजू हांढदअ। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />तेखअ डेऊअ पल़सी विश्वासीए टोली पाक्‍कै करदी, सिरीया मुल्खै अर किलकिआ मुल्खै बाती हांढ दैई।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पल़सी निंयं तिमोथी संघा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />तेखअ डेऊअ सह दिरबे अर लुस्रा नगरी बी। तिधी त एक तिमोथी नाओं एक च़ेल्‍लअ, सह थिअ एकी विश्वासी यहूदी बेटल़ीओ च़ेल्‍लअ पर तेऊओ बाब त यूनान देशो। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />तेऊओ त लुस्रा अर इकुनिम नगरीए सोभी विश्वासी भाई मांझ़ै भलअ नाअं। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पल़सी च़ाहअ इहअ कि अह निंणअ मुंह आप्पू संघै अर तिन्‍नां ज़ैगा ज़ुंण यहूदी मणछ रहा तै, तिन्‍नें तैणीं किअ पल़सी तिमोथीओ खतैर। किल्हैकि तिन्‍नां का बी त थोघ कि एऊओ बाब आसा यूनान देशो।<verse eid="ACT 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 16:4" />तिंयां रहा तै नगरी-नगरी डेऊंदी तिन्‍नां बधाना ज़ुंण एरुशलेम नगरी का शधाणूं अर विश्वासी टोलीए सैणैं ज़रूरी समझ़ै तै तिन्‍नां मनणा लै पजैल़ै लागी। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />इहअ करै रही मसीहा दी विश्वास करनै आल़ेए टोली संघै खास्सै मणछ ज़ुल़दै लागी।<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआस नगरी पल़सीओ दर्शण</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />तिंयां डेऊऐ फ्रूगिआ अर गलात मुल्खै बाती अर पबित्र आत्मां किअ तिन्‍नां लै एशिया मुल्खै बैण खोज़णा लै नांईं। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />मुसिआ नगरी नेल़ पुजी किअ तिन्‍नैं बिथूनिया नगरी लै डेऊणेओ बच़ार पर ईशूए आत्मां निं तिन्‍नां तिधा लै डेऊणैं दैनअ। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />तेखअ डेऊऐ तिंयां मुसिआ बाती हांढ दैई पुजै त्रोआस नगरी।<verse eid="ACT 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9" />पल़सी भाल़अ राची एक दर्शण कि एक मकिदुनिया मुल्खो मणछ खल़्हुअ अर तेऊ बोलअ अरज़ करी पारा बाखा होथी एछ मकिदुनिया मुल्खा लै अर म्हारी मज़त कर। <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />तेऊए दर्शणा हेरदी च़ाहअ हाम्हैं तेभी मकिदुनिया लै डेऊणअ, इहअ सोठी करै कि परमेशरै आसा हाम्हैं खुशीए समादा खोज़दै शादै दै।<verse eid="ACT 16:10" /></para>
  <para style="s">फलिप्पी गराऊंऐं; लुदिआ नाओंऐं बेटल़ीओ दिल बदल़णअ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तैही खोल्हअ हाम्हैं त्रोआस नगरी का ज़हाज़, संघा पुजै कोहरै सामोथ्रेस टापू अर दुजै धैल़ै पुजै नियापोलिस नगरी। <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />तिधा का पुजै हाम्हैं फलिप्पी नगरी ज़ुंण मकिदुनिया मुल्खै बडी नगरी आसा अर रोमी लोगो बसेरअ आसा। हाम्हैं रहै तैहा नगरी थोल़ै धैल़ै।<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />बशैघे धैल़ी डेऊऐ हाम्हैं नगरी बागै नदीए बाढै इहअ सोठी करै कि तिधी भेटणीं प्राथणां करना लै यहूदीए सभागृहा। संघा लागै तिधी नदीए बाढै बेशी तिधी ज़ुंण बेटल़ी कठा ती हुई दी तिन्‍नां संघै गल्‍ला करदै।<verse eid="ACT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14" />लुदिआ नाओंए थुआथिरा नगरीए बैंज़णीं रंगे झिकल़ै बेच़णैं आल़ी एक भगत बेटल़ी ती शूणीं लागी दी अर परमेशरै तेसो मन्‍न खोल्हअ ताकि पल़सीए गल्‍ला दी मन्‍न लाए। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />ज़ांऊं तैहा पूरै टबरा संघी आपणैं पापो प्राश्त करी पाणीं डुबकी लई, तैहा किई अरज़ कि, ज़ै तम्हैं मुंह प्रभूए विश्वासी समझ़ा, तै रहा तम्हैं मेरै घअरै। तैहा निंयैं हाम्हैं मनैऊंईं आपणैं घअरा लै।<verse eid="ACT 16:15" /></para>
  <para style="s">पल़सी अर सिलास कैद खानै दी</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />ज़ांऊं हाम्हैं प्राथणां करने ज़ैगा लै तै डेऊंदै लागै दै, तिधी भेटी हाम्हां एक ज़ुआन शोहरी ज़ुंण कसरी दासी थिई, अर तैहा दी ती एही आत्मां बस्सी दी, ज़ुंण तैहा लै आजू हणैं आल़ी गल्‍ला खोज़ा ती। तेता करै दैआ ती सह आपणैं मालका लै खास्सै ढब्बै खटी। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />सह लागी हाम्हां अर पल़सी पिछ़ू एछी लैल़ा लांदी कि ईंयां मणछ आसा परम प्रधान परमेशरे दास, ज़ुंण हाम्हां का उद्धारे कथ्या खोज़ा।<verse eid="ACT 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18" />सह रही कई धैल़ै तैणीं इहअ ई करदी लागी। पर पल़सी हुअ खास्सअ दुखी। खिरी फिरअ पल़सी पिछ़ू संघा बोलअ तैहा बेटल़ी भितरी बस्सै दै भूता लै, “हुंह बोला ताल्है, मसीहा ईशूए नाओंऐं निखल़ ऐहा बेटल़ी का पोर्ही।” सह भूत निखल़अ तेभी पोर्ही।<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />ज़ांऊं तेसे मालकै भाल़ी कि म्हारी ढब्बै-धेल्‍ले आशा बी हुई ऐबै खतम, तिन्‍नैं ढाकै पल़सी अर सिलास संघा आणै तिंयां च़फै लै अफसरा सम्हनै लै घिशी। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />तिन्‍नैं बोलअ यहूदी मणछे सैणैं सेटा डेऊई, “ईंयां लोग ज़ुंण यहूदी आसा, इनै लाअ म्हारी नगरी बडअ उल़टफेर करी। <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />इनै लाई एही गल्‍ला खोज़ी कि तिंयां मनणी अर करनी आसा रोमी लोगा लै माल़ी।”<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />ज़ांऊं तिधी कठा हुऐ दै खास्सै मणछ तिन्‍नां लै कठा हई च़िक्‍कदै आऐ, सैणैं धेल़ै तिन्‍नें झिकल़ै अर तिन्‍नां लै दैनअ शोठै करै च़िक्‍कणैओ हुकम। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />तिंयां च़िक्‍कै शोठै करै खास्सै, संघा डाहै कैद खानै गोटी। दरोगै लै डाहअ इहअ बोली कि इनो डाहै धैन। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />इहअ हुकम शूणीं डाहै दरोगै डाहै तिंयां भितरली खुडी कैद करी अर तिन्‍नें ज़ांघा डाही दुही बाखा काठा दी बान्हीं ताकि तिंयां च़ुक्‍की बी निं सके।<verse eid="ACT 16:24" /></para>
  <para style="s">सिलास अर पल़सी छ़ुटै कैद खानै का</para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />आधी राची तै लागै दै पल़सी अर सिलास परमेशरा का प्राथणां करदी भज़ना बोल्दै अर तिंयां होर कैदी तै शूणैं लागै दै। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />हेरा-हेरी हुई तिधी ज़ाज़री अर इधी तैणीं कि कैद खाने आथरी सिक्‍की आजू-पिछ़ू अर तेभी दुआर खुल्है अर सारी शांघल़ी चुटी।<verse eid="ACT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 16:27" />दरोगअ उझ़ुअ खल़अ, कैद खाने दुआर भाल़ै तेऊ घुआल़ी। तेऊ सोठअ इहअ कि तिंयां कैदी ठुर्है, तेऊ काढी तलबार अर तेऊ लाई ती आप्पू मारना लै आपणैं कैल़ै तलबारै बाही। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पर पल़सी बोलअ ज़ोरै हाक पाई, “आप्पू लै निं किछ़ करी, हाम्हैं सोभै आसा इधी।”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तेखअ शादअ कहा का तेऊ लाटू अर संघा डेऊअ भितरा लै अर काम्बदी-काम्बदी पल़अ सिलास अर पल़सीए खूरा सेटा उटी बाखा। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />तेखअ तिंयां बागा लै काढी बोलअ तेऊ दरोगै, “जनाब, हुंह किज़ै करूं कि मुंह उद्धार भेटे?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />तिन्‍नैं दैनअ तेऊ लै ज़बाब, “प्रभू ईशू मसीहा दी कर विश्वास, तै भेटणअ ताह अर तेरै घरानै उद्धार।” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />तेखअ खोज़अ तिन्‍नैं दुही दरोगै अर तेऊए सारै टबरा का परमेशरो बैण। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />राची तैहा ई घल़ी तेऊ तिंयां निंयैं अर तिन्‍नें ज़खम धोऐ अर पल़सी दैनी तिन्‍नां लै पाणीं दी डुबकी। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />तेऊ निंयैं पल़सी अर सिलास आपणैं घअरा लै संघा खैऊई तिन्‍नां का रोटी। तिंयां सोभै तै ऐहा गल्‍ला लै खुश कि तिन्‍नैं सोभी टबरै किअ परमेशरा दी विश्वास।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />ज़ांऊं दुजी धैल़ी हुई ता, सैणैं दैनअ आपणैं सपाही का समाद “तिन्‍नां मणछा छ़ाडा पोर्ही।” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />दरोगै खोज़ी ईंयां गल्‍ला पल़सी का, “सैणैं दैनअ तम्हां छ़ाडणेंओ हुकम अर ऐबै डेओआ तम्हैं शांती करै।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पर पल़सी बोलअ तेऊ लै, “तिन्‍नैं हाम्हैं रोमी मणछ बाझ़ी दोशै सोभी लोगा सम्हनै च़िक्‍कै अर कैद खानै बी पाऐ, ऐबै बोला कि च़ुप्प-च़ुप्पै डेओआ! इहअ निं हंदअ! पर तिन्‍नां बोला इहअ कि आप्पै एछा इधा लै अर तेखअ निंयां हाम्हां बागा लै!”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />तिन्‍नैं सपाही बी खोज़ी सारी गल्‍ला सैणैं सेटा, अर तिंयां इहअ शूणीं कि ईंयां आसा रोमी तिंयां डरै। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />तिंयां आऐ आप्पै अर पल़सी अर सिलास मनैऊंऐं। तेखअ किई बागै निंईं करै एही अरज़, “ऐहा नगरी का डेओआ दूर।”<verse eid="ACT 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40" />कैद खानै का छ़ुटी डेऊऐ पल़सी अर सिलास लुदिआ नाओंए विश्वासी बैहणी सेटा अर होरी विश्वासी भाई सेटा लै मिलदै तेसे घअरा लै। तिन्‍नैं दैनअ तिन्‍नां सोभी विश्वासी भाई लै हैअ कि प्रभू ईशू दी डाहा भरोस्सअ तेखअ लागै तिंयां फलिप्पी नगरी का हांढदै।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थिस्सलूणी नगरी दी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />पल़सी अर सिलास आऐ अम्फिपुलिस अर अपूलोनिया नगरी बाती थिस्सलूणी नगरी। तिधी त यहूदीए सभागृहा। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पल़सी डेऊअ तिन्‍नां सेटा लै ज़िहअ सह हर ज़ैगा बशैघे धैल़ी सभागृहा लै डेओआ त। चिई हबतै तैणीं रहअ सह तिन्‍नां संघै पबित्र शास्त्रा का सुआल-ज़बाब करदअ लागी।<verse eid="ACT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 17:3" />तिन्‍नां का समझ़ाऊई पबित्र शास्त्रा का सबूत दैई सारी गल्‍ला कि मसीहो दुख भुगतणअ, अर मरी करै ज़िऊंदै हणअ त ज़रूरी अर अह ई ईशू, ज़सरै बारै हुंह तम्हां का खोज़ा अह आसा मसीहा। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />कई यहूदी मिलै इना गल्‍ला मनी सिलास अर पल़सी संघै। होर बी कई भली भगत बडै घअरे बेटल़ी अर यूनान देशे होरी ज़ातीए परमेशरे डरा हेठै रहणैं आल़ै मणछै बी किअ विश्वास।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पर यहूदी किऐ ज़िदै मारै नभार लोगा मांझ़ै कई कदुष्ट मणछ आप्पू संघा। तिंयां लागै खास्सै मणछ कठा करी सारी नगरी हाल्‍लै-गोल्‍लै करदै। संघा जासोने घअरा फेर सोभी कठा करी च़ाहा तै तिंयां सिलास अर पल़सी बागा लै काढणअ। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />पर तिंयां निं तिन्‍नां तिधी भेटै। संघा निंयैं तिन्‍नैं जासोन अर कई विश्वासी भाई मांझ़ै घिशी तल़िंगी करै नगरीए सैणैं सेटा। तिंयां लागै ज़ोरै-ज़ोरै लैल़ा पाई इहअ बोल्दै, “ईंयां आसा तिंयां ई लोग ज़ुंणी सारै देशै आसा खरोल़ पाअ द अर ऐबै पुजै ईंयां इधी बी।<verse eid="ACT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 17:7" />“जासोनै आसा तिंयां आपणैं घअरै डाहै दै। ईंयां करा माहा राज़ेए बधानो बरोध। ईंयां बोला इहअ कि राज़अ आसा कुंण होर ईशू नाओं मणछ।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />इहअ शूणीं हुऐ नगरीए सैणैं रोश्शै लाल-पिंऊंल़ै <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />अर तिन्‍नैं डाहै जासोन अर बाकी विश्वासी भाई तेभै तैणीं कैद करी ज़ेभै तैणीं तिन्‍नें ज़मानत निं हुई।<verse eid="ACT 17:9" /></para>
  <para style="s">बिरीया नगरी दी</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />होरी विश्वासी भाई छ़ाडै तेभी राची भितरी पल़सी अर सिलास बिरीया नगरी लै अर तिंयां डेऊऐ तिधी पुजी यहूदी मणछे सभागृहा लै। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />ईंयां लोग तै थिस्सलूणी नगरी यहूदी का भलै अर बडै च़ाऊआ करै बैण मनी रहै धैल़ तिंयां पबित्र शास्त्रा दी लोल़ै-भाल़ै लागी कि ईंयां गल्‍ला शुची आसा या एथ किज़ै दोश आसा। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />तिन्‍नां मांझ़ै कई, अर यूनानी बडै घअरे बेटल़ी मांझ़ै अर मर्धा मांझ़ै किअ कई विश्वास।<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />पर ज़ांऊं थिस्सलूणी नगरी यहूदी का थोघ लागअ कि पल़सी आसा बिरीया नगरी बी लागअ द परमेशरे बैण प्रच़ारा करदअ, तिंयां आऐ तिधी बी लोगा खरोल़ पांदै अर उपद्रभ करदै। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तेखअ होरी विश्वासी भाई छ़ाडअ तेभी पल़सी तिधा का कि समुंदरे बाढै डेऊ। पर सिलास अर तिमोथी रहै तिधी बिरीया नगरी।<verse eid="ACT 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 17:15" />पल़सी संघणैं आल़ै पजैल़अ सह एथेंस नगरी तैणीं, अर सिलास अर तिमोथीए बारै इहअ बोली लागै तिधा का हांढदै कि तिन्‍नां छ़ाडै छ़ेक्‍कै मुंह सेटा लै।<verse eid="ACT 17:15" /></para>
  <para style="s">एथेंस नगरी दी</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />ज़ांऊं पल़सी एथेंस नगरी दी तिन्‍नां न्हैल़अ त लागअ द। पल़सी ज़ांऊं इहअ भाल़अ कि सारी नगरी आसा मुहुर्ती करै भर्हुई दी, सह हुअ भितरा का खास्सअ दुखी। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />पल़सी डेऊअ सभागृहा यहूदी, भगता अर तिन्‍नां लोगा सेटा ज़ुंण च़फै भेटा तै। तिन्‍नां संघै रहअ सह हर धैल़ै सुआल-ज़बाब करदअ।<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />तेखअ इपिकूरी अर स्तोईकी पंडता मांझ़ै लागै कई तेऊ संघै सुआल-ज़बाब करदै। कई बोलअ इहअ, “अह नथोघी गल्‍ला करनै आल़अ कै बोल़णअ च़ाहा?” पर होरी बोलअ इहअ, “अह ज़ाण्हिंआं हाम्हां का कहा होरी देअए बारै खोज़णैं आल़अ।” किल्हैकि पल़सी खोज़ा त लोगा का ईशू अर तेऊओ मरी करै ज़िऊंदै हणें बारै खुशीओ समाद।<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />तेखअ निंयं तिन्‍नैं पल़सी आप्पू संघै एरियोपागुस नाओंए सभागृहा लै अर संघा लागै तेऊ का पुछ़दै, “ज़ुंण तूह लोगा का इना नऊंईं गल्‍ला खोज़ा अह किज़ै आसा? एता समझ़ाऊ हाम्हां का बी। <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />तेरी ईंयां गल्‍ला आसा हाम्हां लै नुआहरी, हाम्हां का बी लोल़ी ऐहा गल्‍लो थोघ लागअ कि एतो कै मतलब आसा?” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />तिन्‍नैं बोलअ एते तैणीं कि कई एथेंस नगरी रहणैं आल़ै अर परदेसी ज़ुंण तिधी रहा तै तिंयां निं नऊंईं-नऊंईं गल्‍ला शुणनै अर बोल़णैं का सुआई होर किछ़ू कामां दी बगत काटदै तै।<verse eid="ACT 17:21" /></para>
  <para style="s">एरियोपागुस सभा दी पल़सीओ प्रच़ार</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />तेखअ पल़सी एरियोपागुस सभागृहा खल़्हुई करै बोलअ, “हे एथेंस नगरी रहणैं आल़ैओ! मुखा ज़ाण्हिंआं इहअ कि तम्हैं आसा हर गल्‍ला दी धर्म-कर्म करनै आल़ै। <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />किल्हैकि हुंह त लागअ द हांढदी-फिरदी थारी तिन्‍नां च़िज़ा भाल़अ ज़ेते तम्हैं पूज़ा करा, मुखा शुझुई एक एही बेदी, ज़हा दी इहअ आसा लिखअ द, ‘अह बेदी आसा तेऊ लै ज़हा परमेशरा हाम्हैं नांईं ज़ाणदै।’ ज़हा तम्हैं बाझ़ी ज़ाणैं भाल़ै पूज़ा, मंऐं लाई तम्हां का तेऊए बारै गल्‍ला खोज़ी।<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />“ज़ुंणी परमेशरै संसार अर तेते सोभै च़िज़ा बणाईं, सह निं स्वर्गो अर पृथूईओ मालक हई हाथा करै बणाऐं दै देहुरै रहंदअ।<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 राज़. 8:27</ref>; <ref loc="2CH 6:18">2 इति. 6:18</ref>; <ref loc="PSA 146:6">भज. 146:6</ref></char></note><verse eid="ACT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 17:25" />“नां किज़ू च़िज़े मांणै सह मणछा का मज़त च़ाहंदअ। किल्हैकि सह दैआ आप्पू ई सोभी लै ज़िन्दगी, शाह अर ज़रुरतीए सोभै गल्‍ला।<note caller="-" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="ISA 42:5">ईशा. 42:5</ref>; <ref loc="PSA 50:12">भज. 50:12</ref></char></note><verse eid="ACT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 17:26" />“तेऊ बणाईं एकी मूल़ मणछा करै सारै संसारे सोभ ज़ाती सारी पृथूई दी रहणा लै। तेऊ परमेशरै बणाऐं दै बगत अर रहणें ज़ैगा आसा तैही बान्हीं दी।<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="DEU 32:8">बधा. 32:8</ref></char></note><verse eid="ACT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 17:27" />“परमेशर च़ाहा लोगा लै इहअ कि तिंयां तेऊ दी आशा डाही करै तेऊ भाल़े अर लोल़ै लागे कि असली दी निं सह हाम्हां सोभी का दूर आथी।<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="ISA 55:6">ईशा. 55:6</ref>; <ref loc="JER 23:23">जेर. 23:23</ref></char></note><verse eid="ACT 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 17:28" />“किल्हैकि हाम्हैं रहा तेऊ ई दी ज़िऊंदै, हांढदै-फिरदै अर खल़ै टेक्‍की। तम्हां मांझ़ै आसा कई इहअ बी बोलअ द, ‘हाम्हैं आसा तेऊए ई लुआद।’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />परमेशरे लान्हैं हई आसा हाम्हां लै इहअ सोठणअ गलत कि परमेशर आसा सुन्‍नैं-रुपै अर पात्थरा दी, ज़ुंण मणछे आपणीं सोठा अर कारीगीरी करै आसा बणाऐं दै।<note caller="-" style="x"><char style="xo" closed="false">17:29 </char><char style="xt" closed="false"><ref loc="GEN 1:27">मूल. 1:27</ref>; <ref loc="ISA 40:18-20">ईशा. 40:18-20</ref>; <ref loc="ISA 44:10-17">44:10-17</ref></char></note><verse eid="ACT 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 17:30" />“तैही निं परमेशरै म्हारी बेसमझ़ीए घल़ी धैन दैनअ पर ऐबै दैआ सह सोभी मणछा लै हुकम कि तिंयां प्राश्त करी तिन्‍नें कदुष्ट काम करनै छ़ाडे। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />किल्हैकि तेऊ आसा एक धैल़ी एही डाही दी ज़ेथ परमेशरा तेऊ करै सारै संसारो शुचअ नसाफ करनअ ज़ुंण तेऊ छ़ांटअ द आसा, अर सह किअ मरी करै भिई ज़िऊंदअ अर इहअ करी किई तेऊ अह गल्‍ल सोभी लै प्रगट।”<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="PSA 9:8">भज. 9:8</ref>; <ref loc="PSA 72:2-4">72:2-4</ref>; <ref loc="PSA 96:13">96:13</ref>; <ref loc="PSA 98:9">98:9</ref>; <ref loc="ISA 2:4">ईशा. 2:4</ref></char></note><verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />मूंऐं दै मणछे ज़िऊंदै हणें गल्‍ला शूणीं लागै कई लोग हास्सदै सुहांगा करदै अर कई बोलअ इहअ, “ऐहा गल्‍ला होए शूणीं हाम्हैं ताखा केभै दुजी बारी।”<verse eid="ACT 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 17:33" />इहअ भाल़ी लागअ पल़सी तिधा का हांढदअ। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पर कई मणछै किअ प्रभू दी विश्वास अर तिंयां आऐ पल़सी संघै। तिंयां थिऐ दियोनसियास एरियोपागुस सभागृहो साझ़ू, दमरिस नाओंए एक बेटल़ी अर तिन्‍नां संघै तै होर बी कई लोग।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">करिन्थ नगरी दी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />तेखअ आअ पल़सी एथेंस नगरी छ़ाडी करिन्थ नगरी लै, <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />अर तिधी भेटअ एकी अकबिला नाओंए यहूदी का, तेऊए ज़ल्म त पुंतुस नाओंए मुल्खै हुअ द। सह त तेऊए लाल़ी प्रिस्किला संघै नऊंअ-नऊंअ इटल़ी देशा का करिन्थ नगरी लै आअ द। किल्हैकि क्लौदिउस माहा राज़ै दैनअ त सोभी यहूदी लै रोम नगरी का डेऊणेओ हुकम। पल़सी डेऊअ तिन्‍नां सेटा लै। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />अकबिला अर प्रिस्किला करा तै तरपाला बणाणैं अर बेच़णेंओ बपार अर पल़सीओ बी त अह ई बपार। एते तैणीं रहअ पल़सी तिन्‍नां संघा अर तिन्‍नैं किअ कठा काम।<verse eid="ACT 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 18:4" />हर बशैघे धैल़ै डेओआ त पल़सी यहूदी मणछे सभागृहा ज़िधी सह यहूदी अर यूनानी संघै गल्‍ला करी ईशूए बारै खोज़ा त।<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />ज़ांऊं मकिदुनिया मुल्खा का सिलास अर तिमोथी करिन्थ नगरी आऐ, पल़सी रहअ आपणैं काम छ़ाडी पबित्र आत्में साबै यहूदी मणछा का खोज़दअ लागी कि ईशू ई आसा मसीहा। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />पर ज़ांऊं यहूदी पल़सीओ बरोध अर निंदा करदै लागै, तेऊ बोलअ आपणैं झिकल़ै ठुल़्हकी करै तिन्‍नां लै, “थारअ लोहू लोल़ी थारै कैल़ै पल़अ, हुंह आसा एता का नर्दोश अर शुचअ, ऐबै डेऊणअ मुंह होरी ज़ाती सेटा लै।”<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />तिधा का आअ पल़सी तितस जस्तुस नाओंए एकी परमेशरे भगत मणछे घअरा लै तेऊओ घअर त ज़सरअ घअर सभागृहा नेल़। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />तेखअ क्रिस्पुस नाओंए सभागृहे कारदारै किअ आपणैं सारै टबरा संघी प्रभू दी विश्वास अर कई करिन्थ नगरी का आऐ दै लोगै बी किअ मसीहा दी विश्वास अर तिन्‍नैं बी बदल़अ मन्‍न संघा लई पापो प्राश्त करना लै डुबकी।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />प्रभू बोलअ राची दर्शण दैई पल़सी लै, <char style="wj">“डरै निं आथी, खुशीए समादा खोज़दअ रह लागी, च़ुप्पी निं रही।</char> <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" /><char style="wj">किल्हैकि हुंह आसा ताह संघा अर कोहै निं ताल्है हान्‍नी करी सकदअ। किल्हैकि ऐहा नगरी आसा मेरै कई भगत।”</char><note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ISA 41:10">ईशा. 41:10</ref>; <ref loc="ISA 43:5">43:5</ref>; <ref loc="JER 1:8">जेर. 1:8</ref></char></note><verse eid="ACT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 18:11" />इहअ करै रहअ पल़सी तिन्‍नां मांझ़ै परमेशरे बैणा सखाऊंदअ देहुल़ साला तैणीं।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />ज़धू गलिओ त अखाया मुल्खो राज़पाल, तधू किअ यहूदी मणछै आप्पू मांझ़ै एक्‍कअ अर तिंयां आऐ पल़सी संघै च़िखदै अर पल़सी निंयं दालता लै अर तेऊ लै लाअ इहअ दोश, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />“अह सखाऊआ लोगा का इहअ कि परमेशरे च़ाकरी करनी एऊ साबै, ज़ुंण म्हारै यहूदी बधाना का बिलकुल उंबल़ी आसा।”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />ज़ांऊं पल़सी किज़ै बोली लाअ त, गलिओ लागअ तिन्‍नां यहूदी मणछा लै इहअ बोल्दअ, “हे यहूदी मणछो, ज़ै अह बूरअ या ज़ुल्म करनै आल़अ हंदअ, तै त ठीक किई हुंह शुणदअ थारी। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पर तम्हैं आसा लागै दै बधाने बैण अर नाओंए बारै हठल़दै ज़ुंण थारै आपणैं यहूदी शास्त्रा दी आसा। तम्हैं करा एते बारै आप्पै एऊ संघै गल्‍ला, हुंह निं एतो नसाफ करी सकदअ!” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />तेखअ काढै तेऊ तिंयां दालता का बागै। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />तिन्‍नां मांझ़ै कई लोगै ढाकअ सभागृहो कारदार सोस्थिनेस अर नसाफ राज़गाद्दी सम्हनै च़िक्‍कअ बी। पर गलिओ निं इना गल्‍ले किछ़ै फिकर किई।<verse eid="ACT 18:17" /></para>
  <para style="s">अन्ताकिया लै बापस फिरनअ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />पल़सी रहअ करिन्थ नगरी खास्सै धैल़ै अर होरी विश्वासी भाई का बिदा हई आअ किंखिया नगरी। तिधी छाम्बअ तेऊ आपणअ मूंड, किल्हैकि तेऊ ती तेते मानत मनी दी। तिधा का डेऊअ सह ज़हाज़ा दी बेशी सिरीया मुल्खा लै अर तेऊ संघै तै प्रिस्किला अर अकबिला बी।<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">गण. 6:18</ref></char></note><verse eid="ACT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 18:19" />पल़सी छ़ाडै प्रिस्किला अर अकबिला इफिसुस नगरी पुजी तिधी अर आप्पू लागअ सभागृहा डेऊई यहूदी मणछा का ईशूए बारै खोज़दअ। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />ज़ांऊं तिन्‍नैं पल़सी सेटा अरज़ करदै लागै थोल़ै धैल़ै दै हाम्हां सेटा रहणैं पर पल़सी किअ नांईं। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />पर तिन्‍नां लै इहअ बोली लागअ सह तिधा का हांढदअ, “ज़ै परमेशर च़ाहे तै एछणअ हुंह तम्हां सेटा लै फिरी।” <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />तेखअ पुजअ पल़सी इफिसुस नगरी का ज़हाज़ खोल्ही करै अर कैसरिया मुल्खै, संघा डेऊअ एरुशलेम नगरी लै अर विश्वासीए टोली लै राज्ज़ी-खुशी दैई आअ अन्ताकिया नगरी लै।<verse eid="ACT 18:22" /></para>
  <para style="s">खुशीए समादा खोज़णा लै पल़सीए चिऊथी हांढ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />तेखअ थोल़ै धैल़ै तिधी रही डेऊअ तिधा का अर एकी बाखा गलात अर फ्रूगिआ मुल्खै, संघा लागअ च़ेल्‍लै लै हैअ दैई आजू हांढदअ।<verse eid="ACT 18:23" /></para>
  <para style="s">इफिसुस नगरी दी अपूलोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />अपूलोस नाओं एक यहूदी आअ इफिसुस नगरी लै, ज़ुंण सकंदरीआ नगरी दी त पैईदा हुअ द, सह थिअ पबित्र शास्त्रो ज़ाणकार। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />तेऊ का थिअ थोघ कि प्रभू सेटा डेऊणे असली बात कुंण आसा अर सह खोज़ा त मन्‍न लाई करै प्रभू ईशूए बारै ठीक-ठीक, अर सखाऊआ बी त, पर तेऊ का थिअ सिधअ जोहन्‍ने पाणीं दी डुबकी दैणें बारै ज़ाणकारी। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />सह लागअ यहूदी सभागृहा नडरै हई बोल्दअ। पर तेऊए गल्‍ला शूणीं आणअ सह प्रिस्किला अर अकबिला आप्पू सेटा लै अर परमेशरे गल्‍ला समझ़ाऊई तेऊ का होर बी राम्बल़ै करै।<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />ज़ांऊं अपूलोसै पारा बाखा होथी अखाया लै डेऊणेओ बच़ार किअ, होरी विश्वासी भाई लिखी हैअ दैई यूनान रहणैं आल़ै विश्वासी च़ेल्‍लै लै च़िठी कि एऊ संघै मिलै शोभलै करै। तेऊ किई तिधी पुजी तिन्‍नें खास्सी मज़त, ज़ुंणी जशा दी विश्वास किअ त। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />किल्हैकि अपूलोस दैआ त पबित्र शास्त्रा का यहूदी लै सबूत कि ईशू मसीहा ई आसा मसीहा, ज़ेभै सह शास्त्र पहल़ा त, लोगा का निं तेतो कोई ज़बाब हंदअ त।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">इफिसुस नगरी जोहन्‍ने च़ेल्‍लै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />ज़ेभै अपूलोस करिन्थ नगरी त, पल़सी पुजअ उझै फ्रूगिआ गलात मुल्खै सारै सराज़ै हांढी एशिया बाती इफिसुस नगरी। तिधी भेटे तेऊ कई च़ेल्‍लै इहै तिन्‍नैं बोलअ, “हाम्हैं बी आसा विश्वासी।” <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />पल़सी पुछ़अ तिन्‍नां का, “ज़ेभै तम्हैं परमेशरे खुशीए समादा दी विश्वास किअ तेभै तम्हां पबित्र आत्मां आअ?” तिन्‍नैं किई इहअ बोली नांह,</para>
  <para style="p" vid="ACT 19:2">“हाम्हैं निं पबित्र आत्में बारै शूणअ द बी आथी।” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />पल़सी बोलअ तिन्‍नां लै, “तै ज़ेभै तम्हैं पाणीं दी डुबकी लई तेते बारै तम्हैं किज़ै समझ़ा?”</para>
  <para style="p" vid="ACT 19:3">तिन्‍नैं दैनअ ज़बाब, “हाम्हैं करा तिन्‍नां गल्‍ला दी विश्वास ज़ुंण जोहन्‍ना डुबकी दैणैं आल़ै आसा खोज़अ द।” <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />तेखअ समझ़ाऊऐ तिंयां पल़सी, “जोहन्‍ना दैनी इहअ बोली पापो प्राश्त करने डुबकी कि ज़ुंण तेऊ बाद आसा एछणैं आल़अ, मतलब मसीहा प्रभू ईशू दी करै विश्वास।”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />इहअ शूणीं लई तिन्‍नैं प्रभू ईशूए नाओंऐं पाणीं दी डुबकी। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />ज़ांऊं पल़सी तिन्‍नां दी हाथ डाहै, तिन्‍नां लै आअ पबित्र आत्मां अर तिंयां लागै कई बोली बोल्दै अर आजू हणैं आल़ी गल्‍ला प्रगट करदै। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ईंयां सोभै तै कोई बारा मणछ।<verse eid="ACT 19:7" /></para>
  <para style="s">इफिसुस नगरी दी पल़सीए च़ाकरी</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पल़सी रहअ सभागृहा डेऊई चिई भिन्‍नैं तैणीं नडरै हई बोल्दअ लागी अर परमेशरे राज़े बारै खोज़दअ अर समझ़ाऊंदअ लागी। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />पर ज़ांऊं कई लोगै काठै हई तेऊए नांईं शूणीं अर लोगा नदरी इहअ बोल्दै लागै कि एऊए बात आसा बूरी, पल़सी किऐ तिन्‍नां छ़ाडी च़ेल्‍लै ज़ुदै अर हर धैल़ै करा त तरन्‍नुसे सभा दी ईशूए बारै सुआल-ज़बाब। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />दूई साला तैणीं रहअ इहअ ई हंदअ लागी, इधी तैणीं कि एशिया मुल्खै रहणैं आल़ै कै यहूदी, कै यूनानी, सोभी शूणअ प्रभूओ समाद।<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />परमेशर रहैऊआ त पल़सी करै शगतीए बडै-बडै काम। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />इधी तैणीं कि शाट्टै अर गाची निंयां तै लोग तेऊए देही का छुंआऊंई करै अर तिन्‍नां पाआ तै बमारा प्रैंदै अर तिंयां हआ तै सोभी रोगा का नरोगै अर दूत-भूता का आज़ाद।<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />पर कई यहूदी ज़ुंण ज़ादू करदै फिरा तै तिंयां बी लागै तै इहअ करदै कि ज़हा दी भूत होए तिन्‍नां लै प्रभू ईशूओ नाओं लई करै इहअ बोली मारा तै फूक, “ज़हा ईशूए बारै पल़सी खोज़ा, तेऊए नाओंऐं दैआ हुंह ताल्है हुकम कि दूर हअ।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />एक थिअ सकीबा नाओं यहूदी अर सह बोला त आप्पू लै बडअ प्रोहत, तेऊए तै सात शोहरू अर तिंयां बी करा तै इहअ ई। <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />पर भूतै दैनअ तिन्‍नां लै ज़बाब, “मुखा आसा ईशूओ थोघ अर पल़सी बी बछ़ैणा हुंह, पर तम्हैं कुंण आसा?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />तेऊ मणछा ज़हा दी भूत तै शाचै दै, तेऊ दैनी तिन्‍नां प्रैंदै एही छ़ाहल़ा कि तिंयां किऐ आपणैं बशै अर इहअ उपद्रभ किअ तिन्‍नां लै कि तिंयां ठुर्है नांगै अर मूंड माथै फाल़ी तेऊ घअरा का पोर्ही।<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />ऐहा गल्‍लो थोघ लागअ इफिसुस नगरी दी रहणैं आल़ै यूनानी अर यहूदी सोभी का। तिंयां डरै अर प्रभू ईशूओ नाअं लागअ बढदअ।<verse eid="ACT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 19:18" />तिन्‍नां मांझ़ै किअ कई विश्वास बी, अर तिन्‍नां मांझ़ै आऐ कई अर तिन्‍नैं बोलअ सोभी नदरी इहअ कि हाम्हैं तै आप्पू बी एऊ ई कामां दी लागै दै। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />ज़ादू करनै आल़ै कई मणछै झाल़ी आपणीं बही-पोथी संघा चैल़ी सोभी नदरी तेथ आग। ज़ांऊं तिन्‍नें किम्मत ज़ोल़ी, सह निखल़ी कोई पज़ाह हज़ार च़ंदीए सिक्‍कै बराबर। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />इहअ करै शूणअ खास्सै मणछै प्रभू ईशूओ बैण अर खास्सै मणछै किअ विश्वास।<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />ज़ांऊं पल़सी इफिसुस नगरी आपणअ काम पूरअ करी मुक्‍कअ, पल़सी किअ आपणैं मन्‍नैं बच़ार कि मकिदुनिया अर अखाया मुल्खै डेऊई लणअ पैहलै तिधे विश्वासी भाई सेटा पुजी। तेऊ बोलअ इहअ, “एरुशलेम डेऊई आसा मुंह रोम बी डेऊणअ ज़रूरी।” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />आपणैं दूई साथी तिमोथी अर इरास्तुस छ़ाडै पल़सी मकिदुनिया अर आप्पू रहअ थोल़ै धैल़ै एशिया मुल्खै।<verse eid="ACT 19:22" /></para>
  <para style="s">इफिसुस नगरी उपद्रभ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />तिन्‍नां धैल़ै हुअ तिधी पंथे बारै खास्सअ उपद्रभ। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />किल्हैकि तिन्‍नां धैल़ै दिमेत्रियुस नाओं एक सनार। सह दैआ त अरतिमिस देबीए च़ंदीए देहुरै बणाईं कारीगीरा लै खास्सअ काम। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तेऊ किऐ एऊ कामां करनै आल़ै सोभै कारीगीर कठा संघा बोलअ तिन्‍नां लै,</para>
  <para style="p" vid="ACT 19:25">“हे मणछो, तम्हां का आसा थोघ कि एऊ कामां करी हआ म्हारी खास्सी कमाई।<verse eid="ACT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 19:26" />“तम्हैं भाल़ा बी अर शूणां बी कि सिधअ इफिसुस नगरी ई निं, पर सारै एशिया दी पाऐ एऊ पल़सी खास्सै मणछ इहअ शकाऊई करै कबाता, ‘ज़ुंण च़िज़ा कुंण कारीगीर हाथा करै बणाआं सह निं परमेशर हंदअ।’ <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />ऐबै निं हाम्हां सिधी ऐहा गल्‍ले डअर आथी कि म्हारअ ढब्बै खटणैओ धांधअ हणअ खतम। पर डअर आसा एही बी कि म्हारी महान अरतिमिस देबीए देहुरे बी निं लोगा कदर करनी। ज़हा देबी सारै एशिया मुल्खै अर संसारे कई लोग पूज़ा। इहअ करै निं एऊ देहुरे बी कोई कदर हणीं।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />तिंयां भर्हुऐ इहअ शूणीं रोश्शै अर लैल़ा पाई लागै बोल्दै, “इफिसुस नगरी रहणैं आल़ै मणछे देबी अरतिमिस आसा बडी!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />सारी नगरी मच़अ खास्सअ हाल्‍लअ-गोल्‍लअ अर तिन्‍नैं लोगै ढाकै गयुस अर मकिदुनिया मुल्खो अरिस्तखोरस ज़ुंण पल़सीए साथी-संघी थिऐ। तिंयां निंयैं तिन्‍नैं घिशी करै अर सोभ ठुर्है एक मन्‍न बणाईं करै रंगशाल़ा दी।<verse eid="ACT 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 19:30" />ज़ांऊं पल़सी लोगा सेटा लै भितरा लै डेऊणअ च़ाहअ, होरी च़ेल्‍लै निं तेऊ डेऊणैं दैनी। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />सैणैं मांझ़ै ज़ुंण पल़सीए कई साथी तै तिन्‍नैं बी दैनअ तेऊ लै समाद अर तिन्‍नैं किई एही अरज़ कि रंगशाल़ा लै डेऊई निं खातरै दी पल़ी।<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />पर तिन्‍नां खास्सै मणछे जेल्ह-मरेल्ही मांझ़ा का लागै कोई किछ़ बोल्दै अर कोई किछ़ लैल़ा लांदै। सभा दी थिऐ लोग डरै दै अर कई लोगा का निं इहअ थोघ बी आथी त कि हाम्हैं इधी कठा किल्है आसा हुऐ दै। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />तिधी थिअ लोगा जैंदरी एक यहूदी मणछ, तेऊ नाअं त सकंदर। यहूदी निंयं सह लोगा जैंदरा का आजू लै घिशी। सकंदरै किअ आपणअ हाथ खल़अ करी लोगा लै शारअ कि तिंयां च़ुप्पी रहे, संघा च़ाहा त सह इहअ बोल़णअ कि तेऊ अर तेऊए यहूदी साथी निं किछ़ै बूरअ किअ।<verse eid="ACT 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 19:34" />पर ज़ांऊं तिन्‍नां का थोघ लागअ कि अह आसा यहूदी, तिंयां सोभ रहै कोई खास्सी घल़ी कोई एकी पहरै तैणीं एकी बोला दी लैल़ा लांदै लागी, “इफिसुस नगरी रहणैं आल़ै मणछे देबी अरतिमिस आसा महान!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />नगरीए बज़ीरै किऐ तेखअ लोग शांत, संघा बोलअ तिन्‍नां लै इहअ, “हे इफिसुस नगरी रहणैं आल़ै लोगो, ऐहा गल्‍लो आसा सोभी का थोघ कि सारी इफिसुस नगरी आसा म्हारी बडी देबी अरतिमिस देबीए देहुरै अर ज्यूस देअए सरगा का पल़ी दी मुहुर्तीए च़ाकरी करनै आल़ै। <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />ज़ै सोभी का थोघ आसा, तै निं इना गल्‍ला कोहै झ़ुठअ बोली सकदअ। एता लै आसा इहअ ई ठीक कि तम्हैं रहा च़ुप्पी अर हर गल्‍ला करनी सोठी-समझ़ी। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />किल्हैकि तम्हैं ज़ुंण ईंयां मणछ ढाकी आसा आणै दै, ईंयां नां देहुरै लुटणैं आल़ै आथी, अर नां म्हारी देबीए निंदा करदै।<verse eid="ACT 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 19:38" />“ज़ै दिमेत्रियुस अर तेऊए साथी कारीगीरा कहा संघै झ़गल़अ आसा होए, तेता लै आसा दालता खुल्ही दी, अर पांच़ बी आसा, अर तिंयां सका एकी-दुजैओ दोश खोज़ी। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पर ज़ै तम्हैं किज़ू होरी गल्‍ले बारै च़ाहा पुछ़णअ, तेतो फैंसलअ हणअ सभा दी। <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />किल्हैकि आझ़कै एऊ हाल्‍लै-गोल्‍लै हणें बारै सका हाम्हां लै बी दोश लागी। किल्हैकि एतो निं कोई कारण ई आथी अर हाम्हैं निं एऊ झाल़ै कठा हणैंओ बी कोई ज़बाब दैई सकदै।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />इहअ बोली किई तेऊ सभा बिदा।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकिदुनिया, यूनान अर त्रोआस नगरी पल़सी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />ज़ांऊं इफिसुस नगरी लोगो हाल्‍लअ-गोल्‍लअ शांत हुअ, पल़सी शादै आपणैं च़ेल्‍लै अर तिंयां समझ़ाऊऐ इहै कि प्रभू दी डाहै भरोस्सअ। तेखअ तिन्‍नां का बिदा हई डेऊअ सह मकिदुनिया मुल्खा लै।<verse eid="ACT 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 20:2" />तेऊ सारै मुल्खै हांढ दैई अर तिन्‍नां सोभी च़ेल्‍लै खास्सअ समझ़ाऊई करै आअ दखण यूनान अखाया मुल्खा लै। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />ज़ांऊं चिई भिन्‍नैं तिधी रही सह ज़हाज़ा दी बेशी सिरीया मुल्खा बाखा डेऊणैं आल़अ त, यहूदी रहै तेऊ लै मारना लै ताखुई, अर तैही किई तेऊ एही सलाह कि हुंह एछूं मकिदुनिया मुल्खै बाखा हांढ दैई फिरनअ बापस।<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />बिरीया नगरीए पुरुस नाओंए मणछो शोहरू सोपत्रुस, थिस्सलूणी नगरीए अरिस्तखोरस अर सिकुन्दुस, दिरबे नगरी का गयुस, तिमोथी अर एशिया का तुखिकुस अर त्रोफिमस आऐ तेऊ संघै एशिया तैणीं। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />तिंयां रहै आजू डेऊई त्रोआस नगरी हाम्हां न्हैल़ै लागी। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />हाम्हैं पुजै आखरी रोटीए थैरा बाद फलिप्पी नगरी का ज़हाज़ा दी बेशी पांज़ूऐ धैल़ै तिन्‍नां सेटा त्रोआस अर साता धैल़ै रहै तिधी।<verse eid="ACT 20:6" /></para>
  <para style="s">त्रोआस नगरी मूंअ द मणछ ज़िऊंदअ करनअ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />हबते पैहली धैल़ी ज़ांऊं हाम्हैं प्रभू भोज़ा लै कठा हुऐ, पल़सी रहअ आधी राची तैणीं तिन्‍नां मांझ़ै शिक्षा दैंदअ लागी, किल्हैकि तिन्‍नों दुजै धैल़ै आजू डेऊणेओ बच़ार। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />ज़हा आटल़ू हाम्हैं बेठै दै थिऐ, तेथ तै खास्सै लाटू लागै दै ज़ल़दै।<verse eid="ACT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 20:9" />यूतिकुस नाओं एक ज़ुआन त ताक्‍की दी बेठअ द अर तेऊ ती निंजा करै उंघी लागी दी, अर ज़ांऊं पल़सी खास्सी घल़ी गल्‍ला करदअ रहअ, तेऊ आअ निंजो झ़लारअ अर चिऊथी मज़ला का पल़अ सह खोल़ै लै अर सह च़कअ मूंअ द धरना का। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />पल़सी होथअ उंधै अर तेऊ लै दैनी मल़्हैची संघा बोलअ, “डरा निं आथी अह निं मूंअ, अह आसा ज़िऊंदअ।”<verse eid="ACT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 20:11" />तेखअ खाअ उझै डेऊई प्रभू भोज़ अर ज़ेतरी घल़ी तिन्‍नां संघै गल्‍ला करदअ त लागअ द, तेतरी गई राच भैई अर पल़सी लागअ हांढदअ। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />तिन्‍नैं आणअ सह शोहरू घअरा लै तेऊ शोहरू ज़िऊंदै भाल़ी फिरअ तिन्‍नां सोभी शाह अर तिंयां हुऐ खुश।<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआस नगरी का मिलेतुस टापूए हांढ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />हाम्हैं डेऊऐ पैहलै तेऊ ज़हाज़ा दी बेशी अस्सुस नगरी लै डेऊणे बच़ारा दी आजू कि तिधा का बशैल़णअ पल़सी। किल्हैकि तेऊ बोलअ त इहअ कि तिधी तैणीं डेऊणअ तेऊ आपणीं ज़ांघा हांढी। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />ज़ांऊं पल़सी अस्सुस नगरी भेटअ, हाम्हैं बशैल़अ सह ज़हाज़ा दी संघा पुजै मितिलीन नगरी।<verse eid="ACT 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 20:15" />तिधा का ज़हाज़ खोल्ही करै हाम्हैं दुजै धैल़ै पुजै किआस नगरी सम्हनै, अर आगलै धैल़ै पुजै सामोस नगरी अर तेखअ पुजै तिधा का दुजै धैल़ै मिलेतुस टापू।<verse eid="ACT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 20:16" />किल्हैकि पल़सी थिई आप्पू एही डाही दी कि तेऊ डेऊणअ इफिसुस नगरी बाती। इहअ निं हआ कि एशिया दी तेऊ बल़ैग पल़े, किल्हैकि तेऊ हआ त छ़ेक्‍कअ लागअ द कि हई सके, पिन्तेकुस्त धैल़ै काटणै तेऊ एरुशलेम नगरी।<verse eid="ACT 20:16" /></para>
  <para style="s">इफिसुस नगरीए विश्वासी टोलीए सैणैं लै शिक्षा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />मिलेतुस टापू का शादै पल़सी इफिसुस नगरी लै समाद दैई विश्वासी टोलीए सैणैं।<verse eid="ACT 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 20:18" />ज़ांऊं तिंयां तेऊ सेटा लै आऐ, तेऊ बोलअ तिन्‍नां का, “तम्हां का आसा थोघ कि ज़हा धैल़ी हुंह एशिया मुल्खै पुजअ, हुंह हर बगत तम्हां संघै किहअ रहअ। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />हुंह रहअ बडै मानदारी दी धैल़ लेरा लाई आशू बहाऊई-बहाऊई करै बी तिन्‍नां खरी मांझ़ै बी ज़ुंण यहूदी मणछे बूरी च़ाल्‍ला करै मुंह प्रैंदै आई ती, प्रभूए च़ाकरी करदअ ई लागी। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />ज़ुंण-ज़ुंण गल्‍ला थारी भलाईए ती, तिन्‍नां खोज़णैं अर लोगे सम्हनै घअरै-घअरै सखाऊंणै का निं हुंह पिछ़ू हटअ। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />पर यहूदी अर यूनानी सेटा रहअ शाजत दैंदअ लागी कि पापो प्राश्त करी फिरा परमेशरा बाखा, संघा करा म्हारै प्रभू ईशू मसीहा दी विश्वास।<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“एभै भाल़ा, हुंह च़ाल्‍लअ एरुशलेम नगरी लै डेऊई, किल्हैकि पबित्र आत्मां रहैऊअ मुखा साफ-साफ कि मेरअ आसा तिधा लै डेऊणअ ज़रूरी अर मुखा निं थोघै कि तिधी मुंह संघै कै हणअ? <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />मुखा आसा सिधअ इहअ थोघ कि पबित्र आत्मां बोला मुल्है हर नगरी दी शाजत दैई इहअ कि ताल्है आसा दुख-सांगट शांघल़ी लोहै तैर। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />पर हुंह निं आपणैं प्राणा किछ़ै समझ़दअ कि झ़ूरी करूं, पर इहअ कि आपणीं ठुहर अर च़ाकरी पूरी करूं, ज़ुंण मुंह परमेशरे जशे खुशीए समादे शाजत दैणा लै प्रभू ईशू का आसा भेटी दी।<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“पर ऐबै भाल़ा, मुखा आसा थोघ कि तम्हां सोभी ज़हा का हुंह परमेशरे राज़ो प्रच़ार किअ, ऐबै निं तेखअ तम्हां मेरअ मुंह भिई भाल़णअ भेटणअ। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />तैही बोला हुंह आझ़ तम्हां लै इहअ, ज़ै कुंण मसीहा दी विश्वास किऐ बगैर, मुंह निं तेतो किछ़ै पाप-दोश। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />किल्हैकि मंऐं खोज़ी तम्हां का तिंयां सोभै गल्‍ला ज़ुंण परमेशरै आसा हाम्हां लै सोठी डाही दी।<verse eid="ACT 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28" />“इहअ करै आपणीं अर आपणैं पूरै छ़ुंडे करै हेर-सभाल़। ज़हा दी पबित्र आत्मां तम्हैं सैणैं आसा बणाऐं दै। कि तम्हैं करै परमेशरे टोलीए हेर-सभाल़, ज़ुंण तेऊ आपणैं लोहू करै मोल आसा लई दी।<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="PSA 74:2">भज. 74:2</ref></char></note><verse eid="ACT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 20:29" />“मुखा इहअ बी आसा थोघ कि मुंह डेऊणैं बाद एछणैं तम्हां लै धेल़णै-च़िरनैं आल़ै रुहलै, तिन्‍नां निं अह छ़ुंड बी छ़ाडणअ। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />तम्हां ई मांझ़ा का उझ़णै कई इहै तिन्‍नां दैणीं उंबल़ी शिक्षा अर तम्हां ई मांझ़ा का बणाणैं तिन्‍नां आपणैं च़ेल्‍लै। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />चतैन रहै अर ऐहा गल्‍ला डाहै आद कि मंऐं आसा चिई साला तैणीं राची धैल़ी लेरा लाई-लाई करै एकी-एकी लै चतैनगी दैनी दी।<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“ऐबै लाऐ मंऐं तम्हैं परमेशर अर तेऊए जशे समादा का सभाल़ी ज़ुंण थारी बढोतरी सका करी, अर परमेशरे झींणा करै भेटणीं तम्हां तिंयां सोभै गल्‍ला ज़ेतो तेऊ आपणैं लोगा दैणीं आसा किई दी।<verse eid="ACT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33" />“मंऐं निं कोहिए सुन्‍नैं-च़ंदीओ अर झिकल़ैओ मांण किअ।<note caller="-" style="x"><char style="xo" closed="false">20:33 </char><char style="xt" closed="false"><ref loc="1SA 12:3">1 शमू. 12:3</ref></char></note> <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तम्हां का आसा थोघ कि मेरै इनै हाथै किई मेरी अर मेरै होरी साथीए ज़रुरत पूरी। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />इहअ करै रहैऊअ मंऐं इहअ कि तम्हां केही ज़िन्दगी लागा ज़िऊंणीं। तम्हां लागा खास्सी मैन्थ करनी ताकि तम्हैं रोगी अर रैनै-गरीबे मज़त करी सके। तम्हैं डाहणीं अह गल्‍ला आद कि मसीहा प्रभू ईशू आसा आप्पै इहअ बोलअ द, <char style="wj">‘मांगणै का आसा दैणअ भलअ।’”</char><verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />इहअ बोली तेऊ ज़ान्हूं टेक्‍कै अर तिन्‍नां सोभी लै किई कठा प्राथणां। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />तेखअ लाई तिन्‍नैं सोभी लेरा अर पल़सीए गल़ै मल़्हैची दैई लागै तिंयां तेऊ लै मल़्हैची दैंदै। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />तिन्‍नां हुअ खासकर ऐहा गल्‍लो दुख ज़ुंण तेऊ बोलअ त कि तम्हां निं मेरअ मुंह भिई भाल़णअ भेटणअ, अर तिन्‍नैं दैनअ सह ज़हाज़ा तैणीं संघी।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पल़सीओ एरुशलेम नगरी लै डेऊणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />ज़ांऊं हाम्हां तिन्‍नां का बिदा हई ज़हाज़ खोल्हअ, तेखअ पुजै आज़री बात ढाकी हाम्हैं कोआस टापू ज़िधी हाम्हैं ज़हाज़ खल़अ किअ अर दुजै धैल़ै रुदूस टापू अर तिधा का पुजै पतरा टापू अर सह ज़हाज़ त तिधी तैणीं। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />पतरा नगरी छ़ाडअ हाम्हैं सह ज़हाज़, कुंणी होरी खोज़अ हाम्हां का कि एक ज़हाज़ डेऊणअ इधा का फिनाका नगरी लै। तेखअ बेठै हाम्हैं आजू डेऊणा लै तेऊ ज़हाज़ा दी।<verse eid="ACT 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 21:3" />ज़ांऊं कुप्रास टापू शुझुअ, सह छ़ाडअ हाम्हैं बाऊंईं बाखा, अर सिरीया मुल्खा बाखा डेऊई होथै हाम्हैं सूर नगरी। किल्हैकि तिधी करनअ त ज़हाज़ो बोझ़ हल़कअ।<verse eid="ACT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 21:4" />तिधी किअ हाम्हैं विश्वासी भाईओ थोघ संघा रहै हाम्हैं तिधी सात धैल़ै। पबित्र आत्मां का शूणीं रहै तिंयां भिई-भिई पल़सी लै इहअ बोल्दै लागी कि एरुशलेम नगरी निं डेऊई।<verse eid="ACT 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 21:5" />ज़ांऊं तिंयां सात धैल़ै पूरै हुऐ, हाम्हैं लागै तिधा का हांढदै, अर बेटल़ी माठै संघी दैनै हाम्हैं नगरी बागै पजैल़ी अर हाम्हैं किई समुंदरे बाढै ज़ान्हूं टेक्‍की करै प्राथणां। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />तेखअ एकी-दुजै का बिदा हई करै, हाम्हैं, उखल़ै ज़हाज़ा दी अर तिंयां डेऊऐ आपणैं-आपणैं घअरा लै।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />सूर टापू का पाणींए बात पूरी करी पुजै पतलमिस नगरी। तिधी थिऐ विश्वासी भाई अर तैहा राची रहै हाम्हैं तिन्‍नां संघै तिधी। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />दुजै धैल़ै आऐ हाम्हैं तिधा का कैसरिया नगरी लै। तिधी रहै हाम्हैं खास्सै धैल़ै फलिप्प खुशीओ समाद प्रच़ार करनै आल़ेए घअरै ज़ुंण तिन्‍नां साता दास मांझ़ै एक त। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />तेऊए ती च़ार कुंआरी शोहरी तिंयां करा ती आजू हणैं आल़ी गल्‍ला प्रगट।<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="JOL 2:28">जोए. 2:28</ref></char></note><verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />ज़ांऊं हाम्हां तिधी खास्सै धैल़ै हुऐ, एक अगबुस नाओं परमेशरो गूर आअ यहूदा मुल्खा का। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />सह आअ हाम्हां सेटा लै संघा तेऊ पल़सीओ गाचू च़कअ अर आपणैं हाथ खूर बान्हीं बोलअ, “पबित्र आत्मां बोला इहअ, ‘ज़सरअ अह गाचू आसा, सह बान्हणअ एरुशलेम नगरी यहूदी इहअ ई करै, अर सह दैणअ तिन्‍नां होरी ज़ातीए हाथै।’”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />ज़ांऊं हाम्हैं ईंयां गल्‍ला शूणीं, हाम्हैं सोभी बोला पल़सी लै इहअ, “एरुशलेम नगरी लै निं डेऊई।”<verse eid="ACT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 21:13" />पर पल़सी दैनअ ज़बाब, “तम्हैं किल्है लाअ इहअ करी कि रोक्‍की करै लाअ मेरअ मन्‍न चोल़ी। हुंह आसा प्रभू ईशूए नाओंए एरुशलेम नगरी, नां सिधअ बान्हणां लै पर मरना लै बी तैर।” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />ज़ांऊं तिन्‍नें गल्‍ल तेऊ नांईं मनी, इहअ बोली हुऐ तिंयां च़ुप्पी, “प्रभूए मरज़ी लोल़ी पूरी हुई।”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />तिन्‍नां धैल़ै बाद डेऊऐ हाम्हैं आपणैं बोझ़ल़ै बान्हीं एरुशलेम नगरी लै। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />कैसरिया मुल्खा का आऐ कई च़ेल्‍लै हाम्हां संघै, तिन्‍नैं पजैल़ै हाम्हैं मनसोन नाओंए एकी विश्वासीए घअरै। मनसोन आसा त कुप्रास टापू का अर मसीहो पराणअ विश्वासी।<verse eid="ACT 21:16" /></para>
  <para style="s">पल़सीए याकबा संघै मुलाकात</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />ज़ांऊं हाम्हैं एरुशलेम पुजै, विश्वासी भाई मिलै हाम्हां संघै बडै नंद अर खुशी-खुशी।<verse eid="ACT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 21:18" />दुजै धैल़ै निंयैं पल़सी हाम्हैं याकबा सेटा लै, तिधी थिऐ सोभै विश्वासी टोलीए सैणैं कठा हुऐ दै।<verse eid="ACT 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 21:19" />तेखअ तेऊ तिन्‍नां लै राज्ज़ी-खुशी दैई ज़ुंण-ज़ुंण काम परमेशरै तेऊए च़ाकरी दी होरी ज़ाती मांझ़ै किऐ, तिंयां खोज़ै एक-एक करी तिन्‍नां सोभी का।<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />ज़ांऊं सैणैं पल़सीए गल्‍ला शूणीं, तिन्‍नैं किई परमेशरे ज़ै-ज़ैकार। तेखअ बोलअ इहअ, “भाई पल़सी, ताखा आसा शुझदअ लागअ द कि, एथ हुऐ खास्सै यहूदी ज़ुंणीं ईशू दी विश्वास किअ। पर तिंयां मना मोसा गूरे बधाना बी तत्त-दिला का। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />यहूदी शूणअ इहअ कि तूह करा होरी देशै बस्सै दै यहूदी जैंदरी इहअ प्रच़ार कि तिन्‍नां निं मोसा गूरे बधाना मनणे ज़रुरत आथी, नां आपणैं शोहरूओ खतैर करने ज़रुरत आथी अर नां यहूदी रिती-रबाज़ा मनणे ज़रुरत आथी। <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />लोगा का जाणअ थोघ लागी कि तूह आसा इधी आअ द।<verse eid="ACT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 21:23" />“तैही ज़ुंण हाम्हैं ताल्है करना लै बोला, तूह कर तिहअ। हाम्हां सेटा आसा इधी च़ार मणछ ज़ुंणी मानत आसा मनी दी। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />तिन्‍नां संघा निंईं करै कर आप्पू शुचै अर तिन्‍नां लै कर खर्च़अ कि तिंयां आपणअ मुंडन करे, तेखअ लागणअ सोभी का थोघ कि ज़ुंण गल्‍ला तेरै बारै बोली दी आसा, तिंयां आसा झ़ुठी। पर तूह आप्पू बी मना बधान अर तिन्‍नां दी च़ला बी।<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="NUM 6:5">गण. 6:5</ref>,<ref loc="NUM 6:13-18">13-18</ref>,<ref loc="NUM 6:21">21</ref></char></note><verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />“पर तिन्‍नां होरी ज़ातीए बारै ज़ुंणी विश्वास किअ, हाम्हैं दैनअ इहअ फैंसलअ करी तिन्‍नां लै इहअ समाद लिखी कि तिंयां मुहुर्ती लै बल़ी किऐ दै मास्सा अर लोहू का अर गल़ा का मरोक्‍कै दै मास्सा का अर कंज़रैई का रहै दूर।”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />तेखअ डेऊअ पल़सी दुजै धैल़ै तिन्‍नां होरी संघै परमेशर भबना लै। तिंयां तै बधाने साबै आपणीं शुधी करदै लागै दै, तिधी खोज़अ पल़सी सोभी नदरी कि तिन्‍नें मानत कधू हणीं पूरी ज़हा धैल़ी तिन्‍नां बिधाते भबनै भैंट दैणीं।<note caller="-" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">गण. 6:13-21</ref></char></note><verse eid="ACT 21:26" /></para>
  <para style="s">भबनै पल़सी ढाकणअ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />ज़ांऊं सात धैल़ै तै पूरै हणैं आल़ै, एशिया मुल्खे यहूदी पाई पल़सी भबनै भाल़ी एही हाक्‍का-लैल़ा करै संघा ढाकअ तिन्‍नैं, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“हे इज़राईली मणछो, मज़त करा, अह आसा सह ई मणछ, ज़ुंण लोगा लै बधान का दूर रहणा लै अर ऐहा पबित्र ज़ैगे खलाफ हर ज़ैगा लोगा का सखाऊआ, इधी तैणीं कि यूनान मुल्खा का ज़ुंण होरी ज़ातीए लोग आसा तिंयां बी आणै एऊ भबना भितरी। ऐबै लागी एऊ भबना बी छ़ोत।”<verse eid="ACT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 21:29" />तिन्‍नैं भाल़अ त तेता का आजी पल़सी संघै त्रोफिमस इफिसुस नगरी का आअ द तेऊ संघै नगरी दी, अर तिंयां समझ़ा तै कि पल़सी आणअ सह भबना लै।<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तेखअ मच़अ सारी एरुशलेम नगरी दी हाल्‍लअ-गोल्‍लअ, अर सोभ लोग आऐ ठुर्ही अर तिधी हुऐ खास्सै मणछ कठा। तिन्‍नैं आणअ पल़सी भबना का ढाकी करै नगरी बागा लै अर प्रऊल़ किई तेभी बंद। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />ज़ांऊं तिन्‍नैं पल़सी मारी लाअ त पाई, सपाही दले सरदारा का लागअ थोघ कि सारै एरुशलेम नगरी आसा हाल्‍लअ-गोल्‍लअ मच़अ द। <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />तेभी आअ तेभी आपणैं सपाही अर सुबैदारा लई तिन्‍नां सेटा लै ठुर्ही। सपाही दले सरदारा अर सपाही भाल़ी किअ तिन्‍नैं पल़सी च़िक्‍कणअ बंद अर सह झ़ैऊअ धरना का खल़अ।<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />सपाही दले सरदारै ढाकअ आजू एछी पल़सी अर सह बझ़ैल़अ दूई शांघल़ी करै बान्हणैं अर तेखअ लागअ लोगा पुछ़दअ, “अह कुंण आसा? एऊ किज़ै किअ?”<verse eid="ACT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 21:34" />पर तिन्‍नां खास्सै मणछे जेल्ह-मरेल्ही मांझ़ा का लागै कोई किछ़ बोल्दै अर कोई किछ़ लैल़ा लांदै, अर हाल्‍लै-गोल्‍लै मांझ़ै निं सह किछ़ गल्‍ला समझ़ी सकअ कि सत्त कै आसा। तेऊ दैनअ तिन्‍नां गहल़ा लै निंणैओ हुकम।<verse eid="ACT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 21:35" />ज़ांऊं सह शिहल़ी दी पुजअ, इहअ हुअ कि तिधी थिऐ खास्सै मणछ कठा हुऐ दै अर तिन्‍नें घिश-तल़िंगीए बज़्हा दी पल़अ सपाही पल़सी च़की निंणअ। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />किल्हैकि खास्सै मणछ तै तेऊ पिछ़ू लैल़ा पकारा पाई इहअ बोल्दै लागै दै कि एऊ पाआ मारी! एऊ पाआ मारी!<verse eid="ACT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />ज़ांऊं तिंयां पल़सी गहल़ा दी तै पजैल़णैं ई आल़ै थिऐ, पल़सी बोलअ सपाही दले सरदारा का, “मुंह ती ताह संघै किज़ै गल्‍ला करनी?” तेऊ बोलअ, “तूह कै यूनानी बोली ज़ाणा? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />तूह कै सह मिसर देशो निं आथी ज़ुंणी थोल़ै धैल़ै पैहलै द्रोही बणाईं च़ार हज़ार द्रोही मणछ रेगीस्ताना लै निऐं?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />पल़सी बोलअ, “हुंह निं सह आथी, हुंह आसा किलकिआ मुल्खे मशूर नगरी तरसुस नगरीओ रहणैं आल़अ यहूदी। मेरी आसा ताखा एही अरज़ कि मुंह दै इना लोगा संघै गल्‍ला करनै।”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />ज़ांऊं तेऊ हुकम दैनअ ता, पल़सी किअ शिहल़ी दी खल़्हुई करै लोगा लै शारअ अर ज़ांऊं तिंयां च़ुप्पी हुऐ तेखअ लागअ पल़सी इब्रानी भाषा दी बोल्दअ,<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="s">खास्सै मणछे झाल़ै लै पल़सीओ ज़बाब</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“भाईओ, अर यहूदी सैणैंओ, मेरअ ज़बाब शूणां, ज़ुंण मंऐं ऐबै तम्हां सम्हनै लाअ बोली।”<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />तिंयां इहअ शूणीं कि अह आसा लागअ द हाम्हां संघै इब्रानी दी बोल्दअ, तिंयां हुऐ होर बी च़ुप्पी। तेखअ बोलअ पल़सी,<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“हुंह आसा यहूदी मणछ, मेरअ ज़ल्म आसा हुअ द किलकिआ मुल्खै तरसुस नगरी, पर ऐहा नगरी गमलिएल गूरूए च़रणैं लई मंऐं शिक्षा, अर दादा-बाबे बधान आसा मुखा राम्बल़ै करै सखाऊऐ दै। हुंह मना त तिन्‍नां सोभी गल्‍ला किल्हैकि हुंह च़ाहा त परमेशरो हुकम मनणअ, ज़िहै तम्हैं आझ़ बी आसा मंदै लागै दै।<verse eid="ACT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 22:4" />“मंऐं दैनअ मर्ध अर बेटल़ी सोभी कैद करी एऊ पंथे विश्वासी मणछा लै खास्सअ कष्ट अर इना मांझ़ै कई पाऐ तै मंऐं मारी बी। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />मेरी ऐहा गल्‍ले आसा माहा प्रोहत अर सोभी सैणैं माहा सभा शाजत कि तिन्‍नां मांझ़ै कई यहूदी भाईए नाओंए च़िठी ढाकी थिअ हुंह दमिश्क नगरी लै डेऊंदअ लागअ द, कि तिधी बी ज़ुंण बी मसीही होए, तिंयां आणनैं कैद करी एरुशलेम नगरी लै ताकि तिन्‍नां लै सज़ा दैई सके।<verse eid="ACT 22:5" /></para>
  <para style="s">आपणैं दिला बदल़णें बारै खोज़णअ</para>
  <para style="r">(<ref loc="ACT 9:1-19">शधाणूं 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“ज़ांऊं हुंह हांढदी-हांढदी दमिश्क नगरी नेल़ पुजअ, इहअ हुअ खरै दपहरो बगत त अर हेरा-हेरी च़मकी सरगा का सुरज़ा का बी खास्सै झ़ामणा आल़ी बिज़ल़ी मुंह फेर। <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />हुंह बधल़ुअ धरनीं, अर मंऐं शूणअ इहअ बैण, <char style="wj">‘हे शाऊल, ए शाऊल, तूह किल्है आसा मुंह दुखी करदअ लागअ द?’</char></para>
  <para style="p" vid="ACT 22:7">“मंऐं पुछ़अ इहअ, ‘हे प्रभू तूह कुंण आसा?’<verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />“तेऊ दैनअ मुल्है ज़बाब, <char style="wj">‘हुंह आसा ईशू नासरी ज़हा तूह दुखी करदअ आसा लागअ द?’</char> <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />मेरै तिन्‍नैं होरी साथी सह प्रैश्शअ, भाल़अ तिंयां बोल निं तिन्‍नें समझ़ा दी आऐ कि किज़ै बोलअ।<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />“तेखअ बोलअ मंऐं, ‘हे प्रभू, तै हुंह किज़ै करूं?’</para>
  <para style="p" vid="ACT 22:10">“प्रभू बोलअ मुखा इहअ, <char style="wj">‘खल़अ उझ़ू संघा डेऊ दमिश्क नगरी लै, ज़ुंण ताह आजू करनअ सह हेरनअ ताखा खोज़ी।’</char> <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />ज़ांऊं हुंह तेऊ प्रैश्शे झ़ामणा करै कांणअ हुअ, हुंह पुजअ आपणैं तिन्‍नां साथीए हाथ ढाकी करै दमिश्क नगरी।<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“दमिश्क नगरी थिअ एक हनन्याह नाओं मणछ, सह आअ मुंह सेटा लै, सह थिअ परमेशरे डरा हेठै रहणैं आल़अ भगत अर यहूदी मणछे बधाना दी लिखी दी मना त सह हर गल्‍ला। दमिश्क रहणैं आल़ै सोभ यहूदी करा तै तेऊए इज़त। <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />मुंह सेटा खल़्हुई करै तेऊ बोलअ, ‘भाई शाऊल, ताखा लोल़ी भिई आछी का शुझणअ लागअ’ अर तेभी खुल्ही मेरी आछी अर मुखा लागअ सह शुझदअ।<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />“तेखअ बोलअ तेऊ, ‘म्हारै दादा-बाबे परमेशरै आसा तूह एते तैणीं छ़ांटअ द कि तूह एऊए मरज़ी ज़ाणें अर तूह तेऊ धर्मीं भाल़े, संघा तेऊए खाखा का निखल़ै दै बैण शुणें। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />किल्हैकि तूह हणअ तेऊ बाखा का सोभी मणछे सम्हनै तिन्‍नां गल्‍लो शाजत ज़ुंण तंऐं भाल़ी अर शूणीं दी आसा। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ऐबै निं बल़ैग पाऐ, खल़अ उझ़ू, हुंह दैंऊं ताल्है डुबकी। मसीहा ईशू दी कर विश्वास ताकि परमेशर तेरै पाप माफ करे।’<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="JOL 2:32">जोए. 2:32</ref></char></note><verse eid="ACT 22:16" /></para>
  <para style="s">होरी ज़ाती मांझ़ै खुशीओ समाद खोज़णें बारै</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“ज़ांऊं हुंह भिई एरुशलेम नगरी एछी भबनै प्राथणां करदअ त लागअ द, हुंह पल़अ नर्तान। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />प्रभू बोलअ मेरै बारै इहअ, <char style="wj">‘एभी डेऊ एरुशलेम नगरी का किल्हैकि इधी निं तिन्‍नां तेरै बारै तेरी ईंयां गल्‍ला मनणी।’</char><verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />“पर मंऐं बोलअ, ‘हे प्रभू, तिन्‍नां का आसा थोघ कि हुंह तेरै विश्वासी लोगा किहै पाआ कैद खानै अर ज़ैगै-ज़ैगै सभागृहा किहै च़िक्‍का त। <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />ज़धू तेरै शाजत स्तिफनुसा मारदै तै लागै दै, हुंह बी त तेभै तिधी खल़्हुअ द, अर ऐहा गल्‍ला दी त राज्ज़ी, अर तेऊ मारनै आल़ेए, झिकल़ै बी तै मुखा।’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />पर प्रभू बोलअ मुखा, <char style="wj">‘पोर्ही डेऊ, किल्हैकि मुंह छ़ाडणअ तूह होरी ज़ाती सेटा दूर-दूर तैणीं।’”</char><verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />तिंयां लोग ऐहा गल्‍ला तैणीं, रहै शुणदै लागी पर ऐहा गल्‍ला शूणीं बोलअ तिन्‍नैं ज़ोरै-ज़ोरै लैल़ा लाई, “एऊ इहै मणछा पाआ मारी, एऊओ ज़िऊंदअ रहणअ निं ठीक आथी।” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />ज़ांऊं तिंयां लैल़ा लांदै झिकल़ै धेल़दै अर रोश्शै धूल़ै माट्टै झ़ैऊंदै लागै, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />सपाही दले सुबैदारै बोलअ, “एऊ निंयां गहल़ा लै, अर कोल़ै बाही करा पुछ़-ज़ाच़, ताकि मुखा बी लोल़ी थोघ लागअ कि ईंयां लोग किल्है आसा लागै दै एऊए खलाफ इहै लैल़ा लांदै।”<verse eid="ACT 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 22:25" />ज़ांऊं पल़सी तिन्‍नैं राश्शी करै बान्हअ, तेखअ बोलअ पल़सी तेऊ सुबैदारा लै ज़ुंण तिधी खल़्हुअ द त, “अह कै ठीक आसा कि तम्हैं एकी रोमी मणछा लै, अर सह बी बाझ़ी दोशै च़िक्‍का कोल़ै करै?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />सुबैदारै बोलअ इहअ शूणीं सपाही दले सरदारा का, “तंऐं अह कै आसा लाअ द करी? अह ता रोम. आसा।”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />तेखअ पुछ़अ सपाही दले सरदारै पल़सी सेटा डेऊई, “मुखा खोज़ कि तूह कै रोमी आसा?”</para>
  <para style="p" vid="ACT 22:27">पल़सी बोलअ, “हाँ।”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />इहअ शूणीं बोलअ सपाही दले सरदारै, “मुंह आसा रोमी हणें पदबी खास्सै ढब्बै दैई भेटी दी!”</para>
  <para style="p" vid="ACT 22:28">पल़सी बोलअ, “हुंह आसा हुऐ-ज़ल्मां ओर्ही रोमी।”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />तेखअ ज़ुंणी तेऊए पुछ़-ज़ाच़ ती लाई दी करी, तिंयां हटै तेभी तेऊ सेटा का दूर, अर दलो सरदार बी, इहअ थोघ लागी करै कि अह आसा रोमी, मंऐं आसा अह बान्हअ द, सह डरअ।<verse eid="ACT 22:29" /></para>
  <para style="s">माहा सभा दी पल़सीए पेशी</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />दुजै धैल़ै सह ठीक-ठीक थोघ करने च़ाहा दी कि यहूदी तेऊ लै किज़ै दोश लाआ, तेऊए शांघल़ी लोहै खोल्है, अर बडै प्रोहत अर सारी सभा लै दैनअ कठा हणैंओ हुकम अर पल़सी निंयं तिन्‍नैं उंधै माहा सभा लै संघा किअ सह तिन्‍नां सम्हनै खल़अ।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पल़सी भाल़अ माहा सभा बाखा राम्बल़ै करै संघा बोलअ, “भाईओ, मंऐं काटी आझ़ तैणीं परमेशरा सम्हनै शुचै रही ज़िन्दगी!”<verse eid="ACT 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 23:2" />हनन्याह माहा प्रोहतै बोलअ पल़सी नेल़ खल़्हुऐ दै लोगा लै, “एऊए मुंहैं बाहा च़ैंडै।” <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />एता भाल़ी बोलअ पल़सी हनन्याह लै, “परमेशरा दैणीं ताल्है ऐहा गल्‍ला पिछ़ू आप्पै सज़ा, तूह आसा नसाफ आसना दी मेरै फैंसलै करदअ तेऊ बधाना करै लागअ द ज़ुंण परमेशरै आपणैं गूर मोसा लै दैनअ। पर आप्पू निं तूह तेऊ बधाना मंदअ! किल्हैकि, ज़ै मेरी किज़ै गलती ई निं निखल़ी, तै किल्है बोलअ तंऐं, ‘एऊए मुंहैं बाहा च़ैंडै?’”<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लेब. 19:15</ref>; <ref loc="EZK 13:10-15">एज. 13:10-15</ref></char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />ज़ुंण तिधी नेल़ खल़्हुऐ दै तै तिन्‍नैं बोलअ पल़सी लै रोश्शा संघै, “तूह परमेशरे माहा प्रोहता लै बूरअ बोला?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पल़सी बोलअ, “भाईओ, मुखा निं थोघै त कि अह आसा माहा प्रोहत, किल्हैकि शास्त्रा दी आसा लिखअ द कि आपणैं लोगे सैणैं लै निं बूरअ बोली।”<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">लुआ. 22:28</ref></char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />तेखअ ज़ांऊं पल़सी का थोघ लागअ कि सभा दी केतरै फरीसी अर केतरै सदुकी मणछ आसा, तेऊ बोलअ ज़ोरै-ज़ोरै, “भाईओ, हुंह आसा फरीसी अर फरीसी मणछे खिंबा का, मूंऐं दै अर मूंऐं दै मणछे आशा दी अर मरी करै ज़िऊंदै हणें बारै आसा लागअ द मेरअ नसाफ आसना सम्हनै मकदमअ हंदअ।”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />ज़ांऊं पल़सी अह गल्‍ल बोली, फरीसी अर सदुकी पंथे लोगा मांझ़ै पल़अ झ़गल़अ अर सभा दी पल़ी फूट। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />किल्हैकि सदुकी पंथे लोग मना तै इहअ बी कि मरी करै निं कोहै सकदअ भिई ज़िऊंदअ हई अर नां स्वर्ग दूत अर नां भूत आथी, पर फरीसी मना तै इना सोभी गल्‍ला।<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />तेखअ मच़अ बडअ हाल्‍लअ-गोल्‍लअ अर कई शास्त्री तै फरीसी मणछा पक्षा दी, तिंयां उझ़ुऐ खल़ै इहअ बोली किअ तिन्‍नैं झ़गल़अ, “हाम्हां का निं एऊ मणछा दी किछ़ै बूरी गल्‍ल शुझदी, ज़ै कुंणी भूत अर स्वर्ग दूता संघै गल्‍ला किई तै किज़ै हुअ?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />ज़ांऊं खास्सअ झ़गल़अ हुअ, सपाही दले सरदारै ऐहा डरै कि इहअ निं हआ कि ईंयां पल़सी काटे मारे, तेऊ दैनअ इहअ हुकम कि पल़सी काढा इना मांझ़ा का ज़ोरा-ज़ोरी बागै अर एऊ निंयां गहल़ा लै।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />तैहा ई राची बोलअ प्रभू ईशू पल़सी का दर्शण दैई करै, <char style="wj">“पल़सी, तूह निं फिकर करी, किल्हैकि ज़ेही शाजत तंऐं मेरी एरुशलेम नगरी दैनी, तेही शाजत लागणीं ताह रोम डेऊई बी दैणीं।”</char><verse eid="ACT 23:11" /></para>
  <para style="s">पल़सीए हत्या करने च़ाल</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />दुजै धैल़ै किअ कई यहूदी एक्‍कअ अर तिन्‍नैं खाऐ इहै सोह कि ज़ेभै तैणीं तिंयां पल़सी मारी खतम निं करी हेरे, ज़ै तेता का आजी तिंयां किज़ै खाए-पिए, तै आसा तिन्‍नां लै लानत। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />ज़ुंणीं इहै सोह खाऐ तै, तिंयां थिऐ कोई च़ाल़्ही ज़ण्हैं का खास्सै।<verse eid="ACT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 23:14" />तिन्‍नैं बोलअ बडै प्रोहता अर सैणैं सेटा डेऊई, “हाम्हैं आसा एही ठान्हीं दी कि ज़ांऊं तैणीं हाम्हैं पल़सी मारी निं पाए, तेभै तैणीं हाम्हैं किज़ै च़ाखे बी, हाम्हां लै आसा लानता प्रैंदै लानत। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />तैही समझ़ाऊआ ऐबै माहा सभा संघी सपाही दले सरदारा इहअ कि तेऊ छ़ाडा तम्हां सेटा लै कि तम्हां शाची सज़ा दैणैं का आजी तेऊए बारै ठीक-ठीक पुछ़-ज़ाच़ करनी, अर हाम्हैं हणैं तेऊ इधी तम्हां सेटा पुजणैं का आजी ई मारना लै ताखुई रहै दै।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />तिधी त पल़सीओ भाणज़ू तेऊ शूणीं ईंयां सारी गल्‍ला कि ईंयां आसा पल़सी मारने ताका रहै दै। तेऊ दैनअ गहल़ै डेऊई पल़सी लै अह समाद। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पल़सी बोलअ सुबैदारा मांझ़ै एक आप्पू सेटा लै शादी करै, “एऊ खारकै मणछा निंयां सपाही दले सरदारा सेटा लै, अह च़ाहा किज़ै खोज़णअ।”<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />तेऊ बी निंयं सह सपाही दले सरदारा सेटा लै अर सरदारा का बोलअ, “पल़सी कैदी किई मुंह शादी करै एही अरज़ कि अह ज़ुआन मणछ च़ाहा सपाही दले सरदारा का किज़ै खोज़णअ, एऊ निंऊं तेऊ सेटा लै।”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />सपाही दले सरदारै पुछ़अ तेऊओ हाथ ढाकी करै सह ज़ुदअ ज़िहअ निंईं करै, “तूह किज़ै च़ाहा मुखा खोज़णअ?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />तेखअ खोज़ी तेऊ सारी गल्‍ला, “यहूदी आसा एक्‍कअ किअ द तिंयां च़ाहा कि ताखा बोल़णअ तिन्‍नां इहअ कि काल्‍ला आण पल़सी माहा सभा लै, ज़ाणनअ कि तूह च़ाहा तेऊए ठीक-ठीक पुछ़-ज़ाच़ करनी। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पर तिन्‍नें गल्‍ला निं मनी, किल्हैकि तिन्‍नां मांझ़ै आसा च़ाल़्ही का बी खास्सै मणछ पल़सी बातो-बात मारने ताका रहै दै। तिन्‍नैं आसा एही डाही दी कि ज़ेभै तैणीं पल़सी मारी निं पाए, तेभै तैणीं खाए-पिए, तिन्‍नां लै आसा लानत, अर तिंयां आसा एभै तैर अर तेरै बोला न्हैल़ै लागै दै।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />तेखअ छ़ाडअ सपाही दले सरदारै सह ज़ुआन मणछ इहअ बोली, “ऐहा गल्‍ला निं कोही का खोज़ी ज़ुंण तंऐं मुखा खोज़ी।”<verse eid="ACT 23:22" /></para>
  <para style="s">पल़सी फेलिक्स सेटा लै छ़ाडणअ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />सपाही दले सरदारै शादै दूई सुबैदार संघा बोलअ तिन्‍नां लै इहअ, “दूई शौ सपाही, सत्तर शुंआरी अर दूई शौ सपाही डाहा राची भितरी कैसरिया नगरी लै डेऊणा लै तैर करी। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />संघा डाहा पल़सीए शुंआरी लै घोल़ै तैर करी कि सह पजैल़णअ फेलिक्स राज़पाला सेटा राज्ज़ी राम्बल़अ बच़ाऊई।” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />सरदारै लिखी राज़पाला लै एही एक च़िठी बी,<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“माहा प्रतप्पी फेलिक्स सैणैं लै क्लौदिउस लासिआसा बाखा राज्ज़ी-खुशी।<verse eid="ACT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 23:27" />“अह मणछ लाअ त यहूदी ढाकी करै मारी, पर ज़ांऊं मुखा इहअ थोघ लागअ कि अह आसा रोमी, सपाहीओ दल निंईं करै आणअ मंऐं तिन्‍नां का बच़ाऊई। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />मंऐं किई इहअ थोघ करने खास्सी कोशिश कि तिंयां एऊ लै किज़ै दोश लाआ, तै निंयं मंऐं तिन्‍नें माहा सभा लै। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />तिधी लागअ मुखा थोघ कि तिंयां लाआ तिन्‍नें बधाना मनणे बारै एऊ लै दोश, पर मारनै अर कैद करी बान्हीं डाहणैं जोगी दोश निं मुखा एऊ दी किछ़ै शुझदअ।<verse eid="ACT 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 23:30" />“ज़ांऊं मुखा कुंणी इहअ खोज़अ कि तिन्‍नैं आसा अह लाअ द मारी, मंऐं छ़ाडअ तेभी अह ताह सेटा लै, अर मंऐं आसा एऊ लै मकदमैं करनै आल़ै लै बी बोलअ द कि ताह सेटा डेऊई खोज़ै सारी गल्‍ला, ज़ुंण बी तिन्‍नां बोल़णअ होए।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />तेखअ ज़िहअ हुकम सपाही लै दैनअ त, तिहअ ई निंयं तिन्‍नैं पल़सी अर तिंयां पुजै राची भितरी अंतिपत्रोस नगरी लै। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />दुजै धैल़ै पुजै ज़ांघा हांढी डेऊणैं आल़ै सपाही एरुशलेम नगरी गहल़ै बापस अर घोल़े शुंआरी आल़ै डेऊऐ पल़सी संघै। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />ज़ांऊं तिंयां कैसरिया नगरी पुजै, तिन्‍नैं दैनी सह च़िठी राज़पाला का अर पल़सी बी निंयं तेऊ सेटा लै। <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />तेऊ पुछ़अ च़िठी पहल़ी करै पल़सी का, “तूह केऊ मुल्खा का आसा?” पल़सी खोज़अ, “हुंह आसा किलकिआ का।”<verse eid="ACT 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 23:35" />ज़ांऊं तेऊ का इहअ थोघ गअ लागी कि अह आसा किलकिआ मुल्खा का, तेऊ बोलअ पल़सी लै, “ज़ेभै ताल्है मकदमैं आल़ै बी एछे तेभै करूं हुंह तम्हां सोभिए गल्‍ला शूणीं थारअ फैंसलअ।” तेखअ दैनअ तेऊ इहअ हुकम कि पल़सी डाहअ हेरोदेस राज़ेए राज़ भबनै कैद करी, संघा डाहअ तिधी पहरअ पाई।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">सैणअ फेलिक्सा सेटा पल़सीए पेशी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पांज़ा धैल़ै बाद आअ हनन्याह माहा प्रोहत कई सैणैं अर तिरतुल्‍लुस नाओंए कहा बकीला संघा लई कैसरिया नगरी लै। संघा खोज़अ तिन्‍नैं राज़पाला सम्हनै पल़सीओ दोश। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />ज़ांऊं पल़सी शादअ, तिरतुल्‍लुस बकील लागअ तेऊ लै दोशा लांदअ,</para>
  <para style="p" vid="ACT 24:2">“हे माहा प्रतप्पी फेलिक्स, ताह करै भेटा हाम्हां सराहुणां लै अर तेरै इंतज़ामा करै सधेरा ऐहा ज़ातीए कई बूराई। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ताह अर तेरै बधाना मना हाम्हैं हर ज़ैगा अर हर गल्‍ला दी शूकर करी। <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />तेरअ निं हाम्हैं खास्सअ बगत ज़ांऐं करनअ च़ाहंदै, हुंह करा ताह सेटा अरज़ कि म्हारी शूणैं दूई गल्‍ला,<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />“किल्हैकि हाम्हैं भाल़अ अह मणछ उपद्रभ अर देशै-देशै बस्सै दै यहूदी जैंदरी खरोल़ा पांदअ! अह आसा तिन्‍नां सोभी लोगो सैणअ ज़ुंण ईशू नासरी पंथे आसा। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />एऊ लाई ती म्हारै परमेशरे भबनै छ़ोत लाई, तेते तैणीं ढाकअ हाम्हैं अह। हाम्हां दैणीं आपणीं बधाने साबै एऊ लै सज़ा।<verse eid="ACT 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 24:7" />“पर लासिआस नाओंए सपाही दले सरदारै छ़ड़ैऊअ अह ज़ोरा-ज़ोरी म्हारै हाथा का पोर्ही अर <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />दुशमणा लै दैनी ताह सेटा एछणें ज़ाज़त किई इना सोभी गल्‍ला, ज़ेते बारै हाम्हैं इना दोशा एऊ दी लाआ, ताखा लागणअ आप्पै एऊ पुछ़ी-ज़ाच़ी करै थोघ।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />यहूदी बी बोलअ तेऊओ साथ दैई कि सच्च़ी किअ एऊ इहअ ई।<verse eid="ACT 24:9" /></para>
  <para style="s">पल़सीओ ज़बाब</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />ज़ांऊं राज़पाल फेलिक्सै पल़सी लै बोल़णा लै शारअ किअ, पल़सी दैनअ ज़बाब, “मुखा ज़ांऊं इहअ थोघ लागअ कि तूह करा कई साला ओर्ही ऐहा ज़ातीओ नसाफ, मुंह आसा ऐहा गल्‍ला ताह सेटा खोज़णें बडी खुशी। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />तूह सका आप्पै समझ़ी कि ज़ेभै हुंह एरुशलेम नगरी परमेशरे च़ाकरी करदअ आअ, मुंह निं अज़ी बारा धैल़ै का उझै हुऐ, <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />अर इनै नां भाल़अ हुंह भबनै, नां सभागृहा अर नां नगरी दी कहा संघै हठल़दअ अर नां लोगा कठा करदअ भाल़अ? <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />ज़हा गल्‍लो ईंयां मुल्है दोश लाआ नां ईंयां इना गल्‍ला सच्च़ी साबत करी सकदै।<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />“पर हाँ, हुंह मना ताह सेटा ऐहा गल्‍ला कि हुंह करा तेऊ ई बधाने साबै परमेशरे च़ाकरी ज़ेऊ साबै मेरै दाद-बाब करदी आऐ। अह गल्‍ल बी आसा सच्च़ी कि हुंह च़ला मसीहा ईशूए मरज़ी दी। हुंह करा तिन्‍नां सोभी गल्‍ला दी बी विश्वास ज़ुंण परमेशरै आपणैं गूर मोसा लै दैनी अर परमेशरे होरी कई गूरै आसा शास्त्रा दी लिखी दी।<verse eid="ACT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 24:15" />“मेरअ विश्वास आसा तिहअ ई ज़ेही इना होरी आसा एही आशा कि एकी धैल़ै करनै परमेशरा धर्मीं अर कदुष्ट मणछ दुहै ज़िऊंदै।<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दान. 12:2</ref></char></note> <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />तैहा धैल़ी लै करा हुंह बी इहै करने कोशिश कि परमेशरा सम्हनै अर लोगा सम्हनै लोल़ी हर गल्‍ला दी मेरी सोर-समझ़ नर्दोश रही।<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“कई साला बाद आअ त हुंह एरुशलेम नगरी लै मेरै आपणैं गरीब विश्वासी भाई-बैहणी लै दान दैनै दै धख ढब्बै-धेल्‍लै पजैल़अ। <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />एशिया का आऐ दै यहूदी भाल़अ हुंह भबने ताटी परमेशरा सेटा माथअ टेक्‍कणै का आजी शुधी करनैओ बधान पूरअ करी एक्‍कै ज़ण्हअ, अर नां मुंह संघै कोई लोग आथी तै। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />ज़ै तिन्‍नां एशिया मुल्खे यहूदी का मेरै खलाफ किज़ै दोश शुझुअ बी होए, तै सका तै तिंयां इधी ताह सम्हनै मुल्है दोश लाई।<verse eid="ACT 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 24:20" />“कि खोज़े ईंयां आप्पै कि ज़ेभै हुंह माहा सभा सम्हनै खल़अ किअ त, तेभै इनै मुंह दी कै ज़ुल्म भाल़अ? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />ऐहा एकी गल्‍ला छ़ाडी ज़ुंण मंऐं तिन्‍नां सम्हनै खल़ै हई बोली, ‘मरी करै ज़िऊंदै हणें बारै आसा आझ़ तम्हां सम्हनै मेरअ नसाफ लागअ द हंदअ।’”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलिक्स राज़पाला का थिअ एऊ पंथे सारी गल्‍लो थोघ, पल़सी लै निं तेभै तेऊ किछ़ै सज़ा खोज़ी अर इहअ बोली टाल़ी सह गल्‍ल कि ज़ेभै सपाही दलो सरदार लासिआस एछे, तेभै हणअ थारी गल्‍लो फैंसलअ। <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />तेखअ दैनअ सुबैदारा लै हुकम कि पल़सी लै निं कोई तंगी तकलिफी दैई अर एऊए हेर-सभाल़ करै बडै सुखा संघै, अर एऊए साथी-भाई मांझ़ै ज़ुंण बी एऊए च़ाकरी लै एछे, तिन्‍नां निं रोक्‍की।<verse eid="ACT 24:23" /></para>
  <para style="s">फेलिक्स अर द्रुसिल्‍ला सेटा पल़सीए पेशी</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />कई धैल़ै बाद आअ राज़पाल फेलिक्स आपणीं लाल़ी संघा लई, तेऊए लाल़ी नाअं त द्रुसिल्‍ला अर सह थिई यहूदी। तेऊ शादअ पल़सी आप्पू सेटा अर तेखअ शूणीं मसीहा ईशू दी विश्वास करने बारै सारी गल्‍ला। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />ज़ांऊं पल़सी धर्म, सबर अर आजू हणैं आल़ै नसाफ बारै खोज़अ, फेलिक्से दैनअ हैल़ुई करै पल़सी लै ज़बाब, “एभै; डेऊ, ज़ेभै भिई मुंह मोक्‍कअ भेटे, तेभै शादूं हुंह ताह आप्पै।” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />तेऊ ती पल़सी का किछ़ ढब्बै-धेल्‍ले आशा बी, तैही शादा त सह पल़सी गल्‍ला करना लै।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />पर ज़ांऊं दूई साला बिति, पुरकियस फेस्तुस आअ फेलिक्से ज़ैगा राज़पाल अर फेलिक्सै डाहअ यहूदी खुश करने तैणीं पल़सी कैदी ई बणाईं।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">पल़सीए माहा राज़ेए दुहाई दैणीं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />कैसरिया पुजी पदबी सभाल़णैं का बाद डेऊअ फेस्तुस चिई धेल्‍लै बाद एरुशलेम नगरी लै। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />तिधी छ़ेल़ी बडै प्रोहतै, यहूदी सैणैं तेऊए सम्हनै पल़सीए गल्‍ला। <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />तिन्‍नैं किई तेऊ का एही मांग कि पल़सी छ़ाड एरुशलेम नगरी लै। किल्हैकि तिंयां च़ाहा तै पल़सी बातो-बात मारनअ।<verse eid="ACT 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 25:4" />फेस्तुस राज़पालै दैनअ ज़बाब, “पल़सी आसा कैसरिया कैद खानै, मुंह डेऊणअ आप्पै तिधा लै छ़ेक्‍कै। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />तम्हां मांझ़ै ज़ुंण ऐहा गल्‍ला लै सैणैं आसा तिंयां च़ाल्‍ला मुंह संघै, ज़ै तेऊ मणछा दी किज़ै गलती होए तै सका तम्हैं तेऊ लै तिधी मकदमअ करी।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />आठ-दस धैल़ै बाद डेऊअ फेस्तुस कैसरिया लै फिरी अर दुजै धैल़ै नसाफ करने गाद्दी दी बेशी शादअ पल़सी तेऊ दालता लै। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />ज़ांऊं पल़सी तिधी पुजअ, एरुशलेम नगरी का आऐ दै यहूदी सैणैं खल़्हुऐ तेऊ फेर, अर तिन्‍नैं लाऐ तेऊ लै खास्सै इहै दोश ज़ेते तिंयां कोई सबूत बी निं दैई सकदै तै।<verse eid="ACT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8" />पर पल़सी दैनअ ज़बाब, “मंऐं निं यहूदी बधाने खलाफ किछ़ै ज़ुल्म किअ अर नां भबने अर माहा राज़ेए खलाफ डेऊअ।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />तेखअ पुछ़अ फेस्तुस राज़पालै यहूदी सैणैं खुश करने तैणीं पल़सी का एक सुआल, “तूह कै इहअ च़ाहा कि एरुशलेम नगरी डेऊई तिधी मेरै सम्हनै तेरै मकदमैंओ फैंसलअ होए?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पल़सी दैनअ ज़बाब, “हुंह आसा माहा राज़ेए दालता दी खल़्हुअ द, मेरै मकदमैंओ फैंसलअ लोल़ी इधी हुअ। ज़िहअ कि ताखा बी आसा थोघ कि मंऐं निं यहूदी लै किछ़ै ज़ुल्म किअ। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />ज़ै मंऐं किज़ै ज़ुल्म किअ बी अर ज़ै मेरी सज़ा मौत बी होए, हुंह आसा तेता लै बी राज्ज़ी। पर ज़हा गल्‍लो ईंयां मुल्है दोशा लांदै आसा लागै दै, ईंयां गल्‍ला निं शुची आथी, ऐहा गल्‍लो हक निं कोही का आथी कि मुंह इना यहूदी मारना लै दैए, हुंह दैआ इधी ऐबै एही अरज़ कि मेरै मकदमैंओ फैंसलअ लोल़ी माहा राज़ेए दालता दी हुअ।”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />तेखअ दैनअ फेस्तुस राज़पालै माहा सभा राऐ करी ज़बाब, “तंऐं किई माहा राज़ेए दालता दी डेऊणे अरज़ अर ऐबै छ़ाडणअ मुंह तूह माहा राज़ै सेटा।”<verse eid="ACT 25:12" /></para>
  <para style="s">राज़ै अग्रिप्पा सेटा पल़सीए पेशी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />थोल़ै धैल़ै बाद आअ अग्रिप्पा राज़अ आपणीं बैहणी बिरनिके संघै राज़पाल फेस्तुस सेटा कैसरिया नगरी मिलदअ। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />तिधी खास्सै धैल़ै रहणैं का बाद खोज़ी फेस्तुस राज़पालै पल़सीए बारै तिन्‍नां का सारी गल्‍ला, “एक मणछ आसा ज़ुंण राज़पाल फेलिक्सै इधी कैद खानै आसा छ़ाडअ द। <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />ज़धू हुंह एरुशलेम नगरी थिअ, तधू किई बडै प्रोहत अर यहूदी सैणैं तेऊए गल्‍ला। तिंयां च़ाहा इहअ कि पल़सी लै दैआ मौते सज़ा।<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />“पर मंऐं दैनअ तिन्‍नां लै ज़बाब कि रोम राज़े बधाने साबै लोल़ी दोशी अर मकदमैं करनै आल़ै दुहै पेशी लै आऐ अर मुंहां सम्हनै लोल़ी तिन्‍नें सुआल-ज़बाब हुऐ। ज़हा लै मकदमअ आसा किअ द तेऊ लोल़ी आपणीं गल्‍ला खोज़णेंओ मोक्‍कअ भेटअ तेभै तैणीं निं कोही लै सज़ा दैई सकदै।<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />“ज़ांऊं तिंयां इधी कठा हुऐ, मंऐं निं बल़ैग पाई अर मंऐं शादअ दुजै धैल़ै पल़सी दालता लै। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />ज़ांऊं तेऊ दी मकदमैं करनै आल़ै खल़ै हुऐ, तिन्‍नैं बी निं तेतरी बूरी गल्‍लो दोश लाई ज़िहअ हुंह समझ़ा त। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />तिंयां थिऐ आपणैं रबाज़ा पिछ़ू झ़घल़दै लागै दै अर ईशू नाओंए कोई मणछे बारै ज़ुंण मूंअ त अर अह पल़सी खोज़ा तेऊ ज़िऊंदै, ऐहा गल्‍ला पिछ़ू तै ईंयां हठल़दै लागै दै।<verse eid="ACT 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 25:20" />“हुंह त इहअ झाखुअ द कि इना गल्‍लो थोघ किहअ करै लाऊं? तैही पुछ़अ मंऐं एऊ का इहअ कि तूह एरुशलेम नगरी लै च़ाल्‍लअ कि तिधी तेरै मकदमैंओ फैंसलअ होए? <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />पर एऊ पल़सी किई एही अरज़ कि मेरअ नसाफ माहा राज़ेए दालता दी हुअ। मंऐं दैनअ हुकम कि ज़ेभै तैणीं हुंह एऊ माहा राज़ै सेटा निं पजैल़ी लऊं, तेभै तैणीं करा एऊए कैद खानै हेर-सभाल़।”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />तेखअ बोलअ अग्रिप्पा राज़ै फेस्तुस राज़पाला का, “हुंबी च़ाहा तेऊ मणछे शुणनअ कि सह कै बोला?”</para>
  <para style="p" vid="ACT 25:22">फेस्तुस राज़पालै बोलअ, “काल्‍ला शूणैं तूह भाल़ै।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />दुजै धेल्‍लै पुजै राज़अ अग्रिप्पा तेऊए बैहण बिरनिके बडी ज़ै-ज़ैकारा मांझ़ै सपाही दले सरदारा अर नगरीए बडै लोगा संघै दरबारै। फेस्तुस राज़पालै दैनअ इहअ हुकम कि पल़सी आणा ओर्ही।<verse eid="ACT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 25:24" />फेस्तुस राज़पालै बोलअ, “हे माहा राज़अ अग्रिप्पा, अर इधी हाम्हां संघै सोभी मणछो, तम्हैं भाल़ा एऊ मणछा ज़सरै बारै खास्सै यहूदी एरुशलेम नगरी अर इधी बी लैल़ा, लाई-लाई करै मुखा अरज़ किई कि अह ज़िऊंदअ डाहणअ निं ठीक आथी। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />पर मुखा गअ थोघ लागी कि एऊ निं इहअ किछ़ै किअ ज़ेता लै एऊ मौते सज़ा होए। ऐबै ज़ै एऊ आप्पै ई माहा राज़ेए दालता लै डेऊणे अरज़ किई, मंऐं लाअ अह रोम नगरी दैई पजैल़ी।<verse eid="ACT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 25:26" />“पर मुखा निस्सअ एऊ लै सज़ा दैणैं जोगी किछ़ै दोश शुझुई कि आपणैं मालका सेटा लै किज़ै लिखूं? तैही आणअ मंऐं तम्हां सेटा, खासकर राज़ै अग्रिप्पा सेटा कि एऊए पुछ़-ज़ाच़ करनै का बाद मुंह माहा राज़ै लै लिखी दैणा लै किज़ै सबूत भेटे। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />किल्हैकि कैदी दी किज़ै दोश आसा तेते बारै लिखै बाझ़ी कैदी ताह सेटा लै छ़ाडणअ ज़ाण्हिंआं मुखा बृथा।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">अग्रिप्पा राज़ै सम्हनै पल़सीए सफाई दैणीं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रिप्पा राज़ै बोलअ पल़सी लै, “आपणैं बारै बोल़णें आसा ताल्है ज़ाज़त।”</para>
  <para style="p" vid="ACT 26:1">तेखअ लागअ पल़सी हाथ आजू फुआरी करै गल्‍ला खोज़दअ, <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />“हे राज़अ अग्रिप्पा, हुंह समझ़ा इहअ कि मेरै खुल्है भाग कि आझ़ भेटअ मुंह ताह सम्हनै तिन्‍नां गल्‍ला खोज़णेंओ मोक्‍कअ ज़ेते बारै ईंयां यहूदी सैणैं मुल्है दोश लाआ। <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />खासकर एते तैणीं कि ताखा आसा आप्पै यहूदी मणछे रबाज़ अर हर गल्‍लो थोघ ज़ेते बारै हाम्हैं हठल़दै हआ लागै दै, मेरी आसा ताह सेटा एही अरज़ कि मेरी गल्‍ला शुणें सबर करी।<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“ज़िहअ मेरअ च़ाल-च़लण होछ़ी उझै आपणीं ज़ाती मांझ़ै एरुशलेम नगरी त, तेतो आसा इना सोभी यहूदी का बी थोघ। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />तिंयां बछ़ैणा मुंह होछ़ी उझै अर ऐहा गल्‍ला सका तिंयां खोज़ी कि मंऐं ज़िऊई फरीसी पंथे साबै आपणीं सारी ज़िन्दगी।<verse eid="ACT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 26:6" />“आझ़ आसा मेरअ मकदमअ एता पिछ़ू लागअ द हंदअ कि मेरी आशा आसा एही कि ज़ुंण करार परमेशरै म्हारै दादा-बाबा का किई ती सह हुई पूरी। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />अह आसा सह ई करार ज़हा पूरी हणां लै म्हारै बारा गोत्र धैल़ी-राची परमेशरे च़ाकरी करदी न्हैल़ै आसा लागै दै। ए राज़अ ऐहा ई आशा डाहणें पिछ़ू आसा यहूदी सैणैं मेरअ मकदमअ किअ। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />कहा लै अह गल्‍ला नुआहरी किल्है ज़ाण्हिंआं कि परमेशर करा मूंऐं दै मणछा ज़िऊंदै?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“हुंबी सोठा त पैहलै इहअ ई नासरत नगरीए ईशूओ खलाफ आसा मुंह किज़ै नां किज़ै करनअ ज़रूरी। <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />मंऐं एरुशलेम नगरी इहअ किअ बी। एतरअ तैणीं कि बडै प्रोहता का हक पाई कई पबित्र लोग पाऐ मंऐं कैद खानै दी, अर तिन्‍नें हत्या करना लै हआ त हुंबी राज्ज़ी। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />हुंह करा त सभागृहा तिन्‍नां लै कष्ट दैई ईशूए कराऊआ त निंदा, इधी तैणीं कि रोश्शै हुअ त हुंह इहअ बेगरअ कि बागै नगरी डेऊई बी करा त हुंह तिन्‍नां लै तकलिफ दैई।<verse eid="ACT 26:11" /></para>
  <para style="s">आपणैं दिल बदल़णें बारै खोज़णअ</para>
  <para style="r">(<ref loc="ACT 9:1-19">शधाणूं 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“बडै प्रोहतै दैनी मुल्है दमिश्क नगरी रहणैं आल़ै विश्वासी कैद खानै बंद करनैओ हक अर ज़ांऊं हुंह तिधा लै डेऊअ <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ए राज़अ, तिधी पुजणैं का आजी हुअ बाता इहअ कि खरै दपहरो बगत त, मंऐं भाल़अ सरगा का सुरज़ा का बी खास्सै झ़ामणा ज़िहअ प्रैश्शअ आप्पू अर संघा हांढणै आल़ै साथी फेर च़मकदअ।<verse eid="ACT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 26:14" />“ता ज़ांऊं हाम्हैं सोभै धरनीं माट्टै दी बधल़ुऐ, मुखा शुण्हुंअ इब्रानी बोली दी मुल्है इहै बोल बोल्दअ, <char style="wj">‘हे शाऊल, ए शाऊल, तूह किल्है आसा मुंह दुखी करदअ लागअ द? मुंह संघै जुध करी हणअ ताल्है ई घाटअ।’</char><verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />“मंऐं पुछ़अ इहअ, ‘हे प्रभू तूह कुंण आसा?’</para>
  <para style="p" vid="ACT 26:15">“प्रभू दैनअ मुल्है ज़बाब, <char style="wj">‘हुंह आसा ईशू नासरी ज़हा तूह दुखी करदअ आसा लागअ द।</char> <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" /><char style="wj">पर तूह उझ़ू आपणीं ज़ांघा दी खल़अ, किल्हैकि हुंह आअ ताह सेटा लै एते तैणीं कि तूह बणाणअं मुंह तिन्‍नां गल्‍ला दी दास अर शाजत दुहै, ज़ुंण तंऐं भाल़ी दी आसा, अर तिन्‍नां गल्‍लो बी ज़ुंण ताह आजू करनअ मुंह रहैऊंणीं तिंयां ताखा आप्पै।<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">एज. 2:1</char></note></char><verse eid="ACT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 26:17" />
    <char style="wj">“‘मुंह रहणअ ताह तेरै लोगा का अर होरी ज़ाती का बच़ाऊंदै लागी, ज़हा सेटा लै तूह मंऐं ऐबै छ़ाडी आसा लाअ द कि<note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">1 इति. 16:35</char></note></char> <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" /><char style="wj">तूह तिन्‍नें आछी खोल्हे कि न्हैरै का प्रैश्शै बाखा लै, अर राख्से गलामी का परमेशरा बाखा लै फरेओए अर परमेशर तिन्‍नें पाप माफ करे ज़ुंण मुंह दी विश्वास करी पबित्र आसा किऐ दै।’<note caller="+" style="f"><char style="fr" closed="false">26:18 </char><char style="ft" closed="false">बधा. 33:3-4; ईशा. 35:5-6; 42:7,16; 61:1</char></note></char><verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“तै ए राज़अ अग्रिप्पा, मंऐं किअ सह ज़ुंण परमेशरै मुल्है स्वर्गो दर्शण दैनअ। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />पर पैहलै दमिश्क नगरी अर तेखअ एरुशलेम नगरी रहणैं आल़ै लै, तेखअ यहूदा मुल्खै अर होरी ज़ातीए लोगा का ऐहा गल्‍ला खोज़दअ लागी कि आपणैं पापो प्राश्त करा संघा फिरा परमेशरा बाखा। संघा करा इहै काम ज़ेता करै थोघ लागे कि तम्हैं हेरअ पाप करनअ छ़ाडी।<verse eid="ACT 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 26:21" />“इना गल्‍ला पिछ़ू रहै यहूदी मुंह भबनै ढाकी करै मारने तरकिबा लागी। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />परमेशरे मज़ती करै आसा हुंह आझ़ तैणीं ज़िऊंदअ अर होछ़ै बडै सोभी नदरी दैआ हुंह ऐहा शाजत। इना गल्‍ला छ़ाडी निं हुंह होर किछ़ै बोल्दअ, ज़ुंण मोसा गूरै अर परमेशरे होरी गूरै बी आसा बधाना दी बोली दी कि आजू हणअ इहअ, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />‘मसीहा लागणअ दुख भुगतणअ अर सह सोभी का आजी मूंऐं दै मांझ़ा का ज़िऊंदै हई करनअ तेऊ म्हारै लोगा मांझ़ै अर होरी ज़ाती दी प्रैश्शैओ प्रच़ार।’”<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ईशा. 42:6</ref>; <ref loc="ISA 49:6">49:6</ref></char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />ज़ांऊं पल़सी इहअ करै ज़बाबा दैंदअ त लागअ द, फेस्तुस राज़पालै पाई ज़ोरै हाक बोलअ, “पल़सी, तेरी अक्ल गई भ्रष्ट हई, खास्सी बिद्या करै हुअ तूह बेगरअ।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पर पल़सी बोलअ, “हे माहा प्रतप्पी फेस्तुस, हुंह निं बेगरअ आथी पर हुंह खोज़ा सत्त अर अक्लीए गल्‍ला। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />राज़अ बी, ज़हा सम्हनै हुंह नडरअ हई आसा बोल्दअ लागअ द, एऊ का बी आसा इना गल्‍लो थोघ। मुंह आसा ऐहा गल्‍लो विश्वास कि इना गल्‍ला मांझ़ै निं कोहै गल्‍ल एही आथी कि ज़ेतो एऊ का थोघ निं होए। किल्हैकि अह गल्‍ल निं किधी एकी पांडा भितरी आथी हुई-बिति दी। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />ए राज़अ अग्रिप्पा, तूह कै परमेशरे गूरो भरोस्सअ करा? हाँ, मुखा आसा थोघ कि तूह मना।”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />तेखअ बोलअ अग्रिप्पा पल़सी लै, “धख ज़ेही गल्‍ला समझ़ाऊई कै मुंह बी तूह मसीही च़ाहा बणाणअं?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पल़सी बोलअ, “परमेशरा का आसा मेरी प्राथणां कि कै थोल़ै दी अर कै खास्सै दी, सिधअ तूह ई निं पर ज़ेतरै लोग आझ़ मेरी गल्‍ला शूणैं आसा लागै दै, सोभ लोल़ी इना गल़ैऊंडी छ़ाडी मुंह ज़िहै हुऐ।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />तेखअ उझ़ुऐ राज़अ, राज़पाल, बिरनिके अर तिन्‍नां संघै बेशणै आल़ै सोभ खल़ै संघा लागै हांढदै। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />ज़ांऊं तिंयां बागै डेऊऐ, तिंयां लागै ज़ुदै-ज़ुदै डेऊई आप्पू मांझ़ै बोल्दै, “अह मणछ इहअ ता किछ़ै निं करदअ, ज़ुंण कैद करनै अर मौते सज़ा जोगी आसा।”<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />राज़ै अग्रिप्पा बोलअ फेस्तुस राज़पाला का, “ज़ै अह माहा राज़ै सेटा डेऊणे अरज़ नांईं करदअ, तै सका त अह छ़ुटी।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पल़सीए रोम देशे हांढ क्रेतै तैणीं</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />ज़ांऊं फेस्तुस राज़पालै इहअ फैंसलअ किअ कि हाम्हां लागणअ समुंदरे बाता ज़हाज़ा दी इटल़ी देशा लै डेऊणअ, तिन्‍नैं सभाल़ै पल़सी अर होर कई कैदी बी जूलिऊस नाओंए अगस्तुस माहा राज़ेए सपाही दले एकी सुबैदारे हाथै। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />अद्रमुतियम नगरीए ज़हाज़ा दी। सह ज़हाज़ डेऊणअ त एशिया मुल्खे बाढा बाती अर अरिस्तखोरस नाओं मणछ बी त हाम्हां संघा। सह थिअ मकिदुनिया मुल्खै थिस्सलूणी नगरी का।<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />दुजै धैल़ै पाअ हाम्हैं सैदा नगरी दी लंगर अर जूलिऊस सुबैदारै किई पल़सी लै एही दैआ कि तेऊ दैनअ आपणैं साथी-भाई सेटा डेऊणैं ताकि सह तिन्‍नां का ज़रूतीए च़िज़ा आणै। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />तिधा का ज़हाज़ खोल्ही च़लै हाम्हैं उंबल़ी बागरी च़लणें बज़्हा कुप्रास टापूए आडा दी। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />किलकिआ अर पंफूलिआ नगरी नेल़ समुंदरा बाती डेऊई पुजै हाम्हैं लासिआ मुल्खै मूरा नगरी। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />तिधी भेटअ सुबैदारा सकंदरीआ नगरीओ एक ज़हाज़ इटल़ी देशा लै डेऊंदअ अर तेऊ बशैल़ै हाम्हैं तेथ।<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />ज़ांऊं हाम्हैं खास्सै धैल़ै तैणीं सुलै-सुलै हांढदी करै कनिदुस नगरी पुजणअ कठण हुअ किल्हैकि बागरी निस्सी हाम्हां आजू डैऊणै दैई ती, अर हाम्हैं च़लै सलमोने सम्हनै बाती करै क्रेतै टापूए आडा दी आजू। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />तेते बाढै-बाढै बडी मसीबता दी च़ली करै शुभ लंगरबारी नाओंए एकी ज़ैगा पुजै, तिधा का थिई लासिआ नगरी नेल़।<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />ज़ांऊं खास्सै धैल़ै बितै, अर समुंदरे सफरा त आजू कठण ब्रते धैल़ी गई ती बिति अर आजू तै हिंऊंदे धैल़ै अर समुंदरै ती ढिश-बागर एछणें डअर, पल़सी समझ़ाऊऐ तिंयां,<verse eid="ACT 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 27:10" />“भलै मणछो, मुखा शुझिआ आजू इहअ कि एऊ सफरा दी आसा खास्सी हान्‍नी अर खरी एछणैं आल़ी, तम्हैं निं इहअ समझ़ी कि सिधअ ज़हाज़ा दी डाहअ द समान हणअ बरैबाद पर ज़हाज़े अर प्राणें बी आसा हान्‍नी हणैं आल़ी।”<verse eid="ACT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 27:11" />पर सुबैदारै मनी पल़सीए गल्‍ला का खास्सी ज़हाज़े दलपति अर मालके। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />सह बंज़र ज़ैगा नांईं ती हिंऊंदा काटणा लै ठीक बी आथी, तैही किअ सोभी इहअ बच़ार कि तिधा का ज़हाज़ खोल्ही ज़ै केऊ साबै हई सके, हाम्हां काटणै हिंऊंदे भिन्‍नैं फिनाका पुजी। अह क्रेतै टापूए बंज़र ज़ैगा थिई एक ज़हाज़ो आडअ ज़ेतो मोहरअ दखण-पछ़म अर उतर-पछ़मा बाखा खुल्हा त।<verse eid="ACT 27:12" /></para>
  <para style="s">समुंदरै ढिश-बागर</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />ज़ांऊं दखण दिशा बाखा सुलै-सुलै बागरी लागी, हाम्हैं सोठअ इहअ कि म्हारअ मतलब हुअ पूरअ, अर तिधा का लंगर च़की लागै हाम्हैं क्रेतै टापूए बाढै-बाढै आजू हांढदै। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />पर थोल़ी घल़ी बाद उझ़ुई तिधा का एक बडी ढिश-बागर, ज़हा लै “युरुकूलीन बोला।” <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />ज़ांऊं सह ज़हाज़ा दी लागी, ज़हाज़ निं बागरी आजू खल़्हुई सकअ, अर हाम्हैं दैनअ तेऊ आपणैं साबै बगणैं, अर इहअ ई करै रहै आजू बगदै लागी।<verse eid="ACT 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16" />तेखअ बान्हीं कौदा नाओंए एकी होछ़ै ज़िहै टापूए आडा दी बगदी-बगदी बडै मस्सा जाए किई हाम्हैं आपणीं होछ़ी किश्ती बशै, ज़हाज़ा च़लाऊंणैं आल़ै च़की सह किश्ती उझै, संघा डाही ज़हाज़ा दी। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />तिन्‍नैं डाहअ ज़हाज़ हेठा का प्रैंदै तैणीं राशै करै कशी ताकि समुंदरे च़िफलै रेता दी ज़हाज़ नां शाचे। तिन्‍नैं किअ लंगर धख उंधै अर ज़हाज़ा दैनअ बागरी लागणे साबै आजू बगणैं।<verse eid="ACT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18" />ज़ांऊं हाम्हैं ढिश-बागरी दी खास्सै झ़लारै अर ढेसै लागै, दुजै धैल़ै लागै तिंयां आपणैं ज़हाज़े समाना पाणीं जैंदरी शोटदै। <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />चिऊथै धैल़ै मुक्‍कै तिंयां आपणैं हाथै ज़हाज़ो समान शोटी। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />कई धैल़ै तैणीं नां सुरज़ शुझुअ अर नां तारै शुझुऐ, खास्सी ढिश-बागर ती च़लदी लागी दी अर खिरी हुई म्हारी ज़िऊंदै बच़ी रहणें आशा बी खतम।<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />ज़ांऊं तिंयां खास्सै धैल़ै भुखै रही मुक्‍कै, पल़सी उझ़ुअ खल़अ संघा बोलअ तिन्‍नां लै, “हे मणछो, हुअ ता लोल़ी ती इहअ कि तम्हैं मेरी गल्‍ला शुणदै अर क्रेतै का नां ज़हाज़ खोल्ही आजू हांढदै अर नां अह खरी अर हान्‍नी हंदी। <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />पर ऐबै समझ़ाऊआ हुंह तम्हां कि हैअ डाहा! किल्हैकि तम्हां मांझ़ै निं कोहै मरनै पर ज़हाज़ निं बच़ी सकदअ। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />किल्हैकि मेरअ परमेशर, ज़सरअ हुंह आसा, अर ज़हा परमेशरै हुंह च़ाकरी करा, तेऊए स्वर्ग दूतै बोलअ हिझ़ राची मुंह सेटा एछी,<verse eid="ACT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 27:24" />“‘हे पल़सी, डरै निं आथी, माहा राज़ै सेटा पुजणअ आसा तेरअ ज़रूरी। परमेशरै किई झींण अर इहअ करै हुऐ ईंयां सोभ लोग तेरै ज़ुंण ताह संघै एऊ ज़हाज़ा दी आसा लागै दै डैऊंदै।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />तैही बोला हुंह ओ साथीओ, हैअ डाहा, किल्हैकि हुंह करा परमेशरा दी भरोस्सअ, कि ज़िहअ मुखा खोज़अ द आसा, तिहअ ई हणअ। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पर हाम्हां लागणअ कहा टापू दी डेऊई रहणअ।”<verse eid="ACT 27:26" /></para>
  <para style="s">ज़हाज़ो चुटणअ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />ज़ांऊं च़ौदुई राच हुई, हाम्हैं लागै आन्द्रिया समुंदरै ठणाखदै, आधी राची ज़हाज़ च़लाऊंणैं आल़ै समझ़अ कि हाम्हैं पुजै कहा देशा नेल़। <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />तिन्‍नैं राश्शी पाई थाल्‍लैओ थोघ करी नापअ, पाणीं त कोई च़ाल़्ही गज़ डुघअ अर थोल़अ आजू डेऊई तिन्‍नैं भिई तिन्‍नैं राश्शी करै थाल्‍लैओ थोघ करी पाणीं नापअ, पाणीं त कोई तिह गज़। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />इहअ सोठी करै कि ज़हाज़ निं लोल़ी कधि शाफल़ा दी शाची करै चुटअ अर तिन्‍नैं बी शोटै ज़हाज़ा खरैल़णां लै पिछ़लै च़ार लंगर अर तेखअ रहै राची भैणै न्हैल़ै लागी।<verse eid="ACT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 27:30" />पर ज़ांऊं ज़हाज़ च़लाऊंणैं आल़ै ज़हाज़ा का ठुहर्नअ च़ाहा तै, तिन्‍नैं धुआल़ी ज़हाज़े मोहरै का लंगर पाणें भान्‍नै समुंदरै होछ़ी किश्ती। <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />तेखअ बोलअ पल़सी सुबैदार अर सपाही का, “ज़ै ईंयां ज़हाज़ा दी नांईं रहै तै निं तम्हैं कोहै बच़ी सकदै।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तेखअ पाऐ सपाही राशै काटी संघा शोटी सह होछ़ी किश्ती ज़हाज़ा का दूर।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />ज़ांऊं राच भैणै आल़ी ती, पल़सीए समझ़ाऊऐ सोभै इहअ बोली, सोभै रोटी खाणां लै, “आझ़ हुऐ च़ौदा धैल़ै, तम्हैं रहै बच़णे आशा दी भुखै, अर रोटी-पाणीं निं किछ़ै खाई। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />एता लै समझ़ाऊआ हुंह तम्हां का इहअ कि धख-धख खाआ, ज़ेता करै तम्हैं बच़ी सका, हैल़अ निं करा, तम्हां मांझ़ै निं कसरै मुंडो एक शराल़ बी बरैबाद हणअ।”<verse eid="ACT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 27:35" />तेखअ किअ इहअ बोली पल़सी रोटी चोल़ी करै परमेशरो शूकर, संघा दैनी रोटी चोल़ी करै सोभी लै खाणां लै। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />तेखअ लागै तिंयां सोभ एकी-दुजै लै हैअ दैई खांदै। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />हाम्हैं सोभै तै ज़हाज़ा दी दूई शौ छतर मणछ। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />ज़ांऊं तिंयां सोभै ज़ण्हैं रोटी खाई मुक्‍कै, तिंयां लागै कणके बोरी समुंदरै शोटी करै ज़हाज़े बोझ़ा हल़कै करदै।<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />ज़ांऊं राच भैई राम्बल़अ प्रैश्शअ हुअ, सह देश निं तिन्‍नैं बछ़ैणअ, पर एक खोहल़ शुझुई, तेतो त च़कोर बाढ, अर तिन्‍नैं सोठअ इहअ कि, ज़ै हई सके, इधी टकैल़णअ हाम्हां ज़हाज़। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />तेखअ छ़ाडै तिन्‍नैं ज़हाज़े लंगर खोल्ही समुंदरै। नढैऊऐ किई तिन्‍नैं राश्शी खोल्ही पतबारा ढिल्‍ली, आगलै पाल किऐ उझै खल़ै संघा लागै बाढा बाखा लै हांढदै।<verse eid="ACT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 27:41" />पर तिन्‍नैं टकैल़अ ज़हाज़ दूई समुंदरे कठा हणें ज़ैगा, ज़हाज़े मोहरै लै लागी ढेस अर सह शाचअ तिधी रेता जैंदरी संघा निस्सअ सह आजू-पिछ़ू सिक्‍की। पर पिछ़ली छ़ाल्‍लीए ज़ोरा करै लागअ ज़हाज़ चुटदअ।<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />तेखअ किअ सपाही इहअ बच़ार कि कैदी पाणै मारी इहअ निं हआ कि कोई पाणीं जैंदरी तरी करै ठुर्हे। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पर सुबैदार च़ाहा त पल़सी बच़ाऊंणअ अर तेऊ निं सपाही तिन्‍नां कोही कैदी मारनै दैनअ। पर तेऊ बोलअ हथू इहअ कि ज़ुंण पाणीं जैंदरी तरी सका, सह निखल़ा ज़हाज़ा का पैहलै छ़ाहल़ दैई समुंदरे बाढा लै <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />अर बाकी मणछ निखल़ा चुटी दी च़ाऊल़ी प्रैंदै, अर कोई ज़हाज़े च़िज़ा बस्तिए आसरै बाढै शुक्‍की ज़ैगा लै। इहअ करै पुजै सोभ समुंदरे बाढै शुक्‍की ज़ैगा राज्ज़ी-राम्बल़ै बच़ी।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">माल्टा टापू दी पल़सी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />ज़ांऊं हाम्हैं सोभै राज्ज़ी-राम्बल़ै बच़ी बाढै पुजै, तेखअ लागअ हाम्हां का थोघ कि एऊ टापू लै बोला माल्टा टापू। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />तिधे बशिंदै हुऐ हाम्हां लै खास्सै झणैल़ू, अर सह ती हाम्हां लै नुआहरी गल्‍ल। किल्हैकि हिंऊंदे धैल़ै त सरग लागअ द अर शेल़ै-ठांढै ज़ाल़ी तिन्‍नैं हाम्हां सोभी लै आग संघा डाहै हाम्हैं आप्पू सेटा।<verse eid="ACT 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 28:3" />ज़ांऊं पल़सी झ़ुको बरिंडअ झाल़ी करै आगीए घैनै दी पाअ, एक झ़रीली दानअ निखल़ी आगीए गरमीं करै अर सह पल़ेठुई पल़सीए हाथै। <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />ज़ांऊं तिन्‍नैं तिधे बशिंदै सह दानअ तेऊए हाथै च़ुंढुई दी भाल़ी, तिंयां लागै आप्पू मांझ़ै एही गल्‍ला करदै, “अह आसा सच्च़ी हत्या करनै आल़अ, समुंदरै डुबणै का ता गअ अह बच़ी पर म्हारी नसाफ करनै आल़ी देबी निं च़ाहंदी कि अह ज़िऊंदअ रहे।”<verse eid="ACT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 28:5" />तेखअ शोटी पल़सी सह दानअ आगी जैंदरी, अर तेऊ निं किछ़ै हान्‍नी हुई। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />पर तिंयां रहै न्हैल़ै लागी कि अह शुआणअ-धुआणअ अर तेभी बदल़णअ धरनीं अर तेखअ शोटणै एऊ प्राण। पर ज़ांऊं तिंयां खास्सी घल़ी भाल़ै रहै लागी अर तिन्‍नैं भाल़अ कि तेऊ निं किछ़ै हुअ, तिन्‍नैं सोठअ आपणैं मन्‍नैं इहअ कि अह आसा कोई देअ।<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />तैहा ज़ैगा ओरी-पोरी ती पुबलिऊस नाओंऐं तेऊ टापूए प्रधाने ज़िम्मीं, तेऊ निंयैं हाम्हैं आपणैं घअरा लै, संघा किई चिई धैल़ी धैल़ै तैणीं म्हारी प्राहुंणच़ारी अर खास्सअ अदर-भाअ।<verse eid="ACT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 28:8" />पुबलिऊस प्रधाने बाब त ज़अर अर दस्त लागै दै अर सह च़ैन्‍नै दी पल़अ द, पल़सी तेऊए घअरै डेऊई किई तेऊ लै प्राथणां, अर तेऊ दी हाथ लाई करै किअ सह राम्बल़अ। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />ज़ांऊं इहअ हुअ, तेऊ टापूए आऐ होर बमार बी सोभ पल़सी सेटा अर तिंयां बी किऐ तेऊ नरोगै। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />तिन्‍नैं सोभी किई म्हारी इज़त, अर ज़ांऊं हाम्हैं तिधा का आजू च़ाल्‍लै तै डेऊई, ज़ुंण किछ़ बी हाम्हां ज़रुरत ती, तिन्‍नैं डाही तिंयां सोभै गल्‍ला ज़हाज़ा दी।<verse eid="ACT 28:10" /></para>
  <para style="s">माल्टा टापू का रोम देशा बाखा लै</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />माल्टा टापू दी चिई भिन्‍नैं बाद बेठै हाम्हैं सकंदरीआ नगरीए एकी ज़हाज़ा दी अर च़लै आजू, सह ज़हाज़ त तेऊ टापू दी हिंऊंदे धैल़ै काटदअ खल़्हुअ द। तेऊ ज़हाज़े मोहरै दी त नछ़ैण “दोगल़ भाई” देअए मुहुर्ती। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सारकुस नगरी पुजी रहै हाम्हैं लंगर पाई चिई धैल़ै तिधी। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />तिधा का आऐ हाम्हैं फेर दैई रेगियम नगरी अर एकी धैल़ै बाद च़ली दखण बाखा बागरी अर तेखअ पुजै दुजै धैल़ै पुतियुली नगरी। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />तिधी मिलै हाम्हैं होरी विश्वासी भाई का अर तिन्‍नें बोल़णैं दी रहै हाम्हैं एकी हबतै तिधी, तिधा का पुजै हाम्हैं खिरी मसा जाई करै रोम।<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />तिधा का आऐ विश्वासी भाई म्हारअ समाद शूणीं गराऊंए च़फै चिई सराईं नगरी तैणीं हाम्हां मिलदै। तिन्‍नां भाल़ी किअ पल़सी परमेशरो शूकर अर तिन्‍नां लै दैनअ हैअ विश्वास।<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />ज़ांऊं हाम्हैं रोम पुजै, पल़सी लै दैनअ तेऊ सपाही संघै ज़ुदै ज़िहै एकी रहणैंओ हुकम ज़ुंण तेऊए हेर-सभाल़ करा त।<verse eid="ACT 28:16" /></para>
  <para style="s">रोम देशै पल़सी</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />चिई धैल़ै बाद शादै तेऊ यहूदी मणछे बडै लोग अर ज़ांऊं तिंयां कठा हुऐ, तिन्‍नां का बोलअ, “भाईओ, मंऐं निं आपणैं लोगा अर आपणैं दादा-बाबे बभारे खलाफ किछ़ै किअ, तैबी सभाल़अ कैदी हई हुंह एरुशलेम नगरी का रोम सरकारी सपाही का। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />तिन्‍नैं च़ाहअ हुंह मेरी पुछ़-ज़ाच़ करी छ़ाडणअ बी, किल्हैकि मुल्है निं मौत दैणैं जोगी किछ़ै दोश त।<verse eid="ACT 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 28:19" />“पर ज़ांऊं यहूदी सैणैं एते खलाफ बोल्दै लागै तेखअ पल़ी मुंह माहा राज़ै सेटा एछणें अरज़ करनी। एते तैणीं निं कि मुंह शाचअ आपणैं लोगा लै दोश लाणअ त। <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />तैही आसा मंऐं तम्हैं शादै दै कि तम्हां का मिलूं अर ऐहा गल्‍ला खोज़ी सकूं कि हुंह आसा एता पिछ़ू शांघल़ी करै बान्हीं डाहअ द। किल्हैकि हुंह करा विश्वास कि मसीहा मुक्‍कअ एछी, ज़हा एछणें आशा इज़राईल आसा।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />तिन्‍नैं यहूदी सैणैं बोलअ पल़सी लै, “नां हाम्हां तेरै बारै यहूदा मुल्खा का च़िठी भेटी, नां होरी भाई मांझ़ै तेरै बारै किज़ै खोज़अ अर नां बूरअ बोलअ। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />सह च़ाहा हाम्हैं ताखा शुणनअ, किल्हैकि हाम्हां का आसा थोघ कि कई ज़ैगा बोला एऊ मत्ते बारै लोग खलाफ गल्‍ला।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तेखअ काढी तिन्‍नैं तेऊ लै एक धैल़ी अर पांडा हुऐ खास्सै मणछ तेऊ सेटा कठा। पल़सी रहअ परमेशरे राज़े शाजत दैंदी, अर परमेशरे गूर मोसा खोज़ै दै बधाना अर परमेशरे होरी गूरे कताबा का प्रभू ईशूए बारै समझ़ाऊंदी दोत्ती का उडै तैणीं रह खोज़दअ लागी। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />तेखअ मनी कई तिंयां गल्‍ला, अर कई निं विश्वास किअ।<verse eid="ACT 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 28:25" />इहअ करै निं तिंयां आप्पू मांझ़ै एक मत्त हई सकै। तेखअ डेऊऐ तिंयां पल़सीए ऐहा गल्‍ले बोल़णैं दी तिधा का, “पबित्र आत्मां आसा परमेशरे गूर ईशायाहे कताबा दी थारै दादा-बाबा का ठीक ई बोलअ द,<note caller="-" style="x"><char style="xo" closed="false">28:25 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ईशा. 6:9-10</ref></char></note></para>
  <para style="q" vid="ACT 28:25">‘डेऊ इना लोगा लै बोल,<verse eid="ACT 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 28:26" />तम्हैं शुणदै ता रहणैं,</para>
  <para style="q" vid="ACT 28:26">पर तम्हां निं समझ़ पल़णीं</para>
  <para style="q" vid="ACT 28:26">तम्हैं भाल़ै ता रहणैं,</para>
  <para style="q" vid="ACT 28:26">पर तम्हां का निं थोघ लागणअ कि</para>
  <para style="q" vid="ACT 28:26">किज़ै आसा हंदअ लागणअ।<verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />किल्हैकि इना लोगो मन्‍न आसा काठअ</para>
  <para style="q" vid="ACT 28:27">अर इने कान आसा गर्कै हुऐ दै।</para>
  <para style="q" vid="ACT 28:27">इनै आसा आपणीं आछी बंद डाही दी करी।</para>
  <para style="q" vid="ACT 28:27">इहअ निं हआ कि तिंयां आपणीं आछी का भाल़े,</para>
  <para style="q" vid="ACT 28:27">काना का शुणें अर मना का समझ़े,</para>
  <para style="q" vid="ACT 28:27">अर मुंह बाखा फिरे</para>
  <para style="q" vid="ACT 28:27">अर हुंह तिन्‍नां राम्बल़ै करूं!’<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“तै तम्हैं समझ़ा, कि परमेशरे एऊ उद्धारे कथ्या छ़ाडी होरी ज़ाती सेटा लै अर तिन्‍नां शुणनी बी मनणी बी।”<note caller="-" style="x"><char style="xo" closed="false">28:28 </char><char style="xt" closed="false"><ref loc="PSA 67:2">भज. 67:2</ref>; <ref loc="PSA 98:3">98:3</ref>; <ref loc="ISA 40:5">ईशा. 40:5</ref></char></note><verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />ज़ांऊं पल़सी इहअ बोलअ, यहूदी लागै आप्पू मांझ़ै हठल़दै अर तिधा का डेऊऐ। <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />तेखअ रहअ पल़सी पूरी दूई साला तैणीं आपणैं कराऊऐ दैई एकी घअरा दी।<verse eid="ACT 28:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 28:31" />ज़ुंण तेऊ सेटा एछा तै, सह रहअ तिन्‍नां संघै मिलदअ लागी अर नधड़क परमेशरे राज़ो प्रच़ार करदअ लागी अर मसीहा ईशू प्रभूए गल्‍ला सखाऊंदअ लागी, तेऊ निं तेता लै कोहै रोक्‍कदअ आथी त।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>