  <para style="h">ओबेदिया</para>
  <para style="toc1">बिधातो गूर ओबेदिया</para>
  <para style="toc2">ओबेदिया</para>
  <para style="toc3">ओब.</para>
  <para style="mt1">ओबेदिया</para>
  <para style="mt2">बिधातो गूर ओबेदिया</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: ओबेदिया</para>
  <para style="ili">सन: 605 का 586 ईसा आजी</para>
  <para style="ip">ओबेदिया थिअ बिधातो गूर, पर तेऊए बारै निं खास्सअ थोघ आथी। ओबेदिया गूरे नाओं मतलब आसा, “बिधातो भगत।” ज़ुंण इज़राईला दी पराणैं ज़मानै आम आसा त।</para>
  <para style="ip">ओबेदिया आसा एदोम देशे बारै लिखअ द, ज़ुंण खारै समुंदरे दखणा बाखा आसा त। एदोम देशे लोग तै बिधाते परज़ा लै खास्सै नर्दैई हुऐ दै अर तैही ती बिधाता इज़राईले होरी दुशमण देशा ज़ेही तिन्‍नां लै बी सज़ा लाई दी दैई अर तिन्‍नें ज़ैगा ती लाई दी इज़राईला लै दैई।</para>
  <para style="imq">“बच़ाऊंणै आल़ै एछणैं सियोन धारा अर तिन्‍नां करनअ तैहा धारा राज़ ज़ेथ एसाबे आद-लुआद आसा बस्सै दै। तेखअ हणअ हुंह बिधाता आप्पै राज़अ!”</para>
  <para style="ipr">(1:21)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">शरेरै एदोम देशा लै सज़ा 1:9</para>
  <para style="io1">नर्दैई एदोम 1:10-12</para>
  <para style="io1">परमेशरे परज़े ज़ीत 1:15-21</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:5-17">ईशा. 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">जेर. 49:7-22</ref>; <ref loc="EZK 25:12-14">एज. 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11">आम. 1:11</ref>,<ref loc="AMO 1:12">12</ref>; <ref loc="MIC 1:2-5">मिक. 1:2-5</ref></char>
    </note>ईंयां आसा ओबेदिया खोज़ी दी गल्‍ला ज़ुंण तेऊ का मालक बिधाता एदोम देशे बारै धैनै-सुपनै खोज़ी।</para>
  <para style="s" vid="OBA 1:1">एदोम देशो बनाश</para>
  <para style="q" vid="OBA 1:1">बिधाता छ़ाडै देशा-देशा सेटा लै आपणैं दूत इहअ खोज़दै,</para>
  <para style="q" vid="OBA 1:1">“आपणीं सैना झाल़ा संघा हआ एदोम देशा संघै जुधा लै तैर।<verse eid="OBA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="OBA 1:2" />एदोम, मंऐं निं देशा-देशे मणछा जैंदरी तेरअ किछ़ ज़ोर डाहअ।</para>
  <para style="q" vid="OBA 1:2">तिन्‍नां निं तेरअ कोही अदर करनअ!<verse eid="OBA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="OBA 1:3" />ताह लागअ तेरै आपणैं ई घमंडा करै धोखअ,</para>
  <para style="q" vid="OBA 1:3">तेरी राज़धानी आसा बडी-बडी टोल्हा करै च़िणैं दै गहल़,</para>
  <para style="q" vid="OBA 1:3">अर तूह आसा उछ़टी धारा बस्सअ द।</para>
  <para style="q" vid="OBA 1:3">तूह करा एही शरेरी गल्‍ला, ‘मुंह निं इधा का उंधै कोह थुआल़ी सकदअ!’<verse eid="OBA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="OBA 1:4" />एही ता आसा तूह मुक्षरले कोल्हा ज़िहअ उछ़टी ज़ैगा बस्सअ द,</para>
  <para style="q" vid="OBA 1:4">ज़िहअ कि तेरअ घर आसा सरगे तारै जैंदरी,</para>
  <para style="q" vid="OBA 1:4">तज़ी बी थुआल़णअ मुंह तूह धरनीं।<verse eid="OBA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="OBA 1:5" />ज़ेभै राची च़ोर एछा, तिंयां च़ोरा ज़ेतरअ तिन्‍नों दिल बोला तेतरअ।</para>
  <para style="q" vid="OBA 1:5">ज़ेभै लोग दाख चोल़ा, तेथ छ़ुटा बेला दी पाचा मांझ़ै तिन्‍नां का धख एही।</para>
  <para style="q" vid="OBA 1:5">पर तेरै दुशमणै किअ तूह पठी रित्तअ।<verse eid="OBA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="OBA 1:6" />तिन्‍नैं लुटै एसाबे आद-लुआदे खज़ानै ज़ात पठी!<verse eid="OBA 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="OBA 1:7" />तेरी साथा ज़ुल़ै दै सोभी राज़ै दैनअ ताल्है धोखअ,</para>
  <para style="q" vid="OBA 1:7">तिन्‍नैं दरल़ाऊअ तूह तेरी आपणीं हदा भितरा लै।</para>
  <para style="q" vid="OBA 1:7">ताह संघै मेल़-ज़ोल़े करार करनै आल़ै ज़ितै ताखा ई।</para>
  <para style="q" vid="OBA 1:7">ताह संघै रोटी खाणैं आल़ै तेरै साथी आसा ताल्है ई ज़ज़ाल़ छ़ैअ द,</para>
  <para style="q" vid="OBA 1:7">तिंयां बोला ताल्है इहअ, ‘तेऊ निं समझ़ ई आथी!’”<verse eid="OBA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="OBA 1:8" />बिधाता बोला इहअ,</para>
  <para style="q" vid="OBA 1:8">“एदोम, ज़ेभै इहअ हणअ, तेभै करनी मुंह तेरी सारी अक्ल खतम,</para>
  <para style="q" vid="OBA 1:8">तिन्‍नां धारे समझ़कार पाणै मुंह सोभ मारी ज़ेथ एसाबे आद-लुआद आसा बस्सै दै।<verse eid="OBA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="OBA 1:9" />तेमान नगरीए मशूर जोधे हिम्मत बी चुटणीं पठी,</para>
  <para style="q" vid="OBA 1:9">तेरी धारा बस्सै दै एसाबे आद-लुआद पाणै मुंह सोभ मारी।<verse eid="OBA 1:9" /></para>
  <para style="s">सह कशूर ज़ेता पिछ़ू एदोम देशा लै सज़ा हुई</para>
  <para style="q">
    <verse number="10" style="v" sid="OBA 1:10" />एसाब, तंऐं लुटै आपणैं ई भाई-बंध!</para>
  <para style="q" vid="OBA 1:10">तंऐं पाऐ आपणैं भाऊ याकबे आद-लुआद मारी,</para>
  <para style="q" vid="OBA 1:10">ताह लागणअ शर्मिंदै हणअ, अर तूह हणअ सदा लै खतम।<verse eid="OBA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="OBA 1:11" />ज़धू पराऐ देशा का आऐ दै दुशमणै तेरै भाऊ याकबे ज़ैदात लुटी डेऊऐ,</para>
  <para style="q" vid="OBA 1:11">ज़धू परदेसी सैना एरुशलेम नगरी अर आप्पू मांझ़ै ज़ैदात बांडणां लै परच़ी पाई,</para>
  <para style="q" vid="OBA 1:11">तूह रहअ दूर खल़्हुई, ज़िहअ कि तूह त तिन्‍नां लुटणैं आल़ैओ साथी!<verse eid="OBA 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="OBA 1:12" />तेरै भाई-बंध यहूदा लै ती खास्सी आफ़त पल़ी दी।</para>
  <para style="q" vid="OBA 1:12">तूह रहअ तिन्‍नें बूरी दशा हंदी भाल़अ लागी!</para>
  <para style="q" vid="OBA 1:12">ज़धू यहूदा मुल्खे लोगा लै आफ़त ती पल़ी दी, अर तिंयां मरदै तै लागै दै,</para>
  <para style="q" vid="OBA 1:12">तूह त तेता लै खुश हुअ द! ताह निं इहअ लागा त करनअ।<verse eid="OBA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="OBA 1:13" />तधू निं ताह मेरी परज़े नगरी भितरी एछणअ लागा त।</para>
  <para style="q" vid="OBA 1:13">तूह रहअ तधू तिन्‍नें बूरी दशा हंदी भाल़अ लागी! ताह निं इहअ लागा त करनअ।</para>
  <para style="q" vid="OBA 1:13">एकी बाखा ती तिन्‍नां लै आफ़त पल़ी दी अर तंऐं लुटी तिन्‍नें धन-माया!</para>
  <para style="q" vid="OBA 1:13">ताह निं इहअ लागा त करनअ।<verse eid="OBA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="OBA 1:14" />तिंयां तै आपणीं ज़ान बच़ाऊंणा लै ठुर्हदै लागै दै,</para>
  <para style="q" vid="OBA 1:14">तूह त च़फै दी खल़्हुई तिन्‍नां मारदअ लागअ द! ताह निं इहअ लागा त करनअ।</para>
  <para style="q" vid="OBA 1:14">तेऊ बनाशा का ज़ुंण तेरै भाई-बंध बच़ै, तिंयां बझ़ैल़ै तंऐं दुशमणा का ढाकणैं!</para>
  <para style="q" vid="OBA 1:14">ताह निं इहअ लागा त करनअ।<verse eid="OBA 1:14" /></para>
  <para style="s">बिधाता करनअ देशा-देशो नसाफ</para>
  <para style="q">
    <verse number="15" style="v" sid="OBA 1:15" />सह धैल़ी आसा नेल़ ज़ेभै मुंह बिधाता देशा-देशो नसाफ करनअ।</para>
  <para style="q" vid="OBA 1:15">एदोम, ज़िहअ तंऐं किअ, ताल्है बी हणअ तिहअ ई।</para>
  <para style="q" vid="OBA 1:15">ज़ुंण तंऐं दैनअ, सह फिरनअ ताल्है बापस।<verse eid="OBA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="OBA 1:16" />मेरी पबित्र धारा झुटअ मेरी परज़ा इज़राईली</para>
  <para style="q" vid="OBA 1:16">मेरै प्रिहै का मेरै रोश्शो कल़ुअ घुप्पू।</para>
  <para style="q" vid="OBA 1:16">पर तिन्‍नां ओरी-पोरीए देशा झुटणअ तेता का बी खास्सअ कल़ुअ, ज़ुंण मेरी सज़ा आसा।</para>
  <para style="q" vid="OBA 1:16">तिन्‍नां झुटणअ, संघा हणैं तिंयां पठी खतम।<verse eid="OBA 1:16" /></para>
  <para style="s">खिरी हणीं इज़राईले ज़ीत</para>
  <para style="q">
    <verse number="17" style="v" sid="OBA 1:17" />पर मेरी परज़ा मांझ़ै बच़ै दै बस्सणै सियोन धारा।</para>
  <para style="q" vid="OBA 1:17">एरुशलेम नगरी हणीं भिई पबित्र ज़ैगा।</para>
  <para style="q" vid="OBA 1:17">याकबे आद-लुआदा भेटणअ भिई तिन्‍नें आपणीं ज़ैगा हक।<verse eid="OBA 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="OBA 1:18" />याकबे आद-लुआद हणैं आगी ज़िहै,</para>
  <para style="q" vid="OBA 1:18">युसुफे आद-लुआद हणैं लुप्पी ज़िहै।</para>
  <para style="q" vid="OBA 1:18">तिन्‍नां पाणअ एसाबे आद-लुआद भुखलै ज़िहअ दहई।</para>
  <para style="q" vid="OBA 1:18">एसाबे खिंबा दी निं एक बी ज़िऊंदअ बच़णअ।</para>
  <para style="q" vid="OBA 1:18">अह गल्‍ल डाही मंऐं बिधाता बोली।<verse eid="OBA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="OBA 1:19" />यहूदा मुल्खे दखणा बाखा मुल्खे लोगा करनअ एदोम देशै कबज़अ,</para>
  <para style="q" vid="OBA 1:19">धारा गोधै सऊंऐं मुल्खे लोगा करनअ पलिश्ती देशै कबज़अ।</para>
  <para style="q" vid="OBA 1:19">इज़राईली गिम्मणअ एप्रैम धारा बाखलअ मुल्ख अर सामरी मुल्ख आप्पू लै।</para>
  <para style="q" vid="OBA 1:19">बिन्यामीन गोत्रा आल़ै करनअ गलाद मुल्खै कबज़अ।<verse eid="OBA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="OBA 1:20" />उतरा बाखे इज़राईली एछणैं गलामी का बडी सैना ज़िहै फिरी,</para>
  <para style="q" vid="OBA 1:20">तिन्‍नां करनअ कनानी लोगे ज़ैगा सारपत नगरी तैणीं भिई कबज़अ।</para>
  <para style="q" vid="OBA 1:20">एरुशलेम नगरी का गलामी दी डेऊऐ दै ज़ुंण सपराद नगरी आसा बस्सै दै,</para>
  <para style="q" vid="OBA 1:20">तिन्‍नां करनअ कनान दखणा बाखा मुल्खे सोभी नगरी दी कबज़अ।<verse eid="OBA 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="OBA 1:21" />बच़ाऊंणै आल़ै एछणैं सियोन धारा अर तिन्‍नां करनअ तैहा धारा राज़</para>
  <para style="q" vid="OBA 1:21">ज़ेथ एसाबे आद-लुआद आसा बस्सै दै।</para>
  <para style="q" vid="OBA 1:21">तेखअ हणअ हुंह बिधाता आप्पै राज़अ!”<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>