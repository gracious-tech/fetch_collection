  <para style="h">लामण</para>
  <para style="toc1">दुखे पलका शोगे गिहा</para>
  <para style="toc2">लामण</para>
  <para style="toc3">लाम.</para>
  <para style="mt1">लामण</para>
  <para style="mt2">दुखे पलका शोगे गिहा</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जेरमयाह।</para>
  <para style="ili">सन: 586 का 584 ईसा आजी</para>
  <para style="ip">ऐहा कताबा दी आसा पांज़ कबिता ज़ेथ एरुशलेम नगरीए बरैबादीए बारै खास्सअ दुख आसा प्रगट किअ द। इना कबिता लै बोला लामण ज़ुंण लिखणैं आल़ै एरुशलेम नगरीए बारै आसा बोलै दै ज़ुंण गूर थिअ।</para>
  <para style="ip">इना कबिता पहल़ी ज़ाण्हिंआं इहअ कि एता लिखणैं आल़ै आसा दुशमण एरुशलेम बरैबाद करदै आपणीं आछी भाल़ै दै अर ज़धू ईंयां गल्‍ला हुई, सह थिअ तधू तिधी।</para>
  <para style="ip">तेऊ गूरै हेरअ त ज़ाणीं कि एरुशलेम नगरी लै लाई बिधाता सज़ा दैई किल्हैकि कि यहूदा मुल्खे लोगै किअ घोर पाप। पर तिन्‍नां पल़अ होर बी खास्सअ दुख ज़िरनअ ज़ेतरअ तिन्‍नां लै हुअ लोल़ी त। पर तज़ी बी थिई तिन्‍नां लै आशा। एकी धैल़ै जाणीं बिधाता भिई झींण फिरी ज़ै लोग पाप करनअ छ़ाडे अर परमेशरा बाखा लै फिरे।</para>
  <para style="iq">तेखअ डाहा हुंह तैहा गल्‍ला आद ज़ेता करै मुंह आशा रहा।</para>
  <para style="iq">बिधाते झींण निं कधि खतम हंदी!</para>
  <para style="iq">ज़ै सह झणैल़ू निं हंदअ,</para>
  <para style="iq">तै गऐ तै हाम्हैं कधू खतम हई।</para>
  <para style="iq">हर धैल़ै दोत्ती सका हाम्हैं बिधातो भरोस्सअ करी,</para>
  <para style="iq">तेऊओ सत्त आसा महान।</para>
  <para style="iq">हुंह बोला दिला का इहअ,</para>
  <para style="iq">“मेरी हर ज़रुरत आसा बिधाता, तैही रहा हुंह तेऊए आसरै!”</para>
  <para style="ipr">(3:21-24)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">जेरमयाह करा एरुशलेम नगरी लै शोग 1:1-22</para>
  <para style="io1">पाप करी पल़ा बिधातो कोप 2:1-22</para>
  <para style="io1">बिधाता निं आपणीं परज़ा कधि शोटी डाहंदअ 3:1-66</para>
  <para style="io1">एरुशलेम नगरीए शोभा हुई खतम 4:1-22</para>
  <para style="io1">जेरमयाह करा आपणैं लोगा लै अरज़ 5:122</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">एरुशलेम नगरी उपद्रभ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />एरुशलेम नगरी भाल़ केही शुन्‍नीं आसा पल़ी दी</para>
  <para style="q" vid="LAM 1:1">ज़ुंण कोई धैल़ै मणछा करै भरी हआ ती!</para>
  <para style="q" vid="LAM 1:1">कोई धैल़ै ती सह संसारै महान, पर ऐबै आसा सह बिधबा ज़ेही,</para>
  <para style="q" vid="LAM 1:1">एकी ज़मानै ती सह सोभी नगरी मांझ़ै राज़े देई ज़ेही,</para>
  <para style="q" vid="LAM 1:1">पर ऐबै आसा सह गलामी दी पल़ी दी।<verse eid="LAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />सह हआ सारी-सारी राची लेरा लांदी लागी दी,</para>
  <para style="q" vid="LAM 1:2">तेसे थोथरा बाती हआ आशूए ट्रिहुंणीं लागी दी।</para>
  <para style="q" vid="LAM 1:2">तेसे तै खास्सै लोभी, पर तिन्‍नां मांझ़ै निं एक बी तैहा झेठू आअ!</para>
  <para style="q" vid="LAM 1:2">तेसे साथी-संघी दैनअ तैहा लै धोखअ अर हुऐ सोभ तेसे दुशमण।<verse eid="LAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />यहूदा मुल्खे परज़ा निंईं दुशमणै गलाम बणाईं दूर।</para>
  <para style="q" vid="LAM 1:3">गलामा लागा बेठ खटणी अर आफ़त ज़िरनी,</para>
  <para style="q" vid="LAM 1:3">ऐबै आसा तिंयां पाखलै देशा जैंदरी रहंदै लागै दै।</para>
  <para style="q" vid="LAM 1:3">तिन्‍नां निं बशैघ ई आथी अर तिंयां आसा आपणैं घअरा का दूर।</para>
  <para style="q" vid="LAM 1:3">तिंयां आसा नर्दैई दुशमणै गोटै दै अर</para>
  <para style="q" vid="LAM 1:3">तिन्‍नां का निं तिंयां छ़ुटी सकदै!<verse eid="LAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />सियोन भबना डेऊणे बाता आसा ऐबै शोग पल़अ द,</para>
  <para style="q" vid="LAM 1:4">ऐबै निं तेथ तिह-थैरा मनाऊंदअ बिधाते भबनै कोह एछदअ!</para>
  <para style="q" vid="LAM 1:4">शोहरी ज़ुंण तेथ गिहा बोल्दी हआ ती, तिन्‍नां लै आसा घोर दुख पल़अ द,</para>
  <para style="q" vid="LAM 1:4">अर प्रोहत आसा धकदै लागै दै!</para>
  <para style="q" vid="LAM 1:4">नगरीए प्रऊल़ी आसा शुन्‍नीं पल़ी दी!</para>
  <para style="q" vid="LAM 1:4">एरुशलेम नगरीए लोग आसा खास्सै दुख ज़िरदै लागै दै।<verse eid="LAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />एरुशलेम नगरीए दुशमण हुऐ सफल अर</para>
  <para style="q" vid="LAM 1:5">तिंयां लागै एरुशलेम नगरी प्रैंदै राज़ करदै।</para>
  <para style="q" vid="LAM 1:5">बिधाता डाही सह दुख भुगतदी लाई</para>
  <para style="q" vid="LAM 1:5">किल्हैकि तैहा किऐ घोर पाप।</para>
  <para style="q" vid="LAM 1:5">तेसे दुशमणै निंयैं तेसे शोहरू-शोहरी गलामी लै दूर।<verse eid="LAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />एरुशलेम नगरीए शोभा हुई ऐबै खतम,</para>
  <para style="q" vid="LAM 1:6">ज़ुंण एरुशलेम नगरी राज़ करा तै, तिंयां हुऐ भुखी हरनी ज़िहै दुबल़ै</para>
  <para style="q" vid="LAM 1:6">ज़हा च़रना लै किछ़ घाह निं भेटदअ!</para>
  <para style="q" vid="LAM 1:6">तिंयां आसा तिन्‍नां दरल़ाऊंणै आल़ै दुशमणा आजू</para>
  <para style="q" vid="LAM 1:6">मस्सा ठुर्हदै लागै दै।<verse eid="LAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />एरुशलेम नगरीए मणछ आसा इना खरी अर बरैबादीए धैल़ै</para>
  <para style="q" vid="LAM 1:7">आपणीं शोभा अर धन-दौलती आद करदै लागै दै ज़ुंण तिन्‍नां का थिई।</para>
  <para style="q" vid="LAM 1:7">ऐबै पल़ै तिंयां दुशमणे हाथै अर तिन्‍नें मज़त करदअ निं कोह निखल़अ,</para>
  <para style="q" vid="LAM 1:7">तिन्‍नें बरैबादी भाल़ी लागै दुशमण तिन्‍नां लै हास्सदै।<verse eid="LAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />एरुशलेम नगरी घोर पाप करनैओ दोश,</para>
  <para style="q" vid="LAM 1:8">तैही लागी सोभी तैहा का च़िल़्ह।</para>
  <para style="q" vid="LAM 1:8">ज़ुंण तेसो अदर करा तै, तिंयां करा ऐबै तेसे बेइज़ती।</para>
  <para style="q" vid="LAM 1:8">किल्हैकि तिन्‍नैं भाल़ी सह नांगी।</para>
  <para style="q" vid="LAM 1:8">ऐबै आसा सह धकदी लागी दी अर</para>
  <para style="q" vid="LAM 1:8">सह आसा शरमैं आपणअ मुंह च़ोरदी लागी दी।<verse eid="LAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />छ़ोता करै आसा तेसे सारै झिकल़ै छ़िटुऐ दै,</para>
  <para style="q" vid="LAM 1:9">पर तैहा निं धख बी सोठअ कि तेसे हणीं एही दशा।</para>
  <para style="q" vid="LAM 1:9">तेसे हुई घोर बरैबादी, तेसे निं कोह झेठ करदअ।</para>
  <para style="q" vid="LAM 1:9">तेसे दुशमण ज़ितै तैहा का अर सह आसा बिधाता सेटा</para>
  <para style="q" vid="LAM 1:9">लेरा लाई अरज़ करदी लागी दी कि सह तैहा लै झींण करे।<verse eid="LAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />दुशमणै लुटै तेसे खज़ानै पठी,</para>
  <para style="q" vid="LAM 1:10">तैहा भाल़ै तिंयां लोग भबनै डेऊंदै आपणीं आछी,</para>
  <para style="q" vid="LAM 1:10">ज़िधी बिधाता पराई ज़ातीए लोगा डेऊंणा लै नांह आसा किअ द।<verse eid="LAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />एरुशलेम नगरीए लोग आसा धकदै</para>
  <para style="q" vid="LAM 1:11">अर खाणां लै रोटी लोल़ै लागै दै,</para>
  <para style="q" vid="LAM 1:11">तिंयां आसा आपणीं किम्मती च़िज़ा दैई रोटी मोल लंदै लागै दै</para>
  <para style="q" vid="LAM 1:11">ताकि तिंयां ज़िऊंदै बच़े!</para>
  <para style="q" vid="LAM 1:11">एरुशलेम नगरी बोला, “बिधाता, मुंह बाखा भाल़!</para>
  <para style="q" vid="LAM 1:11">मेरै भाल़ किहै हाल हुऐ! हुंह हुई बृथा!”<verse eid="LAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />तेस्सी बाती एछदै-डेऊंदै लै बोला सह इहअ,</para>
  <para style="q" vid="LAM 1:12">तम्हैं भाल़दै निं आथी कि मुंह संघै किज़ै हुअ?</para>
  <para style="q" vid="LAM 1:12">भाल़णीं दैआ कि मेरै किहै हाल हुऐ!</para>
  <para style="q" vid="LAM 1:12">ज़ेही आफ़त मुल्है पल़ी, तेही निं कोही लै पल़ी!</para>
  <para style="q" vid="LAM 1:12">अह खरी पाई मुल्है बिधाता अर तेऊ डाही हुंह दाह ज़िरदी लाई।</para>
  <para style="q" vid="LAM 1:12">तेऊओ रोश्श आसा मुल्है आगी ज़िहअ भकअ द।<verse eid="LAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />तेऊ शोटी मुल्है उझै का बीज अर</para>
  <para style="q" vid="LAM 1:13">तेता करै दझ़ै भितरा का मेरै हाडकै बी।</para>
  <para style="q" vid="LAM 1:13">तेऊ डाहअ मुंह ढाकणा लै ज़ज़ाल़ छ़ैई।</para>
  <para style="q" vid="LAM 1:13">तेखअ डाही तेऊ हुंह तिधी शोटी अर</para>
  <para style="q" vid="LAM 1:13">हुंह आसा कबल्‍ली दाह ज़िरदी अर दुबल़ी लागी दी हंदी।<verse eid="LAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />मेरै पाप बणाऐं परमेशरै मुल्है गर्कै जूँआं ज़िहै!</para>
  <para style="q" vid="LAM 1:14">तिंयां डाहै मालकै आपणैं हाथै ज़ोल़ी करै मेरै कैल़ै जोची।</para>
  <para style="q" vid="LAM 1:14">मेरै मालक बिधाता मुंह दी ज़ोर-ज़ाहण ई डाहै।</para>
  <para style="q" vid="LAM 1:14">तेऊ दैनी हुंह मेरै दुशमणा का सभाल़ी!</para>
  <para style="q" vid="LAM 1:14">हुंह निं तिन्‍नां का जुध ज़िती सकदी।<verse eid="LAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />मेरअ मालक बिधाता लागा मेरै सोभी का बडै शूरबीरा लै बी हास्सदअ,</para>
  <para style="q" vid="LAM 1:15">तेऊ छ़ाडी मेरै सोभी ज़ुआन मणछा मारदी सैना।</para>
  <para style="q" vid="LAM 1:15">तेऊ पिल्‍लै यहूदा मुल्खे मेरै लोग ज़ेही कोफरी दाख पिल्‍ला।<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रका. 14:20</ref>; <ref loc="REV 19:15">19:15</ref></char></note><verse eid="LAM 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />तैही आसा हुंह लेरा लांदी लागी दी,</para>
  <para style="q" vid="LAM 1:16">मेरी आछी का आसा आशूए छ़ो-छ़ंद लागै दै।</para>
  <para style="q" vid="LAM 1:16">मुंह निं कुंण झेठू बी एछदअ अर नां कुंण मुल्है हैअ दैणैं आल़अ आथी!</para>
  <para style="q" vid="LAM 1:16">दुशमण गऐ मुखा ज़िती अर मेरै लोगा का निं ऐबै किछ़ै बच़अ।<verse eid="LAM 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />मंऐं डाही आपणीं बाहा फुआरी</para>
  <para style="q" vid="LAM 1:17">पर मेरी मज़त निं कोही किई!</para>
  <para style="q" vid="LAM 1:17">बिधाता किअ इहअ हुकम कि याकबे आद-लुआदा</para>
  <para style="q" vid="LAM 1:17">फेर बस्सै दै लोग लोल़ी तिन्‍नें दुशमण हुऐ!</para>
  <para style="q" vid="LAM 1:17">एरुशलेम नगरी हुई तिन्‍नां जैंदरी छ़ोतली बेटल़ी ज़ेही।<verse eid="LAM 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />पर बिधाता आसा धर्मीं, मंऐं किअ तेऊ लै द्रोह!</para>
  <para style="q" vid="LAM 1:18">सोभै लोग शूणां, अर मेरी दाह भाल़ा!</para>
  <para style="q" vid="LAM 1:18">मेरै ज़ुआन शोहरू-शोहरी निंयैं गलामी लै।<verse eid="LAM 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />मंऐं लाई आपणैं सोभी साथी लै हाक्‍का,</para>
  <para style="q" vid="LAM 1:19">पर तिन्‍नैं दैनअ मुल्है धोखअ!</para>
  <para style="q" vid="LAM 1:19">प्रोहत अर सैणैं तै रोटी लोल़ै लागै दै कि तिंयां ज़िऊंदै बच़े,</para>
  <para style="q" vid="LAM 1:19">रोटी लोल़दी रहै तिंयां नगरी दी बाता मरी।<verse eid="LAM 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />बिधाता, मेरी खरी भाल़! मेरी शुक्‍की आंजा बी पठी!</para>
  <para style="q" vid="LAM 1:20">हुंह चुटी भितरा का पठी, किल्हैकि मंऐं किअ ताल्है द्रोह!</para>
  <para style="q" vid="LAM 1:20">घअरा बागै लाऐ मेरै लोग तलबारा करै काटी-मारी</para>
  <para style="q" vid="LAM 1:20">अर भितरी आसा मौत!<verse eid="LAM 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />लोगै शूणीं हुंह दाहै धकदी, पर झेठू निं कोह आऐ!</para>
  <para style="q" vid="LAM 1:21">मेरै दुशमण आसा खुश हुऐ दै कि तंऐं पाई मुल्है आफ़त।</para>
  <para style="q" vid="LAM 1:21">ऐबै कर तूह नसाफ ज़िहअ तंऐं बोलअ द आसा,</para>
  <para style="q" vid="LAM 1:21">ज़ेही आफ़त तंऐं मुल्है पाई, तेही पा तिन्‍नां लै बी।<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />बिधाता, ज़ीबाण, म्हारै दुशमणे पापा बी भाल़,</para>
  <para style="q" vid="LAM 1:22">ज़ेही सज़ा तंऐं मुल्है दैनी, तेही दै तिन्‍नां लै बी।</para>
  <para style="q" vid="LAM 1:22">मंऐं किऐ खास्सै पाप अर तेते दैनी तंऐं मुल्है सज़ा,</para>
  <para style="q" vid="LAM 1:22">हुंह हआ कबल्‍ली धकदी लागी दी अर हुंह हुई भितरा का बाख दुबल़ी।<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">एरुशलेम नगरी लै बिधाते सज़ा</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />भाल़ा, मालके रोश्शे बादल़ सियोन नगरी लै किहै घोर्हुऐ!</para>
  <para style="q" vid="LAM 2:1">तेऊ शोटी इज़राईले शोभा-शान सरगा का धरनीं!</para>
  <para style="q" vid="LAM 2:1">रोश्शै डाही तेऊ आपणीं नगरी बाखा पिठ फरेऊई।<verse eid="LAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />मालकै किऐ नर्दैई हई याकबे आद-लुआदे सोभ गराअं बरैबाद,</para>
  <para style="q" vid="LAM 2:2">यहूदा मुल्खे गहल़ पाऐ तेऊ रोश्शै ढोल़ी।</para>
  <para style="q" vid="LAM 2:2">तेऊ किअ तिन्‍नों राज़ खतम अर तिन्‍नें राज़ै बशैल़ै तेऊ धरनीं नकदरै।<verse eid="LAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />रोश्शै किअ तेऊ इज़राईलो बल खतम,</para>
  <para style="q" vid="LAM 2:3">सह हटअ तिन्‍नें मज़त करनै का पिछ़ू ज़ांऊं तिन्‍नें दुशमण आऐ,</para>
  <para style="q" vid="LAM 2:3">याकबे आद-लुआदा लै पल़अ तेऊओ रोश्श आगी ज़िहअ,</para>
  <para style="q" vid="LAM 2:3">तेता करै हुई तिन्‍नें सोभ गल्‍ला बरैबाद।<verse eid="LAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />तेऊ खिंच़ी दुशमणा ज़ेही कबाणा दी कतीर लाई डोर,</para>
  <para style="q" vid="LAM 2:4">अर आपणैं दैहणै हाथै आसा तेऊ तलबार हारी दी!</para>
  <para style="q" vid="LAM 2:4">तेऊ पाऐ दुशमणा ज़िहै सोभ ज़ुआन मर्ध मारी ज़ुंण हेरनै बित्तै थिऐ।</para>
  <para style="q" vid="LAM 2:4">तेऊओ रोश्श भकअ आगी ज़िहअ अर</para>
  <para style="q" vid="LAM 2:4">तेता करै दझ़ै एरुशलेम नगरी सोभिए घअर।<verse eid="LAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />मालकै किअ दुशमणा ज़िहअ इज़राईल बरैबाद,</para>
  <para style="q" vid="LAM 2:5">तेऊ डाहै तिन्‍नें ज़ैगा अर गहल़ उज़र करी शोटी।</para>
  <para style="q" vid="LAM 2:5">तेऊ डाहअ यहूदा मुल्खे लोगा लै कधि नां मुक्‍कदअ दुख पाई।<verse eid="LAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />बिधाता पाअ एरुशलेम आपणअ पबित्र भबन खेचे छ़ानीं ज़िहअ ढोल़ी!</para>
  <para style="q" vid="LAM 2:6">तेऊ किऐ आपणैं तिह-थैर अर बशैघे धैल़ी खतम।</para>
  <para style="q" vid="LAM 2:6">राज़ै अर प्रोहता लै बी पल़अ तेऊओ रोश्श आगी ज़िहअ।<verse eid="LAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />मालक बिधाता छ़ाडअ आपणअ पबित्र भबन अर तेथ आपणीं बेदी बी,</para>
  <para style="q" vid="LAM 2:7">तेऊ दैनअ दुशमणा तेते दुआली ढोल़णैं।</para>
  <para style="q" vid="LAM 2:7">ज़िधी कोई धैल़ै तिह-थैरे खुशीए ज़ैकारै हआ तै,</para>
  <para style="q" vid="LAM 2:7">तेथ लागै तिंयां दुशमण आप्पू ज़ितणें ज़ैकार करदै!<verse eid="LAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />बिधाता ती दिलै एही डाही दी कि</para>
  <para style="q" vid="LAM 2:8">तेऊ पाणीं एरुशलेम नगरीए दुआल ढोल़ी।</para>
  <para style="q" vid="LAM 2:8">तेऊ लाअ तेथ सूत संघा डाहै नशाण लाई,</para>
  <para style="q" vid="LAM 2:8">अर तेऊ दैनअ तेता पठी बरैबाद करनै।</para>
  <para style="q" vid="LAM 2:8">ऐबै पाऐ गहल़-कोट ढोल़ी, तिंयां आसा दुहै उज़र पल़ै दै।<verse eid="LAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />सियोन नगरीए प्रऊल़ी डुबी धरनीं, तेते द्रींडे किऐ ठोर-ठोर।</para>
  <para style="q" vid="LAM 2:9">राज़ै अर कार-करिंदै आसा परदेसी देशै गलामी दी डेऊऐ दै,</para>
  <para style="q" vid="LAM 2:9">ऐबै निं बिधातो बधान कोह खोज़दअ</para>
  <para style="q" vid="LAM 2:9">नां बिधाता कहा गूरा का धैनै-सुपनै गल्‍ला करदअ।<verse eid="LAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />एरुशलेम नगरीए सैणैं आसा धरनीं नड़क्‍क बेठै दै,</para>
  <para style="q" vid="LAM 2:10">तिन्‍नैं आसा आपणैं मुंडै छ़ार अर घेरी आसा शोगे खिंथल़ै बान्हैं दै।</para>
  <para style="q" vid="LAM 2:10">ज़ुआन बेटल़ी आसा उटअ मूंड करी लेरा लांदी लागी दी।<verse eid="LAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />लेरा लाई-लाई पल़ी मेरी आछी पाल्‍ली, मेरी शुक्‍की भितरी आंजा बी।</para>
  <para style="q" vid="LAM 2:11">आपणैं लोगो बनाश भाल़ी फुटअ भितरी मेरअ काल़ज़अ।</para>
  <para style="q" vid="LAM 2:11">लान्हैं अर दुधा झुटदै शोहरू-शोहरी आसा नगरीए बाता बेहोश पल़ै दै।<verse eid="LAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />नाज़ा बाझ़ी भुखै-नचिशै बोला तिंयां लान्हैं लेरा लांदी आपणीं ईजा लै,</para>
  <para style="q" vid="LAM 2:12">“रोटी अर दाखो रस किधी आसा?”</para>
  <para style="q" vid="LAM 2:12">तिंयां आसा नगरीए बाता अर च़फै ज़खमी मणछा ज़िहै बेहोश पल़ै दै।</para>
  <para style="q" vid="LAM 2:12">तिंयां आसा सुलै-सुलै आपणीं माए भोसल़ै मरदै लागै दै।<verse eid="LAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />एरुशलेम! हुंह ताल्है किज़ै बोलूं!</para>
  <para style="q" vid="LAM 2:13">हुंह तेरी केही झेठ करूं? एही दाह निं कोही हुई!</para>
  <para style="q" vid="LAM 2:13">तेरअ दुख आसा समुंदरा ज़िहअ खास्सअ</para>
  <para style="q" vid="LAM 2:13">एता का निं ताह कोहै बागै काढी सकदअ।<verse eid="LAM 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />तेरै गूरै ज़ुंण धैनै-सुपनै तेरै बारै खोज़ै तै, तिंयां थिऐ झ़ुठै!</para>
  <para style="q" vid="LAM 2:14">तिन्‍नैं निं खोज़अ ई आथी कि तूह ती पाप करदी लागी दी!</para>
  <para style="q" vid="LAM 2:14">तिन्‍नैं गूरै डाही तूह ठगी, तैही पल़ी ताल्है अह आफ़त।<verse eid="LAM 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />एसी बाती एछदै-डेऊंदै लागा तेरै सुहांगा करदै,</para>
  <para style="q" vid="LAM 2:15">एरुशलेम नगरीए बनाश भाल़ी लागा तिंयां मूंड झ़ल़ाऊई हास्सदै,</para>
  <para style="q" vid="LAM 2:15">“पृथूईए सोभी का बित्ती नगरी अह ई आसा?</para>
  <para style="q" vid="LAM 2:15">संसार ज़ेता लै घमंड करा, अह सह ई नगरी आसा?”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="MAT 27:39">मोत्त. 27:39</ref> </char></note><verse eid="LAM 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />एरुशलेम! तेरै सोभ दुशमण आसा ज़िदै ताल्है दांदा कटिल्‍लदै लागै दै,</para>
  <para style="q" vid="LAM 2:16">तिंयां बोला दांदा करै आपणैं होठ दाबी एकी दुजै लै,</para>
  <para style="q" vid="LAM 2:16">“हाम्हैं किई अह पठी बरैबाद! ऐहा ई धैल़ी ता हाम्हैं न्हैल़ै तै लागै दै!”<verse eid="LAM 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />ज़ुंण बिधाता करनअ त सोठअ द, सह किअ खिरी बिधाता पूरअ,</para>
  <para style="q" vid="LAM 2:17">ज़िहअ तेऊ खास्सी साला पैहलै त बोलअ द,</para>
  <para style="q" vid="LAM 2:17">तेऊ किअ नर्दैई हई तिहअ ई बनाश।</para>
  <para style="q" vid="LAM 2:17">एरुशलेम! तेऊ दैनअ तेरै दुशमणा ताखा ज़ितणैं</para>
  <para style="q" vid="LAM 2:17">ताल्है हास्सणैं अर तेरअ सुहांग करनै।<verse eid="LAM 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />एरुशलेम नगरीए लोगो! दिला का लाआ आपणैं मालक बिधाता सेटा लेरा!</para>
  <para style="q" vid="LAM 2:18">धैल़-राच लोल़ी थारी आछी का आशूए गाडा बगी,</para>
  <para style="q" vid="LAM 2:18">कबल्‍लै रहा लेरा लांदै लागी, आछी का निं लोल़ी आशू शुक्‍कै।<verse eid="LAM 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />सारी राची उझ़िआ हर पहरै भिई-भिई खल़ै,</para>
  <para style="q" vid="LAM 2:19">संघा पाआ आपणैं मालक बिधाता सेटा लेर-पकार,</para>
  <para style="q" vid="LAM 2:19">आपणैं दिले गल्‍ला दैआ तेऊ सेटा पाणीं ज़ेही तरैल़ी,</para>
  <para style="q" vid="LAM 2:19">आपणीं बाहा फुआरी करा तेऊ सेटा अरज़</para>
  <para style="q" vid="LAM 2:19">कि सह थारै लान्हैं शोहरू-शोहरी लै झींण करे अर</para>
  <para style="q" vid="LAM 2:19">तिंयां ज़िऊंदै बच़े ज़ुंण नगरीए बाता बेहोश आसा पल़ै दै!<verse eid="LAM 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />हे म्हारै मालक बिधाता! तूह किल्है आसा हाम्हां लै</para>
  <para style="q" vid="LAM 2:20">एही घोर सज़ा दैंदअ लागअ द?</para>
  <para style="q" vid="LAM 2:20">भुखै आसा बेटल़ी आपणैं मूंऐं दै शोहरू खांदी लागी द!</para>
  <para style="q" vid="LAM 2:20">प्रोहत अर गूर पाऐ तेरै पबित्र भबनै मारी!<verse eid="LAM 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />लान्हैं अर प्रोढे ल्हासा आसा नगरीए बाता पल़ी दी,</para>
  <para style="q" vid="LAM 2:21">ज़ुआन मर्ध अर बेटल़ी पाऐ दुशमणै तलबारा करै मारी।</para>
  <para style="q" vid="LAM 2:21">रोश्शै धैल़ै काटै-फणाटै तंऐं तिंयां बेघै नर्दैई हई करै।<verse eid="LAM 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />ज़िहै बिधाते तिह-थैरा लै लोग फेरा-फेर झाल़्हिआ,</para>
  <para style="q" vid="LAM 2:22">तिहै शादै तंऐं मुंह हंतणैं आल़ै मेरै दुशमण फेरा-फेर।</para>
  <para style="q" vid="LAM 2:22">तैहा तेरी रोश्शे धैल़ी निं कोह बच़ी सकदअ।</para>
  <para style="q" vid="LAM 2:22">तिन्‍नैं किई मेरै धाचै दै शोहरू-शोहरीए हत्या ज़हा लै हुंह खास्सी झ़ूरा ती।<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">आजू लै आशा</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />हुंह आसा सह मणछ ज़ुंणी बिधाते कोप ज़िरअ अर सज़ा भुगती।<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />परमेशरै दरल़ाऊअ हुंह दूर घणैं अर नटिप्प न्हैरै जैंदरा लै।<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />सह हुअ मुखा बाख दूर अर तेऊ डाही मुल्है कबल्‍ली आफ़त पाई।<verse eid="LAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />तेऊ दहई-प्लुशी मेरी सारी देही अर मेरै हाडकै पाऐ चोल़ी।<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />तेऊ गोटअ हुंह फेरा-फेर अर तेऊ डाही मुल्है घोर आफ़त पाई</para>
  <para style="q" vid="LAM 3:5">अर तेऊ किई मुल्है हर गल्‍ला कठण।<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />तेऊ डाहअ हुंह मुल्दै ज़िहअ न्हैरै दी बशैल़ी</para>
  <para style="q" vid="LAM 3:6">ज़िहअ कि हुंह आसा होए खास्सी साला पैहलै मरी गअ द!<verse eid="LAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />तेऊ डाहअ हुंह शांघल़ी करै बान्हीं अर फेरा का गोटी,</para>
  <para style="q" vid="LAM 3:7">हुंह निं तेता का छ़ुटी ई सकदअ।<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />मंऐं मांगी ज़ोरै-ज़ोरै हाक्‍का लाई मज़त,</para>
  <para style="q" vid="LAM 3:8">पर बिधाता निं मेरी अरज़ शूणीं ई,<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />ज़हा बाता बी हुंह फिरा, तेथ आसा तेऊ</para>
  <para style="q" vid="LAM 3:9">बडी-बडी टोल्हा करै बाल़ डाहै दै अर तेता निं हुंह लंघी सकदअ।<verse eid="LAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />सह आसा मुल्है भाल्‍लू अर सिहा ज़िहअ ताखुई रहअ द,<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />तेऊ ढाकअ हुंह बाता संघा डाहअ धेल़ी-च़िरी तेतै शोटी।<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />परमेशरै खिंच़ी आपणैं कबाणे डोर अर</para>
  <para style="q" vid="LAM 3:12">कतीरो नशाणअ आसा मुंह बाखा डाहअ द लाई।<verse eid="LAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />तेऊए कतीर खुभै मेरै भितरी काल़ज़ै दी।<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />लोग हआ मुल्है सारी धैल़ी हास्सदै लागै दै,</para>
  <para style="q" vid="LAM 3:14">हुंह किअ तिन्‍नें सुहांगा लै।<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />परमेशरै दैनी मुल्है कल़ुऐ नागदौणा ज़ेही दाह,</para>
  <para style="q" vid="LAM 3:15">तेता खैऊई-पणैऊंईं शोटअ हुंह रज़ैऊई।<verse eid="LAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />तेऊ ढुशअ हुंह धरनीं शदल़ू जैंदरी</para>
  <para style="q" vid="LAM 3:16">तेथ चुटै मेरै दांद बी पठी।<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />हुंह बिस्सरुअ, नरोगी ज़िन्दगी भलाई अर खुशी पठी।<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />हुंह लागअ आप्पू लै इहअ बोल्दअ कि मुंह निं तराण ई आथी रहै दै! नां मुंह बिधाता दी आशा रही!<verse eid="LAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />मुंह एछा सिधी दाह, घअरा का दूर रहणअ</para>
  <para style="q" vid="LAM 3:19">अर नागदौण अर बिश झुटणअ आद।<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />अह बगत एछा मुंह कबल्‍लअ आद,</para>
  <para style="q" vid="LAM 3:20">एता करै च़ाल्‍लअ मेरअ शाह निखल़ी।<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />तेखअ डाहा हुंह तैहा गल्‍ला आद ज़ेता करै मुंह आशा रहा।<verse eid="LAM 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />बिधाते झींण निं कधि खतम हंदी!</para>
  <para style="q" vid="LAM 3:22">ज़ै सह झणैल़ू निं हंदअ,</para>
  <para style="q" vid="LAM 3:22">तै गऐ तै हाम्हैं कधू खतम हई।<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />हर धैल़ै दोत्ती सका हाम्हैं बिधातो भरोस्सअ करी,</para>
  <para style="q" vid="LAM 3:23">तेऊओ सत्त आसा महान।<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />हुंह बोला दिला का इहअ,</para>
  <para style="q" vid="LAM 3:24">“मेरी हर ज़रुरत आसा बिधाता, तैही रहा हुंह तेऊए आसरै।”<verse eid="LAM 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />बिधाता आसा तिन्‍नां लै भलअ ज़ुंण तेऊए आसरै रहा,<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />मणछा लै भलअ आसा इहअ ई कि सह बिधाते आसरै रहे,</para>
  <para style="q" vid="LAM 3:26">अर च़ुपच़ाप रही न्हैल़अ रहे, किल्हैकि तेऊ हेरनै बच़ाऊई।<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />मणछा लै आसा भलअ कि बिधातो जूँ ज़ुआनी दी च़के।<verse eid="LAM 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />ज़ेभै ज़ाण्हिंए कि बिधाता दैनी तेऊ लै सज़ा,</para>
  <para style="q" vid="LAM 3:28">सह लागा मनणी अर तेता लै लागा सबर करनअ।<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />तेऊ मणछा लागा बिधाता सेटा माथअ टेक्‍कणअ,</para>
  <para style="q" vid="LAM 3:29">हई सका कि तेऊए बच़णे कोई आशा रहे।<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />ज़ै तेऊ कुंण च़िक्‍के-मारे अर बेइज़त करे,</para>
  <para style="q" vid="LAM 3:30">सह बी लागा तेऊ मनणी।<verse eid="LAM 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />मालक आसा झणैल़ू अर सह निं हाम्हां सदा शोटी डाहंदअ।<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />हई सका कि सह हाम्हां लै दुख दैए,</para>
  <para style="q" vid="LAM 3:32">सह करा हाम्हां लै झींण बी, किल्हैकि सह झ़ूरा हाम्हां लै खास्सअ।<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />सह निं हाम्हां लै दाह-दुख दैणा लै खुश हंदअ।<verse eid="LAM 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />बिधाता का आसा इना सोभी गल्‍लो थोघ कि</para>
  <para style="q" vid="LAM 3:34">कैदी झेचा लोग आपणैं खूरा हेठै।<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />ज़ेभै लोग दुजैओ हक दैणैं का हुधिआ,</para>
  <para style="q" vid="LAM 3:35">परम प्रधान परमेशरा का हआ तेतो बी थोघ।<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />ज़ेभै कहा मणछा लै शुचअ नसाफ निं भेटदअ,</para>
  <para style="q" vid="LAM 3:36">तेतो बी हआ मालका का थोघ।<verse eid="LAM 3:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />ज़ै कुंण मणछ बोले कि आजू लोल़ी फलाणीं गल्‍ल हुई,</para>
  <para style="q" vid="LAM 3:37">सह निं तेऊ मालका बाझ़ी पूरी हई सकदी।<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />सोभी गल्‍ला करनै आल़अ आसा परम प्रधान परमेशर,</para>
  <para style="q" vid="LAM 3:38">भली अर बूरी गल्‍ला हणां लै करा सह ई हुकम।<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />ज़ेभै मणछ पाप करा, तेता लै सज़ा दैआ सह ई,</para>
  <para style="q" vid="LAM 3:39">ज़ुंण मणछ ज़िऊंदै आसा, तिन्‍नां निं बिधाते खरी खोज़दै लागणअ।<verse eid="LAM 3:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />हथू लागा हाम्हां आप्पू बाखा भाल़णअ कि हाम्हैं किज़ै करा,</para>
  <para style="q" vid="LAM 3:40">अर हाम्हां लागा बिधाता बाखा लै बापस फिरनअ।<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />हाम्हां लागा आपणीं बाहा उझै स्वर्गा बाखा फुआरी</para>
  <para style="q" vid="LAM 3:41">परमेशरा सेटा तत्त-दिला का एही अरज़ करनी,<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />“हाम्हैं किअ द्रोह अर पाप!</para>
  <para style="q" vid="LAM 3:42">हे बिधाता, तंऐं निं हाम्हां लै माफी छ़ाडी आथी।<verse eid="LAM 3:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />तंऐं डाही रोश्शै हाम्हां बाखा पिठ फरेऊई,</para>
  <para style="q" vid="LAM 3:43">तूह पल़अ म्हारै पिछ़ै अर तंऐं पाऐ हाम्हैं मारी!<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />तूह रहअ हाम्हां का तेरै रोश्शे बादल़ा पिछ़ू लुक्‍की,</para>
  <para style="q" vid="LAM 3:44">तिन्‍नां बादल़ा करै निस्सी म्हारी अरज़ ताह सेटा पुजी।<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />तंऐं डाहै हाम्हैं संसारै आल़-जाल़ो रूल़ बणाईं।<note caller="-" style="x"><char style="xo" closed="false">3:45 </char><char style="xt" closed="false"><ref loc="1CO 4:13">1 करि. 4:13</ref></char></note><verse eid="LAM 3:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />म्हारै दुशमण आसा हास्सदै अर म्हारी बेइज़ती करदै लागै दै!<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />हाम्हां आसा डअर-भगैर लागी दी,</para>
  <para style="q" vid="LAM 3:47">म्हारअ हुअ बनाश अर म्हारी हुई सोभ गल्‍ला बरैबाद।”<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />आपणैं लोगो बनाश भाल़ी बगी मेरी आछी का आशूए गाडा।<verse eid="LAM 3:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />आशूए गाडा रहणीं कबल्‍ली लागी दी,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />ज़ेभै तैणीं बिधाता स्वर्गा का उंधै हाम्हां बाखा निं भाल़े।<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />ज़ांऊं मुखा मेरी नगरीए सोभै बेटल़ी शोग करदी शुझिआ,</para>
  <para style="q" vid="LAM 3:51">तेता करै हआ हुंह भितरा का होर बी दुखी।<verse eid="LAM 3:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />मेरै दुशमणै किअ थोघै बाझ़ी मेरअ पिछ़अ,</para>
  <para style="q" vid="LAM 3:52">तिन्‍नैं ढाकअ हुंह ज़िहअ शकारी च़ेल्‍लू ढाका!<note caller="-" style="x"><char style="xo" closed="false">3:52 </char><char style="xt" closed="false"><ref loc="PSA 35:7">भज. 35:7</ref></char></note><verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />तिन्‍नैं डाहअ हुंह ज़िऊंदअ खात्ती दी दाबी अर</para>
  <para style="q" vid="LAM 3:53">खात्ती प्रैंदै डाही टोल्हा बदल़ी।<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />पाणीं पुजअ मेरै मुंडा तैणीं, मंऐं सोठअ कि ऐबै मरनअ हुंह।<verse eid="LAM 3:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />हे बिधाता, डुघी खात्ती भितरा का पाई मंऐं ताह सेटा लेर-पकार,<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />मंऐं किई ताह सेटा अरज़,</para>
  <para style="q" vid="LAM 3:56">“ज़ीबाण, मेरी लेर-पकार शुण, हुंह मांगा ताखा मज़त।”</para>
  <para style="q" vid="LAM 3:56">तेखअ हेरी तंऐं मेरी अरज़ शूणीं।<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />तंऐं दैनअ मुल्है ज़बाब अर तंऐं बोलअ,</para>
  <para style="q" vid="LAM 3:57">“तूह निं डरै आथी।”<verse eid="LAM 3:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />हे मेरै मालक, तूह आअ संघा बच़ाऊई मेरी ज़िन्दगी।<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />बिधाता, तंऐं भाल़अ कि लोगै मुल्है किहअ ज़ुल्म किअ,</para>
  <para style="q" vid="LAM 3:59">ऐबै कर मेरअ नसाफ बी तूह ई।<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />ताखा आसा थोघ कि मेरै केतरै दुशमण डाहा मुंह संघै ज़ीद अर</para>
  <para style="q" vid="LAM 3:60">तिंयां मुल्है किहअ बूरअ करनअ च़ाहा।<verse eid="LAM 3:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />हे बिधाता, तंऐं शूणैं तिंयां मेरी बेइज़ती करदै,</para>
  <para style="q" vid="LAM 3:61">तिन्‍नें मुल्है बूरी सोठ बी आसा ताखा थोघ।<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />तिंयां हआ सारी-सारी धैल़ी मेरै बारै गल्‍ला करदै लागै दै अर</para>
  <para style="q" vid="LAM 3:62">मेरी हान्‍नी करने बिक्री सोठदै लागै दै।<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />दोत्ता पोर्ही उडै तैणीं हआ तिंयां मेरै सुहांगा लागै दै।<verse eid="LAM 3:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />हे बिधाता, ज़ुंण तिन्‍नैं किअ, तेता लै दै तूह तिन्‍नां लै आप्पै सज़ा।<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />तिन्‍नां लै दै फिटक कि तिन्‍नें दमाग लोल़ी नड़क्‍क हुअ।<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />हे बिधाता, तिन्‍नां मार इहै कि तिन्‍नों निं</para>
  <para style="q" vid="LAM 3:66">धरती दी नाअं-नशाण लोल़ी रहअ।<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">बनाश हणैं बाद एरुशलेम</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />सुन्‍नअ फिरअ पठ शेफल़अ! च़ोखअ सुन्‍नअ निखल़अ खोटअ!<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">सुन्‍नअ लुक्‍कअ पठी</char></note></para>
  <para style="q" vid="LAM 4:1">पबित्र ज़ैगे किम्मती पात्थर डाहा सोभी बाते डोरै शोटी।<verse eid="LAM 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />सियोन नगरीए मर्ध तै च़ोखै सुन्‍नैं ज़िहै किम्मती,</para>
  <para style="q" vid="LAM 4:2">पर ऐबै पाऐ तिंयां खमारै बणाऐं दै माट्टे आम भांडै ज़िहै फाल़ी।<verse eid="LAM 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />शैल़ी बी धाचा आपणैं बच़ै आपणीं च़ूई पणैऊंईं करै,</para>
  <para style="q" vid="LAM 4:3">पर एरुशलेम नगरीए बेटल़ी हुई आपणैं शोहरू लै शुतरमुर्गी ज़ेही नर्दैई</para>
  <para style="q" vid="LAM 4:3">ज़ुंण आपणैं आंडै शोटी डाहा।<verse eid="LAM 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />तिन्‍नैं डाहै आपणैं दुधा झुटदै बच़ै भुखै-नचिशै शोटी,</para>
  <para style="q" vid="LAM 4:4">लान्हैं आसा रोटी मांगदै लागै दै, पर तिन्‍नां लै निं कोह किछ़ दैंदअ।<verse eid="LAM 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />ज़ुंण पैहलै बधिया-बधिया भोज़ खाआ तै,</para>
  <para style="q" vid="LAM 4:5">तिंयां आसा बाता मरदै पल़ै दै,</para>
  <para style="q" vid="LAM 4:5">ज़ुंण मुखमले झिकल़ै जैंदरी रहा तै, तिंयां आसा</para>
  <para style="q" vid="LAM 4:5">शणैंऊंए रूल़ा जैंदरा का टुकरै लोल़ै लागै दै!<verse eid="LAM 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />परमेशरै दैनी एरुशलेम बस्सै दै मेरै लोगा लै सज़ा।</para>
  <para style="q" vid="LAM 4:6">तेऊ दैनी हाम्हां लै सदोम नगरी का बी खास्सी घोर सज़ा।</para>
  <para style="q" vid="LAM 4:6">सह नगरी किई ती बिधाता एकी घल़ी भितरी बरैबाद अर</para>
  <para style="q" vid="LAM 4:6">तिधी निं तिन्‍नां बच़ाऊंणै आल़अ बी कोह थिअ।<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24-25">मूल. 19:24-25</ref></char></note><verse eid="LAM 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />एकी ज़मानै तै म्हारै सैणैं शुचै-पाक्‍कै,</para>
  <para style="q" vid="LAM 4:7">तिंयां थिऐ शेतै हिंऊंआं ज़िहै निम्बल़ै अर दुधा ज़िहै शेतै।</para>
  <para style="q" vid="LAM 4:7">तिंयां थिऐ ताज़ै-नरोगै अर तिन्‍नें देही का लागा त नीलमणीं ज़िहअ च़लकार।<verse eid="LAM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />पर ऐबै आसा तिन्‍नें मुंह ज़ाल्‍लै ज़िहै काल़ै फिरै दै,</para>
  <para style="q" vid="LAM 4:8">तिन्‍नां निं बाता कोह बछ़ैणदअ आथी!</para>
  <para style="q" vid="LAM 4:8">तिन्‍नें खाल शाची हाडकै दी ल़पट्ट अर तिंयां हुऐ काठा ज़िहै शुक्‍कै।<verse eid="LAM 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />म्हारै लोग ईंयां ज़ुंण बादा का भुखै-नचिशै मूंऐं, तेता का भलअ हुअ</para>
  <para style="q" vid="LAM 4:9">म्हारै तिन्‍नां मणछा लै ज़ुंण दुशमणै जुधा दी तलबारा करै मारै।<verse eid="LAM 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />झींण करनै आल़ी माआ,</para>
  <para style="q" vid="LAM 4:10">सेटेऊअ आपणैं बच्च़ैओ मास्स आप्पै!</para>
  <para style="q" vid="LAM 4:10">ज़ांऊं दुशमण नगरीओ बनाश करदै लागै,</para>
  <para style="q" vid="LAM 4:10">तिन्‍नैं खाई आपणैं लान्हैं-सुन्हें शिखा!<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 28:57">बधा. 28:57</ref>; <ref loc="EZK 5:10">एज. 5:10</ref></char></note><verse eid="LAM 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />बिधाता काढअ तिन्‍नां प्रैंदै आपणअ सारअ रोश्श,</para>
  <para style="q" vid="LAM 4:11">तेऊ बरशाऊई एरुशलेम नगरी लै आग अर</para>
  <para style="q" vid="LAM 4:11">तेता करै हुअ सारी नगरीओ थाल्‍लै तैणीं बनाश।<verse eid="LAM 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />ऐहा गल्‍ला दी निं होरी देशे राज़ै बी विश्वास करी सकै,</para>
  <para style="q" vid="LAM 4:12">नां संसारे होरी लोगा विश्वास हुअ कि</para>
  <para style="q" vid="LAM 4:12">द्रोही अर दुशमण सका एरुशलेम नगरीए प्रऊल़ी भितरी डेऊई।<verse eid="LAM 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />पर असली दी हुअ इहअ ई!</para>
  <para style="q" vid="LAM 4:13">किल्हैकि एरुशलेम नगरीए गूरै अर प्रोहतै किअ पाप।</para>
  <para style="q" vid="LAM 4:13">तिंयां रहै ऐहा नगरी दी धर्मीं मणछे हत्या करदै लागी।<verse eid="LAM 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />नगरीए सैणैं आसा ऐबै कांणै मणछा ज़िहै</para>
  <para style="q" vid="LAM 4:14">ज़ैगै-ज़ैगै हांढदै अर रल़ाखदै लागै दै।</para>
  <para style="q" vid="LAM 4:14">तिन्‍नें झिकल़ै आसा लोधल़ै करै छ़िटुऐ दै कि</para>
  <para style="q" vid="LAM 4:14">तिन्‍नां निं कोहै छ़ुंहंदअ बी आथी।<verse eid="LAM 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />लोग बोला तिन्‍नां लै, “दूर रहा! दूर रहा!</para>
  <para style="q" vid="LAM 4:15">तम्हैं आसा छ़ोतलै! हाम्हां निं छ़ुंहीं आथी!”</para>
  <para style="q" vid="LAM 4:15">तिंयां रहै देशै-देशै ठुल़्दै लागी, पराई ज़ातीए लोगै बी बोलअ,</para>
  <para style="q" vid="LAM 4:15">“ईंयां निं हाम्हां संघै लोल़ी रहै।”<verse eid="LAM 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />बिधाता डाहै रोश्शै लोग आप्पै देशै-देशै छिंगी,</para>
  <para style="q" vid="LAM 4:16">सह निं ऐबै तिन्‍नों धैन-खैल करदअ,</para>
  <para style="q" vid="LAM 4:16">नां कुंण प्रोहतो अदर करदअ नां कुंण सैणैं लै झींण करदअ।<verse eid="LAM 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />हाम्हां लै निं किधी का किछ़ै मज़त आई!</para>
  <para style="q" vid="LAM 4:17">न्हैल़ी भाल़ी-भाल़ी फिरी म्हारी आछी बी पाल्‍ली।</para>
  <para style="q" vid="LAM 4:17">हाम्हैं रहै इहै देशा का मज़त न्हैल़ै लागी</para>
  <para style="q" vid="LAM 4:17">ज़ुंण हाम्हां बच़ाऊई निं सकअ!<verse eid="LAM 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />दुशमण तै म्हारै पिछ़ै इहै पल़ै दै कि</para>
  <para style="q" vid="LAM 4:18">हाम्हैं निं नगरीए बाता अर च़फै प्रगल़ै हांढी बी सकदै तै।</para>
  <para style="q" vid="LAM 4:18">म्हारी अमर गई ती हई अर म्हारी मौत गई ती एछी।<verse eid="LAM 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />ज़ुंण दुशमण म्हारै पिछ़ै तै पल़ै दै, तिंयां एछा तै सरगै डैऊंदै मुक्षरलै का बी छ़ेक्‍कै,</para>
  <para style="q" vid="LAM 4:19">तिन्‍नैं निं उझै धारा बी म्हारअ पिछ़अ छ़ाडअ, अर</para>
  <para style="q" vid="LAM 4:19">रेगीस्तानै बी थिऐ तिंयां हाम्हां मारदै रहै दै ताखुई।<verse eid="LAM 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />बिधाता त हाम्हां लै राज़अ छ़ांटअ द,</para>
  <para style="q" vid="LAM 4:20">हाम्हैं सोठा तै इहअ कि एऊ हेरनै हाम्हैं बच़ाऊई।</para>
  <para style="q" vid="LAM 4:20">हाम्हैं बोला तै इहअ, “आपणैं राज़े सेटा शरण लई रहणैं हाम्हैं</para>
  <para style="q" vid="LAM 4:20">होरी देशा जैंदरी राज्ज़ी-राम्बल़ै ज़िऊंदै।”</para>
  <para style="q" vid="LAM 4:20">पर दुशमणै ढाकअ सह बी!<verse eid="LAM 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />एदोम अर ऊज़ नगरीए लोगो! एभै आसा तम्हैं खुश हुऐ दै!</para>
  <para style="q" vid="LAM 4:21">अह बनाशे शराब पल़णीं तम्हां बी झुटणीं</para>
  <para style="q" vid="LAM 4:21">अर दुशमणा करनै तम्हैं बी पठ नांगै।<verse eid="LAM 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />एरुशलेम नगरीए परज़ा लै मुक्‍कअ बिधाता पठी सज़ा दैई।</para>
  <para style="q" vid="LAM 4:22">तेऊ हेरनै तिंयां छ़ेक्‍कै गलामी का आपणैं घअरा लै बापस फरेऊई।</para>
  <para style="q" vid="LAM 4:22">पर तम्हां एदोमी लै लणी तेऊ सज़ा दैई,</para>
  <para style="q" vid="LAM 4:22">तेऊ खोज़णैं तिंयां सोभै पाप ज़ुंण तम्हैं किऐ।<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">झींण करना लै अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />बिधाता, आद कर कि हाम्हां लै केही-केही हुई-बिति!</para>
  <para style="q" vid="LAM 5:1">हाम्हां बाखा भाल़, हाम्हैं किहै बेइज़त शोटै करी।<verse eid="LAM 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />म्हारी दादा-बाबे ज़ैदात गिम्मी परदेसी,</para>
  <para style="q" vid="LAM 5:2">म्हारै घअरै बस्सै किअ पराई ज़ाती कबज़अ।<verse eid="LAM 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />हाम्हैं हुऐ बाबा बाझ़ी छ़ुटै-मुक्‍कै दै!</para>
  <para style="q" vid="LAM 5:3">म्हारी ईजा हुई बिधबा।<verse eid="LAM 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />झुटणा लै पाणीं बी लागा हाम्हां मोलै लणअ!</para>
  <para style="q" vid="LAM 5:4">गेठै आगी ज़ाल़णा लै झ़ुका बी लागा हाम्हां ढब्बै दैई लणी!<verse eid="LAM 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />म्हारै कैल़ै आसा बल्दा ज़िहअ गर्कअ जूँ डाहअ द पाई,</para>
  <para style="q" vid="LAM 5:5">ऐबै थकै हाम्हैं, हाम्हां निं थोल़ी घल़ी बी बशैघ भेटदअ।<verse eid="LAM 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />हाम्हैं मनी मिसर अर अश्शूरी देशे गलामी कि</para>
  <para style="q" vid="LAM 5:6">तिंयां हाम्हां लै रज्ज़ी खाणां लै दैए अर हाम्हैं ज़िऊंदै बच़े।<verse eid="LAM 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />म्हारै दादै-बाबै किअ पाप, पर ऐबै गऐ तिंयां मरी,</para>
  <para style="q" vid="LAM 5:7">हाम्हैं आसा तिन्‍नें पापा पिछ़ू सज़ा भुगतदै लागै दै।<verse eid="LAM 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />गलाम आसा हाम्हां प्रैंदै राज़ करदै लागै दै,</para>
  <para style="q" vid="LAM 5:8">तिन्‍नां का निं हाम्हां कोह छ़ड़ैऊंणैं आल़अ आथी।<verse eid="LAM 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />रोटी लोल़ै लागा हाम्हां आपणीं ज़ान खातरै दी पाई डेऊणअ!</para>
  <para style="q" vid="LAM 5:9">दुशमण आसा बागै हर ज़ैगा हाम्हां मारदै ताखुई रहै दै।<verse eid="LAM 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />भुखे आसा हाम्हां आगी ज़िहअ ज़अर आअ द,</para>
  <para style="q" vid="LAM 5:10">म्हारी खाल बी फिरी बागा का तंदूरा ज़ेही काल़ी।<verse eid="LAM 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />दुशमण सुत्तै ज़ोरा-ज़ोरी एरुशलेम नगरीए म्हारी बेटल़ी संघै!</para>
  <para style="q" vid="LAM 5:11">यहूदा मुल्खै हर गराऊंऐं म्हारी कुंआरी शोहरी किई तिन्‍नैं भ्रष्ट!<verse eid="LAM 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />म्हारै कार-करिंदै डाहै दुशमणै राश्शी करै बान्हीं छ़ड़ाऊई!</para>
  <para style="q" vid="LAM 5:12">म्हारै सैणैं किऐ तिन्‍नैं बेइज़त।<verse eid="LAM 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />खारकै मणछ आसा गलामा ज़िहै थरेटा दी नाज़ा पिशदै लागै दै,</para>
  <para style="q" vid="LAM 5:13">लान्हैं आसा गर्कै झ़ुके भर्टू करै जुंघू लागै दै।<verse eid="LAM 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />सैणैं निं ऐबै नगरीए प्रऊल़ी सेटा बेशदै आथी,</para>
  <para style="q" vid="LAM 5:14">नां ज़ुआन शोहरू गिहा-बाता बोल्दै शुण्हदै!<verse eid="LAM 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />म्हारी ज़िन्दगी का हुई ऐबै खुशी दूर,</para>
  <para style="q" vid="LAM 5:15">म्हारी गिहा-बाता अर नाट पाणें ज़ैगा पल़अ हाम्हां लै शोग।<verse eid="LAM 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />म्हारै मुंडो साफअ पल़अ धरनीं, सोभ गल्‍ला हुई हाम्हां लै उंबल़ी!</para>
  <para style="q" vid="LAM 5:16">हाम्हैं किअ पाप अर तैही पल़ी हाम्हां लै आफ़त।<verse eid="LAM 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />हाम्हैं हुऐ भितरा का बाख दुबल़ै,</para>
  <para style="q" vid="LAM 5:17">इना गल्‍ला करै फिरी म्हारी आछी बी पाल्‍ली।<verse eid="LAM 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />सियोन धार हुई पठ शुन्‍नीं अर बरैबाद,</para>
  <para style="q" vid="LAM 5:18">एथ आसा ऐबै शैल़ी-शैल़ठै ठुल़्दै लागै दै।<verse eid="LAM 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />हे बिधाता, तूह आसा राज़गाद्दी दी सदा बेठअ द,</para>
  <para style="q" vid="LAM 5:19">तेरअ राज़ रहणअ पोस्ती दर पोस्ती इहअ ई।<verse eid="LAM 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />ओ परमेशरा! तंऐं किल्है डाहै हाम्हैं सदा लै शोटी?</para>
  <para style="q" vid="LAM 5:20">तंऐं कै हाम्हैं सदा लै हेरै बिस्सरी डाही?<verse eid="LAM 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />हे बिधाता, हाम्हां फरेऊ आप्पू बाखा लै,</para>
  <para style="q" vid="LAM 5:21">तै जाणैं हाम्हैं ताह सेटा लै बापस एछी।</para>
  <para style="q" vid="LAM 5:21">हाम्हां कर भिई तिहै ई ज़ेही म्हारी पैहलै शोभा-शान ती।<verse eid="LAM 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />तंऐं कै हाम्हैं सदा लै हेरै छ़ाडी?</para>
  <para style="q" vid="LAM 5:22">तूह कै हाम्हां का पठी आसा रुश्शअ द?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>