  <para style="h">1 पतरास</para>
  <para style="toc1">पतरासै लिखी दी पैहली च़िठी</para>
  <para style="toc2">1 पतरास</para>
  <para style="toc3">1 पत.</para>
  <para style="mt1">1 पतरास</para>
  <para style="mt2">पतरासै लिखी दी पैहली च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: पतरास</para>
  <para style="ili">पहल़णैं आल़ै: एशिया मुल्खै उतर दिशा बाखा रहणैं आल़ै विश्वासी</para>
  <para style="ili">सन: 62-65</para>
  <para style="ip">पतरासे पैहली च़िठी लिखी ती तिन्‍नां मसीहा विश्वासीए नाओंऐं, ज़हा लै इधी “परमेशरे छ़ांटै दै लोग” आसा बोलअ द, ज़ुंण पूरै एशिया मुल्खे उतर दिशा बाखा मुल्खै छिंघुई तै बस्सै दै। ऐहा च़िठीओ खास मकसद आसा आपणैं तिन्‍नां पहल़णैं आल़ै लै जोश दैणअ, ज़ुंण आपणैं विश्वास करनै पिछ़ू दाह-दुख ज़िरदै थिऐ लागै दै। लिखणैं आल़अ करा इहअ आपणैं पहल़णैं आल़ै लै ईशू मसीहे खुशीए समादे आद फरेऊई करै, किल्हैकि ईशूए मौत, मरी करै भिई ज़िऊंदै हणअ अर फिरी एछणेंओ बाहिदअ दैआ तिन्‍नां लै आशा। एऊ साबै तै तिन्‍नां आपणैं दुख मनणै अर इहअ विश्वास करी ज़िरी कि अह आसा तिन्‍नें विश्वासे सत्ते परख, अर इहअ कि तेतो भाग भेटणअ “मसीहे प्रगट हणें धैल़ी।”</para>
  <para style="ip">दाह-दुखे बगती हैअ विश्वास दैणैं संघा-संघा करा लिखणैं आल़अ एही अरज़ बी कि तेऊए पहल़णैं आल़ै लोग इहै लोगा ज़ेही काटे ज़ुंण मसीहे परज़ा आसा।</para>
  <para style="ip">पतरास खोज़ा कबिता ज़ेही भाषा लिखी पहल़णैं आल़ै का इहअ कि मसीहा किज़ै किअ:</para>
  <para style="imq">“हुंह बोला इहअ तै कि मसीहा भुगतअ दुख अर सह मूंअ म्हारै पापा पिछ़ू। सह मूंअ एकी बारी अर तेऊ निं भिई मरने ज़रुरत आथी। सह थिअ धर्मीं मणछ अर सह मूंअ हाम्हां पापी मणछा लै एते तैणीं कि सह हाम्हां परमेशरा नेल़ आणी सके। तिन्‍नैं पाई तेऊए देही मारी पर सह किअ पबित्र आत्में शगती करै ज़िऊंदअ।”</para>
  <para style="ipr">(3:18)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1:1,2</para>
  <para style="io1">परमेशरे उद्धारे आद फरेऊंणी 1:3-12</para>
  <para style="io1">पबित्र ज़िन्दगी लै शिक्षा 1:13—2:10</para>
  <para style="io1">दुखे बगती मसीही विश्वासीए ज़िम्मैंबारी 2:11—4:19</para>
  <para style="io1">विश्वासीए मानदारी अर च़ाकरी 5:1-11</para>
  <para style="io1">नचोल़ 5:12-14</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />हुंह पतरास ज़ुंण प्रभू ईशू मसीहो शधाणूं आसा, हुंह लिखा ऐहा च़िठी मसीहा दी विश्वास करनै आल़ै तिन्‍नां परदेसी लै ज़ुंण पुंतुस, गलात, कप्पदुकिआ, एशिया अर बिथूनिया मुल्खे कई नगरी दी छिंघुई आसा बस्सै दै।<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />बाब परमेशरै छ़ांटै आप्पै तम्हैं पैहलै ई अर पबित्र आत्मां किऐ तम्हैं पबित्र। तम्हैं किऐ परमेशरै ईशू मसीहे लोहू दी शुचै अर तेऊए साबै ज़िन्दगी ज़िऊंणां लै ज़ुदै।</para>
  <para style="p" vid="1PE 1:2">हुंह करा परमेशरा का एही अरज़ कि परमेशरा का लोल़ी तम्हां लै खास्सी झींण अर शांती भेटी।<verse eid="1PE 1:2" /></para>
  <para style="s">एक ज़िऊंदी आशा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />म्हारै प्रभू ईशू मसीहे बाब अर परमेशरो करा शूकर। अह आसा तेऊए महान झींण कि म्हारअ हुअ नऊंअ ज़ल्म। किल्हैकि तेऊ किअ प्रभू ईशू मसीहा मरी करै ज़िऊंदअ। ऐबै ज़िऊआ हाम्हैं म्हारी ज़िन्दगी पूरी आशा डाही। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />हाम्हैं आसा न्हैल़ै लागै दै कि हाम्हां सह ज़ैदात भेटे ज़ुंण परमेशरै हाम्हां लै आसा डाही दी। तेता निं कोहै बरैबाद करी सकदअ। नां कुंण तेता खोई सकदअ। तिंयां निं कधि पराणैं हणैं अर तेते शोभा रहणीं सदा। परमेशरै आसा तिंयां च़िज़ा स्वर्गै तम्हां लै डाही दी। <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />परमेशर करा आपणीं महान शगती करै थारी हेर-सभाल़ किल्हैकि तम्हैं करा ईशू दी विश्वास। तेऊ डाहणैं आजू बी तम्हैं खिरीए तैहा धैल़ी तैणीं बच़ाऊई ज़ेभै मसीहा फिरी एछणअ। तेभै लागणअ तम्हां का थोघ कि परमेशरै हेरै तम्हैं पाप अर मौता का पठी बच़ाऊई।<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />इना सोभी गल्‍ले बारै लागा तम्हां खुश हणअ च़ाऐ एभै थोल़ी घल़ी कई रंगे तकलिफी तम्हां दुखी किल्है निं करे। <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />इना दुखो मकसद हआ कि थारअ विश्वास परमेशरा दी पाक्‍कअ शुझिए। थारअ ईशू मसीहा दी विश्वास आसा सुन्‍नैं का बी खास्सअ किम्मती। ज़ुंण बरैबाद बी सका हई तेऊ सुन्‍नैं बी परखा अर आगी करै करा तेऊ शुचै, ज़ै थारअ विश्वास परखणैं अर दुखा दी पाक्‍कअ रहे, एता करै भेटणीं तम्हां तैहा धैल़ी खास्सी खुशी, प्रतप्प अर अदर ज़ेभै ईशू मसीहा सारै संसारै प्रगट हणअ।<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JAS 1:12">याक. 1:12</ref>; <ref loc="JOB 23:10">आयू. 23:10</ref>; <ref loc="PSA 66:10">भज. 66:10</ref>; <ref loc="ISA 48:10">ईशा. 48:10</ref></char></note><verse eid="1PE 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 1:8" />तम्हैं निं ईशू कधि आथी भाल़अ द, पर तज़ी बी डाहा तम्हैं तेऊ संघै झ़ूरी। तम्हैं निं सह एभै बी भाल़अ पर तम्हैं करा तेऊ दी विश्वास। एतो नतिज़अ आसा इहअ कि तम्हैं आसा बडै खुश कि हाम्हां का निं इना गल्‍ला खोज़णा लै बैण ई आथी कि तम्हैं किहै खुश आसा। <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />तम्हैं आसा एते तैणीं खुश कि परमेशरै लाऐ तम्हैं पापे सज़ा भुगतणै का बच़ाऊई। थारै मसीहा ईशू दी विश्वास करनैओ मकसद आसा अह ई।<verse eid="1PE 1:9" /></para>
  <para style="s">कई गूरै एऊ उद्धारे बारै खोज़अ द</para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />एऊ ई उद्धारे बारै च़ाहा तै परमेशरे गूर होर बी खास्सअ थोघ लाणअ। तिन्‍नैं बोलअ एते बारै कि परमेशरा तम्हां संघै केही झींण करी दैणअ तम्हां लै उद्धार, ज़ेता जोगी तम्हैं नांईं आथी तै। तिन्‍नैं किई एते ज़बाबा लोल़णा लै खास्सी कोशिश। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />मसीहे आत्मां ती तिन्‍नां दी अर सह खोज़ा ती तिन्‍नां का कि मसीहा किहअ दुख ज़िरनअ अर तेखअ तेऊओ किहअ महान प्रतप्प हणअ। तिन्‍नैं लाअ एतो बी राम्बल़अ थोघ कि मसीहा कुंण हणअ अर सह केभै हणअ।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2PE 1:21">2 पत. 1:21</ref>; <ref loc="LUK 24:25-27">लूक. 24:25-27</ref>; <ref loc="ISA 52:13-14">ईशा. 52:13-14</ref></char></note><verse eid="1PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 1:12" />परमेशरै खोज़अ तिन्‍नां गूरा का कि तेऊओ समाद नांईं त तिन्‍नां लै आथी पर अह आसा तम्हां लै। अह समाद आसा ईशू मसीहे बारै खुशीओ समाद ज़सरै बारै तम्हैं ऐबै शूणअ। परमेशरै छ़ाडी स्वर्गा का आपणीं पबित्र आत्मां कि सह लोगे खुशीए समादा तम्हां का खोज़णा लै मज़त करे। ईंयां गल्‍ला आसा एतरी महान कि स्वर्ग दूत बी हआ इना गल्‍ला हंदी भाल़णें ताका दी रहै दै।<verse eid="1PE 1:12" /></para>
  <para style="s">पबित्र ज़िन्दगी ज़िऊंणेंओ निऊंद्रअ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />तैही करा आपणैं मन्‍नां काबू करी परमेशरे साबै हर कामां करना लै तैर एही आशा डाही करै कि परमेशरा करनअ तम्हां लै भलअ ई भलअ कि तेऊ दैणअ तम्हां लै आपणैं जशा दी उद्धार ज़ेभै मसीहा ईशू स्वर्गा का फिरी एछणअ। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />परमेशरे मना हर गल्‍ला शोभलै लान्हैं ज़िहै ज़ुंण आपणैं बाबे हर गल्‍ला मना। तिन्‍नां कदुष्ट कामां निं ऐबै करा ज़ेता तम्हैं परमेशरो सत्त थोघ लागणै का आजी च़ाहा तै करनी। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />पर ऐबै लोल़ी तम्हैं सोभी साबै पबित्र रहै ज़ुंण बी तम्हैं करा। किल्हैकि ज़ुंणी परमेशरै तम्हैं छ़ांटै दै आसा, सह आसा पबित्र। <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />किल्हैकि पबित्र शास्त्रा दी आसा लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44">लेब. 11:44</ref>; <ref loc="LEV 19:2">19:2</ref>; <ref loc="LEV 20:7">20:7</ref></char></note></para>
  <para style="q" vid="1PE 1:16">“पबित्र हआ, किल्हैकि हुंह आसा पबित्र।”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />ज़ेभै तम्हैं अरज़ करा, तेभै बोला तम्हैं परमेशरा लै आपणअ बाब। पर ऐहा गल्‍ला डाहा आद कि सह निं कोही लै भेदभाब करदअ। सह करा हरेकी मणछो नसाफ तिन्‍नें कामां भाल़ी। तै ज़ेभै तैणीं तम्हैं ऐहा पृथूई दी परदेसी ज़िहै आसा, तम्हां लागा कबल्‍ली परमेशरो अदर करी ज़िन्दगी ज़िऊंणीं।<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="2CH 19:7">2 इति. 19:7</ref>; <ref loc="PSA 28:4">भज. 28:4</ref>; <ref loc="ISA 59:18">ईशा. 59:18</ref>; <ref loc="JER 3:19">जेर. 3:19</ref>; <ref loc="JER 17:10">17:10</ref></char></note><verse eid="1PE 1:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="1PE 1:18-19" />तम्हां का लोल़ी थोघ हुअ कि परमेशरै तम्हैं बृथा बभारा का किहअ करै बच़ाऊऐ, ज़ुंण तम्हैं आपणैं दादा-बाबा का आसा शिखल़अ द। तेऊ निं तम्हैं सुन्‍नैं अर च़ंदी ज़ेही बरैबाद हणैं आल़ी ज़ैदाता करै बच़ाऊऐ। पर परमेशरै बच़ाऊऐ तम्हैं मसीहे किम्मती लोहू करै ज़ुंण म्हारै पापा लै बल़ीदान हुअ। तेऊए मौत ती हाम्हां लै सिध्द अर शुचअ बल़ीदान ज़िहअ यहूदी सिध्द मिम्मूं करा तै बल़ीदान ज़ेथ कोई दाग अर दोश नां होए।<note caller="-" style="x"><char style="xo" closed="false">1:18-19 </char><char style="xt" closed="false"><ref loc="GAL 1:4">गल. 1:4</ref>; <ref loc="PSA 49:7-8">भज. 49:7-8</ref>; <ref loc="ISA 52:3">ईशा. 52:3</ref></char></note><verse eid="1PE 1:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 1:20" />एऊ संसारा बणाणैं का आजी ई त परमेशरै आजू लै डाहअ द सोठी कि ईशू मसीहा हणअ पापा का बच़ाऊंणै आल़अ। पर सह हुअ ऐबै इना खिरीए धैल़ै एऊ संसारै थारी मज़त करना लै प्रगट।<verse eid="1PE 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 1:21" />ज़ुंण ईशू मसीहा म्हारी तैणीं किअ, तेता करै करा तम्हैं ऐबै परमेशरो विश्वास। थारी आशा अर भरोस्सअ आसा ऐबै परमेशरा दी। किल्हैकि तेऊ किअ मसीहा मरी करै भिई ज़िऊंदअ अर तेऊ लै दैनअ खास्सअ अदर।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />ज़ांऊं तम्हैं परमेशरो सत्त मनअ, तम्हैं हेरै शुचै बणाईं। ऐबै लागा तम्हां आपणैं संघी विश्वासी संघै कबल्‍ली दिला-मन्‍नां का झ़ूरी करनी।<verse eid="1PE 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 1:23" />तम्हां लागा एकी-दुजै संघै झ़ूरी करनी ई करनी, किल्हैकि तम्हां आसा परमेशरा का नऊंईं ज़िन्दगी भेटी दी। तम्हां निं अह ज़िन्दगी किज़ू एही च़िज़ा करै आथी भेटी ज़ुंण बरैबाद हणीं, पर अह आसा तेता करै भेटी दी ज़ुंण सदा लै हणीं। हाम्हां आसा नऊंईं ज़िन्दगी परमेशरे ज़िऊंदै अर सदा रहणैं आल़ै बैणा करै भेटी दी। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />ज़िहअ परमेशर पबित्र शास्त्रा दी बोला,</para>
  <para style="q" vid="1PE 1:24">“मणछ आसा घाहा ज़िहअ</para>
  <para style="q" vid="1PE 1:24">अर एते सारी शोभा आसा घाहे फूला ज़ेही,</para>
  <para style="q" vid="1PE 1:24">घाहा शुक्‍का अर फूल बी अल़ा धरनीं।<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />पर प्रभूओ बैण रहणअ जुगै-जुगै इहअ ई बणी।”</para>
  <para style="p" vid="1PE 1:25">अह आसा खुशीए समादो बैण ज़ुंण तम्हां का आसा खोज़अ द।<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लूक. 16:17</ref>; <ref loc="JHN 1:1">जोह. 1:1</ref>; <ref loc="ISA 40:8">ईशा. 40:8</ref></char></note><verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">ज़िऊंदअ पात्थर अर पबित्र परज़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />तैही छ़ाडा सोभी रंगो बूरअ बभार करनअ। होरी लै निं धोखअ दैणअ, नां छ़ल़-कपट करनअ। होरी लै निं ज़ल़ण करनी। कोहिए बारै निं बूरी गल्‍ला करनी। <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />ज़िहअ एभै पैईदा हुअ द शोहरू आपणीं माओ क्लुध च़ाहा, तेही लागा हाम्हां च़ाहा डाहणीं कि परमेशर हाम्हां का सत्त खोज़े, ताकि तम्हैं तेता शिखल़ी करै परमेशरा दी विश्वास करना लै ज़ुआन शोहरू ज़िहै होए। खिरी हणअ इहअ कि परमेशरा बच़ाऊंणै तम्हैं एऊ संसारे बूरी गल्‍ला का पठी। <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />किल्हैकि पबित्र शास्त्र बोला इहअ, “तम्हां गअ तज़ुर्बअ हई कि प्रभू आसा भलअ।”<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">भज. 34:8</ref></char></note><verse eid="1PE 2:3" /></para>
  <para style="s">परमेशरे घअरा लै ज़िऊंदी ज़ान</para>
  <para style="p">
    <verse number="4-5" style="v" sid="1PE 2:4-5" />तम्हैं आऐ प्रभू ईशू सेटा। सह आसा तेऊ खास पात्थरा ज़िहअ ज़ुंण घअरे आथरी दी आसा लाअ द, पर सह आसा ज़िऊंदी ज़ान। कई लोगै समझ़अ सह बृथा, पर परमेशरै छ़ांटअ सह अर सह बणाअं सोभी का खास।</para>
  <para style="p" vid="1PE 2:4-5">ज़िहै मणछ खास्सै पात्थरा करै घअर बणाआं तिहअ च़ाहा परमेशर तम्हां बी तैहा टोली दी कठा ज़ोल़णअ ज़ेथ पबित्र आत्मां रहा, ताकि ज़ुंण ईशू मसीहा म्हारी तैणीं किअ, तेता करै हाम्हैं बी प्रोहता ज़िहै होए ज़ुंण बल़ीदान भैंट दैआ अर तिहै काम करे ज़ेता करै परमेशर खुश हआ। <verse eid="1PE 2:4-5" /><verse number="6" style="v" sid="1PE 2:6" />एता लै आसा पबित्र शास्त्रा दी बी लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ईशा. 28:16</ref></char></note></para>
  <para style="q" vid="1PE 2:6">“हेरा, सियोन नगरीए सोभी का खास कूणींए ज़ान डाहणीं मुंह किल्‍ली।</para>
  <para style="q" vid="1PE 2:6">ज़ुंण बी तेऊ दी विश्वास करे, सह निं केही शर्मिंदअ हणअ।”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />तम्हैं ज़ुंण विश्वास करा तम्हां लै आसा सह किम्मती पर ज़ुंण विश्वास नांईं करदै,<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भज. 118:22</ref>; <ref loc="DAN 2:34-35">दान. 2:34-35</ref></char></note></para>
  <para style="q" vid="1PE 2:7">“सह ई पात्थर ज़ुंण राज़ मिस्त्री बृथा समझ़अ,</para>
  <para style="q" vid="1PE 2:7">सह ई बणाअं तेऊ खास कूणींए ज़ान।”<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />तेखअ,<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1CO 1:23">1 करि. 1:23</ref>; <ref loc="ISA 8:14-15">ईशा. 8:14-15</ref></char></note></para>
  <para style="q" vid="1PE 2:8">“सह आसा एही टोल्हा ज़िहअ ज़ेथ मणछा ठोहल़ लागा,</para>
  <para style="q" vid="1PE 2:8">एही टोल्ह ज़ेता करै तिंयां बरैबाद हआ।”</para>
  <para style="p" vid="1PE 2:8">तिन्‍नां लागा ठोहल़ तै कि तिंयां निं परमेशरो बैण मंदै अर तिन्‍नां लै आसा परमेशरै अह ई सज़ा डाही दी।<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />पर तम्हैं निं तिहै आथी, तम्हैं आसा परमेशरै आप्पू लै छ़ांटै दै। तम्हैं आसा तेऊ परमेशरे च़ाकरी करनै आल़ै प्रोहत ज़ुंण राज़अ आसा। तम्हैं आसा पबित्र अर परमेशरे आपणैं खास लोग ज़ुंण परमेशरे च़ाकरी करा। तेऊ शादै तम्हैं न्हैरै मांझ़ा का महान प्रैश्शै लै ताकि तम्हैं परमेशरे महान कामें बारै सोभी लोगा का खोज़ी सके।<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">लुआ. 19:5-6</ref>; <ref loc="DEU 7:6">बधा. 7:6</ref>; <ref loc="DEU 14:2">14:2</ref>; <ref loc="ISA 9:2">ईशा. 9:2</ref>; <ref loc="ISA 43:20-21">43:20-21</ref></char></note><verse eid="1PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 2:10" />होशे गूरै आसा थारै बारै अह गल्‍ल शुची बोली दी,<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 1:10">होश. 1:10</ref>; <ref loc="HOS 2:23">2:23</ref></char></note></para>
  <para style="q" vid="1PE 2:10">“तम्हैं निं पैहलै किछ़ बी आथी तै,</para>
  <para style="q" vid="1PE 2:10">पर ऐबै आसा परमेशरे परज़ा,</para>
  <para style="q" vid="1PE 2:10">पैहलै निं तम्हां परमेशरे झींणें बारै थोघ आथी त,</para>
  <para style="q" vid="1PE 2:10">पर ऐबै आसा थोघ किल्हैकि तेऊ हेरी पैहलै ई तम्हां लै आपणीं झींण रहैऊई।”<verse eid="1PE 2:10" /></para>
  <para style="s">मसीही ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />मेरै पैरै भाईओ, हुंह करा तम्हां लै अरज़ तम्हैं सोठा ऐहा गल्‍ला, “तम्हैं आसा एऊ संसारै परदेसी” ज़सरअ असली घअर स्वर्गै आसा, तम्हैं करनी तिन्‍नां पापी कामां का दूर रहणें कोशिश ज़ुंण थारै प्राण करनअ च़ाहा। नांईं ता तम्हैं निं परमेशरा नेल़ रही सकदै।<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="GAL 5:24">गल. 5:24</ref>; <ref loc="1PE 4:2">1 पत. 4:2</ref></char></note><verse eid="1PE 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 2:12" />तम्हां फेर रहा तिंयां लोग ज़ुंण परमेशरा दी विश्वास निं करदै तिंयां सका इहअ तम्हां लै दोश लाई कि थारै काम आसा बूरै। तैही डाहणअ धैन कि तम्हैं किहअ बभार करा, ताकि तिंयां थारअ भलअ बभार भाल़े। खिरीए धैल़ी मनणी तिन्‍नां अह गल्‍ल कि थारअ बभार आसा भलअ अर खिरी करनअ परमेशरो अदर ज़ेभै मसीहा ईशू संसारे नसाफ करदअ पृथूई लै फिरी एछणअ।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 5:16">मोत्त. 5:16</ref>; <ref loc="TIT 2:7-8">तित. 2:7-8</ref></char></note><verse eid="1PE 2:12" /></para>
  <para style="s">परमेशरे दास</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />प्रभूओ अदर करना लै लागा हाम्हां तिन्‍नों हुकम मनणअ ज़ुंण संसारै हाम्हां प्रैंदै राज़ करा, ज़िहअ कि राज़अ, ज़ुंण सोभी प्रैंदै प्रधान आसा। <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />हाकम, ज़हा लै राज़ै आसा हक दैनअ द, तिंयां आसा तिन्‍नां लै सज़ा दैंदै छ़ाडै दै ज़ुंण गलत करा अर तिन्‍नां सराहंदै ज़ुंण भलअ करा।<verse eid="1PE 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 2:15" />किल्हैकि परमेशर च़ाहा इहअ ई कि म्हारअ भलै बभारा करै छ़ाडणअ तिन्‍नां मणछा हाम्हां लै झ़ुठअ दोश लाणअ ज़हा का परमेशरो थोघ निं आथी। किल्हैकि अह गल्‍ल आसा पाक्‍की कि तिन्‍नें झ़ुठै दोश निं शुचै आथी। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />पर तम्हैं ज़िहअ च़ाहा, तिहअ करनै का निं तम्हां कोहै रोक्‍की सकदअ किल्हैकि तम्हैं आसा पैहलै ई म्हारै प्रभू ईशू मसीहा करै आज़ाद हेरै दै करी। पर एता निं पाप करना लै मोक्‍कअ समझ़ी। पर थारै कामां करै लोल़ी शुझुअ कि तम्हैं आसा असली दी परमेशरे च़ाकरी करनै आल़ै दास। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सोभिओ करा अदर, होरी विश्वासी भाई संघै डाहा झ़ूरी, परमेशरा का डरनअ अर राज़ैओ करा अदर।<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PRO 24:21">सैणीं. 24:21</ref>; <ref loc="ROM 12:10">रोम. 12:10</ref></char></note><verse eid="1PE 2:17" /></para>
  <para style="s">मसीहा आसा म्हारअ आदर्श</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />तम्हैं कसरै घअरै काम करनै आल़ै दास ज़ुंण विश्वासी आसा, तम्हां लागा आपणैं मालके हर गल्‍ला मनणी अर तिन्‍नों अदर करनअ। एता करै तम्हैं सोभी मालका लै, च़ाऐ तिंयां झणैल़ू होए, च़ाऐ तिन्‍नों बभार तम्हां लै काठअ होए। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />किल्हैकि, ज़ै कुंण हाम्हां दी दोश नांईं हंदी बी हाम्हां लै दुख दैआ, हाम्हैं ज़िरा तैहा बेनसाफी बी मज़ै करै। किल्हैकि हाम्हां का आसा थोघ कि परमेशरा का आसा सोभी गल्‍लो थोघ अर सह आसा हाम्हां करै खुश। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />किल्हैकि, ज़ै तम्हैं ज़ुल्म करी धमुक्‍कै खाऐ अर सबर डाहअ, तै तेते किज़ै सराहणे गल्‍ल हुई? पर ज़ै तम्हां भलै काम करी दुख भेटा अर सबर करा, तेता करै हआ परमेशर खुश।<verse eid="1PE 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 2:21" />तम्हां शादणेंओ आसा परमेशरो एक मकसद इहअ बी कि तम्हैं भलै काम करनै पिछ़ू बी तेऊ लै दुख ज़िरे। मसीहा ज़ुंणी थारी तैणीं दुख ज़िरै, सह आसा तम्हां लै आदर्श। तैही लागा तम्हां तिहअ करनअ ज़िहअ तेऊ किअ।<verse eid="1PE 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 2:22" />“पबित्र शास्त्र बोला इहअ,</para>
  <para style="p" vid="1PE 2:22">“तेऊ निं कधि पाप किअ, नां तेऊ किज़ै झ़ुठअ बोलअ।<note caller="-" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">ईशा. 53:9</ref></char></note><verse eid="1PE 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 2:23" />“ज़ेभै लोग ईशूए बेइज़ती करा तै, सह निं तिन्‍नां बापस बेइज़ती करदअ त। ज़ेभै लोग तेऊ लै दुख दैआ तै सह निं तिन्‍नां लै बापस धमकी दैंदअ त। पर सह करा त आपणीं मज़ती लै परमेशरा दी भरोस्सअ। तेऊ का थिअ थोघ कि परमेशर आसा सदा शुचअ नसाफ करनै आल़अ।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="1PE 4:19">1 पत. 4:19</ref>; <ref loc="ISA 53:7">ईशा. 53:7</ref></char></note><verse eid="1PE 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1PE 2:24" />“ज़ेभै ईशू क्रूसा दी मूंअ, तेऊए देही दी दैनी म्हारै पापा पिछ़ू सज़ा। तेऊ किअ अह एते तैणीं कि पाप हाम्हां दी आजू राज़ नां करे, पर ऐबै हाम्हैं तिन्‍नां धर्मीं गल्‍ला करे ज़ुंण परमेशर च़ाहा। ज़ुंण कोल़े मार तेऊ ज़िरी, हाम्हैं हुऐ तेता करै नरोगै।”<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="GAL 3:13">गल. 3:13</ref>; <ref loc="ISA 53:4-5">ईशा. 53:4-5</ref>,<ref loc="ISA 53:12">12</ref></char></note><verse eid="1PE 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1PE 2:25" />तम्हैं थिऐ पैहलै कबाता पेठी दी भेडा ज़िहै। पर ऐबै आऐ आपणैं हेर-सभाल़ करनै आल़ै फुआल मसीहा सेटा लै भिई फिरी।<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">ईशा. 53:6</ref>; <ref loc="EZK 34:5-6">एज. 34:5-6</ref></char></note><verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">दुहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />ओ बेटल़ीओ, तम्हैं बी रहा आपणैं मर्धे डरा हेठै। <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />ज़ै इना मांझ़ै कोई इहै बी होए, ज़ुंण मसीहा दी विश्वास नांईं करदै, तिन्‍नां हेरनअ थारै पबित्र अर धर्मीं बभारा भाल़ी बाझ़ी बोलै विश्वास करी। तिन्‍नां का जाणअ शुझुई कि तम्हैं करा तिन्‍नों अदर।<verse eid="1PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 3:3" />थारअ हार शंगार निं लोल़ी दखाऊटी हुअ, थारअ शंगार लोल़ी इहअ हुअ ज़ुंण परमेशरे लोगा शोभा दैआ, नां कि कई रंगे गुछ़टी बाली करै अर सुन्‍नैं-च़ंदी, मोती, अर किम्मती झिकल़ै बान्हीं करै। <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />तम्हैं लोल़ी भितरी थारै दिला का शोभलै हुऐ, ज़ुंण शोभा सदा रहा। मतलब थारअ सिधअ-सादअ सभाब अर शांत बभार ज़ेतो मोल परमेशरा का खास्सअ शुझिआ।<verse eid="1PE 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 3:5" />पराणैं ज़मानैं बी ज़ुंण धर्मीं बेटल़ी रहा ती, तिंयां करा ती परमेशरा दी विश्वास अर तिंयां डाहा ती आपणीं आशा तेऊ दी, संघा रहा ती तिंयां आपणैं मर्धे डरा हेठै, एऊ ई साबै बणाआं ती तिंयां आपणीं शोभा। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />ज़ेही सारा ती, सह मना ती आबरामे हर गल्‍ला अर तेऊ लै बोला ती सह आपणअ प्रभू। तम्हैं बी ज़ै होरी लै भलाई करे, अर तम्हां ज़ै अह डअर नांईं होर कि तम्हैं आसा विश्वासी थारै मर्ध अर होर लोग झ़ाणीं ऐबै किज़ै बोले, तै हणीं तम्हैं बी सारे शोहरी ज़ेही।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />तिहअ ई ओ मर्धो, तम्हैं बी ज़िऊआ आपणीं बेटल़ी संघै</para>
  <para style="s" vid="1PE 3:7">मर्ध</para>
  <para style="p" vid="1PE 3:7">जोग-सजोग डाही आपणीं लाल़ी संघै ज़िन्दगी। तम्हैं डाहणीं अह गल्‍ल आद कि तिंयां निं तम्हां ज़ेही पाक्‍की आथी। तैही करनअ तिन्‍नों अदर। किल्हैकि परमेशरै ज़ुंण दान आपणैं जशा करै आसा दैनअ द, तम्हैं आसा दुहै तेथ साझ़ू, अर सह आसा सदा लै ज़िन्दगी। तम्हैं करै इहअ तै कि ज़ेभै तम्हैं प्राथणां करे तेभै परमेशर थारी शुणें।<verse eid="1PE 3:7" /></para>
  <para style="s">भलाई करनै पिछ़ू कष्ट</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />खिरी बोला हुंह तम्हां सोभी लै इहअ कि तम्हैं सोभै रहा आप्पू मांझ़ै एक मन्‍न हई। एकी-दुजैओ डाहणअ धैन-खैल। एकी-दुजै संघै करा भाई अर बैहणी समझ़ी झ़ूरी, होरी लै हणअ झणैल़ू अर घमंड निं कधि करनअ। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />बूराईए बदल़ै बूराई निं करा अर नां गाल़ी दैणैं आल़ै लै बदल़ै दी गाल़ी दैआ, पर एते उंबल़ी दैआ लोगा लै बर्गत। किल्हैकि परमेशरै आसा तम्हैं होरी लै बर्गत दैंदै शादै दै। ज़ै तम्हैं इहअ करे, परमेशरा दैणीं तम्हां लै बी बर्गत।<verse eid="1PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 3:10" />किल्हैकि पबित्र शास्त्रा दी आसा इहअ लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="JHN 9:31">जोह. 9:31</ref>; <ref loc="PSA 34:15-16">भज. 34:15-16</ref>; <ref loc="PRO 15:29">सैणीं. 15:29</ref></char></note></para>
  <para style="q" vid="1PE 3:10">“तम्हां मांझ़ै ज़ुंण बी मणछ आपणीं ज़िन्दगी राज्ज़ी-मौज़ी च़ाहा कि</para>
  <para style="q" vid="1PE 3:10">थारी अमर लाम्मी होए, अर तेथ थारअ भलअ होए?</para>
  <para style="q" vid="1PE 3:10">तै निं आपणीं ज़िभा का कधि बूरअ बोली,</para>
  <para style="q" vid="1PE 3:10">नां आपणैं होठा का झ़ुठअ बोली।<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />सह हटै बूरै करनै का पिछ़ू, सह करै भलअ ई,</para>
  <para style="q" vid="1PE 3:11">सह दैऐ दिला का मेल़-ज़ोल़ करनै बाखा ज़ोर।<verse eid="1PE 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1PE 3:12" />किल्हैकि परमेशर हआ धर्मीं मणछा भाल़अ लागअ द,</para>
  <para style="q" vid="1PE 3:12">सह हेरा तिन्‍नें अरज़ शूणीं।</para>
  <para style="q" vid="1PE 3:12">पर बूरै करनै आल़ै मणछा बाखा</para>
  <para style="q" vid="1PE 3:12">डाहा सह पिठ फरेऊई।”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />ज़ै तम्हैं हर बगत भली गल्‍ला करने कोशिश करे, तै निं कोही लाऐ तम्हैं च़िक्‍की। <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />पर ज़ै कुंण म्हारै धर्मीं बभार हणैं पिछ़ू दुख दैए, तै भेटणीं असली दी हाम्हां बर्गत। तिहअ करा ज़िहअ ईशायाह आसा लिखअ द, “तिन्‍नां मणछा का निं डरी ज़ुंण हाम्हां लै धमकी दैआ अर ऐहा गल्‍ले फिकर निं करी कि लोगा किज़ै सका करी।”<verse eid="1PE 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 3:15" />पर आपणैं दिलै दैआ मसीहा लै ज़ैगा अर तेऊओ करा प्रभू मनी अदर। हर बगत रहणअ ज़बाबा दैणा लै तैर ज़ै कुंण तम्हां का इहअ पुछ़े कि थारी आप्पू लै परमेशरा का किज़ै आशा आसा। पर ज़बाब दैणअ तिन्‍नां सिधै-सादै सभाबा संघै। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />ऐहा गल्‍लो डाहै धैन कि तम्हैं करै एऊ साबै लोगा संघै बभार कि तम्हां आप्पू बूरअ निं च़ेते। तेखअ ज़ै लोग थारै खलाफ बूरअ बोले, तिंयां हणैं थारै भलै बभारा भाल़ी शर्मिंदै किल्हैकि तम्हैं आसा मसीहा ईशू दी एक हुऐ दै। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />किल्हैकि, ज़ै परमेशरे दिलै तम्हां लै एही होए कि तम्हैं भलाई करी दुख भुगते, अह आसा बूराई करी दुखा भुगतणै का भलअ।<verse eid="1PE 3:17" /></para>
  <para style="s">मसीहा बी ज़िरअ दुख</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 3:18" />हुंह बोला इहअ तै कि मसीहा भुगतअ दुख अर सह मूंअ म्हारै पापा पिछ़ू। सह मूंअ एकी बारी अर तेऊ निं भिई मरने ज़रुरत आथी। सह थिअ धर्मीं मणछ अर सह मूंअ हाम्हां पापी मणछा लै एते तैणीं कि सह हाम्हां परमेशरा नेल़ आणी सके। तिन्‍नैं पाई तेऊए देही मारी पर सह किअ पबित्र आत्में शगती करै ज़िऊंदअ।<verse eid="1PE 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 3:19" />तेखअ डेऊई तेऊए आत्मां खुशीए समादा खोज़दी तिन्‍नां आत्मां का ज़ुंण परमेशरै तिधी आसा कैद डाही दी ज़िधी मूंऐं दै मणछे आत्मां डेओआ। <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />ईंयां आसा तिंयां आत्मां ज़ुंणी पैहलै ज़मानैं परमेशरो हुकम नांईं मनअ। ज़धू नूह ज़हाज़ा बणाऊंदअ त लागअ द, परमेशरै किअ सबर अर सह रहअ न्हैल़अ लागी कि तिंयां लोग बदल़े। पर ज़ांऊं पाणींए प्रल़या करै सारअ संसार खतम हुअ, सिधै आठ लोग तै डेऊऐ दै ज़हाज़ा भितरी अर तिंयां ई बच़ै बी।<verse eid="1PE 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 3:21" />पराणैं ज़मानैं तिन्‍नों उद्धार आसा म्हारै उद्धारा लै ऐबै सीख; ज़ेभै हाम्हैं डुबकी लआ। ज़ेऊ पाणीं दी हाम्हैं डुबकी लआ सह निं म्हारी देही का मैल दूर करदअ, सह आसा ऐहा गल्‍लो नछ़ैण कि हाम्हैं किई सोर समझ़ डाही करै परमेशरा का म्हारै पाप माफ करने अरज़। हाम्हां लै सका माफी भेटी किल्हैकि ईशू मसीहा आसा मरी करै भिई ज़िऊंदअ हुअ द,<verse eid="1PE 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 3:22" />अर सह डेऊअ स्वर्गा लै। तिधी आसा सह ऐबै परमेशरे दैहणीं बाखा सोभी का बडी पदबी दी बेठअ द अर सह करा स्वर्ग दूत, प्रधान अर शगती प्रैंदै राज़।<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 1:20-21">इफि. 1:20-21</ref>; <ref loc="PSA 110:1">भज. 110:1</ref></char></note><verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बधल़ूई दी ज़िन्दगी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />तैही ज़ै मसीहा देही दी रहंदी दुख भुगतअ, तम्हां बी लागा तेऊ ई ज़िहै दुख भुगतणा लै तैर रहणअ। ज़ै तम्हैं मसीहे हणैं पिछ़ू देही दी दुख भुगतणअ च़ाहा, तम्हैं हेरअ तै पाप करनअ छ़ाडी। <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />एतो नतिज़अ हणअ इहअ कि आजू निं तेऊ मणछा आपणीं ज़िन्दगी कदुष्ट काम करनै ज़ुंण एऊ संसारे मणछ हर बगत करनअ च़ाहा। पर तेऊ करनअ तिहअ ज़िहअ परमेशर तेऊ लै करना लै बोले।<verse eid="1PE 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 4:3" />पैहलै च़ाहा तै तम्हैं इहै काम करनै ज़ेथ विश्वास नांईं करनै आल़ै मज़अ लागा त, तम्हैं करा तै आपणीं ज़िन्दगी कदुष्ट काम करना लै बरैबाद ज़िहअ कि शराब अर खाणैं पिणैं दी, कंज़रैई दी अर नशर्म नाच़-खेल्हा दी अर मुहुर्ती पूज़ा दी ज़ेता का परमेशर नफरत करा।<verse eid="1PE 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 4:4" />तैही हआ तिन्‍नां थारै पराणैं साथी रहैनी कि तम्हैं निं इहै भारी इना कदुष्ट कामां दी तिन्‍नें साझ़ू हंदै अर तैही करा तिंयां थारी निंदा। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />पर एक धैल़ी एछणी एही बी ज़रूर ज़ेभै तिन्‍नां परमेशरा सम्हनै इना सोभी बूरी गल्‍लो साब-कताब लागणअ दैणअ। परमेशर आसा सोभी लोगे नसाफ करना लै तैर, च़ाऐ तिंयां अज़ी ज़िऊंदै आसा, च़ाऐ तिंयां पैहलै होए मरी गऐ दै।<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="2TI 4:1">2 तिम. 4:1</ref></char></note><verse eid="1PE 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 4:6" />तैही खोज़अ तिन्‍नां मणछा का बी मसीहा खुशीओ समाद ज़ुंण पैहलै ई थिऐ मरी गऐ दै। एही ता भुगती तिन्‍नैं सोभी मणछा ज़ेही सज़ा अर तिंयां मूंऐं, पर ऐबै आसा तिंयां आत्मां दी परमेशरा संघै सदा ज़िऊंदै।<verse eid="1PE 4:6" /></para>
  <para style="s">परमेशरे भलै भढारी</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />एऊ संसारो अंत आसा छ़ेक्‍कै हणैं आल़अ, तैही करा तम्हैं आप्पू सबर, संघा रहा सादै-सिधै रही प्राथणां करदै लागी।<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="EPH 6:18">इफि. 6:18</ref>; <ref loc="JAS 5:8">याक. 5:8</ref></char></note><verse eid="1PE 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 4:8" />सोभी लै आसा सोभी का ज़रूरी गल्‍ल एही कि एकी-दुजै लै करा दिला का झ़ूरी। किल्हैकि, ज़ै तम्हैं मणछा लै झ़ूरी करे तै हणैं तम्हैं तिन्‍नें हर गलती माफ करना लै हर बगत तैर।<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">सैणीं. 10:12</ref></char></note><verse eid="1PE 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 4:9" />ज़ै कुंण विश्वासी हांढदी-फिरदी थारै घअरै प्राहुंणअ एछे, तेऊ लै निं नराज़ हणअ, पर तम्हैं तेऊए च़ाकरी खुशी दिलै।<verse eid="1PE 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 4:10" />सोभी मणछा आसा परमेशरा का किज़ै नां किज़ै बरदान भेटअ द अर तेऊ लागा तेऊ बरदाना करै दुजे च़ाकरी करनी। तिन्‍नां लागा तिंयां बरदान राम्बल़ै करै कामैं लाणैं ज़ुंण तिन्‍नां लै परमेशरै आपणैं जशा करै आसा दैनै दै। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />ज़ै तम्हां का प्रच़ार करनैओ बरदान आसा, तम्हां लागा परमेशरो बैण प्रच़ार करनअ। ज़ै तम्हां का होरीए मज़त करनैओ बरदान आसा, तेऊ करै पूरअ ज़ोर लाई ज़ुंण तम्हां लै परमेशरै आसा दैनअ द। तेखअ तम्हैं ज़िहअ बी करे तेता करै हणअ मसीहा ईशू बाती परमेशरो प्रतप्प। सारअ प्रतप्प अर राज़ आसा सदा-सदा लै तेऊओ ई! एवमस्तू।<verse eid="1PE 4:11" /></para>
  <para style="s">मसीहे दुखा दी साझ़ू हणअ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />मेरै पैरै भाईओ, तिन्‍नां गल्‍ला लै निं रहैन हई ज़ुंण दुख दाह तम्हैं मसीहा ईशूए हणैं पिछ़ू तम्हैं भुगतदै आसा लागै दै। पर ईंयां गल्‍ला आसा एते तैणीं लागी दी हंदी कि थारै विश्वासे परख होए कि असली दी थारअ विश्वास परमेशरा दी आसा कि नांईं। इहअ निं सोठा कि ईंयां एही गल्‍ला किल्है आसा लागी दी हंदी ज़ुंण हाम्हां लै पाखली आसा। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />एते बारै रहा इहअ सोठी करै खुश कि तम्हैं हुऐ मसीहे तिन्‍नां दुखा दी साझ़ू ज़ुंण तेऊ ज़िरै। किल्हैकि तम्हैं बी आसा तिहै ई दुख ज़िरदै लागै दै। ज़ेभै मसीहा ईशू सोभी लोगा लै आपणैं प्रतप्पा प्रगट करदअ फिरी एछणअ, तेभै हणीं तम्हां होर बी खास्सी खुशी।<verse eid="1PE 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 4:14" />तेखअ ज़ै मसीहे नाओंआं लै थारी निंदा बी हआ, परमेशरा दैणीं तम्हां लै बर्गत। किल्हैकि एता करै लागा थोघ कि परमेशरे प्रतप्पा आल़ी आत्मां खोज़ा तम्हां संघै रही कि परमेशर किहअ महान आसा।<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="MAT 5:11-12">मोत्त. 5:11-12</ref></char></note><verse eid="1PE 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 4:15" />तम्हां मांझ़ै निं कोई बी मणछ हत्या करनै आल़अ, या च़ोर, या कदुष्ट कामां करनै आल़ै हणैं या पराऐ कामां दी खरोल़ पाई निं दुख भुगती। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />पर ज़ै तम्हैं मसीही हणें पिछ़ू तम्हैं दुख भेटे, तै निं तम्हैं शर्मिंदै हई, पर ऐहा गल्‍ला लै करै परमेशरे ज़ै-ज़ैकार।<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />हुंह बोला इहअ एते तैणीं कि परमेशरो नसाफ हणैंओ बगत गअ नेल़ एछी। पैहलै करनअ तेऊ तिन्‍नां लोगो नसाफ ज़ुंण तेऊए आपणैं आसा। ज़ै परमेशरा हाम्हां विश्वासीओ नसाफ पैहलै करनअ, तैहा डरैऊंणी गल्‍ले बारै सोठा ज़ुंण तिन्‍नां मणछा लै हणीं ज़ुंणी परमेशरा का आअ द सह खुशीओ समाद नांईं मनअ।<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="HEB 12:24-25">इब्रा. 12:24-25</ref>; <ref loc="JER 25:29">जेर. 25:29</ref>; <ref loc="EZK 9:6">एज. 9:6</ref></char></note><verse eid="1PE 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 4:18" />ज़िहअ पबित्र शास्त्र बोला,<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">सैणीं. 11:31</ref></char></note></para>
  <para style="q" vid="1PE 4:18">“ज़ै धर्मीं मणछा फल ऐहा ई धरती दी फल भेटा,</para>
  <para style="q" vid="1PE 4:18">तै भेटणअ कदुष्ट अर पापी मणछा बी तिन्‍नों फल ज़रूर।”<verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />तैही ज़हा तिहअ दुख भेटअ ज़िहअ परमेशर च़ाहा तिन्‍नां लागा सदा तेऊ परमेशरा दी भरोस्सअ डाहणअ ज़ुंणी तिंयां बणाऐं दै आसा। परमेशर करा सदा तिहअ ई ज़िहअ सह बोला। इहअ करै रहा हर बगत भलै करदै लागी<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">टोलीए सैणैं अर ज़ुआन मणछा लै समाद</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />धख आसा होर गल्‍ला बी ज़ुंण हुंह तम्हां तिधे टोलीए सैणैं लै च़ाहा बोल़णअ किल्हैकि हुंह बी आसा तम्हां ई ज़िहअ सैणअ। मंऐं भाल़ै तिंयां दाह-दुख आपणीं आछी ज़ुंण मसीहा खास्सी साला पैहलै भेटै। ज़ेभै सह भिई फिरी एछणअ, हुंबी हणअ तेऊए प्रतप्पा दी साझ़ू ज़ेभै सह सारै संसारा लै प्रगट हणअ। थारअ संघी सैणअ हणें साबै करा हुंह तम्हां का अरज़ कि<verse eid="1PE 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 5:2" />ज़िहअ एक फुआल आपणीं भेडा हेरअ-भाल़अ रहा लागी, तम्हैं बी रहा तिन्‍नां हेरै-भाल़ै लागी ज़ुंण परमेशरै तम्हां का आसा सभाल़ै दै। एता करा दिला का किल्हैकि परमेशर च़ाहा इहअ ई कि तम्हैं करे। इहअ निं सिधअ तै करा कि तम्हां लै बोलअ कुंणी ज़बरदस्ती विश्वासीए हेर-सभाल़ करना लै। एऊ कामां निं एते तैणीं करा कि तम्हां लै कुंण ढब्बै दैए पर थारै दिलै लोल़ी असली दी परमेशरे अर लोगे च़ाकरी करने च़ाहा हुई। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ज़ुंण लोग तम्हां का सभाल़ै दै आसा, इहअ निं समझ़ा कि तिन्‍नां प्रैंदै आसा थारअ राज़, पर तम्हैं करा एही च़ाकरी कि तिंयां तम्हां का शिखल़े। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />मसीहा ईशू आसा हाम्हां लै सैणैं फुआला ज़िहअ, ज़ेभै सह भिई फिरी एछणअ, तेभै दैणअ तेऊ तम्हां लै शोभलअ मुगट नांम तेतो झ़ामण निं कधि खतम हणअ।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ऐबै बोला हुंह तम्हां ज़ुआन मणछा लै कि टोली दी ज़ुंण थारै सैणैं विश्वासी आसा तम्हैं रहा तिन्‍नें डरा हेठै। एकी दुजे करनी सादै-सिधै रही च़ाकरी किल्हैकि हाम्हैं सका पबित्र शास्त्रा दी इहअ लिखअ द पहल़ी कि</para>
  <para style="q" vid="1PE 5:5">“परमेशर करा घमंडी मणछो बरोध, पर</para>
  <para style="q" vid="1PE 5:5">सादै-सिधै मणछा लै करा झींण।”<verse eid="1PE 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6" />तैही रहा परमेशरा सम्हनै सादै-सिधै ज़हा का थारी फाज़त करनैओ बल आसा। ताकि सह थारअ तैहा धैल़ी अदर करे ज़ुंण तेऊ काढी आसा डाही दी। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />अर आपणीं सारी फिकर छ़ाडा तेऊ दी, किल्हैकि तेऊ आसा थारअ धैन-खैल।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />हर बगत रहा चतैन अर बिहुदै रहा, किल्हैकि थारअ दुशमण राख्स आसा तम्हां बरैबाद करने ताका दी। सह आसा सिहा ज़ेही क्रुंगा लाई लोल़अ लागअ द कि कहा धेल़ा-च़िरा। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />तम्हैं करा विश्वासा दी पाक्‍कै रही तेऊओ बरोध। तिन्‍नां विश्वासी भाई-बैहणी करा आद ज़ुंण सारै संसारै आसा रहंदै लागै दै तिंयां बी आसा लागै दै इहै ई दाह-दुख ज़िरदै ज़ुंण तम्हां आसा।<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />परमेशर ज़ुंण जशा करै भरपूर आसा, तेऊ शादै हाम्हैं स्वर्गे सदा रहणैं आल़ै प्रतप्पे साझ़ू हणां लै किल्हैकि हाम्हैं आसा मसीहा संघै एक हुऐ दै। थोल़ी घल़ी दाह-दुख भुगतणै का बाद बणाणैं परमेशरा तम्हैं भलै, तेखअ निं तम्हां दी किछ़ै दोश हणअ अर तेऊ दैणअ तम्हां लै बल ताकि थारअ विश्वास पाक्‍कअ होए। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />तेऊओ ई राज़ लोल़ी जुगै-जुगै रहअ। एवमस्तू।<verse eid="1PE 5:11" /></para>
  <para style="s">खिरी अदर करनअ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />मंऐं दैनी अह होछ़ी ज़ेही च़िठी सिलासे हाथै तम्हां लै। हुंह समझ़ा तेऊ मसीहा दी विश्वास करनै आल़अ आपणअ इहअ भाई ज़ुंण शुचअ-पाक्‍कअ आसा। मेरअ ऐहा च़िठी लिखणेओ मकसद आसा तम्हां लै हैअ दैणअ अर ऐहा गल्‍लो निहंचअ दैणअ कि ज़ुंण दाह-दुख बी तम्हां लै एभै आसा हंदअ लागअ द सह आसा असली दी तम्हां लै परमेशरे जशो भाग। एऊ जशा दी रहा पाक्‍कै टेक्‍की।<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />रोम देशे बाबेल नगरी ज़ुंण तम्हां ई ज़िहै आसा परमेशरै छ़ांटै दै, तिंयां बी दैआ तम्हां लै राज्ज़ी-खुशी। मार्कुस ज़ुंण मुल्है मेरै शोहरू ज़िहअ आसा, तेऊ बी आसा तम्हां लै राज्ज़ी-खुशी दैनी दी। <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />एकी-दुजै लै दैआ दिला का झ़ूरी संघै मल़्हैची दैई राज्ज़ी-खुशी।</para>
  <para style="p" vid="1PE 5:14">हुंह करा परमेशरा का प्राथणां कि सह तम्हां सोभी लै शांती दैए ज़ुंण मसीहा संघै एक आसा हुऐ दै।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>