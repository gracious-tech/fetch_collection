  <para style="h">1 जोहन्‍ना</para>
  <para style="toc1">जोहन्‍ना लिखी दी पैहली च़िठी</para>
  <para style="toc2">1 जोहन्‍ना</para>
  <para style="toc3">1 जोह.</para>
  <para style="mt1">1 जोहन्‍ना</para>
  <para style="mt2">जोहन्‍ना लिखी दी पैहली च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जोहन्‍ना</para>
  <para style="ili">पहल़णैं आल़ै: एशिया मुल्खै रहणैं आल़ै विश्वासी</para>
  <para style="ili">सन: 80-95</para>
  <para style="ip">जोहन्‍ने ऐहा पैहली च़िठीए आसा दूई मकसद (1) आपणैं पहल़णैं आल़ै परमेशर अर तेऊए शोहरू ईशू मसीहे साझ़ू हई ज़िन्दगी ज़िऊंणां लै हैअ दैणअ। (2) तिन्‍नां लै एही झ़ुठी शिक्षे खलाफ चतैनगी दैणीं ज़ेता करै परमेशरा संघै अह साझ़ खतम हआ। अह झ़ुठी शिक्षा ती ऐहा गल्‍ला प्रैंदै कि आछी शुझदै संसारा संघै कठा रही पनपा बूराई। तैही निं ईशू मसीहा परमेशरो पूत असली दी मणछो शोहरू हई ई सकदअ। इना एही गूरूओ त इहअ दाऊअ कि उद्धार पाणा लै लागा हरेकी मणछा संसारे ज़िन्दगीए बारै कई च़िज़ा का छ़ुटणअ। तिंयां सखाऊआ तै इहअ कि नित-पत्त अर भाई संघै झ़ूरी ज़ेही गल्‍लो निं उद्धारा का कोई लणअ-दैणअ आथी।</para>
  <para style="ip">ऐहा शिक्षे खलाफ बोला लिखणैं आल़अ साफ-साफ कि ईशू मसीहा त असली दी एक मणछ, तेखअ दैआ सह ऐहा गल्‍ला दी ज़ोर कि तिंयां लोग ज़ुंण ईशू मसीहा दी विश्वास करा अर परमेशरा संघै झ़ूरी डाहा, तिन्‍नां लागा आप्पू मांझ़ै बी झ़ूरी ज़रूरी डाहणीं। जोहन्‍ना बोला:</para>
  <para style="imq">“हाम्हैं खोज़ा तेऊए बारै ज़ुंण सोभी का आजी थिअ अर ज़सरै बारै हाम्हैं शूणअ अर ज़ुंण हाम्हैं भाल़अ। हाम्हैं भाल़अ सह आपणीं आछी अर आपणैं हाथा करै छ़ुंअ बी। सह आसा ज़िन्दगी दैणैं आल़अ बैण।”</para>
  <para style="ipr">(1.1)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1:1-4</para>
  <para style="io1">न्हैरअ अर प्रैश्शअ 1:5—2:29</para>
  <para style="io1">परमेशरे लुआद अर राख्से लुआद 3:1-24</para>
  <para style="io1">शुचअ अर झ़ुठ 4:1-6</para>
  <para style="io1">झ़ूरी डाहणें ज़िम्मैंबारी 4:7-21</para>
  <para style="io1">पाक्‍कअ विश्वास 5:1-21</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">ज़िन्दगी दैणैं आल़अ बैण</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />हाम्हैं खोज़ा तेऊए बारै ज़ुंण सोभी का आजी थिअ अर ज़सरै बारै हाम्हैं शूणअ अर ज़ुंण हाम्हैं भाल़अ। हाम्हैं भाल़अ सह आपणीं आछी अर आपणैं हाथा करै छ़ुंअ बी। सह आसा ज़िन्दगी दैणैं आल़अ बैण। <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />अह बैण ज़ुंण आप्पू ई ज़िन्दगी आसा अह हुअ हाम्हां लै प्रगट अर हाम्हैं भाल़अ आपणीं आछी। ऐबै आसा हाम्हैं तेते शाजत अर हाम्हैं खोज़ा तेऊ ई सदा रहणैं आल़ी ज़िन्दगीओ समाद तम्हां का, ज़ुंण बाब परमेशरा संघै त अर हाम्हां लै हुअ प्रगट।<verse eid="1JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 1:3" />ज़ुंण बी हाम्हैं शूणअ अर भाल़अ द आसा, हाम्हैं खोज़ा तेतो समाद तम्हां का बी ताकि तम्हैं बी हाम्हां संघै साझ़ू हई सके। म्हारी साझ़ आसा बाब परमेशरा संघै अर तेऊए पूत मसीहा ईशू संघै। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />इना गल्‍ला लिखा हाम्हैं तम्हां लै एते तैणीं कि म्हारी खुशी लोल़ी पूरी हुई।<verse eid="1JN 1:4" /></para>
  <para style="s">प्रैश्शै दी हांढणअ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />अह समाद आसा हाम्हैं ईशू का शूणअ द अर ऐबै खोज़ा हाम्हैं एऊ तम्हां का: अह आसा इहअ कि परमेशर आसा प्रैश्शै ज़िहअ शुचअ, अर तेथ निं किछ़ बी न्हैरै ज़ेही किछ़ै बूरी गल्‍ल आथी। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />ज़ै हाम्हैं इहअ बोले कि प्रभू संघै आसा म्हारी साझ़ अर तेखअ बी हांढे हाम्हैं न्हैरै दी! तै आसा हाम्हैं झ़ुठै अर तै निं हाम्हैं सत्ता दी रहणैं आल़ै आथी। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />पर ज़िहअ परमेशर प्रैश्शअ आसा, ज़ै तिहै ई हाम्हैं बी प्रैश्शै दी हांढे, तै हआ म्हारी एकी-दुजै संघै साझ़ अर तेऊए पूत मसीहा ईशूओ लोहू करा हाम्हां सोभी पापा का शुचै।<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ISA 2:5">ईशा. 2:5</ref></char></note><verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />ज़ै हाम्हैं इहअ बोले कि हाम्हां दी निं किछ़ै पाप आथी, तै दैआ हाम्हैं आप्पू लै धोखअ अर तै निं हाम्हां दी किछ़ै सत्त आथी। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />ज़ै हाम्हैं परमेशरा सेटा आपणैं पाप मने, तै आसा परमेशर म्हारै पाप माफ करनै अर हाम्हां म्हारै सारै पापा का शुचै करना लै विश्वास करनै जोगी अर धर्मीं।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 32:5">भज. 32:5</ref>; <ref loc="PRO 28:13">सैणीं. 28:13</ref></char></note><verse eid="1JN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1JN 1:10" />पर ज़ै हाम्हैं इहअ बोले कि हाम्हैं निं किछ़ै पाप किअ, तै बणाआं हाम्हैं तेऊ परमेशरा झ़ुठअ अर तै निं अज़ी तेऊओ बैण हाम्हां दी आथी।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">मसीहा आसा म्हारअ मज़त करनै आल़अ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ए मेरै लान्हैंओ, मंऐं लिखी तम्हां लै तै ईंयां गल्‍ला एते तैणीं कि तम्हैं पाप नां करे। पर ज़ै कोई पाप करे, तेता लै आसा बाब परमेशरा का आसा हाम्हां बाखा एक गल्‍ला करनै आल़अ, मतलब प्रभू ईशू मसीहा ज़ुंण धर्मीं आसा। <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />सह ई आसा म्हारै पापो प्राश्त-बल़ीदान, सिधअ म्हारै ई निं पर सारै संसारे पाप माफ करना लै बी आसा सह ई।<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />ज़ै हाम्हैं तेऊओ हुकम मने, तै जाणअ हाम्हां का थोघ लागी कि हाम्हैं हेरअ सह बछ़ैणीं।<verse eid="1JN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 2:4" />ज़ुंण बी इहअ बोला कि हाम्हैं हेरअ परमेशर बछ़ैणीं, अर ज़िहअ सह च़ाहा तिहअ निं करदअ आथी, सह आसा झ़ुठअ अर तेऊ दी निं परमेशरो सत्त आथी। <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />पर ज़ुंण बी तेऊए बैणे साबै ज़िन्दगी ज़िऊए, तेऊ दी हुई सच्च़ी परमेशरे झ़ूरी पाक्‍की, एता करै लागा हाम्हां का थोघ कि हाम्हैं आसा तेऊ दी। <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ज़ै कुंण इहअ बोला कि हुंह रहा परमेशरा दी, तेऊ लोल़ी इहअ कि सह आप्पू बी तिहअ ई करे, ज़िहअ प्रभू आप्पू त।<verse eid="1JN 2:6" /></para>
  <para style="s">नऊंअ हुकम</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />मेरै पैरै भाईओ, हुंह निं तम्हां लै किछ़ै नऊंअ हुकम लिखदअ, पर ईंयां आसा तिंयां ई पराणैं हुकम ज़ुंण तम्हां सेटा शुरू का आसा भेटै दै, ईंयां पराणैं हुकम आसा तिंयां ई बैण ज़ुंण तम्हैं तधू आसा शूणैं दै ज़धू तम्हैं मसीहा दी विश्वास किअ। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />तेखअ लिखा हुंह तम्हां लै एक नऊंअ हुकम, अह आसा असली सह सत्त ज़ेथ मसीहा त अर तम्हैं बी आसा। किल्हैकि न्हैरै ज़ेही बूरी गल्‍ला लागी दूर हंदी अर सत्तो प्रैश्शअ लागअ च़मकदअ।<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />ज़ुंण इहअ बोला कि हुंह आसा प्रैश्शै दी, अर आपणैं साथी-भाई संघै करा ज़ीद, सह आसा अज़ी बी न्हैरै दी। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />ज़ुंण आपणैं भाई लै झ़ूरी करा, सह रहा प्रैश्शै दी अर तेऊ दी निं एही किछ़ै गल्‍ल आथी ज़ुंण कहा होरी का पाप कराओए। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />पर ज़ुंण आपणैं भाई संघै ज़ीद करा, सह आसा न्हैरै दी अर सह हांढा बी न्हैरै दी। तेऊ का निं इहअ थोघ हंदअ कि सह किधा लै च़ाल्‍लअ डेऊई, किल्हैकि न्हैरै आसा डाही दी तेऊए आछी कांणी करी।<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ए लान्हैंओ, हुंह लिखा तम्हां लै एते तैणीं कि प्रभू ईशूए नाओंए आसा हुऐ दै थारै पाप माफ।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 25:11">भज. 25:11</ref></char></note><verse eid="1JN 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 2:13" />ज़ुंण तम्हैं सैणैं आसा, हुंह लिखा तम्हां लै एते तैणीं कि तम्हां का आसा ईशूए बारै थोघ कि सह आसा पैहलै ई का।</para>
  <para style="p" vid="1JN 2:13">ओ ज़ुआन मणछो, तम्हां लै लिखा हुंह एते तैणीं कि तम्हैं आसा तेऊ कदुष्ट राख्सा का जुध ज़िती गऐ दै।</para>
  <para style="p" vid="1JN 2:13">परमेशरे लान्हैंओ, तम्हां लै लिखा हुंह एते तैणीं कि तम्हैं हेरअ बाब परमेशर बछ़ैणीं।<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />सैणैं मणछो, मंऐं लिखअ तम्हां लै एते तैणीं कि ज़ुंण पैहलै का आसा, तम्हां का आसा तेऊओ थोघ।</para>
  <para style="p" vid="1JN 2:14">ओ कुंआरै मणछो, तम्हां लै लिखअ मंऐं तै कि तम्हैं आसा विश्वासा दी जोधै अर परमेशरो बैण लोल़ी थारै दिलै रहअ, अर तम्हैं आसा हेरअ द तेऊ कदुष्ट राख्सा का जुध ज़िती।<verse eid="1JN 2:14" /></para>
  <para style="s">संसारा संघै झ़ूरी निं डाहणीं</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />तम्हैं नां संसारा का अर नां संसारे च़िज़ा का झ़ूरी करी। ज़ै कुंण संसारा का झ़ूरी करा, तेऊ दी निं म्हारै बाब परमेशरे झ़ूरी आथी। <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />किल्हैकि ज़ुंण बी संसारै बूरी गल्‍ला आसा तिंयां निं म्हारै बाब परमेशरा बाखा आथी, पर तिंयां आसा संसारा बाखा ज़हा कामां करनैओ अर भाल़णेंओ तिन्‍नां च़ाअ लागा अर ज़ेऊ साबै ज़िऊंणेंओ तिन्‍नां घमंड आसा।<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 13:14">रोम. 13:14</ref>; <ref loc="PRO 27:20">सैणीं. 27:20</ref></char></note><verse eid="1JN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 2:17" />संसार ज़ुंण परमेशरो अदर नांईं करदअ सह हणअ तेऊए दिले च़ाहा संघी बरैबाद। पर ज़ुंण ज़िहअ परमेशर च़ाहा तिहअ करे तिंयां रहणैं सदा बणी।<verse eid="1JN 2:17" /></para>
  <para style="s">मसीहा-बरोधी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ए लान्हैंओ, अह आसा खिरीओ बगत। ज़िहअ तम्हैं शूणअ द आसा कि मसीहो बरोधी आसा एछणैं आल़अ, तेते साबै आसा गऐ दै कई मसीहा बरोधी उझ़ुई। इहअ करै लागा हाम्हां का थोघ कि अह आसा खिरीओ बगत। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />तिंयां मसीहे बरोधी निखल़ै दै, आसा हाम्हां ई मांझ़ा का, पर असली दी नांईं तै तिंयां म्हारै आथी! किल्हैकि, ज़ै तिंयां म्हारै हंदै, तै रहंदै तिंयां हाम्हां संघै। पर हाम्हां का दूर डेऊऐ तिंयां एते तैणीं कि इहअ थोघ लागे कि तिंयां निं हाम्हां सोभी संघै आथी।<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />थारअ आसा तेऊ मसीहे पबित्र आत्मां दैई अभिषेक किअ द तेता करै हेरा तम्हैं सारअ सत्त समझ़ी। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />मंऐं निं तम्हां लै एते तैणीं लिखअ कि तम्हां का निं सत्तो थोघ आथी। पर मंऐं लिखअ तम्हां लै तै कि तम्हां का आसा थोघ अर तैबी कि कोई बी झ़ुठ निं सत्ता बाखा आथी। <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />झ़ुठअ कुंण आसा? सह आसा झ़ुठअ ज़ुंण प्रभू ईशू लै इहअ बोला कि सह निं मसीहा आथी। मसीहो बरोधी आसा सह ई ज़ुंण बाब अर पूता लै हुधिआ। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />ज़ुंण पूता लै हुधिआ, तेऊ सेटा निं बाब बी आथी, ज़ुंण पूता मना, तेऊ सेटा आसा बाब बी।<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />ज़ुंण बी तम्हैं शुरू का आसा शूणअ द, सह ई लोल़ी तम्हां दी बस्सी रहअ, तै रहणैं तम्हैं बी पूत अर बाबा दी बस्सी। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ज़ुंण हाम्हां अह सदा रहणैं आल़ी ज़िन्दगी भेटी अह आसा परमेशरै हाम्हां लै करार किई दी।<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />मंऐं आसा लिखी दी ईंयां गल्‍ला तम्हां लै तिन्‍नें बारै चतैन रहणा लै ज़ुंण तम्हां धोखै करै मसीहे सत्ता का कबाता पाआ। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />थारअ आसा तेऊ पबित्र मसीहे पबित्र आत्मां दैई अभिषेक किअ द, सह बस्सा तम्हां दी। तम्हां निं एते ज़रुरत आथी कि कुंण तम्हां सेटा एछी सत्ते बारै सखाओए। पर ज़ुंण पबित्र आत्मां तम्हां लै आसा दैनअ द, सह सखाऊआ तम्हां का तिन्‍नां सोभी गल्‍ला ज़ेते तम्हां ज़रुरत हआ ज़ुंण बी तम्हां सह सखाओए तिंयां गल्‍ला आसा शुची तेथ निं किछ़ै झ़ुठअ आथी। ज़िहै तम्हैं तेऊ सखाऊऐ दै आसा, तिहै ई रहा तम्हैं मसीहा दी बस्सी।<note caller="-" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="JHN 14:26">जोह. 14:26</ref></char></note><verse eid="1JN 2:27" /></para>
  <para style="s">परमेशरे लुआद</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />इहअ करै ए लान्हैंओ, प्रभू दी रहा पाक्‍कै, कि ज़ेभै सह प्रगट होए, तेभै लोल़ी हाम्हां हैअ हुअ कि ज़ेभै सह फिरी एछे तेभै निं लोल़ी पल़अ शर्मिंदअ हणअ।<verse eid="1JN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29" />ज़ै तम्हैं इहअ समझ़े कि मसीहा आसा धर्मीं तै लआ ऐहा गल्‍ला बी समझ़ी कि हरेक मणछ ज़ुंण धर्मीं आसा सह आसा परमेशरे लुआद।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />सोठा, बाब परमेशरै हाम्हां संघै केही झ़ूरी किई, कि हाम्हैं तेऊए लुआद हई सके। हाम्हैं तेऊए लुआद आसा बी, तैही निं संसार हाम्हां बछ़ैणदअ, किल्हैकि तिन्‍नैं निं प्रभू, म्हारअ बाब परमेशर बी बछ़ैणअ। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />मेरै पैरै भाईओ, ऐबै आसा हाम्हैं परमेशरे लुआद, अर अज़ी बी निं अह प्रगट हुअ कि आजू हाम्हैं किज़ै-किज़ै हणैं, पर एतरअ आसा हाम्हां का थोघ कि ज़ेभै सह प्रगट होए, तेभै हणैं हाम्हैं बी तेऊ ज़िहै, किल्हैकि सह हेरनअ हाम्हां तिहअ ई ज़िहअ सह आसा। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />ज़ुंण बी मसीहा दी आशा डाहा, सह हआ आप्पू बी तिहअ शुचअ ज़िहअ प्रभू आसा पबित्र आसा।<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />ज़ुंण पाप करा, सह करा बधानो बरोध अर परमेशरो बधान नांईं मनणअ आसा पाप। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />तम्हां का आसा ऐहा गल्‍लो थोघ कि मसीहा आअ एते तैणीं कि म्हारै पाप दूर करे। तम्हां का इहअ बी आसा थोघ कि तेऊ निं कधि पाप किअ।<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">जोह. 1:29</ref></char></note><verse eid="1JN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 3:6" />ज़ुंण बी तेऊ प्रभू दी टेक्‍की रहे, सह निं पाप करदअ। ज़ुंण कबल्‍लअ रहा पाप करदअ लागी, तेऊ नां प्रभू भाल़अ द आथी, नां सह तेऊ बछ़ैणदअ आथी।<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ए लान्हैंओ, कसरै ज़ाणैं निं लागी, ज़ुंण धर्में काम करा, सह आसा तेऊ प्रभू ई ज़िहअ धर्मीं। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />ज़ुंण कबल्‍लअ रहा पाप करदअ लागी, सह आसा राख्सा बाखा। किल्हैकि राख्स करा शुरू ई का पाप। परमेशरो पूत आअ एते तैणीं कि राख्से तिन्‍नां सारै कामां बरैबाद करे। <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />ज़ुंण बी परमेशरे लुआद आसा सह निं कधि पाप करदअ। किल्हैकि परमेशरो बेज़अ रहा तेऊ दी टेक्‍की अर सह निं पाप करी ई सकदअ, किल्हैकि सह आसा परमेशरे लुआद। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />एता ई करै बछ़ैणियां परमेशरे लुआद अर राख्से लुआद। ज़ुंण बी धर्में काम नांईं करदअ, सह निं परमेशरा का आथी अर सह बी निं परमेशरो आथी ज़ुंण आपणैं भाई संघै झ़ूरी निं डाहंदअ।<verse eid="1JN 3:10" /></para>
  <para style="s">एकी-दुजै संघै करनी झ़ूरी</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />ज़ुंण समाद तम्हैं पैहलै ई का आसा शूणअ द, सह आसा इहअ कि हाम्हैं एकी-दुजै संघै झ़ूरी डाहे। <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />तेऊ आदी मणछ आदमीए शोहरू कैना ज़िहअ निं बणी, ज़ुंण कदुष्ट त अर ज़ुंणी आपणैं भाऊए हत्या किई? तेऊ किअ इहअ तै कि तेऊए काम तै बूरै अर तेऊए भाऊए काम तै धर्मीं।<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 38:20">भज. 38:20</ref></char></note><verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />भाईओ, ज़ै तम्हां संघै संसार ज़ीद करा, तैहा गल्‍ला लै निं रहैन हई।<verse eid="1JN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 3:14" />हाम्हैं हेरा जाणीं कि हाम्हां आसा मौता का पार तरी करै ज़िन्दगी दी पुजै दै। किल्हैकि हाम्हैं करा आपणैं भाई लै झ़ूरी। ज़ुंण आपणैं भाई लै झ़ूरी नांईं करदअ, सह हआ मूंऐं दै ज़िहअ। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />ज़ुंण बी आपणैं भाई लै ज़ीद करा, सह आसा हत्या करनै आल़अ अर तम्हां का आसा थोघ कि हत्या करनै आल़ै दी निं सदा रहणैं आल़ी ज़िन्दगी हंदी।<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />हाम्हैं समझ़ी झ़ूरी इहअ करै कि तेऊ प्रभू दैनै म्हारी तैणीं आपणैं प्राण बी। इहअ ई लागा हाम्हां बी आपणैं भाई-बंधा लै हर गल्‍ला लै तैर रहणअ च़ाऐ हाम्हां मरनअ बी किल्है निं पल़े। <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />पर ज़ै कहा का संसारे ज़ैदात होए अर आपणैं भाई नांगअ भुखअ भाल़ी तेऊ लै झींण नांईं करे, तेऊ दी किहअ करै सका परमेशरे झ़ूरी बस्सी।<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">बधा. 15:7-8</ref></char></note><verse eid="1JN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 3:18" />ए लान्हैंओ, म्हारी झ़ूरी निं लोल़ी सिधी गल्‍ला करनै दी रही, पर हाम्हैं लोल़ी भलै काम अर सत्ता दी रही झ़ूरी किई।<verse eid="1JN 3:18" /></para>
  <para style="s">परमेशरा सम्हनै हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />एकी-दुजै लै झ़ूरी करी बछ़ैणियां हाम्हैं कि हाम्हैं आसा सत्ता बाखा अर ज़ै तेता लै म्हारी सोर हाम्हां लै दोश दैआ, तेता लै बी सका हाम्हैं परमेशरा सम्हनै निहंचै रही। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />किल्हैकि परमेशर आसा म्हारी सोर-समझ़ा का खास्सअ बडअ अर तेऊ का आसा सोभी गल्‍लो थोघ।<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />मेरै पैरै भाईओ, ज़ै म्हारी सोर हाम्हां लै दोश नांईं लाए, तै हआ हाम्हां आपणैं परमेशरा सम्हनै हैअ। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />तेखअ ज़ुंण बी हाम्हैं परमेशरा का मांगा, सह जाआ हाम्हां तेऊ का भेटी। किल्हैकि हाम्हैं मना तेऊए हुकम अर हाम्हैं करा तिहअ ई ज़ेता करै सह खुश हआ।<verse eid="1JN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1JN 3:23" />तेऊओ हुकम आसा इहअ कि हाम्हैं तेऊए पूत प्रभू ईशू मसीहा दी विश्वास करे अर ज़िहअ तेऊ हाम्हां लै हुकम आसा दैनअ द, तेऊ ई साबै हाम्हैं आप्पू मांझ़ै झ़ूरी डाहे। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />ज़ुंण प्रभूओ हुकम मना, सह बस्सा परमेशरा दी अर परमेशर रहा तेऊ दी बस्सी अर एता ई करै मतलब तैहा पबित्र आत्मां करै ज़ुंण परमेशरै हाम्हां लै आसा दैनी दी, हाम्हां का आसा थोघ कि परमेशर बस्सा हाम्हां दी।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">आत्मां करनी परखी</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />मेरै पैरै भाईओ, हरेक मणछ ज़ुंण इहअ बोला, “मुंह दी बस्सा परमेशरे आत्मां” तेऊओ विश्वास निं करनअ। पर सोभी आत्मां लआ परखी कि तिंयां परमेशरा का आसा कि नांईं। किल्हैकि खास्सै कबाता पाणै आल़ै झ़ुठै गूर आसा संसारै ज़ुंण परमेशरे निं आथी। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />परमेशरे आत्मां सका तम्हैं इहअ करै समझ़ी कि ज़ुंण बी आत्मां इहअ मना कि मसीहा ईशू आसा मणछ देही धरी करै आअ द अर सह आसा परमेशरा का। <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />ज़ुंण आत्मां ईशू नांईं मंदी, सह निं परमेशरा का आथी। सह आसा मसीहो बरोध करनै आल़ेए आत्मां ज़सरै बारै तम्हैं शूणअ द आसा कि सह आसा एछणैं आल़अ अर एभै बी आसा सह एऊ ई संसारै।<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />मेरै पैरै लान्हैंओ, तम्हैं आसा परमेशरे। तम्हैं आसा तिन्‍नां झ़ुठै गूरा का ज़िती गऐ दै। किल्हैकि ज़ुंण पबित्र आत्मां तम्हां दी बस्सा, सह आसा तेऊ राख्से शगती का बडअ ज़ुंण संसारै आसा। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />तिंयां झ़ुठै गूर आसा संसारे। तैही बोला तिंयां संसारे गल्‍ला अर संसार बी शूणां तिन्‍नें गल्‍ला। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />हाम्हैं आसा परमेशरे ज़हा का परमेशरो थोघ आसा, सह शूणां म्हारी गल्‍ला। ज़हा का परमेशरो थोघ निं आथी सह निं म्हारी शुण्हदअ। इहअ करै सका हाम्हां सत्त खोज़णैं आल़ी आत्मां अर कबाता पाणै आल़ी आत्मां बछ़ैणीं।<verse eid="1JN 4:6" /></para>
  <para style="s">एकी-दुजै लै करनी झ़ूरी</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />मेरै पैरै भाईओ, हाम्हां लागा आप्पू मांझ़ै झ़ूरी करनी। किल्हैकि झ़ूरी आसा परमेशरा का अर ज़ुंण होरी लै झ़ूरी करा सह आसा परमेशरे लुआद, अर सह बछ़ैणा परमेशरा। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />ज़ुंण होरी लै झ़ूरी नांईं करदअ, तेऊ का निं परमेशरो थोघ आथी, किल्हैकि परमेशर आसा झ़ूरी।<verse eid="1JN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 4:9" />ज़ुंण झ़ूरी परमेशर हाम्हां संघै करा, सह हुई इहअ करे प्रगट कि परमेशरै छ़ाडअ आपणअ कल्हअ पूत संसारै ताकि हाम्हां तेऊ करै सदा रहणैं आल़ी ज़िन्दगी भेटे। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />झ़ूरी निं एता दी आथी कि हाम्हैं किई परमेशरा संघै झ़ूरी, पर सह आसा एता दी कि परमेशरै किई हाम्हां लै झ़ूरी अर म्हारै पापे प्राश्ते तैणीं दैनअ आपणअ पूत एऊ संसारा लै।<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />मेरै पैरै भाईओ, ज़ै परमेशरै हाम्हां संघै एही झ़ूरी किई, तै लोल़ी हाम्हैं बी आप्पू मांझ़ै झ़ूरी किई। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />परमेशर निं कधू कोही भाल़अ, पर ज़ै हाम्हैं आप्पू मांझ़ै झ़ूरी डाहे, परमेशर बस्सा हाम्हां दी अर तै हआ तेऊए झ़ूरी हाम्हां दी पाक्‍की।<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />एता करै लागा हाम्हां का थोघ कि हाम्हैं बस्सा तेऊ दी अर सह बस्सा हाम्हां दी। किल्हैकि तेऊ आसा हाम्हां लै आपणीं आत्मां दैनी दी। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />हाम्हैं हेरअ पूत भाल़ी अर हाम्हैं दैआ तेऊए शाजत कि बाब छ़ाडअ आपणअ पूत संसारा लै उद्धार दैणें तैणीं। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />ज़ुंण बी इहअ मना कि ईशू आसा परमेशरो पूत, परमेशर रहा तेऊ दी बस्सी अर सह बस्सा परमेशरा दी। <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />ज़ुंण झ़ूरी परमेशर हाम्हां संघै करा, सह झ़ूरी हेरी हाम्हैं बछ़ैणीं अर हाम्हैं करा तेऊ परमेशरा दी विश्वास। परमेशर आसा झ़ूरी।</para>
  <para style="p" vid="1JN 4:16">ज़हा दी झ़ूरी बस्सा, सह बस्सा परमेशरा दी अर परमेशर बस्सा तेऊ दी। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />एता ई करै हुई झ़ूरी हाम्हां दी पाक्‍की कि नसाफ हणें धैल़ी हणअ हाम्हां निहंचअ कि हाम्हां निं सज़ा भेटणीं। किल्हैकि ज़िहअ मसीहा ईशू संसारै रहंदी परमेशरा दी बस्सा त तिहै ई बस्सा हाम्हैं बी परमेशरा दी। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />हाम्हां निं डरने ज़रुरत आथी किल्हैकि हाम्हैं डाहा परमेशरा संघै असली दी झ़ूरी, ज़ुंण परमेशरा संघै झ़ूरी डाहा तिन्‍नां निं तेऊ का डरने ज़रुरत आथी। किल्हैकि डरा करै हआ कष्ट अर ज़ुंण डरा सह निं झ़ूरी दी पाक्‍कअ हंदअ।<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />हाम्हैं करा तै एकी-दुजै संघै झ़ूरी कि पैहलै किई परमेशरै हाम्हां संघै झ़ूरी। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ज़ै कुंण इहअ बोले कि हुंह करा परमेशरा संघै झ़ूरी अर आपणैं साथी-भाई संघै करे सह ज़ीद, तै आसा सह झ़ुठअ। किल्हैकि ज़ुंण आपणैं साथी-भाई संघै ज़ुंण तेऊ भाल़अ द आसा तेऊ संघै झ़ूरी नांईं करदअ, तै निं सह तेऊ परमेशरा संघै बी झ़ूरी करी सकदअ ज़ुंण तेऊ कधू भाल़अ बी निं आथी। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />प्रभू ईशू का आसा हाम्हां अह हुकम भेटअ द कि ज़ुंण बी परमेशरा संघै झ़ूरी डाहा, तेऊ लागा आपणैं साथी-भाई संघै बी झ़ूरी करनी।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">संसारै ज़ीत पाणीं</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />ज़सरअ इहअ विश्वास आसा कि ईशू आसा मसीहा, सह आसा परमेशरो पूत। ज़ुंण बी बाब संघै झ़ूरी करा सह करा तेऊए सोभी शोहरू संघै बी झ़ूरी। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />ज़ै असली दी हाम्हैं परमेशरा संघै झ़ूरी करा अर तेऊओ हुकम मना, एता ई करै लागा हाम्हां का थोघ कि हाम्हैं करा परमेशरे सोभी लान्हैं संघै झ़ूरी। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />म्हारी परमेशरा संघै झ़ूरी आसा अह कि हाम्हैं मना तेऊओ ई हुकम अर तेऊओ हुकम निं हाम्हां लै कठण आथी।<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 11:30">मोत्त. 11:30</ref></char></note><verse eid="1JN 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 5:4" />ज़ुंण बी परमेशरे लुआद आसा, तिंयां निं संसारे होरी लोगा ज़िहै काम करदै। हाम्हैं ज़िता तिन्‍नां सोभी गल्‍ला का ज़ुंण परमेशरे खलाफ काम करा। हाम्हैं निं संसारे बूरी गल्‍ले बशै पल़दै किल्हैकि म्हारअ विश्वास आसा मसीहा दी। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />संसारै ज़ुंण परमेशरे खलाफ आसा तेता का कुंण मणछ सका ज़िती? सह हरेक मणछ सका तेता का ज़िती ज़ुंण इहअ विश्वास करा कि ईशू मसीहा ई आसा परमेशरो पूत।<verse eid="1JN 5:5" /></para>
  <para style="s">प्रभू ईशू मसीहे बारै शाजत</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ईशू मसीहे बारै करा खैल। अह ई आसा सह ज़ुंण परमेशरै पृथूई लै छ़ाडअ। परमेशरै रहैऊई तधू ईंयां गल्‍ला ज़धू ईशू लै पाणीं दी डुबकी दैनी अर ज़धू ईशू आपणैं लोहू बहाऊई करै प्राण दैनै। पबित्र आत्मां करै गअ इना गल्‍लो सत्त प्रगट हई कि ईशू मसीहा आसा परमेशरै छ़ाडअ द। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />इना गल्‍ला खोज़णैं आल़ै आसा चअन कि मसीहा आअ परमेशरा बाखा का आअ द। <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />पबित्र आत्मां, पाणीं दी डुबकी अर क्रूसा दी बहाऊअ द लोहू। ईंयां चिहै खोज़ा एक्‍कै गल्‍ल। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />हाम्हैं करा होरी मणछै खोज़ी दी गल्‍लो विश्वास। पर हाम्हैं सका परमेशरे गल्‍लो होर बी खास्सअ विश्वास करी। परमेशरै आसा आप्पै आपणैं पूते बारै शाजत दैनी दी। <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />ज़ुंण परमेशरे पूता दी विश्वास करा, सह करा ऐहा गल्‍ला दी विश्वास कि ज़ुंण परमेशरै बोलअ तिंयां गल्‍ला आसा शुची। ज़ुंणी परमेशरो विश्वास ई नांईं किअ, सह करा परमेशरा झ़ुठै, किल्हैकि तेऊ निं तैहा शाजत दी विश्वास किअ ज़ुंण परमेशरै आपणैं पूते बारै दैनी।<verse eid="1JN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11" />होर आसा सह शाजत एही कि परमेशरै आसा हाम्हां लै सदा रहणैं आल़ी ज़िन्दगी दैनी दी अर सह ज़िन्दगी आसा हाम्हां तेऊए पूता करै भेटी दी। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ज़हा दी परमेशरो पूत बस्सा तेऊ का आसा सदा रहणैं आल़ी ज़िन्दगी अर ज़हा दी परमेशरो पूत नांईं बस्सदअ, तेऊ का निं सह ज़िन्दगी बी आथी।<verse eid="1JN 5:12" /></para>
  <para style="s">सदा रहणैं आल़ी ज़िन्दगी</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />हुंह लिखा ऐहा च़िठी तम्हां लै एते तैणीं कि ज़ुंण तम्हैं परमेशरे पूता दी विश्वास करा, तम्हां का लोल़ी इहअ थोघ लागअ कि सदा रहणैं आल़ी ज़िन्दगी तम्हां लै।<verse eid="1JN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14" />होर, हाम्हां आसा परमेशरा सम्हनै इहअ निहंचअ कि, ज़ै हाम्हैं प्रभूए मरज़ी दी मांगे तै शूणां सह म्हारी। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ज़ै हाम्हां का इहअ थोघ आसा कि ज़ुंण हाम्हैं मांगा, तेता हेरा परमेशर शूणीं तै आसा हाम्हां का इहअ बी थोघ कि ज़ुंण हाम्हैं मांगअ सह हेरअ हाम्हां लै तेऊ दैई बी।<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ज़ै कुंण आपणैं साथी-भाई इहअ पाप करदै भाल़े, ज़ेते सज़ा मौत नां होए, तेता लै करै प्राथणां। तेता लै दैणीं परमेशरा तिन्‍नां मणछा लै ज़िन्दगी ज़ेते सज़ा मौत निं आथी। एक पाप आसा इहअ बी ज़ेते सज़ा मौत हआ तेता लै प्राथणां करना लै निं हुंह आथी लागअ द बोल्दअ। <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />सोभी रंगे बूराई आसा पाप, पर एक पाप हआ इहअ बी ज़ेते सज़ा मौत निं हंदी।<verse eid="1JN 5:17" /></para>
  <para style="s">नचोल़</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />हाम्हां का आसा ऐहा गल्‍लो थोघ कि ज़ुंण मणछ परमेशरा का आसा पैईदा हुअ द सह निं पाप करदअ अर तेऊ डाहा परमेशर बच़ाऊई अर तेऊ निं सकदअ सह कदुष्ट राख्स छ़ुंहीं बी।<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />हाम्हां का इहअ बी आसा थोघ कि हाम्हैं आसा परमेशरा का, अर सारअ संसार आसा तेऊ कदुष्ट राख्से बशै पल़अ द।<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />हाम्हां का इहअ बी आसा थोघ कि परमेशरो पूत मसीहा आसा एछी गअ द अर तेऊ आसा दैनी दी हाम्हां लै समझ़ कि हाम्हैं तेऊ शुचै परमेशरा बछ़ैणीं सके अर हाम्हैं तेऊ दी बस्से ज़ुंण शुचअ आसा, मतलब प्रभू ईशू मसीहा दी, शुचअ परमेशर अर सदा रहणैं आल़ी ज़िन्दगी आसा अह ई।<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ए लान्हैंओ, एही मुहुर्ती का रहै दूर ज़ुंण थारै दिलै परमेशरे ज़ैगा बेशा।<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>