  <para style="h">याकब</para>
  <para style="toc1">याकबै लिखी दी च़िठी</para>
  <para style="toc2">याकब</para>
  <para style="toc3">याक.</para>
  <para style="mt1">याकब</para>
  <para style="mt2">याकबै लिखी दी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: याकब</para>
  <para style="ili">पहल़णैं आल़ै: ईशू दी विश्वास करनै आल़ै यहूदी</para>
  <para style="ili">सन: 45-48</para>
  <para style="ip">याकबे च़िठी आसा बभारा दी ज्ञैने एक गांठल़ी ज़ुंण सारै संसारै छिंघुई करै रहणैं आल़ै परमेशरे लोगा लै आसा लिखै दै। लिखणैं आल़अ करा मसीही बभार अर च़ाल-च़लणा लै ज्ञैन अर असली गल्‍ला समझ़णें बारै सलाह खोज़णा लै ज़िऊंदी च़िज़े कथ्या खोज़ी करै समझ़ाऊई। सह करा हरेक गल्‍ला दी मसीहा दी रही बच़ार, ज़िहअ कि सेठ अर गरीबी, परिक्षा, शोभलअ च़ाल-च़लण, भेदभाब, विश्वास अर कर्म, ज़िभे बोल, समझ़कार हणअ, लल़ाई-झ़गल़ै, घमंड अर मानदारी, दुजै लै दोश लाणअ, डिंगा मारनी, सबर करनअ अर प्राथणां करनी।</para>
  <para style="ip">अह च़िठी खोज़ा मसीही ज़िन्दगी ज़िऊंणै अर विश्वासा संघै कर्म करनअ बी केतरअ ज़रूरी आसा:</para>
  <para style="imq">“तम्हैं निं सिधै परमेशरै बैण शुणनै आल़ै रहा, पर तेऊ साबै ज़िऊआ आपणीं ज़िन्दगी बी। नांईं ता तम्हैं आसा आप्पू लै धोखै दैंदै लागै दै कि परमेशरा हेरनै तम्हैं बच़ाऊई।”</para>
  <para style="ipr">(1:22)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1:1</para>
  <para style="io1">विश्वास अर समझ़कार हणअ 1:2-8</para>
  <para style="io1">गरीबी अर ज़ैदात 1:9-11</para>
  <para style="io1">परख अर मांण 1:12-18</para>
  <para style="io1">शुणनअ अर करनअ 1:19-27</para>
  <para style="io1">भेदभाब करनअ हआ पाप 2:1-13</para>
  <para style="io1">विश्वास अर कर्म 2:14-26</para>
  <para style="io1">विश्वासी अर तेऊए ज़िभ 3:1-18</para>
  <para style="io1">मसीही अर संसार 4:1—5:6</para>
  <para style="io1">हरेकी रंगे सलाह 5:7-20</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />अह च़िठी आसा याकबा बाखा ज़ुंण परमेशर अर प्रभू ईशू मसीहो दास आसा,</para>
  <para style="p" vid="JAS 1:1">हुंह लिखा ऐहा च़िठी तिन्‍नां मसीहा ईशू दी विश्वास करनै आल़ै यहूदी “बारा गोत्रा” लै ज़ुंण सारै संसारै छिंघुई करै रहा,</para>
  <para style="p" vid="JAS 1:1">तम्हां सोभी लै मेरी लै राज्ज़ी-खुशी।<verse eid="JAS 1:1" /></para>
  <para style="s">विश्वास अर समझ़कार हणअ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />हे मेरै भाई-बैहणीओ, ज़ेभै तम्हैं कई रंगे मसीबता दी पल़ा, एता समझ़ा खुशीए गल्‍ल। <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />किल्हैकि तम्हां का आसा थोघ कि ज़ेभै थारै विश्वासा परखा, तेता करै बझ़ा तम्हां दी सबर।<verse eid="JAS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 1:4" />हर गल्‍ला दी शिखल़ा सबर करनअ ताकि तम्हैं आत्मां दी पाक्‍कै अर नर्दोश हई थारै च़ाल-च़लणा दी किछ़ू गल्‍ले काम्मी नां रहे।<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />पर ज़ै तम्हां मांझ़ै कहा का अक्लीए काम्मी होए, तेता मांगा परमेशरा का, सह निं तम्हां लै रोश्श करदअ कि तम्हैं किल्है मांगअ पर सह दैआ सोभी लै खुशी-खुशी।<verse eid="JAS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JAS 1:6" />पर मांगा विश्वास डाही करै तेता लै निं बैहम करी किल्हैकि बैहम करनै आल़अ हआ धारा प्रैंदै लागी दी कैली ज़िहअ ज़ुंण बागरी करै ओर्ही-पोर्ही रहा ढुल़दी लागी। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />इहअ मणछ निं इहअ समझ़ी कि मुंह प्रभू का किज़ै भेटे। <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />किल्हैकि सह मणछ आसा दोगल़अ अर सह निं आपणीं कोही गल्‍ला दी टेक्‍की रहंदअ।<verse eid="JAS 1:8" /></para>
  <para style="s">सेठ अर गरीब</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />ज़ुंण विश्वासी भाई गरीब आसा तिंयां रहै खुश। परमेशर करा तिन्‍नों अदर। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />ज़ुंण विश्वासी सेठ आसा तिंयां बी रहै खुश किल्हैकि परमेशरै निं तम्हैं घमंडी डाहै। संसारे सेठ मणछे ज़िन्दगी हणीं घाहे फूला ज़ेही खतम। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />किल्हैकि सुरज़ा निखल़णैं का बाद पल़ा चटाक धुप्पअ अर घाहा दैआ सह शकेऊई, अर तेतो फूल अल़ा धरनीं, संघा तेते शोभा बी हआ खतम। ठीक इहै ई हणैं सेठ बी ढब्बै खटदी-खटदी खतम।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="PSA 102:11">भज. 102:11</ref>; <ref loc="ISA 40:7-8">ईशा. 40:7-8</ref></char></note><verse eid="JAS 1:11" /></para>
  <para style="s">परख अर मांण</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />परमेशर दैआ तेऊ मणछा लै बर्गत ज़ुंण खरी दी पाक्‍कअ रहा, किल्हैकि तेऊ भेटणअ पाक्‍कै रही सदा रहणैं आल़ी ज़िन्दगीओ सह मुगट, ज़ेते करार परमेशरै तिन्‍नां लै आसा किई दी ज़ुंण तेऊ संघै झ़ूरी डाहा। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />ज़ेभै कुंण परखा दी पल़े, सह निं इहअ बोली, “परमेशर आसा मुंह परखदअ लागअ द।” किल्हैकि नां कुंण बूरी गल्‍ला करै परमेशरा परखी सकदअ, अर नां सह आप्पू कहा परखदअ आथी।<verse eid="JAS 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 1:14" />अह आसा म्हारी आपणीं सोठ ज़ुंण हाम्हां का बूरै काम कराऊआ। ज़ेभै हाम्हां पाप करने सोर फिरा, सह पाआ हाम्हां कबाता। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />तेखअ करा तिन्‍नें बूरी सोठ पाप करना लै मज़बूर, अह सोठ रहा तिन्‍नें मन्‍नें तेभै तैणीं पल़ी ज़ेभै तैणीं तिंयां बरैबाद नां होए। तेखअ ज़ांऊं बूरी च़ाहा कठा हआ, तेता का हआ पाप पैईदा। ज़ांऊं पाप खास्सअ हआ, तेतो फल भेटा संसारे देही अर आत्मां दुहीए मौत। मतलब कि एक पापी हआ परमेशरा का सदा लै दूर।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />मेरै पैरै बैहण-भाईओ, धोखै दी निं रही। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />किल्हैकि हरेक शोभलअ बरदान अर हरेक शुचअ दान एछा म्हारै बाब परमेशरा का ज़ुंणी सरगे सोभै प्रैश्शै दैणैं आल़ै तारै बणाऐं। सह निं बदल़दअ अर नां फेर फिरी करै छ़ैल्‍ली ज़िहअ एछदअ डेऊंदअ रहंदअ। परमेशर आसा हर बगत भलअ। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />तेऊ दैनी आपणीं मरज़ी दी हाम्हां लै आपणैं शुचै बैणा करै ज़िन्दगी, ताकि हाम्हैं तेऊ बणाईं दी सोभी च़िज़ा मांझ़ै खास होए।<verse eid="JAS 1:18" /></para>
  <para style="s">शुणनअ अर करनअ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />मेरै पैरै भाईओ, ऐहा गल्‍लो आसा तम्हां का थोघ, तैही रहै हरेक मणछ शुणना लै आजू अर बोल़णा लै पिछ़ू अर धखी का निं रोश्शै आणनीं। <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />किल्हैकि ज़ेभै मणछ रोश्श करा सह निं तेऊ धर्मां पूरै करदअ ज़ुंण परमेशर च़ाहा। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />तैही करा मन्‍नें बूरै सभाब, ज़ीद-मिश अर घमंड दूर करी मना परमेशरो बैण, ज़ुंण थारै दिला दी आसा बऊअ द अर ज़ुंण थारी आत्मां लै उद्धार दैई सका।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />तम्हैं निं सिधै परमेशरै बैण शुणनै आल़ै रहा, पर तेऊ साबै ज़िऊआ आपणीं ज़िन्दगी बी। नांईं ता तम्हैं आसा आप्पू लै धोखै दैंदै लागै दै कि परमेशरा हेरनै तम्हैं बच़ाऊई। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />किल्हैकि ज़ुंण बी परमेशरे बैणा शुणनै आल़अ आसा, अर तेऊ साबै काम नांईं करदअ, सह आसा तेऊ मणछा ज़िहअ ज़ुंण आपणअ मुंह आर्शू दी भाल़ा <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />अर आपणअ मुंह भाल़ी लागा सह हांढदअ तेतरी जाआ सह तेभी बिस्सरुई कि सह किहअ त। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पर ज़ुंण मणछ परमेशरे तेऊ बधाना दी धैन दैए ज़ुंण सोभी आज़ाद करा अर ज़िहअ परमेशरो सह बधान बोला तिहअ ई करदअ रहे अर ज़ुंण बैण तेऊ शूणअ तेता आद डाहे, एता लै भेटणीं तेऊ परमेशरा का बर्गत।<verse eid="JAS 1:25" /></para>
  <para style="s">परमेशरे शुची च़ाकरी</para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />ज़ै कुंण आप्पू लै धर्मीं भगत बोला, अर आपणीं ज़िभा बशै निं डाहे, सह दैआ आप्पू लै धोखअ अर तेऊए च़ाकरी निं किछ़ू कामें आथी।<note caller="-" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="PSA 34:13">भज. 34:13</ref>; <ref loc="PSA 141:3">141:3</ref></char></note><verse eid="JAS 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JAS 1:27" />म्हारै बाब परमेशरा का शुझिआ धर्म इहअ कि छ़ुटै-मुक्‍कै दै अर बिधबा बेटल़ीए करनी तिन्‍नें खरी-अऊखी मज़त। आप्पू रहै संसारे हर पाप करनै का दूर रही नर्दोश।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">भेदभाब करनअ हआ पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />हे मेरै भाई-बैहणीओ, तम्हैं करा प्रतप्पा आल़ै प्रभू ईशू मसीहा दी विश्वास तै निं थारै मन्‍नैं होरी लै पक्षपात लोल़ी हुअ।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="JOB 34:19">आयू. 34:19</ref>; <ref loc="PSA 24:7-10">भज. 24:7-10</ref></char></note><verse eid="JAS 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 2:2" />थारी सभा दी ज़ै कुंण मणछ सुन्‍नें मुंदल़ी बान्हीं अर नऊंऐं झिकल़ै बान्हीं दी एछे अर कुंण गरीब मणछ बी पराणैं झिकल़ै बान्हीं थारी सभा दी एछे, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />अर तम्हैं बोले तेऊ नऊंऐं झिकल़ै आल़ै लै खास्सअ अदर करी, “तूह बेश इधी राम्बल़ी ज़ैगा अर तेऊ गरीबा लै बोले इहअ कि तूह रह इधी खल़्हुई, या इधी बेश बोरी प्रैंदै।” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />तै इहअ करै कै तम्हैं आप्पू मांझ़ै भेदभाब निं किअ? कि तम्हैं बूरी सोठ डाही नसाफ करनै आल़ै निं हुऐ?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />मेरै पैरै भाईओ, शूणां परमेशरै कै एऊ संसारे गरीब निं छ़ांटै कि तिंयां बी विश्वासा दी सेठ बणें? अर तिंयां बी स्वर्ग राज़े हकदार होए ज़ेता दैणें करार प्रभू तिन्‍नां लै आसा किई दी ज़ुंण तेऊ संघै झ़ूरी करा? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />पर तम्हैं किई तेऊ गरीबे बेइज़ती, ईंयां सेठ लोग कै तम्हां लै उपद्रभ निं करदै? तिंयां ई निंयां ज़ोरा-ज़ोरी दालता लै घिशी तल़िंगी ताकि तम्हां सज़ा होए? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />तिंयां कै तेऊ प्रभू ईशूए महान नाओंए निंदा निं करदै ज़सरै तम्हैं आसा?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />तैबी ज़ै तूह पबित्र शास्त्रे साबै तेऊ राज़ बधाना पूरअ करे, “तूह कर आपणैं साथी-संघी संघै एही झ़ूरी ज़िहअ तूह आप्पू लै झ़ूरा।” ज़ै तूह बधाने एऊ बैणा इहअ मना तै करा तूह ठीक।<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेब. 19:18</ref></char></note><verse eid="JAS 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 2:9" />पर ज़ै तम्हैं भेदभाब करे, तै करा तम्हैं पाप, अर बधाने साबै बी आसा तम्हैं दोशी।<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लेब. 19:15</ref></char></note><verse eid="JAS 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10" />किल्हैकि, ज़ै तम्हैं बधाने सोभी गल्‍ला मने बी पर कहा एकी गल्‍ला दी गलती करे, तै आसा सह बधाने साबै सोभी गल्‍ला दी दोशी। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />तैही ज़ुंणी इहअ बोलअ, “तूह निं कंज़री गल्‍ला करी,” अर तेऊ ई बोलअ इहअ बी, “तूह निं हत्या करी।” एते तैणीं कि तूह निं किधी कंझ़रूअ आथी पर हत्या किई, तैबी हुअ तूह बधाने साबै दोशी।<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">लुआ. 20:13-14</ref></char></note><verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />तम्हैं करा तिन्‍नां मणछा ज़ेही झींण करी गल्‍ला अर काम, ज़सरअ नसाफ आज़ादी दैणैं आल़ै बधाना करै हणअ। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />होरी माफ करनै आल़ै निं परमेशरा बी माफ करनै। पर परमेशर आसा झणैल़ू! सह करा म्हारअ नसाफ, तेता का ज़ादअ करा सह हाम्हां माफ!<verse eid="JAS 2:13" /></para>
  <para style="s">विश्वास अर कर्म</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />हे मेरै भाई-बैहणीओ, ज़ै कुंण इहअ बोला कि मुंह आसा मसीहा दी विश्वास पर होरी लै भलै काम निं करदअ, तेतो निं किछ़ै फाईदअ! इहअ विश्वास निं कधि उद्धार करी सकदअ। <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />ज़ै कुंण विश्वासी भाई या बैहण नांगै बल़िंगै होए, अर तिन्‍नां का बैल़ी-क्लारी खाणां लै नांईं होए, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />अर तम्हां मांझ़ै कुंण इहअ बोले कि शांती दी डेओआ, अर नैत्तै-तात्तै रहा अर रज्ज़ी खाआ-पिआ! पर ज़ुंण च़िज़ा देही लै ज़रूरी आसा अर तिन्‍नां नांईं दैए, तै किज़ै फाईदअ हुअ?<verse eid="JAS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 2:17" />तिहअ ई ज़ै विश्वास करनै आल़अ भलै काम नांईं करदअ ता, तै आसा तेऊओ विश्वास मूंअ द।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />कई सका इहअ बोली, “तूह करा विश्वास, पर हुंह करा तेते साबै भलै काम।” पर हुंह बोला तम्हां लै इहअ, “तम्हैं आपणअ विश्वास किहअ करै सका रहैऊई ज़ै कि तम्हैं भलै काम; करदै निं? पर मुंह रहैऊंणअ तम्हां का भलै काम करी आपणअ विश्वास।”<verse eid="JAS 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 2:19" />ज़ै थारअ इहअ विश्वास आसा कि परमेशर आसा एक्‍कै ई, ठीक बोलअ तम्हैं! भूत बी करा विश्वास अर तिन्‍नां बी लागा परमेशरे डरै काम्मणीं। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />पर ओ ऐडै मणछा, ताखा कै इहअ बी थोघै निं आथी कि भलै काम किऐ बाझ़ी आसा विश्वास बृथा?<verse eid="JAS 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JAS 2:21" />ज़धू म्हारै दाद-बाब आबरामै आपणअ शोहरू इसहाक बेदी दी बल़ी करना लै डाहअ, सह कै तेऊ भलै काम करी निं बणअ धर्मीं?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:9">मूल. 22:9</ref></char></note><verse eid="JAS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 2:22" />तंऐं हेरअ भाल़ी कि तेऊ किअ विश्वास अर तेऊ ई साबै भलै काम बी किअ अर भलै काम करी हुअ तेऊओ विश्वास पाक्‍कअ। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />पबित्र शास्त्रो अह बैण हुअ पूरअ, “आबरामै किअ परमेशरा दी विश्वास अर तेऊ शूणअ तिहअ ज़िहअ तेऊ बोलअ अर अह गणअ तेऊ लै धर्म इधी तैणीं कि तेऊ लै बोलअ परमेशरो साथी।”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">मूल. 15:6</ref></char></note> <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />तै हेरी तम्हैं अह गल्‍ल भाल़ी कि मणछ निं सिधअ विश्वास करी धर्मीं हंदअ पर तेऊ लागा भलै काम बी करनै।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />एही ई राहाब कंज़री बी, ज़धू तैहा गुप्त दूता लै आपणैं घअरै आसरअ दैनअ अर कहा होरी बाता बाती काढै तिंयां बागै, तेसे तेऊ भलै कामां करनै करै मनी सह धर्मीं।<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">इब्रा. 11:31</ref></char></note><verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />ज़ेही देही शाह बाझ़ी मूंईं दी आसा, तिहअ ई आसा विश्वास बी भलै कामां बाझ़ी मूंअ द।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">आपणीं ज़िभ बशै करनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />हे मेरै भाई-बैहणीओ, टोली दी निं तम्हैं सोभै गूरू हआ, किल्हैकि तम्हां का आसा थोघ बी कि हाम्हैं गूरू हणैं होर बी खास्सै दोशी। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />हाम्हैं सोभ करा कई बारी च़ूक, ज़ुंण आपणीं ज़िभा बशै करा, सह ई आसा सिध्द मणछ अर सह सका आपणीं सारी देही बशै करी।<verse eid="JAS 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3" />एकी बडै घोल़ै सका हाम्हैं तेऊए नाका दी होछ़ी ज़ेही नकेल लाई करै आपणैं बशै करी। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />एही ता हआ ज़हाज़ बडी ढिश-बागरी करै च़लाऊअ द तैबी बदल़ा ज़हाज़ो दलपति तेऊ एकी होछ़ी ज़ेही पतबारा करै च़ऊ बाखा।<verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />तेही ई आसा ज़िभ एक होछ़अ ज़िहअ आंग पर अह मारा बडी-बडी डिंगा। ज़िहअ धख ज़िहै आगीए लुपल़ै करै शाचा सारै बणैं आग अर सह हआ बरैबाद। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />ज़िभ बी आसा आगी ज़ेही, अह आसा म्हारी देहीए आंगा मांझ़ै सोभी का बूरी। अह लाआ म्हारी सारी देही दी कोहल़। अह सका म्हारी सारी ज़िन्दगी जम्परी का निखल़णैं आल़ी आगी करै बरैबाद करी।<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />सोभी रंगे बणें पशू, च़ेल्‍लू-पखीरू अर रिंगणै आल़ै ज़ीब, पाणीं दी हांढणै आल़ै सोभै ज़ीब सका मणछे बशै हई अर हुऐ बी। <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />पर ज़िभा निं कोहै मणछ बशै करी सकदअ, सह आसा एक एही लत्त ज़ुंण कधि निं थम्हदी, तेथ आसा इहअ बिश ज़ेता करै मौत हआ।<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 140:3">भज. 140:3</ref></char></note><verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />ऐहा ई ज़िभा करै करा हाम्हैं प्रभू अर बाब परमेशरे स्तोती, संघा दैआ ऐहा ई ज़िभा करै हाम्हैं तिन्‍नां मणछा लै फिटक ज़ुंण परमेशरे आपणैं रुपै आप्पू ज़िहै आसा बणाऐं दै! <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />एकी ई खाखा का निखल़ा शूकर अर फिटक दुहै! भाईओ, इहअ निं लोल़ी हुअ! <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />एकी सोबल़ा का मिठअ अर लूंणअ दुही रंगो पाणीं कै निखल़ी सका? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />हे मेरै भाई-बैहणीओ, कै फेडूए बूटा दी जैतून या दाखे लऊंणीं दी फेडू लागी सका? तिहअ ई निं लूंणी सोबल़ा का मिठअ पाणीं निखल़ी सकदअ।<verse eid="JAS 3:12" /></para>
  <para style="s">स्वर्गो ज्ञैन</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तम्हां मांझ़ै ज्ञैनी अर समझ़कार कुंण आसा? ज़ुंण इहअ होए सह करै आपणैं भलै कामां बाझ़ी घमंड किऐ अक्ल करै। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />पर ज़ै थारै दिल कल़बिश ज़ल़ण अर सिधै आपणैं मतलब काढणें सोठा करै आसा भरै दै, इना गल्‍लो घमंड करी निं सत्ता झ़ुठै बणाईं करै पाप। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />अह एही अक्ल निं परमेशरा बाखा आथी, अह आसा देही, संसारे अर राख्सा बाखा। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />ऐहा गल्‍ला डाहा आद कि ज़िधी ज़ल़ण अर सिधी आपणैं ई मतलब काढणें बारै सोठ हआ तिधी हआ सोभै उपद्रभ अर हर कदुष्ट काम।<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />पर ज़ुंण अक्ल उझै का परमेशर दैआ तेता करै शिखल़ा हाम्हैं पबित्र रहणअ, होरी संघै डाहणअ मेल़-ज़ोल़, सोभी लै झणैल़ू हणअ, मज़त करनी, ज़िम्मैंबारी समझ़णीं, कहा मणछा लै भेदभाब निं करनअ अर मानदार रहणअ। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />मेल़-ज़ोल़ करनै आल़ै लऊआ शांतीओ बेज़अ बऊई करै धर्में फसल।<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ISA 32:17">ईशा. 32:17</ref></char></note><verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">संसारा संघै साथ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />तम्हैं हआ आप्पू मांझ़ै झ़घल़दै-च़िखदै लागै दै। तम्हां थोघ बी आसा कि इहअ किल्है हआ? अह हआ तेता करै ज़ुंण थारै मन्‍नैं झाख आसा पल़अ द। तम्हैं च़ाहा इहअ सोठी बूरअ करनअ कि एता करै भेटणीं तम्हां खुशी। <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तम्हां आसा कई च़िज़ा डाहणेंओ च़ाअ पर तम्हां निं तिंयां भेटदी तिन्‍नां पाणें तैणीं करा तम्हैं दुजे हत्या बी। तम्हैं च़ाहा तिन्‍नां च़िज़ा ज़ुंण होरी का आसा। तम्हैं हआ एकी-दुजै संघै लल़दै-झ़घल़दै लागै दै किल्हैकि तम्हां निं तिंयां च़िज़ा भेटदी ज़ुंण होरी का आसा। तम्हां निं तै भेटदअ किल्हैकि तम्हैं निं परमेशरा का मांगदै। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />पर ज़ेभै तम्हैं परमेशरा का मांगा बी, तम्हां निं तैबी भेटदअ किल्हैकि थारै मांगणै पिछ़ू आसा थारी बूरी सोठ ताकि तम्हैं तेता आल-मस्ती दी छेभी सके।<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />ओ कंज़री बेटल़ी ज़िहै विश्वास घाती मणछो! तम्हां का इहअ थोघ बी निं आथी कि संसारे गल्‍ला संघै साथ डाहणीं आसा परमेशरा संघै ज़ीद करनी? ज़ुंण बी संसारे संगती डेऊणअ च़ाहा, सह हआ आप्पू ई परमेशरो दुशमण।<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="JHN 2:15-16">जोह. 2:15-16</ref></char></note><verse eid="JAS 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 4:5" />तम्हैं कै इहअ समझ़ा कि पबित्र शास्त्रा दी लिखी दी ईंयां गल्‍ला आसा बृथा? ज़ुंण इहअ बोला, “परमेशरे आत्मां बस्सा हाम्हां दी।” सह बी च़ाहा इहअ कि हाम्हैं सिधै तेऊ लै झ़ूरी करे ज़ेही एकी मर्धा एही ज़ल़ण हआ कि तेऊए बेटल़ी लोल़ी ती सिधी तेऊ संघै झ़ूरी किई? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />पर परमेशर आसा सर्वशक्तिमान अर सह दैआ हाम्हां लै जश ताकि हाम्हैं बूराई करने आल़ी च़ाहा ज़िहै पाप करनै का दूर रहे, तैही आसा पबित्र शास्त्रा दी लिखअ द,</para>
  <para style="q" vid="JAS 4:6">“परमेशर करा घमंडी मणछो बरोध</para>
  <para style="q" vid="JAS 4:6">पर ज़ुंण घमंड निं करदअ तेऊ लै करा झींण।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />तैही रहा परमेशरे डरा हेठै। राख्सो करा बरोध, तै ठुहर्नअ सह तम्हां सेटा का दूर। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />परमेशरा नेल़ एछा, तै एछणअ सह तम्हां नेल़ बी, ओ पापी मणछो, पाप करनअ छ़ाडा, ओ दोगल़ै लोगो, आपणैं दिल करा शुचै।<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ZEC 1:3">जक. 1:3</ref>; <ref loc="MAL 3:7">मला. 3:7</ref></char></note><verse eid="JAS 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 4:9" />तम्हैं किअ पाप, ऐबै हआ दुखी, शोग करा अर लेरा लाआ। थारी खुशी बधल़णीं शोगा दी अर थारअ नंद रहणअ बदल़णअ दुखा दी। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />तम्हैं प्रभू सम्हनै निं घमंड करी ताकि सह तम्हां खास बणाईं करै ठीक मोक्‍कै दी बढाओए।<verse eid="JAS 4:10" /></para>
  <para style="s">भाई लै दोश लाणअ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />भाईओ, एकी दुजे बदनामीं निं करा, ज़ुंण आपणैं भाईए बदनामीं करा, या आपणैं भाई लै दोश लाआ, सह करा बधाने बदनामीं, अर बधाना दी लाआ सह दोश, तै निं तूह परमेशरे बधाना मनणै आल़अ आथी अर तै हुअ तूह सिधअ बधानो बरोध करनै आल़अ। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />बधाना दैणैं आल़अ अर नसाफ करनै आल़अ आसा एक्‍कै परमेशर, बच़ाऊंणै अर बरैबाद करने शगती बी आसा तेऊ एकी का। तूह कुंण आसा? ज़ुंण होरी मणछो नसाफ करदअ फिरा?<verse eid="JAS 4:12" /></para>
  <para style="s">घमंडे खलाफ चतैनगी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />तम्हैं ज़ुंण इहअ बोला कि आझ़ या काल्‍ला काटणी हाम्हां कहा होरी नगरी डेऊई तिधी एक साल होर अर कोई बपार करी खटणै हाम्हां ढब्बै। <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />पर इहअ निं तम्हां का थोघै आथी किई काल्‍ला किज़ै हणअ? शूणीं, लआ, थारी ज़िन्दगी आसा थोल़ी ज़ेही, तम्हैं, भाफा ज़िहै आसा, ज़ुंण थोल़ी घल़ी, शुझिआ अर तेखअ लूका सह बागरी दी।<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">सैणीं. 27:1</ref></char></note><verse eid="JAS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JAS 4:15" />असली लोल़ी त तम्हैं एता लै इहअ बोलअ, “ज़ै प्रभू च़ाहे तै रहणैं हाम्हैं ज़िऊंदै अर अह काम बी हेरनअ हाम्हां करी।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पर ऐबै करा तम्हैं आपणीं काल्‍ला धैल़ीए बारै सेखी मारी करै घमंड, इहअ घमंड करनअ हआ पाप।<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />तैही ज़ुंण भलाई करनअ ज़ाणा अर तेता नांईं करदअ, तेऊ लै आसा अह पाप।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">सेठ लोगा लै चतैनगी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />ओ सेठ मणछो, तम्हैं बी लआ शूणीं, तम्हैं लाआ आपणीं आजू एछणैं आल़ी खरी लै लैल़ा। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />थारी ज़ैदात हणीं बरैबाद, अर थारै झिकल़ै लै लागणै ल्हऐ। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />थारै सुन्‍नैं-च़ंदी दी गई खई लागी अर तैहा खई खाणअ थारअ मास्स आगी ज़िहअ। अह ज़ैदात ज़ुंण तम्हैं कठा आसा किई दी एता दैणीं खिरी थारै खलाफ शाजत ज़ेभै परमेशरा नसाफ करनअ।<verse eid="JAS 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 5:4" />हेरा, ज़ुंणी मज़दूरै थारै खेचै लऊंणेओ काम किअ, तिन्‍नें मज़दूरी ज़ुंण तम्हैं धोखअ दैई खाई, सह लागी लैल़ा लांदी, अर तिन्‍नां लऊंणे आल़ेए लेरा पकारा गई स्वर्गे सैने प्रभू सेटा पुजी।<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14">बधा. 24:14</ref>,<ref loc="DEU 24:15">15</ref></char></note><verse eid="JAS 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 5:5" />तम्हैं रहै पृथूई दी आल-मस्ती दी लागी, अर तम्हैं हेरअ खास्सअ सुख भोग करी। आपणीं दिले च़ाहा पूरी करै आसा तम्हैं इहै मोट्टै हुऐ दै ज़िहै काटणा लै गाभू। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />तम्हैं पाअ धर्मीं दोशी बणाईं करै मारी ज़ुंणी थारअ किछ़ै निं बगाल़अ त।<verse eid="JAS 5:6" /></para>
  <para style="s">सबर करनअ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />भाईओ, प्रभू एछणैं तैणीं करा सबर, हेरा, कृषाण बी करा पृथूईए किम्मती फल़े आशा डाही करै पैहली अर खिरी हणैं आल़ी बरसाती तैणीं सबर।<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="DEU 11:14">बधा. 11:14</ref></char></note><verse eid="JAS 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 5:8" />इहअ ई करा तम्हैं बी सबर, अर आपणैं दिला करा मज़बूत, किल्हैकि प्रभू एछणें शुभ धैल़ी आसा नेल़। <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />भाईओ, एकी-दुजै लै निं दोश लाई नसाफ करदै निं फिरा, ताकि तम्हां लै बी कुंण दोश नां लाऐ, हेरा, ईशू आसा छ़ेक्‍कै एछणैं आल़अ अर तेऊ करनअ म्हारअ नसाफ तम्हैं समझ़ा इहअ कि सह आसा दुआरै खल़्हुअ द।<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />भाईओ, ज़ुंणी परमेशरे गूरै प्रभूए नाओंऐं गल्‍ला किई, तिन्‍नां समझ़ा दुख ज़िरनै अर सबर करना लै आपणअ आदर्श। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />हाम्हां का थोघ निं आसा कि परमेशर करा सबर करनै आल़ै मणछो अदर, तम्हैं आयूबे सबर करने बारै ता आसा शूणअ द, अर प्रभू बाखा ज़ुंण तेतो फल तेऊ भेटअ, तेतो बी आसा तम्हां का थोघ, ज़िहअ करै प्रभूए खास्सी झींण प्रगट हआ।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />पर हे मेरै भाई-बैहणीओ, सोभी का बडी गल्‍ल आसा अह कि ज़ेभै बाहिदअ करे तेभै निं झ़ुठै सोह खाई, नां स्वर्गै, नां पृथूईए, नां कोई बी च़िज़े। थारअ “हाँ” करनैओ मतलब लोल़ी “हाँ” हुअ अर थारी “नांह” करनैओ मतलब लोल़ी “नांह” हुअ। नांईं ता परमेशरा दैणीं तम्हां लै एकी धैल़ै सज़ा।<verse eid="JAS 5:12" /></para>
  <para style="s">प्राथणां करने शगती</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />ज़ै तम्हां मांझ़ै कोई दुखी होए, सह करै प्राथणां। ज़ै तम्हैं खुशी होए, प्रभूए स्तोती करना लै बोलै भज़न। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />ज़ै तम्हां मांझ़ै कुंण बमार होए, विश्वासीए टोली का विश्वासी टोलीए सैणैं शादै, अर तिन्‍नैं करनी प्रभूए नाओंऐं तिन्‍नां लै तेल मल़ी करै प्राथणां। <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />ज़ुंण प्राथणां तम्हैं परमेशरा सेटा विश्वास डाही करै करे तेता करै हेरनअ परमेशरा सह बमार मणछ तैहा बमारी का बच़ाऊई अर ज़ै तेऊ कोई पाप बी किऐ दै होए, तेते बी भेटणीं तेऊ लै माफी।<verse eid="JAS 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 5:16" />तैही मना तम्हैं आप्पू मांझ़ै एकी-दुजै सेटा आपणैं पाप, संघा करा एकी-दुजै लै परमेशरा सेटा प्राथणां, ज़िहअ करै तम्हैं भिई नरोगै होए। किल्हैकि धर्मीं मणछे प्राथणां करै सका सोभै गल्‍ला हई। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलियाह बी त हाम्हां ज़िहअ दुख-सुख भुगतणै आल़अ मणछ, अर तेऊ किई लेरा लाई-लाई प्राथणां कि सरगा का निं पाणीं निं लोल़ी हुअ, अर साढै चिई साला तैणीं निं भूमी दी सरग हुअ।<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 राज़. 17:1</ref></char></note><verse eid="JAS 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 5:18" />तेखअ किई तेऊ भिई प्राथणां, अर सरगा का हुअ पाणीं अर पृथूई हुई हरी भरी।<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 राज़. 18:42-45</ref></char></note><verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />हे मेरै भाई-बैहणीओ, ज़ै तम्हां मांझ़ै कुंण सत्ता का कबाता पेठे, अर तेऊ कुंण फरेऊई आणे, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />सह लऐ ऐहा गल्‍ला समझ़ी कि ज़ुंण बी कबाता पेठै दै पापी मणछा राम्बल़ी बाता फरेऊई आणे, सह बच़ाऊआ तेऊए प्राण मौता का, परमेशरा करनै तेऊए पाप माफ।<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">सैणीं. 10:12</ref></char></note><verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>