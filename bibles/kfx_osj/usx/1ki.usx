  <para style="h">1 राज़ै</para>
  <para style="toc1">राज़ै सुलैमानो दोहरअ मन्‍न, इज़राईल देश बांढुअ दूई बाखा लै</para>
  <para style="toc2">1 राज़ै</para>
  <para style="toc3">1 राज़.</para>
  <para style="mt1">1 राज़ै</para>
  <para style="mt2">राज़ै सुलैमानो दोहरअ मन्‍न अर इज़राईल देश बांढुअ दूई बाखा लै</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: खास थोघ निं आथी पर कोऐ बोला अह आसा जेरमयाह गूरै लिखी दी</para>
  <para style="ili">सन: 590 का 538 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">पैहलै राज़े ऐहा कताबा दी आसा शमूएले कताबा का आजूए गल्‍ला लिखी दी। शुरू दी थिई 1 राज़ै अर 2 राज़ै एक्‍कै कताब अर सह थिई खास्सी लाम्मी अर तैही बणाऐं तेते दूई भाग। अह कताब आसा राज़े कताबो पैहलअ भाग। अह कताब आसा तधू लिखी दी ज़धू एरुशलेम बिधातो पैहलअ भबन थिअ।</para>
  <para style="ip">ऐहा कताबा सका चिई हेस्सै दी बांडी:</para>
  <para style="ili1">दाबेदो शोहरू सुलैमान इज़राईल अर यहूदो राज़अ अर राज़ै दाबेदे मौत।</para>
  <para style="ili1">राज़ै सुलैमानो राज़ अर तेऊए काम खासकर एरुशलेम नगरी बिधाता लै भबन बणाणअं।</para>
  <para style="ili1">इज़राईल देश बांढुअ उतर अर दखण दूई हेस्सै दी अर ईसा आजी नहुई सदी दी इना दुही मुल्खै राज़ करनै आल़ै राज़ै।</para>
  <para style="ip">1 राज़ै ऐहा कताबा दी आसा कई मशूर गूर एलीशे बारै बी खोज़अ द ज़ुंणी उतरा बाखा मुल्खे कदुष्ट राज़ै अहाब अर राणीं जज़बेलो बरोध किअ। एलियाह दैनी परज़ा लै चतैनगी कि बिधाता छ़ाडी होरी देअ देबतै निं पूज़ी आथी। एलियाह च़ाहा त लोगा का ऐहा गल्‍ला समझ़ाऊंणअ कि एक बिधाता ई आसा शुचअ अर असली परमेशर अर तेऊ रहैऊअ बिधाता अर होरी लोगे बाल देअआ मांझ़ै मकाबलअ बी अर बिधाता निखल़अ असली अर शुचअ। एलियाह खोज़अ लोगा का इहअ:</para>
  <para style="ib" />
  <para style="imq">“तम्हां कधू तैणीं रहणअ दुही बाता? ज़ै परमेशर बिधाता आसा, तै पूज़ा तेऊ! ज़ै बाल देअ आसा परमेशर, तै पूज़ा तम्हैं तेऊ! बाल देअए गूर करै आपणैं देअआ सेटा अरज़ अर हुंह करूं बिधाता सेटा। तेखअ ज़ुंण सरगा का आग शोटी ज़बाब दैए सह ई हणअ असली परमेशर।”</para>
  <para style="ipr">(18:21,24)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">सुलैमानो राज़ 1:1—11:43</para>
  <para style="io1">इज़राईल बांढुअ दूई बाखा 12:1—16:34</para>
  <para style="io1">एलियाह अर अहाब 17:1—22:53</para>
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s">राज़अ दाबेद हुअ खास्सअ प्रोढअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />राज़अ दाबेद गअ त खास्सअ प्रोढअ हई, तेऊए दास डाहा तै तेऊ खास्सै नैत्तै झिकल़ै जैंदरी पर सह निं केही जाम्हदअ आथी त। <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />खिरी दैनी राज़ै दाबेदे कार-करिंदै तेऊ लै एही सलाह, “म्हारै मालक, हाम्हैं आणमै ताल्है एक कुंआरी शोहरी लोल़ी कि सह ताह संघै रही तेरी च़ाकरी करे। सह सुत्तणी तेरी काछ़ा ताकि ताल्है नैत्तअ होए।” <verse eid="1KI 1:2" /><verse number="3" style="v" sid="1KI 1:3" />तिंयां रहै इज़राईला दी सारै शोहरी लोल़ै लागी, खिरी भेटी तिन्‍नां शूनेम नगरी अबीशेग नाओंए एक कुंआरी शोहरी अर तिन्‍नैं आणी सह राज़ै दाबेदा सेटा। <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />सह शोहरी ती हेरनी सोभी का बित्ती, सह लागी तेखअ राज़ै दाबेदे च़ाकरी करदी। पर राज़अ दाबेद निं तैहा ज़ुआन शोहरी संघै सुत्ती बी जाम्हअ।<verse eid="1KI 1:4" /></para>
  <para style="p">
    <verse number="5-6" style="v" sid="1KI 1:5-6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5-6 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 3:4">2 शमू. 3:4</ref>
      </char>
    </note>अदोनियाह त राज़ै दाबेद अर हागीता का हुअ द शोहरू, सह थिअ अबशलोमा कान्हअ। ऐबै त दाबेदे शोहरू मांझ़ै सह ज़ेठअ। हेरनअ बी थिअ सह बेघै बित्तअ। राज़ै दाबेदै निं सह होछ़ी उझै नैरअ बी आथी त! तेऊ का निं सह कधू इहअ बी पुछ़दअ आथी त, “तंऐं इहअ किल्है किअ?” एकी धैल़ै लागअ सह करेर्हुई करै इहअ बोल्दअ, “ऐबै बणनअ मुंह राज़अ!” तेऊ आणै आप्पू लै रथ अर घोल़ै अर आप्पू आजू हांढणा लै पज़ाह सपाही। <verse eid="1KI 1:5-6" /><verse number="7" style="v" sid="1KI 1:7" />अदोनियाह डेऊअ सरूयाहे शोहरू जोआब अर अबतार प्रोहता सेटा कि राज़ै बणना लै तेऊओ साथ दैए। तिंयां दुहै हुऐ तेऊए साथ दैणा लै तैर। <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />पर सदोक प्रोहत, जहोयादो शोहरू बेनियाह, नातान गूर, शिमी, रेई अर दाबेदे फाज़त करनै आल़ै शूरबीरै निं अदोनियाहो साथ दैनअ।<verse eid="1KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9" />एकी धैल़ै किऐ अदोनियाह राज़ै अनरोगल़ कुहै नेल़ जेहलेत नाओंए टोल्हा सेटा हेल़्ही का छ़ांटी करै भेड़, बल्द अर धाचै दै बाछ़ू बल़ीदान। संघा शादै तेऊ आपणैं सोभ भाई अर यहूदा का दाबेदे सोभ कार-करिंदै धामा खांदै। <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />पर तेऊ निं आपणीं काकी माए शोहरू सुलैमान, नातान गूर, बेनियाह अर दाबेदे फाज़त करनै आल़ै शूरबीरा मांझ़ै कोही लै छ़ांदअ किअ।<verse eid="1KI 1:10" /></para>
  <para style="s">सुलैमान बणाअं राज़अ</para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11" />इहअ शूणीं डेऊअ नातान गूर सुलैमाने ईज बेतशेबा सेटा संघा लागअ पुछ़दअ, “ताखा बी लागअ थोघ कि हागीतो शोहरू अदोनियाह आसा गअ द ऐबै आप्पू ई राज़अ बणी? राज़ै दाबेदा का निं ऐहा गल्‍लो थोघ बी आथी!<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 शमू. 12:24</ref></char></note> <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />ज़ै तूह आपणीं अर आपणैं शोहरूए ज़िन्दगी बच़ाऊंणी च़ाहा, तै आसा ताल्है मेरी एही सलाह कि <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />तूह लअ एकी बारी राज़ै दाबेदा सेटा लै डेऊई संघा पुछ़ तेऊ, ‘मालक, तंऐं मुल्है इहै कऊंलै बच़न निं आथी दैनै दै कि ताह बणाणअं मेरअ शोहरू सुलैमान आप्पू बाद राज़अ? तेतो ऐबै कै हुअ? तै किल्है गअ अदोनियाह राज़अ बणी?’ <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />ज़ेतरी तूह राज़ै का इना गल्‍ला करदी हणीं लागी दी, तेतरी जाणअ तिधी हुंह पुजी संघा खोज़ूं आजू हुंह आप्पै कि हाँ इहअ ई हुअ।”<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />बेतशेबा डेऊई राज़े पांडा राज़ै दाबेदा भाल़ी। दाबेद त खास्सअ प्रोढअ गअ द हई, अर तेऊए च़ाकरी करा ती शूनेम नगरी का आणी दी सह कुंआरी शोहरी अबीशेग। <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />बेतशेबा टेक्‍कअ राज़ै दाबेदा सेटा माथअ अर राज़ै पुछ़ी सह, “ताह किज़ै लोल़ी?”<verse eid="1KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 1:17" />बेतशेबा दैनअ ज़बाब, “मेरै मालक, तंऐं आसा मुल्है बिधाते सोह खाई कऊंलै बच़न दैनै दै, ‘मुंह बाद बेशणअ मेरी राज़गाद्दी दी तेरअ शोहरू सुलैमान राज़अ।’ <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />मालक, पर ऐबै हेरअ अदोनियाह राज़अ बणाईं अर मेरै मालक! ताखा निं ऐहा गल्‍लो थोघ ई आथी! <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />माहा राज़अ, हेल़्ही का छ़ांटी करै हेरै तेऊ भेड़, बल्द अर धाचै दै बाछ़ू बल़ीदान करी! तेरअ सैनापति जोआब अर अबतार प्रोहत आसा धामा खांदै शादै दै, पर तेरअ शोहरू सुलैमान निं तेऊ शादअ! <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />मेरै मालक, सोभ इज़राईली आसा ऐबै ताह बाखा भाल़ै लागै दै कि तूह खोज़ आप्पै कि ताह बाद तेरी राज़गाद्दी दी राज़अ कुंण बेशणअ? <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />मेरै मालक, ज़ै तूह इहअ नांईं करे, तिंयां सका इहअ बोली कि सुलैमान अर मंऐं किअ द्रोह! तिन्‍नां न्हैल़णअ तूह मरदअ संघा पाणै हाम्हैं दुहै मारी!”<verse eid="1KI 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22" />बेतशेबा ती राज़ै दाबेदा संघा गल्‍ला करदी ई लागी दी कि तेतरी गअ नातान गूर राज़े मैहलै पुजी। <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />राज़ै का हेरअ कुंणी खोज़ी कि नातान गूर आअ। नातान डेऊअ कोहरअ राज़ै दाबेदा सेटा संघा किअ राज़ैओ अदर करना लै जान्हूंए बलै बेशी उटअ मूंड। <verse eid="1KI 1:23" /><verse number="24" style="v" sid="1KI 1:24" />तेखअ बोलअ नातान गूरै, “मेरै मालक, तंऐं इहअ हुकम हेरअ ज़ारी करी, ‘अदोनियाह हणअ मुंह बाद राज़अ अर मेरी गाद्दी दी बेशणअ सह?’ <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />आझ़ दोत्ती पै किऐ तेऊ खास्सै बल्द बल़ीदान अर धाचै दै बाछ़ू बी अर भेडा बल़ीदान। तेऊ आसा तेरै सोभी शोहरू, तेरै सैनापति अर अबतार प्रोहता लै छ़ांदअ किअ द। तिंयां आसा धामा खांदै अर एही ज़ै-ज़ैकार करदै लागै दै, ‘राज़अ अदोनियाह लोल़ी सदा ज़िऊंदअ रहअ।’ <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />पर माहा राज़अ, तेऊ नां हुंह तेरअ दास शादअ, नां सदोक प्रोहत, नां जहोयादो शोहरू बेनियाह अर नां तेरअ शोहरू सुलैमान शादअ! <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />मालक, इहअ करना लै कै तंऐं आप्पै दैनी ज़ाज़त? तंऐं निं हाम्हां का खोज़णें ज़रुरत बी समझ़ी! तंऐं हाम्हां का किल्है निं खोज़अ कि ताह बाद तेरी गाद्दी दी राज़अ कुंण बेशणअ?”<verse eid="1KI 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />राज़ै दाबेदै बोलअ, “बेतशेबा शादा भिई ओर्ही मुंह सेटा लै।” बेतशेबा आई संघा खल़्हुई राज़ै सेटा। <verse eid="1KI 1:28" /><verse number="29" style="v" sid="1KI 1:29" />तेखअ बोलअ राज़ै दाबेदै, “इज़राईले परमेशर बिधाता ज़ुंणीं हुंह आझ़ तैणीं राज्ज़ी-राम्बल़अ डाहअ, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />तेऊए नाओंऐं करा हुंह ताल्है दैनै दै तिन्‍नां कऊंलै बच़ना पूरै कि मुंह बाद बेशणअ तेरअ शोहरू सुलैमान मेरी गाद्दी दी राज़अ!”<verse eid="1KI 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 1:31" />बेतशेबा टेक्‍कअ राज़ै सेटा धरनीं उटअ पल़ी माथअ संघा बोलअ इहअ, “मेरअ मालक राज़अ दाबेद लोल़ी जुगै-जुगै तैणीं ज़िऊअ!”<verse eid="1KI 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32" />तेखअ बोलअ राज़ै दाबेदै, “सदोक प्रोहत, नातान गूर अर जहोयादे शोहरू बेनियाह शादा ओर्ही मुंह सेटा लै।” ज़ांऊं तिंयां राज़ै सेटा लै आऐ, <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />राज़ै बोलअ तिन्‍नां लै इहअ, “मेरै दरबारे कार-करिंदै निंयां आप्पू संघै अर मेरै शोहरू सुलैमाना निंयां मेरी खच़रा प्रैंदै बशैल़ी संघा डेओआ गीहोन कुहै सेटा। <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />तिधी करै नातान गूर अर सदोक प्रोहत तेऊओ अभिषेक संघा बोलै नर्शिंगै बाज़ी करै ज़ोरै-ज़ोरै, ‘इज़राईलो राज़अ सुलैमान लोल़ी जुगै-जुगै ज़िऊअ!’ <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />तेखअ आणै तेऊ तिधा का आप्पू संघै मेरै मैहला लै अर तेखअ बशैल़ै इधी मेरी गाद्दी प्रैंदै। सुलैमान ई छ़ांटअ मंऐं इज़राईल अर यहूदा मुल्खो राज़अ।”<verse eid="1KI 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36" />जहोयादे शोहरू बेनियाह बोलअ राज़ै लै, “मेरै मालक, हाम्हां करनअ ज़िहअ तंऐं बोलअ तिहअ ई, बिधाता बी लोल़ी त इहअ ई दैनअ हणैं। एवमस्तू <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />मेरै मालक, बिधाता रहअ सदा ताह संघै, हुंह करा तेऊ बिधाता का अरज़ कि सुलैमाना संघै बी लोल़ी सह तिहअ ई रहअ अर सह लोल़ी तेऊ ताखा बी महान राज़अ बणाअं।”<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />तेखअ डेऊऐ सदोक प्रोहत, नातान गूर अर जहोयादो शोहरू बेनियाह राज़ दरबारे सपाही संघा निंईं उंधै। तिन्‍नैं निंयं सुलैमान राज़ै दाबेदे खच़रा दी बशैल़ी गीहोन कुहै सेटा लै। <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />सदोक प्रोहतै निंईं बिधाते खिम्भा भितरी पबित्र ज़ैगा का तेलो शींग भरी संघा किअ सुलैमानो अभिषेक। तेखअ बाज़अ तिन्‍नैं नर्शिंगअ अर सोभी लोगै बोलअ ज़ोरै-ज़ोरै, “राज़अ सुलैमान लोल़ी जुगै-जुगै ज़िऊअ!” <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />तेखअ आऐ तिंयां सोभै सुलैमाना संघै बशूरी बाज़दी अर राज़े ज़ै-ज़ैकार करदी। तिन्‍नों हाल्‍लअ त इहअ कि ज़ाणनअ धरती दी हुई ज़ाज़री।<verse eid="1KI 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41" />अदोनियाह अर तेऊए सारै प्राहुणैं मुक्‍कै खाई-पिई अर तिन्‍नैं बी शूणअ ज़ोरै-ज़ोरै ज़ै-ज़ैकार करनैओ हाल्‍लअ। ज़ांऊं जोआबै नर्शिंगअ शूणअ, तेऊ बोलअ इहअ, “नगरी दी अह एतरअ हाल्‍लअ किज़ू पल़अ होए?” <verse eid="1KI 1:41" /><verse number="42" style="v" sid="1KI 1:42" />ज़ेतरी सह बोली निं मुक्‍कअ, तेतरी गअ अबतार प्रोहतो शोहरू जोनातान तिधी पुजी। अदोनियाह बोलअ तेऊ लै, “ओर्ही एछ छ़ेक्‍कै भितरा लै, तूह आसा भलअ मणछ अर तंऐं आणी हणीं किज़ै खुशीए खबर।”<verse eid="1KI 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 1:43" />जोनातानै बोलअ अदोनियाह लै, “ताल्है निं मुखा एही खबर आथी! एभै पै मुक्‍कअ म्हारअ राज़अ दाबेद सुलैमाना राज़अ बणाईं। <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />तेऊ छ़ाडै सदोक प्रोहत, नातान गूर अर जहोयादो शोहरू बेनियाह आपणैं राज़ दरबारे सपाही तेऊ संघै, तिन्‍नैं बशैल़अ सह राज़े खच़रा प्रैंदै, <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />सदोक प्रोहत अर नातान गूरै किअ तेऊओ गीहोन कुहै सेटा अभिषेक। तेखअ डेऊऐ तिंयां ज़ोरै-ज़ोरै ज़ै-ज़ैकार करदी नगरी लै फिरी अर नगरी आसा सोभ खुशी-खुशी नाच़दै-खेल्हदै लागै दै। अह आसा तेतो हाल्‍लअ ज़ुंण तम्हैं एभै शूणैं आसा लागै दै। <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />ऐबै डेऊणअ सुलैमान राज़े मैहला लै संघा बेशणअ राज़े गाद्दी दी। <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />होर हुअ इहअ कि, राज़े कार-करिंदै डेऊऐ आपणैं माहा राज़अ दाबेदा सेटा लै शूकर करदै तिन्‍नैं बोलअ इहअ, ‘बिधाता लोल़ी त सुलैमान ताखा बी महान राज़अ बणाअं।’ राज़ै दाबेदै टेक्‍कअ आपणैं च़ैन्‍नै ई बिधाता सेटा माथअ संघा बोलअ इहअ, <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />‘हे इज़राईले परमेशर बिधाता, तेरी लोल़ी सदा ज़ै-ज़ैकार हुई, तंऐं बशैल़अ मेरी राज़गाद्दी प्रैंदै मेरी ई लुआदा मांझ़ै मुंह बाद राज़अ अर तंऐं डाहअ हुंह ज़िऊंदअ कि हुंह इहअ हंदअ आपणीं आछी भाल़े!’”<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />तेखअ ज़ुंण तिधी अदोनियाह सेटा प्राहुणैं तै आऐ दै, तिन्‍नां छ़ुटअ डरै दर्छ़णअ, संघा लागै तिधा का आपणीं-आपणीं बाता हांढदै। <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />अदोनियाह बी पल़ी दिलै सुलैमाने डअर। सह डेऊअ बिधाते पबित्र ज़ैगा खिम्भा भितरी संघा डाहै बेदीए शींग ढाकी।<verse eid="1KI 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 1:51" />राज़ै सुलैमाना का हेरअ कुंणी खोज़ी कि अदोनियाह आसा तेऊ का इहअ खास्सअ डरअ द कि तेऊ आसा डाहै दै बेदीए शींग ढाकी, संघा बोला सह इहअ, “हुंह च़ाहा इहअ कि राज़अ सुलैमान काढे सोह कि तेऊ निं हुंह मारनअ आथी।” <verse eid="1KI 1:51" /><verse number="52" style="v" sid="1KI 1:52" />सुलैमानै बोलअ इहअ, ज़ै तेऊओ दिल शुचअ होए, तै निं हुंह तेऊए मुंडो एक शराल़ बी ज़ांऐं दैंदअ हणैं, पर ज़ै तेऊए दिलै खोट होए, तै निं हुंह तेऊ मारनै का छ़ाडी गअ। <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />राज़ै सुलैमानै छ़ाडै आदमी कि अदोनियाह आणा बेदी सेटा का ओर्ही काढी। राज़ै सुलैमाना सेटा पुजी टेक्‍कअ अदोनियाह धरनीं उटअ पल़ी माथअ, राज़ै सुलैमानै बोलअ तेऊ लै इहअ, “तूह लाग आपणैं घअरा लै डेऊंदअ।”<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s">दाबेदै डाही मरनै का आजी सुलैमाना का एही गल्‍ला खोज़ी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />ऐबै गअ त राज़ै दाबेदा मरनैओ बगत पुजी, तेऊ शादअ आपणअ शोहरू सुलैमान संघा डाही तेऊ का एही गल्‍ला खोज़ी, <verse eid="1KI 2:1" /><verse number="2" style="v" sid="1KI 2:2" />“ऐबै निं हुंह आजू खास्सअ ज़िऊंदअ आथी हुंह च़ाल्‍लअ तिधा लै डेऊई ज़िधा लै धरतीओ हर मणछ एकी धैल़ी डेऊणअ, तूह निं हैअ चोल़ी नां हिम्मत हारी। <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />तूह करै तिहअ ई ज़िहअ तेरअ परमेशर बिधाता ताल्है हुकम करा अर तेऊए बिधी निं बिस्सरी। मोसा गूरै लिखै दै बधाना दी ज़ेतरै हुकम आसा, तिन्‍नां मनै सोभी तिहै ई। ज़ै तूह इहअ करे, तै हणअ तूह हर ज़ैगा सफल च़ाऐ तूह ज़िधा लै बी डेओए। <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />ज़ै तूह ज़िहअ बिधाता बोला तिहअ ई करे, तै करनीं बिधाता सह करार पूरी ज़ुंण तेऊ मुल्है बोलअ त, ‘ज़ै तेरी आद-लुआद तेही ज़िन्दगी ज़िऊए ज़ेही हुंह च़ाहा, अर ज़ै तिंयां तत्त-दिला का मेरै हुकम मने, तै बेशणअ तिन्‍नां मांझ़ै एक ज़ण्हअ इज़राईला प्रैंदै सदा लै राज़अ।’<verse eid="1KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5" />“सुलैमान, एता बी निं बिस्सरी कि सरूयाहे शोहरू जोआबै मुल्है किज़ै आसा किअ द! तेऊ आसा भाल़ इज़राईले दूई सैनापति नेरीओ शोहरू अबनेर अर जतेरो शोहरू अमासा मारी पाऐ दै। ताखा आसा थोघ कि तेऊ मारै तिंयां इहै ज़िहअ कुंण जुधा लै दुशमणा मारा! तेऊ किई तिन्‍नां नर्दोश मणछे हत्या ज़ेभै जुध थिअ ई निं आथी। सह आसा दोशी ऐबै तेऊ लै सज़ा दैणें ज़िम्मैंबारी आसा तेरी।<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="2SA 3:27">2 शमू. 3:27</ref>; <ref loc="2SA 20:10">2 शमू. 20:10</ref></char></note> <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />तूह करै आपणीं अक्ल कि ताह किज़ै लागा करनअ, तेऊ निं तूह प्रोढी अमरा आपणीं मौता मरनै दैई।<verse eid="1KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 2:7" />“पर गलाद मुल्खे बर्ज़िले सोभी शोहरू लै झ़ूरनअ निं छ़ाडी, तिन्‍नें करै हेर-सभाल़। किल्हैकि ज़धू हुंह तेरै भाई अबशलोमे डरै राज़धानी छ़ाडी ठुर्हअ त, तधू झ़ूरै तै मेरी खरी लै तिंयां बी मुल्है इहै ई।<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2SA 17:27-29">2 शमू. 17:27-29</ref></char></note><verse eid="1KI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 2:8" />“होर आसा बिन्यामीन गोत्रा का गेरो शोहरू शिमी ज़ुंण बहूरीम नगरी रहा। राज़धानी का ठुर्ही ज़धू हुंह माहानीम नगरी लै डेऊअ, तधू ता थिअ सह मुल्है बेघै बूरै फिटक दैंदअ लागअ द, पर बादा का ज़ांऊं सह जरदण नदीए बाढै मुंह सेटा मिलदअ आअ, तेभै आसा मंऐं तेऊ लै ज़बान दैनी दी कि तेऊ निं हुंह मारदअ आथी। <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />पर तूह निं ऐबै तेऊ सज़ा दैणैं बाझ़ी छ़ाडी। ताखा आसा थोघ कि किज़ै करनअ अर तूह लऐ तेऊ ज़रूर मारी।”<verse eid="1KI 2:9" /></para>
  <para style="s">राज़ै दाबेदे मौत</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10" />खिरी मूंअ राज़अ दाबेद संघा डाहअ सह दाबेदपूर नगरी दाबी।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="2SA 5:4">2 शमू. 5:4</ref>,<ref loc="2SA 5:5">5</ref>; <ref loc="1CH 3:4">1 इति. 3:4</ref></char></note> <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />दाबेद रहअ इज़राईली प्रैंदै पठी च़ाल़्ही साला तैणीं राज़अ। साता साला किअ तेऊ हेब्रोन नगरी का राज़ अर तेत्ती साला किअ एरुशलेम नगरी का राज़। <verse eid="1KI 2:11" /><verse number="12" style="v" sid="1KI 2:12" />आजू बेठअ राज़ै दाबेदे ज़ैगा तेऊओ शोहरू सुलैमान तेऊए राज़गाद्दी दी राज़अ अर सह हुअ होर बी बलबान।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="1CH 29:23">1 इति. 29:23</ref></char></note><verse eid="1KI 2:12" /></para>
  <para style="s">अदोनियाहे मौत</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13" />राज़ै दाबेद अर हागीतो शोहरू अदोनियाह डेऊअ राज़ै सुलैमाने ईज बेतशेबा सेटा, बेतशेबा पुछ़अ तेऊ का, “तूह राज्ज़ी-खुशीओ आअ कि किज़ै होर गल्‍ल आसा?”<verse eid="1KI 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 2:14" />तेऊ बोलअ, “नांईं, हुंह आअ राज्ज़ी-खुशीओ, होर निं किछ़ै गल्‍ल आथी पर मंऐं लाई ती ताखा एक गल्‍ल पुछ़ी।”</para>
  <para style="p" vid="1KI 2:14">बेतशेबा बोलअ, “सह किज़ै गल्‍ल आसा?”<verse eid="1KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 2:15" />अदोनियाह बोलअ, “ताखा आसा थोघ कि राज़अ हणअ त हुंह अर सोभ इज़राईली बी च़ाहा तै इहअ कि आजू लोल़ी त मंऐं राज़ किअ। पर राज़-पाठ डेऊअ मुंह छ़ाडी मेरै भाऊ सुलैमाना लै किल्हैकि बिधाते ती एही ई मरज़ी। <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />पर ऐबै आसा ताखा मेरी एही अरज़, ज़ीबाण तेता लै निं नांह करी।”</para>
  <para style="p" vid="1KI 2:16">बेतशेबा पुछ़अ, “सह किज़ै आसा?”<verse eid="1KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 2:17" />अदोनियाह बोलअ, “राज़अ सुलैमान निं तेरी गल्‍ला लै नांह करी ई सकदअ, ज़ीबाण, तै बोल तूह तेऊ लै कि शूनेम नगरी का आणी दी अबीशेगो बैह दैआ मुंह संघै करी।”<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="1KI 1:3">1 राज़. 1:3</ref>,<ref loc="1KI 1:4">4</ref></char></note><verse eid="1KI 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 2:18" />बेतशेबा बोलअ, “आछ़ा ठीक आ, हुंह करूं राज़ै सेटा ताल्है इना गल्‍ला।”<verse eid="1KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19" />बेतशेबा डेऊई राज़ै सुलैमाना सेटा अदोनियाह बाखा गल्‍ला करदी। राज़अ उझ़ुअ आपणीं ईजे अदर करना लै खल़अ संघा टेक्‍कअ तैहा सेटा माथअ। तैहा बेशणा लै आणी एक गाद्दी तेखअ बशैल़ी तेऊ सह तिधी आपणीं दैहणीं बाखा तैहा गाद्दी प्रैंदै अर बेतशेबा बेठी तिधी। <verse eid="1KI 2:19" /><verse number="20" style="v" sid="1KI 2:20" />तेखअ लागी बेतशेबा बोल्दी, “मेरी आसा ताखा धख ज़ेही मांग, ज़ीबाण, तेता लै निं नांह करी।”</para>
  <para style="p" vid="1KI 2:20">सुलैमान राज़ै बोलअ, “बोल मेरी ईजै, किज़ै लोल़ी? मंऐं किल्है लाअ ताल्है नांह करी?”<verse eid="1KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 2:21" />बेतशेबा दैनअ ज़बाब, “शूनेम नगरी का आणी दी अबीशेगो बैह कर तेरै भाई अदोनियाह संघै।”<verse eid="1KI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 2:22" />राज़ै सुलैमानै दैनअ आपणीं ईजा लै ज़बाब, “तूह अदोनियाह लै सिधअ शूनेम नगरीए अबीशेगो बैह ई किल्है मांगा? तेऊ लै थिई तंऐं राज़गाद्दी पै मांगणी! किल्हैकि सह ता मेरअ ज़ेठअ भाई आसा! सिधअ तेऊ लै किल्है? अबतार प्रोहत अर सरूयाहे शोहरू जोआबा लै बी मांग! <verse eid="1KI 2:22" /><verse number="23" style="v" sid="1KI 2:23" />इहअ पुछ़दी छ़ाडी तूह अदोनियाह भाल़ी! हुंह खाआ आझ़ बिधाते सोह कि सह निं मुंह आझ़ ज़िऊंदअ छ़ाडणअ! ज़ै नांईं, तै लोल़ी बिधाता मुल्है तेता का बी बडी सज़ा दैनी। <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />बिधाता बशैल़अ हुंह आपणैं बाब दाबेदे राज़गाद्दी दी राज़अ। तेऊ किई आपणीं ज़बान पूरी संघा दैनअ राज़ मुल्है अर आजू मेरी आद-लुआदा लै। हुंह खाआ बिधाते सोह कि अदोनियाह बझ़ैल़णअ मुंह आझ़ ई मारनै!”<verse eid="1KI 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 2:25" />तेखअ किअ राज़ै सुलैमानै जहोयादे शोहरू बेनियाह लै हुकम अर सह डेऊअ संघा पाअ अदोनियाह मारी।<verse eid="1KI 2:25" /></para>
  <para style="s">अबतार काढअ प्रोहते पदबी का पोर्ही</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26" />राज़ै सुलैमानै बोलअ अबतार प्रोहता लै, “तूह डेऊ अनातोत नगरी आपणैं घअरा लै। ताल्है बी आसा मौते सज़ा, पर आझ़ निं हुंह ताह मारदअ किल्हैकि मेरै बाब दाबेदे राज़ा दी हआ त ताखा मेरै मालक बिधाते पबित्र करारो मणशू सभाल़अ द अर खरीए पलका आसा तंऐं मेरै बाबो साथ दैनअ द।”<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="2SA 15:24">2 शमू. 15:24</ref>; <ref loc="1SA 22:20-23">1 शमू. 22:20-23</ref></char></note> <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />सुलैमानै काढअ अबतार बिधाते प्रोहते पदबी का पोर्ही। इहअ करै हुअ बिधातो सह बैण पूरअ ज़ुंण तेऊ शिलोह एली प्रोहते खिंबे बारै बोलअ त।<note caller="-" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="1SA 2:27-36">1 शमू. 2:27-36</ref></char></note><verse eid="1KI 2:27" /></para>
  <para style="s">जोआब पाअ मारी</para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28" />जोआबा का गअ थोघ लागी कि इहअ-इहअ हुअ। अबशलोमो साथ ता निं जोआबै दैनअ त पर सह बी थिअ अदोनियाह संघै। सह ठुर्हअ बिधाते खिम्भा भितरा लै संघा डाहै तिधी बेदीए शींग ढाकी। <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />राज़ै सुलैमाना सेटा गई खबर पुजी कि जोआब ठुर्हअ बिधाते खिम्भा भितरा लै अर तेऊ आसा बेदीए शींग डाहै दै ढाकी। तेखअ दैनअ राज़ै सुलैमानै जोआबा लै समाद, “तंऐं किल्है आसा बेदीए शींग डाहै दै ढाकी।” जोआबै दैनअ इहअ ज़बाब, “ताह डरै ठुर्हअ हुंह बच़दअ बिधाता सेटा।” सुलैमानै किअ जहोयादे शोहरू बेनियाह लै हुकम, “तूह डेऊ संघा एछ तेऊ मारी।” <verse eid="1KI 2:29" /><verse number="30" style="v" sid="1KI 2:30" />बेनियाह डेऊअ बिधाते खिम्भा सेटा संघा लाई जोआबा लै बागा का हाक्‍का, “राज़ै किअ ताल्है हुकम कि बागै निखल़।”</para>
  <para style="p" vid="1KI 2:30">जोआबै बोलअ, “हुंह निं च़ाल्‍लअ बागै एछी, मुंह मरनअ इधी।”</para>
  <para style="p" vid="1KI 2:30">बेनियाह डेऊअ राज़ै सेटा फिरी संघा खोज़अ कि जोआब बोला इहअ।<verse eid="1KI 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 2:31" />राज़ै सुलैमानै बोलअ, “ज़िहअ सह बोला, तिहअ ई पा तेऊ मारी संघा डाह तेऊ दाबी। तेखअ छ़ुटणैं हुंह अर मेरअ खिंब तेऊ दोशा का ज़ुंण जोआबै दूई नर्दोश मणछे हत्या आसा किई दी। <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />बिधाता दैणीं जोआबा लै तिन्‍नां हत्या करने सज़ा ज़ुंण तेऊ एही बाझ़ी किई अर मेरै बाब दाबेदा का निं थोघ बी आथी त। जोआबै मारअ इज़राईलो सैनापति नेरीओ शोहरू अबनेर अर यहूदा मुल्खो सैनापति जतेरो शोहरू अमासा, तिन्‍नों निं किछ़ै कशूर आथी त। <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />तिन्‍नें हत्या करनैओ दोश लागणअ जोआबा, पर आजू रहणअ तेऊए आद-लुआदा लै बी सदा। पर दाबेदे आद-लुआदा का ज़ुंण बी राज़ करे सह करनअ बिधाता सफल।”<verse eid="1KI 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 2:34" />तेखअ डेऊअ जहोयादो शोहरू बेनियाह बिधाते खिम्भा भितरी संघा पाअ जोआब तिधी मारी। तेखअ डाहअ सह तेऊए नगरी नेल़ रेगीस्तानै दाबी। <verse eid="1KI 2:34" /><verse number="35" style="v" sid="1KI 2:35" />तेखअ बणाअं राज़ै सुलैमानै जहोयादो शोहरू बेनियाह आपणीं सारी सैनो सैनापति अर अबतार प्रोहते ज़ैगा डाहअ सदोक प्रोहत।<verse eid="1KI 2:35" /></para>
  <para style="s">शिमीए मौत</para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36" />तेखअ शादअ राज़ै सुलैमानै शिमी संघा बोलअ तेऊ लै इहअ, “तूह च़िण आप्पू लै इधी एरुशलेम नगरी घअर संघा रहै तिधी। नगरी बागै निं डेऊंदअ लागी। <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />ऐहा गल्‍ला डाहै आद कि ज़हा धैल़ी तूह किद्रोन गाडा टपी पार डेओए, तैहा धैल़ी हणीं तेरी मौत अर आपणीं मौतो दोशी हणअ तूह आप्पै।”<verse eid="1KI 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 2:38" />शिमी बोलअ राज़ै लै, “मेरअ मालक, ठीक आ, हुंह करूं तिहअ ई।” तेखअ रह सह चिई साला तैणीं एरुशलेम नगरी।<verse eid="1KI 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39" />ज़ांऊं चअन साला बिति, शिमीए दूई गलाम ठुर्है तिधा का संघा पुजै गात नगरी माके शोहरू आकीशा राज़ै सेटा। ज़ांऊं शिमी का थोघ लागअ कि तिंयां आसा गात नगरी, <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />शिमी लाई आपणैं गाधै दी ज़ीन काठी संघा डेऊअ आपणैं तिन्‍नां गलाम मणछा लोल़अ गात नगरी राज़ै आकीशा सेटा संघा आणै तिंयां तेऊ तिधा का बापस घअरा लै। <verse eid="1KI 2:40" /><verse number="41" style="v" sid="1KI 2:41" />ज़ांऊं राज़ै सुलैमाना का थोघ लागअ कि शिमी आअ एरुशलेम नगरी का गात नगरी ओर्ही हांढ दैई, <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />तेऊ शादअ शिमी संघा पुछ़अ, “शिमी, तंऐं त बिधाते सोह खाई बोलअ द कि तूह निं एरुशलेम नगरी छ़ाडी किधी डेऊंदअ। मंऐं ती ताल्है चतैनगी हेरी दी दैई, ‘ऐहा गल्‍ला डाहै आद कि ज़हा धैल़ी तूह किद्रोन गाडा टपी पार डेओए, तैहा धैल़ी हणीं तेरी मौत।’ तंऐं बोलअ तधू, ‘माहा राज़अ, ठीक आ, हुंह करूं तिहअ ई!’ <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />बिधाते सोह खाई ऐबै किल्है हुधूअ तूह अर तंऐं किल्है निं मेरअ हुकम मनअ? <verse eid="1KI 2:43" /><verse number="44" style="v" sid="1KI 2:44" />ताखा आसा आप्पै थोघ कि तंऐं मेरै बाब राज़ै दाबेदा लै किहअ बूरअ आसा किअ द। बिधाता निं ताह तेते सज़ा दैणैं बाझ़ी छ़ाडी गअ। <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />पर तेऊ दैणीं मुंह राज़ै सुलैमाना लै बर्गत अर तेऊ करनअ राज़ै दाबेदो राज़ सदा लै अटल़।”<verse eid="1KI 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 2:46" />तेखअ दैनअ राज़ै सुलैमानै आपणैं सैनापति जहोयादे शोहरू बेनियाह लै हुकम अर तेऊ निंयं सह बागै संघा पाअ शिमी मारी। इहअ करै किअ सुलैमानै सारअ देश काबू।<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s">राज़ै सुलैमानै मांगी बिधाता का अक्ल</para>
  <para style="r">(<ref loc="2CH 1:3-12">2 इतिहास 1:3-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />राज़ै सुलैमानै किअ मिसर देशे माहा राज़ै संघै ज़ोल़-मेल़ संघा किअ तेऊए शोहरी संघै बैह। तेऊ पजैल़ी सह दाबेदपूर संघा डाही तेभै तैणीं तिधी ज़ेभै तैणीं सह आप्पू लै मैहल, बिधाता लै भबन अर एरुशलेम नगरी फेर-फिरदै गहल़ा च़िणीं निं मुक्‍कअ। <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />बिधाता लै भबन निं अज़ी बणाअं आथी त अर लोग करा तै ज़ैगै-ज़ैगै धारा बेदी बणाईं बिधाता लै बल़ीदान। <verse eid="1KI 3:2" /><verse number="3" style="v" sid="1KI 3:3" />सुलैमान झ़ूरा त बिधाता लै खास्सअ अर सह रहअ तिहअ ई करदअ लागी ज़िहअ तेऊए बाब राज़ै दाबेदै तेऊ का खोज़ी-बोली त डाहअ द। पर सह करा त सह उझै धारा डेऊई बी धूप ज़ाल़ी अर बल़ीदान दैई।<verse eid="1KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4" />एकी बारी डेऊअ सुलैमान राज़अ गबोन नगरीए धारा बिधाता लै बल़ीदान करदअ, किल्हैकि तिधी थिई सोभी का मशूर बेदी अर तेथ हेरै तै तेऊ कोई एक हज़ारा का बी खास्सै हूम बल़ीदान करी। <verse eid="1KI 3:4" /><verse number="5" style="v" sid="1KI 3:5" />तैहा बैल़ी आअ बिधाता सुलैमाने सुपनै संघा पुछ़अ तेऊ का इहअ, “तूह मांग मुखा, ताह किज़ै बरदान लोल़ी? ज़िहअ तूह च़ाहा, तूह मांग मुखा तिहअ, ताह मुखा किज़ै लोल़ी?”<verse eid="1KI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 3:6" />सुलैमानै बोलअ, “मेरअ बाब दाबेद तेरअ दास त ताल्है शुचअ-पाक्‍कअ अर तेऊ किअ ज़िहअ तंऐं हुकम किअ तिहअ ई। तूह झ़ूरअ मेरै बाब राज़ै दाबेदा लै सदा, तेरी हुणाकार हुई एही कि तंऐं बणाअं मेरै बाबे ज़ैगा आजू हुंह राज़अ। <verse eid="1KI 3:6" /><verse number="7" style="v" sid="1KI 3:7" />हे परमेशर बिधाता, हुंह आसा तेरअ दास अर तंऐं बणाअं मेरै बाबे ज़ैगा हुंह राज़अ। पर हुंह आसा अज़ी लान्हअ अर मुखा निं अज़ी थोघै कि राज़ किहअ करै लागा करनअ। <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />हुंह आसा इधी तेरी छ़ांटी दी परज़ा जैंदरी, तिंयां आसा इहै खास्सै कि तिन्‍नां निं कुंण गणी सकदअ। <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />तूह दै मुल्है एही अक्ल कि हुंह तेरी परज़ा प्रैंदै राज़ करी सकूं अर तिन्‍नां लै नसाफ दैई सकूं अर मंऐं लोल़ी भलअ अर बूरअ परखी ज़ाणअ। नांईं ताह हुंह निं तेरी एतरी खास्सी परज़ो नसाफ करी सकदअ।”<verse eid="1KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10" />मालक बिधाता हुअ सुलैमाना लै खुश कि तेऊ मांगअ इहअ बरदान। <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />बिधाता बोलअ तेऊ लै इहअ, “लाम्मी अमर, धन-माया अर दुशमणो बनाश छ़ाडी मांगी तंऐं मुखा आप्पू लै अक्ल ताकि तूह परज़ा लै नसाफ दैई सके, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />ज़िहअ बरदान तंऐं मांगअ, मुंह करनअ ताल्है तिहअ ई। मुंह दैणीं ताल्है अक्ल अर एही समझ़ कि ताह ज़िहअ अक्ली आल़अ नां आझ़ तैणीं कुंण हुअ अर नां आजू कुंण हणअ। <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />ज़ुंण तंऐं मुखा नांईं बी मांगअ सह बी दैणअ मुंह ताल्है भरपूर। तूह हणअ सारी ज़िन्दगी सेठ अर सोभी करनअ तेरअ अदर अर तूह हणअ सोभी राज़ै का महान। <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />ज़िहअ हुंह बोले ज़ै तूह तिहअ ई करे अर आपणैं बाब दाबेदा ज़िहै मेरअ बधान अर तेते सोभी बिधी मने, तै दैणीं मुंह ताल्है खास्सी अमर।”<verse eid="1KI 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15" />तेखअ उझ़ुअ सुलैमान निंजा का खल़अ अर तेऊ का गअ ज़ाण्हुंई कि मालक बिधाता किई तेऊ संघै सुपनै गल्‍ला। तेखअ डेऊअ सह एरुशलेम नगरी संघा डेऊअ बिधाते करारे मणशू सेटा अर तिधी किऐ तेऊ बिधाता लै हूम अर मेल़-ज़ोल़े बल़ीदान संघा दैनी आपणैं सोभी कार-करिंदै लै धाम।<verse eid="1KI 3:15" /></para>
  <para style="s">सुलैमानै किअ कठण मकदमैंओ नसाफ</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16" />एकी धैल़ै हुअ इहअ कि राज़ै सुलैमाना सेटा आई दूई कंज़री बेटल़ी। <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />तिन्‍नां मांझ़ै बोलअ एकी, “म्हारै मालक, हाम्हैं दुहै रहा एकी घअरै अर थोल़ै धैल़ै आजी सूई हुंह अर मेरै हुअ शोहरू अर अह बी थिई मुंह संघै तिधी। <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />मेरै शोहरू हणें दूई धैल़ै बाद सूई अह बी अर एसो बी हुअ शोहरू। घअरै ती हाम्हैं दूई ई ज़ण्हीं होर निं कोहै आथी त। <verse eid="1KI 3:18" /><verse number="19" style="v" sid="1KI 3:19" />एकी बैल़ी हुअ इहअ कि हाम्हैं ती सुत्ती दी अर अह रही निंजा प्रैंदै आपणैं शोहरू प्रैंदै बधल़ूई अर एसो शोहरू मूंअ क्सोफूई करै। <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />मुंह बी ती राची नींज आई दी, अह उझ़ुई राची खल़ी संघा च़कअ मेरी कुछी सेटा का मेरअ शोहरू संघा डाहअ आपणैं च़ैन्‍नै सताऊई अर आपणअ मूंअ द शोहरू डाहअ मेरी काछ़ा सताऊई! <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />दुजै धैल़ै दोत्ती ज़ांऊं मेरी नींज डेऊई, हुंह लागी आपणैं शोहरू का च़ूई पणैंऊंदी अर मंऐं भाल़अ कि सह आसा मूंअ द! ज़ांऊं मंऐं राम्बल़ै करै भाल़अ तेखअ लागअ मुखा थोघ कि अह ता मेरअ शोहरू आथी ई निं।”<verse eid="1KI 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22" />पर तैहा दुजी बेटल़ी बोलअ, “नांईं, सह ज़िऊंदअ आसा मेरअ शोहरू अर सह मूंअ तेरअ शोहरू!”</para>
  <para style="p" vid="1KI 3:22">पैहली बेटल़ी दैनअ ज़बाब, “नांई, मूंअ तेरअ शोहरू अर मेरअ शोहरू आसा ज़िऊंदअ!”</para>
  <para style="p" vid="1KI 3:22">इहअ करै लागी तिंयां राज़ै नदरी तिधी हठल़दी।<verse eid="1KI 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23" />तेखअ बोलअ राज़ै सुलैमानै इहअ, “तम्हैं एक बी बोला कि ज़िऊंदअ शोहरू आसा मेरअ अर दुजी बी बोला कि ज़िऊंदअ शोहरू आसा मेरअ अर मूंऐं दै शोहरू लै बोला दुहै कि अह आसा एसो!” <verse eid="1KI 3:23" /><verse number="24" style="v" sid="1KI 3:24" />तेखअ बोलअ राज़ै सुलैमानै, “ओर्ही आणा तलबार।” सपाही आणी राज़ै सेटा एक तलबार। <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />तेखअ बोलअ राज़ै सुलैमानै, “एऊ ज़िऊंदै शोहरू काटा दूई बाखा लै संघा दैआ इना दुही लै आधअ-आधअ बांडी।”<verse eid="1KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26" />ज़ुंण तेऊ शोहरूए असली ईज थिई, तैहा फिरी आपणैं तेऊ शोहरू लै खास्सी झींण अर तैहा बोलअ राज़ै लै, “मेरै मालक, ज़ीबाण, एऊ शोहरू निं मारी, एऊ दैआ ऐहा ई लै!”</para>
  <para style="p" vid="1KI 3:26">पर तैहा दुजी बेटल़ी बोलअ, “अह नां मेरअ लोल़ी हुअ नां तेरअ, एऊए करा दूई ठोर।”<verse eid="1KI 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 3:27" />तेखअ बोलअ राज़ै सुलैमानै, “एऊ शोहरू निं मारा! एऊ दैआ ऐहा पैहली बेटल़ी लै अह आसा एऊए असली ईज।”<verse eid="1KI 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28" />ज़ांऊं इज़राईली परज़ा शूणअ कि राज़ै सुलैमानै किअ इहअ नसाफ! तिंयां लागै तेखअ राज़े कदर करदै किल्हैकि तिन्‍नां का गअ ज़ाण्हुंई कि परमेशरै दैनी तेऊ लै नसाफ करना लै अक्ल।<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s">राज़ै सुलैमाने कार-करिंदै</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />सुलैमान त सोभी इज़राईली प्रैंदै राज़अ, <verse eid="1KI 4:1" /><verse number="2" style="v" sid="1KI 4:2" />तेऊए खास कार-करिंदै थिऐ ईंयां:</para>
  <para style="li" vid="1KI 4:2">सदोको शोहरू अजर्याह त प्रोहत,<verse eid="1KI 4:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="1KI 4:3" />दरबारै काईथ आसा तै: शेशे शोहरू एलीहोरेप अर आहिजा।</para>
  <para style="li" vid="1KI 4:3">इतिहास लिखणैं आल़अ त आहीलूदो शोहरू जहोशापात।<verse eid="1KI 4:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="1KI 4:4" />जहोयादो शोहरू बेनियाह थिअ सैनापति अर सदोक अर अबतार तै प्रोहत।<verse eid="1KI 4:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="1KI 4:5" />नातानो एक शोहरू अजर्याह त सोभी दरोगैओ प्रधान अर दुजअ शोहरू जाबूद प्रोहत त राज़ैओ सलाहकार।<verse eid="1KI 4:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="1KI 4:6" />आहीशार त राज़े मैहलै सोभी दासा प्रैंदै सैणअ।</para>
  <para style="li" vid="1KI 4:6">सोभी बेठू प्रैंदै सैणअ थिअ अबदो शोहरू अदोनीराम।<verse eid="1KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />राज़ै सुलैमाने तै इज़राईले बारा गहल़ा दी बारा दरोगै। तिंयां करै तै तिन्‍नें गहल़ा का राज़े मैहला लै ज़िणसो इंतज़ाम। तिन्‍नां लै तै भिन्‍नैं बांडै दै हर साल एछा त तिन्‍नां मांझ़ै हरेकी लै एक भिन्‍नअ अर तेभै हआ ती तेऊए ज़िम्मैंबारी। <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />बारा गहल़ै ज़ुंण बारा दरोगै थिऐ, तिंयां आसा ईंयां:</para>
  <para style="li" vid="1KI 4:8">बेनहूर थिअ एप्रैम गोत्रे सारै धारा बाखे मुल्खै दरोगअ।<verse eid="1KI 4:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="1KI 4:9" />बेनेदकेर थिअ मकास, शालबीम, बेथ-शमेश अर एलोन-बेथ-हनान नगरी लै दरोगअ।<verse eid="1KI 4:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="1KI 4:10" />बेनहेसद थिअ अरूबोत, सोको नगरी अर हेपेर नगरीए सारै मुल्खा लै दरोगअ।<verse eid="1KI 4:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="1KI 4:11" />बेन-अबीनादाब ज़ुंणीं राज़ै सुलैमाने शोहरी तपाता संघै त बैह किअ द, सह थिअ नापात-दोर सारै मुल्खा लै दरोगअ।<verse eid="1KI 4:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="1KI 4:12" />आहीलूदे शोहरू बाना का थिअ तनाक, मगिदो नगरी अर बेथ-शान सारअ मुल्ख सभाल़अ द ज़ुंण सारतान नगरी नेल़ अर जज्रेल दखणा बाखा बेथ-शान पोर्ही अबेल-मेहोला जोकमीम नगरी पोर्ही तैणीं आसा।<verse eid="1KI 4:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="1KI 4:13" />बेनगेबर थिअ गलाद रामोत नगरी अर तिन्‍नां सोभी गरांओ दरोगअ ज़ेथ मनिश्शे गोत्रे याईर टोली थिई बस्सी दी। होर थिऐ तेऊ का बाशान देशे अर्गोब सारअ मुल्ख सभाल़अ द। तेथ थिई शाठ नगरी अर तेता फेर-फिरदै थिऐ गहल़ अर तेते प्रऊल़ी दी थिऐ कांस्से द्रींड लागै दै।<verse eid="1KI 4:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="1KI 4:14" />ईदूओ शोहरू आहीनदाब त माहानीम गहल़ो दरोगअ।<verse eid="1KI 4:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="1KI 4:15" />आहीमासै त सुलैमाने बासमत नाओंए शोहरी संघै बैह किअ द, अर सह थिअ नप्ताली मुल्खो दरोगअ।<verse eid="1KI 4:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="1KI 4:16" />हूशाईओ शोहरू बाना थिअ आशेर गोत्रे बालोत नगरीए सारै मुल्खो दरोगअ।<verse eid="1KI 4:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="1KI 4:17" />इस्साकार गोत्रे मुल्खै थिअ पारुहो शोहरू जहोशापात दरोगअ।<verse eid="1KI 4:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="1KI 4:18" />बिन्यामीन गोत्रे मुल्खै ईलो शोहरू शिमी।<verse eid="1KI 4:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="1KI 4:19" />ऊरीओ शोहरू गेबर थिअ गलाद मुल्खा लै दरोगअ। तेऊ मुल्खै करा तै कधू अमोरी राज़अ सिहोन अर बाशान देशो राज़अ ओग राज़।</para>
  <para style="p" vid="1KI 4:19">इना बारा गहल़े दरोगै का लाऊआ थिअ सारी यहूदा मुल्खै प्रैंदै एक बडअ दरोगअ बी।<verse eid="1KI 4:19" /></para>
  <para style="s">राज़ै सुलैमाने राज़ा दी सिअं</para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20" />यहूदा अर इज़राईल देशे लोग तै समुंदरे बाढै रेता ज़िहै खास्सै गऐ दै हई। तिंयां रहा तै खाई-पिई मौज़ी। <verse eid="1KI 4:20" /><verse number="21" style="v" sid="1KI 4:21" />राज़अ सुलैमान करा त फरात दरैऊआ ओर्ही पलिश्ती देश अर मिसर देशे सिऊंआं तैणीं सोभी देशा प्रैंदै राज़। तिंयां दैआ तै सोभ तेऊ लै सारी ज़िन्दगी कारअ।<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="GEN 15:18">मूल. 15:18</ref>; <ref loc="2CH 9:26">2 इति. 9:26</ref></char></note><verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />राज़ै सुलैमाने दरबारे रसोई दी एकी धैल़ीए ज़िणस एछा ती तिह गाधै लादी मैदअ, शाठ गाधै लादी पिठअ, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />दस खुंढी धाचै दै पशू, बिह बणैं च़रनै आल़ै पशू, शौ भेडा-बाकरी अर एता का लाऊआ ती हेल़्ही दी हरन-हरनी, घोर्हल़ अर घअरै धाचै दै बणें मुर्गै।<verse eid="1KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 4:24" />फरात दरैऊए पछ़मा दी सारै देशै अर तिपसा ओर्ही पछ़मा बाखा गाज़ा तैणीं ज़ेतरै बी राज़ै थिऐ, तिन्‍नां सोभी प्रैंदै थिअ राज़ै सुलैमानो राज़। आप्पू फेर होरी देशा संघै बी डाहा त सह मेल़-ज़ोल़। <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />सुलैमाने ज़िऊंदी ज़िता रहै यहूदा अर इज़राईल बस्सै दै सोभ उतरा बाखा दान नगरी उंधै दखण बेर्शेबा तैणीं राज्ज़ी-राम्बल़ै अर हर इज़राईलीए थिऐ आपणैं-आपणैं घअर अर फेडू अर दाखे बाग अर तिन्‍नां निं किछ़ै डअर हंदी ती।<verse eid="1KI 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 4:26" />राज़ै सुलैमानै तै आपणैं जुधे घोल़ै लै च़ार हज़ार खुढ बणाऐं दै। घोल़े शुंआरी करनै आल़ै शूरबीर थिऐ तेऊ का बारा हज़ार।<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 10:26">1 राज़. 10:26</ref>; <ref loc="2CH 1:14">2 इति. 1:14</ref>; <ref loc="2CH 9:25">9:25</ref></char></note> <verse eid="1KI 4:26" /><verse number="27" style="v" sid="1KI 4:27" />तेऊए बारा दरोगै आणा तै आपणैं-आपणैं भिन्‍नें बारी दी राज़ै सुलैमाना अर राज़े दरबारै खाणैं आल़ै लै ज़िणस। ज़ेही-ज़ेही ज़रुरत हआ ती, तिंयां करा तै तेही-तेही च़िज़ो इंतज़ाम। <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />हर दरोगअ आणा त आपणीं बारी दी बगार ढोणै आल़ै पशू, घोल़ै अर बागरी ज़िहै छ़ेक्‍कै ठुर्हनै आल़ै घोल़ै लै ज़ौ अर ज़ेही ज़रुरत हुई तिहअ घाह हर भिन्‍नैं।<verse eid="1KI 4:28" /></para>
  <para style="s">सुलैमाने अक्ल<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="PSA 89">भज. 89</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />परमेशरै दैनी राज़ै सुलैमाना लै खास्सी अक्ल अर खास्सी समझ़। तेऊ लै दैनअ परमेशरै इहअ खास्सअ ज्ञैन कि तेता निं कुंण नापी सकदअ। <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />राज़अ सुलैमान त पुर्बा बाखा देशे सोभी लोगा अर मिसर देशे लोगा का खास्सअ अक्ली आल़अ। तेऊ सान अक्ल निं कोही आथी ती। <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />एतान, एज्रेही, हमान, मेहोले शोहरू कलकोल अर दारदा का बी थिई तेऊ खास्सी अक्ल। सह हुअ ओर्ही-पोर्ही होरी देशे मणछा जैंदरी बी मशूर। <verse eid="1KI 4:31" /><verse number="32" style="v" sid="1KI 4:32" />तेऊ आसा चअन हज़ार सैणीं गल्‍ला अर एक हज़ारा का ज़ादी गिहा खोज़ी लिखी डाही दी।<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="PRO 1:1">सैणीं. 1:1</ref>; <ref loc="PRO 10:1">10:1</ref>; <ref loc="PRO 25:1">25:1</ref></char></note> <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />तेऊ आसा लाबानोन धारे केल़ुई, बडै-बडै बूट, ज़ुफा होछ़ी-होछ़ी डाल़ी, डागै, हांढणै-फिरनैं आल़ै ज़ीब, म्हाछ़ली अर च़ेल्‍लू-पखीरूए बारै बी खोज़अ द। <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />राज़ै सुलैमाने अक्लीए गल्‍ला शूणीं देशा-देशे राज़ै संघा छ़ाडै लोग तेऊए सैणीं गल्‍ला शुणदै।<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s">बिधाता लै भबन बणाणें तैरी</para>
  <para style="r">(<ref loc="2CH 2:1-18">2 इतिहास 2:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />सूर देशे राज़ै हिरामे ती राज़ै दाबेदा संघै साथ। ज़ांऊं तेऊ का थोघ लागअ कि सुलैमान बणअ आपणैं बाब दाबेदे ज़ैगा राज़अ, तेऊ छ़ाडअ सुलैमाना सेटा लै आपणअ राज़दूत। <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />सुलैमानै दैनअ राज़ै हिरामा लै इहअ समाद बापस, <verse eid="1KI 5:2" /><verse number="3" style="v" sid="1KI 5:3" />“ताखा आसा थोघ कि मेरअ बाब दाबेद च़ाहा त बिधाता लै भबन बणाणअं। पर सह रहअ फेर-फिरदै दुशमणे मकाबलै करदअ लागी ज़ेभै तैणीं सह सोभी का ज़िती निं मुक्‍कअ। तैही निं तेऊ भबना बणाणेंओ मोक्‍कअ ई भेटअ। <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />पर ऐबै आसा मेरै परमेशर बिधाता मेरै देशे फेर सिऊंआं दी शांती डाही दी करी। ऐबै निं मेरअ कोहै दुशमण आथी अर नां किधा का आफ़त पल़दी शुझदी। <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />बिधाता आसा मेरै बाब दाबेदा लै इहअ बोलअ द, ‘तेरअ शोहरू ज़ुंण मुंह ताह बाद राज़अ बणाणअं, तेऊ बणाणअं मुल्है भबन।’ ऐबै हेरी मंऐं आपणैं दिलै पाक्‍की बान्हीं कि मुंह बणाणअं भबन ज़िधी मेरै परमेशर बिधाते पूज़ा-गाज़ा होए।<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 शमू. 7:12</ref>,<ref loc="2SA 7:13">13</ref>; <ref loc="1CH 17:11">1 इति. 17:11</ref>,<ref loc="1CH 17:12">12</ref> </char></note> <verse eid="1KI 5:5" /><verse number="6" style="v" sid="1KI 5:6" />तूह छ़ाड लाबानोन बणां लै आपणैं आदमी संघा दै मुल्है केल़ुईए काठ आणी। तिन्‍नां संघै कामां लै छ़ाडणैं मुंह आपणैं आदमी बी अर ज़ेतरअ तूह बोले मुंह दैणीं तेरै आदमी लै तेतरी मज़दूरी। किल्हैकि ताखा आसा थोघ कि मेरै आदमी निं सदोनी ज़िहअ गरान अर पछान ज़ाणदै आथी।”<verse eid="1KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7" />राज़ै सुलैमाने इना गल्‍ला शूणीं हुअ राज़अ हिराम खास्सअ खुश, तेऊ बोलअ इहअ, “हुंह करा बिधातो शूकर कि तेऊ दैनअ दाबेदा लै तेऊ महान देशा प्रैंदै राज़ करना लै बेघै अक्ली आल़अ शोहरू!” <verse eid="1KI 5:7" /><verse number="8" style="v" sid="1KI 5:8" />तेखअ दैनअ राज़ै हिरामै सुलैमाना लै इहअ ज़बाब, “मुंह सेटा गअ तेरअ समाद पुजी, ताल्है नांह निं मेरै आथी। हुंह दैंऊं ताल्है केल़ुई अर कैलीए काठ काढी। <verse eid="1KI 5:8" /><verse number="9" style="v" sid="1KI 5:9" />मेरै आदमी पजैल़णैं तिंयां लाबानोन धारा का उंधै मांझ़ समुंदरे बाढै तैणीं। तेखअ बान्हणैं तिंयां लाठा दी संघै दैणैं हाम्हां तिंयां समुंदरा ई समुंदरा बाती ज़िधी तूह बोले तिधी पजैल़ी। तिधी दैणैं मेरै आदमी तिंयां खोल्ही तेरै आदमी का सभाल़ी। तूह करै सिधअ मेरै दरबारी लै खाणां-पिणां लै ज़िणसीओ इंतज़ाम।”<verse eid="1KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 5:10" />राज़ै हिरामै दैनै केल़ुई अर कैलीए काठ ज़िहै सुलैमाना लोल़ी तै तिहै काढी। <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />राज़अ सुलैमान दैआ त हर साल हिरामा लै बिह हज़ार गाधै लादी कणक, बिह हज़ार गाधै लादी जैतूनो तेल।<verse eid="1KI 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 5:12" />ज़िहअ बिधाता बोलअ त, तेऊ दैनी सुलैमाना लै अक्ल। राज़ै हिराम अर राज़ै सुलैमाना रहअ सदा मेल़-ज़ोल़ अर तिन्‍नैं दुही डाही आप्पू मांझ़ै करार करी।<verse eid="1KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13" />राज़ै सुलैमानै डाहै सारै इज़राईला मांझ़ै तिह हज़ार बेठू लाई, <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />अर तिन्‍नें ज़िम्मैंबारी सभाल़ी अदोनीरामा का। तिंयां बांडै तेऊ दस-दस हज़ारे चिई छ़ुंढा दी संघा करा तै बारी-बारी लाबानोन बणां लै डेऊई। एकी भिन्‍नैं लागा त तिन्‍नां काम करनअ अर दूई भिन्‍नैं हआ त तिन्‍नों बशैघ।<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="1KI 12:18">1 राज़. 12:18</ref></char></note> <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />राज़ै सुलैमानै तै अश्शी हज़ार मणछ धारा पात्थरा काढदै डाहै दै लाई अर सत्तर हज़ार मणछ तै ढोंदै डाहै दै। <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />एता का लाऊआ थिऐ राज़ै सुलैमाने कामां कराऊंणै आल़ै कोई चअन हज़ार चअन शौ मेट। <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />राज़ै सुलैमानै थिअ हुकम किअ द कि भबने आथरी लै काढै ल्हाशै बडै-बडै पात्थर संघा करै तिन्‍नां च़कूणै। <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />सुलैमान, हिराम अर गबाल नगरीए कारीगीरै किई भबना च़िणना लै काठा अर पात्थरा दी कारीगीरी।<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s">सुलैमानै बणाअं बिधाता लै भबन</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />इज़राईलीए मिसर देशा का निखल़णें च़ार शौ अश्शी साला बाद गई ती सुलैमाना इज़राईला दी राज़अ बणी च़ौथी साल लागी अर बशाह पोर्ही लागअ सह बिधाते भबना च़िणदअ। <verse eid="1KI 6:1" /><verse number="2" style="v" sid="1KI 6:2" />भितरा का बणाअं राज़ै सुलैमानै बिधाता लै भबन तिह हाथ लाम्मअ अर नौ हाथ बिरलअ अर मज़ल च़िणीं कोई तेर्हा हाथ उछ़टी। <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />भबना आजू डाही नौ हाथ लाम्मी खिटी। <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />भबना फेर-फिरदै पाऐ भित्ती दी तीरू आजू का घाटै भितरा बाखा बणाऐं तिंयां बिरलै। <verse eid="1KI 6:4" /><verse number="5-6" style="v" sid="1KI 6:5-6" />भबना बागै पिछ़ू अर दोहरी भित्तीए नील़ै च़िणैं भढारा लै कमरै। तेथ पाई चअन मज़ला। थाल्‍ले मज़ल थिई पांज़ हाथ बिरली, मांझ़ली मज़ल थिई छ़ह हाथ बिरली अर सोभी का प्रैंधल़ी मज़ल थिई सात हाथ बिरली। थाल्‍ले मज़ले मेटा का च़िणअ मांझ़ली मज़लो मेट घाटअ अर मांझ़ली मज़ले मेटा का प्रैंधल़अ मेट त तेता का घाटअ ताकि काठे चाची पाणें ज़रुरत नां पल़े।<verse eid="1KI 6:5-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7" />भबना च़िणने पात्थर तै पैहलै ई ठोल्‍लू-छ़िणीं करै च़कोर आणै दै बणाईं। तैही निं च़िणदी बारी ठोल्‍लू-छ़िणीं या किज़ू होरी लोहे ल्होखरे छ़ेल़ शुण्हदी ती।<verse eid="1KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8" />हेठल़ी मज़ले भढारा लै थिई भबने दखण दिशा बाखा बात अर प्रैंधल़ी मज़ले भढारा लै बी थिई तिधी का शिहल़ लागी दी। <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />राज़ै सुलैमानै छ़ेक्‍कअ भबन बणाईं अर प्रैंदै ती तेथ केल़ुईए भ्रैहणी पाई दी अर तेता प्रैंदै त केल़ुईए बडी-बडी च़ाऊल़ीओ मेल़ पाअ द। <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />बाघली भित्तीए नील़ै बागा बाखा ज़ुंण भढारे कमरै थिऐ च़िणैं दै, तेते मज़ल ती पांज़ हाथ उछ़टी अर तिंयां ती भबने भित्ती दी केल़ुईए मटैहणूं करै ज़ोल़ै दै।<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />बिधाता बोलअ सुलैमाना लै इहअ, <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />“ज़ै तूह मेरअ बधान अर तेते सोभी बिधी मने। तै करनी मुंह सह करार पूरी ज़ुंण मंऐं तेरै बाब दाबेदा संघै किई ती। <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />तै रहणअ हुंह आपणीं परज़ा इज़राईली जैंदरी एऊ भबनै अर तिंयां निं मुंह कधि शोटी डाहणैं।”<verse eid="1KI 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14" />इहअ करै छ़ेक्‍कअ सुलैमानै बिधाता लै भबन बणाईं।<verse eid="1KI 6:14" /></para>
  <para style="s">भितरा का भबने कारीगीरी</para>
  <para style="r">(<ref loc="2CH 3:8-14">2 इतिहास 3:8-14</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 6:15" />भितरा बाखा महल़ी भबने भित्ती केल़ुईए काठा करै अर धरनीं पाअ कैलीए काठो मेल़। <verse eid="1KI 6:15" /><verse number="16" style="v" sid="1KI 6:16" />भबना भितरी बणाईं सोभी का पिछ़ू खास पबित्र ज़ैगा। सह पांड बणाईं बिह हाथ च़कोर। तेता लै किऐ च़ऊ बाखा केल़ुईए फहल़ै खल़ै।<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="EXO 26:33">लुआ. 26:33</ref>,<ref loc="EXO 26:34">34</ref></char></note> <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />पबित्र ज़ैगा आजू बच़ी च़ाल़्ही हाथ लाम्मी ज़ैगा। <verse eid="1KI 6:17" /><verse number="18" style="v" sid="1KI 6:18" />पबित्र ज़ैगे पांड महल़ी भितरा का केल़ुईए काठा करै तेथ निं पात्थरे भीत धख ज़ेही बी शुझदी रही। तिन्‍नां भित्ती अर प्रैंदै लाऐ दै खील-फूले खेल़्तर।<verse eid="1KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19" />भबना भितरी खास पबित्र ज़ैगा तैहा पांडा डाहअ बिधाते करारो मणशू। <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />खास पबित्र ज़ैगा ती लाम्मी, बिरली अर उछ़टी बिह-बिह हाथ अर सह पांड महल़ी सारै का च़ोखै सुन्‍नैं करै। तेता आजू बेदी फेर बी लाऐ केल़ुईए चकाठी।<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">लुआ. 30:1-3</ref></char></note> <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />खास पबित्र ज़ैगे पांड महल़ी सुलैमानै भितरा बाखा च़ोखै सुन्‍नैं करै अर तेते प्रऊल़ी दी लाई सुन्‍नैं करै महल़ी दी शांघल़। <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />इहअ करै महल़ी भबने पबित्र ज़ैगा भितरा का पठी सुन्‍नैं करै अर पबित्र ज़ैगे बेदी बी महल़ी पठी सुन्‍नैं करै।<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:23 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:18-22">लुआ. 25:18-22</ref>
      </char>
    </note>तेखअ बणाऐं तिन्‍नैं जैतूने काठे दूई दस-दस हाथ लाम्मै करूब<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xq" closed="false">करूब </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">लुआ. 25:18-22</ref></char></note> नाओंए स्वर्ग दूत संघा डाहै तिंयां खास पबित्र ज़ैगा। <verse eid="1KI 6:23" /><verse number="24-26" style="v" sid="1KI 6:24-26" />तिंयां दुहै करूब बणाऐं हेरनै एक्‍कै ज़िहै। दुही दी लाऐ दूई-दूई फैंख। फैंख तै पांज़-पांज़ हाथ लाम्मै। एकी फैंखे च़ुंडी का दुजै फैंखे च़ुंडी तैणीं हुऐ तिंयां दस हाथ लाम्मै। <verse eid="1KI 6:24-26" /><verse number="27" style="v" sid="1KI 6:27" />तिंयां करूब डाहै भितरी खास पबित्र ज़ैगा पिछ़ू भित्ती नील़ै। एकीओ फैंख लागअ पार दैहणीं भित्ती दुजै करूबे फैंखै छ़ुंहीं बाऊंईं भीत अर पबित्र ज़ैगा मांझ़ा-मांझ़ी छ़ुंहीं एकी-दुजे फैंखे च़ुंडी। <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />तिंयां दुहै करूब बी महल़ै च़ोखै सुन्‍नैं करै।<verse eid="1KI 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29" />भबने भित्ती दी पाई भितरी अर बागै करूब स्वर्ग दूत, खज़ूरे बूट, अर खील-फूले खेल़्तर। <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />खास पबित्र ज़ैगे पांड महल़ी धरनीं बी च़ोखै सुन्‍नैं करै।<verse eid="1KI 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 6:31" />खास पबित्र ज़ैगै प्रऊल़ी लै बणाऐं जैतूने काठे पाल्‍लै अर तेते चकाठी अर प्रैंदा का बणाअं द्रींड पांज़ा कूणींओ। <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />तेता लै ज़ोल़ी पाल्‍लै बी बणाऐं जैतूने काठे अर तेथ बी ती करूब स्वर्ग दूत, खज़ूरे बूट, अर खील-फूले खेल़्तर पाई दी अर तिंयां सोभै च़िज़ा ती सुन्‍नैं करै महल़ी दी। <verse eid="1KI 6:32" /><verse number="33" style="v" sid="1KI 6:33" />भबने बाघली बडी प्रऊल़ी लै बी बणाऐं जैतूने काठे द्रींड अर ईंयां तै सोभै च़कोर। <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />तेता लै च़ार ज़ोल़ी पाल्‍लै बणाऐं कैलीए काठे। तिंयां पाल्‍लै बणाऐं ज़ोल़ी करै इहै कि घुआल़दा बारी हआ तै तिंयां पाल्‍लै दोछ़ै। <verse eid="1KI 6:34" /><verse number="35" style="v" sid="1KI 6:35" />तिंयां बी महल़ै च़ोखै सुन्‍नैं करै अर तेथ बी थिई करूब स्वर्ग दूत, खज़ूरे बूट, अर खील-फूले खेल़्तर पाई दी।<verse eid="1KI 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36" />पबित्र ज़ैगा आजूए खुल्ही ज़ैगा भित्तीए नील़ै च़िणीं चअन पात्थरे कूंणी च़की खिटी अर प्रैंदै लाऐ तेथ लाम्मै-लाम्मै केल़ुईए दार।<verse eid="1KI 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37" />बिधाते भबने आथरी च़िणदै लागै तै सुलैमाने राज़ा दी च़ौथी साला बशाहै। <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />तिंयां मुक्‍कै सुलैमाने राज़ा दी गैर्हूई साला मकशीरै ज़िहअ तिंयां च़ाहा तै तिहअ भबन बणाईं। इहअ करै लागी तिन्‍नां तेता बणाणां लै सात साला।<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s">राज़ै सुलैमानो आप्पू लै मैहल</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />सुलैमानै बणाअं आप्पू लै बी नऊंअ मैहल अर एता बणाणां लै लागी तेर्हा साला। <verse eid="1KI 7:1" /><verse number="2-3" style="v" sid="1KI 7:2-3" />एक मैहल बणाअं तेऊ होर, तेऊ नाअं त लाबानोन बणों मैहल। अह थिअ शौ हाथ लाम्मअ, पज़ाह हाथ बिरलअ अर तिह हाथ उछ़टी ती एते मज़ल। एथ ती बडै-बडै केल़ुईए थाम्हे च़ार लगैगा लाई दी। एकी लगैगा दी थिऐ पंद्रा थाम्ह अर तिन्‍नां सोभी थाम्हा प्रैंदै तै तेतरै ई मोट्टै पंजताल़ी शौर पाऐ दै। तेता प्रैंदै त केल़ुईए काठो मेल़ पाअ द। <verse eid="1KI 7:2-3" /><verse number="4" style="v" sid="1KI 7:4" />बागै दोहरी बाखा पाई चअन-चअन ताक्‍कीए लगैग आर-पार सम्हनै। <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />तेते दुआरे द्रींड तै च़कूणै बणाऐं दै, तिंयां थिऐ दोहरी बाखा चअन-चअन आर पार सम्हनै लाऐ दै।<verse eid="1KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6" />सुलैमानै बणाअं पज़ाह हाथ लाम्मअ अर तिह हाथ बिरलअ एक च़ऊंरअ बी, तेथ तै सिधै थाम्ह लागै दै अर तेथ आजू बणाअं तेऊ एक होर ताटल़ू ज़ेथ थाम्ह अर प्रैंदै छ़ाप्पर त।<verse eid="1KI 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 7:7" />एक बणाअं सुलैमानै राज़ दरबार ज़िधी सह लोगा लै नसाफ दैआ त, तेता लै बोला त नसाफ करने गाद्दीओ मैहल। सह तेथ तै धरनीं मेल़ अर फेर भित्ती एकी पुंझ़ा का दुजै पुंझ़ा तैणीं केल़ुईए काठ लागै दै।<verse eid="1KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 7:8" />राज़ दरबारे मैहला भितरी त पिछ़ू त तिहअ ई सुलैमाना लै एक कमरू बणाअं द अर मिसर देशे माहा राज़ेए देई ज़हा संघै सुलैमानै बैह त किअ द, तैहा लै बी थिअ तिहअ ई कमरू बणाअं द।<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="1KI 3:1">1 राज़. 3:1</ref></char></note><verse eid="1KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9" />ईंयां सोभै भबन अर राज़े मैहलै तै गोधा आथरी उझै मडाथरू तैणीं किम्मती पात्थरा करै बणाऐं दै। पात्थर तै छ़िणीं ठोल्‍लू अर आरी करै बराबर च़कोर रद्दै बणाऐं दै। <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />आथरी दी थिऐ आठ-आठ, दस-दस हाथ लाम्मै किम्मती पात्थर लाऐ दै। <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />प्रैंदै बी थिऐ किम्मती पात्थर लाऐ दै अर तिंयां थिऐ नापी करै काटै दै अर चाची दी थिऐ केल़ुईए दार पाऐ दै। <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />राज़ मैहले मेट अर बिधाते भबने मेट थिऐ चअन फेरै पात्थरे रद्दै अर हर च़ौथै फेरै केल़ुईए काठे चाची पाई च़िणैं दै।<verse eid="1KI 7:12" /></para>
  <para style="s">हिराम कारीगीरो काम</para>
  <para style="r">(<ref loc="2CH 2:13">2 इतिहास 2:13</ref>,<ref loc="2CH 2:14">14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13" />राज़ै सुलैमानै शादअ सूर नगरी का हिराम नाओं एक ठठार सह थिअ कांस्से कामां लै बडअ सज़ाण कारीगीर। <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />तेऊओ बाब त मरी गअ द अर ईज थिई तेऊए नप्ताली गोत्रा का। हिरामा ती खास्सी समझ़, सह बी त आपणैं बाबा ज़िहअ कांस्से कामां लै सज़ाण अर मशूर कारीगीर। सह पुजअ राज़ै सुलैमाना सेटा संघा सभाल़ी कांस्से कामें सारी ज़िम्मैंबारी।<verse eid="1KI 7:14" /></para>
  <para style="s">कांस्से दूई थाम्ह</para>
  <para style="r">(<ref loc="2CH 3:15-17">2 इतिहास 3:15-17</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15" />हिरामै बणाऐं कांस्सअ गाल़ी करै ठारा-ठारा हाथ लाम्मै कांस्से दूई थाम्ह, गोल़ तै तिंयां थाम्ह सूता करै नापी कोई बारा-बारा हाथ, भितरा का थिऐ तिंयां खोखलै अर तेथ त च़ार आंगल़ मोट्टअ कांस्सअ लागअ द। <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />तिन्‍नां थाम्हा प्रैंदा लै बणाऐं तेऊ पांज़ हाथ उछ़टै टोप। <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />तिन्‍नां टोपे च़ुंडी दी पाई सात-सात फेरै शांघल़ी ज़ेही ज़ाल़ीदार खेल़्तरा आल़ी कांगणी। <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />दूई कांगणी लाई टोपा दी होर अर तेथ लाऐ नारदाणैं ज़िहै कांस्से शल़ुम्हणूं।<verse eid="1KI 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 7:19" />कांगणी का च़ार हाथ उझै त टोप सुरघे फूला ज़िहअ बणाअं द, <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />ज़ुंण थाम्हे टोपा दी सोभी का हेठै दूई-दूई शल़ुम्हणूं आल़ी कांगणी लाई तेथ तै एकी-एकी कांगणी दी एक-एक शौ नारदाणैं ज़िहै कांस्से शल़ुम्हणूं लागै दै।<verse eid="1KI 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 7:21" />हिरामै किऐ ईंयां दूई कांस्से थाम्ह बिधाते भबने प्रऊल़ी आजू खल़ै। ज़ुंण दखण दिशा बाखा थिअ, तेऊ नाअं डाहअ, “जाकीन<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">जाकीन </char><char style="ft" closed="false">परमेशरे फाज़त</char></note>” अर ज़ुंण थाम्ह उतर दिशा बाखा थिअ, तेऊ नाअं डाहअ “बोआज़<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">बोआज़ </char><char style="ft" closed="false">परमेशरो बल</char></note>।” <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />सुरघे फूला ज़िहअ टोप बशैल़अ तिन्‍नां थाम्हा प्रैंदै।</para>
  <para style="p" vid="1KI 7:22">इहअ करै किअ हिरामै कांस्से थाम्हा बणाणेंओ काम पूरअ।<verse eid="1KI 7:22" /></para>
  <para style="s">कांस्सैओ कल़ाह</para>
  <para style="r">(<ref loc="2CH 4:2-5">2 इतिहास 4:2-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23" />हिरामै बणाअं कांस्सैओ बडअ गोल़ कल़ाह, सह थिअ प्रैंदा का दस हाथ खुल्हअ, घेर थिई तेते सूत नापी करै तिह हाथ गोल़ अर सह थिअ कोई पांज़ हाथ उछ़टअ। <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />कल़ाहे घेरै दी थिई उंधै उझै दूई लगैगा दी एक-एक बैथ दूर बल्दे खेल़्तरा पाई दी, तेते खेल़्तर ती तेऊ कल़ाह ई दी काढी दी। <verse eid="1KI 7:24" /><verse number="25" style="v" sid="1KI 7:25" />सह कल़ाह डाहअ बारा कांस्से बल्दा प्रैंदै। चिई बल्दो मुंह उतर दिशा बाखा, चिई बल्दो मुंह दखण, चिई बल्दो मुंह पुर्बा बाखा अर चिई बल्दो मुंह पछ़म दिशा बाखा। लिंघणैं तै तिन्‍नें पिछ़ू बाखा कल़ाहे एकी ज़ैगा ज़ुल़ै दै अर तिन्‍नें पिठी प्रैंदै बशैल़अ कल़ाह। <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />तेऊ कल़ाहो मडोखर त कोई च़ार आंगल़ मोट्टअ अर तेतो घेरअ ज़ाण्हिंआं त सुरघे फूला ज़िहअ। तेथ भितरी एछा त कोई बिह हज़ार बाटी पाणीं।<verse eid="1KI 7:26" /></para>
  <para style="s">कांस्से गाड्डै</para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27" />हिरामै बणाऐं कांस्से दस गाड्डै, तिंयां थिऐ च़ार हाथ लाम्मै अर च़ार हाथ बिरलै अर चअन हाथ उछ़टै। <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />तेथ तै च़ऊ बाखा च़ूल़ै काटी पाल्‍लै लाऐ दै अर मांझ़ै तै तेथ दिलै ज़ोल़ै दै। <verse eid="1KI 7:28" /><verse number="29" style="v" sid="1KI 7:29" />दिलै दी थिऐ सिह, बल्द अर करूब नाओंए स्वर्ग दूते खेल़्तर पाई दी। चकाठी दी बी थिई तेही ई खेल़्तर पाई दी। <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />एकी-एकी गाड्डै दी तै हेठै कांस्से च़ार-च़ार घरेट लाऐ दै, तिन्‍नां चैल़णा लै कांस्से धूर बणाऐं दै। च़ऊ कूणैं दी थिई भितरा बाखा लै कल़ाह थम्हणा लै कांस्से धज़ी लागी दी। <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />तेथ थिई डबरै बशैल़णा लै कांस्से कांगणी लागी दी, एक हाथ रहा ती सह गाड्डै का उझै अर एक बैथ थिई भितरी अर प्रैंदै थिई तेथ खेल़्तर पाई दी। <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />गाडे घरेट तै डेढ-डेढ हाथ उछ़टै तिंयां थिऐ थाल्‍लै कांस्से धूरा करै ज़ोल़ै दै। <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />तिंयां घरेट थिऐ रथे घरेटा ज़िहै, तेतो घेरअ, घरेट, शल़ाही अर तेते ज़ोल़ सोभै गल़ाऊई-ढल़ाऊई करै बणाऐं दै। <verse eid="1KI 7:33" /><verse number="34-35" style="v" sid="1KI 7:34-35" />सोभी गाड्डै प्रैंदै ती फेर-फिरदी एक बैथ बिरली गोल़ काणस लाई दी अर गाड्डै च़ऊ कूणीं हेठै हाथकला लागी दी। प्रैंदे थुम्हणीं अर धज़ी थिई धरनीं गाड्डै दी ज़ुल़ी दी। <verse eid="1KI 7:34-35" /><verse number="36" style="v" sid="1KI 7:36" />पाल्‍ले धज़ी अर दिलै दी थिई सिह, बल्द अर करूब नाओंए स्वर्ग दूत खज़ूरे बूटे खेल़्तर पाई दी। फेर-फिरदी ती च़ऊ बाखा तेथ काणसा लाई दी। <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />इहअ करै छ़ेक्‍कै तिंयां दस गाड्डै बणाईं। तिंयां सोभ तै नापी करै एक बराबर अर एक्‍कै ज़िहै।<verse eid="1KI 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38" />तिन्‍नां गाड्डै प्रैंदा डाहणां लै बणाऐं हिरामै च़ार-च़ार हाथ बिरलै दस डबरै, एकी-एकी डबरै दी एछा त कोई च़ार शौ बाटी पाणीं।<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 30:17-21">लुआ. 30:17-21</ref></char></note> <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />पांज़ गाड्डै डाहै तेऊ बिधाते भबनै दखणा बाखा पाशल़ी अर बाकी पांज़ डाहै पुर्बा बाखा भबने दुजी पाशल़ी अर सह बडअ कल़ाह डाहअ दखण अर पुर्बा दिशा मांझ़ा-मांझ़ी।<verse eid="1KI 7:39" /></para>
  <para style="s">हिराम ठठारै बणाईं दी च़िज़ा</para>
  <para style="r">(<ref loc="2CH 4:11-5:1">2 इतिहास 4:11—5:1</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 7:40" />होर बणाऐं हिरामै बतिल्‍लै, पल़ैंज़ै, प्रिहै। राज़ै सुलैमाना बिधाते भबनै ज़ेतरअ कांस्सैओ काम करनअ त, सह किअ हिरामै पूरअ। तेऊ बणाईं ईंयां च़िज़ा:<verse eid="1KI 7:40" /></para>
  <para style="li">
    <verse number="41-42" style="v" sid="1KI 7:41-42" />दूई कांस्से थाम्ह,</para>
  <para style="li" vid="1KI 7:41-42">थाम्हा प्रैंदा लै दूई टोप,</para>
  <para style="li" vid="1KI 7:41-42">शांघल़ी ज़ेही ज़ाल़ीदार खेल़्तरा आल़ी कांगणी,</para>
  <para style="li" vid="1KI 7:41-42">दुही थाम्हा लै दूई-दूई शल़ुम्हणूं आल़ी कांगणी</para>
  <para style="li" vid="1KI 7:41-42">तिन्‍नां च़ऊ कांगणी लै नारदाणैं ज़िहै च़ार शौ शल़ुम्हणूं।<verse eid="1KI 7:41-42" /></para>
  <para style="li">
    <verse number="43" style="v" sid="1KI 7:43" />दस गाड्डै अर तेता प्रैंदै कांस्से दस डबरै।<verse eid="1KI 7:43" /></para>
  <para style="li">
    <verse number="44" style="v" sid="1KI 7:44" />बडअ कल़ाह अर तेता हेठै बारा बल्द, होर बतिल्‍लै अर पल़ैंज़ै अर<verse eid="1KI 7:44" /></para>
  <para style="li">
    <verse number="45" style="v" sid="1KI 7:45" />होर प्रिहै।</para>
  <para style="p" vid="1KI 7:45">ईंयां सोभै भांडै ज़ुंण राज़ै हिरामै राज़ै सुलैमानै तैणीं बिधाते भबना लै बणाणैं बझ़ैल़ै, ईंयां तै कांस्सअ कराही करै बणाऐं दै।<verse eid="1KI 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 7:46" />ईंयां बझ़ैल़ै तै राज़ै जरदण खागै सक्‍कोत अर सारतान मांझ़ै तैहा ज़ैगा बणाणैं ज़िधी च़कणाट माट्टअ आसा। <verse eid="1KI 7:46" /><verse number="47" style="v" sid="1KI 7:47" />अह कांस्सैओ समान निं सुलैमानै तोलअ ई आथी किल्हैकि ईंयां तै खास्सै, तिहअ करै निं थोघ ई आथी कि तेथ केतरअ कांस्सअ लागअ।<verse eid="1KI 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:48 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 30:1-3">लुआ. 30:1-3</ref>; <ref loc="EXO 25:23-30">25:23-30</ref></char>
    </note>बिधाते पबित्र ज़ैगा लै ज़ेतरी च़िज़ा लोल़ी ती, तिंयां महल़ी सुलैमानै सुन्‍नैं करै। बेदी, भोज़ना डाहणां लै मेज़, <verse eid="1KI 7:48" /><verse number="49" style="v" sid="1KI 7:49" /><note caller="-" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="EXO 25:1-40">लुआ. 25:1-40</ref></char></note>खास पबित्र ज़ैगा आजूए दस सदीऐ, पांज़ दखण दिशा बाखा अर पांज़ उतर दिशा बाखा, फूल, <verse eid="1KI 7:49" /><verse number="50" style="v" sid="1KI 7:50" />दीऐ, च़िमटै, डबरी, काता, प्रिहै, धूप दानी, धनैरै, भितरा बाखा खास पबित्र ज़ैगा अर भबने बाघली प्रऊल़ीए कल़ोलै बी महल़ै सुन्‍नैं करै।<verse eid="1KI 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51" />ज़ांऊं राज़ै सुलैमानै भबनो सारअ काम करी छ़ेक्‍कअ, तेऊ डाही सुन्‍नैं, च़ंदीए अर होर च़िज़ा बिधाते भबने भढारै ज़ुंण तेऊए बाब दाबेदै बिधाता लै ज़ुदी ती डाही दी।<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="2SA 8:11">2 शमू. 8:11</ref>; <ref loc="1KI 18:11">1 राज़. 18:11</ref></char></note><verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s">बिधाते करारो मणशू पजैल़अ भबना भितरी</para>
  <para style="r">(<ref loc="2CH 5:2-6:2">2 इतिहास 5:2—6:2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />तेखअ शादै राज़ै सुलैमानै सोभी गोत्र अर टोली का इज़राईली सैणैं एरुशलेम नगरी लै एही गल्‍ला करना लै कि बिधाते करारो मणशू निंणअ सियोन दाबेदपूर गहल़ा का बिधाता लै बणाऐं दै भबना लै।<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="2SA 6:12-16">2 शमू. 6:12-16</ref>; <ref loc="1KI 15:25-29">1 राज़. 15:25-29</ref></char></note> <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />इज़राईली सोभ सैणैं हुऐ छ़ानींए थैरा बाती शऊजै राज़ै सुलैमाना सेटा कठा।<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लेब. 23:34</ref></char></note> <verse eid="1KI 8:2" /><verse number="3" style="v" sid="1KI 8:3" />ज़ांऊं तिधी सोभ इज़राईली सैणैं पुजै, प्रोहतै च़कअ बिधाते करारो मणशू <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />संघा पजैल़अ बिधाते भबना भितरी। प्रोहतै अर लेबी निंयैं करारे मणशू संघा तिंयां सोभ पबित्र भांडै अर सारअ समान ज़ुंण मेल़-ज़ोल़े खिम्भा दी थिऐ। खिम्भ बी निंयं तिन्‍नैं खोल्ही करै उझै। <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />राज़अ सुलैमान अर इज़राईली टोली का ज़ेतरै बी लोग तिधी तै आऐ दै, तिंयां लागै करारे मणशू आजू हांढदै अर बाता काटै तिन्‍नैं एतरै खास्सै रिठ अर होर पशूए हेल़्ही कि तिन्‍नां निं कुंण गणी सकदअ त। <verse eid="1KI 8:5" /><verse number="6" style="v" sid="1KI 8:6" />तेखअ पजैल़अ प्रोहतै सह करारो मणशू बिधाता लै बणाऐं दै भबना भितरी तैहा ज़ैगा ज़ेता लै खास पबित्र ज़ैगा बोला तै, संघा डाहअ तिन्‍नां करूब नाओंए स्वर्ग दूते फैंखा हेठै बशैल़ी। <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />तिंयां करूबे फैंख तै इहै कि करारो मणशू आअ तेते लोहल़ी संघी तेथ हेठै। <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />करारे मणशू दी लाई दी लोहल़ी ती एही लाम्मी कि तिंयां जाआ ती भितरी खास पबित्र ज़ैगा आजू सम्हनै का शुझुई पर होर्ता का निं तिंयां किधी का शुझदी ती। तिंयां लोहल़ी आसा आझ़ तैणीं बी तिधी। <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />करारे मणशू भितरी निं तिन्‍नां दूई पात्थरे शिला सुआई होर किछ़ै आथी त ज़ुंण तेथ होरेब धारा का एछी मोसा गूरै तधू डाही ती ज़धू बिधाता इज़राईली संघै मिसर देशा का एछदी बारी करार किई ती।<note caller="-" style="x"><char style="xo" closed="false">8:9 </char><char style="xt" closed="false"><ref loc="DEU 10:5">बधा. 10:5</ref></char></note><verse eid="1KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10" />ज़ांऊं प्रोहत खास पबित्र ज़ैगा का बागै निखल़ै, तिधी घोर्हुऐ बिधाते भबना फेर घणैं बादल़।<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EXO 40:34">लुआ. 40:34</ref>,<ref loc="EXO 40:35">35</ref></char></note> <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />तिन्‍नां बादल़ा करै निस्सअ बिधाते भबनै च़ाकरी करनै आल़ै प्रोहते खल़ै टेखुई किल्हैकि बिधाते भबनै लाई बादल़ा जैंदरी लागअ धुप्पै ज़िहअ झ़ामण अर बिज़ल़ीए झ़प्प-तल़प्पी। <verse eid="1KI 8:11" /><verse number="12" style="v" sid="1KI 8:12" /><note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="PSA 18:11">भज. 18:11</ref>; <ref loc="PSA 97:2">97:2</ref></char></note>तेखअ किई राज़ै सुलैमानै एही अरज़,</para>
  <para style="q" vid="1KI 8:12">“हे बिधाता, तंऐं आसा सरगै सुरज़ टकैल़अ द,</para>
  <para style="q" vid="1KI 8:12">तज़ी बी आसा तंऐं इहअ बोलअ द कि ताह रहणअ घणैं न्हैरै बादल़ा जैंदरी,<verse eid="1KI 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1KI 8:13" />ऐबै बणाअं मंऐं ताल्है रहणा लै महान भबन,</para>
  <para style="q" vid="1KI 8:13">एथ लोल़ी तूह जुगै-जुगै तैणीं रहअ।”<verse eid="1KI 8:13" /></para>
  <para style="s">सुलैमानै दैनअ परज़ा लै भाषण</para>
  <para style="r">(<ref loc="2CH 6:3-11">2 इतिहास 6:3-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 8:14" />सोभ इज़राईली तै तिधी खल़्हुऐ दै, तेखअ फिरअ राज़अ सुलैमान तिन्‍नां बाखा लै अर तेखअ किई बिधाता सेटा अरज़ कि तिन्‍नां लै बर्गत दैए। <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />सुलैमानै बोलअ इहअ, <note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="2SA 7:4-11">2 शमू. 7:4-11</ref>; <ref loc="1CH 17:3-10">1 इति. 17:3-10</ref></char></note>“इज़राईले परमेशर बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई! तेऊ ज़ुंण ज़बान मेरै बाब दाबेदा लै दैनी ती, सह किई आझ़ तेऊ पूरी। तेऊ बोलअ त इहअ, <verse eid="1KI 8:15" /><verse number="16" style="v" sid="1KI 8:16" />‘ज़धू मंऐं आपणीं परज़ा मिसर देशा का काढी आणी, तधा ओर्ही आझ़ तैणीं निं मंऐं इज़राईला मांझ़ै आप्पू लै एही कोहै नगरी छ़ांटी ज़िधी मेरी पूज़ा-गाज़ा करना लै भबन बणांए। पर मंऐं छ़ांटअ आपणीं परज़ा इज़राईली प्रैंदै राज़ करना लै तूह दाबेद।’<verse eid="1KI 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 8:17" />“मेरअ बाब दाबेद राज़अ च़ाहा त बिधाता लै एक भबन बणाणअं ताकि तैहा ज़ैगा एछी सोभ इज़राईली माथअ टेक्‍के।<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="2SA 7:1-3">2 शमू. 7:1-3</ref>; <ref loc="1CH 17:1">1 इति. 17:1</ref>,<ref loc="1CH 17:2">2</ref> </char></note> <verse eid="1KI 8:17" /><verse number="18" style="v" sid="1KI 8:18" />पर बिधाता बोलअ राज़ै दाबेदा लै, ‘ज़ुंण तूह मेरै नाओंए प्रतप्पा लै मुल्है भबन बणाणां लै सोठा, तेरी अह सोठ आसा भली। <verse eid="1KI 8:18" /><verse number="19" style="v" sid="1KI 8:19" />पर ताह निं सह बणाणअं भेटणअ, पर तेरै शोहरू बणाणअं आजू मेरै नाओंए प्रतप्पा लै मुल्है भबन।’<note caller="-" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 शमू. 7:12</ref>,<ref loc="2SA 7:13">13</ref>; <ref loc="1CH 17:11">1 इति. 17:11</ref>,<ref loc="1CH 17:12">12</ref></char></note><verse eid="1KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 8:20" />“अह ज़ुंण बैण बिधाता बोलअ त, सह किअ तेऊ ऐबै पूरअ। हुंह बेठअ आजू आपणैं बाब दाबेदे ज़ैगा इज़राईल देशो राज़अ अर बिधाता लै भबन बी हेरअ मंऐं बणाईं। <verse eid="1KI 8:20" /><verse number="21" style="v" sid="1KI 8:21" />भबना भितरी बिधाते करारे मणशू डाहणां लै बी बणाईं मंऐं भबना भितरी ज़ैगा। तेथ भितरी आसा दूई पात्थरे शिला बिधाते हाम्हां इज़राईली संघै सह करार ज़ुंण बिधाता म्हारै दादा-बाबा संघै मिसर देशा का एछदी बारी सीनाई धारा किई ती।”<verse eid="1KI 8:21" /></para>
  <para style="s">राज़ै सुलैमाने अरज़</para>
  <para style="r">(<ref loc="2CH 6:12-42">2 इतिहास 6:12-42</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22" />तेखअ डेऊअ सुलैमान तिधी सोभी लोगा नदरी बिधाते बेदी सेटा संघा किई आपणैं हाथ उझै सरगा बाखा करी एही अरज़, <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />“हे इज़राईले परमेशर बिधाता, ताह ज़िहअ नां स्वर्गै कुंण आथी अर नां उंधै धरती दी कुंण ताह बराबर परमेशर आथी! तूह झ़ूरा आपणीं परज़ा लै अर तूह करा तिन्‍नां लै आपणीं करार पूरी ज़ुंण तेरै बधान अर बिधी मनणा लै शुचअ-पाक्‍कअ रहा। <verse eid="1KI 8:23" /><verse number="24" style="v" sid="1KI 8:24" />तंऐं ज़ेही मेरै बाब दाबेदा लै ज़बान दैनी ती, सह किअ तंऐं आझ़ आपणअ एक-एक बैण पूरअ। <verse eid="1KI 8:24" /><verse number="25" style="v" sid="1KI 8:25" />ऐबै हे इज़राईले परमेशर बिधाता होर बी ज़ुंण गल्‍ला तंऐं बोली आसा डाही दी तिन्‍नां बी करै पूरी। तंऐं आसा मेरै बाबा लै बोलअ द, ‘तेरी आद-लुआदा मांझ़ै ई हणअ एक ज़ण्हअ इज़राईला प्रैंदै सदा लै राज़अ, ज़ै तिंयां ताह ज़िहै ई मेरै बधान अर बिधी मने।’<note caller="-" style="x"><char style="xo" closed="false">8:25 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1 राज़. 2:4</ref></char></note> <verse eid="1KI 8:25" /><verse number="26" style="v" sid="1KI 8:26" />ऐबै हे इज़राईले परमेशर, ज़ुंण तंऐं मेरै बाब दाबेदा का आसा बोलअ द, ऐबै लोल़ी तिंयां सोभै गल्‍ला तेही ई निभी।<verse eid="1KI 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 8:27" />“हे परमेशर, ऐबै ताह सच्च़ी रहणअ धरती दी? ताल्है पल़ा सारअ भ्रमंड बी थोल़अ, तेखअ मेरअ बणाअं द अह होछ़अ ज़िहअ भबन किधी च़ाल्‍लअ ताल्है पूरअ पल़ी!<note caller="-" style="x"><char style="xo" closed="false">8:27 </char><char style="xt" closed="false"><ref loc="2CH 2:6">2 इति. 2:6</ref></char></note> <verse eid="1KI 8:27" /><verse number="28" style="v" sid="1KI 8:28" />हे मेरै परमेशर बिधाता, हुंह आसा तेरअ दास, ज़ीबाण, तूह शुण आझ़ मेरी अरज़ ज़ुंण आझ़ हुंह ताखा करा। <verse eid="1KI 8:28" /><verse number="29" style="v" sid="1KI 8:29" />अह भबन छ़ांटअ तंऐं आप्पू लै कि इधी तेरी पूज़ा-गाज़ा होए। तूह रहै धैल़ी-राची एता भाल़अ लागी अर ज़ेभै हुंह एथ बाखा मोहरअ करी अरज़ करूं, तेता शूणैं तूह।<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="DEU 12:11">बधा. 12:11</ref></char></note> <verse eid="1KI 8:29" /><verse number="30" style="v" sid="1KI 8:30" />हुंह आसा तेरअ दास, अर इज़राईली सारी परज़ा बी आसा तेरी। हाम्हां मांझ़ै तेरै भबना बाखा भाल़ी अरज़ करे, तूह शूणैं तेता स्वर्गा का संघा करै म्हारै पाप माफ।<verse eid="1KI 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 8:31" />“ज़ै कहा मणछा दुजै मणछा लै ज़ुल्म करनैओ दोश होए अर ज़ै सह मणछ तेरै भबनै तेरी बेदी सेटा एछी सोह खाए कि तेऊओ निं किछ़ै कशूर आथी, <verse eid="1KI 8:31" /><verse number="32" style="v" sid="1KI 8:32" />तै हे बिधाता, तूह करै आपणैं दासो नसाफ स्वर्गा का। तूह दैऐ कदुष्टा लै आप्पै सज़ा अर नर्दोश लोल़ी राज्ज़ी-राम्बल़अ रहअ।<verse eid="1KI 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 8:33" />“ज़ै तेरी परज़ा इज़राईली ताल्है पाप करनै पिछ़ू दुशमणा का हारे, तेखअ ज़ै तिंयां तेरै भबना लै एछी लेर-पकार पाई ताखा माफी मांगे, <verse eid="1KI 8:33" /><verse number="34" style="v" sid="1KI 8:34" />तूह शूणैं स्वर्गा का तिन्‍नें अरज़ संघा करै आपणीं इज़राईली परज़े पाप माफ। तेखअ आणै तिन्‍नां तैहा ज़ैगा लै बापस फरेऊई ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै आसा दैनी दी।<verse eid="1KI 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 8:35" />“ज़ै तेरी परज़ा ताल्है पाप करनै पिछ़ू तूह ज़ै तिन्‍नां लै सरगा का पाणीं हणअ बंद करे, तेखअ ज़ै तिंयां पाप करनअ छ़ाडे अर तेरै भबना बाखा फिरी ताखा अरज़ करे, <verse eid="1KI 8:35" /><verse number="36" style="v" sid="1KI 8:36" />तूह शूणैं तिन्‍नें अरज़ स्वर्गा का संघा करै राज़ै अर इज़राईलीए पाप माफ, तूह दैऐ तिन्‍नां लै भलै करने शिक्षा। हे परमेशर, तेखअ दै तूह आपणीं ऐहा ज़ैगा सरग हणैं ज़ुंण तंऐं सदा लै आपणीं परज़े ज़ैदात आसा बणाईं दी।<verse eid="1KI 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 8:37" />“ज़ै केभै एऊ देशै नकाल़, कि मरी, नाज़ा लै शुक्‍कअ पल़े, रैट्टै कि नाज़ा लै गाल़्ही लागे, कि तेरी परज़ा दुशमण गोटे, कि तेरी परज़ा लै आफ़त पल़े कि किज़ै रोग लागे, <verse eid="1KI 8:37" /><verse number="38" style="v" sid="1KI 8:38" />तेभै ज़ै तेरी परज़ा इज़राईली दिला का माल़ी च़ेते कि तिन्‍नें भलै हुई गलती अर ज़ै तिंयां मणछ ताह सेटा एऊ भबना बाखा बाह फुआरी अरज़ करे, <verse eid="1KI 8:38" /><verse number="39" style="v" sid="1KI 8:39" />तेभै शूणैं तूह तिन्‍नें अरज़ स्वर्गै आपणैं घअरै संघा छ़ाडै तिन्‍नां लै माफी। तिन्‍नां लै दैऐ ज़सरै मन्‍नैं ज़िहअ होए तिहअ फल। किल्हैकि मणछे मन्‍नैं किज़ै आसा, एतो थोघ हआ सिधअ ताखा ई। <verse eid="1KI 8:39" /><verse number="40" style="v" sid="1KI 8:40" />ताकि तैहा ज़ैगा ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै दैनी ती, तेथ रहणअ तिन्‍नां आपणीं ज़िऊंदी ज़िता तेरी डरा हेठै अर तिन्‍नां करनअ ज़िहअ तूह बोला तिहअ।<verse eid="1KI 8:40" /></para>
  <para style="p">
    <verse number="41-42" style="v" sid="1KI 8:41-42" />“तेखअ ज़ै तेरी इज़राईली परज़ा छ़ाडी ज़ै कुंण होर दूर परदेसा का तेरअ नाअं अर तेरै महान कामें बारै शूणीं ताह सेटा लै एछे अर सह तेरै एऊ भबना बाखा फिरी अरज़ करे, <verse eid="1KI 8:41-42" /><verse number="43" style="v" sid="1KI 8:43" />तूह शूणैं तेऊए अरज़ स्वर्ग आपणैं बसेरै का। तूह करै तेऊए दिला-मन्‍नें पूरी ताकि संसारे सोभी लोगा का तेरअ थोघ लागे अर तिंयां बी तेरी परज़ा इज़राईली ज़िहै तेरी डरा हेठै रहे। तेखअ लागणअ तिन्‍नां सोभी का थोघ ज़ुंण मंऐं ताल्है भबन बणाअं, अह ज़ैगा आसा तेरी पूज़ा-गाज़ा करने।<verse eid="1KI 8:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 8:44" />“हे बिधाता, ज़ै केभै तूह आपणीं परज़ा दुशमणा संघै मकाबलै करदै ज़िधा लै बी छ़ाडे, तिंयां ज़िधी बी होए अर ज़ै तिंयां खास्सै दूर हई बी तंऐं आप्पू लै छ़ांटी दी ऐहा नगरी अर मंऐं ताल्है बणाऐं दै एऊ भबना बाखा आपणअ मोहरअ करी ताह बिधाता सेटा अरज़ करे, <verse eid="1KI 8:44" /><verse number="45" style="v" sid="1KI 8:45" />तूह शूणैं तिन्‍नें अरज़ स्वर्गै संघा दैऐ तिन्‍नां लै तिन्‍नें दुशमणा का ज़ीत।<verse eid="1KI 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 8:46" />“हे बिधाता, एही ता आसा सोभ मणछ पापी, पर ज़ै तेरी परज़ा ताल्है पाप करे अर तेता पिछ़ू ज़ै तूह इहअ रुश्शे कि तेरी परज़ा दुशमणा का हारे अर दुशमण तिन्‍नां होरी देशा लै कैद करी निंए, च़ाऐ सह देश केतरअ बी दूर किल्है निं होए, <verse eid="1KI 8:46" /><verse number="47" style="v" sid="1KI 8:47" />तूह शूणैं आपणीं परज़े अरज़ तेथ बी। ज़ेऊ देशै तिंयां कैद करी होए निऐं दै, ज़ै तेथ तिंयां ताह सेटा लेर-पकार पाई बोले, ‘हे म्हारै बिधाता, हाम्हैं किअ घोर पाप, हाम्हैं आसा खास्सै कदुष्ट अर हाम्हैं किऐ बेघै कदुष्ट काम।’ <verse eid="1KI 8:47" /><verse number="48" style="v" sid="1KI 8:48" />तेखअ ज़ै तिंयां दिला मना का माल़ी च़ेते अर तिंयां दूर दुशमणे देशा का बी तैहा ज़ैगा ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै दैनी ती, ऐहा नगरी ज़ुंण तंऐं आप्पू लै छ़ांटी अर भबन ज़ुंण मंऐं ताल्है बणाअं, एथ बाखा मोहरअ करी ताखा अरज़ करे, <verse eid="1KI 8:48" /><verse number="49" style="v" sid="1KI 8:49" />तूह शूणैं तिन्‍नें अरज़ स्वर्गै आपणैं घअरै संघा करै तिन्‍नां लै झींण। <verse eid="1KI 8:49" /><verse number="50" style="v" sid="1KI 8:50" />तिन्‍नैं ताल्है च़ाऐ ज़िहअ बी पाप किअ द होए, तूह करै तिन्‍नां माफ अर ज़ुंणीं दुशमणै तिंयां कैद करी निऐं, तिंयां लोल़ी तेरी परज़ा लै झणैल़ू हुऐ। <verse eid="1KI 8:50" /><verse number="51" style="v" sid="1KI 8:51" />ऐहा गल्‍ला डाहै आद ईंयां आसा तिंयां लोग ज़ुंण तंऐं आप्पू लै छ़ांटै अर तंऐं आणै दा तिंयां मिसर देशा का काढी, तेता समझ़ तूह इहअ कि तिंयां आसा तंऐं लोहै गाल़णे भठी दी भकदै कोयलै मांझ़ा का काढी आणै दै।<verse eid="1KI 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 8:52" />“हे महान बिधाता, हुंह आसा तेरअ दास, इज़राईली परज़ा बी आसा तेरी, ज़ेभै बी हाम्हैं ताह सेटा लेर-पकार पाई अरज़ करे, तेभै शूणैं तूह संघा करै म्हारी मज़त। <verse eid="1KI 8:52" /><verse number="53" style="v" sid="1KI 8:53" />ज़धू तंऐं म्हारै दाद-बाब मिसर देशा का काढी आणै तधू बोलअ त तंऐं आपणैं दास मोसा लै कि इना लै बोल इहअ, ‘संसारे सोभी लोगा मांझ़ा का छ़ांटै मंऐं थारै मालक बिधाता तम्हैं आप्पू लै कि मेरी खास परज़ा होए।’”<verse eid="1KI 8:53" /></para>
  <para style="s">खिरी किई सुलैमानै एही अरज़</para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54" />ज़ांऊं सुलैमान बिधाता सेटा अरज़ करी मुक्‍कअ, सह खल़्हुअ तेखअ बिधाते बेदी सेटा का खल़अ ज़िधी सह ज़ान्हूंए बलै उझै सरगा बाखा हाथ करी बेठअ द थिअ। <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />तेखअ मांगी तेऊ ज़ोरै-ज़ोरै इहअ बोली बिधाता का सोभी इज़राईली लै बर्गत, <verse eid="1KI 8:55" /><verse number="56" style="v" sid="1KI 8:56" />“तेऊ बिधाते लोल़ी ज़ै-ज़ैकार हुई ज़ुंणीं आपणीं परज़ा इज़राईली लै ज़िहअ तेऊ बोलअ त तिहअ ई बशैघ दैनअ। म्हारी भलाईए तैणीं ज़ुंण बी गल्‍ला तेऊ आपणैं दास मोसा का हाम्हां लै बोली ती, तेता मांझ़ै निं एक बी गल्‍ल एही छ़ुटी ज़ुंण पूरी निं हुई होए।<note caller="-" style="x"><char style="xo" closed="false">8:56 </char><char style="xt" closed="false"><ref loc="DEU 12:10">बधा. 12:10</ref>; <ref loc="JOS 21:44">ज़ैह. 21:44</ref>,<ref loc="JOS 21:45">45</ref></char></note> <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />म्हारअ परमेशर बिधाता ज़िहअ म्हारै दादा-बाबा संघै रहअ, तिहअ लोल़ी सह हाम्हां संघै बी रहअ, तेऊ निं हाम्हैं कधि लोल़ी छ़ाडै अर नां शोटी लोल़ी डाहै। <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />तेऊ लोल़ी ती म्हारी एही मज़त किई कि ज़िहअ सह च़ाहा हाम्हैं तेही ज़िन्दगी ज़िऊए अर तेऊए बधाने तिन्‍नां सोभी बिधी मने ज़ुंण तेऊ म्हारै दादा-बाबा लै दैनी ती। <verse eid="1KI 8:58" /><verse number="59" style="v" sid="1KI 8:59" />मेरी आसा एही अरज़ कि ज़ेतरी गल्‍ले मंऐं बिधाता सेटा अरज़ किई, बिधाता लोल़ी ती तिंयां सदा आद डाही। तेऊ लोल़ी इज़राईली परज़ा अर तिन्‍नें राज़े धैल़ ज़ेही तिन्‍नां ज़रुरत पल़ी तेही मज़त किई। <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />तेखअ लागणअ त संसारै सोभी देशा का थोघ कि बिधाता ई आसा एक्‍कै असली दी परमेशर, तेऊ छ़ाडी निं होर कोहै आथी। <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />तम्हैं तेऊए परज़ा बी लोल़ी त सदा म्हारै परमेशर बिधातो बधान अर तेते सोभी बिधी सदा तिहै ई मंदै रहै ज़िहै आझ़ आसा।”<verse eid="1KI 8:61" /></para>
  <para style="s">बिधाते भबने पूज़</para>
  <para style="r">(<ref loc="2CH 7:4-10">2 इतिहास 7:4-10</ref>)</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62" />तेखअ किअ राज़ै सुलैमानै अर तिधी आऐ दै सोभी इज़राईली बिधाता लै मेल़-ज़ोल़ो बल़ीदान। <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />तिन्‍नैं किऐ तिधी बाई हज़ार बल्द, एक लाख बिह हज़ार रिठे हेल़्ही मेल़-ज़ोल़े बल़ीदान अर इहअ करै हुई भबने प्रतिष्ठा। <verse eid="1KI 8:63" /><verse number="64" style="v" sid="1KI 8:64" />तैहा ई धैल़ी किअ राज़ै सुलैमानै बिधाते भबना आजूए ताटीए बी प्रतिष्ठा। तेऊ किऐ तिधी खास्सै हूम, मेल़-ज़ोल़ अर नाज़ बल़ीदान अर च़र्बी हुई एतरी खास्सी कि भबना आजूए कांस्से बेदी दी निस्सी सह हूम करना लै अक्‍की। <verse eid="1KI 8:64" /><verse number="65" style="v" sid="1KI 8:65" />सुलैमान राज़ै अर सारी इज़राईली परज़ा मनाऊंअ भबने प्रतिष्ठा बाद साता धैल़ी तैणीं छ़ानींओ थैर। बिधाते तैहा जाचा लै आऐ उतरा बाखा हमात ज़ोता ओर्ही पछ़मा बाखा मिसर देशे सिऊंआं तैणींए खास्सै मणछ। <verse eid="1KI 8:65" /><verse number="66" style="v" sid="1KI 8:66" />तेखअ छ़ाडै सुलैमानै आठुई धैल़ी<note caller="+" style="f"><char style="fr" closed="false">8:66 </char><char style="fq" closed="false">आठुई धैल़ी </char><char style="ft" closed="false">साता धैल़ी छ़ानींए थैरा मनाऊंणै बाद</char></note> सोभ लोग आपणैं-आपणैं घअरा लै। तिंयां लागै राज़े सर्राफी करदै संघा डेऊऐ खुशी-खुशी घअरा लै। किल्हैकि बिधाता दैनी आपणैं दास दाबेद अर इज़राईली परज़ा लै खास्सी बर्गत।<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s">बिधाता आअ भिई राज़ै सुलैमाने सुपनै</para>
  <para style="r">(<ref loc="2CH 7:11-22">2 इतिहास 7:11-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1" />राज़अ सुलैमान मुक्‍कअ त बिधाता लै भबन अर आप्पू लै मैहल बणाईं, होर बी ज़िहअ सह च़ाहा थिअ, तेता बी मुक्‍कअ सह बणाईं। <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />तेखअ हुअ बादा का इहअ कि बिधाता किई सुलैमाना संघै भिई सुपनै गल्‍ला ज़ेही तेऊ संघै बिधाता गबोन सुपनै गल्‍ला किई ती।<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="1KI 3:5">1 राज़. 3:5</ref>; <ref loc="2CH 1:7">2 इति. 1:7</ref></char></note> <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />बिधाता बोलअ तेऊ लै इहअ, “मंऐं शूणीं तेरी अरज़ अर सह बी कि तूह किज़ै च़ाहा कि हुंह करूं। ज़ुंण तंऐं मुल्है अह भबन बणाअं, अह ज़ैगा छ़ांटी मंऐं सदा लै ज़िधी सदा मेरी पूज़ा-गाज़ा होए। इधी रहणअ हुंह कबल्‍लअ भाल़अ लागी। <verse eid="1KI 9:3" /><verse number="4" style="v" sid="1KI 9:4" />ज़ै तूह आपणैं बाब दाबेदा ज़िहअ शुचअ-पाक्‍कअ रही मेरी च़ाकरी करे अर ज़ै तूह मेरअ बधान अर तेते सोभी बिधी मने, <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />तै हणीं मेरी सह ज़बान पूरी ज़ुंण मंऐं तेरै बाब दाबेदा लै बोलअ त कि तेरी आद-लुआदा मांझ़ै हणअ एक ज़ण्हअ इज़राईला दी सदा राज़अ।<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="1KI 2:4">1 राज़. 2:4</ref></char></note><verse eid="1KI 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 9:6" />“पर ज़ै तूह कि तेरै आद-लुआद मेरै हुकम नांईं मने अर होरी देअआ पूज़दै लागे, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />तेखअ निं हुंह आपणीं परज़ा इज़राईली तैहा ज़ैगा रहणैं दैंदअ ज़ुंण मंऐं तिन्‍नां लै दैनी ती। तेखअ अह भबन ज़ुंण मंऐं आपणीं पूज़ा करना लै मनअ, एथ बी लागणै बाण-भेखल़। तेखअ हणैं इज़राईली होरी देशा लै हास्सणां अर सुहांगा लै। <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />तेखअ रहणीं एऊ भबनै सिधी पात्थरे डिंगरी! एसी बाती एछदै नांहंदै लागणअ एता भाल़ी प्राच अर तिंयां हणैं रहैन संघा बोल़णअ, ‘एऊ देशा अर एऊ भबना संघै बिधाता इहअ किल्है किअ?’<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="2KI 25:9">2 राज़. 25:9</ref>; <ref loc="2CH 36:19">2 इति. 36:19</ref></char></note> <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />तेखअ बोल़णअ होरी लोगा इहअ, ‘इज़राईली मणछै छ़ाडअ आपणअ परमेशर बिधाता मनणअ ज़ुंणीं तिंयां मिसर देशा का काढी आणै तै! ऐबै लागै तिंयां होरी देअआ पूज़दै। तैही पाई बिधाता ईंयां सोभै खरी तिन्‍नां लै।’”<verse eid="1KI 9:9" /></para>
  <para style="s">सुलैमाने हिरामा संघै करार</para>
  <para style="r">(<ref loc="2CH 8:1">2 इतिहास 8:1</ref>,<ref loc="2CH 8:2">2</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10" />राज़ै सुलैमाना लागी बिधाता लै भबन अर आप्पू लै मैहल बणाणां लै कोई बिह साला। <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />सूर देशे राज़ै हिरामै दैनै तै सुलैमाना लै ज़ेतरै तेऊ लोल़ी तेतरै कैली अर केल़ुईए काठ अर सुन्‍नअ। ज़ांऊं सारअ काम मुक्‍कअ, राज़ै सुलैमानै दैनै हिरामा लै गलील मुल्खे बिह नगरी। <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />हिराम पुजअ सूर देशा का तिधी संघा भाल़ी तिंयां नगरी अर तेऊ निं सुलैमानै दैनी दी तिंयां नगरी गम्मी आथी। <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />राज़ै हिरामै बोलअ राज़ै सुलैमाना लै, “सुलैमान, मेरै साथीआ, लै तंऐं मुल्है ईंयां नगरी दैनी!” हिरामै डाहअ तिन्‍नां नगरी नाअं काबूल कि ईंयां आसा बृथा। अह नाअं आसा आझ़ तैणीं बी पल़अ द। <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />हिरामै दैनअ राज़ै सुलैमाना लै कोई च़ाल़्ही कुंटल़ सुन्‍नअ।<verse eid="1KI 9:14" /></para>
  <para style="s">सुलैमाने होर काम</para>
  <para style="r">(<ref loc="2CH 8:3-18">2 इतिहास 8:3-18</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15" />ज़ांऊं सुलैमान बिधाता लै भबन अर राज़ मैहलो सारअ काम करी मुक्‍कअ, तेखअ ज़ेतरै बी राज़े बेठी खटणै आल़ै लोग थिऐ, तिंयां डाहै तेऊ भबन अर एरुशलेम नगरी फेर गहल़ा च़िणदै लाई। तेखअ च़िणीं तेऊ हसोर, मगिदो अर गज़ेर नगरी। <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />पैहलै हुअ त इहअ कि गज़ेर नगरी गिम्मी ती मिसर देशे माहा राज़ै, तेऊ चैल़ी ती सारी नगरी दी आग संघा पाऐ तै तिधी रहणैं आल़ै कनानी लोग मारी। बादा का ज़ांऊं तेऊए शोहरीओ बैह राज़ै सुलैमाना संघै हुअ, तेखअ दैनी तेऊ सह नगरी आपणीं शोहरी लै। <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />सुलैमानै च़िणीं गज़ेर नगरी भिई। उंधलै बेथ-हारोन नगरी बी डाहै तेऊ आपणैं बेठू भिई च़िणदै लाई। <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />यहूदा रेगीस्तानै बालात अर तदमोर नगरी, <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />ज़ेतरी नगरी दी सुलैमाने ज़िणसीए भढार अर रथ-घोल़ै थिऐ, तिंयां नगरी बी च़िणीं तेऊ भिई। एरुशलेम, लाबानोन अर ज़ेतरी बी नगरी दी तेऊओ राज़ त, तिंयां नगरी किई सुलैमानै ज़िहअ सह च़ाहा त तेही पाक्‍की। <verse eid="1KI 9:19" /><verse number="20-21" style="v" sid="1KI 9:20-21" />सुलैमान राज़े बेठू तै तिंयां ज़ुंण तिन्‍नां कनानी लोगे आजू आद-लुआद ज़ुंण इज़राईली कनान देशे ज़ैगा गिम्मदी बारी ज़िऊंदै छ़ाडै तै। तिंयां थिऐ अमोरी, हित्ती, परिजी, हिब्बी, जबेशी। ईंयां लोग आसा आझ़ तैणीं<note caller="+" style="f"><char style="fr" closed="false">9:20-21 </char><char style="fq" closed="false">आझ़ तैणीं </char><char style="ft" closed="false">ज़धू अह कताब लिखी, तधू तैणीं</char></note> बी इज़राईलीए गलाम। <verse eid="1KI 9:20-21" /><verse number="22" style="v" sid="1KI 9:22" />पर इज़राईली मांझ़ै निं सुलैमानै कोहै गलाम बणाअं, इज़राईली हआ तै तेऊए कार-करिंदै, सैना दी, सैनापति अर रथ अर घोल़ै शुंआरीए दलपति।<verse eid="1KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 9:23" />बेठू प्रैंदै कामां कराऊंणै आल़ै अफसर थिऐ पांज़ शौ पज़ाह ज़ण्हैं, ज़ुंण सुलैमाने ज़ैगै-ज़ैगै कामां भाल़ै हआ तै।<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />सुलैमाने राणीं ज़ुंण मिसर देशे माहा राज़ेए देई थिई, सह आई दाबेदपूरा का तेऊ नऊंऐं मैहला लै ज़ुंण सुलैमानै बणाअं त। तेखअ डाहअ पुर्बा बाखा नगरी दी कोट च़िणीं।<verse eid="1KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25" />सुलैमानै बिधाता लै ज़ुंण बेदी ती बणाईं दी, तेथ करा त सह हर साल चिई बारी बिधाता लै हूम अर मेल़-ज़ोल़ो बल़ीदान करी अर बिधाता लै धूप ज़ाल़ी। इहअ करै छ़ेक्‍कअ तेऊ बिधातो भबन बणाईं।<note caller="-" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="EXO 23:17">लुआ. 23:17</ref>; <ref loc="EXO 34:23">34:23</ref>; <ref loc="DEU 16:16">बधा. 16:16</ref></char></note><verse eid="1KI 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26" />एदोम मुल्खै एलात नगरी नेल़ लाल समुंदरे बाढै एजोन-गेबर बणाऐं राज़ै सुलैमानै पाणींए खास्सै ज़हाज़ बी। <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />तिन्‍नां ज़हाज़ा दी छ़ाडै राज़ै हिरामै आपणैं ज़ाण-प्रबीण सपाही सुलैमाने आदमी संघै काम करदै। <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />तिंयां डेऊए ओपीर नगरी अर तिधा का आणअ तिन्‍नैं एक शौ शाठ कुंटल़ सुन्‍नअ राज़ै सुलैमाना लै।<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s">शेबा देशे राणीं पुजी राज़ै सुलैमाना सेटा मिलदी</para>
  <para style="r">(<ref loc="2CH 9:1-12">2 इतिहास 9:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:42">मोत्त. 12:42</ref>; <ref loc="LUK 11:31">लूक. 11:31</ref></char>
    </note>शेबा नगरीए राणीं शूणीं बिधाते बारै राज़ै सुलैमाने मशूरी, सह आई एरुशलेम नगरी लै सुलैमाना का कठण सुआला पुछ़दी कि तेऊ परखे। <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />तैहा आणअ आप्पू संघै आपणैं कार-करिंदैओ बडअ दल एरुशलेम नगरी लै। सुलैमाना लै आणै तैहा किम्मती मणीं, सुन्‍नैं अर कई रंगे खुशबूदार मसालै ऊँट लादी भैंट। सुलैमाना सेटा पुजी लागी सह तिन्‍नां सुआला पुछ़दी ज़ुंण तैहा सोठी तै डाहै दै। <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />राज़ै सुलैमानै दैनअ तेसे सोभी सुआलो ज़बाब, एही निं किज़ै गल्‍ल ई रही ज़ुंण सुलैमान तैहा का खोज़ी निं सकअ।<verse eid="1KI 10:3" /></para>
  <para style="p">
    <verse number="4-5" style="v" sid="1KI 10:4-5" />शेबा नगरीए राणीं हुई राज़ै सुलैमाने अक्ल भाल़ी रहैन। ज़ांऊं तैहा सुलैमानो मैहल, तेऊए पलगा दी खाणअ-पिणअ अर तेऊए कार-करिंदै किहै बेठा, तेऊए दास-दासी किहै झिकल़ै बान्हीं हआ खल़ै, तेऊए मैहलै रोटी-पाणीं खैऊंणैं-पणैऊंणै आल़ैओ किहअ सूल आसा अर राज़अ सुलैमान बिधाते भबना लै डेऊई किहै हूम अर बल़ीदान करा करी, सह हुई इना सोभी गल्‍ला भाल़ी हक्‍की-बक्‍की। <verse eid="1KI 10:4-5" /><verse number="6" style="v" sid="1KI 10:6" />तैहा बोलअ राज़ै सुलैमाना लै, “ज़िहअ मंऐं आपणैं देशै तेरै अर तेरी अक्लीए बारै शूणअ त, तूह आसा असली दी तिहअ ई। <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />पर ज़ांऊं तैणीं मंऐं इधी एछी आपणीं आछी निं भाल़अ, तेभै तैणीं निं मुंह विश्वास हुअ। मुखा निं एते आधी गल्‍ले बारै बी थोघ आथी त। ज़ेतरअ मुखा खोज़अ त, तूह आसा तेता का कई गुणा खास्सअ अक्ली आल़अ अर सेठ। <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />तेरी राणीं भाल़ केही भागा आल़ी आसा! अर किहै भागा आल़ै आसा तेरै दास-दासी ज़ुंण कबल्‍लै ताह सेटा रहा अर तेरी अक्लीए गल्‍ला शूणां। <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />तेरै परमेशर बिधाते लोल़ी ज़ै-ज़ैकार हुई, सह आसा ताल्है खुश अर तेऊ बणाअं तूह इज़राईल देशो राज़अ। किल्हैकि इज़राईला लै तेऊए झ़ूरी आसा अटल़। तूह बणाअं तेऊ तिन्‍नां प्रैंदै एते तैणीं राज़अ कि धर्म अर नसाफ बणी रहे।”<verse eid="1KI 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10" />शेबा नगरीए राणीं दैनअ राज़ै सुलैमाना लै पज़ाह कुंटल़ सुन्‍नअ, खास्सी किम्मती मणीं, खास्सै खुशबूदार किम्मती मसालै। एतरी च़िज़ा भैंट निं इज़राईला लै कधि भैंट दैनी ती।<verse eid="1KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11" />राज़ै हिरामे ज़हाज़ बी ज़ुंण ओपीर नगरी का सुन्‍नअ आणा तै, तिन्‍नैं बी आणअ खास्सअ सुन्‍नअ, च़ंदन नाओंए बूटे किम्मती काठ अर खास्सी किम्मती मणीं। <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />च़ंदने काठा करै बणाऐं राज़ै सुलैमानै बिधाते भबन अर राज़ दरबारा लै शिहल़ी, गिहा बोल़णैं आल़ै लै बींन, अर तारा आल़ै साज़-बाज़। इहै च़ंदने काठ बी निं आझ़ तैणीं इज़राईले राज़ै लै कोही दैनै तै, नां कुंणी तधा बाद दैनै अर नां कुंणी भाल़ै।<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />शेबा देशे राणीं दैनी होर बी ज़िहअ राज़ै सुलैमानै च़ाहअ तेही भैंट अर राज़ै सुलैमानै बी दैनअ तैहा लै तिहअ ई ज़िहअ सह च़ाहा ती। तेखअ डेऊऐ सह अर तेसे कार-करिंदैओ सारअ दल आपणैं देशा लै फिरी।<verse eid="1KI 10:13" /></para>
  <para style="s">राज़ै सुलैमानो बल अर ज़ैदात</para>
  <para style="r">(<ref loc="2CH 9:13-29">2 इतिहास 9:13-29</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14" />हर साल एछा त राज़ै सुलैमाना सेटा लै दूई शौ पज़ाह कुंटल़ सुन्‍नअ, <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />बपारी का कारअ, अरब देशे राज़ै का कारअ अर आपणैं इज़राईल देशे राज़पाला का कारअ एछा त एता का लाऊआ।<verse eid="1KI 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 10:16" />राज़ै सुलैमानै ती सुन्‍नअ गाल़ी करै दूई शौ बडी-बडी ढाल़ा बणाईं दी, एकी-एकी ढाल़ा दी थिअ कोई सात-सात किलू सुन्‍नअ लाअ द। <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />तेही ई बणाईं तेऊ चअन शौ होर ढाल़ा अर तेथ त एकी-एकी ढाल़ा दी कोई दूई-दूई किलू सुन्‍नअ लाअ द। तिंयां ढाल़ा ती तेऊ आपणैं मैहलै अर लाबानोन बणां नाओंए मैहलै डाही दी।<verse eid="1KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 10:18" />आप्पू लै ती तेऊ हाथी दांदे राज़गाद्दी बणाईं दी अर सह थिई च़ोखै सुन्‍नैं करै महल़ी दी। <verse eid="1KI 10:18" /><verse number="19-20" style="v" sid="1KI 10:19-20" />राज़गाद्दीओ कठैम्ह त प्रैंदा का गोल़ बल्दे मुंहां ज़िहअ अर दोहरी बाखा तै बाहा टकैल़णा लै ढासणैं लाऐ दै अर तेथ थिऐ दोहरी बाखा सिहा ज़िहै मुंह। राज़गाद्दी लै थिई तोल़ा बाखा उझै छ़ह पैल़ी अर हर पैल़ी दी थिऐ दोहरी बाखा बाढै सिहा ज़िहै मुंह काढै दै पठी बारा सिह। एही राज़गाद्दी निं सारै संसारै किधी आथी त।<verse eid="1KI 10:19-20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 10:21" />राज़ै सुलैमाने झुटणें भांडै बी थिऐ च़ोखै सुन्‍नैं करै बणाऐं दै। लाबानोन बणां नाओंए मैहलै डाहै दै सोभै भांडै बी थिऐ सोभै च़ोखै सुन्‍नें। तेथ निं च़ंदीओ एक बी भांडअ आथी त। राज़ै सुलैमाने ज़मानैं निं च़ंदीओ किज़ै मोल ई समझ़दै तै। <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />राज़ै सुलैमानै थिऐ समुंदरे बपारा लै खास्सै ज़हाज़ डाहै दै। तिन्‍नां करा त सह राज़ै हिरामा संघै हर चिऊथी साला सुन्‍नैं, च़ंदी, हाथी दांद, गूणी-बांदर अर मोरा आणदै छ़ाडी।<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />राज़अ सुलैमान त संसारे सोभी राज़ै का खास्सअ सेठ अर अक्ली आल़अ। <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />सारै देशा का च़ाहा तै लोग तेऊ का सलाह लणी अर अक्ल शुणनी ज़ुंण तेऊ लै बिधाता आसा दैनी दी। <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />ज़ुंण बी राज़ै सुलैमाना सेटा एछा थिअ, सह आणा त तेऊ सेटा भैंट ज़रूर। हर साल एछा तै तेऊ सेटा दूरा-दूरा का लोग संघा आणा तै सुन्‍नअ, च़ंदी, किम्मती झिकल़ै, अस्त्र-शस्त्र, खुशबूदार मसालै, घोल़ै अर खच़रा लादी।<verse eid="1KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26" />राज़ै सुलैमाना का हुऐ च़ौदा शौ रथ, बारा हज़ार घोल़े शुंआरी। तिंयां थिऐ तेऊ एरुशलेम अर होरी नगरी दी डाहै दै।<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="1KI 4:26">1 राज़. 4:26</ref></char></note> <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />सुलैमाने राज़ा दी हुअ त एरुशलेम नगरी च़ंदीओ मोल केल़ुईए काठ अर पात्थर अर यहूदा मुल्खै निऊल़ै लागै दै आम डाल़-बूटे काठा बराबर।<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="DEU 17:17">बधा. 17:17</ref></char></note> <verse eid="1KI 10:27" /><verse number="28" style="v" sid="1KI 10:28" />राज़अ सुलैमान आणा त आप्पू लै घोल़ै मिसर देशा का। राज़े बपारी आणा तै तिन्‍नां ज़ेतरअ भाअ पाक्‍कअ हुअ किअ द तेते साबै छ़ूंढे-छ़ुंढ मोलै लई।<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:16">बधा. 17:16</ref></char></note> <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />एक रथ आणा तै तिंयां तेऊ ज़मानें छ़ह शौ च़ंदीए सिक्‍कै मिसर देशा का मोल दैई, अर घोल़ै लै दैआ तै तिंयां एक शौ पज़ाह च़ंदीए सिक्‍कै मोल। हित्ती अर सिरीया देशे राज़ै लै बी दैआ तै तिंयां बपारी एऊ ई मोलै।<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s">सुलैमानै पाअ बिधाता बिस्सरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />राज़अ सुलैमान लोभणूंअ होरी-होरी देशे खास्सी बेटल़ी लै। मिसर देशे माहा राज़ेए देई का लाऊआ किअ तेऊ हित्ती, मोआबी, अमोनी, एदोमी सदोनी खास्सी बेटल़ी संघै बैह।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="DEU 17:17">बधा. 17:17</ref></char></note> <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />सुलैमान झ़ूरअ तिन्‍नां ज़ातीए बेटल़ी लै संघा बैही तिन्‍नां जैंदरा का ज़हा लै बिधाता इहअ त बोलअ द, “इना लोगा जैंदरी निं डेऊई नां ईंयां तम्हां जैंदरी लोल़ी आऐ, किल्हैकि तिंयां सका तम्हां इज़राईली आपणैं देअ देबतै बाखा फरेऊई।”<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="EXO 34:16">लुआ. 34:16</ref>; <ref loc="DEU 7:3-4">बधा. 7:3-4</ref></char></note> <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />राज़ै सुलैमाने ती सात शौ राणीं अर तिन्‍नां का लाऊआ ती चअन शौ होर बेटल़ी डाही दी अर तिन्‍नैं पाअ सह बिधाता छ़ाडी कबाता, <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />ज़ांऊं सुलैमान प्रोढअ हुअ, तिन्‍नैं बेटल़ी पाअ सह आप्पू संघै आपणैं देअआ पूज़दअ। सुलैमान निं आपणैं बाब दाबेदा ज़िहअ बिधाता लै शुचअ-पाक्‍कअ रहअ। <verse eid="1KI 11:4" /><verse number="5" style="v" sid="1KI 11:5" />सह लागअ सदोनी लोगे अशतरोत देबी अर अमोनी लोगे च़िल़्हखरै मलकोम देअआ पूज़दअ! <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />इहअ करै किअ सुलैमानै सह ई काम ज़ेता का बिधाता नफरत करा त। सह निं बिधाता लै आपणैं बाब दाबेदा ज़िहअ शुचअ-पाक्‍कअ रहअ। <verse eid="1KI 11:6" /><verse number="7" style="v" sid="1KI 11:7" />सुलैमानै बणाईं एरुशलेम पुर्बा बाखा धारा मोआबी लोगे कमोश नाओंए च़िल़्हखरै देअआ अर अमोनी लोगे मोलक देअआ पूज़णा लै ज़ैगा। <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />ज़ुंण तेऊ देशा-देशा का आप्पू लै खास्सी बेटल़ी ती आणी दी, तिन्‍नां लै बी बणाईं तेऊ ज़ुदी-ज़ुदी ज़ैगा कि तिंयां आपणैं-आपणैं देअ-देबी लै धूप ज़ाल़ी अर बल़ीदान करे!<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9-10" style="v" sid="1KI 11:9-10" />इज़राईलो परमेशर बिधाता आअ त सुलैमाना लै दूई बारी सुपनै अर तेऊ हेरअ त तेऊ का बोली कि होरी देअआ पूज़दअ निं लागी। पर सुलैमानै निं बिधातो सह हुकम मनअ अर सह पेठअ तेऊ छ़ाडी कबाता। तैही आई तेखअ बिधाता तेऊ लै रोश्शै। <verse eid="1KI 11:9-10" /><verse number="11" style="v" sid="1KI 11:11" />तैही बोलअ बिधाता सुलैमाना लै इहअ, “ज़िहअ मंऐं ताल्है बोलअ त, तंऐं निं तिहअ किअ! तंऐं किअ आपणीं मन्‍न-मरज़ीओ काम! ऐबै लाअ मंऐं ताखा राज़ दूर करी अर सह दैणअ मुंह तेरै कार-करिंदै मांझ़ै ई कहा एक ज़ण्हैं लै। <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />पर तेरै बाब दाबेदा पिछ़ू निं हुंह तेरी ज़िऊंदी ज़िता ताखा राज़ दूर करदअ, आजू तेरै शोहरू का छ़ड़ैऊंणअ मुंह राज़ ज़रूर। <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />तज़ी बी निं मुंह तेरै शोहरूओ सारअ राज़-पाठ खतम करनअ, सह डाहणअ मुंह आपणैं दास दाबेद, एकी गोत्रो<note caller="+" style="f"><char style="fr" closed="false">11:13 </char><char style="fq" closed="false">एकी गोत्रो </char><char style="ft" closed="false">यहूदा</char></note> राज़अ डाहणअ मुंह सह बणाईं किल्हैकि हुंह निं आपणैं दास दाबेदा अर मंऐं आप्पू लै छ़ांटी दी एरुशलेम नगरी बिस्सरुअ आथी।”<verse eid="1KI 11:13" /></para>
  <para style="s">सुलैमाने दुशमण</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14" />एदोम मुल्खै थिअ राज़े खिंबा का हदाद, सह बणाअं बिधाता राज़ै सुलैमानो दुशमण। <verse eid="1KI 11:14" /><verse number="15-16" style="v" sid="1KI 11:15-16" />एता का खास्सी साला पैहलै ज़धू राज़ै दाबेदै एदोम मुल्खै कबज़अ किअ त। दाबेदो सैनापति डेऊअ तिधा लै तिन्‍नां दाबदअ ज़ुंण जुधा दी मारै तै। जोआब अर तेऊ संघै इज़राईली सैना रही तिधी छ़हा भिन्‍नैं तैणीं अर तेतरै धैल़ै पाऐ तै तिन्‍नैं तिधी बस्सै सोभ मर्ध अर शोहरू मारी। <verse eid="1KI 11:15-16" /><verse number="17" style="v" sid="1KI 11:17" />हदाद त तधू होछ़अ ज़िहअ शोहरू अर तेऊए बाबे एदोमी दास ठुर्है तिधा का मिसर देशा लै अर सह शोहरू बी निंयं तिन्‍नैं संघा बच़ाऊई। <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />तिंयां डेऊऐ मिद्यान देशा बाती परान तैणीं अर तिधी ज़ुल़ै तिन्‍नां संघै होर बी आदमी संघा पुजै किहअ करै मिसर देशे माहा राज़ै सेटा। तेऊ दैनी हदादा रहणा लै धख ज़ेही ज़िम्मीं, घअर अर तिन्‍नां लै ज़िणस। <verse eid="1KI 11:18" /><verse number="19" style="v" sid="1KI 11:19" />बादा का हुई मिसर देशे राज़ै अर हदादे पाक्‍की साथ अर माहा राज़ै किअ आपणीं साल़ीओ बैह हदादा संघै ज़ुंण तेऊए राणीं तपनेसे च़ेई थिई। <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />तेखअ हुअ तिन्‍नों एक शोहरू अर तेऊ नाअं डाहअ तिन्‍नैं गनूबत। तेऊओ च़ूई चल़ाऊई तपनेस राणींए मैहलै अर तिधी लागअ सह मिसर देशे माहा राज़ेए होरी शोहरू संघै रहंदअ।<verse eid="1KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21" />ज़ांऊं अह खबर मिसर देशै माहा राज़ै हदादा सेटा पुजी कि राज़अ दाबेद, तेऊओ सैनापति जोआब गअ त मरी, तेखअ बोलअ हदादै मिसर देशे माहा राज़ै का, “तूह दै मुल्है मेरै आपणैं देशा लै डेऊणे ज़ाज़त।”<verse eid="1KI 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 11:22" />माहा राज़ै पुछ़अ तेऊ का, “तूह किल्है च़ाल्‍लअ? इहअ किज़ै आसा ज़ुंण हुंह ताल्है दैई निं सकअ?”</para>
  <para style="p" vid="1KI 11:22">हदादै बोलअ, “इहअ निं किछ़ै, तूह दै मुंह डेऊणैं।” तेखअ डेऊअ हदाद आपणैं मुल्खा लै फिरी।</para>
  <para style="p" vid="1KI 11:22">एदोम मुल्खो राज़अ रही त हदाद बेघै बूरअ अर इज़राईलो खास्सअ दुशमण।<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />तेखअ बणाअं परमेशरै एल्यादो शोहरू रजोन सुलैमानो दुशमण। रजोन त आपणैं मालक सोबा नगरीए राज़ै हदादेज़ेरा सेटा का ठुर्हअ द। <verse eid="1KI 11:23" /><verse number="24-25" style="v" sid="1KI 11:24-25" />ज़धू दाबेद राज़ै हदादेज़ेरे सैना का ज़ितअ त, तेता बाद बणाअं रजोनै आपणअ एक छ़ुंढ अर आप्पू बणअ तिन्‍नों दलपति। तेखअ डेऊऐ रजोन अर तेऊए सैना दमिश्क नगरी लै अर तिधी बणअ सह सिरीया देशो राज़अ अर इज़राईलो पाक्‍कअ दुशमण। इहअ करै तै हदाद अर रजोन दुहै इज़राईले दुशमण ज़धू सुलैमान इज़राईला दी राज़अ थिअ। तिन्‍नैं दुही पाई सुलैमाना लै आफ़ता प्रैंदै आफ़त।<verse eid="1KI 11:24-25" /></para>
  <para style="s">जरोबामा संघै बिधाते करार</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26" />एक होर मणछ बी हुअ राज़ै सुलैमाने खलाफ, सह थिअ तेऊए ई कार करिंदै मांझ़ै सरूयाह नाओंए बिधबो शोहरू जरोबाम। तेऊए बाबा नाअं त नबात ज़ुंण एप्रैम गोत्रा का सारतान नगरीओ थिअ। <verse eid="1KI 11:26" /><verse number="27" style="v" sid="1KI 11:27" />सह हुअ राज़ै सुलैमाने खलाफ इहअ करै कि राज़अ सुलैमान त लागअ द एरुशलेम पुर्बा बाखा दाबेदपूर गहल़ा बणाऊंदअ अर नगरी फेर-फिरदै गहल़ा स्केरदअ लागअ द। <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />जरोबाम त ज़ोर-ज़ाहणा आल़अ ज़ुआन शोहरू। राज़ै सुलैमानै भाल़अ कि अह शोहरू आसा खास्सअ मैन्थी। तेऊ डाही तेऊ का युसुफे खिंबे मनिश्शे अर एप्रैम गोत्रे मुल्खै सोभी बेठूए ज़िम्मैंबारी सभाल़ी।<verse eid="1KI 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29" />एकी धैल़ै हुअ इहअ कि जरोबाम त एरुशलेम नगरी का डेऊंदअ लागअ द। तेऊ भेटअ बाता शिलोह नगरीओ आहिजा गूर, तिंयां दुहै तै किधी दहल़ै कल्ही। <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />आहिजा खोल्हअ नऊंअ च़ोल़अ पोर्ही ज़ुंण तेऊ बान्हअ द थिअ संघा बणाऐं तेता धेल़ी करै बारा शाट्टै, <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />तेखअ बोलअ तेऊ जरोबामा लै, “एता मांझ़ै निंऊं तूह दस शाट्टै आप्पू लै, किल्हैकि इज़राईलो परमेशर बिधाता बोला ताल्है इहअ, ‘मंऐं लाअ सुलैमाना का राज़ पोर्ही छ़ड़ैऊई अर बारा मांझ़ै दसा गोत्रा प्रैंदै लाअ तूह राज़अ बणाईं। <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />पर आपणैं दास दाबेद अर एरुशलेम नगरी ज़ुंण मंऐं आप्पू लै आसा छ़ांटी दी, तेता पिछ़ू लाअ मंऐं इज़राईली मांझ़ै एकी गोत्रा प्रैंदै सुलैमाना लै राज़ अज़ी बी डाही। <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />इहअ लाअ मंऐं तै करी कि सुलैमानै हेरअ हुंह छ़ाडी अर सह लागअ सदोन देशे अशतरोत देबी, मोआबीए देअआ कमोश, अमोनी लोगे मलकोम देअआ पूज़दअ। ऐबै निं सुलैमान मेरअ हुकम मंदअ! तेऊ किअ बेघै बूरअ अर तेऊ निं मेरअ बधान अर बिधी तेही मनी ज़िहअ तेऊओ बाब दाबेद करा त।<verse eid="1KI 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 11:34" />“‘पर सारअ राज़ निं मुंह सुलैमाना का दूर करनअ अर तेऊए ज़िऊंदी ज़िता रहणअ सह सोभी इज़राईली प्रैंदै राज़अ। किल्हैकि तेऊओ बाब मेरअ दास दाबेद ज़ुंण मंऐं राज़अ छ़ांटअ थिअ, सह मना त मेरअ बधान अर तेते सोभ बिधी पठी। <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />पर तेऊए शोहरू का करनअ मुंह इज़राईलो राज़ दूर संघा बणाणअं बारा मांझ़ै दस गोत्रा प्रैंदै तूह राज़अ। <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />सुलैमाने शोहरू लै दैणअ मुंह एकी गोत्रा प्रैंदै ज़रूर राज़ ताकि मेरै दास दाबेदे आद-लुआदा मांझ़ै कुंण नां कुंण एरुशलेम नगरी राज़ करे ज़ुंण नगरी मंऐं आप्पू लै आसा छ़ांटी दी कि इधी एछी सोभ मुंह सेटा माथअ टेक्‍के। <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />जरोबाम, मुंह बणाणअं तूह इज़राईलो राज़अ अर तूह करै सारै इज़राईला प्रैंदै ज़िहअ तूह च़ाहा तिहअ राज़। <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />ज़ै तूह मेरै दास दाबेदा ज़िहअ मेरी शुणें, तै करनीं मुंह तेरी मज़त। ज़ै तूह ज़िहअ हुंह बोले तिहअ ई करे ज़िहअ मेरअ दास दाबेद करा थिअ, तै डाहणअ मुंह तेरी आद-लुआदा मांझ़ै कुंण नां कुंण इज़राईला प्रैंदै राज़अ। यहूदा मुल्खै हणअ दाबेदे आद-लुआदो राज़ अर इज़राईल मुल्खै हणअ तेरी आद-लुआदो राज़ पोस्ती दर पोस्ती। <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />सुलैमाने पाप करनै पिछ़ू लागणीं दाबेदे आद-लुआदा सज़ा भुगतणी पर सदा लै दुख निं हुंह तिन्‍नां लै दैंदअ।’”<verse eid="1KI 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 11:40" />सुलैमानै किई जरोबामा मारने बी कोशिश पर जरोबाम निखल़अ बच़ी संघा ठुर्हअ मिसर देशे राज़ै शिशका सेटा लै संघा रहअ सुलैमाना मरनै तैणीं तिधी।<verse eid="1KI 11:40" /></para>
  <para style="s">राज़ै सुलैमाने मौत</para>
  <para style="r">(<ref loc="2CH 9:29-31">2 इतिहास 9:29-31</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41" />सुलैमाने होर सोभै गल्‍ला ज़ुंण तेऊ राज़ै रहंदी किअ, तेऊए अक्लीए गल्‍ला, आसा सोभै सुलैमाने इतिहास नाओंए कताबा दी लिखी डाही दी। <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />राज़ै सुलैमानै किअ एरुशलेम नगरी का सारै इज़राईला प्रैंदै च़ाल़्ही साला तैणीं राज़। <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />खिरी मूंअ सह संघा डाहअ दाबेदपूर नगरी दाबी अर आजू बेठअ तेऊओ शोहरू रहबाम तेऊए ज़ैगा राज़अ।<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s">उतरा बाखा बस्सै दै इज़राईलीओ द्रोह</para>
  <para style="r">(<ref loc="2CH 10:1-19">2 इतिहास 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />रहबाम डेऊअ शकेम नगरी, तिधी त सोभी इज़राईली तेऊ राज़ै बणाणां लै झाल़अ किअ द। <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />नबातो शोहरू जरोबाम थिअ राज़ै सुलैमाने डरै ठुर्ही मिसर देशे राज़ै सेटा रहंदअ लागअ द। ज़ांऊं तेऊ का थोघ लागअ कि इहअ-इहअ हुअ, सह आअ मिसर देशा का फिरी। <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />पर उतरा बाखा बस्सै दै इज़राईली गोत्रै शादअ जरोबाम अर तेखअ डेऊऐ तिंयां जरोबामा संघा निंईं रहबामा सेटा। तिन्‍नैं बोलअ रहबामा लै, <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />“तेरै बाब राज़ै सुलैमानै डाहै हाम्हैं मारी-मारी कामां लाई अर कारै दैणैंओ बोझ़ बी पाअ हाम्हां लै बेघै खास्सअ। ज़ै तूह म्हारै एऊ बोझ़ा हल़कअ करे अर म्हारअ ज़िऊंणअ बी सान करे, तै आसा हाम्हैं मानदारी संघै तेरी च़ाकरी करना लै मज़ूर।”<verse eid="1KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5" />रहबामै दैनअ ज़बाब, “मुंह दैआ सोठी लणैं, तम्हैं लोल़ी चिई धैल़ै बाद मुंह सेटा भिई आऐ, तेखअ खोज़ूं हुंह तम्हां का आपणअ ज़बाब।”<verse eid="1KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6" />राज़ै रहबामै लई तिन्‍नां सैणैं-प्रोढै का सलाह ज़ुंण तेऊए बाब सुलैमाना संघै सारी अमरा रहै, “तम्हैं दैआ मुल्है ओर्ही सलाह कि हुंह परज़ा लै किज़ै ज़बाब दैंऊं?”<verse eid="1KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7" />तिन्‍नैं दैनअ रहबामा लै ज़बाब, “ज़ै तूह इहअ च़ाहा कि परज़ा तेरी शुणें, तै कर तिन्‍नां संघै भली गल्‍ला अर तिन्‍नों बोझ़ हल़कअ करी कर तिन्‍नां खुश, तिहअ करै रहणैं तिंयां सदा तेरै गलाम।”<verse eid="1KI 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8" />रहबामै किई सैणैं-प्रोढे सलाह शूणीं नां शूणीं अर सह डेऊअ तेखअ तिन्‍नां आपणीं सुआल़ीए खारकै मणछा का सलाह पुछ़दअ ज़ुंण तेऊ संघै होछ़ी उझै रहा तै। <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />रहबामै पुछ़अ तिन्‍नां का, “परज़ा बोला मुल्है तिन्‍नों बोझ़ हल़कअ करना लै, तम्हैं मुल्है एते बारै किज़ै सलाह दैआ कि हुंह किज़ै करूं?”<verse eid="1KI 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 12:10" />तिन्‍नैं दैनअ तेऊ लै ज़बाब, “तूह बोलै तिन्‍नां लै इहअ, ‘मेरी कान्हीं गुंठी आसा मेरै बाबै कुछी का बी मोट्टी, ज़ै तम्हां मेरै बाबो खास्सअ बोझ़ समझ़ा, तै लागा आजू तम्हैं भाल़ै कि मुंह किज़ै करनअ!’ <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />तिन्‍नां लै बोलै, ‘मेरै बाबै पाअ तम्हां लै खास्सअ बोझ़, मुंह पाणअ तम्हां लै तेता का बी खास्सअ। तेऊ च़िक्‍कै तम्हैं कोल़ै करै, मुंह क्रिंज़णै तम्हैं लोहे तिछै बिंच़ू करै।’”<verse eid="1KI 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12" />ज़ेही गल्‍ल हुई ती, तिहै ई गऐ चिऐ धैल़ै बाद जरोबाम अर होर इज़राईली राज़ै रहबामा सेटा पुजी। <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />राज़ै रहबामै निं सैणैं-प्रोढे सलाह दी धैन दैनअ अर तेऊ दैनअ तिन्‍नां लै काठअ ज़बाब, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />ज़ेही तेऊ लै खारकै मणछै सलाह दैनी तेऊ दैनअ परज़ा लै तिहअ ई ज़बाब, “मेरै बाबै पाअ तम्हां लै खास्सअ बोझ़, पर मुंह पाणअ तम्हां लै तेता का बी खास्सअ। तेऊ च़िक्‍कै तम्हैं कोल़ै करै, मुंह क्रिंज़णै तम्हैं लोहे तिछै बिंच़ू करै!” <verse eid="1KI 12:14" /><verse number="15" style="v" sid="1KI 12:15" />राज़ै रहबामै निं परज़े गल्‍ल मनी अर इहअ करै किई बिधाता सह गल्‍ल पूरी ज़ुंण शिलोह नगरीए आहिजा गूरै नबाते शोहरू जरोबामा का बोली ती।<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="2SA 20:1">2 शमू. 20:1</ref></char></note><verse eid="1KI 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16" />ज़ांऊं सोभी इज़राईली का ज़ाण्हुंअ कि राज़अ निस्सअ तिन्‍नें एक बी गल्‍ल शूणीं, तिंयां लागै बोल्दै, “ईशैईए शोहरू दाबेद अर तेऊए खिंबा का हआ ज़ुदै! इनै हाम्हां लै आझ़ तैणीं किअ किज़ै? इज़राईलीओ, आपणैं-आपणैं घअरा लै च़ाल्‍ला! रहबाम करो ऐबै आपणैं लोगा प्रैंदै राज़!”<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="2SA 20:1">2 शमू. 20:1</ref></char></note></para>
  <para style="p" vid="1KI 12:16">इहअ करै किअ इज़राईली रहबामा लै द्रोह, <verse eid="1KI 12:16" /><verse number="17" style="v" sid="1KI 12:17" />रहबाम डाहअ तिन्‍नैं सिधअ तिन्‍नां मणछा प्रैंदै राज़अ ज़ुंण यहूदा मुल्खै रहा तै।<verse eid="1KI 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 12:18" />तेखअ छ़ाडअ राज़ै रहबामै अदोराम ज़ुंण सोभी बेठू प्रैंदै सैणअ आसा कि इज़राईली संघै गल्‍ला करे। पर तिन्‍नैं दैनअ तेऊ लै पात्थरो ढो संघा पाअ सह मारी। तेखअ ठुर्हअ रहबाम छ़ेक्‍कै-छ़ेक्‍कै आपणैं रथा प्रैंदै बेशी एरुशलेम नगरी लै। <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />इहअ करै हुऐ उतरा बाखा बस्सै दै इज़राईली दखणा बाखा यहूदा बस्सै दै राज़ै दाबेदे खिंबा का दूर अर तिंयां आसा आझ़ तैणीं बी इहै ई।<verse eid="1KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20" />ज़ांऊं सोभी इज़राईली का थोघ लागअ कि जरोबाम आसा गअ द मिसर देशा का फिरी एछी, तिन्‍नैं किअ बडअ झाल़अ संघा तेथ शादअ सह बी तेखअ बणाअं तिन्‍नैं इज़राईलीओ राज़अ। राज़ै दाबेदे आद-लुआदा संघै रहै सिधै यहूदा गोत्रे लोग।<verse eid="1KI 12:20" /></para>
  <para style="s">शमयाह गूरै खोज़अ बिधातो समाद</para>
  <para style="r">(<ref loc="2CH 11:1-4">2 इतिहास 11:1-4</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21" />ज़ांऊं सुलैमानो शोहरू राज़अ रहबाम एरुशलेम पुजअ, तेऊ झाल़ै यहूदा अर बिन्यामीन गोत्रा का एक लाख अश्शी हज़ार सपाही ज़ुंण सोभी का राम्बल़ै जोधै थिऐ। तेऊओ मतलब थिअ इहअ कि उतरा बाखे इज़राईली संघै छ़ेल़णअ तेऊ जुध संघा करनै तिंयां सोभ इज़राईली आपणैं काबू। <verse eid="1KI 12:21" /><verse number="22" style="v" sid="1KI 12:22" />पर बिधाता बोलअ आपणैं गूर शमयाह लै इहअ, <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />“तूह दै राज़ै रहबाम अर यहूदा अर बिन्यामीन सोभी गोत्रे लोगा लै इहअ समाद, <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />‘तम्हैं निं आपणैं ई सक्‍कै भाई-बंधा संघै जुधा करदै लागी। तम्हैं डेओआ सोभ आपणैं घअरा लै, सह आसा हुंह बिधाता आप्पै ज़ुंणीं इहअ दैनअ हणैं।’” रहबाम अर तेऊए सारी सैना शूणअ तिहअ ई ज़िहअ बिधाता बोलअ संघा डेऊऐ तिंयां आपणैं घअरा लै फिरी।<verse eid="1KI 12:24" /></para>
  <para style="s">जरोबाम बी पेठअ बिधाता छ़ाडी कबाता</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />इज़राईलीओ राज़अ हुअ ऐबै जरोबाम अर तेऊ बणाअं एप्रैम धारा बाखे मुल्खै शकेम नगरी फेर गहल़ संघा रहअ थोल़ै धैल़ै तिधी। तेखअ डेऊअ सह तिधा का पनीएल नगरी संघा किई सह नगरी फेर गहल़ च़िणीं पाक्‍की। <verse eid="1KI 12:25" /><verse number="26-27" style="v" sid="1KI 12:26-27" />जरोबाम सोठा त इहअ, “सोभ इज़राईली डेओआ आझ़ बी बिधाता सेटा बल़ीदान करना लै एरुशलेम नगरी। हई सका कि तिंयां भिई राज़ै दाबेदे खिंबा बाखा लै फिरे! तेखअ सका तिंयां मुंह मारी अर यहूदो राज़अ रहबाम बणाणअं तिन्‍नां भिई आपणअ राज़अ!”<verse eid="1KI 12:26-27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 12:28" />राज़ै जरोबामै लई होरी का बी सलाह संघा बणाईं सुन्‍नें बडी-बडी दूई बाछ़ूए मुहुर्ती संघा बोलअ आपणीं परज़ा लै, “तम्हां लागा बिधाता पूज़दै एरुशलेम नगरी पुजणअ ज़ुंण इधा का खास्सी दूर आसा। इज़राईलीओ, इधी भाल़ा, ईंयां आसा थारै आपणैं देअ ज़ुंणीं तम्हैं मिसर देशा का आसा काढी आणै दै!”<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EXO 32:4">लुआ. 32:4</ref></char></note> <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />एक सुन्‍नेंओ बाछ़ू डाहअ तेऊ बेतेल अर दुजअ डाहअ तेऊ दान स्तापी। <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />इहअ करै लागै इज़राईली घोर पाप करदै अर तिंयां लागै बेतेल अर दान माथै टेक्‍कदै डेऊंदै! <verse eid="1KI 12:30" /><verse number="31" style="v" sid="1KI 12:31" />जरोबामै डाहै उझै उछ़टी धारा प्रैंदै बी कई देहुरै च़िणीं संघा डाहै तेथ लेबी गोत्रा मांझ़ा का पज़ैरै।<verse eid="1KI 12:31" /></para>
  <para style="s">बेतेल डाही मकशीरे भिन्‍नैं जाचा</para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 12:32" />तेखअ डाही जरोबामै पंद्रा मकशीरै बेतेल आपणीं जाच ज़ेही यहूदा मुल्खै एरुशलेम हआ ती। ज़ुंण तेऊ तिधी बाछ़ूए मुहुर्ती बणाईं, तेता आजू बेदी दी किअ तेऊ बल़ीदान। संघा डाहअ बेतेल बी एक प्रोहत तिन्‍नां प्रोहता मांझ़ै ज़ुंण धारा प्रैंदै देहुरै दी पज़ैरै हआ तै डाहै दै।<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LEV 23:33">लेब. 23:33</ref>,<ref loc="LEV 23:34">34</ref></char></note> <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />पंद्रा मकशीरै किअ जरोबामै आपणीं बणाईं दी बाछ़ूए मुहुर्ती सेटा बेदी दी बल़ीदान। संघा डाही सोभी इज़राईली लै हर साल तिधी जाच।<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s">एकी मणछै किअ बेतेल बेदीओ बरोध</para>
  <para style="p">
    <verse number="1-2" style="v" sid="1KI 13:1-2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1-2 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 23:15">2 राज़. 23:15</ref>,<ref loc="2KI 23:16">16</ref></char>
    </note>एकी धैल़ै त जरोबाम बेतेल नगरी तैहा बेदी सेटा भैंट च़ढाऊंणा लै खल़्हुअ द। तिधी आअ नच़ानक यहूदा का एक परमेशरो मणछ संघा लागअ ज़ोरै इहअ बोल्दअ, “बिधाता आसा मुखा ऐहा बेदीए बारै समाद दैनअ द कि दाबेदे खिंबा दी हणअ आजू एक जोशिया नाओं शोहरू। तेऊ करनै ऐहा बेदी दी तिंयां प्रोहत बल़ीदान ज़ुंण इधी बल़ीदान करा। ऐहा बेदी दी हणअ मणछे हाडकेओ हूम।” <verse eid="1KI 13:1-2" /><verse number="3" style="v" sid="1KI 13:3" />तेखअ बोलअ आजू तेऊ मणछै इहअ, “अह बेदी धुआशणीं दूई बाखा लै अर एथ भितरो छ़ार छिंघणअ धरनीं। तेखअ लागणअ तम्हां का थोघ कि मुंह बाती इना गल्‍ला करनै आल़अ आसा बिधाता आप्पै।”<verse eid="1KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4" />ज़ांऊं राज़ै जरोबामै इहअ शूणअ, तेऊ बोलअ तेऊ परमेशरे मणछा बाखा गुंठी करी ज़ोरै इहअ, ज़ुंणी बेतेले तैहा बेदीए बारै हाक्‍का पाई बोलअ त, “ढाका एऊ!” एतरअ दै जरोबामा बोल़णैं कि तेऊओ हाथ मछैंअ तिधी अर तेऊए बाह हुई ल़ेल़ी कि सह निं तेता पिछ़ू बी करी सकअ। <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />सह बेदी बी धुआशुई हेरा-हेरी दूई बाखा लै अर तेतो छ़ार छिंघूअ तिधी धरनीं। ज़िहअ तेऊ मणछै बिधाते नाओंऐं बोलअ त सह हुअ तिहअ ई पूरअ। <verse eid="1KI 13:5" /><verse number="6" style="v" sid="1KI 13:6" />तेखअ बोलअ राज़ै जरोबामै तेऊ मणछा लै, “ज़ीबाण, तूह कर बिधाता सेटा मुल्है अरज़ कि सह मेरी बाह नरोगी करे।”</para>
  <para style="p" vid="1KI 13:6">तेऊ मणछै किई बिधाता सेटा अरज़ अर राज़े बाह हुई तेभी नरोगी। <verse eid="1KI 13:6" /><verse number="7" style="v" sid="1KI 13:7" />तेखअ बोलअ राज़ै जरोबामै बिधाते तेऊ मणछा लै, “तूह च़ाल्‍ल मुंह संघै संघा लअ धख खाई पिई। हुंह च़ाहा ताल्है तेरै एऊ कामां लै नांम बी दैणीं।”<verse eid="1KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 13:8" />परमेशरे तेऊ मणछै दैनअ ज़बाब, “ज़ै तूह मुल्है आपणअ आधअ राज़ बी दैए, हुंह निं तैबी बी ताह संघै डेऊई किज़ै खांदअ पिंदअ आथी। <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />बिधाता आसा मुल्है हुकम किअ द। तेऊ बोलअ इहअ कि नां खाई, नां पिई अर नां तैहा बाता घअरा लै फिरी डेऊई ज़हा बाता हुंह आअ।” <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />तेखअ निं सह मणछ तैहा बाता बापस डेऊअ ज़हा बाता सह बेतेल आअ त, पर सह डेऊअ होरी बाता।<verse eid="1KI 13:10" /></para>
  <para style="s">बेतेल एक प्रोढअ गूर</para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11" />तधू काल्‍ला रहा त बेतेल एक प्रोढअ गूर। तेऊए शोहरू खोज़ी तेऊ का तिंयां सारी गल्‍ला कि यहूदा का आऐ दै बिधाते एकी मणछै राज़े बारै किज़ै बोलअ अर किज़ै किअ। <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />तेऊ प्रोढै गूरै पुछ़अ, “यहूदा का आअ द सह परमेशरो मणछ कहा बाता डेऊअ?” तिन्‍नैं खोज़अ तेऊ का कि ऐहा बाता डेऊअ किल्हैकि तिन्‍नैं हेरअ त सह डेऊंदअ भाल़ी। <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />तेऊ प्रोढै गूरै बोलअ आपणैं शोहरू लै, “मुल्है करा ज़ीन-काठी लाई गाधे शुंआरी तैर।”</para>
  <para style="p" vid="1KI 13:13">तिन्‍नैं किअ तिहअ ई संघा डेऊअ सह गाधै प्रैंदै बेशी <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />तैहा बाता यहूदा का आऐ दै तेऊ मणछा पिछ़ू लोल़अ। बाता भेटअ तेऊ प्रोढै गूरा सह परमेशरो मणछ बडै महरूए बूटा हेठै बेठअ द, तेऊ पुछ़अ, “यहूदा का आअ द परमेशरो मणछ तूह ई आसा?”</para>
  <para style="p" vid="1KI 13:14">तेऊ बोलअ, “हाँ, हुंह ई आसा।”<verse eid="1KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 13:15" />प्रोढै गूरै बोलअ, “तूह च़ाल्‍ल मेरै घअरा लै संघा लअ रोटी खाई।”<verse eid="1KI 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 13:16" />पर यहूदा का आऐ दै गूरै बोलअ, “हुंह निं तेरै घअरा लै एछी सकदअ अर नां ताह संघै फिरी डेऊंदअ, नां ऐहा ज़ैगा रोटी खांदअ नां हुंह पाणीं झुटदअ, <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />किल्हैकि बिधाता आसा मुल्है हुकम किअ द। तेऊ बोलअ इहअ कि नां किज़ै खाई नां पाणीं झुटी अर नां तैहा बाता घअरा लै फिरी डेऊई ज़हा बाता तूह आअ त।”<verse eid="1KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18" />तेखअ बोलअ बेतेले तेऊ प्रोढै गूरै, “हुंबी आसा ताह ई ज़िहअ गूर, बिधाते एकी स्वर्ग दूतै बोलअ मुल्है ताह आपणैं घअरा लै निंणां लै अर मुल्है कि हुंह ताल्है रोटी खैऊए अर ताल्है झुटणा लै पाणीं दैए।” यहूदा का आऐ दै बिधाते गूरै निं ज़ाणअ कि बेतेलो सह प्रोढअ गूर आसा झ़ुठअ बोल्दअ लागअ द! <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />तेखअ डेऊअ सह तेऊ प्रोढै गूरे घअरा लै संघा खाई तिधी रोटी अर पाणीं बी झुटअ। <verse eid="1KI 13:19" /><verse number="20" style="v" sid="1KI 13:20" />ज़ांऊं तिंयां रोटी खांदै तै बेठै दै, बिधाता बोलअ तेऊ प्रोढै गूरा का, <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />संघा बोलअ बेतेले तेऊ प्रोढै गूरै ज़ोरै-ज़ोरै यहूदा का आऐ दै गूरा लै, “बिधाता बोला ताल्है इहअ, ‘तंऐं निं मेरअ हुकम मनअ! तंऐं निं ज़िहअ मंऐं बोलअ तिहअ किअ! <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />ज़िधा लै मंऐं नांह किअ थिअ, तूह फिरअ तिधा ई लै संघा लागअ तिधी खांदअ पिंदअ! एता पिछ़ू पाणअ तूह मारी अर तेरी ल्हास निं तिधी डाहणीं ज़िधी तेरै दाद-बाब डाहै।’”<verse eid="1KI 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23" />ज़ांऊं तिंयां खाई-पिई मुक्‍कै, तेऊ प्रोढै गूरै किअ यहूदा का आऐ दै गूरा लै ज़ीन काठी लाई गाधअ तैर। <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />तेखअ लागअ यहूदा का आअ द गूर हांढदअ। बाता भेटअ तेऊ सिह अर तेऊ पाअ सह मारी। तेऊओ गाधअ अर सिह रहै दुहै तेऊए ल्हासा सेटा तिधी खल़्हुई। <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />तैहा बाता डेऊऐ नगरीए कई लोग अर तिन्‍नैं भाल़ी ल्हास अर सिह भाल़अ तिधी खल़्हुअ द। तिंयां डेऊऐ बेतेल ठुर्ही ज़िहअ तिन्‍नैं भाल़अ, सह खोज़अ सोभी का ज़िधी सह प्रोढअ गूर रहा त।<verse eid="1KI 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26" />ज़ांऊं बेतेल नगरीए तेऊ प्रोढै गूरा का इहअ थोघ लागअ, तेऊ बोलअ, “अह हणअ बिधातो सह ई गूर ज़ुंणीं बिधातो हुकम चोल़अ! तैही छ़ाडअ बिधाता सिह संघा पाअ सह मारी, ज़िहअ बिधाता बोलअ त तिहअ ई।” <verse eid="1KI 13:26" /><verse number="27" style="v" sid="1KI 13:27" />तेखअ बोलअ तेऊ आपणैं शोहरू लै, “मेरै गाधै दी लाआ ज़ीन काठी।” तिन्‍नैं किअ तिहअ ई, <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />तेखअ डेऊअ सह तैहा बाता अर बाता भेटी तेऊ यहूदा का आऐ दै गूरे ल्हास अर तेऊओ गाधअ अर सिह भाल़ै तिधी खल़्हुऐ दै, किल्हैकि नां तिन्‍नैं सिहै सह ल्हास खाई अर नां तिन्‍नां गाधै लै पल़ै चुटी। <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />तेऊ प्रोढै गूरै च़की बिधाते गूरे सह ल्हास संघा पाई गाधै प्रैंदै तेखअ पजैल़ी सह बापस बेतेल नगरी संघा डाही तिधी दाबी। <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />तेऊ डाही सह ल्हास तेऊ प्रोढै गूरै आपणैं दादा-बाबे ल्हासा दाबणे ज़ैगा दाबी। तेऊए शोहरू मनाऊंअ तेऊ लै एही लेरा लाई शोग, “ओ मेरै भाईआ, मेरै भाईआ, तूह किधी डेऊअ!” <verse eid="1KI 13:30" /><verse number="31" style="v" sid="1KI 13:31" />ज़ांऊं तेऊ प्रोढै गूरै तेऊए ल्हास दाबी छ़ेक्‍की, तेखअ बोलअ तेऊ आपणैं शोहरू लै, “ज़ेभै हुंह मरे, तेभै डाहै मुंह बी ऐहा ई ज़ैगा एऊ बिधाते गूरे काछ़ा बाखा दाबी। <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />मुंह आसा पूरअ भरोस्सअ कि ज़ुंण बिधाते एऊ गूरै बेतेल बेदी अर सामरी नगरीए धारा प्रैंदे सोभी देहुरे बारै बोलअ थिअ, सह हणअ पाक्‍कै दी पूरअ।”<verse eid="1KI 13:32" /></para>
  <para style="s">जरोबाम पल़अ घोर पापा दी</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />इज़राईलो राज़अ जरोबाम निं पाप करनै का पिछ़ू हटअ। तेऊ डाहै तिन्‍नां उछ़टी धारा बेदी अर देहुरै दी लेबी गोत्रा छ़ाडी होर बी कज़ोहै प्रोहत बणाईं। ज़ुंण बी प्रोहत बणनअ च़ाहा त, तेऊओ करा त सह संस्कार संघा डाहा त तिन्‍नां प्रोहत बशैल़ी। <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />अह इहअ करनअ हुअ जरोबामे सारी खिंबा लै घोर पाप अर एता ई करै हुअ खिरी सह आपणैं राज़-पाठा संघी पठी बरैबाद।<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s">राज़ै जरोबामे शोहरूए मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />तधू काल्‍ला ई हुअ इहअ कि जरोबाम राज़ैओ शोहरू अबियाह हुअ खास्सअ बमार। <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />जरोबामै बोलअ आपणीं लाल़ी लै इहअ, “तूह बदल़ आपणअ भेश कि तूह निं कोही बछ़ैणीं लोल़ी, संघा डेऊ शिलोह ज़िधी सह आहिजा गूर रहा ज़ुंण मुल्है इहअ बोलअ त कि हुंह हणअ इज़राईलीओ राज़अ। <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />तेऊ लै निंयैं दस रोटी, टिक्‍की अर एक शिंगी मखीर। तेऊ हेरनअ ताखा खोज़ी कि शोहरू लै आजू किज़ै हणअ।”<verse eid="1KI 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 14:4" />जरोबामे बेटल़ी किअ तिहअ ई संघा पुजी हांढी करै शिलोह आहिजा गूरे घअरै। आहिजा गूर त खास्सअ प्रोढअ अर तेऊए आछी का निं शुझदअ बी आथी त। <verse eid="1KI 14:4" /><verse number="5" style="v" sid="1KI 14:5" />बिधाता बोलअ आहिजा गूरा का, “आहिजा, जरोबामे लाल़ी एछणी ताह सेटा आपणैं शोहरूए बारै पुछ़दी ज़ुंण खास्सअ बमार आसा। तूह खोज़ै तैहा का एही-एही गल्‍ला।”</para>
  <para style="p" vid="1KI 14:5">ज़ांऊं जरोबामे लाल़ी आहिजा गूरा सेटा पुजी, तैहा किअ इहअ दखाअ कि सह आसा कुंण होर बेटल़ी। <verse eid="1KI 14:5" /><verse number="6" style="v" sid="1KI 14:6" />पर ज़ांऊं आहिजा गूरै दुआरा ओर्ही तेसे हांढणे छ़ेल़ शूणीं, तेऊ बोलअ तैहा लै इहअ, “मुखा आसा थोघ कि तूह आसा राज़ै जरोबामे लाल़ी। तूह किल्है आसा इहअ दखाअ करदी लागी दी कि तूह आसा कुंण होर बेटल़ी? मुखा आसा ताल्है बडी बूरी खबर। <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />तूह डेऊ राज़ै जरोबामा सेटा लै संघा खोज़ कि इज़राईलो परमेशर बिधाता बोला ताल्है इहअ, ‘सारी परज़ा मांझ़ै छ़ांटअ मंऐं तूह कि तूह मेरी परज़ा इज़राईली प्रैंदै राज़ करे। <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />दाबेदे आद-लुआदा का किअ मंऐं राज़-पाठ दूर संघा दैनअ ताल्है, पर तूह निं मेरै दास दाबेदा ज़िहअ शुचअ आथी। तेऊ मनै मेरै सोभै हुकम, संघा किअ ज़िहअ मंऐं बोलअ तिहअ ई। <verse eid="1KI 14:8" /><verse number="9" style="v" sid="1KI 14:9" />ज़ेतरै बी ताखा आजी राज़ै हुऐ, तंऐं किअ तिन्‍नां सोभी का खास्सअ पाप। तंऐं समझ़अ हुंह नकदरअ अर सुन्‍नें मुहुर्ती बणाईं तिन्‍नां देअए पूज़ा करी ठैऊई तंऐं मुल्है खास्सी रोश्शै। <verse eid="1KI 14:9" /><verse number="10" style="v" sid="1KI 14:10" />एता पिछ़ू पाणीं मुंह तेरै सारै खिंबा लै एही आफ़त कि तेरै खिंबा दी मरनै होछ़ै का प्रोढै तैणीं सोभ मर्ध च़ाऐ तिंयां गलाम होए च़ाऐ आज़ाद। तिन्‍नें करनीं मुंह इज़राईली मांझ़ा का एही सफाई ज़िहै कुंण खुढा का च़िक्‍करै बागै शोधा।<note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="1KI 15:29">1 राज़. 15:29</ref></char></note> <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />तेरै खिंबा दी ज़ुंण नगरी दी मरे, तिन्‍नैं खाणीं ल्हासा बी कुक्‍करा अर ज़ुंण नगरी बागै खेचै मरे तिन्‍नें ल्हासा च़ोच़ल़णी काअ-गरली। अह गल्‍ल डाही मंऐं बिधाता बोली।’”<verse eid="1KI 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12" />तेखअ बोलअ आहिजा गूरै जरोबामे लाल़ी लै इहअ, “ऐबै डेऊ तूह घअरा लै फिरी, ज़ेही ई ताह नगरी दी आपणैं दुआरे डेहल़ा भितरी गंईं डाहणीं, तिहअ ई जाणअ सह शोहरू मरी। <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />इज़राईले सोभी लोगा करनअ तेऊ लै शोग संघा डाहणअ सह दाबी। जरोबामे खिंबा दी हणअ सह ई एक्‍कै मणछ ज़ुंण बिधी-बधाना संघै डाहणअ दाबी। किल्हैकि इज़राईलो परमेशर बिधाता आसा सिधअ तेऊ लै खुश। <verse eid="1KI 14:13" /><verse number="14" style="v" sid="1KI 14:14" />बिधाता करनअ इज़राईला लै इहअ राज़अ खल़अ, तेऊ राज़ै करनअ जरोबामो खिंब पठी खतम! मेरअ मतलब कि इहअ आसा ऐबै छ़ेक्‍कै हणैं आल़अ। <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />बिधाता दैणीं इज़राईली लै सज़ा, तेऊ झ़ुंझ़ल़णै तिंयां इहै, ज़िहअ गाडा-नाल़ो हर्हल नगाल़े डाल़ी झ़ुंझ़ल़ा। तैहा रज़दी-पज़दी ज़ैगा का पेच़णैं तिंयां तेऊ गोधी का ज़ुंण ज़ैगा तेऊ तिन्‍नें दादा-बाबा लै थिई दैनी दी। तेऊ डाहणैं तिंयां फरात दरैऊआ पार छिंगी किल्हैकि अशेरा देबीए मुहुर्ती बणाईं ठैऊई तिन्‍नैं बिधाता लै रोश्श। <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />जरोबामै किअ पाप अर इज़राईली का बी कराऊअ तेऊ पाप। तेता पिछ़ू छ़ाडणैं बिधाता ऐबै इज़राईली।”<verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />जरोबामे लाल़ी लागी तिधा का हांढदी संघा पुजी तिर्सा नगरी आपणैं घअरै। ज़ेही ई तैहा आपणैं घअरै डेहल़ा भितरी गंईं डाही, तेही ई शोटै तेऊ शोहरू प्राण। <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />सोभी इज़राईली किअ तेऊ शोहरू लै शोग संघा डाहअ सह बिधी-बधाना संघै दाबी। सह हुअ तिहअ ई ज़िहअ बिधाता आहिजा गूरा बाती बोलअ त।<verse eid="1KI 14:18" /></para>
  <para style="s">राज़ै जरोबामे मौत</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19" />राज़ै रहंदी जरोबामै ज़िहै बी काम किऐ, तेऊ केतरै जुध लल़ै अर केतरै ज़ितै, तिंयां सोभै गल्‍ला आसा इज़राईले इतिहासे कताबा दी लिखी दी। <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />जरोबामै कि इज़राईला प्रैंदै बाई साला तैणीं राज़। सह मूंअ संघा डाहअ दाबी अर तेऊए ज़ैगा बेठअ तेऊओ शोहरू नादाब राज़अ।<verse eid="1KI 14:20" /></para>
  <para style="s">यहूदा मुल्खै राज़ै रहबामो राज़</para>
  <para style="r">(<ref loc="2CH 11:5-12:15">2 इतिहास 11:5—12:15</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />राज़ै सुलैमानो शोहरू रहबाम थिअ कताल़ी सालो ज़ेभै सह यहूदा मुल्खो राज़अ बणअ। तेऊ किअ सतारा साला तैणीं एरुशलेम नगरी राज़ ज़ुंण बिधाता इज़राईलीए होरी सोभी नगरी मांझ़ै आप्पू लै छ़ांटी कि तिधी तेऊए पूज़ा-गाज़ा होए। रहबामे ईज नामाह ती अमोन नगरी का।<verse eid="1KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22" />यहूदा मुल्खै लोग बी लागै तिहअ ई पाप करदै ज़ेता का बिधाता नफरत करा। तिन्‍नैं ठैऊई बिधाता लै आपणैं दादा-बाबा का बी खास्सी रोश्श। <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />तिन्‍नैं डाहै उछ़टी धारा अर बडै-बडै बूटा हेठै ओडै अर अशेरा देबीए मुहुर्ती स्तापी।<note caller="-" style="x"><char style="xo" closed="false">14:23 </char><char style="xt" closed="false"><ref loc="2KI 17:9">2 राज़. 17:9</ref>,<ref loc="2KI 17:10">10</ref></char></note> <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />तिन्‍नां ज़ैगा करा तै तिन्‍नां मांझ़ै कई मर्ध अर बेटल़ी कंज़रैई। ज़ुंण ज़ाती बिधाता इज़राईली का दूर काढी ती, तिंयां लोग लागै तिन्‍नें ई च़िल़्हखरै रिती-रबाज़ा मंदै।<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="DEU 23:17">बधा. 23:17</ref></char></note><verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />रहबाम राज़े पांज़ूई साला छ़ेल़अ मिसर देशे राज़ै शिशकै जुध संघा पल़अ एरुशलेम नगरी लै चुटी।<note caller="-" style="x"><char style="xo" closed="false">14:25 </char><char style="xt" closed="false"><ref loc="2CH 12:2-8">2 इति. 12:2-8</ref></char></note> <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />तेऊ निंईं एरुशलेम बिधाते भबने अर राज़े मैहले सोभ किम्मती च़िज़ा लुटी अर तेथ संघै निंईं तेऊ तिंयां ढाल़ा बी ज़ुंण सुलैमानै सुन्‍नें ती बणाईं दी।<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="1KI 10:16">1 राज़. 10:16</ref>,<ref loc="1KI 10:17">17</ref>; <ref loc="2CH 9:15">2 इति. 9:15</ref>,<ref loc="2CH 9:16">16</ref></char></note> <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />तेखअ बणाईं राज़ै रहबामै तेते ज़ैगा कांस्से ढाल़ा संघा डाही तिंयां पहरीए सैणैं सेटा सभाल़ी ज़ुंण राज़े मैहलै फाज़त करा तै। <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />ज़ेभै-ज़ेभै राज़अ बिधाते भबना लै डेऊअ त, तेभै-तेभै आणा तै तिंयां पहरी तिन्‍नां ढाल़ा भढारा का काढी अर तेखअ डाहा तै तिंयां बापस।<verse eid="1KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29" />रहबाम राज़ै ज़िहै-ज़िहै काम किऐ, तिंयां आसा यहूदा मुल्खै राज़े इतिहासे कताबा दी लिखै दै। <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />ज़ेभै तैणीं रहबाम अर जरोबामो राज़ रहअ, तिंयां रहै एकी-दुजै संघै कधि बणी। <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />रहबामे ईज नामाह ती अमोन नगरी का, ज़ांऊं रहबाम राज़अ मूंअ, सह डाहअ दाबेदपूर दाबी ज़िधी तेऊए दाद-बाब तै दाबै दै। आजू बणअ तेऊए ज़ैगा तेऊओ शोहरू अबियाह यहूदा मुल्खो राज़अ।<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s">यहूदा मुल्खै राज़ै अबियाहो राज़</para>
  <para style="r">(<ref loc="2CH 13:1-14:1">2 इतिहास 13:1—14:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />इज़राईला दी थिअ नबातो शोहरू जरोबाम राज़अ, तेऊए राज़ा दी ठार्हुई साला बणअ यहूदा मुल्खै अबियाह राज़अ। <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />तेऊ किअ चिई साला तैणीं एरुशलेम नगरी दी राज़। तेऊए ईज ती अबशलोमे शोहरी माकाहा। <verse eid="1KI 15:2" /><verse number="3" style="v" sid="1KI 15:3" />अबियाहै किअ आपणैं बाबा ई ज़िहअ पाप अर सह निं बिधाता लै तिहअ शुचअ-पाक्‍कअ रहअ ज़िहअ तेऊओ पल़दादू राज़अ दाबेद थिअ। <verse eid="1KI 15:3" /><verse number="4-5" style="v" sid="1KI 15:4-5" /><note caller="-" style="x"><char style="xo" closed="false">15:4-5 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 राज़. 11:36</ref>; <ref loc="2SA 11:1-27">2 शमू. 11:1-27</ref></char></note>राज़अ दाबेद करा त तिहअ ज़िहअ बिधाता च़ाहा त कि सह करे। हित्ती उरियाहे लाल़ी संघै पाप करनै का सुआई निं तेऊ आपणीं ज़िऊंदी ज़िता होर किछ़ै गलती किई। अबियाह थिअ दाबेदो पल़पोचअ, बिधाता डाही एरुशलेम नगरी बच़ाऊई अर बिधाता दैनअ अबियाह लै शोहरू कि सह तेऊ बाद राज़अ बणें। <verse eid="1KI 15:4-5" /><verse number="6" style="v" sid="1KI 15:6" />रहबाम अर जरोबामा मांझ़ै एतरी साला ज़ुंण कबल्‍लअ झ़गल़अ रहअ सह रहअ आजू अबियाह ज़िऊंदी ज़िता बी तिहअ ई।<note caller="-" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="2CH 13:3-21">2 इति. 13:3-21</ref></char></note> <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />ज़िहअ-ज़िहअ बी अबियाह राज़ै किअ, सह आसा यहूदा मुल्खै इतिहासे कताबा दी लिखी डाहअ द। अबियाह अर जरोबामे रहै सारी अमरा जुध लागी।<verse eid="1KI 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 15:8" />अबियाह मूंअ संघा डाहअ सह दाबेदपूर गहल़ै दाबी अर आजू बेठअ तेऊओ शोहरू आसाह यहूदा मुल्खै राज़अ।<verse eid="1KI 15:8" /></para>
  <para style="s">यहूदा दी राज़ै आसाहो राज़</para>
  <para style="r">(<ref loc="2CH 14:1-5">2 इतिहास 14:1-5</ref>; <ref loc="2CH 15:16-16:6">15:16—16:6,11-14</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />इज़राईला दी थिअ जरोबामो राज़ अर तेऊए राज़ा दी बिहुई साला बणअ आसाह यहूदा मुल्खो राज़अ अर <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />तेऊ किअ कताल़ी साला तैणीं एरुशलेम नगरी दी राज़। अबशलोमे शोहरी माकाहा थिई आसाहे पल़दादी। <verse eid="1KI 15:10" /><verse number="11" style="v" sid="1KI 15:11" />आसाह किअ आपणैं दाद-बाब दाबेदा ई ज़िहअ काम ज़ेता करै बिधाता खुश हआ। <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />ज़ुंण देशै कंज़रै मर्ध अर बेटल़ी आसा, मुहुर्ती अर तेता पुजणें ज़ैगा बी किई तेऊ आपणैं देशा का खतम।<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="2CH 15:8-15">2 इति. 15:8-15</ref></char></note> <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />आसाह राज़े पल़दादी माकाहा ज़ुंण अशेरा देबीए च़िल़्हखरी मुहुर्त बणाईं ती सह बी च़की तेऊ संघा डाही किद्रोन खागै दहई। माकाहा लै थिई राज़माते पदबी, सह बी निं तेऊ आजू लै डाही। <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />ज़ात पठी निं तेऊ देहुरै ढोल़ै आथी पर तज़ी बी रहअ आसाह आपणीं सारी ज़िन्दगी बिधाता लै शुचअ-पाक्‍कअ। <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />ज़ुंण सुन्‍नैं-च़ंदीए भांडै तेऊए बाबै अर ज़ुंण तेऊ आप्पू बिधाता लै थिऐ अर्पण किऐ दै, तिंयां डाहै तेऊ सोभै बिधाते भबनै।<verse eid="1KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16" />यहूदा दी राज़अ आसाह अर इज़राईला दी थिअ राज़अ बाशा, इना दुही रहअ सारी अमरा जुध लागी। <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />एकी बारी छ़ेल़अ इज़राईले राज़ै बाशा यहूदा संघै जुध संघा किअ रामाह नगरी कबज़अ। तेऊ बणाअं तेथ फेर-फिरदअ गहल़ बागै डाहै आपणीं सैना संघा किअ यहूदा लै लोगै एछणअ डेऊणअ बंद। <verse eid="1KI 15:17" /><verse number="18" style="v" sid="1KI 15:18" />राज़ै आसाह किअ इहअ कि बिधाते भबनै अर तेऊए मैहलै ज़ुंण सुन्‍नैं-च़ंदीए भांडै थिऐ रहै दै, तिंयां काढै तेऊ सोभ संघा दैनै आपणैं कार-करिंदे हाथै दमिश्क अराम देशे राज़ै बेन्हदादा सेटा, सह थिअ तब्रीमोनो शोहरू अर हेज़ियोनो पोचअ। संघा दैनअ तेऊ लै इहअ समाद, <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />“ज़िहअ म्हारै बाबो आप्पू मांझ़ै ज़ोल़-मेल़ थिअ, हाम्हां बी करनअ आजू तिहअ ई। ईंयां सुन्‍नैं-च़ंदीए भांडै दैनै मंऐं ताल्है भैंट। ऐबै एछ तूह मुंह संघै अर इज़राईले राज़ै बाशा संघै कर आपणीं करार खतम ताकि सह मेरी देशे ज़ैगा का आपणीं सैना संघी पोर्ही निखल़े।”<verse eid="1KI 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 15:20" />राज़ै बेन्हदादै किअ तिहअ ई ज़िहअ राज़ै आसाहै बोलअ अर तेऊ छ़ाडै आपणीं सैने दलपति संघा छ़ेल़अ कई इज़राईली नगरी दी जुध। तिन्‍नैं किअ इजोन, दान अबेल, अबेल-बेथ-माकाहा नगरी गलील समुंदरे मुल्खै कबज़अ अर नप्ताली गोत्रो सारअ देश बी ज़ितअ तिन्‍नैं। <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />ज़ांऊं राज़ै बाशा शूणअ कि इहअ हुअ, तेऊ पाई रामाह नगरी गहल़ा-कोटा बणाणें छ़ाड संघा डेऊअ तिर्सा नगरी लै फिरी।<verse eid="1KI 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 15:22" />तेखअ किअ आसाह राज़ै सारै यहूदा मुल्खै सोभी लै हुकम कि ज़ुंण बाशा राज़ै रामाह नगरी गहल़ा बणाणां लै काठ पात्थर तै लाऐ दै, तिन्‍नां च़का। संघा लाऐ तिंयां काठ पात्थर बिन्यामीन गोत्रे नगरी गिबा अर मिज़पा नगरी गहल़ा बणाणां लै।<verse eid="1KI 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23" />आसाह राज़ै आपणैं राज़ा दी ज़ेतरै बी काम किऐ, ज़ेतरै जुध ज़ितै, ज़ेतरी नगरी भिई बसाऊई तिंयां आसा यहूदा मुल्खे इतिहासे कताबा दी लिखी डाही दी। ज़ांऊं सह प्रोढअ हुअ, तेऊ लागी खूरै बमारी। <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />राज़अ आसाह मूंअ संघा डाहअ सह दाबेदपूर गहल़ै दाबी अर आजू बेठअ तेऊओ शोहरू जहोशापात तेऊए ज़ैगा यहूदा मुल्खो राज़अ।<verse eid="1KI 15:24" /></para>
  <para style="s">इज़राईला दी राज़अ नादाब</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />यहूदा थिअ आसाह राज़अ, तेऊए राज़ा दी दुजी साला बणअ जरोबामो शोहरू नादाब इज़राईल मुल्खो राज़अ अर तेऊ किअ बिहा साला तैणीं राज़। <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />ज़िहअ तेऊए बाबै पाप किअ, आजू किअ तेऊ बी तिहअ ई अर इज़राईली का बी कराऊअ तेऊ तिहअ ई पाप ज़ेता का बिधाता नफरत करा।<verse eid="1KI 15:26" /></para>
  <para style="p">
    <verse number="27-28" style="v" sid="1KI 15:27-28" />आहिजो शोहरू बाशा थिअ इस्साकार गोत्रा का, तेऊ बणाईं नादाब राज़ै मारना लै तरकीब। ज़ांऊं नादाब अर तेऊए सैना पलिश्तीए देशै गिबतोन नगरी संघै जुधा लै डेऊऐ, बाशा पाअ तिधी नादाब मारी। इहअ करै बणअ बाशा इज़राईल मुल्खो राज़अ। तधू ती यहूदा मुल्खै आसाहे राज़ा चिऊथी साल लागी दी। <verse eid="1KI 15:27-28" /><verse number="29" style="v" sid="1KI 15:29" />राज़गाद्दी दी बेशदी लागअ बाशा जरोबामे खिंबा दी सोभी मारदअ। सह हुअ तिहअ ई ज़िहअ बिधाता आपणैं गूर शिलोहे आहिजे का पैहलै ई हेरअ त बोली। जरोबामे खिंबा दी पाए बाशा होछ़ै का प्रोढै तैणीं सोभ मर्ध मारी अर तेथ निं तेऊ एक बी ज़िऊंदअ छ़ाडअ।<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="1KI 14:10">1 राज़. 14:10</ref></char></note> <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />इहअ हुअ तै कि जरोबामै ठैऊई बिधाता लै खास्सी रोश्शै, किल्हैकि तेऊ किअ पाप अर इज़राईली का बी कराऊअ तेऊ पाप।<verse eid="1KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31" />ज़िहअ-ज़िहअ बी राज़ै नादाबै किअ, सह आसा इज़राईले इतिहासे कताबा दी लिखी डाहअ द। <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />यहूदा मुल्खै राज़ै आसाह अर इज़राईल मुल्खे राज़ै बाशा रहै आपणीं ज़िऊंदी ज़िता एकी-दुजै संघै जुधा ई करदै लागी।<verse eid="1KI 15:32" /></para>
  <para style="s">इज़राईला दी राज़ै बाशो राज़</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />यहूदा दी थिअ आसाह राज़अ अर तेऊए राज़ा दी चिऊथी साला बणअ आहिजो शोहरू बाशा इज़राईला दी राज़अ। तेऊ किअ तिर्सा नगरी का इज़राईला प्रैंदै च़ौबी साला तैणीं राज़। <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />ज़िहअ तेऊए बाबै जरोबामै पाप किअ, बाशा बी किअ आजू तिहअ ई पाप अर इज़राईली का बी कराऊअ पाप ज़ेता का बिधाता नफरत करा।<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />बिधाता खोज़अ हनानीए शोहरू जेहू गूरा का राज़ै बाशा लै इहअ समाद, <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />“तूह निं किछ़ बी आथी त, पर मंऐं बणाअं तूह आपणीं परज़ा इज़राईली प्रैंदै सैणअ। तंऐं बी किअ ऐबै जरोबामा ज़िहअ पाप अर मेरी परज़ा इज़राईली का बी कराऊऐ तंऐं तिहै ई पाप। तेरै इनै कामैं ठैऊई मुल्है रोश्शै। <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />बाशा, ऐबै करनै मुंह तूह अर तेरअ खिंब खतम, ज़िहअ मंऐं नबाते शोहरू जरोबामा लै किअ। <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />तेरै खिंबा दी ज़ुंण नगरी भितरी मरे, तिन्‍नैं खाणीं ल्हासा बी कुक्‍करा अर ज़ुंण नगरी बागै मरे, तिन्‍नें ल्हासा च़ोच़ल़णी काअ-गरली। अह गल्‍ल डाही मंऐं बिधाता बोली।”<verse eid="1KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5" />राज़ै बाशा ज़ुंण बी काम किऐ, ज़िहअ बीर सह थिअ तिंयां गल्‍ला आसा इज़राईले राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="1KI 16:5" /><verse number="6" style="v" sid="1KI 16:6" />बाशा मूंअ संघा डाहअ सह तिर्सा नगरी दाबी। आजू बणअ तेऊओ शोहरू एला इज़राईलो राज़अ।<verse eid="1KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 16:7" />बिधाता ज़ुंण समाद हनानीए शोहरू जेहू गूरा का राज़ै बाशा लै दैनअ, सह हुअ एता पिछ़ू कि बाशा किअ बिधाते खलाफ पाप। बिधाता निं तेऊ लै सिधी एता पिछ़ू रोश्शै आई कि तेऊ किअ जरोबामा ज़िहअ पाप, तेऊ लै पल़अ कोप एता पिछ़ू कि तेऊ पाऐ तै जरोबामे खिंबा दी सोभ मारी।<verse eid="1KI 16:7" /></para>
  <para style="s">इज़राईला दी राज़अ एला</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />यहूदा दी त राज़अ आसाह अर तेऊए राज़ा दी छब्बूई साला बणअ बाशा राज़ैओ शोहरू एला इज़राईला दी राज़अ। तेऊ किअ तिर्सा नगरी का दूई साला तैणीं राज़। <verse eid="1KI 16:8" /><verse number="9" style="v" sid="1KI 16:9" />कार-करिंदै मांझ़ै त एक ज़िम्री नाओं मणछ राज़े आधै रथे दलो प्रधान, तेऊ सोठी राज़ै मारने बिक्री। एकी धैल़ै त राज़अ एला अर्सा नाओंए बज़ीरे घअरै झुटदअ बेठअ द, अर्सा त तिर्सा राज़ मैहलो प्रधान। <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />ज़िम्री आअ घअरा भितरा लै संघा पाअ एला मारी। आप्पू बेठअ तेऊए ज़ैगा इज़राईला दी राज़अ। इहअ हुअ यहूदा मुल्खै राज़ै आसाहे स्ताहुई साला।<verse eid="1KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11" />ज़िहअ ई राज़अ ज़िम्री राज़अ बणअ, तेऊ पाऐ राज़ै बाशो सारअ खिंब मारी, तेऊ निं राज़ै बाशे रिश्तैदार अर साथी-संघी जैंदरी तोही एक शोहरू बी ज़िऊंदअ छ़ाडअ! <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />राज़ै बाशो हुअ सारअ खिंब खतम, ज़िहअ बिधाता जेहू गूरा का पैहलै ई हेरअ त चतैनगी दैई बोली। <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />बाशा अर एला किअ पाप अर इज़राईली का बी कराऊअ तिन्‍नैं पाप, बृथा मुहुर्तीए पूज़ा करी ठैऊई तिन्‍नैं बिधाता लै रोश्शै। <verse eid="1KI 16:13" /><verse number="14" style="v" sid="1KI 16:14" />ज़िहै-ज़िहै काम राज़ै एला किऐ, तिंयां आसा इज़राईला दी राज़े इतिहासे कताबा दी लिखी डाहै दै।<verse eid="1KI 16:14" /></para>
  <para style="s">इज़राईला दी राज़अ ज़िम्री</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />यहूदा मुल्खै त राज़अ आसाह राज़अ, तेऊए राज़ा दी स्ताहुई साला बणअ ज़िम्री इज़राईल मुल्खो राज़अ। तेऊ किअ तिर्सा नगरी का इज़राईला प्रैंदै साता धैल़ी तैणीं राज़। इज़राईली तै पलिश्ती गिबतोन नगरी संघै जुधा लै डेरै पाऐ दै। <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />ज़ांऊं जुधा लै डेरै पाऐ दै इज़राईली का थोघ लागअ कि ज़िम्री पाअ धोखै करै राज़अ एला मारी संघा बणअ तेऊए ज़ैगा राज़अ। तैहा ई धैल़ी बणाअं इज़राईली सैना आपणअ सैनापति ओमरी इज़राईलीओ राज़अ। <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />ओमरी अर तेऊए सारी सैना फिरै गिबतोन नगरी का पिछ़ू संघा गोटी तिर्सा नगरी फेर-फिरदी। <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />ज़ांऊं राज़ै ज़िम्री का ज़ाण्हुंअ कि तिर्सा नगरी हेरी ऐबै तिन्‍नैं ज़िती, सह डेऊअ गहल़ा लै मैहला भितरी संघा चैल़ी तेथ आग अर आप्पू बी दझ़अ तेथै। <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />ज़िम्री बी किअ तिहअ ई पाप ज़ेता बिधाता नांईं च़ाहंदअ त। तेऊ बी किअ जरोबामा ज़िहअ पाप अर इज़राईली का बी कराऊअ पाप। <verse eid="1KI 16:19" /><verse number="20" style="v" sid="1KI 16:20" />ज़िहै-ज़िहै काम राज़ै ज़िम्री किऐ, तिंयां आसा तेऊए द्रोह करने गल्‍ला संघी इज़राईला दी राज़े इतिहासे कताबा दी लिखी डाहै दै।<verse eid="1KI 16:20" /></para>
  <para style="s">इज़राईला दी राज़अ ओमरी</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />इज़राईली परज़ा बांढुई दूई बाखा, तिन्‍नां मांझ़ै कई च़ाहा तै गनाथे शोहरू तिबनी राज़अ बणाणअं अर होर तै ओमरी बाखा फिरै दै। <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />खिरी हुई तिन्‍नें ज़ीत ज़ुंण ओमरी बाखा तै, गनाथो शोहरू तिबनी पाअ मारी अर ओमरी बणअ इज़राईला दी राज़अ। <verse eid="1KI 16:22" /><verse number="23" style="v" sid="1KI 16:23" />यहूदा मुल्खै थिअ तिहा साला ओर्ही आसाह राज़अ, तेऊए राज़ा दी कत्तुई साला बणअ ओमरी इज़राईला प्रैंदै राज़अ अर तेऊ किअ बारा साला तैणीं इज़राईला प्रैंदै राज़। पैहली छ़हा साला किअ तेऊ तिर्सा नगरी का राज़। <verse eid="1KI 16:23" /><verse number="24" style="v" sid="1KI 16:24" />बादा का लई तेऊ सामरी धारे ज़ैगा शमेर नाओंए मणछा का छ़ह हज़ार च़ंदीए सिक्‍कै मोल दैई। ओमरी बणाअं तैहा धारा गहल़ संघा बसाऊई तिधी नगरी। तेखअ डाहअ तैहा नगरी नाअं शमेरे ई नाओंऐं सामरी।<verse eid="1KI 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25" />ज़ेतरै राज़ै ओमरी का पैहलै थिऐ, तेऊ किअ तिन्‍नां का बी खास्सअ पाप ज़ेता का बिधाता नफरत करा। <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />तेऊ ढाकी नबाते शोहरू राज़ै जरोबामे बात संघा ठैऊई बिधाता लै रोश्शै। तेऊ आप्पू बी किअ पाप अर इज़राईली का बी कराऊअ पाप। तिन्‍नैं ठैऊई बृथा मुहुर्तीए पूज़ा करी बिधाता लै रोश्श। <verse eid="1KI 16:26" /><verse number="27" style="v" sid="1KI 16:27" />ज़िहै बी भलै-कदुष्ट काम ओमरी किऐ, तिंयां आसा इज़राईला दी राज़े इतिहासे कताबा दी लिखी डाहै दै। <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />राज़अ ओमरी मूंअ संघा डाहअ सह सामरी नगरी दाबी अर तेऊ बाद बणअ तेऊओ शोहरू अहाब इज़राईल मुल्खो राज़अ।<verse eid="1KI 16:28" /></para>
  <para style="s">इज़राईला दी राज़अ अहाब</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />यहूदा मुल्खै गई ती राज़ै आसाहे राज़ा ठत्ती साला हई, तैहा साला बणअ इज़राईला ओमरीओ शोहरू अहाब इज़राईला दी राज़अ अर तेऊ किअ सामरी नगरी का इज़राईला प्रैंदै बाई साला तैणीं राज़। <verse eid="1KI 16:29" /><verse number="30" style="v" sid="1KI 16:30" />ओमरीए शोहरू अहाबा का आजी ज़ेतरै बी इज़राईला दी राज़ै रहै, तेऊ किअ तिन्‍नां सोभी का बी खास्सअ पाप ज़ेता का बिधाता नफरत करा। <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />ज़ुंण पाप नबाते शोहरू राज़ै जरोबामै किऐ, तिंयां पाप निं अहाबा सेटा किछ़ बी आथी तै! सह निखल़अ तेता का बी आजू संघा किअ सदोनी राज़ै एतबाले शोहरी जज़बेला संघै बैह, संघा करा त तैहा संघै बाल देअआ पूज़दअ डेऊई! <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />तेऊ बणाअं सामरी नगरी बाल देअआ लै एक देहुरअ अर तेता लै बणाईं एक बेदी। <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />अहाबै बणाईं अशेरा देबीए मुहुर्ती बी। अहाबा का आजी ज़ेतरै बी इज़राईला दी राज़ै थिऐ, तेऊ ठैऊई बिधाता लै तिन्‍नां सोभी का खास्सी रोश्श। <verse eid="1KI 16:33" /><verse number="34" style="v" sid="1KI 16:34" />तेऊए राज़ा दी बसाऊई बेतेले हीएलै जेरिहो नगरी भिई। तैहा नगरीए आथरी पांदा मूंअ अहाब राज़ैओ ज़ेठअ शोहरू अबीराम। ज़ांऊं तेऊ नगरीए प्रऊल़ खल़ी किई तेभै मूंअ तेऊओ कान्हअ शोहरू सगूब। अह हुई बिधाता बोली दी सह गल्‍ल पूरी ज़ुंण तेऊ नूने शोहरू ज़ैहसू का पैहलै ई हेरी ती खोज़ी।<note caller="-" style="x"><char style="xo" closed="false">16:34 </char><char style="xt" closed="false"><ref loc="JOS 6:26">ज़ैह. 6:26</ref></char></note><verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s">बिधातो गूर एलियाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />गलाद मुल्खे तिशबा नगरी का थिअ बिधातो एक गूर, तेऊ नाअं त एलियाह। तेऊ बोलअ अहाब राज़ै लै, “हुंह करा इज़राईले परमेशर बिधाते च़ाकरी ज़ुंण सदा ज़िऊंदअ आसा, हुंह खाआ तेऊ बिधाते सोह कि ज़ेभै तैणीं हुंह निं बोलूं, तेभै तैणीं नां एऊ देशै सरग हणअ अर नां ओश पल़णीं।”<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="JAS 5:17">याक. 5:17</ref></char></note><verse eid="1KI 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2" />तेखअ बोलअ बिधाता आपणैं गूर एलियाह लै, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />“तूह डेऊ ऐहा ज़ैगा का दूर संघा रह जरदण नदी पुर्बा बाखा करीत नाओंए गाडा लुक्‍की। <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />तैहा गाडो पाणीं हणअ ताल्है झुटणा लै अर मंऐं डाहअ काऊड़ै का बोली अर तिन्‍नां हेरनअ तिधी ताल्है खाणां लै पजैल़ी।”<verse eid="1KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5" />ज़िहअ बिधाता बोलअ, एलियाह किअ तिहअ ई संघा रहअ जरदण नदी पुर्बा बाखा करीत नाओंए गाडा लुक्‍की। <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />सह करा त तैहा गाडो पाणीं झुटी अर काऊड़ै करा तै दोत्ती-उडै तेऊ लै रोटी अर शिखा खाणां लै आणी। <verse eid="1KI 17:6" /><verse number="7" style="v" sid="1KI 17:7" />तेऊ देशै निं सरग हुअ अर खिरी शुक्‍कअ तैहा गाडो पाणीं बी पठी।<verse eid="1KI 17:7" /></para>
  <para style="s">एलियाह अर सारपत नगरीए बिधबा</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 17:8" />तेखअ बोलअ बिधाता एलियाह लै, <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />“तूह डेऊ सदोन मुल्खे सारपत नगरी लै संघा रहै तिधी। तिधी आसा एक बिधबा बेटल़ी, मंऐं किअ तैहा लै हुकम कि सह ताल्है रोटी खैऊए अर तेरी हेर-सभाल़ करे।”<note caller="-" style="x"><char style="xo" closed="false">17:9 </char><char style="xt" closed="false"><ref loc="LUK 4:25">लूक. 4:25</ref>,<ref loc="LUK 4:26">26</ref></char></note> <verse eid="1KI 17:9" /><verse number="10" style="v" sid="1KI 17:10" />तेखअ डेऊअ एलियाह सारपत नगरी लै, ज़ांऊं सह नगरीए प्रऊल़ी सेटा पुजअ, तिधी शुझुई तेऊ का एक बिधबा बेटल़ी झ़ुका झाल़दी लागी दी। एलियाह बोलअ तैहा लै, “ज़ीबाण, मुल्है दै तूह झुटणा लै पाणीं।” <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />सह डेऊई तेऊ लै पाणीं आणदी, तेतरी हेरअ एलियाह तैहा लै हाक लाई इहअ बोली, “पाणीं संघै आणै धख रोटी बी।”<verse eid="1KI 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12" />तैहा बिधबा बेटल़ी बोलअ एलियाह लै, “तेरअ परमेशर बिधाता ज़ुंण सदा ज़िऊंदअ आसा, हुंह काढा तेऊए सोह, मेरै निं रोटीओ म्हार बी आथी रहअ द। मेरै आसा हांडू भितरी एक अंदल़ू पिठअ अर शिंगी दी आसा धख ज़िहअ जैतूनो तेल। मंऐं निंयैं ईंयां धख ज़िहै झ़ुके डाल़ झाल़ी, संघा चाणणी ती मुंह आप्पू अर आपणैं शोहरू लै खिरी एऊ बच़ै दै पिठे धख ज़ेही रोटी। तेता बाद हुअ हाम्हां मरनअ ई।”<verse eid="1KI 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13" />एलियाह बोलअ तैहा बेटल़ी लै, “तूह निं फिकर करै, तूह डेऊ, संघा चाण रोटी। पर सोभी का आजी लअ तूह धख ज़ेही रोटी चाणी मुल्है दैई, तेखअ लागै तूह आप्पू अर आपणैं शोहरू लै चाणदी। <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />किल्हैकि इज़राईलो परमेशर बिधाता बोलअ इहअ, ‘ज़ेभै तैणीं सरग निं होए, तेभै तैणीं निं तेरै हांडूओ पिठअ मुक्‍कणअ अर नां तेरी शिंगी भितरी तेल मुक्‍कणअ।’”<verse eid="1KI 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15" />सह बेटल़ी डेऊई भितरा लै संघा किअ ज़िहअ एलियाह गूरै बोलअ तिहअ ई। तधा बाद हुअ तैहा बिधबा बेटल़ी अर तेसे टबरा लै खास्सै धैल़ै तैणीं बतेर्हअ खाणां लै। <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />ज़िहअ बिधाता एलियाह गूरा बाती बोलअ त, तैहा बिधबा बेटल़ीओ पिठैओ हांडू निं कधि मुक्‍कअ अर नां शिंगी भितरी तेल घटअ।<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />थोल़ै धैल़ै बाद हुअ तेऊ घअरे मालक तैहा बिधबा बेटल़ीओ शोहरू बमार, तेऊ लागी धैल़ी-धैल़ी उंधै ई! सह हुअ खास्सअ बमार अर खिरी मूंअ सह! <verse eid="1KI 17:17" /><verse number="18" style="v" sid="1KI 17:18" />तैहा बिधबा बेटल़ी बोलअ एलियाह लै, “हे परमेशरे मणछा, तंऐं मुल्है इहअ किल्है किअ? तूह कै इधा लै मेरै शोहरू मारदअ आअ कि मुंह आद फिरै कि मंऐं आसा पाप किऐ दै?”<verse eid="1KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 17:19" />एलियाह बोलअ तैहा लै, “एऊ शोहरू दै मुखा।” तेखअ दैनअ तैहा सह शोहरू तेऊए भोसल़ै बशैल़ी। एलियाह निंयं सह उझै आटल़ू लै ज़िधी सह सुत्तअ द हआ त। तेखअ डाहअ सह शोहरू धरनीं च़ैनैं। <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />तेखअ किई एलियाह ज़ोरै-ज़ोरै बिधाता सेटा एही अरज़, “हे मेरै परमेशर बिधाता, तंऐं ऐहा बिधबा बेटल़ी लै एही घोर आफ़त किल्है पाई? ऐहा डाहअ हुंह आपणैं घअरै, एतरी किई ऐहा मेरी च़ाकरी अर तंऐं दैनअ एसे शोहरू मरनै!” <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />बिधाता का अरज़ करदी बारी पल़अ एलियाह चिई बारी तेऊ शोहरू प्रैंदै उटअ संघा बोलअ बिधाता लै इहअ, “हे परमेशर बिधाता! एऊ शोहरू लोल़ी शाह फिरअ, एऊ कर भिई ज़िऊंदै।”<note caller="-" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="2KI 4:34">2 राज़. 4:34</ref>,<ref loc="2KI 4:35">35</ref></char></note> <verse eid="1KI 17:21" /><verse number="22" style="v" sid="1KI 17:22" />बिधाता शूणीं एलियाह गूरे अरज़ अर शोहरू फिरअ शाह संघा हुअ ज़िऊंदअ।<verse eid="1KI 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 17:23" />तेखअ आणअ एलियाह सह शोहरू आटल़ू का उंधै संघा दैनअ इहअ बोली सह शोहरू तैहा बिधबा बेटल़ी का, “भाल़, तेरअ शोहरू आसा ज़िऊंदअ!”<verse eid="1KI 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 17:24" />तैहा बिधबा बेटल़ी बोलअ एलियाह का, “ऐबै हुअ मुंह पाक्‍कअ भरोस्सअ कि तूह मणछ आसा परमेशरो। ज़िहअ बिधाता तेरी ज़िभा का बोला, सह निभा तिहअ ई।”<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s">एलियाह अर बाल देअए गूर</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />ज़ांऊं चिई साला तैणीं सरग निं हुअ, तेखअ बोलअ खास्सै धैल़ै बाद बिधाता एलियाह लै, “तूह डेऊ, संघा प्रघल़ू राज़ै अहाबा सेटा। तेखअ बर्शाऊं हुंह सरग।” <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />एलियाह डेऊअ अहाब राज़ै सेटा लै।</para>
  <para style="p" vid="1KI 18:2">सामरी थिअ घोर नकाल़ पल़अ द। <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />अहाब राज़ै शादअ ओबेदियो, सह थिअ तिन्‍नां धैल़ै राज़े मैहलो बज़ीर। पर दिला का रहा त सह बिधाते डरा हेठै इधी तैणीं कि <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />ज़धू जज़बेल बिधाते सोभी गूरा मारदी ती लागी दी, ओबेदियो डाहै तै तैहा का कोई शौ गूर पज़ाह-पज़ाहे छ़ुंढा दी जुहल़ी च़ोरी संघा किई तिन्‍नां लै च़ुप्प-च़ुप्पै रोटी-पाणीं दैई। <verse eid="1KI 18:4" /><verse number="5" style="v" sid="1KI 18:5" />अहाब राज़ै बोलअ ओबेदियो लै, “हाम्हां हुअ आपणैं घोल़ै-खच़रा लै घाह-पाच लोल़णअ, नांईं ता लागणै हाम्हां ईंयां पशू मारनै। हाम्हां एछणअ सारै देशै भाल़ी कि किधी गाडा-नाल़ी नेल़ पाणींए बाढै घाह-पाच बी आसा।” <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />तिन्‍नैं बांडअ सारअ देश आधअ-आधअ, आधै देशै डेऊअ अहाब अर आधै देशै डेऊअ ओबेदियो आपणैं आदमी संघा निंईं लोल़ै भाल़ै। <verse eid="1KI 18:6" /><verse number="7" style="v" sid="1KI 18:7" />ओबेदियो भेटअ बाता एलियाह गूर अर तेऊ हेरअ सह बछ़ैणीं संघा टेक्‍कअ धरनीं उटअ पल़ी तेऊ सेटा माथअ, तेखअ बोलअ इहअ, “मेरै मालक, तूह ई आसा भाल़ी?”<verse eid="1KI 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 18:8" />एलियाह बोलअ, “हाँ, हुंह आसा एलियाह, तूह डेऊ संघा बोल आपणैं मालक राज़ै अहाबा लै कि हुंह आसा इधी।”<verse eid="1KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 18:9" />ओबेदियो बोलअ, “ऐबै मेरअ किज़ै कशूर आसा? ज़ै हुंह अहाब राज़ै सेटा डेऊई इहअ खोज़ूं, सह सका मुंह मारी बी! <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />मेरै मालक, तेरअ परमेशर बिधाता ज़ुंण सदा ज़िऊंदअ आसा, हुंह खाआ तेऊए सोह कि राज़ै अहाबै आसा देशै-देशै ताह लोल़ै छ़ाडै दै। ज़ांऊं तूह किधी निं भेटअ, तेऊ बझ़ैल़ै तिन्‍नां देशा-देशे राज़ै का बी सोह खाणैं कि तूह निं तिन्‍नां किधी भेटअ आथी। <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />ऐबै बोला तूह मुल्है इहअ, ‘तूह डेऊ संघा बोल आपणैं मालक राज़ै अहाबा लै कि हुंह आसा इधी!’ <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />एतो कै थोघ आसा कि मेरै इधा का डेऊंदी बिधाते आत्मां ताह हेरा-हेरी किधी एही ज़ैगा पजैल़े ज़ेतो कहा का थोघ ई निं हंदअ! तेखअ ज़ांऊं मुंह अहाब राज़ै का इहअ खोज़णअ कि तूह आसा इधी अर तेऊ निं तूह इधी भेटणअ अर हुंह पाणअ तेऊ मारी ई! ऐहा गल्‍ला बी कर आद कि हुंह तेरअ दास मना होछ़ी उझै बिधाता ई। <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />मेरै मालक, तंऐं ईंयां गल्‍ला निं शूणीं कि ज़धू जज़बेल बिधाते गूरा मारदी ती लागी दी, तधू डाहै तै मंऐं कोई शौ गूर पज़ाह-पज़ाहे छ़ुंढा दी तैहा डरै जुहल़ी च़ोरी संघा करा त हुंह तिन्‍नां लै च़ुप्प-च़ुप्पै रोटी-पाणीं दैई? <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />तै केऊ साबै बोला तूह मुल्है, ‘तूह डेऊ संघा बोल आपणैं मालक राज़ै अहाबा लै कि हुंह आसा इधी।’ तेऊ पाणअ हुंह मारी।”<verse eid="1KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15" />एलियाह दैनअ ओबेदियो लै ज़बाब, “स्वर्गे सारी सैने मालक बिधाता ज़ुंण सदा ज़िऊंदअ आसा, हुंह करा तेऊए च़ाकरी। हुंह खाआ तेऊए सोह कि आझ़ प्रघल़णअ मुंह राज़ै सेटा ज़रूर।”<verse eid="1KI 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 18:16" />ओबेदियो डेऊअ अहाब राज़ै सेटा संघा खोज़ी पठी गल्‍ला। तेखअ आअ अहाब एलियाह सेटा लै मिलदअ। <verse eid="1KI 18:16" /><verse number="17" style="v" sid="1KI 18:17" />ज़ांऊं अहाब राज़ै एलियाह भाल़अ, तेऊ बोलअ, “आछ़ा, तूह आसा इधी भाल़ी, तूह इज़राईला लै आफ़त पाणै आल़अ!” <verse eid="1KI 18:17" /><verse number="18" style="v" sid="1KI 18:18" />एलियाह दैनअ अहाबा लै ज़बाब, “इज़राईला लै आफ़त पाणै आल़अ निं हुंह आथी, सह आसा तूह अर तेरअ बाब, तिंयां डेऊऐ तम्हैं भाल़ बिधाता छ़ाडी बाल देअए मुहुर्ती पूज़दै। <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />ऐबै कर सोभी इज़राईली लै हुकम संघा एछा मुंह सेटा कर्मेल धारा प्रैंदै। तिन्‍नां संघै आणै च़ार शौ पज़ाह गूर बाल देअए अर च़ार शौ गूर अशेरा देबीए ज़सरअ साथ जज़बेल राणीं दैआ।” <verse eid="1KI 18:19" /><verse number="20" style="v" sid="1KI 18:20" />अहाब राज़ै शादै सोभ इज़राईली अर बाल देअ अर अशेरा देबीए गूर कर्मेल धारा लै संघा किअ तिन्‍नैं सोभी तिधी झाल़अ। <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />एलियाह डेऊअ लोगा सेटा लै संघा बोलअ इहअ, “तम्हां कधू तैणीं रहणअ दुही बाता? ज़ै परमेशर बिधाता आसा, तै पूज़ा तेऊ! ज़ै बाल देअ आसा परमेशर, तै पूज़ा तम्हैं तेऊ! <verse eid="1KI 18:21" /><verse number="22" style="v" sid="1KI 18:22" />हुंह आसा बिधाते गूरा मांझ़ै एक्‍कै बच़अ द, पर बाल देअए आसा इधी च़ार शौ पज़ाह गूर! <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />तम्हैं आणा इधी दूई बल्द। एक दैआ बाल देअए गूरा लै, तेखअ करा तेऊ बल़ीदान संघा डाहा तेतो मास्स बेदीए झ़ुका प्रैंदै पर आग निं तेथ चैल़ी। बल़ीदाना लै ज़ुंण पशू मेरअ हणअ, हुंह बी करूं तिहअ ई अर हुंह बी निं तेथ आग चैल़दअ। <verse eid="1KI 18:23" /><verse number="24" style="v" sid="1KI 18:24" />बाल देअए गूर करै आपणैं देअआ सेटा अरज़ अर हुंह करूं बिधाता सेटा। तेखअ ज़ुंण सरगा का आग शोटी ज़बाब दैए सह ई हणअ असली परमेशर।”</para>
  <para style="p" vid="1KI 18:24">सोभी लोगै बोलअ, “हाँ, ठीक आ, इहअ करा तै।”<verse eid="1KI 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 18:25" />तेखअ बोलअ एलियाह बाल देअए सोभी गूरा लै, “तम्हैं आसा खास्सै, तम्हैं छ़ांटा आप्पू लै बाछ़ू संघा करा हूम करना लै बल़ी तैर। तेखअ लआ तम्हैं आपणैं देअआ का अरज़ करी, पर बेदी दी आग निं चैल़ी आथी।”<verse eid="1KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 18:26" />लोगै आणअ एक बाछ़ू संघा दैनअ बाल देअए गूरा लै। तिन्‍नैं डाहअ सह बेदी प्रैंदै बल़ीदान करी, तेखअ रहै दोत्ता पोर्ही दपहरै तैणीं आपणैं बाल देअआ का अरज़ करदै लागी। तिंयां थिऐ ज़ोरै-ज़ोरै एही अरज़ करदै लागै दै, “हे बाल देअआ, म्हारी अरज़ शुण! म्हारी शुण!” संघा रहै मिट्टदै-छ़ेर्हदै अर बेदी फेर फेरी दैंदै लागी ज़ुंण तिन्‍नैं बणाईं ती। पर तिन्‍नां निं किछ़ ज़बाब भेटअ।<verse eid="1KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 18:27" />दपहरै लागअ बिधातो गूर एलियाह इहअ बोली तिन्‍नें सुहांगा करदअ, “होर ज़ोरै-ज़ोरै पाआ लैल़ा! सह आसा थारअ देअ! झ़ाणीं सह किधी आपणैं धैनै होए बेठअ द, कि किधा लै डेऊअ द होए! हई सका कि सह निंजा होए सुत्तअ द! तम्हां हुअ सह खल़अ झ़ैऊंणअ!” <verse eid="1KI 18:27" /><verse number="28" style="v" sid="1KI 18:28" />बाल देअए गूर लागै ज़ोरै-ज़ोरै अरज़ करदै संघा लागै तिन्‍नें रबाज़े साबै आपणीं घेरी छ़ूरी-बर्छ़ै करै च़िरै दैंदै कि तिन्‍नें घेरी का लागी लोधल़े छेरा! <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />तिंयां रहै दपहरा बाद बी खास्सी घल़ी तिहै ई मिट्टदै-छ़ेर्हदै लागी पर तिन्‍नां निं किछ़ै ज़बाब भेटअ! होर ता होर तिन्‍नें देअआ बाखा निं धख ज़ेही छ़ेल़-छ़ुणक बी हुई!<verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />तेखअ बोलअ एलियाह खिरी लोगा लै, “तम्हैं एछा ओर्ही मुंह नेल़।” लोगै किअ तेऊ फेर झाल़अ। तेखअ लागअ एलियाह बिधाते तैहा पराणीं बेदी भिई च़िणदअ ज़ुंण ढोल़ी दी थिई। <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />एलियाह छ़ांटै इज़राईले बारा गोत्रे साबै बेदी च़िणणा लै बारा पात्थर। बिधातो त इहअ समाद याकबा सेटा पुजी गअ द, “तेरअ नाअं हणअ इज़राईल।”<note caller="-" style="x"><char style="xo" closed="false">18:31 </char><char style="xt" closed="false"><ref loc="GEN 32:28">मूल. 32:28</ref>; <ref loc="GEN 35:10">35:10</ref></char></note> <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />तिन्‍नां पात्थरा करै बणाईं तेऊ बिधाते नाओंऐं एक बेदी। तेथ फेर खण्हीं तेऊ डुघी खाल़्ही ज़ेथ खास्सअ पाणीं एछी सके। <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />तेखअ सज़ाऊई तेऊ बेदी प्रैंदै झ़ुका, बाछ़ू बल़ीदान करी किऐ तेते ठोर-ठोर संघा डाहअ तेतो सह मास्स बेदीए तिन्‍नां झ़ुका प्रैंदै। तेखअ बोलअ तेऊ लोगा लै, “च़ार घल़ै आणा पाणींए संघा तरैल़ा तिन्‍नां बेदी हूम बल़ी अर झ़ुका प्रैंदै।” <verse eid="1KI 18:33" /><verse number="34" style="v" sid="1KI 18:34" />तेखअ बोलअ एलियाह, “भिई तरैल़ा एथ प्रैंदै च़ार घल़ै पाणींए।” लोगै किअ तिहअ ई। तेखअ बोलअ एलियाह, “होर आणा च़ार घल़ै पाणींए संघा तरैल़ा बेदी प्रैंदै।” चिऊथी बारी बी किअ तिन्‍नैं तिहअ ई।<verse eid="1KI 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 18:35" />सह पाणीं पल़अ बेदी प्रैंदै एतरअ कि बेदी फेर फिरदी ज़ुंण खाल़्ही कोती ती, सह हुई पाणीं करै भरी।<verse eid="1KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36" />सह थिई उडै बिधाता लै बल़ीदान करने बेल, एलियाह गूर डेऊअ बेदी सेटा संघा किई बिधाता का एही अरज़, “हे आबराम, इसहाक अर याकबे परमेशर बिधाता! आझ़ लोल़ी अह गल्‍ल सोभी का शुझुई कि इज़राईलो परमेशर आसा तूह ई अर हुंह आसा तेरअ दास अर सोभी का लोल़ी थोघ लागअ कि ज़ुंण मंऐं किअ, तेता करना लै त मुल्है तंऐं हुकम किअ द। <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />हे बिधाता, तूह शुण मेरी अरज़ संघा दै एतो ज़बाब, ताकि इधी सोभी लोगा का थोघ लागे कि तूह ई आसा परमेशर अर तंऐं शादै ईंयां भिई आप्पू लै बापस।”<verse eid="1KI 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38" />हेरा-हेरी शोटी बिधाता सरगा का आग अर हूम बल़ीदान किऐ दै मास्सो, झ़ुका अर बेदीए पात्थरा संघी हुअ धरनीं छ़ार अर बेदी फेर पाणीं शुक्‍कअ पठी। <verse eid="1KI 18:38" /><verse number="39" style="v" sid="1KI 18:39" />ज़ांऊं तिधी लोगै इहअ च़मत्कार आपणीं आछी भाल़अ, तिन्‍नैं टेक्‍कअ धरनीं उटै पल़ी माथअ संघा लागै इहअ बोल्दै, “बिधाता आसा परमेशर, सिधअ बिधाता ई आसा परमेशर!”<verse eid="1KI 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 18:40" />तेखअ किअ एलियाह गूरै हुकम, “इना बाल देअए गूरा ढाका सोभी, ईंयां निं इधा का ठुर्है लोल़ी!” लोगै ढाकै तिंयां सोभ अर एलियाह निंयैं तिंयां उंधै किशोन गाडा लै संघा पाऐ तिधी सोभ मारी।<verse eid="1KI 18:40" /></para>
  <para style="s">देशै शुक्‍कअ हुअ खतम</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41" />तेखअ बोलअ एलियाह अहाब राज़ै लै, “ऐबै डेऊ संघा खा-पिई। मुखा शुण्हिंआं इहअ कि पाणींओ हर्हल-खर्हल च़ाल्‍लअ रिंगी।”<verse eid="1KI 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 18:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:42 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:42-45">18:42-45</ref>; <ref loc="JAS 5:18">याक. 5:18</ref></char>
    </note>ज़ांऊं अहाब राज़अ खांदअ-पिंदअ डेऊअ, एलियाह उखल़अ कर्मेल धारे च़ुंडी लै संघा पल़अ धरनीं उटी बाखा, आपणअ मूंड किअ तेऊ उंधै ज़ान्हूं जैंदरी उटअ, <verse eid="1KI 18:42" /><verse number="43" style="v" sid="1KI 18:43" />तेखअ बोलअ तेऊ आपणैं दासा लै, “उझै निखल़ आजू ज़िहअ संघा भाल़ समुंदरा बाखा।” सह दास उखल़अ उझै आजू ज़िहअ समुंदरा बाखा भाल़अ संघा बोलअ, “एथ निं मुखा किछ़ शुझदअ।” एलियाह बोलअ तेऊ लै, “भिई डेऊ साता बारी भाल़।” <verse eid="1KI 18:43" /><verse number="44" style="v" sid="1KI 18:44" />सातुई बारी ज़ांऊं सह दास बापस फिरअ, तेऊ बोलअ एलियाह लै, “मुखा शुझिआ मणछे हाथा ज़िहअ धख ज़िहअ बादल़।”</para>
  <para style="p" vid="1KI 18:44">एलियाह बोलअ, “तूह डेऊ अहाब राज़ै सेटा लै संघा बोल तेऊ लै, ‘आपणअ रथ ज़ुंडी होथ सरग हणैं का आजी उंधै, नांईं ता तूह शाचणअ एतै।’”<verse eid="1KI 18:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 18:45" />तेतरी गऐ हेरा-हेरी सरगै काल़ै घणैं बादल़ घोर्हुई अर ढिश-बागरी आणै झ़ैऊई अर सरगा का लागअ लोदल़-छ़ोदल़ पाणीं। अहाब राज़अ डेऊअ आपणैं रथा दी शुंआर हई जज्रेल खागा लै। <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />बिधाता दैनअ एलियाह लै इहअ बल कि सह ठुर्हअ अहाब राज़े रथा आजू-आजू जज्रेल खागै तैणीं ज़ांघा हांढी।<verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s">एलियाह डेऊअ सीनाई धारा</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />अहाब राज़ै खोज़ी आपणीं लाल़ी जज़बेला का सारी गल्‍ला कि एलियाह किज़ै किअ अर तेऊ किहै पाऐ बाल देअए गूर मारी। <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />जज़बेलै छ़ाडअ एलियाह सेटा दूत इहअ समाद लई, “ज़िहअ तंऐं बाल देअए गूरा संघै किअ, ज़ै हुंह काल्‍ला ऐहा ई बेला तैणीं ताह संघै बी तिहअ ई निं करूं, तै लोल़ी मेरै देअऐ हुंह ई मारी पाई।” <verse eid="1KI 19:2" /><verse number="3" style="v" sid="1KI 19:3" />एऊ समादा शूणीं डरअ एलियाह खास्सअ, सह ठुर्हअ आपणीं ज़ान बच़ाऊई यहूदा मुल्खै बेर्शेबा नगरी लै।</para>
  <para style="p" vid="1KI 19:3">आपणअ दास डाहअ तेऊ तिधी अर <verse eid="1KI 19:3" /><verse number="4" style="v" sid="1KI 19:4" />आप्पू डेऊअ दुजी सारी धैल़ी हांढी करै रेगीस्तानै संघा बेठअ एकी मधनूंए बूटा हेठै। सह लागअ तिधी इहअ बोली बिधाता का मौत मांगदअ, “हे बिधाता, ऐबै हुअ, मुल्है दै ऐबै मौत, हुंह निं आपणैं दादा-बाबा का राम्बल़अ आथी।”<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="JHN 4:3">जोह. 4:3</ref></char></note><verse eid="1KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 19:5" />सह रहअ तेऊ मधनूंए बूटा हेठै सुत्ती अर तेऊ आई तिधी घणीं नींज। तिधी आअ एक स्वर्ग दूत तेऊ छ़ुंहंअ सह आपणैं हाथा करै संघा बोलअ, “खल़अ उझ़ू संघा खा रोटी।” <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />एलियाह लागअ फेर भाल़अ अर तेखअ शुझुअ तेऊ का आपणैं शरैहणा बाखा आसा पात्थरा प्रैंदै एकी सटेऊई दी रोटी अर झ़ारी दी आसा पाणीं। तेऊ रोटी खाई अर पाणीं झुटअ, तेखअ रहअ भिई तिधी सुत्ती। <verse eid="1KI 19:6" /><verse number="7" style="v" sid="1KI 19:7" />बिधातो स्वर्ग दूत आअ तेऊ सेटा दुजी बारी भिई संघा झ़ैऊअ इहअ बोली खल़अ, “खल़अ उझ़ू संघा खा, अज़ी आसा ताह आजू खास्सअ हांढणा लै।” <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />एलियाह उझ़ुअ खल़अ तेखअ खाई तेऊ भिई रोटी अर पाणीं बी झुटअ। तेखअ आअ तेऊ इहअ बल कि सह रहअ च़ाल़्ही धैल़ी अर च़ाल़्ही राची हांढदअ लागी संघा पुजअ बिधाते पबित्र होरेब धारा। <verse eid="1KI 19:8" /><verse number="9" style="v" sid="1KI 19:9" />तिधी रहअ सह बैल़ी एकी डुआरै।</para>
  <para style="p" vid="1KI 19:9">बिधाता बोलअ तेऊ लै इहअ, “एलियाह, तूह इधी किज़ै करा?”<verse eid="1KI 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 19:10" />एलियाह दैनअ ज़बाब, “हे स्वर्गे सारी सैने मालक बिधाता, मंऐं किई कबल्‍ली तेरी ई च़ाकरी, पर इज़राईली परज़ा निं ताह संघै किई दी करारा लै शुचै-पाक्‍कै रहै! तिन्‍नैं पाई तेरी बेदी ढोल़ी अर तेरै गूर पाऐ मारी। हुंह आसा तेरअ एक्‍कै गूर बच़अ द अर ऐबै आसा तिंयां मेरै पिछ़ै पल़ै दै कि मुंह मारी पाए!”<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="ROM 11:3">रोम. 11:3</ref></char></note><verse eid="1KI 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 19:11" />बिधाता बोलअ एलियाह लै, “तूह डेऊ उझै धारे च़ुंडी लै संघा खल़्हू मुंह सेटा।”</para>
  <para style="p" vid="1KI 19:11">बिधाता डेऊअ एलियाह आजू बाती पोर्ही अर तिधी हुई बिधाता करै एही ढिश-बागर कि सारी धार झ़ील़ी-काम्बी अर भिल़ी का लागै पात्थर अल़दै। पर बिधाता निं तैहा ढिश-बागरी जैंदरी आथी त। ढिश-बागरी बाद हुई तिधी बेघै बडी ज़ाज़री पर बिधाता निं तैहा ज़ाज़री दी बी आथी त। <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />ज़ाज़री बाद शुझुई तिधी आग पर बिधाता निं तैहा आगी जैंदरी बी आथी त। आगी बाद शुण्हुंअ सुलै करै एक बोल।<verse eid="1KI 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 19:13" />ज़ांऊं एलियाह का सह बोल शूणअ, तेऊ ढोपअ आपणअ मुंह च़ादरू करै संघा निखल़अ डुआरा का तेते मोहरै लै। तेखअ शुण्हुंअ तिधी भिई सुलै करै इहअ बोल, “एलियाह, तूह इधी करा किज़ै?”<verse eid="1KI 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 19:14" />एलियाह दैनअ ज़बाब, “हे स्वर्गे सारी सैने मालक बिधाता, मंऐं किई कबल्‍ली तेरी ई च़ाकरी, पर इज़राईली परज़ा निं ताह संघै किई दी करारा लै शुचै-पाक्‍कै रहै! तिन्‍नैं पाई तेरी बेदी ढोल़ी अर तेरै गूर पाऐ मारी। हुंह आसा तेरअ एक्‍कै गूर बच़अ द अर ऐबै आसा तिंयां मेरै पिछ़ै पल़ै दै कि मुंह मारी पाए!”<verse eid="1KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 19:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:15 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 8:7-13">2 राज़. 8:7-13</ref>
      </char>
    </note>बिधाता बोलअ एलियाह लै, “तूह डेऊ दमिश्क नगरी नेल़ रेगीस्ताना लै फिरी, तेखअ डेओऐ नगरी लै संघा करै तिधी करै तूह हज़ाएले मुंडै तेल तरैल़ी करै अभिषेक कि सह हणअ आजू अराम देशो राज़अ अर <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" />इज़राईला दी आगलअ राज़अ हणां लै करै निमशीए शोहरू ज़ैऊओ अभिषेक अर ताह बाद मेरअ गूर हणअ आजू अबेल-मेहोल नगरीए शापातो शोहरू एलिशा तेऊओ बी करै अभिषेक।<note caller="-" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2KI 9:1-6">2 राज़. 9:1-6</ref></char></note> <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />तेखअ ज़ुंण हज़ाएले हाथै मरनै का बच़े, तिंयां पाणै ज़ैऊ मारी अर ज़ुंण ज़ैऊ का बच़े तिंयां पाणै एलिशा मारी। <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />तैबी डाहणैं मुंह इज़राईली मांझ़ै सात हज़ार मणछ ज़िऊंदै ज़ुंणी बाल देअआ सेटा माथअ निं टेक्‍कअ अर तेते मुहुर्ती लै माख्खू निं दैनअ।”<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="ROM 11:4">रोम. 11:4</ref></char></note><verse eid="1KI 19:18" /></para>
  <para style="s">एलिशा छ़ांटअ गूर</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19" />तेखअ लागअ एलियाह तिधा का हांढदअ, बाता भेटअ तेऊ शापातो शोहरू एलिशा खेचै हल़ा लांदअ लागअ द, तेऊ आजू तै गैरा ज़ोल़ी बल्द अर बार्हूई ज़ोल़ी संघै त सह सोभी का पिछ़ू आप्पू। एलियाह डेऊअ तेऊ सेटा संघा पाअ आपणअ च़ादरू तेऊ प्रैंदै। <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />एलिशा छ़ाडै आपणैं हल़-बल्द तिधी संघा ठुर्हअ एलियाह गूरा पिछ़ू, एलिशा लागअ इहअ बोल्दअ, “हुंह एछूं आपणैं ईजा-बाबा लै मल़्हैची दैई, तेखअ एछूं हुंह ताह संघै।”</para>
  <para style="p" vid="1KI 19:20">एलियाह दैनअ तेऊ लै ज़बाब, “डेऊ, मंऐं किधी रोक्‍कअ तूह?”<verse eid="1KI 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 19:21" />एलिशा फिरअ बापस संघा किऐ एक ज़ोल़ी बल्द बल़ीदान, तेते हल़-जूँ पाऐ दहई अर शिखा दैनी लोगा लै खाणां लै अर ज़ांऊं तिंयां खाई मुक्‍कै, तेखअ डेऊअ एलिशा एलियाह गूरा संघै कि तेऊए च़ाकरी करे।<verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s">अराम देशा संघै जुध</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />अराम देशे राज़ै बेन्हदादै झाल़ी आपणीं सारी सैना, तेऊ संघै ज़ुल़ै बत्ती राज़ै तिन्‍नें रथ अर घोल़ै संघी। तिन्‍नां सोभी संघा निंईं छ़ेल़अ बेन्हदादै सामरी नगरी संघै जुध। <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />तेऊ छ़ाडअ तैहा नगरी लै इज़राईले राज़ै अहाबा सेटा इहअ समाद लई दूत, “राज़अ बेन्हदाद बोला ताल्है इहअ, <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />‘ज़ेतरअ ताखा सुन्‍नअ-च़ंदी, बित्ती-बित्ती बेटल़ी अर शोहरू आसा तिंयां आसा मेरै!’”<verse eid="1KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4" />इज़राईले अहाब राज़ै दैनअ तिन्‍नां ई दूता का ज़बाब, “मेरै मालक राज़ै बेन्हदादा लै बोलै इहअ, ‘हाँ हुंह गअ मनी, मेरी सोभै गल्‍ला आसा मुंह संघी तेरी। तूह लागै निंदअ।’”<verse eid="1KI 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5" />बादा का आऐ तिंयां दूत भिई अहाब राज़ै सेटा इहअ समाद खोज़दै, “बेन्हदाद राज़अ बोला ताल्है इहअ, ‘मंऐं दैनअ त ताल्है इहअ समाद कि ज़ेतरअ ताखा सुन्‍नअ-च़ंदी, बेटल़ी अर शोहरू आसा तिंयां पल़णै ताह मुल्है दैणैं। <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />काल्‍ला छ़ाडणैं मुंह आपणैं कार-करिंदै एऊ ई बगती नगरी लै तेरै मैहलै अर तेरै कार-करिंदे घअरै लोल़ै-खरोल़ै, तेखअ ज़ुंण बी तिन्‍नां का किम्मती ज़ाण्हिंए तिंयां च़िज़ा आणनीं तिन्‍नां झाल़ी।’”<verse eid="1KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7" />इज़राईले अहाब राज़ै शादै नगरीए सोभ सैणैं संघा बोलअ, “बेन्हदाद च़ाहा हाम्हां पठी बरैबाद करनअ। सह मांगा मुखा सुन्‍नअ-च़ंदी, बेटल़ी-माठै संघी सारी ज़ैदात अर मंऐं बी बोलअ कि हाँ, तूह लागै निंदअ।”<verse eid="1KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 20:8" />नगरीए सैणैं अर तिन्‍नां संघै होरी लोगै बोलअ, “तूह निं तेऊए गल्‍ला दी धैन ई दैऐ, तूह निं तेऊ लै किछ़ै दैंदअ लागी।”<verse eid="1KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9" />अहाब राज़ै दैनअ बेन्हदाद राज़े दूता का बापस समाद, “मेरै मालक राज़ै बेन्हदादा लै बोलै इहअ, ‘ज़ुंण तंऐं मुखा पैहलै मांगअ, तेता दैणा लै निं मेरी नांह आथी, पर ज़ुंण तूह तेता का लाऊआ बोला, तेता निं हुंह करी सकदअ।’”</para>
  <para style="p" vid="1KI 20:9">तिंयां दूत डेऊऐ संघा आऐ भिई इहअ समाद लई अहाब राज़ै सेटा फिरी कि <verse eid="1KI 20:9" /><verse number="10" style="v" sid="1KI 20:10" />राज़अ बेन्हदाद बोला इहअ, “मुंह करनीं सामरी नगरी एही बरैबाद कि मेरी सैना लै बी निं बापस निंणा लै एक-एक मुठी धूल़अ बी रहणअ। ज़ै हुंह इहअ नांईं करे, तै लोल़ी हुंह ई मेरै देअऐ मारी पाअ!”<verse eid="1KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 20:11" />इज़राईले राज़ै दैनअ ज़बाब, “बेन्हदादा लै बोला इहअ कि ज़ुंण जोधअ अज़ी जुधा लै तैर्हुअ, तेऊ निं जुध ज़ितै दै जोधै ज़िहै सराहुंदै लागणअ।”<verse eid="1KI 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 20:12" />बेन्हदाद त आपणैं डेरै होरी राज़ै संघै झुटदअ बेठअ द। ज़ांऊं तेऊ सेटा अहाब राज़ैओ समाद पुजअ, तेऊ दैनअ आपणीं सैना लै सामरी नगरी संघै जुध छ़ेल़णेंओ हुकम। तिंयां बी हुऐ जुधा लै तैर।<verse eid="1KI 20:12" /></para>
  <para style="s">अहाब ज़ितअ</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />तैहा ई बेला डेऊअ बिधातो एक गूर इज़राईले राज़ै अहाबा सेटा संघा बोलअ इहअ, “बिधाता बोला इहअ, ‘ऐहा एतरी बडी सैना भाल़ी निं डरी आथी! आझ़ दैणीं मुंह ताल्है इना का ज़ीत। तेखअ लागणअ ताखा थोघ कि हुंह आसा बिधाता।’”<verse eid="1KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 20:14" />अहाब राज़ै पुछ़अ, “जुध कहा करनअ?”</para>
  <para style="p" vid="1KI 20:14">बिधाते गूरै बोलअ, “बिधाता बोला इहअ कि, ज़ुआन सपाही ज़ुंण गहल़ै-कोटै कार-करिंदै सेटा च़ाकरी करा।”</para>
  <para style="p" vid="1KI 20:14">अहाब राज़ै बोलअ, “जुधा लै तिन्‍नों सैनापति कुंण हणअ?”</para>
  <para style="p" vid="1KI 20:14">गूरै बोलअ, “तूह हणअ आप्पै।”<verse eid="1KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 20:15" />अहाब राज़ै शादै तिंयां ज़ुआन सपाही ज़ुंण गहल़ै-कोटै थिऐ, तिंयां निखल़ै पठी दूई शौ बत्ती। तेता बाद शादै तेऊ इज़राईली सैना मांझ़ै, तिंयां निखल़ै पठी सात हज़ार मर्ध।<verse eid="1KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 20:16" />तिंयां डेऊऐ दपहरै ज़ेभै बेन्हदाद अर तेऊ संघै ज़ुल़ै दै बत्ती राज़ै तिन्‍नें खिम्भा दी शराबा झुटदै तै लागै दै। <verse eid="1KI 20:16" /><verse number="17" style="v" sid="1KI 20:17" />तिंयां ज़ुआन सपाही गऐ आजी निखल़ी। बेन्हदादे पहरी हेरै तिंयां नगरी का निखल़दै भाल़ी अर तिन्‍नैं खोज़अ तेऊ का, “हाम्हैं भाल़ै एभै सामरी नगरी का धख ज़िहै सपाही निखल़दै।” <verse eid="1KI 20:17" /><verse number="18" style="v" sid="1KI 20:18" />बेन्हदादै दैनअ हुकम, “तेते परबाह निं मुंह आथी कि तिंयां हाम्हां संघै मेल़-ज़ोल़ करदै आऐ होए कि मकाबलै करदै आऐ, पर तिन्‍नां आणै ज़िऊंदै ढाकी।”<verse eid="1KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19" />तिंयां गहल़े ज़ुआन सपाही निखल़ै आजू अर तिन्‍नां पिछ़ू आई नगरी का इज़राईले होर सैना। <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />ज़ुंण बी तिन्‍नें मोहरै आअ, सह पाअ तिन्‍नैं मारी अर अरामी ठुर्है तिन्‍नां डरै अर इज़राईली रहै तिन्‍नां दरल़ाऊंदै पिछ़ू पल़ी। पर बेन्हदाद राज़अ अर तेऊए धख होर साथी ठुर्है घोल़ै प्रैंदै बेशी संघा बच़ै। <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />पर राज़अ अहाब अर इज़राईली सैना ठुर्है तिन्‍नां पिछ़ू ई संघा किअ तिन्‍नें रथ अर घोल़ै दी कबज़अ। तिन्‍नैं किई अरामीए मारी-मारी बूरै हालत।<verse eid="1KI 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22" />बादा का डेऊअ बिधातो गूर इज़राईले राज़ै अहाबा सेटा संघा बोलअ इहअ, “अरामी राज़अ बेन्हदाद एछणअ ताह संघै जुधा लै फिरी, तूह कर आपणीं सैना तैर, राम्बल़ै करै बच़ार करी बणाऐं तरकीब कि किहअ-किहअ करनअ।”<verse eid="1KI 20:22" /></para>
  <para style="s">अरामी आऐ दुजी बारी जुधा लै</para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23" />अरामी राज़ै बेन्हदादे कार-करिंदै बोलअ तेऊ लै, “इज़राईलो देअ आसा धारो देअ। हाम्हैं किअ इज़राईली संघै धारा मकाबलअ, तैही ज़ितै तिंयां हाम्हां का। ज़ै हाम्हैं तिन्‍नां संघै सरली ज़ैगा जुध करे, तै निं हाम्हैं तिन्‍नां का केही बी हारदै। <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />सोभी का आजी कर तूह इहअ, तिन्‍नां बत्ती राज़ै काढ तिन्‍नें पदबी का पोर्ही अर तिन्‍नें ज़ैगा बशैल़ सैनापति। <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />संघा भर होर खास्सै सपाही अर घोल़ै ताकि तेरी सैना पैहलै का खास्सी बलबान होए। तेखअ करनअ हाम्हां इज़राईली सैना संघै सरली ज़ैगा जुध अर तेखअ निं हाम्हां तिंयां ज़िऊंदै छ़ाडणैं।”</para>
  <para style="p" vid="1KI 20:25">राज़ै बेन्हदादै किअ तिहअ ई ज़ेही तेऊए कार-करिंदै तेऊ लै सलाह दैनी। <verse eid="1KI 20:25" /><verse number="26" style="v" sid="1KI 20:26" />नऊंअ संबत एछदी झाल़ी बेन्हदादै आपणीं सारी अरामी सैना संघा पुजअ इज़राईला संघै जुधा करना लै अपेक नगरी। <verse eid="1KI 20:26" /><verse number="27" style="v" sid="1KI 20:27" />इज़राईली बी हुऐ जुधा लै तैर अर तिंयां बी आऐ अरामी सैना संघै मकाबलै लै। इहअ करै पाऐ दुही देशे सैना आर-पार सम्हनै डेरै। सारी ज़ैगा ती अरामी सैना बेठी दी अर इज़राईली सैना ती तिन्‍नां सम्हनै बाकरीए धख ज़िहै छ़ुंढा ज़ेही।<verse eid="1KI 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28" />बिधातो एक गूर डेऊअ इज़राईले राज़ै अहाबा सेटा संघा बोलअ इहअ, “बिधाता बोला इहअ, ‘ईंयां अरामी बोला इहअ कि हुंह आसा धारो देअ अर निऊल़े सरलै मुल्खो निं आथी। तैही लाअ मंऐं तूह ऐबै एतरी खास्सी बलबान सैना का ज़ताऊई। तेखअ लागणअ ताखा बी थोघ कि हुंह आसा बिधाता।’”<verse eid="1KI 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 20:29" />साता धैल़ी तैणीं रहै अरामी अर इज़राईली आर पार स्मोहरै आपणैं डेरै दी। सातुई धैल़ी हुअ तिन्‍नां मांझ़ै जुध शुरू अर एकी ई धैल़ी पाऐ इज़राईली सैना कोई एक लाख अरामी सैना मारी। <verse eid="1KI 20:29" /><verse number="30" style="v" sid="1KI 20:30" />ज़ुंण बच़ै तिंयां ठुर्है अपेक नगरी बाखा लै, तिधी ढूल़अ नगरी फेरो उछ़टअ गहल़ अर तेथ हेठै दाभूई करै मूंऐं तिन्‍नां मांझ़ै सताई हज़ार सपाही।</para>
  <para style="p" vid="1KI 20:30">बेन्हदाद बी ठुर्हअ नगरी भितरी संघा रहअ एकी घअरै किधी पांडा लुक्‍की। <verse eid="1KI 20:30" /><verse number="31" style="v" sid="1KI 20:31" />तेऊए कार-करिंदै डेऊऐ तेऊ सेटा लै संघा बोलअ, “हाम्हैं आसा इहअ शूणअ द कि इज़राईलीए राज़ै हआ झणैल़ू। हाम्हां लै दै कुछी खिंथल़अ अर गल़ै राश्शी बान्हीं इज़राईले राज़ै सेटा डेऊणे ज़ाज़त, तै झ़ाणीं सह ताह ज़िऊंदअ छ़ाडे।” <verse eid="1KI 20:31" /><verse number="32" style="v" sid="1KI 20:32" />तिन्‍नैं बान्हअ कुछी खिंथल़अ अर गल़ै बान्हीं तिन्‍नैं राश्शी संघा बोलअ अहाब राज़ै सेटा डेऊई इहअ, “तेरअ दास बेन्हदाद बोला, ‘ज़ीबाण, मुंह निं मारी आथी।’”</para>
  <para style="p" vid="1KI 20:32">अहाब राज़ै दैनअ ज़बाब, “सह अज़ी बी ज़िऊंदअ आसा? राम्बल़ी हुई, सह आसा मुल्है मेरै भाई ज़िहअ!”<verse eid="1KI 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33" />बेन्हदादे कार-करिंदै तै न्हैल़ै लागै दै कि किज़ै खुशी दैणैं आल़अ नछ़ैण शुझिए, ज़ांऊं अहाब राज़ै बोलअ, “सह आसा मुल्है मेरै भाई ज़िहअ!” तिन्‍नैं ढाकी सह ई गल्‍ल संघा बोलअ, “हाँ, तूह अर बेन्हदाद आसा भाई-भाई ज़िहै!”</para>
  <para style="p" vid="1KI 20:33">अहाब राज़ै किअ हुकम, “ओर्ही आणा तेऊ मुंह सेटा लै।” ज़ांऊं तिन्‍नैं बेन्हदाद राज़अ तिधी पजैल़अ, अहाब राज़ै बशैल़अ सह आप्पू संघै आपणैं रथा दी। <verse eid="1KI 20:33" /><verse number="34" style="v" sid="1KI 20:34" />बेन्हदादै बोलअ अहाबा लै इहअ, “ज़ुंण नगरी मेरै बाबै तेरै बाबा का छ़ड़ैऊई ती, तिंयां दैणीं मुंह ताल्है बापस। ज़िहअ मेरअ बाब सामरी नगरी बपार करा थिअ, तिहअ करै तूह दमिश्क नगरी।”</para>
  <para style="p" vid="1KI 20:34">अहाब राज़ै दैनअ बेन्हदादा लै ज़बाब, “ज़ै तूह इना एतरी गल्‍ला पूरी करे, तै दैणअ मुंह ताह डेऊणैं।” तेखअ किई तिधी तिन्‍नैं आप्पू मांझ़ै करार, संघा दैनअ अहाब राज़ै बेन्हदाद राज़ै डेऊणैं।<verse eid="1KI 20:34" /></para>
  <para style="s">बिधाते एकी गूरै किअ अहाब राज़ैओ बरोध</para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35" />तिन्‍नां ई धैल़ै हुअ इहअ कि बिधाते गूरे छ़ुंढा मांझ़ै किई बिधाता एकी गूरा संघै गल्‍ला, तेऊ गूरै बोलअ आपणैं एकी साथी लै, “मुल्है बाह।” पर तेऊ साथी किअ मारना लै नांह अर <verse eid="1KI 20:35" /><verse number="36" style="v" sid="1KI 20:36" />तेऊ गूरै बोलअ तेऊ साथी लै, “ज़ेतरी तूह मुंह सेटा का दूर डेऊणअ, तूह पाणअ एकी सिहा मारी किल्हैकि तंऐं निं बिधातो हुकम मनअ।” हुअ बी तिहअ ई ज़ेतरी तेऊओ सह साथी तेऊ सेटा का डेऊअ, तेऊ भेटअ बाता एक सिह अर तेऊ पाअ सह मारी।<note caller="-" style="x"><char style="xo" closed="false">20:36 </char><char style="xt" closed="false"><ref loc="1KI 13:24">1 राज़. 13:24</ref></char></note><verse eid="1KI 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 20:37" />तेखअ भेटअ तेऊ गूरा एक होर मणछ, तेऊ लै बी बोलअ तेऊ इहअ ई, “मुल्है बाह।” तेऊ मणछै बाही तेऊ लै एही कि सह हुअ ज़खमी। <verse eid="1KI 20:37" /><verse number="38" style="v" sid="1KI 20:38" />तेखअ लागअ सह गूर तिधा का हांढदअ अर तेऊ डाहअ आपणअ मुंह साफै करै ढोपी संघा रहअ बाते बाढै अहाब राज़ै तेस्सी बाती एछदै न्हैल़अ लागी। <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />ज़ांऊं अहाब राज़अ तेस्सी बाती डेऊंदअ त लागअ द, तेऊ गूरै पाई हाक, “माहा राज़अ, हुंह त घणैं जुधा जैंदरी मकाबलै करदअ लागअ द, एकी सपाही आणअ एक दुशमण कैद करी मुंह सेटा संघा बोलअ इहअ, ‘एऊ मणछो डाहै धैन हेरे ज़ै अह ताखा छ़ुटी ठुर्हे, तै लागणअ तेऊए बदल़ै ताह मरनअ, कि लागणै चअन हज़ार च़ंदीए सिक्‍कै दैणैं।’ <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />पर हुंह शाचअ ओर्ही-पोर्ही किधी होरी कामैं अर सह दुशमण सपाही छ़ुटअ मुखा।”</para>
  <para style="p" vid="1KI 20:40">इज़राईले अहाब राज़ै बोलअ तेऊ लै इहअ, “तंऐं किअ आपणअ नसाफ आप्पै, ज़िहअ तंऐं बोलअ, ताह भेटणीं तेही ई सज़ा।”<verse eid="1KI 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41" />तेखअ काढअ तेऊ गूरै आपणैं मुंहैं पल़ेटअ द साफअ पोर्ही अर तैबै जाई बछ़ैणअ अहाब राज़ै कि अह आसा कुंण गूर। <verse eid="1KI 20:41" /><verse number="42" style="v" sid="1KI 20:42" />तेखअ बोलअ तेऊ गूरै राज़ै लै, “बिधाता बोला ताल्है इहअ, ‘मंऐं ताल्है ज़हा मारनैओ हुकम किअ, सह छ़ाडअ तंऐं पोर्ही, एते किम्मत लागणीं ताह आपणीं ज़िन्दगी दैणीं अर तेऊए परज़ा पिछ़ू लागणअ तेरी परज़ा मरनअ।’”<verse eid="1KI 20:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 20:43" />तेखअ फिरअ इज़राईलो राज़अ अहाब धिठअ अर तेऊ पल़अ हैल़अ संघा लागअ आपणैं घअर सामरी नगरी लै हांढदअ।<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s">नबातो दाखो बाग</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />नबात नाओंए मणछो थिअ जज्रेल सामरी नगरीए राज़ै अहाबे मैहला नेल़ एक दाखो बाग। <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />एकी बारी बोलअ अहाब राज़ै नबाता लै, “नबात, तेरअ दाखो बाग आसा मेरै मैहला नेल़, तूह दै एऊ बागा मुल्है, मुंह पज़ेरनी एथ शाग-भाज़ी। एते बदल़ै दैंऊं हुंह ताल्है एता का बी बधिया बाग, ज़ै इहअ ताह नांईं गम्मा, तै दैणअ मुंह एतो ताल्है ज़ेतरै तूह बोले तेतरै ढब्बै मोल।”<verse eid="1KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3" />नबातै बोलअ अहाब राज़ै लै, “अह बाग आसा मेरै दादा-बाबे जदी ज़ैगा, इहअ निं लोल़ी त बिधाता कधि किअ कि अह बाग मुंह ताल्है पल़े दैणअ!”<verse eid="1KI 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 21:4" />राज़अ अहाब डेऊअ मुंह शेऊई फिरी, तेऊ आई जज्रेल नगरीए नबाता लै खास्सी रोश्शै ज़ुंण तेऊ इहअ बोलअ, “आपणैं दादा-बाबे जदी ज़ैगा निं हुंह ताल्है दैंदअ।” सह रहअ भित्ती बाखा मुंह करी सुत्ती अर तेऊ निं रोटी बी खाई। <verse eid="1KI 21:4" /><verse number="5" style="v" sid="1KI 21:5" />तेऊए राणीं जज़बेल डेऊई तेऊ सेटा लै संघा पुछ़अ, “तंऐं किल्है आसा इहअ मुंह शेऊई डाहअ द? तूह रोटी किल्है निं खांदअ?”<verse eid="1KI 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 21:6" />अहाब राज़ै दैनअ ज़बाब, “हुंह लागअ जज्रेल नगरीए नबाता लै बोल्दअ कि आपणैं एऊ दाखे बागा दै मुल्है हुंह दैंऊं ताल्है एते बदल़ै होर, कि दैंऊं हुंह एतो तेऊ लै ज़ेतरै सह बोले तेतरै ढब्बै मोल, पर तेऊ किअ तेता दैणा लै नांह!”<verse eid="1KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 21:7" />अहाब राज़े राणीं जज़बेलै बोलअ इहअ, “तूह इज़राईलो राज़अ आसा कि नांईं आथी? आपणैं च़ैना का उझ़ू खल़अ संघा रह खाई-पिई खुश! हुंह दैंऊं भाल़ै जज्रेल नगरीए नबातो दाखो बाग ताल्है लई!”<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />तेखअ लिखी जज़बेलै अहाब राज़े नाओंऐं एक च़िठी अर तेथ लाई अहाब राज़े मोहर। तेखअ दैनी सह च़िठी जज्रेल नगरीए सैणैं अर कार-करिंदै सेटा ज़ुंण नबाता नेल़ रहा तै। <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />तैहा च़िठी दी थिअ इहअ लिखअ द, “सोभी लोगो करा झाल़अ संघा बोला तिन्‍नां लै इहअ कि आझ़ करा सोभै ब्रत अर नबाता बशैल़ै सोभी का आजू उछ़टी गाद्दी दी। <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />तेखअ बशैल़ै दूई उपद्रभी शल़ैघी मणछा तेऊ आजू स्मोहरै ज़ुंण तेऊए बारै एही झ़ुठी शाजत दैए, ‘तंऐं किई परमेशर अर राज़े निंदा।’ तेखअ निंयैं नबाता नगरी बागै संघा दैऐ तेऊ लै पात्थरो ढो कि तेऊए मौत होए।”<verse eid="1KI 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11" />नगरीए सैणैं अर कार-करिंदै किअ तिहअ ई ज़िहअ जज़बेलै तैहा च़िठी दी हुकम किअ त। <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />तिन्‍नैं झाल़ै सोभ लोग संघा बोलअ सोभी लै ब्रत करना लै, नबात बशैल़अ तिन्‍नैं सोभी का आजू उछ़टी गाद्दी दी। <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />तेऊ सम्हनै बशैल़ै दूई उपद्रभी मणछ अर तिन्‍नैं दैनी एही झ़ुठी शाजत, “नबातै किई परमेशर अर राज़े निंदा।” ऐहा गल्‍ला पिछ़ू निंयं सोभी लोगै नबात नगरी बागै संघा दैनअ सोभी पात्थरो ढो कि तेऊए हुई मौत। <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />तेखअ दैनअ तिन्‍नैं जज़बेला लै समाद, “नबात हेरअ पात्थरो ढो दैई मारी।”<verse eid="1KI 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15" />ज़िहअ ई जज़बेला सेटा समाद पुजअ, तैहा बोलअ अहाब राज़ै लै, “जज्रेल नगरीओ नबात गअ मरी, ऐबै कर तूह तेऊए दाखे बागा दी कबज़अ ज़ेता सह ताल्है ढब्बै करै बी निस्सअ त दैई।” <verse eid="1KI 21:15" /><verse number="16" style="v" sid="1KI 21:16" />ज़ांऊं अहाब राज़ै इहअ शूणअ कि जज्रेल नगरीओ नबात मूंअ, सह उझ़ुअ तेभी खल़अ कि ऐबै करनअ नबाते दाखे बागा दी तेऊ कबज़अ।<verse eid="1KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17" />बिधाता बोलअ आपणैं गूर तिशबा नगरीए एलियाह लै, <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />“तूह डेऊ सामरी नगरी इज़राईले राज़ै अहाबा सेटा। सह भेटणअ ताह नबाते दाखे बागा दी। सह आसा तेथ तेऊ बागा आप्पू लै कबज़ै करदअ डेऊअ द। <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />तेऊ लै बोलै तूह इहअ कि बिधाता बोला ताल्है इहअ, ‘नबाते हत्या करी ऐबै तूह तेऊए ज़ैदातो मालक बी च़ाल्‍लअ बणी?’ तेऊ लै बोलै इहअ कि हुंह बिधाता बोला ताल्है इहअ, ‘ज़हा ज़ैगा कुक्‍करै नबातो लोहू च़ाटअ, तैहा ई ज़ैगा च़ाटणअ कुक्‍करा तेरअ लोधल़अ बी!’”<verse eid="1KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20" />ज़ांऊं अहाब राज़ै का एलियाह शुझुअ, तेऊ बोलअ, “आरा तूह आसा मेरअ पाक्‍कअ दुशमण, ताखा गअ इधी बी मेरअ थोघ लागी?”</para>
  <para style="p" vid="1KI 21:20">एलियाह दैनअ अहाब राज़ै लै ज़बाब, “हाँ, मुखा गअ थोघ लागी, हुंह आअ इधी एते तैणीं कि तूह आसा तिन्‍नां ई कदुष्ट कामां करना लै पठी बिक्‍कअ द ज़ेता लै बिधाता नफरत करा। <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />तैही बोलअ बिधाता ताल्है इहअ, ‘ताल्है पाणीं मुंह एही डरैऊंणी आफ़त कि तेरै खिंबा दी पाणै मुंह होछ़ै, प्रोढै अर गलाम सोभ मर्ध मारी। <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />तेरी खिंब हणीं नबाते शोहरू राज़ै जरोबाम अर आहिजे शोहरू राज़ै बाशा ज़ेही।’ ज़ुंण तंऐं पाप किअ तेता करै ठैऊई तंऐं बिधाता लै होर बी खास्सी रोश्शै अर इज़राईली का बी कराऊअ तंऐं पाप। <verse eid="1KI 21:22" /><verse number="23" style="v" sid="1KI 21:23" />तेरी राणीं जज़बेला लै बोला बिधाता इहअ, ‘तेसे ल्हास थोस्सणी जज्रेल नगरी कुक्‍करा।’<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="2KI 9:36">2 राज़. 9:36</ref></char></note> <verse eid="1KI 21:23" /><verse number="24" style="v" sid="1KI 21:24" />अहाब राज़ेए होर रिश्तैदार बी ज़ुंण मरे, तिन्‍नें ल्हासा बी खाणीं कुक्‍करा अर ज़ुंण नगरी बागै मरे तिन्‍नें ल्हासा च़ोच़ल़णी काअ-गरली।”<verse eid="1KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25" />अहाब राज़ै ज़िहअ इहअ निं कोहै राज़अ हुअ ज़ुंण आपणीं बेटल़ी जज़बेले ज़ाणैं लागी पठी तिन्‍नां कदुष्ट कामां करना लै बिक्‍कअ ज़ेता का बिधाता नफरत करा। <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />अहाब राज़ै किऐ मुहुर्ती पूज़ा करी च़िल़्हखरै काम ज़ुंण तिंयां अमोरी लोग करा तै ज़ुंण बिधाता तैहा ज़ैगा इज़राईली पुजणैं का आजी का दूर काढै तै।<verse eid="1KI 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27" />ज़ांऊं एलियाह गूर इना गल्‍ला खोज़ी मुक्‍कअ, अहाब राज़ै शोटै आपणैं झिकल़ै धेल़ी करै पोर्ही संघा पल़ेटअ घेरी खिंथल़अ। तेखअ रहअ तेऊ ई खिंथल़ै संघै भुखअ सुत्ती अर तिहअ ई पल़ी अर सह रहा त मुंडकी ढोल़ी सुलै-सुलै मस्सा हांढदअ लागी।<verse eid="1KI 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 21:28" />तेखअ पुजअ बिधातो समाद तिशबा नगरीए एलियाह सेटा, <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />“तंऐं भाल़अ बी कि राज़अ अहाब आसा ऐबै आपणैं किऐ लै पठी पछ़ताअ द? तेऊए ज़िऊंदी ज़िता निं मुंह तेऊए खिंबा लै सज़ा दैणीं। ज़ुंण मंऐं बोलअ, तिंयां गल्‍ला निभणी ज़ांऊं आजू एऊए शोहरूओ राज़ हणअ।”<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s">बिधाते गूर मिका दैनी अहाब राज़ै लै चतैनगी</para>
  <para style="r">(<ref loc="2CH 18:2-27">2 इतिहास 18:2-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />दूई साला तैणीं निं इज़राईल अर अराम देशा आप्पू मांझ़ै कोई लल़ाई झ़गल़अ हुअ। <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />पर चिऊथी साला डेऊअ यहूदा मुल्खो राज़अ जहोशापात इज़राईले राज़ै अहाबा सेटा।<verse eid="1KI 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 22:3" />इज़राईल राज़ै अहाबै पुछ़ै आपणैं कार-करिंदै, “हाम्हैं किल्है निं गलादे मुल्खे रामोत नगरी अराम देशे राज़ै का बापस छ़ड़ैऊंणा लै किज़ै किअ? अह नगरी आसा म्हारी।” <verse eid="1KI 22:3" /><verse number="4" style="v" sid="1KI 22:4" />अहाब राज़ै पुछ़अ जहोशापात, “गलाद मुल्खै रामोत नगरी ताह मेरी साथा अरामी संघै जुधा लै एछणअ ऐ?”</para>
  <para style="p" vid="1KI 22:4">जहोशापातै बोलअ इज़राईले राज़ै लै, “हो, हाम्हैं आसा दुहै एक। मेरी सैना आसा तेरी बी सैना अर मेरै घोल़ै बी आसा तेरै बी घोल़ै। <verse eid="1KI 22:4" /><verse number="5" style="v" sid="1KI 22:5" />पर तेता का आजी लणअ हाम्हां बिधाता का पुछ़ी कि सह किज़ै बोला।”<verse eid="1KI 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 22:6" />तेखअ शादै इज़राईले राज़ै अहाबै कोई च़ार शौ गूर संघा पुछ़ै तिंयां, “हुंह गलाद रामोत नगरी अरामी संघै जुध छ़ेल़ूं कि रहणैं दैंऊं?”</para>
  <para style="p" vid="1KI 22:6">तिन्‍नैं बोलअ, “तूह छ़ेल़ तिन्‍नां संघै जुध तेरै मालक बिधाता हेरनअ तूह ज़ताऊई।”<verse eid="1KI 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 22:7" />पर जहोशापातै पुछ़अ, “इधी बिधातो कुंण होर गूर बी किनी आसा ताकि तेऊ पुछ़ी हाम्हां ऐहा गल्‍ला लै निहंचअ होए?”<verse eid="1KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 22:8" />अहाब राज़ै दैनअ जहोशापाता लै ज़बाब, “एक गूर आसा होर, इमलो शोहरू मिका तेऊ बाती बी सका हाम्हैं बिधाता पुछ़ी। पर तेऊ गूरे लागा मुंह रोश्श किल्हैकि सह निं मुल्है कधू राम्बल़अ खोज़दअ ई आथी, सह खोज़ा कबल्‍लअ बूरअ ई।”</para>
  <para style="p" vid="1KI 22:8">जहोशापातै बोलअ इज़राईले राज़ै लै, “तूह निं इहअ बोलै आथी!”<verse eid="1KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 22:9" />तेखअ शादअ अहाब राज़ै एक दरबारी संघा किअ तेऊ लै हुकम, “इमले शोहरू मिका आण एभी शादी।”<verse eid="1KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10" />इज़राईलो राज़अ अहाब अर यहूदो राज़अ जहोशापात तै दुहै ज़ण्हैं राज़े सुआबा बान्हीं सामरी नगरीए प्रऊल़ी बागै आपणीं-आपणीं गाद्दी दी बेठै दै। सोभै गूर तै तिन्‍नां सेटा आजू हणैं आल़ी गल्‍ला प्रगट करदै लागै दै। <verse eid="1KI 22:10" /><verse number="11" style="v" sid="1KI 22:11" />कनाने शोहरू सिदकिया गूरै बणाऐं लोहे शींग संघा बोलअ अहाब राज़ै लै, “बिधाता बोला इहअ, ‘इना शींगा करै करनअ ताह अरामी संघै जुध अर तिंयां करनै ताह पठी मारी खतम।’” <verse eid="1KI 22:11" /><verse number="12" style="v" sid="1KI 22:12" />होरी गूरै बी बोली एही गल्‍ल, “राज़अ, तूह निखल़ गलाद मुल्खे रामोत नगरी जुधा लै, बिधाता हेरनअ तूह ज़ताऊई।”<verse eid="1KI 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13" />ज़ुंण दरबारी अहाब राज़ै मिका सेटा लै दूत छ़ाडअ त, तेऊ बोलअ मिका लै, “होरी सोभी गूरै खोज़अ इहअ कि राज़अ हणअ सफल, तूह च़ाल्‍ल संघा खोज़ै तूह बी इहअ ई।”<verse eid="1KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 22:14" />पर मिका दैनअ ज़बाब, “हुंह काढा तेऊ बिधाते सोह ज़ुंण सदा ज़िऊंदअ आसा, ज़िहअ सह मुखा खोज़े मुंह बोल़णअ तिहअ ई!”<verse eid="1KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15" />ज़ांऊं मिका राज़ै सेटा पुजअ, अहाब राज़ै पुछ़अ तेऊ का, “मिका, तूह खोज़ कि हुंह अर जहोशापात गलाद मुल्खे रामोत नगरी अरामी संघै जुध छ़ेल़ूं कि रहणैं दैंऊं?”</para>
  <para style="p" vid="1KI 22:15">मिका दैनअ ज़बाब, “जुध छ़ेल़, अह गल्‍ल आसा पाक्‍की कि तूह जाणअ ज़िती। बिधाता हेरनअ तूह ज़ताऊई!”<verse eid="1KI 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 22:16" />अहाब राज़ै पुछ़अ भिई, “मिका, मंऐं हेरअ ताल्है कई बारी बोली कि तूह खोज़ मुखा शुची गल्‍ला! तूह खोज़ बिधाते नाओंऐं कि असली दी बिधाता किज़ै बोला?”<verse eid="1KI 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 22:17" />मिका दैनअ ज़बाब, “मुखा शुझिआ इहअ कि इज़राईले सैना छिंघुई उझै धारा एही भेडा-बाकरी ज़ेही, ज़हा फुआल कोहै निं हंदअ। बिधाता बोला इहअ, ‘हेल़्हीओ फुआल पाअ मारी। इना दैआ राज्ज़ी-राम्बल़ै घअरा लै डेऊणैं।’”<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गण. 27:17</ref>; <ref loc="MAT 9:36">मोत्त. 9:36</ref>; <ref loc="MRK 6:34">मार्क. 6:34</ref></char></note><verse eid="1KI 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 22:18" />अहाब राज़ै बोलअ तेखअ जहोशापाता लै, “मंऐं हेरअ त पैहलै ई ताखा खोज़ी कि अह गूर निं मुल्है कधू राम्बल़अ खोज़दअ ई आथी, अह खोज़ा कबल्‍लअ बूरअ ई!”<verse eid="1KI 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19" />तेखअ खोज़अ मिका आजू इहअ, “ऐबै शुण बिधातो समाद! मुखा शुझिआ इहअ बी कि बिधाता आसा आपणीं गाद्दी दी बेठअ द अर स्वर्गे सोभ ज़ीब हुऐ तेऊ फेर कठा।<note caller="-" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="JOB 1:6">आयू. 1:6</ref>; <ref loc="ISA 6:1">ईशा. 6:1</ref></char></note> <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />बिधाता पुछ़अ, ‘अहाब राज़अ कहा डाहणअ ठगी कि सह गलाद मुल्खे रामोत नगरी अरामी संघै जुध छ़ेल़े अर तिधी सह मारी पाणअ?’ तिधी दैनी स्वर्ग दूतै आपणैं-आपणैं साबै कई सलाह। <verse eid="1KI 22:20" /><verse number="21" style="v" sid="1KI 22:21" />खिरी आई एक आत्मां संघा खल़्हुई बिधाता सेटा। तैहा आत्मां बोलअ इहअ, ‘सह डाहणअ मुंह ठगी।’ बिधाता पुछ़अ तैहा आत्मां का, ‘ताह किहअ करै ठगणअ सह?’ <verse eid="1KI 22:21" /><verse number="22" style="v" sid="1KI 22:22" />तैहा आत्मां दैनअ ज़बाब, ‘मुंह डेऊणअ अहाब राज़े सोभी गूरा दी संघा बझ़ैल़णअ मुंह झ़ुठअ बोल़णैं।’ बिधाता बोलअ, ‘तै जाणीं तूह अहाब राज़ै ठगणा लै सफल हई, डेऊ ज़िहअ तूह सोठा तिहअ कर।’”<verse eid="1KI 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 22:23" />खिरी बोलअ मिका इहअ, “अहाब, असली दी हुअ ताल्है इहअ। बिधाता दैनअ हणैं कि बाल देअए तेरै ईंयां गूर ताल्है झ़ुठअ खोज़े। बिधाता आसा हेरै असली दी तेरै बारै इहअ खोज़अ द कि तूह हणअ पठी बरैबाद!”<verse eid="1KI 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24" />तेखअ उखल़अ कनानो शोहरू सिदकिया गूर उझै मिका सेटा तेऊ बाही मिके थोथरै च़ैंडै संघा बोलअ इहअ, “बिधाता कधू गअ मुंह छ़ाडी ताखा खोज़दअ लागी?”<verse eid="1KI 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 22:25" />मिका दैनअ ज़बाब, “ताखा लागणअ तैहा धैल़ी थोघ ज़ेभै ताह लुक्‍कणा लै पांडा-पांडा लागणअ ठुहर्नअ।”<verse eid="1KI 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 22:26" />तेखअ किअ इज़राईले राज़ै अहाबै आपणैं सपाही लै हुकम, “मिका करा कैद, संघा निंयां एऊ नगरीए राज़पाल अमोन अर जोआश टिक्‍कै सेटा। <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />तिन्‍नां का बोलै तम्हैं, ‘राज़ैओ हुकम आसा कि एऊ डाहा कैद खानै पाई, ज़ेभै तैणीं हुंह राज्ज़ी-राम्बल़अ बापस निं फिरुं तेभै तैणीं निं एऊ लै शुक्‍की रोटी अर पाणीं का सुआई खाणां लै किछ़ दैई।’”<verse eid="1KI 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 22:28" />इहअ शूणीं बोलअ मिका, “ज़ै तूह राज्ज़ी-राम्बल़अ बापस फिरे, तै निं बिधाता ईंयां गल्‍ला मुंह बाती बोली!” तेखअ बोलअ मिका इहअ, “इधी तम्हैं होर बी डाहा शूणीं कि मंऐं किज़ै बोलअ।”<verse eid="1KI 22:28" /></para>
  <para style="s">अहाब राज़े मौत</para>
  <para style="r">(<ref loc="2CH 18:28-34">2 इतिहास 18:28-34</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29" />तेखअ डेऊऐ इज़राईलो राज़अ अहाब अर यहूदो राज़अ जहोशापात दुहै आपणीं सैना पाई गलाद मुल्खे रामोत नगरी अरामी संघै जुधा लै। <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />अहाब राज़ै बोलअ जहोशापात राज़ै लै, “हुंह डेऊं जुधा लै भेश बदल़ी अर तूह डाहै राज़ैओ सुआब बान्हीं।” तेखअ डेऊअ इज़राईलो राज़अ अहाब जुधा लै भेश बदल़ी।<verse eid="1KI 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 22:31" />अराम देशे राज़ै किअ आपणैं रथा आल़ै बत्ती सैनापति लै हुकम, “होछ़ै-बडै जोधै निं भाल़ी, तम्हैं पल़ै सिधै इज़राईले राज़ै अहाबा लै चुटी।” <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />ज़ांऊं तिन्‍नैं जहोशापात भाल़अ, तिन्‍नैं ज़ाणअ सोभी इहअ कि अह आसा इज़राईलो राज़अ अहाब अर तिंयां पल़ै तेऊ लै चुटी। ज़ांऊं जहोशापातै हाक्‍का पाई, <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />तेखअ समझ़ै तिंयां कि अह निं इज़राईलो राज़अ अहाब आथी अर तिन्‍नैं छ़ाडअ तेऊओ पिछ़अ करनअ। <verse eid="1KI 22:33" /><verse number="34" style="v" sid="1KI 22:34" />एकी अरामी सपाही बाही कतीरै अर सह लागी कुदरती अहाब राज़ै लै तेऊए कबचा मांझ़ै ज़िधी ज़ोल़ हआ, अहाबै बोलअ आपणैं सारथी लै, “हुंह हुअ ज़खमी! रथ फरेऊ पिछ़ू संघा निंऊं मुंह जुधा का दूर!”<verse eid="1KI 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 22:35" />जुध च़लअ सारी धैल़ी, अहाब राज़अ रहअ आपणैं रथा दी अरामी बाखा मुंह करी होरी सपाही दी नील़ लाई खल़्हुई। ज़ुंण तेऊ कतीरा करै ज़खम पल़अ, तेता का निखल़अ एतरअ लोहू कि रथे पैल़ी बी हुई उंधै लत्त-पथ। खिरी शोटै उडै तेऊ प्राण। <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />ज़ेतरी धैल़अ उडी च़ाल्‍लअ त, इज़राईली सारी सैना लै हुअ इहअ हुकम, “तम्हैं सोभै डेओआ आपणैं देश आपणीं-आपणीं नगरी लै फिरी!”<verse eid="1KI 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37" />तेखअ आणी अहाब राज़े ल्हास सामरी नगरी लै संघा डाही तिधी दाबी। <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />अहाब राज़ैओ रथ धोअ सामरी कुहै सेटा अर तिधी लागै कुक्‍कर तेऊए लोधल़ै च़ाटदै, सह थिई कंज़री बेटल़ी न्हैऊंणें ज़ैगा। अह हुई सह गल्‍ल पूरी ज़ेते बारै बिधाता पैहलै ई त बोली हेरअ द।<verse eid="1KI 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39" />ज़िहै-ज़िहै काम अहाब राज़ै किऐ, तेऊ ज़ुंण हाथी दांदो मैहल बणाअं, तेऊ ज़ुंण-ज़ुंण नगरी बसाऊई, तिंयां आसा इज़राईली राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />अहाब राज़ै मरनै बाद बणअ अहाजया तेऊए ज़ैगा इज़राईलो राज़अ।<verse eid="1KI 22:40" /></para>
  <para style="s">यहूदा दी राज़ै जहोशापातो राज़</para>
  <para style="r">(<ref loc="2CH 20:31-21:1">2 इतिहास 20:31—21:1</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />इज़राईल थिअ अहाब राज़अ, तेऊए राज़ा दी च़ौथी साला बणअ आसाहो शोहरू जहोशापात यहूदा मुल्खो राज़अ। <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />तेभै ती जहोशापाते अमर पैंईंती साले। तेऊए ईज थिई शिल्हीए शोहरी अजूबा। तेऊ किअ एरुशलेम नगरी का यहूदा मुल्खै पच्‍ची साला तैणीं राज़। <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />जहोशापात त आपणैं बाब आसाह ज़िहअ भलअ, तेऊ बी किअ तिहअ ई ज़िहअ बिधाता च़ाहा त कि इहअ लोल़ी हुअ। पर उछ़टी धारा देहुरै निं तेऊ बी ढोल़ै, यहूदी परज़ा करा ती तेऊए राज़ा दी बी धारा डेऊई बल़ीदान अर धूप ज़ाल़ी। <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />जहोशापातै किअ इज़राईले राज़ै संघै मेल़-ज़ोल़।<verse eid="1KI 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 22:45" />राज़ै रहंदी जहोशापाते काम, तेऊए हिम्मत अर ज़ेतरै जुध तेऊ लल़ै, तिंयां सोभै गल्‍ला आसा यहूदा मुल्खै राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />जहोशापातै काढै आपणैं देशा का ज़ुंण मर्ध-मर्ध आप्पू मांझ़ै कंज़रैई करा तै अर कंज़रैई करनै आल़ी बेटल़ी आपणैं देशा का दूर ज़ुंण तेऊए बाब आसाहे ज़मानै ओर्ही अज़ी बी तिन्‍नें देहुरै इहै काम करा तै।<verse eid="1KI 22:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1KI 22:47" />तिन्‍नां धैल़ै निं एदोम कोहै राज़अ आथी त, तिधी त यहूदे राज़ै राज़-काज़ सभाल़दअ एक पांच़ डाहअ द।<verse eid="1KI 22:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 22:48" />जहोशापात राज़ै बणाऐं समुंदरै हांढणै आल़ै ज़हाज़ कि तेता करै ओपीर डेऊई तिधा का सुन्‍नअ आणे। पर तिंयां ज़हाज़ चुटै एजोन-गेबर नाओंए ज़ैगा संघा निं तिधी पुजै। <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />अहाबो शोहरू अहाजया बोलअ जहोशापाता लै, “मेरै ज़हाज़ा आल़ै दै आपणैं ज़हाज़ा आल़ै संघै डेऊणैं।” पर जहोशापातै किअ नांह।<verse eid="1KI 22:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1KI 22:50" />जहोशापात मूंअ संघा डाहअ सह तेऊए दादा-बाबा संघै दाबेदे नगरी दाबेदपूर दाबी। आजू बणअ तेऊओ शोहरू जेहोराम यहूदा मुल्खो राज़अ।<verse eid="1KI 22:50" /></para>
  <para style="s">इज़राईला दी राज़अ अहाजया</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />यहूदा थिअ जहोशापात राज़अ, तेऊए राज़ा दी स्तार्हुई साला बणअ इज़राईला दी अहाजया राज़अ, तेऊ किअ सामरी का दूई साला तैणीं राज़। <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />तेऊ किअ तिहअ ई ज़ेता का बिधाता नफरत करा। सह निखल़अ आपणैं ईज-बाब नबाते शोहरू जरोबामा ज़िहअ निक्‍कअ ज़ुंणीं इज़राईला का पाप कराऊअ त। <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />सह डेओआ त बाल देअआ पूज़दअ अर माथै टेक्‍कदअ ज़िहअ तेऊ का आजी तेऊओ बाब करा त, तेऊ बी ठैऊई बिधाता लै रोश्शै।<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>