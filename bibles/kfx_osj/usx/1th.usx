  <para style="h">1 थिस्सलूणी</para>
  <para style="toc1">थिस्सलूणी नगरीए विश्वासी टोली लै पैहली च़िठी</para>
  <para style="toc2">1 थिस्सलूणी</para>
  <para style="toc3">1 थिस.</para>
  <para style="mt1">1 थिस्सलूणी</para>
  <para style="mt2">थिस्सलूणी नगरीए विश्वासी टोली लै पैहली च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: पल़सी</para>
  <para style="ili">पहल़णैं आल़ै: थिस्सलूणी नगरीए विश्वासी</para>
  <para style="ili">सन: 51</para>
  <para style="ip">रोम राज़ा दी थिऐ कई मुल्ख, तेता मांझ़ै त एक मुल्ख मकिदुनिया अर थिस्सलूणी नगरी ती तेऊ मुल्खे राज़धानी। फलिप्पी नगरी का इधा लै एछी बणाऐं तै पल़ी इधी कई टोल विश्वासी। इधी बी हेरअ त तिन्‍नैं यहूदी बरोध करनअ शुरू करी ज़ुंण होरी ज़ाती मांझ़ै पल़सीए मसीही खुशीए समादा सारै दी पुजणैं का ज़ल़ा तै। किल्हैकि होरी ज़ातीए लोग बी डाहा तै यहूदी धर्मां दी रुच़ी। इहअ करै पल़अ पल़सी थिस्सलूणी नगरी छ़ाडणीं अर सह डेऊअ बिरीया नगरी लै। बादा दी ज़ांऊं सह करिन्थ नगरी पुजअ तिधी भेटअ तेऊ आप्पू संघै काम करनै आल़ै अर साथी तिमोथी का मुंहां सम्हनै थिस्सलूणी नगरी टोलीए बारै समाद।</para>
  <para style="ip">एऊ समादा पुजणैं का बाद लिखी ती थिस्सलूणी नगरीए विश्वासीए नाओंऐं पल़सी पैहली च़िठी तिन्‍नें दिल खुश करनै संघा-संघा भिई हैअ दैणा लै। सह दैआ तिन्‍नां लै तिन्‍नें विश्वास अर खास्सै झ़ूरनै बारै समादा लै शूकर। सह फरेऊआ तिन्‍नां का आपणीं ज़िन्दगीए तिन्‍नां धैल़ै आद ज़ुंण तेऊ तिन्‍नां मांझ़ै रही काटै तै। तेखअ दैआ सह प्रभू ईशूए ऐहा भिई फिरी एछणें बारै सुआले ज़बाब ज़ुंण तैहा विश्वासीए टोली दी तै उझ़ुऐ दै। सुआल तै इहै कि एक विश्वासी, ज़ुंण प्रभू ईशूए भिई एछणैं का पैहलै ई जाए मरी, सह तैहा ज़िन्दगीओ साझ़ू हणअ बी कि नांईं, ज़ुंण प्रभू ईशूए भिई फिरी एछणें बेला हाम्हां भेटणीं? मसीहा केभै एछणअ भिई फिरी? पल़सी खोज़ा एऊ मोक्‍कै तिन्‍नां का इहअ कि तैहा हालता दी ज़ै तम्हैं प्रभू ईशू फिरी एछणैं न्हैल़ै भाल़ै आसा लागै दै, तै रहा च़ुपच़ाप आपणैं एऊ कामां दी लागी।</para>
  <para style="ip">खिरी दैआ पल़ी एही चतैनगी अर सलाह:</para>
  <para style="imq">“सदा रहणअ नंद। कबल्‍लै रहणअ प्राथणां दी लागी। हर हालता लै करनअ प्रभूओ शूकर, किल्हैकि तम्हैं मसीहा ईशूए आसा तम्हां लै च़ाहा परमेशर इहअ ई।”</para>
  <para style="ipr">(5:16-18)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1:1</para>
  <para style="io1">शूकर अर स्तोती 1:2—3:13</para>
  <para style="io1">मसीही बभारे बारै शिक्षा 4:1-12</para>
  <para style="io1">मसीहे फिरी एछणें बारै शिक्षा 4:13—5:11</para>
  <para style="io1">खिरी दैनी दी शिक्षा 5:12-22</para>
  <para style="io1">नचोल़ 5:23-28</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />अह च़िठी आसा पल़सी, सिलास अर तिमोथी बाखा। अह आसा थिस्सलूणी रहणैं आल़ी विश्वासीए टोली लै लिखी दी ज़ुंण बाब परमेशर अर प्रभू ईशू मसीहे आसा।</para>
  <para style="p" vid="1TH 1:1">तम्हां सोभी लै लोल़ी परमेशरे झींण अर शांती सदा हंदी रही।<verse eid="1TH 1:1" /></para>
  <para style="s">थिस्सलूणी नगरीए विश्वासीओ विश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />हाम्हैं करा तम्हां आपणीं प्राथणां दी कबल्‍लै आद अर हाम्हैं करा तम्हां सोभिए बारै परमेशरो शूकर। <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />हाम्हैं करा हर बगत आपणैं बाब परमेशरा सेटा थारै विश्वासे काम, झ़ूरी लै मैन्थ, अर म्हारै प्रभू ईशू मसीहा दी पाक्‍की आशा अर परमेशरा लै काम करनअ आद।<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />भाईओ, तम्हां ज़हा लै परमेशर झ़ूरा हाम्हैं करा तेता लै बी परमेशरो शूकर किल्हैकि हाम्हां का आसा थोघ कि तेऊ छ़ांटै तम्हैं आपणैं लोग हणें तैणीं।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="EPH 1:4">इफि. 1:4</ref></char></note><verse eid="1TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 1:5" />किल्हैकि म्हारअ ईशू मसीहे बारै खुशीओ समाद निं तम्हां सेटा सिधअ बैण पुजअ, पर सह पुजअ पबित्र आत्में शगती अर तेऊए बडै निहंचै करै। ज़िहअ तम्हां का थोघ आसा कि हाम्हैं थारी भलाईए तैणीं तम्हां मांझ़ै रही किहअ बभार डाहअ।<verse eid="1TH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 1:6" />तम्हैं मनअ बडी खरी दी बी पबित्र आत्मां दी खुशी-खुशी प्रभूओ बैण। इहअ करै लागै म्हारी अर प्रभू ज़ेही च़ाल च़लदै। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />इधी तैणीं कि मकिदुनिया अर अखाया मुल्खै बस्सै दै सोभी मसीहा दी विश्वास करनै आल़ै लै हुऐ तम्हैं गूरू।<verse eid="1TH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 1:8" />किल्हैकि तम्हां सेटा का निं सिधअ मकिदुनिया अर अखाया मुल्खै प्रभूओ बैण पुजअ, पर हर ज़ैगा ज़िधी बी हाम्हैं डेऊऐ तिधी खोज़अ लोगै थारै परमेशरा दी विश्वासे बारै। इहअ करै निं हाम्हां थारै विश्वासे बारै कहा बोल़णें ज़रुरत ई पल़ी। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />किल्हैकि तिंयां खोज़ा हर ज़ैगा आप्पै ई म्हारै बारै कि म्हारअ तम्हां सेटा एछणअ किहअ हुअ। किल्हैकि तम्हैं फिरै मुहुर्ती का परमेशरा बाखा लै, ताकि ज़िऊंदै अर शुचै परमेशरे च़ाकरी करी सके <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अर तेऊए पूते स्वर्गा का फिरी एछणें न्हैल़ै-भाल़ै रहे लागी, ज़ुंण परमेशरै मरी करै ज़िऊंदअ किअ। मतलब प्रभू ईशू, ज़ुंण हाम्हां आजू हणैं आल़ै परमेशरे नसाफ का बच़ाऊआ।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">पल़सीओ खुशीओ समाद खोज़णअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />ए मेरै भाईओ, तम्हां का आसा आप्पै थोघ कि म्हारअ तम्हां सेटा एछणअ निं ज़ांऐं हुअ। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />पर तम्हैं ज़ाणा आप्पै ई कि पैहलै-पैहल फलिप्पी नगरी दी दुख अर उपद्रभ ज़िरने बी दैनी म्हारै परमेशरै हिम्मत कि हाम्हैं थारी नगरी दी भारी बरोध हणैं का बाद बी तम्हां का परमेशरो खुशीओ समाद खोज़े।<verse eid="1TH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3" />म्हारी शिक्षा निं तम्हां लै कबाता पाणै आल़ी आथी ती, नां म्हारअ मकसद कज़ेही अर छ़ोतली गल्‍ला करनी थिई अर नां तेथ छ़ल़-कपट आथी त।<verse eid="1TH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 2:4" />परमेशरै आसा हाम्हां दी भरोस्सअ करी खुशीओ समाद सभाल़अ द। तैही निं हाम्हैं कहा मणछा खुश करदै पर हाम्हैं दैआ शिक्षा तेऊ परमेशरा खुश करना लै ज़हा का म्हारै दिला-मन्‍नों थोघ आसा।<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="TIT 1:3">तित. 1:3</ref>; <ref loc="EPH 6:6">इफि. 6:6</ref></char></note><verse eid="1TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 2:5" />तम्हां का आसा थोघ कि हाम्हैं नां च़लाकीए गल्‍ला करदै अर नां तम्हां का किज़ू च़िज़ो मांण किअ, ऐहा गल्‍लो आसा परमेशर शाजत। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />मसीहे शधाणूं हणैं पिछ़ू ती तम्हां का मज़त मांगणी म्हारअ हक। तैबी निं हाम्हैं मणछा का अदर च़ाहंदै तै, नां तम्हां का अर नां कहा होरी का।<verse eid="1TH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7" />पर ज़ेही ईज आपणैं शोहरू-माठै धाची-पाल़ी होछ़ै का बडै करा, मसीहा दी किई हाम्हैं तम्हां जैंदरी रही थारी तेही ई हेर-सभाल़। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />किल्हैकि हाम्हां लागा थारी झ़ूरी। हाम्हैं निं आपणीं बाखा तम्हां लै सिधअ खुशीओ समाद ई खोज़अ ज़ुंण परमेशरै हाम्हां लै दैनअ। पर हाम्हैं तै तम्हां लै आपणीं ज़ान दैणा लै बी तैर किल्हैकि तम्हैं थिऐ गऐ दै म्हारै दिलै बस्सी।<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />किल्हैकि भाईओ, तम्हैं डाहा म्हारी मैन्थ अर कष्ट आद कि तिन्‍नां धैल़ै ज़धू हाम्हैं तम्हां का परमेशरो खुशीओ समाद खोज़अ, हाम्हैं खटै आपणीं हर गरज़ा पूरी करना लै राची धैल़ी काम करी ढब्बै, ताकि तम्हां मांझ़ै कोही लै बी बोझ़ नां होए।<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तम्हैं आसा आप्पै ऐहा गल्‍ले शाजत अर परमेशर बी, कि तम्हां सोभी विश्वासी भाई-बैहणी संघै म्हारअ सभाब किहअ शुचअ, धर्मीं अर नर्दोश त। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तम्हां का आसा ऐहा गल्‍लो थोघ ज़िहअ बाब आपणैं शोहरू संघै बर्ताअ करा, तेही ई दैआ हाम्हैं तम्हां मांझ़ै हरेकी लै शिक्षा अर हैअ अर समझ़ाऊआ बी तै <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />कि थारअ च़ाल-च़लण परमेशरा खुश करनै जोगी होए, ज़ुंण तम्हां आपणैं राज़ अर प्रतप्पा दी शादा।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />तैही करा हाम्हैं कबल्‍लै परमेशरो शूकर, किल्हैकि ज़धू हाम्हैं तम्हां का खुशीओ समाद खोज़अ, तम्हैं निं सह सिधअ मणछे गल्‍ल समझ़ी, पर तम्हैं मनी म्हारी गल्‍ला, असली दी परमेशरो बैण समझ़ी। हाम्हैं निं सह समाद आपणीं बाखा खोज़ी। हाम्हैं करा एता लै बी परमेशरो शूकर कि तेऊ बदल़ी थारी ज़िन्दगी किल्हैकि तम्हैं करा एऊ खुशीए समादा दी विश्वास।<verse eid="1TH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14" />भाईओ, हाम्हां का आसा राम्बल़अ थोघ कि थारअ च़ाल-च़लण आसा परमेशरे तिन्‍नां विश्वासीए टोली ज़िहअ ज़ुंण यहूदा नगरी मसीहा ईशू दी आसा। किल्हैकि तम्हैं ज़िरअ तिहअ ई दुख ज़िहअ तिन्‍नां लै यहूदी मणछै दुख दैनअ। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />ज़ुंणी यहूदी प्रभू ईशू अर परमेशरे कई गूर बी पाऐ मारी। हाम्हैं बी काढै च़िक्‍की-मारी करै कई नगरी का बागै। परमेशर आसा तिन्‍नां का नराज़ अर तिंयां करा सारी मणछा ज़ातीए खलाफ काम। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />तिंयां हआ हाम्हां होरी ज़ाती मांझ़ै एऊ खुशीए समादे बारै खोज़णैं का रोक्‍कदै लागै दै, तिंयां च़ाहा इहअ कि तिन्‍नां निं उद्धार लोल़ी भेटअ! तिंयां आसा लागै दै साबा का बाधू पाप करदै अर ऐबै भेटणीं परमेशरा का घोर सज़ा।<verse eid="1TH 2:16" /></para>
  <para style="s">विश्वासी टोलीए बारै तिमोथीओ हाल खोज़णअ</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />भाईओ, हाम्हैं हुऐ तै तम्हां का थोल़ै धैल़ै देही दी दूर पर तज़ी बी तै हाम्हैं आपणैं दिला का तम्हां नेल़। ज़धू हाम्हैं थोल़ै धैल़ै तम्हां का दूर किऐ, हाम्हैं च़ेतअ मन्‍नैं झ़ेरअ। हाम्हैं च़ाहा तै हर घल़ी किहअ करै तम्हां सेटा पुजणअ। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />मंऐं किई तम्हां सेटा लै एछणें कई बारी कोशिश बी, पर हर बारी डाहै राख्सै हाम्हैं रोक्‍की।<verse eid="1TH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 2:19" />ज़ेभै म्हारअ प्रभू ईशू भिई फिरी एछणअ तेभै हणैं तेऊ सम्हनै तम्हैं ई म्हारी आशा, नंद अर खुशीए शाबाशीओ मुगट। <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />म्हारी बड़ैई अर नंद आसा तम्हैं ई।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तिमोथी विश्वासी सेटा लै छ़ाडणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />तैही ज़ांऊं म्हारै तम्हां का दूर नांईं रहूअ, मंऐं किअ इहअ फैंसलअ कि सिलास अर मुंह रहणअ एथेंस नगरी। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />भाई तिमोथी ज़ुंण मसीहा ईशूए खुशीए समादा खोज़णा लै म्हारअ साझ़ू अर परमेशरो दास आसा, सह छ़ाडअ हाम्हैं तम्हां सेटा लै, ताकि सह तम्हां थारै विश्वासा दी पाक्‍कै करी सके। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />ज़ुंण दुख-सांगट तम्हां लै हुऐ बितै हाम्हैं निं च़ाहंदै कि तम्हां मांझ़ै एक बी तेते बज़्हा विश्वासा का पिछ़ू हटे। किल्हैकि तम्हां का आसा आप्पै थोघ कि हाम्हैं आसा एही ई दुख-सांगट ज़िरना लै परमेशरै छ़ांटै दै।<verse eid="1TH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 3:4" />किल्हैकि ज़धू पैहलै बी तै हाम्हैं तम्हां सेटा, तधू रहा तै हाम्हैं तम्हां का बोल्दै लागी कि हाम्हां लागणै दुख-सांगट ज़िरनै अर इहअ ई हुअ, ऐहा गल्‍लो बी आसा तम्हां का थोघ। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />तैही छ़ाडअ मंऐं तिमोथी तम्हां सेटा लै। मेरै निस्सअ त रहूई अर तेते तैणीं छ़ाडअ मंऐं सह थारै विश्वासे बारै थोघ करने तैणीं कि किधी इहअ निं हआ कि राख्स लागअ होए तम्हां परखदअ अर म्हारी मैन्थ हुई ज़ांऐं।<verse eid="1TH 3:5" /></para>
  <para style="s">तिमोथी का गल्‍ला शुणनी</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />पर एभै खोज़अ तिमोथी तम्हां सेटा का बापस फिरी करै थारै विश्वास अर परमेशरे झ़ूरी करनैओ समाद। तेऊ खोज़ी ईंयां गल्‍ला बी कि तम्हैं करा सदा हाम्हां बडी झ़ूरी संघै आद, तम्हैं च़ाहा मेरअ मुंह भाल़णअ ज़िहअ हुंह ज़ेही मुंह आसा लागी दी कि मुंह त एभी तम्हां सेटा लै एछणअ। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />भाईओ, तैही हुई हाम्हां आपणैं सारै दुख-सांगटा दी थारै विश्वासा दी टेक्‍की रहणें गल्‍ला शूणीं खास्सी शांती।<verse eid="1TH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 3:8" />थारै प्रभू ईशू मसीहा दी पाक्‍कअ विश्वास डाहणें इना गल्‍ला शूणीं भेटी हाम्हां ज़ेही नऊंईं ज़िन्दगी।<verse eid="1TH 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 3:9" />ऐबै करा हाम्हैं थारै बारै परमेशरो शूकर। हाम्हैं करा परमेशरो तेता लै शूकर ज़ुंण खुशी हाम्हां तेऊ सम्हनै तम्हां करै भेटी। <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />हाम्हैं हआ राची धैल़ी तम्हां लै कबल्‍लै प्राथणां करदै लागै दै कि थारअ मुंह भिई भाल़ी सके अर हाम्हैं तम्हां विश्वासा दी होर बी पाक्‍कै करी सके।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />ऐबै करा हाम्हैं एही प्राथणां कि म्हारअ बाब परमेशर अर म्हारअ प्रभू ईशू पजैल़े ऐबै हाम्हां तम्हां सेटा आप्पै। <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />हाम्हैं करा एही प्राथणां कि प्रभू लोल़ी त इहअ किअ कि ज़ेही हाम्हैं तम्हां संघै झ़ूरी करा, तेही ई थारी झ़ूरी बी आप्पू मांझ़ै अर सोभी मणछा संघै बढदी रहे <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />ताकि प्रभू थारै मन्‍नां इहअ मज़बूत करे, कि ज़ांऊं म्हारअ प्रभू ईशू मसीहा आपणैं सोभी पबित्र लोगा संघै फिरी एछे, तिंयां म्हारै परमेशर बाब सम्हनै पबित्रता दी नर्दोश निखल़े।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="COL 1:22">कुलू. 1:22</ref>; <ref loc="EPH 5:27">इफि. 5:27</ref></char></note><verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">एही ज़िन्दगी ज़ुंण परमेशरा खुश करे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />भाईओ, हाम्हैं करा तम्हां का अरज़ अर तम्हां समझ़ाऊआ हाम्हैं प्रभू ईशू दी कि ज़ेही तम्हैं हाम्हां का ठीक च़ाल-च़लणीं, परमेशर खुश करनअ आसा शिखल़अ द, अर ज़िहअ तम्हैं च़ला बी, तिहै ई होर बी लागा तम्हैं बझ़दै। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />किल्हैकि तम्हां का आसा थोघ कि हाम्हैं प्रभू ईशू बाखा तम्हां लै कुंण-कुंण हुकम पजैल़ै।<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />किल्हैकि परमेशर च़ाहा इहअ कि तम्हैं हआ पबित्र मतलब-कंज़रैई का रहै दूर <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />अर तम्हां मांझ़ै लोल़ी सोभी का थोघ हुअ कि आपणीं बेटल़ी संघै किहअ करै रहणअ, ज़िहअ करै तेसो अदर हआ अर तैहा छ़ाडी बागै डेऊणेओ पाप निं करी। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />एऊ कामां निं सिधअ आपणीं देही खुश करने च़ाहा पूरी करना लै करी, अर नां तिन्‍नां होरी ज़ाती ज़िहअ हई ज़हा का परमेशरो थोघ निं आथी। <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />आपणीं देही डाहणीं आपणैं बशै अर नां आपणीं देहीए भुखा लै आपणैं भाई ठगी अर नां तेऊ लै कोई दाअ-पेच़ च़लाऊई। किल्हैकि प्रभू दैणीं इना सोभी गल्‍ला पिछ़ू सज़ा, ज़िहअ कि हाम्हैं पैहलै बी तम्हां का बोलअ अर चतैनगी बी दैनी।<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 94:1">भज. 94:1</ref></char></note><verse eid="1TH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 4:7" />किल्हैकि परमेशरै निं हाम्हैं छ़ोतलै हणां लै आथी शादै दै पर हाम्हैं आसा पबित्र हणां लै शादै दै। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />एते ई बज़्हा ज़ुंण ऐहा चतैनगी बृथा समझ़ा, सह निं मणछा बृथा समझ़दअ पर सह समझ़ा परमेशरा बृथा ज़ुंण तम्हां लै आपणअ पबित्र आत्मां दैआ।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />आपणैं साथी-भाई संघै झ़ूरी डाहणें बारै लिखणे निं मुंह ज़रुरत आथी। किल्हैकि आप्पू मांझ़ै झ़ूरी डाहणीं आसा तम्हैं आप्पै परमेशरा का शिखल़ी दी।<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="JHN 3:11">जोह. 3:11</ref>; <ref loc="ROM 12:10">रोम. 12:10</ref></char></note><verse eid="1TH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 4:10" />तेतो बी आसा सोभी का थोघ कि मकिदुनिया मुल्खै सोभी विश्वासी भाई लै आसा थारै दिलै झ़ूरी, पर भाईओ, हाम्हैं समझ़ाऊआ तम्हां इहअ कि होर बी लागा आजू बझ़दै।<verse eid="1TH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11" />ज़िहअ हाम्हैं तम्हां लै हुकम आसा दैनअ द, तिहै ई रहा च़ुप्प-च़ुप्पै आपणैं काम-काज़ करदै अर आपणैं-आपणैं हाथै रहा खटदै लागी। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />बागै होरी लोगा मांझ़ै बी लोल़ी थारअ शोभलअ बर्ताअ हुअ ताकि तिंयां बी थारअ अदर करे अर तम्हां निं किछ़ू गल्‍ले काम्मी लोल़ी रही कि तम्हैं होरीए भरोस्सै रहे।<verse eid="1TH 4:12" /></para>
  <para style="s">ईशूओ भिई फिरी एछणअ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />भाईओ, हाम्हैं निं च़ाहंदै कि तम्हैं तिन्‍नें बारै ज़ुंण मरी आसा गऐ दै, तिन्‍नें बारै नज़ाण रहे, इहअ निं हआ कि तम्हैं होरी ज़िहअ शोग करे, ज़हा मरनै का बाद आशा ई निं आथी। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />किल्हैकि, ज़ै हाम्हैं भरोस्सअ करा कि प्रभू ईशू मूंअ अर ज़िऊंदअ बी हुअ, तिहअ ई ज़ुंण मसीहा दी मूंऐं दै आसा तिंयां बी आणनैं परमेशरा मसीहा संघै बापस।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />किल्हैकि हाम्हैं बोला प्रभूए बैणे साबै तम्हां लै कि हाम्हैं ज़ुंण अज़ी बी ज़िऊंदै आसा, ज़ेभै प्रभू फिरी एछणअ तेभै निं हाम्हैं तेऊ सेटा मिलदै तिन्‍नां का आजू डेऊणैं ज़ुंण विश्वासी मरी आसा गऐ दै।<verse eid="1TH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 4:16" />किल्हैकि प्रभू ईशू मसीहा होथणअ आप्पै स्वर्गा का, तेभै शुणनअ अर प्रधान स्वर्ग दूतो बोल अर परमेशरे नाद बाज़णीं, अर ज़ुंण विश्वासी मरी आसा गऐ दै, तिंयां हणैं पैहलै ज़िऊंदै। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तेखअ हाम्हैं ज़ुंण ज़िऊंदै अर बच़ै दै आसा, तेखअ च़कणै हाम्हैं बी तिन्‍नां संघै उझै बादल़ा दी प्रभू सेटा मिलदै अर तेभा पोर्ही रहणैं हाम्हैं सदा प्रभू संघै। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />इहअ करै करा इना गल्‍ला करै एकी-दुजै लै हैअ दैई।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">प्रभू ईशूए फिरी एछणा लै तैर्हुई रहणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />भाईओ, एही बी निं किछ़ै ज़रुरत आथी कि प्रभू फिरी एछणें तैहा ऋता अर बगते बारै तम्हां लै किज़ै लिखे। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />किल्हैकि तम्हां का आप्पै इना गल्‍लो ठीक थोघ कि प्रभूए सह धैल़ी एछणी तम्हां लै नभैऊशै ज़िहअ राची च़ोर एछा। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />ज़ेभै लोगा इहअ बोल़णअ, “ठीक-ठाक आसा, अर किछ़ै फिकर निं आथी।” तिन्‍नां लै एछणअ हेरा-हेरी बनाश, ज़ेही सुंदी बेटल़ी लै सूंणें दाह एछा, तिहै ई च़ाऐ तिंयां किछ़ बी करे पर तिंयां निं तैहा बडी खरी का बच़ी सकदै।<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 24:37-39">मोत्त. 24:37-39</ref></char></note><verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />पर भाईओ, तम्हैं करा ईशू मसीहा दी विश्वास अर तै निं तम्हैं न्हैरै दी आथी अर तम्हां लै निं सह धैल़ी एछणी च़ोरा ज़ेही एछणी। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />किल्हैकि तम्हैं सोभै आसा प्रैश्शे लुआद अर धैल़ीए लुआद। हाम्हैं नां राचीए आथी अर नां न्हैरे आथी। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />तैही निं होरी ज़िहै सुत्ती रहा, पर बिहुदै अर चतैन रहा। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />किल्हैकि ज़ुंण सुत्ती रहा, तिंयां रहा राची ई सुत्ती अर ज़ुंण शराबी हआ तिंयां बी झुटा शराब राची। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />पर हाम्हैं आसा धैल़ीए, तैही रहा सुफी। विश्वास अर झ़ूरी डाहा ज़ुंण म्हारी फाज़त करा ज़िहअ सपाही टोप अर हीकबंद बान्हीं आपणीं फाज़त करा। तम्हैं डाहा एही आशा कि हाम्हैं आसा सदा रहणैं आल़ी सज़ा का बच़ाऊई हेरै दै ज़िहअ सपाहीओ टोप तेऊए फाज़त करा।<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="ISA 59:17">ईशा. 59:17</ref></char></note><verse eid="1TH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 5:9" />किल्हैकि परमेशरै निं हाम्हैं सज़ा दैणा लै आथी छ़ांटै दै, पर हाम्हैं आसा एते तैणीं डाहै दै कि हाम्हां मसीहा ईशू करै उद्धार भेटे। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />ईशू मसीहा मूंअ हाम्हां लै एते तैणीं कि हाम्हैं च़ाऐ ज़िऊंदै रहे या मरे सोभै मिली करै तेऊ ई संघै ज़िऊए। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />एते तैणीं दैआ एकी-दुजै लै हैअ अर एकी-दुजै लै करा परमेशरा दी विश्वास पाक्‍कै हणां लै मज़त, ज़िहअ तम्हैं करा बी।<verse eid="1TH 5:11" /></para>
  <para style="s">विश्वासीए टोली लै शिक्षा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />भाईओ, हाम्हैं करा तम्हां का अरज़ कि ज़ुंण तम्हां मांझ़ै मैन्थ करा अर प्रभू दी थारै सैणैं आसा, अर तम्हां लै शिक्षा दैआ, तिन्‍नों करा अदर। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />तिन्‍नें मैन्थ आद डाही करा तिन्‍नों बडी झ़ूरी संघै अदर अर आप्पू मांझ़ै डाहा मेल़-ज़ोल़।<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />भाईओ, हाम्हैं करा तम्हां का अरज़ कि ज़ुंण नज़ाहणै आसा तिन्‍नां समझ़ाऊआ, अर डरैल्हू लै दैआ हैअ, दुबल़ै मणछे करा हेर-सभाल़ अर सोभी लै रहैऊआ ज़िरने शगती।<verse eid="1TH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 5:15" />ऐहा गल्‍लो डाहै धैन, तम्हां मांझ़ै निं कोहै कसरै कदुष्ट कामें बदल़ै बूरअ करी। पर कबल्‍लै रहणअ भलाई करना लै आजू, अर आप्पू मांझ़ै अर सोभी संघै करा भलाई करने कोशिश।<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="1PE 3:9">1 पत. 3:9</ref></char></note><verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />सदा रहणअ नंद। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />कबल्‍लै रहणअ प्राथणां दी लागी। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />हर हालता लै करनअ प्रभूओ शूकर, किल्हैकि तम्हैं मसीहा ईशूए आसा तम्हां लै च़ाहा परमेशर इहअ ई।<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />पबित्र आत्मां निं लोगा मांझ़ै काम करनै का रोक्‍का। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />ज़ुंण गल्‍ला परमेशरै प्रगट किई, तिंयां निं बृथा समझ़णीं। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />हर गल्‍ल परखणीं कि तिंयां परमेशरा बाखा आसा कि नांईं, ज़ुंण ठीक आसा सह गल्‍ल डाहणीं ढाकी। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सोभी रंगे बूराई का रहणअ दूर।<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="PHP 4:8">फलि. 4:8</ref></char></note><verse eid="1TH 5:22" /></para>
  <para style="s">बर्गत</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />शांती दैणैं आल़ै परमेशरा करनै आप्पै तम्हैं पबित्र अर थारी आत्मां, प्राण अर देही लोल़ी म्हारै प्रभू ईशू फिरी एछणें तैणीं पूरै-पूरै नर्दोश अर बच़ी रहै।<verse eid="1TH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TH 5:24" />तम्हां शादणैं आल़अ आसा शुचअ-पाक्‍कअ, तेऊ आसा तम्हैं पबित्र हणां लै शादै दै अर तेऊ करनै तम्हैं बी पबित्र।<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />ए भाईओ, हाम्हां लै बी करै प्राथणां।<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सोभी विश्वासी भाई लै दैणीं पबित्र माख्खी दैई राज्ज़ी-खुशी।<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />हुंह बोला तम्हां का प्रभूए नाओंऐं कि ऐहा च़िठी खोज़ै पहल़ी करै होरी विश्वासी भाई का बी।<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />म्हारै प्रभू ईशूए झींण लोल़ी सदा तम्हां सोभी लै हुई।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>