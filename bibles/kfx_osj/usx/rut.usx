<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">KULVI Outer Seraji Bible</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 40 License</para>
  <para style="h">रूत</para>
  <para style="toc1">मोआब देशा का आणी दी नुश हुई इज़राईला दी मशूर</para>
  <para style="toc2">रूत</para>
  <para style="toc3">रूत.</para>
  <para style="mt1">रूत</para>
  <para style="mt2">मोआब देशा का आणी दी नुश हुई इज़राईला दी मशूर</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: एही निं थोघै पर कई बोला इहअ कि अह कताब आसा शमूएल गूरै लिखी दी।</para>
  <para style="ili">सन: 1030 का 1010 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">ऐहा कताबा दी आसा तेऊ ज़मानें गल्‍ला ज़धू इज़राईली प्रैंदै पांच़ो राज़ हआ त। एथ आसा इहअ कि एकी मोआब देशे बेटल़ी किअ इज़राईली संघै बैह। तेसे लाल़ै मरनै का बाद बी रही सह शुची-पाक्‍की आपणीं शाशुईए च़ाकरी करदी लागी अर तेसे दिलै ती इज़राईले परमेशरा लै बी खास ज़ैगा। अह टबर हुअ इज़राईली लै बादा का सोभी का खास किल्हैकि तैहा मोआबी बेटल़ीए आद-लुआदा मांझ़ै ई का थिअ आजू दाबेद राज़अ।</para>
  <para style="ip">रूता का लाऊआ आसा ऐहा कताबा दी तेसे शाशअ नाओमी ज़ुंण आपणैं लाल़ै अर दूई शोहरू संघै बेतलेम नगरी का मोआब देशा लै डेऊऐ तै। लाल़ै अर आपणैं दुही शोहरू मरनै का बाद आई सह बेतलेम नगरी लै बापस फिरी अर तेसे दूई नुशा लै बोलअ तैहा पेऊकै डेऊणा लै। ज़ेठी डेऊई पेऊकै लै फिरी पर कान्हीं रूत नाओंए नुश निस्सी तैहा छ़ाडी। बादा का किअ नाओमी रूतो बैह आपणैं ई टबरा बाखे एकी बोआज़ नाओंए मणछा संघै।</para>
  <para style="ip">बधाने साबै निं मोआबी इज़राईली बणी सकदै तै। पर ऐहा कताबा दी लागा हाम्हां का थोघ कि रूत रही बिधाता लै पठी शुची-पाक्‍की अर तैहा भेटी इज़राईली संघै रल़णें ज़ाज़त। रूत बोला ती नाओमी लै इहअ,</para>
  <para style="ib" />
  <para style="imq">“ज़िधा लै तूह डेओए, मुंह डेऊणअ ताह संघै तिधा लै अर रहणअ बी मुंह तिधी ज़िधी तूह रहे। ज़ुंण लोग तेरै आसा, मेरै बी हणैं तिंयां ई अर ज़ुंण परमेशर तेरअ आसा सह ई हणअ मेरअ बी परमेशर। ज़िधी तूह मरे, मुंह बी मरनअ तिधी अर दाबी बी लोल़ी हुंह तिधी ज़िधी लोग ताह दाबै। मुल्है लोल़ी बिधाते घोर सज़ा पल़ी ज़ै हुंह मौता का सुआई किज़ू होरी गल्‍ला पिछ़ू ताखा ज़ुदी होए।”</para>
  <para style="ipr">(1:16,17)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">नाओमी आई आपणीं नुशा संघै बेतलेम नगरी लै बापस फिरी 1:1-22</para>
  <para style="io1">रूत डेऊई बोआज़े खेचै 2:1—3:18</para>
  <para style="io1">बोआज़ै किअ रूता संघै बैह 4:1-22</para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">एलीमोलक डेऊअ आपणैं टबरा संघी मोआब देशा लै</para>
  <para style="p">
    <verse number="1-2" style="v" sid="RUT 1:1-2" />ज़ेऊ ज़मानै इज़राईली प्रैंदै पांच़ो राज़ थिअ, तेऊ ज़मानै पल़अ एकी बारी देशै घोर नकाल़। यहूदा मुल्खे बेतलेम नगरीओ एलीमोलक नाओं एक मणछ डेऊअ आपणीं बेटल़ी अर दूई शोहरू संघा निंईं मोआब देशा लै संघा बस्सअ तिधी।<note caller="-" style="x"><char style="xo" closed="false">1:1-2 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मिक. 5:2</ref>; <ref loc="1CH 4:4">1 इति. 4:4</ref></char></note> एलीमोलक थिअ एप्रात खिंबा का अर तेऊए लाल़ी नाअं थिअ नाओमी, तिन्‍नें तै दूई शोहरू मलोन अर कलोन। <verse eid="RUT 1:1-2" /><verse number="3" style="v" sid="RUT 1:3" />मोआब देशै रहंदी मूंअ नाओमीओ लाल़अ एलीमोलक पोर्ही, पिछ़ू छ़ुटै नाओमी अर तेसे दूई शोहरू। <verse eid="RUT 1:3" /><verse number="4" style="v" sid="RUT 1:4" />तिन्‍नैं दूई शोहरू किअ मोआब देशे शोहरी संघै बैह<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">शोहरी संघै बैह </char><char style="ft" closed="false">इज़राईली नांईं तै आपणीं टोली छ़ाडी कनानी ज़ेही होरी ज़ाती संघै बैह करदै थिऐ, किल्हैकि बधाना दी थिई इहअ करना लै नांह।</char></note>, एकी नाअं त ओरपा अर दुजी नाअं त रूत। तेता बाद रहै तिंयां तिधी कोई दस साला तैणीं। <verse eid="RUT 1:4" /><verse number="5" style="v" sid="RUT 1:5" />तेता बाद मूंऐं नाओमीए तिंयां दूई शोहरू मलोन अर कलोन बी अर ऐबै नां नाओमीओ लाल़अ रहअ अर नां शोहरू रहै।<verse eid="RUT 1:5" /></para>
  <para style="s">नाओमी अर रूत आई इज़राईल देशा लै बापस</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />थोल़ै धैल़ै बाद खोज़अ मोआब देशै कुंणी नाओमी का इहअ कि बिधाता दैनी आपणीं परज़ा इज़राईली लै एही बर्गत कि तिन्‍नें हुई खास्सी साल-फसल। तेखअ डाही नाओमी आपणीं दुही नुशा संघी मोआब देशा का बापस आपणैं देशा लै एछणें। <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />नाओमी आपणीं दूई नुशा संघै यहूदा बाखा लै हांढदी लागी दी, पर बाता लागी सह आपणीं दुही नुशा लै इहअ बोल्दी, <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />“शोहरीओ, मेरअ दिल बोला इहअ कि तम्हैं डेओआ आपणैं पेऊकै लै बापस। तम्हैं झ़ूरा ती मेरै शोहरू लै खास्सी ज़ुंण मरी डेऊऐ, अर मुल्है बी करा तम्हैं खास्सी झींण। मेरी आसा बिधाता का एही अरज़ कि तम्हां लै लोल़ी ती तेऊ खास्सी झींण किई। <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />तम्हां लोल़ी तै दुही बधिया घअर भेटै ज़िधी तम्हैं आपणैं लाल़ै संघै मौज़ी रहे।”</para>
  <para style="p" vid="RUT 1:9">नाओमी दैनी तिन्‍नां दुही लै मल़्हैची अर तिंयां दुहै नुशा लागी ज़ोरै-ज़ोरै लेरा लांदी नाओमी लै बोल्दी, <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />“हाम्हैं निं पेऊकै च़ाल्‍ली डेऊई! हाम्हां डेऊणअ ताह ई संघै अर रहणअ बी तेरै ई लोगा जैंदरी।”<verse eid="RUT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 1:11" />पर नाओमी बोलअ तिन्‍नां लै इहअ, “मेरी शोहरीओ, तम्हां हुअ आपणैं पेऊकै लै डेऊणअ! मुंह संघै एछी किज़ै लाअ तम्हैं करी? मेरै निं ऐबै होर शोहरू हई च़ाल्‍लै कि तम्हां लै मर्ध होए!<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 38:11">मूल. 38:11</ref>; <ref loc="DEU 25:5">बधा. 25:5</ref></char></note> <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />तैही बोला हुंह तम्हां लै मेरी शोहरीओ, तम्हैं फिरा घअरा लै बापस, भिई बैहा करना लै बी गई हुंह खास्सी प्रोढी हई। ज़ै मेरै आझ़ हणैं-ज़ाणें आशा बी हंदी अर आझ़ ज़ै हुंह बैह बी करदी अर बादा का मेरै शोहरू बी हंदै, तम्हां निं तेतो बी किछ़ै फाईदअ हणअ! <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />तम्हैं कै तिन्‍नां ज़ुआन हंदी न्हैल़ी च़ाल्‍ली लागी? एता पिछ़ू तम्हां होर बैह करनअ ई निं आथी? मेरी शोहरीओ, तम्हां का आसा थोघ कि इहअ निं हई ई सकदअ। बिधाता पाई मुल्है घोर मार अर मेरअ दुख आसा थारै दुखा का खास्सअ।”<verse eid="RUT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 1:14" />तिंयां लागी दुहै ज़ण्हीं भिई ज़ोरै-ज़ोरै लेरा लांदी। खिरी डेऊई ओरपा आपणीं शाशुई नाओमी लै मल़्हैची दैई फिरी, पर रूत रही आपणीं शाशुई नाओमी ई संघै। <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />नाओमी बोलअ तेखअ तैहा लै इहअ, “रूत, बेटीऐ तेरी ज़ठाणीं, च़ाल्‍ली भाल़ आपणैं पेऊकै आपणैं लोगा अर आपणैं देअआ सेटा लै बापस डेऊई। तूह बी डेऊ ऐहा ई संघै फिरी।”<verse eid="RUT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 1:16" />रूतै दैनअ आपणीं शाशुई लै इहअ ज़बाब, “ज़ीबाण, मुल्है निं आप्पू छ़ाडी पेऊकै फिरी डेऊणा लै बोली! मुंह दै आप्पू संघै एछणैं। ज़िधा लै तूह डेओए, मुंह डेऊणअ ताह संघै तिधा लै अर रहणअ बी मुंह तिधी ज़िधी तूह रहे। ज़ुंण लोग तेरै आसा, मेरै बी हणैं तिंयां ई अर ज़ुंण परमेशर तेरअ आसा सह ई हणअ मेरअ बी परमेशर।<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2SA 15:21">2 शमू. 15:21</ref></char></note> <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />ज़िधी तूह मरे, मुंह बी मरनअ तिधी अर दाबी बी लोल़ी हुंह तिधी ज़िधी लोग ताह दाबै। मुल्है लोल़ी बिधाते घोर सज़ा पल़ी ज़ै हुंह मौता का सुआई किज़ू होरी गल्‍ला पिछ़ू ताखा ज़ुदी होए।”<verse eid="RUT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 1:18" />ज़ांऊं नाओमी ज़ाणअ कि रूत निं संघा डेऊणैं का पिछ़ू हटणै आल़ी आथी, अर तेखअ निं तैहा सह ज़ोरा-ज़ोरी बापस छ़ाडी। <verse eid="RUT 1:18" /><verse number="19" style="v" sid="RUT 1:19" />तेखअ लागी तिंयां दुहै ज़ण्हीं आजू हांढदी संघा पुजी बेतलेम नगरी। तिधी पुजी ज़ांऊं नगरीए लोगा का थोघ लागअ कि तिंयां आई, अर सारै दी लागी तिन्‍नें ई बारै गल्‍ला अर बेटल़ी लागी इहअ बोल्दी, “अह सच्च़ी नाओमी आसा?”<verse eid="RUT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 1:20" />नाओमी बोलअ तिन्‍नां लै इहअ, “मुल्है निं नाओमी बोला, मुल्है बोलअ मारा किल्हैकि बिधाता दैनअ मुल्है खास्सअ दुख। <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />इधा का डेऊंदी बारी ती हुंह भरी पूरी, पर बिधाता पजैल़ी हुंह रित्तै हाथै बापस। बिधाता ज़हा का सारअ बल आसा, ज़ै तेऊ हुंह घोर आफ़ता दी आसा पाई दी<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">घोर आफ़ता दी आसा पाई दी </char><char style="ft" closed="false">नाओमी थिई बडी दुखी मनै बच़ार करदी लागी दी कि बिधाता ज़ो ईंयां दुख मुल्है पाऐ तिंयां पाऐ तेऊ मुल्है मेरै पाप करनै पिछ़ू। </char></note>, तै किल्है बोला तम्हैं मुल्है नाओमी?”<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="JOB 1:21">आयू. 1:21</ref></char></note><verse eid="RUT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 1:22" />इहअ करै आई नाओमी आपणीं मोआबी नुशा रूता संघै आपणैं देशा लै बापस फिरी। ज़ांऊं तिंयां बेतलेम नगरी पुजी, लोग गऐ तै ज़ौआ लऊंदै लागी।<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s">बोआज़े खेचै किअ रूतै काम</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />नाओमीओ त एक रिश्तैदार तेऊ नाअं त बोआज़, सह थिअ मनअ-तनअ द अर सह आसा एलीमोलके ई टबरा मांझ़ा का।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 19:9">लेब. 19:9</ref>; <ref loc="DEU 24:19">बधा. 24:19</ref> </char></note> <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />एकी धैल़ै बोलअ मोआबण रूतै आपणीं शाशुई नाओमी लै, “मुंह दै कसरै खेचै डेऊणैं, तेता का आणू हुंह तिन्‍नां नाज़े सीला च़ुंघी ज़ुंण लऊंणै आल़ै का पिछ़ू छ़ुटा।”</para>
  <para style="p" vid="RUT 2:2">नाओमी बोलअ, “तूह लाग डेऊंदी।”<verse eid="RUT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="RUT 2:3" />तेखअ डेऊई रूत एकी खेचै संघा लागी लऊंणै आल़ै पिछ़ू धरनीं छ़ुटै दै नाज़े सीला च़ुंघदी। सह हुअ इहअ सजोग कि सह खेच त कुदरती एलीमोलके टबर बोआज़ो खेच।<verse eid="RUT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 2:4" />तेतरी आअ बोआज़ बेतलेम नगरी आपणैं घअरा का खेचा लै आप्पै संघा किअ कामां करनै आल़ै लै इहअ बोली नमस्ते, “बिधाता लोल़ी तम्हां संघै रहअ।” <note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="PSA 129:7">भज. 129:7</ref> </char></note></para>
  <para style="p" vid="RUT 2:4">लऊंणै आल़ै दैनअ ज़बाब, “बिधाता लोल़ी तम्हां लै खास्सी बर्गत दैनी।”<verse eid="RUT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 2:5" />बोआज़ै ज़ांऊं रूत भाल़ी, तेऊ पुछ़अ आपणअ सह दास ज़ुंण कामां आल़ै भाल़अ त डाहअ द, “अह ज़ुआन शोहरी कुंण आसा?”<verse eid="RUT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 2:6" />तेऊ दासै बोलअ, “अह शोहरी आसा परदेसी नाओमी संघै मोआब देशा का आई दी। <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />ऐहा शोहरी बोलअ मुल्है, ‘मुंह दै लऊंणै आल़ै पिछ़ू-पिछ़ू नाज़े काशी जैंदरी सील च़ुंघणैं।’ अह आसा दोत्तकी आई दी अर एभै तैणीं आसा इधी सीला च़ुंघदी लागी दी। ऐहा किअ सिधअ धख घल़ी राम।”<verse eid="RUT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 2:8" />बोआज़ै बोलअ रूता लै, “हे बेटीऐ, शुण, तूह रहअ इधी मेरी इना होरी दासी संघै सीला च़ुंघदी लागी, ओर्ही-पोर्ही निं होरीए खेचै डेऊंदी लागी, <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />ज़हा खेचै बी ईंयां लऊंदी लागे, तूह डेऊऐ तेऊ ई खेचा लै। मंऐं डाहअ इना सोभी आदमी लै बोली कि ताह तंग करदै निं लागी। ज़ेभै ताह चिशै एछे, तूह झुटै इना भांडै का पाणीं ज़ुंण इनै आसा भरी डाहै दै।”<verse eid="RUT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 2:10" />रूतै टेक्‍कअ धरनीं उटी पल़ी माथअ, संघा बोलअ बोआज़ा लै इहअ, “हुंह आसा परदेसी, इहअ थोघ हंदी बी किअ तंऐं मेरअ खैल, तंऐं झ़ाणीं मुल्है एतरी भलाई किल्है सोठी होए?”<verse eid="RUT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 2:11" />बोआज़ै दैनअ ज़बाब, “आपणैं लाल़ै मरनै बाद तंऐं आपणीं शाशुईए केही च़ाकरी किई, मंऐं शूणीं तिंयां गल्‍ला। मुखा आसा थोघ कि तूह केही आई आपणैं ईजा-बाबे घअर, रिश्तैदार अर आपणैं देशा छ़ाडी अर ऐबै केही आसा तूह तिन्‍नां मणछा मांझ़ै रहंदी लागी दी ज़ुंण तंऐं आझ़ तैणीं निं भाल़ै। <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />हुंह करा बिधाता का एही अरज़ कि तेऊ लोल़ी तेरै तेऊ कामों फल ताल्है दैनअ। ऐबै आसा तूह इज़राईले परमेशर बिधाते शरणा आई दी, हुंह करा ताल्है तेऊ का एही अरज़ कि तेऊ लोल़ी ताल्है खास्सी बर्गत दैनी।”<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 17:8">भज. 17:8</ref>; <ref loc="PSA 91:1">91:1</ref></char></note><verse eid="RUT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 2:13" />रूतै दैनअ तेऊ लै ज़बाब, “मेरै मालक, तेरी हुई मुल्है खास्सी झींण। एही ता निं हुंह तेरी इना दासी बराबर आथी पर तज़ी बी किई तंऐं भली गल्‍ला करी मेरअ शाह हल़कअ।”<verse eid="RUT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 2:14" />क्लारी खाणें बेला बोलअ बोआज़ै रूता लै, “इधी खा हाम्हां संघै रोटी, इधी खा मिल्‍लै रसा दी च़ोक्‍की करै म्हार।” तेखअ बेठी सह तिन्‍नां कामां आल़ै संघै। बोआज़ै दैनअ तैहा लै भोश खाणां लै। तैहा खाऐ रज्ज़ी अर धख बच़अ तैहा का एही पै। <verse eid="RUT 2:14" /><verse number="15-16" style="v" sid="RUT 2:15-16" />तेखअ डेऊई सह भिई सीला च़ुंघदी, बोआज़ै डाहअ आपणैं कामां आल़ै का इहअ बोली, “ऐहा दैआ काशी जैंदरा का बी सील च़ुंघणैं अर ऐहा लै निं नांह करी। पर काशी पूरी हणैं का बाद करा धख सील धरनीं एही बी शोटी करी ताकि सह तेता आप्पू लै च़ुंघे।”<verse eid="RUT 2:15-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 2:17" />इहअ करै रही रूत उडै तैणीं सीला च़ुंघदी लागी, पूणीं फल़ाक्‍की करै निखल़ै कोई एक मण ज़ौ<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">एक मण ज़ौ </char><char style="ft" closed="false">कोई 12-16 किलू</char></note>। <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />तैहा निंयं सह नाज़ नगरी लै संघा रहैऊअ आपणीं शाशुई का कि तैहा केतरै झाल़ै। ज़ुंण क्लारी तेसे भोश अर रोटी बच़ी ती, तिंयां बी दैनी तैहा आपणीं शाशुई लै। <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />नाओमी लागी रूता पुछ़दी, “आझ़ अह एतरअ नाज़ तंऐं किधा का झाल़अ? तूह कसरै खेचै ती डेऊई दी? परमेशरै लोल़ी ती तेऊ मणछा लै खास्सी बर्गत दैनी ज़ुंणीं ताल्है आपणैं खेचै च़ुंघणैं दैनअ!”</para>
  <para style="p" vid="RUT 2:19">रूतै खोज़अ नाओमी का, कि तैहा च़ुंघै आझ़ एकी बोआज़ नाओंए मणछे खेचा का सील। <verse eid="RUT 2:19" /><verse number="20" style="v" sid="RUT 2:20" />नाओमी बोलअ आपणीं नुशा लै, “बिधाता लोल़ी बोआज़ा लै खास्सी बर्गत दैनी। बिधाता करा ज़िऊंदै अर मूंऐं दै दुही लै झींण।”</para>
  <para style="p" vid="RUT 2:20">तेखअ खोज़अ नाओमी आपणीं नुशा का, “सह भलअ मणछ आसा म्हारै ई टबरा बाखो, पर अह आसा सह पै ज़हा म्हारी ज़िम्मीं कुआसणेंओ हक आसा।”<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="LEV 25:25">लेब. 25:25</ref>; <ref loc="RUT 4:4">रूत. 4:4</ref></char></note><verse eid="RUT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="RUT 2:21" />तेखअ लागी रूत मोआबण इहअ बोल्दी, “तेऊ आसा मुल्है इहअ बी डाहअ द बोली, ‘मेरै ई खेचै रहै कामां आल़ै संघै सीला च़ुंघदी लागी ज़ेभै तैणीं लऊंणीं खतम निं होए।’”<verse eid="RUT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 2:22" />नाओमी बोलअ रूता लै, “राम्बल़ी हुई बेटीऐ कि तूह तिन्‍नें ई दासी संघा-संघा डेओए, होरीए खेचै कै थोघ लागा कि लोग किज़ै करे।” <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />तेखअ रही रूत ज़ौ अर कणके लऊंणीं खतम हणैं तैणीं बोआज़े दासी संघा-संघा सीला च़ुंघदी लागी, संघा रहा ती आपणीं शाशुई संघै।<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">रूत अर बोआज़</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />थोल़ै धैल़ै बाद बोलअ नाओमी रूता लै इहअ, मुंह हुअ ताल्है लाल़अ लोल़णअ, ताकि तेरअ भलअ होए। <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />ज़सरै खेचा का तंऐं कामां आल़ै संघै सीला ज़ौए नाज़े सील च़ुंघी आणै, सह आसा म्हारै ई टबरा बाखो, तेऊ नाओं आसा बोआज़। ऐबै शुण, सह बोआज़ हणअ भाल़ै आझ़ उडै खहल़ै नाज़ा मांडदअ लागअ द। <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />तूह न्हैऊ संघा डेऊ नऊंऐं झिकल़ै बान्हीं अर खुशबूदार तेल लाई तेऊए खहल़ा<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">खहल़ा </char><char style="ft" closed="false">नाज़ा मांडणै अर पूणणें-फल़ाक्‍कणे ज़ैगा</char></note> लै ज़िधी सह नाज़ा मांडदअ हणअ लागअ द। पर ज़ांऊं तैणीं सह खाई-पिई निं मुक्‍के, तेभै तैणीं निं तेऊ का थोघ लोल़ी लागअ कि तूह आसा तिधी।<verse eid="RUT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 3:4" />तूह दैऐ भाल़णीं कि सह किधी सुत्तअ, ज़ांऊं तेऊ घणीं नींज एछे, तेखअ डेओऐ तूह खुडी भितरी संघा च़कै तेऊए ज़ांघा बाखा दोहल़ू उझै, संघा रहै तेऊए खूरा सेटा सुत्ती। तेऊ खोज़णअ ताल्है आप्पै कि किज़ै करनअ।<verse eid="RUT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 3:5" />रूतै दैनअ ज़बाब, “ज़िहअ तंऐं बोलअ हुंह करूं तिहअ ई।”<verse eid="RUT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 3:6" />तेखअ डेऊई सह बोआज़े खहल़ा लै संघा किअ तैहा तिहअ ई ज़िहअ तेसे शाशुई खोज़ी त डाहअ द।<verse eid="RUT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 3:7" />ज़ांऊं बोआज़ खाई-पिई मुक्‍कअ अर ज़ांऊं तेऊ का नंद ज़ाण्हुंई, तेखअ रहअ सह नाज़े रूल़ा सेटा एकी कूणीं सुत्ती। रूत बी रही च़ुप्प-च़ुप्पै तेऊए खूरा सेटा दोहल़ू हेठै सुत्ती। <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />आधी राची फिरअ बोआज़ पाशल़ी अर तेऊए डेऊई नींज अर सह झशकुअ अर तेऊ भाल़अ कि तेऊए खूरा सेटा आसा कुंण बेटल़ी सुत्ती दी!<verse eid="RUT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="RUT 3:9" />बोआज़ै बोलअ, “तूह कुंण आसा?” तैहा बोलअ, “मेरै मालक, हुंह तेरी दासी आसा रूत, मुंह दै आपणैं च़ादरू हेठै रहणैं<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fq" closed="false">च़ादरू हेठै रहणैं </char><char style="ft" closed="false">मुंह बणां आपणीं लाल़ी</char></note> किल्हैकि तूह ई आसा म्हारै टबरा बाखो ज़हा म्हारी ज़िम्मीं कुआसणेंओ हक आसा।”<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="LEV 22:30">लेब. 22:30</ref> </char></note><verse eid="RUT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 3:10" />बोआज़ै बोलअ तैहा लै, “बिधाता लोल़ी ताल्है बर्गत दैनी, आपणीं शाशुई लै ता झ़ूरा तूह खास्सी पर तेरअ टबरा लै झ़ूरनअ शुझुअ होर बी खास्सअ। तूह सका ती कहा खारकै मणछा, सेठ मणछा लोल़ी लागी पर तंऐं निं इहअ किअ।<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="RUT 1:10">रूत. 1:10</ref></char></note> <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />बेटीऐ, ऐबै निं तूह फिकर करै, हुंह करूं ज़िहअ तंऐं बोलअ तिहअ ई, किल्हैकि नगरीए सोभ लोग करा तेरअ इहअ बोली अदर कि तूह आसा नित-पत्त आल़ी। <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />अह गल्‍ल बी आसा शुची कि हुंह आसा थारअ खास टबर ज़हा थारी ज़िम्मीं कुआसणेंओ हक आसा। पर एक आसा होर ज़ुंण तम्हां लै मुखा बी खास आसा अर मुखा आजी आसा अह हक तेऊओ। <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />काल्‍ला पुछ़ुं हुंह तेऊ, ज़ै सह थारअ टबर थारी ज़िम्मीं कुआसणें ज़िम्मैंबारी लए, तै ठीक, पर ज़ै सह नांह करे, तै दैनी मंऐं बिधाते नाओंऐं ज़बान कि तेखअ आसा मेरी ज़िम्मैंबारी। ऐबै रह तूह दोत्ती तैणीं इधी सुत्ती।”<verse eid="RUT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 3:14" />तेखअ रही रूत तिधी तेऊए खूरा सेटा सुत्ती, पर सह गई दोत्ती राच भैणै का आजी उझ़ुई ताकि तैहा कुंण होर कोह निं बछ़ैणें। बोआज़ै बोलअ तैहा लै इहअ, “इहअ थोघ निं कोही का लोल़ी लागअ कि खहल़ै ती कुंण बेटल़ी आई दी।”<verse eid="RUT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="RUT 3:15" />तेखअ बोलअ बोआज़ै तैहा लै भिई, “आपणैं च़ादरू फुआर धरनीं।” ज़ांऊं तैहा च़ादरू फुआरी करै ढाकअ, बोआज़ै दैनै तैहा लै दूई मण<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="fq" closed="false">दूई मण </char><char style="ft" closed="false">कोई तिह किलू</char></note> ज़ौ अर तेता आपणीं कान्हा च़की डेऊई सह नगरी आपणीं शाशुई सेटा। <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />ज़ांऊं सह घअरै पुजी, तेसे शाशुई नाओमी पुछ़ी सह, “बैल़ी किज़ै-किज़ै हुअ?”</para>
  <para style="p" vid="RUT 3:16">रूतै खोज़ी तैहा का सारी गल्‍ला बाढै कि बोआज़ै तैहा लै किज़ै-किज़ै किअ अर <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />रूतै खोज़अ इहअ बी, “ईंयां दूई मण ज़ौ दैनै तेऊ इहअ बोली कि आपणीं शाशुई सेटा निं रित्तै हाथै डेऊई आथी।”<verse eid="RUT 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 3:18" />नाओमी बोलअ तैहा लै इहअ, “रूत, मेरी बेटीऐ ज़ांऊं तैणीं ऐहा गल्‍लो नतिज़अ निं निखल़े, तेभै तैणीं रह च़ुप्पी न्हैल़ी लागी। ज़ांऊं तैणीं इना गल्‍लो इंतज़ाम करी निं मुक्‍के तेभै तैणीं निं बोआज़ बशैघ करी गअ।”<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">बोआज़ै किअ रूता संघै बैह</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />बोआज़ डेऊअ नगरीए प्रऊल़ी सेटा ज़िधी झाल़अ करा, संघा बेठअ तिधी। तेखअ शादअ बोआज़ै एलीमोलको सह सोभी का खास टबर ज़सरै बारै तेऊ गल्‍ला किई ती, सह बी आअ तिधी अर बोआज़ै बोलअ, “मेरै साथी इधी बेश।” सह बी आअ संघा बेठअ तिधी। <verse eid="RUT 4:1" /><verse number="2" style="v" sid="RUT 4:2" />तेखअ शादै बोआज़ै नगरीए दस सैणैं, तिन्‍नां लै बी बोलअ तेऊ तिधी बेशणा लै। ज़ांऊं तिंयां तिधी बेठै, <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />तेखअ बोलअ बोआज़ै तेऊ खास टबरा लै, “नाओमी आसा मोआब देशा का फिरी आई दी, सह च़ाहा म्हारै टबरा बाखे भाई एलीमोलके ज़िम्मीं मांझ़ै धख बेच़णीं। <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />तै ज़ाणअ मंऐं इहअ कि हुंह लऊं ऐहा गल्‍ला ताखा पुछ़ी। ज़ै तूह बोला, तै लअ तेता इना सैणैं नदरी मोलै। ज़ै करा तूह नांईं, तैबी बोल, किल्हैकि कुआसणेंओ हक निं ताह सुआई कोही आथी अर ताह बाद आसा सिधअ मुखा।”</para>
  <para style="p" vid="RUT 4:4">तेऊ खास टबरै बोलअ, “हुंह कुआसूं एता आप्पै।”<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 1">बधा.</ref> </char></note><verse eid="RUT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 4:5" />तेखअ बोलअ बोआज़ै, “ज़ै तूह नाओमी का ज़िम्मीं कुआसे, तै हुई ताह मोआब देशा का आई दी रूता संघै बी बैह करनअ ज़ुंण बिधबा आसा। ताकि सह आपणैं मूंऐं दै मर्धा लै लुआद पैईदा करे अर तैहा ज़िम्मीं दी तेऊ मूंऐं दै मणछो नाअं रहे।”<verse eid="RUT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 4:6" />तेखअ बोलअ तेऊ खास टबरै, “ज़ै इहअ आसा, तै निं हुंह ऐहा ज़िम्मीं कुआसी सकदअ, एता करै पल़णअ मेरी आपणीं ज़ैदाता बी फरक। एता का कुआस मुंह बाखा तूह आप्पू लै, मंऐं निं लाई अह ज़ैगा कुआसी।”<verse eid="RUT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 4:7" />तेऊ ज़मानै त इज़राईली मांझ़ै ज़िम्मीं कुआसणैं अर बदल़ै करनैओ इहअ रबाज़ कि बेच़णैं आल़अ दैआ त आपणैं खूरो पोलल़अ तेऊ मोलै लणैं आल़ै लै। इहअ करै हआ ती तिन्‍नां मांझ़ै सह गल्‍ल पाक्‍की।<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="LEV 1">लेब.</ref> </char></note><verse eid="RUT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 4:8" />तैही ज़ांऊं तेऊ एलीमोलके खास टबरै इहअ बोलअ, “एता कुआस तूह ई।” तेऊ खोल्हअ आपणैं खूरो पोलल़अ संघा दैनअ बोआज़ा लै।<verse eid="RUT 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="RUT 4:9" />तेखअ बोलअ बोआज़ै तिन्‍नां नगरीए सैणैं अर तिधी आऐ दै सोभी लोगा लै, “तम्हैं सोभै आसा ऐहा गल्‍ले शाजत किई मंऐं कुआसी आझ़ नाओमी का सारी ज़ैदात ज़ुंण एलीमोलक अर तेऊए दूई शोहरू कलोन अर मलोने थिई। <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />एता का लाऊआ, मोआब देशा का आणी दी रूत ज़ुंण मलोने बिधबा आसा, सह बी कुआसी मंऐं आप्पू लै कि आझ़ा पोर्ही आसा सह मेरी बेटल़ी, ताकि सह आपणैं मूंऐं दै मर्धा लै लुआद पैईदा करे अर तेऊ तैहा ज़िम्मींओ मालक बणांए। इहअ करै निं तिन्‍नें आपणैं टबरा जैंदरी अर आपणीं नगरी दी अत्री हणीं। इना गल्‍ले शाजत आसा आझ़ तम्हैं सोभै।”<verse eid="RUT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 4:11" />तिन्‍नैं नगरीए सैणैं अर तिधी सोभी आऐ दै बोलअ, “हाम्हैं आसा ऐहा गल्‍ले शाजत। ज़ुंण बेटल़ी तेरै घअरै आई, तैहा लै लोल़ी बिधाता राहेल अर लिआ ज़ेही बर्गत दैनी ज़ुंणीं इज़राईला लै खास्सी आद-लुआद दैनी। तूह लोल़ी एप्रात<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="fq" closed="false">एप्रात </char><char style="ft" closed="false">एप्रात थिअ फिरिस </char><char style="fp" closed="false">टोलीओ प्रोढअ अर बोआज़ बी थिअ तैहा ई टोलीओ</char></note> टोली दी सेठ अर बेतलेम नगरी दी मशूर हुअ।<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 35:19">मूल. 35:19</ref>,<ref loc="GEN 35:23-26">23-26</ref></char></note> <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />ऐहा ज़ुआन बेटल़ी का बिधाता ताल्है ज़ुंण लुआद दैए, सह लोल़ी यहूदा अर तामारे शोहरू फिरिसे<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="fq" closed="false">फिरिसे </char><char style="ft" closed="false">अह त यहूदे आद-लुआदा मांझ़ै बोआज़ अर कई होर ज़ुंण बेतलेम नगरी तै बस्सै दै।</char></note> खिंबा ज़िहअ हुअ।”<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="GEN 1">मूल.</ref> </char></note><verse eid="RUT 4:12" /></para>
  <para style="s">बोआज़ अर रूता का आजू लुआद</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />इहअ करै किअ बोआज़ै रूता संघै बैह अर सह हुई तेऊए बेटल़ी। बिधाता दैनी तैहा लै एही बर्गत कि सह हुई सुंदी अर तेखअ हुअ तेसो एक शोहरू।<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="GEN 1">मूल.</ref> </char></note> <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />नगरीए होर बेटल़ी लागी नाओमी लै इहअ बोल्दी, “बिधाता दैनी ताल्है बर्गत! तेऊ दैनअ ताल्है आझ़ पोचअ कि सह तेरी हेर-सभाल़ करे। अह शोहरू लोल़ी त इज़राईला दी खास्सअ मशूर हुअ!<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="LUK 1">लूक.</ref> </char></note> <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />तेरी नुश झ़ूरा ताल्है खास्सी, ऐहा किअ ताल्है साता शोहरू हणैं का बी खास्सअ। ऐहा दैनअ ताल्है पोचअ ज़ेता करै ताह नऊंईं ज़िन्दगी भेटी अर बुढल़दा हणअ अह तेरी फाज़त करनै आल़अ।”<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="1SA 1">1 शमू.</ref> </char></note><verse eid="RUT 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 4:16" />नाओमी च़कअ सह शोहरू उझै संघा लाअ आपणीं हिक्‍का दी, संघा रही तेऊ शोहरू धाचदी लागी।<verse eid="RUT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 4:17" />होर बेटल़ी ज़ुंण ओर्ही-पोर्ही संघा रहा ती, तिन्‍नैं डाहअ तेऊ शोहरू नाअं ओबेद<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="fq" closed="false">ओबेद </char><char style="ft" closed="false">मतलब आसा दास, तैहा डाहअ तेऊ नाओं इहअ सोठी ओबेद कि एऊ करनी आपणीं दादी नाओमीए च़ाकरी</char></note>। तिंयां बोला ती सोभी का, “नाओमीओ हुअ भाऊ!”</para>
  <para style="p" vid="RUT 4:17">ओबेद त ईशैईओ बाब अर राज़ै दाबेदो दादू।<verse eid="RUT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 4:18" />फिरिसो खिंब आसा अह: फिरिसो शोहरू त हिस्रोन,<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="1CH 2:4">1 इति. 2:4</ref>; <ref loc="1CH 1:3">1:3</ref> </char></note> <verse eid="RUT 4:18" /><verse number="19" style="v" sid="RUT 4:19" />हिस्रोना का हुअ राम अर रामा का हुअ अमीनादाब, <verse eid="RUT 4:19" /><verse number="20" style="v" sid="RUT 4:20" />अमीनादाबो हुअ आजू नहशोन अर नहशोनो हुअ सलमोन, <verse eid="RUT 4:20" /><verse number="21" style="v" sid="RUT 4:21" />सलमोना का हुअ बोआज़ अर बोआज़ा अर रूता का हुअ ओबेद, <verse eid="RUT 4:21" /><verse number="22" style="v" sid="RUT 4:22" />ओबेदा का हुअ ईशैई अर ईशैईओ शोहरू त राज़अ दाबेद।<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>