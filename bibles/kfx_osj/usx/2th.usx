  <para style="h">2 थिस्सलूणी</para>
  <para style="toc1">थिस्सलूणी नगरीए विश्वासी टोली लै दुजी च़िठी</para>
  <para style="toc2">2 थिस्सलूणी</para>
  <para style="toc3">2 थिस.</para>
  <para style="mt1">2 थिस्सलूणी</para>
  <para style="mt2">थिस्सलूणी नगरीए विश्वासी टोली लै दुजी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: पल़सी</para>
  <para style="ili">पहल़णैं आल़ै: थिस्सलूणी नगरीए विश्वासी</para>
  <para style="ili">सन: 51</para>
  <para style="ip">मसीहे फिरी एछणें बारै उलझ़ण पल़णें बज़्हा ती थिस्सलूणी नगरीए विश्वासी टोली दी गड़बडी पैईदा हुई दी। थिस्सलूणी नगरीए विश्वासी टोलीए नाओंए पल़सीए दुजी च़िठी ती लिखी दी ऐहा गल्‍ला दी बच़ार करने बारै लिखी दी कि मसीहे फिरी एछणें धैल़ी आसा गई दी पैहलै ई नेल़ एछी। पल़सी समझ़ाऊआ इहअ खोज़ी करै कि मसीहे फिरी एछणैं का आजी हणीं निक्‍की सोठ अर बूराई आपणीं हदा का बागै। इहअ हणअ एकी नुआहरै राज़ैए गलामी दी ज़हा लै, “पापो मर्ध मतलब बनाशो शोहरू” आसा बोलअ द, ज़हा मसीहो बरोध करनअ।</para>
  <para style="ip">शधाणूं दैआ ऐहा गल्‍ला दी रहणा लै ज़ोर कि सारै दुख अर कष्ट ज़िरदी लागा तेऊए पहल़णैं आल़ै विश्वासा दी मज़बूत रहणअ बणी। आपणीं गरज़ा पूरी करना लै लागा रहणअ काम-काज़ करदै लागी ज़िहअ कि पल़सी अर तेऊए साथी करा तै, अर भलाई करदै बी रहणअ लागी।</para>
  <para style="ip">पल़सी नैरा इहअ कि ज़ैऊंकर निं हणअ अर इहअ बी बोला कि आपणीं टोली दी डाहै धैन कि कुंण इहअ किनी आसा ज़ुंण मेरी ऐहा च़िठी दी लिखी दी गल्‍ला नांईं मंदअ होए। खिरी मुक्‍का च़िठी पल़सीए परमेशरा सेटा एही अरज़ करनै करै:</para>
  <para style="imq">“प्रभू ज़ुंण शांती दैणैंओ मूल़ आसा, हुंह करा तेऊ का एही अरज़ कि तेऊ लोल़ी तम्हां लै एही बर्गत दैनी कि सह तम्हां लै शांती दैए। हुंह करा प्राथणां कि प्रभू लोल़ी कबल्‍लअ तम्हां सोभी संघै रहअ।”</para>
  <para style="ipr">(3:16)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1:1,2</para>
  <para style="io1">स्तोती अर बड़ैई 1:3-12</para>
  <para style="io1">मसीहे फिरी एछणें बारै शिक्षा 2:1-17</para>
  <para style="io1">मसीही बभारे बारै शिक्षा 3:1-15</para>
  <para style="io1">नचोल़ 3:16-18</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />अह च़िठी आसा पल़सी, सिलास अर तिमोथी बाखा। हाम्हैं आसा अह थिस्सलूणी रहणैं आल़ी विश्वासीए टोली लै लिखी दी ज़ुंण म्हारै बाब परमेशर अर प्रभू ईशू मसीहे आसा।<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />म्हारै बाब परमेशर अर प्रभू ईशू मसीहा का आसा म्हारी अरज़ कि तम्हां सोभी लोल़ी झींण अर शांती सदा हुई।<verse eid="2TH 1:2" /></para>
  <para style="s">नसाफ हणें धैल़ी</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />भाईओ, थारै बारै लोल़ी त हाम्हैं हर बगत परमेशरा लै शूकर किअ। अह ठीक बी आसा इहअ करै कि थारअ विश्वास आसा मसीहा दी होर बी खास्सअ बढदअ लागअ द अर थारी एकी-दुजै लै झ़ूरी बी आसा बढदी लागी दी। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />तैही करा हाम्हैं आप्पू बी परमेशरे होरी टोली दी थारै बारै घमंड कि तम्हैं ज़िरै खास्सै सांगट अर खरी, पर तज़ी बी किअ तम्हैं खास्सअ सबर अर थारअ भरोस्सअ आसा मसीहा दी अज़ी बी पाक्‍कअ।<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />एता करै हआ अह गल्‍ल पाक्‍की कि परमेशरो नसाफ आसा शुचअ अर एतो नतिज़अ हआ इहअ कि तम्हैं हआ परमेशरे राज़ा दी डेऊणैं जोगी ज़ेते तैणीं तम्हैं दाह-दुख ज़िरदै आसा लागै दै। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />ऐबै ज़ै परमेशर सदा धर्मां संघै करा नसाफ, तेऊ आणनअ तिन्‍नां लै सांगट ज़ुंणी तम्हां लै सांगट दैनअ।<verse eid="2TH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2TH 1:7" />तम्हां ज़हा एभै सांगट आसा तेऊ दैणीं तम्हां चैन अर हाम्हां लै बी, अह हणअ तेभै ज़ेभै कि प्रभू ईशू मसीहा आपणैं शगती आल़ै स्वर्ग दूता संघै स्वर्गा का एछणअ अर फेर हणीं आग भकी दी।<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JHN 1:14-15">जोह. 1:14-15</ref>; <ref loc="REV 14:3">प्रका. 14:3</ref></char></note><verse eid="2TH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TH 1:8" />ज़ुंण परमेशरा नांईं बछ़ैणदै, अर म्हारै प्रभू ईशूए खुशीए समादा नांईं मंदै, तेऊ दैणीं तिन्‍नां लै तेभै सज़ा।<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="PSA 79:6">भज. 79:6</ref>; <ref loc="ISA 66:15">ईशा. 66:15</ref>; <ref loc="JER 10:25">जेर. 10:25</ref></char></note><verse eid="2TH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 1:9" />तिंयां हणैं प्रभू का सदा लै ज़ुदै अर तिंयां निं परमेशरे महान प्रतप्पे शगतीए साझ़ू हणैं तेऊ दैणीं तिन्‍नां लै सज़ा कि तिंयां हणैं सदा लै खतम।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="REV 21:8">प्रका. 21:8</ref>; <ref loc="MAT 25:41">मोत्त. 25:41</ref>,<ref loc="MAT 25:46">46</ref>; <ref loc="ISA 2:19">ईशा. 2:19</ref>,<ref loc="ISA 2:21">21</ref></char></note><verse eid="2TH 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2TH 1:10" />अह हणअ तेभै ज़ुंण घल़ी परमेशरै प्रभू ईशू लै स्वर्गा का फिरी एछणा लै आसा डाही दी। एतो नतिज़अ हणअ इहअ कि तेभै रहैऊंणअ हाम्हां पबित्र मणछा तेऊओ प्रतप्प अर तेभै हणीं हाम्हां तेऊ दी रहैनी ज़ुंण हाम्हैं तेऊ दी विश्वास करा। तूह बी हणअ तेभै तिधी किल्हैकि तंऐं बी किअ तेता दी विश्वास ज़ुंण हाम्हैं तेऊए बारै खोज़अ।<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="1TH 2:13">1 थिस. 2:13</ref>; <ref loc="1CO 1:5">1 करि. 1:5</ref>; <ref loc="PSA 89:7">भज. 89:7</ref>; <ref loc="ISA 49:3">ईशा. 49:3</ref></char></note><verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />हाम्हैं करा तम्हां लै कबल्‍ली प्राथणां इहअ बोली कि परमेशर तम्हां तेही ज़िन्दगी ज़िऊंणै जोगी बणांए ज़ेता लै तेऊ तम्हैं शादै दै आसा। हाम्हैं करा एही अरज़ बी कि सह तम्हां लै तिन्‍नां सोभी भली गल्‍ला करने शगती दैए ज़ुंण थारअ विश्वास तम्हां करना लै बोला। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />हाम्हैं करा एही प्राथणां एते तैणीं कि तम्हां करै लोग म्हारै प्रभू ईशूओ नाअं सराहे अर तम्हैं मसीहे हणैं पिछ़ू थारअ अदर होए। इहअ हणअ किल्हैकि म्हारअ परमेशर अर प्रभू ईशू मसीहा आसा तम्हां लै खास्सअ झणैल़ू।<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ISA 24:15">ईशा. 24:15</ref>; <ref loc="ISA 66:5">66:5</ref>; <ref loc="1PE 1:7-8">1 पत. 1:7-8</ref></char></note><verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">पापो शोहरू मतलब बनाशो शोहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />भाईओ, हाम्हैं लाई तम्हां का धख गल्‍ला प्रभू ईशू मसीहे फिरी एछणें बारै अर तेऊ बगते बारै खोज़ी ज़ेभै हाम्हां सोभै कठा तेऊ का मिलणैं। <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />तम्हैं निं आपणीं सोठदै रही धखी का झाखुई आथी या इहअ शूणीं कि प्रभू एछणें सह धैल़ी आसा एछी मुक्‍की दी। कई सका तम्हां लै इहअ समाद खोज़ी या एही गल्‍ला खोज़ी या च़िठी दैई कि अह आसा तम्हां लै हाम्हां बाखा आई दी।<verse eid="2TH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 2:3" />लोगे इना एही झ़ुठी गल्‍लो विश्वास करी निं कबाता पल़ी। किल्हैकि मसीहा फिरी एछणैं का आजी एछणअ इहअ बगत तेभै हणैं खास्सै मणछ परमेशरे द्रोही। ज़हा कदुष्टो परमेशरा न्हैरी जम्परी बनाश करनअ, सह हणअ तेभै प्रगट। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />तेऊ करनअ परमेशरो अर तिन्‍नां सोभी गल्‍लो बरोध ज़ेता लोग पूज़ा अर देअ बोला। तेऊ बोल़णअ इहअ कि सह आसा इना सोभी का महान। होर ता होर तेऊ कदुष्टा बोल़णअ परमेशरे भबनै बेशी सोभी का कि सह आसा आप्पू ई परमेशर।<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="EZK 28:2">एज. 28:2</ref>; <ref loc="DAN 11:36-37">दान. 11:36-37</ref></char></note><verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />तम्हां कै आद निं रही कि ज़धू हुंह तिधी तम्हां सेटा थिअ, हुंह करा त इना गल्‍ला तम्हां का खोज़ी? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />एभै निं अज़ी परमेशरो दुशमण सह कदुष्ट प्रगट हुअ आथी, किल्हैकि किज़ै एही च़िज़ा आसा ज़ुंणी सह रोक्‍की आसा डाहअ द। तम्हां हणीं आद रही दी कि सह कुंणी आसा रोक्‍की डाहअ द। सह कदुष्ट निखल़णअ तेभै आप्पै ज़ुंण बगत तेऊ लै परमेशरै आसा डाहअ द। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />किल्हैकि तेऊ कदुष्टे शगती करा अज़ी गुप्त रुपै एऊ संसारै परमेशरे खलाफ काम। पर एक आसा इहअ ज़ुंणी सह शगती रोक्‍की आसा डाही दी अर तेऊ डाहणीं सह तेभै तैणीं रोक्‍की ज़ेभै तैणीं परमेशर तेऊ दूर नां करे।<verse eid="2TH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TH 2:8" />तेखअ हणअ सह कदुष्ट प्रगट, पर बादा का ज़ांऊं प्रभू ईशू एछणअ तेऊ करनअ सह कदुष्ट आपणीं खाखा का एक बैण बोली अर आपणैं एछणें प्रतप्पा करै खतम।<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="JOB 4:9">आयू. 4:9</ref>; <ref loc="ISA 11:4">ईशा. 11:4</ref></char></note><verse eid="2TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 2:9" />ज़ेभै परमेशरो दुशमण सह कदुष्ट प्रगट हणअ, तेऊ लै दैणीं राख्सा आपणीं शगती। संघा करनै तेऊ कदुष्टा कई रंगे नछ़ैण अर च़मत्कार अर लोगा सोठणअ इहअ कि एता आसा परमेशर लागअ द करदअ। <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />तेऊ करनअ तिन्‍नां लै सोभी साबै बूरअ अर तिंयां पाणै कबाता ज़ुंण परमेशरा करै बरैबाद हणैं। किल्हैकि तिंयां हुधूऐ तैहा झ़ूरी अर तेऊ सत्ता मनणै का ज़ुंणी तिंयां बच़ाऊऐ दै आसा।<verse eid="2TH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 2:11" />तैही छ़ाडणीं परमेशरा एही शगती ज़ुंण तिन्‍नां सत्ता का कबाता पाए अर तिंयां झ़ुठी गल्‍ला दी विश्वास करे। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />ज़ेतरै लोग सत्ता दी विश्वास नांईं करदै पर पाप करनै करै खुश रहा, तिन्‍नां सोभी लै भेटणीं सज़ा।<verse eid="2TH 2:12" /></para>
  <para style="s">मज़बूत रहा बणी</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />भाईओ, तम्हां लागा हर बगत परमेशरो शूकर करनअ, तम्हां लै करा प्रभू झ़ूरी किल्हैकि परमेशरै आसा पैहलै ई तम्हैं पबित्र आत्मां करै पापा का दूर किऐ दै अर सत्ता दी थारै विश्वास करनै पिछ़ू उद्धार हणां लै छ़ांटै दै।<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 1:4-5">इफि. 1:4-5</ref>; <ref loc="1PE 1:1-5">1 पत. 1:1-5</ref>; <ref loc="DEU 33:12">बधा. 33:12</ref> </char></note><verse eid="2TH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 2:14" />ज़ुंण खुशीओ समाद तम्हां का हाम्हैं खोज़अ, तेता करै शादै तेऊ तम्हैं उद्धार हणां लै ताकि तम्हां म्हारै प्रभू ईशूए प्रतप्पा दी साझ़ू हई सके।<verse eid="2TH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15" />भाईओ, तैही बोला हुंह, पाक्‍कै रहा टेक्‍की, तिन्‍नां गल्‍ला दी डाहा विश्वास ज़ुंण हाम्हैं तम्हां संघै रहंदी या तम्हां लै च़िठी लिखी करै सखाऊई।<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />हाम्हैं करा आपणैं प्रभू ईशू मसीहा अर म्हारै बाब परमेशरा का प्राथणां ज़ुंण हाम्हां लै झ़ूरी करा अर सह ज़सरअ जश हाम्हां लै सदा लै हैअ अर पाक्‍की आशा दैआ। <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />हुंह करा प्राथणां कि परमेशर तम्हां लै हैअ दैए अर तम्हां लै एही तागत दैए कि तम्हैं हर बगत भली गल्‍ला करदै अर खोज़दै रहे।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">प्राथणां करने अरज़</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />भाईओ, खिरी बोला हुंह इहअ कि हाम्हां लै बी करा प्राथणां कि ज़ेतरअ छ़ेक्‍कै हई सके हाम्हैं प्रभू ईशूओ खुशीओ समाद हर ज़ैगा खोज़ी सके अर ज़िहअ तम्हैं विश्वास किअ तिहै होर लोग बी विश्वास करी सके। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />एता लै बी करा प्राथणां कि परमेशर हाम्हां बूरै अर कदुष्ट मणछा का बी बच़ाऊई डाहे कि तिंयां हाम्हां लै कष्ट नां दैए, किल्हैकि कई लोग ज़ुंणी ईशू मसीहे बारै समाद शूणअ तिंयां निं विश्वास करदै।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पर तम्हैं सका प्रभू दी पूरअ भरोस्सअ डाही, तेऊ करनै तम्हैं भितरा का पाक्‍कै अर बच़ाऊई ताकि सह राख्स तम्हां लै कष्ट नां दैए।<verse eid="2TH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2TH 3:4" />हाम्हां आसा प्रभू दी भरोस्सअ कि हाम्हैं तम्हां लै ज़िहअ करना लै बोलअ त तम्हैं करा तिहअ ई अर आजू बी रहणैं तम्हैं करदै लागी। <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />हाम्हैं करा प्राथणां कि म्हारअ प्रभू ईशू मसीहा ऐहा गल्‍ला थारै दिलै पाए कि परमेशर तम्हां लै केतरी झ़ूरी करा अर ज़ेभै लोग तम्हां कष्ट दैए तेभै सह सबर करना लै थारी मज़त करे ज़ेही तेऊ आप्पू सबर किअ।<verse eid="2TH 3:5" /></para>
  <para style="s">कामां करने ज़िम्मैंबारी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />भाईओ, ज़ुंण हक हाम्हां लै प्रभू ईशू आसा दैनअ द तेता करै दैआ हाम्हैं तम्हां लै हुकम कि इहै विश्वासी का रहा ज़ुदै ज़ुंण किछ़ै काम निं करदै अर म्हारी खोज़ी दी तिन्‍नां शिक्षे साबै आपणीं ज़िन्दगी निं ज़िऊंदअ। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />किल्हैकि तम्हां का आसा राम्बल़ै करै थोघ कि तम्हां लागा तेऊ साबै ज़िन्दगी ज़िऊंणीं ज़ेही म्हारी ज़िन्दगी आसा। ज़धू हाम्हैं तम्हां मांझ़ै तै हाम्हैं निं बृथा रहै हाम्हैं किअ काम। <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />हाम्हैं निं कोहिए रोटी मुफ्त खाई, पर मैन्थ अर कष्ट करी राची धैल़ी करा तै आप्पू काम, ताकि हाम्हैं तम्हां मांझ़ै कोही लै बी बोझ़ नां होए। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />हाम्हां आसा अह बी हक कि हाम्हैं आपणीं ज़रुरती पूरी करना लै थारी आशा रहे किल्हैकि हुंह आसा शधाणूं, पर हाम्हैं किई खास्सी मैन्थ ताकि तम्हैं मुखा शिखल़ी सके अर तम्हैं बी तिहअ ई करे ज़िहअ म्हारअ बभार आसा।<verse eid="2TH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2TH 3:10" />ज़धू हाम्हैं तम्हां सेटा तै तधू रहा तै हाम्हैं तम्हां लै इहअ बोल्दै लागी, “ज़ै कुंण काम नांईं करनअ च़ाहंदअ, सह निं खाई बी आथी।” <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />हाम्हैं शूणअ इहअ बी कि कई लोग आसा तम्हां मांझ़ै इहै बी ज़ुंण आप्पू किछ़ै काम निं करदै, पर होरीए कामां दी पाआ खरोल़। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />इहै लै दैआ हाम्हैं प्रभू ईशू दी हुकम अर तिन्‍नां समझ़ाऊआ कि च़ुप्प-च़ुप्पै खाआ आपणैं ढब्बै खटी करै रोटी। <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />भाईओ, भलै काम करनै निं छ़ाडी, किल्हैकि तम्हैं आसा थकै दै।<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />ज़ै कोई म्हारी ऐहा च़िठीए गल्‍ला नांईं मने, तेऊ दी डाहै धैन अर तेऊ का रहा ज़ुदै, ताकि सह शर्मिंदअ होए। <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />पर तैबी निं तेऊ संघै दुशमणा ज़िहअ बभार करी, पर तेऊ समझ़ाऊआ तिहै ज़िहै तम्हैं आपणैं भाई-भाऊ समझ़ाऊअ।<verse eid="2TH 3:15" /></para>
  <para style="s">खिरी राज्ज़ी-खुशी दैणीं</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />प्रभू ज़ुंण शांती दैणैंओ मूल़ आसा, हुंह करा तेऊ का एही अरज़ कि तेऊ लोल़ी तम्हां लै एही बर्गत दैनी कि सह तम्हां लै शांती दैए। हुंह करा प्राथणां कि प्रभू लोल़ी कबल्‍लअ तम्हां सोभी संघै रहअ।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />हुंह पल़सी लिखा तम्हां लै आपणैं हाथै राज्ज़ी-खुशी अर हर च़िठी दी आसा मेरअ अह ई नछ़ैण अर हुंह लिखा इहअ ई ताकि सोभी का थोघ लागे कि च़िठी आसा मुंह बाखा। <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />हुंह करा परमेशरा का अरज़ कि हाम्हां सोभिए प्रभू ईशूए झींण लोल़ी सदा तम्हां सोभी लै हुई।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>