  <para style="h">फिलेमोन</para>
  <para style="toc1">फिलेमोना लै लिखी दी च़िठी</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc3">फिल.</para>
  <para style="mt1">फिलेमोन</para>
  <para style="mt2">फिलेमोना लै लिखी दी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: पल़सी</para>
  <para style="ili">पहल़णैं आल़ै: फिलेमोन</para>
  <para style="ili">सन: 61-62</para>
  <para style="ip">फिलेमोन त एक खास मसीही। इहअ बी सका हई कि सह थिअ कुलूस्स नगरीए मसीही टोलीओ दी साझ़ू अर उनेसिमुस नाओंऐं एकी दासो मालक। अह थिअ आपणैं मालक सेटा का ठुर्हअ द, अर तेखअ भेटअ सह किहअ करै पल़सी का ज़ुंण तधू कैद खानै त बंद। पल़सी करै बणअ उनेसिमुस मसीहा दी विश्वास करनै आल़अ। फिलेमोने नाओंऐं शधाणूं पल़सीए अह च़िठी करा फिलेमोना का एही अरज़ कि सह करै आपणैं दास संघै भिई मेल़-ज़ोल़ ज़ुंण पल़सी तेऊ सेटा लै भिई लाअ छ़ाडी। तेऊओ निं सिधअ माफ किऐ दै दासा समझ़ी, तेऊ समझ़ै मसीहा दी आपणअ सक्‍कअ भाई:</para>
  <para style="imq">“मेरी आसा परमेशरा का एही अरज़ कि ज़ुंण साझ़ तेरी होरी विश्वासी संघै आसा, तेता करै लोल़ी ताखा तिन्‍नां सोभी भली गल्‍लो थोघ लागअ ज़ुंण हाम्हां लै परमेशरै आसा दैनी दी। एता करै लोल़ी मसीहो प्रतप्प शुझुअ।”</para>
  <para style="ipr">(1:6)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1-3</para>
  <para style="io1">फिलेमोने बड़ैई 4-7</para>
  <para style="io1">उनेसिमुस लान्हैं लै अरज़ 8-22</para>
  <para style="io1">नचोल़ 23-25</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />ऐहा च़िठी लिखा हुंह पल़सी ज़ुंण मसीहा ईशूए खुशीए समादा खोज़णैं पिछ़ू कैद आसा किअ द अर भाई तिमोथी।<verse eid="PHM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHM 1:2" />हुंह लिखा एता हाम्हां संघै मसीहे कामां दी साझ़ू म्हारै पैरै भाई फिलेमोन अर विश्वासी बैहण अफिहा अर अरखिप्पुस ज़ुंण परमेशरे च़ाकरी सपाही ज़ेही करा अर विश्वासी टोली ज़ुंण तेरै घअरै कठा हआ।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />म्हारै बाब परमेशर अर प्रभू ईशू मसीहा का आसा मेरी एही अरज़ कि तम्हां सोभी लै लोल़ी तेऊए झींण अर शांती सदा हुई।<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोने झ़ूरी अर विश्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />फिलेमोन, ज़ेभै बी हुंह ताल्है प्राथणां करा, हुंह करा हर बगत परमेशरो शूकर। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />किल्हैकि हुंह शूणां लोगा का तेरै बारै कि तूह प्रभू ईशू दी किहअ पाक्‍कअ भरोस्सअ डाहा। तेरै बारै इहअ बी शूणअ मंऐं कि तूह झ़ूरा सोभी लै अर सोभी विश्वासीए करा तूह मज़त।<verse eid="PHM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PHM 1:6" />मेरी आसा परमेशरा का एही अरज़ कि ज़ुंण साझ़ तेरी होरी विश्वासी संघै आसा, तेता करै लोल़ी ताखा तिन्‍नां सोभी भली गल्‍लो थोघ लागअ ज़ुंण हाम्हां लै परमेशरै आसा दैनी दी। एता करै लोल़ी मसीहो प्रतप्प शुझुअ। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />भाई फिलेमोन, तेरी मुल्है झ़ूरी करने हुई मुंह खास्सी खुशी अर शांती, तंऐं किऐ परमेशरे सोभी पबित्र मणछे दिल खुश।<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसिमुस लै अरज़</para>
  <para style="p">
    <verse number="8-9" style="v" sid="PHM 1:8-9" />मंऐं लाअ ताल्है किज़ै इहअ बोली ज़ुंण ताह करनअ लागे। ज़ुंण हक मुल्है मसीहा आसा दैनअ द, तेता करै सका त हुंह ताल्है इहअ करनैओ हुकम दैई, पर हुंह निं इहअ च़ाहंदअ। पर हुंह बोला एही ताल्है एता करना लै किल्हैकि हाम्हैं करा एकी-दुजै अर परमेशरे लोगा संघै झ़ूरी। ऐबै करा ताखा हुंह पल़सी प्रोढअ मणछ अरज़ अर सह ज़ुंण लोगै कैद खानै आसा बंद किअ द, किल्हैकि हुंह करा मसीहा ईशूए च़ाकरी।<verse eid="PHM 1:8-9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHM 1:10" />हुंह करा उनेसिमुसे तैणीं अरज़ ज़ुंण मेरै आपणैं शोहरू ज़िहअ आसा। तधू बणअ सह मसीहा दी मेरअ शोहरू ज़धू हुंह कैद खानै बंद त। हुंह करा ताखा एही अरज़ कि <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />पैहलै, निं सह तेरै किछ़ू कामों त, पर ऐबै आसा सह तेरै अर मेरै दुहीए कामों। <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />मंऐं लाअ सह ताह सेटा लै बापस छ़ाडी, सह ज़हा लै हुंह सारै दिला का झ़ूरी करा।<verse eid="PHM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PHM 1:13" />तेऊ च़ाहा त हुंह इधी आप्पू सेटा मेरी मज़त करना लै डाहणअ ज़ेभै तैणीं हुंह ईशू मसीहे बारै खुशीए समादा खोज़णैं पिछ़ू इधी कैद आसा। सह सका ताह बाखा इधी मेरी मज़त करी, किल्हैकि मुखा आसा थोघ कि तूह च़ाहा मेरी मज़त करनी।<verse eid="PHM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHM 1:14" />मंऐं निं तूह अज़ी पुछ़अ अर तंऐं बी निं मुल्है तेऊ इधी मुंह संघै डाहणें ज़ाज़त दैनी, मंऐं किअ इहअ बच़ार कि सह निं मुंह इधी डाहंणअ। हुंह बोला ताल्है बी इहअ कि तूह करै मेरी मज़त तै, ज़ै तूह सच्च़ी मेरी मज़त करनअ च़ाहे।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />झ़ाणीं परमेशरै सह थोल़ै धेल्‍लै लै ताखा एते तैणीं किअ दूर होए कि सह मसीहा ईशू दी विश्वास करे अर ताह सह आप्पू संघै सदा लै बापस भेटे। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पर ऐबै निं तेऊ सिधअ आपणअ गलाम समझ़ी। सह आसा ऐबै ताल्है गलामा का खास्सअ तेरअ संघी विश्वासी भाई! किल्हैकि तम्हैं दुहै करा प्रभू दी विश्वास सह आसा मेरअ पैरअ, पर ताल्है हणअ सह होर बी खास्सअ पैरअ। किल्हैकि सह आसा तेरअ गलाम बी अर विश्वासा दी तेरअ भाई बी।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />ज़ै तूह ऐहा गल्‍ला मना कि हुंह अर तूह आसा परमेशरे कामां लै साझ़ू, तै करै तूह तेऊओ इहअ सुआगत ज़िहअ कि तूह मेरअ करी सका। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />ज़ै तेऊ तेरी किज़ै हान्‍नी होए किई दी, या ज़ै तेऊ तेरअ किज़ै ऋण होए, तेता लिखै मेरै नाओंऐं।<verse eid="PHM 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHM 1:19" />हुंह पल़सी आसा लागअ द एता आपणैं हाथै लिखदअ कि ताल्है दैंऊं तेऊए बदल़ै हुंह तिन्‍नां ढब्बै-धेल्‍लै, ताखा आसा थोघ कि, ज़ै मंऐं तेरी मज़त निं किई हंदी, तै निं ताह आप्पू दी नऊंईं ज़िन्दगी भेटणीं ती, इहअ करै आसा ताखा तेरी ज़िन्दगी मेरअ ऋण।<verse eid="PHM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20" />ए मेरै भाई, खुशी लोल़ी मुंह प्रभू दी ताह बाखा का भेटी, हाम्हैं दुहै आसा मसीहा दी एक अर मेरअ दिल दैऐ खुश करी।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />हुंह लिखा ताल्है ऐहा च़िठी इहअ भरोस्सअ डाही करै कि तूह मना मेरी हर गल्‍ला अर ऐहा गल्‍लो बी आसा मुखा थोघ कि ताह करनअ तेता का बी खास्सअ ज़ुंण हुंह ताल्है बोला। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />एक गल्‍ल आसा होर कि ज़ेभै हुंह तेरै घअरै एछे तेभा लै डाहै मुल्है एक पांड ज़ुदी, मुंह आसा एही आशा कि थारी प्राथणां करै जाणअ हुंह कैद खानै का छ़ुटी तम्हां सेटा एछी।<verse eid="PHM 1:22" /></para>
  <para style="s">राज्ज़ी-खुशी</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />इपफ्रास ज़ुंण मसीहा ईशूए बारै लोगा का खोज़णैं पिछ़ू इधी मुंह संघै कैदी आसा, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />अर मार्कुस, अरिस्तखोरस, दमास अर लूका, ज़ुंण प्रभूए च़ाकरी लै मेरै साथी आसा, इनै बी आसा ताल्है राज्ज़ी-खुशी दैनी दी।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />हुंह करा परमेशरा का अरज़ कि म्हारै प्रभू ईशूए झींण लोल़ी सदा तम्हां सोभी लै हुई। एवमस्तू।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>