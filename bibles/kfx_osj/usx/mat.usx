  <para style="h">मोत्ती</para>
  <para style="toc1">मोत्ती लिखअ द खुशीओ समाद</para>
  <para style="toc2">मोत्ती</para>
  <para style="toc3">मोत्त.</para>
  <para style="mt1">मोत्ती</para>
  <para style="mt2">मोत्ती लिखअ द खुशीओ समाद</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: मोत्ती</para>
  <para style="ili">पहल़णैं आल़ै: यहूदी</para>
  <para style="ili">सन: 50</para>
  <para style="ip">मोत्ती लिखअ द खुशीओ समाद खोज़ा हाम्हां ऐहा गल्‍ला कि ईशू ई आसा सह उद्धार करनै आल़अ ज़सरै बारै परमेशरै पैहलै ई त बोली हेरअ द। परमेशरै पराणैं बधाना दी हज़ारो साला पैहलै आपणैं लोगा संघै ज़ुंण करार किई ती सह किई तेऊ ई उद्धार करनै आल़ै करै पूरी। अह खुशीओ समाद निं सिधअ तिन्‍नां यहूदी मणछा लै आथी, ज़हा मांझ़ै ईशू धाची-पाल़ी होछ़ै का बडअ हुअ, पर अह आसा सारै संसारा लै।</para>
  <para style="ip">मोत्ती आसा एऊ खुशीए समादे बारै धैन डाही लिखअ द। अह हआ ईशूए ज़ल्म हणें पूरी गल्‍ला खोज़णैं का शुरू, तेखअ आसा तेऊए डुबकी अर परिक्षा हणें बारै खोज़अ द। तेखअ आसा गलील मुल्खै प्रच़ार करनअ, शिक्षा दैणीं अर रोगी नरोगै करने च़ाकरी करने बारै खोज़अ द। तेखअ आसा एऊ खुशीए समादा दी ईशूए गलील मुल्खा का एरुशलेम तैणीं हांढ अर ईशूए ज़िन्दगीए खिरीए धैल़ै हुई-बिति दी इना गल्‍ले बारै लिखअ द, ज़ेते महान झींण तेऊए क्रूसा दी छ़ड़ाऊंणअ अर मरी करै ज़िऊंदै हणअ।</para>
  <para style="ip">एऊ खुशीए समादा दी आसा ईशू महान गूरूए रुपै रहैऊअ द। तेऊ आसा परमेशरे बधाने बारै खोज़णेंओ हक अर सह दैआ परमेशरे राज़े बारै शिक्षा। तेऊए शिक्षा आसा पांज़ा बाखा बांडी दी:</para>
  <para style="ili">1. धारा प्रैंदै शिक्षा आसा, ज़ुंण स्वर्ग राज़ा दी रहणैं आल़ै लोगे च़ाल-च़लण, फर्ज़, खास हक, अर खिरी ज़ुंण आशा आसा (5-7)</para>
  <para style="ili">2. बारा च़ेल्‍लै च़ाकरी लै सखाऊंणै (10)</para>
  <para style="ili">3. स्वर्ग राज़े बारै कथ्या (13)</para>
  <para style="ili">4. च़ेल्‍लै हणें बारै शिक्षा (18) अर</para>
  <para style="ili">5. स्वर्ग राज़ा एछणैं अर एऊ जुगे बनाश हणें बारै शिक्षा। (24-25)</para>
  <para style="ip">मोत्ती करा आपणीं गल्‍ला ईशूए इना गल्‍ला खोज़ी खतम ज़ुंण ईशू आपणैं च़ेल्‍लै का खोज़अ कि तिन्‍नां तेऊए डेऊणैं बाद किज़ै लागणअ करनअ:</para>
  <para style="imq">“स्वर्ग अर पृथूईओ सारअ हक दैनअ मुल्है। एता लै डेओआ तम्हैं संसारे सोभी ज़ातीए लोगा सेटा लै अर तिन्‍नां बणाआं मेरै च़ेल्‍लै। संघा दैआ तिन्‍नां लै बाब परमेशर, परमेशर शोहरू अर परमेशर पबित्र आत्में नाओंऐं डुबकी। तिन्‍नां का सखाऊआ तम्हैं तिन्‍नां सोभी गल्‍ला मनणी ज़ुंण मंऐं तम्हां का आसा खोज़ी दी। ऐहा गल्‍ला लै रहै तम्हैं निहंचै, हुंह आसा संसार खतम हणैं तैणीं सदा तम्हां संघै।”</para>
  <para style="ipr">(28:18-20)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">खिंब अर ईशूओ ज़ल्म 1:1—2:23</para>
  <para style="io1">जोहन्‍ना डुबकी दैणैं आल़ेए च़ाकरी 3:1-12</para>
  <para style="io1">ईशूए पाणीं दी डुबकी अर परिक्षा 3:13—4:11</para>
  <para style="io1">गलील मुल्खै ईशूए च़ाकरी 4:12—18:28</para>
  <para style="io1">गलील मुल्खा का एरुशलेम नगरी तैणीं हांढ 19:1—20:34</para>
  <para style="io1">एरुशलेम नगरी खिरीए सात धैल़ै 21:1—27:66</para>
  <para style="io1">ईशूओ मरी करै ज़िऊंदै हणअ अर शुझणअ 28:1-20</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">ईशूओ खिंब</para>
  <para style="r">(<ref loc="LUK 3:23-38">लूका 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />आबरामे आद-लुआद, राज़ै दाबेदे आद-लुआद मसीहा ईशूए खिंबे बही:<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />आबरामो शोहरू त इसहाक। इसहाको हुअ आजू याकब। याकबा का हुअ यहूदा अर तेऊए होर भाई।<verse eid="MAT 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 1:3" />यहूदा अर तामारा का हुऐ आजू फिरिस अर जेराह। फिरिसा का हुअ आजू हिस्रोन। हिस्रोना का हुअ एराम।<verse eid="MAT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 1:4" />एरामो शोहरू त अमीनादाब। अमीनादाब का हुअ आजू नहशोन। तेऊ का हुअ आजू सलमोन।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="RUT 4:19-20">रूत. 4:19-20</ref></char></note><verse eid="MAT 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 1:5" />सलमोन अर तेऊए लाल़ी राहाबा का हुअ आजू बोआज़। बोआज़ अर तेऊए लाल़ी रूता का हुअ ओबेद। रहाब अर रूत नांईं तै यहूदी आथी तिंयां थिऐ होरी ज़ातीए। ओबेदो शोहरू त ईशैई।<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />ईशैईओ शोहरू त दाबेद राज़अ। दाबेद राज़ैओ शोहरू हुअ आजू सुलैमान तैहा बेटल़ी का ज़ुंण पैहलै उरियाह सैनापतिए लाल़ी थिई।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 शमू. 12:24</ref></char></note><verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />सुलैमाना का हुअ रहबाम। तेऊ का हुअ आजू अबियाह। अबियाह का हुअ आजू असाप।<verse eid="MAT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 1:8" />असाप का हुअ आजू जहोशापात अर तेऊओ हुअ आजू जोराम। तेऊओ हुअ आजू उज़ियाह।<verse eid="MAT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 1:9" />उज़ियाह का हुअ जताम। जतामो हुअ आजू आहाज़ अर तेऊओ हुअ आजू हिजकिया।<verse eid="MAT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 1:10" />हिजकिया का हुअ मनिश्शे। मनिश्शे का हुअ आजू अमोन। अमोनो थिअ आजू जोशिया।<verse eid="MAT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 1:11" />बाबेल देशे गलामी दी डेऊणैं का आजी हुअ जोशिये पोचै जकोनया अर तेऊए होर भाई।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="JER 27:20">जेर. 27:20</ref></char></note><verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />बाबेल देशे गलामी दी डेऊई हुअ जकोनया का आजू शालतीएल। शालतीएलो हुअ जरूबाबल।<verse eid="MAT 1:12" /></para>
  <para style="p">
    <verse number="13-14" style="v" sid="MAT 1:13-14" />जरूबाबलो हुअ अबिहूद। अबिहूदो हुअ आजू इल्याकिम। इल्याकिमो हुअ अजोर। तेऊओ त आजू सदोक अर तेऊओ हुअ आजू अखीम।<verse eid="MAT 1:13-14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 1:15" />अखीमा का हुअ आजू इलीहूद अर तेऊओ हुअ आजू एलीआजर। एलीआजरो हुअ आजू मतान। मतान आसा याकबो बाब।<verse eid="MAT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 1:16" />याकबा का हुअ युसुफ, ज़ुंण मरिअमो लाल़अ त। मरिअमा का हुअ पबित्र आत्मां करै ईशू ज़ुंण मसीहा आसा।<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />आबरामा का दाबेद राज़ै तैणीं हुई पठी च़ौदा पोस्ती, दाबेद राज़ै का बाबेल देशे गलाम हणैं तैणीं बी हुई च़ौदा पोस्ती अर तिधा का मसीहा तैणीं बी हुई च़ौदा पोस्ती।<verse eid="MAT 1:17" /></para>
  <para style="s">ईशूओ ज़ल्म</para>
  <para style="r">(<ref loc="LUK 1:26-38">लूका 1:26-38</ref>; <ref loc="LUK 2:1-7">2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />ज़धू ईशू मसीहो ज़ल्म हुअ, सह हुअ इहअ कि ज़धू तेऊए ईज मरिअम कुंआरी आसा ती, तेसे बरनीं लाई युसुफा संघै। तिन्‍नें बैहा हणैं का आजी हुई मरिअम पबित्र आत्मां करै सुंदी।<verse eid="MAT 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 1:19" />मरिअमो लाल़अ युसुफ त धर्मीं मणछ। सह निं मरिअमा बदनाम करनअ च़ाहंदअ त। युसुफै सोठअ इहअ कि तेऊ दैणीं मरिअम च़ुपच़ाप छ़ाडी।<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />ज़ांऊं युसुफ इना गल्‍ला सोठदअ थिअ लागअ द, परमेशरो एक स्वर्ग दूत शुझुअ तेऊ का सुपनै अर तेऊ स्वर्ग दूतै बोलअ युसुफा लै इहअ, “राज़ै दाबेदे लुआद युसुफा, तूह निं मरिअमा संघै बैहा करनै का निं डरी। किल्हैकि तेसे ओदरै पल़दअ गर्भ आसा पबित्र आत्मां करै। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />तेसो हणअ एक शोहरू, तेऊ शोहरू नाअं डाहै तूह ‘ईशू,’ तेऊ करनअ आपणैं लोगा लै तिन्‍नें पापा का छ़ुटकारअ।”<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ईशा. 7:14</ref></char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />अह हुअ तैही कि ज़ुंण बैण प्रभू आपणैं गूर ईशायाह बाती बोलै तै, तिंयां पूरै होए,<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />“हेरा, एक कुंआरी शोहरी का हणअ एक शोहरू,</para>
  <para style="q" vid="MAT 1:23">तेऊ शोहरू नाअं डाहणअ तैहा ‘इमानुएल’</para>
  <para style="q" vid="MAT 1:23">तेतो मतलब आसा इहअ कि परमेशर आसा हाम्हां संघै।”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />युसुफ उझ़ुअ निंजा का खल़अ अर ज़िहअ प्रभूए स्वर्ग दूतै तेऊ लै सुपनै बोलअ त, तिन्‍नां गल्‍ला मनी किअ तेऊ मरिअमा संघै बैह। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />ज़ेभै तैणीं तेसो शोहरू नांईं हुअ, तेभै तैणीं निं सह मरिअमा संघै कठा सुत्तअ आथी। तेऊ डाहअ तेऊ शोहरूओ नाअं “ईशू।” <note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">लूक. 2:21</ref></char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">जोतषी मणछो एछणअ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />ज़धू यहूदा मुल्खै बेतलेम नगरी ईशूओ ज़ल्म हुअ, तिन्‍नां धैल़ै त तेऊ मुल्खै हेरोदेस राज़ैओ राज़।</para>
  <para style="p" vid="MAT 2:1">पुर्बा देशा बाखा का आऐ एरुशलेम नगरी लै जोतषी अर यहूदा मुल्खै पुजी लागै तिंयां इहअ पुछ़दै, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“एऊ देशै हुअ यहूदीए राज़ैओ ज़ल्म, सह किधी ज़िहअ हुअ? हाम्हैं भाल़अ पुर्बा बाखा तेऊओ तारअ अर हाम्हैं आसा तेऊ सेटा माथै टेक्‍कदै आऐ दै।”<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="NUM 24:17">गण. 24:17</ref></char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />तिन्‍नां जोतषीए इना गल्‍ला शूणीं डरै हेरोदेस राज़अ अर सारै एरुशलेम नगरीए लोग। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />हेरोदेस राज़ै बी किऐ तेभी सारै बडै प्रोहत अर शास्त्री कठा संघा पुछ़अ तिन्‍नां का, “थारै शास्त्रे साबै मसीहो ज़ल्म किधी सका हई?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />तिन्‍नैं बोलअ सोभी राज़ै लै, “पबित्र शास्त्रा दी आसा परमेशरे गूर मिका इहअ बोलअ द, ‘मसीहो ज़ल्म हणअ एऊ यहूदा मुल्खै बेतलेम नगरी।’ एथ आसा इहअ लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मिक. 5:2</ref></char></note><verse eid="MAT 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 2:6" />‘हे बेतलेम, ज़ुंण तूह यहूदा मुल्खै आसा,</para>
  <para style="q" vid="MAT 2:6">तूह आसा सोभी का बडी! किल्हैकि</para>
  <para style="q" vid="MAT 2:6">ताखा हणअ आजू एक मणछ राज़अ</para>
  <para style="q" vid="MAT 2:6">तेऊ करनी मेरी परज़ा इज़राईलीए हेर-सभाल़।’”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तेखअ शादै हेरोदेस राज़ै तिंयां जोतषी च़ुप्प-च़ुप्पै आप्पू सेटा लै संघा बोलअ तिन्‍नां लै इहअ, “तम्हां तारअ ठीक-ठीक कहा घल़ी शुझुअ त?”<verse eid="MAT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 2:8" />हेरोदेस राज़ै छ़ाडै तिंयां जोतषी इहअ बोली बेतलेम नगरी लै कि तिधी डेऊई तम्हैं ठीक-ठीक थोघ कि तेऊ शोहरूओ ज़ल्म किधी हुअ। तेखअ ज़ांऊं सह भेटे, मुल्है बी दैऐ समाद। तै डेऊणअ मुंह बी तेऊ सेटा लै माथै टेक्‍कदै।<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />तिन्‍नैं जोतषी बी राज़ैए ईंयां गल्‍ला शूणीं संघा लागै तिंयां तेऊ सेटा का बेतलेम नगरी लै हांढदै। ज़ुंण तारअ तिन्‍नैं पुर्बा दिशा दी भाल़अ त, सह शुझुअ तिन्‍नां का भिई। तेऊ तारै भाल़ी हुऐ तिंयां खास्सै खुशी।<verse eid="MAT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 2:10" />सह लागअ सरगै तिन्‍नां का आजू-आजू हांढदअ अर तिंयां लागै तेऊ पिछ़ू-पिछ़ू हांढदै अर सह तारअ खल़्हुअ ठीक तैहा ज़ैगा प्रैंदै ज़िधी तेऊ शोहरूओ ज़ल्म त हुअ द।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 2:20">लूक. 2:20</ref></char></note> <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />तिंयां डेऊऐ तैहा ज़ैगा ज़िधी ईशूओ ज़ल्म त हुअ द। तिन्‍नैं भाल़अ सह शोहरू तेऊए ईजा मरिअमे भोसल़ै अर तिन्‍नैं टेक्‍कअ उटै पल़ी माथअ संघा लागै सोभ तेऊए च़ाकरी करदै।</para>
  <para style="p" vid="MAT 2:11">तेखअ खोल्ही तिन्‍नैं आपणीं-आपणीं बोझ़ल़ी अर तेता का दैनी सुन्‍नअ, लोवान, खुशबूदार किम्मती तेल अर कई च़िज़ा भैंट।<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />तेखअ दैनी तिन्‍नां लै परमेशरै सुपनै चतैनगी, “हेरोदेस राज़ै सेटा लै निं बापस डेऊई।” तिंयां बी तिधा का उझ़ुऐ अर तिंयां डेऊऐ होरी बाता आपणैं देशा लै।<verse eid="MAT 2:12" /></para>
  <para style="s">मिसर देशा लै डेऊणअ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />जोतषी डेऊणैं बाद आअ प्रभूओ एक स्वर्ग दूत युसुफे सुपनै। तेऊ स्वर्ग दूतै बोलअ युसुफा लै इहअ, “हे युसुफ, खल़अ उझ़ू, एऊ शोहरू अर एऊए ईजा संघा निंईं करै डेओआ इधा का मिसर देशा लै अर ज़ेभै तैणीं ताल्है हुंह आप्पै निं बोलूं, तेभै तैणीं रहै तिधी, किल्हैकि हेरोदेस राज़अ आसा लागअ द एऊ शोहरू लोल़अ अर तेऊ आसा लाअ द अह मारी पाई।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />इना गल्‍ला शूणीं उझ़ुअ युसुफ, संघा डेऊअ राची भितरी आपणीं लाल़ी मरिअम अर तेऊ शोहरू संघा निंईं तिधा का मिसर देशा लै। <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ज़ांऊं तैणीं हेरोदेस राज़अ मूंअ निं आथी तेभै तैणीं रहै तिंयां तिधी मिसर देशै। अह हुअ तै कि शास्त्रा दी होशे गूरा का बिधाता बोलअ द बैण पूरअ होए, “मंऐं शादअ मेरअ पूत कि मिसर देशा का निखल़े।”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होश. 11:1</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />ज़ांऊं हेरोदेस राज़ै भाल़अ कि जोतषी दैनअ तेऊ लै धोखअ। तेऊ आई बेघै खास्सी रोश्शै अर आपणीं सैना छ़ाडी तेऊ जोतषी खोज़ी दी ठीक-ठीक तैहा घल़ी हुऐ दै बेतलेम नगरी अर तेता ओरी-पोरी गराऊंऐं हुऐ दै शोहरू ज़ुंण दूई साले अर तेता का होछ़ै थिऐ, तिंयां पाऐ तेऊ सोभ मारी। <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />तेखअ ज़ुंण बैण परमेशरे गूर जेरमयाह बोलअ त, सह हुअ पूरअ,<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JER 31:15">जेर. 31:15</ref></char></note><verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“रामाह नगरी शुण्हिंआं मखाण पल़अ द,</para>
  <para style="q" vid="MAT 2:18">तेथ आसा ज़ोरै-ज़ोरै लेरा लांदै लागै दै।</para>
  <para style="q" vid="MAT 2:18">राहेल आसा आपणैं लान्हैं लै लेरा लांदी लागी दी,</para>
  <para style="q" vid="MAT 2:18">सह निस्सी केही च़ुफूई! किल्हैकि</para>
  <para style="q" vid="MAT 2:18">तिंयां निं ऐबै रहै आथी।”<verse eid="MAT 2:18" /></para>
  <para style="s">युसुफ फिरअ मिसर देशा का बापस</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोदेस राज़ै मरी करै आअ प्रभूओ स्वर्ग दूत भिई मिसर देशै युसुफे सुपनै। तेऊ स्वर्ग दूतै बोलअ तेऊ लै, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“हे युसुफ, खल़अ उझ़ू अर एऊ शोहरू अर एऊए ईजा निंऊं इज़राईल देशा लै बापस। ज़ुंण एऊ शोहरू मारनअ च़ाहा त सह गअ ऐबै मरी।”<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="EXO 4:9">लुआ. 4:9</ref></char></note><verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />सह बी उझ़ुअ तिधा का, संघा आअ इज़राईल देशा लै बापस, शोहरू अर मरिअम बी आणै आप्पू संघा।<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />पर ज़ांऊं तेऊ इहअ शूणअ कि हेरोदेस राज़ै बाद आसा यहूदा मुल्खै तेऊओ शोहरू अरखलाऊस राज़अ। युसुफ डरअ तिधा डेऊणैं का।</para>
  <para style="p" vid="MAT 2:22">तेखअ दैनी परमेशरै युसुफा लै सुपनै चतैनगी। संघा डेऊअ युसुफ तिधा का गलील मुल्खा लै। <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />तिधी पुजी लागअ सह नासरत नाओंऐं एकी नगरी रहंदअ। इहअ हुअ तै कि शास्त्रा दी परमेशरे गूरै बोलअ द बैण पूरअ होए “तेऊ नाअं पल़णअ नासरी।”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="LUK 18:7">लूक. 18:7</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">जोहन्‍ना डुबकी दैणैं आल़अ</para>
  <para style="r">(<ref loc="MRK 1:1-8">मार्कुस 1:1-8</ref>; <ref loc="LUK 3:1-18">लूका 3:1-18</ref>; <ref loc="JHN 1:6-8">जोहन्‍ना 1:6-8</ref>,<ref loc="JHN 1:15-34">15-34</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ज़ेभै तैणीं ईशू नासरत नगरी थिअ, तिन्‍नां धैल़ै त जोहन्‍ना डुबकी दैणैं आल़अ यहूदा मुल्खै रेगीस्तानै लोगा परमेशरो इहअ समाद खोज़दअ लागअ द, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“पापो प्राश्त करा, संघा फिरा परमेशरा बाखा, स्वर्गो राज़ गअ नेल़ एछी।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />अह थिअ सह ई, ज़सरै बारै परमेशरे गूर ईशायाह इहअ थिअ बोलअ द,</para>
  <para style="q" vid="MAT 3:3">“शुन्‍नैं रेगीस्ताना का आसा कुंण हाक्‍का लांदअ अर इहअ बोल्दअ लागअ द,</para>
  <para style="q" vid="MAT 3:3">‘प्रभू एछणें धैल़ी लै डाहा बाता शुंहीं-शोधी,</para>
  <para style="q" vid="MAT 3:3">तेऊए सुआगत करना लै रहा सोभ तैर्हुई।’”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />अह जोहन्‍ना बान्हां त घेरी ऊँटे शेलीए झिकल़ै अर आपणीं कुछी दी च़ाम्भल़ेओ गाचू, अर खाणां लै खाआ त रैट्टै अर मखीर।<verse eid="MAT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 3:5" />तेखअ आऐ एरुशलेम नगरी, यहूदा मुल्खै कई ज़ैगा अर जरदण नदी ओरी-पोरी रहणैं आल़ै कई ज़ैगा का लोग जोहन्‍ना सेटा लै। <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />तिन्‍नैं लई आपणैं-आपणैं पाप मनी जरदण नदी दी तेऊ का डुबकी।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />जोहन्‍ना भाल़ै कि कई फरीसी अर सदुकी पंथे लोग आऐ तेऊ सेटा लै डुबकी लंदै एछदै, तेऊ बोलअ तिन्‍नां लै इहअ,</para>
  <para style="p" vid="MAT 3:7">“तम्हैं मणछ आसा झ़रीली दानुईंए बच़ै ज़िहै! तम्हां का कोही निं खोज़अ कि ज़ुंण पाप तम्हैं किऐ परमेशरा दैणीं तम्हां सोभी लै तेते सज़ा? इहअ निं सोठा कि तम्हैं जाणैं तेऊ का बच़ी! <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />इहै काम ता करा ज़ेता करै थोघ लागे कि तम्हैं हेरअ प्राश्त करी पाप करनअ छ़ाडी।<verse eid="MAT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 3:9" />“आपणैं-आपणैं मन्‍नैं निं इहअ सोठा कि हाम्हैं आसा आबरामे खिंबा का, तै निं हाम्हां लै परमेशरा सज़ा दैणीं। हुंह बोला तम्हां का इहअ कि परमेशर सका इना पात्थरा का बी आबरामा लै लुआद पैईदा करी। <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />परमेशर आसा तम्हां लै सज़ा दैणें ताका बेठअ द ज़िहअ मणछ राम्बल़ै फल़ नांईं दैणैं आल़ै बूटा खराल़ै करै गोधी का काटा। तिहै ई पाणै तेऊ बी तिंयां सारै बूट गोधी का पेच़ी करै आगी जैंदरी।<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“हुंह ता दैआ तम्हां लै पाणीं करै पापो प्राश्त करने डुबकी, पर ज़ुंण मुंह बाद एछणैं आल़अ आसा, सह आसा सोभी का महान अर इधी तैणीं कि हुंह निं तेऊ सेटा एता जोगी बी आथी कि हुंह तेऊए पोलल़ै खोल्हणैं ज़ेही च़ाकरी करनै आल़अ दास बणी सकूं, तेऊ दैणीं तम्हां लै पबित्र आत्मां अर आगी दी डुबकी।<verse eid="MAT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 3:12" />“तेऊओ शूप आसा तेऊए हाथै, तेऊ करनी आपणैं खहल़े राम्बल़ै करै सफाई। धर्मीं मणछ करनै तेऊ इहै ज़ुदै ज़िहअ कृषाण कणक खुडी झाल़ा अर कदुष्ट मणछ पाणै तेऊ भुखलै ज़िहै एही आगी जैंदरी दहई, ज़ुंण आग कधि निं हिठदी आथी।”<verse eid="MAT 3:12" /></para>
  <para style="s">जोहन्‍ने हाथै ईशूए पाणीं दी डुबकी</para>
  <para style="r">(<ref loc="MRK 1:9-11">मार्कुस 1:9-11</ref>; <ref loc="LUK 3:21">लूका 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="JHN 1:31-34">जोहन्‍ना 1:31-34</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />संघा आअ ईशू बी गलील मुल्खा का जोहन्‍ना सेटा लै जरदण नदीए बाढै डुबकी लंदअ। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पर जोहन्‍ना लाग अह इहअ करै तेऊ रोक्‍कदअ “हे प्रभू, तूह किल्है आअ मुंह सेटा डुबकी लंदअ? मुंह लागा हथू तेरै हाथै पै डुबकी लणी।”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />ईशू दैनअ तेऊ लै ज़बाब, <char style="wj">“तूह दै मुल्है डुबकी, हाम्हां दुही लागा परमेशरे मरज़ी दी सोभै गल्‍ला एऊ ई साबै पूरी करनी।”</char> तेखअ हुअ जोहन्‍ना डुबकी दैणा लै तैर।<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />ज़ांऊं ईशू पाणीं दी डुबकी दैई पाणीं का उझै निखल़अ, हेरा-हेरी शुझुअ जोहन्‍ना का इहअ कि तेऊ लै खुल्हअ सरग अर परमेशरे पबित्र आत्मां भाल़ी एछदी पालल़ी ज़ेही तेऊ प्रैंदै। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />परमेशरै बोलअ स्वर्गा का इहअ, “अह आसा मेरअ पूत। हुंह झ़ूरा एऊ लै सोभी का खास्सअ, एऊ का आसा हुंह खास्सअ खुशी।”<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">मूल. 22:2</ref>; <ref loc="PSA 2:7">भज. 2:7</ref>; <ref loc="ISA 42:1">ईशा. 42:1</ref>; <ref loc="MAT 12:18">मोत्त. 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">मार्क. 1:11</ref>; <ref loc="LUK 9:15">लूक. 9:15</ref></char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">ईशूए परिक्षा</para>
  <para style="r">(<ref loc="MRK 1:12">मार्कुस 1:12</ref>; <ref loc="LUK 4:1-13">लूका 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />पबित्र आत्मां निंयं तेभी ईशू शुन्‍नैं रेगीस्ताना लै अर तिधी रहअ राख्स तेऊ परखदअ लागी। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />ईशू रहअ च़ाल़्ही धैल़ै अर च़ाल़्ही राची ब्रतू, अर च़ाल़्ही धैल़ै बाद आई तेऊ भुखै।<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">लुआ. 34:28</ref></char></note><verse eid="MAT 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 4:3" />तेखअ बोलअ राख्सै ईशू लै, “ज़ै तूह परमेशरो पूत आसा, तै बोल तूह इना पात्थरा लै इहअ कि रोटी बण?”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />ईशू दैनअ तेऊ लै ज़बाब, <char style="wj">“पबित्र शास्त्रा दी आसा लिखअ द इहअ,</char></para>
  <para style="q" vid="MAT 4:4">
    <char style="wj">‘मणछ निं सिधअ रोटी करै ज़िऊंदअ, </char></para>
  <para style="q" vid="MAT 4:4">
    <char style="wj">पर परमेशरे बोली दी हरेक गल्‍ला मनी सका सह ज़िऊंदअ रही।’”</char><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />तेखअ निंयं राख्सै ईशू पबित्र एरुशलेम नगरी, संघा किअ परमेशरे भबने च़ुंडी खल़अ, तेखअ बोलअ इहअ,<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 34:28">लुआ. 34:28</ref></char></note> <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />“ज़ै तूह परमेशरो पूत आसा, तै दै इधा का उंधै छ़ाहल़! किल्हैकि पबित्र शास्त्रा दी आसा इहअ बी लिखअ द,<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भज. 91:11-12</ref></char></note></para>
  <para style="q" vid="MAT 4:6">‘परमेशरा डाहणैं तेरी फाज़त करदै हर ज़ैगा स्वर्ग दूत लाई,</para>
  <para style="q" vid="MAT 4:6">तूह ज़िधी बी डेऊए, तिंयां रहणैं ताह संघा।</para>
  <para style="q" vid="MAT 4:6">तूह नढैऊणअ तिन्‍नां स्वर्ग दूता हाथा ढाकी,</para>
  <para style="q" vid="MAT 4:6">ताकि तेरै च़रणैं ठोहल़ नां लागे।’”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ईशू बोलअ तेऊ लै, <char style="wj">“पबित्र शास्त्रा दी आसा इहअ बी लिखअ द, ‘तम्हैं निं आपणैं परमेशर परखदै लागी<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">बधा. 6:16</char></note>।’” </char><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 4:9">लूक. 4:9</ref>
      </char>
    </note>तेखअ निंयं राख्सै सह एकी उछ़टी धारा संघा बोलअ तेऊ ईशू का सारै संसारो राज़ अर सुख रहैऊई, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“ज़ै तूह मुंह सेटा माथअ टेक्‍के तै हणीं ईंयां सोभै गल्‍ला तेरी।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />तेखअ बोलअ ईशू राख्सा लै, <char style="wj">“<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">बधा. 6:13</char></note>ओ राख्सा मेरी आछी का हअ दूर, पबित्र शास्त्रा दी आसा लिखअ द, </char></para>
  <para style="q" vid="MAT 4:10">
    <char style="wj">‘तूह टेक्‍कै सिधअ आपणैं प्रभू परमेशरा सेटा माथअ</char></para>
  <para style="q" vid="MAT 4:10">
    <char style="wj">सिधी तेऊए ई च़ाकरी करै।’”</char><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />तेखअ डेऊअ राख्स ईशू सेटा का दूर अर स्वर्ग दूत लागै ईशूए च़ाकरी करदै।<verse eid="MAT 4:11" /></para>
  <para style="s">ईशूए च़ाकरीए शुरूआत</para>
  <para style="r">(<ref loc="MRK 1:14">मार्कुस 1:14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">लूका 4:14</ref>,<ref loc="LUK 4:15">15</ref>,<ref loc="LUK 4:31">31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />ज़ांऊं ईशू शूणअ कि जोहन्‍ना डुबकी दैणैं आल़अ किअ कैद, सह डेऊअ यहूदा मुल्खा का गलील मुल्खा लै फिरी।<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मोत्त. 14:3</ref>; <ref loc="MRK 6:17">मार्क. 6:17</ref>; <ref loc="LUK 3:19">लूक. 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />तेखअ लागअ ईशू नासरत गराऊंआं छ़ाडी कफरनहूम नगरी समुंदरे बाढै ज़बलून अर नप्तालीए मुल्खै रहंदअ। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />ताकि पबित्र शास्त्रा दी परमेशरे गूर ईशायाह बोली दी गल्‍ला पूरी होए,<verse eid="MAT 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 4:15" />“ज़बलून अर नप्तालीए मुल्खै,</para>
  <para style="q" vid="MAT 4:15">समुंदरे बाढै, जरदण नदी नेल़,</para>
  <para style="q" vid="MAT 4:15">गलील मुल्खै, होरी ज़ातीए लोग,<verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />ज़ुंण न्हैरै दी तै बेठै दै,</para>
  <para style="q" vid="MAT 4:16">तिन्‍नां का शुझुअ खास्सअ प्रैश्शअ,</para>
  <para style="q" vid="MAT 4:16">ज़ुंण लोग तेऊ देशै मौते छ़ैल्‍ली दी तै बेठै दै,</para>
  <para style="q" vid="MAT 4:16">तिन्‍नां लै हुअ ऐबै प्रैश्शअ।”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />तधा पोर्ही किई ईशू लोगा का एही गल्‍ला खोज़णीं शुरू, <char style="wj">“आपणैं पापो प्राश्त करा, अर परमेशरा सेटा एछा फिरी, स्वर्गो राज़ गअ नेल़ एछी।”</char><verse eid="MAT 4:17" /></para>
  <para style="s">पैहलै च़ेल्‍लै शादणैं</para>
  <para style="r">(<ref loc="MRK 1:16-20">मार्कुस 1:16-20</ref>; <ref loc="LUK 5:1-11">लूका 5:1-11</ref>; <ref loc="JHN 5:42">जोहन्‍ना 5:42</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />एकी धैल़ी त ईशू गलील समुंदरे बाढै हांढदअ लागअ द, तेऊ भाल़ै दूई मणछ शमौन ज़हा लै पतरास बोला अर तेऊओ भाऊ आन्दरू। तिंयां थिऐ लागै दै पाणीं दी म्हाछ़ली ढाकणा लै ज़ज़ाल़ा पांदै किल्हैकि तिंयां करा तै म्हाछ़ली ढाकणैं अर बेच़णेंओ काम। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“ज़ेही तम्हैं म्हाछ़ली कठा करदै आसा लागै दै, मुंह संघै च़ाल्‍ला हुंह सखाऊं तम्हां मेरै च़ेल्‍लै हणां लै मणछ कठा करनै।”</char> <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />तिंयां बी लागै तेभी ज़ज़ाल़ा छ़ाडी तेऊ संघै हांढदै।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />तिधा का आजू डेऊई भाल़ै ईशू दूई होर भाई, याकब अर तेऊओ भाऊ जोहन्‍ना, तिंयां थिऐ लागै दै आपणैं बाब जबदी संघै किश्ती प्रैंदै बेशी ज़ज़ाल़ा सोहरदै, अर तेऊ शादै तिंयां बी, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />तिंयां बी लागै तेभी किश्ती अर आपणैं बाब छ़ाडी तेऊ संघै हांढदै।<verse eid="MAT 4:22" /></para>
  <para style="s">ईशूए बमार ठीक करनै</para>
  <para style="r">(<ref loc="LUK 6:17-19">लूका 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />तेखअ डेऊअ ईशू गलील मुल्खै कई ज़ैगा। सह रहअ यहूदीए सभागृहा<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="fq" closed="false">सभागृहा </char><char style="ft" closed="false">यहूदी ज़िधी कठा हआ, सभा करा</char></note> शिक्षा दैंदअ अर स्वर्ग राज़े खुशीए समादा खोज़दअ लागी अर सोभी रंगे दाह-खिज़ा का तिन्‍नां नरोगै करदअ लागी।<verse eid="MAT 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24" />ईशूए बारै ईंयां गल्‍ला पुजी सारै सिरीया मुल्खै। तेखअ ज़ुंण लोग कई बमारी, दुख, भूत शाचै दै, मिर्गिए रोगी थिऐ, तिंयां आऐ ईशू सेटा लै अर ईशू किऐ तिंयां सोभ नरोगै। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />खास्सै मणछ आऐ गलील, दिकापुलिस, एरुशलेम नगरी, यहूदा मुल्खै, अर जरदण नदी पारा बाखा का ईशू पिछ़ू।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">ईशूए धारा प्रैंदै शिक्षा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ईशू भाल़अ कि खास्सै मणछ आऐ, सह डेऊअ उझै धारठी प्रैंदा लै। संघा बेठअ तिधी अर च़ेल्‍लै बी बेठै तेऊ फेर शूणैं। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />तेखअ लागअ सह तिन्‍नां सोभी लै इहअ बोली शिक्षा दैंदअ,<verse eid="MAT 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />
    <char style="wj">“परमेशर दैआ तिन्‍नां लै बर्गत, ज़ुंण परमेशरे आसरै रहा, </char></para>
  <para style="q" vid="MAT 5:3">
    <char style="wj">स्वर्गो राज़ आसा तिन्‍नां लै।</char><verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़हा एभै शोग आसा पल़अ द, </char></para>
  <para style="q" vid="MAT 5:4">
    <char style="wj">तिन्‍नां लै भेटणीं शांती।</char><verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़ुंण शरेरै निं फिरदै, </char></para>
  <para style="q" vid="MAT 5:5">
    <char style="wj">तिंयां हणैं ऐहा पृथूईए मालक।</char><verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़ुंण </char></para>
  <para style="q" vid="MAT 5:6">
    <char style="wj">धर्म करने भुख हआ, तिंयां रज़ैऊंणै।</char><verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़ुंण झींण करा, </char></para>
  <para style="q" vid="MAT 5:7">
    <char style="wj">तिन्‍नां लै हणअ परमेशर झणैल़ू।</char><verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़सरै मन्‍नैं खोट निं आथी, </char></para>
  <para style="q" vid="MAT 5:8">
    <char style="wj">तिन्‍नां भेटणअ परमेशर।</char><verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़ुंण मेल़-ज़ोल़ करा, </char></para>
  <para style="q" vid="MAT 5:9">
    <char style="wj">तिंयां हणैं परमेशरे लुआद।</char><verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />
    <char style="wj">परमेशर दैआ तिन्‍नां लै बर्गत ज़हा लै धर्म करी लोग दुख दैआ, </char></para>
  <para style="q" vid="MAT 5:10">
    <char style="wj">स्वर्गो राज़ आसा तिन्‍नां लै।</char><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <char style="wj">“परमेशरा दैणीं तम्हां लै बर्गत ज़ेभै तम्हां लै लोग मुंह पिछ़ू झ़ुठअ बोली थारै खलाफ हर रंगो बूरअ बर्ताअ करे।</char> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><char style="wj">तेभै हऐ तम्हैं खास्सै खुशी। तम्हां लै आसा स्वर्गै बडअ फल़। किल्हैकि ज़ुंण तम्हां का पैहलै भलै मणछ, परमेशरे गूर थिऐ, तिन्‍नैं किअ त तिन्‍नां लै बी इहअ ई ज़ुल्म।</char><verse eid="MAT 5:12" /></para>
  <para style="s">लूंण अर लाटू</para>
  <para style="r">(<ref loc="MRK 9:50">मार्कुस 9:50</ref>; <ref loc="LUK 14:34">लूका 14:34</ref>,<ref loc="LUK 14:35">35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <char style="wj">“ज़िहअ रोटी लै लूंण पाआ तिहै हणैं तम्हैं बी संसारा लै। पर ज़ै लूंणो सुआद लूंणअ नांईं होए, तै सह किज़ू करै करनअ लूंणअ? तेखअ निं तेता ढेक्‍का शोटणै का सुआई किछ़ै काम रहंदअ।</char><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <char style="wj">“तम्हैं आसा संसारा लै प्रैश्शअ, ज़ुंण गराअं धारा प्रैंदै हआ बस्सअ द, सह शुझिआ सोभी का।</char> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><char style="wj">इहअ निं कोह आथी ज़ुंण दीअ ज़ाल़ी दरोठू भितरी डाहा पाई तेता डाहा दीअदानी दी उछ़टै ताकि सारै घअरै प्रैश्शअ होए।</char> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><char style="wj">ठीक इहअ लोल़ी ई थारअ प्रैश्शअ बी होरी लोगा नदरी च़मकअ। ताकि तिंयां थारै भलै कामां भाल़ी परमेशरे बड़ैई करे ज़ुंण थारअ बाब स्वर्गै आसा।</char><verse eid="MAT 5:16" /></para>
  <para style="s">शास्त्रे शिक्षा</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />
    <char style="wj">“इहअ निं समझ़ा कि हुंह आसा परमेशरे गूरे बधाना अर शास्त्रा खतम करदअ आअ द, पर हुंह आसा तिन्‍नां पूरै करदअ आअ द।<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">रोम. 10:4</char></note></char> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि ज़ेभै तैणीं अह सरग अर पृथूई खतम नां होए, तेभै तैणीं निं बधाना दी लिखी दी एक मात्रा अर एक बिंदू बी पूरअ हणैं बाझ़ी टल़णअ।</char><verse eid="MAT 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 5:19" />
    <char style="wj">“तैही बोला हुंह कि ज़ुंण बी इना होछ़ै का होछ़ै हुकमा मनणा लै एकी दी बी गलती करे अर तिहअ ई होरी का बी सखाओए सह हणअ स्वर्ग राज़ा दी सोभी का होछ़अ। पर ज़ुंण बी तिन्‍नां हुकमा मने अर तिन्‍नां होरी का बी सखाओए, सह हणअ स्वर्ग राज़ा दी सोभी का महान।</char><verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />
    <char style="wj">“पर हुंह खोज़ा तम्हां का सत्त, ज़ै तम्हैं परमेशरे हर गल्‍ला मनणा लै इना यहूदी शास्त्री अर फरीसी पंथे लोगा का खास्सै धर्मीं होए तै सका तम्हैं स्वर्ग राज़ा दी डेऊई।</char><verse eid="MAT 5:20" /></para>
  <para style="s">रोश्श अर हत्या</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />
    <char style="wj">“तम्हैं आसा ईंयां गल्‍ला शूणीं दी कि बधाना दी आसा इहअ लिखअ द, ‘हत्या निं करनी अर ज़ुंण हत्या करे, तेऊ भेटणीं दालता दी सज़ा।’”<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">लुआ. 20:13</char></note></char><verse eid="MAT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 5:22" />
    <char style="wj">“पर हुंह खोज़ा तम्हां का सत्त, ज़ुंण बी आपणैं भाई लै रोश्श करे, सह आसा हत्या करनै आल़अ अर तेऊ भेटणीं दालता दी सज़ा। ज़ुंण आपणैं भाई लै निक्‍कअ बोले, तेऊ भेटणीं माहा सभा सज़ा। ज़ुंण इहअ बोले, ‘आरा ऐडै मणछा,’ तेऊ भेटणीं जम्परीए आगी जैंदरी सज़ा। </char><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />
    <char style="wj">“तैही बोला हुंह ज़ै तूह परमेशरा लै आपणीं भैंट बेदी दी आणे, अर तिधी फिरे ताह आद कि मेरै भाई-बैहण मन्‍नैं आसा मुल्है बरोध! तै छ़ाड तूह आपणीं भैंट तिधी बेदी आजू।</char> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" /><char style="wj">आपणैं भाई-बैहणी संघै कर पैहलै मेल़-ज़ोल़ अर तेखअ दै आपणीं भैंट बेदी दी।</char><verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />
    <char style="wj">“ज़ेभै तैणीं तूह आपणैं दुशमणा संघा बाता आसा, तेभी कर तेऊ संघै मेल़-ज़ोल़। इहअ निं हआ कि सह निंए ताह पांच़ा सेटा अर पांच़ दैए ताह सपाही का अर सपाही पाए ताह कैद खानै दी।</char> <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="wj">ऐहा गल्‍ला लऐ तूह समझ़ी कि ज़ेभै तैणीं तूह पाई-पाई निं भरी मुक्‍के, तेभै तैणीं निं तूह तिधा का छ़ुटणअ। </char><verse eid="MAT 5:26" /></para>
  <para style="s">कंज़रैई</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />
    <char style="wj">“तम्हैं आसा ईंयां गल्‍ला शूणीं दी कि परमेशरै आसा म्हारै दादा-बाबा लै बोलअ द, ‘कंज़रै निं हणअ।’<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">बधा. 5:18; लुआ. 20:14</char></note></char> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" /><char style="wj">पर हुंह बोला तम्हां लै इहअ, ज़ुंण कहा बेटल़ी लै कंज़री नदर बी दैए, सह गअ मन्‍नैं ई मन्‍नैं तैहा संघै कंझ़रूई।</char><verse eid="MAT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 5:29" />
    <char style="wj">“ज़ै तूह आपणीं आछी कई गल्‍ला भाल़ी पाप करा, तिन्‍नां पापा दी पाप कराऊंणै आल़ी च़िज़ा भाल़णैं का रह दूर, च़ाऐ ताह सह आछ पोर्ही किल्है निं पल़े काढणीं। किल्हैकि ताल्है आसा अह ई भलअ कि तेरी देही का हणअ एक्‍कै आंग ज़ांऐं, तेता पिछ़ू तेरी सारी देही ता निं जम्परी डेऊणी।</char><verse eid="MAT 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 5:30" />
    <char style="wj">“ज़ै तेरै हाथा करै पाप हआ, तेता करै पाप करने पाऐ छ़ाड। च़ाऐ ताह सह हाथ काटणअ किल्है निं पल़े। ताल्है आसा इहअ ई भलअ कि तेरअ एक्‍कै हाथ हणअ तेरी देही का ज़ांऐं, तेता पिछ़ू तेरी सारी देही ता निं जम्परी डेऊणी।</char><verse eid="MAT 5:30" /></para>
  <para style="s">बैईदाऊअ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <char style="wj">“तम्हैं इहअ बी आसा शूणअ द कि ज़ुंण आपणीं लाल़ी छ़ाडणअ च़ाहा, सह दैऐ तैहा लै बैईदाऊअ लिखी।<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">बधा. 24:1-4</char></note></char> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><char style="wj">पर हुंह बोला तम्हां लै इहअ कि ज़ुंण बी आपणीं बेटल़ी कंज़रै कामां का सुआई थोघै बाझ़ी किज़ू होरी कामां पिछ़ू छ़ाडे, सह कराऊआ तैहा का कंज़रैई, अर ज़ुंण तैहा छ़ाडी दी बेटल़ी संघै बैह करे, सह बी करा कंज़रैई।</char><verse eid="MAT 5:32" /></para>
  <para style="s">सोह निं काढणैं</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />
    <char style="wj">“तम्हैं इहअ बी आसा हेरअ द शूणीं कि थारै दाद-बाब बोला तै तिन्‍नें ज़मानै, ‘झ़ुठै सोह निं काढणैं पर प्रभू लै करनै आपणैं सोह पूरै।’<note caller="+" style="f"><char style="fr" closed="false">5:33 </char><char style="ft" closed="false">बधा. 23:1</char></note></char><verse eid="MAT 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 5:34" />
    <char style="wj">“पर हुंह बोला तम्हां लै इहअ कि सोह निं कधि काढणैं, नांईं ता स्वर्गे, किल्हैकि सह आसा परमेशरे राज़गाद्दी।<note caller="+" style="f"><char style="fr" closed="false">5:34 </char><char style="ft" closed="false">ईशा. 66:1</char></note></char> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><char style="wj">नां पृथूईए, किल्हैकि सह आसा तेऊए च़रणा बशैल़णे च़ौकी। नां एरुशलेम नगरीए, किल्हैकि सह आसा माहा राज़ेए नगरी।</char> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" /><char style="wj">आपणैं मुंडे सोह बी निं काढी। किल्हैकि तूह नां एक शराल़ काल़अ अर नां तूह शेतअ करी सकदअ।</char><verse eid="MAT 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 5:37" />
    <char style="wj">“पर थारी ‘हाँ’ करनैओ मतलब लोल़ी ‘हाँ’ अर थारी ‘नांह’ करनैओ मतलब लोल़ी ‘नांह’ हुअ। किल्हैकि ज़ुंण बी एता का खास्सअ हआ सह हआ राख्सा बाखा।</char><verse eid="MAT 5:37" /></para>
  <para style="s">बदल़अ</para>
  <para style="r">(<ref loc="LUK 6:29">लूका 6:29</ref>,<ref loc="LUK 6:30">30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />
    <char style="wj">“तम्हैं आसा आपणैं दादा-बाबा का इहअ बी शूणअ द कि बधाना दी बोला इहअ, ‘आछिए बदल़ै आछ, अर दांदे बदल़ै दांद।’<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false">बधा. 19:21</char></note></char><verse eid="MAT 5:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 5:39" />
    <char style="wj">“पर हुंह बोला तम्हां लै इहअ, ‘बूरै करने बदल़ै बूरअ निं करी। पर ज़ुंण तेरै दैहणै गलेटै च़ैंडै बाहे, तेऊ बाखा फरेओऐ बाऊंअ गलेटअ बी।’</char> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><char style="wj">ज़ै कुंण तेरअ दाऊअ करी तेरी सज़ा भुगतणे बदल़ै कुर्तै आप्पू लै निंणअ च़ाहे, तेऊ लै दैऐ आपणअ च़ोल़अ बी खोल्ही च़ाऐ तेते ताह खास्सी ज़रुरत किल्है निं होए।</char><verse eid="MAT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 5:41" />
    <char style="wj">“ज़ुंण ताह थोघै बाझ़ी एक मील दूर निंए, तेऊ संघै डेओऐ दूई मील तूह तैणीं बी।</char> <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" /><char style="wj">ज़ुंण ताखा किज़ै मांगे, तेऊ लै दैऐ, अर ज़ुंण ताखा किज़ै ऋण मांगे, तेऊ लै निं आपणीं पिठ फरेऊई।</char><verse eid="MAT 5:42" /></para>
  <para style="s">दुशमणा संघै झ़ूरी</para>
  <para style="r">(<ref loc="LUK 6:27">लूका 6:27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />
    <char style="wj">“तम्हैं आसा इहअ बी शूणअ द कि इहअ बी बोला तै कि आपणैं लोगा संघै डाहै झ़ूरी अर आपणैं दुशमणा संघै डाहै ज़ीद।</char>
    <note caller="-" style="x">
      <char style="xo" closed="false">5:43 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:18">लेब. 19:18</ref>
      </char>
    </note><verse eid="MAT 5:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 5:44" />
    <char style="wj">“पर हुंह बोला तम्हां लै इहअ कि आपणैं दुशमणा संघै डाहै झ़ूरी। ज़ुंण ताल्है ज़ुल्म करा, तेऊ लै करै प्राथणां।</char><verse eid="MAT 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 5:45" />
    <char style="wj">“इहअ करै हणैं तम्हैं आपणैं स्वर्गे बाब परमेशरे लुआद। किल्हैकि सह दैआ भलै अर बूरै दुही लै सुरज़ो धुप्पअ, अर धर्मीं अर पापी दुही लै बरशाऊआ पाणीं।</char> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" /><char style="wj">किल्हैकि, ज़ै तम्हैं आप्पू लै झ़ूरनै आल़ै संघै ई झ़ूरी डाहा, तै तम्हां लै किज़ै फाईदअ हणअ? होर लोग बी कै इहअ निं करदै?</char><verse eid="MAT 5:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 5:47" />
    <char style="wj">“ज़ै तम्हैं आपणैं ई भाई-बंधा लै अदर करा, सह कै तम्हैं बेघै बडअ काम करा? इहअ कै होर लोग बी करदै निं आथी?</char> <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" /><char style="wj">तैही बोला हुंह कि तम्हैं हआ सिध्द, ज़िहअ थारअ स्वर्गो बाब परमेशर सिध्द आसा।”<note caller="+" style="f"><char style="fr" closed="false">5:48 </char><char style="ft" closed="false">लेब. 19:2</char></note></char><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <char style="wj">“ऐहा गल्‍लो डाहै धैन कि तम्हैं निं सिधै एते तैणीं भलअ करी कि लोगै लोल़ी तम्हैं भाल़ै। तै निं तम्हां तेतो स्वर्गे परमेशर थारै बाबा का किछ़ै फल भेटणअ।</char><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />
    <char style="wj">“तैही बोला हुंह, ‘ज़ै तूह गरीबा लै दान करे, सह निं सोभी का लागदअ खोज़णअ कि मंऐं किज़ै दैनअ। ज़िहअ कपटी मणछ सभागृहा अर बागै काढा रहैऊंणा लै। ताकि लोग तेता भाल़ी तिन्‍नें बड़ैई करे।’</char></para>
  <para style="p" vid="MAT 6:2">
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि तिन्‍नां गअ तेतो फल भेटी।</char> <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" /><char style="wj">पर ज़ेभै तूह गरीबा लै दान करे, तेभै निं कोही का लोल़ी थोघ लागअ कि तंऐं किज़ै दैनअ।</char> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" /><char style="wj">ताकि तेरअ गरीबा लै दैनअ द दान गुप्त रहे अर थारअ बाब परमेशर ज़ुंण गुप्त गल्‍ला भाल़ा, तेऊ दैणअ ताल्है तेतो फल।</char><verse eid="MAT 6:4" /></para>
  <para style="s">प्राथणां</para>
  <para style="r">(<ref loc="LUK 11:2-4">लूका 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <char style="wj">“ज़ेभै तूह प्राथणां करे, तेता बी निं तूह कपटी मणछा ज़ेही करी। ज़ेही तिंयां लोगा का रहैऊंणै तैणीं सभागृहा, बडी-बडी सभा अर खुल्ही ज़ैगा तिन्‍नां भज़न प्राथणां करनैओ च़ाअ लागा।</char></para>
  <para style="p" vid="MAT 6:5">
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि तिन्‍नां गअ तेतो फल भेटी।</char> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" /><char style="wj">पर ज़ेभै तूह प्राथणां परमेशरा सेटा गल्‍ला करे, तेभै डेओऐ आपणीं पांडा भितरी, संघा करै दुआर बुदरी करै गुप्त प्राथणां। तेरअ बाब परमेशर ज़ुंण ताह गुप्त भाल़ा, तेऊ दैणअ ताल्है तेतो फल।</char><verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />
    <char style="wj">“प्राथणां करदी बारी निं तूह होरी ज़िहअ एकी ई गल्‍ला लै भिई-भिई कांग डाही। किल्है लाई। तिंयां समझ़ा इहअ कि एही खास्सी कांग डाहे लाई, तै हेरनी तिन्‍नें अरज़ शूणीं।</char><verse eid="MAT 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 6:8" />
    <char style="wj">“तम्हैं निं तिन्‍नां ज़िहै बणी। किल्हैकि थारै स्वर्गै रहणैं आल़ै बाब परमेशरा का आसा थारै मांगणै का पैहलै ई थोघ कि तम्हां किज़ू गल्‍ले निऊल़ आसा।</char> <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" /><char style="wj"><note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">लूक. 11:2</char></note>तम्हैं करै एही प्राथणां,</char></para>
  <para style="q" vid="MAT 6:9">
    <char style="wj">‘हे परमेशर, म्हारै बाब, तूह ज़ुंण स्वर्गै आसा, </char></para>
  <para style="q" vid="MAT 6:9">
    <char style="wj">सोभी लोल़ी तेरै पबित्र नाओं अदर किअ, </char><verse eid="MAT 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="wj">तेरअ राज़ लोल़ी आअ।</char></para>
  <para style="q" vid="MAT 6:10">
    <char style="wj">ज़ेही तेरी मरज़ी स्वर्गै पूरी हआ, </char></para>
  <para style="q" vid="MAT 6:10">
    <char style="wj">तेही लोल़ी एऊ संसारै बी पूरी हुई।</char><verse eid="MAT 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="wj">हे प्रभू, हर धैल़ै दै हाम्हां लै बैल़ी-क्लारी ज़ेते हाम्हां ज़रुरत आसा, </char><verse eid="MAT 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="wj">ज़ै हाम्हां का किज़ै भूल-च़ूक हुई होए, तेता करै माफ </char></para>
  <para style="q" vid="MAT 6:12">
    <char style="wj">ज़ेही हाम्हैं बी तिन्‍नां लै माफी छ़ाडी ज़ुंणी हाम्हां लै ज़ुल्म किऐ।</char><verse eid="MAT 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="wj">हाम्हां लै निं खरी दैई पल़णै,</char></para>
  <para style="q" vid="MAT 6:13">
    <char style="wj">पर हर पाप करनै का अर तेऊ कदुष्ट राख्सा का डाहै हाम्हां बच़ाऊई</char></para>
  <para style="q" vid="MAT 6:13">
    <char style="wj">किल्हैकि राज़, बल अर जश आसा हाम्हां लै तेरअ ई।’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:13 </char>
      <char style="ft" closed="false">कई इब्रानी कताबा दी निं अह खिरी लिखी दी गल्‍ल आथी (किल्हैकि हाम्हां लै तेरअ ई)। </char>
    </note><verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />
    <char style="wj">“ज़ै तम्हैं होरी मणछे पाप माफ नांईं करे, तै निं थारै पाप बी थारै स्वर्गै रहणैं आल़ै बाब परमेशरा माफ करनै।</char> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><char style="wj">ज़ै तम्हैं होरी मणछे पाप माफ करे, तै करनै स्वर्गे बाब परमेशरा बी थारै पाप माफ।</char><verse eid="MAT 6:15" /></para>
  <para style="s">ब्रत</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />
    <char style="wj">“ज़ेभै तम्हैं ब्रत करे, तेभै निं तम्हैं कपटी मणछा ज़िहअ मुंह डाही छ़ड़ाऊई। किल्हैकि तिंयां डाहा आपणअ मुंह शेऊई। ताकि लोगा का इहअ थोघ च़ले कि अह आसा ब्रतू। हुंह खोज़ा तम्हां का सत्त कि तिन्‍नां गअ तेतो फल भेटी।</char><verse eid="MAT 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17" />
    <char style="wj">“पर ज़ेभै तूह ब्रतू होए तेभै न्हैईआ अर मुंडै मल़ तेल।</char> <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" /><char style="wj">ताकि कोही का थोघ निं होए कि तूह आसा ब्रतू। पर तेरअ बाब परमेशर ज़ुंण ताह गुप्त भाल़ा, सिधअ तेऊ का लोल़ी थोघ लागअ अर तेऊ ई दैणअ ताल्है तेतो फल।</char><verse eid="MAT 6:18" /></para>
  <para style="s">स्वर्गो धन</para>
  <para style="r">(<ref loc="LUK 12:33">लूका 12:33</ref>,<ref loc="LUK 12:34">34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <char style="wj">“आप्पू लै निं पृथूई दी धन-माया कठा करा, ज़िधी किल़ै खाआ, खई लागा अर च़ोर पाआ च़ोरी।</char> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><char style="wj">पर तम्हैं करा आप्पू लै स्वर्गै धन-माया कठा, ज़िधी नां किल़ै खांदै, नां खई लागदी अर नां च़ोरी करदअ कोई च़ोर आथी।</char> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" /><char style="wj">किल्हैकि ज़िधी तेरअ धन आसा तिधी रहणअ तेरअ मन्‍न बी लागी।</char><verse eid="MAT 6:21" /></para>
  <para style="s">देहीओ प्रैश्शअ</para>
  <para style="r">(<ref loc="LUK 11:34-36">लूका 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />
    <char style="wj">“ऐहा देहीओ दीअ आसा आछ, ज़ै तेरी आछ ठीक होए, तै हणीं तेरी सारी देही प्रैश्शी।</char> <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" /><char style="wj">पर ज़ै तेरी आछ ई बूरी होए, तेरी सारी देही हणीं न्हैरी। इहअ करै ज़ुंण ताखा प्रैश्शअ आसा, ज़ै सह न्हैरअ होए, तै सोठा सह केतरअ बडअ हणअ।</char><verse eid="MAT 6:23" /></para>
  <para style="s">परमेशर अर धन</para>
  <para style="r">(<ref loc="LUK 16:13">लूका 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />
    <char style="wj">“कोहै दास निं दूई मालके च़ाकरी करी सकदअ। किल्हैकि एकी संघै ता डाहणीं तेऊ झ़ूरी अर दुजै संघै हणीं तेऊ ज़ीद या एकी संघै रहणअ तेऊ मिल़ी-ज़ुल़ी अर दुजअ हणअ तेऊ लै निक्‍कअ। परमेशर अर धन दुहीए निं तम्हैं कठा च़ाकरी करी सकदै।</char><verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />
    <char style="wj">“तैही बोला हुंह तम्हां लै इहअ कि आपणीं ज़िन्दगी लै इहअ फिकर निं करी कि किज़ै खाणअ किज़ै पिणअ? नां आपणीं देही लै फिकर करी कि हाम्हां किज़ै बान्हणअ? ज़िन्दगी आसा रोटी का अर देही आसा झिकल़ै का खास्सी किम्मती।</char><verse eid="MAT 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 6:26" />
    <char style="wj">“सरगै डैऊंदै च़ेल्‍लू-पखीरू भाल़ा! तिंयां नां बऊंदै, नां लऊंदै आथी, अर नां तिंयां भढारा भरना लै कठा करदै। तैबी दैआ थारअ स्वर्गै रहणैं आल़अ बाब परमेशर तिन्‍नां लै खाणअ-पिणअ। तम्हैं कै तिन्‍नां का खास्सै किम्मती निं आथी?</char> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><char style="wj">तम्हां मांझ़ै इहअ कुंण आसा कि फिकर करी आपणीं अमर धख ज़ेही बी सका लाम्मी करी?</char><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />
    <char style="wj">“झिकल़े तैणीं किल्है करा तम्हैं फिकर? बणैं लागै दै होछ़ै-होछ़ै फूला दैआ भाल़णीं कि तिंयां किहअ करै बझ़ा? तिंयां नां मैन्थ करदै, अर नां तिंयां ऊन काती करै आप्पू लै झिकल़ै बणाऊंदै।</char><verse eid="MAT 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 6:29" />
    <char style="wj">“तैबी बोला हुंह तम्हां लै इहअ कि सुलैमान राज़ै बी निं आपणैं सारै राज़-पाठा दी तिन्‍नां कोही बराबर शोभलै झिकल़ै बान्हैं।</char> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" /><char style="wj">ज़ै परमेशर घैहणींए घाहा लै बी इहै झिकल़ै बन्हैऊंआं, ज़ुंण आझ़ आसा अर काल्‍ला दहणअ सह आगी जैंदरी। ओ बैहमी विश्वासीओ, तम्हां लै कै सह झिकल़ै दैई निं सकदअ?</char><verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />
    <char style="wj">“इहअ करै तम्हैं इहअ फिकर निं करी अर नां इहअ बोली कि हाम्हां किज़ै खाणअ-पिणअ अर बान्हणां लै किज़ै हणअ?</char> <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" /><char style="wj">किल्हैकि होर लोग बी रहा इना च़िज़ा लोल़ै लागी, पर थारअ स्वर्गै रहणैं आल़ै बाब परमेशरा का आसा थोघ कि तम्हां आसा इना गल्‍ले ज़रुरत।</char> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><char style="wj">तैही बोला हुंह तम्हां लै इहअ कि पैहलै करा बाब परमेशरे धर्म अर राज़े लोल़-तोप अर ईंयां सारी च़िज़ा जाणीं तम्हां भेटी।<note caller="+" style="f"><char style="fr" closed="false">6:33 </char><char style="ft" closed="false">लूक. 12:31</char></note></char><verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />
    <char style="wj">“ऐबै काल्‍ला धैल़ीओ फिकर निं तम्हैं करी, किल्हैकि काल्‍ला एछणैं आल़ी धैल़ी हेरनअ आपणअ फिकर आप्पै करी अर आझ़ा लै आसा आझ़ो दुख ई बतेर्हअ।”</char><verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">दुजै लै दोश निं लाणअ</para>
  <para style="r">(<ref loc="LUK 6:37">लूका 6:37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />
    <char style="wj">“होरी लै दोश निं लाणअ, तै निं तम्हां लै बी दोश लागणअ अर नां तेते सज़ा पल़णीं भुगतणी।</char> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><char style="wj">किल्हैकि ज़िहअ तम्हैं दुजै लै दोश लाआ, तिहअ ई दोश लागणअ तम्हां लै बी। ज़ेऊ ढाल़ै तम्हैं होरी संघै बर्ताअ करा तेऊ ढाल़ै हणअ तम्हां संघै बी बर्ताअ अर तम्हां भेटणअ होर बी खास्सअ।</char><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />
    <char style="wj">“कहा होरी भाईए होछ़ी-होछ़ी गलती लोल़ै निं लागणअ! सह हणीं दुजे आछी दी पल़ी दी धख ज़ेही घाहे कणीं भाल़णें ज़ेही। पर आप्पू दैणीं भाल़णीं कि मुंह दी केतरी बडी गलती आसा। किल्हैकि आपणीं आछी दी पल़अ द निं ताखा शेटू बी शुझदअ।</char><verse eid="MAT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 7:4" />
    <char style="wj">“ज़ै तेरी आपणीं आछी ई आसा शेटू पल़अ द, तै किहअ करै सका तूह आपणैं भाई लै इहअ बोली, ‘एछ मेरै भाई हुंह काढूं तेरी आछी पल़ी दी घाहे कणीं पोर्ही?’</char><verse eid="MAT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 7:5" />
    <char style="wj">“हे कपटी मणछा, आपणीं आछी पल़अ द शेटू काढ पैहलै पोर्ही। तेखअ सका तूह आपणैं भाईए आछी दी पल़ी दी घाहे कणीं काढी।</char><verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />
    <char style="wj">“परमेशरो समाद निं तिन्‍नां का खोज़णअ ज़ुंण शुणनअ निं च़ाहंदै। ज़ै तम्हैं इहअ करे, सह हणीं एही गल्‍ल कि पबित्र च़िज़ा शोटी कुक्‍करा आजू या मोती शोटै सुंगरा आजू। तिन्‍नां पाणै तिंयां जैंटी अर तेते बदल़ै एछणैं तिंयां तम्हां खांदै ठुर्ही।</char><verse eid="MAT 7:6" /></para>
  <para style="s">ज़ुंण बी मांगे सह भेटणअ</para>
  <para style="r">(<ref loc="LUK 11:9-13">लूका 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />
    <char style="wj">“मांगदै रहा लागी, तै जाणीं तम्हां सह गल्‍ल भेटी ज़ेता तम्हैं मांगा। दुआरा रहा टोक्‍कदै लागी अर सह दुआर जाणअ तम्हां लै खुल्ही।</char> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" /><char style="wj">किल्हैकि ज़ुंण मांगा, तेऊ भेटा अर ज़ुंण लोल़अ लागा, तेऊ बी भेटा अर ज़ुंण दुआर टोक्‍का, तेऊ लै खुल्हा दुआर।</char><verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />
    <char style="wj">“तम्हां मांझ़ै इहअ कुंण आसा कि तेऊओ शोहरू मांगा रोटी, अर सह दैआ आपणैं तेऊ शोहरू लै पात्थर?</char> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" /><char style="wj">ज़ै तेऊओ शोहरू म्हाछ़ली मांगा, पर सह दैआ तेऊए हाथै दानअ?</char><verse eid="MAT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 7:11" />
    <char style="wj">“ज़ै तम्हैं बूरै हई बी आपणैं शोहरू लै राम्बल़ी च़िज़ा दैई सका, तै थारअ स्वर्गे रहणैं आल़अ बाब परमेशर आपणैं मांगणै आल़ै लै राम्बल़ी च़िज़ा किल्है निं दैई सकदअ?<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">लूक. 11:13</char></note></char> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><char style="wj">ठीक इहअ ई, ज़िहअ तम्हैं च़ाहा कि होर मणछ तम्हां संघै करे, तम्हैं बी करा तिन्‍नां संघै तिहअ ई। परमेशरे गूरै बी आसा बधाना दी ईंयां ई ज्ञैन खोज़ै दै।</char><verse eid="MAT 7:12" /></para>
  <para style="s">घाटी अर खुल्ही बात</para>
  <para style="r">(<ref loc="LUK 13:24">लूका 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />
    <char style="wj">“परमेशरा सेटा स्वर्गै डेऊणा लै आसा बडी सांगल़ी बात अर सोभी लागा तैहा बाता डेऊणअ। होर बात बी आसा ज़ेथ खास्सै मणछ डेओआ। सह बात आसा खुल्ही। तिंयां रहा तैहा बाता तेभै तैणीं हांढदै लागी ज़ेभै तैणीं तिंयां खुल्ही प्रऊल़ी सेटा निं पुजा, पर सह पजैल़ा बनाश करी जम्परी। खास्सै मणछ पेठा तैहा ई प्रऊल़ी बाती।</char> <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><char style="wj">सह प्रऊल़ आसा सांगल़ी अर सह आसा बडी कठण बात ज़ुंण ज़िन्दगी दी पजैल़ा, पर तेस्सी बाती डेओआ थोल़ै।</char><verse eid="MAT 7:14" /></para>
  <para style="s">ज़िहअ बूट तिहअ फल़</para>
  <para style="r">(<ref loc="LUK 6:43">लूका 6:43</ref>,<ref loc="LUK 6:44">44</ref>,<ref loc="LUK 6:46">46</ref>; <ref loc="LUK 13:25-27">13:25-27</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />
    <char style="wj">“झ़ुठै गूरा का रहै चतैन, तिंयां एछा भेडे भेश बणाईं तम्हां सेटा लै। पर भितरी हआ तिंयां धेल़णै-च़िरनैं आल़ै रुहलै।<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">एज. 22:27</char></note></char> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><char style="wj">तिन्‍नां सका तम्हैं तिन्‍नें कामां का बछ़ैणीं। किल्हैकि हिंहरे कांडै दी दाख अर झ़िंझ़रै दी फेडू निं लागदै!</char><verse eid="MAT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 7:17" />
    <char style="wj">“ठीक इहअ ई हर एक राम्बल़अ बूट दैआ राम्बल़अ फल़ अर निक्‍कअ दैआ निक्‍कअ फल़।</char> <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" /><char style="wj">तिहअ ई राम्बल़अ बूट निं कधि निक्‍कअ फल़ दैंदअ। निक्‍कअ बूट निं कधि राम्बल़अ फल़ दैई सकदअ।</char><verse eid="MAT 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 7:19" />
    <char style="wj">“ज़ुंण बूट राम्बल़अ फल़ नांईं दैंदअ, सह पाणअ काटी अर सह दहणअ झ़ुका लै।</char> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><char style="wj">इहअ करै सका तम्हैं तिन्‍नें फल़ा करै तिन्‍नां बछ़ैणीं।</char><verse eid="MAT 7:20" /></para>
  <para style="s">शुचै च़ेल्‍लै</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />
    <char style="wj">“ज़ुंण मुल्है हे प्रभू, हे प्रभू करा, तिन्‍नां मांझ़ै निं हर कोई स्वर्गे राज़ा दी डेऊणअ। पर स्वर्गै डेऊणअ सह ज़ुंण तिहअ करे ज़िहअ थारअ बाब परमेशर च़ाहा।</char><verse eid="MAT 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 7:22" />
    <char style="wj">“तैहा धैल़ी बोल़णअ कई लोगा मुल्है कि हे प्रभू, हे प्रभू, हाम्हैं कै तेरै नाओंऐं आजू हणैं आल़ी गल्‍ला प्रगट निं किई? हाम्हैं कै तेरै नाओंऐं भूत निं दरल़ाऊऐ अर हाम्हैं तेरै नाओंऐं खास्सै स्वर्गे नछ़ैण अर च़मत्कार निं किऐ?</char><verse eid="MAT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 7:23" />
    <char style="wj">“तेभै बोल़णअ मुंह तिन्‍नां लै साफ-साफ कि हुंह निं तम्हां कधि बछ़ैणदअ, ओ कदुष्ट काम करनै आल़ै पापी मणछो मुंह सेटा का डेओआ दूर।<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">लूक. 13:27</char></note></char><verse eid="MAT 7:23" /></para>
  <para style="s">घअरा बणाणैं आल़ै दूई मणछ, समझ़कार अर ऐडअ</para>
  <para style="r">(<ref loc="LUK 6:47-49">लूका 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />
    <char style="wj">“तैही बोला हुंह ज़ुंण मेरी गल्‍ला शूणीं तिन्‍नां मने, सह हणअ तेऊ समझ़कार मणछा ज़िहअ, ज़ुंण आपणअ घअर पाक्‍कै शाफल़ा प्रैंदै पाक्‍की ज़ैगा बणाआं।</char> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" /><char style="wj">ज़ांऊं बरसात आई, ढिश-बागर च़ली, पाणींए गाडा-नाल़ी आई। तेऊ घअरा दी लागै बडै-बडै ढेसै। पर सह घअर निं ढूल़अ। किल्हैकि तेते आथरी थिई पाक्‍की ज़ैगा।</char><verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />
    <char style="wj">“पर ज़ुंण मेरी इना गल्‍ला शूणां अर नांईं मंदअ आथी, सह हणअ तेऊ ऐडै मणछा ज़िहअ ज़ुंणी आपणअ घअर रेता प्रैंदै बणाअं।</char> <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><char style="wj">ज़ांऊं बरसात आई, ढिश-बागर च़ली, अर गाडा-नाल़ी आई। तेऊ घअरा दी लागी धख ज़ेही ढेस, सह घअर हुअ ढूल़ी करै बरैबाद।”</char><verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />ज़ांऊं ईशू इना गल्‍ला बोली मुक्‍कअ, तिधी थिऐ खास्सै मणछ, तिंयां हुऐ रहैन। <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />किल्हैकि सह निं शास्त्री फरीसी मणछा ज़ेही शिक्षा दैंदअ ज़ुंण लोगा का बधाने तिन्‍नां गल्‍ला खोज़ा तै भिई-भिई ज़ुंण पैहलै होरी आसा बोली दी पर सह दैआ त इहै गूरू ज़ेही शिक्षा ज़ेतो तेऊ हक अर आप्पू का थोघ हआ त।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">कोहल़ो रोगी किअ शुचअ</para>
  <para style="r">(<ref loc="MRK 1:40-45">मार्कुस 1:40-45</ref>; <ref loc="LUK 5:12-16">लूका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />ज़ांऊं ईशू धारा का उंधै होथअ, तेऊ पिछ़ू लागै खास्सै मणछ हांढदै। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />तिन्‍नां मांझ़ा का आअ एक मणछ ज़हा कोहल़ ती निखल़ी दी। तेऊ टेक्‍कअ ईशू सेटा माथअ संघा किई एही अरज़, “हे प्रभू, ज़ै तूह च़ाहे, तूह सका मुंह एऊ कोहल़ा का शुचअ करी।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ईशू छ़ुंअ सह आपणैं हाथा करै संघा बोलअ, <char style="wj">“हुंबी च़ाहा इहअ ई, तूह लोल़ी एभी शुचअ हुअ।”</char> अर सह हुअ तेभी कोहल़ा का शुचअ। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />ईशू बोलअ तेऊ लै, <char style="wj">“हेरे, ऐहा गल्‍ला निं होरी कोही का खोज़ी। हाँ, प्रोहता सेटा डेऊई एछ आप्पू रहैऊई अर कोहल़ा का शुचै हणें बारै ज़ुंण बधान परमेशरे गूर मोसा आसा खोज़अ द तेऊ साबै दै भैंट। ताकि तिंयां भाल़े कि तूह गअ कोहल़ा का शुचअ हई।”<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">लेब. 14:2-32</char></note></char><verse eid="MAT 8:4" /></para>
  <para style="s">सैने एकी दरबारीओ विश्वास</para>
  <para style="r">(<ref loc="LUK 7:1-10">लूका 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />ईशू डेऊअ कफरनहूम नगरी लै, तिधी आअ एक सुबैदार ईशू सेटा लै संघा लागअ एही अरज़ करदअ, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“हे प्रभू, मेरै आसा घअरै एक दास च़ैन्‍नै सुत्तअ द खास्सअ दुखी तेऊ आसा दरंग हुअ द।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />ईशू बोलअ तेऊ लै इहअ, <char style="wj">“हुंह आअ तेरै घअरा लै, तेऊ करूं हुंह नरोगै।”</char><verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />सुबैदारै बोलअ ईशू लै, “हे प्रभू, हुंह निं एता जोगी आथी कि तूह मेरै घअरै एछी सके। तूह कर इधी का हुकम अर मेरअ दास जाणअ नरोगअ हई, एतो आसा मुंह पाक्‍कअ भरोस्सअ।<verse eid="MAT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 8:9" />“किल्हैकि हुंह आसा आप्पू बी सरकारी दास अर मुंह आसा आप्पू उंधै काम करनै आल़ै सपाही लै हुकम करनैओ हक। ज़ांऊं हुंह कहा लै पोर्ही डेऊणा लै बोला, सह डेओआ पोर्ही अर ज़हा लै ओर्ही एछणा लै बोला, सह एछा ओर्ही अर आपणैं दासा लै बोला हुंह कि इहअ कर, सह करा तिहअ ई।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ईशू हुअ तेऊए गल्‍ला शूणीं रहैन। तेऊ बोलअ तिन्‍नां लै ज़ुंण तेऊ पिछ़ू तै हांढदै लागै दै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि मंऐं निं एऊ होरी ज़ातीए मणछा ज़िहअ विश्वास पूरै इज़राईला दी भाल़अ।</char> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><char style="wj">हुंह बोला तम्हां लै इहअ कि च़ऊ दिशा का एछी बेशणै लोग आबराम, याकब अर इसहाका संघै स्वर्गे राज़ा दी।</char><verse eid="MAT 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 8:12" />
    <char style="wj">“पर ज़हा यहूदी लै परमेशरै राज़ दैणअ किअ त, तिंयां काढणैं बागै न्हैरी जम्परी लै। तिधी हणैं तिंयां लैल़ा लांदै अर दाहे झोशा करै दांदा कटिल्‍लदै लागै दै।”</char><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />तेखअ बोलअ ईशू तेऊ सुबैदारा लै, <char style="wj">“घअरा लै डेऊ, ज़िहअ तूह विश्वास करा, ताल्है लोल़ी तिहअ ई हुअ”</char> सुबैदारो दास हुअ तेभी नरोगअ।<verse eid="MAT 8:13" /></para>
  <para style="s">ईशू किऐ खास्सै रोगी नरोगै</para>
  <para style="r">(<ref loc="MRK 1:29-34">मार्कुस 1:29-34</ref>; <ref loc="LUK 4:38-41">लूका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />तेखअ आअ ईशू पतरासे घअरै अर तिधी त पतरासे शाशुई ज़अर आअ द। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ईशू छ़ुंअ तेसो हाथ, सह उझ़ुई तेभी खल़ी अर सह लागी तिन्‍नें च़ाकरी करदी।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />ज़ांऊं सान्ह पल़ी, ईशू सेटा लै आऐ खास्सै रोगी मणछ, तिन्‍नां तै भूत शाचै दै, अर कई रंगे रोग, ईशू काढै तिन्‍नां सोभिए भूत दूर अर सोभ रोगी किऐ नरोगै। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" /><note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="1PE 2:24">1 पत. 2:24</ref></char></note>इहअ करै हुअ ईशायाह परमेशरे गूरै बोलअ द बैण बी पूरअ,</para>
  <para style="q" vid="MAT 8:17">“तेऊ च़की म्हारी कमज़ोरी आप्पू दी,</para>
  <para style="q" vid="MAT 8:17">अर किऐ म्हारै दाहे शूल़ दूर।”<verse eid="MAT 8:17" /></para>
  <para style="s">ईशूए च़ेल्‍लै हणैंओ मोल</para>
  <para style="r">(<ref loc="LUK 9:57-62">लूका 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />ईशू भाल़ै आप्पू फेर खास्सै मणछो छ़ुंड, अर तेऊ बोलअ आपणैं च़ेल्‍लै लै कि समुंदरा पारा लै च़ाल्‍ला।<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />तिधी आअ एक शास्त्री। तेऊ बोलअ ईशू सेटा एछी, “हे गूरू, ज़िधा लै बी तूह डेओए मुंह बी लागणअ ताह पिछ़ू हांढदै।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />ईशू दैनअ तेऊ लै इहअ ज़बाब, <char style="wj">“शैल़ीए हआ जुहल़ी अर सरगै डैऊंदै च़ेल्‍लू-पखीरूए हआ कोल्ह। पर हुंह मणछो पूत ज़ुंण स्वर्गा का आसा आअ द, मुल्है निं किधी घअर आथी ज़िधी हुंह सुत्ती सकूं!”</char><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />तेखअ बोलअ एकी होरी च़ेल्‍लै ईशू लै, “हे प्रभू, मेरै आसा घअरै प्रोढै, तिन्‍नें क्रिया कर्म हणैं तैणीं लऊं हुंह, न्हैल़ी तेभा बाद एछणअ मुंह ताह संघै।”<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="1KI 19:20-21">1 राज़. 19:20-21</ref></char></note><verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />ईशू बोलअ तेऊ लै, <char style="wj">“ज़ुंण आत्मां दी मुल्दै आसा, तिन्‍नां दै मुल्दै दाबणै, तूह लाग मुंह पिछ़ू हांढदअ।”</char><verse eid="MAT 8:22" /></para>
  <para style="s">ढिश-बागर शांत करनअ</para>
  <para style="r">(<ref loc="MRK 4:35-41">मार्कुस 4:35-41</ref>; <ref loc="LUK 8:22-25">लूका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ज़ांऊं ईशू किश्ती दी बेठअ, तेऊए च़ेल्‍लै बी लागै तेऊ संघै हांढदै। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />समुंदरै आई खास्सी ढिश-बागर, अर किश्ती लै उझ़ुई बडी-बडी छ़ाल्‍ली, तेखअ तिंयां च़ाल्‍लै किश्ती संघी पाणीं दी डुबी! ईशू थिअ पिछ़ू सुत्तअ द। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />तेखअ आऐ च़ेल्‍लै ईशू सेटा, संघा लागै लैल़ा-पकारा पाई बोल्दै, “हे प्रभू, हाम्हां बच़ाऊ हाम्हैं च़ाल्‍लै खतम हई, किश्ती च़ाल्‍ली डुबी।”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं विश्वास किल्है निं करदै, तम्हैं किल्है डरा?”</char> इहअ बोली उझ़ुअ ईशू खल़अ संघा काढी ढिश-बागर अर समुंदरे छ़ाल्‍ली नैरना लै काढी झांश, <char style="wj">“शांत हअ,”</char> ढिश-बागर अर छ़ाल्‍ली हुई तेभी शांत। <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />च़ेल्‍लै हुऐ रहैन संघा लागै इहअ बोल्दै, “अह किहअ मणछ आसा कि एऊए गल्‍ला शूणां ढिश-बागर अर समुंदरे छ़ाल्‍ली बी!”<verse eid="MAT 8:27" /></para>
  <para style="s">भूत शाचै दै मणछ किऐ राम्बल़ै</para>
  <para style="r">(<ref loc="MRK 5:1-20">मार्कुस 5:1-20</ref>; <ref loc="LUK 8:26-39">लूका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />तिंयां पुजै समुंदरा पार गरासेनी मुल्खै, तिधी आऐ दूई मणछ मल्थाना का, तिन्‍नां दी थिऐ भूत शाचै दै, तिंयां मणछ थिऐ एतरै बूरै कि तिन्‍नां डरै निं तैहा बाता कोहै डेऊई सकदअ त।<verse eid="MAT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 8:29" />ज़ांऊं तिन्‍नां का ईशू शुझुअ, तिन्‍नैं बोलअ बडी-बडी लैल़ा पाई ईशू लै, “हे परमेशरे पूता, तूह इधी किज़ू आअ? तंऐं कै म्हारअ बगत एछणैं का आजी लाई हाम्हां लै सज़ा दैई?”<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="LUK 4:34">लूक. 4:34</ref></char></note><verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />तिन्‍नां का दूर ज़िहअ त तिधी धारठी एक सुंगरो बडअ छ़ुंड च़रदअ लागअ द। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />तिन्‍नैं भूतै किई ईशू का एही अरज़, “ज़ै तंऐं हाम्हैं इना मणछा का पोर्ही लाई काढी, तै दै हाम्हां इना सुंगरे छ़ुंडा दी डेऊणे ज़ाज़त।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“डेओआ,” </char> अर तिंयां पेठी सुंगरे छ़ुंडा दी। सह सुंगरो छ़ुंड हुअ बेगरअ अर तिन्‍नैं दैनी समुंदरा लै छ़ाहल़ा। इहअ करै सारअ सुंगरो छ़ुंड हुअ पाणीं जैंदरी मरी खतम।<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />इहअ भाल़ी ठुर्है तिंयां सुंगरा गुआल़ै तिधा का। घअरै डेऊई खोज़अ तिन्‍नैं सारी नगरी तिन्‍नां भूता आल़ै मणछो हाल कि किहअ-किहअ हुअ। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />इना गल्‍ला शूणीं आऐ सारी नगरीए लोग ईशू सेटा अर तिंयां सोभ लोग लागै ईशू का एही अरज़ करदै “म्हारै एऊ मुल्खा का डेऊ बागै।”<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">दरंगो रोगी किअ नरोगअ</para>
  <para style="r">(<ref loc="MRK 2:1-12">मार्कुस 2:1-12</ref>; <ref loc="LUK 5:17-26">लूका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />तेखअ डेऊअ ईशू तिधा का किश्ती दी पार कफरनहूम आपणीं नगरी लै। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />तिधी आऐ कोऐ मणछ तिन्‍नैं आणअ एक मणछ बछ़ाऊणैं प्रैंदै ईशू सेटा लै, तेऊ त दरंग हुअ द। ईशू बोलअ तिन्‍नों विश्वास भाल़ी तेऊ दरंगे मरीज़ा लै, <char style="wj">“शोहरूआ, फिकर निं करी, तेरै पाप हुऐ माफ।”</char><verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />इहअ शूणीं लागै तिधी आऐ दै यहूदी शास्त्री सोठदै, “अह ता परमेशरे कदर बी निं करदअ!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />ईशू हेरी तिन्‍नें मन्‍नें गल्‍ला भुझ़ी, संघा बोलअ तिन्‍नां शास्त्री लै, <char style="wj">“तम्हैं आपणैं मन्‍नैं बूरअ किल्है सोठा?</char> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" /><char style="wj">सान गल्‍ल किज़ै आसा, एऊ दरंगे मरीज़ा लै इहअ बोल़णअ कि तेरै पाप हुऐ माफ, या एऊ लै इहअ बोल़णअ, ‘उझ़ू हांढदअ-फिरदअ लाग?’</char> <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" /><char style="wj">ज़िहअ करै तम्हां का थोघ लागे कि मुंह मणछे पूता लै आसा पृथूई दी पाप माफ करनैओ हक।”</char></para>
  <para style="p" vid="MAT 9:6">तेखअ बोलअ ईशू तेऊ दरंगे मरीज़ा लै, <char style="wj">“हुंह बोला ताल्है, उझ़ू आपणैं एऊ बछ़ाऊणैं च़क संघा डेऊ आपणैं घअरा लै।”</char><verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />सह मरीज़ उझ़ुअ तेभी सोभी नदरी खल़अ, संघा डेऊअ आपणैं घअरा लै। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />ऐहा गल्‍ला भाल़ी हुऐ तिधी सोभ लोग रहैन अर तिंयां डरै बी। तिन्‍नैं भाल़अ कि परमेशरै दैनअ मणछा लै बेघै बडअ हक! तिंयां लागै परमेशरे ज़ै-ज़ैकार करदै<verse eid="MAT 9:8" /></para>
  <para style="s">ईशू शादअ मोत्ती</para>
  <para style="r">(<ref loc="MRK 2:13-17">मार्कुस 2:13-17</ref>; <ref loc="LUK 5:27-32">लूका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />तिधा का आजू डेऊई भाल़अ ईशू एक मोत्ती नाओं मणछ कारै गराहणे च़ौकी दी बेठअ द, सह करा त सरकारी कारै गराहणैओ काम, ईशू बोलअ तेऊ लै, <char style="wj">“मुंह संघै एछ।”</char> सह उझ़ुअ तेभी खल़अ संघा डेऊअ ईशू संघै।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />ज़ांऊं ईशू मोत्तीए घअरै रोटी खांदअ बेठअ, ईशू सेटा लै आऐ खास्सै पापी मणछ संघा बेठै ईशू अर तेऊए च़ेल्‍लै संघै रोटी खांदै। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />इहअ भाल़ी बोलअ अर फरीसी ईशूए च़ेल्‍लै लै, “थारअ गूरू पापी अर कारै गराहणै आल़ै मणछा संघै किल्है खाआ-पिआ?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />इहअ शूणीं बोलअ ईशू तिन्‍नां लै, <char style="wj">“बैईद निं नरोगै मणछा सेटा एछदअ, पर रोगी मणछा सेटा लागा तेऊ ज़रूरी पुजणअ।</char> <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><char style="wj">डेओआ संघा एछा भाल़ी कि पबित्र शास्त्रा दी किज़ै आसा लिखअ द, परमेशर बोलअ तेथ इहअ, ‘हुंह निं थारै डागै-चैणैंओ बल़ीदान च़ाहंदअ, हुंह च़ाहा इहअ कि तम्हैं झींण करे।’ किल्हैकि ज़ुंण आप्पू लै इहअ समझ़ा कि तिंयां आसा धर्मीं, तिन्‍नां शधाणूं निं हुंह आथी आअ द, पर हुंह आसा तिन्‍नां लै आअ द ज़ुंण इहअ समझ़ा कि तिंयां आसा पापी।”<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">होश. 6:6</char></note></char><verse eid="MAT 9:13" /></para>
  <para style="s">ब्रत करनैओ सुआल</para>
  <para style="r">(<ref loc="MRK 2:18-22">मार्कुस 2:18-22</ref>; <ref loc="LUK 5:33-39">लूका 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तेखअ आऐ जोहन्‍ना डुबकी दैणैं आल़ेए च़ेल्‍लै ईशू सेटा, संघा लागै इहअ बोल्दै, “इहअ किल्है आसा कि हाम्हैं अर फरीसी पंथे लोग करा एतरअ ब्रत, पर तेरै च़ेल्‍लै निं ब्रत करदै?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“ज़ेभै तैणीं लाल़अ बरातू संघै रहा, तेभै निं तिंयां ब्रत करदै। एक बगत एछणअ इहअ बी कि लाल़अ करनअ तिन्‍नां का ज़ुदअ अर तेभै करनअ तिन्‍नां ब्रत।”</char><verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />
    <char style="wj">“नऊंऐं झिकल़े शाट्टी निं पराणैं झिकल़ै दी कोहै लांदअ, ज़ै इहअ करे, झिकल़ै धोंदी बारी धेल़ा सह नऊंईं शाट्टी तेऊ पराणैं झिकल़ै होर बी खास्सअ।</char><verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />
    <char style="wj">“इहअ ई निं कोह मणछ नऊंअ दाखो रस पराणैं खाल्हल़ै दी डाहंदै। किल्हैकि इहअ करी फुटा तिंयां खाल्हल़ै, संघा हआ दाखो रस अर तिंयां खाल्हल़ै दुहै च़िज़ा ज़ांऐं। पर नऊंअ दाखो रस भरा नऊंऐं खाल्हल़ै दी ज़िहअ करै तिन्‍नां दुही गल्‍लो बच़ाअ हआ।”</char><verse eid="MAT 9:17" /></para>
  <para style="s">मूंईं दी शोहरी मरीज़ बेटल़ी</para>
  <para style="r">(<ref loc="MRK 5:21-43">मार्कुस 5:21-43</ref>; <ref loc="LUK 8:40-56">लूका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />ईशू त तिन्‍नां मणछा का इना गल्‍ला करदअ ई लागअ द कि तिधी आअ एक मणछ सह त यहूदी सभागृहो कारदार। तेऊ टेक्‍कअ ईशू सेटा माथअ। संघा बोलअ तेऊ ईशू लै इहअ, “हे प्रभू, मेरी शोहरी हुई एभै-एभै ज़ांऐं, पर तूह च़ाल्‍ल मेरै घअरा लै संघा छ़ुंह तूह तैहा आपणैं हाथा करै, तै जाणीं सह ज़िऊंदी हई।”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />ईशू उझ़ुअ तेभी संघा डेऊऐ सह अर तेऊए च़ेल्‍लै तेऊ संघै तेऊए घअरा लै। <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />बाता हांढदी आई एक बेटल़ी, तैहा थिई बारा साला ओर्ही लोहू बगणें बमारी लागी दी। सह आई पिछ़ू का संघा छ़ुंअ तैहा ईशूए झिकल़ैओ पाल्‍लअ।<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="MAT 14:36">मोत्त. 14:36</ref></char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />किल्हैकि सह सोठा ती आपणैं मन्‍नैं इहअ, “ज़ै हुंह ईशूए झिकल़े पाल्‍लै पुंझ़ बी छ़ुंहीं सके, तै जाणीं हुंह ऐहा बमारी का बिज़री।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />ईशू भाल़अ पिछ़ू फिरी तैहा बाखा लै संघा बोलअ तैहा लै, <char style="wj">“तूह निं डरै आथी, तंऐं किअ विश्वास कि हुंह सका ताह नरोगै करी अर मंऐं हेरी तूह एऊ रोगा का नरोगी करी।”</char> इहअ करै हुई सह बेटल़ी तेऊ रोगा का नरोगी।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />ईशू पुजअ यहूदी सभागृहे कारदारे घअरै, तिधी भाल़अ ईशू कि बशूरी बाज़णैं आल़ै आसा शोगे धुन बाज़दै लागै दै, तिधी झाल़्हुऐ दै लोग आसा लेरा लांदै लागै दै। ईशू बोलअ तिन्‍नां लै, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" /><char style="wj">“सोभ डेओआ बागै, शोहरी निं मूंईं आथी! अह आसा सुत्ती दी।”</char> ऐहा गल्‍ला शूणीं लागै तिंयां ईशू लै हास्सदै।<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />ज़िहै ई तिधी झाल़्हुऐ दै लोग बागा लै काढै, तेखअ डेऊअ ईशू पांडा भितरा लै ज़िधी शोहरी ती सताऊई डाही दी। ईशू ढाकअ तैहा शोहरीओ हाथ अर सह हुई तेभी ज़िऊंदी। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ऐहा गल्‍लो थोघ लागअ तेथ सारै मुल्खै।<verse eid="MAT 9:26" /></para>
  <para style="s">दूई कांणै मणछो विश्वास</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />ज़ांऊं ईशू तैहा शोहरीए घअरा का आजू डेऊअ, दूई कांणै मणछ आऐ तेऊ पिछ़ू एही हाक्‍का-पकारा लांदी, “हे दाबेदे लुआद ईशू, हाम्हां लै बी कर झींण!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />ज़ांऊं ईशू तेऊ घअरै पुजअ ज़िधी सह रहअ द थिअ, तिंयां दूई कांणै बी पुजै तिधी ईशू सेटा, ईशू पुछ़अ तिन्‍नां का, <char style="wj">“तम्हां कै इहअ विश्वास आसा कि हुंह सका तम्हां शरैछै करी?”</char></para>
  <para style="p" vid="MAT 9:28">तिन्‍नैं कांणै दैनअ ईशू लै ज़बाब, “हाँ प्रभू, हाम्हां आसा विश्वास कि तूह सका इहअ करी।”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />तेखअ बोलअ ईशू तिन्‍नें आछी छ़ुंहीं करै, “तम्हां लै लोल़ी तिहअ ई हुअ ज़िहअ तम्हैं विश्वास करा।”<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />तिन्‍नें आछी का लागअ तेभी शुझदअ। तेखअ दैनी ईशू तिन्‍नां लै एही चतैनगी, <char style="wj">“हेरे, धैन डाहै, ऐहा गल्‍ला निं तम्हैं कोही का खोज़ी।”</char> <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />पर तिधा का बागै डेऊई फणाऊंई तिन्‍नें ईंयां गल्‍ला सारै दी कई ज़ैगा! कि ईशू तिंयां किहै किऐ आछी का शरैछै।<verse eid="MAT 9:31" /></para>
  <para style="s">एक काल्‍लअ ठीक करनअ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />ज़ांऊं तिंयां दूई मणछ नरोगै हई बागै तै डेऊंदै लागै दै, तिधी आणअ लोगै ईशू सेटा लै एक काल्‍लअ मणछ। तेऊ दी त भूत शाचअ द। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ज़ांऊं तेऊ काल्‍लै का भूत पोर्ही निखल़अ, सह काल्‍लअ लागअ गल्‍ला करदअ, अर तिधी सोभ लोग हुऐ रहैन कि इहअ च़मत्कार निं एऊ इज़राईल देशै आझ़ तैणीं कधि भाल़अ।<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />पर तिधी फरीसी तै आऐ दै, तिन्‍नैं बोलअ इहअ, “अह काढा भूते राज़ै राख्से शगती करै भूत।”<verse eid="MAT 9:34" /></para>
  <para style="s">लऊंदै आसा थोल़ै</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />ईशू रहअ कई नगरी अर गराऊंऐं डेऊई तिन्‍नें सभागृहा शिक्षा दैंदी, स्वर्ग राज़े खुशीए समादा खोज़दअ लागी अर सोभी रंगे दाह-खिज़ा का तिन्‍नां नरोगै करदअ लागी।<verse eid="MAT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 9:36" />ज़ांऊं ईशू खास्सै मणछ भाल़ै, तेऊ फिरी तिन्‍नां लै खास्सी झींण, किल्हैकि तिंयां थिऐ एही बेचैन अर कबाता पेठी दी भेडा ज़िहै, ज़सरअ कोई फुआल निं आथी।<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="1KI 22:17">1 राज़. 22:17</ref></char></note><verse eid="MAT 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 9:37" />तेखअ बोलअ तेऊ आपणैं च़ेल्‍लै लै, <char style="wj">“मुंह दी विश्वास करना लै आसा खास्सै मणछ न्हैल़ै लागै दै पर तिन्‍नां सेटा खुशीए समादा पजैल़णैं आल़ै आसा थोल़ै। तिंयां आसा एही खास्सी फसला ज़िहै ज़ुंण लऊंणा लै गई हई पर लऊंणै आल़ै आसा थोल़ै।</char> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" /><char style="wj">एता लै करा खेचे मालका का अरज़ कि होर मज़दूर छ़ाड।”</char><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">ईशूए बारा खास च़ेल्‍लै</para>
  <para style="r">(<ref loc="MRK 3:13-19">मार्कुस 3:13-19</ref>; <ref loc="LUK 6:12-16">लूका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ईशू शादै आपणैं बारा च़ेल्‍लै आप्पू सेटा संघा दैनअ तिन्‍नां लै भूता काढणेंओ हक अर बल, ताकि तिन्‍नां लोगे हर रोग अर दाह-खिज़ा दूर करी तिन्‍नां नरोगै करे। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />तिन्‍नां बारा शधाणूं नाअं तै इहै:</para>
  <para style="p" vid="MAT 10:2">शमौन ज़हा लै पतरास बोला, पतरासो भाऊ आन्दरू, जबदीओ शोहरू याकब, अर याकबो भाऊ जोहन्‍ना,<verse eid="MAT 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 10:3" />फलिप्प, बरतुलमी, थोमा, कारै गराहणै आल़अ मोत्ती, हलफीओ शोहरू याकब, तेदैई,<verse eid="MAT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 10:4" />शमौन कनानी अर करेती गराऊंओ यहूदा ज़ुंणी ईशू लै छ़ल़ किअ त।<verse eid="MAT 10:4" /></para>
  <para style="s">बारा शधाणूंए च़ाकरी</para>
  <para style="r">(<ref loc="MRK 6:7-13">मार्कुस 6:7-13</ref>; <ref loc="LUK 9:1-6">लूका 9:1-6</ref>; <ref loc="LUK 10:4-12">10:4-12</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ईंयां बारा च़ेल्‍लै छ़ाडै ईशू इहअ खोज़ी बोली, <char style="wj">“यहूदी छ़ाडी होरी ज़ातीए लोगा सेटा निं डेऊई अर सामरी नगरी बी निं डेऊई।<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">जेर. 50:6</char></note></char> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><char style="wj">इज़राईली सेटा डेओऐ। तिंयां आसा एही भेडा ज़िहै ज़ुंण आपणैं फुआल परमेशरा का दूर आसा हुई दी।</char><verse eid="MAT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 10:7" />
    <char style="wj">“बाता हांढदी करै इहअ प्रच़ार कि स्वर्गो राज़ गअ नेल़ एछी।</char> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><char style="wj">रोगी मणछा करै नरोगै, मूंऐं दै करै भिई ज़िऊंदै, कोहल़ निखल़ै दै मणछा करै शुचै अर भूता काढै दूर। तम्हैं दैऐ इना मुफ्त ज़िहअ तम्हां मुफ्त आसा भेटअ द।</char><verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />
    <char style="wj">“आपणैं थैल्‍लू दी निं सुन्‍नअ-च़ंदी अर चाम्बअ डाही।</char> <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><char style="wj">बाता हांढणा लै नां झ़ोल़ी डाही, नां दूई कुर्तै डाही, नां पोलल़े ज़ोल़ी, नां हाथै शोठअ। किल्हैकि मज़दूरा लोल़ी तेऊए मज़दूरी भेटी।</char><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />
    <char style="wj">“ज़हा बी नगरी अर गराऊंऐं तम्हैं डेओए, ऐहा गल्‍लो थोघ लणअ पैहलै करी कि तम्हां लै रहणैं जोगी घअर कुंण आसा। ज़ेभै तैणीं तम्हैं तिधा का नांईं निखल़े तेभै तैणीं रहै तम्हैं तिधी।</char> <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" /><char style="wj">घअरा भितरी डेऊंदी दैऐ तम्हैं तेऊ घअरा लै बर्गत।</char> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" /><char style="wj">ज़ै तेऊ घअरे लोग थारी बर्गता जोगी होए, तै जाणीं तिन्‍नां लै बर्गत हई।</char></para>
  <para style="p" vid="MAT 10:13">
    <char style="wj">“पर ज़ै तिंयां तेता जोगी नांईं होए, तै दैऐ तैहा बर्गता बापस फिरनैं।</char> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><char style="wj">तेखअ ज़ुंण तम्हां नांईं मने अर थारी गल्‍ला नांईं शुणें, तेऊ घअरा या तैहा नगरी का निखल़दी बारी ठुल़्हकै आपणैं खूरा का धूल़अ बी पोर्ही कि अह गल्‍ल हणीं तिन्‍नें शाजत ज़ेभै परमेशरा तिन्‍नों नसाफ करनअ।</char><verse eid="MAT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 10:15" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ेभै परमेशरा सोभिओ नसाफ करनअ, तेभै दैणीं तेऊ सदोम अर अमोरा नगरीए पापी मणछा लै सज़ा। पर ज़ुंण लोग तम्हां नांईं मने, तेऊ मुल्खे लोगे हणीं तेता का बी खास्सी बूरी दशा।</char><verse eid="MAT 10:15" /></para>
  <para style="s">आजू हणीं खास्सी खरी</para>
  <para style="r">(<ref loc="MRK 13:9-13">मार्कुस 13:9-13</ref>; <ref loc="LUK 21:12-17">लूका 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <char style="wj">“हेरा, मंऐं लाऐ तम्हैं भेडा ज़िहै धेल़णै-च़िरनैं आल़ै रुहले छ़ुंढा जैंदरी छ़ाडी। तम्हैं रहै दानुईं ज़िहै च़लाक अर पालल़ी ज़िहै भोल़ै।</char><verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />
    <char style="wj">“पर लोगा का रहै बच़दै। किल्हैकि तिन्‍नां निंणै तम्हैं कैद करी दालता लै अर आपणीं सभागृहा च़िक्‍कणै तम्हैं कोल़ै करै।</char> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><char style="wj">मुंह दी विश्वास करनै पिछ़ू निंणै तम्हैं कैद करी राज़पाल अर राज़ै सेटा, अह हणअ तम्हां लै मोक्‍कअ कि तिन्‍नां अर होरी ज़ाती का मेरै बारै शाजत दैई सके।</char> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" /><char style="wj">ज़ेभै तिंयां तम्हां कैद करी दालता दी निंए, तेभै निं तम्हैं एही फिकर करी कि हाम्हां किहअ करै बोल़णअ अर किज़ै बोल़णअ?</char></para>
  <para style="p" vid="MAT 10:19">
    <char style="wj">“ज़ुंण बी तम्हां तिधी बोल़णअ होए, सह हेरनअ तम्हां लै परमेशरा तैहा ई घल़ी खोज़ी।</char> <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" /><char style="wj">किल्हैकि बोल़णैं आल़ै निं तम्हैं आथी, पर थारअ बाब परमेशरे पबित्र आत्मां बोला तम्हां बाती आप्पै।</char><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <char style="wj">“तेभै हणअ इहअ कि लोगा बझ़ैल़णअ मुंह दी विश्वास करनै आल़अ आपणअ ई सक्‍कअ भाई होरी का मारनै, बाबा बझ़ैल़णअ आपणअ ई शोहरू मारनै ज़ुंण, शोहरू-शोहरी हणैं आपणैं ईजा-बाबे खलाफ ज़ुंण मुंह दी विश्वास करा, संघा बझ़ैल़णैं तिंयां होरी लोगा का मारनै।<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false">मिक. 7:6; मार्क. 13:12; लूक. 21:16 </char></note></char><verse eid="MAT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 10:22" />
    <char style="wj">“मेरै नाओंआं करै हणैं सोभ लोग थारै दुशमण, पर ज़ुंण खिरी तैणीं सबर करे, तेऊओ हणअ उद्धार<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">मोत्त. 24:9; मार्क. 13:13; लूक. 21:17 </char></note>।</char> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" /><char style="wj">ज़ेभै तिंयां कहा नगरी तम्हां तंग करे, तम्हैं ठुर्है दुजी नगरी लै। हुंह खोज़ा तम्हां का सत्त कि तम्हैं निं इज़राईले सोभी नगरी हांढी मुक्‍कणैं कि तेभै तैणीं जाणअ हुंह मणछो पूत एछी।</char><verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <char style="wj">“च़ेल्‍लअ निं आपणैं गूरू का बडअ हंदअ अर नां दास आपणैं मालक का बडअ हंदअ।</char> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><char style="wj">च़ेल्‍लेओ गूरू अर दासो मालका बराबर हणअ आसा बेघै बडी गल्‍ल। ज़ै तिन्‍नैं घअरे मालका लै राख्स बोलअ, तै तिन्‍नां तेऊए घअरा आल़ै लै किल्है निं बोल़णअ?</char><verse eid="MAT 10:25" /></para>
  <para style="s">कहा का डरनअ?</para>
  <para style="r">(<ref loc="LUK 12:2-7">लूका 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <char style="wj">“पर तम्हैं निं तिन्‍नां का डरी, इहअ बगत एछणअ ज़ेभै ढोपी डाही दी हर च़ीज़ सोभी का शुझणीं अर गुप्त च़िज़ो लागणअ सोभी का थोघ।</char> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" /><char style="wj">ज़ुंण हुंह तम्हां लै पिठी पिछ़ू बोला, तेऊ बोलै तम्हैं सोभी नदरी अर ज़ुंण तम्हैं काना पिछ़ू शूणां, तेता खोज़ै तम्हैं छ़ाप्परै उखल़ी हाक्‍का पाई।</char><verse eid="MAT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 10:28" />
    <char style="wj">“तम्हैं निं तिन्‍नां का डरी आथी ज़ुंण थारी देही च़ाहा मारनअ, तिंयां निं थारी आत्मां मारी सकदै। पर डरनअ सिधअ तेऊ परमेशरा का ज़ुंण देही अर आत्मां दुही सका जम्परी खतम करी।</char><verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />
    <char style="wj">“मणछ बेच़ा दूई च़ेल्‍ली सिधै एकी चाम्बे ढब्बै करै! पर थारअ बाब परमेशरा हआ तिन्‍नां होछ़ी च़ेल्‍लीओ तोही धैन-खैल। तिन्‍नां च़ेल्‍ली मांझ़ै निं तेभै तैणीं एक बी धरनीं पल़दी ज़ेभै तैणीं कि परमेशर आप्पै इहअ हणैं निं दैए।</char> <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" /><char style="wj">इधी तैणीं कि परमेशरै आसा थारै मुंडे शराल़ बी सोभ गणै दै।<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false">लूक. 12:7</char></note></char> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><char style="wj">तैही बोला हुंह डरी निं आथी, तम्हैं आसा तिन्‍नां च़ेल्‍ली का खास्सै किम्मती।</char><verse eid="MAT 10:31" /></para>
  <para style="s">ईशू मनणअ कि नांईं मनणअ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />
    <char style="wj">“हुंह बोला तम्हां का कि ज़ुंण मुंह मणछे सम्हनै मने, सह मनणअ मुंह स्वर्गै आपणैं बाब परमेशरे सम्हनै।</char> <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><char style="wj">पर ज़ुंण होरी मणछा सेटा मेरै बारै हुधिए, तेऊ लै हुधणअ मुंह बी स्वर्गै आपणैं बाब परमेशरा सेटा।</char><verse eid="MAT 10:33" /></para>
  <para style="s">ईशूए पृथूई, एछणेंओ असर</para>
  <para style="r">(<ref loc="LUK 12:51-53">लूका 12:51-53</ref>; <ref loc="LUK 14:26">14:26</ref>,<ref loc="LUK 14:27">27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />
    <char style="wj">“इहअ निं समझ़ा कि हुंह आसा पृथूई दी मेल़-ज़ोल़ करदअ आअ द, हुंह निं मेल़-ज़ोल़ करदअ आथी पर तिन्‍नां मांझ़ै ज़ुंण मुंह पिछ़ू एछे तिंयां करनै मुंह ज़ुदै।</char><verse eid="MAT 10:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="MAT 10:35" />
    <char style="wj">‘हुंह आसा एता लै आअ द कि शोहरू तेऊए बाबा का,</char></para>
  <para style="q" vid="MAT 10:35">
    <char style="wj">शोहरी तेसे ईजा का, </char></para>
  <para style="q" vid="MAT 10:35">
    <char style="wj">नुशा तेसे शाशुई का ज़ुदी करूं।</char><verse eid="MAT 10:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="MAT 10:36" />
    <char style="wj">मणछे दुशमण हणैं तेऊए ई टबरा मांझ़ै।’</char><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />
    <char style="wj">“ज़ुंण आपणैं ईजा-बाबा लै मुखा खास्सी झ़ूरी करा, सह निं मुंह जोगी आथी। ज़ुंण आपणैं लान्हैं लै मुखा खास्सी झ़ूरी डाहा, सह बी निं मुंह जोगी आथी।<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false">लूक. 14:26</char></note></char> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><char style="wj">ज़ुंण असली दी मेरअ च़ेल्‍लअ बणनअ च़ाहा, सह रहै मुल्है मरना लै तैर। सह ज़िऊऐ इहै मणछा ज़िहअ ज़ुंण आपणअ क्रूस आपणीं कान्हा च़की मर्दअ आसा च़ाल्‍लअ द।</char> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><char style="wj">किल्हैकि ज़ुंण बी ऐहा पृथूई दी आपणीं ज़िन्दगी बच़ाऊंणी च़ाहे, सह करा परमेशरा संघै सदा रहणैं आल़ी ज़िन्दगी ज़ांऐं, ज़ुंण मुंह दी विश्वास करनै पिछ़ू आपणीं ज़ान दैए, तेऊ भेटणीं परमेशरा संघै सदा लै ज़िन्दगी।</char><verse eid="MAT 10:39" /></para>
  <para style="s">ज़िहअ कर्म तिहअ फल</para>
  <para style="r">(<ref loc="MRK 9:41">मार्कुस 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <char style="wj">“ज़ुंण थारी कदर करे सह करा मेरी कदर। ज़ुंण मेरी कदर करा, सह करा तेऊए कदर ज़ुंणी हुंह संसारा लै आसा छ़ाडअ द।</char> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" /><char style="wj">परमेशरे गूरा ज़ुंण परमेशरो गूर समझ़ी अदर करे तेऊ भेटणअ तेतो तिहअ ई फल।</char></para>
  <para style="p" vid="MAT 10:41">
    <char style="wj">“ज़ुंण धर्मीं समझ़ी धर्मीं मणछो अदर करे, तेऊ भेटणअ धर्मीं मणछो फल।</char> <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><char style="wj">ज़ुंण बी इना होछ़ै मांझ़ै एकी बी मेरै च़ेल्‍लै समझ़ी एक गलास पाणींओ बी पणैऊंए, हुंह खोज़ा तम्हां का सत्त कि तेऊ भेटणअ परमेशरा का तेतो फल।”</char><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">ईशू अर जोहन्‍ना डुबकी दैणैं आल़अ</para>
  <para style="r">(<ref loc="LUK 7:18-35">लूका 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />ज़ांऊं ईशू आपणैं बारा च़ेल्‍लै का खोज़ी-बोली मुक्‍कअ, तेखअ डेऊअ सह यहूदीए नगरी लै शिक्षा दैंदअ अर प्रच़ार करदअ।<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />तिन्‍नां धैल़ै त जोहन्‍ना डुबकी दैणैं आल़अ कैद किअ द। तेऊ शूणअ मसीहे कामों समाद अर तेऊ छ़ाडै आपणैं च़ेल्‍लै ईशू सेटा इहअ पुछ़दै, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“ज़ुंण सह एछणैं आल़अ थिअ, सह मसीहा तूह ई आसा कि अज़ी हाम्हैं कहा होरी न्हैल़ै रहूंमै लागी?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“ज़ुंण बी तम्हैं भाल़अ अर शूणअ, तिन्‍नां गल्‍ला खोज़ा जोहन्‍ना का कि</char> <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><char style="wj">कांणै लागै भाल़ै, लाट्टै लागै हांढदै-फिरदै, कोहल़ी हुऐ शुचै, टौणैं लागै शूणैं, मुल्दै लागै ज़िऊंदै हंदै अर रैनै-गरीबा का खोज़ा खुशीओ समाद।</char> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><char style="wj">परमेशरा दैणीं तेऊ लै बर्गत ज़ुंण मुल्है बैहम निं करदअ।”</char><verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />ज़ांऊं जोहन्‍ना छ़ाडै दै दूत फिरी डेऊऐ, ईशू बोलअ तिधी झाल़्हुऐ दै लोगा का जोहन्‍ने बारै इहअ, <char style="wj">“तम्हैं उज़र रेगीस्तानै जोहन्‍ना सेटा किज़ू भाल़ै डेऊऐ तै? बागरी करै च़ुक्‍कदी नगाल़ै ज़िहै मणछा भाल़ै ज़ुंण आपणीं गल्‍ला तेभा-तेभी बदल़ा?</char> <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" /><char style="wj">तै किज़ू भाल़ै डेऊऐ तै तम्हैं? भाल़ा, तम्हां का आसा राम्बल़ै करै थोघ ज़ुंण नरम किम्मती झिकल़ै बान्हां, तिंयां रहा राज़ मैहलै।</char> <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><char style="wj">तै किज़ू भाल़ै डेऊऐ तै तम्हैं? कहा परमेशरे गूरा भाल़ै? हाँ, हुंह खोज़ा तम्हां का सत्त कि ज़हा भाल़ै तम्हैं डेऊऐ, सह आसा परमेशरे गूरा का बी बडअ।</char><verse eid="MAT 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 11:10" />
    <char style="wj">
      <note caller="+" style="f">
        <char style="fr" closed="false">11:10 </char>
        <char style="ft" closed="false">मला. 3:1</char>
      </note>“अह आसा सह ई ज़सरै बारै पबित्र शास्त्रा दी इहअ आसा लिखअ द, </char></para>
  <para style="q" vid="MAT 11:10">
    <char style="wj">‘भाल़, मंऐं छ़ाडअ आपणअ दूत ताह आजू-आजू, </char></para>
  <para style="q" vid="MAT 11:10">
    <char style="wj">ताकि सह तेरै एछणें धैल़ी लै ताल्है लोगा तैरी डाहे।’</char><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ेतरै मणछ आझ़ तैणीं हुऐ, तिन्‍नां मांझ़ै निं जोहन्‍ना डुबकी दैणैं आल़ै का बडअ कोहै आथी। पर ज़ुंण स्वर्ग राज़ा दी सोभी का होछ़अ आसा, सह आसा जोहन्‍ना का बडअ।</char><verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />
    <char style="wj">“जोहन्‍ना डुबकी दैणैं आल़ेए ज़मानैं ओर्ही एभै तैणीं दैनअ स्वर्ग राज़ा दी डेऊणा लै खास्सअ ज़ोर। पर जोधै मणछ चुटा तेता छ़ड़ैऊंदै।</char> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="wj">जोहन्‍ना तैणीं रहै परमेशरे सारै गूर अर बधान आजू हणैं आल़ी गल्‍ला प्रगट करदै लागी।</char><verse eid="MAT 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 11:14" />
    <char style="wj">“तम्हैं मना च़ाऐ नां मना, अह जोहन्‍ना आसा सह एलियाह ज़सरै बारै परमेशरे गूरै आसा बोलअ द कि सह एछणअ।<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">मला. 4:5</char></note></char> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" /><char style="wj">ज़ै तम्हैं एता समझ़णअ च़ाहा, तै दैऐ ऐहा गल्‍ला दी धैन कि मंऐं एभै तम्हां का किज़ै बोलअ।</char><verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />
    <char style="wj">“एऊ जुगे लोगा हुंह किहै खोज़ूं कि किहै आसा? तिंयां आसा तिन्‍नां लान्हैं ज़िहै ज़ुंण बज़ारै बेशी एकी-दुजै लै हाक्‍का लाई इहअ बोला</char><verse eid="MAT 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MAT 11:17" />
    <char style="wj">‘हाम्हैं बाज़ी तम्हां लै बशूरी </char></para>
  <para style="q" vid="MAT 11:17">
    <char style="wj">अर तम्हैं निं नाच़ै, </char></para>
  <para style="q" vid="MAT 11:17">
    <char style="wj">हाम्हैं किअ हिक्‍का पटाक्‍की शोग</char></para>
  <para style="q" vid="MAT 11:17">
    <char style="wj">पर तम्हैं निं लेरै।’</char><verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />
    <char style="wj">“किल्हैकि जोहन्‍ना डुबकी दैणैं आल़ै नां होरी मणछा ज़ेही भांती-भांतीए रोटी खाई अर नां दाखो रस झुटअ अर तम्हैं बोलअ इहअ कि तेऊ दी आसा भूत!</char><verse eid="MAT 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 11:19" />
    <char style="wj">“हुंह मणछो पूत आअ खांदी-पिंदी। तिंयां बोला इहअ, ‘भाल़ा, छ़ाकू अर खास्सअ झुटणैं आल़अ। कारै मांगणै आल़ै अर पापी मणछो साथी।’ पर तेऊओ थोघ लागा तेऊए कामां करै कि सह केतरअ सिध्द आसा।”</char><verse eid="MAT 11:19" /></para>
  <para style="s">विश्वास नांईं करनै आल़ै लै आफ़त</para>
  <para style="r">(<ref loc="LUK 10:13-15">लूका 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />तेखअ बोलअ ईशू तिन्‍नां नगरीए लोगे बारै ज़ेथ तेऊ खास्सै च़मत्कारे काम किऐ तै। किल्हैकि तिंयां निं अज़ी बी आपणैं प्राश्त करी पाप करनअ छ़ाडअ।<verse eid="MAT 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 11:21" />
    <char style="wj">“खुराजीन अर बैतसैदा नगरीए लोगो! तम्हां लै आसा आफ़त! ज़ुंण महान काम अर च़मत्कार तम्हां जैंदरी किऐ, ज़ै तिंयां काम सूर अर सैदा नगरीए होरी ज़ातीए लोगा मांझ़ै किऐ हंदै, तिन्‍नां करनअ त घेरी खिंथल़ै बान्हीं अर टाट पल़ेटी प्राश्त।</char><verse eid="MAT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 11:22" />
    <char style="wj">“पर हुंह खोज़ा तम्हां का सत्त कि ज़ेभै परमेशरा सोभिओ नसाफ करनअ, तेभै दैणीं तेऊ सूर अर सैदा नगरीए पापी मणछा लै सज़ा। पर थारी हणीं तिन्‍नां का बी खास्सी बूरी दशा।</char><verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />
    <char style="wj">“हे कफरनहूम नगरीए मणछो, तम्हैं निं इहअ सोठा कि थारअ हणअ स्वर्गै होरी लोगा का खास्सअ अदर? पर तम्हैं डेऊणैं उंधै जम्परी लै ज़िधी तम्हां सज़ा भेटणीं। ज़ुंण नछ़ैण अर च़मत्कार तम्हां सेटा आसा किऐ दै, ज़ै तिंयां सदोम नगरी दी किऐ हंदै, सह नगरी रहणीं ती आझ़ तैणीं बच़ी।</char><verse eid="MAT 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 11:24" />
    <char style="wj">“पर हुंह खोज़ा तम्हां का सत्त ज़ेभै परमेशरा सोभिओ नसाफ करनअ तेभै दैणीं तेऊ सदोम अर अमोरा नगरीए पापी मणछा लै सज़ा। पर तेरी हणीं तेता का बी खास्सी बूरी दशा।”</char><verse eid="MAT 11:24" /></para>
  <para style="s">बोझ़ा दी दाभूऐ दै लोगा लै राम</para>
  <para style="r">(<ref loc="LUK 10:21">लूका 10:21</ref>,<ref loc="LUK 10:22">22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />तेखअ बोलअ तेभी ईशू, <char style="wj">“हे मेरै बाब परमेशर, स्वर्ग अर पृथूईए मालक। हुंह करा तेरअ शूकर कि तंऐं डाही ईंयां गल्‍ला ज्ञैनी अर समझ़कार मणछा का गुप्त अर तंऐं खोज़ी ईंयां इना लान्हैं का।</char> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" /><char style="wj">हाँ मेरै बाब, किल्हैकि ताह भाऊंआ इहअ ई।</char><verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <char style="wj">“मेरै बाब परमेशरै आसा मुखा सोभ गल्‍ला सभाल़ी दी। पूता निं बाबा का सुआई कोहै बछ़ैणदअ। बाबा बी निं पूता का सुआई कोह बछ़ैणदअ, तिंयां बी हेरा तेऊ बछ़ैणीं ज़हा का पूत खोज़ै।”</char><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />
    <char style="wj">“तम्हैं सोभै एछा मुंह सेटा लै ज़ुंण शास्त्री अर सैणैं खोज़ै दै बधाना मनणे भरपूर कोशिश करा, ज़ुंण तम्हां प्रैंदै बोझ़ आसा हुंह दैंऊं तम्हां लै तिन्‍नां सोभी गल्‍ला का बशैघ।</char><verse eid="MAT 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 11:29" />
    <char style="wj">“मेरअ जूँ जोचा आपणैं कैल़ै, संघा शिखल़ा मुखा सत्त। हुंह आसा झणैल़ू अर मानदार। मुंह करनी थारी मज़त, तेखअ भेटणीं थारै शाह शांती।</char> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" /><char style="wj">किल्हैकि मेरअ जूँ आसा सान अर ज़ुंण मुंह तम्हां लै बोल़णअ सह करनअ निं तम्हां लै कठण हणअ।”</char><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">बशैघे धैल़ीओ मालक</para>
  <para style="r">(<ref loc="MRK 2:23-28">मार्कुस 2:23-28</ref>; <ref loc="LUK 6:1-5">लूका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />थोल़ै धैल़ै बाद डेऊअ ईशू किधा लै नाज़े खेचा बाती, सह ती यहूदीए बशैघे धैल़ी। तेऊए च़ेल्‍लै ती भुखै आई दी। तिंयां लागै कणके सील चोल़ी अर हाथै मरोक्‍की करै खांदै। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />तिन्‍नां च़ेल्‍लै इहअ करदै भाल़ी बोलअ फरीसी मणछै ईशू लै, “भाल़, तेरै च़ेल्‍लै आसा बशैघे धैल़ी इहै कामां करदै लागै दै ज़ुंण बधाने साबै ऐहा धैल़ी करनअ ठीक निं आथी।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं कै कधू इहअ निं पहल़अ कि ज़धू दाबेद राज़ै ज़रुरत पल़ी अर ज़ांऊं सह अर तेऊए साथी भुखै थिऐ, तेभै तेऊ किज़ै किअ?</char> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><char style="wj">सह किल्है डेऊअ परमेशरे भबना भितरी? अर तेऊ किल्है खाअ परमेशरे बेदी दी छ़ाडअ द भोज़न? अर आपणैं साथी लै बी दैनअ! ज़ेता बधाने साबै प्रोहता का सुआई होर कोह निं खाई सकदअ त?</char><verse eid="MAT 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 12:5" />
    <char style="wj">“इहअ बी हणअ तम्हां का थोघ कि प्रोहत करा हर बशैघे धैल़ी परमेशरे भबनै काम, इहअ करै चोल़ा तिंयां बशैघे धैल़ीओ बधान, पर तज़ी बी आसा तिंयां बधाने साबै नर्दोश।<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">गण. 28:9-10; जोह. 7:22-23</char></note></char> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" /><char style="wj">पर हुंह खोज़ा तम्हां का सत्त कि इधी आसा सह, ज़हा का परमेशरे भबना का बी ज़ादअ हक आसा!</char><verse eid="MAT 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 12:7" />
    <char style="wj">“ज़ै तम्हैं पबित्र शास्त्रे ऐहा गल्‍ला समझ़दै, ‘हुंह निं थारै डागै-चैणैंओ अर बल़ीदान च़ाहंदअ, हुंह च़ाहा इहअ कि तम्हैं झींण करे।’ तै निं तम्हैं मेरै इना नर्दोश च़ेल्‍लै दोश लाणअ त।<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">होश. 6:6</char></note></char> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" /><char style="wj">हुंह मणछो पूत आसा बशैघे धैल़ीओ बी मालक।”</char><note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">मार्क. 2:28</char></note><verse eid="MAT 12:8" /></para>
  <para style="s">मछैंऐं दै हाथो मणछ किअ नरोगअ</para>
  <para style="r">(<ref loc="MRK 3:1-6">मार्कुस 3:1-6</ref>; <ref loc="LUK 6:6-11">लूका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />ज़ांऊं ईशू तिधा का डेऊअ, तेखअ पुजअ सह यहूदी सभागृहा। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />तिधी थिअ एक मणछ इहअ, तेऊओ हाथ त मछैंअ द। फरीसी मांझ़ै पुछ़अ कुंणी ईशू का सुआल, “बशैघे धैल़ी कै अह मणछ नरोगअ करना भलअ आसा?” तिंयां तै एही ताका कि ईशूए किज़ै गलती भेटे अर तेऊ लै दोश लाई सके कि सह आसा बधाने साबै गलत करदअ लागअ द।<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />तेखअ पुछ़अ ईशू तिन्‍नां का, <char style="wj">“तम्हां मांझ़ै इहअ कुंण आसा कि ज़हा का एक्‍कै भेड़ होए अर बशैघे धैल़ी पल़े सह भेड़ डुघी खाल़्ही दी अर सह तैहा भेडा बशैघे धैल़ी उझै नांईं काढे?</char> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><char style="wj">इहअ ता हणअ तम्हां का थोघ कि मणछो मोल आसा भेडा का खास्सअ! इहअ करै आसा बशैघे धैल़ी रोगी मणछ नरोगअ करनअ बधाने साबै भलअ।”</char><verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />तेखअ बोलअ ईशू तेऊ मणछा लै, <char style="wj">“आपणअ हाथ कर आजू।”</char> तेऊ किअ आपणअ हाथ ईशू सेटा आजू अर सह हाथ हुअ दुजै हाथा ज़िहअ ताज़अ-नरोगअ। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />तेखअ किअ फरीसी पंथे तिन्‍नैं मणछै तिधा बागै डेऊई इहअ एक्‍कअ कि हाम्हां पाणअ त अह किहअ करै मारी।<verse eid="MAT 12:14" /></para>
  <para style="s">परमेशरो छ़ांटअ द दास</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ईशू हेरी अह गल्‍ल भुझ़ी संघा लागअ तिधा का हांढदअ। खास्सै मणछ लागै तेऊ पिछ़ू हांढदै। ईशू किऐ तिंयां सोभ दाह-खिज़ा का नरोगै। <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ईशू बोलअ तिन्‍नां भूता लै चतैनगी दैई इहअ, “मेरै बारै निं कोही का खोज़ी कि हुंह कुंण आसा, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ताकि ज़ुंण बैण ईशायाह गूरा बाती परमेशरै बोलअ त, सह पूरअ होए,<verse eid="MAT 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18" />‘भाल़ा, अह आसा मेरअ दास ज़ुंण मंऐं छ़ांटअ द आसा,</para>
  <para style="q" vid="MAT 12:18">अह आसा सह ज़हा लै हुंह झ़ूरा अर ज़हा करै हुंह खुश आसा।</para>
  <para style="q" vid="MAT 12:18">मुंह पाणीं आपणीं आत्मां एऊ दी</para>
  <para style="q" vid="MAT 12:18">अर तेऊ दैणअ होरी ज़ातीए सोभी लोगा लै नसाफ हणैंओ समाद।<verse eid="MAT 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19" />तेऊ नां झांशा काढणीं, अर नां लोगा संघै हठल़दै लागणअ,</para>
  <para style="q" vid="MAT 12:19">अर नां तेऊ च़फै का ज़ोरै-ज़ोरै बोल्दअ शुण्हनअ।<verse eid="MAT 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20" />तेऊ करनी जैंटी दी नगाल़ै ज़िहै दुबल़ै मणछा लै झींण।</para>
  <para style="q" vid="MAT 12:20">तेऊ निं हिठदी धूँआं दैंदी बाती ज़िहै खरी दी पल़ै दै मणछा मरनै दैंदअ,</para>
  <para style="q" vid="MAT 12:20">तेऊ बणाणैं नसाफ करी तिंयां नर्दोश<verse eid="MAT 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="MAT 12:21" />अर होरी ज़ातीए सोभी लोगा डाहणीं</para>
  <para style="q" vid="MAT 12:21">तेऊ दी आशा।’”<verse eid="MAT 12:21" /></para>
  <para style="s">ईशू अर भूतो राज़अ</para>
  <para style="r">(<ref loc="MRK 3:20-30">मार्कुस 3:20-30</ref>; <ref loc="LUK 11:14-23">लूका 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तेखअ आणअ तिधी लोगै एक मणछ, सह थिअ कांणअ बी अर काल्‍लअ बी। तेऊ दी त भूत शाचअ द। ईशू किअ सह नरोगअ अर सह लागअ तेभी भाल़अ अर गल्‍ला करदअ। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />एता लै हुऐ सोभ लोग रहैन अर तिंयां लागै बोल्दै, “अह कै राज़ै दाबेदे लुआद आसा?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />पर फरीसी पंथे लोगै बोलअ ऐहा गल्‍ला शूणीं ईशू लै इहअ, “अह काढा भूते राज़ै राख्से शगती करै भूत।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />ईशू बोलअ तिन्‍नें मन्‍नें गल्‍ल भुझ़ी करै तिन्‍नां लै, <char style="wj">“ज़हा राज़ा दी फूट पल़ा, सह हआ खतम, अर ज़हा नगरी अर टबरा जैंदरी फूट पल़ा, तिन्‍नों हआ बनाश।</char> <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="wj">इहअ करै ज़ै राख्स ई राख्सा काढे, तै हणअ सह इहअ करै आपणअ ई दुशमण। तेखअ तेऊओ राज़ किहअ करै रहणअ बणी?</char><verse eid="MAT 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 12:27" />
    <char style="wj">“ज़ै अह तम्हैं मुल्है इहअ बोला कि हुंह काढा राख्सा करै इना भूता दूर। तै हुई अह गल्‍ल बी शुची कि थारै च़ेल्‍लै बी काढा भूत राख्से शगती करै! मुखा बी आसा इहअ थोघ कि अह गल्‍ल आसा गलत! ऐहा गल्‍लो नसाफ हेरअ तिन्‍नैं करी कि तम्हैं बोला झ़ुठी गल्‍ला।</char><verse eid="MAT 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 12:28" />
    <char style="wj">“पर ज़ै हुंह परमेशरे आत्मां करै भूत काढा, तै गअ परमेशरो राज़ तम्हां सेटा पुजी।</char> <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" /><char style="wj">कोहै मणछ निं दैंत्तर जोधै मणछे घअरै पेशी करै तेऊओ धन तेभै तैणीं लुटी सकदअ, ज़ेभै तैणीं किई सह तेऊ जोधै मणछा बान्हीं नां लऐ, अर तेखअ सका सह तेऊओ धन लुटी।</char><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <char style="wj">“ज़ुंण मुंह संघै नांईं आथी, सह आसा मेरै खलाफ। ज़ुंण मुंह संघै परमेशरे राज़ा लै मणछा नांईं झाल़दअ सह डाहा तिन्‍नां छिंगी।</char><verse eid="MAT 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />
    <char style="wj">“तैही खोज़ा हुंह तम्हां का सत्त, ‘मणछो सोभी रंगो पाप अर निंदा हणैं माफ, पर पबित्र आत्में निंदा करनी निं माफ हणीं।’</char> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><char style="wj">ज़ुंण बी मुंह मणछे पूते खलाफ कोई गल्‍ला करे, तेऊओ पाप सका माफ हई, पर ज़ुंण बी पबित्र आत्में खलाफ किज़ै बोले, तेऊओ ज़ुल्म एऊ संसारै ता कै च़ाल्‍लअ माफ हई पर आजू एछणैं आल़ै संसारै बी निं सह माफ हणअ।</char><verse eid="MAT 12:32" /></para>
  <para style="s">बूट अर तेतो फल़</para>
  <para style="r">(<ref loc="LUK 6:43-45">लूका 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <char style="wj">“ज़ै बूट राम्बल़अ होए, तै हणैं तेते फल़ बी राम्बल़ै। ज़ै होए बूट निक्‍कअ तै हणैं तेते फल़ बी निक्‍कै। किल्हैकि बूट बछ़ैणियां तेते फल़ा करै।</char><verse eid="MAT 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 12:34" />
    <char style="wj">“तम्हैं आसा झ़रीली दानुईंए शोहरू ज़िहै! तम्हैं निं भली गल्‍ला करी ई सकदै किल्हैकि तम्हैं आसा बूरै, ज़ुंण तम्हैं बोला, तेता करै जाआ थोघ लागी कि थारै मन्‍नैं किज़ै आसा।</char> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><char style="wj">भलअ मणछ काढा आपणैं मन्‍नें भलै भढारा का भली गल्‍ला अर बूरअ मणछ काढा आपणैं मन्‍नें बूरै भढारा का बूरी गल्‍ला।</char><verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि मणछा ज़ुंण बृथा गल्‍ला बोल़णीं, तेभै भेटणीं तिन्‍नां तेते साबै सज़ा ज़ेभै परमेशरा नसाफ करनअ कि तम्हैं खाखा का किज़ै-किज़ै बोलअ।</char> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" /><char style="wj">किल्हैकि तूह हणअ आपणीं गल्‍ला करै ई शुचअ अर आपणीं ई गल्‍ला करै हणअ तूह झ़ुठअ।”</char><verse eid="MAT 12:37" /></para>
  <para style="s">स्वर्गे नछ़ैण रहैऊंणे मांग</para>
  <para style="r">(<ref loc="MRK 8:11-12">मार्कुस 8:11-12</ref>; <ref loc="LUK 11:29-32">लूका 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />ऐहा गल्‍ला लै बोलअ कई शास्त्री अर फरीसी ईशू लै, “हे गूरू, हाम्हैं च़ाहा ताखा सरगै एक नछ़ैण भाल़णअ ताकि हाम्हां इहअ भरोस्सअ होए कि तूह आसा परमेशरै हाम्हां सेटा लै छ़ाडअ द।”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“एऊ जुगे कदुष्ट अर विश्वास घाती मणछ लोल़ा नछ़ैण। पर जोना गूरे नछ़ैणां छ़ाडी निं तिन्‍नां लै होर किछ़ै भेटणअ आथी।</char> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><char style="wj">ज़िहअ परमेशरो गूर जोना रहअ चिई राची अर चिई धैल़ी पाणीं जैंदरी म्हाछ़े पेटा भितरी, तिहअ ई रहणअ हुंह मणछो पूत बी चिई राची धैल़ी पृथूई भितरी।</char><verse eid="MAT 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 12:41" />
    <char style="wj">“निनबे नगरीए लोगा बी लाणअ नसाफ हणें धैल़ी एऊ ज़मानें लोगा लै दोश। किल्हैकि जोना गूरे प्रच़ारा शूणीं किअ तिन्‍नैं आपणैं पापा लै प्राश्त, पर तम्हां निं अज़ी बी सुंबल़ी सोर आथी! हेरा, इधी आसा परमेशरे गूर जोना का बी बडअ।</char><verse eid="MAT 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 12:42" />
    <char style="wj">“दखण देशे राणीं बी लाणअ नसाफ हणें धैल़ी एऊ ज़मानें लोगा संघै उझ़ुई करै तिन्‍नां लै दोश कि सह आई सुलैमाने ज्ञैना शुणदी पृथूईए दुजै बाढा का पर तम्हां निं अज़ी बी सुंबल़ी सोर आथी! हेरा, इधी आसा सुलैमाना का बी बडअ।</char><verse eid="MAT 12:42" /></para>
  <para style="s">एऊ जुगे मणछे दशा</para>
  <para style="r">(<ref loc="LUK 11:24-26">लूका 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />
    <char style="wj">“ज़ांऊं भूत मणछा का बागै निखल़ा, सह लोल़ा शुक्‍की ज़ैगा आप्पू लै रामा करना लै अर ज़ांऊं तेऊ नांईं भेटा ता।</char> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" /><char style="wj">तेखअ बोला सह आप्पू लै इहअ, ‘मुंह डेऊणअ तेऊ ई मणछा दी बस्सणा लै बापस ज़िधा का हुंह पैहलै आसा निखल़अ द।’ बापस फिरी करै भाल़ा सह तेऊ मणछा शुन्‍नैं, धोअ-शोअ अर सज़ाऊऐ दै घअरा ज़िहै।</char> <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><char style="wj">तेखअ आणा सह भूत आप्पू का बी बूरै सात होर भूत आप्पू संघै शादी अर तिंयां बस्सा सोभ तेऊ दी। तेऊ मणछे हआ तेखअ पैहलै का बी खास्सी बूरी दशा। एऊ जुगे कदुष्ट मणछे दशा बी हणीं एही।”</char><verse eid="MAT 12:45" /></para>
  <para style="s">ईशूए ईज अर भाई</para>
  <para style="r">(<ref loc="MRK 3:31-35">मार्कुस 3:31-35</ref>; <ref loc="LUK 8:19-21">लूका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />ज़ांऊं ईशू झाल़ै जैंदरी इना गल्‍ला करदअ लागअ द त, तेऊए ईज अर कान्हैं भाई तै बागै खल़्हुऐ दै, अर तिंयां च़ाहा तै तेऊ संघै गल्‍ला करनी। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />एकी बोलअ ईशू सेटा एछी इहअ, “भाल़, तेरी ईज अर तेरै भाई आसा बागै खल़्हुऐ दै, अर ताह संघै च़ाहा तिंयां गल्‍ला करनी।”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />इहअ शूणीं ईशू दैनअ तेऊ लै ज़बाब, <char style="wj">“मेरी ईज कुंण आसा? कुंण आसा मेरअ भाई?</char> <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" /><char style="wj">मेरअ भाई-बैहण कुंण आसा? तेखअ ईशू आपणैं च़ेल्‍लै बाखा हाथ करी बोलअ, ‘ईंयां आसा मेरी ईज अर भाई-बैहण।’</char> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="wj">किल्हैकि ज़ुंण मेरै स्वर्गै रहणैं आल़ै बाब परमेशरो बैण शूणां अर मना तिंयां ई आसा मेरै भाई-बैहणी अर मेरी ईज।”</char><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">बेज़ै बऊंणैं आल़ेए कथ्या</para>
  <para style="r">(<ref loc="MRK 4:1-9">मार्कुस 4:1-9</ref>; <ref loc="LUK 8:4-8">लूका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />तैहा ई धैल़ी डेऊअ ईशू घअरा का बागै संघा डेऊअ गलील समुंदरा बाखा अर तिधी रहअ सह बाढै लोगा लै शिक्षा दैंदअ बेशी। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />ईशू सेटा आऐ तिधी खास्सै मणछ, तैही बेठअ ईशू किश्ती दी अर तिंयां सोभै लोग रहै समुंदरे बाढै खल़्हुई। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ईशू बोली कथ्या खोज़ी खास्सी गल्‍ला,</para>
  <para style="p" vid="MAT 13:3">
    <char style="wj">“शूणां, एकी बारी निखल़अ एकी बारी निखल़अ एक कृषाण बेज़ै बऊंदअ।</char> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" /><char style="wj">बेज़ै शोटदी बारी पल़अ धख बेज़अ बाते बाढै अर सह च़ुंघअ च़ेल्‍लू-पखीरू।</char><verse eid="MAT 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 13:5" />
    <char style="wj">“धख बेज़अ पल़अ शकरीली ज़िम्मीं दी, तेथ निं तेता खास्सअ माट्टअ भेटअ, सह बेज़अ निं डुघै माट्टै दी पल़अ अर इहअ करै टिप्पअ सह जाऊअ।</char> <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" /><char style="wj">ज़ांऊं सुरज़ो धुप्पअ टिप्परू दी पल़अ, तिंयां टिप्परू शुक्‍कै किल्हैकि तेते ज़लैल़ै निं डुघै माट्टै दी आथी तै।</char><verse eid="MAT 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 13:7" />
    <char style="wj">“इहअ ई धख बेज़अ पल़अ झ़ाकल़ै, ज़ांऊं सह बेज़अ टिप्पअ, सह दाभूअ कांडे झ़ाकल़ा जैंदरी।</char> <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" /><char style="wj">पर धख बेज़अ पल़अ रज़दी-पज़दी ज़िम्मीं दी, तिन्‍नां दी लागी खास्सी फसल। कोई दी शौ गुणा, कोई दी शाठ गुणा अर कोई तिह गुणा पज़ैआ।”</char><verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“ज़ै तम्हैं एता समझ़णअ च़ाहा, तै दैऐ ऐहा गल्‍ला दी धैन कि मंऐं एभै तम्हां का किज़ै बोलअ।”</char><verse eid="MAT 13:9" /></para>
  <para style="s">कथ्या का शिक्षा</para>
  <para style="r">(<ref loc="MRK 4:10-12">मार्कुस 4:10-12</ref>; <ref loc="LUK 8:9">लूका 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />तेखअ आऐ च़ेल्‍लै ईशू सेटा संघा लागै इहअ बोल्दै, “तूह इना लोगा संघै कथ्या खोज़ी किल्है करा गल्‍ला?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं सका स्वर्ग राज़ो भेद समझ़ी पर होरी लै ज़ुंण परमेशरे राज़ा दी नांईं आथी तिंयां निं समझ़दै।</char> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><char style="wj">ज़ुंण मेरी शिक्षा शूणां, तिन्‍नां लै दैणीं होर बी खास्सी समझ़ अर तिन्‍नां का हणअ होर बी खास्सअ ज्ञैन। पर ज़ुंण मेरी शिक्षा नांईं शूणां, तिन्‍नां का निंणअ सह बी पोर्ही ज़ुंण तिन्‍नां का धख समझ़ होए बी।</char> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" /><char style="wj">हुंह करा तिन्‍नां संघै कथ्या खोज़ी एते तैणीं गल्‍ला कि</char></para>
  <para style="q" vid="MAT 13:13">
    <char style="wj">तिंयां निं मेरै मुंह भाल़ी शिखल़दै</char></para>
  <para style="q" vid="MAT 13:13">
    <char style="wj">अर मेरी गल्‍ला शूणीं निं समझ़दै।</char><verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />
    <char style="wj">“तिन्‍नें बारै आसा परमेशरे गूर ईशायाह इहअ बोलअ द कि</char></para>
  <para style="q" vid="MAT 13:14">
    <char style="wj">‘मेरी गल्‍ला ता हेरनी तम्हां शूणीं</char></para>
  <para style="q" vid="MAT 13:14">
    <char style="wj">पर तम्हां निं समझ़ पल़णीं।</char></para>
  <para style="q" vid="MAT 13:14">
    <char style="wj">आछी का हेरनअ तम्हां भाल़ी</char></para>
  <para style="q" vid="MAT 13:14">
    <char style="wj">पर तम्हां का निं शुझणअ आथी।</char><verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="wj">किल्हैकि इना लोगो मन्‍न आसा पात्थरा ज़िहअ काठअ हुअ द।</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">ईंयां निं मेरी गल्‍ला शुणदै, </char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">इनै आसा आपणीं आछी मुंदरी डाही दी कि</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">इहअ निं हआ कि इने आछी का शुझिए अर, </char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">इने काना का शुण्हिंए अर</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">इने मन्‍नैं समझ़ एछे, अर ईंयां मुंह सेटा बापस फिरे</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">अर हुंह इना नरोगै करूं।’ </char><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />
    <char style="wj">“पर परमेशरै दैनअ तम्हां लै इना गल्‍ला आपणीं आछी भाल़णेंओ मोक्‍कअ कि तम्हां का शुझिए अर तम्हैं किऐ तेऊ इहै कि तम्हैं तेऊओ समाद शुणें अर तेता समझ़े।</char><verse eid="MAT 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 13:17" />
    <char style="wj">“किल्हैकि हुंह खोज़ा तम्हां का सत्त कि खास्सै गूर अर धर्मीं मणछ च़ाहा तै इना गल्‍ला भाल़णीं। तिन्‍नां निं ईंयां गल्‍ला भाल़णीं भेटी ज़ुंण आझ़ तम्हैं आसा भाल़ै लागै दै। तिंयां च़ाहा तै परमेशरो समाद शुणनअ ज़ुंण आझ़ तम्हैं शूणां पर तिन्‍नां निं शुणनअ भेटअ।”</char><verse eid="MAT 13:17" /></para>
  <para style="s">बेज़ै बऊंणैं आल़ेए कथ्या समझ़ाऊंणी</para>
  <para style="r">(<ref loc="MRK 4:13-20">मार्कुस 4:13-20</ref>; <ref loc="LUK 8:11-15">लूका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />तेखअ बोलअ ईशू इहअ, <char style="wj">“बेज़ै बऊंणैं आल़अ कृषाण आसा परमेशरो समाद खोज़णैं आल़ै ज़िहअ।</char> <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" /><char style="wj">ज़ुंण बी स्वर्ग राज़ो बैण शूणीं नांईं समझ़ा, तेऊए मन्‍नैं ज़ुंण बी बऊअ द त, तेऊ निंयां सह कदुष्ट राख्स छ़ड़ैऊई। अह आसा सह ई बेज़अ ज़ुंण बाते बाढै त बऊअ द।</char><verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />
    <char style="wj">“तिहअ ई शकरीली ज़िम्मीं दी पल़अ द बेज़अ आसा तिन्‍नां लोगे बारै ज़ुंण परमेशरो बैण शूणां अर तेभी खुशी-खुशी संघै मना।</char> <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" /><char style="wj">पर आप्पू पाक्‍कअ विश्वास नांईं हणें बज़्हा रहा तिंयां थोल़ै ई धैल़ै लै। बैण मनणे बज़्हा ज़ांऊं तिन्‍नां लै मसीबता एछा, तिंयां छ़ाडा तेभै परमेशरा दी विश्वास करनअ।</char><verse eid="MAT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 13:22" />
    <char style="wj">“ज़ुंण बेज़अ झ़ाकल़ै पल़अ सह आसा तिन्‍नां मणछे बारै ज़ुंण बैण ता शूणां, पर एऊ संसारे फिकर अर धन-माये धोखै करै पाआ तेऊ बैणा बिस्सरी। तिंयां निं तिहअ करदै ज़िहअ परमेशर च़ाहा कि तिंयां करे।</char><verse eid="MAT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 13:23" />
    <char style="wj">“ज़ुंण बेज़अ रज़दी-पज़दी ज़िम्मीं दी पल़अ, अह आसा तिन्‍नां लोगे बारै ज़ुंणी परमेशरो बैण शूणअ, मनअ अर विश्वास किअ। तिन्‍नैं किअ तिहअ ई ज़िहअ परमेशर च़ाहा कि तिंयां करे। तिंयां आसा एही बधिया फसला ज़ेथ तिह गुणा, शाठ गुणा, कोई दी शौ गुणा फसल हुई।”</char><verse eid="MAT 13:23" /></para>
  <para style="s">बणें बेज़े कथ्या</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />तेखअ खोज़ी ईशू तिन्‍नां का एक होर कथ्या, <char style="wj">“स्वर्गो राज़ आसा तेऊ कृषाणा ज़िहअ ज़ुंणी आपणैं खेचै बधिया बेज़अ बऊअ।</char> <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="wj">पर ज़ांऊं लोग सुत्तै दै तै, तिन्‍नैं दुशमणै डाहै कणका जैंदरी बणें घाह लबहरै बऊई।</char> <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" /><char style="wj">ज़ांऊं टिप्परू लागै अर सील निखल़ै तेखअ लागै तिंयां बणें घाह लबहरे दाणैं बी शुझदै।</char><verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />
    <char style="wj">“एता भाल़ी बोलअ तेऊए घअरे सोभी दास तेऊ सेटा एछी, ‘हे मालक, तंऐं कै आपणैं खेचै बधिया बेज़अ निं बऊअ त? तै ईंयां बणें लबहरै किधा का आऐ?’</char><verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />
    <char style="wj">“तेऊ बोलअ तिन्‍नां लै इहअ, ‘अह आसा कहा दुशमणो काम।’</char></para>
  <para style="p" vid="MAT 13:28">
    <char style="wj">“तिन्‍नैं दासै बोलअ मालका लै, ‘ऐबै तूह किज़ै बोला, हाम्हैं लबहरै कणक जैंदरा का पेच़ी झाल़ी डाहूं?’</char><verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />
    <char style="wj">“मालकै बोलअ तिन्‍नां लै, ‘इहअ निं करी, इहअ निं हआ कि बणें लबहरै झाल़दी बारी राम्बल़ै कणके दैणैंओ डाल़ बी झोठिआ।</char> <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><char style="wj">तम्हैं करा इहअ, लऊंणै तैणीं दैआ इना दुही संघा-संघा बझ़णै। लऊंणे बगती बोल़णअ मुंह लऊंणै आल़ै लै कि इना बणें लबहरैओ लाऐ एकी ज़ैगा दहणा लै रूल़ अर कणक करै मेरै भढारै कठा।’”</char><verse eid="MAT 13:30" /></para>
  <para style="s">शाऊईए बेज़े कथ्या</para>
  <para style="r">(<ref loc="MRK 4:30-32">मार्कुस 4:30-32</ref>; <ref loc="LUK 13:18">लूका 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />तेखअ खोज़ी ईशू तिन्‍नां का एक होर कथ्या, तेऊ बोलअ इहअ, <char style="wj">“स्वर्गो राज़ आसा एक शाऊईए दाणैं ज़िहअ, सह बऊअ एकी मणछै आपणैं खेचै।</char> <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><char style="wj">आसा ता शाऊईओ दाणअ सोभी बेज़ै का होछ़अ पर ज़ांऊं सह बझ़ा, सह हआ सोभी शाग-पाचा का बडअ। सह हआ इहअ बूट कि सरगे च़ेल्‍लू-पखीरू बी बणाआं तेते शाण्हीं जैंदरी आपणैं कोल्ह।”</char><verse eid="MAT 13:32" /></para>
  <para style="s">स्वर्गो राज़ सज़ेल़ै ज़िहअ</para>
  <para style="r">(<ref loc="LUK 13:20">लूका 13:20</ref>,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ईशू खोज़ी तिन्‍नां का एक होर कथ्या, <char style="wj">“स्वर्गो राज़ आसा धख ज़िहै सज़ेल़ै ज़िहअ ज़ुंण कुंणी बेटल़ी खास्सै पिठै जैंदरी मुछ़अ। थोल़ी घल़ी बाद बणअ सह सारअ मुछ़अ द पिठअ सज़ेल़अ।”</char><verse eid="MAT 13:33" /></para>
  <para style="s">कथ्या खोज़णेंओ मकसद</para>
  <para style="r">(<ref loc="MRK 4:33-34">मार्कुस 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />ईंयां सोभ गल्‍ला खोज़ी ईशू कथ्या खोज़ी, इना एही गल्‍ला समझ़ाऊंणा लै करा त ईशू कथ्या खोज़ी गल्‍ला। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ताकि परमेशरे गूर ईशायाह बोलअ द बैण पूरअ होए,</para>
  <para style="q" vid="MAT 13:35">“मुंह करनी कथ्या खोज़ी गल्‍ला,</para>
  <para style="q" vid="MAT 13:35">अर तिंयां गल्‍ला करनी मुंह प्रगट ज़ुंण संसार शुरू हणैं ओर्ही गुप्त आसा रही दी।”<verse eid="MAT 13:35" /></para>
  <para style="s">बणें बेज़े कथ्या समझ़ाऊंणी</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तेखअ आअ ईशू तिन्‍नां मणछा सेटा का घअरा लै। च़ेल्‍लै आऐ ईशू सेटा लै संघा लागै इहअ बोल्दै, “खेचै बणें लबहरे कथ्या समझ़ाऊ हाम्हां का।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />ईशू समझ़ाऊऐ तिंयां इहअ बोली, <char style="wj">“बधिया बेज़ै बऊंणैं आल़अ आसा हुंह मणछो पूत।</char> <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" /><char style="wj">खेच आसा एऊ संसारे मणछ। बधिया बेज़अ आसा स्वर्ग राज़े परज़ा ज़हा प्रैंदै परमेशर राज़ करा। बणों बेज़अ आसा तेऊ राख्से परज़ा ज़हा प्रैंदै सह राख्स राज़ करा।</char> <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" /><char style="wj">कणका जैंदरी लबहरै बऊंणैं आल़अ दुशमण आसा सह राख्स। लऊंणे बेल आसा एऊ संसारा खतम हणैंओ नछ़ैण अर काटणै आल़ै आसा स्वर्ग दूत।</char><verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />
    <char style="wj">“ज़िहै बणें लबहरै झाल़ी दहई पाआ, तिहअ ई हणअ तेभै बी ज़ेभै परमेशरा सोभी लोगो नसाफ करी अह संसार खतम हणअ।</char> <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><char style="wj">मुंह मणछे पूता छ़ाडणैं आपणैं स्वर्ग दूत। तिन्‍नां झाल़णैं तेऊए राज़ा का सोभ पाप अर कदुष्ट काम करनै आल़ै सोभ मणछ।</char> <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><char style="wj">स्वर्ग दूता पाणै तिंयां जम्परी आगीए कूंडा जैंदरी। तिधी हणैं तिंयां लैल़ा लांदै अर दाहे झोशा करै दांदा कटिल्‍लदै।</char> <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><char style="wj">तेभै च़मकणै धर्मीं आपणैं बाब परमेशरे राज़ा दी सुरज़ा ज़िहै।</char></para>
  <para style="p" vid="MAT 13:43">
    <char style="wj">“ज़ै तम्हैं एता समझ़णअ च़ाहा, तै दैऐ ऐहा गल्‍ला दी धैन कि मंऐं एभै तम्हां का किज़ै बोलअ।</char><verse eid="MAT 13:43" /></para>
  <para style="s">गुप्त भढार</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />
    <char style="wj">“स्वर्गो राज़ आसा खेचै दाबी दी धन-माया ज़िहअ ज़ुंण माया कहा मणछा भेटी अर सह डाही तेऊ तिधी दाबी, तेऊ हुई एही खुशी कि तेऊ लअ आपणीं सारी ज़ैदात बेच़ी सह खेच मोलै।</char><verse eid="MAT 13:44" /></para>
  <para style="s">किम्मती मोती</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />
    <char style="wj">“स्वर्गो राज़ आसा एकी बपारी ज़िहअ ज़ुंण सोभी का बधिया मोती लोल़अ त लागअ द।</char> <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><char style="wj">ज़ांऊं तेऊ एक किम्मती मोती भेटअ, तेऊ पाअ मोती मोल लणें तैणीं आपणअ सोभ किछ़ बेच़ी।</char><verse eid="MAT 13:46" /></para>
  <para style="s">म्हाछ़ली ढाकणें कथ्या</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />
    <char style="wj">“स्वर्गो राज़ आसा म्हाछ़ली ढाकणें एकी बडै ज़ज़ाल़ा ज़िहअ, ज़ुंण समुंदरै पाअ अर तेथ शाची सोभी रंगे म्हाछ़ली।</char> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" /><char style="wj">ज़ांऊं सह ज़ज़ाल़ म्हाछ़ली करै भर्हुअ, सह आणअ समुंदरे बाढा लै खिंच़ी। तेखअ भरी तेता मांझ़ै बधिया-बधिया म्हाछ़ली छ़ांटी करै च़ठै भितरी अर बाकी शोटी पोर्ही।</char><verse eid="MAT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 13:49" />
    <char style="wj">“ज़ेभै संसार खतम हणअ तेभै हणीं एही ई गल्‍ला। स्वर्ग दूता करनै स्वर्गा का एछी कदुष्ट मणछ धर्मीं मणछा का ज़ुदै अर तिंयां पाणै जम्परी आगीए कूंडा जैंदरी।</char> <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" /><char style="wj">तिधी हणैं तिंयां लैल़ा लांदै अर दाहे झोशा करै दांदा कटिल्‍लदै।</char><verse eid="MAT 13:50" /></para>
  <para style="s">पराणीं अर नऊंईं शिक्षा</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />
    <char style="wj">“तम्हैं ईंयां गल्‍ला समझ़ी बी कि नांईं?”</char><verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />च़ेल्‍लै बोलअ ईशू लै, “हाँ।”</para>
  <para style="p" vid="MAT 13:52">ईशू बोलअ तिन्‍नां लै, <char style="wj">“तैही ज़ुंण हर शास्त्री स्वर्ग राज़ो च़ेल्‍लअ आसा बणअ द, सह आसा तेऊ भढारी ज़िहअ ज़ुंण आपणैं भढारा का नऊंईं पराणीं च़िज़ा काढा।”</char><verse eid="MAT 13:52" /></para>
  <para style="s">नासरत नगरी ईशूओ अदर नांईं करनअ</para>
  <para style="r">(<ref loc="MRK 6:1-6">मार्कुस 6:1-6</ref>; <ref loc="LUK 4:16-30">लूका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ज़ांऊं ईशू इना सोभी कथ्या खोज़ी मुक्‍कअ, तिधा का डेऊअ ईशू आपणैं घअरै नासरत नगरी लै। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />तिधी पुजी लागअ यहूदीए सभागृहा एही शिक्षा दैंदअ कि तिंयां हुऐ रहैन संघा लागै तिंयां इहअ बोल्दै,</para>
  <para style="p" vid="MAT 13:54">“एऊ ईंयां ज्ञैन अर महान शगतीए काम किधा का भेटै?” <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />अह कै युसुफ छदाणो शोहरू निं आथी? एऊए ईजा नाअं मरिअम निं आथी? एऊए कान्हैं भाऊ नाअं याकब अर युसुफ, शमौन अर यहूदा निं आथी? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />एऊए सारी बैहणी कै हाम्हां मांझ़ै निं आथी? तै एऊ ईंयां सोभै गल्‍ला किधा का भेटी? <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />तिन्‍नैं च़ेती ऐहा गल्‍ले माल़ी अर तिन्‍नैं निं तेऊ दी विश्वास किअ।</para>
  <para style="p" vid="MAT 13:57">पर ईशू बोलअ तिन्‍नां लै, <char style="wj">“परमेशरे गूरो हआ होरी सोभी ज़ैगा अदर पर आपणैं देशै, रिश्तैदारा अर टबरा मांझ़ै निं तेऊओ अदर हंदअ।”</char> <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />तिंयां निस्सै विश्वास करी अर ईशू निं तिधी किछ़ै बडै च़मत्कारे काम किऐ।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">जोहन्‍ना डुबकी दैणैं आल़ेए हत्या</para>
  <para style="r">(<ref loc="MRK 6:14-29">मार्कुस 6:14-29</ref>; <ref loc="LUK 9:7-9">लूका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />तिन्‍नां धैल़ै शूणीं गलील मुल्खै राज़ करनै आल़ै हेरोदेस राज़ै ईशूए बारै गल्‍ला। तेऊ बोलअ आपणैं दरबारी लै इहअ, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />अह ईशू आसा जोहन्‍ना डुबकी दैणैं आल़अ अर सह हुअ मरी करै भिई ज़िऊंदअ, तैही हआ एऊ का एतरै च़मत्कारे काम प्रगट।<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />किल्हैकि हेरोदेस राज़ै पाअ त जोहन्‍ना आपणैं भाई फलिप्पे लाल़ी हेरोदियासा पिछ़ू कैद खानै दी। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />इहअ किअ तेऊ तै कि जोहन्‍ना बोलअ त राज़ै लै इहअ कि आपणैं भाईए बेटल़ी डाही करै किअ तंऐं पाप। <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />हेरोदेस राज़अ ता च़ाहा त जोहन्‍ना मारनअ पर सह डरा त लोगा का, किल्हैकि लोग मना तै जोहन्‍ना परमेशरो गूर।<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />पर ज़ांऊं हेरोदेस राज़ेए ज़ल्म धैल़ी पुजी, हेरोदियासे शोहरी किअ राज़ तेऊ थैरा दी आपणअ नाच़ रहैऊई करै खुश। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />राज़ै दैनअ तैहा लै बच़न कि ज़िहअ बी तूह मांगे, हुंह दैंऊं तेता ताल्है।<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />सह शोहरी ती तेसे ईजै शगरेऊई डाही दी अर तैहा बोलअ राज़ै लै इहअ किई मुल्है आण थाल़ा भितरी जोहन्‍ना डुबकी दैणैं आल़ैओ मूंड एभी काटी। <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />राज़अ हेरोदेस पछ़ताअ हेरोदियासे शोहरी लै बच़न दैई। किल्हैकि तिधी बेठै दै सोभी प्राहुंणैं बी शूणीं तेऊए तिंयां गल्‍ला अर तेखअ पल़अ तेऊ तिहअ करनअ ज़िहअ तेऊ बच़न दैनअ त।</para>
  <para style="p" vid="MAT 14:9">तेखअ दैनअ तेऊ आपणैं दासा लै हुकम कि ज़िहअ अह शोहरी बोला तिहअ ई करा। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />तेऊ दैनअ कैद खानै आपणैं सपाही लै हुकम कि डेओआ, जोहन्‍नो मूंड आणा एभी काटी। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />सपाही आणअ थाल़ा भितरी तेऊओ मूंड संघा दैनअ तैहा शोहरीए हाथै अर तैहा निंयं सह आपणीं ईजा सेटा लै। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />तेखअ निंईं जोहन्‍ने च़ेल्‍लै तिधा का तेऊए ल्हास, संघा डाही तिन्‍नैं सह घोरी दाबी अर तिन्‍नैं दैनअ इना गल्‍लो समाद ईशू लै कि जोहन्‍ना पाअ हेरोदेस राज़ै मारी।<verse eid="MAT 14:12" /></para>
  <para style="s">पांज़ा हज़ारा मणछा का रोटी खैऊंणी</para>
  <para style="r">(<ref loc="MRK 6:30-44">मार्कुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लूका 9:10-17</ref>; <ref loc="JHN 6:1-14">जोहन्‍ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />ज़ांऊं ईशू इहअ शूणअ, सह डेऊअ किश्ती दी बेशी किधी कांगनरांगी ज़ैगा लै। पर लोगा का गअ थोघ लागी अर कई नगरी का आऐ खास्सै मणछ ज़ांघा हांढी संघा पुजै तिधी ज़िधी ईशू थिअ। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />ईशू भाल़ै कि तिधी आऐ खास्सै मणछ अर तेऊ फिरी तिन्‍नां भाल़ी झींण। तिन्‍नां जैंदरी तै खास्सै रोगी मणछ अर ईशू किऐ तिंयां सोभ नरोगै।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />ज़ांऊं सान्ह पल़ी, ईशूए च़ेल्‍लै आऐ तेऊ सेटा लै अर तिंयां लागै इहअ बोल्दै, “अह आसा बडी कराहणीं ज़ैगा अर सान्ह बी च़ाल्‍ली पल़ी, इना लोगा लै बोल ऐबै डेऊणा लै ताकि ईंयां किधी गराऊंऐं आप्पू लै रोटीओ इंतज़ाम करी सके।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“इनो डेऊणअ निं ज़रूरी आथी, तम्हैं ई दैआ इना लै रोटी खाणां लै।”</char><verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />तिन्‍नैं च़ेल्‍लै बोलअ ईशू लै, “हाम्हां सेटा निं इधी पांज़ रोटी अर दूई म्हाछ़ली छ़ाडी होर किछ़ै आथी।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तिन्‍नां आणा मुंह सेटा लै।”</char> <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />संघा बोलअ तेऊ आपणैं च़ेल्‍लै लै, <char style="wj">“सोभी लोगा बशैल़ा धरनीं घाहा प्रैंदै घेहल़ी दी।”</char> तेखअ ढाकी पांज़ रोटी अर दूई म्हाछ़ली हाथै। तेखअ किअ स्वर्गा बाखा भाल़ी परमेशरो शूकर संघा दैनी रोटी अर म्हाछ़ली चोल़ी-चोल़ी करै च़ेल्‍ले हाथै। तिंयां लागै घेहल़ी लोगा लै बांडदै।<verse eid="MAT 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 14:20" />सोभी लोगै खाई रज्ज़ी रोटी, अर बारा च़ठै भर्हुऐ तिन्‍नां रोटीए ज़ुंण पिछ़ू बाकी बच़ी! <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />रोटी खाणैं आल़ै पांज़ हज़ार मर्ध ई मर्ध अर बेटल़ी-माठै तै तिन्‍नां का लाऊआ।<verse eid="MAT 14:21" /></para>
  <para style="s">ईशूओ पाणीं प्रैंदै हांढणअ</para>
  <para style="r">(<ref loc="MRK 6:45-52">मार्कुस 6:45-52</ref>; <ref loc="JHN 6:15-21">जोहन्‍ना 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />तेखअ बशैल़ै तेभी ईशू आपणैं च़ेल्‍लै किश्ती दी ज़ोरा-ज़ोरी कि तम्हैं डेओआ पैहलै गलील समुंदरा पार ज़ेभै तैणीं हुंह इना सोभी लोगा इने घअरा लै बापस निं छ़ाडी लऊं। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />ईशू छ़ाडै तिंयां सोभ लोग घअरा लै अर आप्पू डेऊअ सान्हां एक्‍कै ज़ण्हअ धारठी प्रैंदै प्राथणां करदअ।<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />समुंदरै आअ बडअ ढिश-बागर अर किश्ती लागी समुंदरा मांझ़ै बागरी करै ओरी-पोरी ढुल़दी। <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />ईशू आअ राचकै च़ौथै पहरै समुंदरे पाणीं प्रैंदै हांढी तिन्‍नां सेटा लै। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />ज़ांऊं च़ेल्‍लै का ईशू पाणीं प्रैंदै हांढदअ शुझुअ, तिंयां डरै खास्सै। तिंयां लागै आप्पू मांझ़ै इहअ बोल्दै, “अह आसा भूत।” तेखअ लागै तिंयां डरै ज़ोरै-ज़ोरै लैल़ा-पकारा पांदै।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />तेखअ किई तेभी ईशू तिन्‍नां संघै गल्‍ला, <char style="wj">“डरा निं आथी, अह आसा हुंह तम्हैं निं हैअ चोल़ा।”</char><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />तेखअ बोलअ पतरासै ईशू लै, “प्रभू, ज़ै तूह ई आसा, तै दै मुल्है पाणीं प्रैंदै हांढी करै एछणें ज़ाज़त।”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ईशू बोलअ, <char style="wj">“एछ” </char></para>
  <para style="p" vid="MAT 14:29">पतरास लागअ किश्ती का पाणीं प्रैंदै होथी ईशू बाखा पाणीं प्रैंदै हांढदअ। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पर पतरास डरअ ढिश-बागरी करै, ज़ांऊं सह पाणीं दी डुबदअ लागअ, तेऊ पाई लैल़ा “हे प्रभू, मुंह बच़ाऊ! हुंह च़ाल्‍लअ डुबी, मुंह बच़ाऊ!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ईशू ढाकअ तेभी तेऊओ हाथ संघा बोलअ इहअ, <char style="wj">“बैहम करनै आल़ै मणछा, तंऐं बैहम किल्है किअ?”</char><verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />ज़ांऊं तिंयां किश्ती दी उखल़ै, ढिश-बागर मुक्‍की तेभी। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />तेखअ ज़ुंण किश्ती दी थिऐ बेठै दै, एता भाल़ी टेक्‍कअ तिन्‍नैं ईशू सेटा माथअ संघा बोलअ इहअ, “तूह आसा सच्च़ी परमेशरो पूत।”<verse eid="MAT 14:33" /></para>
  <para style="s">गन्‍नेसरत समुंदरे बाढै किऐ खास्सै रोगी नरोगै</para>
  <para style="r">(<ref loc="MRK 6:53-56">मार्कुस 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />तिंयां सोभ पुजै गलील समुंदरा पार डेऊई गन्‍नेसरत मुल्खे समुंदरे बाढै। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />तिधे लोगै हेरअ ईशू तेभी बछ़ैणीं, संघा दैनअ तिन्‍नैं ओरी-पोरीए नगरी-गराऊंआं दी डेऊई होरी सोभी लै समाद, संघा आणै तिन्‍नैं कई बमार मणछ ईशू सेटा लै।<verse eid="MAT 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 14:36" />तेखअ लागै तिंयां ईशू का एही अरज़ करदै “तूह दै हाम्हां च़ाऐ आपणैं च़ोल़ैओ पाल्‍लअ पुंझ़ा का छ़ुंहंणै ताकि हाम्हैं इना बमारी का बच़े।” ज़ेतरै मणछै बी ईशू छ़ुंअ, तिन्‍नां भेटअ तिन्‍नें सोभ रोग अर बमारी का छ़ुटकारअ।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">रिती-रबाज़ा मनणैओ सुआल</para>
  <para style="r">(<ref loc="MRK 7:1-13">मार्कुस 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तेखअ आऐ एरुशलेम नगरी का मांझ़ा का कई फरीसी मणछ, अर शास्त्री ईशू सेटा, संघा लागै तिंयां इहअ बोल्दै, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“तेरै च़ेल्‍लै दादा-बाबे रिती-रबाज़ किल्है निं मंदै? तिंयां निं रोटी खाणैं का आजी तेऊ साबै हाथ धोंदै ज़िहअ म्हारै रबाज़ आसा?”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />ईशू दैनअ तिन्‍नां लै ज़बाब <char style="wj">“परमेशरै आसा हाम्हां लै हुकम दैनअ द कि हाम्हैं तेते साबै आपणीं ज़िन्दगी ज़िऊए। पर तम्हैं निं तिहअ करदै! तेता छ़ाडी तम्हैं थारै आपणैं बणाऐं दै रबाज़ किल्है मना?</char> <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><char style="wj">परमेशरै ता इहअ थिअ बोलअ द, ‘आपणैं ईजा-बाबो करै अदर। ज़ुंण आपणैं ईजा-बाबा लै बूरअ बोले, तेऊ पाऐ मारी।’</char><verse eid="MAT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 15:5" />
    <char style="wj">“पर तम्हैं बोला इहअ, ‘ज़ै कुंण आपणैं ईजा-बाबा लै इहअ बोले, “ज़ुंण बी हाम्हां तम्हां लै दैणअ त, सह हेरअ हाम्हैं परमेशरा लै अर्पण करी दैई। ऐबै निं हाम्हैं थारी मज़त करी सकदै?”’</char> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" /><char style="wj">इहअ करै करा तम्हैं तेऊ मणछा इहै कि सह निं आपणैं ईजा-बाबो अदर करदअ अर नां तिन्‍नें मज़त करदअ। एता का लागा थोघ कि तम्हैं निं ज़िहअ परमेशरै बोलअ तिहअ मनअ, तम्हैं मनै सिधै आपणैं रिती-रबाज़।</char><verse eid="MAT 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 15:7" />
    <char style="wj">“हे कपटी मणछो, ईशायाह गूरै आसा थारै बारै बधाना दी पैहलै ई ठीक बोलअ द, </char><verse eid="MAT 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8" />
    <char style="wj">‘ईंयां लोग होठा का ता करा मेरअ अदर, </char></para>
  <para style="q" vid="MAT 15:8">
    <char style="wj">पर इनो मन्‍न आसा मुखा दूर।</char><verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />
    <char style="wj">ईंयां करा मेरी च़ाकरी फज़ूल ई, </char></para>
  <para style="q" vid="MAT 15:9">
    <char style="wj">किल्हैकि ईंयां सखाऊआ होरी लोगा का </char></para>
  <para style="q" vid="MAT 15:9">
    <char style="wj">मणछे रिती-रबाज़ मेरअ बधान बोली।’”</char><verse eid="MAT 15:9" /></para>
  <para style="s">छ़ोत लाणैं आल़ी गल्‍ला</para>
  <para style="r">(<ref loc="MRK 7:14-23">मार्कुस 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />तेखअ शादै ईशू तिंयां लोग आप्पू सेटा लै संघा बोलअ, <char style="wj">“मेरी गल्‍ला शूणां अर ऐहा गल्‍ला समझ़ा।</char> <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" /><char style="wj">ज़ुंण खाखा भितरी डेओआ, तेता करै निं मणछा छ़ोत लागदी पर ज़ुंण मणछे मन्‍नां का बागै निखल़ा, तेता करै लागा तेऊ छ़ोत।”</char><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />तेखअ पुछ़अ च़ेल्‍लै ईशू का, “ताखा थोघ बी आसा कि तेरी इना गल्‍ला शूणीं हुऐ फरीसी पंथे लोगा ताखा खास्सै नराज़।”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हरेक बूट ज़ुंण मेरै स्वर्गे बाब नांईं आथी लाअ द, सह पेच़णअ तेऊ पोर्ही।</char> <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><char style="wj">इना फरीसी मणछे ज़ाणैं निं लागा, ईंयां निं लोगा का खोज़दै कि परमेशर किज़ै च़ाहा। ईंयां आसा कांणै मणछा ज़िहै। ज़ै कांणअ मणछ कांणै का बात खोज़े, तिंयां पल़णै दुहै खात्ती दी।”</char><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ऐहा गल्‍ला शूणीं बोलअ पतरासै ईशू लै, “हाम्हां का समझ़ाऊ ऐहा कथ्या राम्बल़ै करै।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं बी अज़ी समझ़ै निं आथी?</char> <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" /><char style="wj">तम्हैं किज़ै निं समझ़ै कि ज़ुंण खाखा डेओआ सह पल़ा पेटै अर दोत्ती दिशा डेऊई निखल़ा बागा लै?</char> <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><char style="wj">पर ज़ुंण खाखा का निखल़ा, सह निखल़ा मन्‍नां का अर तेता ई करै लागा मणछा छ़ोत।</char><verse eid="MAT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 15:19" />
    <char style="wj">“किल्हैकि निक्‍की सोठ, हत्या, पराई बेटल़ी सेटा डेऊणअ, कंज़रैई, च़ोरी, झ़ुठी शाजत अर निंदा निखल़ा मणछे मना का।</char> <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" /><char style="wj">इना ई गल्‍ला करै लागा मणछा छ़ोत, रिती-रबाज़े साबै हाथ धोऐ बगैर रोटी खाई करै निं मणछा छ़ोत लागदी।”</char><verse eid="MAT 15:20" /></para>
  <para style="s">कनानी बेटल़ीओ विश्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मार्कुस 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ईशू लागअ तेखअ गलील मुल्खा का हांढदअ अर संघा पुजअ सह सूर अर सैदा मुल्खै। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />तिधी आई एक कनानी बेटल़ी अर सह लागी ज़ोरै-ज़ोरै बोल्दी, “हे प्रभू, दाबेदे लुआद मुल्है कर झींण, मेरी शोहरीए लाऐ भूतै बूरै हाल करी।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />पर ईशू निं तैहा लै कोई बी ज़बाब दैनअ। तेखअ किई च़ेल्‍लै ईशू सेटा अरज़, “हे प्रभू, ऐहा लै बोल पोर्ही डेऊणा लै, अह आसा लागी दी हाम्हां पिछ़ू लैल़ा लाई ठुहर्दी ऐहा लाऐ हाम्हैं तंग करी।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />ईशू बोलअ तैहा लै इहअ, <char style="wj">“हुंह आसा परमेशरै सिधअ इज़राईली मणछा सेटा लै छ़ाडअ द, किल्हैकि तिंयां आसा कबाता पेठी दी भेडा ज़िहै।”</char><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />पर सह आई तैबी अर ईशू सेटा माथअ टेक्‍कअ संघा बोलअ, “हे प्रभू, मेरी मज़त कर।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />ईशू बोलअ तैहा लै इहअ, <char style="wj">“अह गल्‍ल निं ठीक लागणीं कि लान्हैं लै चाणी दी रोटी कुक्‍करा लै दैए!”</char><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />तैहा बोलअ ईशू लै इहअ, “हाँ प्रभू अह गल्‍ल आसा ठीक पर हे प्रभू, कुक्‍करा बी हआ ठोर-म्हारा न्हैल़ै लागै दै ज़ुंण लान्हैं का छ़ुटा।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ऐहा गल्‍ला शूणीं बोलअ ईशू तैहा लै, <char style="wj">“हे ज़नानी, तेरअ विश्वास महान, ताल्है लोल़ी ज़िहअ तूह च़ाहा तिहअ ई हुअ।”</char> तेसे शोहरी हुई तैहा ई घल़ी नरोगी।<verse eid="MAT 15:28" /></para>
  <para style="s">ईशू किऐ खास्सै रोगी नरोगै</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />तेखअ डेऊअ ईशू तिधा का गलील मुल्खे समुंदरा सेटा अर धारा प्रैंदै डेऊई तिधी बेठअ। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />तिधी आऐ खास्सै लोगे छ़ुंडा प्रैंदै छ़ुंड, तिन्‍नैं आणै आप्पू संघै लाट्टै, कांणै, काल्‍लै, टुंडै अर कई दाह-खिज़ा आल़ै आणै ईशू सेटा लै अर तिंयां बशैल़ै ईशूए च़रणैं अर ईशू किऐ तिंयां सोभ नरोगै। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ज़ांऊं लोगै भाल़अ कि काल्‍लै लागै गल्‍ला करदै, लाट्टै लागै हांढदै, टुंडै हुऐ राम्बल़ै, अर कांणै का लागअ शुझदअ, तिंयां हुऐ रहैन संघा लागै इज़राईले परमेशरे ज़ै-ज़ैकार करदै।<verse eid="MAT 15:31" /></para>
  <para style="s">च़ऊ हज़ारा लोगा का रोटी खैऊंणी</para>
  <para style="r">(<ref loc="MRK 8:1-10">मार्कुस 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ईशू बोलअ आपणैं च़ेल्‍लै लै, <char style="wj">“मुंह फिरा इना एतरै लोगा भाल़ी झींण किल्हैकि ईंयां आसा चिई धैल़ी ओर्ही मुंह संघै। इना का खाणां लै बी निं बच़अ किछ़ै। हुंह निं च़ाहंदअ इना भुखै घअरा लै छ़ाडणअ। इहअ निं हआ कि ईंयां बाता थकी करै रहे तेथै पल़ी।”</char><verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />तेऊए च़ेल्‍लै बोलअ तेऊ लै, “हाम्हैं आसा खास्सै दूर, अर हाम्हैं किधा का लाई एतरी रोटी काढी कि ईंयां एतरै लोग रज्ज़े!”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ईशू पुछ़अ तिन्‍नां का, <char style="wj">“तम्हां का केतरी रोटी आसा?”</char></para>
  <para style="p" vid="MAT 15:34">च़ेल्‍लै बोलअ, “हाम्हां का आसा सात रोटी अर धख ज़ेही होछ़ी म्हाछ़ली।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />ईशू बोलअ तिन्‍नां सोभी लोगा लै धरनीं घेहल़ी दी बशैल़णा लै। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />तेखअ चोल़ी ईशू सात रोटी अर म्हाछ़ली लै परमेशरो शूकर करी। तेखअ रहअ च़ेल्‍ले हाथै रहअ दैंदअ लागी अर तिंयां रहै लोगा लै बांडदै लागी।<verse eid="MAT 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37" />इहअ करै रज्ज़ै रोटी खाई तिंयां सोभ लोग, च़ेल्‍लै भरै पिछ़ू बच़ी दी रोटीए सात च़ठै। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />खाणैं च़ार हज़ार मर्ध ई मर्ध बेटल़ी-माठै तै तेता का लाऊआ।<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />तेखअ छ़ाडै ईशू तिंयां लोग घअरा लै अर आप्पू डेऊअ च़ेल्‍लै संघै किश्ती दी बेशी मगदल़ मुल्खा लै।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">स्वर्गो नछ़ैण मांगणअ</para>
  <para style="r">(<ref loc="MRK 8:11-13">मार्कुस 8:11-13</ref>; <ref loc="LUK 12:54-56">लूका 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरीसी अर सदुकी पंथे लोग आऐ ईशू सेटा लै अर तिन्‍नैं बोलअ, “ज़ै तूह असली दी परमेशरै आसा हाम्हां सेटा लै छ़ाडअ द तै रहैऊ सरगै हाम्हां का एक नछ़ैण ताकि हाम्हां भरोस्सअ होए।”<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“सान्हां बोला तम्हैं कि सरग रहणअ बिझअ, किल्हैकि सरग आसा लाल।</char> <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><char style="wj">दोत्ती बोला इहअ कि आझ़ एछणी ढिश-बागर, किल्हैकि सरग आसा लाल अर न्हैरअ। तम्हैं हेरा सरगे लछ़ण भाल़ी तेतो भेद खोज़ी, पर ज़ुंण एभै आसा हंदअ लागअ द सह किल्है निं तम्हां का शुझदअ? तेता करै किल्है निं तम्हां समझ़ एछदी कि परमेशर किज़ू करदअ आसा लागअ द?</char> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><char style="wj">एऊ जुगे कदुष्ट अर विश्वास घाती मणछ लोल़ा नछ़ैण। पर जोना गूरे नछ़ैणां छ़ाडी निं तिन्‍नां होर किछ़ै भेटणअ आथी।”</char> तेखअ लागअ ईशू तिन्‍नां छ़ाडी तिधा का हांढदअ।<verse eid="MAT 16:4" /></para>
  <para style="s">फरीसी अर सदुकी पंथे लोगे शिक्षो सज़ेल़अ</para>
  <para style="r">(<ref loc="MRK 8:14-21">मार्कुस 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />च़ेल्‍लै बिस्सरुऐ गलील समुंदरा पार डेऊंदी रोटी संघा निंणै। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हेरे, फरीसी अर सदुकी मणछे सज़ेल़ै का रहै दूर।”</char><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />तिंयां लागै आप्पू मांझ़ै सोठदै कि हाम्हैं रोटी ता आणी निं! तै आसा अह लागअ द हाम्हां लै एही गल्‍ला बोल्दअ। <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />ईशू हेरी तिन्‍नें मन्‍नें गल्‍ल भुझ़ी अर तेऊ बोलअ तिन्‍नां लै इहअ, <char style="wj">“मणछो, तम्हां भाल़ किहअ बैहम हआ पल़अ द! तम्हैं किल्है आसा इहअ सोठदै लागै दै कि तम्हां का निं रोटी आथी?</char> <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><char style="wj">तम्हैं कै अज़ी बी निं समझ़ै आथी? पांज़ा रोटी करै ज़ुंण पांज़ हज़ार मणछ रज़ैऊऐ तै, सह आद तम्हां आथी निं? तम्हैं पिछ़ू बच़ै दै रोटीए केतरै च़ठै च़कै तै?</char> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="wj">तिंयां च़ार हज़ार मणछा लै सात रोटी बी बिस्सरुऐ? तिधी तम्हैं बाकी बच़ी दी रोटीए केतरै च़ठै च़कै तै?”</char> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" /><char style="wj">“तम्हैं किल्है निं समझ़ै कि मंऐं निं तम्हां लै रोटीए बारै कधि बोलअ आथी! फरीसी अर सदुकी मणछे सज़ेल़ै ज़ेही शिक्षा का रहै दूर।”</char><verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />तेखअ आई तिन्‍नां समझ़ कि ईशू निं रोटीए सज़ेल़ै का दूर रहणा लै बोलअ, पर तेऊ बोलअ फरीसी अर सदुकी पंथे लोगे शिक्षा का दूर रहणा लै।<verse eid="MAT 16:12" /></para>
  <para style="s">पतरासो ईशू लै “मसीहा” बोल़णअ</para>
  <para style="r">(<ref loc="MRK 8:27-30">मार्कुस 8:27-30</ref>; <ref loc="LUK 9:18-21">लूका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />ईशू आअ कैसरिया अर फलिप्पी नेल़ गराऊंऐं अर सह लागअ आपणैं च़ेल्‍लै का पुछ़दअ, <char style="wj">“लोग मुंह मणछे पूता लै किज़ै बोला कि हुंह कुंण आसा?”</char><verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />तेखअ बोलअ तिन्‍नैं, “कोई बोला ताल्है जोहन्‍ना डुबकी दैणैं आल़अ, कई लोग बोला एलियाह। कई लोग बोला कि अह आसा परमेशरो गूर जेरमयाह या तिन्‍नां मांझ़ै कोई एक ज़ण्हअ।”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />तेखअ पुछ़अ तेऊ तिन्‍नां का, <char style="wj">“तम्हैं किज़ै बोला मुल्है? हुंह कुंण आसा?”</char><verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />शमौन पतरासै बोलअ, “तूह आसा ज़िऊंदै परमेशरो पूत मसीहा।”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ईशू बोलअ तेऊ लै, <char style="wj">“शमौन, जोने शोहरूआ, परमेशर आसा ताह करै खुश। अह गल्‍ल निं लोहू अर मास्सा करै हुई। पर मेरअ बाब ज़ुंण स्वर्गै आसा, तेऊ किई अह गल्‍ल ताह दी प्रगट।</char> <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><char style="wj">हुंबी बोला ताल्है इहअ कि तूह आसा पतरास</char><note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="fq" closed="false">पतरास </char><char style="ft" closed="false">मतलब टोल्हा ज़िहअ</char></note>, <char style="wj">तूह हणीं तैहा टोलीए आथरी ज़ुंण मुंह बणाणीं। जम्पर बी निं तेता का ज़िती सकदी।</char><verse eid="MAT 16:18" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 16:19" />
    <char style="wj">“मुंह दैणीं ताल्है स्वर्ग राज़े कुंज़ी, अर ज़ुंण बी तूह पृथूई दी तिन्‍नां मणछा लै रोक्‍के, सह रोक्‍कणअ स्वर्गै अर ज़ुंण बी तूह पृथूई दी ज़ाज़त दैए, तेता लै भेटणीं स्वर्गै ज़ाज़त।”</char><verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै चतैनगी दैई, <char style="wj">“इहअ निं कोही का खोज़ी कि हुंह आसा मसीहा।”</char><verse eid="MAT 16:20" /></para>
  <para style="s">आपणीं मौते बारै ईशूओ पैहलै ई खोज़णअ</para>
  <para style="r">(<ref loc="MRK 8:31-33">मार्कुस 8:31-33</ref>; <ref loc="LUK 9:22">लूका 9:22</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />तेखअ लागअ होर बी ईशू आपणैं च़ेल्‍लै का खोज़दअ, <char style="wj">“मुंह लागणअ एरुशलेम नगरी लै ज़रूर डेऊणअ कि सैणैं, बडै प्रोहत अर शास्त्री लोगे हाथै हुंह दुख ज़िरे अर तिन्‍नें हाथै मरूं अर हुंह चिऊथै धैल़ै हुंह भिई ज़िऊंदअ होए।”</char> <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />ऐहा गल्‍ला लै निंयं पतरासै सह ज़ुदअ ज़िहअ, संघा लागअ सह ईशू लै बोल्दअ, “हे प्रभू, परमेशर नां करे कि ताह संघै कधि इहअ होए।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />ईशू बोलअ पतरासा बाखा फिरी, <char style="wj">“हे राख्स, मुंह सेटा का हट दूर। ताह बाती आसा राख्स बोल्दअ। किल्हैकि तूह लाआ परमेशरे गल्‍ला छ़ाडी मणछे गल्‍ला दी मन्‍न।”</char><verse eid="MAT 16:23" /></para>
  <para style="s">ईशू पिछ़ू हांढणेओ मतलब</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">मार्कुस 8:34—9:1</ref>; <ref loc="LUK 9:23-27">लूका 9:23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै, <char style="wj">“ज़ुंण बी मेरअ च़ेल्‍लअ हणअ च़ाहे, सह निं तिन्‍नां गल्‍ला करी सकदअ ज़ुंण तेऊओ दिल च़ाहा। तेऊ लागणअ अपराधी ज़िहअ दाह-दुख ज़िरी आपणअ क्रूस आपणीं कान्हा आप्पै च़कणअ।”</char><verse eid="MAT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 16:25" />
    <char style="wj">“किल्हैकि ज़ुंण बी ऐहा पृथूई दी आपणीं ज़िन्दगी बच़ाऊंणी च़ाहे, सह करा परमेशरा संघै सदा रहणैं आल़ी ज़िन्दगी बरैबाद, ज़ुंण मुंह दी विश्वास करनै पिछ़ू आपणैं प्राण दैए, तेऊ भेटणीं परमेशरा संघै सदा लै ज़िन्दगी।</char> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><char style="wj">ज़ै मणछ सारै संसारा आपणैं बशै करी सोभी गल्‍ला दी सेठ बणें अर आपणैं प्राण शोटे, तेऊ लै कै फाईदअ हणअ? या मणछा लै आपणीं ज़ानीं का ज़ादै किम्मती किज़ै आसा?</char><verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />
    <char style="wj">“हुंह मणछो पूत एछणअ आपणैं स्वर्ग दूता संघै आपणैं बाबे प्रतप्पा अर तैहा घल़ी भेटणअ हरेकी तेऊए कामें साबै फल।</char> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि तम्हैं ज़ुंण इधी आसा, तम्हां मांझ़ै आसा कई इहै बी, तिन्‍नां लै निं तेभै तैणीं मौत एछणी ज़ेभै तैणीं हुंह मणछो पूत आपणैं स्वर्ग दूता संघै फिरी निं एछी जाए।”</char><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">च़ेल्‍लै का शुझुअ ईशू मोसा अर एलियाह संघै</para>
  <para style="r">(<ref loc="MRK 9:2-13">मार्कुस 9:2-13</ref>; <ref loc="LUK 9:28-36">लूका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />छ़हा धैल़ी बाद निंयैं ईशू पतरास, याकब अर तेऊओ भाऊ जोहन्‍ना सोभै ज़ण्हैं कांगनरांगै दी एकी धारा प्रैंदा लै संघा। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />तिधी बधल़ूई ईशूए काया तिन्‍नें सम्हनै एही कि ईशूओ मुंह लागअ सुरज़ा ज़िहअ च़मकदअ अर झिकल़ै हुऐ प्रैश्शै ज़िहै शेतै। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />च़ेल्‍लै का शुझुऐ तिधी कि मोसा अर एलियाह आऐ संघा लागै ईशू संघै गल्‍ला करदै।<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />इहअ भाल़ी बोलअ पतरासै ईशू लै, “हे प्रभू, अह हुअ ठीक कि हाम्हैं आसा इधी, ज़ै तेरी ज़ाज़त आसा, तै बणाणैं हाम्हां इधी चअन मंडप, एक ताल्है, एक परमेशरे गूर मोसा लै अर एक एलियाह गूरा लै।”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />पतरास त बोल्दअ ई लागअ द कि शेतअ बादल़ घोर्हुअ तिन्‍नां प्रैंदै अर बादल़ा पिछ़ू का शूणअ तिन्‍नैं परमेशर इहअ बोल्दअ, “अह आसा मेरअ पूत, हुंह झ़ूरा एऊ लै सोभी का खास्सअ एऊ करै आसा हुंह खुश, एऊए शूणां ज़िहअ तम्हां लै बोले तिहअ।” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />इहअ शूणीं फिरै च़ेल्‍लै धरनीं उटै अर तिंयां डरै खास्सै।<verse eid="MAT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7" />ईशू आअ तिन्‍नां सेटा संघा छ़ुंहैं, तेखअ बोलअ इहअ, <char style="wj">“खल़ै उझ़िआ, डरा निं आथी।”</char> <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />तेखअ भाल़अ तिन्‍नैं उझै फेर अर ईशू छ़ाडी निं तिन्‍नां आप्पू संघै होर कोहै शुझुअ।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />ज़ांऊं तिंयां धारा का उंधै तै होथदै लागै, ईशू दैनअ तिन्‍नां लै बाता-हांढदी इहअ हुकम, <char style="wj">“ज़ेभै तैणीं मुंह मणछे पूता परमेशर मरी करै भिई ज़िऊंदै निं करी हेरे, तेभै तैणीं निं इना गल्‍ला कोही का खोज़ी ज़ुंण तम्हैं आझ़ धारा प्रैंदै भाल़ी।”</char><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />तेखअ पुछ़अ च़ेल्‍लै ईशू का, “तै ईंयां यहूदी शास्त्री किल्है बोला इहअ कि मसीहा का आजी एलियाह गूरो पैहलै एछणअ आसा ज़रूरी।”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ईशू बोलअ, <char style="wj">“अह गल्‍ल आसा शुची कि परमेशरै आसा आप्पै बोलअ द कि एलियाह एछणअ अर तेऊ करनै कई लोग मसीहा एछणें धैल़ी लै तैर।</char> <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><char style="wj">पर हुंह खोज़ा तम्हां का सत्त कि एलियाह आसा गअ द, तिन्‍नैं निं सह बछ़ैणअ ई आथी। ज़िहअ तिन्‍नें दिलै बोलअ तिहै किऐ तिन्‍नैं तेऊ लै ज़ुल्म। इहै ई ज़िरनै मुंह मणछे पूता बी तिन्‍नें हाथै दुख।”</char><verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />च़ेल्‍लै समझ़अ इहअ कि अह आसा लागअ द हाम्हां लै जोहन्‍ना डुबकी दैणैं आल़ेए बारै बोल्दअ।<verse eid="MAT 17:13" /></para>
  <para style="s">मिर्गिए बमारी आल़अ लान्हअ किअ नरोगअ</para>
  <para style="r">(<ref loc="MRK 9:14-29">मार्कुस 9:14-29</ref>; <ref loc="LUK 9:37-43">लूका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />ज़ांऊं तिंयां खास्सै मणछा सेटा पुजै, एक मणछ आअ तिन्‍नां सेटा अर माथअ टेक्‍की करै लागअ सह बोल्दअ, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" /><char style="wj">“हे प्रभू, मेरै शोहरू लै कर झींण, तेऊ पल़ा मिर्गिए दौरै, केभै बधल़िआ सह तेता करै पाणीं जैंदरी अर केभै बधल़िआ सह आगी जैंदरी। तेऊ हआ तेता करै खास्सी तकलिफ। </char> <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" /><char style="wj">मंऐं बोलअ तेरै च़ेल्‍लै का बी कि एऊ भूता काढा एऊ का पोर्ही। पर तिंयां निं एऊ नरोगै करी सकै।”</char><verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हे बैहम करनै आल़ै हठी लोगो, मुंह कधू तैणीं रहणअ तम्हां संघा कि तम्हैं विश्वास करे? मुंह केभै तैणीं रहणअ तम्हां न्हैल़ै लागी कि तम्हैं भरोस्सअ करे? ओर्ही आणा एऊ लान्हैं इधी मुंह सेटा लै!”</char> <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />तेखअ नैरअ ईशू सह भूत अर भूत निखल़अ तेऊ का दूर अर सह शोहरू हुअ तेभी नरोगअ।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />तेखअ पुछ़अ च़ेल्‍लै ईशू का कांगनरांगै डेऊई, हाम्हैं एऊ शोहरू दी शाचै दै भूता किल्है निं काढी सकै?<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं निं परमेशरे शगती दी विश्वास करदै, ज़ै थारअ विश्वास शाऊईए दाणैं बराबर धख ज़िहअ बी होए, ज़ै तम्हैं ऐहा धारा लै बी बोले कि इधा का पेछ़ुई करै डेऊ दुजी बाखा लै, सह डेऊणीं अर तम्हैं सका सोभै गल्‍ला करी।</char></para>
  <para style="p" vid="MAT 17:20">
    <char style="wj">“इहै भूत निं प्राथणां अर ब्रत करनै बाझ़ी निखल़दै।”</char><verse eid="MAT 17:20" /></para>
  <para style="s">ईशू बोलअ भिई आपणीं मौत हणें बारै</para>
  <para style="r">(<ref loc="MRK 9:30-32">मार्कुस 9:30-32</ref>; <ref loc="LUK 9:43-45">लूका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 17:21" />ज़ांऊं च़ेल्‍लै गलील मुल्खै तै कठा हुऐ दै ईशू बोलअ तिन्‍नां लै, <verse eid="MAT 17:21" /><verse number="22" style="v" sid="MAT 17:22" /><char style="wj">“हुंह मणछो पूत बझ़ैल़णअ धोखै करै मेरै दुशमणा का कैद करनै अर तिन्‍नां पाणअ हुंह मारी।</char> <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" /><char style="wj">पर हुंह हणअ मरी करै चिऐ धैल़ै भिई ज़िऊंदअ।”</char> ऐहा गल्‍ला शूणीं हुऐ च़ेल्‍लै खास्सै दुखी।<verse eid="MAT 17:23" /></para>
  <para style="s">परमेशरे भबना लै कारअ दैणअ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />ज़ांऊं ईशू अर तेऊए च़ेल्‍लै कफरनहूम नगरी पुजै, तिधी पुछ़अ एकी लै कारै गराहणै आल़ै पतरासा का, “थारअ गूरू परमेशरे भबना लै कारअ बी दैआ कि नांईं?” पतरासै बोलअ, “हाँ, दैआ ता दैआ।”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />ज़ांऊं पतरास घअरै पुजअ, तेऊए पुछ़णै का आजी हेरअ ईशू तेऊ लै बोली, <char style="wj">“शमौन, तूह कै समझ़ा? कि ईंयां पृथूईए राज़ै च़ंदअ या कारअ कहा-कहा का मांगा? आपणैं शोहरू या पराऐ का?”</char></para>
  <para style="p" vid="MAT 17:25">पतरासै बोलअ, “पराऐ का।”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />ईशू बोलअ तेऊ लै, <char style="wj">“एऊ साबै गऐ तै शोहरू कारै दैणैं बच़ी।</char><verse eid="MAT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27" />
    <char style="wj">“तैबी बी दैणअ हाम्हां बी कारअ ताकि तिंयां नराज़ नां होए। तूह कर इहअ, समुंदरे बाढै डेऊ अर कांडअ पाआ म्हाछ़ली लै, ज़ुंण म्हाछ़ली पैहलै तेथ शाचे तैहा आणै। म्हाछ़लीए खाख खोल्ही भेटणअ ताह एक च़ंदीओ सिक्‍कअ, अर तेऊ निंईं दैऐ मेरै अर आपणैं बदल़ै कारअ।”</char><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">स्वर्गे राज़ा दी सोभी का बडअ</para>
  <para style="r">(<ref loc="MRK 9:33-37">मार्कुस 9:33-37</ref>; <ref loc="LUK 9:46-48">लूका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />एता बाद डेऊऐ च़ेल्‍लै ईशू सेटा लै पुछ़दै, “स्वर्ग राज़ा दी सोभी का बडअ कुंण आसा?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />ऐहा गल्‍ला शूणीं ईशू एक होछ़अ ज़िहअ लान्हअ आप्पू सेटा शादी करै तिन्‍नां मांझ़ै खल़अ किअ संघा बोलअ, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><char style="wj">“हुंह खोज़ा तम्हां का सत्त कि, ज़ै तम्हैं आपणीं ज़िन्दगी नांईं बदल़े अर लान्हैं ज़िहै भोल़ै नांईं बणें, तै निं तम्हैं स्वर्ग राज़ा दी डेऊई सकदै।</char> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" /><char style="wj">ज़ुंण बी आप्पू एऊ लान्हैं ज़िहअ भोल़अ बणें, सह हणअ स्वर्ग राज़ा दी बडअ।</char><verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />
    <char style="wj">“ज़ुंण बी मेरै नाओंऐं एक इहै लान्हें कदर करे, सह करा मेरी कदर।</char><verse eid="MAT 18:5" /></para>
  <para style="s">पाप करने परिक्षा</para>
  <para style="r">(<ref loc="MRK 9:42-48">मार्कुस 9:42-48</ref>; <ref loc="LUK 17:1">लूका 17:1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />
    <char style="wj">“ज़ुंण मुंह दी विश्वास करनै आल़ै इना लान्हैं ज़िहै भोल़ै मणछा का पाप कराऊआ, तेऊ लै दैणीं परमेशरा सज़ा। तेऊ लै हणअ त इहअ भलअ कि तेऊए गल़ै बडअ थरेट बान्हीं पाणअ त सह समुंदरै डबेऊई।</char><verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />
    <char style="wj">“तिन्‍नां लै हणीं घोर आफ़त! ज़ुंण होरी का पाप कराऊआ। खरी रहा संसारै एछदी लागी पर तेऊ मणछा लै हणीं घोर आफ़त ज़ुंण होरी का बी पाप कराऊआ।</char><verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />
    <char style="wj">“ज़ै तूह आपणैं हाथा खूरा करै पाप करा, तिन्‍नां कर आप्पू का दूर च़ाऐ ताह तिंयां काटणै किल्है निं पल़े। लाट्टअ-टुंडअ हई सदा रहणैं आल़ी ज़िन्दगी लै डेऊणअ आसा ताल्है एता का भलअ कि दुही हाथा अर दुही खूरा संघै तूह जम्परीए आगी दी पल़े।</char><verse eid="MAT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 18:9" />
    <char style="wj">“ज़ै तेरी आछी का भाल़ी तेरै भलै पाप हआ, तिन्‍नां पापा दी पाणै आल़ी गल्‍ला भाल़णैं छ़ाड। च़ाऐ ताह सह आछ ई किल्है निं पल़े ताह पोर्ही काढणीं। कांणै हई सदा रहणैं आल़ी ज़िन्दगी लै डेऊणअ आसा एता का भलअ कि दुही आछी रहंदी तूह जम्परीए आगी दी पल़े।</char><verse eid="MAT 18:9" /></para>
  <para style="s">लुक्‍की दी भेडे कथ्या</para>
  <para style="r">(<ref loc="LUK 15:3-7">लूका 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <char style="wj">“धैन डाहै तम्हैं निं इना होछ़ै लान्हैं मांझ़ै कोही बी बृथा समझ़ी। किल्हैकि हुंह बोला तम्हां लै इहअ कि इने हेर-सभाल़ करनै आल़ै स्वर्ग दूत रहा स्वर्गै हर बगत मेरै बाब परमेशरा सेटा।</char> <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><char style="wj">किल्हैकि हुंह मणछो पूत आसा शोठुऐ दै बच़ाऊंदअ आअ द।</char><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />
    <char style="wj">“तम्हैं किज़ै समझ़ा? ज़ै कहा मणछे शौ भेडा होए, अर तिन्‍नां मांझ़ै एक भेड़ कबाता पेठे, तै कै नडिनुंऐं भेडा छ़ाडी सह नाल़ै-धारा हर ज़ैगा तैहा लुक्‍की दी भेडा लोल़अ निं डेऊणअ?</char><verse eid="MAT 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 18:13" />
    <char style="wj">“ज़ांऊं सह भेड़ भेटी जाए, हुंह खोज़ा तम्हां का सत्त कि सह निं तिन्‍नां नडिनुंऐं भेडा लै ज़ुंण तेऊ ई सेटा ती, तेतरी खुशी निं तेऊ हणीं, ज़ेतरअ कि ऐहा भेडा लै खुश हुअ।</char> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><char style="wj">इहअ ई थारै बाबे ज़ुंण स्वर्गै भेडा आसा, सह निं इहअ च़ाहंदअ कि इना होछ़ै मांझ़ै एक बी बरैबाद होए।</char><verse eid="MAT 18:14" /></para>
  <para style="s">ज़ुल्म करनै आल़ै संघै बर्ताअ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <char style="wj">“ज़ै तेरअ साथी-भाई ताल्है ज़ुल्म करे, कांगनरांगै डेऊई तेऊ संघै गल्‍ला, संघा दैऐ तेऊ समझ़ाऊंणी। ज़ै सह तेरी शुणें, तै गअ ताह आपणअ भाई भेटी।</char> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><char style="wj">ज़ै सह नांईं शुणें, तै निंऊं दूई मणछ आप्पू संघै होर किल्हैकि बधाने साबै लोल़ी हरेक गल्‍ला दूई या चिई शाजते सम्हनै हुई।</char><verse eid="MAT 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 18:17" />
    <char style="wj">“ज़ै सह तिन्‍नें बी नांईं शुणें, तै खोज़ ऐहा गल्‍ला विश्वासीए टोली मांझ़ै। पर ज़ै सह तिन्‍नें बी नांईं शुणें, तै समझ़ै तेऊ तूह होरी ज़ातीओ अर कारै मांगणै आल़ै मणछा ज़िहअ ज़ुंण परमेशर।</char><verse eid="MAT 18:17" /></para>
  <para style="s">रोक्‍कणअ अर मोक्‍कअ दैणअ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि ज़ुंण बी तूह पृथूई दी तिन्‍नां मणछा लै रोक्‍के, सह रोक्‍कणअ स्वर्गै अर ज़ुंण बी तूह पृथूई दी ज़ाज़त दैए, तेता लै भेटणीं स्वर्गै ज़ाज़त।</char><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />
    <char style="wj">“तेखअ बोला हुंह तम्हां लै इहअ बी, ‘ज़ै तम्हां मांझ़ै दूई ज़ण्हैं पृथूई दी किछ़ी बी गल्‍ला मांगणा लै एक मन्‍न होए, तिंयां गल्‍ला हेरनी स्वर्गै रहणैं आल़ै तिन्‍नें बाब परमेशरा तिन्‍नां लै दैई।</char> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><char style="wj">किल्हैकि ज़िधी दूई या चअन ज़ण्हैं मेरै नाओंऐं कठा हआ, तिधी हआ हुंह आप्पू तिन्‍नां संघै।’”</char><verse eid="MAT 18:20" /></para>
  <para style="s">नर्दैई दासे कथ्या</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />तेखअ बोलअ पतरासै, “हे प्रभू, ज़ै मेरअ साथी-संघी मुल्है ज़ुल्म करे, तै हुंह केतरी बारी छ़ाडूं तेऊ लै माफी? साता बारी छ़ाडूं तेऊ लै माफी?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />ईशू दैनअ तेऊ लै ज़बाब, <char style="wj">“हुंह निं ताल्है बोल्दअ कि सिधअ साता बारी कर तेऊ माफ। पर साता बारीए सत्तर गुणा करी छ़ाडै तेऊ लै माफी।</char><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />
    <char style="wj">“तैही आसा स्वर्गो राज़ इहै राज़ै ज़िहअ, ज़ुंणी आपणैं दासा का साब-कताब करनअ च़ाहअ।</char> <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" /><char style="wj">ज़ांऊं सह साबा-कताब लंदअ लागअ, एक मणछ आअ तेऊ सेटा लै इहअ, तेऊ त राज़ैओ दसा हज़ार सुन्‍नें सिक्‍कैओ ऋण।</char> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" /><char style="wj">पर तेऊ का नांईं त ऋण भरना लै एक धेल्‍लअ बी आथी! तेखअ बोलअ तेऊए मालकै तेऊ लै इहअ, ‘अह अर एऊए बेटल़ी अर एऊए सारी ज़ैदात पाआ बेच़ी अर तेता करै करा एऊओ ऋण पूरअ।’”</char><verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />
    <char style="wj">“इहअ शूणीं किई तेऊ दासै आपणैं मालके पैरै पल़ी एही अरज़, ‘हे मालक, सबर कर, हुंह भरूं तेरअ सारअ ऋण।’</char> <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" /><char style="wj">तेखअ फिरी तेऊ मालका तेऊ दासे झींण अर तेऊओ ऋण माफ करी छ़ाडअ सह तिधा का घअरा लै।</char><verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />
    <char style="wj">“पर ज़ांऊं सह दास बागै निखल़अ, तेऊ भेटअ आपणअ साथी दासा मांझ़ै एक ज़ण्हअ। तेऊ तै तेऊ लै शौ च़ंदीए सिक्‍कै ऋण दैनअ द, अर तेऊ ढाकअ सह गल़ा का संघा बोलअ तेऊ लै इहअ, ‘ज़ेतरअ बी ताह मेरअ ऋण आसा, तेऊ दै एभी मुल्है बापस।’</char><verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />
    <char style="wj">“ऐहा गल्‍ला शूणीं लागअ तेऊओ साथी दास तेऊए पैरै पल़ी लेरा लाई अरज़ करदअ, ‘सबर कर, हुंह भरूं तेरअ सारअ ऋण।’</char> <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" /><char style="wj">पर तेऊ निं तेऊए गल्‍ला मनी अर सह किअ तेऊ इहअ बोली कैद खानै बंद, ‘ज़ेभै तैणीं तूह मेरअ ऋण नांईं भरे, तेभै तैणीं रहणअ तूह इधी बंद।’</char><verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />
    <char style="wj">“तेऊए होरी साथी दासै ज़ुंण तेऊ संघै हुअ त, तिंयां हुऐ तेता भाल़ी खास्सै दुखी अर तिन्‍नैं खोज़ी ईंयां सारी गल्‍ला आपणैं मालका का।</char> <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" /><char style="wj">तेखअ शादअ सह दास तेऊए मालकै संघा बोलअ तेऊ लै, ‘ओ कदुष्ट मणछा, तंऐं ज़ेभै मुखा मेरै पैरै पल़ी अरज़ किई, मंऐं ता तेभै तेरअ सारअ ऋण माफ किअ!</char> <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" /><char style="wj">ज़ेही मंऐं ताल्है झींण किई, ताह बी लागा ती आपणैं साथी लै तेही ई झींण करनी!’</char><verse eid="MAT 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34" />
    <char style="wj">“मालका आई तेऊ लै बेघै खास्सी रोश्शै अर सह सभाल़अ तेऊ कैद खानै सज़ा दैणैं आल़ै का। संघा डाहअ तिन्‍नां लै इहअ बोली, ‘ज़ेभै तैणीं अह मेरअ सारअ ऋण भरी निं मुक्‍के, तेभै तैणीं निं एऊ बागै छ़ाडी।’</char><verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />
    <char style="wj">“ठीक इहअ ई करा तम्हैं बी आपणैं साथी-संघी लै आपणैं तत्त-दिला का पाप माफ। ज़ुंण तत्त-दिला का माफ नां करे, मेरअ बाब परमेशर ज़ुंण स्वर्गै आसा, तै निं तेऊ बी तम्हैं माफ करनै।”</char><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">बैईदाऊअ दैणें बारै ईशूए शिक्षा</para>
  <para style="r">(<ref loc="MRK 10:1-12">मार्कुस 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />ज़ांऊं ईशू इना गल्‍ला करी मुक्‍कअ, सह लागअ गलील मुल्खा का हांढदअ, संघा पुजअ जरदण नदी पारा बाखा यहूदा मुल्खै। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ईशू पिछ़ू आऐ खास्सै मणछ, अर ईशू किऐ तिंयां हर दुख तकलिफी का दूर करी नरोगै।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />फरीसी पंथे लोग बी आऐ तेखअ ईशू सेटा, संघा लागै तेऊ इहअ पुछ़ी परखदै, संघा लागै तिंयां ईशू लै बोल्दै, “हरेक गलती पिछ़ू कै मर्धा आपणीं बेटल़ी छ़ाडणीं ठीक आसा?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं कै इहअ पहल़अ निं आथी कि ज़ुंणी तिंयां बणाऐं, तेऊ बणाऐं तिंयां शुरू ई का मर्ध अर बेटल़ी, संघा बोलअ तिन्‍नां लै इहअ,</char><note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">मूल. 1:27</ref>; <ref loc="GEN 5:2">5:2</ref>; <ref loc="GEN 2:24">2:24</ref>; <ref loc="MRK 10:6">मार्क. 10:6</ref></char></note><verse eid="MAT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 19:5" />
    <char style="wj">“तैही रहणैं तिंयां आपणैं ईजा-बाबा का ज़ुदै आपणीं बेटल़ी संघै, अर तिंयां दुहै हणैं एक देही?</char> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><char style="wj">तैही निं तिंयां ऐबै दूई देही आथी पर तिंयां रहा एक देही बणी। इहअ करै ज़ुंण परमेशरै आसा ज़ोल़ै दै, तिन्‍नां ज़ुदै करदै निं तम्हैं लागा।”</char><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />तेखअ बोलअ तिन्‍नैं ईशू लै, “तै परमेशरे गूर मोसा लिखै दै बधाना दी इहअ किल्है आसा लिखअ कि बैईदाऊअ लिखी सका आपणीं बेटल़ी छ़ाडी?”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">बधा. 24:1-4</ref>; <ref loc="MAT 5:31">मोत्त. 5:31</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“मोसा पल़अ एते तैणीं लिखणअ कि थारै मन्‍न तै काठै हुऐ दै, ज़ै तम्हां मनणअ ई नांईं त आथी, तै दैनअ तेऊ इहअ हुकम कि बेटल़ी लै दुखा दैणैं का दैआ तैहा बैईदाऊअ करी छ़ाडी। पर शुरू का निं इहअ बधान आथी थिअ।</char><verse eid="MAT 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 19:9" />
    <char style="wj">“पर हुंह बोला तम्हां लै इहअ कि ज़ुंण बी कंज़रैई का सुआई किज़ू होरी गल्‍ला पिछ़ू आपणीं बेटल़ी छ़ाडी दुजी बेटल़ी संघै बैह करे, सह करा कंज़रैई करनैओ पाप। ज़ुंण छ़ाडी दी बेटल़ी संघै बैह करा, सह मणछ बी आसा कंज़रअ।”</char><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />तेखअ बोलअ च़ेल्‍लै ईशू लै, “ज़ै इहअ आसा, तै आसा बैहा करनै का एही रहणअ भलअ।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“सोभ निं ऐहा गल्‍ला मनी सकदै, एता सका सिधै तिंयां मनी ज़हा लै परमेशरै एता मनणैओ बरदान आसा दैनअ द।</char> <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" /><char style="wj">कई आसा हुऐ ज़ल्मां ओर्ही दपुर्षै। कई आसा इहै ज़ुंण मणछै आसा दपुर्षै बणाऐं दै। पर कई आसा इहै ज़ुंण स्वर्ग राज़ा लै आसा दपुर्षै बणै दै। ज़ुंण ऐहा गल्‍ला लै सैहमत आसा, सह मने।”</char><verse eid="MAT 19:12" /></para>
  <para style="s">लान्हैं लै बर्गत</para>
  <para style="r">(<ref loc="MRK 10:13-16">मार्कुस 10:13-16</ref>; <ref loc="LUK 18:15-17">लूका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />लोगै आणै लान्हैं ईशू सेटा कि तिन्‍नां दी हाथ लाई ईशू प्राथणां करे, पर च़ेल्‍लै लागै तिन्‍नां पिछ़ू रहणा लै बोल्दै।<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“लान्हैं दैआ मुंह सेटा लै एछणैं, इना निं रोक्‍का, किल्हैकि इना लान्हैं ज़िहै मणछो ई आसा स्वर्गो राज़।”</char> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />तेखअ दैनी ईशू तिन्‍नां लान्हें मुंडै हाथ फेरी तिन्‍नां लै बर्गत। संघा लागअ तिधा का हांढदअ।<verse eid="MAT 19:15" /></para>
  <para style="s">सेठ ज़ुआन मणछ अर सदा रहणैं आल़ी ज़िन्दगी</para>
  <para style="r">(<ref loc="MRK 10:17-31">मार्कुस 10:17-31</ref>; <ref loc="LUK 18:18-30">लूका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />एक मणछ आअ ईशू सेटा, संघा लागअ इहअ बोल्दअ, “हे गूरू, हुंह इहअ किज़ै भलअ करूं ज़ेता करै हुंह सदा रहणैं आल़ी ज़िन्दगी लै डेऊई सके?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ईशू बोलअ तेऊ लै, <char style="wj">“तूह मुखा भलाईए बारै किल्है पुछ़ा? परमेशरा सुआई निं होर कोह भलअ आथी। पर ज़ै तूह सदा रहणैं आल़ी ज़िन्दगी लै डेऊणअ च़ाहा, तेता लै मन तेऊओ बधान ज़िहअ सह बोला तिहअ।”</char><verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />तेऊ मणछै बोलअ ईशू लै, “बधानो कुंण ज़िहअ हुकम मनूं?”</para>
  <para style="p" vid="MAT 19:18">ईशू बोलअ तेऊ लै, <char style="wj">“हत्या निं करनी, नां कंज़रै हणअ, नां च़ोरी करनी अर नां झ़ुठी शाजत निं दैणीं। </char> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="wj">आपणैं ईजा-बाबो करनअ अदर अर होरी लै झ़ूरनअ तिहअ ज़िहअ तूह आप्पू लै झ़ूरा।”</char><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />तेखअ बोलअ तेऊ ज़ुआन मणछै ईशू लै, “इना गल्‍ला मना हुंह होछ़ी उझै! ऐबै मुंह दी किज़ै कामीं आसा?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ईशू बोलअ तेऊ लै, <char style="wj">“ज़ै तूह सिध्द हणअ च़ाहा, तै डेऊ, अर आपणीं ज़ैदात बेच़ पठी संघा बांड तेता रैनै-गरीबा लै। ताह जाणअ धन स्वर्गै भेटी। आप्पू च़ाल्‍ल तूह मुंह संघै।”</char><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />ऐहा गल्‍ला शूणीं हुअ सह ज़ुआन मणछ खास्सअ दुखी, किल्हैकि सह थिअ खास्सअ सेठ।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि धन-माया आल़ै मणछो आसा स्वर्ग राज़ा दी डेऊणअ बडअ कठण।</char> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" /><char style="wj">भिई बोला हुंह तम्हां का इहअ, ‘परमेशरे राज़ा दी सेठा आल़ै मणछो डेऊणैं का सान आसा ऊँटो सिऊंणीए पाशी बाती निखल़णअ।’”</char><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />इहअ शूणीं हुऐ च़ेल्‍लै रहैन! तेखअ लागै इहअ बोल्दै, “एऊ साबै निं च़ाल्‍लअ कोहिओ उद्धार हई! तै कुंण सका स्वर्गै डेऊई?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ईशू बोलअ तिन्‍नां बाखा भाल़ी, <char style="wj">“ज़ुंण मणछे भलै हई निं सकदअ, सह सका परमेशरे भलै हई।”</char><verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />एता लै बोलअ पतरासै, “भाल़, हाम्हैं ता आसा गऐ दै सोभ गल्‍ला छ़ाडी ताह पिछ़ू एछी, तै हाम्हां किज़ै भेटणअ?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि नऊंऐं संसारै ज़ेभै हुंह मणछो पूत आपणैं प्रतप्पे राज़गाद्दी दी बेशणअ, तम्हैं बी ज़ुंण मुंह संघै रहै, तम्हां बी करनअ बारा राज़गाद्दी दी बेशी इज़राईले बारा गोत्रो नसाफ।</char> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><char style="wj">ज़ुंणी बी मेरी तैणीं आपणैं घअर-बण, भाई-बैहण, ई-बाब, शोहरू-माठै, खेच-खहल़, मेरै नाओंऐं छ़ाडे, तेऊ भेटणअ ऐहा ज़िन्दगी दी तेता का खास्सअ फल ज़ुंण तेऊ का पिछ़ू छ़ुटअ अर तेऊ लै हणअ सदा रहणैं आल़ी ज़िन्दगीओ हक।</char> <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><char style="wj">पर इहै आसा खास्सै ज़ुंण आजू आसा, तिंयां हणैं पिछ़ू। ज़ुंण पिछ़ू आसा तिंयां हणैं आजू।”</char><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">दाखे बागा काम करनै आल़ै मणछे कथ्या</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />
    <char style="wj">“स्वर्गो राज़ आसा एकी इहै घअर मालका ज़िहअ, सह डेऊअ दोत्ती-दोत्थी नगरीए च़फै कि सह आपणैं दाखे बागा दी कामां लै मज़दूर लाए।</char> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" /><char style="wj">मालके हुई मज़दूरा संघै सैहमती कि तेऊ दैणीं मज़दूरा लै एक च़ंदीओ सिक्‍कअ तैहा सारी धैल़ीए मज़दूरी। संघा छ़ाडै तिंयां मज़दूर आपणैं दाखे बागा लै कामां करदै।</char><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />
    <char style="wj">“तेखअ शुझुऐ तेऊ मालका का एकी पहरा बाद च़फै होर मणछ खल़्हुऐ दै ज़हा किछ़ै काम निं भेटअ त।</char> <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" /><char style="wj">तेऊ बोलअ तिन्‍नां लै बी, ‘डेओआ, तम्हैं बी करा मेरै दाखे बागा दी काम। ज़ुंण मुंह भलअ लागे तेऊ साबै दैंऊं हुंह तम्हां धैल़ीए मज़दूरी। तिंयां बी डेऊऐ दाखे बागा दी कामां करदै।’</char> <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" /><char style="wj">तेखअ दुजै अर चिऊथै पहरै बी भेटै तेऊ च़फै इहै मणछ ज़हा तैहा धैल़ी किछ़ै काम निं भेटअ त, तिंयां बी छ़ाडै तेऊ आपणैं बागा लै कामां करदै।</char><verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />
    <char style="wj">“खिरी च़ाल्‍ली ती सान्ह पल़ी, तेऊ का शुझुऐ होर मज़दूर ज़हा तैहा धैल़ी किछ़ै काम निं भेटअ त! तेऊ बोलअ तिन्‍नां लै बी, ‘तम्हैं किल्है आसा इधी सारी धैल़ी रित्तै खल़्हुऐ दै?’ तिन्‍नैं बोलअ इहअ, ‘हाम्हां निस्सी किधी बी मज़दूरी खटणा लै भेटी।’</char><verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />
    <char style="wj">“तेऊ बोलअ, ‘तम्हैं बी करा मेरै दाखे बागा दी काम।’</char><verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />
    <char style="wj">“धैल़अ उडी बोलअ तेखअ आपणैं भढारी लै इहअ, ‘सोभी कामां करनै आल़ै शाद अर पिछ़लै का पैहलै तैणीं दैऐ सोभी लै बराबर मज़दूरी।’</char> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" /><char style="wj">ज़ांऊं तिंयां सोभ कामां आल़ै आऐ, खिरी ज़ुंण उडै बी कामां करदै आऐ तै, तिन्‍नां बी भेटी पूरी धैल़ीए होरी बराबर मज़दूरी।</char> <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" /><char style="wj">ज़ुंण दोत्ती पैहलै आऐ तै, तिन्‍नैं ज़ाणअ इहअ कि हाम्हां भेटणीं इना होरी का खास्सी धैल़ी पर तिन्‍नां बी भेटी पूरी धैल़ीए तेतरी ई मज़दूरी ज़ुंण तिन्‍नां संघै बाहिदअ त हुअ द।</char><verse eid="MAT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 20:11" />
    <char style="wj">“ज़ांऊं तिन्‍नां मज़दूरी भेटी, तिंयां हुऐ तेऊ मालका का नराज़ अर तेऊ लै लागै इहअ बोल्दै,</char> <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" /><char style="wj">‘ज़ुंण ईंयां खिरी उडै आऐ तै इनै ता सिधअ एकी कहरै किअ काम! पर तंऐं दैनी इना लै हाम्हां बराबर मज़दूरी! ज़ुंणी सारी धैल़ी बोझ़अ च़कअ अर चटाक धुप्पैओ जाम्ह ज़िरअ?’</char><verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />
    <char style="wj">“तेऊ दैनअ तिन्‍नां मांझ़ै एकी लै ज़बाब, ‘भाल़ भाई, मंऐं निं ताह संघै किछ़ै ज़ुल्म किअ, ज़ेऊ साबै तूह दोत्ती कामां करना लै राज्ज़ी हुअ त तेतरी मज़दूरी ता ताल्है पूरी दैनी?</char> <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" /><char style="wj">ज़ुंण तेरअ आसा तेऊ च़क, संघा लाग हांढदअ। अह आसा मेरी मरज़ी कि ज़ेतरअ मंऐं ताल्है दैनअ तेतरअ दैणअ मुंह इना होरी लै बी ज़ुंण ताखा पिछ़ू आसा आऐ दै।</char> <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><char style="wj">अह आसा मेरी मरज़ी कि हुंह आपणैं ढब्बै संघै ज़िहअ च़ाहूं तिहअ करूं? ज़ै हुंह भलअ आसा, तै तंऐं किल्है आसा तेथ टेरी आछ डाही दी लाई?’</char><verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />
    <char style="wj">“ठीक इहै ई ज़ुंण आजू थिऐ, तिंयां हणैं पिछ़ू अर ज़ुंण पिछ़ू थिऐ, तिंयां हणैं आजू।”</char><verse eid="MAT 20:16" /></para>
  <para style="s">मौत अर ज़िऊंदै हणें बारै चिऊथी बारी खोज़णअ</para>
  <para style="r">(<ref loc="MRK 10:32-34">मार्कुस 10:32-34</ref>; <ref loc="LUK 18:31-34">लूका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />तेखअ निंयैं ईशू एरुशलेम नगरी लै डेऊंदी बारी आपणैं बारा च़ेल्‍लै कांगनरांगै अर बाता बोलअ तेऊ तिन्‍नां लै इहअ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" /><char style="wj">“भाल़ा, हाम्हैं च़ाल्‍लै ऐबै एरुशलेम नगरी लै अर हुंह मणछो पूत बझ़ैल़णअ बडै प्रोहत अर यहूदी शास्त्री का कैद करनै। तिन्‍नां बणाणअं मौते सज़ा दैणैं जोगी दोशी।</char> <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" /><char style="wj">तेखअ दैणअ हुंह तिन्‍नां होरी ज़ातीए हाथै ताकि तिंयां मेरअ सुहांग-मखौल करे, कोल़ै करै च़िक्‍के अर क्रूसा दी मारी पाऐ। पर चिऊथै धैल़ै हणअ हुंह भिई ज़िऊंदअ।”</char><verse eid="MAT 20:19" /></para>
  <para style="s">एकी माए अरज़</para>
  <para style="r">(<ref loc="MRK 10:35-45">मार्कुस 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />ज़ांऊं जबदीए शोहरू याकब अर जोहन्‍ने ईज आई अर ईशू सेटा एछी माथअ टेक्‍कअ, सह लागी ईशू का किज़ू मांगदी। <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />तेऊ बोलअ तैहा लै, <char style="wj">“तूह किज़ै च़ाहा?”</char> तैहा बोलअ इहअ, “मेरै ईंयां दूई शोहरू लोल़ी तेरै राज़ा दी तेरी दैहणीं अर बाऊंईं कुछी बेठै।”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ईशू दैनअ तैहा लै ज़बाब, <char style="wj">“तम्हां का निं थोघै कि तम्हैं किज़ै मांगा? ज़ुंण दुखो घुप्पू मुंह झुटणअ तेता कै तम्हैं झुटी सका?”</char> तिन्‍नैं दैनअ ईशू लै तेभी ज़बाब, “हाँ, हाम्हैं सका इहअ करी।”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हाँ, अह आसा सच्च़ी कि तम्हां हेरनअ मुंह ई ज़िहअ दुखो घुप्पू बी झुटी, पर आपणैं दैहणै-बाऊंऐं बशैल़णअ निं मेरअ काम आथी। पर ज़हा लै मेरै बाब परमेशरै ज़ुंण ज़ैगा बणाईं आसा हेरी दी, सह आसा तिन्‍नां लै।”</char><verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />इहअ शूणीं आई तिन्‍नां होरी च़ेल्‍लै तिन्‍नां दूई भाई लै रोश्शै। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />ईशू शादै तिंयां आप्पू सेटा लै संघा बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का आसा ऐहा गल्‍लो थोघ कि ज़ुंण होरी ज़ातीए सैणैं हआ, तिंयां करा तिन्‍नां दी राज़ अर तिन्‍नां मांझ़ै ज़ुंण बडै हआ तिंयां डाहा तिन्‍नां दी हक।</char><verse eid="MAT 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 20:26" />
    <char style="wj">“पर तम्हां मांझ़ै निं इहअ हणअ, पर ज़ुंण बी तम्हां मांझ़ै बडअ हणअ च़ाहे, सह लोल़ी थारअ दासा ज़िहअ बणअ।</char> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" /><char style="wj">ज़ुंण तम्हां मांझ़ै सोभिओ सैणअ बणनअ च़ाहे, सह लोल़ी पैहलै सोभी लै गलामा ज़िहअ मैन्थ करनै आल़अ हुअ।</char> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><char style="wj">ज़िहअ कि हुंह मणछो पूत निं एते तैणीं आथी आअ द किई कुंण मेरी च़ाकरी करे। पर हुंह आसा एते तैणीं आअ द कि हुंह होरीए च़ाकरी करूं अर सोभिए छ़ुटकारै लै आपणीं ज़ान दैंऊं।”</char><verse eid="MAT 20:28" /></para>
  <para style="s">दूई कांणै मणछ ठीक करनै</para>
  <para style="r">(<ref loc="MRK 10:46-52">मार्कुस 10:46-52</ref>; <ref loc="LUK 18:35-43">लूका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />ज़ांऊं तिंयां जेरिहो नगरी का बागै निखल़दै ई तै लागै दै, तिधी आऐ खास्सै मणछ ईशू पिछ़ू। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />दूई कांणै तै बाते बाढै बेठै दै। तिन्‍नैं शूणअ इहअ कि ईशू एसी बाती आसा ईशू डेऊंदअ लागअ द, तिंयां लागै हाक्‍का लाई बोल्दै, “हे प्रभू, दाबेदे लुआद ईशू, हाम्हां लै कर झींण।”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />लोग लागै तिन्‍नां इहअ बोली नैरदै, “च़ुप्पी रहा।”</para>
  <para style="p" vid="MAT 20:31">पर तिंयां लागै होर बी खास्सै लैल़ा लांदै अर बोल्दै, “हे प्रभू, दाबेदे लुआद ईशू, हाम्हां लै कर झींण।”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />ईशू उझ़ुअ खल़अ संघा शादै तिंयां कांणै मणछ आप्पू सेटा लै। तेखअ बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं इहअ किज़ै च़ाहा कि हुंह तम्हां लै करूं?”</char><verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />तिन्‍नैं बोलअ ईशू लै, “हे प्रभू, हाम्हैं च़ाहा इहअ कि तूह कर हाम्हां नरोगै ताकि म्हारी आछी का शुझदअ लागे।” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />ईशू फिरी तिन्‍नें झींण संघा छ़ुंहीं तिन्‍नें आछी अर तिन्‍नां का लागअ तेभी शुझदअ अर तिंयां बी लागै ईशू पिछ़ू हांढदै।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">ज़िती करै एरुशलेम नगरी लै डेऊणअ</para>
  <para style="r">(<ref loc="MRK 11:1-11">मार्कुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लूका 19:28-40</ref>; <ref loc="JHN 12:12-19">जोहन्‍ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />ईशू अर तेऊए बारा च़ेल्‍लै पुजै एरुशलेम नगरी नेल़ जैतून धारा, ज़ुंण बेतफगे गराऊंआं नेल़ आसा। ईशू छ़ाडै आपणैं दूई च़ेल्‍लै गराऊंआं लै। तिन्‍नां लै बोलअ तेऊ इहअ, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" /><char style="wj">“आपणैं सम्हनै एऊ गराऊंऐं डेओआ। तिधी पुजधी भेटणीं तम्हां एक गाधी बान्हीं दी। तैहा संघै भेटणअ तम्हां तेसो एक बच्च़अ। तेऊ आणै तम्हैं खोल्ही मुंह सेटा लै।</char> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" /><char style="wj">ज़ै तम्हां का कुंण पुछ़े, तम्हैं बोलै इहअ कि प्रभू पल़ी एते पग्गर। तेखअ हेरनअ तेऊ सह तम्हां लै दैई।”</char><verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />अह हुअ तैही कि परमेशरे गूरै ईशायाह ज़ुंण बोलअ थिअ, सह लोल़ी पूरअ हुअ,<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“सियोन नगरी का बोला इहअ, ‘भाल़!</para>
  <para style="q" vid="MAT 21:5">तेरअ राज़अ आअ ताह सेटा लै,</para>
  <para style="q" vid="MAT 21:5">सह आसा शरीफ अर तेऊ करनी गाधे शुंआरी,</para>
  <para style="q" vid="MAT 21:5">सह एछणअ गाधीए बच्च़ै प्रैंदै बेशी।’”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />च़ेल्‍लै बी किअ तिहअ ई ज़िहअ-ज़िहअ ईशू तिन्‍नां लै बोलअ त। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />तिन्‍नैं आणअ गाधी अर तेसो बच्च़अ संघा पाऐ तिन्‍नां प्रैंदै आपणैं च़ादरू, अर ईशू बेठअ गाधू प्रैंदै।<verse eid="MAT 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 21:8" />कई लोगै छ़ैऐ आपणैं झिकल़ै बाता अर कई छ़ैई खज़ूरे बूटा का नरम डाल़ी चोल़ी बाता। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ज़ुंण खास्सै मणछ आजू-पिछ़ू हांढदै तै लागै दै, तिंयां लागै ज़ोरै-ज़ोरै बोल्दै,</para>
  <para style="q" vid="MAT 21:9">“राज़ै दाबेदे लुआदे ज़ै-ज़ैकार,</para>
  <para style="q" vid="MAT 21:9">परमेशर ज़ुंण स्वर्गै आसा, सह दैआ तेऊ लै बर्गत ज़ुंण तेऊए नाओंऐं एछा।</para>
  <para style="q" vid="MAT 21:9">परमेशरे ज़ै-ज़ैकार ज़ुंण स्वर्गै आसा।”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />ज़ांऊं ईशू एरुशलेम नगरी पुजअ, सारी नगरी मच़अ हाल्‍लअ-गोल्‍लअ अर लोग लागै बोल्दै, “अह कुंण आसा?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />तेखअ बोलअ कई लोगै, “अह आसा गलील मुल्खे नासरत गराऊंऐं परमेशरो गूर ईशू।”<verse eid="MAT 21:11" /></para>
  <para style="s">ईशू दरल़ाऊऐ परमेशरे भबना का बपारी</para>
  <para style="r">(<ref loc="MRK 11:15-19">मार्कुस 11:15-19</ref>; <ref loc="LUK 19:45-48">लूका 19:45-48</ref>; <ref loc="JHN 2:13-22">जोहन्‍ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ईशू काढै परमेशरे भबनै डेऊई तिंयां सोभ बागा लै। ज़ुंण परमेशरे भबने ताटी ढब्बै-धेल्‍लै बदल़ी लैण-दैण करदै तै लागै दै। संघा पाई सर्फिए मेज़ अर पालल़ी अर भेडा बाकरी बेच़णैं आल़ेए थल़्ही ढोल़ी। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“पबित्र शास्त्रा दी आसा लिखअ द, ‘मेरअ घअर हणअ प्राथणां करनैओ भबन पर तम्हैं मणछै बणाईं अह ज़ैगा बणाईं च़ोरा-डाकू बेशणेओ डुआर।’”</char><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />तेखअ आऐ कांणै अर लाट्टै परमेशरे भबनै ईशू सेटा लै अर तेऊ किऐ तिंयां सोभ नरोगै। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />बडै प्रोहत अर शास्त्री आई ईशू लै खास्सी रोश्शै। ज़ांऊं तिन्‍नैं ईंयां नुआहरै काम भाल़ै ज़ुंण ईशू किऐ तै, अर ज़ांऊं तिन्‍नैं भाल़ै कि लान्हैं आसा परमेशरे भबनै ईशूए बारै इहअ बोल्दै लागै दै, “राज़ै दाबेदे लुआदे ज़ै-ज़ैकार।” तिंयां लागै ईशू लै रोश्शै इहअ बोल्दै, “ताखा शुण्हिंआं बी कि ईंयां किज़ै बोला?” <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हाँ, तम्हैं कै इहअ पबित्र शास्त्रा दी इहअ पहल़अ निं, ‘लान्हैं-सुन्हैं आसा तेरी ज़ै-ज़ैकार करदै लागै दै।’”</char> <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />तेखअ डेऊअ ईशू तिन्‍नां छ़ाडी नगरी बागै बेथनी गराऊंआं लै संघा काटी ईशू अर च़ेल्‍लै राच तिधी।<verse eid="MAT 21:17" /></para>
  <para style="s">फल़ा बाझ़ी फेडूओ बूट</para>
  <para style="r">(<ref loc="MRK 11:12-14">मार्कुस 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />दोत्ती ज़ांऊं ईशू नगरी लै बापस फिरअ, तेऊ आई भुखै। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />बाते बाढै भाल़अ ईशू एक फेडूओ बूट, ईशू डेऊअ तेऊ बूटा सेटा, पर तेथ निं पाचा छ़ाडी होर किछ़ आथी त, इहअ भाल़ी बोलअ ईशू तेऊ फेडूए बूटा लै, <char style="wj">“ऐबै निं एभा पोर्ही ताह दी कधि फल़ लागणै।”</char> सह फेडूओ बूट शुक्‍कअ तेभी। <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />इहअ भाल़ी हुऐ च़ेल्‍लै रहैन अर तिंयां लागै बोल्दै, “अह फेडूओ बूट किल्है शुक्‍कअ?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि, ज़ै तम्हैं विश्वास करी बोले अर बैहम नां करे, तम्हैं सका इहअ करी ज़ुंण एऊ फेडूए बूटा संघै किअ। ज़ै तम्हैं ऐहा धारा लै बी बोले कि इधा का डेऊ पेछ़ुई समुंदरा लै! इहअ बी जाणअ हई।</char> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" /><char style="wj">ज़ेभै तम्हैं परमेशरा का प्राथणां करी किज़ै मांगे, ज़ै तम्हैं विश्वास करे कि परमेशरा हेरनी ईंयां गल्‍ला मुल्है दैई, तै जाणीं तिंयां गल्‍ला तम्हां तेऊ का भेटी।”</char><verse eid="MAT 21:22" /></para>
  <para style="s">ईशूए हको सुआल</para>
  <para style="r">(<ref loc="MRK 11:27-33">मार्कुस 11:27-33</ref>; <ref loc="LUK 20:1-8">लूका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />तेखअ डेऊअ ईशू परमेशरे भबने ताटी लै। ज़ांऊं सह लोगा लै शिक्षा दैंदअ थिअ लागअ द, तेऊ सेटा लै आऐ तिधी बडै प्रोहत अर सैणैं, संघा लागै तिंयां तेऊ का इहअ पुछ़दै, “ताल्है कुंणी बोलअ इना कामां करना लै? ज़ुंण तंऐं हिझ़ इधी किअ, ताल्है कुंणी दैनअ तेतो हक।”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंबी पुछ़ा तम्हां का एक सुआल, ज़ै तम्हैं मेरी तैहा गल्‍लो ज़बाब दैए, तै खोज़णअ मुंह बी तम्हां का कि मुल्है इना कामां करनैओ हक कुंणी दैनअ।</char> <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" /><char style="wj">जोहन्‍ना लै डुबकी दैणैंओ हक कुंणी दैनअ? स्वर्गा का परमेशरै कि संसारे मणछै?”</char></para>
  <para style="p" vid="MAT 21:25">तिंयां लागै तेखअ आप्पू मांझ़ै इहै हठल़दै, “ज़ै हाम्हैं इहअ बोले कि स्वर्गा का परमेशरै, तै एऊ बोल़णअ हाम्हां लै इहअ कि तै तम्हैं तेऊओ विश्वास किल्है निं किअ? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />ज़ै हाम्हैं इहअ बोले कि संसारे मणछै, तै हणैं ईंयां लोग म्हारै खलाफ किल्हैकि ईंयां मना जोहन्‍ना परमेशरो गूर।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />तिन्‍नैं बोलअ ईशू लै इहअ, “हाम्हां का निं थोघै कि जोहन्‍ना कहा का भेटअ तेतो हक।”</para>
  <para style="p" vid="MAT 21:27">ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“तम्हैं निं मेरै सुआलो ज़बाब दैनअ आथी, हुंबी निं तम्हां का ऐहा गल्‍ला खोज़दअ कि मुल्है हिझ़ इना कामां करनैओ हक कुंणी दैनअ।</char><verse eid="MAT 21:27" /></para>
  <para style="s">दूई शोहरूए कथ्या</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />
    <char style="wj">“तम्हैं एते बारै किज़ै समझ़ा? एकी मणछे तै दूई शोहरू, तेऊ बोलअ ज़ेठै शोहरू सेटा डेऊई, ‘शोहरूआ, आझ़ कर तूह दाखे बागा दी काम।’</char> <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" /><char style="wj">तेऊ शोहरू दैनअ ज़बाब, ‘हुंह निं च़ाल्‍लअ’ पर बादा का हुअ तेऊ पछ़ताअ अर सह डेऊअ दाखे बागा लै कामां करदअ।</char> <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" /><char style="wj">तेखअ किअ तेऊ कान्हैं शोहरू लै ढेअ, ‘शोहरूआ, तूह कर आझ़ दाखे बागा दी काम’ तेऊ कान्हैं बोलअ, ‘हाँ, बाबा हुंह च़ाल्‍लअ एभी डेऊई।’ पर सह निं डेऊअ।</char><verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />
    <char style="wj">“इना दूई मांझ़ै कुंणी किई आपणैं बाबे मरज़ी पूरी?”</char></para>
  <para style="p" vid="MAT 21:31">तिन्‍नैं दैनअ ज़बाब, “ज़ेठै शोहरू।” तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि साबा का बाधू कारै मांगणै आल़ै बूरै अर कंज़री पुजणैं तम्हां का आजी परमेशरे राज़ा दी।</char> <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><char style="wj">किल्हैकि जोहन्‍ना आअ धर्में बाता खोज़दअ तम्हां सेटा। पर तम्हैं निं तेऊओ विश्वास किअ। पर तिन्‍नैं बूरै कारै गराहणै आल़ै अर कंज़री किअ तेऊए गल्‍लो विश्वास। पर तम्हैं निं इहअ भाल़ी बादा का बी पछ़ताऐ कि तेऊओ विश्वास करे।”</char><verse eid="MAT 21:32" /></para>
  <para style="s">कदुष्ट कृषाणे कथ्या</para>
  <para style="r">(<ref loc="MRK 12:1-12">मार्कुस 12:1-12</ref>; <ref loc="LUK 20:9-19">लूका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <char style="wj">“एक होर कथ्या शूणां, एक बारी थिअ एक घअर मालक। तेऊ लाअ दाखो बाग अर तेता फेर लाऐ बाल़ अर मांझ़ै बणाईं दाखे रसा लै कोफर, बागे पहरै करना लै डाही तिधी उछ़टै एक छ़ान बणाईं अर होरी कृषाणा का डाहअ सह बाग ठेकै दी दैई अर आप्पू डेऊअ परदेसा लै।</char> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" /><char style="wj">ज़ांऊं दाखा काढणें ऋत नेल़ आई, तेऊ छ़ाडै आपणैं दास दाखा चोल़दै तिन्‍नां कृषाणा सेटा।</char> <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" /><char style="wj">पर तिन्‍नैं कृषाणै च़िक्‍कै तिंयां दास अर कोई पाऐ मारी अर कोई लै दैनअ पात्थरो ढो।</char> <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" /><char style="wj">तेखअ छ़ाडै तेऊ आपणैं होर बी खास्सै दास दाखा चोल़दै पर तिन्‍नैं कृषाणै किअ तिन्‍नां संघै बी तिहअ ई।</char><verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />
    <char style="wj">“खिरी छ़ाडअ तेऊ आपणअ शोहरू तिन्‍नां कृषाणा सेटा लै कि मेरै शोहरूओ ता हेरनअ तिन्‍नां अदर करी।</char> <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" /><char style="wj">पर तिन्‍नैं किअ तेऊ शोहरू भाल़ी आप्पू मांझ़ै इहअ एक्‍कअ, ‘अह ता तेऊए लुआद आसा! एछा, अह पाणअ हाम्हां मारी तेखअ हणअ एऊ दाखे बागा दी म्हारअ कबज़अ।’</char> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" /><char style="wj">तिन्‍नैं काढअ सह मालको शोहरू दाखे बागा का बागै संघा पाअ सह मारी।</char><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />
    <char style="wj">“तै ऐबै ज़ांऊं दाखे बागो मालक एछणअ, तिन्‍नां ठेकै लणैं आल़ै कृषाणा संघै सोठा कि तेऊ किज़ै करनअ?”</char><verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />तिन्‍नैं बोलअ, “तेऊ करनै तिंयां कदुष्ट मणछा ज़िहै मारी खतम अर दाखे बागो ठेकअ दैणअ तेऊ होरी लै। ज़ुंण हर सिज़नै ठीक बगती तेऊ लै दाखे फसल चोल़ी दैए।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं कै पबित्र शास्त्रा दी इहअ कधि निं पहल़अ, </char></para>
  <para style="q" vid="MAT 21:42">
    <char style="wj">‘ज़ुंण पात्थर राज़ मिस्त्री बृथा समझ़अ, </char></para>
  <para style="q" vid="MAT 21:42">
    <char style="wj">सह पात्थर बणाअं परमेशरै खास कूणींए ज़ान?</char></para>
  <para style="q" vid="MAT 21:42">
    <char style="wj">अह हुअ परमेशरे मरज़ी करै, </char></para>
  <para style="q" vid="MAT 21:42">
    <char style="wj">अर हाम्हां का शुझिआ ईंयां गल्‍ला नुआहरी।’</char><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />
    <char style="wj">“तैही बोला हुंह तम्हां लै कि परमेशरो राज़ करनअ तम्हां का दूर अर सह दैणअ होरी ज़ातीए इहै लोगा लै ज़ुंण परमेशरे साबै ज़िन्दगी ज़िऊए।</char> <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><char style="wj">ज़ुंण ऐहा ज़ानीं प्रैंदै पल़े, तेऊए हणीं छ़णीं-छ़णीं अर ज़हा प्रैंदै अह ज़ान पल़े तेऊओ हणअ च़ूर।”</char><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />बडै प्रोहत अर फरीसी मणछ गऐ ऐहा कथ्या समझ़ी कि अह आसा म्हारै बारै बोल्दअ लागअ द। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />तिंयां ता च़ाहा तै ईशू ढाकणअ, पर तिधी डरै तिंयां लोगा का। किल्हैकि लोग मना तै ईशू परमेशरो गूर।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">धामा खाणां लै छ़ांदअ</para>
  <para style="r">(<ref loc="LUK 14:15-24">लूका 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />ऐहा गल्‍ला समझ़ी लागअ ईशू तिन्‍नां का होर बी कथ्या खोज़ी गल्‍ला करदअ। <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />ईशू बोलअ, <char style="wj">“स्वर्गो राज़ आसा तेऊ राज़ै ज़िहअ ज़ुंणी आपणैं शोहरूए बैहा लै बडअ भोज़ दैनअ।</char> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" /><char style="wj">ज़ांऊं धाम खाणां लै तैर गई हई तेऊ छ़ाडै आपणैं दास तिन्‍नां सेटा समाद पजैल़ै ज़हा लै छ़ांदअ आसा त, ‘एछा, धाम गई बणी।’ पर तिंयां निं आऐ।</char><verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />
    <char style="wj">“तेखअ छ़ाडै राज़ै भिई आपणैं दास लोगा सेटा शधाणूं कि ज़हा लै छ़ांदअ आसा किअ द तिन्‍नां लै बोला इहअ, ‘मंऐं हेरी धाम खाणां लै तैर करी अर खुढै धाचै दै गाभू-छ़ेल्हू हेरै मंऐं काटी अर सोभ गल्‍ला गई बणी, तम्हैं एछा ऐबै धामा खांदै एभी।’</char> <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" /><char style="wj">पर ज़हा लै छ़ांदअ थिअ तिन्‍नैं निं तैहा गल्‍ले परबाह किई तिंयां लागै हांढदै, कोई डेऊऐ आपणैं खेचा लै कामां अर कोई डेऊऐ आपणैं होरी काम-काज़ करदै।</char> <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" /><char style="wj">एता का लाऊआ ढाकै तिंयां राज़ेए दास संघा पाऐ बेइज़त करी तिंयां।</char><verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />
    <char style="wj">“एता लै आई राज़ै खास्सी रोश्शै! तेऊ छ़ाडी तिन्‍नें नगरी लै आपणीं सैना ज़िधी तिंयां हत्या करनै आल़ै थिऐ बस्सै दै, सैना पाऐ तिंयां मारी ज़ुंणीं राज़ेए दास मारी पाऐ तै। तिन्‍नें नगरी किअ तिन्‍नैं आग चैल़ी बनाश।</char> <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" /><char style="wj">तेखअ बोलअ राज़ै आपणैं दासा लै, ‘बैहे धाम ता गई तैर हई अर ज़हा लै छ़ांदअ किअ त तिंयां निं धामा खाणैं जोगी रहै।</char> <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" /><char style="wj">तम्हैं करा इहअ, बाता अर च़फै ज़ेतरै लोग तम्हां भेटे, तिन्‍नां आणा सोभी धामा खांदै शादी।’</char> <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" /><char style="wj">तिंयां दास डेऊऐ संघा किहअ ज़िहअ राज़ै बोलअ तिहअ ई। तिंयां डेऊऐ बाता अर च़फै संघा आणै तिन्‍नैं कै भलै, कै बूरै, ज़ुंण बी तिन्‍नां भेटअ तिंयां मणछ झाल़ी अर राज़ेए शोहरूओ बैहो दरबार हुअ भरी।</char><verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />
    <char style="wj">“ज़ांऊं राज़अ प्राहुंणैं भाल़अ भितरा लै आअ, तेऊ भाल़अ एक मणछ तिधी इहअ कि तेऊ निं तिंयां झिकल़ै आथी तै बान्हैं दै ज़ुंण बैहे भोज़ा लै बान्हणैं ज़रूरी आसा तै।</char> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="wj">राज़ै पुछ़अ तेऊ का, ‘साथी, ज़ुंण बैहे झिकल़ै मंऐं दैनै तै, तंऐं तिंयां किल्है निं बान्हैं?’ सह मणछ निं तेतो ज़बाब ई दैई सकअ।</char> <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><char style="wj">तेखअ दैनअ राज़ै आपणैं दासा लै हुकम, ‘एऊए हाथ खूर बान्हां संघा करा एऊ न्हैरी खुडी कैद, तिधी हणअ अह लेरदअ अर दांदा कटिल्‍लदअ।’</char> <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" /><char style="wj">किल्हैकि छ़ांदअ आसा खास्सै लै किअ द, पर छ़ांटै दै आसा थोल़ै।”</char><verse eid="MAT 22:14" /></para>
  <para style="s">माहा राज़ै लै कारअ दैणअ</para>
  <para style="r">(<ref loc="MRK 12:13-17">मार्कुस 12:13-17</ref>; <ref loc="LUK 20:20-26">लूका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />फरीसी पंथे लोग लागै तिधा का डेऊई आप्पू मांझ़ै इहै जोग करदै कि हाम्हां करनअ किज़ै इहअ ज़ेता करै अह ईशू किज़ै रोमी राज़े खलाफ बोले, तेऊ दोशा पिछ़ू बझ़ैल़णअ हाम्हां अह कैदखानै दी पाणै। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />फरीसी छ़ाडै आपणैं च़ेल्‍लै हेरोदेस राज़ेए पक्ष लणैं आल़ै लोगा संघै ईशू लै इहअ बोल्दै, “हे गूरू, हाम्हां का आसा ऐहा गल्‍लो थोघ कि तूह आसा शुचअ। तूह सखाऊआ परमेशरो सत्त। तूह निं कोहिए परबाह करदअ अर नां तूह कहा मणछे मुंहां भाल़ी गल्‍ला करदअ। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />तूह खोज़ हाम्हां का ऐहा गल्‍ले बारै कि तेरी हाम्हां लै एते बारै किज़ै राऐ आसा कि माहा राज़ै लै कारअ दैणअ ठीक आसा कि नांईं?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />ईशू हेरअ तिन्‍नें दिलो कपट समझ़ी संघा बोलअ तिन्‍नां लै, <char style="wj">“कपटी मणछो, तम्हैं किल्है आसा मुंह परखदै लागै दै?</char> <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" /><char style="wj">तेऊ सिक्‍कै रहैऊआ मुखा ज़ेता लोग राज़ै लै कारअ दैआ।”</char> तिन्‍नैं आणअ तेऊ सेटा एक च़ंदीओ सिक्‍कअ। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“एऊ सिक्‍कै दी अह मुहुर्ती अर नाअं कसरअ आसा?”</char><verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />तिन्‍नैं बोलअ, “एथ आसा माहा राज़ैओ नाअं अर मुहुर्ती।”</para>
  <para style="p" vid="MAT 22:21">तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“ज़ुंण माहा राज़ैओ आसा, तेऊ दैआ माहा राज़ै लै। ज़ुंण परमेशरो आसा, तेऊ दैआ परमेशरा लै।”</char><verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />ऐहा गल्‍ला शूणीं हुऐ तिंयां रहैन संघा लागै ईशू सेटा का हांढदै।<verse eid="MAT 22:22" /></para>
  <para style="s">मणछो भिई ज़िऊंदै हणअ अर बैह</para>
  <para style="r">(<ref loc="MRK 12:18-27">मार्कुस 12:18-27</ref>; <ref loc="LUK 20:27-40">लूका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />तैहा ई धैल़ी आऐ सदुकी ईशू सेटा लै, ज़ुंण इहअ बोला कि मूंऐं दै मणछो भिई ज़िऊंणअ निं आथी, तिन्‍नैं पुछ़अ ईशू का, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“हे गूरू, परमेशरे गूर मोसा आसा इहअ बोलअ द कि, ज़ै कुंण आद-लुआद हुऐ बाझ़ी मरे, तेऊए बिधबा बेटल़ी संघै सका तेऊओ भाई बैह करी अर तेऊ लै लुआद पैईदा करी? <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />एक बार हुअ इहअ कि सात भाई, पैहलअ भाई मूंअ बैह करी अर तेऊए निं लुआद हुई! तेऊए बिधबा बेटल़ी लागी दुजै संघै रहंदी। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />पर दुजअ अर चिऊथअ भाई बी मूंअ लुआद हुऐ बाझ़ी, इहअ हुअ तिन्‍नां साता भाई तैणीं अर तिंयां मूंऐं सोभ अर तिन्‍नें कोहिए निं तैहा बेटल़ी का लुआद। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />तिन्‍नां बाद खिरी सह बेटल़ी बी मूंईं। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ता, ऐबै ज़ेभै सह भिई ज़िऊंदी हणीं, सह तिन्‍नां साता भाई मांझ़ै कसरी बेटल़ी हणीं? किल्हैकि सह ता पैहलै साता ज़ण्हे बेटल़ी ती।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“अह आसा थारी भूल कि तम्हां का निं पबित्र शास्त्रो थोघ ई आथी अर नां तम्हां परमेशरे शगतीओ थोघ आथी!</char> <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" /><char style="wj">ज़ेभै तिंयां मूंऐं दै मांझ़ै ज़िऊई उझ़णै, तेभै नां तिन्‍नां बैह करनअ। नां तिंयां बैहा लै दैणैं। पर स्वर्गै हणैं तिंयां स्वर्ग दूता ज़िहै।</char><verse eid="MAT 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 22:31" />
    <char style="wj">“पर मरी करै ज़िऊंदै हणें बारै तम्हैं पबित्र शास्त्र निं पहल़अ आथी? ज़ेथ परमेशर इहअ बोला,</char> <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="wj">‘हुंह आसा सह परमेशर ज़हा तेरै दाद-बाब आबराम, इसहाक अर याकब मना तै?’ सह निं मुल्दैओ परमेशर आथी पर सह आसा ज़िऊंदैओ।”</char><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />ईशूए ऐहा शिक्षा शूणीं हुऐ लोग रहैन।<verse eid="MAT 22:33" /></para>
  <para style="s">सोभी का बडअ हुकम</para>
  <para style="r">(<ref loc="MRK 12:28-34">मार्कुस 12:28-34</ref>; <ref loc="LUK 10:25-28">लूका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />ज़ांऊं फरीसी पंथे लोगै शूणअ कि ईशू दैनअ तिन्‍नां सदुकी पंथे लोगा लै इहअ ज़बाब कि नां तिंयां तेते बारै सोठी सकदै तै अर नां तेते बारै किज़ै बोली सकदै तै। फरीसी किअ कठा हई आप्पू मांझ़ै जोग कि हाम्हां ईशू लै किज़ै बोल़णअ, संघा डेऊऐ तिंयां ईशू सेटा लै। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />तिन्‍नां मांझ़ै त एक शास्त्रो ज़ाणकार मणछ, सह लागअ इहअ बोली ईशू परखदअ, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“हे गूरू, बधाना दी सोभी का खास हुकम किज़ै आसा?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />ईशू बोलअ तेऊ लै, <char style="wj">“तूह करै आपणैं परमेशर बिधाता लै आपणअ सारअ मन्‍न, प्राण अर आपणीं सारी अक्ल लाई झ़ूरी।</char> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" /><char style="wj">बडअ अर पैहलअ हुकम आसा अह ई।</char> <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><char style="wj">एता ई बराबर दुजअ हुकम बी आसा इहअ कि तूह कर आपणैं साथी-संघी संघै आप्पू बराबर झ़ूरी।</char> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><char style="wj">ईंयां ई दूई हुकम आसा सारै बधाने अर परमेशरे गूरे शिक्षे आथरी।”</char><verse eid="MAT 22:40" /></para>
  <para style="s">मसीहा दाबेदे लुआद या तेऊओ प्रभू आसा?</para>
  <para style="r">(<ref loc="MRK 12:35-37">मार्कुस 12:35-37</ref>; <ref loc="LUK 20:41-44">लूका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />फरीसी तै ईशू सेटा कठा हुऐ दै, ईशू पुछ़अ तिन्‍नां का सुआल, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" /><char style="wj">“मसीहे बारै तम्हैं कै समझ़ा? सह कसरअ शोहरू आसा?”</char> तिन्‍नैं दैनअ ज़बाब, “दाबेद राज़ैओ शोहरू।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />तेखअ पुछ़अ ईशू तिन्‍नां का, <char style="wj">“तै राज़अ दाबेद आत्मां दी हई तेऊ लै प्रभू किल्है बोला?”</char> <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />“सह बोला इहअ,</para>
  <para style="q" vid="MAT 22:44">
    <char style="wj">‘प्रभू बोलअ मेरै प्रभू लै, </char></para>
  <para style="q" vid="MAT 22:44">
    <char style="wj">मेरै दैहणै बेश</char></para>
  <para style="q" vid="MAT 22:44">
    <char style="wj">ज़ेभै तैणीं हुंह तेरै दुशमणा हारी निं लऊं।’</char><verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />
    <char style="wj">“तै, ज़ै राज़अ दाबेद मसीहा लै प्रभू बोला, तै सह तेऊओ शोहरू किल्है हुअ?”</char> <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />एऊ सुआलो ज़बाब निं कोहै दैई सकअ। तेखअ निं कोही बी ईशू का पुछ़णें हिम्मत हुई।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">शास्त्री अर फरीसी पंथे लोगा का चतैन</para>
  <para style="r">(<ref loc="MRK 12:38">मार्कुस 12:38</ref>,<ref loc="MRK 12:39">39</ref>; <ref loc="LUK 11:43">लूका 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45">20:45</ref>,<ref loc="LUK 20:46">46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तेखअ बोलअ ईशू आप्पू सेटा झाल़्हुऐ दै तिन्‍नां खास्सै मणछा लै अर आपणैं च़ेल्‍लै लै, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" /><char style="wj">“शास्त्री अर फरीसी लै आसा मोसा गूरे बधाने शिक्षा समझ़ाऊंणेओ हक।</char> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><char style="wj">हुंह बोला तम्हां लै कि ज़ुंण तिंयां बधाने हुकम खोज़ा, तिन्‍नां मनै तिहै ई। पर तिन्‍नां ज़िहै काम निं करी। किल्हैकि बधाने शिक्षा होरी लै ता दैआ पर आप्पू निं तिंयां तेते साबै ज़िन्दगी ज़िऊंदै।</char> <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" /><char style="wj">तिंयां लादा तम्हां होरी मणछे पिठी रिती-रबाज़े अर बधाने इहै गर्कै बोझ़ै ज़ेता कुंण च़की निं सकदअ। पर आप्पू निं गुंठी करै उटअ पाच तुआणअ करनअ च़ाहंदै।</char><verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />
    <char style="wj">“तिंयां करा कामों दखाअ कि लोग तिन्‍नां भाल़े। तिंयां करा आपणैं जंतरा बिरलै अर आपणैं परने झ़ुंफ करा लाम्मै।</char> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><char style="wj">धामा दी लोल़ी तिन्‍नां बेशणा लै सोभी का बधिया ज़ैगा अर सभागृहा च़ाहा तिंयां इहअ कि तिन्‍नां बडी ज़ैगा बशैल़ी तिन्‍नों अदर करे।</char> <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" /><char style="wj">तिंयां झ़ूरा एता लै कि हाट्टै-बज़ारै सोभ तिन्‍नां लै हाथ ज़ोल़े अर ज़ै तिन्‍नां लै लोल़ी ‘महान गूरू’ बोली तिन्‍नों अदर किअ।</char><verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />
    <char style="wj">“पर तम्हैं डाहै धैन कि तम्हैं निं एकी दुजै लै ‘गूरू’ बोली, किल्हैकि तम्हैं आसा परमेशरो परिबार अर आप्पू मांझ़ै भाई-बैहणी अर थारअ आसा एक्‍कै महान गूरू एक्‍कै।</char> <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" /><char style="wj">नां एऊ संसारै कहा होरी लै ‘बाब’ बोली, किल्हैकि थारअ आसा एक्‍कै ‘बाब’ अर सह आसा परमेशर ज़ुंण स्वर्गै रहा।</char> <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" /><char style="wj">तम्हैं डाहै धैन कि तम्हां लै कुंण ‘सैणैं’ नां बोले किल्हैकि तम्हां नढैऊणैं आल़अ सैणअ आसा एक्‍कै अर सह आसा मसीहा।</char> <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><char style="wj">ज़ुंण तम्हां मांझ़ै सोभी का महान होए, सह बणें पैहलै थारअ दास।</char> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><char style="wj">ज़ुंण बी आप्पू महान समझ़े, सह करनअ होछ़अ अर ज़ुंण आप्पू होछ़अ समझ़े, सह करनअ महान।</char><verse eid="MAT 23:12" /></para>
  <para style="s">शास्त्री अर फरीसी मणछे छ़ल़-कपट करने बारै</para>
  <para style="r">(<ref loc="MRK 12:40">मार्कुस 12:40</ref>; <ref loc="LUK 11:39-42">लूका 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! तम्हैं डाहा मणछो स्वर्ग राज़ा लै डेऊणेओ दुआर हूल़ी। नां आप्पू तेथ डेऊंदै अर नां होरी दैंदै डेऊणैं।</char> <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><char style="wj">ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! तम्हैं लुटा च़लाकी करै बिधबा बेटल़ीए घअर। तम्हैं करा प्राथणां करनैओ दखाअ कि लोग तम्हां भाल़े। तैही भेटणीं तम्हां सोभी का खास्सी सज़ा।</char><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! किल्हैकि एकी मणछा आपणैं पक्षा लै करने तैणीं करा तम्हैं राच-धैल़ी एक। पर ज़ांऊं सह तम्हां बाखा फिरी जाआ, तेऊ पाआ तम्हैं आप्पू का दुगणीं जम्परी।</char><verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />
    <char style="wj">“ओ यहूदी सैणैंओ, तम्हां लै हणीं घोर आफ़त! तम्हैं आसा इहै कांणै मणछ ज़ुंण होरी का बात खोज़ा। तम्हैं बोला इहअ, ‘ज़ै कोई भबने सोह खाए, तेतो निं किछ़ै फरक पल़दअ, पर ज़ै कुंण भबनै डाहै दै सुन्‍नें सोह खाए, तेऊ लै लागणअ दोश।’</char> <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" /><char style="wj">कमुर्ख अर कांणै मणछो, बडअ कुंण आसा! सुन्‍नअ कि सह भबन ज़हा करै सुन्‍नअ पबित्र हआ?</char> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="wj">संघा इहअ बी बोला, ‘ज़ै कुंण बेदीए सोह खाए तै निं किछ़ै हंदअ। पर ज़ुंण बेदी दी भैंट दैनी दी च़िज़े सोह खाए, तेऊ लागणअ दोश।’</char> <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" /><char style="wj">ओ कांणै मणछो, बडअ कुंण आसा? सह भैंट कि सह बेदी आसा बडी ज़हा करै सह भैंट पबित्र हआ?</char> <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" /><char style="wj">तैही बोला हुंह कि ज़ुंण बेदीए सोह खाआ, सह काढा तैहा बेदीए अर तेथ प्रैंदै डाही दी भैंट दुहीए सोह।</char> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" /><char style="wj">ज़ुंण भबने सोह खाआ, सह काढा तेऊ भबने अर तेऊए ज़ुंण तेथ आसा बस्सअ द दुहीए सोह।</char> <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><char style="wj">ज़ुंण स्वर्गे सोह खाआ, सह काढा तेऊ परमेशरे राज़गाद्दी अर तेथ प्रैंदै बेठै दै दुहीए सोह।</char><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! तम्हैं दैआ पदिन्‍नै, सुंफो अर ज़िरैओ दसुअ निसब! पर बधाने ज़रूरी गल्‍ला आसा हेरी दी तम्हैं छ़ाडी। मतलब नसाफ, झींण अर विश्वास निं तम्हैं करदै। हुअ ता लोल़ी त इहअ कि इना गल्‍ला बी रहंदै मंदै अर तिन्‍नां बी नांईं छ़ाडदै।</char> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" /><char style="wj">ओ कांणै सैणैंओ, आपणैं रबाज़े होछ़ी-होछ़ी गल्‍ला मनणा लै आसा तम्हैं आजू अर परमेशरो बडअ हुकम निं तम्हैं मंदै! अह आसा एही गल्‍ल कि फेऊल़ै ता काढा तम्हैं पोर्ही पर ऊँट पाआ तम्हैं घुटी।</char><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! होरी लोगा नदरी करा तम्हैं दखाअ कि तम्हैं आसा खास्सै भलै अर धर्मीं मणछ! असली दी आसा तम्हैं ऐईबी अर बूराई करै भर्हुऐ दै। तम्हैं आसा तिन्‍नां भांडै ज़िहै ज़ुंण बागा बाखा ता आसा धोऐ दै, पर भितरा का आसा बास्स-शल़ैन्ह लागी दी।</char> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="wj">ओ कांणै मणछा ज़िहै फरीसी मणछो, पैहलै बदल़ा आपणैं मन्‍नैं होरी लुटणैं बूरी सोठ, तै सका तम्हैं धर्म करनै जोगी तिन्‍नां भांडै ज़िहै बणी ज़ुंण बागै अर भितरी दुही बाखा हआ धोऐ दै।</char><verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! तम्हैं आसा मुल्दै दाबी दी घोरी ज़िहै छ़ोतलै, बागा का शुझिआ तिंयां सज़ी-सज़ाऊई दी पर भितरा का हआ तेथ बास्स-शल़ैन्ह।</char> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" /><char style="wj">ठीक इहै ई आसा तम्हैं, बागा का ता शुझिआ धर्मीं मणछा ज़िहै, पर भितरी आसा थारै पाप अर छ़ल़-कपट भरअ द।</char><verse eid="MAT 23:28" /></para>
  <para style="s">शास्त्री अर फरीसी लै सज़ा</para>
  <para style="r">(<ref loc="LUK 11:47-51">लूका 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />
    <char style="wj">“ओ कपटी शास्त्री अर फरीसी मणछो, तम्हां लै हणीं घोर आफ़त! तम्हैं फिरा परमेशरे गूरे समाधी सज़ाऊई अर धर्मीं मणछे समाधी बणाईं करै तिन्‍नें अदर करदै।</char> <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" /><char style="wj">तेखअ बोला इहअ कि, ज़ै हाम्हैं आपणैं दादा-बाबे ज़मानैं हंदै, हाम्हां निं परमेशरे गूरे लोहू बहाऊई हत्या करनी ती।</char> <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><char style="wj">इहअ करै खोज़ा तम्हैं आपणैं बारै आप्पै कि तम्हैं आसा परमेशरे तिन्‍नां गूरे हत्या करनै आल़ेए लुआद।</char> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" /><char style="wj">ऐबै करा तम्हैं बी तिहअ ई करै तेऊ कामां पूरै ज़ुंण थारै दादै-बाबै शुरू किअ त।</char> <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><char style="wj">झ़रीली दानुईं ज़िहै मणछो! तम्हैं किहअ करै च़ाल्‍लै न्हैरी जम्परीए सज़ा बच़ी?</char><verse eid="MAT 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 23:34" />
    <char style="wj">“ऐबै शूणां कि परमेशर तम्हां लै किज़ै बोला, ‘मुंह छ़ाडणैं तम्हां सेटा लै आपणैं गूर, समझ़कार अर शास्त्री। तम्हां पाणै तिन्‍नां मांझ़ै खास्सै मारी अर खास्सै लै दैणीं क्रूसे सज़ा अर कई च़िक्‍कणै तम्हां आपणीं सभागृहा कोल़ै करै अर तम्हैं फिरनैं तिन्‍नां एकी नगरी का दुजी नगरी लै दरल़ाऊंदै।’</char> <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><char style="wj">ज़हा का धर्मीं आबला ओर्ही बरेक्याहे शोहरू जकर्या तैणीं, ज़ुंण तम्हैं परमेशरे भबन अर बेदी मांझ़ै मारी पाऐ तै, ज़ेतरै धर्मीं पृथूई दी तम्हैं मारै तेतो पाप-दोश पल़णअ सारअ थारै मुंडै।</char> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि परमेशरो अह नसाफ हणअ ऐहा ई पोस्तीए मणछा लै।</char><verse eid="MAT 23:36" /></para>
  <para style="s">एरुशलेम नगरी लै फिटक</para>
  <para style="r">(<ref loc="LUK 13:34">लूका 13:34</ref>,<ref loc="LUK 13:35">35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />
    <char style="wj">“ओ एरुशलेम नगरीए लोगो! किई परमेशरे तिन्‍नां गूरे हत्या, ज़ुंण परमेशरै तम्हां सेटा लै छ़ाडै तै। तम्हैं पाऐ तिंयां पात्थरे ढो दैई मारी। मंऐं सोठअ कई बारी कि ज़ेही मुर्गी आपणैं बच्च़ै आपणैं फैंखा हेठै झाल़ी फाज़त करा, तिहै ई करूं हुंबी थारै बाल-बच्च़ै बी कठा पर तम्हैं निं इहअ हणैं दैनअ।</char> <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" /><char style="wj">हेरा, थारअ घअर छ़ाडअ तम्हां लै उज़र।</char> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><char style="wj">ऐहा गल्‍ला डाहै आद कि एभा पोर्ही ज़ेभै तैणीं तम्हैं आप्पै इहअ निं बोले, ‘परमेशर दैआ तेऊ मणछा लै बर्गत ज़ुंण प्रभूए नाओंऐं एछा,’ तेभै तैणीं निं हुंह तम्हां का भिई शुझणअ।”</char><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">परमेशरे भबनो बनाश</para>
  <para style="r">(<ref loc="MRK 13:1">मार्कुस 13:1</ref>,<ref loc="MRK 13:2">2</ref>; <ref loc="LUK 21:5">लूका 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />ईशू डेऊअ परमेशरे भबना का बागै, डेऊंदी बारी आऐ च़ेल्‍लै ईशू सेटा संघा लागै तिंयां ईशू संघै परमेशरे भबने बारै गल्‍ला करदै कि भबन भाल़ किहअ शोभलअ आसा। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हां का शुझिआ इधी कि अह भबन एभै किहअ शोभलअ आसा। पर हुंह खोज़ा तम्हां का सत्त कि अह पाणअ दुशमणा पठी ढोल़ी! एथ निं एकी पात्थरा प्रैंदै दुजअ पात्थर भेटणअ टेक्‍कअ द।”</char><verse eid="MAT 24:2" /></para>
  <para style="s">ईशूओ फिरी एछणेंओ नछ़ैण</para>
  <para style="r">(<ref loc="MRK 13:3-13">मार्कुस 13:3-13</ref>; <ref loc="LUK 21:7-19">लूका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />तेता बाद थिअ ईशू जैतून धारा बेठअ द। ईशू त कांगनरांगै एक्‍कै ज़ण्हअ अर तेतरी आऐ च़ेल्‍लै ईशू सेटा लै संघा लागै इहअ बोल्दै, “तूह खोज़ हाम्हां का कि ईंयां गल्‍ला केभै निभणी? हाम्हां का किहअ करै लागणअ थोघ कि तूह एछणअ छ़ेक्‍कै फिरी अर एऊ संसारा खतम हणैंओ किज़ै नछ़ैण हणअ?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं डाहै धैन! तम्हैं निं लोल़ी कुंणी झ़ुठी गल्‍ला खोज़ी कबाता पाऐ।</char> <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><char style="wj">कई एछणैं तम्हां सेटा मेरै नाओंऐं अर तिन्‍नां बोल़णअ इहअ, ‘हुंह आसा सह मसीहा ज़ुंण परमेशरै आसा छ़ाडअ द।’ खास्सै मणछा करनअ तिन्‍नें गल्‍ला दी विश्वास।</char><verse eid="MAT 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 24:6" />
    <char style="wj">“ज़ेभै तम्हां का देशै जुध हणें अर जुधे गल्‍ला शुण्हिंए, तेभै निं तम्हैं डरी। किल्हैकि ईंयां गल्‍ला हणीं आसा ज़रूरी, पर तेभै निं संसार खतम हणअ।</char> <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><char style="wj">एकी देशे लोगा पल़णअ दुजै देशे लोगा लै चुटी, एकी राज़ा करनअ दुजै राज़ा संघै जुध। ज़ैगै-ज़ैगै हणीं ज़ाज़री अर कई ज़ैगा पल़णै नकाल़।</char> <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" /><char style="wj">अह हणीं दाह-दुखे शुरूआत ज़ेही कहा बेटल़ी सूंणें दाहे शूल़ उझ़िआ।</char> <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" /><char style="wj">तेभै करनै लोगा तम्हैं कैद अर तिन्‍नां करनै तम्हां लै ज़ुल्म। कई पाणै तम्हां मांझ़ै तिन्‍नां मारी। हर देशे लोगा डाहणीं मुंह दी विश्वास करनै पिछ़ू तम्हां संघै ज़ीद।</char> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" /><char style="wj">तेभै हणअ इहअ कि ज़ुंण एभै मुंह दी विश्वास करा, तिन्‍नां छ़ाडणअ विश्वास करनअ। तिन्‍नां डाहणीं आप्पू मांझ़ै ज़ीद अर मेरै च़ेल्‍लै मांझ़ै बझ़ैल़णै तिन्‍नां कई कैद करनै।</char> <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><char style="wj">खास्सै झ़ुठै गूर निखल़णैं अर तिन्‍नां पाणै मुंह दी विश्वास करनै आल़ै मांझ़ै खास्सै मणछ कबाता।</char> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><char style="wj">हर ज़ैगा बढणअ पाप, खास्सै मणछा छ़ाडणीं झींण अर झ़ूरी करनी।</char> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><char style="wj">पर ज़ुंण मुंह दी खिरी तैणीं विश्वास डाही सबर करे, तिंयां हेरनै बच़ाऊई।</char> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" /><char style="wj">स्वर्ग राज़ो खुशीए समादो प्रच़ार खोज़णअ सारै संसारै सोभी लोगा का ताकि सोभी देशे लोगा लै खुशीए समादा मनणैओ मोक्‍कअ होए, तेखअ हणअ अह संसार खतम।</char><verse eid="MAT 24:14" /></para>
  <para style="s">माहा सांगटे शुरूआत</para>
  <para style="r">(<ref loc="MRK 13:14-23">मार्कुस 13:14-23</ref>; <ref loc="LUK 21:20-24">लूका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />
    <char style="wj">“ज़ेभै तम्हां सह बनाश करनै आल़ी छ़ोतली च़ीज़ भबनै पबित्र ज़ैगा खल़ी शुझिए, ज़ेते बारै खास्सी साला पैहलै परमेशरे गूर दानिएलै आसा खोज़ी डाहअ द।</char> पहल़णैं आल़अ दै ऐहा गल्‍ला लै धैन! <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" /><char style="wj">तेभै ज़ुंण यहूदा मुल्खै होए तिंयां ठुर्है धारा लै।</char> <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><char style="wj">ज़ुंण च़ाऊल़ी होए, तिंयां निं घअरा भितरा का किछ़ी गल्‍ला निंणे तैणीं उंधै होथी अर नां घअरा भितरा लै डेऊई बगत ज़ांऐं करी।</char> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" /><char style="wj">ज़ुंण खेचै होए, तिंयां निं आपणैं झिकल़ै आणदै पिछ़ू डेऊई।</char><verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />
    <char style="wj">“तिन्‍नां धैल़ी ज़ुंण सुंदी बेटल़ी अर आपणैं शोहरू लै दुधा पणैंऊंदी होए तैहा लै हणअ ठुहर्नअ बडी आफ़त!</char> <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" /><char style="wj">प्राथणां करदै रहै लागी कि तम्हां हिंऊंदे धैल़ै अर बशैघे धैल़ै ठुहर्नअ नां पल़े।</char> <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><char style="wj">किल्हैकि तैहा घल़ी एछणअ इहअ दुख-सांगट कि ज़ुंण एऊ संसारे शुरू का आझ़ तैणीं कधि निं हुअ अर नां कधि हणअ।</char> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" /><char style="wj">परमेशरै आसा आपणैं विश्वास करने आल़ेए बारै सोठी करै ईंयां सांगटे धैल़ी घटाऊई दी, नांईं ता संसारै निं कोह मणछ ज़िऊंदअ बच़णअ त।</char> <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" /><char style="wj">ज़ै कुंण तिन्‍नां धैल़ी तम्हां लै इहअ बोले, ‘भाल़ा मसीहा आसा इधी, अर मसीहा आसा तिधी!’ तिन्‍नें गल्‍लो विश्वास निं करी।</char><verse eid="MAT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 24:24" />
    <char style="wj">“किल्हैकि झ़ुठै मसीहा अर झ़ुठै गूर निखल़णैं अर तिन्‍नां पाणै बडै-बडै नछ़ैण अर च़मत्कार रहैऊई कबाता। ज़ै तिन्‍नों बश च़ले, तिन्‍नां तिंयां मणछ बी कबाता ज़ुंण परमेशरै आसा छ़ांटै दै।</char> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" /><char style="wj">ऐहा गल्‍लो डाहै तम्हैं धैन, ईंयां गल्‍ला डाही मंऐं तम्हां का पैहलै ई खोज़ी। </char> <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" /><char style="wj">तैही ज़ै तिंयां तम्हां का बोले कि भाल़ा, मसीहा आसा रेगीस्तानै, तम्हैं निं बागै निखल़ी। ज़ै कुंण इहअ बोले कि मसीहा आसा फलाणीं बाहूल़ी गुप्त रहअ द, तम्हैं निं तिन्‍नें गल्‍लो विश्वास करी।</char><verse eid="MAT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 24:27" />
    <char style="wj">“किल्हैकि ज़ेही बिज़ल़ी हेरा-हेरी पुर्बा का निखल़ी पछ़मा दी च़मकदी सोभी का शुझिआ, तिहअ शुझणअ हुंह मणछो पूत बी एऊ संसारा लै फिरी एछदअ।</char> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><char style="wj">ज़िधी ल्हासा हआ, तिधी झाल़्हिआ गरली बी।</char><verse eid="MAT 24:28" /></para>
  <para style="s">मुंह मणछे पूतो फिरी एछणअ</para>
  <para style="r">(<ref loc="MRK 13:24-27">मार्कुस 13:24-27</ref>; <ref loc="LUK 21:25-28">लूका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <char style="wj">“तिन्‍नां धैल़ीए दुख-सांगटा का बाद फिरनअ सुरज़ न्हैरअ अर ज़ोथ हणीं काल़ी। सरगा का अल़णैं तारै अर भ्रमंडे सारी शगती बी सिक्‍कणी आजू-पिछ़ू।</char> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" /><char style="wj">तेभै शुझणअ तम्हां का मेरअ नछ़ैण सरगै। तेभै हणैं पृथूईए सोभ खिंब सोभी ज़ातीए मणछ हिक्‍का पटाक्‍की लेरा लांदै। हुंह मणछो पूत शुझणअ तिन्‍नां का महान शगती अर प्रतप्पा संघै सरगै बादल़ा बाती एछदअ।</char> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><char style="wj">मुंह छ़ाडणैं नादे बडी छ़ेल़ा संघै आपणैं स्वर्ग दूत अर तिन्‍नां झाल़णैं सरगे एकी पुंझ़ा का दुजै पुंझ़ै तैणीं च़ऊ दिशा का तिंयां ज़ुंण परमेशरै आसा छ़ांटै दै।</char><verse eid="MAT 24:31" /></para>
  <para style="s">फेडूए बूटे कथ्या</para>
  <para style="r">(<ref loc="MRK 13:28-31">मार्कुस 13:28-31</ref>; <ref loc="LUK 21:29-33">लूका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />
    <char style="wj">“फेडूए बूटा का लआ सबक, ज़ेभै तेथ प्लीर निखल़ा अर बझ़दी लागा, तेभै जाआ तम्हैं समझ़ी कि बसंते ऋत आसा नेल़।</char> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><char style="wj">ठीक इहअ ई ज़ांऊं तम्हां ईंयां गल्‍ला हंदी शुझणीं, तम्हैं समझ़ै कि तिंयां धैल़ै आसा नेल़, दुआरा बागै पुजी।</char> <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि ज़ेभै तैणीं ईंयां गल्‍ला निभी निं जाए, तेभै तैणीं निं ऐहा पोस्तीए लोग मरनै।</char> <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><char style="wj">सरग अर पृथूई टल़णीं पर मंऐं ज़ुंण गल्‍ला बोली, निभणी ज़रूर एही ई।</char><verse eid="MAT 24:35" /></para>
  <para style="s">बिऊंतै रहै</para>
  <para style="r">(<ref loc="MRK 13:32-37">मार्कुस 13:32-37</ref>; <ref loc="LUK 17:26-30">लूका 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />
    <char style="wj">“तैहा धैल़ी अर तेऊ बगतो निं कोही का थोघ आथी कि ईंयां केभै हणीं। नां एतो थोघ स्वर्ग दूता का आथी अर नां पूता का। पर ऐहा गल्‍लो थोघ आसा सिधअ बाब परमेशरा का।</char><verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />
    <char style="wj">“ज़िहअ म्हारै दाद-बाब नूहे ज़मानैं हुअ, तिहअ ई हणअ मुंह मणछे पूतो फिरी एछणअ बी।</char> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><char style="wj">किल्हैकि ज़िहै पाणीं करै हुई दी प्रल़या का आजी ज़ेभै तैणीं नूह ज़हाज़ा भितरी नांईं बेठअ, तेभै तैणीं रहै लोग खांदै-पिंदै अर तिन्‍नां मांझ़ै रहा ती बैह शादी हंदी।</char> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" /><char style="wj">ज़ांऊं तैणीं तिंयां पाणींए प्रल़या दी डुबी मूंऐं निं आथी, तेभै तैणीं निं तिन्‍नां का किछ़ बी थोघ लागअ। ठीक तिहअ ई हणअ तेभै बी ज़ेभै हुंह मणछो पूत फिरी एछणअ।</char> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" /><char style="wj">तैहा घल़ी हणअ इहअ कि ज़ुंण दूई ज़ण्हैं खेचै होए, तिन्‍नां मांझ़ै च़कणअ एक ज़ण्हअ उझै अर एक छ़ाडणअ तिधी।</char> <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" /><char style="wj">दूई बेटल़ी हणीं थरेटा दी नाज़ा पिशदी, एक च़कणी उझै अर दुजी छ़ाडणीं तिधी।</char><verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />
    <char style="wj">“तैही रहै तम्हैं बिऊंतै, किल्हैकि तम्हां का निं इहअ थोघ आथी कि थारअ प्रभू कहा धैल़ी एछणअ।</char> <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><char style="wj">पर इहअ लआ समझ़ी कि, ज़ै घअरे मालका का इहअ थोघ हंदअ कि च़ोर केऊ पहरै एछणअ, तै रहणअ त तेऊ बिऊंतै संघा निं आपणैं घअरै च़ोरी हणैं दैणीं ती।</char> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" /><char style="wj">इहै ई रहा तम्हैं बी हर बगत तैर्हुई। किल्हैकि हुंह मणछो पूत बी एछणअ तैहा घल़ी ज़ेभा लै तम्हैं सोठअ निं हणअ।</char><verse eid="MAT 24:44" /></para>
  <para style="s">विश्वासा करने जोगी दास अर कदुष्ट दास</para>
  <para style="r">(<ref loc="LUK 12:41-48">लूका 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />
    <char style="wj">“इहअ भरोस्सैमंद अर समझ़कार दास कुंण आसा ज़ुंण तेऊए मालकै दास-दासी प्रैंदै सैणअ डाहअ बणाईं ताकि तिन्‍नां लै रोटी-पाणीं करे दैई?</char> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" /><char style="wj">मालक हआ तेऊ दासा लै खुश ज़हा तेऊओ मालक इहअ ई करदै भाल़े।</char> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि तेऊ बणाणअं सह आपणीं सारी ज़ैदातो भढारी।</char><verse eid="MAT 24:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48" />
    <char style="wj">“पर ज़ै सह कदुष्ट दास इहअ सोठे कि मेरै मालका एछणा लै आसा अज़ी खास्सी बल़ैग।</char> <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" /><char style="wj">संघा लागे सह होरी दास-दासी च़िक्‍कदअ-मारदअ अर आप्पू शूर-शराबा झुटदअ, </char> <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" /><char style="wj">तेऊ दासो मालक एछणअ तैहा धैल़ी फिरी, ज़ेभै एछणअ तेऊ सोठअ बी निं हणअ! सह एछणअ तैहा घल़ी ज़ेभै ज़ेतो तेऊ का थोघ निं हणअ।</char> <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><char style="wj">मालका दैणीं तेऊ लै घोर सज़ा। संघा पाणअ सह कपटी मणछा जैंदरी तैहा ज़ैगा ज़िधी मणछ सिधै लेरा लांदै अर दांदा कटिल्‍लदै रहा लागी।”</char><verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दसा कुंआरी शोहरीए कथ्या</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै, <char style="wj">“ज़ेभै हुंह मणछो पूत फिरी एछणअ, तेभै हणअ स्वर्गो राज़ तिन्‍नां दस कुंआरी शोहरी ज़िहअ ज़ुंण आपणैं मसाल्‍लै ज़ाल़ी बैहा लै लाल़ीए साथणीं बणी लाल़ै सेटा मिलदी डेऊई।</char> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" /><char style="wj">तिन्‍नां मांझ़ै ती पांज़ ऐडी पर पांज़ ती समझ़कार।</char> <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" /><char style="wj">तिन्‍नैं ऐडी शोहरी आप्पू संघै मसाल्‍लै ता निंयैं ज़ाल़ी पर आप्पू संघै होर जैतूनो तेल निं निंयं।</char> <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" /><char style="wj">पर ज़ुंण शोहरी समझ़कार आसा ती, तिन्‍नैं निंईं आप्पू संघै जैतूने तेले शिंगी बी भरी।</char> <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" /><char style="wj">ज़ांऊं लाल़ै एछणा लै खास्सी बल़ैग पल़ी, तिन्‍नां लागी उंघी अर खिरी सुत्ती तिंयां।</char><verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />
    <char style="wj">“आधा राची शूणीं गाज़ै-बाज़ेए छ़ेल़ अर इहअ बोल्दै, ‘हेरा लाल़अ आअ अर सोभ साथणीं च़ाल्‍ला लाल़ी संघै लाल़ै का मिलदी।’</char> <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" /><char style="wj">तेखअ लागी तिंयां दस कुंआरी आपणैं-आपणैं मसाल्‍लै सोहरदी।</char> <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" /><char style="wj">तिन्‍नैं ऐडी बोलअ तिन्‍नां समझ़कार साथणीं का इहअ, ‘आपणैं जैतूने तेला का दैआ धख-धख हाम्हां लै बी, किल्हैकि म्हारै मसाल्‍लै च़ाल्‍लै हिठी।’</char> <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" /><char style="wj">तिन्‍नैं समझ़कार शोहरी दैनअ तिन्‍नां लै ज़बाब, ‘इहअ निं हआ कि अह तेल नां हाम्हां लै पूरअ होए अर नां तम्हां लै, एता का आसा भलअ इहअ कि तम्हैं आणा हाट्टी का आप्पू लै होर तेल मोलै लई।’</char><verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />
    <char style="wj">“ज़ांऊं तिंयां हाट्टी लै तेला मोल लंदी डेऊई, तेतरी गअ लाल़अ एछी अर ज़ुंण तेऊ मोक्‍कै तिथी तैर थिई, तिंयां डेऊई लाल़ी पिछ़ू बैहे पांडा लै। तेतरी हेरअ दुआर हूल़ी।</char> <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" /><char style="wj">पिछ़ू लागी दुआरा बागै खल़्हुई तिंयां बाकी कुंआरी शोहरी बी बोल्दी, ‘हे मालक, हे मालक, हाम्हां लै बी खोल्ह पोर्ही दुआर।’</char><verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />
    <char style="wj">“लाल़ै दैनअ तिन्‍नां लै ज़बाब, ‘हुंह खोज़ा तम्हां का सत्त, हुंह निं तम्हां बछ़ैणदअ कि तम्हैं कुंण आसा?’</char><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />
    <char style="wj">“बिऊंतै रहा किल्हैकि तम्हां का निं ऐहा गल्‍लो थोघ आथी कि सह साईत केभै हणीं ज़ेभै हुंह फिरी एछणअ।</char><verse eid="MAT 25:13" /></para>
  <para style="s">सुन्‍नें सिक्‍कै</para>
  <para style="r">(<ref loc="LUK 19:11-27">लूका 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="wj">“अह आसा तेऊ मणछे दशा ज़िहअ ज़ुंणी परदेसा लै डेऊंदी बारी आपणीं सारी ज़ैदात आपणैं दासा का डाही सभाल़ी।</char> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><char style="wj">तेऊ दैनी आपणैं एकी दासा का पांज़ सुन्‍नें सिक्‍कै करै भरी दी पांज़ थैल्‍ली, दुजै लै दैनी दूई थैल्‍ली अर चिऊथै लै दैनी सुन्‍नें सिक्‍कै करै भरी एक थैल्‍ली। मतलब तेऊ दैनअ हरेकी लै ज़ेतरअ ज़ुंण सभाल़ी सका त तेते साबै सोभी लै बांडी अर आप्पू डेऊअ सह परदेसा लै।</char><verse eid="MAT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16" />
    <char style="wj">“तेखअ ज़हा का तेऊ सुन्‍नें सिक्‍कै करै भरी दी पांज़ थैल्‍ली दैनी, तेऊ किअ तेभी तेता करै लैण-दैण शुरू अर तिहअ करै खटै तेऊ तेता करै पांज़ सुन्‍नें सिक्‍कै करै भरी पांज़ थैल्‍ली होर।</char> <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" /><char style="wj">इहअ करै ज़हा लै दूई सुन्‍नें सिक्‍कै करै भरी थैल्‍ली थिई दैनी दी, तेऊ बी खटै तेते दुगणैं सिक्‍कै होर।</char> <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" /><char style="wj">पर ज़हा लै सुन्‍नें सिक्‍कै करै भरी दी एक्‍कै थैल्‍ली थिई दैनी दी, तेऊ खण्हीं माट्टै दी एक डुघी खात्ती, संघा ज़ुंण तेऊए मालकै सह सुन्‍नें सिक्‍कै करै भरी थैल्‍ली थिई दैनी दी, सह डाही तेऊ तेथ दाबी।</char><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />
    <char style="wj">“तेखअ हुअ इहअ कि खास्सै धैल़ै बाद आअ तिन्‍नां दासो मालक घअरा लै बापस। संघा लागअ सह तिन्‍नां का साबा कताबा पुछ़दअ ताकि इहअ थोघ लागे कि तिन्‍नैं लैण-दैण करी तिन्‍नैं केतरअ खटअ।</char> <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" /><char style="wj">ज़हा लै सुन्‍नें सिक्‍कै करै भरी दी पांज़ थैल्‍ली थिई दैनी दी, तेऊ आणी सुन्‍नें सिक्‍कै करै भरी पांज़ थैल्‍ली मालका सेटा लै होर, संघा बोलअ तेऊ दासै इहअ, ‘हे मालक तंऐं ज़ुंण मुल्है सुन्‍नें सिक्‍कै करै भरी पांज़ थैल्‍ली थिई सभाल़ी दी, भाल़, तेता करै खटी मंऐं पांज़ थैल्‍ली भरी सुन्‍नें सिक्‍कै होर।’</char><verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />
    <char style="wj">“मालकै बोलअ तेऊ लै, ‘शाबाश, हुंह हुअ ताह करै खुश तूह, आसा राम्बल़अ अर भरोस्सै करनै जोगी दास। किल्हैकि तंऐं किअ थोल़ै दी विश्वास। मुंह बणाणअं तूह खास्सी च़िज़ो मालक अर तूह हणअ मुंह संघै मेरी खुशी दी साझ़ू।’</char><verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />
    <char style="wj">“इहअ ई ज़हा लै सुन्‍नें सिक्‍कै करै भरी दी दूई थैल्‍ली थिई दैनी दी, तेऊ बी आणी सुन्‍नें सिक्‍कै करै भरी दी दूई होर थैल्‍ली, संघा बोलअ इहअ, ‘हे मालक तंऐं ज़ुंण मुखा सुन्‍नें सिक्‍कै करै भरी दी दूई थैल्‍ली थिई सभाल़ी दी, भाल़ मंऐं खटी तेता करै सुन्‍नें सिक्‍कै करै भरी दूई थैल्‍ली होर।’</char><verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />
    <char style="wj">“मालकै बोलअ तेऊ लै, ‘शाबाश, तूह आसा मेरअ भरोस्सै जोगी दास तुबी रहअ थोल़ै दी विश्वासी, तुबी बणाणअं मुंह ऐबै खास्सी गल्‍लो मालक, अर तुबी हणअ मुंह संघै मेरी खुशी दी साझ़ू।’</char><verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />
    <char style="wj">“खिरी आअ सह ज़हा सुन्‍नें सिक्‍कै करै भरी एक्‍कै थैल्‍ली भेटी ती, तेऊ बी बोलअ मालका सेटा एछी, ‘हे मालक, मुखा त तेरअ थोघ कि तूह आसा बडअ काठअ मणछ। तूह करा होरीए कामां का बी आप्पू लै कमाई! ज़िधी नांईं बऊंदअ तिधा का लऊआ अर ज़िधी नांईं छिंगदअ तिधा का झाल़ा!’</char> <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" /><char style="wj">तैही लागी मुंह ताखा डअर कि तेरी ज़ैदात निं लोल़ी मेरै भलै ज़ांऐं हुई! तेता का डाही मंऐं सह तंऐं दैनी दी सुन्‍नें सिक्‍कै करै भरी थैल्‍ली माट्टै जैंदरी खात्ती दाबी। भाल़, अह आसा सह ई सुन्‍नें सिक्‍कै करै भरी दी थैल्‍ली ज़ुंण तंऐं थिई मुखा सभाल़ी दी।</char><verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />
    <char style="wj">“मालकै दैनअ तेऊ लै ज़बाब, ‘ओ कदुष्ट, नज़ाहणै दास! ज़ै ताखा इहअ थोघ थिअ कि ज़िधी हुंह नांईं बऊंदअ तिधा का लऊआ अर ज़िधी हुंह नांईं छिंगदअ तिधा का झाल़ा हुंह।</char> <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" /><char style="wj">तै तंऐं मेरै ढब्बै कहा बपारी लै बैज़ा दी किल्है निं दैनै ताकि हुंह तिन्‍नां का बैज़-सूत संघी ता लंदअ बापस?’</char><verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />
    <char style="wj">“तेखअ बोलअ मालकै होरी दासा लै, ‘एऊ का मांगा ऐहा सुन्‍नें सिक्‍कै करै भरी दी थैल्‍ली ओर्ही अर एता दैआ तेऊ लै ज़हा का सुन्‍नें सिक्‍कै करै भरी दस थैल्‍ली आसा।</char> <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><char style="wj">किल्हैकि ज़हा का आसा, ज़ै सह तेता बर्ती ज़ाणें, तेऊ लै दैणअ होर अर ज़ेतरी तेऊ ज़रुरत आसा तेऊ का हणअ तेता का खास्सअ। ज़ुंणी मणछै बधिया बर्ताअ नांईं किअ, तेऊ का मांगणअ सह बी पोर्ही ज़ुंण धख ज़िहअ तेऊ का होए बी।</char> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><char style="wj">एऊ निक्‍कै दासा पाआ न्हैरी खुडी। तिधी हणअ अह सिधअ लेरा लांदअ अर दांदा कटिल्‍लदअ।’ </char><verse eid="MAT 25:30" /></para>
  <para style="s">नसाफ हणें धैल़ी</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <char style="wj">“ज़ांऊं हुंह मणछो पूत आपणैं प्रतप्पा दी आपणैं स्वर्ग दूता संघै फिरी एछणअ, तेभै बेशणअ मुंह आपणीं प्रतप्पी राज़गाद्दी दी नसाफ करदै।</char> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><char style="wj">तेभै करनी मुंह सोभै ज़ाती कठा। ज़िहअ फुआल बाकरी का भेडा ज़ुदी करा तिहै ई करनै धर्मीं अर पापी मणछ एकी-दुजै का ज़ुदै।</char> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" /><char style="wj">भेडा करनी मुंह आपणीं दैहणीं बाखा अर बाकरी करनी तेऊ आपणीं बाऊंईं बाखा खल़ी।</char><verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />
    <char style="wj">“तेभै बोल़णअ मुंह राज़ै आपणीं दैहणीं बाखा आल़ै लै, ‘ओ लोगो ज़हा लै मेरै बाब बर्गत दैनी, तम्हैं एछा, संघा करा तेऊ मुल्खा प्रैंदै राज़। ज़ुंण तम्हां लै तेऊ संसार बणाऊंदी बारी आसा बणाअं द।</char> <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><char style="wj">किल्हैकि हुंह थिअ भुखअ अर तम्हैं दैनअ मुल्है खाणां लै। ज़ेभै हुंह नचिशअ थिअ, तम्हैं पणैऊंअं मुखा पाणीं। हुंह त परदेसी अर तम्हैं किअ मुल्है आपणैं घअरै रहणा लै छ़ांदअ।</char> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" /><char style="wj">हुंह त नांगअ अर तम्हैं दैनै मुल्है बान्हणां लै झिकल़ै। हुंह त बमार अर तम्हैं किई मेरी कारी-फाज़त। हुंह थिअ कैदखानै, तेभै आऐ तम्हैं मुंह सेटा लै हेरा-सभाल़ा।’</char><verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />
    <char style="wj">“तेभै दैणअ धर्मीं मणछा तेऊ लै इहअ ज़बाब, ‘हे प्रभू, हाम्हैं कधू भाल़अ तूह भुखअ कि हाम्हैं खैऊअ? अर तूह कधू त नचिशअ कि ताखा पणैऊंअं हाम्हैं पाणीं?</char> <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" /><char style="wj">हाम्हैं कधू भाल़अ तूह परदेसी कि घअरै डाहअ अर कधू थिअ नांगअ कि हाम्हैं ताखा झिकल़ै बन्हैऊंऐं?</char> <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" /><char style="wj">तूह कधू थिअ बमार? कधू थिअ तूह कैद खानै अर कधू आऐ हाम्हैं ताह सेटा लै हेरा-सभाल़ा?’</char> <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" /><char style="wj">तेभै दैणअ मुंह धर्मीं राज़ै तिन्‍नां लै ज़बाब, ‘हुंह खोज़ा तम्हां का सत्त कि ज़ुंण तम्हैं मुंह दी विश्वास करनै आल़ै होछ़ै का होछ़ै भाई-बैहणी मांझ़ै कहा एकी संघै बी इहअ भलअ बभार किअ, सह किअ तम्हैं मुल्है।’</char><verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />
    <char style="wj">“तेखअ बोल़णअ मुंह आपणीं बाऊंईं पाशल़ी आल़ै लै, ‘तम्हैं डेओआ मुखा दूर ज़हा लै परमेशरो फिटक आसा! तम्हैं डेओआ तैहा आगी जैंदरा लै ज़ुंण राख्स अर तेऊए दूत सदा लै आसा डाही दी ज़ुंण कधि निं हिठदी।</char> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" /><char style="wj">किल्हैकि ज़ेभै हुंह भुखअ थिअ तेभै निं तम्हैं मुल्है रोटी दैनी। हुंह त नचिशअ अर तम्हैं निं मुखा पाणीं बी पणैऊंअं!</char> <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" /><char style="wj">हुंह त परदेसी पर तेभै निं तम्हैं मुल्है आपणैं घअरै रहणा लै ज़ैगा दैनी। हुंह थिअ नांगअ अर तम्हैं निं मुल्है झिकल़ै दैनै। हुंह थिअ बमार अर कैद खानै पर तम्हैं निं मेरी हेर-सभाल़ किई!’</char><verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />
    <char style="wj">“तेभै दैणअ तिन्‍नां मुल्है ज़बाब, ‘हे प्रभू हाम्हैं कधू भाल़अ तूह भुखअ, नचिशअ, नांगअ, परदेसी बमार या कैद खानै दी, अर कधू निं हाम्हैं तेरी च़ाकरी किई?’</char><verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />
    <char style="wj">“तेभै दैणअ मुंह तिन्‍नां लै ज़बाब, ‘हुंह खोज़ा तम्हां का सत्त कि ज़ुंण तम्हैं मेरै इना होछ़ै का होछ़ै बैहणी अर विश्वासी भाईए-बैहणीए मज़त करना लै हुधूऐ, तिंयां हुधूऐ तम्हैं मुल्है!’</char><verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />
    <char style="wj">“तैही आसा अह सदा रहणैं आल़ी सज़ा तम्हां लै ज़ुंण बाऊंईं बाखा आसा खल़्हुऐ दै। दैहणीं बाखा खल़ै धर्मीं मणछा भेटणीं सदा रहणैं आल़ी लै ज़िन्दगी।”</char><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">ईशूए लै छ़ल़</para>
  <para style="r">(<ref loc="MRK 14:1">मार्कुस 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">लूका 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">जोहन्‍ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ज़ांऊं ईशू इना गल्‍ला बोली मुक्‍कअ, तेखअ लागअ सह आपणैं च़ेल्‍लै लै बोल्दअ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><char style="wj">“तम्हां का आसा थोघ कि दूई धैल़ै बाद आसा ऊवार्णैओ थैर। हुंह मणछो पूत करनअ कैद कि मुंह क्रूसा दी मारी पाए।”</char><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />तेखअ हुऐ बडै प्रोहत अर सैणैं काईफा नाओंए माहा प्रोहते भबनै कठा। तिधी किई तिन्‍नैं एक पांच़ी। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />तिंयां लागै आप्पू मांझ़ै इहअ जोग करदै कि ईशू ढाकणअ हाम्हां छ़ल़-कपट करी बी संघा पाणअ मारी। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />तेखअ लागै तिंयां इहअ बी बोल्दै कि ऊवार्णे जाचे धैल़ी निं हाम्हां इहअ करनअ, इहअ निं हआ कि लोग उपद्रभ करे।<verse eid="MAT 26:5" /></para>
  <para style="s">बेथनी गराऊंऐं सखाऊअ ईशू सबक</para>
  <para style="r">(<ref loc="MRK 14:3-9">मार्कुस 14:3-9</ref>; <ref loc="JHN 12:1-8">जोहन्‍ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />तेखअ डेऊअ ईशू बेथनी गराऊंऐं, तिधी त सह शमौन नाओंए मणछे घअरै ज़ुंण ईशू कोहल़ा का शुचअ किअ त। <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ईशू थिअ रोटी खांदअ बेठअ द, तिधी आई एक बेटल़ी अर तैहा आणअ संगमरमरे भांडै दी खुशबू दैणैं आल़अ किम्मती तेल। तैहा तरैल़अ सह तेल ईशूए मुंडै। <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />एता भाल़ी बोलअ रोश्शै च़ेल्‍लै इहअ, “अह इहअ किम्मती तेल किल्है किअ ऐहा ज़ांऐं? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />एता बेच़ी सका तै खास्सै ढब्बै भेटी अर तिन्‍नां ढब्बै सका तै रैनै-गरीबा लै बांडी।” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />अह गल्‍ल हेरी ईशू समझ़ी अर तेऊ बोलअ तिन्‍नां लै इहअ, <char style="wj">“ऐहा दैआ रहणैं, तम्हैं किल्है आसा ऐहा तंग करदै लागै दै? ऐहा किअ मुल्है भलअ।</char> <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" /><char style="wj">गरीब रहणैं कबल्‍लै तम्हां ई अर ज़ेभै थारअ दिल बोले तेभै सका तम्हैं तिन्‍नां लै दैई, पर हुंह निं तम्हां संघै कबल्‍लअ रहणअ।</char> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" /><char style="wj">ऐहा ज़ुंण अह मेरी देही दी खुशबू दैणैं आल़अ किम्मती तेल तरैल़अ, अह किई ऐहा मेरी देही दाबणे तैरी।</char> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" /><char style="wj">हुंह खोज़ा तम्हां का सत्त कि सारै संसारै ज़िधी बी मेरै बारै खुशीओ समाद खोज़े, तिन्‍नां मणछा खोज़णअ एसे बारै बी कि ऐहा मुल्है किज़ै किअ।”</char><verse eid="MAT 26:13" /></para>
  <para style="s">करेती गराऊंए यहूदो विश्वास घात</para>
  <para style="r">(<ref loc="MRK 14:10">मार्कुस 14:10</ref>,<ref loc="MRK 14:11">11</ref>; <ref loc="LUK 22:3-6">लूका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />करेती गराऊंआं का आसा त ईशूए बारा च़ेल्‍लै मांझ़ै एक च़ेल्‍लअ यहूदा, सह डेऊअ बडै प्रोहता सेटा संघा बोलअ इहअ, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />“ज़ै हुंह ईशू कैद करना लै थारी मज़त करूं, तम्हां तेते मुल्है केतरै ढब्बै दैणैं?”</para>
  <para style="p" vid="MAT 26:15">तिन्‍नैं बोलअ इहअ, “ताल्है दैणैं हाम्हां तोली करै तिह च़ंदीए सिक्‍कै।” <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />सह रहअ तेभी पोर्ही तेऊ मोक्‍के ताका कि सह किहअ करै ईशू ढाकणैं बझ़ैल़े।<verse eid="MAT 26:16" /></para>
  <para style="s">च़ेल्‍लै संघै आखरी रोटीए थैरो भोज़</para>
  <para style="r">(<ref loc="MRK 14:12-21">मार्कुस 14:12-21</ref>; <ref loc="LUK 22:7-13">लूका 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">जोहन्‍ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />आखरी रोटीए थैरा का पैहली धैल़ी लागै च़ेल्‍लै ईशू का पुछ़दै, “हे प्रभू, तूह किधी च़ाहा कि हाम्हैं ताल्है ऊवार्णे थैरो भोज़ बणाणें तैरी करे?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं डेओआ नगरी लै। तिधी भेटणअ तम्हां एक मणछ। तेऊ लै बोलै कि गूरू बोला इहअ कि मेरअ बगत आसा नेल़, अर मुंह मनाऊंणअ तेरै घअरै आपणैं च़ेल्‍लै संघै एछी अह ऊवार्णैओ थैर।”</char> <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />ज़िहअ ईशू बोलअ, च़ेल्‍लै किअ तिहअ ई, संघा बणाअं च़ेल्‍लै तेऊ घअरै ऊवार्णे थैरो भोज़।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />ज़ांऊं सान्ह पल़ी, ईशू बेठअ आपणैं बारा च़ेल्‍लै संघै रोटी खांदअ। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />ज़ांऊं तिंयां खांदै लागै, ईशू बोलअ तिन्‍नां लै, <char style="wj">“हुंह खोज़ा तम्हां का सत्त कि तम्हां मांझ़ै बझ़ैल़णअ हुंह कहा एकी ज़ण्हैं ढाकणैं।”</char> <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />ऐहा गल्‍ला शूणीं हुऐ तिंयां खास्सै दुखी, अर तिंयां लागै एक-एक करी बारी-बारी ईशू का पुछ़दै, “हे गूरू सह हुंह किनी आसा?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />ईशू दैनअ तिन्‍नां लै ज़बाब, <char style="wj">“ज़ुंणी मुंह संघै एभै मेरै थाल़ू का खाअ, तेऊ ई बझ़ैल़णअ हुंह ढाकणैं।</char> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="wj">हुंह मणछो पूत ता मरनअ तेऊ ई साबै ज़िहअ मेरै बारै पबित्र शास्त्रा दी आसा लिखअ द। पर तेऊ मणछा लै आसा घोर आफ़त! ज़हा हुंह ढाकणैं बझ़ैल़णअ। तेऊ लै हणअ त भलअ इहअ ई कि तेऊओ ज़ल्म ई नांईं हंदअ।”</char> <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />तेखअ बोलअ करेती गराऊंए यहूदा ईशू लै ज़ुंणी ईशू ढाकणैं थिअ लाअ द बझ़ैल़ी, “हे गूरू सह हुंह किनी आसा?” ईशू बोलअ तेऊ लै, <char style="wj">“तंऐं हेरअ एभै बोली।”</char><verse eid="MAT 26:25" /></para>
  <para style="s">प्रभू भोज़</para>
  <para style="r">(<ref loc="MRK 14:22-26">मार्कुस 14:22-26</ref>; <ref loc="LUK 22:14-20">लूका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 करिन्थी 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />ज़ांऊं तिंयां रोटी खांदै बेठै, ईशू च़की एक रोटी संघा किअ परमेशरो शूकर, तेखअ किऐ तैहा रोटीए म्हार-म्हार। तिंयां रोटीए म्हार दैनै तेऊ आपणैं च़ेल्‍लै लै इहअ बोली, <char style="wj">“हुंज़ा, खाआ अह आसा मेरी देही।”</char> <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />तेखअ च़कअ ईशू दाखे रसो प्रिहअ हाथै, सह बी दैनअ परमेशरो शूकर करी च़ेल्‍लै लै, संघा बोलअ इहअ, <char style="wj">“एता का झुटा तम्हैं सोभै।</char> <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><char style="wj">किल्हैकि अह आसा मेरअ लोहू, अह आसा मणछा संघै परमेशरे नऊंईं करार। बल़ीदानो अह लोहू बहाऊंणअ खास्सै मणछे पाप माफी लै।</char> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" /><char style="wj">हुंह बोला तम्हां लै इहअ कि अह दाखो रस निं मुंह तेभै तैणीं झुटणअ ज़ेभै तैणीं तम्हां सोभी संघै बेशी आपणैं बाबे राज़ा दी नऊंअ दाखो रस निं झुटूं।”</char> <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" /><char style="wj">तेखअ डेऊऐ ईशू अर तेऊए च़ेल्‍लै ऊवार्णे थैरे गिहा बोल्दी बागै जैतून धारा लै।</char><verse eid="MAT 26:30" /></para>
  <para style="s">पतरासे हुधणें बारै गल्‍ला प्रगट करनी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मार्कुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लूका 22:31-34</ref>; <ref loc="JHN 13:36-38">जोहन्‍ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />तेखअ बोलअ ईशू आपणैं च़ेल्‍लै लै, <char style="wj">“तम्हैं हणैं आझ़ ई राची मुखा दूर किल्हैकि पबित्र शास्त्रा दी आसा लिखअ द,</char></para>
  <para style="q" vid="MAT 26:31">
    <char style="wj">‘मुंह पाणअ फुआल मारी</char></para>
  <para style="q" vid="MAT 26:31">
    <char style="wj">अर छ़ुंडे भेडा छिंघणीं ओरी-पोरी।’”</char><verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />तेखअ बोलअ ईशू तिन्‍नां लै इहअ, <char style="wj">“पर हुंह हणअ तेखअ भिई ज़िऊंदअ, संघा डेऊणअ मुंह गलील मुल्खा अर तम्हैं एछणैं बादा का तिधी मुंह सेटा।”</char> <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />ऐहा गल्‍ला शूणीं बोलअ पतरासै, “होर लागे ताह छ़ाडी डेऊंदै पर हुंह निं ताखा दूर डेऊंदअ।” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />ईशू बोलअ तेऊ लै, <char style="wj">“हुंह खोज़ा ताखा सत्त कि आझ़ ऐहा ई राची मुर्गै दूई बारी बाशणैं का आजी हुधणअ तूह मेरै बारै चिई बारी।”</char> <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />पतरासै दैनअ ईशू लै ज़बाब, “ज़ै मुंह ताह संघै मरनअ बी पल़े, तैबी निं हुंह तेरै बारै हुधदअ।” अर इहअ ई बोलअ तिन्‍नैं होरी च़ेल्‍लै बी।<verse eid="MAT 26:35" /></para>
  <para style="s">गतसमनीं नाओंए ज़ैगा प्राथणां</para>
  <para style="r">(<ref loc="MRK 14:32-42">मार्कुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लूका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तेखअ डेऊअ ईशू गतसमनीं नाओंए ज़ैगा संघा बोलअ आपणैं च़ेल्‍लै लै, <char style="wj">“इधी रहै तेभै तैणीं बेशी ज़ेभै तैणीं कि हुंह प्राथणां करी फिरी निं एछूं।”</char> <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />तेऊ निंयैं पतरास अर जबदीओ शोहरू जोहन्‍ना अर याकब आप्पू संघै, अर ईशू हुअ खास्सअ दुखी। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तेखअ बोलअ ईशू, <char style="wj">“मेरअ ज़िऊ आसा भितरा का इहअ दुखी कि मेरै च़ाल्‍लअ शाह डेऊई, तम्हैं खल़्हिया इधी संघा रहै बिहुदै।”</char><verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />तेखअ डेऊअ ईशू धख आजू ज़िहअ संघा लागअ उटी बाखा प्राथणां करदअ, <char style="wj">“हे परमेशर, मेरै बाबा, ज़ै हई सके, तै कर मुखा ऐहा घल़ी एऊ दुखा दूर। तैबी निं तिहअ लोल़ी हुअ ज़िहअ हुंह च़ाहा, तूह कर तिहअ ई ज़िहअ तूह च़ाहा करनअ।”</char> <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />तेखअ आअ ईशू तिन्‍नां चिई च़ेल्‍लै सेटा अर तिन्‍नां सुत्तै दै भाल़ी बोलअ ईशू पतरासा लै, <char style="wj">“तम्हैं एकी घल़ी बी निं बिहुदै रही सकै?</char> <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><char style="wj">बिहुदै रहा अर प्राथणां करदै रहा लागी ताकि तम्हैं खरी दी पल़ी पाप नां करे। थारअ शाह ता बोला पर देही आसा कमज़ोर।”</char> <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />तेखअ डेऊअ ईशू दुजी बारी प्राथणां करदअ अर ईशू किई एही प्राथणां, <char style="wj">“हे मेरै बाबा, ज़ै मेरै झुटै बाझ़ी अह दुखो प्रिहअ नांईं हटी सकदअ, तै लोल़ी तेरी मरज़ी पूरी हुई।”</char> <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />तेखअ आअ ईशू भिई आपणैं च़ेल्‍लै सेटा लै अर तेऊ भाल़ै तिंयां घणीं निंजा सुत्तै दै। <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />ईशू डेऊअ तिन्‍नां छ़ाडी भिई प्राथणां करदअ अर सह ई गल्‍ल बोली प्राथणां दी चिऊथी बारी। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />तेखअ आअ भिई ईशू आपणैं च़ेल्‍लै सेटा संघा बोलअ तिन्‍नां लै, <char style="wj">“तम्हैं रहा सुत्ती! बतेर्है सुत्तै ऐबै! भाल़ा, सह घल़ी गई एछी। हुंह मणछो पूत लाअ पापी मणछा का बझ़ैल़ी कैद करनै।</char> <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" /><char style="wj">खल़ै उझ़िआ, च़ाल्‍ला, हेरा, मुंह ढाकणैं आल़अ गअ एछी।”</char><verse eid="MAT 26:46" /></para>
  <para style="s">ईशू धोखै संघै ढाकणअ</para>
  <para style="r">(<ref loc="MRK 14:43-50">मार्कुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लूका 22:47-53</ref>; <ref loc="JHN 18:3-12">जोहन्‍ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />ईशू थिअ इहअ बोल्दअ ई लागअ द कि यहूदा ज़ुंण बारा च़ेल्‍लै मांझ़ै एक थिअ, सह आअ अर तेऊ संघै तै बडै प्रोहत अर यहूदी सैणैं खास्सै मणछ तलबारा अर शोठै पाई छ़ाडै दै। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />करेती गराऊंओ यहूदा त तिन्‍नां लै इहअ डाहअ द बोली कि ज़हा लै हुंह माख्खी दैंऊं, सह ई आसा ईशू तेऊ करै तम्हैं कैद। <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />तिधी पुजधी आअ तेभी यहूदा ईशू सेटा लै संघा बोलअ, “हे गूरू, नमस्ते” संघा तेऊ दैनी ईशू लै माख्खू।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />ईशू बोलअ तेऊ लै, <char style="wj">“मेरै साथी ज़ेता लै तूह आअ द आसा, तेता कर।”</char></para>
  <para style="p" vid="MAT 26:50">तेखअ आऐ तिंयां होर ईशू सेटा लै अर तिन्‍नैं किअ ईशू कैद। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />ईशू नेल़ खल़्हुऐ दै च़ेल्‍लै मांझ़ै काढी एकी आपणीं तलबार संघा बाही तेऊ माहा प्रोहते दासा लै अर तेऊओ कान शोटअ धरनीं।<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />तेखअ बोलअ ईशू तेऊ लै, <char style="wj">“आपणीं तलबार डाह काठी भितरी। किल्हैकि ज़ुंण होरी तलबारा करै मारा, तिंयां बी पाणै तलबारा करै मारी।</char> <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" /><char style="wj">तूह ऐहा गल्‍ला निं समझ़दअ आथी कि हुंह सका आपणैं बाबा का एही अरज़ बी करी कि मुंह सेटा लै छ़ाड बारा दला का बी खास्सै स्वर्ग दूत, तेऊ हेरनै एभी छ़ाडी!</char> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" /><char style="wj">पर इहअ हणअ आसा ज़रूरी, नांईं ता पबित्र शास्त्रे गल्‍ला किहअ करै हणीं पूरी?”</char> <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />तेखअ बोलअ तेभी ईशू तिन्‍नां मणछा लै, <char style="wj">“तम्हैं कै हुंह डाकू समझ़अ कि मुंह ढाकदै आसा तम्हैं तलबारा अर शोठै पाई निखल़ै दै? हुंह ता हर धैल़ै तम्हां संघा परमेशरे भबनै शिक्षा दैआ त, तेभै किल्है निं हुंह तम्हैं ढाकअ?</char> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" /><char style="wj">पर ईंयां सोभै गल्‍ला हुई एते तैणीं कि पबित्र शास्त्रा दी परमेशरे गूरै बोली दी गल्‍ला पूरी होए।”</char> तेखअ ठुर्है तिधा का सारै च़ेल्‍लै अर ईशू डाहअ तिधी कल्ही।<verse eid="MAT 26:56" /></para>
  <para style="s">ईशू निंयं यहूदी माहा सभा लै</para>
  <para style="r">(<ref loc="MRK 14:53-65">मार्कुस 14:53-65</ref>; <ref loc="LUK 22:54">लूका 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">जोहन्‍ना 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ईशू ढाकणैं आल़ै निंयं सह काईफा माहा प्रोहता सेटा लै अर तिधी थिऐ शास्त्री अर सैणैं कठा हुऐ दै। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पतरास बी डेऊअ तिन्‍नां पिछ़ू-पिछ़ू माहा प्रोहते भबना तैणीं अर तिन्‍नें दास संघै रहअ फैंसलै न्हैल़अ बेठी।<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />बडै प्रोहत अर सारी सभा दी थिऐ सोभै लागै दै ईशू मारना लै इहै मणछा लोल़ै ज़ुंण ईशूए बारै झ़ुठी शाजत दैए। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />तिन्‍नैं आणै झ़ुठी शाजत दैणा लै खास्सै मणछ पर तज़ी बी निं तिन्‍नां ईशू दी इहअ दोश भेटअ कि तेऊ मारी पाए। <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />खिरी बोलअ दूई ज़ण्हैं इहअ, “एऊ बोलअ इहअ कि अह सका एऊ परमेशरे भबना ढोल़ी अर चिई धैल़ै भितरी सका भिई च़िणीं।”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तेखअ उझ़ुअ माहा प्रोहत खल़अ संघा बोलअ ईशू लै इहअ, “तूह बोल्दअ किल्है निं आथी? ईंयां मणछ भाल़ तेरै बारै किज़ै बोला?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पर ईशू रहअ च़ुप्पी अर तेखअ बोलअ माहा प्रोहतै, “परमेशर आसा पबित्र अर ज़िऊंदअ, ताह लोल़ी तेऊए सोह लागै, ज़ै तूह परमेशरो पूत मसीहा आसा तै खोज़ हाम्हां का।”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />तेखअ बोलअ ईशू तेऊ लै, <char style="wj">“तंऐं हेरअ आप्पै बोली, पर हुंह बोला तम्हां का इहअ बी कि एभा पोर्ही शुझणअ तम्हां का हुंह मणछो पूत सर्वशक्तिमान परमेशरे दैहणै बेठअ द अर बादल़ा प्रैंदै स्वर्गा का फिरी एछदअ।”</char><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />तेखअ धेल़अ माहा प्रोहतै रोश्शै आपणअ च़ोल़अ, संघा बोलअ, “एऊ किई परमेशरे निंदा, ऐबै निं हाम्हां कोही शाजते ज़रुरत आथी? तम्हैं सोभी बी हेरी अह गल्‍ला शूणीं कि अह बोला आप्पू लै परमेशर अर इहअ करै किई एऊ परमेशरे निंदा! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तम्हां होरीए कै राऐ आसा?”</para>
  <para style="p" vid="MAT 26:66">तिन्‍नैं होरी बोलअ, “अह आसा मारनै ई जोगी!” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />तेखअ थुक्‍कअ तिन्‍नैं ईशूए मुंहां लै, अर कोई लागै तेऊ लै धमुक्‍कै बाहंदै। होरी ढोपी तेऊए आछी संघा लागै तेऊ लै च़ैंडै बाही इहअ बोल्दै, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“ज़ै तूह मसीहा आसा, तै खोज़ हाम्हां का कि ताल्है कुंणी बाही?”<verse eid="MAT 26:68" /></para>
  <para style="s">पतरास हुधूअ</para>
  <para style="r">(<ref loc="MRK 14:66-72">मार्कुस 14:66-72</ref>; <ref loc="LUK 22:56-62">लूका 22:56-62</ref>; <ref loc="JHN 18:15-18">जोहन्‍ना 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पतरास थिअ माहा प्रोहते भबने ताटी बेठअ द, तेऊ का लागी तिधी एक दासी इहअ पुछ़दी, “तुबी त एऊ गलीली ईशू संघै भाल़ी?”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />पतरासै किअ तिन्‍नां सोभी नदरी इहअ बोली नांईं, “तूह किज़ै बोला? मुखा निं किछ़ी गल्‍लो थोघ आथी!”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />तेखअ डेऊअ पतरास डेहल़ा बागै, तिधी बी बोलअ एकी होरी मणछै पतरासा भाल़ी तिधी तिन्‍नां होरी का, “अह बी त नासरत गराऊंए ईशू संघै।” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />पतरासै सोह संघा हुधूअ, “हुंह निं तेऊ मणछा बछ़ैणदअ बी आथी।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />थोल़ी घल़ी बाद ज़ुंण तिधी थिऐ, तिन्‍नैं बोलअ पतरासा नेल़ एछी, “तेरी गल्‍ला का ज़ाण्हिंआं इहअ कि तूह आसा सच्च़ी तिन्‍नां ई मांझ़ै एक।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />तेखअ लागअ पतरास भिई सफाई दैंदअ अर सोह खाई बोल्दअ कि हुंह निं तेऊ मणछा बछ़ैणदअ ई आथी, अर तेभी बाशअ मुर्गअ बी।<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />पतरासा फिरी सह गल्‍ल आद ज़ुंण ईशू तेऊ लै बोली ती, <char style="wj">“मुर्गै दुजी बारी बाशणैं का आजी हुधणअ ताह मेरै बारै चिई बारी।”</char> सह डेऊअ तिधा का बागै, संघा लागअ हिंह करै लेरा लांदअ।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">राज़पाल पिलातुसे दरबारै ईशू</para>
  <para style="r">(<ref loc="MRK 15:1">मार्कुस 15:1</ref>; <ref loc="LUK 23:1">लूका 23:1</ref>,<ref loc="LUK 23:2">2</ref>; <ref loc="JHN 18:28-32">जोहन्‍ना 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />दोत्ती-दोत्थी हुऐ सोभी बडै प्रोहत, सैणैं, शास्त्री कठा अर तैहा माहा सभा बेठै दै हुऐ सोभ ईशू लै मौते सज़ा दैणा लै सैहमत। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />तेखअ निंयं ईशू तिन्‍नैं बान्हीं करै राज़पाल पिलातुसा सेटा लै।<verse eid="MAT 27:2" /></para>
  <para style="s">यहूदा करेतीए मौत</para>
  <para style="r">(<ref loc="ACT 1:18">शधाणूं 1:18</ref>,<ref loc="ACT 1:19">19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />ज़ांऊं करेती गराऊंए यहूदा का थोघ लागअ कि ईशू लै लाअ तिन्‍नैं झ़ुठअ दोश अर तिंयां च़ाहा तेऊ लै मौते सज़ा दैणीं। सह पछ़ताअ तेखअ खास्सअ अर तेऊ दैनै तिंयां तिह च़ंदीए सिक्‍कै बडै प्रोहता अर सैणैं लै बापस। <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />तेखअ बोलअ तेऊ तिन्‍नां लै इहअ बी,</para>
  <para style="p" vid="MAT 27:4">“मंऐं किअ अह पाप कि नर्दोश मणछ दैनअ थारै तम्हां का मारना लै?” तिन्‍नैं बोलअ इहअ, “एते हाम्हां कै फाही? एता ज़ाण तूह!”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तेखअ शोटै तेऊ तिंयां सिक्‍कै परमेशरे भबने खोल़ै अर आप्पू लै दैनी फांसी।<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />बडै प्रोहतै च़कै तिंयां सिक्‍कै संघा बोलअ, “बधाने साबै निं इना सिक्‍कै हाम्हैं भबने भढारै डाही सकदै। किल्हैकि ईंयां ढब्बै दैनै तै हाम्हैं कहा मणछा मारना लै किम्मत।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />तिन्‍नैं किअ आप्पू मांझ़ै जोग अर तिन्‍नां सिक्‍कै करै लअ तेता लै एकी खमारा का तेऊओ खेच मोलै, ताकि ज़ुंण परदेसी मणछ नगरी दी मरे, तिन्‍नें ल्हासा डाहणीं तेथ दाबी। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />इहअ करै आसा तेऊ खेचा नाअं आझ़ तैणीं लोहूओ खेच पल़अ द। <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />इहअ करै हुअ परमेशरे गूर जेरमयाह बोलअ द बैण पूरअ,</para>
  <para style="q" vid="MAT 27:9">“तिन्‍नैं च़कै तिंयां तिह च़ंदीए सिक्‍कै,</para>
  <para style="q" vid="MAT 27:9">सह ई मोल डाहअ इज़राईले आद-लुआदै तेऊ नमोल मणछो।<verse eid="MAT 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 27:10" />ज़िहअ प्रभू मुल्है हुकम किअ त,</para>
  <para style="q" vid="MAT 27:10">तिहअ ई दैनअ तिन्‍नैं खमारा लै तेऊए खेचो मोल।”<verse eid="MAT 27:10" /></para>
  <para style="s">राज़पाल पिलातुसे सुआल</para>
  <para style="r">(<ref loc="MRK 15:2-5">मार्कुस 15:2-5</ref>; <ref loc="LUK 23:3-5">लूका 23:3-5</ref>; <ref loc="JHN 18:33-38">जोहन्‍ना 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ज़ांऊं ईशू राज़पाल पिलातुस सेटा खल़अ थिअ, तेऊ पुछ़अ ईशू का, “तूह कै यहूदीओ राज़अ आसा?”</para>
  <para style="p" vid="MAT 27:11">ईशू बोलअ, <char style="wj">“तंऐं हेरअ आप्पै बोली।”</char><verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />ज़ेभै बडै प्रोहत अर सैणैं ईशू लै दोशा लांदै तै लागै दै, तेभै निं ईशू तिन्‍नां लै किछ़ बी ज़बाब दैनअ। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />एता लै बोलअ पिलातुसै, “ताखा कै शुण्हदअ निं आथी कि ईंयां मणछ ताल्है किहै-किहै दोश लांदै आसा लागै दै?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />पर ईशू निं तेऊए गल्‍लो बी किछ़ै ज़बाब दैनअ, इधी तैणीं कि पिलातुस बी हुअ रहैन।<verse eid="MAT 27:14" /></para>
  <para style="s">मौते सज़ा दैणैंओ हुकम</para>
  <para style="r">(<ref loc="MRK 15:6-15">मार्कुस 15:6-15</ref>; <ref loc="LUK 23:13-25">लूका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">जोहन्‍ना 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />पिलातुसो त इहअ रबाज़ कि सह करा त तेऊ ऊवार्णे थैरे धैल़ी कैदखाने कैदी मांझ़ै एकी कैदी आज़ाद, ज़हा लै लोग बोले कि तेऊ करा आज़ाद। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />तेऊ ज़मानैं त बरोबा नाओं एक मशूर कैदी कैद खानै बंद किअ द। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />ज़ांऊं तिंयां कठा हुऐ, पिलातुसै बोलअ तिन्‍नां लै, “तम्हैं कहा च़ाहा कि हुंह छ़ाडूं तम्हां लै? बरोबा छ़ाडूं, कि ईशू, ज़हा लै मसीहा बोला?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />तेऊ का थिअ थोघ कि यहूदी आसा ईशू सिधअ ज़िदा लै ढाकअ द अर आसा ईशू नर्दोश।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />पिलातुस त पांच़े गाद्दी दी बेठअ द, तेऊए लाल़ी दैनअ तेऊ लै समाद, “तूह निं एऊ धर्मीं मणछा लै किछ़ै करी। अह आसा नर्दोश, हिझ़ राची हुअ मुंह एऊए बारै सुपनअ अर तेता करै आसा मेरै मन्‍नैं खास्सअ झाख पल़अ द।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />बडै प्रोहतै अर सैणैं शकाऊऐ होर लोग इहै कि तम्हैं मांगै बरोबा अर ईशू लै बोलै इहअ कि एऊ पाआ मारी। <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />पिलातुसै ज़ांऊं इहअ पुछ़अ कि इना दूई मांझ़ै तम्हां कुंण लोल़ी कि तम्हां लै हुंह छ़ाडूं?</para>
  <para style="p" vid="MAT 27:21">तिन्‍नैं सोभी बोलअ इहअ, “हाम्हां लै छ़ाड बरोबा।”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />पिलातुसै पुछ़अ तिन्‍नां का, “तै ईशूओ ज़हा लै मसीहा बोला, एऊओ कै करूं?”</para>
  <para style="p" vid="MAT 27:22">तिन्‍नैं सोभी बोलअ इहअ कि एऊ पाआ क्रूसा दी मारी।<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पिलातुसै बोलअ तिन्‍नां लै, “किल्है, एऊ किज़ै ज़ुल्म किअ?”</para>
  <para style="p" vid="MAT 27:23">पर तिन्‍नैं लाई होर बी खास्सी भिई ज़ोरै-ज़ोरै लैल़ा, “एऊ छ़ड़ाऊआ क्रूसा दी।”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />ज़ांऊं पिलातुसै भाल़अ कि अह गल्‍ल निं हणैं आल़ी आथी अर इनै लाअ ऐबै होर बी उपद्रभ करी, तेऊ मांगअ पाणींओ प्रिहअ संघा धोऐ तिन्‍नां नदरी आपणैं हाथ, तेखअ बोलअ तिन्‍नां लै, “हुंह आसा एऊ धर्मीं मणछे लोहू का नर्दोश, अर एता ज़ाणा ऐबै तम्हैं ई।”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />तेखअ दैनअ तिन्‍नैं सोभी लोगै ज़बाब, “एऊ मारनैओ दोश लोल़ी हाम्हां अर म्हारै शोहरू लै लागअ।”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />इहअ शूणीं किअ पिलातुसै लोगा खुश करनै तैणीं बरोबा कैद खानै का आज़ाद, अर ईशू दैनअ कोल़ै करै च़िक्‍की क्रूसा दी छ़ड़ाऊंणा लै।<verse eid="MAT 27:26" /></para>
  <para style="s">सपाही किअ ईशू संघै बूरअ बभार</para>
  <para style="r">(<ref loc="MRK 15:16-20">मार्कुस 15:16-20</ref>; <ref loc="JHN 19:2">जोहन्‍ना 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तेखअ निंयं पिलातुसे सपाही ईशू गहल़ा भितरी राज़ भबनै अर फेर डाही सपाहीए पल़टण खल़ी करी। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />तेखअ खोल्हअ तिन्‍नैं ईशूओ च़ोल़अ पोर्ही संघा बन्हैऊंअ बैंज़णीं रांगो च़ोल़अ। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />तेखअ बणाअं झ़रीलै कांडैओ मुगट संघा डाहअ ईशूए मुंडै, हाथै दैनी एक शोठी। संघा लागै तेऊ आजू ज़ान्हूं दी बेशी इहै सुहांगा करदै, “हे यहूदीए राज़ैआ, नमस्ते।” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />तिन्‍नैं पाअ ईशूए मुंहैं थुक्‍की अर तेऊ का सह शोठअ छ़ड़ैऊई लागै तेता करै तेऊ लै बाहंदै। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ज़ांऊं तिंयां सुहांग करी मुक्‍कै, तेखअ खोल्हअ तिन्‍नैं तेऊ का बैंज़णीं रांगो च़ोल़अ पोर्ही संघा बन्हैऊंऐं ईशू का तेऊओ ई च़ोल़अ। तेखअ निंयं तिन्‍नैं ईशू क्रूसा दी मारना लै नगरी बागै।<verse eid="MAT 27:31" /></para>
  <para style="s">ईशू छ़ड़ाऊअ क्रूसा दी</para>
  <para style="r">(<ref loc="MRK 15:21-32">मार्कुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लूका 23:26-43</ref>; <ref loc="JHN 19:17-27">जोहन्‍ना 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />नगरी बागै डेऊंदी बारी भेटअ तिन्‍नां एक शमौन नाओं कुरेन नगरी का आअ द मणछ अर तिन्‍नैं ढाकअ सह नभैऊशै अर सह निंयं तिन्‍नैं तिधा पोर्ही ज़ोरा-ज़ोरी क्रूसा बगारू। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />तेखअ तैहा ज़ैगा ज़हा लै गुलगुता बोला, मतलब खोपल़ीए ज़ैगा, पुजी <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />दैनअ तिन्‍नैं मुर्र नाओंए दुआई राल़अ द दाखो मिल्‍लअ रस झुटणा लै पर ईशू निं तेता च़ाखणअ च़ाहंदअ त।<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />तेखअ छ़ड़ाऊअ तिन्‍नैं ईशू क्रूसा दी अर तिन्‍नैं सपाही बांडै आप्पू मांझ़ै परच़ी पाई तेऊए झिकल़ै। <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />संघा रहै तिंयां तिधी पहरी बेशी। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />पिलातुसै लिखअ एकी तगती दी ईशूओ दोश अर सह टोक्‍की क्रूसे च़ुंडी, तेथ त लिखअ द, “ईशू नासरी यहूदीओ राज़अ।” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />तिन्‍नैं छ़ड़ाऊऐ ईशूए क्रूसा नेल़ दूई डाकू बी एक ईशूए दैहणीं बाखा अर एक बाऊंईं बाखा क्रूसा।<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />तेस्सी बाती एछदै-डेऊंदै करा तै आपणैं मूंड झ़ल़ाऊई करै तिन्‍नें निंदा, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />संघा करा तै तिंयां इहअ बोली, “परमेशरे भबना ढोल़ी चिऐ धैल़ै बणाणैं आल़ैआ, तूह आप्पू ता बच़, ज़ै तूह परमेशरो पूत आसा, तै होथ क्रूसा का धरनीं।”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />इहअ ई लागै बडै प्रोहत, शास्त्री, सैणैं बी सोभ सुहांगा करदै अर इहअ बोल्दै, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“होर हेरै एऊ बच़ाऊई पर आप्पू निं अह बच़ी सकदअ! अह ता इज़राईलो राज़अ आसा। ऐबै ज़ै अह क्रूसा का धरनीं होथे, तै करनअ हाम्हां बी एऊ दी विश्वास।” <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />अह ता परमेशरे आसरै रहा, ज़ै परमेशर एऊ का खुश होए, तै छ़ड़ैऊए एऊ सह ई, अह ता इहअ बोला त, “हुंह आसा परमेशरो पूत!” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />इहअ ई ज़ुंण तिंयां ईशू संघै डाकू क्रूसा दी थिऐ छ़ड़ाऊऐ दै, तिंयां बी लागै ईशूए निंदा करदै।<verse eid="MAT 27:44" /></para>
  <para style="s">ईशूए प्राण शोटणै</para>
  <para style="r">(<ref loc="MRK 15:33-41">मार्कुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लूका 23:44-49</ref>; <ref loc="JHN 19:28-30">जोहन्‍ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />दपहरा पोर्ही चिऊथै पहरै तैणीं रहअ तेऊ सारी धरती घणअ नटिप्प न्हैरअ हई अर उडै तैणीं रही ज़ेही राच पल़ी। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />चिऊथै पहरा नेल़ बोलअ ईशू आपणीं बोली दी ज़ोरै-ज़ोरै इहअ, <char style="wj">“इलोई, इलोई, लम्मा शबक्तनी?”</char> मतलब <char style="wj">“हे मेरै परमेशर, हे मेरै परमेशर, तंऐं किल्है छ़ाडअ हुंह?”</char> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />ज़ुंण तिधी थिऐ खल़्हुऐ दै, तिन्‍नां मांझ़ै बोलअ कई इहअ, “अह आसा एलियाह लै हाक्‍का लांदअ लागअ द।” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />एक आअ ठुर्ही संघा डबेऊअ मिल्‍लै दाखे रसा दी शाट्टअ, अर नगाल़ीए च़ुंडी दी चैल़ी करै दैनअ तेऊ ईशूए खाखा च़ाखणा लै। <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />होरी बोलअ इहअ, “खल़्हिया, भाल़ा हैनूं कि एलियाह एछा बी एऊ बच़ाऊंदअ।”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />तेखअ शोटै ईशू ज़ोरै लैल़ पाई प्राण। <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />तै हेरा, परमेशरे भबनै लाअ द पल्दअ धेल़्हुअ प्रैंदा का थाल्‍लै तैणीं दूई बाखा लै अर सारी पृथूई हुई ज़ाज़री अर भिल़ी दी लागै पात्थर चटकारदै। <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />घोरी खुल्ही अर मूंऐं दै पबित्र मणछे ल्हासा हुई ज़िऊंदी <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />भिई ज़िऊंदै हई डेऊऐ तिंयां पबित्र एरुशलेम नगरी लै, तिंयां शुझुऐ तिधी खास्सै मणछा का।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />तेखअ ज़ुंण सुबैदार तिधी ईशू नेल़ पहरी थिअ, सह डरअ तिधी तैहा ज़ाज़री भाल़ी संघा लागअ इहअ बोल्दअ, “अह आसा सच्च़ी परमेशरो पूत।” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />तिधी ती गलील मुल्खा का ईशूए च़ाकरी लै खास्सी बेटल़ी बी आई दी अर तिंयां ती लागी दी इना सोभी गल्‍ला भाल़ी। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />तिन्‍नां मांझ़ै ती मगदल़ गराऊंए मरिअम, याकब अर युसुफे ईज मरिअम अर जबदीए शोहरूए ईज बी।<verse eid="MAT 27:56" /></para>
  <para style="s">ईशूए ल्हास दाबी डाहणीं</para>
  <para style="r">(<ref loc="MRK 15:42-47">मार्कुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लूका 23:50-56</ref>; <ref loc="JHN 19:38-42">जोहन्‍ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />ज़ांऊं सान्ह च़ाल्‍ली ती पल़ी, राज़पाल पिलातुसा सेटा आअ एक युसुफ नाओं अरमतियाह गराऊंओ सेठ मणछ, सह थिअ आप्पू बी ईशूओ च़ेल्‍लअ। तेऊ मांगी पिलातुसा का ईशूए ल्हास। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />राज़पाल पिलातुसै दैनी तेऊ लै ईशूए ल्हासा निंणे ज़ाज़त। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />युसुफै निंईं ल्हास बाछे कोरै शेतै झिकल़ै दी पल़ेटी, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />संघा डाही तेऊ सह ल्हास नऊंईं घोरी दी ज़ुंण तेऊ शाफल़ा दी मज़दूरा लाई ती कोती दी। तेखअ डाही तैहा घोरीए मोहरै एक बडी टोल्ह बदल़ी, संघा डेऊअ आपणैं घअरा लै। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />तिधी ती मगदल़ गराऊंए मरिअम अर दुजी मरिअम घोरी सम्हनै बेठी भाल़ी लागी दी।<verse eid="MAT 27:61" /></para>
  <para style="s">घोरी दी पहरअ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />दुजै धैल़ै हुऐ बशैघे धैल़ी बडै प्रोहत अर फरीसी मणछ राज़पाल पिलातुसा सेटा कठा, संघा बोलअ तिन्‍नैं राज़पाला लै, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“जनाब, हाम्हां का आसा थोघ कि तेऊ झ़ुठै मणछै बोलअ त आपणीं ज़िऊंदी ज़िता इहअ, ‘मेरै मरनै का बाद हणअ मुंह चिई धैल़ै बाद भिई ज़िऊंदै।’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />तूह दै इहअ हुकम कि चिई धैल़ै तैणीं डाहणअ हाम्हां तैहा घोरी बागै राची-धैल़ी पहरअ पाई ज़िधी सह दाबी आसा डाहअ द। इहअ निं हआ कि तेऊए च़ेल्‍लै तेऊए ल्हास च़ोरी पाए अर लोगा का लागे इहअ बोल्दै कि सह हुअ मरी करै ज़िऊंदअ। अह हणअ हाम्हां लै पिछ़लै धोखै का बी खास्सअ बूरअ।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />राज़पाल पिलातुसै बोलअ तिन्‍नां लै, “तम्हां का पहरी ता बतेर्है आसा, तम्हैं डेओआ, संघा पाआ आपणैं साबै तिधी पहरअ।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />तिंयां डेऊऐ संघा डाही घोरी बागै टोल्हा दी लाई रोम राज़ैए मोहर ताकि सरकारी मोहरा लाई दी टोल्हा पोर्ही नां काढे। तेखअ डाहअ तिधी सपाही करै पहरअ पाई।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">ईशूओ मरी करै ज़िऊंदै हणअ</para>
  <para style="r">(<ref loc="MRK 16:1-10">मार्कुस 16:1-10</ref>; <ref loc="LUK 24:1-12">लूका 24:1-12</ref>; <ref loc="JHN 20:1-10">जोहन्‍ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />बशैघे धैल़ी बाद, हबते पैहली धैल़ी आई दोत्ती-दोत्थी मगदल़ गराऊंए मरिअम अर दुजी मरिअम घोरी सेटा ईशू भाल़ी।<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />तिधी हुई हेरा-हेरी खास्सी ज़ाज़री, किल्हैकि प्रभूओ एक स्वर्ग दूत होथअ सरगा का, अर घोरीए मोहरै दी लाई दी बडी टोल्ह बदल़ी पोर्ही अर आप्पू बेठअ तेता प्रैंदै। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />तेऊए झिकल़ै तै शेतै अर तेथ ज़ाण्हिंआं त ज़िहअ पाल़अ पल़अ द अर च़मकदअ लागअ द अर तेऊओ रूप त बिज़ल़ी ज़िहअ। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />तेखअ लागै तेऊए डरै तिंयां पहरी काम्बदै अर तिंयां हुऐ ज़िहै मूंऐं दै मणछा ज़िहै।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />स्वर्ग दूतै बोलअ तिन्‍नां बेटल़ी लै, “तम्हैं निं डरा आथी, मुखा आसा थोघ कि तम्हैं आसा ईशू लोल़ी लागी दी ज़ुंण क्रूसा दी मारअ त। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />सह निं इधी आथी, पर ज़िहअ तेऊ बोलअ थिअ, तिहअ ई हुअ सह ज़िऊंदअ। एछा, ऐहा ज़ैगा भाल़ा ज़िधी ईशू त डाहअ द। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />तम्हैं डेओआ एभी तेऊए च़ेल्‍लै सेटा लै संघा खोज़ै तिन्‍नां का, ‘ईशू हुअ मरी करै ज़िऊंदअ, अर सह गअ तम्हां का आजी गलील मुल्खा लै डेऊई। सह शुझणअ तम्हां का तिधी, हेरे, मंऐं हेरअ तम्हां का खोज़ी।’”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />तिंयां बेटल़ी लागी डरै काम्बदी पर तिंयां ठुर्ही खुशी-खुशी घोरी सेटा का घअरा लै च़ेल्‍लै का समादा खोज़दी। <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />तिन्‍नां बेटल़ी भेटअ ईशू बाता नच़ानक। ईशू बोलअ तिन्‍नां लै, <char style="wj">“तम्हां लै लोल़ी शांती हुई।”</char> तिंयां डेऊई ईशू नेल़ संघा टेक्‍कअ ईशू सेटा माथअ। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तेखअ बोलअ ईशू तिन्‍नां लै, <char style="wj">“डरा निं आथी, मेरै होरी भाई लै बोला कि गलील मुल्खा लै डेओआ, हुंह शुझणअ तिन्‍नां का तिधी।”</char><verse eid="MAT 28:10" /></para>
  <para style="s">पहरीओ समाद दैणअ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />तिंयां बेटल़ी ती होरी च़ेल्‍लै सेटा लै समादा खोज़दी डेऊंदी ई लागी दी कि तिन्‍नां पहरी मांझ़ै डेऊऐ कई ज़ण्हैं नगरी लै, तिन्‍नैं खोज़ी बडै प्रोहता का सारी गल्‍ला। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />तेखअ हुऐ सैणैं, प्रोहत अर शास्त्री कठा संघा किई आप्पू मांझ़ै सलाह कि ऐबै आजू किज़ै करनअ। तिन्‍नैं दैनै तिन्‍नां समाद पजैल़ै सपाही लै खास्सी च़ंदीए ढब्बै रेशपत संघा डाहअ तिन्‍नां का इहअ बोली, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“ऐहा गल्‍ला निं कोही का खोज़ी। तम्हैं बोलै हथू लोगा का इहअ कि राची तै हाम्हैं सुत्तै दै अर तेऊए च़ेल्‍लै पाई राची ईशूए ल्हास च़ोरी। <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />ज़ै ऐहा गल्‍लो थोघ रोमी राज़पाल पिलातुसा का लागे, तेता लै समझ़ाऊंमै तेऊ हाम्हैं कि थारअ निं एथ किछ़ै कशूर आथी, ऐहा गल्‍लो फिकर निं तम्हैं करी।” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />तिन्‍नैं सपाही निंयैं ढब्बै अर ज़िहै तिंयां यहूदी सैणैं शगरेऊई तै डाहै दै, तिन्‍नैं खोज़ी होरी लोगा का तेही ई झ़ुठी गल्‍ला। अह गल्‍ल आसा आझ़ तैणीं बी यहूदी मांझ़ै सोभी एही ई समझ़ी दी।<verse eid="MAT 28:15" /></para>
  <para style="s">ईशूओ शुझणअ अर खिरी दैनअ द हुकम</para>
  <para style="r">(<ref loc="MRK 16:14-18">मार्कुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लूका 24:36-49</ref>; <ref loc="JHN 20:19-23">जोहन्‍ना 20:19-23</ref>; <ref loc="ACT 1:6-8">शधाणूं 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />तिंयां गैरा च़ेल्‍लै डेऊऐ गलील मुल्खे तैहा धारा प्रैंदै ज़ुंण ईशू तिन्‍नां का खोज़अ त। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />तिधी डेऊई भेटअ तिन्‍नां ईशू संघा टेक्‍कअ सोभी तेऊ सेटा माथअ। पर कई च़ेल्‍लै थिअ अज़ी बी मन्‍नैं बैहम कि अह सच्च़ी हुअ भिई ज़िऊंदअ! <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />ईशू आअ तिन्‍नां सेटा संघा बोलअ, <char style="wj">“स्वर्ग अर पृथूईओ सारअ हक दैनअ मुल्है।</char> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><char style="wj">एता लै डेओआ तम्हैं संसारे सोभी ज़ातीए लोगा सेटा लै अर बणाआं तिन्‍नां मेरै च़ेल्‍लै। संघा दैआ तिन्‍नां लै बाब परमेशर, परमेशर पूता अर परमेशर पबित्र आत्में नाओंऐं डुबकी।</char> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><char style="wj">तिन्‍नां का सखाऊआ तम्हैं तिन्‍नां सोभी गल्‍ला मनणी ज़ुंण मंऐं तम्हां का आसा खोज़ी दी। ऐहा गल्‍ला लै रहै तम्हैं निहंचै, हुंह आसा संसार खतम हणैं तैणीं सदा तम्हां संघै।”</char><verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>