  <para style="h">सैणीं गल्‍ला</para>
  <para style="toc1">सुलैमान राज़ै खोज़ी दी सैणीं गल्‍ला</para>
  <para style="toc2">सैणीं गल्‍ला</para>
  <para style="toc3">सैणीं.</para>
  <para style="mt1">सैणीं गल्‍ला</para>
  <para style="mt2">सुलैमान राज़ै खोज़ी दी सैणीं गल्‍ला</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: राज़अ सुलैमान</para>
  <para style="ili">सन: 971 का 686 ईसा आजी</para>
  <para style="ip">ऐहा कताबा दी आसा खास्सी सैणीं गल्‍ला खोज़ी दी, इना गल्‍ला करै दैआ तै पराणैं ज़मानैं धर्मीं ज़िन्दगी ज़िऊंणें शिक्षा। एता मांझ़ै आसा बोहू ज़ेही सैणीं गल्‍ला राज़ै सुलैमानै खोज़ी दी अर धख आसा आगूर अर राज़ै लमूएलै खोज़ी दी गल्‍ला।</para>
  <para style="ip">भज़ने कताबा ज़ेही आसा एथ बी सारी गल्‍ला भौंरु अर गिहा ज़ेही गांठी दी। एथ आसा सोभी का खास गल्‍ल एही खोज़ी दी कि अक्ल भेटा बिधाता बाखा मणछा लै दान। अक्ली करै भेटा भितरी बागै हर ज़ैगा राम्बल़ी सलाह।</para>
  <para style="ip">सैणीं गल्‍ले ऐहा कताबा दी आसा होछ़ै पोर्ही प्रोढै तैणीं सोभी लै सलाह कि बिधाते डरा हेठै रहंदी केही भली ज़िन्दगी लागा ज़िऊंणीं अर हर गल्‍ला दी किहै लागा समझ़कार हणअ। एथ आसा बभार, धन, बपार, च़ाल-च़लण, च़ाकरी, अक्ल अर होर कई गल्‍ले बारै बधिया सलाह खोज़ी दी।</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत अर सैणीं गल्‍ला केही लोल़ी समझ़ी 1:1-7</para>
  <para style="io1">आप्पू लै सलाह अर अक्ली लोल़णैंओ नफअ 1:8—7:27</para>
  <para style="io1">अक्लीए बड़ैई 8:1-35</para>
  <para style="io1">अक्लीओ भोज़ 9:1-18</para>
  <para style="io1">राज़ै सुलैमाने अक्ल 10:1—24:34</para>
  <para style="io1">राज़ै सुलैमानै खोज़ी दी होर सैणीं गल्‍ला 25:1—29:27</para>
  <para style="io1">आगूरै खोज़ी दी सैणीं गल्‍ला 30:1-33</para>
  <para style="io1">राज़ै लमूएलै आपणीं ईजा का शूणीं दी सैणीं गल्‍ला 31:1-31</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">अक्ली एछणेंओ मूल़</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />ईंयां सैणीं गल्‍ला आसा इज़राईल मुल्खे राज़ै दाबेदे शोहरू राज़ै सुलैमाने:<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />ज़ुंण इना गल्‍ला पहल़े, तिन्‍नां एछणी अक्ल, सबर</para>
  <para style="q" vid="PRO 1:2">अर तिन्‍नां समझ़णीं ईंयां सैणीं गल्‍ला राम्बल़ै करै।<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />एता करै लागणअ तिन्‍नां का थोघ कि</para>
  <para style="q" vid="PRO 1:3">किहअ करै लागा सुंबल़ी सोर डाही ज़िन्दगी ज़िऊंणीं,</para>
  <para style="q" vid="PRO 1:3">अर एता करै लागणअ तिन्‍नां का थोघ कि धर्म, नसाफ</para>
  <para style="q" vid="PRO 1:3">अर मानदारी किज़ै आसा।<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />एता का सका आम मणछ बी शिखल़ी कि</para>
  <para style="q" vid="PRO 1:4">छ़ल़ैघ किहअ करै हणअ,</para>
  <para style="q" vid="PRO 1:4">खारकअ मणछ सका एता का ज्ञैन अर सुंबल़ी सोर शिखल़ी।<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />इना सैणीं गल्‍ला करै एछणी अक्ली आल़ै मणछा होर बी खास्सी अक्ल</para>
  <para style="q" vid="PRO 1:5">अर छ़ल़ैघ मणछ समझ़णअ<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />सैणीं गल्‍लो, कहाबतो अर</para>
  <para style="q" vid="PRO 1:6">समझ़कार मणछै खोज़ी दी गल्‍लो गुप्त भेद।<verse eid="PRO 1:6" /></para>
  <para style="s">खारकै लै सलाह</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />बिधाते डरा हेठै रही एछा अक्ल,</para>
  <para style="q" vid="PRO 1:7">कबुधी मणछ निं अक्लीओ अदर करदै</para>
  <para style="q" vid="PRO 1:7">अर नां तिंयां शिखल़दै।<verse eid="PRO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />लान्हैंओ, आपणैं ईजा-बाबे शिक्षा दी दैआ धैन कि</para>
  <para style="q" vid="PRO 1:8">तिंयां तम्हां लै किज़ै बोला,<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />तिन्‍नें शिक्षा हणीं तम्हां लै मुंडे मुगट</para>
  <para style="q" vid="PRO 1:9">अर गल़े कंठी ज़ेही।<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />लान्हैंओ, पापी मणछे ज़ाणैं निं लागी</para>
  <para style="q" vid="PRO 1:10">नां तिन्‍नें गल्‍ला मनी। <verse eid="PRO 1:10" /><verse number="11" style="v" sid="PRO 1:11" />तिंयां सका तम्हां लै इहअ बोली,</para>
  <para style="q" vid="PRO 1:11">“एछा हाम्हां रहणअ कहा मारदै ताखुई!</para>
  <para style="q" vid="PRO 1:11">एछा, हाम्हां गोटणअ कुंण नर्दोश मणछ सुहांगा लै!<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />च़ाल्‍ला, ज़ुंण राम्बल़ै खांदै-ज़िऊंदै आसा</para>
  <para style="q" vid="PRO 1:12">तिंयां डाहणैं हाम्हां एकी बारी सोभै मरदै पाई।<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />हाम्हां लुटणीं जुध करी भांती-भांतीए किम्मती च़िज़ा</para>
  <para style="q" vid="PRO 1:13">अर तेता करै करनै हाम्हां आपणैं घअर भरी।<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />ज़ै तम्हैं म्हारै छ़ुंढा दी एछे,</para>
  <para style="q" vid="PRO 1:14">तै भेटणीं तम्हां बी तैहा च़ोरी दी साझ़।”<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />लान्हैंओ, इना इहै मणछे संगत निं करी</para>
  <para style="q" vid="PRO 1:15">इना इहै का रहै बच़दै।<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />ईंयां इहै मणछ डेओआ कबध खटणा लै ठुर्ही</para>
  <para style="q" vid="PRO 1:16">अर हत्या करना लै निखल़ा ईंयां सोभी का आजू।<verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />ज़ुंण च़ेल्‍लू ढाकणअ,</para>
  <para style="q" vid="PRO 1:17">तेऊ नदरी ज़ज़ाल़ फुआरनअ हआ बृथा<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />पर ईंयां इहै मणछ बूणा आप्पू लै आप्पै ज़ज़ाल़</para>
  <para style="q" vid="PRO 1:18">इहअ ज़ज़ाल़ ज़ेथ तिंयां आप्पू मरा।<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />दुजै लुटणैं आल़ेए लागा एकी धैल़ी आपणीं ज़ान</para>
  <para style="q" vid="PRO 1:19">किल्हैकि ज़ुंण होरी लै खण्हां,</para>
  <para style="q" vid="PRO 1:19">तेऊ लै हआ खण्हीं डाही दी।<verse eid="PRO 1:19" /></para>
  <para style="s">अक्ल बोला इहअ</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />शूणां, अक्ल आसा हाट्टा-बज़ारा का</para>
  <para style="q" vid="PRO 1:20">बेटल़ी ज़ेही हाक्‍का लांदी लागी दी,<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />नगरीए प्रऊल़ी सेटा</para>
  <para style="q" vid="PRO 1:21">ज़िधी लोगो झाल़अ हआ,</para>
  <para style="q" vid="PRO 1:21">तिधी पाई तैहा ज़ोरै-ज़ोरै एही हाक्‍का,<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />“हे ऐडै मणछो! तम्हैं कधू तैणीं रहणैं इहै ऐडै?</para>
  <para style="q" vid="PRO 1:22">तम्हां कधू तैणीं रहणअ</para>
  <para style="q" vid="PRO 1:22">ज्ञैन शास्त्रे सुहांगा करदै लागी?</para>
  <para style="q" vid="PRO 1:22">तम्हां कधू शिखल़णअ?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />अज़ी बी शूणां मेरी गल्‍ल,</para>
  <para style="q" vid="PRO 1:23">हुंह आसा लागी दी तम्हां नैरदी,</para>
  <para style="q" vid="PRO 1:23">हुंह खोज़ूं तम्हां का असली ज्ञैन,</para>
  <para style="q" vid="PRO 1:23">मंऐं निं लाऐ तम्हैं कबाता पाई।<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />हुंह थिई लागी दी तम्हां लै हाक्‍का लांदी,</para>
  <para style="q" vid="PRO 1:24">बाहा फुआरी ओर्ही शाददी, पर तम्हैं नां शूणअ नां धैन दैनअ।<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />तम्हैं पाऐ मेरै बैण ई बृथा,</para>
  <para style="q" vid="PRO 1:25">मेरी नैरी-समझ़ाऊई बी निं तम्हैं धैन दैनअ।<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />ऐबै ज़ै तम्हां लै आफ़त एछे,</para>
  <para style="q" vid="PRO 1:26">तेभै करनअ मुंह बी थारअ सुहांग।<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />तम्हां लै एछणी ढिश-बागरी ज़ेही डअर,</para>
  <para style="q" vid="PRO 1:27">आफ़त एछणी तम्हां लै कुरलू बागरी ज़ेही</para>
  <para style="q" vid="PRO 1:27">अर तम्हां एछणी गल़ै तैणीं घाटी,</para>
  <para style="q" vid="PRO 1:27">तेभै करनअ मुंह थारअ सुहांग।<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />तेभै लाणीं तम्हां मुल्है हाक्‍का कि</para>
  <para style="q" vid="PRO 1:28">हुंह थारी मज़त करे,</para>
  <para style="q" vid="PRO 1:28">पर हुंह निं तेभै तम्हां लै किछ़ै करी सकदी</para>
  <para style="q" vid="PRO 1:28">तम्हैं हणैं तेभै सारै दी मुंह लोल़ै लागै दै</para>
  <para style="q" vid="PRO 1:28">पर हुंह निं तम्हां भेटणीं।<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />किल्हैकि तम्हैं डाही अक्ली संघै ज़ीद,</para>
  <para style="q" vid="PRO 1:29">अर बिधातो अदर करनअ समझ़अ तम्हैं बृथा।<verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />तम्हैं निं मेरी सलाह मनी</para>
  <para style="q" vid="PRO 1:30">अर ज़ेभै मंऐं तम्हैं नैरै, तेभै निं तम्हैं धैन दैनअ।<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />तेभै लागणअ तम्हां आपणैं कर्मो फल भुगतणअ</para>
  <para style="q" vid="PRO 1:31">अर ज़ुंण तम्हैं किअ, तेता करै हणीं तम्हां आप्पू ई फाही।<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />नज्ञैनै मणछ मरनै कबाता पेशी,</para>
  <para style="q" vid="PRO 1:32">किल्हैकि तिन्‍नैं समझ़ी अक्ल बृथा।</para>
  <para style="q" vid="PRO 1:32">ऐडै मणछ बी हणैं बरैबाद</para>
  <para style="q" vid="PRO 1:32">किल्हैकि तिंयां रहै निहंचै बेशी।<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />पर ज़ुंण मेरी गल्‍ला शुणें तिंयां रहणैं राज्ज़ी-राम्बल़ै निहंचै।</para>
  <para style="q" vid="PRO 1:33">तिन्‍नां निं आफ़ता का डरने ज़रुरत आथी।”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">अक्लीओ फल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />लान्हैंओ, ज़ुंण हुंह बोला तेता डाहा आद</para>
  <para style="q" vid="PRO 2:1">अर मेरै बैण डाहा आपणैं दिलै च़की।<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />ऐहा गल्‍ला शिखल़ा कि अक्ल किज़ै आसा</para>
  <para style="q" vid="PRO 2:2">अर एता दैआ समझ़णीं।<verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />बिधाता सेटा करा अरज़ कि सह</para>
  <para style="q" vid="PRO 2:3">सोर-समझ़ दैए।<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />तेता लोल़णा लै करा एही मैन्थ,</para>
  <para style="q" vid="PRO 2:4">ज़िहअ कि तम्हैं आसा होए सुन्‍नैं-च़ंदी</para>
  <para style="q" vid="PRO 2:4">या गुप्त खज़ानै लोल़ै लागै दै।<verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />ज़ै तम्हैं इहअ करे तै लागणअ</para>
  <para style="q" vid="PRO 2:5">तम्हां बिधाते बारै</para>
  <para style="q" vid="PRO 2:5">अर तेऊओ अदर करने बारै थोघ।<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />किल्हैकि अक्ल दैआ सह बिधाता ई,</para>
  <para style="q" vid="PRO 2:6">अर समझ़-बुध बी दैआ सह ई।<verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />ज़ुंण मणछ मानदार अर धर्मीं आसा,</para>
  <para style="q" vid="PRO 2:7">सह करा तिन्‍नें मज़त अर फाज़त।<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />सह बिधाता फिरा तिन्‍नां बाखा ज़ुंण शुची पांच़ी करा,</para>
  <para style="q" vid="PRO 2:8">अर आपणैं भगते करा सह हेर-सभाल़।<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />अक्ली करै लागणअ तम्हां का थोघ कि</para>
  <para style="q" vid="PRO 2:9">धर्म, भलाई अर मानदारी किज़ै आसा।<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />किल्हैकि अक्ल करा थारै मन्‍नां बशै,</para>
  <para style="q" vid="PRO 2:10">अर तेखअ हणैं ज्ञैन पाई खास्सै खुश।<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />सुंबल़ी सोर-समझ़ा करनी</para>
  <para style="q" vid="PRO 2:11">थारी फाज़त।<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />ताकि तम्हैं कबध खटणै का दूर रहे,</para>
  <para style="q" vid="PRO 2:12">अर शल़ैघा घल़णै आल़ै अर उंबल़ी गल्‍ला करनै आल़ै</para>
  <para style="q" vid="PRO 2:12">मणछा का बच़ी रहे।<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />ज़ुंण मणछ धर्मीं ज़िन्दगी छ़ाडी</para>
  <para style="q" vid="PRO 2:13">पापे न्हैरै दी ज़िऊआ,<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />ज़ुंण कबध करना लै झ़ूरा</para>
  <para style="q" vid="PRO 2:14">अर ज़ुंण कबल्‍लअ कदुष्ट उंबल़ी गल्‍ला लै झ़ूरा,<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />ज़सरै च़ाल-च़लण ठीक निं आथी</para>
  <para style="q" vid="PRO 2:15">अर ज़सरअ भरोस्सअ निं करी सकदै।<verse eid="PRO 2:15" /></para>
  <para style="s">अक्ल अर कंज़रैई का दूर</para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />सोर अर अक्ली करै बच़णैं तम्हैं पराई बेटल़ी का</para>
  <para style="q" vid="PRO 2:16">ज़ुंण लोभणैं आल़ी गल्‍ला करा अर<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />ज़ुंण आपणैं मर्धा लै धोखअ दैआ,</para>
  <para style="q" vid="PRO 2:17">सह चोल़ा बैहे तैहा करारा ज़ुंण</para>
  <para style="q" vid="PRO 2:17">तैहा परमेशर सोह खाई बैहे धैल़ी किई ती।<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />एही बेटल़ीए घअरा बाखा डेऊणअ हआ मौते बाता डेऊणैं ज़िहअ,</para>
  <para style="q" vid="PRO 2:18">अर तिधी पुजणअ हआ मूंऐं दै मणछे न्हैरै संसार जम्परी डेऊणअ।<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />एही बेटल़ी सेटा डेऊई निं आझ़ तैणीं कोहै बापस फिरअ,</para>
  <para style="q" vid="PRO 2:19">अर नां सह मणछ ज़िन्दगीए बाता बापस फिरअ।<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />तम्हैं ज़िऊऐ धर्मीं ज़िन्दगी,</para>
  <para style="q" vid="PRO 2:20">अर तैहा बाता बी निं छ़ाडी ज़ेथ धर्मीं मणछ हांढा।<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />किल्हैकि धर्मीं अर नर्दोश मणछ ई रहणैं</para>
  <para style="q" vid="PRO 2:21">आपणैं देशै बस्सी।<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />पर कदुष्ट अर धोखै दैणैं आल़ै मणछ करनै,</para>
  <para style="q" vid="PRO 2:22">तेऊ देशा का बिधाता दूर।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">खारकै मणछा लै सलाह</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />लान्हैंओ, मेरी शिक्षा निं बिस्सरी,</para>
  <para style="q" vid="PRO 3:1">ज़िहअ हुंह तम्हां लै बोला तेता डाहै आद,<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />तेता करै हणीं थारी अमर खास्सी,</para>
  <para style="q" vid="PRO 3:2">अर सुखी ज़िन्दगी।<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />तम्हैं लोल़ी सदा झणैल़ू अर शुचै-पाक्‍कै रहै,</para>
  <para style="q" vid="PRO 3:3">तेता डाहै आप्पू का गल़े कंठी ज़ेही,</para>
  <para style="q" vid="PRO 3:3">अर तेता डाहै आपणैं दिलै लिखी।<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />ज़ै तम्हैं इहअ ई करे,</para>
  <para style="q" vid="PRO 3:4">तै हणअ बिधाता बी खुश अर होर मणछ बी हणैं खुश।<verse eid="PRO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5" />तम्हैं डाहै दिला का बिधाता दी भरोस्सअ,</para>
  <para style="q" vid="PRO 3:5">आपणीं समझ़े भरोस्सै निं रही।<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />हर गल्‍ला लै लणअ बिधाता पुछ़ी,</para>
  <para style="q" vid="PRO 3:6">तै हेरनी तेऊ तम्हां का आज़री बात खोज़ी।<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />आप्पू लै निं तम्हैं इहअ समझ़ी कि तम्हैं आसा खास्सै अक्ली आल़ै,</para>
  <para style="q" vid="PRO 3:7">तम्हैं रहै सिधै बिधाते डरा हेठै अर बूरअ करनै का रहै दूर।<verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />ज़ै तम्हैं इहअ करे, सह हणअ तम्हां लै मल्हमा ज़िहअ</para>
  <para style="q" vid="PRO 3:8">तेता करै रहणीं थारी देही अर हाड-मास्स नरोगै।<verse eid="PRO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />आपणीं ज़ैदात अर साल-फसला का,</para>
  <para style="q" vid="PRO 3:9">बिधाता लै पैहलअ अर च़ोखअ निसब दैई करै तेऊओ अदर,<verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />ज़ै तम्हैं इहअ करे, तै रहणैं थारै नाज़े भढार भरी</para>
  <para style="q" vid="PRO 3:10">अर कोफरी दाखो रस बी हणअ बतेर्हअ।<verse eid="PRO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />लान्हैंओ, ज़ेभै बिधाता तम्हां नैरदअ लागे, तिन्‍नां गल्‍ला दी दैऐ धैन</para>
  <para style="q" vid="PRO 3:11">अर तेता समझ़ै आप्पू लै चतैनगी,<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />किल्हैकि बिधाता ज़हा लै झ़ूरा, तेऊ दैआ सह नैरनीं बी</para>
  <para style="q" vid="PRO 3:12">ज़िहअ एक बाब आपणैं शोहरू लै झ़ूरा अर नैरा-समझ़ाऊआ।<verse eid="PRO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />बिधाता दैआ तिन्‍नां मणछा लै बर्गत ज़हा का अक्ल आसा,</para>
  <para style="q" vid="PRO 3:13">अर ज़हा समझ़ एछा।<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />अक्ल आसा च़ंदी का खास्सी किम्मती,</para>
  <para style="q" vid="PRO 3:14">अर तेता करै हआ तम्हैं सुन्‍नैं का बी खास्सै सेठ।<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />अक्ल आसा नमोल हार-शंगारा का बी किम्मती</para>
  <para style="q" vid="PRO 3:15">संसारै ज़ुंण तम्हैं च़ाहा, एता का खास्सी निं किछ़ै च़ीज़ आथी।<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />अक्ल दैआ तम्हां लै लाम्मी अमर,</para>
  <para style="q" vid="PRO 3:16">ज़ैदात अर अदर।<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />अक्ली करै निभा ज़िन्दगी सुखी</para>
  <para style="q" vid="PRO 3:17">अर राज्ज़ी-मौज़ी।<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />ज़हा अक्ल एछा, तिंयां रहा खुश</para>
  <para style="q" vid="PRO 3:18">अर अक्ली करै भेटा तिन्‍नां ज़िन्दगी।<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />बिधाता बी बणाईं धरती अक्ली करै,</para>
  <para style="q" vid="PRO 3:19">आपणीं महान समझ़ा करै बणाअं तेऊ भ्रमंड।<verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />बिधाता का थिअ ज्ञैन,</para>
  <para style="q" vid="PRO 3:20">तेता करै बगी गाडा नाल़ी अर सरगा का हुअ पाणीं।<verse eid="PRO 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />लान्हैंओ, आप्पू का डाहा अक्लीए सोर,</para>
  <para style="q" vid="PRO 3:21">तेता निं आप्पू का दूर करी।<verse eid="PRO 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22" />तेता करै भेटणीं तम्हां सदा लै ज़िन्दगी</para>
  <para style="q" vid="PRO 3:22">ज़ुंण गल़े सुन्‍नें हारा ज़ेही शोभा।<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />तै रहणैं तम्हैं बाता निहंचै हांढदै लागी,</para>
  <para style="q" vid="PRO 3:23">अर नां किधी तम्हां ठोहल़ लागणीं।<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />सुत्ती निं तम्हां किछ़ै डअर हणीं</para>
  <para style="q" vid="PRO 3:24">अर नींज बी एछणी तम्हां बधिया।<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />तम्हां निं नच़ानक एछणैं आल़ी आफ़ता का डरने ज़रुरत आथी,</para>
  <para style="q" vid="PRO 3:25">ज़ेही कदुष्ट मणछा लै ढिश-बागरी ज़ेही आफ़त पल़ा।<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />किल्हैकि बिधाता करनी थारी मज़त आप्पै,</para>
  <para style="q" vid="PRO 3:26">सह निं तम्हां आफ़ता दी पल़णै दैंदअ।<verse eid="PRO 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />ज़ेतरी तेरी समरता आसा,</para>
  <para style="q" vid="PRO 3:27">तेऊ साबै लऐ होरीए मज़त करी ज़हा ज़रुरत आसा।<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />आस्ती च़िज़ा निं आपणैं साथी-संघी लै नांह करी कि</para>
  <para style="q" vid="PRO 3:28">आझ़ निं आथी हुंह दैंऊं ताल्है काल्‍ला!<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />नां आपणैं साथी-संघी लै बूरअ करनैओ सोठी</para>
  <para style="q" vid="PRO 3:29">किल्हैकि तिंयां रहा तेरै आसरै निहंचै।<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />थोघै बाझ़ी कहा मणछा संघै झ़गल़अ कोती</para>
  <para style="q" vid="PRO 3:30">निं दाऊअ-दालत करी।<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />उपद्रभ करनै आल़ै मणछा भाल़ी निं मिश करी</para>
  <para style="q" vid="PRO 3:31">नां आप्पू तिन्‍नां ज़िहै काम करी।<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />किल्हैकि इहै कदुष्ट मणछा का करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 3:32">पर धर्मीं मणछा का खोज़ा सह गुप्त भेद।<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />कदुष्ट मणछे घअरै छ़ाडा बिधाता फिटक,</para>
  <para style="q" vid="PRO 3:33">पर धर्मीं मणछे घअरै दैआ सह बर्गत।<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />सुहांगा करनै आल़ै मणछो करा बिधाता बी सुहांग,</para>
  <para style="q" vid="PRO 3:34">पर भोल़ै मणछा लै करा सह झींण।<verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />अक्ली आल़ै मणछे हआ हर ज़ैगा बड़ैई,</para>
  <para style="q" vid="PRO 3:35">पर ऐडै मणछे हआ सारै दी नाक-नकटी।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">अक्लीओ नफअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />लान्हैंओ, ज़िहअ हुंह बोला तिहअ शूणां</para>
  <para style="q" vid="PRO 4:1">धैन दैआ, तै एछणी तम्हां समझ़।<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />मेरी शिक्षा करै हणीं तम्हां उझै</para>
  <para style="q" vid="PRO 4:2">एता डाहै तम्हैं आद।<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />हुंह बी थिई एकी धैल़ै होछ़ी लान्हीं,</para>
  <para style="q" vid="PRO 4:3">आपणैं ईजा-बाबे कल्ही शोहरी।<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />मेरअ बाब दैआ त मुल्है एही शिक्षा,</para>
  <para style="q" vid="PRO 4:4">“ज़िहअ हुंह खोज़ा तेता डाहै आद, बिस्सरुई निं आथी।</para>
  <para style="q" vid="PRO 4:4">तूह करै तिहअ ई ज़िहअ हुंह बोला, तै रहणअ तूह ज़िऊंदअ।<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />अक्ल अर सुंबल़ी सोर डाह!</para>
  <para style="q" vid="PRO 4:5">ज़ुंण हुंह बोला तेता डाहै आद, बिस्सरी निं आथी।<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />नसकलअ निं हई,</para>
  <para style="q" vid="PRO 4:6">अक्ली लै झ़ूर तेता करै हणीं तेरी फाज़त।<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />सोभी का बडी आसा अक्ल,</para>
  <para style="q" vid="PRO 4:7">तैही दैणअ अक्ल पाणा लै ज़ोर,</para>
  <para style="q" vid="PRO 4:7">होरी सोभी गल्‍ला भेटणैं का खास आसा समझ़ भेटणीं।<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />अक्ली लै झ़ूर तेता करै हणीं ताह उझै।</para>
  <para style="q" vid="PRO 4:8">अक्ली दी रह मल़्हैछुई तेता करै हणअ तेरअ अदर।<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />अक्ल हणीं ताल्है तेरै मुंडै इज़तीए साफै ज़ेही।”<verse eid="PRO 4:9" /></para>
  <para style="s">सुंबल़ी अर उंबल़ी बात</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />मेरै, लान्हैंआ ज़ै तूह मेरी गल्‍ला शुणें या मने</para>
  <para style="q" vid="PRO 4:10">तै हणीं तेरी अमर खास्सी।<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />मंऐं खोज़ी ताखा अक्ल</para>
  <para style="q" vid="PRO 4:11">अर ज़िन्दगी ज़िऊंणां लै सुंबल़ी बात।<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />ज़ै तूह अक्ल डाहे, तै निं ताह किछ़ै रोक्‍की सकदअ</para>
  <para style="q" vid="PRO 4:12">तेखअ च़ाऐ तूह ठुहर बी दैए तैबी निं ताह ठोहल़ लागणीं।<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />मेरी शिक्षा डाहै सदा आद,</para>
  <para style="q" vid="PRO 4:13">किल्हैकि अह ई आसा तेरी ज़िन्दगी, एते करै फाज़त।<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />ज़ेथ बाखा कदुष्ट मणछ डेओआ, तेथ निं डेऊई</para>
  <para style="q" vid="PRO 4:14">नां तिन्‍नां ज़िहै काम करी।<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />इहै मणछा नेल़ बी निं लागी डेऊंदअ,</para>
  <para style="q" vid="PRO 4:15">तिन्‍नां छ़ाडी लागै आपणीं बाता हांढदअ।<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />किल्हैकि ज़ेभै तैणीं किज़ै उपद्रभ निं किअ तेभै तैणीं निं कदुष्ट मणछ सुत्तदअ,</para>
  <para style="q" vid="PRO 4:16">अर ज़ांऊं तैणीं तिन्‍नैं कहा लै ठोहल़ निं बाही तेभै तैणीं निं तिन्‍नां नींज पल़दी।<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />कदुष्ट काम अर उपद्रभ करनअ आसा तिन्‍नां लै,</para>
  <para style="q" vid="PRO 4:17">रोटी खाणैं अर दाखो रस झुटणैं ज़िहअ।<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />पर धर्मीं मणछो च़ाल-च़लण आसा दोत्तकै धुप्पै ज़िहअ,</para>
  <para style="q" vid="PRO 4:18">ज़ेतो च़लकार दपहरै तैणीं उझै ई रहा बढदअ लागी।<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />कदुष्ट मणछे बात आसा उआंसे राची ज़ेही न्हैरी।</para>
  <para style="q" vid="PRO 4:19">तिन्‍नां लागा ठोहल़ पर इहअ निं तिन्‍नां का शुझदअ कि अह किज़ू करै लागी।<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />मेरै लान्हैंआ, ज़िहअ हुंह बोला तेता शुण धैना संघै</para>
  <para style="q" vid="PRO 4:20">मेरै बैण शुण कि हुंह किज़ै बोला।<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />मेरअ निं एक बैण बी बिस्सरी,</para>
  <para style="q" vid="PRO 4:21">इना डाहै आद अर इना डाहै आपणैं दिलै हाल़्है च़की।<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />किल्हैकि ज़ुंण इना गल्‍ला समझ़े,</para>
  <para style="q" vid="PRO 4:22">तेऊए हणीं एता करै देही नरोगी अर लाम्मी ज़िन्दगी।<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />सोभी का खास्सी करनी आपणैं मन्‍नें फाज़त कि तम्हैं किज़ै सोठा,</para>
  <para style="q" vid="PRO 4:23">किल्हैकि मणछे ज़िन्दगी ढल़ा तेऊ साबै ज़ेही सह सोठा।<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />एही निं गल्‍ल ई करनी ज़ुंण शुची निं आथी,</para>
  <para style="q" vid="PRO 4:24">नां एही उंबल़ी अर होरी कबाता पाणै आल़ी गल्‍ला करनी।<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />तंऐं रहणअ आजू आज़रै भाल़ै लागी कि तूह किधा लै च़ाल्‍लअ।<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />ज़ुंण काम करनअ, सह लणअ पैहलै जोखी,</para>
  <para style="q" vid="PRO 4:26">ताकि ज़ुंण तूह करे तेथ सफल होए।<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />बूराई छ़ाडी रहै आज़री बाता हांढदअ लागी</para>
  <para style="q" vid="PRO 4:27">तेता का दैहणै-बाऊंऐं हाथै हांढी गलती निं करी।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">कंज़रैई करने आफ़त</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />मेरै लान्हैंओ, मेरी अक्लीए गल्‍ला दी दैआ धैन</para>
  <para style="q" vid="PRO 5:1">अर ज़ुंण हुंह समझ़ दैआ तेता शूणां कान लाई।<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />एता करै एछणी तम्हां सुंबल़ी सोर</para>
  <para style="q" vid="PRO 5:2">अर थारी गल्‍ला का जाणअ तेखअ ज़ाण्हुंई कि तम्हां का आसा ज्ञैन।<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />किल्हैकि हई सका कि बगैनी बेटल़ी होए च़ाऐ मखीरा ज़ेही मिठी,</para>
  <para style="q" vid="PRO 5:3">अर तेसे माख्खू होए च़ाऐ घिऊ ज़िहै,<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />पर तेतो नतिज़अ आसा इहअ कि सह निं तम्हां लै</para>
  <para style="q" vid="PRO 5:4">नागदौणा ज़ेही कल़बिश अर दाह का सुआई किछ़ै छ़ाडदी।<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />सह पजैल़ा तम्हां सुरगै,</para>
  <para style="q" vid="PRO 5:5">ज़ैहा बाता सह बेटल़ी हांढा, सह आसा मौता बाखे बात।<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />एही बेटल़ी निं तैहा बाता हांढदी ज़ेथ ज़िन्दगी आसा,</para>
  <para style="q" vid="PRO 5:6">सह आसा च़ंदरी अर तैहा का निं आप्पू ई का थोघ हंदअ कि तैहा लै किज़ै आसा हंदअ लागअ द।<verse eid="PRO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />लान्हैंओ, मेरी गल्‍ला शूणां,</para>
  <para style="q" vid="PRO 5:7">मेरी इना गल्‍ला निं तम्हैं कधि बिस्सरी आथी।<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />एही बेटल़ी का रहै तम्हैं दूर ई!</para>
  <para style="q" vid="PRO 5:8">तम्हैं निं तेसे दुआरे डेहल़ा नेल़ बी डेऊई!<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />इहअ करै हणअ थारअ आपणअ ज़ुआनीओ अदर खतम</para>
  <para style="q" vid="PRO 5:9">अर आपणीं बाकी ज़िन्दगी बी करनी तम्हां इहअ करै नर्दैई लोगे बशै।<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />तेखअ पाणीं थारी ज़ैदात बी बगैनै,</para>
  <para style="q" vid="PRO 5:10">अर ज़ेथ तम्हैं मैन्थ हणीं किई दी सह च़ीज़ हणीं होरीए।<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />ज़ांऊं खिरी तम्हां ज़ोर-ज़ाहण निं रहणैं,</para>
  <para style="q" vid="PRO 5:11">तेभै बोल़णअ तम्हां दाह धका दी मुंडै हाथ लाई इहअ,<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />“मंऐं सैणें शिक्षा किल्है निं बोल़ी आद डाही?</para>
  <para style="q" vid="PRO 5:12">ज़ुंण मुंह नैरा-समझ़ाऊआ तै, मंऐं तिन्‍नें किल्है निं शूणीं।<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />मेरै गूरूए शिक्षा दी निं मंऐं धैन दैनअ,</para>
  <para style="q" vid="PRO 5:13">मुंह हुअ त तेथ आपणअ मन्‍न लाणअ।<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />ऐबै च़ाल्‍लअ हुंह पठी बरैबाद हई,</para>
  <para style="q" vid="PRO 5:14">ऐबै निं हुंह सभा दी लोगा का मुंह रहैऊंणै जोगी रहअ।”<verse eid="PRO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />तम्हैं झुटै सिधअ आपणैं ई कुहै का पाणीं!</para>
  <para style="q" vid="PRO 5:15">मतलब सिधअ आपणीं ई बेटल़ी लै झ़ूरै।<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />तम्हैं निं एही सोबल़ा ज़िहै लोल़ी हुऐ ज़ेता का कज़ोहै बेटल़ी झुटा,</para>
  <para style="q" vid="PRO 5:16">तिन्‍नां संघै बस्सी हुई दी लुआदा करै हणअ थारअ ई घाटअ!<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />आपणीं सोबल़ो पाणीं डाहा तम्हैं आप्पू लै आपणीं बेटल़ीए तैणीं,</para>
  <para style="q" vid="PRO 5:17">अह निं होरी बेटल़ी लै बांडणां लै आथी।<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />खारकी अमरा लोल़ी तेरी लाल़ी ताल्है भरी कुहै ज़ेही बर्गत हुई,</para>
  <para style="q" vid="PRO 5:18">तूह रहै तैहा ई संघै खुश अर मगन।<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />सह लोल़ी ताल्है हरनी ज़ेही लोभणैं आल़ी हुई,</para>
  <para style="q" vid="PRO 5:19">तेसे हिक्‍का भाल़ी लोल़ी तेरअ शाह हरअ फिरअ</para>
  <para style="q" vid="PRO 5:19">अर तम्हैं लोल़ी एकी-दुजै लै खास्सै झ़ूरै।<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />ए मेरै शोहरूआ, तूह होरीए बेटल़ी भाल़ी किल्है पल़ा ज़ाहै-मोहै?</para>
  <para style="q" vid="PRO 5:20">अर होरी बेटल़ी संघै किल्है मल़्हैछिया?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />किल्हैकि बिधाता का हआ सोभै गल्‍ला शुझदी लागी दी कि तम्हैं किज़ै करा,</para>
  <para style="q" vid="PRO 5:21">तम्हैं ज़िधी बी डेओए, सह हआ भाल़अ लागअ द।<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />कदुष्ट मणछे पाप आसा तिन्‍नां आप्पू लै फाही,</para>
  <para style="q" vid="PRO 5:22">तिंयां शाचणैं आपणैं ई पापा करै बूणै दै ज़ज़ाल़ा दी।<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />तिंयां मरनै किल्हैकि तिंयां निं आपणैं बशै आथी,</para>
  <para style="q" vid="PRO 5:23">तिन्‍नें ऐडै खैला निंणै तिंयां आप्पै मौता बाखा।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">ऐडै निं रहा</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />लान्हैंओ, ज़ै तम्हैं कहा इहै पाखलै मणछे ज़मानत लए,</para>
  <para style="q" vid="PRO 6:1">ज़ुंण आपणअ ऋण नांईं भरी सकदअ,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />तै आसा सह तम्हैं ज़बान दैनी दी</para>
  <para style="q" vid="PRO 6:2">तम्हैं शाचणैं आपणीं ई ज़िभे बैणा पिछ़ू।<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />ऐबै हुअ तम्हां होरीए ज़मानती पिछ़ू,</para>
  <para style="q" vid="PRO 6:3">ज़हा संघै करार आसा किई दी</para>
  <para style="q" vid="PRO 6:3">तेऊ मणछे च़रणैं पल़ी सह मनैऊंणअ कि</para>
  <para style="q" vid="PRO 6:3">सह ताल्है तेता का छ़ुटकारअ दैए<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />एऊ कामां लऐ तम्हैं तेभी करी,</para>
  <para style="q" vid="PRO 6:4">तेभै तैणीं नां बेशी नां सुत्ती।<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />तम्हैं लऐ एता का इहै बच़ी ज़ेही हरन अर</para>
  <para style="q" vid="PRO 6:5">च़ेल्‍लू-पखीरू शकारी का बच़ा।<verse eid="PRO 6:5" /></para>
  <para style="s">ज़ैऊंकर निं हणअ</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />आरो दल़िदरीओ, इना गल्‍ला शिखल़ा चिटा का,</para>
  <para style="q" vid="PRO 6:6">तिन्‍नों काम-काज़ भाल़ी करा अक्ल,<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />चिटो नां कुंण राज़अ हंदअ</para>
  <para style="q" vid="PRO 6:7">अर नां तिन्‍नां का कामां कराऊंदअ मेट हंदअ!<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />तैबी झाल़ा तिंयां ज़ेठै-शाहल़े गरमीं दी आप्पू लै ज़िणस</para>
  <para style="q" vid="PRO 6:8">ताकि हिंऊंदै तिन्‍नां का खाणां लै होए।<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />दल़िदरीओ, तम्हां केभै तैणीं रहणअ लाम्मै पल़ी?</para>
  <para style="q" vid="PRO 6:9">तम्हां केभै तैणीं रहणअ निंजा सुत्ती?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />दल़िदरी सोठा इहअ, “थोल़ी घल़ी लऊं होर सुत्ती,</para>
  <para style="q" vid="PRO 6:10">अज़ी लणअ हिक्‍का प्रैंदै हाथ दोछ़ी सुत्ती!</para>
  <para style="q" vid="PRO 6:10">एक सताअ लणअ निंजो होर दैई!”<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />सुत्ती रहणैंओ थोघ लागणअ तेऊ का तेभै</para>
  <para style="q" vid="PRO 6:11">ज़ांऊं गरीबी तेऊ पिछ़ू छ़ूरी पाई च़ोरा ज़ेही पल़णीं।<verse eid="PRO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />कबध खटणै आल़ै कदुष्ट मणछ</para>
  <para style="q" vid="PRO 6:12">रिंगा फेरा-फेर उंबल़ी गल्‍ला करदै,<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />तिंयां करा सानै-कानै गल्‍ला</para>
  <para style="q" vid="PRO 6:13">ताकि तिंयां होरी लै धोखअ दैए।<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />तिंयां सोठा आपणैं दिलै हर बगत उंबल़ी गल्‍ला,</para>
  <para style="q" vid="PRO 6:14">अर कबल्‍लै करा उपद्रभ खल़ै।<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />तिंयां इहै मणछा लै एछणी केभै नच़ानक आफ़त,</para>
  <para style="q" vid="PRO 6:15">कि सह हणअ हेरा-हेरी खतम अर तेऊ निं बच़णा लै बात भेटणीं।<verse eid="PRO 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />छ़ह गल्‍ला आसा एही ज़ेता का बिधाता नफरत करा,</para>
  <para style="q" vid="PRO 6:16">एही आसा ईंयां सात पै ज़ेता बिधाता नांईं मंदअ:<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />पैहलअ इहअ मणछ ज़ुंण घमंड करी दुजै लै आछी पेच़ा,</para>
  <para style="q" vid="PRO 6:17">दुजअ इहअ ज़ुंण आपणीं ज़िभा का झ़ुठअ बोला,</para>
  <para style="q" vid="PRO 6:17">चिअ ज़ुंण नर्दोश मणछे हत्या करा,<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />च़ौथअ ज़ुंण आपणैं मन्‍नैं बूरी गल्‍ला सोठा,</para>
  <para style="q" vid="PRO 6:18">पांज़ूअ ज़ुंण कबध करना लै ठुर्ही डेओआ,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />छ़हुअ सह ज़ुंण झ़ुठी शाजत दैआ,</para>
  <para style="q" vid="PRO 6:19">अर सातुअ सह मणछ ज़ुंण भ्रैहरू मांझ़ै झ़गल़अ पाआ।<verse eid="PRO 6:19" /></para>
  <para style="s">कंज़रैई का रहै दूर</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />लान्हैंओ, तम्हैं करा तिहअ</para>
  <para style="q" vid="PRO 6:20">ज़िहअ थारै ईज-बाब खोज़ा बोला,<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />तिन्‍नें शिक्षा डाहै सदा गांठ दैणैं ज़ेही आद</para>
  <para style="q" vid="PRO 6:21">अर गल़े हारा ज़ेही आप्पू का सदा।<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />तिन्‍नें गल्‍ला करै शुझणीं ताखा आजू बात,</para>
  <para style="q" vid="PRO 6:22">सुत्तदा हणीं तेता करै तेरी फाज़त</para>
  <para style="q" vid="PRO 6:22">अर ज़ागदा करनी तिन्‍नां शिक्षा ताह संघै गल्‍ला।<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />किल्हैकि तिन्‍नें शिक्षा आसा लाटूए प्रैश्शै ज़ेही,</para>
  <para style="q" vid="PRO 6:23">तिन्‍नों नैरनै-समझ़ाऊंणैं करै लागा ज़िन्दगी ज़िऊंणेंओ थोघ,<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />ताकि तम्हैं कंज़री बेटल़ी का दूर रहे</para>
  <para style="q" vid="PRO 6:24">अर पराई बेटल़ीए लोभणैं आल़ी गल्‍ला दी नां शाचे।<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />हेरनी-शुणनी भाल़ी निं तम्हैं तैहा लै लोभणूंई,</para>
  <para style="q" vid="PRO 6:25">तैहा निं लोल़ी तम्हैं आपणीं आछी करै मोहै,<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />किल्हैकि कंज़री बेटल़ी सका एकी रोटी पिछ़ू बी थारी हई</para>
  <para style="q" vid="PRO 6:26">पर कंज़रैई करै सका तम्हैं पठी बरैबाद हई।<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />इहअ निं हई ई सकदअ कि</para>
  <para style="q" vid="PRO 6:27">कुंण आपणीं हिक्‍का प्रैंदै ज़ल़दै कोयलै डाहे अर तेऊए झिकल़ै नां दझ़े!<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />इहअ बी निं हई सकदअ कि</para>
  <para style="q" vid="PRO 6:28">ज़ल़दी ल़्हूली दी हांढी कसरै खूर निं दझ़े!<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />ज़ुंण पराई बेटल़ी सेटा डेओआ तेऊए हआ एही ई दशा,</para>
  <para style="q" vid="PRO 6:29">होर ता होर ज़ुंण तैहा छ़ूंए बी, सह बी निं सज़ा का बच़ी सकदअ।<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />ज़ुंण आपणैं पेटे भुख बशैल़णा लै च़ोरी करा</para>
  <para style="q" vid="PRO 6:30">एही निं लोग तेऊ लै किछ़ बी बोल्दै,<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />पर तज़ी बी ज़ै तेऊ च़ोरो थोघ लागे, तेऊ लागणअ सात गुणा हुआह भरनअ</para>
  <para style="q" vid="PRO 6:31">अर सह हणअ सोभी गल्‍ला का रित्तअ।<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />पर ज़ुंण पराई बेटल़ी संघै रहा-बस्सा सह आसा ऐडअ ई,</para>
  <para style="q" vid="PRO 6:32">सह करा आप्पू आप्पै बरैबाद।<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />तेऊ मार बी पल़णीं अर बेइज़ती बी हणीं</para>
  <para style="q" vid="PRO 6:33">अर सह कल़ंक बी रहणअ तेऊ सारी अमरा।<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />किल्हैकि ज़ीद-मिश अर रोश्शै हआ मणछ कांणअ,</para>
  <para style="q" vid="PRO 6:34">तेखअ निं तैहा बेटल़ीए मर्धै तेऊ मणछा लै झींण लाई करी।<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />एता पिछ़ू निं तेऊ किछ़ै डांड या हुआह ढाकी लाअ,</para>
  <para style="q" vid="PRO 6:35">सह मणछ तेऊ लै सारी ज़ैदात बी दैए, तैबी निं सह मंदअ।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">विश्वास घाती आसा ऐडअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />मेरै लान्हैंओ, ज़िहअ हुंह बोला, तेता शूणां राम्बल़ै करै</para>
  <para style="q" vid="PRO 7:1">ज़िहअ हुंह बोला, तेता निं कधि बिस्सरी।<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />ज़िहअ हुंह बोला, तम्हैं करै तिहअ ई, तेता करै ज़िऊंणै तम्हैं</para>
  <para style="q" vid="PRO 7:2">अर मेरी शिक्षा डाहै आप्पू का एही, ज़ेही तम्हैं आपणीं आछिए फाज़त करा।<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />मेरी शिक्षा डाहै आप्पू का गुंठी बान्हीं दी मुंदल़ी ज़ेही,</para>
  <para style="q" vid="PRO 7:3">अर तेता डाहै आपणैं दिलै सदा डाही।<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />अक्ली डाहा तम्हैं आप्पू संघै धर्म बैहणी ज़ेही</para>
  <para style="q" vid="PRO 7:4">अर सुंबल़ी सोर लोल़ी थारी पाक्‍की साथण हुई।<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />तिन्‍नां निं तम्हैं बगैनी बेटल़ीए ज़ज़ाल़ा दी शाचणैं दैणअ</para>
  <para style="q" vid="PRO 7:5">ज़ुंण च़ंदरी तम्हां लै मिठी-मिठी गल्‍ला करा।<verse eid="PRO 7:5" /></para>
  <para style="s">च़ंदरी बेटल़ी</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />एकी धैल़ै त हुंह आपणैं घअरै</para>
  <para style="q" vid="PRO 7:6">तीरू बाती बागा बाखा भाल़अ लागअ द।<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />मुखा शुझुऐ तेथ बागै कई ऐणैं मणछ,</para>
  <para style="q" vid="PRO 7:7">पर तिन्‍नां जैंदरी त एक खारकअ मणछ बेघै ऐडअ।<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />सह मणछ त तेऊ घअरे कणोडै बाती तैहा बाता हांढदअ लागअ द,</para>
  <para style="q" vid="PRO 7:8">ज़हा घअरै एही च़ंदरी बेटल़ी रहा ती।<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />अह गल्‍ल हुई सान्हां,</para>
  <para style="q" vid="PRO 7:9">ज़ाथी गअ त न्हैरअ बी हई।<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />तेखअ निखल़ी सह बेटल़ी तेऊ सेटा तेसे घअरा बागै,</para>
  <para style="q" vid="PRO 7:10">तैहा तै झिकल़ै बी कंज़री बेटल़ी ज़िहै बान्हैं दै।<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />सह बेटल़ी आसा बी ती कंज़री ई,</para>
  <para style="q" vid="PRO 7:11">सह थिई ठुल़गर अर आपणैं घअरै निं सह टेक्‍कदी ई आथी ती।<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />केभै हआ ती सह कणोडै रही दी कहा भाल़ी,</para>
  <para style="q" vid="PRO 7:12">केभै रहा किधी च़फै बेठी अर केभै रहा बज़ारै कहा न्हैल़ी लागी।<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />तेखअ भाल़अ मंऐं कि तैहा दैनी तेऊ खारकै मणछा लै च़ुंज़ी-माख्खी अर मल़्हैची,</para>
  <para style="q" vid="PRO 7:13">संघा लागी तेऊए आछी कोहरअ भाल़ी इहअ बोल्दी,<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />“आझ़ किअ मंऐं मेल़-ज़ोल़े बल़ीदान,</para>
  <para style="q" vid="PRO 7:14">आझ़ हुई मेरी मानत पूरी।<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />तैही आई हुंह ताह सेटा लै घअरा का बागै</para>
  <para style="q" vid="PRO 7:15">हुंह ती ताह ई लोल़ी लागी दी अर ऐबै आसा तूह मुंह सेटा इधी।<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />मंऐं आसा आपणैं पलगा प्रैंदै बेल-बूटै आल़ी बाछे च़ादर छ़ैई दी,</para>
  <para style="q" vid="PRO 7:16">ज़ुंण मिसर देशा का आसा आणी दी।<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />मंऐं आसा बछ़ाऊणैं दी सैंट, अगर, दाल़चिनी</para>
  <para style="q" vid="PRO 7:17">अर खुशबूदार मसालै छ़ल़िकै दै।<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />ऐबै च़ाल्‍ल तूह मुंह संघै हाम्हां झ़ूरनअ एकी-दुजै लै सारी राची,</para>
  <para style="q" vid="PRO 7:18">हाम्हां करनी दोत्ती तैणीं मौज़।<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />किल्हैकि मेरअ मर्ध निं घअरै आथी</para>
  <para style="q" vid="PRO 7:19">सह आसा किधी दूर देशा लै डेऊअ द।<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />तेऊ आसा घअरा का ढब्बैओ भरी थैल्‍लू निंयं द,</para>
  <para style="q" vid="PRO 7:20">दूई हबतै तैणीं निं सह बापस घअरै पुजदअ।”<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />इना एही-एही लोभणैं आल़ी गल्‍ला करी किअ तैहा सह मणछ आपणैं बशै,</para>
  <para style="q" vid="PRO 7:21">अर मिठै मत्रै चैल़अ सह तैहा आपणैं ज़ज़ाल़ा दी।<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />सह ऐडअ मणछ लागअ तैहा पिछ़ू इहअ हांढदअ,</para>
  <para style="q" vid="PRO 7:22">ज़िहअ काटणै आल़ै पिछ़ू गाभू हांढा,</para>
  <para style="q" vid="PRO 7:22">अर ज़िहअ हरन खल़ाक्‍की प्रैंदै आपणअ खूर डाहा।<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />तेऊ का निं इहअ थोघै कि खिरी बिन्हणअ तेऊओ काल़ज़अ कतीरा करै।</para>
  <para style="q" vid="PRO 7:23">सह खारकअ मणछ आसा इहै च़ेल्‍लू ज़िहअ ज़ुंण च़ुनणें तैणीं झ़टपटै ज़ुआल़ै पेशा,</para>
  <para style="q" vid="PRO 7:23">तेऊ का निं इहअ थोघ लागदअ कि एथ आसा आजू मेरी मौत!<verse eid="PRO 7:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />लान्हैंओ, धैन दैई शूणां,</para>
  <para style="q" vid="PRO 7:24">कि हुंह तम्हां लै किज़ै बोला!<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />थारअ दिल निं लोल़ी एही बेटल़ी दी लागअ,</para>
  <para style="q" vid="PRO 7:25">एही बाता निं भूली करै बी डेऊई।<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />किल्हैकि एही बेटल़ी किऐ खास्सै मणछ बरैबाद</para>
  <para style="q" vid="PRO 7:26">अर केतरै लोग गऐ इना पिछ़ू ज़ानीं का खतम हई।<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />एही बेटल़ीए घअरा बाखा डेऊणअ आसा जम्पर,</para>
  <para style="q" vid="PRO 7:27">सह बात पजैल़ा तैहा ज़ैगा ज़िधी मणछ मरी करै डेओआ।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">अक्ल आसा महान</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />शूणां, अक्ल आसा शाददी लागी दी,</para>
  <para style="q" vid="PRO 8:1">समझ़ आसा हाक्‍का लांदी लागी दी।<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />अक्ल आसा धारा प्रैंदै</para>
  <para style="q" vid="PRO 8:2">अर च़फै खल़ी।<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />नगरीए प्रऊल़ी ज़ेसी सोभै नगरी भितरी एछा,</para>
  <para style="q" vid="PRO 8:3">सह आसा तिधी खल़्हुई ज़ोरै-ज़ोरै इहअ बोल्दी लागी दी,<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />“लोगो, हुंह लाआ तम्हां सोभी मणछा लै हाक्‍का,</para>
  <para style="q" vid="PRO 8:4">मेरी आसा तम्हां लै अरज़।<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />ऐणैं मणछो, सैणैं हणअ शिखल़ा,</para>
  <para style="q" vid="PRO 8:5">ऐडै मणछो, तम्हैं करा अक्ल।<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />मेरी नमोल गल्‍ला शूणां,</para>
  <para style="q" vid="PRO 8:6">मुंह खोज़णीं तम्हां का सुंबल़ी अर भली गल्‍ला।<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />किल्हैकि हुंह खोज़ा शुची गल्‍ला</para>
  <para style="q" vid="PRO 8:7">झ़ुठी गल्‍ला करनै का आसा मुंह नफरत।<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />मुंह खोज़णीं तम्हां का धर्मीं गल्‍ला,</para>
  <para style="q" vid="PRO 8:8">तेथ निं एक गल्‍ल बी उंबल़ी या कबाता पाणै आल़ी आथी।<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />समझ़कार मणछा लै आसा ईंयां गल्‍ला सान,</para>
  <para style="q" vid="PRO 8:9">ज़ुंण मणछ ज्ञैन च़ाहा, तेऊ लै आसा ईंयां आज़री।<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />तम्हां का च़ंदी होए नां होए पर मेरी शिक्षा लऐ आप्पू का डाही,</para>
  <para style="q" vid="PRO 8:10">च़ोखै सुन्‍नैं का खास्सअ आसा आप्पू का ज्ञैन डाहणअ भलअ।<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />अक्ल आसा किम्मती रत्ना का बी खास्सी किम्मती,</para>
  <para style="q" vid="PRO 8:11">अक्ली बराबर निं संसारै किछ़ै च़ीज़ आथी।<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />हुंह आसा अक्ल अर मुखा आसा सोर,</para>
  <para style="q" vid="PRO 8:12">मुखा आसा ज्ञैन अर भलै-बूरे समझ़।<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />बिधाते डरा हेठै रहणअ हआ</para>
  <para style="q" vid="PRO 8:13">बूराई संघै ज़ीद डाहणीं।</para>
  <para style="q" vid="PRO 8:13">शरेरी गल्‍ला, घमंड कदुष्ट गल्‍ला अर उंबल़ी गल्‍ला का आसा मुंह नफरत।<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />सुंबल़ी सोर अर सुंबल़ी बुध दैआ हुंह ई,</para>
  <para style="q" vid="PRO 8:14">समझ़ अर बल बी आसा मुखा ई।<verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />राज़अ बी करा मुंह अक्ली करै राज़,</para>
  <para style="q" vid="PRO 8:15">अर मुंह ई करै बणाआं तिंयां धर्मीं बधान।<verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />सोभी बज़ीरा, कार-करिंदै अर</para>
  <para style="q" vid="PRO 8:16">पृथूईए सोभी पांच़ा लै करा हुंह ई नसाफ करना लै मज़त।<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />ज़ुंण मुंह अक्ली बाखा झ़ूरा, तिन्‍नां लै झ़ूरा हुंह बी,</para>
  <para style="q" vid="PRO 8:17">ज़ुंण मानदारी संघै मुंह लोल़ा, तेऊ जाआ हुंह भेटी।<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />हुंह सका तम्हां सेठ अर मशूर,</para>
  <para style="q" vid="PRO 8:18">खास मणछ अर सफल बणाईं।<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />ज़ुंण तम्हां मुखा भेटणअ,</para>
  <para style="q" vid="PRO 8:19">सह आसा च़ोखै सुन्‍नैं-च़ंदी का बी किम्मती।<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />हुंह हांढा तैहा बाता</para>
  <para style="q" vid="PRO 8:20">ज़ेथ धर्म अर नसाफ आसा।<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />ज़ुंण मुल्है झ़ूरा तिन्‍नां लै दैआ हुंह ज़ैदात,</para>
  <para style="q" vid="PRO 8:21">तिन्‍नें घअरै भर्हिया खज़ानै।<verse eid="PRO 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />बिधाता आसा हुंह सोभी का आजी बणाईं दी,</para>
  <para style="q" vid="PRO 8:22">खास्सी साला पैहलै ज़ेतरै बी तेऊ काम किऐ तेता का आजी बणाईं हुंह।<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />ज़ात सोभी का आजी बणाईं बिधाता हुंह ई</para>
  <para style="q" vid="PRO 8:23">संसारे शुरूआत हणैं का आजी आसा हुंह ई बणाईं डाही दी।<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />ज़धू मेरअ ज़ल्म हुअ, तधू नां ईंयां सात समुंदर थिऐ,</para>
  <para style="q" vid="PRO 8:24">नां ईंयां पाणींए सोबल़ा आथी ती।<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />ज़धू मेरअ ज़ल्म हुअ,</para>
  <para style="q" vid="PRO 8:25">तधू निं ईंयां उछ़टी-उछ़टी ज़ोता बी टकैल़ी आथी ती।<verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />सोभी का आजी बणाईं बिधाता हुंह ई,</para>
  <para style="q" vid="PRO 8:26">अह धरती, संसार अर तेते हर कणीं बी बणाईं तेता बाद ई।<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />ज़धू बिधाता भ्रमंड,</para>
  <para style="q" vid="PRO 8:27">अर समुंदरा प्रैंदै सरग टकैल़अ, तधू बी थिई हुंह तिधी।<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />ज़ेभै बिधाता सरगै बादल़ टकैल़ै</para>
  <para style="q" vid="PRO 8:28">अर डुघै समुंदरा दी सोबल़ा फुटी, तधू बी थिई हुंह तिधी।<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />ज़धू बिधाता समुंदरे पाणीं लै सिअं लाई</para>
  <para style="q" vid="PRO 8:29">अर ज़धू पृथूईए आथरी दी सूत खिंच़अ, तधू बी थिई हुंह तिधी।<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />हुंह ती तधू बिधाता संघै कारीगीरा ज़ेही मज़त करदी लागी दी,</para>
  <para style="q" vid="PRO 8:30">अर हर धैल़ै हआ त बिधाता मुंह करै खुश,</para>
  <para style="q" vid="PRO 8:30">अर हुंह बी थिई बिधाता सेटा खुश।<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />हुंह ती बिधाते बसाऊऐ दै संसारा करै खुश,</para>
  <para style="q" vid="PRO 8:31">अर मणछा संघै संगत ती मेरी मौज़।<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />लान्हैंओ, ऐबै बोला हुंह तम्हां खारकै लै मेरी गल्‍ला शूणां,</para>
  <para style="q" vid="PRO 8:32">ज़िहअ हुंह बोला, तम्हैं करा तिहअ ई तै रहणैं तम्हैं खुश।<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />ज़ुंण हुंह खोज़ा, तेता शूणां,</para>
  <para style="q" vid="PRO 8:33">अक्ल करा, इना गल्‍ला निं पिठी पिछ़ू लै करी।<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />ज़ुंण मणछ मेरी गल्‍ला शूणां,</para>
  <para style="q" vid="PRO 8:34">ज़ुंण मेरै दुआरै धैल़ एछा अर मुंह न्हैल़ै रहा बेशी,</para>
  <para style="q" vid="PRO 8:34">तिंयां रहणैं सदा खुश।<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />किल्हैकि ज़हा हुंह भेटा, तेऊ भेटा ज़िन्दगी,</para>
  <para style="q" vid="PRO 8:35">अर बिधाता हआ तेऊ करै खुश।<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />पर ज़हा हुंह नांईं भेटी, सह बाहा आपणीं ज़ांघा खराल़ी,</para>
  <para style="q" vid="PRO 8:36">अर ज़ुंण मुंह संघै ज़ीद डाहा, सह झ़ूरा आपणीं मौता लै।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">ज्ञैना धैने बात</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1" />अक्ली बणाअं आपणअ घअर</para>
  <para style="q" vid="PRO 9:1">अर तेता लै लाऐ तैहा सात थाम्ह।<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />तैहा काटै घरासणी लै रिठ-बाकरै,</para>
  <para style="q" vid="PRO 9:2">दाखे रसा दी राल़ै तैहा मसालै संघा हेरी धाम बणाईं।<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />तैहा छ़ाडी आपणीं दासी लोगा लै छ़ांदै करदी,</para>
  <para style="q" vid="PRO 9:3">तिन्‍नैं लाई धारठी प्रैंदै खल़्हुई नगरीए लोगा लै हाक्‍का, तिन्‍नैं बोलअ इहअ,<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />“ज़ुंण ऐडै अर भोल़ै मणछ आसा</para>
  <para style="q" vid="PRO 9:4">तिन्‍नां लै बोला अक्ल इहअ,<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />‘तम्हां सोभी लै आसा छ़ांदअ,</para>
  <para style="q" vid="PRO 9:5">एछा, तम्हैं खाआ धामा लै शिखा अर मसालै आल़अ दाखो रस बी झुटा।<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />ज़ै तम्हैं ज़िऊंणअ च़ाहा, तै छ़ाडा ऐडी संगत पोर्ही।</para>
  <para style="q" vid="PRO 9:6">तैहा बाता हांढा ज़ेसी समझ़ बोला।’”<verse eid="PRO 9:6" /></para>
  <para style="s">असली अक्ल</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />ज़ुंण सुहांगा करनै आल़ै मणछा लै शिक्षा दैआ, तेऊ पल़ा आप्पू ई शर्मिंदै हणअ!</para>
  <para style="q" vid="PRO 9:7">ज़ुंण कदुष्ट मणछा नैरदअ लागा, तेऊ पल़ा उल़्टी टाभ शुणनी!<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />सुहांगा करनै आल़ै मणछा नैरदै निं लागी,</para>
  <para style="q" vid="PRO 9:8">तेऊ डाहणीं तम्हां लै तैहा गल्‍ले ज़ीद,</para>
  <para style="q" vid="PRO 9:8">पर ज़ै तम्हैं अक्ली आल़ै मणछा नैरे,</para>
  <para style="q" vid="PRO 9:8">तेऊ करनअ तेता लै थारअ अदर।<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />शिक्षा बी दैणीं तेऊ लै ज़हा अक्ल होए,</para>
  <para style="q" vid="PRO 9:9">तै एछणी तेऊ लै होर बी अक्ल।</para>
  <para style="q" vid="PRO 9:9">बोल़णअ हआ धर्मीं मणछा लै ठीक,</para>
  <para style="q" vid="PRO 9:9">सह बढाऊआ तेता करै आपणअ ज्ञैन।<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />बिधाते डरा हेठै रहणअ आसा अक्लीओ मूल़,</para>
  <para style="q" vid="PRO 9:10">परम पबित्र परमेशरे बारै थोघ करनअ आसा समझ़।<verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />अक्ली करै हणीं थारी लाम्मी अमर</para>
  <para style="q" vid="PRO 9:11">अर तम्हैं ज़िऊंणै खास्सी साला।<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />अक्ली करै हणअ थारअ ई नफअ,</para>
  <para style="q" vid="PRO 9:12">पर ज़ै तम्हैं अक्लीओ सुहांग करे, तेतो घाटअ बी लागणअ तम्हां ई खाणअ।<verse eid="PRO 9:12" /></para>
  <para style="s">ऐडे बात</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />ऐडअ हणअ आसा एही नसकली बेटल़ी ज़िहअ,</para>
  <para style="q" vid="PRO 9:13">ज़ुंण ज़िभा लै शाचा पार पर थोघ निं तैहा का किछ़ै हंदअ।<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />सह बेटल़ी रहा आपणैं दुआरे डेहल़ै,</para>
  <para style="q" vid="PRO 9:14">अर नगरीए उछ़टी ज़ैगा बेशी।<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />संघा रहा तेस्सी बाती एछदै हांढदै लै हाक्‍का लाई-लाई,</para>
  <para style="q" vid="PRO 9:15">इहअ बोल्दी लागी,<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />“ज़ुंण ऐडै अर भोल़ै मणछ आसा</para>
  <para style="q" vid="PRO 9:16">तिन्‍नां लै बोला अक्ल इहअ,<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />च़ोरीए पाणीं दी लागा मिठ,</para>
  <para style="q" vid="PRO 9:17">अर लुक्‍की करै रोटी खाणां लै लागा सुआद।<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />ज़ुंण एही ऐडी गल्‍ला शूणां तिन्‍नां का निं थोघ हंदअ कि एसे घअरै डेऊई आसा आजू तिन्‍नें मौत।</para>
  <para style="q" vid="PRO 9:18">ज़ुंण तेसे घअरै डेऊई बी मुक्‍कै तिंयां आसा तैहा ज़ैगा गऐ दै पुजी ज़िधी मणछ मरी करै डेओआ।”<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">सुलैमाने अक्लीए गल्‍ला</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />सुलैमानै आसा एही सैणीं गल्‍ला किई दी:</para>
  <para style="q" vid="PRO 10:1">ज़ै शोहरू अक्ली आल़ै हुऐ, तेता करै हआ ईजा-बाबा बी खुशी,</para>
  <para style="q" vid="PRO 10:1">पर ऐडी लुआद चोल़ा तिन्‍नों दिल।<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />कदुष्ट मणछै डाही दी ज़ैदाता करै निं किछ़ै नफअ हंदअ,</para>
  <para style="q" vid="PRO 10:2">पर मानदारी सका थारी ज़िन्दगीए फाज़त करी।<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />धर्मीं मणछा निं बिधाता भुखै डाहंदअ,</para>
  <para style="q" vid="PRO 10:3">पर कदुष्ट मणछे दिला-मन्‍नें निं सह सफल दैंदअ हणैं।<verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />ज़हा कामां लै ज़ैंईं लागा, सह हआ दाल़जी</para>
  <para style="q" vid="PRO 10:4">पर ज़ुंण मैन्थ करा सह हआ सेठ।<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />ज़हा अक्ल हुई, सह झाल़ा गरमींए<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fq" closed="false">गरमींए </char><char style="ft" closed="false">लऊंणींए ऋता</char></note> धैल़ै साल-फसल,</para>
  <para style="q" vid="PRO 10:5">पर ज़ुंण तेभै घणीं निंजा सुत्ती रहा, तेऊ लागा बादा का शर्मिंदै हणअ।<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />धर्मीं मणछा सराहा सोभै,</para>
  <para style="q" vid="PRO 10:6">पर कदुष्ट मणछै हआ आपणीं खाखा उपद्रभे बोल च़ोरी डाहै दै।<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />धर्मीं मणछा करा लोग मरी करै बी आद,</para>
  <para style="q" vid="PRO 10:7">पर कदुष्ट मणछा जाआ नढैऊऐ बिस्सरी।<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />ज़हा अक्ल हुई सह शूणां-मना बी,</para>
  <para style="q" vid="PRO 10:8">पर ज़िभा-ज़िभी शाचणैं आल़अ ऐडअ मणछ हआ पठी बरैबाद।<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />मानदार मणछ रहा राज्ज़ी-राम्बल़ै अर निहंचै,</para>
  <para style="q" vid="PRO 10:9">पर ज़ुंण उंबल़ी बाता डेओआ सह हआ बरैबाद।<verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />ज़ुंण शुची गल्‍ला खोज़णा लै मुंहैं निं निखल़दअ, सह करा होरी बी दुखी,</para>
  <para style="q" vid="PRO 10:10">पर ज़ुंण गल्‍ला मुंहैं दैआ बोली सह करा मेल़-ज़ोल़ करनैओ काम।<verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />धर्मीं मणछे बैण हआ ज़िन्दगीए सोबल़ा ज़िहै,</para>
  <para style="q" vid="PRO 10:11">पर कदुष्ट मणछै हआ आपणीं खाखा उपद्रभे बोल च़ोरी डाहै दै।<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />ज़ीद डाही हआ झ़गल़ै पैईदा,</para>
  <para style="q" vid="PRO 10:12">पर ज़ुंण झ़ूरी डाह सह करा होरीए ज़ुल्म बी माफ।<verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />अक्ली आल़ै मणछो जाआ गल्‍ला ई का थोघ लागी,</para>
  <para style="q" vid="PRO 10:13">पर ऐडै मणछा लै लागा पिठी कोल़ै बाही सज़ा दैणीं।<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />अक्ली आल़अ मणछ शिखल़ा ज़ेतरअ हई सका तेतरअ ज्ञैन,</para>
  <para style="q" vid="PRO 10:14">पर ज़ेभै ऐडअ मणछ गल्‍ला करा, तेभै हआ आफ़त ई खल़ी।<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />सेठो धन हआ तेऊ लै फेरा-फेर बडी उछ़टी दुआली आल़ी नगरी ज़िहअ,</para>
  <para style="q" vid="PRO 10:15">गरीबी करा दाल़जी बरैबाद।<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />धर्मीं मणछा जाआ ज़िन्दगी भेटी,</para>
  <para style="q" vid="PRO 10:16">पर कदुष्ट मणछ करा आपणअ धन पाप करना लै खतम।<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />ज़ुंण नैरी समझ़ाऊई करै समझ़ी जाआ, तिन्‍नां भेटा ज़िन्दगी,</para>
  <para style="q" vid="PRO 10:17">पर ज़ुंण नांईं समझ़दै, तिंयां पेठा कबाता।<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />ज़ुंण मन्‍नैं ज़ीद डाहा अर होठा का बोला कि हुंह आसा राम्बल़अ! इहअ मणछ आसा झ़ुठअ।</para>
  <para style="q" vid="PRO 10:18">ज़ुंण झ़ुठी गल्‍ला छिंगा सह आसा ऐडअ ई।<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />ज़िधी खास्सी गल्‍ला हआ, तिधी हआ पाप,</para>
  <para style="q" vid="PRO 10:19">ज़हा मणछा का अक्ल हआ, सह निं खास्सी गल्‍ला करदअ।<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />धर्मीं मणछो बैण हआ च़ोखी च़ंदी ज़िहअ,</para>
  <para style="q" vid="PRO 10:20">पर कदुष्ट मणछे सोठ आसा बृथा।<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />धर्मीं मणछे बैणा करै हआ कई मणछो भलअ,</para>
  <para style="q" vid="PRO 10:21">पर ऐडै मणछ बाहा आपणीं ज़ांघा आप्पै खराल़ी! किल्हैकि तिन्‍नां निं अक्ल आथी।<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />सह आसा बिधाते बर्गत ज़ुंण मणछा सेठ बणाआं,</para>
  <para style="q" vid="PRO 10:22">थारी आपणीं मैन्था करै निं तम्हैं सेठ हंदै।<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />ऐडै मणछा लागा पाप करनैओ मज़अ,</para>
  <para style="q" vid="PRO 10:23">पर समझ़कार मणछ हआ अक्ली करै खुश।<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />धर्मीं मणछा भेटा तिहअ ई, ज़िहअ सह च़ाहा,</para>
  <para style="q" vid="PRO 10:24">पर कदुष्ट मणछ ज़ेता का डरा, तेऊ लै एछा सह ई आफ़त।<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />ज़ांऊं ढिश-बागर एछा, कदुष्ट मणछ फरल़ाईआ दूर,</para>
  <para style="q" vid="PRO 10:25">पर धर्मीं मणछ रहा पाक्‍कै टेक्‍की।<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />ज़ै ज़ैऊंकर मणछा का ज़ै कुंणी काम ढेऊअ,</para>
  <para style="q" vid="PRO 10:26">तेऊ का ज़ाण्हिंआं सह मिल्‍लअ खाणैं अर आछी लै धूँ लागणै ज़िहअ।<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />बिधाते डरा हेठै रही हआ लाम्मी अमर,</para>
  <para style="q" vid="PRO 10:27">पर कदुष्ट मणछ जाआ छ़ेक्‍कै मरी।<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />धर्मीं मणछ हआ आशा डाही खुश,</para>
  <para style="q" vid="PRO 10:28">पर कदुष्ट मणछा निं आशा डाही बी किछ़ै भेटणअ।<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />धर्मीं मणछे करा बिधाता फाज़त,</para>
  <para style="q" vid="PRO 10:29">पर कदुष्ट मणछा करा सह खतम।<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />धर्मीं मणछे आसा अटल़ ज़िन्दगी,</para>
  <para style="q" vid="PRO 10:30">कदुष्ट मणछ निं धरती दी रहणैं तिंयां मरनै।<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />धर्मीं मणछ करा अक्ल डाही गल्‍ल,</para>
  <para style="q" vid="PRO 10:31">पर उंबल़ी गल्‍ला करनै आल़ेए ज़िभ पाणीं काटी।<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />धर्मीं मणछ ज़ाणा नरम गल्‍ला करी,</para>
  <para style="q" vid="PRO 10:32">पर कदुष्ट मणछे गल्‍ला हआ दुजै लै पात्थरै बाहणैं ज़ेही।<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />ज़ुंण बाट-तराकल़ा तोलणां लै ठगी करा, तेऊ लै करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 11:1">पर ज़ुंण मानदार आसा, तेऊ लै हआ खुश।<verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />ज़ुंण मणछ घमंड करा, तिन्‍नां पल़ा बादा का शर्मिंदै हणअ,</para>
  <para style="q" vid="PRO 11:2">पर अक्ली आल़अ मणछ हआ शरीफ।<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />भलै मणछा सखाऊआ मानदारी,</para>
  <para style="q" vid="PRO 11:3">पर धोखै दैणैं आल़अ हआ आपणैं ई कदुष्ट कामां करै बरैबाद।<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />ज़ेभै मौत मुंहां आजू एछा<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="fq" closed="false">मौत मुंहां आजू एछा </char><char style="ft" closed="false">ज़ेभै परमेशरा एछी जाआ</char></note>, तेभै निं ढब्बअ बी किछ़ू कामों हंदअ,</para>
  <para style="q" vid="PRO 11:4">पर मानदारी सका थारी ज़िन्दगी बी बच़ाऊई।<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />मानदारी बणाआं धर्मीं मणछा लै आज़री बात,</para>
  <para style="q" vid="PRO 11:5">पर कदुष्ट मणछ हआ आपणैं ई कदुष्ट कामां करै बरैबाद।<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />मानदार मणछा हेरा तेऊए धर्मीं ज़िन्दगी बच़ाऊई,</para>
  <para style="q" vid="PRO 11:6">पर विश्वास घाती मणछ शाचा आपणैं ई कदुष्ट कामां दी।<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />ज़ेभै कदुष्ट मणछ मरा, तेऊए आशा हआ तेऊ ई संघै खतम</para>
  <para style="q" vid="PRO 11:7">अर ज़ैदाता दी भरोस्सअ बी निं तेभै काम एछदअ।<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />धर्मीं मणछ छ़ुटा सोभी आफ़ता का,</para>
  <para style="q" vid="PRO 11:8">अर तिंयां पल़ा कदुष्ट मणछा लै।<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />कदुष्ट मणछे गल्‍ला बगाल़ा आपणीं साथ-संगत बी,</para>
  <para style="q" vid="PRO 11:9">पर धर्मीं मणछे अक्ल डाहा सोभी संघै बणाईं।<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />ज़ेभै धर्मीं मणछो भलअ हआ, तेभै हआ सारी नगरीए लोग खुश,</para>
  <para style="q" vid="PRO 11:10">ज़ेभै कदुष्ट मणछ मरा, तेभै बोला सोभै कि राम्बल़ी हुई।<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />ज़हा नगरी लै धर्मीं मणछ बर्गत दैआ, सह नगरी हआ महान,</para>
  <para style="q" vid="PRO 11:11">पर कदुष्ट मणछे गल्‍ला करै हआ बरैबाद।<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />आपणैं गरांईं बृथा समझ़णैं हआ ऐडी गल्‍ल,</para>
  <para style="q" vid="PRO 11:12">पर समझ़कार मणछ रहा च़ुप्पी।<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />घैंचल़ करनै आल़अ मणछ खोज़ा सारै भेद होरी का,</para>
  <para style="q" vid="PRO 11:13">पर शुचअ-पाक्‍कअ मणछ निं इहअ करदअ।<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />ज़हा देशै अक्ल निं हुई, तेऊ देशे परज़ा लै एछा आफ़त,</para>
  <para style="q" vid="PRO 11:14">पर ज़िधी अक्ली आल़ै सैणैं हुऐ, सह देश रहा बच़ी।<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />कहा पाखलै मणछे ज़मानत लणी हआ आप्पू लै आफ़त,</para>
  <para style="q" vid="PRO 11:15">पर ज़ुंण इना इहै ज़ाणैं नांईं लागदअ, सह रहा इना झांगटा का दूर निहंचै।<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />झणैल़ू बेटल़ीओ हआ अदर,</para>
  <para style="q" vid="PRO 11:16">पर हुश-त्रुंगी लोगा का हआ सिधै ढब्बै खास्सै।<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />झणैल़ू मणछ करा आपणअ भलअ,</para>
  <para style="q" vid="PRO 11:17">पर नर्दैई मणछ बाहा आपणीं ज़ांघा खराल़ी।<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />कदुष्ट मणछा निं असली दी किछ़ै नफअ हंदअ,</para>
  <para style="q" vid="PRO 11:18">पर ज़ै तम्हैं भलअ करे, तेतो पुआज़अ जाणअ केभै नां केभै भेटी।<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />ज़ुंण भलअ ई करनअ च़ाहा, तेऊ भेटा ज़िन्दगी,</para>
  <para style="q" vid="PRO 11:19">पर कदुष्ट कामां च़ाहणैं आल़ै भेटा मौत।<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />ज़ुंण मना का उंबल़ै आसा, तिन्‍नां लै करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 11:20">पर भलै मणछा लै करा सह झींण।<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />ऐहा गल्‍ले डाहै दसल्‍ली कि कदुष्ट मणछा भेटणीं ज़रूर सज़ा,</para>
  <para style="q" vid="PRO 11:21">पर धर्मीं मणछे रहणीं आद-लुआद राज्ज़ी-राम्बल़ी।<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />अक्ली बाझ़ी हेरनी शुणनी बेटल़ी आसा एही,</para>
  <para style="q" vid="PRO 11:22">ज़िहअ सुंगरे टोटै सुन्‍नेंओ बाल़ू।<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />पर धर्मीं मणछ च़ाहा सदा भलअ ई भलअ,</para>
  <para style="q" vid="PRO 11:23">पर कदुष्ट मणछ ज़िहअ च़ाहा, तेता लै एछा परमेशरा रोश्शै ई।<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />कई मणछ हआ दिल खोल्ही बांडी करै बी सेठ,</para>
  <para style="q" vid="PRO 11:24">पर कई पल़ा कमजुशी करी बी गरीबी।<verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />खुल्है दिले मणछ रहा बढदै लागी,</para>
  <para style="q" vid="PRO 11:25">ज़ुंण होरीए मज़त करा, तेऊ भेटा आप्पू बी मज़त।<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />ज़ुंण नाज़े भढार भरी इहअ न्हैल़अ लागा कि आजू बेच़णअ अह खास्सी किम्मती, तेऊ लै दैआ लोग फिटक,</para>
  <para style="q" vid="PRO 11:26">पर ज़ुंण नढैऊऐ बेच़ा, तेऊ लै दैआ लोग बर्गत।<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />ज़ुंण सदा भलअ च़ाहा, तेऊओ हआ अदर,</para>
  <para style="q" vid="PRO 11:27">पर ज़ुंण दुजै लै बूरअ च़ाहा, तेऊ हआ आप्पू लै बूरअ।<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />ज़ुंण आपणीं ज़ैदाता दी भरोस्सअ डाहा, सह अल़ा शुक्‍कै पाचा ज़िहअ,</para>
  <para style="q" vid="PRO 11:28">पर धर्मीं मणछ रहा नऊंईं प्लीरा ज़िहै हरै।<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />ज़ुंण आपणैं टबरा लै आफ़त पाआ तेऊ का निं खिरी किछ़ै रहंदअ,</para>
  <para style="q" vid="PRO 11:29">अर ऐडअ मणछ हआ सदा अक्ली आल़ै मणछो गलाम।<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />धर्मीं मणछ हआ ज़िन्दगी दैणैं आल़ै बूटा ज़िहअ,</para>
  <para style="q" vid="PRO 11:30">अर अक्ली आल़ै मणछा बाखा फिरा होर लोग बी।<verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />ज़ै धर्मीं मणछा ऐहा ई धरती दी फल भेटा,</para>
  <para style="q" vid="PRO 11:31">तै भेटणअ कदुष्ट अर पापी मणछा बी तिन्‍नों फल ज़रूर।<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="s">बूराई पिछ़ू निं तम्हैं लुक्‍की सकदै</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />ज़ुंण शिक्षा लै झ़ूरा, तेऊ सका नैरी समझ़ाऊई बी,</para>
  <para style="q" vid="PRO 12:1">पर ज़ुंण नैरना लै ज़ीद डाहा, सह आसा ऐडअ।<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />भलै मणछा लै झ़ूरा बिधाता बी,</para>
  <para style="q" vid="PRO 12:2">पर ज़ुंण बूरी बिक्री सोठा, तेऊ लै दैआ सह सज़ा।<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />पाप निं फाज़त करी सकदअ,</para>
  <para style="q" vid="PRO 12:3">पर धर्मीं ज़िन्दगी ज़िऊंणै आल़अ मणछ हआ इहै बूटा ज़िहअ</para>
  <para style="q" vid="PRO 12:3">ज़ेते ज़लैल़ै कुंण पेच़ी निं सकदअ।<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />भली बेटल़ी हआ आपणैं मर्धे मुंडा लै मुगटा ज़ेही,</para>
  <para style="q" vid="PRO 12:4">पर नबिज़तै काम करनै आल़ी बेटल़ी हआ एही बमारी ज़ेही ज़ुंण हाडकै दैआ चजेऊई।<verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />भलै मणछा भली सोठ,</para>
  <para style="q" vid="PRO 12:5">पर कदुष्ट मणछ दैआ धोखअ ई।<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />कदुष्ट मणछे सलाह हआ हत्या करनै आल़ै ज़ेही,</para>
  <para style="q" vid="PRO 12:6">पर धर्मीं मणछे बैण हआ होरी लै आफ़ता का छ़ड़ैऊंणैं आल़ै।<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />कदुष्ट मणछ हआ पठी बरैबाद, तिन्‍नें निं आजू आद-लुआद बी रहंदी,</para>
  <para style="q" vid="PRO 12:7">पर धर्मीं मणछे आद-लुआद रहा बढदी लागी।<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />ज़हा का अक्ल हआ, तेऊ सराहा सोभै,</para>
  <para style="q" vid="PRO 12:8">पर ज़ुंण ऐडअ होए, तेऊ समझ़ा सोभै बृथा।<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />ज़हा मणछा का बैल़ी खाई क्लारी निं आथी,</para>
  <para style="q" vid="PRO 12:9">पर आपणैं बारै सेखी फणाटा सह बडी-बडी!</para>
  <para style="q" vid="PRO 12:9">तेऊ इहै मणछा का राम्बल़अ आसा सह आम मणछ ज़ुंण आपणअ पेट, धाचा।<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />धर्मीं मणछा हआ आपणैं डागै-धणे बी फिकर,</para>
  <para style="q" vid="PRO 12:10">पर कदुष्ट मणछ हआ नर्दैई।<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />ज़ुंण खेचै खटा, तेऊ का हणअ खाणां पिणां लै रज्ज़ी,</para>
  <para style="q" vid="PRO 12:11">पर निक्‍की संगती दी बगत ज़ांऐं करनअ हआ ऐडी गल्‍ल।<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />कदुष्ट मणछा हआ किज़ै नां किज़ै कबध करना लै ठुर्हा लागी दी,</para>
  <para style="q" vid="PRO 12:12">पर धर्मीं मणछ रहा इहै बूटा ज़िहअ पाक्‍कअ टेक्‍की ज़ेते ज़लैल़ै डुघै हआ।<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />कदुष्ट मणछा लै हआ तेऊए आपणीं ई बोली दी झ़ुठी गल्‍ला फाही,</para>
  <para style="q" vid="PRO 12:13">पर मानदार मणछ जाआ आफ़ता का बच़ी।<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />मणछा भेटा आपणैं बोल अर कर्मे साबै फल,</para>
  <para style="q" vid="PRO 12:14">सह ज़िहअ कर्म करा, फल बी भेटा तेऊ तिहअ ई।<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />ऐडै मणछ सोठा हर बगत इहअ कि तिंयां ई आसा ठीक,</para>
  <para style="q" vid="PRO 12:15">पर अक्ली आल़ै मणछ दैआ दुजे सलाह दी धैन।<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />ऐडअ मणछ जाआ हेरा-हेरी रुश्शी,</para>
  <para style="q" vid="PRO 12:16">पर सोर-समझ़ हुई, सह काढा आपणीं बेइज़ती बी ज़िरी।<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />मानदार शाजत खोज़ा दालता दी शुची गल्‍ला,</para>
  <para style="q" vid="PRO 12:17">पर झ़ुठअ शाजत खोज़ा झ़ुठी गल्‍ला।<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />बच़ार किऐ बाझ़ी बोलै दै बैण च़ुभा तलबारा ज़िहै,</para>
  <para style="q" vid="PRO 12:18">पर अक्ली आल़ै मणछे बोल लाआ मल्हम।<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />झ़ुठ हआ थोल़ी घल़ी लै,</para>
  <para style="q" vid="PRO 12:19">पर सत्त रहा सदा बणी।<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />कदुष्ट मन्‍न हआ ठग,</para>
  <para style="q" vid="PRO 12:20">पर मेल़-ज़ोल़ करनै आल़ै भेटा खुशी।<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />भलै मणछा निं आफ़त पल़दी,</para>
  <para style="q" vid="PRO 12:21">पर कदुष्टा निं आफ़ता का सुआई होर भेटदअ ई आथी।<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />शल़ैघा घल़णै आल़ै मणछा का करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 12:22">पर ज़ुंण शुची-पाक्‍की ज़बान दैआ, तेऊ लै हआ सह खुश।<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />अक्ली आल़ै मणछा का हआ ज्ञैन पर तेता निं सह होरी का रहैऊंदअ फिरदअ,</para>
  <para style="q" vid="PRO 12:23">पर ऐडअ मणछ खोज़ा आपणीं ऐडी गल्‍ला सारै दी।<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />मैन्थ करनै आल़ै मणछ करा राज़,</para>
  <para style="q" vid="PRO 12:24">पर ज़ैऊंकर मणछा लागा लोगे गलामी करनी।<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />मन्‍नों फिकर करा मणछा धिठै,</para>
  <para style="q" vid="PRO 12:25">पर एक भली गल्‍ला करै हआ तेऊ उझै।<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />धर्मीं मणछ पाआ आपणैं साथी-संघी बी राम्बल़ी बाता,</para>
  <para style="q" vid="PRO 12:26">पर कदुष्ट मणछे बात करा तिन्‍नां बरैबाद।<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />ज़ैऊंकर मणछा निं ज़िहअ सह च़ाहा, तिहअ कधि भेटदअ,</para>
  <para style="q" vid="PRO 12:27">पर मैन्थ करनै आल़ै झाल़ा खज़ानै।<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />धर्मीं बाता भेटा ज़िन्दगी,</para>
  <para style="q" vid="PRO 12:28">सह बात निं मौता बाखा डेऊंदी ज़ेथ कदुष्ट पेठा।<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="s">अक्ली आल़ै मणछे संगत दैआ अक्ल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />ज़ेभै ईज-बाब नैरदै लागै, अक्ली आल़ै लान्हैं समझ़ा तैहा गल्‍ला,</para>
  <para style="q" vid="PRO 13:1">पर नशूण अर हठू निं मंदै ई आथी।<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />भलै मणछा जाआ भली च़िज़ो भलअ पुआज़अ भेटी,</para>
  <para style="q" vid="PRO 13:2">पर घाती मणछ हआ उपद्रभ करने भुखै।<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />सोठी-समझ़ी बोल़णैं आल़अ ता करा आपणीं ज़िन्दगीए फाज़त,</para>
  <para style="q" vid="PRO 13:3">पर ज़ुंण टाभ बाहा, सह करा आपणीं बरैबादी।<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />ज़ैऊंकर मणछ च़ाहा ता खास्सअ, पर तेऊ निं किछ़ भेटदअ,</para>
  <para style="q" vid="PRO 13:4">पर मैन्थी मणछा भेटा ज़िहअ सह च़ाहा तिहअ ई रज्ज़ी।<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />मानदार मणछ करा शल़ैघी का ज़ीद,</para>
  <para style="q" vid="PRO 13:5">पर कदुष्ट मणछा लागा शर्मिंदै अर बेइज़त हणअ।<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />धर्मीं ज़िन्दगी करा नर्दोश मणछे फाज़त,</para>
  <para style="q" vid="PRO 13:6">पर कदुष्ट मणछा करा तेऊओ पाप तेऊ आप्पू ई बरैबाद।<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />कई मणछ करा सेठ हणैंओ दखाअ, पाल्‍लै निं हंदअ तिन्‍नां का किछ़ै!</para>
  <para style="q" vid="PRO 13:7">पर कई का हआ सोभै गल्‍ला बतेर्ही, पर तिंयां करा इहअ दखाअ कि तिंयां आसा गरीब।<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />सेठ मणछा लागा आपणीं ज़िन्दगी बच़ाऊंणा लै ढब्बै बी दैणैं,</para>
  <para style="q" vid="PRO 13:8">पर दाल़जी मणछ निं एही धमकी बाखा धैन बी दैंदअ।<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />धर्मीं मणछ हआ प्रैश्शै ज़िहै,</para>
  <para style="q" vid="PRO 13:9">पर कदुष्ट मणछ हआ हिठै दै लाटू ज़िहै।<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />घमंड करी हआ झ़गल़ै ई,</para>
  <para style="q" vid="PRO 13:10">पर अक्ली आल़अ मणछ शूणां दुजे सलाह।<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />धोखै करै खटअ द धन हआ खतम बी छ़ेक्‍कै,</para>
  <para style="q" vid="PRO 13:11">पर ज़ेथ मैन्थ हुई लागी दी, सह रहा बढदअ लागी।<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />ज़ेभै आशा खतम हआ, तेभै चुटा दिल बी,</para>
  <para style="q" vid="PRO 13:12">पर ज़ेभै मानत पूरी हआ, सह ज़ाण्हिंआं ज़िन्दगी दैणैं आल़ै हरै बूटा ज़िहअ।<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />ज़ुंण भली सलाह<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="fq" closed="false">भली सलाह </char><char style="ft" closed="false">परमेशरे बैण</char></note> निं मंदअ, सह आणा आप्पू लै आफ़त,</para>
  <para style="q" vid="PRO 13:13">पर ज़ुंण तेतो मोल समझ़ा, सह करा आपणीं फाज़त।<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />अक्ली आल़ै मणछे शिक्षा हआ एही सोबल़ ज़ुंण ज़िन्दगी दैआ,</para>
  <para style="q" vid="PRO 13:14">तेता करै भेटा तेभै मज़त ज़ेभै तम्हां मरनै जोगी फाही हआ हुई दी।<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />सुंबल़ी बुधा आल़ै मणछो हआ अदर,</para>
  <para style="q" vid="PRO 13:15">पर कबुधी मणछ हांढा तैहा बाता ज़ेथ बरैबादी हआ।<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />ज़हा सोर-समझ़ हुई, सह करा काम करनै का आजी बच़ार,</para>
  <para style="q" vid="PRO 13:16">पर ऐडअ मणछ करा आपणीं कबुध प्रगट।<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />समादा पजैल़णैं आल़अ दूत ज़ै कदुष्ट होए, सह पाआ होर बी झाख,</para>
  <para style="q" vid="PRO 13:17">पर शुचअ-पाक्‍कअ मणछ करा मेल़-ज़ोल़।<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />ज़ुंण मणछ नांईं शिखल़दअ, तेऊ पल़ा दाल़ज, संघा लागा तेऊ शर्मिंदै हणअ।</para>
  <para style="q" vid="PRO 13:18">ज़ुंण नैरी-समझ़ाऊई करै समझ़ा, तेऊओ हआ अदर।<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />ज़ेभै तम्हैं ज़िहअ च़ाहा तिहअ ई हआ, सह गल्‍ल ज़ाण्हिंआं सोभी का मिठी,</para>
  <para style="q" vid="PRO 13:19">पर कदुष्ट कामां का पिछ़ू हटणअ ज़ाण्हिंआं ऐडै मणछा का बूरअ।<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />ज़ुंण अक्ली आल़ै मणछे संगत करा, तेऊ संघै एछा तेऊ आप्पू बी अक्ल,</para>
  <para style="q" vid="PRO 13:20">पर ऐडै मणछे संगत पाआ आफ़ता दी।<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />पापी मणछे निं आफ़त पिछ़अ छ़ाडदी,</para>
  <para style="q" vid="PRO 13:21">पर धर्मीं मणछा भेटा तेतो फल भलअ ई।<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />भलअ मणछ डाहा आपणैं पोचै-पल़पोचै तैणीं धन झाल़ी,</para>
  <para style="q" vid="PRO 13:22">पर पापी मणछे ज़ैदात डेओआ तेऊए आपणीं पोस्ती बी ज़ैदात धर्मीं लै।<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />रैनै-गरीबे खेचै जाआ राम्बल़ी साल-फसल हई,</para>
  <para style="q" vid="PRO 13:23">पर कदुष्ट मणछ निं तिन्‍नां बऊंणैं-बचऊणैं दैंदै।<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />ज़ुंण आपणैं शोहरू-माठै लै झ़ूरा, सह डाहा तिन्‍नां नैरी बी,</para>
  <para style="q" vid="PRO 13:24">पर ज़ुंण नांईं झ़ूरदअ, सह दैआ तिन्‍नां कज़ेही करनै।<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />धर्मीं मणछा का हआ खाणां लै बतेर्हअ नाज़,</para>
  <para style="q" vid="PRO 13:25">पर कदुष्ट मणछा हआ बैल़ी खाई क्लारी भेटणीं कठण।<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="s">अक्ली करै एछा सोर-समझ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />ज़हा बेटल़ी अक्ल हुई सह बणाआं आपणअ बसेरअ,</para>
  <para style="q" vid="PRO 14:1">पर कबुधी ऐडी बेटल़ी खोआ आपणअ घअर आपणैं हाथै।<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />मानदारी रहैऊआ ऐहा गल्‍ला कि तम्हैं करा बिधातो अदर,</para>
  <para style="q" vid="PRO 14:2">पर विश्वास घात करा ऐहा गल्‍ला प्रगट कि तम्हैं निं बिधाता बी मंदै।<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />घमंडी ऐडअ पाआ बडी-बडी डिंगा मारी आप्पू लै आफ़त,</para>
  <para style="q" vid="PRO 14:3">पर अक्ली आल़ै मणछे बैण करा तेऊए आपणीं फाज़त।<verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />बल्दा बाझ़ी हआ खहल़ रित्तअ,</para>
  <para style="q" vid="PRO 14:4">किल्हैकि तेऊ बाझ़ी निं साल-फसल हंदी।<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />मानदार शाजत निं झ़ुठअ बोल्दअ,</para>
  <para style="q" vid="PRO 14:5">पर झ़ुठअ शाजत घल़ा शल़ैघा ई।<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />ज़ुंण हर गल्‍लो सुहांग करा, तिन्‍नां निं अक्ल एछी सकदी,</para>
  <para style="q" vid="PRO 14:6">पर समझ़कार मणछ जाआ छ़ेक्‍कै समझ़ी।<verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />ऐडै मणछे संगती का रहणअ दूर,</para>
  <para style="q" vid="PRO 14:7">तिन्‍नां का निं शिखल़णा लै किछ़ै भेटदअ।<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />ज़हा सोर-समझ़ हुई सह आसा अक्ली आल़अ, किल्हैकि तेऊ का हआ थोघ कि किज़ै करनअ,</para>
  <para style="q" vid="PRO 14:8">पर ऐडै मणछे कबुध दैआ तेऊ लै धोखअ।<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />ऐडअ मणछ निं आपणैं पापे परबाह करदअ,</para>
  <para style="q" vid="PRO 14:9">पर भलै मणछ च़ाहा माफ करी मेल़-ज़ोल़ करनअ।<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />दुख अर सुख हआ दुहै गल्‍ला आपणीं,</para>
  <para style="q" vid="PRO 14:10">तेथ निं कोहै तम्हां संघै साझ़ करी सकदअ।<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />धर्मीं मणछो घअर रहअ फल़दअ-फुलदअ लागी,</para>
  <para style="q" vid="PRO 14:11">पर कदुष्ट मणछो घअर हआ बरैबाद।<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />एक बात हआ एही बी ज़ुंण मणछा का भली ज़ाण्हिंआं,</para>
  <para style="q" vid="PRO 14:12">पर सह सका मौते दुआरै बी पजैल़ी।<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />हास्सी-खुशी पिछ़ू सका दुख लुक्‍की,</para>
  <para style="q" vid="PRO 14:13">पर ज़ांऊं हास्सी-खुशी मुक्‍का, तेखअ शुझिआ सह दुख तिधी।<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />ज़िहअ बऊअ, लऊंणा लै बी भेटा तिहअ ई,</para>
  <para style="q" vid="PRO 14:14">च़ाऐ सह भलअ होए या बूरअ।<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />ऐडअ मणछ फिरा कज़ेथै बाखा लै,</para>
  <para style="q" vid="PRO 14:15">पर ज़हा सोर-समझ़ हुई सह मणछ करा बच़ार कि अह बात केथ बाखा लै डेओआ।<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />अक्ली आल़अ मणछ डाहा धैन, सह हेरा ज़ाणीं कि आफ़त च़ाल्‍ली पल़ी,</para>
  <para style="q" vid="PRO 14:16">पर ऐडै मणछ हआ निहंचै बेठै दै! तिंयां निं तेतो धैन ई डाहंदै।<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />ज़हा धखी का रोश्शै एछा, तिंयां करा ऐडी गल्‍ल,</para>
  <para style="q" vid="PRO 14:17">पर ज़हा सोर-समझ़ हुई सह करा बच़ार।<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />कबुधी कराऊआ ऐडै काम,</para>
  <para style="q" vid="PRO 14:18">पर ज़हा सोर-समझ़ हुई, तेऊ का हआ ज्ञैन बी।<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />बूरै मणछा लागा भलै सेटा अर कदुष्ट मणछा लागा</para>
  <para style="q" vid="PRO 14:19">धर्मीं मणछा सेटा मुंडकी ढोल़ी मज़त मांगणी।<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />दाल़जी मणछा निं तेऊए साथी-संघी बी च़ाहंदै,</para>
  <para style="q" vid="PRO 14:20">पर सेठ मणछे हआ खास्सी साथ-संगत।<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />ज़ै तम्हैं खुश रहणअ च़ाहा, तै हणअ गरीबा लै झणैल़ू,</para>
  <para style="q" vid="PRO 14:21">किल्हैकि होरी लै नफरत करनी हआ पाप ई।<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />ज़ै तम्हैं भलअ करे, तेता करै खटणअ तम्हां होरीओ भरोस्सअ अर अदर,</para>
  <para style="q" vid="PRO 14:22">पर थारै कदुष्ट काम करनै आसा थारी महान गलती।<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />ज़ै तम्हैं मैन्थ करे, तेता करै हआ सदा नफअ ई,</para>
  <para style="q" vid="PRO 14:23">पर बृथा गल्‍ला दी बगत ज़ांऐं करी एछा गरीबी।<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />अक्ल सका तम्हां सेठ बणाईं,</para>
  <para style="q" vid="PRO 14:24">पर ऐडी गल्‍ला करै हआ कबुध ई पैईदा।<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />शाजत बच़ाऊआ शुची गल्‍ला खोज़ी करै कई ज़िन्दगी,</para>
  <para style="q" vid="PRO 14:25">पर शल़ैघा घल़णै आल़अ दैआ लोगा लै धोखअ।<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />बिधातो अदर करी एछा भरोस्सअ,</para>
  <para style="q" vid="PRO 14:26">तेता करै हआ तेऊ मणछ अर तेऊए टबरे फाज़त अर तेथ भेटा तेऊए लान्हैं सुन्हैं बी शरण।<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />ज़ै तम्हैं मौता का बच़णअ च़ाहा,</para>
  <para style="q" vid="PRO 14:27">तै करा बिधातो अदर, किल्हैकि सह आसा एही सोबल़ा ज़ेही ज़ुंण ज़िन्दगी दैआ।<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />राज़अ महान आसा कि नांईं, तेतो थोघ लागा इहअ करै कि सह केतरै लोगा प्रैंदै करा राज़,</para>
  <para style="q" vid="PRO 14:28">बाझ़ी परज़ा आसा राज़अ बी बृथा।<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />ज़ुंण सबर करा, सह हआ समझ़कार,</para>
  <para style="q" vid="PRO 14:29">पर ज़हा धखी का रोश्शै एछा, सह हआ ऐडअ ई।<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />शांत मन्‍न डाही एछा देही बी त्राण,</para>
  <para style="q" vid="PRO 14:30">पर ज़ीद-मिश हआ हाडकै चजेऊणैं आल़ी बमारी ज़ेही।<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />ज़ुंण गरीबा छेऊआ, सह करा तेऊ बिधाता नकदरै ज़ुंणी तिंयां बणाऐं,</para>
  <para style="q" vid="PRO 14:31">पर गरीबा लै झणैल़ू हणअ हआ बिधाते च़ाकरी करनै बराबर।<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />कदुष्ट मणछ हआ आपणैं ई कदुष्ट कामां करै बरैबाद,</para>
  <para style="q" vid="PRO 14:32">पर धर्मीं मणछे आशा निं मरदी-मरदी बी चुटदी।<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />समझ़कार मणछा का हआ अक्लीओ थोघ,</para>
  <para style="q" vid="PRO 14:33">पर ऐडै मणछा निं अक्लीए बारै थोघ ई हंदअ।<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />ज़ेऊ देशै परज़ा धर्मीं ज़िन्दगी ज़िऊआ, तेता करै हआ सह देश महान,</para>
  <para style="q" vid="PRO 14:34">पर पापी करै पल़ा सारै देशा शर्मिंदै हणअ।<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />राज़े कार-करिंदै मांझ़ै ज़ुंण अक्ली आल़ै काम करा, तिन्‍नां लै हआ सह खुश,</para>
  <para style="q" vid="PRO 14:35">पर ऐडै काम करनै आल़ै लै दैआ सह सज़ा।<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="s">बिधाता हआ सोभी भाल़अ लागअ द</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />राम्बल़ै करै गल्‍ला करी हआ रोश्श बी ठांढअ,</para>
  <para style="q" vid="PRO 15:1">पर कल़ुई गल्‍ला पाआ होर बी खास्सअ खरोल़।<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />अक्ली आल़अ मणछ ज़ाणा लोगा का ज्ञैन खोज़ी,</para>
  <para style="q" vid="PRO 15:2">पर कबुधी मणछा का निखल़ा ऐडी ई गल्‍ला।<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />बिधाता हआ सारै दी भाल़अ लागअ द कि संसार किज़ै करा,</para>
  <para style="q" vid="PRO 15:3">सह भाल़ा हाम्हां कि हाम्हैं भलअ करा कि बूरअ।<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />झणैल़ू गल्‍ला करनी हआ तेऊ बूटा ज़ेही ज़ेता का ज़िन्दगी भेटा,</para>
  <para style="q" vid="PRO 15:4">पर उंबल़ी गल्‍ला करै हआ शाह बी धिठअ।<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />ईजा-बाबा लै नशूंण हणअ आसा कबुध ई,</para>
  <para style="q" vid="PRO 15:5">पर ज़हा सोर-समझ़ हुई, सह मना तिन्‍नें सोभै गल्‍ला।<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />भलै मणछ जाआ सेठ हई,</para>
  <para style="q" vid="PRO 15:6">पर कदुष्ट मणछ हआ एकी धैल़ै ज़रूर दाल़जी।<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />ज्ञैन खोज़ा तिंयां ई ज़हा का अक्ल हुई,</para>
  <para style="q" vid="PRO 15:7">ऐडै का निं किछ़ै हंदअ।<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />ज़ेभै भलै मणछ अरज़ करा, बिधाता हआ तेता लै खुश,</para>
  <para style="q" vid="PRO 15:8">पर कदुष्ट मणछे बल़ीदाना लै करा सह नफरत।<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />ज़ुंण भलअ करा तेऊ लै झ़ूरा बिधाता बी,</para>
  <para style="q" vid="PRO 15:9">पर कदुष्ट मणछे च़ाल-च़लणा का हआ तेऊ नफरत।<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />ज़ुंण सुंबल़ी बाता का कबाता पेठा, तेऊ भेटणीं घोर सज़ा</para>
  <para style="q" vid="PRO 15:10">अर ज़ुंण नैरी-समझ़ाऊई लै ज़ीद डाहा, सह मरा छ़ेक्‍कै।<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />ज़ेऊ संसारै मणछ मरी करै पुजा, तिधी बी हआ बिधाता भाल़अ लागअ द,</para>
  <para style="q" vid="PRO 15:11">तेऊ का हआ इहअ बी थोघ कि थारै दिलै किज़ै आसा।<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />सुहांगा करनै आल़अ मणछ निं नैरी समझ़ाऊई मंदअ,</para>
  <para style="q" vid="PRO 15:12">सह निं अक्ली आल़ै मणछा का सलाह लंदअ।<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />ज़ै दिलै खुशी हुई तेता करै सह जाआ मणछे मुंहैं शुझुई,</para>
  <para style="q" vid="PRO 15:13">पर ज़ै दिल चुटअ, तेता करै हआ आत्मां बी दुखी।<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />ज़हा सोर समझ़ हुई, सह च़ाहा शिखल़णअ,</para>
  <para style="q" vid="PRO 15:14">पर कबुधी मणछ जाआ ऐडी गल्‍ला करै ई रज्ज़ी।<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />गरीब मणछे ज़िन्दगी हआ कठण,</para>
  <para style="q" vid="PRO 15:15">पर खुशी दिले मणछे ज़िन्दगी हआ मौज़।<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />सेठ हई आफ़ता दी पल़णै का आसा,</para>
  <para style="q" vid="PRO 15:16">बिधाते डरा हेठै दुखी रहणअ भलअ।<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />नफरत करनै आल़ै घअरै शिखा खाणैं का आसा,</para>
  <para style="q" vid="PRO 15:17">तेऊ घअरै शुक्‍की भाज़ी करै रोटी खाणीं ठीक ज़ुंण इज़त करा!<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />रोश्शा करै हआ झ़गल़ै पैईदा,</para>
  <para style="q" vid="PRO 15:18">पर सबर डाही हआ मेल़-ज़ोल़।<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />ज़ैऊंकर हणअ हआ कांडे झ़ाकल़ा बाती हांढणअ,</para>
  <para style="q" vid="PRO 15:19">पर मानदार मणछा निं किछ़ै आफ़त पल़दी।<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />अक्ली आल़ी लुआदा करै हआ बाब खुश,</para>
  <para style="q" vid="PRO 15:20">पर ऐडअ मणछ निं आपणीं ईजो अदर करदअ।<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />कबुधी मणछ हआ आपणीं ऐडी गल्‍ला लै खुश,</para>
  <para style="q" vid="PRO 15:21">पर ज़हा सोर-समझ़ हुई, सह हांढा आज़री बाता।<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />राम्बल़ी सलाह करै हआ हर काम सफल,</para>
  <para style="q" vid="PRO 15:22">एता बाझ़ी हआ सारी तरकिबा बृथा।<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />ज़ै मोक्‍कै दी राम्बल़अ ज़बाब दैनअ,</para>
  <para style="q" vid="PRO 15:23">तेता करै हआ सोभ लोग खुश।<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />अक्ली आल़अ मणछ हांढा तैहा बाता, ज़ेथ तेऊए ज़िन्दगी सफल हआ,</para>
  <para style="q" vid="PRO 15:24">सह निं तैहा बाता डेऊंदअ ज़ेथ तेऊए ज़िन्दगी बरैबाद हआ।<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />ज़ुंण घमंडी आसा, तेऊओ घअर निं बिधाता हणैं दैंदअ,</para>
  <para style="q" vid="PRO 15:25">पर बिधबा बेटल़ीए ज़ैदात डाहा सह बच़ाऊई।<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />कदुष्ट सोठा लै करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 15:26">शोभली गल्‍ला करनै आल़ै मणछा लै हआ सह खुश।<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />मांण करनै आल़अ पाआ आपणैं टबरा लै बी आफ़त,</para>
  <para style="q" vid="PRO 15:27">पर ज़ुंण रेशपत लणैं-दैणैं का नफरत करा, तेऊए अमर हआ खास्सी।<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />भलअ मणछ करा गल्‍ला करनै का आजी बच़ार,</para>
  <para style="q" vid="PRO 15:28">पर कदुष्ट दैआ हेरा-हेरी ज़बाब, संघा हआ आफ़त खल़ी।<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />ज़ेभै भलै मणछ बिधाता का अरज़ करा, तिन्‍नें हेरा सह शूणीं,</para>
  <para style="q" vid="PRO 15:29">पर कदुष्ट मणछा का रहा सह दूर ई।<verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />प्रैश्शअ मुंह भाल़ी हआ दिल खुश</para>
  <para style="q" vid="PRO 15:30">अर खुशी दैणैं आल़ै समादा शूणीं फिरअ शाह हरअ।<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />ज़ुंण नैरी-समझ़ाऊई लै धैन दैआ,</para>
  <para style="q" vid="PRO 15:31">सह हआ अक्ली आल़अ मणछ।<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />ज़ुंण शिक्षा नांईं मंदअ, सह करा आप्पू लै आप्पै घात,</para>
  <para style="q" vid="PRO 15:32">पर ज़ुंण नैरी-समझ़ाऊई करै समझ़ा, तेऊ एछा अक्ल।<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />बिधातो अदर करी एछा अक्ल ई,</para>
  <para style="q" vid="PRO 15:33">ज़ै तम्हां अदर लोल़ी, तै लागा शरीफ हणअ।<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />मणछ सोठा कई गल्‍ला,</para>
  <para style="q" vid="PRO 16:1">पर ज़िभा का बैण भराऊणैं आल़अ हआ बिधाता।<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />मणछ सोठा इहअ कि ज़ुंण तेऊ किअ सह ई आसा ठीक,</para>
  <para style="q" vid="PRO 16:2">पर बिधाता तोला तेऊओ मन्‍न।<verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />सोभै गल्‍ला छ़ाडा बिधाता सेटा,</para>
  <para style="q" vid="PRO 16:3">तेऊ करनी थारी गल्‍ला सफल।<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />ज़ुंण बी च़िज़ा बिधाता बणाईं, तेतो आसा किज़ै नां किज़ै मकसद,</para>
  <para style="q" vid="PRO 16:4">इधी तैणीं कि कदुष्ट मणछ आसा बनाशे धैल़ी लै।<verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />घमंडी लै करा बिधाता नफरत,</para>
  <para style="q" vid="PRO 16:5">तिंयां निं सज़ा का बच़ी सकदै।<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />ज़ै तम्हैं मानदार अर शुचै-पाक्‍कै रहे, तै छ़ाडणीं बिधाता तम्हां लै माफी,</para>
  <para style="q" vid="PRO 16:6">ज़ै तम्हैं ज़िहअ बिधाता बोले तिहअ ई करे, तै निं थारअ किछ़ै बूरअ हणअ।<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />ज़ै बिधाता तम्हां करै खुश होए,</para>
  <para style="q" vid="PRO 16:7">तै सका थारै दुशमणा संघै बी मेल़-ज़ोल़ हई।<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />धोखै करै खास्सी कमाई का आसा,</para>
  <para style="q" vid="PRO 16:8">मानदारी दी खटअ द धख ज़िहअ ई भलअ।<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />मणछ सोठा आपणैं मन्‍नैं खास्सी गल्‍ला,</para>
  <para style="q" vid="PRO 16:9">पर असली दी कहा बाता लागा डेऊणअ, तेता खोज़ा बिधाता आप्पै।<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />राज़े खाखा का निखल़ै दै बैण हआ सुरगा बाखा,</para>
  <para style="q" vid="PRO 16:10">तेऊओ फैंसलअ हआ ठीक ई।<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />बिधाता च़ाहा कि हर तराकल़ी अर बाटा दी निं लोल़ी धोखअ हुअ,</para>
  <para style="q" vid="PRO 16:11">लणैं-दैणैं लै निं लोल़ी कोहै ठगै।<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />राज़अ निं बूराई मंदअ ई,</para>
  <para style="q" vid="PRO 16:12">किल्हैकि तेऊए राज़ा दी हआ नसाफ तै रहा सह बणी।<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />राज़अ च़ाहा शुची गल्‍ला शुणनअ,</para>
  <para style="q" vid="PRO 16:13">ज़ुंण शुचअ बोला, तेऊओ साथ बी हेरा तेखअ सह दैई।<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />अक्ली आल़अ मणछ करा राज़ै खुश डाहणें कोशिश,</para>
  <para style="q" vid="PRO 16:14">किल्हैकि ज़ै राज़ै रोश्शै गई एछी, तै सका कुंण नां कुंण मरी बी।<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />ज़ै राज़अ खुश होए अर तम्हां लै राज्ज़ी होए,</para>
  <para style="q" vid="PRO 16:15">सह हणअ तम्हां लै बरसाती ज़िहअ, अर तम्हैं रहणैं तै ज़िऊंदै।<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />अक्ल भेटणीं हआ सुन्‍नैं का बी राम्बल़ी,</para>
  <para style="q" vid="PRO 16:16">अर समझ़ एछणी हआ च़ंदी का भली।<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />भलअ मणछ हांढा तैहा बाता, ज़ेथ बूराई निं हंदी,</para>
  <para style="q" vid="PRO 16:17">तैही डाहणअ धैन कि तम्हैं कैहा बाता च़ाल्‍लै, तेता करै सका थारी ज़िन्दगी बच़ी।<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />ज़हा मणछा ठोहल़ च़ाल्‍ली दी होए लागी अर</para>
  <para style="q" vid="PRO 16:18">ज़ुंण मणछ बरैबाद आसा हणैं आल़अ, तेता का आजी एछा तेऊ घमंड।<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />मानदार रही गरीब रहणअ आसा</para>
  <para style="q" vid="PRO 16:19">कहा लुटी-घशिट्टी करै सेठ हणैं का भलअ।<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />ज़ुंण बोल़णैं का आजी बच़ार करा, सह हआ सफल,</para>
  <para style="q" vid="PRO 16:20">ज़सरअ भरोस्सअ बिधाता दी आसा, सह रहा सदा खुश।<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />सैणैं अर अक्ली आल़ै मणछा लै बोला सोभै समझ़कार,</para>
  <para style="q" vid="PRO 16:21">मिठअ बोल़णैं आल़अ सका होरी बी सखाऊई।<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />अक्ल आसा एही सोबल़ ज़ुंण ज़िन्दगी दैआ,</para>
  <para style="q" vid="PRO 16:22">पर कबुधी मणछा भेटा तेऊए ऐडी गल्‍ला लै सज़ा।<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />अक्ली आल़अ मणछ करा गल्‍ला करनै का आजी बच़ार,</para>
  <para style="q" vid="PRO 16:23">ज़ुंण सह बोला, तेता करै भेटा होरी बी शिक्षा।<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />झणैल़ू बैण हआ मखीरा ज़िहै,</para>
  <para style="q" vid="PRO 16:24">सुआद बी मिठअ अर शाह बी फिरा हरअ।<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />एक बात हआ एही बी ज़ुंण मणछा का भली ज़ाण्हिंआं,</para>
  <para style="q" vid="PRO 16:25">पर सह सका मौते दुआरै बी पजैल़ी।<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />मज़दूरे भुख ई कराऊआ तेऊ का खास्सी मैन्थ</para>
  <para style="q" vid="PRO 16:26">किल्हैकि तेऊए भुख करा तेऊ कामां करना लै मज़बूर।<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />उपद्रभी मणछ सोठा कि तेऊ किहअ करै पै करनै होर तंग,</para>
  <para style="q" vid="PRO 16:27">तिन्‍नें हआ खाखे बैण बी आगीए लुपल़ै ज़िहै दहंदै।<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />कदुष्ट मणछ पाआ एही फुआह,</para>
  <para style="q" vid="PRO 16:28">ज़ेता करै आफ़त बी पल़ा अर साथ-संगत बी चुटा।<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />कदुष्ट मणछ दैआ आपणैं साथी-संघी लै बी धोखअ,</para>
  <para style="q" vid="PRO 16:29">संघा निंयां तिन्‍नां बरैबादी बाखा।<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />ज़ुंण तम्हां लै सानै-कानै गल्‍ला करा,</para>
  <para style="q" vid="PRO 16:30">तिन्‍नें मन्‍नैं हआ किज़ै नां किज़ै छ़ल़-कपट।<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />धर्मीं मणछो पुआज़अ आसा लाम्मी अमर,</para>
  <para style="q" vid="PRO 16:31">अर पल़ू हआ शोभा दैणैं आल़अ मुगट।<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />बल रहैऊंणै का आसा सबर डाहणअ भलअ,</para>
  <para style="q" vid="PRO 16:32">अर आपणअ मन्‍न बशै डाहणअ हआ सारी नगरी ज़ितणैं का बी भलअ।<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />लोग पाआ पुछ़णा लै परच़ी कि बिधाता किज़ै च़ाहा,</para>
  <para style="q" vid="PRO 16:33">पर बिधाता छ़ांटा तेता मांझ़ै एक आप्पै।<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="s">बिधाता परखा मन्‍न</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />शांती दी शुक्‍की रोटी खाणीं आसा तेऊ घअरै धामा खाणैं का भली,</para>
  <para style="q" vid="PRO 17:1">ज़ेथ कबल्‍लै झ़गल़ै हआ पल़ै दै।<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />अक्ली आल़अ दास बी करा आपणैं मालके तेऊ शोहरू प्रैंदै राज़ ज़सरअ अदर निं हंदअ,</para>
  <para style="q" vid="PRO 17:2">अर तेऊ दासा भेटा तिन्‍नें ज़ैदाता दी बी हेस्सअ।<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />ज़िहअ सुन्‍नैं अर च़ंदी आरनैं आगी दी परखा,</para>
  <para style="q" vid="PRO 17:3">तिहअ परखा बिधाता मणछो मन्‍न।<verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />कदुष्ट मणछ दैआ कदुष्ट ई गल्‍ला दी धैन,</para>
  <para style="q" vid="PRO 17:4">झ़ुठअ मणछ बी दैआ झ़ुठी ई गल्‍ला दी धैन।<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />ज़ुंण गरीब मणछो सुहांग करा, सह करा तेऊ बिधाते बेइज़ती ज़ुंणी तिंयां बणाऐं,</para>
  <para style="q" vid="PRO 17:5">ज़ुंण कसरी खरी लै हास्सा सह निं सज़ा का बच़ी सकदअ।<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />प्रोढे शोभा हआ तिन्‍नें पोचै,</para>
  <para style="q" vid="PRO 17:6">अर लान्हें शोभा हआ तिन्‍नें ईज-बाब।<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />ज़हा मणछे इज़त हुई, तिंयां निं झ़ुठी गल्‍ला बोल्दै,</para>
  <para style="q" vid="PRO 17:7">अर ऐडै का निं बृथा बैण बोल़णैं का सुआई किछ़ै हंदअ।<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />कई मणछ सोठा इहअ कि रेशपत करा च़मत्कार करनै आल़ी मणीं ज़िहअ काम,</para>
  <para style="q" vid="PRO 17:8">तिन्‍नों विश्वास आसा इहअ कि एता करै सका किछ़ बी हई!<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />ज़ै तम्हैं इहअ च़ाहा कि लोग लोल़ी तम्हां लै झ़ूरै, तै लागा तिन्‍नें गलती लै माफी दैणीं,</para>
  <para style="q" vid="PRO 17:9">ज़ै गलती आद डाही, तेता करै पल़ा साथ-संगती बी फूट।<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />अक्ली आल़अ मणछ जाआ एकी बारी ठोल़ शूणीं समझ़ी,</para>
  <para style="q" vid="PRO 17:10">पर ऐडअ मणछ निं शौआ बारी डांगै खाई बी समझ़दअ।<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />कदुष्ट आदमी निखल़ा आपणैं सैणैं लै उपद्रभ करना लै आजू,</para>
  <para style="q" vid="PRO 17:11">पर तिन्‍नां मारदी एछणी नर्दैई सैना।<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />कबुधी मणछ ऐडै कामां करदै भेटणैं का भलअ आसा</para>
  <para style="q" vid="PRO 17:12">सह भाल्‍लण भेटणीं भली ज़सरअ बच़अ आसा लुक्‍कअ द।<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />ज़ुंण भलाईए बदल़ै बूरअ करा,</para>
  <para style="q" vid="PRO 17:13">तेऊ घअरा का निं बूराई दूर हंदी।<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />झ़गल़े शुरूआत हआ बडै दरैऊआ दी लाऐ दै रोक्‍के संधा ज़ेही, ज़ेता का धख-धख पाणीं चुहंदअ लागा,</para>
  <para style="q" vid="PRO 17:14">सह संध लागा किहअ करै बंद करनी, नांईं ता हआ आफ़त खल़ी।<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />नर्दोश मणछ दोशी बणाणअं अर कदुष्ट मणछ छ़ाडणअ!</para>
  <para style="q" vid="PRO 17:15">इना दुही गल्‍ला का करा बिधाता नफरत।<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />ऐडै मणछो शिक्षा लणा लै च़ंदअ किज़ू दैणअ</para>
  <para style="q" vid="PRO 17:16">ज़ै तिन्‍नां शिखल़णअ ई निं आथी।<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />साथी रहअ सदा साथी,</para>
  <para style="q" vid="PRO 17:17">ज़ेभै आफ़त पल़ी, तेभै च़ोरा रिश्तैदार बी मुंह।<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />ज़हा सोर-समझ़ निं हुई,</para>
  <para style="q" vid="PRO 17:18">सह मणछ लआ होरीए ऋणा पिछ़ू ज़मानती।<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />ज़ुंण पाप करना लै झ़ूरा, सह झ़ूरा आफ़त खल़ी करना लै,</para>
  <para style="q" vid="PRO 17:19">ज़ुंण कबल्‍ली सेखी फणाटा, सह पाआ आप्पू लै आफ़त।<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />ज़ुंण बूरअ सोठा अर बूरअ बोला,</para>
  <para style="q" vid="PRO 17:20">तेऊ निं आप्पू बी भलअ हंदअ, तेऊ लै पल़ा आफ़त ई।<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />ज़ुंण शोहरू ऐडी गल्‍ला करा,</para>
  <para style="q" vid="PRO 17:21">तिन्‍नें हआ ईजा-बाबा बी दुख ई दुख।<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />ज़ै मन्‍न खुश हुअ, तेता करै रहा मणछ नरोगअ,</para>
  <para style="q" vid="PRO 17:22">ज़ै दिल चुटअ, सह दैआ हाडकै बी चजेऊई।<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />कदुष्ट पांच़ ढाका गलत फैंसलै करना लै रेशपत,</para>
  <para style="q" vid="PRO 17:23">संघा पांच़ी बी हआ उंबल़ी।<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />अक्ली आल़अ मणछ भाल़ा कि कुंण काम आसा समझ़कारी आल़अ,</para>
  <para style="q" vid="PRO 17:24">पर ऐडै मणछा हआ सारै दी टोस्सा लागी दी।<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />ऐडअ मणछ दैआ आपणैं बाबा लै दुख अर</para>
  <para style="q" vid="PRO 17:25">आपणीं ईजा लै शोग।<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />नर्दोश मणछा लै डांड पाणअ अर</para>
  <para style="q" vid="PRO 17:26">भलै मणछा लै सज़ा दैणीं निं दुहै गल्‍ला ठीक आथी।<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />ज़ुंण खास्सी गल्‍ला निं करदअ, तेऊ हआ सबर,</para>
  <para style="q" vid="PRO 17:27">अर ज़ुंण शांत रहा सह हआ समझ़कार।<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />ऐडै मणछा लै बी सका समझ़कार अर अक्ली आल़अ बोली,</para>
  <para style="q" vid="PRO 17:28">पर ज़ै सह शांत रहे अर आपणीं ज़िभ च़ुप्पी डाहे।<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />ज़ुंण मणछ होरी संघै निं रल़दअ, सह सोठा सिधअ आपणैं ई बारै,</para>
  <para style="q" vid="PRO 18:1">होरी ज़ै भली गल्‍ल बी बोली, सह निं तेता बी मंदअ आथी।<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />ऐडअ मणछ निं इहअ धैन डाहंदअ कि ज़ुंण गल्‍ल तेऊ बोली तेते समझ़ निं तेऊ आप्पू बी आथी,</para>
  <para style="q" vid="PRO 18:2">पर लोगा सम्हनै फिरा सह होरी लै सलाह दैंदअ ताकि लोग तेऊ सराहे!<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />बूरअ करी पल़ा शर्मिंदै हणअ,</para>
  <para style="q" vid="PRO 18:3">ज़िधी अदर निं हंदअ, तिधी हआ बेइज़ती।<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />मणछे बोल सका अक्लीओ मूल़ अर</para>
  <para style="q" vid="PRO 18:4">समुंदरा ज़िहै डुघै अर ज़ाईरू पाणींए गाडा ज़िहै हई।<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />कदुष्ट मणछो पक्ष लणअ अर</para>
  <para style="q" vid="PRO 18:5">धर्मीं मणछो हक मारनअ निं भली गल्‍ल आथी।<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />ज़ेभै ऐडअ मणछ हठ करा,</para>
  <para style="q" vid="PRO 18:6">सह बोल़णीं तेऊ आप्पू लै ज़ोरा-ज़ोरी मारा खाणें आफ़त पाणीं।<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />ऐडअ मणछ हआ आपणीं गल्‍ला करै बरैबाद,</para>
  <para style="q" vid="PRO 18:7">तेऊए आपणीं ज़िभे बोल ई हआ तेऊ आप्पू लै फाही।<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />घैंचल़ शुणने लागा मखीरा खाणैं ज़ेही मिठ,</para>
  <para style="q" vid="PRO 18:8">तिंयां गल्‍ला पेटै हाज़म बी जाआ हई।<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />कामां लै ज़ैंईं करनै आल़अ मणछ हआ</para>
  <para style="q" vid="PRO 18:9">खरोल़ पाणै आल़ै मणछा ज़िहअ।<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />बिधाता आसा उछ़टै कोटा ज़िहअ,</para>
  <para style="q" vid="PRO 18:10">तेऊ सेटा डेऊई सका धर्मीं मणछ आफ़ता का बच़ी।<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />सेठ सोठा इहअ कि तेऊ बच़ाऊआ तेऊए माया,</para>
  <para style="q" vid="PRO 18:11">ज़ेही नगरी फेरा-फेर बडी उछ़टी दुआल नगरी बच़ाऊआ।<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />बरैबाद हणैं का आजी एछा मणछा घमंड,</para>
  <para style="q" vid="PRO 18:12">अदर हआ तेऊ ई मणछो ज़ुंण मानदार हुअ।<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />बोल़णैं का आजी लणअ शूणीं,</para>
  <para style="q" vid="PRO 18:13">ज़ुंण इहअ नांईं करदअ, तेऊ लै बोला सोभै ऐडअ, नां तेऊओ अदर हंदअ।<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />ज़ै मणछा ज़िऊंणें च़ाह हुई, सह सका बमारी का बी ठीक हई,</para>
  <para style="q" vid="PRO 18:14">पर ज़ै हैअ चोल़ी हेरअ, तै लागा मरने ई आशा डाहणीं।<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />अक्ली आल़अ मणछ रहा,</para>
  <para style="q" vid="PRO 18:15">हर बगत शिखल़दअ ई लागी।<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />तम्हैं कै कहा खास या मशूर मणछा सेटा डेऊणअ च़ाहा?</para>
  <para style="q" vid="PRO 18:16">तेता लै आसा सोभी का सान तरकीब भैंट दैणीं।<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />दालता दी सोभी का आजी बोल़णैं आल़अ ज़ाण्हिंआं तेभै तैणीं शुचअ,</para>
  <para style="q" vid="PRO 18:17">ज़ेभै तैणीं दुजै पक्षा आल़ै तेऊ का सुआल निं पुछ़ै।<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />झ़गल़ैओ फैंसलअ सका परच़ी पाई खतम हई।<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />आपणैं भाई-बंधे करनी मज़त करी, तिंयां सका थारी नगरी फेरे उछ़टी दुआली ज़ेही फाज़त करी,</para>
  <para style="q" vid="PRO 18:19">पर तिन्‍नां संघै झ़गल़अ करी सका तम्हां लै तिन्‍नें दुआर सदा लै बंद हई।<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />अक्ली आल़ै बोल रज़ैऊआ बधिया भोज़ना ज़िहै,</para>
  <para style="q" vid="PRO 18:20">मोक्‍कै दी ठीक गल्‍ल करनी फरेऊआ शाह हरअ।<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />ज़िभे बोल सका मारी बी अर तारी बी सका,</para>
  <para style="q" vid="PRO 18:21">ज़ुंण गल्‍ला करना लै झ़ूरा, तेऊ लागा नतिज़अ बी भुगतणअ।<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />ज़ुंणी बैह करी बेटल़ी आणी, सह लोल़ी तेऊ आप्पू लै बधिया च़ीच़,</para>
  <para style="q" vid="PRO 18:22">ऐहा गल्‍ला का लागा इहअ थोघ कि बिधाता आसा तम्हां लै भलअ।<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />गरीब मणछ करा हाथ ज़ोल़ी करै अरज़,</para>
  <para style="q" vid="PRO 18:23">पर सेठ दैआ क्रुखअ हई ज़बाब।<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />कई साथी करा एकी-दुजै बरैबाद,</para>
  <para style="q" vid="PRO 18:24">पर असली साथी रहा तेऊ संघै आपणैं सक्‍कै भाई का बी खास्सअ मिल़ी-ज़ुल़ी।<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="s">सबर डाहणअ हआ अक्लीए गल्‍ल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />मानदार रही गरीबी दी ज़िऊंणअ आसा</para>
  <para style="q" vid="PRO 19:1">तेऊ मणछा का भलअ ज़ुंण ऐडअ झ़ुठअ बोला।<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />अक्ली बाझ़ी शौक निं ठीक हंदअ,</para>
  <para style="q" vid="PRO 19:2">ज़ुंण तुआखुई करै ठुर्हा, तेऊ पल़ा आफ़त।<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />मणछ बगाल़ा आपणैं ई ऐडै कामां करै आपणीं गल्‍ल</para>
  <para style="q" vid="PRO 19:3">तेखअ लाआ बिधाता लै गलती कि अह किअ तेऊ।<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />सेठ मणछे हआ कई साथी-संघी,</para>
  <para style="q" vid="PRO 19:4">पर गरीबी भाल़ी डेओआ साथी बी आपणीं बाता।<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />ज़ुंण झ़ुठी शाजत दैआ सह आसा दोशी,</para>
  <para style="q" vid="PRO 19:5">इहअ मणछ निं सज़ा का बच़ी सकदअ।<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />ज़ुंण खुल्है हाथै बांडा तेऊ संघै च़ाहा हर कोई साथ-संगत डाहणीं,</para>
  <para style="q" vid="PRO 19:6">खास मणछा लै च़ाहा सोभै कि अह लोल़ी त मुंह ई संघै रहअ।<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />गरीब मणछो साथ छ़ाडा तेऊए नातै-रिश्तैदार बी,</para>
  <para style="q" vid="PRO 19:7">ज़ेभै असली दी गरज़ पल़ी तेभै च़ोरा साथी-संघी बी मुंह,</para>
  <para style="q" vid="PRO 19:7">तेभै डेओआ तिंयां हाथ ज़ोल़ी अरज़ करी बी दूर।<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />ज़ुंण असली दी आप्पू अक्ली लै झ़ूरा, तेऊ रहणअ शिखल़दै लागी,</para>
  <para style="q" vid="PRO 19:8">ज़ुंण तेता समझ़ी आद डाहा, सह हआ सफल।<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />झ़ुठी शाजत दैणैं आल़अ निं सज़ा का बच़ी सकदअ,</para>
  <para style="q" vid="PRO 19:9">ज़ुंण झ़ुठअ बोला, सह हआ बरैबाद ई।<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />ज़िहअ ऐडै मणछो ठाहठा दी रहणअ निं ढबदअ,</para>
  <para style="q" vid="PRO 19:10">तेही ई हआ गलाम मणछो कार-करिंदै प्रैंदै राज़ करनअ नुआहरी गल्‍ल।<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />ज़हा मणछा अक्ल हआ सह करा सबर,</para>
  <para style="q" vid="PRO 19:11">होरीए गलती माफ करी खटा सह आप्पू लै इज़त।<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />राज़े रोश्श हआ सिहे क्रुंगा ज़ेही,</para>
  <para style="q" vid="PRO 19:12">पर ज़ै राज़अ खुश होए, सह हआ घाह प्रैंदै पल़ी दी ओशा ज़ेही।<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />ऐडी लुआद करा आपणैं ईजा-बाबा बरैबाद,</para>
  <para style="q" vid="PRO 19:13">झ़गल़ै करनै आल़ी बेटल़ी हआ छ़ाप्परा का पांडा भितरी लागी दी च़ोई ज़ेही।<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />घअर अर ज़ैदात जाआ आपणैं ईजा-बाबा का भेटी,</para>
  <para style="q" vid="PRO 19:14">पर अक्ली आल़ी बेटल़ी दैआ बिधाता ई।<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />ज़ैऊंकर मणछा नींज ता जाआ एछी,</para>
  <para style="q" vid="PRO 19:15">पर कामां लै ज़ैंईं लाआ तेऊ भुखै ब्रत।<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />ज़ुंण बिधातो बधान मना, सह ज़िऊआ खास्सअ,</para>
  <para style="q" vid="PRO 19:16">पर ज़ुंण लापरबाही करा, सह मरा छ़ेक्‍कै।<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />गरीबा लै दैनअ द दान हआ बिधाता लै ऋण दैणैं ज़िहअ,</para>
  <para style="q" vid="PRO 19:17">अर बिधाता करा तेऊ तम्हां लै बापस।<verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />आपणैं लान्हैं डाहणैं होछ़ी उझै नैरी,</para>
  <para style="q" vid="PRO 19:18">इहअ नांईं करनअ हआ तिंयां ज़ाणीं-भुझ़ी बरैबाद करनै।<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />ज़ुंण रोश्शा आल़अ आसा, तेऊ दैणअ तेते सज़ा आप्पै भुगतणै,</para>
  <para style="q" vid="PRO 19:19">किल्है तम्हैं एकी बारी बच़ाऊए, तेखअ हणैं तम्हैं कबल्‍लै तेऊ बच़ाऊंदै।<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />ज़ुंण सलाह मना अर शिखल़णअ च़ाहा,</para>
  <para style="q" vid="PRO 19:20">सह हणअ एकी धैल़ै अक्ली आल़अ मणछ।<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />मणछ सोठा आपणैं दिलै कई गल्‍ला,</para>
  <para style="q" vid="PRO 19:21">पर सफल हआ सह ई गल्‍ल ज़ुंण बिधाता सोठा।<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />मानदार मणछ मोहा होरी लोगा बी,</para>
  <para style="q" vid="PRO 19:22">गरीब मणछ हआ शल़ैघा घल़णै आल़ै का भलअ।<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />बिधाते डरा हेठै रही हआ मणछे अमर खास्सी,</para>
  <para style="q" vid="PRO 19:23">सुखी ज़िन्दगी अर आफ़ता का बी रहा सह दूर।<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />कई मणछा हआ एतरी ज़ैंईं कि</para>
  <para style="q" vid="PRO 19:24">तिन्‍नां लागा थाल़ू का खाखा लै रोटीए म्हारा पाणा लै बी ज़ैंईं।<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />सुहांगा करनै आल़ै लै लणी सज़ा दैई, ताकि कबुधी अर ऐडै बी समझ़ एछे,</para>
  <para style="q" vid="PRO 19:25">ज़ुंण अक्ली आल़अ हुअ, सह जाआ तेभै शिखल़ी ज़ेभै तेऊ नैरा-समझ़ाऊआ।<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />ज़ुंण आपणैं बाबा नकदरै करा अर आपणीं ईजा घअरा का पोर्ही काढा,</para>
  <para style="q" vid="PRO 19:26">इहअ मणछ हआ शर्मिंदअ अर तेऊए निं किधी इज़त हंदी।<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />लान्हैंओ, ज़ै तम्हैं शिक्षा शुणनी छ़ाडे,</para>
  <para style="q" vid="PRO 19:27">तम्हैं बिस्सर्नै तिन्‍नां गल्‍ला बी ज़ुंण तम्हां का थोघ बी थिअ।<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />झ़ुठ बोल़णैं आल़अ समझ़ा दालता बी बृथा,</para>
  <para style="q" vid="PRO 19:28">कदुष्ट मणछा लागा ज़ुल्म करना लै सुआद।<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />सुहांगा करनै आल़ै भेटणीं ज़रूर सज़ा</para>
  <para style="q" vid="PRO 19:29">अर ऐडै मणछा भेटा मार ई।<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="s">अक्लीए बोल हआ सुन्‍नैं का बी भलै</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />नशिल्‍लै दाखे रसा झुटी हआ झ़गल़ै ई,</para>
  <para style="q" vid="PRO 20:1">एता झुटा ज़ुंण भूल करा सह मणछ हआ कबुधी ई।<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />राज़े रोश्शे डअर हआ सिहे क्रुंगा ज़ेही,</para>
  <para style="q" vid="PRO 20:2">ज़ुंण तेऊ लै रोश्शै ठैऊआ, सह शादा आप्पू लै मौत।<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />ऐडअ मणछ ई निखल़ा झ़गल़ै लै आजू,</para>
  <para style="q" vid="PRO 20:3">समझ़कार मणछ रहा एही गल्‍ला का दूर।<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />ज़ैऊंकर मणछा हआ बऊंणे ऋता हल़ा लाणें ज़ैंईं लागी दी, तेता लै काढा सह ठांढै-शेल़ैओ भान्‍नअ,</para>
  <para style="q" vid="PRO 20:4">लऊंणींए बगती निं तेखअ घअरै-घअरै टुकरै मांगी बी किछ़ै भेटदअ।<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />मणछे सोठ हआ डुघै कुहै ज़ेही,</para>
  <para style="q" vid="PRO 20:5">पर ज़हा सोर समझ़ हुई, सह काढा तिन्‍नां गल्‍ला बागै।<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />कई मणछ फिरा आपणैं बारै इहअ खोज़दै कि तिंयां आसा शुचै-पाक्‍कै,</para>
  <para style="q" vid="PRO 20:6">पर इहअ थोघ कुंण सका लाई कि कुंण आसा शुचअ-पाक्‍कअ?<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />तिंयां लान्हैं आसा भागा आल़ै,</para>
  <para style="q" vid="PRO 20:7">ज़सरै ईज-बाब मानदार आसा अर ज़ुंण भलअ करा।<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />राज़अ ज़ेभै नसाफ करदअ राज़गाद्दी दी बेठा,</para>
  <para style="q" vid="PRO 20:8">सह हेरा भाल़ी अर तेऊ का जाआ बूराईओ थोघ लागी।<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />इहअ निं कोहै बोली सकदअ,</para>
  <para style="q" vid="PRO 20:9">“हुंह सोठा भलअ ई अर हुंह आसा शुचअ अर पापा का छ़ुटी गअ द!”<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />बाट अर तराकल़ी करै हेर-फेर करनी,</para>
  <para style="q" vid="PRO 20:10">इना दूई गल्‍ला का करा बिधाता नफरत।<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />लान्हैं भलै आसा कि बूरै,</para>
  <para style="q" vid="PRO 20:11">भलै-बूरै बछ़ैणियां तिन्‍नें कामां का।<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />बिधाता आसा हाम्हां शुणना लै कान अर</para>
  <para style="q" vid="PRO 20:12">भाल़णा लै आछी दैनी दी।<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />ज़ुंण निंजा लै खास्सअ झ़ूरा, तेऊ पल़ा दाल़ज,</para>
  <para style="q" vid="PRO 20:13">ज़ुंण कामां दी रहा लागी, तेऊ निं खाणां लै निऊल़ हंदी।<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />मोलै लंदी बारी बोला गाहक सदा कि एतो मोल गअ धख खास्सअ,</para>
  <para style="q" vid="PRO 20:14">पर ज़ांऊं च़ीज़ लई डेऊई गअ, तेखअ करा तेते बड़ैई।<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />अक्ली आल़ै बोल हआ किम्मती रत्न,</para>
  <para style="q" vid="PRO 20:15">सुन्‍नैं-च़ंदी का बी खास्सै किम्मती।<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />ज़ुंण मणछ पाखलै मणछे ज़मानती लआ,</para>
  <para style="q" vid="PRO 20:16">तेऊ लागा किज़ै नां किज़ै च़ीज़ बांधै ज़रूर लणी।<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />छ़ल़-कपट करी खटी दी रोटी ज़ाण्हिंआं मिठी,</para>
  <para style="q" vid="PRO 20:17">पर बादा हआ तिंयां खाखा भर्हुई दी शाकरी ज़ेही।<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />ज़ै तम्हैं राम्बल़ी सलाह लए, तै हणैं तम्हैं सफल,</para>
  <para style="q" vid="PRO 20:18">जोग करी अर बच़ार किऐ बाझ़ी निं जुधा लै डेऊणअ।<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />फुआह निं गुप्त रही सकदी,</para>
  <para style="q" vid="PRO 20:19">तैही रहणअ गप्पा मारनै आल़ै मणछा का दूर ई।<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />ज़ुंण आपणैं ईजा-बाबा लै फिटक दैआ,</para>
  <para style="q" vid="PRO 20:20">तिन्‍नों लाटू जाआ छ़ेक्‍कै हिठी, संघा हआ तिन्‍नां लै बी न्हैरअ।<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />ज़ुंण ज़ैदात छ़ेक्‍कै जाआ भेटी,</para>
  <para style="q" vid="PRO 20:21">तेथ निं खिरी किछ़ै बर्गत हंदी।<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />बूराईओ बदल़अ निं आप्पै लणअ,</para>
  <para style="q" vid="PRO 20:22">बिधाता दी लागा भरोस्सअ डाहणअ, भाल़ा आप्पै।<verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />बाट अर तराकल़ी करै हेर-फेर करनी,</para>
  <para style="q" vid="PRO 20:23">इना दूई गल्‍ला का करा बिधाता नफरत।<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />बिधाता खोज़ा हाम्हां का आप्पै बात,</para>
  <para style="q" vid="PRO 20:24">तै किहअ करै सका मणछा का थोघ लागी कि केस्सी डेऊणअ?<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />बिधाता लै मानत मनी निं तम्हैं मणछ आप्पू लै फाही पाई,</para>
  <para style="q" vid="PRO 20:25">तेता का आजी लणअ राम्बल़ै करै बच़ार करी।<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />ज़हा राज़ै अक्ल हुई, सह भाल़ा राम्बल़ै करै कि कुंण आसा बूरअ,</para>
  <para style="q" vid="PRO 20:26">तेखअ निं सह सज़ा दैणा लै झींण करदअ।<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />बिधाता आसा हाम्हां मणछा लै मन्‍न अर सोर दैनी दी,</para>
  <para style="q" vid="PRO 20:27">तेता करै जाआ म्हारी गुप्त गल्‍लो थोघ लागी।<verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />ज़ुंण राज़अ मानदारी अर सत्ता दी रही राज़ करा,</para>
  <para style="q" vid="PRO 20:28">तेऊओ राज़ रहा सदा बणी।<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />खारकै मणछे बड़ैई हआ तेऊए बला का,</para>
  <para style="q" vid="PRO 20:29">पर प्रोढै मणछे शोभा हआ तेऊए पल़ू करै।<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />ज़खम पल़ी हआ बूराई दूर</para>
  <para style="q" vid="PRO 20:30">अर मार खाई हआ दिल साफ।<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="s">सोभै गल्‍ला करा बिधाता आप्पै</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />बिधाता फरेऊआ राज़ैओ मन्‍न</para>
  <para style="q" vid="PRO 21:1">ज़िहअ सह च़ाहा तिहअ गाडा-नाल़ी ज़िहअ ओर्ही-पोर्ही।<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />मणछ सका आप्पू लै इहअ सोठी कि ज़ुंण तेऊ किअ सह आसा ठीक,</para>
  <para style="q" vid="PRO 21:2">पर बिधाता का हआ थोघ कि तेऊए दिलै किज़ै आसा।<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />काम करनअ सह ज़ुंण ठीक अर भलअ आसा,</para>
  <para style="q" vid="PRO 21:3">तेता करै हआ बिधाता बल़ीदाना का बी खास्सअ राज्ज़ी।<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />कदुष्ट मणछ हआ तिन्‍नें घमंड अर रोभे बशै पल़ै दै,</para>
  <para style="q" vid="PRO 21:4">इहअ ई हआ पाप।<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />ज़ै तम्हैं मैन्थ करना लै थही करै बच़ार करे, तम्हां का हणीं सोभै गल्‍ला बतेर्ही,</para>
  <para style="q" vid="PRO 21:5">पर ज़ुंण पुंआरा ज़िहअ काम करे तेऊ पल़ा निऊल़।<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />ज़ुंण माया छ़ल़-कपट करी खटी, सह उडा धूँईं ज़िहअ,</para>
  <para style="q" vid="PRO 21:6">इहअ करनअ हआ आपणैं ज़िऊआ लै ज़ज़ाल़।<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />कदुष्ट मणछ हआ आपणैं ई उपद्रभा करै बरैबाद,</para>
  <para style="q" vid="PRO 21:7">किल्हैकि तिंयां भलअ करनअ ई च़ाहंदै।<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />दोशी मणछ हांढा बूरी बाता,</para>
  <para style="q" vid="PRO 21:8">नर्दोश मणछ करा भलै काम।<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />कबल्‍ली झ़घल़दी बेटल़ी संघै बडै घअरा भितरी रहणैं का आसा</para>
  <para style="q" vid="PRO 21:9">काशे कशूहल़ी दी रहणअ बित्तअ।<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />कदुष्ट मणछा हआ किज़ै नां किज़ै कबध खटणें लागी दी,</para>
  <para style="q" vid="PRO 21:10">तिंयां निं तेता लै आपणीं साथी-संघी लै बी झींण करदै।<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />ज़ांऊं सुहांगा करनै आल़ै मणछा सज़ा भेटा, तेता भाल़ी एछा ऐडै बी समझ़,</para>
  <para style="q" vid="PRO 21:11">अक्ली आल़ै मणछा एछा नैरी समझ़ाऊई करै होर बी अक्ल।<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />बिधाता आसा शुचअ अर धर्मीं, तेऊ का हआ थोघ कि कदुष्ट मणछ किज़ै करा</para>
  <para style="q" vid="PRO 21:12">अर सह निं तिन्‍नां सज़ा दैणैं बाझ़ी हटदअ।<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />ज़ुंण रैनै-गरीबे लेर-पकार शूणीं मज़त नांईं करदअ,</para>
  <para style="q" vid="PRO 21:13">तेऊ लै हणअ तिहअ ई ज़ेभै सह तेऊ आप्पू गरज़ पल़े।<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />ज़ै तम्हां का कुंण नराज़ होए,</para>
  <para style="q" vid="PRO 21:14">तेऊ लै लागा गुप्त भैंट दैणीं, संघा जाआ सह राज्ज़ी हई।<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />शुचअ पक्ष लई करै हआ धर्मीं मणछा खुशी,</para>
  <para style="q" vid="PRO 21:15">पर कदुष्टा का ज़ाण्हिंआं सह बरैबादी।<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />ज़ुंण मणछ सोर-समझ़ निं डाहे,</para>
  <para style="q" vid="PRO 21:16">तेऊ न्हैल़ी हआ मौत लागी दी।<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />ज़ुंण खास्सै ठाहठ-बाठा लै झ़ूरा तिन्‍नां लै पल़ा दाल़ज,</para>
  <para style="q" vid="PRO 21:17">ज़ुंण शूर-शराबा लै झ़ूरा तिंयां निं कधि सेठ हई सकदै।<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />कदुष्ट मणछा भेटणीं धर्मीं मणछे ज़ैगा सज़ा अर</para>
  <para style="q" vid="PRO 21:18">धोखै दैणैं आल़ै भेटणीं भोल़ै मणछे ज़ैगा सज़ा!<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />झ़गल़खोर अर रुश्शणै आल़ी बेटल़ी संघै रहणैं का आसा</para>
  <para style="q" vid="PRO 21:19">दूर रेगीस्तानै रहणअ भलअ।<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />अक्ली आल़अ मणछ ज़िऊआ आपणीं ज़िन्दगी ठाहठ-बाठा दी,</para>
  <para style="q" vid="PRO 21:20">पर ऐडै मणछा ज़ेतरी ढब्बै भेटा निं तेतरी हेरा तिंयां छेभी।<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />मानदार अर झणैल़ू मणछे अमर हआ खास्सी,</para>
  <para style="q" vid="PRO 21:21">इहै मणछा संघै करा होर बी राम्बल़अ बभार अर अदर।<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />अक्ली आल़अ सपाही सका</para>
  <para style="q" vid="PRO 21:22">बडै-बडै जोधै आल़ी नगरी बी कबज़अ करी।<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />ज़ै तम्हैं आफ़ता का बच़णअ च़ाहा,</para>
  <para style="q" vid="PRO 21:23">तै करनअ गल्‍ला करनै का आजी बच़ार।<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />ज़ुंण घमंड अर हंकार डाही काम करा,</para>
  <para style="q" vid="PRO 21:24">तेऊ लै बोला सोभै, “अह आसा शरेरअ।”<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />दल़िदरी मणछ करा आपणीं हत्या,</para>
  <para style="q" vid="PRO 21:25">किल्हैकि तिन्‍नां हआ कामां खटणें ज़ैंईं लागी दी।<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />कई मणछ हआ कबल्‍लै सोठदै लागै दै, “मुखा लोल़ी ती एही, एही गल्‍ला हुई!”</para>
  <para style="q" vid="PRO 21:26">पर धर्मीं मणछ रहा खुल्है हाथै बांडदअ लागी।<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />बिधाता करा कदुष्ट मणछे बल़ीदाना लै बी नफरत,</para>
  <para style="q" vid="PRO 21:27">खासकर तेभै, ज़ेभै तिंयां होरीओ बूरअ करना लै कारी बाहा।<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />झ़ुठी शाजत दैणैं आल़अ करनअ दूर,</para>
  <para style="q" vid="PRO 21:28">पर असली शाजते गल्‍ला हेरनी शूणीं।<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />कदुष्ट मणछ करा आपणीं बाता डेऊणे हठ,</para>
  <para style="q" vid="PRO 21:29">पर धर्मीं मणछ करा आजू गंईं डाहणैं का आजी बच़ार।<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />च़ाऐ तम्हैं केतरै बी अक्ली आल़ै, छ़ल़ैघ अर समझ़कार किल्है निं होए,</para>
  <para style="q" vid="PRO 21:30">पर ईंयां गल्‍ला निं तेभै किछ़ू कामें हंदी ज़ै बिधाता तम्हां लै पिठ होए फरेऊई दी!<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />जुधा लै बधिया का बधिया घोल़ै आल़ी सैना किल्है निं होए,</para>
  <para style="q" vid="PRO 21:31">पर ज़ीत भेटा सदा बिधाता करै।<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="s">भलै नाओं मोल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />भलअ नाअं अर इज़त हआ</para>
  <para style="q" vid="PRO 22:1">सुन्‍नैं-च़ंदी का बी खास्सअ किम्मती।<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />एकी गल्‍ला लै आसा साहुकार अर गरीब बराबर कि</para>
  <para style="q" vid="PRO 22:2">तिन्‍नां दुही बणाणैं आल़अ आसा बिधाता।<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />ज़हा सोर-समझ़ हुई सह मणछ हेरा ज़ाणीं कि आफ़त च़ाल्‍ली पल़ी अर सह जाआ चतैन हई अर सह हटा पिछ़ू,</para>
  <para style="q" vid="PRO 22:3">पर ऐडअ मणछ डेओआ आजू तैहा ई आफ़ता जैंदरी तेते सज़ा भुगतदअ।<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />मानदारी दी रहणअ बिधाते डरा हेठै,</para>
  <para style="q" vid="PRO 22:4">बिधाता दैणीं तम्हां लै लाम्मी अमर, माया अर अदर पुआज़अ।<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />कदुष्ट हांढा तैहा बाता ज़ेथ कांडै अर ज़ुंण ज़िऊआ लै ज़ज़ाल हआ,</para>
  <para style="q" vid="PRO 22:5">ज़ै तम्हैं आपणीं ज़िन्दगी लै झ़ूरा, तै रहणअ एही बाता का दूर।<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />आपणैं लान्हैं लै डाहणीं होछ़ी उझै बुध खोज़ी कि तिन्‍नां केही ज़िन्दगी लोल़ी ज़िऊई,</para>
  <para style="q" vid="PRO 22:6">सह रहणीं तिन्‍नां सारी अमरा आद।<verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />गरीब मणछ हआ सेठो गलाम,</para>
  <para style="q" vid="PRO 22:7">ऋण काढणैं आल़अ हआ साहुकारो गलाम।<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />ज़ुंण बूराई बऊआ तेऊ भेटा लऊंणा लै आफ़त,</para>
  <para style="q" vid="PRO 22:8">तेखअ हआ तिन्‍नें रोश्शे मुसल़ी खतम।<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />खुल्है दिलै दैणअ गरीबा लै नाज़ पाणीं बांडी,</para>
  <para style="q" vid="PRO 22:9">इहै मणछा लै दैआ बिधाता आप्पै बर्गत।<verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />हंकारी मणछा का छ़ड़ैऊ आपणअ पिछ़अ, तै हणअ झ़गल़अ,</para>
  <para style="q" vid="PRO 22:10">हठ अर सुहांग करनै खतम।<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />ज़सरअ दिल शुचअ आसा अर मोहणैं आल़ी गल्‍ला ज़ाणा करी,</para>
  <para style="q" vid="PRO 22:11">तेऊ संघै डाहा राज़अ बी संगत।<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />ज़हा सुंबल़ी सोर हुई, बिधाता करा तिन्‍नें फाज़त,</para>
  <para style="q" vid="PRO 22:12">पर शल़ैघी अर विश्वास घात करनै आल़ै मणछे सोठ निं सह सफल दैंदअ हणैं।<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />ज़ैऊंकर मणछ काढा घअरै पल़ी रहणा लै भान्‍नअ अर सह बोला इहअ,</para>
  <para style="q" vid="PRO 22:13">“ज़ै हुंह बागै डेऊए, तेथ सका मुंह सिह खाई!”<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />कंज़री बेटल़ीए बोल हआ डुघी खाई ज़िहै,</para>
  <para style="q" vid="PRO 22:14">तेथ पल़ा सह ई मणछ ज़हा का बिधाता नराज़ होए।<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />लान्हैं हआ सोभै ऐडै ई,</para>
  <para style="q" vid="PRO 22:15">पर नैरी-समझ़ाऊई करै जाआ तिंयां समझ़ी कि किहअ बभार लागा करनअ।<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />आपणैं नफै लै गरीब ठगी अर सेठा लै भैंट दैई,</para>
  <para style="q" vid="PRO 22:16">इना दुही गल्‍ला करै हणैं तम्हैं आप्पू ई एक धैल़ै दाल़जी।<verse eid="PRO 22:16" /></para>
  <para style="s">तिह सैणीं गल्‍ला</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />अक्ली आल़ै मणछै आसा ईंयां सैणीं गल्‍ला खोज़ी दी,</para>
  <para style="q" vid="PRO 22:17">तेते शिक्षा लाई मंऐं तम्हां लै दैई, एता शूणैं धैन दैई।<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />ज़ै तम्हैं इना गल्‍ला आपणैं दिलै डाहे अर इना होरी का बी खोज़े,</para>
  <para style="q" vid="PRO 22:18">सह हणीं दिल खुश करनै आल़ी गल्‍ल।<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />हुंह च़ाहा इहअ कि तम्हां लोल़ी बिधाता दी होर बी खास्सअ भरोस्सअ हुअ,</para>
  <para style="q" vid="PRO 22:19">तैही लाई आझ़ मंऐं तम्हां का ईंयां सैणीं गल्‍ला डाही खोज़ी।<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />हुंह आसा खास्सै धैल़ै ओर्ही थारी भलाईए गल्‍ला लिखदअ लागअ द,</para>
  <para style="q" vid="PRO 22:20">मंऐं लिखी तिह एही सैणीं गल्‍ला, ज़ेता का तम्हां राम्बल़ी सलाह भेटी सके।<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />इहअ करै लागणअ तम्हां का थोघ कि असली दी सत्त किज़ै आसा,</para>
  <para style="q" vid="PRO 22:21">तेखअ सका तम्हैं तिन्‍नां सेटा लै राम्बल़अ ज़बाब निंईं ज़ुंणी तम्हैं छ़ाडै दै आसा।<verse eid="PRO 22:21" /></para>
  <para style="s2">1</para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />इहअ भाल़ी निं गरीबा लै ऐब करी कि सह आसा गरीब,</para>
  <para style="q" vid="PRO 22:22">अर ज़सरी मज़त करदअ कोहै निं होए, दालता दी निं तेऊओ नसाफ मारी।<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />किल्हैकि तिन्‍नों पक्ष लणैं आल़अ हणअ बिधाता आप्पै,</para>
  <para style="q" vid="PRO 22:23">अर तेखअ ज़ुंण तिन्‍नां मारने धमकी दैनी, बिधाता निं तिन्‍नां मारनै बाझ़ी छ़ाडी गअ।<verse eid="PRO 22:23" /></para>
  <para style="s2">2</para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />रोश्शा आल़ै मणछे संगत निं करी,</para>
  <para style="q" vid="PRO 22:24">ज़ुंण धखी प्राचदअ शाचा।<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />इहअ निं हआ कि तेऊ का तूह बी इहअ ई शिखल़े</para>
  <para style="q" vid="PRO 22:25">अर तेरी ज़िन्दगी बी हणीं फाही।<verse eid="PRO 22:25" /></para>
  <para style="s2">3</para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />होरीए ऋणा भरने ज़मानती निं लई।<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />बादा का ज़ै सह ऋण नांईं भर्हुअ,</para>
  <para style="q" vid="PRO 22:27">साहुकारा निंणअ ताह हेठा का तेरअ च़ैन बी झाल़ी।<verse eid="PRO 22:27" /></para>
  <para style="s2">4</para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />सिऊंआं दी दादा-बाबा ओर्ही ज़ुंण ओडै आसा लागै दै,</para>
  <para style="q" vid="PRO 22:28">तिंयां निं ओर्ही-पोर्ही सकैऊंणै।<verse eid="PRO 22:28" /></para>
  <para style="s2">5</para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />ज़ुंण मणछ कामां-काज़ा लै सज़ाण अर छ़ल़ैघ आसा,</para>
  <para style="q" vid="PRO 22:29">सह करा राज़ै सेटा काम,</para>
  <para style="q" vid="PRO 22:29">इहअ मणछ निं गलाम हंदअ।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">6</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />ज़ै केभै तम्हैं राज़ै संघै रोटी खांदै बेशे,</para>
  <para style="q" vid="PRO 23:1">तेभै डाहणअ धैन कि तम्हां संघै कुंण आसा बेठअ द।<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />ज़ै तम्हैं खास्सअ खाणेंओ भैस्स बी किल्है निं होए,</para>
  <para style="q" vid="PRO 23:2">पर तिधी करनअ धख सबर।<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />तिन्‍नें भांती-भांतीए भोज़नो मांण निं करी,</para>
  <para style="q" vid="PRO 23:3">हई सका कि तिंयां ताह ई भाल़ै होए लागै दै कि अह किहअ करा!<verse eid="PRO 23:3" /></para>
  <para style="s2">7</para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />मैन्थ निं सेठ हणां लै करनी,</para>
  <para style="q" vid="PRO 23:4">अक्ली करै डाहणअ सबर।<verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />थारी माया सका एकी घल़ी भितरी खतम हई,</para>
  <para style="q" vid="PRO 23:5">ढब्बै डेओआ हेरा-हेरी मुक्षरलै ज़िहै डैअ बाही दूर।<verse eid="PRO 23:5" /></para>
  <para style="s2">8</para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />कमिन्‍नै मणछे घअरै निं छ़ांदअ भेटी बी खांदअ डेऊई,</para>
  <para style="q" vid="PRO 23:6">च़ाऐ तेऊ बधिया का बधिया भोज़ किल्है निं होए बणाअं द, तेतो मांण निं करी।<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />किल्हैकि इहअ मणछ बोला खाखा का, “होर खाआ, थोल़अ ज़िहअ, खाआ होर,”</para>
  <para style="q" vid="PRO 23:7">पर असली दी हआ सह रोटी गणदअ लागअ द कि केतरी खास्सी लाई खाई।<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />तम्हां लागणअ हेरे बादा का सह खाअ पिअ पोर्ही हुकरनअ अर</para>
  <para style="q" vid="PRO 23:8">थारै मिठै बोल बी हणैं बृथा।<verse eid="PRO 23:8" /></para>
  <para style="s2">9</para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />ऐडै मणछा लै बोली निं बैण बृथा पाई,</para>
  <para style="q" vid="PRO 23:9">तिन्‍नां करनअ तेरी अक्लीए सलाहो सुहांग ई।<verse eid="PRO 23:9" /></para>
  <para style="s2">10</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />सिऊंआं दी लागै दै पराणैं ओडै निं ओर्ही-पोर्ही सकैऊई</para>
  <para style="q" vid="PRO 23:10">अर नां छ़ुटै-मुक्‍कै दै लान्हें खेचा गिम्मी।<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />किल्हैकि तिन्‍नां छ़ड़ैऊंणैं आल़अ आसा बिधाता आप्पै ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="PRO 23:11">सह लल़ा तिन्‍नों मकदमअ आप्पै अर तम्हैं निं तेऊ का ज़िती सकदै।<verse eid="PRO 23:11" /></para>
  <para style="s2">11</para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />आपणैं गूरूए गल्‍ला दी दैणअ धैन,</para>
  <para style="q" vid="PRO 23:12">तेऊ का लणअ ज़ेतरअ हई सके तेतरअ खास्सअ ज्ञैन।<verse eid="PRO 23:12" /></para>
  <para style="s2">12</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />लान्हैं नैरना लै निं कसर छ़ाडी।</para>
  <para style="q" vid="PRO 23:13">तिंयां निं नैरी-समझ़ाऊई करै मरी च़ाल्‍लै,<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />छिहुंटी बाही सका तम्हैं तिन्‍नें</para>
  <para style="q" vid="PRO 23:14">ज़िन्दगी बच़ाऊई।<verse eid="PRO 23:14" /></para>
  <para style="s2">13</para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />लान्हैंओ, ज़ै तम्हैं सोर-समझ़ करे,</para>
  <para style="q" vid="PRO 23:15">तै हणीं मुंह खुशी।<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />मुंह हणअ तैहा गल्‍लो घमंड,</para>
  <para style="q" vid="PRO 23:16">ज़ै तम्हैं अक्ली आल़ी गल्‍ला करे।<verse eid="PRO 23:16" /></para>
  <para style="s2">14</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />पापी मणछो मांण निं करी,</para>
  <para style="q" vid="PRO 23:17">हर बगत रहणअ आपणीं ज़िन्दगी बिधाते डरा हेठै।<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />एतो पुआज़अ जाणअ तम्हां आजू भेटी</para>
  <para style="q" vid="PRO 23:18">अर तै हेरनी बिधाता थारी आशा पूरी करी।<verse eid="PRO 23:18" /></para>
  <para style="s2">15</para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />लान्हैंओ, मेरी गल्‍ला शूणां, अक्ल करा,</para>
  <para style="q" vid="PRO 23:19">आप्पू डाहणअ भली ज़िन्दगी ज़िऊंणेंओ खैल।<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />नां तम्हैं शूरी-शराबीए संगत करी</para>
  <para style="q" vid="PRO 23:20">अर नां तिन्‍नें ज़ुंण शिखा खाणैं पिछ़ू मरी एछा।<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />किल्हैकि शूरी-शराबी अर छ़ाक्‍कू मणछा पल़ा दाल़ज।</para>
  <para style="q" vid="PRO 23:21">ज़ै तम्हैं बी ज़ै सिधै खांदै अर सुत्ती रहे, तम्हां लागणै घेरी बी लैऊल़ै बान्हणैं।<verse eid="PRO 23:21" /></para>
  <para style="s2">16</para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />आपणैं बाबे गल्‍ला दी दैणअ धैन, ज़ै सह निं हंदअ, तै निं तम्हैं बी हणैं तै,</para>
  <para style="q" vid="PRO 23:22">ज़ेभै थारी ईज प्रोढी होए, तेभै करनी तेसे होर बी खास्सी कदर।<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />सत्त, अक्ल, शिक्षा अर सुंबल़ी सोर, एता लै करनअ खर्च़ बी,</para>
  <para style="q" vid="PRO 23:23">ईंयां आसा बेच़णां लै बी खास्सी किम्मती।<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />धर्मीं मणछे ईजा-बाबा भेटा खुशी,</para>
  <para style="q" vid="PRO 23:24">ज़ै लान्हैं अक्ली आल़ै हुऐ, तेता पोर्ही निं घमंड करना लै किज़ै होर आथी।<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />थारै ईजा-बाबा लोल़ी तम्हां प्रैंदै घमंड हुअ,</para>
  <para style="q" vid="PRO 23:25">खासकर लोल़ी अह खुशी थारी ईजा हुई।<verse eid="PRO 23:25" /></para>
  <para style="s2">17</para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />लान्हैंओ, आपणअ धैन डाहै,</para>
  <para style="q" vid="PRO 23:26">थारअ च़ाल-च़लण लोल़ी मुंह ज़िहअ हुअ।<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />कंज़री अर पराई बेटल़ी हआ डुघै कुहै ज़िहअ</para>
  <para style="q" vid="PRO 23:27">ज़िऊआ लै ज़ज़ाल़ ज़ेथ पल़ी कुंण उझै निं निखल़ी सकदअ।<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />तिंयां हआ ताखुई रही दी अर च़ोरा ज़ेही न्हैल़ी लागी दी,</para>
  <para style="q" vid="PRO 23:28">ताकि तिंयां मणछा मांझ़ै खास्सै मर्धा विश्वास घाती बणांए।<verse eid="PRO 23:28" /></para>
  <para style="s2">18</para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />कहा आसा कबल्‍ली आफ़त पल़ी दी?</para>
  <para style="q" vid="PRO 23:29">कुंण आसा हठल़दअ अर झ़घल़दअ लागा द?</para>
  <para style="q" vid="PRO 23:29">कहा आसा खाढ-खोत्तै पल़ै दै?</para>
  <para style="q" vid="PRO 23:29">कसरी आछी आसा लाल हुई दी?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />ईंयां आसा तिंयां ज़ुंण आधा राची तैणीं</para>
  <para style="q" vid="PRO 23:30">शूर-शराबा झुटदै रहा लागी।<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />शराबा भाल़ै निं लागी कि अह भाल़ केही लाल आसा,</para>
  <para style="q" vid="PRO 23:31">गलासा दी भाल़ अह केही च़मक दैआ अर एते भाल़ केही आसा लागी दी।<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />पर तेतो थोघ लागा दुजै धैल़ै दोत्ती कि</para>
  <para style="q" vid="PRO 23:32">तम्हां लै आसा ज़िहअ शपैल़ै डांग बाहअ द!<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />आछी का हणीं थारी नुआहरी गल्‍ला शुझदी लागी दी,</para>
  <para style="q" vid="PRO 23:33">नां तम्हैं राम्बल़अ सोठी सकदै अर नां थारै राम्बल़ै करै गल्‍ला च़ाल्‍ली कर्हुई।<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />तम्हां का ज़ाण्हनअ इहअ कि तम्हैं आसा समुंदरै ज़हाज़े च़ुंडी सुत्ती</para>
  <para style="q" vid="PRO 23:34">राश्शी दी झ़ुलदै लागै दै।<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />तम्हां बोल़णअ तेखअ इहअ, “मुल्है बाही कुंणी,</para>
  <para style="q" vid="PRO 23:35">पर मुखा निं तेतो थोघ ई लागअ!</para>
  <para style="q" vid="PRO 23:35">हुंह च़िक्‍कअ कुंणी! पर मुंह निं आद रही!</para>
  <para style="q" vid="PRO 23:35">राच केभै च़ाल्‍ली भैई, मुंह झुटणीं ती होर शराब?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">19</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />कदुष्ट मणछे ज़ीद-मिश निं करी</para>
  <para style="q" vid="PRO 24:1">तिन्‍नें साथ-संगती लै निं झ़ूरी।<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />किल्हैकि तिंयां सोठा आपणैं मन्‍नैं उपद्रभ ई,</para>
  <para style="q" vid="PRO 24:2">इने खाखा का निखल़ै बैण दैआ दुजै लै दुख ई।<verse eid="PRO 24:2" /></para>
  <para style="s2">20</para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />अक्ली आल़अ सज़ाण मणछ बणाआं घअर</para>
  <para style="q" vid="PRO 24:3">अर सोर-समझ़ डाही रहा सह आजू टेक्‍की।<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />ज़िधी अक्ल हआ, तेऊए घअरै भर्हिया भांती-भांतीए किम्मती अर</para>
  <para style="q" vid="PRO 24:4">दिला लोभदी च़िज़ा करै खज़ानै।<verse eid="PRO 24:4" /></para>
  <para style="s2">21</para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />जोधै हणैं का भली आसा अक्ल,</para>
  <para style="q" vid="PRO 24:5">ज्ञैन हआ ज़ोर-ज़ाहणा का बी खास्सअ ज़रूरी।<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />तैही लागा जुधा का आजी राम्बल़ी तरकीब बणाणीं,</para>
  <para style="q" vid="PRO 24:6">ज़ेतरी राम्बल़ी सलाह होए, जुधा ज़ितणें आशा हआ तेतरी खास्सी।<verse eid="PRO 24:6" /></para>
  <para style="s2">22</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />अक्ली सेटा निं ऐडअ मणछ पुजी सकदअ,</para>
  <para style="q" vid="PRO 24:7">नां तेखअ सह सभा दी ज़रूरी गल्‍ला लै सलाह दैई सकदअ।<verse eid="PRO 24:7" /></para>
  <para style="s2">23</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />ज़ुंण आपणैं मन्‍नैं भलअ सोठदअ ई निं,</para>
  <para style="q" vid="PRO 24:8">तेऊ लै बोला लोग कदुष्ट ई।<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />ऐडी गल्‍ल हआ सोठणीं ई पाप।</para>
  <para style="q" vid="PRO 24:9">ज़ुंण मणछ कबल्‍लअ होरीओ सुहांग करा, तेऊ लै करा लोग नफरत।<verse eid="PRO 24:9" /></para>
  <para style="s2">24</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />ज़ै तम्हैं आफ़ते पलका हैअ चोल़े,</para>
  <para style="q" vid="PRO 24:10">तै आसा तम्हैं भितरा का खास्सै दुबल़ै।<verse eid="PRO 24:10" /></para>
  <para style="s2">25</para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />तिन्‍नां बच़ाऊंणै का निं पिछ़ू हटी,</para>
  <para style="q" vid="PRO 24:11">ज़ुंण थोघै बाझ़ी आसा लाऐ दै मारी पाई।<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />तेता लै निं इहअ सोठी, “मुखा निं एतो थोघै!”</para>
  <para style="q" vid="PRO 24:12">पर बिधाता का हआ सोभिए दिलो थोघ,</para>
  <para style="q" vid="PRO 24:12">सह आसा तम्हां बी भाल़अ लागअ द अर</para>
  <para style="q" vid="PRO 24:12">सह दैआ मणछे कर्मे साबै तिन्‍नां लै फल।<verse eid="PRO 24:12" /></para>
  <para style="s2">26</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />लान्हैंओ, मखीरा लागा खांदै, सह हआ बधिया,</para>
  <para style="q" vid="PRO 24:13">तेते काशणीं च़ाबणें बी लागा खाखा मिठ।<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />तेही ई आसा अक्ल बी थारी आत्मां लै मिठी।</para>
  <para style="q" vid="PRO 24:14">ज़ै तम्हां अक्ल भेटे, तै हणीं आजू थारी प्रैश्शी ज़िन्दगी</para>
  <para style="q" vid="PRO 24:14">अर नां थारी आशा चुटणीं।<verse eid="PRO 24:14" /></para>
  <para style="s2">27</para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />कदुष्ट मणछा ज़िहै निं हई, ज़ुंण धर्मीं मणछे घअरै</para>
  <para style="q" vid="PRO 24:15">उज़र करना लै हआ ताखुई रहै दै।<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />धर्मीं मणछ ज़ै साता बारी बी आफ़ता दी पल़े, सह जाआ तेता का बच़ी निखल़ी,</para>
  <para style="q" vid="PRO 24:16">पर ज़ांऊं कदुष्ट मणछा लै आफ़त पल़ा, सह निं खल़ै उझ़णै जोगी रहंदअ।<verse eid="PRO 24:16" /></para>
  <para style="s2">28</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />पर ज़ै थारै दुशमणा लै बी आफ़त पल़े तेता लै निं खुश हणअ,</para>
  <para style="q" vid="PRO 24:17">नां तेभै खुशी मनाऊंईं ज़ेभै तिन्‍नां ठोहल़ लागा!<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />इहअ भाल़ी हणअ बिधाता तम्हां लै बी नराज़</para>
  <para style="q" vid="PRO 24:18">अर थारै दुशमणा का बिधातो रोश्श बी फिरनअ पिछ़ू।<verse eid="PRO 24:18" /></para>
  <para style="s2">29</para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />बूराई काम करनै आल़ै निं दैई आप्पू लै फिकर पाणै अर</para>
  <para style="q" vid="PRO 24:19">नां तिन्‍नां करै आपणैं दिलै ज़ीद-मिश डाही।<verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />किल्हैकि कदुष्ट मणछा निं खिरी किछ़ै फल़ भेटणअ,</para>
  <para style="q" vid="PRO 24:20">तिंयां आसा इहै लाटू ज़िहै ज़ुंण पोर्ही हिठणअ।<verse eid="PRO 24:20" /></para>
  <para style="s2">30</para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />लान्हैंओ, तम्हैं रहणअ बिधाते डरा हेठै अर राज़ैओ करनअ अदर,</para>
  <para style="q" vid="PRO 24:21">ज़ुंण इना दुहीओ बरोध करा, तिन्‍नां नेल़ निं खल़ै बी हई।<verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />इहै मणछ हणैं घल़ी-पला भितरी खतम!</para>
  <para style="q" vid="PRO 24:22">ऐहा गल्‍लो थोघ निं कोही का हंदअ कि</para>
  <para style="q" vid="PRO 24:22">बिधाता अर राज़ै का ज़ुंण आफ़त पल़णीं सह केही होए!<verse eid="PRO 24:22" /></para>
  <para style="s">अक्ली आल़ै मणछे होर सैणीं गल्‍ला</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />अक्ली आल़ै मणछै आसा एही सैणीं गल्‍ला खोज़ी दी:</para>
  <para style="q" vid="PRO 24:23">पांच़ी करना लै भेदभाब करनअ निं ठीक हंदअ।<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />ज़ुंण कदुष्ट मणछा लै खुल्है आम नर्दोश खोज़ा,</para>
  <para style="q" vid="PRO 24:24">इहै मणछा लागणअ फिटक अर लोग बी करा इहै का नफरत।<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />पर ज़ुंण पांच़ कदुष्ट मणछा लै सज़ा दैआ, तेऊओ हणअ भलअ</para>
  <para style="q" vid="PRO 24:25">अर तिन्‍नां लै एछा खास्सी बर्गत।<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />मुंहैं ज़बाब दैणअ हआ</para>
  <para style="q" vid="PRO 24:26">असली साथीओ नछ़ैण।<verse eid="PRO 24:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />आपणअ घअर बणाणैं का आजी लणी</para>
  <para style="q" vid="PRO 24:27">डुघी आथरी खण्हीं पाक्‍की तल़ी बणाईं।<verse eid="PRO 24:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />थोघै बाझ़ी निं होरीए शाजत दैई अर</para>
  <para style="q" vid="PRO 24:28">नां तिन्‍नें बारै कहा होरी शगरेऊई।<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />तम्हैं निं इहअ बोली, “ज़िहअ तिन्‍नैं मुल्है किअ, मुंह बी करनअ तिन्‍नां लै तिहअ ई!</para>
  <para style="q" vid="PRO 24:29">मुंह लणअ तिन्‍नां का बदल़अ लई!”<verse eid="PRO 24:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />हुंह डेऊअ ऐडै दाल़जी मणछे खेचै दाखे बागा बाती,</para>
  <para style="q" vid="PRO 24:30">ज़ुंण कामां लै ज़ैंईं करा,<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />हुंह लागअ तेऊ खेचा भाल़अ कि तेथ आसा कांडै-रिंडै भर्हुऐ दै,</para>
  <para style="q" vid="PRO 24:31">तेथ आसा सारै दी कुंगशी भर्हुई दी अर</para>
  <para style="q" vid="PRO 24:31">बाल़ा लै च़िणीं दी दुआल बी आसा ढूल़ी दी।<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />हुंह लागअ तेता भाल़अ अर आपणैं दिलै सोठदअ</para>
  <para style="q" vid="PRO 24:32">अर तेता का शिखल़ी मंऐं एक गल्‍ल:<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />थोल़ी घल़ी लऊं होर सुत्ती, एक सताअ लणअ त निंजो होर दैई,</para>
  <para style="q" vid="PRO 24:33">अज़ी लणअ हिक्‍का प्रैंदै हाथ दोछ़ी सुत्ती!<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />इहै मणछा लै एछा गरीबी छ़ूरी पाई च़ोरा ज़ेही</para>
  <para style="q" vid="PRO 24:34">संघा निं पिछ़ू किछ़ै छ़ुटणअ।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">राज़ै सुलैमानै खोज़ी दी सैणीं गल्‍ला</para>
  <para style="m">
    <verse number="1" style="v" sid="PRO 25:1" />इधी आसा राज़ै सुलैमानै खोज़ी दी होर बी सैणीं गल्‍ला, इना गल्‍ले नकल किई ती यहूदा मुल्खे बज़ीरै हिजकिया।<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />परमेशरो अदर हआ तेऊए गुप्त गल्‍ला करै,</para>
  <para style="q" vid="PRO 25:2">पर राज़े ज़ै-ज़ैकार हआ तै, ज़ै तेऊ गुप्त गल्‍लो थोघ लाअ।<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />राज़े मन्‍नों थोघ निं कोही का हंदअ, तेऊए सोठ हआ म्हारी समझ़ा का बागै,</para>
  <para style="q" vid="PRO 25:3">ज़िहअ सरगो च़ूल़ अर समुंदरो थह कोही निं लोल़अ।<verse eid="PRO 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />किम्मती च़ीज़ बणाणैं का आजी लागा</para>
  <para style="q" vid="PRO 25:4">सनारा च़ंदी धोई लणी।<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />ज़ै राज़ै सेटा का बूरी सलाह खोज़णैं आल़ै बज़ीर दूर होए,</para>
  <para style="q" vid="PRO 25:5">तै हआ तेऊओ राज़ धर्मीं।<verse eid="PRO 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />ज़ेभै तम्हैं राज़ै सेटा खल़ै होए,</para>
  <para style="q" vid="PRO 25:6">तेऊ सेटा निं आपणीं शमाकी करी कि तम्हैं केतरै खास आसा!<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />भलअ हणअ इहअ कि सह आप्पै तम्हां शादे अर इज़ती करै बडी ज़ैगा बशैल़े,</para>
  <para style="q" vid="PRO 25:7">आप्पै आजू बेशी ज़ै तैहा ज़ैगा कहा ताखा बी ज़ादै खास मणछा लै दैए।</para>
  <para style="q" vid="PRO 25:7">सह हणीं बेइज़ती आल़ी गल्‍ल।<verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />झ़गल़ै लै निं धखी का दाऊअ-दालत करनअ,</para>
  <para style="q" vid="PRO 25:8">इहअ निं हआ कि बादा का होर शाजत शुची गल्‍ल खोज़े</para>
  <para style="q" vid="PRO 25:8">अर पल़णअ तेखअ शर्मिंदै हणअ।<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />ज़ै तम्हां साथी-संघी मांझ़ै दूई रंगे बच़ार बी किल्है निं होए,</para>
  <para style="q" vid="PRO 25:9">तिन्‍नां गल्‍लो भेद निं पराऐ मणछा का खोज़ी।<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />इहअ करै बोल़णअ तम्हां लै होरी बी कि तम्हैं आसा धोही</para>
  <para style="q" vid="PRO 25:10">अर थारी निं आपणीं बी निं लोगा जैंदरी किछ़ै इज़त हणीं।<verse eid="PRO 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />ठीक बगती राम्बल़ी सलाह हआ</para>
  <para style="q" vid="PRO 25:11">च़ंदीए थाल़ा दी सुन्‍नें सेओआ ज़िहै।<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />सैणैं मणछे राम्बल़ी सलाह मनणी हआ</para>
  <para style="q" vid="PRO 25:12">सुन्‍नें बाल़ू का बी किम्मती।<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />ज़ै समादा पजैल़णैं आल़अ शुचअ-पाक्‍कअ हुअ,</para>
  <para style="q" vid="PRO 25:13">सह हआ ज़ेठै-शाहल़ै ठांढै पाणीं ज़िहअ।<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />ज़ुंण मणछ किज़ू च़िज़ा दैणें ज़बान दैई नांईं दैंदअ,</para>
  <para style="q" vid="PRO 25:14">सह मणछ हआ एही बागरी अर बादल़ा ज़िहअ ज़ेता का सरग निं हंदअ।<verse eid="PRO 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />सबर डाही सका रोक्‍कै हटी,</para>
  <para style="q" vid="PRO 25:15">तिहअ करै सका राज़ै-बज़ीरा बी मनैऊंईं।<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />ज़ै मखीर बी साबा का बाधू खाअ,</para>
  <para style="q" vid="PRO 25:16">तेता करै सका तम्हैं बमार हई।<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />आपणैं साथी-संघीए घअरै बी निं धैल़ डेऊणअ,</para>
  <para style="q" vid="PRO 25:17">खिरी हिछ़िआ तिंयां बी संघा लागा टवारधै।<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />होरीए बारै झ़ुठी शाजत दैणीं हआ</para>
  <para style="q" vid="PRO 25:18">तेऊ पिछ़ू तलबार पाई ठुहर्नअ,</para>
  <para style="q" vid="PRO 25:18">मुंडै घणैं बाहणीं अर</para>
  <para style="q" vid="PRO 25:18">तिछै कतीरा खबेऊणैं ज़िहअ।<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />ज़हा साथी दी भरोस्सअ निं हंदअ,</para>
  <para style="q" vid="PRO 25:19">सह हआ खरीए पलका चुटै दै दांदा अर घर्मोस्सुऐ दै खूरा ज़िहअ!<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />दुखी मणछा सेटा गिह बोल़णीं हआ</para>
  <para style="q" vid="PRO 25:20">भाज़ी दी मिल्‍ली छ़ाही पाणीं अर</para>
  <para style="q" vid="PRO 25:20">हिंऊंदै कुंण मणछ नांगै करनै ज़िहअ।<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />ज़ै थारअ दुशमण बी भुखअ होए, तेऊ का लऐ रोटी खैऊई,</para>
  <para style="q" vid="PRO 25:21">ज़ै सह नचिशअ होए, तेऊ का लणअ पाणीं पणैऊंईं।<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />किल्हैकि थारअ इहअ नरम बभार हणअ तिन्‍नें मुंडै आगीए नारा पाणै ज़िहअ<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="fq" closed="false">आगीए नारा पाणै ज़िहअ </char><char style="ft" closed="false">शर्मिंदै हणैं ज़िहअ</char></note> अर</para>
  <para style="q" vid="PRO 25:22">बिधाता बी हेरनअ तम्हां लै तेतो फल दैई।<verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />घैंचल़ करनै आल़ै मणछे मुंह घोर्हिआ रोश्शा करै</para>
  <para style="q" vid="PRO 25:23">ज़ोता बाखा एछदी बागरी ज़िहअ ज़ेता करै सरग हआ।<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />कबल्‍ली झ़घल़दी बेटल़ी संघै बडै घअरा भितरी रहणैं का आसा</para>
  <para style="q" vid="PRO 25:24">काशे कशूहल़ी दी रहणअ बित्तअ।<verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />दूरा का आअ द खुशी दैणैं आल़अ समाद हआ</para>
  <para style="q" vid="PRO 25:25">नचिशै लै ठांढै पाणीं ज़िहअ।<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />धर्मीं मणछो कदुष्टे ज़ाणैं लागणअ हआ खादल़ी गाडा</para>
  <para style="q" vid="PRO 25:26">अर कल़ुऐ पाणींए कुहै ज़िहअ।<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />ज़िहअ खास्सअ मखीर खाणअ ठीक निं हंदअ,</para>
  <para style="q" vid="PRO 25:27">तेही हआ आपणीं बड़ैई आप्पै करनी।<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />ज़ै तम्हैं आपणअ रोश्श काबू निं करी सकदै,</para>
  <para style="q" vid="PRO 25:28">तै आसा तम्हैं एही नगरी ज़िहै ज़ेता फेरे दुआल ढूल़ी दी</para>
  <para style="q" vid="PRO 25:28">अर ज़ेथ कज़ेभल़ी दुशमण सका भितरी पेशी।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="s">ऐडै निं हआ</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />ज़िहअ ज़ेठै-शाहल़ै हिंअं अर लऊंणींए बगती सरग हणअ,</para>
  <para style="q" vid="PRO 26:1">तेही ई हआ ऐडै मणछे बड़ैई करनी।<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />ज़ै तम्हैं किछ़ै निं किअ, तै डेओआ फिटक बी</para>
  <para style="q" vid="PRO 26:2">हिंऊंल़ी च़ेल्‍लीए छ़ुंढा ज़िहअ प्रैंदी पोर्ही।<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />घोल़ै सदेरना लै लागा नकेल अर गाधै लै मुर्क लाणीं</para>
  <para style="q" vid="PRO 26:3">पर ऐडै मणछे पिठी लागा डांगै बाहणीं।<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />ऐडै मणछे ऐडै सुआलो ज़बाब दैई निं</para>
  <para style="q" vid="PRO 26:4">तम्हैं बी ऐडै ज़िहै हई।<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />पर तिन्‍नां लै दैणअ ऐडे साबै ज़बाब,</para>
  <para style="q" vid="PRO 26:5">ताकि ज़ुंणी सह सुआल पुछ़अ, तेऊ का ज़ाण्हिंए कि तेऊ किई सह ऐडी गल्‍ल।<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />ज़ुंण समादा पजैल़ै कहा ऐडै मणछा छ़ाडा,</para>
  <para style="q" vid="PRO 26:6">सह गल्‍ल आसा आपणीं ज़ांघा आप्पै खराल़ै बाहणीं अर बिश खाणैं ज़ेही गल्‍ल।<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />ऐडै मणछे खाखा का सैणीं गल्‍ल हआ</para>
  <para style="q" vid="PRO 26:7">लाट्टै मणछे लाट्टी ज़ांघा ज़ेही।<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />ऐडै मणछो अदर करनअ हआ</para>
  <para style="q" vid="PRO 26:8">टोल्हा लै पात्थरै बाहणैं ज़िहअ बृथा।<note caller="-" style="x"><char style="xo" closed="false">26:8 </char><char style="xt" closed="false"><ref loc="2PE 2:20-22">2 पत. 2:20-22</ref></char></note><verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />ऐडै मणछै बोली दी सैणीं गल्‍ल हआ</para>
  <para style="q" vid="PRO 26:9">शराबी मणछे हाथै खुभै दै कांडै ज़ेही।<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />एछदै डेऊंदै अर ऐडै मणछ कामां दी लाणैं हआ इहै,</para>
  <para style="q" vid="PRO 26:10">ज़िहअ कुंण थोघै बाझ़ी पाआ सोभी कतीरा करै मारी।<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />ऐडै मणछे सह ई ऐडी गल्‍ल दुजी बारी करनी हआ तेही</para>
  <para style="q" vid="PRO 26:11">ज़िहअ कुक्‍कर आपणीं हुकरी करै तेता च़ाटदअ भिई डेओआ।<verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />ज़ुंण आपणीं सर्राफी आप्पू करा कि सह आसा छ़ल़ैघ,</para>
  <para style="q" vid="PRO 26:12">तिहै मणछा का राम्बल़अ हआ ऐडअ मणछ।<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />ज़हा मणछा ज़ैंईं हअ लागी दी,</para>
  <para style="q" vid="PRO 26:13">सह बोला इहअ, “बागै आसा सिह, बाता सका सिह भेटी!”<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />ज़ैऊंकर मणछ रहा दुआरे कूरू ज़िहअ</para>
  <para style="q" vid="PRO 26:14">पाशल़ी बधल़दअ लागी।<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />कई मणछा हआ एतरी ज़ैंईं कि</para>
  <para style="q" vid="PRO 26:15">मुंहां सेटा थाल़ू का बी निं तिंयां म्हार खाखा पाई सकदै।<verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />ज़ैऊंकर मणछ सोठा आप्पू लै इहअ कि</para>
  <para style="q" vid="PRO 26:16">सह सका सोभी का राम्बल़ी सलाह दैई।<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />बाता हांढदी होरीए झ़गल़ै मांझ़ै डेऊणअ आसा</para>
  <para style="q" vid="PRO 26:17">तेऊ मणछा ज़िहअ ज़ुंण कुक्‍करो कान घिशा।<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />ज़ुंण आपणैं साथी-संघी लै धोखअ करी बादा का इहअ बोला, “हुंह त आर्ही लागअ द।”</para>
  <para style="q" vid="PRO 26:18-19">सह आसा इहै बेगरै मणछा ज़िहअ ज़ुंण दाच-खराल़ै दैआ बाही।<verse eid="PRO 26:18-19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />ज़ै गेठै झ़ुका मुक्‍की, तै हिठा आग बी</para>
  <para style="q" vid="PRO 26:20">अर ज़िधी घैंचल़ करनै आल़ै निं होए, तिधी हआ झ़गल़ै खतम।<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />ज़ेही नारा दी आग अर झ़ुका करै आग रहा ज़ल़दी,</para>
  <para style="q" vid="PRO 26:21">तिहअ ई निं झ़गल़खोर मणछ झ़गल़अ हिठणै दैंदअ।<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />घैंचल़ शुणने लागा मखीरा खाणैं ज़ेही मिठ,</para>
  <para style="q" vid="PRO 26:22">तिंयां गल्‍ला पेटै हाज़म बी जाआ हई।<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />कदुष्ट मणछे खाखा का झणैल़ू बोल हआ,</para>
  <para style="q" vid="PRO 26:23">तेऊ माट्टे भांडै ज़िहै ज़ुंण बागा का च़ंदी करै हआ महल़अ द।<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />ज़ुंण दुशमण बागा का भोल़अ फिरा,</para>
  <para style="q" vid="PRO 26:24">तेऊ हआ मन्‍नैं ज़ीद ई डाही दी।<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />तेऊए मिठी गल्‍लो कतैर निं करी,</para>
  <para style="q" vid="PRO 26:25">सह हआ भितरा का छ़ल़-कपटा करै भरी।<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />सह च़ाऐ ज़ेतरअ बी टवारअ करे पर</para>
  <para style="q" vid="PRO 26:26">तेऊए कदुष्ट काम जाणैं आम झाल़ै दी सोभी का शुझुई।<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />ज़ुंण होरी लै खण्हां, तेऊ लै भेटा खण्हअ द,</para>
  <para style="q" vid="PRO 26:27">ज़ुंण होरी लै पात्थर शोटा,</para>
  <para style="q" vid="PRO 26:27">तेऊ लै ढूल़ा आप्पू प्रैंदै ढेक।<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />ज़ुंण कहा झ़ुठी गल्‍ला करै मोहा, सह डाहा तेऊ लै ज़ीद</para>
  <para style="q" vid="PRO 26:28">अर च़ोपल़ लाई गल्‍ला करनै आल़अ करा बरैबादी ई।<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="s">काल्‍ला धैल़ी किज़ै हणअ तेते बारै निं बोली सकदै</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />काल्‍ला धैल़ीए बारै निं सेखी फणाटणी,</para>
  <para style="q" vid="PRO 27:1">तम्हां का निं थोघै कि काल्‍ला धैल़ी किज़ै हणअ!<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-14">याक. 4:13-14</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />तम्हैं निं आपणीं सर्राफी आप्पू करी,</para>
  <para style="q" vid="PRO 27:2">थारी सर्राफी लोल़ी होरी किई तैहा गल्‍ले हआ बड़ैई।<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />ज़ुंण आफ़त ऐडअ मणछ पाआ, तेतो बोझ़अ हआ</para>
  <para style="q" vid="PRO 27:3">पात्थर अर रेते बोझ़ै का गर्कअ।<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />रोश्शा आल़अ मणछ हआ बेघै बूरअ पर</para>
  <para style="q" vid="PRO 27:4">ज़ुंण ज़ीद-मिश डाहा, सह मणछ हआ होर बी खास्सअ कदुष्ट।<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />ज़ुंण तम्हां लै असली झ़ूरी डाहा,</para>
  <para style="q" vid="PRO 27:5">सह नैरा-समझ़ाऊआ मुंहैं बोली।<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />साथी-संघी सका तम्हां लै काठअ बी बोली, सह आसा तम्हां लै भलअ,</para>
  <para style="q" vid="PRO 27:6">पर दुशमण ज़ै तम्हां लै मल़्हैची दैए, तेतो डाहै धैन!<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />रज्ज़ी करै ज़ाण्हिंआं मखीर बी ल़क्‍कअ,</para>
  <para style="q" vid="PRO 27:7">पर भुखै पेटै ज़ाण्हिंआं कल़ुई च़िज़ा बी मिठी।<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />ज़ुंण आपणैं घअरा का दूर हआ,</para>
  <para style="q" vid="PRO 27:8">सह हआ तैहा च़ेल्‍ली ज़िहअ ज़ुंण आपणैं कोल्हा का दूर हआ।<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />ज़ेही धूपे शोभली बास्स बधिया लागा,</para>
  <para style="q" vid="PRO 27:9">तिहअ ई हआ असली साथी करै दिल खुश।<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />आपणैं अर आपणैं बाबे साथी-संघी डाहणैं सदा आद।</para>
  <para style="q" vid="PRO 27:10">नां खरीए पलका आपणैं नातै-रिश्तैदारा का मज़त मांगणी,</para>
  <para style="q" vid="PRO 27:10">किल्हैकि ज़िधी नेल़ रहणैं आल़अ साथी-संघी लागा,</para>
  <para style="q" vid="PRO 27:10">तिधी निं दूर रहणैं आल़ै रिश्तैदार कामैं एछदै।<verse eid="PRO 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />लान्हैंओ, अक्ल करा, तै रहणैं तम्हैं खुश,</para>
  <para style="q" vid="PRO 27:11">तै सका हुंह तिन्‍नां लै ज़बाब दैई ज़ुंण मेरी निंदा करा।<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />ज़हा सोर-समझ़ हुई सह मणछ हेरा ज़ाणीं कि आफ़त च़ाल्‍ली पल़ी अर सह जाआ चतैन हई,</para>
  <para style="q" vid="PRO 27:12">पर ऐडअ मणछ डेओआ आजू तैहा ई आफ़ता जैंदरी।<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />ज़ुंण कहा पाखलै मणछे ऋणा भरने ज़मानती लआ,</para>
  <para style="q" vid="PRO 27:13">तेऊ का लणअ किज़ै नां किज़ै बांधअ ज़रूर ढाकी।<verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />दोत्ती-दोत्थी ज़ोरै हाक्‍का पाई बर्गत बी हआ</para>
  <para style="q" vid="PRO 27:14">तेऊए साथी-संघी लै फिटका ज़ेही।<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />ज़ुंण बेटल़ी कबल्‍ली कांग डाहा लाई,</para>
  <para style="q" vid="PRO 27:15">छ़ाप्परा का लागी दी च़ोई ज़ेही।<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />बागरी रोक्‍कणी अर खाणैं हाथा प्रैंदै तेल ढाकणअ आसा</para>
  <para style="q" vid="PRO 27:16">झ़गल़खोर बेटल़ी रोक्‍कणै का सान।<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />ज़िहअ लोहअ ई लोहै तिछै करा,</para>
  <para style="q" vid="PRO 27:17">तेही दैआ साथी-संघी एकी-दुजै लै अक्ल।<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />ज़ुंण फेडूए बूटे फाज़त करा, सह खाआ तेते फल़ बी,</para>
  <para style="q" vid="PRO 27:18">अर ज़ुंण आपणैं गूरूए च़ाकरी करा, तेऊए हआ आपणीं बी मशूरी।<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />ज़िहअ मणछा पाणीं दी आपणअ ई मुंह शुझिआ,</para>
  <para style="q" vid="PRO 27:19">तिहअ ई लागा थारै मन्‍नें सोठा करै थोघ कि तम्हैं किहै आसा।<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />मणछे आछी हआ जम्परी ज़ेही,</para>
  <para style="q" vid="PRO 27:20">तिंयां निं केही बी रज़दी।<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />ज़िहअ सुन्‍नैं अर च़ंदी आरनैं आगी दी परखा,</para>
  <para style="q" vid="PRO 27:21">तेही हआ मणछे बभारे बी परख।<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />ज़ै तम्हैं ऐडै मणछा च़िक्‍की करै मरदै बी डाहे पाई,</para>
  <para style="q" vid="PRO 27:22">तैबी बी निं तिन्‍नें कबुध तम्हैं मारी सकदै।<verse eid="PRO 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />आपणैं डागै-चैणें हेल़्हीओ डाहणअ</para>
  <para style="q" vid="PRO 27:23">राम्बल़अ धैन-खैल,<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />धन-माया निं सदा रहंदी,</para>
  <para style="q" vid="PRO 27:24">नां सदा राज़ रहंदअ बणी।<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />ज़ेतरी घैहणींओ घाह लऊई निं छ़ेक्‍कअ,</para>
  <para style="q" vid="PRO 27:25">तेतरी जाआ सह भिई टिप्पदअ लागी।<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />तम्हैं सका गाभू, छ़ेल्हू बेच़ी</para>
  <para style="q" vid="PRO 27:26">आप्पू लै झिकल़ै अर ज़िम्मीं मोल लई।<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />बाकी ज़ुंण भेडा-बाकरी रहणीं, तिन्‍नें दुध-घिऊ करै सका तम्हैं आपणैं टबर धाची,</para>
  <para style="q" vid="PRO 27:27">अर थारै दास-दासीओ ज़िऊंण बी हणअ सह ई।<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="s">बिधाते बधाना करै एछा सोर-समझ़</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />ज़ै कदुष्ट मणछा पिछ़ू कोहै बी निं होए पल़अ द, तेऊ हआ तज़ी बी डरै ठुर्हा लागी दी।</para>
  <para style="q" vid="PRO 28:1">पर मानदार मणछ रहा खारकै सिहा ज़िहअ निहंचै।<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />ज़ेभै देशै पाप भर्हुअ, तेभै रहा राज़ बधल़दअ लागी,</para>
  <para style="q" vid="PRO 28:2">पर सह राज़ रहा पाक्‍कअ ज़ेथ समझ़कार अर अक्ली आल़ै मणछ हुऐ, किल्हैकि तिंयां डाहा बधान अर काईदै बच़ाऊई।<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />ज़ुंण दाल़जी होरी गरीबा छेऊंदअ लागा,</para>
  <para style="q" vid="PRO 28:3">सह आसा इहै पाणींए छ़ाल्‍लै ज़िहअ ज़ुंण सारी फसल बरैबाद करा।<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />ज़ुंण मणछ बधान निं मंदअ सह सराहा कदुष्ट मणछा,</para>
  <para style="q" vid="PRO 28:4">पर बधान मनणै आल़अ करा एही गल्‍लो बरोध।<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />कदुष्ट मणछ निं शुची पांच़ी समझ़ी सकदै,</para>
  <para style="q" vid="PRO 28:5">पर बिधाता पिछ़ू हांढणै आल़ै का हआ सोभी गल्‍लो थोघ।<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />बेईमान सेठ हणैं का आसा</para>
  <para style="q" vid="PRO 28:6">मानदार गरीब रहणअ भलअ।<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />ज़ुंण खारकै मणछ बधाने साबै ज़िन्दगी ज़िऊआ, तिन्‍नां हआ सोर-समझ़,</para>
  <para style="q" vid="PRO 28:7">ज़ुंण बाधू मणछे साथ संगत करा तिंयां करा आपणैं ईजा-बाबा बी शर्मिंदै।<verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />ज़ुंण होरी का बैज़ो-पल़ैज़ लई करै ढब्बै खटा,</para>
  <para style="q" vid="PRO 28:8">तिन्‍नें ढब्बै डेओआ तिन्‍नां मणछा लै ज़ुंण गरीबो धैन-खैल करा।<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />ज़ुंण बधाने साबै ज़िन्दगी नांईं ज़िऊंदअ,</para>
  <para style="q" vid="PRO 28:9">बिधाता निं तिन्‍नें अरज़ शुणदअ।<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />ज़ुंण भलै मणछा बूराई करना लै कबाता पाआ,</para>
  <para style="q" vid="PRO 28:10">सह खण्हां आप्पू लै आप्पै खात्ती,</para>
  <para style="q" vid="PRO 28:10">पर भली ज़िन्दगी ज़िऊंणै आल़ै मणछा लै हणअ आजू बी भलअ ई।<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />साहुकार ज़ाणा आप्पू लै कि सह आसा अक्ली आल़अ,</para>
  <para style="q" vid="PRO 28:11">पर ज़हा गरीब मणछा सोर-समझ़ हुई सह हेरा तेऊओ सभाब समझ़ी।<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />ज़ेभै भलै मणछ ज़िता, तेभै मनाऊंआं सोभै थैर,</para>
  <para style="q" vid="PRO 28:12">पर ज़ेभै कदुष्ट मणछ ज़िता तेभै हटा सोभै लोग पिछ़ू।<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />ज़ुंण आपणैं पाप च़ोरी डाहा, सह निं ज़िन्दगी दी सफल हंदअ।</para>
  <para style="q" vid="PRO 28:13">पर ज़ुंण तिन्‍नां मना अर आजू पाप करनअ छ़ाडा, तेऊ लै करा बिधाता झींण।<verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />ज़ुंण मणछ बिधाते डरा हेठै रहा, सह रहा सदा खुश,</para>
  <para style="q" vid="PRO 28:14">पर ज़ुंण हठ करा, तेऊ लै पल़ा आफ़त।<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />गरीब परज़ा प्रैंदै राज़ करनै आल़अ कदुष्ट राज़अ हआ</para>
  <para style="q" vid="PRO 28:15">क्रुंगणैं आल़ै सिहा अर रिंगणै आल़ै भाल्‍लू ज़िहअ घाती।<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />ज़हा राज़ै सोर-समझ़ निं हुई, सह करा परज़ा दुखी,</para>
  <para style="q" vid="PRO 28:16">ज़ुंण ठगी-पोक्‍की करै सेठ नांईं हणअ च़ाहंदअ, तेऊए हआ लाम्मी अमर।<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />ज़ुंण कहा ज़ीबे हत्या करी ज़ुल्म करा,</para>
  <para style="q" vid="PRO 28:17">सह मणछ खण्हां आप्पू लै आप्पै खात्ती, तेऊ रोक्‍कदै निं लागणअ।<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />धर्मीं मणछ रहा राज्ज़ी-राम्बल़अ,</para>
  <para style="q" vid="PRO 28:18">पर ज़ुंण कदुष्ट ठग होए, तेऊ लागणीं नच़ानक ठोहल़।<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />ज़ुंण खेचै खटा, तेऊ का हणअ खाणां पिणां लै रज्ज़ी,</para>
  <para style="q" vid="PRO 28:19">पर ज़ुंण आपणअ बगत निक्‍की संगती दी बरैबाद करा तेऊ पल़ा दाल़ज।<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />शुचै मणछे ज़िन्दगी दी हआ खास्सी बर्गत।</para>
  <para style="q" vid="PRO 28:20">पर ज़ुंण इहअ च़ाहा कि सह लोल़ी छ़ेक्‍कै सेठ हुअ, तेऊ भेटा सज़ा।<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />भेदभाब करनअ निं ठीक हंदअ अर</para>
  <para style="q" vid="PRO 28:21">नां पांच़ो रेशपत खाणअ ठीक हंदअ।<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />मतलबी मणछा हआ सेठ हणैंओ छ़ेक्‍कअ लागअ द,</para>
  <para style="q" vid="PRO 28:22">पर तिन्‍नां का निं इहअ थोघ हंदअ कि आजू आसा गरीबी एछणैं आल़ी।<verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />ज़ुंण मणछ नैरा समझ़ाऊआ,</para>
  <para style="q" vid="PRO 28:23">खिरी हआ तेऊ ई मणछे च़लाकी करनै आल़ै मणछा का खास्सी सर्राफी।<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />ज़ुंण आपणैं ईजा-बाबा ठगी करै इहअ सोठा कि</para>
  <para style="q" vid="PRO 28:24">तेऊ निं किछ़ै गलत किअ!</para>
  <para style="q" vid="PRO 28:24">सह मणछ आसा च़ोरा ई ज़िहअ।<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />मतलबी मणछ करा झ़गल़ै ई,</para>
  <para style="q" vid="PRO 28:25">पर ज़ुंण बिधाता दी भरोस्सअ डाहा तेऊ हआ ज़िन्दगी दी सफल।<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />ज़ुंण आपणैं ई बच़ारा दी भरोस्सअ डाहा, सह आसा ऐडअ,</para>
  <para style="q" vid="PRO 28:26">पर ज़ुंण अक्ली आल़ै मणछे बच़ार मना, सह रहा राज्ज़ी-राम्बल़अ।<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />ज़ुंण गरीबा लै बांडा, तेऊ निं आप्पू गरीबी पल़दी,</para>
  <para style="q" vid="PRO 28:27">पर ज़ुंण गरीब मणछे मज़त करना लै पिठ फरेऊआ, तेऊ लै दैआ सोभै फिटक।<verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />ज़ेभै कदुष्ट मणछो राज़ हआ, तेभै च़ोरा सोभै लोग आपणअ मुंह,</para>
  <para style="q" vid="PRO 28:28">पर ज़ेभै तिन्‍नों राज़ डेओआ, तेखअ हआ धर्मीं मणछो सोभी ज़ैगा राज़।<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="s">सोर समझ़ करनी</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />ज़ुंण भिई-भिई नैरी करै बी हठ ई करा,</para>
  <para style="q" vid="PRO 29:1">तेऊओ निं तेखअ किछ़ै लाज़ हंदअ, सह हआ एकी धैल़ै बरैबाद ई।<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />ज़ेभै देशै धर्मीं मणछ राज़ करा, तेभै हआ सारी परज़ा खुश,</para>
  <para style="q" vid="PRO 29:2">पर ज़ेभै कदुष्ट राज़ करा, तेभै पटाक्‍का लोग हिक्‍का।<verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />ज़ुंण अक्ली लै झ़ूरा, तेऊए रहा ईज-बाब बी खुश,</para>
  <para style="q" vid="PRO 29:3">पर कबुधी मणछ करा आपणैं ढब्बै-धेल्‍लै कंज़री बेटल़ी पिछ़ू बरैबाद।<verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />धर्मीं राज़ै करै हआ देश बलबान,</para>
  <para style="q" vid="PRO 29:4">पर ज़ेऊ देशे पांच़ रेशपत लआ, तिंयां करा आपणैं देशा बरैबाद।<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />च़ोपल़ लाई गल्‍ला करनै आल़ै साथी-संघी डाहा</para>
  <para style="q" vid="PRO 29:5">आप्पू लै आप्पै ज़ज़ाल़ छ़ैई।<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />कदुष्ट मणछे पाप हआ तिन्‍नां आप्पू लै फाही,</para>
  <para style="q" vid="PRO 29:6">पर धर्मीं मणछ रहा खुश अर आज़ाद।<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />धर्मीं मणछा का हआ थोघ कि गरीबो किज़ै हक आसा,</para>
  <para style="q" vid="PRO 29:7">पर कदुष्ट मणछ निं इना गल्‍ला समझ़ी सकदअ।<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />ज़हा मणछा कदर निं हंदी, तिंयां पाआ सारी नगरी खरोल़,</para>
  <para style="q" vid="PRO 29:8">पर अक्ली आल़ै मणछ करा रोश्श बी शांत।<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />अक्ल करनी एही कि ऐडै संघै निं लोल़ी दाऊअ-दालत हुअ,</para>
  <para style="q" vid="PRO 29:9">तिंयां मेल़-ज़ोल़ हणैं दैंदै</para>
  <para style="q" vid="PRO 29:9">किल्हैकि ऐडै करा सुहांग अर तिंयां काढा झांशा त्रुंगा ई।<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />हत्या करनै आल़ै मणछ डाहा भलै मणछा संघै ज़ीद,</para>
  <para style="q" vid="PRO 29:10">पर धर्मीं मणछ बच़ाऊआ इहै मणछे ज़िन्दगी।<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />ऐडअ मणछ दैआ आपणैं दिले सारी गल्‍ला हुकरी,</para>
  <para style="q" vid="PRO 29:11">पर ज़हा सोर-समझ़ हुई, तिंयां रहा सबर डाही च़ुप्पी।<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />ज़ुंण बज़ीर झ़ुठी गल्‍ला दी धैन दैआ,</para>
  <para style="q" vid="PRO 29:12">तेऊए हआ सोभै कार-करिंदै बेईमान।<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />गरीब अर गरीबा छेऊणैं आल़ै हआ दुहै एक्‍कै ज़िहै कि</para>
  <para style="q" vid="PRO 29:13">बिधाता हआ तिन्‍नां दुही लै आछी दैनी दी।<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />ज़ुंण राज़अ सत्ता दी रही गरीब मणछो नसाफ करा,</para>
  <para style="q" vid="PRO 29:14">तेऊओ राज़ रहा सदा बणी।<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />ज़ै लान्हैं नैरै समझ़ाऊऐ, तेता करै हआ तिन्‍नों भलअ,</para>
  <para style="q" vid="PRO 29:15">पर ज़ै शोहरू नैरनै बाझ़ी एही छ़ुटअ, बादा का लागा तेखअ तेऊए ईजा शर्मिंदै हणअ।<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />कदुष्ट मणछे राज़ा दी हआ ज़ुल्म खास्सअ,</para>
  <para style="q" vid="PRO 29:16">पर धर्मीं रहणैं तिन्‍नें बरैबादी भाल़ै ज़िऊंदै।<verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />आपणैं लान्हैं करनै नैरी-समझ़ाऊई,</para>
  <para style="q" vid="PRO 29:17">तै रहणैं तम्हैं काल्‍ला धैल़ी सुखी अर खुश।<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />ज़ेऊ देशै बिधाते सलाह निं मंदै, तिंयां लोग हआ बरैबाद,</para>
  <para style="q" vid="PRO 29:18">पर ज़ुंण बधान मना तिन्‍नां लै दैआ सह बर्गत।<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />दास निं सिधअ गल्‍ला करै शिखल़दअ,</para>
  <para style="q" vid="PRO 29:19">कई बारी निं तिंयां गल्‍ला समझ़ी बी तेथ धैन दैंदै।<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />ज़ुंण दिलै बच़ार करी गल्‍ला निं करदअ,</para>
  <para style="q" vid="PRO 29:20">तिहै का आसा ऐडै मणछा का आशा डाहणीं भली।<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />दास निं होछ़ी उझै मुंडा प्रैंदै डाहणअ कुआल़ी,</para>
  <para style="q" vid="PRO 29:21">खिरी बणां सह तेऊए सोभी गल्‍लो मालक।<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />धखी का रोश्श करनै आल़अ मणछ करा</para>
  <para style="q" vid="PRO 29:22">झ़गल़ै अर आफ़त खल़ी।<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />शरेरै मणछा लागा ज़रूर ठोहल़,</para>
  <para style="q" vid="PRO 29:23">पर मानदार मणछे करा सोभै इज़त।<note caller="-" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मोत्त. 23:12</ref></char></note><verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />च़ोरा संघै संगत डाहणैं आल़अ हआ आपणीं ई ज़ानींओ दुशमण,</para>
  <para style="q" vid="PRO 29:24">ज़ै सह दालता दी शुचअ खोज़े, तेथ भेटणीं तेऊ सज़ा! अर झ़ुठअ बोली लागणअ तेऊ बिधाता का फिटक!<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />इहअ सोठणअ हआ आप्पू लै फाही कि होर लोग थारै बारै किज़ै सोठा,</para>
  <para style="q" vid="PRO 29:25">पर बिधाता दी भरोस्सअ डाहणैं आल़अ मणछ रहा राज्ज़ी-राम्बल़अ।<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />बज़ीरा संघै साथ च़ाहा हर कोई डाहणीं,</para>
  <para style="q" vid="PRO 29:26">पर नसाफ एछा बिधाता ई का।<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />धर्मीं मणछ करा कदुष्ट मणछा का नफरत</para>
  <para style="q" vid="PRO 29:27">अर कदुष्ट डाहा धर्मीं संघै ज़ीद।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">आगूरै खोज़ी दी सैणीं गल्‍ला</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />ईंयां सैणीं गल्‍ला आसा जाकेहे शोहरू आगूरै खोज़ी दी।</para>
  <para style="q" vid="PRO 30:1">आगूरै बोलअ इतीएल अर उकाल़ा का इहअ,<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />“हुंह आसा मणछा मांझ़ै डागै ज़िहअ,</para>
  <para style="q" vid="PRO 30:2">अर मुंह निं मणछा ज़ेही सोर समझ़ ई आथी।<verse eid="PRO 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3" />मुखा नां अक्ल आथी अर</para>
  <para style="q" vid="PRO 30:3">नां मुखा परम पबित्र बिधाते बारै ज्ञैन आथी!<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />स्वर्गा लै उखल़ी उंधै कुंण होथअ?</para>
  <para style="q" vid="PRO 30:4">बागरी कुंणी आसा आपणीं मुठी दी ढाकी डाही दी?</para>
  <para style="q" vid="PRO 30:4">समुंदरो पाणीं कुंणी आसा शाट्टै दी झाल़ी डाहअ द?</para>
  <para style="q" vid="PRO 30:4">अह एतरी बडी पृथूई कुंणी आसा बणाईं दी? तेऊ नाअं किज़ै आसा अर</para>
  <para style="q" vid="PRO 30:4">तेऊओ शोहरू कुंण आसा?</para>
  <para style="q" vid="PRO 30:4">ज़ै ताखा थोघ आसा, तै खोज़ा मुखा बी!<verse eid="PRO 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />परमेशरै ज़ुंण ज़बान दैनी, सह करा तैहा पूरी,</para>
  <para style="q" vid="PRO 30:5">ज़ुंण तेऊए शरण लआ सह करा तेऊए ढाल़ बणी करै फाज़त।<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />ज़ै तम्हैं तेऊए गल्‍ला छ़ाडी किज़ै होर खोज़े ज़ुंण तेऊ नां आथी बोली दी,<note caller="-" style="x"><char style="xo" closed="false">30:6 </char><char style="xt" closed="false"><ref loc="DEU 4:2">बधा. 4:2</ref></char></note></para>
  <para style="q" vid="PRO 30:6">तेऊ नैरनअ तम्हैं तेभी अर तेखअ हणीं अह गल्‍ला प्रगट कि तम्हैं आसा शल़ैघी।<verse eid="PRO 30:6" /></para>
  <para style="s">होर सैणीं गल्‍ला</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />हे बिधाता, मेरी आसा ताखा एही अरज़ कि</para>
  <para style="q" vid="PRO 30:7">तूह लअ मेरै मरनै का आजी मुल्है दूई बअर दैई।<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />हुंह लोल़ी पठी मानदार हुअ,</para>
  <para style="q" vid="PRO 30:8">नां मुंह खास्सअ सेठ बणाईं अर नां खास्सअ गरीब।</para>
  <para style="q" vid="PRO 30:8">मेरी लोल़ी सिधी हर धैल़ै ज़रुरत पूरी हुई।<verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />इहअ निं हआ कि हुंह रज्ज़ी करै ताह बिस्सरी पाए,</para>
  <para style="q" vid="PRO 30:9">अर इहअ बी निं लोल़ी हुअ कि मुंह दाल़ज पल़े अर मेरै भलै किधी च़ोरी होए अर ताह बिधाते नाओंआं दी दाग लागे!”<verse eid="PRO 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />ज़ुंण दास होए, तेऊए बारै निं तेऊए मालका का घैंचल़ करनै,</para>
  <para style="q" vid="PRO 30:10">इहअ निं हआ कि सह तम्हां लै फिटक दैए अर तम्हां बिधाता का सज़ा भेटे।<verse eid="PRO 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />कई मणछ हआ इहै बी ज़ुंण आपणैं बाबा लै फिटक दैआ</para>
  <para style="q" vid="PRO 30:11">अर नां आपणीं ईजो शूकर करदै!<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />इहै मणछ सोठा आप्पू लै इहअ कि तिंयां आसा आप्पू बाखा शुचै</para>
  <para style="q" vid="PRO 30:12">पर तिन्‍नां दी आसा इहअ दाग ज़ुंण कधि निं धोअ!<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />एकी पोस्तीए मणछ आसा इहै शरेरै, तिंयां सोठा इहअ कि तिंयां ई आसा भलै,</para>
  <para style="q" vid="PRO 30:13">तिंयां सोठा कि तिंयां भाल़ किहै भलै निं आथी!<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />तिन्‍नें दांद आसा तलबारा ज़िहै,</para>
  <para style="q" vid="PRO 30:14">तिन्‍नें दाल़्हा आसा छ़ूरी ज़ेही!</para>
  <para style="q" vid="PRO 30:14">तिंयां च़ाहा धरती का गरीब अर</para>
  <para style="q" vid="PRO 30:14">खरी दी पल़ै दै लोगा होरी मणछा जैंदरा का खतम करनअ।<verse eid="PRO 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />ज़ोके हआ दूई शोहरी, तिंयां बोला, “होर दै होर दै!”</para>
  <para style="q" vid="PRO 30:15">तेही ई आसा चअन च़िज़ा ज़ुंण कधि निं रज़दी।</para>
  <para style="q" vid="PRO 30:15">एही च़िज़ा आसा च़ार पै</para>
  <para style="q" vid="PRO 30:15">ज़ुंण कधि निं बोल्दी कि हुअ।<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />जम्पर अर बांढी बेटल़ीओ ओदर,</para>
  <para style="q" vid="PRO 30:16">शुक्‍की धरती लै पाणीं</para>
  <para style="q" vid="PRO 30:16">अर आग निं कधि बोल्दी</para>
  <para style="q" vid="PRO 30:16">कि ऐबै हुअ।<verse eid="PRO 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />ज़ुंण आपणैं बाबो सुहांग करा अर</para>
  <para style="q" vid="PRO 30:17">बुढल़दा आपणीं ईजे कदर निं करदअ,</para>
  <para style="q" vid="PRO 30:17">इहअ मणछ च़ोच़ल़णअ काअ-गरली अर</para>
  <para style="q" vid="PRO 30:17">तेऊए आछी खरोप्पणी मुक्षरलै।<verse eid="PRO 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />चअन च़िज़ा आसा बेघै कठण,</para>
  <para style="q" vid="PRO 30:18">एही आसा ईंयां च़ार गल्‍ला पै ज़ुंण मेरी समझ़ा का बागै आसा:<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />सरगै डैअ दैंदै मुक्षरले बात,</para>
  <para style="q" vid="PRO 30:19">दानुईंओ टोल्हा प्रैंदै हांढणअ,</para>
  <para style="q" vid="PRO 30:19">समुंदरे पाणीं दी ज़हाज़े बात लोल़णी अर</para>
  <para style="q" vid="PRO 30:19">मर्धा बेटल़ीओ एकी-दुजै लै झ़ूरनअ!<verse eid="PRO 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />च़ोरठू बेटल़ी बी हआ एही ई,</para>
  <para style="q" vid="PRO 30:20">सह एछा होरी मर्धा संघै सुत्ती न्हैऊई-धोऊई संघा बोला इहअ,</para>
  <para style="q" vid="PRO 30:20">“मंऐं निं किछ़ै कबध किअ!”<verse eid="PRO 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />चिई गल्‍ला करै लागा धरती काम्मणीं,</para>
  <para style="q" vid="PRO 30:21">पर एही आसा च़ार पै ज़ुंण ज़ेता ज़िरी निं सकदी,<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />गलाम मणछ राज़अ बणनअ</para>
  <para style="q" vid="PRO 30:22">अर ऐडै मणछो पेट रज़णअ।<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />कंज़री बेटल़ीओ बैह करनअ अर</para>
  <para style="q" vid="PRO 30:23">गलाम डाही दी बेटल़ीओ आपणीं मालके ज़ैगा बेशणअ।<verse eid="PRO 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />पृथूई दी आसा च़ार होछ़ै ज़ीब पर तिंयां आसा बेघै अक्ली आल़ै:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />चिटा हआ बेघै होछ़ी पर</para>
  <para style="q" vid="PRO 30:25">तिंयां रहा खरै दपहरै नाज़ा झाल़दी लागी।<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />टाहरू मुश्शअ एही ता आसा होछ़अ ज़िहअ,</para>
  <para style="q" vid="PRO 30:26">पर सह बणाआं शाफल़ा जैंदरी आप्पू लै मशेहर।<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />रैट्टैओ निं कोहै राज़अ हंदअ,</para>
  <para style="q" vid="PRO 30:27">पर तज़ी बी हांढा तिंयां एकी छ़ुंढा दी।<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />छ़बाल़ ढाकणीं हआ सान,</para>
  <para style="q" vid="PRO 30:28">पर तज़ी बी रहा तिंयां राज़े मैहलै।<verse eid="PRO 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />चअन ज़ीब आसा बेघै बित्तै,</para>
  <para style="q" vid="PRO 30:29">एही आसा च़ार पै, तिन्‍नां हांढदै भाल़णेंओ लागा च़ाअ,<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />सिह ज़ुंण सोभी ज़ीबा का बलबान,</para>
  <para style="q" vid="PRO 30:30">सह निं कोही का डरदअ।<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />मुर्गी आजू मुंडकी खल़ी करी हांढदअ मुर्गअ, अर बाकरी आजू बाकरअ</para>
  <para style="q" vid="PRO 30:31">अर आपणीं परज़ा जैंदरी राज़अ।<verse eid="PRO 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />ज़ै तम्हैं एही ऐडी गल्‍ल किई कि तम्हैं लागै आप्पू सराहंदै आप्पै,</para>
  <para style="q" vid="PRO 30:32">ज़ै तम्हैं किज़ै बूरी तरकीब बणाईं,</para>
  <para style="q" vid="PRO 30:32">तै खल़्हणअ तिधी संघा लणअ बच़ार करी।<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />किल्हैकि ज़िहअ दैंहीं छ़ाल्‍ली करै घिऊ अर</para>
  <para style="q" vid="PRO 30:33">नाक मरोक्‍की करै नाथण निखल़ा,</para>
  <para style="q" vid="PRO 30:33">तेही सका थारै कबल्‍लै रोश्शा करै आफ़त खल़ी हई।<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">राज़ै लै सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />ईंयां राज़ै लमूएलै खोज़ी दी खास सैणीं गल्‍ला ज़ुंण तेऊ आपणीं ईजा का थिई शिखल़ी दी।<verse eid="PRO 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />ए मेरै लान्हैंआ, तूह आसा मेरै मानत मनी हुअ द,</para>
  <para style="q" vid="PRO 31:2">हुंह ताल्है किज़ै बोलूं?<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />आपणअ बल निं बेटल़ी दी पठी खतम करी।</para>
  <para style="q" vid="PRO 31:3">एही बेटल़ी किऐ राज़ै बी बरैबाद।<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />लमूएल, शुण, राज़ै निं खास्सअ दाखो रस अर</para>
  <para style="q" vid="PRO 31:4">शराब झुटणअ शोभदअ।<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />इहअ निं हआ कि तूह शराब झुटी बधान बिस्सरी पाए</para>
  <para style="q" vid="PRO 31:5">अर तूह रैनै गरीबो हक मारे।<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />शराब दैणअ तिन्‍नां लै ज़ुंण मरी आसा च़ाल्‍लै दै</para>
  <para style="q" vid="PRO 31:6">अर दाखो रस दैणअ तिन्‍नां लै ज़ुंण दुखी आसा।<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />ताकि तिंयां तेता झुटी करै</para>
  <para style="q" vid="PRO 31:7">आपणअ दुख-दल़िदर बिस्सरीए।<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />ज़ुंण आपणैं बारै किछ़ै निं खोज़ी सकदै, तिन्‍नां बाखा करनी तंऐं गल्‍ला,</para>
  <para style="q" vid="PRO 31:8">अर छ़ुटै-मुक्‍कै दै लान्हैं लै दैणअ तिन्‍नों हक।<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />तंऐं करनी तिन्‍नें मखबरी अर धर्मीं पांच़ी,</para>
  <para style="q" vid="PRO 31:9">दुखी-दल़िदरे हके फाज़त करनी तंऐं आप्पै।<verse eid="PRO 31:9" /></para>
  <para style="s">भली बेटल़ी</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />भली बेटल़ी भेटणीं हआ खास्सी कठण,</para>
  <para style="q" vid="PRO 31:10">सह हआ हीरै-मोती का बी किम्मती।<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />तेसे मर्धा बी हआ तैहा दी भरोस्सअ अर</para>
  <para style="q" vid="PRO 31:11">तेऊ निं कधि गरीबी पल़दी।<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />तेसो बभार हआ आपणीं ज़िऊंदी ज़िता भलअ ई</para>
  <para style="q" vid="PRO 31:12">अर सह निं कधि तेऊ लै दुख दैंदी।<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />सह लोल़ा ऊन अर शल़ूई</para>
  <para style="q" vid="PRO 31:13">संघा रहा खुशी-खुशी तेते मांदरी बूणदी लागी।<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />आपणैं घअरे खाणैं-पिणें च़िज़ा आणा सह दूर देशा का</para>
  <para style="q" vid="PRO 31:14">बपारीए समुंदरे ज़हाज़ा ज़िहअ।<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />सह जाआ दोत्ती न्हैर-प्रैश्शै उझ़ुई नुहारी बणाईं</para>
  <para style="q" vid="PRO 31:15">संघा हेरा आपणीं दासी कामां-काज़ा लै छ़ाडी।<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />सह भाल़ा खेच संघा लआ तेऊ मोलै,</para>
  <para style="q" vid="PRO 31:16">तेखअ लाआ तेथ सह दाखो बाग।<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />सह करा खास्सी मैन्थ अर</para>
  <para style="q" vid="PRO 31:17">सह झ़ूरा आपणैं ज़ाहणै खटणा लै।<verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />सह हेरा ज़ाणीं कि तेसे कामां करै हणअ नफअ</para>
  <para style="q" vid="PRO 31:18">अर सह रहा आधा राची तैणीं कामां लागी।<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />सह कात्ता ताकल़ी दी ऊन आप्पै</para>
  <para style="q" vid="PRO 31:19">संघा बणाआं च़रखै दी ठेर्ही आप्पू लै आप्पै झिकल़ै।<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />रैनै-गरीबा लै बी दैआ सह</para>
  <para style="q" vid="PRO 31:20">खुल्है दिलै।<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />तैहा निं हिंऊंद भराल़ो हैल़अ-फिकर हंदअ</para>
  <para style="q" vid="PRO 31:21">तेसे घअरै हआ सोभी का नैत्तै झिकल़ै।<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />सह बणाआं आपणीं शरैहणीं अर</para>
  <para style="q" vid="PRO 31:22">आप्पू बान्हां सह बैंज़णीं रांगे बाछे झिकल़ै।<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />तेसे मर्धे मशूरी हआ सारी नगरी अर</para>
  <para style="q" vid="PRO 31:23">सह बेठा त सैणैं संघै सभा दी, तिंयां सोभै करा तेऊए इज़त।<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />सह बूणा बाछे झिकल़ै</para>
  <para style="q" vid="PRO 31:24">अर गल़बंध, संघा बेच़ा तिन्‍नां बपारी का।<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />तैहा का हआ बल अर सोभै करा तेसे इज़त,</para>
  <para style="q" vid="PRO 31:25">नां तैहा काल्‍ला धैल़ीओ हैल़अ-फिकर हंदअ।<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />सह करा अक्लीए गल्‍ला अर</para>
  <para style="q" vid="PRO 31:26">नैरा समझ़ाऊआ बी सह मज़ै करै।<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />सह रहा आपणैं टबरे हेर-सभाल़ा लागी अर</para>
  <para style="q" vid="PRO 31:27">नां तैहा कामां लै ज़ैंईं लागदी।<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />तेसे शोहरू करा तेसे खास्सी सर्राफी</para>
  <para style="q" vid="PRO 31:28">अर तेसो मर्ध करा तेसे इहअ बोली सर्राफी,<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />“होर बेटल़ी बी आसा राम्बल़ी</para>
  <para style="q" vid="PRO 31:29">पर तेरै मकाबलै निं कोहै आथी।”<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />शोभा हआ झ़ुठी अर हेरनी बित्ती बी निं सदा रहंदी,</para>
  <para style="q" vid="PRO 31:30">पर ज़ुंण बेटल़ी बिधाते डरा हेठे रहा, तेसे हणीं सर्राफी।<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />ज़ुंण तैहा काम किअ, तेतो फल लोल़ी तैहा भेटअ।</para>
  <para style="q" vid="PRO 31:31">सह आसा एता जोगी कि सोभै तेसे सर्राफी करे।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>