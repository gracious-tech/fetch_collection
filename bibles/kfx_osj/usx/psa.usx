  <para style="h">भज़न</para>
  <para style="toc1">राज़ै, गूर, प्रोहतै लिखै दै भज़न अर गिहा</para>
  <para style="toc2">भज़न</para>
  <para style="toc3">भज.</para>
  <para style="mt1">भज़न</para>
  <para style="mt2">राज़ै, गूर, प्रोहतै लिखै दै भज़न अर गिहा</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़ै: राज़ै, गूर, प्रोहत</para>
  <para style="ili">सन: 1440 का 430 ईसा आजी</para>
  <para style="ip">ऐहा कताबा दी आसा कबिता अर भज़न लिखै दै, अह कताब आसा बी सोभी का लाम्मी कताब। इना कबिता अर भज़ना लिखणैं आल़ै आसा कई ज़िहअ कि, राज़अ दाबेद, असाप, कोराहे शोहरू, राज़अ सुलैमान, एतान, हमान मोसा अर होर, तिन्‍नें बारै निं खास थोघ आथी। तिंयां लिखणैं आल़ै तै राज़ै, प्रोहत, लेबी खिंबा मांझ़ा का ज़ुंण राज़ै दाबेदे राज़ा दी बिधाते पबित्र ज़ैगा बिधाते पूज़ा-गाज़ा करने गाणैं-बज़ाणें ज़िम्मैंबारी सभाल़ा तै।</para>
  <para style="ip">ईंयां भज़न आसा खासकर परमेशरे रच़ना, जुध, च़ाकरी, अक्ल, पाप, बूराई, सज़ा, नसाफ अर मसीहा एछणें बारै। भज़न लिखणैं आल़ै दैआ पहल़णैं आल़ै च़कणी कि परमेशर अर तेऊए कामों गूण गाणअ ज़रूरी। खरीए पलका आसा सह ई हाम्हां लै शुचअ-पाक्‍कअ अर हाम्हां लागा एता करै थोघ कि तेऊओ बैण आसा अटल़।</para>
  <para style="ip">सोभी का आजी विश्वास करनै आल़ै मणछ बी बोला तै परमेशरे स्तोती करना लै इना भज़ना। सखाऊंणा लै अर प्रभू ईशूए खुशीए समादा खोज़णा लै बी हआ तै ईंयां ई भज़न कि मसीहा ईशू हाम्हां लै किज़ै किअ। 118 भज़ने अह गल्‍ल आसा नऊंऐं बधाना दी छ़हा बारी:</para>
  <para style="iq1">ज़ुंण पात्थर मिस्त्री बृथा समझ़अ त,</para>
  <para style="iq1">तंऐं बणाअं सह ई पात्थर सोभी का खास।</para>
  <para style="ipr">(118:22)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">मसीहे भज़न 1:1—41:13</para>
  <para style="io1">मानत पूरी हणें भज़न 42:1—72:20</para>
  <para style="io1">इज़राईलीए बारै भज़न 73:1—89:52</para>
  <para style="io1">राज़े बारै भज़न 90:1—106:48</para>
  <para style="io1">बिधाते बड़ैई करने भज़न 107:1—150:6</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">पैहलअ भाग</para>
  <para style="mr">(<ref loc="PSA 1:1-41:13">भज़न 1:1—41:13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 1:1" />परमेशर दैआ तिन्‍नां मणछा लै बर्गत</para>
  <para style="q" vid="PSA 1:1">ज़ुंण कदुष्ट मणछे सलाह निं मंदअ,</para>
  <para style="q" vid="PSA 1:1">नां पापी मणछा ज़िहअ काम करदअ</para>
  <para style="q" vid="PSA 1:1">अर नां तिन्‍नें टोली दी साझ़ू हंदअ</para>
  <para style="q" vid="PSA 1:1">ज़ुंण परमेशरो मखौल करा।<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />इना सोभी गल्‍ला छ़ाडी रहा तिंयां</para>
  <para style="q" vid="PSA 1:2">बिधातो बधान मनणा लै मगन</para>
  <para style="q" vid="PSA 1:2">अर तिन्‍नां हआ धैल़-राच तेते ई बारै धैन अर सोठ पल़ी दी।<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />तिंयां मणछ आसा इहै हरै बूटा ज़िहै</para>
  <para style="q" vid="PSA 1:3">ज़ुंण सदा बहूंदी गाडे बाढै आसा लागै दै,</para>
  <para style="q" vid="PSA 1:3">ज़ेथ सिज़नै ठीक बगती फल़ लागा</para>
  <para style="q" vid="PSA 1:3">अर पाच रहा तिन्‍नां बूटे हरै ई हरै।</para>
  <para style="q" vid="PSA 1:3">तिंयां मणछ ज़िहअ बी करे, तेथ हआ तिंयां सफल।<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">जेर. 17:8</ref></char></note> <verse eid="PSA 1:3" /><verse number="4" style="v" sid="PSA 1:4" />पर कदुष्ट मणछ निं इहै हंदै!</para>
  <para style="q" vid="PSA 1:4">तिंयां आसा इहै भुखलै ज़िहै, ज़ेता बागरी करै पोर्ही पूणा।<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />तैही निं कदुष्ट मणछा का राज़ै धर्मींए दालता दी ज़बाब हणअ,</para>
  <para style="q" vid="PSA 1:5">तेऊ काढणैं पापी मणछ आपणैं धर्मीं मणछे टोली का दूर।<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />किल्हैकि धर्मीं मणछे हेर-सभाल़ अर फाज़त करा बिधाता आप्पै,</para>
  <para style="q" vid="PSA 1:6">पर कदुष्ट मणछ डेऊणैं तैहा बाता ज़ेथ बरैबादी हआ।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="PSA 68:2">भज. 68:2</ref>; <ref loc="PSA 73:27">73:27</ref>; <ref loc="PSA 92:9">92:9</ref></char></note><verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">राज़अ ज़ुंण बिधाता छ़ांटअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />देशा-देशे लोग किल्है आसा रोश्शै लाल-पिंऊंल़ै हुऐ दै?<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">ज़ुंण परमेशरा नांईं मंदै</char></note></para>
  <para style="q" vid="PSA 2:1">तिन्‍नैं किल्है लाअ फज़ूल गल्‍ला सोठणा लै आपणअ बगत ज़ांऐं करी?<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 4:25">शधा. 4:25</ref>,<ref loc="ACT 4:26">26</ref> </char></note><verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />धरतीए सोभी राज़ै किअ बिधाता</para>
  <para style="q" vid="PSA 2:2">अर तेऊ राज़ै लै एक्‍कअ ज़ुंण परमेशरै आप्पै आसा छ़ांटअ द,</para>
  <para style="q" vid="PSA 2:2">संघा लागै आप्पू मांझ़ै इहअ बोल्दै,<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />“तेऊए बधाना का हणअ हाम्हां आज़ाद</para>
  <para style="q" vid="PSA 2:3">अर हाम्हां निं तेऊए बशै रहणअ!”<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />म्हारअ मालक बिधाता ज़ुंण स्वर्गै आपणीं राज़गाद्दी दी आसा बेठअ द,</para>
  <para style="q" vid="PSA 2:4">तेऊ फुक्‍कणी तिन्‍नां लै हास्सी अर तेऊ करनअ तिन्‍नां देशो सुहांग।<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />बिधाता हणअ तिन्‍नां लै रोश्शै लाल-पिंऊंल़अ,</para>
  <para style="q" vid="PSA 2:5">अर तिन्‍नां पल़णअ हैल़अ ज़ांऊं बिधाता रोश्शै तिन्‍नां लै इहअ बोल़णअ,<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />“ज़ुंण राज़अ मंऐं छ़ांटअ,</para>
  <para style="q" vid="PSA 2:6">सह बशैल़अ मंऐं आपणीं पबित्र धारा सियोने राज़गाद्दी दी।”<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />राज़अ बोला इहअ, “मुंह खोज़णीं तिंयां गल्‍ला सोभी का</para>
  <para style="q" vid="PSA 2:7">ज़ुंण मंऐं शूणअ कि बिधाता किअ इहअ हुकम,</para>
  <para style="q" vid="PSA 2:7">‘तूह आसा मेरअ पूत किल्हैकि आझ़ बणअ हुंह तेरअ बाब।<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">शधा. 13:33</ref>; <ref loc="HEB 1:5">इब्रा. 1:5</ref>; <ref loc="HEB 5:5">5:5</ref></char></note><verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />तूह मुखा मांगी ता भाल़, मुंह बणाणैं देशा-देशे लोग तेरी ज़ैदात</para>
  <para style="q" vid="PSA 2:8">अर सारी धरतीओ मालक हणअ तूह।<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />ताह राट्टणै तिंयां लोहे शोठै करै</para>
  <para style="q" vid="PSA 2:9">अर ताह करनै तिंयां माट्टे भांडै ज़िहै फाल़ी करै शरबूर।’”<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26">प्रका. 2:26</ref>,<ref loc="REV 2:27">27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref></char></note><verse eid="PSA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />देशा-देशे राज़ैओ, कबुधी निं हआ,</para>
  <para style="q" vid="PSA 2:10">संसारै राज़ करनै आल़ैओ, ऐहा चतैनगी दी दैआ धैन,<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />बिधाते डरा हेठै रही करा तेऊए च़ाकरी अर काम्बदी-काम्बदी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />तेऊए शोहरू सेटा टेक्‍का माथअ,</para>
  <para style="q" vid="PSA 2:12">इहअ निं हआ कि बिधाता</para>
  <para style="q" vid="PSA 2:12">रोश्शै लाल-पिंऊंल़अ हई तम्हां नच़ानक खतम करे।</para>
  <para style="q" vid="PSA 2:12">सह करा तेऊए फाज़त अर तिन्‍नां लै दैआ बर्गत ज़ुंण तेऊ सेटा शरण लआ।<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">दोत्ती बोल़णैंओ भज़न</para>
  <para style="d">राज़ै दाबेद बोलअ अह भज़न तधू, ज़धू सह आपणैं शोहरू अबशलोमा सेटा का ठुर्ही डेऊअ त</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />हे बिधाता, मेरै हुऐ खास्सै दुशमण!</para>
  <para style="q" vid="PSA 3:1">मुंह संघै लागै खास्सै झ़घल़दै!<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />कई आसा इहअ बोल्दै लागै दै,</para>
  <para style="q" vid="PSA 3:2">“बिधाता निं एऊ बच़ाऊंदअ च़ाल्‍लअ एछी!”<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />पर हे बिधाता, खातरै का हर बगत बच़ाऊंणा लै आसा</para>
  <para style="q" vid="PSA 3:3">तूह ई मेरी ढाल़</para>
  <para style="q" vid="PSA 3:3">तूह ई आसा मेरी इज़त ज़ुंण मुंह हर बगत ज़ीत दैआ।<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />हुंह करा ताह बिधाता सेटा ज़ोरै-ज़ोरै अरज़</para>
  <para style="q" vid="PSA 3:4">अर तूह दैआ मुल्है तेरी पबित्र धारा का ज़बाब।<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />हुंह सुत्ता राची निहंचै निंजा</para>
  <para style="q" vid="PSA 3:5">किल्हैकि तूह बिधाता करा मेरी फाज़त।<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />फेरा-फेर मुंह हारदै-मारदै आऐ दै</para>
  <para style="q" vid="PSA 3:6">हज़ारो दुशमणा का निं हुंह डरदअ।<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />हे मेरै परमेशर बिधाता, तूह एछ इना कदुष्टा का मुंह बच़ाऊंदअ आप्पै!</para>
  <para style="q" vid="PSA 3:7">मेरै दुशमणे थोथरै बाह च़टराल़ै</para>
  <para style="q" vid="PSA 3:7">अर तिन्‍नें दांदे माल़ा शोट धरनीं,<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />किल्हैकि तूह दैआ आपणैं लोगा लै बर्गत</para>
  <para style="q" vid="PSA 3:8">अर तिन्‍नां लै ज़ीत दैणैं आल़अ आसा तूह बिधाता आप्पै।<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">परमेशरा दी विश्वास</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />मुंह बच़ाऊंणै आल़ै परमेशर</para>
  <para style="q" vid="PSA 4:1">बिधाता, ज़ीबाण ज़ेभै हुंह अरज़ करूं तेभै दैऐ तूह तेतो ज़बाब,</para>
  <para style="q" vid="PSA 4:1">ज़ेभै मुंह गल़ै तैणीं घाटी ती आई दी,</para>
  <para style="q" vid="PSA 4:1">तेभै आअ तूह ई मुंह बच़ाऊंदअ।</para>
  <para style="q" vid="PSA 4:1">ऐबै कर तूह मुल्है झींण अर मेरी अरज़ शुण।<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />ओ लोगो, तम्हां केभै तैणीं रहणअ मेरी बेइज़ती करदै लागी?</para>
  <para style="q" vid="PSA 4:2">तम्हैं झ़ूरा झ़ुठी मुहुर्ती ज़ेही ऐडी गल्‍ला लै अर</para>
  <para style="q" vid="PSA 4:2">तम्हां केभै तैणीं रहणअ शल़ैघा पिछ़ू ठुहर्दै लागी।<verse eid="PSA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />ऐहा गल्‍ला करै आद कि बिधाता आसा सोभै धर्मीं मणछ आप्पू लै डाहै दै</para>
  <para style="q" vid="PSA 4:3">अर ज़ेभै हुंह अरज़ करूं, सह हेरा तेभै मेरी शूणीं।<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />पर तम्हैं सोभै रहा डरदै-काम्बदै अर पाप करनअ छ़ाडा।</para>
  <para style="q" vid="PSA 4:4">एते बारै सोठा धोरै करै दिला का</para>
  <para style="q" vid="PSA 4:4">ज़ेभै तम्हैं कांगनरांगै आपणैं च़ैन्‍नै होए सुत्तै दै।<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">इफि. 4:26</ref></char></note><verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />बिधाता लै करा धर्मीं बल़ीदान</para>
  <para style="q" vid="PSA 4:5">अर रहा बी तेऊए ई भरोस्सै।<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />कई मणछ आसा इहै ज़ुंण एही अरज़ करा,</para>
  <para style="q" vid="PSA 4:6">“हे बिधाता, हाम्हां लै दै खास्सी बर्गत,</para>
  <para style="q" vid="PSA 4:6">तूह भाल़ हाम्हां झणैल़ू हई करै!”<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />पर ज़ुंण नंद तंऐं मुल्है दैनी,</para>
  <para style="q" vid="PSA 4:7">सह आसा तिन्‍नें खास्सी साल-फसल, नाज़</para>
  <para style="q" vid="PSA 4:7">अर दाखे रसा का बी खास्सी।<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />हुंह सका निहंचै राची निंजा सुत्ती</para>
  <para style="q" vid="PSA 4:8">किल्हैकि तूह बिधाता करा आप्पै मेरी फाज़त।<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">मज़त मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो बशूरी संघै बोलअ द भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />हे बिधाता, मेरी गल्‍ला शुण,</para>
  <para style="q" vid="PSA 5:1">हुंह भाल़ किहअ धकदअ आसा लागअ द।<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />ए मेरै राज़ैआ, मेरै परमेशर,</para>
  <para style="q" vid="PSA 5:2">मंऐं पाई ताह सेटा मज़त मांगणा लै पकार।</para>
  <para style="q" vid="PSA 5:2">हुंह करा ताह ई सेटा अरज़।<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />ए मेरै बिधाता, तूह शूणां दोत्ती मेरै बोल,</para>
  <para style="q" vid="PSA 5:3">धैल़अ निखल़णैं का आजी करा हुंह, ता सेटा अरज़</para>
  <para style="q" vid="PSA 5:3">संघा रहा हुंह ताखा ज़बाबा न्हैल़अ लागी।<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />किल्हैकि तूह आसा इहअ परमेशर</para>
  <para style="q" vid="PSA 5:4">ज़ुंण कदुष्ट कामां का खुश निं हंदअ।</para>
  <para style="q" vid="PSA 5:4">पापी मणछ निं ताह सेटा एछी सकदै,<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />नां घमंडी मणछ ताह आजू खल़्हुई सकदै।</para>
  <para style="q" vid="PSA 5:5">तूह करा कदुष्ट मणछा का नफरत।<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />झ़ुठअ बोल़णैं आल़ै करा तूह खतम,</para>
  <para style="q" vid="PSA 5:6">हत्या अर छ़ल़-कपट करनै आल़ै मणछा का बी करा तूह बिधाता नफरत।<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />पर हे बिधाता, मुल्है किई तंऐं झ़ूरी,</para>
  <para style="q" vid="PSA 5:7">अर तैही एछणअ हुंह तेरै भबना भितरा लै।</para>
  <para style="q" vid="PSA 5:7">मुंह करनअ तेरै पबित्र भबनै तेरअ भज़न अर</para>
  <para style="q" vid="PSA 5:7">तिधी टेक्‍कणअ मुंह ताह सेटा माथअ।<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />हे बिधाता, मेरै आसा खास्सै दुशमण!</para>
  <para style="q" vid="PSA 5:8">मुखा कराऊ तिहअ, ज़िहअ तूह च़ाहा,</para>
  <para style="q" vid="PSA 5:8">मुखा खोज़ आपणीं शिक्षा धोरै करै।<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />मेरै दुशमण निं शुची गल्‍ला बोल्दै,</para>
  <para style="q" vid="PSA 5:9">तिंयां च़ाहा होरी बरैबाद ई करनअ।</para>
  <para style="q" vid="PSA 5:9">तिन्‍नें गल्‍ला आसा बृथा, घुआल़ी घोरी का ल्हासे शल़ैन्हां ज़ेही।</para>
  <para style="q" vid="PSA 5:9">तिन्‍नें हर गल्‍ला दी आसा धोखअ अर मौत।<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:3">रोम. 3:3</ref></char></note><verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />हे बिधाता, तिन्‍नां लोल़ी तेरअ दोश लागअ अर तिन्‍नां लै दै सज़ा।</para>
  <para style="q" vid="PSA 5:10">तिन्‍नें च़ाल लोल़ी तिन्‍नां ई लै उल़्टी पल़ी,</para>
  <para style="q" vid="PSA 5:10">तिन्‍नां कर आप्पू सेटा का दूर</para>
  <para style="q" vid="PSA 5:10">किल्हैकि तिन्‍नैं किअ खास्सअ पाप</para>
  <para style="q" vid="PSA 5:10">किल्हैकि तिन्‍नैं किअ ताल्है द्रोह।<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />पर ज़ुंण ताह बिधाता सेटा शरण लआ, तिन्‍नां सोभी लोल़ी नंद हुई,</para>
  <para style="q" vid="PSA 5:11">तिंयां लोल़ी सदा खुशी दी गिहा लांदै रहै।</para>
  <para style="q" vid="PSA 5:11">ज़ुंण ताल्है झ़ूरा, तिन्‍नें कर फाज़त,</para>
  <para style="q" vid="PSA 5:11">ताह करै आसा तिंयां खुश।<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />किल्हैकि ज़ुंण ताह बिधाते शूणां, तिन्‍नां लै दैआ तूह बर्गत।</para>
  <para style="q" vid="PSA 5:12">मालक, तेरी झ़ूरी करा तिन्‍नें ढाल़ा ज़ेही फाज़त।<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">घाटीए पलका अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै खर्ज रागा दी तारा आल़ै बाज़ै संघै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />हे बिधाता, मुल्है निं रोश्श करी नां सज़ा दैई,</para>
  <para style="q" vid="PSA 6:1">नां तेभै मुंह नैरदअ लागी ज़ेभै ताह रोश्श होए आई दी।<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">भज. 38:1</ref></char></note><verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />हे बिधाता, मुल्है कर झींण! हुंह हुअ दुबल़अ,</para>
  <para style="q" vid="PSA 6:2">तूह दै मुल्है बल, मुंह निं तराण ई रहै<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />अर मेरअ शाह चुटअ पठी।</para>
  <para style="q" vid="PSA 6:3">हे बिधाता, ताह केभै तैणीं निं मेरी मज़त करनी?<verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />हे बिधाता, फिरी एछ अर मुंह बच़ाऊ,</para>
  <para style="q" vid="PSA 6:4">तूह बच़ाऊ मुंह मरनै का किल्हैकि तूह आसा खास्सअ झणैल़ू।<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />ज़ै हुंह मरी जाए, तेखअ निं हुंह ताह भज़ी सकदअ,</para>
  <para style="q" vid="PSA 6:5">नां हुंह तेरअ शूकर करी सकदअ!<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />हुंह थक्‍कअ ऐबै धक्‍की-धक्‍की,</para>
  <para style="q" vid="PSA 6:6">राची हआ कबल्‍लअ मेरअ च़ैन सिन्‍नअ</para>
  <para style="q" vid="PSA 6:6">अर मेरअ शरैहण भिज़ा आशू करै पठी।<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />मेरी आछी फिरा लेरी-लेरी पाल्‍ली,</para>
  <para style="q" vid="PSA 6:7">मेरै दुशमणै लरैऊअ हुंह इहअ कि</para>
  <para style="q" vid="PSA 6:7">मुखा निस्सअ शुझुई बी, मेरी आछी आसा शुंआंईं दी।<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />कदुष्ट मणछो, मुंह सेटा का डेओआ पोर्ही!</para>
  <para style="q" vid="PSA 6:8">बिधाता हेरी मेरी लेरा-पकारा शूणीं।<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">मोत्त. 7:23</ref></char></note><verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />बिधाता हेरी मेरी लेर-पकार शूणीं कि मंऐं मांगी तेऊ का मज़त</para>
  <para style="q" vid="PSA 6:9">अर ज़ुंण मंऐं अरज़ किई तेतो ज़बाब हेरनअ तेऊ दैई।<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />तेखअ हणैं मेरै दुशमण शर्मिंदै अर तिन्‍नां पल़णअ हैल़अ,</para>
  <para style="q" vid="PSA 6:10">तिन्‍नां लागणअ पठी बेइज़त हई तिधा का छ़ेक्‍कै ठुहर्नअ।<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">बिधाता करा हर बगत भलअ</para>
  <para style="d">राज़ै दाबेदो शिग्गायोन नाओं भज़न। अह भज़न बोलअ त तेऊ बिधाता सेटा बिन्यामीन गोत्रे कूशा पिछ़ू।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />हे मेरै परमेशर बिधाता, हुंह एछा तेरी शरणा दी,</para>
  <para style="q" vid="PSA 7:1">ज़ुंण मुंह पिछ़ू आसा पल़ै दै,</para>
  <para style="q" vid="PSA 7:1">तूह बच़ाऊ मुंह तिन्‍नां का संघा दै मुल्है छ़ुटकारअ।<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />इहअ निं हआ कि तिंयां मुंह सिहा ज़िहै धेल़े-च़िरे</para>
  <para style="q" vid="PSA 7:2">अर ज़िधी मुंह बच़ाऊंदअ कोहै निं होए</para>
  <para style="q" vid="PSA 7:2">अर तिंयां मेरै च़िथल़ै-च़िथल़ै करे!<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3-4" style="v" sid="PSA 7:3-4" />हे मेरै परमेशर बिधाता, ज़ै मंऐं कहा लै बूरअ किअ होए,</para>
  <para style="q" vid="PSA 7:3-4">ज़ै मंऐं कहा साथी-संघी लै धोखअ किअ होए,</para>
  <para style="q" vid="PSA 7:3-4">ज़ै मंऐं थोघै बाझ़ी आपणैं दुशमणा लै बी ज़ुल्म किअ होए,</para>
  <para style="q" vid="PSA 7:3-4">ज़ै मंऐं इना मांझ़ै एक बी गलती किई होए<verse eid="PSA 7:3-4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />तै दैऐ तूह मेरै दुशमणा मेरअ पिछ़अ करनै अर ढाकणैं,</para>
  <para style="q" vid="PSA 7:5">तै दैऐ तूह तिन्‍नां मुंह मारी पाणै</para>
  <para style="q" vid="PSA 7:5">अर मेरी ल्हासा माट्टै जैंदरी बदल़ी डाहणैं।<verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />हे बिधाता, तूह आण आप्पू लै रोश्शै!</para>
  <para style="q" vid="PSA 7:6">रोश्शै लाल-पिंऊंल़ै हुऐ दै मेरै दुशमणा सम्हनै हअ तूह मेरी तैणीं आप्पै खल़अ,</para>
  <para style="q" vid="PSA 7:6">ऐबै कर तूह ई मेरी मज़त अर</para>
  <para style="q" vid="PSA 7:6">तंऐं आसा हेरअ द नसाफ करी।<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />देशा-देशे लोगो झाल़अ लोल़ी ताह फेर हुअ अर</para>
  <para style="q" vid="PSA 7:7">तंऐं लोल़ी तिन्‍नां प्रैंदै आपणअ आसन लाई राज़ किअ।<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />हे बिधाता, तूह दैआ सोभी लोगा लै नसाफ।</para>
  <para style="q" vid="PSA 7:8">ऐबै कर तूह मेरअ बी नसाफ,</para>
  <para style="q" vid="PSA 7:8">ताखा आसा थोघ कि हुंह आसा नर्दोश।<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />तूह बिधाता आसा धर्मीं अर</para>
  <para style="q" vid="PSA 7:9">तूह हेरा म्हारै मन्‍न अर बच़ार परखी।</para>
  <para style="q" vid="PSA 7:9">इना कदुष्टे ज़ुल्म कर खतम अर</para>
  <para style="q" vid="PSA 7:9">धर्मीं मणछा लोल़ी भलअ फल भेटअ।<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 2:23">प्रका. 2:23</ref></char></note><verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />बिधाता करा मेरी फाज़त अर</para>
  <para style="q" vid="PSA 7:10">ज़ुंण दिले शुचै आसा, तिन्‍नां डाहा सह बच़ाऊई।<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />परमेशर आसा धर्मीं अर सह करा नसाफ अर</para>
  <para style="q" vid="PSA 7:11">कदुष्टा लै दैआ सह कबल्‍ली सज़ा।<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />ज़ै कदुष्ट मणछ बूराईए बाता का पिछ़ू नांईं हटे,</para>
  <para style="q" vid="PSA 7:12">बिधाता डाहणीं आपणीं तलबार पल़ैई अर</para>
  <para style="q" vid="PSA 7:12">आपणअ धणश डाहणअ तैर करी।<verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />तेऊ च़कणै आपणैं इहै शस्त्र ज़ुंण प्रल़या करा,</para>
  <para style="q" vid="PSA 7:13">संघा छ़ाडणैं तेऊ आपणैं ज़ल़दी आगीए कतीर।<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />कदुष्ट मणछ सोठा ज़ुल्म ई करने बारै,</para>
  <para style="q" vid="PSA 7:14">तिंयां सोठा उपद्रभ करने बारै संघा करा आफ़त खल़ी।<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />पर ज़ुंण खात्ती तिंयां होरी लै खण्हां अर</para>
  <para style="q" vid="PSA 7:15">ज़ुंण ज़बाल़ तिंयां होरी लै ढोहा, तेथ मरा तिंयां आप्पू ई।<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />तिंयां ज़ुंण उपद्रभ करा अर होरी लै आफ़त पाआ,</para>
  <para style="q" vid="PSA 7:16">सह हआ तिन्‍नें आपणैं ज़िऊआ लै ज़ज़ाल़।<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />हुंह करा परम प्रधान परमेशर बिधातो शूकर कि तेऊ किअ नसाफ,</para>
  <para style="q" vid="PSA 7:17">मुंह करनी भज़न बोली तेऊए ज़ै-ज़ैकार।<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">बिधातो महान नाअं</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै गितीत रागा दी राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />हे मेरै मालक, म्हारै बिधाता,</para>
  <para style="q" vid="PSA 8:1">तेरअ महान नाओं प्रतप्प पुजअ सारै संसारै!</para>
  <para style="q" vid="PSA 8:1">अर स्वर्गै भाल़ी सोभी तेरी ठाहठ।<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />लान्हैं-सुन्हैं आसा तेरी ज़ै-ज़ैकार करदै लागै दै,</para>
  <para style="q" vid="PSA 8:2">इहअ करै निं तेरै दुशमणा अर</para>
  <para style="q" vid="PSA 8:2">बरोधी का किछ़ै ज़बाब रहअ।<verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />हुंह लागा तेरै हाथै बणाऐं दै सरगा भाल़अ अर</para>
  <para style="q" vid="PSA 8:3">ज़ोथ अर तारै ज़ुंण तंऐं तेथ टकैल़ी आसा डाहै दै,<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />तै सोठा हुंह इहअ कि हाम्हैं मणछ किज़ै आसा कि ताह लागा म्हारै बारै सोठणअ?</para>
  <para style="q" vid="PSA 8:4">हाम्हां मणछा बाखा किज़ू दैणअ ताह धैन?<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />तंऐं बणाअं मणछ आप्पू का धख ई होछ़अ,</para>
  <para style="q" vid="PSA 8:5">तंऐं दैनअ तेऊ लै इज़त अर अदरो मुगट।<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />ज़ुंण आपणैं हाथै तंऐं संसार बणाअं, तंऐं बणाऐं तेते सैणैं मणछ ई,</para>
  <para style="q" vid="PSA 8:6">अर सोभी ज़ीबा प्रैंदै राज़ दैनअ तंऐं तिन्‍नां ई लै।<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />डागै-चैणैं, सोभै बणें ज़ीब,<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />सरगै डैऊंदै च़ेल्‍लू-पखीरू,</para>
  <para style="q" vid="PSA 8:8">समुंदरे म्हाछ़ली अर तेते सोभै ज़ीब।<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />बिधाता, तेरअ महान काम शुझिआ</para>
  <para style="q" vid="PSA 8:9">पृथूई दी सारै इना सोभी गल्‍ला दी।<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">ज़ितणा लै करा बिधातो शूकर</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै मुतलबैण रागा दी राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />महान बिधाता, मुंह करनी दिला का तेरी ई ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 9:1">ज़ुंण महान काम तंऐं आसा किऐ दै, तिंयां खोज़णैं मुंह सोभी का।<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />ताह पिछ़ू मनाऊंणी मुंह खुशी,</para>
  <para style="q" vid="PSA 9:2">तूह परम प्रधान परमेशर बिधाता आसा सोभी का बडअ, मुंह बोल़णैं तेरै ई भज़न।<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />ज़ांऊं तूह प्रगट हआ, मेरै दुशमणा लागा डरै पिछ़ू हटणअ,</para>
  <para style="q" vid="PSA 9:3">तिंयां बधल़िआ तेभै धरनीं संघा हआ तिंयां मरी हक्‍क।<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />तूह करा मानदार अर शुचअ फैंसलअ</para>
  <para style="q" vid="PSA 9:4">अर तंऐं किअ मेरअ नसाफ।<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />तंऐं दैनी होरी सोभी देशा लै चतैनगी</para>
  <para style="q" vid="PSA 9:5">अर कदुष्ट मणछ किऐ तंऐं खतम,</para>
  <para style="q" vid="PSA 9:5">तिन्‍नों निं तंऐं नाअं-नशाण बी डाहअ।<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />म्हारै दुशमण हुऐ सदा लै खतम,</para>
  <para style="q" vid="PSA 9:6">तंऐं किई तिन्‍नें बडी-बडी नगरी खतम अर</para>
  <para style="q" vid="PSA 9:6">तिंयां निं आजू कहा आद बी डाहणैं कि एथ बी रहा हंदअ होए कुंण।<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />पर तूह बिधाता आसा सदा लै राज़अ अर</para>
  <para style="q" vid="PSA 9:7">तूह आसा राज़गाद्दी प्रैंदै नसाफ करदअ बेठदअ द।<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />तूह आसा राज़अ धर्मीं अर</para>
  <para style="q" vid="PSA 9:8">तूह दैआ संसारे सोभी लोगा लै नसाफ।<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />रैनै-गरीबा लै शरण आसा तूह बिधाता ई,</para>
  <para style="q" vid="PSA 9:9">किल्हैकि आफ़तीए पलका लुक्‍कणा लै ज़ैगा आसा तिन्‍नां का तूह बिधाता ई।<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />ज़हा का ताह बिधाते बारै थोघ आसा, तिन्‍नां हआ तेरअ भरोस्सअ,</para>
  <para style="q" vid="PSA 9:10">ज़ुंण ताह सेटा एछा, तेऊ निं तूह कल्ही छ़ाडदअ।<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />बिधाता, तूह करा सियोन धारा का राज़! हाम्हां बोल़णैं तेरै भज़न</para>
  <para style="q" vid="PSA 9:11">ताकि सोभी देशे लोगा का तेरै महान कामें बारै थोघ लागे।<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />तूह निं हत्या करनै आल़ै लै सज़ा दैणीं बिस्सरदअ,</para>
  <para style="q" vid="PSA 9:12">ज़ुंण रैनै-गरीब ताह सेटा लेर-पकार पाआ,</para>
  <para style="q" vid="PSA 9:12">तिन्‍नें शूणां तूह ई।<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />हे बिधाता, तूह कर मुल्है झींण!</para>
  <para style="q" vid="PSA 9:13">भाल़, मेरै दुशमणै आणअ हुंह हारी-मारी!</para>
  <para style="q" vid="PSA 9:13">तूह आण मुंह मौते दुआरा का छ़ड़ैऊई!<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />ताकि हुंह एरुशलेम नगरीए लोगा सेटा डेऊई</para>
  <para style="q" vid="PSA 9:14">तिन्‍नां सोभी गल्‍ला खोज़ूं ज़ेता लै हुंह तेरी ज़ै-ज़ैकार करा।</para>
  <para style="q" vid="PSA 9:14">मुंह रहणअ तिधी खुश किल्हैकि तंऐं बच़ाऊअ हुंह।<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />पराई ज़ातीए लोगै ज़ुंण खात्ती ती खण्हीं दी, तिंयां पल़ै तेथ आप्पू ई,</para>
  <para style="q" vid="PSA 9:15">ज़ुंण ज़ज़ाल़ तिन्‍नैं होरी लै डाहअ त छ़ैई, तेथ शाची तिन्‍नें आपणीं ई ज़ांघा।<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />हे बिधाता, तंऐं हेरअ नसाफ करी अह गल्‍ल प्रगट करी कि तूह आसा धर्मीं राज़अ,</para>
  <para style="q" vid="PSA 9:16">पर कदुष्ट मणछ शाचै तिन्‍नें आपणैं ई कामां करै।<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />कदुष्ट मणछ डेऊणैं सोभै जम्परी ई,</para>
  <para style="q" vid="PSA 9:17">ज़ुंण देश ताह नांईं मंदै, तिन्‍नां लै बी आसा मौत ई।<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />रैनै-गरीब निं सदा बिस्सरी डाहणैं,</para>
  <para style="q" vid="PSA 9:18">नां तिन्‍नें आशा सदा लै खतम हणीं।<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />हे बिधाता, ऐबै एछ, मणछ निं लोल़ी ज़ितै,</para>
  <para style="q" vid="PSA 9:19">देशा-देशे लोग लोल़ी तेरी दालता दी एछी झ़ुकै,</para>
  <para style="q" vid="PSA 9:19">अर तिधी लोल़ी तंऐं आप्पै नसाफ किअ।<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />तिन्‍नां मणछा लोल़ी तेरी डअर पल़ी,</para>
  <para style="q" vid="PSA 9:20">तिन्‍नां का लोल़ी ज़ाण्हुंअ कि तिंयां आसा मणछ ई।<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">मज़त मांगणा लै अरज़ करनी</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />हे बिधाता, तूह किल्है हुअ हाम्हां का दूर?</para>
  <para style="q" vid="PSA 10:1">खरीए पलका किल्है लुक्‍कअ तूह?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />कदुष्ट हुऐ शरेरै, तिन्‍नैं लाऐ रैनै-गरीब हारी-मारी,</para>
  <para style="q" vid="PSA 10:2">ज़ुंण खल़ाक्‍की तिन्‍नैं होरी लै आसा ढोही दी, तिंयां लोल़ी तेथ आप्पू ई शाचै।<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />कदुष्ट करा आपणैं बूरै खैला लै घमंड,</para>
  <para style="q" vid="PSA 10:3">तिंयां मांणक्‍करै मणछ निं तेरी कदर करदै अर तिंयां दैआ ताह बिधाता लै फिटक।<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />कदुष्ट मणछ आसा इहै घमंडी कि</para>
  <para style="q" vid="PSA 10:4">तिंयां निं ताह इहअ बी समझ़दै कि तूह बिधाता बी आसा होए।<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />कदुष्ट निं आपणीं बात छ़ाडदै,</para>
  <para style="q" vid="PSA 10:5">नां तिंयां ताह बिधातो नसाफ समझ़दै</para>
  <para style="q" vid="PSA 10:5">तिंयां दैआ तिन्‍नें दुशमणा लै बी धमकी।<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />तिंयां बोला आप्पू लै इहअ,</para>
  <para style="q" vid="PSA 10:6">“हाम्हां निं कुंण हारी सकदअ अर नां हाम्हां लै आफ़त सकदी पल़ी!”<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />तिंयां करा सिधी झ़ुठी, फिटक अर धमकी आल़ी गल्‍ला,</para>
  <para style="q" vid="PSA 10:7">तिन्‍नें खाखा का निखल़ा सिधी बृथा अर उपद्रभे ई गल्‍ला।<verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />तिंयां रहा किधी गराऊंऐं लुक्‍की,</para>
  <para style="q" vid="PSA 10:8">कहा नर्दोश मणछे हत्या करना लै ताखुई,</para>
  <para style="q" vid="PSA 10:8">ज़सरी मज़त करनै आल़अ कोहै निं होए, तिंयां रहा तिहै मणछा ज़ाच़दै लागी।<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />तिंयां हआ भुखै सिहा ज़िहै शकार करना लै झ़ाकल़ै रहै दै लुक्‍की,</para>
  <para style="q" vid="PSA 10:9">तिंयां हआ रैनै-गरीबा न्हैल़ै-भाल़ै लागै दै</para>
  <para style="q" vid="PSA 10:9">संघा निंयां तिन्‍नां आपणैं ज़ज़ाल़ा दी चैल़ी घिशी-तल़िंगी!<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />रैनै-गरीब आणै इनै छेऊई अर</para>
  <para style="q" vid="PSA 10:10">तिन्‍नें ज़ोरा सेटा निस्सअ तिन्‍नें च़ल्हुई।<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />तिंयां बोला इहअ, “परमेशर निं किछ़ै धैन दैंदअ!</para>
  <para style="q" vid="PSA 10:11">तेऊ आसा आछी बुदरी डाही दी अर तेऊ का निं शुझदअ कि हाम्हैं किज़ै करा।”<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />हे परमेशर बिधाता, ऐबै दै तूह इना कदुष्ट मणछा लै सज़ा,</para>
  <para style="q" vid="PSA 10:12">रैनै-गरीबा बाखा निं पिठ डाहै फरेऊई।<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />कदुष्ट मणछ निं तेरी इज़त करदै,</para>
  <para style="q" vid="PSA 10:13">तिंयां बोला इहअ पै, “परमेशर निं हाम्हां लै सज़ा दैंदअ!”<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />पर तूह हेरा भाल़ी, ताखा जाआ खरी अर आफ़ता शुझुई,</para>
  <para style="q" vid="PSA 10:14">तूह हआ हर बगत मज़त करना लै तैर्हुई रहअ द।</para>
  <para style="q" vid="PSA 10:14">रैनै-गरीब लआ तेरी शरण अर</para>
  <para style="q" vid="PSA 10:14">छ़ुटै-मुक्‍कै दै लान्हैं निं तूह कल्ही छ़ाडदअ।<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />हे बिधाता, बूरै अर कदुष्ट मणछो बल कर तूह खतम,</para>
  <para style="q" vid="PSA 10:15">ज़ुंण कदुष्ट काम तिन्‍नैं किऐ, तेता लै रहअ तिन्‍नां तेभै तैणीं सज़ा दैंदअ लागी,</para>
  <para style="q" vid="PSA 10:15">ज़ेभै तैणीं तिन्‍नैं इहै काम छ़ाडै निं।<verse eid="PSA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />ए म्हारै बिधाता, तूह आसा सदा-सदा लै राज़अ,</para>
  <para style="q" vid="PSA 10:16">ज़ुंण होर देश ताह छ़ाडी होरी देबते पूज़ा करा,</para>
  <para style="q" vid="PSA 10:16">तिंयां हणैं तेरी ज़ैगा का खतम।<verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />हे बिधाता, तंऐं हेरी भोल़ै लोगे अरज़ शूणीं।</para>
  <para style="q" vid="PSA 10:17">ताह दैणअ तिन्‍नां लै आप्पै हैअ।<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />ताह करनअ छ़ुटै-मुक्‍कै अर रैनै-गरीबो नसाफ आप्पै,</para>
  <para style="q" vid="PSA 10:18">ताकि धरतीए मणछ आजू कधि बी</para>
  <para style="q" vid="PSA 10:18">होरी डरैऊंदै नांईं लागे।<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">बिधाता दी भरोस्सअ</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />मुंह आसा आपणैं बिधाता दी भरोस्सअ,</para>
  <para style="q" vid="PSA 11:1">तम्हैं किल्है बोला मुल्है एही ऐडी गल्‍ल,</para>
  <para style="q" vid="PSA 11:1">“च़ेल्‍लू ज़िहअ डैअ दैई डेऊ उझै ज़ोता लै।”<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />किल्हैकि कदुष्ट मणछ आसा न्हैरै दी लुक्‍की करै</para>
  <para style="q" vid="PSA 11:2">भलै मणछा लै कतीरा बाहणां लै ताखुई रहै दै।<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />ज़ै बधान काईदअ ई पठी बरैबाद होए,</para>
  <para style="q" vid="PSA 11:3">तै निं भलअ मणछ किछ़ै करी सकदअ।<verse eid="PSA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />बिधाता आसा आपणैं पबित्र भबनै,</para>
  <para style="q" vid="PSA 11:4">सह आसा स्वर्गै आपणीं राज़गाद्दी प्रैंदै बेठअ द।</para>
  <para style="q" vid="PSA 11:4">सह हआ सोभी मणछा भाल़अ लागअ द</para>
  <para style="q" vid="PSA 11:4">कि तिंयां किज़ै करा।<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />बिधाता परखा भलै अर बूरै मणछा राम्बल़ै करै,</para>
  <para style="q" vid="PSA 11:5">सह करा कदुष्ट मणछा का खास्सी नफरत।<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />तेऊ बरशाऊंणी कदुष्टा लै ज़ल़दी आग अर गंधक,</para>
  <para style="q" vid="PSA 11:6">तेऊ बरशाऊंणी कदुष्टा लै ज़ल़दी आग अर गंधक,<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />बिधाता आसा धर्मीं अर सह झ़ूरा भलै कामां लै,</para>
  <para style="q" vid="PSA 11:7">तेऊ सेटा सका सिधअ सह ई मणछ डेऊई ज़ुंण भलै काम करा।<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">मज़त मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै खर्ज रागा दी राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />हे बिधाता, ज़ीबाण मेरी मज़त कर!</para>
  <para style="q" vid="PSA 12:1">एथ निं एक मणछ बी भलअ रहअ,</para>
  <para style="q" vid="PSA 12:1">मानदार मणछ निस्सै तोप्पी करै बी भेटी।<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />सोभै बोला एकी-दुजै का झ़ुठअ!</para>
  <para style="q" vid="PSA 12:2">एकी-दुजै लै हआ तिन्‍नें होठै होर अर कोठै होर!<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />हे बिधाता, तिन्‍नें ठगणै आल़ै होठा अर</para>
  <para style="q" vid="PSA 12:3">डिंगा मारनै आल़ी ज़िभा पा काटी।<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />तिंयां बोला इहअ, “हाम्हां ज़ितणअ ज़िभे ज़ोरै,</para>
  <para style="q" vid="PSA 12:4">हाम्हां बोल़णअ ज़िहअ म्हारअ दिल च़ाहा तिहअ</para>
  <para style="q" vid="PSA 12:4">अर हाम्हां निं कुंण रोक्‍की सकदअ, नां म्हारअ कुंण मालक आथी।”<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />पर हे बिधाता, तूह बोल तिन्‍नां लै इहअ,</para>
  <para style="q" vid="PSA 12:5">“गरीब मणछ आणै हंती-हंती मारी</para>
  <para style="q" vid="PSA 12:5">अर छ़ुटै-मुक्‍कै दै लान्हैं लागै लेरदै,</para>
  <para style="q" vid="PSA 12:5">मुंह करनी तिन्‍नें फाज़त ताकि तिंयां राज्ज़ी-मौज़ी रहे।”<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />हे बिधाता, तेरी ज़बान हआ पाक्‍की,</para>
  <para style="q" vid="PSA 12:6">सह हआ च़ोखी च़ंदी ज़ेही</para>
  <para style="q" vid="PSA 12:6">ज़ेथ आरनैं साता बारी हआ पाण दैनी दी।<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7-8" style="v" sid="PSA 12:7-8" />हे बिधाता, हाम्हां का आसा थोघ</para>
  <para style="q" vid="PSA 12:7-8">तूह करा हारी-मारी आणै दै मणछे फाज़त,</para>
  <para style="q" vid="PSA 12:7-8">तिन्‍नां डाहा तूह सदा लै एऊ ज़मानें लोगा का बच़ाऊई।</para>
  <para style="q" vid="PSA 12:7-8">च़ाऐ कदुष्ट मणछ ज़ेतरै बी कल़ेल़ै किल्है निं फिरे अर</para>
  <para style="q" vid="PSA 12:7-8">सारै देशै बूराईए ज़ै-ज़ैकार किल्है निं होए हंदी लागी दी।<verse eid="PSA 12:7-8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">मोक्ष मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />हे बिधाता, ताह केभै तैणीं डाहणअ हुंह बिस्सरी? सदा लै?</para>
  <para style="q" vid="PSA 13:1">ताह केभै तैणीं डाहणीं मुंह बाखा पिठ फरेऊई?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />केभै तैणीं रहूं हुंह खरी काटदअ लागी?</para>
  <para style="q" vid="PSA 13:2">केभै तैणीं रहणअ मुंह धैल़-राच दुख पल़ी?</para>
  <para style="q" vid="PSA 13:2">केभै तैणीं रहणैं मेरै दुशमण मुंह च़िक्‍कदै लागी?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />हे मेरै परमेशर बिधाता, मुंह बाखा फिर, मेरी गल्‍लो ज़बाब दै हैनूं,</para>
  <para style="q" vid="PSA 13:3">मेरी आछी का लोल़ी भिई शुझदअ लागअ, मुंह निं सदा लै निंजा सुत्ती मरनै दैई।<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />नांईं ता मेरै दुशमणा बोल़णअ इहअ,</para>
  <para style="q" vid="PSA 13:4">“हाम्हैं ज़ितै तेऊ का!” तिन्‍नां निं मेरी बरैबादीए खुशी दैई मनाऊंणै।<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />मुंह आसा भरोस्सअ कि तूह झ़ूरा मुल्है,</para>
  <para style="q" vid="PSA 13:5">मुंह हणअ खुश किल्हैकि तंऐं हेरअ हुंह बच़ाऊई।<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />हे बिधाता, मुंह बोल़णीं तेरी गिहा,</para>
  <para style="q" vid="PSA 13:6">किल्हैकि तूह आसा मुल्है खास्सअ भलअ।<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">कमुर्ख मणछे कदुष्ट काम</para>
  <para style="r">(<ref loc="PSA 53:1-6">भज़न 53:1-6</ref>)</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />ऐडअ सोठा आपणैं मन्‍नैं इहअ, “परमेशर निं आथी ई!”</para>
  <para style="q" vid="PSA 14:1">इहै मणछ आसा भ्रष्ट गऐ दै हई,</para>
  <para style="q" vid="PSA 14:1">तिन्‍नें आसा बेघै च़िल़्हखरै काम अर</para>
  <para style="q" vid="PSA 14:1">तिन्‍नां मांझ़ै निं इहअ कोहै आथी ज़ुंण भलअ पाछा।<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />बिधाता हआ स्वर्गा का उंधै हाम्हां मणछा भाल़अ लागअ द कि</para>
  <para style="q" vid="PSA 14:2">कहा एकी बी आसा अक्ल?</para>
  <para style="q" vid="PSA 14:2">इहअ मणछ बी आसा ज़ुंण तेऊए लोल़-तोप करा?<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />पर सोभै मणछ आसा कबाता गऐ दै पेठी,</para>
  <para style="q" vid="PSA 14:3">ज़ाथी आसा सोभै भ्रष्ट गऐ दै हई।</para>
  <para style="q" vid="PSA 14:3">कोहै निं भलअ करदअ,</para>
  <para style="q" vid="PSA 14:3">ज़ाथी निं एक बी आथी!<verse eid="PSA 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />बिधाता बोला इहअ, “तिन्‍नां कबध खटणै आल़ै का थोघ ई निं आथी?</para>
  <para style="q" vid="PSA 14:4">तिन्‍नां मेरअ धैन ई निं आथी?</para>
  <para style="q" vid="PSA 14:4">मेरै लोग हारनै-मारनै हआ तिन्‍नां लै ज़ेही फुलकी खाणीं!</para>
  <para style="q" vid="PSA 14:4">मुंह सेटा अरज़, निं तिंयां कधि करदै ई!”<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />डरै छ़ुटणअ तिन्‍नां दर्छ़णअ,</para>
  <para style="q" vid="PSA 14:5">किल्हैकि बिधाता रहा सदा धर्मीं मणछा बाखा।<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />कबध खटणै आल़ै पाआ मानदार मणछे कामां दी खरोल़,</para>
  <para style="q" vid="PSA 14:6">पर बिधाता करा आपणैं लोगे फाज़त आप्पै।<verse eid="PSA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />बिधाता एछणअ इज़राईला बच़ाऊंदअ सियोन धारा का आप्पै!</para>
  <para style="q" vid="PSA 14:7">ज़ांऊं बिधाता आपणैं लोग गलामी का आज़ाद करनै,</para>
  <para style="q" vid="PSA 14:7">याकबा करनी ज़ोरै-ज़ोरै ज़ै-ज़ैकार अर</para>
  <para style="q" vid="PSA 14:7">इज़राईला हणीं नाच़णै जोगी खुशी। <note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="PSA 53:6">भज. 53:6</ref>; <ref loc="LUK 1:69">लूक. 1:69</ref> </char></note><verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">बिधाता सेटा कुंण सका एछी</para>
  <para style="d">दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />हे बिधाता, तेरै पबित्र खिम्भा भितरी कुंण सका डेऊई?</para>
  <para style="q" vid="PSA 15:1">तेरी पबित्र धारा कुंण सका बस्सी?<verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />तेथ सका सिधै तिंयां ई मणछ डेऊई ज़ुंण नर्दोश ज़िन्दगी ज़िऊआ अर</para>
  <para style="q" vid="PSA 15:2">कबल्‍लै भलअ ई करा,</para>
  <para style="q" vid="PSA 15:2">अर ज़ुंण दिला का शुची गल्‍ला बोला।<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />ज़ुंण होरीए बेइज़ती निं करदै,</para>
  <para style="q" vid="PSA 15:3">ज़ुंण आपणैं साथी-संघी लै बूरअ निं करदै अर</para>
  <para style="q" vid="PSA 15:3">नां तिन्‍नें फुआह पांदै।<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />ज़ुंण बिधाता निं मंदै तिन्‍नां समझ़ा तिंयां बृथा,</para>
  <para style="q" vid="PSA 15:4">पर बिधाते डरा हेठै रहणैं आल़ै मणछे करा तिंयां अदर।</para>
  <para style="q" vid="PSA 15:4">तिंयां निं सोह खाई करै हुधदै,</para>
  <para style="q" vid="PSA 15:4">च़ाऐ तेते किछ़ बी किम्मत किल्है निं पल़ै दैणीं।<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />तिंयां निं ढब्बै ऋण दैई बैज़ बी ढाकदै,</para>
  <para style="q" vid="PSA 15:5">नां तिंयां नर्दोश मणछे बारै झ़ुठअ बोल़णा लै रेशपत खांदै।</para>
  <para style="q" vid="PSA 15:5">ज़ुंण मणछ इना सोभी गल्‍ला करा,</para>
  <para style="q" vid="PSA 15:5">तिंयां रहणैं सदा बणी।<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">विश्वास अर आशा</para>
  <para style="d">राज़ै दाबेदो खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />हे परमेशर, मेरी फाज़त कर तूह ई</para>
  <para style="q" vid="PSA 16:1">मंऐं आसा ताह सेटा शरण लई दी।<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />हे बिधाता, हुंह बोला ताखा इहअ, “मेरअ मालक आसा तूह ई!</para>
  <para style="q" vid="PSA 16:2">ताह सुआई निं मुल्है होर किछ़ै भलअ आथी।”<verse eid="PSA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />धरती दी आसा तेरै धर्मीं मणछ ई महान असली मनणै जोगी!</para>
  <para style="q" vid="PSA 16:3">मुंह रहणअ तिन्‍नां ई संघै राज्ज़ी-मौज़ी।<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />ज़ुंण बगैनै देअ-देबी पूज़ा,</para>
  <para style="q" vid="PSA 16:4">तिन्‍नां लै पल़णीं आफ़ता प्रैंदै आफ़त।</para>
  <para style="q" vid="PSA 16:4">हुंह निं तिन्‍नां देअआ लै बल़ीदान अर लोहूओ अर्घअ दैंदअ</para>
  <para style="q" vid="PSA 16:4">अर नां तिन्‍नां सेटा माथअ टेक्‍कदअ।<verse eid="PSA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />हे बिधाता, मेरी ज़ैदात आसा तूह</para>
  <para style="q" vid="PSA 16:5">अर तूह दैआ मुल्है ज़ेही मुंह गरज़ पल़ी तेही,</para>
  <para style="q" vid="PSA 16:5">आजू बी आसा मेरी ज़िन्दगी तेरै ई हाथै।<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />ज़ुंण ज़ैगा तंऐं मुल्है बांडी दैनी, तिधी आसा मेरी मौज़</para>
  <para style="q" vid="PSA 16:6">अर आजू बी हणअ मेरै मज़अ ई।<verse eid="PSA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />हे बिधाता, मुंह करनी तेरी ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 16:7">किल्हैकि मुल्है भली सलाह दैआ तूह ई,</para>
  <para style="q" vid="PSA 16:7">राची बी रहा हुंह सोठदअ लागी कि मुंह किहअ लागा करनअ।<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />मुंह रहा इहअ धैस्स लागी कि तूह बिधाता आसा हर बगत मुंह संघै,</para>
  <para style="q" vid="PSA 16:8">मुंह निं कोहै डरैऊई सकदअ किल्हैकि तूह आसा मुंह सेटा आप्पै।<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />तैही रहा मेरअ मन्‍न खुश अर हुंह करा तेरअ शूकर,</para>
  <para style="q" vid="PSA 16:9">हुंह आसा निहंचै कि ताह करनी मेरी ज़िन्दगीए फाज़त।<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />तंऐं निं हुंह जम्परी डाही,</para>
  <para style="q" vid="PSA 16:10">मंऐं आसा तेरी च़ाकरी तत्त-दिला का किई दी,</para>
  <para style="q" vid="PSA 16:10">ताह निं हुंह डुघी घोरी चिजणैं दैणअ।<verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />तंऐं रहैऊई मुखा सह बात ज़ुंण ज़िन्दगी बाखा डेओआ,</para>
  <para style="q" vid="PSA 16:11">ताह नेल़ रहणैंओ धैस्स करा मुंह खुश अर</para>
  <para style="q" vid="PSA 16:11">ताह संघै रही एछा मुंह सदा लै नंद। <note caller="-" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">शधा. 2:25-28</ref> </char></note><verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">नर्दोश मणछा लै अरज़</para>
  <para style="d">राज़ै दाबेदे प्राथणां</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />हे बिधाता, मेरअ निं किछ़ै कशूर आथी!</para>
  <para style="q" vid="PSA 17:1">मेरी आसा ताखा एही अरज़ कि तूह कर मेरी मज़त,</para>
  <para style="q" vid="PSA 17:1">मेरै दिलै निं किछ़ै खोट आथी, ज़ीबाण मेरी अरज़ शुण।<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />मेरअ नसाफ कर तूह ई कि हुंह आसा नर्दोश,</para>
  <para style="q" vid="PSA 17:2">किल्हैकि ऐहा गल्‍ला ज़ाणा तूह ई।<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />ताखा आसा मेरै दिलो थोघ,</para>
  <para style="q" vid="PSA 17:3">तंऐं हेरअ हुंह सोभी गल्‍ला दी पठी परखी अर</para>
  <para style="q" vid="PSA 17:3">ताह निं मुंह दी किछ़ै खोट भेटी,</para>
  <para style="q" vid="PSA 17:3">हुंह निं कहा लै बूरअ बोल्दअ ई आथी।<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />हुंह निं इना होरी ज़िहअ करदअ आथी।</para>
  <para style="q" vid="PSA 17:4">हुंह करा तिहअ ई ज़िहअ तूह हुकम करा,</para>
  <para style="q" vid="PSA 17:4">नां हुंह कदुष्ट अर नर्दैई मणछे संगत करदअ।<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />ज़ेसी तूह बोला, हुंह हांढा तेस्सी ई,</para>
  <para style="q" vid="PSA 17:5">हुंह निं तैहा बाता का ओर्ही नां पोर्ही फिरदअ।<verse eid="PSA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />हे परमेशर, हुंह करा ताह सेटा अरज़ किल्हैकि ताखा जाआ मुंह तेतो ज़बाब भेटी,</para>
  <para style="q" vid="PSA 17:6">ऐबै फिर मुंह बाखा संघा शुण मेरी अरज़।<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />आपणीं महान झ़ूरी कर मुल्है प्रगट,</para>
  <para style="q" vid="PSA 17:7">तेरै महान बला करै आसा हुंह मेरै दुशमणा का आझ़ तैणीं राज्ज़ी-राम्बल़अ रहअ द।<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />मुंह डाह आपणीं आछी ज़िहअ बच़ाऊई अर</para>
  <para style="q" vid="PSA 17:8">मुंह डाह आपणैं फैंखा हेठै बुदरी।<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />मुल्है ज़ुल्म करनै आल़ै कदुष्ट मणछा अर</para>
  <para style="q" vid="PSA 17:9">मेरै तिन्‍नां दुशमणा का बच़ाऊई ज़ुंणी हुंह फेरा-फेर गोटी मारी आसा लाअ द।<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />तिंयां आसा खास्सै नर्दैई अर</para>
  <para style="q" vid="PSA 17:10">तिंयां फिरा मुल्है शरेरै।<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />तिन्‍नैं गोटअ हुंह ऐबै फेरा-फेर,</para>
  <para style="q" vid="PSA 17:11">तिंयां आसा मुंह धरनीं बदल़ी मारना लै ताखुऐ दै।<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />तिंयां आसा भुखै बराघा शकार करना लै अर</para>
  <para style="q" vid="PSA 17:12">सिहा ज़िहै मुंह धेल़दै-च़िरदै ताखुई रहै दै।<verse eid="PSA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />हे बिधाता, ऐबै एछ, मेरै इना दुशमणे पिठ लाआ तूह आप्पै!</para>
  <para style="q" vid="PSA 17:13">आपणीं तलबारे ज़ोरै बच़ाऊ मुंह इना कदुष्टा का।<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />हे बिधाता, मुंह बच़ाऊ आपणीं बाहे बला करै,</para>
  <para style="q" vid="PSA 17:14">इना लोगा लै दै सज़ा ज़ुंण एऊ संसारे ई ज़िन्दगी लै झ़ूरा।</para>
  <para style="q" vid="PSA 17:14">पर ज़ुंण ताल्है झ़ूरा तिन्‍नां लै दैआ तूह आपणैं भढारा का।</para>
  <para style="q" vid="PSA 17:14">तिन्‍नें लान्हैं का हआ बतेर्हअ अर आजू रहा सह ज़ैदात पोस्ती दर पोस्ती तिन्‍नें पल़पोचै तैणीं।<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />हे बिधाता, हुंह आसा नर्दोश अर हुंह सका तेरअ मुंह भाल़ी!</para>
  <para style="q" vid="PSA 17:15">सुत्ती उझ़ुई च़ाहा हुंह ताह तिहअ ई भाल़णअ ज़िहअ तूह आसा।<note caller="-" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="PSA 4:6-7:1">भज. 4:6—7:1</ref>; <ref loc="1JN 3:2">1 जोह. 3:2</ref> </char></note><verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">बिधातो शूकर करना लै राज़ै दाबेदै बोली दी गिह</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 शमूएल 22:1-51</ref>)</para>
  <para style="d">बिधाते च़ाकरी करनै आल़ै राज़ै दाबेदे गाज़ै-बाज़ै आल़ेए सैणैं लै गिह, ज़धू सह बिधाता तेऊए दुशमण अर राज़ै शाऊला का बच़ाऊअ त, तधू बोली ती तेऊ अह गिह।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />हे बिधाता, हुंह झ़ूरा ताल्है</para>
  <para style="q" vid="PSA 18:1">अर मेरअ बल आसा तूह ई।<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />तूह परमेशर बिधाता आसा मुल्है बडी टोल्हा अर मुंह फेर उछ़टै गहल़ा ज़िहअ</para>
  <para style="q" vid="PSA 18:2">ज़ेथ पिछ़ू शरण लई हुंह बच़ी रहा।</para>
  <para style="q" vid="PSA 18:2">तूह बच़ाऊआ मुंह ढाल़ा ज़िहअ,</para>
  <para style="q" vid="PSA 18:2">मेरी फाज़त करा तूह ई</para>
  <para style="q" vid="PSA 18:2">अर तूह डाहा मुंह राज्ज़ी-राम्बल़ै बच़ाऊई।<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />मुंह करनी ताह बिधाता सेटा अरज़,</para>
  <para style="q" vid="PSA 18:3">तंऐं बच़ाऊअ हुंह मेरै दुशमणा का,</para>
  <para style="q" vid="PSA 18:3">ज़ै-ज़ैकार करनै जोगी आसा तूह ई।<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />मौतै हेरअ हुंह राश्शी ज़िहअ फेरा-फेर कशी!</para>
  <para style="q" vid="PSA 18:4">बनाश करनै आल़ी गाडे हर्हला जैंदरी च़ाल्‍लअ हुंह डुबी।<verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />मेरै मुंडा प्रैंदै थिई मौत रिंगदी लागी दी,</para>
  <para style="q" vid="PSA 18:5">अर मौते थिई मुल्है बाता गंईं-गंईं दी फाही डाही दी ढोही!<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />हुंह त आफ़ता दी पल़अ द,</para>
  <para style="q" vid="PSA 18:6">मंऐं पाई ताह बिधाता सेटा पकार कि मेरी मज़त कर।</para>
  <para style="q" vid="PSA 18:6">मेरी पकार पुजी तेरै बसेरै तेरै कानै</para>
  <para style="q" vid="PSA 18:6">अर ज़ांऊं तंऐं अरज़ शूणीं हेरी।<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />सारी पृथूई हुई ज़ाज़री अर लोगा लागी डरै काम्मणीं,</para>
  <para style="q" vid="PSA 18:7">बडी-बडी धारे आथरी बी सिक्‍की आजू-पिछ़ू!</para>
  <para style="q" vid="PSA 18:7">किल्हैकि बिधाता आई एही खास्सी रोश्शै कि<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />तेऊए नाके ढुंण्हीं का लागअ धूँ निखल़दअ</para>
  <para style="q" vid="PSA 18:8">अर खाखा का आगीए लुपल़ै संघै ज़ल़दै-ज़ल़दै कोयलै निखल़दै।<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />तंऐं खोल्हअ स्वर्ग धुंघरा ज़िहअ संघा होथअ उंधै,</para>
  <para style="q" vid="PSA 18:9">तेरै खूरा हेठै तै घणैं काल़ै बादल़।<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />तूह आअ फैंखा आल़ै करूब स्वर्ग दूता प्रैंदै बेशी,</para>
  <para style="q" vid="PSA 18:10">संघा आअ बागरी ज़िहअ छ़ेक्‍कै डैअ दैई।<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />ताह फेर आसा घणैं पाणीं आल़ै न्हैरै बादल़,</para>
  <para style="q" vid="PSA 18:11">आप्पू आसा तूह तेता पिछ़ू।<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />ताह आजू लागै गुल़ूबिज़ल़ू हंदै अर</para>
  <para style="q" vid="PSA 18:12">बडै-बडै शरू अर बीज पल़दी।<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />ए परम प्रधान परमेशर बिधाता, तेरै बैणै छ़ाडी सरगा का गुल़ूबिज़ल़ू ज़ेही छ़ेल़,</para>
  <para style="q" vid="PSA 18:13">तेखअ लागै बडै-बडै शरू अर आग बरशदी।<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />तंऐं खद्रेल़ै आपणैं दुशमण कतीर बाही ओर्ही-पोर्ही,</para>
  <para style="q" vid="PSA 18:14">तिन्‍नां लै शोटी तंऐं सरगा का बीज अर तिन्‍नां जैंदरी पल़अ घणअ झाख।<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />हे बिधाता, ज़ांऊं तंऐं एक झांश काढी अर</para>
  <para style="q" vid="PSA 18:15">तेरै नाके ढुंण्हींए शाहे ज़ोरा करै शुझुऐ</para>
  <para style="q" vid="PSA 18:15">डुघै समुंदरे थाल्‍लै अर</para>
  <para style="q" vid="PSA 18:15">पृथूईए गाडा नाल़ी हुई पठी नांगी!<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />तंऐं खिंच़अ हुंह स्वर्गा का आपणीं बाह करै</para>
  <para style="q" vid="PSA 18:16">डुघै समुंदरे पाणीं जैंदरा का उझै।<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />तंऐं बच़ाऊअ हुंह मेरै तिन्‍नां सोभी दुशमणा का</para>
  <para style="q" vid="PSA 18:17">ज़ुंण मुंह संघै ज़ीद डाहा तै,</para>
  <para style="q" vid="PSA 18:17">किल्हैकि तिंयां थिऐ बेघै खास्सै बलबान।<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />हे बिधाता, खरीए पलका गोटअ हुंह तिन्‍नैं फेरा-फेर,</para>
  <para style="q" vid="PSA 18:18">पर तेभै किई तंऐं मेरी फाज़त।<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />तंऐं किअ हुंह आफ़ता का दूर,</para>
  <para style="q" vid="PSA 18:19">हुंह छ़ड़ैऊअ तंऐं किल्हैकि तूह झ़ूरा मुल्है खास्सअ।<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />तंऐं बिधाता दैनअ मुल्है धर्मीं हणैंओ पुआज़अ अर</para>
  <para style="q" vid="PSA 18:20">तंऐं दैनी मुल्है बर्गत किल्हैकि मेरै दिलै निं किछ़ै खोट आथी।<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />हुंह करा तिहअ ई ज़िहअ तूह बिधाता मुल्है बोला,</para>
  <para style="q" vid="PSA 18:21">ताह छ़ाडी निं हुंह कधि कबाता डेऊअ, इहअ पाप निं मंऐं किअ ई।<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />हुंह डाहा तेरअ बधान सदा आद,</para>
  <para style="q" vid="PSA 18:22">तंऐं ज़ेही बिधी खोज़ी, तिंयां किई मंऐं तेही ई पूरी।<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />हे बिधाता, ऐहा गल्‍ला ज़ाणा तूह कि मुखा निं किछ़ै खोट आथी,</para>
  <para style="q" vid="PSA 18:23">हुंह रहा कदुष्ट कामां का दूर ई।<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />हे बिधाता, तूह आसा मुल्है भलअ किल्हैकि मंऐं ज़िऊई धर्मीं ज़िन्दगी,</para>
  <para style="q" vid="PSA 18:24">तंऐं दैनी मुल्है बर्गत किल्हैकि हुंह रहअ ज़िहअ तूह च़ाहा तिहअ ई नर्दोश।<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />हे बिधाता, ज़ुंण ताल्है शुचै-पाक्‍कै आसा, तिन्‍नां लै आसा तूह बी तिहअ ई।</para>
  <para style="q" vid="PSA 18:25">ज़ुंण शुचै-पाक्‍कै रहा तिन्‍नां लै बी रहअ तिहअ ई शुचअ।<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />च़ांगै लै रहा तूह च़ांगअ,</para>
  <para style="q" vid="PSA 18:26">पर ज़ुंण कदुष्ट काम करा तिन्‍नां लै फिरा तूह क्रुखअ।<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />मानदार मणछ बच़ाऊऐ तंऐं</para>
  <para style="q" vid="PSA 18:27">पर घमंडी मणछ किऐ तंऐं शर्मिंदै।<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />हे बिधाता, मुल्है किअ प्रैश्शअ तंऐं ई,</para>
  <para style="q" vid="PSA 18:28">तंऐं किअ मेरअ न्हैरअ मुखा दूर।<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />तंऐं दैनअ मुल्है दुशमणा का ज़ितणा लै बल अर</para>
  <para style="q" vid="PSA 18:29">ताह करै सका हुंह कई नगरी ज़िती।<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />हे परमेशर बिधाता, तेरी बात आसा शुची-पाक्‍की,</para>
  <para style="q" vid="PSA 18:30">तेरै बैणा दी आसा सत्त।</para>
  <para style="q" vid="PSA 18:30">ज़ुंण ताह सेटा शरण लआ,</para>
  <para style="q" vid="PSA 18:30">तूह करा तिन्‍नें फाज़त।<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />हे बिधाता, ताह छ़ाडी निं होर कोहै परमेशर आथी!</para>
  <para style="q" vid="PSA 18:31">म्हारी शरण लणें बडी टोल्ह आसा तूह ई।<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />मुल्है बल दैणैं आल़अ आसा तूह परमेशर ई अर</para>
  <para style="q" vid="PSA 18:32">मुखा राम्बल़ी बात खोज़णैं आल़अ बी आसा तूह ई।<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />तूह दैआ मेरी ज़ांघा लै हरनी ज़िहअ ठुर्हनेओ ज़ोर अर</para>
  <para style="q" vid="PSA 18:33">तूह ई करा मुंह उछ़टी धारा प्रैंदै खल़अ।<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />तूह शखैल़ा मुखा जुध बिद्या,</para>
  <para style="q" vid="PSA 18:34">तैही सका हुंह कांस्से बडै धणशा दी डोर लाई।<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />हे बिधाता, तूह ई आसा मेरी बच़ाऊंणै आल़ी ढाल़,</para>
  <para style="q" vid="PSA 18:35">तंऐं हआ हुंह आपणैं खाणैं हाथा करै थम्हीं डाहअ द</para>
  <para style="q" vid="PSA 18:35">अर तेरअ बल डाहा मुंह राज्ज़ी-राम्बल़ै।<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />तंऐं बणाईं मुंह हांढणा लै बिरली बात,</para>
  <para style="q" vid="PSA 18:36">तेथ निं मेरै खूर फिशल़दै।<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />ज़ांऊं तैणीं मंऐं आपणैं दुशमण ढाकै निं, तेभै तैणीं रहणअ मुंह तिन्‍नें पिछ़ै पल़ी,</para>
  <para style="q" vid="PSA 18:37">ज़ेभै तैणीं मंऐं तिंयां पठी खतम निं किऐ, तेभै तैणीं निं हुंह पिछ़ू फिरदअ।<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />मुंह लिरनै तिंयां तलबारा कै इहै कि तिंयां निं खल़ै उझ़दै डाहणैं,</para>
  <para style="q" vid="PSA 18:38">तिंयां झेचणैं मुंह आपणैं खूरा हेठै।<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />तंऐं दैनअ मुल्है जुधा करनैओ बल अर</para>
  <para style="q" vid="PSA 18:39">मेरै दुशमणा प्रैंदै ज़ीत।<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />तंऐं दैनअ मुल्है इहअ बल कि मंऐं झेचै आपणैं खूरा करै तिन्‍नें कैल़ै,</para>
  <para style="q" vid="PSA 18:40">ज़ुंण मुंह संघै ज़ीद डाहा तै, तिंयां किऐ मंऐं पठी बरैबाद।<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />तिन्‍नैं मेरै दुशमणै पाई लैल़ा पकारा पर तिन्‍नां बच़ाऊंदअ निं कोहै आअ,</para>
  <para style="q" vid="PSA 18:41">तिन्‍नैं पाई बिधाता सेटा बी लेर-पकार पर तिन्‍नां निं किछ़ै ज़बाब भेटअ।<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />तिंयां चकोल्‍लै मंऐं धरनीं माट्टै जैंदरी,</para>
  <para style="q" vid="PSA 18:42">तिंयां शोटै मंऐं च़िक्‍करै ज़िहै ढेक्‍का।<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />हे बिधाता, तंऐं बच़ाऊअ हुंह द्रोही मणछा का,</para>
  <para style="q" vid="PSA 18:43">संघा दैनअ मुल्है तिन्‍नां पराई ज़ातीए लोगा प्रैंदै राज़,</para>
  <para style="q" vid="PSA 18:43">ज़हा हुंह बछ़ैणदअ बी नांईं त, तिंयां लागै मेरी च़ाकरी करदै।<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />ज़िहअ ई तिन्‍नैं मेरअ नाअं शूणअ,</para>
  <para style="q" vid="PSA 18:44">तिंयां परदेसी आऐ मुंह सेटा माथै टेक्‍कदै।<note caller="-" style="x"><char style="xo" closed="false">18:44 </char><char style="xt" closed="false"><ref loc="2SA 8:9-12">2 शमू. 8:9-12</ref></char></note><verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />तिन्‍नों चुटणअ हैअ ई अर</para>
  <para style="q" vid="PSA 18:45">तिंयां एछणैं आपणैं गहल़ा का काम्बदी-काम्बदी।<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />हे बिधाता, तूह आसा ज़िऊंदअ परमेशर!</para>
  <para style="q" vid="PSA 18:46">मुंह करनी तेरी ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 18:46">मुंह बच़ाऊंणै आल़अ आसा तूह अर</para>
  <para style="q" vid="PSA 18:46">मुंह करनी तेरी सारै दी बड़ैई।<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />हे परमेशर, तंऐं ज़ताऊअ हुंह मेरै दुशमणा का अर</para>
  <para style="q" vid="PSA 18:47">तंऐं किऐ देशा-देशे लोग मेरै बशै।<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />तंऐं बच़ाऊअ हुंह मेरै दुशमणा का।</para>
  <para style="q" vid="PSA 18:48">तंऐं डाहअ हुंह मेरै दुशमणा का दूर राज्ज़ी-राम्बल़अ अर</para>
  <para style="q" vid="PSA 18:48">तंऐं डाहअ हुंह उपद्रभी मणछा का बच़ाऊई।<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />हे बिधाता, मुंह करनी इना सोभी गल्‍ला पिछ़ू तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 18:49">मुंह करनी देशा-देशे लोगा मांझ़ै तेरी बड़ैई।<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />ज़ुंण राज़अ तंऐं आप्पै हुअ छ़ांटअ द, तेऊ लै दैआ तूह महान ज़ीत,</para>
  <para style="q" vid="PSA 18:50">तूह झ़ूरा राज़ै दाबेद अर तेऊ आद-लुआदा लै पोस्ती दर पोस्ती सदा।<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">सारअ संसार खोज़ा इहअ कि बिधाता केतरअ महान आसा</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />सरग करा ऐहा गल्‍ला प्रगट कि परमेशर किहअ महान आसा,</para>
  <para style="q" vid="PSA 19:1">एता भाल़ी जाआ थोघ लागी कि परमेशरै केही-केही कारीगीरी आसा किई दी!<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />एक धैल़ी खोज़ा दुजी धैल़ी का परमेशरे बारै गल्‍ला अर</para>
  <para style="q" vid="PSA 19:2">राच करा दुजी राची का परमेशरो ज्ञैन प्रगट।<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />नां तिन्‍नें बोली-भाषा आथी अर</para>
  <para style="q" vid="PSA 19:3">नां तिन्‍नें गल्‍ला शुण्हदी।<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />तज़ी बी पुजा सारी पृथूई दी तिन्‍नों समाद अर</para>
  <para style="q" vid="PSA 19:4">तिन्‍नें गल्‍ला शुण्हिंआं सारै संसारै।</para>
  <para style="q" vid="PSA 19:4">बिधाता आसा सुरज़ा लै खिम्भ बणाअं द,<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />सह निखल़ा दोत्ती तेता का लाल़ै ज़िहअ तैर्हुई अर</para>
  <para style="q" vid="PSA 19:5">सह हआ शूरबीरा ज़िहअ ठुहर दैणा लै तैर।<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />सह शुझिआ सरगै एकी पुंझ़ा का</para>
  <para style="q" vid="PSA 19:6">दुजै पुंझ़ै तैणीं हांढदअ अर</para>
  <para style="q" vid="PSA 19:6">तेऊए तात्तै धुप्पै का निं कोहै लुक्‍की सकदअ।<verse eid="PSA 19:6" /></para>
  <para style="s">बिधातो बधान</para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />बिधातो बधान आसा शुचअ-पाक्‍कअ,</para>
  <para style="q" vid="PSA 19:7">सह दैआ नऊंईं ज़िन्दगी।</para>
  <para style="q" vid="PSA 19:7">तेऊए हुकम आसा शुचै-पाक्‍कै अर</para>
  <para style="q" vid="PSA 19:7">तेता करै एछा आम मणछा अक्ल।<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />बिधातो बधान आसा भलअ,</para>
  <para style="q" vid="PSA 19:8">ज़ुंण तेता मना तिंयां रहा खुश।</para>
  <para style="q" vid="PSA 19:8">बिधाते हुकम आसा प्रैश्शै ज़िहै अर</para>
  <para style="q" vid="PSA 19:8">तिंयां दैआ ज़िऊंणें बुध।<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />बिधाते डरा हेठै रहणअ आसा भलअ,</para>
  <para style="q" vid="PSA 19:9">ज़ुंण सदा लै रहा।</para>
  <para style="q" vid="PSA 19:9">बिधातो बधान आसा शुचअ अर</para>
  <para style="q" vid="PSA 19:9">तेते हर गल्‍ला दी आसा नसाफ।<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />तिंयां आसा च़ोखै सुन्‍नैं का खास्सै लोभणैं आल़ै अर</para>
  <para style="q" vid="PSA 19:10">काशणीं का निटरनै आल़ै मखीरा का खास्सै मिठै।<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="PSA 119:72">भज. 119:72</ref>,<ref loc="PSA 119:103">103</ref></char></note><verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />मुंह तेरै दासा भेटा तेता करै ज्ञैन,</para>
  <para style="q" vid="PSA 19:11">ज़ुंण बिधातो बधान मना, तेऊ भेटा तेतो पुआज़अ।<verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />आप्पू दी खोट निं कोही का शुझदी!</para>
  <para style="q" vid="PSA 19:12">हे बिधाता, तूह कर मेरै गुप्त पाप दूर!<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />मुंह बच़ाऊ इहै पाप करनै का ज़ेता मेरअ दिल बोला करना लै,</para>
  <para style="q" vid="PSA 19:13">हुंह निं तेते बशै लोल़ी पल़अ।</para>
  <para style="q" vid="PSA 19:13">तै हणअ हुंह नर्दोश अर</para>
  <para style="q" vid="PSA 19:13">तैही रहणअ पाप करनै का बच़ी।<verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />हे बिधाता, मेरी गल्‍ला अर मेरै बच़ारा करै लोल़ी त तूह खुश हुअ,</para>
  <para style="q" vid="PSA 19:14">हे बिधाता, तूह ई आसा मेरी शरण लणें ज़ैगा अर मुंह बच़ाऊंणै आल़अ।<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">ज़ितणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />खरीए पलका हेरनी बिधाता तेरी लेर-पकार शूणीं।</para>
  <para style="q" vid="PSA 20:1">याकबे परमेशरा करनी तेरी सोभी आफ़ता का फाज़त।<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />तेऊ करनी आपणीं पबित्र ज़ैगा का तेरी मज़त अर</para>
  <para style="q" vid="PSA 20:2">तेऊ दैणअ ताल्है एरुशलेम नगरी का बल।<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />तेऊ मनणी तेरी सारी भैंटा अर</para>
  <para style="q" vid="PSA 20:3">सह हणअ तेरी हूम बल़ी अर मेल़-ज़ोल़े बल़ी करै खुश।<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />बिधाता लोल़ी ती तेरी दिला-मन्‍नें पूरी किई अर</para>
  <para style="q" vid="PSA 20:4">तूह लोल़ी हर गल्‍ला लै सफल हुअ।<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />तेरी ज़ीत शूणीं करनी ती तेखअ हाम्हां बी ज़ोरै-ज़ोरै ज़ैकार अर</para>
  <para style="q" vid="PSA 20:5">आपणैं परमेशरे नाओंऐं करनै तै फ्रहरै खल़ै।</para>
  <para style="q" vid="PSA 20:5">बिधाता लोल़ी ती तेरी प्राथणां शूणीं।<verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />ऐबै गअ मुखा थोघ लागी कि बिधाता दैआ आपणैं छ़ांटै दै राज़ै लै ज़ीत,</para>
  <para style="q" vid="PSA 20:6">सह शूणां पबित्र स्वर्गा का तेऊए अरज़ संघा दैआ</para>
  <para style="q" vid="PSA 20:6">आपणैं महान बला करै तेऊ लै ज़ीत।<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />कोई हआ आपणैं रथा या आपणैं घोल़ै प्रैंदै भरोस्सअ,</para>
  <para style="q" vid="PSA 20:7">पर ए म्हारै परमेशर बिधाता,</para>
  <para style="q" vid="PSA 20:7">म्हारअ भरोस्सअ आसा तूह।<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />तिंयां इहै लोग बधल़णैं धरनीं उटी बाखा,</para>
  <para style="q" vid="PSA 20:8">पर हाम्हैं रहणैं आज़रै खल़ै टेक्‍की।<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />हे बिधाता, तूह दै राज़ै लै ज़ीत अर</para>
  <para style="q" vid="PSA 20:9">ज़ेभै हाम्हैं अरज़ करे, तेभै लऐ म्हारी शूणीं।<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">बिधाता लै शूकर</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />हे बिधाता, तेरअ महान बल दैआ राज़ै बी खुश करी,</para>
  <para style="q" vid="PSA 21:1">सह मनाऊंआं खुशी किल्हैकि तूह दैआ तेऊ लै ज़ीत।<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />तूह दैआ तेऊ लै तिहअ ज़िहअ तेऊओ दिल च़ाहा,</para>
  <para style="q" vid="PSA 21:2">तेरै निं तेऊ लै कधि नांह हंदी।<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />तूह एछा तेऊ सेटा लै बर्गत लई,</para>
  <para style="q" vid="PSA 21:3">संघा लाआ तेऊए मुंडै तूह सुन्‍नेंओ मुगट।<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />सह मांगा ताखा ज़िन्दगी अर</para>
  <para style="q" vid="PSA 21:4">तूह दैआ तेऊ लै जुगा-जुगा लै लाम्मी अमर।<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />ताह करै हुअ तेऊओ सारै दी अदर,</para>
  <para style="q" vid="PSA 21:5">तंऐं दैनी तेऊ लै ज़ीत अर तेता करै हुअ सह मशूर।<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />तूह दैआ तेऊ लै सदा बर्गत अर</para>
  <para style="q" vid="PSA 21:6">सह हआ खुशी दी मगन कि तूह रहा तेऊ संघै।<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />राज़अ करा ताह परम प्रधान परमेशर बिधाता दी भरोस्सअ,</para>
  <para style="q" vid="PSA 21:7">तूह झ़ूरा सदा तेऊ लै अर</para>
  <para style="q" vid="PSA 21:7">सह रहा सदा अटल़।<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />ताह बिधाते महान बला करै ढाकणैं तेऊ आपणैं सारै दुशमण,</para>
  <para style="q" vid="PSA 21:8">ज़ुंण तेऊ संघै ज़ीद डाहा तै।<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />ज़ांऊं तूह आप्पै प्रगट हणअ,</para>
  <para style="q" vid="PSA 21:9">तिंयां दुशमण दझ़णैं ज़िहै आगीए बडै कूंडा दी!</para>
  <para style="q" vid="PSA 21:9">ताह बिधाता काढणअ तिन्‍नां प्रैंदै आपणअ सारअ रोश्श अर</para>
  <para style="q" vid="PSA 21:9">तिंयां हणैं आगी जैंदरी दझ़ी खतम।<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />तेखअ निं पृथूई दी तिन्‍नें आद-लुआद बी बच़णीं अर</para>
  <para style="q" vid="PSA 21:10">ताह निं मणछा जैंदरी तिन्‍नों नाअं-नशाण डाहणअ।<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />तेरी हान्‍नी करना लै तिन्‍नें ज़ेतरी बी बिक्री किई ती,</para>
  <para style="q" vid="PSA 21:11">तिंयां निं एक बी सफल हणीं।<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />ताह छ़ाडणैं तिन्‍नां बाखा आपणैं कतीर अर</para>
  <para style="q" vid="PSA 21:12">तिंयां ठुर्हनै च़ऊ पाओऐ।<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />हे बिधाता, तेरअ बल आसा महान,</para>
  <para style="q" vid="PSA 21:13">हाम्हां करनी गिहा बोली-बोली तेरै महान ज़ोरे ज़ै-ज़ैकार।<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">खरी अर ज़ै-ज़ैकार</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै अभ्येलेरशर रागा दी राज़ै दाबेदो भज़न। एते बोल आसा, “भैणीं दोत्ती हरन।”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />हे मेरै परमेशर, हे मेरै परमेशर, तंऐं किल्है छ़ाडअ हुंह?</para>
  <para style="q" vid="PSA 22:1">तूह मेरी लेर-पकार किल्है निस्सअ शूणीं अर मेरी मज़त किल्है निस्सअ करी?</para>
  <para style="q" vid="PSA 22:1">तूह मुंह किल्है निस्सअ बच़ाऊई?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />हे मेरै परमेशर, मंऐं किई कबल्‍ली</para>
  <para style="q" vid="PSA 22:2">राची-धैल़ी ताह सेटा अरज़,</para>
  <para style="q" vid="PSA 22:2">पर तंऐं निं ज़बाब दैनअ!</para>
  <para style="q" vid="PSA 22:2">मुंह निं कधि राम भेटअ।<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />तूह पबित्र परमेशर करा आपणीं राज़गाद्दी प्रैंदै बेशी राज़,</para>
  <para style="q" vid="PSA 22:3">इज़राईल करा तेरी स्तोती।<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />म्हारै दाद-बाब करा तै ताह दी भरोस्सअ अर</para>
  <para style="q" vid="PSA 22:4">तिन्‍नां बच़ाऊआ त तूह ई।<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />तिंयां करा तै ताह सेटा अरज़ अर तूह हेरा त तिन्‍नां आफ़ता का बच़ाऊई,</para>
  <para style="q" vid="PSA 22:5">तिंयां करा तै तेरअ ई भरोस्सअ अर तिन्‍नां निं कधि उंधै हुई गई।<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />पर हुंह निं मणछ हणैं जोगी बी आथी, हुंह आसा</para>
  <para style="q" vid="PSA 22:6">किल़ै ज़िहअ अर हर ज़ैगा करा लोग मेरी बेइज़ती।<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />ज़ुंण बी मुंह भाल़ा, सह करा मेरअ सुहांग।</para>
  <para style="q" vid="PSA 22:7">तिंयां मरोक्‍का आपणीं खाख संघा बोला मुंडकी ढोल़ी इहअ,<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />“अह आसा बै सह</para>
  <para style="q" vid="PSA 22:8">ज़ुंण बिधाता दी भरोस्सअ करदअ फिरा,</para>
  <para style="q" vid="PSA 22:8">ज़ाणनअ कि बिधाता झ़ूरा एऊ ई लै!</para>
  <para style="q" vid="PSA 22:8">तै किल्है निं सह एऊ बच़ाऊंदअ?”<verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />पर हे बिधाता, तंऐं काढअ हुंह मेरी माए ओदरा का संसारै राज्ज़ी-राम्बल़अ,</para>
  <para style="q" vid="PSA 22:9">च़ूई झुटणें अमरा ओर्ही आअ तूह मुंह बच़ाऊंदी।<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />ज़धू हुंह हुअ, तधा ओर्ही आसा हुंह तेरै ई आसरै अर</para>
  <para style="q" vid="PSA 22:10">मेरी माए ओदरा ओर्ही आसा तूह मेरअ परमेशर।<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />हे बिधाता, तूह निं मुखा दूर हई,</para>
  <para style="q" vid="PSA 22:11">मुल्है आसा आफ़त एछणैं आल़ी अर</para>
  <para style="q" vid="PSA 22:11">ताह छ़ाडी निं मेरी मज़त करनै आल़अ कोहै आथी।<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />मेरै दुशमण आसा बणें म्हैशे छ़ुंढा ज़िहै मुंह फेरा-फेर।</para>
  <para style="q" vid="PSA 22:12">तिंयां आसा बाशान<note caller="+" style="f"><char style="fr" closed="false">22:12 </char><char style="fq" closed="false">बाशान </char><char style="ft" closed="false">जरदण नदीए बाढै एक मुल्ख</char></note> मुल्खे म्हैशै ज़िहै नथहऐ ज़ोरा आल़ै</para>
  <para style="q" vid="PSA 22:12">अर तिन्‍नैं गोटअ हुंह फेरा-फेर।<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />तिन्‍नैं लाई सिहा ज़ेही क्रुंगा ज़ुंण धेल़ा-च़िरा!</para>
  <para style="q" vid="PSA 22:13">तिंयां आसा मुंह क्रिंज़णा लै ताखुई रहै दै।<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />मेरै तराण हुऐ इहै खतम ज़िहअ पाणीं धरना लै निटरा!</para>
  <para style="q" vid="PSA 22:14">मेरै हाडके ज़ोल़ फुक्‍कै पोर्ही अर</para>
  <para style="q" vid="PSA 22:14">मेरअ दिल लागअ भितरी शाणा ज़िहअ गल़दअ!<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />मुंह निं ज़ोर-ज़ाहण ई रहै</para>
  <para style="q" vid="PSA 22:15">अर शुक्‍कअ इहअ ज़िहअ फुटअ द पारू धुप्पै शुक्‍का।</para>
  <para style="q" vid="PSA 22:15">मेरी ज़िभ शाची प्रैंधल़ै दांदा पिछ़ू,</para>
  <para style="q" vid="PSA 22:15">तंऐं बिधाता छ़ाडअ हुंह धरनीं माट्टै जैंदरी मर्दअ!<note caller="-" style="x"><char style="xo" closed="false">22:15 </char><char style="xt" closed="false"><ref loc="PSA 7:5">भज. 7:5</ref>; <ref loc="PSA 90:3">90:3</ref></char></note><verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />मेरै दुशमणै गोटअ हुंह फेरा फेर</para>
  <para style="q" vid="PSA 22:16">खांदै कुक्‍करे छ़ुंढा ज़िहअ,</para>
  <para style="q" vid="PSA 22:16">तिन्‍नैं पाऐ मेरै हाथ-खूर धेल़ी-च़िरी।<verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />मेरै लागै भितरी हाडकै शुझदै!</para>
  <para style="q" vid="PSA 22:17">मेरै दुशमण आसा मुल्है क्रुखै भाल़ै लागै दै।<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />तिन्‍नैं किऐ मेरै झिकल़े लीरा-कच़ीरा</para>
  <para style="q" vid="PSA 22:18">संघा बांडै मेरै झिकल़ै आप्पू मांझ़ै परच़ी पाई।<verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />हे बिधाता, तूह निं मुखा दूर हई!</para>
  <para style="q" vid="PSA 22:19">मुंह बच़ाऊंदअ एछ छ़ेक्‍कै!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />मेरी ज़ान बच़ाऊ इना दुशमणे तलबारा का,</para>
  <para style="q" vid="PSA 22:20">इना कुक्‍करै का बच़ाऊ मेरी ज़िन्दगी।<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />इना धेल़णै-च़िरनैं आल़ै सिहा का,</para>
  <para style="q" vid="PSA 22:21">इना बणें म्हैशै का बच़णअ आसा मेरै बशा का बागै।<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />तेरै बारै खोज़णअ मुंह आपणैं सोभी भाई-बंधा का,</para>
  <para style="q" vid="PSA 22:22">मुंह करनी तिन्‍नें सभा दी तेरी ज़ै-ज़ैकार।<verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />बिधाते च़ाकरी करनै आल़ै मणछो, तेऊए करा ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 22:23">तम्हैं याकबे आद-लुआद करा तेऊ बिधातो अदर!</para>
  <para style="q" vid="PSA 22:23">ओ इज़राईलीओ, तम्हैं रहा तेऊए डरा हेठै।<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />सह निं दुखी मणछा बृथा समझ़दअ अर नां तिन्‍नां लै नफरत करदअ,</para>
  <para style="q" vid="PSA 22:24">सह निं तिन्‍नां बाखा पिठ फरेऊंदअ,</para>
  <para style="q" vid="PSA 22:24">सह हेरा तिन्‍नें लेर-पकार शूणीं।<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />हे बिधाता, ज़ेभै तेरै लोग तेरी जाचा लै कठा होए,</para>
  <para style="q" vid="PSA 22:25">तेभै करनी मुंह तेरै इना सोभी कामें ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 22:25">तेभै भाल़णअ सोभी कि मंऐं किई ताल्है आपणीं मानत पूरी।<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />रैनै-गरीब रज्ज़णै तिन्‍नें मन्‍न-मरज़ीओ खाई-खाई,</para>
  <para style="q" vid="PSA 22:26">बिधाता सेटा एछणैं आल़ै करा सोभै तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 22:26">तिंयां रहणैं सदा राज्ज़ी-राम्बल़ै।<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />हे बिधाता, पृथूई दी करनी दूर-दूर देशे लोगा तेरी आद।</para>
  <para style="q" vid="PSA 22:27">ताह सेटा एछणैं लोग संसारे सोभी ज़ैगा का अर</para>
  <para style="q" vid="PSA 22:27">हर रंगे लोगा टेक्‍कणअ ताह सेटा माथअ।<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />किल्हैकि तूह बिधाता आसा राज़अ अर</para>
  <para style="q" vid="PSA 22:28">तूह करा संसारे सोभी देशा प्रैंदै राज़।<verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />पृथूई दी ज़िहै बी सेठ मणछ होए, तिन्‍नां टेक्‍कणअ ताह बिधाता सेटा माथअ,</para>
  <para style="q" vid="PSA 22:29">होर ता होर, ज़ुंण मरदै तैर आसा तिन्‍नां बी टेक्‍कणअ ताह सेटा माथअ।<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />आजू एछणैं आल़ी पोस्ती करनी तेरी च़ाकरी अर</para>
  <para style="q" vid="PSA 22:30">तिन्‍नां खोज़णीं तेरै बारै गल्‍ला।<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />ज़ुंण मणछ अज़ी संसारै आजू पैईदा हणैं तिन्‍नां का डाहणीं तिन्‍नें ईजा बाबा एही गल्‍ला खोज़ी,</para>
  <para style="q" vid="PSA 22:31">“हाम्हैं आसा बिधाता बच़ाऊऐ दै।”<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">असली फुआल</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />हे बिधाता, तूह आसा मेरअ फुआल,</para>
  <para style="q" vid="PSA 23:1">तूह करा मेरी हर गरज़ पूरी।<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />तूह च़राऊआ मुंह हरै घाहे घैहणीं दी,</para>
  <para style="q" vid="PSA 23:2">तूह निंयां मुंह ज़ाईरू पाणींए छ़ोआ नेल़ अर<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />तूह दैआ मेरअ शाह हरअ फरेऊई।</para>
  <para style="q" vid="PSA 23:3">तूह नढैऊआ मुंह धर्मीं बाता</para>
  <para style="q" vid="PSA 23:3">ज़िहअ सह बोला तिहअ ई।<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />ज़ै हुंह नटिप्प न्हैरै बाती बी हांढे,</para>
  <para style="q" vid="PSA 23:4">हुंह निं तेथ बी डरदअ किल्हैकि</para>
  <para style="q" vid="PSA 23:4">तूह बिधाता हआ मुंह संघा।</para>
  <para style="q" vid="PSA 23:4">तेरी कुंगल़ी चुंडीए शोठी<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">कुंगल़ी चुंडीए शोठी </char><char style="ft" closed="false">डागै चैणैं छ़ेल़्हणै, बाता हांढणे अर डाल़ी बुटी खिंच़णें शोठी</char></note> करा मेरी फाज़त।<verse eid="PSA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />मेरै दुशमणा नदरी दैआ तूह मुल्है खाणां लै भोज़,</para>
  <para style="q" vid="PSA 23:5">तूह करा मेरअ अदर इहअ कि</para>
  <para style="q" vid="PSA 23:5">हुंह आसा तेरअ सोभी का खास प्राहुंणअ,</para>
  <para style="q" vid="PSA 23:5">अर मेरी बाटी दैआ तूह टिरा बहूंदी बर्गत भरी।<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="LUK 7:46">लूक. 7:46</ref></char></note><verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />अह गल्‍ल आसा पाक्‍की कि तूह झ़ूरा मुल्है अर ताह करनी मुल्है सदा झींण,</para>
  <para style="q" vid="PSA 23:6">हे बिधाता, मुंह बस्सणअ तेरै घअरै सदा-सदा लै।<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">बिधाते पबित्र ज़ैगा कुंण सका डेऊई?</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />सारी पृथूई अर तेते हर च़िज़ा आसा बिधाते,</para>
  <para style="q" vid="PSA 24:1">सारअ संसार अर सोभै मणछ बी आसा बिधाते।<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />बिधाता ई आसा धरतीए आथरी डुघै समुंदर अर</para>
  <para style="q" vid="PSA 24:2">बडै-बडै दरैऊआ दी पाक्‍की डाही दी।<verse eid="PSA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />बिधाते धारा प्रैंदै कुंण सका उखल़ी?</para>
  <para style="q" vid="PSA 24:3">तेऊए पबित्र ज़ैगा कुंण सका खल़अ हई?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />सिधै तिंयां ज़सरै काम अर बच़ार भलै आसा,</para>
  <para style="q" vid="PSA 24:4">ज़ुंण मुहुर्ती नांईं पूज़दै अर</para>
  <para style="q" vid="PSA 24:4">ज़ुंण झ़ुठी ज़बान निं करदै।<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />बिधाता दैणीं तिन्‍नां लै बर्गत अर तेऊ डाहणैं तिंयां बच़ाऊई,</para>
  <para style="q" vid="PSA 24:5">तिंयां ई बणाणैं बिधाता आप्पू संघै धर्मीं।<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />इहै मणछ ई करा परमेशरे लोल़-तोप,</para>
  <para style="q" vid="PSA 24:6">ईंयां ई मणछ सका याकबे परमेशरा सेटा एछी।<verse eid="PSA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />पैहलकै ज़मानैं ओर्हीए</para>
  <para style="q" vid="PSA 24:7">उछ़टी-बिरली प्रऊल़ी खोल्हा</para>
  <para style="q" vid="PSA 24:7">ताकि महान प्रतप्पी राज़अ भितरा लै एछी सके।<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />महान प्रतप्पी राज़अ कुंण आसा?</para>
  <para style="q" vid="PSA 24:8">सह आसा परम प्रधान परमेशर बिधाता ज़हा का सारअ बल आसा अर</para>
  <para style="q" vid="PSA 24:8">ज़ुंण जुधा लै सोभी का बडअ जोधअ आसा।<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />पैहलकै ज़मानैं ओर्हीए</para>
  <para style="q" vid="PSA 24:9">उछ़टी-बिरली प्रऊल़ी खोल्हा</para>
  <para style="q" vid="PSA 24:9">ताकि महान प्रतप्पी राज़अ भितरा लै एछी सके।<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />महान प्रतप्पी राज़अ कुंण आसा?</para>
  <para style="q" vid="PSA 24:10">सह आसा स्वर्गे सारी सैनो मालक बिधाता।<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">बिधाता का अरज़</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />हे बिधाता, मंऐं दैनी आपणीं ज़िन्दगी ताल्है,<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />हे परमेशर, मुंह आसा तेरअ ई भरोस्सअ।</para>
  <para style="q" vid="PSA 25:2">तूह बच़ाऊ मुंह हारने बेइज़ती हणैं का,</para>
  <para style="q" vid="PSA 25:2">मेरै दुशमणा निं मेरी हारने खुशी दी नाच़-खेल्ह करनै दैई।<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />ज़ुंण ताह दी भरोस्सअ करा, तिंयां निं कधि हारी सकदै,</para>
  <para style="q" vid="PSA 25:3">पर ज़ुंण छ़ेक्‍कै धोखअ दैआ, तिंयां हणैं शर्मिंदै।<verse eid="PSA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />हे बिधाता, तूह रहैऊ मुखा आपणीं बात,</para>
  <para style="q" vid="PSA 25:4">मुंह सखाऊ तेथ हांढणअ।<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />मुखा शखैल़ आपणैं सत्ता दी ज़िन्दगी ज़िऊंणीं,</para>
  <para style="q" vid="PSA 25:5">मेरअ परमेशर आसा तूह ज़ुंण मुंह बच़ाऊआ।</para>
  <para style="q" vid="PSA 25:5">हुंह रहा सदा तेरै ई भरोस्सै।<verse eid="PSA 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />हे बिधाता, ज़ीबाण, ऐहा गल्‍ला कर आद कि</para>
  <para style="q" vid="PSA 25:6">तूह आअ जुगा-जुगा ओर्ही सबर अर झींण करदी।<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />हे बिधाता, मेरै खारकी अमरा किऐ दै पाप अर गलती कर माफ।</para>
  <para style="q" vid="PSA 25:7">तूह कर ऐहा गल्‍ला प्रगट कि तूह झ़ूरा सदा अर</para>
  <para style="q" vid="PSA 25:7">झींण करी डाह मुंह आद।<verse eid="PSA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />किल्हैकि तूह बिधाता आसा धर्मीं अर झणैल़ू,</para>
  <para style="q" vid="PSA 25:8">तूह खोज़ा पापी मणछा का कि किहअ लागा तेरी बाता हांढणअ।<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />भोल़ै मणछा का सखाऊआ तूह भलअ करनअ अर</para>
  <para style="q" vid="PSA 25:9">इहअ कि तूह किज़ै च़ाहा।<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />ज़ुंण ताह बिधाते करार अर बधान मना,</para>
  <para style="q" vid="PSA 25:10">तिन्‍नां लै हआ सदा तेरी झींण अर सत्त।<verse eid="PSA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />हे बिधाता, तूह कर आपणीं ज़बान आद,</para>
  <para style="q" vid="PSA 25:11">संघा कर मेरै पाप माफ, ज़ुंण बेघै खास्सै आसा।<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />ज़ुंण ताह बिधाते डरा हेठै रहा,</para>
  <para style="q" vid="PSA 25:12">ताह रहैऊंणीं तिन्‍नां का सह भली बात ज़ेथ तूह च़ाहा कि तिंयां हांढे।<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />तिंयां हणैं सेठ अर</para>
  <para style="q" vid="PSA 25:13">तिन्‍नें आद-लुआद हणैं ज़िम्मींए मालक।<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />तूह बिधाता हआ तिन्‍नां मणछो साथी ज़ुंण तेरी डरा हेठै रहा,</para>
  <para style="q" vid="PSA 25:14">आपणीं करार बी करा तूह तिन्‍नां ई संघै पाक्‍की।<verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />हे बिधाता, मेरी आछी हआ कबल्‍ली ताह बाखा लागी दी,</para>
  <para style="q" vid="PSA 25:15">किल्हैकि मुंह बच़ाऊआ तूह ई आफ़त पाणै आल़ै ज़ज़ाल़ा का।<verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />हे बिधाता, मुंह बाखा फिर, मुल्है कर झींण,</para>
  <para style="q" vid="PSA 25:16">किल्हैकि हुंह आसा कल्ही अर मुल्है आसा आफ़त पल़ी दी।<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />मुंह लागअ खास्सअ हैल़अ फिरदअ,</para>
  <para style="q" vid="PSA 25:17">तूह बच़ाऊ मुंह इना सांगटा का।<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />मेरै दुख-सांगटा बाखा दै भाल़णीं अर</para>
  <para style="q" vid="PSA 25:18">मेरै पाप कर माफ।<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />मेरै दुशमण भाल़ किहै खास्सै हुऐ अर</para>
  <para style="q" vid="PSA 25:19">तिंयां भाल़ मुंह संघै केही ज़ीद डाहा।<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />हे बिधाता, मेरी फाज़त कर तूह, तिन्‍नां का बच़ाऊ मेरी ज़िन्दगी।</para>
  <para style="q" vid="PSA 25:20">मुंह निं शर्मिंदै दैई हणैं किल्हैकि</para>
  <para style="q" vid="PSA 25:20">मंऐं आसा ताह सेटा शरण लई दी।<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />हे बिधाता, हुंह करा दिला का ज़िहअ तूह बोला तिहअ ई,</para>
  <para style="q" vid="PSA 25:21">मेरअ भरोस्सअ आसा ताह दी किल्हैकि मुखा आसा थोघ कि ताह हेरनअ हुंह बच़ाऊई।<verse eid="PSA 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />हे बिधाता, तेरै आपणैं इज़राईली मणछा डाह तूह</para>
  <para style="q" vid="PSA 25:22">सोभी आफ़ता का बच़ाऊई!<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">नर्दोश मणछे अरज़</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />हे बिधाता, मेरअ नसाफ कर,</para>
  <para style="q" vid="PSA 26:1">किल्हैकि हुंह निं कधि बूरअ करदअ अर</para>
  <para style="q" vid="PSA 26:1">हुंह रहा पठी तेरै ई भरोस्सै।<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />हे बिधाता, मेरी कर राम्बल़ै करै ज़ाच़-भाल़ अर</para>
  <para style="q" vid="PSA 26:2">मेरै दिला अर मन्‍नां परख।<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />तेरअ मुल्है झ़ूरनअ आसा मुल्है सलाह अर</para>
  <para style="q" vid="PSA 26:3">हुंह ज़िऊआ तेरै सत्ते साबै ज़िन्दगी।<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />हुंह निं बृथा मणछे संगत करदअ अर</para>
  <para style="q" vid="PSA 26:4">नां कपटी मणछा संघै साझ़ करदअ।<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />कदुष्ट मणछे संगत डाहणैं का आसा मुंह नफरत,</para>
  <para style="q" vid="PSA 26:5">मुंह निं तिन्‍नां नकर्मै संघै उझ़णअ बेशणअ बी आथी।<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />हे बिधाता, मंऐं धोऐ आपणैं हाथ कि मेरअ निं किछ़ै कशूर आथी,</para>
  <para style="q" vid="PSA 26:6">संघा दैणीं मुंह तेरी बेदी फेर फेरी।<note caller="-" style="x"><char style="xo" closed="false">26:6 </char><char style="xt" closed="false"><ref loc="PSA 73:13">73:13</ref></char></note><verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />मुंह बोल़णीं तेरै शूकर करना लै ज़ोर-ज़ोरै गिह,</para>
  <para style="q" vid="PSA 26:7">संघा खोज़णैं मुंह तेरै महान काम बाढै।<verse eid="PSA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />हे बिधाता, हुंह झ़ूरा तेरी पबित्र ज़ैगा लै ज़िधी तूह आसा बस्सअ द,</para>
  <para style="q" vid="PSA 26:8">ज़िधी तूह आपणैं महान धुप्पै संघै प्रगट हआ।<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />हे बिधाता, मेरी मौत निं पापी मणछा ज़ेही लोल़ी हुई,</para>
  <para style="q" vid="PSA 26:9">नां तूह मुल्है तेही मौत दैई ज़ेही तूह हत्या करनै आल़ै लै सज़ा दैआ।<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />तिंयां ता रहा कबल्‍लै कबध करदै लागी अर</para>
  <para style="q" vid="PSA 26:10">हर बगत खाआ तिंयां रेशपत।<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />पर हे बिधाता, मुंह करनअ सदा भलअ ई,</para>
  <para style="q" vid="PSA 26:11">मुल्है कर झींण अर मुंह बच़ाऊ।<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />ऐबै आसा हुंह सोभी आफ़ता का दूर सरली ज़ैगा!</para>
  <para style="q" vid="PSA 26:12">हे बिधाता, ज़ेभै तेरै लोग झाल़अ करे, तेभै करनअ मुंह सोभी नदरी तेरअ शूकर।<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">ज़ै-ज़ैकार करना लै भज़न</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />बिधाता आसा मेरअ प्रैश्शअ ज़ुंण मुंह बच़ाऊआ।</para>
  <para style="q" vid="PSA 27:1">हुंह निं कोही का डरदअ।</para>
  <para style="q" vid="PSA 27:1">बिधाता करा मेरी फाज़त आप्पै अर</para>
  <para style="q" vid="PSA 27:1">हुंह निं कधि फिकर करदअ।<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />कदुष्ट मणछ अर मेरै दुशमण</para>
  <para style="q" vid="PSA 27:2">च़ाऐ मुंह मारदै किल्है निं एछे,</para>
  <para style="q" vid="PSA 27:2">पर तिन्‍नां लागणीं ठोहल़</para>
  <para style="q" vid="PSA 27:2">संघा बधल़णैं तिंयां धरनीं।<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />च़ाऐ सारी सैना मुंह फेरा-फेर गोटे,</para>
  <para style="q" vid="PSA 27:3">हुंह निं तैबी बी डरदअ,</para>
  <para style="q" vid="PSA 27:3">तिंयां च़ाऐ मुंह संघै जुध बी छ़ेल़े,</para>
  <para style="q" vid="PSA 27:3">तज़ी बी आसा मेरअ भरोस्सअ बिधाता दी अटल़।<verse eid="PSA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />मंऐं मांगअ बिधाता का एक्‍कै बरदान,</para>
  <para style="q" vid="PSA 27:4">हुंह च़ाहा सिधअ इहअ कि</para>
  <para style="q" vid="PSA 27:4">मुंह रहणअ सारी ज़िन्दगी बिधाते घअरै,</para>
  <para style="q" vid="PSA 27:4">ताकि हुंह तिधी कबल्‍ली बिधाते महान भलाई भाल़ूं</para>
  <para style="q" vid="PSA 27:4">अर बिधाता का हर बगत सलाह मांगूं।<verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />ज़ेभै मुंह आफ़त पल़े, तेभै हणअ सह मेरअ आसरअ,</para>
  <para style="q" vid="PSA 27:5">तेऊ डाहणअ हुंह आपणैं घअरै राज्ज़ी-राम्बल़अ अर</para>
  <para style="q" vid="PSA 27:5">तेऊ डाहणअ हुंह बडी टोल्हा प्रैंदै बच़ाऊई।<verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />तेऊ दैणीं मुल्है मेरै सोभी दुशमणा का ज़ीत।</para>
  <para style="q" vid="PSA 27:6">तेखअ मनाऊंणी मुंह बल़ीदान अर ज़ै-ज़ैकार करी तेऊए भबनै खुशी।</para>
  <para style="q" vid="PSA 27:6">मुंह बोल़णीं बिधाते ज़ै-ज़ैकार करना लै गिहा।<verse eid="PSA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />हे बिधाता, ज़ेभै हुंह अरज़ करूं तेभै शूणैं!</para>
  <para style="q" vid="PSA 27:7">मुल्है दैऐ ज़बाब अर मुल्है करै झींण।<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />तंऐं आसा आप्पै इहअ बोलअ द, “तम्हैं लोल़ी मेरै दर्शण करदै आऐ।”</para>
  <para style="q" vid="PSA 27:8">मंऐं बोलअ इहअ, “हे बिधाता, मुंह करनै तेरै दर्शण।”<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />हे बिधाता, ऐबै निं मुंह बाखा पिठ फरेऊई!</para>
  <para style="q" vid="PSA 27:9">मुल्है निं रोश्श करी, अर</para>
  <para style="q" vid="PSA 27:9">मुंह निं आप्पू का दूर करी।</para>
  <para style="q" vid="PSA 27:9">मेरी मज़त करनै आल़अ आसा सिधअ तूह ई,</para>
  <para style="q" vid="PSA 27:9">मुंह निं शोटी डाही नां कल्ही छ़ाडी आथी, हे बिधाता,</para>
  <para style="q" vid="PSA 27:9">मेरै निं ताह छ़ाडी कोहै आथी ज़ुंण मुंह बच़ाऊई सका।<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />मेरै ईजै बाबै बी डाहअ हुंह शोटी,</para>
  <para style="q" vid="PSA 27:10">पर ताह बिधाता करनी मेरी हेर-सभाल़।<verse eid="PSA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />हे बिधाता, तूह खोज़ मुखा, हुंह करूं तिहअ ई ज़िहअ तूह च़ाहा,</para>
  <para style="q" vid="PSA 27:11">मुंह नढैऊ राम्बल़ी बाता</para>
  <para style="q" vid="PSA 27:11">ज़ेथ हुंह मेरै दुशमणा का बच़ी राज्ज़ी-राम्बल़अ रहूं।<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />ज़िहअ मेरै दुशमण मुल्है करनअ च़ाहा, तिन्‍नां निं तिहअ करनै दैई,</para>
  <para style="q" vid="PSA 27:12">लोग दैआ मेरै बारै झ़ुठी शाजत अर तिंयां दैआ मुल्है डरैऊंणै आल़ी धमकी।<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />पर हे बिधाता, मुंह आसा भरोस्सअ मुंह भाल़णीं तेरी भलाई</para>
  <para style="q" vid="PSA 27:13">ज़िऊंदी ज़िता एऊ ई संसारै। <note caller="-" style="x"><char style="xo" closed="false">27:13 </char><char style="xt" closed="false"><ref loc="PSA 142:5">भज. 142:5</ref></char></note><verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />सबर डाही रहणअ बिधाता न्हैल़ै-भाल़ै लागी।</para>
  <para style="q" vid="PSA 27:14">हैअ विश्वास डाहणअ पाक्‍कअ,</para>
  <para style="q" vid="PSA 27:14">हाँ, सबर डाही रहणअ बिधाता न्हैल़ै-भाल़ै लागी।<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">बिधाता का अरज़</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />हे बिधाता, तूह ई आसा सह बडी टोल्ह ज़ेथ पिछ़ू हुंह शरण लआ।</para>
  <para style="q" vid="PSA 28:1">हुंह पाआ ताह सेटा पकार।</para>
  <para style="q" vid="PSA 28:1">मेरी लेर-पकार शुण! ज़ै तूह नांईं शुणें,</para>
  <para style="q" vid="PSA 28:1">मुखा छ़ुटणीं छ़ाड़ संघा जाणअ हुंह मरी।<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />ज़ीबाण, मेरी प्राथणां अर मेरी लेर-पकार शुण कि हुंह मांगा ताखा मज़त,</para>
  <para style="q" vid="PSA 28:2">हुंह फुआरा तेरै भबना बाखा आपणीं बाहा।<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />मुंह निं कदुष्ट मणछे संगती दी गणी,</para>
  <para style="q" vid="PSA 28:3">तिंयां ज़ुंण कबध खटा अर</para>
  <para style="q" vid="PSA 28:3">आपणैं साथी-संघी संघै गल्‍ला, करा तिंयां मिठी पर</para>
  <para style="q" vid="PSA 28:3">दिलै डाहा तिंयां ज़ीद।<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />तिन्‍नां लै कर तिहअ बभार ज़ुंण तिन्‍नां लै हुअ लोल़ी,</para>
  <para style="q" vid="PSA 28:4">ज़ुंण तिन्‍नैं कदुष्ट काम किऐ,</para>
  <para style="q" vid="PSA 28:4">तेता लै दै तिन्‍नां लै सज़ा अर</para>
  <para style="q" vid="PSA 28:4">तिन्‍नां लोल़ी तिन्‍नें पापो तिहअ ई फल भेटअ।<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />किल्हैकि तिंयां कदुष्ट मणछ निं ताह बिधाते महान कामां बाखा टेरअ बी भाल़दै कि</para>
  <para style="q" vid="PSA 28:5">तंऐं किज़ै आसा किअ द!</para>
  <para style="q" vid="PSA 28:5">ताह दैणीं ऐबै तिन्‍नां लै सज़ा अर</para>
  <para style="q" vid="PSA 28:5">ताह करनै तिंयां सदा लै बरैबाद।<verse eid="PSA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />हे बिधाता, मुंह करनअ तेरअ शूकर</para>
  <para style="q" vid="PSA 28:6">किल्हैकि तंऐं हेरी मेरी लेर-पकार शूणीं।<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />तूह बिधाता मुंह बच़ाऊंणै आल़अ अर</para>
  <para style="q" vid="PSA 28:7">मुंह करनअ ताह ई प्रैंदै भरोस्सअ।</para>
  <para style="q" vid="PSA 28:7">तंऐं किई मेरी मज़त, मुंह मनाऊंणी खुशी अर</para>
  <para style="q" vid="PSA 28:7">गिहा बोली करनअ मुंह तेरअ शूकर।<verse eid="PSA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />हे बिधाता, तूह दैआ आपणैं लोगा लै बल,</para>
  <para style="q" vid="PSA 28:8">ज़ुंण राज़अ तंऐं आप्पै छ़ांटअ तूह रहा तेऊ बच़ाऊंदअ अर फाज़त करदअ।<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />हे बिधाता, ज़ुंण लोग तेरै आपणैं आसा,</para>
  <para style="q" vid="PSA 28:9">तिन्‍नां बच़ाऊ संघा दै तिन्‍नां लै बर्गत।</para>
  <para style="q" vid="PSA 28:9">तिन्‍नें फाज़त कर तूह ई अर</para>
  <para style="q" vid="PSA 28:9">तूह लोल़ी सारी सदा लै तिन्‍नों च़राऊंणै आल़अ फुआल रहअ।<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">बिधातो बोल</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />हे स्वर्गे दूतो, परमेशर बिधाते ज़ै-ज़ैकार करा,</para>
  <para style="q" vid="PSA 29:1">तेऊए महान प्रतप्पे अर महान ज़ोरे करा ज़ै-ज़ैकार।<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />बिधाते महान नाओंए करा ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 29:2">तेऊ महान पबित्र परमेशरा सेटा टेक्‍का माथअ।<verse eid="PSA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />बिधातो बोल शुण्हिंआं समुंदरा का</para>
  <para style="q" vid="PSA 29:3">महान परमेशर छ़ाडा गुल़ूबिज़ल़ू ज़ेही छ़ेल़,</para>
  <para style="q" vid="PSA 29:3">बिधाता रहा घणैं बादल़ा प्रैंदै।<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />बिधाते बैणा दी आसा महान बल अर</para>
  <para style="q" vid="PSA 29:4">तेऊए बैणा दी आसा प्रतप्प।<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />बिधातो बैण दैआ केल़ुई बी ढोल़ी,</para>
  <para style="q" vid="PSA 29:5">तेऊए बैणा करै चुटा लाबानोन बणें बडी-बडी केल़ुई बी।<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />बिधाते बला करै दैआ लाबानोन बडी धार बी बाछ़ू ज़िहै त्रुपल़ै,</para>
  <para style="q" vid="PSA 29:6">सिर्योन धार दैआ बणें खारकै म्हैशै ज़ेही छ़ाहल़।<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />बिधाते बैणा का निखल़ा बिज़ल़ी अर बडै-बडै आगीए लुपल़ै।<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />तेऊए बैणा करै हआ उज़र रेगीस्तानै ज़ाज़री,</para>
  <para style="q" vid="PSA 29:8">कादेश रेगीस्तान लागा बिधाते बैणा करै काम्बदअ।<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />ज़ांऊं बिधातो बैण शुण्हिंआं, हरनी जाआ छ़ेक्‍कै चूई,</para>
  <para style="q" vid="PSA 29:9">बणैं बडै-बडै डाल़-बूटा का लागा पाच धरनीं अल़दै,</para>
  <para style="q" vid="PSA 29:9">भबनै बोला सोभै मणछ, “बिधातो प्रतप्प, बिधातो प्रतप्प!”<verse eid="PSA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />प्रल़या करनै आल़ै पाणीं प्रैंदै लाआ बिधाता आपणीं राज़गाद्दी,</para>
  <para style="q" vid="PSA 29:10">सह आसा इहअ राज़अ ज़हा सदा राज़ करनअ।<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />बिधाता दैआ आपणैं लोगा लै</para>
  <para style="q" vid="PSA 29:11">बल, शांती अर बर्गत।<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">बिधातो शूकर</para>
  <para style="d">भबने प्रतिष्ठा लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />हे बिधाता, मुंह करनी तेरी ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 30:1">किल्हैकि तंऐं डाहअ हुंह बच़ाऊई अर</para>
  <para style="q" vid="PSA 30:1">तंऐं निं मेरै दुशमणा लै खुशी दैनी हणैं।<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />ए मेरै बिधाता, मंऐं पाई ताह सेटा पकार अर तंऐं</para>
  <para style="q" vid="PSA 30:2">किअ हुंह नरोगअ।<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />हे बिधाता, तंऐं बच़ाऊअ हुंह मरनै का</para>
  <para style="q" vid="PSA 30:3">हुंह हणअ त घोरी पल़अ द, पर</para>
  <para style="q" vid="PSA 30:3">तंऐं डाही मेरी ज़िन्दगी बच़ाऊई।<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />ज़ुंण ताह बिधाते शुचै-पाक्‍कै लोग आसा,</para>
  <para style="q" vid="PSA 30:4">तिन्‍नां करनी गिहा बोली तेरी ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 30:4">अर तिन्‍नां करनअ तेरै पबित्र नाओं अदर।<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />तेरअ रोश्श हआ थोल़ी घल़ी लै,</para>
  <para style="q" vid="PSA 30:5">पर तेरी झींण रहा सारी ज़िन्दगी।</para>
  <para style="q" vid="PSA 30:5">इहअ सका हई कि राची छ़ुटी होए केभै लेरा बी,</para>
  <para style="q" vid="PSA 30:5">पर दोत्ती जाआ खुशी भेटी।<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />हुंह त राज्ज़ी-मौज़ी संघा लागअ इहअ सोठदअ,</para>
  <para style="q" vid="PSA 30:6">“ऐबै निं मुंह कुंण छ़ेल़ी बी सकदअ!”<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />हे बिधाता, तूह त मुंह संघै,</para>
  <para style="q" vid="PSA 30:7">तंऐं बणाअं हुंह उछ़टी धारा ज़िहअ पाक्‍कअ।</para>
  <para style="q" vid="PSA 30:7">ज़ांऊं तंऐं मुंह बाखा पिठ फरेऊई,</para>
  <para style="q" vid="PSA 30:7">तेखअ फिरअ मुंह हैल़अ।<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />हे मेरै मालक बिधाता, मंऐं किई ताह ई सेटा अरज़,</para>
  <para style="q" vid="PSA 30:8">मंऐं मांगी ताखा लेर-पकार पाई मज़त।<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />ज़ै हुंह मरे, तेता करै ताह किज़ै च़ाल्‍लअ भेटी?</para>
  <para style="q" vid="PSA 30:9">ज़ै हुंह घोरी दी च़िज़े, तेता करै ताह किज़ै नफअ च़ाल्‍लअ हई?</para>
  <para style="q" vid="PSA 30:9">मूंऐं दै मणछ कै तेरअ शूकर करी सका?</para>
  <para style="q" vid="PSA 30:9">तिंयां कै तेरै बारै होरी का खोज़ी सका कि तूह किहअ शुचअ-पाक्‍कअ आसा?<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />हे बिधाता, मेरी अरज़ शुण, मुल्है कर झींण,</para>
  <para style="q" vid="PSA 30:10">हे बिधाता, मेरी मज़त कर।<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />तंऐं बदल़अ मेरअ शोग खुशी दी,</para>
  <para style="q" vid="PSA 30:11">तंऐं किऐ मेरै दुख दूर अर</para>
  <para style="q" vid="PSA 30:11">तंऐं दैनी फेर-फिरदी मुल्है खुशी ई खुशी।<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />हे बिधाता, मुंह रहणअ तेरी ज़ै-ज़ैकार करना लै गिहा बोल्दै लागी,</para>
  <para style="q" vid="PSA 30:12">ऐबै निं मुंह च़ुप्पी रहणअ,</para>
  <para style="q" vid="PSA 30:12">हे बिधाता, मेरै परमेशर,</para>
  <para style="q" vid="PSA 30:12">मुंह रहणअ सारी सदा तेरअ शूकर करदै लागी।<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">शरण मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />हे बिधाता, हुंह लआ ताह सेटा शरण,</para>
  <para style="q" vid="PSA 31:1">मुंह निं लोल़ी शर्मिंदै पल़अ हणअ।</para>
  <para style="q" vid="PSA 31:1">तूह आसा धर्मीं परमेशर,</para>
  <para style="q" vid="PSA 31:1">हुंह करा ताखा एही अरज़ कि मुंह बच़ाऊ।<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />हे बिधाता, मेरी अरज़ शुण! मुंह बच़ाऊ छ़ेक्‍कै,</para>
  <para style="q" vid="PSA 31:2">तूह बण मुल्है मेरी शरण लणें बडी टोल्ह अर</para>
  <para style="q" vid="PSA 31:2">इहअ गहल़ ज़िधी हुंह बच़ी सका।<verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />हे बिधाता, मेरी शरण लणें बडी टोल्ह अर बच़णा लै गहल़ आसा तूह ई।</para>
  <para style="q" vid="PSA 31:3">तूह खोज़ मुखा आजूए बात अर तूह नढैऊ मुंह तिहअ ई ज़िहअ तंऐं बोलअ द आसा।<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />ज़ुंण गुप्त ज़ज़ाल़ मुल्है मेरै दुशमणै आसा छ़ैई डाहै दै,</para>
  <para style="q" vid="PSA 31:4">तिन्‍नां आफ़ता का डाहै तूह मुंह बच़ाऊई।<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />मंऐं छ़ाडी आपणीं ज़िन्दगी तेरै आसरै।</para>
  <para style="q" vid="PSA 31:5">हे परमेशर बिधाता, हुंह डाहा तेरअ ई भरोस्सअ</para>
  <para style="q" vid="PSA 31:5">किल्हैकि हुंह आसा तंऐं बच़ाऊअ द।<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">लूक. 23:46</ref>; <ref loc="ACT 7:59">शधा. 7:59</ref>; <ref loc="1PE 4:19">1 पत. 4:19</ref> </char></note><verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />ज़ुंण बृथा देअआ-देबीए मुहुर्ती पूज़ा, हुंह करा तिन्‍नां का नफरत,</para>
  <para style="q" vid="PSA 31:6">पर हुंह रहा ताह बिधाते भरोस्सै।<verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />मुंह मनाऊंणी खुशी,</para>
  <para style="q" vid="PSA 31:7">किल्हैकि तंऐं किई मुल्है झींण,</para>
  <para style="q" vid="PSA 31:7">तंऐं भाल़अ मेरअ दुख अर ताखा आसा थोघ कि</para>
  <para style="q" vid="PSA 31:7">मुल्है केही आफ़त आसा पल़ी दी।<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />तंऐं निं मुंह मेरै दुशमणे हाथै लागणै दैनअ,</para>
  <para style="q" vid="PSA 31:8">तंऐं किअ हुंह ज़िधी च़ाहा तिधा लै डेऊणा लै आज़ाद।<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />हे बिधाता, तूह कर मुल्है झींण,</para>
  <para style="q" vid="PSA 31:9">किल्हैकि मुल्है आसा आफ़त पल़ी दी,</para>
  <para style="q" vid="PSA 31:9">मेरी आछी थकी लेरी-लेरी अर</para>
  <para style="q" vid="PSA 31:9">मेरी देही निं ऐबै होर दाह ज़िरी सकदी।<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />मेरी ज़िन्दगी डुबी कबल्‍ली दुख ज़िरदी,</para>
  <para style="q" vid="PSA 31:10">लेरी-लेरी घटी मेरी अमर बी।</para>
  <para style="q" vid="PSA 31:10">इना आफ़ता ज़िरी-ज़िरी हुअ हुंह दुबल़अ अर</para>
  <para style="q" vid="PSA 31:10">मेरै हाडकै बी च़ाल्‍लै पठी गल़ी।<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />मेरै दुशमण करा मेरी बेइज़ती अर</para>
  <para style="q" vid="PSA 31:11">मेरै गराऊंआं आल़ै करा सुहांग करी मेरै होर बी खास्सै बूरै हाल।</para>
  <para style="q" vid="PSA 31:11">मेरै साथी-संघी फिरा मुंह भाल़ी डअर!</para>
  <para style="q" vid="PSA 31:11">तिन्‍नां का ज़ै हुंह बाता हांढदअ बी शुझिए, तिंयां ठुर्हा मुखा दूर!<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />सोभी आसा हुंह मूंऐं दै मणछा ज़िहअ बिस्सरी हेरअ द,</para>
  <para style="q" vid="PSA 31:12">हुंह हुअ फुटै दै भांडै ज़िहअ ज़ेते किछ़ै कदर निं हंदी।<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />मेरै दुशमण आसा मेरै बारै झ़ुठी फुआह पांदै लागै दै,</para>
  <para style="q" vid="PSA 31:13">मुल्है आसा फेरा-फेर डअर।</para>
  <para style="q" vid="PSA 31:13">तिंयां आसा आप्पू मांझ़ै मेरै बारै जोग करदै लागै दै कि</para>
  <para style="q" vid="PSA 31:13">तिंयां किहअ करै मुंह मारी पाए।<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />पर हे बिधाता, मेरअ भरोस्सअ आसा ताह दी,</para>
  <para style="q" vid="PSA 31:14">हुंह बोला इहअ, “मेरअ परमेशर आसा तूह ई।”<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />मेरी ज़िन्दगी आसा तेरै हाथै,</para>
  <para style="q" vid="PSA 31:15">तूह बच़ाऊ मुंह मेरै दुशमणा का</para>
  <para style="q" vid="PSA 31:15">ज़ुंणी हुंह हंती-हंती आणअ मारी।<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />हुंह आसा तेरअ दास, मुंह बाखा भाल़ प्रैश्शै मुंहैं,</para>
  <para style="q" vid="PSA 31:16">तूह कर मुल्है झींण संघा बच़ाऊ मुंह।<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />हे बिधाता, हुंह पाआ सिधी ताह सेटा पकार,</para>
  <para style="q" vid="PSA 31:17">मुंह निं शर्मिंदै दैई हणैं।</para>
  <para style="q" vid="PSA 31:17">शर्मिंदै लोल़ी तिंयां कदुष्ट हुऐ अर</para>
  <para style="q" vid="PSA 31:17">तिंयां लोल़ी जम्परी डेऊई नड़क्‍क हुऐ।<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />तिन्‍नां झ़ुठे खाखा लोल़ी शाण लागअ,</para>
  <para style="q" vid="PSA 31:18">ज़ुंण घमंडी अर शरेरै आसा अर ज़ुंण</para>
  <para style="q" vid="PSA 31:18">धर्मीं मणछे बारै झ़ुठी निंदा करा।<verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />भली च़िज़ा भाल़ केही बधिया हआ,</para>
  <para style="q" vid="PSA 31:19">तेता डाहा तूह तिन्‍नां लै ज़ुंण तेरअ अदर करा!</para>
  <para style="q" vid="PSA 31:19">एतो थोघ लागा सोभी मणछा का कि तूह किहअ भलअ आसा</para>
  <para style="q" vid="PSA 31:19">अर ज़ुंण ताह दी भरोस्सअ डाहा, तिन्‍नें तूह केही राम्बल़ै करै करा फाज़त।<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />तूह डाहा तिन्‍नां आप्पू सेटा हाल़्है,</para>
  <para style="q" vid="PSA 31:20">तिन्‍नां हारनै-मारनै आल़ै छ़ुंढा का बच़ाऊई।</para>
  <para style="q" vid="PSA 31:20">तूह डाहा तिन्‍नां आपणैं छ़ाप्परा हेठै</para>
  <para style="q" vid="PSA 31:20">तिन्‍नें दुशमणे फुआह का बच़ाऊई।<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />हे बिधाता, मुंह करनी तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 31:21">तंऐं किई मुल्है तेभै महान झींण</para>
  <para style="q" vid="PSA 31:21">ज़ेभै हुंह दुशमणै फेरा-फेर थिअ गोटअ द।<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />मुंह त दर्छ़णअ छ़ुटअ द अर मंऐं हेरअ त इहअ सोठी,</para>
  <para style="q" vid="PSA 31:22">“तिन्‍नैं किअ हुंह ताह बिधाता सेटा का दूर!”</para>
  <para style="q" vid="PSA 31:22">पर तंऐं शूणीं मेरी लेर-पकार</para>
  <para style="q" vid="PSA 31:22">ज़ांऊं मंऐं ताखा मज़त मांगणा लै हाक्‍का पाई।<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />ए बिधाते लोगो, तम्हैं झ़ूरा बिधाता लै!</para>
  <para style="q" vid="PSA 31:23">ज़ुंण शुचअ-पाक्‍कअ रहा, तेऊए फाज़त करा बिधाता।</para>
  <para style="q" vid="PSA 31:23">पर घमंडी लै दैआ सह पाक्‍कै दी सज़ा।<verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />ओ लोगो, ज़ुंण बिधाता दी आशा डाहा,</para>
  <para style="q" vid="PSA 31:24">तम्हैं डाहा हैअ अर तम्हैं लोल़ी पाक्‍कै रहै।<note caller="-" style="x"><char style="xo" closed="false">31:24 </char><char style="xt" closed="false"><ref loc="1CO 16:13">1 करि. 16:13</ref></char></note><verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">माफी छ़ाडणा लै अरज़</para>
  <para style="d">राज़ै दाबेदो खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />तिन्‍नां लै भाल़ केही बर्गत हुई,</para>
  <para style="q" vid="PSA 32:1">ज़सरै पाप बिधाता माफ किऐ अर दोश दूर किऐ।<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />तिन्‍नां मणछा लै आसा बर्गत ज़हा लै बिधाता पाप करनैओ दोश निं काढअ</para>
  <para style="q" vid="PSA 32:2">अर ज़सरै दिलै किछ़ै कपट निं आथी।<verse eid="PSA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />ज़ेभै तैणीं मंऐं अह गल्‍ल निं मनी कि मंऐं आसा पाप किऐ दै,</para>
  <para style="q" vid="PSA 32:3">हुंह हआ त सारी-सारी धैल़ी धकदअ लागअ द अर मेरै गल़ै हाडकै बी।<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />हे बिधाता, तूह दैआ त धैल़-राच मुल्है सज़ा,</para>
  <para style="q" vid="PSA 32:4">मेरै हुऐ तै ज़ोर-ज़ाहण ई इहै खतम</para>
  <para style="q" vid="PSA 32:4">ज़िहै गरमीं करै बाच शुक्‍का।<verse eid="PSA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />खिरी मनअ मंऐं ताह सेटा कि मंऐं किऐ पाप,</para>
  <para style="q" vid="PSA 32:5">मंऐं निं ताह सेटा किछ़ै गलती च़ोरी डाही।</para>
  <para style="q" vid="PSA 32:5">मंऐं सोठअ इहअ कि मुंह मनणी ताह सेटा सोभै गलती,</para>
  <para style="q" vid="PSA 32:5">तंऐं किऐ तेखअ मेरै सारै पाप माफ।<verse eid="PSA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />तैही लागा तेरै सोभी लोगा बगत रहंदी ताह सेटा अरज़ करनी,</para>
  <para style="q" vid="PSA 32:6">ताकि ज़ेभै आफ़तो बडअ दरैअ एछे,</para>
  <para style="q" vid="PSA 32:6">तेभै निं सह तिन्‍नां सेटा पुजणअ कि तिन्‍नां घर्होहल़ी सके।<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />मेरै लुक्‍की रहणें ज़ैगा आसा तूह ई,</para>
  <para style="q" vid="PSA 32:7">ताह डाहणअ हुंह आफ़ता का बच़ाऊई।</para>
  <para style="q" vid="PSA 32:7">ज़ुंण ज़ीत तंऐं मुल्है दैनी,</para>
  <para style="q" vid="PSA 32:7">मुंह बोल़णीं तेते ज़ोरै-ज़ोरै गिहा।<verse eid="PSA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />हे बिधाता, तूह बोला मुल्है इहअ,</para>
  <para style="q" vid="PSA 32:8">“हुंह खोज़ूं ताखा तैहा बाता ज़ेथ ताह हांढणअ लागा,</para>
  <para style="q" vid="PSA 32:8">हुंह रहूं ताल्है सलाह दैंदअ अर ताह भाल़अ लागी।<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />तम्हैं निं घोल़ै अर खच़रा ज़िहै रही ज़हा समझ़ निं हंदी,</para>
  <para style="q" vid="PSA 32:9">तिंयां लागा मुर्क अर नकेल लाई काबू करनै,</para>
  <para style="q" vid="PSA 32:9">नांईं ता ठुर्हा तिंयां कज़ेस्सी।”<verse eid="PSA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />कदुष्ट मणछा लागणीं खास्सी दाह ज़िरनी,</para>
  <para style="q" vid="PSA 32:10">पर ज़ुंण बिधाता दी भरोस्सअ डाहा,</para>
  <para style="q" vid="PSA 32:10">तेऊ लै करनी बिधाता झींण।<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />ज़ुंण धर्मीं मणछ आसा तम्हैं मनाऊंआं खुशी कि</para>
  <para style="q" vid="PSA 32:11">तम्हैं सोभै आसा बिधाता संघै,</para>
  <para style="q" vid="PSA 32:11">भोल़ै मणछ करा ज़ोरै-ज़ोरै तेऊए ज़ै-ज़ैकार।<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">बिधाते ज़ै-ज़ैकार करना लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />ए धर्मीं मणछो,</para>
  <para style="q" vid="PSA 33:1">ज़ुंण बिधाता किअ, तेता लै करा तेऊए ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 33:1">किल्हैकि धर्मीं मणछा शोभा अह ई गल्‍ल।<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />बिधातो करा बींन बाज़ी करै शूकर,</para>
  <para style="q" vid="PSA 33:2">दस तारा आल़ै बाज़ै बाज़ी बोला तेऊओ भज़न।<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />बिधाते गांठा एक नऊंईं गिह,</para>
  <para style="q" vid="PSA 33:3">तेऊ लै बाज़ा बधिया रागा दी बींन।<verse eid="PSA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />ज़ुंण बिधाता बोला, तिंयां गल्‍ला हआ शुची।</para>
  <para style="q" vid="PSA 33:4">सह निं किछ़ू कामां लै भेदभाब करदअ<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />सह झ़ूरा धर्म अर नसाफ करना लै,</para>
  <para style="q" vid="PSA 33:5">तेऊए झींण आसा पृथूई दी सोभी लै हर ज़ैगा।<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />बिधाता बणाअं खाखा का बैण बोली सारअ भ्रमंड,</para>
  <para style="q" vid="PSA 33:6">ज़िहअ सह खाखा बोल्दअ रहअ तिहै ई रहै सुरज़, ज़ोथ अर सोभै तारै बणदै लागी।<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />तेऊ झाल़अ समुंदरो पाणीं एकी बाखा लै,</para>
  <para style="q" vid="PSA 33:7">संघा डाहै डुघै समुंदरे पाणींए भढार भरी।<verse eid="PSA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />पृथूईए सोभी ज़ीबा लागा बिधाते डरा हेठै रहणअ,</para>
  <para style="q" vid="PSA 33:8">धरती दी ज़ेतरै मणछ आसा, तिन्‍नां लागा तेऊए ज़ै-ज़ैकार करनी।<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />किल्हैकि ज़िहअ ई बिधाता बैण बोलअ, संसार बणअ तिहअ ई,</para>
  <para style="q" vid="PSA 33:9">ज़िहअ तेऊ हुकम किअ, सह हुअ तिहअ ई प्रगट।<verse eid="PSA 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />देशा-देशे लोग च़ाऐ ज़ेही बी बिक्री सोठे;</para>
  <para style="q" vid="PSA 33:10">तिंयां हआ तेऊ सेटा बृथा,</para>
  <para style="q" vid="PSA 33:10">सह निं तिन्‍नें तरकिबा सफल दैंदअ हणैं।<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />पर ज़ुंण बिधाता आप्पू सोठा सह हआ तिहअ ई,</para>
  <para style="q" vid="PSA 33:11">ज़ुंण सह सोठा, सह रहा पोस्ती दर पोस्ती अटल़,<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />तेऊ देशा लै आसा खास्सी बर्गत ज़सरअ परमेशर बिधाता आसा,</para>
  <para style="q" vid="PSA 33:12">तेऊ समाज़े लोग रहणैं खुश ज़हा सह आप्पू लै छ़ांटा।<verse eid="PSA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />बिधाता हआ स्वर्गा का उंधै भाल़अ लागअ द,</para>
  <para style="q" vid="PSA 33:13">तेऊए आछ हआ हरेकी मणछा दी लागी दी।<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />सह रहा आपणीं राज़गाद्दी प्रैंदै बेशी</para>
  <para style="q" vid="PSA 33:14">धरती दी बस्सै दै सोभी मणछा ज़ाच़दअ लागी।<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />मणछो मन्‍न आसा तेऊ ई बणाअं द,</para>
  <para style="q" vid="PSA 33:15">तेऊ का हआ तिन्‍नें सोभी कामें बारै थोघ।<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />कोही बी राज़ै का केतरी बी खास्सी सैना किल्है निं होए,</para>
  <para style="q" vid="PSA 33:16">सह निं तेते आसरै ज़िती सकदअ अर</para>
  <para style="q" vid="PSA 33:16">नां कुंण शूर-बीर जोधअ आपणैं ज़ोरै छ़ुटी सकदअ।<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />घोल़ै आसरै निं जुध ज़िती सकदै,</para>
  <para style="q" vid="PSA 33:17">तिन्‍नों खास्सअ बल बी निं मणछा बच़ाऊई सकदअ।<verse eid="PSA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />पर बिधाता रहा तिन्‍नां भाल़अ लागी ज़ुंण तेऊओ अदर करा,</para>
  <para style="q" vid="PSA 33:18">अर ज़ुंण तेऊए झींण करने आशा डाहा।<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />सह बच़ाऊआ तिन्‍नां मरनै का,</para>
  <para style="q" vid="PSA 33:19">घोर नकाल़ा जैंदरी बी डाहा तिन्‍नां ज़िऊंदै।<verse eid="PSA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />हे बिधाता, हाम्हैं आसा तेरै आसरै,</para>
  <para style="q" vid="PSA 33:20">तूह कर म्हारी मज़त, हाम्हां डाह बच़ाऊई।<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />ताह बिधाता करै हआ म्हारै दिलै खुशी,</para>
  <para style="q" vid="PSA 33:21">किल्हैकि हाम्हैं करा ताह पबित्र परमेशरा दी भरोस्सअ।<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />हे बिधाता, हाम्हां लै दै आपणीं बर्गत,</para>
  <para style="q" vid="PSA 33:22">हाम्हां लै कर झींण, ज़ेही हाम्हैं ताखा आशा डाहा।<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">बिधाता हेरा धर्मीं मणछा बच़ाऊई</para>
  <para style="d">ज़धू राज़अ दाबेदै अबीमोलका सेटा बेगरै हणैंओ दखाअ किअ त, तधू बोलअ त तेऊ अह भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />मुंह करनअ सदा बिधातो शूकर,</para>
  <para style="q" vid="PSA 34:1">हुंह निं तेऊए ज़ै-ज़ैकार करनै का कधि पिछ़ू हटदअ।<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />ज़ुंण बिधाता किअ, तेता लै करनी मुंह तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 34:2">ताकि भोल़ै मणछ शूणीं खुश होए।<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />मुंह संघै करा बिधाते बड़ैई!</para>
  <para style="q" vid="PSA 34:3">सोभै करा तेऊए महान नाओंए ज़ै-ज़ैकार।<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />मंऐं किई बिधाता सेटा अरज़ अर तेऊ शूणीं मेरी गल्‍ला,</para>
  <para style="q" vid="PSA 34:4">तेऊ दैनअ मुल्है छ़ुटकारअ अर मुंह निं किछ़ै डअर रही।<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />ज़ुंणी तेऊ बाखा भाल़अ, तिन्‍नां भेटी खुशी,</para>
  <para style="q" vid="PSA 34:5">तिन्‍नें मुंह निं कधि शर्मिंदै हई न्हैरै फिरै।<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />रैनै-गरीबै पाई बिधाता सेटा पकार अर तेऊ शूणीं,</para>
  <para style="q" vid="PSA 34:6">संघा बच़ाऊऐ तिंयां सोभी आफ़ता का।<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />ज़ुंण बिधातो अदर करा, तिन्‍नें फाज़त लै हआ</para>
  <para style="q" vid="PSA 34:7">बिधाते स्वर्ग दूत फेरा-फेर रहै दै, तिंयां बच़ाऊआ तिन्‍नां आफ़ता का।<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />तम्हैं लआ परखी संघा भाल़ै आप्पै कि बिधाता किहअ भलअ आसा।</para>
  <para style="q" vid="PSA 34:8">तिंयां मणछ भाल़ किहै खुश हणैं ज़ुंण बिधाता सेटा शरण लआ।<verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />ए बिधाते पबित्र लोगो, तेऊओ करा अदर,</para>
  <para style="q" vid="PSA 34:9">किल्हैकि ज़ुंण तेऊए डरा हेठै रहा, तिन्‍नां निं किछ़ू गल्‍ले निऊल़ हंदी।<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />हई सका कि खारकअ सिह भुखअ रहे,</para>
  <para style="q" vid="PSA 34:10">पर ज़ुंण बिधाते आसरै रहा, तिन्‍नां भेटा सोभै भली गल्‍ला।<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />लान्हैंओ, मुंह नेल़ एछा संघा शूणां मेरी गल्‍ला,</para>
  <para style="q" vid="PSA 34:11">हुंह खोज़ूं तम्हां का बिधातो अदर किहअ लागा करनअ।<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />तम्हां मांझ़ै ज़ुंण बी मणछ आपणीं ज़िन्दगी राज्ज़ी-मौज़ी च़ाहा कि</para>
  <para style="q" vid="PSA 34:12">थारी अमर लाम्मी होए, अर तेथ थारअ भलअ होए?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />तै निं आपणीं ज़िभा का कधि बूरअ बोली,</para>
  <para style="q" vid="PSA 34:13">नां आपणैं होठा का झ़ुठअ बोली।<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />बूरै करनै का हटै पिछ़ू, तम्हैं करै भलअ ई,</para>
  <para style="q" vid="PSA 34:14">तम्हैं दैणअ दिला का मेल़-ज़ोल़ करनै बाखा ज़ोर।<verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />बिधाता हआ धर्मीं मणछा भाल़अ लागअ द,</para>
  <para style="q" vid="PSA 34:15">सह हेरा तिन्‍नें अरज़ शूणीं।<verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />पर बूरै करनै आल़ै मणछा बाखा डाहा बिधाता पिठ फरेऊई,</para>
  <para style="q" vid="PSA 34:16">संघा करा पृथूई का तिन्‍नों नाअं-नशाण ई खतम।<note caller="-" style="x"><char style="xo" closed="false">34:16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 पत. 3:10-12</ref></char></note><verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />बिधाता हेरा धर्मीं मणछे लेर-पकार शूणीं,</para>
  <para style="q" vid="PSA 34:17">संघा बच़ाऊआ सह तिन्‍नां सोभी आफ़ता का।<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />ज़हा मणछो हैअ चुटअ बिधाता हआ तिन्‍नां नेल़,</para>
  <para style="q" vid="PSA 34:18">ज़हा किछ़ै आशा निं रही, तिन्‍नां बच़ाऊआ बिधाता आप्पै।<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />धर्मीं मणछा लै एछा खास्सी आफ़ता,</para>
  <para style="q" vid="PSA 34:19">पर बिधाता बच़ाऊआ तिन्‍नां सोभी का।<verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />बिधाता डाहा तिन्‍नां पठी राज्ज़ी-राम्बल़ै,</para>
  <para style="q" vid="PSA 34:20">तेऊओ निं सह धख ज़िहअ हाडकअ बी चुटणैं दैंदअ।<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">जोह. 19:36</ref></char></note><verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />कदुष्ट मणछ मरनअ बूरै करै,</para>
  <para style="q" vid="PSA 34:21">ज़ुंण धर्मीं मणछा संघै ज़ीद डाहा, तिन्‍नां लागणअ दोश अर नां तिंयां सज़ा का बच़ी सकदै।<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />ज़ुंण बिधाते च़ाकरी करा तिंयां हेरनै तेऊ मोल दैई बच़ाऊई,</para>
  <para style="q" vid="PSA 34:22">तेऊ सेटा शरण लणैं आल़ै मणछा लै निं दोश लागदअ अर नां सज़ा हई सकदी।<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">दुशमणा का ज़ितणा लै अरज़</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />हे बिधाता, ज़ुंण दुशमण मेरअ दाऊअ करा, तिन्‍नां संघै लल़ तूह आप्पै,</para>
  <para style="q" vid="PSA 35:1">ज़ुंण मुंह संघै जुध छ़ेल़ा, तिन्‍नां संघै कर तूह आप्पै जुध।<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />हे बिधाता, आपणीं ढाल़</para>
  <para style="q" vid="PSA 35:2">अर बर्छ़ी लई कर मेरी मज़त,<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />आपणीं बर्छ़ी हार तिन्‍नां बाखा</para>
  <para style="q" vid="PSA 35:3">ज़ुंण मुंह पिछ़ू आसा पल़ै दै,</para>
  <para style="q" vid="PSA 35:3">तूह दै मुल्है ज़बान कि ताह हेरनअ हुंह बच़ाऊई।<verse eid="PSA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />ज़ुंण मुंह मारनअ च़ाहा, तिंयां लोल़ी हारै अर शर्मिंदै हुऐ!</para>
  <para style="q" vid="PSA 35:4">ज़ुंण मेरी हान्‍नी करने बिक्री सोठा,</para>
  <para style="q" vid="PSA 35:4">तिंयां लोल़ी डरै पिछ़ू फिरै अर</para>
  <para style="q" vid="PSA 35:4">तिन्‍नां जैंदरी लोल़ी झाख पल़अ।<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />तिन्‍नां पिछ़ू छ़ाड आपणैं स्वर्ग दूत</para>
  <para style="q" vid="PSA 35:5">अर तिंयां लोल़ी बागरी फर्ल़ाऊऐ दै भुखलै ज़िहै हुऐ।<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />तिन्‍नें बात लोल़ी न्हैरी अर च़िफली हुई,</para>
  <para style="q" vid="PSA 35:6">ताह बिधाते स्वर्ग दूत लोल़ी तिन्‍नां दरल़ाऊंदै पिछ़ू हुऐ पल़ै दै।<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />किल्हैकि तिन्‍नैं डाहअ मुल्है थोघै बाझ़ी डुघी खाल़्ही प्रैंदै ज़ज़ाल़ छ़ैई,</para>
  <para style="q" vid="PSA 35:7">तिन्‍नैं डाही मुंह मारना लै एही बाझ़ी मुल्है डुघी खात्ती खण्हीं।<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />हे बिधाता, तिन्‍नां लै लोल़ी ती नच़ानक आफ़त पल़ी!</para>
  <para style="q" vid="PSA 35:8">ज़ुंण ज़ज़ाल़ तिन्‍नैं मुल्है छ़ैअ, तेथ लोल़ी तै तिंयां आप्पू शाचै अर</para>
  <para style="q" vid="PSA 35:8">तिंयां लोल़ी तै तैहा खात्ती दी आप्पू दाभूऐ ज़ुंण तिन्‍नैं मुल्है डाही ती खण्हीं!<verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />पर हे बिधाता, मुंह रहणअ ताह संघै मगन अर</para>
  <para style="q" vid="PSA 35:9">मुंह आसा ऐहा गल्‍ले खुशी कि तंऐं डाहअ हुंह बच़ाऊई।<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />मुंह बोल़णअ दिला का इहअ,</para>
  <para style="q" vid="PSA 35:10">“ताह बिधाता बराबर निं कोहै आथी।</para>
  <para style="q" vid="PSA 35:10">तूह बच़ाऊआ दुबल़ै मणछा जोधै मणछे हाथा का अर</para>
  <para style="q" vid="PSA 35:10">रैनै-गरीब मणछा डाहा तूह च़ोरा-डाकू का बच़ाऊई।”<verse eid="PSA 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />कदुष्ट मणछ दैआ मेरै बारै झ़ुठी शाजत!</para>
  <para style="q" vid="PSA 35:11">तिंयां लाआ मुल्है इहै ज़ुल्म करनैओ दोश ज़ेतो मुखा थोघ बी निं आथी!<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />मेरै भलै करने बदल़ै करा तिंयां मुल्है बूरअ,</para>
  <para style="q" vid="PSA 35:12">मुल्है आणा तिंयां गल़ै तैणीं घाटी।<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />ज़धू तिंयां रोगी थिऐ, तधू किअ मंऐं तिन्‍नां लै शोग,</para>
  <para style="q" vid="PSA 35:13">हुंह रहअ तिन्‍नें तैणीं भुखअ अर दुखा ज़िरदअ लागी,</para>
  <para style="q" vid="PSA 35:13">मंऐं किई बिधाता सेटा माथअ टेक्‍की करै दिला का तिन्‍नां लै अरज़,<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />हुंह डाहा त आपणैं दिलै तिन्‍नां लै इहअ भाअ कि</para>
  <para style="q" vid="PSA 35:14">तिंयां आसा मेरै साथी अर मेरै भाई-भाऊ ज़िहै,</para>
  <para style="q" vid="PSA 35:14">मंऐं किअ तिन्‍नां लै इहअ शोग ज़िहअ कुंण आपणीं ईजा लै करा।<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />पर ज़ांऊं मुल्है खरी आई, तिंयां दुशमण हुऐ सोभै खुश!</para>
  <para style="q" vid="PSA 35:15">तिन्‍नैं किअ मुंह फेर झाल़अ संघा लागै मेरै सुहांगा!</para>
  <para style="q" vid="PSA 35:15">पाखलै मणछ तोही आऐ मुंह च़िक्‍कदै-मारदै,</para>
  <para style="q" vid="PSA 35:15">तिंयां रहै कबल्‍लै मुंह धेल़दै-च़िरदै लागी।<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />तिंयां लागा तै मेरै सुहांगा अर कई नाअं नोहकल़ी डाहंदै,</para>
  <para style="q" vid="PSA 35:16">ज़िदै लागा तै तिंयां मुल्है दांदा कटिल्‍लदै!<verse eid="PSA 35:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />हे मेरै मालक, ताह केभै तैणीं रहणअ भाल़ै लागी?</para>
  <para style="q" vid="PSA 35:17">ज़हा आफ़ता दी तिन्‍नैं दुशमणै हुंह पाअ, मुंह बच़ाऊ तेता का,</para>
  <para style="q" vid="PSA 35:17">मेरी ज़िन्दगी बच़ाऊ इना नर्दैई सिहा का।<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />ज़ेभै तेरै लोगो झाल़अ होए, तेभै करनअ मुंह तेरअ शूकर अर</para>
  <para style="q" vid="PSA 35:18">तिन्‍नां सोभी नदरी करनी मुंह तेरी ज़ै-ज़ैकार।<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />मेरै बारै झ़ुठी शाजत दैणैं आल़ै मेरै दुशमणा</para>
  <para style="q" vid="PSA 35:19">निं लोल़ी मुंह हारने खुशी भेटी,</para>
  <para style="q" vid="PSA 35:19">ज़ुंण थोघै बाझ़ी मुंह संघै ज़ीद डाहा,</para>
  <para style="q" vid="PSA 35:19">तिन्‍नां निं दैई मुंह पिछ़ू सानै-कानै गल्‍ला करनै।<verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />किल्हैकि तिंयां निं मेल़-ज़ोल़े गल्‍ला ई करदै,</para>
  <para style="q" vid="PSA 35:20">तिंयां सोठा नर्दोश मणछा लै छ़ल़-कपट मिल़ी-ज़ुल़ी हआ रहंदै लागै दै।<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />तिंयां लाआ हेरा-हेरी मुल्है दोश!</para>
  <para style="q" vid="PSA 35:21">तिंयां बोला थोघै बाझ़ी, “अह किअ तंऐं, हाम्हैं भाल़अ तूह आपणीं आछी!”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />पर हे मेरै मालक बिधाता, तूह हेरा सोभी गल्‍ला भाल़ी!</para>
  <para style="q" vid="PSA 35:22">तूह किल्है आसा च़ुप्पी रहअ द?</para>
  <para style="q" vid="PSA 35:22">हे मेरै मालक! तूह निं मुंह आप्पू का दूर करी!<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />हे बिधाता, ऐबै उझ़ू संघा कर मेरअ नसाफ,</para>
  <para style="q" vid="PSA 35:23">हे मेरै मालक, ऐबै कर तूह ई मेरै एऊ झ़गल़ै खतम।<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />हे मेरै मालक बिधाता, तूह आसा धर्मीं, तूह खोज़ ऐबै आप्पै कि हुंह आसा नर्दोश,</para>
  <para style="q" vid="PSA 35:24">मेरै दुशमणा निं मुल्है हास्सणैं दैई।<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />तिन्‍नें निं आप्पू मांझ़े एही गल्‍ला लोल़ी हुई,</para>
  <para style="q" vid="PSA 35:25">“हाम्हैं पाअ सह ज़िऊंदअ ई घुटी!</para>
  <para style="q" vid="PSA 35:25">इहअ ई ता हाम्हैं च़ाहा तै।”<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />ज़ुंण मेरी हान्‍नी करना लै खुश हआ,</para>
  <para style="q" vid="PSA 35:26">तिंयां लोल़ी तै पठी हारै अर झाखुऐ,</para>
  <para style="q" vid="PSA 35:26">तिंयां लोल़ी तै पठी बेइज़त अर शर्मिंदै हुऐ ज़ुंण</para>
  <para style="q" vid="PSA 35:26">मुल्है इहअ बोला तै, “तूह निं हाम्हां सेटा किछ़ बी आथी!”<verse eid="PSA 35:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />पर ज़ुंण मेरी ज़ीत च़ाहा तै,</para>
  <para style="q" vid="PSA 35:27">तिन्‍नां लोल़ी ती नाच़णै जोगी खुशी हुई,</para>
  <para style="q" vid="PSA 35:27">एभा पोर्ही लोल़ी तै सदा तिंयां इहअ बोल्दै रहै,</para>
  <para style="q" vid="PSA 35:27">“बिधाता भाल़ किहअ महान आसा! तेऊ हआ आपणैं दास सफल हणें खुशी।”<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />तेखअ खोज़णअ मुंह सोभी का कि बिधाता आसा धर्मीं, तेऊ किअ मेरअ नसाफ</para>
  <para style="q" vid="PSA 35:28">अर मुंह रहणअ सारी-सारी धैल़ी तेरी ज़ै-ज़ैकार करदै लागी।<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">मणछो पाप अर परमेशरे भलाई</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै बिधाते च़ाकरी करनै आल़ै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />कदुष्ट मणछा निं बिधाते डअर हंदी,</para>
  <para style="q" vid="PSA 36:1">तिन्‍नें दिलै हआ सिधी पाप करने सोठ।<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />तिंयां सोठा आपणैं बारै बेघै खास्सअ,</para>
  <para style="q" vid="PSA 36:2">तिंयां सोठा आपणैं मन्‍नैं इहअ कि</para>
  <para style="q" vid="PSA 36:2">बिधाता निं तिन्‍नें पाप शुझदै अर नां तिन्‍नां तेते सज़ा भेटणीं।<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />तिन्‍नें हआ गल्‍ला ई कदुष्ट अर झ़ुठी,</para>
  <para style="q" vid="PSA 36:3">तिंयां निं कधू अक्ल अर भली गल्‍ला करदै ई आथी।<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />च़ैनैं सुत्ती बी हआ तिंयां बूरी बिक्री सोठदै लागै दै,</para>
  <para style="q" vid="PSA 36:4">तिंयां निं भलअ सोठदै ई आथी,</para>
  <para style="q" vid="PSA 36:4">तिंयां निं बूरै करनै का पिछ़ू हटदै ई आथी!<verse eid="PSA 36:4" /></para>
  <para style="s">परमेशरे भलाई</para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />हे बिधाता, तेरी झ़ूरी आसा पृथूई उझै स्वर्गै तैणीं,</para>
  <para style="q" vid="PSA 36:5">तेरअ सत्त आसा सरगा का बी उझै तैणीं।<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />परमेशर, तेरअ धर्म आसा बडै पर्बता ज़िहअ,</para>
  <para style="q" vid="PSA 36:6">तेरअ नसाफ आसा डुघै समुंदरा ज़िहअ।</para>
  <para style="q" vid="PSA 36:6">मणछ अर सोभी ज़ीबे फाज़त करा तूह बिधाता ई।<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />तेरअ हाम्हां मणछा लै झ़ूरनअ आसा किम्मती खज़ानै ज़िहअ!</para>
  <para style="q" vid="PSA 36:7">हाम्हैं लआ तेरै फैंखा हेठै शरण।<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />तूह दैआ हाम्हां लै आपणैं घअरा<note caller="+" style="f"><char style="fr" closed="false">36:8 </char><char style="fq" closed="false">घअरा </char><char style="ft" closed="false">भबना का</char></note> का रज्ज़ी खाणां लै,</para>
  <para style="q" vid="PSA 36:8">तूह दैआ हाम्हां आपणीं भलाईए गाडा का रज्ज़ी झुटणा लै।<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />ज़िन्दगी दैणैं आल़ी सोबल़ आसा ताखा ई,</para>
  <para style="q" vid="PSA 36:9">अर तेरै धुप्पै करै हआ हाम्हां सोभी लै प्रैश्शअ।<verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />हे बिधाता, ज़ुंण ताल्है झ़ूरा, तिन्‍नां लै दै आपणीं झ़ूरी तरैल़ी करै,</para>
  <para style="q" vid="PSA 36:10">ज़ुंण धर्मीं आसा तिन्‍नां लै कर भलअ।<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />घमंडी मणछ निं लोल़ी हाम्हां लै लात्तै बाही सकै,</para>
  <para style="q" vid="PSA 36:11">नां तिन्‍नैं कदुष्ट मणछै हाम्हैं धाक्‍कै दैई दरल़ाऊऐ।<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />हे बिधाता, भाल़! कदुष्ट मणछ पल़ै ढेक्‍का,</para>
  <para style="q" vid="PSA 36:12">तिंयां बधल़ुऐ उंधै अर ऐबै निं तिंयां भिई खल़ै उझ़णै जोगी रहै।<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">बिधाते आसरै रहा</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />बूरै कर्म करनै आल़ै मणछ निं पाल्‍लै पाणै हंदै,</para>
  <para style="q" vid="PSA 37:1">नां कदुष्ट मणछा संघै ज़ीद डाहणीं।<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />तिंयां जाणैं घाह ज़िहै झ़ट च़ारै खतम हई,</para>
  <para style="q" vid="PSA 37:2">तिंयां मछैणैं बाझ़ी पाणीं हरै घाहा ज़िहै।<verse eid="PSA 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />बिधाता दी डाहणअ भरोस्सअ, आप्पू रहणअ भलअ करदै लागी।</para>
  <para style="q" vid="PSA 37:3">तै रहणैं तम्हैं तेऊ देशै<note caller="+" style="f"><char style="fr" closed="false">37:3 </char><char style="fq" closed="false">तेऊ देशै </char><char style="ft" closed="false">कनान देशै ज़ेता दैणें बिधाता करार किई ती</char></note> बस्सी अर राज्ज़ी-राम्बल़ै।<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />तम्हैं करै तिहअ ज़िहअ बिधाता च़ाहा,</para>
  <para style="q" vid="PSA 37:4">तै करनी तेऊ थारी दिला-मन्‍नें पूरी।<verse eid="PSA 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />सोभै गल्‍ला दैआ बिधाते हाथै छ़ाडी,</para>
  <para style="q" vid="PSA 37:5">बिधाता दी डाहा भरोस्सअ, तेऊ हेरनी सोभै गल्‍ला पूरी करी।<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />तेऊ करनअ थारअ धर्म प्रैश्शै ज़िहअ</para>
  <para style="q" vid="PSA 37:6">अर थारअ नसाफ करनअ तेऊ दपहरे धुप्पै ज़िहअ।<verse eid="PSA 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />सबर डाहणअ संघा दैणअ बिधाता काम करनै,</para>
  <para style="q" vid="PSA 37:7">कदुष्ट मणछा सफल हंदै भाल़ी निं फिकर करनअ अर</para>
  <para style="q" vid="PSA 37:7">नां तिन्‍नें कदुष्ट बिक्री भाल़ी हैल़अ करी।<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />नां रोश्श करी अर नां बखर्दै लागी,</para>
  <para style="q" vid="PSA 37:8">ज़ै रोश्श काबू निं हुअ, तेता करै हआ आफ़त खल़ी।<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />किल्हैकि सोभै कदुष्ट पापी हणैं बरैबाद,</para>
  <para style="q" vid="PSA 37:9">धरतीए मालक<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="fq" closed="false">धरतीए मालक </char><char style="ft" closed="false">ज़ुंण बिधाता करार किई ती, तैहा ज़ैगे मालक</char></note> हणैं तिंयां ज़ुंण बिधाता दी भरोस्सअ डाहा।<verse eid="PSA 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />कदुष्ट हणैं छ़ेक्‍कै खतम,</para>
  <para style="q" vid="PSA 37:10">तम्हां निं तेखअ तिंयां लोल़ी-तोप्पी करै बी च़ाल्‍लै भेटी।<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />पर भोल़ै मणछ हणैं धरतीए मालक,</para>
  <para style="q" vid="PSA 37:11">संघा रहणैं तिंयां राज्ज़ी-खुशी बस्सी।<verse eid="PSA 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />कदुष्ट सोठा भलै मणछा लै बूरी गल्‍ला,</para>
  <para style="q" vid="PSA 37:12">सह डाहा तिन्‍नां लै ज़ीद संघा लागा दांदा कटिल्‍लदअ।<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />पर म्हारअ मालक बिधाता लागा तिन्‍नां कदुष्ट मणछा लै हास्सदअ,</para>
  <para style="q" vid="PSA 37:13">किल्हैकि तेऊ का हआ थोघ कि तिन्‍नों बरैबाद हणैंओ बगत आसा छ़ेक्‍कै ज़ेभै खिरी नसाफ हणअ।<verse eid="PSA 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />कदुष्ट मणछ एछा तलबार अर</para>
  <para style="q" vid="PSA 37:14">कतीर-कबाण खिंच़ी रैनै-गरीबा मारदै अर</para>
  <para style="q" vid="PSA 37:14">ज़ुंण भलअ करा तिन्‍नां मारी पाणा लै ठुर्ही।<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />पर तिन्‍नें तलबारा करै मरनै तिंयां आप्पू ई,</para>
  <para style="q" vid="PSA 37:15">अर तिन्‍नें कतीर-कबाण पाणै चोल़ी।<verse eid="PSA 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />धर्मीं ज़िन्दगी ज़िऊई गरीब रहणअ आसा</para>
  <para style="q" vid="PSA 37:16">पाप करी सेठ हणैं का भलअ।<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />किल्हैकि बिधाता करनै कदुष्ट मणछे ज़ोर-ज़ाहण खतम,</para>
  <para style="q" vid="PSA 37:17">पर धर्मीं मणछे करनी तेऊ फाज़त।<verse eid="PSA 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />नर्दोश मणछे करा बिधाता आप्पै हेर-सभाल़,</para>
  <para style="q" vid="PSA 37:18">तिन्‍नां भेटणीं ज़ैदात सदा लै।<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />खरीए पलका निं तिंयां शर्मिंदै हणैं अर</para>
  <para style="q" vid="PSA 37:19">तिन्‍नां जाणअ घोर नकाल़ा जैंदरी बी खाणां लै भेटी।<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />कदुष्ट मणछ हआ बिधाते दुशमण,</para>
  <para style="q" vid="PSA 37:20">तिंयां शुक्‍कणैं बणें फूला ज़िहै अर</para>
  <para style="q" vid="PSA 37:20">तिंयां लुक्‍कणै धूँआं ज़िहै।<verse eid="PSA 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />कदुष्ट निं ऋण काढी करै पोर्ही भर्दअ आथी,</para>
  <para style="q" vid="PSA 37:21">पर धर्मीं मणछ दैआ दिल खोल्ही दान पै।<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />ज़हा लै बिधाता बर्गत दैआ, तिंयां हणैं धरतीए मालक,</para>
  <para style="q" vid="PSA 37:22">पर ज़हा लै सह फिटक दैआ, तिंयां हणैं बरैबाद।<verse eid="PSA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />धर्मीं मणछा नढैऊआ बिधाता आप्पै,</para>
  <para style="q" vid="PSA 37:23">सह हआ तिन्‍नें ज़िन्दगीए हर गल्‍ला करै खुश।<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />च़ाऐ तिन्‍नां ठोहल़ बी लागे, तिंयां निं धरनीं बधल़णैं,</para>
  <para style="q" vid="PSA 37:24">किल्हैकि तिन्‍नों हाथ हआ बिधाता डाहअ द ढाकी।<verse eid="PSA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />हुंह हुअ ऐबै प्रोढअ अर मंऐं ज़िऊई खास्सी अमर,</para>
  <para style="q" vid="PSA 37:25">पर मंऐं निं इहअ कधि भाल़अ कि धर्मीं मणछ डाहै बिधाता कल्ही शोटी,</para>
  <para style="q" vid="PSA 37:25">नां इहअ भाल़अ कि तिन्‍नें लान्हैं लागै किधी टुकरी मांगी करै खांदै!<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />तिंयां धर्मीं दैआ होरी लै पै दिल खोल्ही ऋण अर</para>
  <para style="q" vid="PSA 37:26">तिन्‍नें हआ आजू आद-लुआदा लै बी खास्सी बर्गत।<verse eid="PSA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />बूरअ छ़ाडी करा भलअ,</para>
  <para style="q" vid="PSA 37:27">तै रहणीं थारी आद-लुआद तेऊ देशै सदा।<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />किल्हैकि बिधाता झ़ूरा नसाफ करना लै,</para>
  <para style="q" vid="PSA 37:28">सह निं धर्मीं मणछा शोटी डाहंदअ,</para>
  <para style="q" vid="PSA 37:28">सह करा सदा तिन्‍नें फाज़त।</para>
  <para style="q" vid="PSA 37:28">पर कदुष्टे आद-लुआद करनी तेऊ दूर।<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />धर्मीं मणछ हणैं धरतीए मालक</para>
  <para style="q" vid="PSA 37:29">अर तिंयां रहणैं सदा तेथ बस्सी।<verse eid="PSA 37:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />धर्मीं मणछे गल्‍ला हआ अक्लीए,</para>
  <para style="q" vid="PSA 37:30">तिंयां करा हर बगत नसाफे गल्‍ला।<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />तिंयां डाहा बिधातो बधान आपणैं दिलै आद,</para>
  <para style="q" vid="PSA 37:31">अर तिंयां निं तेता का ओर्ही नां पोर्ही गंईं दैंदै।<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />कदुष्ट मणछ रहा धर्मीं मणछा लै ताखुई,</para>
  <para style="q" vid="PSA 37:32">सह च़ाहा किहअ नां किहअ करै तेऊ मारी पाणअ।<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />पर बिधाता निं कदुष्ट मणछा सफल हणैं दैंदअ,</para>
  <para style="q" vid="PSA 37:33">ज़ेभै धर्मीं मणछे पेशी होए, तेभै निं बिधाता तिन्‍नां लै दोश लांदअ।<verse eid="PSA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />तम्हैं डाहणीं बिधाता दी आशा,</para>
  <para style="q" vid="PSA 37:34">संघा रहणअ तैहा बाता हांढदै लागी ज़ुंण तेऊ खोज़ी,</para>
  <para style="q" vid="PSA 37:34">तेऊ बणाणैं तम्हैं धरतीए मालक अर</para>
  <para style="q" vid="PSA 37:34">तम्हां का जाणअ आपणीं आछी शुझुई कि कदुष्ट हुऐ बरैबाद।<verse eid="PSA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />मंऐं भाल़ै कदुष्ट मणछ ज़ुंण होरी हंता,</para>
  <para style="q" vid="PSA 37:35">तिंयां बझ़ै पज़दी ज़ैगा बडै हरै बूटा ज़िहै!<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />पर बादा का ज़ांऊं हुंह तेस्सी बाती डेऊअ,</para>
  <para style="q" vid="PSA 37:36">पर सह नांईं त तिधी आथी!</para>
  <para style="q" vid="PSA 37:36">हुंह लागअ तेऊ ओर्ही-पोर्ही बी भाल़अ पर सह निं मुखा शुझुअ।<verse eid="PSA 37:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />तिन्‍नां बाखा दैआ भाल़णीं ज़ुंण भलै अर मानदार आसा,</para>
  <para style="q" vid="PSA 37:37">ज़ुंण मेल़-ज़ोल़ करना लै झ़ूरा, तिन्‍नां भेटा खिरी राम्बल़अ फल।<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />पर कदुष्ट पापी मणछ हआ पठी बरैबाद,</para>
  <para style="q" vid="PSA 37:38">तिन्‍नें निं आद-लुआद बी रहणीं।<verse eid="PSA 37:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />धर्मीं मणछा बच़ाऊआ बिधाता आप्पै,</para>
  <para style="q" vid="PSA 37:39">खरीए पलका हआ सह तिन्‍नां लै पाक्‍कै गहल़ा ज़िहअ।<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />बिधाता करा तिन्‍नें मज़त,</para>
  <para style="q" vid="PSA 37:40">सह हेरा तिन्‍नां कदुष्टा का बच़ाऊई,</para>
  <para style="q" vid="PSA 37:40">किल्हैकि तिन्‍नैं हआ तेऊ सेटा शरण लई दी।<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">खरीए पलका अरज़</para>
  <para style="d">आदगारी लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />हे बिधाता, ज़ेभै ताह रोश्श होए आई दी,</para>
  <para style="q" vid="PSA 38:1">तेभै निं मुंह नैरी नां मुल्है सज़ा दैई।<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />तेरै कतीरा करै हुअ हुंह छिझ-बरिझअ,</para>
  <para style="q" vid="PSA 38:2">तंऐं डाहअ हुंह आपणैं हाथा हेठै ठिंहीं।<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />तेरै रोश्शा करै उझ़ुई मुंह दाहे झोशा,</para>
  <para style="q" vid="PSA 38:3">ज़ुंण मंऐं पाप किऐ, तेता करै लागअ मेरी सारी देही रोग।<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />हुंह च़ाल्‍लअ मेरै पापे च़िक्‍करै जैंदरी पठी डुबी,</para>
  <para style="q" vid="PSA 38:4">मेरै पाप हुऐ मुल्है बेघै गर्कै बोझ़ै ज़िहै, ऐबै निं हुंह तेता ज़िरी सकदअ।<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />ज़ुंण मंऐं ऐडै ज़िहै पाप किऐ तेता करै चिजै मेरै ज़खम बी,</para>
  <para style="q" vid="PSA 38:5">तेता का आसा बेघै बूरी चजैन्ह लागी दी।<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />दाह-दुखै फिरअ मेरअ चल़ैट बी कुंगल़अ,</para>
  <para style="q" vid="PSA 38:6">सारी धैल़ी हआ हुंह धकदअ लागअ द।<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />ज़अरै लाअ हुंह आगी ज़िहअ दहई,</para>
  <para style="q" vid="PSA 38:7">हुंह निस्सअ दाह का बिज़री ई आथी।<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />हुंह हुअ पठी दुबल़अ अर ज़ोर-ज़ाहण निं किछ़ै रहै,</para>
  <para style="q" vid="PSA 38:8">मुंह हआ दिलै हैल़अ लागअ द अर दाहे झोशा करै हआ मुंह धअक लागी दी।<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />हे मालक, ताखा आसा मेरै दिले सोभी गल्‍लो थोघ,</para>
  <para style="q" vid="PSA 38:9">ताखा आसा मेरी दाहे धअक शुण्हदी लागी दी।<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />मेरै दिलै लाअ खास्सअ धुप-धुप करी,</para>
  <para style="q" vid="PSA 38:10">मेरै निस्सअ ऐबै आछी का शुझुई बी।<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />मेरी दाह भाल़ी हुऐ मेरै साथी-संघी बी मुखा दूर,</para>
  <para style="q" vid="PSA 38:11">मेरै आपणैं टबर बी निस्सै मुंह नेल़ एछी!<note caller="-" style="x"><char style="xo" closed="false">38:11 </char><char style="xt" closed="false"><ref loc="PSA 31:11">भज. 31:11</ref>; <ref loc="LUK 23:49">लूक. 23:49</ref></char></note><verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />मेरै दुशमणै आसा मुंह मारना लै ज़ज़ाल़ डाहै दै छ़ैई,</para>
  <para style="q" vid="PSA 38:12">ज़ुंण मेरी हान्‍नी करी मुंह बरैबाद करनअ च़ाहा,</para>
  <para style="q" vid="PSA 38:12">तिंयां हआ सारी-सारी धैल़ा मुल्है किज़ै नां किज़ै बिक्री सोठदै लागै दै।<verse eid="PSA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />तिन्‍नें धमकी लै रहा हुंह टौणैं ज़िहअ बणी अर</para>
  <para style="q" vid="PSA 38:13">तिन्‍नां सेटा पल़ा मुंह काल्‍लै ज़िहअ च़ुप्पी रहणअ।<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />हुंह हुअ टौणैं मणछा ज़िहअ ज़ुंण किछ़ै ज़बाब निं दैंदै,</para>
  <para style="q" vid="PSA 38:14">किल्हैकि तिंयां निं शूणीं सकदै।<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />पर हे मालक, हुंह आसा तेरै आसरै,</para>
  <para style="q" vid="PSA 38:15">हे मेरै परमेशर बिधाता, तिन्‍नां लै ज़बाब दैऐ तूह आप्पै।<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />मंऐं किई ती ताह सेटा एचल़ी अरज़,</para>
  <para style="q" vid="PSA 38:16">“मेरै दुशमणा निं मुल्है हास्सणैं दैई,</para>
  <para style="q" vid="PSA 38:16">नां तिन्‍नां ऐहा गल्‍लो घमंड करनैओ मोक्‍कअ दैई कि मुंह लागी ठोहल़।”<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />किल्हैकि ऐबै आसा मुंह धाक्‍कअ बुल़्हणै आल़अ,</para>
  <para style="q" vid="PSA 38:17">मुंह आसा कबल्‍ली दाह करै झोशा लागी दी।<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />हुंह मना ऐहा गल्‍ला कि मंऐं किऐ पाप,</para>
  <para style="q" vid="PSA 38:18">अर एतो पछ़ताअ बी आसा मुंह।<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />मेरै दुशमण आसा खास्सै अर ज़ोरा आल़ै,</para>
  <para style="q" vid="PSA 38:19">मुंह संघै एही बाझ़ी ज़ीद डाहणैं आल़ै आसा खास्सै।<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />हुंह करा तिन्‍नां लै भलअ अर तेते बदल़ै भेटा मुंह तिन्‍नां का बूरअ,</para>
  <para style="q" vid="PSA 38:20">तिंयां आसा ऐहा गल्‍ला पिछ़ू मेरै बरोधी कि हुंह च़ाहा भलअ करनअ।<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />हे बिधाता, मुंह निं शोटी डाही,</para>
  <para style="q" vid="PSA 38:21">हे मेरै मालक, तूह निं मुखा दूर डेऊई।<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />हे मालक, सह आसा तूह ई ज़ुंण मुंह बच़ाऊआ।</para>
  <para style="q" vid="PSA 38:22">ज़ीबाण, तूह कर मेरी छ़ेक्‍कै मज़त।<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">पाप माफी लै अरज़</para>
  <para style="d">जदूतून, गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />हुंह लागा आप्पू इहअ सोठदअ, “मुंह डाहणअ आपणअ खैल कि हुंह किज़ै करा,</para>
  <para style="q" vid="PSA 39:1">मुंह निं आपणीं ज़िभा पाप करनै दैणअ।”</para>
  <para style="q" vid="PSA 39:1">ज़ै कदुष्ट मणछ बी मेरै मुंहां सम्हनै होए,</para>
  <para style="q" vid="PSA 39:1">मुंह निं तिन्‍नां लै बी किछ़ बोल़णअ।<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />हुंह रहअ च़ुप्पी मंऐं निं एक बैण बी बोलअ,</para>
  <para style="q" vid="PSA 39:2">मंऐं निं भलाईए गल्‍ल बी बोली!</para>
  <para style="q" vid="PSA 39:2">पर मुंह पल़ी होर बी खास्सी दाह ज़िरनी,<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />मेरै दिलै हआ ती भितरी आग लागी दी।</para>
  <para style="q" vid="PSA 39:3">सोठी-सोठी हआ तै मेरै होर बी बूरै हाल,</para>
  <para style="q" vid="PSA 39:3">तेखअ निं मेरै इहअ बोल़णैं बाझ़ी रहूअ,<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“हे बिधाता, ज़ीबाण, तूह डाह मुखा खोज़ी कि हुंह कधू तैणीं ज़िऊंणअ?</para>
  <para style="q" vid="PSA 39:4">ऐबै मेरी आजू केतरी अमर रही?</para>
  <para style="q" vid="PSA 39:4">मेरी मौत केभै हणीं?”<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />तंऐं भाल़ मुल्है केही धख ज़ेही अमर आसा दैनी दी!</para>
  <para style="q" vid="PSA 39:5">ज़ुंण ज़िन्दगी हुंह ज़िऊआ, सह आसा ताल्है धख ज़ेही।</para>
  <para style="q" vid="PSA 39:5">मणछे ज़िन्दगी आसा बागरीए एकी झ़लारै ज़ेही अर<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />उडदी छ़ैल्‍ली ज़ेही।</para>
  <para style="q" vid="PSA 39:6">हाम्हैं हआ बृथा मैन्थ करदै लागै दै,</para>
  <para style="q" vid="PSA 39:6">हाम्हैं डाहा ज़ैदात कठा करी,</para>
  <para style="q" vid="PSA 39:6">पर इहअ थोघ निं हंदअ कि आजू अह कहा भेटणीं!<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />हे मेरै मालक, तै हुंह किज़ै न्हैल़ूं?</para>
  <para style="q" vid="PSA 39:7">आशा डाहा हुंह तेरी।<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />तूह बच़ाऊ मुंह मेरै सोभी पापा का,</para>
  <para style="q" vid="PSA 39:8">ऐडै मणछा निं मेरअ सुहांग दैई करनै।<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />हुंह रहूं काल्‍लै ज़िहअ च़ुप्पी, हुंह निं एक बैण बी बोल्दअ,</para>
  <para style="q" vid="PSA 39:9">तंऐं ई डाहअ हुंह एही दाह ज़िरदअ लाई।<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />ऐबै कर तूह मुखा ऐहा आफ़ता दूर,</para>
  <para style="q" vid="PSA 39:10">तेरै हाथे मारा करै च़ाल्‍लअ मेरअ शाह निखल़ी।<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />तूह नैरा हाम्हां म्हारै पापा लै सज़ा दैई,</para>
  <para style="q" vid="PSA 39:11">ज़ेता लै हाम्हैं मणछ झ़ूरा, तेता करा तूह सूल़ी ज़िहअ सुलै-सुलै खतम।</para>
  <para style="q" vid="PSA 39:11">हाम्हैं आसा ई बागरीए एकी झ़लारै ज़िहै।<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />हे बिधाता, मेरी लेर-पकार शुण,</para>
  <para style="q" vid="PSA 39:12">हुंह पाआ ताह सेटा पकार,</para>
  <para style="q" vid="PSA 39:12">मेरी लेरा शूणीं कर मेरी मज़त।</para>
  <para style="q" vid="PSA 39:12">हुंह आसा तेरै घअरै परदेसी मसाफर,</para>
  <para style="q" vid="PSA 39:12">ज़िहै मुखा एकी ज़मानै मेरै दाद-बाब थिऐ।<note caller="-" style="x"><char style="xo" closed="false">39:12 </char><char style="xt" closed="false"><ref loc="HEB 11:13">इब्रा. 11:13</ref></char></note><verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />मेरै मरनै का आजी दै मुंह कल्ही रहणैं,</para>
  <para style="q" vid="PSA 39:13">तै झ़ाणीं मुंह धख खुशी भेटे!<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">मज़त करना लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />हुंह डाहा सबर, संघा रहा ताह बिधाता न्हैल़अ लागी,</para>
  <para style="q" vid="PSA 40:1">तूह हेरा मेरी लेर-पकार शूणीं।<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />तंऐं काढअ हुंह डुघी खाल़्ही अर</para>
  <para style="q" vid="PSA 40:2">बरैबाद करनै आल़ी च़िक्‍करै जैंदरा का उझै,</para>
  <para style="q" vid="PSA 40:2">तंऐं किअ हुंह सरली ज़ैगा खल़अ</para>
  <para style="q" vid="PSA 40:2">संघा डाहअ हुंह राज्ज़ी-राम्बल़अ।<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />तंऐं दैनी मुल्है एक नऊंईं गिह,</para>
  <para style="q" vid="PSA 40:3">ज़ेता बोली हुंह तेरी ज़ै-ज़ैकार करी सके।</para>
  <para style="q" vid="PSA 40:3">एता भाल़ी करनअ खास्सै मणछा तेरअ अदर,</para>
  <para style="q" vid="PSA 40:3">संघा डाहणअ तिन्‍नां बी ताह बिधाता दी आपणअ भरोस्सअ।<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />तूह दैआ तिन्‍नां लै बर्गत, ज़ुंण ताह दी भरोस्सअ डाहा,</para>
  <para style="q" vid="PSA 40:4">ज़ुंण मुहुर्ती निं पूज़दै अर</para>
  <para style="q" vid="PSA 40:4">ज़ुंण घमंड निं करदै।<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />हे बिधाता, तंऐं किऐ हाम्हां लै बतेर्है नुआहरै काम,</para>
  <para style="q" vid="PSA 40:5">ताह ज़िहअ निं होर कोहै आथी!</para>
  <para style="q" vid="PSA 40:5">ज़ुंण गल्‍ला तंऐं हाम्हां लै सोठी, तेता थकणैं गणी-गणी!</para>
  <para style="q" vid="PSA 40:5">ज़ेतरी बी गल्‍ला तंऐं हाम्हां लै किई,</para>
  <para style="q" vid="PSA 40:5">तेता निं हुंह खोज़ी-खोज़ी मुक्‍कदअ।<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />तूह निं बल़ीदान अर भैंट च़ाहंदअ,</para>
  <para style="q" vid="PSA 40:6">तूह निं हाम्हां लै बोल्दअ कि बेदी दी करा पशूए हूम बल़ी।</para>
  <para style="q" vid="PSA 40:6">नां तंऐं पाप माफी लै पाप बल़ी मांगी।</para>
  <para style="q" vid="PSA 40:6">पर तूह च़ाहा इहअ कि हाम्हैं तेरी शुणें अर तिहअ ई करे।<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />तेता लै दैनअ मंऐं इहअ ज़बाब, “हे परमेशर,</para>
  <para style="q" vid="PSA 40:7">हुंह आसा इधी भाल़, किल्हैकि</para>
  <para style="q" vid="PSA 40:7">तेरी बधाने जंतरी दी आसा मेरै बारै लिखअ द।<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />मेरी खुशी आसा सह ई कि मुंह करनअ तिहअ ई ज़िहअ तूह च़ाहा,</para>
  <para style="q" vid="PSA 40:8">मंऐं आसा तेरअ बधान आपणैं दिलै डाहअ द।”<verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />हे बिधाता, ज़ेभै तेरै लोगो झाल़अ हुअ,</para>
  <para style="q" vid="PSA 40:9">तेभै खोज़अ मंऐं खुशीओ समाद कि तंऐं बच़ाऊऐ<note caller="+" style="f"><char style="fr" closed="false">40:9 </char><char style="fq" closed="false">बच़ाऊऐ </char><char style="ft" closed="false">धर्मीं बणाऐं</char></note> हाम्हैं।</para>
  <para style="q" vid="PSA 40:9">ताखा आसा आप्पै थोघ कि मेरै निं एता खोज़णैं बाझ़ी रहूंदअ।<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />तेरी उद्धार करने खबर निं मंऐं च़ोरी डाही,</para>
  <para style="q" vid="PSA 40:10">हुंह रहअ कबल्‍लअ तेरै सत्त अर उद्धारे बारै खोज़दअ लागी।</para>
  <para style="q" vid="PSA 40:10">ज़ेभै तेरै लोगो बडअ झाल़अ हुअ, तेभै बी निं हुंह च़ुप्पी रहअ,</para>
  <para style="q" vid="PSA 40:10">हुंह रहअ खोज़दअ लागी कि तूह किहअ शुचअ-पाक्‍कअ आसा अर तंऐं किई म्हारी मज़त।<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />हे बिधाता, तूह निं मुल्है झींण करनी छ़ाडी,</para>
  <para style="q" vid="PSA 40:11">तेरी अटल़ झ़ूरी अर सत्ता करै लोल़ी हुंह राज्ज़ी-राम्बल़अ रहअ।<verse eid="PSA 40:11" /></para>
  <para style="s">मज़त मांगणा लै अरज़</para>
  <para style="r">(<ref loc="PSA 70">भज़न 70</ref>)</para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />मुल्है आसा फेरा-फेर आफ़त पल़ी दी,</para>
  <para style="q" vid="PSA 40:12">तिंयां केतरी लाई गणी!</para>
  <para style="q" vid="PSA 40:12">मेरै पापै गोटअ हुंह च़ऊ बाखा,</para>
  <para style="q" vid="PSA 40:12">ऐबै निस्सी मुखा किछ़ै बात शुझुई,</para>
  <para style="q" vid="PSA 40:12">तिंयां आसा मेरै मुंडे शराल़ा का बी खास्सै अर</para>
  <para style="q" vid="PSA 40:12">ऐबै गअ मेरअ हैअ चुटी।<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />हे बिधाता, मुंह बच़ाऊ! तूह कर ऐबै मेरी मज़त।<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />ज़ुंण मुंह मारने ताका आसा,</para>
  <para style="q" vid="PSA 40:14">तिंयां लोल़ी तै हारै अर आप्पू मांझ़ै झाखुऐ।</para>
  <para style="q" vid="PSA 40:14">ज़ुंण मुल्है आफ़त पल़णां लै खुश हआ,</para>
  <para style="q" vid="PSA 40:14">तिंयां लोल़ी तै पिछ़ू हटै अर शर्मिंदै हुऐ।<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />ज़ुंण मेरै सुहांगा हआ लागै दै,</para>
  <para style="q" vid="PSA 40:15">तिंयां लोल़ी तै आपणीं हार भाल़ी धिठै फिरै।<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />पर हे बिधाता, ज़ुंण ताह सेटा एछा,</para>
  <para style="q" vid="PSA 40:16">तिन्‍नां लोल़ी ती मुंह खास्सी खुशी भेटी।</para>
  <para style="q" vid="PSA 40:16">ज़ुंण तेरै उद्धार करना लै शूकर करा,</para>
  <para style="q" vid="PSA 40:16">तिन्‍नैं लोल़ी ती कबल्‍ली एही गल्‍ला बोली,</para>
  <para style="q" vid="PSA 40:16">“बिधाता भाल़ किहअ महान आसा।”<verse eid="PSA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />हे मेरै मालक, हुंह आसा गरीब अर बाख दुबल़अ,</para>
  <para style="q" vid="PSA 40:17">पर तंऐं निं हुंह बिस्सरअ आथी।</para>
  <para style="q" vid="PSA 40:17">मुंह बच़ाऊंणै आल़अ अर मेरी मज़त करनै आल़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 40:17">हे मेरै परमेशर बिधाता, ऐबै निं बल़ैग पाई।<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">दाहे बगती बिधाता का अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />तिन्‍नां मणछा लै आसा खास्सी बर्गत ज़ुंण रैनै-गरीबो खैल डाहा,</para>
  <para style="q" vid="PSA 41:1">खरीए पलका करा तिन्‍नें हेर-सभाल़ बिधाता आप्पै।<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />बिधाता करनी तिन्‍नें फाज़त, संघा डाहणैं तिंयां ज़िऊंदै,</para>
  <para style="q" vid="PSA 41:2">तेऊ दैणीं तिन्‍नां लै धरती दी बर्गत,</para>
  <para style="q" vid="PSA 41:2">सह निं तिन्‍नें दुशमणा मांझ़ै तिन्‍नां शोटी डाहंदअ।<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />ज़ेभै तिंयां दाहुऐ दै होए,</para>
  <para style="q" vid="PSA 41:3">बिधाता करनै तिंयां पठी नरोगै।<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />मंऐं किई अरज़, “हे बिधाता, मंऐं किऐ ताल्है पाप,</para>
  <para style="q" vid="PSA 41:4">मुल्है कर झींण अर मुंह दै ताज़ै-नरोगै करी।<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />मेरै दुशमण बोला मुल्है इहअ,</para>
  <para style="q" vid="PSA 41:5">अह जाणअ खारकअ मरी अर एऊ जाणैं छ़ेक्‍कै बिस्सरी।”<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />ज़ेभै तिंयां मुंह झेठू एछा, तिंयां करा एही ई बृथा गल्‍ला,</para>
  <para style="q" vid="PSA 41:6">तिंयां झाल़ा मेरै बारै बूरी खबर,</para>
  <para style="q" vid="PSA 41:6">संघा पाआ तेते बारै सारै दी फुआह।<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />मेरै सोभ बैरी करा एक-दुजै का मेरै बारै घैंचल़,</para>
  <para style="q" vid="PSA 41:7">तिन्‍नां हआ मेरी हान्‍नी ई करने सोठ पल़ी दी।<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />तिंयां कदुष्ट बोला इहअ, “एऊ लागी घणीं नबिज़री दाह,</para>
  <para style="q" vid="PSA 41:8">अह निं ऐबै कधि च़ैनां का खल़अ उझ़ुई सकदअ!”<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />मेरअ आपणअ साथी ज़हा प्रैंदै मुंह खास्सअ भरोस्सअ थिअ,</para>
  <para style="q" vid="PSA 41:9">ज़ुंण मेरी रोटी खाआ त,</para>
  <para style="q" vid="PSA 41:9">सह ई हुअ ऐबै मेरअ दुशमण!<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 शमू. 15:12</ref>; <ref loc="JHN 13:18">जोह. 13:18</ref>; <ref loc="ACT 1:16">शधा. 1:16</ref></char></note><verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />पर हे बिधाता, तूह कर मुल्है ऐबै झींण संघा दै मुंह ताज़ै-नरोगै करी,</para>
  <para style="q" vid="PSA 41:10">ताकि हुंह तिन्‍नां लै इना सोभी गल्‍ला बापस दैंऊं भरी।<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />मेरै दुशमण निं लोल़ी मुखा ज़ितै,</para>
  <para style="q" vid="PSA 41:11">एता का जाआ मुखा थोघ लागी कि तूह आसा मुखा खुश।<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />तंऐं डाहअ हुंह ज़िऊंदअ बच़ाऊई किल्हैकि हुंह आसा नर्दोश,</para>
  <para style="q" vid="PSA 41:12">ताह डाहणअ हुंह सदा-सदा लै आप्पू संघै।<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />तूह बिधाता आसा इज़राईलो परमेशर,</para>
  <para style="q" vid="PSA 41:13">तेरी रहणीं जुगै-जुगै तैणीं ज़ै-ज़ैकार हंदी लागी। एवमस्तू, एवमस्तू।<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">दुजअ भाग</para>
  <para style="mr">(<ref loc="PSA 42:1-72:20">भज़न 42:1—72:20</ref>)</para>
  <para style="s">बिधाता भाल़णें च़ाह</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै कोराह खिंबा आल़ैओ खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />हे बिधाता, ज़ेही हरनी गाडे पाणीं झुटणा लै फहुंकिआ,</para>
  <para style="q" vid="PSA 42:1">तिहअ फहुंकिआ हुंह ताल्है।<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />हे परमेशर, मुंह आसा ताह ज़िऊंदै परमेशरे एही चिश कि</para>
  <para style="q" vid="PSA 42:2">ताह सेटा हुंह केभै पुजूं!<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />हे परमेशर, राच-धैल़ लेरी-लेरी आसा आशू ई मेरी बैल़ी-क्लारी,</para>
  <para style="q" vid="PSA 42:3">सोभै हआ मुंह इहअ पुछ़दै लागै दै,</para>
  <para style="q" vid="PSA 42:3">“तेरअ परमेशर आसा किधी?”<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />पिछ़ली गल्‍ला आद करी चुटा मेरअ दिल कि</para>
  <para style="q" vid="PSA 42:4">हुंह खास्सै मणछे छ़ुंढा जैंदरी हुंह किहअ एछा त शूकर करदअ तेरै भबना लै,</para>
  <para style="q" vid="PSA 42:4">लोगे तिंयां परमेशरा लै गिहा अर</para>
  <para style="q" vid="PSA 42:4">ज़ै-ज़ैकारे बोल लागा मुखा एभै बी कानै शुण्हदै।<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />इहअ किल्है चुटअ मेरअ हैअ?</para>
  <para style="q" vid="PSA 42:5">मुंह किल्है निस्सअ उझ़ुई नां बेशी राम हई?</para>
  <para style="q" vid="PSA 42:5">मुंह डाहणअ परमेशरा दी भरोस्सअ,</para>
  <para style="q" vid="PSA 42:5">मुंह लणअ त एकी बारी भिई परमेशरा सेटा डेऊई</para>
  <para style="q" vid="PSA 42:5">मेरै उद्धार करनै आल़ै परमेशरो शूकर करी।<note caller="-" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="MAT 26:38">मोत्त. 26:38</ref>; <ref loc="MRK 14:34">मार्क. 14:34</ref>; <ref loc="JHN 12:27">जोह. 12:27</ref></char></note><verse eid="PSA 42:5" /></para>
  <para style="q">
    <verse number="6-7" style="v" sid="PSA 42:6-7" />हे परमेशर, मंऐं हेरअ पठी हैअ चोल़ी,</para>
  <para style="q" vid="PSA 42:6-7">हुंह लागा तेरै बारै सोठदअ,</para>
  <para style="q" vid="PSA 42:6-7">तंऐं पाई मेरै दिलै दुखे बडी-बडी छ़ाल्‍ली,</para>
  <para style="q" vid="PSA 42:6-7">मुल्है पल़अ आई दी गाडा ज़िहअ झाख,</para>
  <para style="q" vid="PSA 42:6-7">सह ज़ाण्हिंआं हर्मोन अर मिसगार धारा का लागै दै</para>
  <para style="q" vid="PSA 42:6-7">जरदण नदीए छ़ोआ ज़िहअ क्रुंगा लांदअ।<verse eid="PSA 42:6-7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />पर हर धैल़ै दैआ बिधाता मुल्है आपणीं अटल़ झ़ूरी तरैल़ी करै,</para>
  <para style="q" vid="PSA 42:8">राची-राची बोला हुंह कबल्‍ली तेऊए गिहा,</para>
  <para style="q" vid="PSA 42:8">हुंह रहा तेऊ परमेशरा का अरज़ करदअ लागी ज़ुंणी मुल्है ज़िन्दगी दैनी।<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />ज़ुंण परमेशर मुंह बच़ाऊआ,</para>
  <para style="q" vid="PSA 42:9">तेऊ का बोल़णअ मुंह इहअ,</para>
  <para style="q" vid="PSA 42:9">“तंऐं किल्है पाअ हुंह बिस्सरी?</para>
  <para style="q" vid="PSA 42:9">मुंह किल्है पल़ा मेरै दुशमणा का ईंयां दुख ज़िरनै?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />तिन्‍नें तान्हैं लाई मेरै हाडकै-हाडकै एही दाह कि तिंयां बिन्हैं बर्छ़ै करै!</para>
  <para style="q" vid="PSA 42:10">तिंयां करा मेरअ इहअ बोली सुहांग,</para>
  <para style="q" vid="PSA 42:10">“अह तेरअ परमेशर आसा किधी?”<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />इहअ किल्है चुटअ मेरअ हैअ?</para>
  <para style="q" vid="PSA 42:11">मुंह किल्है निस्सअ उझ़ुई नां बेशी राम हई?</para>
  <para style="q" vid="PSA 42:11">मुंह डाहणअ परमेशरा दी भरोस्सअ,</para>
  <para style="q" vid="PSA 42:11">मुंह लणअ त एकी बारी भिई परमेशरा सेटा डेऊई</para>
  <para style="q" vid="PSA 42:11">आपणैं उद्धार करनै आल़ै परमेशरो शूकर करी।<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">खरीए पलका अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />हे परमेशर, मेरअ नसाफ कर,</para>
  <para style="q" vid="PSA 43:1">तूह लल़ मेरअ दाऊअ इना पापी संघै आप्पी,</para>
  <para style="q" vid="PSA 43:1">इना कदुष्ट अर कपटी मणछा का बच़ाऊ मुंह।<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />मेरी फाज़त करनै आल़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 43:2">तंऐं किल्है डाहअ हुंह शोटी?</para>
  <para style="q" vid="PSA 43:2">इनै दुशमणै आणअ हुंह हंती,</para>
  <para style="q" vid="PSA 43:2">अह दाह किल्है लागा मुंह ज़िरनी?<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />तूह छ़ाड मुल्है आपणअ सत्त अर प्रैश्शअ,</para>
  <para style="q" vid="PSA 43:3">ताकि तेते ज़ोरै हुंह तेरै</para>
  <para style="q" vid="PSA 43:3">पबित्र पर्बत सियोन अर</para>
  <para style="q" vid="PSA 43:3">तेरै भबनै पुजी सकूं ज़िधी तूह रहा।<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />हे बिधाता, तिधी डेऊणअ मुंह तेरी बेदी सेटा,</para>
  <para style="q" vid="PSA 43:4">किल्हैकि मेरी खुशीओ मूल़ आसा तूह ई।</para>
  <para style="q" vid="PSA 43:4">हे मेरै परमेशर, हे बिधाता,</para>
  <para style="q" vid="PSA 43:4">मुंह करनअ बींन बाज़ी करै तेरअ शूकर।<verse eid="PSA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />इहअ किल्है चुटअ मेरअ हैअ?</para>
  <para style="q" vid="PSA 43:5">मुंह किल्है निस्सअ उझ़ुई नां बेशी राम हई?</para>
  <para style="q" vid="PSA 43:5">मुंह डाहणअ परमेशरा दी भरोस्सअ,</para>
  <para style="q" vid="PSA 43:5">मुंह लणअ त एकी बारी भिई परमेशरा सेटा डेऊई</para>
  <para style="q" vid="PSA 43:5">आपणैं उद्धार करनै आल़ै परमेशरो शूकर करी।<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">मज़त करना लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै कोराह खिंबा आल़ैओ खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />हे परमेशर, हाम्हैं आसा आपणैं कानै शूणअ द,</para>
  <para style="q" vid="PSA 44:1">म्हारै दाद-बाब खोज़ा एते बारै इहअ कि</para>
  <para style="q" vid="PSA 44:1">तिन्‍नें ज़मानैं अर पैहलकै जुगै</para>
  <para style="q" vid="PSA 44:1">तंऐं किहै-किहै महान काम आसा किऐ दै<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />तंऐं काढै तै बोला आपणैं हाथे ज़ोरै</para>
  <para style="q" vid="PSA 44:2">तेऊ देशा का कदुष्ट ज़ाती पोर्ही अर</para>
  <para style="q" vid="PSA 44:2">तिन्‍नें ज़ैगा बसाऊऐ तंऐं आपणैं लोग,</para>
  <para style="q" vid="PSA 44:2">तंऐं भाल़ देशा-देशे लोगा लै केही सज़ा दैनी ती</para>
  <para style="q" vid="PSA 44:2">अर आपणैं खास लोगा दैनअ तंऐं फेरा-फेर बस्सणै।<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />तेरै लोगै निं सह ज़ैगा आपणैं तलबारे ज़ोरै गिम्मी,</para>
  <para style="q" vid="PSA 44:3">नां तिन्‍नें सह आपणैं ज़ोरै जुध करी ज़िती,</para>
  <para style="q" vid="PSA 44:3">तेता लै थिअ तेरअ ज़ोर अर तेरी बाहो बल,</para>
  <para style="q" vid="PSA 44:3">तूह त आप्पू तिन्‍नां संघै अर</para>
  <para style="q" vid="PSA 44:3">एता का लागा थोघ कि तूह झ़ूरा तिन्‍नां लै खास्सअ।<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />हे परमेशर, तूह ई आसा म्हारअ माहा राज़अ,</para>
  <para style="q" vid="PSA 44:4">तूह दैआ आपणीं परज़ा याकबे आद-लुआदा लै ज़ीत,<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />तेरै महान ज़ोरे आसरै बदल़ा हाम्हैं आपणैं दुशमणा धरनीं</para>
  <para style="q" vid="PSA 44:5">अर तेरै प्रतप्पा करै जाआ हाम्हैं तिन्‍नां का ज़िती।<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />हुंह निं आपणैं कबाण अर</para>
  <para style="q" vid="PSA 44:6">आपणीं तलबारे ज़ोरै बच़णे आसरै रहंदअ,<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />पर तंऐं हेरै हाम्हैं म्हारै दुशमणा का बच़ाऊई,</para>
  <para style="q" vid="PSA 44:7">तंऐं किऐ म्हारै बैरी धिठै अर शर्मिंदै।<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />हे परमेशर, हाम्हां करनी कबल्‍ली तेरी बड़ैई अर</para>
  <para style="q" vid="PSA 44:8">हाम्हां रहणअ सदा तेरै शूकर करदै लागी।<verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />पर ऐबै डाहै तंऐं हाम्हैं शोटी अर तंऐं दैनअ हाम्हां हारनै!</para>
  <para style="q" vid="PSA 44:9">ऐबै निं तूह म्हारै दला आजू हांढदअ।<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />हाम्हां पल़ा ऐबै म्हारै दुशमणा सेटा का पोर्ही ठुहर्नअ,</para>
  <para style="q" vid="PSA 44:10">तिंयां लुटा हाम्हां ज़िहअ तिन्‍नों दिल बोला तिहअ!<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />तूह दैआ हाम्हां हेल़्ही मांझ़ा का चैणैं ज़िहै काठणैं,</para>
  <para style="q" vid="PSA 44:11">तंऐं छिंगै हाम्हैं धरती दी देशै-देशै।<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />तंऐं पाऐ आपणैं लोग सस्तै दी बेच़ी,</para>
  <para style="q" vid="PSA 44:12">ज़िहअ कि तिन्‍नें निं किछ़ै किम्मत आथी!<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />हाम्हां ओर्ही-पोर्ही बस्सै दै लोग लागा एता भाल़ी</para>
  <para style="q" vid="PSA 44:13">हास्सदै अर सुहांगा करदै कि तंऐं हाम्हां संघै किज़ै किअ!<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />देशा-देशे<note caller="+" style="f"><char style="fr" closed="false">44:14 </char><char style="fq" closed="false">देशा-देशे </char><char style="ft" closed="false">पराई ज़ातीए</char></note> लोग करा म्हारअ सुहांग अर</para>
  <para style="q" vid="PSA 44:14">तिंयां करा म्हारी बेइज़ती करना लै हाथा करै शारअ।<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />हाम्हां पल़ा धैल़ शर्मिंदै हणअ,</para>
  <para style="q" vid="PSA 44:15">बेइज़ती गोटै हाम्हैं फेरा-फेर,<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />होर लागा हाम्हां लै हास्सदै अर तान्हैं दैंदै,</para>
  <para style="q" vid="PSA 44:16">ज़ांऊं तिंयां भाल़ा कि म्हारै दुशमणै लअ हाम्हां का बदल़अ।<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />हाम्हां संघै एतरअ हई बी निं</para>
  <para style="q" vid="PSA 44:17">हाम्हां ताह बिस्सरुऐ अर</para>
  <para style="q" vid="PSA 44:17">नां हाम्हैं सह करार चोल़ी ज़ुंण तंऐं हाम्हां संघै किई ती।<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />हाम्हैं डाहअ तूह सदा आपणैं मन्‍नैं,</para>
  <para style="q" vid="PSA 44:18">नां हाम्हैं तेरी खोज़ी दी बाता का ओर्ही-पोर्ही डेऊऐ।<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />तज़ी बी डाहै तंऐं हाम्हैं बणैं शैल़ठै जैंदरी पाई,</para>
  <para style="q" vid="PSA 44:19">तंऐं डाहै हाम्हैं नटिप्प न्हैरै दी शोटी।<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />ज़ै हाम्हैं ताह परमेशरा छ़ाडी होरी</para>
  <para style="q" vid="PSA 44:20">देअआ-देबीए पूज़ा बी किई हंदी,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />हे परमेशर, ताखा जाणअ त तेतो बी थोघ लागी,</para>
  <para style="q" vid="PSA 44:21">किल्हैकि ताखा हआ म्हारै दिले गुप्त गल्‍लो बी थोघ।<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />ताह पिछ़ू पाआ लोग हाम्हां कबल्‍लै मारी,</para>
  <para style="q" vid="PSA 44:22">हाम्हां संघै हआ तिन्‍नां भेडा ज़िहअ बर्ताअ ज़ुंण काटणा लै हेल़्ही का ज़ुदी हआ डाही दी।<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">रोम. 8:36</ref></char></note><verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />हे मेरै मालक, उझ़ू! तूह किल्है आसा सुत्ती रहअ द?</para>
  <para style="q" vid="PSA 44:23">ऐबै उझ़ू, हाम्हां निं सदा लै शोटी डाही।<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />तूह किल्है डाहा हाम्हां बाखा लै पिठ फरेऊई?</para>
  <para style="q" vid="PSA 44:24">एता निं बिस्सरी पाई कि हाम्हैं किहै दुख अर आफ़त आसा पल़ी दी!<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />हाम्हैं पल़ै धरनीं अर</para>
  <para style="q" vid="PSA 44:25">हाम्हैं आसा माट्टै जैंदरी लाम्मै पल़ै दै।<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />हे बिधाता, म्हारी मज़त कर,</para>
  <para style="q" vid="PSA 44:26">आझ़ रहैऊ ऐहा गल्‍ला कि तूह हाम्हां लै किहअ खास्सअ झ़ूरा।<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">बैहे गिह</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै, शोशन्‍नीम ज़ैगा कोराह खिंबा आल़ेए खास बैहे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />ज़ांऊं हुंह राज़े बारै गिह सोठा,</para>
  <para style="q" vid="PSA 45:1">मेरअ दिल हआ बडी बित्ती-बित्ती गल्‍ला करै भरी।</para>
  <para style="q" vid="PSA 45:1">मेरी ज़िभ हआ सज़ाण काईथे कलमा ज़ेही</para>
  <para style="q" vid="PSA 45:1">गिहा बोल़णा लै तैर।<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />ताह ज़िहअ हेरनअ बित्तअ निं मणछा मांझ़ै कोहै आथी,</para>
  <para style="q" vid="PSA 45:2">तेरै होठा का निखल़ा मिठै बोल।</para>
  <para style="q" vid="PSA 45:2">तैही दैआ परमेशर ताल्है सदा बर्गत।<note caller="-" style="x"><char style="xo" closed="false">45:2 </char><char style="xt" closed="false"><ref loc="LUK 4:22">लूक. 4:22</ref>; <ref loc="HEB 1:3-4">इब्रा. 1:3-4</ref></char></note><verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />ए शूरबीरा! तूह च़क आपणीं तलबार,</para>
  <para style="q" vid="PSA 45:3">तूह आसा महान अर प्रतप्पी राज़अ।<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />तूह हअ आपणैं प्रतप्पे ज़िता दी शुंआर,</para>
  <para style="q" vid="PSA 45:4">संघा कर सत्त अर नसाफे फाज़त!</para>
  <para style="q" vid="PSA 45:4">तेरै बाहे बला करै जाणीं ताह महान ज़ीत भेटी।<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />तेरै कतीर आसा तिछै,</para>
  <para style="q" vid="PSA 45:5">तिंयां करा तेरै दुशमणे दिल छिझै,</para>
  <para style="q" vid="PSA 45:5">देशा-देशे लोग पल़णै तेरै च़रणैं।<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />परमेशरै ज़ुंण राज़ ताल्है दैनअ,</para>
  <para style="q" vid="PSA 45:6">सह रहणअ जुगै-जुगै तैणीं सदा लै।</para>
  <para style="q" vid="PSA 45:6">तूह करा आपणैं लोगा प्रैंदै नसाफ डाही राज़,<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />तूह झ़ूरा भलै लै अर कदुष्ट कामां का आसा ताह नफरत।</para>
  <para style="q" vid="PSA 45:7">तैही आसा तूह बिधाता, तेरै परमेशरै आप्पै छ़ांटअ द,</para>
  <para style="q" vid="PSA 45:7">तेऊ किअ तेरअ होरी सोभी साथी का खास्सअ अदर</para>
  <para style="q" vid="PSA 45:7">अर खुशीओ खास्सअ तेल तरैल़ी अभिषेक।<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />तेरै च़ोल़ै दी आसा गंधरस, अगर अर तेजे बित्ती बास्स।</para>
  <para style="q" vid="PSA 45:8">हाथी दांदा करै सज़ाऊऐ दै मैहलै लागा ताह तारा आल़ै बाज़ै शुणने मौज़।<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />मशूर बेटल़ी संघै आसा तेरै मैहलै राज़े देई बी,</para>
  <para style="q" vid="PSA 45:9">तेरी राज़गाद्दी दी दैहणीं बाखा आसा तेरी राणीं</para>
  <para style="q" vid="PSA 45:9">च़ोखै सुन्‍नें किम्मती हार-शंगार बान्हीं खल़ी।<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />ओ माहा राणीं, मेरी गल्‍ला शुण धैन दैई,</para>
  <para style="q" vid="PSA 45:10">आपणैं नातै रिश्तैदारा अर पेऊकै आद करदी निं लागी।<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />ऐबै आसा तूह राज़े राणीं,</para>
  <para style="q" vid="PSA 45:11">ऐबै कर तिहअ, ज़िहअ राज़अ च़ाहा।<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />सूर नगरीए सोभी सेठ मणछा आणनीं ताह सेटा लै भैंट,</para>
  <para style="q" vid="PSA 45:12">परज़ा मांझ़ै बी करनी सोभी लोगा ताह खुश करने कोशिश।<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />राज़े देई आसा मैहलै, सह भाल़ हेरनी केही बित्ती आसा!</para>
  <para style="q" vid="PSA 45:13">तेसो घाघरै दी आसा सुन्‍नें धागै करै बूणती पाई दी।<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />तेऊ बूणती आल़ै घाघरै बान्हीं आणी सह राज़ै सेटा,</para>
  <para style="q" vid="PSA 45:14">तेसे कुंआरी साथणीं आसा तैहा पिछ़ू-पिछ़ू हांढदी लागी दी।<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />तिंयां एछणी राज्ज़ी-खुशी</para>
  <para style="q" vid="PSA 45:15">संघा डेऊणीं तिंयां राज़े मैहला भितरी।<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />ताह मेरै राज़े हणीं खास्सी आद-लुआद,</para>
  <para style="q" vid="PSA 45:16">तिंयां बी हणैं तिहै ई राज़ै ज़िहै तेरै दाद-बाब थिऐ।</para>
  <para style="q" vid="PSA 45:16">ताह दैणअ तिन्‍नां लै धरती दी ज़ैगै-ज़ैगै राज़।<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />मुंह गांठणी तेरी एही गिह कि तूह हणअ सदा लै मशूर,</para>
  <para style="q" vid="PSA 45:17">देशा-देशे लोग रहणैं ताल्है जुगै-जुगै तैणीं शूकर करदै लागी।<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">म्हारी शरण लणें ज़ैगा आसा परमेशर</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै कोराह खिंबा आल़ैओ अलामोत रागा दी गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />म्हारअ बल अर शरण लणें ज़ैगा आसा परमेशर,</para>
  <para style="q" vid="PSA 46:1">खरीए पलका करा सह ई म्हारी मज़त सदा।<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />च़ाऐ धरती दी केही बी ज़ाज़री होए,</para>
  <para style="q" vid="PSA 46:2">बडै-बडै पर्बत ढूल़ी समुंदरै डुबे, तैबी बी निं हाम्हां किछ़ै डअर।<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />समुंदर च़ाऐ ज़िहअ बी क्रुंगे, तेता का ज़ेही बी शेफा निखल़े</para>
  <para style="q" vid="PSA 46:3">अर बडी-बडी धारा तेते छ़ाल्‍ली करै च़ुक्‍के।<verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />एक गाड आसा ज़ुंण म्हारै परमेशरे नगरी खुश दैआ करी,</para>
  <para style="q" vid="PSA 46:4">सह आसा परम प्रधान परमेशरो पबित्र बसेरअ।<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />परमेशर आसा तैहा नगरी<note caller="+" style="f"><char style="fr" closed="false">46:5 </char><char style="fq" closed="false">तैहा नगरी </char><char style="ft" closed="false">एरुशलेम नगरी ज़िधी बिधाते पूज़ा-गाज़ा करा</char></note> दी अर सह निं कधि बरैबाद हणीं,</para>
  <para style="q" vid="PSA 46:5">परमेशर जाआ राच भैणै का आजी तेसे मज़त करदअ एछी।<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />देशा-देशे लोग हुऐ रोश्शै लाल-पिंऊंल़ै, बडै-बडै राज़ हुऐ खतम,</para>
  <para style="q" vid="PSA 46:6">ज़ांऊं परमेशरै बैण बोलअ तेता करै हुई गुल़ूबिज़ल़ू ज़ेही छ़ेल़ अर धरती लागी गल़दी!<note caller="-" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="REV 11:18">प्रका. 11:18</ref>; <ref loc="PSA 2:1">भज. 2:1</ref></char></note><verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />स्वर्गे सारी सैनो मालक बिधाता आसा हाम्हां संघै।</para>
  <para style="q" vid="PSA 46:7">याकब ज़हा परमेशरा मना, सह आसा म्हारी शरण लणें ज़ैगा।<verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />एछा! संघा दैआ बिधाते महान कामां भाल़णीं,</para>
  <para style="q" vid="PSA 46:8">धरती दी भाल़ा तेऊ किहै-किहै नुआहरै काम किऐ।<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />सह करा सारै संसारै जुध खतम,</para>
  <para style="q" vid="PSA 46:9">सह पाआ कबाण चोल़ी अर बर्छ़े करा सह ठोर-ठोर अर</para>
  <para style="q" vid="PSA 46:9">बडै-बडै रथा पाआ सह आगी जैंदरी दहई।<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />सह बोला इहअ, “झ़गल़ै करा बंद, एता लआ समझ़ी हेरे कि हुंह आसा परमेशर,</para>
  <para style="q" vid="PSA 46:10">देशा-देशे लोगा प्रैंदै आसा हुंह ई सैणअ अर</para>
  <para style="q" vid="PSA 46:10">सारै संसारा प्रैंदै आसा हुंह ई मालक।”<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />स्वर्गे सारी सैनो मालक बिधाता आसा हाम्हां संघै।</para>
  <para style="q" vid="PSA 46:11">याकब ज़हा परमेशरा मना, सह आसा म्हारी शरण लणें ज़ैगा।<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">परमेशर आसा म्हारअ माहा राज़अ</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै कोराह खिंबा आल़ैओ भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />ए देशा-देशे लोगो, ताल़ी बाज़ा!</para>
  <para style="q" vid="PSA 47:1">ज़ोरै-ज़ोरै करा परमेशरे ज़ै-ज़ैकार।<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />सोभिओ मालक, परम प्रधान परमेशर बिधाता का लागा डरनअ ई,</para>
  <para style="q" vid="PSA 47:2">सह आसा महान राज़अ ज़ुंण सारै संसारै राज़ करा।<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />तेऊ दैनी सोभी लोगा का हाम्हां लै ज़ीत,</para>
  <para style="q" vid="PSA 47:3">तेऊ दैनअ हाम्हां लै देशा-देशा प्रैंदै राज़।<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />तेऊ छ़ांटी हाम्हां लै ज़ैगा ज़िधी हाम्हैं बस्सी सके,</para>
  <para style="q" vid="PSA 47:4">तेऊए आपणीं ज़ैदात आसा याकब ज़हा लै सह खास्सअ झ़ूरा।<verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />परमेशर डेओआ उझै आपणीं राज़गाद्दी दी बेशणा लै,</para>
  <para style="q" vid="PSA 47:5">ज़ांऊं बिधाता उझै हांढदअ लागा,</para>
  <para style="q" vid="PSA 47:5">तेभै हआ ज़ोरै-ज़ोरै ज़ै-ज़ैकार अर ज़ोरै-ज़ोरै शुण्हिंआं नर्शिंगै बाज़दै।<verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />परमेशरा लै बोला गिहा!</para>
  <para style="q" vid="PSA 47:6">माहा राज़ेए ज़ै-ज़ैकार करना लै बोला भज़न।<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />परमेशर आसा सारै संसारो राज़अ,</para>
  <para style="q" vid="PSA 47:7">तेऊए करा भज़न बोली ज़ै-ज़ैकार।<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />परमेशर बेशा आपणीं पबित्र राज़गाद्दी प्रैंदै अर</para>
  <para style="q" vid="PSA 47:8">सह करा देशा-देशे लोगा प्रैंदै राज़।<verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />देशा देशे मशूर लोगै किअ आबरामे आद-लुआदा संघै साझ़ू हणां लै झाल़अ</para>
  <para style="q" vid="PSA 47:9">ज़ुंण परमेशरे खास परज़ा आसा,</para>
  <para style="q" vid="PSA 47:9">परमेशर आसा संसारे सोभी राज़ै का ज़बर जोधअ,</para>
  <para style="q" vid="PSA 47:9">सह आसा सोभी प्रैंदै माहा राज़अ।<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">परमेशरे नगरी</para>
  <para style="d">कोराह खिंबा आल़ेए गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />बिधाता आसा महान, सह आसा तेऊए पबित्र पर्बत<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">पबित्र पर्बत </char><char style="ft" closed="false">सियोन धारा</char></note> अर</para>
  <para style="q" vid="PSA 48:1">तेऊए पबित्र नगरी<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">पबित्र नगरी </char><char style="ft" closed="false">एरुशलेम</char></note> दी खास्सी बड़ैई करनै जोगी।<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />परमेशरे उछ़टै सियोन पर्बते शोभा आसा बेघै खास्सी,</para>
  <para style="q" vid="PSA 48:2">माहा राज़ेए महान सियोन नगरी करै भेटा संसारै संसारा खुशी।<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />एरुशलेम नगरीए पिठी लै आसा परमेशर आप्पै,</para>
  <para style="q" vid="PSA 48:3">तेऊ रहैऊई अह गल्‍ल सोभी का कि सह करा तेसे फाज़त आप्पै।<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />सोभ राज़ै किअ आप्पू मांझ़ै एक्‍कअ,</para>
  <para style="q" vid="PSA 48:4">संघा आऐ सैना पाई तैहा नगरी संघै जुधा लै!<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />पर तिंयां हुऐ तैहा नगरी भाल़ी हक्‍कै-बक्‍कै,</para>
  <para style="q" vid="PSA 48:5">तिन्‍नां छ़ुटी डरै काम्मणीं संघा ठुर्है तिधा का पिछ़ू।<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />तिधी छ़ुटअ तिन्‍नां का दर्छ़णअ अर</para>
  <para style="q" vid="PSA 48:6">तिन्‍नां उझ़ुई एही झोशा ज़ेही बेटल़ी सूंणें दाह लागा,<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />ज़ेही पुर्बा बाखे ढिश-बागर तरशीश नगरीए</para>
  <para style="q" vid="PSA 48:7">समुंदरे ज़हाज़ा ढोल़ी पाआ, तिहै हुऐ तिंयां।<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />हाम्हैं ती गल्‍ला शूणीं दी कि स्वर्गे सारी सैने मालक बिधाता किज़ै किअ,</para>
  <para style="q" vid="PSA 48:8">पर ऐबै भाल़अ हाम्हैं आपणीं आछी कि</para>
  <para style="q" vid="PSA 48:8">एरुशलेम नगरी आसा परम प्रधान परमेशर आप्पै अर</para>
  <para style="q" vid="PSA 48:8">तेऊ डाहणीं अह नगरी सदा राज्ज़ी-राम्बल़ी।<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />हे परमेशर, तेरै भबना भितरी शुझिआ हाम्हां का</para>
  <para style="q" vid="PSA 48:9">हाम्हां लै तेरी अटल़ झ़ूरी।<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />हे परमेशर, हर ज़ैगा करा लोग तेरी बड़ैई,</para>
  <para style="q" vid="PSA 48:10">तूह हुअ सारी धरती दी मशूर।</para>
  <para style="q" vid="PSA 48:10">तेरअ राज़ आसा इहअ ज़ेथ नसाफ भेटा।<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />एरुशलेम नगरीए लोगा हणीं नंद अर</para>
  <para style="q" vid="PSA 48:11">यहूदा नगरीए लोगा हणीं खुशी,</para>
  <para style="q" vid="PSA 48:11">किल्हैकि तंऐं आणअ नसाफ।<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />परमेशरे लोगो, एरुशलेम नगरीए दुआली फेर दैआ फेरी,</para>
  <para style="q" vid="PSA 48:12">संघा गणा कि तेथ केतरै कोट आसा,<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />नगरी फेर उछ़टी दुआली अर मैहलै ज़ाच़ा राम्बल़ै करै</para>
  <para style="q" vid="PSA 48:13">ताकि तम्हैं आगली पोस्ती का एते बारै बाढै खोज़ी सके।<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />अह म्हारअ परमेशर आसा सदा-सदा लै,</para>
  <para style="q" vid="PSA 48:14">तेऊ हेरनी आजू बी म्हारी हेर-सभाल़ करी।<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">धन-माये आसरै निं रहणअ</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै कोराह खिंबा आल़ैओ भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />मेरी ऐहा गल्‍ला शूणां सोभै!</para>
  <para style="q" vid="PSA 49:1">संसारै सोभ लोग शूणां कि हुंह किज़ै बोला!<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />होछ़अ-बडअ, सेठ होए या रैनअ गरीब,</para>
  <para style="q" vid="PSA 49:2">सोभै मणछ शूणां कि हुंह किज़ै बोला।<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />मेरी ज़िभा निं किछ़ खोट आथी,</para>
  <para style="q" vid="PSA 49:3">हुंह दैआ अक्ल अर समझ़ाई।<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />हुंह दैआ सैणीं गल्‍ला दी धैन,</para>
  <para style="q" vid="PSA 49:4">संघा दैआ हुंह तेतो भेद बाढै खोज़ी ज़ेही बींन बाज़ा।<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />तैहा खरी निं मुंह डरने ज़रुरत आथी कि</para>
  <para style="q" vid="PSA 49:5">हुंह गोटअ तिन्‍नैं दुशमणै फेरा-फेर,<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />ज़हा आपणीं धन-माया दी भरोस्सअ आसा अर</para>
  <para style="q" vid="PSA 49:6">तिंयां करा आपणीं ज़ैदाता दी घमंड।<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />हाम्हां मांझ़ै निं कोहै मरनै का बच़ी सकदअ,</para>
  <para style="q" vid="PSA 49:7">नां हाम्हैं आपणीं ज़िन्दगीए बदल़ै परमेशरा लै ढब्बै दैई प्राश्त करी सकदै।<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />किल्हैकि मणछे ज़िन्दगीए किम्मत आसा बेघै खास्सी।</para>
  <para style="q" vid="PSA 49:8">हाम्हैं निं जुगै-जुगै बी तेते किम्मत दैई सकदै कि<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />हाम्हैं लोल़ी सदा ज़िऊंदै रहै,</para>
  <para style="q" vid="PSA 49:9">हाम्हां निं कधि लोल़ी मरनअ पल़अ!<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />हाम्हां का शुझिआ आछी कि अक्ली आल़ै मणछ बी मरा</para>
  <para style="q" vid="PSA 49:10">अर कबुधी अर ऐडै मणछ बी मरा तिहै ई!</para>
  <para style="q" vid="PSA 49:10">तिन्‍नें धन-माया छ़ुटा पिछ़ू होरी लै।<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />तिंयां ता सोठा तै इहअ कि तिन्‍नें घअर रहणैं सदा लै,</para>
  <para style="q" vid="PSA 49:11">अर तिंयां रहणैं पोस्ती दर पोस्ती बस्सी!</para>
  <para style="q" vid="PSA 49:11">तैही हआ तिन्‍नें आपणैं-आपणैं नाओंऐं ज़ैगा-ज़िम्मीं।<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />पर मणछ ज़ेतरअ बी मशूर किल्है निं होए, सह निं मरनै का बच़ी सकदअ,</para>
  <para style="q" vid="PSA 49:12">ज़िहै पशू मरा, हाम्हैं बी मरनै तिहै ई।<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />तिन्‍नां लै भाल़ै किहअ हणअ ज़हा आप्पू दी भरोस्सअ आसा,</para>
  <para style="q" vid="PSA 49:13">ज़ुंण आपणीं धन-माया लै झ़ूरा तिन्‍नें नसीबै किज़ै आसा,<verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />तिंयां आसा भेडे हेल़्ही ज़िहै छ़ेल़्ही लाऐ दै अर</para>
  <para style="q" vid="PSA 49:14">मौत हणीं तिन्‍नां फुआल लागी दी।</para>
  <para style="q" vid="PSA 49:14">धर्मीं मणछा करनअ तिन्‍नां प्रैंदै राज़,</para>
  <para style="q" vid="PSA 49:14">तिन्‍नें देही चिजणैं घोरी दी,</para>
  <para style="q" vid="PSA 49:14">तिन्‍नें घअरा का दूर।<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />पर परमेशरा हेरनअ हुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 49:15">तेऊ हेरनअ हुंह मौते ज़ोरा का छ़ड़ैऊई।<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />होरी सेठ हंदै भाल़ी निं आपणअ शाह चोल़णअ</para>
  <para style="q" vid="PSA 49:16">कि इने धन-माया भाल़ केही खास्सी हुई।<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />तिंयां जाणैं तेतरी मरी अर</para>
  <para style="q" vid="PSA 49:17">तिन्‍नें शोभा-शान<note caller="+" style="f"><char style="fr" closed="false">49:17 </char><char style="fq" closed="false">शोभा-शान </char><char style="ft" closed="false">धन-माया</char></note> छ़ुटणीं इधी!<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />हाम्हां मणछे हआ तेभै बड़ैई ज़ेभै हाम्हैं सफल हआ,</para>
  <para style="q" vid="PSA 49:18">हाम्हैं ज़िऊआ तेभै राज्ज़ी-खुशी।<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />पर हाम्हैं मरनै सोभै संघा डेऊणैं तिधी, ज़िधी तिन्‍नें दाद-बाब डेऊऐ</para>
  <para style="q" vid="PSA 49:19">अर ज़िधी सदा न्हैरअ हणअ।<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />मणछ च़ाऐ ज़िहअ बी मशूर होए, सह निं मरनै का बच़ी सकदअ,</para>
  <para style="q" vid="PSA 49:20">हाम्हैं मरनै सोभै तिहै ई ज़िहै पशू मरा।<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">बिधाता किज़ू करै हआ खुश</para>
  <para style="d">असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />परमेशर बिधाता ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="PSA 50:1">सह शादा पुर्बा ओर्ही पछ़मा तैणीं सारअ संसारा।<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />सियोन नगरी आसा सोभी का बित्ती,</para>
  <para style="q" vid="PSA 50:2">तिधा का निखल़अ परमेशरो धुप्पअ।<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />म्हारअ परमेशर आसा एछणैं आल़अ, पर सह निं च़ुप्प-च़ुप्पै एछणअ,</para>
  <para style="q" vid="PSA 50:3">तेऊ आजू-आजू हणीं दहंदी-प्लुशदी आग भकी दी,</para>
  <para style="q" vid="PSA 50:3">तेऊ फेर हणीं मारदी ढिश-बागर च़ली दी।<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />उझै सरग अर उंधै धरती डाहणैं परमेशरे शाजत कि</para>
  <para style="q" vid="PSA 50:4">तिंयां तेऊ आपणीं परज़ो नसाफ करदै भाल़े।<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />परमेशर बोला इहअ, “मेरै तिंयां भगत करा मुंह सेटा झाल़अ</para>
  <para style="q" vid="PSA 50:5">ज़ुंणी बल़ीदान करी मुंह संघै करार आसा किई दी।”<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />स्वर्गा खोज़णअ तेऊए बारै कि परमेशर आसा धर्मीं,</para>
  <para style="q" vid="PSA 50:6">सह आसा नसाफ करनै आल़अ आप्पै।<verse eid="PSA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />सह बोला इहअ, “मेरै लोगो, शूणां, हुंह बोला तम्हां लै,</para>
  <para style="q" vid="PSA 50:7">इज़राईलीओ, मुंह दैणीं थारै बारै आप्पै शाजत।</para>
  <para style="q" vid="PSA 50:7">हुंह आसा थारअ परमेशर बिधाता।<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />हुंह निं थारै बल़ीदाने बारै तम्हां लै दोश लांदअ,</para>
  <para style="q" vid="PSA 50:8">नां हूम बल़ी ज़ुंण तम्हैं मुल्है कबल्‍ली आणा।<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />हुंह नां थारै खुढा का बल्द बल़ी करना लै बोल्दअ अर</para>
  <para style="q" vid="PSA 50:9">नां थारी भेडा-बाकरीए शाल़ा का बाकरै बल़ी करना लै बोल्दअ,<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />किल्हैकि बणें सोभै पशू अर</para>
  <para style="q" vid="PSA 50:10">हज़ारो धारा रहणैं आल़ै ज़ीब बी आसा सोभै मेरै ई।<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />सोभै च़ेल्‍लू-पखीरू बी आसा मेरै अर</para>
  <para style="q" vid="PSA 50:11">संसारे सोभै ज़िऊंदै ज़ीब बी आसा मेरै ई।<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />ज़ै हुंह भुखअ बी हंदअ, तैबी निं मुंह तम्हां का मांगणे ज़रुरत आथी,</para>
  <para style="q" vid="PSA 50:12">सारअ संसार अर तेते सोभै गल्‍ला आसा मेरी ई।<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />मुंह कै म्हैशे शिखा खाणें ज़रुरत आसा?</para>
  <para style="q" vid="PSA 50:13">कि मुंह छ़ेल्हूओ लोहू लागा झुटणअ?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />हुंह आसा परम प्रधान परमेशर,</para>
  <para style="q" vid="PSA 50:14">हुंह च़ाहा तम्हां का इहअ बल़ीदान कि तम्हैं सदा मेरअ शूकर करे,</para>
  <para style="q" vid="PSA 50:14">अर मुल्है आपणीं ज़बान पूरी करे ज़ुंण तम्हैं मानत मनी।<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />खरीए पलका बोलै तम्हैं मुल्है,</para>
  <para style="q" vid="PSA 50:15">हुंह बच़ाऊं तम्हां आप्पै अर</para>
  <para style="q" vid="PSA 50:15">तै भेटणीं तम्हां मेरी ज़ै-ज़ैकार करनी।”<verse eid="PSA 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />पर कदुष्ट मणछा लै बोला परमेशर इहअ,</para>
  <para style="q" vid="PSA 50:16">“तम्हैं किल्है फिरा मेरै बधाने बारै खोज़दै?</para>
  <para style="q" vid="PSA 50:16">मेरी करारे बारै किल्है करा तम्हैं गल्‍ला?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />ज़िहअ तम्हां हुंह नैरा, तेता, तम्हैं मंदै निं,</para>
  <para style="q" vid="PSA 50:17">मेरअ हुकम समझ़ा तम्हैं बृथा!<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />तम्हैं हआ च़ोरा संघै संगत डाहणां लै राज्ज़ी,</para>
  <para style="q" vid="PSA 50:18">अर तम्हैं हआ कंज़रै मणछा संघै साझ़ू।<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />तम्हैं बोला कबल्‍लै बूरअ ई,</para>
  <para style="q" vid="PSA 50:19">झ़ुठअ बोल़णैं का बी निं तम्हां झ़िह लागदी!<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />तम्हैं लाआ आपणैं भाई-बंधा लै बी दोश,</para>
  <para style="q" vid="PSA 50:20">आपणैं सक्‍कै भाई दी बी शुझिआ तम्हां का खोट।<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />तम्हैं करा इना एतरी गल्‍ला, तज़ी बी निं मंऐं तम्हां लै किछ़ै बोलअ,</para>
  <para style="q" vid="PSA 50:21">तम्हैं सोठा इहअ कि हुंह बी हणअ तम्हां ई ज़िहअ!</para>
  <para style="q" vid="PSA 50:21">पर ऐबै समझ़ाऊंणैं मुंह तम्हैं राम्बल़ै करै,</para>
  <para style="q" vid="PSA 50:21">सोभै गल्‍ला आणनीं मुंह ऐबै थारी आछी सम्हनै बाढै।<verse eid="PSA 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />तम्हैं किअ हुंह भाल़अ नां भाल़अ!</para>
  <para style="q" vid="PSA 50:22">ऐबै शूणां धैन दैई, तम्हैं करनै मुंह पठी बरैबाद,</para>
  <para style="q" vid="PSA 50:22">तम्हां निं कुंण बच़ाऊंणै आल़अ भेटणअ।<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />मेरअ शूकर करनअ आसा इहअ बल़ीदान ज़ेता करै हुंह खुश हआ,</para>
  <para style="q" vid="PSA 50:23">ज़ुंण मेरअ हुकम मना तिन्‍नां बच़ाऊंदअ एछणअ हुंह पाक्‍कै दी।”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">पाप माफी लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न ज़धू नातान गूर तेऊ सेटा लै इहअ खोज़दअ आअ कि बेतशेबा संघै रही किअ तंऐं पाप।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />हे बिधाता, मुल्है दै जश,</para>
  <para style="q" vid="PSA 51:1">किल्हैकि तूह झ़ूरा मुल्है सदा।</para>
  <para style="q" vid="PSA 51:1">आपणीं महान झींण करी कर</para>
  <para style="q" vid="PSA 51:1">तूह मेरै पाप दूर।<verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />मेरी बूराई कर पठी खतम अर</para>
  <para style="q" vid="PSA 51:2">तूह कर मुंह मेरै पापा का शुचअ।<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />हुंह जाआ समझ़ी कि मुंह दी आसा खोट,</para>
  <para style="q" vid="PSA 51:3">मुखा इहअ बी आसा थोघ कि मंऐं किज़ै-किज़ै पाप किऐ।<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />सह आसा सिधअ तूह ई, एक्‍कै तूह ई ज़सरै खलाफ मंऐं पाप किऐ,</para>
  <para style="q" vid="PSA 51:4">ज़ेता तूह बूरअ मना मंऐं किअ सह ई!</para>
  <para style="q" vid="PSA 51:4">मंऐं निं तेरअ हुकम मनअ अर सह आसा मेरी गलती,</para>
  <para style="q" vid="PSA 51:4">मुल्है दोश लाणा लै आसा तूह शुचअ अर मेरअ नसाफ करना लै आसा तूह धर्मीं।<verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />मंऐं किअ हुऐ ज़ल्मां ओर्ही पाप,</para>
  <para style="q" vid="PSA 51:5">ज़धू हुंह मेरी माए ओदरै आअ, मुंह दी आसा तधा ई ओर्ही दोश!<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />तूह हआ तेऊ लै खुश ज़ुंण दिला का शुचअ अर मानदार आसा।</para>
  <para style="q" vid="PSA 51:6">तूह पाआ मेरै मन्‍नैं ऐबै आप्पै अक्ल।<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />तूह कर मेरै पाप दूर, तै जाणअ हुंह शुचअ हई,</para>
  <para style="q" vid="PSA 51:7">मुंह धो तूह ज़ुफे डाल़ी करै आप्पै तै हणअ हुंह हिंऊंआं ज़िहअ शेतअ।<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />मुंह लोल़ी भिई खुशी अर नंद हुई,</para>
  <para style="q" vid="PSA 51:8">तंऐं चोल़ै मेरै हाडकै-हाडकै,</para>
  <para style="q" vid="PSA 51:8">ऐबै लोल़ी ती मुंह भिई खुशी हुई।<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />तूह निं ऐबै मेरै पापा भाल़अ लागी,</para>
  <para style="q" vid="PSA 51:9">ज़ुंण मुंह दी खोट आसा, तेता कर तूह मुखा आप्पै दूर।<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />हे परमेशर, मेरै मन्‍नैं पा तूह सुंबल़ी सोर अर</para>
  <para style="q" vid="PSA 51:10">मेरी आत्मां कर तूह ऐबै शुची अर भरोस्सै करनै जोगी।<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />मुंह निं तूह आप्पू का दूर करी अर</para>
  <para style="q" vid="PSA 51:11">नां आपणीं पबित्र आत्मां मुखा पोर्ही काढी।<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />मुंह लोल़ी भिई तेही खुशी हुई ज़ेही तेरै उद्धार करनै करै भेटा,</para>
  <para style="q" vid="PSA 51:12">अर मेरै दिलै कर एही च़ाह पैईदा कि ज़िहअ तूह बोले मंऐं लोल़ी तिहअ ई किअ।<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />तै दैंऊं हुंह होरी पापी मणछा लै तेरै बधाने शिक्षा,</para>
  <para style="q" vid="PSA 51:13">ताकि तिंयां बी ताह बाखा लै फिरे।<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />हे परमेशर, मेरी ज़िन्दगी डाह सभाल़ी, अर मुंह बच़ाऊ,</para>
  <para style="q" vid="PSA 51:14">तै करनी मुंह गिह बोली ज़ै-ज़ैकार कि तूह आसा धर्मीं।<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />हे मेरै मालक, गल्‍ला करना लै कर तूह मेरी मज़त,</para>
  <para style="q" vid="PSA 51:15">ताकि मेरी खाखा का तेरी बड़ैईए गल्‍ला निखल़े।<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />तूह निं पशूओ बल़ीदान च़ाहंदअ,</para>
  <para style="q" vid="PSA 51:16">तेता करदअ हुंह पोर्ही,</para>
  <para style="q" vid="PSA 51:16">नां तूह हूम बल़ी करै खुश हंदअ।<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />हे परमेशर, तूह हआ तेता लै खुश कि दिला का गलती मनी पछ़ताअ करे,</para>
  <para style="q" vid="PSA 51:17">अह ई आसा सह बल़ीदान ज़ेता तूह मना अर ज़ेता करै तूह राज्ज़ी हआ।<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />हे परमेशर, ज़ीबाण, एरुशलेम नगरी लै कर झींण अर मज़त,</para>
  <para style="q" vid="PSA 51:18">ऐहा नगरी फेर-फिरदी दुआली कर भिई खल़ी।<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />तै हणअ तूह सारी हूम बल़ी करै खुश,</para>
  <para style="q" vid="PSA 51:19">तै करनै हाम्हां बी तेरी बेदी</para>
  <para style="q" vid="PSA 51:19">सेटा बधिया का बधिया बल़ीदान।<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">परमेशरे बशै आसा सोभै गल्‍ला</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो खास भज़न, ज़धू दोएग एदोमी राज़ै शाऊला का खोज़ी पाअ त कि दाबेद डेऊअ त आहीमोलके घअरै।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />तम्हैं शूरबीर ज़ुल्म करी किल्है हआ हुल्‍लै-फुल्‍लै दै,</para>
  <para style="q" vid="PSA 52:1">तम्हैं इहअ बी ज़ाणा कि परमेशर करा सदा नसाफ?<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />तम्हां हआ कबल्‍ली होरी बरैबाद करने ई सोठ पल़ी दी,</para>
  <para style="q" vid="PSA 52:2">थारी ज़िभ छाम्बा होरी तिछै उस्तरै ज़ेही,</para>
  <para style="q" vid="PSA 52:2">झ़ुठअ बोला तम्हैं हेरा-हेरी।<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />तम्हैं झ़ूरा भलै का खास्सअ बूरै करना लै,</para>
  <para style="q" vid="PSA 52:3">शुची गल्‍ला छ़ाडी झ़ूरा तम्हैं शल़ैघा लै।<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />तम्हैं शल़ैघी झ़ूरा आपणीं गल्‍ला करै बरैबाद करना लै!<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />परमेशरा करनै तम्हैं ऐबै सदा लै बरैबाद,</para>
  <para style="q" vid="PSA 52:5">तेऊ काढणैं तम्हैं हाथा ढाकी थारै घअरा का बागै,</para>
  <para style="q" vid="PSA 52:5">तेऊ शोटणै तम्हैं ज़िऊंदै मणछे संसारा का दूर।<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />धर्मीं मणछा छ़ुटणअ इना गल्‍ला भाल़ी दर्छ़णअ,</para>
  <para style="q" vid="PSA 52:6">तिन्‍नां लागणअ इहअ बोली तम्हां लै हास्सदै,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />“भाल़ा, ईंयां आसा तिंयां ज़ुंण परमेशरा आपणीं शरण लणें ज़ैगा निं समझ़दै,</para>
  <para style="q" vid="PSA 52:7">तेता का खास्सअ करा ईंयां आपणीं धन-माया दी भरोस्सअ,</para>
  <para style="q" vid="PSA 52:7">ईंयां समझ़ा ज़ुल्म करनअ ई आपणीं फाज़त।”<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />पर हुंह आसा इहै जैतूने बूटा ज़िहअ, ज़ुंण परमेशरे भबने खोल़ै आसा लागअ द,</para>
  <para style="q" vid="PSA 52:8">हुंह करा तेऊए अटल़ झ़ूरी दी भरोस्सअ ज़ुंण मुंह संघै जुगै-जुगै तैणीं सदा रहणीं।<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />हे परमेशर, तेरै ई एऊ कामां लै रहणअ मुंह</para>
  <para style="q" vid="PSA 52:9">कबल्‍लै तेरअ शूकर करदै लागी,</para>
  <para style="q" vid="PSA 52:9">मुंह खोज़णअ तेरै सोभी पबित्र लोगा सेटा डेऊई कि तूह किहअ भलअ आसा।<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">कमुर्ख मणछे कदुष्ट काम</para>
  <para style="r">(<ref loc="PSA 14:1-7">भज़न 14:1-7</ref>)</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />ऐडअ सोठा आपणैं मन्‍नैं इहअ, “परमेशर निं आथी ई!”</para>
  <para style="q" vid="PSA 53:1">इहै मणछ आसा भ्रष्ट गऐ दै हई,</para>
  <para style="q" vid="PSA 53:1">तिन्‍नें आसा बेघै च़िल़्हखरै काम अर</para>
  <para style="q" vid="PSA 53:1">तिन्‍नां मांझ़ै निं इहअ कोहै आथी ज़ुंण भलअ पाछा।<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />परमेशर हआ स्वर्गा का उंधै मणछा भाल़अ लागअ द कि</para>
  <para style="q" vid="PSA 53:2">तिन्‍नां मांझ़ै कहा एकी बी आसा अक्ल</para>
  <para style="q" vid="PSA 53:2">ज़ुंण परमेशरे लोल़-तोप करा।<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />पर सोभै मणछ आसा कबाता गऐ दै पेठी,</para>
  <para style="q" vid="PSA 53:3">ज़ाथी आसा सोभै भ्रष्ट गऐ दै हई।</para>
  <para style="q" vid="PSA 53:3">कोहै निं भलअ करदअ,</para>
  <para style="q" vid="PSA 53:3">ज़ाथी निं एक बी आथी!<verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />परमेशर पुछ़ा इहअ, “इना कदुष्टा का थोघै निं आथी?</para>
  <para style="q" vid="PSA 53:4">ईंयां खाआ मेरै लोगा फुलकी ज़िहै लुटी</para>
  <para style="q" vid="PSA 53:4">अर मेरअ निं ईंयां नाअं बी लंदै!”<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />पर ज़िधी किछ़ै डअर बी निं होए तिधी बी छ़ुटणअ तिन्‍नां दर्छ़णअ,</para>
  <para style="q" vid="PSA 53:5">एही डअर निं तिन्‍नैं कधि भाल़ी,</para>
  <para style="q" vid="PSA 53:5">किल्हैकि आपणीं परज़े दुशमणे हाडकै छिंगणैं परमेशरा सारै दी।</para>
  <para style="q" vid="PSA 53:5">परमेशरै किऐ तिंयां आप्पू का दूर</para>
  <para style="q" vid="PSA 53:5">अर तिंयां हुऐ पठी शर्मिंदै।<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />सियोन धारा का इज़राईली बच़ाऊंदअ कुंण एछणअ?</para>
  <para style="q" vid="PSA 53:6">ज़ेभै परमेशरा आपणीं परज़ा गलामी का आज़ाद करनी,</para>
  <para style="q" vid="PSA 53:6">याकबा करनी खुशीए मारै ज़ोरै-ज़ोरै ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 53:6">अर इज़राईली हणैं बेघै खुशी।<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">खरीए पलका बिधाता दी भरोस्सअ करनअ</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै, तारा आल़ै बाज़ै करै राज़ै दाबेदो खास भज़न, ज़धू जीपी राज़ै शाऊला का खोज़अ, “दाबेद रहा हाम्हां जैंदरी लुक्‍की।”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />हे परमेशर, तूह बच़ाऊ मुंह आपणैं ज़ोरै,</para>
  <para style="q" vid="PSA 54:1">आपणैं महान प्रतप्पा करै कर मुंह आज़ाद।<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />हे परमेशर, मेरी अरज़ शुण,</para>
  <para style="q" vid="PSA 54:2">मेरी गल्‍ला दी दै धैन!<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />हे परमेशर, शरेरै लोग आसा मुंह पिछ़ू पल़ै दै,</para>
  <para style="q" vid="PSA 54:3">तिन्‍नैं कदुष्ट मणछै लाअ हुंह मारी पाई,</para>
  <para style="q" vid="PSA 54:3">तिंयां निं तेरी बी किछ़ै परबाह करदै।<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />भाल़, मेरी मज़त करनै आल़अ आसा तूह मेरअ परमेशर,</para>
  <para style="q" vid="PSA 54:4">तूह मेरअ मालक डाहा मुंह ज़िऊंदै!<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />मेरै मालक, ताह ई दैणीं मेरै दुशमणा लै तिन्‍नें कदुष्ट कामां पिछ़ू सज़ा।</para>
  <para style="q" vid="PSA 54:5">तूह कर तिन्‍नां तिहै ई खतम ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />हे बिधाता, तैहा खुशी करनअ मुंह ताल्है बल़ीदान,</para>
  <para style="q" vid="PSA 54:6">मुंह करनअ तेरअ शूकर</para>
  <para style="q" vid="PSA 54:6">किल्हैकि तूह आसा राम्बल़अ।<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />तंऐं बच़ाऊअ हुंह सोभी आफ़ता का,</para>
  <para style="q" vid="PSA 54:7">मंऐं भाल़ै आपणीं आछी मेरै दुशमण हारदै।<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">विश्वास घात करनै आल़ै लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै तारा आल़ै बाज़ै संघै राज़ै दाबेदो खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />हे परमेशर, मेरी अरज़ शुण,</para>
  <para style="q" vid="PSA 55:1">मेरी लेर-पकारा भाल़ी निं मुंह बाखा आपणीं पिठ फरेऊई।<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />मुंह बाखा दै धैन, ऐबै दै मेरी गल्‍लो ज़बाब,</para>
  <para style="q" vid="PSA 55:2">मुल्है पल़ी एही आफ़ता कि हुंह च़ाल्‍लअ पठी खतम हई।<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />मेरै दुशमणे धमकी शूणीं पल़अ मुंह हैल़अ,</para>
  <para style="q" vid="PSA 55:3">इनै कदुष्ट मणछै आणअ हुंह हंती,</para>
  <para style="q" vid="PSA 55:3">तिन्‍नैं लाई मुल्है आफ़ता प्रैंदै आफ़त खल़ी करी,</para>
  <para style="q" vid="PSA 55:3">तिंयां डाहा मुंह संघै ज़ीद अर तिन्‍नैं आणअ हुंह रोश्शै छेऊई।<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />मेरअ दिल आसा भितरा का चुटी गअ द,</para>
  <para style="q" vid="PSA 55:4">मरनै हैल़ै च़ाल्‍लै मेरै शाह-प्राण डेऊई।<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />मुंह आसा डरै काम्मणीं लागी दी,</para>
  <para style="q" vid="PSA 55:5">मुंह आसा भितरी दर्छ़णअ छ़ुटअ द।<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />हुंह सोठा इहअ, ज़ै मेरै पालल़ी ज़िहै फैंख हंदै,</para>
  <para style="q" vid="PSA 55:6">तै दैणअ त मुंह दूरा लै डैअ अर तै झ़ाणीं मुंह राम भेटदअ।<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />मुंह दैणअ त दूर रेगीस्ताना तैणीं डैअ,</para>
  <para style="q" vid="PSA 55:7">संघा बणाणअं त मुंह आपणअ घअर तिधी।<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />ढिश-बागरी का बच़णा लै लोल़णी ती मुंह तै</para>
  <para style="q" vid="PSA 55:8">झ़टपटै किधी शरण लणें ज़ैगा।<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />हे मेरै मालक, मेरै दुशमणा जैंदरी पा झाख।</para>
  <para style="q" vid="PSA 55:9">ज़ुंण तिन्‍नैं आप्पू मांझ़ै जोग किअ, सह निं लोल़ी सफल हुअ।</para>
  <para style="q" vid="PSA 55:9">मुखा शुझिआ नगरी दी उपद्रभ अर झ़गल़ै,<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />नगरीए दुआली फेर हआ राची-धेल़ी पहरअ पाअ द,</para>
  <para style="q" vid="PSA 55:10">पर असली उपद्रभ अर आफ़त आसा नगरी भितरी।<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />हर ज़ैगा आसा बरैबादी,</para>
  <para style="q" vid="PSA 55:11">ज़ुल्म अर छ़ल़-कपट आसा गंईं-गंईं दी।<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />ज़ै तिंयां मेरै सुहांगा करनै आल़ै मेरै दुशमण हंदै,</para>
  <para style="q" vid="PSA 55:12">तेता काढदअ हुंह ज़िरी,</para>
  <para style="q" vid="PSA 55:12">ज़ै कुंण मेरअ बैरी मुंह संघै शरेरी गल्‍ला करदअ,</para>
  <para style="q" vid="PSA 55:12">तेऊ का च़ोरदअ हुंह आपणअ मुंह।<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />पर तिंयां आसा मेरै साथी-संघी अर सक्‍कै रिश्तैदार,</para>
  <para style="q" vid="PSA 55:13">ज़हा दी हुंह खास्सअ भरोस्सअ करा त।<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />हे परमेशर, हाम्हैं रहा संघा अर आप्पू मांझ़ै राम्बल़ै चिंजदै बाशदै,</para>
  <para style="q" vid="PSA 55:14">तेरी जाचा लै बी एछा तै हाम्हैं लोगा संघै संघा।<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />तिन्‍नां लै लोल़ी ती नच़ानक मौत आई,</para>
  <para style="q" vid="PSA 55:15">तिंयां लोल़ी तै ज़िऊंदी ज़िता जम्परी पेठै!</para>
  <para style="q" vid="PSA 55:15">किल्हैकि तिन्‍नें आसा मन्‍नैं अर सारै घअरै ई छ़ल़-कपट बस्सअ द।<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />हे बिधाता, मुंह पाणीं मज़ती लै ताह सेटा लेर-पकार,</para>
  <para style="q" vid="PSA 55:16">हुंह हेरनअ ताह बच़ाऊई।<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />दोत्ती, दपहरै अर राची</para>
  <para style="q" vid="PSA 55:17">जाआ मेरी लेर-पकार ताह सेटा पुजी अर</para>
  <para style="q" vid="PSA 55:17">तूह हेरा मेरी गल्‍ला शूणीं।<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />मेरै दुशमणै गोटअ हुंह फेरा-फेर</para>
  <para style="q" vid="PSA 55:18">ताह हेरनअ हुंह तेऊ झ़गल़ै का राज्ज़ी-राम्बल़अ बापस पजैल़ी,</para>
  <para style="q" vid="PSA 55:18">ज़ुंण मेरै दुशमणै मुंह संघै आसा छ़ेल़अ द।<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />परमेशर, तेरअ राज़ आसा सदा ओर्ही,</para>
  <para style="q" vid="PSA 55:19">ताह हेरनी मेरी अरज़ शूणीं अर</para>
  <para style="q" vid="PSA 55:19">ताह हेरनै मेरै दुशमण हारी</para>
  <para style="q" vid="PSA 55:19">किल्हैकि तिंयां निं ताह बिधाता बाखा फिरदै अर नां तिन्‍नां तेरी डअर आथी!<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />हुंह त तिन्‍नों आपणअ पै, तज़ी बी दैनअ तिन्‍नैं मुल्है धोखअ,</para>
  <para style="q" vid="PSA 55:20">ज़ेही तिन्‍नैं करार किई ती, तेही निं तिन्‍नैं आपणीं ज़बान पूरी किई।<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />गल्‍ला, करा तिंयां च़ोपल़ लाई,</para>
  <para style="q" vid="PSA 55:21">पर दिलै डाहा तिंयां ज़ीद,</para>
  <para style="q" vid="PSA 55:21">बैण, बोला तिंयां घिऊ ज़िहै नरम</para>
  <para style="q" vid="PSA 55:21">पर तिंयां करा तिछी तलबारा ज़िहै ज़खम।<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />हे बिधाता, हाम्हैं आसा तेरै,</para>
  <para style="q" vid="PSA 55:22">हाम्हैं खोज़ा आपणीं खरी ताखा</para>
  <para style="q" vid="PSA 55:22">अर तूह निं धर्मीं मणछा हारनै दैंदअ।<verse eid="PSA 55:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />पर हे परमेशर, तिंयां हत्या करनै आल़ै अर कदुष्ट पाणै ताह डुघी खात्ती दी,</para>
  <para style="q" vid="PSA 55:23">तिंयां निं आधी अमरा बी ज़िऊंणै</para>
  <para style="q" vid="PSA 55:23">पर मुंह डाहणअ ताह ई दी भरोस्सअ।<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">हंतणैं आल़ै का छ़ुटकारै लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै योनतेलेखद्दोकीम ज़ैगा दाबेदो खास भज़न ज़धू पलिश्ती तिंयां गात नगरी ढाकै तै।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />हे परमेशर, मुल्है कर झींण,</para>
  <para style="q" vid="PSA 56:1">हुंह गोटअ मेरै दुशमणै फेरा-फेर,</para>
  <para style="q" vid="PSA 56:1">तिन्‍नैं आणअ हुंह धैल़ हंती-हंती मारी।<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />मेरै बैरी करा मुंह संघै धैल़ झ़गल़अ,</para>
  <para style="q" vid="PSA 56:2">ज़ुंण शरेरै मुंह संघै च़िखदै एछा, तिंयां आसा खास्सै।<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />पर हे परमेशर, ज़ेभै बी मुंह डअर लागा,</para>
  <para style="q" vid="PSA 56:3">हुंह डाह तेभै तेरअ ई भरोस्सअ।<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />हे परमेशर, मेरअ भरोस्सअ आसा ताह ई दी कि मुंह डअर नां लागे,</para>
  <para style="q" vid="PSA 56:4">ज़ुंण तंऐं ज़बान आसा दैनी दी हुंह करा तेते बड़ैई,</para>
  <para style="q" vid="PSA 56:4">तेखअ निं कोहै मणछ मेरअ किछ़ बगाल़ी सकदै।<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />मेरै दुशमण हआ कबल्‍लै मेरी गल्‍ला दी खोट लोल़ै लागै दै,</para>
  <para style="q" vid="PSA 56:5">तिंयां हआ कबल्‍लै ताखुऐ दै कि किहअ करै मेरी हान्‍नी करे।<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />तिंयां हआ आप्पू मांझ़ै कठा</para>
  <para style="q" vid="PSA 56:6">संघा हआ लुक्‍की करै मुंह भाल़ै लागै दै कि हुंह किज़ै करा,</para>
  <para style="q" vid="PSA 56:6">तिंयां हआ मुंह मारना लै ताखुई रहै दै।<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />हे परमेशर, तूह दै तिन्‍नें कदुष्ट कामां लै आप्पै सज़ा,</para>
  <para style="q" vid="PSA 56:7">तेरै रोश्शा करै लोल़ी तिंयां हारै।<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />भाल़, ताखा आसा थोघ कि मुल्है केही आफ़त आसा पल़ी दी,</para>
  <para style="q" vid="PSA 56:8">तंऐं आसा मेरी लेर-पकारो साब-कताब डाहअ द,</para>
  <para style="q" vid="PSA 56:8">हाँ, तंऐं आसा सोभै गल्‍ला आपणीं कताबा दी डाही दी लिखी।<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />ज़ेभै हुंह ताखा अरज़ करूं,</para>
  <para style="q" vid="PSA 56:9">तेभै लोल़ी मेरै दुशमण पिछ़ू फिरै।</para>
  <para style="q" vid="PSA 56:9">मुखा आसा इहअ थोघ कि परमेशर आसा मुंह बाखा।<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />तूह परमेशर बिधाता ज़ेही ज़बान दैआ, हुंह करा तेते ज़ै-ज़ैकार।<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11" />हुंह करा तेरअ ई भरोस्सअ अर तेखअ निं हुंह डरदअ,</para>
  <para style="q" vid="PSA 56:11">तेखअ मणछ मेरअ किज़ै सका बगाल़ी?<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />हे परमेशर बिधाता, ज़ुंण मंऐं ताल्है मानत आसा मनी दी, सह करनी मुंह पूरी,</para>
  <para style="q" vid="PSA 56:12">मुंह करनअ तेरअ शूकर अर सह हणीं ताल्है मेरी भैंट।<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />किल्हैकि तंऐं बच़ाऊअ हुंह मरनै का अर</para>
  <para style="q" vid="PSA 56:13">तंऐं निं मुंह हारनै दैनअ।</para>
  <para style="q" vid="PSA 56:13">ताकि हुंह ताह खुश करूं अर</para>
  <para style="q" vid="PSA 56:13">तेऊ प्रैश्शै दी हांढूं ज़ेता करै ज़िन्दगी भेटा।<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">दुशमणा का फाज़त लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै अल-तशहेत रागा दी राज़ै दाबेदो खास भज़न, ज़धू सह राज़ै शाऊला सेटा का ठुर्ही डुआरै थिअ लुक्‍की रहअ द।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />हे बिधाता, मुल्है कर झींण,</para>
  <para style="q" vid="PSA 57:1">किल्हैकि मंऐं आसा ताह सेटा शरण लई दी।</para>
  <para style="q" vid="PSA 57:1">ज़ेभै तैणीं ईंयां आफ़ता मुक्‍की निं जाए,</para>
  <para style="q" vid="PSA 57:1">तेभै तैणीं लणी मुंह तेरै फैंखा हेठै शरण।<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />मुंह करनी ताह परम प्रधान परमेशरा सेटा अरज़</para>
  <para style="q" vid="PSA 57:2">ज़ुंण मेरी सारी गरज़ा पूरी करा।<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />ताह बिधाता करनी मेरी स्वर्गा का मज़त संघा हेरनअ हुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 57:3">ज़ुंण मुंह हंता, तिन्‍नां लै पाणीं ताह आफ़त।</para>
  <para style="q" vid="PSA 57:3">तेरी झ़ूरी आसा मुल्है अटल़ अर तूह आसा शुचअ-पाक्‍कअ।<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />हुंह आसा मेरै दुशमणै फेरा-फेर गोटअ द,</para>
  <para style="q" vid="PSA 57:4">ज़ुंण आदमखोर भुखै सिहा ज़िहै आसा।</para>
  <para style="q" vid="PSA 57:4">तिन्‍नां मणछे दांद आसा कतीर अर बर्छ़ी ज़िहै अर</para>
  <para style="q" vid="PSA 57:4">तिन्‍नें ज़िभा आसा तिछी तलबारा ज़ेही।<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />हे बिधाता, तेरअ अदर लोल़ी सारै भ्रमंडै हुअ अर</para>
  <para style="q" vid="PSA 57:5">तेरअ प्रतप्प लोल़ी सारी पृथूई दी शुझुअ।<verse eid="PSA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />मेरै दुशमणै आसा मुल्है ज़ज़ाल़ छ़ैअ द,</para>
  <para style="q" vid="PSA 57:6">हुंह च़ाल्‍लअ हैल़ै मरी।</para>
  <para style="q" vid="PSA 57:6">तिन्‍नें आसा मुल्है डुघी खात्ती डाही दी खण्हीं,</para>
  <para style="q" vid="PSA 57:6">पर तेथ लोल़ी तै तिंयां आप्पू ई पल़ै।<verse eid="PSA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />हे परमेशर, मुंह आसा तेरअ पाक्‍कअ भरोस्सअ,</para>
  <para style="q" vid="PSA 57:7">मुंह करनी गिहा बोली तेरी ज़ै-ज़ैकार!<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />ए मेरै मन्‍नां, ज़ाग! उझ़ू,</para>
  <para style="q" vid="PSA 57:8">तारा आल़ै बाज़ै अर बींन ज़ागा!</para>
  <para style="q" vid="PSA 57:8">मुंह जाणअ राच भैंदी उझ़ुई।<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />हे मेरै मालक, मुंह करनअ देशा-देशे लोगा जैंदरी तेरअ शूकर,</para>
  <para style="q" vid="PSA 57:9">सोभी लोगा नदरी करनी मुंह गिहा बोली तेरी ज़ै-ज़ैकार।<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />हाम्हां लै तेरी अटल़ झ़ूरी आसा उझै सरगै तैणीं,</para>
  <para style="q" vid="PSA 57:10">तेरअ सत्त आसा सारै भ्रमंडै।<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />हे बिधाता, तेरअ अदर लोल़ी उझै सारै भ्रमंडै हुअ अर</para>
  <para style="q" vid="PSA 57:11">तेरअ प्रतप्प लोल़ी सारी पृथूई दी शुझुअ।<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">नां नसाफीए घल़ी अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै अल-तशहेत रागा दी राज़ै दाबेदो खास भज़न।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />तम्हैं राज़ करनै आल़ै शूरबीर मणछ कै कधू नसाफ बी करा?</para>
  <para style="q" vid="PSA 58:1">तम्हैं कधू धर्मीं रही शुचअ नसाफ बी किअ?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />तम्हैं निं करदै! तम्हैं सोठा सिधअ बूरअ ई ज़िहअ तम्हैं करा,</para>
  <para style="q" vid="PSA 58:2">तम्हैं करा देशै ज़ुल्म अर उपद्रभ ई।<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />तम्हैं किअ हुऐ ज़ल्मां ओर्ही</para>
  <para style="q" vid="PSA 58:3">बूरअ अर झ़ुठअ ई झ़ुठअ!<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />तम्हां का आसा झ़रीली दानुईं ज़िहअ बिश,</para>
  <para style="q" vid="PSA 58:4">तम्हैं आसा शपैल़ा ज़िहै टौणैं ज़ुंण शुणदअ ई निं आथी,<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />तेऊ लै च़ाऐ ज़ेतरी बी बींन बाज़े</para>
  <para style="q" vid="PSA 58:5">अर ज़ादू करनै आल़अ ज़िहअ बी मत्र बोले, सह निं शुणदअ।<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />हे बिधाता, इने कुकल़ी पा चोल़ी,</para>
  <para style="q" vid="PSA 58:6">हे बिधाता, इना खारकै सिहे दाल़्हा पेच़ पोर्ही।<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />ईंयां लोल़ी इहै लुक्‍कै ज़िहअ नचिशी ज़िम्मीं दी पाणीं रप्पा,</para>
  <para style="q" vid="PSA 58:7">ईंयां लोल़ी बाता नगाल़ै ज़िहै चल़ेफुऐ।<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />ईंयां लोल़ी फिल्हा ज़िहै गल़ी करै खतम हुऐ,</para>
  <para style="q" vid="PSA 58:8">ईंयां लोल़ी इहै शोहरू ज़िहै हुऐ ज़ुंण आपणीं माए ओदरा का मूंऐं दै निखल़ा</para>
  <para style="q" vid="PSA 58:8">अर तिन्‍नां निं धुप्पअ बी भाल़णअ भेटदअ।<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />ज़ेभा लै तिन्‍नां का थोघ लागणअ, तिंयां लोल़ी झ़िंझ़रै कांडै ज़िहै छ़ांबी हेरै,</para>
  <para style="q" vid="PSA 58:9">हे बिधाता, तेरै रोश्शै लोल़ी तिंयां ज़िऊंदी ज़िता बागरी ज़िहै दूर फर्ल़ाऊऐ।<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />पापी मणछा लै सज़ा भेटदी भाल़ी लोल़ी धर्मीं मणछा खुशी हुई,</para>
  <para style="q" vid="PSA 58:10">तिन्‍नैं लोल़ी कदुष्ट दुशमणे लोहू दी आपणैं खूर धोऐ।<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />तेखअ बोल़णअ लोगा इहअ,</para>
  <para style="q" vid="PSA 58:11">“धर्मीं मणछा भेटअ बधिया फल, अह आसा परमेशर ई ज़ुंण संसारै नसाफ करा।”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">आपणीं फाज़त लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै अल-तशहेत रागा दी राज़ै दाबेदो खास भज़न, ज़धू राज़ै शाऊलै तेऊए घअरा फेर पहरअ पाअ कि तिंयां तेऊ मारी पाए।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />हे मेरै परमेशर, तूह बच़ाऊ मुंह मेरै दुशमणा का,</para>
  <para style="q" vid="PSA 59:1">हुंह गोटअ इनै फेरा-फेर ऐबै बच़ाऊ इना का मुंह तूह ई।<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />तूह बच़ाऊ मुंह इना कदुष्ट मणछा का,</para>
  <para style="q" vid="PSA 59:2">इना हत्या करनै आल़ै का कर मेरी फाज़त।<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />भाल़! तिंयां आसा मुंह मारी पाणा लै ताखुऐ दै,</para>
  <para style="q" vid="PSA 59:3">ईंयां नर्दैई मणछ हुऐ मुंह मारना लै कठा।</para>
  <para style="q" vid="PSA 59:3">अह निं एता लै हुअ कि मंऐं किअ होए कोई पाप!<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />हे बिधाता, नां मंऐं किज़ै कशूर किअ आथी!</para>
  <para style="q" vid="PSA 59:4">हे परमेशर, भाल़णीं दै, उझ़ू, ऐबै कर मेरी मज़त।<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />ए स्वर्गे सारी सैने मालक बिधाता, ऐबै उझ़ू, ऐबै एछ तूह मेरी मज़त करदअ,</para>
  <para style="q" vid="PSA 59:5">तूह आसा इज़राईलो परमेशर!</para>
  <para style="q" vid="PSA 59:5">ऐबै ज़ाग संघा दै इना विश्वास घाती लै सज़ा,</para>
  <para style="q" vid="PSA 59:5">इना नर्दैई अर कदुष्टा लै निं किछ़ै झींण करी।<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />तिंयां मेरै दुशमण एछा सान्हां संघा लागा कुक्‍करा ज़िहै ख्रिशदै,</para>
  <para style="q" vid="PSA 59:6">संघा रहा नगरी फेर ठुल़्दै लागी।<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />हे बिधाता, तिन्‍नें हाक्‍का अर धमकी शुण,</para>
  <para style="q" vid="PSA 59:7">तिन्‍नें खाखा, ज़िभ आसा तलबारा ज़ेही,</para>
  <para style="q" vid="PSA 59:7">तिंयां सोठा आप्पू इहअ कि तिन्‍नां निं कोहै आथी शूणअ लागअ द!<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />पर हे बिधाता, ताह फुक्‍कणी इना पराई ज़ातीए लोगा लै हास्सी अर</para>
  <para style="q" vid="PSA 59:8">ताह करनअ तिन्‍नों सुहांग।<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />हे परमेशर, मुंह आसा तेरै ज़ोरो भरोस्सअ,</para>
  <para style="q" vid="PSA 59:9">मेरी शरण लणें ज़ैगा आसा तूह ई।<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />तूह झ़ूरा मुल्है अर तूह जाणअ मुंह भेटी,</para>
  <para style="q" vid="PSA 59:10">ताह रहैऊंणै मुखा मेरै दुशमण हारदै मेरी आछी।<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />तिन्‍नां निं मारी आथी, नांईं ता लोग जाणैं बिस्सरुई।</para>
  <para style="q" vid="PSA 59:11">हे मेरै मालक बिधाता, तिन्‍नां छिंग खद्रेल़ी करै ओर्ही-पोर्ही</para>
  <para style="q" vid="PSA 59:11">संघा लोल़ी तिंयां हारै, तेरै लोगा लै बच़णे ढाल़ आसा तूह ई।<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />पाप आसा तिन्‍नें होठै, तिन्‍नें निखल़ा हर बैणा दी पाप,</para>
  <para style="q" vid="PSA 59:12">ज़िहअ झ़ुठअ बोल़णा लै तिंयां घमंड करा,</para>
  <para style="q" vid="PSA 59:12">तिंयां लोल़ी तै मुंह तिन्‍नां ई गल्‍ला दी शाचै।<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />तिन्‍नां कर तूह आपणैं रोश्शा करै बरैबाद,</para>
  <para style="q" vid="PSA 59:13">तिन्‍नां कर पठी खतम।</para>
  <para style="q" vid="PSA 59:13">तेखअ इहअ करै लागणअ सोभी का थोघ कि याकबे आद-लुआदा प्रैंदै करा तूह परमेशर आप्पै राज़</para>
  <para style="q" vid="PSA 59:13">अर तेरअ राज़ आसा सारी पृथूई दी।<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />तिंयां एछा सान्हां संघा लागा कुक्‍करा ज़िहै ख्रिशदै,</para>
  <para style="q" vid="PSA 59:14">संघा रहा नगरी फेर ठुल़्दै लागी।<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />ज़िहअ कि तिंयां आसा फेर रोटीए ठोर-म्हारा लोल़ै लागै दै,</para>
  <para style="q" vid="PSA 59:15">ज़ै तिन्‍नां नांई भेटअ, संघा रहा तिंयां सारी राची ख्रिशदै लागी।<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />पर मुंह करनी तेरै ज़ोरे ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 59:16">तेरी अटल़ झ़ूरीए बोल़णीं मुंह दोत्ती धैल़ गिह।</para>
  <para style="q" vid="PSA 59:16">किल्हैकि तूह आसा मुल्है उछ़टै गहल़ा ज़िहअ</para>
  <para style="q" vid="PSA 59:16">ज़ेथ हुंह आफ़ते पलका शरण लआ।<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />मुंह करनी तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 59:17">मेरी फाज़त करनै आल़अ आसा तूह,</para>
  <para style="q" vid="PSA 59:17">तूह आसा सह परमेशर ज़ुंण मुल्है खास्सअ झ़ूरा।<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">छ़ुटकारै लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो शूशनेदूत रागा दी खास भज़न। तेऊ लिखअ अह भज़न तधू, ज़धू उतर सिरीया देशे सैना संघै जुध थिअ लागअ द, ज़धू लूंणै खागा दी जोआब फिरी डेऊअ अर तेऊ पाऐ तै तिधी बारा हज़ार एदोमी मारी।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />हे परमेशर, तंऐं डाहै हाम्हैं शोटी अर हाम्हैं पाऐ तंऐं हारी,</para>
  <para style="q" vid="PSA 60:1">तूह आसा हाम्हां का रुश्शअ द, ऐबै कर हाम्हां भिई तिहै ई ज़िहै थिऐ।<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />तंऐं किई धरती दी ज़ाज़री संघा पाई तेथ द्रटा,</para>
  <para style="q" vid="PSA 60:2">ऐबै ज़ोल़ एता भिई नांईं ता च़ाल्‍ली पठी ढूल़ी।<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />तंऐं रहैऊई आपणीं परज़ा का खास्सी खरी,</para>
  <para style="q" vid="PSA 60:3">तंऐं पणैऊंअं हाम्हां का इहअ दाखो रस ज़ेते नशै टिम्भल़ुई करै धरनीं बधल़िआ।<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />ज़ुंण तेरी डरा हेठै रहा, तिन्‍नां लै दैनी तंऐं चतैनगी,</para>
  <para style="q" vid="PSA 60:4">ताकि तिंयां बरैबाद हणैं का बच़े।<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />हे परमेशर, तूह बच़ाऊ हाम्हां आपणैं महान बला करै,</para>
  <para style="q" vid="PSA 60:5">ज़हा लै तूह झ़ूरा, तिंयां लोल़ी तै बच़ै।<verse eid="PSA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />हे परमेशर, तूह आसा पबित्र अर तंऐं आसा इहअ बोलअ द,</para>
  <para style="q" vid="PSA 60:6">“मुंह हणीं शकेम नगरी बांडदा खुशी अर</para>
  <para style="q" vid="PSA 60:6">मुंह दैणीं सक्‍कोत सऊंऐं मुल्खे ज़ैगा नापी करै मेरी परज़ा लै बांडी।<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />गलाद आसा मेरअ अर मनिश्शे बी आसा मेरअ ई,</para>
  <para style="q" vid="PSA 60:7">एप्रैम देश आसा मेरअ टोप</para>
  <para style="q" vid="PSA 60:7">अर यहूदा आसा मेरै राज़ बलो नशाण।<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />पर मोआब आसा मेरअ हाथा धोणेंओ भांडअ,</para>
  <para style="q" vid="PSA 60:8">एदोमा लै शोटणअ मुंह आपणैं खूरो पोलल़अ नछ़ैण कि तेऊओ मालक आसा हुंह आप्पै।</para>
  <para style="q" vid="PSA 60:8">पलिश्ती कै इहअ सोठा कि तिन्‍नें हणीं ज़ै-ज़ैकार अर तिंयां कै मुखा ज़िती सका?”<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />“हे बिधाता, बडी-बडी उछ़टी दुआली आल़ी नगरी हुंह कहा पजैल़णअ?</para>
  <para style="q" vid="PSA 60:9">मुल्है एदोम देशे लोगा का ज़ीत कहा दैणीं?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />तंऐं कै हाम्हैं पठी डाहै शोटी?</para>
  <para style="q" vid="PSA 60:10">हे परमेशर, ऐबै कै तूह म्हारी सैना आजू-आजू हांढणअ निं आथी?<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />हे बिधाता, म्हारै दुशमणा का बच़णा लै कर म्हारी मज़त,</para>
  <para style="q" vid="PSA 60:11">किल्हैकि मणछे मज़त हआ बृथा!<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />ज़ै तूह परमेशर हाम्हां संघै होए, तै जाणैं हाम्हैं ज़िती,</para>
  <para style="q" vid="PSA 60:12">ताह हेरनै म्हारै दुशमण हारी।”<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">आपणीं फाज़त लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै तारा आल़ै बाज़ै दी राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />हे परमेशर, मेरी पकार शुण,</para>
  <para style="q" vid="PSA 61:1">मंऐं किई ताह सेटा अरज़, तूह दै तेतो ज़बाब!<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />मुखा निं ऐबै आशा ई शुझदी,</para>
  <para style="q" vid="PSA 61:2">हुंह मांगा ताखा आपणैं देशा का दूर रही लेर-पकार पाई मज़त।</para>
  <para style="q" vid="PSA 61:2">तूह बशैल़ मुंह तैहा बडी टोल्हा पिछ़ू ज़ेथ हुंह शरण लई सके।<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />मेरी शरण लणें ज़ैगा आसा तूह ई,</para>
  <para style="q" vid="PSA 61:3">मेरै दुशमणा का बच़णा लै उछ़टअ कोट बी आसा तूह ई।<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />मुंह दै आपणीं पबित्र ज़ैगा जुगै-जुगै तैणीं रहणैं,</para>
  <para style="q" vid="PSA 61:4">मुंह दै आपणैं फैंखा हेठै शरण लणैं।<verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />हे परमेशर तंऐं शूणीं मेरी मानता,</para>
  <para style="q" vid="PSA 61:5">तंऐं दैनअ मुल्है तिहअ फल ज़ुंण तेरी डरा हेठै रहणैं आल़ै भेटा।<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />राज़े अमर लोल़ी खास्सी हुई,</para>
  <para style="q" vid="PSA 61:6">सह लोल़ी पोस्ती दर पोस्ती ज़िऊंदअ रहअ।<note caller="+" style="f"><char style="fr" closed="false">61:6 </char><char style="ft" closed="false">सदा तेऊए ई खिंबा का राज़अ</char></note><verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />हे परमेशर, तेऊ लोल़ी सदा तेरी आछी सम्हनै राज़ किअ,</para>
  <para style="q" vid="PSA 61:7">तूह कर आपणीं अटल़ झ़ूरी अर सत्ता करै तेऊए फाज़त।<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />तेखअ करनी मुंह सदा तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 61:8">ज़ुंण मंऐं ताल्है मानत मनी सह बी करनी मुंह धैल़ पूरी।<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">परमेशर आसा झणैल़ू अर तेऊ का आसा सारअ बल</para>
  <para style="d">जदूतून, गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />हुंह डाहा सबर कि परमेशर हेरा बच़ाऊई,</para>
  <para style="q" vid="PSA 62:1">हुंह डाहा सिधअ तेऊओ ई भरोस्सअ।<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />मेरी फाज़त करनै आल़अ अर मुंह बच़ाऊंणै आल़अ आसा सह ई,</para>
  <para style="q" vid="PSA 62:2">सह आसा मुंह बच़णा लै उछ़टअ गहल़ अर</para>
  <para style="q" vid="PSA 62:2">तेखअ निं मुंह कोहै हारी सकदअ।<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />खास्सै मणछ आसा एकी मणछा पिछ़ू पल़ै दै,</para>
  <para style="q" vid="PSA 62:3">तिंयां सोभै च़ाहा मुंह मारी पाणअ।</para>
  <para style="q" vid="PSA 62:3">तिन्‍नां लै आसा हुंह ज़िहअ ढूल़ी दी दुआली अर फुक्‍कै दै बाल़ा ज़िहअ।<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />तिंयां च़ाहा मुंह मेरी अदरे पदबी का पोर्ही काढणअ,</para>
  <para style="q" vid="PSA 62:4">तिंयां झ़ूरा झ़ुठअ बोल़णा लै,</para>
  <para style="q" vid="PSA 62:4">खाखा का करा तिंयां बर्गत दैणें गल्‍ला पर</para>
  <para style="q" vid="PSA 62:4">दिलै आसा तिन्‍नें कपट।<verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />हुंह रहा परमेशरे आसरै अर</para>
  <para style="q" vid="PSA 62:5">हुंह डाहा तेऊ ई दी आशा।<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />मेरी फाज़त करनै आल़अ अर मुंह बच़ाऊंणै आल़अ आसा सह ई,</para>
  <para style="q" vid="PSA 62:6">सह आसा मुंह बच़णा लै उछ़टअ गहल़ अर</para>
  <para style="q" vid="PSA 62:6">तेखअ निं मुंह कोहै हारी सकदअ।<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />परमेशर दैआ मुल्है अदर अर उद्धार,</para>
  <para style="q" vid="PSA 62:7">सह आसा मुंह बच़ाऊंणै आल़अ अर</para>
  <para style="q" vid="PSA 62:7">मेरी शरण लणें ज़ैगा।<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />मेरै साथीओ, सदा डाहणअ परमेशरा दी भरोस्सअ,</para>
  <para style="q" vid="PSA 62:8">आपणीं सारी खरी खोज़णीं तेऊ का,</para>
  <para style="q" vid="PSA 62:8">म्हारी शरण लणें ज़ैगा आसा सह ई।<verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />मणछ आसा भाफा ज़िहै, थोल़ी घल़ी लै,</para>
  <para style="q" vid="PSA 62:9">कुंण होछ़अ कुंण बडअ समझ़णअ आसा बृथा।</para>
  <para style="q" vid="PSA 62:9">तराकल़ी दी निं तिन्‍नां कोहिओ किछ़ै बज़न आथी,</para>
  <para style="q" vid="PSA 62:9">तिंयां आसा सोभै शाहा का बी हल़कै।<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />ज़ुल्म करने आसरै निं रहणअ,</para>
  <para style="q" vid="PSA 62:10">च़ोरी-डकैती करदै शरेरै निं हणअ,</para>
  <para style="q" vid="PSA 62:10">च़ाऐ तम्हैं ज़ेतरै बी सेठ होए,</para>
  <para style="q" vid="PSA 62:10">तेते भरोस्सै बी निं रही।<verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />मंऐं शूणअ इहअ कि परमेशर बोला दूई गल्‍ला एही,</para>
  <para style="q" vid="PSA 62:11">“सारअ ज़ोर आसा मेरअ ई,<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />मेरी झ़ूरी आसा अटल़।”</para>
  <para style="q" vid="PSA 62:12">मालक दैआ हाम्हां सोभी लै म्हारै कामें साबै हाम्हां लै फल।<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">परमेशरे झ़ूरी आसा ज़िन्दगी का बढकर</para>
  <para style="d">राज़ै दाबेदो भज़न, ज़धू सह यहूदा रेगीस्तानै थिअ।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />हे बिधाता, तूह आसा मेरअ परमेशर,</para>
  <para style="q" vid="PSA 63:1">मेरअ मन्‍न रहा ताह ई बाखा लागी,</para>
  <para style="q" vid="PSA 63:1">मेरी झ़ूरा सारी देही ताल्है ई,</para>
  <para style="q" vid="PSA 63:1">ज़ेही पाणीं बाझ़ी शुक्‍की ज़िम्मीं,</para>
  <para style="q" vid="PSA 63:1">तेही आसा मेरी आत्मां ताल्है नचिशी।<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />मंऐं भाल़ी तेरी पबित्र ज़ैगा</para>
  <para style="q" vid="PSA 63:2">तेरअ बल अर तेरअ महान धुप्पअ।<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />तेरी झींण आसा मुल्है मेरी ज़िन्दगी का बी पैरी,</para>
  <para style="q" vid="PSA 63:3">मुंह करनी तेरी ई बड़ैई।<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />मुंह रहणअ सारी अमरा तेरअ शूकर करदै लागी,</para>
  <para style="q" vid="PSA 63:4">मुंह फुआरनी अरज़ करना लै उझै ताह बाखा बाहा।<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />तूह रज़ैऊआ मुंह बधिया का बधिया खाणैं पिणैं का खास्सअ,</para>
  <para style="q" vid="PSA 63:5">मुंह बोल़णीं खुशी-खुशी तेरी ज़ै-ज़ैकारे गिहा।<verse eid="PSA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />सुत्तणै का आजी करा हुंह ताह आद,</para>
  <para style="q" vid="PSA 63:6">सारी राची रहा हुंह तेरै बारै सोठदअ लागी।<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />किल्हैकि तंऐं किई सदा मेरी मज़त,</para>
  <para style="q" vid="PSA 63:7">तेरै फैंखे छ़ैल्‍ली दी रही करनी मुंह तेरी खुशी-खुशी ज़ै-ज़ैकार।<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />हुंह रहा ताह ई पिछ़ू ढाखुई,</para>
  <para style="q" vid="PSA 63:8">तूह डाहा मुंह आपणैं हाथै ढाकी राज्ज़ी-राम्बल़अ।<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />ज़ुंण मुंह मारना लै आसा ताखुऐ दै,</para>
  <para style="q" vid="PSA 63:9">तिंयां डेऊणैं उंधै न्हैरी जम्परी।<verse eid="PSA 63:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10" />तिंयां मरनै जुधा दी तलबारा करै,</para>
  <para style="q" vid="PSA 63:10">तिन्‍नें ल्हासा खाणीं शैल़ी अर बणें ज़ीबा।<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />किल्हैकि ताह म्हारै परमेशरा दैणीं राज़ै लै ज़ीत,</para>
  <para style="q" vid="PSA 63:11">ताह करै मनाऊंणी तेऊ खुशी।</para>
  <para style="q" vid="PSA 63:11">ज़ुंण बिधाते नाओंऐं ज़बान दैए,</para>
  <para style="q" vid="PSA 63:11">तिन्‍नां करनी तेऊए बड़ैई,</para>
  <para style="q" vid="PSA 63:11">पर शल़ैघा घल़णै आल़ेए खाखा हणीं बंद।<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">फाज़त करना लै बिधाता का अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />हे परमेशर, मुंह पल़ी बेघै खरी, मेरी अरज़ शुण!</para>
  <para style="q" vid="PSA 64:1">मुंह लागी मेरै दुशमणा का डअर, तूह बच़ाऊ ऐबै मेरी ज़िन्दगी!<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />इना कबध खटणै आल़ी टोली का अर</para>
  <para style="q" vid="PSA 64:2">इना कदुष्ट मणछे उपद्रभा का बच़ाऊ मुंह।<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />तिंयां करा आपणीं ज़िभा तलबारा ज़ेही तिछी,</para>
  <para style="q" vid="PSA 64:3">तिन्‍नें कल़ुऐ बोल च़ुभा ज़िहै कतीरा ज़िहै।<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />तिंयां हेरा झ़ट च़ारै झ़ुठी गल्‍ला फणाऊंई,</para>
  <para style="q" vid="PSA 64:4">झ़ुठी फुआह पाई करा तिंयां भलै मणछा बरैबाद।<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />तिंयां दैआ एकी-दुजै लै बूरै करना लै शैह,</para>
  <para style="q" vid="PSA 64:5">तिंयां रहा आप्पू मांझ़ै इना ई गल्‍ला करदै कि किधी ज़ेही डाहणीं फाही पाई।</para>
  <para style="q" vid="PSA 64:5">तिंयां बोला इहअ, “हाम्हैं निं कोही लाऐ भाल़ी!”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />तिंयां सोठा बूरी बिक्री संघा बोला आप्पू मांझ़ै इहअ,</para>
  <para style="q" vid="PSA 64:6">“अह सोठी बै हाम्हैं राम्बल़ी बिक्री,</para>
  <para style="q" vid="PSA 64:6">कोही मणछा का निं थोघै कि हाम्हैं किज़ै सोठा।”<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />पर हे परमेशर, ताह छ़ाडणैं आप्पै तिन्‍नां लै तिछै कतीर,</para>
  <para style="q" vid="PSA 64:7">तिंयां बधल़णैं नभैऊशै धरनीं।<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />ताह करनै तिंयां तिन्‍नें ई गल्‍ला करै बरैबाद,</para>
  <para style="q" vid="PSA 64:8">होरी लोगा बी छ़ुटणअ तिन्‍नें हालत भाल़ी दर्छ़णअ।<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />तेखअ पल़णीं सोभी मणछा डअर,</para>
  <para style="q" vid="PSA 64:9">तेखअ सोठणअ तिन्‍नां कि बिधाता किज़ै आसा किअ द,</para>
  <para style="q" vid="PSA 64:9">अर होरी का बी खोज़णअ तिन्‍नां कि बिधाता किज़ै काम आसा किअ द।<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />ज़ुंण काम बिधाता किअ,</para>
  <para style="q" vid="PSA 64:10">तेता करै हणीं सोभी धर्मीं मणछा खुशी।</para>
  <para style="q" vid="PSA 64:10">तिन्‍नां भेटणीं तेऊ सेटा शरण,</para>
  <para style="q" vid="PSA 64:10">भलै मणछा करनी तेऊए ज़ै-ज़ैकार।<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">बिधाते ज़ै-ज़ैकार अर शूकर</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />हे परमेशर, हाम्हां लै शोभा सियोन तेरी ज़ै-ज़ैकार करनी,</para>
  <para style="q" vid="PSA 65:1">अर हाम्हैं तेरी मानत पूरी करे,<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />किल्हैकि तूह शूणां म्हारी प्राथणां।</para>
  <para style="q" vid="PSA 65:2">सोभ लोग एछणैं ताह ई सेटा।<note caller="-" style="x"><char style="xo" closed="false">65:2 </char><char style="xt" closed="false"><ref loc="ACT 10:34-35">शधा. 10:34-35</ref>; <ref loc="ISA 66:23">ईशा. 66:23</ref></char></note><verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />म्हारै घोर पापा करै दाभूऐ हाम्हैं,</para>
  <para style="q" vid="PSA 65:3">हाम्हैं गऐ म्हारी गलती करै हारी,</para>
  <para style="q" vid="PSA 65:3">पर ताह हेरनी हाम्हां लै माफी छ़ाडी।<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />ज़ुंण तंऐं आसा छ़ांटै दै, तिन्‍नां लै दैआ तूह बर्गत,</para>
  <para style="q" vid="PSA 65:4">तिन्‍नां दैआ तूह आपणीं पबित्र ज़ैगा बस्सणै।</para>
  <para style="q" vid="PSA 65:4">हाम्हां करनी तेरै घअरै रही नंद,</para>
  <para style="q" vid="PSA 65:4">तेरै पबित्र भबने बर्गता भेटणीं हाम्हां रज्ज़ी।<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />ए म्हारै परमेशर, तंऐं बच़ाऊऐ हाम्हैं,</para>
  <para style="q" vid="PSA 65:5">तंऐं दैनअ हाम्हां ज़ताऊई करै म्हारी प्राथणों ज़बाब।</para>
  <para style="q" vid="PSA 65:5">सारै संसारे मणछ अर दूर समुंदरे बाढै रहणैं आल़ै</para>
  <para style="q" vid="PSA 65:5">लोग करा ताह ई प्रैंदै भरोस्सअ।<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />तंऐं आसा बडै-बडै पर्बत आपणैं ज़ोरा करै बशैल़ै दै,</para>
  <para style="q" vid="PSA 65:6">तेता करै लागा तेरै महान बलो थोघ।<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />तूह करा क्रुंगदै समुंदरे बडी-बडी छ़ाल्‍ली,</para>
  <para style="q" vid="PSA 65:7">अर देशा-देशे लोगे हाल्‍लै-गोल्‍लै</para>
  <para style="q" vid="PSA 65:7">अर झांशा-त्रुंगा आप्पै शांत।<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />ज़ुंण तंऐं महान काम किऐ, तेता भाल़ी हुऐ</para>
  <para style="q" vid="PSA 65:8">संसारे सोभै लोग हक्‍कै-बक्‍कै।</para>
  <para style="q" vid="PSA 65:8">ज़ेतरै बी संसारै लोग रहा</para>
  <para style="q" vid="PSA 65:8">तिन्‍नां करनी तेरै इना कामां भाल़ी गिहा बोली ज़ै-ज़ैकार।<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />तूह करा सारी पृथूईए फाज़त,</para>
  <para style="q" vid="PSA 65:9">सरगा का पाणीं दैई डाहा तूह धरती दी बाच ताकि सह रज़दी-पज़दी रहे,</para>
  <para style="q" vid="PSA 65:9">तूह निं गाडा-नाल़ी शुक्‍कणैं दैंदअ,</para>
  <para style="q" vid="PSA 65:9">तूह करा धरती एही कि तेथ खास्सअ नाज़ पज़े।<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />बाहै दै खेचे सिया लै बरशाऊआ तूह सरग,</para>
  <para style="q" vid="PSA 65:10">संघा डाहा तेता पाणीं करै राम्बल़ै भेऊई,</para>
  <para style="q" vid="PSA 65:10">तेता करै करा तूह धरनीं माट्टी नरम,</para>
  <para style="q" vid="PSA 65:10">संघा लागा तेथ बधिया टिप्परू।<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />धरती दी ज़िधी बी तूह हांढा,</para>
  <para style="q" vid="PSA 65:11">तिधी हआ ज़बर साल-फसल।<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />बणैं-बूटै घैहणीं हआ हरी-भरी</para>
  <para style="q" vid="PSA 65:12">अर उछ़टी धारा हआ खील-फूला करै भरी खुश।<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />घैहणीं हआ भेडा-बाकरीए हेल़्ही करै भरी,</para>
  <para style="q" vid="PSA 65:13">खागै-खागै हआ ज़बर फसल,</para>
  <para style="q" vid="PSA 65:13">तिंयां करा खुशी दी तेरी गिहा बोली तेरी ज़ै-ज़ैकार।<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">परमेशरे महान कामां लै करा तेऊए ज़ै-ज़ैकार</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />संसारे मणछो, ज़ोरै-ज़ोरै करा परमेशरे ज़ै-ज़ैकार!<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />तेऊए नाओंए गिहा बोला,</para>
  <para style="q" vid="PSA 66:2">तेऊए स्तोती अर ज़ै-ज़ैकार करा!<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />परमेशरा लै बोला इहअ, “तेरै काम भाल़ किहै महान आसा!</para>
  <para style="q" vid="PSA 66:3">ताखा आसा महान बल अर</para>
  <para style="q" vid="PSA 66:3">तेरै दुशमण पल़णै तेरै च़रणैं।<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />तेरी ज़ै-ज़ैकार करनी संसारे सोभी लोगा,</para>
  <para style="q" vid="PSA 66:4">तिन्‍नां बोल़णीं तेरै नाओंए गिहा अर</para>
  <para style="q" vid="PSA 66:4">भज़न बोली करनी तिन्‍नां तेरी ज़ै-ज़ैकार।”<verse eid="PSA 66:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />एछा, संघा दैआ भाल़णीं कि परमेशरै</para>
  <para style="q" vid="PSA 66:5">मणछा लै किहै-किहै महान काम किऐ।<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />बिधाता बणाईं समुंदर दूई बाखा करी मांझ़ा-मांझ़ी शुक्‍की ज़ैगा,</para>
  <para style="q" vid="PSA 66:6">म्हारै दादै-बाबै टपअ समुंदर ज़ांघा हांढी।</para>
  <para style="q" vid="PSA 66:6">तिधी हुऐ तेऊए महान कामां भाल़ी हाम्हैं नाच़णै जोगी खुशी।<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />सह करा आपणैं महान बला करै सदा राज़ अर</para>
  <para style="q" vid="PSA 66:7">सह रहा देशा-देशे लोगा भाल़अ लागी।</para>
  <para style="q" vid="PSA 66:7">तेऊ लै निं द्रोह करदै लागी आथी।<verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />देशा-देशे लोगो म्हारै परमेशरे करा ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 66:8">तेऊए ज़ै-ज़ैकार करा राग-भज़न बोली।<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />तेऊ आसा हाम्हैं ज़िऊंदै डाहै दै अर</para>
  <para style="q" vid="PSA 66:9">सह निं हाम्हां फिशल़णैं दैंदअ।<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />हे परमेशर, तंऐं ज़ाच़ै-परखै हाम्हैं राम्बल़ै करै,</para>
  <para style="q" vid="PSA 66:10">तंऐं परखै हाम्हैं तिहै ज़ेही</para>
  <para style="q" vid="PSA 66:10">आगी जैंदरी झमाऊंईं करै च़ंदी परखा।<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />तंऐं दैनअ हाम्हां आपणैं ज़ज़ाल़ा दी शाचणैं,</para>
  <para style="q" vid="PSA 66:11">म्हारी पिठी डाहअ तंऐं गर्कअ बोझ़अ।<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />तंऐं दैनअ दुशमणा म्हारअ मूंड झेचणैं,</para>
  <para style="q" vid="PSA 66:12">हाम्हैं हांढै आगी अर पाणींए हर्हला बाती,</para>
  <para style="q" vid="PSA 66:12">पर ऐबै पजैल़ै तंऐं हाम्हैं एही ज़ैगा ज़िधी हाम्हैं राज्ज़ी-मौज़ी रही सके।<verse eid="PSA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />मुंह आणनीं तेरै घअरा लै हूम बल़ी,</para>
  <para style="q" vid="PSA 66:13">मंऐं ज़ुंण मानत मनी सह करनी मुंह पूरी।<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />आफ़ते पलका मंऐं ज़ुंण मानत मनी ती,</para>
  <para style="q" vid="PSA 66:14">सह लणी मुंह ताल्है दैई।<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />मुंह करनअ हेल़्ही मांझ़ा का बडअ रिठ तेरी बेदी दी हूम बल़ी,</para>
  <para style="q" vid="PSA 66:15">गाभू-छ़ेल्हूए च़र्बीओ हूम करी</para>
  <para style="q" vid="PSA 66:15">लोल़ी तेतो धूँ उझै सरगा बाखा लै डेऊअ।<verse eid="PSA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />परमेशरे डरा हेठै रहणैं आल़ै लोगो,</para>
  <para style="q" vid="PSA 66:16">हुंह खोज़ूं तम्हां का कि परमेशरै मुल्है किज़ै-किज़ै किअ।<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />मंऐं मांगी लेर-पकार पाई परमेशरा का अरज़,</para>
  <para style="q" vid="PSA 66:17">गिहा बोली किई मंऐं तेऊए ज़ै-ज़ैकार।<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />ज़ै मेरी सोठ बृथा अर पाप करने हंदी,</para>
  <para style="q" vid="PSA 66:18">तै किल्है लाई ती मालकै मेरी अरज़ शूणीं।<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />पर परमेशरे हेरी मेरी अरज़ शूणीं,</para>
  <para style="q" vid="PSA 66:19">तेऊ दैनअ मेरी गल्‍ला दी धैन।<verse eid="PSA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />मुंह करनी परमेशरे ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 66:20">किल्हैकि तेऊ शूणीं मेरी अरज़,</para>
  <para style="q" vid="PSA 66:20">सह निं मुल्है झींण करनै का पिछ़ू हटअ।<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">बिधातो शूकर करना लै भज़न</para>
  <para style="d">तारा आल़ै बाज़ै संघै गाज़ै-बाज़ै आल़ेए सैणैं लै भज़न, गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />हे बिधाता, हाम्हां लै दै जश अर बर्गत,</para>
  <para style="q" vid="PSA 67:1">हाम्हां बाखा भाल़ हास्सदी अर प्रैश्शै मुंहैं।<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />सारै संसारा का लोल़ी थोघ लागअ कि तूह किज़ै च़ाहा,</para>
  <para style="q" vid="PSA 67:2">सोभी देशा का लोल़ी हाम्हां बच़ाऊंणे तेरी तागत शुझुई।<note caller="-" style="x"><char style="xo" closed="false">67:2 </char><char style="xt" closed="false"><ref loc="LUK 2:30">लूक. 2:30</ref></char></note><verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />हे बिधाता, सोभी देशे लोगै लोल़ी तेरी ज़ै-ज़ैकार किई,</para>
  <para style="q" vid="PSA 67:3">अर सोभी लोल़ी तेरअ शूकर किअ।<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />सोभी देशै लोल़ी तेरी ज़ै-ज़ैकारे भज़न बोलै,</para>
  <para style="q" vid="PSA 67:4">किल्हैकि तंऐं किअ सोभी लोगो नसाफ,</para>
  <para style="q" vid="PSA 67:4">अर सोभी देशा लै सलाह बी दैआ तूह ई।<verse eid="PSA 67:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />हे बिधाता, सोभी देशे लोगै लोल़ी तेरी ज़ै-ज़ैकार किई,</para>
  <para style="q" vid="PSA 67:5">अर सोभी लोल़ी तेरअ शूकर किअ।<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />ज़ैगा-ज़िम्मीं हेरी फसल दैई,</para>
  <para style="q" vid="PSA 67:6">म्हारै परमेशर बिधाता दैनी हाम्हां लै बर्गत।<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />आजू बी भेटणीं हाम्हां बिधाता का बर्गत ई,</para>
  <para style="q" vid="PSA 67:7">संसारे सोभी लोगै लोल़ी बिधातो अदर किअ।<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">बिधाता हेरनअ जुध ज़िती</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />हे बिधाता, ऐबै कर तूह किज़ै! इना दुशमणा खद्रेल़ पोर्ही,</para>
  <para style="q" vid="PSA 68:1">ईंयां दुशमण ज़ुंण ताखा नफरत करा, ईंयां लोल़ी ज़िहै आऐ तिहै ई बापस ठुर्है।<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />इना कदुष्टा फर्ल़ाऊ धूँआं ज़िहै!</para>
  <para style="q" vid="PSA 68:2">ताह नेल़ एछी लोल़ी ईंयां इहै गल़ै</para>
  <para style="q" vid="PSA 68:2">ज़िहअ आगीए सेका करै घिऊ गल़ा।<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />पर धर्मीं मणछ लोल़ी ताह सेटा राज्ज़ी-मौज़ी रहै,</para>
  <para style="q" vid="PSA 68:3">तिन्‍नैं लोल़ी हास्सदी खेल्हदी तेरी ज़ै-ज़ैकार किई।<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />ए म्हारै परमेशर, तूह आसा सह ई ज़ुंण बादल़ा प्रैंदै शुंआर हआ,</para>
  <para style="q" vid="PSA 68:4">ताह नाअं आसा बिधाता,</para>
  <para style="q" vid="PSA 68:4">हाम्हैं मनाऊंआं तेरी खुशी, संघा करा तेरी ज़ै-ज़ैकार।<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />परमेशर, तूह रहा आपणैं पबित्र घअरै<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="fq" closed="false">पबित्र घअरै </char><char style="ft" closed="false">स्वर्गै </char></note>,</para>
  <para style="q" vid="PSA 68:5">तूह करा छ़ुटै-मुक्‍कै दै अर बिधबा बेटल़ीओ नसाफ।<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />ज़ुंण कल्ही आसा, तूह बसाऊआ तिन्‍नों घअर,</para>
  <para style="q" vid="PSA 68:6">कैद किऐ दै मणछा करा तूह आज़ाद।</para>
  <para style="q" vid="PSA 68:6">पर द्रोही लोगा लागणअ शुन्‍नैं रेगीस्तानै रहणअ।<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />ज़ांऊं तंऐं आपणीं परज़ा आज़ाद किई अर</para>
  <para style="q" vid="PSA 68:7">उज़र रेगीस्ताना बाती आजू नढैऊऐ,<verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />पृथूई दी हुई ज़ाज़री अर</para>
  <para style="q" vid="PSA 68:8">उझै का छ़ुटअ सरग,</para>
  <para style="q" vid="PSA 68:8">किल्हैकि तूह इज़राईलीओ परमेशर बिधाता ज़ुंण सीनाई धारा प्रैंदा का राज़ करा,</para>
  <para style="q" vid="PSA 68:8">तेरै डरै छ़ुटी तिन्‍नां काम्मणीं।<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />हे बिधाता, तंऐं दैनअ सरगा का रज्ज़ी पाणीं,</para>
  <para style="q" vid="PSA 68:9">तेता करै किई तंऐं आपणीं ज़ैगा भिई हरी-भरी।<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />तेरी टोली लागी खिरी तिधी रहंदी बस्सदी,</para>
  <para style="q" vid="PSA 68:10">तंऐं दैनी तिन्‍नां लै खुल्है दिलै सोभै गल्‍ला।<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />तंऐं किअ हुकम अर</para>
  <para style="q" vid="PSA 68:11">बेटल़ीए छ़ुंढे-छ़ुंढ लागी तेरै महान कामें बारै सोभी का इहअ खोज़दी,<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />“दुशमण राज़ै ठुर्है डरै आपणीं-आपणीं सैना संघी!”</para>
  <para style="q" vid="PSA 68:12">बेटल़ी ज़ुंण जुधे बगती घअरै हआ, तिन्‍नैं बी बांडी लुटी दी माया:<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />च़ंदी करै महल़ै दै कबूतर ज़ेते फैंख च़ोखै सुन्‍नें आसा तै!</para>
  <para style="q" vid="PSA 68:13">तैबी बी किल्है आसा तम्हां मांझ़ै कई ज़ण्हैं जुधे बगती भडैल़ै रहै दै लुक्‍की?<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />परमेशर बिधाता ज़हा का सारअ बल आसा, ज़ांऊं तेऊ राज़ै खद्रेल़ै,</para>
  <para style="q" vid="PSA 68:14">सह पल़अ ज़िहअ सलमोन ज़ोता प्रैंदै हिंअं।<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />बाशान धार आसा महान</para>
  <para style="q" vid="PSA 68:15">तेथ आसा कई उछ़टी-उछ़टी ज़ोता।<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />ज़हा धारा बिधाता आपणअ बसेरअ किअ</para>
  <para style="q" vid="PSA 68:16">अर ज़िधी तेऊ सदा रहणअ,</para>
  <para style="q" vid="PSA 68:16">तेता भाल़ी होरी धारा किल्है लागी ज़ल़ण हंदी?<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />ज़ेभै मालक बिधाता सीनाई पबित्र धारा आपणीं परज़ा लै प्रगट हणअ,</para>
  <para style="q" vid="PSA 68:17">तेऊ संघै हणैं हज़ारो रथ।<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />ज़ेभै बिधाता उझै उछ़टै लै डेऊअ,</para>
  <para style="q" vid="PSA 68:18">तेऊ निंणै आप्पू संघै कई कैदी मणछ बी,</para>
  <para style="q" vid="PSA 68:18">तेऊ ढाकणीं हठू मणछे भैंट बी।</para>
  <para style="q" vid="PSA 68:18">बिधाता रहणअ सदा लै तिधी।<verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />ए म्हारै मालक, हाम्हां करनी तेरी ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 68:19">तूह रहा हाम्हां लै हर धैल़ै झणैल़ू,</para>
  <para style="q" vid="PSA 68:19">परमेशर, तंऐं आसा हाम्हैं बच़ाऊई डाहै दै।<verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />हे बिधाता, म्हारै मालक, तूह करा कबल्‍ली म्हारी फाज़त,</para>
  <para style="q" vid="PSA 68:20">हे परमेशर, तंऐं आसा हाम्हैं मरनै का बच़ाऊई डाहै दै।<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />ए म्हारै बिधाता, ज़ुंण आपणैं पापी कामां नांईं छ़ाडदै,</para>
  <para style="q" vid="PSA 68:21">तिन्‍नें फाल़णीं ताह ताल़ू-तुंबी।<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />हे मेरै मालक, तंऐं आसा आप्पै इहअ बोलअ द, “मुंह आणनैं थारै दुशमण बाशान धारा का बापस फरेऊई,</para>
  <para style="q" vid="PSA 68:22">तिंयां च़ाऐ समुंदरे थाल्‍लै किल्है निं होए पुजै दै, तिधा का बी पजैल़णैं मुंह तिंयां बापस!<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />ताकि तम्हैं तिन्‍नें लोहू जैंदरी आपणीं गंईं डाहे अर</para>
  <para style="q" vid="PSA 68:23">थारै कुक्‍कर तिन्‍नों मास्स रज्ज़ी खाए।”<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />हे बिधाता, तेरअ फेर निखल़दअ भाल़अ सोभी,</para>
  <para style="q" vid="PSA 68:24">परमेशर तूह ज़ुंण म्हारअ राज़अ आसा, तेरअ फेर हुअ तेरी पबित्र ज़ैगा पूरअ।<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />गिहा लाणैं आल़ै लागै आजू हांढदै अर बाज़णैं आल़ै पिछ़ू,</para>
  <para style="q" vid="PSA 68:25">तिन्‍नां मांझ़ै थिई कुंआरी शोहरी डफली बाज़दी लागी दी हांढदी।<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />तिंयां ती इज़राईली मणछा लै इहअ बोल्दी लागी दी,</para>
  <para style="q" vid="PSA 68:26">“ज़सरअ मूल़ इज़राईल आसा, तिंयां करा बिधाते ज़ै-ज़ैकार!”<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />बिन्यामीन ज़ुंण सोभी का होछ़अ गोत्र आसा, सह हांढा सोभी का आजू,</para>
  <para style="q" vid="PSA 68:27">तेता बाद यहूदा गोत्रो सैणअ आपणैं दला संघै।</para>
  <para style="q" vid="PSA 68:27">तिन्‍नां पिछ़ू ज़बलून अर नप्ताली गोत्रे सैणैं आपणैं-आपणैं दला संघै।<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />हे बिधाता, आपणअ बल रहैऊ,</para>
  <para style="q" vid="PSA 68:28">ज़िहअ तंऐं पैहलै बी आपणैं तेऊ भबना का<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />बल रहैऊअ ज़ुंण एरुशलेम नगरी आसा</para>
  <para style="q" vid="PSA 68:29">अर ज़िधी ताल्है पृथूईए राज़ै भैंट पजैल़णीं।<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />मिसर ज़ुंण बणें बडै ज़ीबा ज़िहअ नगाल़ै जैंदरी आसा, तेऊ दै नैरनीं,</para>
  <para style="q" vid="PSA 68:30">तेऊ देशा दै नैरनीं ज़ेते सैणैं अर लोग बणें म्हैशै ज़िहै आसा!</para>
  <para style="q" vid="PSA 68:30">तिंयां लोल़ी च़ंदी हाथै भैंट ढाकी धरनीं पेटा करै हांढी ताह सेटा माथअ टेक्‍कअ।</para>
  <para style="q" vid="PSA 68:30">ज़ुंण देश झ़गल़ै लै झ़ूरा, तिन्‍नां खद्रेल़ ओर्ही-पोर्ही।<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />मिसर देशा का एछणैं राज़दूत,</para>
  <para style="q" vid="PSA 68:31">कूश देशे लोगो परमेशरे ज़ै-ज़ैकार करना लै करा बाह खल़ी।<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />पृथूई दी देशै-देशै राज़ करनै आल़ै राज़ैओ,</para>
  <para style="q" vid="PSA 68:32">तम्हैं सोभै बोला सोभिए मालक बिधाते भज़न।<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />ज़ुंण बिधाता सोभी सरगा प्रैंदी पोर्ही हांढा,</para>
  <para style="q" vid="PSA 68:33">तेऊए बैण शूणां, सह आसा किज़ै बोल्दअ लागअ द।<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />परमेशरे ज़ोरे बारै खोज़ा सोभी का!</para>
  <para style="q" vid="PSA 68:34">इज़राईली जैंदरी हआ तेऊओ अदर अर</para>
  <para style="q" vid="PSA 68:34">सारै भ्रमंडै करा सह राज़।<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />हे बिधाता, तेरी पबित्र ज़ैगा लोल़ी तेरी डअर रही,</para>
  <para style="q" vid="PSA 68:35">तूह ज़ुंण हाम्हां इज़राईलीओ परमेशर आसा,</para>
  <para style="q" vid="PSA 68:35">तूह दैआ आपणीं परज़ा लै बल अर तागत।</para>
  <para style="q" vid="PSA 68:35">परमेशरे लोल़ी सदा ज़ै-ज़ैकार हुई।<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">खरीए पलका बिधाता का मज़त</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदे शोशन्‍नीम रागा दी गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />हे बिधाता, मुंह बच़ाऊ डुबणै का,</para>
  <para style="q" vid="PSA 69:1">पाणीं गअ गल़ै तैणीं पुजी,<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />घणैं च़िक्‍करै जैंदरी लागअ हुंह उंधै ई डुबदअ,</para>
  <para style="q" vid="PSA 69:2">धरनीं निस्सअ पाक्‍कअ थह ई भेटी!</para>
  <para style="q" vid="PSA 69:2">हुंह पुजअ ऐबै डुघै पाणीं जैंदरी,</para>
  <para style="q" vid="PSA 69:2">छ़ाल्‍ली आणअ हुंह तेतरी डबेऊई।<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />हुंह थक्‍कअ हाक्‍का लाई,</para>
  <para style="q" vid="PSA 69:3">अर ऐबै शुक्‍कअ मेरअ गअल़ बी।</para>
  <para style="q" vid="PSA 69:3">ताह न्हैल़ी-न्हैल़ी फिरी मेरी आछी बी पाल्‍ली</para>
  <para style="q" vid="PSA 69:3">कि तूह बिधाता जाणअ मेरी मज़त करदअ एछी।<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />ज़ुंण मुंह संघै थोघै बाझ़ी ज़ीद डाहा,</para>
  <para style="q" vid="PSA 69:4">तिंयां आसा गणी करै मेरै मुंडे शराल़ा का बी खास्सै।</para>
  <para style="q" vid="PSA 69:4">मेरै तिंयां दुशमण बोला मेरै बारै झ़ुठअ,</para>
  <para style="q" vid="PSA 69:4">तिंयां आसा खास्सै ज़ोरा आल़ै अर तिंयां च़ाहा मुंह मारी पाणअ।</para>
  <para style="q" vid="PSA 69:4">तिंयां बोला मुल्है एही च़ीज़ बापस फरेऊई दैणा लै ज़ुंण मंऐं कधू च़ोरी ई निं आथी!<verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />हे बिधाता, ताखा आसा थोघ कि हुंह किहअ ऐडअ आसा,</para>
  <para style="q" vid="PSA 69:5">ताखा किज़ू गल्‍ले च़ोरी लाई करी, ताखा आसा मेरै पाप-दोशो बी थोघ।<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />स्वर्गे सारी सैने मालक बिधाता,</para>
  <para style="q" vid="PSA 69:6">तूह करा इज़राईला दी राज़,</para>
  <para style="q" vid="PSA 69:6">ज़ुंण ताह दी भरोस्सअ डाहा अर तेरी च़ाकरी करा,</para>
  <para style="q" vid="PSA 69:6">तिन्‍नां जैंदरी निं मुंह शर्मिंदै दैई हणैं।<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />ताह ई पिछ़ू हुअ हुंह बेइज़त अर</para>
  <para style="q" vid="PSA 69:7">तैही पल़अ मुंह शर्मिंदै हणअ।<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />मेरै आपणैं भाई-बंध बी करा इहअ दखाअ कि तिंयां निं मुंह बछ़ैणदै ई आथी,</para>
  <para style="q" vid="PSA 69:8">तिंयां करा मुंह संघै परदेसी ज़िहअ बभार।<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />तेरै पबित्र भबना लै झ़ूरा हुंह इहअ कि मेरै दिलै हआ आग लागी दी,</para>
  <para style="q" vid="PSA 69:9">हे परमेशर, ज़ेभै होर ताह बेइज़त करा, तेभै हआ हुंह बी शर्मिंदअ।<verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />हुंह रहअ कई बारी लेरदअ लागी अर ब्रतू,</para>
  <para style="q" vid="PSA 69:10">लोगै किअ हुंह तज़ी बी बेइज़त।<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />मंऐं किअ खिंथल़ै बान्हीं शोग अर</para>
  <para style="q" vid="PSA 69:11">लोग लागै मुल्है हास्सदै अर सुहांगा करदै।<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />नगरीए प्रऊल़ी सेटा पाई तिन्‍नैं मेरै बारै सारै दी फुआह अर</para>
  <para style="q" vid="PSA 69:12">शूरी-शराबी तोही गांठी मेरै सुहांगा करना लै गिह।<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />पर बिधाता, हुंह करा ताह सेटा अरज़,</para>
  <para style="q" vid="PSA 69:13">ज़िहअ ताह ठीक लागा तेभै दैऐ तूह एतो ज़बाब।</para>
  <para style="q" vid="PSA 69:13">ताह हुअ ज़बाब दैणअ किल्हैकि तूह झ़ूरा खास्सअ,</para>
  <para style="q" vid="PSA 69:13">अर तंऐं आसा ज़बान दैनी दी कि ताह हेरनअ हुंह बच़ाऊई।<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />मुंह घणैं च़िक्‍करे गारी जैंदरी डुबणै निं दैई,</para>
  <para style="q" vid="PSA 69:14">तूह डाह मुंह मेरै दुशमणा का बच़ाऊई,</para>
  <para style="q" vid="PSA 69:14">डुघै पाणीं जैंदरी डुबणै का करै मेरी फाज़त।<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />दरैऊए हर्हलै निं लोल़ी हुंह उंधै घर्होहल़अ,</para>
  <para style="q" vid="PSA 69:15">नां हुंह डुघै पाणीं दी लोल़ी डुबअ अर</para>
  <para style="q" vid="PSA 69:15">नां हुंह किधी दाभूअ लोल़ी कि मेरी मौत होए।<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />हे बिधाता, तूह दै मुल्है ज़बाब, तूह आसा भलअ अर तूह करा झींण।</para>
  <para style="q" vid="PSA 69:16">मुंह बाख दै धैन! तूह आसा खास्सअ झणैल़ू।<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />तूह निं मुंह बाखा पिठ फरेऊई, हुंह तेरअ दास आसा आफ़ता दी पल़अ द।</para>
  <para style="q" vid="PSA 69:17">ऐबै निं न्हैल़अ लागै, मेरी मज़त लअ करी।<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />ऐबै लअ मुंह सेटा एछी मुंह बच़ाऊई</para>
  <para style="q" vid="PSA 69:18">मुंह लोल़ी मेरै दुशमणा का छ़ुटकारअ भेटअ।<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />ताखा आसा थोघ कि हुंह किहअ बेइज़त हुअ,</para>
  <para style="q" vid="PSA 69:19">मेरै किहै-किहै सुहांग किऐ,</para>
  <para style="q" vid="PSA 69:19">तिन्‍नां शर्मिंदै करनै आल़ै मेरै दुशमणो बी आसा ताखा थोघ।<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />बेइज़ती आणअ हुंह इहअ हारी-मारी कि हुंह हुअ बेगरअ।</para>
  <para style="q" vid="PSA 69:20">मेरी ती एही आशा कि कुंण एक ता झ़ूरदअ मुल्है</para>
  <para style="q" vid="PSA 69:20">पर तेथ निं एक बी भेटअ अर</para>
  <para style="q" vid="PSA 69:20">नां कुंण भलअ चिंजणै आल़अ निखल़अ।<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />भुखे पलका पाअ मेरै दुशमणै मेरी रोटी दी बिश अर</para>
  <para style="q" vid="PSA 69:21">ज़ेभै हुंह नचिशअ थिअ, तेभै दैनअ तिन्‍नैं मिल्‍लअ रस।<verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />तिन्‍नें रोटी लोल़ी ती तिन्‍नां ई लै फाही हुई,</para>
  <para style="q" vid="PSA 69:22">तिन्‍नें धामा करै लोल़ी तै तिंयां सोभै बरैबाद हुऐ।<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />तिंयां लोल़ी ए आछिए कांणै हुऐ!</para>
  <para style="q" vid="PSA 69:23">अर तिंयां लोल़ी तै मुंह सदा कुंगल़ै रहै फिरी।<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />आपणअ सारअ रोश्श काढ तूह तिन्‍नां प्रैंदै,</para>
  <para style="q" vid="PSA 69:24">तेरै रोश्शा करै लोल़ी तिंयां दझ़ै।<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />तिन्‍नें डेरै लोल़ी बरैबाद हुऐ अर</para>
  <para style="q" vid="PSA 69:25">तिन्‍नें खिम्भा दी निं लोल़ी कोह ज़िऊंदअ रहअ।<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />किल्हैकि तिंयां हआ तेऊ मणछा छेऊंदै लागै दै ज़हा लै तंऐं सज़ा दैई हआ हेरी दी,</para>
  <para style="q" vid="PSA 69:26">ज़ुंण तेरी दाह ज़िरदै हआ, तिन्‍नां लै दैआ तिंयां होर बी दुख।<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />तिन्‍नें पापो साब-कताब लऐ तूह डाही,</para>
  <para style="q" vid="PSA 69:27">तिन्‍नां निं सज़ा दैणैं बाझ़ी छ़ाडी।<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />तिन्‍नें नाअं काटै ज़िन्दगीए कताबा का पोर्ही,</para>
  <para style="q" vid="PSA 69:28">तिन्‍नां निं धर्मीं मणछा संघै गणी आथी।<verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />पर हुंह आसा दाह-दुखा दी भर्हुअ द,</para>
  <para style="q" vid="PSA 69:29">हे बिधाता, तूह बच़ाऊ मुंह संघा दै मुल्है छ़ुटकारअ।<verse eid="PSA 69:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />मुंह करनी गिह गांठी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 69:30">अर तेरअ शूकर करी करनी मुंह तेरी बड़ैई।<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />एता करै हणअ तूह बिधाता</para>
  <para style="q" vid="PSA 69:31">बल्दे बल़ीदाना का बी खास्सअ खुश।<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />एता भाल़ी हणैं रैनै-गरीब बी खुश,</para>
  <para style="q" vid="PSA 69:32">ज़ुंण परमेशरे लोल़-तोप करा तिन्‍नां बी एछणी हिम्मत।<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />बिधाता शूणां रैनै-गरीबे लेर-पकार,</para>
  <para style="q" vid="PSA 69:33">आपणीं परज़ा निं सह कैद खानै बिस्सरी डाहंदअ।<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />स्वर्ग, पृथूई, समुंदर अर</para>
  <para style="q" vid="PSA 69:34">तेते सोभी ज़ीबा करनी परमेशरे ज़ै-ज़ैकार।<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />तेऊ बच़ाऊंणअ एरुशलेम,</para>
  <para style="q" vid="PSA 69:35">तेऊ बसाऊंणी यहूदा नगरी भिई।</para>
  <para style="q" vid="PSA 69:35">तेऊए परज़ा हणीं भिई तैहा ज़ैगा बस्सी मालक।<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />ज़ुंण बिधातो हुकम मना, तिन्‍नें आद-लुआद हणीं तैहा ज़ैगे बारस अर</para>
  <para style="q" vid="PSA 69:36">ज़ुंण बिधाता लै झ़ूरा तिंयां बस्सणै तैहा ज़ैगा।<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">बिधाता का मज़त मांगणा लै अरज़</para>
  <para style="r">(<ref loc="PSA 40:13-17">भज़न 40:13-17</ref>)</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदे पिछ़ली गल्‍ला आद फरेऊंणा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />हे बिधाता, तूह कर छ़ेक्‍कै मेरी मज़त!</para>
  <para style="q" vid="PSA 70:1">ज़ीबाण, मुंह बच़ाऊ।<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />ज़ुंण मुंह मारना लै पिछ़ू आसा पल़ै दै,</para>
  <para style="q" vid="PSA 70:2">तिंयां लोल़ी झाखुऐ अर हारै।</para>
  <para style="q" vid="PSA 70:2">ज़ुंण मुल्है आफ़त पाणा लै झ़ूरा,</para>
  <para style="q" vid="PSA 70:2">तिंयां लोल़ी पिछ़ू हटै अर बेइज़त हुऐ।<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />ज़ुंण दुशमण मेरअ सुहांग करा,</para>
  <para style="q" vid="PSA 70:3">तिंयां लोल़ी आपणीं हार भाल़ी शर्मिंदै हुऐ।<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />ज़ुंण तेरै भगत आसा, तिंयां लोल़ी ताह करै खुश अर मगन हुऐ।</para>
  <para style="q" vid="PSA 70:4">ज़ुंण तेरै उद्धार करना लै शूकर करा</para>
  <para style="q" vid="PSA 70:4">तिन्‍नैं लोल़ी ती कबल्‍ली एही गल्‍ला बोली,</para>
  <para style="q" vid="PSA 70:4">“बिधाता भाल़ किहअ महान आसा।”<verse eid="PSA 70:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />हुंह आसा दुखी-गरीब,</para>
  <para style="q" vid="PSA 70:5">पर तूह बिधाता डाहा मेरअ धैन-खैल।</para>
  <para style="q" vid="PSA 70:5">मुंह छ़ड़ैऊंणैं आल़अ आसा तूह ई।</para>
  <para style="q" vid="PSA 70:5">ज़ीबाण, ऐबै निं मुंह बच़ाऊंणा लै बल़ैग पाई।<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">फाज़त करना लै बिधाता का अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />हे बिधाता, हुंह लआ ताह सेटा शरण,</para>
  <para style="q" vid="PSA 71:1">मुंह निं शर्मिंदै हणैं दैई!<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />किल्हैकि तूह आसा धर्मीं, तूह कर मेरी मज़त, मुंह बच़ाऊ।</para>
  <para style="q" vid="PSA 71:2">मुंह बाखा दै धैन संघा कर मेरअ उद्धार।<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />तूह बण मेरी शरण लणें ज़ैगा,</para>
  <para style="q" vid="PSA 71:3">अर मुंह आजू लुक्‍कणा लै बडी टोल्ह,</para>
  <para style="q" vid="PSA 71:3">मुंह बच़ाऊंणै आल़ी टोल्ह अर शरण लणें ज़ैगा आसा तूह ई।<verse eid="PSA 71:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />हे बिधाता, तूह बच़ाऊ मुंह कदुष्ट मणछा का,</para>
  <para style="q" vid="PSA 71:4">नर्दैई अर कमुर्ख लोगा का कर मेरी फाज़त।<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />हे मेरै मालक बिधाता, हुंह रहा ताह ई न्हैल़अ लागी,</para>
  <para style="q" vid="PSA 71:5">मंऐं आसा होछ़ी उझै ताह ई दी आशा डाही दी।<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />मेरी सारी ज़िन्दगी आसा तेरै ई आसरै।</para>
  <para style="q" vid="PSA 71:6">तूह आअ मुंह मेरी ईजै ओदरा ओर्ही मेरी फाज़त करदी।</para>
  <para style="q" vid="PSA 71:6">मुंह करनी सदा तेरी ई ज़ै-ज़ैकार।<verse eid="PSA 71:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />मेरी ज़िन्दगी आसा होरी लै बी सबक,</para>
  <para style="q" vid="PSA 71:7">किल्हैकि तूह आसा मुल्है शरण लणा लै बडी पाक्‍की टोल्हा ज़िहअ।<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />मुंह करनी सारी अमरा तेरी ई ज़ै-ज़ैकार अर</para>
  <para style="q" vid="PSA 71:8">तेरी महान शोभा खोज़णीं मुंह सोभी का।<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />बुढल़दा निं मुंह कल्ही डाही आथी,</para>
  <para style="q" vid="PSA 71:9">ऐबै निं ज़ोर-ज़ाहण बी रहै, मुंह निं छ़ाडी आथी।<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />मेरै दुशमण आसा मुंह मारना लै ताखुऐ दै,</para>
  <para style="q" vid="PSA 71:10">तिन्‍नैं किअ एता लै आप्पू मांझ़ै जोग।<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />तिंयां बोला आप्पू मांझ़ै इहअ, “अह आसा परमेशरै कल्ही डाहअ द शोटी,</para>
  <para style="q" vid="PSA 71:11">एऊ पिछ़ू च़ाल्‍ला अह ढाकणअ हाम्हां,</para>
  <para style="q" vid="PSA 71:11">एऊ बच़ाऊंदअ निं कोहै एछणअ।”<verse eid="PSA 71:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />हे परमेशर, तूह निं मुंह सेटा का दूर डेऊई,</para>
  <para style="q" vid="PSA 71:12">ऐबै निं बल़ैघदअ लागी, मेरी मज़त कर!<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />ज़ुंण मेरी हत्या च़ाहा करनी</para>
  <para style="q" vid="PSA 71:13">तिंयां लोल़ी हारै अर बरैबाद हुऐ।</para>
  <para style="q" vid="PSA 71:13">ज़ुंण मुल्है घाटअ सोठा,</para>
  <para style="q" vid="PSA 71:13">तिंयां लोल़ी बेइज़त अर शर्मिंदै हुऐ।<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />हुंह डाहा सदा ताह ई प्रैंदै आशा,</para>
  <para style="q" vid="PSA 71:14">मुंह करनी तेरी ज़ै-ज़ैकार होर बी खास्सी।<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />मुंह खोज़णीं तेरी सोभ भलाई,</para>
  <para style="q" vid="PSA 71:15">मुंह रहणअ सारी धैल़ी गल्‍ला खोज़दै लागी कि तूह लोगा किहै बच़ाऊआ,</para>
  <para style="q" vid="PSA 71:15">ज़ात पठी गल्‍ला खोज़णीं आसा मेरी समझ़ा का बी बागै।<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />हे मेरै मालक बिधाता, मुंह करनी तेरै महान कामां अर</para>
  <para style="q" vid="PSA 71:16">तेरै उद्धार करने बला लै ज़ै-ज़ैकार।<verse eid="PSA 71:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />तंऐं दैनी मुल्है होछ़ी उझै शिक्षा,</para>
  <para style="q" vid="PSA 71:17">हुंह बी आसा आझ़ तैणीं तेरै महान कामें बारै सोभी का खोज़दअ लागअ द।<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />ऐबै हुअ हुंह प्रोढअ अर मेरअ मूंड गअ पल़ू करै शेतअ हई,</para>
  <para style="q" vid="PSA 71:18">ऐबै निं मुंह तूह छ़ाडी आथी,</para>
  <para style="q" vid="PSA 71:18">हे मेरै मालक, ज़ेभै तैणीं हुंह आगली पोस्ती का तेरै महान बल अर</para>
  <para style="q" vid="PSA 71:18">शगतीए बारै खोज़ी निं मुक्‍के, तेभै तैणीं रहै तूह मुंह संघा।<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />हे बिधाता, तूह आसा महान अर धर्मीं,</para>
  <para style="q" vid="PSA 71:19">ज़ुंण महान काम तंऐं किऐ,</para>
  <para style="q" vid="PSA 71:19">तेतो मकाबलअ निं कोहै करी सकदै।<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />तंऐं पाई मुल्है बतेर्ही खरी अर आफ़ता,</para>
  <para style="q" vid="PSA 71:20">पर ऐबै दै तूह ई मुल्है भिई बल,</para>
  <para style="q" vid="PSA 71:20">ऐबै काढ तूह ई मुंह डुघै कुहै का बागै संघा दै नऊंईं ज़िन्दगी।<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />ताह करनअ मेरअ ऐबै होर बी खास्सअ अदर अर</para>
  <para style="q" vid="PSA 71:21">ऐबै जाणअ मुंह भिई सकाल़अ हई।<verse eid="PSA 71:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />मुंह करनी बींन बाज़ी करै तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 71:22">हे बिधाता, इज़राईले परमेशर तूह आसा पबित्र,</para>
  <para style="q" vid="PSA 71:22">मुंह करनअ बींन बाज़ी करै तेरअ शूकर।<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />मुंह बोल़णीं ज़ोरै-ज़ोरै तेरी गिह,</para>
  <para style="q" vid="PSA 71:23">किल्हैकि तंऐं हेरअ हुंह बच़ाऊई!</para>
  <para style="q" vid="PSA 71:23">मुंह करनी तेरी ज़ै-ज़ैकार।<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />तूह आसा धर्मीं, ईंयां गल्‍ला खोज़णीं मुंह सारी धैल़ी,</para>
  <para style="q" vid="PSA 71:24">किल्हैकि ज़ुंण मुल्है घाटअ सोठा,</para>
  <para style="q" vid="PSA 71:24">तिंयां गऐ हारी अर शर्मिंदै हई।<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">राज़ै लै धर्मीं अर भलाईए अरज़</para>
  <para style="d">राज़ै सुलैमाने गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />हे परमेशर, ज़ीबाण, राज़ै का खोज़ धर्म अर नसाफ करनअ,</para>
  <para style="q" vid="PSA 72:1">ज़िहअ तूह आसा तिहअ ई।<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />सह लोल़ी सारी परज़ा लै मानदार अर धर्मीं रहअ अर</para>
  <para style="q" vid="PSA 72:2">रैनै-गरीबो लोल़ी तेऊ मानदारी संघै नसाफ किअ।<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />सारै देशे सोभी ज़ैगा लोल़ी शांती अर</para>
  <para style="q" vid="PSA 72:3">धर्मीं राज़ हुअ।<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />राज़ै लोल़ी ती रैनै-गरीबो मानदारी संघै नसाफ किअ,</para>
  <para style="q" vid="PSA 72:4">छ़ुटै-मुक्‍कै दै लान्हें लोल़ी ती मज़त किई अर</para>
  <para style="q" vid="PSA 72:4">तिन्‍नां छेऊणैं आल़ै लै लोल़ी सज़ा भेटी।<verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />ज़ेभै तैणीं सुरज़ अर ज़ोथ आसा,</para>
  <para style="q" vid="PSA 72:5">तेभै तैणीं लोल़ी तेरी परज़ा तेरी ज़ै-ज़ैकार करदी रही।<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />राज़अ लोल़ी त परज़ा लै इहअ भलअ हुअ ज़ेही</para>
  <para style="q" vid="PSA 72:6">शुक्‍की ज़ैगा बरसात हआ अर ज़ैगा हरी-भरी हआ।<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />तेऊए राज़ा दी लोल़ी धर्मीं मणछ फल़ै-फुल्‍लै अर</para>
  <para style="q" vid="PSA 72:7">ज़ेभै तैणीं सरगै ज़ोथ आसा तेभै तैणीं लोल़ी तेऊ राज़ा दी शांती रही।<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />तेऊओ राज़ लोल़ी एकी समुंदरा का दुजै समुंदरै तैणीं अर</para>
  <para style="q" vid="PSA 72:8">एप्रात दरैऊआ का पृथूईए दुजै बाढा तैणीं हुअ।<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />उज़र रेगीस्तानै बस्सै दै लोगै लोल़ी तेऊ सेटा माथअ टेक्‍कअ,</para>
  <para style="q" vid="PSA 72:9">तेऊए दुशमणै लोल़ी तेऊ सेटा धरनीं माट्टै दी नाक रघोल़अ।<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />तरशीश<note caller="+" style="f"><char style="fr" closed="false">72:10 </char><char style="fq" closed="false">तरशीश </char><char style="ft" closed="false">तेऊ ज़मानैं ज़ेतरअ भाल़अ हेरअ द थिअ, तेथ त तरशीश पछ़मा बाखा सिऊंआं। ज़ेता लै आझ़काला स्पेन बोला।</char></note> देशे राज़ै अर होरी टापू दी राज़ करनै आल़ै राज़ै लोल़ी तेऊ लै कारअ दैनअ,</para>
  <para style="q" vid="PSA 72:10">अर शेबा अर सबा मुल्खे राज़ै लोल़ी तेऊ सेटा भैंट आणी।<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />सोभी राज़ै लोल़ी तेऊ सेटा माथअ टेक्‍कअ अर</para>
  <para style="q" vid="PSA 72:11">सोभी देशे लोगै लोल़ी तेऊए च़ाकरी किई।<verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />किल्हैकि ज़ुंण रैनै गरीबै तेऊ सेटा पकार पाई, तेऊ राज़ै बच़ाऊऐ तिंयां,</para>
  <para style="q" vid="PSA 72:12">ज़ुंण छ़ुटै मुक्‍कै दै थिऐ, तिन्‍नों किअ तेऊ नसाफ।<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />सह करा रैनै-गरीबा लै झींण,</para>
  <para style="q" vid="PSA 72:13">अर तेऊ बच़ाऊई तिन्‍नें ज़िन्दगी।<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />तेऊ बच़ाऊऐ तिंयां ज़ुल्म अर उपद्रभा का,</para>
  <para style="q" vid="PSA 72:14">तेऊ लै आसा तिन्‍नें ज़िन्दगीए किम्मत खास्सी।<verse eid="PSA 72:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />तेऊ राज़ैओ राज़ लोल़ी सदा रहअ!</para>
  <para style="q" vid="PSA 72:15">शेबा नगरी का लोल़ी तेऊ लै सुन्‍नअ दैनअ,</para>
  <para style="q" vid="PSA 72:15">तेऊ राज़ै लै लोल़ी ताह बिधाता सेटा सदा अरज़ हुई</para>
  <para style="q" vid="PSA 72:15">अर ताखा लोल़ी सदा तेऊ लै बर्गत भेटी।<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />तेऊ देशै लोल़ी बतेर्हअ नाज़ हुअ,</para>
  <para style="q" vid="PSA 72:16">धारा लोल़ी खास्सी फसल हुई,</para>
  <para style="q" vid="PSA 72:16">नाज़े सील लोल़ी तेथ लाबानोन धारे केल़ुई ज़िहै लाम्मै हुऐ।</para>
  <para style="q" vid="PSA 72:16">तेऊ देशे नगरी लोल़ी मणछा करै</para>
  <para style="q" vid="PSA 72:16">घैहणींए घाह ज़ेही भरी हुई।<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />तेऊ राज़े शोभा लोल़ी सदा-सदा लै सरगे सुरज़ा ज़ेही रही,</para>
  <para style="q" vid="PSA 72:17">सोभी देशै लोल़ी ताह बिधाता का एही अरज़ किई,</para>
  <para style="q" vid="PSA 72:17">“ज़ेही तंऐं तेऊ राज़ै लै बर्गत दैनी,</para>
  <para style="q" vid="PSA 72:17">तेही बर्गत दै तूह हाम्हां लै बी।<verse eid="PSA 72:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />हे इज़राईले परमेशर बिधाता, हाम्हां करनी तेरी ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 72:18">इहै च़मत्कार सका तूह ई करी।<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />हाम्हां करनी तेरै महान नाओंए सदा ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 72:19">तेरी शोभा लोल़ी सारी पृथूई दी भर्हुई।</para>
  <para style="q" vid="PSA 72:19">एवमस्तू, भिई बोला हाम्हैं एवमस्तू।”<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />ताह बिधाता सेटा आसा मुंह ईशैई शोहरू राज़ै दाबेदे एचल़ी ई अरज़।<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">चिऊथअ भाग</para>
  <para style="mr">(<ref loc="PSA 73:1-89:52">भज़न 73:1—89:52</ref>)</para>
  <para style="s">बिधाता आसा भलअ</para>
  <para style="d">असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />बिधाता आसा इज़राईला लै भलअ,</para>
  <para style="q" vid="PSA 73:1">खासकर तिन्‍नां लै ज़ुंण दिले शुचै आसा।<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />पर मंऐं हेरअ त हैअ छ़ाडी अर</para>
  <para style="q" vid="PSA 73:2">मेरअ शाह गअ त चुटी,<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />किल्हैकि मेरअ दिल ज़ल़ा त ऐहा गल्‍ला भाल़ी कि</para>
  <para style="q" vid="PSA 73:3">शरेरै अर कदुष्ट मणछ आसा राज्ज़ी-मौज़ी।<verse eid="PSA 73:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />तिन्‍नां निं किछ़ै दाह खीज़ हंदी अर</para>
  <para style="q" vid="PSA 73:4">तिंयां ज़िऊआ नरोगी ज़िन्दगी!<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />नां तिन्‍नां होरी मणछा ज़ेही आफ़त हंदी पल़ी दी,</para>
  <para style="q" vid="PSA 73:5">नां किज़ू गल्‍ले खरी हंदी!<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />तिन्‍नों घमंड ताह इहअ आसा ज़ेही गल़ै सुन्‍नें कंठी!</para>
  <para style="q" vid="PSA 73:6">उपद्रभ अर ज़ुल्म करनअ हआ तिन्‍नां लै पिठी च़ादरू ज़िहअ!<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />तिन्‍नें दिलै आसा उपद्रभ ई,</para>
  <para style="q" vid="PSA 73:7">तिंयां हआ आपणैं मन्‍नैं कदुष्ट ई तरकिबा बणाऊंदै लागै दै।<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />तिंयां हआ होरीए सुहांगा लागै दै अर तिन्‍नें खाखा का निखल़ा गाल़ी ई,</para>
  <para style="q" vid="PSA 73:8">तिंयां आसा शरेरै अर तिंयां सोठा होरी हारनै-मारने ई तरकिबा।<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />तिंयां आसा इहै शरेरै कि तिंयां बोला स्वर्गै बेठै दै बिधाता लै बी बूरअ!</para>
  <para style="q" vid="PSA 73:9">अर होरी लै बी फिरा तिंयां हुकम करदै!<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />तिंयां पाआ धर्मीं मणछा बी कबाता</para>
  <para style="q" vid="PSA 73:10">अर तिन्‍नें गल्‍ला पाआ तिंयां पाणीं ज़ेही झुटी!<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />तिंयां कदुष्ट बोला इहअ पै, “बिधाता ज़ुंण परम प्रधान परमेशर आसा, सह किज़ै ज़ाणा?</para>
  <para style="q" vid="PSA 73:11">तेऊ का निं किछ़ै थोघ लागदअ कि इधी किज़ै हुअ!”<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />तज़ी बी रहा ईंयां कदुष्ट मणछ राज्ज़ी-मौज़ी!</para>
  <para style="q" vid="PSA 73:12">इना का हआ धन-माया होर बी खास्सी!<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />मंऐं निं एक पाप बी किअ अर</para>
  <para style="q" vid="PSA 73:13">आपणअ मन्‍न शुचअ डाही मुंह किज़ै भेटअ?<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />मुंह हआ धैल़ किज़ै नां किज़ै आफ़त पल़ी दी,</para>
  <para style="q" vid="PSA 73:14">हर धैल़ै भेटा मुंह सज़ा!<verse eid="PSA 73:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />ज़ै हुंह बी एही कदुष्ट गल्‍ला करदअ,</para>
  <para style="q" vid="PSA 73:15">सह हणअ त मेरअ तेरी परज़ा संघै छ़ल़-कपट किअ द।<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />हुंह थक्‍कअ इना गल्‍ला सोठी-सोठी</para>
  <para style="q" vid="PSA 73:16">पर ईंयां आसा मेरी समझ़ा का बागै!<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />तेखअ डेऊअ हुंह तेरी पबित्र ज़ैगा,</para>
  <para style="q" vid="PSA 73:17">तिधी पुजी लागअ मुखा थोघ कि कदुष्ट मणछा किज़ै फल भेटा।<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />तूह बिधाता डाहा तिन्‍नां च़िफली ज़ैगा खरैल़ी अर</para>
  <para style="q" vid="PSA 73:18">तिधा का बधल़ूई निं तिंयां खल़ै उझ़दै रहंदै।<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />तिंयां हआ घल़ी-पला दी खतम</para>
  <para style="q" vid="PSA 73:19">तिन्‍नां लै पल़ा नच़ानक एही डरैऊंणी आफ़त कि तिन्‍नों निं नाअं-नशाण बी रहंदअ।<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />हे मेरै मालक, ज़िहअ राच भैई करै सुपनअ बृथा हआ,</para>
  <para style="q" vid="PSA 73:20">तिहै ई करनै ताह तिंयां लोप, ज़ांऊं ताह उझ़ुई जाणअ।<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />मेरअ मन्‍न त खाट्टअ अर</para>
  <para style="q" vid="PSA 73:21">दिल थिअ चुटी गअ द,<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />हुंह त पशू ज़िहअ कबुधी अर बेसमझ़,</para>
  <para style="q" vid="PSA 73:22">हुंह निं ताह बिधाता समझ़ी बोल़अ।<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />तज़ी बी रहअ हुंह कबल्‍लअ ताह नेल़ अर</para>
  <para style="q" vid="PSA 73:23">तंऐं थिअ मेरअ हाथ ढाकी डाहअ द।<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />तेरी सलाह ती मुंह आजू नढैऊंदी लागी दी,</para>
  <para style="q" vid="PSA 73:24">तेतो फल भेटअ मुंह खिरी इहअ कि तंऐं किअ मेरअ अदर।<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />मेरअ निं स्वर्गै ताखा सुआई होर कोहै आथी,</para>
  <para style="q" vid="PSA 73:25">इधी ऐहा पृथूई बी निं मुंह ताखा सुआई होर किछ़ै लोल़ी।<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />मेरअ दिल अर मन्‍न आसा हारी गअ द,</para>
  <para style="q" vid="PSA 73:26">पर तूह बिधाता आसा मेरअ बल</para>
  <para style="q" vid="PSA 73:26">मुंह आसा सदा तेरी ई ज़रुरत।<verse eid="PSA 73:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />ज़ुंण ताखा दूर हआ, तिन्‍नां पल़णीं सज़ा भुगतणी ई,</para>
  <para style="q" vid="PSA 73:27">ज़ुंण ताल्है विश्वास घात करा, तिंयां करनै ताह पठी बरैबाद।<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />पर मुल्है आसा ताह बिधाता नेल़ रहणअ ई भलअ,</para>
  <para style="q" vid="PSA 73:28">मेरी शरण लणें ज़ैगा आसा तूह ई मेरअ मालक,</para>
  <para style="q" vid="PSA 73:28">ज़ुंण तंऐं मुल्है किअ, तिंयां गल्‍ला खोज़णीं मुंह सोभी का।<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">आफ़ते पलका बिधाता का अरज़</para>
  <para style="d">असापो खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />हे परमेशर, तंऐं हाम्हैं इहै कल्ही किल्है छ़ाडै?</para>
  <para style="q" vid="PSA 74:1">ताह कै आपणीं परज़ा का सदा रहणअ रुश्शी?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />तिन्‍नां मणछा कर आद ज़ुंण तंऐं खास्सी साला पैहलै आपणीं खास परज़ा आसा बणाऐं दै,</para>
  <para style="q" vid="PSA 74:2">तिंयां आणै तै तंऐं गलामी का छ़ड़ैऊई कि सह गोत्र लोल़ी तेरअ आपणअ खास हुअ।</para>
  <para style="q" vid="PSA 74:2">तैहा सियोन धारा बी कर आद ज़िधी तंऐं बसेरअ किअ त।<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />म्हारै दुशमणै किई तेरी पबित्र ज़ैगा बरैबाद,</para>
  <para style="q" vid="PSA 74:3">तिन्‍नां ढूल़ै दै मेटा प्रैंदी दै एक हांढ।<verse eid="PSA 74:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />म्हारै दुशमणै लाई तेरै भबनै सिहा ज़ेही क्रुंगा,</para>
  <para style="q" vid="PSA 74:4">तिन्‍नैं डाहै तिधी आपणैं फ्रहरै घैऊई कि तिंयां गऐ ज़िती।<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />तिंयां ज़ाण्हिंआं इहै कि तिन्‍नैं आणअ खराल़ै करै</para>
  <para style="q" vid="PSA 74:5">सारअ बण काटी खतम करी।<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />तिन्‍नैं पाऐ भबने खेल़्तर पाऐ दै काठ</para>
  <para style="q" vid="PSA 74:6">खराल़ै अर घणा करै फाल़ी।<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />तिन्‍नैं चैल़ी पबित्र ज़ैगा तेरै बसेरै सारै दी आग अर</para>
  <para style="q" vid="PSA 74:7">तिन्‍नैं लाई तेरी पबित्र ज़ैगा छ़ोत।<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />तिंयां बोला आप्पू मांझ़ै इहअ, “हाम्हां करनअ एथ पठी बरैबाद।”</para>
  <para style="q" vid="PSA 74:8">सारै देशै ज़िधी-ज़िधी ताह परमेशरे गान-स्तान आसा, तेथ चैल़ी तिन्‍नैं आग।<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />ऐबै नां तेरै नशाण रहै अर नां गूर रहै,</para>
  <para style="q" vid="PSA 74:9">नां हाम्हां मांझ़ै कहा का थोघ आथी कि</para>
  <para style="q" vid="PSA 74:9">अह एही दशा केभै तैणीं रहणीं पल़ी।<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />हे परमेशर, म्हारै दुशमण कधू तैणीं रहणैं तेरै सुहांगा लागी?</para>
  <para style="q" vid="PSA 74:10">दुशमण कै कबल्‍लै रहणैं तेरै नाओंआं बेइज़त करदै लागी?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />तूह तिन्‍नां लै सज़ा किल्है निं दैंदअ,</para>
  <para style="q" vid="PSA 74:11">म्हारी मज़त कर, तूह किल्है आसा च़ुप्पी रहअ द खल़्हुई?<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />पर हे बिधाता, तूह आसा हुऐ ज़मानैं ओर्ही म्हारअ राज़अ,</para>
  <para style="q" vid="PSA 74:12">तूह आअ हाम्हां बच़ाऊंदी।<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />तंऐं किअ त आपणैं बला करै समुंदर बी दूई बाखा लै,</para>
  <para style="q" vid="PSA 74:13">समुंदरै पाणीं दी रहणैं आल़अ बडअ मगर म्हाछ़ पाअ तंऐं तेऊओ मूंड फाल़ी मारी, <verse eid="PSA 74:13" /><verse number="14" style="v" sid="PSA 74:14" />लिबतान नाओं समुंदरो बडअ ज़ीब बी पाअ तंऐं मारी,</para>
  <para style="q" vid="PSA 74:14">तेऊए ठोर-ठोर करी खैऊई तिंयां शिखा बणें ज़ीबा का।<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />तंऐं बहाऊई बडी-बडी सोबल़ा काढी गाडा,</para>
  <para style="q" vid="PSA 74:15">बारा भिन्‍नैं बगणैं आल़ै दरैअ पाऐ तंऐं शकेऊई!<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />धैल़ी बी आसा तेरअ राज़ अर राची बी आसा तेरअ राज़,</para>
  <para style="q" vid="PSA 74:16">सुरज़ अर ज़ोथ आसा तंऐं ई डाहै दै टकैल़ी।<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />पृथूईए सिअं आसा तंऐं ई खिंच़ी दी अर</para>
  <para style="q" vid="PSA 74:17">हिंऊंद भराल़ बी आसा तंऐं ई डाहै दै।<verse eid="PSA 74:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />पर हे बिधाता, तेरै दुशमण आसा ताल्है हास्सदै लागै दै,</para>
  <para style="q" vid="PSA 74:18">तिंयां कमुर्ख आसा तेरी निंदा करदै लागै दै।<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />म्हारी मज़त करनै आल़अ निं कोहै आथी अर हाम्हां निं नर्दैई दुशमणा सेटा कल्ही छ़ाडी,</para>
  <para style="q" vid="PSA 74:19">हाम्हैं आसा तेरी हारी-मारी दी परज़ा, हाम्हां निं हेरे बिस्सरी पाई।<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />आपणीं तैहा करारा डाहै आद ज़ुंण तंऐं हाम्हां संघै आसा किई दी,</para>
  <para style="q" vid="PSA 74:20">देशै आसा न्हैरअ अर ज़ुल्म भर्हुअ द!<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />हारै-मारै दै मणछा निं लोल़ी शर्मिंदै पल़अ हणअ,</para>
  <para style="q" vid="PSA 74:21">रैनै-गरीबा लै दैऐ आपणीं स्तोती करनैओ मोक्‍कअ।<verse eid="PSA 74:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />हे बिधाता, ऐबै उझ़ू, आपणअ नसाफ कर तूह आप्पै!</para>
  <para style="q" vid="PSA 74:22">ऐहा गल्‍ला कर आद कि ईंयां कदुष्ट हआ सारी धैल़ी कबल्‍लै तेरै सुहांगा लागै दै।<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />आपणैं दुशमणे झांशा-त्रुंगा निं तूह बिस्सरी आथी,</para>
  <para style="q" vid="PSA 74:23">तिन्‍नैं हआ धैल़ बबाल किअ द।<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">नसाफ करना लै बिधातो शूकर</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै अलतशहेत रागा दी असापे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />हे बिधाता, हाम्हैं करा तेरअ शूकर,</para>
  <para style="q" vid="PSA 75:1">हाम्हां खोज़णअ सोभी का तूह किहअ महान आसा अर</para>
  <para style="q" vid="PSA 75:1">तंऐं किहै-किहै नुआहरै काम आसा किऐ दै।<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />बिधाता बोला इहअ, “ज़ेभै मेरअ बगत एछे,</para>
  <para style="q" vid="PSA 75:2">तेभै करनअ मुंह आप्पै नसाफ।<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />तेभै छ़ुटणीं सोभी ज़ीबा काम्मणीं अर</para>
  <para style="q" vid="PSA 75:3">पृथूई दी हणीं ज़ाज़री,</para>
  <para style="q" vid="PSA 75:3">तेते आथरी डाहा हुंह ई पाक्‍की टकैल़ी।<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />मंऐं हेरी घमंडी लै चतैनगी दैई कि शरेरै निं फिरा अर</para>
  <para style="q" vid="PSA 75:4">कदुष्टा लै हेरअ मंऐं बोली कि तम्हैं निं आपणीं तागती रहैऊंदै लागा!<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />तम्हैं खास्सै निं फिरा! मुखा निं लागा खोज़दै कि तम्हैं किहै महान<note caller="+" style="f"><char style="fr" closed="false">75:5 </char><char style="fq" closed="false">महान </char><char style="ft" closed="false">हठू, काठै</char></note> आसा!”<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />नसाफ नां पुर्बा बाखा एछदअ, नां पछ़मा बाखा,</para>
  <para style="q" vid="PSA 75:6">नां उतरा बाखा नां दखणा बाखा,<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />सह आसा तूह बिधाता ज़ुंण नसाफ करा,</para>
  <para style="q" vid="PSA 75:7">तूह सका एकी लै बल दैई अर दुजै का बल छ़ड़ैऊई।<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />तंऐं बिधाता आसा आपणैं हाथै रोश्शे नशै आल़ै दाखे रसे बाटी ढाकी दी।</para>
  <para style="q" vid="PSA 75:8">तेऊ तरैल़ा तूह पृथूईए सोभी कदुष्ट मणछा लै,</para>
  <para style="q" vid="PSA 75:8">तिंयां झुटा तेता पठी अर</para>
  <para style="q" vid="PSA 75:8">तेता का निं एक टिप्पू बी पिछ़ू झुटदअ।<verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />पर मुंह रहणअ कबल्‍लै ताह याकबे परमेशरे बारै सोभी का खोज़दै लागी</para>
  <para style="q" vid="PSA 75:9">अर तेरअ भज़न बोल्दै लागी।<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />ताह करनअ कदुष्ट मणछो बल खतम,</para>
  <para style="q" vid="PSA 75:10">पर धर्मीं रहणअ होर बी बलबान हंदअ लागी।<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">परमेशर निं कधि हारदअ</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै बींन अर कतारै संघै असापे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />तूह परमेशर आसा यहूदा गोत्रा दी मशूर अर</para>
  <para style="q" vid="PSA 76:1">तेरी हआ इज़राईला दी खास्सी इज़त।<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />तेरअ घअर आसा शालेम<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="fq" closed="false">शालेम </char><char style="ft" closed="false">एरुशलेम</char></note> अर</para>
  <para style="q" vid="PSA 76:2">तूह आसा सियोन धारा बस्सअ द।<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />तिधी पाऐ तंऐं दुशमणे कतीर, ढाल़ा, तलबारा</para>
  <para style="q" vid="PSA 76:3">अर दुशमणे जुधा करने सारै चाण चोल़ी।<verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />हे बिधाता, तूह आसा बडअ महान,</para>
  <para style="q" vid="PSA 76:4">तेरी शोभा आसा इना बडी-बडी ज़ोता का खास्सी।</para>
  <para style="q" vid="PSA 76:4">तिधी हारै तै तेरै दुशमण अर<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />बडै-बडै हिम्मती आल़ै जोधै हुऐ तै तिधी रित्तै,</para>
  <para style="q" vid="PSA 76:5">ऐबै आसा तिंयां मौते निंजा च़ैना दी सुत्तै दै,</para>
  <para style="q" vid="PSA 76:5">तिन्‍नों सारअ बल अर तागत हुई बृथा।<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />ए याकबे परमेशर, ज़ांऊं तंऐं तिन्‍नां लै एक झ़ाहल़ काढी,</para>
  <para style="q" vid="PSA 76:6">तिन्‍नें रथा दी शुंआर अर घोल़ै हुऐ मरी खतम।<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />पर हे परमेशर, सोभी लोल़ी तेरी ई डअर हुई,</para>
  <para style="q" vid="PSA 76:7">ज़ै ताह रोश्शै एछी गई, तेभै निं</para>
  <para style="q" vid="PSA 76:7">ताह आजू कुंण खल़अ हई सकदअ।<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />तंऐं दैनअ स्वर्गा का आपणअ नसाफ</para>
  <para style="q" vid="PSA 76:8">तेता शूणीं छ़ुटी पृथूई काम्मणीं अर तेथ हुऐ सोभै नड़क्‍क।<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />ज़ांऊं तूह नसाफ करदअ खल़अ उझ़ुअ,</para>
  <para style="q" vid="PSA 76:9">तंऐं बच़ाऊऐ पृथूई दी तिंयां सोभै ज़ुंण रैनै-गरीब हारै-मारै दै थिऐ।<verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />मणछे रोश्शा करै बी हआ खिरी तेरी ई ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 76:10">ज़ुंण जुधा का बच़ै, तिंयां मनाऊंआं ताल्है थैर।<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />ज़ुंण बिधाता लै मानत मनी, सह लणी पूरी करी,</para>
  <para style="q" vid="PSA 76:11">तेऊ लै लणी ओर्ही-पोर्ही का सोभी देशा भैंट आणी।</para>
  <para style="q" vid="PSA 76:11">तेऊए डरा हेठै लागा सोभी रहणअ।<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />परमेशर करा पृथूई दी राज़ करनै आल़ैओ घमंड च़ूर-च़ूर</para>
  <para style="q" vid="PSA 76:12">अर राज़ै लागा तेऊए डरै काम्मणीं।<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">खरीए पलका करा बिधाता मज़त</para>
  <para style="d">जदूतून, गाज़ै-बाज़ै आल़ेए सैणैं लै असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />हे बिधाता, हुंह करा लेर-पकार पाई ताह सेटा अरज़,</para>
  <para style="q" vid="PSA 77:1">तै झ़ाणीं तूह शुणें!<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />ज़ेभै मुंह आफ़त पल़ी, तेभै करा हुंह मेरै मालक बिधाता सेटा अरज़,</para>
  <para style="q" vid="PSA 77:2">सारी राची डाहा हुंह अरज़ करदी बारी आपणीं बाह फुआरी,</para>
  <para style="q" vid="PSA 77:2">पर मुंह निं शांती भेटी।<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />हे बिधाता, तेरै बारै सोठी-सोठी निं मुंह</para>
  <para style="q" vid="PSA 77:3">उझ़ुई नां बेशी राम हंदअ।<verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />राची निं नींज अर धैल़ी निं भुख हंदी,</para>
  <para style="q" vid="PSA 77:4">मुंह निं हैल़ी हांस बी रही।<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />हुंह सोठा पराणैं ज़मानें तिन्‍नां धैल़ीए बारै अर</para>
  <para style="q" vid="PSA 77:5">पिछ़लै जुगे तिन्‍नां साले बारै।<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />मुंह हआ सारी राची सोठ पल़ी दी,</para>
  <para style="q" vid="PSA 77:6">हुंह रहा आपणैं मन्‍नैं राम्बल़ै करै इहअ बच़ार करदअ लागी,<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />“मेरै मालक बिधाता कै हुंह सदा लै हेरअ छ़ाडी?</para>
  <para style="q" vid="PSA 77:7">ऐबै झ़ाणीं सह हाम्हां लै कधि निं हणअ होए राज्ज़ी?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />सह झ़ाणीं हाम्हां लै एचल़ी झ़ूरा हंदअ?</para>
  <para style="q" vid="PSA 77:8">तेऊ हाम्हां लै दैनी दी ज़बान बी ऐबै बृथा डेऊई होए?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />परमेशरा झ़ाणीं हाम्हां लै जश दैणें आद बी निं रही होए?</para>
  <para style="q" vid="PSA 77:9">सह झ़ाणीं रोश्शै हाम्हां लै झींण करनै का बी हटअ होए पिछ़ू?”<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />तेखअ किअ मंऐं इहअ बच़ार, “सोभी का खास्सअ दुख हुअ मुंह इहअ कि</para>
  <para style="q" vid="PSA 77:10">परम प्रधान परमेशर बिधाता का झ़ाणीं ऐबै बल ई निं रहअ होए तैही निस्सअ सह म्हारी मज़त करी!”<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />पर हे बिधाता, ज़ुंण महान काम तंऐं किऐ, तेता निं हुंह बिस्सरदअ,</para>
  <para style="q" vid="PSA 77:11">पराणैं ज़मानैं तंऐं ज़ुंण नुआहरै काम किऐ, तिंयां डाहणैं मुंह आद।<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />आझ़ तैणीं तंऐं ज़िहअ बी किअ मुंह रहणअ तेते बारै सोठदै लागी,</para>
  <para style="q" vid="PSA 77:12">मुंह करनअ तेरै तिन्‍नां महान कामों धैन।<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />तूह बिधाता ज़िहअ बी करा, तेरअ सह काम हआ भलअ ई,</para>
  <para style="q" vid="PSA 77:13">तूह आसा सोभी का बडअ अर महान, तेरअ मकाबलअ निं देअ नां देबतै करी सकदै!<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />च़मत्कार सका सिधअ तूह परमेशर ई करी,</para>
  <para style="q" vid="PSA 77:14">तंऐं रहैऊअ देशा-देशा का आपणअ बल।<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />आपणअ बल रहैऊई बच़ाऊई तंऐं आपणीं परज़ा बी,</para>
  <para style="q" vid="PSA 77:15">याकब अर युसुफे आद-लुआद किऐ तंऐं आज़ाद।<verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />ताह भाल़ी छ़ुटा समुंदरा बी काम्मणीं अर</para>
  <para style="q" vid="PSA 77:16">तेते थाल्‍लै हआ ज़ाज़री।<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />बादल़ा का छ़ुटा उंधै पाणीं संघा लागा</para>
  <para style="q" vid="PSA 77:17">गुल़ूबिज़ल़ूए ढिम्हां अर</para>
  <para style="q" vid="PSA 77:17">सारै सरगै लागा बिज़ल़ीए झ़प्पा-झ़प्पी।<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />ज़ांऊं तेरअ गुल़ूबिज़ल़ू थरेटा ज़िहअ घुर्हअ,</para>
  <para style="q" vid="PSA 77:18">संसारै लागै बिज़ल़ीए च़लकारै,</para>
  <para style="q" vid="PSA 77:18">धरती हुई ज़ाज़री अर लोगा छ़ुटी काम्मणीं।<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />तूह हांढा समुंदरे छ़ाल्‍ली प्रैंदै,</para>
  <para style="q" vid="PSA 77:19">डुघअ समुंदर लंघा तूह एकी लाह लै,</para>
  <para style="q" vid="PSA 77:19">पर तेरै खूरे नछ़ैण निं कोही का शुझदै।<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />तंऐं छाहकी आपणीं परज़ा भेडे हेल़्ही ज़ेही,</para>
  <para style="q" vid="PSA 77:20">मोसा अर हारण डाहै तिन्‍नें फुआल बणाईं।<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">बिधाता आपणीं परज़ा लै किऐ दै काम</para>
  <para style="d">असापो खास भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />मेरै साथी-संघीओ, मेरी गल्‍ला दी दैआ धैन,</para>
  <para style="q" vid="PSA 78:1">मंऐं भाल़ तम्हां लै केही शिक्षा लाई दैई!<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />मुंह करनी कथ्या खोज़ी गल्‍ला,</para>
  <para style="q" vid="PSA 78:2">संघा खोज़णीं मुंह तम्हां का तिंयां गल्‍ला ज़ुंण पराणैं ज़मानै ओर्ही गुप्त आसा।<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />ईंयां गल्‍ला आसा हाम्हैं आपणैं</para>
  <para style="q" vid="PSA 78:3">दादा-बाबा का शूणीं दी,<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />हाम्हां निं ईंयां गल्‍ला आपणैं लान्हैं सुन्हैं का च़ोरी डाहणीं,</para>
  <para style="q" vid="PSA 78:4">हाम्हां खोज़णअ आगली पोस्ती का</para>
  <para style="q" vid="PSA 78:4">बिधातो बल अर तेऊए महान कामें बारै कि</para>
  <para style="q" vid="PSA 78:4">तेऊ किहै-किहै नुआहरै काम आसा किऐ दै।<verse eid="PSA 78:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />बिधाता दैनअ याकबे आद-लुआद इज़राईली मणछा लै आपणअ बधान।</para>
  <para style="q" vid="PSA 78:5">तेऊ आसा म्हारै दाद-बाब नैरी-समझ़ाऊई डाहै दै कि</para>
  <para style="q" vid="PSA 78:5">तेऊओ बधान डाहै पठी आपणैं शोहरू-माठै का खोज़ी,<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />ताकि हर पोस्तीए मणछा बधाने शिक्षा भेटे अर</para>
  <para style="q" vid="PSA 78:6">तिंयां तेऊ बधाना आगली पोस्ती का खोज़े।<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />इहअ करै हणअ तिन्‍नां परमेशरा दी पाक्‍कअ भरोस्सअ,</para>
  <para style="q" vid="PSA 78:7">नां तिंयां परमेशर बिधाता किऐ दै महान कामां बिस्सर्नै।</para>
  <para style="q" vid="PSA 78:7">तेखअ ज़िऊंणीं तिन्‍नां तेऊ साबै ज़िन्दगी ज़िहअ तेऊ हुकम आसा किअ द।<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />तै निं तिंयां आपणैं दादा-बाबा ज़िहै हठू अर</para>
  <para style="q" vid="PSA 78:8">द्रोही हणैं, ज़हा परमेशरा दी भरोस्सअ ई निं बोल़दै तै डाही</para>
  <para style="q" vid="PSA 78:8">अर नां तिंयां आप्पू बिधाता लै शुचै-पाक्‍कै रहै।<verse eid="PSA 78:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />एप्रैम गोत्रे जोधै का थिऐ जुधा करना लै अस्त्र-शस्त्र बी,</para>
  <para style="q" vid="PSA 78:9">पर ज़ांऊं जुधा करने बारी आई, तिंयां ठुर्है उंबल़ी बाखा!<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />तिन्‍नैं निं परमेशरा संघै किई दी करार पूरी किई,</para>
  <para style="q" vid="PSA 78:10">तिन्‍नैं निं बधाने साबै काम किअ।<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />बिधाता तिन्‍नां नदरी ज़ुंण नुआहरै काम अर च़मत्कार किऐ तै,</para>
  <para style="q" vid="PSA 78:11">तेता तै तिंयां बिस्सरुई गऐ दै।<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />ज़धू तिन्‍नें दाद-बाब मिसर देशे सोआन<note caller="+" style="f"><char style="fr" closed="false">78:12 </char><char style="fq" closed="false">सोआन </char><char style="ft" closed="false">अह आसा रामसेस नगरी, अह ती नील नदीए पुर्बा बाखा सेठ नगरी</char></note> सऊंऐं मुल्खै आसा तै,</para>
  <para style="q" vid="PSA 78:12">तधू किऐ तै बिधाता तिन्‍नां नदरी च़मत्कार।<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 1:11">लुआ. 1:11</ref></char></note><verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />बिधाता किअ त समुंदर दूई बाखा ओर्ही-पोर्ही दुआली ज़िहअ,</para>
  <para style="q" vid="PSA 78:13">समुंदरा मांझ़ा-मांझ़ी बात काढी टपाऊऐ तिंयां पार बाखा लै।<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />धैल़ी नढैऊऐ तिंयां तेऊ बादल़े छ़ैल्‍ली हेठै अर</para>
  <para style="q" vid="PSA 78:14">राची हांढणा लै प्रैश्शअ हआ त तिन्‍नां लै आगीओ बडअ कूंड लागअ द।<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />उज़र रेगीस्तानै काढअ तेऊ शुक्‍की टोल्हा का पाणीं,</para>
  <para style="q" vid="PSA 78:15">सारी परज़ा झुटअ रज्ज़ी पाणीं ज़िहअ कि तिन्‍नैं झुटअ बडै डुघै सअरा का।<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />टोल्हा का निखल़अ एतरअ पाणीं कि आजू</para>
  <para style="q" vid="PSA 78:16">लागअ दरैअ बगदअ।<verse eid="PSA 78:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />पर तज़ी बी रही उज़र रेगीस्तानै</para>
  <para style="q" vid="PSA 78:17">परम प्रधान परमेशर खास परज़ा<note caller="+" style="f"><char style="fr" closed="false">78:17 </char><char style="fq" closed="false">खास परज़ा </char><char style="ft" closed="false">इब्रानी लोग</char></note> पाप करदी लागी!<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />खाणां-पिणां लै मन्‍न-मरज़ीओ मांगी रहै तिंयां</para>
  <para style="q" vid="PSA 78:18">परमेशरा परखदै लागी!<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />तिंयां फिरै इहअ बोली बिधाता पटंकदै,</para>
  <para style="q" vid="PSA 78:19">“परमेशर कै उज़र रेगीस्तानै बी हाम्हां एतरै मणछो पेट रज़ैऊई सका?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />च़ल्‍ल अह गल्‍ल, हुई कि</para>
  <para style="q" vid="PSA 78:20">बिधाता काढी शुक्‍की टोल्हा का पाणींए गाड,</para>
  <para style="q" vid="PSA 78:20">पर सह कै हाम्हां एतरै मणछा लै रोटी अर</para>
  <para style="q" vid="PSA 78:20">शिखा बी सका रज्ज़ी खाणां लै दैई?”<verse eid="PSA 78:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />तिन्‍नें इना एही गल्‍ला शूणीं फिरी बिधाता बी रोश्श,</para>
  <para style="q" vid="PSA 78:21">तेऊ बरशाऊई आपणीं परज़ा याकबे आद-लुआदा<note caller="+" style="f"><char style="fr" closed="false">78:21 </char><char style="fq" closed="false">परज़ा याकबे आद-लुआदा </char><char style="ft" closed="false">याकब</char></note> लै आग अर</para>
  <para style="q" vid="PSA 78:21">तेऊ आई इज़राईली लै होर बी खास्सी रोश्शै,<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />किल्हैकि तिन्‍नैं निं तेऊ दी भरोस्सअ डाहअ,</para>
  <para style="q" vid="PSA 78:22">नां तिन्‍नैं इहअ विश्वास किअ कि बिधाता सका तिन्‍नां बच़ाऊई।<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />तेखअ किअ बिधाता बादल़ा लै हुकम संघा</para>
  <para style="q" vid="PSA 78:23">खोल्है खिरी तेऊ सरगे तीरू,<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />तेखअ दैनअ तेऊ स्वर्गा का नाज़</para>
  <para style="q" vid="PSA 78:24">ज़ेता लै खाण बोला।<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />सह दैनअ बिधाता तिन्‍नां लै खास नाज़ अर</para>
  <para style="q" vid="PSA 78:25">तिन्‍नैं सोभी खाअ सह मन्‍न-मरज़ीओ रज्ज़ी।<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />बिधाता बहाऊई पुर्बा बाखा बागरी अर</para>
  <para style="q" vid="PSA 78:26">आपणैं बला करै आणी तेऊ दखणा बाखा ढिश,<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />तेता संघै आणै तेऊ होछ़ै-होछ़ै च़ेल्‍लूओ एतरअ छ़ुंढ कि</para>
  <para style="q" vid="PSA 78:27">तिन्‍नां फेर ज़ैगा लागै तेते समुंदरे रेता ज़िहै रूल़,<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />बिधाता बशैल़ै तिंयां च़ेल्‍लू तिन्‍नें खिम्भे डेरै</para>
  <para style="q" vid="PSA 78:28">फेर सारै दी अर<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />तिन्‍नैं खाई तेते रज्ज़ी शिखा संघा</para>
  <para style="q" vid="PSA 78:29">तिन्‍नें शिखा खाणें शौक बी किई बिधाता पूरी।<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />पर अज़ी निं तिंयां खाई बी मुक्‍कै तै<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />कि बिधाता आई तिन्‍नां लै रोश्शै अर</para>
  <para style="q" vid="PSA 78:31">तिन्‍नें ज़ोर-ज़ाहणा आल़ै मर्ध अर</para>
  <para style="q" vid="PSA 78:31">खारकै मणछ पाऐ इज़राईली मांझ़ा का मारी।<verse eid="PSA 78:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />पर एतरअ हई बी रहै तिंयां पाप करदै लागी,</para>
  <para style="q" vid="PSA 78:32">तिन्‍नैं निं परमेशरे च़मत्कारे कामां दी तज़ी बी विश्वास किअ!<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />तेखअ लागै तिन्‍नें धैल़ै बृथा कामां दी बितदै अर</para>
  <para style="q" vid="PSA 78:33">तिन्‍नैं भाल़ी आपणीं अमरा आफ़ता प्रैंदै आफ़त।<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />ज़ांऊं परमेशरै बिधाता तिन्‍नां मांझ़ै धख ज़िहै मारी पाआ त,</para>
  <para style="q" vid="PSA 78:34">तिंयां होर एछा तै तेखअ बिधाता पुछ़दै,</para>
  <para style="q" vid="PSA 78:34">संघा रहा तै दिला-मन्‍नां का तेऊए च़ाकरी लागी।<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />तेखअ फिरा ती तिन्‍नां आद कि परम प्रधान परमेशर बिधाता आसा तिन्‍नां लै बडी टोल्हा ज़िहअ,</para>
  <para style="q" vid="PSA 78:35">ज़ेथ पिछ़ू लुक्‍की तिंयां बच़ी सका।<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />पर तिंयां थिऐ पाक्‍कै ठग!</para>
  <para style="q" vid="PSA 78:36">तज़ी बी निं तिन्‍नैं बिधाता सेटा झ़ुठअ बोल़णअ छ़ाडअ,<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />तिन्‍नें दिलै त बिधाता लै धोखअ ई</para>
  <para style="q" vid="PSA 78:37">नां तिन्‍नैं बिधाता संघै करार डाही पाक्‍की।<verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />तज़ी बी रहअ परमेशर तिन्‍नां लै झणैल़ू,</para>
  <para style="q" vid="PSA 78:38">तेऊ किऐ तिन्‍नें पाप माफ अर</para>
  <para style="q" vid="PSA 78:38">तेऊ निं तिन्‍नां बरैबाद हणैं दैनअ,</para>
  <para style="q" vid="PSA 78:38">तेऊ ज़िरअ कई बारी आपणअ रोश्श</para>
  <para style="q" vid="PSA 78:38">अर तेऊ निं तिन्‍नां लै झ़ाई-फांगअ बी दैनअ लागणै।<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />बिधाता डाहा ऐहा ई गल्‍ला आद कि मणछे देही हणीं खतम ई</para>
  <para style="q" vid="PSA 78:39">ज़ुंण बागरी ज़ेही डेओआ, संघा निं भिई फिरी एछदी।<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />ज़धू तिंयां उज़र रेगीस्तानै थिऐ, तिंयां करा तै कबल्‍लअ द्रोह अर</para>
  <para style="q" vid="PSA 78:40">बिधाता शोट्टअ त तिन्‍नैं दुखी करी।<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />तिंयां रहै हर बगत परमेशरा परखदै लागी,</para>
  <para style="q" vid="PSA 78:41">इहअ करै ठैऊआ तै तिंयां इज़राईले पबित्र बिधाता लै झोशा।<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />तिंयां गऐ तै बिधाते महान बला बिस्सरुई अर इहअ बी निं तिन्‍नां आद रहअ कि</para>
  <para style="q" vid="PSA 78:42">बिधाता तिंयां तिन्‍नें दुशमणा का किहअ करै आणै छ़ड़ैऊई।<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />बिधाता ज़ुंण महान काम अर च़मत्कार</para>
  <para style="q" vid="PSA 78:43">मिसर देशै सोआन सऊंऐं मुल्खै रहैऊऐ,<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />मिसर देशै गाडा-नाल़ीओ सारअ पाणीं बणाअं त लोहू अर</para>
  <para style="q" vid="PSA 78:44">मिसरी लोग गऐ तै चिशै मरी,<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />सारै देशै छ़ाडै तै बिधाता डगैछे गअण, तिन्‍नैं चुशअ तिन्‍नों लोहू अर</para>
  <para style="q" vid="PSA 78:45">सारै देश भर्हुअ मिंडकै करै, सह हुई ती तिन्‍नां लै आफ़त।<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />तिन्‍नें खेचै लागै तै घणैं किल़ै अर रैट्टै अर</para>
  <para style="q" vid="PSA 78:46">तिन्‍नें हुई ती सारी फसल बरैबाद।<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />तिन्‍नें दाखे बाग अर फेडूए बूटे फसल</para>
  <para style="q" vid="PSA 78:47">किई बिधाता शरू बरशाऊई करै बरैबाद।<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />तिन्‍नें डागै-चैणैं बी मूंऐं बडै-बडै शरू करै अर</para>
  <para style="q" vid="PSA 78:48">तिन्‍नें हेल़्ही लै पल़ी सरगा का बीज।<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />बिधाता पाई मिसरी लोगा लै घोर आफ़ता,</para>
  <para style="q" vid="PSA 78:49">खिरी आई बिधाता एही रोश्शै कि</para>
  <para style="q" vid="PSA 78:49">तेऊ छ़ाडअ तिन्‍नां मारना लै दूत।<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />तेखअ निं तेऊ आपणअ रोश्श ज़िरअ अर</para>
  <para style="q" vid="PSA 78:50">नां तिंयां तेऊ मरनै का बच़ाऊऐ।</para>
  <para style="q" vid="PSA 78:50">पर तिन्‍नां मांझ़ै पाई तेऊ मरी।<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />मिसर देशै हर घअरै ज़ेतरै ज़ेठै शोहरू आसा तै,</para>
  <para style="q" vid="PSA 78:51">तिंयां पाऐ तेऊ सोभ मारी।</para>
  <para style="q" vid="PSA 78:51">हामे<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="fq" closed="false">हामे </char><char style="ft" closed="false">हामो डेरअ बोला तै मिसर देशा लै, हाम थिअ नूहो शोहरू, इहअ बोला तै कि हाम थिअ मिसरी लोगो मूल़ बाब।</char></note> डेरै दी ज़ेतरै पैहलै फल़ थिऐ।<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="GEN 10:6">मूल. 10:6</ref>; <ref loc="PSA 105:23">भज. 105:23</ref>,<ref loc="PSA 105:27">27</ref>; <ref loc="PSA 106:22">106:22</ref></char></note><verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />पर आपणीं परज़ा छाहकी तेऊ भेडा-बाकरीए हेल़्ही ज़ेही मिसर देशा का बागै,</para>
  <para style="q" vid="PSA 78:52">आप्पू रहअ फुआला ज़िहअ तिन्‍नां आजू-आजू हांढदअ लागी।<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />तिंयां रहै राज्ज़ी-मौज़ी आजू हांढदै लागी अर तिन्‍नां निं किछ़ै डअर-भगैर आथी ती।</para>
  <para style="q" vid="PSA 78:53">पर तिन्‍नें दुशमण हुऐ समुंदरा दी डुबी मरी खतम।<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />बिधाता पजैल़ै तिंयां आपणीं पबित्र ज़ैगा नेल़ तैहा धारा<note caller="+" style="f"><char style="fr" closed="false">78:54 </char><char style="fq" closed="false">धारा </char><char style="ft" closed="false">सियोन</char></note> तेऊ देशे सिऊंआं</para>
  <para style="q" vid="PSA 78:54">ज़ुंण तेऊ आप्पै त तिन्‍नां लै गिम्मी डाहअ द।<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />तेता का आजी हेरै तेऊ देशा का बिधाता पराई ज़ातीए लोग पोर्ही काढी;</para>
  <para style="q" vid="PSA 78:55">संघा दैनी तिन्‍नें सारी ज़ैगा-ज़िम्मीं इज़राईले बारा गोत्रा लै बांडी अर</para>
  <para style="q" vid="PSA 78:55">तिन्‍नें डेरै बी गिम्मै पठी इज़राईली आप्पू लै।<verse eid="PSA 78:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />पर तज़ी बी रहै इज़राईली बिधाता परखदै लागी अर</para>
  <para style="q" vid="PSA 78:56">परम प्रधान परमेशरो बधान निस्सअ तिन्‍नां रप्पी!</para>
  <para style="q" vid="PSA 78:56">नां तिंयां तेऊओ हुकम निस्सै मनी।<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />तिंयां थिऐ आपणैं दादा-बाबा ई ज़िहै विश्वास घाती अर कदुष्ट,</para>
  <para style="q" vid="PSA 78:57">तिंयां थिऐ इहै कबाणा ज़िहै ज़ेता का कतीर छ़ाडी नशाणअ ई निं लागदअ!<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />बिधाता च़ाहा त इहअ कि तिंयां पठी तेऊ लै झ़ूरै,</para>
  <para style="q" vid="PSA 78:58">पर तिन्‍नैं ठैऊई मैहरै अर ओडै पूज़ी करै बिधाता लै रोश्श।<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />इहअ भाल़ी आई बिधाता रोश्शै अर</para>
  <para style="q" vid="PSA 78:59">तेऊ छ़ाडै तेखअ इज़राईली ज़ातै का पठी।<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />इज़राईली मणछा जैंदरी शिलोह नगरी घैऊऐ दै ज़हा खिम्भा दी बिधाता एछा त,</para>
  <para style="q" vid="PSA 78:60">तेऊ शांतीए खिम्भा दी एछणें बी पाई तेऊ छ़ाड़।<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />करारो मणशू ज़ुंण बिधाते शोभा अर बलो नछ़ैण थिअ,</para>
  <para style="q" vid="PSA 78:61">तेता बी दैनअ तेऊ दुशमणा गिम्मणै।<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />तेऊ ती आपणीं खास परज़ा लै रोश्शै आई दी अर</para>
  <para style="q" vid="PSA 78:62">तैही दैनअ तेऊ तिन्‍नां दुशमणे हाथै तलबारा करै मरनै।<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />इज़राईलीए खारकै मणछ मूंऐं जुधा लै अर</para>
  <para style="q" vid="PSA 78:63">खारकी बेटल़ी संघै निं कुंण बैहा करनै आल़अ बी छ़ुटअ!<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />प्रोहत पाऐ तलबारा करै काटी अर</para>
  <para style="q" vid="PSA 78:64">तिन्‍नें बिधबा बेटल़ी निं शोग बी दैनअ मनाऊंणै।<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />तेखअ उझ़ुअ खिरी मालक ज़िहअ निंजा का,</para>
  <para style="q" vid="PSA 78:65">ज़िहअ नशै आल़ै दाखे रसा झुटी जोधअ क्रुंगा।<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />तेऊ खद्रेल़ै दुशमण इहै कि</para>
  <para style="q" vid="PSA 78:66">तिंयां हुऐ सदा लै शर्मिंदै।<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />तेखअ छ़ाडै बिधाता युसुफे आद-लुआद अर</para>
  <para style="q" vid="PSA 78:67">नां तेऊ एप्रैम गोत्रे मणछ छ़ांटै,<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />इना छ़ाडी छ़ांटअ तेऊ यहूदा गोत्र अर</para>
  <para style="q" vid="PSA 78:68">सियोन धार ज़ेता लै सह आप्पू खास्सअ झ़ूरा।<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />तिधी बणाअं तेऊ आपणअ भबन</para>
  <para style="q" vid="PSA 78:69">ज़िहअ घअर तेऊओ स्वर्गै आसा,</para>
  <para style="q" vid="PSA 78:69">तेऊ बणाअं सह इहअ पाक्‍कअ ज़ेही पृथूई आसा पाक्‍की टकैल़ी दी,</para>
  <para style="q" vid="PSA 78:69">सह बणाअं सदा लै मूल़।<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />तेखअ छ़ांटअ तेऊ आपणअ दास दाबेद,</para>
  <para style="q" vid="PSA 78:70">सह आणअ तेऊ भेडा-बाकरीए शाल़ा का लोल़ी।<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />ज़िधी भेडा-बाकरीए हेल़्ही च़राऊंदअ हआ त,</para>
  <para style="q" vid="PSA 78:71">तेखअ बणाअं बिधाता सह आपणीं खास परज़ा याकबे आद-लुआदो राज़अ कि</para>
  <para style="q" vid="PSA 78:71">सह फुआला ज़ेही इज़राईलीए फाज़त करे।<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />राज़अ दाबेद रहअ दिल-मन्‍न लाई तिन्‍नें फाज़त करदअ लागी</para>
  <para style="q" vid="PSA 78:72">अर आपणीं अक्ल अर समझ़ा करै रहअ सह तिन्‍नां लै सलाह दैंदअ लागी।<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">इज़राईलीए छ़ुटकारै लै बिधाता का अरज़</para>
  <para style="d">असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />हे परमेशर, पराई ज़ाती गिम्मी तेरी ज़ैगा,</para>
  <para style="q" vid="PSA 79:1">तिन्‍नैं लोगै लाई तेरै पबित्र भबनै छ़ोत अर</para>
  <para style="q" vid="PSA 79:1">एरुशलेम नगरी किई तिन्‍नैं पठी बरैबाद।<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />तिन्‍नैं डाही तेरै आपणैं लोगे ल्हासा शोटी, तेथ लागै काअ-गरली!</para>
  <para style="q" vid="PSA 79:2">तेरै भगते ल्हासा धेल़ी-च़िरी बणें ज़ीबै।<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />तिन्‍नैं बहाऊआ तेरै लोगो लोहू</para>
  <para style="q" vid="PSA 79:3">पाणीं ज़िहअ सारी एरुशलेम नगरी,</para>
  <para style="q" vid="PSA 79:3">तेथ निं मूंऐं दै मणछे क्रिया-कर्म करदअ बी पिछ़ू छ़ुटअ।<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />एता भाल़ी लागै हाम्हां फेरे होर देश बी हाम्हां लै हास्सदै अर</para>
  <para style="q" vid="PSA 79:4">म्हारै सुहांगा करदै, तिन्‍नैं शोटै हाम्हैं शर्मिंदै करी।<verse eid="PSA 79:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />हे बिधाता, ताह कै सदा रहणअ हाम्हां का रुश्शी अर तेरअ रोश्श कै कधि निं हणअ ठांढअ?</para>
  <para style="q" vid="PSA 79:5">तेरी रोश्शे आग कै कबल्‍ली रहणीं ज़ल़दी लागी?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />तूह काढ आपणअ रोश्श तिन्‍नां मणछा प्रैंदै,</para>
  <para style="q" vid="PSA 79:6">ज़ुंण बगैनी ज़ाती ताह नांईं मंदी अर ज़ुंण ताह सेटा अरज़ नांईं करदै।<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />किल्हैकि तिन्‍नैं पाऐ तेरै आपणीं ई परज़ा याकबे आद-लुआद मारी, अर</para>
  <para style="q" vid="PSA 79:7">तिन्‍नैं किअ तेरअ देश बरैबाद।<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />म्हारै दादा-बाबे पापा पिछ़ू निं हाम्हां लै सज़ा दैऐ आथी।</para>
  <para style="q" vid="PSA 79:8">ऐबै कर तूह हाम्हां लै झींण,</para>
  <para style="q" vid="PSA 79:8">ऐबै हुई म्हारी बेघै बूरी दशा!<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />हे परमेशर, म्हारी मज़त कर अर हाम्हां बच़ाऊ,</para>
  <para style="q" vid="PSA 79:9">म्हारै पाप माफ करी दै हाम्हां लै छ़ुटकारअ,</para>
  <para style="q" vid="PSA 79:9">ताकि तेरै नाओं अदर होए।<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />पराई ज़ातीए लोगा लै किल्है दैणअ इहअ बोल़णैंओ मोक्‍कअ,</para>
  <para style="q" vid="PSA 79:10">“थारअ परमेशर किधी आसा?”</para>
  <para style="q" vid="PSA 79:10">हाम्हां लोल़ी आपणीं आछी शुझुअ कि तंऐं दैनी आपणैं लोगे लोहू बहाऊंणैं पिछ़ू</para>
  <para style="q" vid="PSA 79:10">पराई ज़ातीए लोगा लै सज़ा।<note caller="-" style="x"><char style="xo" closed="false">79:10 </char><char style="xt" closed="false"><ref loc="REV 6:10">प्रका. 6:10</ref>; <ref loc="REV 19:2">19:2</ref></char></note><verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />ज़ुंण कैद आसा किऐ दै तिंयां आसा धकदै लागै दै, तेता शुण तूह,</para>
  <para style="q" vid="PSA 79:11">ज़ुंण ऐबै मारी आसा लाऐ दै, तिन्‍नां छ़ड़ैऊ तूह आपणैं बला करै।<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />हे मेरै मालक, ज़ुंणी-ज़ुंणी देशै तेरअ सुहांग किअ,</para>
  <para style="q" vid="PSA 79:12">तेतो बदल़अ लऐ तूह तिन्‍नां का सात गुणा।<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />तै करनअ हाम्हां तेरी आपणीं परज़ा कबल्‍लअ तेरअ शूकर,</para>
  <para style="q" vid="PSA 79:13">हाम्हैं आसा तेरै ई हेल़्हीए भेडा,</para>
  <para style="q" vid="PSA 79:13">हाम्हां रहणअ पोस्ती दर पोस्ती तेरी ज़ै-ज़ैकार करदै लागी।<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">इज़राईली लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै: शोशत्रीमेदूत रागा दी असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />हे इज़राईले फुआला, ज़ीबाण, म्हारी शुण,</para>
  <para style="q" vid="PSA 80:1">तूह छाहका युसुफे आद-लुआदा भेडा-बाकरीए हेल़्ही ज़िहै।</para>
  <para style="q" vid="PSA 80:1">हे परमेशर, तूह ज़ुंण फैंखा आल़ै स्वर्ग दूता प्रैंदै आसा बेठअ द,</para>
  <para style="q" vid="PSA 80:1">तूह रहैऊ आपणीं शोभा हाम्हां का।<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />तूह हअ एप्रैम, बिन्यामीन अर मनिश्शे गोत्रा दी प्रगट।</para>
  <para style="q" vid="PSA 80:2">तूह रहैऊ हाम्हां का आपणअ बल,</para>
  <para style="q" vid="PSA 80:2">तूह एछ संघा बच़ाऊ हाम्हां।<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />हे परमेशर, हाम्हां कर तिहै ई ज़िहै हाम्हैं पैहलै आसा तै,</para>
  <para style="q" vid="PSA 80:3">हाम्हां बाखा भाल़ प्रैश्शै मुंहैं, तै जाणै हाम्हैं बच़ी।<verse eid="PSA 80:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />ए स्वर्गे सारी सैने मालक बिधाता, हाम्हैं आसा तेरी परज़ा,</para>
  <para style="q" vid="PSA 80:4">केभै तैणीं रहणीं ताह म्हारी प्राथणां लै रोश्शै एछी?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />तंऐं खैऊअ हाम्हां का बतेर्है दुख अर</para>
  <para style="q" vid="PSA 80:5">भरी-भरी गाडल़ू पणैऊंऐं तंऐं हाम्हां का आशूए।<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />हाम्हैं हुऐ ओरी-पोरी बस्सै दै दुशमण देशा मांझ़ै सुहांगा लै,</para>
  <para style="q" vid="PSA 80:6">तिन्‍नैं किऐ हाम्हैं बेइज़त।<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />ए स्वर्गे सारी सैने मालक बिधाता, हाम्हां कर तिहै ई ज़िहै हाम्हैं पैहलै आसा तै,</para>
  <para style="q" vid="PSA 80:7">हाम्हां बाखा भाल़ प्रैश्शै मुंहैं, तै जाणै हाम्हैं बच़ी।<verse eid="PSA 80:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:11">ईशा. 5:11</ref>
      </char>
    </note>तंऐं आणी मिसर देशा का एक दाखे बेल,</para>
  <para style="q" vid="PSA 80:8">तंऐं काढै पराई ज़ातीए लोग बागै, संघा डाही सह तिन्‍नें देशै रोही।<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />तेता लै बणाईं तंऐं बिधाता ज़िम्मीं बधिया ताकि सह राम्बल़ी राझ़े,</para>
  <para style="q" vid="PSA 80:9">तेते ज़लैल़ै बी डुघै डेओए अर सह सारै देशै छिंघिए।<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />सह बेल बझ़ी उझै बडी-बडी केल़ुई च़ुंडी तैणीं अर</para>
  <para style="q" vid="PSA 80:10">तैहा बेले ताला करै लागी बडी-बडी धारा बी छ़ैल्‍ली।<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />तेते टिरा पुजी बझ़ी करै मांझ़ समुंदर अर</para>
  <para style="q" vid="PSA 80:11">फरात दरैऊआ तैणीं।<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />ऐबै तेऊ बागा फेर-फिरदै बाल़-शोहल़ किल्है पाऐ तंऐं ढोल़ी?</para>
  <para style="q" vid="PSA 80:12">ऐबै लागै कज़ोहै बागा दी पेशी दाखा च़ोरदै एछदै!<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />बणें सुंगरै लाअ तेथ करोल़अ डाही पाई,</para>
  <para style="q" vid="PSA 80:13">बणें ज़ीबै लाई तेते फसल खाई।<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />ए स्वर्गे सारी सैने मालक बिधाता, सारअ बल आसा ताखा ई,</para>
  <para style="q" vid="PSA 80:14">ज़ीबाण, स्वर्गा का भाल़ हाम्हां बाखा उंधै,</para>
  <para style="q" vid="PSA 80:14">हाम्हैं आसा तेरी परज़ा, हाम्हां बच़ाऊ।<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />तंऐं आसा अह दाखे बेल आपणैं हाथै रोही दी,</para>
  <para style="q" vid="PSA 80:15">तंऐं ई आसा आप्पै एथ बझ़ा छ़ाडी दी!<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />दुशमणै पाअ तेतो ताल झोटी, संघा चैल़ी तेथ आग!</para>
  <para style="q" vid="PSA 80:16">तिन्‍नां बाखा फिर तूह रोश्शै संघा कर तिन्‍नां दुशमणा पठी बरैबाद।<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />पर तिन्‍नां मणछे कर फाज़त ज़ुंण तंऐं आप्पू लै आसा छ़ांटै दै अर</para>
  <para style="q" vid="PSA 80:17">सह देश ज़हा लै तंऐं आसा बल दैनअ द।<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />ऐबै निं हाम्हां भिई ताखा दूर हंदै,</para>
  <para style="q" vid="PSA 80:18">हाम्हां लै दै ऐबै नऊंईं ज़िन्दगी, ताकि हाम्हैं तेरी ज़ै-ज़ैकार करी सके।<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />ए स्वर्गे सारी सैने मालक बिधाता, हाम्हां कर तिहै ई ज़िहै हाम्हैं पैहलै आसा तै,</para>
  <para style="q" vid="PSA 80:19">हाम्हां बाखा भाल़ प्रैश्शै मुंहैं, तै जाणै हाम्हैं बच़ी।<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">बिधाता दैआ हाम्हां लै बल</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै: गित्तीथ रागा दी असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />म्हारअ बल आसा परमेशर, तेऊए करा ज़ोरै-ज़ोरै ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 81:1">ज़हा परमेशरा याकब मना, तेऊओ बोला भज़न!<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />गिहा बोला, संघा बाज़ा डफली, बींन, सरनाई</para>
  <para style="q" vid="PSA 81:2">अर भांती-भांतीए बाज़ै।<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />तेऊए थैरा लै अर</para>
  <para style="q" vid="PSA 81:3">पुनूंईए धैल़ै बाज़ा नर्शिंगै।<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />ज़हा परमेशरा याकब मना,</para>
  <para style="q" vid="PSA 81:4">तेऊ आसा इज़राईला लै अह ई बधान खोज़अ द।<verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />तेऊ दैनअ अह बधान युसुफे खिंब इज़राईली लै तधू,</para>
  <para style="q" vid="PSA 81:5">ज़धू मिसर देशे खलाफ जुध छ़ेल़अ।</para>
  <para style="q" vid="PSA 81:5">तिधी शूणैं मंऐं पाखली बोली दी इहै बोल:<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />“थारी कान्हो बोझ़अ काढअ ऐबै मंऐं पोर्ही अर</para>
  <para style="q" vid="PSA 81:6">थारी पिठीओ गर्कअ भर्टू बशैल़अ मंऐं धरनीं।<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />खरीए पलका पाई तम्हैं मुंह सेटा लेर-पकार, ऐबै हेरै मंऐं तम्हैं बच़ाऊई।<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">लुआ. 17:1-7</ref>; <ref loc="NUM 20:2-13">गण. 20:2-13</ref>; <ref loc="PSA 95:8">भज. 95:8</ref>,<ref loc="PSA 95:9">9</ref></char></note></para>
  <para style="q" vid="PSA 81:7">ज़िधा का गुल़ूबिज़ल़ू लागा, तैहा गुप्त ज़ैगा का शूणीं मंऐं थारी अरज़।</para>
  <para style="q" vid="PSA 81:7">मरीबा नाओंए सोबल़ा सेटा हेरै मंऐं तम्हैं परखी।<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />इज़राईलीओ, शूणां, तम्हैं आसा मेरी परज़ा, मंऐं डाहै तम्हैं नैरी कि</para>
  <para style="q" vid="PSA 81:8">भलअ हणअ त इहअ कि तम्हैं मेरी ई शुणदै!<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />तम्हैं निं हेरे होरी देअआ पूज़दै लागी।<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />हुंह बिधाता ई आसा थारअ परमेशर</para>
  <para style="q" vid="PSA 81:10">ज़ुंणी तम्हैं मिसर देशे गलामी का आसा छ़ड़ैऊई आणै दै।</para>
  <para style="q" vid="PSA 81:10">तम्हां आसा सिधी बोल़णें बेर, हुंह दैंऊं थारी ज़रुरतीए सोभै गल्‍ला।<verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />पर तम्हैं मेरी खास परज़ा निं मेरी गल्‍ला शूणीं!</para>
  <para style="q" vid="PSA 81:11">अर तम्हैं इज़राईली निं मुल्है झ़ूरै!<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />मंऐं दैनअ तम्हां थारी हठी दी रहणैं कि</para>
  <para style="q" vid="PSA 81:12">ज़ेही थारी सलाह होए, तम्हैं लागे तिहअ ई करदै।<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />भलअ हणअ त इहअ कि तम्हैं मेरी परज़ा</para>
  <para style="q" vid="PSA 81:13">ज़िहअ हुंह बोले तिहअ ई शुणदै अर करदै!<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />तै करनै तै मुंह घल़ी-पला दी थारै दुशमण खतम अर</para>
  <para style="q" vid="PSA 81:14">थारै बैरी पल़णीं ती मेरी मार।<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />ज़ुंण मुंह बिधाता लै नफरत करा, तिन्‍नां रघोल़णअ त मुंह सेटा नाक,</para>
  <para style="q" vid="PSA 81:15">तिंयां हणैं तै सदा लै शर्मिंदै।<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />पर तम्हैं रज़ैऊंणै तै मुंह बधिया का बधिया कणके रोटी अर</para>
  <para style="q" vid="PSA 81:16">बणें मखीरा खैऊई करै।”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">नसाफ करना लै अरज़</para>
  <para style="d">असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />परमेशर आसा स्वर्गै पबित्र सभा दी नसाफ करदअ बेठअ द,</para>
  <para style="q" vid="PSA 82:1">तैहा सभा दी आसा होर देअ-देबी<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="fq" closed="false">देअ-देबी </char><char style="ft" closed="false">ज़ेता लै लोग इहअ ज़ाणा कि तिंयां आसा दईब</char></note> बेठै दै अर तिधी बोला परमेशर तिन्‍नां लै इहअ:<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />“तम्हैं गलत नसाफ करनअ लाअ छ़ाडी कि नांईं?</para>
  <para style="q" vid="PSA 82:2">तम्हां केभै तैणीं रहणअ कदुष्ट मणछे तरफदारी करदै लागी?<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />रैनै-गरीब अर छ़ुटै-मुक्‍कै दै लान्हैंओ नसाफ किल्है निं तम्हैं करदै?</para>
  <para style="q" vid="PSA 82:3">ज़हा ज़रुरत आसा अर ज़हा आसरअ लोल़ी, तम्हैं किल्है निं तिन्‍नें मज़त करदै?<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />तिन्‍नां किल्है निं तम्हैं कदुष्ट मणछे हाथा का बच़ाऊंदै?<verse eid="PSA 82:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />तम्हां निं परबाह ई आथी! तम्हैं किहै कमुर्ख आसा!</para>
  <para style="q" vid="PSA 82:5">तम्हैं सोभै आसा पठी भ्रष्ट हुऐ दै,</para>
  <para style="q" vid="PSA 82:5">सारै संसारै निं नसाफ रहअ ई आथी!<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:6 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">जोह. 10:34</ref>
      </char>
    </note>हुंह बोला इहअ, ‘तम्हैं आसा दईब अर</para>
  <para style="q" vid="PSA 82:6">तम्हैं आसा मुंह परम प्रधान परमेशरे पूत,<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />तज़ी बी मरनै तम्हैं मणछा ज़िहै,</para>
  <para style="q" vid="PSA 82:7">थारी ज़िन्दगी बी हणीं तिन्‍नें तिन्‍नां ई मांझ़ै कहा राज़ै ज़ेही खतम।’”<verse eid="PSA 82:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />हे परमेशर, एछ, तूह कर संसारै आप्पै राज़,</para>
  <para style="q" vid="PSA 82:8">संसारे सोभी देशे लोग आसा तेरै ई।<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">बिधाता करा सारै संसारै राज़</para>
  <para style="d">असापो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />हे परमेशर, ऐबै निं च़ुप्पी रहै,</para>
  <para style="q" vid="PSA 83:1">इहअ नकैंस्सअ निं रहै!<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />भाल़! तेरै दुशमणे आसा मौज़ लागी दी,</para>
  <para style="q" vid="PSA 83:2">ज़ुंण ताह संघै ज़ीद डाहा, तिन्‍नें किअ तेरअ बरोध।<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />तिन्‍नैं किअ आप्पू मांझ़ै तेरी परज़ा हंतणा लै जोग,</para>
  <para style="q" vid="PSA 83:3">तेरै खज़ानै लुटणां लै आसा तिंयां कई बिक्री करदै लागै दै।<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />तिंयां करा आप्पू मांझ़ै एही गल्‍ला,</para>
  <para style="q" vid="PSA 83:4">“एछा, हाम्हां करनअ इज़राईल देश इहअ बरैबाद कि</para>
  <para style="q" vid="PSA 83:4">एतो निं नाअं-नशाण लोल़ी रहअ!”<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />तिन्‍नैं सोभी आसा तेरै खलाफ इहअ करना लै एक्‍कअ किअ द अर</para>
  <para style="q" vid="PSA 83:5">आप्पू मांझ़ै एते पाक्‍की करार डाही दी करी।<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />ईंयां एक्‍कअ करनै आल़ै आसा एदोम देशे लोग, इशमाईली,</para>
  <para style="q" vid="PSA 83:6">मोआबी लोग, हागारी,<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />गेबली, अमोनी, अमोलकी,</para>
  <para style="q" vid="PSA 83:7">पलिश्ती अर सूर देशे लोग।<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />अश्शूरी लोग बी आसा इना ई संघै ज़ुल़ै दै अर लूते आद-लुआद</para>
  <para style="q" vid="PSA 83:8">अमोनी अर मोआबी बी आसा इना बाखा फिरै दै।<verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />तिन्‍नां सोभी लै दै तेही ई सज़ा ज़ेही तंऐं मिद्यानी लै अर</para>
  <para style="q" vid="PSA 83:9">किशोन गाडा सिसरा अर ज़बीना लै सज़ा दैनी ती।<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />तिंयां मारै तै तंऐं एनदोर नगरी नेल़ अर</para>
  <para style="q" vid="PSA 83:10">तिन्‍नें ल्हासा चिजी-शल़ी पल़अ तैहा ज़ैगा मैल।<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />तिन्‍नां लै बी कर तिहअ ई, ज़िहअ बभार तंऐं ओरेब अर ज़ीबे<note caller="+" style="f"><char style="fr" closed="false">83:11 </char><char style="fq" closed="false">ओरेब अर ज़ीबे </char><char style="ft" closed="false">ईंयां तै दूई मिद्यानी टिक्‍कै अर ईंयां पाऐ तै एप्रैमी लोगै मारी</char></note> लोगा संघै किअ,</para>
  <para style="q" vid="PSA 83:11">तिन्‍नां प्रैंदै राज़ करनै आल़ै खद्रेल़ जेबाह अर सल्मुने राज़ै ज़िहै,<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />ज़ुंणी इहअ बोलअ त,</para>
  <para style="q" vid="PSA 83:12">“हाम्हां गिम्मणी बिधाते ज़ैगा आप्पू लै।”<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />हे परमेशर, इना फर्ल़ाऊ कुर्लू बागरी धूल़ै अर</para>
  <para style="q" vid="PSA 83:13">बागरी करै भुखलै ज़िहै।<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />ज़िहै आगी करै बण खतम हआ अर</para>
  <para style="q" vid="PSA 83:14">ज़ेही एकी झ़ोलै करै सारी धारा आग शाचा,<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />तिहै ई फर्ल़ाऊ इना तूह आपणीं ढिश-बागरी करै</para>
  <para style="q" vid="PSA 83:15">तेरै ढिश डुआल़ै करै लोल़ी इना काम्मणीं छ़ुटी!<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />हे बिधाता, तिन्‍नैं लोल़ी शर्मिंदै हई मुंह शेऊऐ,</para>
  <para style="q" vid="PSA 83:16">तिन्‍नां का लोल़ी तेरै बलो थोघ लागअ।<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />तिंयां लोल़ी तै इहै हारै तैहा डरा का निं तिन्‍नों पिछ़अ कधि लोल़ी छ़ुटअ,</para>
  <para style="q" vid="PSA 83:17">तिंयां लोल़ी पठी नाक-नकटी हई मूंऐं।<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />ताकि तिन्‍नां का थोघ लागे कि तूह बिधाता आसा परम प्रधान परमेशर एक्‍कै</para>
  <para style="q" vid="PSA 83:18">ज़ुंण सारी पृथूई दी राज़ करा।<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">बिधाते च़ाकरी दी नंद</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै गित्तीथ रागा दी कोराह खिंबे भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />ए स्वर्गे सारी सैने मालक बिधाता, हुंह झ़ूरा तेरै बसेरै लै बेघै!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />हुंह च़ाहा दिला का तेरै बसेरै दी पुजणअ!</para>
  <para style="q" vid="PSA 84:2">हुंह आसा तन-मन्‍न लाई ताह ज़िऊंदै परमेशर बिधाते</para>
  <para style="q" vid="PSA 84:2">खुशी-खुशी गिहा बोल्दअ लागअ द।<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />ए स्वर्गे सारी सैने मालक बिधाता, तूह आसा</para>
  <para style="q" vid="PSA 84:3">मेरअ परमेशर मेरअ राज़अ,</para>
  <para style="q" vid="PSA 84:3">हिंऊंल़ी च़ेल्‍ली भेटी तेरी बेदी नेल़ रहणा लै ज़ैगा अर</para>
  <para style="q" vid="PSA 84:3">फिंच़ी च़ेल्‍ली लै बी बणाअं तिधी कोल्ह</para>
  <para style="q" vid="PSA 84:3">अर तिधी धाचै तिन्‍नैं आपणैं होछ़ै-होछ़ै च़ेल्‍लू।<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />ज़ुंण तेरै बसेरै दी रहा, तिन्‍नां लै दैआ तूह बर्गत,</para>
  <para style="q" vid="PSA 84:4">तिंयां करा हर बगत तेरी ज़ै-ज़ैकार।<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />तूह दैआ तिन्‍नां लै बर्गत ज़ुंण तेरै ज़ोरे आसरै रहा अर</para>
  <para style="q" vid="PSA 84:5">ज़ुंण मणछ असली दी दिला का तेरै बसेरै<note caller="+" style="f"><char style="fr" closed="false">84:5 </char><char style="fq" closed="false">तेरै बसेरै </char><char style="ft" closed="false">सियोन धारा बाखा </char></note> लै एछणअ च़ाहा।<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />ज़ांऊं तिंयां लेरनै-पकारने शुक्‍कै खागा बाती हांढ दैआ,</para>
  <para style="q" vid="PSA 84:6">तिधी बगा शांतीए सोबल़ा</para>
  <para style="q" vid="PSA 84:6">अर सह हआ च़ैत्रै-बशाहे बरसाती करै हरी-भरी।<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />तेरै लोग रहा उझै बझ़दै ई लागी,</para>
  <para style="q" vid="PSA 84:7">तिन्‍नां मांझ़ै एछणअ हरेक मणछ ताह बिधाता सेटा सियोना लै।<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />ए स्वर्गे सारी सैने मालक बिधाता, ताह ज़ुंण याकब मना,</para>
  <para style="q" vid="PSA 84:8">तूह शुण मेरी अरज़!<verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />हे परमेशर, तूह आसा हाम्हां लै ढाल़ा ज़िहअ, म्हारै तेऊ राज़ै लै दै तूह बर्गत,</para>
  <para style="q" vid="PSA 84:9">ज़ुंण तंऐं आप्पै आसा छ़ांटअ द।<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />तेरै बसेरै एकी धैल़ै रहणअ आसा</para>
  <para style="q" vid="PSA 84:10">हज़ार साला ज़िऊंणै का बित्तअ,</para>
  <para style="q" vid="PSA 84:10">कदुष्टे डेरै रहणैं का भलअ आसा मुल्है</para>
  <para style="q" vid="PSA 84:10">तेरै दुआरे डेहल़ै बेशी रहणअ भलअ।<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />हे बिधाता, म्हारी फाज़त करनै आल़अ महान राज़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 84:11">तूह दैआ हाम्हां लै इज़त अर जशे बर्गत।</para>
  <para style="q" vid="PSA 84:11">ज़ुंण मणछ धर्मीं ज़िन्दगी ज़िऊआ,</para>
  <para style="q" vid="PSA 84:11">तिन्‍नां लै निं तूह भली च़िज़ा दैणैं का पिछ़ू हटदअ।<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />ए स्वर्गे सारी सैने मालक बिधाता, ज़ुंण मणछ तेरै आसरै रहा,</para>
  <para style="q" vid="PSA 84:12">तिन्‍नां लै दैआ तूह बर्गत।<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">सारै देशा लै बिधाता का अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै: कोराह खिंबा आल़ैओ भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />हे बिधाता, तंऐं दैनी आपणीं ज़ैगा लै बर्गत,</para>
  <para style="q" vid="PSA 85:1">तंऐं किऐ याकबे आद-लुआद भिई भरै-पूरै।<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />तंऐं किऐ आपणीं परज़े पाप माफ अर</para>
  <para style="q" vid="PSA 85:2">तिन्‍नें गलती बी निं तंऐं आद डाही।<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />ऐबै हुअ तिन्‍नां लै तेरअ रोश्श खतम अर</para>
  <para style="q" vid="PSA 85:3">ऐबै गअ तेरअ कोप तिन्‍नां का दूर हई।<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />ए म्हारै परमेशर बिधाता, हाम्हां बच़ाऊंणै आल़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 85:4">ज़ीबाण, ऐबै निं हाम्हां लै रोश्शै आणी, हाम्हां दै ऐबै म्हारै घअरै पजैल़ी।<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />ताह कै हाम्हां का कबल्‍लै रहणअ रुश्शी?</para>
  <para style="q" vid="PSA 85:5">तेरअ रोश्श कै पोस्ती-दर पोस्ती हाम्हां लै इहअ ई च़ाल्‍लअ रहई?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />तंऐं कै हाम्हां लै नऊंईं ज़िन्दगी दैई निं लाई कि</para>
  <para style="q" vid="PSA 85:6">हाम्हैं तैहा खुशी तेरी ज़ै-ज़ैकार करे?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />ज़िहअ तूह आसा ऐबै झ़ूर हाम्हां लै तूह तिहअ ई</para>
  <para style="q" vid="PSA 85:7">संघा बच़ाऊ हाम्हां।<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />हुंह आसा शूणअ लागअ द कि तूह परमेशर बिधाता किज़ै बोला,</para>
  <para style="q" vid="PSA 85:8">तंऐं आसा हाम्हां आपणीं परज़ा लै ज़बान दैनी दी कि</para>
  <para style="q" vid="PSA 85:8">ज़ै हाम्हैं आपणैं ऐडी बाता का पिछ़ू हटे, तै करनअ ताह म्हारअ मेल़-ज़ोल़।<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />ऐबै जाणैं तिंयां बच़ी ज़ुंण तेरी डरा हेठै रहा,</para>
  <para style="q" vid="PSA 85:9">तूह बस्सणअ ऐबै आपणीं सारी शोभा संघी हाम्हां संघै।<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />ऐबै हणैं तेरी झ़ूरी अर सत्त कठा अर</para>
  <para style="q" vid="PSA 85:10">भलाई अर मेल़-ज़ोल़ रहणैं एकी-दुजै का मल़्हैछुई।<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />धरती दी जाणअ ऐबै सत्त बझ़ी अर</para>
  <para style="q" vid="PSA 85:11">तेरअ धर्मीं नसाफ होथणअ स्वर्गा का उंधै।<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />हे बिधाता, ताह हेरनी ऐबै हाम्हां लै बर्गत दैई अर</para>
  <para style="q" vid="PSA 85:12">म्हारी ज़ैगा-ज़िम्मीं दी हणीं ऐबै खास्सी फसल।<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />बिधाता आजू हांढणअ ऐबै धर्म,</para>
  <para style="q" vid="PSA 85:13">ताकि सह तेऊए गंईं बशैल़णा लै बात सरली करे।<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">मज़त मांगणा लै प्राथणां</para>
  <para style="d">राज़ै दाबेदे अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />हे बिधाता, ज़ीबाण,</para>
  <para style="q" vid="PSA 86:1">मुंह रैनै-गरीबे अरज़ शुण।<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />मुंह बच़ाऊ मरनै का, किल्हैकि हुंह निं विश्वास घाती आथी,</para>
  <para style="q" vid="PSA 86:2">मुंह बच़ाऊ, हुंह आसा तेरअ दास अर हुंह डाहा ताह प्रैंदै भरोस्सअ।<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />हे मेरै मालक, मुल्है कर झींण,</para>
  <para style="q" vid="PSA 86:3">हुंह हआ सारी-सारी धैल़ी ताह सेटा अरज़ करदअ लागअ द।<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />हे मेरै मालक, ऐबै दै मेरअ दिल खुश करी,</para>
  <para style="q" vid="PSA 86:4">हुंह करा तेरी च़ाकरी अर मेरअ मन्‍न हआ ताह ई बाखा लागअ द।<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />तूह आसा हाम्हां लै भलअ अर तूह करा हाम्हां माफ,</para>
  <para style="q" vid="PSA 86:5">ज़ुंण ताखा अरज़ करा, तिन्‍नां लै झ़ूरा तूह खास्सअ।<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />हे बिधाता, मेरी अरज़ शुण,</para>
  <para style="q" vid="PSA 86:6">हुंह आसा लेरा लाई-लाई ताखा मज़त मांगदअ लागअ द।<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />ज़ेभै मुंह आफ़त पल़ा तेभै करा हुंह ताह ई सेटा अरज़,</para>
  <para style="q" vid="PSA 86:7">किल्हैकि मुखा आसा थोघ कि तूह हेरा शूणीं।<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />हे मेरै मालक, होर देअ-देबी निं ताह ज़िहै आथी,</para>
  <para style="q" vid="PSA 86:8">ज़िहै च़मत्कार तूह करा, तिहै निं तिन्‍नां मांझ़ै कोहै करी सकदै।<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />सोभी देशे लोग आसा तंऐं ई बणाऐं दै,</para>
  <para style="q" vid="PSA 86:9">तिन्‍नां एछणअ ताह ई सेटा माथै टेक्‍कदै अर</para>
  <para style="q" vid="PSA 86:9">तिन्‍नां करनी तेरी ज़ै-ज़ैकार।<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />महान अर नुआहरै काम सका तूह ई करी,</para>
  <para style="q" vid="PSA 86:10">किल्हैकि परमेशर आसा तूह एक्‍कै।<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />हे बिधाता, मुखा खोज़ आपणअ सत्त,</para>
  <para style="q" vid="PSA 86:11">मुंह करनअ तिहअ ई ज़िहअ तूह बोले,</para>
  <para style="q" vid="PSA 86:11">तूह कर मेरै दिला शुचै ताकि हुंह सदा तेरअ अदर करूं।<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />हे मेरै मालक, हुंह करा दिला का तेरअ शूकर,</para>
  <para style="q" vid="PSA 86:12">मुंह रहणअ कबल्‍लै खोज़दै लागी कि तूह किहअ महान आसा।<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />एता पोर्ही महान गल्‍ल निं किछ़ै आथी कि तूह झ़ूरा मुल्है कबल्‍लअ,</para>
  <para style="q" vid="PSA 86:13">तंऐं आसा हुंह मरनै का तोही बच़ाऊअ द।<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />हे परमेशर, घमंडी मणछ हुऐ मुल्है शरेरै,</para>
  <para style="q" vid="PSA 86:14">कदुष्ट मणछे टोली च़ाहा मुंह मारी पाणअ,</para>
  <para style="q" vid="PSA 86:14">तिंयां निं तेरी बी परबाह मारदै!<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />पर हे मेरै मालक, तूह आसा हाम्हां लै जश दैणैं आल़अ अर झणैल़ू परमेशर,</para>
  <para style="q" vid="PSA 86:15">तूह निं छ़ेक्‍कै रोश्श करदअ अर एतो सका हाम्हैं निहंचअ डाही कि तूह झ़ूरा हाम्हां लै खास्सअ।<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />हे बिधाता, मुंह बाखा फिर, ऐबै दै मुल्है जश,</para>
  <para style="q" vid="PSA 86:16">मुल्है दै बल, मुंह बच़ाऊ,</para>
  <para style="q" vid="PSA 86:16">किल्हैकि हुंह बी करा तेरी तेही ई च़ाकरी ज़ेही मेरी ईज करा ती।<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />ऐहा गल्‍ले नशाणी दै मुल्है कि तंऐं हेरअ हुंह मनी!</para>
  <para style="q" vid="PSA 86:17">ताकि मुंह संघै ज़ीद डाहणैं आल़ै इहअ भाल़ी शर्मिंदै होए कि</para>
  <para style="q" vid="PSA 86:17">तंऐं किई मेरी मज़त अर शांती बी दैनी।<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">सीनाई धारे शोभा</para>
  <para style="d">कोराह खिंबा आल़ैओ भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />बिधाता च़िणीं आपणीं नगरी पबित्र धारा प्रैंदै,<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />सह झ़ूरा तैहा नगरी<note caller="+" style="f"><char style="fr" closed="false">87:2 </char><char style="fq" closed="false">तैहा नगरी </char><char style="ft" closed="false">एरुशलेम</char></note> लै</para>
  <para style="q" vid="PSA 87:2">ज़िधी याकबे आद-लुआद आसा बस्सै दै।<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />तूह ज़ुंण परमेशरे नगरी<note caller="+" style="f"><char style="fr" closed="false">87:3 </char><char style="fq" closed="false">परमेशरे नगरी </char><char style="ft" closed="false">एरुशलेम नगरी लै बोला तै परमेशरे नगरी</char></note> आसा, शुण,</para>
  <para style="q" vid="PSA 87:3">तेरी शोभे बारै बोला एही बित्ती-बित्ती गल्‍ला।<verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />मिसर, बाबेल, पलिश्ती, सूर अर कूश<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="fq" closed="false">कूश </char><char style="ft" closed="false">इथोपिया</char></note></para>
  <para style="q" vid="PSA 87:4">आसा इहै देश ज़ेतो तम्हां का थोघ आसा,</para>
  <para style="q" vid="PSA 87:4">इना देशे लोग बोला इहअ,</para>
  <para style="q" vid="PSA 87:4">“हाम्हैं आसा एरुशलेम नगरी हुऐ ज़ल्मैं दै।”<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />परम प्रधान परमेशरा दैणीं सियोन नगरी लै एही बर्गत कि</para>
  <para style="q" vid="PSA 87:5">तेखअ बोल़णअ सोभी लोगा इहअ,</para>
  <para style="q" vid="PSA 87:5">“हाम्हैं बी आसा इधी हुऐ ज़ल्मैं दै।”<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />बिधाता डाहणैं आपणैं लोगे नाअं बही दी लिखी,</para>
  <para style="q" vid="PSA 87:6">अर तिन्‍नें ज़ल्म भूमी बी तिधी।<verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />तिंयां बी लागणै सोभै नाच़दै-गांदै अर इहअ बोल्दै,</para>
  <para style="q" vid="PSA 87:7">“म्हारी ज़िन्दगीओ मूल़ बी आसा एरुशलेम नगरी।”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">ज़ेभै आशा पठी चुटे, तेभकी प्राथणां</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै: कोराह खिंबा आल़ैओ महलतलग्नोत रागा दी खास भज़न। अह आसा हमानै बोलअ द ज़ुंण एज्रा खिंबा का थिअ।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />हे बिधाता, तूह डाहा मुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 88:1">हुंह खोज़ा लेर-पकार पाई आपणअ दुख ताखा।<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />ऐबै दै मुंह बाखा धैन,</para>
  <para style="q" vid="PSA 88:2">हुंह करा लेर-पकार पाई ताह सेटा अरज़।<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />मुंह आसा एतरी खास्सी आफ़त पल़ी दी कि</para>
  <para style="q" vid="PSA 88:3">मेरै च़ाल्‍लअ ऐबै मर्हुई।<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />ऐबै निं मुंह ज़ोर-ज़ाहण किछ़ै रहै,</para>
  <para style="q" vid="PSA 88:4">हुंह हुअ तिन्‍नां होरी मणछा ज़िहअ ज़ुंण मरदै तैर आसा!<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />तंऐं आसा हेरअ द हुंह मुल्दै जैंदरी छ़ाडी डाही,</para>
  <para style="q" vid="PSA 88:5">हुंह हुअ ऐबै तिन्‍नां ज़िहअ ज़ुंण मारी करै घोरी आसा दाबै दै,</para>
  <para style="q" vid="PSA 88:5">ज़ुंण तंऐं बिस्सरी आसा हेरै दै अर ज़हा तेरी मज़त निं भेटदी,</para>
  <para style="q" vid="PSA 88:5">मेरी दशा बी हुई तिन्‍नां ई ज़ेही।<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />तंऐं शोट्टअ हुंह इहै डुघै कुहै दी,</para>
  <para style="q" vid="PSA 88:6">ज़ुंण सोभी का डुघअ अर ज़ेथ नटिप्प न्हैरअ आसा।<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />तेरै रोश्शै लाअ हुंह समुंदरे छ़ाल्‍ली ज़िहअ घेप्पी।<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />तंऐं किऐ मेरै साथी-संघी बी मुखा दूर,</para>
  <para style="q" vid="PSA 88:8">तिंयां करा ऐबै मुखा नफरत!</para>
  <para style="q" vid="PSA 88:8">हुंह हुअ इहअ कैद कि हुंह निं ऐबै छ़ुटी सकदअ,<verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />दुख ज़िरी-ज़िरी निस्सअ ऐबै मेरी आछी का बी शुझुई,</para>
  <para style="q" vid="PSA 88:9">हे बिधाता, हुंह रहा कबल्‍लअ धैल़ी-राची</para>
  <para style="q" vid="PSA 88:9">हाथ फुआरी ताह सेटा अरज़ करदअ लागी।<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />ताह कै च़मत्कार मुल्दै लै करनअ?</para>
  <para style="q" vid="PSA 88:10">तेरी ज़ै-ज़ैकार कै मुल्दै लाई खल़ै उझ़ुई करी?<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />तेरी महान झ़ूरीए बारै घोरी दी लाअ खोज़ी?</para>
  <para style="q" vid="PSA 88:11">तिन्‍नां कै तेरै बारै जम्परी खोज़णअ कि तूह किहअ भरोस्सैमंद आसा?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />तेरै च़मत्कार कै तेऊ न्हैरै संसारै शुझुई जाणैं?</para>
  <para style="q" vid="PSA 88:12">तेरी भलाई कहा च़ाली तिधी आद रही ज़हा ज़ैगा सोभै बिस्सरै दै हआ।<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />हे बिधाता, हुंह मांगा ताखा लेर-पकार पाई मज़त,</para>
  <para style="q" vid="PSA 88:13">एता लै करा हुंह कबल्‍ली दोत्ती-दोत्ती ताह सेटा अरज़।<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />हे बिधाता, तंऐं किल्है छ़ाडअ हुंह?</para>
  <para style="q" vid="PSA 88:14">तंऐं किल्है डाही मुंह बाखा लै पिठ फरेऊई?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />मंऐं काटी होछ़ी उझै खरी, ऐबै हुअ हुंह इहअ रोगी कि मेरै च़ाल्‍लअ हैल़ै मर्हुई,</para>
  <para style="q" vid="PSA 88:15">तेरी सज़े भर्टू च़की-च़की आसा मुंह आग लागी दी।<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />तेरअ रोश्श फिरअ मुंह बाखा हर्हला ज़िहअ!</para>
  <para style="q" vid="PSA 88:16">तेते डरै च़ाल्‍लअ हुंह पठी बरैबाद हई।<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />तेऊ हर्हलै आसा हुंह कबल्‍लअ फेरा-फेर गोटअ द,</para>
  <para style="q" vid="PSA 88:17">मुखा निं तेता का सुआई आप्पू फेर होर किछ़ै शुझदअ।<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />मेरै सक्‍कै साथी-संघी बी हुऐ ऐबै मुखा दूर,</para>
  <para style="q" vid="PSA 88:18">ऐबै रहअ मेरी ज़िन्दगी सिधअ न्हैरअ ई।<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">राज़ै दाबेदा संघै बिधाते करार</para>
  <para style="d">एतानो खास भज़न ज़ुंण एज्रा खिंबा का थिअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />हे बिधाता, मुंह रहणअ तेरी अटल़ झ़ूरी लै गिहा बोल्दै लागी,</para>
  <para style="q" vid="PSA 89:1">तेरअ सत्त खोज़णअ मुंह पोस्ती दर पोस्ती।<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />मुंह खोज़णअ इहअ, “बिधाता झ़ूरा सारी सदा,</para>
  <para style="q" vid="PSA 89:2">ज़ेभै तैणीं स्वर्ग आसा, तेभै तैणीं रहणअ बिधातो सत्त बी।”<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />तंऐं बिधाता आसा इहअ बोलअ द, “दाबेद आसा मेरअ दास मंऐं आप्पै छ़ांटअ द,</para>
  <para style="q" vid="PSA 89:3">मंऐं आसा तेऊ संघै एही करार किई दी,<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />‘दाबेद, तेरी आद-लुआदा मांझ़ै ई हणअ एक सदा लै राज़अ,</para>
  <para style="q" vid="PSA 89:4">तेरी राज़गाद्दी रहणीं पोस्ती दर पोस्ती सदा लै।’”<verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />हे बिधाता, सारै स्वर्गै लोल़ी तेरै नुआहरै कामां लै ज़ै-ज़ैकार हुई।</para>
  <para style="q" vid="PSA 89:5">तेरै सोभी स्वर्ग दूतै लोल़ी तेरै सत्ता लै तेरी ज़ै-ज़ैकार किई।<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />हे परमेशर बिधाता, सारै भ्रमंडै निं तेरी बराबरी कुंण सका करी?</para>
  <para style="q" vid="PSA 89:6">स्वर्ग दूता मांझ़ै बी निं तेरै मकाबलै कोहै आथी।<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />स्वर्गै ज़ुंण बी रहा, तिंयां रहा सोभै तेरी डरा हेठै,</para>
  <para style="q" vid="PSA 89:7">ज़ुंण सोभी का खास्सअ बलबान बी आसा, सह बी रहा ताखा बच़दअ।<verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />ए स्वर्गे सारी सैने मालक बिधाता, तेरै मकाबलै जोधअ निं कोहै आथी,</para>
  <para style="q" vid="PSA 89:8">नां कुंण ताह ज़िहअ झ़ूरनै आल़अ आथी अर नां कहा का ताह ज़िहअ सत्त आथी।<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />समुंदरै बी करा तूह राज़,</para>
  <para style="q" vid="PSA 89:9">तेते क्रुंगा बी करा तूह ई शांत।<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />समुंदरे सोभी का बडै रहाब<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="fq" closed="false">रहाब </char><char style="ft" closed="false">रहाब आसा इधी समुंदरै बडअ काल़ी नाग </char></note> नाओंए करबैऊंणैं ज़ीबा बी पाआ तूह चकोल्‍ली करै मारी।</para>
  <para style="q" vid="PSA 89:10">आपणैं महान बाहे बला करै खद्रेल़ा तूह दुशमणा ओर्ही-पोर्ही।<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />सारअ भ्रमंड आसा पृथूई संघी तेरअ ई,</para>
  <para style="q" vid="PSA 89:11">संसारे सोभ च़िज़ा बी आसा तेरी ई, किल्हैकि तिन्‍नां बणाणैं आल़अ आसा तूह ई।<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />फेरा-फेर आसा च़ऊ दिशा दी सोभै गल्‍ला तेरी,</para>
  <para style="q" vid="PSA 89:12">ताबोर अर हर्मोन धारा बी करा तेरी ई ज़ै-ज़ैकार।<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />तूह आसा ज़बर ज़ोरा आल़अ!</para>
  <para style="q" vid="PSA 89:13">तेरअ बल आसा महान!<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />तेरअ राज़ आसा नसाफ अर धर्में आथरी प्रैंदै,</para>
  <para style="q" vid="PSA 89:14">तेरै हर कामां दी हआ झ़ूरी अर सत्त।<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />हे बिधाता, तूह दैआ तिन्‍नां मणछा लै बर्गत ज़ुंण तेरी गिहा बोली तेरी ज़ै-ज़ैकार करा अर</para>
  <para style="q" vid="PSA 89:15">ज़ुंण तेरी झींणें प्रैश्शै दी हांढा।<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />हाम्हैं रहा हर धैल़ै कबल्‍लै ताह करै खुश,</para>
  <para style="q" vid="PSA 89:16">तेरी भलाई लै करा हाम्हैं तेरी ज़ै-ज़ैकार।<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />तूह आसा हाम्हां लै महान बल अर</para>
  <para style="q" vid="PSA 89:17">हाम्हां लै बल दैई हआ तूह आप्पू खुश।<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />म्हारी फाज़त करा तूह बिधाता ई,</para>
  <para style="q" vid="PSA 89:18">तूह आसा इज़राईलो पबित्र अर तंऐं दैनअ हाम्हां लै राज़अ।<verse eid="PSA 89:18" /></para>
  <para style="s">बिधाता दैनी राज़ै दाबेदा लै ज़बान</para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />एता गई खास्सी साला बिति, ज़धू तंऐं आपणैं दास दाबेदा संघै सुपनै एही गल्‍ला खोज़ी,</para>
  <para style="q" vid="PSA 89:19">“मंऐं दैनी मशूर सपाही लै मज़त करने ज़िम्मैंबारी,</para>
  <para style="q" vid="PSA 89:19">मंऐं छ़ांटअ परज़ा मांझ़ै ई एक ज़ण्हअ, संघा बशैल़अ मंऐं सह राज़गाद्दी दी।<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />मंऐं बणाअं आपणअ दास दाबेद राज़अ,</para>
  <para style="q" vid="PSA 89:20">आपणैं पबित्र तेला करै हेरअ मंऐं तेऊओ अभिषेक करी।<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />हुंह रहणअ तेऊ संघै आप्पै अर</para>
  <para style="q" vid="PSA 89:21">तेऊ लै बल दैणअ मुंह ई।<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />कदुष्ट मणछ निं तेऊ तंग करी सकदै अर</para>
  <para style="q" vid="PSA 89:22">नां दुशमण<note caller="+" style="f"><char style="fr" closed="false">89:22 </char><char style="fq" closed="false">दुशमण </char><char style="ft" closed="false">दाबेदे दुशमण</char></note> तेऊ हारी सकदै।<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />तेऊए दुशमण अर ज़ुंण तेऊ लै ज़ीद डाहा,</para>
  <para style="q" vid="PSA 89:23">तिंयां पाणै मुंह तेऊ नदरी मारी।<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />तेऊ लै रहणीं मेरी झ़ूरी अर सत्त सदा,</para>
  <para style="q" vid="PSA 89:24">मुंह करै भेटणीं तेऊ सदा ज़ीत ई।<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />तेऊ दैणअ मुंह मांझ़ समुंदरा पोर्ही</para>
  <para style="q" vid="PSA 89:25">एप्रात नदी तैणीं राज़ करनै।<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />तेऊ बोल़णअ तेखअ मुल्है इहअ,</para>
  <para style="q" vid="PSA 89:26">‘तूह आसा मेरअ परमेशर अर मेरअ बाब,</para>
  <para style="q" vid="PSA 89:26">मेरी फाज़त अर मुंह बच़ाऊंणै आल़अ आसा तूह ई।’<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />सह हणअ मेरअ ज़ेठअ शोहरू,</para>
  <para style="q" vid="PSA 89:27">पृथूईए राज़ै प्रैंदै माहा राज़अ हणअ सह ई।<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />मेरी झींण अर झ़ूरी रहणीं तेऊ लै सदा,</para>
  <para style="q" vid="PSA 89:28">तेऊ संघै किई दी करार बी रहणीं अटल़।<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />तेऊओ खिंब निं हुंह कधि खतम हणैं दैंदअ अर</para>
  <para style="q" vid="PSA 89:29">तेऊ ई खिंबा का हणअ एक सदा लै राज़अ।<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />पर ज़ै तेऊए आद-लुआदा मांझ़ै मेरअ बधान चोल़े अर</para>
  <para style="q" vid="PSA 89:30">मेरै बधाने साबै ज़िन्दगी नांईं ज़िऊए,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />ज़ै तिंयां मेरै बधान अर बिधीए कदर नांईं करे अर</para>
  <para style="q" vid="PSA 89:31">मेरै हुकम नांईं मने,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />तेखअ पल़णै मुंह तिंयां नैरनै अर</para>
  <para style="q" vid="PSA 89:32">तिन्‍नें पापा लै पल़णीं मुंह सज़ा दैणीं।<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />पर दाबेदा झ़ूरनअ निं हुंह छ़ाडदअ अर</para>
  <para style="q" vid="PSA 89:33">नां सत्त छ़ाडी आपणीं ज़बानी हुधदअ।<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />तेऊ संघै करार निं हुंह चोल़दअ,</para>
  <para style="q" vid="PSA 89:34">ज़ुंण बैण मंऐं बोल़ी हेरअ, सह आसा तेखअ पाटा रेख।<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />मंऐं आसा राज़ै दाबेदा संघै सोह खाई करार किई दी,</para>
  <para style="q" vid="PSA 89:35">मेरअ पबित्र नाअं निं झ़ुठअ हई सकदअ।<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />तेऊए आद-लुआदा करनअ सदा राज़,</para>
  <para style="q" vid="PSA 89:36">तेऊओ राज़ रहणअ सरगे सुरज़ा ज़िहअ अर<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />ज़ोथा ज़िहअ सदा लै।</para>
  <para style="q" vid="PSA 89:37">ईंयां दुहै आसा सरगै ऐहा गल्‍ले पाक्‍कै शाजत।”<verse eid="PSA 89:37" /></para>
  <para style="s">राज़े हार हई लामण</para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />पर हे बिधाता, तंऐं किअ तज़ी बी आपणैं तेऊ छ़ांटै दै राज़ै लै रोश्श!</para>
  <para style="q" vid="PSA 89:38">तंऐं डाही तेऊ बाखा पिठ फरेऊई अर सह छ़ाडअ तंऐं पठी।<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />ज़ुंण तेऊ संघै तंऐं करार किई ती, तंऐं खोई सह बी,</para>
  <para style="q" vid="PSA 89:39">अर तेऊओ राज़ मुगट बी शोट्टअ तंऐं धरनीं!<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />तेऊए नगरी फेर-फिरदी दुआल बी पाई तंऐं ढोल़ी अर</para>
  <para style="q" vid="PSA 89:40">तेऊए बडै-बडै गहल़-कोट पाऐ तंऐं ढोल़ी!<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />बाता हांढणै आल़ै बी लुटअ-घशिट्टअ सह ज़िहअ नां किहअ,</para>
  <para style="q" vid="PSA 89:41">तेऊ ओरी-पोरीए देशे लोग लागै तेऊए सुहांगा करदै!<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />इहअ करै, तंऐं तेऊए दुशमणा लै दैनअ बल!</para>
  <para style="q" vid="PSA 89:42">अर तिंयां हुऐ नाच़णै जोगी खुश।<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />तंऐं किऐ तेऊए जुधा करने चाण बी ठुंढै,</para>
  <para style="q" vid="PSA 89:43">ताकि सह जुध ज़िती नां सके!<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />तंऐं किई तेऊए शोभा खतम अर</para>
  <para style="q" vid="PSA 89:44">तेऊए राज़गाद्दी पाई तंऐं आप्पै ढोल़ी!<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />तंऐं किई तेऊए ज़ुआनी खतम अर</para>
  <para style="q" vid="PSA 89:45">सह किअ तंऐं शर्मिंदअ।<verse eid="PSA 89:45" /></para>
  <para style="s">छ़ुटकारै लै प्राथणां</para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />हे बिधाता, ताह कै सदा डाहणीं एही पिठ फरेऊई?</para>
  <para style="q" vid="PSA 89:46">तेरै रोश्शा कधू तैणीं रहणअ इहै आगी ज़िहै दहंदै लागी?<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />ऐहा गल्‍ला, कर आद कि म्हारी ज़िन्दगी आसा बेघै थोल़ी!</para>
  <para style="q" vid="PSA 89:47">तै किल्है डाहै तंऐं हाम्हैं मणछ थोघै बाझ़ी बणाईं?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />इहअ कुंण मणछ आसा ज़ुंण अमर हणअ?</para>
  <para style="q" vid="PSA 89:48">मणछा मांझ़ै कुंण सका मौते बला का बच़ी?<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />हे मेरै मालक, तेरअ हाम्हां लै झ़ूरनअ ऐबै केस्सी लुक्‍कअ?</para>
  <para style="q" vid="PSA 89:49">तेरी सह दाबेदा संघै किई दी करार केस्सी पेठी?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />हे मेरै मालक, हुंह आसा तेरअ दास, मुंह निं बिस्सरी पाई!</para>
  <para style="q" vid="PSA 89:50">पराई ज़ातीए लोग लागै मेरै सुहांगा करदै, हुंह थक्‍कअ ऐहा बेइज़ती ज़िरी-ज़िरी।<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />हुंह आसा तंऐं आप्पै छ़ांटअ द,</para>
  <para style="q" vid="PSA 89:51">पर तेरै दुशमण आसा मेरै पिछ़ै पल़ै दै अर तिंयां करा मेरअ सुहांग!<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />हे बिधाता, हाम्हैं करा सदा तेरी ज़ै-ज़ैकार।</para>
  <para style="qc" vid="PSA 89:52">एवमस्तू अर एवमस्तू।<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">च़ौथअ भाग</para>
  <para style="mr">(<ref loc="PSA 90:1-106:48">भज़न 90:1—106:48</ref>)</para>
  <para style="s">मणछ अर अमर परमेशर</para>
  <para style="d">(मोसा गूरे बिधाता का अरज़)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />ए म्हारै मालक, तूह आसा पोस्ती दर</para>
  <para style="q" vid="PSA 90:1">पोस्ती लै म्हारअ आसरअ।<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />ज़धू तंऐं ईंयां बडी-बडी धारा बणाईं,</para>
  <para style="q" vid="PSA 90:2">ज़धू तंऐं अह पृथूई अर सारअ संसार बणाअं,</para>
  <para style="q" vid="PSA 90:2">इना सोभी का आजी बी थिअ तूह परमेशर ई,</para>
  <para style="q" vid="PSA 90:2">अर आजू बी रहणअ सदा तूह ई।<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />तेरै एकी बैणा करै सका हाम्हैं मणछ भिई माट्टै जैंदरी बापस डेऊई</para>
  <para style="q" vid="PSA 90:3">ज़िहै हाम्हैं तेता का बणाऐं दै आसा।<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />तेरै साबै हआ हज़ार साला बी एही,</para>
  <para style="q" vid="PSA 90:4">ज़ेही कि एक धैल़ी-बिति होए!</para>
  <para style="q" vid="PSA 90:4">ताल्है आसा सह राचकै एकी पहरा ज़िहअ।<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />तूह घर्होहल़ा हाम्हां दरैऊआ ज़िहअ,</para>
  <para style="q" vid="PSA 90:5">हाम्हैं हआ सुपनै ज़िहै नच़ानक खतम।</para>
  <para style="q" vid="PSA 90:5">हाम्हैं आसा इहै नरम घाह ज़िहै ज़ुंण<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />दोत्ती टिर्खिआ अर फूला</para>
  <para style="q" vid="PSA 90:6">पर उडै जाआ सह मछैंईं।<verse eid="PSA 90:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />हाम्हैं हुऐ तेरै रोश्शा करै बरैबाद,</para>
  <para style="q" vid="PSA 90:7">हाम्हां आसा तेरै कोपा का काम्मणीं छ़ुटी दी।<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />ताखा आसा म्हारै पापो थोघ,</para>
  <para style="q" vid="PSA 90:8">ज़ुंण काम हाम्हैं लुक्‍की करै बी किऐ, तिंयां बी आसा ताखा शुझदै लागै दै।<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />तेरै रोश्शा करै घटी म्हारी अमर,</para>
  <para style="q" vid="PSA 90:9">हर धैल़ी बिता म्हारी ज़िहअ एकी बैणा ज़ेही।<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />हाम्हैं डाहा सत्तर साला ज़िऊंणें आशा,</para>
  <para style="q" vid="PSA 90:10">ज़ै हाम्हां ज़ोर-ज़ाहण रहै दै होए, तै सका हाम्हैं अश्शी साला बी ज़िऊई।</para>
  <para style="q" vid="PSA 90:10">पर तेथ बी पल़ा हाम्हां लै दुख अर आफ़ता ई,</para>
  <para style="q" vid="PSA 90:10">म्हारी ज़िन्दगी जाआ झ़टपटै मुक्‍की संघा लागा अह संसार छ़ाडणअ।<verse eid="PSA 90:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />तेरै रोश्शा दी केतरअ बल आसा, एतो थोघ निं कोही का आथी,</para>
  <para style="q" vid="PSA 90:11">कुंण ज़ाणें कि तेरै कोपा किज़ै आफ़त पाणीं?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />हाम्हां लै दै एही अक्ल कि ज़ुंण थोल़ी ज़ेही ज़िन्दगी हाम्हां का आसा,</para>
  <para style="q" vid="PSA 90:12">सह लोल़ी ती हाम्हैं भली भांती काटी ज़ाणीं।<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />हे बिधाता, ऐबै निं भाल़अ लागै, म्हारी मज़त कर,</para>
  <para style="q" vid="PSA 90:13">हाम्हां लै कर झींण, हाम्हैं आसा तेरै दास।<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />दोत्ती दै हाम्हां तेरी सदा रहणैं आल़ी झ़ूरी करै रज़ैऊई,</para>
  <para style="q" vid="PSA 90:14">हाम्हां लोल़ी नाच़णै जोगी खुशी हुई अर सारी अमरा लोल़ी तेरी ज़ै-ज़ैकार करदै रहै।<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />ज़ेतरी साला हाम्हैं दुख अर आफ़ता ज़िरी,</para>
  <para style="q" vid="PSA 90:15">तेतरी ई साला लोल़ी तै हाम्हैं खुश अर राज्ज़ी-मौज़ी रहै।<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />हाम्हैं आसा तेरै दास, हाम्हां लै दै तूह आपणैं महान कामां भाल़णेंओ मोक्‍कअ अर</para>
  <para style="q" vid="PSA 90:16">तेरअ प्रतप्प लोल़ी म्हारै आद-लुआदा का शुझुअ।<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />ए म्हारै मालक, हाम्हां लै लोल़ी तेरी बर्गत हुई।</para>
  <para style="q" vid="PSA 90:17">हाम्हां कर हर कामां दी सफल।<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">म्हारी फाज़त करा बिधाता</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />ज़ुंण परम प्रधान बिधाता सेटा शरण लआ,</para>
  <para style="q" vid="PSA 91:1">ज़ुंण परम प्रधान परमेशरे आसरै निहंचै रहा,<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />सह बोला बिधाता लै इहअ,</para>
  <para style="q" vid="PSA 91:2">“तूह आसा मेरी शरण लणें ज़ैगा अर बच़णे ज़ैगा,</para>
  <para style="q" vid="PSA 91:2">तूह आसा मेरअ परमेशर ज़हा दी हुंह भरोस्सअ डाहा।”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />बिधाता डाहणैं तम्हैं तिन्‍नां आफ़ता अर</para>
  <para style="q" vid="PSA 91:3">माहा मरी का बच़ाऊई ज़ुंण शकारी ज़ेही नच़ानक एछा।<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />तेऊ फुआरनै आपणैं फैंख,</para>
  <para style="q" vid="PSA 91:4">संघा दैणअ तम्हां लै तेथ आसरअ।</para>
  <para style="q" vid="PSA 91:4">तेऊओ सत्त आसा तम्हां लै बच़ाअ अर फाज़त।<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />तेखअ नां तम्हां राची एछणैं आल़ी आफ़ता का डरने ज़रुरत आथी,</para>
  <para style="q" vid="PSA 91:5">नां तिन्‍नां कतीरा का ज़ुंण धैल़ी एछा,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />नां तेखअ तम्हां तैहा मरी का किछ़ै डअर हणीं ज़ुंण न्हैरै दी मारा,</para>
  <para style="q" vid="PSA 91:6">नां कहा एही माहा मरी का ज़ुंण धैल़ी दपहरै करा बनाश।<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />तम्हां नेल़ हज़ार मणछ किल्है निं बधल़िए,</para>
  <para style="q" vid="PSA 91:7">अर तम्हां फेर दस हज़ार किल्है निं मरे,</para>
  <para style="q" vid="PSA 91:7">पर तम्हां निं सह बूराई छ़ुंहीं बी सकदी।<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />पर तम्हां भाल़णअ आपणीं आछी कि</para>
  <para style="q" vid="PSA 91:8">कदुष्ट मणछा केही सज़ा भेटी।<verse eid="PSA 91:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />परम प्रधान परमेशर बिधाता आसा थारी शरण लणें ज़ैगा,</para>
  <para style="q" vid="PSA 91:9">ताह सेटा ठुर्ही सका तम्हैं आपणीं ज़ान बच़ाऊई।<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />तैही निं तम्हां लै आफ़त पल़दी अर</para>
  <para style="q" vid="PSA 91:10">दुख-सांगट बी रहा थारै घअरा का दूर।<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />बिधाता डाहणैं थारी फाज़त करदै हर ज़ैगा स्वर्ग दूत लाई,</para>
  <para style="q" vid="PSA 91:11">तम्हैं ज़िधी बी डेऊए, तिंयां रहणैं तम्हां संघा।<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />तम्हैं नढैऊणैं तिन्‍नां स्वर्ग दूता हाथा ढाकी,</para>
  <para style="q" vid="PSA 91:12">ताकि थारै च़रणैं ठोहल़ नां लागे।<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />तम्हां झेचणैं तेखअ सिह अर</para>
  <para style="q" vid="PSA 91:13">झ़रीलै शपैल़ बी आपणैं खूरा हेठै।<verse eid="PSA 91:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />बिधाता बोला इहअ, “ज़ुंण मुल्है झ़ूरा, तिंयां हेरनै मुंह बच़ाऊई अर</para>
  <para style="q" vid="PSA 91:14">ज़ुंण मुंह बिधाता दी भरोस्सअ डाहा, तिन्‍नें करनी मुंह फाज़त।<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />ज़ेभै तम्हां आफ़त पल़े, तेभै बोलै मुल्है,</para>
  <para style="q" vid="PSA 91:15">तेभै रहणअ मुंह तिन्‍नां संघै आप्पै।</para>
  <para style="q" vid="PSA 91:15">तिन्‍नां बच़ाऊई करै करनी मुंह तिन्‍नें कदर।<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />तिन्‍नें अमर करनी मुंह खास्सी अर</para>
  <para style="q" vid="PSA 91:16">तेभै जाणअ तिन्‍नां का शुझुई कि मंऐं बच़ाऊऐ तिंयां आपणैं बला करै।”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">बिधाते स्तोती</para>
  <para style="d">बशैघे धैल़ी लै भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />हे बिधाता, ए परम प्रधान परमेशर, तेरअ शूकर करनअ अर</para>
  <para style="q" vid="PSA 92:1">तेरी ज़ै-ज़ैकार करना लै भज़न बोल़णअ भाल़ किहअ भलअ आसा!<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />दोत्ती लागा तेरी अटल़ झ़ूरीए बारै खोज़णेंओ च़ाअ अर</para>
  <para style="q" vid="PSA 92:2">राची इहअ कि तूह भाल़ किहअ भरोस्सैमंद आसा।<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />मुंह करनी तेरी दस तारा आल़ै साज़ अर</para>
  <para style="q" vid="PSA 92:3">बींन बाज़ी करै ज़ै-ज़ैकार।<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />हे बिधाता, तंऐं किअ हुंह आपणैं महान कामां करै खुश,</para>
  <para style="q" vid="PSA 92:4">तेरै इना महान कामां लै करा हुंह तेरी ज़ै-ज़ैकार।<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />तेरी आसा गल्‍ल ई बडी अर</para>
  <para style="q" vid="PSA 92:5">तेरी सोठ आसा बेघै डाढी।<note caller="-" style="x"><char style="xo" closed="false">92:5 </char><char style="xt" closed="false"><ref loc="REV 15:3">प्रका. 15:3</ref>; <ref loc="ROM 11:33-34">रोम. 11:33-34</ref></char></note><verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />ऐहा गल्‍ला निं कमुर्ख मणछ समझ़ी सकदअ,</para>
  <para style="q" vid="PSA 92:6">अर ऐडअ मणछ निं एतो खैल डाहंदअ।<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />कदुष्ट खिला फूला घाह ज़िहै,</para>
  <para style="q" vid="PSA 92:7">कबध खटणै आल़ेए हआ मौज़,</para>
  <para style="q" vid="PSA 92:7">पर तिंयां हआ बादा का पठी बरैबाद।<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />पर हे बिधाता, तेरअ राज़ रहणअ हाम्हां प्रैंदै सारी-सदा।<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />ताह पाणै आपणैं दुशमण मारी, अर</para>
  <para style="q" vid="PSA 92:9">कदुष्ट मणछ खद्रेल़णैं ओर्ही-पोर्ही।<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />पर मुल्है दैनअ तंऐं बणें म्हैशै ज़िहअ बल,</para>
  <para style="q" vid="PSA 92:10">तंऐं छ़ांटअ हुंह आप्पू लै।<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />मंऐं भाल़अ आपणीं आछी कि मेरै दुशमण हारै, अर</para>
  <para style="q" vid="PSA 92:11">मंऐं शूणअ आपणैं कानै कि कदुष्ट मणछा का केही लैल़ा-पकारा छ़ुटी।<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />धर्मीं मणछ फुलणैं-फल़णैं खज़ूरे लाम्मै बूटा ज़िहै,</para>
  <para style="q" vid="PSA 92:12">तिंयां बझ़णै लाबानोन धारा लागी दी केल़ुई ज़िहै।<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />तिंयां आसा तेरै भबनै रोहै दै बूटा ज़िहै,</para>
  <para style="q" vid="PSA 92:13">ज़ुंण तेरै खोल़ै फल़ा-फूला।<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />खास्सी प्रोढी अमरा बी रहा तिंयां बूट फल़ा दैंदै लागी अर</para>
  <para style="q" vid="PSA 92:14">तिंयां रहणैं सदा हरै-भरै।<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />तिन्‍नां बोल़णअ तेरै बारै इहअ,</para>
  <para style="q" vid="PSA 92:15">“बिधाता करा नसाफ! सह आसा मेरी शरण लणें टोल्ह,</para>
  <para style="q" vid="PSA 92:15">तेऊ दी निं किछ़ै खोट आथी।”<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">बिधाता आसा राज़अ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />ए म्हारै बिधाता, तूह आसा राज़अ!</para>
  <para style="q" vid="PSA 93:1">महान राज़ अर बल आसा तेरअ सुआब,</para>
  <para style="q" vid="PSA 93:1">एता ई करै आसा पृथूई एकी ज़ैगा टेक्‍की दी,</para>
  <para style="q" vid="PSA 93:1">सह निं तिधा का आजू-पिछ़ू च़ुक्‍कदी।<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />हे बिधाता, तेरी राज़गाद्दी आसा तेही ई,</para>
  <para style="q" vid="PSA 93:2">सोभी ज़मानैं का आजी थिअ तूह ई।<verse eid="PSA 93:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />हे बिधाता, समुंदरै लाई क्रुंगा,</para>
  <para style="q" vid="PSA 93:3">बडै-बडै दरैऊऐ छ़ाल्‍ली लाई गुल़ूबिज़ल़ू ज़ेही ढिम्हां।<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />समुंदरे क्रुंगा अर बडै-बडै दरैऊए छ़ाल्‍ली आसा खास्सअ बल,</para>
  <para style="q" vid="PSA 93:4">पर हे बिधाता, ताखा आसा इना सोभी का खास्सअ महान बल।<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />हे बिधाता, तेरअ बधान आसा अटल़,</para>
  <para style="q" vid="PSA 93:5">तेरअ बसेरअ आसा पबित्र अर</para>
  <para style="q" vid="PSA 93:5">तेते शोभा रहणीं जुगै-जुगै तैणीं।<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">बिधाता दैआ कदुष्ट मणछा लै सज़ा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />हे परमेशर बिधाता, तूह दैआ कदुष्ट मणछा लै सज़ा।</para>
  <para style="q" vid="PSA 94:1">तिन्‍नां लै कर ऐबै आपणअ कोप प्रगट।<note caller="-" style="x"><char style="xo" closed="false">94:1 </char><char style="xt" closed="false"><ref loc="DEU 32:35">बधा. 32:35</ref></char></note><verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />हे बिधाता, पृथूईओ नसाफ करनै आल़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 94:2">घमंडी मणछा लै दै तिन्‍नें कामें साबै तिन्‍नों फल!<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />हे बिधाता, ईंयां कदुष्ट मणछ</para>
  <para style="q" vid="PSA 94:3">केभै तैणीं रहणैं राज्ज़ी-मौज़ी?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />तिंयां करा शरेरी गल्‍ला,</para>
  <para style="q" vid="PSA 94:4">इना कदुष्ट मणछा कधू तैणीं रहणअ डिंगा मारदै लागी?<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />इनै आणै लोग हारी-मारी!</para>
  <para style="q" vid="PSA 94:5">ईंयां दैआ तेरी परज़ा लै दुख।<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />ईंयां करा बिधबा, छ़ुटै मुक्‍कै दै मणछे</para>
  <para style="q" vid="PSA 94:6">अर पाखलै मणछे हत्या।<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />तिंयां बोला इहअ, “बिधाता निं हाम्हां भाल़दअ,</para>
  <para style="q" vid="PSA 94:7">याकबो परमेशर निं एथ बाखा धैन बी दैंदअ।”<verse eid="PSA 94:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />तम्हैं मेरी परज़ा केही ऐडी अर कमुर्ख हुऐ?</para>
  <para style="q" vid="PSA 94:8">तम्हां केभै एछणी अक्ल?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />ज़ुंणी बिधाता तम्हां लै कान दैनै, सह कै आप्पू शूणीं निं सकदअ?</para>
  <para style="q" vid="PSA 94:9">तेऊ दैनी तम्हां लै आछी, सह कै आप्पू भाल़ी निं सकदअ?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />सह नैरा सोभी देशा, सह कै सज़ा निं सकदअ दैई?</para>
  <para style="q" vid="PSA 94:10">सह दैआ हाम्हां सोभी मणछा लै शिक्षा, आप्पू कै तेऊ का ज्ञैन निं आथी?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />बिधाता हेरा भुझ़ी कि हाम्हैं सोभ किज़ै सोठा!</para>
  <para style="q" vid="PSA 94:11">तेऊ का आसा थोघ कि हाम्हां मणछे सोर केही बृथा आसा। <note caller="-" style="x"><char style="xo" closed="false">94:11 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 करि. 3:20</ref></char></note><verse eid="PSA 94:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />हे बिधाता, तेऊ मणछे खुल़्हणै भाग ज़हा तूह नैरा अर</para>
  <para style="q" vid="PSA 94:12">आपणअ बधान सखाऊआ।<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />तूह दैआ तिन्‍नां लै आफ़ता का राम अर</para>
  <para style="q" vid="PSA 94:13">कदुष्ट मणछा ढाकणा लै डाहा तेतरी खात्ती खण्हीं।<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />किल्हैकि तूह बिधाता निं आपणीं परज़ा कल्ही छ़ाडदअ,</para>
  <para style="q" vid="PSA 94:14">ज़ुंण तेरै आपणैं आसा, तिन्‍नां निं तूह आप्पू का दूर करदअ।<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />तेरी दालता दी हआ शुचअ नसाफ अर</para>
  <para style="q" vid="PSA 94:15">धर्मीं मणछ दैआ तिन्‍नां गल्‍लो साथ।<verse eid="PSA 94:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />ताह बिधाता छ़ाडी निं मुंह कदुष्ट मणछा का होर कोहै बच़ाऊई सकदअ।</para>
  <para style="q" vid="PSA 94:16">तिन्‍नां नर्दैई लोगा लै ज़बाब दैंदअ आसा मुंह संघै तूह बिधाता ई खल़अ।<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />ज़ै तंऐं मेरी मज़त नांईं किई हंदी,</para>
  <para style="q" vid="PSA 94:17">तै गई ती आझ़ा लै कधू मेरी ज़िन्दगी खतम हई!<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />ज़ेतरी हुंह फिशल़ुअ थिअ, तेतरी हेरअ तंऐं बिधाता आप्पै हुंह थम्हीं,</para>
  <para style="q" vid="PSA 94:18">किल्हैकि तूह झ़ूरा मुल्है खास्सअ।<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />ज़ेभै मुंह खास्सअ हैल़अ फिकर हुअ,</para>
  <para style="q" vid="PSA 94:19">तेभै दैनअ तंऐं बिधाता मुल्है हैअ अर खुशी।<verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />भ्रष्ट पांच़ा संघै निं तूह हंदअ,</para>
  <para style="q" vid="PSA 94:20">ज़ुंण गलत नसाफ करा।<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />तिंयां बणाआं धर्मीं मणछा मारना लै दल,</para>
  <para style="q" vid="PSA 94:21">नर्दोश मणछा लै दैआ तिंयां मौते सज़ा।<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />पर तूह बिधाता करा मेरी फाज़त,</para>
  <para style="q" vid="PSA 94:22">हुंह लआ ताह सेटा शरण।<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />हेर परमेशर, ताह दैणीं तिन्‍नें कदुष्ट कामां लै सज़ा,</para>
  <para style="q" vid="PSA 94:23">तिन्‍नें पाप करनै पिछ़ू पाणै ताह तिंयां मारी।</para>
  <para style="q" vid="PSA 94:23">हे परमेशर बिधाता, ताह करनै तिंयां पठी खतम।<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">बिधाते स्तोती</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />सोभै करा बिधाते ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 95:1">सह<note caller="+" style="f"><char style="fr" closed="false">95:1 </char><char style="fq" closed="false">सह </char><char style="ft" closed="false">परमेशर</char></note> आसा हाम्हां लै बडी टोल्हा ज़िहअ, ज़ेते आसरै हाम्हैं बच़ा।<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />दिला का शूकर करी टेक्‍का तेऊ सेटा माथअ,</para>
  <para style="q" vid="PSA 95:2">गिहा बोल्दी-बोल्दी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />बिधाता आसा सोभी का महान,</para>
  <para style="q" vid="PSA 95:3">सह आसा सोभी देअआ प्रैंदै माहा राज़अ।<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />सारी पृथूई प्रैंदै आसा डुघै समुंदरे थाल्‍लै उझै</para>
  <para style="q" vid="PSA 95:4">उछ़टी ज़ोते च़ुंडी तैणीं बिधातो ई राज़।<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />समुंदर अर तेते सारी सोभै च़िज़ा आसा तेऊ ई बणाईं दी अर</para>
  <para style="q" vid="PSA 95:5">धरती आसा तेऊए ई हाथे कारीगीरी।<verse eid="PSA 95:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />हाम्हां करनी तेऊ बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 95:6">हाम्हां टेक्‍कणअ तेऊ सेटा माथअ।<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />सह आसा म्हारअ परमेशर</para>
  <para style="q" vid="PSA 95:7">हाम्हैं तेऊए परज़ा आसा तेऊए एही भेडे हेल़्ही ज़िहै</para>
  <para style="q" vid="PSA 95:7">ज़हा सह आपणीं घैहणीं च़राऊआ।</para>
  <para style="q" vid="PSA 95:7">भलअ हणअ त इहअ ज़ै आझ़ हाम्हैं तेऊओ बोल शुणदै।<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />परमेशरा संघै निं हठ करदै लागा, ज़ेही इज़राईली उज़र रेगीस्तानै मरीबा</para>
  <para style="q" vid="PSA 95:8">अर मस्सा नाओंए ज़ैगा किई ती।<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />थारै दाद-बाब रहै च़ाल़्ही साला तैणीं</para>
  <para style="q" vid="PSA 95:9">परमेशरे महान काम आपणीं आछी भाल़ी बी, तेऊ ई परखदै ई लागी।<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />तेखअ छ़ुटी बिधाता का छ़ाड, संघा बोलअ तिन्‍नां लै इहअ,</para>
  <para style="q" vid="PSA 95:10">“इना निं सुंबल़ी सोर ई आथी अर नां ईंयां इहअ समझ़दै कि हुंह किज़ै च़ाहा कि ईंयां करे!”</para>
  <para style="q" vid="PSA 95:10">तैही डाहै बिधाता तिंयां च़ाल़्ही साला तैणीं उज़र रेगीस्तानै ठुल़्दै लाई।<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />बिधाता खाऐ रोश्शै इहै सोह,</para>
  <para style="q" vid="PSA 95:11">“तम्हैं मणछ निं मेरी बशैघे ज़ैगा कधि पुजणैं।”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">बिधाता आसा महान माहा राज़अ</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 इतिहास 16:23-33</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />बिधाता लै गांठा एक नऊंईं गिह,</para>
  <para style="q" vid="PSA 96:1">संसारे सोभै लोग बोला तेऊए गिह!<note caller="-" style="x"><char style="xo" closed="false">96:1 </char><char style="xt" closed="false"><ref loc="REV 5:9">प्रका. 5:9</ref>; <ref loc="PSA 33:3">भज. 33:3</ref></char></note><verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />बिधाता लै बोला गिह अर तेऊए करा ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 96:2">तेऊ हेरै हाम्हैं बच़ाऊई, एऊ खुशीए समादा खोज़ा धैल़ सोभी का।<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />होरी देशा का बी खोज़ा ऐहा गल्‍ला कि बिधातो प्रतप्प किहअ आसा अर</para>
  <para style="q" vid="PSA 96:3">इहअ कि तेऊए काम किहै महान आसा।<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />बिधाता आसा इहअ महान कि तेऊए स्तोती लागा करनी ई।</para>
  <para style="q" vid="PSA 96:4">सह आसा परमेशर एक्‍कै अर हाम्हां लागा तेऊए ई डरा हेठै रहणअ।<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />होरी देशे देअ-देबी आसा सिधी मुहुर्ती,</para>
  <para style="q" vid="PSA 96:5">पर सह आसा बिधाता ई ज़ुंणी सारअ भ्रमंड आसा बणाअं द।<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />तेऊ फेर आसा अदर अर प्रतप्प,</para>
  <para style="q" vid="PSA 96:6">तेऊए पबित्र ज़ैगा आसा बल अर शोभा करै भरी।<verse eid="PSA 96:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />पृथूई दी करा सोभी देशे लोग तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 96:7">ऐहा गल्‍ला मना सोभै कि बिधाता आसा महान अर सोभी का बलबान।<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />सोभ करा बिधाते ज़ै-ज़ैकार, एता जोगी आसा सह ई।</para>
  <para style="q" vid="PSA 96:8">सोभ एछा भैंट लई तेऊए दुआरै।<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />ज़ेभै सह पबित्र प्रगट होए तेऊ महान अर पबित्र बिधाता सेटा टेक्‍का माथअ,</para>
  <para style="q" vid="PSA 96:9">तेऊए डरै लोल़ी पृथूई दी सोभै झ़ील़ै-काम्बै।<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />देशा-देशे लोगा का खोज़ा इहअ, “बिधाता आसा माहा राज़अ!</para>
  <para style="q" vid="PSA 96:10">पृथूई आसा एकी ज़ैगा टकैल़ी दी, सह निं च़ुक्‍कदी आथी,</para>
  <para style="q" vid="PSA 96:10">तेऊ करनअ देशा देशे लोगो धर्मां करै नसाफ।”<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />पृथूई अर सरग हुऐ खुश!</para>
  <para style="q" vid="PSA 96:11">समुंदर अर तेते सोभी च़िज़ा लाई क्रुंगा,<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />ज़ैगा-ज़िम्मीं अर तेते सोभ गल्‍ला लागी नंद अर</para>
  <para style="q" vid="PSA 96:12">बण-बूट लागै ज़ै-ज़ैकार करदै<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />ज़ांऊं बिधाता आप्पै धरती दी राज़ करदअ एछणअ।</para>
  <para style="q" vid="PSA 96:13">तेऊ करनअ संसारे सोभी लोगा प्रैंदै राज़ अर</para>
  <para style="q" vid="PSA 96:13">तेऊए सत्ता करै हणअ सोभी देशे लोगो नसाफ।<note caller="-" style="x"><char style="xo" closed="false">96:13 </char><char style="xt" closed="false"><ref loc="ACT 17:31">शधा. 17:31</ref></char></note><verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">बिधाता ई करा नसाफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />राज़अ आसा बिधाता ई! पृथूई हुई खुश अर</para>
  <para style="q" vid="PSA 97:1">समुंदरे होछ़ै-होछ़ै टापू बी हुई नंद।<note caller="-" style="x"><char style="xo" closed="false">97:1 </char><char style="xt" closed="false"><ref loc="REV 19:7">प्रका. 19:7</ref></char></note><verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />तेऊ फेर आसा घणैं बादल़,</para>
  <para style="q" vid="PSA 97:2">तेऊए राज़गाद्दीए आथरी आसा धर्म अर नसाफ।<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />तेऊ आजू निखल़ा आग अर</para>
  <para style="q" vid="PSA 97:3">सह दहा तेता करै आपणैं दुशमणा।<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />तेऊओ धुप्पै करै हआ सारै संसारै प्रैश्शअ,</para>
  <para style="q" vid="PSA 97:4">तेऊ भाल़ी छ़ुटा पृथूई काम्मणीं।<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />बडी-बडी धारा गल़ा बिधाता नेल़ घिऊ ज़ेही,</para>
  <para style="q" vid="PSA 97:5">ज़ुंण संसारे सोभी लोगा प्रैंदै राज़ करा।<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />भ्रमंड बोला तेऊए बारै इहअ, “नसाफ करा बिधाता ई!”</para>
  <para style="q" vid="PSA 97:6">बिधातो प्रतप्प भाल़णअ सोभी।<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />ज़हा बृथा मुहुर्तीए पूज़ा करनैओ घमंड आसा, तिंयां हणैं शर्मिंदै,</para>
  <para style="q" vid="PSA 97:7">सोभी देअआ टेक्‍कणअ बिधाता सेटा माथअ।<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />इज़राईली हणैं इहअ शूणीं खुश,</para>
  <para style="q" vid="PSA 97:8">यहूदा नगरी करनी नंद किल्हैकि</para>
  <para style="q" vid="PSA 97:8">हे बिधाता, तंऐं किअ शुचअ नसाफ।<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />ए परम प्रधान परमेशर बिधाता, तेरअ राज़ आसा सारी धरती प्रैंदै,</para>
  <para style="q" vid="PSA 97:9">तूह आसा होरी देअआ का खास्सअ महान।<verse eid="PSA 97:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />बिधाता झ़ूरा तिन्‍नां लै ज़ुंण बूराई का नफरत करा।</para>
  <para style="q" vid="PSA 97:10">सह करा आपणीं परज़े ज़िन्दगीए फाज़त,</para>
  <para style="q" vid="PSA 97:10">सह डाहा तिन्‍नां कदुष्टा का बच़ाऊई।<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />धर्मीं मणछे ज़िन्दगी हआ प्रैश्शअ,</para>
  <para style="q" vid="PSA 97:11">भलै मणछा भेटा खुशी।<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />तिंयां आसा बिधाते परज़ा!</para>
  <para style="q" vid="PSA 97:12">खुशी मनाऊंआं अर</para>
  <para style="q" vid="PSA 97:12">तेऊ परमेशरे करा ज़ै-ज़ैकार ज़ुंण पबित्र आसा।<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">नसाफ करना लै बिधातो शूकर</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />बिधाते गांठा एक नऊंईं गिह,</para>
  <para style="q" vid="PSA 98:1">तेऊ किऐ आपणैं ज़ोरै अर पबित्र बला करै</para>
  <para style="q" vid="PSA 98:1">महान अर नुआहरै काम अर</para>
  <para style="q" vid="PSA 98:1">तेऊए हुई बेघै बडी ज़ीत।<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />बिधाता किअ होरी देशा लै बी प्रगट कि</para>
  <para style="q" vid="PSA 98:2">तेऊ का आसा बच़ाऊंणेओ महान बल अर तेऊ किअ नसाफ।<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />बिधाता किई इज़राईली लै आपणीं ज़बान पूरी,</para>
  <para style="q" vid="PSA 98:3">सह आसा भरोस्सैमंद अर सह झ़ूरा तिन्‍नां लै सदा।</para>
  <para style="q" vid="PSA 98:3">देशा-देशे सोभी लोगा का शुझुअ आछी कि म्हारअ परमेशर ज़ितअ।<note caller="-" style="x"><char style="xo" closed="false">98:3 </char><char style="xt" closed="false"><ref loc="ACT 28:28">शधा. 28:28</ref></char></note><verse eid="PSA 98:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />ओ पृथूईए लोगो, ज़ोरै-ज़ोरै करा बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 98:4">ज़ोरै-ज़ोरै गिहा बोली करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />तारा आल़ै बाज़ै संघै बोला तेऊए भज़न अर</para>
  <para style="q" vid="PSA 98:5">बींन बाज़ी बोला तेऊए गिहा।<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />बिधाता आसा राज़अ, तेऊए करा नर्शिंगै अर</para>
  <para style="q" vid="PSA 98:6">करनाल़ी बाज़ी करै ज़ै-ज़ैकार।<verse eid="PSA 98:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />समुंदर अर तेते ज़ीब लोल़ी क्रुंगदै लागै अर</para>
  <para style="q" vid="PSA 98:7">धरती अर तेते सोभी ज़ीबै लोल़ी ज़ोरै-ज़ोरै हाक्‍का पाई।<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />गाडा नाल़ी लोल़ी ताल़ी बाज़ी अर</para>
  <para style="q" vid="PSA 98:8">धारा लोल़ी नाटी पाई तेऊए ज़ै-ज़ैकार किई।<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />किल्हैकि सह एछणअ पृथूई दी राज़ करदअ</para>
  <para style="q" vid="PSA 98:9">तेऊ करनअ संसारे मणछा प्रैंदै</para>
  <para style="q" vid="PSA 98:9">सत्त अर नसाफ डाही राज़।<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">म्हारअ बिधाता आसा राज़अ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />हे बिधाता, तूह आसा राज़अ</para>
  <para style="q" vid="PSA 99:1">देशा-देशे लोगा का छ़ुटी ताखा काम्मणीं,</para>
  <para style="q" vid="PSA 99:1">तूह करा फैंखा आल़ै स्वर्ग दूता प्रैंदै बेशी राज़,</para>
  <para style="q" vid="PSA 99:1">पृथूई दी हुई ज़ाज़री।<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />एरुशलेम नगरी आसा तेरी शान अर</para>
  <para style="q" vid="PSA 99:2">तूह करा सोभी देशा काबू।<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />सोभी लोगै लोल़ी तेरै महान नाओंए ज़ै-ज़ैकार किई।</para>
  <para style="q" vid="PSA 99:3">तूह आसा पबित्र!<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />तूह बिधाता आसा महान राज़अ ज़ुंण भलाई लै झ़ूरा,</para>
  <para style="q" vid="PSA 99:4">तंऐं बढेरअ याकबे आद-लुआदा जैंदरी नसाफ,</para>
  <para style="q" vid="PSA 99:4">धर्म अर सत्त आणअ तंऐं ई।<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />ए म्हारै परमेशर बिधाता, तेरी लोल़ी सदा ज़ै-ज़ैकार हुई,</para>
  <para style="q" vid="PSA 99:5">हाम्हां टेक्‍कणअ तेरी राज़गाद्दी सेटा माथअ!</para>
  <para style="q" vid="PSA 99:5">तूह आसा पबित्र।<verse eid="PSA 99:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />मोसा अर हारण थिऐ तेरै प्रोहत,</para>
  <para style="q" vid="PSA 99:6">शमूएल करा त ताह बिधाता सेटा प्राथणां,</para>
  <para style="q" vid="PSA 99:6">तूह दैआ त तिन्‍नें हर गल्‍लो ज़बाब।<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />तंऐं किई ती तिन्‍नां संघै घणैं बादल़ा बाती गल्‍ला,</para>
  <para style="q" vid="PSA 99:7">तिंयां ज़िऊआ तै तेरै बधाने साबै ज़िन्दगी।<verse eid="PSA 99:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />हे परमेशर बिधाता, तूह आसा म्हारअ मालक, तूह शूणां ती तिन्‍नें प्राथणां अर</para>
  <para style="q" vid="PSA 99:8">तंऐं किऐ तिन्‍नें पाप माफ,</para>
  <para style="q" vid="PSA 99:8">पर तिन्‍नें गलती लै दैनी तंऐं तिन्‍नां लै सज़ा बी।<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />हे बिधाता, हाम्हैं करा तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 99:9">तेरी पबित्र धारा डेऊई टेक्‍का हाम्हैं ताह सेटा माथअ।</para>
  <para style="q" vid="PSA 99:9">किल्हैकि तूह म्हारअ बिधाता आसा पबित्र।<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">बिधाता आसा भलअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />सारअ संसार करा बिधाते ज़ै-ज़ैकार!<note caller="+" style="f"><char style="fr" closed="false">100:1 </char><char style="ft" closed="false">बिधाते भबने खोल़ै प्रोहता संघै ज़ै-ज़ैकार</char></note><verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />नाच़दी-खेल्हदी गिहा बोल्दी करा बिधाते ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 100:2">अर तेऊ सेटा लै एछा शूकर करदी अर खुशीए गिहा बोल्दी-बोल्दी।<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />तम्हां का आसा थोघ बिधाता आसा परमेशर,</para>
  <para style="q" vid="PSA 100:3">हाम्हैं आसा तेऊ बणाऐं दै अर हाम्हैं आसा तेऊ ई लै,</para>
  <para style="q" vid="PSA 100:3">हाम्हैं तेऊए परज़ा आसा तेऊए ई घैहणीं च़रदी भेडा-बाकरीए हेल़्ही ज़िहै।<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />तेऊए प्रऊल़ी भितरी डेओआ शूकर करदी,</para>
  <para style="q" vid="PSA 100:4">अर तेऊए खोल़ै डेओआ ज़ै-ज़ैकार करदी।</para>
  <para style="q" vid="PSA 100:4">तेऊओ करा शूकर अर ज़ै-ज़ैकार।<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />बिधाता आसा भलअ अर सह झ़ूरा हाम्हां लै सदा,</para>
  <para style="q" vid="PSA 100:5">तेऊओ सत्त रहणअ पोस्ती दर पोस्ती।<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">राज़अ अर तेऊए ज़बान</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />हे बिधाता, मुंह गांठणी तेरी झींण अर नसाफे गिहा,</para>
  <para style="q" vid="PSA 101:1">मुंह बोल़णीं तेरी ई गिहा।<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />मुंह डाहणअ इहअ बभार ज़ेथ किछ़ै खोट निं होए,</para>
  <para style="q" vid="PSA 101:2">ताह केभै एछणअ मुंह सेटा लै?</para>
  <para style="q" vid="PSA 101:2">मुंह ज़िऊंणीं आपणैं घअरै शुची ज़िन्दगी।<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />बूरी गल्‍ला निं हुंह मंदअ ई आथी।</para>
  <para style="q" vid="PSA 101:3">भ्रष्ट कामां करनै आल़ै का करा हुंह नफरत,</para>
  <para style="q" vid="PSA 101:3">इना इहै कदुष्ट मणछा संघै निं मुंह बभार ई डाहणअ।<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />हुंह निं ताह नकदरै करदअ अर</para>
  <para style="q" vid="PSA 101:4">नां बूराई संघै आपणअ नातअ डाहंदअ।<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />इहै मणछा का रहणअ मुंह दूर</para>
  <para style="q" vid="PSA 101:5">ज़ुंण होरीए घैंचल़ करा,</para>
  <para style="q" vid="PSA 101:5">नां मुंह इहै मणछ मनणै ज़ुंण</para>
  <para style="q" vid="PSA 101:5">शरेरै अर घमंडी होए।<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />मुंह डाहणीं तिन्‍नां संघै संगत ज़ुंण बिधाता लै शुचै-पाक्‍कै होए,</para>
  <para style="q" vid="PSA 101:6">तिन्‍नां दैणअ मुंह आपणीं ज़ैगा रहणैं।</para>
  <para style="q" vid="PSA 101:6">आपणीं च़ाकरी करनै आल़ै बी डाहणैं मुंह तिंयां ई</para>
  <para style="q" vid="PSA 101:6">ज़ुंण पठी मानदार होए।<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />मुंह निं आपणीं ज़ैगा छ़ल़-कपट करनै आल़ै मणछा रहणैं दैणअ,</para>
  <para style="q" vid="PSA 101:7">ज़ुंण झ़ुठअ बोला, सह निं मुंह सेटा टेक्‍की सकदअ।<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />ज़ुंण मेरै देशै कदुष्ट होए,</para>
  <para style="q" vid="PSA 101:8">तिंयां करनै मुंह धैल़ छ़ांटी करै बरैबाद करी,</para>
  <para style="q" vid="PSA 101:8">बिधाते नगरी<note caller="+" style="f"><char style="fr" closed="false">101:8 </char><char style="fq" closed="false">नगरी </char><char style="ft" closed="false">एरुशलेम</char></note> का करनै मुंह सोभै कदुष्ट खतम।<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">खरीए पलका प्राथणां</para>
  <para style="d">खरीए पलका रैनै-गरीब मणछे अरज़, आपणैं दिलो दुख खोज़ा सह बिधाता सेटा खुल्ही करै।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />हे बिधाता, हुंह पाआ ताह सेटा लेर-पकार!</para>
  <para style="q" vid="PSA 102:1">ज़ीबाण, मेरी अरज़ शुण।<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />खरीए पलका निं</para>
  <para style="q" vid="PSA 102:2">मुंह बाखा पिठ फरेऊई आथी</para>
  <para style="q" vid="PSA 102:2">मेरी गल्‍ला शुण अर ज़ेभै हुंह ताह सेटा पकार पाए,</para>
  <para style="q" vid="PSA 102:2">तेभै निं बल़ैग पाई आथी।<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />मेरी ज़िन्दगी च़ाल्‍ली धूँआं ज़ेही मुक्‍की,</para>
  <para style="q" vid="PSA 102:3">अर मेरी देही आसा ज़ेही आगी जैंदरी दझ़दी लागी दी।<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />हुंह शुक्‍कअ-मुक्‍कअ इहअ ज़िहअ घाह मछैंआं,</para>
  <para style="q" vid="PSA 102:4">मेरी हुई भुख चिश बी खतम।<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />धक्‍की-धक्‍की शुक्‍कअ हुंह इहअ कि</para>
  <para style="q" vid="PSA 102:5">मेरी देही लागै सिधै हाडकै शुझदै।<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />हुंह हुअ बणें च़ेल्‍लू ज़िहअ रेगीस्तानै,</para>
  <para style="q" vid="PSA 102:6">ज़िहअ हुहल़ू दूर रेगीस्तानै कल्ही हआ छ़ुटअ द।<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />हुंह रहा च़ैन्‍नै लाम्मअ पल़ी बिहुदअ,</para>
  <para style="q" vid="PSA 102:7">हुंह हुअ हिंऊंल़ी च़ेल्‍ली ज़िहअ ज़ुंण कणोडै दी कल्ही आसा बेठी दी।<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />मेरै बैरी लागा धैल़ मेरै सुहांगा करदै,</para>
  <para style="q" vid="PSA 102:8">तिंयां करा मुंह ठठ्ठै लै, संघा दैआ मुल्है फिटक।<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9-10" style="v" sid="PSA 102:9-10" />किल्हैकि तेरै रोश्शो कोप पल़अ मुल्है इहअ,</para>
  <para style="q" vid="PSA 102:9-10">मुंह पल़ा छ़ार रोटी ज़िहअ खाणअ अर</para>
  <para style="q" vid="PSA 102:9-10">आशू राल़िआ झुटणें पाणीं जैंदरी,</para>
  <para style="q" vid="PSA 102:9-10">तंऐं शोट्टअ हुंह उछ़टै च़की दूर।<verse eid="PSA 102:9-10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />मेरी ज़िन्दगी आसा उडदी छ़ैल्‍ली ज़ेही,</para>
  <para style="q" vid="PSA 102:11">अर शुक्‍कै दै घाहा ज़ेही।<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />पर बिधाता, तूह आसा सदा लै राज़अ,</para>
  <para style="q" vid="PSA 102:12">तूह रहणअ पोस्ती दर पोस्ती इहअ ई।<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />ताह जाणअ उझ़ुई संघा करनी ताह सियोन नगरी लै झींण,</para>
  <para style="q" vid="PSA 102:13">ऐबै गअ तैहा नगरी लै झींण करनैओ बगत एछी,</para>
  <para style="q" vid="PSA 102:13">तेता लै आसा अह ई बगत।<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />किल्हैकि सह नगरी आसा पठी बरैबाद हुई दी,</para>
  <para style="q" vid="PSA 102:14">तज़ी बी झ़ूरा तैहा नगरी लै तेरै च़ाकरी करनै आल़ै खास्सै,</para>
  <para style="q" vid="PSA 102:14">सह आसा पठी ढूल़ी-पल़ी गई दी</para>
  <para style="q" vid="PSA 102:14">तेता भाल़ी फिरा तिन्‍नां खास्सी झींण।<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />देशा-देशे लोगा रहणीं बिधाते नाओंए डअर,</para>
  <para style="q" vid="PSA 102:15">पृथूईए सोभी राज़ै छ़ुटणअ तेरै प्रतप्पा भाल़ी दर्छ़णअ।<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />ज़ांऊं ताह सियोन नगरी भिई बसाऊंणी,</para>
  <para style="q" vid="PSA 102:16">तेथ शुझणअ तेरअ प्रतप्प सोभी का।<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />ताह हेरनी छ़ुटै-मुक्‍कै दै लान्हें अरज़ शूणीं,</para>
  <para style="q" vid="PSA 102:17">ताह हेरनअ तेतो ज़बाब तिन्‍नां लै दैई।<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />ईंयां गल्‍ला डाहणीं आगली पोस्ती लै लिखी कि बिधाता किज़ै आसा किअ द,</para>
  <para style="q" vid="PSA 102:18">ताकि ज़ुंण अज़ी हुऐ ज़ल्मैं निं आथी, तिंयां बी बिधाते ज़ै-ज़ैकार करे।<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />तूह बिधाता लागअ उझै आपणीं पबित्र ज़ैगा का भाल़अ,</para>
  <para style="q" vid="PSA 102:19">तंऐं भाल़अ उझै स्वर्गा का धरती लै।<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />ज़ुंण गलामी दी कैद आसा, तंऐं हेरी तिन्‍नें लेर-पकार शूणीं,</para>
  <para style="q" vid="PSA 102:20">ज़ुंण मारी तै लाऐ दै, तिंयां किऐ तंऐं शांघल़ी-लोहै का आज़ाद।<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />ताकि सियोन नगरी तेरै नाओंए बारै गल्‍ला होए,</para>
  <para style="q" vid="PSA 102:21">एरुशलेम नगरी तेरी ज़ै-ज़ैकार होए।<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />देशा-देशे लोगा अर राज़ै हणैं</para>
  <para style="q" vid="PSA 102:22">तेरी ज़ै-ज़ैकार करना लै कठा।<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />तंऐं बिधाता किअ हुंह खारकी अमरा दुबल़अ अर</para>
  <para style="q" vid="PSA 102:23">तंऐं किई मेरी अमर होछ़ी।<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />हे परमेशर, मुंह निं आधी अमरा मारी आथी,</para>
  <para style="q" vid="PSA 102:24">हुंह लोल़ी खास्सी प्रोढी अमरा तैणीं रहअ।</para>
  <para style="q" vid="PSA 102:24">हे मेरै मालक, सदा ज़िऊंदअ रहा तूह एक्‍कै।<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />सोभी का आजी बणाईं तंऐं ई पृथूई अर</para>
  <para style="q" vid="PSA 102:25">सारअ भ्रमंड बणाअं तंऐं आपणैं हाथै।<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />धरती संघी सारअ भ्रमंड हणैं एकी धैल़ै खतम पर तूह रहणअ सदा,</para>
  <para style="q" vid="PSA 102:26">तिंयां हणैं झिकल़ै ज़िहै पराणैं,</para>
  <para style="q" vid="PSA 102:26">तिंयां बदल़णैं ताह झिकल़ै ज़िहै पोर्ही</para>
  <para style="q" vid="PSA 102:26">संघा बणाणैं ताह तिंयां नऊंऐं।<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />पर आप्पू आसा तूह सदा ज़िहअ आसा तिहअ ई,</para>
  <para style="q" vid="PSA 102:27">तेरी अमर निं कधि खतम हंदी।<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />म्हारी आद-लुआद रहणीं राज्ज़ी राम्बल़ी,</para>
  <para style="q" vid="PSA 102:28">तिंयां रहणैं तेरी छ़ैआ-छ़तरा हेठै,</para>
  <para style="q" vid="PSA 102:28">तिन्‍नें आद-लुआद<note caller="+" style="f"><char style="fr" closed="false">102:28 </char><char style="fq" closed="false">तिन्‍नें आद-लुआद </char><char style="ft" closed="false">इज़राईले आद-लुआद</char></note> बी रहणीं आजू तेरै प्रतप्पा करै राज्ज़ी-राम्बल़ै।<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">बिधाते महान झ़ूरी</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />ए मेरै मन्‍नां, बिधातो शूकर कर!</para>
  <para style="q" vid="PSA 103:1">मुंह करनी तत्त-दिला का बिधाते पबित्र नाओंए ज़ै-ज़ैकार।<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />ए मेरै मन्‍नां, बिधातो शूकर कर!</para>
  <para style="q" vid="PSA 103:2">ऐहा गल्‍ला निं बिस्सरी आथी कि सह किहअ झणैल़ू आसा।<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />तेऊ ई, मेरै सारै पाप माफ किऐ,</para>
  <para style="q" vid="PSA 103:3">अर तेऊ किअ हुंह सोभी बमारी का नरोगअ।<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />बिधाता बच़ाऊअ हुंह मरनै का,</para>
  <para style="q" vid="PSA 103:4">तेऊए झींण अर झ़ूरी रहा मुल्है मेरै मुंडै मुगटा ज़ेही।<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />सह करा धैल़ मुल्है ज़िऊंणां लै मेरी गरज़ पूरी,</para>
  <para style="q" vid="PSA 103:5">ताकि मुंह मुक्षरलै<note caller="+" style="f"><char style="fr" closed="false">103:5 </char><char style="fq" closed="false">मुक्षरलै</char><char style="ft" closed="false">अह पंछ़ी आसा एऊए ज़ोरा लै मशूर</char></note> ज़िहै भिई तराण एछे।<verse eid="PSA 103:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />बिधाता करा रैनै-गरीबो नसाफ,</para>
  <para style="q" vid="PSA 103:6">सह दैआ तिन्‍नां लै तिन्‍नों हक।<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />तेऊ खोज़ी मोसा का आपणीं दिले गल्‍ला कि तेऊ किज़ै करनअ,</para>
  <para style="q" vid="PSA 103:7">संघा रहैऊऐ तेऊ इज़राईली मणछा का आपणैं महान काम।<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />बिधाता आसा झ़ूरनै आल़अ अर झणैल़ू,</para>
  <para style="q" vid="PSA 103:8">तेऊ निं धखी का रोश्शै एछदी अर तेऊए झ़ूरी आसा अटल़।<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />सह निं सदा दोश लांदअ अर</para>
  <para style="q" vid="PSA 103:9">नां सदा दै रुश्शी रहंदअ।<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />तेऊ निं हाम्हां संघै म्हारै पाप-दोशे साबै बभार किअ अर</para>
  <para style="q" vid="PSA 103:10">नां तेऊ हाम्हां लै तेते सज़ा दैनी ज़ुंण हाम्हां ज़रूर भेटणीं ती।<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />ज़िहअ सरग पृथूई प्रैंदै उछ़टअ आसा,</para>
  <para style="q" vid="PSA 103:11">तिहअ झ़ूरा सह तिन्‍नां लै ज़ुंण तेऊओ अदर करा।<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />ज़िहअ दूर पुर्बा का पछ़म आसा,</para>
  <para style="q" vid="PSA 103:12">तिहै दूर किऐ हाम्हां का तेऊ म्हारै पाप।<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />ज़िहअ बाब आपणैं शोहरू लै झणैल़ू हअ,</para>
  <para style="q" vid="PSA 103:13">तिहअ झणैल़ू आसा बिधाता तिन्‍नां लै ज़ुंण तेऊओ अदर करा।<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />सह ज़ाणा आप्पै कि हाम्हैं तेऊ किज़ूए तैणीं आसा बणाऐं दै,</para>
  <para style="q" vid="PSA 103:14">सह निं ऐहा गल्‍ला बिस्सरदअ कि मणछ आसा माट्टी ई।<verse eid="PSA 103:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />मणछे ज़िन्दगी आसा घाहा ज़ेही,</para>
  <para style="q" vid="PSA 103:15">हाम्हैं मणछ फूला बणें फूला ज़िहै,<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />बागरी करै जाआ तिंयां धरनीं अल़ी अर</para>
  <para style="q" vid="PSA 103:16">तेखअ निं तिंयां भिई शुझदै।<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />पर ज़ुंण बिधाते डरा हेठै रहा, तिन्‍नां लै झ़ूरा बिधाता जुगै-जुगै तैणीं,</para>
  <para style="q" vid="PSA 103:17">तेऊए बर्गत रहा तिन्‍नें आद-लुआदा लै बी पोस्ती दर पोस्ती हंदी लागी।<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />मतलब ज़ुंण तेऊए करारा लै शुचै रहा अर</para>
  <para style="q" vid="PSA 103:18">ज़ुंण तेऊए हुकम मना अर तेते साबै आपणीं ज़िन्दगी ज़िऊआ।<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />बिधाते राज़गाद्दी आसा स्वर्गै अर</para>
  <para style="q" vid="PSA 103:19">सह आसा सोभी प्रैंदै राज़अ।<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />ओ बलबान स्वर्ग दूतो,</para>
  <para style="q" vid="PSA 103:20">ज़ुंण तेऊए हुकम मना अर</para>
  <para style="q" vid="PSA 103:20">हर गल्‍ला शूणां, तम्हैं करा तेऊ बिधाते ज़ै-ज़ैकार!<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />स्वर्गे सारी सैना<note caller="+" style="f"><char style="fr" closed="false">103:21 </char><char style="fq" closed="false">स्वर्गे सारी सैना </char><char style="ft" closed="false">स्वर्ग दूत</char></note>, तम्हैं बिधाते च़ाकरी करनै आल़ै, ज़ुंण</para>
  <para style="q" vid="PSA 103:21">ज़ुंण तेऊए मरज़ी दी च़ला, तम्हैं करा तेऊ बिधाते ज़ै-ज़ैकार!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />संसारै ज़ेतरै बी ज़ीब, ज़हा प्रैंदै बिधाता राज़ करा,</para>
  <para style="q" vid="PSA 103:22">सोभै करा तेऊ बिधाते ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 103:22">ए मेरै मन्‍नां, बिधातो शूकर कर।<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">रच़ना करनै आल़ै बिधाते स्तोती</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />ए मेरै मन्‍नां बिधाते ज़ै-ज़ैकार कर,</para>
  <para style="q" vid="PSA 104:1">हे बिधाता, मेरै परमेशर, तूह भाल़ किहअ महान आसा!</para>
  <para style="q" vid="PSA 104:1">तंऐं आसा महान राज़ अर प्रतप्पे झिकल़ै बान्हैं दै।<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />प्रैश्शअ आसा तंऐं आप्पू फेर च़ादरू ज़िहअ पल़ेटअ द,</para>
  <para style="q" vid="PSA 104:2">तंऐं आसा सरग खिम्भा ज़िहअ छ़ैअ द।<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />तंऐं आसा आपणैं घअरे थाम्ह नथहऐ पाणीं प्रैंदै टकैल़ै दै।</para>
  <para style="q" vid="PSA 104:3">बादल़ आसा ताल्है तेरै रथा ज़िहै,</para>
  <para style="q" vid="PSA 104:3">बागरी आसा तेते फैंख ज़ेथ तूह शुंआर हआ।<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />तेरै दूत आसा पऊंण, तेरै दास आसा बिज़ल़ी।<verse eid="PSA 104:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />तंऐं आसा पृथूई पाक्‍की आथरी दी टकैल़ी डाही दी,</para>
  <para style="q" vid="PSA 104:5">तै निं तैहा ज़ैगा का ओर्ही-पोर्ही सिक्‍कदी।<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />तंऐं छ़ैअ तेथ प्रैंदै समुंदर झिकल़ै ज़िहअ,</para>
  <para style="q" vid="PSA 104:6">उछ़टै पर्बता प्रैंदै बी पजैल़अ तंऐं सह पाणीं।<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />तेरी एकी झांशा शूणीं लागा पाणीं ठुहर्दअ!</para>
  <para style="q" vid="PSA 104:7">तेरै बैणा शूणीं लागा सह ज़ोरै बगदअ।<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />उछ़टी धारा का होथा सह पाणीं खागै-खागै बाती तैहा ज़ैगा लै</para>
  <para style="q" vid="PSA 104:8">ज़ुंण तंऐं तेता लै बणाईं दी आसा।<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />तेखअ आसा तंऐं तेता लै सिअं डाही दी अर तैहा सिऊंआं निं सह लंघदअ,</para>
  <para style="q" vid="PSA 104:9">नां सह सारी धरती प्रैंदै भर्हदअ।<verse eid="PSA 104:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />तंऐं बहाऊऐ खागै-खागै पाणींए छ़ो,</para>
  <para style="q" vid="PSA 104:10">तेते गाड बगा धारा जैंदरी बाती उंधै।<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />तेऊ पाणीं झुटा सऊंऐं मुल्खै पुजी सोभै ज़ीब,</para>
  <para style="q" vid="PSA 104:11">बणें नचिशै गाधै बी शेऊआ तेता झुटी आपणीं चिश।<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />तिन्‍नां गाडे बाढै लागै दै डाल़ा-बूटा दी बणाआं</para>
  <para style="q" vid="PSA 104:12">च़ेल्‍लू-पखीरू आप्पू रहणा लै कोल्ह संघा रहा गिहा बोल्दै लागी।<verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />उछ़टी-उछ़टी धारा भेऊआ तूह सरगा का पाणीं दैई करै,</para>
  <para style="q" vid="PSA 104:13">तेरी बर्गता करै हअ सारी पृथूई हरी भरी।<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />पशू लै पज़ेरा तूह घाह अर</para>
  <para style="q" vid="PSA 104:14">मणछा लै पज़ेरा तूह नाज़ अर डाल़ै-बूटै फल़,</para>
  <para style="q" vid="PSA 104:14">ताकि हाम्हैं साल-फसल बओए अर<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />दाखो रस काढे ज़ेते हाम्हां मौज़ लागा,</para>
  <para style="q" vid="PSA 104:15">घेरी लै जैतूनो तेल ज़ेता करै खुशी भेटा अर</para>
  <para style="q" vid="PSA 104:15">देही लै नाज़ ज़ेता करै ज़ोर-ज़ाहण एछा।<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />लाबानोन धारे बणैं केल़ुई लै रहा सरग हंदअ लागी,</para>
  <para style="q" vid="PSA 104:16">तिंयां आसा बिधाते आपणैं बूट ज़ुंण तेऊ आप्पै आसा रोहै दै।<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />तिन्‍नां केल़ुई दी बणाआं च़ेल्‍ली आपणैं कोल्ह,</para>
  <para style="q" vid="PSA 104:17">सारस च़ेल्‍लू करा कैलीए डाल़ै बसेरअ।<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />बण बाकरै रहा उछ़टी ज़ोता,</para>
  <para style="q" vid="PSA 104:18">नऊल़ै मुश्शै लुक्‍का भिल़ी दी शाफल़े संधा दी।<verse eid="PSA 104:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />तंऐं बणाईं ज़ोथ ताकि हाम्हां सोभी ऋतो थोघ लागे,</para>
  <para style="q" vid="PSA 104:19">सुरज़ा का हआ थोघ कि केभै लागा डुबणअ,<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />तंऐं बणाईं राच अर तेथ हआ न्हैरअ,</para>
  <para style="q" vid="PSA 104:20">ताकि बणें ज़ीब राची हांढी फिरी सके।<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />खारकै सिह लागा शकार करना लै क्रुंगदै,</para>
  <para style="q" vid="PSA 104:21">तूह परमेशर दैआ तिन्‍नां लै बी खाणां लै।<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />दोत्ती धैल़अ निखल़णैं का आजी जाआ तिंयां</para>
  <para style="q" vid="PSA 104:22">आपणीं जुहल़ी लै फिरी डेऊई संघा करा तिधी राम।<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />तेखअ डेओआ मणछ आपणैं कामां-काज़ा लै,</para>
  <para style="q" vid="PSA 104:23">तिंयां रहा सान्हां तैणीं मैन्थ करदै लागी।<verse eid="PSA 104:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />हे बिधाता, तंऐं बणाईं खास्सी च़िज़ा, तेता निं कुंण गणी सकदअ!</para>
  <para style="q" vid="PSA 104:24">ईंयां सोभै गल्‍ला भाल़ तंऐं केही अक्ली करै बणाईं!</para>
  <para style="q" vid="PSA 104:24">सारी पृथूई आसा तिन्‍नां च़िज़ा करै भरी ज़ुंण तंऐं आसा बणाईं दी।<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />समुंदर आसा बेघै बडअ अर बिरलअ,</para>
  <para style="q" vid="PSA 104:25">तेथ आसा पाणीं जैंदरी हांढणै-फिरनैं आल़ै एतरै ज़ीब, तिन्‍नां निं कुंण गणी सकदअ,</para>
  <para style="q" vid="PSA 104:25">होछ़ै-होछ़ै ज़ीबा उझै बडै-बडै ज़ीबा करै आसा सह भरी।<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />समुंदरे पाणीं प्रैंदै रहा ज़हाज़ एछदै डेऊंदै लागी,</para>
  <para style="q" vid="PSA 104:26">लिबतान नाओं समुंदरो बडअ ज़ीब बी आसा तंऐं ई बणाअं द।<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />ईंयां सोभै रहा तेरै ई आसरै कि</para>
  <para style="q" vid="PSA 104:27">ज़ेभै तिन्‍नां लोल़ी तेभै तिन्‍नां लै खाणां लै दैए।<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />तूह दैआ सोभी लै आप्पै खाणां लै,</para>
  <para style="q" vid="PSA 104:28">ज़ुंण तूह तिन्‍नां लै दैआ, तेता खाआ तिंयां रज्ज़ी।<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />ज़ेभै तूह तिन्‍नां बाखा पिठ फरेऊआ, तेभै पल़ा तिन्‍नां हैल़अ फिकर,</para>
  <para style="q" vid="PSA 104:29">ज़ांऊं तूह तिन्‍नों शाह पोर्ही काढा, तेखअ मरा तिंयां</para>
  <para style="q" vid="PSA 104:29">संघा डेओआ तिंयां माट्टै जैंदरी फिरी ज़ेता का तंऐं तिंयां बणाऐं दै आसा।<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />पर ज़ांऊं तूह तिन्‍नां लै आपणअ शाह<note caller="+" style="f"><char style="fr" closed="false">104:30 </char><char style="fq" closed="false">शाह </char><char style="ft" closed="false">आत्मां</char></note> दैआ, तेखअ बणाआं तूह तिहै भिई,</para>
  <para style="q" vid="PSA 104:30">संघा दैआ तूह पृथूई लै नऊंईं ज़िन्दगी।<verse eid="PSA 104:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />हे बिधाता, तेरअ प्रतप्प लोल़ी सारी सदा रहअ!</para>
  <para style="q" vid="PSA 104:31">तूह लोल़ी आपणैं कामां भाल़ी सदा खुशी हुअ।<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />ज़ांऊं तूह भाल़अ लागा, पृथूई छ़ुटा काम्मणीं,</para>
  <para style="q" vid="PSA 104:32">ज़ांऊं तूह बडै-बडै पर्बता छ़ुंहां, तेता का लागा धूँ निखल़दअ।<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />हे बिधाता, मुंह बोल़णीं सारी अमरा तेरी ज़ै-ज़ैकारे गिहा,</para>
  <para style="q" vid="PSA 104:33">ज़ेभै तैणीं हुंह ज़िऊंदअ रहे, तेभै तैणीं रहणअ मुंह तेरै भज़न बोल्दै लागी।<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />तूह लोल़ी त मेरी सोठ अर गिहा करै खुश हुअ,</para>
  <para style="q" vid="PSA 104:34">किल्हैकि मुल्है खुशी एछा ताखा ई।<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />पापी मणछ लोल़ी तै धरती का पठी खतम हुऐ,</para>
  <para style="q" vid="PSA 104:35">कदुष्ट मणछ निं लोल़ी तै रहै ई आथी।</para>
  <para style="q" vid="PSA 104:35">ए मेरै मन्‍नां बिधाते ज़ै-ज़ैकार कर,</para>
  <para style="q" vid="PSA 104:35">बिधाते ज़ै-ज़ैकार करा।<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">बिधाता आसा शुचअ-पाक्‍कअ</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 इतिहास 16:8-22</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />बिधातो करा शूकर अर</para>
  <para style="q" vid="PSA 105:1">सोभी का खोज़ा कि सह किहअ महान आसा,</para>
  <para style="q" vid="PSA 105:1">देशा-देशे लोगा का खोज़ा कि तेऊ किज़ै-किज़ै आसा किअ द।<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />बिधाते ज़ै-ज़ैकार करना लै बोला गिहा!</para>
  <para style="q" vid="PSA 105:2">तेऊ ज़ुंण महान नुआहरै काम किऐ, तेता खोज़ा सोभी का।<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />खुश हआ कि हाम्हैं आसा तेऊ बिधाते,</para>
  <para style="q" vid="PSA 105:3">तेऊए सोभै भगत रहा नंद।<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />मज़त मांगा बिधाता का,</para>
  <para style="q" vid="PSA 105:4">कबल्‍लै रहणअ तेऊए ज़ै-ज़ैकार करदै लागी।<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="PSA 105:5-6" />आबरामे लुआद, तम्हैं ज़ुंण तेऊए च़ाकरी करा,</para>
  <para style="q" vid="PSA 105:5-6">याकबे लुआद, ज़ुंण तेऊ छ़ांटै दै आसा,</para>
  <para style="q" vid="PSA 105:5-6">तम्हैं करा तिन्‍नां च़मत्कारा आद ज़ुंण तेऊ रहैऊऐ,</para>
  <para style="q" vid="PSA 105:5-6">तेता बी करा आद ज़ुंण तेऊ नसाफ किअ।<verse eid="PSA 105:5-6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />सह बिधाता ई आसा म्हारअ परमेशर,</para>
  <para style="q" vid="PSA 105:7">तेऊओ नसाफ आसा सारै संसारा लै।<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />सह डाहा आपणीं करार सदा लै अटल़,</para>
  <para style="q" vid="PSA 105:8">ज़ुंण तेऊ ज़बान दैनी, सह रहा हज़ारो पोस्ती तैणीं।<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />ज़ुंण करार तेऊ आबराम, इसहाका संघै किई अर</para>
  <para style="q" vid="PSA 105:9">ज़ुंण ज़बान तेऊ याकबा लै दैनी सह आसा अटल़।<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />बिधाता दैनअ याकबे आद-लुआदा लै बधान,</para>
  <para style="q" vid="PSA 105:10">तेऊ किई इज़राईली संघै अटल़ करार।<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />तेऊ बोलअ त इहअ, “मुंह दैणीं तम्हां लै कनान देशे ज़ैगा,</para>
  <para style="q" vid="PSA 105:11">तैहा ज़ैगे मालक हणैं तम्हैं सदा लै।”<verse eid="PSA 105:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />तधू तै तिंयां परमेशरे लोग धख ज़िहै मणछ,</para>
  <para style="q" vid="PSA 105:12">अर कनान देशै तै तिंयां पाखलै।<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />तिंयां रहा तै देशै-देशै हांढदै लागी,</para>
  <para style="q" vid="PSA 105:13">एकी मुल्खा का दुजै मुल्खै।<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />पर बिधाता निं तिन्‍नां कोही मणछा हंतणैं दैनअ,</para>
  <para style="q" vid="PSA 105:14">तिन्‍नें फाज़त करना लै नैरा त बिधाता राज़ै इहअ बोली,<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />“मेरी छ़ांटी दी परज़ा निं छ़ुंहीं छ़ेल़ी आथी,</para>
  <para style="q" vid="PSA 105:15">नां मेरै गूर-पज़ैरै लै हान्‍नी करी।”<verse eid="PSA 105:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />तेखअ छ़ाडअ बिधाता तेऊ देशा लै नकाल़ अर</para>
  <para style="q" vid="PSA 105:16">तेऊ देशा का किअ नाज़-पाणीं दूर।<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />पर तेऊ छ़ाडअ युसुफ नाओं मणछ तिन्‍नां का आजू ज़ुंण</para>
  <para style="q" vid="PSA 105:17">गलाम हणां लै बेच़ी पाअ त।<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />सह डाहअ शांघल़ी दी बान्हीं,</para>
  <para style="q" vid="PSA 105:18">हाथै, खूरै अर गल़ा का थिअ सह लोहे कल़ोलै करै बान्हअ द।<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />सह रहअ तेभै तैणीं गलाम कैदी, ज़ेभै तैणीं तेऊए आप्पै बोली दी गल्‍ला पूरी निं हुई,</para>
  <para style="q" vid="PSA 105:19">बिधाता परखअ सह राम्बल़ै करै कि सह आसा भलअ।<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />मिसर देशे राज़ै छ़ाडै तेऊ सेटा आपणैं दूत,</para>
  <para style="q" vid="PSA 105:20">संघा किअ सह आज़ाद।<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />राज़ै बणाअं युसुफ सारै देशा प्रैंदै मालक,</para>
  <para style="q" vid="PSA 105:21">तेऊ लै दैनअ सारै मिसर देशो राज़।<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />सारै बज़ीर अर कार करिंदै प्रैंदै हक बी दैनअ तेऊ लै,</para>
  <para style="q" vid="PSA 105:22">सोभी बज़ीरा प्रैंदै सैणअ बी बणाअं सह कि सह तिन्‍नां लै सलाह दैए।<verse eid="PSA 105:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />पिछ़ू पजैल़अ बिधाता याकब बी मिसर देशै,</para>
  <para style="q" vid="PSA 105:23">संघा बस्सअ इज़राईल तेऊ देशै परदेसी ज़िहअ।<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />बिधाता दैनी तिन्‍नां लै खास्सी बर्गत अर तिन्‍नें हुई खास्सी आद-लुआद,</para>
  <para style="q" vid="PSA 105:24">तिंयां हुऐ खास्सै अर तिन्‍नें दुशमणा का खास्सै बलबान।<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />बिधाता किहअ इहअ कि मिसरी लोग लागै तेऊए परज़ा संघै ज़ीद डाहंदै,</para>
  <para style="q" vid="PSA 105:25">तिंयां लागै बिधाते च़ाकरी करनै आल़ै संघै छ़ल़-कपट करदै।<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />तेखअ छ़ाडै बिधाता मोसा अर हारण</para>
  <para style="q" vid="PSA 105:26">ज़ुंण बिधाता छ़ांटै दै थिऐ।<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />तिन्‍नैं किऐ मिसरी लोगा जैंदरी डेऊई बडै नुआहरै-नुआहरै काम,</para>
  <para style="q" vid="PSA 105:27">अर तिन्‍नैं रहैऊऐ तिधी बिधाते कई च़मत्कार।<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />बिधाता छ़ाडअ तेऊ देशा लै घोर न्हैरअ,</para>
  <para style="q" vid="PSA 105:28">पर मिसरी लोग निस्सै तज़ी बी बिधाते गल्‍ला मनी।<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />परमेशरै किई तेऊ देशे पाणींए गाडा नाल़ी बी लोहू आल़ी अर</para>
  <para style="q" vid="PSA 105:29">म्हाछ़ली मूंईं पठी।<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />सारअ देश भरअ मिंडकै करै,</para>
  <para style="q" vid="PSA 105:30">राज़े मैहलै बी भर्हुऐ मिंडकै।<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />ज़ांऊं परमेशरै हुकम किअ सारअ देश भर्हुअ डगैछै करै,</para>
  <para style="q" vid="PSA 105:31">अर सारै देशै पल़ी कतूआ।<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />बिधाता बरशाऊऐ पाणींए बदल़ै तिन्‍नां लै सारै देशै बडै-बडै शरू,</para>
  <para style="q" vid="PSA 105:32">ज़ैगै-ज़ैगै पल़ी तिन्‍नां लै बीज।<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />बिधाता किऐ तिन्‍नें फेडू अर दाखे बाग बरैबाद,</para>
  <para style="q" vid="PSA 105:33">सारै देशै पाऐ डाल़-बूट चोल़ी।<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />ज़ांऊं तेऊ हुकम किअ, सारअ देश भर्हुअ रैट्टै करै,</para>
  <para style="q" vid="PSA 105:34">तिन्‍नां किल़ै निं कुंण गणी सकदअ त।<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />तिन्‍नैं रैट्टै कोक्‍करी सारै डाल़-बूट,</para>
  <para style="q" vid="PSA 105:35">नाज़ अर सारी साल-फसल।<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />खिरी पाऐ परमेशरै मिसर देशे सारै मारी,</para>
  <para style="q" vid="PSA 105:36">मिसरीओ निं एक घअर बी छ़ुटअ ज़ेथ ज़ेठअ निं मूंअ।<verse eid="PSA 105:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />तेखअ किऐ बिधाता इज़राईली मिसर देशे गलामी का आज़ाद,</para>
  <para style="q" vid="PSA 105:37">तिन्‍नैं निंयं आप्पू संघै खास्सअ सुन्‍नअ-च़ंदी बी,</para>
  <para style="q" vid="PSA 105:37">तिंयां थिऐ सोभै ज़ण्हैं ताज़ै-नरोगै।<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />इज़राईली मिसर देशा का डेऊंदै भाल़ी हुऐ मिसरी लोग खुश,</para>
  <para style="q" vid="PSA 105:38">किल्हैकि तिन्‍नें दिलै ती इज़राईलीए डअर पल़ी दी।<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />धैल़ी डाहा त बिधाता इज़राईली आजू-आजू प्रैंदै बादल़ अर</para>
  <para style="q" vid="PSA 105:39">राची हांढणा लै डाह त तिन्‍नां लै बडअ आगीओ कूंड ताकि तिन्‍नां लै प्रैश्शअ होए।<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />ज़ांऊं इज़राईली पकार पाई, परमेशरै दैनी तिन्‍नां लै समुंदरी होछ़ै-होछ़ै च़ेल्‍लूए शिखा अर</para>
  <para style="q" vid="PSA 105:40">तेऊ रज़ैऊऐ तिंयां स्वर्गा का खाण दैई करै।<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />बिधाता काढअ तिन्‍नां लै शुक्‍की टोल्हा का पाणीं,</para>
  <para style="q" vid="PSA 105:41">तेते लागी शुक्‍कै रेगीस्तानै गाड बगदी।<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />परमेशरै डाही आपणीं पबित्र करार आद</para>
  <para style="q" vid="PSA 105:42">ज़ुंण तेऊ आपणैं दास आबरामा संघै थिई किई दी।<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />तेऊ नढैऊई आपणीं छ़ांटी दी परज़ा आजू आप्पै,</para>
  <para style="q" vid="PSA 105:43">इज़राईली निखल़ै गिहा अर ज़ै-ज़ैकार करदी गलामी का दूर।<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />ज़ेऊ देशै पराई ज़ातीए लोग तै बस्सै दै, सह ज़ैगा दैनी तेऊ इज़राईली लै,</para>
  <para style="q" vid="PSA 105:44">तेऊ दैनअ तिन्‍नां तैहा ज़ैगा पठी गिम्मणै।<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />तेऊ किअ इहअ तै कि तिंयां तेऊए बधाने साबै आपणीं ज़िन्दगी ज़िऊए अर</para>
  <para style="q" vid="PSA 105:45">तेऊए सोभै हुकम आपणैं दिलै आद डाहे।</para>
  <para style="q" vid="PSA 105:45">बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई।<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">आपणीं परज़ा लै बिधाते झींण</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />बिधाते ज़ै-ज़ैकार, तेऊओ करा शूकर,</para>
  <para style="q" vid="PSA 106:1">किल्हैकि सह आसा भलअ अर सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />बिधाता ज़ुंण महान काम किऐ तेता निं कुंण गणी सकदअ,</para>
  <para style="q" vid="PSA 106:2">तेता लै तेऊए ज़ेतरी बी ज़ै-ज़ैकार करे सह आसा थोल़ी।<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />बिधाता दैआ तिन्‍नां लै बर्गत ज़ुंण शुचै आसा</para>
  <para style="q" vid="PSA 106:3">अर ज़ुंण सदा भलै काम करा।<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />हे बिधाता, ज़ेभै तूह आपणीं परज़े मज़त करे, तेभै निं मुंह बिस्सरी पाई,</para>
  <para style="q" vid="PSA 106:4">तिन्‍नां संघै बच़ाऊऐ तूह मुंह बी।<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />ताकि हुंह तेरै छ़ांटै दै मणछा सफल हंदै भाल़ी सकूं,</para>
  <para style="q" vid="PSA 106:5">संघा हुंह बी तिन्‍नें खुशी दी साझ़ू हई हऊं अर</para>
  <para style="q" vid="PSA 106:5">तेरी आपणीं परज़ा संघै हुंह बी तेरी बड़ैई करूं।<verse eid="PSA 106:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />म्हारै भलै हुऐ तिहै ई पाप ज़िहै म्हारै दाद-बाब करा तै,</para>
  <para style="q" vid="PSA 106:6">हाम्हैं किऐ घोर कदुष्ट काम!<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />ज़ुंण महान अर नुआहरै काम तंऐं मिसर देशै किऐ, तेता निं म्हारै दाद-बाब समझ़ी बोल़ै,</para>
  <para style="q" vid="PSA 106:7">तिन्‍नैं पाअ कई बारी बिस्सरी कि तूह तिन्‍नां लै किहअ खास्सअ झ़ूरा,</para>
  <para style="q" vid="PSA 106:7">लाल समुंदरे बाढै किअ त तिन्‍नैं तूह पिठी पिछ़ू लै!<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />पर तंऐं बच़ाऊऐ तिंयां, ज़ेही तंऐं ज़बान थिई दैनी दी,</para>
  <para style="q" vid="PSA 106:8">ताकि तेरअ महान बल प्रगट होए।<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />तंऐं किअ लाल समुंदरा लै हुकम</para>
  <para style="q" vid="PSA 106:9">अर सह हुअ मांझ़ा-मांझ़ी शुक्‍कअ!</para>
  <para style="q" vid="PSA 106:9">संघा टपाऊई तंऐं आपणीं परज़ा तैहा शुक्‍की ज़ैगा बाती समुंदरा पार।<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />तंऐं बच़ाऊऐ तिंयां तिन्‍नां का ज़ुंण तिन्‍नां संघै ज़ीद करा तै,</para>
  <para style="q" vid="PSA 106:10">तंऐं बचाऊऐ तिंयां तिन्‍नें दुशमणा का।<note caller="+" style="f"><char style="fr" closed="false">106:10 </char><char style="ft" closed="false">इधी आसा दुशमण मिसरी लोगा लै दुशमण बोलअ द</char></note><verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />पर तिन्‍नें दुशमण डुबै लाल समुंदरे पाणीं दी सोभै,</para>
  <para style="q" vid="PSA 106:11">तिन्‍नां मांझ़ै निं कुंण एक बी ज़िऊंदअ रहअ।<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />तेखअ किअ तिन्‍नैं तेरी गल्‍ला दी विश्वास,</para>
  <para style="q" vid="PSA 106:12">संघा लागै गिहा बोली तेरी ज़ै-ज़ैकार करदै।<verse eid="PSA 106:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />पर तेतरी गऐ तिंयां झ़ट च़ारै तेरै कामां बिस्सरुई!</para>
  <para style="q" vid="PSA 106:13">संघा गऐ तेरी सलाह बाझ़ी आपणैं साबै काम करदै लागी!<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />तिन्‍नैं डाहअ सिधअ आपणैं पेटो धैन,</para>
  <para style="q" vid="PSA 106:14">संघा लागै उज़र रेगीस्तानै तिंयां ताह परमेशरा पटंकदै।<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />तंऐं दैनअ तिन्‍नां लै ज़िहअ तिन्‍नैं मांगअ तिहअ,</para>
  <para style="q" vid="PSA 106:15">पर बादा का पाऐ तंऐं घोर बमारी करै मारी।<verse eid="PSA 106:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />रेगीस्तानै लागै तिंयां खिम्भे दला दी मोसा अर हारणा संघै ज़ीद डाहंदै</para>
  <para style="q" vid="PSA 106:16">ज़ुंण तेरै पबित्र दास थिऐ।<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />तेखअ धुआशुई धरती ओर्ही-पोर्ही,</para>
  <para style="q" vid="PSA 106:17">संघा डुबै तेथ दतान, अबीराम तिन्‍नें टबरे टोली संघी।<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />ज़ुंण तिन्‍नां कदुष्टे साथा होर थिऐ,</para>
  <para style="q" vid="PSA 106:18">तिन्‍नां लै पल़ी सरगा का बीज अर तिंयां हुऐ सोभ खतम।<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />तिन्‍नैं बणाअं होरेब धारा गोधै सुन्‍नेंओ बाछ़ू,</para>
  <para style="q" vid="PSA 106:19">संघा लागै तैहा मुहुर्तीए पूज़ा करदै!<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />तिन्‍नैं बदल़अ ताह बिधातो महान प्रतप्प</para>
  <para style="q" vid="PSA 106:20">घाह खाणैं आल़ै पशूए रुपै!<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />तिंयां बिस्सरुऐ तेऊ परमेशरा ज़ुंणी तिंयां बच़ाऊऐ तै!</para>
  <para style="q" vid="PSA 106:21">ज़ुंणी मिसर देशै नुआहरै-नुआहरै महान काम किऐ तै!<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />तंऐं भाल़ तिधी किहै-किहै महान काम किऐ तै!</para>
  <para style="q" vid="PSA 106:22">लाल समुंदरै भाल़ तंऐं किहै नुआहरै काम रहैऊऐ तै!<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />ज़ांऊं तंऐं तिधी रोश्शै इहअ बोलअ कि मंऐं लाऐ ईंयां सोभै पठी खतम करी,</para>
  <para style="q" vid="PSA 106:23">तिधी किई तेरै आप्पू लै छ़ांटै दै दास मोसा ताखा अरज़ कि इहअ निं करी,</para>
  <para style="q" vid="PSA 106:23">तै हुअ तेरअ कोप ठांढअ संघा बच़ै तिंयां मरनै का।<verse eid="PSA 106:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />तेखअ समझ़अ तिन्‍नैं दिला लोभणैं आल़अ सह देश बी बृथा!</para>
  <para style="q" vid="PSA 106:24">किल्हैकि तिन्‍नैं निं तेरी गल्‍ला दी विश्वास डाहअ।<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />तिंयां रहै आपणैं खिम्भे डेरै पल़ी बखर्दै लागी,</para>
  <para style="q" vid="PSA 106:25">तिन्‍नैं निं ताह बिधाते गल्‍ल मनी!<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />तंऐं दैनी तिन्‍नां लै एही चतैनगी,</para>
  <para style="q" vid="PSA 106:26">“ईंयां करनै मुंह एऊ रेगीस्तानै ई खतम।<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />इने आद-लुआद छिंगणी मुंह होरी ज़ाती जैंदरी,</para>
  <para style="q" vid="PSA 106:27">इना दैणअ मुंह पराऐ देशै मरनै।”<verse eid="PSA 106:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />तेखअ लागै भाल़ तिंयां बाल-पोर देअए पूज़ा करदै,</para>
  <para style="q" vid="PSA 106:28">संघा उझ़ुऐ मुल्दै लै बल़ीदान किई दी शिखा खांदै!<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />आपणैं इना कदुष्ट कामां करै ठैऊई तिन्‍नैं ताल्है रोश्शै,</para>
  <para style="q" vid="PSA 106:29">तेखअ पल़ी बै तिन्‍नां जैंदरी नबिज़री बमारी।<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />पर तेखअ निखल़अ पिनहास हिम्मत करी आजू संघा दैनी तिन्‍नां लै सज़ा ज़ुंण दोशी थिऐ,</para>
  <para style="q" vid="PSA 106:30">तैबै जाई करै हुई सह नबिज़री बमारी खतम।<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />तेऊए अह गल्‍ल करनी आजू बी सदा</para>
  <para style="q" vid="PSA 106:31">पोस्ती दर पोस्ती आद।<verse eid="PSA 106:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />मरीबा नाओंए सोबल़ा सेटा बी ठैऊई तिन्‍नैं ताह बिधाता लै रोश्शै,</para>
  <para style="q" vid="PSA 106:32">तेता पिछ़ू पल़ी तेरै दास मोसा लै बडी आफ़त।<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />तिन्‍नैं हंतअ मोसा<note caller="+" style="f"><char style="fr" closed="false">106:33 </char><char style="fq" closed="false">मोसा </char><char style="ft" closed="false">परमेशरो गूर</char></note> खास्सअ,</para>
  <para style="q" vid="PSA 106:33">खिरी बोलअ तेऊ बाझ़ी बच़ारै।<verse eid="PSA 106:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />इज़राईली निं तिंयां कदुष्ट मणछ मारै आथी,</para>
  <para style="q" vid="PSA 106:34">ज़हा लै बिधाता इहअ बोलअ त कि इना निं ज़िऊंदै छ़ाडी,<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />पर तिंयां घूल़ै-मिल़ै तिन्‍नां देशे लोगा संघै आप्पू पै,</para>
  <para style="q" vid="PSA 106:35">संघा शिखल़ै तिन्‍नें इहै रिती-रबाज़ ज़ेता का तूह बिधाता नराज़ हआ।<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />तिंयां लागै मुहुर्ती पूज़दै अर</para>
  <para style="q" vid="PSA 106:36">सह ई हुई तिन्‍नां लै बरैबाद करनै आल़ी फाही।<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />होर ता होर तिन्‍नैं किऐ कनान देशै आपणैं शोहरू-शोहरी तोही</para>
  <para style="q" vid="PSA 106:37">भूत-बशाचे मुहुर्ती लै बल़ीदान!<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />तिन्‍नैं किई तिन्‍नां नर्दोश लान्हें हत्या,</para>
  <para style="q" vid="PSA 106:38">तैही लागी तेऊ सारै देशै तिन्‍नां हत्या करनै आल़ेए छ़ोत।<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />तिंयां हुऐ तिन्‍नें आपणैं कदुष्ट कामां करै छ़ोतलै,</para>
  <para style="q" vid="PSA 106:39">तिन्‍नों मुहुर्ती पूज़णा लै झ़ूरनअ शुझुअ ताह बिधाता का कंज़रैई करनै ज़िहअ पाप।<verse eid="PSA 106:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />तैही आई ताह बिधाता इना इहै मणछा लै रोश्शै,</para>
  <para style="q" vid="PSA 106:40">ताह हुई तिन्‍नां का खास्सी नफरत।<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />तेखअ डाहै तंऐं तिंयां पराई ज़ातीए लोगा जैंदरी शोटी,</para>
  <para style="q" vid="PSA 106:41">तंऐं दैनअ तिन्‍नां प्रैंदै तिन्‍नें दुशमणा राज़ करनै।<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />तिन्‍नें दुशमणै मारै तिंयां हंती-हंती,</para>
  <para style="q" vid="PSA 106:42">तिंयां आणै तै तिन्‍नैं पठी हारी-मारी।<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />तूह बिधाता रहअ तिन्‍नां हर बगत बच़ाऊंदअ लागी,</para>
  <para style="q" vid="PSA 106:43">पर तिंयां रहै ताल्है द्रोह करदै लागी</para>
  <para style="q" vid="PSA 106:43">अर होर बी खास्सै पाप करदै लागी!<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />ज़ांऊं खास्सी खरीए पलका ताखा तिन्‍नें लेर-पकार शुण्हुंई,</para>
  <para style="q" vid="PSA 106:44">तूह निं तज़ी बी तिन्‍नें मज़त करनै का पिछ़ू हटअ।<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />तंऐं डाही तिन्‍नें भलाईए तैणीं आपणीं करार आद,</para>
  <para style="q" vid="PSA 106:45">तूह आसा इहअ महान कि तूह झ़ूरा खास्सअ अर तंऐं किई तिन्‍नां लै झींण।<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />तंऐं बझ़ैल़ी तेखअ तिन्‍नां का बी झींण करनै</para>
  <para style="q" vid="PSA 106:46">ज़ुंणी तिंयां गलाम तै डाहै दै बणाईं।<verse eid="PSA 106:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />ए म्हारै परमेशर बिधाता, हाम्हां बच़ाऊ,</para>
  <para style="q" vid="PSA 106:47">हाम्हां पजैल़ देशा-देशा का झाल़ी करै बापस,</para>
  <para style="q" vid="PSA 106:47">ताकि हाम्हैं तेरअ शूकर करी सके अर</para>
  <para style="q" vid="PSA 106:47">तेरै पबित्र नाओंए ज़ै-ज़ैकार करी सके।<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />इज़राईले परमेशर बिधाते करा ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 106:48">तेऊए करा आझ़ा पोर्ही सदा ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 106:48">सोभै बोला, “एवमस्तू!” बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई।<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">पांज़ूअ निसब</para>
  <para style="mr">(<ref loc="PSA 107:1-150:6">भज़न 107:1—150:6</ref>)</para>
  <para style="s">बिधाता आसा आपणीं परज़ा लै भलअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />बिधातो शूकर करा, किल्हैकि सह आसा भलअ!</para>
  <para style="q" vid="PSA 107:1">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />तम्हैं ज़ुंण बिधाता आज़ाद आसा किऐ दै,</para>
  <para style="q" vid="PSA 107:2">बिधाते ज़ै-ज़ैकार करना लै बोला ऐहा गल्‍ला भिई-भिई।</para>
  <para style="q" vid="PSA 107:2">तेऊ आसा तम्हैं थारै दुशमणे हाथा का छ़ड़ैऊई आणै दै।<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />तेऊ पजैल़ै तम्हैं पराऐ देशा का,</para>
  <para style="q" vid="PSA 107:3">पुर्ब, पछ़म, उतर, दखणा का बापस फरेऊई।<verse eid="PSA 107:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />तम्हां मांझ़ै तै कई उज़र रेगीस्तानै शोठुई कल्ही छ़ुटै दै,</para>
  <para style="q" vid="PSA 107:4">तिन्‍नां का निं किधी नगरी डेऊई रहणा लै बात भेटी निस्सी ती।<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />तिंयां थिऐ भुखै-नचिशै,</para>
  <para style="q" vid="PSA 107:5">तिन्‍नैं हेरअ त आपणअ हैअ चोल़ी।<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />तैहा आफ़ते पलका पाई तिन्‍नैं बिधाता सेटा पकार,</para>
  <para style="q" vid="PSA 107:6">तेऊ बच़ाऊऐ तिंयां तैहा खरी का।<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />तेऊ नढैऊऐ तिंयां सुंबल़ी बाता</para>
  <para style="q" vid="PSA 107:7">तैहा नगरी लै ज़िधी तिंयां बस्सी सके।<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />बिधाता भाल़ हाम्हां मणछा लै किहअ झ़ूरा, सह भाल़ केही झींण करा,</para>
  <para style="q" vid="PSA 107:8">तेता लै करनअ तेऊओ शूकर, ज़ुंण महान काम तेऊ हाम्हां लै किऐ।<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />ज़ुंण नचिशै थिऐ, तिन्‍नां लै दैनअ तेऊ रज्ज़ी झुटणा लै,</para>
  <para style="q" vid="PSA 107:9">भुखै लै दैनअ रज्ज़ी खाणां लै।<verse eid="PSA 107:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />कई तै तम्हां मांझ़ै मारना लै न्हैरी खुडी कैद किऐ दै,</para>
  <para style="q" vid="PSA 107:10">हाथ-खूर तै शांघल़ी-लोहै करै बान्हीं डाहै दै।<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />किल्हैकि तम्हैं च़लै परम प्रधान परमेशरे बधाना छ़ाडी उंबल़ी बाखा,</para>
  <para style="q" vid="PSA 107:11">तम्हैं निं तेऊए सलाह मनी।<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />तम्हैं दझ़ै-प्लुशूऐ गलामी दी धैल़-राच काम करी-करी,</para>
  <para style="q" vid="PSA 107:12">ठोहल़ लागी धरना का उझै उझ़णा लै मज़त करनै आल़अ निं तम्हां लै कोहै भेटअ।<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />ज़ांऊं तम्हां खास्सी आफ़त पल़ी तैबै जाई पाई तम्हैं बिधाता सेटा लेर-पकार,</para>
  <para style="q" vid="PSA 107:13">तेखअ बच़ाऊऐ तेऊ तम्हैं तैहा खरी का।<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />तेऊ चोल़ै थारै हाथा-खूरा का शांघल़ी-लोहै पोर्ही,</para>
  <para style="q" vid="PSA 107:14">संघा काढै तेऊ नटिप्प न्हैरै जैंदरा का बागै ज़िधी आजू तम्हां लै मौत थिई।<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />बिधाता भाल़ किहअ झ़ूरा, सह भाल़ हाम्हां मणछा लै केही झींण करा,</para>
  <para style="q" vid="PSA 107:15">तेता लै करनअ तेऊओ शूकर, ज़ुंण महान काम तेऊ हाम्हां लै किऐ।<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />किल्हैकि तेऊ चोल़ी कांस्से बडी-बडी प्रऊल़ी अर</para>
  <para style="q" vid="PSA 107:16">लोहे बडी-बडी आगल़ीए किऐ तेऊ ठोर-ठोर।<verse eid="PSA 107:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />कई किऐ तम्हां मांझ़ै ऐडै ज़िहै पाप,</para>
  <para style="q" vid="PSA 107:17">संघा रहै तेता पिछ़ू दाह-दुखा दी चाछल़दै लागी।<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />तिन्‍नों ज़िऊ निं रोटी खाणां लै बी बोल्दअ त,</para>
  <para style="q" vid="PSA 107:18">तिंयां थिऐ दोत-ऊड़ मरदै तैर।<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />तैहा आफ़ता मांझ़ै पाई तिन्‍नैं बिधाता सेटा लेर-पकार,</para>
  <para style="q" vid="PSA 107:19">तेऊ बच़ाऊऐ तिंयां तैहा खरी का।<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />सह करा आपणैं बैणा करै नरोगै,</para>
  <para style="q" vid="PSA 107:20">तेऊ बच़ाऊऐ तिंयां तैहा डुघी खात्ती का ज़ेथ तिंयां पल़ै दै थिऐ।<verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />बिधाता भाल़ किहअ झ़ूरा, सह भाल़ हाम्हां मणछा लै केही झींण करा,</para>
  <para style="q" vid="PSA 107:21">तेता लै करनअ तेऊओ शूकर, ज़ुंण महान काम तेऊ हाम्हां लै किऐ।<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />तेऊओ शूकर करना लै करनअ बल़ीदान,</para>
  <para style="q" vid="PSA 107:22">गिहा बोली अर ज़ै-ज़ैकार करी खोज़णअ तेऊए महान कामें बारै सोभी का ज़ुंण तेऊ किऐ।<verse eid="PSA 107:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />कई तै तम्हां मांझ़ै ज़ुंण समुंदरै ज़हाज़ा दी बपार करी</para>
  <para style="q" vid="PSA 107:23">आप्पू ज़िऊंणां लै ढब्बै खटा तै।<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />तिन्‍नां का बी शुझुअ कि बिधाता किज़ै सका करी,</para>
  <para style="q" vid="PSA 107:24">तिन्‍नैं भाल़ै डुघै समुंदरै बिधाते महान काम।<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />ज़ांऊं सह हुकम करा, सरगै च़ला ढिश-बागर,</para>
  <para style="q" vid="PSA 107:25">समुंदरा का लागा बडी-बडी उछ़टी छ़ाल्‍ली उझ़दी,<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />अर समुंदरै हांढदै ज़हाज़ा लागा उछ़टै झ़लारै,</para>
  <para style="q" vid="PSA 107:26">संघा डुबा उंधै थाल्‍लै तैणीं,</para>
  <para style="q" vid="PSA 107:26">एही आफ़ता जैंदरी चुटा बपार करनै आल़ैओ हैअ।<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />तिन्‍नां फिरा घेरअ अर तिंयां बधल़िआ शराबी ज़िहै,</para>
  <para style="q" vid="PSA 107:27">तिन्‍नें हआ तेभै सारी बिक्री बृथा।<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />तेही आफ़ता जैंदरी पाई तिन्‍नैं बिधाता सेटा लेर-पकार,</para>
  <para style="q" vid="PSA 107:28">तेऊ बच़ाऊऐ तिंयां तैहा खरी का।<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />सह करा बडी-बडी ढिश-बागरी शांत अर</para>
  <para style="q" vid="PSA 107:29">समुंदरे बडी-बडी छ़ाल्‍ली बेशा तेऊ डरै च़ुप्पी।<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />तेता भाल़ी हुऐ तै तिंयां बपारी बी खुश,</para>
  <para style="q" vid="PSA 107:30">बिधाता पजैल़ै तिंयां राज्ज़ी-राम्बल़ै ज़हाज़े आडै ज़िधी तिन्‍नां पुजणअ थिअ।<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />बिधाता भाल़ किहअ झ़ूरा, सह भाल़ हाम्हां मणछा लै केही झींण करा,</para>
  <para style="q" vid="PSA 107:31">तेता लै करनअ तेऊओ शूकर, ज़ुंण महान काम तेऊ हाम्हां लै किऐ।<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />ज़ेभै बिधाते लोगो झाल़अ होए, तेभै खोज़णीं सोभी नदरी तेऊ ईंयां महान गल्‍ला,</para>
  <para style="q" vid="PSA 107:32">सैणैं सेटा करनी बिधाते बड़ैई।<verse eid="PSA 107:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />बिधाता सका बगदी गाडा बी शुक्‍कअ रेगीस्तान करी अर</para>
  <para style="q" vid="PSA 107:33">बडै-बडै पाणींए छ़ोआ बी शकेऊई।<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />सह सका रज़दी-पज़दी ज़ैगा बंज़र करी,</para>
  <para style="q" vid="PSA 107:34">ज़ै तिधी बस्सै दै लोग कदुष्ट हई पाप करे।<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />बिधाता सका उज़र रेगीस्ताना पाणींओ सअर बणाईं,</para>
  <para style="q" vid="PSA 107:35">अर शुक्‍की रुखी ज़ैगा सका पाणींए छ़ो काढी।<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />ज़ुंण भुखै होए, तिंयां सका तिधी बस्सी,</para>
  <para style="q" vid="PSA 107:36">कि तिंयां आप्पू लै तिधी नगरी बसाओए।<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />तिंयां सका तिधी खेच खटी अर दाखे बाग लाई,</para>
  <para style="q" vid="PSA 107:37">अर भांती-भांतीए साल-फसल पज़ेरी।<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />बिधाता दैआ आपणीं परज़ा लै बर्गत अर तिन्‍नें हआ खास्सी आद-लुआद,</para>
  <para style="q" vid="PSA 107:38">बिधाता निं तिन्‍नें डागै-चैणैं बी घटणैं दैंदअ।<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />हई सका कि केभै तिन्‍नां लै दाह-दुख खरी पल़े,</para>
  <para style="q" vid="PSA 107:39">च़ाऐ तिंयां गणी करै धख ज़िहै ई बच़े।<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />पर बिधाता लआ तिन्‍नां का आप्पै बदल़अ ज़ुंणी तिंयां हंतै अर हारै-मारै,</para>
  <para style="q" vid="PSA 107:40">संघा पजैल़ा तिन्‍नां इहै करबैऊंणैं रेगीस्तानै ज़ेथ केस्सी डेऊणा लै बात बी निं भेटदी।<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />बिधाता छ़ड़ैऊआ रैनै-गरीबा आप्पै संघा बशैल़ा तिन्‍नां उछ़टै दी,</para>
  <para style="q" vid="PSA 107:41">तिन्‍नें आद-लुआद बढेरा सह भेडा-बाकरीए हेल़्ही ज़ेही।<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />धर्मीं मणछ हणैं एता भाल़ी खुश,</para>
  <para style="q" vid="PSA 107:42">पर कदुष्ट मणछे खाखा हणीं बंद।<verse eid="PSA 107:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />ज़हा अक्ल होए, तेऊ दैणअ इना गल्‍ला दी धैन,</para>
  <para style="q" vid="PSA 107:43">तेऊ हेरनअ ऐहा गल्‍लो बच़ार करी कि बिधाता किहअ झणैल़ू आसा।<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">बिधाता आसा हाम्हां बाखा</para>
  <para style="r">(<ref loc="PSA 57:7-11">भज़न 57:7-11</ref>; <ref loc="PSA 60:5-12">60:5-12</ref>)</para>
  <para style="d">परमेशरा लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />हे परमेशर, मेरअ दिल करा तेरअ पाक्‍कअ भरोस्सअ!</para>
  <para style="q" vid="PSA 108:1">मुंह करनी गिहा बोली तेरी ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 108:1">मुंह बोल़णैं दिल खोल्ही तेरै भज़न।<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />ए मेरै मन्‍नां ज़ाग! उझ़ू,</para>
  <para style="q" vid="PSA 108:2">तारा आल़ै बाज़ै अर बींन ज़ागा!</para>
  <para style="q" vid="PSA 108:2">मुंह जाणअ राच भैंदी उझ़ुई।<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />हे बिधाता, मुंह करनअ देशा-देशे लोगा जैंदरी तेरअ शूकर,</para>
  <para style="q" vid="PSA 108:3">सोभी लोगा नदरी करनी मुंह गिहा बोली तेरी ज़ै-ज़ैकार।<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />हाम्हां लै तेरी अटल़ झ़ूरी आसा सरगा का बी उझै तैणीं,</para>
  <para style="q" vid="PSA 108:4">तेरअ सत्त आसा सारै भ्रमंडै।<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />हे बिधाता, तेरअ अदर लोल़ी सारै भ्रमंडै हुअ अर</para>
  <para style="q" vid="PSA 108:5">तेरअ प्रतप्प लोल़ी सारी पृथूई दी शुझुअ।<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />मेरी अरज़ शुण अर तूह बच़ाऊ हाम्हां आपणैं महान बला करै,</para>
  <para style="q" vid="PSA 108:6">ज़हा लै तूह झ़ूरा, तिंयां लोल़ी तै बच़ै।<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />हे परमेशर, तूह आसा पबित्र अर तंऐं आसा इहअ बोलअ द,</para>
  <para style="q" vid="PSA 108:7">“मुंह हणीं शकेम नगरी बांडदा खुशी अर</para>
  <para style="q" vid="PSA 108:7">मुंह दैणीं सक्‍कोत सऊंऐं मुल्खे ज़ैगा नापी करै मेरी परज़ा लै बांडी।<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />गलाद बी आसा मेरअ अर मनिश्शे बी आसा मेरअ,</para>
  <para style="q" vid="PSA 108:8">एप्रैम आसा मेरै मुंडो टोप अर</para>
  <para style="q" vid="PSA 108:8">यहूदा आसा मेरी नसाफ करने छ़ल़ी।<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />पर मोआब आसा मेरअ हाथा धोणेंओ भांडअ,</para>
  <para style="q" vid="PSA 108:9">एदोमा लै शोटणअ मुंह आपणैं खूरो पोलल़अ नछ़ैण कि तेऊओ मालक आसा हुंह आप्पै।</para>
  <para style="q" vid="PSA 108:9">पलिश्ती का ज़िती करनी मुंह ज़ै-ज़ैकार।”<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />हे परमेशर, बडी-बडी उछ़टी दुआली आल़ी नगरी हुंह कहा पजैल़णअ?</para>
  <para style="q" vid="PSA 108:10">एदोम तैणीं हुंह कहा दैणअ संघी।<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />हे परमेशर, तंऐं कै हाम्हैं पठी डाहै शोटी?</para>
  <para style="q" vid="PSA 108:11">ऐबै कै तूह म्हारी सैना आजू-आजू हांढणअ निं आथी?<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />हे बिधाता, म्हारै दुशमणा का बच़णा लै कर म्हारी मज़त,</para>
  <para style="q" vid="PSA 108:12">किल्हैकि मणछे मज़त हआ बृथा!<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />ज़ै तूह परमेशर हाम्हां संघै होए, तै जाणैं हाम्हैं ज़िती,</para>
  <para style="q" vid="PSA 108:13">ताह हेरनै म्हारै दुशमण हारी।<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">बिधाता का मज़त मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />हे बिधाता, हुंह करा तेरी ई स्तोती, तूह निं ऐबै च़ुप्पी रही!<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />कदुष्ट अर कपटी मणछे गोटअ हुंह फेरा-फेर,</para>
  <para style="q" vid="PSA 109:2">तिंयां पाआ मेरै बारै झ़ुठी फुआह।<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />तिंयां करा थोघै बाझ़ी मेरी बूराई,</para>
  <para style="q" vid="PSA 109:3">तिंयां एछा एही बाझ़ी मुंह संघै झ़घल़दै।<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />हुंह झ़ूरा तिन्‍नां लै एतरअ कि हुंह करा तिन्‍नें भलै लै प्राथणां,</para>
  <para style="q" vid="PSA 109:4">पर तिंयां करा कबल्‍लै मेरै घैंचल़।<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />तिन्‍नैं किअ मेरी भलाईए बदल़ै मुल्है बूरअ ई,</para>
  <para style="q" vid="PSA 109:5">हुंह डाह तिन्‍नां लै झ़ूरी अर तिंयां डाह मुंह संघै ज़ीद!<verse eid="PSA 109:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />तूह कर इहअ कि मेरै तिंयां दुशमण लोल़ी तै कहा कदुष्ट मणछे बशै पल़ै,</para>
  <para style="q" vid="PSA 109:6">तिन्‍नां लै छ़ाड इहअ मणछ ज़ुंण तिन्‍नों दाऊअ करे।<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />ज़ेभै तिन्‍नों नसाफ हणअ, तेभै लोल़ी तिंयां दोशी निखल़ै।</para>
  <para style="q" vid="PSA 109:7">तिन्‍नें प्राथणां बी लोल़ी तिन्‍नां लै पाप गणी।<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />तिंयां लोल़ी आधी अमरा मूंऐं अर</para>
  <para style="q" vid="PSA 109:8">तिन्‍नें पदबी लोल़ी कहा होरी भेटी!<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />तिन्‍नें लान्हैं सुन्हैं लोल़ी छ़ुटै-मुक्‍कै अर</para>
  <para style="q" vid="PSA 109:9">तिन्‍नें बेटल़ी लोल़ी बिधबा हुई।<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />तिन्‍नें लान्हैं लोल़ी टुकरै मांगदै हुऐ अर</para>
  <para style="q" vid="PSA 109:10">तिंयां लोल़ी तिन्‍नें बरैबाद हुऐ दै घअरा का ज़ैगै-ज़ैगै ठुल़्दै लागै।<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />तिन्‍नें ज़ैदात लोल़ी पठी रैहण डुबी,</para>
  <para style="q" vid="PSA 109:11">तिन्‍नें कमाई लोल़ी कुंणी परदेसी पठी पाई।<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />तिन्‍नां लै निं कोही झींण लोल़ी किई,</para>
  <para style="q" vid="PSA 109:12">नां तिन्‍नें छ़ुटै-मुक्‍कै दै लान्हैंओ कुंण हेर-सभाल़ करनै आल़अ लोल़ी हुअ।<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />तिन्‍नें आद-लुआद लोल़ी पठी मूंईं,</para>
  <para style="q" vid="PSA 109:13">आगली पोस्ती दी निं तिन्‍नों नाअं ई लोल़ी रहअ।<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />हे बिधाता, ज़ुंण पाप तिन्‍नें दादै-बाबै किअ, तेता डाहै तूह आद,</para>
  <para style="q" vid="PSA 109:14">तिन्‍नें ईजा-बाबो पाप निं माफ करी आथी।<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />हे बिधाता, तूह करै कबल्‍लअ तिन्‍नों पाप आद करी,</para>
  <para style="q" vid="PSA 109:15">पृथूई दी निं कोही मणछा आजू तिन्‍नें बारै थोघ हुअ।<verse eid="PSA 109:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />तिंयां मणछ तै बेघै नर्दैई,</para>
  <para style="q" vid="PSA 109:16">तिंयां मारै तै रैनै-गरीबा हंती-हंती,</para>
  <para style="q" vid="PSA 109:16">तिंयां रहा तै तिन्‍नें पिछ़ै पल़ी ज़सरी मज़त करनै आल़अ कोहै निं हंदअ त।<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />तिंयां झ़ूरा तै होरी लै फिटक दैंदै, ऐबै लोल़ी सह फिटक तिन्‍नां लागअ,</para>
  <para style="q" vid="PSA 109:17">होरी लै बर्गत दैणा लै निं तिंयां खुश हंदै ई आथी तै! ऐबै निं तिन्‍नां लै बर्गत दैणैं आल़अ कोहै लोल़ी भेटअ।<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />फिटक दैणअ हआ त तिन्‍नां लै झिकल़ै बान्हणैं ज़ेही शोभा,</para>
  <para style="q" vid="PSA 109:18">सह फिटक लोल़ी त ऐबै तिन्‍नें आपणैं पेटै पाणीं ज़िहअ</para>
  <para style="q" vid="PSA 109:18">अर तिन्‍नें हाडकै दी तेला ज़िहअ रप्पअ!<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />तिन्‍नें फिटका करै लोल़ी तिंयां आप्पू ई फेरा-फेर गोठुऐ,</para>
  <para style="q" vid="PSA 109:19">सह लोल़ी तिन्‍नें कुछी गाची ज़िहअ पिड्डअ शाचअ।<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />हे बिधाता, मेरै दुशमणा लोल़ी अह ई बदल़अ भेटअ,</para>
  <para style="q" vid="PSA 109:20">ज़ुंण थोघै बाज़ी मुल्है बूरअ बोला।<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />पर हे म्हारै मालक बिधाता, तूह आसा पबित्र, मेरी मज़त लऐ तूह करी ज़ेही तंऐं ज़बान आसा दैनी दी,</para>
  <para style="q" vid="PSA 109:21">मुल्है कर तूह आपणीं महान झींण प्रगट, संघा लऐ मुंह बच़ाऊई।<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />हुंह आसा गरीब, मेरै आसरै लै निं कोहै आथी,</para>
  <para style="q" vid="PSA 109:22">मंऐं हेरअ पठी हैअ चोल़ी।<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />हुंह च़ाल्‍लअ उडदी छ़ैल्‍ली ज़िहअ मुक्‍की,</para>
  <para style="q" vid="PSA 109:23">हुंह आसा रैट्टै ज़िहअ करोल़्हदअ लागअ द।<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />भुखै चुटी ऐबै मेरी ज़ांघा बी अर</para>
  <para style="q" vid="PSA 109:24">पेटे आंजा लरुगी पठी अर मेरी खाल्हल़ी शाची हाडकै दी ल़पट्ट।<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />लोग लागा मुंह भाल़ी हास्सदै,</para>
  <para style="q" vid="PSA 109:25">तिंयां करा हाथ अर मुंडा करै शारअ करी मेरअ सुहांग।<verse eid="PSA 109:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />हे बिधाता, मेरै परमेशर, तूह कर मेरी मज़त,</para>
  <para style="q" vid="PSA 109:26">मुंह बच़ाऊ, किल्हैकि तूह झ़ूरा मुल्है खास्सअ।<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />होरी का बी लोल़ी थोघ लागअ कि</para>
  <para style="q" vid="PSA 109:27">सह आसा तूह बिधाता ज़ुंण मुंह बच़ाऊआ।<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />तिंयां ता दैआ मुल्है फिटक, पर ऐबै दै तूह मुल्है बर्गत!</para>
  <para style="q" vid="PSA 109:28">मुंह हंतणैं आल़ै लोल़ी हारी करै शर्मिंदै हुऐ अर</para>
  <para style="q" vid="PSA 109:28">हुंह ज़ुंण तेरअ दास आसा, मुंह लोल़ी नाच़णै जोगी खुशी भेटी।<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />तिन्‍नां कर तूह फेरा-फेर इहै शर्मिंदै,</para>
  <para style="q" vid="PSA 109:29">ज़िहै तिन्‍नैं झिकल़ै बान्हीं आपणीं देही आसा बुदरी दी।<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />हे बिधाता, मुंह करनअ तेरअ खास्सअ शूकर,</para>
  <para style="q" vid="PSA 109:30">मुंह करनी तेरी खास्सै मणछा जैंदरी तेरी बड़ैई।<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />किल्हैकि तूह बिधाता हआ रैनै-गरीबा संघै खल़अ,</para>
  <para style="q" vid="PSA 109:31">तूह बच़ाऊआ तिन्‍नां आप्पै तिन्‍नां का ज़ुंणी तिंयां मारी आसा लाऐ दै।<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">ज़ीत दैआ बिधाता आप्पै</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />बिधाता बोला राज़ै लै ज़ुंण मेरअ मालक आसा,</para>
  <para style="q" vid="PSA 110:1">“ज़ांऊं तैणीं हुंह तेरै दुशमणा तेरै खूरा हेठै च़ौकी निं बणाऊं,</para>
  <para style="q" vid="PSA 110:1">तेभै तैणीं रह तूह मेरी दैहणीं कुछी बाखा बेशी।”<note caller="-" style="x"><char style="xo" closed="false">110:1 </char><char style="xt" closed="false"><ref loc="HEB 10:12-13">इब्रा. 10:12-13</ref>; <ref loc="LUK 20:42-43">लूक. 20:42-43</ref></char></note><verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />बिधाता बढेरनअ तेरै राज़ो बल सियोना का सारै दी, बिधाता बोला इहअ,</para>
  <para style="q" vid="PSA 110:2">“तूह करै आपणैं दुशमणा प्रैंदै राज़।<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />ज़हा धैल़ी पोर्ही ताह आपणैं दुशमणा संघै जुध करनअ,</para>
  <para style="q" vid="PSA 110:3">तेरी परज़ा हणीं तेरी च़ाकरी करदी।</para>
  <para style="q" vid="PSA 110:3">दोत्ती पल़ै दै ओशा ज़िहै एछणैं खारकै मणछ</para>
  <para style="q" vid="PSA 110:3">ताह सेटा लै तेरी पबित्र धारा।”<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:4 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 7:17">इब्रा. 7:17</ref>,<ref loc="HEB 7:21">21</ref> </char>
    </note>बिधाता आसा आप्पै ज़बान दैनी दी अर सह निं तेता का हुधदअ, ज़िहअ तेऊ बोलअ,</para>
  <para style="q" vid="PSA 110:4">“तूह हणअ सदा लै माहा प्रोहत, ज़िहअ मल्किसदोक थिअ।”<verse eid="PSA 110:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />मालक आसा आप्पै तेरी दैहणीं बाखा खल़अ, ज़ांऊं तेऊ रोश्श एछी जाए,</para>
  <para style="q" vid="PSA 110:5">तेऊ सेटा निं बडै-बडै राज़ै टेक्‍की सकदै।<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />तेऊ करनअ देशा-देशो नसाफ,</para>
  <para style="q" vid="PSA 110:6">तेऊ झेचणी तिन्‍नें तुंबी अर</para>
  <para style="q" vid="PSA 110:6">सारी पृथूई दी लागणै मुल्दे रूल़।<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />बाता हांढदी झुटणअ तेऊ ज़ुंण तेऊओ दिल च़ाहे तैहा गाडो पाणीं,</para>
  <para style="q" vid="PSA 110:7">सह रहणअ सदा ज़ितदअ ई लागी।<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">बिधाता ज़ुंण किअ, तेता लै करा शूकर</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />बिधाते करा ज़ै-ज़ैकार<note caller="+" style="f"><char style="fr" closed="false">111:1 </char><char style="fq" closed="false">ज़ै-ज़ैकार </char><char style="ft" closed="false">इब्रा. बोली दी बोला हाल्‍लेलुयाह</char></note>!</para>
  <para style="q" vid="PSA 111:1">मुंह करनअ बिधाते आपणीं परज़े सभा दी,</para>
  <para style="q" vid="PSA 111:1">तत्त-दिला का बिधातो शूकर।<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />बिधाता भाल़ किहै महान काम किऐ!</para>
  <para style="q" vid="PSA 111:2">ज़ेतरै तेता लै खुश रहा तिंयां दैआ तेथ धैन।<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />ज़ुंण बी बिधाता काम करा, तेथ हआ प्रतप्प अर तिंयां काम हआ महान ई,</para>
  <para style="q" vid="PSA 111:3">तेऊओ नसाफ करनैओ बल आसा अटल़।<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />बिधाता निं हाम्हां तेऊए च़मत्कारे महान काम बिस्सर्नै दैंदअ,</para>
  <para style="q" vid="PSA 111:4">बिधाता दैआ जश अर सह आसा झणैल़ू।<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />ज़ुंण तेऊओ अदर करा, सह निं तिन्‍नां भुखै डाहंदअ,</para>
  <para style="q" vid="PSA 111:5">सह निं आपणीं करार तिन्‍नां लै कधि बिस्सरदअ।<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />तेऊ रहैऊअ आपणीं परज़ा का आपणअ प्रतप्प</para>
  <para style="q" vid="PSA 111:6">तिन्‍नां लै परदेसी देशे ज़ैगा दैई।<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />बिधाते कामां दी आसा सत्त अर नसाफ,</para>
  <para style="q" vid="PSA 111:7">तेऊओ बधान आसा शुचअ-पाक्‍कअ।<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />तेऊओ बधान आसा अटल़,</para>
  <para style="q" vid="PSA 111:8">किल्हैकि तेथ आसा भलाई अर सत्त।<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />तेऊ किई आपणीं परज़ा गलामी का आज़ाद,</para>
  <para style="q" vid="PSA 111:9">तेऊ किई तिन्‍नां संघै अटल़ करार।</para>
  <para style="q" vid="PSA 111:9">सह आसा पबित्र अर सोभी लागा तेऊए डरा हेठै रहणअ।<verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />बिधाते डरा हेठै रहणअ आसा अक्लीओ मूल़,</para>
  <para style="q" vid="PSA 111:10">ज़ुंण तेऊए हुकम मना, तिन्‍नां एछा सुंबल़ी सोर।</para>
  <para style="q" vid="PSA 111:10">बिधाते हणीं सदा ज़ै-ज़ैकार।<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">बिधाता दैआ धर्मीं मणछा लै बर्गत</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />बिधाते करा ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 112:1">बिधाता हआ तेऊ मणछा लै खुश ज़ुंण तेऊओ अदर करा अर</para>
  <para style="q" vid="PSA 112:1">ज़ुंण तेऊए हुकम मना।<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />तेऊए आद-लुआद हणीं देशै बलबान अर</para>
  <para style="q" vid="PSA 112:2">तेऊ भेटणीं परमेशरा का खास्सी बर्गत।<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />तेऊओ घअर रहणअ सदा भरी अर</para>
  <para style="q" vid="PSA 112:3">सह करनअ तेऊए भलाई लै लोगा सदा आद।<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />भलै मणछा लै हआ न्हैरै दी बी प्रैश्शअ,</para>
  <para style="q" vid="PSA 112:4">ज़ुंण झणैल़ू, झ़ूरनै आल़ै अर धर्मीं हआ।<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />तेऊ मणछा लै हआ बर्गत ज़ुंण होरी लै बी ऋण दैआ अर</para>
  <para style="q" vid="PSA 112:5">ज़ुंण बपार करना लै मानदार हआ।<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />सह भलअ मणछ हआ सदा सफल,</para>
  <para style="q" vid="PSA 112:6">तेऊ डाहा लोग बी सदा आद।<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />ज़ै तेऊ बेघै बूरअ समाद बी भेटे, सह निं तैबी बी डरदअ,</para>
  <para style="q" vid="PSA 112:7">तेऊओ विश्वास हआ पाक्‍कअ अर सह रहा बिधाते आसरै।<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />तेऊ निं किछ़ै हैल़अ-फिकर हंदअ,</para>
  <para style="q" vid="PSA 112:8">तेऊ हआ निहंचअ कि तिन्‍नें दुशमण जाणैं हारी।<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />सह दैआ रैनै-गरीबा लै खुल्है हाथै,</para>
  <para style="q" vid="PSA 112:9">तेऊए धर्मीं काम डाहणैं सदा आद।</para>
  <para style="q" vid="PSA 112:9">सह हणअ बलबान अर तेऊओ करनअ सोभी अदर।<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />कदुष्टे दिलै लागा एता भाल़ी आग,</para>
  <para style="q" vid="PSA 112:10">तिंयां रहा ज़िदै दांदा-कटिल्‍लदै लागी अर तिहअ ई करै हणैं तिंयां खतम,</para>
  <para style="q" vid="PSA 112:10">तिन्‍नें आशा हणीं सदा लै खतम।<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">ज़ेभै गरज़ पल़ी, तेभै करा बिधाता मज़त।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />बिधाते ज़ै-ज़ैकार करा।</para>
  <para style="q" vid="PSA 113:1">ज़ुंण तम्हैं तेऊए च़ाकरी करा,</para>
  <para style="q" vid="PSA 113:1">तम्हैं करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />बिधाते ज़ै-ज़ैकार लोल़ी</para>
  <para style="q" vid="PSA 113:2">आझ़ा पोर्ही सारी सदा हुई।<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />पुर्बा ओर्ही पछ़मा तैणीं करा सोभै</para>
  <para style="q" vid="PSA 113:3">बिधाते नाओंए ज़ै-ज़ैकार।<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />बिधाता करा सोभी देशा प्रैंदै राज़,</para>
  <para style="q" vid="PSA 113:4">तेऊओ प्रतप्प आसा सारै भ्रमंडा का बी उछ़टअ।<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />म्हारै परमेशर बिधाता ज़िहअ निं होर कोहै आथी,</para>
  <para style="q" vid="PSA 113:5">सोभी का उछ़टै दी आसा सह ई बेठअ द।<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />पर सह हआ तिधा का उंधै पृथूई भाल़अ लागअ द।<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />सह झ़ैऊआ रैनै-गरीबा</para>
  <para style="q" vid="PSA 113:7">माट्टै अर छ़ारे रूल़ी जैंदरा का उझै,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />ताकि सह तिन्‍नां आपणीं परज़े सैणैं</para>
  <para style="q" vid="PSA 113:8">संघै राज़ करना लै साझ़ू हई सके।<note caller="-" style="x"><char style="xo" closed="false">113:8 </char><char style="xt" closed="false"><ref loc="JOB 36:7">आयू. 36:7</ref></char></note><verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />ज़हा बेटल़ीओ हुअ-ज़ाअ निं आथी, तैहा लै दैआ सह लुआद अर तैहा भेटा खुशी।</para>
  <para style="q" vid="PSA 113:9">बिधाते करा ज़ोरै-ज़ोरै ज़ै-ज़ैकार।<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">बिधाता करा नुआहरै च़मत्कार</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />ज़धू इज़राईली मिसर देशा का निखल़ै अर</para>
  <para style="q" vid="PSA 114:1">याकबे आद-लुआद पराऐ देशे गलामी का छ़ुटी आजू हांढदै लागै,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />यहूदा ज़ैगा हुई बिधाते पबित्र ज़ैगा अर</para>
  <para style="q" vid="PSA 114:2">इज़राईली हुऐ तेऊए परज़ा।<verse eid="PSA 114:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />ज़ांऊं लाल समुंदरै इज़राईली एछदै भाल़ै, सह हुअ झ़ट-पटै ओर्ही-पोर्ही दूई बाखा लै,</para>
  <para style="q" vid="PSA 114:3">जरदण दरैअ बी फिरअ पिछ़ू बाखा लै!<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />उछ़टै-उछ़टै पर्बतै दैनी गाभू ज़ेही छ़ाहल़ा,</para>
  <para style="q" vid="PSA 114:4">उछ़टी-उछ़टी धारा दैनै होछ़ै छ़ेल्हू ज़िहै त्रुपल़ै।<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />ए लाल समुंदर, ताह किज़ै हुअ कि तूह ठुर्हअ ओर्ही-पोर्ही?</para>
  <para style="q" vid="PSA 114:5">जरदण दरैऊआ, तूह किल्है फिरअ पिछ़ू?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />पर्बतो, तम्हैं किल्है दैनी गाभू ज़ेही छ़ाहल़ा?</para>
  <para style="q" vid="PSA 114:6">तम्हैं उछ़टी-उछ़टी धारा किल्है लागी होछ़ै छ़ेल्हू ज़ेही त्रुपल़ै दैंदी?<verse eid="PSA 114:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />हे पृथूई, ज़ेभै याकबो परमेशर प्रगट होए,</para>
  <para style="q" vid="PSA 114:7">ताह छ़ुटणीं तेभै काम्मणीं!<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />किल्हैकि सह काढा बडी काठी टोल्हा का पाणींए गाडा,</para>
  <para style="q" vid="PSA 114:8">अर बडै शाफल़ा दी काढा सह पाणींए गाड।<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">बिधाता आसा ज़ै-ज़ैकार करनै जोगी</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />हे बिधाता, म्हारी निं, ज़ै-ज़ैकार लोल़ी सिधी तेरी हुई,</para>
  <para style="q" vid="PSA 115:1">सारी बड़ैई जोगी आसा सिधअ तूह ई किल्हैकि</para>
  <para style="q" vid="PSA 115:1">किल्हैकि तेरी झ़ूरी अर सत्त आसा अटल़।<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />देशा-देशे लोगा किल्है दैणअ हाम्हां लै इहअ बोल़णैं,</para>
  <para style="q" vid="PSA 115:2">“थारअ परमेशर किधी आसा?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />तूह म्हारअ परमेशर आसा स्वर्गै बेठअ द,</para>
  <para style="q" vid="PSA 115:3">तूह करा ज़िहअ तूह च़ाहा तिहअ।<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />तिन्‍नें<note caller="+" style="f"><char style="fr" closed="false">115:4 </char><char style="fq" closed="false">तिन्‍नें </char><char style="ft" closed="false">तिन्‍नां पराई ज़ातीए/पराऐ देशे</char></note> देअ-देबी आसा सुन्‍नैं-च़ंदीए!</para>
  <para style="q" vid="PSA 115:4">तिंयां आसा मणछै आपणैं हाथै बणाऐं दै!<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />तिन्‍नें खाखा ता हआ पर तिंयां निं गल्‍ला करी सकदै,</para>
  <para style="q" vid="PSA 115:5">तिन्‍नें आछी ता हआ पर शुझदअ निं तिन्‍नां का आथी!<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />तिन्‍नें कान ता हआ पर तिंयां निं शूणीं सकदै,</para>
  <para style="q" vid="PSA 115:6">तिन्‍नें नाक बी आसा बणाऐं दै पर तिंयां निं शिंघी सकदै!<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />तिन्‍नां का हाथ ता आसा, पर तिंयां निं छ़ुंहीं सकदै,</para>
  <para style="q" vid="PSA 115:7">ज़ांघा ता आसा पर तिंयां निं हांढी सकदै,</para>
  <para style="q" vid="PSA 115:7">नां तिन्‍नें घुघल़ै का किज़ै बोल निखल़दअ!<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />ज़ुंणी तिंयां मुहुर्ती बणाईं अर ज़ुंण तिन्‍नां दी भरोस्सअ डाहा,</para>
  <para style="q" vid="PSA 115:8">तिंयां बी हुऐ तिन्‍नां मुहुर्ती ई ज़िहै बृथा अर गुग्गै।<verse eid="PSA 115:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />ओ इज़राईली मणछो, तम्हैं करा बिधाता दी भरोस्सअ,</para>
  <para style="q" vid="PSA 115:9">थारी मज़त अर फाज़त करनै आल़अ आसा सह ई।<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />
    <note caller="+" style="f">
      <char style="fr" closed="false">115:10 </char>
      <char style="ft" closed="false">बिधाते स्तोती करा</char>
    </note>बिधाता दी डाहा भरोस्सअ, ज़ुंण तम्हैं हारणे आद-लुआद बिधाते प्रोहत आसा,</para>
  <para style="q" vid="PSA 115:10">थारी मज़त अर फाज़त करनै आल़अ आसा सह ई।<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />बिधाता दी डाहा भरोस्सअ ज़ुंण तम्हैं बिधाते भगत आसा,</para>
  <para style="q" vid="PSA 115:11">थारी मज़त अर फाज़त करनै आल़अ आसा सह ई।<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />बिधाता निं हाम्हां बिस्सरदअ आथी, तेऊ दैणीं हाम्हां लै बर्गत,</para>
  <para style="q" vid="PSA 115:12">तेऊ दैणीं इज़राईली टोली अर</para>
  <para style="q" vid="PSA 115:12">हारणे आद-लुआदा लै बर्गत।<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />तेऊ दैणीं सोभी लै बर्गत ज़ुंण बी तेऊओ अदर करा,</para>
  <para style="q" vid="PSA 115:13">च़ाऐ सह होछ़अ होए च़ाऐ सह कुंण बडअ मशूर होए।<verse eid="PSA 115:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />मेरी आसा बिधाता का एही अरज़ कि बिधाता लोल़ी तम्हां अर</para>
  <para style="q" vid="PSA 115:14">थारी आद-लुआदा लै खास्सै शोहरू-माठै दैनै।<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />ज़ुंणी बिधाता पृथूई अर सारअ भ्रमंड बणाअं,</para>
  <para style="q" vid="PSA 115:15">तेऊ का लोल़ी तम्हां खास्सी बर्गत भेटी।<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />स्वर्ग आसा बिधाता आप्पू लै डाहअ द,</para>
  <para style="q" vid="PSA 115:16">हाम्हां मणछा लै आसा तेऊ पृथूई दैनी दी।<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />मुल्दै निं बिधाते ज़ै-ज़ैकार करदै,</para>
  <para style="q" vid="PSA 115:17">ज़ुंण मरी गऐ तिन्‍नें भलै निं बिधाते ज़ै-ज़ैकार हंदी।<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />पर ज़ुंण हाम्हैं ज़िऊंदै आसा, हाम्हां करनअ तेऊओ शूकर,</para>
  <para style="q" vid="PSA 115:18">आझ़ बी अर आजू सारी सदा।</para>
  <para style="q" vid="PSA 115:18">बिधाते करा ज़ै-ज़ैकार।<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">बिधातो करा शूकर, तेऊ बच़ाऊऐ तम्हैं मरनै का</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />हे बिधाता, हुंह झ़ूरा ताल्है खास्सअ।</para>
  <para style="q" vid="PSA 116:1">किल्हैकि तूह शूणां मेरी लेर-पकार।<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />ज़ेभै बी हुंह अरज़ करा, तूह हेरा मेरी शूणीं,</para>
  <para style="q" vid="PSA 116:2">मुंह रहणअ सारी ज़िन्दगी ताह सेटा अरज़ करदै लागी।<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />मौतै गोटअ त हुंह फेरा-फेर,</para>
  <para style="q" vid="PSA 116:3">मरने डरै हेरअ त हुंह पठी घेप्पी,</para>
  <para style="q" vid="PSA 116:3">हुंह त डअर अर खरी दी पल़अ द।<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />तेखअ किई मंऐं अरज़,</para>
  <para style="q" vid="PSA 116:4">“हे बिधाता, ज़ीबाण, तूह बच़ाऊ मुंह मरनै का।”<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />हे बिधाता, तूह आसा भलअ अर झणैल़ू,</para>
  <para style="q" vid="PSA 116:5">ए म्हारै परमेशर, तूह करा खास्सी झींण।<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />तूह करा भोल़ै मणछे फाज़त,</para>
  <para style="q" vid="PSA 116:6">ज़ेभै मुंह आफ़त पल़ी ती, तेभै बच़ाऊअ हुंह तंऐं ई।<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />हुंह बोला आपणैं दिलै हैअ डाह,</para>
  <para style="q" vid="PSA 116:7">किल्हैकि बिधाता आसा मुल्है भलअ।<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />हे बिधाता, तंऐं बच़ाऊअ हुंह मरनै का,</para>
  <para style="q" vid="PSA 116:8">तंऐं टुशै मेरी आछी का आशू अर</para>
  <para style="q" vid="PSA 116:8">तंऐं निं मुल्है ठोहल़ दैनी लागणै।<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />मुंह रहणअ आपणीं ज़िऊंदी ज़िता,</para>
  <para style="q" vid="PSA 116:9">ताह बाखा हांढदै लागी।<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />मंऐं डाहअ तेभै बी ताह प्रैंदै विश्वास ज़ेभै मंऐं इहअ बोलअ,</para>
  <para style="q" vid="PSA 116:10">“हुंह हुअ पठी बरैबाद।”<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />ज़ांऊं मुंह खास्सअ हैल़अ बी फिरा, मंऐं बोलअ इहअ,</para>
  <para style="q" vid="PSA 116:11">“सोभै मणछ आसा शल़ैघी।”<verse eid="PSA 116:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />बिधाता मुल्है ज़ेतरी भलाई किई,</para>
  <para style="q" vid="PSA 116:12">तेते बदल़ै हुंह तेऊ लै किज़ै सका दैई?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />मुंह दैणअ ताह बिधाता लै दाखे रसो अर्घअ,</para>
  <para style="q" vid="PSA 116:13">मुंह करनअ तेरअ शूकर कि तंऐं बच़ाऊअ हुंह।<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />ज़ेभै तेरै लोगो झाल़अ होए,</para>
  <para style="q" vid="PSA 116:14">तेभै करनी मुंह सोभी नदरी तेरी मानत पूरी।<verse eid="PSA 116:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />ज़ै तेरअ एक बी भगत मरे,</para>
  <para style="q" vid="PSA 116:15">ताह हआ तेऊओ खास्सअ दुख।<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />हे बिधाता, हुंह आसा तेरअ दास,</para>
  <para style="q" vid="PSA 116:16">ज़ेही मेरी ईज तेरी च़ाकरी करा ती, हुंह करा तेही,</para>
  <para style="q" vid="PSA 116:16">तंऐं बच़ाऊअ हुंह मरनै का।<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />मुंह करनअ तेरअ शूकर करना लै बल़ीदान,</para>
  <para style="q" vid="PSA 116:17">मुंह करनी ताह सेटा प्राथणां।<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18-19" style="v" sid="PSA 116:18-19" />ज़ेभै तेरी पबित्र ज़ैगा एरुशलेम तेरी परज़ा झाल़अ करे,</para>
  <para style="q" vid="PSA 116:18-19">तेभै करनी मुंह सोभी नदरी तेरी मानत पूरी</para>
  <para style="q" vid="PSA 116:18-19">ज़ुंण मंऐं ताल्है मनी ती।</para>
  <para style="q" vid="PSA 116:18-19">बिधाते करा ज़ै-ज़ैकार।<verse eid="PSA 116:18-19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">बिधाते ज़ै-ज़ैकार</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />देशा-देशे लोगो, बिधाते करा ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 117:1">पृथूई दी सोभै मणछ करा तेऊए बड़ैई!<note caller="+" style="f"><char style="fr" closed="false">117:1 </char><char style="ft" closed="false">रोमी 15:11</char></note><verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />सह झ़ूरा हाम्हां लै पाक्‍कअ,</para>
  <para style="q" vid="PSA 117:2">तेऊओ विश्वास आसा हाम्हां लै अटल़।</para>
  <para style="q" vid="PSA 117:2">सोभै करा बिधाते ज़ै-ज़ैकार।<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">बिधाता आसा सदा झणैल़ू</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />बिधातो शूकर करा,</para>
  <para style="q" vid="PSA 118:1">किल्हैकि सह आसा भलअ अर सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />सोभै इज़राईली बोला इहअ,</para>
  <para style="q" vid="PSA 118:2">“बिधाते झ़ूरी आसा अटल़।”<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />हारणो खिंब बिधाते सोभै प्रोहत बोला इहअ,</para>
  <para style="q" vid="PSA 118:3">“बिधाते झ़ूरी आसा अटल़।”<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />सोभै ज़ुंण बिधाते च़ाकरी करा तिंयां बोला,</para>
  <para style="q" vid="PSA 118:4">“बिधाते झ़ूरी आसा अटल़।”<verse eid="PSA 118:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />मंऐं पाई खरीए पलका बिधाता सेटा पकार,</para>
  <para style="q" vid="PSA 118:5">तेऊ शूणीं मेरी अरज़ संघा किअ हुंह आज़ाद।<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />बिधाता आसा मुंह बाखा आप्पै, तैही निं हुंह डरदअ आथी।</para>
  <para style="q" vid="PSA 118:6">संसारे मणछ निं मेरअ किछ़ै बगाल़ी सकदै।<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />सह आसा बिधाता ज़ुंण मेरी मज़त करा,</para>
  <para style="q" vid="PSA 118:7">मुखा शुझणैं आपणीं आछी कि मेरै दुशमण हारै।<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />मणछे आसरै रहणैं का आसा</para>
  <para style="q" vid="PSA 118:8">बिधाता सेटा शरण लणी भली।<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />बलबान प्रधाने आसरै रहणैं का आसा</para>
  <para style="q" vid="PSA 118:9">बिधाता सेटा शरण लणी भली।<verse eid="PSA 118:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />हुंह गोटअ देशा-देशे दुशमणै फेरा-फेर,</para>
  <para style="q" vid="PSA 118:10">पर बिधाता दैनअ मुल्है इहअ बल कि तिंयां किऐ मंऐं सोभै खतम।<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />तिन्‍नैं गोटअ त हुंह च़ऊ बाखा,</para>
  <para style="q" vid="PSA 118:11">पर बिधाता दैनअ मुल्है इहअ बल कि तिंयां किऐ मंऐं सोभै खतम।<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />तिंयां शाचै तै मुल्है फेरा फेर माहूँ ज़िहै,</para>
  <para style="q" vid="PSA 118:12">पर तिंयां हिठै कांडै दी चैल़ी दी आगी ज़िहै छ़ेक्‍कै,</para>
  <para style="q" vid="PSA 118:12">बिधाता दैनअ मुल्है इहअ बल कि तिंयां किऐ मंऐं सोभै खतम।<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />तिंयां आऐ तै मुंह मारदै इहै ठुर्ही कि हुंह पाणअ धरनीं लाम्मअ,</para>
  <para style="q" vid="PSA 118:13">पर बिधाता किई मेरी मज़त।<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />बिधाता दैआ आप्पै मुल्है ज़ोर अर बल,</para>
  <para style="q" vid="PSA 118:14">तेऊ बच़ाऊअ हुंह आप्पै।<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />बिधाते धर्मीं मणछे डेरै हणीं ज़िती करै ज़ोरै-ज़ोरै ज़ै-ज़ैकार करी इहअ बोल्दै लागै दै,</para>
  <para style="q" vid="PSA 118:15">“अह हुअ बिधाते महान बला करै।<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />बिधाते महान बला करै ज़ितै हाम्हैं,</para>
  <para style="q" vid="PSA 118:16">जुधा लै थिअ तेऊओ ई महान बल!”<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />हुंह निं मरदअ आथी, मुंह रहणअ ज़िऊंदै अर</para>
  <para style="q" vid="PSA 118:17">मुंह खोज़णअ सोभी का कि बिधाता किहै-किहै महान काम किऐ।<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />बिधाता नैरअ हुंह बतेर्हअ पर</para>
  <para style="q" vid="PSA 118:18">तेऊ निं मेरी मौत दैनी हणैं।<verse eid="PSA 118:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />ओर्ही खोल्हा मुल्है भबने प्रऊल़,</para>
  <para style="q" vid="PSA 118:19">मुंह करनअ भितरी डेऊई बिधातो शूकर।<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />बिधाते प्रऊल़ आसा अह ई,</para>
  <para style="q" vid="PSA 118:20">एथ भितरी डेओआ सिधै धर्मीं मणछ।<verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />हे बिधाता, मुंह करनी तेरी ज़ै-ज़ैकार, किल्हैकि तंऐं शूणीं मेरी अरज़,</para>
  <para style="q" vid="PSA 118:21">तंऐं ई दैनी मुल्है ज़ीत।<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />ज़ुंण पात्थर मिस्त्री बृथा समझ़अ त,</para>
  <para style="q" vid="PSA 118:22">तंऐं बणाअं सह ई पात्थर सोभी का खास।<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />अह किअ तंऐं बिधाता,</para>
  <para style="q" vid="PSA 118:23">हाम्हां लै हुई अह बेघै नुआहरी गल्‍ल।<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />ऐहा धैल़ी आसा बिधाते ज़ीत हुई दी,</para>
  <para style="q" vid="PSA 118:24">अह धैल़ी मनाऊंणी हाम्हां खुशी।<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />हे बिधाता, हाम्हां बच़ाऊ, बच़ाऊ हाम्हां!</para>
  <para style="q" vid="PSA 118:25">ज़ीबाण, हाम्हां कर तूह सफल।<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />बिधाता लोल़ी ती तेऊ लै बर्गत दैनी ज़ुंण तेऊए नाओंऐं एछा!</para>
  <para style="q" vid="PSA 118:26">हाम्हैं दैआ ताल्है बिधाते पबित्र ज़ैगा का बर्गत।<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />म्हारअ परमेशर आसा बिधाता,</para>
  <para style="q" vid="PSA 118:27">तेऊ दैनअ हाम्हां लै प्रैश्शअ!</para>
  <para style="q" vid="PSA 118:27">खज़ूरे डाल़ी हाथै च़की करा थैर मनाऊंणअ शुरू, संघा दैआ बेदी फेर फेरी।<verse eid="PSA 118:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />हे बिधाता, तूह आसा मेरअ परमेशर, मुंह करनअ तेरअ शूकर।</para>
  <para style="q" vid="PSA 118:28">मुंह करनी तेरी बड़ैई सारै दी।<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />बिधातो शूकर करा,</para>
  <para style="q" vid="PSA 118:29">किल्हैकि सह आसा भलअ अर सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">बिधातो बधान</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />बिधाता दैआ तिन्‍नां लै बर्गत ज़हा दी किछ़ै खोट निं हंदी अर</para>
  <para style="q" vid="PSA 119:1">ज़ुंण बिधाते बधाने साबै ज़िन्दगी ज़िऊआ।<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />सह दैआ तिन्‍नां लै बर्गत ज़ुंण तेऊए हुकम मना,</para>
  <para style="q" vid="PSA 119:2">अर दिला का तेऊ नेल़ रहा।<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />तिंयां निं किछ़ै गलती करदै अर</para>
  <para style="q" vid="PSA 119:3">तिंयां रहा तेस्सी हांढदै लागी ज़ुंण बात बिधाता खोज़ा।<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />हे बिधाता, तंऐं दैनअ हाम्हां लै आपणअ बधान अर</para>
  <para style="q" vid="PSA 119:4">तेरअ आसा इहअ हुकम कि हाम्हैं लोल़ी सह सदा मनअ।<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />तै भाल़ किहअ हणअ त ज़ै हुंह तेरै बधाने</para>
  <para style="q" vid="PSA 119:5">सोभी गल्‍ला मनणा लै शुचअ-पाक्‍कअ हंदअ!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />ज़ै हुंह तेरै बधाने सोभी गल्‍ला दी धैन दैंऊं,</para>
  <para style="q" vid="PSA 119:6">तै निं मुंह शर्मिंदै पल़णअ हणअ।<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />तेरअ धर्मीं बधान शिखल़ी करै करनअ मुंह</para>
  <para style="q" vid="PSA 119:7">शुचै दिलै तेरअ शूकर अर तेरी ज़ै-ज़ैकार।<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />मुंह ज़िऊंणीं तेरै बधाने साबै ज़िन्दगी,</para>
  <para style="q" vid="PSA 119:8">मुंह निं तूह शोटी डाही!<verse eid="PSA 119:8" /></para>
  <para style="s">बधाने साबै ज़िन्दगी ज़िऊंणीं</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />खारकै मणछ सका बिधाते हुकम मनी</para>
  <para style="q" vid="PSA 119:9">शुची ज़िन्दगी ज़िऊई।<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />हे बिधाता, हुंह रहा तत्त-दिला का तेरी च़ाकरी लागी,</para>
  <para style="q" vid="PSA 119:10">तूह निं मुंह आपणैं बधाने बिधी का कबाता दैई पेशणैं।<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />मंऐं आसा तेरअ बधान आपणैं दिलै डाहअ द,</para>
  <para style="q" vid="PSA 119:11">ताकि हुंह ताखा किछ़ पाप करदअ निं शुझिए।<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />हे बिधाता, हुंह करा तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 119:12">तूह खोज़ मुखा आपणीं बिधी आप्पै।<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />ज़ुंण बधान तंऐं खोज़अ,</para>
  <para style="q" vid="PSA 119:13">सह खोज़णअ मुंह आपणीं खाखा का सोभी का।<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />तेरअ हुकम मनी भेटा</para>
  <para style="q" vid="PSA 119:14">बडै सेठ हणैं का बी खास्सी खुशी।<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />मुंह दैणअ तेरै बधाना दी धैन अर</para>
  <para style="q" vid="PSA 119:15">तेरी शिक्षा दी रहणअ मुंह बच़ार करदै लागी।<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />मुंह हणअ तेरै बधाना दी सुखी,</para>
  <para style="q" vid="PSA 119:16">मुंह डाहणीं तेरी सोभै गल्‍ला आद।<verse eid="PSA 119:16" /></para>
  <para style="s">बिधाते बधाना दी खुशी</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />हे बिधाता, हुंह आसा तेरअ दास, तूह रहै मुल्है भलअ,</para>
  <para style="q" vid="PSA 119:17">ताकि हुंह ज़िऊंदअ रहे अर ज़िहअ तूह बोला हुंह तिहअ ई करूं।<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />तूह खोल्ह मेरी आछी ताकि हुंह तेरै</para>
  <para style="q" vid="PSA 119:18">बधाने महान सत्त भाल़ी सकूं।<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />हुंह आसा इधी पृथूई दी परदेसी अर थोल़ै धैल़ै लै,</para>
  <para style="q" vid="PSA 119:19">तूह निं आपणैं-आपणैं हुकम मुखा च़ोरी डाही।<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />हुंह च़ाहा कबल्‍लअ तेरी बिधी शिखल़णअ अर</para>
  <para style="q" vid="PSA 119:20">तेरै बधानो सदा अदर करनअ।<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />तिन्‍नां लागअ फिटक, तंऐं दैनी तिन्‍नां लै सज़ा ज़ुंण शरेरै फिरा तै अर</para>
  <para style="q" vid="PSA 119:21">ज़ुंण तेरै बधाना का कबाता थिऐ पेठै दै।<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />हे बिधाता, तिन्‍नां निं मेरअ सुहांग अर बेइज़ती दैई करनै,</para>
  <para style="q" vid="PSA 119:22">किल्हैकि हुंह ज़िऊआ तेरै बधाने साबै ज़िन्दगी।<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />राज़ करनै आल़ै हुऐ मेरै खलाफ आप्पू मांझ़ै कठा,</para>
  <para style="q" vid="PSA 119:23">पर मुंह रहणअ तेरै बधाने ई बारै बच़ार करदै लागी।<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />तेरै बधाना करै भेटा मुंह खास्सी खुशी!</para>
  <para style="q" vid="PSA 119:24">तेरअ बधान आसा मुल्है सलाहकारा ज़िहअ।<verse eid="PSA 119:24" /></para>
  <para style="s">बधाने मनणे सोह खाणैं</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />हुंह आसा धरनीं मरदअ पल़अ द,</para>
  <para style="q" vid="PSA 119:25">तूह कर मुंह उझै खल़ै ज़िऊंदै, ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />मंऐं ताखा आपणअ च़ाल-च़लण पठी, तंऐं हेरी मेरी अरज़ शूणीं,</para>
  <para style="q" vid="PSA 119:26">ऐबै खोज़ तूह मुखा आपणीं बिधी।<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />तूह कर मेरी मज़त कि मुंह तेरअ बधान समझ़ एछे,</para>
  <para style="q" vid="PSA 119:27">तै रहणअ हुंह तेरै महान कामें बारै सोठदअ लागी।<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />हुंह डुबअ बाख खरी दी,</para>
  <para style="q" vid="PSA 119:28">तूह दै मुल्है ऐबै बल, ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />तूह डाह मुंह उंबल़ी बाता का दूर,</para>
  <para style="q" vid="PSA 119:29">तूह शखैल़ मुखा झणैल़ू हई आपणअ बधान।<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />मंऐं ढाकी आप्पू सह बात ज़ेथ सत्त आसा,</para>
  <para style="q" vid="PSA 119:30">हुंह डाहा कबल्‍लअ तेरै बधाना दी धैन।<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />हे बिधाता, हुंह करा तिहअ ई ज़िहअ तेरअ बधान खोज़ा,</para>
  <para style="q" vid="PSA 119:31">तूह निं मुंह शर्मिंदै दैई हणैं।<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />ज़िहअ तूह बोला, हुंह च़ाहा तिहअ ई करनअ,</para>
  <para style="q" vid="PSA 119:32">तूह कर मेरी मज़त कि मुंह लोल़ी होर बी खास्सी समझ़ आई।<verse eid="PSA 119:32" /></para>
  <para style="s">समझ़ एछणा लै बिधाता का अरज़</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />हे बिधाता, तूह खोज़ मुखा तेरै बधाने भेद,</para>
  <para style="q" vid="PSA 119:33">मुंह ज़िऊंणीं सारी ज़िन्दगी तेते ई साबै। <note caller="+" style="f"><char style="fr" closed="false">119:33 </char><char style="ft" closed="false">सह हणअ मुल्है फल</char></note><verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />तेरै बधाना समझ़णा लै कर मेरी मज़त, मुंह करनअ तिहअ ई,</para>
  <para style="q" vid="PSA 119:34">मुंह ज़िऊंणीं दिला का तेते साबै आपणीं ज़िन्दगी।<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />तूह कर मेरी मज़त कि हुंह तेरै हुकम मनूं,</para>
  <para style="q" vid="PSA 119:35">किल्हैकि मेरी खुशी आसा तेतै।<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />तूह कर इहअ कि मेरै दिलै लोल़ी सेठ हणैं का खास्सअ,</para>
  <para style="q" vid="PSA 119:36">तेरै बधाना बाखा लोभ हुअ।<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />बृथा गल्‍ला<note caller="+" style="f"><char style="fr" closed="false">119:37 </char><char style="fq" closed="false">बृथा गल्‍ला </char><char style="ft" closed="false">मुहुर्ती/मैहरै</char></note> दी धैन दैणैं का डाह मुंह दूर,</para>
  <para style="q" vid="PSA 119:37">मुंह लोल़ी ताह संघै हांढदी ज़िन्दगी भेटी।<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />हे बिधाता, ज़ेते तंऐं आपणैं डरा हेठै रहणैं आल़ै लै ज़बान आसा दैनी दी,</para>
  <para style="q" vid="PSA 119:38">सह ज़बान लोल़ी तेरी मुल्है बी हुई।<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />तूह बच़ाऊ मुंह तैहा बेइज़ती हणैं का ज़ेते ज़ेता का हुंह डरा,</para>
  <para style="q" vid="PSA 119:39">किल्हैकि तेरअ नसाफ आसा महान।<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />हुंह च़ाहा तेरै बधाने साबै आपणीं ज़िन्दगी ज़िऊंणीं,</para>
  <para style="q" vid="PSA 119:40">मुल्है दै नऊंईं ज़िन्दगी किल्हैकि तूह आसा धर्मीं।<verse eid="PSA 119:40" /></para>
  <para style="s">बिधाते बधाना दी भरोस्सअ</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />हे बिधाता, तूह कर ऐहा गल्‍ला प्रगट कि तूह मुल्है केतरअ झ़ूरा,</para>
  <para style="q" vid="PSA 119:41">तूह बच़ाऊ मुंह ज़िहअ तंऐं आप्पै आसा बोलअ द।<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />तै सका हुंह तिन्‍नां लै ज़बाब दैई ज़ुंण</para>
  <para style="q" vid="PSA 119:42">तेरै बैण मनणै पिछ़ू मेरी बेइज़ती करा।<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />तूह कर मेरी मज़त कि मंऐं लोल़ी सदा सत्त खोज़अ,</para>
  <para style="q" vid="PSA 119:43">किल्हैकि हुंह रहा तेरै बधाने आसरै।<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />मुंह रहणअ सदा तिहअ ई ज़िहअ तेरअ बधान खोज़ा अर</para>
  <para style="q" vid="PSA 119:44">सदा तेरै बधाने साबै ज़िन्दगी ज़िऊंदै लागी।<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />मुंह रहणअ सदा आज़ाद हांढदै लागी,</para>
  <para style="q" vid="PSA 119:45">किल्हैकि हुंह डाहा तेरी गल्‍ला आद।<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />हुंह निं राज़ै सेटा बी तेरै हुकम खोज़णैं का पिछ़ू हटदअ</para>
  <para style="q" vid="PSA 119:46">अर नां तेते शरम च़ेतदअ।<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />मेरी हआ सह ई खुशी कि हुंह तेरै हुकम मनूं,</para>
  <para style="q" vid="PSA 119:47">किल्हैकि हुंह झ़ूरा तेता ई लै खास्सअ।<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />मेरै दिलै आसा तेरै हुकमा लै अदर अर हुंह झ़ूरा बी तेता लै,</para>
  <para style="q" vid="PSA 119:48">मुंह रहणअ कबल्‍लै तेते ई बारै सोठदै लागी।<verse eid="PSA 119:48" /></para>
  <para style="s">बिधाते बधाने आसरै रहणअ</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />हे बिधाता, ज़ुंण तंऐं मुल्है ज़बान आसा दैनी दी, तैहा डाहै आद,</para>
  <para style="q" vid="PSA 119:49">मुंह आसा तेतो ई आसरअ।<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />तेता ई करै भेटा मुंह खरीए पलका हैअ,</para>
  <para style="q" vid="PSA 119:50">किल्हैकि तेरअ बैण दैआ मुल्है ज़िन्दगी।<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />शरेरै मणछ करा मेरअ सुहांग,</para>
  <para style="q" vid="PSA 119:51">पर हुंह निं तेरै बधाने साबै ज़िन्दगी ज़िऊंणै का पिछ़ू हटअ।<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />हे बिधाता, मुंह एछा खास्सी साला पैहलै किअ द तेरअ नसाफ आद,</para>
  <para style="q" vid="PSA 119:52">तेता करै फिरा मुंह मेरै दिलै हैअ।<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />ज़ांऊं मुखा इहअ शुझिआ कि कदुष्ट मणछ डेओआ तेरै बधाना का उंबल़ी बाखा,</para>
  <para style="q" vid="PSA 119:53">तेता भाल़ी एछा मुंह खास्सी रोश्शै।<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />एऊ संसारै मेरी ऐहा होछ़ी ज़ेही ज़िन्दगी दी</para>
  <para style="q" vid="PSA 119:54">गांठा हुंह तेरै बधाने बिधीए गिहा।<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />हे बिधाता, मुंह एछा राची बी तेरी आद,</para>
  <para style="q" vid="PSA 119:55">संघा रहा हुंह तेरै बधाने बारै सोठदअ लागी।<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />मुंह हआ तेरै हुकम मनणे बेघै खुशी अर</para>
  <para style="q" vid="PSA 119:56">तेरै बधाने बारै रहा हुंह बच़ार करदअ लागी।<verse eid="PSA 119:56" /></para>
  <para style="s">बधाना दी धैन डाहणअ</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />हे बिधाता, मेरी सोभै गल्‍ला आसा तूह ज़ेता हुंह च़ाहा,</para>
  <para style="q" vid="PSA 119:57">मंऐं आसा तेरै बधाने साबै ज़िन्दगी ज़िऊंणें सोह खाऐ दै।<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />हुंह करा दिला का ताह सेटा अरज़ कि तूह कर मुल्है झींण,</para>
  <para style="q" vid="PSA 119:58">ज़ेही तंऐं आप्पै ज़बान आसा दैनी दी।<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />हुंह डाहा आपणैं बारै खास्सअ धैन अर</para>
  <para style="q" vid="PSA 119:59">हुंह च़ाहा तिहअ ई करनअ ज़िहअ तूह बोला।<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />ज़िहअ तूह हुकम करा, हुंह करा तेभी तिहअ ई,</para>
  <para style="q" vid="PSA 119:60">तेथ निं हुंह धख बी बल़ैग पांदअ।<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />कदुष्ट मणछै आसा मुल्है फाही पाई दी,</para>
  <para style="q" vid="PSA 119:61">पर हुंह निं तेरअ बधान बिस्सरदअ।<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />तेरै धर्मीं बधाने ज़ै-ज़ैकार करना लै उझ़िआ</para>
  <para style="q" vid="PSA 119:62">हुंह आधा राची बी खल़अ।<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />हुंह डाहा तिन्‍नां संघै साथ संगत ज़ुंण तेरी डरा हेठै रहा</para>
  <para style="q" vid="PSA 119:63">अर तेरअ बधान मना।<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />हे बिधाता, तूह करा सारी पृथूई लै खास्सी झींण,</para>
  <para style="q" vid="PSA 119:64">तूह शखैल़ मुखा आपणैं बधाने सोभै बिधी।<verse eid="PSA 119:64" /></para>
  <para style="s">बधान किल्है आसा खास</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />हे बिधाता, हुंह आसा तेरअ दास, तूह आसा मुल्है भलअ</para>
  <para style="q" vid="PSA 119:65">ज़िहअ तूह बोला तिहअ ई।<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />तूह दै मुल्है अक्ल अर सुंबल़ी सोर,</para>
  <para style="q" vid="PSA 119:66">किल्हैकि हुंह करा तेरै हुकमो भरोस्सअ।<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />ज़ेभै तैणीं तंऐं हुंह नैरअ निं तेभै तैणीं रहअ हुंह गलती करदअ लागी,</para>
  <para style="q" vid="PSA 119:67">पर ऐबै मना हुंह तेरै हर बैण।<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />हे बिधाता, तूह भाल़ किहअ भलअ अर झणैल़ू आसा!</para>
  <para style="q" vid="PSA 119:68">तूह शखैल़ मुखा आपणैं बधाने सोभै बिधी।<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />शरेरै मणछै आसा मेरै बारै झ़ुठी फुआह फणाऊंई दी,</para>
  <para style="q" vid="PSA 119:69">पर हुंह मना दिला का तेरी सोभै गल्‍ला।<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />तिन्‍नां शल़ैघी मणछा निं सोर-समझ़ ई आथी,</para>
  <para style="q" vid="PSA 119:70">पर हुंह रहा तेरै बधाना दी खुश।<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />ज़ुंण तंऐं मुल्है सज़ा दैनी, सह हुअ मुल्है भलअ,</para>
  <para style="q" vid="PSA 119:71">किल्हैकि तेता करै लागअ हुंह तेरै बधाना राम्बल़ै करै आद करदअ।<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />ज़ुंण बधान तंऐं मुल्है दैनअ, सह आसा मुल्है</para>
  <para style="q" vid="PSA 119:72">सारै हज़ारो-लाखों सुन्‍नैं-च़ंदीए सिक्‍कै का बी खास्सअ किम्मती।<verse eid="PSA 119:72" /></para>
  <para style="s">बधानो नसाफ</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />हे बिधाता, हुंह आसा तंऐं आपणैं हाथै बणाअं द अर तंऐं ई आसा हुंह बच़ाऊई डाहअ द,</para>
  <para style="q" vid="PSA 119:73">तूह दै मुल्है एही समझ़ कि हुंह तेरअ बधान शिखल़ी सकूं।<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />तै हणैं तिंयां खुश ज़ुंण तेरअ अदर करा,</para>
  <para style="q" vid="PSA 119:74">किल्हैकि हुंह करा तेरै बैणा दी भरोस्सअ।<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />मुखा आसा थोघ कि तेरअ नसाफ हआ धर्मीं,</para>
  <para style="q" vid="PSA 119:75">तंऐं दैनी मुल्है तैही सज़ा किल्हैकि तूह आसा शुचअ।<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />हे बिधाता, हुंह करा तेरी च़ाकरी, मुंह लोल़ी तेरी अटल़ झ़ूरी करै शांती भेटी,</para>
  <para style="q" vid="PSA 119:76">ज़ेही तंऐं मुल्है ज़बान आसा दैनी दी।<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />तेरी झींण लोल़ी मुल्है सदा हुई, तै रहणअ हुंह ज़िऊंदअ</para>
  <para style="q" vid="PSA 119:77">किल्हैकि हुंह रहा तेरै बधाना दी खुश।<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />घमंडी मणछ लोल़ी शर्मिंदै हुऐ ज़ुंण मुंह शल़ैघा घल़ी बदनाम करा,</para>
  <para style="q" vid="PSA 119:78">पर मुंह डाहणअ तेरै बधान अर बिधी दी धैन-मन्‍न लाई।<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />ज़ुंण तेरी डरा हेठै रहा, अर ज़ुंण तेरअ बधान ज़ाणा,</para>
  <para style="q" vid="PSA 119:79">तिंयां लोल़ी मुंह सेटा लै आऐ।<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />हुंह लोल़ी तेरै बधाना मनणा लै पाक्‍कअ हुअ,</para>
  <para style="q" vid="PSA 119:80">अर मुंह निं लोल़ी शर्मिंदै पल़अ हणअ।<verse eid="PSA 119:80" /></para>
  <para style="s">छ़ुटकारै लै अरज़</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />हे बिधाता, हुंह च़ाल्‍लअ शुक्‍की-मुक्‍की, न्हैल़अ लागअ द कि ताह बच़ाऊंणअ हुंह,</para>
  <para style="q" vid="PSA 119:81">हुंह आसा सिधअ तेरै बैणे आसरै रहअ द।<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />मेरी आछी फिरी न्हैल़ी-भाल़ी-भाल़ी पाल्‍ली कि ज़ुंण तंऐं बोलअ, तिंयां गल्‍ला केभै हणीं पूरी!</para>
  <para style="q" vid="PSA 119:82">हुंह बोला ऐबै इहअ, “ताह मेरी मज़त केभै करनी?”<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />हुंह हुअ शुक्‍कै खाल्हल़ै ज़िहअ बृथा,</para>
  <para style="q" vid="PSA 119:83">पर तज़ी बी निं मंऐं तेरै बधाने बिधी बिस्सरी आथी।<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />हे बिधाता, हुंह करा तेरी च़ाकरी, मुंह केभै तैणीं रहणीं अह खरी पल़ी?</para>
  <para style="q" vid="PSA 119:84">ज़ुंणी हुंह हंती-हंती मारी आणअ, तिन्‍नां लै कधू दैणीं ताह सज़ा?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />ज़ुंण शरेरै तेरै बधाने साबै ज़िन्दगी नांईं ज़िऊंदै,</para>
  <para style="q" vid="PSA 119:85">तिन्‍नैं आसा मुल्है डुघी खात्ती डाही दी खण्हीं।<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />तेरै आसा सोभै हुकम शुचै,</para>
  <para style="q" vid="PSA 119:86">तिन्‍नैं शल़ैघी आणअ हुंह हंती-हंती मारी, तूह कर मेरी मज़त।<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />ऐबै च़ाल्‍लै तिंयां मुंह मारना लै सफल हई,</para>
  <para style="q" vid="PSA 119:87">पर मंऐं निं तेरै बधाने बिधी बिस्सरी आथी।<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />तूह कर मुल्है आपणीं अटल़ झ़ूरी प्रगट, संघा डाह मुंह ज़िऊंदै,</para>
  <para style="q" vid="PSA 119:88">ताकि हुंह तेरै बधाने साबै ज़िन्दगी ज़िऊई सकूं।<verse eid="PSA 119:88" /></para>
  <para style="s">बधाना दी विश्वास</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />हे बिधाता, तेरअ बैण आसा अटल़,</para>
  <para style="q" vid="PSA 119:89">अर सह रहा भ्रमंडै सदा।<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />तेरअ सत्त रहअ पोस्ती दर पोस्ती,</para>
  <para style="q" vid="PSA 119:90">तंऐं आसा पृथूई टकैल़ी डाही दी अर सह आसा आझ़ तैणीं तेही ई टेक्‍की दी।<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />ज़िहअ तंऐं बैण बोलअ, सोभै गल्‍ला आसा आझ़ बी तेही ई,</para>
  <para style="q" vid="PSA 119:91">किल्हैकि तिंयां सोभै गल्‍ला करा तेरी ई च़ाकरी।<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />ज़ै मेरी खुशीओ मूल़ तेरअ बधान निं हंदअ,</para>
  <para style="q" vid="PSA 119:92">तै जाणअ त हुंह खरीए पलका कधू मरी!<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />हुंह निं तेरी गल्‍ला कधि बिस्सरदअ,</para>
  <para style="q" vid="PSA 119:93">किल्हैकि तिंयां गल्‍ला डाहा मुंह ज़िऊंदै।<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />हे बिधाता, हुंह आसा तेरअ, तूह बच़ाऊ मुंह!</para>
  <para style="q" vid="PSA 119:94">हुंह रहअ तेरै बधाने सोभी गल्‍ला मंदअ लागी।<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />कदुष्ट मणछ आसा मुंह मारना लै ताखुऐ दै,</para>
  <para style="q" vid="PSA 119:95">पर मुंह डाहणअ तेरै बधाना दी आपणअ धैन-मन्‍न लाई।<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />मंऐं शिखल़ी अह गल्‍ला कि पठी पूरी निं सोभै गल्‍ला हंदी,</para>
  <para style="q" vid="PSA 119:96">पर तेरै हुकम आसा शुचै अर पठी पूरै।<verse eid="PSA 119:96" /></para>
  <para style="s">बधाना लै झ़ूरनअ</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />हुंह झ़ूरा तेरै बधाना लै खास्सअ!</para>
  <para style="q" vid="PSA 119:97">हुंह रहा सारी धैल़ी तेते ई बारै सोठदअ लागी।<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />हर बगत रहा मेरै दिलै तेरै हुकम अर</para>
  <para style="q" vid="PSA 119:98">तेता करै हआ हुंह आपणैं दुशमणा का खास्सअ अक्ली आल़अ।<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />मुंह आसा आपणैं सोभी गूरू का बी खास्सी समझ़,</para>
  <para style="q" vid="PSA 119:99">किल्हैकि हुंह डाहा तेरी गल्‍ला दी आपणअ धैन-मन्‍न लाई।<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />मुंह आसा प्रोढै मणछा का बी खास्सी अक्ल,</para>
  <para style="q" vid="PSA 119:100">किल्हैकि हुंह मना तेरै हुकम।<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />हुंह रहा कदुष्ट कामां करनै का दूर,</para>
  <para style="q" vid="PSA 119:101">किल्हैकि हुंह च़ाहा ज़िहअ तूह बोला तेही ज़िन्दगी ज़िऊंणअ।<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />हे बिधाता, मेरअ गूरू आसा तूह,</para>
  <para style="q" vid="PSA 119:102">हुंह निं तेरै बैणा का ओर्ही नां पोर्ही डेऊंदअ।<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />तेरै बैण लागा मुंह मिठै,</para>
  <para style="q" vid="PSA 119:103">तिंयां आसा मखीरा का बी खास्सै मिठै।<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />मुंह भेटा तेरै बधाना का अक्ल,</para>
  <para style="q" vid="PSA 119:104">तैही करा हुंह कदुष्ट कामां का नफरत।<verse eid="PSA 119:104" /></para>
  <para style="s">बधानो प्रैश्शअ</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />तेरअ बैण आसा मुल्है सलाह दैणैं आल़अ दीअ अर</para>
  <para style="q" vid="PSA 119:105">बाता आजू हांढणा लै प्रैश्शै ज़िहअ।<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />तेरअ बधान आसा शुचअ,</para>
  <para style="q" vid="PSA 119:106">मूंऐं आसा तेते साबै ज़िन्दगी ज़िऊंणें सोह खाऐ दै।<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />हे बिधाता, मुंह आसा बेघै आफ़त पल़ी दी,</para>
  <para style="q" vid="PSA 119:107">तूह डाह मुंह ज़िऊंदै, ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />हे बिधाता, मेरी गल्‍ला मन्‍न शूकर करने बल़ीदाने मानता ज़ेही,</para>
  <para style="q" vid="PSA 119:108">संघा दै तूह मुल्है आपणैं बधाने शिक्षा।<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />मुल्है हआ कबल्‍लअ मरनैओ खातरअ,</para>
  <para style="q" vid="PSA 119:109">पर तज़ी बी निं हुंह तेरै बधाना बिस्सरदअ।<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />कदुष्ट मणछै आसा मुल्है ज़ज़ाल़ डाहै दै छ़ैई,</para>
  <para style="q" vid="PSA 119:110">पर हुंह निं तेरी शिक्षा का कबाता पेठअ आथी।<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />हुंह मना इहअ कि तेरै हुकम आसा मुल्है एही ज़ैदात ज़ुंण सदा रहणीं,</para>
  <para style="q" vid="PSA 119:111">तेते खुशी करै रहा मेरअ दिल भरी।<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />मंऐं आसा डाही दी एही पाक्‍की सोठ कि ज़ेभै तैणीं हुंह ज़िऊंदअ आसा</para>
  <para style="q" vid="PSA 119:112">तेभै तैणीं ज़िऊंणीं मुंह तेरै बधाने साबै ज़िन्दगी।<verse eid="PSA 119:112" /></para>
  <para style="s">बधाना दी फाज़त</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />दोगल़ै मणछा का आसा मुंह नफरत।</para>
  <para style="q" vid="PSA 119:113">पर आप्पू झ़ूरा हुंह तेरै बधाना लै।<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />मेरी शरण लणें ज़ैगा अर मुंह बच़ाऊंणै आल़अ आसा तूह ई।</para>
  <para style="q" vid="PSA 119:114">मेरअ आसरअ आसा सिधअ तेरअ बैण ई।<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />ओ पापी मणछो, मुंह सेटा का डेओआ दूर।</para>
  <para style="q" vid="PSA 119:115">ज़िहअ बिधाता हुकम किअ, मुंह दैआ तेऊ साबै ज़िन्दगी ज़िऊंणै।<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />हे बिधाता, ज़ेही तंऐं ज़बान आसा दैनी दी, तेऊ साबै दै मुल्है ज़ोर-ज़ाहण कि हुंह ज़िऊंदअ रहे,</para>
  <para style="q" vid="PSA 119:116">तूह निं मेरअ हैअ चुटणै दैई।<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />तूह डाह मुंह ढाकी, तै रहणअ हुंह बच़ी,</para>
  <para style="q" vid="PSA 119:117">तै रहणअ कबल्‍लअ मेरअ धैन तेरै बधाने बिधी दी।<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />ज़ुंण तेरै बधाना बृथा समझ़ा, तिन्‍नां निं तूह मंदअ,</para>
  <para style="q" vid="PSA 119:118">तिन्‍नें धोखै दैणें बिक्री आसा बृथा।<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />तंऐं काढै पृथूईए कदुष्ट मणछ चाण-भांडै दी लागै दै चेरखै ज़िहै पोर्ही,</para>
  <para style="q" vid="PSA 119:119">तैही झ़ूरा हुंह तेरै बधाने बिधी लै खास्सअ।<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />ज़ांऊं मुंह तेरै नसाफ करने बारै सोठा,</para>
  <para style="q" vid="PSA 119:120">तेता सोठी छ़ुटा मुंह डरै दर्छ़णअ।<verse eid="PSA 119:120" /></para>
  <para style="s">बिधातो बधान मनणअ</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />मंऐं किअ सह ई काम ज़ुंण भलअ अर शुचअ आसा,</para>
  <para style="q" vid="PSA 119:121">तूह निं मुंह मेरै दुशमणा जैंदरी शोटी डाही!<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />हुंह आसा तेरअ च़ाकर, तूह दै मुल्है ज़बान कि ताह करनी मेरी मज़त,</para>
  <para style="q" vid="PSA 119:122">शरेरै मणछा निं मुंह हारनै-मारनै दैई।<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />मेरी आछी फिरी तेरी मज़त एछदी भाल़ी-भाल़ी पाल्‍ली अर</para>
  <para style="q" vid="PSA 119:123">हुंह आसा न्हैल़अ लागअ द कि तेरी ज़बान केभै हणीं पूरी।<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />हे बिधाता, हुंह आसा तेरअ दास तूह कर मुल्है झ़ूरी ज़ुंण अटल़ आसा,</para>
  <para style="q" vid="PSA 119:124">संघा शखैल़ मुखा आपणैं बधाने बिधी।<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />हुंह करा तेरी च़ाकरी, तूह दै मुल्है समझ़,</para>
  <para style="q" vid="PSA 119:125">ताकि हुंह तेरी शिक्षा शिखल़ी सकूं।<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />हे बिधाता, ऐबै गअ तेरै काम करनैओ बगत पुजी!</para>
  <para style="q" vid="PSA 119:126">किल्हैकि लोगै छ़ाडी तेरै बधाने साबै ज़िन्दगी ज़िऊंणीं।<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />हुंह झ़ूरा तेरै हुकमा लै च़ोखै सुन्‍नैं</para>
  <para style="q" vid="PSA 119:127">अर च़ंदी का बी खास्सअ।<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />हुंह करा हर गल्‍ला तेही ई ज़िहअ तूह हुकम करा,</para>
  <para style="q" vid="PSA 119:128">हुंह करा एही गल्‍ला का नफरत ज़ुंण मुंह कबाता सका पाई।<verse eid="PSA 119:128" /></para>
  <para style="s">बधाने साबै ज़िन्दगी ज़िऊंणें च़ाह</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />हे बिधाता, तेरी शिक्षा आसा महान,</para>
  <para style="q" vid="PSA 119:129">हुंह ज़िऊआ आपणीं ज़िन्दगी तेते साबै दिला का।<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />तेरै बैणे समझ़ दैआ मेरै मन्‍नां लै प्रैश्शअ,</para>
  <para style="q" vid="PSA 119:130">तेता करै एछा ऐडै मणछा बी अक्ल।<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />हुंह फहुंकुअ खास्सअ किल्हैकि</para>
  <para style="q" vid="PSA 119:131">हुंह च़ाहा दिला ज़िहअ बी तूह हुकम करे तिहअ करनअ।<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />तूह सोठ मेरै बारै संघा कर मुल्है झींण,</para>
  <para style="q" vid="PSA 119:132">ज़िहअ तूह ताल्है झ़ूरनै आल़ै लै करदी आअ।<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />तूह कर ज़िहअ तंऐं बोलअ तेही आपणीं ज़बान पूरी,</para>
  <para style="q" vid="PSA 119:133">मुंह निं बधल़णैं दैई अर कबध गल्‍ला का डाहै मुंह दूर।<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />ज़ुंणी हुंह हंती-हंती मारी आणअ, तिन्‍नां मणछा का बच़ाऊ मुंह तूह आप्पै,</para>
  <para style="q" vid="PSA 119:134">ताकि हुंह ज़िहअ तूह हुकम करे तिहअ ई करूं।<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />हे बिधाता, मुंह बाखा लोल़ी तंऐं प्रैश्शै मुंहैं भाल़अ,</para>
  <para style="q" vid="PSA 119:135">संघा शखैल़ मुखा आपणैं बधाने सोभी बिधी।<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />ज़ांऊं हुंह लोगा भाल़ा कि तिंयां निं तेरअ बधान मंदै,</para>
  <para style="q" vid="PSA 119:136">मेरै लागा आछी का आशूए छ़ो-छ़ंध।<verse eid="PSA 119:136" /></para>
  <para style="s">बधानो नसाफ</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />हे बिधाता, तूह आसा धर्मीं अर</para>
  <para style="q" vid="PSA 119:137">तेरै बधाना दी आसा नसाफ।<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />बधान दी तंऐं ज़ुंण बिधी आसा खोज़ी दी,</para>
  <para style="q" vid="PSA 119:138">तिंयां आसा पठी शुची अर भली।<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />ज़ांऊं हुंह भाल़ा कि मेरै दुशमण निं तेरै बधाने कदर करदै,</para>
  <para style="q" vid="PSA 119:139">मेरै दिलै हआ तेभै खास्सअ दुख।<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />हे बिधाता, तेरअ बैण आसा शुचअ-पाक्‍कअ,</para>
  <para style="q" vid="PSA 119:140">तैही झ़ूरा हुंह तेरअ च़ाकर तेता लै खास्सअ।<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />हुंह निं किछ़ बी आथी, हुंह आसा बृथा,</para>
  <para style="q" vid="PSA 119:141">पर तज़ी बी निं हुंह तेरै बधाने बिधी बिस्सरदअ।<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />तूह आसा धर्मीं अर तेरअ नसाफ आसा अटल़,</para>
  <para style="q" vid="PSA 119:142">अर तेरअ बधान आसा शुचअ।<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />हे बिधाता, हुंह आसा खरी दी पल़अ द,</para>
  <para style="q" vid="PSA 119:143">पर तेरै हुकम करा मुंह सुखी।<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />ज़ुंण तूह चतैनगी दैआ, तिंयां आसा भली,</para>
  <para style="q" vid="PSA 119:144">मुल्है दै तूह ई समझ़ ताकि हुंह ज़िऊंदअ रहूं।<verse eid="PSA 119:144" /></para>
  <para style="s">छ़ुटकारै लै अरज़</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />हे बिधाता, मेरी आसा ताह सेटा दिला का अरज़, ज़ीबाण तूह दै मुल्है ज़बाब,</para>
  <para style="q" vid="PSA 119:145">हुंह दैआ ताल्है ज़बान कि हुंह निं तेरअ हुकम बिस्सरदअ।<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />मेरी आसा ताह सेटा पकार कि मुंह बच़ाऊ,</para>
  <para style="q" vid="PSA 119:146">ताकि हुंह तेरै बधाने साबै आपणीं ज़िन्दगी ज़िऊई सकूं।<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />दोत्ती मांगा हुंह दोत्थी ताखा अरज़ करी मज़त,</para>
  <para style="q" vid="PSA 119:147">हुंह रहा तेते आसरै ज़ुंण तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />हुंह रहा सारी राची बिहुदअ,</para>
  <para style="q" vid="PSA 119:148">संघा रहा हुंह तेरी गल्‍ले बच़ार करदअ लागी।<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />किल्हैकि तेरअ मुल्है झ़ूरनअ आसा अटल़।</para>
  <para style="q" vid="PSA 119:149">हे बिधाता, मुल्है कर झींण, तूह डाह मुंह ज़िऊंदै।<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />मुंह हारनै-मारनै आल़ै गऐ मुंह नेल़ पुजी,</para>
  <para style="q" vid="PSA 119:150">तिंयां निं तेरअ बधान मंदै।<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />पर हे बिधाता, मुंह संघै आसा तूह आप्पै,</para>
  <para style="q" vid="PSA 119:151">अर तेरै हुकम आसा अटल़।<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />खास्सी साला ओर्ही आसा हुंह तेरै बधाना शिखल़दअ लागअ द,</para>
  <para style="q" vid="PSA 119:152">कि तंऐं आसा सह सदा लै डाहअ द बणाईं।<verse eid="PSA 119:152" /></para>
  <para style="s">मज़त करना लै बिधाता का अरज़</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />हे बिधाता, तूह भाल़ मेरी खरी संघा बच़ाऊ मुंह,</para>
  <para style="q" vid="PSA 119:153">किल्हैकि मंऐं निं तेरअ बधान बिस्सरअ आथी।<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />मुंह बाखा दै ज़बाब तूह ई, संघा कर मुंह आज़ाद,</para>
  <para style="q" vid="PSA 119:154">तूह बच़ाऊ मुंह ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />कदुष्ट मणछो बच़णअ आसा कठण,</para>
  <para style="q" vid="PSA 119:155">किल्हैकि तिंयां निं तेरै बधाने कदर करदै।<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />पर हे बिधाता, तेरी झींण आसा महान,</para>
  <para style="q" vid="PSA 119:156">तूह कर मुल्है झींण संघा बच़ाऊ मुंह!<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />मुंह हारनै-मारनै आल़ै अर दुशमण आसा खास्सै,</para>
  <para style="q" vid="PSA 119:157">पर हुंह निं तेरै बधाना मनणै का पिछ़ू हटदअ।<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />विश्वास घाती ज़ुंण तेरै हुकम नांईं मंदै,</para>
  <para style="q" vid="PSA 119:158">तिन्‍नां भाल़ी हआ मुंह तिन्‍नां लै नफरत।<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />हे बिधाता, तूह भाल़ हुंह तेरै बधाना लै किहअ झ़ूरा,</para>
  <para style="q" vid="PSA 119:159">तूह कर मुल्है आपणीं अटल़ झ़ूरी प्रगट संघा बच़ाऊ मुंह!<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />तेरै सारै बैण आसा शुचै,</para>
  <para style="q" vid="PSA 119:160">तेरी शिक्षा दी आसा सत्त अर तेरअ बधान आसा अटल़।<verse eid="PSA 119:160" /></para>
  <para style="s">दिला-मन्‍नां का बधान मनणअ</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />प्रधान आसा थोघै बाझ़ी मुंह हंतदै पिछ़ै पल़ै दै,</para>
  <para style="q" vid="PSA 119:161">पर हुंह करा तेरै बधाने खास्सी कदर।<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />तेरै बैणा लै हआ हुंह इहअ खुश ज़िहअ कुंण</para>
  <para style="q" vid="PSA 119:162">धन-माया भेटी करै खुश हआ।<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />मुंह आसा झ़ुठअ बोल़णैं का खास्सी नफरत</para>
  <para style="q" vid="PSA 119:163">पर तेरै बधाना लै झ़ूरा हुंह खास्सअ।<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />तेरै धर्मीं नसाफे बारै सोठा हुंह</para>
  <para style="q" vid="PSA 119:164">सारी धैल़ी साता बारी।<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />ज़ुंण तेरै बधाना लै झ़ूरा, तिंयां जाआ बच़ी,</para>
  <para style="q" vid="PSA 119:165">तिन्‍नां निं किछ़ै च़ीज़ धरनीं बदल़ी सकदी।<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />हे बिधाता, मुंह आसा सिधअ तेरअ आसरअ कि ताह हेरनअ हुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 119:166">हुंह कर तिहअ ई ज़िहअ तूह हुकम करा।<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />हुंह झ़ूरा तेरै बधाने साबै ज़िन्दगी ज़िऊंणां लै खास्सअ,</para>
  <para style="q" vid="PSA 119:167">हुंह मना तेता दिला का।<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />हुंह करा तिहअ ई ज़िहअ तूह हुकम करा अर ज़ेही तूह चतैनगी दैआ,</para>
  <para style="q" vid="PSA 119:168">तूह हआ आप्पै मुंह भाल़अ लागअ द कि हुंह किज़ै करा।<verse eid="PSA 119:168" /></para>
  <para style="s">बिधाता का मज़त</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />हे बिधाता, मेरी लेर-पकार लोल़ी ताह सेटा पुजी!</para>
  <para style="q" vid="PSA 119:169">तूह दै मुल्है समझ़ ज़िहअ तंऐं आप्पै आसा बोलअ द।<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />ज़ीबाण, मेरी लेर-पकार शुण,</para>
  <para style="q" vid="PSA 119:170">मुंह बच़ाऊ तूह ज़ेही तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />मुंह करनी सदा तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 119:171">किल्हैकि तंऐं शखैल़ी मुखा आपणैं बधाने सोभै बिधी।<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />मुंह गांठणी तेरै बधाने गिह,</para>
  <para style="q" vid="PSA 119:172">किल्हैकि तेरै सोभै हुकम आसा धर्मीं।<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />तूह आसा हर बगत मेरी मज़त करनअ लै खल़अ,</para>
  <para style="q" vid="PSA 119:173">किल्हैकि हुंह ज़िऊआ आपणीं ज़िन्दगी तेही ज़िहअ तूह हुकम करा।<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />हे बिधाता, मुंह आसा आशा कि ताह हेरनअ हुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 119:174">हुंह रहा तेरै बधाना दी खुश।<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />तूह दै मुल्है ज़िन्दगी ताकि हुंह तेरी ज़ै-ज़ैकार करी सकूं।</para>
  <para style="q" vid="PSA 119:175">तेरी चतैनगी करै लोल़ी मुंह मज़त भेटी।<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />हुंह तेरअ दास आसा हेल़्ही का दूर लुक्‍की दी भेडा ज़िहअ कबाता पेठअ द,</para>
  <para style="q" vid="PSA 119:176">तूह एछ मुंह लोल़अ आप्पै, हुंह आसा तेरअ च़ाकर,</para>
  <para style="q" vid="PSA 119:176">किल्हैकि मंऐं निं तेरअ बधान बिस्सरअ आथी।<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">बिधाता का मज़त मांगणा लै अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />खरीए पलका पाई मंऐं बिधाता सेटा पकार,</para>
  <para style="q" vid="PSA 120:1">तेऊ शूणीं मेरी अरज़।<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />हे बिधाता, तूह डाह मुंह शल़ैघा घल़णै आल़ै अर</para>
  <para style="q" vid="PSA 120:2">छ़ल़-कपट करनै आल़ै मणछा का बच़ाऊई।<verse eid="PSA 120:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />ओ झ़ुठअ बोल़णैं आल़ै मणछो, बिधाता ताल्है किज़ै करनअ?</para>
  <para style="q" vid="PSA 120:3">तम्हां लै तेऊ केतरी बडी सज़ा दैणीं?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />तम्हैं बिन्हणै तिछै कतीरा करै,</para>
  <para style="q" vid="PSA 120:4">संघा दहणैं आगीए नारे कूंडा दी।<verse eid="PSA 120:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />तम्हां मांझ़ै बस्सणै का आसा मेशक देशे लोगा जैंदरी</para>
  <para style="q" vid="PSA 120:5">अर कदार मुल्खे लोगा जैंदरी परदेसी ज़िहै बस्सणअ भलअ।<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />मुंह हुई तिन्‍नां मणछा संघै रहंदी खास्सी साला</para>
  <para style="q" vid="PSA 120:6">ज़ुंण मेल़-ज़ोल़ा का नफरत करा।<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />हुंह, च़ाहा तिन्‍नां संघै मेल़-ज़ोल़ करनअ पर</para>
  <para style="q" vid="PSA 120:7">तिंयां करा मेरै गल्‍ला करदी मुंह संघै झ़गल़अ।<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">बिधाता करा आपणीं परज़े फाज़त</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />हुंह भाल़ा उझै उछ़टी धारा बाखा लै,</para>
  <para style="q" vid="PSA 121:1">मुल्है मज़त किधा का एछणी?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />मेरी मज़त करा सह बिधाता आप्पै</para>
  <para style="q" vid="PSA 121:2">ज़ुंणी सारअ भ्रमंड आसा बणाअं द।<verse eid="PSA 121:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />सह बिधाता निं ताल्है ठोहल़ लागणै दैंदअ,</para>
  <para style="q" vid="PSA 121:3">ज़ुंण तेरी फाज़त करा, तेऊ निं निंजो झ़लारअ एछदअ।<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />ज़ुंण इज़राईलीए फाज़त करा, तेऊ निं उंघी लागदी,</para>
  <para style="q" vid="PSA 121:4">नां सह सुत्तदअ आथी।<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />बिधाता करनी तेरी फाज़त,</para>
  <para style="q" vid="PSA 121:5">सह आसा तेरी दैहणीं बाखा खल़अ कि तूह तेऊए नील़ै रही सके।<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />नां ताल्है धैल़ी धुप्पै अर</para>
  <para style="q" vid="PSA 121:6">अर नां राची ज़ोथा करै तेरी किज़ै हान्‍नी हणीं।<verse eid="PSA 121:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />बिधाता काढणअ तूह आफ़ता का बच़ाऊई,</para>
  <para style="q" vid="PSA 121:7">तेऊ बच़ाऊंणअ तूह मरनै का।<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />बिधाता करनी आझ़ा पोर्ही सारी सदा,</para>
  <para style="q" vid="PSA 121:8">एछदी-नांहंदी तेरी फाज़त।<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">ज़ै-ज़ैकार करना लै गिह</para>
  <para style="d">हांढा लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />मुंह हुई बेघै खास्सी खुशी ज़ांऊं मेरै साथी इहअ बोलअ,</para>
  <para style="q" vid="PSA 122:1">“च़ाल्‍ला हाम्हां डेऊणअ बिधाते पबित्र भबना लै।”<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />ऐबै आसा हाम्हैं इधी एरुशलेम नगरीए</para>
  <para style="q" vid="PSA 122:2">प्रऊल़ी भितरी खल़्हुऐ दै!<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />एरुशलेम नगरी भाल़ केही बांकी कारीगीरी आसा हुई दी,</para>
  <para style="q" vid="PSA 122:3">एता फेर फिरदी दुआली आसा उछ़टी अर पाक्‍की।<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />इधा लै एछा इज़राईले सोभी गोत्रे लोग</para>
  <para style="q" vid="PSA 122:4">बिधाता लै शूकर करदै, ज़िहअ</para>
  <para style="q" vid="PSA 122:4">बिधाता तिन्‍नां लै हुकम आसा किअ द।<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />इज़राईलीओ राज़अ आसा इधी,</para>
  <para style="q" vid="PSA 122:5">राज़गाद्दी प्रैंदै दाबेदे खिंबे नसाफ करदअ बेठअ द।<verse eid="PSA 122:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />बिधाता सेटा करा अरज़, “एरुशलेम नगरी लोल़ी मेल़-ज़ोल़ रहअ,</para>
  <para style="q" vid="PSA 122:6">हे बिधाता, ज़ुंण ताल्है झ़ूरा तिंयां लोल़ी राज्ज़ी-राम्बल़ै रहै।<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />नगरीए उछ़टी-उछ़टी दुआली भितरी लोल़ी मेल़-ज़ोल़ रहअ,</para>
  <para style="q" vid="PSA 122:7">अर तेरै मैहलै लोल़ी सोभै राज्ज़ी-राम्बल़ै रहै।”<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />आपणैं साथी-भाई अर नातै रिश्तैदारा लै बी करा हुंह बिधाता का अरज़,</para>
  <para style="q" vid="PSA 122:8">“तम्हां सोभी लै लोल़ी मेल़-ज़ोल़ हुअ।”<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />आपणैं परमेशर बिधातो भबने तैणीं करा</para>
  <para style="q" vid="PSA 122:9">हुंह बिधाता का अरज़ कि तम्हां लै लोल़ी खास्सी छाई-छदर हुई।<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">बिधाता का अरज़ कि झींण कर</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />हे बिधाता, परमेशर, हुंह लागा उझै स्वर्गा बाखा ताह भाल़अ<note caller="+" style="f"><char style="fr" closed="false">123:1 </char><char style="fq" closed="false">स्वर्गा बाखा ताह भाल़अ </char><char style="ft" closed="false">हे बिधाता, हुंह भाल़ा ताह प्राथणां दी उझै स्वर्गै ज़िधा का तूह पृथूई दी राज़ करा।</char></note>,</para>
  <para style="q" vid="PSA 123:1">ज़िधी राज़गाद्दी दी बेशी तूह राज़ करा।<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />ज़िहै दास अर हर बगत आपणैं मालका बाखा हेरै-भाल़ै रहा अर</para>
  <para style="q" vid="PSA 123:2">दासी आपणीं मालका बाखा भाल़ी-हेरी रहा,</para>
  <para style="q" vid="PSA 123:2">तिहै ई रहा हाम्हैं बी ताह भाल़ै लागी</para>
  <para style="q" vid="PSA 123:2">कि तूह हाम्हां लै झींण करे।<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />हे बिधाता, हाम्हां लै कर झींण, ज़ीबाण झींण कर,</para>
  <para style="q" vid="PSA 123:3">म्हारी किई लोगै साबा का बाधू बेइज़ती।<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />राज्ज़ी-मौज़ी रहणैं आल़ै सेठ मणछ हआ म्हारै सुहांगा लागै दै,</para>
  <para style="q" vid="PSA 123:4">शरेरै मणछै लाऐ हाम्हैं खास्सै हंती।<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">ज़ीत दैणा लै बिधातो शूकर</para>
  <para style="d">हांढा लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />इज़राईली दैआ ऐहा गल्‍लो ज़बाब!</para>
  <para style="q" vid="PSA 124:1">तै किज़ै हणअ ज़ै बिधाता हाम्हां बाखा नांईं होए?<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />ज़ै बिधाता हाम्हां संघै नांईं हंदअ,</para>
  <para style="q" vid="PSA 124:2">तै हेरै तै हाम्हैं म्हारै दुशमणै कधू धर<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />फेरा-फेर गोट दैई ज़िऊंदै ई घुटी!</para>
  <para style="q" vid="PSA 124:3">तिंयां थिऐ हाम्हां लै रोश्शै लाल पिंऊंल़ै हुऐ दै।<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />हाम्हैं जाणैं तै डुघै पाणीं जैंदरी डुबी</para>
  <para style="q" vid="PSA 124:4">अर तेता काढणैं तै हाम्हैं घर्होहल़ी करै किधी दूर अर<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />समुंदरे क्रुंगदी छ़ाल्‍ली निंणै तै हाम्हैं तेभी बहाऊई।<verse eid="PSA 124:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />बिधातो करा शूकर कि</para>
  <para style="q" vid="PSA 124:6">तेऊ निं हाम्हां दुशमणे हाथै मरनै दैनअ।<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />म्हारी ज़िन्दगी छ़ुटी च़ेल्‍लू ज़ेही शकारीए ज़ज़ाल़ा का,</para>
  <para style="q" vid="PSA 124:7">ज़ज़ाल़ धेल़्हुअ पोर्ही अर हाम्हैं निखल़ै ज़िऊंदै बच़ी।<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />म्हारी मज़त करनै आल़अ आसा सह बिधाता</para>
  <para style="q" vid="PSA 124:8">ज़ुंणी सारअ भ्रमंड आसा बणाअं द।<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">बिधाता डाहा आपणीं परज़ा राज्ज़ी-राम्बल़ै</para>
  <para style="d">हांढा लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />ज़ुंण बिधाता दी भरोस्सअ डाहा, तिंयां आसा सियोन पर्बता ज़िहै,</para>
  <para style="q" vid="PSA 125:1">ज़ुंण नां च़ुकदअ अर नां कधि ओर्ही-पोर्ही सिक्‍कदअ।<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />ज़ेही एरुशलेम नगरी फेर-फिरदी धारा आसा,</para>
  <para style="q" vid="PSA 125:2">तिहअ रहणअ बिधाता आपणीं परज़ा फेर</para>
  <para style="q" vid="PSA 125:2">आझ़ा पोर्ही सारी-सदा लै।<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />धर्मीं मणछे ज़ैगा प्रैंदै निं कदुष्ट मणछो राज़ सदा रहंदअ,</para>
  <para style="q" vid="PSA 125:3">ताकि धर्मीं मणछ कदुष्ट मणछा ज़िहै कदुष्ट कामां बाखा नां फिरे।<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />बिधाता करा तिन्‍नां लै भलअ ज़ुंण भोल़ै आसा अर</para>
  <para style="q" vid="PSA 125:4">ज़ुंण तेऊए हुकम मना।<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />पर ज़ुंण तेता का उंबल़ी बाता डेओआ,</para>
  <para style="q" vid="PSA 125:5">तिन्‍नां लै दैआ सह तेही ई सज़ा ज़ेही कदुष्ट मणछा भेटा<note caller="+" style="f"><char style="fr" closed="false">125:5 </char><char style="fq" closed="false">सज़ा ज़ेही कदुष्ट मणछा भेटा </char><char style="ft" closed="false">तिन्‍नां भेटा घोर सज़ा</char></note>।</para>
  <para style="q" vid="PSA 125:5">सोभी इज़राईली लै लोल़ी मेल़-ज़ोल़ हुअ।<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">छ़ुटकारै लै अरज़</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />ज़धू हाम्हैं बिधाता, एरुशलेम आपणीं नगरी बापस पजैल़ै,</para>
  <para style="q" vid="PSA 126:1">सह ज़ाण्हुंअ हाम्हां का सुपनै ज़िहअ।<note caller="+" style="f"><char style="fr" closed="false">126:1 </char><char style="ft" closed="false">ज़ांऊं बिधाता हाम्हैं गलामी का आज़ाद करी सियोना लै बापस आणै, तेऊ किअ सियोन भिई खल़अ। सियोन आसा एरुशलेम नगरीओ दुजअ नाअं।</char></note><verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />हाम्हैं लाग हास्सदै खेल्हदै अर हाम्हां हुई नाच़णै जोगी खुशी!</para>
  <para style="q" vid="PSA 126:2">तेखअ लागै होरी देशे लोग आप्पू मांझ़ै हाम्हां लै इहअ बोल्दै,</para>
  <para style="q" vid="PSA 126:2">“बिधाता किऐ इना लै खास्सै बडै-बडै काम।”<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />हाँ, बिधाता किऐ हाम्हां लै बडै-बडै महान काम अर</para>
  <para style="q" vid="PSA 126:3">हाम्हां आसा ऐहा गल्‍ले खुशी।<verse eid="PSA 126:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />हे बिधाता, हाम्हैं करा ताखा अरज़ कि हाम्हां लै दै तूह भिई बर्गत<note caller="+" style="f"><char style="fr" closed="false">126:4 </char><char style="fq" closed="false">भिई बर्गत </char><char style="ft" closed="false">हाम्हां आण गलामी का आज़ाद करी बापस फरेऊई</char></note>,</para>
  <para style="q" vid="PSA 126:4">हाम्हैं लोल़ी दखण रेगीस्ताने बगदी गाडा ज़िहै हुऐ।<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />हे बिधाता, हाम्हैं ज़ुंणी लेरा लाई-लाई बऊअ,</para>
  <para style="q" vid="PSA 126:5">तिन्‍नां लोल़ी खुशी दी ज़ै-ज़ैकार करदी लऊंणअ भेटअ।<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />बेज़ै बऊंदै डेऊंदी बारी लाई हाम्हैं लेरा,</para>
  <para style="q" vid="PSA 126:6">पर ऐबै एछणअ हाम्हां गिहा-बाता लांदी फिरी,</para>
  <para style="q" vid="PSA 126:6">ज़ांऊं हाम्हां नाज़े काशीए भर्टू आणनैं।<note caller="+" style="f"><char style="fr" closed="false">126:6 </char><char style="ft" closed="false">ईंयां तै पोशा-माघे धैल़ै</char></note><verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">घअरै बर्गत दैआ सिधअ बिधाता ई</para>
  <para style="d">राज़ै सुलैमाने बाता हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />ज़ै घअरा बणाणां लै बिधाते ज़ाज़त निं होए,</para>
  <para style="q" vid="PSA 127:1">तै आसा घअर च़िणनअ बृथा।</para>
  <para style="q" vid="PSA 127:1">नगरीए फाज़त ज़ै बिधाता नां करै,</para>
  <para style="q" vid="PSA 127:1">तै आसा पहरीओ पहरअ करनअ बी बृथा!<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />दोत्ती-दोत्थी उझ़ुई,</para>
  <para style="q" vid="PSA 127:2">आधा राची तैणीं मैन्थ करनी बी आसा बृथा!</para>
  <para style="q" vid="PSA 127:2">किल्हैकि ज़हा लै बिधाता झ़ूरा,</para>
  <para style="q" vid="PSA 127:2">तिंयां सुत्ता राज्ज़ी-मौज़ी निंजा।<verse eid="PSA 127:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />असली बर्गत हआ लान्हैं सुन्हैं हणैं,</para>
  <para style="q" vid="PSA 127:3">तिंयां हआ बिधाता हाम्हां लै</para>
  <para style="q" vid="PSA 127:3">आप्पू बाखा दैनी दी भैंट।<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />खारकी पलका खास्सै शोहरू-माठै हआ</para>
  <para style="q" vid="PSA 127:4">शूरबीरा का खास्सै कतीरा ज़िहै<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />सोभी का खुशी हआ तेऊ मर्धा लै ज़सरी किर्ली इना इहै कतीरा करै भरी हआ,</para>
  <para style="q" vid="PSA 127:5">तेऊए दुशमण निं तेऊ झ़गल़ै लै फेरा-फेर गोट दैई बी</para>
  <para style="q" vid="PSA 127:5">नसाफ करने ज़ैगा पांच़ी लै हारी सकदै।<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">बिधाता दैआ तिन्‍नां लै बर्गत ज़ुंण तेऊए साबै ज़िन्दगी ज़िऊआ</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />बिधाता दैआ तिन्‍नां लै बर्गत ज़ुंण तेऊए हुकम मना अर</para>
  <para style="q" vid="PSA 128:1">तेते साबै आपणीं ज़िन्दगी ज़िऊआ।<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />तिन्‍नें खेचै हणीं खास्सी पज़ैआ अर</para>
  <para style="q" vid="PSA 128:2">तिंयां रहणैं राज्ज़ी-मौज़ी अर सफल हंदै।<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />तिन्‍नें आपणीं लाल़ी हणीं तिन्‍नें टबरा लै फल़दी दाखे बेला ज़ेही,</para>
  <para style="q" vid="PSA 128:3">तिन्‍नें शोहरू हणैं तिन्‍नां लै जैतूने बूटा ज़िहै।<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />ज़ुंण बी बिधाते डरा हेठै रहा,</para>
  <para style="q" vid="PSA 128:4">तिन्‍नां लै दैआ सह ज़रूर एही ई बर्गत।<verse eid="PSA 128:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />बिधाता लोल़ी तिन्‍नां लै सियोन धारा का बर्गत दैनी!</para>
  <para style="q" vid="PSA 128:5">तिन्‍नां का शुझणीं एरुशलेम नगरी सारी अमरा राज्ज़ी-राम्बल़ी।<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />तिन्‍नें अमर हणीं एही लाम्मी कि तिन्‍नां न्हैल़णै आपणैं पोचै-पल़पोचै बी हंदै!</para>
  <para style="q" vid="PSA 128:6">इज़राईली लै लोल़ी मेल़-ज़ोल़ रहअ।<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">दुशमणा का ज़ितणा लै अरज़</para>
  <para style="d">हांढा गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />होछ़ी अमरा उझै आअ हुंह भाल़दी, दुशमण रहै हंतदै लागी!</para>
  <para style="q" vid="PSA 129:1">ऐबै बोला सोभै इज़राईली इहअ,<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />“होछ़ी अमरा ओर्ही आणै हाम्हैं दुशमणै</para>
  <para style="q" vid="PSA 129:2">फेरा-फेर गोटी हंती-हंती मारी,</para>
  <para style="q" vid="PSA 129:2">पर तिंयां निं हाम्हां हारी सकै।<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />म्हारी पिठी पाई तिन्‍नें एही सिया</para>
  <para style="q" vid="PSA 129:3">ज़िहअ हल़ा करै बाहअ द खेच हआ।<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />पर बिधाता आसा धर्मीं,</para>
  <para style="q" vid="PSA 129:4">तेऊ किऐ हाम्हैं कदुष्ट मणछे गलामी का आज़ाद।<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />मेरी आसा बिधाता का एही अरज़ कि ज़ुंण सियोन नगरी संघै ज़ीद डाहा,</para>
  <para style="q" vid="PSA 129:5">तिंयां लोल़ी हारै अर पिछ़ू हटै।<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />तिंयां लोल़ी दल़बै प्रैंदै लागै दै घाहा ज़िहै हुऐ</para>
  <para style="q" vid="PSA 129:6">ज़ुंण बझ़णै का आजी शुक्‍की जाआ।<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />तेता नां कुंण झाल़दअ अर</para>
  <para style="q" vid="PSA 129:7">नां कुंण पूल़ै बान्हदअ।<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />नां तिन्‍नां लै कुंणी एछदै-नांहंदै मणछै इहअ लोल़ी बोलअ,</para>
  <para style="q" vid="PSA 129:8">‘बिधाता लोल़ी तम्हां लै बर्गत दैनी!</para>
  <para style="q" vid="PSA 129:8">हाम्हैं दैआ तम्हां लै बिधाते नाओंऐं बर्गत।’”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">खरीए पलका बिधातो भरोस्सअ</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />हे बिधाता, खास्सै डुघै दी पल़ी पाआ हुंह</para>
  <para style="q" vid="PSA 130:1">खरीए पलका ताह सेटा पकार।<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />हे मेरै मालक, ज़ीबाण, मुंह बाखा दै धैन,</para>
  <para style="q" vid="PSA 130:2">तूह शुण मेरी लेर-पकार कि हुंह मांगा ताखा मज़त।<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />ज़ै तूह सोभिए पापो साब-कताब करे,</para>
  <para style="q" vid="PSA 130:3">तै निं कोहै ताह सेटा खल़अ टेक्‍की सकदअ!<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />पर तूह छ़ाडा हाम्हां लै माफी,</para>
  <para style="q" vid="PSA 130:4">ताकि हाम्हैं तेरी डरा हेठै रहणअ शिखल़े।<verse eid="PSA 130:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />हुंह रहअ ताह न्हैल़अ भाल़अ लागी कि ताह हेरनी मेरी मज़त करी,</para>
  <para style="q" vid="PSA 130:5">अर हुंह रहा तेते आसरै ज़ुंण तंऐं ज़बान आसा दैनी दी।<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />ज़िहै पहरी न्हैल़ै-भाल़ै रहा लागी कि राच केभै च़ाल्‍ली भैई,</para>
  <para style="q" vid="PSA 130:6">तिहअ रहा हुंह बी ताह मालका न्हैल़अ लागी,</para>
  <para style="q" vid="PSA 130:6">हुंह रहा तिन्‍नां पहरी का बी खास्सअ ताह मेरै मालक बिधाता न्हैल़अ चतैन।<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />इज़राईलीओ, बिधाता दी करा भरोस्सअ,</para>
  <para style="q" vid="PSA 130:7">किल्हैकि तेऊए झ़ूरी आसा हाम्हां लै अटल़,</para>
  <para style="q" vid="PSA 130:7">सह च़ाहा हर बगत हाम्हां बच़ाऊंणअ।<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />इज़राईली ज़ुंण पाप किऐ</para>
  <para style="q" vid="PSA 130:8">तेता का सका सह बिधाता ई तिन्‍नां बच़ाऊई।<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">बिधाते आसरै रहा</para>
  <para style="d">हांढा लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />हे बिधाता, मंऐं हेरअ आपणअ घमंड छ़ाडी,</para>
  <para style="q" vid="PSA 131:1">ऐबै निं हुंह शरेरअ रहअ।</para>
  <para style="q" vid="PSA 131:1">ज़ुंण गल्‍ला मेरै भलै हई निं सकदी,</para>
  <para style="q" vid="PSA 131:1">तेथ बाखा निं हुंह ऐबै धैन दैंदअ।<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />पर हुंह रहा ऐबै शांत अर च़ुप्पी,</para>
  <para style="q" vid="PSA 131:2">ज़िहअ च़ूई चल़ाऊअ द लान्हअ आपणीं ईजे बाह दी च़ुप्पी रहा,</para>
  <para style="q" vid="PSA 131:2">तिहअ आसा ऐबै मेरअ दिल हुअ द।<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />ओ इज़राईलीओ, आझ़ा पोर्ही रहा कबल्‍लै</para>
  <para style="q" vid="PSA 131:3">सारी सदा लै बिधाते आसरै।<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">बिधाता रहा सदा आपणीं परज़ा संघै</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />हे बिधाता, राज़ै दाबेदा निं बिस्सरी आथी कि</para>
  <para style="q" vid="PSA 132:1">तेऊ केही खरी-अऊखी काटी।<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />हे बिधाता, तैहा गल्‍ला कर आद कि तेऊ किज़ै ज़बान दैनी ती,</para>
  <para style="q" vid="PSA 132:2">तेऊ आसा ताह याकबे महान परमेशरा लै मानत मनी दी, ज़हा का सारअ बल आसा।<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />तेऊ बोलअ त इहअ, “मुंह निं तेभै तैणीं आपणैं घअरा भितरी डेऊणअ</para>
  <para style="q" vid="PSA 132:3">अर नां आपणैं पलगा प्रैंदै सुत्तणअ आथी,<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />तेभै तैणीं नां मुंह राम करनअ नां सुत्तणअ आथी,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />ज़ांऊं तैणीं हुंह आपणैं मालक बिधाता लै खास ज़ैगा निं डाहूं</para>
  <para style="q" vid="PSA 132:5">ज़हा का सारअ बल आसा अर ज़हा परमेशरा याकब बी मना त।”<verse eid="PSA 132:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />ज़धू हाम्हैं एप्रात<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">एप्रात </char><char style="ft" closed="false">एप्रात थिअ बेतलेम नगरीओ पराणअ नाअं</char></note> थिऐ, हाम्हैं शूणअ त करारे मणशूए बारै</para>
  <para style="q" vid="PSA 132:6">हाम्हां भेटअ सह ज़रीम <note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">ज़रीम </char><char style="ft" closed="false">किर्यात-ज़रीम थिई एरुशलेम उतर पछ़मा बाखा च़ौदा किलूमीटर दूर एक नगरी ज़िधी बिधातो करारो मणशू पलिश्ती लोगा का बापसी दी बिहा साला तैणीं रहअ त। पलिश्ती त सह जुधा दी ज़िती आपणैं कबज़ै डाहअ द।</char></note>बणैं<note caller="-" style="x"><char style="xo" closed="false">132:6 </char><char style="xq" closed="false">हाम्हां भेटअ सह ज़रीम बणैं </char><char style="xt" closed="false"><ref loc="1SA 4:1-6">1 शमू. 4:1-6</ref>,<ref loc="1SA 4:16">16</ref></char></note>।<note caller="-" style="x"><char style="xo" closed="false">132:6 </char><char style="xt" closed="false"><ref loc="RUT 1:1-2">रूत. 1:1-2</ref>; <ref loc="MIC 5:2">मिक. 5:2</ref></char></note><verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />हाम्हैं बोलअ इहअ, “च़ाल्‍ला, हाम्हां डेऊणअ पबित्र ज़ैगा बिधाते घअरै,</para>
  <para style="q" vid="PSA 132:7">तेऊ सेटा टेक्‍कणअ हाम्हां माथअ।”<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />हे बिधाता, तेऊ भबना लै एछ आपणैं करारे मणशू संघै</para>
  <para style="q" vid="PSA 132:8">ज़ुंण तेरै बलो नशाण आसा,</para>
  <para style="q" vid="PSA 132:8">संघा लोल़ी तूह इधी सदा रहअ।<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />तिधी लोल़ी तेरै प्रोहतै सदा धर्म किअ,</para>
  <para style="q" vid="PSA 132:9">अर तेरी परज़ा लोल़ी तेरी ज़ोरै-ज़ोरै ज़ैकार किई।<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />दाबेद करा त तेरी च़ाकरी अर तंऐं आसा तेऊ लै ज़बान दैनी दी!</para>
  <para style="q" vid="PSA 132:10">हे बिधाता, ज़ुंण राज़अ तंऐं आप्पै आसा छ़ांटअ द, तेऊ निं तूह दूर करी।<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />तंऐं बिधाता आसा राज़ै दाबेदा संघै एही करार किई दी</para>
  <para style="q" vid="PSA 132:11">ज़ेता लै तूह पिछ़ू निं हटदअ,</para>
  <para style="q" vid="PSA 132:11">“तेरी राज़गाद्दी प्रैंदै बशैल़णअ मुंह तेरी ई आद-लुआदा मांझ़ै एक राज़अ,</para>
  <para style="q" vid="PSA 132:11">तेऊ करनअ ताह बाद सदा राज़।”<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />ज़ै तेरी आद-लुआद मुंह संघै हुई दी करार पूरी करे अर</para>
  <para style="q" vid="PSA 132:12">ज़ुंण हुकम मंऐं ताल्है दैनै, तिंयां बी तेते साबै आपणीं ज़िन्दगी ज़िऊए,</para>
  <para style="q" vid="PSA 132:12">तै रहणअ अह राज़ पोस्ती दर पोस्ती सदा तेरी आद-लुआदा का।<verse eid="PSA 132:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />तंऐं बिधाता आसा सियोन आप्पू लै छ़ांटअ द,</para>
  <para style="q" vid="PSA 132:13">तूह च़ाहा तिधी आप्पू बस्सणअ।<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />तम्हैं बोलअ त इहअ, “अह आसा सह ज़ैगा ज़िधी हुंह सदा रहणअ,</para>
  <para style="q" vid="PSA 132:14">अह आसा मेरअ घअर।<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />मुंह करनी सियोन नगरीए हर गरज़ा पूरी,</para>
  <para style="q" vid="PSA 132:15">ऐहा नगरीए रैनै-गरीबा लै दैणअ मुंह रज्ज़ी खाण-पींण।<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />एसे प्रोहता लै दैणीं मुंह सोभी कामां लै बर्गत,</para>
  <para style="q" vid="PSA 132:16">ऐहा नगरी दी रहणैं आल़ै करनी खुशी दी ज़ै-ज़ैकार।<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />इधी बणाणअं मुंह राज़ै दाबेदे आद-लुआदा मांझ़ै ई एक महान राज़अ,</para>
  <para style="q" vid="PSA 132:17">इधी ज़ुंण राज़अ मंऐं आसा छ़ांटअ द, सह हणअ सोभी लोगा लै प्रैश्शै ज़िहअ।<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />तेऊए दुशमण करनै मुंह शर्मिंदै,</para>
  <para style="q" vid="PSA 132:18">पर तेऊए मुंडै मुगट रहणअ सदा च़मकदअ लागी।”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">बिधाते परज़ा लागा मिल़ी-ज़ुल़ी करै रहणअ</para>
  <para style="d">हांढा लै राज़ै दाबेदे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />सह भाल़ केही शोभली अर भली गल्‍ल आसा कि</para>
  <para style="q" vid="PSA 133:1">बिधाते परज़ा रहा आप्पू मांझ़ै मिल़ी-ज़ुल़ी करै।<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />अह गल्‍ल हणीं तेऊ जैतूने किम्मती तेला ज़ेही</para>
  <para style="q" vid="PSA 133:2">ज़ुंण तेल हारण प्रोहते मुंडै तरैल़अ त<note caller="+" style="f"><char style="fr" closed="false">133:2 </char><char style="fq" closed="false">तेल हारण प्रोहते मुंडै तरैल़अ त </char><char style="ft" closed="false">खुशबूदार किम्मती तेल तरैल़अ त हारणे मुंडै ज़धू सह माहा प्रोहत बणाअं त।</char></note>,</para>
  <para style="q" vid="PSA 133:2">अर तेऊए दाल़्ही बाती उंधै लागी ती तेते ट्रिहुंणीं च़ोल़े पाल्‍लै तैणीं।<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />अह हणीं हर्मोन धारा ओशा ज़ेही,</para>
  <para style="q" vid="PSA 133:3">ज़ुंण सियोन धारा पल़ा।</para>
  <para style="q" vid="PSA 133:3">ज़हा ज़ैगा का बिधाता लोगा लै बर्गत दैणा लै बोलअ त,</para>
  <para style="q" vid="PSA 133:3">कि तम्हां लै दैंऊं एही ज़िन्दगी ज़ुंण कधि खतम निं हणीं।<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">राची बी रहणअ बिधाते स्तोती करदै लागी</para>
  <para style="d">हांढा लै गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />ज़ुंण बी बिधाते च़ाकरी करा,</para>
  <para style="q" vid="PSA 134:1">ज़ुंण राची बिधाते भबनै रही च़ाकरी करा,</para>
  <para style="q" vid="PSA 134:1">तिंयां एछा सोभै संघा करा बिधाते ज़ै-ज़ैकार।<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />आपणैं हाथ फुआरा उझै पबित्र ज़ैगा बाखा लै खल़ै,</para>
  <para style="q" vid="PSA 134:2">संघा करा बिधाते ज़ै-ज़ैकार।<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />ज़ुंणी बिधाता सारअ भ्रमंड आसा बणाअं द,</para>
  <para style="q" vid="PSA 134:3">तेऊ लोल़ी तम्हां लै सियोना का बर्गत दैनी।<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">बिधाते महान काम</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />बिधाते ज़ै-ज़ैकार करा!</para>
  <para style="q" vid="PSA 135:1">ए बिधाते च़ाकरी करनै आल़ैओ, बिधाते नाओंए करा ज़ै-ज़ैकार।<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />ज़ुंण परमेशर बिधाते भबनै,</para>
  <para style="q" vid="PSA 135:2">पबित्र ज़ैगा च़ाकरी करा,<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />तम्हैं सोभै करा बिधाते ज़ै-ज़ैकार। किल्हैकि सह आसा भलअ,</para>
  <para style="q" vid="PSA 135:3">तेऊए ज़ै-ज़ैकार करना लै बोला गिहा किल्हैकि सह आसा झणैल़ू।<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />बिधाता छ़ांटअ याकब आप्पू लै,</para>
  <para style="q" vid="PSA 135:4">मतलब इज़राईली बणाऐं तेऊ आपणीं खास परज़ा।<verse eid="PSA 135:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />मुखा आसा थोघ कि बिधाता आसा महान,</para>
  <para style="q" vid="PSA 135:5">सह आसा सोभी देअ-देबी का बडअ।<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />सरग, धरती अर डुघै समुंदरै</para>
  <para style="q" vid="PSA 135:6">सका सह ज़िहअ तेऊओ दिल बोलअ तिहअ करी अर</para>
  <para style="q" vid="PSA 135:6">तेऊ करी बी हेरअ खोज़ी।<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />सह आणा पृथूईए दुजै बाढा का बादल़,</para>
  <para style="q" vid="PSA 135:7">सरग हणां लै लाआ सह गुल़ूबिज़ल़ू,</para>
  <para style="q" vid="PSA 135:7">आपणैं भढारा का छ़ाडा सह बागरी।<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />मिसर देशे लोगे पाऐ तै बिधाता</para>
  <para style="q" vid="PSA 135:8">मणछ अर डागै-धणे ज़ेठै शोहरू मारी।<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />तिधी दैनी ती बिधाता नुआहरै नछ़ैण अर च़मत्कार रहैऊई,</para>
  <para style="q" vid="PSA 135:9">माहा राज़ै अर तेऊए कार करिंदै लै सज़ा।<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />तेऊ किऐ कई देश खतम अर</para>
  <para style="q" vid="PSA 135:10">बडै-बडै जोधै राज़ै पाऐ मारी।<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />अमोरी लोगो राज़अ सिहोन,</para>
  <para style="q" vid="PSA 135:11">बाशान देशो राज़अ ओग अर</para>
  <para style="q" vid="PSA 135:11">कनान देशे निं कोहै राज़ै तेऊ ज़िऊंदै छ़ाडै।<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />तिन्‍नों देश अर ज़ैदात दैनी तेऊ</para>
  <para style="q" vid="PSA 135:12">आपणीं परज़ा इज़राईली लै बांडी।<verse eid="PSA 135:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />हे बिधाता, तेरअ नाअं रहणअ सदा अटल़,</para>
  <para style="q" vid="PSA 135:13">तूह निं पोस्ती दर पोस्ती कोही बिस्सर्नअ।<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />ज़ुंण बिधाते च़ाकरी करे, तेऊ करनी तिन्‍नें च़ाकरी,</para>
  <para style="q" vid="PSA 135:14">तिन्‍नें खरी भाल़ी करनी तेऊ तिन्‍नां लै झींण।<verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />पराई ज़ातीए लोगे देअ-देबी आसा सुन्‍नैं-च़ंदीए,</para>
  <para style="q" vid="PSA 135:15">तिंयां आसा मणछै आपणैं हाथै बणाऐं दै।<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />तिन्‍नें खाखा ता हआ पर तिंयां निं गल्‍ला करी सकदै,</para>
  <para style="q" vid="PSA 135:16">तिन्‍नें आछी ता हआ पर शुझदअ निं तिन्‍नां का आथी!<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />तिन्‍नां मैहरे कान ता हआ पर तिंयां निं शूणीं सकदै,</para>
  <para style="q" vid="PSA 135:17">नां तिन्‍नां दी शाह आथी!<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />ज़ुंणी तिंयां मुहुर्ती बणाईं अर ज़ुंण तिन्‍नां दी भरोस्सअ डाहा,</para>
  <para style="q" vid="PSA 135:18">तिंयां बी हुऐ तिन्‍नां मुहुर्ती ई ज़िहै बृथा अर गुग्गै।<verse eid="PSA 135:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />ओ इज़राईलीओ, बिधाते ज़ै-ज़ैकार करा,</para>
  <para style="q" vid="PSA 135:19">तेऊ परमेशर बिधाता लै करा शूकर।<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />लेबी ज़ुंण हारणो खिंब बिधाते प्रोहत आसा, सोभै करा ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 135:20">बिधाते डरा हेठै रहणैं आल़ै करा सोभै तेऊए ज़ै-ज़ैकार।<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />सियोन नगरीओ मालक बिधाता आसा ज़ै-ज़ैकार करनै जोगी,</para>
  <para style="q" vid="PSA 135:21">सह रहा एरुशलेम नगरी।</para>
  <para style="q" vid="PSA 135:21">तेऊओ करा शूकर अर ज़ै-ज़ैकार।<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">बिधाता झ़ूरा सदा</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />बिधातो शूकर करा, किल्हैकि सह आसा भलअ,</para>
  <para style="q" vid="PSA 136:1">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />तेऊ बिधातो करा शूकर ज़ुंण सोभी देअआ का बडअ आसा,</para>
  <para style="q" vid="PSA 136:2">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />तेऊ बिधातो शूकर करा ज़ुंण मालका प्रैंदै सोभिओ मालक आसा,</para>
  <para style="q" vid="PSA 136:3">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />सह आसा बिधाता ई एक्‍कै ज़ुंण महान च़मत्कार करा,</para>
  <para style="q" vid="PSA 136:4">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />बिधातो शूकर करा ज़ुंणी आपणीं महान समझ़ा करै सारअ भ्रमंड बणाअं,</para>
  <para style="q" vid="PSA 136:5">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />बिधातो शूकर करा ज़ुंणी पाणीं प्रैंदै धरती छ़ैई,</para>
  <para style="q" vid="PSA 136:6">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />तेऊ बणाऐं सुरज़ अर ज़ोथ,</para>
  <para style="q" vid="PSA 136:7">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />सुरज़ डाहअ तेऊ कि सह धैल़ी दी राज़ करे,</para>
  <para style="q" vid="PSA 136:8">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />ज़ोथ अर तारै लै दैनअ राची दी राज़,</para>
  <para style="q" vid="PSA 136:9">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />तेऊ पाऐ मिसर देशे लोगे अर तिन्‍नें पशूए ज़ेठै मारी,</para>
  <para style="q" vid="PSA 136:10">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />तेऊ आणै मिसरी लोगा मांझ़ा का इज़राईली बच़ाऊई,</para>
  <para style="q" vid="PSA 136:11">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />तेऊ काढै तिधा का आपणीं बाहे महान ज़ोरा करै,</para>
  <para style="q" vid="PSA 136:12">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />बिधातो करा शूकर ज़ुंणी लाल समुंदर ओर्ही-पोर्ही दूई बाखा लै किअ,</para>
  <para style="q" vid="PSA 136:13">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />तेऊ टपाऊऐ इज़राईली जैंदरी बाती लाल समुंदरा पार राज्ज़ी-राम्बल़ै,</para>
  <para style="q" vid="PSA 136:14">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />पर तेऊ घर्होहल़ै मिसर देशो माहा राज़अ अर तेऊए सारी सैना लाल समुंदरे डुघै पाणीं जैंदरी,</para>
  <para style="q" vid="PSA 136:15">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />तेऊ बिधातो करा शूकर ज़ुंणी आपणीं परज़ा घोर उज़र रेगीस्ताना बाती नढैऊऐ,</para>
  <para style="q" vid="PSA 136:16">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />बिधातो करा शूकर ज़ुंणी बडै-बडै मशूर राज़ै का ज़ित्तअ।</para>
  <para style="q" vid="PSA 136:17">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />तिंयां बलबान मशूर राज़ै पाऐ तेऊ मारी,</para>
  <para style="q" vid="PSA 136:18">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />अमोरी देशो राज़अ सिहोन,</para>
  <para style="q" vid="PSA 136:19">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />बाशान देशो राज़अ ओग पाअ तेऊ मारी,</para>
  <para style="q" vid="PSA 136:20">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />तिन्‍नें ज़ैगा दैनी तेऊ आपणीं परज़ा लै,</para>
  <para style="q" vid="PSA 136:21">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />सह ज़ैगा दैनी तेऊ इज़राईली लै ज़ुंण तेऊए च़ाकरी करा,</para>
  <para style="q" vid="PSA 136:22">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />तेऊ डाहै हाम्हैं म्हारी खरीए पलका आद,</para>
  <para style="q" vid="PSA 136:23">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />तेऊ बच़ाऊऐ हाम्हैं म्हारै दुशमणा का,</para>
  <para style="q" vid="PSA 136:24">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />सोभी ज़ीबो पेट भरा सह आप्पै,</para>
  <para style="q" vid="PSA 136:25">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />तेऊ परमेशरो करा शूकर ज़ुंण स्वर्गै आसा बेठअ द,</para>
  <para style="q" vid="PSA 136:26">सह झ़ूरा हाम्हां लै सदा।<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">गलामीए पलका इज़राईलीओ लामण</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />हाम्हैं रहै बाबेल गाडे बाढै बेशी,</para>
  <para style="q" vid="PSA 137:1">संघा रहै एरुशलेम नगरी आद करी लेरा लांदै लागी।<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />तिधी डाही हाम्हैं मधनूंए बूटा दी</para>
  <para style="q" vid="PSA 137:2">आपणैं बींन बाज़ै छ़ड़ाऊई।<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />किल्हैकि ज़ुंणी हाम्हैं गलाम बणाईं निंयैं तै,</para>
  <para style="q" vid="PSA 137:3">तिंयां लागै हाम्हां लै बोल्दै कि गिहा बोला,</para>
  <para style="q" vid="PSA 137:3">कि तेता करै हाम्हैं तिन्‍नां खुश करे! तिंयां बोला तै,</para>
  <para style="q" vid="PSA 137:3">“ज़ेही गिहा तम्हैं एरुशलेम बोला, तिन्‍नां मांझ़ै शणाऊंआं हाम्हां का गिहा।”<verse eid="PSA 137:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />हाम्हैं बिधाते गिहा किहअ करै सका</para>
  <para style="q" vid="PSA 137:4">पाखलै देशै बोली?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />ओ एरुशलेम, ज़ै हाम्हैं ताह बिस्सरी पाए,</para>
  <para style="q" vid="PSA 137:5">तै लोल़ी म्हारअ खाणअ हाथ बी बींन बाज़णीं बिस्सरुअ।<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />ज़ै हाम्हैं ताह आद निं करे,</para>
  <para style="q" vid="PSA 137:6">तै लोल़ी हाम्हैं गिहा बोल़णैं बी बिस्सरुऐ,</para>
  <para style="q" vid="PSA 137:6">ज़ै हाम्हैं इहअ निं सोठै कि एरुशलेम नगरी आसा म्हारी सोभी का बडी खुशी!<verse eid="PSA 137:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />हे बिधाता, तिन्‍नां धैल़ै कर आद ज़धू एदोमी लोगै एरुशलेम गिम्मअ,</para>
  <para style="q" vid="PSA 137:7">तधू तिन्‍नैं किज़ै-किज़ै किअ।</para>
  <para style="q" vid="PSA 137:7">तैहा गल्‍ला कर आद ज़ुंण तिंयां इहअ बोला तै,</para>
  <para style="q" vid="PSA 137:7">“ऐहा नगरी करा पठी बरैबाद, एता पाआ पठी ढोल़ी!”<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />ओ बाबेल देशे लोगो, तम्हैं हणैं पठी बरैबाद।</para>
  <para style="q" vid="PSA 137:8">हाम्हैं करा बिधाता का अरज़ कि ज़ुंण तम्हैं हाम्हां संघै बर्ताअ किअ,</para>
  <para style="q" vid="PSA 137:8">तेते बदल़ै ज़ुंण तम्हां लै सज़ा दैए, तिन्‍नां लै लोल़ी बिधाता बर्गत दैनी।<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />तिन्‍नैं लोल़ी थारै होछ़ै-होछ़ै लान्हैं,</para>
  <para style="q" vid="PSA 137:9">ज़ांघा का ढाकी बडै पात्थरा प्रैंदै छ़णाट्टी करै मारै।<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">बिधातो करा दिला का शूकर</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />हे बिधाता, मुंह करनअ दिला का तेरअ शूकर,</para>
  <para style="q" vid="PSA 138:1">मुंह बोल़णीं होरी देअआ नदरी बी तेरी ज़ै-ज़ैकार करना लै गिहा।<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />मुंह फिरनअ तेरै पबित्र भबना बाखा,</para>
  <para style="q" vid="PSA 138:2">संघा करनी मुंह धरनीं माथअ टेक्‍की तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 138:2">किल्हैकि तेरअ सत्त अर झ़ूरी रहा हाम्हां लै सदा,</para>
  <para style="q" vid="PSA 138:2">अर तंऐं रहैऊअ सोभी का इहअ कि तेरअ नाअं अर तेरै बैण आसा सोभी का महान।<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />तंऐं शूणीं मेरी पकार ज़ेभै मंऐं ताखा अरज़ किई,</para>
  <para style="q" vid="PSA 138:3">तंऐं पाऐ हैअ दैई मुंह दी तराण।<verse eid="PSA 138:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />पृथूईए सोभी राज़ै करनअ तेरअ शूकर करी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 138:4">किल्हैकि तिन्‍नैं हेरअ तेरै बैण शूणीं।<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />तिन्‍नां बोल़णीं तेरै महान प्रतप्प अर</para>
  <para style="q" vid="PSA 138:5">ज़ुंण तंऐं किअ तेता लै गिहा बोली ज़ै-ज़ैकार।<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />एही ताह आसा तूह बिधाता बडअ महान सोभी का उझै,</para>
  <para style="q" vid="PSA 138:6">तज़ी बी डाहा तूह भोल़ै मणछो खैल,</para>
  <para style="q" vid="PSA 138:6">पर घमंडी मणछा हेरा तूह दूरा का बछ़ैणीं।<verse eid="PSA 138:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />ज़ेभै मुंह फेरा-फेर आफ़त पल़ी,</para>
  <para style="q" vid="PSA 138:7">तेभै डाहअ तंऐं हुंह मेरै दुशमणा का बच़ाऊई,</para>
  <para style="q" vid="PSA 138:7">ज़ुंण मुल्है रोश्शै लाल-पिंऊंल़ै तै हुऐ दै।</para>
  <para style="q" vid="PSA 138:7">तंऐं डाहअ आपणीं महान बाहे बला करै हुंह बच़ाऊई।<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />हे बिधाता, ज़ुंण तंऐं ज़बान दैनी, सह करनी ताह पूरी,</para>
  <para style="q" vid="PSA 138:8">तेरी झ़ूरी आसा अटल़।</para>
  <para style="q" vid="PSA 138:8">ज़ुंण काम तंऐं शुरू किअ, तेऊ लअ तूह ऐबै छ़ेक्‍की।<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">बिधातो पठी ज्ञैन</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />हे बिधाता, तंऐं आसा हुंह ज़ाच़अ भाल़अ द,</para>
  <para style="q" vid="PSA 139:1">अर ताखा आसा मेरै बारै पठी थोघ।<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />मेरै उझ़णै-बेशणे बारै आसा ताखा पठी थोघ,</para>
  <para style="q" vid="PSA 139:2">ताखा जाआ उझै स्वर्गै एतरअ दूर थोघ लागी कि हुंह किज़ै सोठा।<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />तूह रहा मुंह सोभी गल्‍ला लै ज़ाच़दअ भाल़अ लागी,</para>
  <para style="q" vid="PSA 139:3">ताखा आसा सोभी गल्‍लो थोघ कि हुंह किज़ै-किज़ै करा।<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />मेरी गल्‍ला करनै का आजी हआ ताखा थोघ कि</para>
  <para style="q" vid="PSA 139:4">मंऐं किज़ै लाअ बोली!<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />तूह आसा मुंह फेरा-फेर खल़अ।</para>
  <para style="q" vid="PSA 139:5">तूह डाहा मुंह आपणीं बाहे महान बला करै बच़ाऊई।<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />तेरै बारै सारअ ज्ञैन डाहणअ आसा मुल्है कठण,</para>
  <para style="q" vid="PSA 139:6">अह समझ़णअ आसा मेरै बशा का बागै।<verse eid="PSA 139:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />ताह छ़ाडी हुंह किधा लै सका डेऊई?</para>
  <para style="q" vid="PSA 139:7">ताखा दूर डेऊई किधी सका हुंह लुक्‍की?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />ज़ै हुंह उझै सरगा लै बी उखल़ूं, तिधी आसा तूह!</para>
  <para style="q" vid="PSA 139:8">ज़ै हुंह उंधै पैईताल़ै बी डेऊं, तिधी बी आसा तूह!<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />ज़ै हुंह डैअ दैई पुर्बा दिशा बाखा</para>
  <para style="q" vid="PSA 139:9">समुंदरा पार डेऊई कांगनरांगै बी बस्सूं,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />तूह हणअ तिधी बी मेरी मज़त करदअ लागअ द अर</para>
  <para style="q" vid="PSA 139:10">हाथा ढाकी मुंह नढैऊंदअ लागअ द।<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />ज़ै हुंह इहअ बी बोलूं कि न्हैरै निं हुंह शुझुई च़ाल्‍लअ,</para>
  <para style="q" vid="PSA 139:11">मुंह फेर प्रैश्शअ न्हैरी राची दी बधल़िए,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />पर तूह हेरा तेथ बी भाल़ी,</para>
  <para style="q" vid="PSA 139:12">ताल्है हआ राची बी धैल़ी ज़िहअ प्रैश्शअ,</para>
  <para style="q" vid="PSA 139:12">ताल्है हआ राच अर धैल़ी एक्‍कै ज़ेही।<verse eid="PSA 139:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />तंऐं आसा मेरी देही भितरे सोभै गल्‍ला बणाईं दी,</para>
  <para style="q" vid="PSA 139:13">मेरी आसा आपणैं हाथै मेरी माए ओदरै हुंह बूणअ द।<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />हुंह करा तेरअ शूकर किल्हैकि ताखा लागा डरनअ ई,</para>
  <para style="q" vid="PSA 139:14">ज़ेऊ साबै तंऐं हुंह बणाअं सह आसा बडअ ज़बर अर नोखअ!</para>
  <para style="q" vid="PSA 139:14">ऐहा गल्‍ला समझ़ा हुंह ज़ाथी राम्बल़ै करै।<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />मेरी माए ओदरै ज़ोल़ै तंऐं</para>
  <para style="q" vid="PSA 139:15">मेरै हाडकै-हाडकै बडै राम्बल़ै करै,</para>
  <para style="q" vid="PSA 139:15">हुंह त गुप्त बझ़दअ लागअ द</para>
  <para style="q" vid="PSA 139:15">पर ताखा निं मेरी किछ़ै च़ीज़ गुप्त आथी ती,<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />तूह त मेरै ज़ल्म हणैं का आजी मुंह बझ़दै भाल़अ लागअ द।</para>
  <para style="q" vid="PSA 139:16">मेरै ज़ल्म हणैं का आजी थिऐ तंऐं</para>
  <para style="q" vid="PSA 139:16">मेरी ज़िन्दगीए हर धैल़ै</para>
  <para style="q" vid="PSA 139:16">आपणीं कताबा दी लिखी हेरै दै डाही।<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />हे परमेशर, तेरी सोठ समझ़णीं आसा मेरै बशा का बागै,</para>
  <para style="q" vid="PSA 139:17">तेता निं कुंण गणी सकदअ कि सह केतरी आसा।<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />ज़ै हुंह तेता गणदअ लागूं, तैबी निखल़णीं सह समुंदरे रेते कणीं का बी खास्सी,</para>
  <para style="q" vid="PSA 139:18">ज़ेभै हुंह सुत्ती उझ़िआ, मुखा ज़ाण्हिंआं इहअ कि तूह आसा मुंह ई सेटा।<verse eid="PSA 139:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />हे परमेशर, हुंह च़ाहा त इहअ कि तंऐं लोल़ी कदुष्ट मारी पाऐ!</para>
  <para style="q" vid="PSA 139:19">ज़ुल्म करनै आल़ै लोल़ी तै मुक्‍का दूर हुऐ!<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />तिंयां करा ताह संघै कबल्‍लअ विश्वास घात,</para>
  <para style="q" vid="PSA 139:20">तिंयां लआ तेरअ नाअं झ़ुठी गल्‍ला लै।<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />हे बिधाता, ताखा आसा थोघ कि हुंह करा तिन्‍नां लै नफरत,</para>
  <para style="q" vid="PSA 139:21">ज़ुंण ताह संघै ज़ीद डाहा अर ज़ुंण तेरै खलाफ आसा।<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />तिन्‍नां समझ़ा हुंह आपणअ बी दुशमण,</para>
  <para style="q" vid="PSA 139:22">मुंह आसा दिला का इना इहै लै नफरत।<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />हे परमेशर, तूह ज़ाच़-भाल़ मुंह राम्बल़ै करै, संघा भाल़ मेरै मन्‍नैं किज़ै आसा,</para>
  <para style="q" vid="PSA 139:23">तूह परख मुंह कि हुंह किज़ै सोठा।<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />तूह दै भाल़णीं कि मुंह दी किज़ै खोट किनी आसा,</para>
  <para style="q" vid="PSA 139:24">पर तूह निंऊं मुंह तैहा बाता ज़ेथ सदा लै ज़िन्दगी भेटा।<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">बिधाता का मज़त मांगणा लै अरज़</para>
  <para style="d">गाज़ै-बाज़ै आल़ेए सैणैं लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />हे बिधाता, तूह कर उपद्रभी मणछा का मेरी फाज़त,</para>
  <para style="q" vid="PSA 140:1">इना नर्दैई मणछा का डाह मुंह बच़ाऊई।<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />तिंयां सोठा कबल्‍लअ बूरअ ई,</para>
  <para style="q" vid="PSA 140:2">तिंयां पाआ कबल्‍लअ झ़गल़अ ई।<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />तिन्‍नें ज़िभा आसा शपैल़े दांदा ज़ेही, आपणीं गल्‍ला करै मारा तिंयां होरी दानुईंए बिशा ज़िहै।</para>
  <para style="q" vid="PSA 140:3">तिन्‍नें गल्‍ला हआ शपैल़ै बिशा ज़ेही।<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />हे बिधाता, इना कदुष्ट अर नर्दैई मणछा का डाह मुंह बच़ाऊई,</para>
  <para style="q" vid="PSA 140:4">ईंयां च़ाहा किहअ नां किहअ करै मुंह बरैबाद करनअ।<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />इनै शरेरै मणछै आसा मुल्है फाही डाही दी ढोही,</para>
  <para style="q" vid="PSA 140:5">बाता आसा तिन्‍नैं मुंह ढाकणा लै ज़ज़ाल़ डाहै दै छ़ैई।<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />हे बिधाता, हुंह बोला ताल्है इहअ, “मेरअ परमेशर आसा तूह,</para>
  <para style="q" vid="PSA 140:6">ज़ीबाण मेरी लेर-पकार शुण, मंऐं मांगी ताखा मज़त।”<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />हे परमेशर, मेरै मालक बिधाता, मुंह बच़ाऊंणेओ बल आसा ताखा,</para>
  <para style="q" vid="PSA 140:7">ज़ेभै बी जुध हुअ, तेभै बच़ाऊअ हुंह तंऐं ई।<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />हे बिधाता, ज़िहअ कदुष्ट मणछ च़ाहा,</para>
  <para style="q" vid="PSA 140:8">तेथ निं तिन्‍नां सफल हणैं दैई, नांईं ता तिंयां हणैं होर बी शरेरै।<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />मेरै इना दुशमणा निं ज़ितणैं दैई ज़ुंणी हुंह फेर-फिरदअ गोटी आसा डाहअ द,</para>
  <para style="q" vid="PSA 140:9">ज़ुंण धमकी तिंयां मुल्है दैआ, तिहअ लोल़ी तिन्‍नां ई लै हुअ।<verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />तिन्‍नें मुंडै लोल़ी आगीए ज़ल़दै-ज़ल़दै नार पल़ै,</para>
  <para style="q" vid="PSA 140:10">तिंयां लोल़ी एही डुघी खाल़्ही दी पल़ै ज़ेता का तिंयां उझै निं निखल़ी सके।<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />ज़ुंण होरी लै झ़ुठअ दोश लाआ तिंयां निं सफल लोल़ी हुऐ!</para>
  <para style="q" vid="PSA 140:11">तिंयां कदुष्ट मणछ लोल़ी तिन्‍नां ई ज़िहै उपद्रभी मणछै पठी बरैबाद किऐ।<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />हे बिधाता, मुखा आसा थोघ कि तूह करा</para>
  <para style="q" vid="PSA 140:12">रैनै-गरीबो नसाफ।<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />धर्मीं मणछा करनअ तेरअ शूकर अर ज़ै-ज़ैकार</para>
  <para style="q" vid="PSA 140:13">तिंयां रहणैं ताह संघै।<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">बिधाते मज़त एछणा लै अरज़</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />हे बिधाता, हुंह करा ताखा अरज़, ज़ीबाण, तूह कर मेरी मज़त,</para>
  <para style="q" vid="PSA 141:1">तूह शुण मेरी अरज़।<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />मेरी प्राथणां लोल़ी ताल्है धूपे शोभली बास्सा ज़ेही हुई,</para>
  <para style="q" vid="PSA 141:2">मेरी उडै ताह सेटा बाहा फुआरनी लोल़ी ताल्है नाज़ बल़ी ज़ेही हुई।<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">प्रका. 5:8</ref>; <ref loc="REV 8:3-4">8:3-4</ref>; <ref loc="PRO 3:25">सैणीं. 3:25</ref>; <ref loc="1PE 3:6">1 पत. 3:6</ref></char></note><verse eid="PSA 141:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />हे बिधाता, तूह कर मेरी गल्‍लो पहरअ,</para>
  <para style="q" vid="PSA 141:3">मेरै होठो डाहै हर ज़ैगा तूह ई धैन ज़ेभै हुंह बोले।<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />तूह कर इहअ कि मुंह निं बूरै करने सोर ई लोल़ी आई,</para>
  <para style="q" vid="PSA 141:4">कदुष्ट अर उपद्रभी मणछे संगती का बी डाहै मुंह दूर।</para>
  <para style="q" vid="PSA 141:4">तिन्‍नां संघै निं हुंह रोटी खाणां लै बी साझ़ू लोल़ी हुअ।<verse eid="PSA 141:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />धर्मीं मणछ लागे मुंह नैरदै अर सज़ा दैंदै, तेता करै हणअ मेरअ भलअ ई,</para>
  <para style="q" vid="PSA 141:5">पर कदुष्ट मणछो निं हुंह अदर च़ाहंदअ,</para>
  <para style="q" vid="PSA 141:5">किल्हैकि हुंह रहा तिन्‍नें कदुष्ट कामां लै कबल्‍लअ बिधाता का अरज़ करदअ लागी कि तिंयां छ़ाडे।<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />ज़ांऊं तिन्‍नां दुशमणे सैणैं टोल्हा दी रल़ाकणै,</para>
  <para style="q" vid="PSA 141:6">तेखअ बोल़णअ तिन्‍नां मेरी गल्‍ला लै कि तिंयां आसा शुची।<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />ज़ेही कदाल़ीए पाशै करै बाहै दै खेचे माट्टे ढेल्‍ली फाल़ा,</para>
  <para style="q" vid="PSA 141:7">तिहै ई छाल़ा तिन्‍नें हाडकै घोरी बागै।<verse eid="PSA 141:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />हे परमेशर, मेरै मालक बिधाता हुंह रहा तेरै भरोस्सै,</para>
  <para style="q" vid="PSA 141:8">हुंह लोल़ा तेरी शरण,</para>
  <para style="q" vid="PSA 141:8">तूह निं मुंह मरनै दैई।<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />ज़ुंण ज़ज़ाल़ तिन्‍नैं कदुष्टै मुंह ढाकणा लै आसा छ़ैऐ दै,</para>
  <para style="q" vid="PSA 141:9">अर ज़ुंण फाही मुल्है आसा पाई दी, तेता का बच़ाऊऐ मुंह तूह ई।<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />तिन्‍नें ज़ज़ाल़ा दी लोल़ी तिंयां कदुष्ट आप्पू शाचै अर</para>
  <para style="q" vid="PSA 141:10">हुंह लोल़ी राज्ज़ी-राम्बल़अ निखल़अ बच़ी।<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">सिधअ बिधातो आसरअ</para>
  <para style="d">ज़धू राज़अ दाबेद जुहल़ी त लुक्‍कअ द, तधू बोलअ त तेऊ बिधाता का अरज़ करना लै अह भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />हे बिधाता, हुंह मांगा ताखा मज़त,</para>
  <para style="q" vid="PSA 142:1">हुंह पाआ ताह सेटा लेर-पकार।<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />हुंह खोज़ा आपणीं पठी खरी ताखा,</para>
  <para style="q" vid="PSA 142:2">हुंह खोज़ा ताखा ई कि मुल्है किज़ै-किज़ै आफ़त आसा पल़ी दी।<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />ज़ेभै मुखा छ़ाड़ च़ाल्‍ली छ़ुटी,</para>
  <para style="q" vid="PSA 142:3">तेभै हआ तिधी तूह ई मेरी मज़त करदअ।</para>
  <para style="q" vid="PSA 142:3">ज़हा बाता हुंह डेऊई च़ाल्‍लअ त,</para>
  <para style="q" vid="PSA 142:3">तेथ थिअ मेरै दुशमणै मुल्है खल़ाक्‍की डाही दी ढोही।<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />हुंह लागअ ओर्ही-पोर्ही भाल़अ,</para>
  <para style="q" vid="PSA 142:4">पर मुखा निं तेथ कोहै शुझुअ,</para>
  <para style="q" vid="PSA 142:4">ज़ुंण मुंह बच़ाऊई सके!</para>
  <para style="q" vid="PSA 142:4">मुंह निं कुंण पुछ़णै आल़अ बी भेटअ।<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />हे बिधाता, मंऐं पाई ताह सेटा लेर-पकार कि तूह कर मेरी मज़त,</para>
  <para style="q" vid="PSA 142:5">मुंह बच़ाऊंणै आल़अ आसा तूह ई,</para>
  <para style="q" vid="PSA 142:5">आपणीं ज़िऊंदी ज़िता च़ाहा हुंह सिधअ ताह ई।<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />मेरी लेर-पकार शुण कि हुंह मांगा ताखा मज़त,</para>
  <para style="q" vid="PSA 142:6">मेरी हुई ऐबै खास्सी बूरी दशा,</para>
  <para style="q" vid="PSA 142:6">मुंह बच़ाऊ इना मेरै दुशमणा का!</para>
  <para style="q" vid="PSA 142:6">किल्हैकि मुखा निं इना जोगी ज़ोर आथी।<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />एऊ कैद खानै का काढ मुंह पोर्ही,</para>
  <para style="q" vid="PSA 142:7">तै करनी मुंह तेरै धर्मीं मणछे सभा दी तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 142:7">किल्हैकि तंऐं किई मुल्है खास्सी भलाई।<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">बिधाता का अरज़ ज़ेभै घाटी-घाटी आई</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />हे बिधाता, मेरी अरज़ शुण!</para>
  <para style="q" vid="PSA 143:1">तूह आसा शुचअ अर धर्मीं,</para>
  <para style="q" vid="PSA 143:1">तूह शुण मेरी लेर-पकार।<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />हुंह करा तेरी ई च़ाकरी, मुंह परखदअ निं लागी,</para>
  <para style="q" vid="PSA 143:2">किल्हैकि सोभी मणछा दी आसा किज़ै नां किज़ै खोट ज़रूर।<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">रोम. 3:20</ref>; <ref loc="1CO 4:4">1 करि. 4:4</ref>; <ref loc="GAL 2:16">गल. 2:16</ref></char></note><verse eid="PSA 143:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />मेरै दुशमण आसा मुंह मारना लै पिछ़ू पल़ै दै,</para>
  <para style="q" vid="PSA 143:3">तिन्‍नैं आणअ हुंह पठी छेऊई।</para>
  <para style="q" vid="PSA 143:3">तिन्‍नैं आसा हुंह नटिप्प न्हैरै दी कैद किअ द,</para>
  <para style="q" vid="PSA 143:3">मेरी हालत आसा मूंऐं दै मणछा ज़ेही हुई दी।<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />ऐबै छ़ुटी मुखा छ़ाड़,</para>
  <para style="q" vid="PSA 143:4">मंऐं हेरअ ऐबै हैअ चोल़ी।<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />मुंह फिरा पराणअ ज़मानअ आद,</para>
  <para style="q" vid="PSA 143:5">हुंह करा तेरै तिन्‍नां महान कामें बारै बच़ार,</para>
  <para style="q" vid="PSA 143:5">तंऐं किऐ दै तिन्‍नां नुआहरै कामें बारै रहा हुंह सोठदअ लागी।<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />हुंह करा उझै ताह बाखा बाहा फुआरी अरज़,</para>
  <para style="q" vid="PSA 143:6">हुंह आसा ताल्है पाणीं बाझ़ी शुक्‍की ज़िम्मीं ज़िहअ नचिशअ।<verse eid="PSA 143:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />हे बिधाता, ज़ीबाण, तूह शुण ऐबै मेरी पकार!</para>
  <para style="q" vid="PSA 143:7">मंऐं हेरअ हैअ चोल़ी।</para>
  <para style="q" vid="PSA 143:7">तूह निं मुंह बाखा पिठ फरेऊई,</para>
  <para style="q" vid="PSA 143:7">नांईं ता हुंह हणअ घोरी दाबै दै मूंऐं दै मणछा ज़िहअ।<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />धैल़ लोल़ी मुंह दोत्ती तेरी अटल़ झ़ूरी आद फिरी,</para>
  <para style="q" vid="PSA 143:8">किल्हैकि हुंह रहा तेरै आसरै।</para>
  <para style="q" vid="PSA 143:8">हुंह सभाल़ा आपणीं सोभै गल्‍ला ताखा,</para>
  <para style="q" vid="PSA 143:8">तूह खोज़ मुखा आप्पै कि हुंह कैहा बाता हांढूं।<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />हे बिधाता, मंऐं आसा ताह सेटा शरण लई दी।</para>
  <para style="q" vid="PSA 143:9">ज़ीबाण, तूह बच़ाऊ मुंह मेरै दुशमणा का।<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />मेरअ परमेशर आसा तूह,</para>
  <para style="q" vid="PSA 143:10">ज़ुंण तूह च़ाह कि हुंह करूं, तैहा गल्‍ला खोज़ मुखा,</para>
  <para style="q" vid="PSA 143:10">तूह लोल़ी मुल्है भलअ रहअ अर तूह नढैऊ मुंह राम्बल़ी बाता।<verse eid="PSA 143:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />हे बिधाता, तूह डाह मेरी ज़िन्दगी बच़ाऊई, ज़ेही तेरी ज़बान शुची हआ,</para>
  <para style="q" vid="PSA 143:11">किल्हैकि तेरै सत्ता करै जाणअ हुंह आफ़ता का बच़ी।<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />हुंह आसा तेरअ दास, मेरै दुशमण</para>
  <para style="q" vid="PSA 143:12">ज़ुंणी हुंह हंती-हंती छेऊई आणअ, तिन्‍नां कर पठी बरैबाद</para>
  <para style="q" vid="PSA 143:12">ताकि थोघ लागे कि तूह झ़ूरा मुल्है खास्सअ।<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">ज़ीत दैणा लै बिधातो शूकर</para>
  <para style="d">राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />बिधाते ज़ै-ज़ैकार, ज़ुंण मुल्है शरण लणें बडी टोल्हा ज़िहअ आसा!</para>
  <para style="q" vid="PSA 144:1">सह शखैल़ा मुखा जुध-बिद्या अर</para>
  <para style="q" vid="PSA 144:1">जुध ज़ितणें कला।<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />सह आसा मुल्है झींण अर मेरी फाज़त करनै आल़अ,</para>
  <para style="q" vid="PSA 144:2">सह आसा मुंह बच़ाऊंणै आल़अ अर मेरअ आसरअ,</para>
  <para style="q" vid="PSA 144:2">राज्ज़ी-राम्बल़अ आसा हुंह तेऊए ई भरोस्सै,</para>
  <para style="q" vid="PSA 144:2">सह दैआ देशा-देशे लोगा मेरै बशै करी।<verse eid="PSA 144:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />हे बिधाता, मणछ किज़ै आसा कि तूह तिन्‍नां लै धैन दैए?</para>
  <para style="q" vid="PSA 144:3">तूह किल्है डाहा मणछो एतरअ धैन-खैल?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />मणछ आसा बागरीए झ़लारै ज़िहै,</para>
  <para style="q" vid="PSA 144:4">तिन्‍नें ज़िन्दगी आसा उडदी छ़ैल्‍ली ज़ेही।<verse eid="PSA 144:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />हे बिधाता, सरगा खोल्ह पल्दै ज़िहै धेल़ी करै ओर्ही-पोर्ही, संघा होथ उंधै,</para>
  <para style="q" vid="PSA 144:5">उछ़टी-उछ़टी धारा छ़ुंह भाल़ै! तिंयां उडणी धूँआं ज़ेही।<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />सरगा का छ़ाड बीज कतीरा ज़ेही, संघा पतिंग तेरै दुशमणा ओर्ही-पोर्ही,</para>
  <para style="q" vid="PSA 144:6">तिंयां लोल़ी डरै सातै-बातै ठुर्है।<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />स्वर्गा का आपणीं बाह</para>
  <para style="q" vid="PSA 144:7">डुघै समुंदरै पजैल़ी काढ मुंह उझै संघा बच़ाऊ मुंह,</para>
  <para style="q" vid="PSA 144:7">हुंह आसा परदेसी लोगे बशै पल़अ द, तूह छ़ड़ैऊ मुंह इना का।<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />ईंयां निं कधू शुचअ बोल्दै ई अर</para>
  <para style="q" vid="PSA 144:8">तिंयां बोलअ सोह खाई झ़ुठअ।<verse eid="PSA 144:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />मुंह बोल़णीं तेरी ज़ै-ज़ैकार करना लै नऊंईं गिह,</para>
  <para style="q" vid="PSA 144:9">मुंह बोल़णीं ताल्है दस तारा आल़अ बाज़अ बाज़ी करै गिह।<note caller="-" style="x"><char style="xo" closed="false">144:9 </char><char style="xt" closed="false"><ref loc="REV 5:9">प्रका. 5:9</ref>; <ref loc="REV 14:3">14:3</ref></char></note><verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />राज़ै लै ज़ीत दैआ तूह ई,</para>
  <para style="q" vid="PSA 144:10">आपणैं दास दाबेदा बच़ाऊआ मारनै आल़ी तलबारा का तूह ई।<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />हे बिधाता, मेरै नर्दैई दुशमणा का बच़ाऊ मुंह,</para>
  <para style="q" vid="PSA 144:11">हुंह आसा परदेसी लोगे बशै पल़अ द, तूह छ़ड़ैऊ मुंह इना का,</para>
  <para style="q" vid="PSA 144:11">ईंयां निं कधू शुचअ बोल्दै ई अर</para>
  <para style="q" vid="PSA 144:11">तिंयां बोला सोह खाई झ़ुठअ।<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />म्हारै शोहरू लोल़ी तै खारकी अमरा</para>
  <para style="q" vid="PSA 144:12">हरी-भरी बुटी ज़िहै बझ़ै।</para>
  <para style="q" vid="PSA 144:12">म्हारी शोहरी लोल़ी ती तिन्‍नां पाक्‍कै थाम्हा ज़ेही हुई</para>
  <para style="q" vid="PSA 144:12">ज़ुंण राज़े मैहलै कणोडै दी लागणै।<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />म्हारी कठैरी लोल़ी ती</para>
  <para style="q" vid="PSA 144:13">भांती-भांतीए नाज़ा करै सदा भरी रही।</para>
  <para style="q" vid="PSA 144:13">म्हारी भेडा-बाकरीए हेल़्ही लोल़ी ती एही सल्‍ली कि</para>
  <para style="q" vid="PSA 144:13">तिन्‍नां का लोल़ी तै हज़ारो चैणैं हुऐ।<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />म्हारै डागै ज़ेभै बी धअण लअ,</para>
  <para style="q" vid="PSA 144:14">एक गाअ बी निं लोल़ी चूई,</para>
  <para style="q" vid="PSA 144:14">म्हारै घअरै अर नगरी निं लोल़ी त दुख शोग पल़अ।<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />सह देश भाल़ किहअ खुश हणअ ज़ेथ ईंयां सोभै गल्‍ला पूरी हणीं,</para>
  <para style="q" vid="PSA 144:15">तिन्‍नां मणछा लै आसा खास्सी बर्गत ज़ुंण बिधाता मना!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">बिधाता आसा खास्सअ झणैल़ू</para>
  <para style="d">बिधाते ज़ै-ज़ैकार करना लै राज़ै दाबेदो भज़न</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />हे बिधाता, मुंह करनी सोभी सेटा तेरी बड़ैई,</para>
  <para style="q" vid="PSA 145:1">मुंह रहणअ कबल्‍लै तेरअ शूकर करदै लागी।<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />धैल़ करनअ मुंह तेरअ शूकर,</para>
  <para style="q" vid="PSA 145:2">मुंह रहणअ सदा तेरी ज़ै-ज़ैकार करदै लागी।<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />तूह बिधाता आसा महान अर तूह ई आसा बड़ैई करनै जोगी।</para>
  <para style="q" vid="PSA 145:3">ज़ेतरअ हाम्हैं सोठी सका, तूह आसा तेता का बी खास्सअ महान।<verse eid="PSA 145:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />ज़ुंण महान काम तंऐं किऐ, तेते बड़ैई रहणीं पोस्ती दर पोस्ती हंदी लागी,</para>
  <para style="q" vid="PSA 145:4">तिन्‍नां खोज़णअ तेरै महान कामें बारै सोभी का।<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />तिन्‍नां खोज़णअ कि तूह किहअ महान अर ताखा किहअ प्रतप्प आसा,</para>
  <para style="q" vid="PSA 145:5">मुंह डाहणअ तेरै महान कामां दी आपणअ धैन-मन्‍न लाई।<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />लोगा जैंदरी हणीं तेरै महान कामें बारै गल्‍ला लागी दी,</para>
  <para style="q" vid="PSA 145:6">अर मुंह खोज़णअ तेरै बडै-बडै महान कामें बारै सोभी का।<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />लोगा करनी तेरी महान भलाईए बारै गल्‍ला अर</para>
  <para style="q" vid="PSA 145:7">मुंह खोज़णअ गिह गांठी कि तूह किहअ झणैल़ू आसा।<verse eid="PSA 145:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />तूह बिधाता आसा झ़ूरनै आल़अ अर झणैल़ू,</para>
  <para style="q" vid="PSA 145:8">ताह निं धखी का रोश्शै एछदी अर तूह करा खास्सी झींण।<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />तूह आसा सोभी लै भलअ अर</para>
  <para style="q" vid="PSA 145:9">तेरी झींण आसा पृथूईए सोभी ज़ीबा लै।<verse eid="PSA 145:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />हे बिधाता, सोभी ज़ीबा करनी तेरी ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 145:10">अर सोभी लोगा करनअ तेरअ शूकर।<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />लोगा करनी एही गल्‍ला कि तेरअ राज़ किहअ महान आसा,</para>
  <para style="q" vid="PSA 145:11">अर ताखा किहअ महान बल आसा,<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />ताकि तेरै महान कामें बारै सोभी मणछा का थोघ लागे अर</para>
  <para style="q" vid="PSA 145:12">तेरअ महान राज़ अर तेतो प्रतप्प सोभी लै प्रगट होए।<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />तेरअ बधान आसा अटल़ अर</para>
  <para style="q" vid="PSA 145:13">तूह आसा सदा लै राज़अ।</para>
  <para style="q" vid="PSA 145:13">तूह निं आपणीं ज़बानी का कधि हुधदअ,</para>
  <para style="q" vid="PSA 145:13">ज़िहअ तूह बोला, तूह करा तिहअ ई।<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />ज़हा खरी हुई पल़ी दी तेऊए करा तूह बिधाता ई मज़त,</para>
  <para style="q" vid="PSA 145:14">ज़ुंण ठोहल़ लागी धरनीं बधल़ुअ, तेऊ झ़ैऊआ तूह हाथा ढाकी खल़ै।<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />सोभै ज़िऊंदै ज़ीब रहा तेरै आसरै,</para>
  <para style="q" vid="PSA 145:15">ज़ेभै ज़रुरत हुई तेभै दैआ तूह तिन्‍नां सोभी लै खाणअ-पिणअ।<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />तूह दैआ तिन्‍नां लै खुल्है हाथै कि</para>
  <para style="q" vid="PSA 145:16">सोभै ज़ीब ज़ेतरअ लोल़ी तेतरअ रज्ज़ी खाए।<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />हे बिधाता, तूह आसा तेरै सोभी कामां लै धर्मीं,</para>
  <para style="q" vid="PSA 145:17">अर तेरै सोभी कामां दी हआ खास्सी झींण।<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />ज़ुंण शुचै दिलै ताह सेटा अरज़ करा,</para>
  <para style="q" vid="PSA 145:18">तूह रहा आप्पू तिन्‍नां नेल़।<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />ज़ुंण तेरअ अदर करा, तिन्‍नां लै निं तूह किछ़ू गल्‍ले निऊल़ डाहंदअ,</para>
  <para style="q" vid="PSA 145:19">तूह हेरा तिन्‍नें लेर-पकार शूणीं अर तिन्‍नां बच़ाऊई।<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />ज़ुंण ताल्है झ़ूरा, तिन्‍नें करा तूह फाज़त,</para>
  <para style="q" vid="PSA 145:20">पर कदुष्ट मणछा करा तूह पठी बरैबाद।<verse eid="PSA 145:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />मुंह करनी कबल्‍ली बिधाते ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 145:21">सोभै ज़िऊंदै ज़ीब करा बिधाते पबित्र नाओंए जुगै-जुगै तैणीं ज़ै-ज़ैकार।<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">बिधातो नसाफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />बिधाते ज़ै-ज़ैकार करा,</para>
  <para style="q" vid="PSA 146:1">ए मेरै मन्‍नां, बिधाते ज़ै-ज़ैकार<note caller="+" style="f"><char style="fr" closed="false">146:1 </char><char style="fq" closed="false">ज़ै-ज़ैकार </char><char style="ft" closed="false">हाल्‍लेलुयाह</char></note> कर।<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />आपणीं ज़िऊंदी ज़िता रहणअ मुंह तेऊए ज़ै-ज़ैकार करदै लागी,</para>
  <para style="q" vid="PSA 146:2">सारी ज़िन्दगी रहणअ मुंह गिहा बोली तेऊए ज़ै-ज़ैकार करदै लागी।<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />बलबान मणछे आसरै निं रहणअ,</para>
  <para style="q" vid="PSA 146:3">मणछा मांझ़ै निं कोहै तम्हां बच़ाऊई सकदअ।<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />तिंयां बी मरा एकी धैल़ै पोर्ही संघा डेओआ माट्टै जैंदरी फिरी,</para>
  <para style="q" vid="PSA 146:4">तेभै हआ तिन्‍नें सारी सोठ अर बिक्री खतम।<verse eid="PSA 146:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />तिन्‍नां मणछा लै भाल़ केही बर्गत हणीं ज़सरी मज़त याकबो परमेशर करा</para>
  <para style="q" vid="PSA 146:5">अर ज़ुंण परमेशर बिधाते आसरै रहा।<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />स्वर्ग, पृथूई, समुंदर अर</para>
  <para style="q" vid="PSA 146:6">तेते सोभी गल्‍ला बणाणैं आल़अ आसा सह ई परमेशर।</para>
  <para style="q" vid="PSA 146:6">सह ज़ुंण ज़बाब दैआ, सह हआ अटल़।<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />सह करा हारै-मारै दै मणछो नसाफ अर</para>
  <para style="q" vid="PSA 146:7">भुखै रज़ैऊआ सह रोटी दैई।</para>
  <para style="q" vid="PSA 146:7">ज़ुंण कैद आसा किऐ दै, बिधाता करा तिन्‍नां आज़ाद,<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />सह दैआ कांणै लै आछी कि तिन्‍नां का शुझिए।</para>
  <para style="q" vid="PSA 146:8">ज़ुंण ठोहल़ लागी धरनीं पल़ै तिन्‍नां करा सह हाथा ढाकी आज़रै खल़ै,</para>
  <para style="q" vid="PSA 146:8">सह झ़ूरा धर्मीं मणछा लै।<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />सह करा थारै देशै रहणैं आल़ै पाखलै मणछे बी फाज़त,</para>
  <para style="q" vid="PSA 146:9">बिधबा अर छ़ुटै-मुक्‍कै दै लान्हें करा सह आप्पै मज़त,</para>
  <para style="q" vid="PSA 146:9">पर कदुष्ट मणछा करा सह पठी बरैबाद।<verse eid="PSA 146:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />बिधाता आसा सदा लै राज़अ,</para>
  <para style="q" vid="PSA 146:10">ओ सियोन, थारै परमेशरा करनअ जुगै-जुगै तैणीं सदा राज़।</para>
  <para style="q" vid="PSA 146:10">बिधाते करा ज़ै-ज़ैकार।<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">गिहा बोली करा बिधाते ज़ै-ज़ैकार</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />बिधाते ज़ै-ज़ैकार करा!</para>
  <para style="q" vid="PSA 147:1">परमेशरे गिहा बोली ज़ै-ज़ैकार दैआ शोभा,</para>
  <para style="q" vid="PSA 147:1">तेऊए बड़ैई करनी हआ भली अर खुशीए गल्‍ल।<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />बिधाता बसाऊंणी एरुशलेम नगरी भिई,</para>
  <para style="q" vid="PSA 147:2">तेऊ पजैल़णैं इज़राईली देशा-देशा का झाल़ी बापस तिन्‍नें घअरै।<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />बिधाता करा दुखी दिला आल़ै नरोगै,</para>
  <para style="q" vid="PSA 147:3">सह करा तिन्‍नें देहीए ज़खमा दी मल्हम लाई नरोगै।<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />तेऊ आसा सरगे तारै बी गणी करै डाहै दै,</para>
  <para style="q" vid="PSA 147:4">तेऊ आसा तिन्‍नां सोभिओ ज़ुदअ-ज़ुदअ नाअं डाहअ द।<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />म्हारअ बिधाता आसा महान अर तेऊ का आसा सारअ बल,</para>
  <para style="q" vid="PSA 147:5">तेऊए महान समझ़ निं कुंण नापी सकदअ।<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />सह दैआ भोल़ै मणछा लै आसरअ,</para>
  <para style="q" vid="PSA 147:6">पर कदुष्ट मणछा झेचा सह धरनीं।<verse eid="PSA 147:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />तेऊओ शूकर करदी बोला तेऊए गिह,</para>
  <para style="q" vid="PSA 147:7">तारा आल़ै बाज़ै बाज़दी करा तेऊओ भज़न।<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />सह आणा सारै सरगै बादल़,</para>
  <para style="q" vid="PSA 147:8">संघा दैआ पृथूई लै सरग हणैं</para>
  <para style="q" vid="PSA 147:8">ताकि धारा बणैं-बूटै घाह बझ़े।<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />बणें ज़ीबा लै दैआ सह बिधाता ई खाणअ,</para>
  <para style="q" vid="PSA 147:9">काऊड़ै बच़ै ज़ांऊं भुखै बाशदै लागा, तिन्‍नां लै खाण-पींण दैआ सह ई।<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />बिधाता नां बलबान घोल़ै अर</para>
  <para style="q" vid="PSA 147:10">नां मणछे बडी सैने परबाह करदअ,<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />पर बिधाता रहा तिन्‍नां लै राज्ज़ी ज़ुंण तेऊओ अदर करा अर</para>
  <para style="q" vid="PSA 147:11">तेऊए अटल़ झ़ूरी दी भरोस्सअ डाहा।<verse eid="PSA 147:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />एरुशलेम रहणैं आल़ै करा सोभै!</para>
  <para style="q" vid="PSA 147:12">आपणैं परमेशर बिधाते ज़ै-ज़ैकार!<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />सह डाहा थारी नगरीए प्रऊल़ी पाक्‍की,</para>
  <para style="q" vid="PSA 147:13">सह दैआ थारी लुआदा लै बर्गत।<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />सह करा थारै देशे सिअंए फाज़त,</para>
  <para style="q" vid="PSA 147:14">सह रज़ैऊआ तम्हां सोभी का बधिया कणके रोटी करै।<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />सह दैआ पृथूई लै हुकम,</para>
  <para style="q" vid="PSA 147:15">ज़िहअ बिधाता बोला सह हआ हेरा-हेरी तिहअ ई।<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />सह फुआरा हिंअं शेती ऊने दोहल़ू ज़िहअ,</para>
  <para style="q" vid="PSA 147:16">ओश छिंगा सह छ़ारा ज़ेही।<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />सरगा का शोटा सह हिंअं शेती ऊने फुफू ज़िहै,</para>
  <para style="q" vid="PSA 147:17">ज़ुंण शेल़अ-ठांढअ सह दैआ, तेता निं कुंण ज़िरी सकदै।<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />बिधाता दैआ हुकम संघा लागा हिंअं गल़दअ,</para>
  <para style="q" vid="PSA 147:18">सह छ़ाडा पऊंण संघा लागा पाणीं बगदअ।<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />सह दैआ आपणीं परज़ा याकबे आद-लुआदा लै समाद,</para>
  <para style="q" vid="PSA 147:19">तेऊ दैनअ आपणीं परज़ा इज़राईली लै बिधी अर बधान।<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />इहअ निं तेऊ होरी कोही देशा लै किअ,</para>
  <para style="q" vid="PSA 147:20">तिन्‍नां का निं तेऊए बधानो थोघ ई आथी!</para>
  <para style="q" vid="PSA 147:20">बिधाते करा ज़ै-ज़ैकार।<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">सोभै करा बिधाते ज़ै-ज़ैकार</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />बिधाते ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 148:1">स्वर्गै करा बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:1">सोभै करा बिधाते ज़ै-ज़ैकार ज़ुंण उझै उछ़टै दी रहा।<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />बिधाते सोभै स्वर्गे दूत करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:2">स्वर्गे सारी सैना करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />सुरज़ अर ज़ोथ करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:3">सरगै च़मकदै तारै बी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />सारअ भ्रमंड अर तेते सरगा प्रैंदै पाणीं करा</para>
  <para style="q" vid="PSA 148:4">दुहै गल्‍ला बिधाते ज़ै-ज़ैकार।<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />भ्रमंडे सोभै गल्‍ला करा बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:5">किल्हैकि तिंयां आसा तेऊए हुकमा करै बणी दी।<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />तेऊ किअ तिन्‍नां लै हुकम अर तिंयां सोभै गल्‍ला आसा डाही दी सदा तिन्‍नें ज़ैगा टकैल़ी,</para>
  <para style="q" vid="PSA 148:6">तिन्‍नां लै आसा इहअ बधान दैनअ द, तेता का निं तिंयां ओर्ही-पोर्ही सिक्‍कदी।<verse eid="PSA 148:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />पृथूईए सोभै गल्‍ला करा बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:7">समुंदरे बडै-बडै ज़ीब अर समुंदरे थाल्‍लै रहणैं आल़ै होर ज़ीब,<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />सरगै बीज, शरू, हिंअं, बादल़ अर धूँईं,</para>
  <para style="q" vid="PSA 148:8">पऊंण ज़ुंण बिधातो हुकम मना!<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />बडै-बडै पर्बत, धारा-धारठी,</para>
  <para style="q" vid="PSA 148:9">फल़ा दैणैं आल़ै बूट, बडी-बडी केल़ुई!<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />घअरे डागै-धअण अर बणें ज़ीब,</para>
  <para style="q" vid="PSA 148:10">लरुगी करै हांढणै-फिरनैं आल़ै ज़ीब अर च़ेल्‍लू-पखीरू!<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />पृथूई दै ज़ैगै-ज़ैगै राज़ै अर तिन्‍नें सोभै परज़ा करा बिधाते ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 148:11">सोभै सैणैं अर नसाफ करनै आल़ै पांच़!<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />खारकै मर्ध अर बेटल़ी,</para>
  <para style="q" vid="PSA 148:12">लान्हैं अर प्रोढै बी!<verse eid="PSA 148:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />सोभी लोल़ी बिधाते ज़ै-ज़ैकार किई।</para>
  <para style="q" vid="PSA 148:13">तेऊओ नाअं आसा सोभी का बडअ अर महान!</para>
  <para style="q" vid="PSA 148:13">तेऊओ प्रतप्प आसा सारी पृथूई अर स्वर्गै।<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />तेऊ बणाईं आपणीं परज़ा बलबान,</para>
  <para style="q" vid="PSA 148:14">ताकि तेऊए सह आपणीं परज़ा ज़ै-ज़ैकार करे,</para>
  <para style="q" vid="PSA 148:14">इज़राईली मणछ आसा तेऊए खास्सै पैरै।</para>
  <para style="q" vid="PSA 148:14">सोभै करा बिधाते ज़ै-ज़ैकार।<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">ज़ै-ज़ैकारे गिह</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />सोभै करा बिधाते ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 149:1">तेऊए बड़ैई करना लै बोला नऊंईं गिह,</para>
  <para style="q" vid="PSA 149:1">धर्मीं मणछे सभा दी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />इज़राईलीओ, खुश हआ, सह आसा तम्हां बणाणैं आल़अ परमेशर,</para>
  <para style="q" vid="PSA 149:2">सियोन नगरी बस्सै दै लोगो खुश हआ, सह आसा थारअ राज़अ।<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />इज़राईलीओ, नाच़दी-खेल्हदी करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 149:3">गुज़ै-बाज़ै संघै बोला नाट पाई तेऊए गिहा।<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />बिधाता हआ आपणीं परज़ा लै राज्ज़ी,</para>
  <para style="q" vid="PSA 149:4">भोल़ै मणछा लै ज़ीत दैई बढेरा सह तिन्‍नें शोभा।<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />बिधाते परज़ा लोल़ी खास्सै खुशी हुऐ कि बिधाता दैनी तिन्‍नां लै ज़ीत,</para>
  <para style="q" vid="PSA 149:5">तिंयां लोल़ी च़ैनैं सुत्ती करै बी ज़ै-ज़ैकारे गिहा बोल्दै रहै लागी।<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />तिन्‍नें लोल़ी ज़ोरै-ज़ोरै परमेशरे ज़ै-ज़ैकार किई,</para>
  <para style="q" vid="PSA 149:6">अर हाथै लोल़ी तिन्‍नैं दोहरी बाखा तिछी तलबारा हुई ढाकी दी,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />ताकि तिंयां देशा देशे लोगा का बदल़अ लई सके</para>
  <para style="q" vid="PSA 149:7">संघा तिन्‍नां लै सज़ा दैई सके अर<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />तिन्‍नें राज़ै अर तिन्‍नें सैणैं</para>
  <para style="q" vid="PSA 149:8">शांघल़ी लोहै दी बान्हीं डाहे।<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />तेखअ करनअ तिन्‍नां लै सज़ा दैई नसाफ ज़िहअ बिधाता बोलअ द आसा।</para>
  <para style="q" vid="PSA 149:9">अह हणीं बिधाते आपणीं परज़े ज़ीत।</para>
  <para style="q" vid="PSA 149:9">सोभै करा बिधाते ज़ै-ज़ैकार।<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">बिधाता आसा आपणीं परज़ा लै भलअ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />सोभै करा परमेशर बिधाते ज़ै-ज़ैकार।</para>
  <para style="q" vid="PSA 150:1">तेऊए पबित्र ज़ैगा करा तेऊए ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 150:1">स्वर्ग करा तेऊए ज़ै-ज़ैकार ज़ेथ तेऊओ महान बल आसा।<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />बिधाता ज़ुंण महान काम किऐ, तेता लै करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 150:2">तेऊए ज़ेतरी बी बड़ैई करे सह आसा थोल़ी, तेऊए करा ज़ै-ज़ैकार।<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />नर्शिंगै बाज़दी करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 150:3">बींन अर तारा आल़ै बाज़ै बाज़ी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />गुज़ै-बाज़ै संघै करा नाट पाई तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 150:4">बशूरी अर सरनाई बाज़ी करा तेऊए ज़ै-ज़ैकार।<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />डफाला अर छ़छ़ाल़ा बाज़ी करा तेऊए ज़ै-ज़ैकार,</para>
  <para style="q" vid="PSA 150:5">ज़ेते छ़ेल़ ज़ोरै शुण्हिंआं।<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />सोभै ज़िऊंदै ज़ीब करा तेऊए ज़ै-ज़ैकार!</para>
  <para style="q" vid="PSA 150:6">बिधाते करा सोभै ज़ै-ज़ैकार!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>