  <para style="h">एस्तेर</para>
  <para style="toc1">यहूदी शोहरी एस्तेर फारस देशे राणीं</para>
  <para style="toc2">एस्तेर</para>
  <para style="toc3">एस.</para>
  <para style="mt1">एस्तेर</para>
  <para style="mt2">यहूदी शोहरी एस्तेर फारस देशे राणीं</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: पाखलअ यहूदी मणछ</para>
  <para style="ili">सन: 464 का 331 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: यहूदी</para>
  <para style="ip">ऐहा कताबा दी आसा एक यहूदी शोहरी एस्तेरे बारै कि बिधाते हुणाकार हुई एही कि सह बणी फारस देशे राणीं। तैहा बच़ाऊऐ आपणीं अक्ली करै यहूदी ज़ुंण पठी मारी खतम तै लाऐ दै करी। दुजअ मणछ आसा ऐहा कताबा दी एस्तेर राणींओ भाई मुर्दकाई ज़ुंण तेसे च़ाच़ूओ शोहरू थिअ।</para>
  <para style="ip">क्षयर्ष फारसी राज़ैओ प्रधान मंत्री च़ाहा त फारसी राज़ा यहूदी पठी मारी खतम करनअ, सह च़ाल पाई एस्तेर अर मुर्दकाई उंबल़ी तेऊ ई प्रैंदै। तेते बारै खोज़ा अह कताब कि यहूदी मांझ़ै पूरीम थैरे शुरूआत किहअ करै हुई।</para>
  <para style="ip">आपणैं दुशमणा का ज़ितणैं बाद लिखी मुर्दकाई अर एस्तेर राणीं फारसी राज़ा दी सोभी देशै अर मुल्खै रहणैं आल़ै यहूदी लै च़िठी कि ऐहा गल्‍ला डाहै आद कि हाम्हैं बिधाता किहै बच़ाऊऐ अर च़ौदा-पंद्रा फागणै लऐ पूरीम थैर मनाऊंईं। एही निं ऐहा कताबा दी परमेशरे बारै किछ़ आथी लिखअ द, पर इना सारी गल्‍ला का लागा इहअ थोघ कि परमेशरै त आपणीं परज़ा बच़ाऊंणेओ इंतज़ाम करी डाहअ द, तैही बणी एस्तेर फारस देशे राणीं अर मुर्दकाई बी बोलअ खिरी इहअ:</para>
  <para style="imq">“कुंण ज़ाणें कि तूह ऐहा ई खरीए घल़ी लै आसा होए माहा राणीं बणी दी!”</para>
  <para style="ipr">(4:14)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">एस्तेर बणी फारस देशै माहा राणीं 1:1—2:23</para>
  <para style="io1">यहूदी लै पल़ी घोर आफ़त 3:1-15</para>
  <para style="io1">राणीं एस्तेर अर मुर्दकाईए काम 4:1—5:14</para>
  <para style="io1">यहूदीओ छ़ुटकारअ 6:1—10:3</para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">बशती काढी माहा राणींए पदबी का पोर्ही</para>
  <para style="p">
    <verse number="1-2" style="v" sid="EST 1:1-2" />फारसी राज़अ क्षयर्ष रहा त आपणीं राज़धानी शुआ नगरी। तिधा का करा त सह भारत देशा पोर्ही कूश देशा तैणीं एक शौ सताई मुल्खा प्रैंदै राज़।<verse eid="EST 1:1-2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3" />तेऊ दैनी आपणैं राज़ा दी चिऊथी साला आपणैं सोभी कार-करिंदै अर दरोगै लै धाम। तेथ थिऐ सोभी मुल्खे राज़पाल अर सोभी मुल्खे सैणैं आऐ दै ज़ुंण तेऊए कबज़ै दी थिऐ। फारस देशे सैनापति अर मादी देशे सैनापति बी थिऐ तिधी आऐ दै। <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />सह रहअ छ़हा भिन्‍नैं तैणीं तिन्‍नां का राज़ भबने शोभा-शान रहैऊंदअ लागी। तेऊ किअ प्राहुंणैं लै खास्सअ खर्च़ कि तिन्‍नां सोभी का ज़ाण्हिंए कि तेऊओ राज़ किहअ महान आसा।<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />तेता बाद दैनी तेऊ राज़धानी शुआ नगरीए सोभी आम परज़ा सेठ अर गरीब सोभी लै धाम। लोग रहै साता धैल़ी तैणीं राज़े मैहलै खोल़ै बागा दी खांदै-पिंदै लागी। <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />राज़े मैहलै तैहा ताटी तै फेर-फिरदै निलै अर शेतै पल्दै लाऐ दै, तिंयां थिऐ बैंज़णीं रांगे बाछे डोरी दी च़ंदीए झ़ुंफ लाई संगमरमरे थाम्हा दी बान्हैं दै। खोल़ै ती धरनीं सुन्‍नैं अर च़ंदीए च़ौकी डाही दी। सारी ताटी ती लाल, काल़ै, शेतै, लाल अर पिंऊंल़ै संगमरमरे तल़ाथरा करै तल़अ द। <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />प्राहुणैं लै थिऐ झुटणा लै सुन्‍नें गलास अर तिन्‍नां गलासा दी थिई होरी-होरी रंगे खेल़्तरा। राज़ै पणैऊंईं सोभी का ज़ेतरअ दिल बोलअ तेतरी दाखे रसे शराब। <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />राज़ै त आपणैं राज़ दरबारै च़ाकरी करनै आल़ै लै हुकम डाहअ द करी कि प्राहुंणैं लै दैऐ ज़ेतरअ तिन्‍नों दिल बोले तेतरअ दाखो रसो शराब।<verse eid="EST 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9" />मर्ध ज़ण्हैं तै बागै मौज़ करदै लागै दै अर माहा राणीं बशती ती सोभी बेटल़ी लै क्षयर्ष राज़े मैहला भितरी धामा लाई दी।<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />सातुऐ धैल़ै हुअ इहअ कि राज़अ क्षयर्ष त दाखे शराबा झुटदअ मगन हुअ द, तेऊ शादै आपणैं गुंझी दासा मांझ़ै सात ज़ण्हैं ज़ुंण तेऊए खास च़ाकरी करनै आल़ै थिऐ, मेहुमान, बिजता, हरबोना, बिगथा, अबगथा, जथार अर कर्कास। <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />तेऊ किअ तिन्‍नां लै हुकम कि राणीं बशती आणा ओर्ही शादी। राज़अ च़ाहा त इहअ कि सह माहा राणींओ मुगट बान्हीं तैर्हुई करै एछे ताकि तेऊए कार-करिंदै अर सोभ प्राहुंणैं तैहा भाल़े कि सह हेरनी केही बित्ती आसा। <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />पर ज़ांऊं तिन्‍नैं राणीं बशती का खोज़अ कि राज़ै किअ इहअ हुकम, तैहा किअ एछणा लै नांईं अर एता लै आई राज़ै खास्सी रोश्शै।<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13-14" style="v" sid="EST 1:13-14" />राज़ै शादै फारस अर मादी देशे खास-खास आपणैं सात सलाहकार ज़ुंण बडी पदबी दी आसा तै। तिंयां थिऐ करशेना, शेतेर, अदमाथा, तरशीश, मेरेस, मरसेना अर मेमूसेन। ईंयां तै खास्सै अक्ली आल़ै अर इना का हआ त देशे बधान अर सोभी रिती-रबाज़ो थोघ। राज़अ करा त हर मामलै लै इना का सलाह लई। <verse eid="EST 1:13-14" /><verse number="15" style="v" sid="EST 1:15" />राज़ै बोलअ तिन्‍नां लै, “मंऐं क्षयर्ष राज़ै छ़ाडै आपणैं दास राणीं बशती सेटा लै हुकम दैई कि सह मुंह सेटा लै एछे, पर तैहा किअ एछणा लै नांईं! एते बारै बधाना दी किज़ै आसा लिखअ द? एता लै हुंह तैहा लै किज़ै सका करी?”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />मेमूसेनै बोलअ राज़ै अर होरी कार-करिंदै लै इहअ, “राज़ैओ हुकम नांईं मनी निं माहा राणीं बशती सिधअ राज़अ नकदरअ समझ़अ! अह आसा हाम्हां सोभी कार करिंदै अर देशा-देशे सोभी लोगे बेइज़ती ज़ेथ क्षयर्ष राज़ैओ राज़ आसा! <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />ज़ांऊं ईंयां गल्‍ला बागै सोभी देशे बेटल़ी का थोघ लागणीं इहअ करै भेटणीं सोभी बेटल़ी भाबी अर तिन्‍नां बी निं आपणैं मर्धे कदर करनी! तिन्‍नां बोल़णअ इहअ, ‘क्षयर्ष राज़ै बी शादी ती राणीं बशती अर सह निं तेऊ सेटा डेऊई।’ <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />ज़ांऊं फारस अर मादी देशै राज़ दरबारे कार-करिंदे बेटल़ी का इहअ थोघ लागणअ कि राणीं किअ इहअ-इहअ, तेखअ बोल़णअ तिन्‍नां बी आपणैं-आपणैं मर्धा लै इहअ ई! इहअ करै निं कोही बेटल़ी किधी आपणैं मर्धे इज़त करनी अर मर्ध हणैं तिन्‍नां लै रोश्श करदै। <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />माहा राज़अ क्षयर्ष, ज़ै तूह मेरी गल्‍ला लै सैहमत होए, तै कर इहअ हुकम ज़ारी कि राणीं बशती निं आझ़ा बाद तेरै मोहरै लोल़ी आई। संघा डाहै एता फारसी अर मादी देशे बधाना दी लिखी ताकि एता कुंण बदल़ी निं सके अर माहा राणींए पदबी दै कहा होरी लै ज़ुंण तैहा का बधिया होए। <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />ज़ांऊं तेरै हुकम ज़ारी हणैंओ थोघ सोभी देशै लागणअ, तेखअ करनी सोभी बेटल़ी आपणैं मर्धे कदर च़ाऐ सह सेठ होए च़ाऐ गरीब।”<verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />राज़ै अर होरी कार-करिंदै लागी अह गल्‍ल बधिया अर राज़ै किअ तिहअ ई ज़िहअ मेमूसेनै सलाह दैनी। <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />राज़ै किअ हर मुल्खे बोली-भाषा दी च़िठी लिखी आपणअ हुकम ज़ारी कि घअरो सैणअ हणअ मर्ध अर सोभै गल्‍ला हणीं तेऊए मरज़ी दी।<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">एस्तेर बणाईं माहा राणीं</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />बादा का ज़ांऊं क्षयर्ष राज़ैओ रोश्श फांभअ हुअ, सह लागअ तेखअ तेते बारै सोठदअ ज़ुंण राणीं बशती किअ अर तेता पिछ़ू ज़ुंण तेऊ हुकम ज़ारी किअ अर बधाना दी आजू लै लिखी डाहअ। <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />तेखअ लागै राज़े खास सलाहकार इहअ बोल्दै, “माहा राज़अ, कुंआरी ज़ुआन-ज़ुआन शोहरी बझ़ैल़ लोल़णैं ज़ुंण हेरनी सोभी का बित्ती होए। <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />एऊ कामां लै छ़ांट तूह कार-करिंदै मांझ़ै हर मुल्खा का ज़ुंण तिन्‍नां हेरनी शुणनी कुंआरी शोहरी राज़धानी शुआ गहल़ै पजैल़ी दैए। तिन्‍नां शोहरीए शुधी अर हार-शंगार करने ज़िम्मैंबारी दै हगाई गुंझी लै ज़हा का राज़ै आपणीं सोभी बेटल़ीओ अह काम सभाल़अ द आसा। <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />तेखअ तिन्‍नां कुंआरी शोहरी मांझ़ै ज़ुंण बी ताह गम्मे, तैहा बणाऐं तूह राणीं बशतीए ज़ैगा माहा राणीं।”</para>
  <para style="p" vid="EST 2:4">क्षयर्ष राज़ै लागी सह सलाह बधिया अर तेऊ किअ तिहअ ई।<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />राज़धानी शुशन गहल़ै रहा त मुर्दकाई नाओं एक यहूदी मणछ तेऊए बाबा नाअं त याईर। सह थिअ बिन्यामीन गोत्रा का शिमीओ पोचअ अर किशो पल़पोचअ। <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />ज़धू नबूकदनेसर राज़ै यहूदा मुल्खो राज़अ जकोनया अर खास्सै यहूदी राज़धानी एरुशलेम नगरी का कैद करी आप्पू संघै बाबेल देशा लै निंयैं, तिन्‍नां कैदी मांझ़ै थिअ मुर्दकाई बी। <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />तेऊए ती एस्तेर नाओंए एक बैहण ज़ुंण तेऊए च़ाच़ूए शोहरी थिई, तेसो इब्रानी नाअं त हादास्सी, सह थिई हेरनी-भाल़णीं बेघै बित्ती अर कुंआरी शोहरी। तेसे ईज-बाब मरनै बाद ती सह मुर्दकाई आपणीं शोहरी ज़ेही धाची-पाल़ी दी।<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />ज़ांऊं क्षयर्ष राज़ै बित्ती-बित्ती कुंआरी शोहरी लोल़णैंओ हुकम ज़ारी किअ, हर ज़ैगा का पजैल़ी खास्सी कुंआरी शोहरी राज़धानी शुशन गहल़ै अर तिन्‍नां शोहरी मांझ़ै ती एस्तेर बी। सह बी सभाल़ी राज़े मैहलै हगाई गुंझी सेटा ज़हा का राज़े सोभै बेटल़ी ती सभाल़ी दी। <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />हगाई गम्मी सोभी का खास्सी एस्तेर ई अर तेऊ निं बगत ज़ांऐं किअ अर तेऊ आणी तैहा लै हार-शंगार शुधी करने सोभ च़िज़ा, खास-खास खाण-पींण। तैहा संघै डाही छ़ांटी करै सात साथणीं अर सह अर तेसे साथणीं डाही मैहलै सोभी का बधिया ज़ैगा।<verse eid="EST 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10" />एस्तेरै निं कोही का खोज़अ आथी त कि सह आसा यहूदी! किल्हैकि मुर्दकाई ती सह समझ़ाऊई डाही दी कि इहअ निं कोही का खोज़ी कि सह आसा यहूदी। <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />मुर्दकाई करा त धैल़ मैहलै आजू ताटी हेरअ-भाल़अ डेऊई कि एस्तेर केही आसा अर तैहा संघै किज़ै-किज़ै आसा लागअ द हंदअ।<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />एकी साला तैणीं रहअ तिन्‍नां शोहरीए शुधी हंदी लागी, छ़हा भिन्‍नैं तैणीं रहै तिन्‍नां गंधरस अर तेला करै छशदै लागी अर तेता आजू छ़हा भिन्‍नैं रहै तिन्‍नां दी कई खुशबूदार च़िज़ा मल़दै लागी। तेखअ निंईं तिन्‍नां मांझ़ै बारी-बारी एक-एक शोहरी क्षयर्ष राज़ै सेटा। <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />ज़ांऊं तिन्‍नां शोहरी मांझ़ै कुंण मैहलै राज़ै सेटा डेओआ ती, तैहा लै दैआ तै ज़िहअ तेसो दिल बोलअ तिहअ बान्हणां लै। <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />बैल़ी करा ती एक शोहरी राज़ै सेटा डेऊई अर दुजै धैल़ै दोत्ती दैआ तै तैहा शोहरी राज़े होरी डाही दी बेटल़ी रहणें ज़ैगा पजैल़ी। तिंयां बेटल़ी हआ ती शाशगाज गुंझी बज़ीरा का सभाल़ी दी। तेखअ निं सह शोहरी भिई राज़ै सेटा डेऊंदी आथी ती, हाँ ज़ै राज़ै सह गम्मे अर तेसो नाअं लई भिई शादे, तै डेओआ ती सह भिई राज़ै सेटा।<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />ऐबै आई ती एस्तेरे राज़ै सेटा डेऊणे बारी। एस्तेर थिई मुर्दकाईए च़ाच़ू अबिहेले शोहरी ज़ुंण मुर्दकाई आपणीं शोहरी मनी धाची ती। ज़ुंणी बी एस्तेर भाल़ी, तिन्‍नां लागा ती सह बधिया। ज़ांऊं एस्तेरे बारी आई तैहा किअ तिहअ ई हार शंगार ज़ुंण तैहा लै हगाई बोलअ कि तूह डेऊ एता बान्हीं। <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />क्षयर्ष राज़ै ती राज़ करदी सातुई साल लागी दी अर तैहा साला पोशै पजैल़ी एस्तेर क्षयर्ष राज़े मैहलै। <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />राज़ै गम्मी एस्तेर सोभी बेटल़ी का खास्सी, ज़ेतरी बी तेऊ सेटा लै कुंआरी शोहरी आणी, सह लोभणूंअ एस्तेरा लै तिन्‍नां सोभी का खास्सअ। तेऊ लाअ तेसे मुंडै मुगट संघा बणाईं सह राणीं बशतीए ज़ैगा माहा राणीं। <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />तेखअ दैनी क्षयर्ष राज़ै आपणैं सोभी कार-करिंदै अर दरबारी लै एस्तेरे नाओंऐं बडी धाम। तैहा धैल़ी डाही सोभी मुल्खै कामां-काज़ा का छ़ुट्टी<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">छ़ुट्टी </char><char style="ft" closed="false">कारअ किअ माफ</char></note> अर राज़ै किई सोभी लै कई किम्मती-किम्मती च़िज़ा भैंट।<verse eid="EST 2:18" /></para>
  <para style="s">मुर्दकाई बच़ाऊई राज़े ज़ान</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />ज़धू राज़ै लै कुंआरी शोहरी कठा किई, राज़ै त मुर्दकाई राज़ दरबारे प्रऊल़ी सेटा कामां डाहअ द। <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />एस्तेरै निं अज़ी बी खोज़अ आथी त कि सह आसा यहूदी शोहरी किल्हैकि तैहा लै थिअ मुर्दकाई बोली डाहअ द कि इहअ निं खोज़ी अर सह बी मना ती ज़िहअ तेऊ बोलअ तिहअ ई, किल्हैकि सह थिई होछ़ी उझै तेऊ धाची-पाल़ी दी।<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />तिन्‍नां ई धैल़ै ज़धू मुर्दकाई राज़ दरबारे प्रऊल़ी सेटा कामां लागअ, राज़े दूई गुंझी थिऐ दरवाण बिगताना अर तेरेश। तिंयां थिऐ राज़ै का नराज़ अर तिंयां थिऐ क्षयर्ष राज़ै मारना लै ताखुऐ दै। <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />मुर्दकाई का गअ इना गल्‍लो थोघ लागी अर तेऊ खोज़अ राणीं एस्तेरा का अर तैहा खोज़अ राज़ै का पठी गल्‍ला कि मुर्दकाई भाल़अ कि इहअ लाअ करी। <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />ज़ांऊं इना गल्‍ले पुछ़-ज़ाच़ किई, तिंयां गल्‍ला निखल़ी तेही ई। राज़ै दैनी तिन्‍नां लै सज़ा अर तिंयां डाहै उछ़टै बूटे डाल़ै छ़ड़ाऊई। इना सोभी गल्‍ले बारै डाहअ राज़ै सम्हनै इतिहासे कताबा दी लिखी।<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">हमान च़ाहा त यहूदी पठी बरैबाद करनअ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />थोल़ै धैल़ै बाद बणाअं क्षयर्ष राज़ै आपणअ हमान नाओं बज़ीर प्रधान मंत्री। हमान त आगागे आद-लुआदा मांझ़ै हमदातो शोहरू। <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />राज़ै किअ सोभी दरवाणा लै हुकम ज़ारी कि तिंयां करै ज़ान्हूंए बला दी बेठी उटअ मूंड करी हमानो अदर करी। तिन्‍नैं बी किअ तिहअ ई पर मुर्दकाई निं तिन्‍नां होरी ज़िहअ करी निस्सअ। <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />होर राज़ दरबारे कार-करिंदै अर दुआर पाल लागै मुर्दकाई का पुछ़दै कि तूह किल्है निं राज़ैओ हुकम मंदअ? <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />तिंयां रहै तेऊ लै धैल़ बोल्दै लागी पर तेऊ निं तिन्‍नें एक बी शूणीं अर तेऊ बोलअ तिन्‍नां लै, “हुंह आसा यहूदी अर हुंह निं हमाना सेटा ज़ान्हूंए ज़ोरै बेशी झ़ुकी सकदअ।” तिन्‍नैं खोज़ी खिरी ईंयां सारी गल्‍ला हमाना का इहअ भाल़णा लै कि हमाना मुर्दकाईए एऊ बभारा लै हमाना किज़ै करनअ। <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />ज़ांऊं हमानै भाल़अ कि मुर्दकाई निं तेऊ सेटा ज़ान्हूंए बला दी धरनीं बेशी झ़ुकी करै अदर करदअ, तेऊ आई तेते खास्सी रोश्शै। <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />ज़ांऊं ता लागअ हमाना का इहअ थोघ कि अह आसा यहूदी, तेखअ सोठअ तेऊ इहअ कि एकी मुर्दकाई मारी करै निं किछ़ हणअ, मुंह पाणै हर ज़ैगा का यहूदी मणछ सोभ मारी ज़िधी-ज़िधी क्षयर्ष राज़ैओ राज़ आसा।<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />क्षयर्ष राज़े राज़ा दी बार्हूई साला च़ैत्रै बझ़ैल़ी हमानै परच़ी पाणै कि यहूदीए प्रल़या करने शुरूआत कहा भिन्‍नैं अर कहा धैल़ी पोर्ही हणीं। परच़ी दी निखल़ी बारा फागणे धैल़ी।<verse eid="EST 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8" />हमानै बोलअ क्षयर्ष राज़ै का, “माहा राज़अ, ज़ेतरै देशै तेरअ राज़ आसा, तिन्‍नां जैंदरी आसा सारै दी एक ज़ाती छिंघुई दी, तिन्‍नें आसा कै रिती-रबाज़ ई होरी रंगे, तिंयां निं राज़ैओ हुकम तोही मंदै! ज़ै इना इहै ई छ़ाडे, सह निं हाम्हां लै भलअ आथी। <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />माहा राज़अ, ज़ीबाण, तूह कर एक हुकम ज़ारी कि तिंयां पाणै सोभ मारी। ज़ै तूह इहअ करै, तै रही मेरी ज़बान कि मुंह दैणी राज़ दरबारे खज़ानै दी कोई चअन हज़ार सात शौ पज़ाह कुंटल़ च़ंदी पजैल़ी।”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />राज़ै खोल्ही आपणीं गुंठी का मुंदल़ी ज़ेता करै सरकारी मोहर लाआ तै, संघा दैनी आगागे आद-लुआद हमदाते शोहरू हमाना लै ज़ुंण यहूदीओ बैरी थिअ। <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />राज़ै बोलअ हमाना लै, “सह च़ंदी बी रही तेरी अर तिंयां लोग बी रहै तेरै, तेरअ ज़िहअ दिल बोला, तूह कर तिन्‍नां संघै तिहअ बभार।”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />तेर्हा च़ैत्रै शादै हमानै राज़े काईथ संघा बझ़ैल़ी सोभी मुल्खे राज़पाला लै तिन्‍नें भाषा अर बोली दी राज़ेए मुंदल़ी करै मोहर लाई क्षयर्ष राज़ेए नाओंऐं च़िठी लिखणैं। <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />तिन्‍नां च़िठी पजैल़ै छ़ाडै हर मुल्खा लै दूत ज़ेथ क्षयर्ष राज़ैओ राज़ थिअ। च़िठी दी थिअ इहअ समाद, “तेर्हा फागणै पाऐ यहूदी मांझ़ै ज़ुआन, बुढल़ै, मर्ध, बेटल़ी अर सोभी शोहरू-माठै संघी सोभी मारी। तिन्‍नां लै निं कोह झींण करी अर तिन्‍नें ज़ैदात लुटै पठी।” <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />ज़ुंण अह हुकम ज़ारी किअ, एते नकल दैनी सोभी मुल्खा लै खुल्ही च़िठी दी ताकि सोभै तैहा धैल़ी लै यहूदी मारदै तैर्हुई रहे।<verse eid="EST 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15" />अह हुकम हुअ त राज़धानी शुआ नगरी का ज़ारी, ज़िहअ राज़ै हुकम त किअ द, च़िठी पजैल़णैं आल़ै ठुर्है तेभी ज़ैगै-ज़ैगै सोभी मुल्खा लै। राज़अ क्षयर्ष अर प्रधान मंत्री हमान रहै शराबा झुटदै बेशी अर राज़धानी शुआ त सोभी लोगा जैंदरी हैल़अ-फिकर पल़अ द।<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">मुर्दकाई मांगी राणीं एस्तेरा का मज़त</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />ज़ांऊं मुर्दकाई का इना गल्‍लो थोघ लागअ कि किज़ै-किज़ै किअ, तेऊ धेल़ै तेऊ दुखा दी आपणैं झिकल़ै, घेरी पल़ेटअ खिंथल़अ, आपणैं मुंडै तरैल़अ तेऊ छ़ार संघा लागअ नगरी हांढदअ अर लेरा लांदी ज़ोरै-ज़ोरै लैल़ा लांदअ, <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />संघा पुजअ राज़ दरबारे मैहलै प्रऊल़ी आजू, भितरी निं सह डेऊई सकदअ त, किल्हैकि खिंथल़ै पल़ेटै मणछा निं मैहला भितरी डेऊणे ज़ाज़त आथी ती। <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />हर मुल्खै ज़िधी बी राज़ै ज़ारी किअ द अह हुकम पहल़अ, तिधी-तिधी पल़अ यहूदी मांझ़ै मखाण। तिंयां रहै भुखै-नचिशै, हिक्‍का पटाक्‍की लेरा लांदै लागी अर घेरी खिंथल़ै बान्हीं छ़ारे रूल़ी प्रैंदै लाम्मै पल़ी।<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />ज़ांऊं राणीं एस्तेरे दासी अर गुंझी बेटल़ी राणीं का ईंयां सारी गल्‍ला खोज़ी कि मुर्दकाईए केही दशा आसा, सह हुई खास्सी दुखी। तैहा छ़ाडै मुर्दकाई लै झिकल़ै पजैल़ै संघा दैनअ इहअ समाद कि खिंथल़ै खोल्ह पोर्ही संघा बान्ह राम्बल़ै झिकल़ै, पर तेऊ निं तेसे गल्‍ल मनी। <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />तेखअ शादअ तैहा आपणअ एक दास हताक, सह थिअ तिन्‍नां गुंझी दासा मांझ़ै एक ज़ुंण राज़ै राणीं एस्तेरे च़ाकरी करदै तै डाहै दै। तैहा छ़ाडअ सह इहअ बोली, “मुर्दकाई का एछ पुछ़ी कि किज़ै हुअ अर तंऐं किल्है आसा आपणैं इहै हाल किऐ दै?”<verse eid="EST 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 4:6" />हताक डेऊअ मुर्दकाई सेटा, मुर्दकाई थिअ मैहले प्रऊल़ी सम्हनै नगरीए च़फै। <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />तेखअ खोज़ी मुर्दकाई तेऊ दासा का पठी गल्‍ला कि केही-केही हुई-बिति, अर हमानै सोभी यहूदी मारनै पिछ़ू राज़ दरबारे खज़ानै लै केतरी च़ंदी आसा दैणीं किई दी। <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />तेखअ दैनी मुर्दकाई तेऊ दासा का राज़ेए नाओंऐं लिखी दी तैहा च़िठीए नकल ज़ुंण हुकम यहूदी खतम मारना लै राज़धानी शुआ नगरी का ज़ारी हुअ त। मुर्दकाई बोलअ, “एता दैऐ राणीं एस्तेरा का संघा खोज़ै तैहा का पठी गल्‍ला अर तैहा लै बोलै इहअ कि राज़ै सेटा करै लेर-पकार पाई अरज़ कि सह तेसे आपणैं लोगा लै झींण करे।” <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />हताकै खोज़अ एस्तेरा सेटा पुजी ज़िहअ मुर्दकाई बोलअ तिहअ ई, <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />अर राणीं एस्तेरै दैनअ हताका का मुर्दकाई लै बापस इहअ समाद, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“राज़ै सेटा डेऊंणा लै आसा एक काईदअ बणाअं द, राज़े सोभी कार-करिंदै अर सोभी लोगा का आसा एते बारै थोघ। ज़ुंण बी राज़ै नांईं शादअ अर सह राज़ै सेटा लै डेओए, तेऊ पाआ मारी, तिन्‍नां मांझ़ै बच़ा सह ई ज़हा बाखा राज़अ आपणैं हाथै सुन्‍नेंओ राज़दंड च़की सिसत लाए। मुंह गई राज़ै भाल़ी तिह धैल़ी हई अर हुंह निं राज़ै आप्पू सेटा शादी आथी।”<verse eid="EST 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12" />ज़ांऊं मुर्दकाई सेटा एस्तेरो अह समाद पुजअ, <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />तेऊ दैनअ राणीं एस्तेरा इहअ समाद बापस, “तूह निं इहअ सोठी आथी कि तूह आसा राज़े मैहला भितरी अर तै निं तूह होरी यहूदी ज़ेही मारनी! <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />ज़ै तूह ऐहा घल़ी एही च़ुप्पी रहे, होर यहूदी ता जाए किहअ नां किहअ करै बच़ी बी, पर तूह पाणीं तिन्‍नां तेरै पेऊकी संघी मारी। कुंण ज़ाणें कि तूह ऐहा ई खरीए घल़ी लै आसा होए माहा राणीं बणी दी!”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />एस्तेरै दैनअ मुर्दकाई लै इहअ समाद बापस, <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“डेऊ संघा कर राज़धानी शुआ बस्सै दै सोभी यहूदी कठा, संघा रहा सोभै ज़ण्हैं ब्रतू अर संघा करै मुल्है प्राथणां। चिई धैल़ै तैणीं निं कोहै धैल़ी नां राची किछ़ै खाई पिई आथी। मुंह अर इधी मेरी साथणीं बी करनअ इहअ ई। तेखअ डेऊणअ मुंह राज़ै सेटा लै च़ाऐ सह राज़े बधाने खलाफ किल्है निं होए। तेखअ ज़ै मेरी मौत बी होए, सह लागे हंदी।”<verse eid="EST 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17" />तेखअ डेऊअ मुर्दकाई तिधा का संघा किअ तिहअ ई ज़िहअ एस्तेरै तेऊ लै बोलअ त।<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">राणीं एस्तेरै दैनअ भोज़</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />चिई धैल़ै ब्रतू रहणैं का बाद बान्हअ एस्तेरै राणींओ सुआब संघा डेऊई सह राज़ेए मैहलै भितरलै च़ौकै संघा रही राज़ दरबारे प्रऊल़ी आजू स्मोहरी खल़्हुई। राज़अ त भितरी राज़गाद्दी दी बेठअ द अर तेऊओ मुंह त प्रऊल़ी बाखा। <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />ज़ांऊं राज़ै का प्रऊल़ी आजू राणीं एस्तेर शुझुई, सह हुअ तैहा भाल़ी खुश अर तेऊ किअ आपणैं हाथै सुन्‍नेंओ राज़दंड तैहा बाखा, एस्तेर डेऊई उझै राज़ै सेटा लै संघा छ़ुंहंअ च़ुंडी का राज़दंड। <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />राज़ै पुछ़अ तैहा का, “राणीं एस्तेर, तूह किज़ू कामैं आई इधी? तूह बोल ताह किज़ै लोल़ी? तूह बोल, बोल, ताल्है दैंऊं हुंह आपणअ आधअ राज़ तैणीं बी।”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्तेरै दैनअ ज़बाब, “माहा राज़अ, ज़ै हई सका तै लोल़ी तम्हैं आझ़ बैल़ी मेरै प्राहुंणैं आऐ अर हमाना बी आणै संघा मंऐं आसा तम्हां लै आझ़ भोज़ डाहअ द।”<verse eid="EST 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5" />राज़ै किअ आपणैं दासा लै हुकम, “हमाना आणा एभी ओर्ही शादी हाम्हां डेऊणअ आझ़ प्राहुंणैं।” तेखअ डेऊऐ तिंयां दुहै एस्तेरे मैहला लै भोज़ा खांदै। <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />राज़अ त दाखे शराबा झुटदअ लागअ द अर तेऊ पुछ़अ राणीं एस्तेरा का, “ऐबै खोज़ ओर्ही ताह किज़ै लोल़ी? सह जाणअ ताह भेटी। मांग, तूह मुखा आधअ राज़ बी मांगे, सह बी दैणअ मुंह ताल्है।”<verse eid="EST 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7" />एस्तेरै दैनअ ज़बाब, <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />“माहा राज़अ, ज़ै एही गल्‍ल आसा अर ज़ै तूह मुल्है दैणअ ई च़ाहा, तै लोल़ी तम्हैं अर हमान काल्‍ला भिई मेरै प्राहुंणैं आऐ अर हुंह डाहूं काल्‍ला तम्हां लै भिई भोज़ बणाईं। तेखअ खोज़ूं हुंह काल्‍ला कि हुंह किज़ै च़ाहा।”<verse eid="EST 5:8" /></para>
  <para style="s">हमानै सोठी मुर्दकाई मारने</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />ज़ांऊं हमान भोज़ खाई डेऊअ, सह थिअ दिलै खुश हुअ द। पर ज़ांऊं तेऊ का राज़े मैहलै प्रऊल़ी सेटा मुर्दकाई शुझुअ अर ज़ांऊं तेऊ भाल़अ सह निं आपणीं ज़ैगा का खल़अ उझ़ुअ अर नां केई बी साबै तेऊओ अदर किअ। तेऊ आई मुर्दकाई लै मारनै जोगी रोश्शै, <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />पर तेभै निं तेऊ मुर्दकाई लै किछ़ बोलअ। हमान डेऊअ आपणैं घअरा लै अर तेऊ शादै आपणैं साथी अर आपणीं लाल़ी जेरेश। <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />हमान लागअ आपणैं दोसता सेटा बडी-बडी गल्‍ला करदअ कि सह आप्पू किहअ सेठ आसा, तेऊए केतरै शोहरू किहै आसा अर राज़ै सह किहअ आसा प्रधान मंत्री बणाअं द अर राज़ेए होर कार-करिंदै तेऊओ किहअ अदर करा। <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />तेखअ लागअ हमान इहअ खोज़दअ, “राणीं एस्तेरै तोही शादअ राज़ै संघै सिधअ हुंह भोज़ा खांदअ, काल्‍ला डेऊणअ हाम्हां भिई। <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />पर ज़ांऊं राज़ेए मैहले प्रऊल़ी सेटा सह मुर्दकाई नाओं यहूदी बेठअ द शुझिआ, तेऊ करै हआ मेरी ईंयां सोभै गल्‍ला बृथा!”<verse eid="EST 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14" />हमाने लाल़ी जेरेश अर तेऊए साथी दैनी तेऊ लै एही सलाह, “तेऊ लै बणाऐं पज़ाह हाथ उछ़टअ चेच, दोत्ती बोलै राज़ै लै इहअ कि मुर्दकाई लै दै एथ दी फांसी संघा डेऊऐ राज़ै संघै खुशी-खुशी भोज़ा खांदअ।”</para>
  <para style="p" vid="EST 5:14">हमान हुअ एही गल्‍ला शूणीं दिलै खुशी कि अह दैनी इनै बधिया सलाह अर तेऊ बी किअ तिहअ ई संघा बणाअं एक दोहरअ चेच ज़ेथ फांसी सका तै दैई।<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">राज़ै किअ मुर्दकाईओ अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />तधू बैल़ी निं राज़ै नींज ई पल़ी, तेऊ शदाऊई इतिहासे कताब संघा बझ़ैल़ी तेऊ सह पहल़णैं। <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />ज़ांऊं राज़े दासै सह भाग पहल़अ कि राज़ेए दूई गुंझी बिगताना अर तेरेश ज़ुंण राज़ेए दरवाण थिऐ, तिन्‍नैं किई ती राज़ै क्षयर्ष मारने सांठ-गांठ अर तिन्‍नों सह भेद खोल्हअ त मुर्दकाई। <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />राज़ै पुछ़अ तेता लै, “मुर्दकाईए एऊ कामां लै हाम्हैं तेऊ लै किज़ै नांम आसा दैनी दी।”</para>
  <para style="p" vid="EST 6:3">राज़ेए तेऊ दासै दैनअ ज़बाब, “एते बदल़ै निं तेऊ लै किछ़ बी आथी किअ द।”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />राज़ै पुछ़अ, “एभै कार-करिंदै मांझ़ै कुंण मैहलै आसा?”</para>
  <para style="p" vid="EST 6:4">तेतरी गअ प्रधान मंत्री हमान मैहला भितरी ताटी पुजी, सह आअ त राज़ै सेटा इना गल्‍ला करदअ कि मुर्दकाई लै दैणीं तेथ फांसी ज़ुंण चेच तेऊ बणाईं त डाहअ द। <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />राज़ेए तेऊ दासै दैनअ ज़बाब, “बागा बाखा ताटी आसा हमान खल़्हुअ द।”</para>
  <para style="p" vid="EST 6:5">राज़ै बोलअ, “ओर्ही शाद एऊ भितरा लै।”<verse eid="EST 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6" />हमान आअ भितरा लै अर राज़ै हेरअ नढैऊऐ तेऊ लै इहअ बोली, “हुंह च़ाहा एकी मणछो खास्सअ अदर करनअ, तेऊ मणछा लै हुंह किज़ै करूं कि तेऊओ खास्सअ अदर होए?”</para>
  <para style="p" vid="EST 6:6">हमानै सोठअ, “राज़अ च़ाहा मेरअ अदर करनअ, मुखा सुआई होर कुंण सका हई? ज़ाथी निं कोहै।”<verse eid="EST 6:6" /></para>
  <para style="p">
    <verse number="7-8" style="v" sid="EST 6:7-8" />तेऊ दैनअ राज़ै लै ज़बाब, “ज़सरअ तूह खास्सअ अदर करनअ च़ाहा, तेऊ मणछा लै आणअ राज़ैओ च़ोल़अ ज़ुंण तूह आप्पू बान्हां, राज़ैओ मुगट अर एक घोल़अ ज़ेथ तूह आप्पू शुंआर हआ।” <verse eid="EST 6:7-8" /><verse number="9" style="v" sid="EST 6:9" />तेखअ बझ़ैल़णअ सह च़ोल़अ तेरै सोभी का बडै बज़ीरा का बन्हैऊंणैं अर तेऊ घोल़ै प्रैंदै बशैल़ी नगरीए च़फै दी हांढ-फेर दैणैं। घोल़ै आजू-आजू हणअ सह बज़ीर ज़ोरै-ज़ोरै इहअ बोल्दअ लागअ द, “भाल़ा, भाल़ा, ज़सरअ राज़अ अदर करा, सह हआ इहअ!”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />राज़ै बोलअ हमाना लै, “ऐबै डेऊ झ़ट-च़ारै संघा आण राज़ैओ सुआब अर घोल़अ एभी, तेता करै लाअ मंऐं यहूदी मुर्दकाईओ अदर करी। ज़िहअ-ज़िहअ तंऐं बोलअ तेता मांझ़ै निं एक गल्‍ल बी बिस्सरी आथी। ताह भेटणअ मुर्दकाई मैहले प्रऊल़ी बागै बेठअ द।”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />हमानै आणअ राज़ैओ सुआब अर घोल़अ संघा बन्हैऊंअ राज़ैओ च़ोल़अ मुर्दकाई का संघा बशैल़अ सह राज़ेए घोल़ै प्रैंदै, हमान लागअ घोल़ै आजू-आजू ज़ोरै-ज़ोरै इहअ बोल्दी नगरीए च़फै दी हांढ-फेर दैंदअ, “भाल़ा, भाल़ा, ज़सरअ राज़अ अदर करा, सह हआ इहअ!”<verse eid="EST 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12" />तेता बाद डेऊअ मुर्दकाई राज़ेए मैहले प्रऊल़ी सेटा लै बापस फिरी अर हमान डेऊअ शर्मिंदअ हई झ़टपटै उटै मुंडै आपणैं घअरा लै। <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />घअरै पुजी खोज़ी हमानै तिंयां गल्‍ला आपणीं लाल़ी अर आपणैं साथी का पठी कि इहअ-इहअ हुअ! तेखअ बोलअ तेऊए लाल़ी जेरेश अर तेऊए समझ़कार साथी इहअ, “तूह च़ाहा त मुर्दकाई खतम करनअ! सह आसा यहूदी, अर तूह निं तेऊओ मकाबलअ करी सकदअ, पर तूह हणअ तेऊ करै ज़रूर पठी बरैबाद।”<verse eid="EST 6:13" /></para>
  <para style="s">हमान पाअ मारी</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />तिंयां थिऐ गल्‍ला करदै ई लागै दै, राज़ेए गुंझी गऐ हमाना शाददै पुजी, संघा निंयं सह तेभी राणीं एस्तेरे बणाऐं दै भोज़ा खांदअ।<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="s">ज़ुंण होरी लै खाढ खण्हां</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />तेखअ डेऊऐ राज़अ अर हमान दुहै ज़ण्हैं राणीं एस्तेरे मैहलै भोज़ा खांदै <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />दुजै धैल़ै भिई। राज़ै पुछ़अ दाखे शराबा झुटदी-झुटदी भिई, “एस्तेर, राणींऐ, ऐबै ता खोज़ ओर्ही ताह किज़ै लोल़ी? सह जाणअ ताह भेटी। मांग, तूह मुखा आधअ राज़ बी मांगे, सह बी दैणअ मुंह ताल्है।”<verse eid="EST 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3" />राणीं एस्तेरै दैनअ ज़बाब, “माहा राज़अ, ज़ै तूह मुखा खुश आसा अर ज़ै तूह मुल्है किज़ै दैणअ ई च़ाहा, तै आसा ताखा मेरी अरज़ कि हुंह लोल़ी सदा राज्ज़ी-राम्बल़ी रही अर मेरै लोग बी लोल़ी ज़िऊंदै रहै। <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />किल्हैकि हुंह अर मेरै लोग आसा काटणा लै बेच़ी हेरै दै, ज़ै सिधै गलाम ई हणां लै बेच़दै, तै रहणअ त मुंह च़ुप्पी अर तै निं मुंह ताल्है कष्ट दैणअ त, पर हाम्हैं आसा पठी मारी खतम लाऐ दै करी!”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />क्षयर्ष राज़ै पुछ़अ राणीं एस्तेरा का, “अह इहअ कदुष्ट कुंण आसा? अह किधी आसा ज़ुंण इहअ करनअ च़ाहा?”<verse eid="EST 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6" />एस्तेरै दैनअ ज़बाब, “हाम्हां हंतणैं आल़अ कदुष्ट, म्हारअ दुशमण आसा अह हमान।”</para>
  <para style="p" vid="EST 7:6">हमाना छ़ुटी राज़ै-राणीं सम्हनै डरै दर्छ़णअ। <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राज़अ हुअ रोश्शै लाल-पिंऊंल़अ संघा उझ़ुअ खल़अ झुटणें पाई छ़ाड़, तेखअ डेऊअ कमरै का बागै। राज़अ रहअ मैहले बागा दी, हमाना का गअ ज़ाण्हुंई कि राज़ै हेरी दिलै सज़ा दैणें डाही अर सह रहअ तिधी संघा लागअ राणीं एस्तेरा का माफी मांगी बोल्दअ कि ऐबै बच़ाऊ मुंह राज़े हाथै मरनै का। <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />हमान त तिधी एस्तेर राणींए गाद्दी सेटा उटअ पल़ी राणीं का बच़ाऊंणे अरज़ करदअ लागअ द। ज़ांऊं राज़अ बापस फिरअ, एता भाल़ी पाई राज़ै ज़ोरै हाक्‍का, “अह मणछ लागअ ऐबै मेरै ई मैहलै एछी मुंह नदरी ज़ोरा-ज़ोरी मेरी राणीं नांगी करदअ!”</para>
  <para style="p" vid="EST 7:8">ज़ेतरी राज़ै इहअ बोलअ कि राज़ेए दास गऐ तिधी एछी अर तिन्‍नैं ढोपअ हमानो मूंड। <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />तेखअ बोलअ तिन्‍नां मांझ़ै एकी हरबोना नाओंए दासै राज़ै का, “माहा राज़अ, ज़ुंणीं मुर्दकाई तेरी ज़िन्दगी बच़ाऊई ती, तेऊ लै फांसी दैणा लै आसा हमानै आपणैं घअरै पज़ाह हाथ उछ़टअ एक दोहरअ चेच च़िणअ द!”</para>
  <para style="p" vid="EST 7:9">राज़ै किअ हुकम, “तेथ दैआ एऊ हमाना ई लै फांसी!”<verse eid="EST 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10" />हमाना लै दैनी तेऊ ई चेचा दी फांसी ज़ुंण तेऊ मुर्दकाई लै डाहअ त च़िणीं। तैबै जाई हुअ राज़ैओ रोश्श फांभअ।<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">यहूदी किअ आपणैं दुशमणो मकाबलअ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />क्षयर्ष राज़ै दैनी तैहा ई धैल़ी यहूदीए बैरी हमाने सारी ज़ैदात एस्तेर राणीं लै। तेखअ खोज़अ एस्तेरै राज़ै का इहअ कि मुर्दकाई आसा तेसो भाई अर तधा बाद करा त मुर्दकाई राज़ै सेटा डेऊई। <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />राज़ै ज़ुंण सरकारी मोहरा आल़ी मुंदल़ी हमाना लै दैनी ती, सह दैनी राज़ै हमाने गुंठी का खोल्ही मुर्दकाई लै। राणीं एस्तेरै डाही हमाने घअर अर ज़ैदाते ज़िम्मैंबारी मुर्दकाई का सभाल़ी।<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />तेखअ डेऊई एस्तेर भिई राज़ै सेटा, सह पल़ी तेऊए खूरा सेटा उटी बाखा संघा लागी लेरा लांदी। तैहा किई राज़ै का अरज़ कि ज़ुंण आगागी हमानै यहूदी मारनैओ ज़ज़ाल़ त छ़ैअ द, तेता राज़अ रोक्‍के। <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />राज़ै किअ आपणअ सुन्‍नेंओ राज़दंड तैहा बाखा लै संघा उझ़ुई राणीं एस्तेर खल़ी तेखअ लागी इहअ बोल्दी, <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />“माहा राज़अ, ज़ीबाण, ज़ै तूह मुखा खुश आसा, ज़ै ताखा राम्बल़अ ज़ाण्हिंए, तै कर इहअ हुकम ज़ारी कि हमदाता आगागीए लुआद हमानै ज़हा च़िठी दी राज़े नाओंऐं सोभी मुल्खै यहूदी पठी खतम करने बारै हुकम आसा ज़ारी किअ द, सह लोल़ी रद्द हुअ। <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />मेरै आपणैं लोगा लै एछणैं आल़ी अह आफ़त निं हुंह ज़िरी सकदी! अह बरैबादी हुंह किहअ करै सका भाल़ी कि मेरै आपणैं नातै-रिश्तैदार पाणै मारी?”<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />तेखअ बोलअ क्षयर्ष राज़ै राणीं एस्तेर अर मुर्दकाई यहूदी लै, “हमाना लै हेरी मंऐं एऊ कदुष्ट कामां लै फांसी दैई ज़ुंण तेऊ यहूदी लै करनअ सोठअ त अर तेऊए सारी ज़ैदात हेरी मंऐं एस्तेरा लै दैई। <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />पर ज़ुंण हुकम राज़ै ज़ारी किअ अर ज़ेथ राज़ेए मोहर लागी जाआ, तेता निं बदल़ी सकदै। पर तम्हैं सका यहूदी लै मेरै नाओंऐं एक होर हुकम ज़ारी करी च़िठी लिखी अर तेता सका मेरी मोहर लाई सोभी ज़ैगा पजैल़ी।”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />ईंयां गल्‍ला हुई त्रेई ज़ेठै। मुर्दकाई शादै राज़ेए काईथ संघा बझ़ैल़ी भारता पोर्ही कूश देशा तैणीं सोभी एक शौ सताई मुल्खै बस्सै दै यहूदी, राज़ेए कार-करिंदै अर राज़पाला लै ज़िहअ मुर्दकाई हुकम किअ, तेऊ साबै च़िठी लिखणैं। तेते नकल दैनी सोभी मुल्खे बोली-भाषा दी लिखी अर यहूदी लै दैनी तिन्‍नें आपणीं बोली दी लिखी। <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />मुर्दकाई लिखी सह च़िठी क्षयर्ष राज़ेए नाओंऐं संघा लाई तेथ राज़ेए सरकारी मोहर। तेता पजैल़ै छ़ाडै दूत बागरी ज़िहै छ़ेक्‍कै ठुर्हनै आल़ै घोल़ै प्रैंदै हर मुल्खा लै।<verse eid="EST 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11" />इना च़िठी दी थिअ राज़ैओ इहअ हुकम ज़ारी किअ द कि यहूदी लै आसा हर नगरी कठा हई आपणीं ज़ान बच़ाऊंणे ज़ाज़त। ज़ै कुंण अस्त्र-शस्त्र पाई यहूदी मणछ, बेटल़ी-माठै मारदै एछे, तेता लै सका यहूदी तिन्‍नां पोर्ही बी मारी अर तिन्‍नें ज़ैदात बी सका यहूदी लुटी। <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />अह हुकम आसा तिन्‍नां सोभी मुल्खा लै ज़िधी क्षयर्ष फारसी राज़ैओ राज़ आसा अर इहअ करने ज़ाज़त आसा ऐहा साला तेर्हा फागणे ई धैल़ी लै। <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />ज़ुंण अह हुकम ज़ारी किअ, एते नकला बी पजैल़ी सोभी देशै अर मुल्खै खुल्ही ई ताकि सोभै यहूदी तैहा धैल़ी लै आपणैं दुशमणे मकाबलै करदै अर बदल़ै लणा लै तैर्हुई रहे। <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />राज़ेए एऊ हुकमा पजैल़ै डेऊऐ डाक पजैल़णैं आल़ै सरकारी दूत बागरी ज़िहै छ़ेक्‍कै ठुर्हनै आल़ै घोल़ै प्रैंदै बेशी हेरा-हेरी ज़ुंण हुकम राज़धानी शुआ नगरी का ज़ारी हुअ त।<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />तेखअ डेऊअ मुर्दकाई राज़ेए मैहला का, तेऊ त राज़ैओ सुआब बान्हअ द, मुंडै त तेऊए सुन्‍नेंओ मुगट, घेरी त निलै अर बैंज़णीं रांगो बाछो च़ोल़अ बान्हअ द। शुआ नगरीए लोग लागै खुशी दी नाच़दै अर ज़ोरै-ज़ोरै ज़ै-ज़ैकार करदै। <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />यहूदी बी हुई बेघै खास्सी खुशी अर तेखअ मुक्‍कअ तिन्‍नों हैल़अ फिकर अर तेखअ च़ेतअ तिन्‍नैं कि तिन्‍नें हुई ज़ीत। <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />ज़हा-ज़हा नगरी अर मुल्खै राज़ै ज़ारी किअ द सह हुकम पहल़अ, तिधी-तिधी हुई यहूदी नाच़णै जोगी खुशी, तिन्‍नैं लाई तैहा खुशी दी धामा। तिन्‍नां मुल्खे होर लोग बी बणै यहूदी किल्हैकि तिंयां थिऐ ऐबै यहूदी का डरै दै।<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">यहूदी मारै आपणैं दुशमण</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />क्षयर्ष राज़ेए नाओंऐं ज़ुंण हुकम पैहलै ज़ारी हुअ थिअ, तेर्हा फागणै तै लाऐ दै तेते साबै यहूदी खतम करी। यहूदीए दुशमण बी थिऐ एही आशा रहै दै कि तिंयां हणैं सफल, पर ज़ांऊं सह धैल़ी पुजी तेथ पल़ी तिन्‍नां उंबल़ी मार। <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />ज़हा-ज़हा देशै क्षयर्ष राज़ैओ राज़ थिअ, तिन्‍नां नगरी किअ यहूदी आप्पू मांझ़ै एक्‍कअ अर ज़ुंण बी तिन्‍नां मारदै आऐ, यहूदी पल़ै तिन्‍नां मारदै चुटी। इहअ करै निं तिन्‍नों मकाबलअ कोहै करी सकै अर तधा बाद लागै ओर्ही-पोर्ही होरी देशे लोग बी यहूदी का डरदै। <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />सोभी मुल्खै क्षयर्ष राज़ेए कार-करिंदै, अफसर अर राज़पालै किई हथू यहूदीए मज़त, किल्हैकि तिंयां थिऐ मुर्दकाई का डरै दै। <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />तेथ त सोभी का थोघ गअ द लागी कि राज़ै आसा मुर्दकाई सोभी का बडी पदबी दी बशैल़अ द अर सह थिअ होर बी खास्सअ बलबान हंदअ लागअ द। <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />इहअ करै किअ यहूदी आपणैं दुशमणा संघै ज़िहअ तिंयां च़ाहा तै तिहअ। यहूदी रहै तलबारा पाई तिन्‍नां लै ताखुई संघा काटै-फणाटै तिंयां ज़िहै नां किहै।<verse eid="EST 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6" />राज़धानी शुआ नगरी बी पाऐ यहूदी कोई पांज़ शौ मणछ मारी। <verse eid="EST 9:6" /><verse number="7-10" style="v" sid="EST 9:7-10" />तिन्‍नां मरनै आल़ै मांझ़ै तै यहूदीए दुशमण हमदाते शोहरू हमाने दस शोहरू: परशानदाता, दलपोन, असपाता, परोता, अदालिया, अरीदाथा, परमाशता, अरीसाई, अरीदाई अर बैजाता। पर तिन्‍नैं निं तिन्‍नें ज़ैदात लुटी।<verse eid="EST 9:7-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11" />तैहा धैल़ी ज़ेतरै बी लोग राज़धानी शुआ नगरी मारै, तिंयां खोज़ै राज़ै का पठी गणी करै। <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />तेखअ बोलअ क्षयर्ष राज़ै राणीं एस्तेरा लै, “सिधी राज़धानी शुआ नगरी पाऐ यहूदी हमाने शोहरू संघी पांज़ शौ मणछ मारी! तै होरी मुल्खै झ़ाणीं तिन्‍नैं किज़ै-किज़ै किअ होए! ऐबै होर किज़ै च़ाहा तूह? सह बी जाणअ ताह भेटी। तूह खोज़ ओर्ही ताह होर कै लोल़ी? तेता बी दैंऊं हुंह ताल्है।”<verse eid="EST 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13" />एस्तेरै दैनअ ज़बाब, “माहा राज़अ, ज़ै तेरी ज़ाज़त आसा, तै दै राज़धानी शुआ नगरी यहूदी काल्‍ला बी तिहअ ई करनै ज़िहअ तिन्‍नैं आझ़ किअ। तूह कर इहअ हुकम कि हमाने दस शोहरूए ल्हासा डाहा चेचा दी छ़ड़ाऊई।” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />क्षयर्ष राज़ै किअ राज़धानी शुआ नगरी तिहअ ई हुकम ज़ारी ज़िहअ एस्तेर राणीं बोलअ त। हमाने शोहरूए दस ल्हासा डाही नगरीए च़फै चेचा दी छ़ड़ाऊई। <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />च़ौदा फागणै हुऐ यहूदी राज़धानी शुआ नगरी भिई कठा संघा पाऐ चअन शौ होर मणछ मारी पर तिन्‍नें ज़ैदात निं तिन्‍नैं तैहा धैल़ी बी लुटी।<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />होरी मुल्खे नगरी-नगरी बी हुऐ यहूदी तिहै ई कठा अर इहअ करै बच़ाऊई तिन्‍नैं आपणीं ज़ान। तिन्‍नैं पाऐ तेर्हा फागणे धैल़ी आपणैं दुशमणा मांझ़ै पझत्तर हज़ार मणछ मारी। पर तिन्‍नैं निं तिन्‍नें ज़ैदात लुटी आथी। <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />दुजै धैल़ै च़ौदा फागणै निं तिन्‍नैं किधी काट-मार किई, तिन्‍नैं लाई तैहा धैल़ी खुशी दी धामा। <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />पर राज़धानी शुआ नगरीए यहूदी रहै तेर्हा अर च़ौदा फागणै दुही धैल़ी दुशमणा मारदै लागी, तिन्‍नैं मनाऊंईं तेते खुशी पंद्रा फागणै अर तैहा धैल़ी लाई तिन्‍नैं धामा। <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />तधा बाद हुअ गट्टै-गराऊंऐं रहणैं आल़ै यहूदी मांझ़ै च़ौदा फागणो थैर शुरू। तैहा धैल़ी मनाऊंआं तिंयां खुशी संघा बांडा एकी-दुजै लै शकन भोज़न।<verse eid="EST 9:19" /></para>
  <para style="s">पूरीम नाओं थैर</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />एता बाद दैनी मुर्दकाई तिन्‍नां सोभी देश अर मुल्खै बस्सै दै यहूदी लै च़िठी लिखी ज़ेथ क्षयर्ष फारसी राज़ैओ राज़ थिअ। <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />च़िठी दी बोलअ तेऊ सोभी यहूदी लै इहअ कि हर साल मनाऊंऐं च़ौदा अर पंद्रा फागणै खुशीओ थैर ज़रूर। <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />इना दूई धैल़ी आसा यहूदी आपणैं दुशमणा का ज़ितै दै, ऐहा गल्‍ला डाहै आद कि एऊ भिन्‍नैं आसा म्हारअ दुख-शोग खुशी दी बधल़ुअ द। ऐहा धैल़ै दैऐ भोज़ संघा बांडै एकी-दुजै लै शकन भोज़न अर रैनै-गरीबा लै बी दैऐ। <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />ज़िहअ मुर्दकाई लिखी दैनअ, यहूदी किअ तिहअ ई अर इहअ करै पल़अ एऊ थैरा हर साल मनाऊंणेओ रबाज़।<verse eid="EST 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24" />आगागे आद-लुआदा का हमदातो शोहरू हमान थिअ यहूदीओ दुशमण, सह च़ाहा त यहूदी पठी खतम करनअ। यहूदीए बरैबादी लै काढी ती तेऊ परच़ी पाई धैल़ी। <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पर एस्तेर डेऊई राज़ै सेटा संघा बझ़ैल़अ हुकम ज़ारी करनै कि हमानै ज़ुंण यहूदी मारने च़ाल आसा, सह लोल़ी तेऊ लै उंबल़ी तेऊ ई लै पल़ी, हुअ बी तिहअ ई अर हमान अर तेऊए शोहरू डाहै चेचा दी राश्शी करै छ़ड़ाऊई। <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />तैही पल़अ च़ौदा-पंद्रा फागणे थैरा नाअं पूरीम। अह बोल पल़अ इब्रानी बोलीए पूर बोला का मतलब परच़ी। मुर्दकाईए च़िठी अर यहूदी संघै ज़ेही-ज़ेही हुई-बिति, <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहूदी बणाअं आजू आपणीं आद-लुआद अर आजू तिन्‍नां संघै ज़ुल़णै आल़ै होरी सोभी लै पाक्‍कअ सूल कि सोभै लऐ हर साल एऊ थैरा तिन्‍नां ई धैल़ी ज़रूर मनाऊंईं ज़िहअ मुर्दकाई च़िठी दी खोज़अ द आसा। <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />तिन्‍नैं किई एही गल्‍ल पाक्‍की कि सोभी देश अर सोभी नगरी रहणैं आल़ै यहूदी लोल़ी पोस्ती दर पोस्ती लोल़ी आजू बी अह पूरीम थैर आद डाहअ अर ज़रूर मनाऊंअ।<verse eid="EST 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29" />अबिहेले शोहरी एस्तेर राणीं अर यहूदी मुर्दकाई लिखी ती अह दुजी च़िठी होर। एता करै च़ाहा ती राणीं तैहा गल्‍ला दी पाक्‍की मोहर लाणीं कि तिहअ ई लोल़ी हुअ, ज़ुंण पूरीम थैरे बारै मुर्दकाई पैहलै ती च़िठी दैनी दी। <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />अह च़िठी लिखी ती सोभी यहूदी लै अर एते नकला दैनी सोभी एक शौ सताई मुल्खा लै ज़ेथ क्षयर्ष फारसी राज़ैओ राज़ थिअ। एतो मकसद थिअ इहअ कि सोभै यहूदी राज्ज़ी-राम्बल़ै रहे <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />अर तिंयां पूरीम थैरा आप्पू अर आजू तिन्‍नें आद-लुआद तिन्‍नां ई धैल़ै मनाओए अर ज़िहअ राणीं एस्तेर अर यहूदी मुर्दकाई तिन्‍नां लै खोज़अ अर तिन्‍नैं आप्पै शोग अर खुशी मनाऊंणेओ सूल बणाईं डाहअ त। <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />पूरीम थैरो सूल पाक्‍कअ करना लै किअ राणीं एस्तेरै हुकम ज़ारी अर तेते बारै डाहअ इतिहासे कताबा दी लिखी।<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">मुर्दकाईए मशूरी</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />क्षयर्ष राज़ैओ राज़ ज़िधी-ज़िधी थिअ, तिन्‍नां मुल्खै अर समुंदरे टापू दी मज़दूरी करनै आल़ै लोगा लै लाअ तेऊ कारअ। <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />ज़ेतरै बी महान अर मशूर काम क्षयर्ष राज़ै किऐ, तिंयां सोभै गल्‍ला आसा मादी अर फारस देशे इतिहासे कताबा दी लिखी डाही दी। मुर्दकाईए बारै बी भेटा तेथ लिखअ द कि क्षयर्ष राज़ै बडी पदबी दैई तेऊओ किहअ अदर किअ। <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />आपणैं राज़ा दी थिअ क्षयर्ष राज़ै आप्पू बाद सोभी का बडी पदबी दी मुर्दकाई डाहअ द। मुर्दकाईओ करा तै सोभ यहूदी बडअ अदर अर तेऊ च़ाहा तै सोभ। तेऊ किअ आपणैं लोगा लै भलअ काम अर राज़ै सेटा करा त सह आपणैं लोगे फाज़त लै करा त सह राज़ै सेटा गल्‍ला करी।<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>