  <para style="h">भौंरु</para>
  <para style="toc1">सुलैमान राज़ै लिखै दै भौंरु</para>
  <para style="toc2">भौंरु</para>
  <para style="toc3">भौंर.</para>
  <para style="mt1">भौंरु</para>
  <para style="imt">झ़ूरीए गिहा</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: राज़अ सुलैमान</para>
  <para style="ili">सन: 971 का 965 ईसा आजी</para>
  <para style="ip">ऐहा कताबा दी आसा खासकर गिहा लिखी दी ज़ेथ मर्ध अर बेटल़ी आप्पू मांझ़ै एकी-दुजै का इहअ खोज़ा कि तिंयां किहै झ़ूरा।</para>
  <para style="ip">अह कताब आसा राज़ै सुलैमानै लिखी दी ज़ेऊ ज़मानैं सह राज़ करा त। ऐहा कताबे खास गल्‍ल आसा एकी-दुजै लै झ़ूरी बैह। अह कताब खोज़ा इहअ कि एकी-दुजै लै झ़ूरनअ निं बूरअ हंदअ पर मर्धा बेटल़ी निं बैहे असली बधाना का बाधू गल्‍ला करदै लागणअ। एकी-दुजै लै झ़ूरनअ दिला-मन्‍नां का:</para>
  <para style="ib" />
  <para style="iq1">तूह निं आपणैं दिलै मुंह सुआई होर कोही डाही</para>
  <para style="iq1">अर नां आपणीं बाह दी मुंह छ़ाडी होरी कोही ढाकी,</para>
  <para style="iq1">किल्हैकि झ़ूरी हआ मौता ज़िहअ ज़ोर!</para>
  <para style="iq1">एते ज़ल़ण निं खल़ै ज़िऊंणै दैंदी,</para>
  <para style="iq1">एते आग रहा एही ज़ल़दी लागी,</para>
  <para style="iq1">ज़ेही कि बिधाते आग।</para>
  <para style="iq1">एता निं पाणींओ दरैअ बहाऊई सकदअ</para>
  <para style="iq1">अर नां खार समुंदर डबेऊई सकदअ,</para>
  <para style="iq1">एता निं कुंण सेठ मणछ आपणीं</para>
  <para style="iq1">सारी ज़ैदात दैई बी मोलै लई सकदअ।</para>
  <para style="ipr">(8:6,7)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">दाखे रसे नशै का आसा झ़ूरी झ़ूरीओ नशअ खास्सअ 1:1-17</para>
  <para style="io1">झ़ूरी करै हआ सोभै गल्‍ला बित्ती 2:1—3:5</para>
  <para style="io1">बैह 3:6—5:1</para>
  <para style="io1">ज़हा लै झ़ूरा, सह किल्है हआ सोभी का खास 5:2—7:13</para>
  <para style="io1">लोभी अर झ़ूरी 8:1-14</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />सुलैमान राज़ै लिखै दै भौंरु।<verse eid="SNG 1:1" /></para>
  <para style="s">पैहली गिह</para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />तूह रहअ मुल्है आपणैं होठा करै माख्खू दैंदअ लागी</para>
  <para style="q" vid="SNG 1:2">तेरी झ़ूरी आसा दाखे रसा का बी बधिया,<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />तेरअ खुशबूदार तेल दैआ मेरअ दिल खुश करी।</para>
  <para style="q" vid="SNG 1:3">तेरअ नाअं आसा खुशबू ज़िहअ सारै दी छिंघूअ द,</para>
  <para style="q" vid="SNG 1:3">तैही झ़ूरा सारी खारकी शोहरी ताल्है!<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4-5" style="v" sid="SNG 1:4-5" />मेरै राज़ैआ, छ़ेक्‍कअ कर, छ़ेक्‍कअ कर</para>
  <para style="q" vid="SNG 1:4-5">मुंह निंऊं आपणैं मैहला लै।</para>
  <para style="sp" vid="SNG 1:4-5">एरुशलेम नगरीए बेटल़ी बोला इहअ:</para>
  <para style="q" vid="SNG 1:4-5">हाम्हैं आसा ताह संघै राज्ज़ी!</para>
  <para style="q" vid="SNG 1:4-5">हाम्हैं झ़ूरा तेरी झ़ूरी लै</para>
  <para style="q" vid="SNG 1:4-5">दाखे रसा का बी खास्सी।</para>
  <para style="sp" vid="SNG 1:4-5">नार:</para>
  <para style="q" vid="SNG 1:4-5">एरुशलेम नगरीए बेटल़ीओ,</para>
  <para style="q" vid="SNG 1:4-5">थारअ एऊ लै झ़ूरनअ</para>
  <para style="q" vid="SNG 1:4-5">आसा एकी साबै ठीक</para>
  <para style="q" vid="SNG 1:4-5">हुंह आसा शाऊंणी पर हेरनी आसा एही बित्ती</para>
  <para style="q" vid="SNG 1:4-5">ज़िहअ रेगीस्तानै कदारो खिम्भ,</para>
  <para style="q" vid="SNG 1:4-5">अर ज़िहै सुलैमान राज़े मैहलै लागै दै पल्दै।<verse eid="SNG 1:4-5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />मुल्है निं तम्हैं फ्रिशदी लागा कि हुंह आसा शाऊंणी</para>
  <para style="q" vid="SNG 1:6">धुप्पै करै हुई मेरी घेर एही काल़ी,</para>
  <para style="q" vid="SNG 1:6">मेरै होरी भाई लागा ती मेरी रोश्श</para>
  <para style="q" vid="SNG 1:6">तिन्‍नैं डाही हुंह ज़ोरा-ज़ोरी आपणैं दाखे बागा पहरी लाई</para>
  <para style="q" vid="SNG 1:6">इहअ करै निं मुंह आपणीं घेरीए कारी-फाज़त करनैओ बगत ई भेटअ।<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />मेरै लोभिआ, मुखा खोज़,</para>
  <para style="q" vid="SNG 1:7">ताह आपणीं भेडा-बाकरी किधा लै निंणीं च़रदी?</para>
  <para style="q" vid="SNG 1:7">तूह दपहरै तिन्‍नां लै किधी दैआ बशैघ?</para>
  <para style="q" vid="SNG 1:7">मुंह कै ज़रुरत आसा कि हुंह रहूं</para>
  <para style="q" vid="SNG 1:7">फुआले हेल़्ही जैंदरी ताह लोल़ी लागी?<verse eid="SNG 1:7" /></para>
  <para style="sp">नर:</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />सोभी का सुंदर नार, ज़ै ताखा थोघ निं आथी,</para>
  <para style="q" vid="SNG 1:8">तै भाल़ै भेडा-बाकरीए छ़ल़ूए नछ़ैण</para>
  <para style="q" vid="SNG 1:8">संघा लागै तेथ बाखा हांढदी</para>
  <para style="q" vid="SNG 1:8">आपणैं गाभू-छ़ेल्हूए हेल़्ही च़राऊऐ तूह</para>
  <para style="q" vid="SNG 1:8">होरी फुआले खिम्भा नेल़-नेल़।<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />मेरी झ़ूरीऐ, मंऐं समझ़ी तूह</para>
  <para style="q" vid="SNG 1:9">मिसर देशे माहा राज़ेए होछ़ै रथा दी ज़ुंडी दी घोल़ी ज़ेही।<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />लाम्मी कनूरी शोभा तेरै गलेटै प्रैंदै होर बी खास्सी,</para>
  <para style="q" vid="SNG 1:10">हार-शंगारा करै ढबा तेरअ गअल़ बेघै बधिया।<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />हुंह बणाऊं ताल्है</para>
  <para style="q" vid="SNG 1:11">सुन्‍नैं-च़ंदीए किम्मती हार।<verse eid="SNG 1:11" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />मेरअ राज़अ त आपणैं पलगा प्रैंदै बेठअ द,</para>
  <para style="q" vid="SNG 1:12">मेरै खुशबूदार जटामांसीए तेला का थिई शोभली बास्स लागी दी।<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />मेरै लोभिआ, तूह आसा सैंटे शिश्शी ज़िहअ</para>
  <para style="q" vid="SNG 1:13">ज़ुंण मंऐं दुही हिक्‍का मांझ़ै हआ डाही दी।<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />तूह आसा मैहंदीए फूले लुम्बरू ज़िहअ</para>
  <para style="q" vid="SNG 1:14">ज़ुंण एनगादी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">एनगादी </char><char style="ft" closed="false">खारै समुंदरे पछ़मा बाखा</char></note> ज़ैगा दाखे बागा दी हआ।<verse eid="SNG 1:14" /></para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />मेरी झ़ूरीऐ, तूह भाल़ हेरनी केही बित्ती आसा</para>
  <para style="q" vid="SNG 1:15">तेरी आछी आसा कबूतरी ज़ेही।<verse eid="SNG 1:15" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />मेरै लोभिआ, तूह बी भाल़ हेरनअ किहअ बित्तअ आसा,</para>
  <para style="q" vid="SNG 1:16">तूह आसा दिला लोभणैं आल़अ</para>
  <para style="q" vid="SNG 1:16">म्हारै बैहे पैहली राची हणअ म्हारै च़ैना प्रैंदै हरअ घाह<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />म्हारै घअरे मेल़ आसा केल़ुईए</para>
  <para style="q" vid="SNG 1:17">अर छ़ाप्परे छ़ैट्ठी हणीं कैलीए बूटे।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="s">झ़ूरी करै हआ सोभै गल्‍ला शोभली</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />हुंह आसा शारोन सऊंऐं मुल्खै फुल्‍लअ द गलाबो फूल</para>
  <para style="q" vid="SNG 2:1">उटी रेल़ी धारा लागअ द सुरघो फूल।<verse eid="SNG 2:1" /></para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />मेरी झ़ूरीऐ, होरी बेटल़ी जैंदरी ज़ाण्हिंआं तूह ज़ेही</para>
  <para style="q" vid="SNG 2:2">कांडै जैंदरी सुरघे फूला ज़ेही।<verse eid="SNG 2:2" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />मेरै लोभिआ, तूह बी आसा होरी मर्धा जैंदरी इहअ</para>
  <para style="q" vid="SNG 2:3">ज़िहअ बणैं होरी बूटा जैंदरी सेओ बूट,</para>
  <para style="q" vid="SNG 2:3">मुंह एछा तेरी छ़ैल्‍ली दी बेशणेओ मज़अ,</para>
  <para style="q" vid="SNG 2:3">अर तेरै फल़ आसा खाणां लै मिठै।<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />तंऐं पजैल़ी हुंह आपणीं धामा दी</para>
  <para style="q" vid="SNG 2:4">अर ज़ुंण फ्रहरअ मुंह प्रैंदै आसा, सह आसा तेरी मुल्है झ़ूरी।<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />मुल्है दै दाख खैऊई करै बल अर</para>
  <para style="q" vid="SNG 2:5">सेओ खैऊई फरेऊ मेरअ शाह हरअ!</para>
  <para style="q" vid="SNG 2:5">मुंह आसा दिलो रोग लागअ द।<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />तेरी खिंज़ी बाह लोल़ी ती मेरै शरैहणैं हुई,</para>
  <para style="q" vid="SNG 2:6">खाणैं हाथै लोल़ी तंऐं मुल्है मल़्हैची दैनी।<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />एरुशलेम नगरीए बेटल़ीओ, मेरी आसा तम्हां का अरज़,</para>
  <para style="q" vid="SNG 2:7">तम्हैं काढा हरनी अर घोर्हल़े सोह कि</para>
  <para style="q" vid="SNG 2:7">ज़ेभै तैणीं हाम्हैं झ़ूरी करी पठी निं रज्ज़े तेभै तैणीं निं हाम्हां झ़ैऊई, नां छ़ेल़ी।<verse eid="SNG 2:7" /></para>
  <para style="s">दुजी गिह</para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />मुखा आसा आपणैं लोभिए बोल शुण्हदै लागै दै! शूणां,</para>
  <para style="q" vid="SNG 2:8">सह आसा लागअ द धारा का छ़ाहल़ा दैई अर</para>
  <para style="q" vid="SNG 2:8">धारठी लंघी मुंह सेटा लै एछदअ।<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />मेरअ लोभी आसा घोर्हल़ अर</para>
  <para style="q" vid="SNG 2:9">खारकै हरना ज़िहअ,</para>
  <para style="q" vid="SNG 2:9">सह आसा म्हारी दुआली पिछ़ू खल़्हुअ द।</para>
  <para style="q" vid="SNG 2:9">सह आसा ताक्‍कीए ज़ाल़ी बाती पांडा लागअ द भाल़अ<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />अर सह आसा मुंह संघै गल्‍ला करदअ लागअ द।</para>
  <para style="sp" vid="SNG 2:10">नर</para>
  <para style="q" vid="SNG 2:10">ए मेरी झ़ूरीऐ, हुंह झ़ूरा ताल्है खास्सअ!</para>
  <para style="q" vid="SNG 2:10">च़ाल्‍ल, मुंह संघै एछ।<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />हिंऊंद गअ मुक्‍की, अर सरग बी गअ बिझुई,<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />खील-फूल फुल्‍लै, बसंते ऋत गई पुजी,</para>
  <para style="q" vid="SNG 2:12">च़ेल्‍लू-पखीरूओ गिहा लाणैंओ बगत गअ पुजी,</para>
  <para style="q" vid="SNG 2:12">बणां-बूटा का लागी पालल़ी गिहा बोल्दी शुण्हदी।<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />फेडूए बूटा दी च़ाल्‍लै फेडू पाक्‍की,</para>
  <para style="q" vid="SNG 2:13">दाखे बेला दी लागै दै फूला का आसा शोभली बास्स लागी दी।</para>
  <para style="q" vid="SNG 2:13">मेरी शोभली झ़ूरीऐ, हुंह झ़ूरा ताल्है खास्सअ,</para>
  <para style="q" vid="SNG 2:13">च़ाल्‍ल, मुंह संघै एछ।<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />तूह आसा कबूतरी ज़ेही</para>
  <para style="q" vid="SNG 2:14">ज़ुंण भिल़ीए द्रटा दी आसा लुक्‍की रही दी।</para>
  <para style="q" vid="SNG 2:14">मुंह दै तेरअ शोभलअ मुंह भाल़णैं</para>
  <para style="q" vid="SNG 2:14">अर तेरअ मिठअ बोल शुणनै।<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />म्हारी बागा आसा दाखे फूल खिल्‍लै दै,</para>
  <para style="q" vid="SNG 2:15">ज़ुंण होछ़ै शैल़ठै आसा, तिंयां लणैं हाम्हां ढाकी,</para>
  <para style="q" vid="SNG 2:15">ताकि तिंयां म्हारी बागा बरैबाद नां करे।<verse eid="SNG 2:15" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />मेरै लोभिआ, हुंह आसा तेरी अर</para>
  <para style="q" vid="SNG 2:16">तूह आसा मेरअ,</para>
  <para style="q" vid="SNG 2:16">तूह च़राऊआ आपणीं भेडा सुरघे फूला जैंदरी।<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />ज़ांऊं तैणीं दोत्ती ठांढी बागरी निं फिरे</para>
  <para style="q" vid="SNG 2:17">अर राच भैई निं जाए,</para>
  <para style="q" vid="SNG 2:17">तेभै तैणीं रह तूह खारकै हरना ज़िहअ बणी</para>
  <para style="q" vid="SNG 2:17">ज़ुंण धारे ढल़ाना दी त्रुपल़ै दैआ।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="sp">नार</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />च़ैन्‍नै सुत्ती हआ मुंह राची कबल्‍लै</para>
  <para style="q" vid="SNG 3:1">आपणैं लोभिए सुपनै,</para>
  <para style="q" vid="SNG 3:1">हुंह रही तेऊ लोल़ी लागी पर सह निं मुंह भेटअ।<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />तेखअ बोलअ मंऐं आप्पू लै इहअ,</para>
  <para style="q" vid="SNG 3:2">मुंह डेऊणअ आपणैं लोभी लोल़ी सारी नगरी,</para>
  <para style="q" vid="SNG 3:2">तेते सोभी बाता अर बज़ारै,</para>
  <para style="q" vid="SNG 3:2">हुंह रही तेऊ लोल़ी लागी पर सह निं मुंह भेटअ।<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />तेखअ भेटै मुंह नगरीए पहरी बी हांढदै-फिरदै लागै दै,</para>
  <para style="q" vid="SNG 3:3">मंऐं पुछ़अ तिन्‍नां का, “तम्हैं मेरअ लोभी बी भाल़अ?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />ज़ांऊं हुंह तिन्‍नां सेटा का धख आजू डेऊई,</para>
  <para style="q" vid="SNG 3:4">तेतरी गअ मुंह आपणअ लोभी भेटी,</para>
  <para style="q" vid="SNG 3:4">मंऐं दैनी तेऊ लै पिड्डी मल़्हैची अर सह निं मंऐं</para>
  <para style="q" vid="SNG 3:4">तेभै तैणीं छ़ाडअ ज़ांऊं तैणीं मंऐं आपणैं घअरै</para>
  <para style="q" vid="SNG 3:4">तैहा पांडा निं पजैल़अ ज़िधी हुंह हुई ज़ल्मीं दी आसा।<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />एरुशलेम नगरीए बेटल़ीओ, मेरी आसा तम्हां का अरज़,</para>
  <para style="q" vid="SNG 3:5">तम्हैं काढा हरनी अर घोर्हल़े सोह कि</para>
  <para style="q" vid="SNG 3:5">ज़ेभै तैणीं हाम्हैं झ़ूरी करी पठी निं रज्ज़े तेभै तैणीं निं हाम्हां झ़ैऊई, नां छ़ेल़ी।<verse eid="SNG 3:5" /></para>
  <para style="s">चिऊथी गिह</para>
  <para style="sp">साथणीं</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />रेगीस्ताना का अह धूँए बादल़ा ज़िहअ किज़ै आसा लागअ द एछदअ?</para>
  <para style="q" vid="SNG 3:6">एता संघै आसा भांती-भांतीए मसालै, लोवान अर खुशबूदार तेले</para>
  <para style="q" vid="SNG 3:6">शोभली बास्स लागी दी?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />भाल़ा, अह आअ राज़अ सुलैमान पालकी दी बेशी!</para>
  <para style="q" vid="SNG 3:7">इज़राईले शूर-बीरा मांझ़ै शाठ ज़ण्हैं आसा</para>
  <para style="q" vid="SNG 3:7">तेऊ ओर्ही-पोर्ही अर आजू-पिछ़ू लागै दै हांढदै।<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />तिंयां आसा सोभै तलबारा आल़ै अर</para>
  <para style="q" vid="SNG 3:8">सोभ आसा तिंयां जुध बिद्या दी सेठ।</para>
  <para style="q" vid="SNG 3:8">तिंयां सका राची घणैं न्हैरै बी जुध करी।<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />ज़हा पालकी दी राज़अ सुलैमान आसा बेठअ द,</para>
  <para style="q" vid="SNG 3:9">सह आसा लाबानोने किम्मती काठा करै बणाईं दी।<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />तेते पाअ आसा च़ंदी करै महल़ै दै</para>
  <para style="q" vid="SNG 3:10">अर तेतो कठैम्ह आसा सुन्‍नैं करै</para>
  <para style="q" vid="SNG 3:10">थाल्‍लै बेशणा लै गाद्दी दी आसा</para>
  <para style="q" vid="SNG 3:10">बैंज़णीं रांगो गलाफ लाअ द अर</para>
  <para style="q" vid="SNG 3:10">मांझ़ै आसा तेथ एरुशलेम नगरीए शोहरी</para>
  <para style="q" vid="SNG 3:10">बधिया बूणती पाई दी।<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />सियोन नगरीए बेटल़ीओ, बागै निखल़ा,</para>
  <para style="q" vid="SNG 3:11">भाल़ा, राज़अ सुलैमान आअ</para>
  <para style="q" vid="SNG 3:11">तेऊ आसा सह ई मुगट बान्हअ द</para>
  <para style="q" vid="SNG 3:11">ज़ुंण तेऊए ईजै तेऊए बैहे धैल़ी</para>
  <para style="q" vid="SNG 3:11">तेऊए मुंडै बन्हैऊंअ त।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">नर</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />मेरी झ़ूरीऐ तूह भाल़ केही बित्ती आसा,</para>
  <para style="q" vid="SNG 4:1">तूह आसा हेरनी बेघै बधिया।</para>
  <para style="q" vid="SNG 4:1">घुंढू भितरी ढबा तेरी आछी पालल़ी ज़ेही</para>
  <para style="q" vid="SNG 4:1">तेरअ मूंड आसा बाकरीए हेल़्ही ज़िहअ</para>
  <para style="q" vid="SNG 4:1">ज़ुंण गलाद धारे ढल़ाना दी आसा होथदी लागी दी।<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="PRO 5:19">सैणीं. 5:19</ref></char></note><verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />तेरै दांद आसा मुनी दी शेती भेडे हेल़्ही ज़िहै शेतै</para>
  <para style="q" vid="SNG 4:2">ज़ुंण ज़ात एभै पै पाणीं जैंदरा का न्हैऊई उझै निखल़ी</para>
  <para style="q" vid="SNG 4:2">तिंयां आसा सोभै एकी रंगे अर तिन्‍नां मांझ़ै निं एक बी भेड़ शोठुई आथी।<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />तेरै होठ आसा लाला रांगे डोरी ज़िहै अर</para>
  <para style="q" vid="SNG 4:3">तेरअ मुंह आसा दिला लोभणैं आल़अ।</para>
  <para style="q" vid="SNG 4:3">घुंढू बाती शुझिआ तेरै दोहरै गलेटै नारदाणैं ज़िहै।<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />तेरअ कैल़अ आसा राज़ै दाबेदे उछ़टै कोटा ज़िहअ</para>
  <para style="q" vid="SNG 4:4">हेरनअ बित्तअ ज़ुंण तेऊ अस्त्र-शस्त्रा लै बणाअं</para>
  <para style="q" vid="SNG 4:4">अर ज़ेथ हज़ार ढाल़ा आसा किल्‍ली डाही दी,</para>
  <para style="q" vid="SNG 4:4">तिंयां सोभै ढाल़ा आसा शूर-बीरे।<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />तेरी दुहै हिक्‍का आसा हरनीए दोगल़ बच़ै ज़ेही</para>
  <para style="q" vid="SNG 4:5">ज़ुंण सुरघे फूला जैंदरी आसा च़रदै लागै दै।<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />ज़ांऊं तैणीं दोत्ती ठांढी बागरी निं फिरे</para>
  <para style="q" vid="SNG 4:6">अर राच भैई निं मुक्‍के,</para>
  <para style="q" vid="SNG 4:6">मुंह रहणअ तेभै तैणीं तिन्‍नां धारा प्रैंदै</para>
  <para style="q" vid="SNG 4:6">ज़ेता का लोवान अर गंधरसे</para>
  <para style="q" vid="SNG 4:6">खुशबू आसा लागी दी।<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />ए मेरी झ़ूरीऐ, तूह आसा सोभी गल्‍ला दी लोभणैं आल़ी,</para>
  <para style="q" vid="SNG 4:7">ताह दी निं खोट आथी ई।<verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />ए मेरी बेटल़ीऐ, तूह एछ लाबानोन धारा का मुंह संघै,</para>
  <para style="q" vid="SNG 4:8">लाबानोना का एछ तूह मुंह संघै।</para>
  <para style="q" vid="SNG 4:8">अमाना, सनीर अर हर्मोन धारे च़ुंडी</para>
  <para style="q" vid="SNG 4:8">ज़िधी सिह अर च़राघ रहा,</para>
  <para style="q" vid="SNG 4:8">तिधा का होथ तूह उंधै।<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />मुल्है लाई बरी दी मेरी झ़ूरीऐ,</para>
  <para style="q" vid="SNG 4:9">तंऐं लोभअ मेरअ दिल</para>
  <para style="q" vid="SNG 4:9">आपणीं आछिए एकी झपकै अर गल़े हारा करै।<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />तेरअ मुल्है झ़ूरनअ आसा दाखे रसा का बी मिठअ,</para>
  <para style="q" vid="SNG 4:10">तेरअ सैंट आसा सोभी रंगे मसालै का खास्सअ खुशबूदार।<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />मेरी झ़ूरीऐ, तेरै होठै आसा मखीरा ज़िहअ सुआद,</para>
  <para style="q" vid="SNG 4:11">तेरी ज़िभ आसा मुल्है मखीर अर दुधा ज़ेही।</para>
  <para style="q" vid="SNG 4:11">तेरै झिकल़ै का एछा लाबानोन ज़ेही खुशबू।<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />मेरी बेटल़ीऐ, मेरी झ़ूरीऐ,</para>
  <para style="q" vid="SNG 4:12">तूह आसा मेरी आपणीं बागा अर</para>
  <para style="q" vid="SNG 4:12">ज़ाईरू पाणींए बाऐ ज़ेही</para>
  <para style="q" vid="SNG 4:12">ज़ेथ फेर दुआल आसा दैनी दी कि तेथ भितरी कुंण डेऊई निं सके,<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />तेथ आसा टिप्परू लागै दै</para>
  <para style="q" vid="SNG 4:13">तिंयां बझ़ा बागा दी नारदाणें बुटी ज़िहै ज़ेथ बधिया फल़ लागा,</para>
  <para style="q" vid="SNG 4:13">तेथ आसा मैहंदी, जटामांसी<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />केसर, लोवान, मुश्क,</para>
  <para style="q" vid="SNG 4:14">दाल़चिनी, गंधरस, अगर</para>
  <para style="q" vid="SNG 4:14">बगैरा भांती-भांतीए मसालैदार बुटी लागी दी।<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />तूह आसा बागा दी पाणींए सोबल़,</para>
  <para style="q" vid="SNG 4:15">ज़ाईरू पाणींए बाऐ अर</para>
  <para style="q" vid="SNG 4:15">लाबानोने धारा का बगदी गाडा ज़ेही।<verse eid="SNG 4:15" /></para>
  <para style="sp">शोहरी</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />ओ उतर दिशा बाखे बागरीऐ ज़ाग,</para>
  <para style="q" vid="SNG 4:16">ओ दखणा बाखे बागरीऐ मेरै बागा दी लाग।</para>
  <para style="q" vid="SNG 4:16">तेते खुशबू लोल़ी सारै दी छिंघुई।</para>
  <para style="q" vid="SNG 4:16">मेरअ लोभी लोल़ी आपणैं एऊ बागा दी आअ</para>
  <para style="q" vid="SNG 4:16">अर तेऊ लोल़ी एते बधिया का बधिया फल़ खाऐ।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">नर</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />मुल्है लाई बरी दी, मेरी झ़ूरीऐ,</para>
  <para style="q" vid="SNG 5:1">हुंह गअ आपणैं बागा लै एछी,</para>
  <para style="q" vid="SNG 5:1">मंऐं हेरअ गंधरस अर बलसान चुंघी,</para>
  <para style="q" vid="SNG 5:1">हुंह आसा काशणीं संघी मखीरा खांदअ लागअ द,</para>
  <para style="q" vid="SNG 5:1">दुध अर दाखो रस बी हेरअ मंऐं झुटी।</para>
  <para style="sp" vid="SNG 5:1">साथणीं</para>
  <para style="q" vid="SNG 5:1">साथी-संघीओ, तम्हैं रहा खांदै पिंदै लागी</para>
  <para style="q" vid="SNG 5:1">ज़ेभै तैणीं तम्हैं रज्ज़ी निं जाए।<verse eid="SNG 5:1" /></para>
  <para style="s">च़ौथी गिह</para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />हुंह ती सुत्ती दी पर</para>
  <para style="q" vid="SNG 5:2">दिलै ती ज़ागती रही दी।</para>
  <para style="q" vid="SNG 5:2">मुंह हुअ इहअ सुपनअ कि</para>
  <para style="q" vid="SNG 5:2">मेरअ लोभी लागअ बागै मेरै दुआरा टोक्‍कदअ अर</para>
  <para style="q" vid="SNG 5:2">मुल्है इहअ बोल्दअ,</para>
  <para style="q" vid="SNG 5:2">“मेरी बेटल़ी, मेरी झ़ूरी, मेरी पालल़ीऐ,</para>
  <para style="q" vid="SNG 5:2">मुल्है खोल्ह पोर्ही दुआर!</para>
  <para style="q" vid="SNG 5:2">मेरै मुंडै पल़अ पाल़अ अर</para>
  <para style="q" vid="SNG 5:2">मुंडे शराल़ भिज़ै तेता करै पठी।”<verse eid="SNG 5:2" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />पर मंऐं बोलअ इहअ,</para>
  <para style="q" vid="SNG 5:3">“हुंह आसा आपणैं झिकल़ै खोल्ही</para>
  <para style="q" vid="SNG 5:3">अर हाथ-खूर धोई सुत्ती गई दी,</para>
  <para style="q" vid="SNG 5:3">ऐबै कै हुंह झिकल़ै भिई बान्हूं अर आपणैं खूर भिई मैलै करूं?”<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />मेरै लोभी पाअ दुआरे खाढा बाती</para>
  <para style="q" vid="SNG 5:4">आपणअ हाथ भितरा लै</para>
  <para style="q" vid="SNG 5:4">तेखअ उबल़अ तेऊ लै मेरअ दिल,<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />तेखअ हुई हुंह आपणैं लोभी भितरी छ़ाडणा लै तैर,</para>
  <para style="q" vid="SNG 5:5">ज़ांऊं मंऐं दुआरे मुठ ढाकी,</para>
  <para style="q" vid="SNG 5:5">मेरै हाथे गुंठी का लागै खुशबूदार तेले टिप्पू अल़दै।<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />ज़ेभै सह मुल्है बोल्दअ त लागअ द, तेभै ती हुंह धख डरी दी</para>
  <para style="q" vid="SNG 5:6">पर ज़ेतरी मंऐं आपणैं लोभी लै दुआर घुआल़अ,</para>
  <para style="q" vid="SNG 5:6">तेभा लै गअ सह डेऊई!</para>
  <para style="q" vid="SNG 5:6">हुंह लागी तेऊ लोल़ी पर सह निं मुंह भेटअ अर</para>
  <para style="q" vid="SNG 5:6">मंऐं लाई तेऊ लै हाक्‍का बी</para>
  <para style="q" vid="SNG 5:6">पर तेऊ निं होह बी किअ!<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />मुंह भेटै नगरीए पहरी हांढदै-फिरदै लागै दै,</para>
  <para style="q" vid="SNG 5:7">तिन्‍नैं किई हुंह च़िक्‍की करै नर्तान अर</para>
  <para style="q" vid="SNG 5:7">ज़ुंण नगरीए दुआली पहरी थिऐ, तिन्‍नैं छ़ड़ैऊअ मुखा मेरअ च़ादरू।<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />एरुशलेम नगरीए बेटल़ीओ,</para>
  <para style="q" vid="SNG 5:8">तम्हैं काढा सोह, ज़ै तम्हां मेरअ लोभी भेटे,</para>
  <para style="q" vid="SNG 5:8">तेऊ का खोज़ै इहअ कि हुंह आसा तेऊए झ़ूरी लै चाछल़दी लागी दी।<verse eid="SNG 5:8" /></para>
  <para style="sp">साथणीं</para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />ओ सोभी का सुंदर नार,</para>
  <para style="q" vid="SNG 5:9">तेरअ लोभी कै होरी सोभिए लोभी का खास्सअ बधिया आसा?</para>
  <para style="q" vid="SNG 5:9">तेऊ दी किज़ै आसा इहअ खास</para>
  <para style="q" vid="SNG 5:9">कि तंऐं बझ़ैल़ै हाम्हां का सोह खाणैं?<verse eid="SNG 5:9" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />मेरअ लोभी आसा शेतअ-गोरअ मोट्टअ-धोटअ बधिया,</para>
  <para style="q" vid="SNG 5:10">सह आसा हज़ारो दी एक।<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />तेऊओ मुंह आसा च़ोखै सुन्‍नैं ज़िहअ अर</para>
  <para style="q" vid="SNG 5:11">तेऊए मुंडे शराल़ आसा काऊड़ै ज़िहै काल़ै।<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />तेऊए आछी च़मका पालल़ी ज़ेही</para>
  <para style="q" vid="SNG 5:12">ज़ुंण दुधा दी न्हैऊई गाडे बाढै आसा होए बेठै दै।<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />तेऊए गलेटै आसा इहै रगैटै ज़िहै</para>
  <para style="q" vid="SNG 5:13">ज़ेथ रंगा फूल अर खुशबूदार मसालै आसा लागै दै,</para>
  <para style="q" vid="SNG 5:13">तेऊए होठ आसा सुरघे फूला ज़िहै</para>
  <para style="q" vid="SNG 5:13">ज़ेता का खुशबूदार रस रहा निटरदअ लागी।<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />तेऊए बाह आसा सनांगणूं बान्हीं सुन्‍नें छ़ल़ी ज़ेही</para>
  <para style="q" vid="SNG 5:14">ज़ेथ किम्मती रतन आसा लागै दै,</para>
  <para style="q" vid="SNG 5:14">तेऊए घेर आसा हाथी दांदा ज़ेही ल्हाशी</para>
  <para style="q" vid="SNG 5:14">ज़ुंण नीलमणीं किम्मती पात्थरा करै हआ सज़ाऊअ द।<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />तेऊए ज़ांघा आसा संगमरमरे थाम्हा ज़ेही</para>
  <para style="q" vid="SNG 5:15">ज़ेथ सुन्‍नें ज़ोल़ आसा लाऐ दै</para>
  <para style="q" vid="SNG 5:15">सह आसा हेरनअ लाबानोन धारा</para>
  <para style="q" vid="SNG 5:15">अर बडी केल़ुई ज़िहअ दिला लोभणैं आल़अ।<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />तेऊए च़ुंज़ी माख्खू दैणैंओ लागा च़ाअ,</para>
  <para style="q" vid="SNG 5:16">एरुशलेम नगरीए बेटल़ीओ,</para>
  <para style="q" vid="SNG 5:16">अह ई आसा मेरअ लोभी अर</para>
  <para style="q" vid="SNG 5:16">अह ई आसा मेरअ साथी।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">साथणीं</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />ओ सोभी का सुंदर नार,</para>
  <para style="q" vid="SNG 6:1">तेरअ लोभी किधा लै डेऊअ?</para>
  <para style="q" vid="SNG 6:1">तूह खोज़ हाम्हां का कि सह कैहा बाता डेऊअ,</para>
  <para style="q" vid="SNG 6:1">तै सका हाम्हैं तेऊ लोल़णा लै तेरी मज़त करी।<verse eid="SNG 6:1" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />मेरअ लोभी डेऊअ आपणैं बागा बाखा लै</para>
  <para style="q" vid="SNG 6:2">ज़ेथ खुशबूदार मसाले बूट आसा लागै दै,</para>
  <para style="q" vid="SNG 6:2">सह हणअ बागा दी आपणीं भेडा बाकरी च़राऊंदअ</para>
  <para style="q" vid="SNG 6:2">अर सुरघे फूला कठा करदअ लागअ द।<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />मेरअ लोभी आसा मेरअ अर हुंह आसा तेऊए,</para>
  <para style="q" vid="SNG 6:3">सह च़राऊआ आपणीं भेडा-बाकरी सुरघे फूला जैंदरी।<verse eid="SNG 6:3" /></para>
  <para style="s">पांज़ूई गिह</para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />ए मेरी झ़ूरीऐ, तूह लोभा मुंह तिर्सा नगरी ज़ेही,</para>
  <para style="q" vid="SNG 6:4">हेरनी शुणनी आसा तूह एरुशलेम नगरी ज़ेही बित्ती,</para>
  <para style="q" vid="SNG 6:4">तूह आसा सैने फ्रहरै ज़ेही शानदार।<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />तूह निं मुंह एही भाल़ी लागै,</para>
  <para style="q" vid="SNG 6:5">एता करै एछा मेरै दिलै बुआल़,</para>
  <para style="q" vid="SNG 6:5">तेरअ मूंड दैआ बाकरीए हेल़्ही ज़िहै झ़लारै</para>
  <para style="q" vid="SNG 6:5">ज़ुंण गलाद धारे रेल़ी घैहणीं बाती आसा होथदी लागी दी।<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />तेरै दांद आसा शेती भेडे हेल़्ही ज़िहै शेतै</para>
  <para style="q" vid="SNG 6:6">ज़ुंण ज़ात एभै पै पाणीं जैंदरा का न्हैऊई उझै निखल़ी</para>
  <para style="q" vid="SNG 6:6">तिंयां आसा सोभै एकी रंगे अर तिन्‍नां मांझ़ै निं एक बी भेड़ शोठुई आथी।<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />घुंढू बाती शुझिआ तेरै दोहरै गलेटै नारदाणैं ज़िहै।<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />राज़ै का च़ाऐ शाठ राणीं या अश्शी होर बेटल़ी होए डाही दी</para>
  <para style="q" vid="SNG 6:8">अर हज़ारो कुंआरी शोहरी बी होए,<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />पर हुंह झ़ूरा सिधअ ताह एकी लै,</para>
  <para style="q" vid="SNG 6:9">ज़ुंण कबूतरी ज़ेही लोभणैं आल़ी अर</para>
  <para style="q" vid="SNG 6:9">आपणीं ईजे कल्ही शोहरी अर खास्सी पैरी आसा,</para>
  <para style="q" vid="SNG 6:9">सोभै खारकी शोहरी करा ताह भाल़ी तेरी सर्राफी,</para>
  <para style="q" vid="SNG 6:9">होर ता होर राज़े राणीं अर</para>
  <para style="q" vid="SNG 6:9">होर डाही दी बेटल़ी बी करा</para>
  <para style="q" vid="SNG 6:9">ताह भाल़ी तेरी एही तरीफ:<verse eid="SNG 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />“अह सुंदर नार कुंण आसा ज़ुंण भैणीं दोत्ती ज़ेही प्रैश्शी शुझिआ,</para>
  <para style="q" vid="SNG 6:10">हेरनी आसा अह ज़ोथा ज़ेही बित्ती अर</para>
  <para style="q" vid="SNG 6:10">एसो मुंह आसा सुरज़ा ज़िहअ प्रैश्शअ अर</para>
  <para style="q" vid="SNG 6:10">अह आसा सैने फ्रहरै ज़ेही शानदार?”<verse eid="SNG 6:10" /></para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />हुंह डेऊअ उंधै खोल़े बूटा जैंदरी</para>
  <para style="q" vid="SNG 6:11">होछ़ी-होछ़ी बुटी भाल़अ कि</para>
  <para style="q" vid="SNG 6:11">दाखे बेला दी डोडी-पाची लागी बी होए अर</para>
  <para style="q" vid="SNG 6:11">नारदाणें बुटी दी फूल खिल्‍लै कि नांईं।<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />ज़ेतरी मुखा थोघ लागअ,</para>
  <para style="q" vid="SNG 6:12">तंऐं ज़गाऊई मेरै दिलै एही खास्सी च़ाह</para>
  <para style="q" vid="SNG 6:12">ज़िहअ टिक्‍कैओ रथ जुधा लै ठुर्हा।<verse eid="SNG 6:12" /></para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />ओ सोभी का सुंदर नार, पिछ़ू फिर,</para>
  <para style="q" vid="SNG 6:13">पिछ़ू फिर, मुंह दै ताह भाल़णैं।</para>
  <para style="sp" vid="SNG 6:13">नार</para>
  <para style="q" vid="SNG 6:13">दूई नाटी मांझ़ै ताह हुंह</para>
  <para style="q" vid="SNG 6:13">किल्है शाची नाच़दी भाल़णीं?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">नर</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />ए मेरी झ़ूरीऐ, तूह आसा राज़े देई ज़ेही!</para>
  <para style="q" vid="SNG 7:1">तेरै खूर ढबा पूल़ा दी बेघै बित्तै,</para>
  <para style="q" vid="SNG 7:1">तेरी ज़ांघा पिछ़लअ घेरअ आसा गैहणैं ज़िहअ बित्तअ</para>
  <para style="q" vid="SNG 7:1">सह ज़ाण्हिंआं कुंणी सज़ाण सनारै बणाअं द।<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />तेरी नाही आसा इहै कुंधल़ू ज़ेही,</para>
  <para style="q" vid="SNG 7:2">ज़ुंण कबल्‍लअ मसालै राल़ै दै दाखे रसा करै भरी रहा।</para>
  <para style="q" vid="SNG 7:2">तेरअ पेट आसा पूणैं दै कणके रूल़ा ज़िहअ</para>
  <para style="q" vid="SNG 7:2">ज़ेथ फेर सुरघे फूल आसा डाहै दै।<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />तेरी दुहै हिक्‍का आसा</para>
  <para style="q" vid="SNG 7:3">हरनीए दोगल़ बच़ै ज़ेही।<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />तेरअ गअल़ आसा हाथी दांदे उछ़टै कोटा ज़िहअ आज़रअ,</para>
  <para style="q" vid="SNG 7:4">तेरी आछी आसा तिन्‍नां पाणींए सअरा ज़ेही,</para>
  <para style="q" vid="SNG 7:4">ज़ुंण हेशबोन नगरीए प्रऊल़ी नेल़ आसा।</para>
  <para style="q" vid="SNG 7:4">तेरअ नाक आसा लाबानोने कोठी ज़िहअ,</para>
  <para style="q" vid="SNG 7:4">ज़ुंण दमिश्क नगरी बाखा पहरअ करा।<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />तेरअ मूंड शोभा ताह दी कर्मेल धारा ज़िहअ</para>
  <para style="q" vid="SNG 7:5">अर तेरअ खुल्हअ मूंड आसा</para>
  <para style="q" vid="SNG 7:5">बैंज़णीं रांगे मुखमले झिकल़ै ज़िहै लोभणैं आल़ै,</para>
  <para style="q" vid="SNG 7:5">तेते गुछ़टी सका कहा राज़ै बी गलाम बणाईं।<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />मेरी झ़ूरीऐ, तूह आसा सच्च़ी बेघै हेरनी शुणनी अर</para>
  <para style="q" vid="SNG 7:6">दिला लोभणैं आल़ी।<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />लाम्मी-पल़ामीं शोभा तूह खज़ूरे बूटा ज़ेही,</para>
  <para style="q" vid="SNG 7:7">तेरी हिक्‍का आसा दाखे लुम्बरू ज़ेही।<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />हुंह बोला आप्पू लै इहअ,</para>
  <para style="q" vid="SNG 7:8">“एऊ खज़ूरे बूटा दी उखल़ी काढणैं मुंह एते फल़।”</para>
  <para style="q" vid="SNG 7:8">तेरी दुहै हिक्‍का आसा मुल्है दाखे लुम्बरू ज़ेही</para>
  <para style="q" vid="SNG 7:8">अर तेरी हिक्‍का का एछा मुंह सेओआ ज़ेही खुशबू।<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />तेरै होठै माख्खू दैणैंओ एछा</para>
  <para style="q" vid="SNG 7:9">बधिया दाखे रसा झुटणैं ज़िहअ मज़अ,</para>
  <para style="q" vid="SNG 7:9">ज़ुंण सुलै-सुलै होठा अर दांदा प्रैंदै बगा।<verse eid="SNG 7:9" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />हुंह आसा मेरै लोभिए अर सह बी च़ाह मुंह।<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />मेरै लोभिआ, एछ, हाम्हां डेऊणअ गराऊंआं का दूर</para>
  <para style="q" vid="SNG 7:11">संघा काटणी हाम्हां सारी राच बणें फूला जैंदरी।<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />दोत्ती-दोत्थी उझ़ुई डेऊणअ हाम्हां दाखे बागा लै हेरा-भाल़ा,</para>
  <para style="q" vid="SNG 7:12">कि दाखे बेला बी टिप्पी अर</para>
  <para style="q" vid="SNG 7:12">फूले डोडी बी खिल्‍ली होए,</para>
  <para style="q" vid="SNG 7:12">अर नारदाणैं बी भाल़णैं हाम्हैं फुल्‍लै कि नांईं।</para>
  <para style="q" vid="SNG 7:12">तिधी करूं हुंह ताल्है खास्सी झ़ूरी।<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />गुआंकल़ी का आसा लागी दी शोभली बास्स,</para>
  <para style="q" vid="SNG 7:13">म्हारै दुआरै आसा नऊंऐं-पराणैं</para>
  <para style="q" vid="SNG 7:13">सोभी रंगे बधिया का बधिया फल़,</para>
  <para style="q" vid="SNG 7:13">मेरै लोभिआ, तिंयां सोभै आसा मंऐं</para>
  <para style="q" vid="SNG 7:13">तेरी तैणीं डाहै दै झाल़ी।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />हुंह सोठा इहअ, ज़ै तूह मेरअ दुधभाई हंदअ,</para>
  <para style="q" vid="SNG 8:1">तै सका ती हुंह सोभी नदरी ताल्है माख्खू दैई,</para>
  <para style="q" vid="SNG 8:1">तै निं कोही हाम्हां लै किछ़ै लाअ त बोली।<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />तै सका ती हुंह ताह आपणैं घअरा लै शादी,</para>
  <para style="q" vid="SNG 8:2">तिधी सका त तूह मुखा शखैल़ी,</para>
  <para style="q" vid="SNG 8:2">मुंह दैणअ त तिधी ताल्है मसालै राल़अ द दाखो रस</para>
  <para style="q" vid="SNG 8:2">अर आपणैं नारदाणैंओ रस झुटणा लै।<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />तेरी खिंज़ी बाह लोल़ी ती मेरै शरैहणैं हुई अर</para>
  <para style="q" vid="SNG 8:3">खाणैं हाथै लोल़ी तंऐं मुल्है मल़्हैची दैनी।<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />एरुशलेम नगरीए बेटल़ीओ, मेरी आसा तम्हां का अरज़,</para>
  <para style="q" vid="SNG 8:4">ज़ेभै तैणीं हाम्हैं झ़ूरी करी पठी निं रज्ज़े तेभै तैणीं निं हाम्हां झ़ैऊई, नां छ़ेल़ी।<verse eid="SNG 8:4" /></para>
  <para style="s">छ़हुई गिह</para>
  <para style="sp">साथणीं</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />अह खारकी बेटल़ी कुंण आसा ज़ुंण आपणैं लोभिए कान्हा नील़ लाई</para>
  <para style="q" vid="SNG 8:5">रेगीस्ताना बाखा आसा एछदी लागी दी।</para>
  <para style="sp" vid="SNG 8:5">नार</para>
  <para style="q" vid="SNG 8:5">मंऐं झ़ैऊअ तूह सेओए बूटा हेठै सुत्तअ द,</para>
  <para style="q" vid="SNG 8:5">ज़िधी तेरी ईज सुंदी हुई अर</para>
  <para style="q" vid="SNG 8:5">ज़िधी तूह हुअ ज़ल्मअ।<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />तूह निं आपणैं दिलै मुंह सुआई होर कोही डाही</para>
  <para style="q" vid="SNG 8:6">अर नां आपणीं बाह दी मुंह छ़ाडी होरी कोही ढाकी,</para>
  <para style="q" vid="SNG 8:6">किल्हैकि झ़ूरी हआ मौता ज़िहअ ज़ोर!</para>
  <para style="q" vid="SNG 8:6">एते ज़ल़ण निं खल़ै ज़िऊंणै दैंदी,</para>
  <para style="q" vid="SNG 8:6">एते आग रहा एही ज़ल़दी लागी,</para>
  <para style="q" vid="SNG 8:6">ज़ेही कि बिधाते आग।<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />एता निं पाणींओ दरैअ बहाऊई सकदअ</para>
  <para style="q" vid="SNG 8:7">अर नां खार समुंदर डबेऊई सकदअ,</para>
  <para style="q" vid="SNG 8:7">एता निं कुंण सेठ मणछ आपणीं</para>
  <para style="q" vid="SNG 8:7">सारी ज़ैदात दैई बी मोलै लई सकदअ।<verse eid="SNG 8:7" /></para>
  <para style="sp">शोहरीए भाई,</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />म्हारी आसा एक च़ेई,</para>
  <para style="q" vid="SNG 8:8">सह निं अज़ी ज़ुआन हुई आथी,</para>
  <para style="q" vid="SNG 8:8">ज़ेभै तैहा लै गल्‍ली एछे,</para>
  <para style="q" vid="SNG 8:8">तेभै हाम्हां किज़ै लागणअ करनअ?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />ज़ै सह च़ेई नगरीए उछ़टी दुआली ज़ेही ज़ुआन हंदी,</para>
  <para style="q" vid="SNG 8:9">तै बणाणैं तै हाम्हां तेसे हिक्‍का लाणा लै च़ंदीए छ़तरू,</para>
  <para style="q" vid="SNG 8:9">ज़ै सह घअरे दुआरा ज़ेही हंदी,</para>
  <para style="q" vid="SNG 8:9">तै बणाणैं तै हाम्हां केल़ुईए काठे पाल्‍लै।<verse eid="SNG 8:9" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />हुंह थिई नगरीए दुआली ज़ेही खारकी,</para>
  <para style="q" vid="SNG 8:10">ऐबै आसा मेरी हिक्‍का उछ़टै कोटा प्रैंदे पुंडरी दी छ़तरू ज़ेही।</para>
  <para style="q" vid="SNG 8:10">ज़ांऊं मेरै लोभी हुंह भाल़ी,</para>
  <para style="q" vid="SNG 8:10">सह हुअ खास्सअ खुश।<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="PSA 45:11">भज. 45:11</ref></char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">नर</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्हमोन नाओंए ज़ैगा थिअ</para>
  <para style="q" vid="SNG 8:11">राज़ै सुलैमानो एक दाखो बाग,</para>
  <para style="q" vid="SNG 8:11">तेऊ डाहै हाल़्है-पहरै लै होर लाई,</para>
  <para style="q" vid="SNG 8:11">ज़ुंण-ज़ुंण तेते हाल़्है-पहरै लै थिऐ,</para>
  <para style="q" vid="SNG 8:11">तिन्‍नैं सोभी दैनअ तेते फल़ो हज़ार-हज़ार च़ंदीए सिक्‍कै पुआज़अ।<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />पर मेरअ दाखो बाग आसा मेरअ आपणअ,</para>
  <para style="q" vid="SNG 8:12">सुलैमाना निं हज़ार च़ंदीए सिक्‍कै दैणें ज़रुरत आथी,</para>
  <para style="q" vid="SNG 8:12">पर तेऊ दैणैं दूई-दूई शौ च़ंदीए सिक्‍कै तिन्‍नां लै</para>
  <para style="q" vid="SNG 8:12">ज़ुंणी तेऊए दाखे बागो हाल़्हअ-पहरअ किअ।<verse eid="SNG 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />मेरी झ़ूरीऐ, तूह कर मुंह संघै गल्‍ला,</para>
  <para style="q" vid="SNG 8:13">मेरै साथी-संघी बी च़ाहा तेरअ बोल शुणनअ।<verse eid="SNG 8:13" /></para>
  <para style="sp">नार</para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />ए मेरै लोभिआ, छ़ेक्‍कअ कर,</para>
  <para style="q" vid="SNG 8:14">खुशबूदार मासले आल़ी धारा बण तूह</para>
  <para style="q" vid="SNG 8:14">घोर्हल़ अर हरनीए बच़ै ज़िहअ।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>