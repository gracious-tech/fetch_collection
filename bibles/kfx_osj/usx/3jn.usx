  <para style="h">3 जोहन्‍ना</para>
  <para style="toc1">जोहन्‍ना लिखी दी चिऊथी च़िठी</para>
  <para style="toc2">3 जोहन्‍ना</para>
  <para style="toc3">3 जोह.</para>
  <para style="mt1">3 जोहन्‍ना</para>
  <para style="mt2">जोहन्‍ना लिखी दी चिऊथी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: जोहन्‍ना</para>
  <para style="ili">पहल़णैं आल़ै: गयुस</para>
  <para style="ili">सन: 80-95</para>
  <para style="ip">जोहन्‍ने चिऊथी च़िठी ती “टोलीए सैणैं” विश्वासी टोलीए एकी सैणैं गयुसा लै लिखी दी। लिखणैं आल़अ दैआ गयुसा लै एते तैणीं शाबाशी किल्हैकि सह करा त होरी मसीही विश्वासीए बडी मज़त। संघा दैआ सह दिमेत्रियुस नाओंए एकी मणछा का बच़दै रहणें चतैनगी बी।</para>
  <para style="imq">“ज़ुंण मणछ बूरअ करा, तम्हैं निं तिन्‍नें नकल करी। पर तम्हैं ज़िऊआ तिन्‍नां मणछा ज़ेही ज़िन्दगी ज़ुंण भलअ करा। भलअ करनै आल़ै मणछ आसा परमेशर लुआद। पर ज़ुंण बूरअ करा, तिन्‍नैं निं परमेशर आथी भाल़अ द।”</para>
  <para style="ipr">(1:11)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1-4</para>
  <para style="io1">गयुसे बड़ैई 5-8</para>
  <para style="io1">दयुत्रिफेसे बारै 9,10</para>
  <para style="io1">दिमेत्रियुसे सर्राफी 11,12</para>
  <para style="io1">नचोल़ 13-15</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />हुंह मसीही टोलीओ सैणअ जोहन्‍ना लिखा ऐहा च़िठी ताह, मेरै पैरै साथी गयुसा लै। हुंह डाहा ताह संघै झ़ूरी किल्हैकि हाम्हैं आसा सत्ता दी।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ए मेरै पैरै साथी, मेरी आसा एही अरज़ कि ज़िहअ तूह विश्वासा दी बझ़दअ आसा लागअ द तिहअ ई लोल़ी तूह सोभी साबै बझ़दअ लागअ अर तूह लोल़ी देही दी राज्ज़ी-राम्बल़अ रहअ।<verse eid="3JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="3JN 1:3" />किल्हैकि ज़ांऊं होरी विश्वासी भाई खोज़अ मुखा कि तूह किहअ शुचअ पाक्‍कअ रही आसा तेऊ सत्ते साबै ज़िन्दगी ज़िऊंदअ, मुंह हुई इहअ शूणीं बडी भाई खुशी। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मुल्है निं एता का बडी होर किछ़ै खुशी आथी ज़ांऊं मंऐं इहअ शूणअ कि ज़ुंण मेरै लान्हैं ज़िहै आसा तिंयां आसा तेऊ सत्ते साबै ज़िन्दगी ज़िऊंदै लागै दै।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुसा लै शाबाश</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ए मेरै पैरै साथी, तंऐं किई तिन्‍नां विश्वासी भाई-बैहण खास्सी मज़त ज़ुंण खुशीए समादा खोज़णा लै हांढदै-फिरदै रहा। इधी तैणीं कि तंऐं किई तिन्‍नां लै बी मज़त ज़ुंण तेरै भेतू-बछ़ैणूं नांईं बी तै। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />ज़सरी तंऐं मज़त किई तिन्‍नां मांझ़ै खोज़अ कई खोज़अ तेरै इधी टोलीए विश्वासी का इहअ कि तूह साथी-संघी विश्वासी लै किहअ झ़ूरा। ऐबै बोला हुंह ताल्है कि तूह रहअ आजू बी इना इहै विश्वासीए हर ज़रुरती लै मज़त करदअ लागी ज़ेभै तिंयां ताह सेटा का होरी ज़ैगा लै आजू डेओआ। किल्हैकि एता करै हआ परमेशर खुश। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />किल्हैकि ईंयां लोग आसा हर ज़ैगा एते तैणीं हांढदै-फिरदै लागै दै कि प्रभूओ बैण सारै दी पुजे। तिंयां निं तिन्‍नां का किछ़ै मांगदै ज़ुंण विश्वासी निं आथी। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />तैही लागा इने आपणैं घअरै बशैल़ी हर गल्‍ले मज़त करनी, ज़िहअ करै हाम्हैं बी तिन्‍नां संघै तेऊ सत्ते बारै खोज़णा लै साझ़ू हई सके।<verse eid="3JN 1:8" /></para>
  <para style="s">दिमेत्रियुस अर दिमेत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मंऐं दैनी ती पैहलै बी तेरी टोलीए लोगा लै च़िठी लिखी पर दिओत्रीफेसे निं मेरी गल्‍ला मनी किल्हैकि सह च़ाहा कबल्‍लअ आप्पू ई मसीही टोलीओ सैणअ रहणअ। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ज़ेभै हुंह एछणअ, मुंह खोज़णअ तेऊए बारै टोलीए सोभी लोगा नदरी कि सह किज़ै करा। सह लाआ बूरी गल्‍ला बोली हाम्हां लै झ़ुठअ दोश, सिधअ एतरअ ता हुअ, सह निं खुशीए समादा खोज़णैं आल़ै हांढदै-फिरदै विश्वासी भाई आपणैं घअरै मंदअ अर ज़ुंण होर विश्वासी मनणअ च़ाहा तिन्‍नां काढा सह टोली का बागै।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ए मेरै पैरै साथीओ, ज़ुंण मणछ बूरअ करा, तम्हैं निं तिन्‍नें नकल करी। पर तम्हैं ज़िऊआ तिन्‍नां मणछा ज़ेही ज़िन्दगी ज़ुंण भलअ करा। भलअ करनै आल़ै मणछ आसा परमेशर लुआद। पर ज़ुंण बूरअ करा, तिन्‍नैं निं परमेशर आथी भाल़अ द। <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />टोली दी बोलअ सोभी कि दिमेत्रिऊस आसा भलअ मणछ अर तेऊए ज़िन्दगी आसा तेऊ सत्ते साबै। हाम्हैं बी बोला इहअ ई कि सह आसा भलअ मणछ। ताखा बी आसा थोघ कि हाम्हैं करा शुची गल्‍ला।<verse eid="3JN 1:12" /></para>
  <para style="s">खिरी अदर करनअ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />होर बी आसा कई गल्‍ला ज़ुंण हुंह च़ाहा कि ताल्है बोलूं, पर हुंह निं तिन्‍नां च़िठी दी लिखणअ च़ाहंदअ। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मुंह आसा एही आशा कि हुंह एछणअ ताह सेटा लै छ़ेक्‍कै अर तेभै करनी मुंह ताह सम्हनै गल्‍ला।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />हुंह करा परमेशरा का अरज़ कि सह ताल्है शांती दैए।</para>
  <para style="p" vid="3JN 1:15">इधी होर सोभै साथी-भाई बी दैआ ताल्है राज्ज़ी-खुशी अर तिधे साथी-भाई लै दैऐ सोभिओ नाअं लई करै राज्ज़ी-खुशी।<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="2JN 1:12">2 जोह. 1:12</ref></char></note><verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>