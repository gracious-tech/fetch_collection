  <para style="h">इब्रानी</para>
  <para style="toc1">इब्रानी बोली बोल़णैं आल़ै यहूदी विश्वासी लै च़िठी</para>
  <para style="toc2">इब्रानी</para>
  <para style="toc3">इब्रा.</para>
  <para style="mt1">इब्रानी</para>
  <para style="mt2">इब्रानी बोली बोल़णैं आल़ै यहूदी विश्वासी लै च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: एता लिखणे तरिकै का ज़ाण्हिंआं इहअ कि अह आसा पल़सी लिखी दी, हई सका कि अह कुंणी होरी होए लिखी दी</para>
  <para style="ili">पहल़णैं आल़ै: ईशू दी विश्वास करनै आल़ै यहूदी</para>
  <para style="ili">सन: 67-69</para>
  <para style="ip">इब्रानी बोली बोल़णैं आल़ै विश्वासीए नाओंऐं च़िठी थिई लिखी दी विश्वासी भाईए एकी बडी टोली लै ज़ुंण लोगे बरोधे बज़्हा मसीही विश्वासा का दूर तै हणैं आल़ै। लिखणैं आल़अ करा तिन्‍नां आपणैं विश्वासा दी रहणा लै खुशी-खुशी रही खासकर ऐहा गल्‍ला खोज़दी कि मसीहा ई आसा परमेशरो असली अर खिरीओ रूप। इहअ करदी दैआ सह सत्ता दी ज़ोर।</para>
  <para style="ip">पैहलै धैऊआ दी खोज़ा सह कि ईशू ई आसा परमेशरो पूत, ज़ुंणी दुख ज़िरी बाब परमेशरो शुचअ हुकम मनणअ शिखल़अ। परमेशरे शोहरूए रुपै आसा ईशू पराणैं बधाने कई परमेशरे गूर, स्वर्ग दूता अर परमेशरे गूर मोसा का महान। दुजै धैऊआ दी खोज़ा सह इहअ कि ईशू बणाअं परमेशरै सारी सदा लै प्रोहत, सह आसा पराणैं बधाने प्रोहता का महान। चिऐ धैऊआ दी खोज़ा सह कि ईशू करै हेरै मणछ पाप, डअर अर मौता का बच़ाऊई अर ईशू दैआ माहा प्रोहते रुपै शुचअ उद्धार, ज़ेतो यहूदी धर्म-बिधी अर पशू बल़ी करै पल़ा सिधअ भैस्स।</para>
  <para style="ip">इज़राईलीए दादा-बाबे कई मशूर मणछे विश्वासे बारै खोज़ी करा लिखणैं आल़अ पहल़णैं आल़ै का विश्वासा दी टेक्‍की रहणें अरज़ गैर्हुऐ धैऊआ दी। बार्हूऐ धैऊआ दी करा सह आपणैं पहल़णैं आल़ै का एही अरज़ कि खिरी तैणीं रहा विश्वासा दी टेक्‍की अर आपणीं आछी डाहा ईशू बाखा लाई, ज़ुंण दुख अर कष्ट तिन्‍नां प्रैंदै एछा; तिन्‍नां ज़िरा सुलै करै। अह च़िठी हआ कई सलाह अर चतैनगी करै खतम।</para>
  <para style="ip">पल़सी खोज़ा इहअ कि इहअ कि मसीहा ईशू ज़िहअ माहा प्रोहत हणैंओ किज़ै मतलब आसा:</para>
  <para style="imq">“म्हारअ माहा प्रोहत ईशू मसीहा रहा म्हारै दाह-दुखा दी हाम्हां संघै, सह परखअ सोभी गल्‍ला लै हाम्हां ज़िहअ, पर तैबी निं तेऊ दी एक पाप बी निखल़अ। एछा, हाम्हां करनी हिम्मत संघा डेऊणअ तेऊ मसीहा नेल़, ज़ुंण स्वर्गे राज़गाद्दी का राज़ करा। तेऊ किई हाम्हां लै एही झींण ज़ेते हाम्हैं हकदार बी नांईं तै आथी। म्हारी खरीए पलका रहणअ सह मसीहा ई हाम्हां लै झणैल़ू अर म्हारी मज़त बी करनी तेऊ ई।”</para>
  <para style="ipr">(4:15,16)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत, मसीहा परमेशरो पूरअ रूप 1:1-3</para>
  <para style="io1">मसीहा स्वर्ग दूता का बी महान 1:4—2:18</para>
  <para style="io1">मसीहा मोसा अर ज़ैहसू का बी महान 3:1—4:13</para>
  <para style="io1">मसीहे प्रोहते महान पदबी 4:14—7:28</para>
  <para style="io1">मसीहे महान करार 8:1—9:28</para>
  <para style="io1">मसीहो महान बल़ीदान 10:1-39</para>
  <para style="io1">महान विश्वास 11:1—12:29</para>
  <para style="io1">खिरी दैनी दी शिक्षा अर नचोल़ 13:1-25</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">ईशू आसा परमेशरो पूत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पैहलै जुगै किई परमेशरै म्हारै दादा-बाबा का कई बारी भांती-भांती करै आपणैं गूरा बाती गल्‍ला, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />एऊ जुगै किई तेऊ इना खिरीए धैल़ै हाम्हां संघै परमेशरै आपणैं पूता बाती गल्‍ला। परमेशरै बणाईं सोभै गल्‍ला तेऊ ई करै। तैही किअ परमेशरै इहअ बच़ार कि सह ई बणाणअं खिरी ऐबै इना सोभी गल्‍ला दी मालक।<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="1CO 8:6">1 करि. 8:6</ref>; <ref loc="JHN 1:3">जोह. 1:3</ref></char></note><verse eid="HEB 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 1:3" />सह शोहरू ई आसा तेऊए प्रतप्पो प्रैश्शअ अर सह तेऊ ई करै लागा हाम्हां का थोघ कि परमेशर किहअ महान आसा, सह आसा हर गल्‍ला दी तेऊ ई ज़िहअ अर तेऊए बैणा दी आसा एही शगती कि सारअ भ्रमंड रहा तिहअ ई काम करदअ लागी ज़िहअ सह आसा, तेऊ किऐ मणछे पाप दूर अर तेखअ बेठअ सह स्वर्गै सर्वशक्तिमान परमेशरे दैहणीं बाखा सोभी का बडी पदबी दी।<verse eid="HEB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />तेऊए एऊ कामां लै दैनी परमेशरै तेऊ लै सोभी का बडअ नाअं ज़ुंण स्वर्ग दूता का बी खास्सी बडी आसा इहअ करै लागा हाम्हां का थोघ कि ज़ुंण शोहरू आसा सह आसा तिन्‍नां का महान।<verse eid="HEB 1:4" /></para>
  <para style="s">ईशू आसा सोभी का बडअ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />किल्हैकि परमेशरे निं स्वर्ग दूता मांझ़ै कोही लै इहअ बोलअ ज़ुंण तेऊ बोलअ ईशू लै बोलअ,<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 शमू. 7:14</ref>; <ref loc="1CH 17:13">1 इति. 17:13</ref>; <ref loc="PSA 2:7">भज. 2:7</ref></char></note></para>
  <para style="q" vid="HEB 1:5">“तूह आसा मेरअ पूत,</para>
  <para style="q" vid="HEB 1:5">आझ़ किअ मंऐं अह प्रगट कि तूह आसा मेरअ पूत!”</para>
  <para style="p" vid="HEB 1:5">इहअ बी निं तेऊ कोही स्वर्ग दूता लै बोलअ,</para>
  <para style="q" vid="HEB 1:5">“हुंह हणअ तेऊओ बाब अर</para>
  <para style="q" vid="HEB 1:5">सह हणअ मेरअ पूत?”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />ज़ांऊं परमेशर आपणैं कल्है ज़ेठै पूता संसारा लै छ़ाडा, तेभै बोला सह इहअ,</para>
  <para style="p" vid="HEB 1:6">“सोभै स्वर्ग दूत टेक्‍का तेऊ सेटा माथअ।”<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:13">बधा. 32:13</ref>; <ref loc="1PE 3:22">1 पत. 3:22</ref></char></note><verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />स्वर्ग दूते बारै बोला परमेशर इहअ,<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">भज. 104:4</ref></char></note></para>
  <para style="q" vid="HEB 1:7">“तेरै दूत आसा पऊंण, तेरै दास आसा बिज़ल़ी।”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />पर पूता लै बोला सह इहअ,<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="PSA 45:5">भज. 45:5</ref></char></note></para>
  <para style="q" vid="HEB 1:8">“हे परमेशर तेरअ राज़ रहणअ जुगै-जुगै तैणीं सदा लै।</para>
  <para style="q" vid="HEB 1:8">तूह करा आपणैं लोगा प्रैंदै नसाफ डाही राज़।<verse eid="HEB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9" />तूह झ़ूरा भलै लै अर कदुष्ट कामां का आसा ताह नफरत।</para>
  <para style="q" vid="HEB 1:9">तैही आसा तूह बिधाता, तेरै परमेशरै आप्पै छ़ांटअ द,</para>
  <para style="q" vid="HEB 1:9">तेऊ किअ तेरअ होरी सोभी साथी का खास्सअ अदर</para>
  <para style="q" vid="HEB 1:9">अर खुशीओ खास्सअ तेल तरैल़ी अभिषेक।”<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />सह बोला पूता लै इहअ बी,<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="PSA 102:25">भज. 102:25</ref>; <ref loc="GEN 1:1">मूल. 1:1</ref></char></note></para>
  <para style="q" vid="HEB 1:10">“हे प्रभू सोभी का आजी बणाईं तंऐं ई पृथूई अर</para>
  <para style="q" vid="HEB 1:10">सारअ भ्रमंड बणाअं तंऐं आपणैं हाथै।<verse eid="HEB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11" />धरती संघी सारअ भ्रमंड हणैं एकी धैल़ै खतम पर तूह रहणअ सदा,</para>
  <para style="q" vid="HEB 1:11">तिंयां सोभै हणैं झिकल़ै ज़िहै पराणैं।<verse eid="HEB 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 1:12" />“ताह च़फल़णै तिंयां मांदरी ज़िहै,<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="HEB 13:8">इब्रा. 13:8</ref>; <ref loc="PSA 102:25-26">भज. 102:25-26</ref></char></note></para>
  <para style="q" vid="HEB 1:12">तिंयां बदल़णैं ताह झिकल़ै ज़िहै पोर्ही</para>
  <para style="q" vid="HEB 1:12">संघा बणाणैं ताह तिंयां नऊंऐं।</para>
  <para style="q" vid="HEB 1:12">पर आप्पू आसा तूह सदा ज़िहअ आसा तिहअ ई,</para>
  <para style="q" vid="HEB 1:12">तेरी अमर निं कधि खतम हंदी।”<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />परमेशरै निं कधू कोही स्वर्ग दूता लै इहअ बोलअ ज़िहअ तेऊ बोलअ ईशू लै बोलअ,<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 22:44">मोत्त. 22:44</ref>; <ref loc="PSA 110:1">भज. 110:1</ref></char></note></para>
  <para style="q" vid="HEB 1:13">“तूह बेश मेरै दैहणै सोभी का बडी पदबी दी,</para>
  <para style="q" vid="HEB 1:13">ज़ेभै तैणीं कि हुंह तेरै दुशमणा</para>
  <para style="q" vid="HEB 1:13">हारी करै सोभी गल्‍लो हक ताल्है निं दैंऊं?”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />तै स्वर्ग दूत किज़ै काम करा? तिंयां आसा परमेशरे च़ाकरी करनै आल़ै। परमेशर छ़ाडा तिन्‍नां स्वर्ग दूता तिन्‍नें हेर-सभाल़ करदै ज़हा मणछा उद्धार भेटा।<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="PSA 103:20-21">भज. 103:20-21</ref></char></note><verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">महान उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />तैही लागा हाम्हां तिंयां गल्‍ला बडी धैन-मन्‍न लाई करनी ज़ुंण हाम्हैं शूणीं दी आसा, ताकि हाम्हैं सत्ता का दूर निं डेओए।<verse eid="HEB 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 2:2" />ज़ुंण समाद परमेशरै स्वर्ग दूता बाती दैनअ तेता करै हुअ हर बगत सत्त प्रगट, अर बधाने ज़ुंण बी गल्‍ला लोगै नांईं मनी तेता लै भेटी तिन्‍नां सज़ा। <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />इहअ किज़ै आसा ज़ुंण हाम्हैं इहअ सोठा कि एऊ महान उद्धारे गल्‍ला नांईं मनी कै हाम्हैं बच़ी जाणैं ज़ुंण प्रभू ईशू आप्पै आसा खोज़अ द? अह उद्धारो समाद आसा हाम्हां लै तिन्‍नैं खोज़अ द ज़ुंणी सह तेऊ का आसा शूणअ द। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />आपणैं दिला-मन्‍नें साबै ज़ेभै परमेशरै च़ाहअ तेऊ दैनअ नछ़ैण, नुआहरै काम, च़मत्कार अर पबित्र आत्मों दान दैई एऊ उद्धारे समादो सबूत।<verse eid="HEB 2:4" /></para>
  <para style="s">म्हारअ उद्धार करनै आल़अ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />परमेशरै निं सह आजू एछणैं आल़अ संसार, ज़ेते बारै हाम्हैं लिखदै आसा लागै, तेतो हक निं तेऊ स्वर्ग दूता लै दैनअ पर सह दैनअ प्रभू ईशू लै। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />पबित्र शास्त्रा दी आसा एकी ज़ैगा परमेशरा लै इहअ बोलअ द,</para>
  <para style="q" vid="HEB 2:6">“कोहै मणछ निं एता जोगी आथी कि तूह तिन्‍नें बारै सोठे?</para>
  <para style="q" vid="HEB 2:6">नां कुंण मणछो शोहरू एता जोगी आथी कि तूह तेऊए हेर-सभाल़ करे?<verse eid="HEB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7" />तंऐं बणाअं मणछ स्वर्ग दूता का धख ई होछ़अ,</para>
  <para style="q" vid="HEB 2:7">तंऐं दैनअ तेऊ लै इज़त अर अदरो मुगट। तेऊ लै दैनअ तंऐं तेऊए हाथे कामां दी हक।<verse eid="HEB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8" />तंऐं दैनअ तेऊ लै सोभी गल्‍ला दी हक।”</para>
  <para style="p" vid="HEB 2:8">इधी ज़ाण्हिंआं इहअ कि परमेशरै किई सोभै गल्‍ला मणछे बशै। एही निं किछ़ै गल्‍ला छ़ुटी ज़ुंण तिन्‍नें बशै निं किई। पर हाम्हां का शुझिआ आझ़ इहअ कि सोभै गल्‍ला निं मणछे बशै आथी।<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भज. 8:6</ref>; <ref loc="1CO 15:27">1 करि. 15:27</ref></char></note><verse eid="HEB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 2:9" />पर हाम्हैं भाल़ा ईशू! सह किअ थोल़ी घल़ी स्वर्ग दूता का धख होछ़अ ताकि सह परमेशरे झींणा करै सह सोभिए तैणीं मरे। तेऊ ज़िरअ दुख अर सह मूंअ, अर तेऊ लै दैनअ प्रतप्प अर अदरो मुगट। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />परमेशरै बणाईं सोभै गल्‍ला अर सोभै गल्‍ला डाही तेऊ आप्पू लै ज़िऊंदी। एता लै किअ परमेशरै इहअ बच़ार कि प्रभू ईशू दुख ज़िरे अर सोभी गल्‍ला दी सिध्द होए ताकि खास्सै मणछ तेऊए प्रतप्पा दी साझ़ू होए। किल्हैकि सह आसा ईशू ई ज़ुंण तिन्‍नां लै उद्धार सका दैई।<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />किल्हैकि ज़ुंण पाप दूर करी पबित्र करा अर ज़ुंण पापा का छ़ुटी पबित्र हुऐ, तिन्‍नां सोभिओ बाब आसा एक्‍कै ई, तैही निं ईशू तिन्‍नां लै आपणैं भाई अर बैहणी बोल़णा लै शरम लागदी। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />मसीहा बोला परमेशरा लै एते बारै इहअ,<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">भज. 22:22</ref></char></note></para>
  <para style="q" vid="HEB 2:12">“ज़ुंण तंऐं किअ, मुंह खोज़णअ तेते बारै आपणैं सोभी लोगा का</para>
  <para style="q" vid="HEB 2:12">मुंह तिन्‍नें सभा दी तेरी ज़ै-ज़ैकार।”<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />तेखअ बोला सह इहअ बी,<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ईशा. 8:17-18</ref>; <ref loc="ISA 12:2">12:2</ref></char></note></para>
  <para style="q" vid="HEB 2:13">“मुंह डाहणअ ताह दी भरोस्सअ।”</para>
  <para style="p" vid="HEB 2:13">तेखअ बोला सह भिई इहअ,</para>
  <para style="q" vid="HEB 2:13">“हुंह आसा तिन्‍नां मणछा संघै ज़ुंण मुल्है परमेशरै दैनै, ईंयां आसा लान्हैं ज़िहै।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />ज़ै कि परमेशर ज़हा लै आपणैं लान्हैं बोला तिंयां बी आसा मणछ अर ईशू बी बणअ तिन्‍नां ई ज़िहअ मास्सा-लोहू आल़अ मणछ। राख्सा का आसा शगती कि मौते डअर रहैऊई करै डरैओए पर मसीहा बणअ मणछ एते तैणीं कि तेऊए मौत होए अर मौता हारी करै सह राख्से शगती खतम करे<verse eid="HEB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 2:15" />अर ज़ेतरै मौतै डरा संघै सारी ज़िन्दगी गलामा ज़िहै तै, सह तिन्‍नां आज़ाद करे।<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ROM 8:3">रोम. 8:3</ref>; <ref loc="COL 2:15">कुलू. 2:15</ref></char></note><verse eid="HEB 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16" />किल्हैकि प्रभू ईशू निं स्वर्ग दूते हेर-सभाल़ करदअ, पर सह करा आबरामे खिंबे हेर-सभाल़।<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="GAL 3:29">गल. 3:29</ref>; <ref loc="ISA 41:8-10">ईशा. 41:8-10</ref></char></note><verse eid="HEB 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 2:17" />एते ई तैणीं लोल़ी त तेऊ कि सोभी गल्‍ला दी आपणैं होरी भाई-बैहणी ज़िहअ मणछ बणें, ज़िहअ करै सह परमेशरो इहअ माहा प्रोहत बणें ज़ुंण झणैल़ू अर शुचअ-पाक्‍कअ होए। ताकि ज़ुंण बल़ीदान तेऊ तिन्‍नां लै किअ तेता करै तिन्‍नें पाप माफ होए। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />किल्हैकि सह परखअ अर तेऊ ज़िरअ दुख, तैही सका सह खरी दी पल़ै दै मणछे मज़त करी।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">ईशू आसा मोसा का महान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />मसीहा दी विश्वास करनै आल़ै मेरै भाई-बैहणीओ, तम्हैं ज़ुंण तेऊ आप्पू संघै स्वर्गे ज़िन्दगी ज़िऊंणां लै आसा शादै दै, ज़हा हाम्हैं मना, तेऊ मसीहा ईशू दी दैआ धैन ज़ुंण परमेशरे खुशीए समादो दूत अर माहा प्रोहत आसा। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />ईशू किई तिंयां सोभै गल्‍ला ज़ुंण परमेशरै तेऊ लै बोलअ त, ज़िहअ मोसा गूरै बी किई शुचअ-पाक्‍कअ रही परमेशरे तिंयां गल्‍ला पूरी ज़ुंण तेऊ लै बोलअ त करना लै।<verse eid="HEB 3:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="HEB 3:3-4" />लोग बणाआं आप्पू लै घअर पर परमेशर आसा इहअ ज़ुंणी सोभै गल्‍ला बणाईं। ज़िहअ घअरा बणाणैं आल़ै घअरा का खास्सअ अदर भेटा, तिहअ ई आसा ईशू बी, तेऊ ई करै बणाईं परमेशरै आपणैं घअरे सोभै गल्‍ला, सह आसा मोसा का खास्सअ अदर करनै जोगी।<verse eid="HEB 3:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 3:5" />मोसा रहअ परमेशरे घअरे सोभी लोगे च़ाकरी करनै आल़ै ज़िहअ शुचअ-पाक्‍कअ कि ज़ुंण गल्‍ला आजू ती हणैं आल़ी, तिन्‍नां गल्‍ला प्रगट करे।<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="NUM 12:7">गण. 12:7</ref></char></note><verse eid="HEB 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 3:6" />मसीहा आसा पूते रुपै परमेशरे घअरे सोभी लोगो सैणअ अर ज़ै हाम्हैं हिम्मत डाही करै आपणीं आशा दी खिरी तैणीं विश्वासा दी मज़बूत रहे तै आसा हाम्हैं तेऊए घअरे टबर।<verse eid="HEB 3:6" /></para>
  <para style="s">विश्वास नांईं करने बारै चतैनगी</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />तै ज़िहअ पबित्र शास्त्रा दी पबित्र आत्मां बोला,<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">लुआ. 17:7</ref>; <ref loc="NUM 20:2-5">गण. 20:2-5</ref>,<ref loc="NUM 20:13">13</ref></char></note></para>
  <para style="q" vid="HEB 3:7">“भलअ हणअ त इहअ, ज़ै तम्हैं आझ़ परमेशरो बोल शुणदै,<verse eid="HEB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8" />परमेशरा संघै निं हठ करदै लागा,</para>
  <para style="q" vid="HEB 3:8">ज़िहअ थारै दादै-बाबै तधू परमेशरा लै द्रोह किअ</para>
  <para style="q" vid="HEB 3:8">ज़धू तिंयां रेगीस्तानै परखै तै।<verse eid="HEB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9" />ज़िधी थारै दाद-बाब च़ाल़्ही साला तैणीं मेरै महान कामां आपणीं आछी भाल़ी बी</para>
  <para style="q" vid="HEB 3:9">मुंह ई परखदै ई रहै लागै।<verse eid="HEB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10" />एता ई पिछ़ू आई मुंह तेऊ जुगे लोगा लै रोश्शै, तेखअ बोलअ मंऐं इहअ</para>
  <para style="q" vid="HEB 3:10">‘इना निं सुंबल़ी सोर ई आथी अर नां ईंयां</para>
  <para style="q" vid="HEB 3:10">इहअ समझ़दै कि हुंह किज़ै च़ाहा कि ईंयां करे!’”<verse eid="HEB 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 3:11" />तेखअ खाऐ मंऐं रोश्शै इहै सोह, “ईंयां निं मेरी बशैघे ज़ैगा कधि पुजणैं।”<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="NUM 14:21-23">गण. 14:21-23</ref>; <ref loc="DEU 1:34-35">बधा. 1:34-35</ref></char></note><verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />भाईओ, ऐहा गल्‍ला लै रहा चतैन कि थारअ मन्‍न निं लोल़ी तेऊ ज़िऊंदै परमेशरे विश्वासा का दूर हुअ। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />हर धैल़ै दैणअ एकी-दुजै लै हैअ। ताकि पाप तम्हां धोखअ दैई थारै मन्‍नां काठै नां करे। एता लै रहा तेभै तैणीं एकी-दुजै लै हैअ दैंदै लागी ज़ेभै तैणीं हाम्हैं “आझ़की धैल़ी” बोला।<verse eid="HEB 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 3:14" />ज़िहै हाम्हैं शुरू दी विश्वासा दी मज़बूत तै, ज़ै तम्हैं तिहै ई खिरी तैणीं रहे तै हणैं हाम्हैं मसीहा दी साझ़ू। <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />ज़िहअ पबित्र शास्त्र बोला,</para>
  <para style="q" vid="HEB 3:15">“भलअ हणअ त इहअ, ज़ै तम्हैं आझ़ परमेशरो बोल शुणदै,</para>
  <para style="q" vid="HEB 3:15">परमेशरा संघै निं हठ करदै लागा,</para>
  <para style="q" vid="HEB 3:15">ज़िहअ थारै दादै-बाबै तधू परमेशरा लै द्रोह करी</para>
  <para style="q" vid="HEB 3:15">परमेशरा लै रोश्श फरेऊई ती।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />कुंणी लोगै फरेऊई परमेशरो बैण शूणीं बी तेऊ लै रोश्शै? कै तिन्‍नैं सोभी निं फरेऊई परमेशरा लै रोश्शै ज़ुंण मोसा संघै मिसर देशे गलामी का छ़ुटी आऐ तै? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />सह च़ाल़्ही साला तैणीं कहा का रहअ रुश्शी? सह कै तिन्‍नां ई का निं रुश्शअ ज़ुंणी पाप किअ, अर तिन्‍नें ल्हासा रही रेगीस्तानै पल़ी?<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="NUM 14:29">गण. 14:29</ref></char></note><verse eid="HEB 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 3:18" />परमेशरै कहा लै बोलअ सोह खाई इहअ कि तम्हैं निं मेरै बशैघे ज़ैगा पुजणैं! पर तिंयां जाणैं पुजी ज़ुंणीं हुकम मनै?<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 106:24-26">भज. 106:24-26</ref></char></note><verse eid="HEB 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 3:19" />एता करै आई हाम्हां अह गल्‍ल समझ़ कि तिंयां निं तिधी तै पुजी सकै किल्हैकि तिन्‍नैं निं परमेशरे गल्‍ला दी विश्वास किअ।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">परमेशरे लोगा लै बशैघ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />ज़ै कि तेऊए बशैघा दी पुजणें करार आझ़ तैणीं आसा, हाम्हां बी लागा डरनअ, हाम्हां मांझ़ै निं लोल़ी कोही का तेऊ बशैघा दी डेऊणेओ मोक्‍कअ छ़ुटअ। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />ज़िहअ हाम्हैं ईशू मसीहो खुशीओ समाद शूणअ, तिहअ ई शूणअ त तिन्‍नैं इज़राईली मणछै बी बशैघे ज़ैगा लै डेऊणेओ खुशीओ समाद। पर तिन्‍नैं निं तेतो विश्वास किअ। इहअ करै निं तेऊ समादो तिन्‍नां लै किछ़ै फाईदअ हुअ।<verse eid="HEB 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 4:3" />तैही ज़ुंणी हाम्हैं परमेशरै बोली दी गल्‍ला दी विश्वास किअ, हाम्हैं डेऊणैं तैहा बशैघे ज़ैगा लै। ज़िहअ परमेशरै आसा आप्पै बोलअ द,</para>
  <para style="q" vid="HEB 4:3">“मंऐं खाऐ रोश्शै इहै सोह,</para>
  <para style="q" vid="HEB 4:3">‘ईंयां निं मेरी बशैघे ज़ैगा कधि पुजणैं।’”</para>
  <para style="p" vid="HEB 4:3">परमेशरै निं इहअ एते तैणीं बोली कि बशैघे ज़ैगा निं अज़ी बणाईं आथी ती। अह ती तधू हेरी दी बणाईं ज़धू संसार बणाअं। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />किल्हैकि सातुई धैल़ीए बारै आसा परमेशरै पबित्र शास्त्रा दी इहअ लिखअ द, “परमेशरै किअ सातुऐ धैल़ै आपणैं सोभै काम करी बशैघ।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />दुजी ज़ैगा बोला पबित्र शास्त्रा दी परमेशर इहअ,</para>
  <para style="p" vid="HEB 4:5">“ईंयां निं मेरै बशैघा दी कधि पुजणैं?”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />तिंयां इज़राईली मणछ ज़हा का सोभी का आजी खुशीओ समाद खोज़अ तिंयां निं बशैघे ज़ैगा पुजी सकै किल्हैकि तिन्‍नैं निं तिहअ किअ ज़िहअ परमेशरै तिन्‍नां लै बोलअ त। पर परमेशरे बशैघे ज़ैगा लै डेऊणेओ मोक्‍कअ आसा अज़ी बी। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />तैही आसा परमेशरै बशैघे ज़ैगा लै डेऊणेओ एक होर बगत काढअ द, अर सह बगत आसा आझ़काला। खास्सी साला पैहलै किअ त एकी ज़मानै म्हारै दादै-बाबै परमेशरा लै द्रोह। परमेशरै आसा दाबेद राज़ै बाती पैहलै ई डाहअ द बोली,</para>
  <para style="p" vid="HEB 4:7">“भलअ हणअ त इहअ ज़ै आझ़ तम्हैं परमेशरो बोल शुणदै, परमेशरा संघै निं हठ करदै लागा।”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">भज. 95:7-8</ref></char></note><verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />हाम्हां का आसा इहअ बी थोघ कि ज़हा बशैघे ज़ैगे बारै परमेशरै करार आसा किई दी, अह निं सह कनान देश आथी ज़िधी लै ज़ैहसू म्हारै दाद-बाब पजैल़ै। पर ज़ै सह कनान देश ई हंदअ तै निं बादा का परमेशरा इहअ बोल़णअ त कि अज़ी बी आसा बशैघे ज़ैगा लै डेऊणेओ होर बगत।<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">बधा. 31:7</ref>; <ref loc="JOS 22:4">ज़ैह. 22:4</ref></char></note><verse eid="HEB 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 4:9" />तैही आसा परमेशरे लोगा लै अज़ी बी एक ज़ैगा बणाईं दी ज़िधी तिन्‍नां पूरअ बशैघ करनअ। तिन्‍नां करनअ तिहअ बशैघ ज़िहअ परमेशर सातुई धैल़ी बशैघ करा। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />परमेशरै किअ आपणैं सोभ काम करी बशैघ। इहअ ई हणअ तिन्‍नां सोभी लै बी ज़ुंण परमेशरा संघै बशैघा दी डेओआ। तिन्‍नां बी करनअ बशैघ ज़ेभै तिंयां आपणअ काम पूरअ करे।<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="REV 14:13">प्रका. 14:13</ref>; <ref loc="GEN 2:2">मूल. 2:2</ref></char></note><verse eid="HEB 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 4:11" />तैही करा तैहा बशैघे ज़ैगा पुजणें मैन्थ, तिन्‍नां ज़िहअ निं कोहै करी ज़ुंणी परमेशरे गल्‍ला शूणीं नां शूणीं किई। तै सका हाम्हैं बशैघे ज़ैगा पुजी।<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="HEB 4:1">इब्रा. 4:1</ref>; <ref loc="2PE 1:10-11">2 पत. 1:10-11</ref></char></note><verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />किल्हैकि परमेशरो बैण आसा ज़िऊंदअ, शगती आल़अ अर दुही बाखा तिछी तलबारा का बी तिछअ। सह करा आत्मां, प्राण, गांठ-गांठ अर हर ज़ोल़ ज़ुदै करी छ़िन्ह-बिन्ह। सह हेरा मन्‍नें गल्‍ला अर म्हारी सोठ परखी।<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JER 23:29">जेर. 23:29</ref>; <ref loc="ISA 55:11">ईशा. 55:11</ref></char></note><verse eid="HEB 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 4:13" />कोहिए निं एही किछ़ै गल्‍ला आथी ज़ुंण तेऊ का थोघ निं आथी ज़ुंण हाम्हां तेऊ का खोज़णीं लागे कि हाम्हैं आपणीं ज़िन्दगी दी किज़ै किअ, तेऊए आछी सम्हनै आसा सोभै गल्‍ला घुआल़ी अर प्रगट।<verse eid="HEB 4:13" /></para>
  <para style="s">माहा प्रोहत</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />ईशू ज़ुंण स्वर्गा लै डेऊअ सह आसा परमेशरो पूत। सह आसा हाम्हां सोभी लै माहा प्रोहत। तैही एछा, हाम्हां रहणअ तेऊए विश्वासा दी पाक्‍कै टेक्‍की ज़ुंण हाम्हैं सोभी नदरी मनअ। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />किल्हैकि म्हारअ माहा प्रोहत ईशू मसीहा रहा म्हारै दाह-दुखा दी हाम्हां संघै, सह परखअ सोभी गल्‍ला लै हाम्हां ज़िहअ, पर तैबी निं तेऊ दी एक पाप बी निखल़अ।<verse eid="HEB 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 4:16" />एछा, हाम्हां करनी हिम्मत संघा डेऊणअ तेऊ मसीहा नेल़, ज़ुंण स्वर्गे राज़गाद्दी का राज़ करा। तेऊ किई हाम्हां लै एही झींण ज़ेते हाम्हैं हकदार बी नांईं तै आथी। म्हारी खरीए पलका रहणअ सह मसीहा ई हाम्हां लै झणैल़ू अर म्हारी मज़त बी करनी तेऊ ई।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />ज़ेभै परमेशर माहा प्रोहत बणाआं, सह छ़ांटा एक मणछ लोगा मांझ़ा का। एऊ मणछा लागा लोगे तैणीं परमेशरे च़ाकरी करनी, सह दैआ परमेशरा लै लोगे भैंट अर बल़ीदान ताकि तिन्‍नें पाप माफ होए। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />एक माहा प्रोहत सका तिन्‍नां लै झींण करी ज़ुंण परमेशरा का पाप करदै शुझिआ, अर ज़हा तेऊए बारै खास्सअ थोघ निं हंदअ। किल्हैकि माहा प्रोहत आसा आप्पू बी मणछ अर पाप करी हआ सह आप्पू बी कमज़ोर। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />तैही लागा तेऊ माहा प्रोहता आप्पू बी आपणैं पापो प्राश्त करना लै पाप बल़ी दैणीं ताकि तेऊए पाप माफ होए। किल्हैकि सह करा आप्पू बी लोगा ई ज़िहअ पाप।<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 16:6">लेब. 16:6</ref></char></note><verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />पर आप्पै निं आप्पू लै कोहै माहा प्रोहते पदबी दैंदअ ज़ेतो एतरअ अदर हआ। पर परमेशर छ़ांटा हरेकी मणछा ऐहा पदबी लै आप्पै ज़िहअ हारण बणाअं पैहलअ माहा प्रोहत।<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">लुआ. 28:1</ref> </char></note><verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />तैही निं प्रभू मसीहा बी माहा प्रोहत हणें बड़ैई आप्पू लई। पर तेऊओ अदर किअ परमेशरै ज़ुंणी सह छ़ांटअ अर तेखअ बोला सह तेऊ लै इहअ,<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भज. 2:7</ref></char></note></para>
  <para style="q" vid="HEB 5:5">“तूह आसा मेरअ पूत,</para>
  <para style="q" vid="HEB 5:5">आझ़ किअ मंऐं अह प्रगट कि तूह आसा मेरअ पूत!”<verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />दुजी ज़ैगा बोला पबित्र शास्त्रा दी परमेशर इहअ,</para>
  <para style="q" vid="HEB 5:6">“तूह हणअ सदा लै माहा प्रोहत, ज़िहअ मल्किसदोक थिअ।”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />ज़धू मसीहा एऊ संसारै देही दी रहअ, तेऊ किई ज़ोरै-ज़ोरै लेरा लाई आछी का आशू बहाऊई करै प्राथणां। तेऊ बोलअ तेऊ परमेशरा का ज़ुंण तेऊ मरनै का बच़ाऊई सका त। परमेशरै शूणीं तेऊए किल्हैकि मसीहा करा त तेऊओ हर गल्‍ला मनी अदर। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />एही ता थिअ ईशू परमेशरो पूत पर तेऊ शिखल़ी दुख ज़िरी अर ज़ान दैई परमेशरे हर गल्‍ला मनणी। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />सोभी गल्‍ला दी सिध्द हई बणअ सह सोभी लै उद्धार दैणैंओ मूल़ ज़ुंण तेऊए गल्‍ला शूणां अर मना।<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ISA 45:17">ईशा. 45:17</ref></char></note><verse eid="HEB 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 5:10" />तेऊ लै दैनी परमेशरै माहा प्रोहते पदबी, ज़िहअ मल्किसदोक थिअ।<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="HEB 2:10">इब्रा. 2:10</ref></char></note><verse eid="HEB 5:10" /></para>
  <para style="s">विश्वासा का दूर हणैंओ फल</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />एते बारै आसा हाम्हां खास्सी गल्‍ला बोल़णा लै, पर एते बारै बाढै लिखणअ आसा एभै कठण, किल्हैकि तम्हां निं परमेशरो बैण एकी बारी बोली समझ़ ई एछदअ।<verse eid="HEB 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 5:12" />तम्हैं आसा खास्सी साला ओर्ही विश्वासी, तेते साबै ता लोल़ी तै तम्हैं होरी सखाऊंणै आल़ै हुऐ, तैबी कै अह ज़रूरी आसा कि कोई तम्हां लै परमेशरे शुरूआती शिक्षा दबारी सखाऊऐ? अर तम्हैं हुऐ इहै लान्हैं ज़िहै कि तम्हां लोल़ी रोटीए बदल़ै अज़ी बी दुध ई। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />किल्हैकि दुधा झुटणैं आल़ै लान्हैं निं परमेशरे साबै धर्मीं ज़िन्दगी ज़िऊंणें थोघ हंदअ किल्हैकि तिंयां आसा अज़ी लान्हैं! <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पर सैणैं लै आसा रोटी, ज़सरी ज्ञैन इंद्री भलै अर बूरै दी भेद समझ़णा लै पाक्‍की हई भैस्सुई आसा गई दी।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />तैही बोला हुंह इहअ कि तिन्‍नां शिक्षे बारै निं आप्पू मांझ़ै गल्‍ला करनी छ़ाडणीं ज़ुंण हाम्हैं पैहली बारी मसीहे बारै आसा शिखल़ी दी। तिंयां गल्‍ला ज़ुंण हर विश्वासी लै शिखल़णीं ज़रूरी आसा। इना मांझ़ै आसा कई एही गल्‍ला ज़ेता करै परमेशर हाम्हां का इहअ खोज़ा कि तिन्‍नां पापी कामां का किहअ करै रहणअ दूर ज़ुंण हाम्हां मौता बाखा लै निंयां। एही ई आसा हाम्हैं कई होर गल्‍ला बी तम्हां का सखाऊई दी। <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />ज़िहै कि कई बारी एकी-दुजै लै हाथ डाही करै प्राथणां करनी अर परमेशरा किहअ करै करने म्हारी मौत हणैं का बाद भिई ज़िऊंदै अर सोभिओ नसाफ करी रहणैं सदा ज़िऊंदै। कई रंगे डुबकी अर सदा रहणैं आल़ी ज़िन्दगीए बारै आसा एही होर बी खास्सी गल्‍ला करना लै तेता होए केभै होरी बारी करी। ज़ै परमेशर हाम्हां लै एतो मोक्‍कअ दैए। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />पर एभै करनी हाम्हां तेते बारै गल्‍ला ज़ुंण समझ़णीं कठण आसा, च़ाऐ किछ़ बी होए तिंयां गल्‍ला आसा एही ज़ेता करै सदा हाम्हां मसीहा दी भरोस्सै करना लै थारी मज़त हणीं।<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />हुंह खोज़ूं इना गल्‍ला तम्हां का बाढै कि ईंयां किल्है आसा ज़रूरी किल्हैकि ज़ुंण विश्वासा का कबाता गऐ पेठी तिन्‍नां निं तेखअ भिई प्राश्त करना लै बापस फरेऊई सकदै। तिन्‍नैं हेरअ सह सत्त बछ़ैणीं ज़ुंण परमेशरा का एछा अर तिन्‍नां गअ स्वर्गा का बरदान अर होरी संघै पबित्र आत्मां भेटी। <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />तिन्‍नैं आसा हेरअ द परखी कि परमेशरो समाद आसा बधिया अर तिन्‍नां का इहअ बी आसा गअ द थोघ लागी कि इहअ बगत आसा एछणैं आल़अ ज़ेभै परमेशरा आप्पै करनअ राज़। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />तिन्‍नां निं केऊ बी साबै भिई बापस फरेऊई सकदै किल्हैकि तिन्‍नैं किअ परमेशरो पूत एकी बारी भिई क्रूसा टोक्‍की करै बेइज़त अर ज़िहअ करै होर लोग मसीहो सुहांग करा।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />ज़हा मणछा शोभली शिक्षा भेटा तिंयां आसा एही ज़िम्मीं ज़िहै ज़िधी सरग हंदअ रहा। ज़ै ज़िम्मीं बधिया होए, तेथ लागा बधिया फसल ज़ेता लै सह बऊई दी आसा अर तेथ हआ परमेशरे बर्गत। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पर होर लोग आसा एही ज़िम्मीं ज़िहै ज़ेथ कज़ेही कांडै-रिंडै लागा। तिन्‍नां लै आसा परमेशरो फिटक पल़अ द अर तिंयां हणैं आगी करै खतम।<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="JHN 15:6">जोह. 15:6</ref></char></note><verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />मेरै पैरै भाईओ, एही ता आसा हाम्हैं एऊ साबै लागै दै बोल्दै, तज़ी बी आसा हाम्हां निहंचअ कि थारी हालत आसा एता का कई राम्बल़ी अर तम्हैं आसा तैहा बाता हांढदै लागै दै ज़ेथ उद्धार आसा। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />परमेशर निं बेनसाफी करदअ, सह निं बिस्सरदअ कि तम्हैं तेऊ लै केही मैन्थ किई, अर होरी विश्वासी आप्पू संघै नढैऊई तम्हैं तेऊ लै किहै झ़ूरै, ज़िहै तम्हैं अज़ी बी आसा करदै लागै दै।<verse eid="HEB 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 6:11" />पर हाम्हैं च़ाहा इहअ कि ज़ेभै तैणीं तम्हैं ज़िऊंदै रहे तेभै तैणीं डाहा सोभी संघै झ़ूरी अर इना भलै कामां रहा करदै लागी। ताकि तम्हां निहंचअ होए कि ज़ेते तम्हैं आशा डाहा सह हणीं पूरी। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />हुंह निं च़ाहंदअ कि तम्हैं लापरबाह होए, पर हुंह च़ाहा इहअ कि तम्हैं तिन्‍नां ज़िहै काम करे ज़ुंण विश्वास अर सबर करी परमेशरै ज़ुंण करार आसा किई दी तैहा बरासते हकदार आसा।<verse eid="HEB 6:12" /></para>
  <para style="s">परमेशरे अटल़ करार</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />परमेशरै ज़धू आबरामा लै ज़बान दैनी, तेता लै निं परमेशरा सम्हनै आप्पू का बडअ कोहै आथी त ज़सरै सोह खाई सह करार करदअ। तेखअ बोलअ परमेशरै आपणैं सोह खाई,<verse eid="HEB 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 6:14" />“मुंह दैणीं सच्च़ी ताल्है बर्गत अर तेरी लुआदा रहणअ मुंह बढाऊंदै लागी।”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:17">मूल. 22:17</ref></char></note><verse eid="HEB 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 6:15" />आबरामै किअ खास्सी साला सबर अर तेखअ भेटअ तेऊ तेतो फल ज़ुंण परमेशरै करार ती किई दी।<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />ज़ेभै मणछ ज़बान दैआ, तिंयां लआ सोह काढणा आप्पू का बडैओ नाअं, अर तिन्‍नें हरेकी झ़गल़ैओ फैंसलअ हआ सोह खाई करै पाक्‍कअ।<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="EXO 22:11">लुआ. 22:11</ref></char></note><verse eid="HEB 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 6:17" />तैही खाऐ परमेशरै बी सोह ज़हा लै तेऊ ज़बान दैनी ती, ताकि तिन्‍नां निहंचअ होए कि परमेशरै ज़ुंण करार तिन्‍नां लै किई, सह हणीं पूरी। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />इहअ करै किई परमेशरै करार अर तेऊ खाऐ तेता लै सोह बी। ईंयां दुहै गल्‍ला निं बदल़ी सकदी, किल्हैकि परमेशर निं झ़ुठअ बोली सकदअ। तेऊ दैनी हाम्हां लै ज़बान कि तेऊ करनी म्हारी मज़त अर तेऊ लाणअ आप्पू लै दोश ज़ै सह म्हारी मज़त नांईं करे। तैही आसा म्हारी आशा परमेशरा दी, ज़िहै हाम्हैं जोश डाही खुशी-खुशी तेऊ नेल़ डेओए।<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="NUM 23:19">गण. 23:19</ref>; <ref loc="1SA 15:29">1 शमू. 15:29</ref></char></note><verse eid="HEB 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19" />ज़ुंण हाम्हां आशा आसा, सह आसा ज़हाज़े लंगरा ज़ेही ज़ुंण पाक्‍कअ रहा टेक्‍की। अह निं हाम्हां परमेशरा का दूर करदी पर अह निंयां हाम्हां भबना भितरी खास पबित्र ज़ैगा लै परमेशरा सेटा।<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="NUM 23:19">गण. 23:19</ref>; <ref loc="1TI 2:13">1 तिम. 2:13</ref></char></note><verse eid="HEB 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 6:20" />ईशू डेऊअ परमेशरा सेटा हाम्हां का आजू ताकि हाम्हैं बी तेऊ संघै परमेशरे तैहा ज़ैगा पुजे। ईशू बणअ सदा लै म्हारअ माहा प्रोहत, ज़िहअ मल्किसदोक माहा प्रोहत थिअ।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मल्किसदोक प्रोहत</para>
  <para style="p">
    <verse number="1-3" style="v" sid="HEB 7:1-3" />अह मल्किसदोक त शालेम नगरीओ राज़अ अर परम प्रधान परमेशरो प्रोहत। तेऊए नाओं मतलब आसा, “धर्मीं राज़अ” अर शालेमो राज़ैओ मतलब आसा, “शांतीओ राज़अ।” तेऊओ ज़ल्म कधू हुअ अर तेऊए ईज-बाब अर दाद-बाब कुंण आसा अर सह कधू मूंअ तेते बारै निं पबित्र शास्त्रा दी किछ़ै आथी लिखअ द। सह थिअ सदा लै प्रोहत। तैही आसा सह परमेशरे पूता ज़िहअ। ज़ांऊं आबराम च़ऊ राज़ै मारी करै जुध ज़िती आअ, तधू आअ मल्किसदोक तेऊ सेटा लै अर तेऊ लै दैनी बर्गत। आबरामै दैनअ तिन्‍नां सोभी शोभली का शोभली किम्मती च़िज़ो दसुअ निसब तेऊ लै ज़ुंण तेऊ जुध ज़िती करै लुटी आणी ती।<verse eid="HEB 7:1-3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />ऐबै दैआ ऐहा गल्‍ला लै धैन कि मल्किसदोक किहअ महान त, ज़हा लै दाद-बाब आबरामै तिन्‍नां शोभली का शोभली किम्मती च़िज़ो दसुअ निसब दैनअ त ज़ुंण तेऊ जुध ज़िती करै लुटी आणी ती? <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेबी खिंबा का ज़हा प्रोहते पदबी भेटा, मोसा गूरो बधान बोला तिन्‍नां लै इहअ कि लेबी खिंबा का आजू ज़ुंण प्रोहत निखल़ा, तिन्‍नां लणअ इज़राईली मणछा का सोभी च़िज़ो दसुअ निसब। किल्हैकि तिंयां आसा तिन्‍नें आपणैं लोग। तिंयां होर प्रोहत अर लोग आसा भाई ज़िहै किल्हैकि तिंयां आसा सोभै आबरामे खिंबा का। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पर अह मल्किसदोक प्रोहत नांईं त लेबी खिंबा का आथी तेऊ ढाकअ आबरामा का दसुअ निसब। एही ता थिअ आबराम सह ज़हा का परमेशरे करार आसा पर तज़ी बी दैनी मल्किसदोक प्रोहतै तेऊ लै बर्गत।<verse eid="HEB 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 7:7" />ऐहा गल्‍ला समझ़ा सोभै कि ज़हा बर्गत भेटा सह हआ तेऊ का होछ़अ ज़ुंण बर्गत दैआ।<verse eid="HEB 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8" />लेबी खिंबे प्रोहत ज़ुंण दसुअ निसब लआ तै, तिंयां बी तै मणछ ज़ुंण मूंऐं। पर मल्किसदोक प्रोहत ज़ुंण दसुअ निसब लआ तेऊए बारै खोज़ा पबित्र शास्त्र इहअ सह आसा अज़ी बी ज़िऊंदअ। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />तै सका हाम्हैं इहअ बी बोली कि लेबी ज़ुंण लोगा का दसुअ हेस्सअ लआ तै तिंयां थिऐ आबरामे आजू लुआद। इहअ करै ज़ांऊं आबरामै मल्किसदोक प्रोहता लै दसुअ निसब दैनअ, तेता लै सका हाम्हैं बोली कि एऊ साबै दैनअ लेबी बी आबरामा बाती मल्किसदोक प्रोहता लै दसुअ निसब। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />किल्हैकि ज़धू मल्किसदोक तेऊए बाब सेटा लै मिलदअ पुजअ, तैहा बगती त सह आपणैं बाबे देही दी।<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 14:18-20">मूल. 14:18-20</ref></char></note><verse eid="HEB 7:10" /></para>
  <para style="s">ईशू आसा मल्किसदोका ज़िहअ माहा प्रोहत</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />लोगा लै दैनअ बधान प्रोहते साबै ज़ुंण लेबी गोत्रा दी हारणे आजू लुआद तै, पर तिन्‍नां प्रोहता करै निं किछ़ै सिध्द हई सकअ। तेखअ पल़ी एकी इहै प्रोहता एछणें ज़रुरत ज़ुंण हारणा ज़िहअ नां हई मल्किसदोक प्रोहता ज़िहअ होए।<verse eid="HEB 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 7:12" />पर हाम्हैं ज़ाणा ऐहा गल्‍ला कि तिंयां प्रोहत निं किछ़ै सिध्द करी सकै किल्हैकि ऐबै आअ मल्किसदोका ज़िहअ एक नऊंअ प्रोहत। ज़ै परमेशरै एक नऊंऐं साबै प्रोहत बणाअं, तेऊ बदल़अ बधान बी।<verse eid="HEB 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 7:13" />हाम्हैं आसा इना गल्‍ला मसीहे बारै लागै दै बोल्दै, ज़ुंण होरी गोत्रा का आसा। तेऊ गोत्रा का निं कोही प्रोहते रुपै बेदी दी च़ाकरी किई। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />ऐहा गल्‍लो आसा हाम्हां का थोघ कि म्हारै प्रभू ईशूओ ज़ल्म आसा यहूदे गोत्रा का हुअ द। यहूदा गोत्रा का प्रोहत निखल़णें बारै निं मोसा गूरै किछ़ै आथी बोलअ द अर नां तेऊ खिंबा का कधू कुंण प्रोहत बणअ।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 49:10">मूल. 49:10</ref>; <ref loc="ISA 11:1">ईशा. 11:1</ref></char></note><verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />ऐबै सका हाम्हैं ऐहा गल्‍ला होर बी राम्बल़ै करै समझ़ी कि बधान गअ ऐबै बदल़ी। किल्हैकि ऐबै गअ दुजै साबो नऊंअ प्रोहत एछी अर सह आसा मल्किसदोक प्रोहता ज़िहअ। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />सह प्रोहत आसा ईशू, सह बणअ प्रोहत, पर तिहअ करै निं बणअ ज़ुंण गल्‍ला लेबी गोत्रा लै परमेशरे बधाना दी ज़रूरी ती। सह बणअ सदा रहणैं आल़ी ज़िन्दगीए शगती करै सदा लै प्रोहत। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />किल्हैकि तेऊए बारै दैआ पबित्र शास्त्र एही शाजत दैनी दी,</para>
  <para style="q" vid="HEB 7:17">“तूह आसा मल्किसदोक प्रोहता ज़िहअ</para>
  <para style="q" vid="HEB 7:17">सदा लै माहा प्रोहत।”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />प्रोहता बणाणेंओ सह पराणअ बधान डाहअ परमेशरै पिछ़ू किल्हैकि तिंयां प्रोहत निं पापी लोगा पबित्र करी सकै। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />मोसा गूरो बधान निं किछ़ू गल्‍ला असली ज़ैगा पजैल़ी सकअ अर तेते ज़ैगा आसा हाम्हां एही बडी आशा ज़ुंण ईशू मसीहा दी आसा, ज़हा करै हाम्हैं परमेशरा नेल़ सका डेऊई।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />परमेशरै खाऐ तेभै बी सोह ज़ेभै तेऊ मसीहा माहा प्रोहत बणाअं। लेबी गोत्रा दी हारणे खिंबा का ज़ुंण प्रोहत हुऐ, तिन्‍नां लै निं परमेशरै सोह खाई एही ज़बान दैनी आथी। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />पर मसीहे बारै आसा परमेशरै आप्पै ज़बान दैनी दी, अर सह निं तेता का हुधदअ, ज़िहअ तेऊ बोलअ,</para>
  <para style="q" vid="HEB 7:21">“तूह हणअ सदा लै माहा प्रोहत, ज़िहअ मल्किसदोक थिअ।”<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />ईशू आसा ऐहा बडी करार पूरी करनैओ भरोस्सअ।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />एथ आसा एक होर फरक बी, कि तिंयां रहै एकी का बाद आजू दुजअ प्रोहत बणदै लागी किल्हैकि तिंयां सोभ मूंऐं ज़ुंण पैहलै तै, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पर ईशू रहणअ जुगै-जुगै, एता करै ई आसा अह प्रोहते पदबी अटल़। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />तैही ज़ुंण ईशू करै परमेशरा सेटा एछा, सह सका तिन्‍नों पूरअ उद्धार करी, किल्हैकि सह आसा तिन्‍नां लै अरज़ करना लै सदा ज़िऊंदअ।<note caller="-" style="x"><char style="xo" closed="false">7:25 </char><char style="xt" closed="false"><ref loc="1JN 2:1-2">1 जोह. 2:1-2</ref>; <ref loc="1TI 2:5">1 तिम. 2:5</ref></char></note><verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />किल्हैकि हाम्हां ती इहै ई माहा प्रोहते ज़रुरत ज़िहअ ईशू आसा। सह आसा पबित्र, तेऊ निं धख बी गलती किई अर सह आसा नर्दोश। ऐबै हेरअ सह परमेशरै संसारे पापी मांझ़ा का दूर करी उझै सोभी का उछ़टै स्वर्गा लै निंईं।<verse eid="HEB 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 7:27" />ईशू निं हारणे खिंबे तिन्‍नां माहा प्रोहता ज़ेही ज़रुरत आथी कि हर धैल़ै आपणैं पापा लै बल़ीदान करे, किल्हैकि ईशू किई सोभै गल्‍ला आप्पू बल़ीदान हई एकी बारी पूरी।<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 16:6">लेब. 16:6</ref>; <ref loc="HEB 10:10">इब्रा. 10:10</ref>,<ref loc="HEB 10:12">12</ref>,<ref loc="HEB 10:14">14</ref></char></note><verse eid="HEB 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 7:28" />किल्हैकि मोसा गूरो बधान छ़ांटा कमज़ोर मणछा लै प्रोहत, पर बधाना दी ज़ुंण परमेशरै ज़बान आसा दैनी दी, सह दैआ तेऊ पूता लै प्रोहते पदबी अर सह बणअ सदा लै सिध्द माहा प्रोहत।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">ईशू आसा म्हारअ माहा प्रोहत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />ऐबै ज़ुंण गल्‍ला हाम्हैं आसा बोल्दै लागै दै, तिन्‍नां मांझ़ै आसा सोभी का बडी गल्‍ल अह कि म्हारअ आसा इहअ माहा प्रोहत ज़ुंण स्वर्गै परमेशरे महान राज़गाद्दी दी दैहणीं बाखा सोभी का बडी पदबी दी आसा बेठअ द।<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भज. 110:1</ref>; <ref loc="HEB 10:12">इब्रा. 10:12</ref></char></note><verse eid="HEB 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 8:2" />म्हारअ माहा प्रोहत करा स्वर्गै सोभी का खास पबित्र ज़ैगा असली खिम्भा भितरी च़ाकरी, ज़ुंण मणछे हाथै निं आथी बणाअं द। पर सह आसा परमेशरै आप्पै बणाअं द।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />किल्हैकि हरेक प्रोहता हआ लोगे पाप माफी लै भैंट अर बल़ीदान दैणें तैणीं, तैही आसा अह ज़रूरी कि म्हारै माहा प्रोहत ईशू का बी लोल़ी किज़ै भैंट दैणा लै हुअ। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />ज़ै मसीहा पृथूई दी हंदअ तै निं सह कधि माहा प्रोहत हंदअ, किल्हैकि पृथूई दी आसा मोसा गूरे बधाने साबै भैंट दैणैं आल़ै प्रोहत। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />ईंयां प्रोहत ज़ुंण करा सह आसा सिधी नकल अर तेते छ़ैल्‍ली ज़ुंण स्वर्गै आसा। पर तिहअ निं आथी ज़ुंण स्वर्गै असली दी आसा। ज़िहअ मोसा ज़धू खिम्भ बणाईं लाअ त, तेऊ लै दैनी परमेशरै अह चतैनगी, “भाल़ै, ज़िहअ-ज़िहअ ताखा मंऐं धारा खोज़अ त, तेऊ ई साबै बणाऐं सोभै गल्‍ला।”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="EXO 25:20">लुआ. 25:20</ref></char></note><verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />पर म्हारै माहा प्रोहत ईशू मसीहा लै ज़ुंण प्रोहतो काम दैनअ सह काम आसा होरी प्रोहते कामां का खास्सअ महान। किल्हैकि सह ज़हा करारो खणोढी आसा सह आसा पराणीं करारा का राम्बल़ी अर तिंयां हआ राम्बल़ी च़िज़े बाहिदै आसरै किई दी।<verse eid="HEB 8:6" /></para>
  <para style="s">नऊंईं करार</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />किल्हैकि, ज़ै तिंयां पैहली करारा नर्दोश हंदी, तै निं दुजी करार करने ज़रुरत पल़णीं ती। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पर परमेशर बोला तिन्‍नां लै दोश लाई करै,</para>
  <para style="q" vid="HEB 8:8">“प्रभू बोला इहअ, ‘आजू एछणैं इहै धैल़ै कि मुंह करनीं इज़राईल अर यहूदा संघै नऊंईं करार।<verse eid="HEB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9" />करार निं तेता ज़ेही हणीं</para>
  <para style="q" vid="HEB 8:9">ज़ुंण मंऐं तिन्‍नें दादा-बाबा संघै तधू किई ती</para>
  <para style="q" vid="HEB 8:9">ज़धू मंऐं तिंयां मिसर देशा का काढी आणै।</para>
  <para style="q" vid="HEB 8:9">किल्हैकि तिंयां निं मेरी करारा लै शुचै-पाक्‍कै रहै</para>
  <para style="q" vid="HEB 8:9">अर मंऐं डाही तिन्‍नां बाखा लै पिठ फरेऊई।’ प्रभू बोला इहअ ई।”<verse eid="HEB 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 8:10" />तेखअ बोला प्रभू इहअ,</para>
  <para style="q" vid="HEB 8:10">“ज़ुंण नऊंईं करार मुंह तिन्‍नां धैल़ै बाद</para>
  <para style="q" vid="HEB 8:10">इज़राईली संघै करनी,</para>
  <para style="q" vid="HEB 8:10">सह आसा एही कि मुंह पाणअ आपणअ बधान तिन्‍नें मन्‍नैं,</para>
  <para style="q" vid="HEB 8:10">अर सह डाहणअ मुंह तिन्‍नें दिलै लिखी।</para>
  <para style="q" vid="HEB 8:10">हुंह हणअ तिन्‍नों परमेशर अर तिंयां हणैं मेरी परज़ा।<verse eid="HEB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11" />तेखअ निं तिन्‍नां साथी-संघी अर</para>
  <para style="q" vid="HEB 8:11">भाई बंधा का खोज़णअ पल़णअ कि बिधातो अदर करा।</para>
  <para style="q" vid="HEB 8:11">किल्हैकि तिन्‍नां सोभी का हणअ मेरअ थोघ</para>
  <para style="q" vid="HEB 8:11">च़ाऐ तिंयां आम मणछ होए या</para>
  <para style="q" vid="HEB 8:11">राज़ करनै आल़ै मशूर मणछ होए।<verse eid="HEB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12" />मुंह करनै तिन्‍नें पाप माफ अर</para>
  <para style="q" vid="HEB 8:12">तेखअ निं मुंह तिन्‍नें गलती आद डाहणीं।<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />“नऊंईं करार” दैई किई प्रभू आप्पै पैहली करार पराणीं अर ज़ुंण च़ीज़ पराणीं अर खई आल़ी हआ, तेसो खतम हणअ आसा ज़रूरी।<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">जेर. 31:31-34</ref></char></note><verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">संसारे खिम्भा भितरी च़ाकरी</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पैहली करारा दी दैनी परमेशरै इज़राईली मणछा लै च़ाकरी करने बिधी अर तेऊ बोलअ तिन्‍नां लै पृथूई दी च़ाकरी करने पबित्र ज़ैगा बणाणां लै। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />मतलब तिन्‍नैं बणाअं एक खिम्भ अर तेथ ती दूई पांडा, बाघली पांडा त सदीअ अर च़ौकी अर भैंट दैनी दी रोटी, अर तेता लै बोला तै पबित्र ज़ैगा।<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 25:23-30">लुआ. 25:23-30</ref>; <ref loc="EXO 26:1-30">26:1-30</ref></char></note><verse eid="HEB 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 9:3" />तेखअ त तिधी एक पल्दअ अर तेथ पिछ़ू ती दुजी पांड ज़ेता लै खास पबित्र ज़ैगा बोला तै।<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">लुआ. 26:31-33</ref></char></note><verse eid="HEB 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 9:4" />तैहा पांडा ती सुन्‍नैं करै मल़्ही दी बेदी अर धनैरअ, अर च़ऊ बाखा का सुन्‍नैं करै महल़अ द काठो मणशू ज़हा लै करारो मणशू बोला तै, अर तेथ त खाण करै भरअ द एक सुन्‍नेंओ पटारू अर हारणे शोठी ज़ेथ नऊंईं टिरा बी थिई निखल़ी दी अर तिंयां करारे तगती।<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 16:33">लुआ. 16:33</ref>; <ref loc="EXO 25:10-16">25:10-16</ref>; <ref loc="EXO 30:1-6">30:1-6</ref>; <ref loc="NUM 17:8-10">गण. 17:8-10</ref>; <ref loc="DEU 10:3">बधा. 10:3</ref>,<ref loc="DEU 10:5">5</ref></char></note><verse eid="HEB 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 9:5" />तेता प्रैंदै तै प्रतप्पा आल़ै करूब, तिन्‍नें फैंख तै मणशूए ढक्‍कणा प्रैंदै फुआरुऐ दै ज़ेता लै प्राश्ते ज़ैगा बोला, इना गल्‍ला बाढै खोज़णेंओ बगत निं एभै आथी।<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">लुआ. 25:18-22</ref></char></note><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />इहअ करै करा तै तिंयां खिम्भा भितरी काम-काज़। तेखअ डेओआ त प्रोहत धैल़ बाघली पांडा लै। तिंयां करा तै तेथ परमेशरे च़ाकरी ज़िहअ तिन्‍नां लै तेतो बधान आसा त खोज़अ द।<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="DEU 27:21">बधा. 27:21</ref></char></note><verse eid="HEB 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 9:7" />पर दुजी पांड ज़ेता लै खास पबित्र ज़ैगा बोला तै तिधी डेओआ त माहा प्रोहत सिधअ साला दी एकी बारी अर सह निंयां त आप्पू संघै बल़ीदान करी लोहू, ताकि ज़ुंण तेऊ आप्पू होरी लोगे भलै भूल-च़ूक हुई, तिंयां माफ होए।<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="EXO 30:10">लुआ. 30:10</ref>; <ref loc="LEV 16:2">लेब. 16:2</ref></char></note><verse eid="HEB 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 9:8" />इना सोभी गल्‍ला करै करा पबित्र आत्मां ऐहा गल्‍ला बाखा शारअ कि ज़ेभै तैणीं खिम्भे बाघली पांड आसा तेभै तैणीं निं सोभी आम लोगा लै भितरी खास पबित्र ज़ैगा तैणीं डेऊणे बात प्रगट हुई।<verse eid="HEB 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9" />अह खिम्भ आसा आझ़कै ज़मानैं समझ़णा लै एक कथ्या कि ज़हा दी एही भैंट अर बल़ीदान प्रोहत च़ढाऊआ तै, तेता करै निं च़ाकरी करनै आल़ेए सोर-समझ़ कधि सिध्द हई सकदी ती। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />किल्हैकि तिंयां थिऐ सिधै खाणैं पिणें च़िज़ा अर कई रंगे न्हैऊंण बिधीए साबै देही लै तेभै तैणीं बधान, ज़ेभै तैणीं कि तेतो किज़ै होर राम्बल़अ समाधान निं होए।<verse eid="HEB 9:10" /></para>
  <para style="s">मसीहे लोहूए शगती</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पर ज़ांऊं मसीहा म्हारअ माहा प्रोहत बणी आअ, तेऊ आणी ईंयां शोभली गल्‍ला ज़ुंण एभै हाम्हां का आसा। तेखअ डेऊअ सह परमेशरा सेटा स्वर्गा लै, सह आसा भितरे खास पबित्र ज़ैगा ज़िहअ, पर अह निं एऊ संसारो आथी ज़ुंण परमेशरै बणाअं। अह आसा तेऊ खिम्भा का बधिया ज़ुंण मोसा गूरै ऐहा पृथूई दी बणाअं किल्हैकि सह आसा सिध्द। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />तेऊ निं अह होरी प्रोहता ज़िहअ गाभू-छ़ेल्हूए लोहू करै किअ, पर तेऊ किअ आपणअ ई बल़ीदान करी लोहू क्रूसा दी बहाऊई करै एकी बारी खास पबित्र ज़ैगा लै डेऊई सोभिओ सदा लै छ़ुटकारअ।<verse eid="HEB 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 9:13" />किल्हैकि, ज़ै गाभू छ़ेल्हूओ लोहू अर बाछ़ीओ छ़ार छ़ल़िकी देही शुची पबित्र हआ,<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:3">लेब. 16:3</ref>,<ref loc="LEV 16:14-16">14-16</ref>; <ref loc="NUM 19:9">गण. 19:9</ref>,<ref loc="NUM 19:17-19">17-19</ref></char></note><verse eid="HEB 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 9:14" />तै मसीहा ज़ुंणी आप्पू ई अमर आत्मां करै परमेशरे सम्हनै आपणअ नर्दोश लोहू बल़ीदान किअ, सह सका थारी सोर मौता बाखा निंणै आल़ै कामां का पबित्र लोहू करै शुची करी ताकि तम्हैं ज़िऊंदै परमेशरे च़ाकरी करी सके।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />तैही आसा मसीहा परमेशरा अर लोगा मांझ़ै नऊंईं करारो खणोढी, ताकि हाम्हैं ज़ुंण परमेशरै आसा शादै दै हाम्हैं तैहा बरासते साझ़ू सदा लै होए ज़ेते तेऊ करार आसा किई दी। किल्हैकि पैहली करारा दी हाम्हैं ज़ुंण पाप किऐ तै तेते सज़ा का बच़ाऊंणा लै दैनी तेऊ म्हारी तैणीं आपणीं ज़ान।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />करार हआ बसीहता ज़ेही, तेता लै हआ ऐहा गल्‍लो सबूत दैणअ ज़रूरी कि ज़ुंणी बसीहत आसा करी डाही दी सह गअ मरी। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />किल्हैकि बसीहत हआ मरी करै ई पूरी, अर ज़ेभै तैणीं बसीहत करनै आल़अ ज़िऊंदअ आसा, तेभै तैणीं निं सह बसीहत किछ़ू कामें हंदी।<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />पैहली करार बी हआ ती पशूए लोहू करै पूरी ज़ेभै प्रोहत तिन्‍नों बल़ीदान करा तै। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />किल्हैकि ज़ांऊं मोसा सोभी लोगा का बधाने सोभी गल्‍ला समझ़ाऊई मुक्‍कअ, तिन्‍नैं आणअ गाभू-छ़ेल्हू अर मिम्मूंओ लोहू, पाणीं, लाल ऊन, ज़ुफा, संघा छ़ल़िकअ तैहा कताबा दी अर सोभी लोगा दी।<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="LEV 14:4">लेब. 14:4</ref>; <ref loc="NUM 19:6">गण. 19:6</ref></char></note><verse eid="HEB 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 9:20" />तेखअ बोलअ तिन्‍नां लै इहअ, “अह लोहू करा परमेशरे तैहा करारा पाक्‍की ज़ुंण परमेशरै तम्हां लै आसा दैनी दी।”<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">लुआ. 24:8</ref></char></note><verse eid="HEB 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 9:21" />एऊ ई साबै छ़ल़िकअ मोसा खिम्भा भितरी अर परमेशरे च़ाकरी करने सारै समाना दी बी लोहू।<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">लेब. 8:15</ref>,<ref loc="LEV 8:19">19</ref></char></note> <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />मोसा गूरै खोज़ै दै बधाने साबै करा तै सोभी च़िज़ा लोहू करै शुची अर बाझ़ी लोहू बहाऐ निं पाप माफी हंदी।<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">लेब. 17:11</ref></char></note><verse eid="HEB 9:22" /></para>
  <para style="s">मसीहे बल़ीदाना करै पाप-माफी</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />तैही ज़ुंण सह खिम्भ आसा, सह आसा स्वर्गे असली पबित्र च़िज़ो एक नकल अर छ़ैल्‍ली ज़िहअ, तेता बी करा तै पशूए लोहू करै शुचै। पर स्वर्गै असली च़िज़ा लै लोल़ी पशूए लोहू का बी बडअ बल़ीदान ज़ुंण पबित्र होए।<verse eid="HEB 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24" />किल्हैकि मसीहा बी निं तेऊ हाथा करै बणाऐं दै खिम्भा भितरी डेऊअ ज़ुंण स्वर्गे असली पबित्र ज़ैगे नकल अर छ़ैल्‍ली थिई, पर सह डेऊअ स्वर्गै ताकि सह हाम्हां लै परमेशरे सम्हनै शुझिए।<verse eid="HEB 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 9:25" />इहअ निं कि सह भिई-भिई बल़ीदान करे, ज़िहअ माहा प्रोहत हर साल पशूओ बल़ीदान करी लोहू निंईं खिम्भा भितरी पबित्र ज़ैगा डेओआ। <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />ज़ै इहअ ज़रूरी हंदअ, संसार शुरू हणैं ओर्ही लागणअ त मसीहा कई बारी आपणअ बल़ीदान करनअ। पर एभै एऊ जुगे हुअ खिरी सह प्रगट ताकि आपणअ बल़ीदान दैई एकी ई बारी सह सोभिए पाप दूर करी सके।<verse eid="HEB 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27" />ज़िहअ मणछा लै एकी बारी मरनअ अर नसाफ हणअ पैहलै ई का आसा पाक्‍कअ किअ द,<note caller="-" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2 करि. 5:10</ref>; <ref loc="ECC 12:14">ज्ञैन. 12:14</ref></char></note><verse eid="HEB 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 9:28" />तिहअ ई हुअ मसीहा बी हरेकी मणछे पाप दूर करना लै बल़ीदान। सह एछणअ एकी बारी भिई तिन्‍नां बच़ाऊंदअ फिरी ज़ुंण तेऊ न्हैल़ै भाल़ै आसा लागै दै नां कि पापे तैणीं भिई बल़ीदान हणां लै।<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="1PE 2:24">1 पत. 2:24</ref>; <ref loc="TIT 2:13">तित. 2:13</ref></char></note><verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">मसीहा हुअ सोभी लै एकी ई बारी बल़ीदान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />किल्हैकि मोसा गूरो बधान थिअ आजू एछणैं आल़ी शोभली गल्‍ले छ़ैल्‍ली, सह निं असली रूप आथी, तेऊ बधाने साबै लागा तै हर साल भिई-भिई बल़ीदान करनअ पर तेता करै निं परमेशरे च़ाकरी करनै आल़ेए पाप खतम हई सकदै तै। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />ज़ै च़ाकरी करनै आल़ेए पाप खतम हुऐ हंदै, तै हणीं ती तिन्‍नां च़ाकरी करनै आल़ेए पाप करने सोर बी शुची, तेखअ निं तिन्‍नां भिई-भिई बल़ीदान करने ज़रुरत पल़णीं ती।<verse eid="HEB 10:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="HEB 10:3-4" />पर गाभू-छ़ेल्हू अर झ़ोटैओ बल़ीदान करी निं तिन्‍नें पाप दूर हई सकदै तै। पर तेता करै फिरा ती लोगा हर साल तिन्‍नें किऐ दै पापे आद।<verse eid="HEB 10:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />तैही बोलअ तधू मसीहा परमेशरा लै ज़धू सह एऊ संसारा लै आअ,</para>
  <para style="q" vid="HEB 10:5">“तूह निं बल़ीदान अर भैंट च़ाहंदअ,</para>
  <para style="q" vid="HEB 10:5">पर तंऐं दैनी मुल्है मेरी देही ज़ेता हुंह भैंट दैई सकूं।<verse eid="HEB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6" />नां तंऐं हूम बल़ीदान करना लै बोलअ, नां तंऐं पाप-माफी लै पाप बल़ी मांगी।<verse eid="HEB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7" />तेखअ बोलअ मसीहा इहअ, ‘हे परमेशर,</para>
  <para style="q" vid="HEB 10:7">हुंह आसा इधी भाल़, किल्हैकि</para>
  <para style="q" vid="HEB 10:7">तेरी बधाने कताबा दी आसा मेरै बारै लिखअ द।</para>
  <para style="q" vid="HEB 10:7">मेरी खुशी आसा सह ई कि मुंह करनअ तिहअ ई ज़िहअ तूह च़ाहा।’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />बधान बोला इहअ कि पाप माफी लै दैणीं भैंट अर हूम अर मेल़-ज़ोल़ो बल़ीदान। पर मसीहा बोला इहअ कि परमेशर निं इना गल्‍ला च़ाहंदअ!<verse eid="HEB 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 10:9" />तेखअ बोला मसीहा इहअ,</para>
  <para style="q" vid="HEB 10:9">“हे परमेशर, हेर, हुंह गअ एछी,</para>
  <para style="q" vid="HEB 10:9">मुंह करनअ तिहअ ज़िहअ तूह बोले।”</para>
  <para style="p" vid="HEB 10:9">इहअ बोली किई तेऊ पैहली करार पूरी ताकि दुजी करार सिध्द होए। <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />किल्हैकि परमेशर च़ाहा त इहअ कि सह हाम्हां ईशू मसीहे देहीओ बल़ीदान करी एकी ई बारी सोभी पबित्र करे।<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="HEB 10:14">इब्रा. 10:14</ref></char></note><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />पराणीं करारे साबै करा तै प्रोहत हर धैल़ै बेदी सम्हनै खल़्हुई करै च़ाकरी। तिंयां करा तै हर धैल़ै बल़ीदान ज़ुंण कधि पाप दूर निं करी सकदै।<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38-39">लुआ. 29:38-39</ref></char></note><verse eid="HEB 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 10:12" />पर म्हारअ माहा प्रोहत मसीहा हुअ आप्पू ई म्हारै पापा पिछ़ू बल़ीदान, सह बल़ीदान आसा सारी सदा लै। ऐबै आसा सह परमेशरे दैहणीं बाखा सोभी का बडी पदबी दी बेठअ द। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />सह रहणअ तेभै तैणीं बणी ज़ेभै तैणीं कि तेऊए दुशमण हारी करै तेऊए खूरा हेठै करी लए।<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भज. 110:1</ref></char></note><verse eid="HEB 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 10:14" />तेऊए एकी बल़ीदाना करै किऐ मसीहा तिन्‍नें पाप सदा लै दूर ज़ुंण तेऊ परमेशरा सेटा आणै। <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />पबित्र आत्मां बी खोज़ा हाम्हां का एते बारै इहअ बोली कि प्रभू बोला इहअ,<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="HEB 8:12">इब्रा. 8:12</ref>; <ref loc="JER 31:34">जेर. 31:34</ref></char></note><verse eid="HEB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16" />“ज़ेभै सह बगत एछे,</para>
  <para style="q" vid="HEB 10:16">तेभै करनी मुंह तिन्‍नां संघै नऊंईं करार</para>
  <para style="q" vid="HEB 10:16">मुंह पाणअ आपणअ बधान तिन्‍नें मन्‍नैं,</para>
  <para style="q" vid="HEB 10:16">अर सह डाहणअ मुंह तिन्‍नें दिलै लिखी।<verse eid="HEB 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HEB 10:17" />मुंह करनै तिन्‍नें पाप माफ अर तेखअ निं मुंह तिन्‍नें गलती आद डाहणीं।”<verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />“ऐबै ज़ै तिन्‍नें सारै पाप माफ गऐ हई, ऐबै निं पाप माफी लै होर बल़ीदान दैणें ज़रुरत आथी।”<verse eid="HEB 10:18" /></para>
  <para style="s">परमेशरा नेल़ डेओआ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />मसीहा दी मेरै भाई-बैहणीओ, ईशू मसीहे मौता करै आसा ऐबै हाम्हैं तैहा खास पबित्र ज़ैगा लै डेऊणा लै पूरै आज़ाद। <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />आपणअ बल़ीदान करी खोल्ही ईशू हाम्हां लै भितरी परमेशरा सेटा खास पबित्र ज़ैगा डेऊणा लै नऊंईं बात ताकि हाम्हैं सदा ज़िऊंदै रहे। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />तैही आसा म्हारअ इहअ माहा प्रोहत, ज़ुंण परमेशरे घअरे स्वर्गे पबित्र ज़ैगो प्रोहत आसा।<verse eid="HEB 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 10:22" />तै एछा, हाम्हां डेऊणअ परमेशरा नेल़ शुचै मन्‍न अर पूरै विश्वासा संघै। किल्हैकि म्हारी दोशी सोर शुची करना लै हेरअ मसीहो लोहू छ़ल़िकी अर म्हारी देही हेरी शुचै पाणीं करै धोई।<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="EPH 5:26">इफि. 5:26</ref>; <ref loc="1PE 3:21">1 पत. 3:21</ref>; <ref loc="EZK 36:25">एज. 36:25</ref></char></note><verse eid="HEB 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23" />आपणीं आशा दी डाहणअ पाक्‍कअ विश्वास। किल्हैकि ज़ुंणी करार आसा किई दी, सह परमेशर आसा शुचअ। <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />ऐहा गल्‍लो डाहणअ खास धैन कि आप्पू मांझ़ै एकी दुजे किहअ करै सका झ़ूरी अर भलै कामां करना लै मज़त करी। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />आप्पू मांझ़ै कठा हणअ निं छ़ाडी, ज़िहअ कि कई भैस्स आसा, पर एकी-दुजै रहा समझ़ाऊंदै लागी, अर ज़िहअ-ज़िहअ प्रभूए फिरी एछणें धैल़ै तम्हैं नेल़ एछदअ भाल़े, तिहअ-तिहअ रहै होर बी खास्सै मिलदै-ज़ुल़दै लागी।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />किल्हैकि सत्त बछ़ैणनै का बाद बी ज़ै हाम्हैं ज़ाणीं भुझ़ी करै पाप करे, तै निं पाप माफ करना लै होर किछ़ै बल़ीदान आथी। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />हाँ, सज़ा लै एक डरैऊंणै आल़ी धैल़ी अर आगीए कूंडा जैंदरे ज़ल़ण आसा बाकी, ज़ेथ परमेशरे दुशमण भस्सम करनै।<verse eid="HEB 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 10:28" />ज़ुंण मोसा गूरो बधान चोल़ा तै, तिन्‍नां पाआ तै तेभै झींण किऐ बाझ़ी मारी ज़ेभै तिन्‍नें खलाफ दूई या चअन मणछ शाजत दैए।<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">बधा. 17:6</ref>; <ref loc="DEU 19:15">19:15</ref></char></note><verse eid="HEB 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 10:29" />पर ऐहा गल्‍ला सोठा कि मसीहा आसा परमेशरो पूत। ज़ै कुंण तेऊए करारो बरोध करा अर तेऊए बल़ीदाना निक्‍कै समझ़ा अर तेऊ लोहू नांईं मंदअ ज़ेता करै परमेशरै तेऊ मणछे पाप माफ किऐ, ज़ै सह मणछ पबित्र आत्मों बरोध करे ज़ुंणी तेऊ लै झींण किई, तेऊ लै दैणीं परमेशरा डरैऊंणी अर घोर सज़ा।<note caller="-" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="HEB 12:25">इब्रा. 12:25</ref></char></note><verse eid="HEB 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30" />किल्हैकि हाम्हैं ज़ाणा तेऊ, ज़ुंणी इहअ बोलअ,</para>
  <para style="q" vid="HEB 10:30">“बदल़अ लणअ आसा मेरअ काम,</para>
  <para style="q" vid="HEB 10:30">मुंह लणअ आप्पै बदल़अ।”</para>
  <para style="p" vid="HEB 10:30">तेखअ बोलअ इहअ बी,<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">बधा. 32:35-36</ref>; <ref loc="PSA 135:14">भज. 135:14</ref></char></note></para>
  <para style="q" vid="HEB 10:30">“प्रभू करनअ आपणैं लोगो नसाफ।”<verse eid="HEB 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 10:31" />अह हणीं बडी डरैऊंणी गल्‍ल ज़ै ताह सर्वशक्तिमान ज़िऊंदअ परमेशर कैद करे अर ताल्है सज़ा दैए।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />तिन्‍नां धैल़ै करा आद ज़धू तम्हां पैहली बारी मसीहे सत्तो थोघ लागअ। तम्हैं केतरअ दाह-दुख ज़िरअ! पर तज़ी बी रहै तम्हैं विश्वासा दी बणी। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />थारी किई कई बारी लोगै खुल्है आम निंदा अर दुख-सांगट ज़िरदी बणै लोगा लै तमास्सै। कई बारी हुऐ तम्हैं तिन्‍नें विश्वासी भाईए मसीबता दी साझ़ू, ज़सरी एही ई बूरी दशा बिति। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />ज़ुंण मसीहा दी विश्वास करनै पिछ़ू कैद तै किऐ दै, तम्हैं निं सिधै तिन्‍नां लै झणैल़ू रहै, पर तम्हैं दैनी खुशी-खुशी आपणीं ज़ैदात विश्वास नांईं करनै आल़ै बी निंणै। किल्हैकि तम्हां का थिअ थोघ कि तम्हां लै आसा एता का बधिया सदा रहणैं आल़ी ज़ैदात स्वर्गै डाही दी।<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />आपणीं खरी दी निं प्रभू दी भरोस्सै करने आपणीं हैअ छ़ाडा, किल्हैकि तेतो भेटणअ तम्हां बडअ फल। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />किल्हैकि तम्हां लागा सबर करनअ ज़रूरी, ताकि परमेशरे मरज़ी पूरी करी तम्हां करारो फल भेटी सके। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />ज़िहअ पबित्र शास्त्रा दी परमेशर मसीहे बारै बोला,<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="HAB 2:4">हब. 2:4</ref>; <ref loc="GAL 3:11">गल. 3:11</ref></char></note></para>
  <para style="q" vid="HEB 10:37">“एछणैं आल़अ आसा छ़ेक्‍कै एछणैं आल़अ,</para>
  <para style="q" vid="HEB 10:37">तेऊ निं खास्सी बल़ैग पाणीं।<verse eid="HEB 10:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38" />ज़ुंण लोग मंऐं विश्वासा करै धर्मीं बणाऐं तिंयां रहणैं ज़िऊंदै,</para>
  <para style="q" vid="HEB 10:38">हुंह निं तिन्‍नां का खुश हंदअ ज़ुंण विश्वासा का पिछ़ू हटा।”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />पर हाम्हैं निं तिन्‍नां मणछा ज़िहै आथी ज़ुंण विश्वासा का पिछ़ू हटा अर बरैबाद हआ। हाम्हैं आसा खिरी तैणीं विश्वास डाहणैं आल़ै ज़सरी आत्मां बच़णीं।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">पाक्‍कै विश्वास करनै आल़ै</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />विश्वास आसा एतो निहंचअ कि हाम्हां भेटणीं तिंयां गल्‍ला पाक्‍कै दी ज़ेते हाम्हैं आशा डाहा अर भरोस्सअ करनअ कि ज़ुंण च़िज़ा हाम्हैं भाल़ी निं आथी तिंयां आसा असली दी। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />म्हारै दादा-बाबो त इहअ ई विश्वास। तैही त परमेशर तिन्‍नां करै खुश।<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />विश्वासा करै ई लागा हाम्हां का थोघ कि सारअ भ्रमंड आसा बणाअं द परमेशरै आपणैं बैणा करै। ज़हा च़िज़ा हाम्हैं भाल़ा, तिंयां बणाईं परमेशरै तेता करै ज़ेता हाम्हैं भाल़ी निं सकदै।<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">मूल. 1:1</ref>; <ref loc="JHN 1:3">जोह. 1:3</ref>; <ref loc="PSA 33:6">भज. 33:6</ref>,<ref loc="PSA 33:9">9</ref></char></note><verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />आदमीए शोहरू आबलै किअ परमेशरा दी विश्वास, तेऊ च़ढाऊअ परमेशरा लै आपणैं बडै भाई कैना का राम्बल़अ बल़ीदान। परमेशर हुअ आबले बल़ीदाना करै खुश अर तेऊ लै बोलअ परमेशरै आप्पै कि सह थिअ धर्मीं। आबल ता नाठअ मरी पर हाम्हैं शिखल़ा आझ़ बी तेऊ का परमेशरा दी विश्वास करने बारै।<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-5">मूल. 4:3-5</ref>,<ref loc="GEN 4:10">10</ref></char></note><verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />हणोक करा त परमेशरा दी विश्वास अर सह निंयं परमेशरै तेऊए ज़िऊंदी ज़िता स्वर्गा लै। तैही निं कोही तेऊए ल्हास भेटी। स्वर्गा निंणै का आजी किअ तेऊ परमेशर हर गल्‍ला दी खुश, इहअ आसा तेऊए बारै पबित्र शास्त्रा दी लिखअ द।<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">मूल. 5:21-24</ref></char></note><verse eid="HEB 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 11:6" />ज़ै लोग विश्वास करे, तेता करै सका परमेशर खुश हई, किल्हैकि परमेशरा सेटा एछणैं आल़ै लोल़ी विश्वास किअ कि सह आसा। ज़ुंण शुचै मन्‍नैं परमेशरा लोल़ै हआ लागै दै तिन्‍नां लै दैआ सह तेतो फल।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />नूहै किअ परमेशरै खोज़ी दी तिन्‍नां गल्‍ला दी विश्वास कि आजू हणीं पाणीं करै प्रल़या ज़ुंण तेऊ ज़मानैं भाल़ी नां हेरी ती। तिन्‍नां गल्‍ला दी विश्वास करी बणाअं तेऊ परमेशरे डरा हेठै रही एक बडअ ज़हाज़ ज़ेता करै सह अर तेऊए सारै टबर बच़ै। इहअ करै संसारे होर लोग ज़ुंणी विश्वास निं किअ तिंयां मूंऐं सोभ अर नूह बणअ विश्वासा करै धर्मीं।<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">मूल. 6:13-22</ref>; <ref loc="GEN 7:1">7:1</ref></char></note><verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />आबरामै बी किअ विश्वास अर तेऊ किअ तिहअ ई ज़िहअ परमेशरै तेऊ लै बोलअ त। सह लागअ परमेशरे गल्‍ला दी विश्वास करी आपणैं देशा गराऊंआं छ़ाडी तेऊ देशा बाखा लै हांढदअ ज़ुंण परमेशरै तेऊ लै दैणअ किअ त। तेऊ का निं थोघ बी त कि किधा लै डेऊणअ पर तज़ी बी लागअ सह हांढदअ।<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1">मूल. 12:1</ref></char></note><verse eid="HEB 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 11:9" />ज़ुंण देश परमेशरै आबरामा लै दैणअ किअ त, तिधी रहअ आबराम परदेसी ज़िहअ खिम्भ खल़अ करी तेऊ डेरै दी। तिहै ई तेऊओ शोहरू इसहाक अर तेऊओ पोचअ याकब ज़हा परमेशरा का सह ई करार भेटी, तिंयां बी रहै खिम्भा दी।<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 26:3">मूल. 26:3</ref>; <ref loc="GEN 35:12">35:12</ref>,<ref loc="GEN 35:27">27</ref></char></note><verse eid="HEB 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 11:10" />किल्हैकि तिंयां थिऐ स्वर्गे तैहा सदा रहणैं आल़ी नगरी न्हैल़ै लागै दै, ज़ेते पाक्‍की आथरी आसा अर ज़ेतो कारीगीर अर बणाणैं आल़अ परमेशर आप्पै आसा।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />आबरामै किअ विश्वास अर परमेशरै दैनअ तेऊ लै इहअ बल कि तेऊओ हुअ शोहरू तेभै गअ त सह खास्सअ प्रोढअ हई अर तेऊए लाल़ी सारा बी थिई बांढी अर प्रोढी गई दी हई। परमेशरै बोलअ तैहा लै कि तेरअ हणअ एक शोहरू अर आबरामै किअ भरोस्सअ कि परमेशरा करनअ तिहअ ई ज़ेही तेऊ करार आसा किई दी।<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 17:19">मूल. 17:19</ref>; <ref loc="GEN 18:11-14">18:11-14</ref>; <ref loc="GEN 21:2">21:2</ref></char></note><verse eid="HEB 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 11:12" />आबराम थिअ खास्सअ प्रोढअ हई गअ द अर सह थिअ मरनै ई आल़अ, पर सह हुअ खास्सै मणछो दाद-बाब तेऊए लुआद हुई आजू सरगे तारै, समुंदरे रेता ज़िहै खास्सै ज़ेता कुंण गणी निं सकदअ।<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 2:12">मूल. 2:12</ref>; <ref loc="GEN 15:5">15:5</ref></char></note><verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />ईंयां सोभै ज़ुंण परमेशरा दी विश्वास करा तै, ईंयां मूंऐं सोभै तिन्‍नां गल्‍ला भेटणैं का आजी ज़ुंण परमेशरै इना लै दैणीं किई ती। तिंयां गऐ ऐहा गल्‍ला समझ़ी कि परमेशरै ज़ुंण बोलअ तेऊ करनअ तिहअ ई अर ऐहा गल्‍ला बी गऐ तिंयां समझ़ी कि तिंयां आसा पृथूई दी परदेसी अर मसाफर।<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">मूल. 23:4</ref>; <ref loc="1CH 29:15">1 इति. 29:15</ref></char></note><verse eid="HEB 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 11:14" />ईंयां गल्‍ला करा तिन्‍नां मणछा बाखा शारअ ज़ुंण इहअ बोला कि हाम्हैं आसा ऐहा पृथूई दी परदेसी अर किधा होरी ज़ैगा का आऐ दै। एता करै हआ अह गल्‍ल प्रगट कि तिंयां थिऐ तेऊ देशा लोल़ै लागै दै ज़ुंण तिन्‍नों आपणअ होए अर तिंयां तिधी बस्से।<verse eid="HEB 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 11:15" />ज़हा देशा का तिंयां आऐ तै, ज़ै तिन्‍नां तेऊ ई देशे बारै धैन हंदअ, तिंयां सका तै तेऊ देशा लै बापस फिरी। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पर तिंयां थिऐ एकी सोभी का बडै देशे मतलब स्वर्गे च़ाहा डाहणैं आल़ै, परमेशर हआ त तिन्‍नां लै खुश ज़ेभै सह तिन्‍नां लै इहअ बोला त कि ईंयां आसा मेरै आपणैं लोग। परमेशरै बणाईं तिन्‍नां लै एक नगरी बी।<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="EXO 3:6">लुआ. 3:6</ref>,<ref loc="EXO 3:15">15</ref></char></note><verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />विश्वासा करै ई आबराम ज़धू परखअ त, तेऊ निंयं आपणअ शोहरू इसहाक बल़ीदान करना लै। ज़सरै बारै परमेशरै करार ती किई दी।<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-10">मूल. 22:1-10</ref></char></note><verse eid="HEB 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 11:18" />ज़हा शोहरू लै परमेशरै इहअ बोलअ त, “इसहाका ई का हणीं आजू तेरी आद-लुआद।” पर सह थिअ आपणैं तेऊ कल्है शोहरूओ बल़ीदान करना लै तैर।<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">मूल. 21:12</ref></char></note><verse eid="HEB 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19" />आबरामा त इहअ विश्वास कि, ज़ै इसहाक मरे बी, परमेशर सका तेऊ मरी करै भिई ज़िऊंदै करी। ज़ै दुजै साबै सोठे; आबरामा भेटअ आपणअ शोहरू मरी करै ज़िऊंदअ। <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />इसहाक करा त परमेशरा दी विश्वास, तैही किई तेऊ परमेशरा का प्राथणां कि मेरै मरनै का बाद दैणीं आजू मेरै दुही शोहरू एसाब अर याकबा लै तैहा करारे बर्गत।<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-40">मूल. 27:27-40</ref></char></note><verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />विश्वासा करै ई दैनी याकबै मरदी बारी युसुफे दूई शोहरू लै बर्गत. याकब फिरअ मांज़े शरैहणां बाखा उटअ संघा टेक्‍कअ माथअ।<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 47:31">मूल. 47:31</ref>; <ref loc="GEN 48:15">48:15</ref>,<ref loc="GEN 48:16">16</ref></char></note><verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />युसुफै किअ परमेशरा दी विश्वास, ज़ांऊं मिसर देशै तेऊए मरने घल़ी पुजी, तेऊ खोज़ी इज़राईलीए मिसर देशा का आज़ाद हणें गल्‍ला अर तेऊ डाहअ आपणैं लोगा का बोली कि ज़ेभै तम्हैं इधा का छ़ुटे, मेरै हस्तू बी पजैल़ै आप्पू संघा तिधी।<note caller="-" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">मूल. 50:24-25</ref>; <ref loc="EXO 13:19">लुआ. 13:19</ref></char></note><verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />ज़ांऊं मिसर देशे राज़ै इहअ हुकम दैनअ कि ज़ेतरै बी इज़राईलीए शोहरू आसा ज़ल्मैं दै तिन्‍नां पाआ मारी, तेखअ डाहअ विश्वासा करै ई मोसा गूरे ईज-बाब सह पैईदा हणैं का बाद चिई भिन्‍नैं तैणीं च़ोरी। किल्हैकि तिन्‍नैं भाल़अ कि अह निं आम शोहरू ज़िहअ आथी अर तिंयां निं राज़ैए हुकमा का डरै।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 1:22">लुआ. 1:22</ref>; <ref loc="EXO 2:2">2:2</ref></char></note><verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />मिसर देशे माहा राज़ेए देई निंयं मोसा; संघा बणाअं आपणअ शोहरू। पर ज़ांऊं सह ज़ुआन हुअ, विश्वासा ई करै किअ तेऊ नांईं कि सह आसा राज़ेए देईए लुआद।<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:11">लुआ. 2:11</ref></char></note><verse eid="HEB 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 11:25" />तेऊ समझ़अ इहअ ठीक कि थोल़ै धैल़ै पापा दी सुख-भुगतणै का आसा परमेशरे लोगा संघै दुख भुगतणअ ई भलअ। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />तेऊ समझ़अ मसीहा पिछ़ू, परमेशरा लै बेइज़ती हणअ तेऊ मिसर देशे ज़ैदात अर भढारा का खास्सअ ठीक। किल्हैकि तेऊ का थिअ थोघ कि तेऊ भेटणअ तेतो फल स्वर्गै।<note caller="-" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 पत. 4:14</ref>; <ref loc="MAT 5:12">मोत्त. 5:12</ref></char></note><verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />किल्हैकि मोसा किअ परमेशरा दी विश्वास तैही छ़ाडअ तेऊ मिसर देश। तेऊ निं ऐहा गल्‍लो फिकर किअ कि तेऊए मिसर देशा छ़ाडणैं करै हणअ राज़अ तेऊओ दुशमण। सह लागअ हांढदअ किल्हैकि सह रहअ तेऊ परमेशरा भाल़अ लागी ज़हा कोहै निं भाल़ी सकदअ।<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="EXO 10:28-29">लुआ. 10:28-29</ref></char></note><verse eid="HEB 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 11:28" />विश्वासा करै ई मनी तेऊ ऊवार्णे अर मिम्मूंए लोहू छ़ल़िकणें बिधी, कि ज़ेठै शोहरू मारनै आल़अ दूत इज़राईली मणछा लै कोई हान्‍नी नां करे।<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-29">लुआ. 12:21-29</ref></char></note><verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />विश्वासा करै ई डेऊऐ इज़राईली मणछ लाल समुंदरा बाती पारा बाखा लै इहै, ज़िहै शुक्‍की ज़ैगा बाती हांढा! अर ज़ांऊं मिसर देशे राज़े सपाही बी तिहअ ई किअ, तिंयां मूंऐं सोभ समुंदरै पाणीं दी डुबी।<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">लुआ. 14:21-31</ref></char></note><verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />किल्हैकि इज़राईली मणछ करा तै परमेशरा दी विश्वास, तिंयां रहै साता धैल़ी तैणीं जेरिहो नगरीए दुआली फेर फेरी दैंदै लागी। तेखअ ढूल़ी दुआल। ज़िहअ परमेशरै तिन्‍नां का बोलअ त।<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />राहाब ती कंज़री पर तैहा किअ विश्वास, अर तैहा दैनअ तिन्‍नां इज़राईली मणछा लै लुक्‍की रहणा लै आसरअ ज़ुंण जेरिहो नगरीए भेद लंदै तै आऐ दै। इहअ करै निं सह तिन्‍नां मणछा संघै मारी ज़ुंण परमेशरो बरोध करा तै।<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JAS 2:25">याक. 2:25</ref>; <ref loc="JOS 2:11-12">ज़ैह. 2:11-12</ref>; <ref loc="JOS 6:21-25">6:21-25</ref></char></note><verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />ऐबै निं मुंह खास्सी गल्‍ला खोज़णें ज़रुरत आथी। मुखा निं ऐबै तिन्‍नां सोभिए बारै खोज़णेंओ बगत आथी कि पांच़ गिदोन, बराक, शिमशोन, जपताह, राज़अ दाबेद, परमेशरो गूर शमूएल अर परमेशरे होरी गूरे बारै शुरू ओर्ही बाढै खोज़ूं। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />तिन्‍नैं किअ विश्वासा ई करै कई देश ज़िती करै तेथ राज़, तिन्‍नैं किअ भलअ अर तिन्‍नां भेटी तिंयां च़िज़ा ज़ुंण परमेशरै तिन्‍नां लै दैणीं किई ती। सिह निं तिन्‍नां खाई सकै, आग निं तिन्‍नां दहई सकी अर तलबार निं तिन्‍नां मारी सकी! <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />तिन्‍नां लै दैआ त परमेशर तेभै होर बी शगती ज़ेभै तिंयां धख कमज़ोर हआ तै, जुधा दी बी निखल़ै जोधै, तिन्‍नैं दरल़ाऊऐ दुशमणे सपाही सातै-बातै। <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />कई बेटल़ी भेटै आपणैं मूंऐं दै भिई ज़िऊंदै, कई रहै तेभै तैणीं मारा खांदै लागी ज़ेभै तैणीं तिन्‍नें मौत निं हुई, तिन्‍नां लै भेटै ईंयां दुख तै कि दुशमण बोला तै तिन्‍नां लै इहअ, “ज़ै तम्हैं परमेशरा दी विश्वास करनअ छ़ाडे तै सका हाम्हैं तम्हां लै छ़ुटकारअ दैई।”</para>
  <para style="p" vid="HEB 11:35">पर तिंयां निं आपणअ विश्वास छ़ाडी कैद खानै का छ़ुटणअ च़ाहंदै तै। किल्हैकि तिन्‍नैं समझ़अ पृथूई दी ज़िऊंणै का खास्सअ परमेशरा संघै सदा लै ज़िऊंदै रहणअ ठीक। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />कई लोग बणाऐं सुहांगा-मखौला लै, कई च़िक्‍कै कोल़ै करै, कई डाहै बान्हीं अर कई परखै कैद करी। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />कई विश्वासी पाऐ पात्थरा करै मारी, कई च़िरै आरै करै, कई पाऐ तलबारा करै काटी। इना लोगा मांझ़ै होर लोग रहै बाझ़ी ढब्बै-धेल्‍लै दाह-दुख ज़िरदी भेडा-बाकरीए खाला बान्हीं ढेक्‍कै-डुआरै नाल़ा-धारा खोखा दी रल़ाखदै लागी। <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />तिंयां रहै पृथूई दी उज़र रेगीस्तानै, धारा, डुआरै जुहल़ी कज़िधल़ी पल़ी।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />अह संसार त तिन्‍नां लै दुशमण, सह नांईं त तिन्‍नां विश्वासी जोगी आथी, तिन्‍नें विश्वासा भाल़ी हुअ परमेशर बी खुश, तैबी निं तिन्‍नां तिंयां गल्‍ला भेटी ज़ेते परमेशरै करार ती किई दी, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />किल्हैकि परमेशर च़ाहा तेता का बी बधिया दैणअ, सह निं सिधअ तिन्‍नां लै आथी पर सह आसा हाम्हां लै बी। परमेशर च़ाहा त तिन्‍नां सिध्द करनअ पर सिधअ हाम्हां संघै।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">बाब परमेशर नैरा आपणैं शोहरू कष्ट दैई</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />हाम्हां फेर आसा खास्सै मणछ ज़सरी ज़िन्दगी करै हाम्हां का थोघ लागा कि विश्वासो किज़ै मतलब हआ। तै एछा हरेक रोक्‍कणै आल़ी च़िज़ा अर उलझ़ण पाणै आल़ै पाप दूर करी ठुर्हा तैहा ठुर्हा दी सबर डाही करै ज़ेथ हाम्हां ठुहर्नअ लागा। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />विश्वासा बणाणैं आल़ै अर सिध्द करनै आल़ै ईशू मसीहा दी डाहा आछी टकैल़ी। तेऊ आसा हाम्हां लै आजू खुशी डाही दी, तेता लै निं तेऊ लाज़ शरमें कोई बी परबाह किई अर क्रूसो दुख ज़िरी बेठअ परमेशरे राज़गाद्दी दी दैहणीं बाखा सोभी का बडी पदबी दी।<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="1PE 2:23-24">1 पत. 2:23-24</ref>; <ref loc="TIT 2:13-14">तित. 2:13-14</ref></char></note><verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />ईशूए बारै सोठा ज़ुंणी नफरत करनै आल़ै पापी लोगे हाथै सबर करी हर दाह-दुख ज़िरअ, ताकि तम्हैं आशा छ़ाडी हिम्मत नां हारे।<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />तम्हैं निं पापे खलाफ इहअ दुख ज़िरअ कि ज़िधी लोग तम्हां मारी पाए। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />तम्हैं गऐ परमेशरे तिन्‍नां हैअ दैणैं आल़ै बैणा बिस्सरुई ज़ुंण तम्हां लै आपणैं लान्हैं हणें नातै आसा खोज़ै दै। सह बोला इहअ,</para>
  <para style="q" vid="HEB 12:5">“हे मेरै लान्हैंआ, प्रभूए इना गल्‍ला दी दै धैन ज़ेभै सह ताल्है ऐहा गल्‍ला प्रगट करे कि तूह आसा गलत,</para>
  <para style="q" vid="HEB 12:5">अर ज़ेभै सह ताह नैरदअ लागे तेभै निं हिम्मत छ़ाडी।<verse eid="HEB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6" />किल्हैकि प्रभू ज़हा संघै झ़ूरी करा, तेऊ दैआ नैरनीं बी,</para>
  <para style="q" vid="HEB 12:6">ज़हा सह आपणअ शोहरू बणाआं; तेऊ लै बाहा शोठी बी।”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />तम्हैं ज़िरा दुख सबक समझ़ी, परमेशर करा तम्हां संघै शोहरू समझ़ी बर्ताअ, इहअ कुंण शोहरू आसा, ज़हा तेऊओ बाब नैरदअ निं आथी?<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">सैणीं. 3:11-12</ref>; <ref loc="DEU 8:5">बधा. 8:5</ref>; <ref loc="2SA 7:14">2 शमू. 7:14</ref></char></note><verse eid="HEB 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 12:8" />ज़ै तम्हां बाब तिहअ नांईं नैरा ज़िहअ सह आपणैं होरी शोहरू नैरा, एतो मतलब आसा इहअ कि तम्हैं निं तेऊए असली शोहरू आथी तै आसा तम्हैं कहा होरीए लुआद।<verse eid="HEB 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9" />तेखअ ज़ै म्हारअ संसारे देहीओ बाब बी हाम्हां नैरना लै शोठी च़का, अर हाम्हैं करा एता लै तिन्‍नों अदर। तै कै अह ठीक निं आथी कि हाम्हैं म्हारै स्वर्गै रहणैं आल़ै बाबे डरा हेठै रही ज़िऊंदै रहे।<verse eid="HEB 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 12:10" />संसारे बाबे शोठी, हआ हाम्हां नैरना लै सिधी थोल़ै धैल़ै ज़िहअ तिन्‍नां आपणैं साबै ठीक लागा, पर परमेशर च़का म्हारै फाईदे तैणीं हर बगत शोठी ताकि सह हाम्हां इहै पबित्र करे ज़िहअ सह पबित्र आसा। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />ज़ेभै हाम्हां सज़ा भेटा सह निं हाम्हां तेभै ठीक लागदी, हाम्हैं हआ तेभै खास्सै दुखी पर तैबी ज़ुंण तेता ज़िरदी-ज़िरदी पाक्‍कै आसा गऐ दै हई, बादा का भेटा तिन्‍नां तेतो फल मेल़-ज़ोल़ अर धर्म।<verse eid="HEB 12:11" /></para>
  <para style="s">समझ़ अर चतैनगी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />एते तैणीं करा ढिलै हाथा अर दुबल़ै ज़ान्हूं आज़रै।<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ईशा. 35:3</ref></char></note><verse eid="HEB 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 12:13" />ओर्ही-पोर्ही भाल़ै निं लागा, आज़री बाता लागा हांढदै ज़ुंण ईशू सेटा लै डेओआ, ताकि ज़ुंण हाम्हां मांझ़ै आत्मां दी दुबल़ै आसा तिंयां निं लोल़ी कबाता पेठै पर तिन्‍नों विश्वास लोल़ी मज़बूत हुअ।<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">सैणीं. 4:26</ref></char></note><verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सोभी संघै डाहणअ मेल़-ज़ोल़, पबित्र ज़िन्दगी ज़िऊंणें कोशिश करनी, ज़ुंण पबित्र होए सह सका परमेशरा भाल़ी।<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="1PE 3:11">1 पत. 3:11</ref>; <ref loc="PSA 34:14">भज. 34:14</ref></char></note><verse eid="HEB 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 12:15" />एकी-दुजैओ डाहा धैन, इहअ निं हआ कि कुंण परमेशरे जशा बाझ़ी एही रहे, या किज़ै विश्वास नांईं करनै ज़िहअ कल़ुअ ज़लैल़अ निखल़ी कष्ट दैए। कई आसा गऐ दै एऊ बिशा करै भ्रष्ट हई।<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="2JN 1:8">2 जोह. 1:8</ref>; <ref loc="DEU 29:18">बधा. 29:18</ref></char></note><verse eid="HEB 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 12:16" />इहअ निं हआ कि कोई मणछ पापी होए, या ज़िहअ कदुष्ट आबरामो पोचअ एसाब थिअ, ज़ुंणी रोटी पिछ़ू आपणअ ज़ेठै हणें पदबी आपणैं भाऊ का बेच़ी पाई।<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="COL 3:5">कुलू. 3:5</ref>; <ref loc="GEN 25:31-34">मूल. 25:31-34</ref></char></note><verse eid="HEB 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 12:17" />तम्हां का आसा ऐहा गल्‍लो थोघ कि बादा का ज़ांऊं तेऊ आपणैं बाबा का बर्गत लणी च़ाही, सह निं तेऊ भेटी, अर लेरा-पकारा पाई बी निं तेऊ ज़ेठै हणैंओ हक अर बर्गत पाणैओ मोक्‍कअ भेटअ।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तम्हैं निं इज़राईली मणछा ज़िहै तैहा सीनाई धारा सेटा आऐ, ज़ेता छ़ुंहीं सका तै, अर ज़ेथ आग ती लागी दी, ज़ेथ काल़ै बादल़ तै, न्हैरै अर ढिश-बागर ती। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />तिन्‍नैं शूणीं नादे एही छ़ेल़ कि सह थिई एही डरैऊंणी कि तिन्‍नैं पाई परमेशरा सेटा लैल़ा पकारा कि ऐबै निं होर गल्‍ला करी आथी।<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="EXO 20:18-21">लुआ. 20:18-21</ref>; <ref loc="DEU 5:23">बधा. 5:23</ref>,<ref loc="DEU 5:25">25</ref></char></note><verse eid="HEB 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 12:20" />किल्हैकि तिन्‍नैं बोलअ इहअ एते तैणीं कि तिंयां निं एऊ हुकमा ज़िरी सकदै, “ज़ै कोई पशू बी तैहा धारा छ़ूंऐं; तेऊ बी पाऐ मारी” लोग तै डरै दै।<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">लुआ. 19:12-13</ref></char></note><verse eid="HEB 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 12:21" />सह दर्शण त इहअ डरैऊंणअ कि मोसा बी बोलअ इहअ, “मुंह लागी डअर अर काम्मणीं।”<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">बधा. 9:19</ref></char></note><verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पर तम्हैं आऐ सियोने धारा ज़िधी स्वर्गो एरुशलेम आसा, ज़ुंण ज़िऊंदै परमेशरे नगरी आसा अर ज़िधी लाखों स्वर्ग दूत खुशीओ थैर मनाऊंआं। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />तम्हैं आऐ परमेशरे सोभी ज़ेठै शोहरूए टोली दी ज़सरै नाअं स्वर्गै आसा लिखै दै। तिंयां आसा धर्मीं आत्मां ज़ुंण सिध्द आसा गऐ दै हई। तम्हैं आऐ परमेशरा सेटा ज़ुंण सोभी गल्‍लो नसाफ करा।<verse eid="HEB 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 12:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:24 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:23">12:23</ref> </char>
      <char style="xt" closed="false">
        <ref loc="GEN 4:10">मूल. 4:10</ref>
      </char>
    </note>तम्हैं आऐ ईशू सेटा, ज़ुंण मणछा अर परमेशरा मांझ़ै नऊंईं करारो खणोढी आसा अर मसीहो लोहू ज़ुंण पाप माफ करने बारै खोज़ा, सह निं आबले लोहू ज़िहअ नसाफ मांगदअ।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />चतैन रहा अर परमेशरे गल्‍ला निं शूणीं नां शूणीं करी, किल्हैकि ज़ेभै इज़राईली मोसा गूरे गल्‍ला नांईं शूणीं, तिन्‍नां भेटी सज़ा, हाम्हैं बी निं स्वर्गा का चतैनगी दैणैं आल़ै परमेशरे गल्‍ला नांईं मनी सज़ा बच़ी सकदै। <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />ज़धू परमेशरै सीनाई धारा का गल्‍ला किई ती, तेऊए बोला करै हुई ती सारी पृथूई दी ज़ाज़री। पर ऐहा बारी आसा तेऊ इहअ बोलअ द कि पृथूई संघै हणीं सरगै बी ज़ाज़री।<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">हगा. 2:6</ref>; <ref loc="JDG 5:4">पांच़ 5:4</ref>; <ref loc="PSA 68:8">भज. 68:8</ref></char></note><verse eid="HEB 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 12:27" />अह गल्‍ल करा ऐहा गल्‍ला बाखा शारअ कि ज़ुंण बी च़िज़ा परमेशरै आसा बणाईं दी तेथ हणीं ज़ाज़री अर तिंयां हणीं खतम। पिछ़ू बच़णीं तिंयां ई च़िज़ा ज़ेथ कधि ज़ाज़री निं हणीं।<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="HAG 2:6">हगा. 2:6</ref></char></note><verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />हाम्हां लागा परमेशरो शूकर करनअ कि हाम्हां लै आसा सह राज़ दैनअ द ज़ेथ कधि निं हणीं ज़ाज़री। एऊ राज़ा दी करा हाम्हैं परमेशरो अदर अर परमेशरा करा हाम्हैं स्तोती अर च़ाकरी करै खुश। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />किल्हैकि म्हारअ परमेशर आसा भस्सम करनै आल़ी आगी ज़िहअ सह पाआ सोभी छ़ोतली च़िज़ा ज़ाल़ी।<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">बधा. 4:24</ref>; <ref loc="DEU 9:3">9:3</ref>; <ref loc="ISA 33:14">ईशा. 33:14</ref></char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">मसीही ज़िन्दगी ज़िऊंणें सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />आप्पू मांझ़ै डाहणीं भाई-बैहणी ज़ेही झ़ूरी। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />ज़हा विश्वासी भाई संघै तम्हां पैहली बारी भेत-बछ़ैण हआ तिंयां निंणै ज़रूर आपणैं घअरा लै प्राहुंणैं। किल्हैकि इहअ करै आसा कई लोगै स्वर्ग दूत बी प्राहुंणैं निंयैं दै।<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="1PE 4:9">1 पत. 4:9</ref>; <ref loc="GEN 18:1-19:3">मूल. 18:1—19:3</ref></char></note><verse eid="HEB 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3" />कैद हुऐ दै विश्वासीए हेर-सभाल़ बी करा एही समझ़ी कि तिन्‍नां संघै आसा तम्हैं बी कैद, अर ज़हा संघै लोग विश्वासी हणैं पिछ़ू बूरअ बर्ताअ करा, तिन्‍नें करा इहअ समझ़ी हेर-सभाल़ ज़िहअ कि अह आसा म्हारी आपणीं देही।<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />बैहो करनअ सोभी अदर, अर आपणीं ज़िन्दगीए साथी संघै रहणअ शुचै-पाक्‍कै अर नर्दोश किल्हैकि परमेशरा दैणीं कंज़रै अर पराई बेटल़ी सेटा डेऊणैं आल़ै लै सज़ा।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />थारअ सभाब निं ढब्बैओ मांण करनै आल़अ लोल़ी हुअ। ज़ुंण तम्हां का आसा तेता ई दी रहा खुश। किल्हैकि परमेशरै आसा आप्पै इहअ बोलअ द,<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="PSA 37:25">भज. 37:25</ref>; <ref loc="DEU 31:8">बधा. 31:8</ref>; <ref loc="JOS 1:5">ज़ैह. 1:5</ref></char></note></para>
  <para style="q" vid="HEB 13:5">“मुंह निं तम्हैं कधि कल्ही शोटणै</para>
  <para style="q" vid="HEB 13:5">अर हुंह निं तम्हां लै दैणअ कधि बिस्सरदअ।”<verse eid="HEB 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 13:6" />तैही एछा हाम्हां इहअ बोल़णें हिम्मत,<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 27:1">भज. 27:1</ref>; <ref loc="PSA 118:6">118:6</ref></char></note></para>
  <para style="q" vid="HEB 13:6">“मेरी फाज़त करनै आल़अ आसा परमेशर,</para>
  <para style="q" vid="HEB 13:6">तैही निं हुंह डरदअ आथी।</para>
  <para style="q" vid="HEB 13:6">संसारे मणछ निं मेरअ किछ़ै बगाल़ी सकदै।”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />ज़ुंण थारै सैणैं तै, अर ज़ुंणी तम्हां लै परमेशरो बैण आसा खोज़अ द, तिन्‍नां डाहा आद कि तिन्‍नैं आपणीं ज़िन्दगी केही ज़िऊई अर तिंयां किहै रहै मरनै तैणीं शुचै-पाक्‍कै। तैही लागा हाम्हां बी तिन्‍नां ई ज़िहअ करनअ।<verse eid="HEB 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8" />प्रभू ईशू मसीहा आसा हिझ़, आझ़ अर जुगै-जुगै ज़िहअ कै तिहअ।<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 90:2">भज. 90:2</ref>; <ref loc="REV 1:8">प्रका. 1:8</ref>; <ref loc="ISA 41:4">ईशा. 41:4</ref></char></note><verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />किल्हैकि ईशू मसीहा आसा हर बगत तिहअ ई, तै निं नऊंईं गल्‍ले अर होरी रंगे शिक्षे ज़ाणैं लागी। तम्हां लै एछा परमेशरे झींणा करै शगती। नां कि खाणैं पिणें बारै बधान बणाईं करै। तिंयां खाणैं पिणें च़िज़ा करै निं असली दी तिन्‍नां किछ़ै फाईदअ हंदअ ज़ुंण तिन्‍नां खाआ।<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />ज़ेथ मसीहा बल़ीदान आसा हुअ द सह बेदी आसा म्हारी, तेता प्रैंदा का खाणेंओ हक निं तिन्‍नां मणछा बी आथी, ज़ुंण यहूदी पराणैं बधाने साबै अज़ी बी बेदी दी बल़ीदान करी भबनै च़ाकरी करा। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />किल्हैकि पैहली करारे साबै हर साल ज़हा पशूओ लोहू माहा प्रोहत पाप माफी लै बल़ीदान करी खास पबित्र ज़ैगा लै निंयां, तिन्‍नें ल्हास पाआ खिम्भा बागै ज़ाल़ी। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />ईशू मसीहा बी ज़िरै एरुशलेम नगरीए प्रऊल़ी बागै दुख, ताकि सह आपणैं लोहू करै सोभी लोगा पबित्र करी सके। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />एछा, ऐबै छ़ाडणअ हाम्हां बी यहूदी मणछो पराणअ रबाज़ हाम्हां डेऊणअ मसीहा सेटा, हाम्हां दैणअ लोगा म्हारी बेइज़ती करनै ज़ेही तिन्‍नैं ईशूए बेइज़ती किई।<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="LUK 6:22">लूक. 6:22</ref></char></note><verse eid="HEB 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 13:14" />किल्हैकि एऊ संसारै निं हाम्हां का इहअ घअर आथी ज़ुंण सदा लै रहणअ। पर हाम्हैं आसा तेऊ सदा रहणैं आल़ै घअरा न्हैल़ै-भाल़ै लागै दै ज़ुंण हाम्हां आजू भेटणअ।<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />तै करनी हाम्हां आपणैं होठा करै परमेशरे स्तोती। अह आसा म्हारअ तेऊ लै बल़ीदान।<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="PSA 50:14">भज. 50:14</ref>,<ref loc="PSA 50:23">23</ref>; <ref loc="HOS 14:2">होश. 14:2</ref></char></note> <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />हर बगत रहणअ दुजै लै भलै कामां करदै लागी आपणीं हर गल्‍ला करनी तिन्‍नां लै दैई ज़हा ज़ेते ज़रुरत आसा। किल्हैकि इहै कामें बल़ीदाना करै हआ परमेशर खुश।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />विश्वासा दी ज़ुंण थारै सैणैं आसा, तिन्‍नें शूणां ज़िहअ तिंयां बोला तिहअ, अर रहा बी तिन्‍नें डरा हेठै। किल्हैकि तिंयां आसा थारी हेर-सभाल़ करदै लागै दै कि तम्हैं कबाता नां पेठे। तिन्‍नां लागा आपणैं कामों साब-कताब परमेशरा सेटा दैणअ, कि तिंयां एऊ कामां खुशी-खुशी करे नां कि दुखी हई करै। नांईं ता तम्हां निं किछ़ै फाईदअ हणअ।<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="1TH 5:12-13">1 थिस. 5:12-13</ref>; <ref loc="ACT 20:28">शधा. 20:28</ref></char></note><verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />हाम्हां लै बी रहा परमेशरा का प्राथणां करदै लागी। किल्हैकि हाम्हां आसा भरोस्सअ कि म्हारी सोर-समझ़ आसा शुची अर हाम्हैं च़ाहा सोभी गल्‍ला करै परमेशरा खुश करनअ। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />हुंह च़ाहा इहअ कि तम्हैं करै मुल्है प्राथणां कि हुंह तम्हां सेटा लै एकी बारी भिई एछी सकूं।<verse eid="HEB 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HEB 13:20" />ईशू आसा म्हारी तैणीं,</para>
  <para style="q" vid="HEB 13:20">सह बच़ाऊआ हाम्हां अर सह करा म्हारी एही हेर-सभाल़ ज़िहअ एक फुआल आपणीं भेडे करा।</para>
  <para style="q" vid="HEB 13:20">म्हारै मन्‍नैं शांती दैणैं आल़ै परमेशरै किअ प्रभू ईशू मरी करै ज़िऊंदअ।</para>
  <para style="p" vid="HEB 13:20">इहअ करी किई परमेशरै हाम्हां लै सदा रहणैं आल़ी करार मसीहे क्रूसा दी बहाऊऐ दै लोहू दी प्रगट।<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="JHN 10:11">जोह. 10:11</ref>; <ref loc="ACT 2:24">शधा. 2:24</ref>; <ref loc="ROM 15:33">रोम. 15:33</ref></char></note><verse eid="HEB 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 13:21" />हुंह करा परमेशरा का प्राथणां कि तम्हां हरेक भली गल्‍ला लै सिध्द करे, ईशू थारी तिहअ करना लै मज़त करे ज़ेता करै परमेशर खुश हआ।</para>
  <para style="p" vid="HEB 13:21">ईशू मसीहे बड़ैई लोल़ी जुगै-जुगै हंदी रही। एवमस्तू।<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />भाईओ, मंऐं लिखी थारी हिम्मत बढाऊंणा लै च़िठी दी थोल़ी ज़ेही गल्‍ला, हुंह करा तम्हां का अरज़ कि मंऐं ईंयां गल्‍ला ज़ुंण बोली एता समझ़ै बडै धैन-मन्‍न लाई।<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />हुंह च़ाहा कि तम्हां का लोल़ी थोघ लागअ कि विश्वासा दी म्हारअ भाई तिमोथी गअ कैद खानै का छ़ुटी, ज़ै सह मुंह सेटा छ़ेक्‍कै एछे, तै आणू हुंह तेऊ आप्पू संघै तम्हां सेटा लै मिलदअ।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />आपणैं सोभी सैणैं अर सोभी पबित्र लोगा लै दै मुंह बाखा राज्ज़ी-खुशी, इधी एऊ इटल़ी देशै रहणैं आल़ै विश्वासी भाई बी आसा दैनी दी तम्हां लै राज्ज़ी-खुशी।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />हुंह करा प्राथणां कि तम्हां सोभी लै लोल़ी परमेशरे झींण हंदी रही। एवमस्तू।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>