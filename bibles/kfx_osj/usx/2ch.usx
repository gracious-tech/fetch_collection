  <para style="h">2 इतिहास</para>
  <para style="toc1">राज़ै सुलैमाने भाग अर यहूदा मुल्खे बरैबादी</para>
  <para style="toc2">2 इतिहास</para>
  <para style="toc3">2 इति.</para>
  <para style="mt1">2 इतिहास</para>
  <para style="mt2">राज़ै सुलैमानो राज़ अर यहूदा मुल्खे बरैबादी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: खास थोघ निं आथी पर कोऐ बोला अह आसा एज्रा लिखी दी</para>
  <para style="ili">सन: 450 का 425 ईसा आजी</para>
  <para style="ili">पहल़णैं आल़ै: इज़राईली</para>
  <para style="ip">2 इति. अह कताब आसा 1 इति. कताबो दुजअ भाग। ऐहा कताबा दी आसा राज़ै सुलैमानो राज़, उतरा बाखा इज़राईलीओ द्रोह ज़ुंण जरोबामै रहबाम राज़ै लै किअ। एता आजू राज़ै सुलैमानो शोहरू राज़अ अर 586 ईसा आजी एरुशलेम नगरीए बरैबादी तैणीं यहूदा मुल्खे राज़ैओ इतिहास।</para>
  <para style="ip">ऐहा कताबा दी लागा हाम्हां का थोघ कि एरुशलेम नगरी किहअ करै हुई बरैबाद अर यहूदा मुल्खे लोग किहै निंयैं कैद करी बाबेल देशे गलामी लै। पर ऐहा कताबा दी पहल़ा हाम्हैं खिरी इहअ कि यहूदी लै थिई अज़ी बी बापस फिरनें आशा। फारस देशे राज़ै कुस्रू दैनअ तिन्‍नां यहूदा मुल्खा लै इहअ बोली बापस एछणैं:</para>
  <para style="imq">“हुंह फारसी माहा राज़अ कुस्रू बोला इहअ, ‘स्वर्गे परमेशर बिधाता बणाअं हुंह सोभी देशा प्रैंदै माहा राज़अ। तेऊ बिधाता सभाल़ी मुल्है ज़िम्मैंबारी कि हुंह यहूदा मुल्खै एरुशलेम नगरी तेऊ लै भबन बणांए। ऐबै तम्हां बिधाते परज़ा मांझ़ै ज़ेतरै बी यहूदा लै बापस फिरनअ च़ाहा, तिंयां लागा हांढदै, सह बिधाता रहणअ तम्हां संघै आप्पै।’”</para>
  <para style="ipr">(36:23)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">राज़ै सुलैमाने राज़ा दी इज़राईल 1:1—9:31</para>
  <para style="io1">राज़ै रहबामा पोर्ही अहाज राज़ै तैणीं 10:1—28:27</para>
  <para style="io1">हिजकिया राज़ै पोर्ही यहूदा मुल्खे बरैबादी तैणीं 29:1—36:23</para>
  <chapter number="1" style="c" sid="2CH 1" />
  <para style="s">राज़ै सुलैमानै मांगी बिधाता का अक्ल</para>
  <para style="r">(<ref loc="1KI 3:1-15">1 राज़ै 3:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 1:1" />राज़ै दाबेदो शोहरू सुलैमान राज़ै किअ इज़राईला प्रैंदै आपणअ राज़ पाक्‍कअ, परमेशर बिधाता दैनी तेऊ लै एही बर्गत कि सह हुअ खास्सअ बलबान।<verse eid="2CH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 1:2" />राज़ै सुलैमानै किअ सैना दी दरोगै, दलपति, सोभी सरकारी कार-करिंदै, पांच़, सोभी गोत्रे सैणैं अर होरी इज़राईली लै हुकम कि <verse eid="2CH 1:2" /><verse number="3" style="v" sid="2CH 1:3" />सारी इज़राईली टोली लोल़ी गबोन बिधाते पबित्र ज़ैगा आऐ। तिंयां सोभ पुजै तिधी किल्हैकि मेल़-ज़ोल़ो खिम्भ ज़ुंण बिधाते गूर मोसा रेगीस्तानै थिअ बणाअं द, सह थिअ तिधी डाहअ द। <verse eid="2CH 1:3" /><verse number="4" style="v" sid="2CH 1:4" />पर बिधाते करारो मणशू त किर्यात-ज़रीम नगरी का आणी एरुशलेम नगरी तैहा ज़ैगा खिम्भा दी डाहअ द ज़ुंण राज़ै दाबेदै बिधाता लै ज़ुदी ती बणाईं दी। <verse eid="2CH 1:4" /><verse number="5" style="v" sid="2CH 1:5" />हूरे पोचै अर ऊरीए शोहरू बसलेलै ज़ुंण कांस्से बेदी ती बणाईं दी, सह बी थिई गबोन बिधाते खिम्भ आजू। तिधी पुजी किऐ सुलैमानै अर सारी इज़राईली टोली बिधाते पबित्र ज़ैगा <verse eid="2CH 1:5" /><verse number="6" style="v" sid="2CH 1:6" />बिधाते मेल़-ज़ोल़े खिम्भा सेटा कांस्से बेदी दी एक हज़ार पशू बल़ीदान करी पठी हूम।<verse eid="2CH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 1:7" />राज़ै सुलैमाना लै बोलअ राची सुपनै बिधाता इहअ, “ज़िहअ तूह च़ाहा तूह मांग मुखा तिहअ, ताह मुखा किज़ै लोल़ी?”<verse eid="2CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 1:8" />सुलैमानै दैनअ बिधाता लै ज़बाब, “तूह झ़ूरअ मेरै बाब राज़ै दाबेदा लै सदा। तेरी हुणाकार हुई एही कि तंऐं बणाअं मेरै बाबे ज़ैगा आजू हुंह राज़अ। <verse eid="2CH 1:8" /><verse number="9" style="v" sid="2CH 1:9" />हे परमेशर बिधाता, ज़ुंण करार तंऐं मेरै बाब राज़ै दाबेदा संघै आसा किई दी, तेता करै पूरी। ज़हा परज़ा प्रैंदै तंऐं हुंह राज़अ बणाअं, सह आसा एतरी खास्सी कि तिन्‍नां निं कुंण गणी सकदअ, <verse eid="2CH 1:9" /><verse number="10" style="v" sid="2CH 1:10" />तूह दै मुल्है अक्ल अर समझ़ कि हुंह तिन्‍नां प्रैंदै राज़ करी सके, नांईं ता हुंह निं तेरी एही महान परज़ा प्रैंदै राज़ करी सकदअ।”<verse eid="2CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 1:11" />बिधाता बोलअ सुलैमाना लै इहअ, “तंऐं मांगी सोभी का बधिया गल्‍ल। तूह सका त मुखा धन-माया, ज़ैदात, मशूरी, दुशमणे मौत, आप्पू लै लाम्मी अमर मांगी। पर तंऐं मांगी मुखा अक्ल अर समझ़ कि तूह मेरी तैहा परज़ा प्रैंदै राज़ करी सके ज़हा प्रैंदै मंऐं तूह राज़अ बणाअं। <verse eid="2CH 1:11" /><verse number="12" style="v" sid="2CH 1:12" />मुंह दैणीं ताल्है अक्ल अर समझ़ पर एता का लाऊआ दैणीं मुंह ताल्है खास्सी धन-माया, ज़ैदात अर एतरी मशूरी कि नां ताखा आजी कहा राज़ै भेटी अर नां ताह बाद कहा राज़ै भेटणीं।”<verse eid="2CH 1:12" /></para>
  <para style="s">राज़ै सुलैमानो बल अर ज़ैदात</para>
  <para style="r">(<ref loc="1KI 10:26-29">1 राज़ै 10:26-29</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 1:13" />राज़अ सुलैमान पुजअ गबोन बिधाते पबित्र ज़ैगा ज़िधी बिधातो मेल़-ज़ोल़ो खिम्भ थिअ। संघा आअ तिधा का एरुशलेम नगरी लै फिरी अर तिधा का रहअ सह सारै इज़राईला प्रैंदै राज़ करदअ लागी। <verse eid="2CH 1:13" /><verse number="14" style="v" sid="2CH 1:14" />राज़ै सुलैमानै बणाईं एक बडी सैना अर तेथ तै च़ौदा हज़ार रथ अर बारा हज़ार शूरबीर घोल़ै प्रैंदै शुंआर हई जुधा करनै आल़ै। तेता मांझ़ै तै तेऊ थोल़ै राज़धानी एरुशलेम डाहै दै अर बाकी तै होरी-होरी नगरी डाहै दै। <verse eid="2CH 1:14" /><verse number="15" style="v" sid="2CH 1:15" />सुलैमाने राज़ा दी हुअ त एरुशलेम नगरी च़ंदीओ मोल केल़ुईए काठ, पात्थर अर यहूदा मुल्खै निऊल़ै लागै दै आम डाल़-बूटे काठा बराबर। <verse eid="2CH 1:15" /><verse number="16" style="v" sid="2CH 1:16" />राज़अ सुलैमान आणा त आप्पू लै घोल़ै मिसर देशा का। राज़े बपारी आणा तै तिन्‍नां ज़ेतरअ भाअ पाक्‍कअ हुअ किअ द तेते साबै छ़ूंढे-छ़ुंढ मोलै लई। <verse eid="2CH 1:16" /><verse number="17" style="v" sid="2CH 1:17" />एक रथ आणा तै तिंयां तेऊ ज़मानें छ़ह शौ च़ंदीए सिक्‍कै दैई मिसर देशा का मोलै लई। घोल़ै लै दैआ तै तिंयां एक शौ पज़ाह च़ंदीए सिक्‍कै मोल। हित्ती अर सिरीया देशे राज़ै लै बी दैआ तै तिंयां बपारी एऊ ई मोलै।<verse eid="2CH 1:17" /></para>
  <chapter eid="2CH 1" />
  <chapter number="2" style="c" sid="2CH 2" />
  <para style="s">बिधाता लै भबन बणाणें तैरी</para>
  <para style="r">(<ref loc="1KI 5:1-18">1 राज़ै 5:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 2:1" />राज़ै सुलैमानै सोठअ इहअ कि तेऊ बणाणअं बिधाता लै एक भबन अर आप्पू लै एक मैहल। <verse eid="2CH 2:1" /><verse number="2" style="v" sid="2CH 2:2" />सुलैमानै डाहै सत्तर हज़ार मज़दूर काठ-पात्थरा ढोंदै बगारू लाई। अश्शी हज़ार मणछ डाहै धारा बाखे मुल्खै काठा काढदै लाई अर तिन्‍नां सोभी प्रैंदै डाहै चअन हज़ार छ़ह शौ मेट।<verse eid="2CH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 2:3" />राज़ै सुलैमानै दैनअ सूर देशे राज़ै हिरामा लै समाद, “तूह दै मुल्है बी केल़ुईए काठ मोलै ज़िहै तंऐं मेरै बाब राज़ै दाबेदा लै तधू दैनै तै ज़धू सह आपणैं मैहला बणाऊंदअ त लागअ द। <verse eid="2CH 2:3" /><verse number="4" style="v" sid="2CH 2:4" />मंऐं आसा लाअ द आपणैं परमेशर बिधाता लै भबन बणाईं। अह हणीं पबित्र ज़ैगा तिधी एछणैं मेरै लोग इज़राईले परमेशर बिधाता सेटा माथै टेक्‍कदै, धूप ज़ाल़दै, खुशबूदार मसालै, भोज़न छ़ाडी पूज़ा-गाज़ा करदै। तिधी करनअ धैल़ दोत्ती-उडै, बशैघे धैल़ी, पुनूंईए धैल़ी अर होरी तिह-थैरे धैल़ी बिधाता लै हूम। म्हारै परमेशर बिधाता आसा हुकम किअ द कि हाम्हैं लोल़ी सदा इहअ ई करदै रहै। <verse eid="2CH 2:4" /><verse number="5" style="v" sid="2CH 2:5" />अह हणअ सोभी का महान भबन किल्हैकि म्हारअ परमेशर बिधाता आसा सोभी देअआ का महान।<verse eid="2CH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 2:6" />“असली दी निं बिधाता लै घअर कोहै बणाईं सकदअ किल्हैकि तेऊ रहणा लै आसा सारअ भ्रमंड बी थोल़अ! मंऐं लाअ सिधअ एतरअ करी कि हुंह बणाऊं तेऊ लै भबन ज़िधी हाम्हैं तेऊ लै बल़ीदान करी सके। <verse eid="2CH 2:6" /><verse number="7" style="v" sid="2CH 2:7" />तूह छ़ाड मुंह सेटा इहै ज़ाण-प्रबीण आदमी ज़ुंण सुन्‍नैं, च़ंदी, कांस्सै अर लोहै दी खेल़्तर पाई सके अर निलै, बैंज़णीं अर इहै बूणती करनै आल़ै ज़ुंण लाला झिकल़ै दी खेल़्तर पाई सके। तिन्‍नां करनअ यहूदा अर एरुशलेम नगरीए तिन्‍नां कारीगीरा संघै काम ज़ुंण मेरै बाब राज़ै दाबेदै आसा छ़ांटै दै। <verse eid="2CH 2:7" /><verse number="8" style="v" sid="2CH 2:8" />मुखा आसा थोघ कि तेरै आदमी आसा गरान-पछान करना लै सज़ाण अर मशूर। तूह दै मुल्है लाबानोन बणां का केल़ुई, कैलीए अर च़ंदने काठ काढी। तेरै तिन्‍नां आदमी संघै कामां करना लै छ़ाडूं हुंह इधा का आपणैं आदमी बी, <verse eid="2CH 2:8" /><verse number="9" style="v" sid="2CH 2:9" />ताकि तिंयां खास्सै काठ काढी सके। किल्हैकि ज़ुंण भबन मुंह बिधाता लै बणाणअं, सह हणअ खास्सअ बडअ अर महान। <verse eid="2CH 2:9" /><verse number="10" style="v" sid="2CH 2:10" />तेरै गरानी-पछानी लै दैंऊं हुंह एक-बिह हज़ार कुंटल़ कणक अर बिह हज़ार ज़ौ, दूई शौ हज़ार बाटी दाखो रस अर एतरअ ई जैतूनो तेल।”<verse eid="2CH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 2:11" />सूर नगरीए राज़ै हिरामै दैनअ सुलैमाना लै च़िठी लिखी बापस ज़बाब, “हुंह ज़ाणा कि बिधाता झ़ूरा आपणीं परज़ा लै खास्सअ अर तैही बणाअं तेऊ तूह तिन्‍नां प्रैंदै राज़अ। <verse eid="2CH 2:11" /><verse number="12" style="v" sid="2CH 2:12" />हुंह करा इज़राईले परमेशर बिधातो शूकर ज़ुंणी सारअ भ्रमंड बणाअं! तेऊ दैनअ राज़ै दाबेदा लै इहअ अक्ली आल़अ शोहरू, ज़ुंण इहअ ज़ाण-प्रबीण अर समझ़कार आसा अर ज़ुंणीं बिधाता लै भबन अर आप्पू लै मैहल लाअ बणाईं। <verse eid="2CH 2:12" /><verse number="13" style="v" sid="2CH 2:13" />मंऐं लाअ ताह सेटा लै हिराम-आबी छ़ाडी। अह आसा ज़ाण-प्रबीण कारीगीर। <verse eid="2CH 2:13" /><verse number="14" style="v" sid="2CH 2:14" />एऊए ईज थिई इज़राईली मांझ़ै दान गोत्रा का अर बाब आसा एऊओ सूर देशा का। अह आसा सुन्‍नैं, च़ंदी, कांस्सै, लोहै, काठ अर किम्मती पात्थरो मशूर कारीगीर। एता का लाऊआ ज़ाणा अह हर लाल, निलै, बैंज़णीं हर रंगे झिकल़ै अर बाछे झिकल़ै दी बूणती अर खेल़्तर पाई। एऊ दै आपणैं सज़ाण कारीगीरा संघै अर तिन्‍नां संघै काम करनै ज़ुंण तेरै बाब राज़ै दाबेदा लै काम करा तै। <verse eid="2CH 2:14" /><verse number="15" style="v" sid="2CH 2:15" />मेरै मालक, ऐबै दै तूह तेता ज़ुंण तंऐं हाम्हां लै कणक, ज़ौ, दाखो रस अर जैतूनो तेल दैणअ किअ त। <verse eid="2CH 2:15" /><verse number="16" style="v" sid="2CH 2:16" />हाम्हैं दैऊंमै ताल्है लाबानोन बणां का ज़ेतरै ताह लोल़ी तेतरै केल़ुईए काठ काढी। तिंयां दैणैं हाम्हां बान्हीं करै समुंदरे पाणीं दी बहाऊई करै जोपा नगरी समुंदरे बाढै तैणीं पजैल़ी। तिधा का निंयैं तूह तिन्‍नां एरुशलेम नगरी लै।”<verse eid="2CH 2:16" /></para>
  <para style="s">सुलैमान लागअ बिधाता लै भबन बणाऊंदअ</para>
  <para style="r">(<ref loc="1KI 6:1-38">1 राज़ै 6:1-38</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 2:17" />राज़ै सुलैमानै किई तिन्‍नां सोभी परदेसी आदमीए तेही ई गणांई ज़ुंण इज़राईल देशै तै बस्सै दै ज़ेही तेऊए बाब राज़ै दाबेदै किई ती। तिंयां निखल़ै पठी एक लाख त्रुंजा हज़ार छ़ह शौ। <verse eid="2CH 2:17" /><verse number="18" style="v" sid="2CH 2:18" />तिन्‍नां मांझ़ै छ़ांटै तेऊ सत्तर हज़ार काठा बगारू, अश्शी हज़ार डाहै धारा पात्थरा काढदै लाई अर चअन हज़ार छ़ह शौ डाहै तिन्‍नां प्रैंदै मेट बणाईं कि तिंयां कामों धैन-खैल करे।<verse eid="2CH 2:18" /></para>
  <chapter eid="2CH 2" />
  <chapter number="3" style="c" sid="2CH 3" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 3:1" />राज़ै सुलैमाने बाब राज़ै दाबेदै ती पैहलै ई बिधाते भबना बणाणां लै ज़ैगा छ़ांटी डाही दी। अह ज़ैगा ती एरुशलेम नगरी मोरिया धारा जबेशी अरोने ताटी ज़िधी बिधाता राज़ै दाबेदा लै दर्शण दैनै तै। राज़अ सुलैमानै किअ <verse eid="2CH 3:1" /><verse number="2" style="v" sid="2CH 3:2" />आपणैं राज़ा दी च़ौथी साला साज़ै बशाहा पोर्ही बिधाते भबन बणाणेंओ काम शुरू। <verse eid="2CH 3:2" /><verse number="3" style="v" sid="2CH 3:3" />राज़ै सुलैमानै ज़ुंण बिधाता लै भबन बणाअं, सह थिअ भितरा का शाठ हाथ लाम्मअ अर बिह हाथ बिरलअ। <verse eid="2CH 3:3" /><verse number="4" style="v" sid="2CH 3:4" />ज़ेतरअ बिरलअ बिधातो भबन थिअ, तेतरी ई बिरली थिई तेता आजू बिह हाथ बिरली बडी पांड अर सह थिई एक शौ बिह हाथ उछ़टी मज़ल। राज़ै सुलैमानै महल़ी भितरा बाखा तेते भित्ती च़ोखै सुन्‍नैं करै। <verse eid="2CH 3:4" /><verse number="5" style="v" sid="2CH 3:5" />खास पबित्र ज़ैगे पांडा दी लाऐ भितरा बाखा कैलीए फल़्है संघा पाई तेथ खज़ूरे बूट अर शांघल़ी ज़ेही खेल़्तरा, तेता बागै महल़ै च़ोखै सुन्‍नैं करै। <verse eid="2CH 3:5" /><verse number="6" style="v" sid="2CH 3:6" />राज़ै सुलैमानै लाई बिधाते भबनै किम्मती मणीं। ज़ुंण तेथ सुन्‍नअ लाअ सह थिअ पर्बेम देशा का आणअ द। <verse eid="2CH 3:6" /><verse number="7" style="v" sid="2CH 3:7" />तेऊ सुन्‍नैं करै महल़ी भबने भित्ती, दुआरे डेहल़, द्रींड, पाल्‍लै, मटैहणूं अर भ्रैहणी। भित्ती दी पाई सारै दी फैंखा आल़ै करूब नाओंए स्वर्ग दूते खेल़्तरा। <verse eid="2CH 3:7" /><verse number="8" style="v" sid="2CH 3:8" />भितरली पांड ज़ेता लै खास पबित्र ज़ैगा बोला, सह बी ती भबना बराबर बिह हाथ बिरली। सह बी महल़ी राज़ै सुलैमानै भित्ती संघी सारै दी च़ोखै सुन्‍नैं करै, तेथ लागअ कोई दूई शौ तिह कुंटल़ सुन्‍नअ। <verse eid="2CH 3:8" /><verse number="9" style="v" sid="2CH 3:9" />सुन्‍नें कील बणाणां लै लागअ कोई आधअ किलू सुन्‍नअ। प्रैंधल़ी मज़ले भित्ती बी महल़ी च़ोखै सुन्‍नैं करै।<verse eid="2CH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 3:10" />राज़ै सुलैमानै बझ़ैल़ी जैतूने काठे दूई फैंखा आल़ै करूब नाओंए स्वर्ग दूते मुहुर्ती बणाणैं अर तिंयां बी महल़ै बागा का च़ोखै सुन्‍नैं करै संघा डाहै तिंयां खास पबित्र ज़ैगा <verse eid="2CH 3:10" /><verse number="11-13" style="v" sid="2CH 3:11-13" />पिछ़ली भित्तीए नील़ै दुआरा बाखा स्मोहरै। तिन्‍नां दुही करूबे तै दूई-दूई फैंख। फैंख तै पांज़-पांज़ हाथ लाम्मै। एकीओ फैंख लागअ पार दैहणीं भित्ती दुजै करूबे फैंखै छ़ुंहीं बाऊंईं भीत अर पबित्र ज़ैगा मांझ़ा-मांझ़ी छ़ुंहीं एकी-दुजे फैंखे च़ुंडी। पठी हुऐ तिन्‍नें फैंख दैहणीं भित्ती का बाऊंईं भित्ती तैणीं बिह हाथ लाम्मै। <verse eid="2CH 3:11-13" /><verse number="14" style="v" sid="2CH 3:14" />खास पबित्र ज़ैगा लै बणाअं एक पल्दअ, सह थिअ निली, बैंज़णीं अर लाल ऊना करै बूणै दै बाछे झिकल़ै करै बणाअं द। तेथ पाई फैंखा आल़ै करूब नाओंए स्वर्ग दूते बूणती करी खेल़्तर बी।<verse eid="2CH 3:14" /></para>
  <para style="s">कांस्से दूई थाम्ह</para>
  <para style="r">(<ref loc="1KI 7:15-22">1 राज़ै 7:15-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 3:15" />राज़ै सुलैमानै बझ़ैल़ै पैंईंती-पैंईंती हाथ लाम्मै दूई कांस्से थाम्ह बणाणैं। तेते प्रैंधल़ै टोप तै पांज़-पांज़ हाथ लाम्मै। <verse eid="2CH 3:15" /><verse number="16" style="v" sid="2CH 3:16" />थाम्हे टोपा दी थिई शांघल़ी ज़ेही ज़ाल़ीदार खेल़्तरा अर तेथ तै नारदाणैं ज़िहै कांस्से शौ शल़ुम्हणूं। <verse eid="2CH 3:16" /><verse number="17" style="v" sid="2CH 3:17" />ईंयां दूई कांस्से थाम्ह बिधाते भबने प्रऊल़ी आजू खल़ै। ज़ुंण दखण दिशा बाखा थिअ, तेऊ नाअं डाहअ, “जाकीन” अर ज़ुंण थाम्ह उतर दिशा बाखा थिअ, तेऊ नाअं डाहअ “बोआज़।”<verse eid="2CH 3:17" /></para>
  <chapter eid="2CH 3" />
  <chapter number="4" style="c" sid="2CH 4" />
  <para style="s">बिधाते भबना लै चाण-भांडै</para>
  <para style="r">(<ref loc="1KI 7:23-39">1 राज़ै 7:23-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 4:1" />राज़ै सुलैमानै बणाईं एक कांस्से बेदी, सह थिई बिह हाथ च़कोर अर दस हाथ उछ़टी। <verse eid="2CH 4:1" /><verse number="2" style="v" sid="2CH 4:2" />एक बझ़ैल़अ तेऊ कांस्सैओ बडअ गोल़ कल़ाह बणाणैं सह थिअ प्रैंदा का दस हाथ खुल्हअ, तेते घेर थिई फेर-फिरदी तिह हाथ गोल़ अर सह थिअ कोई पांज़ हाथ उछ़टअ। <verse eid="2CH 4:2" /><verse number="3" style="v" sid="2CH 4:3" />कल़ाहे घेरै दी थिई उंधै उझै फेर-फिरदी दूई लगैगा दी खेल़्तर पाई दी। तिन्‍नां खेल़्तरा दी तै दस-दस बल्द खेल़ै दै अर तेते खेल़्तर ती तेऊ कल़ाह ई दी काढी दी। <verse eid="2CH 4:3" /><verse number="4" style="v" sid="2CH 4:4" />सह कल़ाह डाहअ बारा कांस्से बल्दा प्रैंदै। चिई बल्दो मुंह दखण, चिई बल्दो मुंह पुर्बा बाखा अर चिई बल्दो मुंह पछ़म दिशा बाखा। लिंघणैं तै तिन्‍नें पिछ़ू बाखा कल़ाह हेठै एकी ज़ैगा ज़ुल़ै दै अर तिन्‍नें पिठी प्रैंदै बशैल़अ कल़ाह। <verse eid="2CH 4:4" /><verse number="5" style="v" sid="2CH 4:5" />तेऊ कल़ाहो मडोखर त कोई च़ार आंगल़ मोट्टअ अर तेतो घेरअ ज़ाण्हिंआं त सुरघे फूला ज़िहअ। तेथ भितरी एछा त कोई तिह हज़ार बाटी पाणीं। <verse eid="2CH 4:5" /><verse number="6" style="v" sid="2CH 4:6" />तिन्‍नैं बणाऐं दस कल़ाह, पांज़ डाहै भबने दखणा बाखा अर पांज़ डाहै उतर दिशा बाखा। बिधाता लै हूम करनै का आजी धोआ तै तिन्‍नां कल़ाह दी बल़ीदान किऐ दै पशू। प्रोहता लै हाथ-खूर धोणा लै थिअ बडअ कल़ाह ज़ुदअ।<verse eid="2CH 4:6" /></para>
  <para style="p">
    <verse number="7-8" style="v" sid="2CH 4:7-8" />दस बणाऐं सुन्‍नें सदीऐ तिहै ई ज़ेऊ साबै तेता बणाणेंओ बधान थिअ। दस बणाऐं मेज़ संघा डाहै पांज़ सदीऐ अर पांज़ मेज़ भबना भितरी दैहणीं बाखा अर पांज़ सदीऐ अर पांज़ मेज़ डाहै बाऊंईं बाखा। एक शौ बणाऐं सुन्‍नें प्रिहै।<verse eid="2CH 4:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 4:9" />सुलैमानै बझ़ैल़ी प्रोहता लै दूई ताटी बणाणैं, तेथ लाई प्रऊल़ी अर तेते पाल्‍लै महल़ै कांस्सै करै। <verse eid="2CH 4:9" /><verse number="10" style="v" sid="2CH 4:10" />कांस्सैओ बडअ कल़ाह डाहअ भबने दैहणीं बाखा कूणीं नेल़ पुर्ब अर दखण दिशा मांझ़ा-मांझ़ी।<verse eid="2CH 4:10" /></para>
  <para style="s">हिराम ठठारै बणाईं दी च़िज़ा</para>
  <para style="r">(<ref loc="1KI 7:40-50">1 राज़ै 7:40-50</ref>)</para>
  <para style="p">
    <verse number="11-16" style="v" sid="2CH 4:11-16" />हिराम ठठारै बणाऐं हांडै, बाटी, पल़ैंज़ै अर कई च़िज़ा। बिधाते भबना लै ज़ेही-ज़ेही च़िज़ा बणाणेंओ हुकम राज़ै सुलैमानै किअ त, हिरामै किअ तिन्‍नां सोभी च़िज़ा बणाईं आपणअ काम पूरअ। तेऊ बणाईं ईंयां च़िज़ा:</para>
  <para style="li" vid="2CH 4:11-16">दूई कांस्से बडै थाम्ह,</para>
  <para style="li" vid="2CH 4:11-16">थाम्हा प्रैंदा लै दूई बडै-बडै कांस्से टोप,</para>
  <para style="li" vid="2CH 4:11-16">शांघल़ी ज़ेही ज़ाल़ीदार खेल़्तरा आल़ी कांगणी,</para>
  <para style="li" vid="2CH 4:11-16">तिन्‍नां च़ऊ कांगणी लै नारदाणैं ज़िहै च़ार शौ शल़ुम्हणूं।</para>
  <para style="li" vid="2CH 4:11-16">दस गाड्डै अर तेता प्रैंदै कांस्से दस डबरै।</para>
  <para style="li" vid="2CH 4:11-16">बडअ कल़ाह अर तेता हेठै बारा बल्द, होर बतिल्‍लै अर</para>
  <para style="li" vid="2CH 4:11-16">बाटी, पल़ैंज़ै अर कल़गैथू।<verse eid="2CH 4:11-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 4:17" />ईंयां सोभै समान बझ़ैल़ै तै राज़ै सुलैमानै जरदण खागै सक्‍कोत अर सारतान मांझ़ै तैहा ज़ैगा बणाणैं ज़िधी च़कणाट माट्टअ आसा। <verse eid="2CH 4:17" /><verse number="18" style="v" sid="2CH 4:18" />अह कांस्सैओ समान निं सुलैमानै तोलअ ई आथी किल्हैकि ईंयां तै खास्सै, तिहअ करै निं थोघ ई आथी कि तेथ केतरअ कांस्सअ लागअ।<verse eid="2CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 4:19" />ज़ेतरी च़िज़ा राज़ै सुलैमानै बिधाते भबना लै बणाईं तिंयां महल़ी सोभ सुन्‍नैं करै: बेदी, भोज़ना डाहणां लै मेज़, <verse eid="2CH 4:19" /><verse number="20" style="v" sid="2CH 4:20" />खास पबित्र ज़ैगा आजूए दस सदीऐ, पांज़ दखण दिशा बाखा अर पांज़ उतर दिशा बाखा, <verse eid="2CH 4:20" /><verse number="21" style="v" sid="2CH 4:21" />फूल, दीऐ, च़िमटै, <verse eid="2CH 4:21" /><verse number="22" style="v" sid="2CH 4:22" />डबरी, काता, बाटी, धूप दानी, धनैरै। भितरा बाखा खास पबित्र ज़ैगा अर भबने बाघली प्रऊल़ीए कल़ोलै बी महल़ै सुन्‍नैं करै।<verse eid="2CH 4:22" /></para>
  <chapter eid="2CH 4" />
  <chapter number="5" style="c" sid="2CH 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 5:1" />ज़ांऊं राज़ै सुलैमानै भबनो सारअ काम करी छ़ेक्‍कअ, तेऊ डाही सुन्‍नैं, च़ंदीए अर होर च़िज़ा बिधाते भबने भढारै ज़ुंण तेऊए बाब दाबेदै बिधाता लै ज़ुदी ती डाही दी।<verse eid="2CH 5:1" /></para>
  <para style="s">बिधाते करारो मणशू पजैल़अ भबना भितरी</para>
  <para style="r">(<ref loc="1KI 8:1-9">1 राज़ै 8:1-9</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 5:2" />तेखअ शादै राज़ै सुलैमानै सोभी गोत्र अर टोली का इज़राईली सैणैं एरुशलेम नगरी लै एही गल्‍ला करना लै कि बिधाते करारो मणशू निंणअ सियोन दाबेदपूर गहल़ा का बिधाता लै बणाऐं दै भबना लै। <verse eid="2CH 5:2" /><verse number="3" style="v" sid="2CH 5:3" />इज़राईली सोभ सैणैं हुऐ छ़ानींए थैरा बाती शऊजै कठा। <verse eid="2CH 5:3" /><verse number="4" style="v" sid="2CH 5:4" />ज़ांऊं तिधी सोभ इज़राईली सैणैं पुजै, लेबी च़कअ बिधाते करारो मणशू <verse eid="2CH 5:4" /><verse number="5" style="v" sid="2CH 5:5" />संघा पजैल़अ बिधाते भबना भितरी। प्रोहतै अर लेबी निंयैं करारे मणशू संघै तिंयां सोभ पबित्र भांडै अर सारअ समान ज़ुंण मेल़-ज़ोल़े खिम्भा दी थिऐ। खिम्भ बी निंयं तिन्‍नैं खोल्ही करै उझै। <verse eid="2CH 5:5" /><verse number="6" style="v" sid="2CH 5:6" />राज़अ सुलैमान अर इज़राईली टोली का ज़ेतरै बी लोग तिधी तै आऐ दै, तिंयां लागै करारे मणशू आजू हांढदै अर बाता काटै तिन्‍नैं एतरै खास्सै रिठ अर होर पशूए हेल़्ही कि तिन्‍नां निं कुंण गणी सकदअ त। <verse eid="2CH 5:6" /><verse number="7" style="v" sid="2CH 5:7" />तेखअ पजैल़अ प्रोहतै सह करारो मणशू बिधाता लै बणाऐं दै भबना भितरी तैहा ज़ैगा ज़ेता लै खास पबित्र ज़ैगा बोला तै। संघा डाहअ तिन्‍नां करूब नाओंए स्वर्ग दूते फैंखा हेठै बशैल़ी। <verse eid="2CH 5:7" /><verse number="8" style="v" sid="2CH 5:8" />तिंयां करूबे फैंख तै इहै कि करारो मणशू आअ तेते लोहल़ी संघी तेथ हेठै। <verse eid="2CH 5:8" /><verse number="9" style="v" sid="2CH 5:9" />करारे मणशू दी लाई दी लोहल़ी ती एही लाम्मी कि तिंयां जाआ ती भितरी खास पबित्र ज़ैगा आजू सम्हनै का शुझुई पर होर्ता का निं तिंयां किधी का शुझदी ती। तिंयां लोहल़ी आसा आझ़ तैणीं बी तिधी। <verse eid="2CH 5:9" /><verse number="10" style="v" sid="2CH 5:10" />करारे मणशू भितरी निं तिन्‍नां दूई पात्थरे शिला सुआई होर किछ़ै आथी त ज़ुंण तेथ होरेब धारा का एछी मोसा गूरै तधू डाही ती ज़धू बिधाता इज़राईली संघै मिसर देशा का एछदी बारी करार किई ती।<verse eid="2CH 5:10" /></para>
  <para style="s">बिधातो प्रतप्प</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 5:11" />तेखअ डेऊऐ पबित्र ज़ैगा का सोभै प्रोहत। ज़ेतरै बी प्रोहत तिधी थिऐ तिंयां रहै बिधाता लै ज़ुदै च़ांगै-च़ोखै। संघा रहै आपणैं-आपणैं दले बारीए साबै बिधाते च़ाकरी लागी। <verse eid="2CH 5:11" /><verse number="12" style="v" sid="2CH 5:12" />ज़ेतरै बी लेबी बेदीए पुर्बा बाखा खल़्हुई गाज़ै-बाज़ै करै च़ाकरी करा तै, तिंयां थिऐ असाप, हमान, जदूतून, तिन्‍नें शोहरू अर होर भाई-बंध। तिन्‍नैं हआ तै बाछे च़ोल़ै बान्हैं दै अर तिंयां बाज़ा तै छ़छ़ाल़ा, दंतारै अर बींन। तिन्‍नां संघै हआ तै एक शौ बिह प्रोहत नर्शिंगची खल़्हुऐ दै। <verse eid="2CH 5:12" /><verse number="13" style="v" sid="2CH 5:13" />ज़ांऊं नर्शिंगची अर होर गाज़ै-बाज़ै आल़ै एकी ताला दी बाज़ी बिधातो शूकर अर ज़ै-ज़ैकार किई, घैरी बोली नर्शिंगै, छ़छ़ाल़ा अर होरी साज़ बाज़ा संघै गिह। तिन्‍नैं किई एही गिह बोली बिधाते स्तोती,</para>
  <para style="q" vid="2CH 5:13">“बिधाता आसा भलअ अर</para>
  <para style="q" vid="2CH 5:13">सह झ़ूरा हाम्हां लै सदा।”</para>
  <para style="p" vid="2CH 5:13">तेखअ घोर्हुऐ बिधाते भबना फेर हेरा-हेरी घणैं बादल़। <verse eid="2CH 5:13" /><verse number="14" style="v" sid="2CH 5:14" />तिन्‍नां बादल़ा करै निस्सअ बिधाते भबनै च़ाकरी करनै आल़ै प्रोहते खल़ै टेखुई किल्हैकि बिधाते भबनै लागअ बादल़ा जैंदरी लागअ धुप्पै ज़िहअ झ़ामण अर तेथ लागी बिज़ल़ी ज़ेही झ़प्प-तल़प्पी।<verse eid="2CH 5:14" /></para>
  <chapter eid="2CH 5" />
  <chapter number="6" style="c" sid="2CH 6" />
  <para style="s">सुलैमानै दैनअ परज़ा लै भाषण</para>
  <para style="r">(<ref loc="1KI 8:12-21">1 राज़ै 8:12-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 6:1" />राज़ै सुलैमानै किई बिधाता सेटा एही अरज़,</para>
  <para style="q" vid="2CH 6:1">“बिधाता, तंऐं बोलअ इहअ,<verse eid="2CH 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="2CH 6:2" />‘मुंह रहणअ नटिप्प न्हैरै बादल़ा जैंदरी।’</para>
  <para style="q" vid="2CH 6:2">ऐबै बणाअं मंऐं ताल्है रहणा लै महान भबन</para>
  <para style="q" vid="2CH 6:2">एथ लोल़ी तूह जुगै-जुगै तैणीं रहअ।”<verse eid="2CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 6:3" />तिधी आऐ दै सोभ इज़राईली तै तिधी खल़्हुऐ दै, तेखअ फिरअ राज़अ सुलैमान तिन्‍नां बाखा लै संघा मांगी तेऊ तिन्‍नां लै बिधाता का इहअ बोली बर्गत, <verse eid="2CH 6:3" /><verse number="4" style="v" sid="2CH 6:4" />“इज़राईले परमेशर बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई! तेऊ ज़ुंण ज़बान मेरै बाब दाबेदा लै दैनी ती, सह किई आझ़ तेऊ पूरी। तेऊ बोलअ त इहअ, <verse eid="2CH 6:4" /><verse number="5" style="v" sid="2CH 6:5" />‘ज़धू मंऐं आपणीं परज़ा मिसर देशा का काढी आणी, तधा ओर्ही आझ़ तैणीं निं मंऐं इज़राईले कोही गोत्रा मांझ़ै आप्पू लै एही कोहै नगरी छ़ांटी ज़िधी मेरी पूज़ा-गाज़ा करना लै भबन बणांए। नां कुंण मणछ मेरी परज़ा प्रैंदै राज़ करदअ छ़ांटअ। <verse eid="2CH 6:5" /><verse number="6" style="v" sid="2CH 6:6" />पर ऐबै छ़ांटी मंऐं एरुशलेम नगरी ज़िधी मेरी पूज़ा-गाज़ा होए अर आपणीं परज़ा इज़राईली प्रैंदै राज़ करना लै छ़ांटअ मंऐं तूह दाबेद।’”<verse eid="2CH 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 6:7" />आजू बोलअ सुलैमानै इहअ, “मेरअ बाब दाबेद राज़अ च़ाहा त बिधाता लै एक भबन बणाणअं ताकि तैहा ज़ैगा एछी सोभ इज़राईली माथअ टेक्‍के। <verse eid="2CH 6:7" /><verse number="8" style="v" sid="2CH 6:8" />पर बिधाता बोलअ राज़ै दाबेदा लै, ‘ज़ुंण तूह मुल्है भबन बणाणां लै सोठा, सह सोठ आसा तेरी भली, <verse eid="2CH 6:8" /><verse number="9" style="v" sid="2CH 6:9" />पर ताह निं सह बणाणअं भेटणअ, पर तेरै शोहरू बणाणअं आजू मुल्है भबन।’<verse eid="2CH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 6:10" />“अह ज़ुंण बैण बिधाता बोलअ त, सह किअ तेऊ ऐबै पूरअ। हुंह बेठअ आजू आपणैं बाब दाबेदे ज़ैगा इज़राईल देशो राज़अ अर बिधाता लै भबन बी हेरअ मंऐं बणाईं। <verse eid="2CH 6:10" /><verse number="11" style="v" sid="2CH 6:11" />बिधाते करारे मणशू डाहणां लै बी बणाईं मंऐं भबना भितरी ज़ैगा। तेथ भितरी आसा दूई पात्थरे शिला बिधाते हाम्हां इज़राईली संघै सह करार ज़ुंण बिधाता म्हारै दादा-बाबा संघै मिसर देशा का एछदी बारी सीनाई धारा किई ती।”<verse eid="2CH 6:11" /></para>
  <para style="s">राज़ै सुलैमाने अरज़</para>
  <para style="r">(<ref loc="1KI 8:22-53">1 राज़ै 8:22-53</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 6:12" />तेखअ डेऊअ सुलैमान तिधी सोभी इज़राईली नदरी बिधाते बेदी सेटा संघा किई आपणैं हाथ उझै सरगा बाखा करी एही अरज़। <verse eid="2CH 6:12" /><verse number="13" style="v" sid="2CH 6:13" />राज़ै सुलैमानै ती तिधी एक पांज़ हाथ लाम्मी, पांज़ हाथ बिरली अर चअन हाथ उछ़टी च़ौकी बणाईं दी संघा ती सह बिधाते भबना आजू मांझ़ा-मांझ़ी खोल़ै डाही दी। सुलैमान त इज़राईली सम्हनै तैहा च़ौकी प्रैंदै खल़्हुअ द संघा किई तेऊ ज़ान्हूंए ज़ोरै बेशी सरगा बाखा हाथ करी एही अरज़, <verse eid="2CH 6:13" /><verse number="14" style="v" sid="2CH 6:14" />“हे इज़राईले परमेशर बिधाता, नां स्वर्गै ताह बराबर कुंण आथी अर नां उंधै धरती दी कुंण देअ ताह बराबर आथी! तूह झ़ूरा आपणीं परज़ा लै अर तूह करा तिन्‍नां लै आपणीं करार पूरी ज़ुंण तेरै बधान अर बिधी मनणा लै शुचअ-पाक्‍कअ रहा। <verse eid="2CH 6:14" /><verse number="15" style="v" sid="2CH 6:15" />तंऐं ज़ेही मेरै बाब दाबेदा लै ज़बान दैनी ती, तेतो किअ तंऐं आझ़ आपणअ एक-एक बैण पूरअ। <verse eid="2CH 6:15" /><verse number="16" style="v" sid="2CH 6:16" />ऐबै हे इज़राईले परमेशर बिधाता होर बी ज़ुंण गल्‍ला तंऐं आपणैं दास दाबेदा का आसा बोली दी, तिन्‍नां बी करै पूरी। तंऐं आसा मेरै बाबा लै बोलअ द, ‘तेरी आद-लुआदा मांझ़ै ई हणअ एक ज़ण्हअ इज़राईला प्रैंदै सदा लै राज़अ, ज़ै तिंयां ताह ज़िहै ई मेरै बधान अर बिधी मने।’ <verse eid="2CH 6:16" /><verse number="17" style="v" sid="2CH 6:17" />ऐबै हे इज़राईले परमेशर बिधाता, ज़ुंण तंऐं मेरै बाब दाबेदा का आसा बोलअ, ऐबै लोल़ी तिंयां सोभै गल्‍ला तेही ई निभी।<verse eid="2CH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 6:18" />“हे परमेशर, ऐबै ताह सच्च़ी रहणअ धरती दी मणछा संघै? ताल्है पल़ा सारअ भ्रमंड बी थोल़अ, तेखअ मेरअ बणाअं द अह होछ़अ ज़िहअ भबन किधी च़ाल्‍लअ ताल्है पूरअ पल़ी! <verse eid="2CH 6:18" /><verse number="19" style="v" sid="2CH 6:19" />हे मेरै परमेशर बिधाता, हुंह आसा तेरअ दास, ज़ीबाण, तूह शुण मेरी अरज़ ज़ुंण आझ़ हुंह ताखा करा। <verse eid="2CH 6:19" /><verse number="20" style="v" sid="2CH 6:20" />अह भबन छ़ांटअ तंऐं आप्पू लै कि इधी तेरी पूज़ा-गाज़ा होए। तूह रहै धैल़ी-राची एता भाल़अ लागी अर ज़ेभै हुंह एथ बाखा मोहरअ करी अरज़ करूं, तेता शूणैं तूह। <verse eid="2CH 6:20" /><verse number="21" style="v" sid="2CH 6:21" />हुंह आसा तेरअ दास, अर इज़राईली सारी परज़ा बी आसा तेरी। तेरी इज़राईली परज़ा बी ज़ेभै तेरै भबना बाखा भाल़ी अरज़ करे, तूह शूणैं तेता स्वर्गा का संघा करै म्हारै पाप माफ।<verse eid="2CH 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 6:22" />“ज़ै कहा मणछा दुजै मणछा लै ज़ुल्म करनैओ दोश होए, अर ज़ै सह मणछ तेरै भबनै तेरी बेदी सेटा एछी सोह खाए कि तेऊओ निं किछ़ै कशूर आथी, <verse eid="2CH 6:22" /><verse number="23" style="v" sid="2CH 6:23" />तै हे बिधाता, तूह करै आपणैं दासो नसाफ स्वर्गा का। तूह दैऐ दोशी लै आप्पै सज़ा अर नर्दोश लोल़ी राज्ज़ी-राम्बल़अ रहअ।<verse eid="2CH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 6:24" />“ज़ै तेरी परज़ा इज़राईली ताल्है पाप करनै पिछ़ू दुशमणा का हारे, तेखअ ज़ै तिंयां तेरै भबना लै एछी लेर-पकार पाई ताखा माफी मांगे, <verse eid="2CH 6:24" /><verse number="25" style="v" sid="2CH 6:25" />तूह शूणैं स्वर्गा का तिन्‍नें अरज़ संघा करै आपणीं इज़राईली परज़े पाप माफ। तेखअ आणै तिन्‍नां तैहा ज़ैगा लै बापस फरेऊई ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै आसा दैनी दी।<verse eid="2CH 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 6:26" />“ज़ै तेरी परज़ा ताल्है पाप करनै पिछ़ू तूह ज़ै तिन्‍नां लै सरगा का पाणीं हणअ बंद करे, तेखअ ज़ै तिंयां पाप करनअ छ़ाडे अर तेरै भबना बाखा फिरी ताखा अरज़ करे, <verse eid="2CH 6:26" /><verse number="27" style="v" sid="2CH 6:27" />हे बिधाता, तूह शूणैं तिन्‍नें अरज़ स्वर्गा का संघा करै राज़ै अर इज़राईलीए पाप माफ, तूह दैऐ तिन्‍नां लै भलै करने शिक्षा। हे परमेशर, तेखअ दैऐ तूह आपणीं ऐहा ज़ैगा सरग हणैं ज़ुंण तंऐं सदा लै आपणीं परज़े ज़ैदात आसा बणाईं दी।<verse eid="2CH 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 6:28" />“ज़ै केभै एऊ देशै नकाल़, कि मरी, नाज़ा लै शुक्‍कअ पल़े, रैट्टै, कि नाज़ा लै गाल़्ही लागे, कि तेरी परज़ा दुशमण गोटे, कि तेरी परज़ा लै आफ़त पल़े कि किज़ै रोग लागे, <verse eid="2CH 6:28" /><verse number="29" style="v" sid="2CH 6:29" />तेभै ज़ै तेरी परज़ा इज़राईली दिला का माल़ी च़ेते कि तिन्‍नें भलै हुई गलती अर ज़ै तिंयां मणछ ताह सेटा एऊ भबना बाखा बाह फुआरी अरज़ करे, <verse eid="2CH 6:29" /><verse number="30" style="v" sid="2CH 6:30" />तेभै शूणैं तूह तिन्‍नें अरज़ स्वर्गै आपणैं घअरै संघा छ़ाडै तिन्‍नां लै माफी। तिन्‍नां लै दैऐ ज़सरै मन्‍नैं ज़िहअ होए तिहअ फल। किल्हैकि मणछे मन्‍नैं किज़ै आसा, एतो थोघ हआ सिधअ ताखा ई। <verse eid="2CH 6:30" /><verse number="31" style="v" sid="2CH 6:31" />ताकि तैहा ज़ैगा ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै दैनी ती, तेथ रहणअ तिन्‍नां आपणीं ज़िऊंदी ज़िता तेरी डरा हेठै अर तिन्‍नां करनअ ज़िहअ तूह बोला तिहअ।<verse eid="2CH 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 6:32" />“तेखअ ज़ै तेरी इज़राईली परज़ा छ़ाडी ज़ै कुंण होर दूर परदेसा का तेरअ नाअं अर तेरै महान कामें बारै शूणीं ताह सेटा लै एछे अर सह तेरै एऊ भबना बाखा फिरी अरज़ करे, <verse eid="2CH 6:32" /><verse number="33" style="v" sid="2CH 6:33" />तूह शूणैं तेऊए अरज़ स्वर्ग आपणैं बसेरै का। तूह करै तेऊए दिला-मन्‍नें पूरी ताकि संसारे सोभी लोगा का तेरअ थोघ लागे अर तिंयां बी तेरी परज़ा इज़राईली ज़िहै तेरी डरा हेठै रहे। तेखअ लागणअ तिन्‍नां सोभी का थोघ कि ज़ुंण मंऐं ताल्है भबन बणाअं, अह ज़ैगा आसा तेरी पूज़ा-गाज़ा करने।<verse eid="2CH 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 6:34" />“हे बिधाता, ज़ै केभै तूह आपणीं परज़ा दुशमणा संघै मकाबलै करदै ज़िधा लै बी छ़ाडे, तिंयां ज़िधी बी होए अर ज़ै तिंयां खास्सै दूर हई बी तंऐं आप्पू लै छ़ांटी दी ऐहा नगरी अर मंऐं ताल्है बणाऐं दै एऊ भबना बाखा आपणअ मोहरअ करी ताह बिधाता सेटा अरज़ करे, <verse eid="2CH 6:34" /><verse number="35" style="v" sid="2CH 6:35" />तूह शूणैं तिन्‍नें अरज़ स्वर्गै संघा दैऐ तिन्‍नां लै तिन्‍नें दुशमणा का ज़ीत।<verse eid="2CH 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2CH 6:36" />“हे बिधाता, एही ता आसा सोभ मणछ पापी, पर ज़ै तेरी परज़ा ताल्है पाप करे, अर तेता पिछ़ू ज़ै तूह इहअ रुश्शे कि तेरी परज़ा दुशमणा का हारे अर दुशमण तिन्‍नां होरी देशा लै कैद करी निंए, च़ाऐ सह देश केतरअ बी दूर किल्है निं होए, <verse eid="2CH 6:36" /><verse number="37" style="v" sid="2CH 6:37" />तूह शूणैं आपणीं परज़े अरज़ तेथ बी। ज़ेऊ देशै तिंयां कैद करी होए निऐं दै, ज़ै तेथ तिंयां ताह सेटा लेर-पकार पाई बोले, ‘हे म्हारै बिधाता, हाम्हैं किअ घोर पाप, हाम्हैं आसा खास्सै कदुष्ट अर हाम्हैं किअ बेघै कदुष्ट काम।’ <verse eid="2CH 6:37" /><verse number="38" style="v" sid="2CH 6:38" />तेखअ ज़ै तिंयां दिला का माल़ी च़ेते अर तिंयां दूर दुशमणे देशा का बी तैहा ज़ैगा ज़ुंण तंऐं तिन्‍नें दादा-बाबा लै दैनी ती, ऐहा नगरी ज़ुंण तंऐं आप्पू लै छ़ांटी अर भबन ज़ुंण मंऐं ताल्है बणाअं, एथ बाखा मोहरअ करी ताखा अरज़ करे, <verse eid="2CH 6:38" /><verse number="39" style="v" sid="2CH 6:39" />तूह शूणैं तिन्‍नें अरज़ स्वर्गै आपणैं बसेरै का। संघा करै तिन्‍नां लै झींण अर तूह करै आपणीं परज़े सोभ पाप माफ।<verse eid="2CH 6:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2CH 6:40" />“ऐबै हे परमेशर बिधाता, तूह शूणैं तेभै म्हारी ज़ेभै हाम्हैं एऊ भबनै एछी ताखा अरज़ करे।<verse eid="2CH 6:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="2CH 6:41" />ए म्हारै परमेशर बिधाता, ऐबै एछ तूह आपणैं नऊंऐं घअरा लै</para>
  <para style="q" vid="2CH 6:41">संघा बस्सै इधी सदा लै, तेरै ज़ोरे नशाणी तेरअ करारो मणशू आसा हाम्हैं तिधी डाही हेरअ द।</para>
  <para style="q" vid="2CH 6:41">तूह दैऐ प्रोहते सोभी कामां लै बर्गत, तेरी सारी परज़ा लोल़ी तेरी भलाई करै सदा खुश रही।<verse eid="2CH 6:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="2CH 6:42" />हे परमेशर बिधाता, ज़ुंण राज़अ तंऐं छ़ांटअ, तेऊ निं शोटी डाही।</para>
  <para style="q" vid="2CH 6:42">तूह डाहै सदा आद कि तूह आपणैं दास दाबेदा लै किहअ झ़ूरा।”<verse eid="2CH 6:42" /></para>
  <chapter eid="2CH 6" />
  <chapter number="7" style="c" sid="2CH 7" />
  <para style="s">बिधाते भबने प्रतिष्ठा</para>
  <para style="r">(<ref loc="1KI 8:62-66">1 राज़ै 8:62-66</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 7:1" />ज़ांऊं राज़अ सुलैमान बिधाता सेटा अरज़ करी मुक्‍कअ, सरगा का पल़ी आग, बेदी दी ज़ुंण हूम बल़ीदान त किअ द, सह दझ़अ पठी। बिधाते धुप्पै ज़िहै झ़ामणा करै भर्हुअ सारअ भबन। <verse eid="2CH 7:1" /><verse number="2" style="v" sid="2CH 7:2" />झ़ामण त इहअ खास्सअ कि प्रोहता मांझ़ै निं कोहै बिधाते भबना भितरी डेऊई सकै। <verse eid="2CH 7:2" /><verse number="3" style="v" sid="2CH 7:3" />ज़ांऊं इज़राईली परज़ा भाल़अ कि सरगा का पल़ी आग अर भबन भर्हुअ बिधाते धुप्पै ज़िहै झ़ामणा करै, तिन्‍नैं सोभी टेक्‍कअ धरनीं उटै पल़ी माथअ संघा किअ इहअ बोली बिधातो शूकर,</para>
  <para style="q" vid="2CH 7:3">“बिधाता आसा भलअ अर</para>
  <para style="q" vid="2CH 7:3">सह झ़ूरा हाम्हां लै सदा।”<verse eid="2CH 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 7:4" />तेखअ किअ राज़ै सुलैमानै अर तिधी आऐ दै सोभी इज़राईली बिधाता लै मेल़-ज़ोल़ो बल़ीदान। <verse eid="2CH 7:4" /><verse number="5" style="v" sid="2CH 7:5" />तिन्‍नैं किऐ तिधी बाई हज़ार बल्द, एक लाख बिह हज़ार रिठे हेल़्ही मेल़-ज़ोल़े बल़ीदान अर इहअ करै हुई बिधाते भबने प्रतिष्ठा। <verse eid="2CH 7:5" /><verse number="6" style="v" sid="2CH 7:6" />सोभ इज़राईली तै खल़्हुऐ दै, प्रोहत तै आजू ज़ुदै ज़िहै खल़्हुऐ दै अर नर्शिंगै बाज़दै लागै दै। होर लेबी तै तिन्‍नां बाखा स्मोहरै फिरी तिन्‍नां साज़-बाज़ा बाज़दै लागै दै ज़ुंण राज़ै दाबेदै थिऐ बणाणैं बझ़ैल़ै दै। तिंयां थिऐ इहअ राग लाई बिधाते ज़ै-ज़ैकार करदै लागै दै, “बिधाता झ़ूरा हाम्हां लै सदा!”<verse eid="2CH 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 7:7" />तैहा ई धैल़ी किई राज़ै सुलैमानै बिधाते भबना आजू ताटीए बी प्रतिष्ठा। तेऊ किऐ तिधी खास्सै हूम, मेल़-ज़ोल़ अर नाज़ बल़ीदान करी बेदी बागै ताटी दी हूम। किल्हैकि भबना आजू कांस्से बेदी दी निस्सी ती सोभै च़िज़ा हूम करना लै अक्‍की।<verse eid="2CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 7:8" />सुलैमान राज़ै अर सारी इज़राईली परज़ा मनाऊंअ तेता बाद साता धैल़ी तैणीं छ़ानींओ थैर। बिधाते तैहा जाचा लै आऐ उतरा बाखा हमात ज़ोता ओर्ही पछ़मा बाखा मिसर देशे सिऊंआं तैणींए खास्सै मणछ। <verse eid="2CH 7:8" /><verse number="9" style="v" sid="2CH 7:9" />साता धैल़ी तैणीं रहै भबने प्रतिष्ठा लै अर तेता बाद मनाऊंअ साता धैल़ै तैणीं छ़ानींओ थैर। <verse eid="2CH 7:9" /><verse number="10" style="v" sid="2CH 7:10" />त्रेई शऊजै मुक्‍की तिन्‍नें जाचा अर तैहा ई धैल़ी छ़ाडै राज़ै सुलैमानै सोभ आपणैं-आपणैं घअरा लै। सोभ लोग डेऊऐ खुशी-खुशी आपणैं-आपणैं घअरा लै किल्हैकि बिधाता दैनी आपणैं दास दाबेद अर इज़राईली परज़ा लै खास्सी बर्गत।<verse eid="2CH 7:10" /></para>
  <para style="s">बिधाता आअ भिई राज़ै सुलैमाने सुपनै</para>
  <para style="r">(<ref loc="1KI 9:1-9">1 राज़ै 9:1-9</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 7:11" />राज़अ सुलैमान मुक्‍कअ त बिधाता लै भबन अर आप्पू लै मैहल बणाईं, होर बी ज़िहअ सह च़ाहा त, तेता बी मुक्‍कअ सह बणाईं। <verse eid="2CH 7:11" /><verse number="12" style="v" sid="2CH 7:12" />तेखअ हुअ बादा का इहअ कि बिधाता किई सुलैमाना संघै भिई सुपनै गल्‍ला। बिधाता बोलअ तेऊ लै इहअ, “मंऐं शूणीं तेरी अरज़ अर इहअ बी कि तूह किज़ै च़ाहा कि हुंह करूं। ज़ुंण तंऐं मुल्है अह भबन बणाअं, अह ज़ैगा किई मंऐं सदा लै ज़िधी सोभ मुल्है हूम करे। <verse eid="2CH 7:12" /><verse number="13" style="v" sid="2CH 7:13" />ज़ै सरग नांईं होए अर साल-फसला खांदै हुंह रैट्टै छ़ाडूं, ज़ै हुंह आपणीं परज़ा मांझ़ै माहा मरी पाऊं, <verse eid="2CH 7:13" /><verse number="14" style="v" sid="2CH 7:14" />तेखअ ज़ै तिंयां मुंह सेटा अरज़ करे अर ज़ै तिंयां दिला का पाप करनअ छ़ाडे, तै हेरनी मुंह स्वर्गा का तिन्‍नें अरज़ शूणीं अर तिन्‍नें पाप माफ करी करनी मुंह तिन्‍नें ज़िम्मीं-ज़ैगा भिई रज़दी-पज़दी।<verse eid="2CH 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 7:15" />“एऊ भबनै रहणीं मेरी नदर सदा अर ज़ुंण इधी अरज़ करे, सह हेरनी मुंह शूणीं। <verse eid="2CH 7:15" /><verse number="16" style="v" sid="2CH 7:16" />किल्हैकि अह ज़ैगा छ़ांटी मंऐं सदा लै पबित्र ज़िधी सदा मेरी पूज़ा-गाज़ा होए। इधी रहणीं कबल्‍ली मेरी नदर लागी। <verse eid="2CH 7:16" /><verse number="17" style="v" sid="2CH 7:17" />ज़ै तूह आपणैं बाब दाबेदा ज़िहअ शुचअ-पाक्‍कअ रही मेरी च़ाकरी करे अर ज़ै तूह मेरअ बधान अर तेते सोभी बिधी मने, <verse eid="2CH 7:17" /><verse number="18" style="v" sid="2CH 7:18" />तै हणीं मेरी सह ज़बान पूरी ज़ुंण मंऐं तेरै बाब दाबेदा लै बोला त कि तेरी आद-लुआदा मांझ़ै हणअ एक ज़ण्हअ इज़राईला दी सदा राज़अ। <verse eid="2CH 7:18" /><verse number="19" style="v" sid="2CH 7:19" />पर ज़ै तूह या तेरै आद-लुआद मेरै हुकम नांईं मने अर होरी देअआ पूज़दै लागे, <verse eid="2CH 7:19" /><verse number="20" style="v" sid="2CH 7:20" />तेखअ निं हुंह आपणीं परज़ा इज़राईली तैहा ज़ैगा रहणैं दैंदअ ज़ुंण मंऐं तिन्‍नां लै दैनी ती। तेखअ अह भबन ज़ुंण मंऐं आपणीं पूज़ा करना लै पबित्र मनअ, एथ बी लागणै बाण-भेखल़। तेखअ हणैं इज़राईली होरी देशा लै हास्सणां अर सुहांगा लै।<verse eid="2CH 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 7:21" />“तेखअ रहणीं एऊ भबनै सिधी पात्थरे डिंगरी! एसी बाती एछदै नांहंदै लागणअ एता भाल़ी प्राच अर तिंयां हणैं रहैन संघा बोल़णअ, ‘एऊ देशा अर एऊ भबना संघै बिधाता इहअ किल्है किअ?’ <verse eid="2CH 7:21" /><verse number="22" style="v" sid="2CH 7:22" />तेखअ बोल़णअ होरी लोगा इहअ, ‘इज़राईली छ़ाडअ आपणअ परमेशर बिधाता मनणअ ज़ुंणीं तिंयां मिसर देशा का काढी आणै तै! ऐबै लागै तिंयां होरी देअआ पूज़दै तैही किऐ बिधाता तिंयां इहै खतम।’”<verse eid="2CH 7:22" /></para>
  <chapter eid="2CH 7" />
  <chapter number="8" style="c" sid="2CH 8" />
  <para style="s">राज़ै सुलैमाने काम</para>
  <para style="r">(<ref loc="1KI 9:10-28">1 राज़ै 9:10-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 8:1" />राज़ै सुलैमाना लागी बिधाता लै भबन अर आप्पू लै मैहल बणाणां लै कोई बिह साला। <verse eid="2CH 8:1" /><verse number="2" style="v" sid="2CH 8:2" />तेऊ च़िणीं तिंयां नगरी बी भिई ज़ुंण तेऊ लै राज़ै हिरामै दैनी ती, संघा बसाऊऐ तेथ इज़राईली। <verse eid="2CH 8:2" /><verse number="3" style="v" sid="2CH 8:3" />सुलैमानै किअ हमात-सोबा मुल्खै कबज़अ। <verse eid="2CH 8:3" /><verse number="4" style="v" sid="2CH 8:4" />सुलैमानै बझ़ैल़ी तदमोर नगरी भिई च़िणनै अर हमात मुल्खे नगरी बी बझ़ैल़ी भिई च़िणनै अर तिधी डाहअ तेथ डाहै तेऊ आपणैं भढार बणाईं। <verse eid="2CH 8:4" /><verse number="5" style="v" sid="2CH 8:5" />उझलै अर उंधलै बेथ-हारोन नगरी बी किई तेऊ फेर-फिरदै गहल़ च़िणीं अर प्रऊल़ी लाई पाक्‍की। <verse eid="2CH 8:5" /><verse number="6" style="v" sid="2CH 8:6" />यहूदा रेगीस्तानै बालात अर तामार नगरी, ज़ेतरी नगरी दी सुलैमाने ज़िणसीए भढार थिऐ अर रथ-घोल़ै थिऐ, तिंयां बी च़िणीं तेऊ भिई। एरुशलेम, लाबानोन अर ज़ेतरी बी नगरी दी तेऊओ राज़ त, तिंयां नगरी किई सुलैमानै ज़िहअ सह च़ाहा त तेही पाक्‍की। <verse eid="2CH 8:6" /><verse number="7-8" style="v" sid="2CH 8:7-8" />सुलैमान राज़े बेठू तै कनानी लोगे आजू आद-लुआद ज़ुंण इज़राईली कनान देशे ज़ैगा गिम्मदी बारी ज़िऊंदै छ़ाडै तै। तिंयां थिऐ अमोरी, हित्ती, परिजी, हिब्बी, जबेशी अर आझ़ तैणीं बी<note caller="+" style="f"><char style="fr" closed="false">8:7-8 </char><char style="fq" closed="false">आझ़ तैणीं बी </char><char style="ft" closed="false">मतलब ऐहा कताबा लिखणे ज़मानै तैणीं</char></note> आसा ईंयां लोग गलामी ई दी। <verse eid="2CH 8:7-8" /><verse number="9" style="v" sid="2CH 8:9" />पर इज़राईली मांझ़ै निं सुलैमानै कोहै बेठू बणाअं। इज़राईली हआ तै तेऊए कार-करिंदै, सैना दी, सैनापति अर रथ अर घोल़ै शुंआरीए दलपति। <verse eid="2CH 8:9" /><verse number="10" style="v" sid="2CH 8:10" />राज़ै सुलैमाने कार-करिंदै मांझ़ै तै दूई शौ पज़ाह ज़ण्हैं ज़ुंण बेठूए कामों ज़ैगै-ज़ैगै धैन डाहा तै।<verse eid="2CH 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 8:11" />सुलैमाने राणीं ती मिसर देशे माहा राज़ेए देई, सह आणी तेऊ दाबेदपूर गहल़ा का तेऊ नऊंऐं मैहला लै ज़ुंण तेऊ खास तैहा लै च़िणअ त। किल्हैकि दाबेदपूर आणअ त बिधाते करारो मणशू। सुलैमानै बोलअ इहअ, “अह निं इज़राईले राज़ै दाबेदे मैहलै डाहणीं किल्हैकि ज़िधी करारो मणशू बशैल़अ, सह ज़ैगा बी हआ खास पबित्र।”<verse eid="2CH 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 8:12" />सुलैमानै बिधाता लै ज़ुंण बेदी ती बणाईं दी, तेथ किऐ तेऊ बिधाता लै हूम अर मेल़-ज़ोल़े बल़ीदान। <verse eid="2CH 8:12" /><verse number="13" style="v" sid="2CH 8:13" />राज़अ सुलैमान करा त हर धैल़ै, बशैघे धैल़ी, पुनूंईए धैल़ै मोसा गूरे बधाने साबै बल़ीदान करी बेदी दी हूम। आखरी रोटीओ थैर, नऊंईं साल-फसलो थैर अर छ़ानींओ थैर। ईंयां थैर ज़ुंण चअन हर साल हआ तै एथ बी करा त सह बधाने साबै बल़ीदान करी हूम। <verse eid="2CH 8:13" /><verse number="14" style="v" sid="2CH 8:14" />राज़ै सुलैमानै दैनअ प्रोहत अर लेबी लै ज़ुदै-ज़ुदै तिन्‍नें च़ाकरी करनैओ काम सभाल़ी ज़िहअ तेऊए बाब राज़ै दाबेदै खोज़ी-बोली त डाहअ द। लेबी मांझ़ै डाहै थोल़ै साज़-बाज़ बाज़णैं आल़ै अर तेता संघै करा तै तिंयां प्रोहता संघै च़ाकरी बी। ज़िहअ परमेशरे दास राज़ै दाबेदै हुकम त किअ द, बिधाते भबने पहरी बी डाहै तेऊ ई साबै ज़ुदै-ज़ुदै दला दी बांडी कि तिंयां आपणीं-आपणीं बारी दी पहरअ दैए। <verse eid="2CH 8:14" /><verse number="15" style="v" sid="2CH 8:15" />ज़िहअ बी राज़ै दाबेदै हुकम त किअ द, सोभ काम सभाल़ै प्रोहत, लेबी, भढारे बारै तिहै ई।<verse eid="2CH 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 8:16" />ज़िहअ बी राज़ै सुलैमानै बिधाते भबने आथरी उझै मडोखरै तैणीं करनअ सोठअ त, सह छ़ेक्‍कअ त तेऊ बणाईं।<verse eid="2CH 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 8:17" />राज़अ सुलैमान डेऊअ एदोम देशै एलात नगरी नेल़ लाल समुंदरे बाढै एजोन-गेबर मुल्खै। <verse eid="2CH 8:17" /><verse number="18" style="v" sid="2CH 8:18" />राज़ै हिरामै दैनै तेऊ लै पाणींए ज़हाज़ अर तेता च़लाऊंणैं आल़ै कप्तान अर सज़ाण सपाही। तिंयां डेऊऐ ओपीर नगरी अर तिधा का आणअ एक शौ शाठ कुंटल़ सुन्‍नअ राज़ै सुलैमाना लै।<verse eid="2CH 8:18" /></para>
  <chapter eid="2CH 8" />
  <chapter number="9" style="c" sid="2CH 9" />
  <para style="s">शेबा देशे राणीं पुजी राज़ै सुलैमाना सेटा मिलदी</para>
  <para style="r">(<ref loc="1KI 10:1-13">1 राज़ै 10:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 9:1" />शेबा नगरीए राणीं शूणीं बिधाते बारै राज़ै सुलैमाने मशूरी, सह आई एरुशलेम नगरी लै सुलैमाना का कठण सुआला पुछ़दी कि तेऊ परखे। तैहा आणअ आप्पू संघै आपणैं कार-करिंदैओ बडअ दल एरुशलेम नगरी लै। सुलैमाना लै आणै तैहा किम्मती मणीं, सुन्‍नैं अर कई रंगे खुशबूदार मसालै ऊँट लादी भैंट। सुलैमाना सेटा पुजी लागी सह तिन्‍नां सुआला पुछ़दी ज़ुंण तैहा सोठी तै डाहै दै। <verse eid="2CH 9:1" /><verse number="2" style="v" sid="2CH 9:2" />राज़ै सुलैमानै दैनअ तेसे सोभी सुआलो ज़बाब, एही निं किज़ै गल्‍ल ई रही ज़ुंण सुलैमान तैहा का खोज़ी निं सकअ। <verse eid="2CH 9:2" /><verse number="3" style="v" sid="2CH 9:3" />शेबा नगरीए राणीं हुई राज़ै सुलैमाने अक्ल भाल़ी रहैन। ज़ांऊं तैहा सुलैमानो मैहल, <verse eid="2CH 9:3" /><verse number="4" style="v" sid="2CH 9:4" />तेऊए पलगा दी खाणअ-पिणअ अर तेऊए कार-करिंदै किहै बेठा, तेऊए दास-दासी किहै झिकल़ै बान्हीं हआ खल़ै, तेऊए मैहलै रोटी-पाणीं खैऊंणैं-पणैऊंणै आल़ैओ किहअ सूल आसा अर राज़अ सुलैमान बिधाते भबना लै डेऊई किहअ बल़ीदान करा करी, सह हुई इना सोभी गल्‍ला भाल़ी हक्‍की-बक्‍की।<verse eid="2CH 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 9:5" />तैहा बोलअ राज़ै सुलैमाना लै, “ज़िहअ मंऐं आपणैं देशै तेरै अर तेरी अक्लीए बारै शूणअ त, तूह आसा असली दी तिहअ ई। <verse eid="2CH 9:5" /><verse number="6" style="v" sid="2CH 9:6" />पर ज़ांऊं तैणीं मंऐं इधी एछी आपणीं आछी निं भाल़अ, तेभै तैणीं निं मुंह विश्वास हुअ। मुखा निं एते आधी गल्‍ले बारै बी थोघ आथी त। ज़ेतरअ मुखा खोज़अ त, तूह आसा तेता का कई गुणा खास्सअ अक्ली आल़अ। <verse eid="2CH 9:6" /><verse number="7" style="v" sid="2CH 9:7" />तेरी च़ाकरी करनै आल़ै कार-करिंदै भाल़ किहै भागा आल़ै आसा तेरै दास-दासी ज़ुंण कबल्‍लै ताह सेटा रहा अर तेरी अक्लीए गल्‍ला शूणां! <verse eid="2CH 9:7" /><verse number="8" style="v" sid="2CH 9:8" />तेरै परमेशर बिधाते लोल़ी ज़ै-ज़ैकार हुई, सह आसा ताल्है खुश अर तेऊ बणाअं तूह इज़राईल देशो राज़अ। किल्हैकि इज़राईला लै तेऊए झ़ूरी आसा अटल़। तूह बणाअं तेऊ तिन्‍नां प्रैंदै एते तैणीं राज़अ कि धर्म अर नसाफ बणी रहे।”<verse eid="2CH 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 9:9" />शेबा नगरीए राणीं दैनअ राज़ै सुलैमाना लै पज़ाह कुंटल़ सुन्‍नअ, खास्सी किम्मती मणीं, खास्सै खुशबूदार किम्मती मसालै कि तेता का आजी नां तेता बाद कुंणी तेही किम्मती च़िज़ा अर तिहै बधिया मसालै राज़ै सुलैमाना लै दैनै।<verse eid="2CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 9:10" />राज़ै हिरामे ज़हाज़ बी ज़ुंण ओपीर नगरी का सुन्‍नअ आणा तै, तिन्‍नैं बी आणअ खास्सअ सुन्‍नअ, च़ंदने काठ अर खास्सी किम्मती मणीं। <verse eid="2CH 9:10" /><verse number="11" style="v" sid="2CH 9:11" />च़ंदने काठा करै बणाऐं राज़ै सुलैमानै बिधाते भबन अर राज़ दरबारा लै शिहल़ी अर गिहा बोल़णैं आल़ै लै बींन, अर तारा आल़ै साज़-बाज़। इहै च़ंदने काठ बी निं आझ़ तैणीं इज़राईले राज़ै लै कोही दैनै तै अर नां कुंणी तधा बाद दैनै।<verse eid="2CH 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 9:12" />शेबा नगरीए राणीं दैनी होर बी ज़िहअ राज़ै सुलैमानै च़ाहअ तेही भैंट अर राज़ै सुलैमानै बी दैनअ तैहा लै तिहअ ई ज़िहअ सह च़ाहा ती। तेखअ डेऊई सह अर तेसे कार-करिंदैओ सारअ दल आपणैं देशा लै फिरी।<verse eid="2CH 9:12" /></para>
  <para style="s">राज़ै सुलैमाने ज़ैदात</para>
  <para style="r">(<ref loc="1KI 10:14-25">1 राज़ै 10:14-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 9:13" />हर साल एछा त राज़ै सुलैमाना सेटा लै दूई शौ पज़ाह कुंटल़ सुन्‍नअ, <verse eid="2CH 9:13" /><verse number="14" style="v" sid="2CH 9:14" />बपारी का कारअ, अरब देशे राज़ै का कारअ अर आपणैं इज़राईल देशे राज़पाला का कारअ एछा त इना ढब्बै का लाऊआ। <verse eid="2CH 9:14" /><verse number="15" style="v" sid="2CH 9:15" />राज़ै सुलैमानै त सुन्‍नअ गाल़ी करै बडी-बडी ढाल़ा बणाईं दी, एकी-एकी ढाल़ा दी थिअ कोई सात-सात किलू सुन्‍नअ लाअ द। <verse eid="2CH 9:15" /><verse number="16" style="v" sid="2CH 9:16" />तेही ई बणाईं राज़ै सुलैमानै चअन शौ होर ढाल़ा अर तेथ त एकी-एकी ढाल़ा दी कोई दूई-दूई किलू सुन्‍नअ लाअ द। तिंयां ढाल़ा ती तेऊ आपणैं मैहलै अर लाबानोन बणां नाओंए मैहलै डाही दी।<verse eid="2CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 9:17" />आप्पू लै ती तेऊ हाथी दांदे राज़गाद्दी बणाईं दी अर सह थिई च़ोखै सुन्‍नैं करै महल़ी दी। <verse eid="2CH 9:17" /><verse number="18" style="v" sid="2CH 9:18" />राज़गाद्दी लै थिई तोल़ा बाखा उझै छ़ह पैल़ी अर हर पैल़ी, तेथ प्रैंदै ती खूरा टकैल़णा लै सुन्‍नैं करै महल़ी दी च़ौकी। राज़गाद्दीए आसना दी थिऐ दोहरी बाखा बाहा टकैल़णा लै ढासणैं लाऐ दै अर तेथ थिऐ दोहरी बाखा सिहा ज़िहै मुंह। <verse eid="2CH 9:18" /><verse number="19" style="v" sid="2CH 9:19" />पैल़ी दी थिऐ दोहरी बाखा बाढै सिहा ज़िहै मुंह काढै दै। तिंयां सिहा ज़िहै मुंह तै पठी बारा। एही राज़गाद्दी निं सारै संसारै किधी आथी ती।<verse eid="2CH 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 9:20" />राज़ै सुलैमाने झुटणें भांडै बी थिऐ च़ोखै सुन्‍नैं करै बणाऐं दै। लाबानोन बणां नाओंए मैहलै डाहै दै सोभै भांडै बी थिऐ सोभै च़ोखै सुन्‍नें। तेथ निं च़ंदीओ एक बी भांडअ आथी त। राज़ै सुलैमाने ज़मानैं निं च़ंदीओ किज़ै मोल ई समझ़दै तै। <verse eid="2CH 9:20" /><verse number="21" style="v" sid="2CH 9:21" />राज़ै सुलैमानै थिऐ तरशीश डेऊणा लै समुंदरे बपारा करने खास्सै ज़हाज़ डाहै दै। तिन्‍नां करा त सह राज़ै हिरामा संघै हर चिऊथी साला सुन्‍नैं, च़ंदी, हाथी दांद, गूणी-बांदर अर मोरा आणदै छ़ाडी।<verse eid="2CH 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 9:22" />राज़अ सुलैमान त संसारे सोभी राज़ै का खास्सअ सेठ अर अक्ली आल़अ। <verse eid="2CH 9:22" /><verse number="23" style="v" sid="2CH 9:23" />सारै देशा का च़ाहा तै लोग राज़ै सुलैमाना का सलाह लणी अर अक्ल शुणनी ज़ुंण तेऊ लै बिधाता थिई दैनी दी। <verse eid="2CH 9:23" /><verse number="24" style="v" sid="2CH 9:24" />ज़ुंण बी राज़ै सुलैमाना सेटा एछा त, सह आणा त तेऊ सेटा भैंट ज़रूर। हर साल एछा तै तेऊ सेटा दूरा-दूरा का लोग संघा आणा तै सुन्‍नअ, च़ंदी, किम्मती झिकल़ै, अस्त्र-शस्त्र, खुशबूदार मसालै, घोल़ै अर खच़रा लादी।<verse eid="2CH 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 9:25" />राज़ै सुलैमाना का थिऐ घोल़ै अर रथा डाहणां लै च़ार हज़ार आडै अर तेऊ का थिऐ बारा हज़ार जुधे घोल़ै। तिन्‍नां मांझ़ै तै तेऊ थोल़ै एरुशलेम डाहै दै अर बाकी तै होरी-होरी नगरी डाहै दै। <verse eid="2CH 9:25" /><verse number="26" style="v" sid="2CH 9:26" />सुलैमान त फरात दरैऊए देशा ओर्ही उतरा बाखा पलिश्ती देशे अर दखणा बाखा मिसर देशे सिऊंआं दी सोभी देशे राज़ै प्रैंदै माहा राज़अ। <verse eid="2CH 9:26" /><verse number="27" style="v" sid="2CH 9:27" />सुलैमाने राज़ा दी हुअ त एरुशलेम नगरी च़ंदीओ मोल केल़ुईए काठ, पात्थर अर यहूदा मुल्खै निऊल़ै लागै दै आम डाल़-बूटे काठा बराबर। <verse eid="2CH 9:27" /><verse number="28" style="v" sid="2CH 9:28" />राज़अ सुलैमान आणा त आप्पू लै घोल़ै मिसर अर होरी-होरी देशा का।<verse eid="2CH 9:28" /></para>
  <para style="s">राज़ै सुलैमाने मौत</para>
  <para style="r">(<ref loc="1KI 11:41-43">1 राज़ै 11:41-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 9:29" />राज़ै सुलैमानो बाकी इतिहास आसा शुरू का खिरी तैणीं नातान गूर, शिलोहे आहिजा गूर अर ईदू गूरै लिखी डाहअ द। ईदू गूर आसा सह ज़ुंणी नबाते शोहरू जरोबामो इतिहास बी आसा लिखअ द। <verse eid="2CH 9:29" /><verse number="30" style="v" sid="2CH 9:30" />राज़ै सुलैमानै किअ एरुशलेम नगरी का च़ाल़्ही साला तैणीं सारै इज़राईल देशै राज़। <verse eid="2CH 9:30" /><verse number="31" style="v" sid="2CH 9:31" />खिरी मूंअ राज़अ सुलैमान संघा डाहअ दाबेदपूर नगरी दाबी अर आजू बेठअ तेऊओ शोहरू रहबाम तेऊए ज़ैगा राज़अ।<verse eid="2CH 9:31" /></para>
  <chapter eid="2CH 9" />
  <chapter number="10" style="c" sid="2CH 10" />
  <para style="s">उतरा बाखा बस्सै दै इज़राईलीओ द्रोह</para>
  <para style="r">(<ref loc="1KI 12:1-20">1 राज़ै 12:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 10:1" />रहबाम डेऊअ शकेम नगरी, तिधी त उतरा बाखा बस्सै दै सोभी इज़राईली तेऊ राज़ै बणाणां लै झाल़अ किअ द। <verse eid="2CH 10:1" /><verse number="2" style="v" sid="2CH 10:2" />नबातो शोहरू जरोबाम त राज़ै सुलैमाने डरै ठुर्ही मिसर देशे राज़ै सेटा रहंदअ लागअ द। ज़ांऊं तेऊ का थोघ लागअ कि इहअ-इहअ हुअ, सह आअ मिसर देशा का फिरी। <verse eid="2CH 10:2" /><verse number="3" style="v" sid="2CH 10:3" />पर उतरा बाखा बस्सै दै इज़राईली गोत्रै शादअ जरोबाम अर तेखअ डेऊऐ तिंयां जरोबामा संघा निंईं रहबामा सेटा। तिन्‍नैं बोलअ रहबामा लै, <verse eid="2CH 10:3" /><verse number="4" style="v" sid="2CH 10:4" />“तेरै बाब राज़ै सुलैमानै डाहै हाम्हैं मारी-मारी कामां लाई अर कारै दैणैंओ बोझ़ बी पाअ हाम्हां लै बेघै खास्सअ। ज़ै तूह म्हारै एऊ बोझ़ा हल़कअ करे अर म्हारअ ज़िऊंणअ बी सान करे, तै आसा हाम्हैं मानदारी संघै तेरी च़ाकरी करना लै मज़ूर।”<verse eid="2CH 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 10:5" />रहबामै दैनअ ज़बाब, “मुंह दैआ सोठी लणैं, तम्हैं लोल़ी चिई धैल़ै बाद मुंह सेटा भिई आऐ, तेखअ खोज़ूं हुंह तम्हां का आपणअ ज़बाब।”<verse eid="2CH 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 10:6" />राज़ै रहबामै लई तिन्‍नां सैणैं-प्रोढै का सलाह ज़ुंण तेऊए बाब सुलैमाना संघै सारी अमरा रहै, “तम्हैं दैआ मुल्है ओर्ही सलाह कि हुंह परज़ा लै किज़ै ज़बाब दैंऊं?”<verse eid="2CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 10:7" />तिन्‍नैं दैनअ रहबामा लै ज़बाब, “ज़ै तूह इहअ च़ाहा कि परज़ा तेरी शुणें, तै कर तिन्‍नां संघै भली गल्‍ला अर तिन्‍नों बोझ़ हल़कअ करी कर तिन्‍नां खुश, तिहअ करै रहणैं तिंयां सदा तेरै गलाम।”<verse eid="2CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 10:8" />रहबामै किई सैणैं-प्रोढे सलाह शूणीं नां शूणीं अर सह डेऊअ तेखअ तिन्‍नां आपणीं सुआल़ीए खारकै मणछा का सलाह पुछ़दअ ज़ुंण तेऊ संघै होछ़ी उझै रहा तै। <verse eid="2CH 10:8" /><verse number="9" style="v" sid="2CH 10:9" />रहबामै पुछ़अ तिन्‍नां का, “परज़ा बोला मुल्है तिन्‍नों बोझ़ हल़कअ करना लै, तम्हैं मुल्है एते बारै किज़ै सलाह दैआ कि हुंह किज़ै करूं?”<verse eid="2CH 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 10:10" />तिन्‍नैं दैनअ तेऊ लै ज़बाब, “तूह बोलै तिन्‍नां लै इहअ, ‘मेरी कान्हीं गुंठी आसा मेरै बाबे कुछी का बी मोट्टी, <verse eid="2CH 10:10" /><verse number="11" style="v" sid="2CH 10:11" />मेरै बाबै पाअ तम्हां लै खास्सअ बोझ़, मुंह पाणअ तम्हां लै तेता का बी खास्सअ। तेऊ च़िक्‍कै तम्हैं कोल़ै करै, मुंह क्रिंज़णै तम्हैं लोहे तिछै बिंच़ू करै।’”<verse eid="2CH 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 10:12" />ज़ेही गल्‍ल हुई ती, तिहै ई गऐ च़ौथै धैल़ै जरोबाम अर होर इज़राईली राज़ै रहबामा सेटा पुजी। <verse eid="2CH 10:12" /><verse number="13" style="v" sid="2CH 10:13" />राज़ै रहबामै निं सैणैं-प्रोढे सलाह दी धैन दैनअ अर तेऊ दैनअ तिन्‍नां लै काठअ ज़बाब, <verse eid="2CH 10:13" /><verse number="14" style="v" sid="2CH 10:14" />ज़ेही तेऊ लै खारकै मणछै सलाह दैनी तेऊ दैनअ परज़ा लै तिहअ ई ज़बाब, “मेरै बाबै पाअ तम्हां लै खास्सअ बोझ़, पर मुंह पाणअ तम्हां लै तेता का बी खास्सअ। तेऊ च़िक्‍कै तम्हैं कोल़ै करै, मुंह क्रिंज़णै तम्हैं लोहे तिछै बिंच़ू करै!” <verse eid="2CH 10:14" /><verse number="15" style="v" sid="2CH 10:15" />राज़ै रहबामै निं परज़े गल्‍ल मनी अर इहअ करै किई बिधाता सह गल्‍ल पूरी ज़ुंण शिलोह नगरीए आहिजा गूरै नबाते शोहरू जरोबामा का बोली ती।<verse eid="2CH 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 10:16" />ज़ांऊं सोभी इज़राईली का ज़ाण्हुंअ कि राज़अ निस्सअ तिन्‍नें एक बी गल्‍ल शूणीं, तिंयां लागै बोल्दै, “ईशैईए शोहरू दाबेद अर तेऊए खिंबा का हआ ज़ुदै! इनै हाम्हां लै आझ़ तैणीं किअ किज़ै? इज़राईलीओ, आपणैं-आपणैं घअरा लै च़ाल्‍ला! रहबाम करो ऐबै आपणैं लोगा प्रैंदै राज़!”</para>
  <para style="p" vid="2CH 10:16">इहअ करै किअ इज़राईली रहबामा लै द्रोह, <verse eid="2CH 10:16" /><verse number="17" style="v" sid="2CH 10:17" />रहबाम डाहअ तिन्‍नैं सिधअ तिन्‍नां मणछा प्रैंदै राज़अ ज़ुंण इज़राईली यहूदा मुल्खे नगरी तै बस्सै दै।<verse eid="2CH 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 10:18" />तेखअ छ़ाडअ राज़ै रहबामै हादोराम ज़ुंण सोभी बेठू प्रैंदै सैणअ आसा कि इज़राईली संघै गल्‍ला करे। पर तिन्‍नैं दैनअ तेऊ लै पात्थरो ढो संघा पाअ सह मारी। तेखअ ठुर्हअ रहबाम छ़ेक्‍कै-छ़ेक्‍कै आपणैं रथा प्रैंदै बेशी एरुशलेम नगरी लै। <verse eid="2CH 10:18" /><verse number="19" style="v" sid="2CH 10:19" />इहअ करै हुऐ उतरा बाखा बस्सै दै इज़राईली राज़ै दाबेदे खिंबा का द्रोह करी दूर अर तिंयां आसा आझ़ तैणीं बी<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="fq" closed="false">आझ़ तैणीं बी </char><char style="ft" closed="false">मतलब ऐहा कताबा लिखणे ज़मानै तैणीं</char></note> इहै ई।<verse eid="2CH 10:19" /></para>
  <chapter eid="2CH 10" />
  <chapter number="11" style="c" sid="2CH 11" />
  <para style="s">शमयाह गूरै खोज़अ बिधातो समाद</para>
  <para style="r">(<ref loc="1KI 12:21-24">1 राज़ै 12:21-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 11:1" />ज़ांऊं सुलैमानो शोहरू राज़अ रहबाम एरुशलेम पुजअ, तेऊ झाल़ै यहूदा अर बिन्यामीन गोत्रा का एक लाख अश्शी हज़ार सपाही ज़ुंण सोभी का राम्बल़ै जोधै थिऐ। तेऊओ मतलब थिअ इहअ कि उतरा बाखे इज़राईली संघै छ़ेल़णअ तेऊ जुध संघा करनै तिंयां सोभ इज़राईली आपणैं काबू। <verse eid="2CH 11:1" /><verse number="2" style="v" sid="2CH 11:2" />पर बिधाता बोलअ आपणैं गूर शमयाह का इहअ, <verse eid="2CH 11:2" /><verse number="3" style="v" sid="2CH 11:3" />“तूह दै सुलैमाने शोहरू राज़ै रहबाम अर यहूदा अर बिन्यामीन सोभी गोत्रे इज़राईली लै इहअ समाद, <verse eid="2CH 11:3" /><verse number="4" style="v" sid="2CH 11:4" />‘तम्हैं निं आपणैं ई सक्‍कै भाई-बंधा संघै जुधा करदै लागी। तम्हैं डेओआ सोभ आपणैं घअरा लै, सह आसा हुंह बिधाता आप्पै ज़ुंणीं इहअ दैनअ हणैं।’” रहबाम अर तेऊए सारी सैना शूणअ तिहअ ई ज़िहअ बिधाता बोलअ संघा डेऊऐ तिंयां आपणैं घअरा लै फिरी अर तिन्‍नैं निं तेखअ जरोबामा संघै जुध किअ।<verse eid="2CH 11:4" /></para>
  <para style="s">रहबामै ज़हा-ज़हा नगरी फेर गहल़ च़िणैं</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 11:5" />रहबाम लागअ एरुशलेम नगरी का राज़ करदअ। तेऊ च़िणैं यहूदा अर बिन्यामीन मुल्खे कई नगरी दी फेर-फिरदै गहल़। तिंयां नगरी ती ईंयां: <verse eid="2CH 11:5" /><verse number="6" style="v" sid="2CH 11:6" />बेतलेम, एताम, तकोआ, <verse eid="2CH 11:6" /><verse number="7" style="v" sid="2CH 11:7" />बेथ-सूर, सोको, अदुलाम, <verse eid="2CH 11:7" /><verse number="8" style="v" sid="2CH 11:8" />गात, मारेशा, जीप, <verse eid="2CH 11:8" /><verse number="9" style="v" sid="2CH 11:9" />अदोरीम, लकीश, अज़ेका, <verse eid="2CH 11:9" /><verse number="10" style="v" sid="2CH 11:10" />सोरा, अजालोन अर हेब्रोन नगरी। <verse eid="2CH 11:10" /><verse number="11" style="v" sid="2CH 11:11" />तिन्‍नां सोभी नगरी फेर-फिरदै गहल़ होर बी पाक्‍कै करी डाहै तिन्‍नां सोभी नगरी दी सैणैं अर सोभी नगरी दी ज़िणस, जैतूने तेल अर दाखे रसे भढार। <verse eid="2CH 11:11" /><verse number="12" style="v" sid="2CH 11:12" />ढाल़ा अर बर्छ़ै बी डाहै तिन्‍नां सोभी नगरी दी पुगतै। इहअ करै किऐ तेऊ यहूदा अर बिन्यामीन गोत्रे सारै मुल्खै सारी परज़ा आपणैं काबू।<verse eid="2CH 11:12" /></para>
  <para style="s">लेबी अर प्रोहत आऐ यहूदा लै</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 11:13" />उतरा बाखा इज़राईल सारै मुल्खा का आऐ प्रोहत अर लेबी दखणा बाखा यहूदा मुल्खा लै। <verse eid="2CH 11:13" /><verse number="14" style="v" sid="2CH 11:14" />तिन्‍नैं लेबी छ़ाडी इज़राईल मुल्खै आपणीं जदी ज़ैगा अर घैहणीं संघा पुजै यहूदा मुल्खै एरुशलेम, किल्हैकि इज़राईल मुल्खे राज़ै जरोबाम अर तेऊए शोहरू निस्सै तिन्‍नां बिधाता लै प्रोहतो काम करनै दैई। <verse eid="2CH 11:14" /><verse number="15" style="v" sid="2CH 11:15" />जरोबामै छ़ांटै आपणैं प्रोहत ज़ुंण इज़राईल सारै मुल्खै ज़ैगै-ज़ैगै धारा देहुरै दी बाकरे मुहुर्ती अर बाछ़ूए मुहुर्ती पूज़दै हआ तै। <verse eid="2CH 11:15" /><verse number="16" style="v" sid="2CH 11:16" />पर इज़राईले सोभी गोत्रा मांझ़ै तै कई लोग इहै ज़ुंण अज़ी बी दिला का आपणैं दादा-बाबा ज़ेही सिधी बिधाते पूज़ा-गाज़ा करनी च़ाहा तै, तिंयां बी आऐ लेबी पिछ़ू एरुशलेम नगरी लै ताकि तिंयां बिधाता लै बल़ीदान करी सके। <verse eid="2CH 11:16" /><verse number="17" style="v" sid="2CH 11:17" />तिंयां रहै चिई साला तैणीं यहूदा मुल्खै अर तिंयां थिऐ राज़ै रहबाम अर तेऊए राज़े पक्षा दी। तिन्‍नैं दैनअ तेऊओ तिहअ ई साथ ज़िहअ तिन्‍नैं राज़ै दाबेद अर तेऊए शोहरू सुलैमानो साथ दैनअ त।<verse eid="2CH 11:17" /></para>
  <para style="s">रहबामे आद-लुआद</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 11:18" />रहबामै किअ महलता संघै बैह। महलत ती दाबेदे शोहरू जरमोत अर अबिहेले शोहरी। अबिहेलो बाब थिअ ईशैईओ शोहरू एलीआब। <verse eid="2CH 11:18" /><verse number="19" style="v" sid="2CH 11:19" />महलता का थिऐ रहबामे चअन शोहरू जेऊश, शेमारीया अर जहाम हुऐ दै।<verse eid="2CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 11:20" />बादा का किअ तेऊ अबशलोमे शोहरी माकाहा संघै बैह। माकाहा का हुऐ रहबामे अबियाह, अताई, जीजा, अर शेलोमीत। <verse eid="2CH 11:20" /><verse number="21" style="v" sid="2CH 11:21" />रहबाम झ़ूरा त अबशलोमे शोहरी माकाहा लै आपणीं राणीं अर होरी डाही बेटल़ी का खास्सअ। तेऊए ती पठी ठारा राणीं अर होर डाही दी बेटल़ी थिई शाठ। तिन्‍नां का थिऐ तेऊए ठाई शोहरू अर शाठ शोहरी हुई दी।<verse eid="2CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 11:22" />रहबामै बणाअं माकाहा का हुअ द शोहरू अबियाह सोभी शोहरू प्रैंदै टिक्‍कअ कि सह हणअ तेऊ बाद राज़अ। <verse eid="2CH 11:22" /><verse number="23" style="v" sid="2CH 11:23" />रहबामा ती खास्सी अक्ल अर यहूदा अर बिन्यामीने मुल्खै दैनी तेऊ आपणैं सोभी शोहरू लै एकी-एकी नगरीए ज़िम्मैंबारी। तेऊ दैनअ तिन्‍नां लै ज़िहअ तिन्‍नां लोल़ी तिहअ अर बेटल़ी बी दैनी तिन्‍नां सोभी लै खास्सी आणी।<verse eid="2CH 11:23" /></para>
  <chapter eid="2CH 11" />
  <chapter number="12" style="c" sid="2CH 12" />
  <para style="s">मिसर देशै छ़ेल़अ यहूदा मुल्खा संघै जुध</para>
  <para style="r">(<ref loc="1KI 14:25">1 राज़ै 14:25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 12:1" />ज़िहअ ई रहबाम राज़अ बणअ, तेऊ अर तेऊए परज़ा इज़राईली छ़ाडअ बिधातो बधान मनणअ। <verse eid="2CH 12:1" /><verse number="2" style="v" sid="2CH 12:2" />रहबामे राज़ा दी पांज़ूई साला दैनी बिधाता तिन्‍नां लै सज़ा किल्हैकि तिन्‍नैं किअ विश्वास घात। बिधाता दैनअ इहअ हणैं कि मिसर देशो राज़अ शिशक आअ <verse eid="2CH 12:2" /><verse number="3" style="v" sid="2CH 12:3" />आपणैं बारा शौ रथ अर शाठ हज़ार घोल़े शुंआरा लई यहूदा मुल्खा संघै जुधा लै। होर तै लिबिया, कूश, सकोती संघी पैदल सपाही एतरै कि तिन्‍नां निं कुंण गणी सकदअ त। <verse eid="2CH 12:3" /><verse number="4" style="v" sid="2CH 12:4" />तेऊ किअ यहूदा मुल्खे कई गहल़ा आल़ी नगरी दी कबज़अ संघा पुजअ राज़धानी एरुशलेम।<verse eid="2CH 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 12:5" />बिधातो गूर शमयाह डेऊअ रहबाम राज़ै अर यहूदी सैणैं सेटा लै ज़ुंण एरुशलेम नगरी तै कठा हुऐ दै। तेऊ बोलअ तिन्‍नां लै इहअ, “तम्हां लै बोला बिधाता इहअ, ‘तम्हैं छ़ाडअ हुंह अर ऐबै डाहै मंऐं तम्हैं शोटी कि तम्हैं राज़ै शिशके बशै पल़े।’”<verse eid="2CH 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 12:6" />तेखअ पचताऐ राज़अ रहबाम अर इज़राईली सैणैं कि तिन्‍नें भलै हुअ पाप। तिन्‍नैं बोलअ तेखअ इहअ, “बिधाता किअ ठीक ई, हाम्हैं तै एता ई जोगी।”<verse eid="2CH 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 12:7" />इहअ शूणीं बोलअ बिधाता शमयाह गूरा का भिई इहअ, “यहूदा मुल्खे परज़ा पचताऐ दिला का कि तिन्‍नें भलै हुअ पाप, तै निं मुंह ऐबै राज़ै शिशका तिन्‍नां पठी बरैबाद करनै दैणअ। एरुशलेम नगरी जाणी ऐबै मेरै रोश्शा का धख बच़ी, <verse eid="2CH 12:7" /><verse number="8" style="v" sid="2CH 12:8" />पर तज़ी बी करनअ राज़ै शिशका तिन्‍नां प्रैंदै राज़, तेखअ लागणअ तिन्‍नां का थोघ कि मेरी च़ाकरी करनै अर संसारे होरी राज़े च़ाकरी करनै दी किज़ै फरक आसा।”<verse eid="2CH 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 12:9" />मिसर देशो राज़अ शिशक पुजअ राज़धानी एरुशलेम संघा लुटे राज़े मैहलै अर बिधाते भबने भढार। राज़ै सुलैमानै ज़ुंण सुन्‍नें ढाल़ा ती बणाईं दी, तिंयां निंईं तेऊ आप्पू संघा। <verse eid="2CH 12:9" /><verse number="10" style="v" sid="2CH 12:10" />तेते ज़ैगा बणाईं तेखअ राज़ै रहबामै तेही ई कांस्से ढाल़ा संघा डाही तिंयां पहरी अर भढारी का सभाल़ी ज़ुंण राज़ दरबारे प्रऊल़ी दी पहरी हआ तै। <verse eid="2CH 12:10" /><verse number="11" style="v" sid="2CH 12:11" />ज़ेभै बी राज़अ बिधाते भबना लै डेओआ त, तेभै-तेभै हांढा तै सपाही तिन्‍नां ढाल़ा च़की राज़ै संघै अर तेखअ डाहा तै तिन्‍नां भढारै डाही। <verse eid="2CH 12:11" /><verse number="12" style="v" sid="2CH 12:12" />ज़ांऊं राज़अ रहबाम बिधाता सेटा निंऊंअ फिरअ, तेखअ हुअ तेऊ का बिधातो कोप दूर अर इहअ करै बच़अ सह पठी बरैबाद हणैं का अर यहूदा मुल्खै बी आअ सधेर।<verse eid="2CH 12:12" /></para>
  <para style="s">रहबामो राज़ अर मौत</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 12:13" />राज़ै रहबामै किअ राज़धानी एरुशलेम नगरी का यहूदा मुल्खै राज़ अर सह हुअ खास्सअ बलबान। ज़धू सह राज़अ बणअ, तधू ती तेऊए अमर कताल़ी साले अर एरुशलेम नगरी ज़ुंण बिधाता इज़राईलीए सोभी गोत्रा मांझ़ै आप्पू लै थिई छ़ांटी दी, तिधा का किअ तेऊ सतारा साला तैणीं यहूदा मुल्खै राज़। रहबामे ईज थिई नामाह अर सह थिई अमोन नगरी का। <verse eid="2CH 12:13" /><verse number="14" style="v" sid="2CH 12:14" />रहबामै किअ तिहअ काम ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे। नां तेऊ इहअ समझ़णें कोशिश किई कि बिधाता किज़ै च़ाहा।<verse eid="2CH 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 12:15" />शुरू का खिरी तैणीं राज़ै रहबामै ज़िहै-ज़िहै काम किऐ, तिंयां आसा शमयाह गूर अर ईदू गूरे कताबा दी तेऊए खिंबा संघी लिखी डाहै दै। रहबाम अर इज़राईल मुल्खो राज़अ जरोबाम रहै सारी अमरा आप्पू मांझ़ै जुधा करदै लागी। <verse eid="2CH 12:15" /><verse number="16" style="v" sid="2CH 12:16" />खिरी मूंअ रहबाम संघा डाहअ सह दाबेदपूर नगरी तेऊए दादा-बाबा ज़िहअ दाबी अर तेऊओ शोहरू अबियाह बणअ आजू तेऊए ज़ैगा यहूदा मुल्खो राज़अ।<verse eid="2CH 12:16" /></para>
  <chapter eid="2CH 12" />
  <chapter number="13" style="c" sid="2CH 13" />
  <para style="s">यहूदा मुल्खै राज़ै अबियाहो राज़</para>
  <para style="r">(<ref loc="1KI 15:1-8">1 राज़ै 15:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 13:1" />उतरा बाखा इज़राईल मुल्खै थिअ नबातो शोहरू जरोबाम राज़अ, तेऊए राज़ा दी ठार्हुई साला बणअ यहूदा मुल्खै अबियाह राज़अ। <verse eid="2CH 13:1" /><verse number="2" style="v" sid="2CH 13:2" />तेऊ किअ चिई साला तैणीं एरुशलेम नगरी दी राज़। तेऊए ईज ती गिबा नगरी का ऊरीएले शोहरी मिकाया।</para>
  <para style="p" vid="2CH 13:2">खास्सअ बगत निं हुअ कि यहूदा मुल्खे राज़ै अबियाह अर इज़राईल मुल्खे राज़ै जरोबामा गअ आप्पू मांझ़ै जुध लागी। <verse eid="2CH 13:2" /><verse number="3" style="v" sid="2CH 13:3" />अबियाह का थिई च़ार लाख सैना अर दुजी बाखा ती जरोबामा का आठ लाख सैना।<verse eid="2CH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 13:4" />दुहै सैना हुई एप्रैम गोत्रे धारा बाखे मुल्खै आर-पार स्मोहरी। राज़अ अबियाह डेऊअ ज़मरीम धारा संघा बोलअ जरोबाम अर उतरा बाखे इज़राईली लै हाक्‍का पाई इहअ, “जरोबाम अर इज़राईलीओ, शूणां कि हुंह कै बोला! <verse eid="2CH 13:4" /><verse number="5" style="v" sid="2CH 13:5" />तम्हां का ऐहा गल्‍लो थोघ निं आथी कि इज़राईले परमेशर बिधाता आसा राज़ै दाबेदा संघै अटल़ करार किई दी कि तेऊए ई आद-लुआदा मांझ़ै हणअ सदा इज़राईली प्रैंदै राज़अ? <verse eid="2CH 13:5" /><verse number="6" style="v" sid="2CH 13:6" />नबाते शोहरू जरोबामै किअ आपणैं मालक दाबेदे शोहरू राज़ै सुलैमाना लै द्रोह। <verse eid="2CH 13:6" /><verse number="7" style="v" sid="2CH 13:7" />बादा का ज़ुल़ै तेऊ संघै उपद्रभी लोग रहबामा संघै मकाबलै करदै! सुलैमानो शोहरू रहबाम त अज़ी बेघै खारकअ अर कज़ाण अर सह निं तिन्‍नों मकाबलअ करी सकअ!<verse eid="2CH 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 13:8" />“ऐबै तम्हैं कै सोठा कि तम्हैं अर थारी एतरी खास्सी सैना बिधाते राज़ा संघै मकाबलअ करी सका ज़ुंण राज़ तेऊ दाबेदे आद-लुआदा लै आसा दैनअ द? तम्हां संघै आसा सिधी तिंयां सुन्‍नें बल्द अर बाछ़ूए मुहुर्ती ज़ुंण जरोबामै थारै कुल़ज देबतै डाहै बणाईं! <verse eid="2CH 13:8" /><verse number="9" style="v" sid="2CH 13:9" />तम्हां बाखा निं हारणे आद-लुआद बी आथी! किल्हैकि तम्हैं काढै तिंयां बिधाते प्रोहत अर लेबी आप्पू जैंदरा का ज़ोरा-ज़ोरी दरल़ाऊई। तिन्‍नें ज़ैगा डाहै तम्हैं होरी देशा ज़िहै पज़ैरै। बेदी सेटा ज़ुंण बाछ़ू अर सात गाभू आणी बल़ीदान करा, सह जाआ थारै तिन्‍नां देअओ प्रोहत बणी!<verse eid="2CH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 13:10" />“पर हाम्हैं करा अज़ी बी बिधाते च़ाकरी अर हाम्हैं निं तेऊ का दूर डेऊऐ। म्हारै करा आझ़ बी हारणे आद-लुआदा मांझ़ै ई प्रोहतो काम अर होर लेबी बी करा तिन्‍नां संघै च़ाकरी। <verse eid="2CH 13:10" /><verse number="11" style="v" sid="2CH 13:11" />हर धैल़ै दोत्ती अर उडै ज़ाल़ा तिंयां बिधाता सेटा धूप अर धैल़ करा तिंयां बल़ीदान करी हूम। तिंयां छ़ाडा बिधाता लै पबित्र मेज़ा प्रैंदै भोज़न, हर धैल़ै ज़ाल़ा तिंयां सुन्‍नें सदीऐ दी दीऐ। हाम्हैं करा आझ़ बी तिहअ ई ज़िहअ बिधाता हुकम करा अर तम्हैं आसा बिधाता का दूर हुऐ दै। <verse eid="2CH 13:11" /><verse number="12" style="v" sid="2CH 13:12" />हाम्हां प्रैंदै सैणअ आसा आझ़ बी बिधाता ई अर तेऊए प्रोहत आसा इधी नर्शिंगै बाज़णा लै तैर कि हाम्हैं तम्हां संघै जुध छ़ेल़े। इज़राईलीओ, आपणैं दादा-बाबे तेऊ परमेशर बिधाता संघै मकाबलै करदै निं लागा! तेऊ का निं तम्हैं ज़िती सकदै!”<verse eid="2CH 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 13:13" />अबियाह त इना गल्‍ला बोल्दअ लागअ द अर पोरी हेरअ जरोबामै एक दल यहूदे सैना मारदअ छ़ाडी कि तिंयां पिछ़ू बाखा घेरअ बाही तिन्‍नां लै चुटी पल़े अर बाकी सैना डाही मोहरै बाखा मकाबलै लै। <verse eid="2CH 13:13" /><verse number="14" style="v" sid="2CH 13:14" />यहूदी सैना हेरअ भाल़ी कि तिंयां गोटै पिछ़ू बाखा। तिंयां लागै ज़ोरै-ज़ोरै लैल़ा लाई बिधाता का मज़त मांगदै अर प्रोहतै बाज़ै जुध शुरू करना लै नर्शिंगै। <verse eid="2CH 13:14" /><verse number="15" style="v" sid="2CH 13:15" />यहूदी सैना पाअ सोभी एकी शाहै ज़ोरै हाल्‍लअ संघा निंयैं अबियाह तिंयां इज़राईली संघै मकाबलै करदै। बिधाता दैनअ तिन्‍नां लै इहअ बल कि इज़राईली सैना अर जरोबाम हारै तिन्‍नां का पठी। <verse eid="2CH 13:15" /><verse number="16" style="v" sid="2CH 13:16" />इज़राईली ठुर्है यहूदी डरै बापस अर यहूदी सैना लैऊई तिन्‍नां लै काट-फणाटी। <verse eid="2CH 13:16" /><verse number="17" style="v" sid="2CH 13:17" />अबियाह अर तेऊए सैना का हारै इज़राईली इहै कि तिन्‍नें हुई बूरी दशा। तिन्‍नें सैना मांझ़ै पाऐ तिन्‍नैं कोई पांज़ लाख मारी, कि कोई डाहै खास्सै ज़खमी करी। <verse eid="2CH 13:17" /><verse number="18" style="v" sid="2CH 13:18" />इहअ करै ज़ितै इज़राईली का यहूदी किल्हैकि तिंयां रहै तेऊ परमेशर बिधाते आसरै ज़हा तिन्‍नें दाद-बाब मना तै।<verse eid="2CH 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 13:19" />अबियाह किअ जरोबामे सैनो पिछ़अ संघा किअ तिन्‍नें कई नगरी दी कबज़अ। तिंयां नगरी ती बेतेल, जेशाना, एप्रोन अर तिन्‍नां सोभी नगरी फेर-फिरदै गराअं। <verse eid="2CH 13:19" /><verse number="20" style="v" sid="2CH 13:20" />तेखअ निं जरोबाम अबियाहे राज़ा दी भिई तेऊ संघै मकाबलै करदअ आअ। खिरी दैनी बिधाता तेऊ लै एही सज़ा कि तेऊए हुई मौत। पर यहूदा मुल्खो राज़अ अबियाह हुअ होर बी बलबान।<verse eid="2CH 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 13:21" />अबियाह ती पठी च़ौदा बेटल़ी आणी दी, तिन्‍नां का थिऐ तेऊए बाई शोहरू अर सोल़ा शोहरी हुई दी। <verse eid="2CH 13:21" /><verse number="22" style="v" sid="2CH 13:22" />अबियाह राज़ै बाकी होर किज़ै बोलअ अर होर किज़ै-किज़ै किअ, तिंयां आसा पठी गल्‍ला ईदू गूरै लिखै दै इतिहासा दी लिखी डाही दी।<verse eid="2CH 13:22" /></para>
  <chapter eid="2CH 13" />
  <chapter number="14" style="c" sid="2CH 14" />
  <para style="s">यहूदा राज़ै आसाहो राज़</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 14:1" />खिरी मूंअ राज़अ अबियाह संघा डाहअ सह दाबेदपूर नगरी दाबी। तेखअ बणअ तेऊओ शोहरू आसाह यहूदा मुल्खो राज़अ। तेऊए राज़ा दी रही दसा साला तैणीं यहूदा मुल्खै शांती। <verse eid="2CH 14:1" /><verse number="2" style="v" sid="2CH 14:2" />आसाह किअ तिहअ ई भलअ ज़िहअ बिधाता च़ाहा त कि सह करे। <verse eid="2CH 14:2" /><verse number="3" style="v" sid="2CH 14:3" />पराऐ देअए मुहुर्ती, गान-स्तान अर तिन्‍नें बेदी किई तेऊ खतम। तिन्‍नें पूज़णे ओडै अर अशेरा देबीए डौंड पाऐ तेऊ ढोल़ी अर फाल़ी। <verse eid="2CH 14:3" /><verse number="4" style="v" sid="2CH 14:4" />तेऊ किअ यहूदा मुल्खे परज़ा लै हुकम कि सिधी बिधाते पूज़ा-गाज़ा करा ज़िहअ तिन्‍नें दादै-बाबै किअ अर बधाने साबै ज़िऊआ ज़िहअ बिधाता च़ाहा। <verse eid="2CH 14:4" /><verse number="5" style="v" sid="2CH 14:5" />ज़ेतरै बी यहूदा मुल्खै मुहुर्ती पूज़णे गान-स्तान अर धूपा दैणें बेदी थिई, तिंयां किई तेऊ खतम। इहअ करै रहअ आसाहे राज़ा दी यहूदा मुल्खै सोभी नगरी सुख-चैन। <verse eid="2CH 14:5" /><verse number="6" style="v" sid="2CH 14:6" />राज़ै आसाहै बणाऐं आपणैं राज़ा दी यहूदा मुल्खै कई नगरी फेर फिरदै गहल़। इहअ करै निं कई साला तैणीं यहूदा मुल्खा संघै कोही जुध छ़ेल़अ किल्हैकि बिधाता ती यहूदा मुल्खै शांती डाही दी। <verse eid="2CH 14:6" /><verse number="7" style="v" sid="2CH 14:7" />राज़ै आसाहै बोलअ यहूदा मुल्खे परज़ा लै, “हाम्हां च़िणनै यहूदा मुल्खै सोभी नगरी फेर गहल़, बडी-बडी दुआली, बडै-बडै कोट। बडी-बडी लाणीं प्रऊल़ी ज़ेथ बडी-बडी आगल़ी होए। अह ज़ैगा आसा आझ़ बी म्हारी किल्हैकि हाम्हैं किअ तिहअ ई ज़िहअ म्हारअ परमेशर बिधाता च़ाहा। बिधाता आसा हाम्हैं फेरा-फेर सोभी दुशमणा का राज्ज़ी-राम्बल़ै बच़ाऊई डाहै दै।”</para>
  <para style="p" vid="2CH 14:7">ज़िहअ राज़ै आसाह हुकम किअ, सारी परज़ा किअ तिहअ ई। <verse eid="2CH 14:7" /><verse number="8" style="v" sid="2CH 14:8" />यहूदा का थिई राज़ै आसाह सेटा बर्छ़ै अर ढाल़ा च़लाऊंणैं आल़ी सज़ाण चअन लाख शूरबीरे सैना। बिन्यामीन गोत्रा मांझ़ै थिई तेऊ का ढाल़ अर कतीर-कबाणे सज़ाण दूई लाख अश्शी हज़ार सैना।<verse eid="2CH 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 14:9" />कूश<note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="fq" closed="false">कूश </char><char style="ft" closed="false">इथोपिया</char></note> देशे जेराह छ़ेल़अ यहूदा मुल्खा संघै जुध। तेऊ आणी आप्पू संघै दस लाख सैना अर चअन शौ रथ संघा पुजअ मारेशा नगरी तैणीं। <verse eid="2CH 14:9" /><verse number="10" style="v" sid="2CH 14:10" />राज़अ आसाह निखल़अ तेऊए मकाबलै करदअ संघा खल़्हुई मारेशा नगरी नेल़ सापता नाओंए खागै दुहै सैना आर-पार स्मोहरी। <verse eid="2CH 14:10" /><verse number="11" style="v" sid="2CH 14:11" />आसाह किई बिधाता सेटा अरज़, “हे बिधाता, तूह करा थोल़ै बला आल़ी सैने मज़त बी तेही ई ज़ेही तूह बलबान सैने मज़त करा। ए म्हारै परमेशर बिधाता, ऐबै कर म्हारी मज़त तूह ई, किल्हैकि हाम्हैं आसा तेरै ई आसरै। हाम्हैं आसा तेरै नाओंऐं दुशमणे एतरी बडी सैने मकाबलै करदै आऐ दै। हे बिधाता, तूह आसा म्हारअ परमेशर, ताखा निं कोहै मणछ ज़िती सकदअ।”<verse eid="2CH 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 14:12" />तेखअ पल़ी यहूदी सैना तिन्‍नां लै चुटी अर बिधाता ज़ताऊऐ तिंयां कूश देशे सैना का अर कूश देशे सैना ठुर्है तिधा का च़ऊ पाओऐ। <verse eid="2CH 14:12" /><verse number="13" style="v" sid="2CH 14:13" />राज़अ आसाह अर तेऊए सैना डेऊई तिन्‍नां पिछ़ू गरार नगरी तैणीं। तेथ मारी एतरी कूशी सैना कि तधा बाद निं तिंयां खल़ै उझ़दै डाहै किल्हैकि तिंयां हारै बिधाता अर तेऊए सैना का अर यहूदी सैना लुटी तिन्‍नें सारी च़िज़ा। <verse eid="2CH 14:13" /><verse number="14" style="v" sid="2CH 14:14" />गरार नगरी ओरी-पोरी ज़ेतरी नगरी थिई, तिंयां किई यहूदी सैना पठी बरैबाद, तेथ बस्सै दै लोगे दिलै पल़ी तेखअ बिधाते डअर। तिन्‍नां नगरी ती खास्सी धन-माया, सह लुटी यहूदी सैना पठी। <verse eid="2CH 14:14" /><verse number="15" style="v" sid="2CH 14:15" />तिन्‍नें कई फुआले डेरै लै बी पल़ै यहूदी चुटी संघा लुटी तिन्‍नें खास्सै डागै, भेडा-बाकरीए हेल़्ही अर ऊँट अर खिरी पुजै राज़धानी एरुशलेम बापस फिरी।<verse eid="2CH 14:15" /></para>
  <chapter eid="2CH 14" />
  <chapter number="15" style="c" sid="2CH 15" />
  <para style="s">राज़ै आसाहे खास काम</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 15:1" />थोल़ै धैल़ै बाद किई बिधाता ओदेदे शोहरू अजर्याह संघै गल्‍ला। <verse eid="2CH 15:1" /><verse number="2" style="v" sid="2CH 15:2" />अजर्याह डेऊअ तेभी आसाह राज़ै सेटा संघा खोज़अ इहअ, “आसाह राज़ैआ, यहूदा अर बिन्यामीन गोत्रे सोभी लोगो, मेरी गल्‍ला दी दैआ धैन! बिधाता रहणअ तेभै तैणीं तम्हां संघै अर तेऊ रहणअ तेभै तैणीं थारी मज़त करदै लागी ज़ेभै तैणीं तम्हैं तेऊ संघै अर ज़िहअ सह हुकम करा तिहअ करदै रहे। ज़ै तम्हैं तेऊ छ़ाडी दूर होए, तै डाहणैं तेऊ बी तम्हैं शोटी। <verse eid="2CH 15:2" /><verse number="3" style="v" sid="2CH 15:3" />एकी ज़मानै रहै इज़राईली खास्सी साला तैणीं, असली परमेशरा बाझ़ी, नां तिन्‍नां लै शिक्षा दैणैं आल़अ प्रोहत थिअ अर नां तिंयां बिधाते बधाना मंदै तै। <verse eid="2CH 15:3" /><verse number="4" style="v" sid="2CH 15:4" />पर ज़ांऊं आफ़त पल़ी तेखअ फिरै तिंयां इज़राईले परमेशर बिधाता बाखा अर तेखअ पल़ी तिन्‍नां बिधाते छोद। <verse eid="2CH 15:4" /><verse number="5" style="v" sid="2CH 15:5" />तिन्‍नां धैल़ै निं इज़राईला मांझ़ै कोहै राज्ज़ी आथी त किल्हैकि सारै देशै ती आफ़त अर सोभी जैंदरी त झाख पल़अ द। <verse eid="2CH 15:5" /><verse number="6" style="v" sid="2CH 15:6" />देश-देश तै एकी-दुजै बरैबाद करदै पल़ै दै। हर ज़ैगा तै एकी नगरीए लोग दुजी नगरी हारदै-मारदै लागै दै। सह हुअ इहअ करै कि बिधाता दैनअ तिन्‍नां प्रैंदै आफ़त पल़णै। <verse eid="2CH 15:6" /><verse number="7" style="v" sid="2CH 15:7" />पर तम्हैं डाहा हिम्मत अर हैअ निं चोल़ी। बिधाते साबै ज़िन्दगी ज़िऊंणेंओ भलअ फल जाणअ तम्हां भेटी।”<verse eid="2CH 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 15:8" />बिधाता ज़ुंण गल्‍ला ओदेदे शोहरू अजर्याह गूरा का प्रगट किई ती, तेता शूणीं आई राज़ै आसाह होर बी हिम्मत। तेऊ किई यहूदा, बिन्यामीन अर एप्रैम धारा बाखे मुल्खै तिन्‍नां सोभी नगरी का मुहुर्ती पूज़ा ज़ेही च़िल़्हखरी च़िज़ा दूर। बिधाते बेदीए बी किई तेऊ भिई मराम्मत ज़ुंण बिधाते भबने खोल़ै थिई।<verse eid="2CH 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 15:9" />एप्रैम, मनिश्शे अर शमौन गोत्र ज़ुंण यहूदा तै बस्सै दै, तिंयां बी हुऐ राज़ै आसाहे पक्षा लै। किल्हैकि तिन्‍नां का शुझुअ कि राज़ै आसाह संघै आसा बिधाता। आसाह किऐ यहूदा अर बिन्यामीन गोत्रा संघै तिंयां सोभै इज़राईली बी कठा। <verse eid="2CH 15:9" /><verse number="10" style="v" sid="2CH 15:10" />तिंयां हुऐ राज़ै आसाहे राज़ा दी पंद्रुई साला ज़ेठै राज़धानी एरुशलेम कठा। <verse eid="2CH 15:10" /><verse number="11" style="v" sid="2CH 15:11" />तैहा धैल़ी किअ तिन्‍नैं बिधाता लै तेता मांझ़ै सात शौ बल्द अर सात हज़ार भेडा-बाकरी बल़ीदान ज़ुंण डागै-चैणें हेल़्ही तिन्‍नैं लुटी ती आणी दी। <verse eid="2CH 15:11" /><verse number="12" style="v" sid="2CH 15:12" />तिन्‍नैं खाऐ सोभी सोह संघा किई एही करार कि हाम्हां करनी तत्त-दिला का आपणैं दादा-बाबे परमेशर बिधाते पूज़ा-गाज़ा। <verse eid="2CH 15:12" /><verse number="13" style="v" sid="2CH 15:13" />ज़ुंण बी तिन्‍नां मांझ़ै होछ़अ-प्रोढअ, मर्ध-बेटल़ी, इज़राईले परमेशर बिधाता नांईं मने, सह पाणअ हाम्हां मारी। <verse eid="2CH 15:13" /><verse number="14" style="v" sid="2CH 15:14" />तिधी आऐ दै सोभै लोग हुऐ तेता लै राज्ज़ी कि ज़िहै हाम्हैं सोह खाऐ, हाम्हां करनअ तिहअ ई। तेखअ किई तिन्‍नैं ज़ोरै-ज़ोरै बिधाते ज़ै-ज़ैकार संघा लागै नर्शिंगै बाज़दै। <verse eid="2CH 15:14" /><verse number="15" style="v" sid="2CH 15:15" />यहूदा मुल्खे सारी परज़ा ती खुश किल्हैकि तिन्‍नैं किई तधू तत्त-दिला का बिधाता संघै करार। बिधाता बी दैनी तेते बदल़ै तिन्‍नां लै बर्गत कि तिन्‍नां भेटअ तिन्‍नें सोभी दुशमणा का राम।<verse eid="2CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 15:16" />राज़ै आसाह काढी आपणीं दादी माकाहा राज़ माए पदबी का पोर्ही किल्हैकि तैहा ती सह अशेरा देबीए च़िल़्हखरी मुहुर्ती बणाईं दी। राज़ै आसाह फाल़ी सह मुहुर्ती संघा पिशी भींन, संघा डाही किद्रोन नाल़ै दहई। <verse eid="2CH 15:16" /><verse number="17" style="v" sid="2CH 15:17" />तज़ी बी निं राज़अ आसाह यहूदा मुल्खा का इज़राईली मांझ़ै सोभी मुहुर्ती पूज़ा करने गान-स्ताना खतम करी सकअ। पर आप्पू रहअ सह आपणीं ज़िऊंदी ज़िता बिधाता लै शुचअ-पाक्‍कअ। <verse eid="2CH 15:17" /><verse number="18" style="v" sid="2CH 15:18" />ज़ुंण सुन्‍नअ-च़ंदी अर भांडै तेऊए बाब राज़ै अबियाह बिधाता लै थिऐ अर्पण किऐ दै, तिंयां डाहै तेऊ बिधाते भबनै। ज़ुंण च़िज़ा तेऊ आपणीं बाखा दैनी, तिंयां बी डाही बिधाते भबनै। <verse eid="2CH 15:18" /><verse number="19" style="v" sid="2CH 15:19" />राज़ै आसाहे राज़ा दी निं पैंईंती साला तैणीं कोही संघै जुध हुअ।<verse eid="2CH 15:19" /></para>
  <chapter eid="2CH 15" />
  <chapter number="16" style="c" sid="2CH 16" />
  <para style="s">उतरा बाखे इज़राईली लै आफ़त</para>
  <para style="r">(<ref loc="1KI 15:17-22">1 राज़ै 15:17-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 16:1" />यहूदा मुल्खै थिअ राज़ै आसाहो राज़, तेऊए राज़ा दी छत्तुई साला छ़ेल़अ इज़राईल मुल्खे राज़ै बाशा यहूदा संघै जुध। राज़ै बाशा बणाअं रामाह नगरी फेर-फिरदअ गहल़ अर बागै डाही आपणीं सैना अर तेऊ किअ यहूदा लै लोगो एछणअ डेऊणअ बंद। <verse eid="2CH 16:1" /><verse number="2" style="v" sid="2CH 16:2" />राज़ै आसाह किअ इहअ कि बिधाते भबनै अर तेऊए मैहलै ज़ुंण सुन्‍नैं-च़ंदीए भांडै थिऐ रहै दै, तिंयां काढै तेऊ सोभ संघा दैनै आपणैं कार-करिंदे हाथै दमिश्क नगरी अराम देशे राज़ै बेन्हदादा सेटा, संघा दैनअ तेऊ लै इहअ समाद, <verse eid="2CH 16:2" /><verse number="3" style="v" sid="2CH 16:3" />“ज़िहअ म्हारै बाबो आप्पू मांझ़ै ज़ोल़-मेल़ थिअ, हाम्हां बी करनअ आजू तिहअ ई। ईंयां सुन्‍नैं-च़ंदीए भांडै दैनै मंऐं ताल्है भैंट। ऐबै एछ तूह मुंह संघै अर इज़राईले राज़ै बाशा संघै कर आपणीं करार खतम ताकि सह मेरी देशे ज़ैगा का आपणीं सैना संघी पोर्ही निखल़े।”<verse eid="2CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 16:4" />राज़ै बेन्हदादै किअ तिहअ ई ज़िहअ राज़ै आसाहै बोलअ अर तेऊ छ़ाडै आपणीं सैने दलपति संघा छ़ेल़अ कई इज़राईली नगरी दी जुध। तिन्‍नैं किअ इजोन, दान, अबेल-बेथ-माकाहा नगरी गलील समुंदरे मुल्खै कबज़अ अर नप्ताली गोत्रे सारी नगरी ज़ेथ तिन्‍नैं ज़िणसा करै भढार थिऐ भरी डाहै दै। <verse eid="2CH 16:4" /><verse number="5" style="v" sid="2CH 16:5" />ज़ांऊं राज़ै बाशा शूणअ कि इहअ हुअ, तेऊ पाई रामाह नगरी गहल़ा बणाणें छ़ाड संघा किअ सह काम तिधी बंद। <verse eid="2CH 16:5" /><verse number="6" style="v" sid="2CH 16:6" />तेखअ किअ आसाह राज़ै सारै यहूदा मुल्खै सोभी लै हुकम कि ज़ुंण बाशा राज़ै रामाह नगरी गहल़ा बणाणां लै काठ पात्थर तै लाऐ दै, तिन्‍नां च़का। संघा लाऐ तिंयां काठ पात्थर बिन्यामीन गोत्रे मुल्खै गिबा अर मिज़पा नगरी गहल़ा बणाणां लै।<verse eid="2CH 16:6" /></para>
  <para style="s">बिधातो गूर हनानी</para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 16:7" />इना एतरी गल्‍ला हणैं बाद डेऊअ बिधातो गूर हनानी यहूदा मुल्खे राज़ै आसाह सेटा संघा बोलअ इहअ, “तंऐं समझ़अ आपणैं परमेशर बिधाता छ़ाडी अराम देशे राज़ै बेन्हदादो आसरअ खास्सअ! ताखा त अराम देशे सैना मारनैओ मोक्‍कअ पर ऐबै निं तूह तिन्‍नां का कधि ज़िती सकदअ।” <verse eid="2CH 16:7" /><verse number="8" style="v" sid="2CH 16:8" />तेता कर आद कि कूश देशे सैना अर लिबिया देशे सैना केही खास्सी अर बलबान आसा ती? तेता लै रहअ तूह बिधाते आसरै संघा ज़ितअ तूह तिन्‍नां का! <verse eid="2CH 16:8" /><verse number="9" style="v" sid="2CH 16:9" />बिधाता हआ संसारै सोभी भाल़अ लागअ द, सह दैआ तिन्‍नां लै बल ज़ुंण तेऊ लै शुचै-पाक्‍कै हआ। तंऐं किअ ऐडै ज़िहअ काम अर तैही रहणैं ऐबै ताह संघै कबल्‍लै जुध लागी। <verse eid="2CH 16:9" /><verse number="10" style="v" sid="2CH 16:10" />ऐहा गल्‍ला लै आई राज़ै आसाहा तेऊ गूरा लै खास्सी रोश्शै अर तेऊ बझ़ैल़अ सह शांघल़ी करै बान्हणैं। तिन्‍नां ई धैल़ै थिअ आसाह राज़ परज़ा मांझ़ै होरी कई लोगा लै बी इहअ ई ज़ुल्म करदअ लागअ द।<verse eid="2CH 16:10" /></para>
  <para style="s">राज़ै आसाहो राज़ मुक्‍कअ</para>
  <para style="r">(<ref loc="1KI 15:23">1 राज़ै 15:23</ref>,<ref loc="1KI 15:24">24</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 16:11" />आसाह राज़ै आपणैं राज़ा दी ज़ेतरै बी काम किऐ, तिंयां आसा यहूदा अर इज़राईल मुल्खे इतिहासे कताबा दी लिखी डाही दी। <verse eid="2CH 16:11" /><verse number="12" style="v" sid="2CH 16:12" />आपणैं राज़ा दी उन्ताल़ुई साला लागी आसाह राज़ै खूरै बमारी संघा हुअ लाट्टअ। तेता लै बी रहअ सह बिधाता छ़ाडी बैईदे आसरै। <verse eid="2CH 16:12" /><verse number="13" style="v" sid="2CH 16:13" />तेखअ हुई तेऊए दूई साला बाद मौत <verse eid="2CH 16:13" /><verse number="14" style="v" sid="2CH 16:14" />संघा डाहअ सह दाबेदपूर नगरी तैहा घोरी दी दाबी ज़ुंण तेऊ आप्पू लै आप्पै ती कोती डाही दी। तैहा घोरी दी पाऐ खास्सै खुशबूदार मसालै अर शोभली बास्सा दैणैं आल़ै तेल। तेऊओ अदर करना लै ज़ाल़अ लोगै तिधी बडअ आगीओ कूंड।<verse eid="2CH 16:14" /></para>
  <chapter eid="2CH 16" />
  <chapter number="17" style="c" sid="2CH 17" />
  <para style="s">यहूदा मुल्खै बणअ जहोशापात राज़अ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 17:1" />राज़ै आसाह मरनै का बाद बणअ आजू तेऊओ शोहरू जहोशापात यहूदा मुल्खो राज़अ। तेऊ बढेरी इज़राईलीए मकाबलै लै आपणीं सैना खास्सी। <verse eid="2CH 17:1" /><verse number="2" style="v" sid="2CH 17:2" />यहूदा मुल्खे सोभी गहल़ा आल़ी नगरी अर एप्रैम मुल्खै ज़हा-ज़हा नगरी तेऊए बाब आसाह कबज़अ किअ थिअ, तिन्‍नां सोभी नगरी डाही तेऊ आपणीं सैना मांझ़ै ज़ुदी-ज़ुदी पल़टणा। <verse eid="2CH 17:2" /><verse number="3" style="v" sid="2CH 17:3" />बिधाता दैनी जहोशापाता लै बर्गत किल्हैकि सह रहअ आपणैं दाद-बाब राज़ै दाबेदा ज़िहअ बिधाता लै शुचअ-पाक्‍कअ अर सह निं बाल देअआ पूज़दअ डेऊअ। <verse eid="2CH 17:3" /><verse number="4" style="v" sid="2CH 17:4" />तेऊ किई आपणैं दादा-बाबे परमेशरे च़ाकरी अर तेऊ किअ ज़िहअ बिधाता बोलअ तिहअ ई अर तेऊ निं इज़राईल मुल्खे होरी राज़ै ज़िहै च़िल़्हखरै काम किऐ। <verse eid="2CH 17:4" /><verse number="5" style="v" sid="2CH 17:5" />बिधाता किअ यहूदा मुल्ख जहोशापाते बशै। सोभ लोग करा तै तेऊ सेटा भैंट आणी। इहअ करै हुअ सह खास्सअ सेठ अर सोभ करा तै तेऊओ अदर। <verse eid="2CH 17:5" /><verse number="6" style="v" sid="2CH 17:6" />सह रहअ बिधाता लै पठी शुचअ-पाक्‍कअ। उझै धारा मुहुर्ती पूज़ा करने गान-स्तान किऐ तेऊ आपणैं देशा का खतम अर तिंयां ज़ैगा बी किई तेऊ यहूदा मुल्खा का खतम ज़ेथ अशेरा देबीए पूज़ा करा तै।<verse eid="2CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 17:7" />जहोशापातै छ़ाडै आपणैं राज़ा दी चिऊथी साला आपणैं कार-करिंदै मांझ़ै पांज़ ज़ण्हैं यहूदा मुल्खे हर नगरी बिधाते बधाना सखाऊंदै। तिंयां पांज़ ज़ण्हैं तै बेनहेल, ओबेदियो, जकर्या, नतनेल अर मिका। <verse eid="2CH 17:7" /><verse number="8" style="v" sid="2CH 17:8" />तिन्‍नां संघै छ़ाडै लेबी मांझ़ा का नौ ज़ण्हैं अर प्रोहता मांझ़ा का दूई ज़ण्हैं। लेबी थिऐ शमयाह, नतानिया, जबदीया, असाहेल, शेमीरामोत, जोनातान, अदोनियाह, तोबियाह अर तोबियाह। तिन्‍नां संघै दूई प्रोहत थिऐ एलीशामा अर जेहोराम। <verse eid="2CH 17:8" /><verse number="9" style="v" sid="2CH 17:9" />तिन्‍नैं निंईं बिधाते बधाने कताब आप्पू संघै, तेखअ डेऊऐ यहूदा मुल्खै सोभी नगरी लोगा लै शिक्षा दैंदै।<verse eid="2CH 17:9" /></para>
  <para style="s">जहोशापातो बल</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 17:10" />बिधाता दैनअ जहोशापाता लै इहअ बल कि यहूदा मुल्खै ओरी-पोरीए देशा पल़ी यहूदीए एही डअर कि तिन्‍नें निं जहोशापाता संघै जुध छ़ेल़णै हिम्मत ई पल़दी ती। <verse eid="2CH 17:10" /><verse number="11" style="v" sid="2CH 17:11" />पलिश्ती मांझ़ै दैनी कई जहोशापाता लै च़ंदी अर कई च़िज़ा भैंट अर अरब देशा का बी दैनी कई लोगै सात हज़ार सात शौ गाभू अर सात हज़ार सात शौ बाकरे हेल़्ही भैंट। <verse eid="2CH 17:11" /><verse number="12" style="v" sid="2CH 17:12" />राज़अ जहोशापात रहअ बढदअ अर बलबान हंदअ लागी। सह रहअ सारै यहूदा मुल्खै नगरी फेर गहल़ा-कोटा च़िणदअ लागी <verse eid="2CH 17:12" /><verse number="13" style="v" sid="2CH 17:13" />अर तेथ डाहै तेऊ भढार भरी।</para>
  <para style="p" vid="2CH 17:13">एरुशलेम नगरी हआ तै तेऊ सज़ाण शूरबीर अर जोधै डाहै दै। <verse eid="2CH 17:13" /><verse number="14" style="v" sid="2CH 17:14" />तिन्‍नां शूरबीरे दल तै यहूदा अर बिन्यामीन गोत्रा का तिन्‍नें टोलीए साबै ईंयां:</para>
  <para style="p" vid="2CH 17:14">यहूदे दलो दलपति त अदना अर तेऊ का थिई चअन लाख सैना। <verse eid="2CH 17:14" /><verse number="15" style="v" sid="2CH 17:15" />दुजअ दलपति थिअ जहोहनान, तेऊ का थिई दूई लाख अश्शी हज़ार सैना सभाल़ी दी।<verse eid="2CH 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 17:16" />चिऊथअ दलपति थिअ ज़िक्रीओ शोहरू अमास्या अर तेऊ का थिई दूई लाख सैना। अमास्या त बिधाते च़ाकरी करना लै आप्पू अर्पण हुअ द। <verse eid="2CH 17:16" /><verse number="17" style="v" sid="2CH 17:17" />बिन्यामीन गोत्रे एकी टोली का थिअ एल्यादा, सह थिअ खास्सअ शूरबीर जोधअ। तेऊ का थिऐ दूई लाख ढाल़ अर कबाणा आल़ी सज़ाण सैना। <verse eid="2CH 17:17" /><verse number="18" style="v" sid="2CH 17:18" />तेऊ संघै दुजअ दलपति थिअ जोजबाद, तेऊ का थिई एक लाख अश्शी हज़ार सपाहीए सैना ज़ुंण जुध बिद्ये ज़ाण-प्रबीण थिऐ। <verse eid="2CH 17:18" /><verse number="19" style="v" sid="2CH 17:19" />ईंयां सपाही करा तै राज़धानी एरुशलेम राज़ै सेटा च़ाकरी। ईंयां थिऐ तेता का लाऊआ ज़ुंण राज़ै जहोशापातै यहूदा मुल्खै होरी गहल़ा आल़ी नगरी तै डाहै दै।<verse eid="2CH 17:19" /></para>
  <chapter eid="2CH 17" />
  <chapter number="18" style="c" sid="2CH 18" />
  <para style="s">बिधाते गूर मिका दैनी अहाब राज़ै लै चतैनगी</para>
  <para style="r">(<ref loc="1KI 22:1-28">1 राज़ै 22:1-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 18:1" />यहूदा मुल्खो राज़अ जहोशापात हुअ खास्सअ सेठ अर मशूर। तेऊ किअ आपणैं शोहरू जेहोरामो बैह इज़राईले राज़ै अहाबे शोहरी संघै करी मेल़-ज़ोल़। <verse eid="2CH 18:1" /><verse number="2" style="v" sid="2CH 18:2" />थोल़ी साला बाद डेऊअ जहोशापात इज़राईल मुल्खे राज़धानी सामरी नगरी अहाब राज़ै सेटा मिलदअ। अहाब राज़ै दैनी जहोशापात अर तेऊए कार-करिंदै लै रिठ-बाकरे हेल़्ही काटी धाम। अहाब राज़अ च़ाहा त इहअ कि जहोशापात तेऊ संघै ज़ुल़ी गलाद मुल्खे रामोत नगरी संघै जुधा लै एछे। <verse eid="2CH 18:2" /><verse number="3" style="v" sid="2CH 18:3" />इज़राईले राज़ै अहाबै पुछ़अ यहूदे राज़ै जहोशापाता का, “गलाद मुल्खै रामोत नगरी ताह मेरी साथा अरामी संघै जुधा लै एछणअ ऐ?”</para>
  <para style="p" vid="2CH 18:3">जहोशापातै बोलअ, “हो, हाम्हैं आसा दुहै एक। मेरी सैना आसा तेरी बी सैना अर मेरै घोल़ै बी आसा तेरै बी घोल़ै। <verse eid="2CH 18:3" /><verse number="4" style="v" sid="2CH 18:4" />पर तेता का आजी लणअ हाम्हां बिधाता पुछ़ी कि सह किज़ै बोला।”<verse eid="2CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 18:5" />तेखअ शादै इज़राईले राज़ै अहाबै कोई च़ार शौ गूर संघा पुछ़ै तिंयां, “हुंह गलाद रामोत नगरी अरामी संघै जुध छ़ेल़ूं कि रहणैं दैंऊं?”</para>
  <para style="p" vid="2CH 18:5">तिन्‍नैं बोलअ, “तूह छ़ेल़ तिन्‍नां संघै जुध बिधाता हेरनअ तूह ज़ताऊई।”<verse eid="2CH 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 18:6" />पर जहोशापातै पुछ़अ, “इधी बिधातो कुंण होर गूर बी किनी आसा ताकि तेऊ पुछ़ी हाम्हां ऐहा गल्‍ला लै निहंचअ होए?”<verse eid="2CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 18:7" />अहाब राज़ै दैनअ जहोशापाता लै ज़बाब, “एक गूर आसा होर, इमलो शोहरू मिका तेऊ बाती बी सका हाम्हैं बिधाता पुछ़ी। पर तेऊ गूरे लागा मुंह रोश्श! किल्हैकि सह निं मुल्है कधू राम्बल़अ खोज़दअ ई आथी, सह खोज़ा कबल्‍लअ बूरअ ई।”</para>
  <para style="p" vid="2CH 18:7">जहोशापातै बोलअ इज़राईले राज़ै लै, “तूह निं इहअ बोलै आथी!”<verse eid="2CH 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 18:8" />तेखअ शादअ इज़राईले राज़ै अहाबै एक दरबारी संघा किअ तेऊ लै हुकम, “इमले शोहरू मिका आण एभी शादी।”<verse eid="2CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 18:9" />इज़राईलो राज़अ अहाब अर यहूदो राज़अ जहोशापात तै दुहै ज़ण्हैं राज़ेए सुआबा बान्हीं सामरी नगरीए प्रऊल़ी बागै ताटी आपणीं-आपणीं गाद्दी दी बेठै दै। सोभै गूर तै तिन्‍नां सेटा आजू हणैं आल़ी गल्‍ला प्रगट करदै लागै दै। <verse eid="2CH 18:9" /><verse number="10" style="v" sid="2CH 18:10" />कनाने शोहरू सिदकिया गूरै बणाऐं लोहे शींग संघा बोलअ अहाब राज़ै लै, “बिधाता बोला इहअ, ‘इना शींगा करै करनअ ताह अरामी संघै जुध अर तिंयां करनै ताह पठी मारी खतम।’” <verse eid="2CH 18:10" /><verse number="11" style="v" sid="2CH 18:11" />होरी गूरै बी बोली एही गल्‍ल, “तूह निखल़ गलाद मुल्खे रामोत नगरी जुधा लै, बिधाता हेरनअ तूह ज़ताऊई।”<verse eid="2CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 18:12" />ज़ुंण दरबारी अहाब राज़ै मिका सेटा लै दूत छ़ाडअ त, तेऊ बोलअ मिका लै, “होरी सोभी गूरै खोज़अ इहअ कि राज़अ हणअ सफल, तूह च़ाल्‍ल संघा खोज़ै तूह बी इहअ ई।”<verse eid="2CH 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 18:13" />पर मिका दैनअ ज़बाब, “हुंह काढा तेऊ बिधाते सोह ज़ुंण सदा ज़िऊंदअ आसा, ज़िहअ सह मुखा खोज़े मुंह बोल़णअ तिहअ ई!”<verse eid="2CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 18:14" />ज़ांऊं मिका राज़ै सेटा पुजअ, अहाब राज़ै पुछ़अ तेऊ का, “मिका, तूह खोज़ कि हुंह अर जहोशापात गलाद रामोत नगरी अरामी संघै जुध छ़ेल़ूं कि रहणैं दैंऊं?”</para>
  <para style="p" vid="2CH 18:14">मिका दैनअ ज़बाब, “जुध छ़ेल़, अह गल्‍ल आसा पाक्‍की कि तूह जाणअ ज़िती। बिधाता हेरनअ तूह ज़ताऊई।”<verse eid="2CH 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 18:15" />अहाब राज़ै पुछ़अ भिई, “मिका, मंऐं हेरअ ताल्है कई बारी बोली कि तूह खोज़ मुखा शुची गल्‍ला! तूह खोज़ बिधाते नाओंऐं कि असली दी बिधाता किज़ै बोला?”<verse eid="2CH 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 18:16" />मिका दैनअ ज़बाब, “मुखा शुझिआ इहअ कि इज़राईले सैना छिंघुई उझै धारा एही भेडा-बाकरीए हेल़्ही ज़ेही ज़हा फुआल कोहै निं हंदअ। बिधाता बोला इहअ, ‘इनो फुआल पाअ मारी। इना दैआ राज्ज़ी-राम्बल़ै घअरा लै डेऊणैं।’”<verse eid="2CH 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 18:17" />इज़राईले राज़ै अहाबै बोलअ तेखअ जहोशापाता लै, “मंऐं हेरअ त ताखा पैहलै ई खोज़ी कि अह गूर निं मुल्है कधू राम्बल़अ खोज़दअ ई आथी, अह खोज़ा कबल्‍लअ बूरअ ई!”<verse eid="2CH 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 18:18" />तेखअ खोज़अ मिका आजू इहअ, “ऐबै शुण बिधातो समाद! मुखा शुझिआ इहअ बी कि बिधाता आसा आपणीं गाद्दी दी बेठअ द अर स्वर्गे सोभ ज़ीब हुऐ तेऊ फेर कठा। <verse eid="2CH 18:18" /><verse number="19" style="v" sid="2CH 18:19" />बिधाता पुछ़अ, ‘इज़राईलो राज़अ अहाब कहा डाहणअ ठगी कि सह गलाद मुल्खे रामोत नगरी अरामी संघै जुध छ़ेल़े अर तिधी पाणअ सह मारी?’ तिधी दैनी स्वर्ग दूतै आपणैं-आपणैं साबै कई सलाह। <verse eid="2CH 18:19" /><verse number="20" style="v" sid="2CH 18:20" />खिरी आई एक आत्मां संघा खल़्हुई बिधाता सेटा। तैहा बोलअ इहअ, ‘सह डाहणअ मुंह ठगी।’ बिधाता पुछ़अ तैहा आत्मां का, ‘ताह किहअ करै ठगणअ सह?’ <verse eid="2CH 18:20" /><verse number="21" style="v" sid="2CH 18:21" />तैहा आत्मां दैनअ ज़बाब, ‘मुंह डेऊणअ अहाब राज़े सोभी गूरा दी संघा बझ़ैल़णअ मुंह झ़ुठअ बोल़णैं।’ बिधाता बोलअ, ‘तै जाणीं तूह अहाब राज़ै ठगणा लै सफल हई, डेऊ ज़िहअ तूह सोठा तिहअ कर।’”<verse eid="2CH 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 18:22" />खिरी बोलअ मिका इहअ, “अहाब, असली दी हुअ ताल्है इहअ। बिधाता दैनअ हणैं कि ईंयां गूर ताल्है झ़ुठअ बोले। बिधाता आसा हेरै असली दी तेरै बारै इहअ खोज़अ द कि तूह हणअ पठी बरैबाद!”<verse eid="2CH 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 18:23" />तेखअ उखल़अ कनानो शोहरू सिदकिया गूर उझै मिका सेटा तेऊ बाही मिके थोथरै च़ैंडै संघा बोलअ इहअ, “बिधाता कधू गअ मुंह छ़ाडी ताखा खोज़दअ लागी?”<verse eid="2CH 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 18:24" />मिका दैनअ ज़बाब, “ताखा लागणअ तैहा धैल़ी थोघ ज़ेभै ताह लुक्‍कणा लै पांडा-पांडा लागणअ ठुहर्नअ।”<verse eid="2CH 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 18:25" />तेखअ किअ इज़राईले राज़ै अहाबै आपणैं सपाही लै हुकम, “मिका करा कैद, संघा निंयां एऊ नगरीए राज़पाल अमोन अर जोआश टिक्‍कै सेटा। <verse eid="2CH 18:25" /><verse number="26" style="v" sid="2CH 18:26" />तिन्‍नां का बोलै तम्हैं, ‘राज़ैओ हुकम आसा कि एऊ डाहा कैद खानै पाई, ज़ेभै तैणीं हुंह राज्ज़ी-राम्बल़अ बापस निं फिरुं, तेभै तैणीं निं एऊ लै शुक्‍की रोटी अर पाणीं का सुआई खाणां लै किछ़ दैई।’”<verse eid="2CH 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 18:27" />इहअ शूणीं बोलअ मिका, “ज़ै तूह राज्ज़ी-राम्बल़अ बापस फिरे, तै निं बिधाता ईंयां गल्‍ला मुंह बाती बोली!” तेखअ बोलअ मिका इहअ, “इधी तम्हैं होर बी डाहा शूणीं कि मंऐं किज़ै बोलअ।”<verse eid="2CH 18:27" /></para>
  <para style="s">अहाब राज़े मौत</para>
  <para style="r">(<ref loc="1KI 22:29-35">1 राज़ै 22:29-35</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="2CH 18:28" />तेखअ डेऊऐ इज़राईलो राज़अ अहाब अर यहूदो राज़अ जहोशापात दुहै आपणीं सैना पाई गलाद मुल्खे रामोत नगरी अरामी संघै जुधा लै। <verse eid="2CH 18:28" /><verse number="29" style="v" sid="2CH 18:29" />अहाब राज़ै बोलअ जहोशापाता लै, “हुंह डेऊं जुधा लै भेश बदल़ी अर तूह डाहै राज़ैओ सुआब बान्हीं।” तेखअ डेऊअ इज़राईलो राज़अ अहाब जुधा लै भेश बदल़ी।<verse eid="2CH 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CH 18:30" />अराम देशे राज़ै किअ आपणैं रथा आल़ै सैनापति लै हुकम, “तम्हैं पल़ै होरी सोभी छ़ाडी सिधै इज़राईले राज़ै अहाबा लै चुटी।” <verse eid="2CH 18:30" /><verse number="31" style="v" sid="2CH 18:31" />ज़ांऊं तिन्‍नैं जहोशापात भाल़अ, तिन्‍नैं ज़ाणअ सोभी इहअ कि अह आसा इज़राईलो राज़अ अहाब अर तिंयां पल़ै तेऊ लै चुटी। ज़ांऊं जहोशापातै हाक्‍का पाई, बिधाता किई तेऊए एही मज़त कि अरामी सैना हटी तेऊ का पिछ़ू। <verse eid="2CH 18:31" /><verse number="32" style="v" sid="2CH 18:32" />अरामी दलपति का गअ थोघ लागी कि अह निं इज़राईलो राज़अ अहाब आथी अर तिन्‍नैं छ़ाडअ तेऊओ पिछ़अ करनअ। इहअ करै बच़ाऊअ बिधाता जहोशापात। <verse eid="2CH 18:32" /><verse number="33" style="v" sid="2CH 18:33" />एकी अरामी सपाही बाही कतीरै अर सह लागी कुदरती इज़राईले अहाब राज़ै लै तेऊए कबचा मांझ़ै ज़िधी ज़ोल़ हआ, अहाबै बोलअ आपणैं सारथी लै, “हुंह हुअ ज़खमी! रथ फरेऊ पिछ़ू संघा निंऊं मुंह जुधा का दूर!” <verse eid="2CH 18:33" /><verse number="34" style="v" sid="2CH 18:34" />जुध च़लअ सारी धैल़ी, अहाब राज़अ रहअ आपणैं रथा दी अरामी बाखा मुंह करी होरी सपाही दी नील़ लाई खल़्हुई। खिरी शोटै उडै तेऊ प्राण।<verse eid="2CH 18:34" /></para>
  <chapter eid="2CH 18" />
  <chapter number="19" style="c" sid="2CH 19" />
  <para style="s">राज़ै जहोशापाता लै जेहू गूरे चतैनगी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 19:1" />यहूदा मुल्खो राज़अ जहोशापात पुजअ राज़धानी एरुशलेम राज्ज़ी-राम्बल़अ फिरी। <verse eid="2CH 19:1" /><verse number="2" style="v" sid="2CH 19:2" />तिधी आअ राज़ै जहोशापाता सेटा बिधातो एक गूर हनानो शोहरू जेहू संघा बोलअ इहअ, “तूह किल्है डेऊअ कदुष्टे मज़ती करदअ? तूह किल्है झ़ूरअ तिन्‍नें साथा लै ज़ुंण बिधाता का नफरत करा? ज़ुंण तंऐं इहअ किअ, एता लै आसा बिधाता ताल्है खास्सी रोश्शै आई दी!” <verse eid="2CH 19:2" /><verse number="3" style="v" sid="2CH 19:3" />तज़ी बी निं तूह पठी बूरअ आथी। तंऐं किऐ अशेरा देबीए सोभै मुहुर्ती पूज़ा करने गान-स्तान दूर ज़िधी लोग माथै टेक्‍कदै डेओआ तै, तंऐं च़ाहअ तत्त-दिला का तिहअ करनअ ज़िहअ बिधाता च़ाहा।<verse eid="2CH 19:3" /></para>
  <para style="s">जहोशापाते सधेरै कई काम</para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 19:4" />जहोशापात रहा त राज़धानी एरुशलेम, पर सह रहा त कबल्‍लअ दखण बेर्शेबा उझै उतर धारा बाखे मुल्खै एप्रैम तैणीं हर ज़ैगा डेऊंदअ लागी। इहअ करै समझ़ाऊई तेऊ सारी परज़ा कि तिंयां बिधाता बाखा फिरे अर तिंयां बिधाता तिहै ई मने ज़िहै तिन्‍नें दाद-बाब मना तै। <verse eid="2CH 19:4" /><verse number="5" style="v" sid="2CH 19:5" />तेऊ डाहै यहूदा मुल्खै सोभी गहल़ा आल़ी नगरी दी लोगा लै पांज़ पांच़ अर <verse eid="2CH 19:5" /><verse number="6" style="v" sid="2CH 19:6" />तिन्‍नां लै डाहअ इहअ बोली, “तम्हैं करै सोठी-समझ़ी फैंसलअ करी। तम्हैं निं मणछा खुश करना लै फैंसलै करी, थारै नसाफ करनै करै लोल़ी बिधाता खुश हुअ। ज़ै तम्हैं बिधाते परज़ा लै शुचअ नसाफ करे तै रहणअ तम्हां संघै बिधाता आप्पै। <verse eid="2CH 19:6" /><verse number="7" style="v" sid="2CH 19:7" />थारै कामां करै लोल़ी बिधातो अदर हुअ, किल्हैकि म्हारअ परमेशर बिधाता निं खोट, पक्षपात अर रेशपत मंदअ आथी।”<verse eid="2CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 19:8" />राज़धानी एरुशलेम बी डाहै राज़ै जहोशापातै लेबी, प्रोहत अर इज़राईले होरी सैणैं मांझ़ै पांच़ ताकि तिंयां बिधाते बधाने भूल-च़ूक अर परज़ा मांझ़ै आम झ़गल़े नसाफ करे। <verse eid="2CH 19:8" /><verse number="9" style="v" sid="2CH 19:9" />जहोशापातै डाही तिन्‍नां लै एही चतैनगी दैई, “तम्हैं करै बिधाते डरा हेठै शुचै-पाक्‍कै रही परज़ो नसाफ।” <verse eid="2CH 19:9" /><verse number="10" style="v" sid="2CH 19:10" />होरी नगरी का बी सका तम्हां सेटा मकदमैं एछी। तिंयां मकदमैं च़ाऐ हत्या करने होए, बिधाते बधान, हुकम, बिधी या होरी काईदे बारै होए, तम्हैं करै तिन्‍नां लै चतैनगी दैई कि बिधाता लै पाप निं करी ताकि थारै भाई-बंधा लै बिधातो कोप नां पल़े। ज़ै तम्हैं आपणअ काम शुचै-पाक्‍कै रही करे तै निं तम्हैं किछ़ू गल्‍ला लै कशूरबार हणैं। <verse eid="2CH 19:10" /><verse number="11" style="v" sid="2CH 19:11" />ज़ुंण बी बिधाते बधाने बारै मकदमैं एछे, तेतो पांच़ हणअ अमर्या प्रोहत। यहूदा गोत्रो सैणअ इशमाईलो शोहरू जबदीया आसा राज़पाल, राज़ दरबारे मकदमें फैंसलै करनै तेऊ। होरी लेबी करनी तम्हां संघै इना कामां लै थारी मज़त। तम्हैं करै हिम्मत अर बिधाता सेटा एही अरज़ कि सह नसाफ करना लै थारी मज़त करे।<verse eid="2CH 19:11" /></para>
  <chapter eid="2CH 19" />
  <chapter number="20" style="c" sid="2CH 20" />
  <para style="s">एदोम देशा संघै जुध</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 20:1" />थोल़ी साला बाद किअ मोआबी, अमोनी अर एदोमी लोगै आप्पू मांझ़ै एक्‍कअ संघा निखल़ै जहोशापात राज़ै संघै जुधा लै। <verse eid="2CH 20:1" /><verse number="2" style="v" sid="2CH 20:2" />जहोशापात राज़ै सेटा आऐ दूत, तिन्‍नैं खोज़अ, “एदोम देशे पुर्बा लाल समुंदरा बाखा आई खास्सी सैना म्हारै देशा बाखा लै! तिंयां गऐ हसोन-तामर पुजी ज़ेता लै एनगाद बोला अर तेथ हेरअ तिन्‍नैं कबज़अ करी।” <verse eid="2CH 20:2" /><verse number="3" style="v" sid="2CH 20:3" />जहोशापात राज़ै पल़ी डअर अर तेऊ किई बिधाता सेटा अरज़ कि ऐबै किहअ करूं? तेखअ किअ तेऊ यहूदा मुल्खे सारी परज़ा लै हुकम कि ज़ुंण हाम्हां लै अह दुख पल़अ, एता लै रहा सोभ ब्रतू। <verse eid="2CH 20:3" /><verse number="4" style="v" sid="2CH 20:4" />यहूदा मुल्खा का आऐ हर नगरी का यहूदी एरुशलेम नगरी बिधाता पुछ़दै कि ऐबै किहअ करनअ? <verse eid="2CH 20:4" /><verse number="5" style="v" sid="2CH 20:5" />तिन्‍नैं सोभी किअ बिधाते भबने नऊंईं ताटी झाल़अ। राज़अ जहोशापात बी डेऊअ तिन्‍नां सेटा संघा हुअ यहूदा अर एरुशलेम नगरी का आऐ दै सोभी लोगा आजू खल़अ।<verse eid="2CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 20:6" />जहोशापात राज़ै किई बिधाता सेटा एही अरज़, “हे म्हारै दादा-बाबे परमेशर बिधाता, तूह करा स्वर्गा का सोभी देशा प्रैंदै राज़। सारअ बल अर शगती आसा ताखा ई! तेरअ मकाबलअ निं कोहै करी सकदअ! <verse eid="2CH 20:6" /><verse number="7" style="v" sid="2CH 20:7" />ए म्हारै परमेशर, ऐहा ज़ैगा आसा हाम्हैं तंऐं पजैल़ै दै अर ज़ुंण हाम्हां का आजी एथ थिऐ बस्सै दै, तिंयां काढै तंऐं इज़राईली नदरी एता का पोर्ही संघा दैनी तंऐं अह ज़ैगा आबरामे आद-लुआदा लै ज़ुंण ताल्है तेरअ साथी ज़िहअ थिअ। <verse eid="2CH 20:7" /><verse number="8" style="v" sid="2CH 20:8" />आबरामे आद-लुआद बस्सै एथ संघा बणाअं तेरै अदर करना लै एक भबन। <verse eid="2CH 20:8" /><verse number="9" style="v" sid="2CH 20:9" />तिन्‍नां का थिअ ऐहा गल्‍लो थोघ, ज़ै ऐहा ज़ैगा जुध, नकाल़, माहा मरी कि किज़ै होर आफ़त एछे, तै सका तेरी परज़ा तेरै भबना सेटा एछी ताखा अरज़ करी अर ताह शुणनी तिन्‍नें अरज़ संघा हेरनै ताह तिंयां बच़ाऊई।<verse eid="2CH 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 20:10" />“ऐबै भाल़, मोआबी, अमोनी, एदोमी लोग आऐ हाम्हां इज़राईली हारदै-मारदै! ज़धू म्हारै दाद-बाब मिसर देशा का एछदै तै लागै दै, तधू निं तंऐं तिन्‍नां इना देशे ज़ैगा बाती एछणैं दैनअ अर म्हारै दाद-बाब आऐ इना देशा बागी फेरअ दैई इधा लै अर तिन्‍नैं निं ईंयां मारै आथी। <verse eid="2CH 20:10" /><verse number="11" style="v" sid="2CH 20:11" />तैही आसा तिंयां ऐबै हाम्हां का बदल़ै लंदै आऐ दै कि हाम्हैं दरल़ाऊंणै तिन्‍नां ऐहा ज़ैगा का पोर्ही ज़ुंण ज़ैगा हाम्हां लै तंऐं आसा दैनी दी। <verse eid="2CH 20:11" /><verse number="12" style="v" sid="2CH 20:12" />हे परमेशर, ऐबै दै इना लै तूह आप्पै सज़ा, ऐहा एतरी बडी सैना आजू आसा हाम्हैं बज़ंद हुऐ दै! हाम्हां निस्सी समझ़ पल़ी कि किज़ै करनअ? ऐबै आसा हाम्हैं सिधै ताह ई बाखा भाल़ै लागै दै।”<verse eid="2CH 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 20:13" />तिधी तै बिधाते भबनै यहूदा मुल्खै ज़ैगा-ज़ैगा का आऐ दै मणछ, तिन्‍नें बेटल़ी अर शोहरू-माठै संघै खल़्हुऐ दै। <verse eid="2CH 20:13" /><verse number="14" style="v" sid="2CH 20:14" />बिधाता आअ हेरा-हेरी एकी जहजीएल नाओंए एकी लेबी दी ज़ुंण तिधी लोगा जैंदरी थिअ। सह लेबी त असाप टोली का मतानियाहे आद-लुआदा मांझ़ै जकर्यो शोहरू, बेनियाह अर जेइलो पल़पोचअ। <verse eid="2CH 20:14" /><verse number="15" style="v" sid="2CH 20:15" />जहजीएलै बोलअ इहअ, “यहूदी मणछो! एरुशलेम बस्सै दै सोभी मणछो! राज़अ जहोशापात! बिधाता बोला तम्हां लै इहअ, ‘ऐहा एतरी बडी सैना भाल़ी निं तम्हैं डरदै लागी अर नां आपणअ हैअ चोल़ी। जुध निं थारअ आथी!’ तम्हां बाखा हणअ थारअ परमेशर आप्पै। <verse eid="2CH 20:15" /><verse number="16" style="v" sid="2CH 20:16" />तम्हैं पल़ै काल्‍ला तिन्‍नां लै चुटी, तिंयां हणैं सीस कुआल़ी उझै उखल़दै लागै दै, तिंयां भेटणैं तम्हां तेऊ खागै तैहा बाता ज़ुंण जरूएल नगरी नेल़ रेगीस्ताना लै डेओआ। <verse eid="2CH 20:16" /><verse number="17" style="v" sid="2CH 20:17" />तम्हां निं जुध करने ज़रुरत ई पल़णीं। तम्हैं रहै उपर सिधै लगैग लाई खल़्हुई तिन्‍नां न्हैल़ै लागी अर तम्हां का जाणअ तिधी शुझुई कि बिधाता दैनी तम्हां लै ज़ीत। यहूदा अर एरुशलेम नगरीए लोगो! तम्हैं निं हैल़अ-फिकर डाही नां डरी आथी। तम्हैं डेओआ काल्‍ला जुधा लै अर तम्हां संघै हणअ बिधाता आप्पै।”<verse eid="2CH 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 20:18" />राज़ै जहोशापातै टेक्‍कअ धरनीं उटअ पल़ी माथअ अर यहूदा मुल्खे होरी नगरी अर एरुशलेम नगरी का तिधी आऐ दै सोभी मणछै बी टेक्‍कअ बिधाता सेटा माथअ। <verse eid="2CH 20:18" /><verse number="19" style="v" sid="2CH 20:19" />कोराह अर कहात टोलीए लेबी उझ़ुऐ खल़ै संघा लागै ज़ोरै-ज़ोरै बोल्दै, “इज़राईले परमेशर बिधाते लोल़ी सदा ज़ै-ज़ैकार हुई।”<verse eid="2CH 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 20:20" />दुजै धैल़ै दोत्ती उझ़ुऐ सोभ दोत्थी संघा डेऊऐ तकोआ रेगीस्ताना बाखा लै। हांढदी-हांढदी हुअ जहोशापात आजू खल़अ संघा बोलअ सोभी लै इहअ, “यहूदा अर एरुशलेम नगरीए मणछो! तम्हैं डाहा आपणैं परमेशर बिधातो भरोस्सअ, तै सका तम्हैं मकाबलै लै टेक्‍की। तिन्‍नां गल्‍ला दी करा विश्वास ज़ुंण बिधाते गूरै बोली, तै जाणैं तम्हैं सफल हई।” <verse eid="2CH 20:20" /><verse number="21" style="v" sid="2CH 20:21" />सोभी लोगा संघै सलाह करी राज़ै जहोशापातै किअ थोल़ै गाज़ै-बाज़ै आल़ै लै हुकम कि च़ोल़ै बान्हीं हांढा गाज़ै-बाज़ै संघै सारी सैना आजू एही गिहा बोल्दी, “बिधाते ज़ै-ज़ैकार, सह झ़ूरा हाम्हां लै सदा!”<verse eid="2CH 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 20:22" />ज़ांऊं तिंयां गिहा बोल्दै लागै, बिधाता पाअ दुशमणे सैना दी झाख ज़ुंण यहूदी खतम करदै तै आऐ दै! <verse eid="2CH 20:22" /><verse number="23" style="v" sid="2CH 20:23" />अमोनी अर मोआबी पल़ै एदोमी सैना मारदै चुटी अर तिंयां किऐ तिन्‍नैं पठी खतम अर तेखअ झ़घल़ुऐ तिंयां आप्पू मांझ़ै ज़ेभै तैणीं तिंयां एकी-दुजै पठी निं मारी मुक्‍कै। <verse eid="2CH 20:23" /><verse number="24" style="v" sid="2CH 20:24" />ज़ांऊं यहूदी सैना रेगीस्ताना नेल़ च़ौकी दी पुजै, तिन्‍नैं भाल़ी दुशमणे सैना कि तिंयां आसा सोभ धरनीं लाम्मै पल़ै दै अर मूंऐं दै! तिन्‍नां मांझ़ै निं कोह ज़िऊंदअ आथी त बच़अ द!<verse eid="2CH 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 20:25" />जहोशापात अर तेऊए सारी सैना डेऊई तिन्‍नां नेल़ समाना लुटदै अर तिन्‍नां भेटी तेथ खास्सी ज़िणस, गाऊई, झिकल़ै अर होर बी कई खास्सी किम्मती च़िज़ा। तिन्‍नां समाना झाल़णां लै लागै तिन्‍नां चअन धैल़ै पर तज़ी बी निं तिंयां तेता का पठी समान झाल़ी आणी सकै। <verse eid="2CH 20:25" /><verse number="26" style="v" sid="2CH 20:26" />च़ौथै धैल़ै हुऐ तिंयां सोभ एकी खागै कठा संघा किअ सोभी बिधाता शूकर। तैही पल़अ तेऊ खागा नाअं, “बराका<note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="fq" closed="false">बराका </char><char style="ft" closed="false">ज़ै-ज़ैकार</char></note>।” <verse eid="2CH 20:26" /><verse number="27" style="v" sid="2CH 20:27" />तेखअ आऐ तिंयां सोभ यहूदी एरुशलेम नगरी लै फिरी, तिन्‍नां आजू-आजू त जहोशापात हांढदअ लागअ द। तिंयां सोभ तै खास्सै खुश हुऐ दै किल्हैकि बिधाता दैनी ती तिन्‍नां लै तिन्‍नें दुशमणा का ज़ीत। <verse eid="2CH 20:27" /><verse number="28" style="v" sid="2CH 20:28" />हांढदी-हांढदी तै तिंयां बींन, छ़छ़ाल़ा अर नर्शिंगै बाज़दै लागै दै, संघा डेऊऐ तिंयां कोहरै एरुशलेम नगरी बिधाते भबनै। <verse eid="2CH 20:28" /><verse number="29" style="v" sid="2CH 20:29" />ज़ांऊं ओरी-पोरी होरी सोभी देशा का इहअ थोघ लागअ कि बिधाता किअ इज़राईलीए दुशमणे सैना संघै आप्पै जुध! तधा बाद लागै तिंयां बिधाता का डरदै। <verse eid="2CH 20:29" /><verse number="30" style="v" sid="2CH 20:30" />इहअ करै हुई जहोशापाते राज़ा दी शांती किल्हैकि बिधाता दैनअ तिन्‍नां लै फेर-फिरदै सोभी दुशमणा का राम।<verse eid="2CH 20:30" /></para>
  <para style="s">यहूदा मुल्खै राज़ै जहोशापातो राज़ो सार</para>
  <para style="r">(<ref loc="1KI 22:41-50">1 राज़ै 22:41-50</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 20:31" />ज़धू जहोशापात यहूदा मुल्खो राज़अ बणअ, तधू ती तेऊए अमर पैंईंती साले। तेऊ किअ एरुशलेम नगरी का यहूदा मुल्खै पच्‍ची साला तैणीं राज़। तेऊए ईज थिई शिल्हीए शोहरी अजूबा। <verse eid="2CH 20:31" /><verse number="32" style="v" sid="2CH 20:32" />जहोशापात त आपणैं बाब आसाह ज़िहअ भलअ, तेऊ बी किअ तिहअ ई ज़िहअ बिधाता च़ाहा त कि इहअ लोल़ी हुअ। <verse eid="2CH 20:32" /><verse number="33" style="v" sid="2CH 20:33" />पर उछ़टी धारा देहुरै निं तेऊ बी ढोल़ै, यहूदी परज़ा निं अज़ी बी तत्त-दिला का आपणैं दादा-बाबे परमेशर बिधाता बाखा फिरै आथी तै कि तिंयां सिधी बिधाते स्तोती करे।<verse eid="2CH 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2CH 20:34" />राज़ै रहंदी जहोशापातै ज़िहअ-ज़िहअ बी किअ, तिंयां गल्‍ला आसा शुरू पोर्ही तेऊओ राज़ खतम हणैं तैणीं हनानीए शोहरू जेहू लिखी दी कताबा दी लिखी दी, जेहूए सह कताब आसा इज़राईल मुल्खे राज़े इतिहासो भाग।<verse eid="2CH 20:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2CH 20:35" />यहूदा मुल्खे राज़ै जहोशापातै किअ आपणैं राज़ा दी इज़राईल मुल्खे राज़ै अहाजया संघै सुल्हअ ज़ुंणीं कई कदुष्ट काम किऐ तै। <verse eid="2CH 20:35" /><verse number="36" style="v" sid="2CH 20:36" />जहोशापात राज़ै बणाऐं एजोन-गेबर नाओंए ज़ैगा समुंदरै हांढणै आल़ै कई ज़हाज़। <verse eid="2CH 20:36" /><verse number="37" style="v" sid="2CH 20:37" />पर मारेशा नगरीए दोदाबाहे शोहरू एलीआजरै दैनी जहोशापाता लै चतैनगी, “तंऐं किअ कदुष्ट अहाजया राज़ै संघै मेल़-ज़ोल़ अर एता पिछ़ू करनी बिधाता तेरी बणाईं दी च़िज़ा बरैबाद।” तिंयां ज़हाज़ चुटै अर तिंयां निं तरशीश पुजै ई आथी कि तिन्‍नां बेच़ी सके।<verse eid="2CH 20:37" /></para>
  <chapter eid="2CH 20" />
  <chapter number="21" style="c" sid="2CH 21" />
  <para style="p">
    <verse number="1" style="v" sid="2CH 21:1" />खिरी ज़ांऊं राज़अ जहोशापात मूंअ, सह डाहअ दाबेदपूर नगरी दाबी अर तेऊ बाद बणअ तेऊओ शोहरू जेहोराम यहूदा मुल्खो राज़अ।<verse eid="2CH 21:1" /></para>
  <para style="s">यहूदा मुल्खो राज़अ जेहोराम</para>
  <para style="r">(<ref loc="2KI 8:17-24">2 राज़ै 8:17-24</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 21:2" />इज़राईल मुल्खे राज़ै जहोशापाते तै सात शोहरू, जेहोराम त सोभी का ज़ेठअ अर तेऊ कान्हैं तै छ़ह शोहरू अजर्याह, जेहीएल, जकर्या, अजर्याह, मिकाईल, शपताह। <verse eid="2CH 21:2" /><verse number="3" style="v" sid="2CH 21:3" />जहोशापातै दैनअ तिन्‍नां सोभी लै सुन्‍नअ, च़ंदी अर होर बी खास्सी किम्मती च़िज़ा ज़ैदात बांडी। संघा सभाल़ी तिन्‍नां सोभी लै यहूदा मुल्खै एक-एक गहल़ा आल़ी नगरी। <verse eid="2CH 21:3" /><verse number="4" style="v" sid="2CH 21:4" />पर ज़ांऊं जेहोरामै यहूदा मुल्खै राज़-काज़ सभाल़अ, तेऊ पाऐ आपणैं सोभ कान्हैं भाई मारी अर तिन्‍नां संघै मारै थोल़ै इज़राईली कार-करिंदै बी!<verse eid="2CH 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 21:5" />जेहोराम बणअ बत्ती साले अमरा राज़अ अर तेऊ किअ एरुशलेम नगरी का इज़राईल मुल्खै आठा साला तैणीं राज़। <verse eid="2CH 21:5" /><verse number="6" style="v" sid="2CH 21:6" />तेऊए राणीं ती अहाब राज़ेए देई अर इज़राईले राज़ै अहाबे खिंबा ज़िहअ किअ जेहोरामै बी सह ई पाप ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे। <verse eid="2CH 21:6" /><verse number="7" style="v" sid="2CH 21:7" />पर बिधाता निं यहूदा बरैबाद करनअ च़ाहंदअ त, किल्हैकि तेऊ ती आपणैं दास दाबेदा संघै करार किई दी कि तेऊए आद-लुआदा मांझ़ै रहणअ यहूदा दी कुंण नां कुंण राज़अ बणी।<verse eid="2CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 21:8" />जेहोरामे राज़ा दी हुअ एदोम देश यहूदे गलामी का आज़ाद संघा बणाअं तिन्‍नैं आपणअ एक राज़अ। <verse eid="2CH 21:8" /><verse number="9" style="v" sid="2CH 21:9" />राज़ै जेहोराम अर तेऊए कार-करिंदै किऐ आपणैं सारै रथ कठा संघा पुजअ एदोम। तिधी गोटै तिंयां एदोम देशे सैना फेर-फिरदै। तैहा राची निखल़ै तिंयां तिधा का बडी मस्सा बच़ी। <verse eid="2CH 21:9" /><verse number="10" style="v" sid="2CH 21:10" />इहअ करै हुअ एदोम यहूदा का आज़ाद अर सह आसा आझ़ तैणीं बी<note caller="+" style="f"><char style="fr" closed="false">21:10 </char><char style="fq" closed="false">आझ़ तैणीं बी </char><char style="ft" closed="false">ऐहा कताबा लिखणे ज़मानै तैणीं</char></note> तिहअ ई। लिब्ना नगरी बी हुई तेऊ ई ज़मानै यहूदा का आज़ाद। किल्हैकि जेहोराम राज़अ हुअ त आपणैं दादा-बाबे परमेशर बिधाता का दूर। <verse eid="2CH 21:10" /><verse number="11" style="v" sid="2CH 21:11" />होर ता होर तेऊ डाहै यहूदा मुल्खे ज़ैगा-ज़ैगा धारा मुहुर्ती पूज़ा करने कंज़रै गान-स्तान भिई बणाईं अर संघा कराऊअ एरुशलेम अर यहूदा मुल्खे परज़ा का मुहुर्ती पूज़ा करनैओ पाप ज़ेता बिधाता नांईं च़ाहंदअ त कि तिंयां करे।<verse eid="2CH 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 21:12" />एलियाह गूरै दैनअ राज़ै जेहोरामा लै च़िठी लिखी इहअ समाद, “मेरअ समाद आसा ताल्है तेऊ परमेशर बिधाता बाखा ज़हा तेरअ दाद-बाब दाबेद मना त। तेऊ बिधाता का आसा शुझदअ लागअ द कि तंऐं निं आपणैं बाब यहूदा मुल्खै राज़ै जहोशापात अर आपणैं दादू आसाह राज़ै ज़िहअ भलअ किअ! <verse eid="2CH 21:12" /><verse number="13" style="v" sid="2CH 21:13" />तंऐं किअ तेता का उंबल़अ! तंऐं किई इज़राईल मुल्खे पापी कंज़रै राज़ै ज़ेही नकल। तंऐं किऐ एरुशलेम अर यहूदा मुल्खे परज़ा बिधाता का दूर, ज़िहअ अहाब राज़ै अर तेऊए आद-लुआदै इज़राईल मुल्खै किअ त! तंऐं पाऐ आप्पू कान्हैं आपणैं सक्‍कै भाई तोही मारी ज़ुंण ताखा राम्बल़ै थिऐ! <verse eid="2CH 21:13" /><verse number="14" style="v" sid="2CH 21:14" />एतो नतिज़अ हणीं ताल्है घोर आफ़त! बिधाता दैणीं तेरी परज़ा, तेरै शोहरू, तेरी बेटल़ी लै घोर सज़ा। तेरी ज़ैदात करनी तेऊ पठी बरैबाद अर तेरअ राज़ हणअ खतम। <verse eid="2CH 21:14" /><verse number="15" style="v" sid="2CH 21:15" />ताह लागणीं आंजा दी लागणीं एही नबिज़री बमारी कि पेटै दाहे झोशा करै निखल़णीं तेरी आंजा बी बागै।”<verse eid="2CH 21:15" /></para>
  <para style="s">राज़ै जेहोरामे खिरीए धैल़ै</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 21:16" />बिधाता किअ इहअ कि कूश देशा नेल़ बस्सै दै पलिश्ती अरब देशे लोग ज़िधूऐ राज़ै जेहोरामा लै। <verse eid="2CH 21:16" /><verse number="17" style="v" sid="2CH 21:17" />तिन्‍नैं छ़ेल़अ यहूदा मुल्खा संघै जुध। तिन्‍नां एरुशलेम राज़े मैहलै ज़ेतरी ज़ैदात भेटी, सह लुटी तिन्‍नैं पठी। तिन्‍नैं निंयैं राज़ै जेहोरामे सोभ बेटल़ी अर सोभ शोहरू आप्पू संघै कैद करी। जेहोराम राज़ै सेटा छ़ाडअ सिधअ तेऊओ सोभी कान्हअ शोहरू अहाजया।<verse eid="2CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 21:18" />इना एतरी गल्‍ला हणैं बाद दैनी बिधाता जेहोरामा आंजा दी लागी नबिज़री बमारी लागणै अर तेऊ लागी पेटै दाहे झोशा। <verse eid="2CH 21:18" /><verse number="19" style="v" sid="2CH 21:19" />दाह रही बढदी ई लागी अर तेऊ लागी पेटै दाहे एही झोशा कि आंजा बी निखल़ी बागै अर खिरी हुई कोई दूई साला बाद तेऊए मौत। तेऊ मरनै बाद निं तेऊए अदर करना लै निं परज़ा खुशबूदार मसालै ज़ाल़ी आगीओ घैनअ पाअ ज़िहअ तेऊए दादा-बाबा लै लोग करा तै।<verse eid="2CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 21:20" />जेहोराम बणअ बत्ती साले अमरा राज़अ अर तेऊ किअ एरुशलेम नगरी का इज़राईल मुल्खै आठा साला तैणीं राज़। तेऊ मरनैओ दुख निं कोही हुअ। सह डाहअ तिन्‍नैं दाबेदपूर नगरी दाबी पर तिन्‍नां घोरी दी निं तिन्‍नैं सह दाबअ ज़िधी खासकर राज़ै दाबा तै।<verse eid="2CH 21:20" /></para>
  <chapter eid="2CH 21" />
  <chapter number="22" style="c" sid="2CH 22" />
  <para style="s">यहूदी मुल्खै अहाजया राज़अ</para>
  <para style="r">(<ref loc="2KI 8:25-29">2 राज़ै 8:25-29</ref>; <ref loc="2KI 9:21-28">9:21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 22:1" />अरब देशै ज़ुंण जेहोरामे शोहरू कैद किऐ तै, तिंयां पाऐ बादा का तिन्‍नैं सोभ मारी। जेहोरामो सोभी का कान्हअ शोहरू अहाजया त एक्‍कै ज़िऊंदअ बच़अ द अर सह बणाअं यहूदा मुल्खो राज़अ। <verse eid="2CH 22:1" /><verse number="2-3" style="v" sid="2CH 22:2-3" />अहाजया त तधू बाई सालो ज़धू सह राज़अ बणअ। तेऊ किअ एरुशलेम नगरी का यहूदा मुल्खे इज़राईली प्रैंदै एकी ई साला राज़। तेऊए ईजा नाअं त अताल्या अर सह थिई इज़राईले राज़ै ओमरीए पोची। तेसे सलाह करै किअ तेऊ पाप। अहाजया बी किअ अहाबे खिंबा ई ज़िहअ पाप। <verse eid="2CH 22:2-3" /><verse number="4" style="v" sid="2CH 22:4" />आपणैं बाबा मरनै बाद बणाऐं तेऊ अहाब राज़े भाई-बंधा मांझ़ै आपणैं बज़ीर, तिन्‍नें सलाह करै किऐ तेऊ बिधाता लै पाप ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे! <verse eid="2CH 22:4" /><verse number="5" style="v" sid="2CH 22:5" />तिन्‍नैं ई दैनी तेऊ लै सलाह संघा ज़ुल़अ उतरा बाखा इज़राईले राज़ै अहाबे शोहरू जोरामा संघै गलाद मुल्खै रामोत अराम देशे राज़ै हज़ाएला संघै जुधा लै। तेऊ जुधा दी हुअ जोराम खास्सअ ज़खमी। <verse eid="2CH 22:5" /><verse number="6" style="v" sid="2CH 22:6" />अहाबो शोहरू राज़अ जोराम आअ फिरी कि जज्रेल पुजी सह तिन्‍नां ज़खमो लाज़ करे ज़ुंण तेऊ अरामी हज़ाएला संघै जुध करदी पल़ै तै। यहूदो राज़अ जेहोरामो शोहरू अजर्याह डेऊअ तिधी तेऊ झेठू।<verse eid="2CH 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 22:7" />बिधाता दैनअ इहअ हणैं कि यहूदो राज़अ अहाजया उतरा बाखा इज़राईले राज़ै जोरामे साथा डेओए कि सह बरैबाद होए। ज़ांऊं अहाजया जज्रेल नगरी आअ, तेऊ अर जोरामा निं समझ़ ई निस्सी ती पल़ी कि निमशीओ पोचअ ज़ैऊ तिन्‍नां सेटा लै किज़ू कामैं आअ अर तिंयां निखल़ै तेऊ सेटा लै मिलदै! बिधाता त ज़ैऊ छ़ांटअ द कि सह अहाब राज़ैओ सारअ खिंब खतम करे! <verse eid="2CH 22:7" /><verse number="8" style="v" sid="2CH 22:8" />ज़ैऊ त अहाब राज़े खिंबा लै तिहअ ई करदअ निखल़अ द कि बाता भेटै तेऊ यहूदी सैणैं अर अहाजया राज़े भाणज़ू ज़ुंण अहाजया राज़े च़ाकरी करा तै, ज़ैऊ पाऐ तिंयां तिधी मारी। <verse eid="2CH 22:8" /><verse number="9" style="v" sid="2CH 22:9" />तेखअ छ़ाडै तेऊ आपणैं आदमी अहाजया लोल़ै। तिन्‍नां भेटअ अहाजया कि सह आसा सामरी नगरी लुक्‍कअ द। तिन्‍नैं आणअ सह ज़ैऊ सेटा लै अर ज़ैऊ पाअ अहाजया राज़अ मारी। तिन्‍नैं डाहअ अहाजया मरी करै इज़ती संघै इहअ बोली दाबी कि अह आसा राज़ै जहोशापातो पोचअ। जहोशापातै आसा तत्त-दिला का बिधाते च़ाकरी किई दी।</para>
  <para style="p" vid="2CH 22:9">राज़ै अहाजये खिंबो निं इहअ कुंण बच़अ ई आथी ज़ुंण यहूदा मुल्खै राज़ करी सके।<verse eid="2CH 22:9" /></para>
  <para style="s">यहूदे राणीं अताल्या</para>
  <para style="r">(<ref loc="2KI 11:1-3">2 राज़ै 11:1-3</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 22:10" />राज़ै अहाजये ईज अताल्या भाल़अ कि तेसो शोहरू हेरअ मारी, तैहा किअ हुकम कि राज़ परिबारे तिन्‍नां सोभी पाआ मारी ज़ुण राज़ै बणी यहूदा मुल्खे राज़ै बणी सका। तैहा किअ बी तिहअ ई। <verse eid="2CH 22:10" /><verse number="11" style="v" sid="2CH 22:11" />तिन्‍नां मांझ़ै छ़ुटअ सिधअ अहाजयो शोहरू जोआश। सह बी हेरअ त होरी संघै मारी पाई पर सह बच़ाऊअ तेऊ शोहरूए बुबी जेहशेबा<note caller="+" style="f"><char style="fr" closed="false">22:11 </char><char style="fq" closed="false">जेहशेबा </char><char style="ft" closed="false">जेहोशेबात</char></note>। सह थिई राज़ै जेहोरामे शोहरी अहाजये काकी बैहण। तेसो बैह त जहोयादा नाओंए प्रोहता संघै हुअ द। तैहा निंयं अहाजयो सह शोहरू होरी टिक्‍कै का दूर संघा डाहअ तेऊ धाचणै आल़ी दाई संघी झिकल़ै डाहणें कठैरी बिधाते भबनै एकी कमरू च़ोरी अर इहअ करै बच़अ सह अताल्या का ज़िऊंदअ। <verse eid="2CH 22:11" /><verse number="12" style="v" sid="2CH 22:12" />सह डाहअ जेशेबा छ़हा साला तैणीं बिधाते भबनै च़ोरी संघा रही तिधी लुक्‍की करै तेऊ धाचदी लागी। यहूदा ती अताल्या राणीं राज़ करदी लागी दी।<verse eid="2CH 22:12" /></para>
  <chapter eid="2CH 22" />
  <chapter number="23" style="c" sid="2CH 23" />
  <para style="s">अताल्या लै द्रोह</para>
  <para style="r">(<ref loc="2KI 11:4-16">2 राज़ै 11:4-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 23:1" />छ़हा साला तैणीं अहाजये शोहरू जोआशा च़ोरी डाहणैं बाद सोठअ जहोयादा प्रोहतै कि ऐबै हुअ किज़ै करनअ। तेऊ किऐ सातुई साला सैनापति, दलपति अर दरबारी मांझ़ै पांज़ ज़ण्हैं आप्पू बाखा संघा बझ़ैल़ी तिन्‍नां का बिधाते सोह खाई करार करनै। तिंयां कार-करिंदै तै जेरोहामो शोहरू अजर्याह, जहोहनानो शोहरू इशमाईल, ओबेदो शोहरू अजर्याह अदायो शोहरू मासेया अर ज़िक्रीओ शोहरू एलीशापात। <verse eid="2CH 23:1" /><verse number="2" style="v" sid="2CH 23:2" />तिंयां हांढै यहूदा मुल्खै सोभी नगरी संघा आणै इज़राईली मांझ़ै लेबी अर सोभी टोलीए सैणैं एरुशलेम नगरी लै।<verse eid="2CH 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 23:3" />तिन्‍नैं सोभी किअ बिधाते भबनै झाल़अ अर तिन्‍नैं किई राज़े शोहरू जोआशा संघै करार। जहोयादा प्रोहतै बोलअ तिन्‍नां लै, “इधी आसा भाल़ा राज़ैओ शोहरू, अह हणअ म्हारअ आगलअ राज़अ ज़िहअ बिधाता आप्पै आसा बोलअ द कि दाबेदे खिंबा मांझ़ै ई हणअ एक ज़ण्हअ राज़अ।” <verse eid="2CH 23:3" /><verse number="4" style="v" sid="2CH 23:4" />तम्हैं आसा पांज़ दल, ऐबै करै तम्हैं इहअ कि ज़ेभै बशैघे धैल़ी लेबी अर प्रोहत आपणीं च़ाकरी करदै एछे, थारै चिई दला मांझ़ै एक दल रहै भबने प्रऊल़ी पहरी। <verse eid="2CH 23:4" /><verse number="5" style="v" sid="2CH 23:5" />एक दल रहै राज़े मैहलै पहरी अर एक दल डाहै राज़ मैहला पिछ़ू बाखा प्रऊल़ी सेटा पहरअ पाई। बाकी दूई दल रहै लोगा जैंदरी बिधाते भबने ताटी। <verse eid="2CH 23:5" /><verse number="6" style="v" sid="2CH 23:6" />बिधाते भबनै निं बिधाते च़ाकरी करनै आल़ै प्रोहत अर लेबी का सुआई कोही भितरा लै एछणैं दैई। तिन्‍नां दै भितरा लै एछणैं किल्हैकि तिंयां हणैं आप्पू बिधी-बधाने साबै शुचै हुऐ दै। पर बाकी सोभी लोगै लोल़ी बिधातो हुकम मनअ कि तिंयां रहे बागै। <verse eid="2CH 23:6" /><verse number="7" style="v" sid="2CH 23:7" />लेबी रहै राज़ै पहरी नेल़-नेल़ अर डाहै आप्पू का गुप्त तलबारा संघा रहै राज़ै जोआशा फेर संघा-संघा लगैग लाई हांढदै लागी। ज़ुंण भबना भितरी एछणें कोशिश करे, तेऊ पाऐ मारी।<verse eid="2CH 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 23:8" />ज़िहअ जहोयादा प्रोहतै हुकम किअ, लेबी अर होरी सोभी यहूदी किअ तिहअ ई। सैना मांझ़ै ज़ुंण दल छ़ुटी दी थिऐ, तिन्‍नें बशैघे छ़ुटी बी किई खारज अर इहअ करै ती सोभी दलपति का आपणीं सैना संघै ज़ुंण च़ाकरी लै एछणैं तै अर ज़ुंण छ़ुटी लै डेऊणैं तै, तिंयां थिऐ सोभ तिधी। <verse eid="2CH 23:8" /><verse number="9" style="v" sid="2CH 23:9" />बिधाते भबनै राज़ै दाबेदे ज़ुंण ढाल़ा अर बर्छ़ै थिऐ, तिंयां दैनै जहोयादा प्रोहतै सैने दलपति लै। <verse eid="2CH 23:9" /><verse number="10" style="v" sid="2CH 23:10" />जहोयादा बझ़ैल़ी सोभी पहरी का तलबारा गुप्त डाहणैं। तिन्‍नैं डाहअ बिधाते भबनै दखण बाखा पुंझ़ा पोर्ही उतरा बाखा पुंझ़ै तैणीं राज़ै जोआशा फेर पहरअ पाई। <verse eid="2CH 23:10" /><verse number="11" style="v" sid="2CH 23:11" />तेखअ आणअ जहोयादा प्रोहतै जोआश बागा लै संघा लाअ तेऊए मुंडै मुगट संघा दैनअ तेऊए हाथै देशा दी राज़ करने बधाने च़ुआल़ी दी कताब। तेखअ किअ तिधी तेऊए मुंडै जैतूनो तेल तरैल़ी अभिषेक कि आगलअ राज़अ आसा ऐबै अह। सोभी लोगै बाज़ी तिधी ताल़ी संघा लागै ज़ोरै-ज़ोरै इहअ बोल्दै, “राज़ै जोआशे अमर लोल़ी खास्सी हुई!”<verse eid="2CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 23:12" />राणीं अताल्या का गई पहरी अर लोगे छ़ेल़ शुण्हुंई अर सह आई तेभी बिधाते भबना लै ज़िधी खास्सै मणछ तै कठा हुऐ दै। <verse eid="2CH 23:12" /><verse number="13" style="v" sid="2CH 23:13" />तिधी भाल़अ तैहा कि नऊंअ राज़अ आसा बिधाते भबनै दूई थाम्हा मांझ़ै खल़्हुअ द, ज़िहअ तिन्‍नों रबाज़ थिअ। तेऊ फेर थिऐ कार-करिंदै अर नर्शिंगै बाज़णैं आल़ै। लोग तै खुशी मनाऊंदै अर नर्शिंगै बाज़दै लागै दै। अताल्या धेल़अ आपणअ बाघलअ सुआब संघा लागी ज़ोरै लैल़ा पाई इहअ बोल्दी, “अह आसा राज़ द्रोह! अह किअ राज़ द्रोह!”<verse eid="2CH 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 23:14" />जहोयादा प्रोहत निं अताल्या बिधाते भबना नेल़ मारनअ च़ाहंदअ त, तेऊ किअ कार-करिंदै लै हुकम, “पहरीए लगैगा मांझ़ा का काढा ऐहा पोर्ही संघा निंयां ऐहा इधा का दूर, ज़ुंण ऐहा छ़ड़ैऊंदअ पिछ़ू एछे, तेऊ पाऐ मारी।”<verse eid="2CH 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 23:15" />अताल्या निंईं तिन्‍नैं कैद करी राज़े मैहला नेल़, तिधी पाई तिन्‍नैं घोल़े प्रऊल़ी सेटा मारी।<verse eid="2CH 23:15" /></para>
  <para style="s">जहोयादा प्रोहतै खोज़अ बधान</para>
  <para style="r">(<ref loc="2KI 11:17-20">2 राज़ै 11:17-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 23:16" />जहोयादा प्रोहतै किई जोआश अर लोगे बिधाता संघै एही करार कि तिंयां लोल़ी सदा बिधाते परज़ा रही। राज़ै अर परज़ा मांझ़ै बी किई तेऊ बिधाता शाजत मनी करार कि तिंयां लोल़ी एकी-दुजै लै शुचै-पाक्‍कै रहै। <verse eid="2CH 23:16" /><verse number="17" style="v" sid="2CH 23:17" />तेखअ डेऊऐ लोग बाल देअए देहुरै संघा ढोल़अ सह पठी। बेदी अर मुहुर्ती पाई तिन्‍नैं फाल़ी अर बाल देअ प्रोहत मतान पाअ तिन्‍नैं बेदी सम्हनै मारी। <verse eid="2CH 23:17" /><verse number="18" style="v" sid="2CH 23:18" />जहोयादा प्रोहतै सभाल़अ बिधाते भबनो काम काज़ प्रोहत अर लेबी का ज़िहअ राज़ै दाबेदै सोभी लै काम बांडअ द थिअ। तिन्‍नें ज़िम्मैंबारी ती मोसा गूरे बधाने साबै बिधाता लै हूम बल़ीदान करनअ अर साज़-बाज़ा संघै गिहा बोली बिधाते स्तोती करनी। <verse eid="2CH 23:18" /><verse number="19" style="v" sid="2CH 23:19" />जहोयादा प्रोहतै डाहै बिधाते भबने प्रऊल़ी दी पहरी लाई कि ज़ुंण छ़ोतलअ होए, तेऊ बागै रोक्‍के।<verse eid="2CH 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 23:20" />तेखअ निंयं राज़अ जोआश जहोयादा प्रोहतै संघा हांढणै आल़ै सपाही, दरबारी, दलपति अर सैनापतिए पहरै दी बिधाते भबना का उंधै संघा पजैल़अ राज़े मैहलै, होर लोग आऐ तेऊ पिछ़ू। जोआश डेऊअ पहरीए प्रऊल़ी बाती मैहला भितरी संघा बेठअ राज़गाद्दी प्रैंदै। <verse eid="2CH 23:20" /><verse number="21" style="v" sid="2CH 23:21" />सोभ लोग तै तिधी खुशी हुऐ दै अर सारी नगरी दी थिई शांती हुई दी किल्हैकि अताल्या ती राज़े मैहलै मारी हेरी दी।<verse eid="2CH 23:21" /></para>
  <chapter eid="2CH 23" />
  <chapter number="24" style="c" sid="2CH 24" />
  <para style="s">यहूदा मुल्खै राज़अ जोआश</para>
  <para style="r">(<ref loc="2KI 12:1-16">2 राज़ै 12:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 24:1" />ज़धू जोआश राज़अ बणअ, तधू त सह साता सालो। तेऊ किअ एरुशलेम नगरी का च़ाल़्ही साला तैणीं राज़। तेऊए ईजा नाअं त सिबीया अर सह थिई बेर्शेबा का। <verse eid="2CH 24:1" /><verse number="2" style="v" sid="2CH 24:2" />जहोयादा प्रोहते ज़िऊंदी ज़िता किऐ जोआशै तिहै ई भलै काम ज़िहअ बिधाता च़ाहा त कि सह करे। <verse eid="2CH 24:2" /><verse number="3" style="v" sid="2CH 24:3" />जहोयादा प्रोहतै दैनी जोआशा लै दूई बेटल़ी आणी अर तिन्‍नां का हुऐ तेऊए खास्सै शोहरू अर शोहरी।<verse eid="2CH 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 24:4" />ज़ांऊं जोआशा राज़ै बणी थोल़अ बगत बित्तअ, तेऊ सोठअ बिधाते भबना मराम्मत करना लै। <verse eid="2CH 24:4" /><verse number="5" style="v" sid="2CH 24:5" />तेऊ शादै लेबी अर प्रोहत संघा किअ तिन्‍नां लै इहअ हुकम, “तम्हैं डेओआ यहूदा मुल्खै सोभी नगरी संघा करा इज़राईली का हर साल बिधाते भबने मराम्मत करना लै ढब्बै कठा। एऊ कामां लआ तम्हैं सोभी का आजी करी।” पर लेबी हुई खास्सी साला कि तिन्‍नैं निं सह काम किअ। <verse eid="2CH 24:5" /><verse number="6" style="v" sid="2CH 24:6" />तेखअ शादै राज़ै जोआशै जहोयादा माहा प्रोहत अर यहूदी सैणैं संघा बोलअ तिन्‍नां लै, “तम्हैं किल्है निं लेबी, यहूदा अर एरुशलेम नगरीए लोगा का ढब्बै कठा करदै छ़ाडै, ज़ेता लै बिधाते दास मोसा इज़राईली लै सूल आसा बणाअं द कि बिधाते खिम्भे च़ाकरी लै करै सोभ लोग च़ंदअ दैई?<verse eid="2CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 24:7" />“ऐबै आसा बिधातो भबन मराम्मत करना लै हुअ द, किल्हैकि तैहा कदुष्ट अताल्या अर तेसे साथी-संघी किअ भबन बरैबाद! बिधाते पबित्र चाण भांडै तोही निंयैं तिन्‍नैं बाल देअए पूज़ा-गाज़ा लै।”<verse eid="2CH 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 24:8" />राज़ै जोआशै किअ हुकम कि एक काठो सदूक बणाआं संघा डाहा तेऊ बिधाते भबने प्रऊल़ी आजू कि लोग तेथ च़ंदअ पाए। <verse eid="2CH 24:8" /><verse number="9" style="v" sid="2CH 24:9" />तेखअ दैनअ यहूदा अर एरुशलेम सोभी लोगा लै समाद कि बिधाता लै दैऐ सोभ च़ंदअ, ज़िहअ इज़राईली मांझ़ै परमेशरे दास मोसा मिसर देशा का एछदी रेगीस्तानै च़ंदअ कठा करी सूल बणाअं त। <verse eid="2CH 24:9" /><verse number="10" style="v" sid="2CH 24:10" />ऐहा गल्‍ला लै हुऐ सोभ लोग अर तिन्‍नें सैणैं राज्ज़ी अर तिन्‍नैं आणै सोभी ढब्बै संघा रहै सदूका दी ढब्बै पांदै लागी अर सदूक हुअ भरी। <verse eid="2CH 24:10" /><verse number="11" style="v" sid="2CH 24:11" />ज़ांऊं हर धैल़ै सदूक ढब्बै करै भर्हिया त, लेबी निंयां तै तेऊ राज़े कार-करिंदै सेटा लै। तेखअ काढा तै राज़ैओ काईथ अर माहा प्रोहते कार-करिंदै सदूका का ढब्बै पोर्ही संघा डाहा तै तेता भिई बिधाता भबना आजू तिधी। इहअ करै झाल़ै तिन्‍नैं खास्सै ढब्बै।<verse eid="2CH 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 24:12" />राज़अ जोआश अर जहोयादा प्रोहत दैआ तै तिन्‍नां ढब्बै तिन्‍नां मणछा का सभाल़ी ज़हा का बिधाते भबने मराम्मत करने ज़िम्मैंबारी हआ ती। तिन्‍नैं दैनी तिन्‍नां ढब्बै करै काठे कारीगीरे मज़दूरी, पात्थरे कारीगीर अर भित्ती च़िणनै आल़ै मिस्त्री अर पल़ैमूए मज़दूरी। <verse eid="2CH 24:12" /><verse number="13" style="v" sid="2CH 24:13" />ज़ुंण बिधाते भबने मराम्मत करने कामां तै लागै दै, तिन्‍नैं किई खास्सी मैन्थ अर तिन्‍नैं दैनअ बिधातो भबन तिहअ पाक्‍कअ बणाईं ज़िहअ सह पैहलै थिअ। <verse eid="2CH 24:13" /><verse number="14" style="v" sid="2CH 24:14" />ज़ांऊं बिधाते भबने मराम्मत करी मुक्‍कै, तेता का ज़ुंण सुन्‍नैं, च़ंदीए ढब्बै बच़ै तिंयां दैनै तिन्‍नैं राज़ै जोआशा अर जहोयादा प्रोहता का सभाल़ी। तेता करै बणाऐं तिन्‍नैं बिधाते भबना लै सुन्‍नैं-च़ंदीए कऊली अर होर भांडै।</para>
  <para style="s" vid="2CH 24:14">जहोयादा प्रोहते सूल</para>
  <para style="p" vid="2CH 24:14">जहोयादा प्रोहतै निं बिधाते भबनै हर धैल़ै हणैं आल़ै हूम अर बल़ीदानो सूल चोल़अ। <verse eid="2CH 24:14" /><verse number="15" style="v" sid="2CH 24:15" />खिरी ज़ांऊं जहोयादा खास्सअ प्रोढअ हुअ, तेखअ मूंअ सह एकी शौआ तिहा साले अमरा। <verse eid="2CH 24:15" /><verse number="16" style="v" sid="2CH 24:16" />सह डाहअ तिन्‍नैं दाबेदपूर नगरी राज़ै दाबणे ज़ैगा आदगारी लै दाबी कि तेऊ किअ परमेशर, बिधाते भबन अर सोभी इज़राईली लै भलअ।<verse eid="2CH 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 24:17" />ज़ांऊं जहोयादा प्रोहत मूंअ, यहूदा मुल्खे कार-करिंदै आऐ राज़ै जोआशा सेटा लै, तिन्‍नैं किई तेऊ संघै गल्‍ला कि तिन्‍नें सलाह मने। ज़िहअ तिंयां च़ाहा तै राज़ै किअ तिहअ ई। <verse eid="2CH 24:17" /><verse number="18" style="v" sid="2CH 24:18" />तेखअ पाई लोगै आपणैं दादा-बाबे परमेशर बिधाते भबनै पूज़ा-गाज़ा करने छ़ाड अर तिंयां लागै अशेरा देबीए मुहुर्तीए पूज़ा करदै। तिन्‍नें एऊ पापा करै पल़अ यहूदा मुल्ख अर एरुशलेम नगरी लै बिधातो कोप। <verse eid="2CH 24:18" /><verse number="19" style="v" sid="2CH 24:19" />बिधाता छ़ाडै तिन्‍नां लै चतैनगी दैंदै आपणैं गूर बी पर तिन्‍नैं किई तिन्‍नां गूरे गल्‍ला बी शूणीं नां शूणीं। <verse eid="2CH 24:19" /><verse number="20" style="v" sid="2CH 24:20" />तेखअ किई बिधाता जहोयादा प्रोहते शोहरू जकर्या दी एछी गल्‍ला। जकर्या खल़्हुअ लोगा सम्हनै उछ़टै दी संघा खोज़अ सोभी का इहअ कि बिधाता बोला, “मेरअ हुकम नांईं मनी तम्हैं किल्है लाई आप्पू लै बरैबादी आणी? तम्हैं छ़ाडअ हुंह अर ऐबै छ़ाडै मंऐं तम्हैं!” <verse eid="2CH 24:20" /><verse number="21" style="v" sid="2CH 24:21" />यहूदी सैणैं किअ आप्पू मांझ़ै जकर्या मारना लै एक्‍कअ अर राज़अ जोआश बी त तिन्‍नां संघै ज़ुल़अ द। राज़ै किअ हुकम अर संघा पाअ तिन्‍नैं सोभी सह बिधाते भबने खोल़ै पात्थरो ढो दैई मारी। <verse eid="2CH 24:21" /><verse number="22" style="v" sid="2CH 24:22" />राज़ै जोआशै निं सह गल्‍ल बी आद डाही कि जकर्यो बाब जहोयादा प्रोहत तेऊ लै किहअ शुचअ-पाक्‍कअ साथी आसा त! तेऊ बझ़ैल़अ जकर्या मारनै! मरदी-मरदी बोलअ जकर्या इहअ, “हे बिधाता, तूह भाल़ इनै मुल्है किज़ै किअ! एतो बदल़अ लऐ तूह इना सोभी का आप्पी!”<verse eid="2CH 24:22" /></para>
  <para style="s">जोआशो राज़ हुअ खतम</para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 24:23" />ज़ांऊं नऊंअ संबत आअ, अरामी सैना छ़ेल़अ यहूदा मुल्खा संघै जुध। तिन्‍नैं पाऐ यहूदा अर एरुशलेम सोभ कार-करिंदै अर सैणैं मारी संघै निंईं खास्सी धन-माया लुटी दमिश्क नगरी आपणैं राज़ै सेटा। <verse eid="2CH 24:23" /><verse number="24" style="v" sid="2CH 24:24" />अरामी लोगे ती थोल़ी ज़ेही सैना आई दी, पर बिधाता दैनअ तिन्‍नां यहूदा मुल्खे बडी सैना का ज़ितणैं। किल्हैकि यहूदा मुल्खे परज़ा हुई ती आपणैं दादा-बाबे परमेशर बिधाता का दूर। इहअ करै भेटी राज़ै जोआशा तेऊए कर्मे सज़ा।<verse eid="2CH 24:24" /></para>
  <para style="s">राज़ै जोआशे हत्या</para>
  <para style="p">
    <verse number="25-26" style="v" sid="2CH 24:25-26" />राज़अ जोआश त तेऊ जुधा दी खास्सअ ज़खमी हुअ द, ज़ांऊं अरामी सैना यहूदा मुल्खा का फिरी डेऊई, राज़ै जोआशे दूई कार-करिंदै अमोन नगरीए बेटल़ी शमातो शोहरू जाबाद अर मोआबी बेटल़ी शमेरो शोहरू जोजबाद। तिन्‍नैं दुही किअ एक्‍कअ कि एऊ मारी लणअ हाम्हां जहोयादा प्रोहते शोहरू जकर्ये हत्या करनैओ बदल़अ। जोआश त आपणैं च़ैनैं जुधा दी पल़ै दै ज़खमा का बिज़रदअ लागअ द अर तिन्‍नैं पाअ सह मारी। जोआश डाहअ दाबेदपूर दाबी पर तिधी निं सह दाबअ ज़िधी राज़ै डाहा तै दाबी। <verse eid="2CH 24:25-26" /><verse number="27" style="v" sid="2CH 24:27" />सोभी राज़े इतिहासे कताबा दी आसा, जोआश राज़े शोहरूए बारै, ज़ुंण गूरै राज़ै जोआबा लै गल्‍ला प्रगट किई, जोआशै किहअ करै बणाअं बिधातो भबन मराम्मत करी भिई, इना सोभी गल्‍ले बारै लिखअ द। तेऊओ शोहरू अमास्या बणअ तेऊ बाद यहूदा मुल्खो राज़अ।<verse eid="2CH 24:27" /></para>
  <chapter eid="2CH 24" />
  <chapter number="25" style="c" sid="2CH 25" />
  <para style="s">यहूदा मुल्खै राज़अ अमास्या</para>
  <para style="r">(<ref loc="2KI 14:2-6">2 राज़ै 14:2-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 25:1" />अमास्या ज़धू राज़अ बणअ, सह थिअ तधू पच्‍ची सालो अर तेऊ किअ एरुशलेम नगरी का उणत्ती साला तैणीं राज़। तेऊए ईजा नाअं आसा जेहोदी अर सह थिई एरुशलेम नगरी का। <verse eid="2CH 25:1" /><verse number="2" style="v" sid="2CH 25:2" />अमास्या किअ तिहअ ई ज़िहअ बिधाता च़ाहा त, पर तज़ी बी निं सह पठी शुचअ-पाक्‍कअ आथी त। <verse eid="2CH 25:2" /><verse number="3" style="v" sid="2CH 25:3" />ज़िहअ ई सह यहूदा मुल्खो राज़अ बणअ, तेऊ किऐ तिंयां कैद संघा पाऐ तिंयां मारी ज़ुंणीं तेऊओ बाब मारी पाअ त। <verse eid="2CH 25:3" /><verse number="4" style="v" sid="2CH 25:4" />पर तिन्‍नें शोहरू-माठै निं तेऊ मारै आथी। तेऊ किअ आपणैं साबै तिहअ ई ज़िहअ मोसा गूरे बधाने कताबा दी बिधाता हुकम आसा किअ द, “ज़ै कसरै शोहरू ज़ुल्म किअ होए, तेता पिछ़ू निं तेऊए ईजा-बाबा लै मौते सज़ा दैई अर नां कसरै ईजा-बाबे ज़ुल्मा पिछ़ू शोहरू लै मौते सज़ा दैई। ज़ुंण दोशी आसा, सज़ा बी लोल़ी तेऊ ई भेटी।”<verse eid="2CH 25:4" /></para>
  <para style="s">एदोमी संघै जुध</para>
  <para style="r">(<ref loc="2KI 14:7">2 राज़ै 14:7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 25:5" />राज़ै अमास्या दैनअ यहूदा अर बिन्यामीन गोत्रा लै समाद संघा शादै तिन्‍नां मांझ़ै सोभ मर्ध ज़सरी अमर बिहा साला का उझै थिई। इहअ करै डेऊऐ चअन लाख लोग राज़धानी एरुशलेम नगरी लै। तिंयां सोभ तै जुध करनै जोगी कतीर अर ढाल़ा करै जुध करना लै सज़ाण। राज़ै अमास्या बणाऐं तिन्‍नें टोलीए साबै ज़ुदै-ज़ुदै दल संघा सभाल़ै तिंयां सैनापति अर दलपति का। <verse eid="2CH 25:5" /><verse number="6" style="v" sid="2CH 25:6" />एता का लाऊआ आणै उतरा बाखा इज़राईला का एक लाख सपाही अर तेता लै दैनअ च़ाल़्ही कुंटल़ च़ंदी। <verse eid="2CH 25:6" /><verse number="7" style="v" sid="2CH 25:7" />पर बिधातो एक गूर आअ राज़ै अमास्या सेटा, तेऊ बोलअ, “एप्रैमे आद-लुआद इना इज़राईली सपाही निं आप्पू संघै जुधा लै निंईं। किल्हैकि बिधाता निं उतरा बाखा बस्सै दै इज़राईली संघै आथी!” <verse eid="2CH 25:7" /><verse number="8" style="v" sid="2CH 25:8" />तूह ता समझ़ा इहअ कि इना करै भेटणअ ताह जुधा लै होर बी बल, पर ज़ीत अर हार आसा परमेशरे हाथै। बिधाता हेरनअ तूह तेरै दुशमणा का ज़ताऊई।<verse eid="2CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 25:9" />राज़ै अमास्या पुछ़अ परमेशरो सह गूर, “इने बदल़ै ज़ुंण च़ंदी मंऐं इज़राईली लै दैई हेरी, ऐबै तेतो किज़ै हणअ?”</para>
  <para style="p" vid="2CH 25:9">गूरै बोलअ इहअ, “बिधाता हेरनअ ताल्है तेता का खास्सअ होर दैई!” <verse eid="2CH 25:9" /><verse number="10" style="v" sid="2CH 25:10" />तेखअ बोलअ अमास्या तिन्‍नां उतरा बाखा बस्सै दै एप्रैम गोत्रे इज़राईली मांझ़ै शादै दै सपाही लै कि तम्हैं डेओआ बापस फिरी। इहअ करै डेऊऐ तिंयां फिरी पर एता लै हुऐ तिंयां यहूदे लोगा लै रोश्शै लाल-पिंऊंल़ै।<verse eid="2CH 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 25:11" />तेखअ किई अमास्या हिम्मत संघा डेऊअ आपणीं सैना संघा लई जुधा लै संघा पुजअ लूंणै खागै। तेऊ जुधा दी पाऐ तिन्‍नैं दस हज़ार एदोमी सपाही मारी। <verse eid="2CH 25:11" /><verse number="12" style="v" sid="2CH 25:12" />होर दस हज़ार सपाही किऐ तिन्‍नैं यहूदी कैद संघा निंयैं उझै उछ़टै चेचा प्रैंदा लै अर तिधा का शोटै तिंयां ढेक्‍का अर तिंयां सोभ हुऐ मरी हक्‍क।<verse eid="2CH 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 25:13" />एसी ज़ुंण इज़राईली सैनो दल ज़ुंण राज़ै अमास्या आपणैं घअरा लै बापस छ़ाडै तै, तिंयां पल़ै बाता सामरी अर बेथ-हारोन मांझ़ै बस्सी दी यहूदी नगरी लै चुटी अर तेथ बस्सै दै यहूदी मांझ़ै पाऐ तिन्‍नैं चअन हज़ार मणछ मारी संघा पाई तिन्‍नें ज़ैदात लुटी।<verse eid="2CH 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 25:14" />ज़ांऊं राज़अ अमास्या एदोमी का जुध ज़िती करै बापस फिरअ, तेऊ आणै आप्पू संघै एदोमी लोगे देअए मुहुर्ती बी! तेखअ डाही तेऊ तिंयां मुहुर्ती एरुशलेम नगरी स्तापी अर तेखअ लागअ तेथ बी धूपा ज़ाल़दअ अर माथै टेक्‍कदअ! <verse eid="2CH 25:14" /><verse number="15" style="v" sid="2CH 25:15" />अमास्या राज़े एऊ कामां करै आई बिधाता तेऊ लै रोश्शै अर बिधाता छ़ाडअ तेऊ सेटा आपणअ एक गूर पुछ़दअ, “तूह किल्है आसा इना पराऐ देअआ-देबीए मुहुर्ती पूज़दअ लागअ द ज़ुंण ताखा आपणैं लोगा बी निं बच़ाऊई सकै?”<verse eid="2CH 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 25:16" />सह गूर त बोल्दअ ई लागअ द कि अमास्या बोलअ तेऊ लै इहअ, “च़ुप्पी रह, नांईं ता हुंह पाऊं ताह मारी! तूह कै हाम्हैं राज़ै लै सलाह दैणैं आल़अ बज़ीर हेरअ बणाईं?”</para>
  <para style="p" vid="2CH 25:16">सह गूर हुअ च़ुप्पी पर एतरअ लअ तेऊ तज़ी बी बोली, “एतरअ गअ मुखा ज़ाण्हुंई कि बिधाता आसा डाही दी कि तूह करनअ ऐबै बरैबाद ई! किल्हैकि एक ता किअ तंऐं पाप अर दुजअ निस्सअ तूह मेरी सलाह शूणीं।”<verse eid="2CH 25:16" /></para>
  <para style="s">इज़राईली संघै जुध</para>
  <para style="r">(<ref loc="2KI 14:8-20">2 राज़ै 14:8-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 25:17" />यहूदा मुल्खे राज़ै अमास्या किअ आपणैं कार-करिंदै संघै जोग। तेखअ दैनअ जोअहाजे शोहरू ज़ैऊए पोचै इज़राईले राज़ै जोआशा लै समाद, “ज़ै हिम्मत थिऐ कर जुधा लै मेरअ मकाबलअ!” <verse eid="2CH 25:17" /><verse number="18" style="v" sid="2CH 25:18" />इज़राईले राज़ै जोआशै दैनअ यहूदे राज़ै अमास्या लै इहअ समाद बापस, “लाबानोन बणैं झ़िंझ़रे कांडै दैनअ केल़ुई लै समाद, ‘तूह कर आपणीं केल़टीओ बैह मेरै झ़ुंभल़ू संघै।’ तेतरी डेऊअ तेस्सी बाती एक बणों ज़ीब संघा दर्ल़अ झ़िंझ़रै कांडैओ झ़ुंभल़ धरनीं! <verse eid="2CH 25:18" /><verse number="19" style="v" sid="2CH 25:19" />तूह ज़ितअ एदोमी का, तै आसा एभै तूह इहअ हुल्‍लअ-फुल्‍लअ हुअ द। तिन्‍नां डिंगा मारदी रह आपणैं घअरै बेशी। तूह किल्है आसा आप्पू लै आफ़त खल़ी करदअ लागअ द? इहअ करै हणीं तेरी अर यहूदा तेरी परज़े बरैबादी!”<verse eid="2CH 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 25:20" />पर अमास्या निस्सअ मनी, बिधाता दैनअ हणैं कि राज़अ अमास्या अर तेऊए सैना हारे किल्हैकि तिंयां थिऐ एदोमी देअआ पूज़दै लागै दै। <verse eid="2CH 25:20" /><verse number="21" style="v" sid="2CH 25:21" />तेखअ निखल़अ इज़राईलो राज़अ जोआश यहूदा बाखा लै अर यहूदे राज़ै अमास्या किअ तेऊ संघै बेथ-शमेश नगरी मकाबलअ। <verse eid="2CH 25:21" /><verse number="22" style="v" sid="2CH 25:22" />तेऊ जुधा लै हारी यहूदे सैना इज़राईला का पठी अर तिन्‍नें सारी सैना ठुर्ही आपणैं-आपणैं डेरै लै। <verse eid="2CH 25:22" /><verse number="23" style="v" sid="2CH 25:23" />इज़राईले राज़ै जोआशै किअ जोअहाजो पोचअ अर जोआशो शोहरू यहूदो राज़अ अमास्या बेथ-शमेश कैद संघा निंयं आप्पू संघै। तेखअ डेऊअ सह एरुशलेम नगरी संघा पाअ एप्रैम प्रऊल़ी पोर्ही कूणींए प्रऊल़ी तैणीं नगरी फेरो गहल़ कोई च़ार शौ हाथ ढोल़ी। <verse eid="2CH 25:23" /><verse number="24" style="v" sid="2CH 25:24" />तेऊ ज़ेतरअ बी सुन्‍नअ-च़ंदी भेटअ, बिधाते भबन अर राज़े मैहलै भढारै ज़ेतो पहरअ ओबेद-एदोमे आद-लुआद करा तै, तेथ ज़ेतरै बी सुन्‍नैं-च़ंदीए भांडै थिऐ, तिंयां निंयैं तेऊ सामरी नगरी लै अर ज़ुंण कैद किऐ, तिंयां बी निंयैं आप्पू संघा।<verse eid="2CH 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 25:25" />यहूदा मुल्खो राज़अ अमास्या रहअ इज़राईले राज़ै जोअहाजे शोहरू जोआशा मरनै बाद पंद्रा साला तैणीं ज़िऊंदअ। <verse eid="2CH 25:25" /><verse number="26" style="v" sid="2CH 25:26" />अमास्या राज़े ज़ुंण बी काम किऐ, तिंयां आसा शुरू का खिरी तैणीं यहूदा अर इज़राईल मुल्खे राज़े इतिहासे कताबा दी लिखी डाहै दै। <verse eid="2CH 25:26" /><verse number="27" style="v" sid="2CH 25:27" />ज़िहअ ई राज़अ अमास्या बिधाता लै विश्वास घात करदअ लागअ, तेखअ हुऐ एरुशलेम तेऊए कई लोग द्रोही अर सह ठुर्हअ तिधा का लकीश नगरी लै पर तेऊए दुशमण पुजै तेऊ पिछ़ू तिधी बी संघा पाअ सह मारी। <verse eid="2CH 25:27" /><verse number="28" style="v" sid="2CH 25:28" />तेऊए ल्हास आणी घोल़ै प्रैंदै यहूदा एरुशलेम नगरी लै संघा डाहअ सह दाबेदपूर राज़ै दाबणे ज़ैगा दाबी।<verse eid="2CH 25:28" /></para>
  <chapter eid="2CH 25" />
  <chapter number="26" style="c" sid="2CH 26" />
  <para style="s">यहूदा मुल्खै राज़ै उज़ियाहो राज़</para>
  <para style="r">(<ref loc="2KI 14:21">2 राज़ै 14:21</ref>,<ref loc="2KI 14:22">22</ref>; <ref loc="2KI 15:1-7">15:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 26:1" />यहूदा मुल्खे सारी परज़ा बणाअं अमास्यो सोल़ा सालो शोहरू उज़ियाह तेऊए ज़ैगा यहूदा मुल्खो राज़अ। <verse eid="2CH 26:1" /><verse number="2" style="v" sid="2CH 26:2" />आपणैं बाब राज़ै अमास्या मरनै बाद छ़ड़ैऊअ उज़ियाह एलात नगरीओ कबज़अ संघा च़िणीं सह नगरी भिई इहअ करै हुई सह नगरी भिई यहूदा मुल्खे।<verse eid="2CH 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 26:3" />ज़धू उज़ियाह राज़अ बणअ, तधू ती तेऊए अमर सोल़ा साल। तेऊ किअ एरुशलेम नगरी का यहूदा मुल्खै बुंजा साला तैणीं राज़। तेऊए ईजा नाअं त जकोल्या अर सह थिई एरुशलेम नगरी का। <verse eid="2CH 26:3" /><verse number="4" style="v" sid="2CH 26:4" />तेऊ किऐ आपणैं बाब अमास्या ज़िहै भलै काम ज़ेता करै बिधाता खुश हआ। <verse eid="2CH 26:4" /><verse number="5" style="v" sid="2CH 26:5" />जकर्या थिअ राज़ै उज़ियाहो सलाहकार अर सह करा त बिधाते बारै तेऊ लै शिक्षा दैई। जकर्ये ज़िऊंदी ज़िता किई उज़ियाह शुचअ-पाक्‍कअ रही बिधाते च़ाकरी अर बिधाता बी किअ सह सफल।<verse eid="2CH 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CH 26:6" />उज़ियाह कि पलिश्ती संघै जुध। तेऊ पाई गात, जबनेह अर अशदोद नगरी फेरे दुआली ढोल़ी संघा च़िणीं अशदोद अर पलिश्ती मुल्खै उछ़टै गहल़ा आल़ी नऊंईं नगरी। <verse eid="2CH 26:6" /><verse number="7" style="v" sid="2CH 26:7" />बिधाता किई तेऊए पलिश्ती, गूर-बाल बस्सै दै अरबी अर मुनी लोगा का ज़ितणा लै मज़त। <verse eid="2CH 26:7" /><verse number="8" style="v" sid="2CH 26:8" />अमोनी लोग बी करा तै उज़ियाह लै कारअ दैई। इहअ करै हुअ उज़ियाह खास्सअ बलबान अर सह हुअ मिसर देशा तैणीं खास्सअ मशूर।<verse eid="2CH 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 26:9" />एरुशलेम नगरी च़िणैं उज़ियाह पुंझ़े प्रऊल़ी, नाल़टी बाखा प्रऊल़ी अर तिधी बडै-बडै कोट ज़िधा का नगरीए दुआल भितरा बाखा फिरा। <verse eid="2CH 26:9" /><verse number="10" style="v" sid="2CH 26:10" />यहूदा मुल्खै रेगीस्तानी सऊंऐं मुल्खै डाहै तेऊ कोट च़िणीं अर तेथ डाही सरगे पाणीं कठा करना लै खास्सी कोफरी बणाईं। किल्हैकि तेथ ती तेऊ का खास्सी डागै-चैणें हेल़्ही। सह झ़ूरा त कृषाणी करना लै खास्सअ, तेऊ का थिऐ धारा बाखे मुल्खै खास्सै दाखे बाग ज़ेथ रज़दी-पज़दी ज़ैगा थिई। तेथ कामां करनै आल़ै तै तेऊ खास्सै बेठू डाहै दै लाई।<verse eid="2CH 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 26:11" />उज़ियाह का थिई बडी सैना तेते सोभै दल रहा हर बगत जुधा लै तैर। जेइल थिअ सैना दी काईथ अर तेऊ संघै दुजअ थिअ मासेया। तिन्‍नां प्रैंदै सैणअ आसा राज़े बज़ीरा मांझ़ै हनन्याह। <verse eid="2CH 26:11" /><verse number="12" style="v" sid="2CH 26:12" />सारी सैना दी थिऐ दूई हज़ार छ़ह शौ दलपति। <verse eid="2CH 26:12" /><verse number="13" style="v" sid="2CH 26:13" />तिन्‍नां उंधै थिई चअन लाख सात हज़ार पांज़ शौ शूरबीरे सैना ज़ुंण राज़े फाज़त करना लै दुशमणा संघै ज़बरदस्त जुध करनै आल़ै थिऐ। <verse eid="2CH 26:13" /><verse number="14" style="v" sid="2CH 26:14" />राज़ै उज़ियाह किअ सारी सैना लै ढाल़, टोप, कबच, कबाण अर फर्णैक्‍की लै पात्थरो पुगतअ इंतज़ाम। <verse eid="2CH 26:14" /><verse number="15" style="v" sid="2CH 26:15" />एरुशलेम नगरीए गहल़ा प्रैंदै कोटा दी बणाईं तेऊए ज़ाण-प्रबीण कारीगीरै एही-एही मशीना ज़ेता करै खास्सै कतीर बाही सका तै अर दुआली प्रैंदै पुंडरी अर पुंझ़ा बाखा बडै-बडै पात्थर शोटी सका तै। बिधाता किअ उज़ियाह खास्सअ बलबान अर सारै दी मशूर।<verse eid="2CH 26:15" /></para>
  <para style="s">उज़ियाह आअ घमंड</para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 26:16" />ज़ांऊं राज़अ उज़ियाह खास्सअ बलबान हुअ, सह हुअ तेखअ घमंडी अर तेता करै हुई तेऊए बरैबादी। सह हुअ इहअ शरेरअ कि सह डेऊअ एकी बारी बिधाते भबनै संघा ज़ाल़अ धूप-बेदी दी आप्पै धूप। इहअ करै चोल़अ तेऊ बिधातो बधान। <verse eid="2CH 26:16" /><verse number="17" style="v" sid="2CH 26:17" />अजर्याह प्रोहत अर तेऊ संघै बिधाते अश्शी प्रोहत बी भितरा लै ज़ुंण शूरबीर बी थिऐ। <verse eid="2CH 26:17" /><verse number="18" style="v" sid="2CH 26:18" />तिंयां लागै राज़ै रोक्‍कदै अर इहअ बोल्दै, “माहा राज़अ, उज़ियाह! अह हक निं ताल्है आथी कि तूह पबित्र ज़ैगा डेऊई बिधाता लै धूप ज़ाल़े!” एता सका सिधै तिंयां प्रोहत करी ज़ुंण हारणे आद-लुआदा मांझ़ै आसा। तूह निखल़ खास पबित्र ज़ैगा का बागै। अह किअ तंऐं पाप अर ताह निं आजू बिधाता का बर्गत भेटणीं।<verse eid="2CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 26:19" />उज़ियाह त हाथै धनैरअ ढाकअ द अर सह हुअ तिन्‍नां प्रोहता लै रोश्शै लाल-पिंऊंल़अ। सह थिअ बिधाते भबनै खास पबित्र ज़ैगा धूप बेदी सेटा खल़्हुअ द अर हेरा-हेरी निखल़ी तेऊए माथै कोहल़। <verse eid="2CH 26:19" /><verse number="20" style="v" sid="2CH 26:20" />अजर्याह माहा प्रोहत अर होरी प्रोहतै ज़ांऊं तेऊए माथै कोहल़ निखल़दी भाल़ी तिन्‍नैं काढअ सह छ़ेक्‍कै-छ़ेक्‍कै बागा लै। ज़ांऊं उज़ियाह का ज़ाण्हुंअ कि बिधाता दैनी तेऊ लै सज़ा! तेऊ त आप्पू बी बागै निखल़णेंओ छ़ेक्‍कअ लागअ द।<verse eid="2CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 26:21" />उज़ियाह रही सह कोहल़ तधा पोर्ही सारी अमरा अर सह निं बिधाते भबनै एछी सकदअ त किल्हैकि सह थिअ बधाने साबै छ़ोतलअ। सह रहा त आपणैं मैहला भितरी अर यहूदा मुल्खो सारअ राज़-काज़ सभाल़ा त पठी तेऊओ शोहरू जताम।<verse eid="2CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 26:22" />राज़ै उज़ियाह आपणैं राज़ा दी ज़िहै बी काम किऐ, तिंयां सोभै गल्‍ला आसा आमोसे शोहरू ईशायाह गूरै लिखी डाही दी। <verse eid="2CH 26:22" /><verse number="23" style="v" sid="2CH 26:23" />ज़ांऊं उज़ियाह मूंअ, सह डाहअ दाबेदपूर नगरी दाबी। सह निं तिधी दाबअ ज़िधी राज़ै दाबा तै किल्हैकि तेऊ ती कोहल़ निखल़ी दी। तेऊए ज़ैगा बणअ आजू तेऊओ शोहरू जताम यहूदा मुल्खो राज़अ।<verse eid="2CH 26:23" /></para>
  <chapter eid="2CH 26" />
  <chapter number="27" style="c" sid="2CH 27" />
  <para style="s">यहूदा मुल्खै जताम राज़अ</para>
  <para style="r">(<ref loc="2KI 15:32-38">2 राज़ै 15:32-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 27:1" />ज़धू जताम यहूदा मुल्खो राज़अ बणअ, तधू त सह पच्‍ची सालो। तेऊ किअ एरुशलेम नगरी का सोल़ा साला तैणीं राज़। तेऊए ईजा नाअं त जेरूशा अर सह थिई सदोके शोहरी। <verse eid="2CH 27:1" /><verse number="2" style="v" sid="2CH 27:2" />तेऊ किअ आपणैं बाब उज़ियाह ज़िहअ भलअ ज़ेता करै बिधाता खुश हआ। पर आपणैं बाब उज़ियाह ज़िहअ बिधाते भबनै पबित्र ज़ैगा डेऊई धूप ज़ाल़णै ज़िहअ पाप निं तेऊ किअ। पर हाँ लोग रहै तेऊए राज़ा दी पाप करदै लागी।<verse eid="2CH 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 27:3" />बिधाते भबनै उतर दिशा बाखे प्रऊल़ बणाईं राज़ै जतामै अर ओपेल धारा नेल़ एरुशलेम नगरीए दुआलीए मराम्मत बी किई तेऊ। <verse eid="2CH 27:3" /><verse number="4" style="v" sid="2CH 27:4" />यहूदा धारा बाखे मुल्खै बसाऊई तेऊ नऊंईं नगरी अर उंधै रेगीस्ताना बाखा डाहै तेऊ गहल़-कोट च़िणीं। <verse eid="2CH 27:4" /><verse number="5" style="v" sid="2CH 27:5" />राज़ै जतामै किअ अमोनी राज़ै संघै जुध संघा ज़ितअ बी। तेखअ पल़ी ती अमनोनी लोगा यहूदा मुल्खे राज़ै लै चिई साला तैणीं हर साल च़ाल़्ही-च़ाल़्ही कुंटल़ च़ंदी, दस-दस हज़ार कुंटल़ कणक अर दस-दस हज़ार कुंटल़ ज़ौ सांठ दैणीं। <verse eid="2CH 27:5" /><verse number="6" style="v" sid="2CH 27:6" />जताम रहअ परमेशर बिधाता लै शुचअ-पाक्‍कअ अर सह हुअ खास्सअ बलबान राज़अ। <verse eid="2CH 27:6" /><verse number="7" style="v" sid="2CH 27:7" />ज़िहअ बी राज़ै जतामै किअ, तेऊ ज़ेतरै जुध किऐ, तिंयां सोभै गल्‍ला आसा यहूदा अर इज़राईल मुल्खे राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="2CH 27:7" /><verse number="8" style="v" sid="2CH 27:8" />ज़धू जताम यहूदा मुल्खो राज़अ बणअ, तधू त सह पच्‍ची सालो। तेऊ किअ एरुशलेम नगरी का सोल़ा साला तैणीं राज़। <verse eid="2CH 27:8" /><verse number="9" style="v" sid="2CH 27:9" />ज़ांऊं जताम मूंअ, सह डाहअ दाबेदपूर गहल़ै राज़ै दाबणे मल्थाना दी दाबी अर तेऊओ शोहरू अहाज बणअ तेऊए ज़ैगा यहूदा मुल्खो राज़अ।<verse eid="2CH 27:9" /></para>
  <chapter eid="2CH 27" />
  <chapter number="28" style="c" sid="2CH 28" />
  <para style="s">यहूदा दी राज़अ अहाज</para>
  <para style="r">(<ref loc="2KI 16:1-4">2 राज़ै 16:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 28:1" />ज़धू अहाज राज़अ बणअ, तधू ती तेऊए अमर बिहा साले, तेऊ किअ एरुशलेम नगरी का यहूदा दी सोल़ा साला तैणीं राज़। तेऊ निं आपणैं दाद-बाब दाबेदा ज़िहअ भलअ किअ, पर तेऊ किअ तेता का उंबल़अ ज़ेता का बिधाता नफरत करा। <verse eid="2CH 28:1" /><verse number="2" style="v" sid="2CH 28:2" />तेऊ ढाकी इज़राईले कई राज़ै ज़ेही बात। तेऊ बणाईं पूज़णा लै बाल देअए मुहुर्ती! <verse eid="2CH 28:2" /><verse number="3" style="v" sid="2CH 28:3" />तेऊ किऐ हिनोम खागै बाल देअआ लै हूम अर बल़ीदान। होर ता होर, तेऊ किअ आपणअ सक्‍कअ शोहरू बी होरी देअए गान-स्ताना दी हूम बल़ीदान! तेऊ मनै तिन्‍नां लोगे च़िल़्हखरै रबाज़ ज़ुंण लोग बिधाता तेऊ देशै इज़राईली पुजणैं का आजी दूर काढै तै। <verse eid="2CH 28:3" /><verse number="4" style="v" sid="2CH 28:4" />अहाज राज़ै किऐ उछ़टी धारा प्रैंदै देहुरै, ज़ोता अर कई बडै-बडै बूटा गोधै बल़ीदान अर धूप ज़ाल़ी पूज़ा।<verse eid="2CH 28:4" /></para>
  <para style="s">इज़राईल अर अराम देशो जुध</para>
  <para style="r">(<ref loc="2KI 16:5">2 राज़ै 16:5</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 28:5" />तैही दैनअ परमेशर बिधाता राज़ै आहाज़ा अराम देशे राज़ै का जुध हारनै, संघा निंयं सह अर खास्सै इज़राईली कैद करी दमिश्क नगरी लै। इज़राईली सैना का बी हारअ अहाज अर तेऊए पाई खास्सी सैना मारी। <verse eid="2CH 28:5" /><verse number="6" style="v" sid="2CH 28:6" />इज़राईल मुल्खे राज़ै रेमले शोहरू पेका मारै यहूदी सैना मांझ़ै एक लाख बिह हज़ार सज़ाण जोधै ज़ुंण जुधा लै मशूर आसा तै! किल्हैकि तिंयां हुऐ तै आपणैं दादा-बाबे परमेशर बिधाता का दूर। <verse eid="2CH 28:6" /><verse number="7" style="v" sid="2CH 28:7" />इज़राईली सैना मांझ़ै त एप्रैम गोत्रा का एक ज़िक्री नाओं जोधअ, तेऊ पाअ अहाज राज़ैओ शोहरू मासेया मारी, राज़ दरबारो सैणअ अज्रीकाम बी पाअ मारी अर एलकाना ज़ुंण राज़ैओ प्रधान बज़ीर थिअ, सह बी पाअ मारी। <verse eid="2CH 28:7" /><verse number="8" style="v" sid="2CH 28:8" />यहूदी थिऐ इज़राईलीए आपणैं ई भाई-बंध पर तज़ी निंयैं इज़राईली सैना दूई लाख यहूदी बेटल़ी अर शोहरू-माठै कैद करी अर तिन्‍नां संघै निंईं खास्सी ज़ैदात लुटी आपणीं राज़धानी सामरी नगरी लै।<verse eid="2CH 28:8" /></para>
  <para style="s">ओदेद गूर</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 28:9" />इज़राईल मुल्खै थिअ ओदेद नाओं बिधातो एक गूर। सह रहा त सामरी नगरी। यहूदी मांझ़ै खास्सै कैदी संघा लई ती इज़राईली सैना बापस एछदी लागी दी, तेऊ गूरा भेटै तिंयां नगरी बागै अर तेऊ बोलअ तिन्‍नां लै, “थारै दादा-बाबे परमेशर बिधाता ती यहूदी लै खास्सी रोश्शै आई दी, तैही हारै तम्हां का तिंयां जुध। पर तम्हैं निखल़ै तिन्‍नां का बी आजू! तम्हैं ज़िहै नर्दैई हई तिंयां काटै-फणाटै, सह बी हेरअ स्वर्गै बिधाता भाल़ी। <verse eid="2CH 28:9" /><verse number="10" style="v" sid="2CH 28:10" />तम्हैं उझ़ुऐ ऐबै यहूदा अर एरुशलेम नगरीए मर्ध-बेटल़ी गलाम बणाऊंदै! तम्हैं इहअ बी ज़ाणा कि एतो लागणअ तम्हां आपणैं परमेशर बिधाता का दोश? <verse eid="2CH 28:10" /><verse number="11" style="v" sid="2CH 28:11" />ज़ै तम्हां मेरी सलाह शुणनी, तै करा इहअ कि इना सोभी कैदी दैआ घअरा लै बापस डेऊणैं। ईंयां आसा थारै ई भाई-बंध। नांईं ता तम्हैं हणैं बिधाते रोश्शा करै बरैबाद।”<verse eid="2CH 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 28:12" />तेतरी गऐ तिधी एप्रैम गोत्रा का च़ार इज़राईली सैणैं एछी। तिंयां थिऐ जहोहनानो शोहरू अजर्याह, बरेक्याहो शोहरू मशीलमोत, शलूमो शोहरू जहिजकिया अर हदलाईओ शोहरू अमासा। तिन्‍नैं बी दैनअ ओदेद गूरो साथ कि इज़राईली सैना किअ अह काम गलत। <verse eid="2CH 28:12" /><verse number="13" style="v" sid="2CH 28:13" />तिन्‍नैं बोलअ इहअ, “इना कैदी निं सामरी नगरी भितरी आणी! एक गलती करी गऐ हाम्हैं पैहलै ई बिधाते दोशी हई! एता का आजू हणअ हेरे नर्थ, बिधाता गअ दा इज़राईली लै पैहलै ई कोप एछी, ऐबै निं पाप बढेरदै लागा।” <verse eid="2CH 28:13" /><verse number="14" style="v" sid="2CH 28:14" />इज़राईली सैना छ़ाडै तिंयां यहूदा का आणै दै कैदी इज़राईली सैणैं अर सोभी लोगा नदरी पोर्ही। तिन्‍नां का ज़ुंण लुटी आणअ त, सह बी दैनअ तिन्‍नां लै बापस। <verse eid="2CH 28:14" /><verse number="15" style="v" sid="2CH 28:15" />तिन्‍नैं इज़राईली च़ऊ सैणैं दैनै तिन्‍नां कैदी लै लुटै दै समाना मांझ़ै घेरी बान्हणां लै झिकल़ै, खूरा लै पोलल़ै बन्हैऊंईं। संघा खैऊई तिन्‍नां सोभी लै रोटी-पाणीं, ज़ुंण ज़खमी थिऐ, तिन्‍नें ज़खमा दी लाअ जैतूनो तेल। ज़सरै हांढुई निस्सअ त, तिंयां बशैल़ै गाधै प्रैंदै संघा पजैल़ै सोभ कैदी यहूदा मुल्खै खज़ूरे नगरी जेरिहो। संघा डेऊऐ उतरा बाखे इज़राईली राज़धानी सामरी लै फिरी।<verse eid="2CH 28:15" /></para>
  <para style="s">अहाज राज़ै मांगी अश्शूर देशे राज़ै का मज़त</para>
  <para style="r">(<ref loc="2KI 16:7-9">2 राज़ै 16:7-9</ref>)</para>
  <para style="p">
    <verse number="16-17" style="v" sid="2CH 28:16-17" />एदोमी छ़ेल़अ यहूदा मुल्खै पुर्बा बाखा जुध संघा निंयैं खास्सै यहूदी कैद करी। तेखअ दैनअ अहाज राज़ै अश्शूर देशे राज़ै तिगला-पेल़सरा लै समाद कि सह तेऊए मज़त करे। <verse eid="2CH 28:16-17" /><verse number="18" style="v" sid="2CH 28:18" />तिन्‍नां ई धैल़ै पल़ै पलिश्ती यहूदा मुल्खै दखणा बाखा चुटी। तिन्‍नैं किअ बेथ-शमेश, अजालोन, गदरोत, सोको, तिम्ना, गिमजो नगरी अर तिन्‍नां सोभी नगरी ओरी-पोरी सारै गराऊंऐं कबज़अ संघा बस्सै आप्पू तेथ। <verse eid="2CH 28:18" /><verse number="19" style="v" sid="2CH 28:19" />बिधाता दैनी इज़राईले राज़ै अहाजा पिछ़ू यहूदा मुल्खा लै एही आफ़त पल़णै किल्हैकि तेऊ किअ बिधाता लै विश्वास घात अर नां तेऊ यहूदा मुल्खे परज़ा पाप करनै का रोक्‍की। <verse eid="2CH 28:19" /><verse number="20" style="v" sid="2CH 28:20" />अश्शूर देशो राज़ै तिगला-पेल़सरै पाई अहाज राज़ै लै होर बी आफ़त मज़त करनी ता दूरे गल्‍ल। <verse eid="2CH 28:20" /><verse number="21" style="v" sid="2CH 28:21" />अहाज राज़ै काढअ बिधाते भबना अर राज़े मैहले भढारा, परज़ा प्रैंदै सैणें घअरा का सुन्‍नअ-च़ंदी संघा दैनअ अश्शूर देशे राज़ै लै भैंट। तज़ी बी निं तिगला-पेल़सरै तेऊए मज़त किई।<verse eid="2CH 28:21" /></para>
  <para style="s">अहाज राज़े पाप</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 28:22" />अहाज राज़ै लै रही आफ़ता प्रैंदै आफ़त पल़दी लागी पर सह रहअ तज़ी बी बिधाता लै होर बी खास्सअ पाप करदअ लागी। <verse eid="2CH 28:22" /><verse number="23" style="v" sid="2CH 28:23" />सह रहअ अरामी देशे दमिश्क नगरीए देअआ लै बल़ीदान करदअ लागी ज़ुंणीं सह हारअ त। अहाज सोठा त इहअ, “अरामी देशे देअऐ दैनअ तिन्‍नें राज़ै जुध ज़ितणा लै साथ। ज़ै हुंह तिन्‍नें देअआ लै पज़ाया दैए, तै हेरनअ तिन्‍नें देअआ मेरअ साथ बी दैई।” पर तेता करै हुई राज़ै अहाज अर सोभी इज़राईलीए बरैबादी ई। <verse eid="2CH 28:23" /><verse number="24" style="v" sid="2CH 28:24" />एतरअ ता हुअ, अहाज राज़ै किऐ बिधाते भबने चाण भांडै कठा संघा पाऐ चोल़ी-फाल़ी तेते ठोर-ठोर। तेऊ किई बिधाते भबने प्रऊल़ी बंद संघा बणाईं एरुशलेम ज़ैगै-ज़ैगै बेदी। <verse eid="2CH 28:24" /><verse number="25" style="v" sid="2CH 28:25" />यहूदा मुल्खै बणाऐं तेऊ सोभी नगरी अर गराऊंऐं पराऐ देबतै पूज़णा लै गान-स्तान। तेथ करा तै सोभ धूप ज़ाल़ी। इहअ करै ठैऊई तेऊ आपणैं दादा-बाबे परमेशर बिधाता लै रोश्शै।<verse eid="2CH 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 28:26" />अहाज राज़े राज़ा दी होर बी ज़िहै-ज़िहै काम हुऐ, तिंयां आसा शुरू का खिरी तैणीं यहूदा अर इज़राईल मुल्खे राज़े इतिहासे कताबा दी लिखै दै। <verse eid="2CH 28:26" /><verse number="27" style="v" sid="2CH 28:27" />ज़ांऊं राज़अ अहाज मूंअ, सह डाहअ एरुशलेम नगरी दाबी। पर इज़राईलीए राज़ै दाबणे मल्थाना दी निं सह दाबअ। तेऊ बाद बणअ तेऊओ शोहरू हिजकिया यहूदा मुल्खो राज़अ।<verse eid="2CH 28:27" /></para>
  <chapter eid="2CH 28" />
  <chapter number="29" style="c" sid="2CH 29" />
  <para style="s">यहूदा मुल्खै राज़अ हिजकिया</para>
  <para style="r">(<ref loc="2KI 18:1-3">2 राज़ै 18:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 29:1" />ज़धू हिजकिया राज़अ बणअ, तधू ती तेऊए अमर पच्‍ची साले। तेऊ किअ एरुशलेम नगरी का उणत्ती साला तैणीं इज़राईला दी राज़। तेऊए ईजा नाअं त अबियाह अर सह थिई जकर्ये शोहरी। <verse eid="2CH 29:1" /><verse number="2" style="v" sid="2CH 29:2" />हिजकिया किअ आपणैं दाद-बाब दाबेदा ज़िहअ ई भलअ ज़ेता लै बिधाता खुश हआ।<verse eid="2CH 29:2" /></para>
  <para style="s">बिधाते भबने शुधी</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 29:3" />ज़ांऊं हिजकिया राज़अ बणअ, पैहली ई साला खोल्ही तेऊ बिधाते भबने प्रऊल़ संघा किई तेते मराम्मत। <verse eid="2CH 29:3" /><verse number="4" style="v" sid="2CH 29:4" />तेऊ किअ बिधाते भबने पुर्बा बाखा ताटी लेबी अर प्रोहतो झाल़अ। <verse eid="2CH 29:4" /><verse number="5" style="v" sid="2CH 29:5" />तिधी किई तेऊ तिन्‍नां संघै गल्‍ला, “तम्हैं लेबी हआ आप्पू च़ांगै-च़ोखै संघा करा आपणैं दादा-बाबे परमेशर बिधाते भबने शुधी।” ज़ुंण बी बिधाते भबनै छ़ोतली च़िज़ा आसा पाई दी, तिन्‍नां काढा पोर्ही। <verse eid="2CH 29:5" /><verse number="6" style="v" sid="2CH 29:6" />म्हारै दादा-बाबा मांझ़ै निं कई बिधाता लै शुचै-पाक्‍कै रहै अर तिन्‍नैं किअ तिहअ काम ज़ेता का बिधाता नफरत करा। तिन्‍नैं छ़ाडअ बिधाता मनणअ अर तिन्‍नैं किअ बिधातो भबन पठी नकदरअ। <verse eid="2CH 29:6" /><verse number="7" style="v" sid="2CH 29:7" />तिन्‍नैं डाही बिधाते भबने प्रऊल़ी बी हूल़ी, सदीऐ पाऐ शेऊई, खास पबित्र ज़ैगा छ़ाडअ तिन्‍नैं धूप ज़ाल़णअ अर इज़राईले परमेशर बिधाता लै बल़ीदान अर हूम करने बी पाई तिन्‍नैं छ़ाड़। <verse eid="2CH 29:7" /><verse number="8" style="v" sid="2CH 29:8" />तैही पल़अ यहूदा अर एरुशलेम नगरी लै बिधातो कोप। तेता पिछ़ू बिधाता ज़ेही सज़ा दैनी तेता भाल़ी छ़ुटअ सोभी दर्छ़णअ अर सोभ आसा हक्‍कै-बक्‍कै हुऐ दै। इना सोभी गल्‍ला आसा तम्हैं सोभै आपणीं आछी भाल़ै लागै दै। <verse eid="2CH 29:8" /><verse number="9" style="v" sid="2CH 29:9" />तैही पाऐ म्हारै बाब जुधा दी मारी अर म्हारै बेटल़ी-माठै निंयैं कैद करी गलामी लै!<verse eid="2CH 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 29:10" />“ऐबै आसा मंऐं आपणैं दिलै एही डाही दी कि मुंह करनी इज़राईले परमेशर बिधाता संघै करार कि ऐबै निं हाम्हां लै तेऊओ कोप लोल़ी पल़अ।” <verse eid="2CH 29:10" /><verse number="11" style="v" sid="2CH 29:11" />मेरै साथीओ, मेरै शोहरूओ, ऐबै निं बल़ैघदै लागा, तम्हैं आसा तिंयां प्रोहत ज़ुंण बिधाता आसा छ़ांटै दै कि तेऊ सेटा धूप ज़ाल़े अर सारी परज़ा का बिधाते स्तोती कराओए अर तेऊ लै भैंट च़ढाऊए।<verse eid="2CH 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 29:12" />ज़ांऊं राज़अ हिजकिया इना गल्‍ला करी मुक्‍कअ, तिधी सोभ लेबी उझ़ुऐ संघा सभाल़अ आपणअ-आपणअ काम। ज़ुंण लेबी तिधी थिऐ, तिंयां थिऐ ईंयां:</para>
  <para style="li" vid="2CH 29:12">कहात टोली का थिऐ अमासो शोहरू महात, अजर्याहो शोहरू जोएल।</para>
  <para style="li" vid="2CH 29:12">मरारी टोली का थिऐ अबदीओ शोहरू कीश अर जहलेलो शोहरू अजर्याह।</para>
  <para style="li1" vid="2CH 29:12">गर्शोनी टोली का थिऐ जिम्मो शोहरू जोआह अर जोआहो शोहरू एदेन।<verse eid="2CH 29:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="2CH 29:13" />एलीसापाने लुआदा मांझ़ै थिऐ शिम्री अर जेइल।</para>
  <para style="li1" vid="2CH 29:13">असापे लुआदा मांझ़ै आसा तै: जकर्या अर मतानियाह।<verse eid="2CH 29:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="2CH 29:14" />हमाने लुआदा मांझ़ै थिऐ जेहीएल अर शिमी।</para>
  <para style="li1" vid="2CH 29:14">जदूतूने लुआदा मांझ़ै थिऐ शमयाह अर उज्जीएल।<verse eid="2CH 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 29:15" />इनै झाल़ै आपणैं सोभ लेबी भाई-बंध संघा हुऐ आप्पू सोभ ज़ण्हैं च़ांगै-च़ोखै। तेखअ लागै तिंयां बिधाते भबने शुधी करदै ज़िहअ राज़ै तिन्‍नां लै हुकम किअ त। तिंयां लागै बिधाते बिधी-बधानो धैन डाही तिन्‍नें कामां करदै। <verse eid="2CH 29:15" /><verse number="16" style="v" sid="2CH 29:16" />प्रोहत डेऊऐ खास पबित्र ज़ैगा संघा किई तेथ सारै धोई-शोई शुधी। ज़ुंण बी तेथ छ़ोतली च़िज़ा थिई, तिंयां काढी तिन्‍नैं बिधाते भबना बागै खोल़ै लै अर तिधा का च़की होरी लेबी संघा डाही नगरी बागै किद्रोन नाल़ै शोटी।<verse eid="2CH 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 29:17" />साज़ै च़ैत्रै नऊंऐं संबता पोर्ही किअ तिन्‍नैं बिधाते भबने धोणैं-शोणैओ काम शुरू अर बिधाते भबना फेर ताटी दी लागै तिन्‍नां आठ धैल़ै। तेखअ किई तिन्‍नैं बिधाते भबने शुधी अर तेथ लागै आठ धैल़ै होर अर इहअ करै मुक्‍कै तिंयां सोल़ा च़ैत्रै बिधाते भबना धोई-शोई।<verse eid="2CH 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 29:18" />तेखअ डेऊऐ तिंयां हिजकिया राज़ै सेटा संघा खोज़अ, “माहा राज़अ, हाम्हैं हेरअ आपणअ काम पूरअ करी। ऐबै हेरी हाम्हैं बिधाते भबनै सारै दी शुधी करी, हूम करने बेदी, भोज़ना डाहणेंओ मेज़ बगैरा सारै चाण-भांडै हेरै हाम्हैं धोई-शोई।” <verse eid="2CH 29:18" /><verse number="19" style="v" sid="2CH 29:19" />ज़ुंण चाण-भांडै अहाज राज़ै आपणैं राज़ा दी विश्वास घात करी बिधाते भबना का पोर्ही शोटै तै, तिंयां बी डाहै हाम्हैं धोई-शोई बेदी सेटा झाल़ी।<verse eid="2CH 29:19" /></para>
  <para style="s">बिधाते भबने पूज़</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 29:20" />दुजै धैल़ै दोत्ती-दोत्थी किऐ राज़ै हिजकिया नगरीए सोभ कार-करिंदै कठा संघा डेऊऐ तिंयां बिधाते भबना लै। <verse eid="2CH 29:20" /><verse number="21" style="v" sid="2CH 29:21" />तिन्‍नैं निंयैं आप्पू संघै सात बल्द, सात रिठ, सात होछ़ै गाभू हूम बल़ीदान करना लै अर सात निंयैं बाकरी मांझ़ा का बाकरै राज़ै अर यहूदा मुल्खे लोगे पाप माफी लै पाप बल़ीदान करना लै। ज़ुंण हारणे खिंबा का प्रोहत थिऐ, राज़ै किअ तिन्‍नां लै हुकम कि तिंयां सोभी पशू बल़ीदान करी बिधाते बेदी दी हूम करे। <verse eid="2CH 29:21" /><verse number="22" style="v" sid="2CH 29:22" />तिन्‍नैं काटै तिंयां बल्द संघा छ़ल़िकअ तेतो लोहू बेदी दी। तेखअ काटै तिन्‍नैं रिठ संघा छ़ल़िकअ प्रोहतै तेतो लोहू बेदी दी अर खिरी काटै तिन्‍नैं तिंयां होछ़ै गाभू अर तिन्‍नों लोहू बी छ़ल़िकअ बेदी दी। <verse eid="2CH 29:22" /><verse number="23" style="v" sid="2CH 29:23" />तेखअ आणै पाप बल़ी लै बाकरै राज़ै अर सोभी लोगा नेल़ तिन्‍नैं सोभी लाऐ आपणैं हाथ तिन्‍नां दी। <verse eid="2CH 29:23" /><verse number="24" style="v" sid="2CH 29:24" />तेखअ काटै प्रोहतै तिंयां बाकरै पाप बल़ी लै संघा छ़ल़िकअ तिन्‍नों लोहू बेदी दी ताकि सारै इज़राईलीए पापो प्राश्त होए। किल्हैकि राज़ै किअ त हुकम कि सोभी इज़राईली लै करै हूम बल़ीदान अर पाप माफी लै बल़ीदान।<verse eid="2CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 29:25" />तेखअ सभाल़ै राज़ै हिजकिया सोभी लेबी लै बिधाते भबनै तिन्‍नें आपणैं-आपणैं काम। तेऊ दैनी छ़छ़ाल़ा, बींन, नर्शिंगै अर होर साज़-बाज़ राज़ै दाबेदे गूर गाद अर नाताना का सभाल़ी। ज़िहअ बिधाता हुकम त किअ द। <verse eid="2CH 29:25" /><verse number="26" style="v" sid="2CH 29:26" />तेखअ खल़्हुऐ लेबी राज़ै दाबेदै बणाऐं दै तिन्‍नां सोभी साज़-बाज़ च़की अर प्रोहत खल़्हुऐ नर्शिंगै च़की। <verse eid="2CH 29:26" /><verse number="27" style="v" sid="2CH 29:27" />तेखअ किअ राज़ै हिजकिया हुकम कि बल़ी किऐ दै पशू बेदी दी हूम करे। ज़ांऊं बेदी दी हूम शुरू हुअ। प्रोहत लागै बिधाते गिहा बोल्दै, नर्शिंगै बाज़दै अर इज़राईल मुल्खे राज़ै दाबेदै बणाऐं दै तिन्‍नां साज़-बाज़ा बाज़दै। <verse eid="2CH 29:27" /><verse number="28" style="v" sid="2CH 29:28" />तिधी आऐ दै सोभी लोगै किई बिधाते स्तोती अर सोभ रहै नर्शिंगै, गाज़ै-बाज़ै संघै गिहा बोल्दै लागी ज़ेभै तैणीं हूम करी निं मुक्‍कै। <verse eid="2CH 29:28" /><verse number="29" style="v" sid="2CH 29:29" />ज़ांऊं हूम करी मुक्‍कै तेखअ टेक्‍कअ राज़ै अर सोभी लोगै धरनीं उटी बाखा माथअ। <verse eid="2CH 29:29" /><verse number="30" style="v" sid="2CH 29:30" />तेखअ किअ राज़ै हिजकिया अर राज़े कार-करिंदै लेबी लै हुकम कि राज़ै दाबेद अर असाप गूरै लिखै दै भज़ना बोली करा बिधाते स्तोती। सोभी टेक्‍कअ धरनीं उटै पल़ी बिधाता सेटा माथअ संघा लागै सोभै खुशी-खुशी गिहा बोली बिधाते स्तोती करदै।<verse eid="2CH 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2CH 29:31" />तेखअ बोलअ राज़ै हिजकिया सोभी लोगा लै, “ऐबै हुऐ तम्हैं सोभै बिधाता लै शुचै, ऐबै आणा ओर्ही बिधाता लै मेल़-ज़ोल़ अर शूकर करनैओ बल़ीदान।”</para>
  <para style="p" vid="2CH 29:31">तेखअ आणै परज़ा मांझ़ै बिधातो शूकर करना लै बल़ीदान अर ज़ुंण दैई सका तै तिन्‍नैं दैनै तत्त-दिला का बिधाता लै हूम बल़ीदान बी। <verse eid="2CH 29:31" /><verse number="32" style="v" sid="2CH 29:32" />आम लोगा मांझ़ै आणै बिधाता लै सत्तर बल्द, एक शौ रिठ अर दूई शौ होछ़ै गाभू हूम बल़ीदान करना लै। <verse eid="2CH 29:32" /><verse number="33" style="v" sid="2CH 29:33" />होर आणै छ़ह शौ बल्द अर चअन हज़ार भेडा-बाकरीए हेल़्ह ज़ुंण आम लोगै बिधाता बर्गत मांगणा लै बांधअ तै डाहै दै। <verse eid="2CH 29:33" /><verse number="34" style="v" sid="2CH 29:34" />तिधी तै प्रोहत बेघै थोल़ै कि तिन्‍नां निस्सअ हूम बल़ीदान करना लै पशूए खाला बी काढी सकै, किल्हैकि कई प्रोहता निं आपणीं शुधी करनैओ बगत भेटअ त। तेखअ आऐ तिन्‍नें मज़ती लै होर लेबी ज़ुंण आपणीं शुधी करी शुचै तै हुऐ दै, तिन्‍नैं किई तिन्‍नें मज़त ज़ांऊं तैणीं सारअ काम निं छ़ेक्‍कअ। लेबी डाहा तै प्रोहत च़ांगै-च़ोखै रहणा लै प्रोहता का बी खास्सअ धैन। <verse eid="2CH 29:34" /><verse number="35" style="v" sid="2CH 29:35" />हूम बल़ीदाने पशू पठी हूम करनै का लाऊआ लागा ती प्रोहता होरी बल़ीदाना का बिधाता लै भैंट किई दी च़र्बी बी हूम करनी, हर हूम बल़ीदाना संघै लागा त दाखे रसो अर्घअ दैणअ।</para>
  <para style="p" vid="2CH 29:35">इहअ करै हुई बिधाते भबनै भिई पूज़ा-गाज़ा शुरू। <verse eid="2CH 29:35" /><verse number="36" style="v" sid="2CH 29:36" />राज़अ हिजकिया अर यहूदा मुल्खे सारी परज़ा ती खास्सी खुश हुई दी। किल्हैकि ज़ुंण काम तिन्‍नैं करनअ सोठअ त सह किअ बिधाता हेरा-हेरी पूरअ।<verse eid="2CH 29:36" /></para>
  <chapter eid="2CH 29" />
  <chapter number="30" style="c" sid="2CH 30" />
  <para style="s">राज़ै हिजकिया किई ऊवार्णे थैर मनाऊंणे तैरी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 30:1" />राज़ै हिजकिया दैनअ इज़राईल अर यहूदा मुल्खै सोभी लै समाद, एप्रैम अर मनिश्शे गोत्रा लै बी दैनअ तेऊ च़िठी लिखी समाद। तेऊ किअ सोभी लै छ़ांदअ कि राज़धानी एरुशलेम मनाऊंणअ इज़राईले परमेशर बिधाता लै ऊवार्णैओ थैर, तेता लै लोल़ी सोभै आऐ। <verse eid="2CH 30:1" /><verse number="2" style="v" sid="2CH 30:2" />राज़ै अर कार-करिंदै किई आप्पू मांझ़ै सट-सलाह कि ऐहा बारी मनाऊंणअ हाम्हां ऊवार्णैओ थैर बशाहै। <verse eid="2CH 30:2" /><verse number="3" style="v" sid="2CH 30:3" />एही ता मनाऊंआं तै ऊवार्णैओ थैर च़ैत्रै पर अज़ी ती कई प्रोहते शुधी हणीं बाकी अर सारै का होर लोग बी निं एरुशलेम अज़ी पुजै तै। <verse eid="2CH 30:3" /><verse number="4" style="v" sid="2CH 30:4" />तेखअ हुऐ ऐहा गल्‍ला लै राज़अ अर सारी सभा दी सोभ राज्ज़ी कि ऊवार्णैओ थैर मनाऊंणअ बशाहै। <verse eid="2CH 30:4" /><verse number="5" style="v" sid="2CH 30:5" />तेखअ पजैल़अ तिन्‍नैं दखण बेर्शेबा उझै उतर दान तैणीं सोभी इज़राईली सेटा समाद कि सोभै लोल़ी बधाने साबै आपणैं परमेशर बिधाते ऊवार्णे थैरा मनाऊंदै एरुशलेम आऐ। तधू आऐ तेऊ थैरा लै एतरै खास्सै मणछ कि तेतरै निं कधि आऐ तै। <verse eid="2CH 30:5" /><verse number="6" style="v" sid="2CH 30:6" />राज़ै हिजकिया ज़ुंण दूत छ़ाडै, तिंयां डेऊऐ इज़राईल अर यहूदा मुल्खै सारै दी तिन्‍नां का थिअ च़िठी लिखी इहअ सारी परज़ा लै इहअ छ़ांदअ दैनअ द,</para>
  <para style="p" vid="2CH 30:6">“इज़राईली मणछो, ज़ुंण तम्हैं अश्शूरी राज़ै का बच़ै दै आसा, ऐबै फिरा आपणैं दाद-बाब आबराम, इसहाक अर इज़राईले परमेशर बिधाता बाखा, तै जाणअ बिधातो कोप तम्हां का दूर हई। <verse eid="2CH 30:6" /><verse number="7" style="v" sid="2CH 30:7" />थारै दाद-बाब अर इज़राईली मांझ़ै होर भाई-बंध ज़ुंण आपणैं परमेशर बिधाता लै शुचै-पाक्‍कै नांईं रहै, तम्हां निं तिन्‍नां ज़िहै हई। तम्हैं भाल़अ आपणीं आछी कि बिधाता तिन्‍नां लै केही सज़ा दैनी। <verse eid="2CH 30:7" /><verse number="8" style="v" sid="2CH 30:8" />तम्हैं निं तिन्‍नां ज़िहै जर्ड हई अर तम्हैं करै तिहअ ज़िहअ बिधाता हुकम करा। तम्हैं लोल़ी एरुशलेम बिधाते भबना लै आऐ, ज़ुंण भबन म्हारै परमेशर बिधाता सदा लै पबित्र किअ कि तिधी तेऊए पूज़ा होए। तेखअ जाणअ बिधातो कोप तम्हां का दूर हई। <verse eid="2CH 30:8" /><verse number="9" style="v" sid="2CH 30:9" />ज़ै तम्हैं बिधाता बाखा बापस एछे, तै जाणीं दुशमणा थारै तिन्‍नां भाई-बंधा लै झींण फिरी ज़ुंण तिन्‍नैं कैद करी गलामी दी आसा निंयैं दै अर तिंयां हेरनै तिन्‍नां घअरा लै बापस छ़ाडी। म्हारअ परमेशर बिधाता आसा झणैल़ू अर सह झ़ूरा हाम्हां लै खास्सअ। ज़ै तम्हैं तेऊ बाखा फिरे, तेखअ निं लाई तेऊ तम्हां बाखा पिठ डाही फरेऊई।”<verse eid="2CH 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 30:10" />नगरी-नगरी हांढदी पुजअ अह समाद एप्रैम, मनिश्शे, उतरा बाखा बस्सै दै ज़बलून गोत्रा आल़ै सेटा, पर तिंयां सोभै लागै तिन्‍नां लै हास्सदै अर सुहांगा करदै। <verse eid="2CH 30:10" /><verse number="11" style="v" sid="2CH 30:11" />पर तज़ी बी थिऐ आशेर, मनिश्शे अर ज़बलून गोत्रा मांझ़ै कई भलै मणछ अर तिंयां आऐ एरुशलेम नगरी लै। <verse eid="2CH 30:11" /><verse number="12" style="v" sid="2CH 30:12" />यहूदा सारै देशै बी हुअ बिधातो इहअ प्रतप्प कि तिंयां तैर्हुऐ ज़िहअ बोलअ तिहअ ई करना लै ज़िहअ राज़ै हिजकिया अर तेऊए कार-करिंदै हुकम किअ त।<verse eid="2CH 30:12" /></para>
  <para style="s">राज़धानी एरुशलेम मनाऊंअ ऊवार्णैओ थैर</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 30:13" />बशाहै झाल़्हुऐ राज़धानी एरुशलेम ऊवार्णे अर आखरी रोटीए थैरा मनाऊंदै खास्सै मणछ। <verse eid="2CH 30:13" /><verse number="14" style="v" sid="2CH 30:14" />बिधाते भबना छ़ाडी एरुशलेम होर्ती नगरी ज़िधी बी बल़ीदान अर धूप ज़ाल़णा लै बेदी थिई बणाईं दी, तिंयां काढी तिन्‍नैं पोर्ही संघा शोटी किद्रोन नाल़ै। <verse eid="2CH 30:14" /><verse number="15" style="v" sid="2CH 30:15" />ज़ांऊं च़ौदा बशाहै लोग ऊवार्णै लै मिम्मूं काटदै लागै, प्रोहत अर लेबी पल़अ आप्पू लै शर्मिंदै हणअ, तेखअ किई सोभी आपणीं शुधी संघा आणै बिधाते भबनै हूम बल़ीदान। <verse eid="2CH 30:15" /><verse number="16" style="v" sid="2CH 30:16" />तेखअ हुऐ तिंयां तेऊ साबै बिधाते भबनै आपणीं-आपणीं ज़ैगा खल़ै ज़िहअ परमेशरे दास मोसा तिन्‍नां लै बधाना दी आसा लिखी डाहअ द। लेबी आणअ बल़ीदान किऐ दै पशूओ लोहू प्रोहता सेटा अर तिन्‍नैं छ़ल़िकअ सह बेदी दी। <verse eid="2CH 30:16" /><verse number="17" style="v" sid="2CH 30:17" />किल्हैकि लोगा मांझ़ै बी थिऐ इहै ज़ुंण अज़ी बी छ़ोतलै थिऐ। तिन्‍नैं लोगै ज़ुंण ऊवार्णे चैणैं बिधाता लै ज़ुदै शुचै तै डाहै दै, तिन्‍नें तिंयां मिम्मूं काटै तेखअ लेबी आप्पै संघा किऐ बिधाता लै अर्पण।<verse eid="2CH 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 30:18" />इना का लाऊआ ज़ुंण एप्रैम, मनिश्शे, इस्साकार अर ज़बलून गोत्रा का थिऐ आऐ दै, तिन्‍नां मांझ़ै निं खास्सै ज़ण्हैं बधाने साबै आपणीं शुधी आथी ती किई दी। पर तिंयां बी हुऐ ऊवार्णे मिम्मूंए शिखा खाणां लै साझ़ू। राज़ै हिजकिया भाल़अ कि तिन्‍नैं किज़ै किअ अर तेऊ किई तिन्‍नां लै बिधाता सेटा अरज़, “परमेशर बिधाता, <verse eid="2CH 30:18" /><verse number="19" style="v" sid="2CH 30:19" />एही ता निं आसा ईंयां बधाने साबै शुचै आथी हुऐ दै! तूह करै इनो पाप-दोश माफ, किल्हैकि ईंयां बी आसा इने दादा-बाबा ज़िहै तत्त-दिला का ताह बिधाता सेटा तेरी पबित्र ज़ैगा माथै टेक्‍कदै आऐ दै।” <verse eid="2CH 30:19" /><verse number="20" style="v" sid="2CH 30:20" />बिधाता शूणीं हिजकिया राज़े अरज़ संघा किऐ तिन्‍नें पाप-दोश माफ अर तिन्‍नें निं किछ़ हान्‍नी हुई। <verse eid="2CH 30:20" /><verse number="21" style="v" sid="2CH 30:21" />इज़राईली मांझ़ा का ज़ेतरै लोग एरुशलेम नगरी कठा हुऐ तै, तिन्‍नैं मनाऊंअ खुशी-खुशी साता धैल़ी तैणीं आखरी रोटीओ थैर अर हर धैल़ै करा तै लेबी अर प्रोहत गाज़ै-बाज़ै संघै बिधाते ज़ै-ज़ैकार। <verse eid="2CH 30:21" /><verse number="22" style="v" sid="2CH 30:22" />ऊवार्णे थैरा लै लेबी अर प्रोहतै ज़ेही समझ़कारी संघै काम किअ, तेते किई राज़ै हिजकिया खास्सी तिन्‍नें सर्राफी।</para>
  <para style="s" vid="2CH 30:22">ऊवार्णैओ थैर मनाऊंअ साता धैल़ै होर</para>
  <para style="p" vid="2CH 30:22">तेखअ रहै तेता बाद साता धैल़ै तैणीं भिई सोभ लोग थैरा मनाऊंदै लागी। संघा किअ मेल़-ज़ोल़े बल़ीदान करी सोभी लोगै आपणैं दादा-बाबे परमेशर बिधातो शूकर। <verse eid="2CH 30:22" /><verse number="23" style="v" sid="2CH 30:23" />सोभै हुऐ ऐहा गल्‍ला लै राज्ज़ी संघै रहै तेता बाद भिई होर साता धैल़ी तैणीं खुशी-खुशी ऊवार्णे थैरा मनाऊंदै लागी। <verse eid="2CH 30:23" /><verse number="24" style="v" sid="2CH 30:24" />यहूदा मुल्खे राज़ै हिजकिया दैनै लोगा लै एक हज़ार बाछ़ू, सात हज़ार भेडा-बाकरी हेल़्ही बल़ीदान करी धाम। कार-करिंदै बाखा बी दैनै लोगा लै एक हज़ार बल्द अर दस हज़ार भेडा। तेखअ किई खास्सै प्रोहतै बधाने साबै आपणीं शुधी। <verse eid="2CH 30:24" /><verse number="25" style="v" sid="2CH 30:25" />यहूदा मुल्खे प्रोहत, लेबी संघी सारी सभा, यहूदा बस्सै दै सोभ लोग, इज़राईल मुल्खा का आऐ दै लोग अर परदेसी बी ज़ुंण ऊवार्णे थैरा लै थिऐ आऐ दै तिंयां थिऐ सोभ खुश हुऐ दै। <verse eid="2CH 30:25" /><verse number="26" style="v" sid="2CH 30:26" />सारी नगरी ती फेर-फिरदी खुशी किल्हैकि एचल़अ बडअ थैर निं आझ़ तैणीं एरुशलेम नगरीए बस्सै दै लोगै इज़राईले राज़ै दाबेदे शोहरू सुलैमाने ज़मानै ओर्ही भाल़अ ई आथी त। <verse eid="2CH 30:26" /><verse number="27" style="v" sid="2CH 30:27" />तेखअ हुऐ खिरी प्रोहत अर लेबी खल़ै संघा मांगी सोभी लोगा लै बिधाता का बर्गत। बिधाता शूणीं स्वर्गै तिन्‍नें अरज़।<verse eid="2CH 30:27" /></para>
  <chapter eid="2CH 30" />
  <chapter number="31" style="c" sid="2CH 31" />
  <para style="s">राज़ै हिजकिया किई आपणैं देशा का मुहुर्ती पूज़ा दूर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 31:1" />ज़ांऊं ऊवार्णैओ थैर मुक्‍कअ, सोभ इज़राईली डेऊए यहूदा मुल्खै सोभी नगरी संघा पाऐ हर ज़ैगा ओडै अर अशेरा देबीए डौंड चोल़ी फाल़ी, उछ़टी धारे गान-स्तान अर बेदी बी पाई तिन्‍नैं ढोल़ी। ज़ांऊं एप्रैम, बिन्यामीन अर मनिश्शे गोत्रे इज़राईली आपणीं नगरी घअरै पुजै, तेथ बी किअ तिन्‍नैं तिहअ ई।<verse eid="2CH 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CH 31:2" />राज़ै हिजकिया बांडै लेबी अर प्रोहत भिई तिन्‍नें कामें साबै ज़ुदै-ज़ुदै दला दी। तिन्‍नां मांझ़ै दैनी कोई लै हूम अर मेल़-ज़ोल़े बल़ीदाने ज़िम्मैंबारी अर कोई दला लै दैनी बिधाता लै शूकर करने बल़ीदाने ज़िम्मैंबारी। इना कामां लै डाही बिधाते भबनै भितरी अर बागै च़ाकरी करना लै ज़ुदै-ज़ुदै दला लै ज़िम्मैंबारी सभाल़ी। <verse eid="2CH 31:2" /><verse number="3" style="v" sid="2CH 31:3" />बिधाते भबनै धैल़ दोत्ती अर उडै बल़ीदान, बशैघे धैल़ी अर पुनूंईए धैल़ै बधाने साबै ज़ुंण हूम बल़ीदान लागा तै करनै, तेता लै पशू दैणें ज़िम्मैंबारी मनी राज़ै आपणीं भेडा-बाकरीए हेल़्ही का दैणी।<verse eid="2CH 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CH 31:4" />तेता का लाऊआ डाहअ राज़ै एरुशलेम बस्सी दी परज़ा लै इहअ बोली कि तिंयां करै प्रोहत अर लेबी लै भैंट दैई ज़ुंण सूल आसा। ताकि तिंयां कबल्‍लै बधाने साबै बिधाते च़ाकरी करदै रहे। <verse eid="2CH 31:4" /><verse number="5" style="v" sid="2CH 31:5" />ज़िहअ ई राज़ै हिजकिया हुकम किअ, इज़राईली मणछ लागै आपणीं साल-फसला मांझ़ै नाज़, दाखो रस, जैतूनो तेल, मखीर अर होरी पज़ैआ मांझ़ै पैहली घाण बिधाते भबनै भैंट आणदै। होरी सोभी च़िज़ो बी करा तै तिंयां दसुअ निसब आणी। <verse eid="2CH 31:5" /><verse number="6" style="v" sid="2CH 31:6" />यहूदा मुल्खे होरी नगरी बस्सै दै इज़राईली अर यहूदी बी लागै आपणैं डागै-चैणें हेल़्ही मांझ़ै दसुअ निसब बिधाते भबना लै आणदै। होर बिधाता लै बांधअ ज़ुंण होर च़िज़ा ज़ुदी हआ ती डाही दी, तेता बी लागै आणदै। <verse eid="2CH 31:6" /><verse number="7" style="v" sid="2CH 31:7" />ज़ेठा पोर्ही रहै काती तैणीं लोग बिधाते भबनै भैंट आणदै लागी, भबने भढारै डाहै रूल़ लाई। <verse eid="2CH 31:7" /><verse number="8" style="v" sid="2CH 31:8" />ज़ांऊं राज़ै हिजकिया अर तेऊए कार-करिंदै भाल़अ कि परज़ा दैनी बिधाते भबना लै खास्सी भैंट, तिन्‍नैं किअ बिधातो अर इज़राईली परज़ो शूकर। <verse eid="2CH 31:8" /><verse number="9" style="v" sid="2CH 31:9" />खास्सी भैंट भाल़ी पुछ़अ राज़ै हिजकिया लेबी, प्रोहत अर <verse eid="2CH 31:9" /><verse number="10" style="v" sid="2CH 31:10" />सदोके शोहरू माहा प्रोहत अजर्याह का, “ज़धा ओर्ही लोग भैंट दैंदै आसा लागै दै, तधा ओर्ही निं खाणैं-पिणें निऊल़ पल़ी अर तेता का लाऊआ बच़ा म्हारै खास्सी ज़िणस पिछ़ू। किल्हैकि बिधाता दैनी आपणीं परज़ा लै खास्सी बर्गत। इधी भाल़ा ज़िणसीए किहै रूल़ आसा बच़ै दै!”<verse eid="2CH 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 31:11" />तेखअ किअ राज़ै हिजकिया हुकम कि बिधाते भबने भढारै बणाआं कठैरी। तिन्‍नैं बझ़ैल़ी कारीगीरा का कठैरी बणाणैं अर <verse eid="2CH 31:11" /><verse number="12" style="v" sid="2CH 31:12" />बिधाते भबनै दैनी दी भैंटा का ज़ेतरी च़िज़ा बच़ी दी थिई, तिंयां डाही तिन्‍नैं कठैरी दी ज़ुदी-ज़ुदी हाल़्है। तेते भढारी डाहै तिन्‍नैं लेबी मांझ़ै कननया अर तेऊ संघै दुजअ तेऊओ भाई शिमी। <verse eid="2CH 31:12" /><verse number="13" style="v" sid="2CH 31:13" />बिधाते भबनै तिन्‍नां संघै च़ाकरी लै डाहै राज़ै हिजकिया अर अजर्याह माहा प्रोहतै लेबी मांझ़ै दस ज़ण्हैं होर। तिंयां थिऐ जेहीएल, नाहात, अजाज्या, असाहेल, जरमोत, जोजबाद, एलीएल, इसमाकिया, महात, बेनियाह। <verse eid="2CH 31:13" /><verse number="14" style="v" sid="2CH 31:14" />लेबी मांझ़ै इमनो शोहरू कोराह बणाअं बिधाते भबनै पुर्बा बाखा प्रऊल़ीए पहरै करने आल़ैओ प्रधान। तेऊए ज़िम्मैंबारी ती बिधाता लै रगाऊई दी भैंट प्रोहता लै बांडी दैणी। <verse eid="2CH 31:14" /><verse number="15" style="v" sid="2CH 31:15" />तेऊ संघै च़ाकरी लै थिऐ लेबी मांझ़ै छ़ह ज़ण्हैं होर डाहै दै, तिन्‍नां का थिई ज़िम्मैंबारी सभाल़ी दी कि होरी नगरी बस्सै दै प्रोहता बी बिधाता लै रगाऊई दी भैंटा मांझ़ै भाग भेटे। तिंयां छ़ह ज़ण्हैं तै एदेन, मिन्यामीन, जेशूआ, शमयाह, अमर्या अर शकनया। तिंयां रहा तै तिन्‍नां ई नगरी ज़ेथ-ज़ेथ प्रोहत तै बस्सै दै। तिंयां दैआ तै तिन्‍नां सोभी लेबी लै बिधाते भैंटा मांझ़ै तिन्‍नें कामें साबै ज़िणस बांडी। <verse eid="2CH 31:15" /><verse number="16" style="v" sid="2CH 31:16" />भेंटो भाग दैआ तै तिंयां तिन्‍नां सोभी प्रोहता मांझ़ै तिन्‍नां लै तिन्‍नें पदबीए साबै ज़ुंण तिहा साले या तेता का खास्सी अमरे होए अर बिधाते भबनै धैल़ च़ाकरी करा।<verse eid="2CH 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 31:17" />प्रोहता लै थिऐ बिधाते भबनै तिन्‍नें टोलीए साबै काम सभाल़ै दै। च़ाकरी लै हआ तै लेबी मांझ़ै सिधै तिन्‍नें नाअं लिखै दै ज़ुंण बिहा साले अर तेता खास्सी अमरे होए। <verse eid="2CH 31:17" /><verse number="18" style="v" sid="2CH 31:18" />तिन्‍नें नाअं हआ तै तिन्‍नें बेटल़ी अर शोहरू-शोहरी अर होरी टबरा संघी दर्ज़ डाहै दै करी। किल्हैकि तिंयां रहा तै शुचै-पाक्‍कै रही बिधाते भबनै च़ाकरी करना लै च़ांगै-च़ोखै। <verse eid="2CH 31:18" /><verse number="19" style="v" sid="2CH 31:19" />यहूदा मुल्खै ज़ुंण नगरी हारणे आद-लुआदे हेस्सै ती आई दी, राज़ै हिजकिया छ़ांटे लेबी मांझ़ै होर बी ज़ुंण तिन्‍नां नगरी ओरी-पोरी घैहणीं तै बस्सै दै लेबी अर प्रोहता सेटा बी बिधाता लै रगाऊई दी भैंटा मांझ़ै भाग बांडी दैए।<verse eid="2CH 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 31:20" />इहअ करै दैआ त राज़अ हिजकिया सारै यहूदा मुल्खै प्रोहता अर लेबी लै ज़िणस बांडी। तेऊ किअ शुचअ-पाक्‍कअ रही तिहअ ई ज़िहअ बिधाता च़ाहा अर ज़ेता लै बिधाता खुश हआ त। <verse eid="2CH 31:20" /><verse number="21" style="v" sid="2CH 31:21" />राज़ै हिजकिया यहूदा मुल्खै ज़ुंण बी काम किऐ, सह हुअ तेता लै सफल। किल्हैकि तेऊ किऐ सारै काम बधाने साबै, तेऊ किऐ सोभै काम तत्त-दिला का अर परमेशरे डरा हेठै रही।<verse eid="2CH 31:21" /></para>
  <chapter eid="2CH 31" />
  <chapter number="32" style="c" sid="2CH 32" />
  <para style="s">अश्शूरी छ़ेल़अ यहूदा मुल्खा संघै जुध</para>
  <para style="r">(<ref loc="2KI 18:13-37">2 राज़ै 18:13-37</ref>; <ref loc="2KI 19:14-19">19:14-19</ref>; <ref loc="2KI 19:35-37">19:35-37</ref>; <ref loc="ISA 36:1-22">ईशायाह 36:1-22</ref>; <ref loc="ISA 37:8-38">37:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 32:1" />राज़अ हिजकिया रहअ बिधाता लै शुचअ-पाक्‍कअ ज़ांऊं सह इना सोभी कामां करी मुक्‍कअ, अश्शूर देशे राज़ै सनहेरीबै छ़ेल़अ यहूदा मुल्खा संघै जुध। तेऊ गोटी यहूदा मुल्खे गहल़ा आल़ी नगरी संघा किअ आपणीं सैना लै हुकम कि तिन्‍नां नगरी फेरे गहल़ा पाआ ढोल़ी। <verse eid="2CH 32:1" /><verse number="2" style="v" sid="2CH 32:2" />ज़ांऊं हिजकिया का ज़ाण्हुंअ कि ऐबै लाअ सनहेरीबै एरुशलेम नगरी बी जुध छ़ेल़ी, <verse eid="2CH 32:2" /><verse number="3-4" style="v" sid="2CH 32:3-4" />राज़ै हिजकिया किई आपणैं कार-करिंदै अर सैना लै सलाह दैणैं आल़ै बज़ीरा संघै सट-सलाह कि नगरी बाखा बगणैं आल़ै पाणीं दी लाणअ रोक्‍कअ ताकि ज़ांऊं अश्शूरी सैना नगरी नेल़ एछे तिन्‍नां निं झुटणा लै पाणीं लोल़ी भेटअ। कार-करिंदै निंयैं आप्पू संघै खास्सै मणछ संघा लाअ नगरी नेल़ बगणैं आल़ी गाडा दी रोक्‍कअ।<verse eid="2CH 32:3-4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 32:5" />नगरी फेर गहल़ै ज़िधी-ज़िधी ढूल़अ द थिअ, तेथ बी बझ़ैल़ी राज़ै हिजकिया च़णाई करनै अर तेता प्रैंदै डाहै उछ़टै कोट च़िणीं। ज़ुंण गहल़ा बागै एक होर दुआल थिई, तेते बी किई तेऊ मराम्मत। पुर्बा बाखा दाबेदपूर गहल़ बी किअ तेऊ पाक्‍कअ। जुधा करना लै डाही खास्सी ढाल़ा अर अस्त्र-शस्त्र बणाईं। <verse eid="2CH 32:5" /><verse number="6" style="v" sid="2CH 32:6" />सैने दला लै छ़ांटै राज़ै हिजकिया दलपति। तेखअ शादै सोभै दल नगरीए प्रऊल़ी नेल़ च़फै लै, तिधी बढेरअ तेऊ इहअ बोली सैनो जोश, <verse eid="2CH 32:6" /><verse number="7" style="v" sid="2CH 32:7" />“हिम्मत डाहा, पिछ़ू निं हटी! अश्शूरी राज़ै सनहेरीब अर तेऊए सैना का निं डरदै लागी, तिन्‍नां का कई गुणा खास्सअ बल आसा हाम्हां संघै। <verse eid="2CH 32:7" /><verse number="8" style="v" sid="2CH 32:8" />तिन्‍नें सैना च़ाऐ ज़ेतरी बी खास्सी होए, पर सह आसा सिधअ मणछो ज़ोर। हाम्हां बाखा जुधा करनै आल़अ आसा म्हारअ परमेशर बिधाता!” इहअ करै दैनी राज़ै हिजकिया यहूदा मुल्खे आपणीं सैना लै हिम्मत।<verse eid="2CH 32:8" /></para>
  <para style="s">अश्शूरी राज़ै दैनी एरुशलेम नगरी लै धमकी</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 32:9" />थोल़ै धैल़ै बाद हुअ इहअ कि अश्शूरी राज़ै सनहेरीबै तै आपणीं सैना संघी लकीश नगरी डेरै पाऐ दै तेऊ दैनअ राज़ै हिजकिया अर यहूदा मुल्खे लोगा लै समाद ज़ुंण तेऊ संघै एरुशलेम नगरी आसा तै, <verse eid="2CH 32:9" /><verse number="10" style="v" sid="2CH 32:10" />“हुंह अश्शूर देशो माहा राज़अ सनहेरीब पुछ़ा तम्हां का इहअ कि तम्हां कसरै आसरै आसा अज़ी बी हिम्मत? मंऐं आसा फेर फिरदै तम्हैं गोटी डाहै दै! <verse eid="2CH 32:10" /><verse number="11" style="v" sid="2CH 32:11" />हिजकिया आसा तम्हैं यहूदा मुल्खे लोग इहअ बोली धोखै दी डाहै दै कि थारै परमेशर बिधाता हेरनै तम्हैं मुंह अश्शूर देशे माहा राज़ै का बच़ाऊई! इहअ करै लाऐ तेऊ तम्हैं नगरी भितरी भुखै-नचिशै मारी! <verse eid="2CH 32:11" /><verse number="12" style="v" sid="2CH 32:12" />तिंयां थिऐ बिधाते ई गान-स्तान अर बेदी ज़ुंण एऊ हिजकिया बरैबाद किई। एऊ बोलअ यहूदा अर एरुशलेम देशे लोगा लै इहअ कि एरुशलेम नगरीए बेदी का सुआई निं होर्ती माथअ टेक्‍की आथी। <verse eid="2CH 32:12" /><verse number="13" style="v" sid="2CH 32:13" />तम्हैं हणअ शूणअ द कि मेरै-दाद-बाब अर मंऐं होरी देशे केही बूरी दशा किई? तिन्‍नां देशे देअ देबतै कै अश्शूरी राज़ै का आपणीं परज़ा बच़ाऊई? <verse eid="2CH 32:13" /><verse number="14" style="v" sid="2CH 32:14" />तिन्‍नां देशै निं इहअ एक बी देअ नां देबतअ निखल़अ ज़ुंणी आपणीं परज़ा हाम्हां अश्शूरी राज़ै का बच़ाऊई होए! ऐबै तम्हैं कै सोठा थारै बिधाता कै तम्हैं बच़ाऊई हेरनै? <verse eid="2CH 32:14" /><verse number="15" style="v" sid="2CH 32:15" />तम्हैं निं हिजकिया राज़े ज़ाणैं लागी, एऊ आसा तम्हैं धोखै दी डाहै दै! एऊओ विश्वास निं करी! आझ़ तैणीं निं कोही देशे देअ-देबी अश्शूरी माहा राज़ै का आपणीं परज़ा बच़ाऊई सकै। ऐबै निं तम्हैं हिजकिया राज़े ऐहा गल्‍ले आसरै रही कि तम्हैं हेरनै थारै देअआ बच़ाऊई!”<verse eid="2CH 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CH 32:16" />तिंयां अश्शूरी कार-करिंदै लागै परमेशर बिधाता अर बिधाते दास राज़ै हिजकिया लै होर बी खास्सै कज़िछ़ बोल्दै। <verse eid="2CH 32:16" /><verse number="17" style="v" sid="2CH 32:17" />सनहेरीब राज़ै ज़ुंण च़िठी ती लिखी दैनी दी, तेथ त इज़राईले परमेशर बिधातो सुहांग किअ द! तेथ त इहअ लिखअ द, “कोही देशे देअ-देबी निं आपणीं परज़ा मेरी शगती का बच़ाऊई सकै, नां हिजकियो देअ बिधाता मुखा आपणीं परज़ा बच़ाऊई सकदअ।” <verse eid="2CH 32:17" /><verse number="18" style="v" sid="2CH 32:18" />तिंयां कार-करिंदै लागै ज़ोरै-ज़ोरै इना गल्‍ला इब्रानी बोली दी पहल़दै ताकि ज़ुंण यहूदी मणछ एरुशलेम गहल़े दुआली प्रैंदै तै बेठै दै, तिंयां शुणें अर डरे अर अश्शूरी सैना लै एरुशलेम नगरी दी कबज़अ करनअ सान होए। <verse eid="2CH 32:18" /><verse number="19" style="v" sid="2CH 32:19" />तिंयां थिऐ बिधाते बारै इहअ बोल्दै लागै दै ज़िहअ कि बिधाता आसा होरी देअए आम मुहुर्ती ज़िहअ ज़ुंण मणछै आपणैं हाथै थिई बणाईं दी!<verse eid="2CH 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 32:20" />तेखअ लागै राज़अ हिजकिया अर आमोसो शोहरू ईशायाह गूर बिधाता सेटा लेर-पकार पाई मज़त मांगदै। <verse eid="2CH 32:20" /><verse number="21" style="v" sid="2CH 32:21" />बिधाता छ़ाडअ एक स्वर्ग दूत तेऊ पाऐ अश्शूरी सैने डेरै सारी सैना मारी अर अश्शूरी राज़अ ठुर्हअ बेइज़त हई आपणैं देशा लै बापस। एकी धैल़ै डेऊअ सह आपणैं देअए देहुरै लै अर तिधी पाअ सह तेऊए आपणैं ई शोहरू तलबारा करै मारी।<verse eid="2CH 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 32:22" />इहअ करै बच़ाऊऐ बिधाता एरुशलेम नगरीए परज़ा अर राज़अ हिजकिया अश्शूरी राज़ै सनहेरीबा अर तिन्‍नें होरी दुशमणा का। तेखअ भेटी यहूदा मुल्खे लोगा होरी सोभी देशा का शांती। <verse eid="2CH 32:22" /><verse number="23" style="v" sid="2CH 32:23" />तेखअ लागै खास्सै मणछ एरुशलेम नगरी लै एछदै, तिंयां करा तै बिधाता लै भैंट अर यहूदा मुल्खे राज़ै हिजकिया लै किम्मती च़िज़ा भैंट आणी। तधा पोर्ही करा तै सोभ देश राज़ै हिजकियो अदर।<verse eid="2CH 32:23" /></para>
  <para style="s">राज़ै हिजकियो घमंड</para>
  <para style="r">(<ref loc="2KI 20:1-3">2 राज़ै 20:1-3</ref>; <ref loc="2KI 20:12-19">20:12-19</ref>; <ref loc="ISA 38:1-3">ईशायाह 38:1-3</ref>; <ref loc="ISA 39:1-8">39:1-8</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 32:24" />तिन्‍नां ई धैल़ै हुअ इहअ कि हिजकिया राज़ै लागी एही बमारी कि तेऊए ती मौत हणैं आल़ी। तेऊ किई बिधाता सेटा अरज़ कि हे बिधाता, तूह दै मुल्है किज़ै इहअ नछ़ैण कि हुंह जाणअ ऐहा बमारी का बिज़री। <verse eid="2CH 32:24" /><verse number="25" style="v" sid="2CH 32:25" />पर हिजकिया त खास्सअ घमंड आअ द कि तेऊ निं बिधातो शूकर बी किअ कि बिधाता किई तेऊ लै एतरी गल्‍ला। राज़ै हिजकिया संघै पल़ी एते सज़ा यहूदा अर एरुशलेम नगरीए परज़ा बी भुगतणी। <verse eid="2CH 32:25" /><verse number="26" style="v" sid="2CH 32:26" />खिरी मनी राज़ै हिजकिया अर एरुशलेम नगरीए परज़ा आपणीं गलती अर बिधाता छ़ाडी तिन्‍नां लै माफी। तेखअ निं राज़ै हिजकिये ज़िऊंदी ज़िता तिन्‍नां लै किछ़ै आफ़त पल़ी।<verse eid="2CH 32:26" /></para>
  <para style="s">हिजकिया राज़े ज़ैदात अर तेऊए काम</para>
  <para style="p">
    <verse number="27" style="v" sid="2CH 32:27" />राज़अ हिजकिया त खास्सअ सेठ, सोभ करा तै तेऊओ अदर। तेऊ तै सुन्‍नैं, च़ंदी, मणीं, नघ, खुशबूदार मसालै, ढाल़ा अर होरी किम्मती च़िज़ा डाहणां लै खास्सै भढार बणाऐं दै। <verse eid="2CH 32:27" /><verse number="28" style="v" sid="2CH 32:28" />एता का लाऊआ तै तेऊ नाज़, दाखे रस, जैतूने तेल डाहणां लै भढार बणाऐं दै। डागै लै बडै-बडै खुढ अर भेडा-बाकरीए हेल़्ही डाहणां लै ती बडी-बडी शाल़ा बणाईं दी। <verse eid="2CH 32:28" /><verse number="29" style="v" sid="2CH 32:29" />बिधाता दैनी राज़ै हिजकिया लै एही खास्सी बर्गत कि तेऊ का थिई खास्सी भेडा, बाकरी अर गाऊईए हेल़्ही। इना डागै-चैणैं डाहणां लै बणाईं तेऊ खास्सी नगरी। <verse eid="2CH 32:29" /><verse number="30" style="v" sid="2CH 32:30" />सह थिअ राज़अ हिजकिया ई ज़ुंणीं गीहोन गाडा दी रोक्‍कअ लाई सह गाड कुल्ह खण्हीं एरुशलेम नगरी दाबेदपूर गहल़े पछ़मा बाखा लै फरेऊई। ज़ुंण बी तेऊ काम किअ तेथ हुअ सह सफल। <verse eid="2CH 32:30" /><verse number="31" style="v" sid="2CH 32:31" />बाबेल देशे कार-करिंदै छ़ाडै हिजकिया सेटा आपणैं दूत इहअ पुछ़दै कि हाम्हैं किहअ करै ज़ाणूं कि सोभै गल्‍ला किई ताल्है बिधाता? परमेशरै दैनअ इहअ परखणां लै हिजकिया आपणैं साबै ज़बाब दैणैं कि सह केचल़अ शुचअ-पाक्‍कअ आसा।<verse eid="2CH 32:31" /></para>
  <para style="s">राज़ै हिजकियो राज़ हुअ खतम</para>
  <para style="r">(<ref loc="2KI 20:20">2 राज़ै 20:20</ref>,<ref loc="2KI 20:21">21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2CH 32:32" />राज़ै हिजकिया ज़िहै बी काम किऐ, तिंयां सोभै गल्‍ला आसा आमोसे शोहरू ईशायाह गूरे कताबा अर इज़राईल अर यहूदा मुल्खे राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="2CH 32:32" /><verse number="33" style="v" sid="2CH 32:33" />खिरी मूंअ राज़अ हिजकिया संघा डाहअ दाबेदपूर राज़ै दाबणे मल्थानै घोरी दी दाबी। यहूदा अर एरुशलेम नगरीए लोगै किअ मरनै बाद खास्सअ अदर। आजू बणअ तेऊए ज़ैगा तेऊओ शोहरू मनिश्शे यहूदा मुल्खो राज़अ।<verse eid="2CH 32:33" /></para>
  <chapter eid="2CH 32" />
  <chapter number="33" style="c" sid="2CH 33" />
  <para style="s">यहूदा मुल्खै राज़अ मनिश्शे</para>
  <para style="r">(<ref loc="2KI 21:1-9">2 राज़ै 21:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 33:1" />ज़धू मनिश्शे यहूदा मुल्खो राज़अ बणअ, तेऊए अमर ती तधू बारा साले अर तेऊ किअ एरुशलेम नगरी का पजुंजा साला तैणीं राज़। <verse eid="2CH 33:1" /><verse number="2" style="v" sid="2CH 33:2" />मनिश्शे किअ पाप ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे! तेऊ किऐ तिन्‍नां ज़ाती ज़िहै च़िल़्हखरै काम ज़ुंण बिधाता तेऊ देशै इज़राईली पुजणैं का आजी दूर किऐ तै।<verse eid="2CH 33:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 33:3" />मनिश्शे च़िणैं उझै धारा देहुरै भिई ज़ुंण तेऊए बाब हिजकिया खतम किऐ तै! तेऊ बणाईं इज़राईले राज़ै अहाबा ज़ेही बाल देअ अर अशेरा देबीए मुहुर्ती। सरगे ग्रहा पूज़दअ बी रहा त मनिश्शे लागी। <verse eid="2CH 33:3" /><verse number="4" style="v" sid="2CH 33:4" />एरुशलेम नगरी बिधाते भबनै ज़िधी सिधै बिधाता सेटा माथअ टेक्‍का तै, तिधी बणाईं तेऊ होरी देअआ लै बी बेदी। <verse eid="2CH 33:4" /><verse number="5" style="v" sid="2CH 33:5" />बिधाते भबनै दोहरी बाखा खोल़ै बणाईं ग्रहे पूज़ा करना लै बेदी। <verse eid="2CH 33:5" /><verse number="6" style="v" sid="2CH 33:6" />हिनोम खागै किअ आपणअ शोहरू बी बल़ीदान करी हूम! मनिश्शे करा त डांऊं-च़ेल्‍लै, शाऊई भाल़णैं आल़ै, मणशाण झ़ैऊंणै आल़ै सेटा डेऊई। इहअ करै किअ तेऊ बिधाता लै घोर पाप अर तेता लै आई बिधाता खास्सी रोश्शै। <verse eid="2CH 33:6" /><verse number="7" style="v" sid="2CH 33:7" />तेऊ ज़ुंण अशेरा देबीए मुहुर्ती बणाईं, तेऊ स्तापी सह बिधाते तेऊ भबनै ज़ेता लै बिधाता राज़ै दाबेद अर दाबेदे शोहरू सुलैमाना का इहअ बोलअ त, “इज़राईले बारा गोत्रे सोभी ज़ैगा मांझ़ै छ़ांटी मंऐं एरुशलेम नगरी अह ज़ैगा आप्पू लै ज़िधी सोभी एछी मुंह सेटा माथअ टेक्‍कणअ। <verse eid="2CH 33:7" /><verse number="8" style="v" sid="2CH 33:8" />ज़ै इज़राईली मेरै सोभै हुकम मने अर मेरै तेऊ बधाने साबै आपणीं ज़िन्दगी ज़िऊए ज़ुंण मेरै दास मोसा तिन्‍नां लै दैनअ, तै डाहणैं मुंह तिंयां तेऊ देशै बसाऊई ज़ुंण मंऐं तिन्‍नें दादा-बाबा लै दैनअ। तिन्‍नां निं तिधा का किधी ठुल़णें ज़रुरत आथी।” <verse eid="2CH 33:8" /><verse number="9" style="v" sid="2CH 33:9" />पर यहूदा अर एरुशलेम नगरीए लोगै निं बिधाते साबै ज़िन्दगी ज़िऊई। राज़ै मनिश्शे पाऐ तिंयां इहै कबाता कि तिंयां लागै तिन्‍नां होरी ज़ाती का बी खास्सै पाप करदै ज़ुंण बिधाता तेऊ देशा का इज़राईली नदरी खतम किई ती।<verse eid="2CH 33:9" /></para>
  <para style="s">राज़अ मनिश्शे पछ़ताअ</para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 33:10" />बिधाता दैनी राज़ै मनिश्शे अर तेऊए परज़ा लै चतैनगी बी पर तिन्‍नैं किई शूणीं नां शूणीं। <verse eid="2CH 33:10" /><verse number="11" style="v" sid="2CH 33:11" />तेखअ दैनअ बिधाता अश्शूर देशे सैनापति यहूदा मुल्खा संघै जुधा लै एछणैं। तिन्‍नैं किअ यहूदा मुल्खो राज़अ मनिश्शे कैद तेखअ लाई तेऊए नाकै नकेल संघा निंयं पितल़े शांघल़ी करै बान्हीं बाबेल देशा लै। <verse eid="2CH 33:11" /><verse number="12" style="v" sid="2CH 33:12" />ज़ांऊं राज़ै मनिश्शे लै अह खरी पल़ी, तेखअ फिरी तेऊ आपणैं दादा-बाबे परमेशर बिधाते आद संघा मांगी बिधाता का माफी कि हे बिधाता, ऐबै कर मेरी मज़त तूह ई। <verse eid="2CH 33:12" /><verse number="13" style="v" sid="2CH 33:13" />बिधाता शूणीं मनिश्शे अरज़ संघा पजैल़अ सह एरुशलेम बापस कि सह यहूदा मुल्खै राज़ करे। तेखअ हुअ मनिश्शे निहंचअ कि बिधाता ई आसा परमेशर।<verse eid="2CH 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 33:14" />एता बाद किअ राज़ै मनिश्शे दाबेदपूर पुर्बा बाखा गहल़ च़णाई करी होर बी उछ़टअ। सह च़णाई किई तेऊ पछ़मा बाखा गीहोन गाडा उझै म्हाछ़ली नाओंए प्रऊल़ी तैणीं अर नगरीए ज़ैगा फेर किअ सह गहल़ उछ़टअ ज़ेता लै ओपेल बोला। यहूदा मुल्खे सोभी गहल़ा आल़ी नगरी डाही तेऊ आपणीं सैना का ज़ुदै-ज़ुदै दल अर तिन्‍नां प्रैंदै डाहै सैनापति छ़ांटी। <verse eid="2CH 33:14" /><verse number="15" style="v" sid="2CH 33:15" />बिधाते भबना का काढै तेऊ काठा-पात्थरे मुहुर्ती अर होरी देअआ-देबीए मैहरै पोर्ही। तिन्‍नें ज़ेतरी बेदी बिधाते भबनै, एरुशलेम नगरी ज़ैगै-ज़ैगै उछ़टी धारा थिई, तिंयां बी झाल़ी तेऊ सोभै संघा शोटी नगरी बागै। <verse eid="2CH 33:15" /><verse number="16" style="v" sid="2CH 33:16" />तेखअ बझ़ैल़ी तेऊ बिधाते बेदी स्केरनै, संघा किअ तिधी बिधाता लै मेल़-ज़ोल़ अर शूकर करनैओ बल़ीदान। तेखअ किअ मनिश्शे यहूदा मुल्खै सोभी लोगा लै हुकम कि सोभ करा इज़राईले परमेशर बिधाते पूज़ा-गाज़ा। <verse eid="2CH 33:16" /><verse number="17" style="v" sid="2CH 33:17" />पर तज़ी बी रहै परज़ा मांझ़ै कई लोग ज़ैगै-ज़ैगै उझै धारा बल़ीदान करदै लागी पर करा तै तिंयां बिधाते नाओंऐं।<verse eid="2CH 33:17" /></para>
  <para style="s">मनिश्शेओ राज़ हुअ खतम</para>
  <para style="r">(<ref loc="2KI 21:17">2 राज़ै 21:17</ref>,<ref loc="2KI 21:18">18</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2CH 33:18" />राज़ै मनिश्शे ज़ुंण बी काम किऐ, ज़ेही तेऊ परमेशरा सेटा अरज़ किई, इज़राईले परमेशर बिधाता गूरा बाती तेऊ लै किज़ै चतैनगी दैनी, ईंयां सोभै गल्‍ला आसा इज़राईले राज़े इतिहासे कताबा दी लिखी डाही दी। <verse eid="2CH 33:18" /><verse number="19" style="v" sid="2CH 33:19" />राज़ै मनिश्शे प्राथणां, तेखअ परमेशरै सह केऊ साबै शूणीं, मनिश्शे किहै-किहै पाप किऐ, तेऊ किज़ै बूरअ किअ, तेऊ किधी-किधी धारा बणाऐं होरी देअए गान-स्तान, अशेरा देबीए डौंड तेऊ किधी-किधी डाहै घैऊई अर होर सह किज़ै-किज़ै मुहुर्ती पूज़ा त, इना सोभी गल्‍लो इतिहास आसा बिधाते गूर होसाह लिखी डाहअ द। <verse eid="2CH 33:19" /><verse number="20" style="v" sid="2CH 33:20" />खिरी मूंअ राज़अ मनिश्शे संघा डाहअ सह तेऊए दादा-बाबा संघै तेऊए मैहलै दाबी। आजू बणअ तेऊओ शोहरू अमोन तेऊए ज़ैगा यहूदा मुल्खो राज़अ।<verse eid="2CH 33:20" /></para>
  <para style="s">यहूदा मुल्खै राज़अ अमोन</para>
  <para style="r">(<ref loc="2KI 21:19-26">2 राज़ै 21:19-26</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2CH 33:21" />ज़धू अमोन यहूदा मुल्खो राज़अ बणअ, तधू ती तेऊए अमर बाई साले। तेऊ किअ एरुशलेम नगरी का दूई साला तैणीं राज़। <verse eid="2CH 33:21" /><verse number="22" style="v" sid="2CH 33:22" />अमोनै बी किअ आपणैं बाब मनिश्शे ज़िहअ पाप, ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे। सह लागअ तिन्‍नां मुहुर्ती पूज़दअ अर तेता लै बल़ीदान करदअ ज़ुंण तेऊए बाब मनिश्शे ती बणाईं दी। <verse eid="2CH 33:22" /><verse number="23" style="v" sid="2CH 33:23" />अमोन निं आपणैं बाबा ज़िहअ पछ़ताअ करी बिधाता बाखा फिरअ। सह निखल़अ पाप करना लै आपणैं बाब मनिश्शे का बी च़ार गंईं आजू।<verse eid="2CH 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CH 33:24" />अमोने कार-करिंदै किअ तेऊ लै राज़ द्रोह संघा डाहअ सह तेऊए ई मैहला भितरी मारी। <verse eid="2CH 33:24" /><verse number="25" style="v" sid="2CH 33:25" />यहूदा मुल्खे आम परज़ा पाऐ तिंयां मारी ज़ुंणीं अमोन मारअ त अर तेखअ बणाअं तिन्‍नैं अमोने ज़ैगा तेऊओ शोहरू जोशिया राज़अ।<verse eid="2CH 33:25" /></para>
  <chapter eid="2CH 33" />
  <chapter number="34" style="c" sid="2CH 34" />
  <para style="s">यहूदा मुल्खो राज़अ जोशिया</para>
  <para style="r">(<ref loc="2KI 22:1">2 राज़ै 22:1</ref>,<ref loc="2KI 22:2">2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 34:1" />ज़धू जोशिया यहूदा मुल्खो राज़अ बणअ, सह थिअ तधू आठा सालो शोहरू। तेऊ किअ एरुशलेम नगरी का कत्ती साला तैणीं यहूदा मुल्खै राज़। <verse eid="2CH 34:1" /><verse number="2" style="v" sid="2CH 34:2" />जोशिया रहअ बिधाता लै शुचअ-पाक्‍कअ अर तेऊ किअ तिहअ ई ज़िहअ बिधाता च़ाहा त कि सह करे ज़िहअ तेऊओ दाद-बाब राज़अ दाबेद थिअ, तेही ई किई तेऊ सोभै गल्‍ला परमेशरे बधाने साबै।<verse eid="2CH 34:2" /></para>
  <para style="s">जोशिया किऐ च़िल़्हखरै गान-स्तान खतम</para>
  <para style="p">
    <verse number="3" style="v" sid="2CH 34:3" />राज़अ जोशिया त अज़ी लान्हअ ई, ज़ांऊं तेऊ राज़ै बणी आठ साला हुई, तेखअ लागअ सह आपणैं दाद-बाब राज़ै दाबेदे परमेशरे बारै शिखल़दअ। तेता का च़ऊ साला बाद ज़ांऊं सह बिहा साले अमरो हुअ, तेखअ लागअ सह यहूदा अर एरुशलेम हर ज़ैगे शुधी करदअ। तेऊ पाऐ सारै का मुहुर्ती पूज़ा करने गान-स्तान पठी ढोल़ी अर अशेरा देबीए डौंड अर होर मुहुर्ती बी काढी पठी पोर्ही। <verse eid="2CH 34:3" /><verse number="4" style="v" sid="2CH 34:4" />तेऊ किअ हुकम कि बाल देअए बेदी पाआ ढोल़ी अर ज़ुंण उछ़टै दी धूपा ज़ाल़णे बेदी थिई, तिंयां बी पाई फाल़ी। अशेरा देबीए डौंड अर टिप्पी अर गल़ाऊई-ढल़ाऊई करै बणाईं दी होर मुहुर्ती बी किई तेऊ ज़ाक्‍करी करै भींन अर तेते छिक्‍करी डाही तेऊ तिन्‍नें मल्थाना दी शोटी ज़ुंण तिन्‍नां मुहुर्ती लै बल़ीदान करा तै। <verse eid="2CH 34:4" /><verse number="5" style="v" sid="2CH 34:5" />ज़ुंण तिन्‍नां मुहुर्तीए पज़ैरै थिऐ, तिन्‍नें हाडकै किऐ तेऊ तिन्‍नें ई बेदी दी हूम अर इहअ करै काढी तेऊ सारै यहूदा अर एरुशलेम नगरी का छ़ोत पोर्ही। <verse eid="2CH 34:5" /><verse number="6" style="v" sid="2CH 34:6" />ज़िधी मनिश्शे, शमौन, एप्रैम अर नप्ताली गोत्र आसा बस्सै दै, तिन्‍नें नगरी अर तेता ओरी-पोर्ही शुन्‍नैं रेगीस्तानै बणाईं दी बेदी बी पाई तेऊ फाल़ी। <verse eid="2CH 34:6" /><verse number="7" style="v" sid="2CH 34:7" />तेथ बी पाऐ अशेरा देबीए डौंड अर टिप्पी अर गल़ाऊई-ढल़ाऊई करै बणाईं दी होर मुहुर्ती फाल़ी अर तिंयां किई तेऊ ज़ाक्‍करी करै माट्टै जैंदरी भींन। इज़राईल मुल्खै ज़ेतरी बी धूपा ज़ाल़णे बेदी थिई, तिंयां किई तेऊ पठी खतम अर तेखअ आअ सह खिरी एरुशलेम नगरी लै फिरी।<verse eid="2CH 34:7" /></para>
  <para style="s">बधाने कताब लोल़ी</para>
  <para style="r">(<ref loc="2KI 22:3-20">2 राज़ै 22:3-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2CH 34:8" />ज़ांऊं राज़अ जोशिया सारै यहूदा मुल्खै अर बिधाते भबना का मुहुर्ती पूज़ा करने गान-स्तान खतम करी शुधी करी मुक्‍कअ, तेखअ छ़ाडै तेऊ आपणैं राज़ा दी ठार्हुई साला बिधाते भबने मराम्मती करदै आपणैं कार-करिंदै मांझ़ै असलाहो शोहरू शापान, एरुशलेम नगरीओ राज़पाल मासेया जोअहाजो शोहरू जोआह ज़ुंण इतिहास लिखणैं आल़अ काईथ थिअ। <verse eid="2CH 34:8" /><verse number="9" style="v" sid="2CH 34:9" />तिंयां डेऊऐ माहा प्रोहत हिलकिया सेटा। लेबी मांझ़ै ज़ुंण बिधाते भबने प्रऊल़ी सेटा पहरी थिऐ, तिन्‍नैं दैनै माहा प्रोहता का तिंयां ढब्बै सभाल़ी ज़ुंण बिधाते प्रऊल़ी सेटा पहरी लोगा का दान ढाकै तै। तिन्‍नैं लेबी तै तिंयां ढब्बै एप्रैम, मनिश्शे अर होरी उतरा बाखा बस्सै दै इज़राईली, यहूदा, बिन्यामीन अर एरुशलेम नगरीए लोगा का झाल़ै दै। <verse eid="2CH 34:9" /><verse number="10" style="v" sid="2CH 34:10" />तेखअ सभाल़ै तिंयां ढब्बै तिन्‍नां चिई का ज़हा लै राज़ै बिधाते भबने मराम्मती करने ज़िम्मैंबारी थिई सभाल़ी दी। तिन्‍नैं दैनी तेता मांझ़ै काठे कारीगीर अर <verse eid="2CH 34:10" /><verse number="11" style="v" sid="2CH 34:11" />पात्थरे कारीगीरे मज़दूरी अर बाकी ढब्बै करै लऐ तिन्‍नैं तेता करै काठ-पात्थर अर होर च़िज़ा मोलै ज़ुंण भबने मराम्मती दी कामैं एछे अर तिन्‍नां होरी घअरे मराम्मती करना लै बी किऐ खर्च़ ज़ुंण यहूदे राज़ै कई राज़ै ढोल़ी तै पाऐ दै।<verse eid="2CH 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CH 34:12" />ज़हा का बिधाते भबने मराम्मत करनैओ काम त सभाल़अ द, तिंयां थिऐ शुचै-पाक्‍कै मणछ। कारीगीरे कामों धैन डाहणैं आल़ै दरोगै थिऐ मरारी टोली का जहात अर ओबेदियो, कहात टोली का जकर्या अर मशूलाम। लेबी तै कामां कराऊंणै आल़ै ज़ाण-प्रबीण अर गाज़ै-बाज़ैओ बी थिअ तिन्‍नां का थोघ कि कुंण राग केभै बाज़ा। <verse eid="2CH 34:12" /><verse number="13" style="v" sid="2CH 34:13" />होर तै लेबी मांझ़ै बेठूए कामों धैन डाहणैं आल़ै अर होरी कई कामों धैन डाहणैं आल़ै, कई तै भबना ओर्ही-पोर्ही पहरी अर कई साब-कताब लिखी डाहणैं आल़ै काईथ।<verse eid="2CH 34:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CH 34:14" />ज़ांऊं भढारा का ढब्बै बागा लै काढदै लागै, हिलकिया माहा प्रोहता भेटी तेथ बिधाते गूर मोसा लिखी दी बधाने कताब। <verse eid="2CH 34:14" /><verse number="15" style="v" sid="2CH 34:15" />हिलकिया माहा प्रोहतै बोलअ शापान काईथा लै, “मुंह भेटी बिधाते भबनै बधाने कताब।” तेखअ दैनी सह कताब तेऊ शापान काईथे हाथै। <verse eid="2CH 34:15" /><verse number="16" style="v" sid="2CH 34:16" />शापानै निंईं सह कताब राज़ै सेटा संघा बोलअ इहअ, “ज़िहअ-ज़िहअ काम तंऐं हाम्हां का सभाल़अ त, सह तेता आसा हाम्हैं तिहअ ई करदै लागै दै। <verse eid="2CH 34:16" /><verse number="17" style="v" sid="2CH 34:17" />ज़ुंण ढब्बै बिधाते भबने तै डाहै दै, तिंयां हेरै हाम्हैं तिन्‍नां का दैई ज़हा लै बिधाते भबने मराम्मतीओ काम आसा सभाल़अ द।” <verse eid="2CH 34:17" /><verse number="18" style="v" sid="2CH 34:18" />तेखअ बोलअ शापान काईथै राज़ै लै इहअ, “माहा राज़अ, माहा प्रोहत हिलकिया दैनी मुखा अह कताब बी।” तेखअ लागअ शापान तैहा कताबा का ज़ोरै-ज़ोरै पहल़दअ।<verse eid="2CH 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CH 34:19" />बधाने कताबे गल्‍ला शूणीं धेल़ै दुखा दी राज़ै आपणैं झिकल़ै। <verse eid="2CH 34:19" /><verse number="20" style="v" sid="2CH 34:20" />तेखअ किअ राज़ै जोशिया हिलकिया प्रोहत, शापाने शोहरू आहीकाम, मिके शोहरू अबदोन, शापान काईथ अर असाया नाओंए एकी दरबारी लै इहअ हुकम, <verse eid="2CH 34:20" /><verse number="21" style="v" sid="2CH 34:21" />“बिधाता हणीं मुल्है अर यहूदा मुल्खे परज़ा लै खास्सी रोश्शै आई दी! किल्हैकि म्हारै दादै-बाबै निं सह बधान पूरअ किअ ज़ुंण ऐहा कताबा दी लिखअ द आसा! तम्हैं एछा मुंह बाखा बिधाता पुछ़ी कि बिधाता किहअ बोला कि हाम्हैं इज़राईली करे।”<verse eid="2CH 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 34:22" />तेखअ डेऊऐ हिलकिया प्रोहत, शापाने शोहरू आहीकाम, मिके शोहरू अकबोर, शापान बज़ीर अर असाया नाओं दरबारी हुल्दा नाओंए एकी बेटल़ी सेटा पुछ़दै। तेसे लाल़ै नाअं त शलूम अर सह थिअ बिधाते भबनै झिकल़ैओ भढारी। शलूम थिअ तोखातो शोहरू अर हासराहो पोचअ। हुल्दा रहा ती राज़धानी एरुशलेम नऊंऐं गराऊंऐं। तिन्‍नैं खोज़ी तैहा का राज़ै बाखा सारी गल्‍ला। <verse eid="2CH 34:22" /><verse number="23" style="v" sid="2CH 34:23" />हुल्दा बोलअ तिन्‍नां लै इहअ कि तम्हैं डेओआ राज़ै सेटा बापस फिरी, संघा खोज़ै राज़ै का इहअ समाद कि इज़राईलो परमेशर बिधाता बोला इहअ, <verse eid="2CH 34:23" /><verse number="24" style="v" sid="2CH 34:24" />“मंऐं लाई एरुशलेम नगरी अर तेथ बस्सै दै सोभी मणछा लै तेही ई सज़ा दैई ज़ुंण तैहा कताबा दी आसा लिखअ द ज़ुंण कताब यहूदा मुल्खे राज़ै नदरी पहल़ी। <verse eid="2CH 34:24" /><verse number="25" style="v" sid="2CH 34:25" />यहूदा मुल्खै बस्सी दी परज़ा समझ़अ हुंह नकदरअ। तिंयां लागै पराऐ देअआ पूज़दै अर बल़ीदान करदै। तिन्‍नैं आणी मुल्है खास्सी रोश्शै अर ऐबै निं मेरअ रोश्श फांभअ हंदअ। <verse eid="2CH 34:25" /><verse number="26-27" style="v" sid="2CH 34:26-27" />यहूदे राज़ै जोशिया ज़ुंणीं तम्हैं पुछ़दै छ़ाडै, तेऊ का खोज़ै इहअ कि हुंह इज़राईलो परमेशर बिधाता बोला तेरै बारै इहअ कि मंऐं भाल़अ कि तूह किहअ दुखी हुअ ज़ांऊं तंऐं इहअ शूणअ कि अह देश अर एथ बस्सै दै लोग हणैं पठी खतम। तंऐं धेल़ै तेऊ दुखै आपणैं झिकल़ै अर मंऐं शूणअ तूह लेरदअ बी। <verse eid="2CH 34:26-27" /><verse number="28" style="v" sid="2CH 34:28" />ऐबै करनअ मुंह इहअ कि ज़ुंण आफ़त मुंह एरुशलेम नगरी लै पाणीं, तैहा निं हुंह तेरी ज़िऊंदी ज़िता पल़णै दैंदअ, ईंयां गल्‍ला निभदी निं ताह आपणीं आछी नदरी भाल़णीं।”<verse eid="2CH 34:28" /></para>
  <para style="s">जोशिया किई मुहुर्ती पूज़ा बंद</para>
  <para style="r">(<ref loc="2KI 23:1-20">2 राज़ै 23:1-20</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="2CH 34:29" />राज़ै जोशिया शादै यहूदा मुल्खे अर एरुशलेम नगरीए सोभ सैणैं, <verse eid="2CH 34:29" /><verse number="30" style="v" sid="2CH 34:30" />संघा डेऊऐ तिंयां सोभै ज़ण्हैं एरुशलेम बिधाते भबना लै, तिन्‍नां संघै तै लेबी, गूर, प्रोहत अर यहूदा मुल्खे आम आदमी बी। ज़ांऊं सोभै ज़ण्हैं तिधी थिऐ, राज़ै जोशिया पहल़ी बधाने सह कताब बाढै ज़ोरै-ज़ोरै ज़ुंण बिधाते भबनै भेटी ती। <verse eid="2CH 34:30" /><verse number="31" style="v" sid="2CH 34:31" />ज़ांऊं जोशिया राज़अ पहल़ी मुक्‍कअ, सह खल़्हुअ बिधाते भबनै एकी थाम्हा नेल़। संघा बझ़ैल़ै सोभी लोगा का सोह खाणैं कि आझ़ा बाद मनणअ हाम्हां बिधातो बधान, सोभ बिधी अर हुकम तत्त-दिला का। हाम्हां करनअ तिहअ ई ज़िहअ ऐहा बधाने कताबा दी आसा लिखदअ द। ज़ेतरै लोग तिधी थिऐ, तिन्‍नैं सोभी तिन्‍नैं सोभी किई बिधाते सोह खाई करार। <verse eid="2CH 34:31" /><verse number="32" style="v" sid="2CH 34:32" />ज़ुंण बिन्यामीन गोत्रा मांझ़ै एरुशलेम तै आऐ दै, तिन्‍नां का बी बझ़ैल़ी बिधाते नाओंऐं करार करनै। एरुशलेम बस्सै दै सोभ लोग लागै तिहअ ई करदै ज़िहअ तिन्‍नें दादा-बाबो परमेशर च़ाहा त कि तिंयां करे। <verse eid="2CH 34:32" /><verse number="33" style="v" sid="2CH 34:33" />राज़ै जोशिया किई इज़राईली मांझ़ै सारै का च़िल़्हखरी मुहुर्ती अर छ़ोतली च़िज़ा दूर। आपणीं ज़िऊंदी ज़िता डाहै तेऊ सोभ लोग आपणैं दादा-बाबे परमेशर बिधाते स्तोती करदै लाई।<verse eid="2CH 34:33" /></para>
  <chapter eid="2CH 34" />
  <chapter number="35" style="c" sid="2CH 35" />
  <para style="s">राज़ै जोशिया मनाऊंअ ऊवार्णैओ थैर</para>
  <para style="r">(<ref loc="2KI 23:21-23">2 राज़ै 23:21-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 35:1" />राज़ै जोशिया मनाऊंअ बिधाते अदर करना लै राज़धानी एरुशलेम ऊवार्णैओ थैर, च़ौदा च़ैत्रै किअ तिन्‍नैं रिठ काटी ऊवार्णअ। <verse eid="2CH 35:1" /><verse number="2" style="v" sid="2CH 35:2" />राज़ै जोशिया दैनै प्रोहता का तिन्‍नें काम सभाल़ी कि कहा किज़ै-किज़ै करनअ संघा दैनअ तिन्‍नां लै हैअ कि तम्हैं रहा बिधाते भबनै आपणीं-आपणीं च़ाकरी करदै लागी। <verse eid="2CH 35:2" /><verse number="3" style="v" sid="2CH 35:3" />ज़ुंण लेबी बिधाते भबनै च़ाकरी करा तै अर ज़ुंण इज़राईली मणछा लै बधाने शिक्षा दैआ तै, तेऊ किअ तिन्‍नों झाल़अ संघा बोलअ तिन्‍नां लै इहअ, “बिधाते पबित्र करारे मणशू डाहा दाबेदे शोहरू राज़ै सुलैमानै बणाऐं दै भबनै। ऐबै निं तम्हां एता ज़ैगै-ज़ैगै रगाऊंणे ज़रुरत आथी। ऐबै करनी तम्हैं इधी का आपणैं परमेशर बिधाता अर तेऊए परज़े च़ाकरी। <verse eid="2CH 35:3" /><verse number="4" style="v" sid="2CH 35:4" />तम्हैं करा बिधाते भबनै आपणीं-आपणीं टोलीए साबै ज़ुदअ-ज़ुदअ काम ज़ेही ज़िम्मैंबारी तम्हां लै इज़राईले राज़ै दाबेद अर तेऊए शोहरू सुलैमानै आसा सभाल़ी दी। <verse eid="2CH 35:4" /><verse number="5" style="v" sid="2CH 35:5" />तम्हैं लेबी बांढिआ आप्पू मांझ़ै ज़ुदै-ज़ुदै छ़ुंढा दी, संघा करै इज़राईलीए तिन्‍नां-तिन्‍नां टोली का भैंट लई आऐ दै लोगे मज़त ज़हा-ज़हा टोलीए ज़िम्मैंबारी तम्हां का ज़ुदी-ज़ुदी आसा सभाल़ी दी। <verse eid="2CH 35:5" /><verse number="6" style="v" sid="2CH 35:6" />ज़ेभै लोग तम्हां सेटा ऊवार्णअ आणे, तेऊ काटै तम्हैं। तम्हैं करा बधाने साबै आपणीं शुधी संघा करा आपणैं इज़राईली भाई-बंधे मज़त कि तिंयां तेऊ साबै ऊवार्णैओ थैर मनाओए ज़िहअ बिधाता आपणैं गूर मोसा का खोज़ी बोली आसा डाहअ द।”<verse eid="2CH 35:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CH 35:7" />राज़ै जोशिया दैनै लोगा लै आपणीं भेडा-बाकरीए हेल़्ही का तिह हज़ार होछ़ै गाभू अर छ़ेल्हू, चअन हज़ार बल्द कि लोग ऊवार्णे थैरा लै बल़ीदान करे। <verse eid="2CH 35:7" /><verse number="8" style="v" sid="2CH 35:8" />राज़े कार-करिंदै बी दैनै दिला का लेबी, प्रोहत अर लोगा लै चैणैं कि तिंयां बल़ीदान करे। बिधाते भबनै कार-करिंदै मांझ़ै माहा प्रोहत हिलकिया, जकर्या अर जेहीएलै दैनै प्रोहता लै दूई हज़ार छ़ह शौ होछ़ै गाभू अर छ़ेल्हू अर चअन शौ बल्द कि ऊवार्णे थैरा लै काटे। <verse eid="2CH 35:8" /><verse number="9" style="v" sid="2CH 35:9" />कननया अर तेऊए दूई भाई शमयाह अर नतनेल, हशाबिया, जेइल, जोजबाद ज़ुंण लेबी मांझ़ै सैणैं थिऐ, तिन्‍नैं सोभी दैनै पांज़ हज़ार होछ़ै गाभू अर छ़ेल्हू अर पांज़ शौ बल्द होरी लेबी लै कि तिंयां ऊवार्णे थैरा लै बल़ीदान करे।<verse eid="2CH 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CH 35:10" />ज़ांऊं ऊवार्णे थैरा लै सारी तैरी करी मुक्‍कै, लेबी अर प्रोहत खल़्हुऐ आपणीं-आपणीं ज़ैगा ज़ुंण काम तिन्‍नां लै राज़ै सभाल़अ त। <verse eid="2CH 35:10" /><verse number="11" style="v" sid="2CH 35:11" />ज़ांऊं ऊवार्णे गाभू, छ़ेल्हू काटै, लेबी काढी तिन्‍नें खाला पोर्ही अर प्रोहतै छ़ल़िकअ बल़ीदान किऐ दै तिन्‍नां पशूओ लोहू बेदी दी। <verse eid="2CH 35:11" /><verse number="12" style="v" sid="2CH 35:12" />बिधाता लै हूम बल़ीदान करने पशू तै तिन्‍नैं हेल़्ही का ज़ुदै डाहै दै, तिंयां दैनै तिन्‍नैं सोभी लोगा लै तिन्‍नें टोलीए साबै बांडी ताकि तिंयां तिन्‍नां पशू बधाने कताबा दी मोसा गूरै खोज़ी दी बिधीए साबै बिधाता लै हूम करे। <verse eid="2CH 35:12" /><verse number="13" style="v" sid="2CH 35:13" />तिन्‍नैं भुज़ी ऊवार्णे आगी दी ज़ेही बधाना दी तेते बिधी थिई खोज़ी दी, अर ज़ुंण शिखा ज़ुदी पबित्र दी डाही दी, तिंयां सटेऊई हांडै अर बतिल्‍लै अर बल़ाही दी। तेखअ दैनी झ़ट-पटै तिंयां शिखा लोगा लै बांडी। <verse eid="2CH 35:13" /><verse number="14" style="v" sid="2CH 35:14" />सारी धैल़ा रहै प्रोहत बल़ीदान करदै अर बल़ीदान किऐ दै पशूए च़र्बी बेदी दी हूम करदै लागी। ज़ांऊं सोभै बल़ीदान करी मुक्‍कै। तेखअ बणाईं लेबी ऊवार्णे शिखा आप्पू लै बी अर तिन्‍नां प्रोहता लै ज़ुंण हारणे आद-लुआद थिऐ।<verse eid="2CH 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CH 35:15" />लेबी मांझ़ै त राज़ै दाबेदै असाप टोलीए लुआदा का गाज़ै-बाज़ै आल़ै, पहरीओ काम सभाल़अ द, तिंयां थिऐ असाप, हमान अर जदूतून ज़ुंण राज़ैओ गूर थिअ। इनो काम त इहअ कि ईंयां निं आपणीं ज़ैगा का ओर्ही-पोर्ही डेऊई ई सकदै तै। इना लै दैनी होरी लेबी ऊवार्णे शिखा बणाईं। <verse eid="2CH 35:15" /><verse number="16" style="v" sid="2CH 35:16" />तधू मनाऊंअ बिधाते अदर करना लै ऊवार्णैओ थैर संघा किऐ बल़ीदान बेदी दी हूम ज़िहअ राज़ै जोशिया हुकम त किअ द।<verse eid="2CH 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 35:17" />इज़राईली मांझ़ै ज़ुंण लोग ऊवार्णे थैरा लै थिऐ आऐ दै, तिन्‍नैं मनाऊंअ तैहा धैल़ी ऊवार्णैओ थैर अर तेखअ मनाऊंअ साता धैल़ी तैणीं आखरी रोटीओ थैर। <verse eid="2CH 35:17" /><verse number="18" style="v" sid="2CH 35:18" />ऊवार्णे थैरा लै थिऐ एरुशलेम नगरीए सोभ लोग, सारै यहूदा अर उतरा बाखा इज़राईल मुल्खा का लोग आऐ दै। राज़अ जोशिया, प्रोहत अर लेबी बी थिऐ सोभै। बिधाते गूर शमूएले ज़मानै ओर्ही तधू तैणीं निं ऊवार्णे थैरे एचल़ी बडी जाचा कधि हुई ती नां तधा का आजी कुंणी राज़ै ऊवार्णैओ थैर इहअ बडअ मनाऊंअ त। <verse eid="2CH 35:18" /><verse number="19" style="v" sid="2CH 35:19" />अह मशूर ऊवार्णैओ थैर मनाऊंअ राज़ै जोशिया आपणैं राज़ा दी ठार्हुई साला।<verse eid="2CH 35:19" /></para>
  <para style="s">राज़ै जोशियो राज़ मुक्‍कअ</para>
  <para style="r">(<ref loc="2KI 23:28-30">2 राज़ै 23:28-30</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2CH 35:20" />राज़अ जोशिया मुक्‍कअ बिधाते भबना लै इना एतरै कामां करी। थोल़अ बगत बितअ कि मिसर देशो राज़अ नेकू छ़ेल़अ फरात दरैऊआ नेल़ कर्कमीश नगरी दी जुध। राज़अ जोशिया डेऊअ तेऊए मकाबलै करदअ। <verse eid="2CH 35:20" /><verse number="21" style="v" sid="2CH 35:21" />पर राज़ै नेकू छ़ाडै दूत संघा दैनअ जोशिया लै इहअ समाद, “मेरअ अह जुध निं ताह यहूदा मुल्खे राज़ै संघै आथी! नां हुंह ताह संघै मकाबलै करदअ आथी आअ द।” पर मुल्है बोलअ बिधाता कि हुंह आपणैं दुशमणा मारदअ ज़ेतरअ हई सके तेतरअ छ़ेक्‍कै चुटी पल़े। बिधाता आसा मुंह बाखा, तूह निं मुंह रोक्‍कदअ लागै नांईं ताह हेरे तेऊ करनअ तूह पठी बरैबाद। <verse eid="2CH 35:21" /><verse number="22" style="v" sid="2CH 35:22" />पर जोशिया ती डाही हेरी दी कि नेकू संघै लणअ मकाबलअ करी। तेऊ निं तैहा गल्‍ला दी धैन दैनअ ज़ुंण गल्‍ल बिधाता राज़ै नेकू बाती बोली ती। राज़ै जोशिया डेऊअ मगिदो सऊंऐं मुल्खै भेश बदल़ी नेकू संघै मकाबलै करदअ।<verse eid="2CH 35:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 35:23" />तेऊ जुधा लै लागी जोशिया राज़ै कुदरती मिसर देशे सैना मांझ़ै एकी सपाहीए कतीरै। जोशिया किअ आपणैं दासा लै हुकम, “हुंह हुअ खास्सअ ज़खमी, तूह निंऊं मुंह इधा का दूर।” <verse eid="2CH 35:23" /><verse number="24" style="v" sid="2CH 35:24" />तिन्‍नैं काढअ सह तेऊए रथा का पोर्ही संघा बशैल़अ तिधी नेल़ दुजै रथा प्रैंदै संघा पजैल़अ राज़धानी एरुशलेम अर तिधी हुई तेऊए मौत। तेखअ डाहअ सह तिन्‍नैं राज़ै दाबणे मल्थाना दी दाबी। सारै यहूदा मुल्ख अर एरुशलेम नगरीए परज़ा किअ जोशिया राज़ै लै शोग।<verse eid="2CH 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CH 35:25" />बिधाते गूर जेरमयाह आसा जोशिया राज़े अदर करना लै तेऊ मरने गिह गांठी दी। तधा बाद बणअ अह रबाज़ कि ज़ेभै बी इज़राईली राज़ै जोशिया मरने आदगारी लै शोग करा तै, तेभै बोला तै सोभ मर्ध अर बेटल़ी तैहा गिहा। अह गिह भेटा लामणे कताबा दी।<verse eid="2CH 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2CH 35:26" />जोशिया राज़ै ज़ुंण बी काम किऐ, सह बिधाता लै किहअ शुचअ-पाक्‍कअ रहअ अर सह बधाना किहअ तत्त-दिला का मना त, <verse eid="2CH 35:26" /><verse number="27" style="v" sid="2CH 35:27" />तेऊओ अह इतिहास आसा शुरू का खिरी तैणीं इज़राईल अर यहूदा मुल्खे राज़े कताबा दी लिखी डाहअ द।<verse eid="2CH 35:27" /></para>
  <chapter eid="2CH 35" />
  <chapter number="36" style="c" sid="2CH 36" />
  <para style="s">यहूदा मुल्खो राज़अ जोअहाज</para>
  <para style="r">(<ref loc="2KI 23:30-35">2 राज़ै 23:30-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2CH 36:1" />यहूदा मुल्खे परज़ा किअ एरुशलेम नगरी जोशिया राज़े शोहरू जोअहाजो अभिषेक संघा बणाअं सह जोशिये ज़ैगा आजू यहूदा मुल्खो राज़अ। <verse eid="2CH 36:1" /><verse number="2" style="v" sid="2CH 36:2" />ज़धू जोअहाज यहूदा मुल्खो राज़अ बणअ, तधू त सह त्रेई सालो। तेऊ किअ एरुशलेम नगरी का यहूदा मुल्खै चिई भिन्‍नैं तैणीं राज़। <verse eid="2CH 36:2" /><verse number="3" style="v" sid="2CH 36:3" />मिसर देशे राज़ै किअ जोहाज कैद संघा बोलअ तेऊ देशा का चऊती कुंटल़ च़ंदी अर चऊती किलू सुन्‍नअ कारअ भरना लै। <verse eid="2CH 36:3" /><verse number="4" style="v" sid="2CH 36:4" />मिसर देशे राज़ै नेकू बशैल़अ तेखअ जोशिया राज़ैओ शोहरू एलीकीम राज़धानी एरुशलेम यहूदा मुल्खो राज़अ अर तेऊओ नाअं डाहअ बदल़ी करै जेहोकीम। जोअहाज राज़अ निंयं तेऊ आप्पू संघै कैद करी मिसर देशा लै।<verse eid="2CH 36:4" /></para>
  <para style="s">यहूदा मुल्खै जेहोकीम राज़अ</para>
  <para style="r">(<ref loc="2KI 23:36-24:7">2 राज़ै 23:36—24:7</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="2CH 36:5" />ज़धू जेहोकीम यहूदा मुल्खो राज़अ बणअ, तधू ती तेऊए अमर पच्‍ची साले। तेऊ किअ एरुशलेम नगरी का गैरा साला तैणीं राज़। तेऊ किअ तिहअ ई पाप ज़ेता का बिधाता नफरत करा। <verse eid="2CH 36:5" /><verse number="6" style="v" sid="2CH 36:6" />बाबेल देशे राज़ै नबूकदनेसरै छ़ेल़अ यहूदा मुल्खा संघै जुध, तेऊ किअ राज़अ जेहोकीम कैद संघा निंयं शांघल़ी करै बान्हीं बाबेल देशा लै। <verse eid="2CH 36:6" /><verse number="7" style="v" sid="2CH 36:7" />नबूकदनेसर राज़ै निंयैं बिधाते भबना का कई किम्मती च़िज़ा, संघा डाही तिंयां बाबेल देशै पुजी आपणैं मैहलै। <verse eid="2CH 36:7" /><verse number="8" style="v" sid="2CH 36:8" />जेहोकीम राज़ै ज़िहै-ज़िहै काम किऐ, ज़ुंण तेऊ कदुष्ट अर च़िल़्हखरै काम बी किऐ, तिंयां सोभै गल्‍ला आसा यहूदा अर इज़राईल मुल्खे इतिहासे कताबा दी लिखी डाही दी। तेऊ बाद बणअ तेऊओ शोहरू जेहोकीन यहूदा मुल्खो राज़अ।<verse eid="2CH 36:8" /></para>
  <para style="s">यहूदा मुल्खै जेहोकीन राज़अ</para>
  <para style="r">(<ref loc="2KI 24:8-17">2 राज़ै 24:8-17</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="2CH 36:9" />ज़धू जेहोकीन यहूदा मुल्खो राज़अ बणअ, तेऊए अमर ती तधू ठारा साले। तेऊ किअ एरुशलेम नगरी का चिई भिन्‍नैं अर दसा धैल़ी तैणीं राज़। तेऊ बी किअ तिहअ ई पाप ज़ेता का बिधाता नफरत करा। <verse eid="2CH 36:9" /><verse number="10" style="v" sid="2CH 36:10" />नऊंअ संबत एछदी छ़ाडै बाबेल देशे राज़ै नबूकदनेसरे सैनापति एरुशलेम नगरी लै संघा निंयं यहूदा मुल्खो राज़अ जेहोकीन कैद करी बाबेल देशा लै अर बिधाते भबना का किम्मती च़िज़ा बी बझ़ैल़ै तेऊ बाबेल देशा लै आणनैं। नबूकदनेसरै बणाअं जेहोकीमे ज़ैगा तेऊओ च़ाच़ू सिदकिया राज़अ।<verse eid="2CH 36:10" /></para>
  <para style="s">यहूदा मुल्खै राज़अ सिदकिया</para>
  <para style="r">(<ref loc="2KI 24:18-20">2 राज़ै 24:18-20</ref>; <ref loc="JER 52:1-3">जेरमयाह 52:1-3</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="2CH 36:11" />ज़धू सिदकिया यहूदा मुल्खो राज़अ बणअ, सह थिअ तधू इक्‍की सालो। तेऊ किअ एरुशलेम नगरी का गैरा साला तैणीं राज़। <verse eid="2CH 36:11" /><verse number="12" style="v" sid="2CH 36:12" />राज़ै सिदकिया बी किअ पाप ज़ेता बिधाता नांईं च़ाहंदअ त कि सह करे। बिधाता दैनी आपणैं गूर जेरमयाह बाती तेऊ लै चतैनगी बी, पर तेऊ निं तेथ बाखा धैन बी दैनअ।<verse eid="2CH 36:12" /></para>
  <para style="s">एरुशलेम नगरीए बरैबादी</para>
  <para style="r">(<ref loc="2KI 25:1-21">2 राज़ै 25:1-21</ref>; <ref loc="JER 52:3-11">जेरमयाह 52:3-11</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2CH 36:13" />खिरी किअ सिदकिया बाबेल देशे राज़ै नबूकदनेसरा लै द्रोह ज़ुंणीं तेऊ का बिधाते नाओंऐं कसमा थिई खैऊई दी कि सह सदा तेऊए पक्षा दी रहे। पर सिदकिया हुअ इहअ काठअ कि सह निं इज़राईले परमेशर बिधाता बाखा बी फिरअ। <verse eid="2CH 36:13" /><verse number="14" style="v" sid="2CH 36:14" />एता का लाऊआ, यहूदा मुल्खे सैणैं, प्रोहत अर होरी लोगै बी किअ आप्पू ओरी-पोरी होरी देशा ज़िहअ मुहुर्ती पूज़ा करी बिधाता लै विश्वास घात अर इहअ करै लाई तिन्‍नैं एरुशलेम तेऊ भबनै बी छ़ोत ज़ुंण बिधाता आप्पै पबित्र थिअ किअ द। <verse eid="2CH 36:14" /><verse number="15" style="v" sid="2CH 36:15" />ज़हा बिधाता तिन्‍नें दाद-बाब मना तै, सह रहअ कबल्‍लअ तिन्‍नां सेटा लै आपणैं गूर छ़ाडी चतैनगी दैंदअ लागी। किल्हैकि बिधाता निं च़ाहंदअ त कि तिंयां अर सह भबन बरैबाद होए। <verse eid="2CH 36:15" /><verse number="16" style="v" sid="2CH 36:16" />पर ज़ुंण बी बिधातो दूत तिन्‍नां सेटा एछा त, तिंयां लागा तै तेऊ लै हास्सदै अर ज़ुंण गूर तिन्‍नां सेटा लै एछा तै तिन्‍नें लागा तै तिंयां सुहांगा करदै। खिरी पल़अ तिन्‍नां लै बिधातो इहअ कोप कि तिन्‍नां निं तेता का छ़ुटणा लै बात निस्सी भेटी।<verse eid="2CH 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CH 36:17" />बिधाता दैनअ तिन्‍नां लै बाबेल देशे राज़ै एछणैं। नबूकदनेसरै पाऐ यहूदा मुल्खै खारकै मणछ मारी, इधी तैणीं कि ज़ुंण बिधाते भबनै च़ाकरी करनै आल़ै बी थिऐ तिंयां बी निं तेऊ मारनै का छ़ाडै। तेऊ निं होछ़ै-प्रोढै, मर्ध-बेटल़ी, रोगी-नरोगी कोही लै झींण किई। बिधाता दैनअ तेऊ तिन्‍नां सोभी मारनै। <verse eid="2CH 36:17" /><verse number="18" style="v" sid="2CH 36:18" />बाबेल देशे राज़ै लुटअ बिधातो भबन अर तेते भढार पठी। राज़ै अर तेऊए कार-करिंदे का ज़ेतरी बी धन-माया थिई, सह निंईं तेऊ आप्पू संघै बाबेल देशा लै। <verse eid="2CH 36:18" /><verse number="19" style="v" sid="2CH 36:19" />तेऊ चैल़ी बिधाते भबनै अर एरुशलेम नगरी आग। राज़े मैहलै, होर भबन अर नगरी फेर गहल़े दुआली पाई ढोल़ी अर तेथ लागी दी किम्मती च़िज़ा हुई पठी बरैबाद। <verse eid="2CH 36:19" /><verse number="20" style="v" sid="2CH 36:20" />ज़ुंण तेऊ का ज़िऊंदै बच़ै, तिंयां निंयैं तेऊ आप्पू संघै कैद करी बाबेल देशा लै। तिंयां रहै बाबेल देशे राज़ै अर तेऊए आजू आद-लुआदे तेभै तैणीं गलाम बणी ज़ेभै तैणीं फारसी राज़ै बाबेल देशै कबज़अ निं किअ। <verse eid="2CH 36:20" /><verse number="21" style="v" sid="2CH 36:21" />यहूदा मुल्ख हुअ पठी उज़र अर रित्तअ, इहअ करै हुई सह गल्‍ल पूरी ज़ुंण बिधाता आपणैं गूर जेरमयाह बाती बोली ती, “अह ज़ैगा रहणीं सत्तर साला तैणीं उज़र पल़ी, ताकि ऐहा ज़ैगा बशैघे धैल़ी ज़िहअ बशैघ भेटे ज़ुंण ऐहा ज़ैगा कधि निं भेटअ।”<verse eid="2CH 36:21" /></para>
  <para style="s">राज़ै कुस्रू किअ यहूदी लै आपणैं देशा लै बापस फिरनेओ हुकम</para>
  <para style="r">(<ref loc="EZR 1:1-4">एज्रा 1:1-4</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="2CH 36:22" />कुस्रू बणअ फारस देशै राज़अ, तेऊए राज़ा दी पैहली साला किई बिधाता तिंयां गल्‍ला पूरी ज़ुंण तेऊ आपणैं गूर जेरमयाह बाती बोली ती। बिधाता पाई राज़ै कुस्रूए मन्‍नैं एही कि तेऊ दैनअ च़िठी लिखी तिन्‍नां सोभी देशा लै समाद ज़हा प्रैंदै तेऊओ राज़ थिअ। सह समाद त इहअ,<verse eid="2CH 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CH 36:23" />“हुंह फारसी माहा राज़अ कुस्रू बोला इहअ, स्वर्गे परमेशर बिधाता बणाअं हुंह सोभी देशा प्रैंदै माहा राज़अ। तेऊ बिधाता सभाल़ी मुल्है ज़िम्मैंबारी कि हुंह यहूदा मुल्खै एरुशलेम नगरी तेऊ लै भबन बणांए। ऐबै तम्हां बिधाते परज़ा मांझ़ै ज़ेतरै बी यहूदा लै बापस फिरनअ च़ाहा, तिंयां लागा हांढदै, सह बिधाता रहणअ तम्हां संघै आप्पै।”<verse eid="2CH 36:23" /></para>
  <chapter eid="2CH 36" />
</usx>