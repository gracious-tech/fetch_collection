  <para style="h">आयूब</para>
  <para style="toc1">धर्मीं हंदी बी आयूबै किहै-किहै दाह-दुख ज़िरै</para>
  <para style="toc2">आयूब</para>
  <para style="toc3">आयू.</para>
  <para style="mt1">आयूब</para>
  <para style="imt">धर्मीं हंदी बी आयूबै किहै-किहै दाह-दुख ज़िरै</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: एतो निं कै खास थोघ आथी!</para>
  <para style="ili">सन: 700 का 400 ईसा आजी</para>
  <para style="ip">ऐहा कताबे बारै निं कोही का थोघ आथी कि अह कुंणी आसा लिखी दी। ऐहा कताबा दी बी निं किज़ै इहअ आथी ज़ेता करै थोघ लागे कि अह कुंणी आसा लिखी दी। हई सका कि एता लिखणैं आल़ै खास्सै होए। एता लै बोला इहअ कि पबित्र शास्त्रे सोभी कताबा मांझ़ै आसा अह कताब सोभी का आजी लिखी दी।</para>
  <para style="ip">ऐहा कताबा दी आसा आयूबे बारै लिखअ द कि सह थिअ खास्सअ धर्मीं मणछ अर तेऊ पल़ी बेघै बूरी खरी अर आफ़ता, पर तज़ी बी रहअ सह बिधाते आसरै शुचअ अर धर्मीं मणछ। तेऊए साथी-संघी बी आऐ तेऊ हेरै-भाल़ै अर पुछ़दै कि तेऊ ईंयां बिपदा किल्है पल़ी। ऐहा कताबा दी आसा खासकर आयूब, तेमानी, एलीपज, शूही, बिल्दाद, नमाती, सोपर, बूज़ी एलीहू ज़ुंण एकी-दुजै संघै गल्‍ला करा।</para>
  <para style="ip">आयूब त खास्सी दाह-दुखा ज़िरदअ लागअ द, कई बारी बोला सह इहअ कि एते बारै खोज़े बिधाता आप्पै कि मणछा इहै दुख किल्है लागा ज़िरनै। खिरी हुअ बिधाता प्रगट, तेऊ इहअ ता निं खोज़अ कि आयूबा किल्है पल़ै दाह-दुख ज़िरनै पर तेऊ रहैऊअ इहअ कि ज़ुंण काम बिधाता करा तेता निं मणछ कधि समझ़ी सकदै। मणछ निं तेता करी सकदै ज़ुंण बिधाता करा। बिधाता बोलअ इहअ कि आयूब करनअ आजू बी मेरअ सोभी का खास्सअ धर्मीं भगते रुपै आद।</para>
  <para style="ip">खिरी लागा हाम्हां ऐहा कताबा दी थोघ कि बिधाता आयूबा लै केही खास्सी बर्गत दैनी, खिरी बणाअं बिधाता सह पैहलै का दुगणअ सेठ। पर आयूब निं तज़ी बी समझ़ी बोल़अ कि तेऊ दाह-दुख किल्है पल़ै ज़िरनै। पर तेऊ निं तेतरी खरी हंदी बी बिधाते च़ाकरी छ़ाडी। आयूब रहा त ऐहा आशा कि बिधाता हेरनअ सह एकी धैल़ै ईंयां खरी अऊखी दूर करी बच़ाऊई। सह बोला त इहअ:</para>
  <para style="ib" />
  <para style="iq1">एतरअ आसा मुखा थोघ कि ज़िऊंदअ परमेशर ज़ुंण स्वर्गै आसा,</para>
  <para style="iq1">च़ाऐ मेरी सारी देही बी चिजे-शल़े,</para>
  <para style="iq2">तज़ी बी लणैं मुंह ऐहा देही दी बिधाते दर्शण करी।</para>
  <para style="iq1">मुंह भाल़णअ सह आप्पै आपणीं आछी,</para>
  <para style="iq2">हुंह आसा तैहा घल़ी न्हैल़अ-भाल़अ लागअ द।</para>
  <para style="ipr">(19:25-27)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">आयूब हुअ पठी दाल़जी 1:1—2:13</para>
  <para style="io1">आयूब लागअ आपणैं चिई साथी संघै गल्‍ला करदअ 3:1—31:40</para>
  <para style="io1">एलीहू बोलअ इहअ कि बिधाता हेरनी तेरी खरी भाल़ी 32:1—37:24</para>
  <para style="io1">बिधाता बोलअ इहअ कि आयूबो मालक आसा हुंह आप्पै 38:1—41:34</para>
  <para style="io1">बिधाता दैनी आयूबा लै दुगणीं बर्गत 42:1-17</para>
  <chapter number="1" style="c" sid="JOB 1" />
  <para style="s1">राख्सै किअ आयूब पठी बरैबाद</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1" />ऊज़ नाओंए देशै रहा त एक मणछ, तेऊ नाअं त आयूब। सह थिअ खास्सअ धर्मीं मणछ अर सह रहा त बिधाते डरा हेठै, तेऊ निं कधि किछ़ै पाप किअ।<verse eid="JOB 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOB 1:2" />आयूबे थिऐ सात शोहरू अर चअन शोहरी। <verse eid="JOB 1:2" /><verse number="3" style="v" sid="JOB 1:3" />तेऊ का थिऐ खास्सै डागै-चैणें हेल़्ही, सात हज़ार भेडा, चअन हज़ार ऊँट, पांज़ शौ ज़ोल़ी बल्द, पांज़ हज़ार गाधी अर खास्सै दास-दासी। सह थिअ पुर्बा बाखा देशे लोगा मांझ़ै सोभी का सेठ मणछ।<verse eid="JOB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4" />आयूबे शोहरू करा तै बारी-बारी धाम दैई, संघा करा तै तिंयां एकी दुजे घअरै धामा खांदै डेऊई अर आपणीं चिई बैहणी बी लआ तै तिंयां तेता लै ज़रूर प्राहुंणीं शादी। <verse eid="JOB 1:4" /><verse number="5" style="v" sid="JOB 1:5" />भोज़े दुजै धैल़ै जाआ त आयूब दोत्ती-दोत्थी उझ़ुई संघा करा त सह आपणैं हर शोहरू शुचै करना लै बल़ीदान करी हूम। किल्हैकि सह आयूब सोठा त इहअ कि हई सका कि भूला-बिस्सरा इना मांझ़ै कसरै भलै पाप हुअ होए अर परमेशर रुश्शे! तेते तैणीं करा त सह कबल्‍लअ इहअ ई।<verse eid="JOB 1:5" /></para>
  <para style="s">आयूबे शोहरू-माठै अर ज़ैदात हुई पठी खतम</para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6" />एकी धैल़ै हुअ इहअ, स्वर्ग दूत<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">स्वर्ग दूत </char><char style="ft" closed="false">मूल़ बोली दी परमेशरे पूत</char></note> आऐ बिधाता सेटा, राख्स बी पुजअ तिधी तिन्‍नां सेटा। <verse eid="JOB 1:6" /><verse number="7" style="v" sid="JOB 1:7" />बिधाता पुछ़अ राख्सा का इहअ, “तूह केस्सी गअ एथ पुजी?”</para>
  <para style="p" vid="JOB 1:7">राख्सै दैनअ बिधाता लै इहअ ज़बाब, “हुंह आअ सारी पृथूई हांढ-फेर दैई।”<verse eid="JOB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8" />बिधाता लागअ राख्सा का पुछ़दअ, “तंऐं मेरअ दास आयूब बी भाल़अ? तेऊ सान शुचअ-पाक्‍कअ अर भलअ मणछ निं पृथूई दी कोहै आथी! सह करा मेरअ सोभी का खास्सअ अदर अर बूरअ करनअ निं तेऊ कधू सोठअ बी आथी।”<verse eid="JOB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9" />राख्सै बोलअ बिधाता लै इहअ, “आयूब गअ सच्च़अ तेरअ अदर करदअ, तेता करै हआ तेऊ ई नफअ! <verse eid="JOB 1:9" /><verse number="10" style="v" sid="JOB 1:10" />किल्हैकि तूह करा कबल्‍ली तेऊए ज़ैदात अर टांडै-टबरे फाज़त। तूह दैआ तेऊए हर कामां लै बर्गत, तेऊए डागै-चैणें हेल़्ही करै, तंऐं सारअ देश दैनअ भरी! <verse eid="JOB 1:10" /><verse number="11" style="v" sid="JOB 1:11" />तूह इना सोभी गल्‍ला तेऊ का दूर, कर भाल़ै, तेखअ भाल़ै तूह आप्पै कि तेऊ ताल्है किहअ फिटक दैणअ।”<verse eid="JOB 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12" />बिधाता बोला राख्सा लै, “च़ल्‍ल ठीक आ, ज़िहअ तूह च़ाहा तिहअ करै तूह, पर हेरै आयूबे देही निं पेहुश बी लाई।”</para>
  <para style="p" vid="JOB 1:12">तेखअ लागअ राख्स बिधाता सेटा का हांढदअ।<verse eid="JOB 1:12" /></para>
  <para style="s">आयूबे ज़ैदात अर शोहरू किऐ राख्सै पठी खतम</para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13" />तेखअ हुअ एकी धैल़ै इहअ कि आयूबे शोहरू-शोहरी तै आपणैं ज़ेठै भाईए घअरै खांदै अर नशिल्‍ली दाखे रसा झुटदै लागै दै, <verse eid="JOB 1:13" /><verse number="14" style="v" sid="JOB 1:14" />एक मणछ आअ आयूबा सेटा ठुर्ही संघा खोज़अ इहअ समाद, “हाम्हैं तै खेचै हल़ा लांदै लागै दै अर गाधीए हेल़्ह ती खेचे बाढै च़रदी लागी दी। <verse eid="JOB 1:14" /><verse number="15" style="v" sid="JOB 1:15" />शेबा नगरीए लोग आऐ छ़ुंढ बणाईं करै, तिन्‍नें गोटै हाम्हैं फेरा-फेर, बल्द अर गाधे हेल़्ही निंईं तिन्‍नैं लुटी, तेरै सोभै दास पाऐ तिन्‍नैं तलबारा करै मारी। ताखा समाद खोज़णा लै छ़ुटअ हुंह तिन्‍नां मांझ़ै एक्‍कै।”<verse eid="JOB 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16" />ज़ेतरी सह दास गल्‍ला खोज़ी निं मुक्‍कअ, तेतरी गअ एक होर दास एछी, तेऊ बोलअ इहअ, “सरगा का पल़ी बीज अर तेता करै हुई सारी भेडा-बाकरीए हेल़्ही फुआल दझ़ी खतम। हुंह बच़अ एक्‍कै संघा पुजअ हुंह ताह सेटा समादा खोज़दअ।”<verse eid="JOB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17" />ज़ेतरी सह फुआला बणां का आअ द गल्‍ला खोज़ी निं मुक्‍कअ, तेतरी गअ आयूबो एक होर दास एछी संघा लागअ खोज़दअ, “कसदी ज़ातीए लोग आऐ छ़ुंढ बणाईं, तिन्‍नैं निंईं ऊँटे हेल़्ही लुटी, तिन्‍नां गुआल़ै तेरै दास पाऐ सोभ तिन्‍नैं तलबारा करै मारी, हुंह छ़ुटअ किहअ करै तिन्‍नां का एक्‍कै ज़ण्हअ ज़िऊंदअ, संघा आअ हुंह ठुर्ही ताह सेटा समादा पजैल़अ।”<verse eid="JOB 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18" />ज़ेतरी सह ऊँटा गुआल़अ गल्‍ला करी निं मुक्‍कअ, तेतरी गअ तिधी एक होर दास एछी संघा लागअ इहअ बोल्दअ, “तेरै शोहरू-शोहरी तै तेरै ज़ेठै शोहरूए घअरै कठा हई खांदै-पिंदै लागै दै, <verse eid="JOB 1:18" /><verse number="19" style="v" sid="JOB 1:19" />हेरा-हेरी आई रेगीस्ताना बाखा हारदी-मारदी ढिश-बागर अर घअर ढूल़अ तिन्‍नां प्रैंदै अर तिंयां मूंऐं तेथ दाभूई करै सोभ, तिन्‍नां मांझ़ै बच़अ किहअ करै हुंह एक्‍कै ज़ण्हअ, हुंह आअ ताह सेटा लै समादा खोज़दअ।”<verse eid="JOB 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20" />इना गल्‍ला शूणीं उझ़ुऐ आयूबा दुखै ज़िहै शूल़ अर तेऊ धेल़ै आपणीं घेरीए झिकल़ै। तेऊ छाम्बअ आपणअ मूंड संघा रहअ दुखी उटी बाखा धरनीं पल़ी। <verse eid="JOB 1:20" /><verse number="21" style="v" sid="JOB 1:21" />आयूब लागअ लेरा लांदी इहअ बोल्दअ,</para>
  <para style="q" vid="JOB 1:21">“हुंह आसा आपणीं माए रित्तै हाथै ओदरा का नांगअ आअ द,</para>
  <para style="q" vid="JOB 1:21">मरी करै बी निं मुंह आप्पू संघै किछ़ै निंणअ।</para>
  <para style="q" vid="JOB 1:21">बिधाता ई आसा मुल्है दैणैं आल़अ अर</para>
  <para style="q" vid="JOB 1:21">तेऊ ई निंईं तिंयां सोभै गल्‍ला बापस।</para>
  <para style="q" vid="JOB 1:21">तेऊए लोल़ी सदा ज़ै-ज़ैकार हुई!”<verse eid="JOB 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22" />एतरअ हई बी नां आयूबै पाप किअ अर नां तेऊ बिधाता लै दोश दैनअ।<verse eid="JOB 1:22" /></para>
  <chapter eid="JOB 1" />
  <chapter number="2" style="c" sid="JOB 2" />
  <para style="s1">आयूब हुअ रोगी</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1" />तेखअ हुऐ एकी धैल़ै भिई बिधाते स्वर्ग दूत बिधाता सेटा कठा, राख्स बी गअ तेतरी तिधी पुजी। <verse eid="JOB 2:1" /><verse number="2" style="v" sid="JOB 2:2" />बिधाता हेरअ तेऊ का पुछ़ी, “तूह केस्सी गअ एथ पुजी?”</para>
  <para style="p" vid="JOB 2:2">राख्सै दैनअ बिधाता लै इहअ ज़बाब, “हुंह आअ सारी पृथूई हांढ-फेर दैई।”<verse eid="JOB 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3" />बिधाता लागअ राख्सा का पुछ़दअ, “ताह मेरै दास आयूबा भाल़ी हुई बी ताह दसल्‍ली? मंऐं कै बोलअ त कि तेऊ सान शुचअ-पाक्‍कअ अर भलअ मणछ निं पृथूई दी कोहै आथी! सह करा मेरअ सोभी का खास्सअ अदर अर बूरअ करनअ निं तेऊ कधू सोठअ बी आथी। तंऐं बोलअ थोघै बाझ़ी मुल्है ज़ोरा-ज़ोरी तेऊए सारी ज़ैदात बरैबाद करना लै, एतरअ हई बी आसा सह मुल्है तिहअ ई भरोस्सैमंद।”<verse eid="JOB 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4" />राख्सै बोलअ बिधाता लै इहअ, “ज़ेभै तैणीं मणछे आपणीं घेरी दी खास्सी दाह निं होए, तेभै तैणीं हेरा सह ज़िरी, पर ज़िऊंदै रहणा लै सका सह किछ़ बी करी। <verse eid="JOB 2:4" /><verse number="5" style="v" sid="JOB 2:5" />तेऊए देही दी हाड-मास्सा दी ला भाल़ै दाह, तेखअ भाल़ै तूह तेऊ दैणअ तेरै नाओंआं लै बी फिटक!”<verse eid="JOB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6" />बिधाता बोलअ राख्सा लै इहअ, “च़ल्‍ल ठीक आ, ज़िहअ तूह च़ाहा तिहअ कर, पर हेरे मारी निं तेऊ आथी।” <verse eid="JOB 2:6" /><verse number="7" style="v" sid="JOB 2:7" />तेखअ लागअ राख्स बिधाता सेटा का हांढदअ अर आयूबे सारी घेरी काढै तेऊ मुंडा उंधै घुंढी तैणीं बडै-बडै झोशा लांदै दुखणैं।<verse eid="JOB 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 2:8" />आयूबा लागी सारी घेरी खरोक्खणी सह बेठअ छ़ारे रूल़ी प्रैंदै, संघा लागअ फुटै दै गाडल़ूए ठिक्‍करै करै घेरी खरोक्‍कदअ। <verse eid="JOB 2:8" /><verse number="9" style="v" sid="JOB 2:9" />तेऊए लाल़ी लागी तेऊ लै इहअ बोल्दी, “तूह अज़ी बी बिधाता दी करा भरोस्सअ? अज़ी ताह दसल्‍ली निं हुई? पोर्ही मर बिधाता लै फिटक दैणा लै संघा लाग मरदअ।”<verse eid="JOB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10" />आयूबै बोलअ तैहा लै इहअ, “तूह केही ऐडै ज़ेही गल्‍ल करा! बिधाता ज़ेभै हाम्हां लै भलाई करा, तेता लै हआ हाम्हैं राज्ज़ी! ज़ै बिधाता हाम्हां लै आफ़त पाई, तेता किल्है निं हाम्हैं मंदै?” एतरी आफ़त पल़ी बी निं आयूबै बिधाता लै बूरअ बोली किछ़ै पाप किअ।<verse eid="JOB 2:10" /></para>
  <para style="s">आयूबे चअन साथी आऐ तेऊ झेठू</para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11" />आयूबे चअन साथी तेमान नगरी एलीपज, शूही ज़ैगा का बिल्दाद अर नमाती नगरी का सोपर। ज़ांऊं तिन्‍नां सेटा कुंणी खोज़अ कि आयूब आसा खास्सअ बमार, तिंयां आऐ तेऊ सेटा झेठू। <verse eid="JOB 2:11" /><verse number="12" style="v" sid="JOB 2:12" />आयूबे घअरा नेल़ पुजदी हेरअ दूरा ई का तिन्‍नैं आयूब भाल़ी पर तिंयां निं तेऊ बछ़ैणीं सकै! ज़ांऊं नेल़ पुजी राम्बल़ै करै सह बछ़ैणअ, तिन्‍नैं लाई हिक्‍की-सल़िक्‍की लेरा अर तिन्‍नैं धैल़ै तेऊ दुखै आपणीं घेरीए झिकल़ै बी अर धरना का शोट्टअ उझै तिन्‍नैं माट्टअ-गट्टअ आपणैं मुंडा प्रैंदै।<verse eid="JOB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 2:13" />तिंयां रहै साता धैल़ी साता राची तैणीं तिधी आयूबा सेटा बेशी, पर तिन्‍नैं निं तेऊ संघै किछ़ै गल्‍ला किई, किल्हैकि तिन्‍नैं सोठअ इहअ कि अह निं ऐबै ऐहा दाह का बिज़री ठीक हणैं आल़अ आथी।<verse eid="JOB 2:13" /></para>
  <chapter eid="JOB 2" />
  <chapter number="3" style="c" sid="JOB 3" />
  <para style="s">आयूब लागअ फिटक दैंदअ कि सह पैईदा ई किल्है हुअ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1" />खिरी लागअ आयूब तैहा धैल़ी लै फिटक दैंदअ ज़धू सह पैईदा हुअ। <verse eid="JOB 3:1" /><verse number="2" style="v" sid="JOB 3:2" />आयूबै बोलअ इहअ,<verse eid="JOB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 3:3" />“हे बिधाता, तैहा धैल़ी लोल़ी फिटक लागअ</para>
  <para style="q" vid="JOB 3:3">ज़हा धैल़ी हुंह पैईदा हुअ,</para>
  <para style="q" vid="JOB 3:3">ज़हा राची हुंह मेरी माए ओदरै आअ</para>
  <para style="q" vid="JOB 3:3">तैहा राची बी लोल़ी फिटक लागअ!<verse eid="JOB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 3:4" />हे परमेशर, ज़धू हुंह हुअ सह धैल़ी लोल़ी ती न्हैरी हुई!</para>
  <para style="q" vid="JOB 3:4">सह धैल़ी निं लोल़ी ती कधि आद डाही!</para>
  <para style="q" vid="JOB 3:4">तेथ निं लोल़ी कधि प्रैश्शअ हुअ।<verse eid="JOB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 3:5" />तैहा धैल़ी लै लोल़ी ती छ़ैल्‍ली अर नटिप्प न्हैरअ हुअ,</para>
  <para style="q" vid="JOB 3:5">तेथ लोल़ी तै इहै घणैं काल़ै बादल़ आऐ कि सह काल़ी राची ज़ेही डरैऊंणी होए।<verse eid="JOB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 3:6" />सह राच बी लोल़ी ती जंतरी-पत्री का सदा लै दूर हुई,</para>
  <para style="q" vid="JOB 3:6">ज़हा राची मेरी ईजा का थोघ लागअ कि हुंह आअ तेसे ओदरै।<verse eid="JOB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 3:7" />तैहा राची निं लोल़ी कोहै माए ओदरै आऐ,</para>
  <para style="q" vid="JOB 3:7">नां तैहा राची खुशीओ नाच़-खेल्ह लोल़ी हुअ।<verse eid="JOB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 3:8" />तैहा धैल़ी लै लोल़ी डांऊं-च़ेल्‍लै फिटक दैनअ,</para>
  <para style="q" vid="JOB 3:8">लिबतान नाओं समुंदरो बडअ ज़ीब लोल़ी मेरी परज़ा झ़ैऊअ अर तेऊ लै फिटक दैनअ।<verse eid="JOB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 3:9" />तैहा धैल़ी निं भैणूं तारअ लोल़ी शुझुअ,</para>
  <para style="q" vid="JOB 3:9">तैहा राची भैणे लोल़ी आशा ई खतम हुई।<verse eid="JOB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 3:10" />तैहा राची आअ हुंह माए ओदरै अर आझ़ पल़ी मुंह एऊ संसारे आफ़ता ज़िरनी,</para>
  <para style="q" vid="JOB 3:10">एता पिछ़ू लोल़ी तैहा राची फिटक लागअ।<verse eid="JOB 3:10" /></para>
  <para style="s">हुंह पेटा हंदी ई किल्है निं मूंअ</para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 3:11" />एता का हणअ त भलअ ज़ै हुंह मेरी माए ओदरै जांदअ मरी,</para>
  <para style="q" vid="JOB 3:11">हुंह पेटा हंदी ई किल्है निं मूंअ आथी?<verse eid="JOB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 3:12" />मेरी माऐ किल्है ढाकअ हुंह आपणीं बाह दी?</para>
  <para style="q" vid="JOB 3:12">तैहा किल्है पणैऊंईं मुल्है आपणीं च़ूई?<verse eid="JOB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 3:13" />ज़ै हुंह तधू ई मूंअ हंदअ,</para>
  <para style="q" vid="JOB 3:13">तै हणअ हुंह त हुंह सुत्तअ द अर रामा करदअ लागअ द।<verse eid="JOB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 3:14" />तै हणअ त हुंह पृथूईए तिन्‍नां राज़ै बज़ीरा ज़िहअ,</para>
  <para style="q" vid="JOB 3:14">ज़ुंणी आपणैं मैहलै कांगनरांगै आसा बणाऐं दै।<verse eid="JOB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 3:15" />तै रहणअ त हुंह टिक्‍कै ज़िहअ मौज़ी ज़ुंण सुन्‍नेंओ सेठ हआ अर</para>
  <para style="q" vid="JOB 3:15">ज़सरै मैहलै च़ंदी ई च़ंदी हआ।<verse eid="JOB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 3:16" />भलअ हणअ त मुल्है इहअ ज़ै हुंह मेरी ईजो मेरी बारी लै पैहलै ई जांदअ पेट डेऊई,</para>
  <para style="q" vid="JOB 3:16">तै निं मुंह धुप्पअ भाल़णअ भेटणअ त।<verse eid="JOB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 3:17" />सुरगै डेऊई निं तेखअ मुल्है</para>
  <para style="q" vid="JOB 3:17">कोही कदुष्ट मणछा दुखा दैणअ त,</para>
  <para style="q" vid="JOB 3:17">तिधी हणअ त मुंह नकैंस्सै रहणा लै पल़ी।<verse eid="JOB 3:17" /></para>
  <para style="q">
    <verse number="18-19" style="v" sid="JOB 3:18-19" />तिधी रहा कैदी बी राज्ज़ी-मौज़ी,</para>
  <para style="q" vid="JOB 3:18-19">नां तिधी कुंण कामां लै झांशा-त्रुंगा काढी ढेअ करदअ।</para>
  <para style="q" vid="JOB 3:18-19">तिधी हआ सोभ मशूर अर पाखलै अर सोभै गलामी का आज़ाद।<verse eid="JOB 3:18-19" /></para>
  <para style="s">बिधाता किल्है डाहअ हुंह ज़िऊंदअ</para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 3:20" />ज़ै ज़िन्दगी दी एतरअ दाह-दुख आसा,</para>
  <para style="q" vid="JOB 3:20">तै किल्है डाहअ हुंह बिधाता ज़िऊंदअ?<verse eid="JOB 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 3:21" />हुंह थक्‍कअ न्हैल़ी-न्हैल़ी पर मौत बी निस्सी मुल्है एछी,</para>
  <para style="q" vid="JOB 3:21">दाबी डाही दी धन-माया का खास्सअ आसा हुंह मौता लोल़अ लागअ द।<verse eid="JOB 3:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 3:22" />मेरी सोभी का खास्सी खुशी आसा मेरी एही कि</para>
  <para style="q" vid="JOB 3:22">हुंह लोल़ी त मूंअ।<verse eid="JOB 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 3:23" />मुंह किज़ू लै रहणअ ज़िऊंदै?</para>
  <para style="q" vid="JOB 3:23">फेरा-फेर आसा बिधाता मुल्है आफ़त पाई दी अर</para>
  <para style="q" vid="JOB 3:23">आजू निं मुखा थोघै कि मुंह संघै काल्‍ला धैल़ी किहअ हणअ होए!<verse eid="JOB 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 3:24" />मेरै निस्सी रोटी बी खाहुई, मुंह आसा सुआसी लागी दी,</para>
  <para style="q" vid="JOB 3:24">धअक आसा मुंह कबल्‍ली एही लागी दी ज़िहअ पाणीं रहा पोछदअ लागी।<verse eid="JOB 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 3:25" />ज़हा डरैऊंणी गल्‍ला का हुंह डरा,</para>
  <para style="q" vid="JOB 3:25">मुल्है लागी सह ई गल्‍ल हंदी।<verse eid="JOB 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 3:26" />मुंह नां सुख-शांती आथी नां राम आथी,</para>
  <para style="q" vid="JOB 3:26">अर मुल्है पल़ा कबल्‍ली आफ़ता प्रैंदै आफ़त!”<verse eid="JOB 3:26" /></para>
  <chapter eid="JOB 3" />
  <chapter number="4" style="c" sid="JOB 4" />
  <para style="s">एलीपज लागअ झेठ करदअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 4:1" />तेखअ लागअ तेमान नगरीओ एलीपज इहअ बोल्दअ,<verse eid="JOB 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 4:2" />“आयूब, तूह निं मेरी गल्‍लो बूरअ मनी,</para>
  <para style="q" vid="JOB 4:2">ऐबै निस्सअ मेरै बोल़णैं बाझ़ी रहूई।<verse eid="JOB 4:2" /></para>
  <para style="q">
    <verse number="3-4" style="v" sid="JOB 4:3-4" />तूह दैआ कई लोगा लै सलाह पै,</para>
  <para style="q" vid="JOB 4:3-4">तंऐं किई कई लोगे मज़त करी तिंयां खांदै ज़िऊंदै।</para>
  <para style="q" vid="JOB 4:3-4">ज़ुंण गल़ी ढल़ी च़ाल्‍लै, तिन्‍नां लै दैआ तूह हैअ ताकि तिंयां खल़ै टेक्‍की सके।<verse eid="JOB 4:3-4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 4:5" />पर ऐबै ज़ांऊं ताह आप्पू आफ़त पल़ी, तंऐं चोल़अ आपणअ शाह,</para>
  <para style="q" vid="JOB 4:5">तेरअ गअ एता करै हैअ पठी चुटी।<verse eid="JOB 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 4:6" />तंऐं आसा बिधाते आशा डाही दी! ताह दी खोट बी निं किछ़ै आथी!</para>
  <para style="q" vid="JOB 4:6">ताह लोल़ी त खास्सअ भरोस्सअ अर हैअ हुअ!<verse eid="JOB 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 4:7" />तंऐं कधू इहअ शूणअ बी कि धर्मीं</para>
  <para style="q" vid="JOB 4:7">मणछा लै पल़ी एही घोर आफ़ता अर सह गअ खारकअ ज़ांऐं?<verse eid="JOB 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 4:8" />हुंबी हुअ इहअ भाल़दी सैणअ कि</para>
  <para style="q" vid="JOB 4:8">ज़ुंण मणछ बूरअ बऊआ</para>
  <para style="q" vid="JOB 4:8">तिन्‍नां भेटा लऊंणा लै बी बूरअ ई।<verse eid="JOB 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 4:9" />तिंयां फर्लाऊंणैं बिधाते रोश्शा ढिश-बागरी ज़िहै</para>
  <para style="q" vid="JOB 4:9">संघा हणैं तिंयां पठी बरैबाद।<verse eid="JOB 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 4:10" />कदुष्ट हआ हुश-त्रुंगी आल़ै, तिंयां पाआ सिहा ज़ेही क्रुंगा,</para>
  <para style="q" vid="JOB 4:10">पर बिधाता करा तिन्‍नां आप्पै च़ुप्पी अर</para>
  <para style="q" vid="JOB 4:10">सह पाआ तिन्‍नें दांद चोल़ी।<verse eid="JOB 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 4:11" />ज़ै बुढल़ै सिहा शकार निं भेटअ, सह मरा,</para>
  <para style="q" vid="JOB 4:11">तिन्‍नें बच्च़ै छिंघिआ तेखअ सारै दी।<verse eid="JOB 4:11" /></para>
  <para style="s">मुखा खोज़अ कुंणी भेद</para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 4:12" />मुखा खोज़ी च़ुप्प-च़ुप्पै कुंणी एही गल्‍ल,</para>
  <para style="q" vid="JOB 4:12">सह खोज़ी सुलै करै मेरै काना पिछ़ू।<verse eid="JOB 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 4:13" />हुंह त घणीं निंजा सुत्तअ द</para>
  <para style="q" vid="JOB 4:13">अर मुंह त सुपनअ लागअ द, ज़ांऊं अह गल्‍ल शूणीं मेरअ सुपनअ चुटअ,<verse eid="JOB 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 4:14" />मुंह छ़ुटी डरै काम्मणीं अर दर्छ़णअ,<verse eid="JOB 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 4:15" />मेरै मुंहां बाती डेऊअ ज़िहअ बागरीओ झ़लारअ सह थिई आत्मां,</para>
  <para style="q" vid="JOB 4:15">मेरै उंगरै मुंडे शराल़ बी अर मेरी सारी घेरी आऐ कांडै।<verse eid="JOB 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 4:16" />तेखअ शुझुअ मुखा कि आजू आसा किज़ै खल़अ,</para>
  <para style="q" vid="JOB 4:16">पर हुंह निं बछ़ैणीं सकअ कि सह किज़ै आसा।</para>
  <para style="q" vid="JOB 4:16">तेखअ निं तिधी फेर छ़ेल़ नां छ़ुणक हुई पर</para>
  <para style="q" vid="JOB 4:16">तेखअ शुंण्हुंऐ सुलै करै मुखा इहै बोल,<verse eid="JOB 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 4:17" />‘परमेशरा का शुझिआ कि कोह मणछ निं शुचअ आथी!</para>
  <para style="q" vid="JOB 4:17">मणछ निं आपणैं बणाणैं आल़ै ज़िहै पबित्र आथी।’<verse eid="JOB 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 4:18" />परमेशरा का जाआ आपणैं च़ाकरी करनै आल़ेए खोट बी शुझुई,</para>
  <para style="q" vid="JOB 4:18">सह निं आपणैं स्वर्ग दूता दी बी भरोस्सअ करदअ।<verse eid="JOB 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 4:19" />तम्हैं कै सोठा, ज़ुंण मणछ माट्टै का आसा बणाऐं दै,</para>
  <para style="q" vid="JOB 4:19">ज़ुंण सूल़ी ज़िहै झ़ट च़ारै खतम हणैं,</para>
  <para style="q" vid="JOB 4:19">सह कै तिन्‍नां दी भरोस्सअ करी सका?<verse eid="JOB 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 4:20" />ज़ुंण मणछ दोत्ती ता हआ ज़िऊंदै,</para>
  <para style="q" vid="JOB 4:20">पर उडै सका तिंयां बाझ़ी बोलै मरी!</para>
  <para style="q" vid="JOB 4:20">तिंयां डेओआ सदा लै अर खिरी जाआ तिन्‍नां सोभ बिस्सरी!<verse eid="JOB 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 4:21" />मणछे सोभै गल्‍ला हणीं<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="fq" closed="false">गल्‍ला हणीं </char><char style="ft" closed="false">ज़ुंण बी तेऊ का आसा</char></note> तिन्‍नां का दूर,</para>
  <para style="q" vid="JOB 4:21">हाम्हैं मरनै सोभ बारी-बारी,</para>
  <para style="q" vid="JOB 4:21">पर तज़ी बी निं मणछा अक्ल आथी कि बिधाता किज़ै च़ाहा।”<verse eid="JOB 4:21" /></para>
  <chapter eid="JOB 4" />
  <chapter number="5" style="c" sid="JOB 5" />
  <para style="s">हाक्‍का लाई मांग मज़त</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 5:1" />“आयूब, ज़ोरै-ज़ोरै ला हाक्‍का हैनूं तेरी मज़त करदअ कुंण एछा कि नांईं?</para>
  <para style="q" vid="JOB 5:1">झ़ाणीं कुंण स्वर्ग दूत ताह सेटा एछी जाए!<verse eid="JOB 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 5:2" />ज़ीद-मिश करा ऐडै अर</para>
  <para style="q" vid="JOB 5:2">कबुधी मणछा मारी खतम।<verse eid="JOB 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 5:3" />मंऐं आसा भाल़ै दै ऐडै मणछ सफल हंदै,</para>
  <para style="q" vid="JOB 5:3">पर तिन्‍नां लागा हेरा-हेरी फिटक</para>
  <para style="q" vid="JOB 5:3">संघा हआ तिंयां पठी बरैबाद।<verse eid="JOB 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 5:4" />तिन्‍नें लुआद छ़ुटा बाझ़ी आसरै अर</para>
  <para style="q" vid="JOB 5:4">तिन्‍नें मज़त करदअ निं दालता दी कोहै निखल़दअ।<verse eid="JOB 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 5:5" />मांणक्‍करै अर भुखै मणछ गिम्मा तिन्‍नें</para>
  <para style="q" vid="JOB 5:5">बाल़-शोहल़ लाऐ दै खेचा का साल-फसल बी</para>
  <para style="q" vid="JOB 5:5">अर तिन्‍नें ज़ैदात पाआ पठी लुटी।<verse eid="JOB 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 5:6" />आफ़त निं धूल़ै जैंदरा का एछदी अर</para>
  <para style="q" vid="JOB 5:6">नां खेचा का दुख पज़दअ।<verse eid="JOB 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 5:7" />ज़िहै आगीए कूंडा का उझै लुपल़ै निखल़ा,</para>
  <para style="q" vid="JOB 5:7">तिहअ ई आसा मणछ दुख भोगणा लै बणअ द।<verse eid="JOB 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 5:8" />आयूब, ज़ै तेरी ज़ैगा हुंह हंदअ,</para>
  <para style="q" vid="JOB 5:8">मुंह करनी ती परमेशरा का अरज़ कि सह मेरी मज़त करे।<verse eid="JOB 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 5:9" />ज़ुंण महान काम सह करा, तेते थह निं हाम्हैं लोल़ी सकदै,</para>
  <para style="q" vid="JOB 5:9">ज़ेतरै सह च़मत्कार करा, तेता निं हाम्हैं गणी सकदै।<verse eid="JOB 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 5:10" />सह दैआ पृथूई लै हिंऊंद-भराल़ अर</para>
  <para style="q" vid="JOB 5:10">खेचा लै सरग हणैं।<verse eid="JOB 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 5:11" />सह आसा परमेशर ई ज़ुंण भोल़ै मणछा उछ़टै दी बशैल़ा,</para>
  <para style="q" vid="JOB 5:11">ज़हा शोग हुअ पल़अ द, तेऊ लै आणा सह खुशी।<verse eid="JOB 5:11" /></para>
  <para style="q">
    <verse number="12-13" style="v" sid="JOB 5:12-13" />च़लाक मणछे करा सह सारी बिक्री बृथा,</para>
  <para style="q" vid="JOB 5:12-13">ज़ुंण कदुष्ट आप्पू छ़ल़ैघ समझ़ा तिन्‍नां चैल़ा सह तिन्‍नें ई</para>
  <para style="q" vid="JOB 5:12-13">बूरी बिक्रीए ज़ज़ाल़ा दी अर तिंयां निं किछ़ू गल्‍ला दी सफल हंदै।<verse eid="JOB 5:12-13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 5:14" />तिन्‍नां लै हआ धैल़ी दपहरै न्हैरअ अर</para>
  <para style="q" vid="JOB 5:14">तेथ रहा तिंयां तोफदै लागी।<verse eid="JOB 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 5:15" />पर परमेशर बच़ाऊआ रैनै-गरीबा मरनै का,</para>
  <para style="q" vid="JOB 5:15">कदुष्ट मणछा निं सह तिन्‍नां हंतणैं दैंदअ।<verse eid="JOB 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 5:16" />रैनै-गरीबा रहा आशा अर</para>
  <para style="q" vid="JOB 5:16">कदुष्ट मणछे खाख डाहा परमेशर बुदरी।<verse eid="JOB 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 5:17" />तेऊ मणछा लै भाल़ केही खुशी हणीं</para>
  <para style="q" vid="JOB 5:17">ज़हा परमेशर आप्पै नैरा!</para>
  <para style="q" vid="JOB 5:17">ज़ेभै सह नैरे, तेता निं बृथा समझ़ी।<verse eid="JOB 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 5:18" />ज़ुंण ज़खम सह दैआ, तेतो करा सह लाज़ बी आप्पै,</para>
  <para style="q" vid="JOB 5:18">ज़ुंण तेऊए हाथै रोग एछा,</para>
  <para style="q" vid="JOB 5:18">तेता करा सह नरोगै बी आपणैं हाथै।<verse eid="JOB 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 5:19" />तेऊ डाहणअ तूह छ़हा आफ़ता का बच़ाऊई,</para>
  <para style="q" vid="JOB 5:19">सात आफ़ता बी होए, तैबी निं तेरी किछ़ै हान्‍नी हणीं।<verse eid="JOB 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 5:20" />ज़ेभै नकाल़ पल़े, तेभै डाहणअ तेऊ तूह ज़िऊंदअ,</para>
  <para style="q" vid="JOB 5:20">जुधा दी निं तेऊ तूह दुशमणे तलबारा करै मरनै दैणअ।<verse eid="JOB 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 5:21" />तेऊ डाहणअ तूह कोल़े मारा का बच़ाऊई,</para>
  <para style="q" vid="JOB 5:21">ज़ै बनाश बी एछे तैबी बी निं ताह किछ़ै हैल़अ हणअ।<verse eid="JOB 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 5:22" />बनाश अर नकाल़े धैल़ै बी रहणअ तूह राज्ज़ी-खुशी,</para>
  <para style="q" vid="JOB 5:22">नां ताह बणें ज़ीबे डअर-भगैर हणीं।<verse eid="JOB 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 5:23" />तेरै खेचै निं बाहंदी-बऊंदी बारी टूंक बी निखल़णअ,</para>
  <para style="q" vid="JOB 5:23">नां बणें ज़ीब ताह खांदै बच़ोटदै एछणैं।<verse eid="JOB 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 5:24" />इहअ करै रहणअ तूह आपणैं डेरै दी राज्ज़ी-मौज़ी।</para>
  <para style="q" vid="JOB 5:24">तेरै डागै चैणैं मांझ़ै बी निं किछ़ै हान्‍नी हणीं।<verse eid="JOB 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 5:25" />तेरी आद-लुआद बी हणीं आजू खास्सी,</para>
  <para style="q" vid="JOB 5:25">तिंयां हणैं घैहणीं घाह ज़िहै खास्सै।<verse eid="JOB 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 5:26" />ज़िहअ लऊंणींए ऋता खहल़ै नाज़े काशीओ रूल़ लागा,</para>
  <para style="q" vid="JOB 5:26">तेही हणीं तेरी खास्सी अमर अर तूह मरनअ ऐन प्रोढअ हई।<verse eid="JOB 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 5:27" />आयूब, हाम्हैं ज़ाणअ-भाल़अ आपणीं अमरा इहअ ई,</para>
  <para style="q" vid="JOB 5:27">ईंयां गल्‍ला आसा शुची अर ईंयां गल्‍ला हुई ताह मनणी।”<verse eid="JOB 5:27" /></para>
  <chapter eid="JOB 5" />
  <chapter number="6" style="c" sid="JOB 6" />
  <para style="s1">आयूबै बोलअ इहअ निं हई सकदअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 6:1" />आयूब लागअ इहअ बोल्दअ,<verse eid="JOB 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 6:2" />ज़ै मेरअ दुख तोली सकदै अर</para>
  <para style="q" vid="JOB 6:2">ज़ै मेरी सारी खरी तराकल़ी दी पल़दी,<verse eid="JOB 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 6:3" />तेतो बज़न निखल़णअ त सारै समुंदरे रेता का बी खास्सअ,</para>
  <para style="q" vid="JOB 6:3">तै निं तम्हैं मेरी तांऊंल़ी गल्‍ला लै रहैन हणैं तै।<verse eid="JOB 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 6:4" />महान परमेशर ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 6:4">तेऊ खभेऊऐ मुल्है आपणैं तिछै कतीर।</para>
  <para style="q" vid="JOB 6:4">तेतो बिश लागअ मेरी सारी घेरी दी।</para>
  <para style="q" vid="JOB 6:4">परमेशरे आसा हुंह फेर-फिरदअ डरैऊई डाहअ द।<verse eid="JOB 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 6:5" />हुंह कै खरी खोज़ी निं सकदअ?</para>
  <para style="q" vid="JOB 6:5">बणें गाधै कै घाहा बाझ़ी चाछल़दै निं आथी?</para>
  <para style="q" vid="JOB 6:5">बल्द कै भुखै पेटै गल़ंगा निं लांदअ?<verse eid="JOB 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 6:6" />लूंणां बाझ़ी नसादअ स्लूणअ निं कोहै खांदअ अर</para>
  <para style="q" vid="JOB 6:6">नां आंडे शल़ेफल़ै दी सुआद हंदअ।<verse eid="JOB 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 6:7" />तेही ई हुई इहै भाल़ी मेरी भुख खतम,</para>
  <para style="q" vid="JOB 6:7">ज़िहअ बी हुंह खाआ, तेता करै लागअ हुंह बमार हंदअ।<verse eid="JOB 6:7" /></para>
  <para style="q">
    <verse number="8-9" style="v" sid="JOB 6:8-9" />परमेशर ज़िहअ हुंह मांगा, तिहअ किल्है निस्सअ दैई?</para>
  <para style="q" vid="JOB 6:8-9">सह मेरी अरज़ किल्है निस्सअ शूणीं?</para>
  <para style="q" vid="JOB 6:8-9">एता का लोल़ी त हुंह तेऊ आपणैं हाथै मारी पाअ!<verse eid="JOB 6:8-9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 6:10" />ज़ै मुखा इहअ थोघ लागदअ,</para>
  <para style="q" vid="JOB 6:10">तै दैणीं ती मुंह एतरी दाह दी बी खुशी दी छ़ाहल़ा।</para>
  <para style="q" vid="JOB 6:10">हुंह ज़ाणा कि परमेशर आसा पबित्र,</para>
  <para style="q" vid="JOB 6:10">हुंह निं कधि तेऊए हुकम मनणै का पिछ़ू हटअ।<verse eid="JOB 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 6:11" />मुंह निं ज़िऊंदै रहणा लै ज़ोर-ज़ाहण ई रहै!</para>
  <para style="q" vid="JOB 6:11">मेरी हुई आशा ई खतम, मंऐं किज़ै लाअ ज़िऊंदै रही करी?<verse eid="JOB 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 6:12" />हुंह निं पात्थरो आथी बणाअं द अर</para>
  <para style="q" vid="JOB 6:12">नां मेरी देही कांस्से आथी कि सह आसा पाक्‍की।<verse eid="JOB 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 6:13" />मुंह निं कोहिओ आसरअ आथी कि मेरी कुंण मज़त करे,</para>
  <para style="q" vid="JOB 6:13">ऐबै निं हुंह बिज़री सकदअ।<verse eid="JOB 6:13" /></para>
  <para style="s">मेरै साथीओ, मेरै च़ाल्‍लअ मर्हुई</para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 6:14" />“मेरै साथीओ, मेरै च़ाल्‍लअ मर्हुई,</para>
  <para style="q" vid="JOB 6:14">ऐहा खरी लोल़ी ती तम्हैं मेरी मज़त किई,</para>
  <para style="q" vid="JOB 6:14">तेतो निं तम्हां किछ़ै मतलब आथी कि</para>
  <para style="q" vid="JOB 6:14">हुंह महान परमेशरो ज़हा का सारअ बल आसा, तेऊओ अदर करा कि नांईं।<verse eid="JOB 6:14" /></para>
  <para style="q">
    <verse number="15-16" style="v" sid="JOB 6:15-16" />तम्हैं मेरै साथी दैनअ भराल़कै नाल़ा ज़िहअ धोखअ,</para>
  <para style="q" vid="JOB 6:15-16">ज़ुंण बरसात मुक्‍कदी निं तेथ पाणीं ई हंदअ।</para>
  <para style="q" vid="JOB 6:15-16">हिंऊंदै, रहा तेथ शाण लागी पर<verse eid="JOB 6:15-16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 6:17" />बसंते रीत एछदी-एछदी जाआ तिंयां</para>
  <para style="q" vid="JOB 6:17">धुप्पे गरमीं करै गल़ी करै पठी शुक्‍की!<verse eid="JOB 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 6:18" />हुंह हुअ ऊँटे शुंआरी करनै आल़ै ज़िहअ,</para>
  <para style="q" vid="JOB 6:18">ज़ुंण रेगीस्तानै पाणीं लोल़अ रहा ठुल़्दअ लागी,</para>
  <para style="q" vid="JOB 6:18">खिरी हआ पाणीं बाझ़ी तेऊए मौत।<verse eid="JOB 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 6:19" />कई ऊँटा दी शुंआर तै तेमा नाओंए नगरी का आऐ दै,</para>
  <para style="q" vid="JOB 6:19">शेबा ज़ैगा का आऐ दै शुंआरो छ़ुंढ बी लागै तिन्‍नां ई ज़िहै पाणीं लोल़ै,<verse eid="JOB 6:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 6:20" />तिंयां थिऐ एही आशा निहंचै रहै दै कि तिन्‍नां जाणअ पाणीं भेटी,</para>
  <para style="q" vid="JOB 6:20">ज़ांऊं तिंयां नाल़ै पुजै, सह भेटअ शुक्‍कअ अर तिन्‍नें आशा बी हुई खतम।<verse eid="JOB 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 6:21" />तिहै हुऐ मुल्है तम्हैं,</para>
  <para style="q" vid="JOB 6:21">ज़ांऊं तम्हैं मेरी खरी भाल़ी,</para>
  <para style="q" vid="JOB 6:21">तम्हैं लागै डरै मुखा दूर ठुर्हदै!<verse eid="JOB 6:21" /></para>
  <para style="s">मेरअ किज़ै कशूर आसा?</para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 6:22" />तम्हैं किल्है डरै इहै? मंऐं कै तम्हां का कधू किज़ै च़ीज़ मांगी?</para>
  <para style="q" vid="JOB 6:22">कि मंऐं इहअ बोलअ कि आपणीं ज़ैदाता का दैआ मुल्है किज़ै?<verse eid="JOB 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 6:23" />कि मंऐं तम्हां लै इहअ बोलअ कि</para>
  <para style="q" vid="JOB 6:23">तम्हैं बच़ाऊआ मुंह मेरै दुशमणा का?<verse eid="JOB 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 6:24" />तम्हैं खोज़ा मुखा मेरअ किज़ै कशूर आसा?</para>
  <para style="q" vid="JOB 6:24">तम्हैं समझ़ाऊआ मुंह, हुंह</para>
  <para style="q" vid="JOB 6:24">रहूं च़ुप्पी थारी गल्‍ला शूणअ लागी।<verse eid="JOB 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 6:25" />शुची गल्‍ला ज़ाण्हिंआं कल़ुई,</para>
  <para style="q" vid="JOB 6:25">पर थारी हठ करनी आसा बृथा।<verse eid="JOB 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 6:26" />मेरै च़ाल्‍लअ इधी मर्हुई,</para>
  <para style="q" vid="JOB 6:26">अर तम्हैं बोला मेरी गल्‍ला बागरी ज़ेही बृथा!<verse eid="JOB 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 6:27" />आप्पू ता आसा तम्हैं छ़ुटै-मुक्‍कै दै लान्हैं</para>
  <para style="q" vid="JOB 6:27">गलामी लै बेच़ी करै ढब्बै खटी सेठ हुऐ दै!<verse eid="JOB 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 6:28" />मेरै मुंहैं दैआ नदर!</para>
  <para style="q" vid="JOB 6:28">तम्हां का कै हुंह झ़ुठअ शुझिआ?<verse eid="JOB 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 6:29" />ऐबै बोलअ तम्हैं बतेर्हअ, मेरी आसा तम्हां का अरज़, झ़ुठअ बोल़णें पाआ छ़ाड़।</para>
  <para style="q" vid="JOB 6:29">मुंह दी खोट काढदै निं लागा, हुंह आसा शुचअ मणछ।<verse eid="JOB 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 6:30" />मुखा कै भलै बूरैओ थोघ निं आथी?</para>
  <para style="q" vid="JOB 6:30">मेरी गल्‍ला दी कै छ़ल़-कपट आसा?”<verse eid="JOB 6:30" /></para>
  <chapter eid="JOB 6" />
  <chapter number="7" style="c" sid="JOB 7" />
  <para style="s">ज़िऊंणअ इहअ कठण किल्है आसा</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 7:1" />“मणछे ज़िन्दगी आसा बेघै कठण</para>
  <para style="q" vid="JOB 7:1">हाम्हां लागा मज़दूरा ज़ेही ज़ोरा-ज़ोरी मैन्थ करनी,<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="JOB 15:5">आयू. 15:5</ref>; <ref loc="JOB 13">13</ref>; <ref loc="JOB 14">14</ref></char></note><verse eid="JOB 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 7:2" />हाम्हैं आसा चटाक्‍क धुप्पै दी कामां करदै गलामा ज़िहै</para>
  <para style="q" vid="JOB 7:2">ज़ुंण छ़ैल्‍ली लोल़ै हआ लागै दै अर</para>
  <para style="q" vid="JOB 7:2">हाम्हैं आसा मज़दूरा ज़िहै ज़ुंण आपणीं मज़दूरी न्हैल़ै रहा लागी।<verse eid="JOB 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 7:3" />हुंह बी आसा भिन्‍नैं दर भिन्‍नैं थोघै बाझ़ी ज़िऊंदअ लागअ द,</para>
  <para style="q" vid="JOB 7:3">राची का बाद राची एछा मुल्है शोग ई।<verse eid="JOB 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 7:4" />च़ैन्‍नै सुत्ती करा हुंह एही अरज़ कि राच लोल़ी ती छ़ेक्‍कै भैई,</para>
  <para style="q" vid="JOB 7:4">पर सह ज़ाण्हिंआं मुखा होर बी लाम्मी,</para>
  <para style="q" vid="JOB 7:4">सारी राची रहा हुंह पाशल़ी बधल़दअ न्हैल़अ लागी कि राच केभै भैणीं।<verse eid="JOB 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 7:5" />मेरी सारी घेरी आसा फिमशी, दुखणैं अर किल़ै पल़ै दै,</para>
  <para style="q" vid="JOB 7:5">दुखणैं का आसा पाक लागअ द निटरदअ।<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="ISA 14:11">ईशा. 14:11</ref></char></note><verse eid="JOB 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 7:6" />ज़ेतरअ छ़ेक्‍कै राछ़े नल़पी दी भरअ द धाग्गअ मुक्‍का, तेता का छ़ेक्‍कै आसा मेरै धैल़ै लागै दै बितदै,</para>
  <para style="q" vid="JOB 7:6">मेरै धैल़ै रहा बितदै लागी अर मेरी आशा बी रहा चुटदी लागी।<verse eid="JOB 7:6" /></para>
  <para style="s">बिस्सरी निं आथी!</para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 7:7" />हे परमेशर, तूह निं बिस्सरी आथी,</para>
  <para style="q" vid="JOB 7:7">मेरी ज़िन्दगी आसा बागरीए झ़लारै ज़ेही,</para>
  <para style="q" vid="JOB 7:7">ऐबै निं मुंह आजू खुशी भाल़णीं भेटणीं।<verse eid="JOB 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 7:8" />हुंह हणअ ऐबै सोभिए आछी का दूर,</para>
  <para style="q" vid="JOB 7:8">हुंह निं आजू कोही का शुझणअ,</para>
  <para style="q" vid="JOB 7:8">ताखा बी निं हुंह शुझुई च़ाल्‍लअ।<verse eid="JOB 7:8" /></para>
  <para style="q">
    <verse number="9-10" style="v" sid="JOB 7:9-10" />ज़िहअ हांढदअ बादल़ निखल़ी लुक्‍का,</para>
  <para style="q" vid="JOB 7:9-10">तिहै निं हाम्हैं मणछ बी मरी करै भिई फिरी एछदै।</para>
  <para style="q" vid="JOB 7:9-10">तेखअ निं हाम्हैं कोही लाऐ आद डाही।<verse eid="JOB 7:9-10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 7:11" />तैही निं हुंह ऐबै च़ुप्पी च़ाल्‍लअ रही,</para>
  <para style="q" vid="JOB 7:11">मुंह खोज़णअ आपणैं दिलो दुख खुल्ही करै,</para>
  <para style="q" vid="JOB 7:11">मुंह आसा भितरी बुआल़ लागै दै अर मुंह लणअ बोली।<verse eid="JOB 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 7:12" />तंऐं किल्है आसा मुल्है इहअ पहरअ पाअ द?</para>
  <para style="q" vid="JOB 7:12">हुंह कै समुंदर आसा कि समुंदरो बडअ ज़ीब आसा?<verse eid="JOB 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 7:13" />ज़ेभै बी हुंह इहअ सोठा कि मुंह सुत्तणअ निंजा,</para>
  <para style="q" vid="JOB 7:13">च़ैन्‍नै सुत्ती झ़ाणीं मुंह मेरी दाह का राम जाए भेटी,<verse eid="JOB 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 7:14" />तेभै पै डरैऊआ तूह मुंह</para>
  <para style="q" vid="JOB 7:14">डरैऊंणै सुपनै रहैऊ करै!<verse eid="JOB 7:14" /></para>
  <para style="q">
    <verse number="15-16" style="v" sid="JOB 7:15-16" />होर ता होर, मेरअ शाह बोला केभै फांसी दैणा लै,</para>
  <para style="q" vid="JOB 7:15-16">ऐहा दाह ज़िरनै का आसा मरनअ भलअ।</para>
  <para style="q" vid="JOB 7:15-16">मुंह हुई आपणीं ज़िन्दगी का नफरत मेरअ निं ज़िऊंणेंओ शाह ई करदअ।</para>
  <para style="q" vid="JOB 7:15-16">मुंह छ़ाडा कल्ही, मेरी आसा ज़िन्दगी ई बृथा।<verse eid="JOB 7:15-16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 7:17" />ताह कै ज़रुरत आसा मणछे,</para>
  <para style="q" vid="JOB 7:17">कि ताह लागा म्हारै बारै खास्सअ सोठणअ?<verse eid="JOB 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 7:18" />तूह करा मणछे ज़ाच़-भाल़ धैल़ अर</para>
  <para style="q" vid="JOB 7:18">हर घल़ी रहा तूह हाम्हां परखदअ लागी।<verse eid="JOB 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 7:19" />तूह आसा कबल्‍लअ मुंह भाल़अ लागअ द,</para>
  <para style="q" vid="JOB 7:19">तूह निस्सअ मुल्है थिह घुटणेंओ बगत बी दैई।<verse eid="JOB 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 7:20" />ज़ै मंऐं पाप बी किअ होए, तैबी बी निं मंऐं तेरअ किछ़ै बूरअ किअ,</para>
  <para style="q" vid="JOB 7:20">हे मणछे पहरै करनै आल़ैआ,</para>
  <para style="q" vid="JOB 7:20">तेरी नदर किल्है आसा सिधी मुल्है लागी दी,</para>
  <para style="q" vid="JOB 7:20">हुंह कै ताल्है खास्सअ बोझ़ आसा।<verse eid="JOB 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 7:21" />तूह मेरै पाप माफ अर मेरअ कशूर दूर किल्है निं करदअ?</para>
  <para style="q" vid="JOB 7:21">ऐबै जाणअ हुंह तेतरी मरी,</para>
  <para style="q" vid="JOB 7:21">तेखअ निं हुंह ताह लोल़ी करै बी भेटी च़ाल्‍लअ।”<verse eid="JOB 7:21" /></para>
  <chapter eid="JOB 7" />
  <chapter number="8" style="c" sid="JOB 8" />
  <para style="s">बिल्दाद लागअ झेठी करदअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 8:1" />शूही मुल्खो बिल्दाद लागअ आयूबा लै इहअ बोल्दअ,<verse eid="JOB 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 8:2" />“तेरी निं गल्‍ला ई मुक्‍कदी!</para>
  <para style="q" vid="JOB 8:2">तेरी गल्‍ला आसा ढिश-बागरी ज़ेही!<verse eid="JOB 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 8:3" />ज़हा परमेशरा का सारअ बल आसा तेऊ का कै नसाफ आथी निं?</para>
  <para style="q" vid="JOB 8:3">तेऊए ज़ाणैं कै बूरअ हई सका?<verse eid="JOB 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 8:4" />तेरै शोहरू-माठै किअ हणअ ज़रूर किज़ै पाप,</para>
  <para style="q" vid="JOB 8:4">तैही दैनी परमेशरै तिन्‍नां लै सज़ा, ज़ुंण तिन्‍नां भेटणीं ती।<verse eid="JOB 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 8:5" />पर ज़ै तूह आझ़ परमेशरा का प्राथणां करे,</para>
  <para style="q" vid="JOB 8:5">बिधाता ज़हा का सारअ बल आसा, ज़ै तूह तेऊ सेटा लेर-पकार पाई अरज़ करे,<verse eid="JOB 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 8:6" />ज़ै तूह मानदार अर शुचअ आसा,</para>
  <para style="q" vid="JOB 8:6">तै जाणअ परमेशर तेरी मज़त करना लै एछी,</para>
  <para style="q" vid="JOB 8:6">तै हेरनअ तेऊ तूह बच़ाऊई अर</para>
  <para style="q" vid="JOB 8:6">तेखअ हणअ तेरअ घअर-बण भिई ज़िहअ कै तिहअ।<verse eid="JOB 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 8:7" />आजू हणीं तेरी ज़िन्दगी होर बी सफल,</para>
  <para style="q" vid="JOB 8:7">ज़ुंण ताखा थिअ, सह निं तेता सेटा किछ़ बी आथी ज़ुंण आजू ताल्है परमेशरा दैणअ।<verse eid="JOB 8:7" /></para>
  <para style="s">म्हारै दाद-बाब तै अक्ली आल़ै</para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 8:8" />धख शिखल़ आपणैं दादा-बाबा का,</para>
  <para style="q" vid="JOB 8:8">तिन्‍नां भाल़ केही अक्ल थिई।<verse eid="JOB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 8:9" />हाम्हैं निं तिन्‍नां सेटा किछ़ बी आथी</para>
  <para style="q" vid="JOB 8:9">अर म्हारी अमर आसा ई केतरी!</para>
  <para style="q" vid="JOB 8:9">पृथूई का डेओआ हाम्हैं छ़ैल्‍ली ज़िहै।<verse eid="JOB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 8:10" />दादा-बाबा का भेटणीं ताह राम्बल़ी शिक्षा,</para>
  <para style="q" vid="JOB 8:10">तिन्‍नें गल्‍लो कर बच़ार कि तिन्‍नैं किज़ै आसा बोलअ द,<verse eid="JOB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 8:11" />‘कछैरो घाह निं पणैल्ही ज़ैगा छ़ाडी होर्ती लागदअ,</para>
  <para style="q" vid="JOB 8:11">नां नगाल़ै प्राल़ी ज़ैगा बझ़दी ज़िधी शुक्‍कअ होए।<verse eid="JOB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 8:12" />ज़ै पाणीं शुक्‍के, तिंयां जाआ सोभी घाह का बी आजी शुक्‍की,</para>
  <para style="q" vid="JOB 8:12">च़ाऐ तिंयां अज़ी काटणा लै बी निं हुऐ होए।’<verse eid="JOB 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 8:13" />ज़ुंण परमेशरा बिस्सरी पाआ तिन्‍नें हालत बी हआ एही ई।</para>
  <para style="q" vid="JOB 8:13">इहै पापी मणछे हआ आशा ई खतम।<verse eid="JOB 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 8:14" />ज़ेथ तिंयां भरोस्सअ करा,</para>
  <para style="q" vid="JOB 8:14">सह हआ तिन्‍नां लै जांगूए जगोल्हा ज़िहअ।<verse eid="JOB 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 8:15" />सह च़ाऐ तेथ ज़ेतरअ बी नील़ लाए, सह निं पाक्‍कअ आथी,</para>
  <para style="q" vid="JOB 8:15">अर सह तेता ज़िहअ बी पिड्डअ ढाकी डाहे, सह निं टेक्‍कदअ आथी।<verse eid="JOB 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 8:16" />कदुष्ट मणछ हआ प्राल़ी ज़ैगा लागी दी एही बेला ज़िहअ,</para>
  <para style="q" vid="JOB 8:16">ज़हा धुप्पअ अर पाणीं पुगतअ भेटा,</para>
  <para style="q" vid="JOB 8:16">सह बेल सल्‍ला सारी बागा सारै दी।<verse eid="JOB 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 8:17" />तेते ज़लैल़ै शाचा कोडी-बिल्‍ला</para>
  <para style="q" vid="JOB 8:17">द्रटा अर पात्थरे रूल़ा दी पाक्‍कै।<verse eid="JOB 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 8:18" />पर ज़ांऊं तिन्‍नां पोर्ही पेच़ा, तेखअ निं कोही का इहअ थोघ रहंदअ</para>
  <para style="q" vid="JOB 8:18">कि एथ बी थिअ होए किज़ै इहअ लागअ द।<verse eid="JOB 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 8:19" />इधी हआ तेते ज़िन्दगी खतम अर</para>
  <para style="q" vid="JOB 8:19">तेते ज़ैगा लागा तेखअ किज़ै होर घाह! कदुष्ट मणछे बी हआ एही ई दशा।<verse eid="JOB 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 8:20" />पर नर्दोश मणछा निं परमेशर शोटी डाहंदअ अर</para>
  <para style="q" vid="JOB 8:20">नां सह तेऊ छ़ाडी कदुष्ट मणछे मज़त करदअ।<verse eid="JOB 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 8:21" />तेऊ सका अज़ी बी ताल्है खुश हणैंओ मोक्‍कअ दैई,</para>
  <para style="q" vid="JOB 8:21">अर तेरै होठा का निखल़णैं ज़ै-ज़ैकारे बोल।<verse eid="JOB 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 8:22" />पर ज़ुंण ताह संघै ज़ीद डाहा, तिंयां हणैं शर्मिंदै,</para>
  <para style="q" vid="JOB 8:22">अर कदुष्ट मणछे डेरै हणैं सदा लै बरैबाद।”<verse eid="JOB 8:22" /></para>
  <chapter eid="JOB 8" />
  <chapter number="9" style="c" sid="JOB 9" />
  <para style="s">आयूबै दैनअ इहअ ज़बाब</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 9:1" />आयूबै दैनअ इहअ ज़बाब,<verse eid="JOB 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 9:2" />“तंऐं बोल्दअ ठीक,</para>
  <para style="q" vid="JOB 9:2">मंऐं आसा ईंयां गल्‍ला शूणीं दी।</para>
  <para style="q" vid="JOB 9:2">पर मणछ किज़ै सका करी कि सह परमेशरा का धर्मीं शुझिए?<verse eid="JOB 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 9:3" />तेऊ संघै कुंण सका हठ करी?</para>
  <para style="q" vid="JOB 9:3">सह सका हज़ार सुआल पुछ़ी अर</para>
  <para style="q" vid="JOB 9:3">तेतो ज़बाब निं कोहै दैई सकदअ।<verse eid="JOB 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 9:4" />परमेशरा का आसा अक्ल अर</para>
  <para style="q" vid="JOB 9:4">तेऊ का आसा सारअ बल,</para>
  <para style="q" vid="JOB 9:4">तेऊ सेटा निं कोहै खल़अ टेक्‍की सकदअ।<verse eid="JOB 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 9:5" />सह सका नच़ानक बडै-बडै पर्बता</para>
  <para style="q" vid="JOB 9:5">ओर्ही-पोर्ही सकैऊई,</para>
  <para style="q" vid="JOB 9:5">रोश्शै सका सह तिन्‍नां कज़ेभल़ी खतम करी।<verse eid="JOB 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 9:6" />परमेशर करा सारी पृथूई दी ज़ाज़री,</para>
  <para style="q" vid="JOB 9:6">तेते आथरी सकैऊआ सह ओर्ही-पोर्ही।<verse eid="JOB 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 9:7" />सह सका सुरज़ा बी निखल़णैं का रोक्‍की अर</para>
  <para style="q" vid="JOB 9:7">ज़ै सह च़ाहे, तारै निं दैणअ तेऊ राची च़मकणै!<verse eid="JOB 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 9:8" />तेऊ आसा सारअ भ्रमंड एकी ज़ण्हैं डाहअ द छैई,</para>
  <para style="q" vid="JOB 9:8">सह हांढा समुंदरे बडी-बडी छ़ाल्‍ली प्रैंदै।<verse eid="JOB 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 9:9" />तेऊ आसा सरगै सोभै तारै बणाऐं दै,</para>
  <para style="q" vid="JOB 9:9">सात ऋषी तारै, मृग नक्षत्र,</para>
  <para style="q" vid="JOB 9:9">कृतिका तारे छ़ुंढ अर</para>
  <para style="q" vid="JOB 9:9">दखण दिशा बाखा नक्षत्र आसा तेऊ ई डाहै दै टकैल़ी।<verse eid="JOB 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 9:10" />तेऊए महान कामें निं हाम्हैं थह ई लोल़ी सकदै,</para>
  <para style="q" vid="JOB 9:10">नां हाम्हैं तेऊए च़मत्कारा गणी सकदै।<verse eid="JOB 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 9:11" />परमेशर हांढा मेरै मुंहां बाती पोर्ही,</para>
  <para style="q" vid="JOB 9:11">हुंह निं तेऊ भाल़ी सकदअ नां तेऊए छ़ेल़-छ़ुणक शुण्हदी!<verse eid="JOB 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 9:12" />ज़ै सह किछ़ै पोर्ही छ़ड़ैऊए, तेता लै निं तेऊ कोहै रोक्‍की सकदअ,</para>
  <para style="q" vid="JOB 9:12">तेऊ का निं कोहै इहअ सुआल करी सकदअ,</para>
  <para style="q" vid="JOB 9:12">‘तंऐं किल्है लाअ इहअ करी?’<verse eid="JOB 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 9:13" />परमेशरो रोश्श निं फांभअ हंदअ,</para>
  <para style="q" vid="JOB 9:13">सह कच़ुंच़रा समुंदरे बडै-बडै करबैऊंणैं</para>
  <para style="q" vid="JOB 9:13">दैंत्तर ज़ीबा बी आपणैं खूरा हेठै।<verse eid="JOB 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 9:14" />तेखअ हुंह तेऊ सेटा किज़ै च़ीज़ आसा कि हुंह तेऊ लै ज़बाब काढूं?</para>
  <para style="q" vid="JOB 9:14">तेऊ संघै किधी सका हुंह हठ करी?<verse eid="JOB 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 9:15" />ज़ै मेरअ किछ़ै कशूर बी निं हंदअ,</para>
  <para style="q" vid="JOB 9:15">तैबी सका हुंह परमेशरा सेटा लेर-पकार पाई सिधअ इहअ बोली कि झींण करी कर मेरअ नसाफ।<verse eid="JOB 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 9:16" />ज़ै सह मुंह बोल़णैं बी दैए,</para>
  <para style="q" vid="JOB 9:16">तैबी बी निं मुंह भरोस्सअ आथी कि तेऊ हेरनी मेरी गल्‍ला शूणीं।<verse eid="JOB 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 9:17" />सह छ़ाडा थोघै बाझ़ी मुंह हारना लै ढिश-डुआल़अ</para>
  <para style="q" vid="JOB 9:17">ताकि मुल्है होर बी खास्सै ज़खम पल़े।<verse eid="JOB 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 9:18" />सह निं मुंह शाह बी दैंदअ काढणैं,</para>
  <para style="q" vid="JOB 9:18">तेतरी जाआ मुल्है होर आफ़त पल़ी!<verse eid="JOB 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 9:19" />ज़ै ज़ोरो साब भाल़े, मुंह निं परमेशरा सान ज़ोर आथी,</para>
  <para style="q" vid="JOB 9:19">ज़ै नसाफे गल्‍ल करनी होए, सह आसा एही कि</para>
  <para style="q" vid="JOB 9:19">परमेशरा निं समन दैई कोहै दालता लै शादी सकदअ!<verse eid="JOB 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 9:20" />मेरअ च़ाऐ किछ़ै कशूर बी निं होए, मेरै निखल़णीं आपणीं ई खाखा का खोट,</para>
  <para style="q" vid="JOB 9:20">मेरी आपणीं गल्‍ला बी ज़ाण्हणीं मुखा मुल्है ई कशूर काढणैं आल़ी।<verse eid="JOB 9:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 9:21" />मेरअ निं किछ़ै कशूर आथी,</para>
  <para style="q" vid="JOB 9:21">पर तेतो निं मुल्है किछ़ै फरक आथी।</para>
  <para style="q" vid="JOB 9:21">हुंह गअ आपणीं ज़िन्दगी ई का हिछ़ुई।<verse eid="JOB 9:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 9:22" />मेरअ कशूर होए, च़ाऐ नां होए, तेता करै निं किछ़ै फरक पल़दअ,</para>
  <para style="q" vid="JOB 9:22">हुंह आसा रोगी बृथा ज़िन्दगी ज़िऊंदअ लागअ द,</para>
  <para style="q" vid="JOB 9:22">तैही बोला हुंह परमेशर करा खरै अर बूरै दुही खतम।<verse eid="JOB 9:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 9:23" />ज़ेभै कुंण भलअ मणछ नच़ानक मरा,</para>
  <para style="q" vid="JOB 9:23">तेभै फुक्‍का परमेशरा बी हास्सी।<verse eid="JOB 9:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 9:24" />सारी पृथूई दी आसा कदुष्ट मणछो राज़,</para>
  <para style="q" vid="JOB 9:24">नसाफ करनै आल़ै पांच़े आछी आजू बी आसा न्हैरअ किअ द!</para>
  <para style="q" vid="JOB 9:24">इहअ करनै आल़अ परमेशर निं आथी तै होर कुंण आसा?<verse eid="JOB 9:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 9:25" />मेरी ज़िन्दगी आसा बाझ़ी आशा अर</para>
  <para style="q" vid="JOB 9:25">बाझ़ी खुशी दी बेघै छ़ेक्‍कै ठुहर्दी लागी दी।<verse eid="JOB 9:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 9:26" />मेरी हर धैल़ी डेओआ छ़ेक्‍कै ठुहर्नै आल़ी मोट्टै नगाल़े किश्ती ज़ेही,</para>
  <para style="q" vid="JOB 9:26">ज़िहअ छ़ेक्‍कै मुक्षरलअ आपणैं शकारा लै झ़ाफल़ी दैआ,</para>
  <para style="q" vid="JOB 9:26">तिहै छ़ेक्‍कै बिता मेरै धैल़ै।<verse eid="JOB 9:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 9:27" />कई बारी किई मंऐं दाह बिस्सरी</para>
  <para style="q" vid="JOB 9:27">खुश रहणें कोशिश,<verse eid="JOB 9:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 9:28" />पर आपणीं दाह भाल़ी छ़ुटा मुंह दर्छ़णअ,</para>
  <para style="q" vid="JOB 9:28">किल्हैकि मुंह फिरा एही आद कि</para>
  <para style="q" vid="JOB 9:28">परमेशरा सम्हनै निं हुंह नर्दोश आथी!<verse eid="JOB 9:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 9:29" />तेखअ सोठा हुंह इहअ, ज़ै हुंह दोशी हणअ ई हणअ,</para>
  <para style="q" vid="JOB 9:29">तै आसा मेरी आप्पू बाखा इहअ खोज़णें मैन्थ करनी बृथा कि मेरअ निं किछ़ै कशूर आथी!<verse eid="JOB 9:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 9:30" />इहअ निं किज़ै साबण ई आथी</para>
  <para style="q" vid="JOB 9:30">ज़ुंण मेरै पाप धोई सके।<verse eid="JOB 9:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 9:31" />परमेशरा पाणअ हुंह डुघी खात्ती दी</para>
  <para style="q" vid="JOB 9:31">च़िक्‍करै जैंदरी ज़ेथ बेघै बूरी बास्स हआ लागी दी,</para>
  <para style="q" vid="JOB 9:31">मेरै झिकल़ै बी लागणीं मुखा च़िल़्ह।<verse eid="JOB 9:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 9:32" />ज़ै परमेशर मुंह ज़िहअ मणछ हंदअ, तै सका त हुंह तेऊ लै ज़बाब दैई,</para>
  <para style="q" vid="JOB 9:32">तै सका त हुंह दालता दी डेऊई तेऊ संघै हठ करी।<verse eid="JOB 9:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 9:33" />मुंह अर परमेशरा मांझ़ै निं कोहै पांच़ी करी सकदअ अर</para>
  <para style="q" vid="JOB 9:33">नां कुंण हाम्हां दूईओ नसाफ करी सकदअ।<verse eid="JOB 9:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 9:34" />हे परमेशर, ऐबै कर हुअ!</para>
  <para style="q" vid="JOB 9:34">ऐबै च़िक्‍कअ तंऐं हुंह बतेर्हअ,</para>
  <para style="q" vid="JOB 9:34">ऐबै पा मुंह डरैऊंणे छ़ाड़।<verse eid="JOB 9:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 9:35" />तै निं मुंह ताह संघै गल्‍ला करना लै डअर रहणीं,</para>
  <para style="q" vid="JOB 9:35">पर एही हालता दी निं हुंह ताह संघै चिंज़ी सकदअ।”<verse eid="JOB 9:35" /></para>
  <chapter eid="JOB 9" />
  <chapter number="10" style="c" sid="JOB 10" />
  <para style="s">आयूब करा परमेशरा का अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 10:1" />“हुंह हिछ़ुअ ऐबै आपणीं ज़िन्दगी का!</para>
  <para style="q" vid="JOB 10:1">हुंह आसा भितरा का खास्सअ दुखी,</para>
  <para style="q" vid="JOB 10:1">ऐबै दै मुंह आपणैं दिलो दुख खुल्ही करै खोज़णैं।<verse eid="JOB 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 10:2" />हे परमेशर, मुल्है निं सिधअ कशूर खोज़दअ लागै,</para>
  <para style="q" vid="JOB 10:2">ओर्ही खोज़ मुखा कि किज़ू गल्‍ला पिछ़ू लागअ मुल्है अह कशूर?<verse eid="JOB 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 10:3" />इहअ रुखअ हणअ कै ताह शोभा दैआ?</para>
  <para style="q" vid="JOB 10:3">ज़ुंण तंऐं आपणैं हाथै बणाअं तेता किल्है शोटा तूह पोर्ही?</para>
  <para style="q" vid="JOB 10:3">तूह किल्है दैआ इहअ करै कदुष्ट मणछे सोठी दी बिक्री सफल हणैं?<verse eid="JOB 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 10:4" />ताखा कै हाम्हां मणछा ई ज़ेही आछी आसा</para>
  <para style="q" vid="JOB 10:4">अर ज़ेतरअ मणछ भाल़ी सका, ताखा कै सिधअ तेतरअ ई शुझिआ?<verse eid="JOB 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 10:5" />मणछा ज़ेही कै तेरी अमर बी थोल़ी आसा?<verse eid="JOB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 10:6" />ताखा कै तैही जाआ मुंह दी</para>
  <para style="q" vid="JOB 10:6">धखी का पाप शुझुई?<verse eid="JOB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 10:7" />ताखा आसा थोघ कि मेरअ निं किछ़ै कशूर आथी,</para>
  <para style="q" vid="JOB 10:7">तेरै हाथा का निं मुंह कोहै बच़ाऊई सकदअ।<verse eid="JOB 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 10:8" />हुंह आसा तंऐं आपणैं हाथै ज़ोल़ी-ज़ोल़ी करै बणाअं द,</para>
  <para style="q" vid="JOB 10:8">ऐबै लाअ तंऐं हुंह तिन्‍नां ई हाथा करै खतम करी!<verse eid="JOB 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 10:9" />आद कर कि तंऐं आसा हुंह माट्टै मुछ़ी करै बणाअं द,</para>
  <para style="q" vid="JOB 10:9">ऐबै कै तंऐं हुंह भिई लाअ शुक्‍कै माट्टै जैंदरी दाबी डाही?<verse eid="JOB 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 10:10" />तंऐं तरैल़अ हुंह दुधा ज़िहअ मेरी माए ओदरै,</para>
  <para style="q" vid="JOB 10:10">तेथ दैनअ तंऐं मेरी देही दैहीं ज़िहअ ज़म्मणै अर बझ़णै।<verse eid="JOB 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 10:11" />तंऐं ज़ोल़ै मेरै हाडकै संघा</para>
  <para style="q" vid="JOB 10:11">लाअ तेता बागै मास्स अर खाल।<verse eid="JOB 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 10:12" />तंऐं दैनी मुल्है ज़िन्दगी अर</para>
  <para style="q" vid="JOB 10:12">तंऐं रहैऊई मुल्है आपणीं अटल़ झ़ूरी।</para>
  <para style="q" vid="JOB 10:12">मुंह भाल़अ हआ कबल्‍लअ तूह ई, तै आसा हुंह आझ़ तैणीं ज़िऊंदअ।<verse eid="JOB 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 10:13" />पर ऐबै गअ मुखा तेरअ भेद थोघ लागी कि</para>
  <para style="q" vid="JOB 10:13">तंऐं त पैहलै ई डाहअ द सोठी कि ताह दैणअ मुल्है दुख।<verse eid="JOB 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 10:14" />तूह त मुंह भाल़अ लागअ द, ज़ै हुंह पाप करे,</para>
  <para style="q" vid="JOB 10:14">ताह निं मुल्है माफी छ़ाडणीं, तेते सज़ा लणी ताह मुल्है दैई।<verse eid="JOB 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 10:15" />ज़ै हुंह किज़ै कशूर करूं, सह आसा मुल्है लानत,</para>
  <para style="q" vid="JOB 10:15">पर ज़ै मुंह दी किछ़ै खोट बी निं होए, तैबी निं हुंह खुश हई सकदअ!</para>
  <para style="q" vid="JOB 10:15">किल्हैकि मुल्है आसा आफ़त पल़ी दी अर हुंह आसा शर्मिंदअ हुअ द।<verse eid="JOB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 10:16" />पर ज़ै हुंह खास्सी मैन्थ करी सफल हऊं,</para>
  <para style="q" vid="JOB 10:16">तेतरी हेरा तूह सिहा ज़िहअ मेरअ शकार करी,</para>
  <para style="q" vid="JOB 10:16">मेरी हान्‍नी करना लै करा तूह बडै-बडै च़मत्कार।<verse eid="JOB 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 10:17" />तूह आणा मुल्है कबल्‍ली किज़ै नां किज़ै शाजत,</para>
  <para style="q" vid="JOB 10:17">तूह काढा आपणअ सारअ रोश्श मुंह प्रैंदै अर</para>
  <para style="q" vid="JOB 10:17">तूह छ़ाडा मुल्है आफ़ता ज़ेही जुधा लै सैना छ़ाडा।<verse eid="JOB 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 10:18" />हे परमेशर, तंऐं किल्है दैनअ मेरअ ज़ल्म हणैं?</para>
  <para style="q" vid="JOB 10:18">भलअ हणअ त इहअ कि</para>
  <para style="q" vid="JOB 10:18">हुंह पेटा हणैं का आजी मरी जांदअ।<verse eid="JOB 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 10:19" />तै हणअ त हुंह हुअ नां हुअ एक बराबर अर</para>
  <para style="q" vid="JOB 10:19">तै हेरनअ त हुंह पेटा हंदी ई घोरी दाबी डाही।<verse eid="JOB 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 10:20" />मुंह रहै ऐबै थोल़ै धैल़ै,</para>
  <para style="q" vid="JOB 10:20">मुंह दै कल्ही कांगनरांगै रहणैं,</para>
  <para style="q" vid="JOB 10:20">ताकि ज़ुंण बगत मुखा आसा तेथ मुंह धख शांती भेटे।<verse eid="JOB 10:20" /></para>
  <para style="q">
    <verse number="21-22" style="v" sid="JOB 10:21-22" />ऐबै जाणअ हुंह छ़ेक्‍कै मरी अर तेखअ निं हुंह बापस फिरदअ,</para>
  <para style="q" vid="JOB 10:21-22">हुंह डेऊणअ तेऊ देशा लै ज़िधी न्हैरअ अर शोग रहा पल़ी,</para>
  <para style="q" vid="JOB 10:21-22">तैहा न्हैरी ज़ैगा आसा छ़ैल्‍ली, झाख</para>
  <para style="q" vid="JOB 10:21-22">अर प्रैश्शअ बी आसा तिधी न्हैरै ज़िहअ।”<verse eid="JOB 10:21-22" /></para>
  <chapter eid="JOB 10" />
  <chapter number="11" style="c" sid="JOB 11" />
  <para style="s">सोपर लागअ आयूबा संघै गल्‍ला करदअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 11:1" />नमाती मुल्खो सोपर लागअ आयूबा लै इहअ बोल्दअ,<verse eid="JOB 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 11:2" />“एही नथोघी गल्‍लो ज़बाब कुंण निं दैणअ च़ाहंदअ?</para>
  <para style="q" vid="JOB 11:2">खास्सी गल्‍ला करी मणछ शुचअ हआ?<verse eid="JOB 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 11:3" />आयूब तूह कै सोठा कि</para>
  <para style="q" vid="JOB 11:3">हाम्हैं कै तेरी गल्‍लो ज़बाब दैई निं सकदै?</para>
  <para style="q" vid="JOB 11:3">ज़िहै तंऐं हाम्हैं सुहांगा लै किऐ</para>
  <para style="q" vid="JOB 11:3">तिहै सका हाम्हैं तेरी गल्‍लो ज़बाब दैई ताह शर्मिंदै करी।<verse eid="JOB 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 11:4" />तूह फिरा आप्पू इहअ बोली पठी शुचअ कि</para>
  <para style="q" vid="JOB 11:4">परमेशरा का शुझिआ तूह सोभी का पबित्र।<verse eid="JOB 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 11:5" />असली ता हणअ त इहअ ठीक कि ताल्है परमेशर आप्पै ज़बाब दैंदअ अर</para>
  <para style="q" vid="JOB 11:5">सह खोज़दअ कि तूह किहअ आसा!<verse eid="JOB 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 11:6" />तेऊ खोज़णअ त ताखा कि अक्ल केतरै रंगे हआ,</para>
  <para style="q" vid="JOB 11:6">तेतो भेद समझ़णअ आसा मणछे समझ़ा का बागै।</para>
  <para style="q" vid="JOB 11:6">शुण, परमेशरै निं ताल्है तेतरी सज़ा दैनी आथी</para>
  <para style="q" vid="JOB 11:6">ज़ेतरी ताह असली दी भेटी लोल़ी ती।<verse eid="JOB 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 11:7" />बिधाता ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 11:7">तेऊओ भेद अर तेऊए बारै कै तूह पठी समझ़ी सका?<verse eid="JOB 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 11:8" />सारअ भ्रमंड बी आसा तेऊ सेटा होछ़अ, तूह निं तेथ पुजी सकदअ।</para>
  <para style="q" vid="JOB 11:8">परमेशर हआ पैईताल़ै बी भाल़अ लागअ द, ताखा किज़ै थोघ आसा?<verse eid="JOB 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 11:9" />तेऊए अक्ल आसा पृथूई का लाम्मी अर</para>
  <para style="q" vid="JOB 11:9">समुंदरा का बिरली, तेता निं तूह समझ़ी सकदअ।<verse eid="JOB 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 11:10" />परमेशर कहा कैद करे, दालता दी शादे,</para>
  <para style="q" vid="JOB 11:10">तेता लै निं कोहै तेऊ रोक्‍की सकदअ।<verse eid="JOB 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 11:11" />तेऊ का हआ थोघ कि झ़ुठअ कुंण आसा अर</para>
  <para style="q" vid="JOB 11:11">सह हेरा तिन्‍नें पाप आप्पै भाल़ी।<verse eid="JOB 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 11:12" />कबुधी मणछा अक्ल एछणी हआ एही</para>
  <para style="q" vid="JOB 11:12">ज़िहअ कि बणें गाधै का हुअ मणछ पैईदा।<verse eid="JOB 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 11:13" />आयूब, तूह कर आपणअ दिल शुचअ,</para>
  <para style="q" vid="JOB 11:13">बाह फुआरी कर परमेशरा सेटा अरज़।<verse eid="JOB 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 11:14" />ज़ै च़ुप्प-च़ुप्पै तूह किज़ै पाप करा बी होए, तेता छ़ाड पोर्ही,</para>
  <para style="q" vid="JOB 11:14">आपणैं डेरै निं किछ़ै पाप दैई रहणैं।<verse eid="JOB 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 11:15" />तै निं ताह शर्मिंदै पल़णअ हणअ,</para>
  <para style="q" vid="JOB 11:15">तै एछणअ ताह हैअ अर नां किज़ै डअर रहणीं।<verse eid="JOB 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 11:16" />तै जाणअ तूह इना आफ़ता का छ़ुटी अर बिस्सरुई,</para>
  <para style="q" vid="JOB 11:16">ज़ेही बरसाती गाड एछी आजू निखल़ा तेखअ निं तेता कोहै आद डाहंदै।<verse eid="JOB 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 11:17" />तेरी ज़िन्दगी हणीं तेखअ दपहरे धुप्पै का बी खास्सी प्रैश्शी,</para>
  <para style="q" vid="JOB 11:17">तेरी ज़िन्दगीए न्हैरी घल़ी ज़ाण्हणीं ताखा भैणीं दोत्ती ज़ेही।<verse eid="JOB 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 11:18" />तेरी ज़िन्दगी निभणी तेखअ निहंचै,</para>
  <para style="q" vid="JOB 11:18">तै रहणीं ताह आजू बी आशा अर</para>
  <para style="q" vid="JOB 11:18">नां किज़ै हैल़अ-फिकर रहणअ।<verse eid="JOB 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 11:19" />तेरै दुशमण बी निं ताह डरैऊंदै एछणैं,</para>
  <para style="q" vid="JOB 11:19">हथू एछणैं होर लोग ताखा पै मज़त मांगदै।<verse eid="JOB 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 11:20" />पर कदुष्ट मणछा का हणअ शुझणअ बी बंद,</para>
  <para style="q" vid="JOB 11:20">तिन्‍नां निं बच़णा लै बात बी शुझणीं।</para>
  <para style="q" vid="JOB 11:20">आजू रहणीं तिन्‍नां सिधी एही आशा कि सिधी मौत सका तिन्‍नां बच़ाऊई।”<verse eid="JOB 11:20" /></para>
  <chapter eid="JOB 11" />
  <chapter number="12" style="c" sid="JOB 12" />
  <para style="s">आयूबै दैनअ सोपरा लै टोक्‍की करै ज़बाब</para>
  <para style="q">
    <verse number="1-2" style="v" sid="JOB 12:1-2" />आयूबै दैनअ आपणैं साथी लै इहअ ज़बाब,</para>
  <para style="q" vid="JOB 12:1-2">“सोभी लोगे हंदै किई तंऐं एकी ज़ण्हैं गल्‍ला,</para>
  <para style="q" vid="JOB 12:1-2">तेरै मरनै बाद निं तेखअ देशै अक्ली आल़अ मणछ ई रहणअ!<verse eid="JOB 12:1-2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 12:3" />ज़िहअ तूह बोला, तेतरअ जाआ हुंह बी समझ़ी,</para>
  <para style="q" vid="JOB 12:3">हुंह निं किछ़ू गल्‍ला लै ताखा घट आथी,</para>
  <para style="q" vid="JOB 12:3">इहअ निं कोहै आथी ज़हा का तेरी इना गल्‍लो थोघ निं आथी।<verse eid="JOB 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 12:4" />मंऐं ज़िऊई हर बगत धर्मीं ज़िन्दगी,</para>
  <para style="q" vid="JOB 12:4">परमेशरै बी किई आझ़ तैणीं ज़ेही मंऐं अरज़ किई तेही ई पूरी।</para>
  <para style="q" vid="JOB 12:4">पर ऐबै आसा मेरै साथी-संघी मुल्है हास्सदै अर मेरै सुहांगा करदै लागै दै।<verse eid="JOB 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 12:5" />ज़ेभै तैणीं आप्पू निं पल़ी तेभै तैणीं करा,</para>
  <para style="q" vid="JOB 12:5">तेऊओ सुहांग सोभै ज़हा आफ़त हुई पल़ी दी,</para>
  <para style="q" vid="JOB 12:5">ज़ुंण बधल़ूई च़ाल्‍लअ तेऊ लै धाक्‍कअ दैणअ बी हआ सान।<verse eid="JOB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 12:6" />च़ोरा-डाकू अर पापी मणछ रहा आपणैं डेरै राज्ज़ी-राम्बल़ै,</para>
  <para style="q" vid="JOB 12:6">तिंयां बोला इहअ कि,</para>
  <para style="q" vid="JOB 12:6">परमेशर आसा म्हारी मुठी दी।<verse eid="JOB 12:6" /></para>
  <para style="s">ज़ै शिखल़णअ च़ाहा तै शिखल़ा</para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 12:7" />ज़ै कुंण शिखल़णअ च़ाहे,</para>
  <para style="q" vid="JOB 12:7">सह सका बणें ज़ीबा अर च़ेल्‍लू-पखीरू का बी शिक्षा लई।<verse eid="JOB 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 12:8" />धरती अर समुंदरे पाणीं जैंदरे</para>
  <para style="q" vid="JOB 12:8">ज़ीबा अर म्हाछ़ली का बी भेटा शिक्षा।<verse eid="JOB 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 12:9" />तिंयां बी समझ़ा ऐहा गल्‍ला कि</para>
  <para style="q" vid="JOB 12:9">तिंयां आसा बिधाता आप्पै बणाऐं दै।<verse eid="JOB 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 12:10" />सोभी ज़ीबे ज़िन्दगी आसा परमेशरे हाथै,</para>
  <para style="q" vid="JOB 12:10">मणछा लै शाह बी दैआ सह ई।<verse eid="JOB 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 12:11" />ज़ेही ज़िभ सुआद परखणां लै हआ,</para>
  <para style="q" vid="JOB 12:11">तिहै ई हआ कान गल्‍ला परखणां लै।<verse eid="JOB 12:11" /></para>
  <para style="q">
    <verse number="12-13" style="v" sid="JOB 12:12-13" />प्रोढै मणछा हआ अक्ल अर सुंबल़ी सोर,</para>
  <para style="q" vid="JOB 12:12-13">पर असली अक्ल अर ज़ोर आसा बिधाता का,</para>
  <para style="q" vid="JOB 12:12-13">असली समझ़ अर सलाह बी भेटा तेऊ ई का।<verse eid="JOB 12:12-13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 12:14" />ज़ुंण परमेशरै ढोल़ी हेरअ, तेऊ निं कोहै भिई च़िणीं सकदअ,</para>
  <para style="q" vid="JOB 12:14">ज़ुंण तेऊ आप्पै कैद करी हेरअ, तेऊ बी निं कोहै तेता का छ़ड़ैऊई सकदअ।<verse eid="JOB 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 12:15" />ज़ै सह सरग हणैं निं दैए सारी धरती हणीं रेगीस्ताना ज़ेही शुक्‍की,</para>
  <para style="q" vid="JOB 12:15">ज़ांऊं सह पाणीं छ़ाडी हेरा, तेखअ सका सारी धरती दी पाणीं प्रल़या करी।<verse eid="JOB 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 12:16" />परमेशर का आसा सारअ बल, तेऊ निं कोहै हारी सकदअ,</para>
  <para style="q" vid="JOB 12:16">धोखै खाणैं अर धोखै करनै आल़ै आसा दुही प्रैंदै सह ई राज़अ।<verse eid="JOB 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 12:17" />बडै-बडै बज़ीरे अक्ल बी निं तेऊ सेटा काम करदी,</para>
  <para style="q" vid="JOB 12:17">अर मशूर पांच़ बी हआ तेऊ सेटा ऐडै।<verse eid="JOB 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 12:18" />सह बशैल़ा बडै-बडै राज़ै बी राज़गाद्दी का धरनीं,</para>
  <para style="q" vid="JOB 12:18">संघा दैआ तिन्‍नां शांघल़ी लोहै पाई गलामी दी डेऊणैं।<verse eid="JOB 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 12:19" />सह काढा प्रोहता बी तिन्‍नें पदबी का पोर्ही,</para>
  <para style="q" vid="JOB 12:19">ज़ुंण बडै-बडै जोधै फिरा, तिन्‍नां बशैल़ा सह ठुंईऐं।<verse eid="JOB 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 12:20" />तेऊ सेटा हआ मशूर सलाहकार च़ुप्पी,</para>
  <para style="q" vid="JOB 12:20">सैणें गल्‍ला बी निं तेऊ सेटा काम करदी।<verse eid="JOB 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 12:21" />बडै-बडै महान राज़ै बी करा सह शर्मिंदै,</para>
  <para style="q" vid="JOB 12:21">तेऊ सेटा निं बडै-बडै जोधै बी ज़ोर-ज़ाहण रहंदै।<verse eid="JOB 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 12:22" />न्हैरै दी हुऐ दै गुप्त भेद बी करा सह प्रगट,</para>
  <para style="q" vid="JOB 12:22">नटिप्प न्हैरै दी बी पजैल़ा सह प्रैश्शअ।<verse eid="JOB 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 12:23" />देशा-देशा करा सह ई बलबान अर मशूर,</para>
  <para style="q" vid="JOB 12:23">तिन्‍नां हारनै अर गलामी दी पाणै आल़अ बी आसा सह ई।<verse eid="JOB 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 12:24" />तिन्‍नां प्रैंदै राज़ करनै आल़ेए करा सह सोर-समझ़ ई खतम,</para>
  <para style="q" vid="JOB 12:24">संघा पाआ तिन्‍नां एही करबैऊंणीं ज़ैगा लै कबाता</para>
  <para style="q" vid="JOB 12:24">ज़ेथ दूर-दूर तैणीं कुंण मणछ निं भेटदअ।<verse eid="JOB 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 12:25" />तेऊ न्हैरै दै हांढदी लागा तिन्‍नां</para>
  <para style="q" vid="JOB 12:25">शराबी ज़िहै धाक्‍कै फर्नैक्‍कै।”<verse eid="JOB 12:25" /></para>
  <chapter eid="JOB 12" />
  <chapter number="13" style="c" sid="JOB 13" />
  <para style="s">मुखा आसा थोघ अर हुंह जाआ समझ़ी</para>
  <para style="q">
    <verse number="1-2" style="v" sid="JOB 13:1-2" />“साथीओ, ज़ुंण गल्‍ला तम्हैं बोली,</para>
  <para style="q" vid="JOB 13:1-2">तिंयां आसा मंऐं बी शूणीं दी, हुंह जाआ इना सोभी गल्‍ला समझ़ी,</para>
  <para style="q" vid="JOB 13:1-2">तम्हां का निं इहअ किछ़ै आथी ज़ेतो मुखा थोघ निं होए।</para>
  <para style="q" vid="JOB 13:1-2">हुंह निं किछ़ी गल्‍ला लै तम्हां का घट आथी।<verse eid="JOB 13:1-2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 13:3" />पर हुंह निं तम्हां लै आथी बोल्दअ लागअ द, मेरी हठ आसा परमेशरा संघै ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 13:3">मुंह करनी तेऊ संघै गल्‍ला कि मेरअ निं किछ़ै कशूर आथी।<verse eid="JOB 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 13:4" />पर तम्हैं बोला शुची गल्‍ला दाबणा लै झ़ुठअ,</para>
  <para style="q" vid="JOB 13:4">तम्हैं आसा इहै बैईद ज़सरी दुआई करै रोगी राम ई निं हंदअ।<verse eid="JOB 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 13:5" />असली अक्लीए गल्‍ल हणीं ती थारी एही कि तम्हैं च़ुप्पी रहंदै!<verse eid="JOB 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 13:6" />अर मेरी गल्‍ला धैन दैई शुणदै कि</para>
  <para style="q" vid="JOB 13:6">हुंह किज़ू गल्‍ले हठ करदअ आसा लागअ द।<verse eid="JOB 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 13:7" />तम्हैं कै सोठा, झ़ुठअ बोली अर लोगा लै धोखअ दैई</para>
  <para style="q" vid="JOB 13:7">कै तम्हैं परमेशरे मज़त करदै आसा लागै दै?<verse eid="JOB 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 13:8" />तम्हैं कै परमेशरे बकील आसा?</para>
  <para style="q" vid="JOB 13:8">दालता दी करनी तम्हां तेऊए पक्षा दी हठ?<verse eid="JOB 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 13:9" />ज़ै परमेशर तम्हां राम्बल़ै करै ज़ाच़े-भाल़े, तेऊ का तम्हां दी</para>
  <para style="q" vid="JOB 13:9">किज़ै भली गल्‍ला शुझुई जाणीं? तम्हैं कै इहअ सोठा कि ज़िहै</para>
  <para style="q" vid="JOB 13:9">तम्हैं मणछा ठगा, तिहअ तम्हां सह परमेशर बी ठगणअ?<verse eid="JOB 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 13:10" />तेऊ निं तम्हैं ठगी सकदै, ज़ै तम्हैं च़ुप्प-च़ुप्पै बी धोखअ किअ होए</para>
  <para style="q" vid="JOB 13:10">तेऊ फरेऊंणी तम्हां लै तेते बी सज़ा दैई आद अर<verse eid="JOB 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 13:11" />ज़ांऊं तेऊ आपणअ महान ज़ोर रहैऊंणअ,</para>
  <para style="q" vid="JOB 13:11">तम्हां छ़ुटणअ दर्छ़णअ।<verse eid="JOB 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 13:12" />थारी सैणीं गल्‍ला हणीं छ़ारा ज़ेही बृथा,</para>
  <para style="q" vid="JOB 13:12">थारी हठ हणीं माट्टे भांडै ज़ेही काच़ी।<verse eid="JOB 13:12" /></para>
  <para style="s">ऐबै शूणां ठुंईऐं बेशी मेरी गल्‍ला</para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 13:13" />ऐबै लआ च़ुपच़ाप रही मेरी गल्‍ला शूणीं,</para>
  <para style="q" vid="JOB 13:13">तेखअ च़ाऐ मुल्है ज़िहअ होए सह लागे हंदअ।<verse eid="JOB 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 13:14" />एतो नतिज़अ मुल्है ज़िहअ बी होए,</para>
  <para style="q" vid="JOB 13:14">तेतो ज़िम्मैंबार आसा हुंह आप्पै।<verse eid="JOB 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 13:15" />मंऐं आसा हेरी दी एही आशा चोल़ी,</para>
  <para style="q" vid="JOB 13:15">तेखअ परमेशर मुंह मारी बी पाए, तैबी किज़ै?</para>
  <para style="q" vid="JOB 13:15">मुंह लणी आप्पू बाखा तेऊ सेटा आपणीं गल्‍ला खोज़ी।<verse eid="JOB 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 13:16" />हई सका कि इहअ करै हुंह बच़ी बी जाए,</para>
  <para style="q" vid="JOB 13:16">किल्हैकि हुंह आसा नर्दोश,</para>
  <para style="q" vid="JOB 13:16">किल्हैकि कदुष्ट मणछ निं तेऊ सम्हनै डेऊई सकदअ।<verse eid="JOB 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 13:17" />ऐबै शूणां मेरी गल्‍ला कान खोल्ही करै।<verse eid="JOB 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 13:18" />ऐबै लाअ मंऐं आपणअ पक्ष परमेशरे दालता दी डाही,</para>
  <para style="q" vid="JOB 13:18">तम्हैं लागै भाल़ै हुंह निखल़णअ शुचअ।<verse eid="JOB 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 13:19" />ऐहा गल्‍ला लै कहा करनी मुंह संघै पांच़ी?</para>
  <para style="q" vid="JOB 13:19">ज़ै मुंह दी खोट निखल़े, तै पाणीं मुंह बोल़णें छ़ाड़</para>
  <para style="q" vid="JOB 13:19">अर हुंह आसा मरना लै बी तैर।<verse eid="JOB 13:19" /></para>
  <para style="s">हुंह पुछ़ा सिधी दूई गल्‍ला</para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 13:20" />हे परमेशर, तूह दै मुल्है सिधी दूई गल्‍ले ज़ाज़त,</para>
  <para style="q" vid="JOB 13:20">तै एछणी मुंह ताह सम्हनै गल्‍ला करने हिम्मत।<verse eid="JOB 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 13:21" />एक, कर ऐबै मुल्है सज़ा दैणा लै हुअ,</para>
  <para style="q" vid="JOB 13:21">दुजअ इहअ कि ऐबै मुंह डरैऊई बी निं आथी।<verse eid="JOB 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 13:22" />हे परमेशर, कि पुछ़ तूह मुखा अर हुंह दैंऊं तेतो ज़बाब,</para>
  <para style="q" vid="JOB 13:22">कि दैऐ मुंह बोल़णैं संघा दैऐ तूह तेतो ज़बाब।<verse eid="JOB 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 13:23" />तूह खोज़ मुखा मंऐं किज़ै पाप किऐ? मंऐं किज़ै-किज़ै कशूर किअ?</para>
  <para style="q" vid="JOB 13:23">ताकि मुखा इहअ थोघ लागे कि मेरै आसा इहै पाप-दोश।<verse eid="JOB 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 13:24" />तंऐं किल्है आसा मुंह बाखा पिठ फरेऊई दी?</para>
  <para style="q" vid="JOB 13:24">तूह किल्है करा मुंह संघै दुशमणा ज़िहअ बभार।<verse eid="JOB 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 13:25" />तूह मुंह डरैऊंदअ आसा लागअ द? हुंह आसा डाल़ा का अल़ै दै शुक्‍कै पाचा ज़िहअ,</para>
  <para style="q" vid="JOB 13:25">तूह आसा शुक्‍की डिंढी पिछ़ू पल़अ द।<verse eid="JOB 13:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 13:26" />तंऐं डाहै मुल्है आपणीं नसाफे बही दी</para>
  <para style="q" vid="JOB 13:26">बेघै बूरी सज़ा लिखी!</para>
  <para style="q" vid="JOB 13:26">तंऐं डाहअ हुंह तेते सज़ा भुगतदअ लाई ज़ुंण</para>
  <para style="q" vid="JOB 13:26">मेरी खारकी अमरा भूल-च़ूक हुई!<verse eid="JOB 13:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 13:27" />तंऐं डाहै मेरै खूर शांघल़ी करे काठा दी बान्हीं, संघा रहा तूह हर घल़ी मुंह भाल़अ लागी,</para>
  <para style="q" vid="JOB 13:27">तूह करा राम्बल़ै करै ज़ाच़-भाल़ कि मेरै धरनीं मेरै खूरे नछ़ैण किनी लागै।<verse eid="JOB 13:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 13:28" />हुंह हुअ सूल़ी खाऐ दै काठा अर</para>
  <para style="q" vid="JOB 13:28">ल्हऐ खाऐ दै च़ादरू ज़िहअ।”<verse eid="JOB 13:28" /></para>
  <chapter eid="JOB 13" />
  <chapter number="14" style="c" sid="JOB 14" />
  <para style="s">ज़िन्दगी आसा थोल़ी ज़ेही</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 14:1" />हाम्हां मणछे अमर आसा धख ज़ेही अर</para>
  <para style="q" vid="JOB 14:1">तेथ बी आसा खास्सी आफ़त।<verse eid="JOB 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 14:2" />हाम्हैं बझ़ा फूला ज़िहै झ़ट च़ारै,</para>
  <para style="q" vid="JOB 14:2">तेतरी जाआ छ़ैल्‍ली ज़िहै हेरा-हेरी मुक्‍की।<verse eid="JOB 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 14:3" />हे परमेशर, तज़ी बी ताह हुंह ई भेटअ परखणां लै?</para>
  <para style="q" vid="JOB 14:3">तंऐं किल्है घिशअ हुंह दालता लै ज़ेथ तूह नसाफ करा?<verse eid="JOB 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 14:4" />इहअ निं कधि हई ई सकदअ कि</para>
  <para style="q" vid="JOB 14:4">हाम्हां मणछा ज़ेही छ़ोतली च़िज़ा का किज़ै शुचअ निखल़े।<verse eid="JOB 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 14:5" />हाम्हां मणछे अमर आसा धरती दी पैहलै ई तंऐं आप्पै नापी करै डाही दी कि</para>
  <para style="q" vid="JOB 14:5">हाम्हैं केतरै भिन्‍नैं अर केतरै धैल़ै ज़िऊंणै।</para>
  <para style="q" vid="JOB 14:5">ज़ुंण रह-तह तंऐं आप्पै किअ, सह हआ अटल़।<verse eid="JOB 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 14:6" />तूह हाम्हां कल्ही किल्है निं छ़ाडदअ?</para>
  <para style="q" vid="JOB 14:6">तै झ़ाणीं म्हारी ऐहा मज़दूरा ज़ेही कठण ज़िन्दगी दी</para>
  <para style="q" vid="JOB 14:6">धख खुशी भेटी जांदी।<verse eid="JOB 14:6" /></para>
  <para style="s">हाम्हैं आणै हारी-मारी</para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 14:7" />“ज़ै डाल़-बूट काटी बी पाए, तेते हआ एही आशा कि</para>
  <para style="q" vid="JOB 14:7">तेथ जाणीं भिई टिरा निखल़ी</para>
  <para style="q" vid="JOB 14:7">संघा जाणैं तिंयां डाल़-बूट भिई तिहै ई बझ़ी।<verse eid="JOB 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 14:8" />च़ाऐ तेते ज़लैल़ै मछैंईं बी जाए अर</para>
  <para style="q" vid="JOB 14:8">तेते डुंघ शुक्‍की बी जाए,<verse eid="JOB 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 14:9" />पाणीं हई जाआ तिंयां भिई टिर्खुई,</para>
  <para style="q" vid="JOB 14:9">संघा लागा तेता का नऊंईं बुटी बझ़दी।<verse eid="JOB 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 14:10" />पर ज़ांऊं हाम्हैं मणछ मरा, तेखअ निं तिधा आजू तेऊए ज़िन्दगी आथी!</para>
  <para style="q" vid="JOB 14:10">ज़ांऊं मणछा का शाह पोर्ही निखल़ा तेखअ किधी आसा हाम्हैं?<verse eid="JOB 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 14:11" />हाम्हैं हआ तेखअ एही शुक्‍की दी गाडा अर</para>
  <para style="q" vid="JOB 14:11">शुक्‍कै दै सअरा ज़िहै ज़ेथ पाणींओ टिप्पू बी निं हंदअ।<verse eid="JOB 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 14:12" />ज़ांऊं मणछ मौते निंजा सुत्ती गअ, तेखअ निं सह भिई खल़अ उझ़दअ,</para>
  <para style="q" vid="JOB 14:12">ज़ेभै तैणीं सरग आसा तेभै तैणीं निं तेखअ</para>
  <para style="q" vid="JOB 14:12">तैहा निंजा का खल़अ उझ़दअ।<verse eid="JOB 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 14:13" />हे परमेशर, ज़ीबाण, ज़ेभै तैणीं</para>
  <para style="q" vid="JOB 14:13">तेरअ रोश्श फांभअ निं होए,</para>
  <para style="q" vid="JOB 14:13">तेभै तैणीं डाह तूह मुंह धरती दी उंधै डुघी घोरी दी च़ोरी,</para>
  <para style="q" vid="JOB 14:13">तेखअ ज़ुंण धैल़ी तूह काढी डाहे, तेभै करै तूह मेरी आद।<verse eid="JOB 14:13" /></para>
  <para style="s">मणछ कै भिई ज़िऊई सका?</para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 14:14" />मणछ कै मरी करै भिई ज़िऊंदअ हई सका?</para>
  <para style="q" vid="JOB 14:14">पर मुंह रहणअ तैहा घल़ी न्हैल़ै लागी</para>
  <para style="q" vid="JOB 14:14">ज़हा घल़ी मेरी आफ़त खतम हणीं।<verse eid="JOB 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 14:15" />हे परमेशर, तेभै लाणीं ताह मुल्है हाक्‍का अर</para>
  <para style="q" vid="JOB 14:15">मुंह करनअ होए, तूह हणअ तेभै मुल्है राज्ज़ी</para>
  <para style="q" vid="JOB 14:15">किल्हैकि हुंह आसा तंऐं आपणैं हाथै बणाअं द।<verse eid="JOB 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 14:16" />ताह डाहणअ तेभै मेरी गंईं-गंईं हांढणेओ धैन</para>
  <para style="q" vid="JOB 14:16">पर तेभै निं ताह मेरै पाप गणनै आथी।<verse eid="JOB 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 14:17" />ताह छ़ाडणीं मुल्है माफी अर</para>
  <para style="q" vid="JOB 14:17">मेरै पाप करनै ताह मुखा दूर,</para>
  <para style="q" vid="JOB 14:17">ताह धोणैं मेरै सोभै पाप-दोश।<verse eid="JOB 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 14:18" />हर गल्‍लो एछा बगत</para>
  <para style="q" vid="JOB 14:18">बडै-बडै पर्बत पल़ा ढूल़ी धरनीं,</para>
  <para style="q" vid="JOB 14:18">बडी-बडी टोल्हा बी सिक्‍का ओर्ही-पोर्ही,<verse eid="JOB 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 14:19" />पाणीं धेल़ा पात्थर बी,</para>
  <para style="q" vid="JOB 14:19">बरसात निंयां माट्टअ-गट्टअ बहाऊई,</para>
  <para style="q" vid="JOB 14:19">तेही ई करा तूह मणछे आशा बी खतम।<verse eid="JOB 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 14:20" />तूह ज़िता मणछा का सदा</para>
  <para style="q" vid="JOB 14:20">संघा करा तिन्‍नां सदा लै दूर,</para>
  <para style="q" vid="JOB 14:20">तूह दैआ मरदी बारी मणछो मुंह ई बगाल़ी।<verse eid="JOB 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 14:21" />मरी करै निं तेखअ तेऊ का थोघ लागदअ कि</para>
  <para style="q" vid="JOB 14:21">पिछ़ू तेऊए शोहरूओ लोग अदर करा कि</para>
  <para style="q" vid="JOB 14:21">तिंयां गरीबी दी शर्मिंदै हई आसा ज़िऊंदै लागै दै!<verse eid="JOB 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 14:22" />दाह-दुख ज़ाण्हिंआं मणछा का सिधअ आपणीं देही दी,</para>
  <para style="q" vid="JOB 14:22">शोग बी पल़ा मणछे आपणैं शाह दी।”<verse eid="JOB 14:22" /></para>
  <chapter eid="JOB 14" />
  <chapter number="15" style="c" sid="JOB 15" />
  <para style="s">एलीपज बोला आयूबा लै</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 15:1" />तेखअ लागअ तेमान नगरीओ एलीपज आयूबा लै बोल्दअ,<verse eid="JOB 15:1" /></para>
  <para style="q">
    <verse number="2-3" style="v" sid="JOB 15:2-3" />“आयूब, ईंयां लाई बै तंऐं ज़ाथी नथोघी गल्‍ला!</para>
  <para style="q" vid="JOB 15:2-3">ज़ै कहा मणछा अक्ल होए, सह निं आप्पू नर्दोश खोज़णा लै</para>
  <para style="q" vid="JOB 15:2-3">ताह ज़ेही एही नथोघी गल्‍ला करदअ।<verse eid="JOB 15:2-3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 15:4" />ज़ै तेरी गल्‍ले ज़ाणैं लागे,</para>
  <para style="q" vid="JOB 15:4">तै निं कोही परमेशरे डअर रहणीं,</para>
  <para style="q" vid="JOB 15:4">नां तेऊ सेटा कुंणी अरज़ लाई करी।<verse eid="JOB 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 15:5" />तेरी गल्‍ला का जाआ ज़ाण्हुंई कि तूह भितरा का किहअ कदुष्ट आसा!</para>
  <para style="q" vid="JOB 15:5">गल्‍ला सज़ाऊई लाआ तूह आंट।<verse eid="JOB 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 15:6" />हुंह निं इधी तेरी पांच़ी करदअ आथी बेठअ द,</para>
  <para style="q" vid="JOB 15:6">तेरी आपणीं गल्‍ला ई आसा तेरै बारै शाजत</para>
  <para style="q" vid="JOB 15:6">कि कशूरबार आसा तूह ई।<verse eid="JOB 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 15:7" />तूह आप्पू लै कै समझ़ा कि तूह मणछ संसारै सोभी का आजी आसा हुअ द?</para>
  <para style="q" vid="JOB 15:7">ज़धू बिधाता ईंयां पर्बत बणाऐं, तूह कै तधू हई त गअ द?<verse eid="JOB 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 15:8" />तंऐं कै स्वर्गै बिधाते सभा दी बेशी शूणीं ईंयां गल्‍ला?</para>
  <para style="q" vid="JOB 15:8">मणछा मांझ़ै कै अक्ल सिधी ताखा आसा?<verse eid="JOB 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 15:9" />ताखा इहअ किज़ै आसा ज़ेतो थोघ हाम्हां का निं आथी?</para>
  <para style="q" vid="JOB 15:9">ताखा एही कै समझ़ आसा ज़ुंण हाम्हैं निं समझ़दै?<verse eid="JOB 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 15:10" />हाम्हैं आसा ईंयां अक्लीए गल्‍ला सैणैं-प्रोढै का शिखल़ी दी,</para>
  <para style="q" vid="JOB 15:10">ज़ुंण तेरै दादा-बाबा का बी ज़ेठै आसा।<verse eid="JOB 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 15:11" />परमेशरै दैनअ ताल्है आप्पै हैअ,</para>
  <para style="q" vid="JOB 15:11">तेता करै बी तेरै हुअ निं आथी?<verse eid="JOB 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 15:12" />तूह किल्है आसा इहअ फहुंकुअ द?</para>
  <para style="q" vid="JOB 15:12">तेरी आछी किल्है आसा लाल हुई दी?<verse eid="JOB 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 15:13" />एऊ साबै आसा तेरै ईंयां रोश्श परमेशरा लै अर</para>
  <para style="q" vid="JOB 15:13">ईंयां बृथा गल्‍ला बी बोली तंऐं तेऊ ई लै।<verse eid="JOB 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 15:14" />मणछा मांझ़ै निं इहअ कोहै आथी</para>
  <para style="q" vid="JOB 15:14">ज़ुंण परमेशरा संघै शुचअ अर धर्मीं होए।<verse eid="JOB 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 15:15" />परमेशर निं आपणैं पबित्र स्वर्ग दूता प्रैंदै बी भरोस्सअ करदअ,</para>
  <para style="q" vid="JOB 15:15">सारअ भ्रमंड बी निं तेऊ सेटा शुचअ आथी।<verse eid="JOB 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 15:16" />हाम्हैं करा पाप ज़िहअ कि पाणींओ गलास झुटअ होए,</para>
  <para style="q" vid="JOB 15:16">हाम्हैं मणछ आसा भ्रष्ट अर बृथा हुऐ दै।<verse eid="JOB 15:16" /></para>
  <para style="s">ज़ुंण हुंह ज़ाणा तेता शुण</para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 15:17" />आयूब, ऐबै शुण तूह मेरी ज़ुंण मंऐं</para>
  <para style="q" vid="JOB 15:17">आझ़ तैणीं ज़ाणीं-भाल़ी दी आसा।<verse eid="JOB 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 15:18" />ईंयां गल्‍ला आसा मंऐं अक्ली आल़ै मणछा का शिखल़ी दी,</para>
  <para style="q" vid="JOB 15:18">ज़ुंण तिंयां आपणैं दादा-बाबा ओर्ही शिखल़दी आऐ,</para>
  <para style="q" vid="JOB 15:18">तिन्‍नैं निं एतो किछ़ै भेद च़ोरी डाहअ।<verse eid="JOB 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 15:19" />परमेशरै ज़हा लै एही सोर दैनी,</para>
  <para style="q" vid="JOB 15:19">तिन्‍नां लै दैनअ तेऊ ज़ुदअ ज़िहअ देश बी,</para>
  <para style="q" vid="JOB 15:19">तिन्‍नां मांझ़ै निं कोहै परदेसी बी थिअ</para>
  <para style="q" vid="JOB 15:19">कि तिंयां तेऊ का होरी रंगे गल्‍ला शिखल़े।<verse eid="JOB 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 15:20" />ज़ुंण कदुष्ट मणछ होरी हंता,</para>
  <para style="q" vid="JOB 15:20">तेऊ लागा सारी ज़िन्दगी तेते सज़ा भुगतणी।<verse eid="JOB 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 15:21" />तिन्‍नें कानै लागा डरैऊंणी क्रिंगा शुण्हदी,</para>
  <para style="q" vid="JOB 15:21">ज़ेभै तिंयां इहअ सोठा कि तिंयां आसा राज्ज़ी-मौज़ी,</para>
  <para style="q" vid="JOB 15:21">तेभै पै गोटा तिन्‍नां च़ोर-डाकू फेरा-फेर।<verse eid="JOB 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 15:22" />तिन्‍नें हआ न्हैरै का छ़ुटणे आशा ई खतम,</para>
  <para style="q" vid="JOB 15:22">कुंण नां कुंण हआ तिन्‍नां मारना लै ताखुई रहअ द।<verse eid="JOB 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 15:23" />रोटी पिछ़ू रहा तिंयां ज़ैगै-ज़ैगै ठुहर्दै लागी,</para>
  <para style="q" vid="JOB 15:23">तिन्‍नां का जाआ आप्पू ज़ाण्हुंई कि</para>
  <para style="q" vid="JOB 15:23">आजू आसा तिन्‍नें ज़िन्दगी दी न्हैरअ ई।<verse eid="JOB 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 15:24" />तिन्‍नां रहा फिकर पल़ी कि किज़ै बूरअ निं लोल़ी त हुअ,</para>
  <para style="q" vid="JOB 15:24">आजू निं लोल़ी ती किज़ै आफ़त पल़ी।</para>
  <para style="q" vid="JOB 15:24">तिंयां रहा तेता लै राज़ै ज़िहै जुधा लै तैर्हुई।<verse eid="JOB 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 15:25" />तिन्‍नां लै करा इहअ हई किल्हैकि तिंयां आसा</para>
  <para style="q" vid="JOB 15:25">तेऊ परमेशरे द्रोही ज़हा का सारअ बल आसा।<verse eid="JOB 15:25" /></para>
  <para style="q">
    <verse number="26-27" style="v" sid="JOB 15:26-27" />तिंयां आसा शरेरै द्रोही, तिंयां आसा इहै हठू कि</para>
  <para style="q" vid="JOB 15:26-27">तिंयां ठुर्हा आपणीं ढाल़ च़की परमेशरा संघै जुधा करदै!<verse eid="JOB 15:26-27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 15:28" />तिंयां आसा बरैबाद हुई दी नगरी अर इहै</para>
  <para style="q" vid="JOB 15:28">घअरै बस्सै दै ज़ेते मालक तेता छ़ाडी आसा डेऊऐ दै,</para>
  <para style="q" vid="JOB 15:28">पर तिंयां नगरी अर घअर हणैं जुधा दी पठी बरैबाद।<verse eid="JOB 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 15:29" />आजू नां तिंयां सेठ रहणैं अर</para>
  <para style="q" vid="JOB 15:29">नां तिन्‍नां का ज़ैदात रहणीं।</para>
  <para style="q" vid="JOB 15:29">तिन्‍नें छ़ैल्‍ली बी डेऊणीं तिन्‍नां का दूर।<verse eid="JOB 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 15:30" />तिंयां निं न्हैरै का छ़ुटी सकदै।</para>
  <para style="q" vid="JOB 15:30">तिंयां हणैं इहै बूटा ज़िहै ज़ुंण आगी करै पठी हआ झल़ुशुअ द अर</para>
  <para style="q" vid="JOB 15:30">तेते शुक्‍कै दै पाच बी निखल़ा बागरी करै दूर।<verse eid="JOB 15:30" /></para>
  <para style="q">
    <verse number="31-32" style="v" sid="JOB 15:31-32" />ज़िहअ तिंयां बृथा च़िज़े भरोस्सै रहै,</para>
  <para style="q" vid="JOB 15:31-32">ऐबै हुऐ तिंयां बी तिहै ई बृथा।</para>
  <para style="q" vid="JOB 15:31-32">तिंयां हुऐ इहै डाल़ा-बूटा ज़िहै ज़ेता</para>
  <para style="q" vid="JOB 15:31-32">छ़ेक्‍कै हेरा काटी पाई अर तेखअ</para>
  <para style="q" vid="JOB 15:31-32">निं तेथ भिई हरै पाच निखल़दै।<verse eid="JOB 15:31-32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 15:33" />तिंयां हुऐ एही दाखे बेला ज़िहै</para>
  <para style="q" vid="JOB 15:33">ज़ेते दाणैं पाकणै का आजी जाआ धरनीं अल़ी अर</para>
  <para style="q" vid="JOB 15:33">जैतूने इहै बूटा ज़िहै ज़ेते फूल फल़ा लागणै का आजी जाआ अल़ी।<verse eid="JOB 15:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 15:34" />अह गल्‍ल आशा शुची कि पापी मणछे निं</para>
  <para style="q" vid="JOB 15:34">आजू आद-लुआद ई रहंदी,</para>
  <para style="q" vid="JOB 15:34">ज़ुंण रेशपत खाआ तिन्‍नें डेरै लै पल़ा सरगा का बीज।<verse eid="JOB 15:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 15:35" />ईंयां गल्‍ला हआ तेऊ लै ज़ुंण होरी लै आफ़त पाआ अर बूरअ सोठा,</para>
  <para style="q" vid="JOB 15:35">अर ज़सरै मन्‍नैं कबल्‍लअ छ़ल़-कपट रहा।”<verse eid="JOB 15:35" /></para>
  <chapter eid="JOB 15" />
  <chapter number="16" style="c" sid="JOB 16" />
  <para style="s">आयूबै दैनअ एलीपजा लै ज़बाब</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 16:1" />तेखअ दैनअ आयूबै इहअ ज़बाब,<verse eid="JOB 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 16:2" />इना एही गल्‍ला आअ हुंह शुणदी,</para>
  <para style="q" vid="JOB 16:2">ज़ेही झेठ तम्हैं किई, तेता करै उझ़िआ होर बी झोशा।<verse eid="JOB 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 16:3" />तम्हैं इना नथोघी गल्‍ला केभै मुक्‍कणैं करी?</para>
  <para style="q" vid="JOB 16:3">तम्हैं किज़ू गल्‍ला पिछ़ू आसा इहै भुल़्हखदै लागै दै?<verse eid="JOB 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 16:4" />ज़ै हुंह थारी ज़ैगा हंदअ अर</para>
  <para style="q" vid="JOB 16:4">थारी हालत मुंह ज़ेही हंदी,</para>
  <para style="q" vid="JOB 16:4">तै सका त हुंबी तम्हां लै इना ई गल्‍ला बोली</para>
  <para style="q" vid="JOB 16:4">अर एही गल्‍लो सका त मुंह तम्हां लै हर्हल फरेऊई।<verse eid="JOB 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 16:5" />पर हुंह निं तम्हां ज़िहअ आथी,</para>
  <para style="q" vid="JOB 16:5">मुंह दैणअ त तम्हां लै राम्बल़ी सलाह खोज़ी हैअ,</para>
  <para style="q" vid="JOB 16:5">मुंह करनी ती थारी एही झेठ ज़िहअ करै थारअ दुख घटदअ।<verse eid="JOB 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 16:6" />पर मुल्है निं ऐबै मेरै बोल़णैं करै</para>
  <para style="q" vid="JOB 16:6">किछ़ै मज़त च़ाल्‍ली भेटी अर</para>
  <para style="q" vid="JOB 16:6">नां मेरै च़ुप्पी रहणैं करै मेरी दाह दी राम च़ाल्‍लअ भेटी।<verse eid="JOB 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 16:7" />परमेशरै निं मुंह दी तराण ई डाहै,</para>
  <para style="q" vid="JOB 16:7">तेऊ किअ मेरअ घअर-टबर पठी बरैबाद।<verse eid="JOB 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 16:8" />तेऊ किअ हुंह कैद ज़िहअ कि हुंह आसा तेरअ दुशमण,</para>
  <para style="q" vid="JOB 16:8">हुंह शुक्‍कअ-मुक्‍कअ पठी अर</para>
  <para style="q" vid="JOB 16:8">मेरी घेरीए बोजा आसा ऐहा गल्‍ले शाजत।<verse eid="JOB 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 16:9" />परमेशर डाहा मुल्है ज़ीद, तेऊए रोश्शै धेल़अ-च़िरअ हुंह पठी,</para>
  <para style="q" vid="JOB 16:9">सह भाल़ा मुंह बाखा दांद कटिल्‍ली अर लाल-पिंऊंल़ी आछी करी।<verse eid="JOB 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 16:10" />लोग लागै मुल्है हास्सदै अर सुहांगा करदै,</para>
  <para style="q" vid="JOB 16:10">तिंयां झाल़्हिआ मुंह फेर संघा बाहा मेरै थोथरै तमाच़ै।<verse eid="JOB 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 16:11" />परमेशरै शोट्टअ हुंह पापी मणछा जैंदरी,</para>
  <para style="q" vid="JOB 16:11">तेऊ डाहअ हुंह कदुष्ट मणछे बशै पाई।<verse eid="JOB 16:11" /></para>
  <para style="s">मेरै ती सोभी गल्‍ले मौज़</para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 16:12" />हुंह त राज्ज़ी-मौज़ी ज़िऊंदअ लागअ द,</para>
  <para style="q" vid="JOB 16:12">पर परमेशरै ढाकअ हुंह कैल़ै का,</para>
  <para style="q" vid="JOB 16:12">संघा किऐ मेरै धरनीं झेची करै ठोर-ठोर।</para>
  <para style="q" vid="JOB 16:12">धरना का खल़अ बी झ़ैऊअ तेऊ एता लै कि सह<verse eid="JOB 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 16:13" />फेरा-फेर कतीरै बाही मुल्है नशाणअ लाई सके!</para>
  <para style="q" vid="JOB 16:13">तेऊए कतीरा करै हुअ हुंह छिझ-बरिझअ,</para>
  <para style="q" vid="JOB 16:13">धरनीं लागी लोधल़े छेरा!</para>
  <para style="q" vid="JOB 16:13">पर तज़ी बी निं तेऊ मुल्है झींण फिरी!<verse eid="JOB 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 16:14" />सह रहअ जोधै ज़िहअ भिई-भिई मुंह च़िक्‍कदअ लागी।<verse eid="JOB 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 16:15" />दुखी हई डाहै मंऐं आपणीं घेरी च़िथल़ै बान्हीं,</para>
  <para style="q" vid="JOB 16:15">संघा रहअ हारी करै इधी धूल़ै-माट्टै जैंदरी बेशी।<verse eid="JOB 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 16:16" />लेरी-लेरी हुअ मेरअ मुंह बी लाल,</para>
  <para style="q" vid="JOB 16:16">मेरी शुंआंईं आछी अर आछी फेर पल़ी काल़ी हेर।<verse eid="JOB 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 16:17" />एतरअ हई बी निं मंऐं किज़ै उपद्रभ किअ,</para>
  <para style="q" vid="JOB 16:17">परमेशरा सेटा मेरी अरज़ आसा शुची।<verse eid="JOB 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 16:18" />“हे धरती, ज़ुंण मुल्है बूरअ हुअ, तेता निं च़ोरी डाही!</para>
  <para style="q" vid="JOB 16:18">नसाफ मांगणा लै ज़ुंण मंऐं लेर-पकार पाई</para>
  <para style="q" vid="JOB 16:18">सह निं लोल़ी च़ुप्पी हुई।<verse eid="JOB 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 16:19" />मेरअ आसा अज़ी बी स्वर्गै एक शाजत,</para>
  <para style="q" vid="JOB 16:19">ज़ुंण मुंह बच़ाऊंणै आल़अ बकील आसा।<verse eid="JOB 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 16:20" />मेरै साथी-संघी हेरअ हुंह शोटी डाही,</para>
  <para style="q" vid="JOB 16:20">पर हुंह पाआ परमेशरा सेटा आशूए छ़ो-छ़न्द।<verse eid="JOB 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 16:21" />हुंह च़ाहा इहअ मणछ कि मुंह बाखा मेरअ बकील परमेशरा सेटा मेरी गल्‍ला एही करे,</para>
  <para style="q" vid="JOB 16:21">ज़िहअ कुंण आपणैं साथीए तैणीं अरज़ करा।<verse eid="JOB 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 16:22" />किल्हैकि मेरी रही ऐबै थोल़ी ज़ेही अमर,</para>
  <para style="q" vid="JOB 16:22">तेखअ लागणअ हुंह तैहा बाता हांढदअ ज़ेता का कोहै फिरी निं एछदअ।”<verse eid="JOB 16:22" /></para>
  <chapter eid="JOB 16" />
  <chapter number="17" style="c" sid="JOB 17" />
  <para style="s">आयूबै कि परमेशरा सेटा अरज़</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 17:1" />ऐबै च़ाल्‍लअ मेरै मर्हुई,</para>
  <para style="q" vid="JOB 17:1">मेरै निस्सअ दोहरअ शाह बी लहुई,</para>
  <para style="q" vid="JOB 17:1">ऐबै च़ाल्‍लअ हुंह तेतरी घोरी दाबणा लै हई ई।<verse eid="JOB 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 17:2" />मुखा आसा लागअ द आछी शुझदअ कि</para>
  <para style="q" vid="JOB 17:2">फेरा-फेर आसा लोग मुल्है ज़िधूऐ दै, द्रोही हुऐ दै अर मेरै सुहांगा लागै दै।<verse eid="JOB 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 17:3" />हे परमेशर, तूह शुण मेरी गल्‍ला,</para>
  <para style="q" vid="JOB 17:3">मुंह सेटा निं ताह छ़ाडी मेरी गल्‍ला</para>
  <para style="q" vid="JOB 17:3">शुणनै आल़अ कोहै आथी।<verse eid="JOB 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 17:4" />तंऐं आसा मन्‍न काठअ किअ द,</para>
  <para style="q" vid="JOB 17:4">तैही निस्सी तिन्‍नां समझ़ एछी,</para>
  <para style="q" vid="JOB 17:4">पर हे परमेशर, ऐबै निं तूह तिन्‍नां</para>
  <para style="q" vid="JOB 17:4">मुखा ज़ितणैं दैई।<verse eid="JOB 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 17:5" />एही कहाबत आसा कि</para>
  <para style="q" vid="JOB 17:5">ज़ुंण आपणैं साथी ठगी करै लुटा,</para>
  <para style="q" vid="JOB 17:5">तेते सज़ा पल़ा तिन्‍नें शोहरू-माठै भुगतणी।<verse eid="JOB 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 17:6" />ऐबै बोला तिंयां ऐहा कहाबता मुल्है,</para>
  <para style="q" vid="JOB 17:6">लोगै लाई मेरै मुंहैं थुक्‍की करै मेरी बेइज़ती करी!<verse eid="JOB 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 17:7" />दाह-दुखै निस्सअ मेरी आछी बी किछ़ै शुझुई,</para>
  <para style="q" vid="JOB 17:7">मेरी ज़ांघा बाहा हुई ताकल़ी ज़ेही भींन।<verse eid="JOB 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 17:8" />ज़ुंण भलै मणछ आसा बी,</para>
  <para style="q" vid="JOB 17:8">तिंयां बी प्राछिआ मुंह भाल़ी!</para>
  <para style="q" vid="JOB 17:8">तेखअ बोला तिंयां बी मुल्है पापी मणछ!<verse eid="JOB 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 17:9" />इहअ आसा कि धर्मीं मणछै</para>
  <para style="q" vid="JOB 17:9">आपणीं बात ढाकी डाही दी अर</para>
  <para style="q" vid="JOB 17:9">शुचअ मणछ रहा धैल़ी पर धैल़ी बढदअ लागी।<verse eid="JOB 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 17:10" />पर ज़ै तिंयां सोभै भिई बी मुंह सेटा एछे,</para>
  <para style="q" vid="JOB 17:10">तैबी निं मुखा तिन्‍नां मांझ़ै सोर-समझ़ा आल़अ शुझणअ।<verse eid="JOB 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 17:11" />मेरै गऐ मरने धैल़ै एछी अर ज़ुंण मंऐं</para>
  <para style="q" vid="JOB 17:11">सोठी त डाहअ द, सह निं हई बोल़अ,</para>
  <para style="q" vid="JOB 17:11">मुंह निं ऐबै किछ़ै आशा रही।<verse eid="JOB 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 17:12" />राची लै बोला मेरै साथी इहअ कि धैल़ी-दपहर आसा!</para>
  <para style="q" vid="JOB 17:12">तिंयां बोला इहअ कि एथ आसा प्रैश्शअ, पर मुखा आसा थोघ कि हुंह आसा न्हैरै दी।<verse eid="JOB 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 17:13" />मुखा आसा आजू सिधी आपणीं मौत शुझदी लागी दी,</para>
  <para style="q" vid="JOB 17:13">तेखअ रहणअ हुंह घोरी दी न्हैरै सदा लै सुत्ती।<verse eid="JOB 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 17:14" />तेखअ सका हुंह मेरी ल्हासा चजेऊणैं आल़ी</para>
  <para style="q" vid="JOB 17:14">घोरी लै आपणअ बाब बोली अर</para>
  <para style="q" vid="JOB 17:14">ज़ुंण किल़ै मेरी ल्हासा खाआ तिन्‍नां लै बोलूं हुंह</para>
  <para style="q" vid="JOB 17:14">आपणीं ईज अर दाई-च़ेई।<verse eid="JOB 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 17:15" />कहा भाल़णअ कि मेरी कै आशा आसा?</para>
  <para style="q" vid="JOB 17:15">हुंह आजू किज़ै आशा डाहूं?<verse eid="JOB 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 17:16" />मेरी आशा निं मुंह संघै तेऊ संसारै डेऊई च़ाल्‍ली</para>
  <para style="q" vid="JOB 17:16">ज़ेथ मणछ मरी करै पुजा।<verse eid="JOB 17:16" /></para>
  <chapter eid="JOB 17" />
  <chapter number="18" style="c" sid="JOB 18" />
  <para style="s">बिल्दाद बोला आयूबा लै,</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 18:1" />शूही मुल्खो बिल्दाद लागअ आयूबा लै इहअ बोल्दअ,<verse eid="JOB 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 18:2" />“आयूब, ताह केभै तैणीं रहणअ इहै बोल्दै ई लागी?</para>
  <para style="q" vid="JOB 18:2">ज़ै, म्हारी गल्‍ला शुणनी ई निं, तै किज़ै लाअ हाम्हैं बोली?<verse eid="JOB 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 18:3" />तूह कै समझ़ा कि हाम्हैं</para>
  <para style="q" vid="JOB 18:3">ऐडै अर डागै ज़िहै आसा?<verse eid="JOB 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 18:4" />तूह लागअ द तेरै रोश्शा करै आप्पू ई दझ़दअ!</para>
  <para style="q" vid="JOB 18:4">तेरै रोश्शा करै कै धरती दी ज़ाज़री च़ाल्‍ली हई?</para>
  <para style="q" vid="JOB 18:4">ताह मनैऊंणा लै कै परमेशरै पर्बत ओर्ही-पोर्ही लाऐ सकैऊई?<verse eid="JOB 18:4" /></para>
  <para style="q">
    <verse number="5-6" style="v" sid="JOB 18:5-6" />कदुष्ट मणछे लाटू हिठणै पठी,</para>
  <para style="q" vid="JOB 18:5-6">तिंयां निं तेखअ भिई ज़ल़दै।</para>
  <para style="q" vid="JOB 18:5-6">तिन्‍नें डेरै हणअ नटिप्प न्हैरअ।<verse eid="JOB 18:5-6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 18:7" />तिंयां हांढा तै आज़रै,</para>
  <para style="q" vid="JOB 18:7">पर ऐबै जुंघल़णै तिंयां धरनीं,</para>
  <para style="q" vid="JOB 18:7">ज़ुंण तिंयां बिक्री सोठा तै, तिंयां बधल़णैं तेता ई करै।<verse eid="JOB 18:7" /></para>
  <para style="q">
    <verse number="8-10" style="v" sid="JOB 18:8-10" />तिन्‍नें गंईं पल़णीं ज़ज़ाल़ा प्रैंदै, अर तिंयां शाचणैं तेथ,</para>
  <para style="q" vid="JOB 18:8-10">तिन्‍नें घुंढी शाचणी खल़ाक्‍की दी पिड्डी।</para>
  <para style="q" vid="JOB 18:8-10">तिन्‍नें बाता आसा ज़ज़ाल़ अर फाही ढोही डाही दी।<verse eid="JOB 18:8-10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 18:11" />तिन्‍नां लै आसा फेरा-फेर डरैऊंणी च़िज़ा न्हैल़ी लागी दी,</para>
  <para style="q" vid="JOB 18:11">तिन्‍नां आसा गंईं-गंईं दी डअर-भगैर।<verse eid="JOB 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 18:12" />तिंयां थिऐ सेठ पर ऐबै च़ाल्‍लै तिंयां भुखै मरी,</para>
  <para style="q" vid="JOB 18:12">आजू आसा तिन्‍नां लै आफ़त न्हैल़ी लागी दी।<verse eid="JOB 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 18:13" />तिन्‍नें घेरी सल्‍ला नबिज़री बमारी अर</para>
  <para style="q" vid="JOB 18:13">तिन्‍नें हाथा खूरो मास्स लागा चिजदअ।<verse eid="JOB 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 18:14" />आपणैं ज़हा डेरै तिंयां राज्ज़ी-मौज़ी रहा तै,</para>
  <para style="q" vid="JOB 18:14">तेता का काढणैं तिंयां बागै अर</para>
  <para style="q" vid="JOB 18:14">तिंयां पुजणैं जम्परीए राज़ै सेटा।<verse eid="JOB 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 18:15" />पिछ़ू ज़ुंण घअर तेऊओ छ़ुटअ, सह गिम्मणअ कज़ोही,</para>
  <para style="q" vid="JOB 18:15">तिन्‍नां छ़ल़िकणी बमारी दूर करना लै तेऊए घअरै गंधक।<verse eid="JOB 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 18:16" />आप्पू हणअ सह इहै डाल़ा-बूटा ज़िहअ</para>
  <para style="q" vid="JOB 18:16">ज़सरै ज़लैल़ै गोधी का पेच़ी शुक्‍कै दै हआ अर ज़ेते शाण्हीं पठी हआ काटी दी।<verse eid="JOB 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 18:17" />खिरी निं तिन्‍नों नशाण बी रहंदअ,</para>
  <para style="q" vid="JOB 18:17">तिन्‍नां निं तेखअ कोहै आद करदअ।<verse eid="JOB 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 18:18" />ज़ेऊ देशै तिंयां बस्सै दै आसा तिधा का काढणैं तिंयां</para>
  <para style="q" vid="JOB 18:18">घिशी करै पोर्ही प्रैश्शै का न्हैरै बाखा लै।<verse eid="JOB 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 18:19" />तिन्‍नें निं आजू आद-लुआद बी रहणीं</para>
  <para style="q" vid="JOB 18:19">अर नां तिन्‍नें नाअं बोली आजू कुंण रहणअ।<verse eid="JOB 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 18:20" />पुर्बा ओर्ही पछ़मा तैणीं छ़ुटणअ सोभी लोगा</para>
  <para style="q" vid="JOB 18:20">तिन्‍नें बारै शूणीं डरै दर्छ़णअ।<verse eid="JOB 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 18:21" />पापी मणछा अर तिन्‍नें टांडै-टबर</para>
  <para style="q" vid="JOB 18:21">ज़ुंण परमेशरे परबाह निं करदै</para>
  <para style="q" vid="JOB 18:21">तिन्‍नां भेटा खिरी इहअ ई फल।”<verse eid="JOB 18:21" /></para>
  <chapter eid="JOB 18" />
  <chapter number="19" style="c" sid="JOB 19" />
  <para style="s1">आयूबै दैनअ बिल्दादा लै ज़बाब</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 19:1" />आयूबै बोलअ इहअ,<verse eid="JOB 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 19:2" />तम्हां कधू तैणीं रहणअ आपणीं गल्‍ला करै</para>
  <para style="q" vid="JOB 19:2">मुंह दुखी करदै अर हंतदै लागी?<verse eid="JOB 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 19:3" />हर गल्‍ला लै मेरी बेइज़ती करी तम्हैं अज़ी बी रज्ज़ै निं?</para>
  <para style="q" vid="JOB 19:3">तम्हां आप्पू शरम निं एछदी कि</para>
  <para style="q" vid="JOB 19:3">तम्हैं मुंह दाहुऐ दै मणछा संघै किहअ बभार करा!<verse eid="JOB 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 19:4" />ज़ै मंऐं पाप बी किअ होए,</para>
  <para style="q" vid="JOB 19:4">तेते बी निं तम्हां किछ़ै फाही पल़ी आथी।<verse eid="JOB 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 19:5" />तम्हैं सोठा इहअ कि तम्हैं आसा मुखा भलै,</para>
  <para style="q" vid="JOB 19:5">मुल्है खोज़ा तम्हैं एही सलाह कि</para>
  <para style="q" vid="JOB 19:5">मंऐं किअ पाप तैही पल़ी मुल्है ईंयां आफ़ता!<verse eid="JOB 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 19:6" />थारी आछी का शुझदअ निं आथी कि एता करनै आल़अ आसा परमेशर आप्पै?</para>
  <para style="q" vid="JOB 19:6">मुंह ढाकणा लै आसा तेऊ आप्पै शकारीओ ज़ज़ाल़ डाहअ द छ़ैई।<verse eid="JOB 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 19:7" />मंऐं मांगी लेर-पकार पाई मज़त,</para>
  <para style="q" vid="JOB 19:7">पर मेरी निं कोही शूणीं!</para>
  <para style="q" vid="JOB 19:7">हुंह रहअ बोल्दअ लागी कि मुंह संघै लागअ उपद्रभ हंदअ</para>
  <para style="q" vid="JOB 19:7">पर मुंह निं नसाफ भेटअ आथी।<verse eid="JOB 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 19:8" />परमेशरै डाहै मुल्है सोभै दुआर बुदरी, हुंह निं बागै निखल़ी सकदअ,</para>
  <para style="q" vid="JOB 19:8">तेऊ डाह मुल्है न्हैरअ करी अर मुखा निस्सी आजू बात शुझुई।<verse eid="JOB 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 19:9" />तेऊ किई मेरी शोभा-शान</para>
  <para style="q" vid="JOB 19:9">अर ज़ैदात मुखा दूर।<verse eid="JOB 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 19:10" />तेऊ किअ हुंह फेरा-फेर बरैबाद,</para>
  <para style="q" vid="JOB 19:10">तेऊ किई मेरी आशा ढूल़ै दै बूटा ज़ेही</para>
  <para style="q" vid="JOB 19:10">गोधी का पेच़ी खतम ताकि हुंह शुक्‍के अर मरे।<verse eid="JOB 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 19:11" />परमेशर आसा मुल्है रोश्शै लाल-पिंऊंल़अ हुअ द,</para>
  <para style="q" vid="JOB 19:11">तेऊ किअ मुंह संघै आपणैं ज़ानीं दुशमणा ज़िहअ बभार।<verse eid="JOB 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 19:12" />तेऊए सैना आसा मेरै डेरै फेर,</para>
  <para style="q" vid="JOB 19:12">तिन्‍नैं आसा हुंह गोटी डाहअ द।<verse eid="JOB 19:12" /></para>
  <para style="s">हुंह हेरअ सोभी बिस्सरी</para>
  <para style="q">
    <verse number="13-14" style="v" sid="JOB 19:13-14" />परमेशरै किअ इहअ कि मेरै भाई-बंधै बी डाहअ हुंह कल्ही शोटी,</para>
  <para style="q" vid="JOB 19:13-14">मेरै ज़ाणूं बछ़ैणूं बी फिरै मुल्है ऐबै पाखलै,</para>
  <para style="q" vid="JOB 19:13-14">नातै-रिश्तैदार बी निस्सै ऐबै मुंह नेल़ एछी।<verse eid="JOB 19:13-14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 19:15" />ज़ुंण मेरै घअरै प्राहुंणैं बी एछा तै, तिंयां बी बिस्सरुऐ मुंह पठी,</para>
  <para style="q" vid="JOB 19:15">मेरै दास-दासी फिरा मुल्है पाखलै ज़िहअ कि हुंह आसा कुंण परदेसी।<verse eid="JOB 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 19:16" />मेरअ दास निं मेरी हाक्‍का बी शुणदअ,</para>
  <para style="q" vid="JOB 19:16">मुंह एछा ज़ीबाण करी अंतै, तज़ी बी निं सह मुंह सेटा एछदअ!<verse eid="JOB 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 19:17" />मेरी बेटल़ी फिरा मेरै शाहे बास्सा का च़िल़्ह,</para>
  <para style="q" vid="JOB 19:17">मेरै टबर अर सक्‍कै भाई मांझ़ै बी निं</para>
  <para style="q" vid="JOB 19:17">मुंह नेल़ कोहै एछदअ, तिन्‍नां बी लागा मुखा च़िल़्ह।<verse eid="JOB 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 19:18" />लान्हैं-सुन्हैं बी रहा मुखा दूर,</para>
  <para style="q" vid="JOB 19:18">ज़ै तिंयां मुंह नेल़ एछा बी, तेभै लागा तिंयां मुंह भाल़ी</para>
  <para style="q" vid="JOB 19:18">मुल्है हास्सदै अर मेरै सुहांगा करदै।<verse eid="JOB 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 19:19" />मेरै सोभी का खास साथी बी हुई मुखा नफरत,</para>
  <para style="q" vid="JOB 19:19">ज़हा लै हुंह खास्सअ झ़ूरा त, तिंयां बी हुऐ आझ़ मेरै बरोधी।<verse eid="JOB 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 19:20" />मेरी खाल बी शाची हाडकै दी ल़पट्ट, हुंह हुअ च़ार काठ शुक्‍कअ अर</para>
  <para style="q" vid="JOB 19:20">हुंह आसा बडी मस्सा ज़िऊंदअ लागअ द।<verse eid="JOB 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 19:21" />तम्हैं आसा मेरै खास साथी, धख ता करा मुल्है झींण आरो!</para>
  <para style="q" vid="JOB 19:21">परमेशरै डाहअ हुंह आपणैं हाथै मरदअ पाई।<verse eid="JOB 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 19:22" />ज़िहअ मुल्है परमेशरै किअ, तिहै किल्है आसा तम्हैं बी मुंह हंतदै लागै दै?</para>
  <para style="q" vid="JOB 19:22">अज़ी बी थारै रज्ज़ुअ निं आथी?<verse eid="JOB 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 19:23" />हुंह च़ाहा त इहअ कि कुंण मेरी गल्‍ला बही दी लिखी डाहंदै अर</para>
  <para style="q" vid="JOB 19:23">मेरी इना गल्‍ला आद डाहंदै!<verse eid="JOB 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 19:24" />कि मेरी इना गल्‍ला छ़िणीं करै किधी टोल्हा दी डाहंदै लिखी</para>
  <para style="q" vid="JOB 19:24">ताकि तेथ तिंयां सदा लै रहंदी।<verse eid="JOB 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 19:25" />पर एतरअ आसा मुखा बी थोघ कि ज़िऊंदअ परमेशर ज़ुंण स्वर्गै आसा,</para>
  <para style="q" vid="JOB 19:25">सह जाणअ खिरी मुंह बच़ाऊंदअ उंधै धरती लै एछी।<verse eid="JOB 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 19:26" />च़ाऐ मेरी सारी देही बी चिजे-शल़े,</para>
  <para style="q" vid="JOB 19:26">तज़ी बी लणैं मुंह ऐहा देही दी बिधाते दर्शण करी।<verse eid="JOB 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 19:27" />मुंह भाल़णअ सह आप्पै आपणीं आछी,</para>
  <para style="q" vid="JOB 19:27">हुंह आसा तैहा घल़ी न्हैल़अ-भाल़अ लागअ द।<verse eid="JOB 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 19:28" />“मेरै साथीओ, तम्हैं, सोठा इहअ कि</para>
  <para style="q" vid="JOB 19:28">एऊ का हाम्हां किहअ करै ज़ितणअ? तैही काढा तम्हैं</para>
  <para style="q" vid="JOB 19:28">मुंह दी खोट कि मुल्है अह आफ़त पल़णीं आसा मेरअ ई कशूर!<verse eid="JOB 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 19:29" />पर तम्हां लै बोला हुंह इहअ कि तैहा तलबारा का डरा,</para>
  <para style="q" vid="JOB 19:29">ज़ुंण हेरा-हेरी पापी लै सज़ा दैआ,</para>
  <para style="q" vid="JOB 19:29">तेखअ लागणअ तम्हां का थोघ कि नसाफ किहअ हआ।”<verse eid="JOB 19:29" /></para>
  <chapter eid="JOB 19" />
  <chapter number="20" style="c" sid="JOB 20" />
  <para style="s1">तेरी गल्‍ला का हुई मुंह नफरत</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 20:1" />नमाती मुल्खो सोपर लागअ आयूबा लै इहअ बोल्दअ,<verse eid="JOB 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 20:2" />तेरी गल्‍ला ठैऊऐ मुल्है शूल़,</para>
  <para style="q" vid="JOB 20:2">ऐबै निस्सअ मेरै ताल्है बोल़णैं बाझ़ी रहूई।<verse eid="JOB 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 20:3" />तंऐं शोट्टअ हुंह आपणीं गल्‍ला करै बेइज़त करी,</para>
  <para style="q" vid="JOB 20:3">पर मुखा आ तेरी गल्‍लो ज़बाब आसा।<verse eid="JOB 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 20:4" />ताखा एतरअ, हणअ थोघ कि पैहलकै जुगै ज़धू</para>
  <para style="q" vid="JOB 20:4">मणछ धरती दी बस्सै, तधू तिन्‍नां लै किज़ै बधान आसा त?<verse eid="JOB 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 20:5" />कि कदुष्ट अर पापी मणछे</para>
  <para style="q" vid="JOB 20:5">खुशी हआ थोल़ी घल़ीए।<verse eid="JOB 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 20:6" />हई सका कि तिंयां खास्सै बलबान अर स्वर्गै तैणीं मशूर होए,</para>
  <para style="q" vid="JOB 20:6">तिंयां इहै महान होए कि तिंयां आपणीं बाहा करै उझै बादल़ बी छ़ुंए,<verse eid="JOB 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 20:7" />पर तिंयां फर्लाऊंणैं धूल़ै माट्टै ज़िहै दूर।</para>
  <para style="q" vid="JOB 20:7">तिन्‍नें ज़ाणूं-बछ़ैणूं लागणै तिन्‍नां लोल़ै कि</para>
  <para style="q" vid="JOB 20:7">तिंयां केस्सी पेठै!<verse eid="JOB 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 20:8" />तिंयां लुक्‍कणै राची भाल़ै दै सुपनै ज़िहै,</para>
  <para style="q" vid="JOB 20:8">अर तेखअ निं तिंयां भिई शुझणैं।<verse eid="JOB 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 20:9" />कदुष्ट मणछ ज़िधी बस्सै दै हआ तिंयां हणैं तिधा का खतम,</para>
  <para style="q" vid="JOB 20:9">तिधी निं तिंयां तेखअ कोही का भिई शुझणैं।<verse eid="JOB 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 20:10" />आपणीं ज़िन्दगी ज़ुंण तिन्‍नैं लुटअ-घशिट्टअ द आसा,</para>
  <para style="q" vid="JOB 20:10">सह लागणअ तिन्‍नां बाद तिन्‍नें आजू लुआदा</para>
  <para style="q" vid="JOB 20:10">तिन्‍नां लै बापस दैणअ फरेऊई ज़हा रैनै-गरीबा का सह लुटअ द आसा।<verse eid="JOB 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 20:11" />कदुष्ट जाणैं खारकी अमरा मरी।<verse eid="JOB 20:11" /></para>
  <para style="s">पापी झ़ूरा पाप करना लै</para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 20:12" />कदुष्ट मणछा लागा पाप करने मिठ,</para>
  <para style="q" vid="JOB 20:12">तिंयां डाहा तेता किज़ू च़िज़ा ज़िहअ ज़िभा हेठै ताकि तिन्‍नां सुआद लागी रहे,<verse eid="JOB 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 20:13" />तेखअ रहा सुलै-सुलै तेते रसा घुटदै लागी।<verse eid="JOB 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 20:14" />पर तिन्‍नैं खाई दी रोटी फिरनी तिन्‍नें पेटै</para>
  <para style="q" vid="JOB 20:14">शपैल़े बिशा ज़िहअ झ़रील्‍लअ।<verse eid="JOB 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 20:15" />ज़ुंण धन-माया तिन्‍नैं लुटी-घशिट्टी घुटी,</para>
  <para style="q" vid="JOB 20:15">सह लागणीं तिन्‍नां पोर्ही हुकरनी</para>
  <para style="q" vid="JOB 20:15">परमेशरा काढणीं सह तिन्‍नें पेटा का बी गुंठी पाई उझै बापस।<verse eid="JOB 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 20:16" />कदुष्ट मणछा लै हआ ईंयां शपैल़े बिशा झुटणैं ज़ेही,</para>
  <para style="q" vid="JOB 20:16">एता करै हआ तिन्‍नें एही मौत ज़िहअ कुंण झ़रीली दानुईंए चटाक बाहणैं करै मरा।<verse eid="JOB 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 20:17" />तिंयां निं तेऊ रज़दै-पज़दै देशै बस्सणा लै साझ़ू हई सकदै ज़ेथ</para>
  <para style="q" vid="JOB 20:17">जैतूनो तेल अर दुधा-मखीरे गाडा बगा।<verse eid="JOB 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 20:18" />ज़ेता लै तिन्‍नैं खास्सी मैन्थ किई, सह लागणीं तिन्‍नां छ़ाडणीं,</para>
  <para style="q" vid="JOB 20:18">तिन्‍नां निं तेता खाणैं ज़िऊंणेंओ सुख भेटणअ।<verse eid="JOB 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 20:19" />किल्हैकि तिन्‍नैं सह आसा तिन्‍नैं रैनै-गरीबा ठगी करै लुटअ द,</para>
  <para style="q" vid="JOB 20:19">तिन्‍नैं गिम्मै तिंयां घअर ज़ुंण होरी आप्पू लै बणाऐं तै।<verse eid="JOB 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 20:20" />तिन्‍नां हआ मांण कि सोभै गल्‍ला लोल़ी तिन्‍नां ई भेटी</para>
  <para style="q" vid="JOB 20:20">अर तिंयां निं कधि रज़दै।<verse eid="JOB 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 20:21" />ज़ेभै तैणीं तिंयां पठी लुटी निं मुक्‍कै,</para>
  <para style="q" vid="JOB 20:21">तेभै तैणीं निं तिंयां पिछ़ू हटदै,</para>
  <para style="q" vid="JOB 20:21">तैही निं तिंयां बी खिरी किछ़ू गल्‍ला लै सफल हंदै।<verse eid="JOB 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 20:22" />खास्सै सेठ हई बी पल़ा खिरी तिन्‍नां लै आफ़त,</para>
  <para style="q" vid="JOB 20:22">तिन्‍नां लागा रैनै-गरीबे कार-च़ुंआर</para>
  <para style="q" vid="JOB 20:22">संघा हआ तिंयां पठी बरैबाद।<verse eid="JOB 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 20:23" />परमेशर दैआ तिन्‍नां ज़िहअ तिंयां च़ाहा तिहअ खाणैं अर</para>
  <para style="q" vid="JOB 20:23">खिरी काढा सह सारअ रोश्श तिन्‍नां ई प्रैंदै संघा हआ तिंयां खतम।<verse eid="JOB 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 20:24" />ज़ेतरी तिंयां लोहे तलबारा का बच़णा लै ठुर्हा,</para>
  <para style="q" vid="JOB 20:24">तेतरी हेरनै तिंयां कांस्से कबाणा का निखल़ै दै कतीरा करै मारी।<verse eid="JOB 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 20:25" />तिंयां कतीर निखल़णैं तिन्‍नें पिठी लागी पेटा आजू बागै,</para>
  <para style="q" vid="JOB 20:25">कतीरे तिछी च़ुंज़ी करै हणीं तिन्‍नें काकल़ी-बुक्‍की छिझी,</para>
  <para style="q" vid="JOB 20:25">तिन्‍नां हणीं भितरी मरने डअर पल़ी दी।<verse eid="JOB 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 20:26" />ज़ुंण बी खज़ानै तिन्‍नैं झाल़ी हणैं डाहै दै,</para>
  <para style="q" vid="JOB 20:26">तिंयां हणैं बरैबाद,</para>
  <para style="q" vid="JOB 20:26">परमेशरा छ़ाडणीं तिन्‍नां लै एही आग कि</para>
  <para style="q" vid="JOB 20:26">तिंयां हणैं आपणैं डेरै अर</para>
  <para style="q" vid="JOB 20:26">सारी धन-माया संघी खतम।<verse eid="JOB 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 20:27" />भ्रमंडै हणअ तिन्‍नों पाप प्रगट अर</para>
  <para style="q" vid="JOB 20:27">धरती हणीं तिन्‍नें कदुष्ट कामें शाजत।<verse eid="JOB 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 20:28" />परमेशरो रोश्श हणअ तिन्‍नां लै एही गाडा ज़िहअ</para>
  <para style="q" vid="JOB 20:28">ज़ेता तिन्‍नें घअर अर सारी ज़ैदात पठी पाणीं घर्होहल़ी।<verse eid="JOB 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 20:29" />कदुष्ट मणछा भेटणअ खिरी अह ई फल,</para>
  <para style="q" vid="JOB 20:29">परमेशरै आसा खिरी तिन्‍नें हेस्सै इहअ ई डाहअ द।<note caller="-" style="x"><char style="xo" closed="false">20:29 </char><char style="xt" closed="false"><ref loc="JOB 27:13">आयू. 27:13</ref></char></note><verse eid="JOB 20:29" /></para>
  <chapter eid="JOB 20" />
  <chapter number="21" style="c" sid="JOB 21" />
  <para style="s">आयूबो सोपरा लै ज़बाब</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 21:1" />आयूबै बोलअ इहअ,<verse eid="JOB 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 21:2" />“मेरी गल्‍ला शूणां धैन दैई,</para>
  <para style="q" vid="JOB 21:2">हुंह च़ाहा तम्हां बाखा एही ई झेठ।<verse eid="JOB 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 21:3" />धख लआ तम्हैं मेरी गल्‍ला पोर्ही शूणीं,</para>
  <para style="q" vid="JOB 21:3">ज़ांऊं हुंह गल्‍ला करी मुक्‍के,</para>
  <para style="q" vid="JOB 21:3">तेखअ रहै च़ाऐ तम्हैं मेरै सुहांगा लागी।<verse eid="JOB 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 21:4" />हुंह निं मणछा संघै हठल़दअ आथी लागअ द,</para>
  <para style="q" vid="JOB 21:4">मेरी हठ आसा परमेशरा संघै, तैही आसा मुंह भितरा का बुआल़ लागै दै।<verse eid="JOB 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 21:5" />मुंह बाखा दैआ भाल़णीं। एतरअ तम्हां लै थोल़अ आसा कि</para>
  <para style="q" vid="JOB 21:5">तम्हैं झशकिए अर दांदा हेठै गुंठी पाई च़ुप्पी रहे?<verse eid="JOB 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 21:6" />आप्पू लै एऊ दाह-दुखे बारै सोठी फिरा मुंह हैल़अ,</para>
  <para style="q" vid="JOB 21:6">अर मुंह छ़ुटा सारी घेरी काम्मणीं।<verse eid="JOB 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 21:7" />परमेशर किल्है दैआ कदुष्ट मणछा राज्ज़ी-मौज़ी ज़िऊंणै?</para>
  <para style="q" vid="JOB 21:7">तिंयां हआ खास्सै प्रोढै तज़ी बी रहा हेरे तिन्‍नें धन-माया होर बी खास्सी हंदी लागी!<verse eid="JOB 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 21:8" />तिन्‍नें हआ शोहरू-माठै अर दादू-पोचू अर</para>
  <para style="q" vid="JOB 21:8">तिंयां रहा तिन्‍नां बडै हंदै भाल़णा लै ज़िऊंदै!<verse eid="JOB 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 21:9" />तिन्‍नें घअरै निं किछ़ै आफ़त पल़दी अर</para>
  <para style="q" vid="JOB 21:9">नां तिन्‍नां किज़ै हैल़अ फिकर हंदअ।<verse eid="JOB 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 21:10" />ज़ेभै बी तिन्‍नें बल्द गाऊई सेटा डेओआ, तिंयां जाआ झ़ट च़ारै गाभणीं हई,</para>
  <para style="q" vid="JOB 21:10">नां तिन्‍नां लै कधू इहअ हंदअ कि तिन्‍नें गाऊई चूई होए।<verse eid="JOB 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 21:11" />तिन्‍नें लान्हैं-सुन्हैं रहा बागै नाच़दै-खेल्हदै अर</para>
  <para style="q" vid="JOB 21:11">होछ़ै छ़ेल्हू ज़िहै त्रुपल़ै दैंदै लागी।<verse eid="JOB 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 21:12" />तिंयां रहा डफली, बींन अर बशूरी बाज़ी</para>
  <para style="q" vid="JOB 21:12">गिहा बोल्दी नाच़दै अर खुशी।<verse eid="JOB 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 21:13" />तिंयां रहा आपणीं ज़िन्दगी राज्ज़ी-मौज़ी,</para>
  <para style="q" vid="JOB 21:13">तिन्‍नां निं मरनै का आजी बी किछ़ै दाह-खीज़ हंदी।<verse eid="JOB 21:13" /></para>
  <para style="s">हाम्हां दैआ कांगनरांगै रहणैं</para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 21:14" />कदुष्ट मणछ बोला परमेशरा लै तोही इहअ कि</para>
  <para style="q" vid="JOB 21:14">तूह रहअ हाम्हां का दूर ई!</para>
  <para style="q" vid="JOB 21:14">हाम्हां निं एता का मतलब आथी कि तूह किज़ै च़ाहा</para>
  <para style="q" vid="JOB 21:14">अर हाम्हां केऊ साबै च़ाहा कि हाम्हैं आपणीं ज़िन्दगी ज़िऊए।<verse eid="JOB 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 21:15" />तिंयां सोठा इहअ कि तेऊ महान परमेशरे नां च़ाकरी करने ज़रुरत आथी अर</para>
  <para style="q" vid="JOB 21:15">नां तेऊ सेटा अरज़ करी किज़ै भेटी च़ाल्‍लअ।<verse eid="JOB 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 21:16" />तिंयां बोला इहअ कि हाम्हैं हणैं आपणैं बलबुतै सफल,</para>
  <para style="q" vid="JOB 21:16">पर ज़ेऊ साबै तिंयां सोठा</para>
  <para style="q" vid="JOB 21:16">तैहा गल्‍ला निं हुंह मंदअ ई आथी।<verse eid="JOB 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 21:17" />तम्हैं कधू इहअ भाल़अ बी कि कदुष्ट गअ खारकी अमरा मरी?</para>
  <para style="q" vid="JOB 21:17">तिन्‍नां मांझ़ै कहा एकी बी पल़ी कधू आफ़त?</para>
  <para style="q" vid="JOB 21:17">तिन्‍नां लै परमेशरे कधू रोश्शै सज़ा दैनी होए? इहअ निं कधि हुअ।<verse eid="JOB 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 21:18" />कि तम्हैं कधू इहअ भाल़अ कि तिंयां फर्ल़ाऊऐ इहै दूर</para>
  <para style="q" vid="JOB 21:18">ज़ेही बागरी भुखलै अर कुर्लू बागरी</para>
  <para style="q" vid="JOB 21:18">धूल़अ-माट्टअ च़की दूर फर्ल़ाऊआ? इहअ बी निं कधि भाल़अ।<verse eid="JOB 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 21:19" />तम्हैं बोला इहअ कि शोहरू बी पल़ा आपणैं ईजा-बाबे सज़ा भुगतणी।</para>
  <para style="q" vid="JOB 21:19">इहअ किल्है लोल़ी हुअ? हुंह, बोला इहअ कि</para>
  <para style="q" vid="JOB 21:19">ज़ुंणी पाप किअ परमेशरै लोल़ी सज़ा बी तिन्‍नां ई लै दैनी,</para>
  <para style="q" vid="JOB 21:19">तै लागणअ तिन्‍नां का थोघ कि तिन्‍नैं किअ पाप अर</para>
  <para style="q" vid="JOB 21:19">तेथ पिछ़ू भेटी तिन्‍नां सह सज़ा।<verse eid="JOB 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 21:20" />तिन्‍नां लोल़ी तिन्‍नें पापे सज़ा आप्पै पल़ी भुगतणी,</para>
  <para style="q" vid="JOB 21:20">तिन्‍नां का बी लोल़ी ज़ाण्हुंअ कि तेऊ परमेशरो कोप किहअ आसा</para>
  <para style="q" vid="JOB 21:20">ज़हा का सारअ बल आसा।<verse eid="JOB 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 21:21" />ज़ै मणछ मरी गअ, तेखअ निं तेऊ इहअ किछ़ै फिकर हंदअ कि</para>
  <para style="q" vid="JOB 21:21">पिछ़ू तेऊए बेटल़ी-माठै राज्ज़ी-मौज़ी आसा कि नांईं।<verse eid="JOB 21:21" /></para>
  <para style="s">शूआ का शल़ोक निं खोज़णैं</para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 21:22" />इहअ कुंण आसा ज़ुंण तेऊ परमेशरा लै शिक्षा दैए</para>
  <para style="q" vid="JOB 21:22">ज़ुंण देशा-देशे बडै-बडै राज़ैओ बी नसाफ करा।<verse eid="JOB 21:22" /></para>
  <para style="q">
    <verse number="23-24" style="v" sid="JOB 21:23-24" />कई रहा मरने धैल़ी तैणीं ताज़ै-नरोगै,</para>
  <para style="q" vid="JOB 21:23-24">तिन्‍नां भेटा मौत बी खुशी-खुशी,</para>
  <para style="q" vid="JOB 21:23-24">तिन्‍नें देही दी हआ खिरी तैणीं भरपूर तागत।<verse eid="JOB 21:23-24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 21:25" />कई मणछा हआ सारी ज़िन्दगी दुख ई दुख,</para>
  <para style="q" vid="JOB 21:25">मरदी बारी बी हआ तिन्‍नां लै दुखे गांठल़ी संघा।<verse eid="JOB 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 21:26" />पर खिरी डेओआ सोभै माट्टै ई जैंदरी,</para>
  <para style="q" vid="JOB 21:26">मरी करै पल़ा तिन्‍नां दुहीए देही दी किल़ै।<verse eid="JOB 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 21:27" />मेरै साथीओ, मुखा आसा थोघ कि तम्हैं किज़ै सोठा,</para>
  <para style="q" vid="JOB 21:27">मुंह हारना लै थारी बिक्री बी हेरा हुंह ज़ाणीं।<verse eid="JOB 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 21:28" />तम्हैं बोला इहअ,</para>
  <para style="q" vid="JOB 21:28">‘तेऊ मशूर मणछो घअर ऐबै किधी आसा?</para>
  <para style="q" vid="JOB 21:28">ज़ुंण बेघै कदुष्ट अर बूरअ आसा त?’<verse eid="JOB 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 21:29" />पर लआ आप्पू फेर होरी का पुछ़ी,</para>
  <para style="q" vid="JOB 21:29">तिन्‍नां हेरनी तम्हां का खोज़ी कि असली गल्‍ल किज़ै आसा।<verse eid="JOB 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 21:30" />तिन्‍नां भाल़ी जाणअ तम्हां का शुझुई कि</para>
  <para style="q" vid="JOB 21:30">ज़ेभै परमेशर रोश्शै सज़ा दैआ, तेता का निखल़ा कदुष्ट मणछ शुक्‍कअ बच़ी,</para>
  <para style="q" vid="JOB 21:30">सह हआ माहा प्रल़ये धैल़ी लै बच़ाऊई डाहअ द।<verse eid="JOB 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 21:31" />कदुष्ट मणछे मुंहैं निं कोहै बोल्दअ कि तूह आसा बूरअ,</para>
  <para style="q" vid="JOB 21:31">ज़ुंण तिन्‍नैं ज़ुल्म किअ, तेतो बी निं तिन्‍नां का कोहै बदल़अ लंदअ।<verse eid="JOB 21:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 21:32" />मरी करै हआ तिन्‍नें ल्हासो बी बडअ अदर अर</para>
  <para style="q" vid="JOB 21:32">मल्थाना लै निंदा बारी बी हआ तिन्‍नें शान,<verse eid="JOB 21:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 21:33" />हज़ारो मणछ डेओआ तिन्‍नें ल्हासा आजू पिछ़ू मल्थाना तैणीं,</para>
  <para style="q" vid="JOB 21:33">धरती बी करा आपणैं घअरै तिन्‍नों सुआगत!<verse eid="JOB 21:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 21:34" />तम्हैं आसा बृथा गल्‍ला करी मुंह झेठू लागै दै!</para>
  <para style="q" vid="JOB 21:34">तम्हैं निं एक बी ज़बाब शुचअ दैनअ!”<verse eid="JOB 21:34" /></para>
  <chapter eid="JOB 21" />
  <chapter number="22" style="c" sid="JOB 22" />
  <para style="s">एलीपज लागअ चिऊथी बारी बोल्दअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 22:1" />तेमानी नगरीओ एलीपज लागा इहअ बोल्दअ,<verse eid="JOB 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 22:2" />“कुंण मणछ कै परमेशरे किज़ै मज़त करी सका?</para>
  <para style="q" vid="JOB 22:2">एतरअ कुंण अक्ली आल़अ मणछ आसा ज़ुंण परमेशरा लै सका सलाह दैई?<verse eid="JOB 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 22:3" />तेरै धर्मीं हणैं करै परमेशरा किज़ै फाईदअ भेटा?</para>
  <para style="q" vid="JOB 22:3">तेरै भलै हणैं करै परमेशरा किज़ै आसरअ भेटा?<verse eid="JOB 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 22:4" />तेरै धर्मीं कामां लै सह ताह किल्है नैरा?</para>
  <para style="q" vid="JOB 22:4">तूह कै सोठा, परमेशर कै ताल्है एते तैणीं दैआ सज़ा कि</para>
  <para style="q" vid="JOB 22:4">तूह आसा तेऊओ शुचअ-पाक्‍कअ दास? इहअ निं हई ई सकदअ।<verse eid="JOB 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 22:5" />ताल्है सज़ा भेटी तै कि तंऐं किअ बतेर्हअ पाप,</para>
  <para style="q" vid="JOB 22:5">तंऐं निं बूरअ करी कसर डाही।<verse eid="JOB 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 22:6" />हई सका कि ज़ांऊं तेरै भाई-बंध ताखा निंयं द ऋण भरी निं सकै,</para>
  <para style="q" vid="JOB 22:6">तंऐं निं तिन्‍नों बांधअ बापस दैनअ अर</para>
  <para style="q" vid="JOB 22:6">तंऐं बझ़ैल़ै तेता पिछ़ू तिन्‍नें घेरीए झिकल़ै बी पोर्ही खोल्हणैं, संघा डाहै तिंयां नांगै शोटी।<verse eid="JOB 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 22:7" />मेरै खैलै निं तंऐं कधू भुखै लै रोटी अर</para>
  <para style="q" vid="JOB 22:7">नचिशै लै पाणीं पणैऊंअं आथी!<verse eid="JOB 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 22:8" />तंऐं किई आप्पू ज़िहै सेठा लै</para>
  <para style="q" vid="JOB 22:8">रैनै-गरीबे ज़िम्मीं-ज़ैगा गिम्मणा लै मज़त।<verse eid="JOB 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 22:9" />तंऐं डाही बिधबा बेटल़ीए मज़त करना लै पिठ फरेऊई,</para>
  <para style="q" vid="JOB 22:9">तंऐं लुटै हणैं छ़ुटै-मुक्‍कै दै लान्हैं।<verse eid="JOB 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 22:10" />तेही पल़ी ऐबै ताल्है फेरा-फेर आफ़त अर</para>
  <para style="q" vid="JOB 22:10">ऐबै पल़ी नच़ानक तेरै दिलै डअर।<verse eid="JOB 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 22:11" />तैही निस्सअ तेरै ऐबै न्हैरै शुझुई,</para>
  <para style="q" vid="JOB 22:11">तेऊ हर्हला दी गअ तूह गल़ै तैणीं डुबी।<verse eid="JOB 22:11" /></para>
  <para style="s">परमेशर कै स्वर्गा का हाम्हां भाल़ी हेरा?</para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 22:12" />परमेशर रहा स्वर्गै सोभी का उछ़टै दी,</para>
  <para style="q" vid="JOB 22:12">सरगे तारै दै भाल़णीं कि किधी तैणीं आसा,</para>
  <para style="q" vid="JOB 22:12">सह आसा तेता का बी उझै।<verse eid="JOB 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 22:13" />तज़ी बी बोला तूह इहअ, ‘परमेशरा का किज़ै थोघ आसा?</para>
  <para style="q" vid="JOB 22:13">सह आसा घणैं बादल़ा पिछ़ू लुक्‍कअ द, तेऊ किहअ करै लाअ म्हारअ नसाफ करी?’<verse eid="JOB 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 22:14" />तूह कै सोठा कि सह घणैं बादल़ा बाती</para>
  <para style="q" vid="JOB 22:14">कै सह भाल़ी निं सकदअ?</para>
  <para style="q" vid="JOB 22:14">सह कै उझै भ्रमंडै रहा सिधअ हांढदअ लागी?<verse eid="JOB 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 22:15" />तूह अज़ी बी तेही ज़िन्दगी ज़िऊंदअ आसा लागअ द,</para>
  <para style="q" vid="JOB 22:15">ज़ेऊ साबै पराणैं ज़मानें कदुष्ट मणछ ज़िऊआ तै?<verse eid="JOB 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 22:16" />तिंयां गऐ तै तिन्‍नों बगत एछणैं का आजी</para>
  <para style="q" vid="JOB 22:16">नच़ानक खारकी अमरा मरी!<verse eid="JOB 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 22:17" />ईंयां तै तिंयां मणछ ज़ुंण परमेशरा लै इहअ बोला तै,</para>
  <para style="q" vid="JOB 22:17">‘तूह रह हाम्हां का दूर ई! हाम्हां किज़ै च़ाल्‍लअ ताखा भेटी?’<verse eid="JOB 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 22:18" />पर तज़ी बी दैनी परमेशरै तिन्‍नें घअरा लै बर्गत।</para>
  <para style="q" vid="JOB 22:18">तिन्‍नां कदुष्ट मणछे सोठ समझ़णीं आसा मेरै बशा का बागै।<verse eid="JOB 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 22:19" />कदुष्टे बरैबादी भाल़ी हणैं धर्मीं मणछ खुश,</para>
  <para style="q" vid="JOB 22:19">नर्दोश मणछ लागणै तिन्‍नां लै इहअ बोली हास्सदै,<verse eid="JOB 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 22:20" />‘भाल़ा, हाम्हां हंतणैं आल़ै हुऐ पठी बरैबाद,</para>
  <para style="q" vid="JOB 22:20">तिन्‍नें हुई सोभै गल्‍ला आगी जैंदरी दझ़ी खतम।’<verse eid="JOB 22:20" /></para>
  <para style="s">सोभै गल्‍ला छ़ाडणीं परमेशरा सेटा</para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 22:21" />आयूब, ऐबै लअ तूह परमेशरा सेटा मेल़-ज़ोल़ करी,</para>
  <para style="q" vid="JOB 22:21">तेऊ संघै ज़िधणे पा ऐबै छ़ाड़,</para>
  <para style="q" vid="JOB 22:21">तै हणअ तेरअ सोभी गल्‍ला लै भलअ।<verse eid="JOB 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 22:22" />तूह शुण कि परमेशर ताल्है किज़ै करना लै बोला,</para>
  <para style="q" vid="JOB 22:22">संघा डाह तिन्‍नां आपणैं दिलै आद।<verse eid="JOB 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 22:23" />बिधाता ज़हा का सारअ बल आसा, ज़ै तूह दिला का तेऊ बाखा फिरे,</para>
  <para style="q" vid="JOB 22:23">ज़ै तूह आपणैं डेरै कदुष्ट काम करनै छ़ाडे,</para>
  <para style="q" vid="JOB 22:23">तै जाणअ तूह भिई नरोगअ अर सफल हई।<verse eid="JOB 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 22:24" />आपणअ च़ोखअ सुन्‍नअ<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="fq" closed="false">च़ोखअ सुन्‍नअ </char><char style="ft" closed="false">ओपीर</char></note> च़ंदी शोट आप्पू का दूर,</para>
  <para style="q" vid="JOB 22:24">तेता डाह तूह किधी नाल़ै दाबी।<verse eid="JOB 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 22:25" />ताल्है आसा सुन्‍नैं-च़ंदीओ खज़ानअ सह परमेशर</para>
  <para style="q" vid="JOB 22:25">ज़हा का सारअ बल आसा।<verse eid="JOB 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 22:26" />तै रहणअ तूह कबल्‍लअ तेऊ परमेशरे भरोस्सै ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 22:26">तै हणअ तेरी खुशीओ मूल़ सिधअ सह ई।<verse eid="JOB 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 22:27" />तेखअ ज़ेभै बी तूह तेऊ सेटा अरज़ करे,</para>
  <para style="q" vid="JOB 22:27">तेऊ हेरनी तेरी शूणीं,</para>
  <para style="q" vid="JOB 22:27">ज़ुंण तंऐं मानत मनी, सह बी जाणीं तेरै पूरी हई।<verse eid="JOB 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 22:28" />तेखअ हणअ तूह तेरै हर कामां लै सफल अर</para>
  <para style="q" vid="JOB 22:28">तै निं तेरी ज़िन्दगी दी न्हैरअ हणअ।<verse eid="JOB 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 22:29" />परमेशर घुशा शरेरै मणछो नाक,</para>
  <para style="q" vid="JOB 22:29">अर भोल़ै मणछा डाहा सह बच़ाऊई।<verse eid="JOB 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 22:30" />ज़ै तूह भलअ करे</para>
  <para style="q" vid="JOB 22:30">अर तूह नर्दोश निखल़े,</para>
  <para style="q" vid="JOB 22:30">तै हेरनअ तेऊ तूह बी बच़ाऊई।”<verse eid="JOB 22:30" /></para>
  <chapter eid="JOB 22" />
  <chapter number="23" style="c" sid="JOB 23" />
  <para style="s">आझ़ निस्सअ मेरै बोल़णैं बाझ़ी रहूई</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 23:1" />आयूबै दैनअ एलीपजा लै इहअ ज़बाब,<verse eid="JOB 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 23:2" />“मुंह लणी अज़ी बी आझ़ परमेशरा सेटा आपणीं खरी खोज़ी,</para>
  <para style="q" vid="JOB 23:2">किल्हैकि सह फिरअ मुल्है बेघै बूरअ</para>
  <para style="q" vid="JOB 23:2">हुंह थक्‍कअ आपणीं धअक गोटी-गोटी।<verse eid="JOB 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 23:3" />ज़ै मुखा सिधअ इहअ थोघ हंदअ कि परमेशर किधी भेटणअ अर</para>
  <para style="q" vid="JOB 23:3">तै डेऊणअ त मुंह तैहा ज़ैगा लै ज़िधी बेशी सह नसाफ करा।<verse eid="JOB 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 23:4" />तै करनअ त मुंह तेऊ सेटा आपणअ दाऊअ कि हुंह आसा नर्दोश</para>
  <para style="q" vid="JOB 23:4">अर तेऊ का खोज़णीं ती मुंह पठी गल्‍ला आप्पै कि हुंह किहअ शुचअ आसा।<verse eid="JOB 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 23:5" />तेखअ मुखा बी जाणअ त थोघ लागी कि</para>
  <para style="q" vid="JOB 23:5">सह किज़ै च़ाहा अर तेऊ मुल्है किज़ै ज़बाब दैनअ।<verse eid="JOB 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 23:6" />तेऊ कै मुंह संघै हठ करना लै आपणअ सारअ ज़ोर लाअ लाई?</para>
  <para style="q" vid="JOB 23:6">मुखा आसा थोघ सह निं इहअ करदअ,</para>
  <para style="q" vid="JOB 23:6">तेऊ हेरनी ती मेरी गल्‍ला शूणीं संघा करनअ त तेऊ शुचअ नसाफ।<verse eid="JOB 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 23:7" />तेऊ सेटा पुजी सका त हुंह हठ करी</para>
  <para style="q" vid="JOB 23:7">किल्हैकि हुंह आसा मानदार,</para>
  <para style="q" vid="JOB 23:7">मेरअ नसाफ करनै आल़अ आसा सह ई तेऊ हेरनअ त हुंह नर्दोश काढी।<verse eid="JOB 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 23:8" />हुंह लागअ आजू पुर्बा बाखा अर पिछ़ू पछ़मा बाखा परमेशरा लोल़अ,</para>
  <para style="q" vid="JOB 23:8">पर मुंह निं परमेशर किधी भेटअ।<verse eid="JOB 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 23:9" />हुंह लागअ तेऊ दैहणीं-बाऊंईं बाखा सारै दी भाल़अ,</para>
  <para style="q" vid="JOB 23:9">पर मुखा निं सह किधी शुझुअ आथी।<verse eid="JOB 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 23:10" />पर तज़ी बी हआ परमेशर मुंह गंईं-गंईं हांढदै भाल़अ लागअ द,</para>
  <para style="q" vid="JOB 23:10">पर ज़ेभै सह मुंह परखे,</para>
  <para style="q" vid="JOB 23:10">हुंह निखल़णअ च़ोखै सुन्‍नैं ज़िहअ शुचअ।<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="1PE 1:7">1 पत. 1:7</ref></char></note><verse eid="JOB 23:10" /></para>
  <para style="q">
    <verse number="11-12" style="v" sid="JOB 23:11-12" />हुंह रहअ कबल्‍लअ ज़ेसी तेऊ बोलअ तैहा ई बाता हांढदअ लागी,</para>
  <para style="q" vid="JOB 23:11-12">तेता का निं हुंह ओर्ही नां पोर्ही डेऊअ।</para>
  <para style="q" vid="JOB 23:11-12">ज़िहअ तेऊ हुकम किअ, मंऐं किअ तिहअ ई,</para>
  <para style="q" vid="JOB 23:11-12">मंऐं निं कधि आपणीं मरज़ी किई अर मंऐं किअ तिहअ ई ज़िहअ सह च़ाहा त।<verse eid="JOB 23:11-12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 23:13" />ज़ुंण तेऊ सोठी हेरअ, तेता लआ सह करी ई,</para>
  <para style="q" vid="JOB 23:13">तेता का निं तेऊ कोहै रोक्‍की सकदअ अर</para>
  <para style="q" vid="JOB 23:13">नां कुंण तेऊए सोर बदल़ी सकदअ।<verse eid="JOB 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 23:14" />ज़िहअ तेऊ मुल्है आसा सोठअ द,</para>
  <para style="q" vid="JOB 23:14">सह बी लणअ तेऊ ज़ाथी तिहअ ई करी।<verse eid="JOB 23:14" /></para>
  <para style="q">
    <verse number="15-16" style="v" sid="JOB 23:15-16" />सह परमेशर ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 23:15-16">तेऊए बारै सोठी छ़ुटा मुंह डरै काम्मणीं।</para>
  <para style="q" vid="JOB 23:15-16">हुंह निं न्हैरै का डरदअ पर परमेशरा का लागा मुंह डअर।<verse eid="JOB 23:15-16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 23:17" />मुंह फेर आसा नटिप्प न्हैरअ</para>
  <para style="q" vid="JOB 23:17">पर हुंह निं तेथ तज़ी बी च़ुप्पी रहंदअ।”<verse eid="JOB 23:17" /></para>
  <chapter eid="JOB 23" />
  <chapter number="24" style="c" sid="JOB 24" />
  <para style="s">आयूबे खरी</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 24:1" />परमेशर ज़हा का सारअ बल आसा तेऊ इहअ बगत किल्है निं आथी डाहअ द खोज़ी</para>
  <para style="q" vid="JOB 24:1">ज़हा धैल़ी तेऊ आपणीं दालता दी बेशी नसाफ करनअ?</para>
  <para style="q" vid="JOB 24:1">ताकि धर्मीं मणछ बी भाल़ी सकदै कि</para>
  <para style="q" vid="JOB 24:1">पापी मणछा भेटी सज़ा।<verse eid="JOB 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 24:2" />कई लोग रहा आपणीं सिऊंआं का आजू सिक्‍की होरीए खेचा गिम्मदै</para>
  <para style="q" vid="JOB 24:2">अर होरीए हेल़्ही का डागै-चैणैं च़ोरी रहा तिंयां इहै फुआल बणी कि तिंयां आसा तिन्‍नें आपणैं!<verse eid="JOB 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 24:3" />तिंयां पाआ छ़ुटै-मुक्‍कै दै लान्हें गाधै ठगी करै आप्पू लै,</para>
  <para style="q" vid="JOB 24:3">बिधबा बेटल़ीओ बाछ़ू डाहा तिंयां आप्पू का</para>
  <para style="q" vid="JOB 24:3">ज़ांऊं तैणीं सह ऋण भरी निं मुक्‍के!<verse eid="JOB 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 24:4" />ज़ुंण गरीबो हक आसा तिंयां निं तिन्‍नां तेता बी करनै दैंदै,</para>
  <para style="q" vid="JOB 24:4">रैनै-गरीबा लागा तिन्‍नें डरै लुक्‍की रहणअ!<verse eid="JOB 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 24:5" />गरीब हुऐ बणें गाधै ज़िहै,</para>
  <para style="q" vid="JOB 24:5">ज़ुंण शुक्‍कै रेगीस्तानै आपणैं बच्च़ै लै घाह-पाचा लोल़ै रहा लागी,</para>
  <para style="q" vid="JOB 24:5">एता का सुआई निं तिंयां होर्ती किधी डेऊई सकदै!<verse eid="JOB 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 24:6" />कि लागा तिन्‍नां होरीए खेचै धरनीं छ़ुटी दी फसल</para>
  <para style="q" vid="JOB 24:6">आप्पू लै झाल़णीं कि धख खाणां लै होए!</para>
  <para style="q" vid="JOB 24:6">संघा लागा तिन्‍नां कहा सेठे दाखे बागा का दाख च़ोरी पाणीं।<verse eid="JOB 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 24:7" />हिंऊंदै धैल़ै लागा तिन्‍नां झिकल़ै बाझ़ी राच काटणी,</para>
  <para style="q" vid="JOB 24:7">किल्हैकि तिन्‍नां का निं प्रैंदै छ़ैणां लै च़ादरू तोही हंदअ।<verse eid="JOB 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 24:8" />धारा लागा इहअ भराल़ कि तिंयां हआ भिज़ी-भिज़ी छ़ल़ूह,</para>
  <para style="q" vid="JOB 24:8">नैत्तै हणां लै रहा तिंयां डुआरै बडी टोल्हे नील़ै शरण लई च़ैहनूई</para>
  <para style="q" vid="JOB 24:8">किल्हैकि तिन्‍नां का निं रहणा लै घअर ई हंदअ!<verse eid="JOB 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 24:9" />कदुष्ट मणछ दैआ गरीबा लै ऋण, ज़ै तिन्‍नें मरनै का आजी नांईं भर्हुअ,</para>
  <para style="q" vid="JOB 24:9">तेता पिछ़ू निंयां तिंयां तिन्‍नें छ़ुटै-मुक्‍कै दै च़ूई झुटदै शोहरू तोही</para>
  <para style="q" vid="JOB 24:9">माए हाथा का आपणैं गलाम बणाणां लै छ़ड़ैऊई।<verse eid="JOB 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 24:10" />गरीबा लागा ज़ोरा-ज़ोरी लोगे खेचै मारी-मारी नाज़े भरै बुल़्हणै,</para>
  <para style="q" vid="JOB 24:10">नां तिन्‍नैं घेरी झिकल़ै हंदै बान्हैं दै अर</para>
  <para style="q" vid="JOB 24:10">नां तिन्‍नैं पेटै रोटी हंदी खाई दी।<verse eid="JOB 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 24:11" />तिंयां दैआ कोफरी जैतूनो तेल काढी,</para>
  <para style="q" vid="JOB 24:11">अर दाखो रस काढी पर</para>
  <para style="q" vid="JOB 24:11">तिन्‍नां निं कुंण पाणीं बी दैंदै झुटणैं।<verse eid="JOB 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 24:12" />तिंयां रहा नगरी-नगरी दाहै धकदै अर</para>
  <para style="q" vid="JOB 24:12">लेर-पकार पाई परमेशरा का मज़त मांगदै लागी,</para>
  <para style="q" vid="JOB 24:12">पर तज़ी बी निं परमेशर तिन्‍नां बाखा धैन ई दैंदअ!<verse eid="JOB 24:12" /></para>
  <para style="s">कई आसा प्रैश्शै संघै ज़ीद</para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 24:13" />“कई आसा इहै लोग बी ज़ुंण प्रैश्शै ई निं मंदै!</para>
  <para style="q" vid="JOB 24:13">तिंयां रहा तेता छ़ाडी उंबल़ी ई बाता लागी हांढदै।<verse eid="JOB 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 24:14" />सान्ह पल़ी निं कि, तेतरी जाआ ईंयां हत्या करनै आल़ै</para>
  <para style="q" vid="JOB 24:14">रैनै-गरीबा मारदै निखल़ी,</para>
  <para style="q" vid="JOB 24:14">राची निखल़ा ईंयां ई च़ोरी करदै।<verse eid="JOB 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 24:15" />कंज़रै न्हैल़ा सिधी राच पल़दी,</para>
  <para style="q" vid="JOB 24:15">तिंयां डेओआ न्हैरै आपणअ मुंह च़ोरी</para>
  <para style="q" vid="JOB 24:15">होरीए बेटल़ी या मर्धा सेटा,</para>
  <para style="q" vid="JOB 24:15">तिंयां सोठा इहअ कि एथ निं हाम्हैं कोही लाऐ भाल़ी।<verse eid="JOB 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 24:16" />च़ोर रहा धैल़ी पांडा भितरी सुत्ती,</para>
  <para style="q" vid="JOB 24:16">तिन्‍नैं निं कधू धैल़ी धुप्पअ भाल़अ ई</para>
  <para style="q" vid="JOB 24:16">राची निखल़ा तिंयां कसरै घअरे मेटा दी खाढ पाई च़ोरी करदै।<verse eid="JOB 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 24:17" />ज़िहै होर राची, तिहै डरा तिंयां धैल़ी बागै निखल़णैं का,</para>
  <para style="q" vid="JOB 24:17">राची आसा तिंयां भैस्सुई गऐ दै,</para>
  <para style="q" vid="JOB 24:17">तेथ निं तिंयां नटिप्प न्हैरै बी बागै निखल़णां लै डरदै।<verse eid="JOB 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 24:18" />ईंयां इहै पापी हआ पाणीं प्रैंदै शेफा ज़िहै,</para>
  <para style="q" vid="JOB 24:18">तिंयां घ्रोहल़णै दूर अर ज़ुंण ज़ैगा-ज़िम्मीं तिन्‍नें नाओंऐं होए</para>
  <para style="q" vid="JOB 24:18">तेथ लाणअ परमेशरा फिटक अर तेथ निं फसल हणीं।</para>
  <para style="q" vid="JOB 24:18">तिंयां डरनै आपणीं दाखे बागा डेऊणैं का बी।<verse eid="JOB 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 24:19" />ज़िहअ गरमीं अर धुप्पै करै हिंअं गल़ा,</para>
  <para style="q" vid="JOB 24:19">तिहै हणैं पापी मणछ बी चिजी शल़ी खतम।<verse eid="JOB 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 24:20" />तिन्‍नें ईज बी जाणीं तिन्‍नां छ़ेक्‍कै बिस्सरुई।</para>
  <para style="q" vid="JOB 24:20">तिंयां हणैं इहै खतम ज़िहै ढिश-बागरी करै ढूल़ै दै</para>
  <para style="q" vid="JOB 24:20">बूटा सूल़ी करा खाई पठी खतम।<verse eid="JOB 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 24:21" />तिन्‍नां लै हणअ ई इहअ किल्हैकि, तिन्‍नैं किअ बिधबा बेटल़ी संघै बूरअ बर्ताअ,</para>
  <para style="q" vid="JOB 24:21">नां तिन्‍नां बेटल़ी लै झींण किई ज़सरअ हुअ-ज़ाअ निं आथी।<verse eid="JOB 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 24:22" />पर परमेशर करा आपणैं महान</para>
  <para style="q" vid="JOB 24:22">ज़ोरा करै बडै-बडै जोधै खतम,</para>
  <para style="q" vid="JOB 24:22">परमेशर ज़ै कामां करदअ लागी गअ,</para>
  <para style="q" vid="JOB 24:22">तेखअ निं कदुष्ट ज़िऊंदअ बच़दअ।<verse eid="JOB 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 24:23" />परमेशर दैआ तिन्‍नां हणैं अर</para>
  <para style="q" vid="JOB 24:23">तिन्‍नां का ज़ाण्हिंआं इहअ कि तिंयां आसा निहंचै,</para>
  <para style="q" vid="JOB 24:23">पर परमेशर हआ कबल्‍लअ तिन्‍नां भाल़अ लागअ द कि तिंयां किज़ै करा।<verse eid="JOB 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 24:24" />थोल़ी घल़ी हआ कदुष्ट खास्सै सफल अर मशूर,</para>
  <para style="q" vid="JOB 24:24">तेतरी जाआ तिंयां झ़ट च़ारै खतम हई,</para>
  <para style="q" vid="JOB 24:24">तिंयां अल़ा तेखअ शुक्‍कै दै फूले पाचा ज़िहै धरनीं।<verse eid="JOB 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 24:25" />मेरी इना गल्‍ला लै कुंण इहअ बोली सका कि इहअ निं हंदअ?</para>
  <para style="q" vid="JOB 24:25">इहअ आसा कुंण ज़हा का मेरी गल्‍ला बृथा ज़ाण्हिंआं? तै खोज़ा सह कि किहअ हआ।<verse eid="JOB 24:25" /></para>
  <chapter eid="JOB 24" />
  <chapter number="25" style="c" sid="JOB 25" />
  <para style="s">परमेशरा का लागा डरनअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 25:1" />शूही मुल्खे बिल्दादै दैनअ इहअ ज़बाब,<verse eid="JOB 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 25:2" />परमेशरा का आसा महान बल,</para>
  <para style="q" vid="JOB 25:2">सोभी मणछा लागा तेऊए डरा हेठै रहणअ।</para>
  <para style="q" vid="JOB 25:2">सह करा स्वर्गा का राज़ अर मेल़-ज़ोल़।<verse eid="JOB 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 25:3" />तेऊ का आसा स्वर्ग दूते एतरी खास्सी सैना, तिन्‍नां निं कुंण गणी सकदअ।</para>
  <para style="q" vid="JOB 25:3">एही निं कुंण ज़ैगा आथी ज़िधी तेऊओ प्रैश्शअ निं पुजदअ।<verse eid="JOB 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 25:4" />तेखअ किहअ करै सका मणछ तेऊ सेटा धर्मीं हणैंओ दखाअ करी?</para>
  <para style="q" vid="JOB 25:4">इहअ कुंण आसा ज़ुंण परमेशरा सेटा शुचअ निखल़े?<verse eid="JOB 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 25:5" />परमेशरा सेटा आसा ज़ोथ बी न्हैरी,</para>
  <para style="q" vid="JOB 25:5">तेऊ सेटा फिरा तारै बी धुंमधुंमै।<verse eid="JOB 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 25:6" />तेखअ मणछ ज़ुंण किल़ै-मकोल़ै ज़िहअ आसा,</para>
  <para style="q" vid="JOB 25:6">तेऊए परमेशरा सेटा किज़ै मुर्त-मल़ाई आसा।<verse eid="JOB 25:6" /></para>
  <chapter eid="JOB 25" />
  <chapter number="26" style="c" sid="JOB 26" />
  <para style="s">एता करै तंऐं मेरी किज़ै मज़त किई</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 26:1" />आयूबै बोलअ बिल्दादा लै इहअ,<verse eid="JOB 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 26:2" />तंऐं भाल़ मुंह ज़िहै दुबल़ै मणछे केही राम्बल़ी</para>
  <para style="q" vid="JOB 26:2">मज़त किई ज़हा तराण ई निं आथी रहै दै!<verse eid="JOB 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 26:3" />तंऐं दैनी बै ज़ाथी राम्बल़ी सलाह अर</para>
  <para style="q" vid="JOB 26:3">तंऐं भाल़ मुंह ज़िहै कबुधी मणछा का</para>
  <para style="q" vid="JOB 26:3">किहै राम्बल़ै ज्ञैन खोज़ै!<verse eid="JOB 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 26:4" />तंऐं ईंयां ज्ञैन शिखल़ै किधा का?</para>
  <para style="q" vid="JOB 26:4">एही सैणीं गल्‍ला करनी ताखा कुंणी खोज़ी?<verse eid="JOB 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 26:5" />परमेशर आसा इहअ महान कि तेऊए डरै छ़ुटा</para>
  <para style="q" vid="JOB 26:5">खास्सी साला पैहलै जम्परी डेऊऐ दै मणछे शाह बी दर्छ़णअ</para>
  <para style="q" vid="JOB 26:5">समुंदरे थाल्‍लै अर पाणीं जैंदरी बस्सै छ़ुटा काम्मणीं।<verse eid="JOB 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 26:6" />परमेशर हआ जम्परी बी भाल़अ लागअ द,</para>
  <para style="q" vid="JOB 26:6">तेऊ सेटा आसा सोभै ज़ैगा घुआल़ी।<verse eid="JOB 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 26:7" />परमेशरै आसा उतरा बाखा सरग छ़ैई डाहअ द,</para>
  <para style="q" vid="JOB 26:7">पृथूई आसा तेऊ सरगै बाझ़ी थुम्हणीं टकैल़ी डाही दी!<verse eid="JOB 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 26:8" />घणैं बादल़ा दी पाणीं सांज़णै आल़अ आसा सह ई अर</para>
  <para style="q" vid="JOB 26:8">नां पाणींए बोझ़ा करै बादल़ा फुटणै दैंदअ।<verse eid="JOB 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 26:9" />सह छ़ैआ ज़ोथा आजू घणैं बादल़,</para>
  <para style="q" vid="JOB 26:9">संघा डाहा ज़ोथ तेथ पिछ़ू ढोपी।<verse eid="JOB 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 26:10" />समुंदरै बान्हीं तेऊ गोल़ रेख दैई सिअं,</para>
  <para style="q" vid="JOB 26:10">संघा डाहै न्हैरअ अर प्रैश्शअ ज़ुदै-ज़ुदै करी।<verse eid="JOB 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 26:11" />तेऊए झांशा करै च़ुक्‍का</para>
  <para style="q" vid="JOB 26:11">भ्रमंडे आथरी बी ओर्ही-पोर्ही।<verse eid="JOB 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 26:12" />अह आसा तेऊओ ई ज़ोर कि समुंदर बी रहअ ठुंईंअ बेशी,</para>
  <para style="q" vid="JOB 26:12">अर तेथ ज़ुंण बडै-बडै करबैऊंणैं दैंत्तर ज़ीब</para>
  <para style="q" vid="JOB 26:12">किऐ तेऊ आपणीं अक्ल अर समझ़ा करै खतम।<verse eid="JOB 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 26:13" />तेऊए शाह<note caller="+" style="f"><char style="fr" closed="false">26:13 </char><char style="fq" closed="false">शाह </char><char style="ft" closed="false">आत्मां</char></note> करै हआ सारअ सरग निम्बल़अ,</para>
  <para style="q" vid="JOB 26:13">बडी-बडी फैंखा आल़ी दानुईं ज़ुंण डैअ दैआ,</para>
  <para style="q" vid="JOB 26:13">तिन्‍नां लै बाहा सह आपणैं हाथा करै थच़ अर</para>
  <para style="q" vid="JOB 26:13">तिंयां हआ तेभी धरनीं पल़ी च़ित्त।<verse eid="JOB 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 26:14" />मंऐं खोज़ी तेऊए बारै सिधी धख ज़ेही गल्‍ला,</para>
  <para style="q" vid="JOB 26:14">ज़ै लागे तेऊए बारै सारी गल्‍ला खोज़णीं तै हणीं सारी अमर खतम पर</para>
  <para style="q" vid="JOB 26:14">तज़ी बी निं तेऊए महान कामें बारै खोज़ी मुक्‍कणैं!</para>
  <para style="q" vid="JOB 26:14">असली दी निं परमेशरे बारै कोही का थोघ आथी</para>
  <para style="q" vid="JOB 26:14">कि सह किहअ महान आसा।”<verse eid="JOB 26:14" /></para>
  <chapter eid="JOB 26" />
  <chapter number="27" style="c" sid="JOB 27" />
  <para style="s">हुंह हुअ बेघै दुखी</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 27:1" />आयूब लागअ तेखअ एही सैणीं गल्‍ला बोल्दअ,<verse eid="JOB 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 27:2" />“महान परमेशर ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 27:2">हुंह बोला तेऊए सोह खाई कि</para>
  <para style="q" vid="JOB 27:2">सह ई निस्सअ मेरअ नसाफ करी अर</para>
  <para style="q" vid="JOB 27:2">तेऊ ई किअ मेरअ ज़िऊ कल़ुअ।<verse eid="JOB 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 27:3" />ज़ेभै तैणीं मुंह दी परमेशरो शाह रहे,<verse eid="JOB 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 27:4" />मुंह रहणअ तेभै तैणीं आपणीं ज़िभा</para>
  <para style="q" vid="JOB 27:4">अर खाखा का शुची गल्‍ला खोज़दै लागी।<verse eid="JOB 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 27:5" />हुंह निं ऐहा गल्‍ला बोली सकदअ कि तम्हैं आसा शुचै,</para>
  <para style="q" vid="JOB 27:5">ऐहा गल्‍ला का निं हुंह मरनै तैणीं</para>
  <para style="q" vid="JOB 27:5">पिछ़ू हटदअ आथी।<verse eid="JOB 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 27:6" />मुखा आसा थोघ कि हुंह आसा शुचअ</para>
  <para style="q" vid="JOB 27:6">अर हुंह निं छ़ाड़ छ़ाडदअ किल्हैकि मेरै मन्‍नैं निं किछ़ै खोट आथी।<verse eid="JOB 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 27:7" />हुंह करा एही अरज़ कि ज़ुंण मुंह संघै ज़ीद डाहा,</para>
  <para style="q" vid="JOB 27:7">तिन्‍नां लोल़ी ती कदुष्ट अर</para>
  <para style="q" vid="JOB 27:7">पापी मणछा ज़ेही सज़ा भेटी।<verse eid="JOB 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 27:8" />कदुष्ट मणछा तेभै किज़ै आशा रहणीं</para>
  <para style="q" vid="JOB 27:8">ज़ेभै परमेशर तिन्‍नां लै मौत दैए?<verse eid="JOB 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 27:9" />ज़ेभै तिन्‍नां आफ़त पल़णीं,</para>
  <para style="q" vid="JOB 27:9">तेभै कै परमेशरा तिन्‍नें लेर-पकार शूणीं हेरनी? सह निं शुणदअ।<verse eid="JOB 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 27:10" />किल्हैकि ईंयां निं तिंयां मणछ आथी</para>
  <para style="q" vid="JOB 27:10">ज़ुंण तेऊ परमेशरे च़ाकरी दी सुखी रहा ज़हा का सारअ बल आसा।<verse eid="JOB 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 27:11" />हुंह खोज़ूं तम्हां का कि परमेशरो बल किहअ महान आसा अर</para>
  <para style="q" vid="JOB 27:11">परमेशरै किज़ै आसा सोठी डाहअ द।<verse eid="JOB 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 27:12" />पर तम्हैं हेरी ईंयां सोभै गल्‍ला आपणीं आछी भाल़ी,</para>
  <para style="q" vid="JOB 27:12">तेखअ किल्है बोला तम्हैं मुल्है एही नथोघी गल्‍ला।<verse eid="JOB 27:12" /></para>
  <para style="s">परमेशर कदुष्टा संघै किहअ बभार करा</para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 27:13" />परमेशर ज़हा का सारअ बल आसा, हुंह खोज़ूं तम्हां का भाल़ै तेऊ</para>
  <para style="q" vid="JOB 27:13">कदुष्ट मणछा लै केही सज़ा दैणीं।<verse eid="JOB 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 27:14" />हई सका कि तिन्‍नें खास्सै शोहरू-शोहरी होए,</para>
  <para style="q" vid="JOB 27:14">पर तिंयां पाणै जुधा दी सोभै मारी,</para>
  <para style="q" vid="JOB 27:14">तिन्‍नें शोहरू-माठै निं रज्ज़ी खाणां लै रोटी बी हणीं।<verse eid="JOB 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 27:15" />ज़ुंण पिछ़ू ज़िऊंदै बच़े,</para>
  <para style="q" vid="JOB 27:15">तिंयां मरनै नबिज़री बमारी करै,</para>
  <para style="q" vid="JOB 27:15">तिन्‍नें बिधबा बेटल़ी निं तिन्‍नां लै शोग बी करनअ।<verse eid="JOB 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 27:16" />कदुष्ट मणछै सुन्‍नअ-च़ंदी माट्टे रूल़ा ज़िहअ</para>
  <para style="q" vid="JOB 27:16">किल्है निं होए झाल़ी डाहअ द,</para>
  <para style="q" vid="JOB 27:16">च़ाऐ तिन्‍नां का खास्सै झिकल़ै किल्है निं होए,<verse eid="JOB 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 27:17" />पर तिन्‍नां निं तिंयां बान्हणैं भेटणैं, तेतो भलअ हणअ कहा धर्मीं मणछा,</para>
  <para style="q" vid="JOB 27:17">अर तिन्‍नों सुन्‍नअ-च़ंदी भेटणअ कहा मानदार मणछा।<verse eid="JOB 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 27:18" />कदुष्ट बणाआं आपणअ घअर जांगूए जगोल्हा ज़िहअ अर</para>
  <para style="q" vid="JOB 27:18">खेचै पहरीए छ़ानां ज़िहअ।<verse eid="JOB 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 27:19" />तिंयां पापी ज़ै सेठ हई च़ैन्‍नै सुत्ते,</para>
  <para style="q" vid="JOB 27:19">पर ज़ांऊं तिंयां सुत्ती उझ़णै, तिंयां हणैं दाल़जी गऐ दै हई।<verse eid="JOB 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 27:20" />तिन्‍नां पल़णीं बरसाती आई दी गाडा ज़ेही नच़ानक डअर,</para>
  <para style="q" vid="JOB 27:20">तिंयां फर्लाऊंणैं हारनै-मारनै आल़ी ढिश-बागरी ज़िहै दूर।<verse eid="JOB 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 27:21" />पुर्बा बाखे बागरी च़कणै तिंयां उझै</para>
  <para style="q" vid="JOB 27:21">संघा शोटणै किधी दूर।<verse eid="JOB 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 27:22" />तिंयां फिरनैं तेता का बच़दै पर</para>
  <para style="q" vid="JOB 27:22">तिन्‍नां लै पल़णीं आफ़ता प्रैंदै आफ़त, परमेशरा निं तिन्‍नां लै झींण फिरनी।<verse eid="JOB 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 27:23" />ढिश-बागरी पाणीं मणछा ज़ेही ताल़ी बाज़ी शल़ेल़्हा</para>
  <para style="q" vid="JOB 27:23">किल्हैकि तिंयां फर्ल़ाऊऐ तिन्‍नें ज़ैगा का दूर।”<verse eid="JOB 27:23" /></para>
  <chapter eid="JOB 27" />
  <chapter number="28" style="c" sid="JOB 28" />
  <para style="s">सुन्‍नैं-च़ंदीए हआ खान</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 28:1" />“सुन्‍नअ-च़ंदी आणा लोग खांनी का कोती,</para>
  <para style="q" vid="JOB 28:1">तेता धोई च़ोखअ बी ज़ाणा तिंयां करी।<verse eid="JOB 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 28:2" />लोहअ बी लागा धरती का कोती करै काढणअ अर</para>
  <para style="q" vid="JOB 28:2">कांस्सअ बी निखल़ा शाफल़ा जैंदरा का गाल़ी करै।<verse eid="JOB 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 28:3" />इना सोभी धातू काढणा लै</para>
  <para style="q" vid="JOB 28:3">खण्हां लोग धरती दी उंधै डुघी खात्ती संघा आणा तिन्‍नां</para>
  <para style="q" vid="JOB 28:3">पात्थरा लोल़ी ज़ेता का ईंयां धातू निखल़ा।<verse eid="JOB 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 28:4" />ईंयां च़िज़ा निं घअरा फेर भेटदी ज़िधी हाम्हैं बस्सै दै हआ,</para>
  <para style="q" vid="JOB 28:4">एता लै डेओआ दूर-दूर तैणीं हांढी ज़िधी आम मणछ डेऊंदअ ई निं आथी,</para>
  <para style="q" vid="JOB 28:4">संघा डेओआ राश्शी करै च़ुंढुई उंधै डुघी खात्ती दी।<verse eid="JOB 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 28:5" />धरती प्रैंदै, बऊआ मणछ फसल,</para>
  <para style="q" vid="JOB 28:5">पर तैहा ई ज़िम्मीं हेठै हआ भितरी</para>
  <para style="q" vid="JOB 28:5">आगी ज़िहअ घोर घमास्स लागअ द ज़ुंण पात्थरा बी दैआ गाल़ी।<verse eid="JOB 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 28:6" />धरतीए पात्थरा जैंदरी लोल़ा मणछ नीलमणीं</para>
  <para style="q" vid="JOB 28:6">अर माट्टै जैंदरा का काढा सुन्‍नअ।<verse eid="JOB 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 28:7" />इना खांनी खण्हनै आल़ेए बातो निं कहा काअ-गरली बी थोघ हंदअ,</para>
  <para style="q" vid="JOB 28:7">नां तिन्‍नां प्रैंदै उझै बाज़ हंदै डैऊंदै लागै दै।<verse eid="JOB 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 28:8" />तिंयां हआ एही-एही ज़ैगा पुजै दै, तेथ निं कुंण शकारी ज़ीब बी डेऊंदअ</para>
  <para style="q" vid="JOB 28:8">नां तैहा बाता कधू सिह हांढदअ।<verse eid="JOB 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 28:9" />तिंयां फाल़ा काठै-का काठै पात्थरा,</para>
  <para style="q" vid="JOB 28:9">बडी-बडी धारा झ़ैऊआ तिंयां गोधी का।<verse eid="JOB 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 28:10" />तिंयां बणाआं शाफल़ कोती, लाम्मी-लाम्मी जुहल़ी</para>
  <para style="q" vid="JOB 28:10">संघा लोल़ा तेथ किम्मती पात्थर।<verse eid="JOB 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 28:11" />तिंयां लोल़ा पाणींए दरैओ मूल़</para>
  <para style="q" vid="JOB 28:11">अर तिंयां लोल़ा एही-एही ज़ैगा ज़ुंण कोही निं भाल़ी।<verse eid="JOB 28:11" /></para>
  <para style="s">अक्ल किधा का भेटा?</para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 28:12" />अक्ल किधा का सका भेटी?</para>
  <para style="q" vid="JOB 28:12">हाम्हैं किधा का सका शिखल़ी अर समझ़ी।<verse eid="JOB 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 28:13" />अक्ल निं एऊ संसारै हाम्हां मणछा जैंदरी भेटदी</para>
  <para style="q" vid="JOB 28:13">नां कहा का तेते असली किम्मत थोघ आथी।<verse eid="JOB 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 28:14" />अक्ली लोल़ै ज़ै समुंदरे थाल्‍लै बी पुजे,</para>
  <para style="q" vid="JOB 28:14">सह निं तेथ बी च़ाल्‍ली भेटी।<verse eid="JOB 28:14" /></para>
  <para style="q">
    <verse number="15-16" style="v" sid="JOB 28:15-16" />तेता निं च़ोखअ सुन्‍नैं-च़ंदी दैई बी मोलै लई सकदै।</para>
  <para style="q" vid="JOB 28:15-16">तेते किम्मत आसा च़ोखै सुन्‍नैं अर</para>
  <para style="q" vid="JOB 28:15-16">किम्मती मणीं का बी खास्सी।<verse eid="JOB 28:15-16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 28:17" />च़ोखअ सुन्‍नअ, अर खास्सअ किम्मती</para>
  <para style="q" vid="JOB 28:17">शिशअ बी निं तेता सेटा किछ़ै आथी।<verse eid="JOB 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 28:18" />हीरै, मोती, किम्मती नघो</para>
  <para style="q" vid="JOB 28:18">मोल बी निं अक्ली सेटा किछ़ आथी।<verse eid="JOB 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 28:19" />ज़ुंण पुखराज़ नघ कूश देशै भेटा अर</para>
  <para style="q" vid="JOB 28:19">च़ोखअ सुन्‍नअ बी निं अक्लीए बराबरी करी सकदअ।<verse eid="JOB 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 28:20" />तै अक्लीओ मूल़ किधी आसा?</para>
  <para style="q" vid="JOB 28:20">तेता हाम्हैं किधा का सका समझ़ी अर शिखल़ी?<verse eid="JOB 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 28:21" />तेता निं कोहै ज़िऊंदअ ज़ीब भाल़ी सकदअ,</para>
  <para style="q" vid="JOB 28:21">सरगै डेऊणैं आल़ै च़ेल्‍लू-पखीरू बी निं तेता भाल़ी सकदै।<verse eid="JOB 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 28:22" />मौत अर बरैबादी बी बोला तेते बारै एचल़ी,</para>
  <para style="q" vid="JOB 28:22">‘हाम्हैं आसा अक्लीए बारै गल्‍ला शूणीं दी।’<verse eid="JOB 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 28:23" />अक्लीओ थोघ आसा सिधअ परमेशरा का,</para>
  <para style="q" vid="JOB 28:23">तेऊ का आसा थोघ कि अक्ल किधी भेटा,<verse eid="JOB 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 28:24" />किल्हैकि सह ई सका धरतीए पुंझ़ै तैणीं भाल़ी,</para>
  <para style="q" vid="JOB 28:24">सह हेरा सारै भ्रमंडै भाल़ी कि तेथ किज़ै लागअ द हंदअ।<note caller="-" style="x"><char style="xo" closed="false">28:24 </char><char style="xt" closed="false"><ref loc="PSA 11:4">भज. 11:4</ref></char></note><verse eid="JOB 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 28:25" />सह तोला बागरी ज़ेही तराकल़ी दी कि केतरी ज़ोरै लोल़ी लागी अर</para>
  <para style="q" vid="JOB 28:25">पाणीं दैआ सह नापी करै कि केतरअ सरग लोल़ी हुअ।<verse eid="JOB 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 28:26" />सह करा एतो बच़ार आप्पै कि सरग किधी लोल़ी हुअ अर</para>
  <para style="q" vid="JOB 28:26">गुल़ूबिज़ल़ू कैहा ज़ैगा लोल़ी लागअ।<verse eid="JOB 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 28:27" />तेऊ आसा अक्ल आप्पै ज़ाच़ी-भाल़ी दी कि तेतो मोल किज़ै आसा,</para>
  <para style="q" vid="JOB 28:27">अर सह तेता लै हाँ करनै आल़अ बी आसा सह ई।<verse eid="JOB 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 28:28" />स्वर्गे सारी सैनो मालक बोला हाम्हां मणछा लै इहअ,</para>
  <para style="q" vid="JOB 28:28">‘मुंह परमेशरे डरा हेठै रहणअ ई आसा अक्ल,</para>
  <para style="q" vid="JOB 28:28">बूराई का दूर रहणअ ई आसा समझ़।’”<verse eid="JOB 28:28" /></para>
  <chapter eid="JOB 28" />
  <chapter number="29" style="c" sid="JOB 29" />
  <para style="s">आयूब लागअ पिछ़ली गल्‍ला आद करी बोल्दअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 29:1" />आयूब लागअ तेखअ एही सैणीं गल्‍ला बोल्दअ,<verse eid="JOB 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 29:2" />“तिंयां धैल़ै भाल़ किहै डेऊऐ,</para>
  <para style="q" vid="JOB 29:2">परमेशर करा त आप्पै मेरी हेर-सभाल़,<verse eid="JOB 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 29:3" />परमेशर हआ त कबल्‍लअ मुंह संघै</para>
  <para style="q" vid="JOB 29:3">न्हैरै हांढणा लै दैआ त सह मुल्है प्रैश्शअ।<verse eid="JOB 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 29:4" />मेरी ज़िन्दगी तै इहै बी धैल़ै कि हुंह त सोभी गल्‍ला लै सेठ,</para>
  <para style="q" vid="JOB 29:4">मेरी साथ थिई परमेशरा संघै अर</para>
  <para style="q" vid="JOB 29:4">तेता करै रहा त हुंह राज्ज़ी-राम्बल़अ।<verse eid="JOB 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 29:5" />सह परमेशर रहा त मुंह संघा ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 29:5">खेचै-खहल़ै त मुंह आपणैं शोहरू-माठैओ कामां लै सकाल़अ।<verse eid="JOB 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 29:6" />तिन्‍नां धैल़ै न्हैईआ त हुंह दुधा करै,</para>
  <para style="q" vid="JOB 29:6">शाबू आल़ी ज़िम्मीं दी लागै दै जैतूने बूटा का हआ त</para>
  <para style="q" vid="JOB 29:6">मेरै खास्सअ जैतूनो तेल।<verse eid="JOB 29:6" /></para>
  <para style="q">
    <verse number="7-8" style="v" sid="JOB 29:7-8" />नगरीए प्रऊल़ी सेटा सभा दी</para>
  <para style="q" vid="JOB 29:7-8">बेशा त हुंह खास सैणैं संघै आजू,</para>
  <para style="q" vid="JOB 29:7-8">सभा दी मेरै एछदी सिक्‍का तै खारकै मणछ मेरअ अदर करना लै</para>
  <para style="q" vid="JOB 29:7-8">ओर्ही-पोर्ही अर सैणैं मणछ करा तै खल़अ उझ़ुई मेरअ अदर।<note caller="-" style="x"><char style="xo" closed="false">29:7-8 </char><char style="xt" closed="false"><ref loc="DEU 21:19">बधा. 21:19</ref>; <ref loc="RUT 4:1">रूत. 4:1</ref>; <ref loc="2KI 7:1">2 राज़. 7:1</ref>,<ref loc="2KI 7:11">11</ref></char></note><verse eid="JOB 29:7-8" /></para>
  <para style="q">
    <verse number="9-10" style="v" sid="JOB 29:9-10" />मेरै सभा दी पुजदी हआ तै सोभ ज़ण्हैं च़ुपच़ाप</para>
  <para style="q" vid="JOB 29:9-10">खास-खास सैणैं बी रहा तै तेभै च़ुप्पी।<verse eid="JOB 29:9-10" /></para>
  <para style="s">सोभै मणछ हआ तै मुल्है राज्ज़ी</para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 29:11" />मुंह भाल़णैं अर शुणनै आल़ै हआ तै</para>
  <para style="q" vid="JOB 29:11">मेरै कामां लै राज्ज़ी अर खुश।<verse eid="JOB 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 29:12" />रैनै-गरीब अर छ़ुटै-मुक्‍कै दै लान्हें</para>
  <para style="q" vid="JOB 29:12">लेर-पकार शूणीं डेओआ त हुंह तिन्‍नें</para>
  <para style="q" vid="JOB 29:12">मज़त करना लै सोभी का आजू।<verse eid="JOB 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 29:13" />खास्सी दाह-दुखा दी पल़ै दै मणछ</para>
  <para style="q" vid="JOB 29:13">बी बोला तै मुल्है भलअ,</para>
  <para style="q" vid="JOB 29:13">बिधबा बेटल़ीए मज़त करना लै मेरै कामां करै हआ ती तिन्‍नें दिलै बी खुशी।<verse eid="JOB 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 29:14" />मानदारी अर धर्मीं ज़िन्दगी ती</para>
  <para style="q" vid="JOB 29:14">मंऐं च़ोल़ै अर साफै ज़ेही बान्हीं दी।<verse eid="JOB 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 29:15" />मंऐं किई लोगे एही च़ाकरी कि कांणै लै थिअ हुंह आछी ज़िहअ</para>
  <para style="q" vid="JOB 29:15">अर लाट्टै लै थिअ हुंह ज़ांघा ज़िहअ।<verse eid="JOB 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 29:16" />रैनै-गरीबा लै थिअ हुंह तिन्‍नें ईजा-बाबा ज़िहअ,</para>
  <para style="q" vid="JOB 29:16">पाखलै मणछे तोही करा त हुंह</para>
  <para style="q" vid="JOB 29:16">दालता दी डेऊई तिन्‍नें मज़त।<verse eid="JOB 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 29:17" />कदुष्ट मणछे दैआ त हुंह दांद चोल़ी अर</para>
  <para style="q" vid="JOB 29:17">तिन्‍नें बशै पल़ै दै मणछा आणा त हुंह छ़ड़ैऊई।<verse eid="JOB 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 29:18" />तधू काल्‍ला सोठा त हुंह इहअ कि मेरी लोल़ी ती खास्सी अमर हुई</para>
  <para style="q" vid="JOB 29:18">ज़ेभै मुल्है मौत बी एछे,</para>
  <para style="q" vid="JOB 29:18">तेभै लोल़ी त हुंह आपणैं घअरै आपणैं टबरा जैंदरी हुअ।<verse eid="JOB 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 29:19" />तिन्‍नां धैल़ै त हुंह इहै बूटा ज़िहअ,</para>
  <para style="q" vid="JOB 29:19">ज़ेते ज़लैल़ै डुघै अर</para>
  <para style="q" vid="JOB 29:19">शाण्हीं दी कबल्‍लअ ओश हआ पल़अ द।<verse eid="JOB 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 29:20" />मुंह सराहा तै सोभै अर सोभै करा तै मेरअ अदर,</para>
  <para style="q" vid="JOB 29:20">तेता करै भेटा त मुंह होर बी खास्सअ बल।<verse eid="JOB 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 29:21" />ज़ांऊं हुंह बोल्दअ लागा थिअ, तेभै निं कुंण चूँ बी करदअ त,</para>
  <para style="q" vid="JOB 29:21">तिंयां शूणां तै मेरी सलाह धैन-मन्‍न लाई।<verse eid="JOB 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 29:22" />ज़ांऊं हुंह गल्‍ला खोज़ी मुक्‍का त तेखअ निं सभा दी मेरी गल्‍ला दी किज़ै ज़ोल़णे ज़रुरत हंदी ती,</para>
  <para style="q" vid="JOB 29:22">मेरी गल्‍ला हआ ती तिन्‍नां लै गरमींए धैल़ै पाणींए छ़ाल्‍लै ज़ेही।<verse eid="JOB 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 29:23" />सोभै हआ तै मेरी गल्‍ला लै इहै राज्ज़ी ज़िहअ</para>
  <para style="q" vid="JOB 29:23">बरसात हणां लै कृषाण राज्ज़ी हआ।<verse eid="JOB 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 29:24" />ज़ेभै लोग किज़ू लै पठी हैअ हेरा तै चोल़ी,</para>
  <para style="q" vid="JOB 29:24">तिन्‍नां बाखा दैआ त हुंह मसुस्सुऐ हास्सी नदर अर तेता करै एछा त तिन्‍नां हैअ।<verse eid="JOB 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 29:25" />तिन्‍नां लै त हुंह ई सैणैं ज़िहअ अर</para>
  <para style="q" vid="JOB 29:25">तिन्‍नां लै बात खोज़णैं आल़अ बी हआ त हुंह ई।</para>
  <para style="q" vid="JOB 29:25">ज़िहअ राज़अ आपणीं सैना जैंदरी हआ, तिहअ त हुंह तिन्‍नां लै।</para>
  <para style="q" vid="JOB 29:25">हुंह दैआ त तिन्‍नां लै तिन्‍नें दाह-दुखा</para>
  <para style="q" vid="JOB 29:25">जैंदरी हैअ विश्वास।”<verse eid="JOB 29:25" /></para>
  <chapter eid="JOB 29" />
  <chapter number="30" style="c" sid="JOB 30" />
  <para style="s">खारकै करा मेरअ सुहांग</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 30:1" />“ज़ुंण मुखा खारकै आसा, तिंयां फिरा ऐबै मेरै सुहांगा करदै!</para>
  <para style="q" vid="JOB 30:1">पोर्ही निं तिन्‍नें ईज-बाब एता जोगी बी आथी तै कि तिंयां</para>
  <para style="q" vid="JOB 30:1">मेरै कुक्‍करा का रोटी खैऊई अर</para>
  <para style="q" vid="JOB 30:1">मेरी भेडा-बाकरीए हेल़्ही फुआल रही सके।<verse eid="JOB 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 30:2" />तिंयां निं आप्पू ई किछ़ू कामें आथी तै!</para>
  <para style="q" vid="JOB 30:2">मेरै काम करनअ, थिई दूरे गल्‍ल!<verse eid="JOB 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 30:3" />तिंयां थिऐ पठी दाल़जी अर तिन्‍नां हआ तै भुखै ब्रत लागै दै!</para>
  <para style="q" vid="JOB 30:3">राची हआ तै तिंयां धूल़ै-माट्टै जैंदरी खाणां लै</para>
  <para style="q" vid="JOB 30:3">शुक्‍कै ज़लैल़ै लोल़ै लागै दै कि तिंयां तेता च़ाबी आपणीं भुख शेऊई सके।<verse eid="JOB 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 30:4" />तिंयां खाआ रेगीस्तानै पज़णै आल़ै शागे ज़लैल़ै,</para>
  <para style="q" vid="JOB 30:4">तिंयां रहा तै झाऊए बूटे ज़लैल़ै च़ाबदै लागी ज़ेथ किछ़ सुआद निं हंदअ।<verse eid="JOB 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 30:5" />लोग दरल़ाऊआ तै तिन्‍नां हाक्‍का भ्रुका पाई</para>
  <para style="q" vid="JOB 30:5">च़ोरा ज़िहै आपणीं नगरी का दूर।<verse eid="JOB 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 30:6" />तिन्‍नां पल़ा त डरैऊंणै नाल़ै-खोहल़ै</para>
  <para style="q" vid="JOB 30:6">अर ढुंखरै-डुआरै रहणअ।<verse eid="JOB 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 30:7" />तिंयां रहा तै कुंगशी-कार्हलै जैंदरी पशू ज़िहै ठुल़्दै लागी,</para>
  <para style="q" vid="JOB 30:7">कांडे झ़ाकल़ा हेठै हआ त तिन्‍नों रूल़ कठा।<verse eid="JOB 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 30:8" />तिन्‍नां काढा तै लोग बेगरै गाधै ज़िहै</para>
  <para style="q" vid="JOB 30:8">दरल़ाऊई नगरी का दूर।<verse eid="JOB 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 30:9" />पर ऐबै लागा तिंयां मेरी गिह गांठी सुहांगा करदै!</para>
  <para style="q" vid="JOB 30:9">तिन्‍नां लै आसा हुंह ऐबै मखौल हुअ द।<verse eid="JOB 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 30:10" />तिन्‍नां लागा मुंह नेल़ एछणा लै बी च़िल़्ह!</para>
  <para style="q" vid="JOB 30:10">ऐबै सोठा तिंयां इहअ कि तिंयां आसा मुखा खास्सै राम्बल़ै,</para>
  <para style="q" vid="JOB 30:10">तिंयां पाआ दूर खल़्हुई मेरै मुंहां लै थुक्‍की।<verse eid="JOB 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 30:11" />मुंह भाल़ी ज़िहअ तिन्‍नों दिल बोला, तिंयां करा तिहअ,</para>
  <para style="q" vid="JOB 30:11">किल्हैकि परमेशरै किअ हुंह पठी बरैबाद</para>
  <para style="q" vid="JOB 30:11">तैही हुई तिन्‍नां एतरी हिम्मत।<verse eid="JOB 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 30:12" />इना उपद्रभी मणछे टोली एछा मुंह च़िक्‍कदी,</para>
  <para style="q" vid="JOB 30:12">ईंयां हआ मुंह पठी बरैबाद करना लै भांती-भांतीए बिक्री सोठदै लागै दै।<verse eid="JOB 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 30:13" />तिंयां रोक्‍का फेरा फेर मेरी बात कि हुंह ठुर्ही नां सके,</para>
  <para style="q" vid="JOB 30:13">अर मुंह मारना लै लाआ तिंयां पूरअ ज़ोर</para>
  <para style="q" vid="JOB 30:13">तिंयां भाल़ा कि मेरी मज़त करदअ निं तेथ कोहै आथी।<verse eid="JOB 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 30:14" />तिंयां एछा फेरा-फेर मुल्है ठुर्ही</para>
  <para style="q" vid="JOB 30:14">अर उझै का दैआ तिंयां मुंह प्रैंदा लै छ़ाहल़ा।<verse eid="JOB 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 30:15" />मुंह हआ भितरी हैल़अ पल़अ द,</para>
  <para style="q" vid="JOB 30:15">लोग ज़िहअ मेरअ अदर करा तै, सह बी फर्ल़ाऊअ उझै</para>
  <para style="q" vid="JOB 30:15">मेरी ज़ितणें आशा बी लुक्‍की बादल़ा ज़ेही।<verse eid="JOB 30:15" /></para>
  <para style="s">मुंह आसा भितरी खास्सी दाह लागी दी</para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 30:16" />ऐबै च़ाल्‍लअ मेरै मर्हुई,</para>
  <para style="q" vid="JOB 30:16">मुंह निस्सअ दाह दी केही राम हई।<verse eid="JOB 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 30:17" />राची लागा मुंह हाडके ज़ोल़ै-ज़ोल़ै दाह</para>
  <para style="q" vid="JOB 30:17">तिंयां झोशा करै उझ़िआ होर बी खास्सी दाह।<verse eid="JOB 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 30:18" />परमेशरै ढाकअ हुंह गल़ा का</para>
  <para style="q" vid="JOB 30:18">अर तेऊ पाई मेरी घेरी क्रिंज़ा।<verse eid="JOB 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 30:19" />तेऊ शोट्टअ हुंह धरनीं च़िक्‍करै जैंदरी,</para>
  <para style="q" vid="JOB 30:19">हुंह हुअ ऐबै माट्टै अर छ़ारा ज़िहअ।<verse eid="JOB 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 30:20" />हे परमेशर, हुंह पाआ ताह सेटा लेर पकार,</para>
  <para style="q" vid="JOB 30:20">पर तंऐं निं कधू तेतो ज़बाब ई दैनअ!</para>
  <para style="q" vid="JOB 30:20">मंऐं मांगी ताखा मज़त पर तंऐं निं</para>
  <para style="q" vid="JOB 30:20">मुंह बाखा धैन ई दैनअ!<verse eid="JOB 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 30:21" />तूह हुअ मुल्है बेघै काठअ,</para>
  <para style="q" vid="JOB 30:21">तंऐं शोट्टअ हुंह आपणैं ज़ोरा करै हंती।<verse eid="JOB 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 30:22" />तूह फर्ल़ाऊआ मुंह बागरी करै दूर,</para>
  <para style="q" vid="JOB 30:22">तंऐं छ़णाटअ हुंह ढिशा करै ओर्ही-पोर्ही।<verse eid="JOB 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 30:23" />ऐबै गअ मुखा थोघ लागी कि तंऐं लाअ द हुंह मारी पाई,</para>
  <para style="q" vid="JOB 30:23">तूह च़ाह मुंह तिधी पजैल़णअ ज़िधी</para>
  <para style="q" vid="JOB 30:23">मरी करै ज़ीबो शाह डेओआ।<verse eid="JOB 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 30:24" />मंऐं निं कोही गरीबा लै आपणैं हाथै किछ़ै बूरअ किअ</para>
  <para style="q" vid="JOB 30:24">अर नां हुंह खरीए पलका तिन्‍नें मज़त करनै का पिछ़ू हटअ।<verse eid="JOB 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 30:25" />दुख-तकलिफी दी पल़ै दै मणछा भाल़ी छ़ुटा ती मुखा कबल्‍ली लेरा,</para>
  <para style="q" vid="JOB 30:25">ज़हा का किछ़ निं हंदअ थिअ, तिन्‍नां भाल़ी हआ त हुंह बेघै दुखी।<verse eid="JOB 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 30:26" />मंऐं ज़ाणअ त इहअ कि आजू हणीं मेरै मौज़,</para>
  <para style="q" vid="JOB 30:26">पर मुल्है पल़ी आफ़ता प्रैंदै आफ़त,</para>
  <para style="q" vid="JOB 30:26">मेरी ती एही आशा कि राच जाणीं भैई,</para>
  <para style="q" vid="JOB 30:26">पर मुल्है हुअ होर बी नटिप्प न्हैरअ।<verse eid="JOB 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 30:27" />पेटा भितरी निस्सी मेरै दाहे झोश केही बेशी,</para>
  <para style="q" vid="JOB 30:27">मेरै दुखे धैल़ै निस्सै मुक्‍की ई आथी।<verse eid="JOB 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 30:28" />मंऐं ज़िऊई दुखी ज़िन्दगी, सुरज़े धुप्पै करै बी निं मुंह खुशी हंदी ती,</para>
  <para style="q" vid="JOB 30:28">लोगा लै बी लागअ हुंह सभा दी बोल्दअ कि ज़ीबाण मेरी मज़त करा।<verse eid="JOB 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 30:29" />हुंह रहअ दुखी अर कल्ही शैल़ी अर</para>
  <para style="q" vid="JOB 30:29">हुहल़ू ज़िहअ ल़ुहल़ी लांदअ लागी।<verse eid="JOB 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 30:30" />मेरी हुई सारी घेर ई काल़ी अर</para>
  <para style="q" vid="JOB 30:30">ज़ोरै जाम्हां करै भुझ़ुअ हुंह पठी।<verse eid="JOB 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 30:31" />कोई धैल़ै किहअ थिअ हुंह खुशीए बींन अर बशूरी शुणनै आल़अ</para>
  <para style="q" vid="JOB 30:31">पर ऐबै शुण्हिंआं मुखा फेरा-फेर सिधअ लेरनअ अर मखाण पल़अ द।”<verse eid="JOB 30:31" /></para>
  <chapter eid="JOB 30" />
  <chapter number="31" style="c" sid="JOB 31" />
  <para style="s">मंऐं निं किछ़ै पाप-दोश किअ</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 31:1" />“मंऐं आसा आपणीं आछी लै बी बधान डाहअ द कि मुंह निं कधि</para>
  <para style="q" vid="JOB 31:1">च़ंदरी सोठ डाही कहा शोहरी भाल़ै लागणअ।<verse eid="JOB 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 31:2" />तेखअ मुंह परमेशरा का किज़ै फल च़ाल्‍लअ भेटी?</para>
  <para style="q" vid="JOB 31:2">महान परमेशर ज़हा का सारअ बल आसा ज़ुंण स्वर्गै सोभी का उझै आसा, तेऊ म्हारै हेस्सै किज़ै दैणअ?<verse eid="JOB 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 31:3" />ज़ुंण पाप करा तिन्‍नां लै छ़ाडणीं तेऊ</para>
  <para style="q" vid="JOB 31:3">आफ़त अर बरैबादी ई।<verse eid="JOB 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 31:4" />परमेशरा का हआ सोभी गल्‍लो थोघ कि हुंह किज़ै करा।</para>
  <para style="q" vid="JOB 31:4">सह हआ मुंह गंईं-गंईं दी भाल़अ लागअ द।<verse eid="JOB 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 31:5" />हुंह खाआ सोह कि मंऐं निं कधि इहै कदुष्ट काम किऐ</para>
  <para style="q" vid="JOB 31:5">नां मंऐं कहा लै कधू धोखअ किअ।<verse eid="JOB 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 31:6" />परमेशरै लोल़ी त हुंह धर्में तराकल़ी दी तोलअ</para>
  <para style="q" vid="JOB 31:6">अर तेखअ हेरनअ तेऊ भाल़ी कि हुंह आसा नर्दोश।<verse eid="JOB 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 31:7" />ज़ै हुंह कधू उंबल़ी बाता डेऊअ होए,</para>
  <para style="q" vid="JOB 31:7">ज़ै कधू मेरी आछी भाल़णैं करै मेरअ दिल तेता लै लोभणूंअ होए अर होर बी मुल्है किज़ै पाप करनैओ दोश होए,<verse eid="JOB 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 31:8" />तै लोल़ी मेरी साल-फसल बरैबाद हुई,</para>
  <para style="q" vid="JOB 31:8">मेरी बऊई दी फसल लोल़ी कुंणी होरी खाई।<verse eid="JOB 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 31:9" />ज़ै हुंह मेरै साथी-संघीए लाल़ी लै लोभणूंअ होए अर</para>
  <para style="q" vid="JOB 31:9">तैहा घअरै कल्ही रहणें मोक्‍कै न्हैल़अ लागअ होए,<verse eid="JOB 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 31:10" />तै लोल़ी मुल्है बी तिहअ ई हुअ अर</para>
  <para style="q" vid="JOB 31:10">मेरी आपणीं बेटल़ी बी लोल़ी कुंणी पराऐ मणछै भ्रष्ट किई।<verse eid="JOB 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 31:11" />इहै घोर पापा पिछ़ू लोल़ी ज़रूर सज़ा भेटी।<verse eid="JOB 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 31:12" />कंज़रैई हणीं ती मुल्है एही आगी ज़ेही ज़ेता करै हुंह पठी बरैबाद सका त हई,</para>
  <para style="q" vid="JOB 31:12">ज़ुंण मुखा आसा सह दझ़णअ त तेथ पठी।<verse eid="JOB 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 31:13" />ज़ेभै मेरै नोकर-च़ाकरै मुखा खरी खोज़ी होए अर</para>
  <para style="q" vid="JOB 31:13">तेथ मंऐं तिन्‍नां लै नसाफ नांईं किअ होए,<verse eid="JOB 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 31:14" />तै ज़ेभै परमेशर मेरअ नसाफ करदअ एछे, तेभै कै करूं?</para>
  <para style="q" vid="JOB 31:14">तेभै मुंह तेऊ लै किज़ै ज़बाब दैणअ?<verse eid="JOB 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 31:15" />सह ई परमेशर आसा सोभी लै एक्‍कै</para>
  <para style="q" vid="JOB 31:15">ज़ुंणी हुंह अर मेरअ नोकर दुहै आसा बणाऐं दै।<verse eid="JOB 31:15" /></para>
  <para style="s">मंऐं निं कोहै ठगै आथी</para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 31:16" />हुंह निं रैनै-गरीबे मज़त करनै का पिछ़ू हटअ आथी,</para>
  <para style="q" vid="JOB 31:16">नां कहा बिधबा बेटल़ीए आशा चोल़ी।<verse eid="JOB 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 31:17" />नां मंऐं कधू इहअ किअ कि आप्पू खाई रोटी अर</para>
  <para style="q" vid="JOB 31:17">छ़ुटै-मुक्‍कै दै लान्हैं आसा भुखै!<verse eid="JOB 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 31:18" />ज़धा ओर्ही हुंह ज़ाणदअ हुअ, तधा ओर्ही</para>
  <para style="q" vid="JOB 31:18">करा हुंह बिधबा अर छ़ुटै मुक्‍कै दै मणछे हेर-सभाल़ ईजा-बाबा ज़ेही।<verse eid="JOB 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 31:19" />ज़ेभै बी मंऐं कुंण गरीब मणछ भाल़अ कि</para>
  <para style="q" vid="JOB 31:19">सह निं आप्पू लै झिकल़ै बी लई सकदअ,<verse eid="JOB 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 31:20" />तिन्‍नां लै दैनै मंऐं नैत्तै झिकल़ै</para>
  <para style="q" vid="JOB 31:20">ज़ुंण मंऐं आपणीं भेडे ऊना का हआ तै बणाऐं दै।</para>
  <para style="q" vid="JOB 31:20">तिंयां मणछ बी करा तै दिला का मेरी सर्राफी।<verse eid="JOB 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 31:21" />हुंह निं दालता दी कधि छ़ुटै-मुक्‍कै दै लान्हैं च़िक्‍कदअ उझ़ुअ</para>
  <para style="q" vid="JOB 31:21">कि पांच़ बी आसा मेरै पक्षा लै।<verse eid="JOB 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 31:22" />तै लोल़ी मेरी बाह चुटी अर</para>
  <para style="q" vid="JOB 31:22">सह लोल़ी घंफरा का धरनीं अल़ी।<verse eid="JOB 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 31:23" />हुंह डरा परमेशरे सज़ा का,</para>
  <para style="q" vid="JOB 31:23">इहै काम निं हुंह कधि करी ई सकदअ त।<verse eid="JOB 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 31:24" />हुंह निं कधि सुन्‍नैं-च़ंदीए आसरै रहंदअ त,<verse eid="JOB 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 31:25" />नां मुंह आपणैं सेठ हणैंओ घमंड आथी त कि</para>
  <para style="q" vid="JOB 31:25">मुखा आसा खास्सी ज़ैदात।<verse eid="JOB 31:25" /></para>
  <para style="q">
    <verse number="26-27" style="v" sid="JOB 31:26-27" />मंऐं निं कधि सरगै सुरज़ अर</para>
  <para style="q" vid="JOB 31:26-27">ज़ोथा भाल़ी तेते पूज़ा किई।<verse eid="JOB 31:26-27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 31:28" />ज़ै हुंह इहअ करदअ, तै लोल़ी ती मुंह एते सज़ा भेटी,</para>
  <para style="q" vid="JOB 31:28">किल्हैकि एतो मतलब हुअ इहअ कि</para>
  <para style="q" vid="JOB 31:28">मंऐं छ़ाडअ परम प्रधान परमेशरो अदर करनअ।<verse eid="JOB 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 31:29" />हुंह निं कधू आपणैं दुशमणे बरैबादी लै बी खुश हुअ,</para>
  <para style="q" vid="JOB 31:29">नां हुंह कधू तिन्‍नां लै आफ़त पल़ी भाल़ी राज्ज़ी हुअ।<verse eid="JOB 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 31:30" />नां मंऐं इहअ पाप किअ कि</para>
  <para style="q" vid="JOB 31:30">मंऐं बाही बिधाता सेटा एही कारी कि तिंयां लोल़ी मूंऐं।<verse eid="JOB 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 31:31" />मेरै काम करनै आसा सोभ ऐहा गल्‍ले शाजत कि</para>
  <para style="q" vid="JOB 31:31">मेरै घअरा का निं कोहै मणछ भुखअ डेऊअ आथी।<verse eid="JOB 31:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 31:32" />हांढदै-फिरदै पाखलै मणछ बी आणै मंऐं आपणैं घअरा लै ताकि</para>
  <para style="q" vid="JOB 31:32">तिन्‍नां बागै शेल़ै-ठांढै निं पल़े रहणअ।<verse eid="JOB 31:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 31:33" />मंऐं निं होरी आदमी ज़िहअ किअ, ज़ुंण पाप करी टवारअ करा।<verse eid="JOB 31:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 31:34" />हुंह निं कधि डरअ कि लोगा किज़ै बोल़णअ,</para>
  <para style="q" vid="JOB 31:34">हुंह निं पांडा भितरी च़ुप्पी बेशी रहअ</para>
  <para style="q" vid="JOB 31:34">कि लोगा करनअ मेरअ सुहांग।<verse eid="JOB 31:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 31:35" />मेरी गल्‍ला शुणनै आल़अ कोहै निं आथी?</para>
  <para style="q" vid="JOB 31:35">हुंह काढा सोह कि मेरै हरेक बैण आसा शुचै।</para>
  <para style="q" vid="JOB 31:35">परमेशर ज़हा का सारअ बल आसा, तेऊ लोल़ी त मेरी गल्‍लो ज़बाब दैनअ।</para>
  <para style="q" vid="JOB 31:35">ज़ै तेऊ का मेरै खलाफ किज़ै दोश होए बी</para>
  <para style="q" vid="JOB 31:35">सह लोल़ी त तेऊ लिखी दैनअ ताकि हुंह तेता भाल़ी सकूं,<verse eid="JOB 31:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 31:36" />तेता डाहूं हुंह आपणीं कान्हा च़की ताकि सोभी का शुझिए,</para>
  <para style="q" vid="JOB 31:36">तेता बणाऊं हुंह साफै ज़ेही आपणैं मुंडे शोभा।<verse eid="JOB 31:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 31:37" />मुंह खोज़णीं ती परमेशरा का पठी गल्‍ला कि मंऐं किज़ै-किज़ै किअ।</para>
  <para style="q" vid="JOB 31:37">तेऊ सेटा डेऊणअ त मुंह सैणैं ज़िहअ बाझ़ी डरै।<verse eid="JOB 31:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 31:38" />ज़ै मंऐं ज़िम्मींए घाल़ च़ोरी डाही होए,</para>
  <para style="q" vid="JOB 31:38">अर घाल़ी बऊंणैं आल़ैओ हक मारअ होए,<verse eid="JOB 31:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 31:39" />ज़ै मंऐं तैहा ज़िम्मीं का ढब्बै मज़दूरी नांईं दैई फसल खाई होए</para>
  <para style="q" vid="JOB 31:39">अर मालक भुखै मारै होए,<verse eid="JOB 31:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 31:40" />तै लोल़ी मेरै खेचै ज़ौआ कणके बदल़ै</para>
  <para style="q" vid="JOB 31:40">सिधै झ़िंझ़रअ अर छ़ैण-छ़णिथू ई पज़ै!”</para>
  <para style="q" vid="JOB 31:40">इहअ बोली मुक्‍कअ आयूब गल्‍ला करी।<verse eid="JOB 31:40" /></para>
  <chapter eid="JOB 31" />
  <chapter number="32" style="c" sid="JOB 32" />
  <para style="s">एलीहू बोलअ इहअ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1" />तेखअ छ़ुटी एलीपज, बिल्दाद अर सोपरा का छ़ाड़ अर तिन्‍नैं निं आयूबा लै ज़बाब दैणें कोशिश किई किल्हैकि आयूब त निहंचै कि सह आसा पठी नर्दोश।<verse eid="JOB 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOB 32:2" />तिधी त बारकेलो<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">बारकेलो </char><char style="ft" closed="false">परमेशरै दैनी बर्गत</char></note> शोहरू एलीहू<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">एलीहू </char><char style="ft" closed="false">मतलब सह मेरअ परमेशर</char></note> ज़ुंण बूज़ खिंबा का रामे<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">रामे </char><char style="ft" closed="false">मतलब बडअ, उछ़टअ</char></note> टोली का थिअ। तेऊए निं रोश्श ज़िर्हुऐ, किल्हैकि आयूबै लाई सारी गलती परमेशरा लै अर आप्पू फिरअ पठी नर्दोश। <verse eid="JOB 32:2" /><verse number="3" style="v" sid="JOB 32:3" />आयूबे तिन्‍नां चिई साथी लै बी आई तेऊ खास्सी रोश्शै, किल्हैकि तिंयां निं आयूबा लै ज़बाब दैई बोल़ै, तिहअ करै लागी परमेशरा लै गलती। <verse eid="JOB 32:3" /><verse number="4" style="v" sid="JOB 32:4" />किल्हैकि एलीहू त तिन्‍नां चिई का अमरा होछ़अ, सह थिअ न्हैल़अ लागअ द कि आयूब लोल़ी सोभै गल्‍ला करी मुक्‍कअ। <verse eid="JOB 32:4" /><verse number="5" style="v" sid="JOB 32:5" />ज़ांऊं एलीहू भाल़अ कि तिंयां चिही निस्सी आयूबा लै समझ़ पल़ी कि किज़ै ज़बाब दैणअ, तेऊ आई रोश्शै <verse eid="JOB 32:5" /><verse number="6" style="v" sid="JOB 32:6" />संघा लागअ बारकेलो एलीहू इहअ बोल्दअ,</para>
  <para style="sp" vid="JOB 32:6">एलीहू</para>
  <para style="q" vid="JOB 32:6">“तम्हैं आसा प्रोढै अर हुंह आसा तम्हां का</para>
  <para style="q" vid="JOB 32:6">अमरा खास्सअ होछ़अ,</para>
  <para style="q" vid="JOB 32:6">तैहा ल्हैज़ी निं मंऐं तम्हां का आजी आपणैं बच़ार खोज़ै।<verse eid="JOB 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 32:7" />हुंह सोठा त इहअ कि प्रोढै आदमी लागा गल्‍ला लै आजू डाहणैं</para>
  <para style="q" vid="JOB 32:7">ताकि तिंयां होरी का अक्ल खोज़े।<verse eid="JOB 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 32:8" />पर मणछा दी आसा परमेशरे आत्मां आप्पै</para>
  <para style="q" vid="JOB 32:8">परमेशर ज़हा का सारअ बल आसा तेऊओ शाह दैआ हाम्हां लै समझ़।<verse eid="JOB 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 32:9" />सिधअ बडी अमरे हई बी निं अक्ल एछदी अर</para>
  <para style="q" vid="JOB 32:9">प्रोढै बी निं कई बारी नसाफ समझ़ी सकदै।<verse eid="JOB 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 32:10" />ऐबै शूणां तम्हैं मेरी,</para>
  <para style="q" vid="JOB 32:10">हुंह खोज़ूं तम्हां का मेरी राऐ।<verse eid="JOB 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 32:11" />हुंह त थारी गल्‍ला राम्बल़ै करै शूणअ लागा द कि तम्हां केही गल्‍ला करनी,</para>
  <para style="q" vid="JOB 32:11">हुंह त न्हैल़अ लागअ द कि तम्हां आयूबा लै किहअ ज़बाब दैणअ।<verse eid="JOB 32:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 32:12" />हुंह त राम्बल़ै करै शूणअ लागअ द,</para>
  <para style="q" vid="JOB 32:12">पर तम्हां मांझ़ै निं एकी बी राम्बल़अ ज़बाब दैनअ,</para>
  <para style="q" vid="JOB 32:12">ज़ुंण आयूबे गल्‍ला काटी सके!<verse eid="JOB 32:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 32:13" />तम्हैं किहअ करै सका बोली तम्हां गई अक्ल भेटी?</para>
  <para style="q" vid="JOB 32:13">तेऊए गल्‍लो ज़बाब दैणअ परमेशरा आप्पै, तम्हैं निं आयूबा का गल्‍ला लै ज़िती बोल़ै।<verse eid="JOB 32:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 32:14" />आयूबै निं मुल्है किछ़ै बोलअ,</para>
  <para style="q" vid="JOB 32:14">सह थिअ तम्हां लै लागअ द बोल्दअ,</para>
  <para style="q" vid="JOB 32:14">पर हुंह निं एऊ लै तम्हां ज़िहअ ज़बाब दैंदअ।<verse eid="JOB 32:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 32:15" />आयूब, ऐबै निं इना चिही समझ़ पल़ी कि</para>
  <para style="q" vid="JOB 32:15">ताल्है किज़ै ज़बाब दैणअ।<verse eid="JOB 32:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 32:16" />ऐबै आसा ईंयां च़ुप्पी खल़्हुऐ दै, हुंह कै न्हैल़अ रहूं लागी?</para>
  <para style="q" vid="JOB 32:16">ईंयां ता ऐबै खाखा बैण निस्सै काढी?<verse eid="JOB 32:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 32:17" />मुंह लणअ ताल्है ज़बाब दैई खोज़ी कि हुंह कै सोठा।<verse eid="JOB 32:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 32:18" />मुखा आसा बोल़णा लै खास्सी गल्‍ला,</para>
  <para style="q" vid="JOB 32:18">हुंह निं बोल़णैं बाझ़ी रही सकदअ।<verse eid="JOB 32:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 32:19" />मुंह आसा भितरा का बोल़णा लै बुआल़ लागै दै, ज़ै हुंह नांईं बोलूं,</para>
  <para style="q" vid="JOB 32:19">हुंह च़ाल्‍लअ नऊंऐं दाखे रसा करै भरै दै पराणैं खाल्हल़ै ज़िहअ फुटी।<verse eid="JOB 32:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 32:20" />मुंह हुअ बोल़णअ ताकि मुंह शांती भेटे।<verse eid="JOB 32:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 32:21" />मुंह नां आपणीं गल्‍ला करै कहा मणछो पक्ष लणअ अर</para>
  <para style="q" vid="JOB 32:21">नां मुंह कहा आर्ही सराहंदै लागणअ।<verse eid="JOB 32:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 32:22" />किल्हैकि मुंह निं च़ोपल़ लागी गल्‍ला करनी एछदी,</para>
  <para style="q" vid="JOB 32:22">नांईं ता परमेशरा हेरनी ती मुल्है तेभी सज़ा दैई।”<verse eid="JOB 32:22" /></para>
  <chapter eid="JOB 32" />
  <chapter number="33" style="c" sid="JOB 33" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 33:1" />“आयूब, ऐबै शुण धैन दैई</para>
  <para style="q" vid="JOB 33:1">सोभी गल्‍ला ज़ुंण मंऐं बोली लाई।<verse eid="JOB 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 33:2" />ऐबै लाअ मंऐं खोज़ी कि मेरै मन्‍नैं किज़ै आसा।<verse eid="JOB 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 33:3" />हुंह करा सिधी सांऊंई गल्‍ला,</para>
  <para style="q" vid="JOB 33:3">तेथ निं हुंह किछ़ै हेर-फेर करदअ।<verse eid="JOB 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 33:4" />सह परमेशर ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 33:4">तेऊए ई शाह करै आसा मुंह ज़िन्दगी भेटी दी।<verse eid="JOB 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 33:5" />ज़ै ताखा होए, तै लऐ तूह मुल्है ज़बाब दैई,</para>
  <para style="q" vid="JOB 33:5">मुंह संघै हठ करना लै लऐ तूह आपणीं गल्‍ला तही-जोखी।<verse eid="JOB 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 33:6" />परमेशरा सेटा आसा हुंह अर तूह दुहै एक्‍कै ज़िहै,</para>
  <para style="q" vid="JOB 33:6">हाम्हैं आसा तेऊ दुहै माट्टी का बणाऐं दै।<verse eid="JOB 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 33:7" />ताह निं मुखा डरने ज़रुरत आथी,</para>
  <para style="q" vid="JOB 33:7">हुंह निं तेरअ बरोध करै ताह छेऊंदअ आथी आअ द।<verse eid="JOB 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 33:8" />हुंह त शूणअ लागअ द ज़ुंण तंऐं इहअ बोलअ,<verse eid="JOB 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 33:9" />‘मेरअ निं किछ़ै कशूर आथी, मंऐं निं किछ़ै गलती किई।</para>
  <para style="q" vid="JOB 33:9">मंऐं निं किछ़ै पाप किअ आथी।<verse eid="JOB 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 33:10" />परमेशर हआ मुंह संघै हठल़णा लै किज़ू नां किज़ू भान्‍नै लोल़अ लागअ द,</para>
  <para style="q" vid="JOB 33:10">सह करा मुंह संघै दुशमणा ज़िहअ बभार।<verse eid="JOB 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 33:11" />तंऐं डाहै मेरै खूर शांघल़ी करे काठा दी बान्हीं,</para>
  <para style="q" vid="JOB 33:11">संघा रहा तूह हर घल़ी मुंह भाल़अ लागी।’<verse eid="JOB 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 33:12" />पर आयूब, हुंह बोला ऐहा गल्‍ला लै आसा तूह गलत,</para>
  <para style="q" vid="JOB 33:12">परमेशर आसा सोभी मणछा का महान।<verse eid="JOB 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 33:13" />तूह किल्है लाआ परमेशरा लै इहअ दोश कि सह निं म्हारी</para>
  <para style="q" vid="JOB 33:13">खरी अर गल्‍लो ज़बाब दैंदअ?<verse eid="JOB 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 33:14" />परमेशर रहा भिई-भिई पै बोल्दअ लागी,</para>
  <para style="q" vid="JOB 33:14">पर लोग निं तेऊए गल्‍ला दी धैन दैंदै।<verse eid="JOB 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 33:15" />राची करा परमेशर सुपनै एछी गल्‍ला,</para>
  <para style="q" vid="JOB 33:15">ज़ेभै मणछ घणीं निंजा दी हआ सुत्तै दै।<verse eid="JOB 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 33:16" />सह करा इहअ कि तिन्‍नां का तेऊए गल्‍ला कानै शुण्हिंए,</para>
  <para style="q" vid="JOB 33:16">तिन्‍नां छ़ुटा तेऊए चतैनगी शूणीं दर्छ़णअ।<verse eid="JOB 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 33:17" />परमेशर करा एते तैणीं गल्‍ला कि तिंयां मणछ पाप करनअ छ़ाडे</para>
  <para style="q" vid="JOB 33:17">अर तिंयां घमंडी हणैं का बच़े।<verse eid="JOB 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 33:18" />सह निं तिन्‍नां बरैबाद हणैं दैंदअ,</para>
  <para style="q" vid="JOB 33:18">इधी तैणीं कि सह बच़ाऊआ तिन्‍नां मौता का।<verse eid="JOB 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 33:19" />परमेशर नैरा हाम्हां रोग दैई</para>
  <para style="q" vid="JOB 33:19">अर देही दी दाहे झोशा झ़ैऊई।<verse eid="JOB 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 33:20" />ज़ुंण रोगी हआ, तिन्‍नों निं रोटी खाणां लै बी ज़िऊ बोल्दअ,</para>
  <para style="q" vid="JOB 33:20">बधिया का बधिया खाणैं-पिणैं का बी फिरा तिन्‍नां च़िल़्ह।<verse eid="JOB 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 33:21" />तिंयां हआ च़ार काठ शुक्‍कै अर</para>
  <para style="q" vid="JOB 33:21">तिन्‍नें लागा हाडकै अर गल़ा बाती पाणीं शुझदअ।<verse eid="JOB 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 33:22" />तिन्‍नें एछा मर्हुई अर</para>
  <para style="q" vid="JOB 33:22">तिन्‍नें ज़िन्दगी हआ जम्परीए बशै।<verse eid="JOB 33:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 33:23" />हई सका कि तिन्‍नां मणछे मज़त करना लै कुंण स्वर्ग दूत एछे,</para>
  <para style="q" vid="JOB 33:23">सह हणअ परमेशरे हज़ारो स्वर्ग दूता मांझ़ै कुंण एक,</para>
  <para style="q" vid="JOB 33:23">ज़हा हाम्हां का आद फरेऊंणी कि म्हारअ असली काम किज़ै आसा।<verse eid="JOB 33:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 33:24" />तेऊ स्वर्ग दूता फिरनी झींण संघा बोल़णअ इहअ,</para>
  <para style="q" vid="JOB 33:24">‘परमेशर, एऊ बच़ाऊ जम्परी डेऊणैं का,</para>
  <para style="q" vid="JOB 33:24">मुंह भेटी एऊ आज़ाद करने बात।’<verse eid="JOB 33:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 33:25" />तेखअ हणीं तेऊ मणछे देही होछ़ै लान्हैं ज़ेही नरोगी</para>
  <para style="q" vid="JOB 33:25">अर तेऊ एछणैं भिई ज़ुआनी ज़िहै ज़ोर-ज़ाहण।<verse eid="JOB 33:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 33:26" />ज़ेभै सह मणछ प्राथणां करे, परमेशरा हेरनी तेऊए शूणीं।</para>
  <para style="q" vid="JOB 33:26">तेऊ करनी खुशी-खुशी परमेशरे ज़ै-ज़ैकार,</para>
  <para style="q" vid="JOB 33:26">किल्हैकि तेऊ करनअ सह मणछ सोभी दाह-बमारी का भिई नरोगअ।<verse eid="JOB 33:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 33:27" />तेऊ खोज़णअ सोभी का इहअ,</para>
  <para style="q" vid="JOB 33:27">‘मंऐं किअ पाप अर हुंह त सत्ता का कबाता पेठअ द,</para>
  <para style="q" vid="JOB 33:27">पर परमेशरै निं मुल्है तेते सज़ा दैनी</para>
  <para style="q" vid="JOB 33:27">ज़ुंण मुंह भुगतणी पल़णीं ती।<verse eid="JOB 33:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 33:28" />तेऊ बच़ाऊअ हुंह जम्परी का अर</para>
  <para style="q" vid="JOB 33:28">हुंह आसा ज़िऊंदअ राज्ज़ी-राम्बल़अ।’<verse eid="JOB 33:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 33:29" />इहै काम करा परमेशर भिई-भिई,<verse eid="JOB 33:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 33:30" />अर हर बारी बच़ाऊआ परमेशर तेऊ मणछे ज़िन्दगी जम्परी का,</para>
  <para style="q" vid="JOB 33:30">ताकि तेऊ मणछा ज़िन्दगी ज़िऊंणें खुशी भेटे।<verse eid="JOB 33:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 33:31" />आयूब, ऐबै शुण मेरी गल्‍ला धैन दैई,</para>
  <para style="q" vid="JOB 33:31">तूह रहै च़ुपच़ाप मेरी गल्‍ला शूणअ लागी।<verse eid="JOB 33:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 33:32" />ज़ै ताह किज़ै बोल़णअ रहअ तै लअ बोली, हुंह लऊं तेता शूणीं</para>
  <para style="q" vid="JOB 33:32">हुंह च़ाहा ऐहा गल्‍ला पाक्‍की करनअ कि तेरअ निं किछ़ै कशूर आथी।<verse eid="JOB 33:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 33:33" />ज़ै नांईं, तै लाग च़ुपच़ाप मेरी गल्‍ला शूणअ,</para>
  <para style="q" vid="JOB 33:33">हुंह खोज़ूं ताखा कि किहअ करै हणअ अक्ली आल़ै।”<verse eid="JOB 33:33" /></para>
  <chapter eid="JOB 33" />
  <chapter number="34" style="c" sid="JOB 34" />
  <para style="s">तेरै ईंयां साथी आसा च़लाक</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 34:1" />एलीहू लागअ आजू इहअ बोल्दअ,<verse eid="JOB 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 34:2" />“तम्हैं खास्सै अक्ली आल़ै ज्ञैनी मणछ</para>
  <para style="q" vid="JOB 34:2">शूणां मेरी गल्‍ला धैन दैई।<verse eid="JOB 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 34:3" />ज़ेही ज़िभ सुआद परखा,</para>
  <para style="q" vid="JOB 34:3">तिहै हआ कान गल्‍ला परखणां लै।<verse eid="JOB 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 34:4" />अह हआ म्हारी आपणीं समझ़ कि</para>
  <para style="q" vid="JOB 34:4">हाम्हैं परमेशरा संघै किज़ै हठ करा।<verse eid="JOB 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 34:5" />आयूब बोला इहअ कि एऊओ निं किछ़ै कशूर आथी,</para>
  <para style="q" vid="JOB 34:5">परमेशर निं एऊओ नसाफ बोल़अ करी।<verse eid="JOB 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 34:6" />अह बोला इहअ, ‘सह हणीं झ़ुठी गल्‍ल ज़ै हुंह</para>
  <para style="q" vid="JOB 34:6">इहअ बोलूं कि मेरअ आसा किज़ै कशूर,</para>
  <para style="q" vid="JOB 34:6">मेरी निं गलती ई आथी, तज़ी बी पाऐ</para>
  <para style="q" vid="JOB 34:6">परमेशरै मुल्है इहै डुघै ज़खम कि मेरै च़ाल्‍लअ मर्हुई।’<verse eid="JOB 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 34:7" />अह आयूब आसा किहअ मणछ?</para>
  <para style="q" vid="JOB 34:7">एऊ लै आसा परमेशरे निंदा करनी पाणींओ घुप्पू झुटणअ।<verse eid="JOB 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 34:8" />अह डाहा कदुष्ट मणछा संघै संगत अर</para>
  <para style="q" vid="JOB 34:8">एऊओ ज़िऊंण बी आसा पापी मणछा ई ज़िहअ।<verse eid="JOB 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 34:9" />अह बोला इहअ कि परमेशरे साबै ज़िन्दगी ज़िऊई करै निं</para>
  <para style="q" vid="JOB 34:9">मणछा किछ़ै फाईदअ हंदअ!<verse eid="JOB 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 34:10" />तैही बोला हुंह, ज़हा समझ़ होए सह शूणां मेरी गल्‍ला!</para>
  <para style="q" vid="JOB 34:10">इहअ निं हई ई सकदअ परमेशर गलती करे</para>
  <para style="q" vid="JOB 34:10">अर नां सह कधू बूरअ करी करदअ।<verse eid="JOB 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 34:11" />सह दैआ मणछे कर्मे साबै तेतो फल ज़रूर</para>
  <para style="q" vid="JOB 34:11">सोभी मणछा लागा तिन्‍नें कर्मो फल भुगतणअ।<verse eid="JOB 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 34:12" />परमेशर ज़हा का सारअ बल आसा, सह निं बूरअ करी ई सकदअ,</para>
  <para style="q" vid="JOB 34:12">नां सह कहा लै पक्षपात करदअ।<verse eid="JOB 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 34:13" />परमेशरा लै शगती दैणैं आल़अ कै कुंण होर आसा?</para>
  <para style="q" vid="JOB 34:13">कि संसारो इंतज़ाम कुंणी होरी आसा तेऊ का सभाल़अ द?<verse eid="JOB 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 34:14" />ज़ै परमेशर ज़िन्दगी दैणैं आल़अ शाह बापस काढे,<verse eid="JOB 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 34:15" />तेखअ हणैं सोभै ज़ीब खतम</para>
  <para style="q" vid="JOB 34:15">संघा डेऊणैं सोभै मणछ भिई माट्टी जैंदरी।<verse eid="JOB 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 34:16" />ज़ै ताह समझ़ आसा, तै शुण मेरी गल्‍ला धैन दैई।<verse eid="JOB 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 34:17" />तूह तेऊ महान धर्मीं परमेशरा लै फिरा खोट काढदअ?</para>
  <para style="q" vid="JOB 34:17">तूह कै सोठा तेऊओ नसाफ शुचअ आथी निं?<verse eid="JOB 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 34:18" />परमेशर बोला सोभी राज़ै लै बी, ‘तम्हैं आसा कदुष्ट,’</para>
  <para style="q" vid="JOB 34:18">पांच़ा लै बोला इहअ, ‘तम्हैं करा पक्षपात।’<verse eid="JOB 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 34:19" />सह निं कार-करिंदैओ पक्ष लंदअ,</para>
  <para style="q" vid="JOB 34:19">नां सह सेठ अर दाल़जी दी भेदभाब करदअ</para>
  <para style="q" vid="JOB 34:19">किल्हैकि सोभै आसा तेऊ ई बणाऐं दै।<note caller="-" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="JAS 2:1">याक. 2:1</ref>; <ref loc="ROM 2:11">रोम. 2:11</ref>; <ref loc="PRO 22:2">सैणीं. 22:2</ref></char></note><verse eid="JOB 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 34:20" />हाम्हैं सका आधी राची बी कज़ेभल़ी मरी।</para>
  <para style="q" vid="JOB 34:20">परमेशर पाआ मणछा लै मार अर हाम्हैं हआ खतम!</para>
  <para style="q" vid="JOB 34:20">बडै-बडै प्रतप्पी राज़ै मारना लै तोही निं तेऊओ धख ज़िहअ ज़ोर बी लागदअ।<verse eid="JOB 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 34:21" />परमेशर हआ हाम्हां मणछा भाल़अ लागअ द</para>
  <para style="q" vid="JOB 34:21">कि हाम्हैं किज़ै-किज़ै करा अर केही ज़िन्दगी ज़िऊआ।<verse eid="JOB 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 34:22" />च़ाऐ ज़िहअ बी नटिप्प न्हैरअ किल्है निं होए,</para>
  <para style="q" vid="JOB 34:22">तेथ बी निं पापी मणछ लुक्‍की सकदै।<verse eid="JOB 34:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 34:23" />परमेशरै निं कोही मणछा लै इहअ पाक्‍कअ बगत आथी डाहअ द</para>
  <para style="q" vid="JOB 34:23">कि हाम्हैं तेभै तेऊ सेटा डेओए अर सह म्हारअ नसाफ करे।<verse eid="JOB 34:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 34:24" />तेऊ निं बडै-बडै जोधै पदबी का दूर करना लै अर</para>
  <para style="q" vid="JOB 34:24">कहा होरी तैहा पदबी दी बशैल़णा लै</para>
  <para style="q" vid="JOB 34:24">कोही का ज़ाज़त लागदी लणी।<verse eid="JOB 34:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 34:25" />किल्हैकि परमेशरा का आसा तिन्‍नें सोभी कामों थोघ,</para>
  <para style="q" vid="JOB 34:25">सह पल़ा राची तिन्‍नां लै चुटी संघा करा तिन्‍नां ज़ातै का खतम।<verse eid="JOB 34:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 34:26" />सह दैआ पापी लै एही ज़ैगा सज़ा,</para>
  <para style="q" vid="JOB 34:26">ज़िधी सोभै लोग तिन्‍नां भाल़ै होए लागै दै,<verse eid="JOB 34:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 34:27" />किल्हैकि तिन्‍नैं छ़ाडी तेऊ परमेशरे साबै ज़िन्दगी ज़िऊंणीं</para>
  <para style="q" vid="JOB 34:27">अर तिन्‍नैं निं तेऊए हुकम मनै।<verse eid="JOB 34:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 34:28" />तिन्‍नैं छेऊऐ रैनै-गरीब इहै कि</para>
  <para style="q" vid="JOB 34:28">तिंयां लागै कारी बाही परमेशरा का मज़त मांगदै</para>
  <para style="q" vid="JOB 34:28">अर परमेशरै शूणीं तिन्‍नें लेर-पकार।<verse eid="JOB 34:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 34:29" />ज़ै परमेशर च़ाहे कि तेऊ निं किछ़ै करनअ,</para>
  <para style="q" vid="JOB 34:29">तेऊ लै निं तेखअ कोह लोग बोली सकदै।</para>
  <para style="q" vid="JOB 34:29">ज़ै सह पिठ फरेऊई हेरे, तेखअ निं तेऊ कोह मणछ भाल़ी सकदअ।<verse eid="JOB 34:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 34:30" />सह निं पापी मणछा राज़ करनै दैंदअ ताकि</para>
  <para style="q" vid="JOB 34:30">तिंयां लोगा छेऊई नां सके।<verse eid="JOB 34:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 34:31" />आयूब, तंऐं कधू परमेशरा सेटा मनअ बी,</para>
  <para style="q" vid="JOB 34:31">‘मेरै भलै हुअ पाप अर आजू निं</para>
  <para style="q" vid="JOB 34:31">हुंह भिई पाप करदअ?’<verse eid="JOB 34:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 34:32" />कधू इहअ पुछ़अ,</para>
  <para style="q" vid="JOB 34:32">‘हे परमेशर मुखा खोज़ मंऐं किज़ै गलती किई?</para>
  <para style="q" vid="JOB 34:32">तै लागणअ मुखा थोघ कि इहअ काम आसा गलत, सह निं लागा मुंह करनअ?’<verse eid="JOB 34:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 34:33" />ज़ुंण काम परमेशर करा, तेता, तूह मंदअ ई निं आथी,</para>
  <para style="q" vid="JOB 34:33">तेखअ बी कै तूह एही आशा डाह कि</para>
  <para style="q" vid="JOB 34:33">तेऊ करनअ तिहअ ज़िहअ तूह च़ाहा?</para>
  <para style="q" vid="JOB 34:33">ऐहा गल्‍लो फैंसलअ हुअ ताह करनअ नां कि मुंह,</para>
  <para style="q" vid="JOB 34:33">ओर्ही खोज़ हाम्हां का तेरअ किज़ै बच़ार आसा।<verse eid="JOB 34:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 34:34" />समझ़कार मणछा जाणै मनी अर</para>
  <para style="q" vid="JOB 34:34">अक्ली आल़ै मणछा बी बोल़णअ मेरी गल्‍ला शूणीं<verse eid="JOB 34:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 34:35" />कि आयूबा निं गल्‍ला करने समझ़ ई आथी,</para>
  <para style="q" vid="JOB 34:35">सह डाहा नथोघी गल्‍ला लाई।<verse eid="JOB 34:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 34:36" />ज़ै आयूबै बोली दी सारी गल्‍ला भाल़णीं,</para>
  <para style="q" vid="JOB 34:36">तेता का लागा थोघ कि आयूबे गल्‍ला आसा कदुष्ट मणछा ज़ेही।<verse eid="JOB 34:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 34:37" />पाप, हुअ पर तेऊ किअ परमेशरा लै द्रोह बी!</para>
  <para style="q" vid="JOB 34:37">सह करा हाम्हां सोभी नदरी परमेशरो सुहांग।”<verse eid="JOB 34:37" /></para>
  <chapter eid="JOB 34" />
  <chapter number="35" style="c" sid="JOB 35" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 35:1" />एलीहू रहअ बोल्दअ लागी,<verse eid="JOB 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 35:2" />“आयूब, तेरअ इहअ बोल़णअ आसा गलत कि</para>
  <para style="q" vid="JOB 35:2">तूह आसा परमेशरा संघै धर्मीं।<verse eid="JOB 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 35:3" />ज़ुंण तूह परमेशरा लै इहअ बोला, ‘मेरै पापा करै ताह किज़ै फरक पल़ा?</para>
  <para style="q" vid="JOB 35:3">मेरै पाप नांईं करनै करै मुंह किज़ै फाईदअ भेटअ?’<verse eid="JOB 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 35:4" />एतो ज़बाब लाअ मंऐं ताल्है अर</para>
  <para style="q" vid="JOB 35:4">तेरै साथी लै कठा दैई।<verse eid="JOB 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 35:5" />उझै दै सरगा बाखा लै भाल़णीं!</para>
  <para style="q" vid="JOB 35:5">भाल़ बादल़ केतरै उछ़टै आसा!<verse eid="JOB 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 35:6" />ज़ै तूह पाप करे, तेता करै निं परमेशरा किछ़ै हान्‍नी हंदी।</para>
  <para style="q" vid="JOB 35:6">ज़ै तूह भिई-भिई बी रहे पाप करदअ लागी,</para>
  <para style="q" vid="JOB 35:6">तेता करै कै परमेशरा किज़ै फरक च़ाल्‍लअ पल़ी?<verse eid="JOB 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 35:7" />ज़ै तूह खास्सअ धर्मीं बी होए, तेता करै तंऐं परमेशरा लै किज़ै सान लाई?</para>
  <para style="q" vid="JOB 35:7">परमेशर निं ताखा किछ़ै मांगदअ आथी।<verse eid="JOB 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 35:8" />तेरै पापा करै पल़ा मणछा फरक ज़ुंण ताह ई ज़िहै आसा</para>
  <para style="q" vid="JOB 35:8">अर तेरै भलै करनै करै हआ तिन्‍नें मज़त।<verse eid="JOB 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 35:9" />ज़ै लोग ऐन छेऊऐ, तै पाआ तिंयां लैल़ा-पकारा,</para>
  <para style="q" vid="JOB 35:9">तिंयां मांगा कहा इहै का मज़त ज़ुंण तिन्‍नां बच़ाऊई सके।<verse eid="JOB 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 35:10" />पर तज़ी बी निं तिंयां तेऊ परमेशरा लोल़दै आथी</para>
  <para style="q" vid="JOB 35:10">ज़ुंणी तिंयां बणाऐं दै आसा अर</para>
  <para style="q" vid="JOB 35:10">ज़ुंण तिन्‍नां लै आफ़तीए बगती बी खुशीए गिहा दैआ बोल़णैं।<verse eid="JOB 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 35:11" />तिंयां निं तेऊ परमेशरा बाखा फिरदै ज़ुंण तिन्‍नां लै अक्ल दैआ अर</para>
  <para style="q" vid="JOB 35:11">च़ेल्‍लू-पखीरू अर पशू का खास्सी समझ़ दैआ।<verse eid="JOB 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 35:12" />तिंयां पाआ लेर-पकार पर परमेशर निं तिन्‍नां लै ज़बाब दैंदअ</para>
  <para style="q" vid="JOB 35:12">किल्हैकि तिंयां आसा घमंडी अर कदुष्ट।<verse eid="JOB 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 35:13" />पर इहअ बोल़णअ बी आसा गलत कि परमेशर ज़हा का सारअ बल आसा, सह निं तिन्‍नें शुणदअ अर</para>
  <para style="q" vid="JOB 35:13">परमेशर निं तिन्‍नां बाखा धैन ई दैंदअ।<verse eid="JOB 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 35:14" />आयूब, तूह बोला इहअ कि ताखा निं परमेशर शुझदअ ई आथी,</para>
  <para style="q" vid="JOB 35:14">पर तेऊ हेरनअ तेरअ नसाफ करी</para>
  <para style="q" vid="JOB 35:14">ज़ै तूह सबर डाही न्हैल़ी बोल़े।<verse eid="JOB 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 35:15" />तूह सोठा इहअ कि परमेशर निं सज़ा दैंदअ अर</para>
  <para style="q" vid="JOB 35:15">सह निं पापा बाखा खास्सअ धैन दैंदअ।<verse eid="JOB 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 35:16" />तैही करा तूह एही नथोघी गल्‍ला,</para>
  <para style="q" vid="JOB 35:16">ताखा निं आप्पू ई थोघ लागदअ कि तूह किज़ै बोला।”<verse eid="JOB 35:16" /></para>
  <chapter eid="JOB 35" />
  <chapter number="36" style="c" sid="JOB 36" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 36:1" />तेखअ बोलअ आजू एलीहू इहअ,<verse eid="JOB 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 36:2" />“आयूब, सबर कर, हुंह खोज़ूं ताखा सत्त किज़ै आसा।</para>
  <para style="q" vid="JOB 36:2">हुंह निं अज़ी परमेशरे पक्षा दी गल्‍ला करी मुक्‍कअ।<verse eid="JOB 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 36:3" />मुखा आसा अज़ी बतेर्हअ ज्ञैन,</para>
  <para style="q" vid="JOB 36:3">तेता ताखा खोज़ी करूं हुंह ऐहा गल्‍ला प्रगट कि ज़ुंणी परमेशरै हुंह</para>
  <para style="q" vid="JOB 36:3">बणाअं द आसा, सह आसा शुचअ।<verse eid="JOB 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 36:4" />मुंह खोज़णअ सत्त, झ़ुठी गल्‍ला निं हुंह करदअ,</para>
  <para style="q" vid="JOB 36:4">एभै आसा ताल्है सह बोल्दअ लागअ द ज़हा का ज्ञैन ई ज्ञैन आसा।<verse eid="JOB 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 36:5" />परमेशरा का आसा सारअ बल!</para>
  <para style="q" vid="JOB 36:5">सह निं कोही बृथा समझ़दअ,</para>
  <para style="q" vid="JOB 36:5">इहअ निं किछ़ै आथी ज़ेता सह निं समझ़दअ होए।<verse eid="JOB 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 36:6" />कदुष्टा निं सह ज़िऊंणै दैंदअ,</para>
  <para style="q" vid="JOB 36:6">रैनै-गरीबा लै दैआ सह कबल्‍लअ तिन्‍नों हक।<verse eid="JOB 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 36:7" />तेऊ हआ धर्मीं मणछो कबल्‍लअ धैन,</para>
  <para style="q" vid="JOB 36:7">सह दैआ तिन्‍नां राज़ै ज़िहअ राज़ करनै</para>
  <para style="q" vid="JOB 36:7">ताकि तिन्‍नों सदा अदर होए।<verse eid="JOB 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 36:8" />तिंयां च़ाऐ शांघल़ी-लोहै दी कशै दै होए,</para>
  <para style="q" vid="JOB 36:8">अर तिंयां आफ़तीए ज़ज़ाल़ा दी होए शाचै दै,<verse eid="JOB 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 36:9" />परमेशर हेरा तिन्‍नां का खोज़ी कि तिन्‍नां लै इहअ किल्है हुअ अर</para>
  <para style="q" vid="JOB 36:9">सह रहैऊआ तिन्‍नां का तिन्‍नें पाप ज़ेथ तिंयां घमंड करा तै।<verse eid="JOB 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 36:10" />सह फरेऊआ तिन्‍नों धैन आपणीं चतैनगी बाखा लै</para>
  <para style="q" vid="JOB 36:10">ताकि तिंयां बूरै करनै का पिछ़ू हटे।<verse eid="JOB 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 36:11" />ज़ै तिंयां ज़िहअ परमेशर बोला तिहअ ई करे,</para>
  <para style="q" vid="JOB 36:11">तै ज़िऊआ तिंयां आपणीं सारी ज़िन्दगी राज्ज़ी-मौज़ी।<verse eid="JOB 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 36:12" />पर ज़ै तिंयां तिहअ नांईं करै,</para>
  <para style="q" vid="JOB 36:12">तै सका तिन्‍नां कुंण तलबारा करै मारी पाई</para>
  <para style="q" vid="JOB 36:12">अर तिंयां मरनै बेसमझ़ी दी।<verse eid="JOB 36:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 36:13" />पर ज़ुंण परमेशरा दी विश्वास निं डाहंदै, तिंयां रहा रोश्श करदै लागी,</para>
  <para style="q" vid="JOB 36:13">परमेशरा का सज़ा भुगती बी निं तिंयां</para>
  <para style="q" vid="JOB 36:13">तेऊ का मज़त मांगणा लै अरज़ करदै।<verse eid="JOB 36:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 36:14" />आपणीं ज़िन्दगी शर्मिंदगी दी खतम करी</para>
  <para style="q" vid="JOB 36:14">जाआ तिंयां खारकी अमरा मरी।<verse eid="JOB 36:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 36:15" />दुख-तकलिफी करै दैआ परमेशर लोगा लै शिक्षा,</para>
  <para style="q" vid="JOB 36:15">सह दैआ तिन्‍नां लै आफ़त पल़णै कि तिंयां तेऊए शुणें।<verse eid="JOB 36:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 36:16" />आयूब, तेऊ करनी ताखा अह आफ़त दूर,</para>
  <para style="q" vid="JOB 36:16">तूह पजैल़णअ तेऊ एही ज़ैगा</para>
  <para style="q" vid="JOB 36:16">ज़िधी तूह राज्ज़ी-राम्बल़अ रहे,</para>
  <para style="q" vid="JOB 36:16">ताखा हणअ खाणां पिणां लै बधिया का बधिया।<verse eid="JOB 36:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 36:17" />पर एभै आसा तूह आपणैं कर्मे सज़ा भुगतदअ लागअ द,</para>
  <para style="q" vid="JOB 36:17">तेता का निं तूह बच़ी सकदअ।<verse eid="JOB 36:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 36:18" />पर तूह डाहै धैन हेरे, रेशपतै निं लोल़ी तूह कबाता पाअ,</para>
  <para style="q" vid="JOB 36:18">किधी धन-माया ताह बरैबादी बाखा निंए।<verse eid="JOB 36:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 36:19" />तेरी ज़ैदाता करै निं तेरअ किछ़ै भलअ हणअ,</para>
  <para style="q" vid="JOB 36:19">तूह ला च़ाऐ आपणअ सारअ ज़ोर</para>
  <para style="q" vid="JOB 36:19">तेता करै निं तेरी किछ़ै मज़त हणीं।<verse eid="JOB 36:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 36:20" />इहअ बोल कि सह राच निं ताल्है लोल़ी आई</para>
  <para style="q" vid="JOB 36:20">ज़ेभै देशे-देशे लोगा लै प्रल़या एछणी।<verse eid="JOB 36:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 36:21" />तूह डाहै धैन! आप्पू हटै बूरै करनै का पिछ़ू,</para>
  <para style="q" vid="JOB 36:21">एता ई लै ताल्है परमेशरै आफ़त पाई दी</para>
  <para style="q" vid="JOB 36:21">कि तूह बूराई का दूर रहे।<verse eid="JOB 36:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 36:22" />आद कर कि परमेशरा का भाल़ किहअ महान बल आसा,</para>
  <para style="q" vid="JOB 36:22">तेऊ ज़िहअ महान गूरू निं कोहै आथी।<verse eid="JOB 36:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 36:23" />तेऊ लै निं कोहै बोली सकदअ कि किज़ै करनअ,</para>
  <para style="q" vid="JOB 36:23">नां तेऊ लै कुंण इहअ बोली सकदअ कि अह किअ तेऊ गलत।<verse eid="JOB 36:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 36:24" />तेऊए कामां लै हआ सदा ज़ै-ज़ैकार ई,</para>
  <para style="q" vid="JOB 36:24">ताह बी लागा तिहअ ई करनअ।<verse eid="JOB 36:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 36:25" />तेऊए महान काम शुझिआ सोभी का,</para>
  <para style="q" vid="JOB 36:25">पर हाम्हैं मणछ भेटा तिंयां दूरा ई का भाल़णैं।<verse eid="JOB 36:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 36:26" />परमेशरे महान कामें बारै पठी थोघ निं कोही का आथी।</para>
  <para style="q" vid="JOB 36:26">नां कहा का इहअ थोघ आथी कि तेऊए अमर केतरी हुई।<verse eid="JOB 36:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 36:27" />धरना का पाणीं उझै घिशा सह परमेशर ई,</para>
  <para style="q" vid="JOB 36:27">संघा बणाआं तेऊ पाणींए बादल़।<verse eid="JOB 36:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 36:28" />सह बझ़ैल़ा तिन्‍नां बादल़ा का</para>
  <para style="q" vid="JOB 36:28">सोभी मणछा लै सारै दी पाणीं बरशाऊंणै।<verse eid="JOB 36:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 36:29" />एतो थोघ निं कोही का लागदअ कि बादल़ किहअ करै हांढा,</para>
  <para style="q" vid="JOB 36:29">कि सरगै गुल़ूबिज़ल़ू किहअ करै लागा, ज़िधी परमेशर रहा।<verse eid="JOB 36:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 36:30" />सह लाआ सारै सरगै बिज़ल़ीए झ़प्प-तल़प्पी,</para>
  <para style="q" vid="JOB 36:30">पर समुंदरे थाल्‍लै डाहा सह न्हैरअ।<verse eid="JOB 36:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 36:31" />आपणैं इना महान कामां करै धाचा सह देशा-देशे लोगा</para>
  <para style="q" vid="JOB 36:31">संघा दैआ सह तिन्‍नां लै रज्ज़ी साल-फसल।<verse eid="JOB 36:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 36:32" />सह ढाका बीज आपणैं हाथै, संघा शोटा सह</para>
  <para style="q" vid="JOB 36:32">संघा दैआ सह तेता लै तिधी पल़णैओ हुकम ज़िधी सह च़ाहा।<verse eid="JOB 36:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 36:33" />गुल़ूबिज़ल़ू खोज़ा कि परमेशर आसा अर</para>
  <para style="q" vid="JOB 36:33">ढिश-बागरी का जाआ डागै-चैणैं अर बणें ज़ीबा का थोघ लागी कि तेऊ आई रोश्शै।”<verse eid="JOB 36:33" /></para>
  <chapter eid="JOB 36" />
  <chapter number="37" style="c" sid="JOB 37" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 37:1" />“ढिशा भाल़ी लागा मेरअ दिल ज़ोरै-ज़ोरै धुक्‍क-धुक्‍क करदअ,<verse eid="JOB 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 37:2" />तम्हैं सोभै शूणां परमेशरो बोल,</para>
  <para style="q" vid="JOB 37:2">ज़ुंण गुल़ूबिज़ल़ू ज़ेही छ़ेल़ छ़ाडा।<verse eid="JOB 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 37:3" />सह लाआ पृथूई प्रैंदै सारै सरगै,</para>
  <para style="q" vid="JOB 37:3">एकी पुंझ़ा बिज़ल़ीए झ़प्प-तल़प्पी।<verse eid="JOB 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 37:4" />तेखअ शुण्हिंआं तेऊए बोला का निखल़ी दी ढिम्हां-गल़िम्हीं,</para>
  <para style="q" vid="JOB 37:4">बिज़ल़ी डाहा कबल्‍ली झ़प्प-तल़प्पी लाई।<verse eid="JOB 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 37:5" />परमेशर दैआ नुआहरी गल्‍ला हणैंओ हुकम,</para>
  <para style="q" vid="JOB 37:5">तेऊए इहै महान कामां निं हाम्हैं समझ़ी सकदै।<verse eid="JOB 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 37:6" />सह दैआ धरती दी हिंऊंआं पल़णैओ हुकम,</para>
  <para style="q" vid="JOB 37:6">सरगा का दैआ पाणींए छ़ो-छ़ंध तरैल़ी।<verse eid="JOB 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 37:7" />सह लाआ मणछे कामां-काज़ा दी रोक,</para>
  <para style="q" vid="JOB 37:7">ताकि हाम्हां सोभी का थोघ लागे कि सह किज़ै सका करी।<verse eid="JOB 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 37:8" />बणें ज़ीब बी लुक्‍का ढुंखरै, डुआरै अर</para>
  <para style="q" vid="JOB 37:8">आपणीं-आपणीं जुहल़ी भितरी।<verse eid="JOB 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 37:9" />सह आणा दखण दिशा बाखा का ढिश-डुआल़अ</para>
  <para style="q" vid="JOB 37:9">अर उतर दिशा बाखा हिंऊंद।<verse eid="JOB 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 37:10" />परमेशरे शाह करै लागा पाणीं दी शाण,</para>
  <para style="q" vid="JOB 37:10">बडै-बडै सअरा प्रैंदै ज़म्मा तेते पाट।<verse eid="JOB 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 37:11" />बादल़ा लै झाल़ा सह खास्सअ भाफ,</para>
  <para style="q" vid="JOB 37:11">संघा लागा तेता का बिज़ल़ी च़मकदी।<verse eid="JOB 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 37:12" />ज़ेही परमेशरे मरज़ी हआ, बादल़ सिक्‍का तिहै ई ओर्ही-पोर्ही,</para>
  <para style="q" vid="JOB 37:12">तिंयां करा सारी पृथूई दी तिहअ ई,</para>
  <para style="q" vid="JOB 37:12">ज़िहअ सह तिन्‍नां लै हुकम करा।<verse eid="JOB 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 37:13" />परमेशर बरशाऊआ धरती दी पाणीं,</para>
  <para style="q" vid="JOB 37:13">कई बारी दैआ सह हाम्हां लै तेता करै सज़ा</para>
  <para style="q" vid="JOB 37:13">अर कई बारी करा सह तेता करै हाम्हां लै झींण।<verse eid="JOB 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 37:14" />आयूब, थोल़ी घल़ी दै धैन भाल़ै, संघा शुण,</para>
  <para style="q" vid="JOB 37:14">परमेशरे नुआहरै कामें बारै कर बच़ार।<verse eid="JOB 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 37:15" />ताखा आसा थोघ कि परमेशर ढिश-बागरी किहअ करै डाह आपणैं बशै</para>
  <para style="q" vid="JOB 37:15">अर बादल़ा का बिज़ल़ीए झ़प्प-तल़प्पी किहअ करै लागा।<verse eid="JOB 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 37:16" />ताखा आसा थोघ कि सरगै बादल़ ओर्ही-पोर्ही किहअ करै ठुर्हा?</para>
  <para style="q" vid="JOB 37:16">अह नोखअ काम आसा परमेशरे कारीगीरी</para>
  <para style="q" vid="JOB 37:16">ज़ुंण सोभै गल्‍ला ज़ाणा।<verse eid="JOB 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 37:17" />गरमींए घमास्सा करै हआ तेरी घेरीए झिकल़ै प्रसिन्‍नै करै लुच़-लुच़ै</para>
  <para style="q" vid="JOB 37:17">ज़ांऊं दखण दिशा बाखा तात्ती बागरी दहई प्लुशी शोटा।<verse eid="JOB 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 37:18" />सरगा छ़ैणां लै कै तूह परमेशरे मज़त करी सका</para>
  <para style="q" vid="JOB 37:18">ज़ुंण तेऊ शिश्शै ज़िहअ च़मच़मांदअ आसा बणाअं द?<verse eid="JOB 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 37:19" />ऐबै दै तूह हाम्हां लै शिक्षा कि परमेशरा लै किज़ै बोल़णअ?</para>
  <para style="q" vid="JOB 37:19">ऐबै निं म्हारै मन्‍नैं बोल़णा लै किछ़ै रहअ।<verse eid="JOB 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 37:20" />परमेशरा लै कै पैहलै फैल़अ लोल़ी दैनअ कि हुंह च़ाहा गल्‍ला करनअ?</para>
  <para style="q" vid="JOB 37:20">कोहै मणछ निं आप्पू बरैबाद हणअ च़ाहंदअ।<verse eid="JOB 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 37:21" />एभै निं हाम्हैं सरगै च़मच़मांदै प्रैश्शै बाखा भाल़ी सकदै</para>
  <para style="q" vid="JOB 37:21">किल्हैकि एते च़मक आसा भाल़णा लै बेघै खास्सी,</para>
  <para style="q" vid="JOB 37:21">बागरी करा सरगा निम्बल़ै।<verse eid="JOB 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 37:22" />उतर दिशा बाखा एछा परमेशर च़मच़मांदै सुन्‍नैं ज़िहअ,</para>
  <para style="q" vid="JOB 37:22">तेऊए च़मच़मांदै झ़ामणा भाल़ी फिरा हाम्हां सोभी दर्छ़णअ।<verse eid="JOB 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 37:23" />परमेशरो बल आसा खास्सअ महान अर हाम्हैं निं तेऊ नेल़ डेऊई सकदै,</para>
  <para style="q" vid="JOB 37:23">पर तज़ी बी आसा सह भलअ अर धर्मीं, सह निं हाम्हां बरैबाद करदअ।<verse eid="JOB 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 37:24" />तैही करा लोग परमेशरो अदर,</para>
  <para style="q" vid="JOB 37:24">सह निं तिन्‍नां बाखा धैन बी दैंदअ</para>
  <para style="q" vid="JOB 37:24">ज़ुंण आप्पू लै अक्ली आल़ै हणैंओ दखाअ करा।”<verse eid="JOB 37:24" /></para>
  <chapter eid="JOB 37" />
  <chapter number="38" style="c" sid="JOB 38" />
  <para style="s">बिधातो आयूबा लै ज़बाब</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 38:1" />तेखअ बोलअ बिधाता ढिश-बागरी जैंदरा का आयूबा लै इहअ,<verse eid="JOB 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 38:2" />“तूह कुंण हआ मेरी अक्लीए बारै सुआल करनै आल़अ?</para>
  <para style="q" vid="JOB 38:2">ताखा कुंणी खोज़ी एही नथोघी गल्‍ला बोल़णीं?<verse eid="JOB 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 38:3" />मर्धा ज़ेही बान्ह कुछी गाची</para>
  <para style="q" vid="JOB 38:3">संघा दै मेरी गल्‍लो ज़बाब ज़ुंण हुंह पुछ़ा।<verse eid="JOB 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 38:4" />ज़धू मंऐं धरतीए आथरी पाई तधू किधी त तूह?</para>
  <para style="q" vid="JOB 38:4">ज़ै ताखा थोघ थिअ तै लअ एते बारै मुखा खोज़ी।<verse eid="JOB 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 38:5" />धरतीओ घेरअ कुंणी नापअ अर</para>
  <para style="q" vid="JOB 38:5">तेथ कुंणी खिंच़अ सूत?<verse eid="JOB 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 38:6" />पृथूईए आथरी किज़ू करै आसा थम्हीं डाही दी?</para>
  <para style="q" vid="JOB 38:6">एते आथरीए ज़ानीं कुंणी लाई?<verse eid="JOB 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 38:7" />भैणीं दोत्ती लागा तारै बी कठा गिहा बोल्दै,</para>
  <para style="q" vid="JOB 38:7">बिधाते स्वर्गे दूत लागा ज़ै-ज़ैकार करदै।<verse eid="JOB 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 38:8" />पृथूईए ओदरा का ज़ांऊं समुंदर निखल़अ,</para>
  <para style="q" vid="JOB 38:8">तेथ कुंणी आसा फेरा-फेर रोक्‍कअ डाहअ द लाई।<verse eid="JOB 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 38:9" />सह आसा हुंह भाल़! ज़ुंणी बादल़ा करै आसा समुंदर ढोपी</para>
  <para style="q" vid="JOB 38:9">अर नटिप्प न्हैरै करै आसा पल़ेटी डाहअ द।<verse eid="JOB 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 38:10" />मंऐं आसा समुंदरा फेर सिअं डाही दी</para>
  <para style="q" vid="JOB 38:10">कि सह तेते प्रऊल़ी पिछ़ू ई रहे।<verse eid="JOB 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 38:11" />मंऐं बोलअ समुंदरा लै,</para>
  <para style="q" vid="JOB 38:11">‘तूह एछै इधी तैणीं एता आजू निं डेऊई,</para>
  <para style="q" vid="JOB 38:11">तेरी बडी-बडी छ़ाल्‍ली बी लोल़ी इधी पुजी शांत हुई।’<verse eid="JOB 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 38:12" />आयूब, तंऐं आपणीं ज़िन्दगी इहअ हुकम किअ कि</para>
  <para style="q" vid="JOB 38:12">राच लोल़ी भैई या सान्ह लोल़ी पल़ी?<verse eid="JOB 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 38:13" />कि सुरज़ा लै तंऐं किअ ढेअ कि तेतो प्रैश्शअ लोल़ी सारी धरती पुजअ</para>
  <para style="q" vid="JOB 38:13">कि तै शुझणैं कदुष्ट मणछ कि किधी आसा लुक्‍कै दै,</para>
  <para style="q" vid="JOB 38:13">संघा ठुल़्हकणै तिंयां तिधा का पोर्ही?<verse eid="JOB 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 38:14" />धुप्पै करै शुझिआ धारा अर खाग-खाग इहै कि,</para>
  <para style="q" vid="JOB 38:14">तिन्‍नैं आसा होए झिकल़ै बान्हैं दै,</para>
  <para style="q" vid="JOB 38:14">तिंयां शुझिआ च़कणाट माट्टै प्रैंदै लाई दी मोहरा ज़िहै निम्बल़ै।<verse eid="JOB 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 38:15" />कदुष्ट मणछे निं धुप्पअ ज़िर्हदअ आथी</para>
  <para style="q" vid="JOB 38:15">किल्हैकि तेता करै गछ़ा तिन्‍नां ज़ुल्म करनै का।<verse eid="JOB 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 38:16" />तूह कधू तिधी पुजअ ज़िधा का समुंदरे सोबल़ निखल़ा?</para>
  <para style="q" vid="JOB 38:16">तूह कधू समुंदरे थाल्‍लै हांढअ?<verse eid="JOB 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 38:17" />कै ताखा इहअ थोघ आसा कि जम्परीए प्रऊल़ी किधी आसा?<verse eid="JOB 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 38:18" />ताखा आसा थोघ ऐ, कि अह संसार केतरअ आसा?</para>
  <para style="q" vid="JOB 38:18">ज़ै ताखा थोघ आसा, तै खोज़ मुखा।<verse eid="JOB 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 38:19" />ताखा इहअ बी आसा थोघ ऐ कि प्रैश्शअ किधा का एछा</para>
  <para style="q" vid="JOB 38:19">अर न्हैरैओ मूल़ किधी आसा?<verse eid="JOB 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 38:20" />कै तूह तेता लै बोली सका कि इधी तैणीं डेओऐ</para>
  <para style="q" vid="JOB 38:20">कि तूह तेता पिछ़ू फरेऊई सका।<verse eid="JOB 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 38:21" />मेरै खैलै ज़ाणा तूह सोभै गल्‍ला!</para>
  <para style="q" vid="JOB 38:21">किल्हैकि तूह आसा हणअ इना सोभी का आजी हुअ द</para>
  <para style="q" vid="JOB 38:21">अर तूह हुअ इना गल्‍ला भाल़दी प्रोढअ!<verse eid="JOB 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 38:22" />तूह कधू तेऊ भढारा भाल़अ बी डेऊअ,</para>
  <para style="q" vid="JOB 38:22">ज़ेथ मंऐं हिंअं अर शरू हआ डाहै दै?<verse eid="JOB 38:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 38:23" />ईंयां च़िज़ा हआ मंऐं आफ़ते बगती,</para>
  <para style="q" vid="JOB 38:23">झ़गल़ै अर जुधे धैल़ लै तैर डाहै दै।<verse eid="JOB 38:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 38:24" />तूह कै कधू तैहा ज़ैगा डेऊअ ज़िधा का सुरज़ निखल़ा</para>
  <para style="q" vid="JOB 38:24">अर पुर्बा बाखे बागरी एछा?<verse eid="JOB 38:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 38:25" />लोदल़-छ़ोदल़ पाणीं लै कुल्ह कुंणी फरेऊई?</para>
  <para style="q" vid="JOB 38:25">कुंणी बणाईं गुल़ूबिज़ल़ू लै बात?<verse eid="JOB 38:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 38:26" />उज़र रेगीस्तानै ज़ेथ कोहै मणछ निं हंदअ बस्सअ द, तेथ कुंण बरशाऊआ पाणीं?<verse eid="JOB 38:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 38:27" />शुक्‍की-रुखी ज़िम्मीं कुंण भेऊआ पाणीं करै</para>
  <para style="q" vid="JOB 38:27">ताकि घाह टिर्खिए?<verse eid="JOB 38:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 38:28" />सरगा का हणैं आल़ै पाणींओ बाब कुंण आसा,</para>
  <para style="q" vid="JOB 38:28">ओश कुंणी आसा बणाअं द?<verse eid="JOB 38:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 38:29" />हिंअं कसरै ओदरा का निखल़ा,</para>
  <para style="q" vid="JOB 38:29">पाल़े ईज कुंण आसा?<verse eid="JOB 38:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 38:30" />पाणीं किहअ करै बणा पात्थरा ज़िहअ लड्ड करदअ</para>
  <para style="q" vid="JOB 38:30">अर समुंदरा प्रैंदै लागा हिंऊंओ शाण?<verse eid="JOB 38:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 38:31" />सरगै कृतिका तारैओ छ़ुंढ कै तूह बूणी सका</para>
  <para style="q" vid="JOB 38:31">अर मृग नक्षत्रो ज़ोल़ कै तूह खोल्ही सका?<verse eid="JOB 38:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 38:32" />तूह कै तारै लै बोली सका कि आपणीं ऋता निखल़ै बगती?</para>
  <para style="q" vid="JOB 38:32">सात ऋषी तारै अर तिन्‍नां संघै होरी होछ़ै तारै लै तूह दैआ सलाह।<verse eid="JOB 38:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 38:33" />ताखा आसा थोघ ऐ, भ्रमंडै कुंण बधान आसा?</para>
  <para style="q" vid="JOB 38:33">तेऊ ई बधाना कै तूह धरती दी मनणा लै बोली सका?<verse eid="JOB 38:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 38:34" />तूह कै बादल़ा लै हाक्‍का लाई सका</para>
  <para style="q" vid="JOB 38:34">कि ताह प्रैंदै लोल़ी पाणींओ हर्ल्ह रिंगअ।<verse eid="JOB 38:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 38:35" />तूह कै सरगै बीजा हुकम दैई सका</para>
  <para style="q" vid="JOB 38:35">कि ज़िधी तूह बोला, सह पल़ा ताक्‍की करै तिधी।<verse eid="JOB 38:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 38:36" />बादल़ा लै पाणीं बरशाऊंणे बुध कुंण दैआ?</para>
  <para style="q" vid="JOB 38:36">धूँईं का कुंण खोज़ा कि उझै लागा उझ़णअ?<verse eid="JOB 38:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 38:37" />एतरी अक्ल कहा आसा ज़ुंण बादल़ गणी सके?</para>
  <para style="q" vid="JOB 38:37">सह कुंण आसा ज़ुंण सरगे पाणींए शिंगी तरैल़ी बरशाऊआ<verse eid="JOB 38:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 38:38" />ज़ेता करै धूल़ै-माट्टे गार बणा?<verse eid="JOB 38:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 38:39" />तूह कै सिहा लै शकार लोल़ी सका,</para>
  <para style="q" vid="JOB 38:39">भुखै खारकै सिहा कै तूह तेभै रज़ैऊई सका<verse eid="JOB 38:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 38:40" />ज़ेभै तिंयां आपणीं जुहल़ी न्हैल़ै</para>
  <para style="q" vid="JOB 38:40">शकारा खाणां लै च़ैहनूई करै ताखुई हआ रहै दै?<verse eid="JOB 38:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="JOB 38:41" />काऊड़ै लै तेभै रोटी कुंण दैआ</para>
  <para style="q" vid="JOB 38:41">ज़ेभै तिंयां भुखै ठुल़्दै रहा लागी अर</para>
  <para style="q" vid="JOB 38:41">ज़ेभै तिन्‍नें होछ़ै बच़ै रोटी लै मुंह परमेशरा सेटा लेरा लाआ?”<verse eid="JOB 38:41" /></para>
  <chapter eid="JOB 38" />
  <chapter number="39" style="c" sid="JOB 39" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 39:1" />“ताखा आसा बी थोघ धारा रहणैं आल़ी बणें बाकरी केभै सूआ?</para>
  <para style="q" vid="JOB 39:1">तंऐं कधू बणें हरनी भाल़ी सुंदी?<verse eid="JOB 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 39:2" />ताखा आसा बी थोघ कि तिंयां आपणैं बच़ै केतरै भिन्‍नैं डाहा ओदरै?</para>
  <para style="q" vid="JOB 39:2">ताखा इहअ पाक्‍कअ थोघै हआ कि ऐहा बेला सूंणीं तिंयां,<verse eid="JOB 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 39:3" />कि एभै बेशणअ तिन्‍नां धरनीं</para>
  <para style="q" vid="JOB 39:3">अर बच़ै लै ज़ल्म दैई जाणी तिंयां सूंणें दाह का छ़ुटी।<verse eid="JOB 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 39:4" />बणैं-बूटै हआ तिन्‍नें बच़ै बडै</para>
  <para style="q" vid="JOB 39:4">तेखअ डेऊऐ तिंयां माआ का दूर संघा निं भिई बापस फिरदै।<verse eid="JOB 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 39:5" />बणें गाधै कुंणी आसा खुल्है छ़ाडै दै?</para>
  <para style="q" vid="JOB 39:5">तिंयां कुंणी आसा राश्शी का पोर्ही खोल्है दै?<verse eid="JOB 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 39:6" />तेऊ दैनअ मंऐं रेगीस्तानै बस्सणै,</para>
  <para style="q" vid="JOB 39:6">तिन्‍नें घअर आसा बंज़र ज़िम्मीं दी ज़ेथ किछ़ै निं पज़दअ।<verse eid="JOB 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 39:7" />तिन्‍नां आसा नगरीऐ हाल्‍लै-गोल्‍लै का नफरत,</para>
  <para style="q" vid="JOB 39:7">तिन्‍नां का निं तिन्‍नां कामां लै छ़ेल़्हणै आल़ेए हाक्‍का शुण्हदी।<verse eid="JOB 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 39:8" />तिंयां रहा धारा च़रदै लागी,</para>
  <para style="q" vid="JOB 39:8">तेथ भेटा तिन्‍नां भांती-भांतीओ घाह च़रना लै।<verse eid="JOB 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 39:9" />बणों म्हैशअ कै तेरै काम करना लै झ़ूरनअ?</para>
  <para style="q" vid="JOB 39:9">तेऊ कै तेरी च़राठी सेटा राच काटी हेरनी?<verse eid="JOB 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 39:10" />तूह कै बणें बल्दा हल़ै ज़ुंडी सका?</para>
  <para style="q" vid="JOB 39:10">तूह कै तेऊ करै खेचै मोई दैई सका?<verse eid="JOB 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 39:11" />तूह कै तेऊए ज़ोरे आसरै रही सका</para>
  <para style="q" vid="JOB 39:11">कि खास्सअ ज़ोरा आल़अ काम जाणअ तेऊ करै हई?<verse eid="JOB 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 39:12" />तूह तेऊ दी भरोस्सअ करी सका कि तेऊ हेरनअ तेरअ नाज़ घअरै पजैल़ी</para>
  <para style="q" vid="JOB 39:12">कि तिन्‍नां खहल़ै मांडणा लै झाल़े?<verse eid="JOB 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 39:13" />शुतरमुर्गी बी फुआरा आपणैं फैंखा खास्सै!</para>
  <para style="q" vid="JOB 39:13">पर तिंयां निं सारसा ज़िहअ डैअ दैई सकदै।<verse eid="JOB 39:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 39:14" />शुतरमुर्गी डाहा आपणैं आंडै धरनीं माट्टै प्रैंदै</para>
  <para style="q" vid="JOB 39:14">संघा डाहा तेता धूल़ै जैंदरी जाम्हदै लाई।<verse eid="JOB 39:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 39:15" />तैहा निं इहअ फिकर बी हंदअ कि ईंयां निं लोल़ी कुंणी जैंटी पाऐ,</para>
  <para style="q" vid="JOB 39:15">या कुंणी बणें ज़ीबै फाल़ी पाऐ!<verse eid="JOB 39:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 39:16" />सह करा इहअ दखाअ कि तिंयां आंडै निं तेसे आथी ई,</para>
  <para style="q" vid="JOB 39:16">कष्ट, हआ तैहा खास्सअ पर तज़ी बी निं सह परबाह मारदी।<verse eid="JOB 39:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 39:17" />सह आसा हुंह परमेशर, ज़ुंण तैहा ऐडी बणाआं</para>
  <para style="q" vid="JOB 39:17">मंऐं निं तैहा लै एही समझ़ आथी दैनी दी।<verse eid="JOB 39:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 39:18" />पर ज़ै सह ठुर्हदी गई लागी,</para>
  <para style="q" vid="JOB 39:18">तै शोटा सह घोल़ै अर तेते शुंआरा बी शर्मिंदै करी।<verse eid="JOB 39:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 39:19" />आयूब, घोल़ै लै बल दैणैं आल़अ कै तूह आसा?</para>
  <para style="q" vid="JOB 39:19">तिन्‍नें कैल़ै शराल़े फ्रूरू कै तंऐं आसा गुंदै दै?<verse eid="JOB 39:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 39:20" />रैट्टै ज़िहै त्रुपल़ै दैणैंओ ज़ोर कै तिन्‍नां लै तूह दैआ?</para>
  <para style="q" vid="JOB 39:20">ज़ांऊं तिंयां ख्रिंऊं करा, लोगा छ़ुटा डअर।<verse eid="JOB 39:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 39:21" />तिंयां लागा टप-टपै खागै-खागै हांढदै,</para>
  <para style="q" vid="JOB 39:21">तिंयां डेओआ आपणअ सारअ ज़ोर लाई जुधा लै ठुर्ही।<verse eid="JOB 39:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 39:22" />डअर नाओंए च़ीज़ निं तिंयां ज़ाणदै ई आथी,</para>
  <para style="q" vid="JOB 39:22">तलबारे डरै बी निं तिंयां पिछ़ू हटदै।<verse eid="JOB 39:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 39:23" />तिन्‍नें शुंआरै सोभै अस्त्र-शस्त्रा का लागा</para>
  <para style="q" vid="JOB 39:23">धुप्पै करै झ़ामण निखल़दअ।<verse eid="JOB 39:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 39:24" />नर्शिंगै छ़ेल़ शुण्हदी ठुर्हा घोल़अ जुधा लै आजू</para>
  <para style="q" vid="JOB 39:24">तेखअ निं तिंयां खल़ै रहंदै टेक्‍की।<verse eid="JOB 39:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 39:25" />ज़ेभै-ज़ेभै नर्शिंगअ शुण्हिंआं, तिंयां रहा ख्रिंऊं करदै लागी,</para>
  <para style="q" vid="JOB 39:25">तिन्‍नां जाआ नेल़ पुजणैं का आजी जुधे बास्स एछी</para>
  <para style="q" vid="JOB 39:25">अर अफसरे चाल़्हणें हाक्‍का शुण्हुंई।<verse eid="JOB 39:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 39:26" />आयूब, ज़ेभै बाज़ दखण दिशा बाखा डेऊणा लै फैंख फुआरा,</para>
  <para style="q" vid="JOB 39:26">सह कै डैअ दैणअ ताखा शिखल़ा?<verse eid="JOB 39:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 39:27" />मुक्षरलअ कै तेरै बोलै बणाआं उछ़टै पर्बता दी आपणअ कोल्ह?<verse eid="JOB 39:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 39:28" />सह बणाआं आपणअ कोल्ह सोभी का उछ़टी टोल्हा प्रैंदै</para>
  <para style="q" vid="JOB 39:28">अर तिछी च़ुंडी हआ तेऊ गहल़ा ज़ेही।<verse eid="JOB 39:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 39:29" />सह सका आपणीं आछी करै नेल़ अर खास्सअ दूर तैणीं</para>
  <para style="q" vid="JOB 39:29">आपणअ शकार भाल़ी।<verse eid="JOB 39:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 39:30" />ज़िधी ल्हासा हआ, तिधी झाल़्हिआ गरली बी,</para>
  <para style="q" vid="JOB 39:30">तिन्‍नें बच़ै बी झुटा तेतो लोहू।”<note caller="-" style="x"><char style="xo" closed="false">39:30 </char><char style="xt" closed="false"><ref loc="LUK 17:37">लूक. 17:37</ref>; <ref loc="MAT 24:28">मोत्त. 24:28</ref></char></note><verse eid="JOB 39:30" /></para>
  <chapter eid="JOB 39" />
  <chapter number="40" style="c" sid="JOB 40" />
  <para style="s">हुंह आसा बिधाता ज़हा का सारअ बल आसा</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 40:1" />तेखअ बोलअ बिधाता आयूबा लै इहअ,<verse eid="JOB 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 40:2" />“आयूब, तंऐं किई मुंह परमेशरा संघै हठ ज़हा का सारअ बल आसा,</para>
  <para style="q" vid="JOB 40:2">ऐबै लाई तंऐं छ़ाड़ छ़ाडी कि तंऐं ज़बाब लाअ दैई?”<verse eid="JOB 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 40:3" />आयूबै दैनअ बिधाता लै ज़बाब,<verse eid="JOB 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 40:4" />“हे बिधाता, हुंह निं ताह सेटा किछ़ बी आथी,</para>
  <para style="q" vid="JOB 40:4">मंऐं ताल्है किज़ै ज़बाब लाअ दैई?</para>
  <para style="q" vid="JOB 40:4">ऐबै निं हुंह किछ़ै बोल्दअ।<verse eid="JOB 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 40:5" />मंऐं हेरअ बतेर्हअ बोली।</para>
  <para style="q" vid="JOB 40:5">ऐबै निं मुखा बोल़णा लै किछ़ै रहअ।”<verse eid="JOB 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 40:6" />तेखअ बोलअ बिधाता ढिश-बागरी जैंदरा का आयूबा लै इहअ,<verse eid="JOB 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 40:7" />“ऐबै उझ़ू आज़रअ खल़अ</para>
  <para style="q" vid="JOB 40:7">संघा दै मेरी गल्‍लो ज़बाब।<verse eid="JOB 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 40:8" />तूह कै इहअ च़ाहा बोल़णअ कि मेरअ नसाफ निं शुचअ आथी?</para>
  <para style="q" vid="JOB 40:8">तूह कै इहअ बोला कि हुंह आसा गलत अर तूह आसा शुचअ।<verse eid="JOB 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 40:9" />तूह कै मुंह ज़िहअ बलबान आसा?</para>
  <para style="q" vid="JOB 40:9">तेरै बोल कै मुंह ज़ेही गुल़ूबिज़ल़ूए छ़ेल़ छ़ाडा?<verse eid="JOB 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 40:10" />ज़ै इहअ आसा, तै उझ़ू इज़ती संघै शाना दी खल़अ,</para>
  <para style="q" vid="JOB 40:10">तै रहैऊ कि तूह आसा महान ताकि लोग तेरअ अदर करे।<verse eid="JOB 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 40:11" />तिन्‍नां बाखा भाल़ ज़ुंण घमंडी आसा,</para>
  <para style="q" vid="JOB 40:11">आपणअ रोश्श दै तिन्‍नां लै तरैल़ी संघा कर तिन्‍नां निऊंऐं।<verse eid="JOB 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 40:12" />हाँ, फेर भाल़ तिन्‍नां बाखा संघा कर तिन्‍नां निऊंऐं,</para>
  <para style="q" vid="JOB 40:12">कदुष्ट ज़िधी खल़ै आसा, तिन्‍नां बदल़ तिधा का धरनीं।<verse eid="JOB 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 40:13" />तिन्‍नां सोभी दाब धरनीं माट्टै जैंदरी,</para>
  <para style="q" vid="JOB 40:13">तिन्‍नां डाह जम्परी बान्हीं।<verse eid="JOB 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 40:14" />तै मनूं सोभी का आजी ताह हुंह आप्पै,</para>
  <para style="q" vid="JOB 40:14">अर इहअ कि तूह सका आपणैं ज़ोरै ज़िती।<verse eid="JOB 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 40:15" />पाणीं नेल़ रहणैं आल़ै तेऊ दैंत्तर ज़ीबा भाल़,</para>
  <para style="q" vid="JOB 40:15">ज़ुंण मंऐं ताह ई संघै बणाअं त,</para>
  <para style="q" vid="JOB 40:15">सह खा बल्दा ज़िहअ घाह।<verse eid="JOB 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 40:16" />तेऊ भाल़ किहअ ज़ोर आसा अर</para>
  <para style="q" vid="JOB 40:16">तेऊए पेटे नसा दी भाल़ किहअ बल आसा!<verse eid="JOB 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 40:17" />तेऊओ लिंघणअ आसा केल़ुई ज़िहअ,</para>
  <para style="q" vid="JOB 40:17">तेऊए ज़ांघे नसा आसा बेघै पाक्‍की।<verse eid="JOB 40:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 40:18" />तेऊए हाडकै आसा कांस्सै ज़िहै,</para>
  <para style="q" vid="JOB 40:18">तेऊए पिल्‍ली आसा लोहे खुंढै ज़ेही।<verse eid="JOB 40:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 40:19" />होरी सोभी ज़ीबा का नुआहरी गल्‍ल आसा तेऊ दी एही कि</para>
  <para style="q" vid="JOB 40:19">तेऊ सका सिधअ सह ई परमेशर हारी ज़ुंणी सह बणाअं द आसा।<verse eid="JOB 40:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 40:20" />तेऊए पेटै खाणां लै भेटा धारा घाह,</para>
  <para style="q" vid="JOB 40:20">ज़ेथ बणें ज़ीबै खलैर हआ पाअ द।<verse eid="JOB 40:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 40:21" />सह रहा कंऊंले फूले बूटे झ़ाकल़ा हेठै सुत्ती अर</para>
  <para style="q" vid="JOB 40:21">सअरै नगाल़ै हेठै डुघी च़िक्‍करै जैंदरी लुक्‍की।<verse eid="JOB 40:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 40:22" />सह रहा बडै-बडै कांडे झ़ाकल़े छ़ैल्‍ली अर</para>
  <para style="q" vid="JOB 40:22">फेर-फिरदै मधनूंए बूटा जैंदरी।<verse eid="JOB 40:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 40:23" />तेऊ निं दरैऊआ एछणें डअर बी हंदी,</para>
  <para style="q" vid="JOB 40:23">जरदण नदी बी तेऊए गल़ै तैणीं पुजे, सह निं चूँ करदअ।<verse eid="JOB 40:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 40:24" />तेऊए आछी छ़ार पाई निं तेऊ कोहै ढाकी सकदअ।</para>
  <para style="q" vid="JOB 40:24">नां कुंण तेऊए नाकै नकेल लाई सकदअ।”<verse eid="JOB 40:24" /></para>
  <chapter eid="JOB 40" />
  <chapter number="41" style="c" sid="JOB 41" />
  <para style="q">
    <verse number="1" style="v" sid="JOB 41:1" />“ताह कै लिबतान नाओं समुंदरो बडअ ज़ीब</para>
  <para style="q" vid="JOB 41:1">म्हाछ़ली ढाकणें कुंगल़ै कांडै करै खिंच़ी हेरनअ?</para>
  <para style="q" vid="JOB 41:1">या डोरी करै तेऊए ज़िभा झेची सका?<verse eid="JOB 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 41:2" />तेऊए नाकै कै तूह नकेल लाई सका</para>
  <para style="q" vid="JOB 41:2">या तेऊए जात कै किल्‍ली सका?<verse eid="JOB 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 41:3" />तेऊ कै ताखा एही पकार लाई पाई कि तेऊ छ़ाड पोर्ही?</para>
  <para style="q" vid="JOB 41:3">तेऊ कै लेरा पाई ताखा एही अरज़ करनी कि झींण कर?<verse eid="JOB 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 41:4" />तेऊ कै ताह संघै करार करनी</para>
  <para style="q" vid="JOB 41:4">कि इहअ बाहिदअ करनअ कि तेऊ करनी सदा तेरी च़ाकरी?<verse eid="JOB 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 41:5" />तूह कै तेऊ च़ेल्‍लू ज़िहअ ढाकी पाल़ी सका,</para>
  <para style="q" vid="JOB 41:5">कि तूह तेता आपणीं होछ़ी लान्हीं लै खेल्हणा लै दैए?<verse eid="JOB 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 41:6" />म्हाछ़ली ढाकणैं आल़ै कै तेऊए बोली लाई सका?</para>
  <para style="q" vid="JOB 41:6">बपारी कै तेऊ छ़िन्हीं करै बेच़ी सका?<verse eid="JOB 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 41:7" />तूह कै तेऊ म्हाछ़ली ढाकणें कांडै आल़ी तारा करै छ़िन्ह-बिन्ह करी सका,</para>
  <para style="q" vid="JOB 41:7">कि तूह तेऊए मुंडै बर्छ़ी खबेहुई सका?<verse eid="JOB 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 41:8" />तूह तेऊ एकी बारी छ़ुंह, ता छ़ुंह भाल़ै, ताह निं भिई कधि लागणअ,</para>
  <para style="q" vid="JOB 41:8">तेऊ जुधा निं तूह कधि बिस्सरुई च़ाल्‍लअ!<verse eid="JOB 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 41:9" />लिबताना ज़िहै पाणींए बडै ज़ीबा भाल़ी छ़ुटा लोगा दर्छ़णअ</para>
  <para style="q" vid="JOB 41:9">अर बेहोश हई बधल़िआ तिंयां धरनीं।<verse eid="JOB 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 41:10" />एही हिम्मत निं कोही आथी ज़ुंण लिबताना ज़िहै पाणींए बडै ज़ीबा रोल़े,</para>
  <para style="q" vid="JOB 41:10">नां तेऊ सेटा कुंण खल़अ टेक्‍की सकदअ।<verse eid="JOB 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 41:11" />तेऊ पिछ़ू पल़ी निं कोहै राज्ज़ी रही सकदअ,</para>
  <para style="q" vid="JOB 41:11">सारै संसारै निं तेऊए मकाबलै करदअ कोहै डेऊई सकदअ।<verse eid="JOB 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 41:12" />हुंह खोज़ूं ताखा लिबतान किहअ बडअ</para>
  <para style="q" vid="JOB 41:12">बलबान आसा अर तेऊए ज़ांघा केचल़ी आसा।<verse eid="JOB 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 41:13" />तेऊ बागो कवच निं कोहै धेल़ी सकदअ</para>
  <para style="q" vid="JOB 41:13">नां कहा तेऊए दबारै दांदा भितरी डेऊणे हिम्मत हंदी।<verse eid="JOB 41:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 41:14" />तेऊए डरैऊंणै दांदा भाल़ी निं</para>
  <para style="q" vid="JOB 41:14">तेऊए जात निं कोहै खोल्ही सकदअ।<verse eid="JOB 41:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 41:15" />तेऊए पिठीए तरोल़ै हआ तेऊ लै ढाल़</para>
  <para style="q" vid="JOB 41:15">तेते लगैग हआ पात्थरा ज़ेही लड्ड करदी।<verse eid="JOB 41:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 41:16" />तिंयां धारी हआ एकी-दुजै का पिड्डी शाची दी,</para>
  <para style="q" vid="JOB 41:16">तेथ जैंदरी निं बागरी बी निस्सरदी।<verse eid="JOB 41:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 41:17" />तेतो ज़ोल़ आसा इहअ कि सह निं कधि फुक्‍कदअ ई आथी।<verse eid="JOB 41:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 41:18" />तेऊए छ़िक्‍का का निखल़ा बिज़ल़ी ज़िहअ च़लकार,</para>
  <para style="q" vid="JOB 41:18">तेऊए आछी का निखल़ा धुप्पै ज़िहअ झ़ामण।<verse eid="JOB 41:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 41:19" />तेऊए खाखा का हआ ज़ल़दी आगी ज़िहै</para>
  <para style="q" vid="JOB 41:19">लुपल़ै लागै दै निखल़दै।<verse eid="JOB 41:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 41:20" />नाका का हआ धूँए मोरी लागी दी</para>
  <para style="q" vid="JOB 41:20">ज़िहअ कांडै-रिंडे ज़ल़दी आगी प्रैंदै लाऐ दै हांडू का भाफ हआ लागअ द।<verse eid="JOB 41:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 41:21" />तेऊओ शाहा का लागा आग ज़ल़दी</para>
  <para style="q" vid="JOB 41:21">अर तेऊए खाखा का लागा आगीए लुपल़ै लागै दै निखल़दै।<verse eid="JOB 41:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 41:22" />तेऊओ कैल़अ आसा गेल्‍ली ज़िहअ</para>
  <para style="q" vid="JOB 41:22">तेऊ भाल़ी फिरा सोभी दर्छ़णअ।<verse eid="JOB 41:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 41:23" />तेऊए घेर निं किधी का दुबल़ी आथी,</para>
  <para style="q" vid="JOB 41:23">तेऊए मास्सो ज़ोल़ आसा लोहै ज़िहअ पाक्‍कअ।<verse eid="JOB 41:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 41:24" />तेऊओ दिल आसा पात्थरा ज़िहअ ज़ेथ डअर निं हंदी,</para>
  <para style="q" vid="JOB 41:24">सह आसा घरटे तल़ी ज़िहअ काठअ।<verse eid="JOB 41:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 41:25" />ज़ांऊं सह खल़अ उझ़ुअ, बडै का बडै जोधै बी छ़ुटा दर्छ़णअ,</para>
  <para style="q" vid="JOB 41:25">डरै-मारै लुक्‍का तिन्‍नें हैल़ी हांस ई।<verse eid="JOB 41:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 41:26" />एही निं कुंण तलबार आथी ज़ुंण तेऊओ किज़ै बगाल़ी सके,</para>
  <para style="q" vid="JOB 41:26">नां कील, बर्छ़ी अर कतीरा करै तेऊए हान्‍नी हंदी।<verse eid="JOB 41:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 41:27" />लोहअ आसा तेऊ लै भुखलै ज़िहअ,</para>
  <para style="q" vid="JOB 41:27">कांस्सअ आसा तेऊ लै चिजी दी झ़ुका ज़िहअ।<verse eid="JOB 41:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 41:28" />तेऊ निं कतीरा करै ठर्राऊई सकदै,</para>
  <para style="q" vid="JOB 41:28">पात्थरो ढो बी ज़ाण्हिंआं इहै कि तेऊ लै शोटै नाज़े किश!<verse eid="JOB 41:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 41:29" />डांगै बी ज़ाण्हिंआं तेऊ का एही कि नाज़े काशी करै बाही,</para>
  <para style="q" vid="JOB 41:29">ज़ै तेऊ लै बर्छ़ै करै बिन्हें तेता करै फिरा तेऊ च़ुंढु दैणैं ज़ेही हास्सी!<verse eid="JOB 41:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 41:30" />तेऊए पेटा हेठै ज़ाण्हिंआं गाडल़ूए फुटै दै ठिक्‍करै ज़िहै दांद निखल़ै दै,</para>
  <para style="q" vid="JOB 41:30">ज़िहअ कि च़िक्‍करै जैंदरी ददाल़ होए फरेऊअ द।<verse eid="JOB 41:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 41:31" />सह लाआ डुघै समुंदरै उबल़दै पाणीं ज़िहै गाड्डू,</para>
  <para style="q" vid="JOB 41:31">अर कल़ाही दी तेला ज़िहअ उबल़दअ।<verse eid="JOB 41:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 41:32" />तेऊ पिछ़ू छ़ुटा च़मच़मांदी शेफा</para>
  <para style="q" vid="JOB 41:32">अर समुंदरो पाणीं शुझिआ तेता करै शेतअ।<verse eid="JOB 41:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 41:33" />तेऊ ज़िहअ निं संसारै कोहै ज़ीब आथी,</para>
  <para style="q" vid="JOB 41:33">सह आसा इहअ ज़ीब ज़हा डअर ई निं आथी।<verse eid="JOB 41:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 41:34" />ज़हा ज़ीबा सोभी का बडै हणैंओ घमंड बी आसा</para>
  <para style="q" vid="JOB 41:34">तेऊ लै बी भाल़ा सह उपरा का उंधै</para>
  <para style="q" vid="JOB 41:34">सह आसा सोभी दैंत्तर ज़ीबा प्रैंदै राज़अ।”<verse eid="JOB 41:34" /></para>
  <chapter eid="JOB 41" />
  <chapter number="42" style="c" sid="JOB 42" />
  <para style="s">आयूब प्राश्त</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 42:1" />आयूबै दैनअ बिधाता लै ज़बाब,<verse eid="JOB 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 42:2" />“हे बिधाता, हुंह ज़ाणा कि ताखा आसा सारअ बल,</para>
  <para style="q" vid="JOB 42:2">तूह सका सोभै गल्‍ला करी ज़िहअ तूह च़ाहा तिहअ।<verse eid="JOB 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 42:3" />तंऐं बोल़अ मुल्है इहअ,</para>
  <para style="q" vid="JOB 42:3">‘तूह कुंण हआ मेरी अक्लीए बारै लै सुआल करनै आल़अ?</para>
  <para style="q" vid="JOB 42:3">ताखा कुंणी खोज़ी एही नथोघी गल्‍ला बोल़णीं?’</para>
  <para style="q" vid="JOB 42:3">पर मंऐं बोली तिंयां गल्‍ला ज़ुंण मुंह समझ़ निं आई,</para>
  <para style="q" vid="JOB 42:3">ज़ुंण मेरी समझ़ अर मेरै बशा का बागै थिई।<verse eid="JOB 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 42:4" />तंऐं बोलअ मुल्है इहअ, ‘मर्धा ज़ेही बान्ह कुछी गाची</para>
  <para style="q" vid="JOB 42:4">संघा दै मेरी गल्‍लो ज़बाब ज़ुंण हुंह पुछ़ा।’<verse eid="JOB 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 42:5" />मुखा त तेरै बारै सिधअ एचल़ी थोघ ज़ुंण मुखा होरी त खोज़अ द,</para>
  <para style="q" vid="JOB 42:5">पर ऐबै भाल़अ मंऐं तूह आपणीं आछी।<verse eid="JOB 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 42:6" />ऐबै हुअ हुंह आपणीं तिन्‍नां गल्‍ला लै शर्मिंदअ,</para>
  <para style="q" vid="JOB 42:6">मुंह करनअ धूल़ै-माट्टै अर</para>
  <para style="q" vid="JOB 42:6">छ़ारे रूल़ी प्रैंदै बेशी तैहा गल्‍लो प्राश्त।”<verse eid="JOB 42:6" /></para>
  <para style="s">नचोल़</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7" />ज़ांऊं बिधाता आयूबा संघै गल्‍ला करी मुक्‍कअ, तेखअ बोलअ तेऊ तेमान नगरीए एलीपजा लै,<verse eid="JOB 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 42:8" />“तम्हैं करा इहअ, सात गाभू अर सात बाछ़ू आणा छ़ांटी करै, संघा करा मेरै दास आयूबा सेटा आप्पू लै हूम बल़ीदान। तै करनी मेरै दास आयूबा तम्हां लै मुंह सेटा अरज़ अर थारै बारै तेऊए अरज़ हेरनी मुंह शूणीं। तै निं मुंह तम्हां लै थारी ऐडी गल्‍ले सज़ा दैणीं ज़ुंण तम्हां भेटी लोल़ी ती। किल्हैकि तम्हैं निं मेरै बारै मेरै दास आयूबा ज़िहअ सत्त खोज़अ।”<verse eid="JOB 42:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 42:9" />इहअ शूणीं किअ तेमान नगरीए एलीपज, शूही का बिल्दाद अर नमाती नगरीए सोपरै तिहअ ई ज़िहअ बिधाता तिन्‍नां लै हुकम किअ त। संघा शूणीं बिधाता तिन्‍नें बारै माफी लै आयूबे अरज़।<verse eid="JOB 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10" />ज़ांऊं आयूबै आपणैं तिन्‍नां साथी लै बिधाता का अरज़ किई, बिधाता किअ तेऊओ सारअ दुख-सांगट बी दूर। ज़ेतरअ सेठ सह पैहलै थिअ, बिधाता बणाअं सह तेता का दुगणअ सेठ। <verse eid="JOB 42:10" /><verse number="11" style="v" sid="JOB 42:11" />तेखोस आऐ आयूबे भाई-बैहणी नातै-रिश्तैदार, साथी-संघी अर ज़ाणूं-बछ़ैणूं तेऊ सेटा मिलदै संघा खाई तेऊए घअरै कठा धाम। ज़ुंण बिधाता आयूबा लै खरी-अऊखी पाई ती, तेते बारै लागै तिंयां झेठ अर शोग मनाऊंदै। तिन्‍नैं सोभी दैनै तेऊ लै च़ंदीए सिक्‍कै अर एक-एक सुन्‍नेंओ बाल़ू।<verse eid="JOB 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12" />आयूबे बाकी ज़िन्दगी दी दैनी बिधाता तेऊए पिछ़ली ज़िन्दगी का खास्सी बर्गत। आयूबा का थिई च़ौदा हज़ार भेडा, छ़ह हज़ार ऊँट, एक हज़ार ज़ोल़ी बल्द अर एक हज़ार गाधीए हेल़्ह।<verse eid="JOB 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 42:13" />तेऊए हुऐ सात शोहरू अर चअन शोहरी। <verse eid="JOB 42:13" /><verse number="14" style="v" sid="JOB 42:14" />तेऊए ज़ेठी शोहरी नाअं त ज़मीना, मांझ़ली नाअं त कसीआ अर कान्हीं शोहरी नाअं त केरन। <verse eid="JOB 42:14" /><verse number="15" style="v" sid="JOB 42:15" />आयूबे शोहरी ती हेरनी शुणनी एही बित्ती कि सारै देशै निं तिन्‍नां ज़िहै कोहै बेटल़ी आथी ती। आयूबै दैनअ तिन्‍नां लै तिन्‍नें होरी भाई संघै ज़ैदाता दी हेस्सअ।<verse eid="JOB 42:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16" />तेता बाद ज़िऊअ आयूब एक शौ च़ाल़्ही साला होर अर तेऊ भाल़ी च़ौथी पोस्ती तैणीं आजू आपणीं आद-लुआद। <verse eid="JOB 42:16" /><verse number="17" style="v" sid="JOB 42:17" />ज़ांऊं आयूब खास्सअ प्रोढअ हुअ, तेखअ गअ सह ज़ांऐं।<verse eid="JOB 42:17" /></para>
  <chapter eid="JOB 42" />
</usx>