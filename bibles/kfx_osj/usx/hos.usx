  <para style="h">होशे</para>
  <para style="toc1">होशे गूरै खोज़ी दी गल्‍ला ज़ुंण आजू निभणी</para>
  <para style="toc2">होशे</para>
  <para style="toc3">होश.</para>
  <para style="mt1">होशे</para>
  <para style="mt2">होशे गूरै खोज़ी दी गल्‍ला ज़ुंण आजू निभणी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ:</para>
  <para style="ili">सन: 750 का 710 ईसा आजी</para>
  <para style="ip">होशे थिअ तेऊ ई ज़मानै, ज़धू ईशायाह गूर आसा त। ज़धू उतरा बाखा इज़राईल मुल्खै अश्शूर देशै कबज़अ किअ, तेता का पैहलकी साला तैणीं किअ इज़राईली घोर पाप अर परमेशरै बी दैनी तिन्‍नां लै घोर सज़ा। बिधाता बोलअ आपणैं गूर होशे लै एकी कंज़री बेटल़ी संघै बैह करना लै, ताकि सह इहअ खोज़ी सके कि इज़राईली बिधाता लै किहै विश्वास घाती आसा। बिधाता बझ़ैल़ै होशे गूरा का तेऊए शोहरूए नाअं डाहणैं ज़ुंण इज़राईली लै चतैनगी थिऐ कि बिधाता लाई इज़राईली लै सज़ा दैई। पर बिधाता बोलअ होशे लै इहअ कि सह झ़ूरै आपणीं विश्वास घाती बेटल़ी लै खास्सअ, सह ती एक एही तशबीर कि बिधाता झ़ूरा आपणीं परज़ा लै कबल्‍लअ, च़ाऐ तिन्‍नैं विश्वास घात बी किल्है निं होए किअ द।</para>
  <para style="ip">आजू आसा ऐहा कताबा दी इहअ कि इज़राईल अर यहूदा दी निखल़ी खोट कि तिन्‍नैं चोल़ी बिधाते करार अर तेते पल़णीं तिन्‍नां सज़ा भुगतणी। पर तज़ी बी निं बिधाता तिन्‍नां शोटी डाहंदअ अर सह झ़ूरा अज़ी बी तिन्‍नां लै खास्सअ। तैही बोलअ बिधाता कि तेऊ छ़ाडणीं तिन्‍नां लै माफी अर तेऊ दैणीं तिन्‍नां लै भिई बर्गत।</para>
  <para style="imq">“मेरी परज़ा किअ मुल्है विश्वास घात, पर मुंह छ़ाडणीं तिन्‍नां लै माफी। मुंह झ़ूरनअ तिन्‍नां लै दिला का खास्सै अर मुंह निं तिन्‍नां लै ऐबै रोश्श करनै।”</para>
  <para style="ipr">(14:4)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">होशे गूरे कंज़री बेटल़ी 1:1-11</para>
  <para style="io1">इज़राईला लै परमेशरे सज़ा अर नसाफ 2:1-23</para>
  <para style="io1">बिधाता आसा उद्धार करनै आल़अ 3:1-5</para>
  <para style="io1">इज़राईलो विश्वास घात 4:1—10:15</para>
  <para style="io1">इज़राईला लै बिधातो झ़ूरनअ अर उद्धार करनअ 11:1—14:9</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 15:1-7">2 राज़. 15:1-7</ref>; <ref loc="2CH 26:1-23">2 इति. 26:1-23</ref></char>
    </note>अह समाद खोज़अ तेऊ ज़मानै बिधाता बेरीए शोहरू होशे का, ज़धू यहूदा मुल्खै उज़ियाह, जताम, अहाज अर हिजकिया राज़ किअ अर इज़राईल मुल्खै थिअ जोआशो शोहरू जरोबाम राज़अ।<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2CH 27:1-8">2 इति. 27:1-8</ref>; <ref loc="2KI 15:32-38">2 राज़. 15:32-38</ref>; <ref loc="2KI 16:1-20">2 राज़. 16:1-20</ref>; <ref loc="2CH 28:1-27">2 इति. 28:1-27</ref>; <ref loc="2KI 18:1-20:21">2 राज़. 18:1—20:21</ref>; <ref loc="2CH 29:1-32:33">2 इति. 29:1—32:33</ref>; <ref loc="2KI 14:23-29">2 राज़. 14:23-29</ref></char></note><verse eid="HOS 1:1" /></para>
  <para style="s">होशे गूरे बेटल़ी अर शोहरू माठै</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />ज़धू पैहली बारी बिधाता आपणैं गूर होशे का इज़राईला लै समाद खोज़अ, तधू बोलअ बिधाता इहअ, “तूह डेऊ संघा कर कंज़री बेटल़ी संघै बैह, तेसे लुआद बी हणीं ज़ेही सह आसा तेही ई। सह हणअ ज़ाथी तिहअ ई ज़िहअ मेरी परज़ा मुल्है विश्वास घात किअ। मुंह बिधाता का दूर हई लागै तिंयां होरी देअए च़ाकरी करदै।”<verse eid="HOS 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />होशे किअ गोमेर नाओंए बेटल़ी संघै बैह। तेसे बाबा नाअं त दिबलाम। गोमेर हुई सुंदी अर तैहा का हुअ होशे लै एक शोहरू। <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />बिधाता बोलअ होशे लै, “एऊ नाअं डाह तूह, ‘जज्रेल,’ किल्हैकि थोल़ै धैल़ै बाद दैणीं मुंह जज्रेल खागै राज़ै ज़ैऊए खिंबा लै सज़ा। किल्हैकि राज़ै ज़ैऊ किई ती तिधी खास्सै लोगे हत्या। मंऐं लाअ इज़राईल देश खतम करी।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2KI 10:11">2 राज़. 10:11</ref></char></note> <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />तेभै करनअ मुंह जज्रेल खागै इज़राईले सैनो बल पठी खतम।”<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />बादा का हुई गोमेर भिई सुंदी अर तेसे हुई एक शोहरी। बिधाता बोलअ होशे लै, “ऐहा शोहरी नाअं डाह, ‘कपैरी<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">कपैरी </char><char style="ft" closed="false">लोरुहामा</char></note>,’ किल्हैकि ऐबै निं हुंह मेरी इज़राईली परज़ा लै झ़ूरदअ अर नां तिन्‍नां लै माफी छ़ाडदअ। <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />पर यहूदा मुल्खे मेरी परज़ा संघै रहणीं मेरी झ़ूरी बरकरार। तिंयां बच़ाऊंणै मुंह तिन्‍नें दुशमणा का। तेता लै निं तिन्‍नें सैना हणीं ज़ुंण कतीर-कबाणा अर तलबारा करै जुध करा, नां एता लै तिन्‍नें सैना हणीं ज़ुंण रथ अर घोल़ै प्रैंदै बेशी जुध करा। पर तिंयां बच़ाऊंणै मुंह तिन्‍नें बिधाता आपणैं ज़ोरै।”<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />ज़ांऊं गोमेर कपैरी का च़ूई चल़ाऊई मुक्‍की, सह हुई भिई सुंदी अर तेसो हुअ एक होर शोहरू। <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />बिधाता बोलअ होशे लै, “एऊ शोहरू नाअं डाह, ‘परज़ात<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">परज़ात </char><char style="ft" closed="false">लो-आम्मी</char></note>,’ किल्हैकि इज़राईली निं ऐबै मेरी आपणीं परज़ा आथी अर नां हुंह तिन्‍नों परमेशर आथी।<verse eid="HOS 1:9" /></para>
  <para style="s">इज़राईल देश बणनअ भिई</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />“पर तज़ी बी हणैं आजू इज़राईली समुंदरे रेता ज़िहै इहै खास्सै कि तिन्‍नां निं कुंण गणी सकदअ। एभै बोला हुंह तिन्‍नां लै, ‘तम्हैं निं मेरी परज़ा आथी।’ पर तेभै बोल़णअ तिन्‍नां लै, ‘तम्हैं आसा ज़िऊंदै परमेशरे लुआद।’<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ROM 9:26">रोम. 9:26</ref></char></note> <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />यहूदा अर इज़राईल दुही मुल्खै बस्सै दै इज़राईली हणैं भिई एक। तिन्‍नां छ़ांटणअ आप्पू लै एक्‍कै राज़अ अर तेखअ फिरनैं तिंयां आपणीं ऐहा ज़ैगा लै बापस कि इधी बस्से। जज्रेले सह धैल़ी हणीं महान!<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />“तैही बोलै तम्हैं आपणैं-आपणैं भाई-बंधा लै, ‘परज़ात,’ अर आपणीं दाई-च़ेई लै बोलै, ‘कपैरी।’”<verse eid="HOS 2:1" /></para>
  <para style="s">ज़ेही कंज़री गोमेर तिहै ई इज़राईली</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 2:2" />“मेरै लान्हैंओ, आपणीं ईजा दैआ नैरनीं! सह निं ऐबै मेरी बेटल़ी आथी अर नां हुंह तेसो मर्ध आथी। ज़ीबाण करी बोला तैहा लै कि कंज़री बेटल़ी ज़िहअ बभार करनअ छ़ाड पोर्ही। हुंह च़ाहा इहअ कि सह मुंह छ़ाडी होरी मर्धा संघै सुत्तणअ छ़ाडे। <verse eid="HOS 2:2" /><verse number="3" style="v" sid="HOS 2:3" />ज़ै सह इहअ नांईं करे, मुंह खोल्हणैं तेसे घेरीए झिकल़ै पठ पोर्ही अर सह हणीं तेही नांगी ज़धू तेसो ज़ल्म हुअ त! सह करनी मुंह उज़र रेगीस्ताना ज़ेही, ज़ेथ पाणींओ टिप्पू बी निं भेटदअ। सह डाहणीं मुंह शोटी कि सह नचिशी मरे। <verse eid="HOS 2:3" /><verse number="4" style="v" sid="HOS 2:4" />मुंह निं तेसे लान्हैं लै धख बी झींण करनी, किल्हैकि सह आसा कज़ोही संघै सुत्ती सुंदी हुई दी। <verse eid="HOS 2:4" /><verse number="5" style="v" sid="HOS 2:5" />सह तिन्‍नें ईज ती कंज़री, आपणैं मर्धा लै धोखअ दैई तिन्‍नां होरी संघै ढाण्हीं ढैऊई हुई सह नबिज़ती। सह बोला इहअ, ‘मेरै लोभी दैआ मुल्है नाज़-पाणीं, शल़ूई, ऊन, जैतूनो तेल अर झुटणा लै दाखो रस।’<verse eid="HOS 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 2:6" />“तैही डाहणैं मुंह तेसे बाता कांडे इहै घणैं बाल़ लाई कि सह किधी बी डेऊई निं सके। <verse eid="HOS 2:6" /><verse number="7" style="v" sid="HOS 2:7" />तैहा दैणी आपणैं लोभी पिछ़ू ठुर्हा, पर तैहा निं तिंयां ठिमकी बोल़णैं। सह लागणीं तिन्‍नां लोल़ी पर तैहा निं तिंयां भेटणैं। खिरी बोल़णअ तैहा इहअ, ‘ऐबै डेऊणअ मुंह आपणैं लाल़ै सेटा लै फिरी, ऐहा ज़िन्दगी का भली थिई मेरी तेऊ संघे ज़िन्दगी।’<verse eid="HOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 2:8" />“तैहा निं समझ़अ ई आथी कि सह आसा हुंह ज़ुंणीं तेसे हर गरज़ पूरी किई। मंऐं दैनअ तैहा लै नाज़, दाखो रस, जैतूनो तेल अर खास्सअ सुन्‍नअ-च़ंदी। पर तैहा किई मंऐं दैनी दी इना च़िज़ा करै बाल देअए पूज़ा! <verse eid="HOS 2:8" /><verse number="9" style="v" sid="HOS 2:9" />तैही निं मुंह तैहा नाज़ अर दाखो रस दैणअ ज़ुंण हुंह फसल काढणें ऋता दैआ। ऊन अर बाछ बी निं करनै मुंह दूर ज़ेता हुंह तेसे देही ढोपणां लै दैआ। <verse eid="HOS 2:9" /><verse number="10" style="v" sid="HOS 2:10" />सह करनी मुंह तेसे लोभी नदरी नांगी, इहअ निं कोह हणअ ज़ुंण तैहा मुखा बच़ाऊई सके। <verse eid="HOS 2:10" /><verse number="11" style="v" sid="HOS 2:11" />हर साल तिह-थैर, पुनूंईए, बशैघे धैल़ी अर साज़े धैल़ी ज़ेथ सह खुशी मनाऊंआं, तिंयां चोल़णैं मुंह पठी। <verse eid="HOS 2:11" /><verse number="12" style="v" sid="HOS 2:12" />तेसे दाखे बाग अर फेडूए बूट ज़ेता लै सह इहअ बोला कि तिंयां आसा तेसे लोभी दैनै दै! तिंयां करनै मुंह पठ खतम। तेसे बाग-बगिच़ै करनै उज़र, तेते फल़ खाणैं बणें ज़ीबा। <verse eid="HOS 2:12" /><verse number="13" style="v" sid="HOS 2:13" />ज़िना धैल़ै तैहा हुंह बिस्सरअ, मुंह छ़ाडी बाल देअआ लै धूपा दैंदी लागी अर हार-शंगार करी आपणैं लोभी पिछ़ू ठुर्हदी लागी, तिन्‍नां धैल़ै पिछ़ू लणी मुंह तैहा लै सज़ा दैई। अह गल्‍ल डाही मंऐं बिधाता बोली।<verse eid="HOS 2:13" /></para>
  <para style="s">आपणीं परज़ा लै बिधाते झींण</para>
  <para style="p">
    <verse number="14" style="v" sid="HOS 2:14" />“तैही लाई सह मंऐं भिई रेगीस्ताना लै निंईं, तिधी करनी मुंह तैहा संघै एही पैरी गल्‍ला कि सह भिई मुल्है झ़ूरे। <verse eid="HOS 2:14" /><verse number="15" style="v" sid="HOS 2:15" />तिधी दैणैं मुंह तैहा लै तेसे दाखे बाग बापस अर आफ़तो खाग हणअ तैहा लै इहअ दुआर ज़ेथ सह आशा डाही सका। सह हणीं तिधी मुंह संघै खुश ज़ेही सह ज़ुआनीए पलका मिसर देशा का निखल़दी बारी आसा ती।<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="JOS 7:24-26">ज़ैह. 7:24-26</ref></char></note> <verse eid="HOS 2:15" /><verse number="16" style="v" sid="HOS 2:16" />तेखअ बोल़णअ तैहा भिई कि हुंह आसा तेसो मर्ध अर तेखअ निं मुखा तैहा कधि इहअ बोल़णअ, ‘बाल आसा तेसो मर्ध।’ अह गल्‍ल डाही मंऐं बिधाता बोली। <verse eid="HOS 2:16" /><verse number="17" style="v" sid="HOS 2:17" />तेखअ निं मुंह तैहा कधि बाल देअ नाअं लणैं दैणअ।<verse eid="HOS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HOS 2:18" />“तिन्‍नां धैल़ै करनी मुंह बणैं हांढणै-फिरनैं आल़ै ज़ीबा अर च़ेल्‍लू-पखीरू संघै करार कि तिन्‍नैं निं मेरी परज़े किछ़ हान्‍नी लोल़ी किई। तिन्‍नें ज़ैगा का करनै मुंह जुधा करने सोभ शस्त्र, तलबारा, कतीर-कबाण दूर अर मुंह करनअ इहअ कि मेरी परज़ा शांती दी बस्से अर निहंचै रहे।<verse eid="HOS 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 2:19" />इज़राईल, ताह संघै करनअ मुंह सदा लै बैह।</para>
  <para style="q" vid="HOS 2:19">मेरी रही ताल्है ज़बान कि मुंह करनी तेरी तेते साबै मज़त</para>
  <para style="q" vid="HOS 2:19">ज़ेथ धर्म अर नसाफ हआ।</para>
  <para style="q" vid="HOS 2:19">मुंह करनी ताल्है झींण अर मुंह झ़ूरनअ ताल्है सदा।<verse eid="HOS 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HOS 2:20" />मुंह रहणअ ताल्है शुचै-पाक्‍कै,</para>
  <para style="q" vid="HOS 2:20">तेखअ हेरनअ ताह ज़ाणीं कि हुंह आसा बिधाता।<verse eid="HOS 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="HOS 2:21" />अह गल्‍ल डाही मंऐं बिधाता बोली कि</para>
  <para style="q" vid="HOS 2:21">तिन्‍नां धैल़ै शुणनी मुंह मेरी परज़े अरज़,</para>
  <para style="q" vid="HOS 2:21">मुंह छ़ाडणैं सरगै बादल़ अर तेता का हणअ धरती लै पाणीं,<verse eid="HOS 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="HOS 2:22" />धरती पज़ेरनअ नाज़, दाख अर जैतूनो तेल।</para>
  <para style="q" vid="HOS 2:22">मेरी परज़ा बोल़णीं खुशी दी गिह, ‘जज्रेल, परमेशर पज़ेरा।’<verse eid="HOS 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="HOS 2:23" />मुंह डाहणीं आपणीं परज़ा तिन्‍नें ज़ैगा भिई रोही,</para>
  <para style="q" vid="HOS 2:23">अर तिंयां हणैं भिई खास्सै।</para>
  <para style="q" vid="HOS 2:23">तिन्‍नां लै करनी मुंह झ़ूरी ज़हा लै, ‘कपैरी,’ बोला तै अर</para>
  <para style="q" vid="HOS 2:23">ज़हा लै, ‘परज़ात,’ बोला तै।</para>
  <para style="q" vid="HOS 2:23">मुंह बोल़णअ, ‘तम्हैं आसा मेरी परज़ा,’</para>
  <para style="q" vid="HOS 2:23">तिन्‍नां दैणअ इहअ ज़बाब, ‘तूह आसा म्हारअ परमेशर।’”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ROM 9:25">रोम. 9:25</ref>; <ref loc="1PE 2:10">1 पत. 2:10</ref></char></note><verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">होशे अर विश्वास घाती बेटल़ी</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />बिधाता बोलअ मुल्है, “तूह डेऊ भिई आपणीं बेटल़ी सेटा लै, संघा झ़ूर तैहा लै खास्सअ ज़ुंण आपणैं लोभी संघै आसा कंज़रैई करदी लागी दी। तूह झ़ूरै तैहा लै तिहअ ई ज़िहअ हुंह अज़ी बी इज़राईली परज़ा लै झ़ूरा। एही ता आसा तिंयां मुंह बिधाता छ़ाडी होरी देअआ पूज़दै लागै दै अर तिंयां झ़ूरा मुहुर्ती सेटा छ़ाडी दी दाखे टिक्‍की लै, पर तज़ी बी झ़ूरा हुंह बिधाता तिन्‍नां।”<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />तेखअ लई मंऐं सह बेटल़ी पंद्रा च़ंदीए फाल़ी<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">पंद्रा च़ंदीए फाल़ी </char><char style="ft" closed="false">कोई एक शौ सत्तर गराम</char></note> अर डेढ कुंटल़ ज़ौ दैई मोलै। <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />मंऐं डाहअ तैहा लै बोली, “ऐबै रहै तूह इधी मुंह संघै खास्सै धैल़ै मेरै घअरै। ऐबै निं कंज़रैई करी नां होरी मर्धा संघै सुत्ती आथी। मुंह बी निं खास्सै धैल़ै तैणीं ताह संघै सुत्तणअ आथी। <verse eid="HOS 3:3" /><verse number="4" style="v" sid="HOS 3:4" />इहै ई रहणैं इज़राईली बी खास्सै धैल़ै तैणीं बाझ़ी राज़ै अर नां तिन्‍नां प्रैंदै कुंण सैणअ हणअ। तिन्‍नां धैल़ै निं तिन्‍नां बल़ीदान करनअ, नां तिन्‍नां का पूज़णा लै डौंड हणैं नां च़ोल़ै अर नां तिन्‍नां का मुहुर्ती हणीं। <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />ज़ांऊं ईंयां धैल़ै निभणैं, तेखअ फिरनैं इज़राईली भिई बिधाता बाखा लै ज़ुंण तिन्‍नों परमेशर आसा। तेखअ करनी तिन्‍नां आपणैं तेऊ राज़ेए च़ाकरी ज़ुंण राज़ै दाबेदे आद-लुआदा का हणअ। तेखअ रहणअ तिन्‍नां बिधाते डरा हेठै अर तिन्‍नां भेटणीं तेऊ का बर्गत।”<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">इज़राईला लै बिधातो दोश</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 4:1" />इज़राईलीओ, बिधातो समाद शूणां! तम्हैं सोभै ज़ुंण एऊ देशै आसा बस्सै दै, बिधाता लाअ तम्हां लै दोश। सह बोला इहअ, “एऊ देशै निं कोह शुचअ-पाक्‍कअ आथी, नां कुंण झींण अर झ़ूरी करदअ अर नां कहा परमेशरो ज्ञैन आथी। <verse eid="HOS 4:1" /><verse number="2" style="v" sid="HOS 4:2" />तम्हैं दैआ एकी दुजै लै फिटक, तम्हैं दैआ तिन्‍नां लै धोखअ अर तम्हैं करा हत्या। तम्हैं आसा च़ोर अर कंज़रैई करनै आल़ै। तम्हैं हआ कबल्‍लै ज़ुल्मा प्रैंदै ज़ुल्म करदै लागै दै। <verse eid="HOS 4:2" /><verse number="3" style="v" sid="HOS 4:3" />तैही पल़णअ ऐहा ज़ैगा इहअ घोर शुक्‍कअ कि अह ज़ैगा हणीं रेगीस्ताना ज़ेही पठ शुन्‍नीं। एथ निं कोह ज़िऊंदअ बच़णअ। बणें ज़ीब, च़ेल्‍लू-पखीरू अर समुंदरे पाणीं जैंदरी म्हाछ़ली बी हणीं खतम।”<verse eid="HOS 4:3" /></para>
  <para style="s">प्रोहता लै दोश</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 4:4" />बिधाता बोला इहअ बी, “पर तम्हैं निं आप्पू मांझ़ै एकी-दुजै लै दोश लांदै लागा। इना ज़ुल्म करने दोशी आसा तम्हैं प्रोहत। <verse eid="HOS 4:4" /><verse number="5" style="v" sid="HOS 4:5" />तम्हां लै दैणीं मुंह धैल़-राच सज़ा, तम्हां संघै थारै झ़ुठै गूरा लै बी करनअ मुंह इहअ ई। इज़राईल देश ज़ुंण थारी ईजा ज़ेही आसा, सह बी करनी मुंह खतम। <verse eid="HOS 4:5" /><verse number="6" style="v" sid="HOS 4:6" />मेरी परज़ा हणीं खतम किल्हैकि तिंयां निं मुंह ज़ाणदै ई आथी। तम्हैं प्रोहतै समझ़अ मेरअ ज्ञैन बृथा अर तम्हैं निं मेरी शिक्षा मनी आथी! तैही हेरै मंऐं तम्हैं बी छ़ाडी अर नां हुंह आजू थारै शोहरू माठै प्रोहत मंदअ।<verse eid="HOS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HOS 4:7" />“ज़ेतरै तम्हैं प्रोहत खास्सै लागा हंदै, तम्हैं करा तेतरै खास्सै पाप, तैही करनै मुंह थारी शोभा-शान खतम करी तम्हैं बेइज़त। <verse eid="HOS 4:7" /><verse number="8" style="v" sid="HOS 4:8" />तम्हैं हुऐ मेरी परज़े पापा करै सेठ, तैही च़ाहा तम्हैं कि तिन्‍नैं लोल़ी होरी बी खास्सअ पाप किअ। <verse eid="HOS 4:8" /><verse number="9" style="v" sid="HOS 4:9" />तम्हां प्रोहते दशा बी हणीं तेही ई ज़ेही दशा लोगे हणीं! मुंह दैणीं तम्हां लै सज़ा अर ज़ुंण बूरअ तम्हैं किअ तेतो फल लागणअ तम्हां भुगतणअ। <verse eid="HOS 4:9" /><verse number="10" style="v" sid="HOS 4:10" />तम्हां खाणअ पर थारै पेट निं रज्ज़णै। तम्हां सुत्तणअ खास्सी बेटल़ी संघै पर तज़ी बी रहणैं तम्हैं लुआदा बाझ़ी एही। किल्हैकि तम्हैं छ़ाडअ हुंह बिधाता अर तम्हैं रहै कंज़रैई करदै अर होरी देअआ पूज़दै लागी।”<verse eid="HOS 4:10" /></para>
  <para style="s">बिधाता करा मुहुर्ती पूज़ा का नफरत</para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 4:11" />बिधाता बोला इहअ, “शराब नऊंईं होए च़ाऐ पराणीं तेता करै निं मणछा सोर समझ़ ई रहंदी। <verse eid="HOS 4:11" /><verse number="12" style="v" sid="HOS 4:12" />मेरी परज़ा हआ काठे मुहुर्ती का सलाह पुछ़दै लागै दै! तम्हैं हआ काठे शोठी का पुछ़दै लागै दै कि आजू किज़ै हणअ! तम्हैं हुऐ मुखा दूर अर तम्हैं आसा कबाता पेठै दै। हुंह आसा थारअ परमेशर पर तम्हैं निं मुल्है शुचै-पाक्‍कै आथी। तम्हैं आसा कंज़री बेटल़ी ज़िहै ज़ुंण आपणैं मर्धा लै धोखअ दैआ। <verse eid="HOS 4:12" /><verse number="13" style="v" sid="HOS 4:13" />तम्हैं करा धारे च़ुंडी होरी देअआ-देबी लै डागै-चैणैं बल़ीदान अर हूम। तम्हैं करा इना पूज़ा-गाज़ा बान-महरू, रऐ-तोस्सा अर बडै-बडै बूटा हेठै किल्हैकि तेते छ़ैल्‍ली दी लागा तम्हां मज़अ। तैही लागी थारी नुशा शोहरी कज़ोही संघै बरेल़्हदी। <verse eid="HOS 4:13" /><verse number="14" style="v" sid="HOS 4:14" />पर तिंयां निं ईंयां ज़ुआन बेटल़ी निं आथी ज़हा लै मुंह सज़ा दैणीं। तिंयां आसा तम्हैं मर्ध ज़हा लै मुंह सज़ा दैणीं। किल्हैकि ज़ेभै उझै धारा गान-स्तानै तम्हैं बल़ीदान करा, तेभै हआ कंज़री बेटल़ी तम्हां संघै खांदी बेठी दी अर तेखअ हआ तम्हैं सुत्तदै बी तिन्‍नां ई संघै पेठै दै। तम्हैं मेरी परज़ा निं भलअ-बूरअ समझ़दै ई आथी अर तैही हणअ थारअ बनाश ज़रूर।<verse eid="HOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HOS 4:15" />“तम्हैं मेरी इज़राईली परज़ा किअ मुंह बिधाता लै विश्वास घात। हुंह निं च़ाहंदअ कि मेरी परज़ा यहूदी बी इहअ ई पाप करे। गिलगाल अर बेताबेन गान-स्तानै पूज़ा करदै निं डेऊई! नां इहअ बोली, ‘मुंह करनी आपणीं ज़बान पूरी। मेरी ज़बान आसा एही शुची ज़िहअ बिधाता ज़िऊंदअ आसा।’ <verse eid="HOS 4:15" /><verse number="16" style="v" sid="HOS 4:16" />तम्हैं इज़राईली आसा छ़ुहाणा ज़िहै हठू ज़ुंण शुणदी ई निं आथी। तम्हैं आसा इहै हठू कि हुंह बिधाता निं तम्हां मिम्मूं ज़िहअ सऊंई बडी घैहणींए घाहा जैंदरी च़राऊई सकदअ। <verse eid="HOS 4:16" /><verse number="17" style="v" sid="HOS 4:17" />मेरी एप्रैमी परज़ा<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="fq" closed="false">एप्रैमी परज़ा </char><char style="ft" closed="false">इज़राईली परज़ा</char></note> लागा मुहुर्तीए पूज़ा करना लै मज़अ। तिन्‍नां दैआ तेथ शाची रहणैं। <verse eid="HOS 4:17" /><verse number="18" style="v" sid="HOS 4:18" />ज़ांऊं तिंयां शराब झुटी मुक्‍का, तेखअ लागा तेभी तिंयां कंज़री लोल़ै कि तिन्‍नां संघै सुत्ते। <verse eid="HOS 4:18" /><verse number="19" style="v" sid="HOS 4:19" />तैही दैणीं मुंह तिन्‍नां सोभी लै सज़ा। तिंयां च़कणै ढिश-बागरी उझै च़ेल्‍लू ज़िहै संघा फर्लाऊंणैं दूर। तेखअ हणैं खिरी तिंयां शर्मिंदै कि तिन्‍नैं किऐ मुहुर्ती लै हूम अर बल़ीदान।<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 5:1" />“तम्हैं प्रोहत शूणां! तम्हैं इज़राईली दैआ धैन! अर ज़ुंण तम्हैं राज़ेए खिंबा का आसा तम्हैं बी शूणां राम्बल़ै करै! तम्हां लै आसा दोश अर तम्हां लागणीं सज़ा भुगतणी। तम्हैं तै मिज़पा नगरी लोगा लै फाही। ताबोर धारा शाचै लोग थारै ज़ज़ाल़ा दी! <verse eid="HOS 5:1" /><verse number="2" style="v" sid="HOS 5:2" />तम्हैं किऐ लोग मुखा दूर अर तम्हैं बझ़ैल़ी खास्सै लोगे हत्या करनै। तैही लाई मंऐं तम्हां सोभी लै सज़ा दैई। <verse eid="HOS 5:2" /><verse number="3" style="v" sid="HOS 5:3" />मुखा आसा थोघ कि एप्रैम गोत्रे लोग किहै आसा। इज़राईलीए पाप आसा मुखा शुझदै लागै दै! तम्हैं आसा कंज़री बेटल़ी ज़िहै! तम्हैं आसा छ़ोतलै अर तम्हैं निं मेरी च़ाकरी करी सकदै।<verse eid="HOS 5:3" /></para>
  <para style="s">मुहुर्ती पूज़ा लै चतैनगी</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 5:4" />“तम्हैं निं कदुष्ट काम करनै छ़ाडदै अर नां मुंह थारै परमेशरा बाखा फिरी बापस एछदै! तम्हैं झ़ूरा कंज़रैई अर मुहुर्ती पूज़ा करना लै अर तेतो असर पल़अ थारी सोर-समझ़ा दी। तम्हैं निं मुंह बिधाता ज़ाणनअ ई च़ाहंदै। <verse eid="HOS 5:4" /><verse number="5" style="v" sid="HOS 5:5" />थारअ घमंड करा ऐहा गल्‍ला प्रगट कि तम्हैं इज़राईली आसा दोशी। थारै इना पापा पिछ़ू पल़णीं इज़राईल अर एप्रैमी लै घोर आफ़त अर यहूदा मुल्खे लोगा लै बी हणअ इहअ ई। <verse eid="HOS 5:5" /><verse number="6" style="v" sid="HOS 5:6" />तम्हैं फिरा मुंह बिधाता लै आपणीं हेल़्ही का खास्सै डागै-चैणैं बल़ीदान करदै, पर तिंयां आसा बृथा, किल्हैकि हुंह गअ तम्हां का दूर हई। <verse eid="HOS 5:6" /><verse number="7" style="v" sid="HOS 5:7" />तम्हैं निं मुल्है शुचै-पाक्‍कै आथी। थारै शोहरू माठै बी निं मेरै आथी। किल्हैकि ज़िहै कदुष्ट काम करी तिंयां पुनूंईओ थैर मनाऊंआं, तेता पिछ़ू करनी मुंह बिधाता तिंयां अर तिन्‍नें खेचे साल-फसल खतम।<verse eid="HOS 5:7" /></para>
  <para style="s">यहूदा अर इज़राईलो आप्पू मांझ़ै जुध</para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 5:8" />“गिबा नगरी बाज़ा नर्शिंगै! रामाह नगरी बाज़ा नाद! बेताबेन नगरी पाआ जुधे लैल़ा-पकारा! बिन्यामीन गोत्रे लोगो जुधा लै तैर्हिआ! <verse eid="HOS 5:8" /><verse number="9" style="v" sid="HOS 5:9" />एप्रैमे सोभी टोली लै सज़ा दैणैंओ बगत गअ पुजी। तैहा धैल़ी हणैं तिंयां पठी बरैबाद! इज़राईलीओ! ईंयां गल्‍ला रहणीं हई!<verse eid="HOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 5:10" />“मुंह आसा तिन्‍नां लै बी रोश्शै आई दी ज़ुंण यहूदा मुल्खै प्रैंदै राज़ करा। तिन्‍नां ज़िहै ज़ुंण होरी लोगे ज़ैगा ज़िम्मीं लुटा। तैही दैणीं मुंह तिन्‍नां लै सज़ा। मुंह पल़णअ तिन्‍नां लै भराल़ै आई दी गाडा ज़िहै चुटी। <verse eid="HOS 5:10" /><verse number="11" style="v" sid="HOS 5:11" />एप्रैम गोत्रे लोगा लै च़ाल्‍ली घोर आफ़त पल़ी। तिन्‍नां पल़णीं खास्सी सज़ा भुगतणी, किल्हैकि तिंयां झ़ूरै मुहुर्तीए पूज़ा करना लै। <verse eid="HOS 5:11" /><verse number="12" style="v" sid="HOS 5:12" />मुंह करनै एप्रैम गोत्रे लोग इहै खतम ज़िहै ल्हऐ झिकल़ै खाआ। यहूदा गोत्रे लोग करनै मुंह इहै बरैबाद ज़ेही काठा दी सूल़ी लागा।<verse eid="HOS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 5:13" />“एप्रैम गोत्रे लोगा का आसा थोघ कि तिंयां तै रोगी अर यहूदा गोत्रे लोग बी ज़ाणा तै कि तिंयां आसा ज़खमी। एप्रैम गोत्रा आल़ै च़ाहा तै इहअ कि अश्शूरी राज़अ तिन्‍नें मज़त करे, पर सह निं तिन्‍नां नरोगै करी सकअ नां तेऊ करै तिन्‍नें ज़खम ताझ़ुऐ। <verse eid="HOS 5:13" /><verse number="14" style="v" sid="HOS 5:14" />मुंह पल़णअ एप्रैम अर यहूदा लै सिहा ज़िहै चुटी। मुंह करनै आप्पै तिन्‍नें धेल़ी करै ठोर-ठोर संघा डाहणैं शोटी। ज़ेभै तिंयां मुंह घिशणै, तेभै निं तिन्‍नां मुखा छ़ड़ैऊंणै आल़अ कोह हणअ।<verse eid="HOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HOS 5:15" />“तेखअ डेऊणअ मुंह आपणीं ज़ैगा लै बापस फिरी। मुंह दैणअ तिन्‍नां तिन्‍नें पापे पठी सज़ा भुगतणै। ज़ांऊं तिंयां खास्सी दाह ज़िरी मुक्‍कणैं, तेखअ फिरनैं तिंयां पिछ़ू मुंह लोल़ै अर तेखअ सोठणअ तिन्‍नां भिई कि तिंयां मेरी च़ाकरी करे।”<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">लोगा करनअ पछ़ताअ करनैओ दखाअ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 6:1" />लोगा बोल़णअ इहअ, “होलो! बिधाते च़ाकरी करदै च़ाल्‍ला बापस। अह आसा सह ई ज़ुंणीं हाम्हैं धेल़ै-च़िरै! ऐबै नरोगै बी करनै हाम्हैं तेऊ ई, ईंयां ज़खम पाऐ हाम्हां लै तेऊ ई अर एथ मल्हम बी लाणअ तेऊ ई। <verse eid="HOS 6:1" /><verse number="2" style="v" sid="HOS 6:2" />तेऊ करनै हाम्हैं छ़ेक्‍कै ताज़ै-नरोगै, चिऊथै धैल़ै करनै तेऊ हाम्हैं भिई ज़िऊंदै। तेखअ सका हाम्हैं तेऊ संघै रही। <verse eid="HOS 6:2" /><verse number="3" style="v" sid="HOS 6:3" />हाम्हां हुई बिधाते बारै थोघ करना लै मैन्थ करनी कि सह कुंण आसा। सह हणअ हाम्हां लै दोत्ती सुरज़ा ज़िहअ ज़रूर प्रगट। सह एछणअ हाम्हां प्रैंदै भराल़ै बरशणैं आल़ै सरगे पाणीं ज़िहअ ज़ेता करै धरनीं साल-फसला लै राम्बल़ी बाच पल़ा।”<verse eid="HOS 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 6:4" />पर बिधाता बोला इहअ, “एप्रैम अर यहूदा मुल्खे लोगो, मुंह गई तम्हां लै किज़ै करूं? थारअ मुल्है झ़ूरनअ लुक्‍का दोत्ती धूँईं ज़िहअ झ़ट च़ारै! सह मुक्‍का दोत्ती ओशा ज़िहअ हेरा-हेरी! <verse eid="HOS 6:4" /><verse number="5" style="v" sid="HOS 6:5" />तैही रहअ आपणैं गूरा बाती तम्हां लै इहअ समाद दैंदअ लागी कि मुंह करनअ थारअ नसाफ अर तम्हैं लाऐ मंऐं खतम करी। मेरअ नसाफ एछणअ दोत्ती धुप्पै ज़िहअ। <verse eid="HOS 6:5" /><verse number="6" style="v" sid="HOS 6:6" />हुंह निं थारै डागै-चैणैंओ बल़ीदान च़ाहंदअ, हुंह च़ाहा इहअ कि तम्हैं तत्त दिला का मुल्है झ़ूरे। थारै हूम बल़ीदाना का खास्सअ च़ाहा हुंह इहअ कि तम्हैं मुंह परमेशरे बारै समझ़ डाहे।<note caller="-" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मोत्त. 9:13</ref>; <ref loc="MAT 12:7">12:7</ref></char></note><verse eid="HOS 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HOS 6:7" />“पर तम्हैं चोल़ी मेरी करार आदमा ज़ेही। तम्हैं निं मेरी च़ाकरी करना लै शुचै-पाक्‍कै रहै। <verse eid="HOS 6:7" /><verse number="8" style="v" sid="HOS 6:8" />तम्हैं गलाद नगरी बस्सै दै लोग आसा हत्या करनै आल़ै कदुष्ट। <verse eid="HOS 6:8" /><verse number="9" style="v" sid="HOS 6:9" />तम्हैं प्रोहत आसा डाकूओ छ़ुंढ ज़ुंण लुक्‍की करै होरी लुटणें ताका हआ बेठै दै। शकेम नगरी डेऊणे बाता करा तम्हैं लोगे हत्या। ज़ुंण तम्हैं ज़ुल्म करा, सह आसा माहा पाप। <verse eid="HOS 6:9" /><verse number="10" style="v" sid="HOS 6:10" />मुखा शुझुअ कि इज़राईल देश आसा बेघै च़िल़्हखरै कामां करदअ लागदअ। एप्रैम आसा कंज़री बेटल़ी ज़िहअ ज़ुंण होरी मर्धा लै आपणीं देही बेच़ा। हाँ, इज़राईली लोग हुऐ पठ छ़ोतलै।<verse eid="HOS 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 6:11" />“यहूदे लोगो, तम्हां लै बी दैणीं मुंह इज़राईली ज़ेही सज़ा, तेता लै आसा मंऐं धैल़ी काढी डाही दी। पर हुंह च़ाहा मेरी परज़ा बापस आणनअ।<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 7:1" />“ज़ेभै बी हुंह च़ाहा इहअ कि मेरी इज़राईली परज़ा लोल़ी भिई ताज़ी-नरोगी हुई, पर मुखा शुझिआ कि एप्रैमी लोग आसा पठी कदुष्ट हुऐ दै अर सामरी नगरीए लोग आसा खास्सै ज़ुल्म करदै लागै दै! तिंयां ठगा एकी-दुजै! तिंयां पाआ होरीए घअरा का च़िज़ा च़ोरी, तिन्‍नां डाकूए छ़ुंढ पल़ा बाता-बणैं लोगा लुटदै चुटी। <verse eid="HOS 7:1" /><verse number="2" style="v" sid="HOS 7:2" />तिंयां निं धख बी इहअ सोठदै कि हुंह बिधाता डाहा तिन्‍नें इना सोभी कदुष्ट कामां आद! तिन्‍नें पापा करै आसा तिंयां फेरा-फेर गोठुऐ दै। हर ज़ैगा हआ मुखा तिन्‍नें पाप शुझदै लागै दै।”<verse eid="HOS 7:2" /></para>
  <para style="s">राज़ मैहलै द्रोह</para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 7:3" />बिधाता बोला इहअ, “तिन्‍नें पापा करै हआ राज़ै बी खुश अर तिन्‍नें कार-करिंदै बी हआ ठगी करनै अर झ़ुठअ बोल़णा लै खुश। <verse eid="HOS 7:3" /><verse number="4" style="v" sid="HOS 7:4" />तिंयां सोभ करा मुल्है धोखअ। तिंयां आसा तात्ती तऊई ज़िहै, ज़ांऊं मल़ेगे मुछ़ी डाहअ द पिठअ सिज़ी जाआ, सह झमाऊंआं तेता आग फुकरी करै होर बी खास्सी। <verse eid="HOS 7:4" /><verse number="5" style="v" sid="HOS 7:5" />राज़े ज़ल्म धैल़ी झुटा कार-करिंदै अर राज़अ खास्सी शराब। राज़अ ज़ुल़ा तिन्‍नां संघै ज़ुंण तेऊ लै भरोस्सैमंद हणैंओ दखाअ करा। <verse eid="HOS 7:5" /><verse number="6" style="v" sid="HOS 7:6" />पर तिंयां कार-करिंदै हआ तेऊए हत्या करने बारै सोठदै लागै दै, भितरी हआ तिन्‍नां तऊई झमाऊंदी आगी ज़िहै रोश्श लागै दै! सह आग हआ भितरी तिन्‍नां सारी राची कोइलै ज़ेही अर दोत्ती भका तेता का आगीओ घैनअ। <verse eid="HOS 7:6" /><verse number="7" style="v" sid="HOS 7:7" />आपणैं तेऊ आगी ज़िहै तात्तै रोश्शा करै करा तिंयां आप्पू प्रैंदै राज़ करनै आल़ेए हत्या। तिन्‍नैं पाऐ आपणैं सोभ राज़ै एक-एक करी मारी। पर तिन्‍नैं निं कोही बी मुंह बिधाता सेटा लेर-पकार पाई मज़त मांगी।”<verse eid="HOS 7:7" /></para>
  <para style="s">इज़राईल अर होर देश</para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 7:8" />बिधाता बोला इहअ, “एप्रैम गोत्रे लोग रल़ै आप्पू फेर होरी देशा संघै। तिंयां आसा आधै काच़ै रोटा ज़िहै बृथा! <verse eid="HOS 7:8" /><verse number="9" style="v" sid="HOS 7:9" />तिंयां निं समझ़दै ई आथी कि परदेसी लोगै किअ तिन्‍नों ज़ोर ई खतम पर तज़ी बी निं तिंयां मुंह बिधाता बाखा बापस फिरदै ज़ुंण तिन्‍नों परमेशर आसा। <verse eid="HOS 7:9" /><verse number="10" style="v" sid="HOS 7:10" />इज़राईली आसा घमंडी, तिंयां निं बदल़णअ ई च़ाहंदै, अह घमंड आसा तिन्‍नों शाजत कि तिंयां आसा दोशी। तज़ी बी निं तिंयां मुंह बिधाता बाखा बापस फिरदै ज़ुंण तिन्‍नों परमेशर आसा अर नां मुंह लोल़ै लागदै। <verse eid="HOS 7:10" /><verse number="11" style="v" sid="HOS 7:11" />एप्रैम गोत्रे लोग आसा ऐडी पालल़ी ज़िहै, तिन्‍नां का निं थोघ ई आथी कि डैअ केथ बाखा दैणअ! पैहलै डेऊऐ तिंयां मिसर देशा का मज़त मांगदै अर तिधा का हटी डेओआ तिंयां अश्शूरी लोगा का मज़त मांगदै! <verse eid="HOS 7:11" /><verse number="12" style="v" sid="HOS 7:12" />पर मुंह फुआरनअ तिन्‍नां लै आपणअ ज़ज़ाल़ अर तिंयां ढाकणैं मुंह ज़िहै सरगै डैअ दैंदै च़ेल्‍लू ढाका। ज़ुंण तिंयां बूरै कामां लै साझ़ू हुऐ, तेता लै दैणीं मुंह तिन्‍नां लै सज़ा।<verse eid="HOS 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 7:13" />“तिन्‍नां लै आसा आफ़त! तिन्‍नैं छ़ाडअ हुंह अर तिन्‍नैं किअ मुल्है द्रोह। तिन्‍नों हणअ बनाश! हुंह च़ाहा तिन्‍नां बच़ाऊंणअ पर तिंयां बोला मुखा झ़ुठअ ई! <verse eid="HOS 7:13" /><verse number="14" style="v" sid="HOS 7:14" />तिंयां निं तत्त दिला का मुंह सेटा अरज़ ई करदै! पर तिंयां रहा आपणैं च़ैनैं उटी बाखा सुत्ती ज़ोरै-ज़ोरै लेरदै लागी। तिंयां करा पराऐ देअआ सेटा आपणीं देही दी च़िरै पाई दाख अर नाज़े साल-फसल हणां लै अरज़ अर मुखा आसा तिंयां दूर हुऐ दै। <verse eid="HOS 7:14" /><verse number="15" style="v" sid="HOS 7:15" />सह त हुंह ज़ुंणीं तिन्‍नां लै भली शिक्षा दैनी। तिन्‍नां बलबान बणाणैं आल़अ आसा हुंह। पर तिन्‍नैं किअ मुल्है ई द्रोह। <verse eid="HOS 7:15" /><verse number="16" style="v" sid="HOS 7:16" />तिंयां भाल़ा फेर सारै दी पर उझै निं तिंयां मुंह बाखा भाल़दै कि मुखा मज़त मांगे! तिंयां आसा धोखै दैणैं आल़ै कबाणा ज़िहै। तिन्‍नें सैणैं आसा आपणैं ज़ोरा दी बडअ घमंड पर तिंयां मरनै जुधा दी। तेखअ लागणै मिसर देशे लोग तिन्‍नां लै हास्सदै।”<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">इज़राईले मुहुर्ती पूज़ा पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 8:1" />बिधाता बोला इहअ, “चतैनगी दैणा लै बाज़ा नर्शिंगै! दुशमण पल़ै मुक्षरलै ज़िहै उटअ डैअ दैई मेरी ज़ैगा लै चुटी! मेरी परज़ा पाई मुंह संघै मेरी करार चोल़ी, तिन्‍नैं किअ मेरै बधाना लै द्रोह। <verse eid="HOS 8:1" /><verse number="2" style="v" sid="HOS 8:2" />तज़ी बी मांगणी तिन्‍नां मुंह परमेशरा का मज़त, तिन्‍नां बोल़णअ इहअ, ‘हाम्हैं इज़राईली ज़ाणा ताह कि तूह आसा म्हारअ परमेशर।’ <verse eid="HOS 8:2" /><verse number="3" style="v" sid="HOS 8:3" />पर इज़राईली निं भलअ करदै ई आथी! तैही पल़ै तिन्‍नें दुशमण तिन्‍नां पिछ़ू।<verse eid="HOS 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 8:4" />“मेरी परज़ा छ़ांटा आप्पू लै आपणीं मरज़ीए राज़ै, तेता लै निं तिंयां मुंह पुछ़दै आथी। तिंयां छ़ांटा आप्पू प्रैंदै सैणैं पर मेरी ज़ाज़त निं तिंयां तेता लै लंदै। तिंयां बणाआं आपणैं सुन्‍नैं-च़ंदी करै आप्पू लै मुहुर्ती ज़ेता करै तिन्‍नों आपणअ बनाश हआ। <verse eid="HOS 8:4" /><verse number="5" style="v" sid="HOS 8:5" />सामरी नगरीए लोगे सुन्‍नें बाछ़ूए पूज़ा करनै का आसा मुंह नफरत। मुंह आसा तिन्‍नां लै खास्सी रोश्शै आई दी। इहअ कधू हणअ कि तिंयां किछ़ै कशूर निं करे। <verse eid="HOS 8:5" /><verse number="6" style="v" sid="HOS 8:6" />इज़राईली कारीगीर बणाआं मुहुर्ती, पर तिंयां निं परमेशर आथी ई! सामरी नगरी सुन्‍नें बाछ़ूए हणैं ठोर-ठोर। <verse eid="HOS 8:6" /><verse number="7" style="v" sid="HOS 8:7" />इज़राईली परज़ा डाही बागरी बऊई। ढिश-डुआल़अ हणीं तिन्‍नें फसल ज़ुंण तिन्‍नां झाल़णीं! तिन्‍नें साल-फसल हणीं पोल्‍ली, तेथ निं किछ़ नाज़ निखल़णअ अर नां तेता का पिठअ हणअ। ज़ै तेथ धख नाज़ लागे बी, सह पाणअ परदेसी लोगा आप्पू लै। <verse eid="HOS 8:7" /><verse number="8" style="v" sid="HOS 8:8" />इज़राईल देश हणअ होरी देशा जैंदरी बाख खतम। सह हणअ फुटै दै गाडल़ू ज़िहअ बृथा। <verse eid="HOS 8:8" /><verse number="9" style="v" sid="HOS 8:9" />इज़राईली सैणैं आसा बरेल़्हुऐ दै बणें गाधै ज़िहै ज़हा ओर्ही अर पोर्ही ठुर्हा हआ लागी दी। तिंयां डेऊऐ अश्शूरी सेटा मज़त मांगदै। एप्रैमी लोगै मांगी ढब्बै दैई आपणैं अश्शूरी लोभी का मज़त! <verse eid="HOS 8:9" /><verse number="10" style="v" sid="HOS 8:10" />पर ऐबै लाऐ मंऐं तिंयां झाल़ी करै कठा करी संघा दैणीं मुंह तिन्‍नां लै सज़ा। ऐबै जाणीं तिन्‍नां छ़ेक्‍कै दाहे झोशा उझ़ुई ज़ांऊं तिंयां अश्शूर देशे राज़ै तिन्‍नें बूरी दशा करनी।<verse eid="HOS 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 8:11" />“एप्रैमी लोगै आसा बेदी बणाईं दी ज़ेथ पाप दूर करना लै पाप बल़ीदान करे, पर तिंयां बेदी हुई एही ज़ैगा ज़ेथ लोग होर बी खास्सअ पाप करा। <verse eid="HOS 8:11" /><verse number="12" style="v" sid="HOS 8:12" />मंऐं खोज़अ खास्सी शिक्षा दैई मेरी परज़ा का मेरअ बधान, पर तिन्‍नैं समझ़ी तिंयां गल्‍ला पराई। <verse eid="HOS 8:12" /><verse number="13" style="v" sid="HOS 8:13" />तिंयां करा मुल्है बल़ीदान अर तेता का शिखा बी खाआ। पर हुंह बिधाता निं तिन्‍नें बल़ीदाना करै खुश हंदअ। ऐबै करनै मुंह तिन्‍नें पाप आद संघा दैणीं मुंह तेता पिछ़ू तिन्‍नां लै सज़ा। तिन्‍नां लागणअ मिसर देशा लै बापस डेऊणअ।<verse eid="HOS 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HOS 8:14" />“मेरी इज़राईली परज़ा बणाऐं ज़ैगै-ज़ैगै मैहल, पर हुंह बिस्सरअ तिन्‍नैं पठी ज़ुंणीं तिंयां बणाऐं। यहूदा मुल्खे परज़ा बणाईं कई गहल़ा आल़ी नगरी, पर मुंह छ़ाडणीं आग अर तैहा करनै तिन्‍नें तिंयां नगरी अर मैहल पठी बरैबाद।”<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">इज़राईला लै सज़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 9:1" />इज़राईलीओ! तम्हैं निं होरी देशा ज़ेही खुशी मनाऊंदै लागा। तम्हैं हुऐ थारै परमेशरा का दूर अर तम्हैं निं तेऊ लै शुचै-पाक्‍कै रहै। तम्हैं बिक्‍कै कंज़री बेटल़ी ज़िहै बाल देअआ लै! तम्हैं झ़ूरै तेऊ नाज़ा लै ज़ुंणी हर खहल़ै थारी कंज़रैईए किम्मत दैनी। <verse eid="HOS 9:1" /><verse number="2" style="v" sid="HOS 9:2" />पर खहल़ो नाज़ निं थारै लोगा लै पूरअ पल़णअ। ज़ुंण तम्हैं कोफरी दाखो रस झाल़अ, तेता करै बी निं तम्हैं रज्ज़णै। <verse eid="HOS 9:2" /><verse number="3" style="v" sid="HOS 9:3" />तम्हैं निं ऐबै बिधाते देशै रहणैं। एप्रैम! ताह लागणअ मिसर देशे गलामी लै फिरी डेऊणअ। ताह लागणीं अश्शूर देशे छ़ोतली च़िज़ा खाणीं। <verse eid="HOS 9:3" /><verse number="4" style="v" sid="HOS 9:4" />तिन्‍नां पराऐ देशै निं तम्हां बिधाता लै दाखे रसो अर्घअ दैणअ भेटणअ अर नां बिधाता थारै बल़ीदाना करै खुश हणअ। थारअ भोज़न ज़ुंण बी खाए, तेता करै लागणीं तिन्‍नां छ़ोत, सह हणअ मरगे धैल़ी रोटी खाणैं ज़िहअ। सह भोज़न हणअ सिधअ पेटे भुख शांत करना लै, पर सह निं बिधाते भबनै छ़ाडणैं जोगी हणअ। <verse eid="HOS 9:4" /><verse number="5" style="v" sid="HOS 9:5" />गलामी दी रहंदी ज़ांऊं मुंह बिधाते अदर करना लै तिह-थैरे धैल़ै एछणैं, तेथ निं तम्हैं किछ़ करनै जोगी हणैं! <verse eid="HOS 9:5" /><verse number="6" style="v" sid="HOS 9:6" />भाल़ा! ज़ांऊं अश्शूर देशे सैना चुटी पल़णअ, तम्हां मांझ़ै जाणैं कई तेऊ बनाशा का बच़ी निखल़ी। तिंयां ढाकणैं मिसर देशे सैना। तिंयां मरनै माफीस नाओंए ज़ैगा अर लोगा डाहणैं तिंयां तिधी दाबी। तिन्‍नें सुन्‍नैं-च़ंदीए किम्मती च़िज़ा रहणीं कुंगशी-कार्हलै जैंदरी पल़ी अर तिन्‍नें घअरै राझ़णैं झ़िंझ़रे कांडै ज़ेते तिंयां मालक थिऐ।<verse eid="HOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HOS 9:7" />सज़ा दैणैंओ बगत गअ पुजी, तिंयां धैल़ै गऐ नेल़ एछी ज़ेभै तम्हां थारै पापो बदल़अ भेटणअ। ज़ेभै इहअ हणअ, तेभै जाणअ तम्हां इज़राईली का एतो थोघ लागी ज़ुंण तम्हैं इहअ बोला, “अह गूर आसा ऐडअ, अह बिधातो समाद खोज़णैं आल़अ मणछ आसा बेगरअ।” तम्हैं लोग करा मुल्है खास्सी नफरत किल्हैकि तम्हैं आसा खास्सै पाप किऐ दै।<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LUK 21:22">लूक. 21:22</ref></char></note> <verse eid="HOS 9:7" /><verse number="8" style="v" sid="HOS 9:8" />बिधाता छ़ाडअ हुंह आपणअ गूर कि हुंह तेऊए परज़ा एप्रैमा लै चतैनगी दैए। पर ज़िधी बी हुंह डेओआ, तम्हैं च़ाहा मुंह ढाकणअ ज़िहअ शकारी आपणैं ज़ज़ाल़ा दी च़ेल्‍लू ढाका। बिधाते भबनै तोही आसा तम्हैं मुंह बिधाते गूरे दुशमण हुऐ दै। <verse eid="HOS 9:8" /><verse number="9" style="v" sid="HOS 9:9" />तम्हैं आसा पापा दी तिहै ई डुबै दै ज़िहै थारै लोगै गिबा नगरी घोर पाप किऐ तै। बिधाता डाहणैं तिन्‍नें पाप आद अर तेऊ दैणीं तिन्‍नां लै तेते सज़ा ज़रूर।<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">पांच़ 19:1-30</ref></char></note><verse eid="HOS 9:9" /></para>
  <para style="s">इज़राईलो पाप अर तेतो फल</para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 9:10" />बिधाता बोला इहअ, “ज़धू मुंह इज़राईल पैहली बारी भेटअ, सह त रेगीस्तानै दाखे बेला भेटणैं ज़िहअ। ज़धू मंऐं थारै दाद-बाब पैहली बारी भाल़ै, तिंयां तै इहै, ज़िहअ कि मंऐं भाल़ै पैहलकै भ्रहे पाक्‍कै फेडू। पर ज़ांऊं तिंयां बाल-पोर धारा आऐ, तिधी पुजी लागै तिंयां बाल देअए पूज़ा करदै अर खिरी हुऐ तिंयां झ़ट च़ारै तिन्‍नां ई देअआ ज़िहै च़िल़्हखरै ज़हा लै तिंयां झ़ूरा तै।<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 25:1-5">गण. 25:1-5</ref></char></note> <verse eid="HOS 9:10" /><verse number="11" style="v" sid="HOS 9:11" />एप्रैमे शोभा लुक्‍कणी ज़िहअ च़ेल्‍लू डैअ दैई दूर डेओआ। इज़राईले बेटल़ीओ निं आजू किछ़ हणअ-ज़ाणअ। तिंयां निं सुंदी ई हणीं। <verse eid="HOS 9:11" /><verse number="12" style="v" sid="HOS 9:12" />पर ज़ै तिंयां आपणैं शोहरू-शोहरी धाची करै बडै बी करे, तिंयां बी करनै मुंह तिन्‍नां का दूर कि तिन्‍नें पठी अत्री होए। ज़ांऊं मुंह इना मणछा छ़ाडी दूर डेऊणअ, सह बगत हणअ इना लै आफ़त।”<verse eid="HOS 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HOS 9:13" />मुखा शुझुअ कि एप्रैम आसा सूर नगरी ज़िहअ शोभली ज़ैगा बस्सअ द। पर ऐबै लागणै एप्रैमा आपणैं शोहरू-शोहरी दुशमणा सेटा मारना लै आणनैं! <verse eid="HOS 9:13" /><verse number="14" style="v" sid="HOS 9:14" />बिधाता, हुंह तेरी परज़ा लै किज़ै मांगूं? इहै ओदर ज़ेता का लुआद ई निं हंदी? कि एही च़ूई ज़ेता का दुध ई निं निखल़णअ!<verse eid="HOS 9:14" /></para>
  <para style="s">इज़राईला लै बिधातो नसाफ</para>
  <para style="p">
    <verse number="15" style="v" sid="HOS 9:15" />बिधाता बोला इहअ, “तिन्‍नें कदुष्ट कामां करने शुरूआत हुई गिलगाल नगरी का। तिधी का हुई मुंह बी तिन्‍नां का नफरत। तिन्‍नें कदुष्ट काम करनै पिछ़ू ई काढणैं मुंह तिंयां आपणीं ज़ैगा का दूर। ऐबै निं हुंह तिन्‍नां लै झ़ूरदअ, तिन्‍नें सोभी सैणैं किअ मुल्है द्रोह। <verse eid="HOS 9:15" /><verse number="16" style="v" sid="HOS 9:16" />एप्रैम आसा इहै बूटा ज़िहअ ज़ेते ज़लैल़ै शुक्‍की आसा गऐ दै अर ज़ेथ फल़ ई निं लागदै। तिन्‍नें निं आजू किछ़ हणअ, पर ज़ै तिन्‍नें बेटल़ी सूए बी, तिन्‍नें तिंयां बच़ै पाणै मुंह मारी ज़ुंण तिन्‍नें दिले काल़ज़ै आसा।”<verse eid="HOS 9:16" /></para>
  <para style="s">गूरै खोज़अ इज़राईले बारै</para>
  <para style="p">
    <verse number="17" style="v" sid="HOS 9:17" />परमेशर ज़सरी च़ाकरी हुंह करा तेऊ निं तिंयां मनणै, किल्हैकि तिन्‍नैं निं तेऊए इज़त किई। तिंयां रहणैं देशा-देशा जैंदरी ठुल़्दै लागी।<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 10:1" />इज़राईली आसा च़ुंढुई दी दाखे बेला ज़िहै ज़ेथ खास्सै दाखे लुम्बरू आसा लागै दै। ज़िहै ई तिंयां खास्सै सेठ हुऐ, तिन्‍नैं बणाईं होर बी खास्सी बेदी। ज़ेही तिन्‍नें ज़िम्मीं का खास्सी साल-फसल लागी हंदी, तिहै ई लागै तिंयां पूज़ा करना लै पात्थरे ओडै बणाऊंदै। <verse eid="HOS 10:1" /><verse number="2" style="v" sid="HOS 10:2" />तिन्‍नों मन्‍न च़ला दोहरअ, ऐबै लागणीं तिन्‍नां आपणैं पापे सज़ा भुगतणी। परमेशरा पाणीं तिन्‍नें बेदी ढोल़ी अर तिन्‍नें पूज़ा करने ओडै फाल़ी।<verse eid="HOS 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HOS 10:3" />तेखअ बोल़णअ ऐबै इना लोगा इहअ, “म्हारअ निं कोह राज़अ आथी अर तैही निं हाम्हैं बिधातो अदर किअ। ज़ै म्हारै राज़अ हंदअ बी, सह बी निं म्हारी किछ़ मज़त करी सकदअ त!” <verse eid="HOS 10:3" /><verse number="4" style="v" sid="HOS 10:4" />तिंयां दैआ ज़बान पर आपणीं ज़बान निं तिंयां पूरी करदै अर तिंयां करा बृथा करार। इहअ करै हआ नसाफे बाहै दै खेचै लागै दै झ़रीलै घाहा ज़ेही बेनसाफी।<verse eid="HOS 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 10:5" />राज़धानी सामरी नगरी बस्सै दै लोगा लागणीं डअर। तिन्‍नां करनअ सुन्‍नें बाछ़ू ज़ांऐं हणां लै शोग ज़ुंण बेताबेन नगरी आसा। तैहा बाछ़ूए मुहुर्तीए च़ाकरी करनै आल़ै प्रोहता बी लाणीं लेरा। तिन्‍नैं हेरअ ज़ाणीं कि दुशमणा निंणीं तिन्‍नें सुन्‍नें शोभली मुहुर्ती तिन्‍नां का दूर। <verse eid="HOS 10:5" /><verse number="6" style="v" sid="HOS 10:6" />सह बाछ़ूए मुहुर्ती निंणीं अश्शूरी सैना। सह करनी तिन्‍नां अश्शूरी माहा राज़ै लै भैंट। एप्रैमी लोगै ज़ुंण सलाह मनी, तिंयां हणैं तेता लै बेइज़त अर शर्मिंदै। <verse eid="HOS 10:6" /><verse number="7" style="v" sid="HOS 10:7" />सामरी नगरीए लोग अर तिन्‍नों राज़अ निंणै ज़िहअ गाडो पाणीं होछ़ै ज़िहै शेटू निंयां। <verse eid="HOS 10:7" /><verse number="8" style="v" sid="HOS 10:8" />उझै धारा पाप करने बेदी ज़ेथ इज़राईली मुहुर्तीए पूज़ा करा, तिंयां पाणीं ढोल़ी अर तेथ लागणै झ़िंझ़रै कांडै अर बाण-भेखल़। लोगा बोल़णअ धारा लै इहअ, “हाम्हां प्रैंदै ढूल़ा!” अर ढेक्‍का लै बोल़णअ इहअ, “हाम्हां डाहा दाबी!”<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="LUK 23:30">लूक. 23:30</ref>; <ref loc="REV 6:16">प्रका. 6:16</ref></char></note><verse eid="HOS 10:8" /></para>
  <para style="s">इज़राईला लै सज़ा</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 10:9" />बिधाता बोला इहअ, “इज़राईलीओ, तम्हैं आसा आझ़ बी तिहै ई पाप करदै लागै दै ज़िहअ थारै दादै-बाबै गिबा नगरी किअ त। गिबा ज़ुंणीं पाप किअ थिअ, तेतो फल भेटअ तिन्‍नां इहअ कि तिंयां हुऐ जुधा दी खतम।<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="JDG 19:1-30">पांच़ 19:1-30</ref></char></note> <verse eid="HOS 10:9" /><verse number="10" style="v" sid="HOS 10:10" />ज़ेभै मेरअ दिल बोले, मुंह दैणीं तिन्‍नां लै सज़ा ज़ुंण पापी आसा। तिन्‍नां लै करनअ देशा-देशा एक्‍कअ अर तिन्‍नां भेटणीं तेते सज़ा ज़ुंण तिन्‍नैं पाप किऐ।<verse eid="HOS 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HOS 10:11" />“एप्रैम त तैहा बाछ़ी ज़िहअ ज़ुंण मंऐं खहल़ै नाज़ा मांडणा लै थिई शखैल़ी दी, सह झ़ूरा ती खहल़ै फिरना लै। पर ऐबै सोठअ मंऐं इहअ कि तेसे ल्हाशै कैल़ै पाणअ मुंह जूँ। यहूदा ज़ुंडणअ मुंह हल़ै अर याकबा करै दैणअ ददाल़।”<verse eid="HOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 10:12" />मंऐं बोलअ त इहअ, “कृषाणा ज़िहअ बऊआ राम्बल़अ बेज़अ धर्म अर नसाफ। तै झाल़णीं तम्हां सह फसल ज़ुंण शुची झ़ूरी आसा। थारै दिल आसा शणैहतै खेचा ज़िहै, तेथ लाआ हल़। अह आसा तम्हां लै बिधाता सेटा बापस फिरनेओ बगत कि सह एछे अर तम्हां लै आपणीं बर्गते बरसात करे।”<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JER 4:3">जेर. 4:3</ref></char></note> <verse eid="HOS 10:12" /><verse number="13" style="v" sid="HOS 10:13" />पर तम्हैं लाअ हल़ संघा डाहै कदुष्ट काम बऊई अर तम्हैं झाल़ी तिन्‍नां ई पापे फसल। तम्हैं भुगतअ थारै धोखै दी रहणैंओ नतिज़अ।</para>
  <para style="p" vid="HOS 10:13">किल्हैकि तम्हैं तै आपणैं रथ-घोल़े आसरै रहै दै। तम्हैं सोठअ इहअ कि थारी बडी सैना अर तेता करै जाणैं तम्हैं बच़ी। <verse eid="HOS 10:13" /><verse number="14" style="v" sid="HOS 10:14" />तम्हां जाणअ छ़ेक्‍कै जुधो हाल्‍लअ-गोल्‍लअ शुण्हुंई। दुशमणा पाणै थारै बडै-बडै गहल़-कोट ढोल़ी, ज़िहै राज़ै शालमाने सैना बेथ-अरबेल नगरीओ बनाश किअ त। तेऊ जुधा लै पाई ती तेऊए नर्दैई सैना माआ तिन्‍नें होछ़ै शोहरू संघी मारी। <verse eid="HOS 10:14" /><verse number="15" style="v" sid="HOS 10:15" />बेतेल नगरीए लोगो, ज़ुंण तम्हैं घोर कदुष्ट काम किऐ, तेता पिछ़ू हणीं थारी बी एही ई दशा। ज़ेभै सह सज़ा दैणें धैल़ी एछणी, इज़राईल देशो राज़अ पाणअ मारी।<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">द्रोही परज़ा लै बी करा परमेशर झींण</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 11:1" />बिधाता बोला इहअ,</para>
  <para style="q" vid="HOS 11:1">“ज़धू इज़राईल लान्हअ थिअ,</para>
  <para style="q" vid="HOS 11:1">हुंह झ़ूरअ तेऊ लै कि सह आसा मेरअ शोहरू अर</para>
  <para style="q" vid="HOS 11:1">मंऐं शादअ मेरअ शोहरू कि मिसर देशा का निखल़े।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EXO 4:22">लुआ. 4:22</ref>; <ref loc="MAT 2:15">मोत्त. 2:15</ref></char></note><verse eid="HOS 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2" />पर ज़ेतरअ हुंह तेऊ लै बोला त, तेतरअ डेओआ त सह मुखा दूर!</para>
  <para style="q" vid="HOS 11:2">मेरी परज़ा करा तै बाल देअआ लै बल़ीदान,</para>
  <para style="q" vid="HOS 11:2">तिंयां करा तै मुहुर्ती सेटा धूप ज़ाल़ी तेते पूज़ा।<verse eid="HOS 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3" />सह त हुंह ज़ुंणीं एप्रैम होछ़ी उझै हाथै ढाकी नढैऊअ!</para>
  <para style="q" vid="HOS 11:3">तिंयां तै मंऐं आपणीं बाह दी ढाकै दै,</para>
  <para style="q" vid="HOS 11:3">पर तिन्‍नैं निं समझ़अ कि तिन्‍नें हेर-सभाल़ करनै आल़अ त हुंह।<verse eid="HOS 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4" />मंऐं नढैऊऐ तिंयां आपणीं झींण अर झ़ूरीए राश्शी करै,</para>
  <para style="q" vid="HOS 11:4">हुंह त तिन्‍नां लै इहै मणछा ज़िहअ ज़ुंणीं तिन्‍नें कैल़ै का जूँ पोर्ही खोल्हअ</para>
  <para style="q" vid="HOS 11:4">संघा दैनअ उटअ फिरी तिन्‍नां लै खाणां लै।<verse eid="HOS 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HOS 11:5" />“इज़राईली हणैं भिई गलाम ज़िहै तिंयां मिसर देशे गलामी दी आसा तै। पर एभकी बारी हणअ तिन्‍नां प्रैंदै राज़ करनै आल़अ अश्शूर देश। <verse eid="HOS 11:5" /><verse number="6" style="v" sid="HOS 11:6" />तिन्‍नें नगरी दी हणअ जुध अर तिन्‍नें बडी-बडी प्रऊल़ी पाणीं ढोल़ी। एता करै हणीं मेरी परज़ा बरैबाद किल्हैकि तिन्‍नैं किई आपणीं मन्‍न-मरज़ी। <verse eid="HOS 11:6" /><verse number="7" style="v" sid="HOS 11:7" />मेरी परज़ा ती मुंह छ़ाडी कबाता ई डेऊणे हठ ढाकी दी। तिंयां बोला मुल्है परम प्रधान परमेशर, पर असली दी निं तिंयां मेरअ अदर करदै।<verse eid="HOS 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8" />एप्रैम, हुंह किहअ करै डाहूं ताह शोटी?</para>
  <para style="q" vid="HOS 11:8">इज़राईल, एतरअ हणैं बाद बी निं हुंह निं ताह छ़ाडी सकदअ!</para>
  <para style="q" vid="HOS 11:8">हुंह निं ताह दुशमणा का सभाल़ी सकदअ!</para>
  <para style="q" vid="HOS 11:8">हुंह निं तेरअ अदमा अर सबोईम नगरी ज़िहअ बनाश करी सकदअ।</para>
  <para style="q" vid="HOS 11:8">मेरअ दिल निं इहअ करना लै बोल्दअ!</para>
  <para style="q" vid="HOS 11:8">हुंह झ़ूरा ताल्है बेघै खास्सअ।<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:23">बधा. 29:23</ref></char></note><verse eid="HOS 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9" />एप्रैम! मुंह निं ताल्है आपणअ कोप दैणअ पल़णै,</para>
  <para style="q" vid="HOS 11:9">मुंह निं मेरी इज़राईली परज़ो भिई बनाश करनअ।</para>
  <para style="q" vid="HOS 11:9">किल्हैकि हुंह निं मणछ आथी हुंह आसा परमेशर।</para>
  <para style="q" vid="HOS 11:9">हुंह आसा सह पबित्र ज़ुंण तम्हां जैंदरी रहा।</para>
  <para style="q" vid="HOS 11:9">ऐबै निं मुंह तम्हां सेटा रोश्शा संघी एछणअ।<verse eid="HOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 11:10" />“खिरी लागणअ मेरी परज़ा मुंह पिछ़ू हांढदै। ज़ांऊं मुंह बिधाता तिन्‍नें दुशमणा लै सिहा ज़ेही क्रुंगा पाणीं, मेरी परज़ा एछणअ डरदी-काम्बदी पछ़मा बाखा का फिरी। <verse eid="HOS 11:10" /><verse number="11" style="v" sid="HOS 11:11" />तिंयां एछणैं मिसर देशा का च़ेल्‍लू अर अश्शूर देशा का पालल़ी ज़िहै डैअ बाही। तिंयां पजैल़णैं मुंह तिन्‍नें घअरै भिई बापस। अह गल्‍ल डाही मंऐं बिधाता बोली।”<verse eid="HOS 11:11" /></para>
  <para style="s">इज़राईल अर यहूदा लै दोश</para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 11:12" />बिधाता बोला इहअ, “मेरी एप्रैमी परज़ा बोला हर बगत झ़ुठअ। इज़राईली दैआ मुल्है धोखअ। यहूदे लोग आसा अज़ी बी मुंह पबित्र परमेशरा लै द्रोह करदै लागै दै! तिंयां आसा मुहुर्ती पूज़णा लै शुचै-पाक्‍कै।<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 12:1" />“एप्रैमी लोग हआ होरी भाल़ै लागै दै कि तिंयां तिन्‍नें मज़त करे। अह आसा बागरी पिछ़ू ठुर्हनै ज़िहअ बृथा। तिंयां आसा पुर्बा बाखे तात्ती बागरी ढाकदै लागै दै! तेतो नतिज़अ निखल़ा इहअ कि तिंयां बोला होर बी खास्सअ झ़ुठअ अर तिंयां करा कबल्‍लअ उपद्रभ। तिंयां करा अश्शूर देशा संघै करार अर तिंयां मांगा जैतूनो तेल दैई मिसर देशा का मज़त।”<verse eid="HOS 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 12:2" />बिधाता लाऐ यहूदे लोग दालता दी खल़ै करी तिन्‍नों दोश खोज़ी। तेऊ लाई याकबे आद-लुआदा लै सज़ा दैई ज़ेही तिन्‍नैं बूरी ज़िन्दगी ज़िऊई। तेऊ दैणअ तिन्‍नां लै ज़िहै तिन्‍नैं पाप किऐ तिहअ ई फल बापस। <verse eid="HOS 12:2" /><verse number="3" style="v" sid="HOS 12:3" />पैईदा हणैं का आजी गअ याकब माए ओदरै आपणैं बडै भाई एसाबा संघै झ़घल़दअ लागी। ज़ांऊं याकब ज़ुआन हुअ, तेऊ किअ परमेशरा संघै झ़गल़अ।<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GEN 25:26">मूल. 25:26</ref></char></note> <verse eid="HOS 12:3" /><verse number="4" style="v" sid="HOS 12:4" />तेऊ किअ स्वर्ग दूता संघै झ़गल़अ अर ज़ितअ बी। तेऊ मांगी लेर-पकार पाई परमेशरा का बर्गत। बेतेल हुऐ याकबा परमेशरे दर्शण अर तिधी किई परमेशरै तेऊ संघै गल्‍ला।<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="GEN 28:10-22">मूल. 28:10-22</ref>; <ref loc="GEN 32:24-26">32:24-26</ref></char></note> <verse eid="HOS 12:4" /><verse number="5" style="v" sid="HOS 12:5" />सह त परमेशर बिधाता ज़ुंण स्वर्गे सारी सैनो मालक आसा, ज़हा हाम्हैं बिधाता नाअं बोली करै ज़ाणा। <verse eid="HOS 12:5" /><verse number="6" style="v" sid="HOS 12:6" />ऐबै तम्हैं ज़ुंण याकबे आद-लुआद आसा, तम्हैं रहा परमेशरे आसरै, संघा फिरा तेऊ बाखा बापस। आप्पू मांझ़ै करा धर्म अर नसाफ। सबर डाही रहा परमेशरा न्हैल़ै लागी।<verse eid="HOS 12:6" /></para>
  <para style="s">आजू बिधातो नसाफ</para>
  <para style="p">
    <verse number="7" style="v" sid="HOS 12:7" />बिधाता बोला इहअ, “तम्हैं आसा इहै बपारी ज़िहै ज़ुंण तराकल़ी तोलणां लै हेर-फेर करा। तम्हैं झ़ूरा लोगा ठगणा लै। <verse eid="HOS 12:7" /><verse number="8" style="v" sid="HOS 12:8" />एप्रैमी लोगो, तम्हैं मारा एही डिंगा, ‘हाम्हैं आसा सेठ, हाम्हैं हुऐ धन-माया आल़ै। हाम्हां लै निं कोह इहअ दोश लाई सकदअ कि हाम्हैं हुऐ ठगी करी सेठ!’ <verse eid="HOS 12:8" /><verse number="9" style="v" sid="HOS 12:9" />पर हुंह आसा थारअ परमेशर बिधाता ज़ुंणीं तम्हैं मिसर देशा का आणै, तम्हां लै करनअ मुंह इहअ कि तम्हां पल़णअ भिई खिम्भा दी बस्सणअ ज़िहै तम्हैं तिह-थैरे पैहलै रेगीस्तानै रहा तै।<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="LEV 23:42">लेब. 23:42</ref>,<ref loc="LEV 23:43">43</ref></char></note><verse eid="HOS 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 12:10" />“मंऐं किई गूरा संघा गल्‍ला, तिन्‍नां का रहैऊऐ मंऐं कई सुपनै। तिन्‍नां गूरा बाती दैनी मंऐं तम्हां लै चतैनगी। <verse eid="HOS 12:10" /><verse number="11" style="v" sid="HOS 12:11" />तज़ी बी करा गलाद मुल्खै बस्सै दै लोग बृथा मुहुर्तीए पूज़ा! तेते पूज़ा करनै आल़ैओ हणअ बनाश। गिलगाल बस्सै दै लोग करा देअआ लै बल्दो बल़ीदान! तिन्‍नें बेदी हणीं बाहै दै खेचै झाल़ै दै पात्थरे रूल़ा ज़ेही।”<verse eid="HOS 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 12:12" />म्हारअ दाद-बाब याकब ठुर्हअ त अराम देशा लै, तिधी रहअ सह गलाम कि तेऊ आप्पू लै बेटल़ी भेटे। सह रहअ लाबान नाओंए मणछे घअरै तेऊए भेडा-बाकरी च़राऊंदअ।<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="GEN 29:1-20">मूल. 29:1-20</ref></char></note> <verse eid="HOS 12:12" /><verse number="13" style="v" sid="HOS 12:13" />बिधाता छ़ाडअ आपणअ गूर इज़राईली मिसर देशे गलामी का काढदअ अर आपणैं गूरा करै किई तेऊ तिन्‍नें फाज़त।<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="EXO 12:50">लुआ. 12:50</ref></char></note> <verse eid="HOS 12:13" /><verse number="14" style="v" sid="HOS 12:14" />पर एप्रैमी लोगै ठैऊई बिधाता लै खास्सी रोश्श। तिन्‍नें घोर पापा लै पाणै बिधाता तिंयां मारी। ज़ुंण तिन्‍नैं परमेशर बेइज़त किअ, तेते बदल़ै लणी परमेशरा तिन्‍नां लै सज़ा दैई।<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s">खिरी इज़राईलो नसाफ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 13:1" />एक ज़मानअ त इहअ कि एप्रैम गोत्र ज़ेभै बोला थिअ, इज़राईले होर गोत्रा छ़ुटा ती डरै काम्मणीं, एप्रैम त इज़राईला मांझ़ै सोभी का खास। पर ज़ांऊं एप्रैमी लोगै बाल देअए पूज़ा करी पाप किअ, तेता करै हुअ तिन्‍नों बनाश। <verse eid="HOS 13:1" /><verse number="2" style="v" sid="HOS 13:2" />ऐबै आसा एप्रैम मुल्खे लोग होर बी खास्सै पाप करदै लागै दै। तिंयां बणाआं आप्पू लै आपणीं च़ंदी करै देअए मुहुर्ती। तेता बणाणां लै लाआ तिंयां मणछ आपणअ दमाग अर समझ़। तिंयां सोभ मुहुर्ती आसा सज़ाण कारीगीरै बणाईं दी। तिंयां बोला इहअ, “इना मुहुर्ती लै करा बल़ीदान, अर बाछ़ूए मुहुर्ती लै दैआ माख्खू!” <verse eid="HOS 13:2" /><verse number="3" style="v" sid="HOS 13:3" />तैही उडणैं ईंयां लोग दोत्ती धूँईं ज़िहै झ़ट च़ारै अर ईंयां शुक्‍कणैं दोत्ती पल़ी दी ओशा ज़िहै हेरा-हेरी। तिंयां हणैं किशा ज़िहै ज़ेता बागरी ताटी का दूर फर्ल़ाऊआ अर तिंयां उडणैं धुंघरा बाती धूँआं ज़िहै।<verse eid="HOS 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 13:4" />बिधाता बोला इहअ, “हुंह आसा थारअ परमेशर बिधाता ज़ुंणीं तम्हैं मिसर देशा का आणै काढी। तम्हैं निं होरी देअए च़ाकरी करदै लागी। मुखा सुआई निं तम्हां कोह बच़ाऊई सकदअ। <verse eid="HOS 13:4" /><verse number="5" style="v" sid="HOS 13:5" />मंऐं किई शुक्‍कै-रुखै रेगीस्तानै थारी हेर-सभाल़।<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 8:11-17">बधा. 8:11-17</ref></char></note> <verse eid="HOS 13:5" /><verse number="6" style="v" sid="HOS 13:6" />पर ज़ांऊं तम्हैं रज़दी-पज़दी ज़ैगा पुजी रज्ज़ी खाणां लै भेटअ, तेखअ हुऐ तम्हैं शरेरै अर हुंह बिस्सरअ तम्हैं पठी। <verse eid="HOS 13:6" /><verse number="7" style="v" sid="HOS 13:7" />तैही पल़णअ मुंह तम्हां लै सिहा ज़िहै चुटी। मुंह रहणअ बाता तम्हां लै च़राघा ज़िहै तम्हां ढाकणें ताका बेशी। <verse eid="HOS 13:7" /><verse number="8" style="v" sid="HOS 13:8" />मुंह ब्रूज़णै भाल्‍लणी ज़िहै ज़ुंण आपणैं लुक्‍कै दै बच्च़ै लोल़ी हआ लागी दी। मुंह पाणै तम्हैं धेल़ी-च़िरी। तम्हैं खाणैं मुंह भुखै सिहा ज़िहै तिधी। मुंह पल़णअ तम्हां मारदै बणें ज़ीबा ज़िहै चुटी।<verse eid="HOS 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 13:9" />“इज़राईलीओ! थारअ करनअ मुंह बनाश। तम्हां निं कुंण बच़ाऊंणै आल़अ भेटणअ। <verse eid="HOS 13:9" /><verse number="10" style="v" sid="HOS 13:10" />तम्हैं तै आपणैं राज़ेए आसरै कि तेऊ हेरनै तम्हैं सोभी नगरी दी बच़ाऊई, पर सह निं किछ़ करी सकअ! तम्हां प्रैंदै राज़ करनै आल़ै पांच़ बी निं तम्हां बच़ाऊई सकै! तम्हैं पाई ती मुखा मांग कि होरी देशा ज़िहै लोल़ी तम्हां बी आप्पू प्रैंदै पांच़ अर राज़ै। पर इना मांझ़ै निं तम्हां कोह बच़ाऊई सकै।<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 शमू. 8:5</ref>,<ref loc="1SA 8:6">6</ref></char></note> <verse eid="HOS 13:10" /><verse number="11" style="v" sid="HOS 13:11" />रोश्शै दैनै मंऐं तम्हां लै राज़ै, पर ऐबै आसा मुंह इहअ कोप फिरअ द कि मुंह करनै तम्हां का तिंयां राज़ै दूर!<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="1SA 10:17-24">1 शमू. 10:17-24</ref>; <ref loc="1SA 15:26">15:26</ref></char></note><verse eid="HOS 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 13:12" />“मंऐं आसा एप्रैमे पाप-दोश लिखी अर सभाल़ी डाहै दै, तिन्‍नें पाप आसा मंऐं लिखी-जोखी हाल़्है डाहै दै। <verse eid="HOS 13:12" /><verse number="13" style="v" sid="HOS 13:13" />तिन्‍नां उझ़णै सूंणें दाह लागी दी बेटल़ी ज़िहै शूल़। तिंयां आसा कमुर्ख लान्हैं ज़िहै, अह आसा तिन्‍नों ज़ल्म हणैंओ बगत पर तिंयां निं माए ओदरा का बागै निखल़णअ ई च़ाहंदै! <verse eid="HOS 13:13" /><verse number="14" style="v" sid="HOS 13:14" />हुंह निं तिन्‍नां जम्परी डेऊणैं का छ़ड़ैऊंदअ, नां हुंह तिन्‍नां मरनै का बच़ाऊंदअ। ओ मौत, तूह आण आपणीं माहा मरी! जम्पर, तूह आण बनाश! हुंह निं ऐबै आपणीं परज़ा लै झींण करदअ।<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="1CO 15:55">1 करि. 15:55</ref></char></note> <verse eid="HOS 13:14" /><verse number="15" style="v" sid="HOS 13:15" />च़ाऐ इज़राईल होरी देशा जैंदरी फल़दी बुटी ज़िहअ सफल किल्है निं होए, पर मुंह बिधाता छ़ाडणीं रेगीस्ताना का पुर्बा बाखे तात्ती बागरी। तेता करै शुक्‍कणीं तिन्‍नें पाणींए गाडा अर कुहै पठ। तिन्‍नें किम्मती भढार लुटणैं पठी। <verse eid="HOS 13:15" /><verse number="16" style="v" sid="HOS 13:16" />राज़धानी सामरी नगरी बस्सै दै इज़राईली किअ मुंह बिधाता लै द्रोह करी पाप, तिन्‍नां लागणीं तेता पिछ़ू सज़ा भुगतणी। तिंयां मरनै जुधा दी तिन्‍नें लान्हैं मारनै धरनीं फणाटी करै, तिन्‍नें सुंदी बेटल़ीए डाहणैं पेट फाल़ी।”<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">खिरी बस्सणअ इज़राईल भिई</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 14:1" />इज़राईलीओ, आपणैं परमेशर बिधाता बाखा फिरा बापस! थारै पाप करनै पिछ़ू हुऐ तम्हैं बरैबाद। <verse eid="HOS 14:1" /><verse number="2" style="v" sid="HOS 14:2" />बिधाता सेटा लै एछा बापस संघा करा तेऊ सेटा एही अरज़, “बिधाता, ज़ीबाण म्हारै सोभ पाप कर माफ, म्हारी अरज़ शुण, हाम्हां करनअ ताल्है शूकर सह हणअ हाम्हां बाखा ताल्है बल़ीदान। <verse eid="HOS 14:2" /><verse number="3" style="v" sid="HOS 14:3" />अश्शूरी निं हाम्हां बच़ाऊई सकदै। तिन्‍नां घोल़ै करै निं म्हारी फाज़त हंदी ज़ेते शुंआरी हाम्हैं जुधा लै डेओआ। ऐबै निं हाम्हां मुहुर्ती लै कधि बोल़णअ कि तिंयां आसा म्हारै दईब। बिधाता, तूह करा छ़ुटै-मुक्‍कै दै लान्हैं लै झींण।”<verse eid="HOS 14:3" /></para>
  <para style="s">बिधाता दैणीं इज़राईला लै नऊंईं ज़िन्दगी</para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 14:4" />बिधाता बोला,</para>
  <para style="q" vid="HOS 14:4">“मेरी परज़ा किअ मुल्है विश्वास घात, पर मुंह छ़ाडणीं तिन्‍नां लै माफी।</para>
  <para style="q" vid="HOS 14:4">मुंह झ़ूरनअ तिन्‍नां लै दिला का खास्सै अर</para>
  <para style="q" vid="HOS 14:4">मुंह निं तिन्‍नां लै ऐबै रोश्श करनै।<verse eid="HOS 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 14:5" />मुंह दैणीं मेरी इज़राईली परज़ा लै बर्गत</para>
  <para style="q" vid="HOS 14:5">ज़ेही शुक्‍की-रुखी ज़ैगा दी बरसात पल़ा।</para>
  <para style="q" vid="HOS 14:5">तिंयां खिलणैं सुरघे फूला ज़िहै,</para>
  <para style="q" vid="HOS 14:5">तिंयां हणैं लाबानोन बणें केल़ुई ज़िहै</para>
  <para style="q" vid="HOS 14:5">ज़ेते ज़लैल़ै धरनीं डुघै हआ राझ़ै दै।<verse eid="HOS 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 14:6" />तिंयां हणैं इहै बूटा ज़िहै ज़ेता का नऊंईं टिरा टिर्खणी,</para>
  <para style="q" vid="HOS 14:6">तिन्‍नां दैणीं जैतूने बूटा ज़ेही शोभा।</para>
  <para style="q" vid="HOS 14:6">तिन्‍नां का हणीं लाबानोन बणें केल़ुई ज़ेही बधिया बास्स लागी दी।<verse eid="HOS 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 14:7" />मेरी परज़ा लणी भिई मुंह सेटा शरण।</para>
  <para style="q" vid="HOS 14:7">तिंयां हणैं नाज़ा ज़िहै खास्सै अर तिंयां खिलणैं दाखे बेला ज़िहै,</para>
  <para style="q" vid="HOS 14:7">तिंयां हणैं मशूर ज़िहअ लाबानोन मुल्खो दाखो रस मशूर आसा।<verse eid="HOS 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 14:8" />मेरी एप्रैमी परज़ा हणीं सदा लै मुहुर्ती का दूर।</para>
  <para style="q" vid="HOS 14:8">तिन्‍नें अरज़ शुणनी मुंह अर तिन्‍नें फाज़त बी करनी मुंह।</para>
  <para style="q" vid="HOS 14:8">हुंह आसा तिन्‍नां लै बडी कैलीए हरै बूटा ज़िहअ।</para>
  <para style="q" vid="HOS 14:8">तिन्‍नां लै बर्गत दैणैंओ मूल़ आसा हुंह।”<verse eid="HOS 14:8" /></para>
  <para style="s">सार</para>
  <para style="p">
    <verse number="9" style="v" sid="HOS 14:9" />ज़हा अक्ल होए, सह जाणअ इना गल्‍ला समझ़ी कि इधी किज़ै आसा लिखअ द। तेऊ हेरनी ईंयां गल्‍ला भुझ़ी बी। बिधाते बात आसा आज़री अर धर्मीं मणछ हांढा तैहा बाता। पर पापी बधल़िआ ठोहल़ लागी धरनीं किल्हैकि तिंयां हआ कबाता पेठै दै।<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>