  <para style="h">यहूदा</para>
  <para style="toc1">यहूदा लिखी दी च़िठी</para>
  <para style="toc2">यहूदा</para>
  <para style="toc3">यहू.</para>
  <para style="mt1">यहूदा</para>
  <para style="mt2">यहूदा लिखी दी च़िठी</para>
  <para style="is">भेत</para>
  <para style="ili">लिखणैं आल़अ: यहूदा</para>
  <para style="ili">पहल़णैं आल़ै: विश्वासी टोली लै</para>
  <para style="ili">सन: 67-80</para>
  <para style="ip">यहूदे च़िठी थिई लिखी दी झ़ुठी शिक्षा दैणैं आल़ेए खलाफ चतैनगी दैणा लै, किल्हैकि कई लोग करा तै होरी सम्हनै मसीहा दी विश्वास करनैओ दखाअ पर असली दी निं तिंयां विश्वासी हंदै तै। ऐहा होछ़ी ज़ेही च़िठीए खास गल्‍ल आसा पतरासे दुजी च़िठी ज़िहअ, एथ करा लिखणैं आल़अ आपणैं पहल़णैं आल़ै ऐहा गल्‍ला लै दिल भरी, “तेऊ विश्वासा लै करा पूरी कोशिश ज़ुंण पबित्र लोगा लै एकी ई बारी आसा सभाल़अ द।”</para>
  <para style="ip">यहूदा मकेरा एक शोभली प्राथणां लिखी ऐहा च़िठी:</para>
  <para style="imq">“सिधअ परमेशर ई आसा एक्‍कै ज़ुंण तम्हां का ठोहल़ लागणै का बच़ाऊई सका। परमेशर सका तम्हां नर्दोश अर खुश करी ज़ेभै सह तम्हां आप्पू सम्हनै आपणैं प्रतप्पा दी खल़ै करे। तेऊ बच़ाऊऐ हाम्हैं प्रभू ईशू मसीहा करै। प्रतप्प, राज़ अर अदर आसा पैहलै ई का तेऊए, आझ़ बी आसा तेऊए ई अर आजू बी रहणीं सारी सदा लै तेऊए ई।”</para>
  <para style="ipr">(24,25)</para>
  <para style="iot">कताबे बांड</para>
  <para style="io1">भेत 1,2</para>
  <para style="io1">झ़ुठै सखाऊंणै आल़ैओ च़ाल-च़लण, शिक्षा अर अंत 3-16</para>
  <para style="io1">विश्वासा बस्सणे चतैनगी 17-23</para>
  <para style="io1">बर्गत बैण 24,25</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">अदर</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />हुंह यहूदा आसा ईशू मसीहो दास अर याकबो भाऊ।</para>
  <para style="p" vid="JUD 1:1">हुंह लिखा ऐहा च़िठी तम्हां लै ज़ुंण परमेशरै आसा शादै दै। बाब परमेशर करा तम्हां लै झींण अर सह करा मसीहा ईशू दी थारी हेर-सभाल़।<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />मेरी आसा परमेशरा का एही अरज़ कि सह तम्हां सोभी लै खास्सी झींण करे, खास्सी शांती दैए अर सह तम्हां संघै खास्सी झ़ूरी करे।<verse eid="JUD 1:2" /></para>
  <para style="s">झ़ुठै गूरू</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />मेरै पैरै साथीओ, हुंह आसा तम्हां लै तैहा नऊंईं ज़िन्दगीए बारै लिखणे कोशिश करदअ लागअ द ज़ेथ हाम्हैं सोभै साझ़ू आसा अर ज़ुंण मसीहा ईशू बाती एछा। पर एभै च़ेतअ मंऐं इहअ कि हुंह दैंऊं तम्हां लै ऐहा च़िठी करै हैअ। हुंह करा तम्हां का अरज़ कि तम्हैं करा आपणैं विश्वासे फाज़त। परमेशरै आसा अह विश्वास एकी ई बारी अर आपणैं सोभी लोगा लै दैनअ द ज़ुंण कधि निं बदल़दअ। <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />किल्हैकि कई लोग आसा तम्हां संघै टोली दी ज़ुल़ै दै ज़ुंण ईशू मसीहा दी विश्वास करनैओ दखाअ करा। तिंयां निं परमेशरो अदर करदै अर तिंयां दैआ एही झ़ुठी शिक्षा कि परमेशरै हेरै म्हारै पाप माफ करी अर हाम्हैं सका कंज़रैई दी ज़िन्दगी ज़िऊई। तिंयां निं ईशू मंदै ज़ुंण म्हारअ एक्‍कै गूरू अर प्रभू आसा। खास्सी साला पैहलै आसा पबित्र शास्त्रा दी इहअ लिखअ द, “परमेशरा दैणीं इना इहै लोगा लै सज़ा।”<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />एही ता आसा गअ द तम्हां का इना सोभी गल्‍लो थोघ लागी, पर तज़ी बी फरेऊआ हुंह तम्हां का आद कि प्रभू किऐ इज़राईली मणछ मिसर देशे गलामी का आज़ाद। पर बादा का पाऐ तेऊ तिंयां सोभ मारी ज़ुंणी उज़र रेगीस्तानै तेऊ दी विश्वास निं किअ।<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="HEB 3:16-19">इब्रा. 3:16-19</ref>; <ref loc="NUM 14:22-23">गण. 14:22-23</ref>,<ref loc="NUM 14:30">30</ref></char></note><verse eid="JUD 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JUD 1:6" />ऐहा गल्‍ला बी करा आद कि ज़ुंण स्वर्ग दूत तिन्‍नां लै दैनी दी पदबी करै खुश नांईं तै आथी, अर स्वर्गो आपणअ घअर छ़ाडअ, तिंयां स्वर्ग दूत आसा परमेशरै सदा लै न्हैरी ज़ैगा एही शांघल़ी करै डाहै दै बान्हीं ज़ेता कोहै निं चोल़ी सकदअ। ताकि तैहा महान धैल़ी तिन्‍नों नसाफ होए।<verse eid="JUD 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JUD 1:7" />इज़राईली अर स्वर्ग दूता ज़ेही करा ऐहा गल्‍ला बी आद कि तिन्‍नां मणछा संघै किज़ै हुअ ज़ुंण सदोम अर अमोरा नगरी अर तेता नेल़ होरी नगरी रहा तै। तिंयां लोग हुऐ तै कंज़रै अर तिंयां थिऐ हर रंगे कंज़रैई करै भर्हुऐ दै। परमेशरै किऐ तिंयां आगी करै दहई खतम। इना लै इहअ हणअ आसा झ़ुठी गूरू लै चतैनगी कि तिन्‍नां बी भेटणीं सदा रहणैं आल़ी आगीए कूंडा दी सज़ा।<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="2PE 2:6">2 पत. 2:6</ref>; <ref loc="GEN 19:4-25">मूल. 19:4-25</ref>; <ref loc="DEU 29:23">बधा. 29:23</ref></char></note><verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />ठीक इहै ई तम्हां मांझ़ै तिंयां दखाअ करनै आल़ै मणछ करा इहै ई पाप, तिंयां बोला इहअ कि तिन्‍नां का खोज़ी परमेशरै सुपनै गल्‍ला प्रगट कि तिंयां सका आपणीं देही कंज़रैई करै भ्रष्ट करी, तिंयां निं च़ाहंदै कि प्रभू बी तिन्‍नां प्रैंदै हक डाहे अर तिंयां करा स्वर्गे महान स्वर्ग दूते बी नथोघी निंदा। <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />मिकाईल ज़ुंण परमेशरो एक प्रधान स्वर्ग दूत आसा, तेऊ बी निं इहअ किअ ज़ुंण इनै दखाअ करनै आल़ै लोगै किअ। ज़ांऊं राख्सै मिकाईल स्वर्ग दूता संघै ऐहा गल्‍ले बारै हठ किई कि तिन्‍नां मांझ़ै मोसा गूरे ल्हासा दाबी डाहणेंओ हक कहा आसा, एही ता आसा मिकाईल स्वर्ग दूता इना लोगा का खास्सअ हक, तेऊ निं राख्सा लै बी नकदरी गल्‍ल बोली अर नां तेऊ लै दोश लाअ। पर तेऊ बोलअ सिधअ इहअ, “परमेशरा नैरनअ तूह आप्पै।”<verse eid="JUD 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JUD 1:10" />पर इना दखाअ करनै आल़ै लोगा का ज़ुंण गल्‍ला समझ़ निं एछदी तेता लै करा तिंयां निंदा। ज़ुंण गल्‍ला इना समझ़ एछा अर तिन्‍नां करा ईंयां सभाबा ई का बणें पशू ज़ेही, अर तिन्‍नें इना पापी कामां करदी हआ तिंयां खिरी आप्पू बरैबाद। <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />तिन्‍नां लै आसा आफ़त! ज़ुंण इना एही गल्‍ला करा। तिन्‍नों बभार आसा कैना ज़िहअ ज़ुंणी रोश्शै आपणअ भाऊ पाअ त मारी, तिंयां आसा बलाम गूरा ज़िहै पापी ज़ुंणी आपणैं ढब्बे मांणै परमेशरे लोगा का पाप कराऊअ मरनै कोराहा ज़िहै ज़ुंणी मोसा गूरो बरोध किअ।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2PE 2:15">2 पत. 2:15</ref>; <ref loc="1JN 3:22">1 जोह. 3:22</ref>; <ref loc="GEN 4:3-8">मूल. 4:3-8</ref>; <ref loc="NUM 16:19-35">गण. 16:19-35</ref>; <ref loc="NUM 22:7">22:7</ref>; <ref loc="NUM 24:12-14">24:12-14</ref></char></note><verse eid="JUD 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12" />ज़ेही पाणीं जैंदरी गुप्त टोल्हा का किश्ती खातरअ हआ, तिहअ आसा तम्हां बी इना लोगा का खातरअ ज़ुंण तम्हां मांझ़ै खुशीए भोज़ा दी एछा। तिन्‍नों बभार आसा एऊ भोज़ा लै शर्मिंदै करनै आल़अ, पर नां तिन्‍नां हैल़अ फिरदअ। तिंयां आसा इहै फुआल ज़ुंण सिधी आपणीं हेर-सभाल़ करा। तिंयां निं होरी लोगे मज़त करदै। तिंयां आसा इहै बादल़ ज़ुंण बागरी करै शुक्‍की ज़िम्मीं प्रैंदा का बाझ़ी बरशै डेओआ दूर। तिंयां दैणा लै, बोला खास्सअ पर दैंदै निं आथी। तिंयां आसा इहै डाल़ बूट ज़ुंण फल़ा दैणें ऋता दी फल़ निं दैंदै। तिंयां आसा इहै बूट ज़ुंण गोधी का आसा पेछ़ुऐ दै, तिंयां आसा पठी मूंऐं दै।<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="2PE 2:17">2 पत. 2:17</ref>; <ref loc="JHN 15:4-6">जोह. 15:4-6</ref>; <ref loc="EPH 4:14">इफि. 4:14</ref></char></note><verse eid="JUD 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JUD 1:13" />ज़ेही समुंदरे बडी-बडी छ़ाल्‍ली बासली शेफा छ़ाडा, तिहै करा ईंयां लोग शर्मिंदै करनै आल़ै काम। तिंयां आसा इहै तारै ज़िहै ज़ुंण सिधी बाता निं हांढदै, तिंयां निं ठीक बात खोज़ी सकदै। तम्हैं निं इना लोगा ज़िहै हई। परमेशरै आसा इना लोगा लै एक ज़ैगा डाही दी ज़िधी सदा न्हैरअ रहणअ, ज़िधी प्रैश्शअ आथी ई निं आथी।<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ISA 57:20">ईशा. 57:20</ref></char></note><verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />हणोक बी, ज़सरअ ज़ल्म आदमी का सातुई पोस्ती हुअ, तेऊ आसा इना दखाअ करनै आल़ै लोगे बारै एही गल्‍ला प्रगट किई दी, <note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="2TH 1:7-8">2 थिस. 1:7-8</ref>; <ref loc="DEU 33:2">बधा. 33:2</ref></char></note>“भाल़ा, प्रभू एछणअ आपणैं लाखों पबित्र स्वर्ग दूता संघै, <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />सोभी लोगो नसाफ करदअ, तिन्‍नां सोभी दखाअ करनै आल़ै, कंज़रै अर पापी मणछा लै सज़ा दैंदअ। ज़ुंण कदुष्ट काम तिन्‍नैं किऐ अर तिन्‍नां सोभी नबिज़ती गल्‍ला लै ज़ुंण पापी मणछै परमेशरा लै बोली।”<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />ईंयां लाआ हर गल्‍ला लै परमेशरा लै दोश ज़ुंण तिन्‍नां लै बिति। तिंयां रहा तिन्‍नां कदुष्ट कामां करदै लागी ज़ेता तिन्‍नें दिल करनअ च़ाहा। तिंयां करा आपणैं बारै घमंड अर होरी लोगा सराहणेओ दखाअ ताकि तिन्‍नां तिहअ भेटे ज़ुंण तिंयां च़ाहा।<verse eid="JUD 1:16" /></para>
  <para style="s">चतैनगी अर शिक्षा</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />मेरै पैरै साथीओ, तम्हैं डाहा तिन्‍नां गल्‍ला आद ज़ुंण म्हारै प्रभू ईशूए शधाणूं खास्सी साला पैहलै आसा बोली मुक्‍कै दै। <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />तिंयां रहा तै तम्हां लै बोल्दै लागी, “म्हारै प्रभू ईशू फिरी एछणैं का आजी हणैं इहै लोग तिन्‍नां करनअ प्रभू अर तेऊए लोगो मखौल। ईंयां हणैं तिंयां लोग ज़ुंण आपणैं पापी सभाबे बशै आसा।” <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ईंयां आसा तिंयां ज़ुंण तम्हां मांझ़ै फूट पाआ, तिन्‍नें बूरै सभाबे च़ाहा करा तिन्‍नां आपणैं बशै अर तिन्‍नां दी निं पबित्र आत्मां आथी।<verse eid="JUD 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20" />पर मेरै पैरै साथीओ, तम्हैं रहा एकी-दुजै लै मज़त अर हैअ दैंदै लागी। परमेशरे तिन्‍नां शुची शिक्षा दी डाहा कबल्‍लअ भरोस्सअ ज़ेता तम्हैं विश्वास करा, पबित्र आत्में मज़ती करै करा प्राथणां। <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />तम्हां लागा सदा निहंचै दी रहणअ कि परमेशर करा तम्हां लै झ़ूरी, ज़ेही तम्हां तैहा धैल़ीए आशा बी आसा ज़ेभै म्हारअ प्रभू ईशू मसीहा फिरी एछणअ तेभै दैणीं तेऊ तम्हां लै सदा रहणैं आल़ी ज़िन्दगी किल्हैकि सह आसा हाम्हां लै झणैल़ू।<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />तिन्‍नां लै रहा झणैल़ू ज़हा का थोघ निं आथी कि केही शिक्षा दी करनअ विश्वास। <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />लोगा बच़ाऊआ नसाफ हणें आगी जैंदरा का ओर्ही घिशी। इहै आसा होर बी कई लोग ज़हा लै तम्हां झींण लागा करनी, पर तम्हैं डाहै धैन कि तिन्‍नां ज़िहै पाप निं करी। तम्हैं डाहै ऐहा गल्‍लो धैन कि तम्हैं निं तिन्‍नां पापा करी अर तिन्‍नां पापा का करा नफरत ज़ुंण तिन्‍नां लै छ़ोत लाआ।<verse eid="JUD 1:23" /></para>
  <para style="s">बर्गत बैण</para>
  <para style="p">
    <verse number="24-25" style="v" sid="JUD 1:24-25" />सिधअ परमेशर ई आसा एक्‍कै ज़ुंण तम्हां ठोहल़ लागणै का बच़ाऊई सका। परमेशर सका तम्हां नर्दोश अर खुश करी, ज़ेभै सह तम्हां आप्पू सम्हनै आपणैं प्रतप्पा दी खल़ै करे। तेऊ बच़ाऊऐ हाम्हैं प्रभू ईशू मसीहा करै। प्रतप्प, राज़ अर अदर आसा पैहलै ई का तेऊए, आझ़ बी आसा तेऊए ई अर आजू बी रहणीं सारी सदा लै तेऊए ई। एवमस्तू।<verse eid="JUD 1:24-25" /></para>
  <chapter eid="JUD 1" />
</usx>