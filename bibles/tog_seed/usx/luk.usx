<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LUKA</book>
  <para style="h">LUKA</para>
  <para style="toc2">LUKA</para>
  <para style="toc1">Makani Mabotu aa Jesu Kilisitu Aakalembwa o LUKA</para>
  <para style="mt2">Makani Mabotu aa Jesu Kilisitu Aakalembwa o</para>
  <para style="mt1">Luka</para>
  <para style="imt">Bupanduluzi</para>
  <para style="ip">Bbuku lya Luka litondezya mbuli Jesu mbwali Mufutuli wakasyomezegwa kuli Izilaili ape okubantu boonse. Ndebbuku litwaambila kuteeti Jesu wakaitwa o Muuya Uusalala kuteeti akambooke Makani Mabotu kubapengede. Lilatutondezya Jesu mbwali silubomba kulaabo babulide. Ape litondezya kuza okutolwa kwa Jesu. Luka ulazumanana kulemba nkani yokukomena okusabalangana kolusyomo lwe Cikilisitu mubbuku lya Misebezi ya Baapositola.</para>
  <para style="ip">Zimwi zibeela zye bbuku eeli zyaamba zimwi zinji zijanika feela mubbuku lya Luka mbuli nyiimbo zyabangelo abeembezi nibakapota akuzyalwa kwa Jesu, ape o Jesu mungʼanda ya Leza kali musyimani, cikozyanyo camu Samaliya mubotu, a mwana mutaka. Bbuku eeli lyaamba loko akukomba, Muuya Uusalala, musebezi wabanakazi mubukamboosi bwa Jesu, o Leza mbwalekelela zibi.</para>
  <para style="iot">Mundandaanda wezili Mwateni</para>
  <para style="io1">Majwi o kutalika<char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref></char></para>
  <para style="io1">Kuzyalwa obukamboosi bwa Joni Mubbabbatizi ape o Mwami Jesu<char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref></char></para>
  <para style="io1">Bukamboosi bwa Joni Mubbabbatizi<char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref></char></para>
  <para style="io1">Kubbabbatizigwa okusunkwa kwa Jesu<char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref></char></para>
  <para style="io1">Bukamboosi bwa Jesu mu Galileya<char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref></char></para>
  <para style="io1">Kuzwa ku Galileya kuya ku Jelusalemu<char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref></char></para>
  <para style="io1">Nako yamamanino ya Jesu afwiifwi o Jelusalemu omu Jelusalemu<char style="ior"><ref loc="LUK 19:27">19:27</ref></char></para>
  <para style="io1">Kubuka, kulibonya okutolwa kujulu ko Mwami Jesu<char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref></char></para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Luka Walembela Tiyofilasi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Nomuyandwa ba Tiyofilasi:</para>
  <para style="p" vid="LUK 1:1">Bantu banji bakasoleka cenguzu kulemba mundandaanda wezintu zyakacitika okuzuzikizigwa akati kesu. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Bakalemba zyoonyina zitwakaambilwa abakamboosi be jwi bakazibona amenso kuzwa kumatalikilo. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Iino nomukutekwa, mbokunga ndakazicilizya obotu-obotu zintu eezi zyoonse kuzwa kumatalikilaateni, amebo ndakayeeya kuteeti cabota ndimulembele zizyo kabotu-kabotu. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Ndacita namu kuteegwa muzizibe nconzyo zimwakaiisigwa.<verse eid="LUK 1:4" /></para>
  <para style="s">Kwaambilizigwa Kokuzyalwa Kwa Joni Mubbabbatizi</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5 </char>
      <char style="xt" closed="false">
        <ref loc="1CH 24:10">1 Makani 24:10</ref>.</char>
    </note>Nako Helodi naali mwami we cilalaanda ca Judiya, kwali mupaizi walikwiitwa kuteeti Zakaliya walikuzulilwa mukabunga kobupaizi bwa Abija. Mwanakazaakwe walikwiitwa kuteeti Lizabeti waliweciinga cobupaizi bwa Aloni awe. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Boonse bobile baliluleme mumenso aa Leza okucilizya milawo amalailile o Mwami oonse kabotu-kabotu. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Kono taakwe nibakajesi bana, mukuteeti Lizabeti taali kuzyala ape boonse bobile balicembeede.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Bumwi buzuba Zakaliya walikubeleka musebezi wakwe wobupaizi kuli Leza, kaambo wali muguyu wakabunga kakwe. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Kweendelana ecizo cobupaizi, Zakaliya wakasalwa kwiinda mukuuma cisolo<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Bapaizi bakabelesyanga zintu zimbi kuteeti bazibe uuti katente lubbani. Balikubika mazina aabapaizi acintu-acintu mpoonyina okuzibika zintu eezi mucigumbuli okuciyuntaanya naanga kugwisya comwi. Balikusyoma kuteeti mupaizi uleezina lili acintu cabwezegwa nguwakasalwa o Leza kuteeti atente lubbani. </char></note> kuteegwa akatente tununkilizyo acipaililo, mpoonyina wakanjila mu Ngʼanda yo Mwami. <figure style="fig" alt="Altar of Incense" file="hk00260b.tif" size="col" loc="1:5-1:25" ref="1:9">Cipaililo co Tununkilizyo</figure> <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Aleeyo nako, mbunga yabantu yalikukomba anze. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />Mpoonyina mungelo wa Leza wakalibonya kuli Zakaliya, kaimvwi kululyo lwa cipaililo aali kutentelwa tununkilizyo. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Zakaliya naakabona mungelo ooyo wakatilimuka okuyoowa loko. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Kono mungelo wakateeti, “Zakaliya utayoowi kaambo Leza wamvwa kukomba kwako, mpoonyina mwanakazaako Lizabeti uyookuzyalila mwana musyimani. Ukamuuzike zina lya Joni. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Uyobotelwa okunonenwa antoomwi abantu banji kaambo kokuzyalwa kwakwe! <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" /><note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">Myeelwe 6:3</ref>.</char></note> Unooli mwaalumi munkutwe mumensaa Mwami. Teelede kunonywa waini naanga cimwi cikola<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Joni wapedwe ku mwami kuteeti azuzikizye musebezi mupati. Mwami wakalailila kuteeti Joni antanoonywi waini mbuli citondezyo cokuteeti walipedwe.</char></note>. Katana okutumbukwa unoozwide Muuya Uusalala, <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Ape uyoopilusya bana Izilaili banji ku Mwami Leza wabo. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" /><note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">Malaki 4:5-6</ref>.</char></note>Uzoozulula kunembo lyo Mwami mumuuya omunguzu mbuli musinsimi Elija kweeta antoomwi bamaisi abana ape, okusandula basicinguni kuboobusongo bwa balulami. Uyoocita zyoonse eezi kuteegwa bantu balibambile kuza ko Mwami.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Mpoonyina Zakaliya wakateeti ku mungelo, “Ino ndilaziba buti kuteeti kulaba namu? Mebo omwanakazaangu twacembaala.”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:19 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 8:16">Danyele 8:16</ref>; <ref loc="DAN 9:21">9:21</ref>.</char>
    </note> Kuzwaawo mungelo wakataba kuteeti, “Ndime Gabuliyeli, wiima kunembo lya Leza. Wandituma kuzaamboola ayibo okukweetela aaya makani mabotu. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Iino bona! Kaambo kokuteeti taakwe niwasyoma makanaangu ayoozuzikizigwa muciindi ceelede, tonookonzyi kwamboola naanga aniini kusikila eezi zikacitike.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Muciindeeco, bantu bali kulindila Zakaliya, kabakomokedwe kuteeti na waliyeha buti mu Ngʼanda ya Leza. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Nakazwaanze, talikukonzya kwaamboola, aati kutondaika amaanza akwe, mpoonyina bakaziba kuteeti wabona cilengaano mu Ngʼanda ya Leza kaambo wakazumanana kutaamboola.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Niwakamana muguyu wa Zakaliya mu Ngʼanda ya Leza, wakapiluka kungʼanda yakwe. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Nikwakainda kaindi, Lizabeti mwanakazi wa Zakaliya wakamita, mpoonyina taalikuzwa mu ngʼanda kwe myeezi yosanwe. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Kuzwaawo wakateeti, “Maa! Iino Mwami wandigwasya, kumamanino kale wandigwisya masampu akati kabantu.”<verse eid="LUK 1:25" /></para>
  <para style="s">Kwaambilizigwa Kokuzyalwa Kwa Jesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Lizabeti kaleemyeezi iili cisambomwi yokumita, Leza wakatuma mungelo Gabuliyeli kuya kutaindi lye Nazaleta mucooko ca Galileya. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" /><note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">Mateyo 1:18</ref>.</char></note> Mungelo ooyo walikweeta makani kulinakalindu wezina lya Maliya, wakatangidwe kuli Josefa wali womukowa wo Mwami Deveti. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Mungelo wakeza kulinguwe okumwaambila kuteeti, “Lumela oolelekedwe! Mwami ulaayibo<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">Malembo amwi ayungizizya mabbala ookuteeti, “Ulilelekedwe akati kabanakazi.”</char></note>.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Maliya wakapenzegwa loko mumoyo kaambo kamakani akeetwa omungelo, okulibuzya caalikupandulula. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Mpoonyina mungelo wakateeti kulinguwe, “Utayoowi Maliya, Leza wakumvwida luzyalo. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" /><note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mateyo 1:21</ref>.</char></note> Bona! Uyoomita okutumbuka mwana musyimani, mpoonyina ukamuuzike kuteeti Jesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" /><note caller="-" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 Samuele 7:12-13</ref>, <ref loc="2SA 7:16">16</ref>; <ref loc="ISA 9:7">Izaya 9:7</ref>.</char></note> Mwanooyo uyooba mupati okwiitwa kuteeti Mwanaa Leza<note caller="+" style="f"><char style="fr" closed="false">1:32 </char><char style="ft" closed="false">Jesu Mwanaa Leza munzila iisiyene abantu susu mbobaba bana kumaisi. Bbaibbele libelesya bbala lyo mwana kutondezya kuteeti Jesu ulaabube mbuli bwa Leza ape uzwa kuli Leza. Ape citondezya cibbululu akati ka Leza o Jesu, mwana wakwe mbocikozyenye ecibbululu ca isi o mwana kubuntu susu. </char></note> Sijulu Wama Julu. Mwami Leza uyoomupa cibbula cobwami bwa Deveti sikale wakwe <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />ape uyooba mwami wolunyungu lwa Jakobo mane kukabe kutamani!” Bwami bwakwe tabukamani.<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Maliya wakateeti kumungelo, “Ndicilinakalindu. Ino eeci ciyoocitika buti?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Mungelo wakamutaba kuteeti, “Muuya Uusalala uyookuselukila, mpoonyina enguzu zya Leza Sijulu Wama Julu ziyooza aliyebo. Kaambo keeco, mwana uusalala uzoitwa kuteeti Mwanaa Leza. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Uyeeye muzyalwanyoko Lizabeti! Kwalikwaambwa kuteeti takonzya kuboomwana, kono we uleetumbu lye myeezi iili cisambomwi, nekuba kuteeti ulicembeede, <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" /><note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Matalikilo 18:14</ref>.</char></note> kaambo Leza taakwe catakonzya kucita.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Maliya wakateeti, “Ndilimuzike wa Leza. Akube mboonya mbuli mbowaamba.” Mpoonyina mungelo wakainka.<verse eid="LUK 1:38" /></para>
  <para style="s">Maliya Wapotela Lizabeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mumazuba aayo, Maliya wakanyamuka okwiinka cokufwambaana mucibaka camalundu mutaindi iili mucooko ca Judiya. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Naakasika wakanjila mungʼanda ya Zakaliya okulumelesya Lizabeti. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Mpoonyina Lizabeti naakamvwa kulumelesya kwa Maliya, mwana mutumbu lyakwe wakaputooka. Muuya Uusalala wakazula muli Lizabeti. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Kuzwaawo Lizabeti wakoongololola kuli Maliya kateeti, “Ulilelekedwe akati kabanakazi, ape omwana uulimutumbu lyako ulilelekedwe! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Ino ndime ni cokuteeti banyina bo Mwami wangu bazoondipotele? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Iino mbundamvwinda feela kulumelesya kwako, mwana uuli mutumbu lyangu waputooka cokunonenwa. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Ulilelekedwe kaambo wakasyoma kuteeti caakakwaambila Mwami ciyoozuzikizigwa.”<verse eid="LUK 1:45" /></para>
  <para style="s">Lwiimbo Lokulumbaizya Lwa Maliya</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Mpoonyina Maliya wakateeti,</para>
  <para style="q1" vid="LUK 1:46">“Muuya wangu watembaula Mwami.<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />Moyo wangu wabotelwa kaambo ka Leza Mufutuli wangu,<verse eid="LUK 1:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="LUK 1:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:48 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 1:11">1 Samuele 1:11</ref>.</char>
    </note>kaambo we wandiyeeya ndemuzike wakwe uubombede!</para>
  <para style="q1" vid="LUK 1:48">Kuzweeno mazyalano oonse aaza anoondiita kuteeti ulelekedwe,<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />kaambo kezintu zipati zyaandicitila Leza Singuzu zyoonse.</para>
  <para style="q1" vid="LUK 1:49">Izina lyakwe lilasalala.<verse eid="LUK 1:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="LUK 1:50" />Ulaamangʼeke kulaabo bamuyoowa,</para>
  <para style="q2" vid="LUK 1:50">kuzwa kumazyalani amwi kusika kulaamwi.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Wavungununa janza lyakwe lyenguzu okucita zintu zipati,</para>
  <para style="q2" vid="LUK 1:51">okumwaya baleentunda antoomwi amakanze aabo.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:52 </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:11">Jobo 5:11</ref>; <ref loc="JOB 12:19">12:19</ref>.</char>
    </note>Wagwisya bami basinguzu muzibbula zyabo zyobulelo,</para>
  <para style="q2" vid="LUK 1:52">okunyamuna basulidwe.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Wakusya bafwide nzala ezintu zibotu</para>
  <para style="q2" vid="LUK 1:53">okutanda bavubide cinkwamaanza.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Wagwasya Izilaili mubelesi wakwe</para>
  <para style="q2" vid="LUK 1:54">mukuteeti taakwe naaluba kutondezya mangʼeke<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:55 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:7">Matalikilo 17:7</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:55 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:1-10">1 Samuele 2:1-10</ref>.</char>
    </note>kuli Abbulahamu okulunyungu lwakwe mane kukabe kutamani,</para>
  <para style="q2" vid="LUK 1:55">mboonyina mbwaakasyomezya kuli basikale besu.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Mpoonyina Maliya wakakala o Lizabeti kwe myeezi iisika kuli yotatwe, amane wakapiluka kungʼanda yakwe.<verse eid="LUK 1:56" /></para>
  <para style="s">Kuzyalwa Kwa Joni Mubbabbatizi</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Nako yakasika yokuteeti Lizabeti aangunuke, mpoonyina wakatumbuka mwana musyimani. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" /><note caller="-" style="x"><char style="xo" closed="false">1:58 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Levitiko 12:3</ref>.</char></note> Basimukobonyina abecibbululu nibakamvwa Mwami Leza mbwaakafwida Lizabeti mangʼeke, bakasekelela antoomwi anguwe.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Mwana naakakwanisya mazuba aali lusele, bakeza kuteegwa bazoope mwana zina okumupalula.<note caller="+" style="f"><char style="fr" closed="false">1:59 </char><char style="ft" closed="false">Kupalulwa ciiminina citondezyo cokunyama citondezya cizuminano cecibbululu citamani akati ka Leza abama Juda.</char></note> Balikuyanda kumupa zina lya Zakaliya isi. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Kono banyina bakateeti, “Nee! Weelede kwiitwa kuteeti Joni.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Bakateeti kulinguwe, “Ede taakwe wecibbululu uulezina lili namu?” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Mpoonyina bakatambaikila Zakaliya isi kuteeti abaambile zina ndyalikuyanda kuuzika mwana wakwe.<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />Zakaliya wakakumbila cilembyo, okulemba kuteeti, “Zina lyakwe ngu Joni.” Mpoonyina boonse bakakomokwa loko! <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Mpoonyinaawo Zakaliya wakakonzya kwaamboola ape, okutalika kulumbaizya Leza. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Boonse basimukobonyina bakayoowa loko, mpoonyina makani eezintu eezi akasabalangana mumalundu oonse aa Judiya. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Boonse bakamvwa bakazumanana kuyeeya mumyoyo yabo okulibuzya kuteeti, “Ino ooyu mwana uyoba ni?” Bakayeeya namu kaambo nguzu zya Leza zyakalitondezya kubaalinguwe.<verse eid="LUK 1:66" /></para>
  <para style="s">Businsimi bwa Zakaliya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Mpoonyina Zakaliya isi Joni wakazula Muuya Uusalala okusinsima kateeti,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />Atulumbaizye Mwami Leza wa Izilaili,</para>
  <para style="q2" vid="LUK 1:68">kaambo waza kuzoogwasya bantu bakwe okubanununa.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Watutumina Mufutuli singuzu,</para>
  <para style="q2" vid="LUK 1:69">wolunyungu lwa Deveti mubelesi wakwe,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />mbuli mbwaakasyomezya kwiinda mubasinsimi bakwe basalala bensiku.<verse eid="LUK 1:70" /></para>
  <para style="q2">
    <verse number="71" style="v" sid="LUK 1:71" />Watutumina ooyu Mufutuli kuteegwa azootufutule kuzwa kuli batulwana,</para>
  <para style="q2" vid="LUK 1:71">omumaanza aabo batatuyandi boonse.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Wakacita namu kuteegwa atondezye mangʼeke kuli basikale besu</para>
  <para style="q2" vid="LUK 1:72">okuzuzikizya cizuminano cakwe cisalala.<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73-74" style="v" sid="LUK 1:73-74" />Acikonke cipati wakasyomezya Abbulahamu sikale wesu</para>
  <para style="q2" vid="LUK 1:73-74">kutunununa kuzwa kumaanza aabatulwana</para>
  <para style="q2" vid="LUK 1:73-74">okutuzumizya kumubelekela cokutayoowa,<verse eid="LUK 1:73-74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />kuteegwa tube basalede okululama anembo lyakwe,</para>
  <para style="q2" vid="LUK 1:75">mazuba oonse oobuumi bwesu.<verse eid="LUK 1:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:76 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:1">Malaki 3:1</ref>.</char>
    </note> Yebo, mwaanangu uyooitwa kuteeti musinsimi wa Leza Sijulu Wamajulu,</para>
  <para style="q1" vid="LUK 1:76">kaambo uyooinka kunembo lyo Mwami,</para>
  <para style="q2" vid="LUK 1:76">kuteegwa ukamubambile mugwagwa mwatazoinde,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />okwaambila bantu bakwe kuteeti bayoofutulwa kwiinda</para>
  <para style="q2" vid="LUK 1:77">mukujatilwa zibi zyabo.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Leza wesu ulaamangʼeke ape muteteete.</para>
  <para style="q1" vid="LUK 1:78">Uyootumunikila lufutuko lwakwe mbuli mumuni wokubucedo,<verse eid="LUK 1:78" /></para>
  <para style="q2">
    <verse number="79" style="v" sid="LUK 1:79" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:79 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:2">Izaya 9:2</ref>.</char>
    </note> kumunika kuzwa kujulu kumunikila aabo bantu bakede mumudima omumunzinziimwa wolufu,</para>
  <para style="q2" vid="LUK 1:79">okusolwedela kweenda kwesu munzila yoluumuno.<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Mwanooyu wakakomena okubeenguzu mumuuya. Walikukala munkanda mpoonyina wakatalika kukambooka antangalala kubantu bomu Izilaili.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Kuzyalwa Kwa Jesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mateyo 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Muciindi eeco, Kaisala Ogasitasi woku Loma wakalailila kuteeti bantu boonse balimubulelo bwe Loma bakalilembye. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Ooku kulilembya kwali kokusaanguna mubulelo bweci Loma. Kwakacitika nako Kwiliniyasi naali mweendelezi woku Siliya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Muntu omuntu wakainka kutaindi kwazwa kuyoolilembya.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Josefa wakazwa mutaindi lya Nazaleta mu Galileya okwiinka mutaindi lya Bbetelehemu mu Judiya ooko Mwami Deveti kwakazyalilwa kaambo wali wolunyungu lwa Deveti. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Wakainka kuyoolilembya o Maliya wakatangidwe kukwatwa kulinguwe.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Zikonke zyokukwata zyalikupangwa aciindi cokubulikwa, calikucitwa antangalala ape taakwe nizyalikuyandika kucita sikukwata anobweza sikukwatwa wakwe kuyookala awe mbuli mwanakazaakwe. Mateyo 1:24 itondezya kuteeti Josefa wakali mubwezede kale Maliya kungʼanda yakwe mbuli mwanakazaakwe kabatana kwiinka ku Bbetelehemu. Nekuba namu tibalina kuswaangana antoomwi mbuli mwaalumi o mwanakazi (Mateyo 1:25). Cecico eeco Luka caamba kuteeti Maliya ngonguwe “wakatangidwe kukwatwa.” </char></note> Maliya walimisi. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Kabacili ooko buzuba bwa Maliya bokutumbuka bwakasika. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Mpoonyina wakatumbuka mwana musyimani wokusaanguna. Wakamuvungaila mumasila. Mpoonyina wakamulazika mucilido cebanyama, kaambo tikwalikwe cibaka mungʼanda yabeenzu.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Mikwasyi yeci Juda iipengede yalikubambila banyama bayo mumaanda nako yamasiku. Iino cilido cabanyama ciyeeyelwa kuteeti cali mungʼanda mwakatambwidwe Maliya o Josefa kukala kutali mumulaka kule engʼanda. Kuyeeyelwa kuteeti bamwi basinyendo bakali kale mumaanda abeenzu. Maliya o Josefa bakakala mucibaka cengʼanda mwali banyama ape ezilido zyabanyama zyali afwiifwi.</char></note><verse eid="LUK 2:7" /></para>
  <para style="s">Beembezi a Bangelo</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Oobo busiku mumyuunda afwiifwi o Bbetelehemu kwakali beembezi balikulindilila matanga eembelele zyabo. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Mpoonya mpoonya mungelo wo Mwami wakaboneka kulibo, obulemu bo Mwami bwakamweka okubazinguluka, mpoonyina bakayoowa loko. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Kono Mungelo wakateeti, “Mutayoowi kaambo ndeeta makani mabotu aateete kubotelwa kupati kubantu boonse. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Ndyoonya sunu, mutaindi lya Deveti, Mufutuli wenu wazyalwa, Mwami Mesiya! <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Eeci ceciyooba citondezyo kulindinywe, muyoojana mbuumbu uvungailidwe mumasila kalede mucilido cabanyama.”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Mpoonya-mpoonya kwakalibonya bangelo basinkondo bokujulu banji antoomwi omungelo, kabalumbaizya Leza<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />kabateeti, “Bulemu kuli Leza kujulu lyamajulu,</para>
  <para style="q2" vid="LUK 2:14">oluumuno ansi kulaabo mbakondwaabo!”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Bangelo nibakapiluka kujulu, beembezi bakaambilana kuteeti, “Atwiinke inaawa ku Bbetelehemu tukabone ecicintu cacitika caatwaambila Mwami.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Mpoonyina cokufwambaana bakainka, okumujana Maliya o Josefa okubona mbuumbu kalede mucilido cabanyama. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Beembezi nibakamubona mwana, bakabaambila boonse balikwateni zyakaamba mungelo kujatikizya mwana. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Boonse bakamvwa zibakalungulula beembezi bakakomokwa. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Maliya wakazibika eezi zintu zyoonse mumoyo wakwe ape walikuziyeeyaanga nako yoonse. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Beembezi bakapiluka kabayoobwiimba okulumbaizya Leza kaambo zyoonse zibakabona okumvwa zyakaba mboonyina mbuli mbwaakabaambilide mungelo.<verse eid="LUK 2:20" /></para>
  <para style="s">Jesu Wauzikwa Zina</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:21 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 12:3">Levitiko 12:3</ref>; <ref loc="LUK 1:31">Luka 1:31</ref>.</char>
    </note>Nikwakainda Nsondo, niyakasika nako yokuteeti mwana apalulwe, wakauzikwa kuteeti Jesu, zina mungelo ndyakamupa katana kumitwa.<verse eid="LUK 2:21" /></para>
  <para style="s">Jesu Wapedwa Kuli Leza</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Niyakasika nako yokuteeti Josefa o Maliya bazuzikizye Mulawo wa Mozesi waamba kuteeti mwanakazi wakazwa akutumbuka weelede kulisalazya, bakatola mbuumbu ku Jelusalemu kuyoomupeda ku Mwami, <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" /><note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">Kulonga 13:2</ref>, <ref loc="EXO 13:12">12</ref>.</char></note>mboonyina mbuli mbokulembedwe mumulawo wo Mwami kuteeti, “Mwana musyimani wokusanguna weelede kupedwa kuli Leza, <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" /><note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">Levitiko 12:6-8</ref>.</char></note>okuyoopa cipaizyo ce nziba ziniini zyobile, na nkwilimba ziniini zyobile kwendelana o Mulawo wo Mwami.”<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Muciindi eeco, kwakali mwaalumi walikuteegwa Simiyoni walikukala mu Jelusalemu. Wali muntu uululeme, uyoowa Leza, walikulindila kufutulwa kwa Izilaili. Muuya Uusalala walaalinguwe, <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />ooyo wakamuyubunwida kuteeti tayoofwi mane akamubone Mesiya wo Mwami. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Simiyoni kasolwedwe o Muuya wa Leza wakanjila mulabba lye ngʼanda ya Leza. Jesu nibakamweeta mwateni bazyali bakwe kuteegwa acitilwe celeede kweendelana o Mulawo, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Simiyoni wakamubweza mumanzaakwe o kulumba Leza kateeti,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“O Mwami Singuzu Zyoonse! Wazuzilikizya ciwakasyomezya,</para>
  <para style="q2" vid="LUK 2:29">iino leka mubelesi wako afwe muluumuno,<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />kaambo menso aangu amubona Mufutuli nguwakatuma,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />nguwakabambila mumenso aabantu boonse.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:32 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:6">Izaya 42:6</ref>; <ref loc="ISA 49:6">49:6</ref>; <ref loc="ISA 52:10">52:10</ref>.</char>
    </note>Ooyu ngomumuni uyubununa Leza kuli Bamasi</para>
  <para style="q2" vid="LUK 2:32">ape uyeeta bulemu kubantu bako bana Izilaili.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Baisi abanyina mwana bakakomokwa kumvwa majwi ngaakaamba Simiyoni kujatikizya mwana. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simiyoni wakabaleleka mpoonyina wakaambila Maliya banyina mwana kuteeti, “Ooyu mwana wakasalwa o Leza kuzosinyoona banji ape okufutula banji mu Izilaili. Uyooba citondezyo kuzwa kuli Leza eeco bantu banji cobayookazya. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Kaambo kanguwe, mizeezo yemyoyo minji iyooyubununa. Ape ayibo mause ayooyasa moyo wako, mboonyina mbuli sabule libosya.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36-37" style="v" sid="LUK 2:36-37" />Kwali musinsimi mukamufu wali mucembele loko wezina lya Ana, mwanaa Faniwelu, womukowa wa Asha. Waleemyaka iili makumi aalilusele aone yokuzyalwa. Wakakwetwe feela kwe myaka iili ciloba. Lyoonse wali mulabba lye Ngʼanda ya Leza, kabeleka kwiinda mukukomba okuliimya kulya masiku esikati. <verse eid="LUK 2:36-37" /><verse number="38" style="v" sid="LUK 2:38" />Aciindi coonyina eeco, wakasika kulibo okutalika kalumba Leza okwaamba zijatikizya mwana kuli boonse balikulindila Leza kuteeti anunune Jelusalemu.<verse eid="LUK 2:38" /></para>
  <para style="s">Josefa omukwasyi wakwe bapiluka ku Nazaleta</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 2:23">Mateyo 2:23</ref>.</char>
    </note>Josefa o Malia nibakamana kucita zyoonse zyakali kuyandika mu Mulawo wo Mwami, bakapiluka kulibo ku Nazaleta mu Galileya. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Mwanooyu wakakomena okubeenguzu, kazwide busongo ezileleko zya Leza zyalaalinguwe.<verse eid="LUK 2:40" /></para>
  <para style="s">Jesu mulabba lye Ngʼanda ya Leza</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:41 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Kulonga 12:1-27</ref>; <ref loc="DEU 16:1-8">Detilonomo 16:1-8</ref>.</char>
    </note>Mwaaka omwaaka bazyali ba Jesu bali kwiinkaanga ku Mukiti we Pasika ku Jelusalemu. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Jesu naaleemyaaka ili kumi ayobile, bazyali bakwe bakainka ku Mukiti mbuli cilengwa cabo, okumutolelezya. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Mukiti niwakamana nibalikuyobupiluka kungʼanda yabo ku Nazaleta, Jesu wakasyaala mu Jelusalemu kono bazyali bakwe tibalizi. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Bali kuyeeya kuteeti mpali, uyobweenda mubbunga lyabantu. Nibakeenda musinzo wobuzuba bomwi, bakamuzula, kuzwaawo bakatalika kumuyandoola akati ka mabbululu a beenzinyina. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Taakwe nibakamujana, mpoonyina bakapiluka ku Jelusalemu kabayoobumuyandoola. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Nikwakainda mazuba otatwe, bakamujana mulabba lye Ngʼanda ya Leza kakede abamayi beci Juda kalimukubaswiilizya okubabuzya mibuzyo. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Boonse balikuswiilizya bakalukomokwa luzibo lwakwe emitabilo yakwe. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Bazyali bakwe bakakomokwa nibakamubona, mpoonyina banyina bakamwaambila kuteeti, “Mwanaangu, niinzi niwatucita namu? Bauso amebo twalikuyoobukuyandoola katulikaleledwe loko.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Jesu wakataba kuteeti, “Ino niinzi nimwali kundiyandoola? Timwalizi kuteeti ndeelede kuba mu Ngʼanda ya Tata na?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Kono taakwe nibakaziba caalikwaamba.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Mpoonyina Jesu wakainkaabo ku Nazaleta, okwiindilizya kubamvwida. Banyina bakazibamba zyoonse eezi mumoyo wabo. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" /><note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 Samuele 2:26</ref>; <ref loc="PRO 3:4">Tusimpi 3:4</ref>.</char></note>Jesu walikuyoobukomena mumaano omuciimo ape wakaba mwana uuyandwa loko o Leza ape abantu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Bukamboosi Bwa Joni Mubbabbatizi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateyo 3:1-12</ref>; <ref loc="MRK 1:1-8">Maako 1:1-8</ref>; <ref loc="JHN 1:19-28">Joni 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Mumwaaka we kumi aisanu wokulela kwa Kaisala Tibbeliyasi woku Loma, ijwi lya Leza lyakasika kuli Joni mwanaa Zakaliya kali musaka. Kweeyo nako Pontiyasi Pilato wali mweendelezi wecooko ca Judiya. Helodi wali mwami wecooko ca Galileya. Filipo muzyalwanyina wa Helodi wali mwami wezilalaanda zya Ituliya a Tilakonitisi. Lisaniyasi wali mwami wecooko ca Abbilene. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Muciindi eeco Anasi o Kefasi bali Bapaizi Bapati. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Joni wakainka mucilalanda coonse comulonga we Jolodani kayoobukambooka kateeti, “Amusanduke kuzwa kuzibi zyenu mweempe okubbabbatizigwa, mpoonyina Leza ulamujatila zibi zyenu.” <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">Izaya 40:3-5</ref>.</char></note>Mbuli mbokulembedwe mubbuku lya Izaya musinsimi kuteeti,</para>
  <para style="q1" vid="LUK 3:4">“Kuli woongolola munkanda kuteeti,</para>
  <para style="q2" vid="LUK 3:4">‘Amubambile limwi mugwagwa wo Mwami,</para>
  <para style="q2" vid="LUK 3:4">amululamike nzila yakwe.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Zinkaandwa zyoonse zivwikilwe,</para>
  <para style="q2" vid="LUK 3:5">zyuulu a malundu zibbambasigwe.</para>
  <para style="q1" vid="LUK 3:5">Migwagwa ipilingene yoololwe enzila zyezigunyu-gunyu zilulamikwe.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Mpoonyina bantu boonse bayoolubona lufutuko lwa Leza.’”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mateyo 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char>
    </note> Kuzwaawo bantu banji bakeza kuli Joni kuteeti azobabbabbatizye. Mpoonyina wakabaambila kuteeti, “Nywebo nobana bacipile! Ngwani wakamucenjezya kuteeti mucije cisubulo caandootuma Leza? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" /><note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Joni 8:33</ref>.</char></note>Amucite zintu zitondezya kuteeti mweempwa, ape mutataliki kulyaambila kuteeti, ‘Abbulahamu ngusikale wesu.’ Ndamwaambila kuteeti Leza ulakonzya kupanga bana ba Abbulahamu kuzwa kumabwaaya. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mateyo 7:19</ref>.</char></note> Ape Kacapu kokutemya miyanda yezisamu kalibambidwe kale, kufumbwa cisamu citazyali micelo mibotu ciyootemwa okusowelwa mumulilo.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Kuzwaawo bantu bakabuzya Joni kuteeti, “Ino niinzi cotweelede kucita kuteegwa tufutuke?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Wakabataba kuteeti, “Kufumbwa ujesi zibaki zyobile ape comwi kuli utajesi, ape kufumbwa ooyo uleecokulya aabane ootajesi.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:29">Luka 7:29</ref>.</char>
    </note> Bamwi basimutelo abo bakeza kuteeti babbabbatizigwe, mpoonyina bakamubuzya kuteeti, “O mwiiyi, ino niinzi cotweelede kucita kuteegwa tufutuke?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Mpoonyina wakabataba kuteeti, “Mutanotelesya kwiindilizya mweelwe ngumwakalaililwa.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Mpoonyina bamwi basilumamba abo bakamubuzya kuteeti, “Ino swebo niinzi cotweelede kucita kuteegwa tufutuke?”</para>
  <para style="p" vid="LUK 3:14">Wakabataba kuteeti, “Mutanoobwezi mali kubantu kwiinda mukubanyanga naanga mukubatamizya milandu njibatacita ape amukutile okuhola kwenu.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Lulangilo lwa bantu lwakatalika kukomena, mane bakatalika kuyeeya kuteeti mweendi Joni ngo Mesiya. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Joni wakabataba kuteeti, “Ndimubbabbatizya amaanzi kono kuluuza uleenguzu loko kwiinda ndime cokuteeti tandeeleli kumwaangununa zinyantela zyakwe. Uyoomubbabbatizya o Muuya Uusalala omulilo. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Ulijesi ecipupuluzyo mumaanza, cayoopupuluzya mailaakwe okwaalongela mubutala. Kono buungululwa uyoobubunganya okubusowela mumulilo utamani.”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Joni wakaamba zintu zinji mbuleezi zyokubakulwaizya naalikuyoobukambooka makani mabotu kuteegwa basanduke. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" /><note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">Mateyo 14:3-4</ref>; <ref loc="MRK 6:17-18">Maako 6:17-18</ref>.</char></note>Kono Joni naakapatokela Helodi Mweendelezi kaambo ka Helodiyasi mwanakazi womuzyalwanyina ezimwi zibi zyaakacita, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Helodi wakacita cibi cipati kuyunguzizya azibi zyakwe zimwi mukubika Joni muntolongo.<verse eid="LUK 3:20" /></para>
  <para style="s">Kubbabbatizigwa kwa Jesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mateyo 3:13-17</ref>; <ref loc="MRK 1:9-11">Maako 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Iino bantu boonse nibali kubbabbatizigwa, awe Jesu wakabbabbatizigwa. Mpoonyina naalikukomba ijulu lyakajuka, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" /><note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Matalikilo 22:2</ref>; <ref loc="PSA 2:7">Intembauzyo 2:7</ref>; <ref loc="ISA 42:1">Izaya 42:1</ref>; <ref loc="MAT 3:17">Mateyo 3:17</ref>; <ref loc="MRK 1:11">Maako 1:11</ref>; <ref loc="LUK 9:35">Luka 9:35</ref>.</char></note>o Muuya Uusalala wakamuselukila mbuli nziba okumukala. Mpoonyina kwakamvwika jwi kuzwa kujulu kaliteeti, “Uli Mwanaangu ngondiyandisisya, mulindiwe mondibotelwa loko”.<verse eid="LUK 3:22" /></para>
  <para style="s">Mazyalani a Jesu</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mateyo 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Nako Jesu naakatalika musebezi wakwe waleemyaka itandila kumakumi otatwe. Jesu wali mwanaa Josefa mukuyeeya kwabantu, Josefa wali mwanaa Heli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Heli mwanaa Matati, Matati mwanaa Levi, Levi mwanaa Meleki, Meleki mwanaa Janai, Janai mwanaa Josefa. <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Josefa Mwanaa Matatiyasi, Matatiyasi mwanaa Amosi, Amosi mwanaa Nahumu, Nahumu mwanaa Esili, Esili mwanaa Nagai, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Nagai mwanaa Maati, Maati mwanaa Matiyasi, Matiyasi mwanaa Semeyini, Semeyini mwanaa Joseci, Joseci mwanaa Joda, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Joda mwanaa Jowanani, Jowanani mwanaa Lesa, Lesa mwanaa Zelubbabbeli, Zelubbabbeli mwanaa Salitiyelu, Salitiyelu mwanaa Neli, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Neli mwanaa Meleki, Meleki mwanaa Adi, Adi mwanaa Kosamu, Kosamu mwanaa Elimadamu, Elimadamu mwanaa Eli, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Eli mwanaa Josyuwa, Josyuwa mwanaa Eliyaza, Eliyaza mwanaa Jolimu, Jolimu mwanaa Matati, Matati mwanaa Levi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Levi mwanaa Simiyoni, Simiyoni mwanaa Juda, Juda mwanaa Josefa, Josefa mwanaa Jonamu, Jonamu mwanaa Eliyakimu, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Eliyakimu mwanaa Meleya, Meleya mwanaa Mena, Mena mwanaa Matata, Matata mwanaa Natani, Natani mwanaa Deveti, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Deveti mwanaa Jesi, Jesi mwanaa Obedi, Obedi mwanaa Bowazi, Bowazi mwanaa Salimoni, Salimoni mwanaa Nashoni, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Nashoni mwanaa Aminadabu, Aminadabu mwanaa Adimini, Adimini mwanaa Ani, Ani mwanaa Heziloni, Heziloni mwanaa Pelezi, Pelezi mwanaa Juda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Juda mwanaa Jakobo, Jakobo mwanaa Isaki, Isaki mwanaa Abbulahamu, Abbulahamu mwanaa Tela, Tela mwanaa Naho, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Naho mwanaa Selugi, Selugi mwanaa Lewu, Lewu mwanaa Pelegi, Pelegi mwanaa Ebba, Ebba mwanaa Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Shela mwanaa Kainani, Kainani mwanaa Afakisadi, Afakisadi mwanaa Shemu, Shemu mwanaa Nowa, Nowa mwanaa Lameki, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Lameki mwanaa Metusela, Metusela mwanaa Enoki, Enoki mwanaa Jaledi, Jaledi mwanaa Mahalalela, Mahalalela mwanaa Kainani, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kainani mwanaa Enosi, Enosi mwanaa Seti, Seti mwanaa Adamu, Adamu mwanaa Leza.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Kusunkwa Kwa Jesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mateyo 4:1-11</ref>; <ref loc="MRK 1:12-13">Maako 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Joni naakamana kubbabbatizya Jesu, Jesu wakapiluka kuzwa ku mulonga wa Jolodani kaazwide Muuya Uusalala. Wakasolwedwa o Muuya Uusalala kwiinka musaka, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />omo mwakakusunkwa o Dyabulosi kwamazuba aali makumi one. Muciindi coonseeco taakwe caakalya, cokuteeti wakafwa nzala loko mazubaayo nakainda.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Mpoonyina Dyabulosi wakateeti kulinguwe, “Na uli Mwanaa Leza, lailila bbwe eeli lisanduke kuba cinkwa.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:3">Detilonomo 8:3</ref>.</char>
    </note> Kono Jesu wakamutaba kuteeti, “Kulilembedwe mumalembe kuteeti, ‘Muntu taponi ecinkwa feela.’”<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Kuzwaawo Dyabulosi wakatola Jesu atala lye cilundu okumutondezya bwami bwaansi boonse mukulaba kwelinso. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Mpoonyina Dyabulosi wakaambila Jesu kuteeti, “Ndilakupa bulelo boonse oobu antoomwi obulemu bwateni kaambo zyakapegwa kulindime, ape ndikonzya kupa kufumbwa ngundayanda. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Nakuteeti yebo wandifugamina okundikomba zyoonseezi zilaba zyako.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:13">Detilonomo 6:13</ref>.</char>
    </note>Jesu wakataba kuteeti, “Kulilembedwe mumalembe kuteeti, ‘Komba Mwami Leza wako okubelekela nguwe alike.’”<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Kuzwaawo Dyabulosi wakeeta Jesu ku Jelusalemu, okuyoomwiimika ataleeni lye Ngʼanda ya Leza, okumwaambila kuteeti, “Na uli Mwanaa Leza, lifusilaansi kuzwaano,<figure style="fig" alt="Pinnacle of Temple" file="dn00405b.tif" size="col" loc="4:1-4:13" ref="4:9">Jesu ataleeni lye Ngʼanda ya Leza</figure> <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" /><note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Intembauzyo 91:11-12</ref>.</char></note>kaambo kulilembedwe mumalembe kuteeti, ‘Leza uyoolailila bangelo bakwe kuteeti bakakukwabilile.’ <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />Ape, ‘Bayookukwaba amaanzaabo kuteegwa utakalicisi kucituta cako abbwe.’”<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:16">Detilonomo 6:16</ref>.</char>
    </note>Kono Jesu wakamutaba kuteeti, “Malembe ateeti, ‘Utasunki Mwami Leza wako.’”<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Mpoonyina Dyabulosi naakamana kusunka Jesu munzila zyoonse wakamusiya kuteeti uzomuzida azojana nako mbotu.<verse eid="LUK 4:13" /></para>
  <para style="s">Jesu Watalika Musebezi Wakwe mu Galileya</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mateyo 4:12-17</ref>; <ref loc="MRK 1:14-15">Maako 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Mpoonyina Jesu wakapiluka ku Galileya, kazwide enguzu zyo Muuya wa Leza. Mpuwo ya Jesu yakasabalangana cilalaanda coonse. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Walikwiisyaanga muzikombelo zyabo mane bantu boonse bakamulumbaizya.<verse eid="LUK 4:15" /></para>
  <para style="s">Jesu Wakakwa ku Nazaleta</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mateyo 13:53-58</ref>; <ref loc="MRK 6:1-6">Maako 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Kuzwaawo Jesu wakainka ku Nazaleta, ooko kwaakakomenena. Mpoonyina mubuzuba bwe Nsabata wakainka ku cikombelo mbuli cilengwa cakwe. Wakaima kuteeti abale Malembe, <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />mpoonyina wakatambikwa bbuku lyo musinsimi Izaya. Wakajula okujana palembedwe kuteeti,<figure style="fig" alt="Scroll" file="hk00150b.tif" size="col" loc="p" ref="4:17">Bbuku</figure><verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:18 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:1-2">Izaya 61:1-2</ref>.</char>
    </note>“Muuya wo Mwami ulaalindime</para>
  <para style="q2" vid="LUK 4:18">kaambo wandinanika kuteeti ndaambilizye Makani Mabotu kubapenzi.</para>
  <para style="q1" vid="LUK 4:18">Wandituma kwaambilizya kubaangidwe kuteeti bayoangununwa</para>
  <para style="q2" vid="LUK 4:18">okuboofu kuteeti bayoobona,</para>
  <para style="q1" vid="LUK 4:18">okwaangununa badyaaminidwe,<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />okwaambilizya kuteeti nako yasika yokuteeti</para>
  <para style="q2" vid="LUK 4:19">Mwami atondezye luzyalo lwakwe kubantu bakwe.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Mpoonyina Jesu wakalijala bbuku okulipilusya kuli sikubamba cikombelo amane wakakalaansi. Bantu boonse mu cikombelo bakamudongomwena. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Mpoonyina wakatalika kubaambila kuteeti, “Aaya Malembo azuzikizigwa sunu nimwaamvwa kaabalwa.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Bantu boonse balikwaaamba zibotu alinguwe ape bakomokwa kaambo kamajwaakwe ooluzyalo. Mpoonyina bakabuzyanya kuteeti, “Tiinsi mwanaa Josefa ooyu na?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Mpoonyina Jesu wakateeti kulibo, “Nconzyo muyoondaambila kaambyo kokuteeti, ‘Omusilisi lisilike ndiwenya.’ Ape muyoondaambila kuteeti, ookuno kondizwa ndicite zintu ziswana mbuli zimwakamvwa kazicitwa mu Kapenaumu.” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" /><note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Joni 4:44</ref>.</char></note>Mpoonyina wakazwida anembo kateeti, “Ndimwaambila kuteeti taakwe musinsimi ukutekwa kwazwa. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" /><note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Bami 17:1</ref>.</char></note>Amundimvwe, nconzyo kwali bamukabafu banji mu Izilaili muciindi ca Elija, nikwatalikwe mvula myaaka yotatwe emyeezi ili cisambomwe, nikwali nzala mpati cisi coonse. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" /><note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 Bami 17:8-16</ref>.</char></note> Nekuba namu, Elija taakwe naakatumwa kuli umbi mu Izilaili, aati feela kulooyu mukamufu walikukala kunzaa Izilaili mu Zelifati mucilalaanda ca Sidoni. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" /><note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 Bami 5:1-14</ref>.</char></note> Ape kwali basizinsenda banji balikukala mu Izilaili muciindi co musinsimi Elisha, nekuba namu aati Namani woku Siliya nguwakaponisigwa alike.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Bantu bali mucikombelo nibakamvwa namu, bakanyema loko. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Mpoonyina bakanyamuka okukuluntila Jesu anzeetaindi okumutola atalee cilundu akayakidwe taindi lyabo kuteegwa bamutontele mujeleele, <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />kono wakazyuuluka okwiinda akati kabo okubasiya.<verse eid="LUK 4:30" /></para>
  <para style="s">Jesu Wagwisya Muuya Mubi Mu Mwaalumi</para>
  <para style="r">(<ref loc="MRK 1:21-28">Maako 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Kuzwaawo Jesu wakaselela kwiinka ku Kapenaumu, taindi lijanika mu Galileya, okutalika kwiisya bantu mu Nsabata. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" /><note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Mateyo 7:28-29</ref>.</char></note> Mpoonyina bakakomokwa mbwaalikwiisya kaambo walikwiisya enguzu zya Leza. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />Mu cikombelo, kwali mwaalumi waloomuuya wedimona, wakakwiila loko, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />okuteeti, “Aa! Ino uyandaanzi kulindiswe, Jesu woku Nazaleta? Wazotusinya na? Ndilikwizi. Ndiwe uusalala wa Leza!”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Jesu wakalailila muuya mubi kuteeti, “Umuna! Zwa mumwaalumi ooyu!” Mpoonyina dimona lyakamuzintila aansi mwaalumi kunembo lyabo, okuzwa mulinguwe kakutakwe kumucisa.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Bantu boonse bakakomokwa, okwaamboozyanya kuteeti, “Ino majwiinzi aaya aaleenguzu, cokuteeti mane ooyu mwaalumi ulalailila emyuuya mibi mpoonyina ilazwa?” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Mpoonyina mpuwo ya Jesu yakasabalangana cilalaanda coonse.<verse eid="LUK 4:37" /></para>
  <para style="s">Jesu Waponya Bantu Banji</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mateyo 8:14-17</ref>; <ref loc="MRK 1:29-34">Maako 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Jesu naakazwa kucikombelo wakainka kungʼanda ya Saimoni kwaakakujana banyinazyala Saimoni mbalwazi, mubili wali kupya loko. Mpoonyina bakakumbila Jesu kuteeti abagwasye. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Kuzwaawo Jesu wakainka okuyoobakotamina. Wakalailila bulwazi kuteeti buzwe mumubili mpoonyina bakapona. Mpoonya-mpoonya bakanyamuka okuyumbula Jesu abasikwiiya bakwe cokulya.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Kuzwaawo nilyakabbila zuba, boonse balaabeenzinyina balikuciswa malwazi asiyene-siyene bakabeeta kuli Jesu. Boonse wakabaguma okubaponya. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Madimona angawo akazwa mubantu banji, kaongolola kuteeti, “Ndiwe Mwanaa Leza.”</para>
  <para style="p" vid="LUK 4:41">Kono Jesu wakaapatokela okwaalesya kwaamboola kaambo alimwizi kuteeti wali Mesiya.<verse eid="LUK 4:41" /></para>
  <para style="s">Jesu Wakambooka Muzikombelo</para>
  <para style="r">(<ref loc="MRK 1:35-39">Maako 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Kubucedo Jesu wakazwa mutaindi okwiinka kucibaka cuumwine. Mpoonyina bantu bakatalika kumuyandoola, nibakamujana bakasola kumukumbila kuteeti atainki. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Kono we wakateeti, “Ndeelede kukambooka Makani Mabotu oo Bulelo bwa Leza omumataindi amwi, kaambo eeci Leza caakandituma kucita.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Mpoonyina wakazwida anembo kukambooka muzikombelo zyoonse zyomu Judiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Jesu Waita Basikwiiya Bakwe Bokusaanguna</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mateyo 4:18-22</ref>; <ref loc="MRK 1:16-20">Maako 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:1-2">Mateyo 13:1-2</ref>; <ref loc="MRK 3:9-10">Maako 3:9-10</ref>; <ref loc="MRK 4:1">4:1</ref>.</char>
    </note>Bumwi buzuba Jesu kaimvwi ankomwe yo lwizi lwa Genasaleti,<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Genaseleti, ndizina limwi lyo lwizi lwa Galileya.</char></note> bantu banji balikusyanikizyanya kabaswena kulinguwe kuteegwa bamvwe majwaa Leza. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Jesu wakabona migolo yobile yalaambali olwizi. Basikuzuba baliiside kabayoosanzya tunyandi twabo. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Mpoonyina Jesu wakanjila mumugolo umwi wali wa Saimoni okumukumbila kuteeti autontele mumaanzi aniini. Kumane Jesu wakakala mumugolo okwiisya mbunga.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Naakamana kwiisya, wakateeti kuli Saimoni, “Tontela mugolo mumaanzi malamfu kuteegwa yebo abeenzinyoko musowele tunyandi twenu mumaanzi mujate nswi.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 21:3">Joni 21:3</ref>.</char>
    </note> Mpoonyina Saimoni wakateeti, “O mwami, twabeleka cenguzu busiku boonse kusola kujata nswi kono taakwe citwajata naanga comwi. Kono kaambo waamba, ndilacita mboonya namu.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" /><note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">Joni 21:6</ref>.</char></note> Nibakacita namu bakaca nswi zinji loko, mane tunyandi twakatalika kuyawooka. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Bakacita kukobeta beenzinyina bali mumugolo umwi kuteegwa bazoobagwasye. Bakeza okuzuzya migolo yobile mane yalikuyanda kubbila. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Saimoni Pita naakabona cakacitika, wakafugama kunembo lya Jesu okuteeti, “Mwami ndisiya! Ndilisimucita zibi!”<verse eid="LUK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9" />Saimoni wakaamba namu kaambo we abeenzinyina bakakomokwa loko obunji bwe nswi zibakajata. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Beenzinyina Saimoni bene Jemusi o Joni bana ba Zebbediya abo bakakomokwa. Kono Jesu wakateeti kuli Saimoni, “Utayoowi, kuzwa sunu unooli muzubi wabantu.”<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />Kuzwaawo bakakwelela migolo yabo anze amaanzi mpoonyina bakasiya zyoonse okumucilila.<verse eid="LUK 5:11" /></para>
  <para style="s">Jesu Waponya Mwaalumi Sicinsenda</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mateyo 8:1-4</ref>; <ref loc="MRK 1:40-45">Maako 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Imwi nako Jesu naali mutaindi limwi, oomo mwali mwaalumi wajesi cinsenda<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">Bulwazi bwaambidwe aawa bwaamba malwazi asiyene-siyeni aatabukila acikanda comubili womuntu ape mabi loko. Muntu wajesi bumwi bwamalwazi aaya wali muntu usofweede mumulawo wama Juda. Kweelana omulawo ooyu, mulwazi taalikuzumizigwa kuvwaanana abantu bamwi naanga kukomba mulabba lye Ngʼanda ya Leza. Nakuteeti bapona kokuteeti basalala kweelana omulawo wama Juda, mpoonyina balikuzumizigwa kunjila mulabba lye Ngʼanda ya Leza okutola lubazu muzyokucita zyoonse zicitika abantu bamwi.</char></note> mubili woonse. Ooyu mwaalumi naakabona Jesu, wakavundama kunembo lyakwe okumukumbila kuteeti, “Mwami, na ulayanda inga wandiponya.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Mpoonyina Jesu wakatandabika janza lyakwe okumuguma okuteeti, “Ndilayanda. Kopona!” Mpoonyinaawo cisenda cakamana, ooyu mwaalumi wakapona. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" /><note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Levitiko 14:1-32</ref>.</char></note>Kuzwaawo Jesu wakamulailisisya kuteeti, “Mvwa! Utaambili muntu naanga omwi zyacitika. Kono koya ku Ngʼanda ya Leza kumupaizi, akakubone kuteeti wapona. Mpoonyina ukape cituuzyo mbuli mbwaakalailila Mozesi kuteegwa bantu bazibe kuteeti wapona.”<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Kono nekuba kuteeti Jesu wakamukasya, nkani yakasabalangana kwiinda kusaanguna. Kaambo keeci, bantu bakeza mubunji kuli Jesu kuteegwa bazomumvwe okuponesegwa kumalwazaabo. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Kono Jesu walikubasiyaanga okwiinka kuzibaka zyuumwine kuyookomba.<verse eid="LUK 5:16" /></para>
  <para style="s">Jesu Waponya Mwaalumi Wayumunide Mubili</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mateyo 9:1-8</ref>; <ref loc="MRK 2:1-12">Maako 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Bumwi buzuba Jesu naalikwiisya mungʼanda, Bafalisi abamayi bo Mulawo balikede aawo. Bakazwidilide mumiinzi yoonse ya Galileya, Judiya o Jelusalemu. Nguzu zyo Mwami zyokuponya zyakalaawe. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Iino bantu bamwi bakeeta mwaalumi wayuminide mubili amacile. Bakasola kuteeti bamweete kunembo lya Jesu mungʼanda. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Kono mukubula cibaka cokwiinda kaambo kokuvula kwabantu, bakatanta manela kabaya atala lyeciluli cipateme, okudonkola cipulo okumwiinzya fateni kalede amacile aakwe kumusisya akati kabantu paabede Jesu.<figure style="fig" alt="Flat roof house" file="gt00044.tif" size="col" loc="5:17-5:26" ref="5:19">Ngʼanda yeciluli cipateme</figure> <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Jesu naakabona lusyomo lwabo wakateeti kumulwazi, “Mweenzuma, zibi zyako zyajatilwa.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Bafalisi abamayi bo Mulawo bakatalika kulyamboozya mumyoyo yabo kuteeti, “Ngwanooyu muntu usampoola Leza? Ngwani uunga wajatila zibi kunzaa Leza alike?”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Jesu mukuziba zyobali kuyeeya mumyoyo yabo wakateeti, “Ino niinzi comuyeeya zili namu? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Ino ceecili cuuba, kwaamba kuteeti, ‘Zibi zyako zyajatilwa,’ naakuteeti, ‘Nyamuka weende’? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Kono ndiyanda kumutondezya kuteeti Mwanoo Muntu ulijesi nguzu zyokujatila zibi aanaansi.” Mpoonyina Jesu wakaambila mwaalumi wakayumininide mubili kuteeti, “Nyamuka! Bweza macile aako, uye kungʼanda yako.”<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Mpoonyinaawo wakanyamuka kabalangilide okubweza macile aakwe, okuya kungʼanda yakwe kalumbaizya Leza. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Bantu boonse bakakomokwa loko, okulumbaizya Leza, kabayoowede bakateeti, “Twabona cikomosya sunu!”<verse eid="LUK 5:26" /></para>
  <para style="s">Jesu Waita Levi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mateyo 9:9-13</ref>; <ref loc="MRK 2:13-17">Maako 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Kumane, Jesu naalikuzwa mutaindi, wakabona simutelo walikwiitwa kuteeti Levi. Wakakede paali kubelekela. Jesu wakateeti kulinguwe, “Ndicilile!” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Mpoonyinaawo Levi wakanyamuka okusiya zyoonse zyaalikucita okumucilila.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Amane Levi wakapangila Jesu mukiti mupati angʼanda yakwe. Bunji bwabeenzu bakazide bali basimutelo abamwi bantu feela. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" /><note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luka 15:1-2</ref>.</char></note> Kono bamwi Bafalisi abamwi bamayi bo Mulawo balikubalilwa kubbazu lyabo bakatongookela basikwiiya ba Jesu kuteeti, “Niinzi nemulya okunywa abasimutelo, abamwi basizibi?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Mpoonyina Jesu wakabataba kuteeti, “Bantu baumbulu tabayandiki musilisi aati baciswa. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Sikazidilide kwiita bantu baluleme kono ndakazida kwiita basizibi kuteegwa basanduke.”<verse eid="LUK 5:32" /></para>
  <para style="s">Kwiisya Kwa Jesu Otunsiya-nsiya Twabasikale</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mateyo 9:14-17</ref>; <ref loc="MRK 2:18-22">Maako 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Bumwi buzuba bamwi bantu bakateeti kuli Jesu, “Basikwiiya ba Joni Mubbabbatizi aba Bafalisi balaliimya kulya okukomba kanji-kanji kono basikwiiya bako balalya okunywa.”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Mpoonyina Jesu wakabataba kuteeti, “Muyeeyaanga inga mwakasya beenzu basikukwata kulya kacilaabo? Nee! Tacikonzeki! <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Kono nako iyoosika sikukwata nayoobwezegwa kuzwa kulibo, mpampawo nebayooliimya kulya.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Ape Jesu wakabaambila cikozyanyo eeci, “Taakwe uuyaula cigamba kuzwa kucizwato cipya okucilukila acizwato ceciindi, kaambo acita namu cizwato cipya cilasinyeka ape cigamba cipya tacikoendelana ecizwato ceciindi. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Ape taakwe uutila waini mpya munkomo zyamatobo zyakabeleka kale. Naa wacita namu waini uulya ulabbotola okusinya nkomo ziya, kwamana waini ulasuumukilaansi. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Kono waini mpya yeelede kutilwa munkomo zyamatobo zipya.<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false">Jesu naalikwaamba kubika waini mpya munkomo zyamatobo eciindi cali mbuli kumvwelanya ziisyo zyakwe ezizo zyeciindi. Waini mpya yapapa, nkomo zyeciindi tizyalikunkonzya kufutumuka mpoonyina zilabbotoka. Munzila iswana, ziisyo zyakwe zipya tazyeendelani ezizo zyeciindi.</char></note> <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Ape taakwe uyanda waini mpya amana kunywa waini yeciindi. Ulateeti, ‘Waini yeciindi nimbotu kwiinda mpya.’”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Jesu ngo Mwami we Nsabata</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mateyo 12:1-8</ref>; <ref loc="MRK 2:23-28">Maako 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">Detilonomo 23:25</ref>.</char>
    </note>Jesu abasikwiiya bakwe balikuyoobweenda mumyuunda yamaila mubuzuba bwe Nsabata. Basikwiiya bakwe bakapulula mitwe yamaila okwiibukusa mumaanza okulya buseke bwa maila. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Bamwi Bafalisi nibakababona kabacita namu, bakabuzya kuteeti, “Ino niinzi nemucita cuutazumizi Mulawo mu Nsabata?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Mpoonyina Jesu wakabataba kuteeti, “Ino taakwe nimwakabala caakacita Deveti, we abantu mbaalaabo nibakafwide nzala na? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" /><note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Levitiko 24:9</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Samuele 21:1-6</ref>.</char></note>Ede wakanjila mulabba lye Ngʼanda ya Leza<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Mabbala “Ngʼanda ya Leza” kwaamba kweci Juda kupandulula Teente lya Leza naanga Ngʼanda ya Leza (yakayakidwe amabwe). Muciindi ca Deveti, eeci calikwaamba Teente lya Leza kutali Ngʼanda ya Leza Solomoni njakazooyaka. Deveti wakanjila mulabba lye Teente lyoku Nobi ooko kwaakazumizidwe kwiinka kutali mu Teente lyeni.</char></note> okubweza cinkwa caakapegwa omupaizi, cinkwa cakatuuzigwa kuli Leza. Wakalya okwabanya bantu bakwe. Kono Mulawo tiwalikuzumizya muntu feela utainsi mupaizi kulya cinkwa eeci.”<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Mpoonyina Jesu wakamanizya kateeti, “Mwanoo Muntu ngo Mwami we Nsabata.”<verse eid="LUK 6:5" /></para>
  <para style="s">Jesu Waponya Mwaalumi mu Nsabata</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mateyo 12:9-14</ref>; <ref loc="MRK 3:1-6">Maako 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Bumwi buzuba bwe Nsabata, Jesu wakanjila mu cikombelo okutalika kwiisya. Oomo mwali mwaalumi wayuminide janza lyolulyo. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Kwali bamwi bamayi bo Mulawo abamwi Mafalisi bali kuyandoola nzila yokupeda fateni Jesu mulandu. Kaambo keeci bakamulangisisya kuyanda kubona na ulaponya mu Nsabata. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Kono Jesu waliizi mizeezo yabo, mpoonyina wakaambila mwaalumi ooyu kuteeti, “Nyamuka uze kuno.” Mwaalumi wakainka okuyoima. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Mpoonyina Jesu wakababuzya kuteeti, “Ino ceecili Mulawo wesu cuuzumizya kucita mu Nsabata? Kucita cibotu na cibi? Kufutula buumi na kubusinyoona?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Amane wakazinguluka kubalanga boonse okwaambila mwaalumi kuteeti, “Olola janza lyako.” Mpoonyina wakacita mboonyina namu, janza lyakapona.<verse eid="LUK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11" />Eeci cakabanyemya loko Bafalisi abamayi bo Mulawo okutalika kwaamboozyanya mulicabo mbobatimucite Jesu.<verse eid="LUK 6:11" /></para>
  <para style="s">Jesu Wasala Baapositola Balikumi Abobile</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mateyo 10:1-4</ref>; <ref loc="MRK 3:13-19">Maako 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Muciindi eeco Jesu wakainka kucilundu okuyookomba kuli Leza busiku boonse. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Nibwakaca wakaita basikwiiya bakwe, akati kabo wakasala bali kumi abobile okubaita kuteeti mbaapositola. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Bakaitwa mbaaba, Saimoni ngwakauzika kuteeti Pita o Andulu mwence wakwe, Jemusi o Joni, Filipo o Batolomeyo, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Mateyo o Tomasi, Jemusi mwanaa Alufasi, o Saimoni walikwiitwa kuteeti Sikulwanina Lwaanguluko, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Judasi mwanaa Jemusi, o Judasi Isikaliyoti wakazomwaaba.<verse eid="LUK 6:16" /></para>
  <para style="s">Jesu Waiisya Okuponya</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mateyo 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Jesu wakaselela abaapositola kuzwa acilundu okwiima apateme. Mpoonyina wakajana basikwiiya bakwe banji kababungene antoomwi ebbunga lyabantu balikuzwa ku Judiya yoonse, oku Jelusalemu, omuzilalaanda zya Taila o Sidoni zili mumbaloo lwizi. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Bakeza kuzoomumvwa kaiisya okuponisigwa kumalwazi aabo, abalikusyupwa emyuuya mibi bakaponisigwa. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Bantu boonse balikuyanda kumuguma, kaambo nguzu zyalikuzwa mulinguwe okubaponya boonse.<verse eid="LUK 6:19" /></para>
  <para style="s">Kulelekwa o Kuusa</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mateyo 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Mpoonyina Jesu wakalanga kuli basikwiiya bakwe okuteeti,</para>
  <para style="q1" vid="LUK 6:20">“Mulilelekedwe nomupengede,</para>
  <para style="q2" vid="LUK 6:20">kaambo Bwami bwa Leza mbubwenu.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Mulilelekedwe nomufwa nzala iino nako,</para>
  <para style="q2" vid="LUK 6:21">kaambo muzookuta.</para>
  <para style="q1" vid="LUK 6:21">Mulilelekedwe nomulila iino nako,</para>
  <para style="q2" vid="LUK 6:21">kaambo muyooseka.<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:22 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1 Pita 4:14</ref>.</char>
    </note> “Mulilelekedwe bantu banomusulaika, banomukaka, banomutuka okunomwaamba kuteeti muli babi kaambo ko Mwanoo Muntu. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" /><note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Makani 36:16</ref>; <ref loc="ACT 7:52">Misebezi 7:52</ref>.</char></note> Mubotelwe okuzyana cokunonenwa eezi zyacitika kaambo bulumbu bwenu kujulu mbupati. Mboonyina namu basikale babo mbubakacita basinsimi.”<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />“Kono maawe kulinywebo nomuvubide iino nako,</para>
  <para style="q2" vid="LUK 6:24">kaambo mwatambula kale buumi bubotu buzulide.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Maawe kulinywebo nomukuta iino nako,</para>
  <para style="q2" vid="LUK 6:25">kaambo muyoofwa nzala.</para>
  <para style="q1" vid="LUK 6:25">Maawe kulinywebo nomuseka iino nako,</para>
  <para style="q2" vid="LUK 6:25">kaambo muyoolila okoomoka.<verse eid="LUK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26" />“Maawe kulinywebo nomwaambwa zibotu kubantu boonse, kaambo abasikale babo bakacita mboonya namu ku basinsimi babeji.<verse eid="LUK 6:26" /></para>
  <para style="s">Yanda Basinkondonyoko</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mateyo 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Kono nywebo nomundiswiilizya ndamwaambila kuteeti, muyande basinkondonyoko ape aabo batamuyandi mubacitile zibotu. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Amuleleke aabo bamufwiza okukombela aabo bamupenzya. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Nakuteeti muntu wakuuma kutama umuzumizye kuuma elimwi tama. Uutola jansi lyako, umuzumizye kutolelezya ecibaki. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Kufumbwa uukukumbila cintu umupe, ape naa muntu wabweza cintu cako, utacisesi kuteeti acipilusye. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" /><note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">Mateyo 7:12</ref>.</char></note> Amucitile bamwi mbuli mbomuyanda kuteeti abo bamucitile.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />“Nakuteeti kamuyanda feela bamuyanda, ino muleelede kulumbaizigwa na? Ede abo basizibi bayanda babayanda! <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Ape nakuteeti kamucitila feela zibotu aabo bamucitila zibotu, ino muleelede kulumbaizigwa na? Ede abo basizibi mbobacita namu! <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Nakuteeti kamukolotisya feela aabo mbomuyeeya kuteeti balapilusya, ino muleelede kulumbaizigwa na? Ede abo basizibi balakolotisyanya, kuteegwa babapilusizye mboonya mbubakakolotisya. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Kono muyande basinkondonyoko okubacitila zibotu. Amukolotisye kamutalindili kupilusizigwa. Nakuteeti mwacita namu, bulumbu bwenu bunooli bupati ape muyooba bana ba Leza Sijulu Wama Julu, kaambo we mubotu kubatalumbi okubabi. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Amube amangʼeke mbuli Leza Uso mbwalaamangʼeke.<verse eid="LUK 6:36" /></para>
  <para style="s">Kwaatula Bamwi</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mateyo 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“Mutaatuli kuteegwa anywebo mutaatulwi. Mutapi mulandu kuteegwa anywebo mutapegwi mulandu. Amujatile kuteegwa anywebo mujatilwe. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Amupe kulibamwi kuteegwa Leza akamupe anywebo. Nconzyo muyoopegwa cipimyo cizwide, citikimwidwe, cisindailidwe okufusuka. Cipimyo comubelesezya bamwi awe Leza cayoomubelesezya.” <verse eid="LUK 6:38" /><verse number="39" style="v" sid="LUK 6:39" /><note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">Mateyo 15:14</ref>.</char></note> Mpoonyina ape Jesu wakabaambila cikozyanyo eeci: “Ino moofu inga wakonzya kusolweda moofunyina na? Tabakoowida mucilindi boonse na? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" /><note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">Mateyo 10:24-25</ref>; <ref loc="JHN 13:16">Joni 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char></note> Taakwe sikwiiya wiinda mwiiyi wakwe, kono sikwiiya woonse amanizya kwiiya uba mbuli mwiiyi wakwe.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“Ino niinzi nolanga kakwa kali mulinso lyo muzyalwanyoko kotalangi tanda lili mulinso lyako? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Ino niinzi noambila muzyalwanyoko kuteeti, ‘Koza ndikugwisye kakwa kali mulinso lyako,’ kono tokonzyi naanga kubona tanda lili mulinso lyako? Yebo osikupaupa amenso! Saanguna kugwisya tanda lili mulinso lyako, mpoonyina inga wabona obotu kuteegwa ugwisye kakwa kali mulinso lyo muzyalwanyoko.”<verse eid="LUK 6:42" /></para>
  <para style="s">Musamu Emicelo Yawo</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mateyo 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />Taakwe musamu mubotu uuzyala micelo mibi, ape naanga musamu mubi uuzyala micelo mibotu. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" /><note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mateyo 12:33</ref>.</char></note> Ede musamu uuli woonse uzibilwa kumicelo yawo, mbuli mbomuzi kuteeti nkuyu tazicelwa kumyuumvwa naanga nsaansa kumyuunga. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" /><note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mateyo 12:34</ref>.</char></note> Muntu uulikabotu ucita zibotu kuzwa kuzibotu zyabambide mumoyo wakwe, awe muntu uutalikabotu ucita zibi kuzwa kuzibi zyabambide mumoyo wakwe, kaambo mulomo wakwe waamba zizwide mumoyo wakwe.<verse eid="LUK 6:45" /></para>
  <para style="s">Bayasi Bamaanda Bobile</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mateyo 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Ino niinzi comundiitila kuteeti, ‘Mwami, Mwami,’ kono tamuciti zendimwaambila? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Kufumbwa uuza kulindime okuzooswiilizya majwaangu okwaacilila, ndilamutondezya mbwabede. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Uli mbuli muyaki naalikuyaka ngʼanda yakwe, wakasya kusikaabbwe, aawo pakayakila ntalisyo. Mulonga niwakabayuka, maanzi akauma angʼanda eeyo kono taakwe niyakawa, kaambo yakayakidwe kabotu. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Iino kufumbwa uumvwa majwaangu kono kataacilizyi uli mbuli mwaalumi wakayaka ngʼanda amuse kataside ntalisyo. Mulonga niwakazula okubayuka, maanzi akayuuma ngʼanda mpoonyina yakawa okukolomoka kumaninina.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Jesu Waponya Muzike Wasilutwe Wabasilumamba</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mateyo 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Jesu naakamana kwaamba zintu eezi zyoonse kubantu, wakanjila mu Kapenaumu. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Mutaindi eelyo kwakali umwi mweendelezi wabasilumamba beci Loma, wakajesi muzike ngwaalikuyandisya loko. Muzike ooyo walikuciswa colufu. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Silutwe wabasilumamba naakamvwa zya Jesu, wakakumbila bamaalu beci Juda bamwi kuteegwa bakamukumbilile kuteeti Jesu aze kuzooponya muzike wakwe. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Mpoonyina bakeza kuli Jesu, okumukombelezya loko kabateeti, “Ooyu muntu uleelede kugwasigwa ayibo. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Muntu uuyanda musyobo wesu weci Juda ape nguwakatuyakila cikombelo.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Mpoonyina Jesu wakainkaabo. Naakasika afwiifwi engʼanda, mweendelezi wabasilumamba wakatuma bamwi beenzinyina kuteegwa baambile Jesu kuteeti, “Mwami, utalikatazyi, kaambo tandelede kuteeti undizide mu ngʼanda yangu. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Naanga mebo kulimvwa kuteeti ndileelede kuza kulindiwe. Lailila feela mpoonyina mubelesi wangu ulapona. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Ndilizi kaambo amebo ndili muntu weendelezegwa abolupati-pati ape ndeendelezya basilumamba bamwi. Ndaambila omwi kuteeti ‘Koya’, ulainka, ape na ndaambila umwi kuteeti, ‘Koza’ uleza. Ape ndalailila mubelesi wangu kuteeti, ‘Cita namu,’ ulacita.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Jesu naakamvwa namu wakamukomokwa. Wakalanga bbunga lyabantu lyalikuyoobumucilila okuteeti, “Ndimwaambila kuteeti tandina kujana lusyomo mbuli oolu nekuba kubana Izilaili!”<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />Aabo bakatumidwe nibakapiluka kungʼanda ya silutwe wabasilumamba, bakajana mubelesi wapona kale.<verse eid="LUK 7:10" /></para>
  <para style="s">Jesu Wabusya Mwana Womukamufu</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Kuzwaawo, Jesu abasikwiiya bakwe bakainka kutaindi lya Naini, abantu banji bakamucilila. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Naakasika feela amanjililo omuunzi, wakaswaana bantu bayumwine mutunta. Ooyo mufu ngowakali mwana musyimani alike womukamufu. Bantu banji bakezaawe mukamufu ooyo kuzwa mumuunzi. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Mpoonyina Mwami naakabona mukamufu, wakamufwida mangʼeke okumwaambila kuteeti, “Aakaka leka kulila.” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Jesu wakaswena afwiifwi okujata macile mpaalede mufu, balikwaayumwine bakaima. Mpoonyina Jesu wakateeti, “Musyimani, ndikwaambila kuteeti buka!” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Wakabuka okukala okutalika kwaamboola, amane Jesu wakamupeda kuli banyina.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Bantu boonse bakayoowa loko mpoonyina bakatalika kulumbaizya Leza kabateeti, “Musinsimi mupati wasika akati kesu! Leza waza kuzoofutula bantu bakwe!”<verse eid="LUK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17" />Mpuwo ya Jesu yakasabalangana cisi coonse ce Judiya ecilalaanda cizingulukide.<verse eid="LUK 7:17" /></para>
  <para style="s">Batumwa Kuzwa Kuli Joni Mubbabbatizi</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mateyo 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Basikwiiya ba Joni nibakamwaambila<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">Basikwiiya ba Joni bakamwaambila zintu zyoonse kali muntolongo.</char></note> zyoonse Jesu zyaalikucita, Joni wakaita bobile alimbabo. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Wakabatuma kuli Jesu kuyoomubuzya kuteeti, “Ino ndiwe ooyo uuza na? Na katucilangila umbi?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Iino nibakasika kuli Jesu bakateeti, “Joni Mubbabbatizi watutuma kuzoobuzya kuteeti, ‘Ino ndiwe ooyo uuza na? Na katucilangila umbi?’”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Aciindi conya eeco, Jesu wakaponya bantu banji balikuciswa aabo bakali amalwazi okutanda myuuya mibi, ape wakabonya boofu banji. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" /><note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Izaya 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref>.</char></note> Mpoonyina wakateeti kuli basikwiiya ba Joni, “Amupiluke mukaambile Joni zimwabona okumvwa, boofu balabona, zihole zileenda, basizinsenda balapona, basinkide matwi balamvwa, bafu balabusigwa, Makani Mabotu alakambookwa kubapenzi. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Ulilelekedwe ooyo utandizumboozyi!”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Kuzwaawo basikwiiya ba Joni nibakapiluka, Jesu wakatalika kwaamboola zya Joni Mubbabbatizi kubantu banji kateeti, “Nimwakainka munkanda kuli Joni mwalikuyanda kubona muntu uulibuti? Kana ndubu lwali kuzungaana kaambo koluwo na? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Nee? Ino mwainkide kuyobona ni? Mwaalumi uzwete zizwato zidula na? Bantu bazwata namu okupona kabotu bajanika mumaanda aabami! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Ino mwakainkilide kuyoobonaanzi? Musinsimi na? Iiyi nconzyo, kono mwakabona ciinda amusinsimi. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" /><note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Malaki 3:1</ref>.</char></note> Joni nguwaambwa mumalembe kuteeti, ‘Leza wakaamba kuteegwa, Bona! Ndiyootuma mutumwa wangu kunembo lyako kuyoobamba nzila motizooinde.’” <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Jesu wakayungizizya okuteeti, “Ndimwaambila kuteeti, Joni mupati kwiinda boonse bakaponaansi aano. Kono ooyo muniini mu Bwami bwa Leza mupati kwiinda Joni.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:32">Mateyo 21:32</ref>; <ref loc="LUK 3:12">Luka 3:12</ref>.</char>
    </note> Bantu boonse antoomwi abasimutelo bakamvwa kukambooka kwa Joni, bakazumina kuteeti nzila ya Leza ililuleme mpoonyina ncibakabbabbatizigwa okucililizya zyayanda Leza. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Kono Bafalisi abamayi bo Mulawo bakakaka muzeezo ngwaali kujesi Leza alibo, ncibakakakila kubbabbatizigwa o Joni.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Jesu wakaindilizya kateeti “Ino bantu bomusela wesunu inga ndabakozyanye enzi? Babede mbuli nzi? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Bali mbuli bana bakede mumusika. Kamwi kabunga kabana kalateeti kuli kamwi, ‘Twamulizizya nyeele, kono taakwe nimwazyana! Twaimba nyimbo zyecililo kono taakwe nimwalila.’ <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Ede Joni Mubbabbatizi wakeza katalyi zilyo zibalikulya obuzuba bantu boonse okutanywa waini, mpoonyina mwaamba kuteeti, ‘Uleedimona.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Mwanoo Muntu wakeza kalya okunywa, mpoonyina mwaamba kuteeti, ‘Amumubone, uleendya ape mukolwi, mweenzinyina wabasimutelo abasizibi.’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Kono busongo bwa Leza bulalitondezya kuteeti mbwanconzyo mubana bakwe.”<verse eid="LUK 7:35" /></para>
  <para style="s">Jesu Wananikwa o Mwanakazi Sizibi</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateyo 26:6-13</ref>; <ref loc="MRK 14:3-9">Maako 14:3-9</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Umwi Mufalisi wezina lya Saimoni wakatamba Jesu kuteeti akalalile awe. Mpoonyina Jesu wakainka kungʼanda yo Mufalisi okuyookalaansi kuteegwa alye. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" /><note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:7">Mateyo 26:7</ref>; <ref loc="MRK 14:3">Maako 14:3</ref>; <ref loc="JHN 12:3">Joni 12:3</ref>.</char></note> Iino oomo mutaindi mwali mwanakazi sizibi. Naakamvwa kuteeti Jesu walikulya mu ngʼanda yo Mufalisi, wakeeta nsanzi yakapangwa ebbwe lya alabbasita<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">Alabbasita lyali bbwe bbotu lyo musyobo uutuba omungunga we ji lyalikuzwa ku Ijipiti. Balikupanga nsazi ezimwi zintu zibotu kuzwa kulindilyo.</char></note> yalikuzwide mafuta aanunkilila. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Ooyu mwanakazi wakaima kusule lya Jesu kuzituta zyakwe kalila okutalika kuzitesya emisozi yakwe. Amane wakazipukuta amasusaakwe, wakazimyonta okuzitila mafuta aanunkilila.<figure style="fig" alt="Jesus sitted with people at the table, woman wiping Jesus' feet her hair" file="wa03839b.tif" size="col" loc="7:36-7:50" ref="7:38">Jesu kakede abantu atafule, mwanakazi kamupukuta zituta zyakwe amasusaakwe</figure> <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Mufalisi wakatamba Jesu naakabona namu, wakalyamboozya mumoyo wakwe kateeti, “Kambe ooyu mwaalumi walimusinsimi, naaziba mbwabede ooyu mwanakazi umujata obuumi bwezibi mbwapona.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Mpoonyina Jesu wakamwaambila kuteeti, “Saimoni ndilaacokukwaambila.”</para>
  <para style="p" vid="LUK 7:40">Saimoni wakataba kuteeti, “Iyii O mwiiyi, ndaambile.”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Jesu wakamwaambila caano kateeti, “Kwali baalumi bobile bakakolotede mali kuli sikukolotisya, womwi wakolotede myaanda yosanwe yamali eensiliva, umwi wakolotede makumi osanwe. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Taakwe naanga omwi walikukonzya kupilusya cikoloti alaaba bobile, mpoonyina wakabajatila. Iino ngwani alaaba bobile utimuyande loko?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Saimoni wakataba kuteeti, “Ndiyeeyaanga ngooyo wakajatilwa zinji.”</para>
  <para style="p" vid="LUK 7:43">Jesu wakamwaambila kuteeti, “Wataba kabotu.” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Mpoonyina wakacebukila mwanakazi okwaambila Saimoni kuteeti, “Wamubona ooyu mwanakazi zyaacita? Nindeza mu ngʼanda yako mbuli mweenzu, taakwe niwandipa maanzi ookusamba kuzituta,<note caller="+" style="f"><char style="fr" closed="false">7:44 </char><char style="ft" closed="false">Mucizo cama Juda, calicitambo kuteeti mweenzu walikubikilwa maanzi ookusamba kumaulu. Eeci calikweelela loko kalaabo beenzu balikweenda munzila yesuko.</char></note> kono we wasanzya zituta zyangu emisozi yakwe okuzipukuta amasusaakwe. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Taakwe niwandimyoonta<note caller="+" style="f"><char style="fr" closed="false">7:45 </char><char style="ft" closed="false">Mucizo cama Juda, kumyoonta cali citambo baalumi mbobali kujuzyanya. Kumyoonta kwali atama naanga ajanza.</char></note> nindasika, kono we taakwe naaleka kumyonta zituta zyangu kuzwa nindasika. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Taakwe niwanditila mafuta kumutwe kundilemeka, kono we watila zituta zyangu amafuta aanunkilila. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Ndakwaambila kuteeti zibi zyakwe zyali zinji zyajatilwa caatondezezya luyando lupati. Kono kufumbwa uujatilwa ziniini, utondezya luyando luniini.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Mpoonyina Jesu wakaambila mwanakazi kuteeti, “Zibi zyako zyajatilwa.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Kono bamwi bakede ambabo atafule bakatalika kulibuzya kuteeti, “Ngwani ooyu, mane ukonzya okujatila zibi?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Mpoonyina Jesu wakateeti kumwanakazi, “Lusyomo lwako lwakufutula, koya muluumuno.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Banakazi Bakasindikizya Jesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Kuzwaawo, Jesu wakeenda musinzo, wakainda mumataindi omumiinzi kayoobukambooka Makani Mabotu oo Bwami bwa Leza. Basikwiiya bakwe bali kumi abobile bakainka awe. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" /><note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">Mateyo 27:55-56</ref>; <ref loc="MRK 15:40-41">Maako 15:40-41</ref>; <ref loc="LUK 23:49">Luka 23:49</ref>.</char></note> Ape abamwi banakazi mbaakaponya kumalwazi abamwi mbakagwisya myuuya mibi mbuli Maliya, walikwiitwa kuteeti Magadalena, abo bakainka awe. Maliya ngooyo wakanjidwe madimona aali ciloba aayo Jesu ngaakagwisya mulinguwe. <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Ape kwali o Joana mwanakazaa Cuza. Cuza wali mupati wababelesi mu ngʼanda ya Helodi. Ape kwali o Suzana, abamwi banakazi banji aabo bakabelesya lubono lwabo kugwasilizya Jesu abasikwiiya bakwe.<verse eid="LUK 8:3" /></para>
  <para style="s">Mukozyanyo Wasikuhasa</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mateyo 13:1-9</ref>; <ref loc="MRK 4:1-9">Maako 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Bumwi buzuba bantu banji nibakamubunganina Jesu kuzwa mumataindi asiyene-siyene, wakabaambila mukozyanyo ooyu wokuteeti,<verse eid="LUK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5" />“Kwali mulimi wakainka kuyoohasa mbuto kumuunda. Naakali kuhasa, mbuto zimwi zyakawida mumbali enzila, mpoonyina zyakalyatwa, abayuni bakazilya zyoonse. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Mbuto zimwi zyakawida munyika yebbwe lipateme yakajesi muse muce. Mpoonyina nizyalikukomena zyakayuma, kaambo zyakabula mudumo. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Mbuto zimwi zyakawida munyika yakamenede myuumvwa. Mpoonyina nizyakakomenena antoomwi, myuumvwa yakazifundilizya zisyango okuzisinkilizya. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Mbuto zimwi zyakawida mumuse mubotu, zyakakomena okuzyala micelo ivuzyanya mwaanda.”</para>
  <para style="p" vid="LUK 8:8">Jesu wakamanizya okuteeti, “Amuswiilizye! Ulaamatwi ookumvwisya amvwe!”<verse eid="LUK 8:8" /></para>
  <para style="s">Muzeezo Wokwaambweeda Muzikozyanyo</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mateyo 13:10-17</ref>; <ref loc="MRK 4:10-12">Maako 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Kuzwaawo basikwiiya ba Jesu bakamubuzya kuteeti, “Ino cikozyanyo eeci caamba nzi?” <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" /><note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Izaya 6:9</ref>.</char></note> Mpoonyina wakabataba kuteeti, “Mulipedwe luzibo lwamaseseke Oobwami bwa Leza, kono kulibamwi lupedwa muzikozyanyo, kuteegwa kabalanga kono kabataboni, kabaswiilizya kono kabatamvwisisisyi.”<verse eid="LUK 8:10" /></para>
  <para style="s">Jesu Wapandulula Cikozyanyo Casikuhasa</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mateyo 13:18-23</ref>; <ref loc="MRK 4:13-20">Maako 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Jesu wakazwida anembo kateeti, “Ceeci cecaamba cikozyanyo eeci, mbuto ndijwi lya Leza. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Mbuto zyakawida mumbaleenzila caamba bantu bamvwa jwi lya Leza, mpoonyina Dyabulosi ulasika okuzoogwisya majwi mumyoyo yabo kuteegwa batasyomi okufutulwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Mbuto zyakawida anyika yebbwe lipateme, caamba aabo bamvwa majwi okwaatambula cokubotelwa, kono taanjililili mulibo. Basyoma feela nako niini kono masunko asika balawa. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Mbuto zyakawida mumuse wemiyanda yemyuumvwa, caamba aabo bamvwa majwi, kono kwainda nako, makatazyo kulikalelwa, buvubi ezisaano zyobuumi zilabakasya kuzyala micelo iisimide. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Mbuto yakawida mumuse mubotu, caamba aabo bamvwa majwi okwaabamba mumyoyo mibotu iisyomeka. Mpoonyina balazumanana kusikila bazyala micelo.<verse eid="LUK 8:15" /></para>
  <para style="s">Cikozyanyo ce Lampi</para>
  <para style="r">(<ref loc="MRK 4:21-25">Maako 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mateyo 5:15</ref>; <ref loc="LUK 11:33">Luka 11:33</ref>.</char>
    </note> “Taakwe muntu umunika lampi okulivunika ecisuwo na kulibika munsaabulo. Kono ulibika antangalala kuteegwa aabo banjila mukati babone mumuni.<verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:26">Mateyo 10:26</ref>; <ref loc="LUK 12:2">Luka 12:2</ref>.</char>
    </note> “Kufumbwa cisisidwe ciyoosisununwa, ape maseseke oonse ayeetwa antangalala.”<verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:29">Mateyo 25:29</ref>; <ref loc="LUK 19:26">Luka 19:26</ref>.</char>
    </note> “Amucenjele mbomumvwa, kaambo aabo bajesi bayoopegwa zinji, kono uutajesi uyoonyangwa naanga kaniini kayeeya kuteeti ulijesi.”<verse eid="LUK 8:18" /></para>
  <para style="s">Banyina Abazyalwanyina Jesu Benconzyo</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mateyo 12:46-50</ref>; <ref loc="MRK 3:31-35">Maako 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Kuzwaawo banyina abazyalwanyina Jesu bakeza kuzoobona Jesu, kono kaambo kokuvula kwabantu bakakacilwa kusika afwiifwi anguwe. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Mpoonyina umwi muntu wakaambila Jesu kuteeti, “Banyoko abazyalwanyoko baliimvwi anze, bayanda kukubona.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Kono Jesu wakabaambila kuteeti, “Bama abazyalwama, mbaabo bamvwa jwi lya Leza okulicililizya.”<verse eid="LUK 8:21" /></para>
  <para style="s">Jesu Waumuzya Guwo</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mateyo 8:23-27</ref>; <ref loc="MRK 4:35-41">Maako 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Bumwi buzuba Jesu abasikwiiya bakwe bakanjila mumugolo mpoonyina wakabaambila kuteeti, “Atuzubukile kutala limwi lyo lwizi.” Kumane bakatalikizya. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Nibalikuyoobuya mumugolo, Jesu wakoona. Mpoonyinaawo kwakabbubbula guwo pati mulwizi, mane maanzi akatalika kukupaikila mumugolo. Bakaba muntenda mpati. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Basikwiiya bakeza kuzoomubusya kabateeti, “Mwami! Mwami! Tuyanda kufwa!”</para>
  <para style="p" vid="LUK 8:24">Mpoonyina Jesu wakabuka okupatookela guwo amayuwe, mpoonya-mpoonya zyakamana olwiizi lwakaumuna zii. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Mpoonyina wakateeti kuli basikwiiya bakwe, “Lulikuli lusyomo lweenu?”</para>
  <para style="p" vid="LUK 8:25">Kono basikwiiya bakakomokwa okuyoowa loko, okulyaamboozya kabateeti, “Ngwanooyu uunga mane apatooka guwo amayuwe zilamumvwida?”<verse eid="LUK 8:25" /></para>
  <para style="s">Jesu Watanda Madimona Manji Mumwaalumi</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mateyo 8:28-34</ref>; <ref loc="MRK 5:1-20">Maako 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Jesu abasikwiiya bakwe bakazubuka mumugolo okusika kucilalaanda cabana Gelasa, calangene o Galileya. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Jesu naakaseluka mumugolo, umwi mwaalumi wanjidwe madimona wakeza okuzomuswanganya. Ooyu mwaalumi walikuzwa mutaindi eeli kono kweciindi cilamfu taalikukala mungʼanda walikukala mumayumbelo ape taalikuzwaata. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Naakabona Jesu, wakoongolola okulifusa kuzituta zya Jesu okwaamba kuteeti, “Jesu Mwanaa Leza, Sijulu Wama Julu! Ino uyanda nzi kulindime? Ndakukumbila utandipi cisubulo!” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Wakaamba namu kaambo Jesu wakalailide kale muuya mubi kuteeti uzwe mulinguwe. Bunji bweziindi naalikupenzegwa omuuya mubi ooyu walikulindilwa kaangidwe amaceeni kumaanza okumaulu kono walikwaadunsula mpoonyina muuya mubi walikumutola musaka.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Jesu wakamubuzya kuteeti, “Ndiweni zina lyako?”</para>
  <para style="p" vid="LUK 8:30">Wakateeti, “Ndime dwi lyabasinkondo,” kaambo wanjidwe madimona manji. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Madimona akazumanana kukombelezya Jesu kuteegwa ataatandili mudindi litagoli.<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Ma Juda balikusyoma kuteeti cibaka cabafu kwali kunseenyika. Ape cali cibaka myuuya mibi koyakabikidwe kiilindila buzuba Leza mbwayoipa cisubulo.</char></note><verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Iino afwiifwi kwali tanga pati lyengulube zyalikucela acilundu, mpoonyina madimona akakumbila Jesu kuteeti aazumizye kunjila mungulube. Kumane wakaazumizya. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Madimona aaya akazwa mumwaalumi ooyu okuyoonjila mungulube mpoonyina tanga lyoonse lyakaselemuka kuzwa acilundu okuwida mulwizi okwiinkila.<figure style="fig" alt="Pigs rushing off the cliff" file="wa03846b.tif" size="col" loc="8:26-8:39" ref="8:33">Tanga lye ngulube kaliselemuka kuzwa acilundu</figure><verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Baalumi bali kweembela ngulube nibakabona namu, bakacija kabayoobusabalanganya nkaneeyi mutaindi omumiinzi yalaafwiifwi. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Kuzwaawo bantu bakainka kuyoobona zyakacitika, mpoonyina nibakeza kuli Jesu bakamujana mwaalumi ooyo wakagwisigwa madimona kakede kumaulu a Jesu kazweete ape kasitikide, mpoonyina bakayoowa boonse. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Aabo bakabona ooyo mwaalumi mbwaakafutulwa kuzwa ku madimona bakaambila bantu. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Mpoonyina bantu boonse mucilalaanda ca Gelasa bakakumbila Jesu kuteeti ainke, kaambo bakayoowa loko. Mpoonyina Jesu wakanjila mumugolo okwiinka. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Kono Jesu katana kunyamuka, mwaalumi ooyo ngwakagwisya madimona wakakumbila kuteeti acilile Jesu. Kono Jesu wakamupilusya kateeti, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Piluka kungʼanda yako ukakwaambe Leza zyaakucitila.”</para>
  <para style="p" vid="LUK 8:39">Kumane mwaalumi ooyu wakainka kayoobwaambilizya taindi lyoonse caakacitilwa kuli Jesu.<verse eid="LUK 8:39" /></para>
  <para style="s">Mwanaa Jailosi o Mwanakazi Wakakuma Jansi Lya Jesu</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mateyo 9:18-26</ref>; <ref loc="MRK 5:21-43">Maako 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Iino Jesu abaskwiiya bakwe nibakapiluka kubbazu limwi lyo lwizi, bantu banji bakamutambula kabotu kaambo boonse balikumulindila. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Mpoonyinaawo umwi wabeendelezi be cikombelo walikwiitwa kuteeti Jailosi wakeza okufugama anembo lya Jesu, okumukombelezya kuteeti ainke kungʼanda yakwe, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />kaambo kokuteeti mwana wakwe musimbi waleemyaka ili kumi ayobile walikuciswa cokuyanda kufwa. Ngomwana ngwaalikujesi alike.</para>
  <para style="p" vid="LUK 8:42">Jesu wakazumina kwiinka awe. Mpoonyina naalikuyobweenda bantu balikuyoobumusyaanikizya. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Iino kwali mwanakazi walikuciswa bulwazi bwakalobola kwemyaka iili kumi eyobile, wakabbadela zyoonse zyaajesi kubasilisi<note caller="+" style="f"><char style="fr" closed="false">8:43 </char><char style="ft" closed="false">Amwi malembo taalembedwe kuteeti, “Wakabbadela zyoonse zyaajesi kubasilisi.” </char></note>, kono taakwe wakakonzya kumusilika.<verse eid="LUK 8:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 8:44" />Wakanjila mubantu kusule lya Jesu, okukuma kumamanino ejansi lya Jesu, mpoonyinaawo gazi lyakaleka kuzwa.<figure style="fig" alt="Woman touching the edge of Jesus' robe" file="lb00310b.tif" size="col" loc="p" ref="8:44">Mwanakazi wakuma kumamanino ejansi lya Jesu</figure> <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Jesu wakabuzya kuteeti, “Ngwani wandikuma?”</para>
  <para style="p" vid="LUK 8:45">Kono boonse bakakaka. Mpoonyina Pita wakateeti, “Simalelaangu, bantu banji balikuzungulukide okukusyaanikizya.”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Kono Jesu wakateeti, “Kuluumwi wandikuma ecaali, kaambo ndamvwa nguzu ziponya zyazwa mulindime.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Ooyu Mwanakazi naakabona kuteeti wasyungulwa, wakeza kuli Jesu katuntuma<note caller="+" style="f"><char style="fr" closed="false">8:47 </char><char style="ft" closed="false">Kweendelana omulawo weci Juda, kuciswa ko mwanakazooyu kwakamusofwaazya. Nakuteeti wakuma muntu ooyo muntu awe ulasofwaala. Mwendi walikuyoowa kuteeti Jesu abamwi bantu baziba kuteeti wakuma Jesu balanyema. </char></note> okufugama anembo lyakwe. Mpoonyina wakalungulwida Jesu akati kabantu boonse caakamukumina ombwaakaponesegwa mpoonyinaawo. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Mpoonyina Jesu wakamwaambila kuteeti, “Omwanaangu, lusyomo lwako lwakuponya. Koya muluumuno.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Jesu naacilikwaamboola omwanakazi, kwakeza mutumwa kuzwa kungʼanda ya Jailosi okwaambila Jailosi kuteeti, “Mwanaako wafwa, lekakusyupa mwiiyi.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Kono Jesu naakamvwa zyakacitika, wakaambila Jailosi kuteeti, “Utayoowi, syoma feela, mpoonyina mwana wako ulapona.”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Jesu naakasika kungʼanda ya Jailosi taakwe ngwakazumizya kumucilila kunjila anguwe mu ngʼanda kunze lya Pita, Joni, Jemusi, baisi abanyina mufu. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Boonse bantu balikubede kwateni balikulila, kono Jesu wakabaambila kuteeti, “Amuleke kulila, kaambo ooyu mwana tafwide ulede feela.”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Kono bo bakatalika kumufubaazika, kaambo balizi kuteeti mwana wafwa. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Kono Jesu wakajata janza lyomwana ooyo okwaambisya kateeti, “Mwanaangu, buka!” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Muuya womwana wakapiluka, mpoonyinaawo mwana wakabuka. Kuzwaawo Jesu wakabalailila kuteeti, “Amumupe cokulya.” <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Bazyali bo mwana bakakomokwa, kono Jesu wakabakasya kwaambila muntu naanga omwi kuli zyakacitika.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Jesu Watuma Basikwiiya Bali Kumi Abobile</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mateyo 10:5-15</ref>; <ref loc="MRK 6:7-13">Maako 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Kuzwaawo Jesu wakaita basikwiiya bali kumi abobile antoomwi okubapa nguzu zyokugwisya madimona oonse okuponya malwazi. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Mpoonyina wakabatuma kuteeti bainke kuyookambooka zyo Bwami bwa Leza okuponya balwazi. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Wakabaambila kuteeti, “Mutabwezi naanga cintu comwi mumusinzo wenu, mutabwezi nkoli na cilyo, mpotomona naanga mali, ape mutabwezi zibaki kunze azyomuzweete. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Kufumbwa mu ngʼanda mobayoomutambula, mukakale moonyoomo kusikila mwaakuzwa mucibaka eeco. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" /><note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Misebezi 13:51</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luka 10:4-11</ref>.</char></note> Ape kufumbwa mutaindi njimwatatambulwa, mwanoozwa kwateni mukunkumune suko ili kumaulu eenu kuteeti cikabe citondezyo cokubacenjezya.”<verse eid="LUK 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 9:6" />Mpoonyina basikwiiya bakainka okwiinda mumiinzi yoonse kabaabukambooka Makani Mabotu, okuponya bantu koonse-koonse.<verse eid="LUK 9:6" /></para>
  <para style="s">Kukatazigwa ko Mwami Helodi</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mateyo 14:1-12</ref>; <ref loc="MRK 6:14-29">Maako 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mateyo 16:14</ref>; <ref loc="MRK 8:28">Maako 8:28</ref>; <ref loc="LUK 9:19">Luka 9:19</ref>.</char>
    </note> Iino Helodi Antipasi mwami wa Galileya wakamvwa zyoonse Jesu zyakacita. Mpoonyina wakakatazigwa loko kaambo bamwi balikwaamba kuteeti Joni Mubbabbatizi wabuka kuzwa kubafu. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Bamwi balikuteeti musinsimi Elija<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">Elija walimusinsimi wakapona myaka iinda kumiyanda yosanwe Jesu katana zyalwa. Ma Juda balikuyeeya kuteeti Elija ulapiluka katanaza Mesiya. Kusyoma namu bakakujana mubbuku lya Malaki 4:5-6. Elija taakwe naakafwa, kaambo Leza wakamutola kujulu mungolovani (2 Bami 2). Mweendi eeci cecico Luka caakaambila kuteeti, “walibonya” kunze lyokwaamba kuteeti, “wakabuka kuzwa kubafu.” </char></note> walibonya ape, mpoonyina bamwi balikwaamba kuteeti musinsimi umwi wabeciindi wabuka kuzwa kubafu. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Helodi wakateeti, “Ede Joni ndakamutimbuzya mutwe. Ino ngwani ooyu ucita zintu eezi zyendimvwide?” Mpoonyina wakasola loko kuteeti abone Jesu.<verse eid="LUK 9:9" /></para>
  <para style="s">Jesu Wasanina Bantu Bainda ku Zyuulu Zyosanwe</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateyo 14:13-21</ref>; <ref loc="MRK 6:30-44">Maako 6:30-44</ref>; <ref loc="JHN 6:1-14">Joni 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Baapositola nibakapiluka mumusinzo wabo, bakaambila Jesu zyoonse zibakaakucita. Kumane wakababweza okwiinkaabo kutaindi lya Bbetisaida kuteegwa bakabe abalike. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Kono bantu banji nibakamvwa bakamucilila, mpoonyina wakabatambula, okubaambila zyo Bwami bwa Leza okuponya balikuciswa.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Izuba nilyakainka mukubbila, basikwiiya balikumi abobile bakeza kulinguwe okuteeti, “Niwabaambila bantu kuteeti bainke mumiinzi otuunzi tulaafwiifwi kuteegwa bakalijanine zyokulya amalalo kaambo ecino cibaka cilikule abantu.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Kono Jesu wakaambila basikwiiya bakwe kuteeti, “Ndinywenya nywebo amubape zyokulya.”</para>
  <para style="p" vid="LUK 9:13">Mpoonyina bakataba kuteeti, “Kono tujesi feela zinkwa zyosanwe enswi zyobile. Ino uyanda kuteeti tukabaulile zilyo bantu boonse aaba na?” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Kwakali baalumi balikutandila kusika kuzyuulu zyosanwe mumbunga.</para>
  <para style="p" vid="LUK 9:14">Jesu wakaambila basikwiiya bakwe kuteeti, “Amubaambile bantu bakale makumi osanwe kabunga akabunga.”<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Basikwiiya nibakamana kucita namu, <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Jesu wakabweza zinkwa zyosanwe enswi zyobile, wakalanga kujulu okuzileleka. Mpoonyina wakazikomoona okupa basikwiiya bakwe kuteegwa baabanye bantu. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Boonse bakalya okukuta. Kuzwaawo basikwiiya bakabwezelela zizuma zili kumi ezyobile zyezilyo zyakasyaala.<verse eid="LUK 9:17" /></para>
  <para style="s">Pita Waamba Kuteeti Jesu ngu Mesiya wa Leza</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mateyo 16:13-19</ref>; <ref loc="MRK 8:27-29">Maako 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Bumwi buzuba Jesu naalikukomba alike, basikwiiya bakwe balaafwiifwi. Mpoonyina wakababuzya kuteeti, “Ino bantu bandaamba kuteeti ndime ni?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1-2">Mateyo 14:1-2</ref>; <ref loc="MRK 6:14-15">Maako 6:14-15</ref>; <ref loc="LUK 9:7-8">Luka 9:7-8</ref>.</char>
    </note> Bakamutaba kuteeti, “Bamwi baamba kuteeti, ndiwe Joni Mubbabbatizi, bamwi baamba kuteeti, ndiwe musinsimi Elija, bamwi baamba kuteeti, uli umwi wabasinsimi beciindi wakabuka kuzwa kubafu.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68-69">Joni 6:68-69</ref>.</char>
    </note> Wakababuzya kuteeti, “Ino nywebo mundaamba kuteeti ndime ni?”</para>
  <para style="p" vid="LUK 9:20">Pita wakataba kuteeti, “Ndiwe Mesiya wa Leza.”<verse eid="LUK 9:20" /></para>
  <para style="s">Jesu Waamba zyo Kupenzegwa ezyo Lufu Lwakwe</para>
  <para style="r">(<ref loc="MAT 16:20-28">Mateyo 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Maako 8:30—9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Mpoonyina Jesu wakalailila basikwiiya bakwe cenguzu kuteeti bataambili muntu naanga omwi kuteeti ngwani. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Ape wakabaambila kuteeti, “Mwanoo Muntu weelede kupenga loko okukakwa abamaalu, bapaizi basilutwe, abamayi bo Mulawo. Ape weelede kujaigwa okubusigwa kuzwa kubafu kwainda mazuba otatwe.”<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mateyo 10:38</ref>; <ref loc="LUK 14:27">Luka 14:27</ref>.</char>
    </note> Mpoonyina Jesu wakabaambila boonse kuteeti, “Na kuli uyanda kundicilila, aliimye zyayanda, okunyamuna ciingano cakwe buzuba obuzuba okundicilila. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" /><note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mateyo 10:39</ref>; <ref loc="LUK 17:33">Luka 17:33</ref>; <ref loc="JHN 12:25">Joni 12:25</ref>.</char></note>Iino kufumbwa uyanda kufutula buumi bwakwe, uyoobusweekelwa, kono kufumbwa usweekelwa buumi bwakwe kaambo kangu uyoobufutula. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Ino nimpindu nzi muntu njakonzya kujana nakuteeti wavuba nyika yoonse kono wasweekelwa buumi butamani na wasinyeeka? Taakwe! <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Kufumbwa uumvwa nsoni akaambo kangu amajwaangu, awe Mwanoo Muntu uzoomufwida nsoni asika mubulemu bwakwe obulemu bwa Isi abangelo basalala. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Nconzyo ndamwaambila kuteeti, kobali bamwi baimvwaawa batayoofwi mane bakabone Bwami bwa Leza.”<verse eid="LUK 9:27" /></para>
  <para style="s">Kusanduka Kobube bwa Jesu</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mateyo 17:1-8</ref>; <ref loc="MRK 9:2-8">Maako 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Naalikuyanda kukwana mazuba aali lusele kaambide eezi, Jesu wakabweza Pita, Joni o Jemusi okwiinkaabo atala eecilundu kuyookomba. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Naalikukomba, bube bwe ciinso cakwe bwakasanduka, ezizwaato zyakwe zyakatuba buu. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Mpoonyinaawo kwakadunuka baalumi bobile, Mozesi o Elija okutalika kwaamboola anguwe. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Bakalibonya mubulemu bokujulu kabaamboola o Jesu mbwayoozuzilikizya muzeezo wa Leza kwiinda mukufwida mu Jelusalemu. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Iino Pita abeenzinyina bakalikoona. Nibakabuka bakabona bulemu bwa Jesu ape bakabona baalumi bobile kabaimvwi anguwe. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Mozesi o Elija nibalikuzwa kuli Jesu, Pita wakateeti, “Simalelo, cabota tuli kuno! Atupange tutungu totatwe, komwi kako, komwi ka Mozesi akomwi ka Elija.” Nconzyo taakwe naakazi caali kwaamba.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Kacaamboola kwakeza joba lyakazobavumba eceemvule cateni mpoonyina basikwiiya bakayoowa nilyakabavumba joba. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" /><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">Izaya 42:1</ref>; <ref loc="MAT 3:17">Mateyo 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Maako 1:11</ref>; <ref loc="LUK 3:22">Luka 3:22</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Pita 1:17-18</ref>.</char></note>Mpoonyina kwakazwa jwi mujoba, lyalikwaamba kuteeti, “Ooyu Mwanaangu, ngundakasala. Amumumvwide!”<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Nilyakaumuna jwi, basikwiiya bakajana kuteeti Jesu wali alike. Basikwiiya taakwe ngubakaambila aleeyo nako aleezi zibakabona.<verse eid="LUK 9:36" /></para>
  <para style="s">Jesu Waponya Musyimani Wajesi Muuya Mubi</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mateyo 17:14-18</ref>; <ref loc="MRK 9:14-27">Maako 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Buzuba bwakacilila Jesu abasikwiiya bakwe botatwe nibakaselela kuzwa acilundu, bantu banji bakamucinguuzya. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Mpoonyina mwaalumi umwi akati kebbunga lyabantu wakoongolola kateeti, “Omwiiyi! Ndakukomba, bona mwanaangu musyimani ngondijesi alike! <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Kucitika kuteeti muuya mubi ulamujataanga, mbuumujatila mpoonya-mpoonya ulamukwiizya okumusuntusya cokumugwisya kovu kumulomo, tuumuleki ape ulamucisa loko. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ndakumbide basikwiiya bako kuteeti bautande kono bakacilwa.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Jesu wakabaambila kuteeti, “Nywebo nomusela utakwe lusyomo, basicinguni! Ino ndikale nako ndamfu buti andinywe? Ndilamulangilizya nako ndamfu buti? Mweete kuno mwana wako.”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Musyimani naali kuyoobuza, dimona lyakamuwisizyaansi okumusuntusya. Mpoonyina Jesu wakalailila muuya mubi kuteeti uzwe okuponya musyimani, amane wakamupilusya kuli baisi. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Mpoonyina bantu boonse bakakomokwa nibakabona nguzu zya Leza.</para>
  <para style="s" vid="LUK 9:43">Jesu Waamba Zyolufu Lwakwe Ape</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Mateyo 17:22-23</ref>; <ref loc="MRK 9:30-32">Maako 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Bantu kabacikomokedwe alizyoonse zyaakacita Jesu, wakateeti kuli basikwiiya bakwe,<verse eid="LUK 9:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 9:44" />“Mutalubi zindaandoomwaambila! Mwanoo Muntu wandoabwa mumaanza aabantu.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Kono basikwiiya bakwe taakwe nibakamvwisisisya caali kwaamba kaambo cicalikwaamba calisisidwe kulibo cibatakamvwisisisya ape balikuyoowa kumubuzya fateni.<verse eid="LUK 9:45" /></para>
  <para style="s">Ngwani Mupati Kwiinda</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mateyo 18:1-5</ref>; <ref loc="MRK 9:33-37">Maako 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:46 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luka 22:24</ref>.</char>
    </note> Iino basikwiiya bakwe bakatalika kukazyanya kuteeti ngwani mupati akati kabo. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Kono Jesu naakaziba zibali kuyeeya, wakaita mwana muniini okumwiimika kumbali anguwe. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" /><note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mateyo 10:40</ref>; <ref loc="LUK 10:16">Luka 10:16</ref>; <ref loc="JHN 13:20">Joni 13:20</ref>.</char></note> Amane wakateeti kulibo, “Kufumbwa utambula mwana mbuli ooyu muzina lyangu, watambula ndime, ape kufumbwa unditambula, watambula wakandituma.”</para>
  <para style="p" vid="LUK 9:48">Wakamanizya kateeti, “Ooyo muniini akati kenu noonse, ngomupati kwiinda.”<verse eid="LUK 9:48" /></para>
  <para style="s">Utakazyanyi Anywebo Ulikubbazu Lyenu</para>
  <para style="r">(<ref loc="MRK 9:38-40">Maako 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Mpoonyina Joni wakateeti, “Omwiiyi, twabona muntu walikutanda madimona muzina lyako, mpoonyina twamwaambila kuteeti aleke kaambo tali umwi wesu.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Kono Jesu wakaambila Joni abasikwiiya bamwi kuteeti, “Mutasoli kumukasya, kaambo kufumbwa utamulwani ulikubbazu lyenu.”<verse eid="LUK 9:50" /></para>
  <para style="s">Muunzi wabana Samaliya Wakaka Kutambula Jesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Niyalaafwi kusika nako ya Jesu yokutolwa kujulu, wakakanza kwiinka ku Jelusalemu lilampe lifwiimpe. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Wakatuma batumwa kunembo lyakwe, bakainka kumuunzi wabana Samaliya kuyoomululamikila kusika kwakwe. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Kono bantu booko bakaka kumutambula kaambo balizi kuteeti walikuya ku Jelusalemu. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" /><note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2 Bami 1:9-16</ref>.</char></note> Basikwiiya bakwe Jemusi o Joni nibakabona namu, bakateeti, “O Mwami, ino uyanda kuteeti twiite mulilo kuzwa kujulu kuteegwa ubasinye na?”<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />Kono Jesu wakacebuka okubapatookela. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Mpoonyina we abasikwiiya bakwe bakainka kumuunzuumbi.<verse eid="LUK 9:56" /></para>
  <para style="s">Jesu Mbweelede Kucililwa</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mateyo 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Jesu abasikwiiya bakwe kabayobweenda munzila, mwaalumi umwi wakateeti kuli Jesu, “Ndilakucilila kufumbwa kotainke.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Mpoonyina Jesu wakamutaba kuteeti “Bamwaaba balijesi madindi, abayuni balijesi ziteente, kono Mwanoo Muntu takwe ngʼanda yokulala.”<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Kuzwaawo Jesu wakaambila mwaalumi umwi kuteeti, “Ndicilila!”</para>
  <para style="p" vid="LUK 9:59">Kono mwaalumi ooyo wakateeti, “Mwami, leka pili ndikazike tata.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Kono Jesu wakamutaba kuteeti, “Leka bafu bazikane. Kono yebo koya ukakambooke zyo Bwami bwa Leza.”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:61 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 19:20">1 Bami 19:20</ref>.</char>
    </note> Ape oumwi wakateeti, “Mwami, ndilakucilila kono leka pili ndikalaizye mukwasyi wangu.”<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Kono Jesu wakamutaba kuteeti, “Kufumbwa uulima ecikekele kumwi kacebuka musule tajesi mpindu mu Bwami bwa Leza.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Jesu Watuma Basikwiiya Bakwe bali Makumi aali Ciloba Abobile</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Kuzwaawo Mwami wakasala bamwi baalumi bali makumi aali ciloba abobile, okubatuma bobile-bobile kuteeti bainke kunembo lyakwe mumataindi oonse oomo mwaali kuyanda kwiinka. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" /><note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">Mateyo 9:37-38</ref>.</char></note> Mpoonyina wakaambila basikwiiya bakwe kuteeti, “Bukutuzi mbunji kono bakukutula baceya. Amukombe kuli mukamwini bukutuzi kuteegwa atumine fateni bamwi bakutuzi kuzookutula. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" /><note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">Mateyo 10:16</ref>.</char></note> Kamuya! Kono amumvwe! Ndimutuma mbuli mbelele akati kabaumpe. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Mutabwezi nkomo yamali naanga mpotomona nikuba zikatulu, ape mutaimi nako ndamfu kulumelesya muntu uuli woonse munzila. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Kufumbwa mungʼanda momuyoonjila, mukasaangune kwaamba kuteeti, ‘Akube luumuno kubantu boomuno mungʼanda.’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Nakuteeti mwajana siluumuno, kulumelesya kwenu koluumuno kuyoosyaalaawe, nakuteeti taakwe, kulumelesya kwenu koluumuno kuyoomupilukila. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" /><note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 Bakolinto 9:14</ref>; <ref loc="1TI 5:18">1 Timooti 5:18</ref>.</char></note> Mukakale mungʼanda oomo, mukanywe okulya kufumbwa zibayoomupa, kaambo mubelesi weelede kuhola. Mutakalongi-longi kuzwaawa-aawa. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Kufumbwa mutaindi momuyooinka ape bantu bamutambula, mukalye zyemuyooyumbulwa. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Mukaponye balwazi oomo mutaindi, okwaambila bantu bomwateni kuteeti, ‘Bwami bwa Leza bwamusikila.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" /><note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Misebezi 13:51</ref>.</char></note> Kono kufumbwa mutaindi momuyooinka ape bantu taakwe nibamutambula, mukainke mumigwagwa okwaamba kuteeti, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" /><note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Mateyo 10:7-14</ref>; <ref loc="MRK 6:8-11">Maako 6:8-11</ref>; <ref loc="LUK 9:3-5">Luka 9:3-5</ref>.</char></note> ‘Esuko lyetaindi lyenu lyajatilide kumauleesu twalikunkumuna kuteeti cibe citondezyo cokumucenjezya, nekuba namu mutalubi kuteeti Bwami Bwa Leza bwasika.’” <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" /><note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Matalikilo 19:24-28</ref>; <ref loc="MAT 11:24">Mateyo 11:24</ref>; <ref loc="MAT 10:15">10:15</ref>.</char></note> Naakamana Jesu wakateeti, “Ndamwaambila kuteeti mubuzuba bobwaatuzi, Leza uyoomvwida loko mangʼeke kuli Sodoma kwiinda kuli eelyo taindi!”<verse eid="LUK 10:12" /></para>
  <para style="s">Mataindi Aatasyomi</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mateyo 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:13 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 23:1-18">Izaya 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Ezekelo 26:1—28:26</ref>; <ref loc="JOL 3:4-8">Joeli 3:4-8</ref>; <ref loc="AMO 1:9-10">Amosi 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zakalaya 9:2-4</ref>.</char>
    </note> Mpoonyina Jesu wakazumanana kateeti, “Maawe kulinywebo nobantu bomu Kolazini omu Bbetisaida! Kambe maleele akacitwa mumiinzi yenu akacitilwa mu Taila omu Sidoni, nibakeempa ciindi okuzwaata masaka. Nibakanana dota kutondezya kuteeti beempwa kuzibi zyabo. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Nekuba namu, Leza uyoomvwida loko mangʼeke kuli Taila o Sidoni kwiinda nywebo! <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" /><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Izaya 14:13-15</ref>.</char></note> Iino yebo, Kapenaumu! Uyoonyamunywa kutolwa kujulu na? Nee! Uyoosowelwa ansi kucibaka cabafu.”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:40">Mateyo 10:40</ref>; <ref loc="MRK 9:37">Maako 9:37</ref>; <ref loc="LUK 9:48">Luka 9:48</ref>; <ref loc="JHN 13:20">Joni 13:20</ref>.</char>
    </note> Kuzwaawo Jesu wakateeti kuli basikwiiya bakwe, “Ooyo uswiilizya ndinywe waswiilizya ndime, ooyo umukaka, wakaka ndime ape kufumbwa ukaka ndime, wakaka wakandituma.”<verse eid="LUK 10:16" /></para>
  <para style="s">Kupiluka kwa Basikwiiya Bali Makumi aali Ciloba Abobile</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Nibakapiluka basikwiiya bali makumi aali ciloba abobile baliboteledwe loko, okuteeti, “Mwami, amadimona alatumvwida twaalailila kuteeti azwe muzina lyako.”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Jesu wakabataba kuteeti, “Iiyi, ndakabona Satani kazundwa okuwa mbuli lulabo kuzwa kujulu. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" /><note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 91:13">Intembauzyo 91:13</ref>.</char></note> Amuswiilizye! Ndamupa nguzu kuteeti mukonzye kulyata nzoka o tubanze okuzunda nguzu zyoonse zyasinkondo, ape taakwe citikamucise nywebo. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Kono mutabotelwi kaambo kokuteeti myuuya mibi ilamumvwida, kono mubotelwe kaambo kokuteeti mazina eenu alilembedwe kujulu<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false">Kujulu mubbuku lyo buumi, Leza wakalemba mazina abantu boonse bayootambula buumi butamani. Eeli bbuku lyakaambwa omu Ntembauzyo 69:28, Bafilipi 4:3, Bahebbulayo 12:23, Ciyubunuzyo 3:5, 13:8, 17:8, 20:12, 20:15, 21:27. </char></note>.”<verse eid="LUK 10:20" /></para>
  <para style="s">Jesu Wabotelwa</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mateyo 11:25-27</ref>; <ref loc="MAT 13:16">13:16</ref>, <ref loc="MAT 13:17">17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Aciindi eeco Muuya Uusalala wakabotezya Jesu, mpoonyina Jesu wakateeti, “Tata, Mwami wejulu enyika! Ndakulumba kaambo watondezya batayiide zyowakasisila bayiide abasongo. Iiyi Tata eeci wakacicita kaambo mbuwakayanda kuteeti cibe namu.” <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />Mpoonyina Jesu wakateeti kubantu, “Tata wakandipa zintu zyoonse. Taakwe uumuzi Mwana kuteeti ngwani aati feela Isi, ape taakwe uumuzi Isi kuteeti ngwani aati feela Mwana aabo Mwana mbakasala kuteeti abayubunwide nguwe.” <verse eid="LUK 10:22" /><verse number="23" style="v" sid="LUK 10:23" />Mpoonyina Jesu wakacebukila basikwiiya bakwe okubaambila kumbali kuteeti, “Mulilelekedwe kubona zintu eezi zyomubona! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Ndamwaambila kuteeti basinsimi banji abami balikuyandisisya kuzibona ezi zintu zyomubona kono bakakacilwa ape balikuyandisisya kumvwa zintu zyomumvwa, kono bakakacilwa.”<verse eid="LUK 10:24" /></para>
  <para style="s">Mukozyanyo womuna Samaliya Mubotu</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:35-40">Mateyo 22:35-40</ref>; <ref loc="MRK 12:28-34">Maako 12:28-34</ref>.</char>
    </note> Imwi nako mwiiyi wo Mulawo wakeza kuli Jesu okusola kumuca kateeti, “Omwiiyi mubotu, ino ndeelede kucita nzi kuteegwa nditambule buumi butamani?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Jesu wakamutaba kuteeti, “Ino Malembo aamba kuteeti nzi? Ino waapandulula buti?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:27 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:5">Detilonomo 6:5</ref>; <ref loc="LEV 19:18">Levitiko 19:18</ref>.</char>
    </note> Mpoonyina mwaalumi wakateeti, “‘Yanda Mwami Leza wako omoyo wako woonse, omuuya wako woonse, enguzu zyako zyoonse, emizeezo yako yoonse’ ape yanda muntunyoko mboonyina mboliyanda.”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:28 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 18:5">Levitiko 18:5</ref>.</char>
    </note>Jesu wakamutaba kuteeti, “Waamba kabotu. Cita mboonyina namu, uyooboo buumi.”<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Kono mwiiyi wo Mulawo mukuyanda kulisalazya, wakabuzya Jesu kuteeti, “Ino ngwani muntuma ngondeelede kuyanda?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Mpoonyina Jesu wakataba kuteeti, “Imwi nako kwali umwi mwaalumi wali mumusinzo kuzwa ku Jelusalemu kaya ku Jeliko. Munzila bafumpi bakamulwana, kumutubula, okumuuma okumusiya kayuminide. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Kuzwaawo, kwakeza mupaizi umwi kayoobweenda munzila njoonyeeyo, kono naakabona mwaalumi ooyu, wakamuleya. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Awe mu Levi naakasika acibaka eeco wakamubona mpoonyina wakamuleya. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" /><note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2 Makani 28:15</ref>.</char></note> Kono mu Samaliya walimumusinzo wakasika aali mwaalumi ooyu. Naakamubona wakamufwida mangʼeke. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Mpoonyina wakamwiinkila okutila waini azilonda zyakwe okumunanika mafuta mpoonyina okumuzambaila zisila. Amane wamutansika ambongolo yakwe okumutola kungʼanda yabeenzu, ooko kwaakakumubabalela. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Buzuba bwakacilila mu Samaliya wakapa mwini ngʼanda yabeenzu mali omuwaya-waya we nsiliva obile okumwaambila kuteeti, ‘Umubabalele kabotu, nakuteeti ubelesye ainda aawa, ndaakupiluka ndizookubbadela.’”<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Mpoonyina Jesu wakamaninizya kateeti, “Ino mumuzeezo wako, ngwani aalaaba bamaalumi botatwe wakaba muntunyina mubotu kulooyu mwaalumi wakalwanwa abafumpi?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Mwiiyi wo Mulawo wakataba kuteeti, “Ngooyo wakamufwida mangʼeke.”</para>
  <para style="p" vid="LUK 10:37">Mpoonyina Jesu wakamutaba kuteeti, “Mbombubo, iino koya ukacite mboonyina namu.”<verse eid="LUK 10:37" /></para>
  <para style="s">Jesu Wapotela Maliya o Maata</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 11:1">Joni 11:1</ref>.</char>
    </note> Jesu abasikwiiya bakwe nibali mumusinzo, wakasika amuunzi alikukala mwanakazi wezina lya Maata, wakamutambula mungʼanda yakwe. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Maata wajesi muzyalwanyina wezina lya Maliya, wakakede ansi kumbali o Jesu kaswiilizya zyaalikwiisya Jesu. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Maata wakabijilwa kaambo kemisebezi yakamuvulila njalikweelede kucita, mpoonyina wakeza kuli Jesu okwaamba kuteeti, “Mwami tobwene kuteeti muzyalwama wandilekelezya misebezi na? Mwaambile aze andigwasye.”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Mpoonyina Jesu wakateeti, “Maata, Maata! Ulakatazigwa ape ulabilaila ezintu zinji. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Kono kuyandika feela cintu coomwi. Maliya wasala cilikabotu, ape takooyoonyangwa.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Jesu Waiisya Kukomba</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mateyo 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Bumwi buzuba Jesu wali kukomba mucibaka cimwi. Naakamana, umwi sikwiiya wakwe wakateeti kulinguwe, “Mwami, twiisye kukomba mboonyina mbuli Joni mbwakaiisya basikwiiya bakwe.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Mpoonyina Jesu wakabaambila kuteeti, “Mwanookomba kamwaamba namu,</para>
  <para style="q1" vid="LUK 11:2">‘Tateesu,</para>
  <para style="q2" vid="LUK 11:2">alilemekwe zina lyako.</para>
  <para style="q2" vid="LUK 11:2">Abuze Bwami bwako,’”<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />“Utupe cilyo<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">“Cilyo” muci Giliki caamba, “cinkwa”. Cinkwa cicali cilyo cipati loko kuma Juda bomuciindi ca Jesu mboonyina mbuli nsima kulindiswe. Muleeci cibalo ibbala “cinkwa” lyaamba “cilyo”.</char></note> cesu cobuzuba-obuzuba.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Utujatile zibi zyesu,</para>
  <para style="q2" vid="LUK 11:4">kaambo aswebo tulabajatila boonse batubisizya.</para>
  <para style="q1" vid="LUK 11:4">Ape utatutoli mumasunko.”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Mpoonyina ape Jesu wakabaambila kuteeti, “Atwaambe kuteeti, umwi wenu wainka kungʼanda yo mweenzinyina akataamasiku okwaamba kuteeti, ‘Mweenzuma, ndipe kwateni zinkwa zyotatwe, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />kaambo ndatambula umwi mweenzuma ulimulweendo weza kungʼanda yangu, kono tandikwe cokumupa kuteegwa alye.’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Mpoonyina atwaambe kuteeti ooyo uli mungʼanda wataba kuteeti, ‘Utandikatazyi! Twajala kale mulyango ape swebo abana twalala. Tandikonzyi kubuka kuzokupa zyoyanda.’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ino inga cacitika namu na? Ndimwaambila kuteeti, naanga katakonzyi kubuka okukupa cinkwa kaambo mweenzinyoko, inga wabuka okukupa zyoonse zyoyanda kaambo tayandi kubija zina. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Mpoonyina ndimwaambila kuteeti amukumbile mulapegwa, amuyandoole mulajana, amukonkomone muyoojulilwa mulyango. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Nconzyo boonse bakumbila balatambula, aabo bayandoola balajana, mulyango ulajulwa kuli woonse ooyo ukonkomona. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Ino kuli isi akati kenu unga mwana wakwe amukumbila nswi umupa nzoka na? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Naanga akumbila ji umupa kabanze? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Na kuteeti nywebo nobasizibi kamuzi kupa zintu zibotu kubana benu, ino Uso uuli kujulu inga wakacilwa buti kupa Muuya Uusalala kulaabo bamukumbila?”<verse eid="LUK 11:13" /></para>
  <para style="s">Jesu o Bbelizabbuli Mwami Wamadimona</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mateyo 12:22-30</ref>; <ref loc="MRK 3:20-27">Maako 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Bumwi buzuba Jesu walikutanda dimona lyalikupa umwi mwaalumi kutaamboola. Nilyakazwa, mwaalumi ooyu wakatalika kwaamboola. Mpoonyina mabunga aabantu akakomokwa, <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" /><note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mateyo 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note> kono bamwi bantu bakateeti, “Ngu Bbelizabbuli mwami wamadimona nguumupa nguzu zyokwaatanda.”<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mateyo 12:38</ref>; <ref loc="MAT 16:1">16:1</ref>; <ref loc="MRK 8:11">Maako 8:11</ref>. </char>
    </note>Bamwi balikuyanda kuca Jesu mpoonyina bakamukumbila kuteeti acite citondezyo camaleele kuzwa kujulu. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Kono Jesu walizi zyobalikuyeeya, mpoonyina wakateeti kulimbabo, “Kufumbwa cisi caanzeene mutubunga tulwaanisyanya mulicato cilasinyeka ape mukwasyi waanzeene mulicawo ulamwacooka. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Mwaamba kuteeti Bbelizabbuli nguundipa nguzu zyokutanda madimona. Kono na bwami bwa Satani bulootubunga tulwana mulicato, ino bulaima buti njii? <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Iino na muyeeya kuteeti nditanda madimona kubelesya nguzu zya Bbelizabbuli, ano abacilili benu zyobabelesya kwaatanda. Kokuteeti mbabayooba baatuzi benu. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Kono na kuteeti nditanda madimona munguzu zya Leza, kokuteeti Bwami bwa Leza bwamusikila kale.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“Na mwaalumi singuzu kalibambilide ezilwaanyo zyakwe kalindilila ganda lyakwe, zibya zyakwe zyoonse inga zilikwabilidwe kabotu. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Kono na uleenguzu kwiinda mukamwini ganda wamulwana okumuzunda, ulamunyanga zilwaanyo eezyo zyaalikusyoma okuzyaabanya zyabba zyoonse.”<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">Maako 9:40</ref>.</char>
    </note> Mpoonyina Jesu wakamanizya kateeti, “Kufumbwa ooyo utali amebo nguundilwana, ooyo utabunganiki amebo nguumwaya.”<verse eid="LUK 11:23" /></para>
  <para style="s">Kupiluka ko Muuya Mubi</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mateyo 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />Ape Jesu wakateeti, “Na muuya mubi wazwa mumuntu, ulainda mucimpayuma kuyandoola cibaka cokupumwida. Watacijana cibaka eeco, ulalyaamboozya kuteeti, ‘Ndilapilukila kungʼanda yeciindi kundakazwa.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Mpoonyina ulapiluka okujana ngʼanda ilitanyedwe okubambwa kabotu. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Mpoonyinaawo ulainka okweeta myuuya iimbi mibi kwiinda nguwo iili ciloba, ileza okuzookala mwateni. Kuzwaawo buumi booyo uunjidwe bulabija kwiinda kusaanguna.”<verse eid="LUK 11:26" /></para>
  <para style="s">Cileleko Canconzyo</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Jesu naakaamba namu, umwi mwanakazi wakoongolola akati kembunga kateeti, “Ulilelekedwe mwanakazi wakakutumbuka okukunyonsya!”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Kono Jesu wakamutaba kuteeti, “Balelekedwe loko mbaabo bamvwa majwaa Leza okwaacilizya!”<verse eid="LUK 11:28" /></para>
  <para style="s">Bantu Bayanda Kubona Maleele</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mateyo 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">Mateyo 16:4</ref>; <ref loc="MRK 8:12">Maako 8:12</ref>.</char>
    </note> Bantu nibalikuyoobuvula, Jesu wakaindilizya kateeti, “Mbaasizibi balibuti bantu bamazuba aano! Bayanda kuteeti ndibacitile citondezyo camaleele, nee! Tainsi mbonditacite, kunze akubapa citondezyo cilimbuli cakacitikila musinsimi Jona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" /><note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JON 3:4">Jona 3:4</ref>.</char></note> Mboonyina musinsimi Jona mbwaali citondezyo kubantu boku Niniva, awe Mwanoo Muntu uyooba citondezyo kubantu besunu. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" /><note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Bami 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Makani 9:1-12</ref>.</char></note> Mubuzuba bobwaatuzi, mwami wecanakazi woku Shebba uyoopa bumboni bokuteeti bantu besunu baloomulandu kaambo we wakazwa kule loko okuzooswiilizya majwi oobusongo bo Mwami Solomoni. Iino ndimwaambila kuteeti, mpali mupati aano wiinda Solomoni, kono mukaka kumumvwida. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" /><note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JON 3:5">Jona 3:5</ref>.</char></note> Mubuzuba bobwaatuzi bantu boku Niniva bayoopa bumboni bokuteeti ooyu musela uloomulandu kaambo bo bakeempa okusanduka nibakamvwa Jona kakambooka. Iino ndimwaambila nconzyo kuteeti, mpali mupati aano wiinda Jona, kono mukaka kweempa.”<verse eid="LUK 11:32" /></para>
  <para style="s">Lampi Lyomubili</para>
  <para style="r">(<ref loc="MAT 5:15">Mateyo 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mateyo 5:15</ref>; <ref loc="MRK 4:21">Maako 4:21</ref>; <ref loc="LUK 8:16">Luka 8:16</ref>.</char>
    </note> Mpoonyina Jesu wakateeti, “Taakwe muntu umunika lampi okwiisisa naanga kulibika munsi ecisuwo, kono ulibika acikazikilo calyo kuteegwa boonse banjila bamunikilwe. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Meenso aako kekampalamba komubili wako. Nakuteeti meenso aako kaali kabotu, kokuteeti mubili wako woonse unoozwide mumuni. Kono na meenso aako taali kabotu, mubili wako woonse unooli mumudima uusiya mbii! <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Kaambo keeci ucenjele kuteeti mumuni uuli mulindiwe tuuli mudima. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Na mubili wako woonse kuuzwide mumuni, kakutakwe kadima nekaceya, unoomweka mwee mbuli lampi mbolikumunikila omumuni walyo.”<verse eid="LUK 11:36" /></para>
  <para style="s">Jesu Wapa Bafalisi Abamayi bo Mulawo Milandu</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mateyo 23:1-36</ref>; <ref loc="MRK 12:38-40">Maako 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Jesu naakamana kwaamboola, umwi Mufalisi wakamutamba kuteeti akalye kungʼanda yakwe. Mpoonyina Jesu wakanjila mungʼanda okukala kuteeti alye. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Ooyo Mufalisi wakakomokwa naakabona kuteeti Jesu tasambide kumaanza katanalya kaambo eeci ticali kweendelana ecizo cama Juda. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Mpoonyina Mwami wakamwaambila kuteeti, “Iino nywebo no Bafalisi musanzya nkomoki emikeke yenu anze feela, kono mukati kenu muzwide busyacivule-mwaangu obubi. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Nywebo nobafuba-fuba! Ino Leza wakapanga aanze tiinsinguwe wakapangama omukati na? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Kono amupe bapengede kuzwa kunsi emyoyo yenu, mpoonyina ndamwaambila kuteeti zyoonse ziyoomusalalila.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:42 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 27:30">Levitiko 27:30</ref>.</char>
    </note> “Maawe kulinywebo no Bafalisi! Mulapa cekumi cezisyango azyeezyo zivwelanywa muzilyo zyenu kuli Leza, kono mulakacilwa kucita ziluleme okuyanda Leza. Eezi mweelede kuzicita kakutakwe kusulaika zimwi.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“Maawe kulinywebo no Bafalisi! Muyandisya kukala azibbula zibotu loko muzikombelo okulumelesigwa elikute mumisika. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Maawe kulinywebo! Kaambo muli mbuli zyuumbwe zitalibonyi, bantu zyebalyatooka kabatezi kaambo taakwe zitondezyo.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Umwi mwiiyi wo Mulawo wakamutaba kuteeti, “Omwiiyi, waamba namu, aswibo watutuka!”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Mpoonyina Jesu wakataba kuteeti, “Maawe okulinywebo nobamayi bo Mulawo! Mubika mikuli milemu abantu, kono nywebo mulakaka kubagwasya kwiiyumuna nekuceya. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Maawe kulinywebo! Muyakila basinsimi zyuumbwe zibotu, mbeenyaabo basikale benu mbibakajaya. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Nobeni mwatondezya kuteeti mulazizumina zyakacita basikale benu, kaambo bakajaya basinsimi mpoonyina nywebo mwabayakila zyuumbwe. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Kaambo keeci, Leza mubusongo bwakwe wakaamba kuteeti, ‘Ndiyoobatumina basinsimi abaapositola, bamwi baaba bayoobajaya okupenzya bamwi.’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Mpoonyina bantu besunu bayoopegwa mulandu wokujaya basinsimi boonse bakajaigwa kuzwa kumalengelo enyika, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" /><note caller="-" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Matalikilo 4:8</ref>; <ref loc="2CH 24:20-21">2 Makani 24:20-21</ref>.</char></note> kuzwa kukujaigwa kwa Abela kuyoosika kukujaigwa kwa Zakaliya, ooyo wakajailwa akati kecipaililo ecibaka cisalala mu Ngʼanda ya Leza. Nconzyo ndamwaambila, bantu beeino nako bayoopegwa mulandu kaambo kaaba boonse!<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />“Maawe kulinywebo nobamayi bo Mulawo! Mwakasisa nkii yecitendele coluzibo. Nywebo tamunjilide ape mukasyaabo basoleka kunjila mwateni!”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Mpoonyina Jesu naakazwa kucibakeeco, bamayi bo Mulawo a Bafalisi bakatalika kumusumuna okumubuzya mibuzyo azintu zinji, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />bali kusola kumuteya kuteegwa bamuce aamba citalikabotu.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Kucenjezya ankani Yokuupa-upa Amenso</para>
  <para style="r">(<ref loc="MAT 10:26-27">Mateyo 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:6">Mateyo 16:6</ref>; <ref loc="MRK 8:15">Maako 8:15</ref>.</char>
    </note> Nako eeyo bantu bali zyuulu-zyuulu nibakabungana antoomwi cokusyanikizyanya, Jesu wakasaanguna kwaambila basikwiiya bakwe kuteeti, “Amucenjele okumamela emimena ya Bafalisi, ndaamba kuupa-upa amenso kwabo. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" /><note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Maako 4:22</ref>; <ref loc="LUK 8:17">Luka 8:17</ref>.</char></note> Kufumbwa cisisidwe ciyoosisununwa, ape maseseke oonse ayeetwa antangalala. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Mpoonyina kufumbwa comwakaamba mumudima ciyoomvwigwa antangalala, ape kufumbwa cimwakavuya kumbali mukaanda kajalidwe ciyoongololwa atalee ciluli cengʼanda.<verse eid="LUK 12:3" /></para>
  <para style="s">Weelede Kuyoowegwa</para>
  <para style="r">(<ref loc="MAT 10:28-31">Mateyo 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Nobeenzuma, ndimwaambila kuteeti, mutabayoowi aabo bajaya feela mubili, kono bamana taakwe cebakonzya kucita kwiindaawo. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Kono ndilamutondezya weelede kuyoowegwa. Amuyoowe Leza ukonzya kujaya amana ulijesi enguzu zyokusowela mumulilo uutamani. Nconzyo ngonguwe weelede kuyoowegwa!”<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />“Ede, tunteya tosanwe tulauzigwa otumali tobile feela? Kono taakwe naanga kanteya komwi Leza kanga waluba. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Naanga masusu aali mumutwe wenu alibalidwe. Mutanoyoowi kaambo muli bayandisi kwiinda tunteya tunji!”<verse eid="LUK 12:7" /></para>
  <para style="s">Kuzumina Okukaka Jesu</para>
  <para style="r">(<ref loc="MAT 10:32">Mateyo 10:32</ref>, <ref loc="MAT 10:33">33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19">10:19</ref>, <ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Ndamusyomezya kuteeti, boonse aabo baamba antaangalala kuteeti mbibangu, awe Mwanoo Muntu uyoobacitila mboonyina namu kumenso abangelo ba Leza. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Kono boonse aabo bandikaka antangalala, awe Mwanoo Muntu uyoobacitila mboonyina namu kumenso abangelo ba Leza. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Kufumbwa ooyo waamba zibi a Mwanoo Muntu inga wajatilwa, kono kufumbwa usampoola Muuya Uusalala tayoojatilwi.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:19-20">Mateyo 10:19-20</ref>; <ref loc="MRK 13:11">Maako 13:11</ref>; <ref loc="LUK 21:14-15">Luka 21:14-15</ref>.</char>
    </note> “Baakumutola kuyoomuzekesya muzikombelo na kubeendelezi, mutakabilaili ambomutakaliiminine naanga mbomutakatabe. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Muuya Uusalala uyoomwiisya muciindi eeco zyomweelede kuyaamba.”<verse eid="LUK 12:12" /></para>
  <para style="s">Cikozyanyo Comuvubi Mufuba-fuba</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Umwi mwaalumi akati kembunga wakateeti kuli Jesu, “Omwiiyi, mwaambile muzyalwama kuteeti aabane andime lubono ndwaakatusiila tata naakafwa.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Kono Jesu wakamutaba kuteeti, “Mweenzuma, ino ngwani wakandipa nguzu zyokwaatula naanga kumwaabanya lubono lwenu nobile?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Mpoonyina wakazwidaanembo kubaambila boonse kuteeti, “Amumamele okulikwabilila kubusyacivule mwangu bwemisyobo-misyobo, kaambo buumi bwenu tabwiimvwi azintu zyomujesi, naanga muvube buti.”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Mpoonyina Jesu wakabaambila cikozyanyo eeci, “Imwi nako kwaluumwi mwaalumi muvubi wajesi muunda mubotu. Zyoonse zyaakabyalide zyakamupa bukutuzi bubotu. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Naakabona namu, wakatalika kuyeeya mumoyo wakwe kuteeti, ‘Tandijesi mokubikila zilyo zyangu zyoonseezi. Ino ndilacita buti?’ <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Mpoonyina wakateeti, ‘Ndilacita namu, ndilamwacoola matalaangu, okuyaka mapati munditakabike zilyo zyangu ezimwi zintu zyoonse. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Mpoonyina ndiyoolyaambila kuteeti, Yebo osicoolwe! Kwemyaaka minji, zyoonse zintu zyoyanda ulizibambide. Liibe, ulye, unywe okulibotezya.’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Kono Leza wakamwaambila kuteeti, ‘Yebo omufuba-fuba! Sunu masiku ngoonyaaya ulafwa. Mpoonyina ngwani uyoobweza eezi zintu zyoonse zyowakalilundaikila?’”<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Mpoonyina Jesu wakamaninizya kateeti, “Oobu mbociyooba kulaabo balilundikila buvubi lwabo beni kono kabatavubide kumensaa Leza.”<verse eid="LUK 12:21" /></para>
  <para style="s">Kusyoma Leza</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mateyo 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Mpoonyina Jesu wakateeti kuli basikwiiya bakwe, “Kaambo keeci, ndamwaambila kuteeti mutabilaili ezyokulya zyomuyandika kuteeti mupone na zizwaato zyomweelede kuzwaata. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Ede, buumi mbupati loko kwiinda zyokulya, omubili cintu cipati loko kwiinda zizwaato. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Amubone bacikwangala! Tababyali mbuto naanga kukutula naanga kubaamatala ezilyo, kono Leza ulabalisya! Iino nywebo mulayandika kwiinda bayuni! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ape ngwani ukonzya kuyungizizya nokuceya kubuumi bwakwe kwiinda mukubilaila? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Natamukonzyi kucita naanga eeci ciniini, ino niinzi nemubilaila eezi zimwi? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" /><note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Bami 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Makani 9:3-6</ref>.</char></note> Amulange maluba-luba oomusaka mbwaakomena. Taabeleki naanga kulipangila zizwaato. Kono ndamwaambila kuteeti naanga Mwami Solomoni obuvubi bwakwe boonse taalijesi zizwaato zibotu mbuli lyomwi lyamaluba-luba aaya. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Ngu Leza uzwaatika bwizu bomusaka, bwizu bokuteeti sunu kobuli, junza bwatentwa mumulilo. Ino takonzyi kubikila maano kuteeti amuzwaatike na? Nduniini buti lusyomo lwenu!<verse eid="LUK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29" />“Iino nywebo mutabikili maano kuli zyemutilye okunywa. Ape mutanoobilaila ezintu zyomusyobo namu. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Ede benyika eeyi babikila maano azintu eezi zyoonse, kono Uso ulizi kuteeti mulaziyanda. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Kono amubikile maano kuli zyo Bwami bwakwe, mpoonyina uyoomupa zyoonse eezi zyasyaala.”<verse eid="LUK 12:31" /></para>
  <para style="s">Buvubi Bokujulu</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mateyo 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />Kuzwaawo Jesu wakateeti, “Utayoowi, ookatanga kaniini, kaambo Uso uliboteledwe kumutambula mu Bwami bwakwe. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Amuuzye zyoonse zyomujesi, mali mupe bapenzi. Amulipangile zikwama zitamani, ndaamba buvubi bokujulu butaceyi, kaambo ko takusiki mubbi, ape takukwe lumoma lukonzya kubusinya. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Ndaamba namu kaambo myoyo yenu inoolooko kuli buvubi bwenu.”<verse eid="LUK 12:34" /></para>
  <para style="s">Babelesi Balibambilide</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:1-13">Mateyo 25:1-13</ref>.</char>
    </note> Jesu wakazwida anembo kwaambila basikwiiya bakwe kuteeti, “Amuzwaate cokulibambila kubeleka amalampeenu kaayaka. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" /><note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">Maako 13:34-36</ref>.</char></note> Mube mbuli babelesi balindilila simalelaabo wainkide kumukiti womucado, kuteegwa asika feela okukonkomona bamujulile mulyango mpoonya-mpoonya. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Balilelekedwe aabo babelesi simalelaabo mbayoojana kabalanga ape kabalibambilide azoopiluka! Nconzyo ndamwaambila kuteeti, uyootubula jansi lyakwe, okubakazikaansi okubayumbula. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Balilelekedwe aabo bayoojanika kabalibambilide, naanga akeze akati kamasiku na kubucedo! <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" /><note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">Mateyo 24:43-44</ref>.</char></note> Ape iino comweelede kuziba cokuteeti, kambe mwini ngʼanda naalizi nako mubbi neza, inga takonzya kumulekela kuteeti apwaye okunjila mungʼanda. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Mboonyina namu anywebo, mweelede kuba balibambilide kaambo Mwanoo Muntu uyooza aciindi pomutamuyeeyeli.”<verse eid="LUK 12:40" /></para>
  <para style="s">Sikubamba Uusyomeka Outasyomeki</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mateyo 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Mpoonyina Pita wakaamba kuteeti, “O Mwami, ino eeci cikozyanyo waambila feela ndiswe na abantu boonse?” <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Mpoonyina Mwami wakataba kuteeti, “Ino he ngwani sikweendelezya usyomeka ape musongo? Ede ngooyo simalelaakwe ngwatikabike kweendelezya babelesi bamwi okubona kuteeti bapegwa cokulya cabo muciindi ceelede. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Ulilelekedwe ooyo sikweendelezya simalelaakwe ngwatikajane kacita eezi aakupiluka. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Nconzyo, ndamwaambila kuteeti, simalelaakwe uyoomupa nguzu zyokulanga zintu zyakwe zyoonse. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Kono na sikweendelezya ooyo wayeeya kuteeti simalelaakwe utola nako ndamfu kupiluka mpoonyina watalika kuuma babelesi bamaalumi abanakazi, okutalika kulya, kunywa okukolwa, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />mpoonyina simalelaakwe uyoopiluka bumwi buzuba mbwatayeeyeli ape aciindi catezi. Simalelaakwe uyoomutimboola muzipaanzi-paanzi okumusubula aabo batasyomeki.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />“Mubelesi uuzi ciyanda simalelaakwe kono talibambili naanga kucicita, uyoonabbwa loko. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Kono mubelesi utazi ciyanda simalelaakwe, mpoonyina wacita cinga camupa kunabbwa uyoonabbwa aniini. Muntu uupegwa mubunji, kuyoolangilwa kuzwa kulinguwe mubunji. Ape kumuntu uupegwa mubunji loko, kuyooyandikana kuzwa kulinguwe mubunji loko.”<verse eid="LUK 12:48" /></para>
  <para style="s">Makani Oolwaandaano</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mateyo 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Kuzwaawo Jesu wakateeti, “Ndakazida kuzoobbusya mulilo<note caller="+" style="f"><char style="fr" closed="false">12:49 </char><char style="ft" closed="false">Kuli nzila zinji zyokupandulula mulilo mulaaka kampango: (1) Bunji bwabasilwiiyo bayeeya kuteeti mulilo wiiminina bwaatuzi bwa Leza kucibi (mbuli muli Luka 3:16-17). Oobu bwaatuzi bukonzya kutondezya lufu lwa Jesu aciingano naanga bwaatuzi bwabatasyomi buza. (2) Bamwi basilwiiyo bayeeya kuteeti mulilo wiiminina bantu baanzeene naanga mazwanga. (3) Bamwi basilwiiyo bayeeya kuteeti mulilo wiiminina kusalazigwa kwabantu kuli Leza. Mwendi aawa citondezya kuteeti mulilo tawiiminini cintu comwi feela.</char></note> anyika! Ndalikuyeeya kuteeti mane kambe walibbukide kale! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" /><note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">Maako 10:38</ref>.</char></note> Kono ndilolubbabbatizyo lwamapenzi ndondeelede kwiinda mwateni, aano ndilipengede mumoyo kusikila zikainde eezi! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Ino muyeeya kuteeti ndakazida kweeta luumuno munyika na? Nee, ndamwaambila kuteeti ndakazida kweeta lwaandano. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Kuzwaino, mumukwasyi wabosanwe munoli lwaandano, botatwe bayoobukila bobile ape bobile bayoobukila botatwe. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" /><note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mika 7:6</ref>.</char></note> Baisi bayoobukila mwana musyimani, awe mwana musyimani uyoobukila baisi. Banyina bayoobukila mwana musimbi, awe mwana musimbi uyoobukila banyina. Banyinazyala bayoobukila musangakazi, awe musangakazi uyoobukila banyinazyala.”<verse eid="LUK 12:53" /></para>
  <para style="s">Kuziba Zitondezyo zye Ziindi</para>
  <para style="r">(<ref loc="MAT 16:2-3">Mateyo 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Mpoonyina Jesu wakaambila embunga yabantu kuteeti “Namwabona joba lisiya lizwa kumbo mpoonya-mpoonya mwaamba kuteeti, ‘Mvula ilawa,’ okuwa yawa<note caller="+" style="f"><char style="fr" closed="false">12:54 </char><char style="ft" closed="false">Munyika ya Izilaili, imvula izwidaanga kumbo kubbazu lyo lwizi lwa Meditaleniyani.</char></note>. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Ape mwabona guwo lizwa kumusanza lyanounga mwaamba kuteeti, ‘Kwandoopya,’ okupya kwapya<note caller="+" style="f"><char style="fr" closed="false">12:55 </char><char style="ft" closed="false">Kumusanza wecisi ca Izilaili kuli cibaka cipati cenkanda, mpoonyina luuwo lwanozwida kumusanza kutalika kupya. </char></note>.” <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Nywebo nomuupa-upa amenso! Mwalanga nyika ejulu mulaziba mbokutabe. Ino mukacilwa buti kuziba iino nako ceyaamba?<verse eid="LUK 12:56" /></para>
  <para style="s">Kupiluka kuli Leza Netucili Eciindi</para>
  <para style="r">(<ref loc="MAT 5:25-26">Mateyo 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“Kaambo nzi nomutaatuli nobeni kuteegwa muzibe ciluleme? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Naa simulandunyoko wakutola kunkuta, amwaamboozyanye nimuciyoobweenda anguwe munzila kuteegwa mumvwane kamutana kusika kunkuta. Nakuteeti tocitide namu uyookusungilizya kwiinka kumuzekesyi, mpoonyina muzekesyi uyookubika mumaanza aabalindizi bentolongo, bayookubika muntolongo. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Nconzyo ndikwaambila kuteeti toyoozwi mwateni kusikila mane ukabbadele kali komuwaya-waya kamamanino.”<note caller="+" style="f"><char style="fr" closed="false">12:59 </char><char style="ft" closed="false">Jesu wakaambila bantu eci cikozyanyo kubacenjezya kuteeti beelede kumvwana o Leza kaitana sika nako yobwaatuzi.</char></note><verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Amweempe Kuteegwa Mutafwi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Aleeyo nako kwali bamwi bantu bakaambila Jesu zyabana Galileya aabo mweendelezi Pilato mbaakajaya nibalikupa zituuzyo kuli Leza. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Jesu wakabataba kuteeti, “Kokuteeti muyeeya aanga aabo bana Galileya bakajaigwa kaambo bali basizibi kwiindaabo boonse bamwi bomu Galileya na? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Nee, tainsi mbombubo! Kono mwateempwa anywebo mulafwa noonse mbuli mbabo. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Ino baya bali kumi olusele bakajaigwa niyakawa ngalani yamabwe ku Silome, mubonaanga balibabi loko kwiinda bamwi boonse balikukala mu Jelusalemu na?” <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Nee, tainsi mbombubo! Kono mwateempwa anywebo mulafwa noonse mbuli mbabo.<verse eid="LUK 13:5" /></para>
  <para style="s">Cikozyanyo Comukuyu Utazyali Micelo</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Mpoonyina Jesu wakabaambila cikozyanyo eeci: “Kwali umwi muntu wajesi muunda mwali cisamu co mukuyu. Naalikuyanda kucela nkuyu wakajana tacizyede. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Wakaambila mubelesi womumuunda wakwe kuteeti, ‘Bona, kwe myaka yotatwe kendiza kuzoolanga nkuyu kuleeci cisamu kanditajani. Citeme ciwe! Cisinya feela cibaka mumuunda.’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Kono mubelesi wakamutaba kuteeti, ‘Simalelaangu, cileke ko mwaaka omwi pili ndiciliminine okucibikila mbolezi. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Nakuteeti cizoozyale mwaaka uza, cilikabotu. Kono nakuteeti citazoozyali, uzoociteme.’”<verse eid="LUK 13:9" /></para>
  <para style="s">Jesu Waponya Mwanakazi Mulema mu Nsabata</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Bumwi buzuba bwe Nsabata Jesu naalikwiisya mucikombelo, <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />kwali mwanakazi walikujesi muuya mubi walikumucisya kwemyaaka iili kumi o lusele. Waloongomene cokuteeti taalikukonzya kwiinamuka naanga aniini. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Jesu naakamubona wakamwiita okuteeti, “Mwanakazi, waangununwa kubulwazi bwako!” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Mpoonyina Jesu wakabika maanzaakwe alinguwe, mpoonyinaawo mwanakazi wakainamuka okulumbaizya Leza. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />Kono wolupati-pati wecikombelo wakanyema kaambo Jesu wakaponya muntu mubuzuba bwe Nsabata. Mpoonyina wakaambila bantu kuteeti, “Kuli mazuba aali cisambomwe ngotweelede kubeleka, kamuzaanga kuzoponesegwa mumazuba aayo, mutanozaanga mu Nsabata!” <verse eid="LUK 13:14" /><verse number="15" style="v" sid="LUK 13:15" />Mpoonyina Mwami wakamutaba kuteeti, “Nywebo nobasikupa-upa amenso! Ino noonse aawa tamwaangununaanga basune benu naanga mbongolo okuzitola kuyoonywa maanzi mu Nsabata na? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Iino ooyu mwanakazi wakazyalwa kulunyungu lwa Abbulahamu walikwaangidwe o satani kwe myaka iili kumi olusele, teelede kwaangununwa mu Nsabata na?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Jesu naakataba namu, boonse balikumulwana bakalisenda loko, kono mbunga yabantu yoonse yakabotelwa loko kuzintu zyobulemu zyoonse zyaakacita.<verse eid="LUK 13:17" /></para>
  <para style="s">Cikozyanyo Cakaseke ka Masitadi</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Mpoonyina Jesu wakabuzya kuteeti, “Ino Bwami bwa Leza buli mbuli nzi? Ino ndilabukozyanisyeenzi? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Buli mbuli cicitika muntu abyala kaseke ke masitadi mumuunda. Mpoonyina kalakomena okuba cisamu, kuzwaawo bayuni bapangila mwateni ziteente mumitabi yaco.”<verse eid="LUK 13:19" /></para>
  <para style="s">Cikozyanyo Comumena</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Ape Jesu wakateeti, “Ino ndilabukozyanisyeenzi Bwami bwa Leza? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Buli mbuli mumena wakabelesegwa omwanakazi mukupanga cinkwa. Nekuteegwa wakabika feela tumena tuniini muzisuwo zyotatwe zyobusu bwamaila, bwakafunduluka boonse.”<verse eid="LUK 13:21" /></para>
  <para style="s">Njila Mumulyango Uusyanikide</para>
  <para style="r">(<ref loc="MAT 7:13-14">Mateyo 7:13-14</ref>, <ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Jesu naalikuyoobuya ku Jelusalemu wakainda mumataindi omumiinzi kayoobwiisya bantu. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Muntu umwi wakamubuzya kuteeti, “Mwami, kokuteeti mbantu baniini feela batazoofutulwe na?”</para>
  <para style="p" vid="LUK 13:23">Mpoonyina Jesu wakabaambila kuteeti, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Bwami bwa Leza buli mbuli ngʼanda yomulyango usyanikide. Amusole cenguzu kwiinda amulyango ooyu, kaambo nconzyo mbanji bayoosola kwiinda fateni kono bayookacilwa. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Mwini ngʼanda azoujala mulyango, muzoima anze kamukonkomona okukombelezya kuteeti, ‘Mwami tujulile!’ Kono uzoomutaba kuteeti, ‘Tandizi komuzwida!’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Mpoonyina muzoomutaba kuteeti, ‘Kono twakalya okunywa andiwe, ape walikwiisya mutaindi lyesu,’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" /><note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Intembauzyo 6:8</ref>.</char></note>kono ape uyootaba kuteeti, ‘Tandizi komuzwa, amuzwe kulindime, nywebo noonse nobasimucita zibi!’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" /><note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mateyo 22:13</ref>; <ref loc="MAT 25:30">25:30</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">Mateyo 8:11-12</ref>.</char></note> Kuzooba kulila okuluma ntwino mukuusa mwazoobona Abbulahamu, Isaka o Jakobo, abasinsimi boonse mu Bwami bwa Leza, kono nywebo munosowedwe anze! <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Bantu bayooza kuzwa kujwe okumbo, bamwi bayooza kuzwa kunyika okumusanza mpoonyina bayookala okulya mumukiti mu Bwami bwa Leza. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" /><note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mateyo 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">Maako 10:31</ref>.</char></note>Iino nconzyo, aabo bali musule<note caller="+" style="f"><char style="fr" closed="false">13:30 </char><char style="ft" closed="false">Leza uzoobona bubotu mubantu banji bamwi mbebaamba kuteeti tabakwe bubotu. Eeci cibalo citondezya Leza mbwabona bubotu omuli Bamasi aabo ma Juda mbibalikubonaanga tabakwe loko bubotu kwiinda mbabo. Ape cilakonzya kubalilizya bantu kufumbwa bamwi mbobatapi bulemu naanga kubabona kuteeti baleentuso. Ape abantu banji balemekwa ano anyika bayoobula bulemu mu Bwami bwa Leza. Leza tayoobapi zibbula zipati nekuteegwa bantu balikubabona kuteeti mbabalemekwa loko munyika.</char></note> bayoojanika kunembo, ape aabo balikunembo bayoojanika musule.”<verse eid="LUK 13:30" /></para>
  <para style="s">Jesu Walila Jelusalemu</para>
  <para style="r">(<ref loc="MAT 23:37-39">Mateyo 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Muciindi coonyeeco bamwi Bafalisi bakeza kuli Jesu okumwaambila kuteeti, “Uzwe kuno kaambo Helodi uyanda kukujaya.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Mpoonyina Jesu wakabataba kuteeti, “Kamuya mukamwaambile mwaaba ulya kuteeti, ‘Bona! Sunu ejuunza ndinootanda madimona okuponya bantu, mpoonyina buzuba bwatatu nenditizomanisye musebezi wangu.’ <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Nekuba namu, sunu, junza, ejunzalimwi ndeelede kwiindilizya omusinzo wangu, kaambo nconzyo Jelusalemu cecibaka basinsimi kobajailwa.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“Yebo Jelusalemu, Jelusalemu! Ujaya basinsimi okupotoola mabwe batumwa mbaakakutumina Leza! Ziindi zinji kandiyanda kubungaanya bantu bako antoomwi mbuli nkuku mbwiifukatila twana twayo mumababa, kono taakwe niwakandizumizya! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" /><note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Intembauzyo 118:26</ref>.</char></note> Mpoonyineeno bona Ngʼanda yako lyaba tongo. Ape toyoondiboni kaitana sika nako noyaamba kuteeti, ‘Ulilelekedwe ooyo uza muzina lyo Mwami.’”<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Jesu Waponya mu Nsabata</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Bumwi buzuba bwe Nsabata Jesu naakainka kuyoolya kungʼanda youmwi mweendelezi wa Bafalisi, boonse bantu ooko bakamulangisisya. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Mpoonya-mpoonya umwi mwaalumi walikuciswa bulwazi bokuzimba maulu amaanza wakeza kuli Jesu. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Mpoonyina Jesu wakabuzya bamayi bo Mulawo a Bafalisi kuteeti, “Ino Mulawo wesu ulazumizya na tuuzumizyi kuponya muntu mu Nsabata?”<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />Kono taakwe nibakamutaba naanga comwi. Mpoonyina Jesu wakajata mwaalumi ooyo okumuponya. Amane, wakamuleka wainka. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" /><note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">Mateyo 12:11</ref>.</char></note> Mpoonyina Jesu wakaambila bamayi bo Mulawo a Bafalisi kuteeti, “Ino kuteeti umwi wenu kajesi mwana na mupulu wawida mudindi mubuzuba bwe Nsabata, takoomugwisya mpoonya-mpoonya na?”<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />Kono bakuukacilwa kuutaba ooyu mubuzyo.<verse eid="LUK 14:6" /></para>
  <para style="s">Kulicesya Okulisumpula</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Mpoonyina Jesu naakabona beenzu bakatambidwe ku mukiti kabasala zibbula zibotu zyobulemu, wakabaambila cikozyanyo eeci, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" /><note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">Tusimpi 25:6-7</ref>.</char></note> “Nakuteeti watambwa ku mukiti womucado, utazuzili kukala acibbula cobulemu, kaambo cimwi ciindi kuli watambwa ukutekwa kwiinda yebo. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Mpoonyina wamutamba noonse ulakwaambila kuteeti, ‘Cija acibbula eeci kukale ooyu.’ Mpoonyina uyoolisenda loko waakukala acibbula ciniini cili munsi loko. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Kono watambwa kala acibbula ciniini loko kuteegwa uulya wamutamba aze azookwaambila kuteeti ‘Nyamuka mweenzuma, tanta uzookale mucibbula cibotu kwiinda eeco.’ Mukucita namu, uyoopegwa bulemu akati kabantu batambwa boonse, <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" /><note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mateyo 23:12</ref>; <ref loc="LUK 18:14">Luka 18:14</ref>.</char></note>Ndamupa cikozyano eeci kumwiisya kuteeti boonse balisumpula bayootolwa ansi ape aabo balitola ansi bayoosumpulwa.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Mpoonyina Jesu wakateeti kuli wakamutamba, “Wabamba cisusulo na cilalilo, utatambi beenzinyoko na bazyalwanyoko na bomukowaako na bavubide mbokala aabo afwiifwi kaambo abo bayokutamba, muleeyi nzila unooliwapilusisigwa kale kuli cowacita. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Kono wapanga mukiti, tamba bapenzi, zihole aboofu. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Mpoonyina uyoolelekwa kaambo tabakonzya kukupilusizya. Leza uyookupilusizya mubuzuba bantu baluleme baakubuka kuzwa kubafu.”<verse eid="LUK 14:14" /></para>
  <para style="s">Cikozyanyo Comukiti Mupati</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mateyo 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Naakamana kwaamboola Jesu, umwi waabo balikulya atafule wakamwaambila kuteeti, “Ulilelekedwe ooyo uuyoolya mumukiti womu Bwami bwa Leza!”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Jesu wakateeti kulinguwe, “Imwi nako, kwali muntu wakakanza kupanga mukiti mupati okutamba bantu banji. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Niyakasika nako, wakatuma mubelesi wakwe kuyoitaabo bakatambidwe, ‘Amuze-amuze, zyoonse zyabambwa kale!’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Kono boonse bakatambidwe bakatalika kulitamizya. Wokusaanguna wakateeti kumubelesi, ‘Amundijatile kaambo ndakazwaakuula muunda mpoonyina ndeelede kuyoubona.’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Umwi wakateeti, ‘Amundijatile kaambo ndakazwaakuula zipani zyosanwe zyamapulu. Ndiyanda kuyoozisola kulimya.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Oumwi wakateeti, ‘Tandikookonzya kuza kaambo ndakazwaakukwata.’ <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Mubelesi wakapiluka okuyaambila simalelaakwe zyoonse zibakaamba basikutambwa. Simalelaakwe wakanyema loko mpoonyina wakaambila mubelesi wakwe kuteeti, ‘Fwambaana koya mumigwagwa o mutuzila tomutaindi ukeete bapenzi, zihole, aboofu.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Naakapiluka mubelesi wakateeti, ‘Simalelaangu, ndacita mboonyina mbumwandilailide, kono cibaka kocicili.’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Mpoonyina simalelaakwe wakateeti, ‘Koya munzila ziindilila omutuzila twiinda mumyuunda ukabakombelezye boonse kuteeti baze kuteegwa ngʼanda yangu izule. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ndimwaambila kuteeti taakwe naanga omwi waabo bakatambidwe kusaanguna uyooulabila mukiti wangu!’”<verse eid="LUK 14:24" /></para>
  <para style="s">Makatazyo Ookucilila Jesu</para>
  <para style="r">(<ref loc="MAT 10:37-38">Mateyo 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Iino Jesu naalikuyoobweenda amabunga aabantu, wakacebuka okuteeti kulibo, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" /><note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">Mateyo 10:37</ref>.</char></note> “Aabo bayanda kundicilila tabakonzyi kuba basikwiiya bangu, aati kuteeti bandiyanda kwiinda mbobayanda baisi abanyina, banakazi babo abana, bazyalwanyina abamacizi, okwiinda mbobaliyanda. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" /><note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mateyo 10:38</ref>; <ref loc="MAT 16:24">16:24</ref>; <ref loc="MRK 8:34">Maako 8:34</ref>; <ref loc="LUK 9:23">Luka 9:23</ref>.</char></note> Taakwe ukonzya kuba sikwiiya wangu aati wanyamuna ciingano cakwe okundicilila. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />Ino kuteeti umwi wenu wayeeya kuyaka ngʼanda ndamfu, takookalaansi okubalila ziyandika kubona kuteeti na mali ngajesi alakwana kwiiyaka yoonse?<figure style="fig" alt="Stone Tower" file="tower.JPG" size="col" loc="p" ref="14:28">Ngʼanda ndamfu</figure> <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Buyo-buyo inga wayaka feela ntalisyo okukacilwa kwiimana ngʼanda yoonse, mpoonyina boonse bayaabona mayakaakwe bayoomuseka. <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />Banooteeti, ‘Ooyu mwaalumi wakaatalika mayake kono wakaakacilwa kwaamaninizya.’ <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />Naanga mwami nzi unga wainka kunkondo abasilumamba bali zyuulu zili kumi kuyoolwana o mwami ujesi basilumamba bali zyuulu zili makumi obile? Ede uyoosaanguna kukala ansi okubona na uyookonzya kuzunda mwaminyina. <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Kono na wayeeya kuteeti takonzyi kumuzunda, uyootuma baiminizi bakwe kuteeti bakaswaane mwami ooyo kuyookumbila luumuno nacili kule.” <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Mukumaninizya Jesu wakateeti, munzila iswana, “Taakwe naanga omwi akati kenu ukonzya kuba sikwiiya wangu aati wafutatila okusiya zyoonse zyajesi.<verse eid="LUK 14:33" /></para>
  <para style="s">Sautu Lisampukide</para>
  <para style="r">(<ref loc="MAT 5:13">Mateyo 5:13</ref>; <ref loc="MRK 9:50">Maako 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Sautu ndibbotu, kono kuteeti lyasampuka, taakwe mbolikonzya kupilusigwa kuteeti linone ape. <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Talikwe bubotu kumuse na kumbolezi. Elyo sautu lilinamu ndyakusowa feela. Ulaamatwi ookumvwisya, amvwe!”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Imbelele Yakasweekede</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mateyo 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:29-30">Luka 5:29-30</ref>.</char>
    </note> Bumwi buzuba basimutelo banji abasizibi bamwi bakabunganina Jesu kuteegwa bazooswiilizye kwiisya kwakwe. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Bafalisi abamayi bo Mulawo bakatalika kutongooka kabateeti, “Ooyu muntu utambula basizibi okulyaabo!” <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />Mpoonyina Jesu wakabapa cikozyanyo eeci, <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Na umwi muntu kajesi mbelele zili mwaanda mpoonyina yomwi yasweeka, ino inga wacita nzi? Ede inga wasiya zili makumi aalifuka efuka musaka okwiinka kuyooyandoola eeyo yomwi isweekede mane kusikila akiijane. <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Aijana ulabotelwa loko, okwiisempula. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Mpoonyina aitola kungʼanda, uyooita beenzinyina antoomwi ambabambenaabo okubaambila kuteeti, ‘Atusekelele antoomwi, kaambo ndaijana mbelele yangu yasweekede.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Ndimwaambila kuteeti, mboonyina namu okujulu kulaba kusekelela loko kaambo kasizibi omwi wasanduka kwiinda baluleme bali makumi aalifuka efuka batayandiki kusanduka.<verse eid="LUK 15:7" /></para>
  <para style="s">Kadi Kakasweekede</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“Naape mwanakazi ujesi mali omuwayawaya wensiliva aali kumi wasweekelwa komwi kadii kangawo, ino inga wacita buti? Ede ulamunika lampi, okutanyela mungʼanda yakwe, okuyandoola konse-konse kusikila mane akajane. <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Akajana, uyooita beenzinyina antoomwi ambabambenaabo okubaambila kuteeti, ‘Atusekelele antoomwi, kaambo ndakajana kadi kangu kasweekede!’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Ndimwaambila kuteeti, mboonyina namu, Leza ulasekelela akati kabangelo bakwe kuteeti na sizibi womwi wasanduka.”<verse eid="LUK 15:10" /></para>
  <para style="s">Cikozyano ca Isi Uulekelela</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Kuzwaawo Jesu wakazwida anembo kateeti, “Kwali mwaalumi wajesi bana basyimani bobile. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Mpoonyina muniini wakateeti kuliisi, ‘Tata, ndipe caabilo cangu colubono.’ Mpoonyina mwaalumi ooyu wakaabanya lubono lwakwe akati kabana bakwe bobile. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Nikwakainda feela mazuba maniini, ooyu muniini wakauzya lubono ndwaakapedwe okubweza mali oonse amane waya kunyika iili kule kwaakaakutatoola mali mukucita zyobufuba-fuba. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Wakalumana lubono ndwaajesi, kuzwaawo mucisi oomo mwakanjila nzala ilunda kasuko, mpoonyina wakatalika kupenga. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Kuzwaawo wakatalika kubeleka kuluumwi muntu womucisoomo, wakamutuma mumyuunda yakwe kuyoosanina ngulube<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="ft" closed="false">Mulawo wama Juda walikwaamba kuteeti ngulube zinyama zisofweede. Kweendelana omulawo ooyu, ma Juda tibalikweelede kulya nyama yengulube. Balevi 11:7. Mpoonyina ma Juda balikubisyaanya ngulube abantu balikuzilela.</char></note>. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Musyimani ooyu walikufwa nzala cokuteeti walikunyomenena kulya zyokulya zye ngulube kono taakwe walikumupa cili coonse. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Kono kumamanino naakaliyeeya wakateeti, ‘Boonse babelesi ba tata balalya mbobayandila, iino mebo kuno ndaandoofwa enzala! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ndilapiluka kuli tata okuyoomwaambila kuteeti, “Tata, ndakabisya kuli Leza okuli yebo. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Tandiceelede kwiitwa kuteeti mwana wako, ndibweze feela mbuli umwi wababelesi bako.”’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Mpoonyina wakanyamuka okupiluka kuliisi. Kono kacili kule omuunzi, isi wakabona mwana wakwe. Moyo wakwe wakazula mangʼeke, mpoonyina wakamuzuzila, okuyoomukumbata okumumyoonta.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />“Mpoonyina we wakateeti, ‘Tata, ndakabisya kuli Leza okuli yebo. Tandiceelede kwiitwa kuteeti mwana wako.’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Kono bo baisi bakaita babelesi babo, kabateeti, ‘Amufwambaane! Amweete jansi liinda kubota, mumuzwaatike. Mumubike nwenwe kumunwe, mwamana mumuzwatike ezikatulu. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Mpoonyina mweete munamani uneneede<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">Mikwasyi yeci Juda yakali kujesi mali manji yakali kusanina munamani cokulya cinji kuteegwa aneneye. Mikwasyi eeyi yayanda kuba omukiti, yakali kulibambila kujaya okulya munamani ooyu.</char></note>, mujaye kuteegwa tupange mukiti tusekelele, <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />kaambo ooyu mwaanangu musyimani walifwide kono iino wabuka, waliswekede, kono iino wajanwa.’ Mpoonyina mukiti wakatalika.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“Aleeyo nako mwana wakwe mupati taaliwo, walikumuunda. Iino naalikuyoobupiluka, naakaswenaafwiifwi omuunzi wakamvwa kwiimba okuzyana. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Kumane wakaita umwi wababelesi okumubuzya kuteeti, ‘Ino niinzi cicitika?’ <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Mubelesi wakateeti, ‘Mweencaako wapiluka mpoonyina bauso bajaya munamani uneneede, kaambo bamutambula kali muumi ape kalikabotu.’ <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />Kono mupati wakanyema loko mane wakakaka okunjila mungʼanda. Mpoonyina isi wakazwaanze okumukombelezya kuteeti anjile. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Kono wakataba isi kuteeti, ‘Kolanga, myaaka yoonse eeyi ndakubelekela mbuli muzike, ape lyoonse ndalikucilila malailile aako. Ino wakandipedeenzi? Taakwe naanga mpongo feela kuteeti ndisekelele abeenzuma! <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Kono ooyu mwana wako, wakatatoola lubono lwako kumahuule, we ucisika feela wamujaila munamani uneneede!’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Isi wakataba kuteeti, ‘Mwanaangu, yebo ukalaandime lyoonse, ape zyendijesi zyoonse zizyako. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Kono twacita kabotu kusekelela kaambo ooyu mweencaako walifwide, iino wabuka, walisweekede, iino wajanwa.’”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Sikweendelezya Musongo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Ape Jesu wakateeti kuli basikwiiya bakwe, “Kwali muntu muvubi wajesi sikweendelezya lubono lwakwe. Ooyo muvubi wakaambilwa kuteeti sikweendelezya lubono lwakwe ulimukwaasinyoona mali. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Mpoonyina wakaita sikweendelezya okuteeti kulinguwe, ‘Niinzeezi zyendimvwide alindiwe? Ndipe mundandaanda mbuwakabelesya lubono lwangu, kaambo takucikonzeki kuteeti wiindilizye kweendelezya lubono lwangu.’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Mpoonyina sikweendelezya wakalyaamboozya kateeti, ‘Ino ndilacita buti mbokunga simalelaangu ulandigwisya amusebezi wangu? Tandijesi nguzu zyokugampoola, ape ndilalisenda kukumbila. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ehee! Ndilizi cenditacite kuteegwa ndagwisigwa amusebezi ndibe abeenzuma bayoonditambula mumaandaabo.’ <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Mpoonyina wakaita bantu boonse bakaleezikoloti kuli simalelaakwe, okubuzya wokusaanguna kuteeti, ‘Ino yebo uleecikoloti cisikaali kuli simalelaangu?’ <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />We wakateeti, ‘Madilamu aamafuta aa oliva ali mwaanda.’ Mpoonyina sikweendelezya wakateeti kulinguwe, ‘Ngooyu mweelwe wecikoloti cako. Kalaansi fwambaana lemba makumi osanwe feela.’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Mpoonyina wakabuzya umwi kuteeti, ‘Ino yebo uleecikoloti cisikaali?’ We wakateeti, ‘Masaka aamaila aali mwaanda.’ Okulooyu wakateeti, ‘Ngooyu mweelwe wecikoloti cako. Lemba makumi aali lusele feela.’ <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Simalelo naakabona namu, wakalumbaizya ooyu sikweendelezya lubono lwakwe uutasyomeki kaambo wakacita cobusongo. Eeci cikozyanyo citondezya kuteeti bantu benyika balaamaano loko mukucita zintu mulicabo kwiinda bana bomumuni.”<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />Ape Jesu wakazwida anembo kwaamba kuteeti, “Iino ndimwaambila kuteeti, amubelesye lubono lomunyika kugwasya bantu kuteegwa mubaabeenzinyoko, cokuteeti lwazoomana Leza azoomutambule mumaanda aatamani. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Kufumbwa muntu uusyomeka muzintu ziniini nguusyomeka omuzipati, awe uutasyomeki muzintu ziniini tasyomeki omuzipati. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Ino, na tosyomeki mukweendeleezya lubono lomunyika, inga wasyomeka buti mulubono lwenconzyo? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Ape na kotasyomeki muzintu zyoumwi, ino ngwani utikupe zyako zikugeme?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:24">Mateyo 6:24</ref>.</char>
    </note> “Taakwe mubelesi ukonzya kuba muzike wa bami bobile, kaambo ulazonda umwi okuyanda umwi, na kukakatila kuli umwi okunyansilizya umwi. Tacikonzyekani kubelekela bami bobile, Leza amali.” <note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">Mateyo 6:24</ref>.</char></note><verse eid="LUK 16:13" /></para>
  <para style="s">Zimwi Zyaambo Zya Jesu</para>
  <para style="r">(<ref loc="MAT 11:12-13">Mateyo 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>; <ref loc="MRK 10:11-12">Maako 10:11-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Bafalisi balikuyandisisya mali nibakamvwa eezi zyoonse, bakatalika kumufubazika. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Mpoonyina Jesu wakateeti kulibo, “Mulipa kululama kumenso aabantu. Kono Leza uliizi myoyo yenu. Zintu zyemuyeeya kuteeti zezipati loko kubantu kuli Leza zilasesemya.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:12-13">Mateyo 11:12-13</ref>.</char>
    </note>“Mulawo wa Mozesi aamalembe aabasinsimi zyalikubeleka kusikila mane muciindi ca Joni Mubbabbatizi, kuzwaawo Makani Mabotu o Bwami bwa Leza alakambookwa ape abantu boonse balwanina kunjila mwateni. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" /><note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mateyo 5:18</ref>.</char></note> Kono cuubauba julu enyika kumana, kwiinda kabala naanga komwi ko Mulawo wa Leza kumwaigwa.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">Mateyo 5:32</ref>; <ref loc="1CO 7:10-11">1 Bakolinto 7:10-11</ref>.</char>
    </note> “Kufumbwa mwaalumi uleka mwanakazaakwe okukwata uumbi, wacita bumambe, awe ooyu uukwata mwanakazi wakalekwa wacita bumambe.”<verse eid="LUK 16:18" /></para>
  <para style="s">Muvubi o Lazalo</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Mpoonyina Jesu wakapa eeci cizyanyo, “Imwi nako kwali mwaalumi muvubi wali kuzwaata zizwaato zitalidulili, walikulya zilyo zibotu okuponoobotu loko buzuba-obuzuba. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Ape kwali omwaalumi mupenzi wali kuteegwa Lazalo, waleezilonda mubili woonse. Walikweetwaanga amulyango wooyu muvubi, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />kalangila kulya zyalikusyaala okuwa kuzwa atefule lyo muvubi. Ababwa balikuza okumyankoota zilonda zyakwe. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />Kuzwaawo, muntu mupenzi wakafwa okubwezegwa abangelo kuyookala kumbaloo Abbulahamu. Mpoonyina awe muvubi wakafwa okuzikwa. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Kumane wakainka kucibaka cabafu, kwaakamvwide kucisa kupati loko. Mpoonyina wakalanga mujulu okubona Abbulahamu kule loko kali o Lazalo kumbali lyakwe. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Mpoonyina wakaita kateeti, ‘Tata Abbulahamu! Ndifwide mangʼeke, utume Lazalo atompe munwe wakwe mumaanzi, azootontozye lulimi lwangu, kaambo ndimvwide kucisa kupati loko mumulilo muno!’ <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />Kono Abbulahamu wakateeti, ‘Mwanaangu, yeeya kuteeti mubuumi bwako walipedwe zintu zibotu zyoonse, we Lazalo wapedwe zintu zibi zyoonse. Kono iino we ulilikwaide okuno ayibo ulapenga ooko. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Kutaleeco feela, akati kesu ayibo kuli mulindi mulamfu loko cokuteeti taakwe muntu uukonzya kuzubuka kuzwa kuno kwiinka ooko, naanga uukonzya kuzubuka kuzwa ooko kuza kuno.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Mpoonyina muvubi wakateeti, ‘Ano nacilinamu, tata Abbulahamu ndakumbila kuteeti, utume Lazalo ku ngʼanda ya tata, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />kondijesi bazyalwama bosanwe. Akabacenjezye kuteegwa batakazookuno kucibaka cokucisa loko.’ <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />Abbulahamu wakataba kuteeti, ‘Bazyalwanyoko balijesi Mulawo wa Mozesi amalembe aabasinsimi aanga abacenjezya, beelede kwaaswiilizya zyaamba.’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Ooyu muvubi wakataba kuteeti, ‘Nee, tata Abbulahamu, kutali eeco feela, kono kuteeti umwi wabuka kuzwa kubafu okubainkila inga basanduka okusiya zibi zyabo.’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Kono Abbulahamu wakateeti, ‘Batamvwa Mulawo wa Mozesi amalembe aabasinsimi, naanga omwi wabuka kuzwa kubafu tabakoosyoma.’”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Jesu Waiisya zye Cibi Okulekelela</para>
  <para style="r">(<ref loc="MAT 18:6-7">Mateyo 18:6-7</ref>, <ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Maako 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Mpoonyina Jesu wakateeti kuli basikwiiya bakwe, “Masunko alebya bantu kuwida mucibi alalangilwa kusika, kono maawe kulooyo wapa kuteeti asike! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Inga cabota kuteeti waangililwa ziyo pati munsingo okusowelwa mulwizi kwiinda kuteeti ape umwi waaba baniini kuwida mucibi. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" /><note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mateyo 18:15</ref>.</char></note> Iino amwiilangisisye micito yenu!”</para>
  <para style="p" vid="LUK 17:3">“Na musyominyoko wabisya, amumupatookele, na kuteeti weempwa, amumujatile. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Na kuteeti kapilukila kukulubizizya ziindi zili ciloba mubuzuba bomwi ape mbwaakubisizya keza kulindiwe kateeti, ‘Ndeempwa,’ uleelede kumulekelela.”<verse eid="LUK 17:4" /></para>
  <para style="s">Jesu Waiisya Makani Oolusyomo</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Kuzwaawo baapositola bakaambila Mwami kuteeti, “Yungizizya lusyomo lwesu!”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Mpoonyina Mwami wakabataba kuteeti, “Nimwaloolusyomo neluceya mbuli kaseke ka masitadi, nemukonzya kwaambila cisamu co mulubbeni ooyu kuteeti, ‘Simpuka aawa ukalibyale mulwizi!’ Mpoonyina ciyoocita mboonyina namu.<verse eid="LUK 17:6" /></para>
  <para style="s">Musebezi wo Mubelesi</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />“Nakuteeti umwi wenu kajesi mubelesi uulima mumuunda na weembela mbelele. Ucikotoka feela kuzwa kumuunda, ino inga wamwaambila kuteeti, ‘Fwambaana koza ulye’ na? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Nee! Kono ulateeti kulinguwe, ‘Fwambaana undijikile cokulya. Wamana uzwaate kabotu mpoonyina undeetele zyokulya kandilya okunywa. Ndamana, kulya ayibo notilye okunywa.’ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Ino mubelesi ulalumbwa anoocilila malailile na? Nee. <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Cintu ciswana okulindinywe. Mwacita zyoonse zimwaambilwa, amwaambe kuteeti, ‘Tuli bazike feela bateelede kulumbwa. Twacita feela musebezi ngotweelede kucita.’”<verse eid="LUK 17:10" /></para>
  <para style="s">Jesu Waponya Basizinsenda Bali Kumi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Iino Jesu naali mumusinzo woku Jelusalemu, wakainda mumunyinza wa Samaliya o Galileya. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Naalikunjila mumunzi umwi, basizinsenda bali kumi bakeza kulinguwe okwiimina aleele, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />okoongolola kabateeti, “Jesu! Simalelo! Tufwide mangʼeke!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:14 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 14:1-32">Levitiko 14:1-32</ref>.</char>
    </note>Jesu naakababona wakateeti kulibo, “Kamuya ku Ngʼanda ya Leza kubapaizi bakaakubone kuteeti mwapona.”</para>
  <para style="p" vid="LUK 17:14">Kumane bakaponisigwa kabayoobuya. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Umwi wabo naakabona kuteeti wapona, wakapiluka kuli Jesu kalumbaizya Leza ejwi pati. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Naakasika wakaavuntamina Jesu okumulumba. Mwaalumi ooyu wali muna Samaliya. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Mpoonyina Jesu wakateeti, “Ede kwaponesegwa bali kumi. Ino bali fuka bali kuli? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Kaambo nzi nikwapiluka feela wamasi ooyu kuzoolumba Leza?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Mpoonyina Jesu wakateeti kulinguwe, “Nyamuka, koya. Lusyomo lwako lwakuponya.”<verse eid="LUK 17:19" /></para>
  <para style="s">Kuza ko Bwami bwa Leza</para>
  <para style="r">(<ref loc="MAT 24:23-28">Mateyo 24:23-28</ref>, <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Bumwi buzuba bamwi Bafalisi bakabuzya Jesu kuteeti, “Ino Bwami bwa Leza buza lili?” Wakabataba kuteeti, “Bwami bwa Leza tabuzi munzila yokuteeti mane bulibonye. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Taakwe uutikaambe kuteeti, ‘Bona! Mboobaawa!’ Na ‘Mboobuya aalya’, kaambo Bwami bwa Leza bulikale akati kenu.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Mpoonyina Jesu wakateeti kuli basikwiiya bakwe, “Iyoosika nako nomuyooyandisisya kububona buzuba bomwi bwamazuba o Mwanoomuntu kono tamukoyoobubona. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Mpoonyina kunooli bamwi banooteeti kulindinywe, ‘Langa, nguulya kuya Mwanoo Muntu!’ Na ‘Ngooyu awa!’ Kono mutakabacililizyi. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Kulibonya ko Mwanoo Muntu asika kuyooba mboonyina mbuli lulabi lwemvula aalya lwanoolaba okumunikila julu kuzwa kulubazu lumwi kuya kuli lumwi. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Kono weelede kusaanguna kupenga loko o kukakwa abantu besunu. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" /><note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Matalikilo 6:5-8</ref>.</char></note> Mboonyina mbuli mbukwakabede mumazuba aa Nowa, mbombubo mboonyina mbokuyooba mumazuba o Mwanoo Muntu. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" /><note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Matalikilo 7:6-24</ref>.</char></note> Bantu boonse bagamine kupona feela mbuli lyoonse kunywa okulya ape banakazi abaalumi balikukwatana, kusika nako Nowa naakanjila mumugolo mupati. Mpoonyina miyoba mipati yakasika okubajayoola boonse. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" /><note caller="-" style="x"><char style="xo" closed="false">17:28 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">Matalikilo 18:20—19:25</ref>.</char></note> Ape bunooli mbuli buzuba bwa Loti. Bantu boonse bagamine kupona feela mbuli lyoonse kunywa okulya, kuula okuuzya, kubyala okuyaka. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Kono mubuzuba Loti naakazwa mu Sodoma, mabwe oomulilo akaloka kuzwa kujulu okubajayoola boonse. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Mboonyina namu bantu tabanoolibambilide nako nayooyubununywa Mwanoo Muntu.<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:31 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:17-18">Mateyo 24:17-18</ref>; <ref loc="MRK 13:15-16">Maako 13:15-16</ref>.</char>
    </note> “Muloobo buzuba, ooyo unooli aciluli cengʼanda atakapilukili mungʼanda kuteegwa abweze zintu zyakwe. Ape ooyo uli mumuunda atapilukili kungʼanda yakwe. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" /><note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">Matalikilo 19:26</ref>.</char></note> Amuyeeye mwanakazaa Loti! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" /><note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mateyo 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Maako 8:35</ref>; <ref loc="LUK 9:24">Luka 9:24</ref>; <ref loc="JHN 12:25">Joni 12:25</ref>.</char></note>Kufumbwa muntu usola kufutula buumi bwakwe, uyoobusweekelwa, kono kufumbwa usweekelwa buumi bwakwe uyoobubamba. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ndimwaambila kuteeti mubusiku oobo, bantu bobile bonoolede abulo bomwi, omwi uyootolwa, umwi uyoosyaala. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Banakazi bobile banooziya antoomwi, umwi uyootolwa, umwi uyoosyaala.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Baalumi bobile banooli mumuunda, umwi uyootolwa, umwi uyoosyaala.<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">Amwi malembo taajesi kancali ka 36. </char></note><verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Basikwiiya bakwe bakamubuzya kuteeti, “Ino Mwami eezi ziyoocitikila kuli?”</para>
  <para style="p" vid="LUK 17:37">Mpooonyina Jesu wakabataba kuteeti, “Ooko kuli mutunta, makubi kwaabunganina.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Amukombe Cokuzumanana</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Bumwi buzuba Jesu wakaambila basikwiiya bakwe cikozyanyo kubaisya kuteeti kabakomba nako yoonse kabatatyompwi. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Wakateeti, “Muliimwi taindi kwali mubetesi watali kuyowa Leza naanga kukuteka bantu. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Ape mutaindi ndyonyeelyo kwali mukamufu walikwiinkaanga kumubetesi ooyo okumwaambila kuteeti, ‘Ndilulamikile kaambo kangu osinkondoma!’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Kweciindi cilamfu, ooyu mubetesi walikumukakila kono kumamanino wakalyaamboozya kateeti, ‘Nekuteegwa siyoowi Leza naanga kukuteka bantu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />iino kaambo mwanakazi ooyu wandipenzya, ndilakalulamika kaambo kakwe, ndatacita namu, ulazumanana kundikatazya.’”<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Mpoonyina Mwami wakateeti, “Amumvwe zyakaamba mubetesi utaluleme. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Ino Leza takoyoopa basale bakwe ciluleme, bamulilila lugwasyo masiku esikati na? Ino Leza inga waliyeha kubagwasya na? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ndimwaambila kuteeti ulabapa bwaatuzi bululeme cokufwambaana. Kono ino Mwanoo Muntu asika uzoojana lusyomo anyika na?”<verse eid="LUK 18:8" /></para>
  <para style="s">Cikozyanyo co Mufalisi o Simutelo</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Kuzwaawo Jesu wakapa cikozyanyo eeci kubantu balikulimvwa kuteeti baliluleme okunyansilizya bamwi boonse. <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />Wakateeti, “Kwali baalumi bobile bakainka ku Ngʼanda ya Leza kuyookomba. Umwi wali Mufalisi umwi wali simutelo. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Mufalisi wakaima okukomba kalyaamba kuteeti, ‘Leza ndilakulumba mukuteeti tandili mbuli bantu boonse, tandili mufumpi, tandili muntu uutasyomeki, tandili simamambe naanga mbuli ooyu simutelo. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ndiliimyaanga zyokulya mazuba obile munsondo, ape ndilakupa ecekumi kuli zyoonse zendijana.’ <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />Kono simutelo wakaiminaale okukacilwa kulanga kujulu naalikukomba, kono walikulyuuma acamba kateeti, ‘Leza ndifwide mangʼeke, kaambo ndilisimucita zibi!’ <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" /><note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mateyo 23:12</ref>; <ref loc="LUK 14:11">Luka 14:11</ref>.</char></note> Mpoonyina Jesu wakateeti ndimwaambila kuteeti, simutelo wakapiluka kungʼanda yakwe kalulamikidwe kutaamba Mufalisi.” Ndamwaambila cikozyanyo eeci kuteegwa muzibe kuteeti, “Boonse balisumpula bayootolwa ansi ape aabo balitola ansi bayoosumpulwa.”<verse eid="LUK 18:14" /></para>
  <para style="s">Jesu Waleleka Bana Baniini</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mateyo 19:13-15</ref>; <ref loc="MRK 10:13-16">Maako 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Imwi nako, bamwi bantu balikweeta bana babo baniini kuli Jesu kuteeti azoobabike maanzaakwe amitwe okubaleleka. Basikwiiya bakwe nibakabona namu, bakanyemena bantu aaba. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Kono Jesu wakaita bana baniini kuteegwa baze kulinguwe okuteeti, “Amubaleke bana baniini baze kulindime, mutabakasyi kaambo Bwami bwa Leza mbwabantu babede mbulimbabo. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Ndimusyomezya kuteeti kufumbwa utikacilwe kutambula Bwami bwa Leza mbuli mwana muniini takoyoonjila mwateni.”<verse eid="LUK 18:17" /></para>
  <para style="s">Muntu Muvubi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mateyo 19:16-30</ref>; <ref loc="MRK 10:17-31">Maako 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Bumwi buzuba, umwi musololi waba Juda wakabuzya Jesu kuteeti, “Omwiiyi mubotu, ino ndeelede kucita nzi kuteeti nditambule buumi butamani?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Jesu wakamutaba kuteeti, “Ino niinzi nondiita kuteeti mubotu? Taakwe muntu mubotu aati feela Leza. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" /><note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Kulonga 20:14</ref>; <ref loc="DEU 5:18">Detilonomo 5:18</ref>; <ref loc="EXO 20:13">Kulonga 20:13</ref>; <ref loc="DEU 5:17">Detilonomo 5:17</ref>; <ref loc="EXO 20:15">Kulonga 20:15</ref>; <ref loc="DEU 5:19">Detilonomo 5:19</ref>; <ref loc="EXO 20:16">Kulonga 20:16</ref>; <ref loc="DEU 5:20">Detilonomo 5:20</ref>; <ref loc="EXO 20:12">Kulonga 20:12</ref>; <ref loc="DEU 5:16">Detilonomo 5:16</ref>.</char></note> Ede uliizi milawo, ‘Utajayi, utaciti bumambe, utabbi, utabejekezyi umwi, utabeji, kuteka bauso abanyoko.’”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Mwaalumi ooyu wakataba kuteeti, “Yoonse eeyi milawo ndakaicilizya kuzwa kubwana.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Mpoonyina Jesu naakamvwa namu wakamwaambila kuteeti, “Kucili cintu comwi coelede kucita. Uuzye zintu zyako zyoonse, mpoonyina mali ukape bapengede, notikabe obuvubi kujulu. Wazwaawo uze undicilile.” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Kono ooyu mwaalumi naakamvwa namu wakausa loko, kaambo walivubide loko ape taalikuyanda kubupa buvubi bwakwe.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Jesu naakabona kuteeti ooyu mwaalumi wausa<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Malembo amwi taajesi bulembo bokuteeti “wausa.”</char></note> wakateeti, “Ciyumu loko kubantu bavubide kuyoonjila mu Bwami bwa Leza. <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Nconzyo cintu cuuba nkamela kwiinda muliinso lyendonga, kwiinda muntu uvubide kunjila mu Bwami bwa Leza.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Mpoonyina bantu bakamumvwa bakabuzya kuteeti, “Ino mpoonyina ngwani ukonzya kufutulwa?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Jesu wakataba kuteeti, “Citakonzyeki kubantu, kuli Leza cilakonzeka.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Mpoonyina Pita wakateeti, “Langa! Twakasiya zyoonse zetujesi kukucilila.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Mpoonyina Jesu wakabaambila kuteeti, “Iiyi, ndamusyomezya kuteeti kufumbwa wakasiya ngʼanda yakwe, na mwanakazaakwe, na bazyalwanyina, na bazyali bakwe, na bana bakwe kaambo ko Bwami bwa Leza <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />uyootambula mubunji mubuumi bwesunu ape uyootambula buumi butamani muciindi ciza.”<verse eid="LUK 18:30" /></para>
  <para style="s">Jesu Waamba Zyolufu Okubuka Kwakwe Ape</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mateyo 20:17-19</ref>; <ref loc="MRK 10:32-34">Maako 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Mpoonyina Jesu wakatola basikwiiya bali kumi abobile kumbali okubaambila kuteeti, “Amuswiilizye! Tuya ku Jelusalemu ooko koziyoozuzikizigwa zyoonse zyakalembwa abasinsimi kujatikizya Mwanoo Muntu. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Bayoomwaaba mumaanza abamasi, aabo bayoomufubazika okumutuka okumuswida mate. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Bayoomukwabboola loko okumujaya, kono kwainda mazuba otatwe uyoobuka kuzwa kubafu.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Kono basikwiiya ba Jesu taakwe nibakaamvwisisisya majwi aakwe kaambo alikubalyanganya cokuteeti taakwe nibakaziba zyaalikwaamba.<verse eid="LUK 18:34" /></para>
  <para style="s">Jesu Waponya Moofu Sikukumbilila</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mateyo 20:29-34</ref>; <ref loc="MRK 10:46-52">Maako 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Jesu naakasika afwiifwi o Jeliko, umwi mwaalumi moofu wakede mumbali enzila kakumbilila. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Ooyu mwaalumi naakamvwa kuyoba kwe bbunga lyabantu lyalikwiinda, wakabuzya kuteeti, “Ino niinzi cicitika?”<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Mpoonyina bakamwaambila kuteeti, “Ngu Jesu woku Nazaleta nguuyobwiinda.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Mpoonyina wakoongolola kateeti, “Jesu! Mwanaa Deveti! Ndifwide mangʼeke!”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Mpoonyina bantu bali kunembo bakamupatookela okumwaambila kuteeti aumune, kono we naakoongololesya kateeti, “Mwanaa Deveti! Ndifwide mangʼeke!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Jesu naakamumvwa, wakaima okulailila kuteeti ooyu mwaalumi bamweete kulinguwe. Naakaswena afwiifwi, Jesu wakamubuzya kuteeti, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Ino uyanda kuteeti ndikucitile nzi?”</para>
  <para style="p" vid="LUK 18:41">Wakataba kuteeti, “Mwami, ndiyanda kubonaape.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Mpoonyina Jesu wakamwaambila kuteeti, “Ano kobona! Lusyomo lwako lwakuponya.”<verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />Mpoonyinaawo wakakonzya kubona ape, okucilila Jesu okukayoobulumbaizya Leza. Bantu boonse nibakabona namu abo bakalumbaizya Leza.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Jesu o Zakeyo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Kuzwaawo Jesu wakanjila mu Jeliko kayoobwiinda. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Kwali kukala umwi simutelo mupati wali kwiitwa kuteeti Zakeyo, wavubide loko. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Ooyo muntu walikusola kuteeti abone Jesu, kono kaambo kokufwiimpa kwakwe okuvula kwabantu, wakakacilwa. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Mpoonyina Zakeyo wakazuzila kunembo okuyootanta mucisamu comukuyu kuteegwa abone Jesu mukuteeti Jesu kwaakeleede kwiinda. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Jesu naakasika acibakaawo, wakalanga mujulu okumwaambila kuteeti, “Zakeyo, fwambaana seluka! Ndeelede kukala mungʼanda yako sunu.”<verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Zakeyo wakaseluka cokufwambaana okumutambula kaboteledwe loko. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Bantu boonse bakaboneeci bakatalika kutongooka kuteeti, “Ooyu mwaalumi wainka kuyoopotela sizibi!”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Mpoonyina Zakeyo wakanyamuka okwaambila Mwami kuteeti, “Komvwa Mwami! Ndilabwiinda akati buvubi bwangu okupa cibeela comwi kubapenzi, ape na ndakeeneena muntu, ndiyoomupilusizya ziindi zyone.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Jesu wakataba kuteeti, “Lufutuko lwasika kubantu boomuno mungʼanda sunu, kaambo ooyu mwaalumi awe ngokulunyungu lwa Abbulahamu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" /><note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">Mateyo 18:11</ref>.</char></note> Ede Mwanoo Muntu wakazida kuyandoola okufutula basweekede.”<verse eid="LUK 19:10" /></para>
  <para style="s">Cikozyanyo ce Dii lye Ngolide</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mateyo 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Bantu kabaciswiilizya eezi zyaalikwaamba, Jesu wakazwida anembo kubaambila cikozyanyo kaambo aawa walaafwifwi o Jelusalemu, ape kaambo ababantu bakayeeya aanga Bwami bwa Leza bwaandosika mpoonyinaawo. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Mpoonyina wakateeti kulibo, “Kwali mwaalumi walikukutekwa wali kwiinka kucisi cokule loko kuyoopegwa bwami kuteegwa kwamana apiluke azoolele bantu bakwe. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Katanainka, ababelesi bakwe wakaita bali kumi okubapa di lyomwi-lyomwi lyengolide<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">“Di lyengolide” muci Giliki caamba “mina”. Mina wakali mweelwe wamali wakali kweelana okuhola kwa simusebezi kwa mazuba aali mwaanda.</char></note> okubaambila kuteeti, ‘Mwaapindoole mali aaya kuteegwa ndaakuza ndizojane mpindu yawo.’ <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Kono basicisinyina balikumuzondede, mpoonyina musule lyaakwe, bakatuma batumwa amajwi okuteeti, ‘Swebo tatuyandi kuteeti muntu ooyu abe mwami wesu.’<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“Mwaalumi ooyo wakapegwa bwami amane wakapiluka. Mbwaakasika feela, wakaita babelesi bakwe boonse mbaapede mali kuteegwa azibe mpindu njibakajana mukupindooka kwabo. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Wokusaanguna wakasika okuteeti, ‘Mwami, ndakajana mali eengolide aali kumi kuzwa kuli lyomwi ndiwakandipede.’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Mwami wakateeti kulinguwe, ‘Wacita kabotu, omubelesi mubotu! Iino kaambo ulasyomeka muzintu ziniini, ndilakupa bweendelezi bwa mataindi mapati aali kumi.’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Mubelesi wabili wakasika okuteeti, ‘Mwami, ndajana mali eengolide aali osanwe kuzwa kuli lyomwi ndiwakandipede.’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Kulooyu wakateeti, ‘Ulaba mweendelezye wa mataindi mapati osanwe.’ <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Umwi mubelesi wakasika okuteeti, ‘Mwami, ndeeli di lyako lya ngolide, ndalilivungailide mukasila. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Ndakayoowa kaambo ulimukali. Ulabweza ciwatakabika ape ulakutula ciwatakabyala.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Mpoonyina mwami wakamwaambila kuteeti, ‘Yebo o mubelesi mubi! Ndilabelesya majwaako kukupa mulandu! Ulizi kuteeti ndilimukali, ndibweza cindatakabika okukutula cindatakabyala. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Ino niinzi niwatakaabika feela mumaanza abasimpindu malaangu? Naanga ndaatambula empindu atala akupiluka kwangu.’ <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Mpoonyina wakaambila bakaimvwi aawo kuteeti, ‘Amumunyange di lye ngolide mulipe ooyo mubelesi ujesi aali kumi.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Kono bakateeti kulinguwe, ‘Mwami, ede ulijesi kale madi aali kumi!’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />Mwami wakabataba kuteeti, ‘Ndimwaambila kuteeti, aabo bajesi bayoopegwa zinji, kono uutajesi uyoonyangwa naanga kaniini kajesi. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" /><note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Mateyo 25:14-30</ref>.</char></note>Iino kulaabo basinkondoma batalikuyanda kuteeti ndibe mwami wabo, amubeete kuno ape mubajaile mumenso aangu!’”<verse eid="LUK 19:27" /></para>
  <para style="s">Jesu watambulwa mu Jelusalemu co Bwami</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateyo 21:1-11</ref>; <ref loc="MRK 11:1-11">Maako 11:1-11</ref>; <ref loc="JHN 12:12-19">Joni 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Jesu naakamana kwaamba namu, wakazumanana kwiinka ku Jelusalemu. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Naakasika afwiifwi omuunzi wa Betifage owa Bbetaniya ku Cilundu ca Oliva, wakatuma bobile ali basikwiiya kunembo <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />okubalailila kuteeti, “Kamuya kumuunzi ulaanembo. Muciyoosika feela, muyoojana mbongolo itana beleka, yaangidwe acisamu. Mukayaangunune mpoonyina muyeete kuno. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Na umwi amubuzye kuteeti, ‘Ino muyaangunwidaanzi?’ Mumwaambile kuteeti, ‘Mwami ulaiyanda.’”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Aabo basikwiiya bakatumwa, bakainka okuyoojana zyoonse zili mboonyina mbwaakabaambilide Jesu. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Nibali kuyaangununa mbongolo, bamukamwini bakababona okuteeti, “Ino muyangunwidaanzi mbongolo eeyo?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Bakataba kuteeti, “Mwami uliiyanda,” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Bakayeeta kuli Jesu, okuyala majansi aabo amunsana wayo, mpoonyina wakatanta fateni. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Naalikuyoobuya katantide fateni, bantu balikuyoobuyala majansi aabo munzila.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Naakasika afwiifwi o Jelusalemu, acibaka nzila mpoiselelela kuzwa kucilundu ca Oliva, mbunga yoonse yabasikwiiya bakwe yakatalika kusekelela okulumbaizya Leza ejwi pati kaambo kamaleele oonse ngibakabona, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" /><note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Intembauzyo 118:26</ref>.</char></note> kabateeti, “Ulilelekedwe Mwami ooyo uza muzina lyo Mwami Leza! Luumuno kujulu obulemu kuli Leza!”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Mpoonyina bamwi Bafalisi bali mumbunga oomo bakateeti kuli Jesu, “Omwiiyi, lailila basikwiiya bako baumune!”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Jesu wakabataba kuteeti, “Ndimwaambila kuteeti naanga baumuna, mabwe alatalika koongolola kulumbaizya.”<verse eid="LUK 19:40" /></para>
  <para style="s">Jesu Walila Taindi Pati lya Jelusalemu</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Jesu naakaswena afwiifwi okulibona taindi pati lya Jelusalemu, wakalila kaambo wakalifwida mangʼeke taindi pati eeli. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Wakateeti, “Kambe feela niwalizi sunu ziyandika kuteeti kube luumuno! Kono iino tokonzyi kuzibona! <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Nako iyoosika basinkondonyoko nebayookuyakila bwaanda bukuzungulukide kukusinkila koonse-koonse. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Mpoonyina bayookusinyoona yebo abana bako bakala mulindiwe. Taakwe bbwe naanga lyomwi ndebayoosiya atalee bbwenyina, kaambo taakwe niwakaciziba nako Leza naazide kuzookufutula.”<verse eid="LUK 19:44" /></para>
  <para style="s">Jesu Watanda Basikuuzya Mulabba lye Ngʼanda ya Leza</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mateyo 21:12-17</ref>; <ref loc="MRK 11:15-19">Maako 11:15-19</ref>; <ref loc="JHN 2:13-22">Joni 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Mpoonyina Jesu wakainka mulabba lye Ngʼanda ya Leza, okutalika kutanda balikuuzizya<note caller="+" style="f"><char style="fr" closed="false">19:45 </char><char style="ft" closed="false">Naakuteeti umwi walikuyanda kuula munyama wokutuuzya kuli Leza mulabba lye Ngʼanda ya Leza, aaba basikuuzya bakali kumuuzizya. Ape balikuuzya ezimwi zintu eezyo bantu zyobali kuyanda kukutuuzya zili mbuli waini, mafuta antoomwi o sautu. Aaba basikuuzya balikweeneena bantnu kwiinda mukuduzya myuulo yezintu zyobali kuuzya. Ape balikudyaaminina bapengede.</char></note> mwateni, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" /><note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Izaya 56:7</ref>; <ref loc="JER 7:11">Jelemiya 7:11</ref>.</char></note> kateeti kulibo, “Kulilembedwe mu Malembo kuteeti Leza wakateeti, ‘Ngʼanda yangu iyooba ngʼanda yokukombela.’ Kono mwaisandula kuba ciyubilo cababbi!”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:47 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 21:37">Luka 21:37</ref>.</char>
    </note> Jesu walikwiisya mulabba lye Ngʼanda ya Leza buzuba-obuzuba. Bapaizi basilutwe abamayi bo Mulawo abasololi ba bantu balikuyandoola nzila yokumujaila fateni. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Kono bakakacilwa kwiijana kaambo bantu boonse balikuyandisisisya kumuswiilizya.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Mubuzyo Wenguzu zya Jesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mateyo 21:23-27</ref>; <ref loc="MRK 11:27-33">Maako 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Bumwi buzuba Jesu kaiisya bantu mulabba lye Ngʼanda ya Leza okukambooka Makani Mabotu, bapaizi basilutwe bamayi bo Mulawo abamaalu bakamuzida okumubuzya kuteeti, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />“Ninguzu nzi zyobelesya kucita zintu eezi? Ngwani wakakupa zizyo?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Mpoonyina Jesu wakabataba kuteeti, “Pili amebo ndimubuzye mubuzyo. Munditabe, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />ino nguzu zya Joni zyokubbabbatizya zyakazwida kuli Leza na kubantu?” <verse eid="LUK 20:4" /><verse number="5" style="v" sid="LUK 20:5" />Bakatalika kwaamboozyanya mulicabo kuteeti, “Ino tulataba buti? Twataba kuteeti, ‘Zyakazwa kuli Leza,’ ulaamba kuteeti, ‘Ino niinzi nimwatakamusyoma Joni?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Kono ape twaamba kuteeti, ‘Zizwa kubantu,’ bantu boonse babungene aawa, balatupotoola mabwe kaambo basyoma kuteeti Joni wali musinsimi.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Mpoonyina bakataba kuteeti, “Tatuzi kuzyakazwida nguzu zya Joni zyokubbabbatizya.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Mpoonyina Jesu wakabaambila kuteeti, “Ano tandikomwaambila amebo nguzu zyondibelesya kucita zintu eezi kuzyakazwida.”<verse eid="LUK 20:8" /></para>
  <para style="s">Cikozyanyo ca Balimi Babi</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mateyo 21:33-46</ref>; <ref loc="MRK 12:1-12">Maako 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:9 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:1">Izaya 5:1</ref>.</char>
    </note>Mpoonyina Jesu wakaambila bantu cikozyanyo eeci, “Kwali mwaalumi wakabyala muunda womusaansa okuusiya mumaanza abalimi kuteeti baweendelezya kuteegwa bapanga mpindu, kabaabana anguwe. Mpoonyina wakainka mumusinzo kweciindi cilamfu. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Niyakasika nako yokukutula, wakatuma muzike wakwe kuteeti akamubwezele caabilo cakwe kubalimi. Kono balimi bakauma muzike okumupilusya cinkwa maanza. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Mpoonyina wakatuma umwi muzike, kono balimi bakamuuma awe okumusampoola okumupilusya cinkwa maanza. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Mpoonyina ape wakatuma muzike watatu. Balimi bakamucisa anguwe, okumusowelaanze cinkwamaanza. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Mpoonyina mukamwini muunda wakateeti, ‘Ndilacita buti? Ndilatuma mwanaangu muyandisi, nconzyo bayoomukuteka.’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Mpoonyina wakatuma mwana wakwe. Kono balimi nibakamubona, bakaamboozyanya kuteeti, ‘Ooyu ngoswaana. Amuze tumujaye kuteegwa muunda tuubweze!’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Kuzwaawo bakamusowela anze omuunda, okumujaya.”</para>
  <para style="p" vid="LUK 20:15">Mpoonyina Jesu wakabuzya kuteeti, “Ino mukamwini muunda uzoobacita buti aabo balimi? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Uzooza okubajaya aabo balimi okuupa bamwi.”</para>
  <para style="p" vid="LUK 20:16">Bantu nibakamvwa namu bakateeti, “Aakaka, kutabi namu!”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:17 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:22">Intembauzyo 118:22</ref>.</char>
    </note> Kono Jesu wakabadongomwena okubabuzya kuteeti, “Ino Malembo aaya ookuteeti,</para>
  <para style="q1" vid="LUK 20:17">‘Bbwe<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="ft" closed="false">Jesu wakabelesya kancali aaka alinguwe. Bbwe eeli liiminina nguwe. Bayasi baiminina basololi beci Juda. Bakamukaka Jesu kono Leza wakamusumpula.</char></note> ndibakakaka bayasi kuteeti talikwe musebezi</para>
  <para style="q2" vid="LUK 20:17">lyakaba ndeliyandisi kwiinda oonse’ aamba nzi?<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Kufumbwa muntu uwida abbwe eelyo, ulavwenzooka na bbwe eelyo lyawida amuntu umwi, lilamupwacoola kuba busu.”<verse eid="LUK 20:18" /></para>
  <para style="s">Mubuzyo ankani yo Kutela Mutelo</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mateyo 22:15-22</ref>; <ref loc="MRK 12:13-17">Maako 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Bapaizi basilutwe abamayi bo Mulawo, balikuyanda kumwaanga Jesu mpoonyinaawo, kaambo bakaziba kuteeti mucikozyanyo eeci walikwaamba mbabo. Kono bakayoowa bantu, mpoonyina bakamusiya okwiinka. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Mpoonyina bakamucililizya kumuyandweeda mokumwaangila. Bakaula bamwi baalumi makulo okubaambila kuteeti bakalitondezye mbuli kuteeti balasyomeka kulinguwe. Bakatuma baalumi aaba kuli Jesu kuteegwa bamujanine kaambo kwiindila mukwaamboola kwakwe okumwaaba kumweendelezi waba Loma kuyaatulwa. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Mpoonyina aabo bakaulwa makulo bakateeti kuli Jesu, “Omwiiyi, tulizi kuteeti zyoamba okwiisya zyenconzyo ape tosalululi kono wiisya feela zyenconzyo zyayanda Leza kuteeti tucite. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Iino twaambile, cililuleme na taciluleme mumulawo wesu kutela mutelo kuli Kaisala Muleli Mupati waba Loma?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Kono Jesu wakabona lweeneeno lwabo, mpoonyina wakateeti kulibo, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Amunditondezye kadi komuwaya-waya wensiliva. Ino cifwanikiso eeci ezina lilaawa zizyani?”</para>
  <para style="p" vid="LUK 20:24">Bakataba kuteeti, “Zizya Kaisala.”<figure style="fig" alt="Roman coin" file="hk00166b.tif" size="col" loc="20:19-20:26" ref="20:24">Kadi komuwaya-waya</figure><verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Mpoonyina Jesu wakateeti, “Zya Kaisala, amuzipe kuli Kaisala, ezya Leza amuzipe kuli Leza.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Aawa bakabula akumujanina kaambo akati kabantu kwiindila mukwaamboola kwakwe. Kutaba kwakwe kwakabakomosya mpoonyina bakaumuna feela.<verse eid="LUK 20:26" /></para>
  <para style="s">Mubuzyo ankani Yokubuka kuzwa Kubafu</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mateyo 22:23-33</ref>; <ref loc="MRK 12:18-27">Maako 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:27 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Misebezi 23:8</ref>.</char>
    </note> Kuzwaawo bamwi Basaduki bakeza kuli Jesu. Basaduki basyoma kuteeti bantu tabayoobuki kuzwa kubafu. Nibakasika bakamwaambila kuteeti, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" /><note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Detilonomo 25:5</ref>.</char></note> “Omwiiyi, Mozesi wakatulembela Mulawo wokuteeti, ‘Na mwaalumi wafwa katazyede, muzyalwanyina womufu weelede kukwata mukamufu okuzyalila mufu bana.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Imwi nako kwali baalumi bali ciloba bazyedwaamwi. Mupati wakakwata okufwa katakwe mwana. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Mpoonyina walikumucilila wakakwata mukamufu awe wakafwa. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Okuliwatatu mbweenya namu. Cintu ciswana cakacitika kuli aaba boonse bali ciloba, bakafwa kabatazyede anguwe. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Kumamanino mwanakazi awe wakafwa. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Iino, mubuzuba bokubuka kwabafu, ooyu mwanakazi uyoba wani? Twabuzya namu kaambo boonse bali ciloba balikumukwete.”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Jesu wakabataba kuteeti, “Baalumi abanakazi bouno musela balakwatana, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />kono baalumi abanakazi beelela kubusigwa kuzwa kubafu okupona muciindi ciza tabakoyookwatana. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Mane banooli mbuli bangelo ape tabakonzya kufwa. Mbana ba Leza kaambo babuka kuzwa kubafu. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" /><note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kulonga 3:6</ref>.</char></note> Awe Mozesi wakacibika antangalala kuteeti, bafwa balabusigwa kuzwa kubafu mumalembe ankani ye citeyo calikuyaka mulilo, paakaita Mwami kuteeti, ‘Leza wa Abbulahamu, Leza wa Isaka, o Leza wa Jakobo.’ <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Eeci caamba kuteeti ngu Leza wabapona, tali wabantu bafwide nee, kaambo kulinguwe boonse bantu bakwe mbaumi.”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Mpoonyina bamwi bamayi bo Mulawo baliwo bakaamba kuteeti, “Wataba kabotu, omwiiyi!” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Kuzwaawo, taakwe nibakasolela limwi kumubuzya mibuzyo ape.<verse eid="LUK 20:40" /></para>
  <para style="s">Ino Mesiya inga waba buti wolunyungu lwa Deveti kumwi kali Mwami wakwe</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mateyo 22:41-46</ref>; <ref loc="MRK 12:35-37">Maako 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Mpoonyina Jesu wakababuzya kuteeti, “Ino inga kwaambwa buti kuteeti, Mesiya unooli wolunyungu lwa Mwami Deveti? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" /><note caller="-" style="x"><char style="xo" closed="false">20:42 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Intembauzyo 110:1</ref>.</char></note> Deveti lwakwe mubbuku lye Ntembauzyo waamba kuteeti,</para>
  <para style="q1" vid="LUK 20:42">‘Mwami wakaambila Mwami wangu kuteeti</para>
  <para style="q2" vid="LUK 20:42">kala kubbazu lyolulyo lwangu lyobulemu <verse eid="LUK 20:42" /><verse number="43" style="v" sid="LUK 20:43" />kusikila ndibike basinkondonyoko kuba cilyatilo cezituta zyako.’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Na Deveti wakaita Mesiya kuteeti ‘Mwami,’ ino inga waba buti wolunyungu lwakwe<note caller="+" style="f"><char style="fr" closed="false">20:44 </char><char style="ft" closed="false">Mesiya wakali wolunyungu lwa Deveti ape wali Mwami wa Deveti. Baswiilizi ba Jesu bakali kuyeeya kuteeti bolunyungu lwa Deveti bali bantu susu feela. Taakwe nibakali kuyeeya kuteeti awe ngu Leza nikuba kuteeti muli eeyi Ntembauzyo cilipandulwidwe kabotu-kabotu. (Aawa Jesu taakwe naakaamba kuteeti Mesiya taakali wolunyungu lwa Deveti). </char></note>?”<verse eid="LUK 20:44" /></para>
  <para style="s">Jesu Wacenjezya zya Bamayi bo Mulawo</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mateyo 23:1-36</ref>; <ref loc="MRK 12:38-40">Maako 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Iino bantu boonse nibalikuswiilizya, Jesu wakaambila basikwiiya bakwe kuteeti, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Amucenjele, mutabaanga mbamayi bo Mulawo, bayandisya kuzyungaana kabazwete majansi malamfu okulumelesigwa elikute mumisika okukala azibbula zyobulemu muzikombelo omumikiti. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Beenena bamukabafu okubanyanga maanda aabo, ape bayanda kulibonesya kubantu kwiinda mukukomba kwabo kulamfu. Cisubulo cabo cinoindilide!”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Mulumbo wo Mukamufu</para>
  <para style="r">(<ref loc="MRK 12:41-44">Maako 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Jesu abasikwiiya bakwe nibali mulabba lye Ngʼanda ya Leza, wakalanga-langa okubona bavubi kababika zipego zyabo mucibikilo camali. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Ape wakabona mukamufu mupenzi awe kabika tudibilisi tobile tomukuba. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Jesu wakateeti, “Nconzyo ndimwaambila kuteeti, ooyu mukamufu mupenzi wapa kwiinda boonse, <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />kaambo bamwi aaba boonse bapa zipego zyabo kuzwa mubuvubi bwabo bunji. Kono we obupenzi bwakwe, wapa tudibilisi toonse twaajesi tokuponena fateni.”<verse eid="LUK 21:4" /></para>
  <para style="s">Jesu Waamba Zyokukolomonwa kwe Ngʼanda ya Leza</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mateyo 24:1-2</ref>; <ref loc="MRK 13:1-2">Maako 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Iino bamwi basikwiiya ba Jesu balikwamboola mbuli mbuyalikuboneka Ngʼanda ya Leza amabwe mabotu akabelesigwa kwiiyaka ape ezipo zyali kupegwa kuli Leza kwiibotya. Kono Jesu wakateeti, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Iyoosika nako yokuteeti zyoonse eezi zintu zemubwene ziyookolomonwa. Takukabi naanga bbwe lyomwi litikasyaale polyeelede kuba.”<verse eid="LUK 21:6" /></para>
  <para style="s">Mapenzi amakatazyo</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mateyo 24:3-14</ref>; <ref loc="MRK 13:3-13">Maako 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Mpoonyina basikwiiya bakabuzya Jesu kuteeti, “Omwiiyi, ino ziyoocitika lili eezi? Ape citondezyo nzi citakacitike kutondezya kuteeti ciindi casika cokuteeti eezi zintu zicitike?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Amane Jesu wakateeti, “Amucenjele, kuteeti kutabi muntu umweena kaambo bantu banji bayooza muzina lyangu kabateeti, ‘Ndendime nguwe!’ Ape, ‘Nako yasika!’ Kono mutakabacilili. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Mutayoowi mwamvwa nkondo okubukilana kaambo eezi zyeelede kutalikila kucitika, kono tazyambi kuteeti mamanino alaafwiifwi loko.”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Jesu wakazwidaanembo okuteeti, “Zisi ziyobukilana, bwami buyoolwana obwaminyina. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Kuyooba kuzungaana kwenyika kuyoosya, enzala mpati, amalwazi atabukila muzibaka zisiyene-siyene ape kuyooba ziyoosya okukomosya kuzwa kujulu. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Kono kazitana citika zyoonse eezi, muyaangwa okupenzegwa, muyootolwa kuyoozekisigwa muzikombelo okubikwa muntolongo ape muyeetwa kunembo lya bami okubeendelezi kaambo kangu. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Eeyi iyooba nako yenu yokuba bakamboni bangu. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" /><note caller="-" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">Luka 12:11-12</ref>.</char></note> Amuliibe ape mutalibambili mbomutakalikwabilile nako kaitana sika, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />kaambo ndiyoomupa majwi o busongo cokuteeti taakwe naanga womwi sinkondonyoko uyoozikaka na kuzikazya eezyo zyemutikaambe. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Muciindi eeco, naanga bazyali benu abazyalwanyoko amabbululu ape abeenzinyoko bayoomwaaba. Bamwi benu mane bayojaigwa. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Boonse bayoomuzonda kaambo kangu. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Kono taakwe susu naanga lyomwi liyoosweeka kuzwa mumitwe yenu. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Amujatisye cokuzyandamana, mpoonyina muyoojana buumi butamani.<verse eid="LUK 21:19" /></para>
  <para style="s">Jesu Waamba Zyokukolomonwa kwa Jelusalemu</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mateyo 24:15-21</ref>; <ref loc="MRK 13:14-19">Maako 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Mwaakubona Jelusalemu yazingulukwa abasilumamba, mukazibe kuteeti nako yokukolomonwa kwayo yaswena afwiifwi. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Mpoonyina balimu Judiya abacijile mumalundu, ape aabo balimutaindi abazwe mwateni, mpoonyina aabo balimumiinzi batainki mutaindi, <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" /><note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">Hosia 9:7</ref>.</char></note> kaambo aaya ngangawo mazuba ecisubulo azuzilikizya zyoonse Malembo zyaamba. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Maawe kulaabo banakazi bamisi akulaabo banyonsya mumazuba aayo. Nyika eeyi iyoosikilwa amapenzi ayoosya ayoozidaamwi obukali bwa Leza kubantu aaba. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Mpoonyina bamwi bayoojaigwa amasabule, ape bamwi bayootolwa mubuzike kuzisi zyoonse. Kumane Jelusalemu uyoolyatookwa abamasi mane kusikila nako yabamasi ikainde.<verse eid="LUK 21:24" /></para>
  <para style="s">Kuza ko Mwanoo Muntu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mateyo 24:29-31</ref>; <ref loc="MRK 13:24-27">Maako 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:25 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">Izaya 13:10</ref>; <ref loc="EZK 32:7">Ezekelo 32:7</ref>; <ref loc="JOL 2:31">Joeli 2:31</ref>; <ref loc="REV 6:12-13">Ciyubunuzyo 6:12-13</ref>.</char>
    </note> “Kuyooba zitondezyo zikomosya ku zuba, ku mwezi, oku nyenyezi. Mpoonyinaano ansi kuyooba kuyoowa okulyangana loko muzisi zyoonse kaambo kokuvuuma ko lwizi amayuwe mapati. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Bantu bayooyumimina kaambo kokuyoowa banoolindila citikasike munyika yoonse kaambo nguzu zilimumulenga-lenga ziyoozungaanisigwa. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" /><note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Danyele 7:13</ref>; <ref loc="REV 1:7">Ciyubunuzyo 1:7</ref>.</char></note> Mpoonyina bayoobona Mwanoo Muntu keza mumayoba enguzu zipati obulemu. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Iino eezi zintu zyaakutalika kucitika, mukanyamuke obusicamba kaambo lwaangunuko lwenu lulaafwiifwi.”<verse eid="LUK 21:28" /></para>
  <para style="s">Ciiyo Cecisamu Comukuyu</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mateyo 24:32-35</ref>; <ref loc="MRK 13:28-31">Maako 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Mpoonyina Jesu wakabaambila cikozyanyo eeci, “Amuyeeye mukuyu emisamu yoonse imwi. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Nako nemubona maani atalika kusyuuka mulaziba kuteeti mainza alaafwiifwi. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Munzila iswana eeci, mwazoobona zintu eezi kazicitika, muzoozibe kuteeti Bwami bwa Leza bulaafwiifwi.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Nconzyo ndimwaambila kuteeti zyoonse eezi ziyoocitika bamwi bantu besunu kabatana kufwa. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Julu enyika ziyoomana kono majwi aangu taayoomani.<verse eid="LUK 21:33" /></para>
  <para style="s">Amumamele</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Amukale kamulibambilide! Mutayandisisyi mikiti okunywa makoko okubilaila zyoobuumi oobu, buyo-buyo buzuba oobo buyoomujanikizya kamutalibambilide, mboonyina mbuli kakole mbokaca. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Oobo buzuba buyooza ciyusu-yusu kubantu boonse bapona munyika. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Kamumamela okukomba nako yoonse kuteegwa mubeenguzu zyokwiinda kabotu-kabotu muzintu eezyo ziyoocitika okuyoima kunembo lyo Mwanoo Muntu.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:37 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">Luka 19:47</ref>.</char>
    </note> Buzuba obuzuba walikwiinka kuyoiisya mulabba lye Ngʼanda ya Leza mpoonyina kujolezya walikuzwaanga okwiinka kucilundu ca Oliva kwaalikubucesezya. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Bantu boonse balikumufumina kuyomuswiilizya mulabba lye Ngʼanda ya Leza.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Makanze Ookujaya Jesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateyo 26:1-5</ref>; <ref loc="MRK 14:1-2">Maako 14:1-2</ref>; <ref loc="JHN 11:45-53">Joni 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Kulonga 12:1-27</ref>.</char>
    </note> Nako Yomukiti Wecinkwa citakwe Mumena uteegwa Pasika<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="ft" closed="false">Muciindi Luka naalikulemba, Mukiti Wecinkwa Citakwe Mumena e Pasika zyakali kulanganisigwa kuteeti mukiti omwi. Mikiti eeyi, yakali kuyeezya ba Majuda nako Leza naakagwisya basikale babo kuzwa mubuzike mu Ijipiti. (Kulonga 12:1-27).</char></note> calaafwiifwi. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Bapaizi basilutwe abamayi bo Mulawo balikuyandoola nzila yo kujaila Jesu cokusisilikizya kaambo kokuyoowa bantu.<verse eid="LUK 22:2" /></para>
  <para style="s">Judasi Wazumina Kwaaba Jesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mateyo 26:14-16</ref>; <ref loc="MRK 14:10-11">Maako 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Mpoonyina Satani wakanjila Judasi uuteegwa Isikaliyoti, umwi wabasikwiiya bali kumi abobile. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Mpoonyina Judasi wakainka kuyaamboozyanya abapaizi basilutwe abolupati-pati babalindizi be Ngʼanda ya Leza mbwataabe Jesu kulibo. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Naakaamba namu, bakabotelwa loko mane bakamusyomezya kumubbadela mali. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Judasi wakazumina, mpoonyina wakatalika kuyandoola nako mbotu yokwaaba Jesu kulibo bantu kabatezi.<verse eid="LUK 22:6" /></para>
  <para style="s">Kulibambila kulya Mukiti we Pasika</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mateyo 26:17-25</ref>; <ref loc="MRK 14:12-21">Maako 14:12-21</ref>; <ref loc="JHN 13:21-30">Joni 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Muciindi Comukiti we cinkwa Citakwe Mumena buzuba bwakasika mbelele zyokulya a Pasika nizyalikujaigwa. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Jesu wakatuma Pita o Joni kuteeti, “Kamuya mukatubambile cilalilo cesu ce Pasika.”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Mpoonyina bakabuzya Jesu kuteeti, “Kokuli koyanda kuteeti tukacibambile?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Wakabataba kuteeti, “Amumvwe! Mwanoonjila mu Jelusalemu, muyooswaanwa omwaalumi uyumwine nongo mpati yamaanzi. Mumucilile omo mungʼanda mwatikanjiile. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Mpoonyina mukaambile mukamwini ngʼanda kuteeti, ‘Mwiiyi wesu ukubuzya kuteeti, moomuli monditilide Pasika abasikwiiya bangu?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Mpoonyina ulamutondezya ngʼanda mpati ilimujulu ibambidwe kabotu loko. Mukatubambilile mwateni zyokulya.”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Mpoonyina bakainka okujana zyoonse zili mbuli mbwakaamba Jesu. Kumane bakabamba zyokulya zye Pasika.<verse eid="LUK 22:13" /></para>
  <para style="s">Mulalilo wo Mwami</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mateyo 26:26-30</ref>; <ref loc="MRK 14:22-26">Maako 14:22-26</ref>; <ref loc="1CO 11:23-25">1 Bakolinto 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Nako niyakasika yokulya Pasika Jesu wakakala mucibaka cakwe atafule abaapositola. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Mpoonyina wakabaambila kuteeti, “Ndalikuyandisisya loko kulya cilalilo eeci ce Pasika andinywe kanditana kunjila mumapenzi, <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />kaambo ndimwaambila kuteeti, sikoyoocilya ape mane kusikila cikazuzikizigwe mu Bwami bwa Leza.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Mpoonyina Jesu wakabweza nkomoki, wakalumba Leza, okwaambila basikwiiya bakwe kuteeti, “Amubweze eeci, mwaabane mulicenu. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Ndimwaambila kuteeti, kuzwa sunu siyounwi ape musinza womunsaansa, kusikila mane Bwami bwa Leza bukasike.”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Mpoonyina wakabweza cinkwa, wakalumba Leza, wakacikomoona okucipa basikwiiya bakwe kateeti, “Ooyu mubili wangu, wapegwa kaambo kandinywe. Kamucita namu mukundiyeeya.” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" /><note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jelemiya 31:31-34</ref>.</char></note> Munzila iswana, niwakamana mulalilo wakabapa nkomoki kateeti, “Eeyi nkomoki cecizuminano cipya ca Leza cidiisigwa egazi lyangu, lyatika kaambo kandinywe.<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:21 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:9">Intembauzyo 41:9</ref>.</char>
    </note> “Kono, amulange! Ooyo uundaaba ulimukulya andime awa atafule! <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Nconzyo, Mwanoo Muntu uyoofwa mbuli mbwakaciyanda Leza, kono maawe kulooyo mwaalumi uumwaaba!”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Mpoonyina basikwiiya bakatalika kubuzyanya mulicabo na ngwani aalimbabo uunga wacita cilinamu.<verse eid="LUK 22:23" /></para>
  <para style="s">Ngwani Mupati Kwiinda Bamwi</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:1">Mateyo 18:1</ref>; <ref loc="MRK 9:34">Maako 9:34</ref>; <ref loc="LUK 9:46">Luka 9:46</ref>.</char>
    </note>Iino kwakabuka kukazyanya akati kabasikwiiya kokuteeti na ngwani weleede kuba mupati akati kabo. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Mpoonyina Jesu wakabaambila kuteeti, “Bamami babamasi balela bantu cokudyaaminina, abo baleli bayanda kwaambwa kuteeti, ‘Mbaasikugwasya bantu.’ <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" /><note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mateyo 23:11</ref>; <ref loc="MRK 9:35">Maako 9:35</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">Mateyo 20:25-27</ref>; <ref loc="MRK 10:42-44">Maako 10:42-44</ref>.</char></note> Kono eeci taceelede kuba namu kulinywebo. Ooyo mupati akati kenu abe mbuli muniini loko ape mweendelezi mbuli mubelesi. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" /><note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="JHN 13:12-15">Joni 13:12-15</ref>.</char></note> Ino ngwani mupati kwiinda, ooyo ukalaansi kulya na ooyo ubeleka? Nconzyo ngooyo ukalaansi. Kono mebo ndili akati kenu mbulooyo ubeleka.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />“Mwakala amebo mumasunko aangu oonse. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Iino ndimupa nguzu zyobwami, mboonyina mbuli Tata mbwaakandipa. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" /><note caller="-" style="x"><char style="xo" closed="false">22:30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mateyo 19:28</ref>.</char></note> Muyoolya okunywa atafule lyangu mu Bwami bwangu, ape muyookala azibbula zyobwami okulela misyobo ya Izilaili iili kumi ayobile.”<verse eid="LUK 22:30" /></para>
  <para style="s">Jesu Waamba Zyokukakwa o Pita</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateyo 26:31-35</ref>; <ref loc="MRK 14:27-31">Maako 14:27-31</ref>; <ref loc="JHN 13:36-38">Joni 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Jesu wakaambila Saimoni kuteeti, “Saimoni, Saimoni! Swiilizya! Saatani wazumizigwa kuteeti amusunke noonse, kwanzaanya zibotu kuzwa kuzibi mbuli mulimi mbwavulula buungululwa kuzwa kumaila. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Kono ndakukombela Saimoni kuteegwa lusyomo lwako lutamani. Ape wakupiluka kulindime weelede kuyumya bazyalwanyoko.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Pita wakataba kuteeti, “Mwami, ndililibambilide kwiinka kuntolongo naanga kufwa ayibo!”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Jesu wakateeti, “Pita ndikwaambile, muzingili takookukuluka masiku aano kusikila ukake ziindi zyotatwe kuteeti tondizi.”<verse eid="LUK 22:34" /></para>
  <para style="s">Cikwama, Cibbeeki a Sabule</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:9-10">Mateyo 10:9-10</ref>; <ref loc="MRK 6:8-9">Maako 6:8-9</ref>; <ref loc="LUK 9:3">Luka 9:3</ref>; <ref loc="LUK 10:4">10:4</ref>.</char>
    </note> Mpoonyina Jesu wakabuzya basikwiiya bakwe kuteeti, “Nindakamutuma kamutakwe cikwama, nkomo, amakatulu amwi, mwakaakubula cintu na?”</para>
  <para style="p" vid="LUK 22:35">Bakateeti, “Taakwe naanga comwi ncitwakabula.”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Jesu wakateeti, “Kono iino<note caller="+" style="f"><char style="fr" closed="false">22:36 </char><char style="ft" closed="false">Jesu naakatuma basikwiiya kusaanguna (Luka 9:1-6; 10:1-16), bantu bakabatambula mumaanda aabo okuswiilizya makani aabo aa Jesu. Iino Jesu bayoomulanganya mbuli cigebenga ape bayoopenzya basikwiiya bakwe. </char></note>, kufumbwa ujesi cikwama naanga cibbeeki weleede kucibweza ape kufumbwa utajesi sabule weelede kuuzya jansi lyakwe kuteegwa aule lyomwi. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" /><note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Izaya 53:12</ref>.</char></note> Amucite namu kaambo Malembo aamba kuteeti, ‘Wakabalilizigwa abasikutyola Mulawo’ eelede kuzuzikizigwa mulindime kaambo eeco cakalembwa kujatikizya ndime caba afwiifwi okucitika.”<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Basikwiiya bakateeti, “Bona! Mwami, ngaaya masabule obile!”</para>
  <para style="p" vid="LUK 22:38">Jesu wakateeti, “Mbubo, kwamana ankani eeyi.”<verse eid="LUK 22:38" /></para>
  <para style="s">Jesu Wakomba Acilundu ca Oliva</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mateyo 26:36-46</ref>; <ref loc="MRK 14:32-42">Maako 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Mpoonyina Jesu wakazwa mutaindi okwiinka kucilundu camisamu ye Oliva mbuli cilengwa cakwe, abo basikwiiya bakainka awe. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Naakasika acibaka eeco wakateeti kulibo, “Amukombe kuteegwa mutawidi mumasunko.”<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Mpoonyina wakabasiya, wakainka aleele aniini, aawo wakaakufugama okukomba. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />Wakateeti, “Tata, na ulayanda gwisya nkomokeeyi yamapenzi alimebo. Nikuba namu kutabi kuyanda kwangu nee, kono lucitwe luyando lwako.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Kwakalibonya mungelo kulinguwe kuzwa kujulu okumuyumya-yumya. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Mukupenga kupati komoyo, wakakombesya cenguzu cokuteeti nkasaalo yakwe yali mbuli madosi egazi alikulokelaansi.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Naakanyamuka kuzwa mpaali kukombela wakapiluka okujana basikwiiya baloona. Bakalikatede kaambo myoyo yabo yakatyompya. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Mpoonyina wakabaambila kuteeti, “Kaambo nzi comoona? Amubuke, mukombe kuteegwa mutawidi mumasunko.”<verse eid="LUK 22:46" /></para>
  <para style="s">Kwaangwa kwa Jesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateyo 26:47-56</ref>; <ref loc="MRK 14:43-50">Maako 14:43-50</ref>; <ref loc="JHN 18:3-11">Joni 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Jesu naacili kwaamboola kwakasika mbunga yabantu yakasololedwe o Judasi umwi wabasikwiiya bakwe bali kumi abobile. Wakasika kuli Jesu okumumyonta. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Kono Jesu wakateeti, “Judasi, ino wazaaba Mwanoo Muntu kwiinda mukumumyonta na?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Mpoonyina basikwiiya bali o Jesu nibakabona calikuyanda kucitika, bakabuzya kuteeti, “Mwami, tubelesye masabuleesu na?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Mpoonyina umwi wabo wakatema muzike wo Mupaizi mupati okumutimbula kutwi kokululyo.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Kono Jesu wakateeti, “Kwamana! Amuleke!” Kumane wakajata kutwi kooyo muzike, okumuponya.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Mumbunga yazide mukujata Jesu mwali bapaizi basilutwe, abolupati-pati babalindizi be Ngʼanda ya Leza, abamaalu. Mpoonyina Jesu wakateeti kulimbabo, “Ino muzidaanzi amasabule a makoli mbulikuteeti mwaza kuzojata cigebenga? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" /><note caller="-" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luka 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note> Ede ndali anywebo buzuba obuzuba mulabba lye Ngʼanda ya Leza, kono taakwe nimwakasola kundijata. Kono eeci ceciindi cenu ape ceciindi cenguzu zyomumudima.”<verse eid="LUK 22:53" /></para>
  <para style="s">Pita Wakaka Jesu</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mateyo 26:57-58</ref>, <ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Maako 14:53-54</ref>, <ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Joni 18:12-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Kuzwaawo bakaanga Jesu okumutola mungʼanda yo Mupaizi Mupati. Kono Pita walikuyoobucilila aleele. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Kwabbikidwe mulilo akati kelabba, mpoonyina Pita wakaakukala aabo balikuyota mulilo. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Umwi mwanakazi mubelesi naakamubona kakede aawo amulilo, wakamulangisisya okwaamba kuteeti, “Ooyu mwaalumi awe waloo Jesu!”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Kono Pita wakakazya kateeti, “Yebo mwanakazi, tandimwizi okumuziba ooyo!”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Nikwakainda kaindi kaniini feela, mwaalumi umwi wakamuziba Pita okuteeti kulinguwe, “Ayebo uli umwi wabo!”</para>
  <para style="p" vid="LUK 22:58">Kono Pita wakataba kuteeti, “Mwaalumi! Nee tandiinsi!”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Ape nikwakainda woola lyomwi umwi mwaalumi wakaamba cokusinizya wateeti, “Taakwe okuzumboozya ooyu mwaalumi walaawe, kaambo awe muna Galileya!”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Kono Pita wakataba kuteeti, “Mwaalumi, tandizi zyolimukwaamboola!”</para>
  <para style="p" vid="LUK 22:60">Mpoonya-mpoonya naacilikwaamboola muzingili wakakukuluka. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Mpoonyinaawo Mwami wakacebuka okumulangisisya Pita, mpoonyina Pita wakayeeya Mwami zyakamwaambilide kuteeti, “Muzingili kautana kukukuluka masiku aano, uyoondikaka ziindi zyotatwe kuteeti, tondizi.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Pita wakazwidaanze elabba okuyoolila colufu.<verse eid="LUK 22:62" /></para>
  <para style="s">Jesu Wafubaazikwa Okuumwa</para>
  <para style="r">(<ref loc="MAT 26:67-68">Mateyo 26:67-68</ref>; <ref loc="MRK 14:65">Maako 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Iino balindizi bali kulindilila Jesu, bakatalika kumufubazika okumuuma. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Bakamuvumba kumenso okunoomubuzya kuteeti, “Ino ngwani wakuuma? Sinsima!” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Ape bakaamba zintu zimwi zinji zyokumutukila.<verse eid="LUK 22:65" /></para>
  <para style="s">Jesu Weetwa Anembo lye Nkuta</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mateyo 26:59-66</ref>; <ref loc="MRK 14:55-64">Maako 14:55-64</ref>; <ref loc="JHN 18:19-24">Joni 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Nibwakaca, Benkuta Mpati yabamaalu ba Majuda bakabungana antoomwi, aaba bali bapaizi basilutwe a bamayi bo Mulawo. Mpoonyina Jesu wakeetwa kunkuta yabo. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Kuzwaawo bakamubuzya kuteeti, “Twaambile! Ndiwe Mesiya na?”</para>
  <para style="p" vid="LUK 22:67">Wakataba kuteeti, “Ndamwaambila tamukondisyoma <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />ape ndamubuzya mubuzyo tamukonditaba. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Kono kuzwa iino Mwanoo Muntu uyookala kululyo lwa Leza Singuzu zyoonse.”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Mpoonyina boonse bakateeti, “Kokuteeti uli Mwanaa Leza na?”</para>
  <para style="p" vid="LUK 22:70">Wakabataba kateeti, “Iiyi, mwaamba kuteeti ndime nguwe”.<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Mpoonyina bakateeti, “Tatuciyandi bambi bakamboni! Ede twalimvwida tobeni zyaamba omulomo wakwe mwini!”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Jesu Watolwa kunembo lya Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mateyo 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Maako 15:1-5</ref>; <ref loc="JHN 18:28-38">Joni 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Mpoonyina benkuta boonse bakanyamuka okutola Jesu kunembo lya mweendelezi Pilato. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Bakatalika kumutamizya kuteeti, “Ooyu mwaalumi twamujana kayunga bantu besu, walikubaambila kuteeti batanotela mutelo kuli Kaisala ape walikulyaamba kuteeti ngonguwe Mesiya, Mwami.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Mpoonyina Pilato wakabuzya Jesu kuteeti “Ino yebo ndendiwe mwami wama Juda na?”</para>
  <para style="p" vid="LUK 23:3">Wakamutaba kuteeti, “Waamba.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Amane Pilato wakaambila bapaizi basilutwe amabunga abantu kuteeti, “Tandijene mulandu mulooyu mwaalumi.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Kono nibakazumanana loko kuteeti, “Uyunga bantu eziisyo zyakwe Judiya yoonse. Wakatalikila mu Galileya mpoonyineeno weza kuno.”<verse eid="LUK 23:5" /></para>
  <para style="s">Jesu Watolwa kunembo lya Helodi</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Pilato naakamvwa namu wakabuzya kuteeti, “Ino ooyu mwaalumi muna Galileya na?” <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Nibakaamba kuteeti Jesu walikuzwa kucooko ca Galileya Helodi kwaali kulela, wakamutumina kuli Helodi kaambo anguwe wali mu Jelusalemu aleeyo nako. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Helodi wakabotelwa loko naakabona Jesu, kaambo walikuzimvwaanga zyakwe, ape kweciindi cilamfu walikuyanda kubona Jesu kacita zimwi zitondezyo zyamaleele. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Mpoonyina Helodi wakabuzya Jesu mibuzyo minji, kono Jesu taakwe naakataba. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Kuzwaawo bapaizi basilutwe abamayi bo Mulawo bakaswena afwiifwi okutalika kutamikizya Jesu loko. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Mpoonyina Helodi abasilumamba bakwe bakapenzya Jesu okumufubaazika, mpoonyina bakamuzwaatika cizwaato cobwami okumupilusya kuli Pilato. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Mboonyina oobo buzuba, Helodi o Pilato bakatalika kumvwana, nekuba kuteeti kusule balizondene.<verse eid="LUK 23:12" /></para>
  <para style="s">Jesu Waatulwa kuteeti Ajaigwe</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mateyo 27:15-26</ref>; <ref loc="MRK 15:6-15">Maako 15:6-15</ref>; <ref loc="JHN 18:39-19:16">Joni 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Kuzwaawo Pilato wakaita antoomwi bapaizi basilutwe, basololi abantu, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />okubaambila kuteeti, “Mweeta ooyu mwaalumi kulindime, okwaamba kuteeti walikuyunga bantu. Kono amumvwisisisye, ndamubuzya-buzya mumenso eenu, taakwe mulandu ngundamujanina kuli zyoonse zimulimukumutamikizya. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Naanga Helodi taakwe mulandu ngwaamujanina, caamupilusizya kuno kulindiswe. Calitondezya kuteeti taakwe caabisya kuteegwa ajaigwe. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Ndilamukwabboozya feela okumuleka ainke.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />[Lyoonse aciindi cokusekelela Pasika, mweendelezi walikweelede kubalukulwida mwaange.]<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Bunji bwamalembo taajesi kancali aaka.</char></note><verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Bantu boonse bakoongolweda antoomwi kuteeti, “Ajaigwe! Tulukulwide Bbalabbasi!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Ooyo Bbalabbasi waangilidwe manyongwe akacitikide mutaindi pati ape okujaya muntu.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Mpoonyina Pilato wakamboozyanya abo ape kaambo walikuyanda kulukulula Jesu. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Kono bakaindilizya koongolola kuteeti, “Akankaminwe aciingano! Akankaminwe aciingano!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Mpoonyina Pilato wakabuzya katatu kuteeti, “Ino? Wacita mulandu nzi? Taakwe mulandu ngundajana wokuteeti mane ajaigwe! Iino ndilamukwabboozya feela okumulukulula.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Kono bakazumanana koongolola kuteeti, “Aakankaminwe!” Mpoonyina kumamanino majwaabo akazunda. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Mpoonyina Pilato wakaatula Jesu bwaatuzi mbubalikuyanda bantu. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Wakalukulula Bbalabbasi ngubalikuyanda, ooyo waangilidwe manyongwe ape okujaya muntu. Mpoonyina wakabapa Jesu kuteegwa bamucite mbobayanda.<verse eid="LUK 23:25" /></para>
  <para style="s">Jesu Wakankaminwa Aciingano</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateyo 27:32-44</ref>; <ref loc="MRK 15:21-32">Maako 15:21-32</ref>; <ref loc="JHN 19:17-27">Joni 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Mpoonyina basilumamba bakatola Jesu. Nibalikuyoobuya, bakaswaana mwaalumi woku Sailini walikwiitwa kuteeti Saimoni walikuzwa kumiinzi kayoobuya mutaindi. Bakamujata okumubika ciingano amaheta okumunyamuzya cico musule lya Jesu.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Bbunga lyabantu lyakacilila musule, akati kabo kwali bamwi banakazi balikuyoobumulila. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Mpoonyina Jesu wakabacebuka okubaambila kuteeti, “Nobanakazi bomu Jelusalemu! Mutalili ndime, kono mulilile lwenu abana benu, <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />kaambo mazuba ayoosika bantu nebatikaambe kuteeti, ‘Balilelekedwe banakazi batakwe bana, batakazyala okunyonsya!’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" /><note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hosia 10:8</ref>; <ref loc="REV 6:16">Ciyubunuzyo 6:16</ref>.</char></note> Eeco ceciindi bantu nebayoambila malundu kuteeti, ‘Tuwide!’ Okwaambila tulundu keteeti, ‘Tuvumbe!’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Nakuteeti bacita zintu zilinamu kucisamu cicili citetete, ino niinzi ciyoocitika kucisamu ciyumu?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Iino kwali ezigebenga zyobile zyakatolelezegwa kuteeti zikajaigwe antoomwi o Jesu. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Mpoonyina nibakasika acibaka ciitwa kuteeti “Kapapa komutwe” bakakankamina Jesu aciingano ezigebenga zyobile, comwi kululyo lwakwe cimbi kucigoyo cakwe. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" /><note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Intembauzyo 22:18</ref>.</char></note> Kuzwaawo Jesu wakateeti, “Tata bajatile kaambo tabazi zyebalimukucita!”</para>
  <para style="p" vid="LUK 23:34">Mpoonyina basilumamba bakaabana zizwaato zyakwe kwiinda mukuuma cisolo. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" /><note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Intembauzyo 22:7</ref>.</char></note> Bantu baliimvwi ooko kabeebela kumwi basololeli beci Juda kabamufubazika kuteeti, “Wakafutula bamwi, alifutule anguwe nakuteeti ngo Mesiya ngwaakasala Leza!”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:36 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:21">Intembauzyo 69:21</ref>.</char>
    </note> Abo basilumamba bakamufubaazika Jesu kwiinda mukumuswenena okumupa waini upapa, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />okumwaambila kuteeti, “Na uli mwami wama Juda, lifutule!”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Atala omutwe wakwe kwalee cikwankwani calembedwe kuteeti, “Ooyu ngo Mwami wama Juda.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Mpoonyina umwi we zigebenga zyakankaminidwe aciingano wakatuka Jesu kateeti, “Tolindiwe Mesiya na? Lifutule antoomwi aswebo!”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Kono oyuumwi wakamunyemena kateeti, “Toyoowi Leza na? Tobwene kuteeti watambula cisubulo comwi anguwe. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Swebo twaatulwa kabotu kaambo tuleelela kufwida zyotwakacita. Kono we ooyu mwaalumi taakwe cibi caacita.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Kuzwaawo wakateeti, “Jesu, ukandiyeeye waakutalika kulela mu Bwami bwako!”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Mpoonyina Jesu wakamutaba kuteeti, “Ndikusyomezya kuteeti sunu unolaamebo mu Paladaizi<note caller="+" style="f"><char style="fr" closed="false">23:43 </char><char style="ft" closed="false">Ibbala eeli ndyeci Hibbulu likonzya kwaamba muunda mubotu uujesi misamu minji ye micelo iiligwa. Mumizeezo yeci Juda, Paladaizi cakali cibaka cokupumwida kulindila kubuka kuzwa kubafu, kutali cibaka camamanino kuzwa lufu. </char></note>.”<verse eid="LUK 23:43" /></para>
  <para style="s">Lufu lwa Jesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateyo 27:45-56</ref>; <ref loc="MRK 15:33-41">Maako 15:33-41</ref>; <ref loc="JHN 19:28-30">Joni 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:44-45 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 26:31-33">Kulonga 26:31-33</ref>.</char>
    </note> Nako yesikati, zuba nilyali kale akati kwakaba mudima nyika yoonse kwamawoola otatwe kaambo zuba lyakaleka kumunika. Mpoonyina sila lyo mu Ngʼanda ya Leza lyakayauka akati. <verse eid="LUK 23:44-45" /><verse number="46" style="v" sid="LUK 23:46" /><note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">Intembauzyo 31:5</ref>.</char></note> Mpoonyina Jesu wakoongolola kuteeti, “Tata! Ndibika muuya wangu mumanzaako!” Wakaamba namu okufwa.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Iino umwi mupati wabasilumamba beci Loma naakabona cakacitika wakalumbaizya Leza okuteeti, “Nconzyo mwaalumi ooyu waliluleme!”<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />Boonse bantu bakabungene kuzeeba kukankaminwa kwa Jesu nibakabona cakacitika bakapiluka kumaanda aabo, kabayoobulyuuma-uma azyamba kutondezya kuusa. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" /><note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luka 8:2-3</ref>.</char></note> Kono beenzinyina ba Jesu antoomwi abanakazi balikuyobumucilila kuzwa ku Galileya, baimvwi aleele kabeebela.<verse eid="LUK 23:49" /></para>
  <para style="s">Kuzikwa kwa Jesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateyo 27:57-61</ref>; <ref loc="MRK 15:42-47">Maako 15:42-47</ref>; <ref loc="JHN 19:38-42">Joni 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51" />Iino kwali mwaalumi walikwiitwa kuteeti Josefa walikuzwa mutaindi liitwa kuteeti Alimatiya mu Judiya. Wali mwaalumi walikabotu okululama, walikulindilila kuza ko Bwami bwa Leza. Nekuba kuteeti wali waabo Benkuta Mpati ya Majuda taali kweendelana emizeezo emicito yabo. <verse eid="LUK 23:50-51" /><verse number="52" style="v" sid="LUK 23:52" />Wakainka kuli Pilato, okuyookumbila mutunta wa Jesu kuteeti akuuzike. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Naakazumizigwa, wakuuselusya mutunta okuuvungaila musila okuubika mumpangala yakasidwe mubbwe pati loko yatalina kuzikilwa muntu. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Bwali buzuba bokulibambila ape e Nsabata<note caller="+" style="f"><char style="fr" closed="false">23:54 </char><char style="ft" closed="false">Kweendelana omulawo weci Juda, bantu taakwe nibalikuzumizigwa kweenzya mutunta mubuzuba bwe Nsabata. Mpoonyina Josefa wakafwambaana kuuzika mutunta kalitana bila zuba kiitana talika Nsabata. </char></note> yalaafwiifwi okutalika.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Banakazi balikucilila Jesu kuzwa ku Galileya bakainka o Josefa, mpoonyina bakacibona cuumbwe omubili wa Jesu mbuwakabikwa. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" /><note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">Kulonga 20:10</ref>; <ref loc="DEU 5:14">Detilonomo 5:14</ref>.</char></note> Mpoonyina bakapiluka ku Jelusalemu okuyoobamba mafuta anunkilila okuteeti bazonanike mutunta wa Jesu. Kono mu Nsabata bakapumuna kweelana omulawo.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Jesu Muumi</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mateyo 28:1-10</ref>; <ref loc="MRK 16:1-8">Maako 16:1-8</ref>; <ref loc="JHN 20:1-10">Joni 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Mujunzoonza loko lye Nsunda, banakazi bakainka ku cuumbwe ca Jesu, kabayumwide mafuta anunkilila ngibakabambide. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Bakajana bbwe lyakajalisidwe acuumbwe lyakunkulisigwa kuzwa amulyango,<figure style="fig" alt="Tomb with stone cover" file="wa03929b.tif" size="col" loc="24:1-24:12" ref="24:2">Cuumbwe cijesi cijazyo cebbwe</figure> <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />mpoonyina bakanjila mucuumbwe kono taakwe nibakaujana mutunta wo Mwami Jesu. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Bakaima fateni kabakatazidwe kaambo keeci. Mpoonya-mpoonya bakabona baalumi bobile bazweete zizwaato zimweka, kabaimvwi kumbali lyabo. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Aaba banakazi kabayoowede loko bakalanga ansi okukotama. Mpoonyina bamaalumi bakabuzya kuteeti, “Niinzi nimuyandoola muumi akati kabafu? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" /><note caller="-" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mateyo 16:21</ref>; <ref loc="MAT 17:22-23">17:22-23</ref>; <ref loc="MAT 20:18-19">20:18-19</ref>; <ref loc="MRK 8:31">Maako 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luka 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note> Tawo kuno, wabusigwa kuzwa kubafu. Amuyeeye zyaakamwaambila naacili mu Galileya zyokuteeti, <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />‘Mwanoo Muntu weelede kwaabwa kuli basizibi, okukankaminwa aciingano okubuka mubuzuba bwatatu.’”<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Mpoonyina banakazi bakaayeya majwaakwe, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />bakazwa kucuumbwe okupiluka, okuyaambila basikwiiya bali kumi aomwi abamwi boonse zyoonse zyakacitika. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Aabo banakazi bali ba Maliya Magadalena, Johana o Maliya banyina Jemusi, bo abamwi banakazi mbibalaabo, bakaambila baapositola eezi zintu. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Kono baapositola taakwe nibakasyoma, kaambo bakayeeya kuteeti zyobakaamba banakazi zyobufuba-fuba. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Kono Pita wakanyamuka okuzuzila ku cuumbwe. Naakasika wakakotama okubona feela sila mwakavungailidwe mutunta kakutakwe cilimwateni. Mpoonyina wakapiluka kungʼanda kakomokidwe zyakacitika.<verse eid="LUK 24:12" /></para>
  <para style="s">Musinzo woku Emasi</para>
  <para style="r">(<ref loc="MRK 16:12-13">Maako 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Mubuzuba oobo mboonyina, basikwiiya bobile balikuyoobuya kumuunzi wiitwa kuteeti Emasi. Kuzwa ku Jelusalemu kuya ku Emasi kakali kasinzo keendwa mawoola obile. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Nibalikuyoobweenda, balikuyoobwaamboozyanya zyoonse zyakacitika. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Nibalikuyoobwaamboozyanya, Jesu lwakwe wakaswena afwiifwi okutalika kweenda abo. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Bakamubona kono taakwe nibakamuziba kuteeti na ngwani. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Mpoonyina Jesu wakababuzya kuteeti, “Ino makani nzi ngomuyobwaamboola nomuyoobweenda?”</para>
  <para style="p" vid="LUK 24:17">Bakaima nji, kabauside ameenso. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Umwi wabo, walikwiitwa kuteeti Kilewopasi wakamubuzya kuteeti, “Ino ndiwe mweenzu olike mu Jelusalemu utezi zyalikucitika kwateni mumazuba maniini ainda?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Mpoonyina Jesu wakabuzya kuteeti, “Zintuunzi eezyo?”</para>
  <para style="p" vid="LUK 24:19">Bakamutaba kuteeti, “Zintu zyakacitika kuli Jesu woku Nazaleta. Ooyu mwaalumi walimusinsimi mupati ape walisinguzu loko muzintu zyaali kwaamba okucita ape walikukutekwa o Leza abantu boonse. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Bapaizi basilutwe abasololi besu bakamwaaba kuteeti akaatulwe kujaigwa. Mpoonyina bakamukankamina aciingano. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Kono twasyomede kuteeti nguutikonzye kulukulula Izilaili! Kutali feela eeci, iino oobu mbuzuba bwatatu kazicitikide eezi. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Mpoonyina ape bamwi banakazi bembunga yesu batukomosya. Kubucedo bainkide kucuumbwe, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />kono taakwe nibaujana mutunta wa Jesu. Bapiluka okwaamba kuteeti babona cilengaano cabangelo babaambila kuteeti Jesu muumi. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Mpoonyina bamwi besu baliinkide kucuumbwe, okuyoojana nconzyo mboonyina mbubaamba banakazi, kono taakwe nibamubona.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Mpoonyina Jesu wakabaambila kuteeti, “Mulibafuba-fuba balibuti, mucedwa buti kusyoma zyoonse basinsimi zibakaamba! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Ino ticalikweelela Mesiya kupenga namu okunjile mubulemu bwakwe na?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Mpoonyina Jesu wakabapandulwida zyalikwaambwa zyakwe mumalembe oonse, kutalikila kumalembe a Mozesi abasinsimi boonse.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Nibakasika afwiifwi omuunzi kubali kwiinka, Jesu wakacita mbuli kuteeti walikwiindilila, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />kono bakamukumbila kabateeti, “Kala aswibo, kaambo zuba lyainka kulazwa kwasiya.” Mpoonyina wakanjila kukalaabo. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Wakakala ansi kuteegwa alyaabo, wakabweza cinkwa okulumba, mpoonyina wakacikomoona okubapa. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Mpoonyinaawo menso aabo akajuka, bakamuziba, kono wakazimaana, taakwe nibakamubona ape. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Mpoonyina bakabuzyanya kuteeti, “Ede kwalimbuli mulilo uuyaka muzyamba zyesu naalikwaamboola aswibo munzila okutupandulwida malembe?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Mpoonyinaawo bakanyamuka okupiluka ku Jelusalemu kubakaakujana basikwiiya bali kumi aomwi kababungene abamwi. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Aaba babungene bakaamba kuteeti, “Nconzyo Mwami wabuka! Wabonekela kuli Saimoni!”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Mpoonyina aaba bobile bakapandulula zyakacitika munzila yo ku Emasi ape ombubakamuziba Mwami naakakomona cinkwa.<verse eid="LUK 24:35" /></para>
  <para style="s">Jesu Walibonya kuli Basikwiiya Bakwe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateyo 28:16-20</ref>; <ref loc="MRK 16:14-18">Maako 16:14-18</ref>; <ref loc="JHN 20:19-23">Joni 20:19-23</ref>; <ref loc="ACT 1:6-8">Misebezi 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Aba bobile nibacili kwaambila beenzinyina makani aaya, Jesu lwakwe wakadunuka akati kabo okubaambila kuteeti, “Luumuno lube andinywe.”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Kono bakatilimuka okuyoowa loko okuyeeya kuteeti mweendi babona saku. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Kono we wakabaambila kuteeti, “Niinzi cimwayoowa namu? Kaamboonzi nimuzumboozya mumyoyo yenu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Amulange maanzaangu ezituta zyangu, kuteegwa musyome kuteeti ndime. Amundijate, mubone kuteeti tandili saku, kaambo masaku taajesi nyama amafuwa mbulindime mbomundibwene mbondizijesi.”<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Naakamana kwaamba namu, wakabatondezya maanzaakwe ezituta zyakwe. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Nekuba namu taakwe nibakasyoma kaambo baliboteledwe loko okukomokwa. Mpoonyina Jesu wakababuzya kuteeti, “Ino mulijesi cokulyaawa na?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Bakamupa cipaanzi censwi iyokedwe, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />wakacitambula okucilya kabalangilide.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Mpoonyina wakabaambila kuteeti, “Eezi zezizyo zindali kumwaambila aalya nindacilaandinywe, kuteeti zyoonse zilembedwe zyaamba ndime mu Mulawo wa Mozesi, omumalembe aabasinsimi, omuntembauzyo, zyeelede kuteeti zizuzikizigwe.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Mpoonyina wakabagwasya kumvwisisisya Malembo caamba, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />okubaambila kuteeti, “Eeci cecilembedwe kuteeti, Mesiya weelede kupenga, kufwa okubuka kuzwa kubafu mubuzuba bwatatu, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />ape muzina lyakwe makani aakweempwa okulekelelwa zibi akambookwe kubantu bemisyobo yoonse, kutalikila mu Jelusalemu. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Nywebo ndinywe bakamboni bezintu eezi. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" /><note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">Misebezi 1:4</ref>.</char></note> Mpoonyina mebo ndiyoomutumina Muuya Uusalala Tata ngwaakasyomezya. Kono mweelede kuteeti kamukede mutaindi pati muno mane kusikila mukatambule nguzu zizwa kujulu.”<verse eid="LUK 24:49" /></para>
  <para style="s">Jesu Watolwa Kujulu</para>
  <para style="r">(<ref loc="MRK 16:19-20">Maako 16:19-20</ref>; <ref loc="ACT 1:9-11">Misebezi 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:50 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Misebezi 1:9-11</ref>.</char>
    </note> Mpoonyina Jesu wakabasolwedela kuzwa mutaindi pati kuya kumuunzi wa Bbeteniya. Nibakaakusika ooko, Jesu wakanyamuna maanzaakwe okubaleleka. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Kacibaleleka namu, wakazwa alimbabo mpoonyina wakatolwa kujulu. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Bo, bakamukomba mpoonyina bakapilukila ku Jelusalemu kababoteledwe loko. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Nako yoonse bali mulabba lye Ngʼanda ya Leza kabalumbaizya Leza.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>