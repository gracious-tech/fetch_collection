<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">OLUKA- ALAGO Bible</book>
  <para style="h">Oluka</para>
  <para style="toc1">Oshu Neshi bwabo ko Oluka</para>
  <para style="toc2">Oluka</para>
  <para style="toc3">Olk</para>
  <para style="mt2">Oshu Neshi bwabo ko</para>
  <para style="mt1">Oluka</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Okwotu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Ase lewa kwobonu gbigwu koza ni gbodagye ipu kaha, <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />byoni ashibita daha bwebe kawase ni yolobene nu bwikyikyo kweyi tono kela ko Owuso ni. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Mani oni, ami abiyun kikpo kela kpiri bwikyikyo, kweyi nma mo oshoshi na toza ni nggye neneshi dawo ada kagye Otiyofilo, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />shini ogyo kwokwoshi koza ni afuwa ni.<verse eid="LUK 1:4" /></para>
  <para style="s">Ako Omoma ko Oyohana Inoyo Obatisma</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Ishini Ohiridus wose ko Ojudiya ni, agbosapa oye, iyenu wo Ozakariya, oyipu kikpo ka Abija. Aruna wokyikyi konya nu Elizabe. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Kpiri wa wase neshi ebe ko Owuso. Aba yawu ipu kono ka Adole neneshi. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Awa ke mayi lo, ikweyi koni Elizabe wodoma ni; kweyi kpiri wa sawukye.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Enoye Ozakariya ya yoko nu ko Osapa ipu kole ko Owuso koni oko kwikpo wa koya ni. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Aweba ome asho shini nayoko ko Osapa ole ko Owuso byoni owodu kawosapa shini ana yola koturare<note caller="+" style="f"><char style="fr" closed="false">1.9 </char></note> ni. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Nishi ko yola koturare yani, ase lewa bese ba tinarigwu.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Oyoleho ka Adole bose danu kweyi hagye abore ko okpe koza kpehe. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Ishini Ozakariya yiyi shoni, otu nu gbo, oshi yokwu. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Oyoleho ke kadanu mo, &lt;&lt;Ka yoshi lo Ozakariya, Owuso pwinarigwu wo. Onya wo Elizabe ya moyi nongo, oya tiye mo Oyohana. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Oya wo otunehe kpo otushosha dawo, kweyi ase nwashika ba shotunehe kpo omoma nu. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Oya wase nyakwu ebe ka Adole. Oyawa gwinyi ni ya yase ni lo. Omaku ko Owuso yayo kpanu bwipu kinanu. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Oyawa kwikye ayi ki Izrayila nwashika gebe ka Adole Owuso wa. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Kweyi oyawa yawu obutu ka Adole ipu ko Omaku kpo oshu kinobane Iliya, oya pyotu kawada gebe kayi wa oki ya pyotu kawase ni lagbiti ni gebe ko ziyi kawase neshi, ko kyasuse tu da Adole.&gt;&gt;<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Ozakariya doyoleho oka mo, &lt;&lt;Nyya yamoji ya kyogwu kpela mani nami kponya hin ke sawukye mani?&gt;&gt;<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Ebeni oyoleho kyogwu mo, &lt;&lt;Iye hin wo Ojibiri. Nyya agye obutu ko Owuso; anu pini tumoleho shini na kela dawo kweyi ki koshu neshi mani dawo la. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Bwishi mani okwunu wo ya gwu, oya gege kokela lo gbishini oza mani ya gbodagye, ikweyi koni otela ko kyogwu kpela hin ni yawa gbodagye ipu kishi nu ni.&gt;&gt;<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Kweyi ewa kasuse bese ba gbeyi kowowa ko Ozakariya, aba ka ipu kotu wa mo ojiyo ga gbeji ipu kole ko Owuso mani? <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Ishini obose wese ni, ogege ko kela kpawa lo. Agye mo agwaniyi moje ole ko Owuso, ikweyi koni oya myabo kin gbela koka lo.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Nishi koko nu kweyi ni, okwikye gole. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Itikpi kishi gbayayi onya nu Elizabe bipu kweyi oyiyinu teba oda koya eho. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Okamo, &lt;&lt;Ogwejeji Adole miyinyinyi hin, ongmami shipu kiweyi.&gt;&gt;<verse eid="LUK 1:25" /></para>
  <para style="s">Akoshu Komoma ko Oyesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Ishini ipu ke Elizabe gyoya ihiri ni, Owuso toyoleho nu Ojibiri oleho go Onazareti agye ko Ogalili, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />ebe kisonya oye ni gyo ngo lo ni ayo kongo oye ni iyenu wi Isu bwipwoma ko Odawuda kodoka nu. Iye kisonya mani wo Omeremu. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Oyoleho gebe nu ga kamo, &lt;&lt;Nngmagye omeremu! Awo ni Owuso ya yimu wo ni! Adole yo kpawo.&gt;&gt;<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Omeremu byotu kotata kpo gbogba koyoleho mani, kweyi igbashi yokwu, okamo edo ko gbogba koji lemani? <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Oyoleho ke kadanu mo, &lt;&lt;Ka yoshi lo Omeremu, oneshi ko Owuso yo kpa wo. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Oya bipu, kweyi ya moyi nongo, oya daniye mo Oyesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Oya wase neneshi, aba yogwu mo Oyi ka Ada ini koshu kpiri. Adole Owuso ya danu obe kadanu Odawuda. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Kweyi oyawa wose kole ko Oyakubu ko gbogbo-gbogbo; obula nu ya kweyi lo.&gt;&gt;<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Omeremu doyoleho oka mo, &lt;&lt;Omani ya gbodagye moji ni ngyongo walo mani?&gt;&gt;<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Oyoleho kyogwu mo, &lt;&lt;Omaku ko Owuso yawa, kweyi Oshu ka Ada Nyakwu yawa sa dawo. Ase sere ni aba mo ni aba yogwu mo Oyi ko Owuso. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Nyya yimu shini ogye moyene wo ke Elizabe ni amo wodoma ni bipu, oya ihiri yoma. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Ojije ya sho Owuso oshu ko ya lo.&gt;&gt;<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Omeremu kyogwu mo, &lt;&lt;Ami woyole ka Adole la; Nalemani byoni oka ni.&gt;&gt; Ebeni oyoleho shobita.<verse eid="LUK 1:38" /></para>
  <para style="s">Omeremu Gebe ke Elizabe</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Ipu kishi oni Omeremu kyiyinu tu kweyi nyiso papa gipu ko ogya oye ipu kikpokyi kagye ko Ojuda, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />ebeni ogipu kole ko Ozakariya kweyi ote Elizabe ogbogba. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Ishini Elizabe pwogbogba ko Omeremu ni, oyi meme ni yipu nuni pya, kweyi Elizabe nwu kpo Omaku ko Owuso. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Ozoko iso mo: &lt;&lt;Otunehe yo kpawo ipu ka anya kpiri, aboneshi wo oyi kipu wo. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Ojiya ome ni oza neshi wa tami ikyeni, ni ene ka Adole hin webe hin ikyeni? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Ishini npwogbogba wo ni, oyi ni yipu hin ni pya kpotu nehe. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Otunehe yo kpase ni kyogwu kpoza ni Adole shokoyi ni.&gt;&gt;<verse eid="LUK 1:45" /></para>
  <para style="s">Omeremu Wigye Kotu nehe</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Omeremu zoko iso mo:</para>
  <para style="q1" vid="LUK 1:46">&lt;&lt;Otu hin sha Adole iye,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />kweyi nshotunehe do Owuso inongmami,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />koni oyela hin oyole nu ni,</para>
  <para style="q2" vid="LUK 1:48">koni nnyonye ni.</para>
  <para style="q1" vid="LUK 1:48">Bwanani gohobu, kpiri kase bawa yumogwu mo,</para>
  <para style="q2" vid="LUK 1:48">aboneshi, <verse eid="LUK 1:48" /><verse number="49" style="v" sid="LUK 1:49" />koni Ada nyakwu yoza neshi dami, kweyi iyenu wase sere. <verse eid="LUK 1:49" /><verse number="50" style="v" sid="LUK 1:50" />Iyinyinyi nu yikweyi kawase ni ba yoshi nu gbomeyi lo bwo oyi oye goyi oye. <verse eid="LUK 1:50" /><verse number="51" style="v" sid="LUK 1:51" />Onabo nu nyakwu ta;</para>
  <para style="q2" vid="LUK 1:51">oyawo zikweyi iso kya kpoza ni aba ya ipu kotu wa ni.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Oyawose saa shobe wa,</para>
  <para style="q2" vid="LUK 1:52">kweyi ongawase ni wojije lo ni iso.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Odawino ngmemye oza neneshi,</para>
  <para style="q2" vid="LUK 1:53">kweyi onawolodu enya abo yeye.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Otoyole nu Izrayila abo,</para>
  <para style="q2" vid="LUK 1:54">kweyi oya yela kiyinyinyi nu ikweyi kase nu,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />byoni oshokoyi dawada kaha ni;</para>
  <para style="q2" vid="LUK 1:55">di Ibirayi kpayi nu, ko gbogbo-gbogbo.&gt;&gt;<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Omeremu yagye kpe Elizabe goya eta ome okwikye gole.<verse eid="LUK 1:56" /></para>
  <para style="s1">Omoma ko Oyohana Inoyo obatisma</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Ishi fu koni Elizabe ya moyi ni, omoyi nongo. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Awoya kobagye kpayinanu pwo mo Adole miyinyinyi nu, ashotu nehe kpanu.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Eno komahata awa ko shoyi mani ofu, aba yimu ko tiye kadanu Ozakariya, <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />ene koyi ke kadawa mo, &lt;&lt;Aayi! Iyenu wo Oyohana!&gt;&gt;<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Aka danu mo, &lt;&lt;Ashishe bwipwoma kala riye mani lo.&gt;&gt;<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Ebeni ashada koyi ekwu, shini ona dawiye koyi. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Omyabo dawa shini ana danoza ko tenena kweyi ota mo, &lt;&lt;Iye nu wo Oyohana.&gt;&gt; Ebeni igbashi kwananoho! <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Ebebeni Ozakariya gege gwokwunu kela, kweyi sho Owuso iye. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Oshi yawoya ko yagye nu kwu, ebebenya ipu kikpokyi kagye ko Ojudiya ase ba kela koza ni gbodagye ni. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Kpiri kase ni pwela mani ba diyiwa oka mo, &lt;&lt;Oyi mani yawa lemoji ome?&gt;&gt; Abo ka Adole yo kpanu.<verse eid="LUK 1:66" /></para>
  <para style="s1">Ozakariya Bane</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Adanu Ozakariya nwu kpo Omaku ko Owuso kweyi obane mo:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />&lt;&lt;Ahan sha Adole iye, Owuso ki Izrayila,</para>
  <para style="q2" vid="LUK 1:68">ikweyi koni owa wa ngmase ni wakakanu ni.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Odaha inongmese ni gboshu ni</para>
  <para style="q2" vid="LUK 1:69">bwole ko oyole nu Odawuda,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />byoni oshokoyi nekye-nekye bwokwunu kawinobane sere ni,<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />ana ngmaha shabo kawo monyekwotu kaha</para>
  <para style="q2" vid="LUK 1:71">kpawase ni ba yimu ka aha lo ni,<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />ona ki miyinyinyi kawada kaha,</para>
  <para style="q2" vid="LUK 1:72">kweyi ona yela ko okoyi sere nu,<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />ene ni ogwa kpada kaha Ibirayi ni:<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />shini ona ngmaha shabo kawo monyekwotu kaha,</para>
  <para style="q2" vid="LUK 1:74">shini ahan meshe danu gboshi yoya lo<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />ipu ko osere kponeshi obutu nu kurutu.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />&lt;&lt;Kweyi awoyi hin aba yogwu minobane ka Ada Nyakwu ni yiso,</para>
  <para style="q2" vid="LUK 1:76">koni oya kwobonu da Adole ko ga kyowe tu danu,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />shini oka dase nu ozagyogye ko ngmawa</para>
  <para style="q2" vid="LUK 1:77">bwebe ko nase ozalabi wa,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />ikweyi kiyinyinyi nwashika ko Owuso kaha,</para>
  <para style="q2" vid="LUK 1:78">eno ya yu daha bwiso,<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />shini na yu dawase ni bebe dibu</para>
  <para style="q2" vid="LUK 1:79">ipu kobowu kikwu,</para>
  <para style="q1" vid="LUK 1:79">ona ki shiyaha owe kotu mene.&gt;&gt;<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Kweyi Oyohana gye ki loshu ipu ko Omaku, kweyi oyagye ipu kimweshi gbishini obose ododa agye ki Izrayila.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Omoma ko Oyesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">oMatiyu 1.18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Ipu kishi oni Okesa Ogostu yuwa tono mo ana yase ni bokpagye ko Oroma ni yika. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Omani wokoka kikyikyo ni gbodagye ishini Okiriniyu woteyi ko Osiriya ni. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Kweyi ananoho kwikye gogya nu shini ana yoka.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Isu sho Onazareti kipu ko Ogalili bita go Obetalami kipu ko Ojudiya ikweyi koni obwole ko Odawuda. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Oga kpo Omeremu ni ayoko ni shini anayuwa ka, kweyi Omeremu bipu <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Ni atayayo bipu ko Obetalami ni, ishi koma nu gye, <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />kweyi omoyi nu kikyikyo nongo. Oyakyi kanu ikpiye, oyo tagye ipu ko okpa, ikweyi koni agboda kokya lo ni.<verse eid="LUK 2:7" /></para>
  <para style="s">Awogbeho ko bize kpa Ayoleho</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Agbabo kokpagye ni awogbeho ko obize bese otu ba yiyi kwobize wa. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Oyoleho ka Adole bose dawa, kweyi oyoyu kigyashi ka Adole yu bwiso, oshi yuwa kwu. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Oyoleho ke wa kadawa mo, &lt;&lt;Ala kayoshi lo. Nbyo oshu neshi ko otunehe neneshi wa dala ni yawa kase kpiri ni.&gt;&gt; <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Ikyeni ogya ko Odawuda ami Inongmese dala, anu pini wo Okristi Adole la. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Omani ya woyi dala: Ala baga moyi ayakyi kanu, gwutagye ikweyi ko okpa.&gt;&gt;<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Ebebeni ogbayi ka ayoleho neneshi kiso ba shawa kweyi ba sho Owuso iye mo,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />&lt;&lt;Igyashi wa ko Owuso ipu ki iso!</para>
  <para style="q2" vid="LUK 2:14">Ipu kese otumene yo kpawase ni oya shotunehe kpawa ni.&gt;&gt;<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Ishini ayoleho kwikye gawa giso ni, awogbeho ko obize ka diyiwa mo, &lt;&lt;Ahan go Obetalami ga moza ni gbodagye, byoni Adole ka daha ni.&gt;&gt;<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Bwebe ni, ayiso papa gato Omeremu kpo Isu kweyi oyi gwutagye ipu ko okpa. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Ishini awogbeho kobize ga mo ni, akoshu koza ni aka dawa ikweyi koyi mani, <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />kweyi kpiri kase ni pwela ni awogbeho ko bize kani, igbashi yuwa kwu. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Omeremu ke yela mani kpiri kpo shotu nu kweyi ya ka ipu kotu nu. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Awogbeho ko bize kwikye kpotunehe kweyi ba sho Owuso iye ikweyi koza ni apwo aki ma, olema byoni aka dawa ni.<verse eid="LUK 2:20" /></para>
  <para style="s">Ato Oyesu Iye</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Eno komahata, ashofu, kweyi atiye mo Oyesu, iye ni oyoleho danu ome abipu nu ni.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Ishini ataba kweyi byoni ono ko Omusa kani, Omeremu kpi Isu, byo go Ojerusele ko oyo da Adole. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Byoni ono ka Adole ka ni, &lt;&lt;Oyi kikyikyo nongo aba yo nabo da Adole.&gt;&gt; <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Kweyi ana ga peshi byoni ono ka Adole ka ni mo, &lt;&lt;Aba byikoho kwe ayi ko otitiribi epa.&gt;&gt;<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Kweyi ipu ko Ojerusele, ongo oye iyenu wo Osimo, owaseneshi, oki ya geyagye do Owuso. Kweyi oyagye ya gbeyi kase ni wa ngma ayi ki Izrayila koni Omaku ko Owuso yo kpa anu ni. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Omaku ko Owuso shiyanu mo oya gekwu lo so mowowa ko Okristi ni Adole shokoyi ni. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Omaku ko Owuso yo nyiso gole ko Owuso. Kweyi ene kpa ada ko Oyesu byo gole ko Owuso, shini ana yoza ni ono ko Omusa ka ni. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Osimo kwoyi kweyi sho Owuso iye mo:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />&lt;&lt;Adole byoni oshokoyi ni,</para>
  <para style="q2" vid="LUK 2:29">yoshe wo na minyo ipu kotu mene.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Koni iyi hin mase ni otoleho ko wa ngmaha,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />ni okyanutu obutu kase kese mani kpiri,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />oya woyoyu dase ni wo Ase ko Oyahuda lo ni, kweyi oki ya wigyashi dase wo ki Izrayila.&gt;&gt;<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Kweyi igbashi yada kpene koyi yikwu, ikweyi ko oza ni aka ikweyi nu ni. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Ebeni Osimo suwa aboneshi kweyi ka do Omeremu inanu mo: &lt;&lt;Oyi mani asho ko wowe kigbo kpo onyiso kase lewa okpagye ki Izrayila, kweyi oki ya woyi ni ase ba tela nu ni, <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />shini ela ni yipu kotu kase kpiri na tese. Kweyi ela mani ya lema byo okpa pini ayitotu la.&gt;&gt;<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Inobane oye nonya, iyenu wo Ohanatu oyi ko Ofanuwe wose ka Asha. Oyagye kpo obunu ashayi ahapa ome obunu gekwu, osawukye kotata, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />kweyi owonyokwu ashayi awahata ayene, osho ole ko Owuso bita lo, oyebeni keno kotu ya geyagye do Owuso ya kwokwunu kpinarigwu. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Ishi oni gyogye, oshotunehe do Owuso kweyi okela ikweyi koyi mani dawase ni kpiyi shagye ba gbeyi kishi ni Owuso ya ngmo Ojerusele ni.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Ishini Isu kpo Omeremu yoza kpiri ni ono ka Adole ka ni, akwikye gogya wa ko Onazareti agye ko Ogalili. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Oyi mani gye kweyi loshu, kweyi oki ziyi, kweyi oneshi ko Owuso yo kpanu.<verse eid="LUK 2:40" /></para>
  <para style="s">Oyesu ipu ko Ole ko Owuso</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Ipu kishayi kpiri, ene kpada nu ba go Ojerusele ebe ki Imya ko Sheyi. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Ishini Oyesu gyishayi igwepa ni, agi Imya byoni owodu wa ni. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Ni Imya kweyi ni, akwikye gole wa, Oyesu tayayo yo Ojerusele, inanu kpada nu gyelo. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Amamo oyipu kikpo kawase ni ayawu kpawa bwo otukpokyi gonose, ni amo lo ni, akwotu ko tikpo nu ipu kayene wa kpase kiyi gyogye. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Ishini amo lo ni, akwikye go Ojerusele ga tikpo nu. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Itikpi keneta, awa yo pye ipu kole ko Owuso, yagye kpa awofoza, oya pwela wa, oki ya duwo oka kela. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Kpiri kase ni pwela nu, igbashi yuwa kwu kpela ni oya nyuwagbo ni. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Ishini inanu kpa ada nu yiyi shoni, igbashi yuwa kwu. Ebeni inanu kadanu mo, &lt;&lt;Oyi, ojiya ni oyaha mani? Ami kpa ada wo ba tikpo wo gbishi ni otu kaha bya.&gt;&gt; <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Oduwo oka mo, &lt;&lt;Ojiya ni ala ba tikpo hin? Ala gye mo nshu ko yole kada hin lo?&gt;&gt; <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Awa ke gyoza ni oya ka ni lo.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Ebeni ogbosuwa go Onazareti, oya geyagye dawa. Inanu ke kpela mani kpiri yi kposhotu nu. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Kweyi Oyesu gye ipu kikpiye kpoziyi, kweyi Owuso kpa asuse yimu nu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s1">Onototu ko Oyohana Ine ko Obatisma</para>
  <para style="r">(<ref loc="MAT 3:1-12">oMatiyu 3.1-12</ref>; <ref loc="MRK 1:1-8">oMak 1.1-8</ref>; <ref loc="JHN 1:19-28">Oyohana 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ipu kishayi igweho ni Okesa Otiberiyu wose ni, Opontu Obilatus woteyi ko Ojudiya, Ohiridus woteyi ko Ogalili. Oyadanu Ofilibus woteyi ki Ituriya kpo Otarakoniti, Olisaniya wa ka Abiliya. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Ipu kishini Anas kpo Okayafas wosapa nyakwu ni, Owuso kela kpo Oyohana oyi ko Ozakariya ipu kododa. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Ogipu kawogya ni kwishu ko Ojoda ni ya tono kweyi ki ya yo Obatisma shini ase na shagbotu shozalabi wa. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Byoni ayitota ipu ko kpa kinobane Ishaya ni mo,</para>
  <para style="q1" vid="LUK 3:4">&lt;&lt;Oko yo ododa ya tono mo,</para>
  <para style="q1" vid="LUK 3:4">&lt;Ala kyowetu gbeyi kowowa ka Adole!</para>
  <para style="q2" vid="LUK 3:4">Kyowe tiriri danu!<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Aba yogowu kpiri ya yi gwu, aba yefu kpikpokyi kpiri yayi sa.</para>
  <para style="q1" vid="LUK 3:5">Aba yowe ni tokoka ya nata tiriri, owe ni gbogo aba kyanu ya.<verse eid="LUK 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 3:6" />Kpiri kasuse ba mino ngmese bwebe ko Owuso!&gt;&gt;&gt;<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Ishini ewa kasuse ba webe ko Oyohana shini ona yuwo obatisma ni, okadawa mo, &lt;&lt;Alayi kifufulegboji! Anaho pyala akpaha mo ala bose shipu kanya ko Owuso ni yawa ni? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Ala yoza ni ya sayi ase mo ala shagbotu shozalabi kala ni. Ala kaka diyi kala mo, &lt;Aha wayi ki Ibirayi lo.&gt; Nyya kadala, Owuso ya gege ya pyakyo mani ya wa ayi ki Ibirayi. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Byonabani ayokwunu ka aga kwotu kefu wa, Efu ni gwa neshi lo aba yogo kweyi yi kpo shola.&gt;&gt;<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Ewa kasuse doka mo, &lt;&lt;Oji naha ba ya?&gt;&gt;<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Oyohana kyogwu mo, &lt;&lt;Kpiri kase ni gbo oshiye epa, ona yoye dase ni gbo lo ni. Ase ni gbozarore, na ya mamani.&gt;&gt;<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Awozegba ki wa shini ana yuwo obatisma kweyi adoka mo, &lt;&lt;Inofoza, ojini aha ba ya?&gt;&gt;<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Okadawa mo, &lt;&lt;Ala ka zegba shoni ono kokpagye ka ni lo.&gt;&gt;<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Ebeni ashishini kawadakare doka mo, &lt;&lt;Aha ba ya moji?&gt;&gt;</para>
  <para style="p" vid="LUK 3:14">Oyohana kyogwu mo, &lt;&lt;Ala ka basela kweyi zikwiri koshu abo wa lo. Ala shotunehe kpoza ni aba salore ni.&gt;&gt;<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Ase kpiyi showe ba gbeyi kinongmese, kweyi aba diyiwa oka ipu kotu mo kwe Oyohana pini wo Okristi la. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Oyohana nyuwagbo mo, &lt;&lt;Nyya lo obatisma kpinyawo, ashe ni shun ni yawa ba ni ami gye ko yo okpabawu kikpo nu ngma lo ni. Anu ya wa yalo obatisma kpo Omaku ko Owuso kpo ola. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Oya wa kpo oda abo nu wa towu kizire, oya yikpo kizire neshi ya sho owuya, omutu ke oya yi yola ni gbo omyomyi lo ni.&gt;&gt; <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Oyohana kela nwashika dase, oki tono koshu neshi ko Owuso dawa.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Oyohana ke gbo Ohiridus oteyi apwo ikweyi koni odoka konya ko oyinanu Ohirodiya kpozabibi kpiri ni oya ni, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Ohiridus yoza ni shozabibi nu kpiri ni, oyo Oyohana kwu toruduru.<verse eid="LUK 3:20" /></para>
  <para style="s">1 Obatisma ko Oyesu kpo Okyikyi nu</para>
  <para style="r">(<ref loc="MAT 3:13-17">oMatiyu 3.13-17</ref>; <ref loc="MRK 1:9-11">oMak 1.9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Ishini ase nwashika wa yobatisma ni, Oyesu ki wa yo obatisma. Ishini oya tinarigwu ni, okpowuso gwa, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />kweyi Omaku ko Owuso sa byo otitiribi ikpiye nu. Oko bwipu kiso ya kamo, &lt;&lt;Awo wo oyi hin ni nyya yimu ni; otu hin yasha kpawo.&gt;&gt;<verse eid="LUK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Oyesu kwotu koko nu ishini owishayi aweta ni. Ase ba kamo owoyi ki Isu, oyi ko Oheli,<verse eid="LUK 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LUK 3:24" />Oheli woyi ko Omatat, Omatat woyi ko Olawi, Olawi woyi ko Omeliki, Omeliki woyi ko Ojanayi, Ojanayi woyi ki Isu, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Isu woyi ko Omatatiya, Omatatiya woyi ke Emosi, Emosi woyi ko Onahu, Onahu woyi ke Esili, Esili woyi ko Onageyi, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Onageyi woyi ko Omatu, Omatu woyi ko Omatatiya, Omatatiya woyi ko Osameni, Osameni woyi ko Ojoseki, Ojoseki woyi ko Ojoda; <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Ojoda woyi ko Ojowana, Ojowana woyi ko Oresa, Oresa woyi ko Ozerubabe, Ozerubabe woyi ko Oshetiya, Oshetiya woyi ko Oniri <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Oniri woyi ko Omeliki, Omeliki woyi ka Adi, Adi woyi ko Okosama, Okosama woyi ke Elimada, Elimada woyi ke Eri, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Eri woyi ko Ojoshuwa, Ojoshuwa woyi ke Eliyaza, Eliyaza woyi ko Ojorimu, Ojorim woyi ko Omatat, Omatat woyi ko Olawi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Olawi woyi ko Osimo, Osimo woyi ko Oyahuda, Oyahuda woyi ki Isu, Isu woyi ko Ojonamu, Ojonamu woyi ke Eliyakim, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Eliyakim woyi ko Omeleya, Omeleya woyi ko Omena, Omena woyi ko Omatata, Omatata woyi ko Onata, Onata woyi ko Odawuda, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Odawuda woyi ko Ojese, Ojese woyi ko Obedi, Obedi woyi ko Obowaz, Obowaz woyi ko Osalimo, Osalimo woyi ko Onasho, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Onasho woyi ka Aminada, Aminada woyi ka Aram, Aram woyi ko Ohezero, Ohezero woyi ko Operez, Operez woyi ko Oyahuda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Oyahuda woyi ko Oyakubu, Oyakubu woyi ki Ishakwu, Ishakwu woyi ki Ibirayi, Ibirayi woyi ko Otera, Otera woyi ko Onaho, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Onaho woyi ko Oseru, Oseru woyi ko Oreyu, Oreyu woyi ko Opele, Opele woyi ke Eba, Eba woyi ko Oshela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Oshela woyi ko Okena, Okena woyi ka Arfakzad, Arfakzad woyi ko Oshem, Oshem woyi ko Onuhu, Onuhu woyi ko Olame, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Olame woyi ko Ometusela, Ometusela woyi ke Enoki, Enoki woyi ko Oyare, Oyare woyi ko Omahalale, Omahalale woyi ko Okena, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Okena woyi ke Enoshi, Enoshi woyi ko Oseti, Oseti woyi ka Adomu, Adomu woyi ko Owuso.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Omoma ko Oyesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">oMatiyu 4.1-11</ref>; <ref loc="MRK 1:12-13">oMak 1.12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Oyesu bwishu ko Ojoda wa nwu, kpo Omaku ko Owuso, kweyi sho Otarakoniti bita, kweyi Omaku byo gipu ko ododa, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />oyebeni keno awene, ibiri ya moma. Orojije lo ipu kishi oni, ogwejeji emye ya ngmo.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Ibiri ka danu mo, &lt;&lt;Owoni owo Oyi ko Owuso, yikyikpo mani pya wikyoga.&gt;&gt;<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Oyesu kadanu mo, &lt;&lt;Ayitota ipu kokpa ko Owuso mo: &lt;Ikyoga kin pini ya yase ya gbo layi la lo.&gt;&gt;&gt;<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Ibiri byo giso ebelenu kweyi ga shiyanu obula kese ipu kishi gbayayi. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Kweyi okadanu mo, &lt;&lt;Nyya dawo oshu kese kposhinu kpiri, koni kpiri koza mani ayi dami ni, kweyi ami ki gboshu ko dananoho ni nyyimu ko danu ni. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Owoni ogeyagye dami, kpiri koza mani ya wakakawo.&gt;&gt;<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Oyesu kadanu mo, &lt;&lt;Ayitota ipu kokpa ko Owuso mo: &lt;Geyagye da Adole Owuso wo, anu fufunu pini oya yoko danu la.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.8 </char><char style="ft" closed="false">DEU 6.13</char></note><verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Ibiri byo go Ojerusele kweyi ga hagye iso ebelenu ikweyi kole ko Owuso. Okadanu mo, &lt;&lt;Owoni owo Oyi ko Owuso, shibi bwebeni gokpagye. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Koni ayitota ipu kokpa ko Owuso mo, &lt;Owuso ya kada ayoleho nu shini anagbeho wo.&gt; <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />Akyi kamo, &lt;Aba wa yabo byo iso, shini oka yikpo gwakyo lo.&gt;&gt;&gt;<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Oyesu kadanu mo, &lt;&lt;Okpa ko Owuso kamo: &lt;Ka ma Adole Owuso wo ma lo.&gt;&gt;&gt;<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Ishini ibiri moma kweyi ni, oshobita gbishi oye.<verse eid="LUK 4:13" /></para>
  <para style="s">Oyesu Kwotu Koko nu Ogalili</para>
  <para style="r">(<ref loc="MAT 4:12-17">oMatiyu 4.12-17</ref>; <ref loc="MRK 1:14-15">oMak 1.14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Oyesu kwikye go Ogalili, ipu koshu ko Omaku ko Owuso, kweyi oshu ikweyi nu ge ebebenya agbabo kokpagye ni. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Oya foza ipu kekpa, kweyi ananoho ba kanu.<verse eid="LUK 4:15" /></para>
  <para style="s">Atela ko Oyesu Onazareti</para>
  <para style="r">(<ref loc="MAT 13:53-58">oMatiyu 13.53-58</ref>; <ref loc="MRK 6:1-6">oMak 6.1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Okwikye go Onazareti ebeni abyo gye ni, kweyi Eno ko Minyo ogipu kekpa wa byoni owodu nu ni. Kweyi onyiso ko mokpa. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Ayo okpa kinobane Ishaya nabo danu. Ogwanu kweyi omebe ni ata mo:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />&lt;&lt;Omaku ka Adole yo kpami, ikweyi koni osumabo ikweyi ko tono koshu neshi dawoleha. Otumoleho ebe kase ni ayuwa shetu ni shini ana shuwa bita, ko gwofiyi iyi, ko ngmawase ni aba buwikpo ni, <verse eid="LUK 4:18" /><verse number="19" style="v" sid="LUK 4:19" />kweyi na ka dase mo omani wishayi ni Adole ya yase oneshi ni la.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">4.19 </char><char style="ft" closed="false">61. 1-2</char></note><verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Ebeni oyo okpa yi la, kweyi oyi dase ni ya yoko ipu kekpa ni kweyi oga yagye. Ananoho ni bipu kekpa ni kpiyi kwo. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Kweyi okwotu ko kadawa mo, &lt;&lt;Ikyeni oza ni okpa ko Owuso ka ni ala pwo akpaha kala.&gt;&gt;<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Kpiri wa koneshi nu kweyi igbashi yuwa kwu ikweyi kela neshi ni ya bose bwokwunu nu ni. Adiyiwa oka mo, &lt;&lt;Omani woyi ki Isu yona lo?&gt;&gt;<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Oyesu ka dawa mo, &lt;&lt;Nggye mala basasuse mani kpami mo, &lt;Oloboshi, ngmiyo! Yoza ni aha pwo moya Okapanahu ni daha ipu ko ogya wo.<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />Oki ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, aba kyogwu kpinobane ipu ko ogya nu lo. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Ami ke ya kadala okwokwoshi, ishi ki Iliya agba anyokwu nwashika ipu ki Izrayila, ishini owuso tela koyiwo kishayi eta kpoya ihiri kweyi emye ngmase kotata ebebe nya okpagye ni. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Ati Iliya oleho gebe kashishe wa lo, ke so onyokwu oye ipu ko Ozerefa ka agbabo ko Osido. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Aki agbawine kiyiwa nwashika ipu ki Izrayila ishi kinobane Elisha, kweyi oyoye ipu wa pyogege lo, ke so Onahama ni wase ko Osiriya ni.&gt;&gt;<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Ishini apwela mani ni, otu kase kpiri ni bipu kekpa ni bya. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Anyiso kweyi nenya bose shogya, kweyi abyo gikweyi kikpokyi ni yogya wa ni shini ana to bwebeni gokpagye. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Oke yawu bwo otutehe wa kweyi kwowe ganu.<verse eid="LUK 4:30" /></para>
  <para style="s">Ongo ni Gbo Omaku Bibi ni</para>
  <para style="r">(<ref loc="MRK 1:21-28">oMak 1.21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Ebeni ogo Okapanahu, ogya ko Ogalili, Eno ko Minyo okwotu ko fasoza. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Igbashi yuwa kwu ikweyi kozafofu nu, koni ela nu gboshu ni.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Ipu kekpa, ongo oye gbo omaku bibi. Osheha kpoko nwa kamo, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />&lt;&lt;Ojino oya yimu ebe kaha, Oyesu ko Onazareti? Owa ko wa yaha ngmo la? Ngyase ni owe ni, owase Sere ko Owuso la!&gt;&gt;<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Oyesu kela mo, &lt;&lt;Sha! Bose shikpiye nu!&gt;&gt; Ebeni omaku bibi nwongo mani pyagye obutu wa kweyi onyiso kwikpiye nu ebyibye fa lo.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Igbashi yase kpiri kwu kweyi aba diyiwa oka mo, &lt;&lt;Ozafofu mani lemoji? Ogbo omaku bibi eha kpo oshu kweyi abose!&gt;&gt; <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Kweyi oshu ikweyi nu gebebenya ipu ko ogya ni bagbabo ni.<verse eid="LUK 4:37" /></para>
  <para style="s">Oyesu Dase Nwashika Ogege</para>
  <para style="r">(<ref loc="MAT 8:14-17">oMatiyu 8.14-17</ref>; <ref loc="MRK 1:29-34">oMak 1.29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Oyesu shekpa bita kweyi go ole ko Osimo. Oshu yene konya ko Osimo kwu, kweyi abo Oyesu mona danogege. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Oweyi kwagye obutu nu kweyi ka doshu mona shobita, kweyi oshu shobita. Ebebeni onyiso kweyi okwotu ko yozarore dawa.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Ishini eno shani, abyase ni gbedo ko ose gogo-gogo ni webe ko Oyesu, kweyi osuwabo oyoye kweyi kpiri wa pyogege. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Kweyi omaku bibi bose shikpiye kase nwashika basheha mo, &lt;&lt;Owo Oyi ko Owuso la!&gt;&gt; Oyesu ke kyaweha kweyi wuwobi ko kela, ikweyi koni agye mowo Okristi ni.<verse eid="LUK 4:41" /></para>
  <para style="s">Oyesu Tono Ipu ka Agye ko Oyahudiya</para>
  <para style="r">(<ref loc="MRK 1:35-39">oMak 1.35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Ishini ebenya ni Oyesu shogya ni bita kweyi ga yebye fufunu. Ase ba tikpo nu kweyi ishini agebe ni oyanu ni, aba yimu shini ona ka shuwa bita lo. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Oke kadawa mo, &lt;&lt;Owotiri shini na tono koshu neshi ko obula ko Owuso gogya shishini mamani, ikweyi koni oza ni ya ni atumoleho ni oma.&gt;&gt; <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Kweyi ogohobu kpono totu ipu ka awekpa kokpagye ko Ojudiya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Oyesu sha awogboso kikyikyo</para>
  <para style="r">(<ref loc="MAT 4:18-22">oMatiyu 4.18-22</ref>; <ref loc="MRK 1:16-20">oMak 1.16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Eno oye Oyesu ya tono okwunu kega kishu nyakwu ko Ogenesarati, ewa kasuse nwashika shogba to ba pwela ko Owuso, <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />omo owu kinyo epa hagye okwunu kega, ni awino kwebinyi shibita kweyi aba neya wa ni. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Ogipu kowu oye ni wa ko Osimo ni, oka danu mona sha gipu kishu nyakwu gbayayi. Ebeni oyagye ipu kowu ya fuwela ko Owuso.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Ishini okela kweyi ni, oka do Osimo mo, &lt;&lt;Yeya wo shebeni libu ni shini okwebinyi.&gt;&gt;<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Osimo kadanu mo, &lt;&lt;Adole aba yoko kotu gbishini ebenya aha kwojije lo. Ikweyi koni oka mani ke, nyya sheya ipu kinyo.&gt;&gt; <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Ishini aya mani ni, akwebinyi nwashika gbishini eya wa kwotu ko sha. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Ebeni aya awino kwebinyi ni bowu oye ni ogwu shini ana wa tuwabo, awa kpebinyi sho owu pepa, owu mwu gbishini akwotu ko gbobi geye kinyo.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Ishini Osimo Obitrus moza mani ni, okwagye obutu ko Oyesu, kweyi kamo, &lt;&lt;Ga sho obutu hin, Adole! Ami wine ko ozalabi la!&gt;&gt; <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Igbashi yo Obitrus kpa awino kwebinyi mani kpiri yikwu ikweyi kebinyi nwashika ni akwu ni, <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />ko Oyakubu kpo Oyohana ayi ko Ozebedi mamani.</para>
  <para style="p" vid="LUK 5:10">Ebeni Oyesu ka do Osimo kamo, &lt;&lt;Kayoshi lo; bwanani go ohobu oya kwasuse.&gt;&gt; <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Ebeni apyowu wa wese kishu, asho ojoji wa kpiri bita kweyi agboso.<verse eid="LUK 5:11" /></para>
  <para style="s">Oyesu do Ongo ni gbo ose kiyiwa Ogege</para>
  <para style="r">(<ref loc="MAT 8:1-4">oMatiyu 8.1-4</ref>; <ref loc="MRK 1:40-45">oMak 1.40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />No Oyesu tayayo yipu ko ogya oye ni, ongo oye ni gbose kiyiwa ni webenu. Ishini omo Oyesu ni, ogbo okpagye ya bo mo, &lt;&lt;Adole, owoni okyogwu odamogege.&gt;&gt;<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Oyesu ya abo so ongo mani, okamo, &lt;&lt;Otu hin ze, ose wo na kweyi!&gt;&gt; Ebebeni ose kiyiwa nu kweyi.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Ebeni Oyesu pyakpaha kamo, &lt;&lt;Kaka dashishe lo, ga shiyo dosapa, kweyi opeshi byoni ono ko Omusa ka ni, nawo oza ni ya shase mo opyo ogege.&gt;&gt;<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Oshu ikweyi ko ongo mani gebebenya, kweyi ewa kasuse wa shini ana pwela nu kweyi ona ki dawo ogege wa. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Ishi shishini ke Oyesu ya kwikye ga yagye fufunu ya tinarigwu.<verse eid="LUK 5:16" /></para>
  <para style="s1">Oyesu dine kose ko Owinyi Ogege</para>
  <para style="r">(<ref loc="MAT 9:1-8">oMatiyu 9.1-8</ref>; <ref loc="MRK 2:1-12">oMak 2.1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Eno oye Oyesu yafoza, ashishini ka Awofarisi kpa awofono, ni bwo ogya leke ko Ogalili kpo Ojudiya kpo Ojerusele ni wa bagye ebeni. Kweyi oshu ka Adole yo kpanu ko dawine kose ogege. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Ango oye byine kose kikpiye winyi ni gwutagye ote ni webe ko Oyesu. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Kweyi apyowe ko gipu kole lo, koni ase nwashika ni, kweyi atoshi giso kinu kweyi ayo sa tagye ote otutehe kewa obutu ko Oyesu.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Ishino Oyesu mo otuse wa ni, okamo, &lt;&lt;Oya hin, ayo ozalabi wo na.&gt;&gt;<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Kweyi Awofarisi kpa awofono kwotu ko lo okwunu agye ba kamo, &lt;&lt;Anu mani wa anoho ya kela karigbetu? Anoho ke ya gege ya no ozalabi, so Owuso fufunu lalo?&gt;&gt;<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Oyesu gyoza ni yipu kotu wa ni kweyi oduwoka mo, &lt;&lt;Ojiya ni ala ba ra mani ipu kotu kala? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Onya le kwe: ko kamo, &lt;Ayo ozalabi wo na;&gt; Kwe ko kamo, &lt;Nyiso shini oyawu&gt;? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Shini ala kegye mo Oyi ka Asuse gboshu ese mani ko no ozalabi,&gt;&gt; Okado inogbose kowinyi mo, &lt;&lt;Nka do mo, nyiso, zote wo shini ogole.&gt;&gt; <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Ebebeni onyiso obutu wa, ozo ote ni ogwutagye ikweyi nu ni kweyi gole yasho Owuso iye. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Ananoho igbashi yuwa kwu kweyi aba sho Owuso iye. Oshi yuwa kwu kotata kweyi akamo, &lt;&lt;Aha moza kigbashi ikyeni.&gt;&gt;<verse eid="LUK 5:26" /></para>
  <para style="s">Oyesu yo Olawi ogwu</para>
  <para style="r">(<ref loc="MAT 9:9-13">oMatiyu 9.9-13</ref>; <ref loc="MRK 2:13-17">oMak 2.13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Oyesu bose gese kweyi omino zegba oye, iye nu wo Olawi oyagye oda kozegba, Oyesu ka danu mo, &lt;&lt;Gbosun.&gt;&gt; <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Kweyi Olawi nyiso, osho ojoji bita kweyi ogboso.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Ebeni Olawi byo Oyesu gole nu kweyi oyimya nyakwu danu, kweyi lewa ka awozegba kpase shishi bagye ba roza kpa awa. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Ashini ka Awofarisi kpa awofono ni ke bagye kpo Oyesu ni ba lokwunu agye dawogboso mo, &lt;&lt;Ojiya ni ala ba re ba gwa kpawo zegba kpa awinozalabi?&gt;&gt;<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Oyesu ka dawa mo, &lt;&lt;Ase ni loshu ni ya yimu komo oloboshi lalo, ke sine kere. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Nwa ko yase neshi ogwu la lo; nwa ikweyi ka awine ko ozalabi shini ana shagbotu.&gt;&gt;<verse eid="LUK 5:32" /></para>
  <para style="s">Oka doda ikweyi ko okwunu kwokwu</para>
  <para style="r">(<ref loc="MAT 9:14-17">oMatiyu 9.14-17</ref>; <ref loc="MRK 2:18-22">oMak 2.18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Ashini ka Awofarisi kpa awofono wa do Oyesu oka mo, &lt;&lt;Awogboso Oyohana kpa ka Awofarisi ba kwokwunu ba tinarigwu ishi kpiri, awogboso ke ba roza ba gwinyi.&gt;&gt;<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Oyesu ka dawa mo, &lt;&lt;Kwala ma awoya koba konyape ba kwokwunu ishini oba konyape yo kpa awa ekpa ni? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ishi ke ya waba ni aba yoba konyape ya bize shuwa ni. Ishi oni aba kwokwunu.&gt;&gt;<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Oyesu kelase mani dawa kamo, &lt;&lt;Ashishe ya gege yayabo kayikyi pepe ya go kwonekye lo, koni ayikyi pepe yayo nekye yayi sha labi. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Kweyi ashishe ya yinyi pepe ya sheyi ko okpa nekye lo, owoni ayamani, eyi ko okpa ya kya kweyi inyi ya shonu, olemani lalo, aba yi inyi pepe ya sheyi ko okpa pepe la, shini kpiri wa naka yishi lo.&gt;&gt; <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Aayi inyi pepe aba yi sheyi ko okpa pepe la! <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Kweyi ase ni gwinyi nekye ya yimu ko pepe lo, oya kamo, &lt;Onekye shoshi sho pepe.&gt;<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Adole ke Eno ko Minyo</para>
  <para style="r">(<ref loc="MAT 12:1-8">oMatiyu 12.1-8</ref>; <ref loc="MRK 2:23-28">oMak 2.23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Eno ko Minyo oye Oyesu ya yawu ipu keho ki izire, kweyi awogboso kwotu ko kyikweyi ki izire kweyi ba ha. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Ashini ka Awofarisi do oka mo, &lt;&lt;Ojiya ni ala ba yo oza ni ono wobi ni Eno ko Minyo?&gt;&gt; <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />Oyesu ka da awa mo, &lt;&lt;Ala mo oza ni Odawuda ya ishini anu kpa awoya ki iyawu nu ba ngmemye ni lo? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Ogipu ko Ole ko Owuso, kweyi ga zo ikyoga ni akyanutu do Owuso, oha oza ni wo ono da awosapa ko ha kin ni. Kweyi oki yo ashishini da awoya ki iyawu nu.&gt;&gt; <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Ebeni Oyesu ka da awa mo, &lt;&lt;Oyi ka Asuse pini wa Adole ke Eno ko Minyo la.&gt;&gt;<verse eid="LUK 6:5" /></para>
  <para style="s">Ongo ni abo nu winyi ni</para>
  <para style="r">(<ref loc="MAT 12:9-14">oMatiyu 12.9-14</ref>; <ref loc="MRK 3:1-6">oMak 3.1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Eno ko Minyo oye ogipu ke ekpa Ase ko Oyahuda kweyi ya foza, ongo oye ni abo nu ka abore winyi ye ebeni. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Ashishini ka Awofarisi kpa awofono ba tikpo ko oza ni aba ya abo abyo shini ana kwo Oyesu epwo ni, akpiyi shagye kwe Oyesu ya da ashe ogege Eno ko Minyo. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Oyesu ke gyo oza ni yipu ko otu wa ni, oka do ongo ni gbose ka abo winyi mani mo, &lt;&lt;Nyiso shini ohagye obutu ka ananoho.&gt;&gt; Ebeni onyiso hagye.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Ebeni Oyesu duwoka mo, &lt;&lt;Onya shoshi ko ya Eno ko Minyo, oneshi kwe obibi, ko da ase olayi la kwe ko ya ase ngmo?&gt;&gt;<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Ishino otiyi muwa kpiri ni, kweyi oka do ongo mani kamo, &lt;&lt;Nata ka abo wo.&gt;&gt; Oya mani byoni oka da nu ni, kweyi opyo oshu ka abo nu. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Awa ke otuwa hakyashi kweyi aba gbela kpi iyiwa ikweyi ko oza ni aba ya kpo Oyesu.<verse eid="LUK 6:11" /></para>
  <para style="s">Oyesu sha Ayole nu Igwepa</para>
  <para style="r">(<ref loc="MAT 10:1-4">oMatiyu 10.1-4</ref>; <ref loc="MRK 3:13-19">oMak 3.13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Eno oye Oyesu bose ga ashikwu ke efu ko tinarigwu, otinarigwu do Owuso gbi ishini ebenya. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Ishini ebenya ni, oya awogboso kpiri gwu kweyi oshase igwepa ipu wa kweyi yuwo gwu mo ayikoko ko Oyesu: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Osimo ni iye nu wo Obitrus ni, kpo oyinanu Andru kpo Oyakubu kpo Oyohana kpo Ofilibus kpo Obatolomi, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />kpo Omatiyu kpo Otoma kpo Oyakubu oyi ka Alfayu kpo Osimo ni gbo otu dose ko okpagye nu ni, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />kpo Oyahuda oyi ko Oyakubu ki kpo Oyahuda Iskariyoti ni yo Oyesu ra da awa ni.<verse eid="LUK 6:16" /></para>
  <para style="s">Oyesu Fa Ase Oza Oki Da awa Ogege</para>
  <para style="r">(<ref loc="MAT 4:23-25">oMatiyu 4.23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Osa kpa ayikoko ko Oyesu nu bwi ikweyi ke efu wo okpagye. Kweyi asuse nwashika bwa agye ko Ojudiya kpo Ojerusele kpa agbabo ki ishu ko Otaya kpo Osidon, <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />wa ko wa foza fofu nu kweyi ona ki da awo ogege wa. Awase ni omaku bibi ya da awa owe ya mani ada awo ogege. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Kweyi ase kpiri ba yimu ko ganu abo ikweyi koni oshu ya bose bwi ikpiye nu kweyi ya da awo ogege.<verse eid="LUK 6:19" /></para>
  <para style="s">Otunehe kpo otubyobya</para>
  <para style="r">(<ref loc="MAT 5:1-12">oMatiyu 5.1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Oyesu tiyi ma awogboso, kweyi okamo,</para>
  <para style="q1" vid="LUK 6:20">&lt;&lt;Otunehe yo kpa awoleha, koni aba pyo obula ko Owuso.<verse eid="LUK 6:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="LUK 6:21" />Otunehe yo kpa awo ngme emye byo onabani, aba yipu. Otunehe yo kpa awase ni ba kyegba byo onabani ni, aba ye eye.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />Otunehe yo kpa ala ni asuse ba yanya kala, aki tela kala, aki sa ala esa, aki ya ala ogwu mo ala wa ase bibi, ikweyi ko Oyi ka Asuse.<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />&lt;&lt;Ala gyoba kpeye okwunu, koni abola kala ya nwashika ipu ki iso. Mamani pini awokyikyi wa ya kpa awinobane la.<verse eid="LUK 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LUK 6:24" />&lt;&lt;Ebi ke yo kpa ala ni wo olodu byo onabani, koni ala kwobonu pya abola kala. <verse eid="LUK 6:24" /><verse number="25" style="v" sid="LUK 6:25" />Ebi yo kpa ala ni yipu byo onabani, koni ala ba wa ngme emye. Ebi yo kpa ala ni ba yeye byo onabani ni, koni ala ba wa byotu kweyi ba kyegba. <verse eid="LUK 6:25" /><verse number="26" style="v" sid="LUK 6:26" />Ebi yo kpa ala ni asuse kela neshi ikweyi kala, koni mamani pini awokyikyi kala ya kpa awinobane ko okame la.&gt;&gt;<verse eid="LUK 6:26" /></para>
  <para style="s">Yimu ka Awomonye-kwotu</para>
  <para style="r">(<ref loc="MAT 5:38-48">oMatiyu 5.38-48</ref>; <ref loc="MAT 7:12a">7.12a</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />&lt;&lt;Ami ke ya kadala ni ba pwun ni: yimu ka awomonyekwotu wo, kweyi yo neshi kpa awino yanya wo, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />sa awase ni ba sesa ni aboneshi, tinarigwu da awase ni ba yo obibi ni. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Owoni ashe labo akpaha oye, ki pyo omwepa da anu. Owoni ashe yo oshiye kpo, ka wobi ko obagidi wo lo. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Ase ni do oka ko oza kpiri odanu, owoni ashe yo oza bize, ka do oka lo. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Oza ni oya yimu shini ase na ya dawo awo ya dawa mamani.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />&lt;&lt;Owoni oyimu kawase ni ba yimu wo kin, abola nya yebe ni? Kwa &lt;awinozalabi&gt; ba yimu kawase ni ba yimu wa ni. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Kweyi owoni oyo neshi kpa awase ni ba yo neshi kin, abola nya no opye? Koni awinozalabi ba ya mani. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Kweyi owoni okpase ni oyo otuse mo aba sore ni oza, abola nya ye ebe ni? Kwa &lt;awinozalabi&gt; ba kpa &lt;awinozalabi&gt; oza kweyi ba yitagye shini ana suwa ore gyogye. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Ke yimu ko omonyekwotu wo, yo oza neshi da awa, kpa awo oza, ka yo otuse mo ana sore lo. Ebeni abola wo ya wo nyakwu, oya wo oyi ka Ada Nyakwu ki iso, koni owine ko otu mene kpa awase ni ba shotunehe ikweyi ko oza ni aya da awa lo ni kpa awine ko otu bibi ni. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Miyinyinyi ka asuse, byoni Ada kala wine ki iyinyinyi ni.<verse eid="LUK 6:36" /></para>
  <para style="s">Ala ka Kwa Ase Epwo lo</para>
  <para style="r">(<ref loc="MAT 7:1-5">oMatiyu 7.1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />&lt;&lt;Ala ka kwase epwo lo, shini ana ka kwala epwo lo. Ka ya ase ishi lo, shini ana ka yi ishi lo. Yo ozalabi gbase, shini ana yo ozalabi wo gbo. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Dase oza, aba dala nwo owatu, si ikpokyi kweyi janu ya shonu ataku wo. Owatu neshi ni ala myiyo kpa anu da ase ni aba myiyo kpa anu ya da ala.&gt;&gt; <verse eid="LUK 6:38" /><verse number="39" style="v" sid="LUK 6:39" />Oki kelase da awa mo, &lt;&lt;Opwiyi ya gege ya pyo ofiyi abo? Kpiri wa ba gbo go ogo lo? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Oyi ki inokpa ya shi inofoza lo, ase ni ke afoza neneshi ya lema byo inofoza.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />&lt;&lt;Ojiya ni oya mi ikpo ki ikyashi ni yipu ki iyi ko oyene wo kweyi orela ke efu ni yipu ki iyi wo ni lo? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Oya ya moji ya ka do oyene wo mo, &lt;Wa shini na ngmi ikpo ki ikyashi ni yipu kiyi wo ni kweyi awo gege ko me efu ni yipu ki iyi wo ni lo? Ala awoyoziyi, ala ngme efu ni yipu ki iyi kala ni ome, shini ala mebe neneshi ko ngmi ikpo ki ikyashi shipu ki iyi ka ayene kala.<verse eid="LUK 6:42" /></para>
  <para style="s">Efu kpo Ogwogwa Nu</para>
  <para style="r">(<ref loc="MAT 7:16-20">oMatiyu 7.16-20</ref>; <ref loc="MAT 12:33-35">12.33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />&lt;&lt;Efu neshi ya gwa labi lo, mamani efu labi ya gwa neshi lo. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Aba gye efu bwe ebe ko gwogwa nu la. Aba wa aza bwe efu ki igye lo, kwe ya gege ya wa aremu bwe efu ko ofigi lo. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Ase neshi ela neshi ya bose bwi ipu ko otu nu la, ase bibi ela bibi ya bose bwi ipu ko otu nu. Oza ni yipu ko otu ni pini okwunu ya ka la.<verse eid="LUK 6:45" /></para>
  <para style="s">Oziyi kpi Ikyo ni Mo Ole wa ni</para>
  <para style="r">(<ref loc="MAT 7:24-27">oMatiyu 7.24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />&lt;&lt;Ojiya ni ala ba yumogwu mo, &lt;Adole, Adole,&gt; Kweyi ala ba yo oza ni nka ni lo? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Nyya shiya ala oza ni owe ni, kpiri kase ni pwela hin kweyi yo oko kpa anu. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Olema bya ase ni kwotu kole nu ikweyi ki ikyikpo ni. Ishini owu wa to ole ni, ole ke kye lo, ikweyi koni amo ole ni neneshi ni. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Ase ni ke pwela hin kweyi tela ko yo oko kpa anu lema bya ase ni kwotu kole nu ikweyi ki isisagye ni. Ishini owu tole ni, okye shonu kpiri.&gt;<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Otuse ko oteyi ka adakare ko Oroma</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Ishini Oyesu kawela mani kweyi ni, ogo okpagye ko Okapanahu. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Ebeni oyole ko oteyi ka adakare na adole nu ya yimu nu ko otata ni loshu lo, oyo okwunu ki ikwu. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Oteyi ka adakare pwoshu ko Oyesu kweyi ota awanyakwase ka Ase ko Oyahuda oleho ebe nu, aga bo Oyesu shini nawa ngmo oshe nu. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Ishini awebe ko Oyesu ni, abo Oyesu ko otata kamo, &lt;&lt;Ongo mani ya yimu shini ongmo oyole nu, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />ikweyi koni oya yimu ko okpagye ka aha oki me ekpa daha.&gt;&gt; <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Ebeni Oyesu gbosuwa ga.</para>
  <para style="p" vid="LUK 7:6">Ishini oyo pee kpo ole ni oteyi ka adakare mani ta awoya nu oleho ebe nu kamo, &lt;&lt;Adole, ka di iyo owe lo, koni nggye mo nnye koni oya winu kole hin ni. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Oza ni ya ni nmiyun mo nggye ko webe wo lo ni oma. Owoni okela kin, oyole hin ya pyo ogege. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Koni ami abiyun nyya abo kashe la, kpa adakare bo otu hin. Owoni nka da ashe wa mo, &lt;Ga!&gt; Oya ga; &lt;Kwikye,&gt; oya kwikye. Owoni nka do oyole hin mo, &lt;Yoza mani,&gt; oya ya.&gt;&gt;<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Ishini Oyesu pwela mani ni, igbashi yo kwu, opyi me ewa ka asuse ni ba gboso ni, okamo, &lt;&lt;Nyya kadala ipu ki Izrayila nma ashishe ni gbo otuse loshu byo ongo mani lo.&gt;&gt; <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Ebeni ango ni otuwo oleho ni kwikye go ole ga to oyole nu pyo ogege nu.<verse eid="LUK 7:10" /></para>
  <para style="s">Oyesu Sho Oyi ko Onyokwu ni Gekwu ni iyi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Ni Oyesu she ebeni bita ni, ogo ogya oye ni aba yogwu mo Onayi, awogboso kpe ewa ka asuse nwashika gboso. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Ni oyo pee kpofunu oba ko ogya ni, azo okwu ko ongo oye ni wa anu fufunu ebe ki inanu, kweyi inanu wo onyokwu. Ase nwashika bwo ogya ni gboso onya ni. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Ishini Adole mo onya mani ni, iyinyinyi nu yo kwu, kweyi okamo, &lt;&lt;Ka kyegba lo.&gt;&gt;<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Ebeni oga gabo agba, kweyi awase ni hagye. Okamo, &lt;&lt;Isongo, nyiso!&gt;&gt; <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Ongo ni gekwu mani nyiso yagye kweyi ya kela, kweyi Oyesu yo di inanu.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Kpiri wa oshi yuwa kwu kotata kweyi aba sho Owuso iye. Akamo, &lt;&lt;Inobane neshi wi ipu ka aha, Owuso wa ko wa ta awase nu abo.&gt;&gt; <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Oshu ikweyi ko Oyesu ge ebebenya ipu ka okpagye ko Ojudiya kpa awogya ni yo kuwa ni.<verse eid="LUK 7:17" /></para>
  <para style="s">Oyohana ko yo Obatisma Toleho Ebe ko Oyesu</para>
  <para style="r">(<ref loc="MAT 11:1-19">oMatiyu 11.1-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Awogboso Oyohana ka da anu ojoji ni gbodagye ni. Oya ase epa ipu wa ogwu, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />otuwo oleho ge ebe ka Adole mo, &lt;&lt;Awo pini wa ase ni ya wa ni la, kwe ahan gbeyi ka ashe hoha?&gt;&gt;<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Ishini ango epa ni we ebe ko Oyesu ni, akamo, &lt;&lt;Oyohana ko yo Obatisma taha oleho ebe wo ma ahan do oka mo, &lt;Awo pini wa ase ni yawa ni la, kwe ahan gbeyi ka ashe hoha?&gt;&gt;&gt;<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Ipu ki ishi oni Oyesu da ase nwashika ni loshu lo ni ogege kpa awine ko ose kpa awase ni gbo omaku bibi, kweyi gwo ofiyi nwashika iyi. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Ebeni okyogwu mo, &lt;&lt;Ala kwikye ga ka do Oyohana oza ni ala ma ni ki kpo oza ni ala pwo ni: Awopwiyi ba mebe, awokyikpo ba yawu; awogbose ki iyiwa pyo ogege, awodoho ba pwaha; awase ni gekwu ni ayuwa nyiso; kweyi awoleha ba pwo Oshu Neshi. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Otunehe yo kpase ni kwikye itikpi ikweyi kela hin lo ni.&gt;&gt;<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Ni awogboso Oyohana ba she ebeni bita ni, Oyesu kwotu ko kela de ewa ka asuse ikweyi ko Oyohana mo: &lt;&lt;Ishini ala ge ebe ko Oyohana ododa ni oji ni ala ga ko ma? Ala ga ko ma agwu ni owu ya tuwa ni la? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Owoni olemani lo, oji ni ala ge ese ko ma? Ongo ni sho oshiye neneshi ni la? Aayi, awase ni ba sho oshiye neshi ni bo ole ka awose la. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Kwe, oji ni ala gese ko ga ma? Ala ga ko mi inobane la? Olemani, ase ni ala ge ese ko mo ni shi inobane. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Oyohana pini wa ase ni okpa ko Owuso ya kela ikweyi nu ya kamo,</para>
  <para style="q1" vid="LUK 7:27">&lt;&lt;&lt;Ma, nyya to oyoleho hin oleho ya kwobonu dawo,</para>
  <para style="q2" vid="LUK 7:27">shini nawa kyowe gbishi wo.&gt;<verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />Nyya kadala, ipu ka asuse ni anya mani ashishe sho Oyohana lo; kwikyikyeni ase ni wo ogwejeji obula ko Owuso ni sho.&gt;&gt;<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Kpiri kase, kpa awozegba, ishini apwela ko Oyesu ni, agye mo owe ko Owuso wokwokwoshi, ikweyi koni Oyohana yuwo obatisma ni. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Awofarisi kpa awofono ke tela ki imu no Owuso gbo da awa ni, ikweyi koni Oyohana yuwo obatisma lo ni.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />&lt;&lt;Oji ni nyya mya asuse ki ishi mani kpa anu? Ale byo oji? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Alema bya ayileke ni bi ipishi ba yi iyiwa ogwu mo:</para>
  <para style="q1" vid="LUK 7:32">&lt;&lt;&lt;Aha tajigwo da ala, ala tela ko gyoba, aha wigye ki ikwu da ala, ala tela ko kyegba.&gt; <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Koni Oyohana ko yo obatisma wa, oroza kwo ogwi inyi lo, ala kamo, &lt;Ogbo omaku bibi.&gt; <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Oyi ka Asuse wa ya ro oza ya gwi inyi, ala kamo, &lt;Oyi kinyi, oya ka awino zegba kpa awinozalabi.&gt;&gt;&gt; <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Ala ke ba gyo oziyi ko Owuso bwe ebe ka ayi nu.&gt;&gt;<verse eid="LUK 7:35" /></para>
  <para style="s">Onya ni Yayo Ozalabi ni Nyo Oyesu Ano</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Ongo ko oFarisi oye po Oyesu ko ga roza ole nu, kweyi Oyesu ga yagye ko roza. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Ishini onya ni wi inozalabi mani pwo mo Oyesu ya roza ole ko ongo ko oFarisi mani ni, obyo ogya ka ano kpeye, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Owa hagye itikpi ko Oyesu ya kyegba, ize ki iyi nu yo Oyesu ikpo gbinyi, ebeni oyi ikpo wa kpi inyeyi ki ikweyi nu, ogwi ikpo kweyi oki sha ano kpeye anu. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Ishini ongo ko oFarisi ni po Oyesu ni mo oza mani ni, oka ipu ko otu nu mo, &lt;&lt;Owoni ongo mani bi wi inobane obiya gyo onya ni ya gabo anu mani, kpe edo kase ni owe ni, owino ozalabi la.&gt;&gt;<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Oyesu kyogwu mo, &lt;&lt;Osimo, ngbe ela oye ko ka da awo.&gt;&gt;</para>
  <para style="p" vid="LUK 7:40">osimo ka mo, &lt;&lt;Ka da ami inofoza.&gt;&gt;<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Oyesu kamo, &lt;&lt;Ango epa myore ka ashe ni ya kpase ikwiri ni. Oye myore ko odinari ogbogbo eho, oye aweho<note caller="+" style="f"><char style="fr" closed="false">7.41 </char><char style="ft" closed="false">Odinari we enu ki ikwiri ko oko ke eno oye ishi oni </char></note>. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Pepa wa gege ko sore lo, oshi ikwiri oni bita da awa. Byonabani anoho ipu wa ya yimu ko ongo mani she?&gt;&gt;<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Osimo kyogwu mo, &lt;&lt;Ase ni myore nwashika ni.&gt;&gt;</para>
  <para style="p" vid="LUK 7:43">Oyesu ka da anu mo, &lt;&lt;Okepwo neneshi.&gt;&gt;<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Ebeni Oyesu pyi iyi to onya mani oka do Osimo mo, &lt;&lt;Omo onya mani? Ishini nwwo ole wo ni, oda ami inyawo ko nikpo lo, onya mani yumi ikpo na kpize kiyi nu oki wumikpo kpinyeyi ki ikweyi nu. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Ogwumi ikpo ishini nwwo ole wo ni lo, onya mani ke bwi ishini nwwa ni oyipu ko gwumi ikpo. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Onyuma ano ikweyi lo, onya mani ke shuma ano kpeye ikpo. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Ikweyi koni nyya ka da awo, ozalabi nu nwashika ayi na koni oyimu hin nwashika ni. Nyya kadala mo ase ni ozalabi nu le gbayayi ni ayi na imu nu ya le gbayayi kin la.&gt;&gt;<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Ebeni Oyesu ka da nu mo, &lt;&lt;Ayo ozalabi wo na.&gt;&gt;<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Ashishini ko ogboga ni bagye kpa awa ni kwotu ko diyiwa oka mo, &lt;&lt;Anu mani wa anoho ni ya no ozalabi?&gt;&gt;<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Oyesu ka do onya mani mo, &lt;&lt;Ga kpo otu mene, otuse wo ngma awo.&gt;&gt;<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Anya ni gboso Oyesu ni</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Itikpi ko omani Oyesu bose gogya leke kpo onyakwu, oya tono ko oshu neshi ko obula ko Owuso. Igwepa ni ga kpa anu, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />kweyi kpa ashishini ka anya ni angma awa shi ipu ko omaku bibi kpo ose ni; kpo Omeremu bwa agye ko Omagdalin ni omaku bibi ahapa bose ikpiye nu ni; <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Ojuwana onya ko Okuza, ni wo oteyi kole ko Ohiridu ni, kpo Osuzana kpa ashishini kase nwashika. Anya mani ba to Oyesu kpa awogboso abo kpo oza ni agbo ni.<verse eid="LUK 8:3" /></para>
  <para style="s">Elase ikweyi ko Osheho</para>
  <para style="r">(<ref loc="MAT 13:1-9">oMatiyu 13.1-9</ref>; <ref loc="MRK 4:1-9">oMak 4.1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Ni ewa gbayi ni, ase lewa we ebe ko Oyesu bwo ogya gogo-gogo, okelase da awa mo, <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />&lt;&lt;Osheho oye ge eho ko myizire, ishini oya myizire ni, ashishini shonu okoka ko owe, ebeni ano wayi kpo re. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Ashishini shonu ikweyi ko okpo, kweyi ishini abwu ni, agekwu koni agbagye nwashika lo ni. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Ashishini ki izire shonu ipu ki igye, kweyi igye gye yuwa bya. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Ashishini shonu ipu ka agye neshi. Agye kweyi gwi izire, ashishini ma asa ikpo ogbogbo oye, ni sho olamuni omyi ni.&gt;&gt;</para>
  <para style="p" vid="LUK 8:8">Ishini okela mani kweyi ni okamo, &lt;&lt;Ase ni gba akpaha ko pwe ela na pwo.&gt;&gt;<verse eid="LUK 8:8" /></para>
  <para style="s">Ikweyi ke Elase</para>
  <para style="r">(<ref loc="MAT 13:10-17">oMatiyu 13.10-17</ref>; <ref loc="MRK 4:10-12">oMak 4.10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Awogboso ka da anu mo ona gwi ikweyi kelase da awa. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Owuso kamo, &lt;&lt;Oza gyogye ko obula ki iso ni teba ni ayi gwa da ala, ase shishini nyya ka ipu kelase shini,</para>
  <para style="q1" vid="LUK 8:10">&lt;&lt;&lt;Aba ma, bya aba ma lo ni;</para>
  <para style="q2" vid="LUK 8:10">aba pwo, aba gyo oza ni aka ni lo.&gt;<note caller="+" style="f"><char style="fr" closed="false">8.10 </char><char style="ft" closed="false">ISH 6.9</char></note><verse eid="LUK 8:10" /></para>
  <para style="s">Oyesu Ki Ikweyi ke Elase Ikweyi ko Osheho</para>
  <para style="r">(<ref loc="MAT 13:18-23">oMatiyu 13.18-23</ref>; <ref loc="MRK 4:13-20">oMak 4.13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />&lt;&lt;Ikweyi kelase mani yoma: Izire we ela ko Owuso. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Oni shonu ikweyi ko owe ni wa awase ni pwo, kweyi ibiri ke wa yo oza ni apwo ni yi bize sho otu wa, shini ana ka kyogwu kpa anu shini ana pyo minyo lo. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Oni shonu ikweyi ko okpo ni lema bya awase ni pwe ela ko Owuso kweyi akyogwu kpo otushosha, ake gbo ogba loshu lo. Ayo otuse ki ishi gbayayi, ishini omama ke wa da awa ni akwikye itikpi. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Izire ni shonu ipu ki igye ni lema byo awase ni pwe ela ko Owuso, kweyi otu byobya ikweyi ko odu kpo onye ko yagye kese mani yuwa ma lo. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Izire ni ke shonu ikweyi ka agye neneshi ni lema bya awase ni pwo oshu kweyi ayi ti ipu ko otu neshi ni ya zikweyi iso loni, aha gye giri kweyi ami izire.<verse eid="LUK 8:15" /></para>
  <para style="s">Elase Ikweyi ki Ikwomu</para>
  <para style="r">(<ref loc="MRK 4:21-25">oMak 4.21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />&lt;&lt;Ashishe ya kwola ikwomu kweyi yayi leba ipu ke eyi kwe yi heye ko ogwudu lo. Apa ba yi hi ikweyi ko oka nu, shini ase ni ya wi ipu kole na mebe. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Ojoji ni ayi leba aba yifu tese, kweyi ojije ni gwogwu aba yi gwa. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Mani oni, ala gbera kpo oza ni ala pwo. Kpiri kase ni gbo oza aba fu manu da anu; kpiri kase ni gbo lo, ko ogbayayi ni ogbo ni aba yi bize sho.&gt;&gt;<verse eid="LUK 8:18" /></para>
  <para style="s">Ayene ko Oyesu kpi Inanu</para>
  <para style="r">(<ref loc="MAT 12:46-50">oMatiyu 12.46-50</ref>; <ref loc="MRK 3:31-35">oMak 3.31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Ene ko Oyesu kpa ayinanu wa ko mo, ake gege ko mo lo ikweyi koni ase lewa ebe ni. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Ashe ga ka da anu mo, &lt;&lt;Ene wo kpa ayene wo hagye ese, aba yimu ko mo.&gt;&gt;<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Okamo, &lt;&lt;Enen kpa ayene hin wa awase ni pwe ela ko Owuso ki yo oko kpa anu ni.&gt;&gt;<verse eid="LUK 8:21" /></para>
  <para style="s">Oyesu Yo Owu Nyakwu Hagye</para>
  <para style="r">(<ref loc="MAT 8:23-27">oMatiyu 8.23-27</ref>; <ref loc="MRK 4:35-41">oMak 4.35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Eno oye, Oyesu ka da awogboso mo, &lt;&lt;Ala gipu ko owu ki inyo shini ahan sheyi ki ishu ge ese.&gt;&gt; Ebeni agipu ko owu ki inyo ko sheyi. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Ni aba ga ni, ola yo bize. Ebeni owu nyakwu ta ikweyi ki ishu, kweyi owu ki inyo ya yimu ko ga agye, kweyi ebi ya yimu ko ruwa. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Awogboso Oyesu shi iyi mo, &lt;&lt;Adole, Adole, inyo ya yaha re!&gt;&gt;</para>
  <para style="p" vid="LUK 8:24">Onyiso kweyi ka do owu kpo ogwa ki inyo mo ana hagye. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Oda awogboso oka mo, &lt;&lt;Otuse kala yini?&gt;&gt;</para>
  <para style="p" vid="LUK 8:25">Ipu ko oshi kpi igbashi adi iyiwa oka mo, &lt;&lt;Omani wa anoho, no owu kpi inyo, ba apwe ela nu?&gt;&gt;<verse eid="LUK 8:25" /></para>
  <para style="s">Oyesu Do Ongo ni Gbo Omaku bibi ni Ogege</para>
  <para style="r">(<ref loc="MAT 8:28-34">oMatiyu 8.28-34</ref>; <ref loc="MRK 5:1-20">oMak 5.1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Oyesu kpa awogboso sheyi ki ishu ga agbabo ko oGerasa bwa agye ko Ogalili. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Ishini Oyesu sa ega ki ishu ni, ogbayi kpo ongo oye ni gbo omaku bibi bwo ogya ni. Ogbeji ni ongo mani ya osho oshiye lo ni, oya yo ole lo, oya kya ebe ka amiri. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Ishi no omo Oyesu ni, ozoko iso ya kyegba kweyi kamo, &lt;Oji ni oya yimu ebe hin, Oyesu, Oyi ko Owuso Ada Nyakwu? Nyya bo mo ka yumo ojije lo!&gt;&gt; <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Oka mani ikweyi koni Oyesu sho omaku bibi eha mo ona bose sho. Ongo mani ishi nwashika aba yo sha ashirika, oya ya aba yayi kweyi omaku bibi ya byo ge ebe ni gba ashishe lo ni. Ase ko Oyahuda.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Oyesu do oka mo, &lt;&lt;Iye wo wa anoho?&gt;&gt;</para>
  <para style="p" vid="LUK 8:30">Okyogwu mo, &lt;&lt;Iye hin wo nwashika,&gt;&gt; ikweyi koni omaku bibi nwashika bi ikpiye nu ni. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Awo omaku bibi mani bo Oyesu mo ona ka nawenya ga aleku lo.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Aruma nwashika ba ashikwu kikpokyi ba roza. Awomaku bibi mani bo Oyesu mo ona na awa enya gipu ka awaruma ni, kweyi oda awo okwunu. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Ishini awomaku bibi mani bose sho ongo mani, agipu ka awaruma mani, awaruma nyinya ga shonu ipu ki ishu, kweyi ishu yuwa re.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Awase ni ba gbeho ka awaruma mani mo oza ni gbodagye ni, anyinya gipu ko ogya ga gbi igwu ko oza ni gbodagye ni da awa ipu ka awogya leke kpo onyakwu, <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />kweyi ase bose ge ese ko ga mo oza ni gbodagye ni. Ishini awe ebe ko Oyesu ni, awa to ongo ni omaku bibi bose sho mani yagye obutu ko Oyesu, osho oshiye kweyi otu nu ka agye; kweyi oshi yuwa kwu. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Awase ni mo oza mani ka da ase oza ni omaku bibi ya kpo ongo mani ni ada nu ogege ni. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Ebeni ase ka agbabo ko oGerasa ka do Oyesu mo ona sho ogya wa bita, ikweyi koni oshi yuwa kwu ni. Ogipu ko owu ki ishu kweyi ganu.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Ongo ni omaku bibi bose sho mani bo Oyesu shini ona ga kpa anu, Oyesu ke ka da anu mo, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />&lt;&lt;Go ole ga ko oza ni Owuso ya da awo ni.&gt;&gt; Ebeni ongo mani gaga tono do ogya kpiri ikweyi ko oza ni Oyesu ya da anu ni.<verse eid="LUK 8:39" /></para>
  <para style="s">Onya ni Loshu lo ni kpo Oyi ko ojayirus</para>
  <para style="r">(<ref loc="MAT 9:18-26">oMatiyu 9.18-26</ref>; <ref loc="MRK 5:21-43">oMak 5.21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Ni Oyesu kwikye ni, ewa ka asuse yo omaba, koni ananoho ba gbeyi nu ni. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Ebeni ongo oye ni aba yogwu mo Oyayirus, oteyi ke ekpa we ebe ko Oyesu wa kwagye obutu nu kweyi bo mo ona go ole nu, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />ikweyi koni oyi nu ki ishayi igwepa nonya yo okwunu ki ikwu.</para>
  <para style="p" vid="LUK 8:42">Ni Oyesu yikweyi ko owe ko go ole ko ojayirus ni, ewa ka asuse ba sa abo. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Kweyi onya oye ye ebe ni ya gboyi ishayi igwepa, oyoji ni ogbo ipu koyagye nu ngmo dawoloboshi, ashishe ke gege da anu ogege lo. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Ebeni oyawu bwi itikpi wa ga abo oshiye ko Oyesu, ebebeni ogboyi nu hagye.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Oyesu doka mo, &lt;&lt;Anoho ga ami abo?&gt;&gt;</para>
  <para style="p" vid="LUK 8:45">Kpiri wa tawashu. Kweyi Obitrus kamo, &lt;&lt;Adole, ase lewa ba sa abo.&gt;&gt;<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Oyesu ke kamo, &lt;&lt;Ashe ga ami abo; nggye oshu bose ikpiyen.&gt;&gt;<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Ebeni onya ni, ma mo anu ya gege yaga mani kin lo, oshi yo kwu, kweyi obose wa kwagye obutu ko Oyesu. Obutu ka asuse kpiri, oko oza ni ya ni ogo Oyesu abo kweyi opyo ogege nu ebebeni. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Ebeni Oyesu ka da anu mo, &lt;&lt;Oyin, otuse wo da awo ogege, ga kpo otumene.&gt;&gt; <verse eid="LUK 8:48" /><verse number="49" style="v" sid="LUK 8:49" />Ni Oyesu tayayo ya kela ni, ase bwo ole ko ojayirus oteyi ke ekpa wa ka da anu mo, &lt;&lt;Oyi wo gekwu, ka yi inofoza apya kelo.&gt;&gt;<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Ni Oyesu pwo mani ni, oka do ojayirus mo, &lt;&lt;Ka yoshi lo; totuse, kweyi oyi wo ya pyo ogege.&gt;&gt;<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Ishini Oyesu pwo ole ko ojayirus ni, osha ashishe bita gipu kpa anu lo so Obitrus kpo Oyohana kpo Oyakubu, kpa ada kpe ene ko oyi mani. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Ase shishini ke be ese ba kyegba kpo otu byobya ikweyi ko oyi mani. Oyesu ke kamo, &lt;&lt;Ala she egba kyokye bita, ikweyi koni oyi mani gekwu lo, oke ya gbola kin la.&gt;&gt;<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Ayo Oyesu eye koni agye mo oyi mani gekwu ni. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Oyesu ke bya abo kweyi kamo, &lt;&lt;Oyin, nyiso!&gt;&gt; <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Omaku nu kwikye, kweyi otakpa nyiso. Ebeni Oyesu mo ana da anu oza na re. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Igbashi ya ada kpe ene ko oyi mani kwu. Oyesu pyuwa akpaha ma ana ka ka da ashishe oza ni gbodagye mani lo.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Oyesu ta Awogboso Igwepa Oleho</para>
  <para style="r">(<ref loc="MAT 10:5-15">oMatiyu 10.5-15</ref>; <ref loc="MRK 6:7-13">oMak 6.7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Ishini Oyesu ya awogboso igwepa ogwu gbayi ni, oda awo oshu ko no omaku bibi enya kweyi da awine ko ose ogege, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />kweyi otuwo oleho ko ga tono ko obula ko Owuso, ana ki da awine ko ose ogege. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Kweyi oka da awa mo, &lt;&lt;Ala ka zo ojije ki iyawu lo, kwe okposhi, kwe oshu, kwo ikyoga, kwe ikwiri, kwe oshiye. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Ole ni ala ga anu kpiri, ala banu gbishini ala sho ogya ni bita. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Owoni ase ya ala omaba lo, ala gwo omutu ki ikpo kala ishini ala ba sho ogya ni bita, oni ya na wo olobene ikweyi wa.&gt;&gt; <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Bwebeni abose gogya gogya, ba tono ko oshu neshi aki ba da ase ogege ebebe nya.<verse eid="LUK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Ishini oteyi Ohiridus pwo oshu ko oza ni gbodagye ni. Kweyi oshi yo kwu ikweyi koni ashishini ba kamo Oyohana shiyi bwa amiri, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />ashishini mi Iliya bose, kweyi ashishini mo inobane nekye oye pini bose la. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Ohiridus ke kamo, &lt;&lt;Nyyo Oyohana ikweyi ngma. Anoho ni nyya pwe ela mani ikweyi nu ni?&gt;&gt; Kweyi oya yimu ko mo.<verse eid="LUK 9:9" /></para>
  <para style="s">Oyesu da ase okpaku eho ozarore</para>
  <para style="r">(<ref loc="MAT 14:13-21">oMatiyu 14.13-21</ref>; <ref loc="MRK 6:30-44">oMak 6.30-44</ref>; <ref loc="JHN 6:1-14">Oyohana 6.1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Ishini ayikoko ko Oyesu ko Oyesu kwikye ni, aka da anu oza ni aya ni kpiri. Ebeni obyuwa gogya ko Obetseda, <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />ewa ka asuse ke gye ebeni aba ga ni kweyi agboso. Oyuwa omaba oki kela da awa ikweyi ko obula ko Owuso, oki da awase ni gbo ose ni ogege.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Ni eno ya sha ni ayikoko ko Oyesu igwepa ni wa ta anu kweyi kamo, &lt;&lt;Ashishe be ebe mani lo, ka da awase mani na gogya leke kpo onyakwu naga labo ko oza rore kpe ebe ko kya ikweyi koni ebe ko kya ye ebe mani lo.&gt;&gt;<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Okyogwu mo, &lt;&lt;Ala da awo oza rore shini ana re.&gt;&gt;</para>
  <para style="p" vid="LUK 9:13">Akamo, &lt;&lt;Aha gbo ikyoga eho kpe ebinyi epa kin la, kwe an ga roza rore wa da awase mani kpiri?&gt;&gt; <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Ango okpakwu eho pini be ebeni la.</para>
  <para style="p" vid="LUK 9:14">Oke ka da awogboso mo, &lt;&lt;Ala yuwa na bagye ikpo ikpo ase awa aweho.&gt;&gt; <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Awogboso ya mani, kweyi ananoho bagye okpagye. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Oyesu zo ikyoga eho kpe ebinyi epa kweyi otiyi mi iso, kweyi osho Owuso iye, oyi kyigbo. Ebeni oda awogboso, kweyi ako da ase. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Kpiri wa ha yipu, kweyi awogboso kpo shishini sho ogwugwu igwepa.<verse eid="LUK 9:17" /></para>
  <para style="s">Obitrus kase ni Oyesu we ni</para>
  <para style="r">(<ref loc="MAT 16:13-19">oMatiyu 16.13-19</ref>; <ref loc="MRK 8:27-29">oMak 8.27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Eno oye Oyesu ya tinarigwu anu fufunu, kweyi awogboso bagye kpa anu. Oduwo oka mo, &lt;&lt;Anoho ni ase ba ka mo ami we?&gt;&gt;<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Akyogwu mo, &lt;&lt;Ashishini mo owo Oyohana ino Obatisma, ashishini kamo owi Iliya, ashishini mo owo oye ipu ka awinobane nekye pini kwikye ya gbo layi la.&gt;&gt;<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Oduwo oka mo, &lt;&lt;Ala ke, anoho ni ala kamo nwwe?&gt;&gt;</para>
  <para style="p" vid="LUK 9:20">Obitrus kamo, &lt;&lt;Okristi ko Owuso.&gt;&gt;<verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Oyesu pyuwa akpaha kamo ana kaka da ashishe lo. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Kweyi okamo, &lt;&lt;Oya wo otiri shini awanyakwase kpo ose ka awosapa kpa awofono, na do Oyi ka Asuse owe nwashika. Aba tela nu ki ba yo ngmo, oki ya nyiso eno ko omweta.&gt;&gt;<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Ebeni Oyesu ka da awa mo: &lt;&lt;Ase ni ya yimu ko gbosun, ona tela ki iyinu ishi kpiri na zo oshi nu na gbosun. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Ase ni ya yimu ko gbo olayi nu oya yi tonu, ase ni ke yo olayi nu tonu ikweyin, oya yo gbo. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Ojiya shoshi da asuse owoni opyo oza kese mani kpiri okwunu ko olayi nu? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Ase ni yi iweyi hin kpe ela hin, Oyi ka Asuse ya yi iweyi nu ishini oyawa ipu kigyashi nu kpigyashi ka Ada kpa aka ayoleho sere. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Nyya kadala okwokwoshi, ashishini kala ni hagye ebe mani ni, aba gekwu ome ba mo obula ko Owuso lo.&gt;&gt;<verse eid="LUK 9:27" /></para>
  <para style="s">Ikpiye ko Oyesu Pya</para>
  <para style="r">(<ref loc="MAT 17:1-8">oMatiyu 17.1-8</ref>; <ref loc="MRK 9:2-8">oMak 9.2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Oyesu kela mani kpe eno ahata, kweyi oyo Obitrus kpo Oyohana kpo Oyakubu ogwu, kweyi atoshi gi iso ke efu ko tinarigwu. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Ni oya tinarigwu ni, aheyi nu pya, kweyi oshiye nu ki pya wo shehe purututu. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Ango epa, Omusa kpi Iliya, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />bose ipu kigyashi neshi ba kela kpo Oyesu. Aba kela ikweyi ki ikwu nu ni oyawa gbodagye Ojerusele ni. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Ola yo Obitrus kpa awoya ki iyawu nu bize ge ebe lenu, ishini ake shiyi ni, amo ipu kigyashi nu, kpa ango epa hagye kpa anu. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Ni ango mani ba sho Oyesu bita ni, Obitrus kamo, &lt;&lt;Adole, oshoshi ni aha be ebeni ni, an gwa adaba eta, oye na wa akakoho, oye na wa ko Omusa, oye na wa aki Iliya.&gt;&gt; Obitrus gyo oza ni oya ka ni lo.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Ni Obitrus yipu kela ya ka ni, akpa sa wa yuwa gwu, kweyi oshi yuwa kwu ni abi ipu ka akpa ni. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Oko bwi ipu ka akpa ya kamo, &lt;&lt;Omani pini wo Oyi hin, ni ami shu ni la. Ala ya akpaha tagye shini ala pwo oza ni oya kani.&gt;&gt; <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Ishini oko mani kela kweyi ni, amo Oyesu fufunu hagye. Awogboso ka da ashishe oza ni ama ni lo.<verse eid="LUK 9:36" /></para>
  <para style="s">Oyesu do oyi nongo oye ni gbo omaku bibi ni ogege</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Gbe ebenya asa bwi iso ke efu, ewa kase wa ta anu. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Ongo oye ipu ke ewa wa kyegba do Oyesu mo, &lt;&lt;Inofoza, nyya bo mo wa mo oyin. Anu fufunu woyin la. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Omaku bibi yo oyin kwu, kweyi oyo ya sheha; oki yi ikpikpi kwo kweyi okwunu nu ya kyowu. Oya shobita lo so oyo ofo. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Nba awogboso ko nenya, agege lo.&gt;&gt;<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Oyesu kyogwu mo, &lt;&lt;Ala ase ki ishi mani, awo gbotuse lo ki gbo otu meme, gbi ishi wonya ni nyya yagye kpa ala? Gbi ishi wonya ni nyya gbotu kpa ala? Byo oyi wo we ebeni.&gt;&gt;<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Ni oyi mani yawu ya we ebe ko Oyesu ni, omaku bibi yi ikpikpi gwo tonu. Oyesu ke gbo omaku bibi eha, kweyi oyi mani pyo gege, kweyi oyo da Ada nu <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Kweyi igbashi ya ananoho kwu ikweyi koni amo neneshi ko Owuso ni.</para>
  <para style="p" vid="LUK 9:43">Igbashi ya ananoho kwu ikweyi ko oza ni Oyesu ya ni. Oka da awogboso mo, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />&lt;&lt;Ala ya akpaha tagye shini ala pwo oza ni nyya kadala mani: Aba yo Oyi ka Asuse ya ra kweyi yo nabo ya da ase.&gt;&gt; <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Awogboso ke gyo oza ni oya ka ni lo. Ayikweyi kela mani yi teba da awa, agyo oza ni owe ni lo, aba yoshi ko do Oyesu oka.<verse eid="LUK 9:45" /></para>
  <para style="s">Anoho ya wo Oneneshi</para>
  <para style="r">(<ref loc="MAT 18:1-5">oMatiyu 18.1-5</ref>; <ref loc="MRK 9:33-37">oMak 9.33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Ebeni awogboso kwotu ko tawashu kpi iyiwa ikweyi koni anoho ya wo oneneshi. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Oyesu gyo oza ni yipu ko otu wa ni, okwo oyi leke wa hagye ashikwu nu. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Ebeni oka da awa mo, &lt;&lt;Kpiri kase ni yo oyi leke mani omaba ipu ki iyen, oyumo omaba pini yoma; ase ni yumo omaba oya ase ni tumo oleho ni oma. Koni ase ni le titi ipu kala anu pini wo oneneshi la.&gt;&gt;<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Oyohana kamo, &lt;&lt;Adole, aha ma ashe ya no omaku bibi enya ipu ki iye wo kweyi aha takirikwu wobi; ikweyi koni oyipu ka aha lo ni.&gt;&gt;<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Oyesu kamo, &lt;&lt;Ala ka wobi lo, ikweyi koni ase ni wo omonye-kwotu wo lo, owa akaka wo la.&gt;&gt;<verse eid="LUK 9:50" /></para>
  <para style="s">Awo Osamariya tela ko Oyesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Ni ishi ba pya koni aba zo Oyesu ya giso ni, ozo otu nu ko go Ojerusele. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Kweyi ota ayoleho nu oleho yohobu gogya kase ko Osamariya ko ga kye ebetu gbeyi nu; <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />awase ni bebeni ke tela ko yo omaba ikweyi koni amo yowe ko go Ojerusele ni. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Ishini awogboso, Oyakubu kpo Oyohana ma mani ni, ado oka mo, &lt;&lt;Adole, oya yimu shini ahan yo ola ogwu bwi iso shini na ya awase mani yi la?&gt;&gt; <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Oyesu ke pya kweyi opyuwa akpaha, <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />abose gogya oye.<verse eid="LUK 9:56" /></para>
  <para style="s">Owe ko gboso Oyesu</para>
  <para style="r">(<ref loc="MAT 8:19-22">oMatiyu 8.19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Ni aba yawu ikweyi ko owe ni, ongo oye wa ka da anu mo, &lt;&lt;Nyya gboso ge ebeni oya ga kpiri.&gt;&gt;<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Oyesu kyogwu mo, &lt;&lt;Iwo-apashi gbo ogo wa, igbano ni yawu iso gbo ole wa, oyi ka Asuse ke gbe ebe ko kya lo.&gt;&gt;<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Oka da ashe hoha mo, &lt;&lt;Gbosun.&gt;&gt;</para>
  <para style="p" vid="LUK 9:59">Ongo mani ke kyogwu mo, &lt;&lt;Adole, na ga ya Ada hin nyi ome.&gt;&gt;<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Oyesu ke ka da anu mo, &lt;&lt;Sha awokwu bita na nyo okwu wa, awo ke ga shini oga tono ko obula ko Owuso.&gt;&gt;<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Ashe ki ka mo, &lt;&lt;Nyya gboso, Adole, ke shun bita na ga ka da ase ki ipwoma hin ma ana mowa hin.&gt;&gt;<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Oyesu kyogwu mo, &lt;&lt;Ase ni bye enu kweyi ya pyi iyi ya mi itikpi, oshu ko go obula Owuso lo.<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Oyesu ta ase awahapa ayepa oleho</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Itikpi ko oza mani Adole sha ase awahapa ayepa kpase shishini kweyi tuwo oleho ase epepa bo ohobu nu gogya ni oya yimu ko ga ni. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Oka da awa mo, &lt;&lt;Izire ko kye nwashika, awo yo oko ke le gbayayi. Tinarigwu Adole ine ke eho shini na sa awo yo oko nwashika abo gipu ke eho ga yo oko. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Ala ga! Nyya sa ala abo bya aso oyi ko otukpo abo go otutehe ka awiwo ni. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Ala ka zo oshu ki iyo kwe ki ikwiri kwe okpabawu lo; ala ka ta ashishe ogbogba owe lo.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />&lt;&lt;Ishini ala gipu kole, ikyikyo ala kamo, &lt;Omene na yo kpo ole mani.&gt; <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Owoni ase gbo otu mene ye ebe ni, eshi ko omene kala na yo kpa anu; owoni olemani lo, omene kala ya kwikye we ebe kala. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Ala bagye ole ni, ala re ala gwo oza ni ada ala kpiri, ikweyi koni ino yoko shu ko pya abola. Ala ka bwo ole bwo ole lo.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />&lt;&lt;Ishini ala gogya ni aya ala omaba, ala roza ni ada ala ni. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Ala da awase ni loshu lo ni be ebeni ogege kweyi ala ka da awa mo, &lt;Obula ko Owuso wa pee kpa ala.&gt; <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Ishini ala ke gogya kweyi atela ko ya ala omaba, ala gi ikweyi ko owe, kweyi ala kamo, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />&lt;Kwo omula ko ogya kala ni ba aha ikpo ni ayi gwo shonu shini na wo olobene ikweyi kala. Ala gye mo: Obula ko Owuso yo pee.&gt; <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Nyya kadala, eno ko ke epwo, Owuso ya dase ko ogya ni owe ni sha kase ko Osodom ni!<verse eid="LUK 10:12" /></para>
  <para style="s">Ogya ni tela ko Oyesu ni</para>
  <para style="r">(<ref loc="MAT 11:20-24">oMatiyu 11.20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />&lt;&lt;Igbe na ta ala ase ko Okorazi kpo Obetseda! Oza ki igbashi ni nyya ogya kala ni abi ya okpagye ko Otaya kpo Osidon, ase ke ebeni bi sho oshiye ko otu byobya, kweyi abi shi iyawu ikpiye shini ase na mamo asho ozalabi wa bita. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Eno ko kepwo oyawa labi da ala sha ako Otaya kpo Osidon. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Kweyi awo Okapanahu, oya yimu ana nga awo iso? Aayi, aba to go ola.&gt;&gt;<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />&lt;&lt;Ase ni pwe ela kala, opwe ela hin, ase ni tela kala otela hin, ase ni ke tela hin otela kase ni tumo oleho ni.&gt;&gt;<verse eid="LUK 10:16" /></para>
  <para style="s">Okwikye kase awahapa ayepa</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Ase awahapa ayepa ni kwikye kpo otunehe kweyi kamo, &lt;&lt;Adole, omaku bibi geyagye daha ipu ki iye wo.&gt;&gt;<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Okyogwu mo, &lt;&lt;Nmi Ibiri ya gbo bwi iso byo ola ka akpula ni. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Ala pwo! Ndala oshu shini ala yawu ikweyi ke egwa kpe ena, kweyi oshu kala na sha ko omonyekwotu kala; kweyi ojije ya ta ala lo. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Ala ka shotunehe koni ibiri geyagye da ala ni lo, ala ke shotunehe koni ati iye kala ipu ki iso ni.&gt;&gt;<verse eid="LUK 10:20" /></para>
  <para style="s">Oyesu shotunehe ipu ko Omaku ko Owuso</para>
  <para style="r">(<ref loc="MAT 11:25-27">oMatiyu 11.25-27</ref>; <ref loc="MAT 13:16-17">13.16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Ipu ki ishi oni otu ko Oyesu nwu kpo otunehe bwe ebe ko Omaku ko Owuso kweyi okamo, &lt;&lt;Nyya sha awo iye Ada, Adole ki iso kpo okpagye, ikweyi koni oyo oza mani yi teba da awase ni ziyi kpa awase ni gyo oza ni kweyi oyi shiya ayileke. Olemani, Ada, omani wo oza ni sho otu ni la.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />&lt;&lt;Ada hin yo ojoji kpiri yi da ami. Ashishe gya ase ni Oyi we nilo sa Ada nu, kweyi ashishe ki gya ase ni Ada we nilo so Oyi kpase ni Oyi yimu ko yo shiya awa ni.&gt;&gt;<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Ebeni opya ge ebe ka awogboso kweyi kela da awa kyo mo, &lt;&lt;Otunehe yo kpi iyi ni mo oza ni ala mani. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Nyya kadala okwokwoshi mo awobane nwashika kpo ose yimu ko mo oza ni ala mani, ake ma lo, ko pwo oza ni ala pwo ni, ake pwo lo.&gt;&gt;<verse eid="LUK 10:24" /></para>
  <para style="s">Elase ikweyi ko ongo ko Osamariya ni gbi iyinyinyi ni</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Ishi oye, inofono oye nyiso hagye iso ko mo Oyesu ma. Odo oka mo, &lt;&lt;Inofoza, ojini nyyaya shina pyo olayi ko gbogbo-gbogbo?&gt;&gt;<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Okyogwu mo, &lt;&lt;Oji ni ata ipu ko okpa ko ono? Oma moji ipu ni?&gt;&gt;<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Okamo &lt;&lt;&lt;Yimu ka Adole Owuso wo kpo otu wo kpiri, kpo omaku wo kpiri, kpo oshu wo kpiri, ki kpo ogyogye wo kpiri&gt; kweyi, &lt;Yimu ko oya ko oyagye wo byoni oyimu ki iyo ni.&gt;&gt;&gt;<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Oyesu ka da anu mo, &lt;&lt;Okela gyogye, ya mani oya pyo olayi.&gt;&gt;<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Anu ke ya yimu ko shiyo Oyesu mo anu gbo ozalabi lo, odo oka mo, &lt;&lt;Anoho wo oya ko oyagye hin?&gt;&gt; <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />Oyesu kyogwu mo, &lt;&lt;Ongo oye bwo Ojerusele wa go Ojeriko, owa ga abo ka awowiyi. Ayo oshiye ke, agwo gbi ishini osheku kweyi aga wa. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Osapa oye wa shigbo bwo owe ni, ishini omo ongo mani ni, obwo okoka kweyi ganu. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Mamani ongo oye bwi ipwoma ko Olawi, obwe ebeni kweyi omo, obwo okoka kweyi ganu. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Ongo ko Osamariya oye ke wa shigbo, obwe ebeni ongo mani gwutagye ni, omi iyinyinyi nu. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Oge ebe nu, ga bo oza ipi, kweyi sha ano kpi inyi anu. Ebeni oyo ongo mani yi ti ikweyi ko odagyi nu kweyi byo go ole ka awogboga kweyi yi iyi kwo. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Ni ebe nya ni oda ase ni ya yi iyi kwe ebeni ni opami epa kweyi kamo, &lt;Yi iyi kwo, ishini nkwikye wa, nyya da awo oza ni ongmo ikweyi ko ikwiri ni ndawo mani.&gt;<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Oyesu do oka mo, &lt;&lt;Anoho ipu kase eta mani ni oma mo owo oya ko oyagye ko ongo ni awowi gwo mani?&gt;&gt;<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Inofono kyogwu mo, &lt;&lt;Ase ni mi iyinyinyi nu ni.&gt;&gt; Oyesu ka da anu mo,</para>
  <para style="p" vid="LUK 10:37">&lt;&lt;Awo, gaya mamani.&gt;&gt;<verse eid="LUK 10:37" /></para>
  <para style="s">Oyesu go ole ko Omata kpo Omeremu</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Ni Oyesu kpa awogboso yawu ba ga ni, apwo ogya leke oye ebe ni onya oye ni aba yogwu mo Omata ni gwofunu kole nu da anu. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Omata gbo oyene oye, iyenu wo Omeremu, owa yagye obutu ka Adole ya pwe ela ni oya kani. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Omata ke iyi nu yebe ko yo ozarore. Owebe nu wa kamo. &lt;&lt;Adole, oko ojije lo, oyene hin shun bita yayo oko fufun? Ka danu na wa tumabo!&gt;&gt;<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Adole kamo, &lt;&lt;Omata, Omata, oya byotu ikweyi ko oza nwashika, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />oje oye kponu pini oke ya yimu la. Omeremu zo oza ni shoshi she ni, kweyi aba gege ko yi bize sho lo.&gt;&gt;<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Ozafofu ko Oyesu Ikweyi ki Inarigwu</para>
  <para style="r">(<ref loc="MAT 6:9-13">oMatiyu 6.9-13</ref>; <ref loc="MAT 7:7-11">7.7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Eno oye Oyesu ya tinarigwu ebye, ishini otinarigwu kweyi ni, oye ipu ka awogboso ka da anu mo, &lt;&lt;Adole, faha inarigwu tota byoni Oyohana fa awogboso ni.&gt;&gt;<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Oka da awa mo, &lt;&lt;Ishini ala ba tinarigwu, ala kamo,</para>
  <para style="q" vid="LUK 11:2">&lt;&lt;Ada, iye wo na yo sere, obula wo nawa. <verse eid="LUK 11:2" /><verse number="3" style="v" sid="LUK 11:3" />Da aha ozarore ke eno ki ikyeni. <verse eid="LUK 11:3" /><verse number="4" style="v" sid="LUK 11:4" />Yo ozalabi ka aha gbaha, byoni aha gba awase ni yaha ozalabi ni. Ka bya aha gipu ko omama lo.&gt;&gt;<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Oyesu ka dawa mo, &lt;&lt;Ana kamo ashe ipu kala gbo oya, kweyi oge ebe nu otutehe ko otu kweyi kamo, &lt;Oya, kpa ami ikyoga eta, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />oya hin oye bwi iyawu wa sa ebe hin anani, Ami ke gbo ozarore ko danu lo.&gt;<verse eid="LUK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7" />&lt;&lt;Ebeni ase ni yipu ko oda ni kamo, &lt;Ka yumo ogidigidi lo. Ami kpa ayi hin ba gbola, ayofunu ka aha gwu wa. Nyya gege ya yiso ya da awo ojije lo.&gt; <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Nyya kadala, owoni oya gege ya nyiso ya danu ikyoga koni owo oyanu ni lo, oya nyiso wa danu koni ogwi iweyi shonu ni, kweyi wa danu oza ni oya yimu ni.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />&lt;&lt;Nyya kadala mamani: Doka, aba da ala, tikpo, ala ba pye, gwabo ofunu, aba gwa da ala. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Koni kpiri kase ni ba aba danu: ase ni tikpo oya pye, ase ni gwabo ofunu, aba gwofunu danu.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />&lt;&lt;Ada wonya ipu kala ni, owoni oyinu do oka ke ebinyi kweyi ona danu egwa? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Kwe owoni odoka ka ayi, kweyi ona danu ena? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Owoni ala ase bibi ba gye ko da ayi kala oza neshi, oya lemoji kpa Ada kala ni yi iso ni ya da ase ni do oka ko omaku ko Owuso ni!&gt;&gt;<verse eid="LUK 11:13" /></para>
  <para style="s">Oyesu kpo Obelizebu</para>
  <para style="r">(<ref loc="MAT 12:22-30">oMatiyu 12.22-30</ref>; <ref loc="MRK 3:20-27">oMak 3.20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Oyesu ya ngmo omaku bibi ni yo ongo oye ya kela lo ni. Ishini omaku bibi mani bose ni, ongo oni kwotu ko kela, igbashi ya ase ni be ebeni ni yi kwu. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Ashishini wa ke kamo, &lt;&lt;Obelizebu, ose ko omaku bibi pini danu oshu ko ngma awa la.&gt;&gt; <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Ashishini kase moma ba doka ki igbashi oye bwi iso.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Oyesu gyo oza ni yo otu wa ni, oka da awa mo, &lt;&lt;Obula ni ba gbapwo kpi iyiwa, oya hagye lo, kweyi ole ni kepa ya kye. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Owoni obula ki Ibiri kepa, owe wonya ni oya hagye? Nka mani ikweyi koni ala mo ngmo omaku bibi kpo oshu ko Obelizebu ni. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Kweyi owoni Obelizebu pini da ami oshu ko ngmo omaku bibi la, oshu wonya ni awogboso ba ngma awa kpa anu? Olemani, aba wa awino kwa ala epwo! <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Owoni nke ya ngmo omaku bibi kpo oshu ko Owuso, obula ko Owuso wa da ala pini yoma.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />&lt;&lt;Ishini ino oshu wi iyinu shu ya gbeho kole nu, ojije ya ti iyo nu lo. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Ishini ashe ni ke loshu sho ni wa nonu kpa anu kweyi gwagye, oya yi iyo ke efu ni ba abo nu yayi kpo kweyi ki ya yi iyo ya kpo. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />&lt;&lt;Ase ni yo kpa ami lo owo omonyekwotu hin la, kweyi ase ni kpo tukpa kpa ami lo, oya yi pasha.<verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />&lt;&lt;Ishini omaku bibi bose shi ikpiye kase, oya bose gipu ko ododa kweyi ga labo kebe ko minyo. Kweyi owoni opye lo, oya kamo, &lt;Nyya kwikye go ole ni nbose bwa anu ni.&gt; <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Ishini okwikye ni, oga mo ole ni obose ni ayigwu ki kyanutu neshi. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Ebeni okwikye ga kpo omaku bibi ahapa ni gbotu bibi sha sho ni, kweyi kpiri wa wa gi ikpiye ka anu oni kweyi bagye ebeni. Kweyi otu ko ongo ni labi sho nekye-nekye.&gt;&gt;<verse eid="LUK 11:26" /></para>
  <para style="s">Otunehe ko Otata</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Ni Oyesu ya kela mani ni, onya oye ipu ke ewa sheha mo, &lt;&lt;Otunehe yo kpo onya ni mo ki da awo ame gwa ni.&gt;&gt;<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Oyesu kyogwu mo, &lt;&lt;Otunehe ke yo kpa awase ni pwela ko Owuso kweyi yo oko kpanu.&gt;&gt;<verse eid="LUK 11:28" /></para>
  <para style="s">Oyesu kpo Oyunana (Omt. 12.39-42)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Ni ewa ka asuse wa tukpa ni, Oyesu kamo, &lt;&lt;Omani wi ishi bibi la. Aba doka ko oza ki igbashi, nyya yo oza ki igbashi oyoye da ala lo, so oni gbodagye kpo Oyunana ni. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Byoni Oyunana wi igbashi do Onineba ni, mamani Oyi ka Asuse ya we da ase ki ishi mani. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Inole ko Osheba wa nyiso ya ka dala eno ko kepwo mo, ala yo ozalabi ase kishi mani, koni owa bwe ebe lenu wa pwela gyogye ko Osolomo, onabani ase ni sho Osolomo ni yoma. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Ango ko Onineba ba wa hagye eno ko kepwo kpase ki ishi mani kweyi ba kwuwe epwo, ikweyi koni ashagbotu ishini Oyunana ya tono ni, onabani ase ni sho Oyunana ni yoma.<verse eid="LUK 11:32" /></para>
  <para style="s">Ikwomu ki Ikpiye</para>
  <para style="r">(<ref loc="MAT 5:15">oMatiyu 5.15</ref>; <ref loc="MAT 6:22-23">6.22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />&lt;&lt;Ashishe ya kwola ikwomu kweyi yayi leba, kwe oya yipu ko ogwugwu lo. Oke ya kwu ya yi hi ikweyi ko oka nu shini ase ni ba wi ipu na mebe. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Iyi kala wo ikwomu ki ikpiye la. Ishini iyi kala shoshi, ikpiye kala kpiri ba yu. Owoni iyi ke shoshi lo, ikpiye kala kpiri ba dibu. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Gye ipu ko otu wo mo oyoyu ni ogbo ni wa ke ebe dibu lalo. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Ni olemani, owoni ogbo oyoyu ni gbe ebe dibu lo ni, oya we ebe yoyu byoni oyoyu ki ikwomu yayu ikpiye wo ni.<verse eid="LUK 11:36" /></para>
  <para style="s">Igbe na ta Awofarisi kpa Awofono</para>
  <para style="r">(<ref loc="MAT 23:1-36">oMatiyu 23.1-36</ref>; <ref loc="MRK 12:38-40">oMak 12.38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Ni Oyesu kela kweyi ni, ongo ko Ofarisi oye kanu ko go ole nu ga roza, oga yagye ikweyi ko oka. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Igbashi ke ya ase ko ofarisi ni yo ogwu ni kwu koni omo yagye ko roza kweyi onabo byoni ono ka ni lo.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Ebeni Adole ka da anu mo, &lt;&lt;Ala Awofarisi ba gbera kpe ese ka abwa kpo ogo kweyi ba yina neneshi ipu ko otu kala ke nwu kpi imu ki iyi kala kpo otu labi. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Ala awikyo! Owuso ni ye ese ni pini yipu lalo? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Ala yo oza ni yipu ko ogo ni yi do oleha kweyi ojoji yawo neshi dala.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Igbe na ta ala Awofarisi koni ala ba zo oye ipu kigwo do Owuso, bwipu kiyo kefu ko obobo kpi ikpako kpiri, ala ke tela ko yo okwokwoshi kpimu ko Owuso. Awomani pini woza ni ala shu ko ya, wa ko sho ashishini bita lalo.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />&lt;&lt;Igbe na ta ala Awofarisi, ala ba yimu shini ana da ala ebe ko yagye neneshi ekpa, ana ki bi ta ala ogbogba ipu ki ipishi.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />Igbe na ta ala, ala lema bya amiri na ase gyo oyi nu lo, kweyi ba yawu ikweyi nu ni.&gt;&gt;<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Bwebe ni oye ipu ka awofono ka do Oyesu mo, &lt;&lt;Inofoza, ishini ni oka mani, osa aha esa oma!&gt;&gt;<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Oyesu kyogwu mo, &lt;&lt;Igbe na ta ala awofono, ala ba kpiyo lenu ko sa ase ni ba gege ya bi lo ni, ala abiyikala ke kwi ikpiye kala kyokya ko tuwabo lo.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />Igbe na ta ala, ala ma amiri kawo bane, awokyikyi kala pini ke ngmuwa la. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Ala abiyikala yo olobene, ala ki kyogwu kpo oza ni awokyikyi kala ya ni. Angma awinobane, ala ma amiri wa. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Oza ni ya ni oziyi ko Owuso ya kamo, &lt;Nyya ta awinobane kpa ayikoko ko Oyesu oleho ebe wa. Aba ngma ase shishini ki ba da ase shishini owe.&gt; <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Ikweyi koni aba da ase ki ishi mani owe ikweyi ko ngmongmo ni angma awinobane bwi ishini aye ese ni, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />bwi ikweyi ko oyi ka Abila gi ikweyi ko Ozakariya, ni ayi ngmo obepa ko okpe ko shokoyi kpo oda sere ipu ko Ole ko Owuso. Nyya kadala okwokwoshi, aba da ase ki ishi mani owe ikweyi ko oza mani kpiri.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />&lt;&lt;Igbe na ta ala awofono, ala byo obakofunu ko ozagyogye. Ala abiyikala gipu nu lo, ala ke sha awase ni ba yimu ko gipu nu bita na ganu lo.&gt;&gt;<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Ishini Oyesu she ebe ni bita ni, awofono kpa Awofarisi ke iyi wa gola kweyi akwotu ko bo ogo kpo oka doda, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />aba tikpo ko owe ko kwo kpo oza ni oya ka ni,<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Akpaha Pyopyi Ikweyi ka Awoyoziyi</para>
  <para style="r">(<ref loc="MAT 10:28-31">oMatiyu 10.28-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Ishini ewa ka asuse nwashika gbayi kweyi akwotu ko bi iyiwa ikpo, Oyesu ko kela da awogboso ikyikyo kamo, &lt;&lt;Ala gbera kpo oyisi ka Awofarisi ni wa awoyoziyi ni. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Ojoji ni ayi teba ni aba yi fu tese, kwe oza ni aya ipu ke ebe dibu kpiri aba yi fu tese. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Oza ni ala ka otu, aba pwo eno, kweyi oza ni ala ka kyo ipu ko oda, aba yi ka nwa ese da ase na pwo.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />&lt;&lt;Nyya kadala, awoya hin, ala ka yoshi kawase ni ba ngmi ikpiye kweyi, itikpi nu aba gege ko yo ojije lo. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Ami ke ya shiya ala ase ni ala shu ko yoshi nu ni. Ala yoshi kase ni gbo oshu ko yi ikpiye ngmo ki gbo oshu ko yota go ole ko ola. Ko kwokwoshi, yoshi nu. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Aba yi igbano eho yi ra ikweyi ki ikwiri epa lalo? Ni olemani oni, oyoye ipu wa Owuso nwanyi kpa anu lo. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Ko okwokwoshi, inyeyi ki ikweyi kala, ayi koka la. Ala ka yoshi lo; ala shi igbano nwashika.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />&lt;&lt;Nyya kadala, kpiri kase ni hagye kweyi kyogwu manu wa akakan obutu ka asuse, Oyi ka Asuse yaya mamani da anu obutu ka ayoleho ko Owuso. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Ase ni ke te elan obutu ka asuse, aba te ela nu obutu ka ayoleho ko Owuso. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Kweyi kpiri kase ni kela bibi ikweyi ko Oyi ka Asuse aba yo na, ase ni ke kela karigbetu ikweyi ko Omaku ko Owuso aba yo na lo.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />&lt;&lt;Ishini abyo ga awekpa, kwe ebe ka awoteyi kpo ogoneti, ka byotu ikweyi ko oza ni oya ya ko ngmiyo kwo oza ni oya ka ni lo, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />koni Omaku ko Owuso ya fo oza ni oya ka ipu ki ishi oni.&gt;&gt;<verse eid="LUK 12:12" /></para>
  <para style="s">Elase ikweyi ko olodu ni wi ikyo ni</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Ebeni ashe ipu ke ewa ka da anu mo, &lt;&lt;Inofoza, ka do oyenen na yo ogwu ko kpa ami.&gt;&gt;<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Oyesu kyogwu mo, &lt;&lt;Ongo, anoho zun wine ko kepwo kwe ino kyela kala gwo?&gt;&gt; <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Ebeni oka da awa mo, &lt;&lt;Ala gbera! Ala kyiyi kala tu she edo kimu kiyi kala kpiri, olayi ka asuse ye ebe ko oza nwashika ni ogbo ni lalo.&gt;&gt;<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Kweyi okelase mani da awa mo, &lt;&lt;Eho ko olodu oye yi izire neshi. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Oka di iyinu mo, &lt;Nyya ya moji? Nggbebe ko kpi izire hin sho lo.&gt;<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />&lt;&lt;Ebeni okamo, &lt;Oza ni nyyaya ni yoma. Nyya yo owuya hin ya kye, shina mo nyakwu oye, kweyi nyya kpi izire kpi iyo hin kpiri ya sho. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Kweyi nyya ka diyun mo, &lt;Ngbo oza neshi nwashika ni ya bagye ki ishayi nwashika. Yagye shino ore, gwa ki minyo.&gt;&gt;<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />&lt;&lt;Owuso ke ka da anu mo, &lt;Awo ikyo! Otu mani aba yo olayi wo ya bize sho. Anoho ya zo oza ni okyanu ya di iyo mani?&gt;<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />&lt;&lt;Omani ya gbodagye kpase ni kpo oza shagye di iyinu kpiri ni, anu ke gbo odu ebe ko Owuso lo.&gt;&gt;<verse eid="LUK 12:21" /></para>
  <para style="s">Ala ka byotu lo</para>
  <para style="r">(<ref loc="MAT 6:25-34">oMatiyu 6.25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Ebeni Oyesu ka da awogboso mo, &lt;&lt;Mani oni, nyya kadala mo, ala ka byotu ikweyi ko olayi, ela ko ozarore kwe ikweyi ki ikpiye kala kpe oza ni ala ba shoko ni lo. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Owushoshu kala shoshi sho oza rore kweyi ikpiye shoshi sho oshiye. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Ala ma awigbano, aba toza kwe aba kyi izire lo, agbo oda ko shi iyo kwe owuya lo, Owuso ke ya dawoza ko rore. Ala ke shoshi sha awigbano mani ebe nu! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Anoho ipu kala no otu byobya nu ya gege ya fi ishi gbayayi mo olayi nu? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Ni ala ba gege ko yo oza gbayayi mani lo, ojiya ni ala ba byotu ikweyi ka ashishini.<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />&lt;&lt;Ala ma awo oshefu ni ba bwu ni, aba yoko kwe aba to oshiye abiyiwa lo. Kwikyikyeni, nyya kadala mo, kwo ose Osolomo kpo odu nu, oshiye nu shoshi shaka awo oshefu ki ikyashi lo. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Kweyi owoni olemani pini Owuso ya sha akyashi iyo la, ala muwa ikyeni kweyi ayo ola kwuwa okyi akyala, ala ba ma byo oya sha ala oshiye lo? Ala awine ko otuse gbayayi! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Ala ka yo otu kala so oza ni ala ba re kwe ba gwa lo; ala ka byotu ikweyi nu lo. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Awopeka kese ba labo ka awozamani kpiri, ada kala gye mo ala ba yimu ka awozamani mamani. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Ala ke tikpo ko obula ko Owuso ikyikyo oza mani kpiri aba yi da ala.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />&lt;&lt;Ala ka yoshi lo, ala ase gbayayi ki ikpo hin, ikweyi koni owi imu ko otu ka Ada ko da ala obula. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Ala yo oza ni ala gbo ni yi ra shini ala yi ikwiri yi ko do oleha. Ala kpo oshu kala shi iso ebe ni aba sawukye lo ni, odu ki iso ni ya kweyi lo ni. Ebeni owi oyoye ya shabo lo, kweyi eha ba ganu lo ni. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Ebeni odu kala yanu, anu pini otu kala ya ba banu la.<verse eid="LUK 12:34" /></para>
  <para style="s">Kyiyotu Gbeyi ko Owowa ka Adole</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />&lt;&lt;Ala sokugba ko meshe kweyi ikwomu kala na kwokwu, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />byoni ango ba gbabo ka adole wa na kwikye bwe ebe ki imya ko onyape ni. Ishini owa gwofunu, ebebeni aba gwofunu da anu. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Oya shoshi do oyole ni kyi iyinu tu kweyi ya gbabo ko owowa ka adole nu. Nyya ko okwokwoshi da ala, oya wa sokugba kweyi ya da awo oka kweyi ya meshe da awa ishini aba gye ko roza ni. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Oya shoshi da ayole neshi ni adole wa wa ta awa kyiyiwa tu, otutehe ko otu kwi otukpokyi. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Nke ya yimu sha ala gye mo: Owoni adole gyi ishi ni owi ya wo ole nu, obi ya sho owi bita ya fofunu kweyi ya gipu kole nu lo. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Ala ki bagye kpe era, ikweyi koni Oyi ka Asuse ya wa ishini ala yo otutagye lo ni.&gt;&gt;<verse eid="LUK 12:40" /></para>
  <para style="s">Oyole Neshi</para>
  <para style="r">(<ref loc="MAT 24:45-51">oMatiyu 24.45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Obitrus do oka mo, &lt;&lt;Adole, oya kelase mani kpa aha la, kwe kpa ananoho?&gt;&gt;<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Adole kyogwu mo, &lt;&lt;Anoho wo oyole ni gbo otusose ki ziyi ni, ase ni adole nu ya yo otuso kweyi ki sho ole nu bita da anu kweyi kamo na da ashishini ka ayole oza rore ipu ki ishi neshi. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Oya shoshi owoni adole ko oyole mani wa ta anu yo oko nu neshi ishini okwikye wa. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Nyya kadala okwokwoshi, oya yo oza ni ogbo ni kpiri yi da anu abo. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Obi ke wo oyole bibi la, obi ya ka ipu ko otu nu mo, &lt;Adole hin ya ga gbeji,&gt; Kweyi ya kwotu ko gwa ashishini ko oyole nongo kpa anya kweyi bi ya roza ya gwinyi kpa ayi ki inyi. <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />Adole ko oyole mani ya wa eno ni ototuse lo kweyi oya wa ishini ogye lo ni. Adole ko oyole mani wa yo shigbo wuruwuru kweyi yayo tagye kpa awase ni gyo Owuso lo ni.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />&lt;&lt;Oyole ni gyo oza ni adole nu ya yimu ni kweyi yagye kyi iyi nu tu lo, kwe yo oza ni adole nu ya yimu ni lo, aba gwize kotata. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Oyole ni ke gyo oza ni adole nu ya yimu lo kweyi yo oza ni ashu ko da anu owe ni, aba gwize gbayayi. Ase ni ada anu nwa, aba yimu ko oza nwa ebe nu. Ase ni ayo oza nwa da anu abo, aba doka ko oza nwashika ebe nu.<verse eid="LUK 12:48" /></para>
  <para style="s">Oyesu byo okoko wa</para>
  <para style="r">(<ref loc="MAT 10:34-36">oMatiyu 10.34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />&lt;&lt;Ola pini nbi we ese la, obi shababo hin obi kye wa! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Ngbo Obatisma ni aba yun ni, nze ipu ko otu hin sa ayun! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Ala ba ma mo nbyo omene we ese mani la? Aayi! Nyya kadala, ke wo okoko la. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Bwi ishi mani go ohobu, ase eho ipu ki ipwoma oye ba yi iyiwa ko, ase eta ba wo omonyekwotu kase epa kweyi ase epa ba wo omonyekwotu kase eta. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Aba yi iyiwa ya ko: ada ya wo omonyekwotu ko oyi, oyi ya wo omonyekwotu ka ada, ene ya wo omonyekwotu ko oyi nu nonya, oyi nonya ya wo omonyekwotu ki inanu, inoba ya wo omonyekwotu ko onya ko oyi nu, onya ko oyi ya wo omonyekwotu ki inobunu.&gt;&gt;<verse eid="LUK 12:53" /></para>
  <para style="s">Awofarisi ba do oka ki Ishi</para>
  <para style="r">(<ref loc="MAT 16:2-3">oMatiyu 16.2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Oyesu ka de ewa ka asuse mo, &lt;&lt;Ishini ala mo Owuso tobi bwe eye, ebebeni ala ka mo, &lt;Owuso ya yimu kowa.&gt; Kweyi oya wa. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Ishini owu ta bwo onose, ala ka mo, &lt;Ebe yawa dola.&gt; Kweyi ebe ke wa dola. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Ala awoyoziyi! Ala gyishi ko gwi ikweyi kese kpo okpowuso, ojiya ni ala gege ko gwi ikweyi ki ishi mani lo?<verse eid="LUK 12:56" /></para>
  <para style="s">Ye ela gwo kpo Omonyekwotu wo</para>
  <para style="r">(<ref loc="MAT 5:25-26">oMatiyu 5.25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />&lt;&lt;Ojiya ni ala abiyikala ba roza neshi ko ya lo? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Yela gwo kpo omonyekwotu wo papa ishini oya byo goda ko kepwo ni, yela gwo kpa anu ishini ala tayayo bo owe ni, lalo oya byo go obutu ki ino ke epwo, ino kepwo yayo nabo di ino sha ase tu shini ana yo to oda. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Nyya ka da awo, oya bose lo so sore ki ikwiri kpiri.<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Shagbotu kwe Ogekwu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Ishi oni ashishini kase ni bebeni ka do Oyesu oshu ikweyi kase ko Ogalili ni Obilatus ngmuwa ishini aba peshi do Owuso ni. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Oyesu kyogwu mo, &lt;&lt;Koni angma ase ko Ogalili mani ni, asha ase ko Ogalili shishini kpo ozalabi ona? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Aayi! Nyya ka dala, owoni ala shagbotu ikweyi ko ozalabi kala lo, kpiri kala ba gekwu bya awa ni. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Kwa ase igwahata ni oda ki iso sa shuwa Osiluwa kweyi yuwa ngmo ni, ala ba ma mo asha ase shishini ko Ojerusele kpiri kpo ozalabi la? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Aayi! Nyya kadala, owoni ala shagbotu ikweyi ko ozalabi kala lo, kpiri kala ba gekwu bya awa ni.&gt;&gt;<verse eid="LUK 13:5" /></para>
  <para style="s">Elase ikweyi ko odegyo ni gwa lo ni</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Oyesu kelase da awa mo, &lt;&lt;Ongo oye te efu ko ofigi ipu ke eho ki inabi nu. Oga ko wo ogwogwa nu, oke pye kwo oye lo. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Ebeni oka do ongo ni ya yi iyi kwe eho ni mo, &lt;Ma, ishayi eta ikyeni yoma ni nyya wa tikpo ko ogwogwa ke efu ko ofigi, nke ya pyo ojije ipu nu lo. Yi go! Ikweyi koji ni ayumo okpagye gwu?&gt;<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />Ine ko yi iyi kwe eho ke kyogwu mo, &lt;Adole, ana shobita nagye ipu ki ishayi mani, kweyi na bwogo gyehe to kweyi na sho otakyi. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Owoni ogwa ishayi ni ya wa ni oshoshi! Owoni ogwa lo ke, ana yi go tonu.&gt;&gt;&gt;<verse eid="LUK 13:9" /></para>
  <para style="s">Oyesu do Onya ni Winyi ni Ogege Eno ko Ominyo</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Eno ko Minyo Oyesu ya foza ipu ke ekpa oye, <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />kweyi onya oye ni omaku bibi yo winyi ki ishayi igwahata, oyo tokoka kweyi ya gege ko nata lo. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Ishini Oyesu mo ni, oyogwu mo, &lt;&lt;Onya, ada wo ogege.&gt;&gt; <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Ebeni oya abo nu si ikweyi, ebebeni opyo ogege kweyi osho Owuso iye.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Oteyi ke ekpa ke kyanya koni Oyesu da ano ogege Eno ko Minyo ni. Oka da ase ni be ebeni ni mo, &lt;&lt;Agbe eno ihiri ni shu ko yo oko ni, ala wa ipu ka aweno mani shini ana da ala ogege, ke we Eno ko Minyo lalo.&gt;&gt;<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Adole ka da anu mo, &lt;&lt;Ala awoyoziyi! Anoho ipu kala ya ye ena kwe odagyi nu yayi kweyi ya byo ge ebe ko gwinyo Eno ko Minyo lo? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Onya mani bwi ipwoma ki Ibirayi ni Ibiri yo gbo ishayi igwahata ikyeni ni, oya shoshi shini ana yoyi Eno ko Minyo lo?&gt;&gt;<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />Ishini okela ni ni, omonyekwotu nu kpiri yi iweyi. Ashishini kase ke shotunehe kpa awoza ki igbashi ni oya ya ni.<verse eid="LUK 13:17" /></para>
  <para style="s">Elase Ikweyi ki Ikpo ko Omosta</para>
  <para style="r">(<ref loc="MAT 13:31-32">oMatiyu 13.31-32</ref>; <ref loc="MRK 4:30-32">oMak 4.30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Ebeni Oyesu do oka mo, &lt;&lt;Obula ko Owuso lebyo oji? Kwe oji ni nyya myo kpa anu? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Olema byi ikpo ko omusta ni ongo oye ze kweyi tu eho nu ni. Obwu kweyi gye we efu, kweyi awigbano kiso ba lole ayabo nu.&gt;&gt;<verse eid="LUK 13:19" /></para>
  <para style="s">Elase ikweyi ko Oyisi</para>
  <para style="r">(<ref loc="MAT 13:33">oMatiyu 13.33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Oki do oka mo, &lt;&lt;Nyya myo obula ko Owuso kpo oji? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Olema byo oyisi gbayayi ni onya yi kwabo kpo omu nwashika, gbi ishini onu,&gt;&gt;<verse eid="LUK 13:21" /></para>
  <para style="s">Ala Gipu ko Owe Pyopyi</para>
  <para style="r">(<ref loc="MAT 7:13">oMatiyu 7.13</ref>,<ref loc="MAT 7:14">14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Ebeni Oyesu bwa awogya leke kpa awonyakwu kweyi ya foza ishini oya go Ojerusele ni <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Ashe do oka mo, &lt;&lt;Adole, ase gbayayi pini aba wa ngma awa la?</para>
  <para style="p" vid="LUK 13:23">Oka da awa mo, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />&lt;&lt;Ala takirikwu shini ala bwofunu pyopyi, nyya kadala, ase lewa ba takirikwu ko bwa anu, aba gege lo. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Owoni adole wa yofunu gwu, ala ba hagye ese ba gwofunu ki ya shagye mo, &lt;Adole, gwofunu daha.&gt;</para>
  <para style="p" vid="LUK 13:25">&lt;&lt;Anu ke ya ka mo, &lt;Ngya ala lo, nki gye ebe ni ala bwa anu wa lo.&gt;<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />Ebeni ala ba kamo, &lt;Aha re ki gwa kpa awo, kweyi oki foza ikweyi ko owe ka.&gt;<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />&lt;&lt;Anu ke ya kamo, &lt;Ngya ala lo, kwe ebenya ni ala bwa anu wa. Ala shaga sho obutun ala ase bibi!&gt;<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />&lt;&lt;Ebeni ala ba kyegba ba shabo ahanu, ishini ala mi Ibirayi kpi Ishakwu kpo Oyakubu kpa awobane kpiri ipu ko obula ko Owuso, ala ke aba ya ala ta ge ese. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Ase ba wa bwa ohanokyi kpe eye kpa abwi iso kpo onose, kweyi ba wa ze ebe ko yagye wa ebe ki imya obula ko Owuso. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Ebeni awase ni wa ko gwejeji ba wa kikyikyo, kikyikyo ba wa ko gwejeji.&gt;&gt;<verse eid="LUK 13:30" /></para>
  <para style="s">Oyesu Byotu do Ojerusele</para>
  <para style="r">(<ref loc="MAT 23:37-39">oMatiyu 23.37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Ishi oni ashishi ka Awofarisi we ebe ko Oyesu kweyi ka da anu mo, &lt;&lt;She ebeni bita shini oge ebye. Ohiridus ya yimu ko yo ngmo.&gt;&gt;<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Okyogwu mo, &lt;&lt;Ala ga ka de iwo ka apashi oni mo, &lt;Nyya ngmo omaku bibi ki ya da ase ogege ikyeni kpo okyi kweyi eno ko omweta nyya yo oko hin kweyi.&gt; <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Owotiri shini na go ohobu kpi iyawu hin ikyeni, okyi kpi ikyiyo, ikweyi koni inobane ya gekwu ebyibye lo so Ojerusele!<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />&lt;&lt;Aye, Ojerusele, Ojerusele! Ala ni ngma awinobane ki ta awase ni atuwo oleho ebe kala ni akyo! Igbe maa ni nyya yimu ko kpa ayi kala tukpa byo ni ogwu yaya akya ka ayi nu ni, ala ke tela ko ya mani! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Ma! Nabani asho ole kala bita gba ashishe lo. Nyya kadala, ala ba mun kelo gbishini ala ba kamo, &lt;Otunehe yo kpase ni wa ipu ki iye ka Adole.&gt;&gt;&gt;<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Oyesu do ongo oye ogege eno ko minyo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Eno ko Minyo oye, Oyesu go ole ko oteyi ka Awofarisi ko ga roza, kweyi ase kpi iyi kwo. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Ebeni obutu nu ongo oye gbo ose ki ikpo kpa abo myomyi. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Oyesu da Awofarisi kpa awofono oka mo, &lt;&lt;Ono kamo an da ase ogege Eno ko Minyo kwe an ka da awa lo?&gt;&gt; <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Awa ke ko ojije lo. Ebeni obyo ongo ni kweyi oda nu ogege kweyi omo ona ga nu.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />Ebeni oduwo oka mo, &lt;&lt;Ano ipu kala ni oyi nu kwe ena nu gbo go ogo ki inyo Eno ko Minyo kweyi ya yo ngma lo?&gt;&gt; <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Kweyi agege ko ojije lo.<verse eid="LUK 14:6" /></para>
  <para style="s">Ikweyi Bagye kpo Omaba Neshi</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Ni Oyesu ma awase shishini ni apawa ko ga roza ga bagye oka ka anyakwase ni, okelase mani dawa: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />&lt;&lt;Ishini ashe pawo gebe kimya ko onyape, ka ga yagye oka ka onyakwase lo, ikweyi koni ase ni ke awo ni ki ke ashe ni ki sho ni. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Owoni olemani, ase ni ke ala ni wa ka da awo mo, &lt;Nyiso sho oka wo do ongo mani.&gt; Kweyi oya gbo owuru koni oya ga zo oka leke ni. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Owoni ake ke awo, ga zo oka leke, koni ase ni ke awo ni wa ka da awo mo, &lt;Oya, nyiso ga yagye oka ka anyakwase.&gt; Ebeni awogboga ni be ebe ni ba mo gyiyi. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Koni ase ni zi iyinu iso, aba zo wo ojije lo, ase ni ke yikweyi bagye, aba zo iso.&gt;&gt;<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Ebeni Oyesu ka da ase ni ke anu ni mo, &lt;&lt;Owoni oya ke ase ko roza kwi imya, ka ke awoya wo kwa ayene wo kwa ase ki ipwoma wo kwo oya kobagye wo ni gbo odu ni; owoni oya mani, awa ki bawa pawo eno oye shini ana suwore. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Owoni oke ya ke ase ki imya, opa awoleha, awowinyi, awopyepu agye kpa awofiyi, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />bwe ebe koni oya pya aboneshi. Ikweyi koni awa mani ba gege ko sore lo Owuso ya sa aboneshi ki ya da awo abola eno ni aseneshi ba nyiso amiri ni.&gt;&gt;<verse eid="LUK 14:14" /></para>
  <para style="s">Elase Ikweyi ki Imya Nyakwu</para>
  <para style="r">(<ref loc="MAT 22:1-10">oMatiyu 22.1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Ishini oye ipu kawase ni bagye oka kpa anu pwe ela mani ni, oka do Oyesu mo, &lt;&lt;Otunehe yo kpase ni wa roza ki imya obula ko Owuso ni.&gt;&gt;<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Oyesu kyogwu mo, &lt;&lt;Ongo oye yi imya nyakwu kweyi pe ewa ka asuse nwashika. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Ni ishi ki imya gye ni, oto oyole nu oleho ebe kawase ni opawa ni mo, &lt;Ala wa, ojoji kpiri ya wa.&gt;<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />Kpiri wa ke kwotu ko nyepwo. Akikyikyo kamo, &lt;N re eho anana mani yoma, nyya yimu ko ga gyo ma. Nyya bo mo gbotu mene kpa ami.&gt;<verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />&lt;&lt;Ashe hoha kamo, &lt;N re ena eho ko sheho anamani yoma, nyyo owe ko ga mabo awa ma. Nyya bo mo gbotu mene kpa ami.&gt;<verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />&lt;&lt;Kwikyikyeni ashe hoha ki kamo, &lt;N gbo onya pepe kin yoma, nyya gege ya wa lo.&gt;<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />&lt;&lt;Oyole mani kwikye ga ka da adole nu oza ni aka ni. Ebeni otu ka adole nu bya kweyi oka do nu mo, &lt;Nyiso papa gi ikweyi ko owe kpo obepa ko ogya ga kpa awoleha, awowinyi, awofiyi kpa awopyepu agye wa.&gt;<verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />Oyole nu kamo, &lt;&lt;&lt;Adole,&gt; oza ni akamo naya ni nyya wa, kwikyikyeni ebe ke shishini.&gt;<verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />&lt;&lt;Ebeni adole mani ka do oyole nu mo, &lt;Bose gi ikweyi ko owe leke kpo onyakwu kweyi oka dawa na wa shini ole hin na nwu. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Nyya kadala, ashishe ipu kawase ni npawa kikyikyo ni ya mo onye ko ozarore ki imya ni nyya mani lo.&gt;&gt;&gt;<verse eid="LUK 14:24" /></para>
  <para style="s">Enu ko gboso Oyesu</para>
  <para style="r">(<ref loc="MAT 10:37-38">oMatiyu 10.37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Ishini Oyesu yipu ki iyawu kpe ewa ka asuse ba ga ni, opyiyi kweyi ka da awa mo: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />&lt;&lt;Kpiri kase ni we ebe hin kweyi tela ka ada nu, kpi inanu, kpo onyanu, kpa ayinu, ayinanu nongo kpo nonya, kpo olayi nu lo, oya wi inogbosun lo. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Kweyi kpiri kase ni ngo oshi nu kweyi ka ami lo, oya wi inogbosun lo.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />&lt;&lt;Ana mo ashe ipu kala ya yimu ko mo oda ki iso. Ikyikyo oya yagye ya to oza ni ole ni ya kwu shini ona ma kwe ikwiri ni ogbo ni ya gye ko yo ole kweyi ome lo? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Owoni okwagye ko oda kweyi ogege ko kweyi lo, kpiri kase ni ma aba ye eye, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />aba kamo, &lt;Ongo mani kwagye kole oke gege ko kweyi lo.&gt;<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />&lt;&lt;Kwo ose wonya ni ya yimu ko ga kpefu kpo ose oye kweyi ya yagye ya arisawu ikweyi ka adakare okpakwu igwo ni ogbo ni kwe aba gege ko kpefu kpo ose ni gba adakare okpakwu awepa ni ome lo? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Owoni oya gege lo, bwi ishini atayayo be ebe lenu ni oya tayoleho nu oleho shini ana ga tikpo ko owe ko bagye ko mene. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Mamani kpiri kase ni sho oza ni ogbo ni bita lo, oya wi inogbosun lo.&gt;&gt;<verse eid="LUK 14:33" /></para>
  <para style="s">Onwa ni Nyeba ni</para>
  <para style="r">(<ref loc="MAT 5:13">oMatiyu 5.13</ref>; <ref loc="MRK 9:50">oMak 9.50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />&lt;&lt;Onwa shoshi, owoni onye ko onwa ke nyeba, oya wo onwa ke? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Ogbo oko oyoye eho ke lo, oya wo otakyi lo, aba yi shonu kin la.</para>
  <para style="p" vid="LUK 14:35">&lt;&lt;Ase ni gba akpaha ko pwo na pwo.&gt;&gt;<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Elase Ikweyi ko Otukpo ni Gebi ni</para>
  <para style="r">(<ref loc="MAT 18:12-14">oMatiyu 18.12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Eno oye awozegba kpa awinozalabi wa shogba to Oyesu shini ana foza ni oya ka ni. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Awofarisi kpa awofono ke ba lo okwunu agye mo, &lt;&lt;Ongo mani ya yagye kpa awinozalabi kweyi ki ya roza kpa awa.&gt;&gt;<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Ebeni Oyesu kelase mani da awa mo: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />&lt;&lt;Owoni ashe ipu kala gbo otukpo ogbogbo oye kweyi oye ipu wa gebi, oya gege ko sha awahane ayahane bita ikpokyi kweyi ga labo ko oye ni gebi ni lo? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Owoni opyo, oya shotunehe kweyi yayo ya so oko <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />kweyi ya go ole. Ebeni oya ya awoya nu kpa awase ni bagye kwo ni ogwu wa bagye kweyi oya ka da awa mo, &lt;Ala shotunehe kpami, npyo otukpo hin ni gebi ni.&gt; <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Nyya kadala mo mamani ase ba shotunehe ole kiso ikweyi ki inozalabi oye ni shagbotu ni sha ase awahane ayahane ni wa aseneshi ni gbo shagbotu ke lo ni.<verse eid="LUK 15:7" /></para>
  <para style="s">Elase Ikweyi ki Ikwiri ni Gebi ni</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />&lt;&lt;Kwe owoni onya oye gba azufa ki ikwiri igwo kweyi oye gebi, oya kwo ola ikwomu kweyi gwebe kole nu myo gbi ishini oyo pye lo? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Kweyi owoni opye, oya ya awoya nu kpa awase ni bagye kwo ni ogwu kweyi ya kamo, &lt;Ala wa shotunehe kpa ami, npyi ikwiri hin ni gebi ni.&gt; <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Mamani, nyya kadala, otunehe yaba obutu ka ayoleho ko Owuso ikweyi ki inozalabi oye ni shagbotu ni.&gt;&gt;<verse eid="LUK 15:10" /></para>
  <para style="s">Elase Ikweyi ko Oyi ni Gebi ni</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Oyesu kamo, &lt;&lt;Ongo oye gba ayi epa. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Oyi leke ka da ada nu mo, &lt;Ada, da ami ogwu hin.&gt; Ebeni oyo ogwu nu yiko we epa da awa.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />&lt;&lt;Gbeji lo, oyi leke kpo oza ni ogbo ni, kweyi go okpagye ni lenu ni ga yebe ni yo oza ni ogbo ni ngmo owe ni shoshi lo ni. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Ishini oyi ikwiri nu ngmo kweyi ni, emye kotota go okpagye ni kweyi ogbo ojije ko re lo. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Ebeni oga zo oko ki ikwiri ebe kase ko okpagye ni yo ga da aruma nu oza rore eho ni. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Oya tikpo ka akya ni aruma ba ha ni shini anu na ha, ashishe ke da anu lo.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />&lt;&lt;Ishini okwikye wi iyinu ni, okamo, &lt;Awoyoko da ada hin we ema ni aba roza ba shibita, ami ke ye ebeni ya gekwu kpe emye! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ami ya kwikye ya ge ebe ka ada hin kweyi ga ka da anu mo: Ada, nyyo ozalabi obutu ko Owuso kpo obutu wo. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Nshu koni oya yumo ogwu mo nwwo oyi wo lo, yun na lema byo oye ipu ka awoyoko wo.&gt; <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Ebeni onyiso kweyi ge ebe ka ada nu.</para>
  <para style="p" vid="LUK 15:20">&lt;&lt;Ni oke tayayo ye ebe lenu ni, ada nu mo kweyi iyinyinyi yo kwu, kweyi onyinya ge ebe ko oyi nu kweyi kwo botu ki gwo okwunu.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />Oyi nu ka do anu mo, &lt;Ada, nyyo ozalabi obutu ko Owuso ki iso kpa awo, nshu koni oya yumo ogwu mo nwwo oyi wo lo.&gt;<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />Ada nu ke ka da ayole nu mo, &lt;&lt;Ala nyinya papa ga kpo obagidi neshi bwo oda wa sho oko. Ala la arika abo kpo okpabawu ikpo. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Ala ga ngme ena nyakwu, shini ahan yi imya kpo otunehe. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Ikweyi koni oyin mani gekwu onabani oke onyiso, ogebi ayo pye.&gt; Ebeni akwotu ko shotunehe.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />&lt;&lt;Ipu ki ishi oni, oyi nu anyakwase ye eho ya yoko. Ishini oyo pee kpo ole ni, opwo aba gwodu kweyi ba gyoba. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Ebeni oyo oye ipu ka ayole ogwu kweyi do oka mo oji ya gbodagye. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Okyogwu mo, &lt;Oyene wo wa, kweyi ada kala ngme ena nyakwu ikweyi koni okwikye wa neshi kpo oshu ni.&gt;<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />&lt;&lt;Otu ko oyi nu anyakwase bya kweyi otanu ko gipu ole. Ebeni ada nu bose kweyi wa shagye da anu. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Anu ke ka da ada nu mo, &lt;Ma! Ishayi nwashika ni shigbo ni, nyyoko dawo byoshe ni, nggwakpaha dawo lo. Kwo oyi ki ikpowu oda ami shini na shotunehe kpa awoya hin lo. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Ishini oyi wo ni ke kpo odu wo kweyi ga yi ngmo kpa awagbaza ni kwikye wo ole, ongme ena nyakwu da anu!&gt;<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />Ada nu kamo, &lt;&lt;&lt;Oyin,&gt; oyo kpa ami ishi kpiri, kweyi oza ni ngbo kpiri wa akakoho la. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Aha ke shu ko shotunehe kotata, ikweyi koni oyene wo gekwu, onyiso, ogebi kweyi ayo pye.&gt;&gt;<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Elase Ikweyi ko Oyole ni gbo Okwokwoshi lo ni</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Oyesu ka da awogboso mo: &lt;&lt;Ongo oye gbo odu, kweyi ashe ga ka da anu mo oyole nu ya tiga kpo odu nu. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Ebeni oyogwu kweyi do oka mo, &lt;Oji ni nyya pwo ikweyi wo ni? Za arisawu ko oko ni ndawo ni, ikweyi koni oya yiyi kwo odu hin kelo.&gt; <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Ebeni oyole ni ya yi iyi kwo odu nu ni ka ipu ko otu nu mo, &lt;Oji ni nyya ya byo onabani? Adole hin ya yo oko ya bize shun? Ami ke loshu ko sheho lo, nke ya yi iweyi ko boza. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Nggyoza ni nyya ya ni, ishini onumenya sho oko, ase ba zun ole wa.&gt;<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />Ebeni oyawase ni myore ka adole nu ogwu oyoye. Oda kikyikyo oka mo, &lt;Omyore ka adole hin ke emaa?&gt;<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />Okyogwu mo, &lt;&lt;&lt;Ogya ka ano ogbogbo ahata,&gt;</para>
  <para style="p" vid="LUK 16:6">&lt;&lt;Oyole mani ka da anu mo, &lt;Zo okpa shini okyanu ta nawo ogbogbo ene.&gt;<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />&lt;&lt;Oki do omwepa oka mo, &lt;Omyore ka adole hin ke emaa?&gt;</para>
  <para style="p" vid="LUK 16:7">Okyogwu mo, &lt;&lt;&lt;Owatu ke ewo okpakwu oye,&gt;</para>
  <para style="p" vid="LUK 16:7">&lt;&lt;Oka da amu mo, &lt;Zo okpa shini oyi ta na wo ogbogbo ahata.&gt;<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />&lt;&lt;Adole nu da anu abokpa ikweyi koni oziyi ni. Koni ase kese mani ziyi ko yo oza da ase kishi wa sha ase ke ebe yoyu. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Nyya kadala, ala yo oko kpo odu kese mani shini ala kwo oya, ishini odu kweyi, aba ya ala omaba ole wa ko gbogbo-gbogbo.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />&lt;&lt;Ase ni yo okwokwoshi ikweyi ko oza gbayayi, aba yo oza nwashika da anu abo, kweyi ase ni yo okwokwoshi ikweyi ko oza gbayayi lo, oki ya yo okwokwoshi ikweyi ko oza nwashika lo. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Owoni oyo okwokwoshi ikweyi ko odu kese mani lo, anoho ya yo otuso ikweyi ko odu ki iso? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Kweyi owoni ogbo okwokwoshi kpi iyo ka ashe lo, anoho ya da awo iyo wo ki iyo?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />&lt;&lt;Ashishe ya gege ya wo oshe da adole epa ishi oye kponu lo. Oya tela ko oye kweyi yimu ko oye, oya gboso oye kweyi ya tela ko oye. Byoni olemani oni, oya gege ya wo oshe ko Owuso ki wo oshe ki ikwiri lo.<verse eid="LUK 16:13" /></para>
  <para style="s">Ozafofu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 11:12-13">oMatiyu 11.12-13</ref>; <ref loc="MAT 5:31-32">5.31-32</ref>; <ref loc="MRK 10:11-12">oMak 10.11-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Ashishini ka Awofarisi ni gbi imu ki ikwiri ni pwo oza ni Oyesu ya ka ni kweyi ashakyo. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Oyesu ka da awa mo, &lt;&lt;Ala pini ba yo oza shini ase na ma mo ala wa ase neneshi la, Owuso ke gyo otu kala. Owuso ya tela ko oza ni asuse mo oshoshi ni.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />&lt;&lt;Ome ishi ko Oyohana, ase foza ko ono kpa awobane. Bwi ishi oni, aba tono ko oshu neshi ko obula ko Owuso, kweyi ananoho ya nonu ko gipu nu. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Oya lono shini oti kwe ofofa ipu ko ozafofu ko ono na gebi, shi iso kpe ese ko kweyi.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />Kpiri kase ni kabo kpo onya nu kweyi gbo onya oye hoha, oya beba kpa anu pi yoma, kweyi ongo ni doka ko onya ni kabo kpo oba, oya beba kpa anu pi yoma.<verse eid="LUK 16:18" /></para>
  <para style="s">Ongo ni Gbo Odu ni kpo Olazarus</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />&lt;&lt;Olodu oye ni ya sho oshiye neshi kweyi ki yo ole neshi ki ya roza neshi ishi kpiri. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Ongo oye iye nu wo Olazarus ya yagye owo ofunu kole nu, ikpiye nu kpiri wi ipi, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />kweyi oya labo ko ro ozarore ni shonu okpagye obutu ko olodu mani. Iwo ki ba wa pi ipi ki ikpiye nu.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />Ishini inoboza mani gekwu ni ayoleho wa zo gebe ni Ibirayi yanu ni. Olodu mani ki gekwu kweyi ayo nyi. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Oyo ole ko ola ya mowe, oziyi iso kweyi omi Ibirayi ebe lenu kpo Olazarus ashikwu nu. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Ebeni osho gwu yo mo, &lt;Ada Ibirayi, miyinyinyi hin kweyi oto Olazarus oleho shini na yo oyi ka abo nu linyo na tumi igbenu shi na sha, ikweyi koni nyya mowe ipu ko ola.&gt;<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />&lt;&lt;Ibirayi ke kyogwu mo, &lt;Oyi, rela ki ishini oya gbo olayi ese ni, ogbo oza neshi kpiri ni oya yimu ni, Olazarus ke ya mebi ishi oni, ishi mani ke oya minyo ebeni kweyi awo ya mowe. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Itikpi ko oni ke, otutehe ka aha kpa awo gbo ogo nyakwu shini ase ni ye ebe ni naka gege ge ebe wo lo, kweyi ase ni ye ebe wo naka gege we ebe ka lo.&gt;<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />&lt;&lt;Oka da anu mo, &lt;Ni olemani, nyya bo ada, to Olazarus oleho na go ole ka ada hin, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />ngba ayene nongo eho ona ga pyuwa akpaha, shini ana ka wi ipu ko owe mani lo.&gt;<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />&lt;&lt;Ibirayi kyogwu mo, &lt;Agbo okpa ko Omusa kpa akawo bane, ana ya akpaha tagye shini ana pwo.&gt;<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />Okamo, &lt;&lt;&lt;Aayi, ada Ibirayi, owoni ashe ke nyiso amiri ge ebe wa, aba shagbotu.&gt;<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />&lt;&lt;Oka da anu mo, &lt;Owoni aya akpaha tagye do okpa ko Omusa kpa akawo bane lalo, kwa ashe nyiso amiri, aba kyogwu kpa anu lo.&gt;&gt;<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Omama Gipu ko Ozalabi</para>
  <para style="r">(<ref loc="MAT 18:6-7">oMatiyu 18.6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">oMak 9.42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Oyesu ka da awogboso mo, &lt;&lt;Oza ni ba ya ase ba yo ozalabi ni bawa gbodagye, owe yo kpase ni ke yuwa gbodagye ni. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Oya shoshi she shini ana ye ego ko gboza nyakwu gbo bo oko kweyi yo ta gi ishu nyakwu sho oni oya yo oye ipu ka ayi leke mani ya yo ozalabi ni. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Ni olemani oni, ala gbera.</para>
  <para style="p" vid="LUK 17:3">&lt;&lt;Owoni oyene wo yo ozalabi, kela kpa anu, kweyi owoni oshagbotu, yo ozalabi nu na. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Owoni oyo ozalabi igba ahapa eno oye kponu kweyi owa ta awo igba ahapa mo, &lt;N shagbotu,&gt; yo ozalabi nu yigbo.&gt;&gt;<verse eid="LUK 17:4" /></para>
  <para style="s">Yo Otuse ka Aha na Gye</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Ayikoko ka da Adole mo, &lt;&lt;Yo otuse ka na loshu!&gt;&gt;<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Adole kamo, &lt;&lt;Owoni ala gbo otuse titi byi ikpo ko omusta, ala ba gege ba ka de efu nyakwu mani mo, &lt;Shu ga hagye ipu ki ishu nyakwu,&gt; kweyi oya pwela kala.<verse eid="LUK 17:6" /></para>
  <para style="s">Oko ko Oyole</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />&lt;&lt;Ana ma ashe ipu kala gbo oyole ni ya sheho da anu kwe ya gbeho ko otukpo da anu. Ishini okwikye bwi ipashi wo ole, oya ka da anu mo, &lt;Na wa yagye na oroza&gt;? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Oza ni oya ka ni yo na lo, &lt;Ga yo ozarore ko onose dami, kyi iyo tu gbeyi hin, na re na gwa, ome shini awo re ki gwa.&gt; <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Oya shotunehe kpo oyole mani ikweyi koni oyo oza ni oka da anu ni? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Mamani ala, ishini ala yo oza ni aka da ala mo ala ya ni, ala kamo, &lt;Aha wa ayole kin la, aha ba yo oko ni aka daha ni kin la.&gt;&gt;&gt;<verse eid="LUK 17:10" /></para>
  <para style="s">Oyesu da Awine ki Iyiwa Igwo Ogege</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Eno oye Oyesu ya go Ojerusele, obwe eji ko Osamariya kpo Ogalili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Ni oya gipu ko ogya leke ni, ango igwo ni gbo ose ki iyiwa ni ga tanu ebe lenu <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />kweyi ashogwu yo kpo oko nyakwu mo, &lt;&lt;Adole, Oyesu, miyinyinyi ka aha!&gt;&gt;<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Ishini oziyi iso muwa ni, okamo, &lt;&lt;Ala ga shini awosapa na ma ala.&gt;&gt; Kweyi ishini aba ga ni apyo ogege wa.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Ashe oye ipu wa, ishini oma mo anu pyo ogege ni, okwikye wa sho Owuso iye kpo oko nyakwu. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Okwagye obutu ko Oyesu kweyi yi iyi lagye kweyi shotunehe da anu. Ongo oni wa ase ko Osamariya la.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Oyesu do oka mo, &lt;&lt;Ala wa ase igwo pini pyo ogege lalo? Ashishini kase ahane bi ini? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Ashishe ipu wa kwikye wa sho Owuso iye lo, so ogboga mani?&gt;&gt; <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Ebeni oka da anu mo, &lt;&lt;Nyiso shini oga, otuse wo da awo ogege.&gt;&gt;<verse eid="LUK 17:19" /></para>
  <para style="s">Owowa ko Obula ko Owuso</para>
  <para style="r">(<ref loc="MAT 24:23-28">oMatiyu 24.23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Eno oye Awofarisi do Oyesu oka mo, ishi nya ni obula ko Owuso ya wa? Oyesu kyogwu mo, &lt;&lt;Obula ko Owuso ya wa byoni ala kpi iyi shagye ni lalo, <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />oke wo oza ni aba mo, &lt;Oyoma,&gt; kwe &lt;Oya anoni oma&gt; lalo, &lt;ikweyi koni obula ko Owuso yo kpa ala.&gt;&gt;<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Ebeni oka da awogboso mo, &lt;&lt;Eno ya wa ba ni ala ba yimu ko mo Oyi ka Asuse, ala ke ba ma lo. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Ase ba kadala mo, &lt;Oyoma!&gt; Kwe &lt;Oyo oma!&gt; Ala ka nyinya ka awa lo. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Koni eno ko owowa ko Oyi ka Asuse ya le byo oyoyu ko ola ka akpula ni ya yu okpowuso bwa agbabo oye ga agbabo oye ni la. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Ikyikyo oke ya mowe nwashika kweyi ase ki ishi mani ba tela nu.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />&lt;&lt;Byoni ogbodagye ishi ko Onuhu ni, mamani oya gbodagye ishi ko owowa ko Oyi ka Asuse. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Ase ba re, ba gwa, aba gba anya kweyi ba bya anya go oda oba gbi ishini eno ni Onuhu gipu ko owu ni. Ebeni inyo wa yuwa re kpiri.<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />&lt;&lt;Mamani ishi ko Olotu. Ase ba re, ba gwa, aba riyo ba kyanu ra, aba to oza aba mo ole. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Enoni Olotu ke sho Osodom bita ni, ola wa bwi iso kpo onwa ki igbe wa yuwa re kpiri.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />&lt;&lt;Oya lemani eno ko owowa ko Oyi ka Asuse. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Enoni ase ni yi iso ki inu kole nu naka sa wo okpagye wa zo ojije ipu kole lo. Mamani ase ni yi ipashi naka kwikye ga kpo oshiye nu lo. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Rela ko onya ko Olotu! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Kpiri kase ni takirikwu ko yo olayi nu gbo, oya yi tonu, kweyi ase ni yo olayi nu tonu, oya pye. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Nyya kadala, ipu ko otu oni ase epa ba gwutagye ikweyi ko ogwudu oye; aba yo oye ya bize kweyi ba sho oye bita. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Anya epa ba bi ikweyi ke ego ba gboza dudu; aba yo oye bize kweyi sho oye bita. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Ango epa ba bi ipu ke eho ba sheho, aba yo oye bize kweyi sho oye bita.<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Ado oka mo, &lt;&lt;Ebenya Adole?&gt;&gt;</para>
  <para style="p" vid="LUK 17:37">Okyogwu mo, &lt;&lt;Ebeni okwu tagye ni pini ayikyefu ba sa anu la.&gt;&gt;<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Elase Ikweyi ki Inarigwu Tota Gbo Ominyo lo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Ebeni Oyesu kelase da awogboso ko shiya awa mo ana tinarigwu ipu ki ishi kpiri, ana ka gbotu lo. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Okamo, &lt;&lt;Ipu ko ogya oye, agbi ino kepwo ni ya yoshi ko Owuso lo, oki ya ma ase gyiyi lo. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Kweyi onyokwu oye yo ogya ni ya webe nu wa bo mo, &lt;Kepwo ko okwokwoshi dami kpo oya kepwo hin.&gt;<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />&lt;&lt;Ishi nwashika oya tanu. Ogwejeji oke ka diyinu mo, &lt;Koni nyya yoshi ko Owuso lo nki ya mase gyiyi lo ni, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />nyya hagye shini na ma mo onyokwu mani pyo okwokwoshi, ikweyi koni oya yuma apya ni!&gt;&gt;&gt;<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Kweyi Adole kamo, &lt;&lt;Ala moza ni ino kepwo ni gbo okwokwoshi lo ni ka ni. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Owuso ya gege ya dase nu ni oshu ni okwokwoshi koni aba kyegba danu kotu ke eno ni lo? Oya pyitikpi tuwa? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Nyya ka dala, so oma mo apyo okwokwoshi wa papa. Ni olemani, ishini Oyi ka Asuse wa, oya wa pya ase ni gbo otuse ese mani?&gt;&gt;<verse eid="LUK 18:8" /></para>
  <para style="s">Elase Ikweyi ko Ofarisi kpi Inozegba</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Oyesu ki kelase ikweyi kawase ni gbotu ipu koneshi wa kweyi ba mamo awa shashi sha shishini: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />&lt;&lt;Ango epa gipu ko Ole ko Owuso ko ga tinarigwu, oye wo Ofarisi, omwepa wi ino zegba. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Ofarisi nyiso kweyi tinarigwu ikweyi ki iyinu mo: &lt;Owuso, nkeshi wo koni nlema byase shishini lo ni; nyya wiyi lo, nyya yo ozalabi lo, nyya beba lo, nke le byi inozegba mani lo. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Nyya kwokwunu igbe epa ipu ko obize. Kweyi nyya zo oye ipu ki igwo ko oza ni ngbo ni kpiri.&gt;<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />&lt;&lt;Inozegba ke hagye ebe lenu. Ogege ziyi mi iso lo, okwagye ya shagye mo, &lt;Owuso mi iyinyinyi hin, inozalabi.&gt;<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />&lt;&lt;Nyya kadala, inozegba go ole kpo ozalabi lo ebe ko Owuso, ole bya ashe oni lo. Koni ase ni zi iyinu iso, aba zo wo ojije lo, ase ni ke yikweyi bagye, aba zo iso.&gt;&gt;<verse eid="LUK 18:14" /></para>
  <para style="s">Oyesu sa Ayileke Aboneshi</para>
  <para style="r">(<ref loc="MAT 19:13-15">oMatiyu 19.13-15</ref>; <ref loc="MRK 10:13-16">oMak 10.13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Ebeni abya ayi leke wa do Oyesu shini ona suwa abo ikweyi shini na ki tuwi inarigwu. Ishini awogboso ma mani ni, agba awase ni byuwa wa ni apwo mo ana hagye. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Oyesu ke ya ayi oni ogwu webe nu kweyi kamo, &lt;&lt;Ala shayi leke bita na webe hin, ala ka wuwobi lo, obula ko Owuso wa akakawa la.&gt;&gt; <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Nyya kadala okwokwoshi, ase ni zo obula ko Owuso byo oyi leke lo, oya gipu nu lo.&gt;&gt;<verse eid="LUK 18:17" /></para>
  <para style="s">Oteyi ni Gbo Odu ni</para>
  <para style="r">(<ref loc="MAT 19:16-30">oMatiyu 19.16-30</ref>; <ref loc="MRK 10:17-31">oMak 10.17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Oteyi oye wa do Oyesu okamo, &lt;&lt;Inofoza neshi, oji ni nyyaya shini na pyo olayi ko gbogbo-gbogbo?<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Oyesu kyogwu mo, &lt;&lt;Ojiya ni oya yumo ogwu mo ase neshi? Ashishe wo oneshi lo so Owuso fufu nu. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Ogyo ono, &lt;Ka beba lo, ka ngmase lo, ka wiyi lo, ka ba ase ela lo, geyagye da ada wo kpe ene wo.&gt;&gt;&gt;<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Okamo, &lt;&lt;Kpiri ka awo oza mani nyya ishini nwwo oyi leke ni.&gt;&gt;<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Ishini Oyesu pwe ela mani ni, oka da anu mo, &lt;&lt;Osho kpo oje. Ga yo oza ni ogbo ni kpiri yi ra shini oyi ikwiri yi da awoleha, kweyi oya gbo odu iso. Ome shini owa gbosun.&gt;&gt;<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Ishini opwo mani ni, otu nu bya kotata, ikweyi koni owase ni gbo odu nwashika ni. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Oyesu tiyi mo kweyi kamo, &lt;&lt;Oya lono do olodu ko go obula ko Owuso! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Nki ya kadala, oya le kwee do onyakwimi ko bwo owu ko onya, sho olodu ko go obula ko Owuso.&gt;&gt;<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Awase ni pwela mani do okamo, &lt;&lt;Owoni olemani, anoho ni aba ngma anu?&gt;&gt;<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Oyesu kyogwu mo, &lt;&lt;Ebe kasuse oya lemani lo, ebe ko Owuso ke kpiri ko oza oya gege ko ya.&gt;&gt;<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Obitrus ka da anu mo, &lt;&lt;Aha shojoji ka aha bita kweyi gboso!&gt;&gt;<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Oyesu ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, kpiri kase ni sho ole nu bita kwe onyanu kwe ayinanu nongo, kwe inanu kpa ada nu kwe ayinu ikweyi ko obula ko Owuso <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />oya pyo oza nwashika ni sha awo ni ipu kishi mani kpishi ni ya wa ni kpo olayi ko gbogbo-gbogbo.&gt;&gt;<verse eid="LUK 18:30" /></para>
  <para style="s">Oyesu Ki Kela Ikweyi ki Ikwu Nu</para>
  <para style="r">(<ref loc="MAT 20:17-19">oMatiyu 20.17-19</ref>; <ref loc="MRK 10:32-34">oMak 10.32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Oyesu ya awogboso igwepa ogwu go okoka kweyi ka dawa mo, &lt;&lt;Aha ba go Ojerusele, kweyi kpiri koza ni awobane ta ikweyi ko Oyi ka Asuse ya gya. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Aba yo ya nabo da awase ni wo Ase ko Oyahuda lo ni. Aba gbowuru, aba sesa, aba tehe sho, aba ya aboshi kweyi yo ngmo. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Eno ko omweta oki ya nyiso bwa amiri.&gt;&gt;<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Awogboso gyo oza ni oya ka ni lo. Ayikweyi kela yi teba da awa, kweyi awa gyoza ni oya kela ikweyi nu ni lo.<verse eid="LUK 18:34" /></para>
  <para style="s">Opwiyi ni ya boza ni Oyesu yo mebe</para>
  <para style="r">(<ref loc="MAT 20:29-34">oMatiyu 20.29-34</ref>; <ref loc="MRK 10:46-52">oMak 10.46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Ni Oyesu yo pee kpo Ojeriko ni, ofiyi oye yagye okoka ko owe ya boza. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Ishini opwoko kewa ba shigbo ni, odoka mo oji ya gbodagye. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Aka danu mo, &lt;&lt;Oyesu ko Onazareti pini ya shigbo la.&gt;&gt;<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Oka mo, &lt;&lt;Oyesu, Oyi ko Odawuda, miyinyinyi hin!&gt;&gt;<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Awase ni bohobu ni gbapwo kweyi kamo ona sha, anu ke ya zoko iso mo, &lt;&lt;Oyi ko Odawuda miyinyinyi hin!&gt;&gt;<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Oyesu hagye kweyi ka dawa mo ana byo ongo oni wa danu. Ishini abyo wobutu nu ni, Oyesu do oka mo, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />&lt;&lt;Oji ni oya yimu shini na ya dawo?&gt;&gt;</para>
  <para style="p" vid="LUK 18:41">Okyogwu mo, &lt;&lt;Adole, nyya yimu ko mebe.&gt;&gt;<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Oyesu ka danu mo, &lt;&lt;Gwiyi shini omebe, otuse wo dawo ogege.&gt;&gt; <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Ebebeni omebe kweyi gboso Oyesu, ya sho Owuso iye. Ishini kpiri kase ni bebeni ma mani ni, awa ki sho Owuso iye.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Ozaka Ino Zegba</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Oyesu ya shigbo bwo ogya nyakwu ko Ojeriko. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Ongo oye iye nu wo Ozaka yo ogya ni. Anu pini wo oteyi ka awozegba la. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Oya takirikwu ko mo Oyesu, oke gege lo ikweyi koni owase digbo kweyi ewa nwashika ebeni. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Ebeni onyinya kweyi ga toshi iso ke efu nyakwu ni hagye owe ni Oyesu wa shigbo shini ona mo.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Ishini Oyesu fo tu ke efu oni ni, otiyi mi iso kweyi ka da anu mo, &lt;&lt;oZaka, sa wo okpagye papa. Owo otiri shini na hagye ole wo ikyeni.&gt;&gt; <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Ebeni oZaka sa wo okpagye papa kweyi byo Oyesu go ole nu kpo otunehe.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Kpiri kase ni be ebeni mo oza ni gbodagye ni kweyi aba ka akyose mo, &lt;&lt;Oya go ole ki ine ko ozalabi.&gt;&gt;<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />oZaka ke takpa nyiso kweyi ka da Adole mo, &lt;&lt;Ma, Adole! Ebeni anani, nyya yo oza ni ngbo ni ya yi ko we epa kweyi nyya yo okwu oye ya yi da awoleha. Owoni nggya ashe egya kweyi zi ikwiri, nyya sore ko oza ni nze ni ole ene.&gt;&gt;<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Oyesu ka da anu mo, &lt;&lt;Ikyeni angmase ni bo ole ebeni ni, ikweyi koni ongo mani bwi ipwoma ki Ibirayi la. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Koni Oyi ka Asuse wa shini na tikpo kweyi ki ngmo oza ni gebi ni la.&gt;&gt;<verse eid="LUK 19:10" /></para>
  <para style="s">Elase Ikweyi ka Ayole Igwo</para>
  <para style="r">(<ref loc="MAT 25:14-30">oMatiyu 25.14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Ni aya akpaha ze ba pwe ela ni Oyesu ya ka ni, okelase da awa ikweyi koni oye pee kpo Ojerusele kweyi ase ba ma mo obula ko Owuso ya wa ishi oye kponu. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Okamo, &lt;&lt;Ongo oye wo oyi ose, ogo okpagye oye lenu shini ana to ose, kweyi ishini orose ona kwikye wo Obula wa. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Ebeni oya ayole nu igwo kweyi oda awo ikwiri igwo, oka da awa mo, &lt;Ala yo otoyu kpanu gbi ishini nwwa.&gt;&gt;<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />&lt;&lt;Awase nu ke yanya nu kweyi asha ase gboso kweyi ga kamo, &lt;Aha ba yimu ko ongo mani ko wose ka aha lo.&gt;<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />&lt;&lt;Oyi ose mani ro ose, kweyi okwikye wo obula wa. Ebeni otoleho ge ebe ka ayole nu ni oda awi ikwiri ni, oya yimu ko gyo oza ni opye kpa anu ni.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />&lt;&lt;Oyole kikyikyo wa kweyi wa kamo, &lt;Adole ikwiri oye wo, nyyo otoyu, npyi igwo manu.&gt;<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />Adole nu kyogwu mo, &lt;&lt;&lt;Nngmagye, oyole hin neshi, koni oyo okwokwoshi ikweyi ko oza gbayayi ni, nyya yo ya woteyi ko ogya nyakwu igwo.&gt;<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />&lt;&lt;Oyole ko omwepa wa kweyi wa kamo, &lt;Adole, ikwiri oye wo, nyyo otoyu kpa anu, npye eho manu.&gt;<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />&lt;&lt;Adole nu ka da anu mo, &lt;Awo ga wo oteyi ko ogya nyakwu eho.&gt;<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />&lt;&lt;Ebeni oyole oye wa kweyi wa kamo, &lt;Adole, ikwiri oye wo yoma, nyyi teba ipu ka ayikyi. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Nyya yoshi ko otu wo, ikweyi koni ogbo ono ni. Oya zo oza ebeni oyi tagye lo ni, kweyi oki ya kyo oza ebeni otu lo ni.&gt;<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />&lt;&lt;Adole nu kyogwu mo, &lt;Nyya kwe epwo bwe ebe kela ni oka ni, awo ayole bibi! Ogye mo nwwa ase ni gbo ono ni, nyya zo oza ebeni nyyi tagye lo ni, kweyi nki ya kyoza ebeni ntu lo ni? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Ojiya ni oyi ikwiri hin to olashiko, shini ishini ni nwwa, nbi ya zo oza hin kpi inyigwiye lo?&gt;<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />&lt;&lt;Ebeni oka da awase ni hagye ni mo, &lt;Ala yo ikwiri oye ni yi bize sha abo nu shini ala yi da ase ni gbo opami igwo ni.&gt;<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />Akamo, &lt;Adole,&gt; &lt;anu kwobonu gbi ikwiri igwo wa!&gt;<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />Okyogwu mo, &lt;&lt;Nyya kadala, kpiri kase ni gbo oza aba fu manu, ase ni ke go ojije lo, ko oza ni ogbo gbayayi ni aba yi bize sho. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Awase ni ke wa awomonyekwotu hin nu ni ba yimu mo naka wose wa lo ni, kpuwa we ebeni kweyi kpuwa ngmo obutu hin.&gt;&gt;&gt;<verse eid="LUK 19:27" /></para>
  <para style="s">Oyesu go Ojerusele</para>
  <para style="r">(<ref loc="MAT 21:1-11">oMatiyu 21.1-11</ref>; <ref loc="MRK 11:1-11">oMak 11.1-11</ref>; <ref loc="JHN 12:12-19">Oyohana 12.12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Ishini Oyesu ka awe ela mani kweyi ni, okwo owe ya go Ojerusele. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Ishini oyo pee kpo Obetafiji kpo Obetani ni, ebe kikpokyi ni aba yogwu mo Efu ko Ozetu ni, ota awogboso epa oleho kweyi ka da awa mo, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />&lt;&lt;Ala gogya leke ni yo ohobu kala ni, ogoga kala, ala ba mo oyi ko odagyi gbogbo ebeni, ni ashishe se ebibye wa lo ni. Ala yo yi shini ala byo we ebeni. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Owoni ashe da ala oka mo, &lt;Ojiya ni ala ba yo yi?&gt; Ala ka da anu mo, &lt;Adole pini ya yimu la.&gt;&gt;&gt;<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Awase ni otuwo oleho ni ga tanu byoni oka da awa ni. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Ni aba yo oyi ko odagyi ya yiyi ni, inoza duwoka mo, &lt;&lt;Ojiya ni ala ba yo oyi ko odagyi mani ya yiyi?&gt;&gt;<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Akyogwu mo, &lt;&lt;Adole pini ya yimu la.&gt;&gt;<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Aga byo oyi ko odagyi oni wa do Oyesu, ayo oshiye wa ta ikweyi ko odagyi kweyi ayo Oyesu yagye ikweyi nu. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Ni oyipu ki iyawu ya ga ni ase nwashika to oshiye wa ikweyi ko owe.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Ishini owa pee kpe ebeni owe gi kweyi ke Efu ko oZetu ni, kpiri ke ewa ka awogboso kwotu ko osho Owuso iye kpo oko nyakwu ikweyi ka awoza ki igbashi ni ama ni:<verse eid="LUK 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 19:38" />&lt;&lt;Otunehe yo kpo ose ni wa ipu ki iye ka Adole ni.&gt;&gt;</para>
  <para style="p" vid="LUK 19:38">&lt;&lt;Omene yipu ki iso kweyi Igyashi wa ko Owuso!&gt;&gt;<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Ashishini ka Awofarisi ni bi ipu ke ewa ni ka do Oyesu mo, &lt;&lt;Inofoza ka da awogboso na sha!&gt;&gt;<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Okyogwu mo, &lt;&lt;Nyya kadala, owoni asha, awikyikpo mani ba sha ami iye.&gt;&gt;<verse eid="LUK 19:40" /></para>
  <para style="s">Oyesu Kyegba Ikweyi ko Ojerusele</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Ni oyo pee kpo Ojerusele ni, oziyi iso mo ogya, kweyi osize iyikweyi nu,<verse eid="LUK 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 19:42" />kweyi kamo, &lt;&lt;Ojerusele, owoni ase wo bi gyo oza ni ya byo omene wa da ala nabani, ake yi leba da ala. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Eno ya wa ba ni awomonyekwotu kala ba shoba gyehe ta ala kweyi shogba ta ala kweyi ba wa ngma ala bwa agbabo kpiri. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Aba wa yo ogya kala ya kya, aba wa ya ayi kala ya ngmo kpiri. Aba sha akyo oyoye bita ya hagye ikweyi ko oye lo, ikweyi koni ala gyi ishi ko owowa ko Owuso da ala lo ni.&gt;&gt;<verse eid="LUK 19:44" /></para>
  <para style="s">Oyesu Gipu ko Ole ko Owuso</para>
  <para style="r">(<ref loc="MAT 21:12-17">oMatiyu 21.12-17</ref>; <ref loc="MRK 11:15-19">oMak 11.15-19</ref>; <ref loc="JHN 2:13-22">Oyohana 2.13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Oyesu gipu ko Ole ko Owuso, kweyi kwotu ko na awase ni ba tora ko oza ni.<verse eid="LUK 19:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 19:46" />Oka dawa mo, &lt;&lt;Ayi tota ipu ko Okpa mo, &lt;Ole hin wole ko tinarigwu la,&gt; ala ke yo pya wo ole ka awowi.&gt;&gt;&gt;<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Kurutu oya foza ipu ko Ole ko Owuso ose ka awosapa kpa awofono kpa awoteyi ka asuse ke ba takirikwu ko yo ngmo. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Ake pyo owe ko ya lo, ikweyi koni kpiri kase ba takirikwu ko pwe ela nu.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Oka Doda Ikweyi ko Oshu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">oMatiyu 21.23-27</ref>; <ref loc="MRK 11:27-33">oMak 11.27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Eno oye Oyesu ya fa ase oza ipu ko Ole ko Owuso, kweyi oya tono ko oshu neshi, oteyi ka awosapa kpa awofono kpa awanyakwase we ebe nu. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />Akamo, &lt;&lt;Ka daha, oshu wonya ni oya ya awoza mani kpa anu, anoho da awo oshu mani?&gt;&gt;<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Okyogwu mo, &lt;&lt;Ami ki gbo oka oye ko da ala. Ala ka da ami, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />obatisma ko Oyohana ni oya ya ni bwi iso la kwe bwe ebe ka asuse la?&gt;&gt;<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Ebeni akwotu ko tawashu kpi iyiwa mo, &lt;&lt;Owoni aha kamo obwebe ko Owuso la, oya ka daha mo, &lt;Ojiya ni ala tela ko kyogwu kpa anu?&gt;&gt; <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Owoni aha ke kamo obwe ebe ka asuse la, ase ba taha akyo koni akyogwu mo Oyohana wi inobane ni.&gt;&gt;<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Ebeni akamo, &lt;&lt;Aha gye ebeni obwanu wa ni lo.&gt;&gt;<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Oyesu ka da awa mo, &lt;&lt;Ami ke ya kadala oshu wonya ni nyyaya awoza mani kpa anu lo.&gt;&gt;<verse eid="LUK 20:8" /></para>
  <para style="s">Elase Ikweyi ka Awo osheho ka Abola</para>
  <para style="r">(<ref loc="MAT 21:33-46">oMatiyu 21.33-46</ref>; <ref loc="MRK 12:1-12">oMak 12.1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Oyesu ki kelase mani da ase mo: &lt;&lt;Ongo oye gbeho ki inabi, kweyi oyi da awosheho oye abo kweyi ga anu go okpagye oye ga gbeji kotata. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Ni ishi gye ko kyi izire ni, oto oyole nu oleho ko ga zo ogwogwa ke efu mani ebe ka awo osheho. Awo osheho mani ke gwo kweyi no abo yeye. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Oki to oyoleho oye oleho, oyoleho ni ke agwo kweyi gbo owuru ki ne enya kpa abo yeye. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Oki to oyole ko omweta oleho, kweyi ayi ibiri kweyi to we ese.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />&lt;&lt;Ebeni adeho mani kamo, &lt;Oji ni nyya ya? Nyya to oyi hin ni nyya yimu ni oleho; kwe awosheho ba mo ya gyiyi.&gt;<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />&lt;&lt;Ishini awosheho ka abola mo ni, aka diyiwa mo. &lt;Ino ro ogwu nu yoma, ala wa shan yo ngmo, shini ogwu na wa akaka aha.&gt; <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Ebeni ato bwo oko ko ongma we ese kweyi ayo ngmo.</para>
  <para style="p" vid="LUK 20:15">&lt;&lt;Oji ni ala ma byo ada keho mani wa ya kpa awa? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Oya wa kweyi wa ya awo osheho ka abola mani yi ngmo kweyi wa ye eho ya da awashe.&gt;&gt; Ishini ase pwela mani ni akamo, &lt;&lt;Oza mani naka gbodagye lo!&gt;&gt;<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Oyesu ke yi iyi kwuwa tiriri kweyi odoka mo, &lt;&lt;Oji wi ikweyi kela mani ni ayitota ni mo,</para>
  <para style="p" vid="LUK 20:17">&lt;&lt;&lt;Akyo ni awomoda tela nu ni, anu pini wo oshu kole&gt;? <verse eid="LUK 20:17" /><verse number="18" style="v" sid="LUK 20:18" />Ase ni gbo ikweyi ka akyo mani oya kyigbo wuruwuru, ase ni oke gboso oya yo ya gba wo omu.&gt;&gt;<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Awofono kpo ose ka awosapa ba tikpo ko owe ni aba yo kwu ebebeni, ikweyi koni agye mo okelase ikweyi wa ni. Awa ke ba yoshi ka asuse.<verse eid="LUK 20:19" /></para>
  <para style="s">Egba ko Okesa</para>
  <para style="r">(<ref loc="MAT 22:23-33">oMatiyu 22.23-33</ref>; <ref loc="MRK 12:18-27">oMak 12.18-27</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Akpiyi kwo ba mo oza ni oyaya ni, asha ase ba gboso shini ana moza ni oya ya ni, awa ni wa bya ase neshi ni. Aba yimu ko kwo Oyesu kpela oye shini ana yo nabo doshu ko ogbolamaga. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Ebeni awase ni ashuwa ni do oka mo, &lt;&lt;Inofoza, aha gye mo oza ni oya ka ki ya fu ni gyogye la, oya yimu ka ashe sha ashe lo, oke ya foza ko Owuso owe ko kwokwoshi. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Ogyogye la shini ahan zegba do Okesa kwe ahan ka ze lo?&gt;&gt;<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Oyesu ke gyo oza ni yipu ko otu wa ni kweyi oka da awa mo, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />&lt;&lt;Ala shiya ami odinari. Oyi ka anoho kpi iye ka anoho yipu nu?&gt;&gt;<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Akyogwu mo, &lt;&lt;Ko Okesa.&gt;&gt;</para>
  <para style="p" vid="LUK 20:25">Oka da awa mo, &lt;&lt;Ala do Okesa oza ni wa ko Okesa, ala do Owuso oza ni wa ko Owuso.&gt;&gt;<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Agege ko ze eda da anu ikweyi ko oza ni oka iyi ke ewa ni ke lo. Igbashi yuwa kwu agege kela lo.<verse eid="LUK 20:26" /></para>
  <para style="s">Gbo Onya kpo Nyiso ka Amiri</para>
  <para style="r">(<ref loc="MAT 22:23-33">oMatiyu 22.23-33</ref>; <ref loc="MRK 12:18-27">oMak 12.18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Ebeni ashishini ka Awosadusi ni mo onyiso ka amiri yaba lo ni we ebe ko Oyesu wa do oka mo, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />&lt;&lt;Inofoza, Omusa kamo owoni ongo gbo onya kweyi omo oyi kpa anu lo gbi ishini ogekwu, oyinanu ya doka ko onya oni shini na mo oyi da anu. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Ishi oye agba ayene ahapa. Akikyikyo ipu wa gbo onya kweyi mo oyi lo gbishini ogekwu. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Ko omwepa, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />kpa ako omweta doka nu, mama ni kpiri wa ase ahapa gekwu ashishe wa mo oyi kpa anu lo. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Ogwejeji nu, onya ni gekwu. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Nabani onyiso ka amiri, oya wo onya ka anoho ipu wa ikweyi koni kpiri wa ase ahapa do oka nu ni?&gt;&gt;<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Oyesu kyogwu mo, &lt;&lt;Ala ase ki ishi mani ba gba anya kweyi aba bya anya go oda oba. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Awase ni ke shu ko bi ipu ka awonyiso amiri abayi oyi ni yawa ni aba gba anya kwe aba byuwa go oda ba lo, <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />kweyi aba gekwu lo; koni ale bya ayoleho ni. Awayi ko Owuso, ikweyi koni awayi ko nyiso ka amiri ni. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Omusa ke ka gbo ipu ki igwu ki ikyashi mo awase ni gekwu ba nyiso amiri, koni oya Adole ogwu mo, &lt;Owuso ki Ibirayi, Owuso ki Ishakwu kpo Owuso ko Oyakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">20.37 </char><char style="ft" closed="false">OBOSE 3.6</char></note> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Owo Owuso kawase ni gekwu lalo, oke wa ka awo gbo olayi la, ikweyi koni bwebe nu kpiri wa gbolayi.&gt;&gt;<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Ashishini ka awofono kyogwu mo, &lt;&lt;Inofoza, okela wo gyogye la!&gt;&gt; <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Kweyi ado oka ko ojije kelo.<verse eid="LUK 20:40" /></para>
  <para style="s">Okristi wo Oyi ka Anoho?</para>
  <para style="r">(<ref loc="MAT 22:41-46">oMatiyu 22.41-46</ref>; <ref loc="MRK 12:35-37">oMak 12.35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Ebeni Oyesu ka dawa mo, &lt;&lt;Aba yamoji ba ka mo Okristi<note caller="+" style="f"><char style="fr" closed="false">20.41 </char><char style="ft" closed="false">Messiah</char></note> wo Oyi ko Odawuda? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Odawuda abiyinu ka ipu ko Okpa ki Igye mo, &lt;&lt;&lt;Adole ka da Adole hin mo, &lt;Yagye abore hin,<verse eid="LUK 20:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 20:43" />gbishini nyya ya awomonyekwotu wo ba wa wo oka ki ikpo wo.&gt;&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">20.43 </char><char style="ft" closed="false">Okpa ki Igye 110.1</char></note> <verse eid="LUK 20:43" /><verse number="44" style="v" sid="LUK 20:44" />Odawuda yo ogwu mo &lt;Adole.&gt; Bwo owe wonya ni oya wo oyi nu?&gt;&gt;<verse eid="LUK 20:44" /></para>
  <para style="s">Ala Gbera kpa Awofono</para>
  <para style="r">(<ref loc="MAT 23:1-36">oMatiyu 23.1-36</ref>; <ref loc="MRK 12:38-40">oMak 12.38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Ni ase tayayo ba pwela nu ni, Oyesu ka da awogboso mo, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />&lt;&lt;Ala gbera kpa awofono! Aba yimu ko yawu kpo obagidi, kweyi ba yimu shini ana tuwo ogbogba ipishi, ana da awa oka ko yagye neshi ipu ke ekpa kpe ebe ki imya. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Aba ya anyokwu ole ya bize, aki ba tinarigwu gbeji. Edo kase mani aba wa kwuwe epwo ko tata.&gt;&gt;<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Oza ko Otukyokye ko Onyokwu</para>
  <para style="r">(<ref loc="MRK 12:41-44">oMak 12.41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Ishini Oyesu zi iyi iso ni, oma awolodu ba zeshi ko otukyokye wa ba tipu ko odudu ko Ole ko Owuso. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Oki mo onyokwu oye ni wo oleha ni yo ikwiri nu epa yi ti ipu ko olashiko. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Okamo, &lt;&lt;Nyya kadala okwokwoshi, eshi ni onyokwu ni wo oleha mani ze ni shoshi sha aka ananoho. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Kpiri kawase mani ze eshi bwipu ko odu wa; anu ke ze ipu ke eha nu, oto oza ni ogbo ko re ni.&gt;&gt;<verse eid="LUK 21:4" /></para>
  <para style="s">Oyi ko Kweyi ki Ishi Mani</para>
  <para style="r">(<ref loc="MAT 24:1-2">oMatiyu 24.1-2</ref>; <ref loc="MRK 13:1-2">oMak 13.1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Ashishini ka awogboso ba kela ikweyi ko Ole ko Owuso ni agwa agya kpi ikyikpo kpe eshi ni aze do Owuso ni. Oyesu ke kamo, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />&lt;&lt;Oza ni ala ma ebeni, ishi ya wa ba ni aba shi ikyikpo oyoye bita ya hagye ikweyi ko oye lo; kpiri wa aba yi sa sho okpagye.&gt;&gt;<verse eid="LUK 21:6" /></para>
  <para style="s">Owe kpe Egye Moma</para>
  <para style="r">(<ref loc="MAT 24:3-14">oMatiyu 24.3-14</ref>; <ref loc="MRK 13:3-13">oMak 13.3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Adoka mo, &lt;&lt;Inofoza, ishi wonya ni awoza mani ba gbodagye? Kweyi oji ya wo oyi ni ya shiya aha mo aba yimu ko gbodagye?<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Okyogwu mo, &lt;&lt;Ala gbera ela koni ashishe na ka bya ala go owe labi lo. Koni ase nwashika ba wa kpi iyen, ba kamo, &lt;Ami wo Okristi la, ishi yo pee.&gt; Ala ka gbosuwa lo. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Ishini ala pwela ke efu kpokpo kpa awashosha, ala ka yoshi lo. Awoza mani kpiri ba gbodagye, oke wo okweyi kese lalo.&gt;&gt;<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Ebeni oka da awa mo, &lt;&lt;Okpagye oye ba kpefu kpo okpagye oye, obula oye ba kpefu kpo obula oye. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Okpagye ya ja jigi-jigi, ase ba ngme emye kpe ere ebebe nya, kweyi oyi ko oza ko ta ase oshi neneshi ba gbodagye bwi iso.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />&lt;&lt;Ime awoza mani ke, aba kwa ala kweyi ba da ala egye. Aba bya ala ge ekpa kpo oruduru, aba bya ala go obutu ka awose kpa awogbolamaga kpiri ipu ki iye hin. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Omani ya da ala ko oshu yo olobene ikweyin. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Ikweyi koni ke ala ka byotu ikweyi ko oza ni ala ba ka ni lo. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Koni nyya da ala ela kpo oziyi ni ashishe ipu ka awomonyekwotu kala ya gege ya tawashu ikweyi ko oza ni ala ba ka ni lo. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Awene kpa awada kpa ayene kala kpase ki ipwoma kala kpa awoya kala ba ya ala ra kweyi aba ya ashishini kala ngmo. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Ase nwashika ba ya anya kala ikweyin. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Oyoye ipu ki inyeyi ki ikweyi kala ke ya gebi lo. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Owoni ala hagye giri ala ba pyo olayi.<verse eid="LUK 21:19" /></para>
  <para style="s">Oyesu Kela Ikweyi ke Ebi ni wa Ro Ojerusele ni</para>
  <para style="r">(<ref loc="MAT 24:15-21">oMatiyu 24.15-21</ref>; <ref loc="MRK 13:14-19">oMak 13.14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />&lt;&lt;Ishini ala ma awadakare shogba to Ojerusele, ala gye mo ishi ko yo kya yo pee. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Ebeni awase ni bo okpagye ko Ojudiya ni na nyinya gi ikweyi ke efu, awase ni bo ogya nyakwu na bose, kweyi awase ni bo ogya leke na ka gipu ko ogya nyakwu lo. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Ikweyi koni omani pini wi ishini aba dase owe kpiri byoni ayi tota ni. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Ishi oni ya labi da anya ni bifu kpa anya ni bya ayi abo ni! Ikweyi koni ishi oni aba mo owe labi okpagye ni kweyi anya ko Owuso ya wa ikweyi kawase ni. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Aba ngma ashishini kpe ewakpa, aba bya ashishini ga shetu okpagye kpiri. Awase ni wa Ase ko Oyahuda lo ni ba da ase ko Ojerusele ikpo gbi ishini ishi kawase ni wo Oyahuda lo ni wa ya gye.<verse eid="LUK 21:24" /></para>
  <para style="s">Owowa ko Oyi ka Asuse</para>
  <para style="r">(<ref loc="MAT 24:29-31">oMatiyu 24.29-31</ref>; <ref loc="MRK 13:24-27">oMak 13.24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />Aba mo oza ko oshi ipu ke eno, kpo oya, kpi inyiwo. Ipu kese okpagye gogogogo ba yoshi kotata ikweyi ke eya ko ogwa ki ishu nyakwu. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Asuse ba yoshi kweyi ba shekwu, ikweyi ko oza ni ya gbodagye ese ni, koni oza ni bo okpowuso ni ba ja. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Ipu ki ishi oni aba mo Oyi ka Asuse ya bwi ipu ko okpowuso kpo oshu kpo igyashi. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Ishini awoza mani ba gbodagye, ala kyi iyi kala tu neneshi ikweyi koni inongma ala yo pee.&gt;&gt;<verse eid="LUK 21:28" /></para>
  <para style="s">Ozafofu ko Oyesu Ikweyi ke Efu ko Odegyo</para>
  <para style="r">(<ref loc="MAT 24:32-35">oMatiyu 24.32-35</ref>; <ref loc="MRK 13:28-31">oMak 13.28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Okelase mani da awa mo: &lt;&lt;Ala me efu ko ofigi kpa ashishini ke efu. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Ishini efu wa kwotu ko fu, ala gye mo ogwa ya yimu ko gbo. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Mamani, ishini ala ma awoza mani ba gbodagye, ala gye mo obula ko Owuso yo pee.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />&lt;&lt;Nyya kadala okwokwoshi, awoza mani kpiri ba gbodagye ome ese ki ikyeni na shigbo. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Iso kpo okpagye ya shuga, elan ke ya shuga lo.<verse eid="LUK 21:33" /></para>
  <para style="s">Otugbagba ko Gbera</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />&lt;&lt;Ala gbera, ala ka yo otu kala do ozarore kpi inyi gwogwa, kpo otu byobya ikweyi ki iyo kese mani lo, koni eno ya wa kwa ala gba. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Ikweyi koni oya wa ikweyi kawase ni bi ipu kese ni kpiri. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Ala bagye kpe era, ala bi tinarigwu ishi kpiri shini ala pyo oshu ko bose shi ipu ko oza ni ya yimu ko gbodagye ni, kweyi ala ba gege ko hagye obutu ko Oyi ka Asuse.&gt;&gt;<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Ishi kpiri Oyesu ya foza ipu ko Ole ko Owuso, kweyi onose kpiri oya bose ge ese gi ikweyi ke efu ni aba yogwu mo Efu ko oZetu ga kya, <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />kweyi kpiri kase ba bose ototukpokyi ko pwela nu ipu ko Ole ko Owuso.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Oyahuda Kyogwu ko yo Oyesu Ra</para>
  <para style="r">(<ref loc="MAT 26:1-5">oMatiyu 26.1-5</ref>; <ref loc="MRK 14:1-2">oMak 14.1-2</ref>; <ref loc="JHN 11:45-53">Oyohana 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Ni ishi ki Imya kikyoga ni gbo Oyisi lo ni aba yo mo Osheyi ba pya ni, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />kweyi awose ka awosapa kpa awofono ba tiyi ko owe ko yo Oyesu ngmo, ake ba yo oshi ka asuse.<verse eid="LUK 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Ebeni ibiri gipu ko otu ko Oyahuda ni aba yo mo Iskariyoti, oye ipu ka ayikoko ko Oyesu igwepa. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Oyahuda gebe ka awose ka awosapa kpa awogbeho kole ko Owuso ga gbela kpa awa ko tikpo ko owe ni oya yo Oyesu ya ra dawa ni. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Ashotunehe kweyi kyogwu ko da anu ikwiri. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Okyogwu, oya tikpo ko owe ni oya yo Oyesu da awa ishini ase baba lo ni.<verse eid="LUK 22:6" /></para>
  <para style="s">Oyesu Roza ki Imya ko Osheyi</para>
  <para style="r">(<ref loc="MAT 26:17-25">oMatiyu 26.17-25</ref>; <ref loc="MRK 14:12-21">oMak 14.12-21</ref>; <ref loc="JHN 13:21-30">Oyohana 13.21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Ishini eno gye ko ri Imya ki Ikyoga ni gbo Oyisti lo ni, eno ni aba yo oyi ko otukpo ngmo ko ri Imya ko Osheyi ni. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Oyesu to Obitrus kpo Oyohana oleho mo, &lt;&lt;Ala ga kyebetu daha ko roza ki imya ko Osheyi.&gt;&gt;<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Ado oka mo, &lt;&lt;Ebenya ni oya yimu shini ahan ga ya ni imya mani?&gt;&gt;<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Okyogwu mo, &lt;&lt;Owoni ala gipu ko ogya, ongo oye yawa tala kpo ogya ki inyawo, ala gboso gipu kole ni oya ga nu ni. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Kweyi ala ka di ine kole mo, &lt;Inofoza mo an doka: Oda ko ogboga yini, ebeni nyya wa roza ko Osheyi kpa awogbosun ni?&gt; <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Kweyi oya shiya ala oda ki iso nyakwu, akyanutu kpiri. Ala yo ozarore ebeni.&gt;&gt;<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Aga kweyi ga ma byoni oka da awa ni. Kweyi ayo ozarore ko Osheyi.<verse eid="LUK 22:13" /></para>
  <para style="s">Ozarore ka Adole</para>
  <para style="r">(<ref loc="MAT 26:26-30">oMatiyu 26.26-30</ref>; <ref loc="MRK 14:22-26">oMak 14.22-26</ref>; 1 Okor 11.23-25)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Ni ishi ya ko roza ni, Oyesu kpa ayikoko ko Oyesu bagye oka. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Oka da awa mo, &lt;&lt;Ngbeyi kishi mani gbeji wa ko roza ko Osheyi kpala ome shina mowe. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Nyya kadala, nyya roza mani kpa ala kelo gbi ishini ala ba wa gyikweyi nu neneshi obula ko Owuso.&gt;&gt;<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Oza abwa ki inyi kweyi okeshi do Owuso kweyi kamo, &lt;&lt;Ala ze shini ala ko di iyi kala. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Nyya kadala, nyya gwinyi mani kpa ala kelo so obula ko Owuso wa.&gt;&gt;<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Oki zo ikyoga, kweyi okeshi do Owuso kweyi kyigbo da ayikoko ko Oyesu mo, &lt;&lt;Omani pini wi ikpiye hin ni nyya ze ikweyi kala; ala bi ya mani shini ala rela hin.&gt;&gt;<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Mamani ishini aroza kweyi ni oza abwa kweyi mo, &lt;&lt;Omani pini wa abwa ko okoyi pepe ko oyi hin ni ayi shonu ikweyi kala ni. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Ase ni ke ya yun ra ni ya roza kpa ami owatu oye kpo nu. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Oyi ka Asuse ya gekwu byoni akwobonu ka bwi ikyikyo ni, igbe ke na ta ase ni yo ra ni.&gt;&gt; <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Ayole nu kwotu ko diyiwa oka mo, anoho ipu ka aha ya gege ko yo oza mani?<verse eid="LUK 22:23" /></para>
  <para style="s">Anoho wo Oneneshi?</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Ebeni akwotu ko shawa kpi iyiwa mo anoho ya wo oneneshi ipu wa. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Oyesu ka da awa mo, &lt;&lt;Awose ka Ashashe ba yuwa oza ko oshu, kweyi aba yi iyiwa ogwu mo ase neshi. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ala ke ka lemani lo. Ase ni wa anyakwase ipu kala na zi iyinu wa ase leke, kweyi oteyi ipu kala ni zi iyinu wo oyole. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Anoho wo oneneshi, ase ni yo oka ni la kwe, ase ni wo oyole ni? Ami ke yagye ipu kala bya ase ni wo oyole ni.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />Ala wa ase ni bagye kpami ishi ko omama hin ni. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Kweyi nyya da ala obula byoni ada hin da ami ni, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />shini ala roza gwinyikweyi ko oka kpa ami ipu ko obula hin kweyi ala wa bagye ebe, ba kepwo ikweyi ka ayi ki ipwoma igwepa ki Izrayila.<verse eid="LUK 22:30" /></para>
  <para style="s">Oyesu kamo Obitrus wa Tawashu nu</para>
  <para style="r">(<ref loc="MAT 26:31-35">oMatiyu 26.31-35</ref>; <ref loc="MRK 14:27-31">oMak 14.27-31</ref>; <ref loc="JHN 13:36-38">Oyohana 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />&lt;&lt;Osimo, Osimo, Ibiri ya doka shini ana shobita na ya ala sha byo omu ni. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Ami ke tinarigwu da awo oSimo shini otuse wo naka gbo lo. Kweyi ishini okwikye we ebe hin, ta ayene wo otugbagba.<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Okyogwu mo, &lt;&lt;Adole, ami yaba ko go oruduru, ko gekwu kpa awo.&gt;&gt;<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Oyesu kamo, &lt;&lt;Obitrus, nyya ka da awo, obogwu ya tono ikyeni lo so tawashu igbeta mo ogyun lo.&gt;&gt;<verse eid="LUK 22:34" /></para>
  <para style="s">Owo Otiri shini Oza ni Okpa ka ni na Gya Ikweyi ko Oyesu</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Ebeni Oyesu duwo oka mo, &lt;&lt;Ishini ntala oleho mo ala ka ga kpo okyo kwe oshu ki iyo kwe okpabawu lo ni, oje nyala?&gt;&gt;</para>
  <para style="p" vid="LUK 22:35">Akamo, &lt;&lt;Ojije nyaha lo.&gt;&gt;<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Oka da awa mo, &lt;&lt;Anani owoni ala gbo okyo, ala ze, ki kpo oshu ki iyo. Kweyi owoni ala gbe ewakpa lo, ala yo obagidi kala ra shini ala re ewakpa. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Nyya kadala, ayitota ipu ko okpa ko Owuso mo: &lt;Ayo ka tipu ka awinozalabi,&gt;<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">ISH 53.12 </char></note> nyya kadala owotiri shini awoza ni ata ikweyi hin bwa abo kawo bane kpiri na gya.&gt;&gt;<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Awogboso kamo, &lt;&lt;Adole ma, ewakpa epa yoma.&gt;&gt;</para>
  <para style="p" vid="LUK 22:38">Okamo, &lt;&lt;Ogbayi.&gt;&gt;<verse eid="LUK 22:38" /></para>
  <para style="s">Oyesu Tinarigwu Efu ko Ozetu</para>
  <para style="r">(<ref loc="MAT 26:36-46">oMatiyu 26.36-46</ref>; <ref loc="MRK 14:32-42">oMak 14.32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Oyesu bose ge Efu ko oZetu ko tinarigwu byoni owo odu nu ni kweyi awogboso byoshi. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Ishini ofe ebeni ni oka da awa mo, &lt;&lt;Ala tinarigwu shini ala ka gbo ipu ko omama lo.&gt;&gt; <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Oshaga bye enu ka akyo tota kweyi ga kwagye tinarigwu mo, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />&lt;&lt;Ada, owoni okyogwu, obi ya abwa ko owe mani yi bize shun, oke wi imun lalo, imu wo la ona gbodagye.&gt;&gt; <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Ebeni oyoleho ko Owuso bose bwi iso kweyi to otugbagba. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Ikweyi koni obyotu kotata ni, obelela ko tinarigwu gbishini ehe ya shonu bwi ikpiye nu byo oyi.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Ishini otinarigwu kweyi ni okwikye ge ebe ka awogboso, oga ta awa ba gbola ipu ko otu byobya. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Oduwoka mo, &lt;&lt;Ojiya ni ala ba gbola? Ala nyiso shini ala tinarigwu shini ala ka gbo gipu ko omama lo.&gt;&gt;<verse eid="LUK 22:46" /></para>
  <para style="s">Ayo Oyesu Kwu</para>
  <para style="r">(<ref loc="MAT 26:47-56">oMatiyu 26.47-56</ref>; <ref loc="MRK 14:43-50">oMak 14.43-50</ref>; <ref loc="JHN 18:3-11">Oyohana 18.3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Oyesu yipu kela ya ka, Oyahuda oye ipu ayikoko ko Oyesu nu igwepa kpe ewa ka asuse we ebe ko Oyesu. Oyahuda yawu ge ebe ko Oyesu ga to ogbogba ko oya. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Oyesu ke do oka mo, &lt;&lt;Oyahuda, oya yo Oyi ka Asuse ya ra mani la?&gt;&gt;<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Ishini awogboso Oyesu mo oza ni ya gbodagye ni, aka mo, &lt;&lt;Adole, ahan sha ase igbo kpe ewakpa?&gt;&gt; <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Kweyi oye ipu ka ayikoko ko Oyesu nu yo oshe ka anyakwase ko osapa oye akpaha ka abore ngma kpe ewakpa.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Oyesu ke kamo, &lt;&lt;Ala shibita!&gt;&gt; Kweyi ogabo anu akpaha kweyi da anu ogege.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Ebeni Oyesu ka da awose ko osapa kpa awadakare ni yo oko Ole ko Owuso kpa awanyakwase ni we ebe ko kwo ni mo, &lt;&lt;Ala wa kpe ewakpa kpo okposhi ko wa kwun byo nwwo owi? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Ishi kpiri nyyipu kole ko Owuso kpa ala, ala kwun lo? Omani ke wi ishi kala kpo oshu ke ebe dibu.&gt;&gt;<verse eid="LUK 22:53" /></para>
  <para style="s">Obitrus Tawashu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 26:57">oMatiyu 26.57</ref>,<ref loc="MAT 26:58">58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53">oMak 14.53</ref>,<ref loc="MRK 14:54">54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Oyohana 18.12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Ebeni ayo Oyesu kwu kweyi byo ge ebe ko osapa nyakwu. Obitrus gboso ebe lenu. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Ishini ake gwola otutehe ka akpada kole kweyi bagye ba gyola, Obitrus ya gyola kpa awa. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Oyole nonya oye mo Obitrus bwo oyoyu ko ola kweyi kamo, &lt;&lt;Ongo mani wo oye ipu wa.&gt;&gt;<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Obitrus tawashu mo, &lt;&lt;Onya, ami gyo ongo mani lo.&gt;&gt;<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Ipu ki ishi gbayayi ashe mo kweyi kamo, &lt;&lt;Owo oye ipu wa.&gt;&gt;</para>
  <para style="p" vid="LUK 22:58">Obitrus kamo, &lt;&lt;Adole, ngyo lo.&gt;&gt;<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Ipu ki ishi gbayayi, ashe ki kamo, &lt;&lt;Ko okwokwoshi anu mani yo kpa anu ikweyi koni owase ko Ogalili la.&gt;&gt;<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Obitrus kyogwu mo, &lt;&lt;Adole, ngyo oza ni oya kela ikweyi nu mani lo!&gt;&gt; Ni otayayo ya kela ni obogwu tono. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Ebeni Adole pyiyi kwo Obitrus tiriri. Ebeni Obitrus rela ni Adole ka da anu ni mo: &lt;&lt;Ime obogwu na tono, oya tawashu hin igbeta kamo ogyun lo.&gt;&gt; ome <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Obitrus sha akpada kole bita kweyi ga kyegba ko otata.<verse eid="LUK 22:62" /></para>
  <para style="s">Awogbeho Sho Oyesu Enyo</para>
  <para style="r">(<ref loc="MAT 26:67-68">oMatiyu 26.67-68</ref>; <ref loc="MRK 14:65">oMak 14.65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Awogbeho sho Oyesu enyo kpi izegwogwo. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Ayo oza gbiyi kweyi kamo, &lt;&lt;Bane daha! Anoho gwo?&gt;&gt; <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Kweyi edo kesa kpiri aso.<verse eid="LUK 22:65" /></para>
  <para style="s">Abyo Oyesu go Obutu ka Awonongbo</para>
  <para style="r">(<ref loc="MAT 26:59-66">oMatiyu 26.59-66</ref>; <ref loc="MRK 14:55-64">oMak 14.55-64</ref>; <ref loc="JHN 18:19-24">Oyohana 18.19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Ototukpoki onongbo ka awanyakwase, awofono kpa awosapa wa gbayi, kweyi abyo Oyesu go obutu wa. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Akamo, &lt;&lt;Ka daha, awo pini wo Omezaya la?&gt;&gt;</para>
  <para style="p" vid="LUK 22:67">Oyesu ka da awa mo, &lt;&lt;Owoni nka dala, ala ba kyogwu kpa ami lo, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />kweyi owoni ndaloka, ala ba koje dami lo. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Bwi ishi mani go ohobu ke, Oyi ka Asuse ya yagye abore ko Owuso ine ko oshu.&gt;&gt;<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Kpiri wa do oka mo, &lt;&lt;Awo pini wo Oyi ko Owuso la?&gt;&gt;</para>
  <para style="p" vid="LUK 22:70">Okyogwu mo, &lt;&lt;Byoni ala ka ni, ami la.&gt;&gt;<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Ebeni aka mo, &lt;&lt;Olobene koji ni aha ba yimu? Aha pwo bwo okwunu nu.&gt;&gt;<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Abyo Oyesu Ge Ebe ko Obilatus</para>
  <para style="r">(<ref loc="MAT 27:1">oMatiyu 27.1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">oMak 15.1-5</ref>; <ref loc="JHN 18:28-38">Oyohana 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Ebeni kpiri ka awonongbo nyiso kweyi byo ge ebe ko Obilatus. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Kweyi akwotu ko kwe epwo mo, &lt;&lt;Ato ongo mani ya fa ase ko okpagye ka aha oza bibi. Oma ana ka zegba do Okesa lo kweyi oki manu wo Omezaya, ose.&gt;&gt;<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Mani oni Obilatus do Oyesu oka mo, &lt;&lt;Awo pini wose ka Ase ko Oyahuda la?&gt;&gt;</para>
  <para style="p" vid="LUK 23:3">Oyesu kyogwu mo, &lt;&lt;Byoni oka ni.&gt;&gt;<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Ebeni Obilatus tono da awose kawo osapa kpe ewa ka asuse mo, &lt;&lt;Nkwo ongo mani kpe epwo oyoye lo.&gt;&gt;<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Ake belela mo, &lt;&lt;Oya tela okpagye ko Ojudiya kpiri. Okwotu bwo Ogalili, anana mani owe ebebeni wa.&gt;&gt;<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Ni opwe ela mani ni, Obilatus doka mo, &lt;&lt;Ongo mani bwo Ogalili la?&gt;&gt; <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Ishini owa gye mo Oyesu bwo obula ko Ohiridus ni, osabo gebe ko Ohiridus ni yo Ojerusele ishi oni.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Ohiridus shotunehe nwashika koni omo Oyesu ni, ikweyi koni oyi iyinu zoze gbeji ya webe ko mo. Bwi ipu kela ni opwo ikweyi nu ni, oya yimu ko mo ya yo oza ki igbashi. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Odoka kela lewa, Oyesu ke ko ojije lo. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Awose ka awosapa kpa awofono hagye ebeni ba kwo Oyesu epwo kpe ela loshu loshu. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Ebeni Ohiridus kpa awadakare nu she enyo ki gbo owuru. Asho oshiye nyakwu kweyi akwikye anu ge ebe ko Obilatus. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Eno oni Ohiridus kpo Obilatus wo oya; gbikyikye awo omonyekwotu kiyiwa la.<verse eid="LUK 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Obilatus kpa awose ka awosapa, kpa awose kpase kpiri tukpa, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />kweyi oka da awa mo, &lt;&lt;Ala byo ongo mani wa da ami mo oya gya ase egya. Nmoma obutu kala ebeni, nke kwo kpe epwo ni ala byi wa ni lo. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Mamani Ohiridus kwo kpe epwo lo, pini osabo kwikye wa daha ma; byoni ala ma ni, ongo mani yo ozalabi ni gye ko yo ngmo ni lo. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Ikweyi koni, nyya ya aboshi kweyi ya shobita.&gt;&gt; <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Ishi ki Imya ko Osheyi kpiri Obilatus ya ngma ashe oye ipu ka awo bo oruduru.<note caller="+" style="f"><char style="fr" closed="false">23.17 </char><char style="ft" closed="false">Ashishini ko okpa nekye na ata kpa abo ni gbo omani lo </char></note><verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Ewa ka asuse sheha kpo oko oye kponu ba mo, &lt;&lt;Yo ngmo! Sho Obaraba bita daha!&gt;&gt; <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Abyo Obaraba go oruduru ikweyi koni otonu ogya kweyi ngmase.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Obilatus ki duwo oka ikweyi koni oya yimu ko sho Oyesu bita. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Awa ke ba ngmegba mo, &lt;&lt;Yo poshi! Yo poshi!&gt;&gt;<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Obilatus ki kela kpa awa ko omweta mo: &lt;&lt;Ojiya? Oji ni ongo mani ya? Nmojije ni oya ni aba kwe epwo ko yo ngmo ni lo. Ni olemani oni nyya ya aboshi kweyi ya shobita.&gt;&gt;<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Awa ke ngmegba kpo oko nwa mo aba yimu shini ana yo poshi, kweyi egba ngmongmo wa yo yo da awa. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Obilatus kwepwo byoni aba yimu ni. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Osho Obaraba ni ngma ase ki tonu ogya ni ayo kwu to oruduru ni bita byoni adoka ni, kweyi oyo Oyesu da awa mo ana yo oza ni shuwo otu ni.<verse eid="LUK 23:25" /></para>
  <para style="s">Ayo Oyesu Poshi</para>
  <para style="r">(<ref loc="MAT 27:32-44">oMatiyu 27.32-44</ref>; <ref loc="MRK 15:21-32">oMak 15.21-32</ref>; <ref loc="JHN 19:17-27">Oyohana 19.17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Ni abyo ba ga ni, agbayi kpo simo ni wa ase ko Osiriya ni, oya wa bwo ogya leke kweyi abyo ko oshu zo oshi ko Oyesu kweyi gboso itikpi. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Ogbayi kase nwashika gboso, kpa anya ni ba kyegba ba byotu ikweyi nu. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Oyesu pyiyi muwa kweyi kamo, &lt;&lt;Anya ko Ojerusele, ala ka kyegba ikweyin lo; ala kyegba ikweyi kiyi kala kpa ayi kala. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Koni ishi yawa ba ni ala ba kamo, &lt;Otunehe yo kpa anya ni wo odoma ni, ipu ni moyi ebibye lo ni kpa ame ni ayi gwa ebibye lo ni!&gt; <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Ebeni</para>
  <para style="q1" vid="LUK 23:30">&lt;&lt;&lt;aba ka de efu mo, &lt;&lt;Gbo saha!&gt;&gt;</para>
  <para style="q2" vid="LUK 23:30">Kweyi ikpokyi na, &lt;&lt;Yaha gwu!&gt;&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23.30 </char><char style="ft" closed="false">Oseya 10.8</char></note><verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />Owoni aya kpe efu meme mani, oya lemoji koni owo ngmongmo?&gt;&gt;<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Abya ango epa ni wa awiyi ni ga kpa anu ko yuwa ngmo. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Ishini afebe ni aba yogwu mo Okpokwu-ki-ikweyi ni, ebeni ayo poshi kpa awiyi epa, oye abore nu, oye aboshe nu. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Oyesu kamo, &lt;&lt;Ada, yo ozalabi wa na, koni agyo oza ni aba ya ni lo.&gt;&gt; Kweyi ayo oshiye nu yiko bwe ebe ke ekye tota.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Ase hagye ba mo kweyi awoteyi ba pyi igboro. Akamo, &lt;&lt;Ongma ashishini kase; ona ngmi iyinu owoni owo Omezaya ni Owuso Shu ni.&gt;&gt;<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Awadakare ki pyi igboro. Ada anu inyi wowa <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />kweyi akamo, &lt;&lt;Owoni owo ose ka Ase ko Oyahuda, ngmi iyo.&gt;&gt;<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Iso ki ikweyi nu atenena kamo: OMANI WO OSE KA AWOYAHUDA.<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Oye ipu ka awiyi ni ayuwa poshi ni sesa mo: &lt;&lt;Awo wo Okristi lalo? Ngmiyo kpa aha la!&gt;&gt;<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Omepa ko owi ke gbapwo mo, &lt;&lt;Oya yoshi ko Owuso lo, awo ni akwe epwo kpa anu gyogye ni? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Ada aha owe gyogye la, apya abola ko oza ni aya ni. Ongo mani ke yo ojije labi lo.&gt;&gt;<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Ebeni okamo, &lt;&lt;Oyesu rela hin ishini ogipu ko obula wo.&gt;&gt;<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Oyesu kyogwu mo, &lt;&lt;Nyya kadala okwokwoshi, ikyeni oya yo kpa ami ole ki iso.&gt;&gt;<verse eid="LUK 23:43" /></para>
  <para style="s">Ikwu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">oMatiyu 27.45-56</ref>; <ref loc="MRK 15:33-41">oMak 15.33-41</ref>; <ref loc="JHN 19:28-30">Oyohana 19.28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Bwi isheno, ebebe nya dibu okpagye ni go ogye eta ko onose, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />ni eno sha ni. Kweyi ayikyi kofunu ko Ole ko Owuso ko we epa. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Ebeni Oyesu kyegba kpo oko nwa mo, &lt;&lt;Ada nyyo omaku hin yi da awa abo.&gt;&gt; Ishini okela mani ni ogbo layi nu ki igbeji.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Ishini oteyi ka adakare mo oza ni gbodagye ni, osho Owuso iye kweyi kamo, &lt;&lt;Ko okwokwoshi ongo mani gbo ozalabi lo!&gt;&gt; <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Ishini kpiri kawase ni gbayi ko yo olobene ko oza mani mo oza ni gbodagye ni, aya abo shipu kweyi aga wa kpo otu byobya. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Kpiri kawase ni gyo ni kpa anya ni gboso bwo Ogalili ni hagye ebe lenu ba me ebe.<verse eid="LUK 23:49" /></para>
  <para style="s">Ayo Oyesu yi Nyi</para>
  <para style="r">(<ref loc="MAT 27:57-61">oMatiyu 27.57-61</ref>; <ref loc="MRK 15:42-47">oMak 15.42-47</ref>; <ref loc="JHN 19:38-42">Oyohana 19.38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Ebeni ongo oye iye nu wo Isu, Owo oye ipu konongbo ka Ase ko Oyahuda, owa aseneshi, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />okyogwu kpo oza ni agbo ni lo. Obwo ogya ka Arimatiya okpagye ko Oyahuda kweyi oya gbeyi ko obula ko Owuso ko wa. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Oge ebe ko Obilatus ga doka ko okwu ko Oyesu. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Ebeni oyosa wo okpagye, oyo to opa kweyi yo ti ipu ka amiri na abwu ipu ko okpo ni anya ashishe ipu nu lo. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Owe eno ko kyatu kweyi Eno ko Minyo yo pee.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Anya ni wa kpo Oyesu bwo Ogalili gboso Isu kweyi ama amiri kpe ebe ni ayi ikpiye ko Oyesu ta anu ni. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Ebeni ago ole ga zo oturare kpa ano ko nyi ikpiye. Eno ko Minyo, awa ke minyo byoni owo odu wa ni.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Onyiso ka Amiri</para>
  <para style="r">(<ref loc="MAT 28:1-10">oMatiyu 28.1-10</ref>; <ref loc="MRK 16:1-8">oMak 16.1-8</ref>; <ref loc="JHN 20:1-10">Oyohana 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Ototukpokyi eno kikyikyo ko obize, anya ni ga amiri kpa ano kyeye ni akyanutu ni. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Ati ikyikpo ko okwunu ka amiri ja go okoka, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />ishini agipu ni ake mi ikpiye ka Adole Oyesu lo. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Abi ipu ko otu byobya, ango epa bose da awa, oshiye wa ba yu byo ola ka akpula ni. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Ipu ko oshi yoya, anya ni weyi kweyi yikweyi wa kwagye, ango oni ka da awa mo, &lt;&lt;Ojiya ni ala ba tikpo ki ino gbo olayi ipu kawase ni gekwu ni? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Oye ebe ni lo. Onyiso wa! Ala rela ko oza ni oka da ala ishini oyo kpa ala Ogalili ni. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Omo, &lt;Aba yo Oyi ka Asuse ya nabo da awine ko ozalabi, aba yo poshi, eno ko omweta oki ya nyiso.&gt;&gt;&gt; <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Ebeni ara mo oka mani.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Ishini akwikye bwa amiri wa ni, akela mani kpiri da ayikoko ko Oyesu nu igwoye kpase shishini. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Anya ni byela mani waka dayole ni wo Omeremu bwagye ko Omagdalin kpo Oyowana kpo Omeremu ene ko Oyakubu kpa anya shishini ipu wa. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Ake kyogwu lo mela ka anya mani, ama mo ela ka anya yeye la. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Obitrus ke nyiso kweyi ge ebe ka amiri kpe enya. Oweyi kweyi oma ayiki yeye shagye, okwikye nu go ole kpi igbashi ko oza ni gbodagye ni.<verse eid="LUK 24:12" /></para>
  <para style="s">Ikweyi ko Owe ki Imawu</para>
  <para style="r">(<ref loc="MRK 16:12-13">oMak 16.12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Eno oni awogboso Oyesu ase epa bo owe ba gogya-leke oye ni aba yo mi Imawu ni, enu ko ogya ni kpo Ojerusele go oza ko omili ahapa. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Aba ko oka owe ikweyi ko oza kpiri ni gbodagye ni. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Ishini aba kela kpi iyiwa ni, Oyesu abiyinu wa yawu kpa awa. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Owuso ke gwa awiyi shini ana agyo lo.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Oyesu duwoka mo, &lt;&lt;Oka koji ni ala ba ka kpi iyi kala mani ikweyi ko owe?&gt;&gt;</para>
  <para style="p" vid="LUK 24:17">Akwu hagye ba byotu. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Ashe wa ni iye nu wo Okiliyopas doka mo, &lt;&lt;Awo fufo pini wo ogboga Ojerusele ni ogyo oza ni gbodagye ebeni kwekwekwe mani lola?&gt;&gt;<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Oduwoka mo, &lt;&lt;Ela koji?&gt;&gt; Amo, &lt;&lt;Ela ko Oyesu ko oNazareti. Owi inobane la, oloshu ipu kela kpo oko obutu ko Owuso kpa asuse kpiri. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Awose ka awosapa kpa awoteyi ka aha yo da awa mo ana kwe epwo ki ikwu, kweyi ayo poshi. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Aha ke yi iyitagye mo anu pini wi ine ko ngmi Izrayila la. Kweyi ikyeni we eno ko omweta ni oza mani gbodagye ni. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Ime, anya ka aha shishini ta aha igbashi. Aga amiri ototukpokyi mani <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />ake mi ikpiye nu lo. Awa ka daha mo ayoleho ko Owuso ka da awa mo oya gbo layi. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Ebeni ashishini ka aha ga amiri kweyi amo lo, byoni anya ni ka daha ni.&gt;&gt;<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Oyesu ka da awa mo, &lt;&lt;Ma awikyo de, kwi ikyikye ni ala totuso oza ni awobane ka ni lo! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Oshu koni Omezaya na mo owe mani kpiri ime na wa gipu ko igyashi nu lalo?&gt;&gt; <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Kweyi okyogwu ko oza ni awobane ka ipu ko okpa ko Owuso ikweyi nu ni, bwo okpa ko Omusa ge ena kawo bane kpiri.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Ishini ayo pee kpo ogya ni aba ga ni, Oyesu ya byo oya gwota ni. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Ake ka da anu mo, &lt;&lt;Wa kya kpa aha, eno sha wa.&gt;&gt; Ebeni okawa ga sa ebe wa. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Ishini abagye ko roza ni, ozo ikyoga, okeshi, oyi kyigbo kweyi da awa. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Ebeni iyi wa gwa, agyo kweyi ogebi shuwi iyi. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Adiyiwa oka mo, &lt;&lt;Ishini oya kela kpa aha owe kweyi gwo Okpa daha ni otu ka aha ka agye lo?&gt;&gt;<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Ebebeni anyiso kweyi akwikye go Ojerusele. Ama ayikoko ko Oyesu nu igwoye kpa awase ni be ebeni kpa awa ni, kpi iyiwa tukpa <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />kweyi ba kamo, &lt;&lt;Ko okwokwoshi! Adole nyiso kweyi bose do oSimo.&gt;&gt; <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Ebeni ase epa ni ko oza ni gbodagye owe ni da awa, aki kamo ishini owa yo ikyoga kyigbo ni pini awa gyo la.<verse eid="LUK 24:35" /></para>
  <para style="s">Oyesu Bose da Ayole nu</para>
  <para style="r">(<ref loc="MAT 28:16-20">oMatiyu 28.16-20</ref>; <ref loc="MRK 16:14-18">oMak 16.14-18</ref>; <ref loc="JHN 20:19-23">Oyohana 20.19-23</ref>; Oko ka Ayikoko 1.6-8)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Abi ipu ko kela mani ba ka tini amo Oyesu abiyinu hagye ipu wa kweyi ka da awa mo, &lt;&lt;Omene na yo kpa ala.&gt;&gt;<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Oshi yuwa kwu, aba sode ki ikpiye, ba ma byo oyi pini ama la. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Oka da awa mo, &lt;&lt;Oji ya ala ba yoshi? Oji ya ala ba gbo otu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Ala ma abo hin kpi ikpo hin. Ami da hin la! Ala gabo ami shini ala ma. Oyi ya gbe ebe kpo okpokwu lo, ami ke gbo, byoni ala ma ni.&gt;&gt;<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Ishini okela mani kweyi ni, oshiya awa abo nu kpi ikpo nu. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Kwikyikyeni akyogwu lo ikweyi ko otunehe kpi igbashi ni yuwa kwu ni. Oduwoka mo, &lt;&lt;Ala gbo ozarore ebeni?&gt;&gt; <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Ada nu ikyi ka ayibo, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />oze kweyi ha obutu wa.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Ebeni oka da awa mo, &lt;&lt;Oza ni nka dala ishini nyyo kpa ala ni yoma: Oza kpiri ni ata ikweyin ipu ko ono ko Omusa kpe enena ka Awobane kpo Okpa ki Igye ni ba gbodagye.&gt;&gt;<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Ebeni ogwawo otu kweyi agyo oza ni Okpa ya ka ni. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Oka da awa mo, &lt;&lt;Oza ni ata ni yoma: Omezaya ya mo owe kweyi ya nyiso bwi ipu kawase ni gekwu ni eno ko omweta. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Kweyi ipu ki iye nu aba ko oshu ko shagbotu kpo ozalabi ko nona da ase okpagye kpiri, aba kwotu bwo Ojerusele. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ala wa awolobene ka awoza mani kpiri. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Nyya ga toleho ko oza ni ada hin shokoyi ni da ala; ala bi ipu ko ogya gbi ishini asha ala oshiye kpo oshu bwi iso ime.&gt;&gt;<verse eid="LUK 24:49" /></para>
  <para style="s">Ayo Oyesu Bize gi Iso</para>
  <para style="r">(<ref loc="MRK 16:19-20">oMak 16.19-20</ref>; Oko ka Ayikoko 1.9-11)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Ishini obose kpa awa go Obetani ni, okpa abo nu iso kweyi suwa aboneshi. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Oyipu ko suwa aboneshi, oshu wa bita kweyi ayo bize gi iso. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Ebeni ageyagye da anu kweyi akwikye go Ojerusele kpo otunehe nwashika. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Kweyi kpiri ki ishi abi ipu ko Ole ko Owuso, ba sho Owuso iye.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>