<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Alago Bible Translation Project</book>
  <para style="h">3 Oyohana</para>
  <para style="toc1">Okpa komweta ko Oyohana</para>
  <para style="toc2">3 Oyohana</para>
  <para style="toc3">3 Oyh</para>
  <para style="mt2">Okpa komweta ko</para>
  <para style="mt1">3 Oyohana</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Bwebe ko onyakwase,</para>
  <para style="p" vid="3JN 1:1">Gebe ko oya hin moshi Ogayos ni nyya yimu ko kwokwoshi ni.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Oya hin moshi, nyya tinarigwu shini ogbo ogege kikpiye kweyi ojoji na yawu neneshi dawo, byoni oya yawu neshi ipu ko Omaku ni. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nshotunehe ni awogboso Okristi shishini wa ka dami mo hagye loshu ipu kokwokwoshi, byoni oya yagye wo ipu ko okwokwoshi ni. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Otunehe hin nwashika wa ko pwo mayi hin bagye ipu kokwokwoshi.<verse eid="3JN 1:4" /></para>
  <para style="s">Asho Ogayos Iye</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Oya hin moshi, oyo kwokwoshi ipu koko ni oya dawo gboso Okristi ni, koni awa awogboga ni. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Akela kimu wo do oda ko Owuso kebe ni. Nyya bo mo tuwabo shini ana gohobu kpi iyawu wa owe ni ya sho Owuso otu ni. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Ikweyi koni akwowe kiyawu wa ipu koko ko Okristi, anye eshi oyoye bwebe kawase ni gyo Owuso lo ni lo. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Mani oni aha awogboso Okristi, ashu ko tawase mani abo, shini ahan gbingbo ipu koko kokwokwoshi ni aba ya.<verse eid="3JN 1:8" /></para>
  <para style="s">Odiyotrefes kpo Odemetriyos</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ntenena do oda ko Owuso; Odiyotrefes ni ke ya yimu ko wa kikyikyo wa ni yakpaha tagye pwela ni aka ni lo. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Mani oni ishini nwwa nyya ka dala oza kpiri ni oya ni: oza bibi ni oka ikweyi kaha ni kpo okame ni oya ka ni! Omani fufunu ke gyo lo; otela ko za awogboso Okristi ni wa ni, oki wawase ni ba yimu ko zuwa ni obi kweyi nuwenya sho oda ko Owuso!<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Oya hin moshi, ala ka gboza bibi lo, ala ke gboza neshi. Ino yoza neshi kpiri wa ko Owuso la: Ino yozalabi omo Owuso moma lo. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Kpiri kase kela neshi ikweyi ko Odemetriyos; okwokwoshi abiyinu kela neshi ikweyi nu. Aha yolobene kaha manu, kweyi awo gye mo oza ni aba ka ni wokwokwoshi.<verse eid="3JN 1:12" /></para>
  <para style="s">Ogbogba ko Gwejeji</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ngbela nwashika ko ka dawo, nke ya yimu ko tokpa lo. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Nyyiyitagye ko mo kwekwekwe mani, shini an kela iyi kpiyi. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Omene nayo kpawo.</para>
  <para style="p" vid="3JN 1:15">Awoya wo kpiri mo na to ogbogba. Ta awoya ka kpiri ogbogba daha oyoye.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>