<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Alago Bible Translation Project</book>
  <para style="h">1 Oyohana</para>
  <para style="toc1">Okpa kikyikyo ko Oyohana</para>
  <para style="toc2">1 Oyohana</para>
  <para style="toc3">1 Oyh.</para>
  <para style="mt2">Okpa kikyikyo ko</para>
  <para style="mt1">Oyohana</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Ela ko Olayi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Atokpa mani dala ikweyi kela ko olayi, ni yaba bwi ikyikyo ni. Aha pwo, kweyi aha ma kpi iyi ka, ee, aha ma kweyi abo ka ki ganu. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Ishini olayi mani bose ni, aha mo; mani oni akela ikweyi nu kweyi ka dala ikweyi ko olayi gbogbo ni yebe ka ada kweyi owa yaha gyo. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Mamani oza ni ama ki pwo ni pini aka dala la, shini ala gipu kema ka ni agbo kpa Ada kpo Oyi nu Oyesu Okristi. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Atokpa mani shini shotunehe ka na gyogya.<verse eid="1JN 1:4" /></para>
  <para style="s">Owuso Wo Oyoyu</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Anani oshu ni apwo bwebe ko Oyi nu kweyi ka dala ni yoma: Owuso wo oyoyu, kweyi gbe ebe dibu ipu nu lo kpiri-kpiri. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Owoni ake kamo aba rema kpanu, kweyi aha ke tayayo bebe dibu, akokame ipu kela ka kpo ozayoya ka. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Owoni ake kamo abebe yoyu, byoni anu yipu kebe yoyu ni, mani oni arema kpiyi ka, oyi ko Oyesu, oyinu, ya yaha na sho zalabi kpiri.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Owoni akamo aha yo ozalabi lo, aha ba gyiyi ka egya la, kweyi okwokwoshi yipu kotu ka lo. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Owoni ake shagbotu ko ozalabi ka do Owuso, oya byo okoyi nu kweyi oya yoza neshi: oya yozalabi ka gbaha kweyi oya yaha na shipu koza ni aya neshi lo ni. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Owoni akamo aha yozalabi lo, akokame to Owuso kweyi ela nu yipu kotu ka lo.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Okristi Wino Tahabo</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Ayi hin moshi, nyya tenena mani dala shini ala ka yozalabi lo; owoni ashe kala ke yozalabi, agba ase ni ya ba Ada ikweyi ka ni wo Oyesu Okristi, aseneshi. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Okristi abiyinu wo owe ko yozalabi ka gbaha, wo ozalabi ka kin la lo, ke wo ozalabi kese mani kpiri.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Owoni ageyagye do ono ko Owuso, oni ya sayi ma agyo oma. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Owoni akamo agyo, kweyi ake geyagye do ono nu lo, akokame, okwokwoshi yipu kotu ka lo. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Owoni ake gboso ela nu, awase ni yimu ko Owuso yo gyogye ni. Owe ni aba gye mo arema kpo Owuso ni oma: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Owoni akamo atayayo ba rema kpo Owuso, ahan bagye byoni Oyesu Okristi ya ni.<verse eid="1JN 2:6" /></para>
  <para style="s">Ono Pepe</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Ayene hin moshi, ono ni nyya ta dala mani wo pepe la lo; owono nekye-nekye la, oni ala pwo bwikyikyo ni. Ono nekye-nekye mani wo oshu ni ala kwobonu pwo ni. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Ni olemani oni, ono ni nyya ta dala mani wo opepe la, ikweyi koni okwokwoshi nu aba ma ipu ko Okristi ki kpa ala. Koni ebe dibu shigbo wa, kweyi oyoyu ko kwokwoshi ya yu.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Owoni akamo abipu ko yoyu, ake tela ka ayene ka, atayayo bebe didu kwikyikye ni. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Owoni ayimu kase ashini, abipu ko yoyu, mani oni ojije yebe ka ni ya yashe ya yozalabi lo. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Owoni ake tela kase ashini, abipu kebe dibu; aba yawu ipu nu kweyi agyebe ni aba gani lo, ikweyi koni ebe dibu yaha pwiyi.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ayi hin moshi, ta dala ikweyi koni Owuso ya yozalabi kala yi gbala bwebe ko Okristi. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Nyya to omani dala awada, ikweyi koni ala gyo, anu ni yaba bwikyikyo ni. Nyya ta dala awisongo, ikweyi koni ala yi Ibiri gwagye ni. <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />Ayi hin, nyya ta dala, ikweyi koni ala gya Ada. Nyya ta dala awada, ikweyi koni ala gyo, anu ni yaba bwikyikyo ni. Nyya ta dala awisongo, ikweyi koni ala loshu; ela ko Owuso yipu kala, kweyi ala kwobonu ya Ase Bibi oni gwagye wa.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Ala ka yimu kese kwe oza kpiri ni bipu kese ni lo. Owoni oya yimu kese, oya yimu ka Ada lo. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Ojoji ni wa kese, ozalabi ni ase ba yimu ni, wo oza ni ase ma kweyi ba showu, kpo ojoji kese ni ase ba gwabotu kpa anu ni, oyoye wa bwebe ka Ada lo; kpiri wa kese mani la. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Ese kpo ojoji ni ase ba showu ni ya kweyi; awase ni ke yoza ni Owuso ya yimu ni ba gbo olayi ko gbogbo-gbogbo.<verse eid="1JN 2:17" /></para>
  <para style="s">Omonyekwotu ko Okristi</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Ayi hin moshi, okweyi kese yo pee wa! Aka dala mo omonyekwotu ko Okristi ya wa; kweyi anani nwashika ko monyekwotu ko Okristi kwobonu bose wa, mani oni agye mo okweyi yo pee. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Ko kwokwoshi awase mani ba rema kpa aha lo, oza ni ya ni ashaha bita ni oma; owoni abi ba rema kpaha, abi ba bagye kpaha. Ake shaha bita shini ase na gye mo ashishe wa bipu kikpo ka lo.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Ala ke adala Omaku ko Owuso ni Okristi dala ni, kweyi kpiri ka gyo kwokwoshi mani. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Mani oni ntokpa mani dala, ikweyi koni ala gyo kwokwoshi lo ni lalo; ikweyi koni ke ala gye ni la, shini ala ki gye mo okame yawa bwebe ko kwokwoshi lo.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Mani oni anoho ke ya kokame? Awase ni kamo Oyesu wo Omezaya lo ni. Edo kawase mani wo omonyekwotu ko Okristi, atela ka Ada kpo Oyi nu. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Awase ni tela ko Oyi, atela ka Ada mamani oma; awase ni kyogwu kpo Oyi, akyogwu kpa Ada mamani oma.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Ni olemani oni, ala kpela ni ala pwo bwikyikyo ni shipu ko otu kala. Owoni ala kpela mani shotu kala, ala ba rema kpo Oyi kpa Ada ishi kpiri. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Oza ni Okristi abiyinu shokoyi ko daha ni oma olayi ko gbogbo-gbogbo.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Nyya tokpa mani dala ikweyi kawase ni ba takirikwu ko gyala egya ni. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Ala ke, Okristi dala Omaku ko Owuso wa. Byoni Omaku nu tayayo yipu kotu ala, ala ba tikpo ka ashishe ko fala oza kelo, ikweyi koni Omaku nu ya fala ojoji, kweyi oza ni oya fu ni ke wo kwokwoshi la, wo kame lalo. Mani oni ala geyagye do ozafofu ko Omaku ko Owuso shini ala bipu kema kpo Okristi.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Een, ayi hin moshi, ala bipu kema kpanu, shini ishini owa bose ikpiye ka ya loshu kweyi aba nyinya teba kpi iweyi Eno ni lo. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Agye mo Okristi wa aseneshi la; ala ki gye mo, ase ni yoza neshi wo oyi ko Owuso la.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Ayi ko Owuso</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ala medo kimu ni Ada gbo daha ni! Imu nu sheyigagye ni kweyi aba yaha ogwu ma ayi ko Owuso awe kwokwoshi. Oza ni ya ni ese gyaha lo ni oma: ikweyi koni ese gyo Owuso lo. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Ayene hin moshi, anani awayi ko Owuso, oza ni aha ke we ashishe gye wa lo. Aha ke gye mo owoni Okristi bose aba lema byanu, koni aba mo byo ni owe ko kwokwoshi ni. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Kpiri kase ni gbiyitagye mani ipu ko Okristi ya nyinya sho ozalabi, byoni Okristi yozalabi lo ni.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Ase ni ke yozalabi, ogbepwo ko yono ko Owuso yi kyigbo, ikweyi koni ono ko kyigbo wo ozalabi la. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Ala gye mo Okristi bose kowa yozalabi bize, kweyi anu gbo ozalabi lo. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Mani oni, ase ni yo kpo Okristi ya gohobu ko yozalabi lo, ase ni ke gohobu kpo ozalabi omo wa lo kwe gyo wa lo.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Ayi hin moshi, ashishe naka gyala egya lo! Ase ni yoza gyogye owase neshi, byoni Okristi wase neshi ni. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Ase ni gohobu ko yozalabi owa ki Ibiri, ikweyi koni Ibiri ya yozalabi bwishi ni Owuso ye ese. Oyi ko Owuso bose ikweyi ko mani la, shini na yoko ki Ibiri yi yishi.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Awase ni wayi ko Owuso ni ba gohobu ko yozalabi lo, ikweyi koni agbo olayi ko Owuso; kweyi Owuso wa Ada wa, aba gohobu ko yozalabi lo. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Omani pini ya ayi ko Owuso kpa ayi ki Ibiri gogo la: awase ni ba yoza gyogye lo kwe ba yimu kase lo wayi ko Owuso lalo.<verse eid="1JN 3:10" /></para>
  <para style="s">Ala Yimu Kiyi Kala</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Omani pini wo oleho ni ala pwo bwikyikyo; ni ka mo ala yimu kiyi kala. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Ahan ka lema byo Okayinu lo, ni wase ni bwi ipwoma ki ibibi, ni yo oyinanu ka Abila ngmo ni, oji ya ni oyo ngmo? Ikweyi koni oko nu kpiri wo ozalabi, ko oyinanu ke wo oza neshi. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />Mani oni, ayene hin, owoni ase kese tela kala, onaka woza kigbashi dala lo. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Aha gye mo aha bose bwikwu wo Olayi, ikweyi koni aha ba yimu ka ayene ka aha ni. Ase ni ya yimu ko oyinanu lo, oyipu kikwu. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Ase ni kyanya kpo oyinanu owino ngmase la, ala gye mo ase ni ya ngmase gbo Olayi ko gbogbo ipu nu lo.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />Oza ni yaha gyoza ni imu yoya we ni yoma, Okristi gekwu ikweyi ka, mamani ashu ko gekwu ikweyi ka ayene ka. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Owoni ashe ka gboza kabo, kweyi omo oyinanu ni gboza lo ni kweyi tabo lo, imu ko Owuso yipu nu ona? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Ayi hin moshi, ahan ka yimu kiyi ka kpela ko okwunu kin lo, ahan ke yoza neshi kpo okwokwoshi.<verse eid="1JN 3:18" /></para>
  <para style="s">Ikpiye Loshu Obutu ko Owuso</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Omani pini ya yaha gye mo aha wa ko Owuso kwokwoshi la, kweyi ikpiye ka na loshu obutu ko Owuso. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Owoni otu ka kwaha epwo, Owuso shotu ka, kweyi ogyo ojoji kpiri.<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />Ayene hin moshi, ishini otu ka kwaha epwo lo, ikpiye kaha ya loshu obutu ko Owuso. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Kweyi aba pyoza kpiri ni aha doka ebe nu, ikweyi koni aha geyagye dono nu ki yoza ni shotu ni. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Ono ni okwu ni yoma; ahan kyogwu kpiye ko Oyi nu Oyesu Okristi, kweyi ahan yimu kiyi kaha, byoni oka daha ni. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Awase ni geyagye do ono nu, abipu nu, kweyi anu yipu wa. Kweyi agye mo oyipu ka bwebe ko Omaku ni odaha ni.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Omaku ko Okwokwoshi kpo Omaku ko Okame</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Ayene hin moshi, ala ka kyogwu kpa awase kpiri mawa agbo Omaku ni lo, Ala muwama kwe Omaku ni agbo ni bwebe ko Owuso la, ikweyi koni awinobane ko okame nwashika bose ebebenya ipu kese. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Owe ni ala ba gye kwe owo Omaku ko Owuso ni yoma: ase ni kyogwu mo Oyesu Okristi wese bya asuse ni gbo Omaku ko Owuso la. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Ase ni ke kyogwu mo Oyesu wese bya asuse lo ogbo Omaku ko Owuso lo, Omaku ni ogbo ni wa ko Omonyekwotu ko Okristi la; ala pwo mo oyawa, nabani oke kwobonu wese wa.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Ayi hin moshi, ala ke wa ko Owuso, ala awobane ko kame yi gwagye, ikweyi koni Omaku ni yo kpa ala ni sho Omaku ni yo kpase kese. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Awobane ko kame ba kela ikweyi koza kese mani la, kweyi ese ke ba pwuwa ikweyi koni awa kese mani la ni. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Aha ke wa ko Owuso. Ase kpiri ni gyo Owuso ya pwala ka; ase ni gyo Owuso lo ya pwala ka lo. Mani pini aha ba gyo Omaku ko kwokwoshi, kpo Omaku ni wako kame ni la.<verse eid="1JN 4:6" /></para>
  <para style="s">Owuso wi Imu</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Ayene hin moshi, ahan yimu ki iyikaha, ikweyi koni imu bwebe ko Owuso la. Ase ni ya yimu kase wo Oyi ko Owuso la kweyi ogyo Owuso. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Ase ni ya yimu kase lo, ogyo Owuso lo, ikweyi koni Owuso pini wi imu la. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Owuso sayi ki imu nu daha bwebe ko toleho kpo Oyi nu oye kpokponu wipu kese, shini ahan pyo Olayi bwebe nu. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Ozani imu we ni oma: wako ni aha yimu ko Owuso lalo, anu ke yimu ka kweyi to Oyi nu oleho ko wa kore ko ozalabi ka. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />Ayene hin moshi, owoni Owuso yimu kaha mani, aha shu ko yimu ki iyikaha. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Ashishe mo Owuso igbo oye kponu walo, owoni aha yimu ki iyikaha, Owuso yayo kpaha dudu, kweyi imu nu gyogya ipu kaha.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Aha gye maha bipu nu kweyi anu yipu kaha, ikweyi koni odaha Omaku nu ni. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Aha ke ma kweyi ka dase mo Ada to Oyi nu oleho wa ko wa wo Olowoyi kese mani. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Ase ni kyogwu mo Oyesu wo Oyi ko Owuso, Owuso yipu nu, kweyi anu yipu ko Owuso.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />Mani oni aha gye kweyi kyogwu kpi imu ni Owuso gbo daha ni.</para>
  <para style="p" vid="1JN 4:16">Owuso wi imu la, ase ni yo kpimu, oyo kpo Owuso, kweyi Owuso yo kpanu. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Mani oni, imu yo kpaha gyogya, shini ikpiye kaha na loshu Eno ko ke Epwo, koni ipu kese mani ahan lema byanu ni. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Oshi yaba ipu kimu yoya lo, imu kotata ya noshi yoya enya. Mani oni, imu kotata yipu kase ni ya yoshi ni lo, ikweyi koni oshi ya ye dudu kpo gbogo agye la.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Agbi imu ikweyi koni Owuso yimu ka ikyikyo ni. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Owoni akamo, aba yimu ko Owuso, kweyi aba tela kase ashishini, awawo kokame. Koni owoni aha ba yimu kase shishini ni aha ba muwa ni lo, aba ya moji ba gege ko yimu ko Owuso ni aba mo lo ni? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Ono ni Okristi daha ni yoma: ase ni ya yimu ko Owuso owotiri shini ona yimu ko oyinanu mamani.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Arogwa Ikweyi Kese</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Kpiri kase ni kyogwu mo Oyesu wo Omezaya, owo Oyi ko Owuso; ase ni yimu ka Ada oya yimu ko oyi nu mamani. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Owe ni aba gye maha ba yimu ka ayi ko Owuso ni yoma: bwebe ko yimu ko Owuso kpo geyagye do ono nu. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Imu ni agbo do Owuso ni sayi maba geyagye do ono nu. Kweyi ono nu lono daha lo, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Koni kpiri kase ni wo Oyi ko Owuso, oyese mani gwagye. Kweyi aba rogwa ikweyi kese bwebe ko otuse ka. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Anoho ya gege ya yese gwagye? Ase ni kyogwu mo Oyesu wo Oyi ko Owuso ni fufunu.<verse eid="1JN 5:5" /></para>
  <para style="s">Olobene Ikweyi ko Oyesu Okristi</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Oyesu Okristi pini wase ni wa kpinyo ko obatisma nu kpo oyi kikwu nu la. Owa kpinyo kin lalo, oke wa kpinyo kpoyi la. Kweyi Omaku abiyinu yolobene mo omani wokwokwoshi, koni Omaku wo kwokwoshi la. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Koni aha gbo olobene eta: <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Omaku, inyo kpo oyi; oza eta mani yolobene oye kponu. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Aha kyogwu kpolobene kasuse; olobene ko Owuso ke loshu she, kweyi anu yolobene mani ikweyi ko Oyi nu. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Mani oni awase ni kyogwu kpo Oyi ko Owuso ni gbo olobene mani ipu kotu wa; awase ni ke kyogwu kpo Owuso lo, ayoya wino kokame, ikweyi koni akyogwu kpolobene ni Owuso ya ikweyi ko Oyi nu ni lo. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Olobene oni yoma: Owuso daha Olayi ko gbogbo, kweyi otu ko olayi mani wo Oyi nu. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Ase ni gbo Oyi nu gbo olayi: ase ni gbo oyi ko Owuso lo, ogbo olayi lo.<verse eid="1JN 5:12" /></para>
  <para style="s">Olayi ko Gbogbo-gbogbo</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Nyya tenena mani dala shini ala gye mala gbo Olayi ko gbogbo-gbogbo, ala ni kyogwu kpo Oyi ko Owuso ni. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Ikpiye kaha loshu obutu ko Owuso, ikweyi koni aha gye mo oya pwaha owoni adoka koza kpiri ni wa kotu nu ni.<verse eid="1JN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 5:15" />Oya pwaha ishi kpiri ni ado oka; aha gye mo omani wo kwokwoshi, aki gye mo oya dahoza ni aba do oka ni. <verse eid="1JN 5:15" /><verse number="16" style="v" sid="1JN 5:16" />Owoni omo oyene oye ya yozalabi niya byo gowe kikwu lo ni, tinarigwu do Owuso, shini ona dase ni Olayi. Nyya kela kawase ni ozalabi wa wako byuwa gikwu lo ni. Ozalabi ni ke ya byase gikwu ni yaba, nyya ka mala tinarigwu do Owuso ikweyi koni lalo. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Oza ni shoshi lo kpiri wozalabi la, ozalabi oye ke yaba ni ya byase gikwu lo ni.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Agye mo ase ni woyi ko Owuso oya yipu ko yozalabi lo; Oyi ko Owuso ya gbo gbogbo, kweyi Ase Bibi oni ya yo ofo lo.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Koni aha gye maha wa ayi ko Owuso, koni ese kpiri ya abo ka Ase Bibi oni ni.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Aha gye mo Oyi ko Owuso kwobonu wa wa kweyi odaha ogyogye, shini ahan gyo Owuso kokwokwoshi. Aha bagye dudu kpo Owuso kokwokwoshi oni, kpo Oyi nu Oyesu Okristi. Anu pini wo Owuso ko okwokwoshi kpo Olayi ko gbogbo la.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Ayi hin moshi, ala ka sha be eka lo!<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>