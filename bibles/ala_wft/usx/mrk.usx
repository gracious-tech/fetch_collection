<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id" />
  <para style="h">Omaki</para>
  <para style="toc1">Oshu Neshi Bwabo ko Omaki</para>
  <para style="toc2">Omaki</para>
  <para style="toc3">Omk.</para>
  <para style="mt2">Oshu Neshi Bwabo ko</para>
  <para style="mt1">Omaki</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Oyohana Ino Obatisma Kyo Owe Tu</para>
  <para style="r">(<ref loc="MAT 3:1-12">oMatiyu 3.1-12</ref>; <ref loc="LUK 3:1-9">oLuka 3.1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Oyohana 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ikyikyo ko oshu neshi ikweyi ko Oyesu Okristi Oyi ko Owuso. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Byoni inobane Ishaya ta ni mo:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Ma, nyya to oyoleho hin oleho, ya yo ohobu wo,</para>
  <para style="q2" vid="MRK 1:2">ko kyowe ya gbishi wo.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">1.2 </char><char style="ft" closed="false">MAL 3.1</char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />&lt;&lt;Oko kashe ya yogwu ipu ko ododa ya kamo,</para>
  <para style="q1" vid="MRK 1:3">&lt;Ala kyowe tu da<note caller="-" style="x"><char style="xo" closed="false">1.3 </char><char style="xt" closed="false" /></note> Adole,</para>
  <para style="q2" vid="MRK 1:3">kyowe tiriri danu!&gt;&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Isaiah 40:3</char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Kweyi Oyohana wa, ya tono ipu ko ododa shini ase na shagbotu shini ona yuwa Obatisma shini ana yo ozalabi wa gbuwa. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Kpiri kase ka agye ko Oyahuda, kpase ko Ojerusele, webenu, ba shagbotu ko ozalabi wa kweyi oyuwo Obatisma ipu ki Ishu ko Ojoda. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Oshiye ko Oyohana atu kpo oya ko onyakwimi kpo okpa ko gbogbeyi nu. Kweyi ozarore nu wikpaga kpinyi keyi. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Oya tono mo: &lt;&lt;Itikpi hin ashe ni shun ni yawa, ni kwo ogwa ko okpabawu nu nyya gege ya yi lo. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Nyya yala Obatisma kpi inyo, anu ke ya wa yala Obatisma kpo Omaku ko Owuso.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Obatisma kpo Omama ko Oyesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">oMatiyu 3.13-17</ref>; <ref loc="LUK 3:21-22">oLuka 3.21-22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Ipu ki ishi oni Oyesu wa bwo Onazareti agye ko Ogalili, kweyi Oyohana yo obatisma ipu ki ishu ko Ojoda. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Ni Oyesu ya bose bwipu ki inyo ni, omi iso gwa, kweyi Omaku ko Owuso sa ikpiye nu byo otitiribi. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Kweyi, oko kela bwi iso ya kamo, &lt;&lt;Omani wo Oyi hin ni nyya yimu ni. Nyya shotunehe kpa awo.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ebebeni Omaku ko Owuso byo gipu ko ododa, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />kweyi oyo ododa ke eno awene, Ibiri ya moma. Oyo kpa awobekwu, kweyi ayoleho ko Owuso ba to otugbagba.<verse eid="MRK 1:13" /></para>
  <para style="s">Oyesu ya Awotinyi Ene Ogwu</para>
  <para style="r">(<ref loc="MAT 4:12-22">oMatiyu 4.12-22</ref>; <ref loc="LUK 4:14-15">oLuka 4.14-15</ref>; <ref loc="LUK 5:1-11">5.1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Itikpi ni ayo Oyohana shetu ni, Oyesu gipu ko Ogalili ya tono ko oshu neshi ko Owuso. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Oya kamo, &lt;&lt;Ishi gye wa, obula ko Owuso yo pee! Ala shagbotu, shini ala kyogwu kpo oshu neshi!&gt;&gt;<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Ni Oya yawu ega ki ishu ko Ogalili ni, omo Osimo kpo oyinanu Andru, ba she eya ipu ki ishu-nyakwu, awa awotinyi la. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Oyesu ka da awa mo, &lt;&lt;Ala wa, gbosun, nyya ya ala ba wa awino kwa asuse okwunu ke ebinyi.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ebebeni ashe eya wa bita kweyi gboso.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Ni oyawu go ohobu ke ni, omo Oyakubu oyi ko Ozebedi kpo oyinanu Oyohana bipu ko owu ki inyo ba kye eya wa tu. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Ebebeni oyuwo ogwu, kweyi asha Ada wa Ozebedi bita ipu ko owu, kpa awo yo oko ka abola kweyi gboso.<verse eid="MRK 1:20" /></para>
  <para style="s">Oyesu Ngmo Omaku Bibi</para>
  <para style="r">(<ref loc="LUK 4:31-37">oLuka 4.31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Ebeni anu kpa awogboso go Okapanahu Eno ko Minyo kweyi foza ipu ko ekpa wa. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Ozafofu nu da ase igbashi ikweyi koni oya foza kpo oshu, olema bya awofono ni lalo. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Ebebeni ongo oye ni gbo omaku bibi ni ngmegba ipu ke ekpa mo, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Oji ni oya tikpo ebe ka aha Oyesu ko Onazareti, owa ko wa yaha bya la? Ngya ase ni owe ni! Awo pini wa ase Sere ko Owuso la!&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Oyesu gbeha mo, &lt;&lt;Sha! Bose sho!&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Omaku bibi ja anu ebe ni kweyi ongmegba ome osho bita.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Igbashi yuwa kwu kpiri kweyi adiyiwa oka mo, &lt;&lt;Omani wo oji yo ni? Oza fofu pepe kpo oshu! Okela kweyi omaku bibi geyagye danu.&gt;&gt; <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Oshu kela ikweyi ko Oyesu ge ebebenya kpiri ipu ka agye ko Ogalili.<verse eid="MRK 1:28" /></para>
  <para style="s">Oyesu Da Ase Lewa Ogege</para>
  <para style="r">(<ref loc="MAT 8:14-15">oMatiyu 8.14-15</ref>; <ref loc="LUK 4:38-39">oLuka 4.38-39</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Oyesu sho ekpa bita kpo Oyakubu kpo Oyohana ogo ole ko Osimo kpo Andru. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Oshu ye ene ko onya ko Osimo kwu, ogwutagye ikweyi ko ogwudu, Oyesu wa ebebeni aka danu. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ebeni oga ta anu, obya abo kweyi zo iso. Ebebeni oshu kweyi, kweyi oyo ozarore da awa.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Ni eno gbo ni, abya awine ke ere kpa awase ni gbo omaku bibi ni wa do Oyesu. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Ase ko ogya kpiri gbayi okwunu kole, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ebeni awase ni gbo ose gogo-gogo ni, Oyesu da awo ogege. Okyi no omaku bibi nwashika enya. Oshu wa bita kela lo ikweyi koni agye ase ni owe ni.<verse eid="MRK 1:34" /></para>
  <para style="s">Oyesu Tinarigwu Ebeni Gba Ashishe lo ni</para>
  <para style="r">(<ref loc="LUK 4:42-44">oLuka 4.42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ogwu togwu, Oyesu nyiso ge ebe ni gba ashishe lo ni kweyi ga tinarigwu. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Osimo kpa awase ni bagye kpa anu ni ba tikpo nu, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ishini amo ni, akamo, &lt;&lt;Ananoho ba tikpo wo!&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Oyesu kyogwu mo, &lt;&lt;Ahan ga awogya oye hoha shini na ki ga tono da awa. Oza ni byun wa ni oma.&gt;&gt; <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Kweyi oga awogya ipu ko Ogalili ya tono ipu ke ekpa kweyi ya na awomaku bibi enya.<verse eid="MRK 1:39" /></para>
  <para style="s">Oyesu do Ongo ni Gbo Ose ki Iyiwa ni Ogege</para>
  <para style="r">(<ref loc="MAT 8:1-4">oMatiyu 8.1-4</ref>; <ref loc="LUK 5:12-16">oLuka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ongo oye gbo ose ki iyiwa wa kwagye obutu ko Oyesu ya bo mo, &lt;&lt;Owoni okyogwu, ogbo oshu ko da ami ogege.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Oyesu mo ongo ni kpi iyinyinyi kweyi oga anu abo kweyi kamo, &lt;&lt;Ngbi imu, pyo ogege!&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ebebeni iyiwa nu kweyi, kweyi ongo ni pyo ogege.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Ebeni Oyesu yo mo ona ga, kweyi opya akpaha mo, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Ka ka da ashishe lo, ke ge ebe ko osapa shini ona mo kpe eshi byoni ono ko Omusa ka ikweyi kawase ni pyo ogege ki iyiwa ni. Ebeni ase ba gye kamo, opyo ogege.&gt;&gt; <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Ongo oni ke ga ko oshu oni ebebe nya da ase, ikweyi koni Oyesu gege ko gogya oyoye kyakya kelo, oke ya ge ebe ni ashishe ba anu lo ni. Kwikyikyeni ase ba we ebe nu bwe ebebe nya.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Oyesu do Ongo ni Abo nu Winyi ni Ogege</para>
  <para style="r">(<ref loc="MAT 9:1-8">oMatiyu 9.1-8</ref>; <ref loc="LUK 5:17-26">oLuka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Ishini Oyesu kwikye wo Okapanahu ni, ase pwo mo owole. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ase nwashika wa gbayi bwi ipwole we ese gbishini ebe gyuwa lo, kweyi oya tono kela da awa. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Ebeni ango ene bya ashe ni winyi ni we ebe nu ikweyi ko ote. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Ni ama mo aba gege ko ge ebe ko Oyesu lo koni ewa shoshu ni, agwi iso ki inu kweyi yo sa wo okpagye ikweyi ko ote nu obutu ko Oyesu. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Ishini Oyesu mo otuse wa ni oka di ino winyi mo, &lt;&lt;Oyi hin, ayo ozalabi wo na.&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Ashishini ka awofono ke ba kela ipu ko otu wa mo, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Ojiya ni, ongo mani ya ka mani? Oya kela ka arigbetu! Anoho ya gege ya no ozalabi? Ke so Owuso.&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Ebebeni Omaku ko Oyesu ka danu oza ni yo otu wa ni, kweyi oduwoka mo, &lt;&lt;Ojiya ni ala ba kela mani ipu ko otu kala? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Onya le kwee: ko ka di ino winyi mo, &lt;Ayo ozalabi wo na,&gt; Kwe ko ka mo, &lt;Nyiso, zote wo shini oyawu&gt;? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ami ke ya yimu shini ala gye mo Oyi ka Asuse gbo oshu ko no ozalabi ese mani.&gt;&gt; Ebeni oka di ino winyi mo, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Nka da awo, nyiso zo ote wo shini ogo ole.&gt;&gt; <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Ebebeni onyiso zo ote nu kweyi yawu bwo otutehe wa ge ese. Oshi ya ananoho kwu kweyi aba sho Owuso iye ba ka mo, &lt;&lt;Aha moza lemani ebibye wa lo!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s1">Oyesu yo Olawi Ogwu</para>
  <para style="r">(<ref loc="MAT 9:9-13">oMatiyu 9.9-13</ref>; <ref loc="LUK 5:27-32">oLuka 5.27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Oyesu ki bose ge ega ki ishu-nyakwu ko Ogalili. Ase lewa ge ebe nu kweyi okwotu ko ofu wo oza. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Ni oya shigbo ni omo Olawi, oyi ka Alifayu yagye oka ko zegba. Oyesu ka danu mo, &lt;&lt;Gbosun.&gt;&gt; Olawi nyiso kweyi gboso.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Ishini Oyesu kpa awogboso bagye ba roza ole ko Olawi ni, awozegba kpa ashini ka awinozalabi ba roza kpa anu kpa awogboso, ikweyi koni ase lewa gboso ni. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Ishini awofono ni wa Awofarisi ni mo ya roza dudu kpa awinozalabi kpa awino zegba ni, ada awogboso oka mo, &lt;&lt;Ojiya ni oya roza kpa awase mani?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Ishini Oyesu pwo mani ni, oka da awa mo, &lt;&lt;Awase ni loshu ni, ba ge ebe ko oloboshi lo, sa awine kere. Nwwa ela kase neneshi lalo, nke wa ikweyi ka awinozalabi la.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s1">Oka Doda Ikweyi ko Okwunu kwokwu</para>
  <para style="r">(<ref loc="MAT 9:14-17">oMatiyu 9.14-17</ref>; <ref loc="LUK 5:33-39">oLuka 5.33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Awogboso Oyohana kpa Awofarisi ba kwo okwunu. Ashishini kase wa do Oyesu oka mo, &lt;&lt;Ojiya ni awogboso Oyohana kpa awogboso Awofarisi ba kwo okwunu, awogboso ba kwo okwunu lo?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Oyesu kyogwu mo, &lt;&lt;Awoya ko oba onyape ba gege ko kwo okwunu ishini oba ko onyape yo kpa awa ekpa ni? Aayi! Aba gege ko kwo okwunu ishini oba ko onyape yo kpa awa ni lo. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Eno ya wa ba ni aba yo oba onyape ya bize shuwa, bwi ishi oni aba kwo okwunu.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Ashishe ya gege ya yabo ka ayikyi pepe yago bo onekye lo. Owoni oya mani, opepe ya sha sho onekye kweyi oshosha nu ya labi. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Kweyi ashishe ya gege ya yi inyi pepe ya she eyi ko okpa nekye lo. Owoni aya mani, eyi ko okpa ya kya kweyi inyi ya shonu. Olemani lalo, aba yi inyi pepe ya she eyi ko okpa pepe la shini kpiri wa naka yishi lo.<verse eid="MRK 2:22" /></para>
  <para style="s1">Oka Doda Ikweyi ke Eno ko Minyo</para>
  <para style="r">(<ref loc="MAT 12:1-8">oMatiyu 12.1-8</ref>; <ref loc="LUK 6:1-5">oLuka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Eno ko Minyo oye, Oyesu ya yawu ipu ke eho anu kpa awogboso kweyi emye ya ngmuwa, kweyi adri ikweyi ki izire. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Awofarisi ka danu mo, &lt;&lt;Ma, ojiya awogboso ba yoza ni ono ka Ase ko Oyahuda mo oshoshi ko ya Eno ko Minyo ka aha lo?&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Oka da awa mo, &lt;&lt;Ala mo oza ni Odawuda kpa awoya ki iyawu nu ya ishini emye ya ngmuwa ni lo? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Ishini Abiyata wo oteyi ka awosapa ni, Odawuda go Ole ko Owuso ga ho ikyoga ni akyanutu da awosapa kin ko ha. Kweyi oyo shishini yi da awoya ki iyawu nu.&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Ebeni oka da awa mo, &lt;&lt;Aye Eno ko Minyo da asuse la, aya asuse de Eno ko Minyo lalo. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Mani oni, Oyi ka Asuse wa Adole ke Eno ko Minyo la.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Oyesu Di Ine ka Abo Winyi Ogege</para>
  <para style="r">(<ref loc="MAT 12:9-14">oMatiyu 12.9-14</ref>; <ref loc="LUK 6:6-11">oLuka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Ishi oye Oyesu ki gipu ke ekpa, kweyi omo ongo oye ni abo nu winyi ni ebeni. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Ashishini kase ba tikpo ko owe ko kwo Oyesu epwo, akpi iyi kwo ko ma kwe oya danu ogege Eno ko Minyo. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Oyesu ka danu mo, &lt;&lt;Nyiso hagye otutehe wa.&gt;&gt;<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Ebeni Oyesu duwoka mo, &lt;&lt;Onya shoshi she ko ya Eno ko Minyo? Oneshi la kwe obibi, ko ngma ase kwe ko ya ase ngmo?&gt;&gt; Ake kela lo.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Oyesu pyi iyi muwa kpa anya kpo otu byobya nwashika ikweyi ko otu loshu wa, ebeni oka do ongo ni mo, &lt;&lt;Na abo wo ta.&gt;&gt; Ona abo nu ta kweyi opyo ogege ka abo nu. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Ebeni Awofarisi bose ge ese ga gbela kpi ikpo ko Ohiridus ko yo Oyesu ngmo.<verse eid="MRK 3:6" /></para>
  <para style="s">Ase Lewa Gboso Oyesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Oyesu she ebeni bita kpa awogboso go ega ki ishu nyakwu, ewa kase nwashika bwo Ogalili, kpo Oyahuda ke gboso. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Ni apwo oza kpiri ni Oya ya ni, lewa kase bwo Oyahuda kpo Ojerusele, kpo Idumiya we ebe nu kpa awase ni bo osheyi ki ishu ko Ojoda, kpa awase ni bo Otaya kpo Osidon ni. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ikweyi koni ase lewa ni, Oyesu ka do awogboso mo ana labo ko owu leke hagye shini ewa ka naka shogba to lo. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Oda ase lewa ogege, mani oni awine ke ere lewa ba sabo ko ga anu abo. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Kweyi kpiri ki ishini omaku bibi mo aba gbo obutu nu ba kyegba mo, &lt;&lt;Owo Oyi ko Owuso la.&gt;&gt; <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Oke ya pyuwa akpaha mo ana ka ka da ashishe lo.<verse eid="MRK 3:12" /></para>
  <para style="s">Oyesu Sha Ayikoko Igwepa</para>
  <para style="r">(<ref loc="MAT 10:1-4">oMatiyu 10.1-4</ref>; <ref loc="LUK 6:12-16">oLuka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Oyesu toshi giso kefu kweyi yawase ni oya yimu ni ogwu, kweyi agebe nu. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Oshase igwepa ni oya yuwo ogwu mo ayikoko ko ni, shini ana bagye kpa anu, shini ona bi tuwo oleho ko tono kela nu, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />kweyi oki da awo oshu ko ngmo awomaku bibi. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Iye ka ayikoko ko Oyesu igwepa ni yoma, kikyikyo wo Osimo ni Oyesu ya yogwu mo Obitrus ni, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />kpo Oyakubu oyi ko Ozebedi kpo oyinanu Oyohana ni Oyesu da awa iye mo Obowanege, ikweyi nu wo, &lt;&lt;Ayi ka akpula ni.&gt;&gt; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Kpa Andru, kpo Ofilibus kpo Obatolomi kpo Omatiyu kpo Otoma kpo Oyakubu oyi ko Alfayos kpo Otadiyos kpo Osimo ni gbotudose kokpagye nu ni, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />kpo Oyahuza Iskariyoti, anu ni yo Oyesu ra ni.<verse eid="MRK 3:19" /></para>
  <para style="s">Asuse Kamo Oyesu Ya Yoko kpo Oshu ko Obelizebu</para>
  <para style="r">(<ref loc="MAT 12:22-32">oMatiyu 12.22-32</ref>; <ref loc="LUK 11:14-23">oLuka 11.14-23</ref>; <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ishi oni Oyesu gipu kole oye. Ase lewa gboso gbi ishini anu kpa ayikoko ko Oyesu nu gege ko roza lo. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Ishini ayinanu pwo mani ni abose ko wa byo go ole, ikweyi koni akamo, &lt;&lt;Ikweyi nu pya!&gt;&gt;<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Awofono wa bwo ogya ko Ojerusele kweyi kamo, &lt;&lt;Ogbo omaku ko Obelizebu! Kpo oshu ko ose ko omaku bibi pini oya ngmo obibi la.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Ebeni Oyesu yuwo ogwu kweyi kelase da awa mo, &lt;&lt;Oya le moji owoni Ibiri ni Ibiri enya? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Obula ni ase nu ba kpepwu kpi iyiwa obula ni ya hagye lo. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Mamani, ole ni yi iyinu ko we epa, ole oni ya hagye lo. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Owoni Ibiri ya ni Ibiri enya, oyi iyinu ko pini yoma, oya ya moji ni obula nu ya hagye? Igbo nu wa ma. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Kwe anoho ya gege ya go ole kase ni loshu ni ga wi? So ke kwobonu yo gbo ime oya go ole nu ga yi iyo ya wi kpiri la. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Nyya ka dala okwokwoshi, kpiri ko ozalabi ni ase ya kpe ela ka arigbetu ni oka, aba yi na. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Kpiri kase in ke kela bibi ikweyi ko Omaku ko Owuso, aba yo ozalabi nu na lo, anu oni yo ozalabi gbogbo-gbogbo.&gt;&gt;<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Oka mani ikweyi koni aba akamo, &lt;&lt;Ogbo omaku bibi ni.&gt;&gt;<verse eid="MRK 3:30" /></para>
  <para style="s">Ene ko Oyesu kpa Ayinanu We Ebe nu</para>
  <para style="r">(<ref loc="MAT 12:46-50">oMatiyu 12.46-50</ref>; <ref loc="LUK 8:19-21">oLuka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ebeni, ene ko Oyesu kpa ayinanu wa hagye ese, kweyi ata ashe oleho mo ona yo ogwu. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ewa shogba to, ebeni ashe ka danu mo, &lt;&lt;Ene wo kpa ayene wo hagye ese, aba yimu ko kela kpa awo.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Oyesu duwoka mo, &lt;&lt;Anoho we ene hin kpa ayene hin?&gt;&gt;<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Ebeni opyi iyi kweyi ma awase ni shogba to ni kweyi kamo, &lt;&lt;Awamani pini we ene hin kpa ayene hin la. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Kpiri kase ni yo oza ni sha Ada hin ni yi iso ni otu, anu pini we ene hin kpa ayene hin la.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Elase Ikweyi ki Ino Myi Izire</para>
  <para style="r">(<ref loc="MAT 13:1-9">oMatiyu 13.1-9</ref>; <ref loc="LUK 8:4-8">oLuka 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Oyesu ki kwotu ko foza okwunu ki ishu nyakwu. Ebeni ewa ka asuse wa gbayi obutu nu kweyi ogipu ko owu ga yagye, kweyi kpiri ke ewa mani hagye okwunu ki ishu. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Kweyi ofuwoza nwashika ipu kelase. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />Okamo, &lt;&lt;Osheho oye gebe ko myi izire eho nu, <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Ishini oya myi izire ni, ashini ki izire shonu okoka ko owe, ebe ni ano wa yi kpo re. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Ashishini shonu ebe ni gbo okpo ni, kweyi abwu papa ikweyi koni agba agye nwashika lo ni. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Ishini eno ke si izire ni, angmongmo, ikweyi koni agbo ogba lo ni. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Ashishini ki izire shonu ipu ki igye, kweyi igye gye yuwa bya, kweyi agwa lo. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Ashishini shonu ipu ka agye neshi, agye kweyi mi izire, ashini ma aweta, ashini ma awehiri kpo ogbogbo oye, ko oza ni otu ni.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Ebeni okamo, &lt;&lt;Ase ni gba akpaha ko pwo ona pwo.&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ishini Oyesu yagye fufunu ni, ayikoko ko Oyesu Igwepa kpase shishini wa doka ki ikweyi kelase nwashika ni oka ni. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Okyogwu mo, &lt;&lt;Oza gyogye ko Obula ko Owuso ni teba ni ayi gwa da ala. Awase ni ke bi ipu kala lo, ojoji kpiri aba ka da awa ipu kelase <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />shini,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt;Aba ma, ake ba gye lo;</para>
  <para style="q2" vid="MRK 4:12">aba pwo, ake ba gyo oza ni apwo ni lo;</para>
  <para style="q1" vid="MRK 4:12">shini ana ka shagbotu lo, kweyi ana ka yo ozalabi wa na lo.&gt;&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="s">Oyesu Gwi Ikweyi ke Elase ki Ino Myi Izire</para>
  <para style="r">(<ref loc="MAT 13:18-23">oMatiyu 13.18-23</ref>; <ref loc="LUK 8:11-15">oLuka 8.11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ebeni Oyesu ka da awa mo, &lt;&lt;Owoni ala gyikweyi kelase mani lo, onya ni ala ba gye ke? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Edo ki izire ni osheho myi ni we ela ko Owuso. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Izire ni shonu ikweyi ko owe oni lema bya ase ni pwe ela ko Owuso, ebebeni Ibiri ke wa yela ni yi bize shi ipu ko otu nu. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Mamani, izire ni shonu ikweyi ko okpo ni lema bya awase ni pwe ela ko Owuso kweyi ze kpo otunehe. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ikweyi koni ogba wa gagye lo ni, aha gye gbeji lo. Akwikye itikpi ishini owe kwe egye kela ko Owuso ta awa ni. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Izire ni shonu ipu ki igye ni lema bya ase ni ya pwe ela ko Owuso ni, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />kweyi otu byobya ko oyagye kese mani kpe egya ko odu kpi imu ko oza shishini yo otuwa bize she ela ko Owuso. Mani oni, izire ni ke ma lo. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Izire ni shonu ikweyi ka agye neshi ni lema bya awase ni pwe ela ko Owuso ko otata kweyi akyogwu kpa nu. Mani oni, ashini mi izire ikpo aweta, ashini ma awihiri, ashini mo ogbogbo oye.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s1">Elase Ikweyi ki Ikwomu</para>
  <para style="r">(<ref loc="LUK 8:16-18">oLuka 8.16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Oyesu ka da awa mo &lt;&lt;Ase ya kwo ola ikwomu ya heye ko ogwugwu? Aba yi hi ikweyi ko oka la shini na yu da ananoho ipu kole. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Oza ni teba kpiri, aba yi fu te ese, oza ni gwogwu kpiri aba yi gwa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Ase ni gba akpaha ko pwo ona pwo.<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Oki ka da awa mo, &lt;&lt;Ala pwo. Owatu ni ala myiyo kpa anu ni, anu pini aba mya kpa anu da ala, ki she mani. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Ase ni gbo oza aba fu manu danu, ase ni gbo lo, kwo oza ni ogbo gbayayi ni aba yi bize sho.<verse eid="MRK 4:25" /></para>
  <para style="s1">Elase Ikweyi ki Izire ni Ya Gye ni</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Oyesu ki kamo, &lt;&lt;Obula ko Owuso lema byo osheho ni myi izire eho nu ni. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ke eno ko otu, ko ogbola kwe oyiyi, izire ya gye, anu abiyinu ke gyo oza ni yo ya gye ni lo. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Agye mi izire abiyinu, kikyikyo wo obwobwu, kweyi oyikweyi, kweyi ti ikpo neshi. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Ishini izire ze ni osheho wa yi gwu kpo okenge, koni ishi ko kyi izire ya ni.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s1">Elase Ikweyi ki Ikpo ko Omusta</para>
  <para style="r">(<ref loc="MAT 13:31-32">oMatiyu 13.31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">oLuka 13.18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Oyesu kamo, &lt;&lt;Oji ni nyya kamo obula ko Owuso le bya anu? Elase wonya ni nyya ka ikweyi nu? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Olema byo ikpo ko omusta, ni ayi tu eho ni. Ikpo nu wo nyonye ipu ki izire kpiri ni atu agye ni. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Owoni ogye, oya gyokwu ya shi izire wonyonya ipu ke eho; kweyi ya we efu ni ano ni biso ni ba lo ole ayabo nu. <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />Oyesu kela ko Owuso da awa kpe elase nwashika byo omani ni aba gege ko gyikweyi nu ni. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Oyesu kela kpiri da ase ipu kelase. Ishini oke yo fufunu kpa awogboso ni, kweyi ogwi ikweyi ko ojoji kpiri da awa.<verse eid="MRK 4:34" /></para>
  <para style="s1">Oyesu Yo Owu Loshu Hagye</para>
  <para style="r">(<ref loc="MAT 8:23-27">oMatiyu 8.23-27</ref>; <ref loc="LUK 8:22-25">oLuka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Ni eno sha ni, Oyesu ka da awogboso mo, &lt;&lt;Ahan sheyi go gbeyi.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Ashe ewa bita gipu ko owu ki inyo kweyi akwotu ki iyawu. Owu ki inyo shishini gbosuwa. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ebeni owu loshu nyiso ishu, ebe ni owu ni ta kpo ogwa ki inyo ya yimu ko yo owu bya. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Oyesu ya gbola, itikpi ko owu yi kweyi nu so Otinti. Awogboso shiyi kamo, &lt;&lt;Adole, inyo ya yaha re, obyo otu lo?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Ebeni Oyesu nyiso kweyi, okela do owu kpo ogwa ki inyo mo, &lt;&lt;Sha! Hagye!&gt;&gt; Ebeni owu hagye kweyi ebe ka agye. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Oka da awogboso mo, &lt;&lt;Ojiya ni ala ba yoshi? Kwikyikyeni ala gbo otuse lo la?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Ebeni oshi yuwa kwu. Aba diyiwa oka mo, &lt;&lt;Ongo mani wa anoho ome ni owu kpo ogwa ki inyo ba pwe ela nu?&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Oyesu do Ongo ni Gbo Omaku Bibi ni Ogege</para>
  <para style="r">(<ref loc="MAT 8:28-34">oMatiyu 8.28-34</ref>; <ref loc="LUK 8:26-39">oLuka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Oyesu sheyi ki ishu nyakwu ga agbabo ko Ogerasa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Ishini Oyesu bose bwi ipu ko owu ni, ogbayi kpo ongo oye ni bose bwa amiri ni ebeni, ongo mani gbo omaku bibi ikpiye nu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Ongo oni ya kya ebe ka amiri, kwa ashirika, ashishe ya gege ko yo gbo kpa anu lo. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Ongo mani ishi nwashika aba yo sha ashirika, oya ya ashirika yayi kweyi ya yo ogye ki ikpo nu ya yi kyigbo. Ashishe ya gbo oshu ko gege byo bagye lo. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ko otu, ke eno oya gyehe ipu ka amiri kpi ikweyi kikpokyi, oya kyegba ya shi iyinu ikpiye kpa akyo ni gba ahanu ni.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Ishini omo Oyesu ebe lenu ni, onyinya kweyi wa kwagye obutu nu. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Osheha kweyi kamo, &lt;&lt;Oji ni oya tikpo ebe hin, Oyesu, Oyi ko Owuso? Nyya bo mo ka yumo ojije lo!&gt;&gt; <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Oka mani ikweyi koni Oyesu kwobonu ka do omaku bibi mo, &lt;&lt;Bose shi ikpiye ko ongo mani awo omaku bibi.&gt;&gt;<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Ebeni Oyesu do oka, &lt;&lt;Iye wo wo oji?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">Okyogwu mo, &lt;&lt;Iye hin we Ewa, ikweyi koni aha nwashika ni.&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Ebeni omaku bibi bo Oyesu mo ona ka nawa enya sha agbabo ni lo.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Aruma nwashika ba roza ashikwu kikpokyi ni kuwa ni. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Awo omaku bibi mani bo Oyesu kamo, &lt;&lt;Na aha enya shini ahan gipu ka awaruma mani.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Oyesu da awo okwunu, kweyi omaku bibi bose sho ongo ni kweyi gipu ka awaruma. Aruma okpakwu epa sa bwi ikpokyi gipu ki ishu.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Awase ni ba gbeho ka awaruma ni nyinya gogya wa kpa awo ole ni kwuwa ni kweyi ga ko oza ni gbodagye ni da ase, kweyi abose ge ese ga mo oza ni gbodagye ni. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Ishini awe ebe ko Oyesu ni awa mo ongo ni gbo omaku bibi mani yagye kweyi oshi iyo neshi, kpi ikweyi nu gyogye, kweyi oshi yuwa kwu. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Awase ni mani ko oshu da ase ikweyi ko ongo ni gbo omaku bibi ni, ki kpa awaruma da ase. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ebeni awase ko ogya ni bo Oyesu mo, ona sho okpagye wa bita.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Ni Oyesu ya gipu ko owu ni, ongo ni ongmo omaku bibi sho ni bo Oyesu mo, anu ya yimu ko ga kpa anu. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Oyesu tanu kweyi ka danu mo, &lt;&lt;Ona go ole ebe kase ki ipwoma nu na ka da awa oza ni Adole Owuso ya ni, kpi iyi nyinyi ni oya ikweyi nu ni.&gt;&gt; <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ongo ni ga ko oza ni Oyesu yo ni okpagye ni aba yogwu mo Odakapoli ni da ase. Igbashi ya ase kpiri yi kwu.<verse eid="MRK 5:20" /></para>
  <para style="s">Onya ni Loshu lo ni kpo Oyi ko Ojayirus</para>
  <para style="r">(<ref loc="MAT 9:18-26">oMatiyu 9.18-26</ref>; <ref loc="LUK 8:40-56">oLuka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Ishini Oyesu gipu ko owu kweyi sheyi ge ega ki ishu ko Ogalili ni, ase nwashika wa shogba to. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Ebeni oteyi ke ekpa, ni iye nu wo Oyayirus mo Oyesu ni, kweyi owa kwagye obutu nu. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Kweyi obo Oyesu kamo, &lt;&lt;Oyi hin nonya ya yimu ko gekwu. Obi wa ya abo wo so shini ona pyo ogege na gbo layi.&gt;&gt; <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Oyesu gboso ga.</para>
  <para style="p" vid="MRK 5:24">Ase lewa gboso kweyi ba nyi ikpiye. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Kweyi onya oye yebeni ni ya gboyi kishayi igwepa ni. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Omebi nwashika abo ka awoloboshi, kweyi oyo oza ka abo nu ngmo kpiri shini ose na kweyi, ose ke ya go ohobu. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Ni opwo oshu ko Oyesu ni, ogboso itikpi ipu ke ewa kweyi gabo oshiye nu. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Oka ipu ko otu nu mo, &lt;&lt;Owoni nggabo oshiye nu kin, ose hin ya kweyi.&gt;&gt; <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Ebebeni ogboyi nu hagye kweyi opwo ikpiye nu mo, ose nu kweyi.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Ebeni, Oyesu gye kamo oshu bose ikpiye nu, opyi iyi kweyi odoka mo, &lt;&lt;Anoho gabo oshiye hin?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Awogboso kamo, &lt;&lt;Oma ase ba nyi ikpiye oya kamo anoho ga awo abo?&gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Oyesu ke pyi iyi shini na ma ase ni yo oza mani ni. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Ebeni onya oni wa, oya yoshi kweyi ya wode ikpiye, koni ogyo oza ni gbodagye kpa anu ni. Owa kwagye obutu nu kweyi oka danu okwokwoshi. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Oyesu ka danu mo, &lt;&lt;Oyi hin, otuse wo ngma wo. Ga kpo otu mene opyo gege.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Ni Oyesu yipu kela ya ka ni, ango bwo ole ko Ojayirus oteyi ke ekpa wa kamo, &lt;&lt;Oyi wo gekwu, oya di Inofoza owe koji ke?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Oyesu shuwo okwunu lo, kweyi oka do oteyi ke ekpa mo, &lt;&lt;Ka yoshi lo, yo otuse.&gt;&gt;<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Oshashishe bita gboso lo, so Obitrus kpo Oyakubu kpo Oyohana oyene ko Oyakubu <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Ni Oyesu go ole ko oteyi ke ekpa ni, ome ebe ya, ase ba kyegba ba sheha. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Ishini ogipu ni, oka da awa mo, &lt;&lt;Ojiya ni ala ba kyegba ba sheha? Oyi mani gekwu lo, oya gbola la.&gt;&gt; <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Awa ke yo Oyesu eye.</para>
  <para style="p" vid="MRK 5:40">Ishini onuwenya kpiri wese ni, obya ada kpe ene ko oyi kpa awogboso ni bebeni kpanu ni gipu koda ni ayo gwutagye ni. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Obya abo kweyi kamo, &lt;&lt;Talita kumi!&gt;&gt; ikweyi nu wo, &lt;&lt;Oyinonya nkamo, nyiso!&gt;&gt; <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Ebebeni oyi nyiso yawu. Owo oyi ki ishayi igwepa. Oza mani yi igbashi yuwa kwu kpiri. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ebeni opyuwa akpaha mo ana ka ka da ashishe lo, kweyi oka da awa mo ana danu oza shini ona re.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Atela ko Oyesu Onazaret</para>
  <para style="r">(<ref loc="MAT 13:53-58">oMatiyu 13.53-58</ref>; <ref loc="LUK 4:16-30">oLuka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Oyesu she ebe ni bita kweyi anu kpa awogboso kwikye gogya nu, Onazaret. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Eno ko Minyo, okwotu ko foza ekpa, kweyi igbashi yo kpiri kawase ni pwo ni yi kwu.</para>
  <para style="p" vid="MRK 6:2">Kweyi adiyiwa oka mo, &lt;&lt;Ebenya ni ongo mani pyo oza mani. Ebenya ni opyo oziyi kpa awoza ki igbashi ni oya ya mani?&gt;&gt; <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Anu mani wi ino gwinu lalo? Inanu pini wo Omeremu lalo? Ayinanu pini wo Oyakubu kpo Isu kpo Oyahuda kpo Osimo lalo, ayinanu nonya bagye kpa aha na lo?&gt;&gt; Kweyi otu wa bya kweyi atela ko kyogwu kpa anu.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Oyesu ka da awa mo, &lt;&lt;Aba mi inobane gyiyi ebebe nya, ogya nu kpi ipwole nu ke aba mo gyiyi lo.&gt;&gt; <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ogege yo oza ki igbashi oyoye ebe ni lo, sa ase gbayi ni loshu lo ni osuwa abo kweyi apyo ogege. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Kweyi igbashi yo kwu ikweyi koni agbo otuse lo ni.</para>
  <para style="s" vid="MRK 6:6">Oyesu Ta Ase Igwepa Oleho Ge Ese</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">oMatiyu 10.5-15</ref>; <ref loc="LUK 9:1-6">oLuka 9.1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Ebeni Oyesu bose gogya kweyi ya foza. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Oya awogboso igwepa ogwu kweyi otuwo oleho epepa, oda awoshu ko ngma awomaku bibi.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />Oka da awa mo, &lt;&lt;Ala ka byo ojije ki ikpo ki yawu lo, so okposhi. Ala ka byo ikyoga kwe oshu, kwe ikwiri lo. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Ala lo okpabawu, ala ke ka byo oshiye epa lo. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Ole ni ala ganu kpiri ala banu gbi ishini ala she ebe ni bita. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Kweyi ebe ni ala ga kweyi atela ko ya ala omaba kwe atela ko pwo ono totu kala, ala gwo omula ka apatikpo kala she ebe ni ishini ala ba she ebe ni bita, shini na wo olobene ikweyi wa.&gt;&gt;<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Ebeni abose gese ga tono mo ase na shagbotu. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Angmo omaku bibi nwashika, kweyi anya awine ke ere ano kweyi ada awo ogege.<verse eid="MRK 6:13" /></para>
  <para style="s">Ikwu ko Oyohana Ine ko Obatisma</para>
  <para style="r">(<ref loc="MAT 14:1-12">oMatiyu 14.1-12</ref>; <ref loc="LUK 9:7-9">oLuka 9.7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Ose Ohiridus pwo oshu mani, koni ase nwashika gyo Oyesu ni, ashini kase kamo, &lt;&lt;Anu mani wo Oyohana ine ko Obatisma ni gekwu ni pini nyiso ikwu la, oza ni ya ni oya ya awoza ki igbashi mani ni oma.&gt;&gt;<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Ashishini mo, &lt;&lt;Owi Iliya.&gt;&gt; Kweyi ashini mo, &lt;&lt;Owinobane byo oye ipu ka awinobane nekye.&gt;&gt;<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Ishini Ohiridus ke pwe ela mani ni okamo, &lt;&lt;Oyohana ni nyyikweyi ngma ni nyiso ikwu!&gt;&gt;<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Ikweyi koni Ohiridus abiyinu kwobonu ta adakare oleho mo ana yo Oyohana yi gbo kweyi yo to oruduru. Ohiridus ya mani shini ona sho Ohiridiya, onya ko oyinanu Ofilibus, ni odoka ni otu. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Ishi oni Oyohana ya ka do Ohiridus mo, &lt;&lt;Oshoshi koni oya zo onya ko oyinawo gbo lo.&gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ohiridu yo Oyohana bi otu kweyi ya tiyi ko owe ko yo ngmo. Oke gege lo, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ikweyi koni Ohiridus ya yoshi ko Oyohana kweyi ya gbo gbogbo koni ogye mo owase neshi ni. Ishini Ohiridus pwela ko Oyohana ni otu nu bya kotata, kwikyikyeni oki gbi imu ko pwela nu.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Ogwejeji, Ohiridiya pyo owe eno ki imya ko omoma ko Ohiridus. Ohiridus yi imya da awonongbo kpa awoteyi ka adakare kpa anyakwase ko Ogalili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Ishini oyi ko Ohiridiya gyoba ni, oyo otu ko Ohiridus kpa awase ni opawa ko roza ni sha.</para>
  <para style="p" vid="MRK 6:22">Ebeni ose ka do oyi nonya oni mo, &lt;&lt;Kpiri ko oza ni odoka nyya da awo.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Oshokoyi kpo ene gwogwa danu mo, &lt;&lt;Kpiri ko oza ni odoka nyya da awo, kwo obula hin nyya yi kepa kpa awo.&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Oge ese ga di inanu oka mo, &lt;&lt;Oji ni nyya doka?&gt;&gt;</para>
  <para style="p" vid="MRK 6:24">Inanu mo, &lt;&lt;Ikweyi ko Oyohana ine ko Obatisma.&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Ebebeni oyi nonya ni ge ebe ko ose kpo oza ni oya yimu ni mo, &lt;&lt;Nyya yimu shini oda ami ikweyi ko Oyohana ine ko Obatisma ipu ko okpa.&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Ebeni otu ko ose bya kotata ikweyi koni ogwene obutu ka awogboga ni, oya yimu ko wobi lo. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ebebeni ose zoko da adakare nu mo ona ga bi ikweyi ko Oyohana wa. Oga yo Oyohana ikweyi ngma ipu ko oruduru. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Abi ikweyi nu wa ipu ko okpa. Oyi do oyi nonya ni, kweyi obi ga yi di inanu. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Ishini awogboso Oyohana pwela mani ni, aga yo okwu nu yi bize ga yi nyi.<verse eid="MRK 6:29" /></para>
  <para style="s">Oyesu Da Ase Okpakwu Eho Ozarore</para>
  <para style="r">(<ref loc="MAT 14:13-21">oMatiyu 14.13-21</ref>; <ref loc="LUK 9:10-17">oLuka 9.10-17</ref>; <ref loc="JHN 6:1-14">Oyohana 6.1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Ebeni ayikoko ko Oyesu gbayi obutu nu kweyi ka danu oza ni aya ni kpiri kpo oza ni afu ni. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Ebeni ase nwashika ba wa ba ga kweyi agbi ishi ko roza lo, oka da awa mo, &lt;&lt;Ala ka ami wa shan ge ebe ni aba ga minyo ni.&gt;&gt;<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Ebeni abose gipu ko owu kweyi ge ebe ni gba ashishe lo ni. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Awase ni ke muwa ishini aba ga ni anyinya ki ikpo gbosuwa bwo ogya, bwo ogya kwobonu da awa. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Ishini Oyesu sa ni ome ewa ka asuse tukpa, iyinyinyi wa yo okwu, ikweyi koni omuwa lema byo obize ni gbase ko gbeho wa lo ni. Ebeni okwotu ko fuwa oza nwashika.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Ni eno sha ni, awogboso wa ka danu mo, &lt;&lt;Ebeni wi ikyashi, otu ya bi wa. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Ya awase mani na gipu ka awogya kpa ada ga ro ozarore abiyiwa shini ana re.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Okyogwu mo, &lt;&lt;Ala da awa oza na re.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">Aka da nu mo, &lt;&lt;Ahan ga ro ikyoga ki ikwiri ni awo yo oko ka abola ba pye oya ahata ni wa da awa?&gt;&gt;<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Oduwoka mo, &lt;&lt;Ikyoga ema ni ala gbo? Ala ga ma.&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">Ishini aga ma ni, aka mo, &lt;&lt;Ikyoga eho kpe ebinyi epa.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Ebeni Oyesu ka dawa mo ana yase na bagye ikpo, ikpo ikweyi ki ikyashi. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Abagye, ikpo, ikpo kase ogbogbo oyoye, kpase awaweho. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Ozo ikyoga eho kpe ebinyi epa kweyi otiyi mi iso, okeshi do Owuso kweyi oyiko da awogboso kweyi awogboso da ase. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Kpiri wa ha yipu. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Awogboso kpo shishini ko ikyoga kpe ebinyi nwo ogwugwu igwepa. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Ewa kase ni ho oza ni wa ango okpakwu eho.<verse eid="MRK 6:44" /></para>
  <para style="s">Oyesu Yawu Ikweyi ki Inyo</para>
  <para style="r">(<ref loc="MAT 14:22-33">oMatiyu 14.22-33</ref>; <ref loc="JHN 6:15-21">Oyohana 6.15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ebebeni oka da awogboso mo ana gipu ko owu shini ana kwobonu danu sheyi go Obetseda, anu ke na ye ewa ka asuse na ga wa ome. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Ishini oshu wa bita ni, ogi ikweyi ke efu ga tinarigwu.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Ni eno sha ni, owu yo otutehe ki ishu nyakwu, kweyi sha anu fufunu hagye okpagye. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Ebeni oma awogboso ba nonu kpo owu kpo ogwa ki inyo ya pyuwa. Abo ko ogye ene ko otu, oyawu we ebe wa ikweyi ki inyo. Oya yimu ko shigbo gwuwa ta, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />ni amo yawu ikweyi ki inyo ni, ama byo owo oyi la. Angme egba, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ikweyi koni amo ni oshi yuwa kwu.</para>
  <para style="p" vid="MRK 6:50">Ebebeni oka da awa mo, &lt;&lt;Ala gbotu gbagba! Ami la. Ala ka yoshi lo.&gt;&gt; <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Ebeni oto gipu ko owu kpa awa, kweyi owu ni ya ta ni ka agye. Igbashi yuwa kwu, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ikweyi koni agyo oza ni gbodagye ikweyi ki ikyoga ni lo, koni ikweyi wa lenu ni.<verse eid="MRK 6:52" /></para>
  <para style="s">Oyesu di Ine ke Ere Ogege Ogenesaret</para>
  <para style="r">(<ref loc="MAT 14:34-36">oMatiyu 14.34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Ishini ashigbo ge ese ko Ogenesaret ni, ayo owu gbo okwunu ke ega. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Ishini abose ipu ko owu ni ebebeni ase mo Oyesu kweyi gye. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Anyinya ga agbabo ko okpagye kpiri kweyi ga bya awine ke ere ikweyi ko ote ge ebe ni apwo mo oya nu ni. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Kweyi ebe ni oga, ogya leke kpo nyakwu, kwe ada, abya awine ke ere gi ipishi. Aba bo mo kwa ko shuwa bita na gabo akpaha ko oshiye nu kin, kweyi kpiri kawase ni gabo oshiye nu pyo ogege.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Ozafofu ka Awokyikyi</para>
  <para style="r">(<ref loc="MAT 15:1-9">oMatiyu 15.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Awofarisi kpa ashini ka awofono ni bwo Ojerusele ni wa gbayi obutu ko Oyesu kweyi, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ama awogboso ba roza kpa abo &lt;&lt;Hirinyi,&gt;&gt; ana abo byoni odu ka aha ka ni lo. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Awofarisi kpa Ase ko Oyahuda ba roza lo, sa ayo odu ka abo nona, ikweyi koni aya abo byo odu ka anyakwase ni. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ishini abwi ipishi wo ole, sa ana abo ome aba roza la. Aba gboso odu nekye nwashika byo owatu nona, kpe eyi, kpo ogwudu.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Awofarisi kpa awofono do Oyesu oka mo, &lt;&lt;Ojiya ni awogboso ba gboso odu ka anyakwase lo? Aba roza kpa abo &lt;Hirinyi,&gt; Ana abo byoni odu ka aha ka ni lo.&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Okyogwu mo, &lt;&lt;Ishaya ko okwokwoshi ishini obane ikweyi kala awo byiga byiwa byoni ata ni mo,</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt;Awase mani ba kelan okwunu kin la,</para>
  <para style="q2" vid="MRK 7:6">otuwa ke lenu kpa ami.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Aba geyagye da ami yeye kin la,</para>
  <para style="q2" vid="MRK 7:7">oza fofuwa wo ono ka asuse mo wa ko Owuso.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.7 </char><char style="ft" closed="false">ISH 29.13</char></note><verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Ala sho ono ko Owuso bita, kweyi ala ya abo byo odu ka asuse.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Kweyi Oyesu ka da awa mo, &lt;&lt;Ala ma mo ala gbo owe neshi ko yo ono ko Owuso to okoka ikweyi ko odu kala! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Omusa kamo, &lt;Geyagye da ada wo kpe ene wo,&gt;<note caller="+" style="f"><char style="fr" closed="false">7.10 </char><char style="ft" closed="false">Obose 20.12</char></note> Kweyi &lt;Ase ni sa ada nu kwe inanu esa owo otiri shini ana yo ngmo.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.10 </char><char style="ft" closed="false">Obose 21.17</char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ala ke kamo owoni ase ka da ada nu kwe inanu mo, &lt;Kpiri ko oza ni ala bi ba pye ebe hin ni, nkwobonu gbomu ko yi do Owuso wa,&gt; <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Ebeni ala shobita yo oza da ada nu kpi inanu kelo. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Bwebe ko omani ala yela ko Owuso yi tokoka ikweyi ko odu kala ni ashibita tagye da ala ni. Kweyi ala ya awoza nwashika mani.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s">Oza ni ya Ase ya Kyinyi ni</para>
  <para style="r">(<ref loc="MAT 15:10-20">oMatiyu 15.10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Oyesu ye ewa ka asuse kpiri ogwu we ebe nu kweyi ka da awa mo, &lt;&lt;Ala ya akpaha tagye shini ala pwo, kpiri kala shini ala gyo oza mani. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Oza ni bwe ese gipu kase pini ya ya ase ya &lt;Kyinyi&gt; lalo, ke so oza ni bwi ipu kase we ese ni pini ya ya ase ya &lt;Kyinyi&gt; la. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Ase ni gba akpaha ko opwo, ona pwo.<note caller="+" style="f"><char style="fr" closed="false">7.16 </char><char style="ft" closed="false">Okpa ni ata kpa abo nekye ni shishini gba ayabo igwihiri lo.</char></note>&gt;&gt;<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Ishini oshe ewa bita gipu kole ni, awogboso ga do oka ki ikweyi kelase. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Oduwoka mo, &lt;&lt;Ala wi ikyo la? Oza ni bwe ese gipu kase ya yo ya &lt;Kyinyi&gt; lo ala gye lo? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Ikweyi koni ogipu ko otu nu lalo, ke yipu nu kweyi ya bose ikpiye nu.&gt;&gt; Bwe ebe ko omani Oyesu mo ozarore kpiri yo sere.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Oki kamo, &lt;&lt;Oza ni bwi ipu kase we ese pini ya yo ya &lt;Kyinyi&gt; la. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Koni kpiri ko oza ni ase ya ka bwi ipu ko otu kase byela bibi, kpe eba, kpo owi, kpo ngmase, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />kpa afu, kpo otu labi, kpe egya, kpa agbaza, kpa anya, kpi ishi yoya, kpo ki iyo, kpi ikyo. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Kpiri ka awozalabi mani bose bwi ipu ko otu kweyi ya ase ya &lt;Kyinyi.&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">Onya ni Gbo Otuse ni</para>
  <para style="r">(<ref loc="MAT 15:21-28">oMatiyu 15.21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Bwe ebeni Oyesu nyiso go okpagye ko Otaya kpo Osidon. Ogipu kole oye, kweyi oya yimu shini ashishe naka gye lo; oke gege yi iyinu teba lo. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Ebebeni onya oye ni oyi nu gbo omaku bibi ni pwe ela ko Oyesu ni, owa gbo obutu nu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Onya ni wa ase ko Ogirik, amo Osiriya okpagye ko Ofinikiya. Obo Oyesu mo ona ngmo omaku bibi shi ikpiye ko oyi nu.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Oka danu mo, &lt;&lt;Sha ayeke bita na ro oza yipu ome, ikweyi koni oya shoshi shini ana yo ozarore ka ayi shagye di iwo lo.&gt;&gt;<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Onya ni kyogwu mo, &lt;&lt;Olemani Adole, iwo ke ba roza ni shonu bwabo kayi ni.&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Ebeni oka danu mo, &lt;&lt;Ikweyi koni okyogwu mani ni, kwikye gole, omaku bibi sho oyi wo bita wa.&gt;&gt;<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ogo ole ga to oyi nu gwutagye ogwudu, omaku bibi bose sho.<verse eid="MRK 7:30" /></para>
  <para style="s">Oyesu da Ase ni Kyi Igbenu ni Ogege</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Ebeni Oyesu sha agye ko Otaya bita kweyi bwo ogya ko Osido gi ishu ko Ogalili kweyi ga agbabo ko Odikapoli. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ebeni abyo ongo oye ni wo odoho oki ya shigwu ni wa do Oyesu abo mo na sa aboneshi eyi.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Obyo go okoka sho otutehe ke ewa kweyi ya abo nu la akpaha kweyi otehe kweyi oga anu abo igbenu. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Oyesu ngiyi iso kweyi ogbo layi faa, kweyi ka danu mo, &lt;&lt;Ifata!&gt;&gt; Ikweyi nu wo, &lt;&lt;Gwa!&gt;&gt; <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Bwebe ni akpaha ko ongo ni gwa, Igbenu nu ra kweyi okwotu ko kela neneshi.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Oyesu pyuwa akpaha mo ana ka ka da ashishe lo. Oya wuwobi ko ka, awa ke ba go ohobu ko ka. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Ase nwonwu kpi igbashi. Kweyi akamo, &lt;&lt;Oyo ojoji kpiri neshi, ko odoho oyo pwaha, awo kyigbenu oyuwa kela.&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Oyesu da Ase Okpakwu Ene Ozarore</para>
  <para style="r">(<ref loc="MAT 15:32-39">oMatiyu 15.32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Ipu ki ishi oni, ewa ka asuse ki gbayi. Agbo oza ko re lo, Oyesu ya awogboso ogwu kweyi ka da awa mo, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Nyya miyinyinyi wa, eno eta yoma ni abebeni kpa ami kweyi agbo oza ko rore lo. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Owoni nkamo ana go ole kpe emye aba ga shekwu owe ikweyi koni ashini wa bwe ebe lenu ni.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Awogboso do oka mo, &lt;&lt;Aha ke ba ga pyo ozarore ko gye ewa mani ebenya ipu ki ikyashi mani?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Oyesu duwoka mo, &lt;&lt;Ikyoga ema ni ala gbo?&gt;&gt;</para>
  <para style="p" vid="MRK 8:5">Akamo, &lt;&lt;Ahapa.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Oka de ewa mo ana bagye okpagye. Ishini ozo ikyoga ahapa mani kweyi okeshi do Owuso, oyi ko da awogboso mo ana da ase, ake ya mani. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Agbe ebenyi gbayayi, oki keshi kweyi ka da awogboso mo ana yi ko da ase. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ase roza yipu. Awogboso kpo shishini ko ozarore nwo ogwugwu ene. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Awase ni ro oza ni go okpakwu ene. Ebeni oka da awa mo ana ga wa. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Ebebeni ogipu ko owu anu kpa awogboso kweyi ago okpagye ko Odalumanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Awofarisi ba Doka ko Oza ki Igbashi</para>
  <para style="r">(<ref loc="MAT 16:1-4">oMatiyu 16.1-4</ref>; <ref loc="LUK 12:54-56">oLuka 12.54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Awofarisi we ebe ko Oyesu kweyi ba tawashu kpa anu. Aba yimu ko moma, kweyi aba doka ko oyi bwi iso. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Oyiyi kwuwa kweyi ogbolayi fa, kweyi okamo, &lt;&lt;Ojiya ase ke eno ki ikyeni ba yimu ko oza ki igbashi ome? Nyya kadala okwokwoshi, aba shiya ala oza ki igbashi oyoye lo.&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Ebeni oshu wa bita, okwikye gipu ko owu kweyi sheyi ge ega ki ishu.<verse eid="MRK 8:13" /></para>
  <para style="s">Oyisi ka Awofarisi kpo Ohiridus</para>
  <para style="r">(<ref loc="MAT 16:5-12">oMatiyu 16.5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Awogboso nwanyi ko byikyoga, so oni yipu kowu kpawa ni. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Oyesu pyuwa akpaha mo, &lt;&lt;Ala gbera kpo oyisi ka Awofarisi kpo Ohiridus.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Adiyiwa oka mo, &lt;&lt;Kwe ikweyi koni abyo ikyoga lo ni pini oya ka mani la?&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Oyesu gyo oza ni aba ka kpi iyiwa ni, oduwoka mo, &lt;&lt;Ojiya ni ala ba kela ikweyi koni ala byo ikyoga lo ni? Kwikyikyeni ala gye lo? Ikweyi kala lenu la? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Ala gbiyi yeye, ala ke ba ma lo, ala gbakpaha kweyi ala ke ba pwo lo. Kweyi ala ba ra lo? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Ishini nfi ikyoga eho da ase okpakwu eho ni, oni aha shishini ni nwo ogwugwu ema?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">Akyogwu mo, &lt;&lt;Igwepa.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;Kweyi ishini nfi ikyoga ahapa da ase okpakwu ene ni, oni aha shishini ni nwo ogwugwu ema?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">Aka danu mo, &lt;&lt;Ahapa.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Oka da awa mo, &lt;&lt;Kwikyikyeni, ala gye lo?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">Ado Opwiyi Ogege Obetseda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Awo Obetseda, ebeni abyo ofiyi oye wa danu kweyi abo mo ona ganu abo. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Obyo ofiyi abo kweyi byo bose sho ogya. Otehe shi iyi kweyi ya abo so. Oyesu do oka mo, &lt;&lt;Omo oje?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Otiyi mi iso kweyi kamo, &lt;&lt;Nma asuse bye efu ba yawu.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Oki ga anu abo iyi. Ebeni iyi nu gwa, ebe moma nu kwikye, kweyi ome ebe neneshi. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Oyesu ka danu mo, &lt;&lt;Go ole, ka kwikye gipu ogya lo.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">Obitrus Kamo Oyesu wo Okristi</para>
  <para style="r">(<ref loc="MAT 16:13-20">oMatiyu 16.13-20</ref>; <ref loc="LUK 9:18-21">oLuka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Oyesu kpa awogboso ba gogya ko Okesariya Ofilipi, ishini abi ipu ki iyawu ba ga ni, oduwoka mo, &lt;&lt;Anoho ni ase ba kamo, nwwe?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Akyogwu mo, &lt;&lt;Ashishini kase mo owo Oyohana ine ko Obatisma, ashini mo owi Iliya, ashini mo owo oye ipu kawo bane nekye.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Oduwoka mo, &lt;&lt;Anoho ni ala kamo nwwe?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">Obitrus kamo, &lt;&lt;Awo wo Omezaya.&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Ebeni Oyesu pyuwa akpaha mo, ana ka ka da ashishe lo.<verse eid="MRK 8:30" /></para>
  <para style="s">Oyesu Kela Ikweyi ki Ikwu nu</para>
  <para style="r">(<ref loc="MAT 16:21-28">oMatiyu 16.21-28</ref>; <ref loc="LUK 9:22-27">oLuka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Ebeni okwotu ko fuwa oza mo Oyi ka Asuse ya wa mowe nwashika kweyi anyakwase kpa awosapa kpa awofono ba wa tela nu. Aba yo ngmo, eno ko ome eta oki ya nyiso ikwu. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Oyesu kela mani kya da awa ebeni Obitrus byo go okoka kweyi okwotu gba apwo.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Oyesu ke pyi iyi ma awogboso, kweyi ogbo Obitrus apwo mo, &lt;&lt;Shaga shun Ibiri, ogbo oza ko Owuso ipu ko otu wo lo, so oza ka asuse.&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Ebeni oye ewa ka asuse kpa awogboso ogwu kweyi ka da awa mo, &lt;&lt;Kpiri kase ni ya yimu ko gbosun owotiri ni oya tela ki iyinu kweyi zo oshi nu gbosun. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Ase ni ya yimu ko gbo olayi nu oya yi tonu, ase ni ke yo olayi nu tonu ikweyi hin, oya gbo gbogbo. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Oji shoshi da asuse owoni opyo oza kese mani kpiri okwunu ko olayi nu? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Kwe oji ni ase ya sore okwunu ko olayi nu? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Ase ni yi iweyi hin kpe ela hin ipu ki ishi bibi ni gyo Owuso lo mani, Oyi ka Asuse ya yi iweyi nu ishini oya wa ipu ko igyashi ka Ada nu kpa ayoleho sere.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Kweyi oka da awa mo, &lt;&lt;Nyya kadala okwokwoshi, ashini kase hagye ebeni ba, aba gekwu lo gbi ishini aba mo obula ko Owuso wa kpo oshu.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s">Ikpiye ko Oyesu Pya Gogo</para>
  <para style="r">(<ref loc="MAT 17:1-13">oMatiyu 17.1-13</ref>; <ref loc="LUK 9:28-36">oLuka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Itikpi ke eni ihiri Oyesu zo Obitrus kpo Oyakubu kpo Oyohana kweyi byuwa gi iso ke efu jigiri awa fufuwa. Ebeni ikpiye ko Oyesu pya gogo obutu wa, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />oshiye nu pya wo onehe purututu, sho oza ni shehe ese mani kpiri. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Kweyi Iliya kpo Omusa bose ba kela kpo Oyesu.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Obitrus ka do Oyesu mo, &lt;&lt;Inofoza, oshoshi ni aha be ebeni ni. Ahan gwa adaba eta ebeni, oye wa akako wo, oye wa ko Omusa, oye wa ki Iliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Oshi yuwa kwu, kweyi ogyo oza ni oya ka ni lo.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ebeni akpa yuwa gwu, kweyi oko kela bwi ipu ka akpa ya kamo, &lt;&lt;Omani wo Oyi hin moshi ni nyya yimu ni. Ala pwela nu!&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Ebebeni apyiyi, ama ashishe kpawa kelo so Oyesu.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Ni aba sa bwi iso ke efu ni, Oyesu pyuwa akpaha mo, ana ka ka da ashishe oza ni ama ni lo, so Oyi ka Asuse nyiso ikwu. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Ayela ni bi ipu ko otu wa kweyi aba diyiwa oka mo, &lt;&lt;onyiso ikwu wo oji.&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Kweyi ado oka mo, &lt;&lt;Ojiya ni awofono ba kamo owotiri shini Iliya na wa ikyikyo?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Oyesu kyogwu mo, &lt;&lt;Kotata, Iliya ya wa ikyikyo, kweyi wa kyo oza kpiri yatu. Ojiya ni ake kwobonu yi tota mo, Oyi ka Asuse ya wa mowe kotata abo wa, kweyi aba tela nu? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ami ke ya kadala, Iliya kwobonu wa wa, agyo lo, kweyi ayo oza ni aba yimu ni, byoni ayitota ikweyi nu ni.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s">Oyesu do Oyi ni Gbo Omaku Bibi ni Ogege</para>
  <para style="r">(<ref loc="MAT 17:14-21">oMatiyu 17.14-21</ref>; <ref loc="LUK 9:37-43a">oLuka 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Ishini awe ebe ka ashini ka awogboso ni, ame ewa ka asuse shogba tuwa kpa awofono ba ta awashu kpa awa. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Ni ewa ka asuse mo Oyesu ni igbashi yuwa kwu kotata kweyi anyinya ga to ogbogba.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Oduwoka mo, &lt;&lt;Ala ba ta awashu kpa awa ikweyi ko oji?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Ongo oye ipu ke ewa kamo, &lt;&lt;Inofoza, nbyo oyi hin ni gbo omaku bibi ni ya wobi ko kela lo ni wa da awo. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Kpiri ki ishini okwo, oya gwo gbo, kweyi okwunu nu ya kyowu kweyi ya hahanu oki ya ngmongmo kwakya. Nba awogboso ake gege ko no omaku bibi oni enya lo.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Oyesu ka da awa mo, &lt;&lt;Ala awine ko otuse gbayayi ki ishi mani, gbi ishi wonya ni nyya yagye kpa ala? Gbi ishi wonya ni nyya gbotu kpa ala? Ala byo we ebeni wa da ami.&gt;&gt;<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Kweyi abyo wa danu. Ishini omaku bibi mo Oyesu ni, ebebeni oyo gwo gbo ya ja okpagye kweyi okwunu nu ya kyowu.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Oyesu da ada ko oyi mani oka mo, &lt;&lt;Ose mani kwo gbeji wa?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">Ada nu kamo, &lt;&lt;Bwi ishini owo oyi leke ni. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ishini okwo kpiri oya yo ta go ola kwe inyo ko yo ngmo. Owoni oke ya gege, miyinyinyi ka aha shini otahabo.&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Oyesu ka da nu mo, &lt;&lt;Ojiya ni omo owoni oya gege?&gt; Ojoji ya le kwee da ase ni yo otuse ni.&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Ebebeni ada ko oyi mani kamo, &lt;&lt;Nyyo otuse, otuse hin pa nwa lo, fu manu da ami!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Ishini Oyesu me ewa ba we ebeni ni, oka do omaku bibi mo, &lt;&lt;Awo omaku ko odoho kpo okyi igbenu, nyya ka da awo, bose sho, ka kwikye gi ikpiye nu ke lo.&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Omaku bibi sheha, kweyi ja oyi mani ko otata ime obose sho. Oyi oni tagye byo okwu kweyi ase nwashika ba kamo, &lt;&lt;Ogekwu.&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Oyesu ke bya abo kweyi nga anu hagye kpi ikpo nu, kweyi ohagye iso.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Ishini Oyesu gi ipwole ni, awogboso ga ta anu fufunu kweyi do oka mo, &lt;&lt;Ojiya ni aha gege ko ngmo omaku bibi shi ikpiye ko oyi oni lo?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Oka da awa mo, &lt;&lt;Edo ko omaku bibi mani ba bose kin lo, si inarigwu kpo kwo okwunu.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s">Oyesu Ki Kela Ikweyi ki Ikwu nu</para>
  <para style="r">(<ref loc="MAT 17:22-23">oMatiyu 17.22-23</ref>; <ref loc="LUK 9:43b-45">oLuka 9.43b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Oyesu kpa awogboso she ebeni bita kweyi abwa agye ko Ogalili. Oya yimu shini ashishe na gye ebeni aba anu ni lo, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ikweyi koni oya fa awogboso oza ni. Oka da awa mo, &lt;&lt;Aba yo Oyi ka Asuse ya ra da asuse. Aba yo ngmo, kweyi itikpi ke eno ko omweta Owuso ya yo ya nyiso ikwu.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Awa ke gyikweyi kela ni oya ka ni lo, aba yoshi ko do oka.<verse eid="MRK 9:32" /></para>
  <para style="s">Anoho She?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">oMatiyu 18.1-5</ref>; <ref loc="LUK 9:46-48">oLuka 9.46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Ishini Awo Okapanahu ni, oduwoka ipu kole ni aba nu ni mo, &lt;&lt;Awashu wonya ni ala ba ta owe oni?&gt;&gt; <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Abagye kpo, koni agye mo awa tawashu ikweyi ko kamo anoho ya wo neneshi ni.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Ni abagye ni, Oyesu ya awogboso igwepa ogwu kweyi ka da awa mo, &lt;&lt;Kpiri kase ni ya yimu ko wa kikyikyo, owotiri koni oya wa ko gwejeji kweyi ya wo oyole ka ananoho.&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Oyo oyi leke oye ogwu wa hagye otutehe wa. Oyo sakya kweyi ka da awa mo, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />&lt;&lt;Kpiri kase ni yo oye ipu ka ayi leke mani omaba ipu ki iye hin, ami pini oyumo omaba oma, kweyi kpiri kase ni yumo omaba, ami pini oyumo omaba lalo ke wa ase ni tumoleho ni.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s">Ase ni Tela ka Aha lo, Owa akaka Aha la</para>
  <para style="r">(<ref loc="LUK 9:49-50">oLuka 9.49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Oyohana kamo, &lt;&lt;Inofoza, aha ma ashe ya no omaku bibi enya shi ikpiye kase ipu ki iye wo, aha kamo ona shi bita ikweyi koni owo oye ipu ka aha lo ni.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Oyesu ka danu mo, &lt;&lt;Ala ka wo obi lo. Kpiri kase ni yo oza ki igbashi ipu ki iye hin, go ohobu oya ko obibi ikweyi hin lo, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />kpiri kase ni tela ka aha lo, oyo kpa aha la. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Nyya kadala okwokwoshi, kpiri kase ni da ala abwa ki inyo ipu ki iye hin koni ala wa ko Okristi ni abola ya nyo lo.<verse eid="MRK 9:41" /></para>
  <para style="s">Oza ni Ya Ase ba Yo Ozalabi ni</para>
  <para style="r">(<ref loc="MAT 18:6-9">oMatiyu 18.6-9</ref>; <ref loc="LUK 17:1-2">oLuka 17.1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />&lt;&lt;Kweyi kpiri kase ni yo oye ipu ka ayi leke mani ni kyogwu kpa ami ni yo ozalabi, oya shoshi she danu oni shini ana ye ego nyakwu gbo bo oko kweyi yo ta gi ishu nyakwu. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Owoni abo wo yayo ya yozalabi, yigo tonu. Oya shoshi she shini opyo olayi ko gbogbo-gbogbo kpa abo oye gogo sho oni oya gba abo epa kweyi ayo ta go ole ko ola, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />ebeni iyu ni ba ho okwu wa ni ba gekwu lo, kweyi ola ni ya yuwa ni ya gbo omyomyi lo.<note caller="+" style="f"><char style="fr" closed="false">9.44 </char><char style="ft" closed="false">Okpa ni ata kpa abo nekye ni shishini gba ayabo awene ayene lo</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Kweyi owoni ikpo wo ya yo ya yo ozalabi, yigo tonu. Oya shoshi she shini opyo olayi ko gbogbo-gbogbo kpi ikpo gogo sho oni oya gbi ikpo epa kweyi ayo ta go ole ko ola, <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />ebeni iyu ni ba ho okwu wa ni ba gekwu lo, kweyi ola ni ya yuwa ni ya gbo omyomyi lo.<note caller="+" style="f"><char style="fr" closed="false">9.46 </char><char style="ft" closed="false">Okpa ni ata kpa abo nekye ni shishini gba ayabo awene ayihiri lo</char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Kweyi owoni iyi wo ya yo ya yo ozalabi, yi ngma tonu. Oya shoshi she shini ogo obula ko Owuso kpi iyi oye ya sho oni oya gbi iyi epa kweyi ayo ta go ole ko ola,<verse eid="MRK 9:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="MRK 9:48" />ebeni iyu ni ba ho okwu wa ni ba gekwu lo,</para>
  <para style="q2" vid="MRK 9:48">kweyi ola ni ya yuwa ni ya gbo omyomyi lo.<note caller="+" style="f"><char style="fr" closed="false">9.48 </char><char style="ft" closed="false">ISH 66.24</char></note><verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />Aba ma ananoho ma kpo ola.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />&lt;&lt;Onwa shoshi, owoni onye ko onwa ke nyeba, oki ya wo onwa ke? Ala wo onwa la, ala gbo otu mene kpi iyi kala.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Ozafofu ko Oyesu Ikweyi ko ka Abo ko Onya kpo Oba</para>
  <para style="r">(<ref loc="MAT 19:1-12">oMatiyu 19.1-12</ref>; <ref loc="LUK 16:18">oLuka 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Oyesu she ebeni bita kweyi ga agbabo ko Oyahuda, kweyi sheyi ki ishu ko Ojoda. Ewa ka asuse we ebe nu, oya fuwoza byoni oya ya hagye ni.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Ashishini ka Awofarisi we ebe nu ko moma, adoka mo, &lt;&lt;Owo ono la shini ongo na kabo kpo onya nu?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Okyogwu mo, &lt;&lt;Oji ni Omusa ke kadala?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Akamo, &lt;&lt;Omusa daha oshu ko to okpa shini na wo olobene ko kabo ko onya kpo oba kweyi nenya.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Oyesu kyogwu mo, &lt;&lt;Ebe ko otu bibi kala pini yo Omusa ko ono mani da la. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Bwi ikyikyo kese, Owuso &lt;yo ongo kpo onya.&gt;<note caller="+" style="f"><char style="fr" closed="false">10.6 </char><char style="ft" closed="false">IKYI 1.27</char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />&lt;Ikweyi koni ongo ya shi inanu kpa adanu bita kweyi ya gbo onya nu, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />kweyi ase epa ni wi ikpiye oye kponu.&gt; Bwe ebeni awase epa lo, ke wo oye la.<note caller="+" style="f"><char style="fr" closed="false">10.8 </char><char style="ft" closed="false">IKY 2.24</char></note> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ni olemani, oza no Owuso yi gbo ni ashishe naka yiyi lo.&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Ishini abi ipu kole ni, awogboso do Oyesu oka ikweyi kela ni oka ni. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Okyogwu mo, &lt;&lt;Kpiri kase ni ka abo kpo onya nu kweyi gbo onya oye, oya beba kpa anu pini oma. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Kweyi onya ni tela ko obunu ga gbo oba oye, oya beba kpa anu pini oma.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s">Oyesu Sa Ayi Leke Aboneshi</para>
  <para style="r">(<ref loc="MAT 19:13-15">oMatiyu 19.13-15</ref>; <ref loc="LUK 18:15-17">oLuka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Abya ayi leke wa do Oyesu shini na suwa aboneshi, awogboso ke ba gba awase ni apwo mo ana hagye. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Ishini Oyesu ma mani ni okyanya kpa awa. Oka da awa mo, &lt;&lt;Ala sha ayi leke bita na we ebe hin, ala ka wuwo obi lo, obula ko Owuso wa akaka wa la. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Nyya kadala okwokwoshi, kpiri kase ni zo obula ko Owuso bya ayi leke mani lo, oya ga nu lo.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Kweyi okwa ayi leke sa akya nu, kweyi suwa aboneshi.<verse eid="MRK 10:16" /></para>
  <para style="s">Isongo ni Gbo Odu ni</para>
  <para style="r">(<ref loc="MAT 19:16-30">oMatiyu 19.16-30</ref>; <ref loc="LUK 18:18-30">oLuka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Ni Oyesu yipu ki iyawu ya ga ni, ongo oye nyinya wa kwagye obutu nu kweyi doka mo, &lt;&lt;Inofoza neshi, oji ni nyya ya shina pyo olayi ko gbogbo-gbogbo?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Oyesu doka mo, &lt;&lt;Ojiya ni oyumo ogwu mo ase neshi? Ashishe wa ase neshi lo, so Owuso fufunu. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ogyo oza ni ono ka ni, &lt;Ka ngmase lo, ka beba lo, ka wi lo, ka ba ase ela lo, geyagye da ada wo kpe ene wo.&gt;&gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Okamo, &lt;&lt;Inofoza, kpiri ka awoza mani nggeyagye danu bwi ishini nwwo oyi leke ni.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Oyesu pyi iyi mo kweyi oyimu nu, okamo, &lt;&lt;Oza oye nyo. Ga yo oza ni ogbo kpiri yi ra shini oyi ikwiri yi ko da awoleha, shini ogbo odu iso. Kweyi owa gbosun.&gt;&gt;<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Ela mani yi iyi ko ongo mani gola. Oga kpo otu byobya, koni ogbo odu nwashika ni.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Oyesu pyi iyi ma awogboso kweyi kamo, &lt;&lt;Oya lono do olodu ko go obula ko Owuso!&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Ebeni igbashi ya awogboso kwu ikweyi kela ni oka ni. Oyesu ki kamo, &lt;&lt;Ayi leke, oya lono ko go obula ko Owuso! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Oya le kwee do onyakwimi ko bwo owu ko onya sho olodu ko go obula ko Owuso.&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Igbashi ya awogboso kwu kweyi aba diyiwa oka mo, &lt;&lt;Anoho ni aba ngmanu?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Oyesu pyi iyi muwa kweyi kamo, &lt;&lt;Ebe ka asuse oya gbodagye lo, ebe ko Owuso ke kpiri ko oza oya gege ko ya.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Obitrus ka danu mo, &lt;&lt;Aha ke sho ojoji bita kweyi gboso!&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Oyesu ka da awa mo, &lt;&lt;Nyya kadala okwokwoshi, kpiri kase ni sho ole nu bita kwe ayinanu nongo kpa anya kwe ada nu kwe inanu kwe ayi nu kwe eho nu ikweyi hin kpe ela hin, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />oya pye ole ogbogbo, ipu ki ishi mani ole kwe ayene wo nongo kpa anya kwe ene wo kwe ayi wo kpe eho wo kpe egye, oya pyo olayi ko gbogbo-gbogbo ipu ki ishi ni ya wa ni. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Awase ni ke wa kikyikyo ba wa ko ogwejeji, ko ogwejeji ba wa kikyikyo.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">Oyesu ki Kela Ikweyi ki Ikwu nu</para>
  <para style="r">(<ref loc="MAT 20:17-19">oMatiyu 20.17-19</ref>; <ref loc="LUK 18:31-34">oLuka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Ni abowe ko go Ojerusele ni, Oyesu yo ohobu wa. Kweyi igbashi ya awogboso kwu, kweyi awase ni ki ba gbosuwa ni oshi yuwa kwu. Ebeni oya awogboso igwepa ogwu go okoka kweyi ka da awa oza ni ya wa gbodagye kpa anu ni. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Oka da awa mo, &lt;&lt;Aha ba go Ojerusele, kweyi aba ga yo Oyi ka Asuse ya ra da awoteyi ka awosapa kpa awofono. Aba kwe epwo ko yo ngmo, kweyi aba yo ya na abo da awase ni wa Ashashe ni, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />shini ana gbo owuru, ana tehe sho, ana ya aboshi, ana yo ngmo. Eno ko omweta oya nyiso.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s">Oyohana kpo Oyakubu wa bo Oyesu Oza</para>
  <para style="r">(<ref loc="MAT 20:20-28">oMatiyu 20.20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ebeni Oyakubu kpo Oyohana ayi ko Ozebedi we ebe ko Oyesu kweyi kamo, &lt;&lt;Inofoza, aba yimu shini oyo oza kpiri ni aha do oka ni daha.&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Oduwoka mo, &lt;&lt;Oji ni ala ba yimu?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Akyogwu mo, &lt;&lt;Ya ashe ipu ka aha na yagye abore wo, oye na yagye aboshe ipu ko igyashi wo.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Oyesu ka da awa mo, &lt;&lt;Ala gyo oza ni ala ba doka ni lo. Ala ba gege ko gwinyi kpa abwa ni nyya gwinyi kpa anu kwe ana ya ala obatisma ni nyya ni lo?&gt;&gt;<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Akyogwu mo, &lt;&lt;Aha ba gege.&gt;&gt;</para>
  <para style="p" vid="MRK 10:39">Oyesu ka da awa mo, &lt;&lt;Ala ba gwinyi kpa abwa ni nyya gwa ni kweyi ki yo obatisma byoni nyya ni, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />yagye abore kwe aboshe hin ke, ami gbo oshu ko da ase lo. Omani akyanu tu gbeyi kawase ni akyanu tu ela wa ni la.&gt;&gt;<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Ishini ashini ka awogboso igwo pwela mani ni, akyanya kpo Oyakubu kpo Oyohana. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Oyesu yuwo ogwu tukpa kweyi kamo, &lt;&lt;Ala gye mo awase ni wose ka wase WO Oyahuda lo ni ba yuwa ayikoko ko Oyesu, kweyi ase ni wo onongbo nyakwu ipu wa gbo oshu ikweyi wa. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Oke ya lemani kpa ala lo. Mani oni, kpiri kase ni ya yimu ko wo oteyi ipu kala na zi iyinu wo oyole, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />kweyi kpiri kase ni ya yimu ko wi ikyikyo na wo oyole ka ananoho. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kwo Oyi ka Asuse wa shini ana gbeshe danu lalo, oke wa shini ona gbeshe da ase, kweyi ona ki zo olayi nu ikweyi kase nwashika.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s">Opwiyi ko Obatimawu Pyo Ogege</para>
  <para style="r">(<ref loc="MAT 20:29-34">oMatiyu 20.29-34</ref>; <ref loc="LUK 18:35-43">oLuka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Ebeni ago ogya ko Ojeriko. Byoni Oyesu kpa awogboso kpe ewa ka asuse ba sho ogya nyakwu oni bita ni, ofiyi oye ni aba yo mo Obartimawus (oyi ko Otimawus) ni yagye okunu kowe ya boza. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Ishini opwo mo Oyesu ko Onazaret ya shigbo ni, okwotu ko ngmegba mo, &lt;&lt;Oyesu, Oyi ko Odawuda, miyinyinyi hin!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Awase ni be ebeni gba apwo kweyi kamo ona sha, anu ke ya zoko iso nwa ya kamo, &lt;&lt;Oyi ko Odawuda, miyi nyinyi hin!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Oyesu hagye kweyi kamo, &lt;&lt;Ala yo ogwu.&gt;&gt;</para>
  <para style="p" vid="MRK 10:49">Ebeni ayo ofiyi oni ogwu mo, &lt;&lt;Shotunehe! Nyiso sho hagye! Oya yo ogwu.&gt;&gt; <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Oyo oshiye nu shonu kweyi shibi we ebe ko Oyesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Oyesu do oka mo, &lt;&lt;Oji ni oya yimu shini na ya da awo?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">Opwiyi mani kamo, &lt;&lt;Inofoza, nyya yimu ko ki me ebe.&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Oyesu ka danu mo, &lt;&lt;Ga, otuse wo da awo ogege.&gt;&gt; Ebebeni iyi nu gwa kweyi ogboso Oyesu.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Oyesu Gipu ko Ogya ko Ojerusele</para>
  <para style="r">(<ref loc="MAT 21:1-11">oMatiyu 21.1-11</ref>; <ref loc="LUK 19:28-40">oLuka 19.28-40</ref>; <ref loc="JHN 12:12-19">Oyohana 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Ni ayo pee kpo Ojerusele, kpo Obetafiji kpo Obetani ni afe ebe ke Efu ko Ozetu ni, Oyesu ta awogboso epa oleho mo, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />&lt;&lt;Ala gipu ko ogya ni yo ohobu kala anoni, kweyi owoni ala gogya ni, ala ba mo oyi ko odagyi ni ashishe se wa lo ni togwa. Ala yiyi biwa. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Owoni ashe da ala oka mo, &lt;Ojiya ni ala ba yoyi?&gt; Ala ka danu mo, &lt;Adole pini ya yimu la, oya kwikye anu anani.&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Aga kweyi ga mo oyi ko odagyi gbogbo owofunu kole okwunu ko owe. Ni aba yo yi ni, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />awa ase ni hagye ebeni ni duwoka mo, &lt;&lt;Oji ni ala baya ni, ala ba yo oyi ko odagyi yi la?&gt;&gt;<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Aka da awa byoni Oyesu ka ni, kweyi awase ni shuwa bita ga. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Ishini abyo oyi ko odagyi wa do Oyesu ni akpo oshiye wa ta ikweyi nu, kweyi oyagye ikweyi nu. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Ase nwashika yo oshiye wa ta ikweyi ko owe, ashini gipu ke eho ga kye efu wa ta. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Awase ni bo ohobu kpa awase ni bi itikpi ni sheha mo,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;An sho Owuso iye!&gt;&gt;</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Otunehe yo kpase ni ya wa ipu ki iye ka Adole!&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="ft" closed="false">IGYE 118. 26</char></note><verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />&lt;&lt;Otunehe yo kpo obula ka ada ka Odawuda ni ya wa ni!&gt;&gt;</para>
  <para style="q" vid="MRK 11:10">1 &lt;&lt;Iye shosha wa ko Owuso ni yiso!&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Oyesu gogya ko Ojerusele kweyi ogo ole ko Owuso. Otiyi mo ojoji kpiri, ni eno ya sha ni obose go Obetani kpa awogboso igwepa.<verse eid="MRK 11:11" /></para>
  <para style="s">Oyesu te Efu ko Ofigi Igbe</para>
  <para style="r">(<ref loc="MAT 21:18-19">oMatiyu 21.18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Gbe ebenya ni aba sho ogya ko Obetani bita ni, emye ya ngmo Oyesu. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Omefu ko Ofigi oye ni gbefu ni ebe lenu, ebeni osha bo kwe ogbo ogwogwa. Ishini ofebeni ni, omo ojije lo sefu, koni owi ishi ko gwogwa nu lo ni. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Ebeni oka de efu mo, &lt;&lt;Ashishe ya ho ogwogwa wo kelo ko gbogbo-gbogbo!&gt;&gt; Awogboso pwo oza ni oka ni.<verse eid="MRK 11:14" /></para>
  <para style="s">Oyesu kyo Ole ko Owuso tu</para>
  <para style="r">(<ref loc="MAT 21:12-17">oMatiyu 21.12-17</ref>; <ref loc="LUK 19:45-48">oLuka 19.45-48</ref>; <ref loc="JHN 2:13-22">Oyohana 2.13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Ni apwo ogya ko Ojerusele ni, Oyesu gipu kole ko Owuso kweyi okwotu ko na wo riyo kya anu ra shi ipu kole. Oki ya sa abo oka ka awo shi ikwiri kpo oka ko yagye ka awo tora ko otitiribi, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />kweyi oki wa ananoho obi ko zoje shigbo akpada kole ko Owuso. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Kweyi oya fa ase oza mo, &lt;&lt;Kwe ayi tota ipu ko okpa mo, &lt;Aba yo ole hin ogwu mo ole ko tinarigwu ko ose kpiri.&gt;<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false">ISH 56.7</char></note></para>
  <para style="m" vid="MRK 11:17">Ala ke yo pya we ebe ko &lt;teba ka awowi.&gt;&gt;<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Ni awoteyi ka awosapa kpa awofono pwo mani ni, aba tikpo ko owe ko yo ngmo, aba yoshi ikweyi koni igbashi ya ase lewa kwu ikweyi ko ozafofu nu.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Ishini eno sha ni, anu kpa awogboso bose sho ogya ni.<verse eid="MRK 11:19" /></para>
  <para style="s">Ozafofu Ikweyi ke Efu ko Ofigi</para>
  <para style="r">(<ref loc="MAT 21:20-22">oMatiyu 21.20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Otukpokyi ni abose ba ga ni, ame efu ko Ofigi oni ngmongmo ko ogbogba. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Ebeni Obitrus ra kweyi ka do Oyesu mo, &lt;&lt;Adole, ma! Efu ko Ofigi ni otigbe ni ngmongmo!&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Oyesu ka da awa mo, &lt;&lt;Ala yo otuse Owuso. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Nyya kadala okwokwoshi, kpiri kase ni ka de efu mani mo, &lt;Ona shu ga gbo ipu ki ishu nyakwu,&gt; Kweyi ogbo otu lo, oke yo otuse mo oza ni oka ni ya gbodagye, oya lemani danu. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Mani oni, nyya kadala, kpiri koza ni ala tinarigwu ba doka, ala yotuse mala kwobonu pye wa, kweyi oya wa kakala. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Kweyi ishini ala hagye ko tinarigwu kweyi ala bya ashe otu, yo ozalabi nu yi gbo shini Ada kala ni yi iso ni na yo ozalabi kala gbala. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Owoni oke gbase ozalabi lo, Ada wo ni yi iso ni ya yo ozalabi wo gbuwo lo.&gt;&gt;<verse eid="MRK 11:26" /></para>
  <para style="s">Oka Doda Ikweyi ko Oshu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">oMatiyu 21.23-27</ref>; <ref loc="LUK 20:1-8">oLuka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Aki kwikye wo Ojerusele kweyi Oyesu ya yawu ipu kole ko Owuso, oteyi ka awosapa kpa awofono kpa anyakwase we ebe nu. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Awa doka mo, &lt;&lt;Kpo oshu wonya ni oya ya awoza mani? Anoho da awo oshu ko ya?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Oyesu kyogwu mo, &lt;&lt;Nyya da ala oka oye. Ala gyelo nyumagbo, nyya kadala kpo oshu wonya ni nyya ya awoza mani. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Ala ka da ami, obatisma ni Oyohana ya ni bwi iso ebe ko Owuso la kwe bwe ebe ka asuse?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Adiyiwa oka mo, &lt;&lt;Owoni aha kamo, &lt;Obwi iso,&gt; Oya daha oka mo, &lt;Ojiya ni ala kyogwu kpa anu lo?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ake ba yoshi ko kamo, &lt;Obwebe kasuse&gt; koni ananoho kyogwu mo Oyohana wi inobane la.&gt;&gt;<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Ebeni anyo Oyesu agbo mo, &lt;&lt;Aha gye lo.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Oyesu ka da awa mo, &lt;&lt;Ami ki ya kada ala kpo oshu wonya ni nyya ya awoza mani kpa anu ni lo.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Elase Ikweyi ka Awo osheho ka Abola</para>
  <para style="r">(<ref loc="MAT 21:33-46">oMatiyu 21.33-46</ref>; <ref loc="LUK 20:9-19">oLuka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Ebeni okela da awa ipu kelase mo, &lt;&lt;Ongo oye sheho kinabi kweyi omokpe gyehe to, omoba ni aba pyi inyi ya sho ni, oki moda ki inogbeho. Ebeni oye eho yi da awo osheho oye abo kweyi ganu gi iyawu. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Ni ishi ko wo ogwogwa ke efu ya ni, oto oyole nu oleho ko ga zo ogwogwa ke efu ebe wa. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ake yo kwu, kweyi agwo kweyi ane enya ga kpa abo yeye. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Ebeni oki to oyole oye oleho ge ebe wa. Agwo ikweyi kweyi agbowuru. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Oki ta ashe oleho ebe wa, anu oni ayo ngmo. Ota ase nwashika oleho, ashini wa agwuwa, ashini ayuwa ngmo.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />&lt;&lt;Ogba ashe oye ko to oleho, oyi nu moshi ni oya yimu ni. Otoleho ogwejeji mo, &lt;Aba yi iweyi ko oyi hin.&gt;<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />&lt;&lt;Awoyoko ka abola mani ke ka diyiwa mo, &lt;&lt;Omani pini wi ino rogwu la. Ala wa shini ahan yo ngmo shini ogwu nu na wa akakaha.&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Ebeni ayo kwu kweyi yo ongmo, ayo ta weyi ko ongma ge ese ke eho.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />&lt;&lt;Nabani oji ni ada ke eho ya wa ya? Oya wa ya awo osheho ka abola mani ya yi ngmo, kweyi ya ye eho ya da awashe hoha. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Ala mo oza mani ipu ko okpa lo?</para>
  <para style="q1" vid="MRK 12:10">&lt;Okpo ni awomoda tela mo shoshi lo ni,</para>
  <para style="q2" vid="MRK 12:10">anu pini wo okpo neshi ko moda la;<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Owo oyoya ka Adole la,</para>
  <para style="q1" vid="MRK 12:11">kweyi oshoshi iyi ka!&gt;&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Bwe ebeni aba tikpo ko owe ni aba yo kwu ni ikweyi koni agye mo okelase mani kpa awa. Ake ba yoshi ke ewa, ebeni asho bita kweyi ga wa.<verse eid="MRK 12:12" /></para>
  <para style="s">Ala Zegba do Okesa</para>
  <para style="r">(<ref loc="MAT 22:15-22">oMatiyu 22.15-22</ref>; <ref loc="LUK 20:20-26">oLuka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Ipu ki ishi gbayayi, ata ashini ka Awofarisi kpi ikpo ko Ohiridus oleho ge ebe ko Oyesu shini ana pwe ela ko okwunu nu. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Awe ebe nu kweyi kamo, &lt;&lt;Inofoza, agye mo owa ase neshi. Oya byotu kpo oza ni ase ba ka ni lo. Oza ashe ya sha ashe lo, oya fa ase ela ko Owuso kpo kwokwoshi. Ka daha, oshoshi shini ahan zegba do Okesa la kwe ahan ka ze lo?&gt;&gt; <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ahan zegba kwe an ka ze lo?</para>
  <para style="p" vid="MRK 12:15">Oyesu ke gye mo awa awo byiga byiwa kweyi oduwoka kamo, &lt;&lt;Ojiya ni ala yimu ko zegba da ami? Ala byo odinari wa da ami shini na ma.&gt;&gt; <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Abyikwiri ikwiri oni wa danu, oduwoka mo, &lt;&lt;Oyi ka anoho kpi iye ka anoho yo ni?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">Akamo, &lt;&lt;Oyi ko Okesa.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Ebeni Oyesu ka da awa mo, &lt;&lt;Ala do Okesa oza ni wa ko Okesa, ala do Owuso oza ni wa ko Owuso ni.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">Ebeni igbashi yuwa kwu.<verse eid="MRK 12:17" /></para>
  <para style="s">Oka Doda Ikweyi ko Onyiso ka Ikwu</para>
  <para style="r">(<ref loc="MAT 22:23-33">oMatiyu 22.23-33</ref>; <ref loc="LUK 20:27-40">oLuka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Awosadukiya ni kamo onyiso ki Ikwu yaba lo. Ashishini wa <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />do oka mo, &lt;&lt;Inofoza, Omusa ta daha kamo, owoni ongo gbo onya kweyi moyi kpa anu lo kweyi ogekwu sho onya bita, owotiri shini oyinanu na do oka ko onyokwu oni shini na mayi do oyinanu. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Ishi oye agba ayene ahapa. Ki ikyikyo ipu wa gbo onya kweyi mo oyi kpa anu lo, gbi ishini ogekwu. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ko omwepa fogwu ko onya oni, ake moyi lo gbi ishini ogekwu. Mamani ogbodagye kpa ako omweta wa. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Ogwejeji nu, ayene ahapa mani ashishe wa moyi kpa anu lo, gbi ishini onya ni ki gekwu. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ni olemani, onyiso ki Ikwu, anoho ni oya wo onya nu ipu wa, ni ayene ahapa mani kpiri do oka nu ni?&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Oyesu kyogwu mo, &lt;&lt;Ala gebi ikweyi koni ala gyo Okpa kpo oshu ko Owuso lo. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Ishini awase ni gekwu ni nyiso, ango ba gba anya lo, anya ba gbo oba lo; aba lema bya ayoleho ipu ki iso. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ikweyi ko onyiso ka amiri. Ala ma ipu ko okpa ko Omusa ni Owuso kela danu ipu ki ikyashi ni mo, &lt;Ami wo Owuso ki Ibirayi, Owuso ki Ishaku kpo Owuso ko Oyakubu ni lo&gt;<note caller="+" style="f"><char style="fr" closed="false">12.26 </char><char style="ft" closed="false">OBOSE 3.6</char></note>? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Owo Owuso kawase ni gekwu ni lalo, ke wo Owuso kawase ni ba gbo layi ni la. Ala nyi iyi nwashika!&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">Ono ni wo Loshu She ni</para>
  <para style="r">(<ref loc="MAT 22:34-40">oMatiyu 22.34-40</ref>; <ref loc="LUK 10:25-28">oLuka 10.25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Oye ipu ka awofono wa tawa ba tawashu. Ogye mo Oyesu kyogwu kela neshi, kweyi odoka mo, &lt;&lt;Ipu ko ono ko Omusa kpiri, onya loshu she?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Oyesu kyogwu mo, &lt;&lt;Oni loshu she ni yoma, &lt;Ala za akpaha shini ala pwo, ase ki Izrayila, Owuso Adole ka aha wo oye la. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Kweyi oyimu ko Owuso Adole wo kpo otu wo oye kpiri, kpo olayi wo, kpo oza kpiri no oya ra ipu ko otu wo ni, kpo oshu wo kpiri.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.30 </char><char style="ft" closed="false">KYE EPWO 6.4,5</char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Omepa nu wo, &lt;Yimu kase ni yo kwo ni byoni oya yimu ki iyiwo ni.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.31 </char><char style="ft" closed="false">OLI 19.18</char></note> Ono oyoye yaba ni sha awomani lo.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Inofono kamo, &lt;&lt;Owokwokwoshi la. Oko okwokwoshi ni okamo Owuso wo oye kweyi ashishe yaba kelo sa anu. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kweyi oyimu nu kpo otu wo oye kpiri, kpo oza gyogye wo, kpo oshu wo kpiri, kweyi yimu kase ni yo kwo ni byoni oyimu ki iyiwo ni shoshi she eshi zoze kpo peshi la.&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Ishini Oyesu mo kela kase ni ziyi ni, oka danu mo, &lt;&lt;Oyo lenu kpo obula ko Owuso lo.&gt;&gt; Bwe ebeni go ohobu ashishe ki do oka ka awela kelo.<verse eid="MRK 12:34" /></para>
  <para style="s">Omezaya wo Oyi ka Anoho</para>
  <para style="r">(<ref loc="MAT 22:41-46">oMatiyu 22.41-46</ref>; <ref loc="LUK 20:41-44">oLuka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Ishini Oyesu ya foza ipu kole ko Owuso ni, odoka mo, &lt;&lt;Owe wonya ni awofono ba kamo Omezaya wo oyi ko Odawuda? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Odawuda abiyinu kela bwe ebe ko Omaku ko Owuso mo,</para>
  <para style="q1" vid="MRK 12:36">&lt;Adole ka da Adole hin:</para>
  <para style="q2" vid="MRK 12:36">&lt;&lt;Yagye abore hin</para>
  <para style="q1" vid="MRK 12:36">gbishini nyya ya awomonyekwotu wo</para>
  <para style="q2" vid="MRK 12:36">ba bagye eye ka apatikpo wo.&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Odawuda abiyinu yo ogwu mo, &lt;Adole.&gt; Owe wonya ni oki ya wo oyi nu?&gt;&gt;</para>
  <para style="p" vid="MRK 12:37">Lewa kase pwela mani kweyi otuwa sha.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Ishini Oyesu ya foza ni, okamo, &lt;&lt;Ala gbera kpo oza fofu ka awofono. Aba sho obagidi ni gbo ogwa ni kweyi ba gyehe shini ana tuwo ogbogba ipishi, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />kweyi ana da awa ebe ko yagye neshi ipu ke ekpa kpe ebe ki imya. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Aba kpi iyo ka anyokwu koshu ole wa. Kweyi aba tinarigwu gbeji shini ase na muwa. Edo kawase mani aba da awo owe kotata.&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">Eshi Zoze ko Onyokwu</para>
  <para style="r">(<ref loc="LUK 21:1-4">oLuka 21.1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Oyesu yagye pyi iyi te ebe ni aba zeshi ni kweyi ome ewa ba zeshi ba ti ipu ko odudu. Awolodu nwashika ba ti ikwiri nwashika. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Ebeni onyokwu oye ni ke gbeha ni wa ti ikwiri epa ni fo okwobo lo ni.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Ebeni Oyesu ya awogboso ogwu kweyi kamo, &lt;&lt;Nyya kadala okwokwoshi, oza ni onyokwu ni gbeha mani ti ipu ko odudu mani sha ka ananoho. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kpiri wa ze ipu ko oza ni agbo nwashika ni la, anu ke ipu ke eha ni oyanu ni. Ozo oza ni ogbo ni, ki kpo oza ni ogbo ko re ni.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Oyi ko Kweyi ke Ese</para>
  <para style="r">(<ref loc="MAT 24:1-28">oMatiyu 24.1-28</ref>; <ref loc="LUK 21:5-24">oLuka 21.5-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Ishini obose bwo Ole ko Owuso ni, ashe ipu ka awogboso do oka mo, &lt;&lt;Inofoza, me edo ka awikyikpo kpa awole neshi mani!<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Oyesu kyogwu mo, &lt;&lt;Ala ma awole neneshi mani? Ikyikpo oyoye aba shobita ya hagye ikweyi ko oye lo, kpiri wa ke aba yi kye sho okpagye.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Ishini Oyesu yagye ikweyi ke Efu ko oZetu ni kweyi pyi iyi to ole ko Owuso ni, Obitrus kpo Oyakubu kpo Oyohana kpa Andru wa tanu kweyi do oka mo, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt;Ka daha, ishi wonya ni awoza mani ba gbodagye? Oji ya wo oyi ni aha ba gye kamo oza mani ba yimu ko gbodagye?&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Oyesu ka da awa mo, &lt;&lt;Ala gbere, ashishe na ka gya ala egya lo. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Ikweyi koni ase nwashika ba wa kpi iyen kweyi ba kamo, &lt;Ami pini wa anu la,&gt; Kweyi aba wa gyase nwashika egye. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ishini ala pwela ke efu kpokpo, kpo oshu ikweyi ke efu kpokpo, ala ka yoshi kwe wode lo. Oza lemani bawa gbodagye, okweyi kese ke tayayo wa wa lo. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Okpagye oye ba kpe efu kpo okpagye oye, kweyi obula bawa kpe efu kpo obula oye. Okpagye ya ja ebe nwashika kpe emye. Awomani wo okwotu ko ose ko oma kin yoma.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />&lt;&lt;Ala bagye kpe era. Aba ya ala nabo da awonongbo leke kweyi aba ya ala aboshi ekpa. Ikweyin aba bya ala go obotu ka awogbolamaga kpa awose, ala ba yo olobene da awa. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Kweyi ikyikyo oshu neshi ko Owuso ya ga akpaha ko ose kpiri. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Ishini akwa ala kweyi bya ala ge ebe ko ke epwo, ala ka gbo otu ikweyi ko oza ni ala ba ka ni lo. Ala ko oza ni ayi ta ala okwunu ishi oni kin, ikweyi koni ala pini ba kela lalo, ke wo Omaku ko Owuso pini ya ka la.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />&lt;&lt;Oyene ya rotu ko oyinanu da awa ko yo ngmo, kweyi ada ki ya rotu ko oyi nu. Ayi ba wa ya akyala kpa awase ni muwa ni kweyi aba yuwa nabo da awa ko yuwa ngmo. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ikweyi koni, kpiri kase ba wa tela kala, ase ni ke zotu go ogwejeji, aba ngma anu she epwo koka ko Owuso.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Inomokpa na gye mo, &lt;&lt;Ishini ala ba mo oza kebi hagye ebe neshi ko bye ebe kyokya wa ebeni oshu ko hagye lo ni. Kweyi awase ni ba agye ko Oyahuda na nyinya gi ikweyi ka awefu. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Kweyi ase ni yikweyi ki inu kole nu naka sa wo okpagye kwe gipu kole ga zo ojije we ese lo. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Kweyi ase ni yipu ke eho naka kwikye go ole ga kpo oshiye nu lo. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Eno ni ya labi da anya ni byipu kpa anya ni bya ayi abo ni! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Ala tinarigwu shini awoza mani naka gbodagye oshi ko oshu lo, <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />ikweyi koni aweno ni ba gbo owe she eno kpiri bwi ishini Owuso ye ese wo onabani kweyi aba gyogye kpe eno oyoye ohobu kelo. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Owoni Adole fe eno ni shigbo lalo, ashishe aba ngma anu lo. Ikweyi kawase ni oshu ni ke, ofe eno wa shigbo. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Ipu ki ishi oni, owoni ashe ka da awo mo, &lt;Omezaya yoma!&gt; Kwe &lt;Oyo oma!&gt; Ka kyogwu lo. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Koni awomezaya ko kame kpa awobane ko kame ba wa kweyi ba wa ya awoza ki igbashi ko gya awase ni oshu ni egya, owoni aba gege. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ikweyi koni ala gbera; nkwobonu kadala ojoji kpiri ime ishi oni na wa.<verse eid="MRK 13:23" /></para>
  <para style="s">Owowa ko Oyi ka Asuse</para>
  <para style="r">(<ref loc="MAT 24:29-31">oMatiyu 24.29-31</ref>; <ref loc="LUK 21:25-28">oLuka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />&lt;&lt;Ipu ka aweno ni ke, itikpi ko owe ni, aba ye eno ya dibu, kweyi oya ya yu lo; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />inyiwo ba shonu bwa akpa, kweyi oza ni bi ipu ka akpa ni ba ja.&gt; <note caller="+" style="f"><char style="fr" closed="false">13.25 </char><char style="ft" closed="false">ISH 13.10; ISH 34.4</char></note> <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />&lt;&lt;Ipu ki ishi oni, ase ba mo Oyi ka Asuse ya wa bwi ipu ka akpa kpo oshu kpo igyashi. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Kweyi oya ta ayoleho nu oleho kweyi ya wa kpa awase ni oshu ni tukpa bwa agyi ene, bwe eji kese ge eji ki iso.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />&lt;&lt;Byonabani, ala fu bwebe kelase ke efu ko ofigi. Ishini efu nu ya fu pepe, ala gye mo ogwa ya gbo oma. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ni olemani oni, ishini ala ma awoza ni ba gbodagye, ala gye mo ishi yo pee, oyofunu kowe kala. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Nyya kadala okwokwoshi, ase ki ishi mani ba gekwu lo, sa awoza mani kpiri gbodagye. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Iso kpo okpagye ba wa shuga, elan ke ba shuga lo.<verse eid="MRK 13:31" /></para>
  <para style="s">Ashishe Gye Eno kwe Ishi lo</para>
  <para style="r">(<ref loc="MAT 24:36-44">oMatiyu 24.36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />&lt;&lt;Ashishe gye eno kwe ishi lo, ka ayoleho ki ipu ki iso kwe Oyi gye lo, ke sa Ada fufunu. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Ala gbera! Ala wi iyi kala shu! Ikweyi koni ala gyi ishi oni lo ni. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Owowa ko Oyi ka Asuse ya lema byo ongo oye ni ya gi iyawu, kweyi sho ole nu bita do oyole nu mo ona gbole, oda ananoho oko nu, kweyi oka di inogbeho kole mo ona gbera.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />&lt;&lt;Mani oni, ala gbera ikweyi koni ala gye eno ni Ada kole ya kwikye ya wa ni lo, kwe onose, kwe otutehe ko otu, kwe ogwutogwu, kwe otukpokyi. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Owoni owa onaka wa ta awo ya gbola lo. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Oza ni nkadala mani, nka da ananoho: &lt;Ala gbera!&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Anyo Oyesu ano Obetani</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Ni Imya ko Sheyi kpi imya ki ikyoga ni gbo oyisi lo ni she ene epa ni, oteyi ka awosapa kpa awofono ba tiyi ko owe ni aba yo Oyesu ya kwu kweyi yo ngmo teba ni. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Akamo, &lt;&lt;Ona ka wi ishi ki imya lo ela koni apwo ya nyiso ipu ka asuse ni.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Ishini otayayo yo Obetani, oyagye ya roza ipu kole ko Osimo ni gbi iyiwa ni, onya oye wa kpo ogya ka ano kpeye ni gbi ikwiri nwashika. Obyo ogya ka ano kpeye kweyi yi nyiikweyi.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Ashishini kase ni bebeni otuwa bya kweyi aba diyiwa oka mo, &lt;&lt;Ojiya ni oya ano kpeye mani ya yi yishi? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Obi ya ano kpeye mani bi yi ra kweyi yi ikwiri yi da awoleha.&gt;&gt; Kweyi akyaneha jajaja. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Oyesu kamo, &lt;&lt;Ala sho onya mani bita, ojiya ni ala ba byotu kpa anu ikweyi koni oyumo oza neshi ni? <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Ishi kpiri ala yo kpa awoleha, ala ba gege ba tuwa abo ishini ala yimu. Ami ke ya yo kpa ala ishi kpiri lo. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Oyo oza ni oya gege ni, onyuma ano ikpiye gbeyi kishi ni aba yun nyi ni. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Nyya kadala okwokwoshi, ebeni ako oshu neshi anu kpiri ipu kese mani, aba ko oneshi ko onya mani.&gt;&gt;<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Oyahuda Iskariyoti oye bwi ipu ki igwepa ge ebe ko oteyi ka awosapa shini ona yo Oyesu ra da awa. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Otuwa sha, ishini apwo mani ni kweyi asho okoyi ko danu ikwiri. Bwebeni, oya tikpo ko owe ko yo Oyesu ra.<verse eid="MRK 14:11" /></para>
  <para style="s">Oyesu Roza ki Imya ko Sheyi kpa Awogboso</para>
  <para style="r">(<ref loc="MAT 26:17-25">oMatiyu 26.17-25</ref>; <ref loc="LUK 22:7-13">oLuka 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Oyohana 13.21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Eno kikyikyo ki imya ko oza rore ni gbo oyisi lo ni, owo odu wa ni aba shoko ko otukpo ki Imya ko Sheyi, awogboso Oyesu do oka mo, &lt;&lt;Ebenya ni oya yimu shini ahan ga yo oza rore ki Imya ko Sheyi do ko re?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Bwe ebeni, ota asepa oleho ipu ka awogboso mo, &lt;&lt;Ala gipu ko ogya, kweyi ala ba mo ongo oye byo ogya ki inyawo ya wa gbayi kpa ala. Ala gboso. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Ala ka da ada kole ni ala ganu ni mo, &lt;Inofoza ya doka ko oda ko roza, ebenya ni nyya roza ki Imya ko Sheyi ami kpa awogbosun?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Oya shiya ala oda oye nyakwu ki iso, akyanutu hagye. Ala yo oza rore ebeni.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Awogboso shobita, agi ipu ko ogya, kweyi ga mo oza kpiri ni Oyesu ka da awa ni. Ebeni ayo oza rore ki Imya ko Sheyi.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Ishini eno sha ni, Oyesu kpase igwepa ni ge ebeni. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Ishini aba roza ni, Oyesu ka da awa mo, Nyya kadala okwokwoshi, &lt;&lt;Ashe ipu kala, ni ya roza kpa ami owatu oye kponu ni ya wa yun ra.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Abyotu, kweyi akwotu ko do oka oyoye mo, &lt;&lt;Kwe ami la?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Okyogwu mo, &lt;&lt;Oye ipu ki igwepa ni ya labo owatu oye kponu kpa ami ni. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Oyi ka Asuse ya ga byoni ayitota ikweyi nu ni. Igbe na ta ase ni ke yo Oyi ka Asuse yi ra ni! Oya shoshi danu owoni abi ka mo lo.&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Ni aba roza ni, Oyesu zo ikyoga kweyi okeshi, kweyi oyi kyigbo, kweyi oyi da awogboso mo, &lt;&lt;Ala ze, omani wi ikpiye hin la.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ebeni oki za abwa, okeshi kweyi kamo ala ze, shini ala gwa bwi ipu nu. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Okamo, &lt;&lt;Omani pini woyi hin ko okoyi ni aba yi shonu ikweyi kase nwashika ni la. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Nyya kadala okwokwoshi, bwi ikyeni, nyya gwi inyi ko ogwogwa ke efu kelo si ishini nwwa gwo opepe obula ko Owuso.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Awigye ko Ozabura, kweyi abose ge ese ge ebe ke Efu ko Ozetu.<verse eid="MRK 14:26" /></para>
  <para style="s">Oyesu kamo Obitrus ya Tawashu nu</para>
  <para style="r">(<ref loc="MAT 26:31-35">oMatiyu 26.31-35</ref>; <ref loc="LUK 22:31-34">oLuka 22.31-34</ref>; <ref loc="JHN 13:36-38">Oyohana 13.36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Oyesu ka dawa mo, &lt;&lt;Kpiri kala ba wa nyinya shun, koni okpa ko Owuso kamo, &lt;Nyya ngmi inogbeho ko bize, kweyi otukpo ba kya.&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Ishini nke nyiso, nyya yohobu kala ya gipu ko Ogalili.&gt;&gt;<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Obitrus kamo, &lt;&lt;Owoni kpiri kase nyinya sho, ami ya nyinya lo.&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Oyesu kamo, &lt;&lt;Nyya kadala okwokwoshi, ome obogwu na tono ko omwepa, oya tawashu mo ogyun lo igbeta.&gt;&gt;<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Obitrus hagye okokonu mo, &lt;&lt;Kwo owa ko gekwu kpa awo, nyya tawashu wo lo.&gt;&gt; Kweyi ashini wa ka mamani.<verse eid="MRK 14:31" /></para>
  <para style="s">Oyesu Tinarigwu Ogesamani</para>
  <para style="r">(<ref loc="MAT 26:36-46">oMatiyu 26.36-46</ref>; <ref loc="LUK 22:39-46">oLuka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Abose ge ebye ni aba yogwu mo, Ogesamani, kweyi Oyesu ka da awogboso mo, &lt;&lt;Ala bagye ebeni, nyya ga tinarigwu.&gt;&gt; <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Oga, Obitrus, kpo Oyakubu, kpo Oyohana. Kweyi otu nu kwotu ko bya ko otata. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Oka da awa mo, &lt;&lt;Otu hin ya bya ko otata ko gekwu. Ala bagye ebeni shini ala gbeho.&gt;&gt;<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Osha go ohobu kee, ogbo okpagye kweyi otinarigwu mo owoni obi kyogwu, obi ye ebi mani bize shun. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Okamo, &lt;&lt;Ada hin, oya gege ya yo ojoji kpiri. Ya abwa ko owe mani yi bize shun. Ka yo oza ko otu hin lo, ke so oza ko otu wo.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Ebeni okwikye we ebe ka awogboso wa ta awa ba gbola. Oka do Obitrus mo, Awo Osimo, ala ba gbola la? Ala ba gege ya bagye ki ishi oye lo? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Ala bi iyi, kweyi ala tinarigwu lalo ala ba gbo gipu ko omama. Omaku ya yimu, ikpiye ke gekwu.&gt;&gt;<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Oki kwikye ge ebeni ki kyi inarigwu oni ta. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Ishini okwikye wa ni, oki wa ta awa ba gbola, ola nwuwiyi. Agyoza ni aba ka danu ni lo.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Okwikye ko omweta, oka da awa mo, &lt;&lt;Kwikyikyeni ala tayayo ba gbola? Ola na gbayi mani! Ishi ya wa. Ala ma, ayo Oyi ka Asuse ra da awine ko ozalabi wa. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ala nyiso, shini ahan ga! Ase ni yun ra ni ya wa ma!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s">Ayo Oyesu Kwu</para>
  <para style="r">(<ref loc="MAT 26:47-56">oMatiyu 26.47-56</ref>; <ref loc="LUK 22:47-53">oLuka 22.47-53</ref>; <ref loc="JHN 18:3-12">Oyohana 18.3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Oyipu kela ya ka, Oyahuda oye ipu ka ayikoko ko Oyesu igwepa, wa kpe ewa ka asuse nwashika, kpe ewakpa, kpe efu, ni anyakwase kpo oteyi ka awosapa, kpa awofono tuwo oleho.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Ase ni yo ra ni ka da awa oza ni oya ya ni. Oka da awa mo, &lt;&lt;Ase ni nkwo botu, anu pini ala ba yo ya kwu la.&gt;&gt; <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Ishini afu ebe ko Oyesu kweyi Oyahuda kamo, &lt;&lt;Inofoza!&gt;&gt; kweyi okwo botu. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Awase ni yo Oyesu kwu. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ebeni oye ipu kawase ni hagye ni ngme ewakpa kweyi yo oyole ko osapa nyakwu akpaha she.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Oyesu kamo, &lt;&lt;Ala bose kpe ewakpa, kpo efu ko wa yun kwu, byo nwwo owi? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Ebe ni ya nya kpiri nyyo kpa ala, nyya foza ipu kole ko Owuso, kweyi ala yun kwu lo. Omani gbodagye shini oza ni okpa ka ni na gya.&gt;&gt; <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Ebeni kpiri ka ananoho nyinya wa sho kweyi ga wa.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Isongo oye yo opa kweyi ya gboso Oyesu. Ishini ayo kwu ni, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ayikyi nu shu kweyi onyinya ewewa.<verse eid="MRK 14:52" /></para>
  <para style="s">Abyo Oyesu ge ebe ka Awonongbo</para>
  <para style="r">(<ref loc="MAT 26:57-68">oMatiyu 26.57-68</ref>; <ref loc="LUK 22:54-55">oLuka 22.54-55</ref>; 63-71; <ref loc="JHN 18:13-14">Oyohana 18.13-14</ref>; 19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Abyo Oyesu ge Ebe ko osapa nyakwu kpo oteyi ka awosapa, kpa anyakwase kpa awofono kweyi awa gbayi kpiri. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Obitrus gboso itikpi ebe lenu gipu kole ko osapa nyakwu, ebe ni oyagye kpa awase ni ba gbeho ni ya gyola.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Awosapa nyakwu kpa anyakwase ba labo ko oza ni aba ya abo abyo shini ana yo Oyesu ngmo ni, ake pye lo. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ase nwashika wa yo olobene kweyi oza ni aka ni kpiri we ela meme.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Ebeni ase shishini nyiso kela meme ikweyi nu mo: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Aha pwo oya kamo, &lt;Anu ya yo ole ko Owuso ni asuse ma ni ya yi kye shonu, kweyi ipu ke eno eta anu ya mo ohoha, wo olamu ni asuse ma ni lalo.&gt;&gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ipu ko olobene ni aka ni, akyogwu kpa anu lo.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Ebeni osapa nyakwu nyiso hagye obutu wa kweyi do Oyesu oka mo, &lt;&lt;Ogbo ojije ko ka lo? Pwo olobene ni awase mani ba ka ikweyi wo mani ke?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Oyesu ke ko ojije lo kweyi yagye nu kpo.</para>
  <para style="p" vid="MRK 14:61">Awosapa nyakwu ki doka mo, &lt;&lt;Awo wo Okristi la, Oyi kase neshi?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Oyesu kamo, &lt;&lt;Ami la, kweyi ala ba mo Oyi ka Asuse yagye abore ka Ada nyakwu kweyi ya wa ipu ko okpowuso.<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Osapa nyakwu yo oshiye nu sha. Kweyi okamo, &lt;&lt;Olobene ko oji nwashika na aha ba tikpo ke?&gt;&gt; <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Ala pwe ela ka arigbetu ni oka ni. Oji ni ala ma?</para>
  <para style="p" vid="MRK 14:64">Kpiri wa kamo oshu ko gekwu! <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Ebeni ashini wa ba tehe sho, ayo oza gbi iyi kweyi ba gwo kpo ayiki wa kweyi kamo, &lt;&lt;Bane daha!&gt;&gt; Awogbeho byo kweyi ga gwo.<verse eid="MRK 14:65" /></para>
  <para style="s">Obitrus Tawashu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">oMatiyu 26.69-75</ref>; <ref loc="LUK 22:56-62">oLuka 22.56-62</ref>; <ref loc="JHN 18:15-18">Oyohana 18.15-18</ref>; 25-27)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Ishini Obitrus yagye akpada ko oda ke epwo ni, oye ipu ka awoyole nonya ko osapa nyakwu we ebeni. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Ishini omo Obitrus ya gyola ni, oyi iyi kwo, kweyi do oka mo,</para>
  <para style="p" vid="MRK 14:67">&lt;&lt;Awo yo kpo Oyesu ko Onazaret. <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Anu ke tawashu mo, &lt;&lt;Ngyo oza ni oya ka ni lo,&gt;&gt; kweyi obose ga yo owofunu ke ekpa.&gt;&gt;<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Ishini oyole nonya mo ebeni ni, oki ka da awase ni bebeni mo, &lt;&lt;Ongo mani wo oye ipu wa.&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ebeni Obitrus otawashu.</para>
  <para style="p" vid="MRK 14:70">Ishi kee, awase ni bebeni kamo, ko okwokwoshi oye ebeni, awo wa ase ko Ogalili la.&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ebeni okwotu ko si iyinu esa, kpe ene gwogwa da awa mo, &lt;&lt;Ngya ase ni ala ba kela ikweyi nu ni lo.&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Ebebeni obogwu tono ko omwepa. Ebeni Obitrus rela ni Oyesu ka danu ni mo, &lt;&lt;Ome obogwu na tono igbepa, oya tawashu hin igbeta. Ni orela mani ni okwotu ko kyegba.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Abyo Oyesu go Obutu ko Obilatus</para>
  <para style="r">(<ref loc="MAT 27:1-2">oMatiyu 27.1-2</ref>; 11-14; <ref loc="LUK 23:1-5">oLuka 23.1-5</ref>; <ref loc="JHN 18:28-38">Oyohana 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ototukpokyi oteyi ka awosapa kpa anyakwase, kpa awofono kpa awonongbo ga gbela. Ayo Oyesu gbo, kweyi abyo ga yi do Obilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Obilatus do oka mo, &lt;&lt;Awo wo ose ka Ase ko Oyahuda la?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Oyesu kyogwu mo, &lt;&lt;Olemani, byoni oka ni.&gt;&gt;<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Oteyi ka awosapa danu epwo labi nwashika. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Ebeni Obilatus ki do oka mo, &lt;&lt;Oya kyogwu lo? Me epwo labi nwashika ni aba ka ikweyi wo ni.&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Oyesu ke ko ojije lo, kweyi igbashi yo Obilatus kwu.<verse eid="MRK 15:5" /></para>
  <para style="s">Ayo Oyesu Poshi</para>
  <para style="r">(<ref loc="MAT 27:15-26">oMatiyu 27.15-26</ref>; <ref loc="LUK 23:13-25">oLuka 23.13-25</ref>; Oyohana 18.39-19,16)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Okwobonu wodu, ni ishi kimya aba ngma ashe ipu ko oruduru ni ase doka ni. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ongo oye ni iyenu wo Obaraba ni ayo kwu to oruduru, kpa awi kpo ozogye ni yo ozalabi ko ngma ase ishini aba sha awa ni. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ewa ka asuse we ebe ko Obilatus wa doka ko oza ni aba yimu shini ona ya da awa ishi kpiri ni.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Obilatus duwoka mo, &lt;&lt;Ala ba yimu shini na sho ose ka Ase ko Oyahuda bita da ala?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Ogye mo ipu ka anya yoya pini oteyi ka awosapa yo Oyesu nabo danu la. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Awoteyi ka awosapa ya te ewa ikpo mo Obilatus na sho Obaraba bita da awa.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Obilatus duwoka mo, &lt;&lt;Na ya moji kpase ni aba yogwu mo ose ka Ase ko Oyahuda ni?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Azo oko iso nwa kamo, &lt;&lt;Ana yo poshi.<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Obilatus duwoka mo, &lt;&lt;Oji labi ni oya?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Angmegba mo, &lt;&lt;Ana yo poshi!&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Obilatus yimu ko yo oza ni ewa ba yimu ni, osho Obaraba bita da awa. Oma ana yo Oyesu aboshi kweyi yo nabo da awa shini ana yo poshi.<verse eid="MRK 15:15" /></para>
  <para style="s">Awadakare Sho Oyesu Enyo</para>
  <para style="r">(<ref loc="MAT 27:27-31">oMatiyu 27.27-31</ref>; <ref loc="JHN 19:2-3">Oyohana 19.2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Awadakare byo Oyesu gekpa ko onongbo kweyi aya awadakare kpiri ogwu. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Akpo obagidi shooko kweyi aligye byozakeyi kose kweyi yi liikweyi. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Kweyi akwotu ko to ogbogba mo, &lt;&lt;Abaga, ose ka Ase ko Oyahuda!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Kweyi aki ba gwo ikweyi kpo okposhi, aki tehe sho. Akwagye kpo okinafu wa obutu nu, kweyi ba geyagye danu. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Ishini aye eye kweyi ni, ayo obagidi ngma sho kweyi akpo oshiye nu sho oko. Kweyi abyo ge ebeni aba ga yo poshi ni.<verse eid="MRK 15:20" /></para>
  <para style="s">Ayo Oyesu Poshi</para>
  <para style="r">(<ref loc="MAT 27:32-44">oMatiyu 27.32-44</ref>; <ref loc="LUK 23:26-43">oLuka 23.26-43</ref>; <ref loc="JHN 19:17-27">Oyohana 19.17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Ongo oye bwo Osiri, iyenu wo Osimo Ada ka Alekzanda kpo Orufu wa shigbo, abyo ko otiri mo ona zo oshi ko Oyesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Abyo Oyesu ge ebye ni aba yo ogwu mo Ogolgota ni. Ikweyi nu wo Ebe ko Okpokwu ki Ikweyi. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Ebeni adanu inyi wowa ni ashe eshi anu ni, oke tela ko gwa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Kweyi ayo poshi. Ayo oshiye nu yi ko, awe eba shini ana mo oza ni ananoho ya pye ni.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Ayo poshi ogye ahane ko otukpokyi. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Atenena ke epwo labi nu yi pi iso ko oshi mo: OSE KA AWOYAHUDA. <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Ayo awi epa poshi kpa anu dudu, oye ya abore, oye aboshe nu. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Omani shini ela kawo bane na gya mo, &lt;&lt;Ayo ka ti ipu ka awinozalabi.&gt;&gt; <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Awase ni ba shigbo ni ye eye kweyi ba ji ikweyi ba kamo, &lt;&lt;Awo! Mo oya yo ole ko Owuso ya kye kweyi ya kyanu ya ma ipu ke eno eta, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />sa bwo oshi wo okpagye shini ongmi iyo!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Mamani, oteyi ka awosapa kpa awofono ba ye eye mo, &lt;&lt;Ongma ase shishini, oke gege ko ngmi iyinu lo! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Okristi, Ose ki Izrayila, na sa sho oshi na wo okpagye shini ahan ma, kweyi aha ba kyogwu.&gt;&gt; Awase ni ayuwa poshi kpa anu ni ki sesa.<verse eid="MRK 15:32" /></para>
  <para style="s">Ikwu ko Oyesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">oMatiyu 27.45-56</ref>; <ref loc="LUK 23:44-49">oLuka 23.44-49</ref>; <ref loc="JHN 19:28-30">Oyohana 19.28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Bwe eno weyi, ebe kpiri dibu okpagye ni go ogyeta ki isheno. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Kweyi ogyeta, Oyesu kyegba kpo oko nwa mo, &lt;&lt;Eliyo, Eliyo, lama sabatani?&gt;&gt; ikweyi nu wo, &lt;&lt;Owuso hin, Owuso hin, ojiya ni opyitikpi tun?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Ishini awase ni hagye ebeni pwo oza ni oya ka, akamo, &lt;&lt;Ala ya akpaha tagye oya yi Iliya ogwu.&gt;&gt;<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Ashe ipu wa nyinya ga zo ko gbi ikpiye kweyi yi linyo wowa kweyi yi lo okposhi do Oyesu mo ona gwa. Oka mo, &lt;&lt;Ala shobita, shini ahan ma kwe Iliya ya wa sa nu lo.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Oyesu ngmegba nwa, kweyi ogbo layi ko ogwejeji.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Ebeni ayikyi kofunu oda sha bwi iso wa geye. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Ishini oteyi ka adakare ni hagye ebeni ma mani ni, okamo, &lt;&lt;Ko okwokwoshi ongo mani wo Oyi ko Owuso la!&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Ishi oni anya oye hagye ebe lenu ba mo oza ni ya gbodagye ni. Anya ni be ebeni ni wo Omeremu bwa agye ko Omagdalin kpo Omeremu ene ko Oyakubu leke kpo Oyosi kpo Osalomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Bwo Ogalili, anya mani gboso kweyi aba danu oza ni oya yimu ni. Anya nwashika ni gboso bwo Ojerusele ni be ebeni.<verse eid="MRK 15:41" /></para>
  <para style="s">Ayo Oyesu yi Nyi</para>
  <para style="r">(<ref loc="MAT 27:57-61">oMatiyu 27.57-61</ref>; <ref loc="LUK 23:50-56">oLuka 23.50-56</ref>; <ref loc="JHN 19:38-42">Oyohana 19.38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Owe eno ko kyatu, eno ni gbe ebenya nu we Eno ko Minyo ni. Ni eno sha ni, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Isu bwo ogya ka Arimatiya, owo oye ipu ka awonongbo, oya gbeyi ko obula ko Owuso na wa, odi iyinu oshu ge ebe ko Obilatus ga doka ko okwu ko Oyesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Igbashi yo Obilatus kwu ni opwo mo ogekwu ni. Oya adakare oni ogwu kweyi doka kwe Oyesu gekwu wa. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Ishini opwo bwe ebe ka adakare mo ogekwu ni, oyo okwu nu yi do Isu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Isu ga ro opa, oyo okwu to opa kweyi oyo okwu yi nyi amiri ni abwu ipu ko okpo ni. Ebeni oso okpo ni abo yo okwunu ka amiri yi gwu. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Omeremu bwa agye ko Omagdalin kpo Omeremu ene ko Isu me ebe ni ayo okwu nu yi nyi ni.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Oyesu Nyiso Amiri</para>
  <para style="r">(<ref loc="MAT 28:1-8">oMatiyu 28.1-8</ref>; <ref loc="LUK 24:1-12">oLuka 24.1-12</ref>; <ref loc="JHN 20:1-10">Oyohana 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Ishini Eno ko Minyo kweyi ni, Omeremu bwagye ko Omagdalin kpo Omeremu ene ko Oyakubu kpo Osalomi ga rano kpehe shini ana ga nyo Oyesu ikpiye. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Ototukpokyi ke eno kikyikyo ipu ko obize, ni eno bose ni, akwowe ko gebe ka amiri <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />kweyi aba diyiwa oka mo, &lt;&lt;Ipu ka aha, anoho ya jo okpo sho okwunu ka amiri?&gt;&gt;<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Ishini ake ziyi iso, amo okpo nyakwu mani, ayi ja go okoka. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Ni agipu ka amiri ni, ami isongo oye sho oshiye nehe yagye abore, ebeni oshi yuwa kwu. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Oka dawa mo, &lt;&lt;Ala ka yoshi lo, ala ba labo ko Oyesu ko Onazaret, ni ayo poshi ni. Onyiso! Oyebeni lo. Ala wa mebe ni ayo nyi ni. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ala ke ga ka da awogboso kpo Obitrus mo, &lt;Oyohobu kala ya go Ogalili oma. Ala ba ga mo ebeni byoni oka dala ni.&gt;&gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Ebeni oshi yuwa kwu kweyi aba wode, abose bwa amiri kpenya. Aka da ashishe lo, ikweyi koni aba yo oshi ni.<verse eid="MRK 16:8" /></para>
  <para style="s">Oyesu Bose do Omeremu bwa agye ko Omagdalin</para>
  <para style="r">(<ref loc="MAT 28:9-10">oMatiyu 28.9-10</ref>; <ref loc="JHN 20:11-18">Oyohana 20.11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Ishini Oyesu nyiso eno kikyikyo ko obize ni, ase ni mo ikyikyo ni wo Omeremu bwagye ko Omagdalin, anu ni Oyesu ngmo omaku bibi ahapa sho ni. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Obose ga ka dawase ni bagye kpa anu ni kweyi aba byotu ba kyegba. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Ishini awogboso pwo oshu ko nyiso ko Oyesu ni, akyogwu lo.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Ni okela kweyi ni, Oyesu ki bose dase epa gogo ishini aba yawu ogya ni. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Awa ni kwikye itikpi ga ka dase shishini wa, ashishe ke kyogwu kpela ni lo.<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Itikpi ko omani, Oyesu bose wa shiyinu da awogboso igwoye ishini aba roza ni; ogbuweha ikweyi koni agbo otuse lo ni kpa akpaha zoze wa ikweyi koni atela ko kyogwu kpela kawase ni mo ni.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Oka dawa mo, &lt;&lt;Ala gipu kese kweyi, ala ga tono ko oshu neshi dasuse kpiri. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Ase ni kyogwu kweyi ayo obatisma aba yi gbo, ase ni ke kyogwu lo, aba danu owe. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Kweyi ase ni kyogwu kpami, awoza mani kpiri ba gboso: Ipu kiye hin aba ngma awomaku bibi, aba kela ipu kawose pepe; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />aba kwegwa kpa abo; kweyi ishini agwefa oya yuwa ojije lo. Aba ya abo ya sa awase ni ba gbere ni, kweyi aba pyo ogege.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Ishini Adole Oyesu kela mani dawa ni, ayo bize giso kweyi ga yagye abore ko Owuso. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Ebeni Awogboso bose gese kweyi ga tono ebebe nya, kweyi Adole yo kpawa bwebe kela koka wa kpo oza ki igbashi nwashika ni aya ni.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>