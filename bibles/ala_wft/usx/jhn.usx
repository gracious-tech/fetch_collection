<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">ALAGO BIBLE</book>
  <para style="h">Oyohana</para>
  <para style="toc1">Oshu Neshi bwabo ko Oyohana</para>
  <para style="toc2">Oyohana</para>
  <para style="toc3">Oyh.</para>
  <para style="mt2">Oshu Neshi bwabo ko</para>
  <para style="mt1">Oyohana</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Ela wa Asuse</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Bwikyikyo Ela yaba, Ela mani yo kpo Owuso, kweyi Ela mani wo Owuso. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Oyo kpo Owuso bwikyikyo.<verse eid="JHN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3" />Bwebe nu ayojoji kpiri, bwebe nu lalo abiba yojije lo. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Olayi yipu nu, kweyi olayi mani webe yoyu kasuse. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Ola mani yayu ipu kebe dibu, ebedibu ke gege yogwu lo.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Ongo oye ni Owuso toleho ni wa, iye nu wo Oyohana. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Owa ko wa yolobene kebeyoyu, shini bwebe nu asuse kpiri na kyogwu kpanu. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Anu abiyinu pini webeyoyu lalo; owa kin kowa yolobene kebeyoyu la. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Ebeyoyu ko kwokwoshi wa yu dase kpiri ni bipu kese ni.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Oyipu kese, kweyi bwebe nu pini ayese la, ase kese ke gyo lo. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Owebe kase nu, ake tela ko zo. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Kwikyikyeni kpiri kase ni zo ki kyogwu kpiye nu ni, odawoshu ko wayi ko Owuso. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Awayi moma kasuse kwe akimu kotu kasuse lalo, ke womoma ko Owuso la.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Ela mani wa wasuse kweyi yagye ipu kaha. Aha migyashi nu, igyashi koni anu fufunu wo Oyi ka Ada ni, oki nwonwu kponeshi kpokwokwoshi.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Oyohana yolobene ikweyi nu. Okela kpoko nyakwu kamo, &lt;&lt;Anu mani pini wase ni nkela ikweyi nu ni la, &lt;Anu ni yawa itikpi hin ni shun, ikweyi koni oyaba kwobonu dami.&gt;&gt;&gt; <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />Bwebe ko oneshi nu pini kpiri ka aha pya aboneshi ni gbo kweyi lo ni. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Owuso daha ono bwebe ko Omusa; oneshi kpo okwokwoshi bwebe ko Oyesu Okristi. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Ashishe mo Owuso ebyibye lo, Oyi nu fufunu pini mo la, ni woye kponu kpa Ada ni, oyase gyo.<verse eid="JHN 1:18" /></para>
  <para style="s">Oyohana Ino Obatisma Kamo Anu wo Omezaya Lalo</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Omani wolobene ko Oyohana ishini awoteyi ko Oyahuda ko Ojerusele tawosapa kpayi ko Olawi oleho shini ana doka kase ni owe ni. <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Oyohana ke tawashu lo, okyogwu mo, &lt;&lt;Ami wo Omezaya lalo.&gt;&gt;<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Adooka mo, &lt;&lt;Awo wanoho? Owi Iliya la?&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">Okamo, &lt;&lt;Ami lalo.&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">&lt;&lt;Owi Inobane la?&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">Okamo, &lt;&lt;Aayi.&gt;&gt;<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Ogwejeji akamo, &lt;&lt;Awo wa anoho? Ka daha shini ahan ga ka dawase ni taha oleho ni. Oji ni oka ikweyi kiyo?&gt;&gt;<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Oyohana kyogwu bwipu kela kinobane Ishaya mo, &lt;&lt;Ami woko ni ya yogwu ipu kododa ni ya kamo, &lt;Kyowe tiriri da Adole.&gt;&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false">Ishaya 40.3</char></note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Bwebe ni Awofarisi ni atuwoleho ni <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />doka mo, &lt;&lt;Ojiya ni oyase obatisma owoni owo Omezaya kwi Iliya kwinobane lalo?&gt;&gt;<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Oyohana kamo, &lt;&lt;Nyya yo obatisma kpinyo, ashe ke hagye ipu kala ni ala gyo lo ni. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Anu pini ya wa itikpi hin la, ni ogwa kokpabawu nu, nggye ko yiyi lo.&gt;&gt;<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Kpiri koza mani gbodagye Obetani agbabo kishu ko Ojoda, ebe ni Oyohana ya yase obatisma ni.<verse eid="JHN 1:28" /></para>
  <para style="s">Oyi ko Otukpo ko Owuso</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Gbebenya Oyohana mo Oyesu ya webe nu kweyi okamo, &lt;&lt;Ala mo Oyi ko Otukpo ko Owuso, anu ni ya wa zozalabi kese ni! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Anu pini wase ni nyya kela ikweyi nu mo, &lt;Ase ni yawa itikpi hin ni shun, ikweyi koni oyaba kwobonu dami.&gt; <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ami abiyun gyoo lo, oza ni ya ni nke ya yobatisma kpinyo ni oma shini ana yo shiyase ki Izrayila.&gt;&gt;<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Ebeni Oyohana yolobene mo, &lt;&lt;Nmo Omaku sa bwiso wokpagye byo otitiribi ni kweyi wa kwikpiye nu. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ami gye mo owanu lo, ase ni tumoleho ko yo obatisma kpinyo ni pini ka dami mo, &lt;Ase ni omo Omaku sa ikweyi nu, anu pini yawa yo obatisma kpo Omaku ko Owuso la.&gt; <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Nma kweyi nkyogwu mo Oyi ko Owuso pini yoma.&gt;&gt;<verse eid="JHN 1:34" /></para>
  <para style="s">Awogboso Oyesu ki Ikyikyo</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Gbebenya, Oyohana kpa awogboso epa hagye. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Ishini omo Oyesu ya shigbo ni, okamo, &lt;&lt;Ala mo Oyi ko Otukpo ko Owuso!&gt;&gt;<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Awogboso epa mani pwoza ni oka ni kweyi agboso Oyesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Oyesu pyiyi kweyi omuwa ba gboso, kweyi oduwoka mo, &lt;&lt;Oji ni ala ba yimu?&gt;&gt;</para>
  <para style="p" vid="JHN 1:38">Akamo, &lt;&lt;Inofoza, ebenya ni oyo?&gt;&gt;<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Okyogwu mo, &lt;&lt;Ala wa, ala ba ma.&gt;&gt;</para>
  <para style="p" vid="JHN 1:39">Aga kweyi aga mebe ni oya nu ni, abo kogye ene konose kweyi abagye kpanu dudu eno ni.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Andru, oyene ko Osimo Obitrus woye ipu kawogboso Oyohana epa ni pwela ni Oyohana ka kweyi gboso Oyesu ni. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Oza kikyikyo ni Andru ya ni, oga tikpo ko oyinanu Osimo kweyi ka danu mo, &lt;&lt;Aha pyo Omezaya, Okristi.&gt;&gt; <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Obyo gebe ko Oyesu.</para>
  <para style="p" vid="JHN 1:42">Oyesu tiyi mo kweyi okamo, &lt;&lt;Awo wo Osimo, oyi ko Oyohana. Aba yogwu mo Okefas. Ni woye kponu kpo Obitrus ni, ikweyi nu wo &lt;&lt;okpo.&gt;&gt;<verse eid="JHN 1:42" /></para>
  <para style="s">Oyesu yo Ofilibus kpo Onataniyel Ogwu</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Gbebenya Oyesu go Ogalili. Kweyi ogebe ni Ofilibus yanu ni oka danu mo, &lt;&lt;Gbosun.&gt;&gt;<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Ofilibus kpa Andru kpo Obitrus wase kogya ko Obetseda. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Ofilibus mo Onataniye, kweyi oka danu mo, &lt;&lt;Aha mase ni Omusa kela ikweyi nu ipu kokpa ko Ono, kpa kawo bane ni mo, Oyesu ko Onazareti, oyi ki Isu.&gt;&gt;<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Onataniye dooka mo, &lt;&lt;Oje neshi ya bose bwo Onazareti?&gt;&gt;</para>
  <para style="p" vid="JHN 1:46">Ofilibus kamo, &lt;&lt;Wa shini oga ma.&gt;&gt;<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Ishini Oyesu mo Onataniye ya webe nu ni, oka danu mo, &lt;&lt;Ala mase ki Izrayila ko okwokwoshi, ni ya gyashishe egya lo ni.&gt;&gt;<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Onataniye dooka mo, &lt;&lt;Oyamoji gyun?&gt;&gt;</para>
  <para style="p" vid="JHN 1:48">Oyesu kyogwu mo, &lt;&lt;Ome Ofilibus na yoogwu, nmoo yotu kefu ko Ofigi.&gt;&gt;<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Onataniye ka danu mo, &lt;&lt;Inofoza, awo wo Oyi ko Owuso la; Ose ki Izrayila.&gt;&gt;<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Oyesu kamo, &lt;&lt;Okyogwu ikweyi koni nka dawo mun moo yagye otu kefu ko Ofigi ni? Oya wa mawoza nwashika ni shomani ni.&gt;&gt; <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Ebeni okamo, &lt;&lt;Nyya ka dala okwokwoshi, ala ba miso gwogwa, kweyi ayoleho ko Owuso ba toshi ba sa ikweyi ko Oyi ka Asuse.&gt;&gt;<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Imya ko Onyape Okana ko Ogalili</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Eno ko omweta ayonyape ogya ko Okana ipu ko Ogalili. Kweyi ene ko Oyesu yebeni, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />kweyi apo Oyesu kpawogboso ebe konyape. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Ishini inyi kweyi ni, ene ko Oyesu ga ka danu mo, &lt;&lt;Agbinyi kelo.&gt;&gt;<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Kweyi Oyesu ka danu mo, &lt;&lt;Ene, onya wakakahin? Ishi hin gye wa lo.&gt;&gt;<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Inanu ka dayole mo, &lt;&lt;Oza ni oka kpiri ala ya.&gt;&gt;<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ebeni epwo kinyo ihiri ni ama kpa akyo hagye ebe ni, ko yodu kikpiye nona ka Ase ko Oyahuda, ibwu kepwo mani ya gogya awepa kwe aweta.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Oyesu ka dayole mo, &lt;&lt;Ala shinyo nwawepwo mani.&gt;&gt; Kweyi ashi nwuwa sururu.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Ebeni oka dawa mo, &lt;&lt;Ala shi ga dorogwu koka kimya.&gt;&gt;</para>
  <para style="p" vid="JHN 2:8">Aya mani, <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />kweyi orogwu koka kimya gwinyo ni ayi pya winyi mani. Ogyebe ni abyinyi mani bwanu wa ni lo, ayole ni byinyi wa ni pini gye la. Ebeni, oyoba konyape ogwu gokoka, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />kweyi okamo, &lt;&lt;Aba dase inyi neshi ba gwa ikyikyo ome la, kweyi ishini awogboga kwobonu gwa nwashika ome aba byoni shoshi fakikyikyo lo ni ya wese. Awo ke yinyi neneshi yi teba wishi mani ome obi wese.&gt;&gt;<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Omani pini woza kigbashi kikyikyo ni Oyesu ya Okana ko Ogalili ni la. Bwebe ni oyigyashi nu yi tese, kweyi awogboso kyogwu kpanu.<verse eid="JHN 2:11" /></para>
  <para style="s">Oyesu Kyo Ole ko Owuso tu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Bwebeni Oyesu gogya ko Okapanahu kpinanu, ayinanu kpa awogboso, kweyi aga bebeni keno gbayayi. <verse eid="JHN 2:12" /><verse number="13" style="v" sid="JHN 2:13" />Ni ishi ki Imya ko Sheyi ka Ase ko Oyahuda yo pee ni, Oyesu go Ojerusele. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Ipu ko Ole ko Owuso omase ba tora kena, kpikpowu kpo otitiribi, kpa ashishini kase boka ba pyikwiri. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Ongogwa kaboshi kweyi onuwenya shipu ko Ole ko Owuso, kpikpowu kpena. Oki sawoka kawo pyikwiri abo, oki yuwikwiri yi myonu. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Oka da awotora ko otitiribi mo, &lt;&lt;Ala yawoza mani kpo shebe ni! Ala ka yo Ole ka Ada hin yi pya wipishi lo.&gt;&gt;<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Awogboso ra ipu kotu wa mo akwobonu yi tota mo, &lt;&lt;Imu ni nggbo do Ole wo ni ya yun byo ola ni.&gt;&gt;<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Ebeni Ase ko Oyahuda doka mo, &lt;&lt;Oyi koji ni oya shiyaha shini an gye mogboshu ko yoza kpiri?&gt;&gt;<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Oyesu kyogwu mo, &lt;&lt;Ala yo Ole ko Owuso mani yi kye, nyya kyanu ya ma eno eta.&gt;&gt;<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Awoyahuda kyogwu mo, &lt;&lt;Ozaha ishayi awene ayihiri ome aha mo Ole ko Owuso mani la, kweyi omo oya kyanu ya ma ipu keno eta?&gt;&gt; <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Ole ko Owuso ni Oyesu ya kela ikweyi nu ni wikpiye nu la. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Ishini onyiso amiri ni, awogboso rela koza ni oka ni. Ebeni akyogwu kpoza ni Okpa ka ni, kpela ni Oyesu kwobonu ka ni.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Ishini oyogya ko Ojerusele ebe ki Imya ko Sheyi ni, ase nwashika mawoza kigbashi ni oya ni aki kyogwu kpanu. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Oyesu ke ziyinu dawa abo lo, koni ogyoza ni kpiri wa we ni. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Oya doka shini ashishe na koza ni awe ni danu lo, ikweyi koni anu abiyinu gyoza ni yotu wa ni.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Oyesu Fo Onikodemus Oza</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Agbo ongo ko Ofarisi oye iyenu wo Onikodemus, owo oye ipu kawoteyi konongbo ka Ase ko Oyahuda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Owebe ko Oyesu otu kweyi kamo, &lt;&lt;Adole, agye mo owinofoza ni bwebe ko Owuso ni la. Koni ashishe ya gege ya yoza kigbashi ni oya ya mani lo, owoni Owuso yo kpanu la lo.&gt;&gt;<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Oyesu ka danu mo, &lt;&lt;Nyya ka dawokwokwoshi, ashishe ya gobula ko Owuso lo, owoni akyanuma lalo.&gt;&gt;<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Onikodemus dooka mo, &lt;&lt;Owe wonya ni aki ba kyase ni sawukye ni ma? Kwe oya kwikye ya gipu kinanu shini ana kyanuma komwepa la?&gt;&gt;<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Oyesu kyogwu mo, &lt;&lt;Nyya ka dawo kwokwoshi, ashishe ya gipu ko obula ko Owuso lo, owoni akyanu ma kpinyo kpo Omaku lo. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Omoma kikpiye wikpiye la, omoma ko Omaku ke wo Omaku la. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ona ka woza kigbashi dawo koni nkamo, &lt;Owotiri shini ana kyawoma ni lo.&gt; <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Owu ya ta gebe ni shootu ni. Ala ba pweya nu, ala ke ba gyebe ni obwanu wa kwebe ni oya ga ni lo. Oya lemani kpananoho ni amoo ipu ko Omaku ni.&gt;&gt;<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Onikodemus dooka mo, &lt;&lt;Omani ya gbodagye moji?&gt;&gt;<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Oyesu kamo, &lt;&lt;Owi inofoza ki Izrayila la, kweyi awo gyawoza mani lo?&gt;&gt; <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Nyya ka dawo okwokwoshi, aha koza ni agye ni, kweyi aha ba yolobene koza ni aha ma ni, kwikyikyeni ala ke kyogwu kpolobene kaha lo. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Nkela dala ikweyi koza kese mani kweyi ala kyogwu lo; ala ba yamoji ba kyogwu owoni nkela koza ni yiso ni? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Ashishe giso ebyibye wa lo, so Oyi ka Asuse ni bwi iso wa ni. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Byoni Omusa zegwa iso ipu kododa ni, mamani oya wotiri shini ana zo Oyi ka Asuse iso, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ikweyi koni kpiri kase ni kyogwu kpanu oya pyolayi ko gbogbo-gbogbo.<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />&lt;&lt;Koni Owuso yimu kese ni, otoleho kpo Oyi nu oye kpokponu, kpiri kase ni totuso Oyi nu oya gekwu lo, oke ya yiyi ko gbogbo-gbogbo. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Owuso to Oyi nu oleho wese mani ko yese yishi la lo, pa shini ona ngmese bwebe nu la. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Kpiri kase ni kyogwu kpanu aba kweepwo lo, ase ni ke kyogwu kpanu lo akwobonu kweepwo ikweyi koni okyogwu kpiye ko Owuso kpo Oyi nu fufunu lo. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Epwo koka ya lema: Oyoyu wese mani, ase ke ba yimu kebedibu shoyoyu, ikweyi koni oko wa woza bibi ni. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Kpiri kase ni ya yoza bibi ya tela kebe yoyu, kweyi ya webeyoyu lo, mani oni aba sha bebeyoyu lo, oya yoshi koni otu nu ya tese ni. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Kpiri kase ni ke ya yo kwokwoshi ya webe yoyu, shini ana ma ese kyaa koni oza ni oya kpiri ni yobutu ko Owuso la.&gt;&gt;<verse eid="JHN 3:21" /></para>
  <para style="s">Oyesu kpo Oyohana Ino Obatisma</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Itikpi koni, Oyesu kpa awogboso bose gagye ko Ojudiya, ebeni oyagye kpawa kishi gbayayi kweyi ya yase obatisma. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Ishi oni Oyohana ya yo obatisma mamani ogya ka Ayinon ni yo pee kpo Osalimu ni, kweyi inyo nwashika ebe ni, kweyi ase ba wa shini ana yuwo obatisma. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Oza mani gbodagye ome ayo Oyohana kwu toruduru la. <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Ebeni awashu loshu nyiso obepa kawogboso Oyohana kpase ko Oyahuda oye ikweyi ko odu kikpiye nona. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Awebe ko Oyohana kweyi wa ka danu mo, &lt;&lt;Inofoza, ongo ni yo kpawo agbabo ki ishu ko Ojoda, anu ni okela ikweyi nu oni, oya yase obatisma, kweyi ase nwashika ba gebe nu.&gt;&gt;<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Oyohana kyogwu mo, &lt;&lt;Ashishe ya gege ya yojije lo soza ni adanu bwiso ni. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Ala abiyikala wolobene hin ni nka mo, &lt;Ami wo Omezaya lalo, ake tumoleho yohobu nu la.&gt; <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Onyape wakoba konyape la. Oya koba konyape ya gbeyi nu kweyi ya pwela nu, kweyi otu nu ya sha nwashika ishini opwoko koba konyape. Otu shosha mani wakakahin la, kweyi nabani ogya wa. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Owotiri shini anu na gye gohobu, ami na kwikye itikpi.&gt;&gt;<verse eid="JHN 3:30" /></para>
  <para style="s">Ase ni Wa Bwi Iso ni</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />&lt;&lt;Anu ni wa bwi iso ni shananoho; ase ni yese wa kese la, oki ya kela byase kese. Ase ni wa bwiso ni shananoho kpiri. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Oyolobene ko oza ni oma kpo oza ni opwo ni, ashishe ke kyogwu kpolobene nu lo. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Awase ni zela nu kyogwu mo Owuso wokwokwoshi. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ase ni Owuso toleho ya kela ko Owuso, koni Owuso danu Omaku ni gbo okweyi lo ni. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Ada yimu ko Oyi nu kweyi oyo ojoji yi danu abo. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Kpiri kawase ni kyogwu kpo Oyi ko Owuso, aba pyo olayi ko gbogbo-gbogbo. Kpiri kase ni ke tela ko Oyi ko Owuso aba pyo olayi lo, koni anya ko Owuso yikweyi wa.&gt;&gt;<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Oyesu Kela kpo Onya ko Osamariya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Awofarisi pwo mo, Oyesu ya pya awogboso nwashika sho Oyohana kweyi oki ya yuwa obatisma, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Oyesu abiyinu pini ya yo obatisma lalo, awogboso pini ba ya la. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Ishini Oyesu pwoza ni aba ka ikweyi nu ni, osho ojudiya bita kweyi go Ogalili.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Owotiri danu ko bwagye ko Osamariya. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Owa gogya oye ipu ko Osamariya ni aba yo ogwu mo Osayika ni yo pee kpo okpagye ni Oyakubu doyi nu ki Isu ni. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ibwu ko Oyakubu yebe ni, Oyesu nwa bwi iyawu, owa yagye ebe ki ibwu oni. Ishini eno weyi ni.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Ishini onya ko Osamariya wa ko shinyo ni, Oyesu ka danu mo, &lt;&lt;Dami inyo na gwa.&gt;&gt; <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Awogboso gipu ogya ko ga roza rore.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Onya ko Osamariya oni ka danu mo, &lt;&lt;Awo wase ko Oyahuda ami wo onya ko Osamariya. Bwowe wonya ni oya dumoka ki inyo ko gwa? Koni Ase ko Oyahuda kpo Osamariya ba gbayi lo ni.&gt;&gt;<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Oyesu ka danu mo, &lt;&lt;Owoni obigye eshi ko Owuso kpase ni ya doka kinyo mani, obi doka shini ona dawo inyo ko olayi.&gt;&gt; <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />Onya ni ka danu mo, &lt;&lt;Adole, oke gbidu kpogwa ko shinyo lo, ibwu mani libu. Ebenya ni oya pyinyo ko olayi mani? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Awo shosoku kaha ko Oyakubu, ni bwibwu mani daha kweyi anu kpayi nu gwa kpo obize nu kpa awogbeho ko obize ni la?&gt;&gt;<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Oyesu kamo, &lt;&lt;Kpiri kase ni gwinyo mani igyini kiya ngmo, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />ase ni ke gwinyo ni ami ya dase ni, igyini ya ngmo ebibye kelo. Inyo ni ami ya danu mani ya bwi ibwu ni yapo ko olayi ko gbogbo-gbogbo ni.&gt;&gt;<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Onya mani ka danu mo, &lt;&lt;Adole, da ami inyo mani shini igyini naka ngmun kelo kweyi shini naka wa shinyo ebe ni kelo.&gt;&gt;<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Oyesu ka danu mo, &lt;&lt;Ga byo obu wo wa.&gt;&gt;<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Onya ni ka danu mo, &lt;&lt;Ngbo oba lo.&gt;&gt; Oyesu ka danu mo, &lt;&lt;Oko okwokwoshi ni omo ogbo oba lo ni. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Oza ni oka ni wokwokwoshi la, ogbo oba eho, kwa ase ni oyo kpa anu byonabani wo oba wo lalo.&gt;&gt; <verse eid="JHN 4:18" /><verse number="19" style="v" sid="JHN 4:19" />Onya ni kamo, &lt;&lt;Adole, omoma hin owi inobane la. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Awosoku ka aha geyagye do Owuso ikweyi kefu mani, ala Ase ko Oyahuda ke ba kamo ebe ni ashu ko geyagye do Owuso ni wo Ojerusele.&gt;&gt; <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />Oyesu ka danu mo, &lt;&lt;Onya kyogwu kpa ami, ishi yawa ba ni ala ba geyagye da Ada ikweyi kefu mani kwo Ojerusele kelo. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Ala Osamariya ba geyagye doza ni ala gye lo ni, aha ke ba geyagye doza ni aha gye ni, koni inongmase bwebe ka Ase ko Oyahuda la. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ishi ke yawa ba, kweyi owa wa ni awo geyagye ko okwokwoshi ba geyagye da Ada ipu ko Omaku kpo okwokwoshi, ikweyi koni awedo kawo geyagye ni Ada ya yimu ni. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Owuso wo Omaku, kweyi owotiri shini ana geyagye danu ipu ko Omaku kpo okwokwoshi.&gt;&gt;<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Onya ni kamo, &lt;&lt;Ngye mo Omezaya ni aba yogwu mo Okristi ya wa ba. Ishini owa, oya owa gwi ikweyi ko ojoji daha.&gt;&gt;<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Ebeni Oyesu ka danu mo, &lt;&lt;Ini ko kela kpa awo mani, pini wo Omezaya la.&gt;&gt;<verse eid="JHN 4:26" /></para>
  <para style="s">Awogboso Oyesu Wa Tanu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Ishini awogboso kwikye bwipu ogya wa ni, igbashi yuwa kwu kotata koni awa tanu ya kela kpo onya ni. Ashishe ke doka mo, &lt;&lt;Oji ni oya yimu? Kwe ojiya ni oya kela kpanu?&gt;&gt;<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Ebeni onya mani sheyi kinyo nu bita, kweyi okwikye gogya ga ka dase kpiri mo, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />&lt;&lt;Ala wa mo ongo ni koza ni nyya ni kpiri. Kwe anu pini wo Omezaya la?&gt;&gt; <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Ananoho shipu ko ogya bita kweyi bose gebe ko mo Oyesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ebeni awogboso bo mo, &lt;&lt;Inofoza, zoza shini ore.&gt;&gt;<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Anu ke ka da awa mo, &lt;&lt;Ngbo ozarore ni ala gye lo ni.&gt;&gt;<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Awogboso diyiwa oka mo, &lt;&lt;Kwashe byo ozarore wa danu la?&gt;&gt;<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Oyesu kamo, &lt;&lt;Ozarore hin wa ko yo oza kotu kase ni tumoleho ni, kweyi na yoko nu kweyi. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Ala gye mo, &lt;Izire ya yo oya ene ome aba yi kye la lo&gt;? Nyya kadala, ala tiyi meho! Izire ze ko kyokye wa. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Nabani Owuso ya dino kyizire abola nu, kweyi oya kyizire ko olayi ko gbogbo-gbogbo. Shini inototu kpino kyokye na shotunehe dudu. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Bwebe ni, asuse sosa ni kamo, &lt;Ashe wo toza, ashe wo kyoza&gt; ni wokwokwoshi la. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Nta ala oleho koga kyoza eho ni ala tu lo ni. Ashishini yoko ni lono ni, kweyi ala ga kyoza koko wa.&gt;&gt;<verse eid="JHN 4:38" /></para>
  <para style="s">Osamariya Nwashika Kyogwu</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Ase ko Osamariya nwashika ni bogya ni kyogwu kpo Oyesu ikweyi koza ni onya ni ka ni mo, &lt;&lt;Oka dami ojoji ni nyya nekye-nekye ni.&gt;&gt; <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Ishini ase ko Osamariya webe nu ni, abo mo ona yagye kpawa, kweyi oyeno epa kpawa. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Kweyi ase nwashika kyogwu kpo Oyesu bwebe kela ni oka ni.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Aka do onya ni mo, &lt;&lt;Aha kyogwu ikweyi ko oza ni oka ni kin lalo, anani aha pwo kpa akpaha ka aha, kweyi aha gye kamo ongo mani pini wi inongmese la.&gt;&gt;<verse eid="JHN 4:42" /></para>
  <para style="s">Oyesu Do Oyi ki Igabo Ogege</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Itikpi ke eno epa, oshe ebe ni bita go Ogalili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Ebeni Oyesu abiyinu kadawa mo aba mi inobane gyiyi okpagye nu lo. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Ishini owo Ogalili ni, ase ko Ogalili yo omaba. Amo awoza kpiri ni oya ipu ko ogya ko Ojerusele ebe ki Imya ko Sheyi ni, ikweyi koni awa bebeni.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Oki kwikye gogya ko Okana ipu ko Ogalili, ogya ni oyinyo pya winyi ni. Kweyi anyakwase ka awonongbo oye ni oyi nu gutagye kere Okapanahu. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Ishini ongo mani pwo mo Oyesu kwikye bwo ojudiya wo Ogalili ni, ogebe nu ga bo mo ona wa doyi nu ni yokwunu kikwu ni ogege.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Oyesu kadawa mo, &lt;&lt;Owoni ala mo oyi kpoza kigbashi lalo ashishe kala ya kyogwu lo.&gt;&gt;<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Anyakwase ko onongbo oni kamo, &lt;&lt;Adole, wa shini ahan ga papa lalo oyi hin ya gekwu.&gt;&gt;<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Oyesu kyogwu mo, &lt;&lt;Ga, oyi wo ya pyo ogege.&gt;&gt;</para>
  <para style="p" vid="JHN 4:50">Ongo oni kyogwu kpoza ni Oyesu ka ni kweyi oga nu. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Ishini otayayo yowe yaga ni, oyole nu byoshu wa danu mo, oyi nu pyo ogege. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Oduwoka mo ishi wonya ni oyi nu pyo ogege. Aka danu mo, &lt;&lt;Oshu shobita ogye oye kisheno kene.&gt;&gt;<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Ebeni ada ko oyi mani ra mo abo kogye oye kisheno kene Oyesu ka danu mo, &lt;&lt;Oyi wo ya pyo ogege.&gt;&gt; Ebeni anu kpase kole nu kyogwu kpanu.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Omani woza kigbashi komwepa ni Oyesu ya ome ona go ojudiya agye ko Ogalili.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Oyesu Dase Ogege Okunu Kogo ki Inyo.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Ishi oye Oyesu go Ojerusele ebe ki Imya kase ko Oyahuda. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ipu ko Ojerusele ogo kinyo ni yo pee kpofunu koda kikpowu ni aba yogwu okwunu ki ibru mo Obeseda, ni agwinu to ni. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Kweyi ase ni gbo ogege lo ni bya awopywiyi, awopyepu-agye kpa awo ngmonyodu nwashika bebeni. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Ishi shishini oyoleho ka Adole yawa yinyo yaya. Kweyi kpiri kase ni gbo ginyo ishini oya yinyo ya ya ni ikyikyo, oya pyo ogege. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Ongo oye yebe ni, ni gbose, oya gege ko nyiso lo ishayi aweta ayahata. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Ishini Oyesu mo gutagye ebe ni, ogye mo oya mowe kpere gbeji wa, odoka mo, &lt;&lt;Oya yimu ko pyo ogege?&gt;&gt;<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Ini kere kyogwu mo, &lt;&lt;Ngba ashishe ko tumabo ko gipu ko ogo kinyo ishini inyo ya ni lo. Ishini nyya takirikwu ko gbo ginyo, ashe ya kwobonu dami.&gt;&gt;<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Ebeni Oyesu kamo, &lt;&lt;Nyiso! Sho lote wo shini oyawu.&gt;&gt; <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Ebebeni ongo ni pyogege, oyote nu la kweyi yawu.</para>
  <para style="p" vid="JHN 5:9">Eno ni oza mani gbodagye ni we Eno ko Minyo, <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />ebe ni awoteyi ko Oyahuda ka do ongo ni pyo ogege ni mo, &lt;&lt;Owe Eno ko Minyo, ono kaha wobi koni oya zote shini oyawu ni.&gt;&gt;<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Anu ke kyogwu mo, &lt;&lt;Ase ni dami ogege ni ka dami mo, &lt;Zote wo na shini oyawu.&gt;&gt;&gt; <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />Adoka mo, &lt;&lt;Anoho ka dawo mo, lote wo sho yawu?&gt;&gt;<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ongo ni odanu ogege mani gyase ni owe ni lo, Oyesu kwobonu gebi shuwiyi ipu kewa.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Kee Oyesu wa mo ipu ko Ole ko Owuso kweyi oka danu mo, &lt;&lt;Ma, opyo ogege. Owoni oshozalabi bita lo oni sho omani ki yawa tawo.&gt;&gt; <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Ongo mani ga ka da awoteyi ko Oyahuda mo Oyesu pini danu ogege la.<verse eid="JHN 5:15" /></para>
  <para style="s">Oshu ko Oyi ko Owuso</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Ikweyi koni Oyesu ya ya awoza mani Eno ko Minyo ni, koni Ase ko Oyahuda danu egye. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Oyesu ka dawa mo, &lt;&lt;Ada hin yipu koko nu, kwikyikyeni, kweyi ami yipu koko ya ya mamani.&gt;&gt; <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />Ikweyi koni Ase ko Oyahuda ba tikpo ko owe wonyonya ko yongmo, omani wi ikweyi koni odase ogege Eno ko Minyo kin lalo, ke wi ikweyi koni omo Owuso wa Ada nu ni, oziyinu gyogye kpo Owuso.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Oyesu ka dawa mo, &lt;&lt;Nyya kadala okwokwoshi, Oyi ya gege ko kwiyinu yoza kin lo, oya gboza ni Ada nu ya ya ni la, ikweyi koni ojoji ni Ada ya ya, Oyi ya ya mamani. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Koni Ada ya yimu ko Oyi nu kweyi oki shiyanu oza kpiri ni oya ya ni. Kweyi oki ya shiyanu oza nwashika shini igbashi na ya ala kwu. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Byoni Ada ya ya awase ni gekwu ni ba nyiso amiri ni kweyi ba gbo olayi ni, mamani Oyi ya da awase ni nyya yimu ni olayi. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Ada abiyinu kwashishe epwo lo, oke yoshu ko kwepwo yi do Oyi nu, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />shini kpiri kase na mo gyiyi byoni aba ma Ada nu gyiyi ni. Ase ni mo Oyi gyiyi lo oya ma Ada ni toleho ni ya gyiyi lo.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Nyya ka dala okwokwoshi, kpiri kase ni pwela hin kweyi okyogwu kpase ni tumoleho ni oya gbo olayi ko gbogbo-gbogbo kweyi aba kwepwo lo, osheyi kikwu gipu ko olayi. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Nyya ka dala okwokwoshi, ishi yawa ba kweyi okwobonu wa wa ni ase ni gekwu ba pwoko ko Oyi ko Owuso, kweyi awase ni pwoko nu aba pyo olayi. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Byoni Ada gbo olayi ipu nu ni, oyo Oyi gbo olayi ipu nu mamani. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Oki danoshu ko kepwo koni owo Oyi ka Asuse ni.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />Igbashi naka kwala ikweyi koza mani lo, koni ishi yawa ba ni kpiri kawase ni ba amiri wa ni ba pwoko nu <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />kweyi awase ni yoza neshi ba nyiso kweyi ba gbo olayi, kweyi awase ni yobibi aba kwuwepwo. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Ami gboshu ko yojije abiyun lo, nyya kepwo byoni Owuso ka dami ni la, epwo koka hin wa kokwokwoshi, koni nyya tikpo ko yoza ni shumotu ni la lo, ke wako shase ni tumoleho ni otu ni la.<verse eid="JHN 5:30" /></para>
  <para style="s">Olobene Ikweyi ko Oyesu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Owoni nyyo olobene ikweyi kiyun, olobene hin wo kwokwoshi lalo. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ashe yaba ni yolobene ikweyi hin ni, ngye molobene ni oya ikweyi hin kpiri ni wo kwokwoshi.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />Ala toleho gebe ko Oyohana, kweyi oyolobene kokwokwoshi. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Owotiri shina kyogwu kpolobene kasuse lalo, ami ke ka mani shini ana ngmala. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Oyohana lema bye emu ni wa yu dala ni, kweyi ala kyogwu kishi gbayayi ko monye koyoyu nu.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />Ami ke gbo olobene ni shoni Oyohana yani. Oko ni Ada dami ni mo na yi ya kweyi, anu pini nyya ya ma kweyi oya shiyase ma Ada pini tumoleho la. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Kweyi Ada ni tumoleho ni abiyinu kokwokwoshi ikweyi hin, kwigboye ala pwoko nu kwe mo iyi kpi iyi lo, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ala zela nu ipu kotu kala lo, koni ala kyogwu kpase ni otoleho ni lo. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Ala yiyi kwokpa neneshi, ikweyi koni ala yotuse mo oya dala olayi ko gbogbo-gbogbo. Okpa mani ke yolobene ikweyi hin la, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />kwikyikyeni ala tela ko webe hin shini ala pyo olayi.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Nyya tikpo kiye shosha kasuse lo, <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />ami ke gyala. Ngye mo ala gbi imu ko Owuso ipu kotu kala lo. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Nwa ipu kiye ka Ada hin, kweyi ala kyogwu kpa ami lo, owoni ashe ke wa kela ikweyi kiyinu, ala ba kyogwu kpanu. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Ala ba yamoji ba kyogwu kpami, koni ala ba kyogwu kpiye shosha ni ala ba shiyi kala ni? Ala ke tikpo kigyashi ni yawa bwebe ko Owuso ni lo.<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Ala ke ka ma byami pini ya ga sha Ada epwo mala tela ko yoza neshi lalo. Omusa ni ala yotuso ni, anu pini yawa rotu kala la. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Owoni ala kyogwu kpo Omusa, ala bi ba kyogwu kpami, koni otenena ikweyi hin. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Byoni ala ke kyogwu kpoza ni ota ni lo ni, ala ba ya moji ba kyogwu kpoza ni nka ni?&gt;&gt;<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Oyesu Dase Okpaku Eho Ozarore</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Bwebe ni Oyesu sheyi ki ishu-nyakwu ko Ogalili, okwunu kega ko Otiberiya, <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ase lewa gboso ikweyi koni amoza kigbashi ni oya ikweyi kawase ni ba gbere ni. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Ebeni Oyesu toshi gi ikweyi ke efu ga yagye kpa awogboso. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ishi ki Imya ko Sheyi ko Oyahuda yo pee.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />Ishini Oyesu tiyi mase lewa ni ba webe nu ni, oka do Ofilibus mo, &lt;&lt;Ebenya ni aba pyi ikyoga ko dewa kasuse mani shini ana ha?&gt;&gt; <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Odoka mani kin shini ona moma, ikweyi koni okwobonu gyoza ni oya yimu koya ni.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Ofilibus kyogwu mo, &lt;&lt;Ikwiri niya roza rore dewa kasuse mani ko pyabo oyoye, ya shikwiri koko ke eno ogbogbo epa.&gt;&gt;<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Oye ipu kawogboso, Andru, oyene ko Osimo Obitrus kamo, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />&lt;&lt;Oyi nongo oye gbo Ikyoga eho kpe ebinyi epa yoma. Omani ya yamoji ya fikweyi kewa ni bagye mani?&gt;&gt;<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Oyesu kamo, &lt;&lt;Ala ka dase na bagye.&gt;&gt; Ebeni ikyashi nwashika kweyi aka da ango mo ana bokpagye, awase okpakwu eho. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Oyesu zo ikyoga kweyi oshotunehe do Owuso, kweyi oda awogboso mana yiko dewa ni bokpagye ni, oki ya mamani kpe ebinyi.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Ishini kpiri wa roza gyuwa ni, oka da awogboso mo, &lt;&lt;Ala kpashini koza ni are ni tukpa. Shini ojije naka yishi lo.&gt;&gt; <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Oni akpo tukpa ni nwo ogwugwu igwepa kpo ikyoga eho ni aha ni.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Ishini ase moza kigbashi ni Oyesu ya ni, akamo, &lt;&lt;Ko kwokwoshi omani pini winobane ni ya wese ni la!&gt;&gt; <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Oyesu gye mo aba yimu ko to ose ko oshu, ebe ni okwikye nu gikweyi kefu oye ga yagye fufunu.<verse eid="JHN 6:15" /></para>
  <para style="s">Oyesu Yawu Ikweyi ki Inyo</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Ishini eno shani, awogboso go okwunu ki ishu-nyakwu, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />ebe ni agipu ko owu, kweyi asheyi ki ishu-nyakwu go Okapanahu. Ishi oni ebe kwobonu dibu, kweyi Oyesu yipu kowu kpa wa lo. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Owu ta loshu ikweyi kinyo kweyi ya wu giso. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Ishini ayawu kigbo eta kwe ene ni, kweyi amo Oyesu yawu ikweyi kinyo ya webe ko owu, kweyi oshi yuwa kwu. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Oke ka dawa mo, &lt;&lt;Ami la, alaka yoshi lo.&gt;&gt; <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Ebeni azo kpabo pepa ipu kowu, ebebeni owu pwo okwunu kega ebe ni aba yimu ko ga ni.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Gbebenya, ashishini kase ni hagye pyiyi tega ki ishu-nyakwu ni mo owu oye kponu pini hagye ebe ni la, awogboso ke shokwunu kega bita, Oyesu ke gipu kowu kpa awa ishini aba nyiso ene ni lo. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Bwebe ni ashishini kowu bwo Otiberiya wa hagye ebe ni ase ho ikyoga ishini Adole shotunehe ni. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Ishini ewa ma mo Oyesu kpa awogboso bebeni lo ni, agipu ko owu kweyi akwikye go Okapanahu aba tikpo ko Oyesu.<verse eid="JHN 6:24" /></para>
  <para style="s">Oyesu wi Ikyoga ko Owushoshu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Ishini amo okoka ki ishu-nyakwu ni, adoka mo, &lt;&lt;Inofoza, ishi nya no ofebe ni?&gt;&gt;<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Oyesu kyogwu kweyi ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, ala ba tikpo hin ikweyi koni ala ma awoza kigbashi ni lalo ke wikweyi koni ala ho ikyoga yipu ni la. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ala yoko kozarore ni ya dala olayi ko gbogbo-gbogbo ni, ala ka yoko kozarore ni ya yishi ni lo. Ami Oyi ka Asuse ya dala ozarore mani koni ami pini Owuso Ada dami oshu ko ya la.&gt;&gt;<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Ebeni adoka mo, &lt;&lt;Aha baya moji shini ahan yoko ko Owuso ya?&gt;&gt;<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Oyesu kyogwu kweyi ka dawa mo, &lt;&lt;Oko ko Owuso yoma, ala kyogwu kpase ni otoleho ni.&gt;&gt;<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Aki doka mo, &lt;&lt;Oza kigbashi nya ni oya ya, shini ahan kyogwu kpa awo? Oji ni oya ya? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Awokyikyi ka aha hozarore ni aba yogwu mo omana ni ipu ko ododa, byoni ayitota ipu ko okpa ni mo, &lt;Odawa ikyoga bwi iso mo ana ha.&gt;&gt;&gt;<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Oyesu ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, Omusa pini dala ikyoga bwi iso lalo, Ada hin pini ke dala ikyoga kokwokwoshi bwi iso la. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Koni ikyoga ko Owuso wase ni bwi iso wo okpagye kweyi wa dase kese olayi ni.&gt;&gt;<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Akamo, &lt;&lt;Adole, bwishi mani gohobwu daha ikyoga mani.&gt;&gt;<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Ebeni Oyesu ka dawa mo, &lt;&lt;Ami pini wo ikyoga ko olayi la. Ase ni webe hin emye ya ngmo lo, kweyi ase ni kyogwu kpami igyini ya ngmo lo. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Byoni nka dala ni, ala mun kweyi kwikyikyeni ala kyogwu kpami lo. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Kpiri kase ni Ada dami ya webe hin, kweyi ase ni webe hin nyya nenya lo. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Koni ami bwi iso wa ko yoza ko otu hin lalo, nke wa ko yoza kotu kase ni tumo oleho ni la. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Kweyi oza kotu kase ni tumo oleho ni mo, ipu kase ni odami ni ashishe naka gebi lo, na ke dawa olayi eno ko kweyi. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Oza kotu ka Ada hin wo, ase ni pyiyi mo Oyi mani kweyi kyogwu kpanu oya pyo olayi ko gbogbo-gbogbo, kweyi nyya shiyi eno ko kweyi kese.&gt;&gt;<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Ebeni Ase ko Oyahuda kakakyose ikweyi koni okamo, &lt;&lt;Ami wo ikyoga ni bwi iso wa ni.&gt;&gt; <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Akamo, &lt;&lt;Omani wo Oyesu oyi ki Isu, ni aha gya ada nu kpi inanu ni yo na lo? Ojiya ni oya kamo, &lt;Nbwi iso pini wa la?&gt;&gt;&gt;<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Oyesu kamo, &lt;&lt;Ala sha akyose koka bita. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Ashishe ya gege ya webe hin lo, owoni Ada ni tumo oleho ni pyo wa lalo, kweyi ami ya shiyi eno ko kweyi kese. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Ayitota ipu kokpa kawo bane mo, &lt;Owuso ya fase kpiri oza.&gt; Kpiri kase ni pwela ka Ada kweyi ki fu bwebe nu oya webe hin. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Ashishe ma Ada ebyibye lo, ase ni bwebe ko Owuso, anu kin pini ma Ada la. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Nyya ka dala okwokwoshi, ase ni kyogwu kpanu ogbo olayi ko gbogbo-gbogbo. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ami wo ikyoga ko olayi. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Awokyikyi kala hoza ni aba yogwu mo omana ni ododa, kwikyikyeni aki gekwu. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ikyoga ni ke sa bwi iso ni yoma, ase ni ha oya gekwu lo. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ami wo ikyoga ko olayi ni sa bwi iso ni. Ase ni ho ikyoga mani, oya sho olayi ko gbogbo-gbogbo. Ikyoga mani webe kikpiye hin la, ni nyya ze ikweyi kase kese kpiri.&gt;&gt;<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Ebeni Ase ko Oyahuda kwotu ko tawashu kpi iyiwa mo, &lt;&lt;Owe wonya no ongo mani ya daha ebe kikpiye nu ya ha?&gt;&gt; <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />Oyesu ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, owoni ala hebe ko Oyi ka Asuse kweyi gwoyi nu lalo, ala ba pyo olayi lo. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Ase ni hebe kikpiye hin kweyi gwo oyi hin oya pyo olayi ko gbogbo-gbogbo, nyya shiyi eno ko kweyi kese. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Koni ebe kikpiye hin wo ozarore kokwokwoshi oyi hin ki winyi ko okwokwoshi. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Ase ni hebe kikpiye hin kweyi gwoyi hin oyipu hin, kweyi ami yipu nu. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Byoni Ada ni ya yase ya gbo olayi ni tumo oleho ni kweyi Ada ki yun ya gbo olayi, ase ni hebe kikpiye hin oya gbo olayi bwebe hin. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Omani pini wo ikyoga ni bwi iso ni la. Awokyikyi kala ho omana ni kweyi agekwu, ase ni ke ho ikyoga mani oya gbo olayi ko gbogbo-gbogbo.&gt;&gt; <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Oyesu kela mani ishini oya foza ipu ke ekpa ka Ase ko Oyahuda ipu ko Okapanahu.<verse eid="JHN 6:59" /></para>
  <para style="s">Awogboso Oyesu Nwashika Kwikye Itikpi</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Ishini awogboso nwashika pwo mani ni akamo, &lt;&lt;Ozafofu mani loshu. Anoho ya kyogwu kpanu?&gt;&gt;<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Oyesu gye mo awogboso ba tawashu ikweyi koza ni apwo ni, oka dawa mo, &lt;&lt;Ela mani yala ba shikawu la? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Oya lemoji owoni ala mo Oyi ka Asuse kwikye gebe ni oyo ni ome? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Oza ni ya dase olayi ni wo Omaku, ikpiye gboshu oyoye lo. Ela ni nka dala mani nwonwu kpo Omaku kpo olayi. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Kwikyikyeni ashishini kala kyogwu lo.&gt;&gt; Bwikyikyo Oyesu gyase ni kyogwu kpanu lo kpase ni wa yo ra ni. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Okamo, &lt;&lt;Oza ni ya ni nka dala mo ashishe ya webe hin lo, owoni Ada hin danu oshu la lo.&gt;&gt;<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Bwishi oni awogboso nwashika kwikye itikpi kweyi atela ko gboso.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Oyesu dase igwepa ni oka mo, &lt;&lt;Kwe ala ba ga kala mamani la?&gt;&gt;<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Osimo Obitrus ka danu mo, &lt;&lt;Adole, ebe kanoho ni aba ga? Ogbela ko olayi ko gbogbo-gbogbo. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Akyogwu aki gye mo owase Sere ko Owuso.&gt;&gt; <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />Ebeni Oyesu kyogwu mo, &lt;&lt;Ala wa ase igwepa pini nshala lalo? Kwikyikyeni ashe ipu kala wibiri!&gt;&gt; <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Oya kela ko Oyahuda Iskariyoti, oyi ko Osimo, oye ipu kase igwepa, ni yawa yo ra ni.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Ayene ko Oyesu Kyogwu kpa Anu lo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Oyesu gogya-gogya ipu ko Ogalili kweyi otela ko ga agye ko Oyahuda ikweyi koni Ase ko ojudiya ba yimu koyo ngmo. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ishini Imya ka Ase ko Oyahuda ka Adaba ke yo pee ni, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />ayene ko Oyesu ka danu mo, &lt;&lt;Oshu ko she ebe ni bita shini ogo ojudiya, shini awogboso na mawoza kigbashi ni oya ya ni. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Ase ni ya yimu ko woteyi naka yoza teba lo. Owoni oya yoza mani, shiyo dase kese.&gt;&gt; <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Ayinanu kipu nu kyogwu kpanu lo.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Ni olemani oni, Oyesu ka dawa mo, &lt;&lt;Ishi hin gye wa lo, ebe kala ishi kpiri wo gyogye. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ese ba yanya kala lalo, ake ba yanya hin la ikweyi koni nyyo olobene moko kese kpiri wo obibi. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Ala ba gebe kimya. Ami ke ya gebe kimya mani lo, ikweyi koni ishi hin gye wa lo.&gt;&gt; <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Ni oka mani dawa ni, oyagye Ogalili.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Ishini ayinanu nyiso gebe kimya ni, anu gbosuwa, obose ese shini ana mo lo, oke ga teba. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Awoyahuda ba tikpo nu ebe kimya kweyi aba da ase okamo, &lt;&lt;Oyini?&gt;&gt;<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Ase lewa bagye ba kakyose ikweyi nu. Ashishini kase kamo, &lt;&lt;Ongo mani wase neshi.&gt;&gt;</para>
  <para style="p" vid="JHN 7:12">Ashishini kamo, &lt;&lt;Oya gyase egya la.&gt;&gt; <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ashishe ke gege ko kela nu shese lo koni aba yoshi ka Ase ko Oyahuda ni.<verse eid="JHN 7:13" /></para>
  <para style="s">Oyesu Foza Ebe Kimya</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ishini arimya go otutehe ni Oyesu nyiso gole ko Owuso kweyi okwotu ko foza. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Igbashi ya Ase ko Oyahuda kwu kweyi adoka mo, &lt;&lt;Ebenya ni ongo mani pyawoza gyogye mani bwanu, oke yi inokpa lo?&gt;&gt;<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Oyesu kyogwu mo, &lt;&lt;Oza ni nyya fu mani bwebe kase ni tumoleho ni la. Ami kwiyun ya fu lalo. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ase ni kyogwu kweyi yoza ni Owuso ya yimu ni, oya gye kwe ozafofu mani bwebe ko Owuso kwe nkwiyun pini ya fu la. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Ase ni ya foza kpo oshu kiyinu oya tikpo ko igyashi diyinu. Ase ni ke yoko kase ni toleho ni owase ko kwokwoshi, kweyi ela meme yipu nu lo. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Omusa dala ono lo? Kwikyikyeni ashishe kala gboso ono ni lo. Ojiya ni ala ba tikpo ko yun ngmo?&gt;&gt;<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Ase lewa kamo, &lt;&lt;Ogbo owu bibi ipu wo! Anoho ya tikpo koyo ngmo?&gt;&gt;<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Oyesu ka dawa mo, &lt;&lt;Nyyoza kigbashi oye kweyi igbashi yala kwu kpiri. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Ikweyi koni Omusa kela ikweyi ko ofu shoshe, akwotu koni bwi ikweyi nu lalo, akwotu bwebe ka awokyikyi kala, kweyi ala ba sha ayileke ofu Eno ko Minyo. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Owoni aba shoyi ofu Eno ko Minyo shini ono ko Omusa naka kyigbo lo, ojiya ni ala ba byotu kpa ami koni ndase ogege Eno ko Minyo ni? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ala shepwo koka kiyi bita, kweyi ala kepwo kokwokwoshi.&gt;&gt;<verse eid="JHN 7:24" /></para>
  <para style="s">Oyesu Wo Okristi la?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Ebeni ase ko Ojerusele kwotu ko doka mo, &lt;&lt;Ongo mani pini aba yimu koyo ngmo lalo? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Mo hagye ebe ni ya kela ese gboshi lo, kweyi agege ko yoje lo. Kwe awoteyi kyogwu manu wo Okristi la? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Aha ke gye ebe ni ongo mani bwanu wa ni, ishini Okristi wa, ashishe ya gye ebe ni oya bwanu ni lo.&gt;&gt;<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Oyesu tayayo ya foza ipu ko Ole ko Owuso, ozoko iso nwa mo, &lt;&lt;Ngye mo ala gyun, ala ki gye ebe ni nbwanu wa ni. Nwa kpo oshu kiyun lalo, ase ni ke tumoleho ni wokwokwoshi. Ala gyo lo, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />ami ke gyo ikweyi koni nbwebe nu pini wa la, anu tumoleho la.&gt;&gt;<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Ikweyi kela mani, aba nonu koyo kwu, ashishe ke yabo kwo lo, ikweyi koni ishi nu gye wa lo ni. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Ase nwashika kyogwu kpanu. Akamo, &lt;&lt;Ishini Okristi wa, oya yawoza kigbashi nwashika ni ki shomani ni la?&gt;&gt;<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Ishini ashishini ka Awofarisi pwela ni ewa kase ba ka ikweyi nu ni. Ebeni ose kawosapa kpa Awofarisi ta awogbeho ko Ole ko Owuso oleho koyo kwu. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Oyesu ka dawa mo, &lt;&lt;Nyya yo kpa ala kishi gbayayi kin la, kweyi nki ya kwikye ya gebe kase ni tumoleho ni. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Ala ba tikpo hin, ala ke ba pyun lo, kweyi ebe ni nyyanu, ala ba gege baga lo.&gt;&gt;<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Awoyahuda diyiwa oka mo, &lt;&lt;Ebenya ni ongo mani ya yimu koga ni aha ba pyo lo? Kwe oya gebe ka Ase ko Oyahuda ni pasha ipu ka Ogirik, kweyi na fuwoza ebe ni la? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Oji ni ogbo ipu kotu nu ni oya kamo, &lt;Ala ba tikpo hin, ala ke ba pyun lo,&gt; Kpo, &lt;Ebe ni nyyanu, ala ba gege bawa lo?&gt;&gt;&gt; <verse eid="JHN 7:36" /><verse number="37" style="v" sid="JHN 7:37" />Eno ko kweyi kimya neneshi ke, Oyesu ya hagye kweyi ya kela kpo oko nwa ya kamo, &lt;&lt;Kpiri kase ni igyini ya ngmo, ona webe hin wa gwinyi. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Kpiri kase ni kyogwu kpami, byoni okpa ko Owuso ka ni, inyo kokpa ko olayi yape ipu nu.&gt;&gt; <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Omani oya kela ikweyi ko Omaku, ni awase ni kyogwu kpanu bawa ze ni. Ishi oni ada ashishe Omaku wa lo, ikweyi koni ado Oyesu igyashi wa lo.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Ashishini kase apwela mani akamo, &lt;&lt;Kokwokwoshi ongo mani winobane la.&gt;&gt;<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Ashishini kase kamo, &lt;&lt;Owo Okristi la.&gt;&gt;</para>
  <para style="p" vid="JHN 7:41">Kwikyikyeni ashishini ba doka mo, &lt;&lt;Okristi ya bwo Ogalili moji? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Okpa ko Owuso kamo Okristi yawa bwi ipwoma ko Odawuda kpo Obetalami, ogya ni Odawuda yanu ni ona lo?&gt;&gt; <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Ebeni okwunu kase kepa ikweyi nu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Ashishini kase yimu koyo kwu, ashishe ke ga anu abo lo.<verse eid="JHN 7:44" /></para>
  <para style="s">Awoteyi ka Awoyahuda Kyogu lo</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ogwejeji awogbeho kole ko Owuso kwikye gebe ko ose ka awosapa kpa Awofarisi kweyi aduwa okamo, &lt;&lt;Ojiya ni ala byo wipu lo?&gt;&gt;<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Awogbeho kole ko Owuso kamo, &lt;&lt;Ashishe ebyibye kela byoni ongo mani ka ni lo.&gt;&gt;<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Awofarisi oni kamo, &lt;&lt;Ala ba ka daha mo ogya ala egya mamani ona?&gt;&gt; <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />&lt;&lt;Kwe ashe ipu ka awoteyi kwe Ofarisi kyogwu kpanu la? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Aayi! Ase kokpagye mani ke agyojije ikweyi ko ono lo, igbe na tuwa.&gt;&gt;<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Onikodemus ni kwobonu gebe ko Oyesu otu ni, woye ipu wa kweyi doka mo, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />&lt;&lt;Ono ka aha kyogwu mo aha kwase epwo, owoni aha pwela bwokwunu nu shini ahan gyoza ni oya ni ome lo?&gt;&gt;<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Akyogwu mo, &lt;&lt;Awo bwo Ogalili mamani la? Owoni obi mokpa ko Owuso obi ya gye mo, inobane bwo Ogalili ebyibye lo.&gt;&gt; <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Ebeni ananoho wa kwikye ganu gole.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Oyesu gikweyi ke Efu ko Ozetu.<verse eid="JHN 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2" />Otukpokyi okwikye go ole ko Owuso. Kpiri kase wa gbayi obutu nu, kweyi oyagye ya fuwoza. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Awofono kpa Awofarisi byo onya oye ni akwo ya beba ni wa. Abyo wa hagye otutehe kewa. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Kweyi aka do Oyesu mo, &lt;&lt;Inofoza, aha kwo onya mani ya beba. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Ishini Omusa daha ono mani oka daha mo onya ni akwo ya yoza mani, ana takyo gbi ishini ona gekwu. Nabani awo kamoji?&gt;&gt; <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Oka doda mani weda pini aba ze do Oyesu la shini ana pyowe ko kwepwo.</para>
  <para style="p" vid="JHN 8:6">Oyesu ke yikweyi lagye kweyi ya tenena okpagye kpayabo nu byoya pwuwa lo ni. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Ishini abipu koka ba do ni, Oyesu zikweyi iso kweyi ka dawa mo, &lt;&lt;Owoni ashishe ipu kala gbozalabi ebibye lo nawa kikyikyo ko tonya mani akyo.&gt;&gt; <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Okyikweyi nu lagye kweyi ya tenena.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Bwebe ni awase ni pwela mani ni kwotu ko shebe ni bita bwa anyakwase wa ayeke, gbishini asho Oyesu kpo onya ni bita hagye ebe ni. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Oyesu zikweyi iso kweyi doka mo, &lt;&lt;Onya, abebenya? Ashishe wa kwepwo lo?&gt;&gt;<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Okamo, &lt;&lt;Ashishe lo.&gt;&gt;</para>
  <para style="p" vid="JHN 8:11">Oyesu ka danu mo, &lt;&lt;Ami ki ya kwepwo lo. Gawo, ka yozalabi kelo.&gt;&gt;<verse eid="JHN 8:11" /></para>
  <para style="s">Oyesu wo Oyoyu ke Ese</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Ishini Oyesu ki kela dase ni okamo, &lt;&lt;Ami wo oyoyu kese la. Ase ni gbosun oya yawu ipu kebe dibu lo, ke ya gbo oyoyu ipu ko olayi nu.&gt;&gt;<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Ebeni Awofarisi ka danu mo, &lt;&lt;Awo ya yolobene abiyo, olobene ni oya ya ni wa ko kwokwoshi lalo.&gt;&gt;<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Oyesu ka dawa mo, &lt;&lt;Owoni nyyo olobene abiyun, olobene hin wa ko kwokwoshi la, koni ngye ebe ni nbwanu wa ni, nki gyebe ni nyya ga ni. Ala ke gyebe ni nbwanu wa ni lo kwe ebe ni nyya ga ni lo. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Ala ba kepwo kiyi kasuse la, ami ke ya kwa ashishe epwo lo. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Owoni nke kwase epwo, epwo hin wa ko kwokwoshi la, ikweyi koni ami yo fufun lalo. Ada hin ni tumoleho ni yo kpami. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Ipu ko ono kala ayi tota mo owoni ase epa koje kponu, owotiri shini ana kyogwu kpolobene wa. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ami ya yolobene ikweyi kiyun, koni olobene hin komwepa pini wa Ada ni tumoleho la.&gt;&gt;<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Ebeni adoka mo, &lt;&lt;Ada wo yebe nya?&gt;&gt;</para>
  <para style="p" vid="JHN 8:19">Oyesu kyogwu mo, &lt;&lt;Ala gyun kwe Ada hin lo. Owoni ala bi gyun, ala bi ba gya Ada hin.&gt;&gt; <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />Oyesu kela mani ishini oya foza ipu kole ko Owuso, pee kpebe ko odudu kotu kyokye ni. Ashishe ke yo kwu lo ikweyi koni ishi nu gye wa lo ni.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Oyesu ki ka dawa mo, &lt;&lt;Nyya ga hin, kweyi ala ba tikpo hin, kweyi ala ba gekwu ipu ko ozalabi kala. Ebeni nyya ga ni, ala ba gege ko ga lo.&gt;&gt;<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Ela mani ya Ase ko Oyahuda doka mo, Oya yiyinu ngmo la? Oza ni ya ni oya kamo, &lt;&lt;Ebeni nyya ga ni, ala ba gege ko ga lo ni ona?&gt;&gt;<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Anu ke gohobu kpela koka mo, &lt;&lt;Ala bweye, ami ke bwi iso. Ala wa kese mani la, ami wa kese mani lalo. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Nka dala mo ala ba gekwu ipu ko ozalabi kala, owoni ala kyogwu mami pini wanu lalo, ala ke ba gekwu ipu ko ozalabi kala.&gt;&gt;<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Adoka mo, &lt;&lt;Owa anoho?&gt;&gt; Oyesu kyogwu mo, &lt;&lt;Ami wase ni nka dala mo nwwe bwikyikyo ni.&gt;&gt; <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />&lt;&lt;Ngbela nwashika ko ka ni nyya kwala epwo ni. Ami ke ya ka dase oza ni npwo bwebe kase ni tumoleho mona ka dase kese ni okwokwoshi.&gt;&gt;<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Awa ke gyoza ni oya ka dawa ikweyi ka Ada nu ni lo. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Ebeni Oyesu ka dawa mo, &lt;&lt;Ishini ala ngo Oyi ka Asuse iso, ishi oni ala ba gye mo owa ami la. Nyya gege ko yojije ami fufun lo, nke ya koza ni Ada fun ni. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Ase ni tumoleho ni yo kpami, oshun bita fufun lo, koni nyya yoza ni otu nu yasha ni.&gt;&gt; <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Ishini Oyesu ya kela mani ni, ase nwashika kyogwu kpanu.<verse eid="JHN 8:30" /></para>
  <para style="s">Ayi ki Ibirayi</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Awoyahuda ni kyogwu kpanu ni, Oyesu ka dawa mo, &lt;&lt;Owoni ala byoza ni nfu ni, ala wa awogbosun ko kwokwoshi la. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Ebeni ala ba gyo okwokwoshi kweyi okwokwoshi ya ngma ala.&gt;&gt;<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Aka danu mo, &lt;&lt;Aha wayi kayi ki Ibirayi la, aha wo oshe kashishe ebibye wa lo. Oyamoji ya kamo aba wa shaha eshe?&gt;&gt;<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Oyesu kyogwu mo, &lt;&lt;Nyya ka dala okwokwoshi, kpiri kase ni yo ozalabi owo oshe ko ozalabi. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Nabani oshe gbebe kiyinu ipu kipwoma lo, oyi ke yipu nu gbogbo-gbogbo. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ni olemani, owoni Oyi ko Owuso shawo eshe, ashawo eshe kwokwoshi. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ami gye mi Ibirayi wokyikyi kala la. Kwikyikyeni ala ba yimu ko yun ngmo, ikweyi koni ela hin gboyagye ipu kotu ka lo. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Nyya ka dala oza ni nma ebe ka Ada ni, kweyi ala yoza ni ala pwo ebe ka ada kala ni.&gt;&gt;<verse eid="JHN 8:38" /></para>
  <para style="s">Ayi ki Ibiri</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Aka mo, &lt;&lt;Aayi, Ibirayi pini wada ka aha la.&gt;&gt;</para>
  <para style="p" vid="JHN 8:39">Oyesu kamo, &lt;&lt;Owoni ala wayi kayi ki Ibirayi la, ala bi ba yawoza ni Ibirayi ya ni. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Byoni ala ba yimu ko ngmun ni, ami wase ni ya ka dala okwokwoshi ko oza ni npwo bwebe ko Owuso ni la. Ibirayi ya gege ya ya awoza mani lo. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Ala ba yawoza ni awada kala ya ni la.&gt;&gt;</para>
  <para style="p" vid="JHN 8:41">Awoyahuda ke ba kamo, &lt;&lt;Aha wase ni amuwa kagya ni lalo, aha gba Ada wo Owuso.&gt;&gt;<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Oyesu ka dawa mo, &lt;&lt;Owoni Owuso wa Ada kala, ala bya yimu hin, ikweyi koni nwebe kala bwebe ko Owuso la. Nbyiyun kin pini webe mani lalo, anu pini ke tumo oleho la. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Ojiya ni ala gyoza ni nyya ka ni lo? Ikweyi koni ala ya akpaha tagye do ozafofu hin lo ni! <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Ala ada kala wi ibiri la, ala ki ba yimu ko yoza bibi ni oya yimu ni. Owino ngmase bwikyikyo. Kpiri kishi oya yanya kokwokwoshi, ikweyi koni ojije wokwokwoshi yipu nu lo. Kpiri kishini oya kokame, oya shiya ase otu nu la, ikweyi koni owino kokame ki wa ada ko okame. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ikweyi koni nkokwokwoshi, ala kyogwu kpo oza ni nka ni lo! <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Anoho ipu kala ya yolobene ni shiya ase mo nyyo ozalabi hagye? Owoni okwokwoshi pini nyya ka la, ojiya ni ala kyogwu lo? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Ase ni wa ko Owuso oya pwoza ni Owuso ya ka ni. Oza ni ya ni ala pwo lo ni wa koni ala wako Owuso lalo.&gt;&gt;<verse eid="JHN 8:47" /></para>
  <para style="s">Ashishini ka Ase ko Oyahuda Tela ko Oyesu</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Awoyahuda ka danu mo, &lt;&lt;Aha ka gyogye lo, owoni aha kamo owase ko Osamariya, oki gbo omaku bibi?&gt;&gt;<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Oyesu ka dawa mo, &lt;&lt;Ngbo omaku bibi lo, ami geyagye da Ada hin ala ke mun nye. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ami ya tikpo shini ase na shamiye lalo, ashe ke yaba ni ya tikpo ni, anu wino kepwo. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Nyya ka dala okwokwoshi, kpiri kase ni yoza ni nfo mona ya ni, oya gekwu lo.&gt;&gt;<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Ikweyi kela mani, Oyahuda kamo, &lt;&lt;Kokwokwoshi agye kamo ogbo omaku bibi! Ibirayi kpa awobane gekwu, kwikyikyeni, okamo kpiri kase ni yoza ni ofu ni oya gekwu lo. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Oya ziyo byo osha ada ka aha Ibirayi la? Anu gekwu, mamani awobane ki gekwu. Awo miyo wa anoho?&gt;&gt;<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Oyesu kyogwu mo, &lt;&lt;Owoni nbi ziyun iso, ziyun iso hin bi ya wojije lo. Ada hin ni ala mo owo Owuso kala ni ya ngami iso. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Ala gyo lo, ami ke gyo. Owoni nkamo ngyo lo, nyya wino okame bya ala, nke gyo kweyi nyya geyagye dela nu. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Ada kala Ibirayi shotunehe ko moyi hin, oma kweyi otu nu sha.&gt;&gt;<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Awoyahuda ka do Oyesu mo, &lt;&lt;Awo fishayi aweho wa lo, oya kamo omi Ibirayi?&gt;&gt;<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Oyesu kamo, &lt;&lt;Nyya ka dala okwokwoshi, ome ana mi Ibirayi nyya ba!&gt;&gt; <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Ni Oyesu ka mani ni, akpakyo koto, Oyesu ke teba kweyi osho ole ko Owuso bita.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Oyesu do Ongo oye ni Amo wo Ofiyi ni Ogege</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Ni Oyesu ya shigbo ni, omongo oye ni amo wofiyi ni. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Awogboso doka mo, &lt;&lt;Inofoza, anoho yo ozalabi, ongo mani la kwe inanu kpa adanu, ni amo wo ofiyi ni?&gt;&gt;<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Oyesu kamo, &lt;&lt;Ongo mani kwe inanu kpa ada nu pini yozalabi lalo, omani ke gbodagye shini ase na moza ni Owuso ya gege koya bwebe ko ongo mani. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Owotiri shini na yoko kase ni tumoleho ni. Anani ni otu bi walo ni. Otu yawa biba ni ashishe ya yoko lo ni. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Byoni ntayayo yese ni, nwo oyoyu kese.&gt;&gt;<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Ni Oyesu ka mani, otehe shokpagye, oyikwabo kweyi oyi nyo ongo mani iyi. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Oka danu mo, &lt;&lt;Ga yi na ibwu ko Osiluwa,&gt;&gt; ikweyi nu wo Oleho. Ebeni ongo ni ga niyi, kweyi okwikye go ole ya mebe.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Awase ni bagye kwo kpa awase ni ba mo ni kwotu ko doka mo, &lt;&lt;Omani wo ongo ni ya yagye kweyi ya boza ni ona lo?&gt;&gt; <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Ashini kase kamo owanu.</para>
  <para style="p" vid="JHN 9:9">Ashini kamo, &lt;&lt;Aayi, obyanu kin la.&gt;&gt;</para>
  <para style="p" vid="JHN 9:9">Anu ke mo, &lt;&lt;Ami la.&gt;&gt;<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Adoka mo, &lt;&lt;Oyamoji niyi wo gwa?&gt;&gt;<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Okyogwu mo, &lt;&lt;Ongo ni aba yogwu mo Oyesu pini kwabo ka agye kweyi nyumiyi. Okadami mo na gi ibwu ko Osiluwa ga niyi. Ebeni ngga na, kweyi nmebe.&gt;&gt;<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Adoka mo, &lt;&lt;Ongo mani ye ebenya?&gt;&gt; Okamo, &lt;&lt;Ngye lo.&gt;&gt;<verse eid="JHN 9:12" /></para>
  <para style="s">Awofarisi Bwikpo ko Ogege mani</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Abyo ongo ni wo ofiyi oni webe ka Awofarisi. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Eno ni Oyesu kwabo ka agye kweyi gwofiyi mani iyi ni we eno ko minyo. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Awofarisi ki do ongo mani okamo oyamoji ome iyi nu gwa. Ongo ni kamo, &lt;&lt;Okwabo ka agye nyumiyi, kweyi ngga niyi, kweyi nmebe.&gt;&gt;<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Ashini ka Awofarisi kamo, &lt;&lt;Ongo mani bwebe ko Owuso lalo, koni oyoza ni ono wobi ni Eno ko Minyo.&gt;&gt;</para>
  <para style="p" vid="JHN 9:16">Ashini kase ke duwoka mo, &lt;&lt;Inozalabi yamoji ya gege ko yawoza ki igbashi mani?&gt;&gt; Bwebe ni okwunu wa kepa.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Ogwejeji nu akyikwikye gebe kofiyi mani kweyi akamo, &lt;&lt;Oji ni ogbo ko ka ikweyi nu? Awo pini ogwawo iyi la.&gt;&gt;</para>
  <para style="p" vid="JHN 9:17">Ongo oni kyogwu mo, &lt;&lt;Owinobane.&gt;&gt;<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Kwikyikyeni Ase ko Oyahuda kyogwu mo owofiyi ome agwani iyi lalo, gbishini atoleho gebe kene kpa ada ko ongo mani. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Aduwoka mo, &lt;&lt;Omani woyi kala la? Anu pini ala mo wo ofiyi la? Yamoji ni oya mebe anani?&gt;&gt;<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Inanu kpa adanu kamo, &lt;&lt;Aha gye mo owoyi ka aha la, aha ki gye mamo wofiyi. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Owe ni oke bwu ome oya mebe nabani, kwase ni gwaniyi ni aha gye lo. Ala doka. Owoyi leke kelo, ona ka dala okwunu nu.&gt;&gt; <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Inanu kpa adanu ka mani ikweyi koni aba yoshi ka Ase ko Oyahuda, ikweyi koni Ase ko Oyahuda kwobonu gbela mo kpiri kase ni kyogwu mo Oyesu wo Okristi aba yo ongma shekpa ka Ase ko Oyahuda. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ozani ya ni ene kpa ada nu kamo, &lt;&lt;Owo oyi leke kelo, ala doka.&gt;&gt; ni oma.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Aki yongo ni amo wofiyi mani ogwu wa komwepa kweyi aka danu mo, &lt;&lt;Shokoyi do Owuso moya kokwokwoshi! Aha gye mongo ni dawogege mani winozalabi la.&gt;&gt;<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Okyogwu mo, &lt;&lt;Owinozalabi kwe owe lo, nggye lo. Oje kponu pini nggye la. Gbikyikye nwwofiyi, anani ke nyya mebe!&gt;&gt;<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Ebeni adoka mo, &lt;&lt;Oyo moji? Oya moji gwawiyi?&gt;&gt;<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Okyogwu mo, &lt;&lt;Nkela mani dala wa ala ke zakpaha lo. Ojiya ni ala ba yimu ko pwo ko omwepa? Ala ba yimu ko wawogboso mamani la?&gt;&gt;<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Ebeni awoteyi ko Oyahuda sesa kotata mo, &lt;&lt;Awo dawo pini winogboso ongo mani la! Aha wawogboso Omusa la! <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Agye mo Owuso kela do Omusa, ongo mani ke agyebe ni obwanu wa ni lo.&gt;&gt;<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Ongo ni kyogwu mo, &lt;&lt;Anani owoza kigbashi! Ala gyebe ni obwanu wa ni lo, oke gwamiyi. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ahagye kamo Owuso ya pwela kawinozalabi lo. Oya pwela kase ni ya yoshi ko Owuso kweyi ki ya yoza ni oya yimu ni la. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Bwikyikyo kese ashishe pwo mo ashe gwiyi kase ni amo wofiyi ni wa lo. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Owoni ongo mani bi bwebe ko Owuso lalo, obi ya gege ya yoza mani lo.&gt;&gt;<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Aka danu mo, &lt;&lt;Awo ni amo ipu kozalabi ni, kweyi mo wa fahoza?&gt;&gt; Kweyi anenya.<verse eid="JHN 9:34" /></para>
  <para style="s">Opwiyi Ipu ko Omaku</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Oyesu pwo mo anenya, kweyi ishini opyo ni, okamo, &lt;&lt;Okyogwu kpo Oyi ka Asuse?&gt;&gt;<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Ongo oni doka mo, &lt;&lt;Adole, owanoho? Kadami shini na kyogwu kpanu.&gt;&gt;<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Oyesu kamo, &lt;&lt;Anani omo wa, anu pini ya kela kpawo ma.&gt;&gt;<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Ebeni ongo oni kamo, &lt;&lt;Adole, nkyogwu,&gt;&gt; Kweyi ogeyagye danu.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Oyesu kamo, &lt;&lt;Nwwese mani kowa kepwo la, nwwa shini ofiyi na mebe kweyi ase ni ba mebe ni na pwiyi.&gt;&gt;<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Ashini ka Awofarisi ni bebeni kpanu ni pwela mani kweyi adoka mo, &lt;&lt;Oji, aha wofiyi mamani ona?&gt;&gt;<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Oyesu kamo, &lt;&lt;Owoni ala bi wofiyi, ala bi ba gbozalabi lo, byonabani ke ni ala mala ba mebe ni, ozalabi kala yaba.&gt;&gt;<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Elase Ikweyi ki Inogbeho ko Obize</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />&lt;&lt;Nyya ka dala okwokwoshi, ase ni gipu koko kotukpo bwofunu lo, ke bwebye hoha, owowi kponyoza-oshu la. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Ase ni gipu bwowe kofunu anu pini winogbeho ko otukpo la. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Inogbeho ya gwofunu danu, kweyi otukpo ba gyoko nu. Oya yotukpo nu ogwu kpiye wa kweyi ya gwuwa gese. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Ishini obyakakanu kpiri wese, oya gohobu wa, kweyi otukpo nu ba gboso ikweyi koni agyoko nu ni. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Awa ke ba gbosogboga lo; nyya ka dala, aba nyinya wa sho ikweyi koni agyoko kogboga lo ni.&gt;&gt; <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />Oyesu kelase mani dawa, awa ke gyikweyi nu lo.<verse eid="JHN 10:6" /></para>
  <para style="s">Oyesu wi Ino Gbeho ko Obize Neshi</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Oyesu ki kamo, &lt;&lt;Nyya ka dala okwokwoshi, ami wofunu dawotukpo la. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Kpiri kase ni wa kwobonu dami ni awi kpawo nyoza-oshu la, otukpo ke pwela wa lo. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ami wofunu; ase ni gipu bwebe hin aba ngmanu. Oya gipu ya gese, kweyi oya pyikyashi ko ha. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Owi yawa kowa wi, ki ngmase kweyi yoza yishi kin la, ami ke wa shini ana pyo olayi, kweyi ana pye sheyi gagye.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />&lt;&lt;Ami wino gbeho ko obize neshi. Ino gbeho ko obize neshi ya zo olayi nu ikweyi ko otukpo nu. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Ase ni aro ko gbeho ko obize ni wine ko obize la lo. Ishini omi iwo-apashi ya wa, oya shotukpo bita kweyi ya nyinya nu. Ebeni iwo-apashi yawa kwo otukpo mani kweyi ya yuwa kya. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Anu oni ya nyinya nu ikweyi koni aro rora la, oya byotu kojije ikweyi ko otukpo mani lo.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />&lt;&lt;Ami pini winogbeho neshi la; ngyo otukpo hin kweyi otukpo hin gyun mamani. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Byoni Ada gyun kweyi ami gya Ada mamani kweyi nyya zo olayi hin ikweyi ko otukpo hin. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Ngbo otukpo shishini ni bipu kikpo mani lo ni. Owotiri dami ko byuwa wa. Awa ba pwoko hin mamani, kweyi aba wikpo ko obize oye kponu, inogbeho oye kponu. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />&lt;&lt;Ozani ya Ada hin ya yimu hin ni wo, nkyogwu ko gekwu shini na ki pyo olayi hin. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Ashishe ya yo olayi hin bize shun lo, ami ke yayi dawa kpotu hin oyekponu. Ngboshu ko ze nkyi gboshu ko kyanu nye. Omani wo ono ni Ada hin dami ni la.&gt;&gt;<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Ikweyi kela ni Oyesu ka ni okwunu ka Ase ko Oyahuda ke epa. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Nwashika wa ba kamo, &lt;&lt;Ogbo omaku bibi, kweyi nyoza. Ojiyala ba pwela nu?&gt;&gt;<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ashini ke kamo, &lt;&lt;Ela mani wela kase ni gbo omaku bibi ni lalo. Omaku bibi ya gege ya yofiyi ya mebe?&gt;&gt;<verse eid="JHN 10:21" /></para>
  <para style="s">Ase ko Oyahuda tela ko Oyesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Aba ri Imya ko gwo Ole ko Owuso Ojerusele, owishi ko oshu, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />kweyi Oyesu yipu ko Ole ko Owuso ya yawu ebe koyagye ko Osolomo. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Ashini ka Ase ko Oyahuda shogba to, ba kamo, &lt;&lt;Gbishi wonya ni oya shaha bita ipu kebe dibu? Owoni awo wo Okristi la ka daha okwokwoshi kin.&gt;&gt;<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Oyesu kyogwu mo, &lt;&lt;Nka dala, ala ke kyogwu lo. Oko ni nyya ipu kiye ka Ada hin ni yolobene ikweyi hin, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />ala ke ba kyogwu lo, ikweyi koni ala wo otukpo hin lo byoni nka dala ni. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Otukpo hin ba pwoko hin; ngyuwa, kweyi awa ba gbosun. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ndawa olayi ko gbogbo-gbogbo, aba gekwu lo. Ashishe ya gege ya yuwa bize shun lo. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Oza ni Ada hin dami ni shojoji, kweyi ashishe ya gege ya yuwa bize shabo ka Ada hin lo. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ami kpa Ada hin woye kponu la.&gt;&gt;<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Ebeni Ase ko Oyahuda kyi kpakyo ko takyo, <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Oyesu ke kadawa mo, &lt;&lt;Nyyoza kigbashi nwashika bwebe ka Ada dala. Onya ipu kawoko mani ni ala ba yimu ko tumakyo ikweyi nu?&gt;&gt;<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Awoyahuda kyogwu mo, &lt;&lt;Aha ba takyo ikweyi kawoza ni la lo, pa wikweyi karigbetu, ikweyi koni owasuse shishi, ya ziyo mowo Owuso.&gt;&gt;<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Oyesu kadawa mo, &lt;&lt;Ela mani ayitota ipu ko Ono kala mo, &lt;Nkamo ala wa awowuso la&gt; lo?&gt;&gt; <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Owoni oyuwogwu ma wa &lt;&lt;awowuso,&gt;&gt; awa ni ela ko Owuso yebe wa ni, Okpa ko Owuso ke ya kokame lo ko gbogbo-gbogbo, <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ase ni Ada sho mowa akaka nu kweyi otoleho wese ni lemoji? Ojiya ni ala ba kwumepwo karigbetu ikweyi koni nkamo, &lt;&lt;Nwwo Oyi ko Owuso ni? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Owoni nyyo oko ni Ada hin tumoleho ni lo, ala ka kyogwu kpami lo. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Owoni nke ya, kala kyogwu kpami kala kyogwu kpami lo, ala kyogwu kpo oza kigbashi, shini ala gyo okwokwoshi ma Ada yipu hin, kweyi ami yipu ka Ada.&gt;&gt; <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Aki takirikwu ko yo kwu, oke pa shabo wa.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Ebeni Oyesu kwikye sheyi ki ishu ko Ojoda gebe ni Oyohana ya yo Obatisma bwikyikyo ni ga yagye ebe ni. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Ase lewa webe nu. Akamo, &lt;&lt;Oyohana yoza kigbashi ebyibye lo, oza ni oke ka ikweyi ko ongo mani kpiri ni wo kwokwoshi.&gt;&gt; <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Kweyi ebe ni ase nwashika kyogwu kpo Oyesu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Iku ko Olazarus</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Agbo ongo oye iyenu wo Olazarus ya gbere. Obwogya leke ko Obetani, ogya ko Omeremu kpo oyinanu Omata. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Omeremu ni oyinanu wo Olazarus ya gbere ni, anu pini nyo Oyesu ano kpeye ikpo kweyi wikpo kpinyeyi kikweyi nu la. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Ayene nonya mani toleho ebe ko Oyesu mo, &lt;&lt;Adole, oyawo moshi ya gbere.&gt;&gt;<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Ishini Oyesu pwela mani okamo, &lt;&lt;Ere mani ya wa kikwu lo. Aayi owa ko byi igyashi wa do Owuso shini Oyi ko Owuso na pyo igyashi bwebe kere mani.&gt;&gt; <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Oyesu yimu ko Omata kpo oyinanu Omeremu kpo Olazarus. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Koni opwo mo Olazarus ya gbere ni, okwikpo hebe ni oyanu ni kenepa, <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />bwebe ni oka dawogboso mo, &lt;&lt;Ahan kwikye go Ojudiya.&gt;&gt;<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Awogboso kamo, &lt;&lt;Inofoza, ipu kishi gbayayi ni shigbo ni, Ase ko Oyahuda takirikwu ko takyo, kwikyikyeni oki ya kwikye ya gebe ni?&gt;&gt;<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Oyesu kyogwu mo, &lt;&lt;Agbo ogye igwepa ipu ke enoye la lo? Ase ni ya yawu isheno ya shikawu lo, ikweyi koni oya mebe bwebe koyoyu kese mani. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Owoni ase ya yawu otu oya shikawu, ikweyi koni ebe yoyu yaba danu lo ni.&gt;&gt;<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Ni Oyesu kela mani kweyi ni, ogohobu ko kela dawa mo, &lt;&lt;Oya ka aha ko Olazarus gbola, nke ya gebe ni koga shiyi.&gt;&gt;<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Awogboso kyogwu mo, &lt;&lt;Adole, owoni oya gbola, oya pyo ogege.&gt;&gt; <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Oyesu ya kela ikweyi kikwu nu, awogboso ke ba ma byo oya kela kola ni agye ni la.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Ebeni Oyesu ka dawa mo, &lt;&lt;Olazarus gekwu, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />kweyi ikweyi kala nshotunehe koni nyyebe ni lo ni, shini ala kyogwu. Ahan gebe nu.&gt;&gt;<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Ebeni Otoma ni aba yogwu mo ayapule ni ka dashini kawogboso mo, &lt;&lt;Ahan ga, shini an ga gekwu kpanu mamani.&gt;&gt;<verse eid="JHN 11:16" /></para>
  <para style="s">Oyesu wo Onyiso ka Amiri kpo Olayi</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Owowa nu, Oyesu pwo mo Olazarus kwobonu yeno ene amiri wa. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Enu ko Obetani kpo Ojerusele fomeli epa lo, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />kweyi Ase ko Oyahuda nwashika webe ko Omata kpo Omeremu kowa kawotu agye kikwu koyinawa. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Ishini Omata pwo mo Oyesu ya wa ni, oga gbayi kpanu owe, Omeremu ke yagye ole.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />Omata ka do Oyesu mo, &lt;&lt;Adole,&gt;&gt; Obi yebe ni, oyene hin bi ya gekwu lo. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Nke gye mo koni aba kela mani Owuso ya dawo ojoji ni odoka.&gt;&gt;<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Oyesu ka danu mo, &lt;&lt;Oyene wo kiya shiyi.&gt;&gt;<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Omata kyogwu mo, &lt;&lt;Nggye moya shiyi ishi ko nyiso ka amiri eno kokweyi.&gt;&gt;<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Oyesu ka danu mo, &lt;&lt;Ami wonyiso ikwu kpo olayi la. Ase ni kyogwu kpami, ko ogekwu, oya gbo olayi, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />kweyi ase ni yiyi kweyi ki kyogwu kpami oya gekwu goga lo. Okyogwu mani?&gt;&gt; <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />Okadanu mo, &lt;&lt;Nkyogwu, Adole, mawo wo Okristi, Oyi ko Owuso ni ya wipu kese mani ni.&gt;&gt;<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Ishini okela mani kweyi ni, okwikye ga yo oyinanu Omeremu ogwu gokoka. Okadanu mo, &lt;&lt;Inofoza wa, oya doka wo.&gt;&gt; <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Ishini Omeremu pwo mani, onyiso papa ga tanu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Ishi oni Oyesu fipu ko ogya wa lo, otayayo yebeni Omata ga tanu ni. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Ishini Ase ko Oyahuda ni bo ole kpo Omeremu ba kanotu agye ni ma ni onyiso papa gese ni, agboso, aba ma byoya ga amiri ko ga kyegba la.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Ishini Omeremu febeni Oyesu yanu kweyi omo ni, ogbo obutu nu kweyi kamo, &lt;&lt;Adole, owoni obi yebeni, oyenen bi ya gekwu lo.&gt;&gt;<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Ishini Oyesu mo ya kyegba kweyi Ase ko Oyahuda ni wa kpanu ni ba kyegba kpanu ni, oza ni domaku nu ose kotata kweyi otu nu bya. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Oduwoka mo, &lt;&lt;Ala yonyi ebenya?&gt;&gt;</para>
  <para style="p" vid="JHN 11:34">Aka danu mo, &lt;&lt;Adole, wa ma.&gt;&gt;<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Oyesu kyegba.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Ebeni Ase ko Oyahuda kamo, &lt;&lt;Medo ki imu ni ogbo danu ni!&gt;&gt;<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ashini wa ke kamo, &lt;&lt;Anu ni yofiyi mebe ni gege wobi kikwu ko ongo mani lo?&gt;&gt;<verse eid="JHN 11:37" /></para>
  <para style="s">Oyesu Sho Olazarus Iyi Bwikwu</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Otu ko Oyesu ki bya kotata kweyi ogebe ka amiri. Amiri ke yowu kokpo kweyi ayo okpo sokwunu ko owe. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Oyesu ka dawa mo, &lt;&lt;Ala yokpo oni bize.&gt;&gt;</para>
  <para style="p" vid="JHN 11:39">Omata, oyene ko ongo ni gekwu mani ke kamo, &lt;&lt;Adole, anani oya kwipi wa, koni oyebe ni keno ene yoma.&gt;&gt;<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Ebeni Oyesu kamo, &lt;&lt;Nka dawo mo owoni okyogwu oya mo igyashi ko Owuso lo?&gt;&gt;<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Mani oni ayokpo ni bize. Ebeni Oyesu ziyi iso kweyi kamo, &lt;&lt;Ada, nshotunehe dawo ikweyi koni opwela hin ni. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ngye mipu kishi kpiri oya pwela hin, npa ya ka mani wakoneshi kawase ni hagye mani, shini ana kyogwu mawo pini tumoleho la.&gt;&gt;<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Ishini okela mani kweyi ni, Oyesu yogwu kpoko nyakwu mo, &lt;&lt;Olazarus, wese!&gt;&gt; <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Ongo ni gekwu mani yawu wese, kweyi abo kpikpo nu lola kpo opa, kweyi ayiki kaheyi nu.</para>
  <para style="p" vid="JHN 11:44">Oyesu ka dawa mo, &lt;&lt;Ala yoyi shini ala shobita na ganu.&gt;&gt;<verse eid="JHN 11:44" /></para>
  <para style="s">Agbela ko Yo Oyesu Ngmo</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Mani oni, Awoyahuda nwashika ni webe ko Omeremu, kweyi na moza ni Oyesu ya ni, akyogwu kpanu. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ashini wa ke gebe ka Awofarisi ga ka dawoza ni Oyesu ya ni. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Ebeni awose kawosapa kpa Awofarisi yogwu kogbayi ko onongbo.</para>
  <para style="p" vid="JHN 11:47">Adoka mo, &lt;&lt;Aha ba ya moji yoni? Ongo mani ya yoza kigbashi nwashika. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Owoni aha shobita ya gohobu mani, ananoho ba kyogwu kpanu, kweyi ase ko Oroma bawa yo Ole ko Owuso kpagye ka aha bize.&gt;&gt;<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ebeni ashe ipu wa iye nu wo Okayafa, ni wosapa nyakwu ishayi oni, kela mo, &lt;&lt;Ala gyojije lo kpiri-kpiri! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ala gye moya shoshi dala shini ashe na gekwu ikweyi kasuse shoni ebi ya yo okpagye kpiri re ni lo?&gt;&gt;<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />Ela ni oka mani bwebe kiyinu lalo. Koni ishayi oni anu wosapa nyakwu la ni, obane mo Oyesu wa gekwu ikweyi ko okpagye kpiri, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />kweyi wikweyi ko okpagye oni kin lalo, ke wikweyi kayi ko Owuso ni pasha ni, shini ana kpuwa gbayi kweyi yuwa wo oye kponu. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Mani oni bwishi oni gohobu aba gbela ko yo ngmo.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Ikweyi koni Oyesu yawu ese kyaa ipu kase ko Oyahuda kelo. Abishi koni okwikye ga agbabo ni yokwunu kinweshi ni, ogogya leke oye ni aba yogwu mo Ifuremu ni, oga yagye ebe ni kpa awogboso.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Nishi ki Imya ko Sheyi ko Oyahuda yo pee ni, ase nwashika sho okpagye wa bita go Ojerusele, koni owodu wa ko ga yiyiwa na sere ebe ko Owuso gbeyi ki Imya ko Sheyi ni. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Abipu ko tikpo ko Oyesu, ishini ahagye ebe ko Ole ko Owuso ni, aba diyiwa oka mo, &lt;&lt;Ala ma moji? Oya wi Imya mani lo?&gt;&gt; <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Awose kawosapa kpa Awofarisi kwobonu zoko mo ase ni wa gyebe ni Oyesu yanu ni, ona ka shini ana yo kwu.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Asho Oyesu Ano Obetani</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Imya ko Sheyi sheno ihiri, Oyesu go Obetani, ebe ni Olazarus ni Oyesu yo nyiso ikwu ni. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ebeni ayozarore ko onose do Oyesu. Omata kozarore dawa, kweyi Olazarus yipu kawase ni bagye oka ko roza kpanu ni. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Ebeni Omeremu zogya ka ano kpeye ni gbakwekye ni, osho Oyesu ikpo kweyi yikpo wa kpinyeyi kikweyi nu. Ebebenya ole ni kpeye kpano.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Ashe ipu kawogboso Oyesu ni aba yogwu mo Oyahuda Iskariyoti ni wa yo ra ni kamo, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />&lt;&lt;Ojiya ni oya ya ano mani yishi? Abi yano mani ra kweyi yikwiri yi dawoleha. Ikwiri kano oni ya go odinari ogbogbo eta.<note caller="+" style="f"><char style="fr" closed="false">12.5 </char><char style="fq" closed="false">odinari ogbogbo eta. </char><char style="ft" closed="false">Ikwiri mani wikwiri leke lalo. Imbe ase na pyikwiri mani okpagye wa, oya yoko kishayi oye.</char></note>&gt;&gt; <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Okela mani ikweyi koni owowi ni la, oya byotu ikweyi kawoleha lalo, anu pini ya byikwiri la, oka mani ikweyi koni oya tiyinu abo kpoza ni aba tipu kolashiko ni.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Oyesu kamo, &lt;&lt;Ala shobita, ona shanoni bita gbeyi ke eno ni aba yun nyi ni. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Oleha baba kpala ishi kpiri, ami ke ya yo kpala ishi kpiri lo.&gt;&gt;<verse eid="JHN 12:8" /></para>
  <para style="s">Agbela ko Yo Olazarus Ngmo</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Awoyahuda nwashika pwo mo Oyesu yo Obetani, aga ko ga mo ki kpo Olazarus ni nyiso ikwu ni. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Ebeni oteyi kawosapa ya tikpo ko yo Olazarus ngmo mamani, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />koni ikweyi nu pyi Ase ko Oyahuda nwashika ba gebe ko Oyesu kweyi aba kyogwu kpanu la.<verse eid="JHN 12:11" /></para>
  <para style="s">Oyesu Go Ojerusele</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Gbebenya, ogbayi kewa ni wi Imya ko Sheyi ni pwo mo Oyesu yowe ko go Ojerusele. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Agokwari kweyi bose ko ga gbayi kpanu, ba sheha mo,</para>
  <para style="b" vid="JHN 12:13" />
  <para style="q1" vid="JHN 12:13">&lt;&lt;Osanna!&gt;&gt;</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Otunehe yo kpase ni yawa ipu kiye ka Adole ni!&gt;&gt;</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Otunehe yo kpo Ose ki Izrayila!&gt;&gt;<verse eid="JHN 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14" />Oyesu pyo oyi kodagyi oye kweyi oyagye ikweyi nu byoni ayitota ni mo,</para>
  <para style="q" vid="JHN 12:14">1 <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />&lt;&lt;Ala ka yoshi kojije lo, Ayi nonya ko Osiyona;</para>
  <para style="q2" vid="JHN 12:15">Ala ma, ose kala yawa oma,</para>
  <para style="q2" vid="JHN 12:15">Oyagye ikweyi ko oyi ko odagyi!&gt;&gt;<verse eid="JHN 12:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ikyikyo awogboso gyawoza mani lo. Ishini azo Oyesu ipu ko igyashi nu ome agye mawoza mani ayitota ikweyi nu kweyi ayawoza mani danu.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ishini ewa kasuse ni bebeni ishini oyo Olazarus ogwu bwa amiri kweyi nyiso ni agohobu ko koshu mani ebebe nya. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Ase lewa, ikweyi koza kigbashi ni apwo moya ni, abose gese ga gbayi kpanu. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Awofarisi ka diyiwa mo, &lt;&lt;Ala ma! Aha ngmeyi koza ni aha bose ko ga ya ni wa lo. Ala ma ni ese kpiri ba kanu ni!&gt;&gt;<verse eid="JHN 12:19" /></para>
  <para style="s">Oyesu Kela Ikweyi ki Iku Nu.</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Ishi oni ashini ko Ogirik bipu kawase kwagye ishi ki Imya ko Sheyi ni. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Awebe ko Ofilibus, anu ni wase ko Obetseda ipu ka agye ko Ogalili ni, awa bo mo, &lt;&lt;Adole, aba yimu ko mo Oyesu.&gt;&gt; <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Ofilibus ga kado Andru; Andru kpo Ofilibus ga kado Oyesu.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Oyesu kyogwu mo, &lt;&lt;Ishi gye wa ni aba do Oyi ka Asuse igyashi ni. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Nyya ka dala okwokwoshi, owoni ikpo ke ewo gbo okpagye kweyi gekwu lalo, oya wikpo oye kin la. Owoni oke gekwu, oya mikpo nwashika. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Ase ni yimu ko olayi nu oya yi tonu, ase ni ke tela ko olayi nu ese mani oyi tagye ko gbogbo-gbogbo. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Ase ni ya yimu ko yoko dami, owotiri danu ko gbosun. Kweyi ebe ni nyyanu ni, oyole hin ya yebe ni mamani. Kweyi Ada hin ya dayole hin kpiri abokpa.<verse eid="JHN 12:26" /></para>
  <para style="s">OYesu Kela Ikweyi Ki Ikwu Nu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />&lt;&lt;Nabani otu hin bya, kweyi nyya kamoji? Na kamo, &lt;&lt;Ada ngmami shipu kishi mani?&gt;&gt; Aayi, ikweyi kishi mani pini wa la.&gt;&gt; <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Ada, ziye wo iso!&gt;&gt;</para>
  <para style="p" vid="JHN 12:28">Ebeni oko bwipu ki iso ya kamo, &lt;&lt;Nkwobonu zo iso wa, nki ya zo iso.&gt;&gt; <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Ewa kasuse ni bebeni pwo mani akamo akpula gbo, ashini wa mo oyoleho kela danu.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Oyesu kamo, &lt;&lt;Oko mani kela ikweyi koneshi kala la, kaka hin lalo. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ishi mani wishi ko kepwo kese mani, anani aba nose kese mani enya. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Kweyi ami, ishi ni angmami bwamiri, nyya pyase kpiri webe hin.&gt;&gt; <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Oka mani shini ase na gyedo kikwu ni oya wa ga ni.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Ewa kasuse ka danu mo, &lt;&lt;Aha pwo ipu ko ono ka aha mo Okristi wa yo kpaha ko gbogbo-gbogbo, bwowe wonya ni oya kamo, &lt;&lt;Owotiri shini ana ngmo Oyi ka Asuse bwamiri&gt;&gt;? Anoho wo &lt;&lt;Oyi ka Asuse mani?&gt;&gt;<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Ebeni Oyesu kadawa mo, &lt;&lt;Oyoyu mani tayayo kpala kishi gbayayi kin la. Ala yawu anani ni ola yaba ni, shini ebe dibu naka tala lo. Ase ni ya yawu ipu kebe dibu oya gyebe ni oya ga ni lo. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Ala kyogwu oyoyu anani ni oyoyu yaba ni, shini ala wayi kebe yoyu.&gt;&gt; Ishini okela kweyi ni, Oyesu shuwa bita kweyi ga teba nu.<verse eid="JHN 12:36" /></para>
  <para style="s">Ase ko Oyahuda Kyogwu kpo Oyesu Lo</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Ko ni Oyesu yawoza kigbashi mani kpiri obutu wa ni, akyogwu kpanu lo. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Omani kpiri gbodagye shini oza ni inobane Ishaya ka ni na gya, okamo:</para>
  <para style="q" vid="JHN 12:38">&lt;&lt;Adole, anoho ya kyogwu kposhu kaha kweyi awanoho ni ashawo oshu ka Adole?&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">12.38 </char><char style="ft" closed="false">Ishaya 53.1</char></note><verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Ozani ya ni aba kyogwu lo ni oma, ikweyi koni, byoni Ishaya ki ka ebye ni mo:<verse eid="JHN 12:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;&lt;Owuso yuwa wo ofiyi, kweyi yuwotu gbo shini anaka ma kpiyi wa lo, anaka gyikweyi nu ipu kotu wa lo, ake naka kwikye webe hin shini na dawogege lo.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">12.40 </char><char style="ft" closed="false">Ishaya 6.10</char></note> <verse eid="JHN 12:40" /><verse number="41" style="v" sid="JHN 12:41" />Inobane Ishaya ka mani ikweyi koni omigyashi ko Oyesu kweyi okela ikweyi nu.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Kwikyikyeni ipu kishi oni ase nwashika kpa ashini kawoteyi ko Oyahuda kyogwu kpanu. Ikweyi ka wo Ofarisi ake ka shese lo koni aba yoshi mo aba yuwa ngma shekpa ni, <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />ikweyi koni aba yimu mo asuse na shawiye shiye shosha bwebe ko Owuso.<verse eid="JHN 12:43" /></para>
  <para style="s">Ela Ko Oyesu Kepwo</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Ebeni Oyesu ka kpoko nwa mo, &lt;&lt;Ase ni kyogwu kpami, okyogwu kpami kin lalo, oke kyogwu kpase ni tumoleho ni. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Ase ni tiyi mun, oya mase ni tumoleho ni. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Nwwipu kese byoyoyu, shini kpiri kase ni kyogwu kpami naka yagye ipu kebe dibu lo.<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />Kpiri kase ni ke pwela hin kweyi yoko kpanu lo, nyya kwepwo lo. Ikweyi koni nwwa ko kwe ese epwo lalo, nke wa ko ngmese la. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Inokepwo oye yaba dase kpiri ni tela hin kweyi kyogwu kpe ela hin lo ni, ela ni nka ni ya kuwepwo eno ko kweyi. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Ikweyi koni ela ni nyya ka ni bwebe hin lalo, Ada ni tumoleho ni ke kadami oza kpiri ni nyya ka ni. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Koni ngye mela nu ya dase olayi ko gbogbo-gbogbo. Mani oni ojoji ni nka ni woza ni Ada kadami mo na ka ni kin la.&gt;&gt;<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Oyesu Na Ayole Nu Ikpo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Ome Imya ko osheyi nawa, Oyesu gye mishi gye koni oya shese bita ya gebe ka Ada ni. Oya yimu kase nu ni bese ni, oshawa imu nu sheyi gagye.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Oyesu kpayole nu ba roza ko onose kweyi ibiri gipu kotu ko Oyahuda Iskariyoti, oyi ko Osimo koyo Oyesu ra. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Oyesu gye mo Ada yoshu kojoji danu abo, oki gye manu bwebe ko Owuso, oki ya kwikye gebe ko Owuso, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ebe ni ongma abo shozarore, oyo oshiye nu kese yi ngma, kweyi oya ayiki gbo ogbeyi. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Oshinyo sho obatu kweyi kwotu ko nayole nu ikpo, kweyi okpayiki ni ogbogbeyi ni ya wuwikpo.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Owebe ko Obitrus, Obitrus ka danu mo, &lt;&lt;Adole, oya numikpo ona?&gt;&gt;<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Oyesu kyogwu mo, &lt;&lt;Oya gyoza ni nyya ya mani wa lo, ishi yawa ba ni oya wa gye ni.&gt;&gt;<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Obitrus kamo, &lt;&lt;Aayi, oya numikpo Ishi oyoye lo.&gt;&gt;</para>
  <para style="p" vid="JHN 13:8">Oyesu kyogwu mo, &lt;&lt;Owoni nnikpo lo, oyipu hin lo.&gt;&gt;<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Ebeni Obitrus kamo, &lt;&lt;Adole, ikpo hin kin pini oya na lalo, kabo kpikweyi hin kpiri!&gt;&gt;<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Oyesu kyogwu mo, &lt;&lt;Ase ni kwobonu gwiye, oya yimu ko nikpo kin la, koni oyikpiye nu kpiri yi na sere ni. Kpiri kala gbinyi lo, ashe kponu pi gbinyi la.&gt;&gt; <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Ogyase ni wa yo ra ni, oza ni ya ni okamo kpiri wa pini le sere lalo ni oma.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Ishini onuwikpo kweyi ni, okyo oshiye nu kese kpo shoko kweyi kwikye ga yagye. Oduwoka mo, &lt;&lt;Ala gyoza ni nyyala mani?&gt;&gt; <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Ala ba yumogwu mo &lt;Inofoza&gt; kpa, &lt;Adole,&gt; Kokwokwoshi, oza ni nwwe ni oma. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Nabani ami Adole kala kpi Inofaloza nalikpo, ala niyikala ikpo mamani. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Nyya mani shini ala gbami la, ala ya byoni nyyala ni. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Nyya kadala okwokwoshi, oyole oyoye ya sha adole nu lo, oyoleho oyoye ya shase ni toleho ni lo. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Nabani nala gyoza mani kpiri ni, owoni ala yuwa, aba sala aboneshi.<verse eid="JHN 13:17" /></para>
  <para style="s">Oyesu Ka Ase ni wa Yo Ra ni</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />&lt;&lt;Nyya kela kpala kpiri lalo, nggyawase ni nshu ni. Omani ke wako yoza ni okpa ka ni na gbodagye mo, &lt;Ase ni ya roza owatu oye kponu kpami ni pini womonyekwotu hin la.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.18 </char><char style="ft" closed="false">Okpa ki Igye 41.9</char></note><verse eid="JHN 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19" />&lt;&lt;Nyya kadala nabani ome onawa gbodagye, ishini owa gbodagye, ala ba kyogwu mo Nwwase ni Nwwe ni. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Nyya kadala okwokwoshi, ase ni zase ni ntoleho ni ozun pi yoma, kweyi ase ni zun ozase ni tumoleho ni.&gt;&gt;<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Ishini Oyesu kela mani kweyi ni, ozani domaku nu ose kotata kweyi oyolobene mo, &lt;&lt;Nyya kadala okwokwoshi, ashe ipu kala ya yun ra.&gt;&gt;<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Ebeni awogboso kwotu ko tiyi miyiwa ikweyi koni agyase ni oya kela ikweyi nu ni lo. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Ashe ipu wa, oyole ni Oyesu ya yimu kotata ni yagye kwo. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Osimo Obitrus shase ni yagye kwo Oyesu mani ekwu kweyi kamo, &lt;&lt;Doka mo anoho ni oya kela ikweyi nu.&gt;&gt;<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Anu ke bagye so kweyi doka mo, &lt;&lt;Adole, anoho ome la?&gt;&gt;<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Oyesu kyogwu mo, &lt;&lt;Ase ni nyyo ofofa kikyoga kwipu kowatu kweyi danu, anu oma.&gt;&gt; Ebeni oyo fofa kikyoga kwipu kowatu, oyi do Oyahuda Iskariyoti, oyi ko Osimo. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Ni Oyahuda ya zikyoga ni, ebebeni Ibiri gipu kotu nu.</para>
  <para style="p" vid="JHN 13:27">Oyesu kadanu mo, &lt;&lt;Oza ni oya yimu ko ya, ya papa.&gt;&gt; <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Ashishe ipu wa ni ke bebe kozarore ni gyoza ni ya ni Oyesu ya ka mani do Oyahuda ni lo. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Koni Oyahuda wino byikwiri ni, ashini kayole ba ma byo Oyesu ya kadanu mona ga roza ni aba ri Imya ni kwe ko dawoleha oza la. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Ni Oyahuda ya zikyoga ni, ebebeni obose gese. Ishi oni otu kwobonu bi.<verse eid="JHN 13:30" /></para>
  <para style="s">Ono Pepe</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Ishini oya ga ni, Oyesu kamo, &lt;&lt;Nabani ado Oyi ka Asuse abokpa kweyi aziye ko Owuso iso bwebe nu. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Owoni aziye ko Owuso iso bwebe nu, Owuso ya do Oyi abokpa ebe kiyinu, kweyi oya danu abokpa ebebeni.<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />&lt;&lt;Ayi hin, nyya yo kpala kishi gbayayi kin la. Ala ba wa tikpo hin, byoni nka dase ko Oyahuda ni, mamani nyya ka dala nabani. Ebeni nyya ga ni, ala ba gege ko ga lo.<verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />&lt;&lt;Nyya dala ono pepe. Ala yimu kiyi kala. Byoni nyyimu kala ni, mamani owotiri shini ala yimu kiyi kala. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Bwebe ko mani ase bagye mala wayole hin, owoni ala yimu kiyikala.&gt;&gt;<verse eid="JHN 13:35" /></para>
  <para style="s">Obitrus Tawashu ko Oyesu</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Osimo Obitrus doka mo, &lt;&lt;Adole, ebenya ni oya ga?&gt;&gt;</para>
  <para style="p" vid="JHN 13:36">Oyesu kyogwu mo, &lt;&lt;Ebeni nyya ga ni, ala ba gbosun anani lo, ala ke bawa gbosun ishi oye.&gt;&gt;<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Obitrus doka mo, &lt;&lt;Adole, ojiya ni nyya gboso anani lo? Nyya gege ya gekwu dawo.&gt;&gt;<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Ebeni Oyesu kyogwu mo, &lt;&lt;Oya gege ya gekwu dami? Nyya kadawokwokwoshi, ome obogwu na tono, oya tawashu hin igbeta!&gt;&gt;<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Oyesu Wowe ko Gebe ka Ada</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Oyesu ka dawa mo, &lt;&lt;Otu kala naka bya lo. Ala kyogwu kpo Owuso, ala ki kyogwu kpa ami mamani. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Ole ka Ada hin gboda nwashika, owoni olemani lo, nbi ya kadala. Nyya ga kyebetu dala. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Kweyi ishini ngga kyebe tu dala, nyya kwikye wa kpala gebe ni, shini ala ga bagye kpami ebe ni nyyanu ni. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Ala gyowe kebe ni nyya ga ni.&gt;&gt;<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Otoma kadanu mo, &lt;&lt;Adole, aha gyebe ni oya ga ni lo, aba yamoji ome agyowe?&gt;&gt;<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Oyesu kyogwu mo, &lt;&lt;Ami wowe, nwwokwokwoshi, nwwo olayi. Ashishe ya gebe ka Ada lo, owotiri ko bwebe hin. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Ala bi gyun kwokwoshi, ala bi ya gya Ada hin mamani. Bwanani gohobu, ala gyo kweyi ala ki mo iyi kala.&gt;&gt;<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Ofilibus kamo, &lt;&lt;Adole, shiyaha Ada, aki ba doka kojije kelo.&gt;&gt;<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Oyesu kamo, &lt;&lt;Ogyun lo Ofilibus, koni nyyagye kpala gbeji mani? Kpiri kase ni mun, oma Ada hin. Oyamoji ya mo, &lt;&lt;Shiyaha Ada&gt;&gt;? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Ala kyogwu mami yipu ka Ada, kweyi Ada yipu hin lo? Ela ni nyya kadala nyya ka kposhu kiyun lalo. Abishi koni, Ada hin, ni yipun ni, anu pini ya yoko nu la. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Ala totu sun ishini nka dala mun nyyipu ka Ada, kweyi Ada yipun, kwe ala totu sun ikweyi koko kigbashi ni nyya ni. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Nyya ka dala okwokwoshi, kpiri kase ni totu sun oya yoza ni nyya ya ni. Oya ya shoza ni nyya ni, ikweyi koni nyya gebe ka Ada ni. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Kweyi nyya yojoji ni ala doka ipu kiye hin, shini ana da Ada abokpa bwebe ko Oyi. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Owoni ala doka kojoji ipu kiye hin, nyya ya dala.<verse eid="JHN 14:14" /></para>
  <para style="s">Okoyi ko Omaku ko Owuso</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />&lt;&lt;Owoni ala ba yimu hin, ala ba geyagye do ono hin. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Kweyi nyya ba Ada hin, kweyi oya dala ino talabo, kowa yagye kpala ko gbogbo-gbogbo. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Ino talabo oni wo Omaku ko okwokwoshi. Ese ya zo lo, ikweyi koni oya gege ya mo lo, oke ya gyo lo. Ala ke gyo, ikweyi koni oyo kpala ki yipu kala ni. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Nyya shala bita byayokwu lo, nyya kwikye ya webe kala. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Ipu kishi gbayayi gohobu, ese ba mun kelo, ala ke ba mun. Ikweyi koni nyyiyi, ala ki biyi mamani. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Eno ni ala ba gye mo nyyipu ka Ada, kweyi ala bipu hin byoni ami yipu kala ni. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Kpiri kase ni gyo ono hin kweyi yoko kpanu, anu pini wase ni yimu hin la. Ase ni yimu hin, Ada hin ya yimu nu kweyi ami ki ya yimu nu mamani kweyi nyya yiyun shiyanu.&gt;&gt;<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Ebeni Oyahuda (Iskariyoti lalo) kamo, &lt;&lt;Adole, ojiya ni oya yimu ko yiyo shiyaha kweyi ya yimu ko shiye ese lo?&gt;&gt;<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Oyesu kyogwu mo, &lt;&lt;Kpiri kase ni yimu hin, oya geyagye doza fofun. Ada hin ya yimu nu, kweyi aba webe nu ba wa bagye kpanu. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Kpiri kase ni yimu hin lo, oya geyagye dozafofu hin lo. Ela ni ala pwomani wakaka hin lalo, ela ka Ada hin ni tumoleho ni la.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />&lt;&lt;Nka awoza mani ishini ntayayo yo kpala ni. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Ino talabo, Omaku ko Owuso ni Ada ya toleho ipu kiye hin ni, ya wa faloza kpiri kweyi ki ya rala ojoji ni nka dala ni. <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />Nshala bita kpo omene, omene hin pini ndala la. Ndala byoni ese ba dase ni lalo. Ala ka yotu kala na bya lo, ala ka yoshi lo.<verse eid="JHN 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28" />Ala pwo ni nkamo, &lt;&lt;Nyya shalabita, kweyi nkyi ya kwikye webe kala.&gt;&gt; Owoni ala bi ba yimu hin, ala bi ba shotunehe koni nyya gebe ka Ada ni, koni Ada shun. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Nka dala nabani ome onawa gbodagye, shini ishini owa gbodagye ala ba totu sun. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Nyya kela kpala nwa kelo, ikweyi koni ose kese mani yawa. Ogboshu ikweyi hin lo, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />oke yawa shini ese na gye mo nyya yimu ka Ada kweyi nyya yoza ni Ada zoko dami mona ya ni gyogye.</para>
  <para style="p" vid="JHN 14:31">&lt;&lt;Ala nyiso shan ga shebe ni.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Oyesu we Efu ki Inebi Kokwokwoshi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />&lt;&lt;Ami we efu ki inebi ko kwokwoshi, Ada hin pi wino kyanutu la. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ayabo wonyonya ni yikpiye hin kweyi ya gwa lo oya yi go tonu, kweyi ayabo ni ya gwa, oya kyanutu shini ona gwa she mani. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Akwobonu yala wase sere wa bwebe kela ni nka dala ni. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ala bipu hin, ami ya yipu kala mamani. Ayabo ke efu oyoye ya gege ya gwa fufunu lo, owotiri shini ona yipu ke efu ki inebi. Ala ba gege ba gwa lo owoni ala bipu hin lo.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />&lt;&lt;Ami wefu ki inebi, ala wa ayabo. Owoni ala bipu hin kweyi ami yipu kala, ala ba gwa nwashika, owami lalo, ala ba gege ko yojije lo. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Owoni ala bipu hin lo, ala lema bya ayabo ni ayi go tonu kweyi efu ongmongmo, edo kayabo kefu oni aba yi kpo tukpa kweyi yola kwo. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Owoni ala bipu hin kweyi ela hin yipu kala, ala ba doka kojoji nala ba yimu, kweyi aba ya dala. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Omani ya wigyashi ka Ada hin, owoni ala gwa nwashika, oni ya shiyase mala wa awogbosun.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />&lt;&lt;Byoni Ada yimu hin ni, mamani ami yimu kala. Nabani ala bagye ipu kimu hin. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Owoni ala geyagye do ono hin, ala ba bagye ipu ki imu hin, byoni ami geyagye do ono ka Ada hin ni kweyi nyyagye ipu kimu nu. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Nkoza mani dala shini otushosha hin na yipu kala kweyi otushosha kala na gya. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Ono hin yoma: Ala yimu kiyikala byoni nyyimu kala ni. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Imu yoya oyoye shomani kelo, ni ase zo olayi nu ikweyi kawoya nu. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Ala wawo oya hin owoni ala yoza ni nka ni. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Nyya yala ogwu mayole kelo, ikweyi koni oyole ya gyoko ka adole lo. Abishi koni nyyala ogwu mawo oya hin, ikweyi koni nyyala gyojoji ni nfu bwebe ka Ada hin ni. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ala pi shun lalo, ami pi shala la kweyi ndala oko ko ya, ala ga gwa nwashika bye efu, ogwogwa ni ya rese ni. Owoni ala ya mani, Ada ya daloza kpiri ni ala doka ipu kiye hin. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Ono hin yoma: ala yimu kiyi kala.<verse eid="JHN 15:17" /></para>
  <para style="s">Ese Tela ka Awogboso Oyesu</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />&lt;&lt;Owoni ese tela kala, ala gye ipu kotu kala mo otela hin kwobonu dala. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Ala bi wa kese, obi ya yimu kala koni ala wakaka nu ni. Byoni owe ni, ala wa kese lalo, npa shala bwipu kese. Oza ni yese ya tela kala ni oma. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Ala rela koza ni nka dala ni mo, &lt;&lt;Oyole oyoye sha adole nu lo.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">15.20 </char><char style="ft" closed="false">Oyohana 13.16</char></note> Owoni adami egye, aki ba dala egye mamani. Owoni ageyagye do ozafofu hin, aki ba geyagye do ozafofu kala mamani. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Aba yala mani ikweyi koni ala wakaka hin, ikweyi koni agyase ni tumoleho ni lo. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Owoni nbi wa kela dawa lalo, abi ba kwuwepwo kozalabi lo. Nabani, agbawashu oyoye kota ikweyi kozalabi wa lo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Kpiri kase ni tela hin, otela ka Ada hin mamani. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Owoni nbi yawoza ni ashishe ya ebibye lo ni ebe wa lalo, abi ba kwuwepwo ko ozalabi lo. Nabani ake ma kwikyikyeni atela hin, kami ka Ada hin. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Omani ke gbodagye shini oza ni ayitota ipu ko Ono wa ni na gya mo: &lt;&lt;Atela hin kin, gbikweyi lo gbotu lo.<note caller="+" style="f"><char style="fr" closed="false">15.25 </char><char style="ft" closed="false">Okpa ki Igye 35.19; Okpa ki Igye 69.4 </char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />&lt;&lt;Ishini ino talabo oni wa, anu ni nyya toleho bwebe ka Ada ni, Omaku kokwokwoshi ni bwebe ka Ada ni, oya yolobene ikweyi hin. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Kweyi owotiri dala shini ala yolobene mamani, koni ala bagye kpami bwikyikyo ni.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />&lt;&lt;Nkawoza mani kpiri dala shini ala ka gebi lo. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Aba nala enya shekpa, nyya kadala, ishi yawa ba ase ba ngmala, kweyi aba ma byo aba yoko ko Owuso. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Aba yaloza mani ikweyi koni agya Ada lo, ake gyun lo. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Nkwobonu kela mani dala, shini owoni ishi wa gye, ala ba ra mo npyala akpaha ikweyi nu. Nkela mani dala bwikyikyo lo ikweyi koni ntayayo yo kpala.<verse eid="JHN 16:4" /></para>
  <para style="s">Oko ko Omaku ko Owuso</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Nabani ke, nyya gebe kase ni tumoleho ni, kwikyikyeni ashishe kala gege dumoka mo, &lt;&lt;Ebenya ni oya ga lo?&gt;&gt; <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Otu kala pa bya ikweyi koza ni nka mani. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Nke ya kadala okwokwoshi, ogoga hin ya shoshi dala. Owoni ngga lalo, ino talabo ya webe kala lo, owoni nke ga, nyya toleho webe kala. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Ishini owa, oya wa kwese epwo ikweyi kozalabi kpo oza neshi, kpepwo koka ko Owuso: <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />ikweyi kozalabi, koni asuse totu sun lo ni, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ikweyi ko neshi, koni nyya gebe ka Ada, ebe ni ala ba mun kelo ni, <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />ikweyi kepwo koka, koni kwobonu kwo ose kese mani epwo wa.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />&lt;&lt;Nggbela nwashika ko ka dala, ala ba gege ko yi byi ikweyi anani lo. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ishini ano Omaku ko okwokwoshi ke wa, oya shiyala owe ipu kokwokwoshi kpiri. Oya wa kela kabiyinu lalo, oya koza ni opwo ni kin la, kweyi oya kawoza ni ba wa gbodagye ni dala. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Oya yun ya gbigyashi ikweyi koni oya zoza ni wakaka hin ni ya yi shiyala. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ozani Ada gbo ni kpiri wakaka hin la. Ozani ya ni nkamo Omaku wa zoza ni wakaka hin ni ya yi shiyala ni oma.<verse eid="JHN 16:15" /></para>
  <para style="s">Otubyobya ka Awogboso Ya Pya wo Otunehe</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Oyesu gohobu kpela koka mo, &lt;&lt;Ipu ki ishi gbayayi ala ba mun kelo, kweyi ipu ki ishi gbayayi ala ki ba mun.&gt;&gt;<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Ikweyi kela mani, ashini kawogboso diyiwa oka mo, &lt;&lt;Ikweyi kela nu mani lemoji ni oya kamo, &lt;&lt;Ipu ki ishi gbayayi ala ba mun kelo, kweyi ipu ki ishi gbayayi ala ki ba mun?&gt;&gt; Oki kamo &lt;&lt;Ikweyi koni nyya gebe ka Ada.&gt;&gt; <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Abipu ko doka mo, &lt;&lt;Ojiya ni oya kamo &lt;ipu ki ishi gbayayi&gt;? Aha gyikweyi koza ni oya ka ni lo.&gt;&gt;<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Oyesu gye mo aba yimu ko doka koza mani, oka dawa mo, &lt;&lt;Ozani ala ba diyi kala oka ni ona, ni nkamo, Ipu ki ishi gbayayi ala ba mun kelo, kweyi ipu ki ishi gbayayi ala ki ba mun ni?&gt;&gt; <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Nyya kadala okwokwoshi, ala ba kyegba kweyi ba byotu kotata, ese ke ya shotunehe. Otu kala ya bya, otubyobya kala ke ya pya wotunehe. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Ishini onya ya moyi oya dose koni ishi nu gye ni, otu nu ya sha ishini oke yoyi ma, oya nwanyi kpose ikweyi koni omoyi wipu kese ni. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Mamani ala: ishi kotu byobya kala pi yoma, nki yawa mala kweyi ala ba shotunehe, kweyi ashishe ya yotunehe kala bize lo. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Eno ni ala ba dumoka kojije kelo. Nyya kadala okwokwoshi, Ada hin ya dala ojoji ni ala doka ipu kiye hin. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Kwikyikyeni ala doka kojije ipu kiye hin wa lo. Ala doka ala ba pye, kweyi otunehe kala ya gyogya.<verse eid="JHN 16:24" /></para>
  <para style="s">Refu Ikweyi Kese</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />&lt;&lt;Ko ni nyya kela ipu kelase ni, ishi yawa ba ni nyya kela mani kelo ni, npa yawa kela shese dala ikweyi ka Ada hin. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Eno oni ala ba doka ipu kiye hin. Nyya kamo nyya da Ada oka okwunu kala lalo. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Aayi, Ada abiyinu ya yimu kala ikweyi koni ala yimu hin kweyi totuse mo nwa bwebe ko Owuso ni. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Nbwebe ka Ada wipu kese: anani nyya shese bita kweyi ya kwikye gebe ka Ada.&gt;&gt;<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Ebeni awogboso Oyesu ka danu mo, &lt;&lt;Anani oya kela tiriri kweyi okelase kelo. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Anani aha gye mogyojoji kweyi ashishe shu ko doka kojije kelo. Omani yaha kyogwu mo obwebe ko Owuso la.&gt;&gt;<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Oyesu kyogwu mo, &lt;&lt;Anani ala kyogwu wa?&gt;&gt; <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Ishi yawa ba, kweyi oyiwa wa, ni aba yala kya, ananoho ya kwowe kole nu. Ala ba wa shunbita fufun. Ami ke yo fufun lo, koni Ada hin yo kpami ni.<verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />&lt;&lt;Nka dala oza mani shini ala gbo omene ipu hin. Ipu kese mani ala ba mowe. Ipu kese mani ala ba gbotu gbagba. Ala ka byotu lo! Nkwobonu yese gwagye wa.&gt;&gt;<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Oyesu Tinarigwu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Ishini Oyesu kela kweyi ni, oziyi iso kweyi tinarigwu mo:</para>
  <para style="b" vid="JHN 17:1" />
  <para style="pi" vid="JHN 17:1">&lt;&lt;Ada hin, ishi gye wa. Yo Oyi wo na gbigyashi, shini Oyi wo na yo sho gbigyashi. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Koni odanoshu ikweyi kasuse kpiri shini ona dawase ni odanu ni olayi ko gbogbo-gbogbo. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Anani olayi ko gbogbo-gbogbo yoma: aba gyo, awo Owuso ko kwokwoshi, kpo Oyesu Okristi ni otoleho ni. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Nsayi kigyashi wo ese ikweyi koni nyyoko ni odami mo na ya ni. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Anani, Ada dami igyashi obutu wo kpigyashi ni ngbo kpawo ome oyese ni.<verse eid="JHN 17:5" /></para>
  <para style="s">Oyesu Tinarigwu Ikweyi ka Awogboso</para>
  <para style="pi">
    <verse number="6" style="v" sid="JHN 17:6" />&lt;&lt;Nkwobonu yawase ni odami ipu kese ni gyo wa. Awakaka wo, awo pi dami la kweyi ageyagye dawo. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Anani agye moza ni odami kpiri bwebe wo la. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Koni nkela ni oka dami ni dawa kweyi akyogwu kpanu. Agye kokwokwoshi mo nbwebe wo, kweyi atotuse mo awo pi tumoleho la. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />Nyya tinarigwu dawa. Nyya tinarigwu dase kese mani lalo, nke ya tinarigwu dawase ni odami ni, ikweyi koni awakaka wo la. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Kpiri koza ni ngbo wakaka wo, kweyi oza ni ogbo wakaka hin. Kweyi igyashi bwebe wa webe hin. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ami ya yese kelo, awa ke tayayo bese, kweyi ami ya webe wo. Ada Sere, gbuwa kposhu kiye wo, iye ni okwobonu dami ni, shini ana woye kponu byoni ami kpawo woye kponu ni. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Ishini nyyo kpawa ni, ngbuwa kweyi kpuwa shagye kpiye ni odami ni. Ashishe ipu wa gebi lo, oye ipu wa pi gebi la shini oza ni okpa ka ni na gya.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />&lt;&lt;Anani nyya webe wo, nke kawoza mani kpiri ishini ntayayo yese ni, shini ana pyo otushosha hin ipu kotu wa. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Nkyoleho wo dawa, kweyi ase kese tela wa, koni awase kese kelo byoni ami wase kese lo ni. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Nyya tinarigwu mo yuwa kpo shese mani lalo, ke gbuwa shabo kase bibi oni. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Awase kese mani lalo byoni ami welo ni. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Yuwa na ziyiwa dawo bwebe kokwokwoshi; ikweyi koni ela wo pi wokwokwoshi la. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Byoni otumoleho wese ni, ami ki tuwoleho ipu kese. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ikweyi wa nyya ziyun dawo, shini ana ziyiwa dawo kokwokwoshi.<verse eid="JHN 17:19" /></para>
  <para style="s">Oyesu Tinarigwu Dawine ko Otuse</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />&lt;&lt;Nyya tinarigwu dawa kin lalo. Nkyi ya tinarigwu dawase ni totu sun bwebe kela wa, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />shini kpiri wa na woye kponu, Ada, byoni oyipu hin kweyi ami yipu wo ni. Awa na ki yo kpaha shini ase kese na totuse mawo pi tumoleho la. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ami kwobonu dawo igyashi ni odami ni wa, shini ana woye byoni ami kpawo we ni: <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ami yipu wa kweyi awo yipu hin. Ana woye kponu shini ase kese na gye mawo pi tumoleho la kweyi oya yimu wa byoni oya yimu hin ni.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />&lt;&lt;Ada, nyya yimu mo ase ni odami ni na bebeni nyyanu ni, kweyi ana mi igyashi hin kpi igyashi ni odami ikweyi koni oyimu hin ome oyese ni.<verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />&lt;&lt;Ada, Aseneshi, ase kese gye lo, ami ke gyo, awa gye mo awo pini tumoleho la. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Nshawa ase ni awo we ni, nyya yipu ko shawa shini imu ni ogbo dami ni na yipu wa, shini ami abiyun na yipu wa.&gt;&gt;<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Ayo Oyesu Kwu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Ishini Oyesu tinarigwu kweyi ni, anu kpa Awogboso sheyi kokpa ko Okidiro. Ashikwu nu eho kiyo kobobo yebe ni, kweyi Oyesu kpayole nu gipu nu.<verse eid="JHN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2" />Oyahuda ine ko yo ra gyebe ni, ikweyi koni Oyesu kpa ayole nu ba gbayi ebe ni ishi kpiri. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Ebeni Oyahuda weho kiyo kobobo anu kpikpo kawadakare kpashini kayikoko ko Oyesu bwebe kawo oteyi kawosapa kpa Awofarisi. Abye emu, kpi ikwomu kpiyo kefu.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />Oyesu kwobonu gyoza kpiri ni ya wa gbodagye kpanu ni, osha gohobu ga duwoka mo, &lt;&lt;Anoho ni ala ba doka?&gt;&gt;<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Akamo, &lt;&lt;Oyesu ko Onazareti.&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">Oyesu kamo, &lt;&lt;Ami Wanu la.&gt;&gt; Oyahuda ni yo ra ni hagye ebe ni kpawa. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Ishini Oyesu kamo, &lt;&lt;Ami wanu la,&gt;&gt; ni, akwikye itikpi kweyi ga gbo okpagye.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Oki duwoka mo, &lt;&lt;Anoho ni ala ba doka?&gt;&gt;</para>
  <para style="p" vid="JHN 18:7">Akamo, &lt;&lt;Oyesu ko Onazareti.&gt;&gt;<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Oyesu kyogwu mo, &lt;&lt;Nka dala mo Ami Wanu la, owoni ala ba tikpo hin la, ala yango mani na gawa.&gt;&gt; <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Omani gbodagye shini oza ni okpa ka ni na gya mo: &lt;&lt;Ashishe ipu kawase ni odami ni gebi lo.&gt;&gt;<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Ebeni Osimo Obitrus ni gbewakpa ni ngmanu kweyi yo oshe ko osapa nyakwu akpaha kabore shigbo. Iye ko oshe oni wo Omalshu.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Oyesu ka do Obitrus mo, &lt;&lt;Kwikye ewakpa wo lape! Abwa ni Ada dami ni, naka gwa lo?&gt;&gt;<verse eid="JHN 18:11" /></para>
  <para style="s">Abyo Oyesu Go Obutu ka Anas</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Ebeni oteyi ka adakare ko Oroma kponongbo ka Ase ko Oyahuda yo Oyesu kwu. Ayo gbo <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />kweyi byo ikyikyo gobutu ka Anas ada ko Nya ko Okayafa, ni wosapa nyakwu ishayi oni. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Okayafa pini dawoteyi Kase ko Oyahuda ela moya shoshi she shini ase oye na gekwu ikweyi kasuse kpiri la.<verse eid="JHN 18:14" /></para>
  <para style="s">Obitrus Tawashu ko Oyesu</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Osimo Obitrus kpoyole oye ba gboso Oyesu. Osapa nyakwu gyoyole oye oni neneshi, mani oni ogboso Oyesu gipu kikpakyo kole ko osapa nyakwu, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Obitrus ke hagye ya gbeyi ese okwunu kofunu. Oyole oye ni osapa nyakwu gyo ni wa kela kpo oyinonya ni ya gbeho kofunu ni, kweyi obyo Obitrus gipu.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Ebeni oyinonya ni ya gbeho kofunu ni do Obitrus oka mo, &lt;&lt;Awo woye ipu kayole nu lalo?&gt;&gt;</para>
  <para style="p" vid="JHN 18:17">Obitrus kyogwu mo, &lt;&lt;Aayi, nwwe lo.&gt;&gt;<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Oshu yaya, mani oni ayole kpawonongbo hagye ba gyola shini ikpiye wa na gbone. Obitrus hagye kpawa ya gyola mamani.<verse eid="JHN 18:18" /></para>
  <para style="s">Osapa Nyaku Do Oyesu Oka kela</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Ebeni osapa nyakwu do Oyesu oka kela ikweyi kawogboso kpozafofu nu.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />Oyesu ka danu mo, &lt;&lt;Nkela kyaa dananoho pwo, ishi kpiri nyya foza ipu ke ekpa kpo ole ko Owuso, ebe ni Ase ko Oyahuda kpiri ba gbayi ni. Nkojije teba lo. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Ojiya ni oya dumoka? Dawase ni pwela hin ni oka. Kwokwoshi agyoza ni nka ni.&gt;&gt;<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Ishini Oyesu ka mani ni, ashe ipu ka awonongbo labo akpaha. Okamo, &lt;&lt;Owe ni oshu ko kela do osapa nyakwu ni ona?&gt;&gt;<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Oyesu kyogwu mo, &lt;&lt;Owoni nkela bibi, kashini ananoho napwo. Owoni nke kokwokwoshi la, ojiya ni olumabo akpaha?&gt;&gt; <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Ebeni Anas yuwa byo gebe ko Okayafa osapa nyakwu byoni ayo gbo ni.<verse eid="JHN 18:24" /></para>
  <para style="s">Obitrus Tawashu ko Oyesu ko Omwepa</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Ni Osimo Obitrus hagye ya gyola ni, awashe ki doka mo, &lt;&lt;Awo woye ipu kayole nu lalo?&gt;&gt;</para>
  <para style="p" vid="JHN 18:25">Obitrus ke tawashu mo, &lt;&lt;Aayi, nwwe lo.&gt;&gt;<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Oshe ko osapa nyakwu oye ni wema kase ni Obitrus yakpaha shigbo ni kamo, &lt;&lt;Ami mo kpanu ipu keho kiyo kobobo lo?&gt;&gt; <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Obitrus ki tawashu mo, &lt;Aayi&gt; ebebeni obogwu oye tono.<verse eid="JHN 18:27" /></para>
  <para style="s">Abyo Oyesu Go Obutu ko Obilatus</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Ebeni awoteyi ko Oyahuda byo Oyesu bwo ole ko Okayafa go ole ko oteyi ko Oroma. Ishi oni ke witikpokyi, kweyi awoteyi ko Oyahuda tela ko gipu kole, amo awa ba kyinyi owoni agipu kole; shini ana shu ko roza ki Imya ko Sheyi. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Ebeni Obilatus bose wa duwo oka mo, &lt;&lt;Ala kwo ongo mani kpepwo labi wonya?&gt;&gt;<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Akyogwu mo, &lt;&lt;Owoni aha bi kwo ongo mani kpepwo labi lalo, abi ba byo webe wo lo.&gt;&gt;<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Obilatus kamo, &lt;&lt;Ala byo ga kepwo kpanu abiyikala byoni ono kala ka ni.&gt;&gt;</para>
  <para style="p" vid="JHN 18:31">Awoyahuda kyogwu mo, &lt;&lt;Aha gboshu oyoye ko kwepwo labi lo. <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Omani gbodagye shini ela ni Oyesu ka ikweyi kedo kikwu nu ni na gbodagye.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Ebeni Obilatus kwikye gipu ole ko ose nu, oyo Oyesu ogwu kweyi doka mo, &lt;&lt;Awo pi wose ka Ase ko Oyahuda la?&gt;&gt;<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Oyesu kyogwu mo, &lt;&lt;Oka doda wo mani, awo abiyo piya dumoka la kwe ashe hoha pi ka dawo mo dumoka la?&gt;&gt;<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Obilatus kyogwu mo, &lt;&lt;Ami wo Oyahuda la? Ase wo kpo awosapa nyakwu kala pi yo nabo dami la. Oji ni oya?&gt;&gt;<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Oyesu kamo, &lt;&lt;Obula hin wa kese mani lalo. Owoni obi wa kese mani la, ayole hin biya wa Ase ko Oyahuda obi ko yun kwu. Nabani ke obula hin wa kese mani lalo.&gt;&gt;<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />ko Obilatus kamo, &lt;&lt;Awo wose la?&gt;&gt;</para>
  <para style="p" vid="JHN 18:37">Oyesu kamo, &lt;&lt;Awo pi kamo nwwose la. Kokwokwoshi, ikweyi ko omani pini amun la, kweyi nwwese ko yolobene ko okwokwoshi. Kpiri kase kese ni yagbabo kokwokwoshi ya yakpaha tagye dami.&gt;&gt;<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Obilatus doka mo, &lt;&lt;Oji wokwokwoshi?&gt;&gt; Bwebe kela mani okwikye gese ebe ka Ase ko Oyahuda ga ka dawa mo, &lt;&lt;Nmo kpozalabi oyoye ko kwepwo lo.<verse eid="JHN 18:38" /></para>
  <para style="s">Akwo Oyesu Epwo Koyo Ngmo</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Oke wodu kala shini na shashe ni yoruduru bita dala ishi ki Imya ko Sheyi. Ala ba yimu shini na sho &lt;&lt;ose ka Ase ko Oyahuda bita?&gt;&gt;<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Azoko iso mo, &lt;&lt;Aayi! Sho Obaraba bita daha!&gt;&gt; Obaraba woye ipu kawo nyoza-oshu.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">Akwo Oyesu Epwo ko yo Poshi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Ebeni Obilatus yuwa yo Oyesu aboshi. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Awadakare gweka kigye likweyi. Akpo oshiye inyi kogarura shoko <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />kweyi ba gobutu nu ba kamo, &lt;&lt;Abaga edu, ose ka Ase ko Oyahuda!&gt;&gt; Kweyi alabo akpaha.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Obilatus ki bose wa ka dawa mo, &lt;&lt;Ala ma, nyya byo ya wa dala shini ala gye mo nkwo kpepwo labi oyoye ni ala ka ni lo.&gt;&gt; <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Ishini Oyesu bose kpe eka kigye ikweyi akpo oshiye inyi kogarura ni, Obilatus ka dawa mo, &lt;&lt;Ongo oni yoma!&gt;&gt;<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Ni awosapa nyakwu kpa awonongbo mo ni, angmegba mo, &lt;&lt;Ana yo poshi, ana yo poshi!&gt;&gt;</para>
  <para style="p" vid="JHN 19:6">Obilatus ke kyogwu mo, &lt;&lt;Ala byo ga yo poshi sepa. Ami kwo kpepwo labi oyoye ni ala bi wa ikweyi nu ni lo.&gt;&gt;<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Ewa kasuse ko Oyahuda ke belela mo, &lt;&lt;Aha gbono, kweyi ono ka kamo owotiri shini ona gekwu, ikweyi koni oziyinu manu wo Oyi ko Owuso ni.&gt;&gt;<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Ishini Obilatus pwo mani ni, oki yoshi kotata, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />kweyi okwikye gipu ole ko ose. Oga do Oyesu oka mo, &lt;&lt;Awo bwebe nya wa? Oyesu ke kojije danu lo. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Obilatus kamo, &lt;&lt;Oya kela dami lo, ogye mo ngboshu ko shobita kwako yo poshi sepa lo kwo?&gt;&gt;<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Oyesu kyogwu mo, &lt;&lt;Obi ya gboshu ikweyi hin lo, owoni abi dawoshu bwi iso lalo. Ase ni ke yun dala ni pi yozalabi she la.&gt;&gt;<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Bwishi oni, Obilatus ya yimu ko sho Oyesu bita, Ase ko Oyahuda ke ba ngmegba mo, &lt;&lt;Owoni oshongo mani bita ganu, owoya ko Okesa kelo.&gt;&gt;<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Ishini Obilatus pwo mani ni, obyo Oyesu wese kweyi wa yagye oka kino kepwo ebe ni aba yogwu mo &lt;&lt;Agbo Okpo&gt;&gt;. Ni ase ki Ibru ba yo ogwu mo &lt;&lt;Ogabata.&gt;&gt; <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Eno wikweyi ome eno ko Sheyi.</para>
  <para style="p" vid="JHN 19:14">Obilatus ka da Ase ko Oyahuda mo, &lt;&lt;Ose kala yoma.&gt;&gt;<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Awa ke ki ba ngmegba mo, &lt;&lt;Ana yongmo! Ana yongmo! Ana yo poshi sepa!&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">Obilatus kamo, &lt;&lt;Ala ba yimu na yose kala poshi sepa?&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">awosapa nyakwu kyogwu mo, &lt;&lt;Ose naha gbo ni wo Okesa fufunu la.&gt;&gt;<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Ogwejeji nu, Obilatus yo Oyesu nabo dawa ko yo poshi sepa.</para>
  <para style="p" vid="JHN 19:16">Ebeni awadakare byo Oyesu ga.<verse eid="JHN 19:16" /></para>
  <para style="s">Ayo Oyesu Poshi Sepa</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Oyesu zoshi nu sepa bose gebye ni aba yogwu mo &lt;&lt;Okpokwu ki Ikweyi.&gt;&gt; Okwunu ko ose kase ki Ibru &lt;&lt;Ogolgota.&gt;&gt; <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Ebeni ayo poshi sepa kpango epa, oye abore nu oye aboshe nu kweyi Oyesu yotutehe wa.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />Obilatus yoshu tota kweyi yi piso ko oshi sepa mo. OYESU KO ONAZARETI, OSE KA AWOYAHUDA. <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Awoyahuda nwashika ni ba shigbo ni ma, koni ebeni ayo Oyesu poshi sepa ni lenu kpogya ni lo, kweyi ela mani ayi ta okwunu ko ose ka Ase ki Ibru kpase ko Oroma kpase ko Ogirik. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Ebeni awosapa nyakwu kpa Ase ko Oyahuda ka do Obilatus mo, &lt;&lt;Ona ka ta mo &lt;Ose ka Ase ko Oyahuda&gt; lo, oke na ta mo, &lt;&lt;Ongo mani manu wose ka Ase ko Oyahuda.&gt;&gt;<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Obilatus kyogwu mo, &lt;&lt;Oza ni nta ni, nyyi ta oma.&gt;&gt;<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Ishini awadakare yo Oyesu poshi ni, akposhiye nu, ayiko wene, awadakare zoyoye. Akpo oshiye nu wirikpo ni gboyi ko gogo lo ni, atotu bwi iso weye.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />Aka di iyiwa mo, &lt;&lt;Ahan ka yi sha lo. Ahan gwekye shini an mase ni ya yi re ni.&gt;&gt;</para>
  <para style="p" vid="JHN 19:24">Omani gbodagye shini oza ni okpa ko Owuso ka ni na gya mo,</para>
  <para style="q" vid="JHN 19:24">&lt;&lt;Ayo oshiye hin yi ko diyiwa kweyi agwekye ikweyi koshiye nu.&gt;&gt; Oza ni awadakare ya ni oma.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Ene ko Oyesu hagye kwo oshi sepa kpa ayene kinanu, kpo Omeremu onya ko Okilofa, kpo Omeremu bwa agye ko Omagadali. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Ishini Oyesu mi inanu hagye, kweyi oki mo oyole nu oye ni oya yimu ni hagye kwo, oka di inanu mo, &lt;&lt;Ene oyi wo yoma.&gt;&gt; <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />Oki ka di inogboso oni mo, &lt;&lt;Ene wo yoma.&gt;&gt; Bwishi oni, oyole oni byo gole nu.<verse eid="JHN 19:27" /></para>
  <para style="s">Ikwu ko Oyesu</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Oyesu gye mojoji kweyi, shini oza ni okpa ko Owuso ka ni na gya. Okamo, &lt;&lt;Igyini ya ngmun.&gt;&gt; <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Eyi kinyi yebe ni, ayakasa ko gwiye linyi, kweyi ayo lokposhi kweyi bi gebe ko okwunu ko Oyesu. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Ishini Oyesu gwinyi mani kweyi ni okamo, &lt;&lt;Okweyi wa.&gt;&gt; Bwebe ni oyikweyi kwagye kweyi oyowu nu she.<verse eid="JHN 19:30" /></para>
  <para style="s">Ato Oyesu Okpa Ashikwu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Ishi oni weno ko Kyatu, kweyi gbebe nya nu we eno ko Minyo. Ikweyi koni Ase ko Oyahuda ba yimu shini ana shokwu ko Oyesu bita gbe eno ko Minyo lo, aga bo Obilatus ko yikpo ko Oyesu kyigbo ki yokwu nu yi sa sho oshi sepa. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Ebeni awadakare wa kweyi wa yikpo kongo kikyikyo ni ayi poshi sepa kpo Oyesu ni yi kyigbo, aki ya ko omwepa nu kigbo mamani. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ishini ake webe ko Oyesu ni, awa tanu kwobonu gekwu, ayikpo kyigbo kelo. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Abishi koni ashe ipu kawadakare tokpa ashikwu okwunu kikpo ni ayi kyigbo lo ni. Ebebeni oyi kpinyo shonu. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Ongo ni moza mani ni yolobene, kweyi olobene nu wo kwokwoshi. Ogye mo okokwokwoshi, kweyi oyolobene shini ala ki totuso. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Awoza mani gbodagye shini oza ni okpa ko Owuso ka ni na gya mo: &lt;&lt;Okpokwu nu oyoye ya kyigbo lo,&gt;&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />kweyi okpa ko Owuso ki kamo, &lt;&lt;Aba kpiyi kwase ni atokpa ashikwu ni.&gt;&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">Ayo Okwu ko Oyesu Nyi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Itikpi kawoza mani, Isu ka Arimatiya ga do Obilatus oka ko okwu ko Oyesu. Isu woye ipu ka awogboso Oyesu, oke ya gboso teba ikweyi koni oya yoshi ka Ase ko Oyahuda ni. Obilatus danoko, owa kweyi wa yo okwu ko Oyesu yi bize. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Onikodemus byi Isu oshi, anu ni webe ko Oyesu otutehe ko otu ni. Onikodemus bya ano kpeye ni iye nu wo omayiri kpo alo yo ogya ni enu nu ya gomyomya aweta ayeho. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Asepa mani zokwu ko Oyesu to opa kweyi nyano kpeye. Aya mani byoni owodu ko nyo okwu ka Ase ko Oyahuda ni. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Ebeni ayo Oyesu poshi ni eho oye ye ebe ni, ipu ke eho ni amiri oye pepe ye ebeni ni anya ashishe anu wa lo ni. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Koni ogbebe nya we Eno ko Minyo ka Ase ko Oyahuda, ni amiri ki kwuwa ni, ayo Oyesu nyi ebe ni.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Oyesu Nyiso Amiri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Eno kikyikyo ko obize, ogwogwutogwu, Omeremu bwagye ko Omagadali bose ga amiri kweyi oma ayo okpo ja gokoka. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Ebeni okwikye kpenya ga to Osimo Obitrus kpo oyole oye ni Oyesu ya yimu ni kweyi kamo, &lt;&lt;Aya Adole yi bize sha amiri, aha gye ebe ni ayo ta anu ni lo!&gt;&gt;<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Ebeni Obitrus kpo oyole oye oni bose gebe ka amiri. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Kpiri wa bose kpenya, oyole oye ni nyinya gwo Obitrus ta kweyi fa amiri kwobonu danu. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Oweyi kweyi shoko, omo opa shagye, oke gipu lo. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Ebeni Obitrus ni yitikpi ni wa kweyi wa gipu ka amiri. Omo opa ngmongma shagye, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ki kpiyo ni ayi lokwu ko Oyesu ikweyi ni. Iyo ni kyokye abiyinu shagye gogo kpo opa. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Ogwejeji nu, oyole ni kwobonu do Obitrus gebe ka amiri ni, wa gipu mamani. Oma kweyi ototu so. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kwikyikyeni agyikweyi koza ni okpa ka mo Oyesu ya nyiso amiri ni lo.<verse eid="JHN 20:9" /></para>
  <para style="s">Oyesu Bose do Omeremu ko Omagadali</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />Ebeni ayole ko Oyesu mani kwikye gole wa, <verse eid="JHN 20:10" /><verse number="11" style="v" sid="JHN 20:11" />Omeremu ke hagye ese ka amiri ya kyegba. Ni oya kyegba ni, oweyi kwagye ya shoko ma amiri, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />oma ayoleho epa shoshiye nehe bagye ebe ni okwu ko Oyesu yanu ni, oye yagye ebe kikweyi nu, oye yagye ebe kikpo nu.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />Ado oka mo, &lt;&lt;Onya, oji yo ya kyegba?&gt;&gt;</para>
  <para style="p" vid="JHN 20:13">Okamo, &lt;&lt;Ayo okwu ka Adole hin yi bize, kweyi nggyebe ni ayo tanu ni lo.&gt;&gt; <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Ebebeni opyiyi kweyi omo Oyesu hagye, oke gye mowo Oyesu lo.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Okamo, &lt;&lt;Onya, oji yo ya kyegba? Anoho ni oya tikpo?&gt;&gt;</para>
  <para style="p" vid="JHN 20:15">Oya ma byawino yiyi kweho la, kweyi okamo, &lt;&lt;Adole, owoni awo pi yo bize la, ka dami ebe ni oyo tanu ni, shini na ga zo.&gt;&gt;<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Oyesu yogwu mo, &lt;&lt;Omeremu!&gt;&gt; Ebeni opyiyi kweyi ngmegba okwunu ki Ibru mo, &lt;&lt;Oraboni&gt;&gt; asenu wo &lt;&lt;Inofoza!&gt;&gt;<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Oyesu kamo, &lt;&lt;Ka byun lo, koni nkwikye gebe ka Ada wa lo. Gebe ka ayole hin ga ka dawa mo, &lt;&lt;Nyya kwikye gebe ka Ada hin, Ada kala; Owuso hin, Owuso kala.&gt;&gt;<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Omeremu ko Omagadali kwikye ga koshu oni dayole mo: &lt;&lt;Ami ma Adole!&gt;&gt; Kweyi oka dawa mo okawela mani danu.<verse eid="JHN 20:18" /></para>
  <para style="s">Oyesu Bose da Ayole Nu</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Onose ke eno kikyikyo ko obize, ishini ayole nu wa gbayi ni, ayofunu gwu ikweyi koni aba yoshi ka Ase ko Oyahuda ni, Oyesu wa hagye obutu wa kweyi kamo, &lt;&lt;Omene na yo kpala!&gt;&gt; <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Ishini okela mani kweyi ni oshawa abo kpashikwu nu. Otu kawogboso sha kotata ishini ama Adole ni.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Oyesu ki ka dawa mo, &lt;&lt;Omene na yo kpala! Byoni Ada tumoleho ni, ami ki ya tala oleho.&gt;&gt; <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Ni oka mani, ogbo olayi tuwa kweyi kamo, &lt;&lt;Ala nyo Omaku ko Owuso. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Owoni ala yase ozalabi wa na, ayi na oma; owoni ala yuwo ozalabi na lo, ayi na lo.&gt;&gt;<verse eid="JHN 20:23" /></para>
  <para style="s">Oyesu Kpo Otoma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Oye ipu kawi Igwepa, Otoma (ni aba yo ma Apule ni), yo kpayole ishini Oyesu wa ni lo. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Mani oni ashini kayole ka danu mo, &lt;&lt;Aha ma Adole!&gt;&gt;</para>
  <para style="p" vid="JHN 20:25">Otoma ka dawa mo, &lt;&lt;Owoni nmoyi kabo nu ni bwu ni agwaba kweyi yayabo hin goyi kofo ni ayo ni ki gabo ashikwu nu lalo, nyya kyogwu lo.&gt;&gt;<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Obize oye shigbo, ayole ko Oyesu kpiri bipu kole, kweyi Otoma yo kpawa. Koni ofunu boba ni, Oyesu wa kweyi wa hagye ipu wa kweyi kamo, &lt;&lt;Omene na yo kpala!&gt;&gt; <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Ebeni oka do Otoma mo, &lt;&lt;Yayi kabo wo lebe ni; mabo hin. Nabo wo ta shini ogabo ashikwu hin. Ka kotu lo, totu sun.&gt;&gt;<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Otoma ka danu mo, &lt;&lt;Adole hin kpo Owuso hin!&gt;&gt;<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Ebeni Oyesu ka danu mo, &lt;&lt;Koni omun ni pini ototu sun la; aboneshi yo kpawase ni mun lo kwikyikyeni ake totu sun.&gt;&gt;<verse eid="JHN 20:29" /></para>
  <para style="s">Ozani Ya ni Atokpa Mani</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Oyesu yoza kigbashi nwashika obutu kawogboso ni ayita ipu ko okpa mani lo ni. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ake yomani ta shini ala totuse mo Oyesu wo Okristi, Oyi ko Owuso, kweyi owoni ala totuso ala ba pyo olayi ipu kiye nu.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Oyesu Bose da Awogboso Ahapa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Itikpi koni, Oyesu ki bose dayole nu okwunu ki Ishu nyakwu ko Otiberiya agye ko Galili. Owe ni obose dawa ni yoma: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Awase ni bebeni wo, Osimo Obitrus kpo Otoma ni aba yogwu ma Apule ni, kpo Onataniye bwo Okana ka agye ko Ogalili, oyi ko Ozebedi, kpa ayole nu epa. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Osimo Obitrus ka da awa mo, &lt;&lt;Nyya ga tinyi,&gt;&gt; aka danu mo, &lt;&lt;Aha ba ga kpawo.&gt;&gt; Ebeni abose ga gipu ko owu kinyo, ipu kotu oni akwojije lo.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Ototukpokyi, Oyesu wa hagye ega ki ishu, ayole nu ke gye mo Oyesu pi hagye lalo.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />Oyesu yuwogwu mo, &lt;&lt;Ayene hin, ala kwe ebinyi oyoye lo?&gt;&gt;</para>
  <para style="p" vid="JHN 21:5">Akamo, &lt;&lt;Aayi.&gt;&gt;<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Oyesu ka dawa mo, &lt;&lt;Ala sheya kala abore ko owu ala ba kwe ebinyi.&gt;&gt; Ni aya mani, agege ko pyeya lo ikweyi koni ebe nwashika ipu keya ni.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Ebeni oye ipu kayole ko Oyesu ni oya yimu ni ka do Obitrus mo, &lt;&lt;Adole la!&gt;&gt; Ni Osimo Obitrus pwo ya kamo, &lt;&lt;Adole la,&gt;&gt; ni, okpo oshiye nu kese shoko kweyi shibi gipu kinyo. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Ashini kayole gboso ipu ko owu kega ki ishu, kweyi apyeya nwonwu kpe ebinyi, koni alenu kpega ki ishu lo ni. Enu wa kpega ki ishu lema byikpo ogbogbo eta kin la. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Ishini abose shipu ki ishu wo okpagye ni, eha kola yebe ni kpe ebinyi yikweyi nu, kpikyoga.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />Oyesu ka dawa mo, &lt;&lt;Ala bye ebinyi ni ala kwu ni gbayayi wa.&gt;&gt;<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Ebeni Osimo Obitrus toshi gipu ko owu kweyi pyeya go okwunu kega. Eya kwebinyi nyakwu-nyakwu ogbogbo oye saweho ayeta, koni ebinyi nwashika ipu nu ni, eya ke sha lo. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Oyesu ka dawa mo, &lt;&lt;Ala wa shan roza kotukpokyi.&gt;&gt; Ipu kayole nu ashishe gege ko doka mo, &lt;&lt;Awo wanoho?&gt;&gt; lo. Agye mowa Adole la. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Oyesu wa zikyoga kweyi odawa, oki dawe ebinyi mamani. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Omani wo bose komweta ni Oyesu bose dayole nu itikpi ni onyiso amiri ni oma.<verse eid="JHN 21:14" /></para>
  <para style="s">Oyesu kpo Obitrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Ishini aroza kweyi ni, Oyesu ka do Osimo Obitrus mo, &lt;&lt;Osimo oyi ko Oyohana, oya yimu hin shashini kala mani?&gt;&gt;</para>
  <para style="p" vid="JHN 21:15">Okamo, &lt;&lt;Adole, ogye mo, nyya yimu wo.&gt;&gt;</para>
  <para style="p" vid="JHN 21:15">Oyesu ka danu mo, &lt;&lt;Dayi ko otukpo hin ozarore.&gt;&gt;<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Oyesu ki kamo, &lt;&lt;Osimo oyi ko Oyohana, oya yimu hin ko okwokwoshi?&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">Okamo, &lt;&lt;Adole, ogye mo, nyya yimu wo.&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">Oyesu kamo, &lt;&lt;Yiyi kwo otukpo hin.&gt;&gt;<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Oki doka komweta mo, &lt;&lt;Osimo oyi ko Oyohana, oya yimu hin?&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">Otu ko Obitrus bya ikweyi koka ni Oyesu do komweta ni mo, &lt;&lt;Oya yimu hin?&gt;&gt; Okamo, &lt;&lt;Adole, ogyojoji kpiri; ogye mo, nyya yimu wo.&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">Oyesu ka danu mo, &lt;&lt;Yiyi kwo otukpo hin.&gt;&gt; <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Nyya ka dawokwokwoshi, ishini owisongo, oya gwagya kweyi ya gebe ni oya yimu ni; ishini oke sawukye, oya nata kabo wo kweyi ashe hoha ya shoshiye kweyi ya pyabo gebe ni oyimu ko ga lo ni.&gt;&gt; <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Oyesu ka mani shini ona sayi kedo kikwu ni Obitrus ya wa ga ni shini Owuso na pyi igyashi. Ebeni oka do Obitrus mo, &lt;&lt;Gbosun!&gt;&gt;<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Obitrus pyiyi kweyi omoye ipu kayole ko Oyesu ni oya yimu ni ya gbosuwa. Ase ni yagye kpo Oyesu ishini aba roza ki Imya ko Sheyi ni doka mo, &lt;&lt;Adole, anoho wa yo ra?&gt;&gt; ni. <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Ishini Obitrus mo ni, odo Oyesu oka mo, &lt;&lt;Adole, ongo mani ke?&gt;&gt;<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Oyesu kyogwu mo, &lt;&lt;Owoni nyyimu nu koyiyi gbishini nyya kwikye ya wa, onya wakaho? Gbosun!&gt;&gt; <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Ela mani ge ebebenya ebe kawogboso Oyesu mo, oyole nu mani ya gekwu lo. Oyesu ke kamo oya gekwu lo lalo; okamo, &lt;&lt;Owoni nyyimu nu ko yiyi gbishini nyya kwikye ya wa, onya wakaho?&gt;&gt;<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Oyole nu oni pi yolobene kawoza mani kweyi anu pi tenena mani la. Aha gye molobene nu wo kwokwoshi.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Oyesu ki yawoza shini nwashika. Owoni abi yi ta kpiri, Nyya ma mo oda oyoye ese mani ya gyawo okpa ni abi ba ta ni lo.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>