<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">-- Alago Bible</book>
  <para style="h">Omatiyu</para>
  <para style="toc1">Oshu Neshi Bwabo ko Omatiyu</para>
  <para style="toc2">Omatiyu</para>
  <para style="toc3">Omt</para>
  <para style="mt2">Oshu neshi bwabo ko</para>
  <para style="mt1">Omatiyu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Awo Kyikyi ko Oyesu Okristi</para>
  <para style="r">(<ref loc="LUK 3:23-38">oLuka 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Omani pini wokpa kawiye kokyikyi ko Oyesu Okristi, ni woyi ko Odawuda kpi Ibirayi ni.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Ibirayi wada ki Ishaku, Ishaku wada ko Oyakubu, Oyakubu wada ko Oyahuda kpa ayinanu,<verse eid="MAT 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3" />Oyahuda wada ko Ofere, kpo Ozera ni inawa wo Otama ni,</para>
  <para style="q1" vid="MAT 1:3">Opere wada ko Ohezron,</para>
  <para style="q1" vid="MAT 1:3">Ohezron wada ka Aram,<verse eid="MAT 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4" />Aram wada ka Aminada,</para>
  <para style="q1" vid="MAT 1:4">Aminada wada ko Onasho,</para>
  <para style="q1" vid="MAT 1:4">Onasho wada ko Osalimo,<verse eid="MAT 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5" />Osalimo wada ko Obowaz, ni inanu wo Orahab ni,</para>
  <para style="q1" vid="MAT 1:5">Obowaz wada ko Obed, ni inanu wo Orutu ni,</para>
  <para style="q1" vid="MAT 1:5">Obed wada ko Ojese,<verse eid="MAT 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6" />Ojese wada kose Odawuda.</para>
  <para style="p" vid="MAT 1:6">Odawuda wada ko Osolomo, ni inanu wo Obasheba, ni wonya ko Oyuriya ikyikyo ni.<verse eid="MAT 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7" />Osolomo wada ko Orehobuwa,</para>
  <para style="q1" vid="MAT 1:7">Orehobuwa wada ka Abija,</para>
  <para style="q1" vid="MAT 1:7">Abija wada ka Asa<verse eid="MAT 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa wada ko Ojehoshafa,</para>
  <para style="q1" vid="MAT 1:8">Ojehoshafa wada ko Ojoram,</para>
  <para style="q1" vid="MAT 1:8">Ojoram wada ka Azariya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya wada ko Ojotam,</para>
  <para style="q1" vid="MAT 1:9">Ojotam wada ka Ahaz,</para>
  <para style="q1" vid="MAT 1:9">Ahaz wada ke Ezekiya,<verse eid="MAT 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10" />Ezekiya wada ko Omanase,</para>
  <para style="q1" vid="MAT 1:10">Omanase wada ka Amoni,</para>
  <para style="q1" vid="MAT 1:10">Amoni wada ko Ojosiya,<verse eid="MAT 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11" />Ojosiya wada ko Ojekoniya kpayinanu, ishini akpase ko Oyahuda ga woshe okpagye ko Obabila ni.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Itikpi keshe gbogbo ko Obabila,</para>
  <para style="q1" vid="MAT 1:12">Ojekoniya wada ko Osheyatiye,</para>
  <para style="q1" vid="MAT 1:12">Osheyatiye wada ko Ozerubabe<verse eid="MAT 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13" />Ozerubabe wada ka Abihudu,</para>
  <para style="q1" vid="MAT 1:13">Abihudu wada ke Eliyakim,</para>
  <para style="q1" vid="MAT 1:13">Eliyakim wada ka Azo,<verse eid="MAT 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14" />Azo wada ko Ozado,</para>
  <para style="q1" vid="MAT 1:14">Ozado wada ka Akimu,</para>
  <para style="q1" vid="MAT 1:14">Akimu wada ke Eliyuda,<verse eid="MAT 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliyuda wada ke Eliyaza,</para>
  <para style="q1" vid="MAT 1:15">Eliyaza wada ko Omatan,</para>
  <para style="q1" vid="MAT 1:15">Omatan wada ko Oyakubu,<verse eid="MAT 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16" />Oyakubu wada ki Isu, oba ko Omeremu, Omeremu wene ko Oyesu ni ayomo Okristi ni.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ni olema oni, bwi Ibirayi go Odawuda wi ipwoma igwene, bwo Odawuda gishi ni agbeshe okpagye ko Obabila ni wipwoma igwene bwishi oni go omoma ko Okristi wipwoma igwene.<verse eid="MAT 1:17" /></para>
  <para style="s">Omoma ko Oyesu Okristi</para>
  <para style="r">(<ref loc="LUK 2:1-7">oLuka 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Owe komoma ko Oyesu Okristi pini yoma. Inanu Omeremu ayo ki Isu ko doka, ome ona godoba, obipu bwebe ko Omaku ko Owuso. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Isu oba ko Omeremu wase neshi, oyimu koto Omeremu iweyi ebe kasuse lo, ogbo ipu kotunu ko kabo kpanu kyokyokyo.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Oyipu ko gbela mani, kweyi oyoleho ka Adole webe nu ipu kana kamo, &lt;&lt;Isu oyi ko Odawuda, kayoshi lo, zo Omeremu na wonya wo, koni ipu ni obi ni, bwebe ko Omaku ko Owuso la. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Oyi nu kikyikyo wongo, kweyi oya tiye mo Oyesu, koni anu pini ya ngma wase nu shipu kozalabi wa la.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Omani kpiri gbodagye shini ela ka Adole ni, oka bwebe kinobane ni na gbodagye. <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />Okamo, &lt;&lt;Ma! Isonya ya bipu! Oya moyi, aba daniye mi, Imanuwe.&gt;&gt; ase ki Imanuwe wo, &lt;&lt;Owuso yo kpaha.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Ishini Isu shiyi ola ni, oyoko kpoza ni oyoleho ka Adole kadanu ni, kweyi ozo Omeremu onya nu gole. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ogyewewa ko onya nu lo, gbishini omoyi nu, otiye wo Oyesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Awoziyi Bwa Ahanokyi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Ishini amo Oyesu, Obetalami agye ko Oyahudiya, ishi oni Ohiridus wo Ose, awoziyi bwa ahanokyi gogya ko Ojerusele, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Adoka, &lt;&lt;Ebenya ni amo ose kase ko Oyahuda? Aminyiwo nu ahanokyi, awa ko geyagye danu.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ishini ose, Ohiridus pwela mani ni, otunu bya, mamani awase ni bo Ojerusele kpiri ni byotu. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Oyo oteyi kawosapa kpa awofoza kpiri ogwu kweyi duwoka mo, &lt;&lt;Ebenya ni, aba mo Okristi?&gt;&gt; <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Akyogwu mo, &lt;&lt;Ipu kogya ko Obetalami agye ko Oyahudiya,&gt;&gt; byoni inobane tani:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;Awo Obetalami agye ko Ojuda,</para>
  <para style="q2" vid="MAT 2:6">ala bama bya ala wogya leke okpagye ko Ojuda la,</para>
  <para style="q1" vid="MAT 2:6">oteyi ke yawa bose ipu kala,</para>
  <para style="q2" vid="MAT 2:6">ni yawa kpogwu kawase ki Izrayila.&gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Ebeni Ohiridus yawoziyi ogwu teba kweyi duwoka, ishi wonya ni inyiwo mani bose. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Mani oni, otuwoleho go Obetalami kweyi kamo, ala doka koyi mani kpera. &lt;&lt;Owoni ala mo, ala yun na gye shini na gageyagye danu.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Ishini apwela kose kweyi ni, agboso inyiwo gbishini oga hagye ebe ni oyi yanu ni. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ishini ami inyiwo ni, ashotunehe. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ishini agipwole ni, amoyi kpi inanu Omeremu, akwagye obutu nu kweyi ageyagye danu. Abyeshi kogye yoyu, ikwiri ka azurupa, ozakpeye. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ni ishi wa gye kokwikye gokpagye wani, abwowe oye hoha, ikweyi koni Owuso shuwana mo, anaka gebe ko Ohiridus kelo.<verse eid="MAT 2:12" /></para>
  <para style="s">Agawa gi Ijip</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ishini awoziyi gawa ni, oyoleho ka Adole webe ki Isu ipu kana. &lt;&lt;Yiso, zoyi kpi inanu shini ala gogya ki Ijip, shini ala bebeni gbishini nyya ka dala eno ko shebe ni bita! Ela koni Ohiridus ya labo kowe koyo oyi ngmo.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Isu takpa nyiso, zoyi kpi inanu gogya ki Ijip otu. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Abebeni gbishini Ohiridus gekwu. Omani gbodagye byoni Adole ka bwebe ki inobane mo &lt;&lt;Nyya yoyi hin ogwu bwi Ijip.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Ongmongmo ka Ayileke</para>
  <para style="r">(<ref loc="MRK 13:9-13">oMak 13.9-13</ref>; <ref loc="LUK 21:12-17">oLuka 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ni Ohiridus mamo awoziyi gyegya ni, okyanya. Odawo okwunu mana yayi nongo meme ngmo kpiri ogya ko Obetalami kpo ogya ni yo pee kpanu ni. Bwa ashayi epa weye, omani gbodagye ikweyi koza ni awoziyi ka danu ishini inyiwo bose ni. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Mani, ozani inobane ko Owuso Irimiya kani na gbodagye mo,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Aha pwegba shoshu Orama,</para>
  <para style="q2" vid="MAT 2:18">egba shoshu kotu byobya,</para>
  <para style="q1" vid="MAT 2:18">Orahila ya kyegba kayi nu,</para>
  <para style="q2" vid="MAT 2:18">Otanu kosha, koni agekwu ni.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Okwikye go Onazareti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ishini Ohiridus gekwu ni, oyoleho ka Adole bose waka di Isu, ipu kana ogya ki Ijip. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Okadanu mo, &lt;&lt;Takpa nyiso, zoyi kpi inanu, shini ala gokpagye ki Izrayila, koni awase ni ba yimu koyo olayi koyi mani ngmo ni gekwu wa.&gt;&gt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Ni olemani Isu kwikye papa gokpagye ki Izrayila kpo Oyesu kpinanu. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ishini opwo mo Akilayu rogwu kada nu Ohiridus wose ko okpagye ko Oyahudiya ni, oya yoshi ko gebe ni. Aki shaana mo, ona gokpagye ko Ogalili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Ebeni aga bagye ogya ni ayogwu mo Onazareti ni. Omani gbodagye ikweyi kela ni awobane kamo, &lt;&lt;Aba yogwu mowase ko Onazareti ni.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Ono totu kela ko Owuso bwebe ko Oyohana Ine koyo Obatisma</para>
  <para style="r">(<ref loc="MRK 1:8">oMak 1.8</ref>; <ref loc="LUK 3:1-18">oLuka 3.1-18</ref>; <ref loc="JHN 1:19-28">Oyohana 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ishi oni, Oyohana inoyo Obatisma kwotu ko tono kela ko Owuso ipu kododa okpagye ko Oyahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Oya kamo, &lt;&lt;Ala shagbotu shozalabi kala shini ala yotuso Owuso, ikweyi koni owowa kobula kiso yo pee.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Oyohana wase ni inobane ko Owuso Ishaya ya kela ikweyi nu, ishini okamo,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Ashe ya tono kpoko nwaa, ipu kododa mo,</para>
  <para style="q1" vid="MAT 3:3">&lt;Kyowetu gbeyi ka Adole!</para>
  <para style="q2" vid="MAT 3:3">Kyowe tiriri danu.&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Oshiye ko Oyohana woya ko onyakwimi, Oyo okpa gbogbeyi nu, Ozarore nu wi ikpaga kpinyi keho. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ase webe nu bwogya ko Ojerusele, okpagye kpiri ni shishini ko Oyahudiya, kikpo kpagye ko Ojoda. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ashagbotu kozalabi wa, kweyi oyuwo obatisma ishu ko Ojoda.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ishini Oyohana mawo Ofarisi kpawo Osaduki nwashika ba webenu koyuwo obatisma ni, okadawa mo, &lt;&lt;Ala awigboji! Anoho pyala akpaha mo, alaba bose bweshe gbogbo ni Owuso yabiwa ikweyi kase ni? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ala yawoza ni ya sayi ase mo, ala shagbotu shozalabi kala bita wa, kweyi totuso Owuso. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ala kaka diyikala mo angmala, koni Ibirayi wokyikyi kokyikyi kaha! Nyya ka dala mo Owuso yagege ko pya awikyikpo mani yawayi di Ibirayi. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Owuso yaga gbeyi kogogba kefu tonu, efu kpiri nigwa neshi lo, ala yogo tonu ime yo ta gola.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Awase ni shagbotu wa kweyi totuso Owuso ni, ami ya yala obatisma kpi inyo. Anu ni yawa itikpi hin ni shun puputu, anu oni nyya gege ko wa pee kpanu lo, koni oshun ni, kweyi okpabawu nu nyya gege kokpo lo. Oyawa yala obatisma kpo Omaku ko Owuso kpola. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Ogbo oda kotowu kizire sho omutu nu bita. Oya kpi izire nu sho owuya, omutu nu ke oyayi yola ni gbo myomyi loni.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">Obatisma ko Oyesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">oMak 1.9-11</ref>; <ref loc="LUK 3:21-22">oLuka 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ishi oni, Oyesu bwo Ogalili gebe ko Oyohana ishu ko Ojoda koni anayo obatisma ni. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Oyohana ya yimu koyo Oyesu Obatisma lo, oya kamo, &lt;&lt;Ami Oyohana, keya yimu shini oyumo obatisma la kweyi awo webe hin?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Oyesu nyagbo mo, &lt;&lt;Nalemani anani, oya shoshi koni ahan yojoji kpiri ipu kimu ko Owuso.&gt;&gt; Ebeni Oyohana kyogwu koyo Oyesu obatisma.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Ishini oyo Oyesu obatisma ni, obose ipu kinyo, okpowuso gwa kweyi omo Omaku ko Owuso sa bwiso byo otitiribi ni wa kwagye ikpiye nu. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Kweyi oko kela bwiso ya kamo, &lt;&lt;Omani woyi hin moshi ni nyya yimu ni, otu hin ya sha kpanu.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ibiri mo Oyesu ma</para>
  <para style="r">(<ref loc="MRK 1:12-13">oMak 1.12-13</ref>; <ref loc="LUK 4:1-13">oLuka 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Ebeni, Omaku neshi ko Owuso byo Oyesu gipu ko ododa shini Ibiri na moma. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Oyesu kwokwunu keno awene, kotu keno, kweyi emye ngmo kotata. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ebeni, Ibiri watanu moma kamo; &lt;&lt;Owoni owoyi ko Owuso, kadi ikyikpo mani na pya wikyoga.&gt;&gt; <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Oyesu ke nyagbo mo, &lt;&lt;Ayitota ipu kokpa ko Owuso mo: &lt;Ozarore kin pini ya dase olayi la lo, ke wela ni yawa bwo okwunu ko Owuso ni la.&gt;&gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ebeni, Ibiri zo Oyesu gogya sere ko Ojerusele, kweyi byo gogwejeji kiso ko Ole ko Owuso. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Oki kadanu mo, &lt;&lt;Owoni awowo Oyiko Owuso la, shibi gokpagye. Byoni ela ko Owuso kani,</para>
  <para style="q1" vid="MAT 4:6">&lt;Oyakada ayoleho nu;</para>
  <para style="q2" vid="MAT 4:6">nawa byo</para>
  <para style="q2" vid="MAT 4:6">shimi oka yikpo gwakyo lo.&gt;&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Oyesu nyagbo mo, &lt;&lt;Ela ko Owuso ki kamo, kama Adole Owuso wo ma lo.&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Ebeni Ibiri ki byo Oyesu gogwejeji kikweyi kefu, kweyi shiyanu kpiri ko Obula ni bese mani ni kpa awoza kigyashi ni banu ni. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Okadanu mo, &lt;&lt;Nyya dawo kpiri koza neshi ni nshiyawo ni, owoni okwagye geyagye dami.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Oyesu nyagbo mo, &lt;&lt;Ibiri, gashun!&gt;&gt; Ela ko Owuso ki kamo, &lt;&lt;Oya geyagye da Adole Owuso wo; Anu kin pini oya gbeshe danu la.&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ebeni Ibiri ganu, kweyi ayoleho ko Owuso wato Oyesu abo.<verse eid="MAT 4:11" /></para>
  <para style="s">Oyesu Kwotu koko nu Okpagye ko Ogalili</para>
  <para style="r">(<ref loc="MRK 1:14-15">oMak 1.14-15</ref>; <ref loc="LUK 4:14-15">oLuka 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ishini Oyesu pwomo ayo Oyohana toruduru ni, osho okpagye ko Oyahudiya bita gokpagye ko Ogalili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ishini ofagye ko Ogalili ni, oyagye ogya ko Onazareti lo, oke gayagye ogya ko Okapanahu ni yo pee kpishu ko Ogalili ni, Okpagye ko Ozebulu kpo okpagye ko Onaptali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Omani gbodagye shini ela ko Owuso ni inobane Ishaya kani na wokwokwoshi:<verse eid="MAT 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Ala awase ko okpagye ko Ozebulu, ala awase ko okpagye ko Onaptali, agbabo kishu, ebelenu bwishu ko Ojoda,</para>
  <para style="q2" vid="MAT 4:15">ipu ko okpagye ko Ogalili, ebeni awase ni wase ko Oyahuda lo nwashika bipu kala,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />awase ni bebe dibu ni, olayi bwebe ko Owuso wa dawa.&gt;&gt;</para>
  <para style="q2" vid="MAT 4:16">Awase ni ke bokpagye ni gbo obowu ki ikwu ni, ola bwebe ko Owuso ki yu dawa. <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" />Bwebe ni, Oyesu kwotu kotono kela ko Owuso mo, &lt;&lt;Ala shagbotu sho ozalabi kala shini ala totuso Owuso, ela koni obula kiso yo pee ni.&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Awo foko, kikyikyo ko Oyesu</para>
  <para style="r">(<ref loc="MRK 1:16-20">oMak 1.16-20</ref>; <ref loc="LUK 5:1-11">oLuka 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Eno oye Oyesu ya yawu agbabo kishu ko Ogalili. Ni oyipu kiyawu ni Oma awayene epa, Osimo ni aba yogwu mo Obitrus ni, kpo Andru. Aba sheya ko kwebe kinyi, koni awawo kwebe kinyi ni. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Oyesu yuwo ogwu kamo, &lt;&lt;Ala wa, shini ala wawawo foko hin, shini na shiyala owe ko bya ase wa dami; byoni ala ba kwebe kinyi ni.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ebebeni ashe eya wa bita kweyi gboso Oyesu.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Osha gohobu kee, oma awayene epa mamani, Oyakubu oyi ko Ozebedi kpo oyinanu Oyohana. Abipu kowu kpada wa Ozabadi, ba kyeya wa ko kwebe kinyi tu. Kweyi Oyesu yuwogwu. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ebebeni asho owuwa kpada wa bita, kweyi gboso Oyesu.<verse eid="MAT 4:22" /></para>
  <para style="s">Oyesu Foza, Otono, ki Ngmo Ose</para>
  <para style="r">(<ref loc="LUK 6:17-19">oLuka 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Oyesu gyehe tokpagye ko Ogalili kpiri, yafoza ekpa <note caller="+" style="f"><char style="fr" closed="false">4.23 </char><char style="ft" closed="false">Ebeni oya lemani, go ohobu ipu ko okpa aba ta mo ekpa kin </char></note> ya tono ebebe nya ikweyi koshu neshi kobula ko Owuso. Awase ni gbose gogo-gogo ni, kpa awase ni ba gbere ni, odawo gege kpiri. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ela koza ni oya ni, gebebenya okpagye ko Osiriya, kweyi abyawase ni gbose gogo-gogo ni webe nu bwokpagye ko Osiriya koni oya ngmawa ni. Kpiri ka awase ni ikpiye ya duwose kotata ni, kpa awase ni gbo omaku bibi ni, kpa awase ni gbose ki ikpikpi ni, kpa awase ni gbose ko winyi ni, Oyesu dawo ogege ki ikpiye wa kpiri. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ewa nwashika gboso gebebenya ni oga ni ase bwo okpagye ko Ogalili, kpe ebeni ayo mo ogya igwo ni, ogya nyakwu ko Ojerusele, kpo okpagye ko Oyahudiya kpiri, kpa awebeni yo ogbeyi kishu ko Ojoda ni.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Awoza ni Oyesu Fu Ikweyi ke Efu ni</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ishino Oyesu mewa kasuse ba webenu ni, otoshi giso kefu ga yagye, awogboso webe nu, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />bwebeni okwotu ko fuwoza mo:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Otunehe yo kpa awase ni ba totu sun ni,</para>
  <para style="q2" vid="MAT 5:3">obula kiso wakakawa la.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Otunehe yo kpa awase ni ba byotu ni,</para>
  <para style="q2" vid="MAT 5:4">oya shinyo shosha shuwotu.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Otunehe yo kpa awino zikweyi iso lo,</para>
  <para style="q2" vid="MAT 5:5">aba rogwu kese.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Otunehe yo kpa awo ngmemye</para>
  <para style="q1" vid="MAT 5:6">kpi igyini ko yoza neshi no Owuso ya yimu ni,</para>
  <para style="q2" vid="MAT 5:6">aba yipu.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Otunehe yo kpa awo miyinyinyi kase,</para>
  <para style="q2" vid="MAT 5:7">oya miyinyinyi wa.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Otunehe yo kpa awase ni gbotu neshi,</para>
  <para style="q2" vid="MAT 5:8">aba mo Owuso.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Otunehe yo kpa awo byo yagye mene webe kasuse,</para>
  <para style="q2" vid="MAT 5:9">aba yuwogwu mayi ko Owuso.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Otunehe yo kpa awase ni adawo owe</para>
  <para style="q1" vid="MAT 5:10">ikweyi koni ayoza ni Owuso ya yimu mana ya ni,</para>
  <para style="q2" vid="MAT 5:10">obula kiso wa akakawa la.&gt;&gt;<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Otunehe yo kpala ni asala esa, adala owe aki ko bibi dala ikweyi koni ala totusun ni. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Shotunehe kpeye, koni ogba abola nyakwu iso ni, byoni adawi inobane ni wa kwobonu dala ni owe, mamani akiba dala owe.&gt;&gt;<verse eid="MAT 5:12" /></para>
  <para style="s">Oyesu foza ikweyi ko Onwa kpo Oyoyu.</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ala lema byo onwa kese mani la. Owoni onye ko onwa nyeba, oya wonwa ke? Oyashoshi ko yojije kponu kpanu kelo, aba yoshonu akiya dikpo. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Ala lema byo oyoyu kese la. Ogya ni yikweyi kikpokyi ni yateba lo. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Ase ya kwola ikwomu aheye ko ogwugwu lo. Aba hikweyi ko oka la shini onayu dananoho ipu ko ole. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Mamani oni, oyoyu kala na gebe kasuse, shini ana moko neshi kala shini ana shiye ka Ada kala ni yiso ni.<verse eid="MAT 5:16" /></para>
  <para style="s1">Oyesu Foza Ikweyi Kono</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Ala kaze mo nwwa koyo ozafofu kono bya kwe ozafofu kawo bane lo; nwwa shini oza ni afu ni na gbodagye. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Nyya ka dala okwokwoshi, kwiso kpese kweyi, titi kwe ofofa ipu kozafofu kono ya gebi lo sojoji kpiri gbodagye. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Kpiri kase ni yoye ipu kono mani ni omo woleke yikyigbo kwe oki fawashe koya mani, Owuso ya yuwogwu mase leke obula kiso. Kpiri kase ni pwo ozafofu kono mani ki yoko kpanu oya wanyakwase obula kiso.<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />Nyya ka dala, owoni ala yoza ni Owuso ya yimu ni nasha kawo Ofarisi kpa awofoza lalo alaba gobula kiso lo.&gt;&gt;<verse eid="MAT 5:20" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi ka Onya kyokye</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Byoni ala pwo aka dawosokwu kaha nekye mo, &lt;Ka ngmase lo, kpiri ka ase ni ngmase aba kwepwo.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Anani nke ya ka dala: ase ni kyanya kpo oyinanu aba kwepwo, kwikikyeni ase ni ka do oyinanu mo, &lt;Awo shoshi yeye.&gt; Aba byo gobutu ka awonongbo, kweyi ase ni ki yoyinanu ogwu mo, owase yeye kese oya gola ka Alekwu.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Byoni olemani, owoni oya byeshi wa do Owuso okpe kweyi oya mo ogbela kpo oyene wo, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />Sheshi wo bita ohobu kokpe ko Ole ko Owuso. Kwikye ga yela gwo kpo oyene wo, ime owa zeshi wo do Owuso. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Yela gwo kpo oyene wo papa ni ya byo goda kepwo ni. Yela gwo kpa anu ishini ala tayayo bowe ni, lalo oya byo gobutu kino kepwo, ino kepwo yayo nabo dino byase goruduru shini nayo toruduru. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nyya ka dawo okwokwoshi, oya bose lo sosore kikwiri kpiri nogbo ni.&gt;&gt;<verse eid="MAT 5:26" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi Kebaboba</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ala pwo akamo, &lt;Ala ka beba lo&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Nyya ka dala kpiri kase ni yiyi kwonya ki gbimoza ipu kotu nu, obeba kpanu ipu kotu nu piyoma. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Owoni iyiwo ka abore ya byo gipu kozalabi, yo ngma tonu. Oya shoshi ko gbiyi oye shoni aba yi ikpiye kpiri atola kpiyi epa ni. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Owoni abore wo ya byo gozalabi, yogo tonu, ashoshi shini oyo kpa abo oye, shoni agola kpa abo epa kpi ikpiye wo kpiri ni.&gt;&gt;<verse eid="MAT 5:30" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi ko Kabo konya kpo Oba</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;Aki kamo, &lt;Ase ni kabo kpo onya nu kpiri na dano olobene kabo koko.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ami ya ka dala mo, ase ni kabo kpo onya nu kpiri, owoni owela keba la lo, obeba piyoma, ase ni ki gbo onya oye ni kabo kpo obunu oya beba kpanu piyoma.&gt;&gt;<verse eid="MAT 5:32" /></para>
  <para style="s">Kayo Owuso Ogwu yeye lo</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ala ki pwo aka dawosokwu ka mo, &lt;Ala ka yenegwogwa kala yi pya lo, ala byene nala gwa da Adole ni pya.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ami ke yaka dala mo, ala ka gwene kpiso lo kpiri koni owebe kose Owuso, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />kwe, gwene kpo okpagye koni owebe ko hikpo nu ni, kwe gwene kpiye ko Ojerusele, koni owogya kose nyakwu ni. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ka gwene kpi ikweyi wo lo, oya gege ya pyo oya kikweyi wo oye yawo nehe kwe onobi lo. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Kamo, &lt;Ee&gt; kwe &lt;Aayi&gt; ozani gogo kpo omani kpiri bwebe kobibi pini wala.&gt;&gt;<verse eid="MAT 5:37" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi kore sosa</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Ala pwo akamo, &lt;Ase ni yashe iyi ngma ana yakakanu yi ngma, ase ni yashe ahanu shu ana yakakanu shu mamani.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ami ke yaka da ala, ozabibi ni ase yoni kasore lo. Owoni ashe labo akpaha kabore pya kaboshe danu naki labo anu. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Owoni ashe ya yimu kobyo goda kepwo koyo opawo bize, yobagidi wo manu danu. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Owoni ashe byo koshu mo ziyo kigbo oye, zega kpanu kigbo epa. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Ase ni doka koza odanu, kweyi ka pyitikpi tase ni ya yimu ko kpoza ebewo ni lo.&gt;&gt;<verse eid="MAT 5:42" /></para>
  <para style="s">Yimu ko Omonye-kwotu wo</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ala pwo akamo, &lt;Yimu kase ni wose wo ni kin kweyi otela kase ni wo omonyekwotu wo ni.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Nke ya ka dala, ala yimu ka awomonyekwotu kala, shini ala ki tinarigwu dawase ni ba dala owe ni, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Shini ala wayi ka Ada kala ni yiso ni. Oyenose dase bibi kpase neshi, kweyi oki yo Owuso wa da aseneshi kpase bibi. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Owoni, ala ba yimu ka awase ni ba yimu kala ni kin, ojiya wa abola kala? Awozegba ba yama ni lalo? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Owoni oya toyene wo ogbogba kin, oji no oyaya ni yogogo kpa awase shishini? Awopeka baya mani lalo? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Ni olemani, ala yojoji kpiri gyogye byoni Ada kala ni yiso ni yoza kpiri gyogye ni.&gt;&gt;<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Ozafofu ko Oyesu ikweyi keshi yoya Dawoleha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Ala gbera, ozayoya neshi kala naka wakiyi kasuse niba kala ni lo. Owoni ala yamani, ala bagbabola neshi ebe ka Ada kala ni yiso ni lo. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Owoni ala badoleha eshi, ala kaka nwa shini ase napwo lo, byoni awoyoziyi baya ekpa kpikweyi kowe, shini ase na kawa. Nyya ka dala okwokwoshi, akwobonu zabola wa kpiri ebe kasuse pini yoma. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Mani oni, owoni oya doleha eshi, kayoyene wo niyo kpa awo naka gyoza ni oyaya ni lo. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Owoni oya mani, ase ni odanu eshi ni kpo Owuso na gyoza ni oyaya ni. Shini Ada kala niya moza ni asuse baya tebani kpiri na dala abola neshi.&gt;&gt;<verse eid="MAT 6:4" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi kinarigwu</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Ishini ala ba tinarigwu, ala kaya byoni awoyoziyi baya ni lo! Aba yimu ko tinarigwu aba hagye iso ipu kekpa kpo oweshepa kipu ko ogya shina ase na muwa. Nyya ka dala okwokwoshi, akwobonu pyabola wa kpiri ebe kasuse pini yoma. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ishini ala ba tinarigwu, ala gipu ko oda, yofunu gwu kweyi ala tinarigwu da Ada kala, ni aba mo lo ni. Shini Ada kala, ni yamoza ni ala baya tebani, na da ala abola. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />&lt;&lt;Ishini ala ba tinarigwu, ala kaka kyaka gbikweyi lo bya awopeka ni lo, aba ma byo bwebe kela nwashika wa pini eka ya dawoza ni aba doka ni la. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Ipu kinarigwu kala, ala kalema bya awa ni lo, ome ala doka Owuso Ada kwobonu gyoza ni ala ba yimu ni wa.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Inarigwu ni ala ba tani yoma:</para>
  <para style="q1" vid="MAT 6:9">&lt;Ada ka ni yipu kiso ni,</para>
  <para style="q1" vid="MAT 6:9">Ashawiye koni owo Owuso sere ni. <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />Obula wo nawa,</para>
  <para style="q1" vid="MAT 6:10">asuse na yoza ko otuwo,</para>
  <para style="q2" vid="MAT 6:10">ipu kese byoni aba yo ipu kiso ni.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Daha ozarore kaha kikyeni.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Yozalabi ka gbaha,</para>
  <para style="q2" vid="MAT 6:12">byoni aha ba gbawase ni yaha ozalabi ni.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ka byaha gipu komama lo,</para>
  <para style="q1" vid="MAT 6:13">kweyi ngmaha shabo kibiri.&gt;<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />&lt;&lt;Owoni ala yigbase ni yala ozalabi ni, Ada kala ni yiso ni yayigba la. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Owoni ala yozalabi yigbase lo Ada kala ni yiso ni ya yozalabi kala gbala lo mamani.&gt;&gt;<verse eid="MAT 6:15" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi kokwunu kwokwu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Owoni ala ba kwokwunu, ala ka gbiyi byoni awoyoziyi baya ni lo, aba yiyiwa gbo shini ase nagye mo aba kwokwunu. Nyya ka dala okwokwoshi, akwobonu pya abola wa kpiri ebe kasuse pini yoma. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ishini ala ba kwokwunu, ala yahiyi kala na, ala nyano ikweyi kala. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />Ala ya mani shini ase na kagye mo ala ba kwokwunu lo, shini Ada kala fufunu ni ase ba mo lo ni kin nagye, kweyi Ada ni ya moza ni ala baya tebani, na dala abola.<verse eid="MAT 6:18" /></para>
  <para style="s">Ozafofu ko Oyesu ikweyi ko kpodu tukpa Iso</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Ala ka yo Odu kala kpo tukpa ese mani lo, ebeni eha yatu kwe oya kwoka ni lo, kwe ebeni awowiyi agege akyofunu kweyi agoda ga wiyi lo ni. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Byoni olemani oni ala yodu kala tukpa iso, ebeni eha yatu kwe oya kwoka lo ni, ebeni awowiyi ba gege ko kyofunu goda ga wiyi lo ni. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ebeni odu kala yanuni, ebeni pini otu kala yayanu la.<verse eid="MAT 6:21" /></para>
  <para style="s">Iyi Wemu Kikpiye</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Iyi lema byo ikwomu kikpiye la. Owoni iyi kala gbo ogege, oya mebe neneshi. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Owoni iyi ke yadose ebe kpiri ikpiye wo ya dibu. Owoni owofiyi, oya gege ya mebe kelo kpiri.<verse eid="MAT 6:23" /></para>
  <para style="s">Geyagye do Owuso kwe Iyo Kese</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Ashishe ya gege yagbeshe dadole epa ishi oye kponu lo. Oyatela koye kweyi yimu koye, agboso oye kweyi yatela koye. Byoni olemani oni oya gege ya yimu ko Owuso kpi ikwiri lo.&gt;&gt;<verse eid="MAT 6:24" /></para>
  <para style="s">Ala totuso Oza ni Owuso yaya dala ni</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Ni, olemani nyya ka dala mo, ala ka byotu ikweyi kowushoshu kala lo, ela kozarore kpinyi gwogwa; kwe ela kikpiye kpoza ko shoko. Owushoshu kala shozarore lo, kwe ikpiye kala shiyo lo? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ala ma awigbano ni bawu iso ni, aba toza lo kwe aba kizire lo, aba shizire owuya lo, kwikyikyeni Ada kala ni yiso ni ya dawozarore. Ala ke shawi igbano mani ebe nu lo? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Anoho ipu kala ni otubyobya nu ya fishi oye ya molayi nu?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Ojiya ni ala ba byotu ikweyi koza shiye kala? Ala mawo shefu kikyashi. Aba yoko kwe aba toshiye ka biyiwa lo. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Kwikyikyeni nyya ka dala mo kwose Osolomo kpo odu nu, ozashiye nu shoshi fakawo oshefu kefu lo. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Owoni olemani pini Owuso ya shakyashi iyo la, ala muwa ikyeni kweyi okyi ayuwa kpo shakyala, ala awine kotuse gbayayi, oya gege ya shala iyo ni shoshi sha kakyashi ni lo? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />&lt;&lt;Ni olemani, ala ka byotu kamo, &lt;Ozarore hin yawa bwini lo? Kwe inyigwogwa hin? Kwe oshiye hin?&gt; <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Awopeka ba labo kawoza mani kpiri, Ada kala ni yiso gye mo ala ba yimu kawoza mani lalo. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Mani oni, ikyikyo ala labo ko obula ko Owuso kpo oneshi nu, oza ni ala ba yimu kpiri oya dala. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Ni olemani ala ka byotu ikyeni ikweyi ko oza ni ala ba yimu okyi lo, okyi ime ala byotu koza ni ala ba yimu ni. Eno kpiri gbo oza ni ala ba byotu ikweyi nu ni.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Ozafofu ko Oyesu ikweyi Kepwo Koka</para>
  <para style="r">(<ref loc="LUK 6:37">oLuka 6.37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt;Ala kakwase epwo lo, shini Owuso naka kwala epwo lo. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Byoni ala ba kwase epwo ni, mamani pini Owuso ya kwala epwo la, owe ni ala bwu ome ala kwase epwo ni, owe ni pini Owuso ya bwu ya kwala epwo la.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Ojiya ni oya mikpo kikyashi iyi ko yene wo, kweyi osho ogbulo ni yipu kiyi wo ni bita? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Oya kado oyene wo moji, wa na yikpo kikyashi ni yipu kiyi wo ni ngma; ome awo ke gbo ogbulo yiyi wo? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Awo olanwe, ikikyo yogbulo ni yipu kiyi wo ni yi ngma ome shini omebe neneshi ko yikpo kikyashi ni yiyi ko oyene wo ngma.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Ala ka yoza ni wo sere ni yidiwo lo, koni oya pya ya fala ahanu; kwoza kimu kala kayi shobutu karuma lo. Owoni ala ya mani aba dikpo.<verse eid="MAT 7:6" /></para>
  <para style="s">Ala doka, ala labo, ala gwofunu</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Ala do Owuso oka koza ni ala ba yimu oya dala, labo koza ni ala bayimu ebe ko Owuso ala bapye; ala gwofunu ko Owuso oya gwa dala. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kpiri kase ni do Owuso oka koza oya danu; ase ni labo koza ebe ko Owuso oya ma; ase ni gwofunu ko Owuso, Owuso ya gwa danu.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;Anoho kala, ni oyinu do oka kikyoga kweyi adanu ikyikpo? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Kwowoni odoka ke ebinyi, adanu ya danu egwa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Owoni ala ase bibi bagye ko dayi kala oza neshi ni abadoka ni, Ada kala ni yiso ni gbotu neshi shala ni ya dala oza ni ala badoka ni! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Ni olemani, oza ni ala ba yimu shini ase na ya dala, ala ya dawa mamani; omani pini wozafofu kono ko Omusa kpa awinobane la.&gt;&gt;<verse eid="MAT 7:12" /></para>
  <para style="s">Ala gipu ko owe pyopyi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Ala gobula ko Owuso bwo owe kofunu pyopyi. Koni owe kofunu gwogwa kpo owe gwogwa ya byase gikwu ko gbogbo-gbogbo, ase lewa ba bwanu la. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Byoni olemani, owe pyopyi pini ya byaha golayi kweyi ase gbayayi pini ba bwu la.<verse eid="MAT 7:14" /></para>
  <para style="s">Ase ba gye Efu bwo ogwogwa nu</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Ala gbera kpa awobane ko kame. Aba webe kala byo otukpo ni gbotu neneshi, ipu kotu wa alema byi iwo kikyashi niba yala ofoni. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Bwebe koza yo yawa ala ba gyuwa. Ala ba pyo ogwogwa kofig bwefu kigye lo, kwo odu ya gwigye lo. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Mamani oni, edo kefu loshu ya gwa nyakwu, kweyi efu ni ya gbere yagwa tititi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Efu loshu yagwa tititi lo, mamani efu niya gbere yagwa nyakwu lo. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kpiri kefu ni gwa neshi lo, aba yigo kweyi ta gola. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ni olemani oni, ala bagya awinobane bwebe koko wa.<verse eid="MAT 7:20" /></para>
  <para style="s">Oyesu ya kamo ngya ala ebibye lo</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Kpiri kase ni ba yumogwu mo, &lt;Adole, Adole,&gt; Pini ya gobula ko Owuso la lo, ke ase ni yoza ni Ada hin ni yiso yimu mo ana ya ni. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ase lewa ba ka dami eno ko kepwo mo, &lt;Adole, Adole, aha tono kela ko Owuso ipu kiye wo, kweyi aki no omaku bibi enya shikpiye kase ipu kiye wo, aki yoza kigbashi nwashika ipu kiye wo.&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ebeni nyya ka dala mo, &lt;Ngyala lo. Ala ga shebeni, awo yozabibi!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Igwu kase Epa ni Mole wani</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Ni olemani oni, kpiri kase ni pwela hin mani kweyi yoko kpanu, olema byo oziyi ni mole nu ikweyi kikyikpo ni. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Owuso wa, inyo nwokpa, owuta ole ni ke kye lo, ela koni ashikpo nu ikweyi kikyikpo ni. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ase ni ke pwela hin mani kweyi tela ko yoko kpanu, olema byase yeye ni mole ikweyi kisisagye ni. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Owuso wa okpa nwu, kweyi owu tole ni gbo.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ishini Oyesu kela kweyi ni, ase lewa ni bebeni igbashi yuwa kwu koza ni ofu ni, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Ikweyi koni ofuwoza byase ni gboshu ikweyi koza kpiri, olema bya awofono ni la lo.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Ongo ni gbo Ose ki Iyiwa ni Oyesu Dano Ogege</para>
  <para style="r">(<ref loc="MRK 1:40-45">oMak 1.40-45</ref>; <ref loc="LUK 5:12-16">oLuka 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Ishini Oyesu sa bwiso kefu ni, ewa kase gboso. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ongo oye ni gbose kiyiwa ni wa kwagye obutu nu, kweyi kamo, &lt;&lt;Adole, owoni okyogwu, oyun na pyogege.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Oyesu nabo ta kweyi ganabo kamo, &lt;&lt;Nyya yimu, ikpiye wo na pyogege.&gt;&gt; Ebebeni opyogege kikpiye nu. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Ebeni Oyesu ka danu mo, &lt;&lt;Kaka dashishe oza mani lo. Gebe kosapa shini na mogege wo; kweyi ozeshi do Owuso byoni ono ko Omusa kani, nawo oza ni ya shiyase kamo ogbogege.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Otuse Koteyi ka Adakare ko Oroma</para>
  <para style="r">(<ref loc="LUK 7:1-10">oLuka 7.1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Ishini Oyesu go Okapanahu ni oteyi kadakare ko Oroma webe nu, odoka shini na taabo. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Okamo, &lt;&lt;Adole, oshe hin winyi gwutokpagye ole ya mowe kotata.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Oyesu ka danu mo, &lt;&lt;Nyya wa dano ogege kikpiye.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Oteyi ka adakare kamo, &lt;&lt;Adole, nggye koni oya wipu kole hin ni lo, kela kin, ose koshe hin ya kweyi! <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ami abiyun wase ni yabo kawashe ni la, nkyi gba awadakare ba abo hin. Ngboshu, owoni nkadawa mana ga, aba ga, nkadawa mana wa, aba wa. Owoni nka da awayole hin mo ana yoza mani ake ba ya.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Ishini Oyesu pwozani ongo mani ka ni, igbashi yokwu kweyi okada awase ni ba gboso ni mo, &lt;&lt;Nyya ka dala okwokwoshi, nma ashishe okpagye ki Izrayila ni gbo otuse kotata byo ongo mani lo. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nyya ka dala mo, ase bawa bwo okpagye nwashika bawa bagye ebe kimya kpi Ibirayi, Ishaku kpo Oyakubu Obula kiso. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Awase ni obula kiso shu kowa akakaha ni ke, aba tuwa ya gese, ipu kebe dibu, ebeni aba kyegba kweyi ba shabo ahanu.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Ebeni Oyesu kado oteyi kadakare mo, &lt;&lt;Gole! Oyole wo ya pyogege byoni oyotuse mo oyaweni.&gt;&gt; Ni, olemani oni, oshe nu pyogege kikpiye nu.<verse eid="MAT 8:13" /></para>
  <para style="s">Nwashika kase ni ba Gbere ni Oyesu dawo Ogege kikpiye</para>
  <para style="r">(<ref loc="MRK 1:29-34">oMak 1.29-34</ref>; <ref loc="LUK 4:38-41">oLuka 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Ishini Oyesu wole ko Obitrus ni, omene konya ko Obitrus gwutagye ogwudu ikweyi koni oshu yayoni. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ebeni Oyesu ganabo, oshu shobita. Ebebeni onyiso kweyi oyozarore danu.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ishini eno shani, nwashika kase ni gbose komaku bibi ni, abyuwa webe ko Oyesu. Ono omaku bibi bose shikpiye wa ishini okela dawani, kweyi awine kere na byuwa webe nu ni odawo ogege kpiri. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Omani gbodagye shini oza ni inobane Ishaya kani na gya,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Oyere kaha ngma</para>
  <para style="q2" vid="MAT 8:17">kweyi ose ni yikpiye kaha ni yibize.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Awase ni Kamo aba Yimu ko Gboso Oyesu ni</para>
  <para style="r">(<ref loc="LUK 9:57-62">oLuka 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ishini Oyesu mewa kase nwashika shogba toni, oka dawogboso mo, ana sheyi kishu gese kanoni. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ebeni ashe ni ya fono ni, webe nu kweyi kamo, &lt;&lt;Inofoza, nyya gboso ebe kpiri ni oya gani.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Oyesu ka danu mo, &lt;&lt;Iyawu gbogo wa ko kyanu, igbano kiso gbole wa, oyi ka Asuse ke gbole ko yikweyi tanu lo.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Oye ipu kawo gboso ka danu kamo, &lt;&lt;Adole, kikikyo na gole gaya ada hin nyi ome nawa gboso.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Oyesu ka danu mo, &lt;&lt;Gbosun, shase ni zela ko Owuso loni bita na nyiyiwa.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">Oyesu yo owu loshu hagye</para>
  <para style="r">(<ref loc="MRK 4:35-41">oMak 4.35-41</ref>; <ref loc="LUK 8:22-25">oLuka 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ebeni Oyesu gipu kowu kinyo kweyi awogboso kanu. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Agye lo, owu loshu nyiso ishu, ebeni owu ni tani kpi inyo yayimu koyo owu bya. Oyesu ya gbola. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Awogboso shiyi, kamo, &lt;&lt;Adole, ngmaha! Inyo yayaha re!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Okela dawa mo, &lt;&lt;Ala ni gbotuse lo ni, oji yala ba yoshi?&gt;&gt; Ebeni onyiso kweyi okela dowu kpo ogwa kinyo, kweyi owu hagye. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Ango ni bebeni, igbashi yuwa kwu kweyi adoka mo, &lt;&lt;Ongo mani wanoho? Ome owu kpo ogwa kinyo ba pwela nu!&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Oyesu da Ango Epa ni gbo Omaku Bibi ni Ogege ki ikpiye</para>
  <para style="r">(<ref loc="MRK 5:1-20">oMak 5.1-20</ref>; <ref loc="LUK 8:26-39">oLuka 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Ishini Oyesu sheyi kishu gokpagye ko Ogadarin ni, ango epa ni gbo omaku bibi ni bwa amiri wa gbayi kpanu. Awozakoshi ni ashishe yagege ko bwo owe ni lo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />&lt;&lt;Angmegba kweyi kamo, Oji ni oya tikpo ebe kaha, Oyi ko Owuso? Owebeni ko daha owe ome ishi ko Owuso ko daha owe naya la?&gt;&gt; <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Pee kpawa ebeni, aruma nwashika ba roza. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Awomaku bibi mani bo Oyesu kamo, &lt;&lt;Owoni ongmaha shipu kawa mani, naha enya shini ahan gipu kawaruma mani.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Oka dawa mo, &lt;&lt;Ala ga,&gt;&gt; ebeni abose gipu kawaruma, kweyi kpiri kawaruma sa bwiso kefu gipu kinyo kweyi agekwu. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Awani ba gbeho kawaruma ni nyinya wa gipu kogya kweyi koza ni gbodagye kpa ango ni gbo omaku bibi ni. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ebeni kpiri kase kogya bose koga gbayi kpo Oyesu. Kweyi ishini amoni, abo mo naga shokpagye wa bita.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Oyesu dine ki ikpiyi winyi ogege</para>
  <para style="r">(<ref loc="MRK 2:1-12">oMak 2.1-12</ref>; <ref loc="LUK 5:17-26">oLuka 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Oyesu gipu ko owu kinyo, kweyi sheyi kishu gogya nu. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Awashe byo ongo oye ni gbose kikpiye winyi ni webe nu, gwutagye ikweyi kote. Ishini Oyesu mo otuse wa ni, oka dine kikpiye winyi mo, &lt;&lt;Ka gbotu lo, oyi hin; ayozalabi wo yina.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Ikweyi kela ni Oyesu kani, ashini ka awofono ka diyiwa mo, &lt;&lt;Ongo mani yoza bibi oya ziyinu byo Owuso!&gt;&gt; <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Oyesu gyoza ni yotu wa ni kweyi okamo, &lt;&lt;Ojiya ni ala ba yela kozabibi ipu kala mani? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Onya shashi she, ko kamo, &lt;Ayozalabi wo yina kwe ko kamo, nyiso sho yawu&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nyya yoza ni ala yagye mo Oyi ka Asuse gboshu ese mani ko yozalabi kase yina.&gt;&gt; Ebeni oka dine kikpiye winyi mo, &lt;&lt;Nyiso, zote wo shino ogole.&gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Kweyi ongo ni nyiso ganu gole. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Ishini ewa kase mamani ni, igbashi kpo oshi yuwa kwu, kweyi asho Owuso iye, anu ni dase oshu koyoza ni.<verse eid="MAT 9:8" /></para>
  <para style="s">Oyesu yo Omatiyu Ogwu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Ishini Oyesu shebe ni bita ya gani, omo ongo oye, iyenu wo Omatiyu yagye ebe kozegba. Oka danu mo &lt;&lt;Gbosun,&gt;&gt; kweyi Omatiyu nyiso gboso.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ishini Oyesu yaroza konose ole ko Omatiyu ni, awozegba lewa kpa awinozalabi shishini kpa awogboso bagye baroza kpanu. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ishini Awofarisi ma mani ni ada awogboso oka mo, &lt;&lt;Ojiya ni inofaloza yaroza kpa awozegba kpa awinozalabi shishini?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Ishini Oyesu pwuwani, okamo, &lt;&lt;Awase ni loshu ni ba gebe koloboshi lo, awase ni loshu lo ni pini ba gebe koloboshi la. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ala ga foza ni, okpa ko Owuso kani: &lt;Nyya yimu shase na gbiyinyinyi kiyi wa, wo peshi kin lalo.&gt; Nwebe ko yawa aseneshi ogwu lalo, ke wase ni ba yozalabi ni la.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Ase do Oyesu Oka Ikweyi Kokwunu Kwokwu.</para>
  <para style="r">(<ref loc="MRK 2:18-22">oMak 2.18-22</ref>; <ref loc="LUK 5:33-39">oLuka 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ebeni awogboso Oyohana wa doka kela mo, &lt;&lt;Ojiya ni aha kpa Awofarisi ba kwokwunu, awogboso ke ba kwokwunu lo?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Oyesu kyogwu dawa mo, &lt;&lt;Kwe ala mawoya koba konyape ba byotu ishini oba konyape yo kpawa ebe kimya konyape ni? Ishi ya waba ni aba yoba konyape ya bize shuwa ni. Ishi oni aba kwokwunu.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Ashishe ya gege ya yabo kayikyi pepe yagokwo nekye lo, koni ayikyi pepe yayo nekye yayi sha labi. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ashishe ke ya yinyi kinabi pepe yasheyi kokpa nekye lo. Owoni ayamani, eyi kokpa ya kya kweyi inyi kinabi ya shonu, olema lalo, aba yinyi kinabi pepe ya sheyi kokpa pepe la, shini kpiri wa naka yishi lo.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Oyi nonya ni Gekwu ni kpo Onya ni Gabo Oshiye ko Oyesu ni</para>
  <para style="r">(<ref loc="MRK 5:21-43">oMak 5.21-43</ref>; <ref loc="LUK 8:40-56">oLuka 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Ishini Oyesu yipu kela mani ya kani, oteyi kase ko Oyahuda oye wa kwagye obutu nu kweyi kamo, &lt;&lt;Oyi hin nonya gekwu anana mani oma. Obiwa yabo so shini ona gbolayi.&gt;&gt;<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Oyesu kpa awogboso nyiso kweyi ga kpanu. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Ebeni onya ni ya shonu kpo oyi ishayi igwepa ni kanu itikpi kweyi gabo akpaha koshiye nu. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Oka diyinu mo, &lt;&lt;Owoni nggabo akpaha koshiye nu kin, nyya pyogege ki kpiye hin.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Oyesu pya kweyi kamo. &lt;&lt;Oyi nonya kagbo otu lo! Otuse wo ngma wo.&gt;&gt; Ebeni opyogege kikpiye nu.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ishini Oyesu gipwole koteyi kase ko Oyahuda kweyi oma awotajigwo kpewa kasuse nwashika ba kyegba, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Oka dawa mo, &lt;&lt;Ala bose gese, oyinonya mani gekwu lo, oke ya gbola la.&gt;&gt; Ebeni ayeye <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Ishini onewa kasuse gese ni, ogipu koda kweyi, obyo oyinonya mani abo, kweyi onyiso iso. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Oshu mani gebe nye ipu ko okpagye ni.<verse eid="MAT 9:26" /></para>
  <para style="s">Oyesu Gwo Ofiyi Epa Iyi.</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Ishini Oyesu shebeni bita yaga ni, ango epa niwo ofiyi ni gboso ba shogwu yo mo, &lt;&lt;Oyi ko Odawuda! Miyinyinyi kaha.&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ishini ogipwole ni, ango epa ni wofiyi webe ko Oyesu, kweyi oduwoka, &lt;&lt;Ala gbotuse mo nyya gege ya yala mebe?&gt;&gt; Akyogwu kamo, &lt;&lt;Ayotuse mani adole.&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ebeni onyuwa abo iyi kweyi kamo, &lt;Byoni ala yo otuse ni, nyya diyi kala ogege!&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />kweyi iyi wa gwa. Oyesu pyuwa akpaha ko tata kweyi kamo, &lt;&lt;Ala kaya ashishe na gye kamo ami diyi kala ogege lo.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Abose gese ke ga ko oshu oni ebe kpiri okpagye ni.<verse eid="MAT 9:31" /></para>
  <para style="s">Oyesu yo odoho faha</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ishini ofiyi epa ni shebe ni bita ba gese ni, awashe byo ongo ni gbo omaku bibi ni ya gege ko kela lo ni wa to Oyesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Ishini ono omaku bibi enya gese ni, ongo niya kela lo ni kela. Igbashi yuwa ku kweyi akamo, &lt;&lt;Ojije lemani gbodagye Izrayila ni amamani wa lo.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ebeni ashini ko Awofarisi kamo, &lt;&lt;Ogege ko ngmo omaku bibi koni Oyo ose ko omaku bibi danu oshu ni.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Awo yoko ko Owuso lewa lo.</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Oyesu yawu gawogya nyakwu kpo oleke, kweyi ya foza ekpa, oya koshu neshi kobula ko Owuso kweyi ya dawine kose kpere kpiri ogege kikpiye wa. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ishini omewa kasuse ni, omiyinyinyi wa, koni aba byotu ni kweyi agbase kotuwabo lo, byo otukpo ni gbine kogbeho wa lo ni. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ebeni oka da awogboso kamo &lt;&lt;Izire ze eho, awo kyokye ke, le gbayayi. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ala ba Adole keho, shini natawo yoko oleho na geho ga kyizire.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Oyesu sha Ayikoko nu Igwepa.</para>
  <para style="r">(<ref loc="MRK 3:13-19">oMak 3.13-19</ref>; <ref loc="LUK 6:12-16">oLuka 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Oyesu ya awogboso igwepa ogwu kweyi dawo oshu kono omaku bibi enya shikpiye ka asuse kweyi da awine kose kpere ogege kikpiye.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Iye kawi ayikoko ko Oyesu igwepa yoma: kikyikyo wo Osimo ni oyogwu mo Obitrus ni kpo oyinanu Andru; Oyakubu kpo oyinanu Oyohana ayi ko Ozebedi;<verse eid="MAT 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 10:3" />Ofilibus kpo Obatolomi; Otoma kpo Omatiyu inozegba, Oyakubu oyi ka Alfayu kpo Otadiyu; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Osimo Okananaya kpo Oyahuda Iskariyoti, ni yora ni.<verse eid="MAT 10:4" /></para>
  <para style="s">Oyesu Tayikoko nu Igwepa Oleho</para>
  <para style="r">(<ref loc="MRK 6:7-13">oMak 6.7-13</ref>; <ref loc="LUK 9:1-6">oLuka 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Oyesu tayikoko nu igwepa oleho kweyi shiyawa oza ni abaya kpo olamuni abaya lo ni. Okamo &lt;&lt;Ala ka gebe kawase ni wo Oyahuda lo kwe ogya kase ko Osamariya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ala ke gebe kase ki Izrayila ni wo otukpo ko Owuso ni gebi ni. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ishini ala gebe ni, ala tono dawa kamo, &lt;Obula kiso yo pee.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ala dase ni loshu lo ni ogege kikpiye, ala yawase ni gekwu na nyiso ikwu, ala dawase ni gbose kiyiwa ni ogege kikpiye kweyi, ala na awomaku bibi shikpiye kasuse. Ndala oshu mani yeye la, ni olemani ala tase abo yeye. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ala ka byi ikwiri kozinariya kwe azurupa kwe otagula ikpiye kala lo; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ala ka byo oshu, kwe oshiye kwe okpabawu, kwe okwute lo; ikweyi koni aba sino yoko ore koko nu.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Ishini ala gogya nyakwu kwe oleke, ala labo kase ni ya zogboga ni shini ala sa ole nu gbishini ala shebeni bita. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ishini ala gipwole, ala kada ase kole ni mo, &lt;Omene ko Owuso nayo kpala.&gt; <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Owoni ase kole ni zala, omene kala nayo kpawa; owoni azala lo, omene kala na kwikye webe kala. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Owoni ashishe zala lo kwe pwono totu kala lo, ala gwo omula kapatikpo kala shebeni ishini ala ba shole ni kwe ogya ni bita. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Nyya ka dala okwokwoshi, Owuso ya miyinyinyi ko Osodom kpo Ogomora eno ko kepwo shase kole kwo ogya ni.<verse eid="MAT 10:15" /></para>
  <para style="s">Owe ni Awogboso Oyesu bawa mani</para>
  <para style="r">(<ref loc="MRK 13:9-13">oMak 13.9-13</ref>; <ref loc="LUK 21:12-17">oLuka 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Ami ya tala oleho gese byo otukpo ipu ki iwapashi ni. Ni olema oni, ala ziyi bye egwa shini alaka gbibya lo byo otitiribi ni. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Ala gbera kpase bibi; aba byala agoda ko kepwo kweyi aba yala aboshi ipu kekpa. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ikweyi koni ala ba gbosun ni, aba byala ya gebe koteyi agye kpa awose. Omani ke yawo owe ni ala tono kela hin dawa kpa awase ni wa Ase ko Oyahuda lo ni. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ishini ake kwala ga, ala ka gbotu ikweyi koza ni ala baka kwe owe ni ala ba ko ni lo. Ipu kishi oni Owuso ya dala oza kokoka, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />alagye mishi oni ala pini ba kela la lo, ke wo omaku ka Ada kala ya kela okwunu kala la.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Ipu kishi oni oyene ya byo oyinanu ga dawa koyi ngmo, ada ya byo oyi nu ga dawa koyi ngmo, ayi ba wewa koko kada wa kpi inawa kweyi ba byuwa ga dawa koyi ngmo. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Kpiri kase ba yimu ko miyi kala lo ikweyi koni ala ba gbosun ni, ase ni zotu hagye Owuso ya ngma nu. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ishini adala owe ogya oye, ala nyiso gogya oye. Nyya ka dala okwokwoshi, ala ba gege agogya ki Izrayila kpiri lo ome Oyi ka Asuse yawa la.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Ase ni afoza ni yasha ase ni fo ni lo, kwe oshe yasha adole nu lo. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Oyashoshi ase ni afoza na lema byase ni fo ni, oshe na lema bya adole nu. Owoni aya adole ogwu mo Obelizebu, edo kiye wonya ni aba ya ayole nu ogwu kpanu lo!<verse eid="MAT 10:25" /></para>
  <para style="s">Ala Yoshi ko Owuso</para>
  <para style="r">(<ref loc="LUK 12:2-7">oLuka 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Ala ka yoshi kasuse lo. Ishi yawa ba ni ojoji ni ayi teba ni aba yi tese, oza ni ayi teba kpiri aba yase agye. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Oza ni nyya ka dala ipu kebe dibu ni ala ko isheno, oza ni nka dala kyo ni, ala ko nwaa dase na pwo. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ala ka yoshi kawa ase ni ba yikpiye ngmo ni lo, ke bagege ko ngmo omaku lo, ala ke yoshi ko Owuso ni gboshu koyo omaku kpi ikpiye shipu kola ko gbogbo-gbogbo. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ase bagege ayi igbano epa ra kpo otagula oye lo? Koni ale titi ni, oyoye wa ya gbo okpagye lo. Ke sa Ada kala yimu. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Mamani Ada kala gyo nwashika ki inyeyi kala. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Mani oni ala ka yoshi lo; ala shoshi sha awigbano ebe ko Owuso.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Kpiri kase ni manu wino gbosun ebe kasuse ese mani, ami ya kamo anu waka hin ebe ka Ada hin ni yiso ni. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Kpiri kase ni kamo anu waka hin lo obutu kasuse ese mani ke, ami ya kamo anu waka hin lo obutu ka Ada hin ni yiso ni.<verse eid="MAT 10:33" /></para>
  <para style="s">Nbyo Mene wa la lo, ke Efukpokpo</para>
  <para style="r">(<ref loc="LUK 12:51-53">oLuka 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Ala kama ipu kotu kala mo, nwwa ko byotu mene wese mani lalo. Nke bye efukpokpo wala. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Nwa koyoyi nongo woyakonu ka ada nu, Oyinonya ya woyakonu ki inanu, kweyi onya koyi ya woyakonu kino obunu. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Ase ki ipwole wo bawo oyakonu wo la.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Kpiri kase ni yimu ka adanu kwe inanu shun, ogye ko gbosun lo, kpiri ka ase ni ya yimu koyi nu nongo kwe nonya shun, ogye ko gbosun lo. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Kpiri kase ni kyogwu ko zoshi nu kpo owe ni yawa tanu ikweyi hin lo, ogye ko gbosun lo. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Kpiri kase ni yimu kolayi nu shun, oya pye lo, ase ni kyogwu ayo ngmo ikweyi hin oya pyo olayi kogbogbo-gbogbo.<verse eid="MAT 10:39" /></para>
  <para style="s">Abola</para>
  <para style="r">(<ref loc="MRK 9:41">oMak 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Kpiri kase ni zala, ozun pini yoma, ase ni zun oza Ada hin ni tumoleho ni. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Kpiri kase ni zinobane koni owine kobane kela ko Owuso ni, Owuso ya danu abola byoni odinobane ni, kweyi kpiri kase ni zase ni yayo ozaneshi koni awaseneshi ni, Owuso ya danu abola byoni adase neshi ni. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Owoni ashe da ase ni ala mo wojije lo abwa kinyawo shosha koni oya gbosun ni, nyya ka dala okwokwoshi, oya pya abola nu.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Oyohana ino Obatisma tawo ogboso eleho ebe ko Oyesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ishini Oyesu kada awogboso igwepa oza koya kpo olamuni aba ya lo kweyi ni, oshebe ni bita kweyi ga awo ogya okpagye ko Ogalili, ebe ni ofa ase oza oki tono kela ko Owuso dawa.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Ishini Oyohana ino yo Obatisma yo oruduru ni opwo oza ni Oyesu Kristi yaya ni, ota awogboso oleho. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Ko do oka mo, &lt;&lt;Awo pini wo Okristi ni awobane kamo oyawa la kwe, ahan yi iyitagye gbeyi kashe hoha?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Oyesu kyogwu mo, &lt;&lt;Ala kwikye ga kado Oyohana oza ni ala pwo ebeni kpo oza ni ala mun yaya ni: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Awofiyi ba mebe, awokyikpo ba yawu; awo gbo ose ki iyiwa pyo ogege ki kpiye wa, awo odoho ba pwaha; awase ni gekwu ni nyiso; kweyi awoleha ba pwo oshu neshi ko Owuso. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Otunehe ko Owuso yo kpa awase ni otuse wa ikweyin hagye lo ni.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ni awogboso Oyohana ba shebe ni bita ni, Oyesu kwotu ko kela de ewa ka asuse ikweyi ko Oyohana mo: &lt;&lt;Ishini ala gebe ko Oyohana ododa ni oji ni ala ga ko ma? Ala ga ko ma agwu ni owu ya tuwa ni la? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Owoni olemani lo, oji ni ala gese koga ma? Ongo ni sho oshiye neneshi ni la? Aayi, awase ni ba sho oshiye neshi ni bo ole kawo ose la. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Kwe, oji ni ala gese koga ma? Ala ga ko mino obane la? Olemani, ase ni ala gese ko moni shino obane. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Oyohana pini wa ase ni okpa ko Owuso ya kela ikweyi nu ya kamo:</para>
  <para style="q1" vid="MAT 11:10">&lt;Ma, nyya to oyelehon eleho ya kwobonu dawo,</para>
  <para style="q2" vid="MAT 11:10">shini nawa kyowe gbishi wo.&gt;<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Oyesu kamo, nyya ka dala okwokwoshi, Oyohana ino yo batisma wo nyakwu shananoho ni wo omoma kanya ese mani; ase ni ke wo ojije lo obula ko Owuso ni sho Oyohana la. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Bwi ishi ni Oyohana ino yo batisma ya tono ni wishi mani, ase ba takirikwu ko go obula ko Owuso kpo oshu wa kweyi awine ko otu bibi ba yimu ko yo owe ko obula ki giso yi gwu. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ime Oyohana ino Obatisma nawa kwo otu ko tono, awo obane ko ono ko Omusa, bane kela ikweyi ko obula ko Owuso; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Owoni ala kyogwu ko yotuso oza ni aka ni, ala ba gye mo Oyohana pini wi Iliya ni yawa ni la. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ase ni gba akpaha ko pwe ela na pwo.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Oji ni nke ya kamo ase kese ki ikyeni bya nu? Alema bya ayi le ke ni bagye otutehe ko ogya ba tiga ebe ni ase ba gbayi ni, kweyi ba ya awo oya wa gwu,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />akamo, &lt;Aha tajigwo ko onyape dala!</para>
  <para style="q2" vid="MAT 11:17">Ala gyoba lo;</para>
  <para style="q1" vid="MAT 11:17">Aha wigye ki ikwu dala,</para>
  <para style="q2" vid="MAT 11:17">ala ke kyebga lo.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Ishini Oyohana wani, okwokwunu, oke gwinyi kinabi lo. Akamo, Ogbo omaku bibi. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Oyi ka Asuse ke wa, oya roza ya gwinyi, akamo oya roza kpinyi nwashika, oya yawu kpa awozegba kpa &lt;&lt;Awo yo ozalabi shishini.&gt;&gt; Ishini ase yo oza ni wo ogyogye ebe ko Owuso oza ni aba ya ya shiya ase mo Owuso wokwokwoshi ipu ko oza ni oka ni.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Oyesu kela kpo oko loshu dawase ni tela ko shagbotu ni</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Awase ko ogya ni Oyesu yo oza ki igbashi nwashika ni tawa ko shagbotu, okela dawa kpo oko loshu kweyi kamo, <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Igbe na tala ase ko Okorazin kpo Obesayida! Owoni oza ki igbashi ni nyya ebe kala ni, obiwo Otaya kpo Osidon la, abi shagbotu gbeji wa kweyi bya sho oshiye ko otu byobya kpi iyawu ikpiyewa. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Nyya ka dala mo, eno ko kepwo ko Owuso ya miyinyinyi kawase ko Otaya kpo Osidon sho oni oya ya dala ni! <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ala ase ko ogya ko Okapanahu, ala kama byo Owuso ya za ala wa ase neshi gi iso? Oya kpa ala ya sho ola. Abi kamo oza ki igbashi ni nyya ogya kala ni bi gbodagye ogya ko Osodom, ogya ni biya yaba kwikyikyeni. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ami ke inya kada ala mo eno ko kepwo ko Owuso oya miyinyinyi kase ko Osodom ya shala.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Ala webe hin shala minyo</para>
  <para style="r">(<ref loc="LUK 10:21-22">oLuka 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ishi oni Oyesu kamo, &lt;&lt;Ada, Adole awo ni yiso kpo okpagye ni, ko okwokwoshi nshotunehe do koni oyo oza mani yi teba da awine ko ziyi kpa awine ko zi ikweyi giso kweyi oyi shiya ase ni le bya ayi le ke ni. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ada, oya mani koni ebe wo, oma mo owo oza neshi ni.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Ada hin yo oza kpiri yi dami, ashishe gyo Oyi lo, sa Ada nu. Ashishe gya Ada lo so Oyinu, kpa wa ase ni Oyi yimu shini Ada nu na gyuwa ni.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Ala webe hin, ala ni yoko nwa kweyi byiyo lenu ni, ami ya dala ominyo. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ala gipu ko oko hin, ala ki fu ebe hin, koni nwine ko otu mene nki ya zikweyi iso lo, nyya dala ominyo. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ikweyi koni oko ni nyya dala ni lono ko ya lo, kweyi iyo ni nyya dala ni ya lenu lo.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Okadoda Ikweyi Ke eno Ko minyo</para>
  <para style="r">(<ref loc="MRK 2:23-28">oMak 2.23-28</ref>; <ref loc="LUK 6:1-5">oLuka 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ishi oye, Oyesu ya yawu ipu ke eho eno ko minyo ko Ase ko Oyahuda, kweyi awogboso, emye ya ngmuwa, kweyi aba kwabo ko drizire kweyi ha. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ashishini ko Awofarisi muwa baya mani ni, akado Oyesu mo, &lt;&lt;Ma! Awogboso ba gboso ono ka Ase ko Oyahuda mo oshoshi eno ko minyo ka lo.&gt;&gt; <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Ebeni, Oyesu ka da awa mo, &lt;&lt;Ala kwobonu gye ipu ko okpa ko Owuso oza ni Odawuda kpa awo oya kokonu ya, ishi ni emye ya ngmu wa ni. <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ogipu ole ko Owuso kpa awo oya ko oko nu kweyi hi ikyoga ni ono wuwobi ko ha ni, mo owa ko Osapa kin la. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ala ki gye ipu ko ono ko Omusa mo akyogwu da awo osapa na yo oko Ole ko Owuso eno ko minyo ashishe ke kada awa mo owoza labi lo. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nyya ka dala mo, ase ni sho Ole ko Owuso ye ebe ni. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Okpa ko Owuso mo, &lt;Oza ni nyya yimu sha ase na yani wo ana mi iyinyinyi ki iyi wa, sho peshi na aba ya dami ni,&gt; Owoni alabi gye mani alabi ba bya awase ni gbe epwo ikweyi ko oza ni aya ni lo. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Koni Oyi ka asuse wa Adole ke eno ko minyo ko Ase ko Oyahuda la.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Ongo ni abo nu wi ine ni</para>
  <para style="r">(<ref loc="MRK 3:1-6">oMak 3.1-6</ref>; <ref loc="LUK 6:6-11">oLuka 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Oyesu she ebe ni bita kweyi ge ekpa. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Ebeni, omo ongo oye ni abo nu winyi ni. Kweyi ashishini ko Awofarisi ba labo ko owe ko kwo Oyesu epwo kweyi adoka mo, &lt;&lt;Owo ono la, ko da ase ogege ki ikpiye eno ko minyo ko Ase ko Oyahuda?&gt;&gt; <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Oyesu kyogwu mo, &lt;&lt;Owoni ashe kala gbo otukpo oye kweyi gbo gogo eno ko minyo, oya nabo yayi ngma lo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Asuse shoshi sho otukpo lo! Ni olemani owo ono la koyo neshi eno ko minyo.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Ebeni okado ongo oni mo, &lt;&lt;Na abo ta.&gt;&gt; kweyi ona abo ta, opyo gege ka abo nu byoni abo nu ko me epa weni. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Awofarisi ke ge ese ga labo ko owe ni aba yo Oyesu ngmo.<verse eid="MAT 12:14" /></para>
  <para style="s">Oshe ni Owuso shu ni.</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ni Oyesu gyo oza ni Awofarisi ba gbo ikweyi nuni, oshebe ni bita. Kweyi ase lewa gboso. Ebeni odawa ase ni loshu lo kpiri ipu ke ewa oni ogege ki ikpiye wa. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Opyuwa akpaha mo, ala ka kada ashishi ase ni weni lo. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Omani gbodagye shini ela ni inobane Ishaya ka ikweyi nu ni nawokwokwoshi.<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Owuso kamo omani pini wo oshe hin ni shu ni la</para>
  <para style="q2" vid="MAT 12:18">anu pini wa ase ni nyyimu ni la, nshotunehe kpa anu;</para>
  <para style="q1" vid="MAT 12:18">Nyya yo Omaku hin ya gipu nu.</para>
  <para style="q2" vid="MAT 12:18">Oya kada ase kese kpiri mo nyya ngma awa<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Oya gbapwo kpase kwe oya ngmegba lo;</para>
  <para style="q2" vid="MAT 12:19">kwe owa kela oko loshu kpase ikweyi ko owe lo.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Oshe hin ni nshu ni ya wi ine ki iyinyinyi da awase ni loshu lo kpa awase ni abi ikpo ni,</para>
  <para style="q2" vid="MAT 12:20">Owa gbi iyinyinyi kawase ni ba gege ko tiyi wa abo lo ni,</para>
  <para style="q1" vid="MAT 12:20">Oya go ohobu koyo neshi kpi iyinyinyi gbi ishini oneshi ya yo obibi yayi bya.&gt;&gt;<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Ase lewa ba yi iyitagye mo Owuso shu ni ko ngma awa.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Oyesu kpo Obelizebu</para>
  <para style="r">(<ref loc="MRK 3:20-30">oMak 3.20-30</ref>; <ref loc="LUK 11:14-23">oLuka 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Eno oye awa ashe byo ongo oye ni gbo omaku bibi webe ko Oyesu. Ongo ni wo ofiyi okiya kela lo ebe ni Oyesu dano gege ki ikpiye bwebe ko ngmo omaku bibi, kweyi ongo mani ya kela oki ya me ebe! <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Kpiri ke ewa ni bagye ni igbashi yuwa kwu kweyi akela kpi iyiwa mo, &lt;&lt;Kwa anu mani bwi ipwoma ko ose Odawuda la?&gt;&gt; <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Ishini Awofarisi pwo ogege ki ikpiye no Oyesu do ongo mani ni akamo, &lt;&lt;Oya ngmo omaku bibi koni ibiri na aba yogwu mo Obelizebu ose ko omaku bibi danu oshu koya mani ni.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Ni Oyesu gyo oza ni aba gbo ipu ko otu wa ni, mani oni okadawa mo, &lt;&lt;Obula ni ase nu ba gbapwo kpi iyiwa aba ya agye oni ya yishi. Mani oni ogya kwe ole ni yiyiwa ko ikpo ikpo kweyi ba gba apwo kpi iyiwa ogya ni kwe ole ni ba ko. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Owoni Ibiri ya ni ibibi enya, oyi iyinu ko pi yoma. Oya le moji no obula nu ya hagye? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Owoni ala kamo nyya ngmo omaku bibi kpo oshu ko Obelizebu. Anoho dawo gbosala oshu ko ngma awa? Ni olema oni, oza ni awo gboso ala ba yani ya shiyala mo oza ni ala ba ka ikweyi ni wo gyogye la lo. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Owoni nyya no omaku bibi enya kpo omaku ko Owuso, omani ya sayi da ala mo obula ko Owuso wa dala.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Kwa anoho ya gege ya gole kase ni loshu ni ga wiyi? So oke kwobonu yo gbo imbe oya go ole nu ga wi la. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Kpiri kase ni ya kyogwu kpe elan lo, owo oya konun la, kweyi kpiri kase ni ya kpase ya gbayi kpa ami lo oya yuwa ya pasha oma. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ni olema oni, nyya kada ala, kpiri ko ozalabi ni ase yo Owuso kpe ela bibi ni oka ikweyi nu, oya yigbuwa, Owuso ke, ya gbase ni kela bibi ikweyi ko Omaku ko Owuso lo. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Kpiri kase ni kela bibi ikweyi ko Oyi ka asuse, Owuso yo ozalabi nu gbo, kpiri kase ni kela bibi ikweyi ko Omaku ko Owuso, Owuso yozalabi nu gbo lo, kwe ishi mani kwe ishi ni yawa ni.<verse eid="MAT 12:32" /></para>
  <para style="s">Efu bwo ogwogwa nu</para>
  <para style="r">(<ref loc="LUK 6:43-45">oLuka 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;Owoni okye efu ya, efu ya gwa neshi. Owoni okye efu ya lo efu ya gwa neshi lo. Aba gye efu bwe ebe ko gwogwa nu la. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ala egwa, ala baya moji akela neshi ni ala ke wase bibi mani? Ela nwashika ni yotu pini okwunu ya kala. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ase neshi ya kela neshi ikweyi koni oya yela ko oza neshi ipu kotu nu, mamani ase bibi ya kela bibi ipu ko oza bibi ni ogbo ipu ko otu nu. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Nyya kadala mo kpiri kela bibi ni ase bakani, eno kepwo, aba ka arisawu nu. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Bwebe kela wo pini aya ngmawo la, kweyi bwebe kela wo pini aya kwe epwo la.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Ase doka koza kigbashi</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Eno oye, ashishini ka Awofarisi kpa awofono, ka do Oyesu mo, &lt;&lt;Adole, yo oza ki igbashi daha shini ahan gye mo obwebe ko Owuso la.&gt;&gt; <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Ebeni Oyesu kadawa mo, &lt;&lt;Awo yoza bibi kpa awo gbo otuse lo ki ishi mani, pini ba doka koza igbashi la! Nyya yoza kigbashi oyoye dala lo, so oni gbodagye kpi inobane Oyunana ni. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Byoni Oyunana yene eta kpo otu eta ipu ke ebinyi nyakwu oni, mani oni Oyi ka asuse ayeno eta kpo otu eta ipu ka amiri ese mani. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Awase ko Onineba kpase kishi mani wa nyiso aka dala eno ko kepwo mo, ala yo ozalabi; koni ase ko Onineba shagbotu ishi ni Oyunana ya kela ko Owuso dawa ni, nabani ase ni sho Oyunana ni yoma! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Ino ko kepwo Onya ni wo Inole ko okpagye ko Osheba ni ya hagye ko kwuwepwo, kweyi koni owa bwebe le nu wa pwela ko zafofu ko ziyi ko Osolomo, kweyi Ami tala otugbagba mo oje yaba ni sho Osolomon ni!<verse eid="MAT 12:42" /></para>
  <para style="s">Okwikye ko omaku bibi</para>
  <para style="r">(<ref loc="LUK 11:24-26">oLuka 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Owoni omaku bibi bose sho ongo, oya ga labo kebe ko minyo kweyi opye lo. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Kweyi okamo, nyya kwikye gole ni nbwanu wani, ishini okwikye wani, omole gbojije lo, gwogwu kweyi akya anu tu. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Kweyi oya gese ga bya awo omaku bibi ahapa ni shanu tata niwa, kweyi wa bagye ebe ni kpa anu. Mani oni, okweyi ko ongo ni wa labi sha kikyikyo. Owa lema ni kpa awase ki ishi mani.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Ene ko Oyesu Kpa ayinanu</para>
  <para style="r">(<ref loc="MRK 3:31-35">oMak 3.31-35</ref>; <ref loc="LUK 8:19-21">oLuka 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ni Oyesu tayayo ya kela kpewa kasuse ni, inanu kpa ayinanu hagye ese, ba yimu ko kela kpa anu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ebeni ashe ka danu mo, &lt;&lt;Ene wo kpayiwo hagye ese, aba yimu ko kela kpa wo.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Oyesu nyagbo ki doka mo, &lt;&lt;Anoho wene hin, kpa ayene hin?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Omyabo awogboso kweyi kamo, &lt;&lt;Awa mani wene hin kpa ayene hin la. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kpiri kase ni yo oza ni sha Ada hin ni yi iso ni otu, anu pini we enen, kpa ayene hin la.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Oyesu ke Elase Ikweyi Ki ino mizire</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Eneneni Oyesu bose ipu kole, kweyi oyagye ega ki ishu.<verse eid="MAT 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 13:2" />Ebeni ewa kasuse gbayi obutu nu kweyi ogipu kowu ga yagye, kweyi kpiri kewa mani hagye ega kishu. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Kweyi okelase ikweyi koza nwashika dawa, kamo, &lt;&lt;Osheho gebe ko myizire eho nu; <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ishini oya myizire ni, ashishini kizire shonu okoka kowe, ebeni ano wayi kpore. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ashishini shonu ebeni gbo okpo ni, ebeni gbagye nwashika lo ni obwu papa, koni agye nwashika lo ni. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ishini eno bose ni osizire, koni ogbawa pya agye neshi lo ni, angmongmo. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ashishini kizire shonu ipu kigye, kweyi igye gye yuwa bya. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ashishini shonu ipu ka agye neshi, gye kweyi mizire, ashishini ma asa ni gbi ikpo ogbogbo oye, ashishini wa awehiri, kpa aweta ko oza ni otu ni. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ase ni gba akpaha ko pwela na pwo.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Oyesu koza ni ya no oya kelase ni</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ebeni awogboso doka mo, &lt;&lt;Ojiya ni oya kela kpase ipu kelase?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Okyogwu mo, &lt;&lt;Oza gyogye ko obula ki iso ni teba ni ayi gwa dala, apa yi gwa dawa lo. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Ase ni gbo gyogye kela ko obula ki iso, Owuso ya dano ogyogye nwashika, ase ni ke gbo ogyogye ko obula ki iso lo, koza ni oma mo ogye ni Owuso yayo agye lo. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Oza ni yani nyya kela dawa ipu kelase ni yoma:</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;koni ayiyi kwo oza, ama lo;</para>
  <para style="q2" vid="MAT 13:13">koni aya akpaha tagye aba, pwo kwe ake bagye lo.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Ikweyi wa obane ki Ishaya wa gyogye.</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt;Ala ba zakpaha ala ke ba gye oza ni ala ba pwo ni lo,</para>
  <para style="q2" vid="MAT 13:14">ala ba yi iyi kwo oza kweyi ala ke ba gyo oza ni ala ba ma ni lo.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Olemani ikweyi koni ayo otu wa senu ni,</para>
  <para style="q2" vid="MAT 13:15">atawa ko pwela kpa akpaha wa</para>
  <para style="q2" vid="MAT 13:15">kweyi ayiyi wa gwu shini ana ka ma lo,</para>
  <para style="q1" vid="MAT 13:15">owoni obi lemani la lo abi yama kpi iyi wa</para>
  <para style="q2" vid="MAT 13:15">abi ya apwo kpa akpaha wa,</para>
  <para style="q2" vid="MAT 13:15">shini ana gye ipu ko otu wa,</para>
  <para style="q1" vid="MAT 13:15">shini ana pya shini ami na da awo gege ki ikpiye.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Otunehe waka la koni iyi kala ba ma, akpaha kala ki ba pwo ni. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Nyya ka dala okwokwoshi, awobane kpase neshi nwashika ba yimu ko ma awo oza ni ala ba ma mani, kweyi ama lo, shini ana pwo oza ni ala pwo mani, kweyi apwo lo.<verse eid="MAT 13:17" /></para>
  <para style="s">Oyesu gwi ikweyi kelase ki ino mizire</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Ala za akpaha sha ala pwo oza ni elase ki ino mi izire mani we ni: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Ishini ase ya pwela ko obula ko Owuso kweyi gyoza ni owe ni lo, ase bibi yawa yela ko Owuso ni yipu ko otu nu ni yi ngma. Omani pini we elase ikweyi ki izire ni ami kweyi gbo ikweyi ko owe kweyi ano wayi kpo re. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Ase ni ya pwe ela ko Owuso kweyi ze kpo otunehe papa olema byelase ikweyi ki izire ni ami kweyi gbo ikweyi ko okpo ni gba agye nwashika lo ni. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ikweyi koni ela ko Owuso pye ebe ko yagye ipu ko otu nu tata lo ni, oya kyogwu kpanu opa ya ogbeji lo, mani oni ishini otu byobya kpo owe tanu ikweyi koni oze ela ko Owuso, ebe ni oya gbo papa. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Elase ikweyi ki izire ni shonu otutehe ki igye lema bya ase ni ya pwe ela ko Owuso ni kweyi imu ko oza kese mani ba we ela ko Owuso obi ko gye ipu nu oki ya wobi ko yo oko kpanu. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Izire ni shonu ikweyi ka agye neshi ni, lema bya awase ni pwe ela ko Owuso ko tata kweyi gyo neneshi kweyi ki yo oko kpanu. Mani oni ashishini ma asa ki izire ikpo ogbogbo oye, ashishini awihiri, kpa aweta ko oza ni otu ni.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Elase ikweyi ki ikyashi ipu keho</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Oyesu kada ase elase oye mo: &lt;&lt;Obula ki iso lema bya ase ni ti izire neshi ipu ke eho nu. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ishini ase kpiri ba gbola ni, oyakonu wa ti ikpo ka akyashi ipu ki izire nu kweyi ganu. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Ishini izire gye kweyi gbi ikpo ni, ebe ni akyashi gye lalo.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />&lt;&lt;Ebeni ayole ga ta adole wa, kweyi doka mo, &lt;Adole, izire neshi pi otu eho la lo? Ojiya ome ni ikyashi bwu ipu nu nwashika?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />&lt;&lt;Okyogwu mo, &lt;Omonyekwotu pini yo oza ni oma.&gt; Oyole nu do okamo, &lt;Oya yimu shini ahan ga yawi ikyashi shu shonu?<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Okyogwu dawa mo, &lt;Aayi, owoni ala ga ko sha akyashi, alaba yi izire shu kpa akyashi dudu. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ala shuwa bita na gye dudu gbishi ko kyi izire. Ishi oni nyya ka da awokyi izire: Ikikyo ala yi ikyashi gwu tukpa ebye kponu kweyi yo ola kwo; kweyi ala kpi izire shi ipu ko owuya hin.&gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Elase ikweyi ki Ikpo ko Omusta kpo Oyisi</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Oki kelase oye dawa mo: &lt;&lt;Obula ki iso lema byi ikpo ko omusta, ni ongo oye tu eho nu ni. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ikpo nu wo nyonye ipu ki ikpo ki izire shishini, owoni ogye oya gyokwu gi iso ya shi iyo ko obobo ni bi ipu ke eho ni, kweyi pya we efu ni ano bawa mole ayabo nu.&gt;&gt; <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Kwikyikyeni Oyesu ki kelase oye dawa mo, &lt;&lt;Obula ki iso lema byo oyisi gbayayi ni onya kwabo kpo omu nwashika, gbishini omu nu.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Oyesu kela mani kpiri kpa asuse ipu elase; okwokwoshi ogbo ojije no fu wa kweyi gbe elase ipunu lo ni. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Oyesu yama ni shini na wa gyogye kpo oza ni inobane Ishaya ka mo:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Nwwa kela kpa asuse ipu kelase,</para>
  <para style="q2" vid="MAT 13:35">nyya gwa awi ikweyi kawo oza ni teba bwo kwagye kese mani.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Oyesu Gwase ikweyi kelase ka kyashi keho</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ebeni, Oyesu shuwa bita kweyi ganu go ole. Awogboso webe nu kweyi kamo, &lt;&lt;Gwi ikweyi kelase ki kyashi ni yeho ni daha.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Okyogwu da awa mo, &lt;&lt;Ase ni ti ikpo ki izire neshi ni woyi kasuse la. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Eho le bye ese mani la, ikpo ki izire neshi le bya ayi ko Obula. Ikyashi le bya ayi kase bibi la, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />omonyekwotu ni ti ikiyashi ipu keho ni le byi ibiri; ishi ki izire kyokye le byo okweyi kese mani, awo kyizire wa ayoleho ko Owuso pi yoma.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Byoni aya akyashi shu kpo tukpa yi yola, mamani pi wa kpase bibi okweyi kese la. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Ami Oyi ka Asuse ya ta ayoleho eho ipu kese kweyi oza ni yi ayikoko ko Oyesu ko owuso in ya ase ayo ozalabi aba kpu wa gese mamani ase kpiri ni yo ozalabi, ki ya ase shishini yozalabi aba yuwa ngma shi ayikoko ko Oyesu ko owuso <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />kweyi ayo leho hin yuwa ta shola ko gbogbo-gbogbo, ebe ni aba kyegba kpo ha ahanu. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ebeni awa aseneshi bayu bye eno ipu ke ayikoko ko Oyesu ka Ada wa. Ase ni gbakpaha ko pwo, na pwo!<verse eid="MAT 13:43" /></para>
  <para style="s">Elase Ikweyi Kodu ni Teba ni</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Obula kiso lema byo odu ni ayi teba ipu keho ka ashe; ishini ase pye, okyanu teba, kpo otunehe oya yoza kpiri ni ogbo ni yikpo ra, kweyi oya aneho oni yira.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Mamani, ayikoko ko Oyesu ki iso lema bya awo yo otoyu ni ba labo ki ikikpo yoyu ko ra. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Ishini opyo olamu ni shoshi ki gbo ikwiri ni, ebeni oga ya awo oza ni ogbo kpiri ni yikpo ra, kweyi oga ro oni.<verse eid="MAT 13:46" /></para>
  <para style="s">Elase ikweyi ke eya</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Kwikyikyeni, ayikoko ko Oyesu gi iso lema byo eya ko kwe ebinyi, ni ayi shu ipu ki inyo ki ishu ni, kweyi kwe ebinyi wo onyonya we ese: <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ishini eya mwu ni awotinyi pyo we ega wa bagye, kweyi akpa awo neneshi sho ogwugwu, awo ni labi ni ayi shonu. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Mani la mo owuso aya kpo wu ase okweyi kese mani la. Ayoleho bawa ya ase bibi yi ko sha aseneshi <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />kweyi aba ya ase bibi shola, ebeni aba kyegba kpo ha ahanu.<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />&lt;&lt;Oyesu duwo oka mo, &lt;&lt;Ala gya awoza mani kpiri?&gt;&gt; Akyogwu mo, &lt;&lt;Ee.&gt;&gt; <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Oka dawa mo, &lt;&lt;Ase ni fono ikweyi ki ayikoko ko Oyesu ki gi iso lema bya Adole ni kpo odu nu pepe kpo onekye bwo owuya nu wese.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Ayene ko Oyesu tela nu oNazareti</para>
  <para style="r">(<ref loc="MRK 6:1-6">oMak 6.1-6</ref>; <ref loc="LUK 4:16-30">oLuka 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ishini Oyesu kelase kweyi ni, oshe ebeni bita ge ebye. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ni owogya nu ni, okwotu ko foza ekpa, kweyi igbashi yuwa kwu, kweyi adiyiwa oka mo, &lt;&lt;Ebe nya ni ongo mani pyo oza gyogye kpa awo oza ki igbashi ni oya ya mani?&gt;&gt; <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Anu mani pini ada nu wi inogbopu lalo? Inanu pini wo Omeremu la lo? Ayi nanu pini wo Oyakubu kpo Isu kpo oSimo kpo Oyahuda lalo? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ayina nu nonya, bagye kpa aha lalo? Ebenya me ni ongo mani pyoza mani kpiri?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />kweyi otu wa bya kpa anu.</para>
  <para style="p" vid="MAT 13:57">Oyesu ke ka da awa mo, &lt;&lt;Inobane, aba zo neshi ebye, ole nu kpo ogya nu ke aba zo neshi lo.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Ikweyi koni oyo oza ki igbashi nwashika ebe ni lo, kweyi atela ko akyogwu kpa anu mo owo Omezaya.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ishi ki Ikwu ko Oyohana Ine Ko Obatisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ishi oni Ohiridus ose ko Ogalili pwo oshu ko oko ni Oyesu yaya ni, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />kweyi oka da awo yo oko nu mo, &lt;&lt;Anu mani wo Oyohana ino Obatisma; ni gekwu nyiso ni la! Oza ni ya ni ogbo oshu ko ya awo oza ki igbashi ni oma.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Ohiridu ka mani ikweyi koni anu pi yo Oyohana kwu toruduru ikweyi ko Oheridiya ni wo onya ko Ofilibus ni wo oyene ko Ohiridu ni. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Ohiridu yo Oyohana toruduru ikweyi koni okada nu mo, &lt;&lt;Oshoshi shini odoka ko onya koyene wo ni gekwu ni lo. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ohiridus yimu ko yo Oyohana ngmo, oke ya yoshi kase koni azo wi inobane ni ko Owuso.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Eno ki imya ko moma ko Ohiridus, oyi ko Ohiridiya gyo ba obutu kawo ogboga ni we ebe ki imya ni. Oyo oza ni sho Ohiridus otu ni <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Gbishini oshokoyi kpe enegwogwa danu mo, kpiri ko oza ni odoka oya danu. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Ni ene ko oyi nonya pwo oza in Ohiridus kani, okado oyi nu mo na kado Ohiridus mo oya yimu ki ikweyi ko Oyohana ino yo Obatisma ipu ko okpa. Ebeni oyi nu ga kado Ohiridus mo, &lt;&lt;Nyya yimu ki ikweyi ko Oyohana ipu ko okpa!&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Elamani yo otu ko ose bya, koni okwobonu gwene obutu kawase ni bagye kpa anu ebe ki imya nu ni, okada awa mo, oza ni odoka ni ana danu. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Otuwo oleho ga yo Oyohana ikweyi ngma oruduru. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Abi ikweyi ko Oyohana wa ipu ko okpa, kweyi ayi do oyinonya oni kweyi obi ga yi di inanu. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Awo gboso Oyohana wa yo oku nu bize ga yi nyi. Kweyi aga ka do Oyesu oza ni gbodagye kpo Oyohana ni.<verse eid="MAT 14:12" /></para>
  <para style="s">Oyesu dase Okpaku eho Oza rore</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />No Oyesu pwo oza ni gbodagye kpo Oyahana iniko yo Obatisma ni, oshe ebe ni bita gipu ko owu she ebeni bita kweyi gebe ni gba ashishe lo ni shini na yagye fufunu. Nase bwebe ni oga ni, agboso kpi ikpo bwo ogya gogo-gogo. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ni obose bwo owu ni, ime ewa ka asuse. Iyinyinyi wa yo kwu, kweyi oda awine ke ere ogege.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Ni eno sha ni, awo gboso we ebe nu kweyi akamo, &lt;&lt;Ebeni gbashishe lo, ishi ke ya gawa ye ewa na gawa, shini ana go ogya ga ro oza ko rore.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Oyesu kyogwu mo, &lt;&lt;owo tiri koni aya ga ro oza rore ebye lo. Ala dawa oza rore na re.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Aka do Oyesu mo, &lt;&lt;Ikyoga eho kpe ebinyi epa kin pini aha gbo ebe ni la.&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Okamo, &lt;&lt;Ala byo oza ni ala gbo ni wa dami.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Ebeni oya ase bagye ikweyi ka akyashi. Ozo ikyoga eho kpe ebinyi epa, kweyi otiyi mi iso kweyi keshi ko Owuso. Kweyi oyi ko tititi da awo gboso, kweyi awo gboso ko dase. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Kpiri wa ha yipu. Awo gboso kpo shishi ni mwo ogwugwu igwepa. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ewa kase ni ha ni wo okpaku eho, ijiji ka ango aya Aresawu ka anya kpo ayi le ki lo.<verse eid="MAT 14:21" /></para>
  <para style="s">Oyesu yawu ikweyi ki inyawo</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />No Oyesu da ese okpaku eho oza rore kweyi ni, ebebeni oka dawo gboso kamo ana gipu ko owu shini ana sheyi ki ishu gese kwobonu danu, ohagye itikpi kweyi ye ewa gawa. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Ishini oye ewa gawa ni, otoshi gi ikweyi kefu fufunu shini na tinarigwu. Oye ebe ni fufunu ya tinarigwu gbi ishini eno sha. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ishi oni owu ka awo gboso ke yo otutehe ki ishu kweyi ya ja, ikweyi koni owu loshu ya tani oya yo ogwa ki inyawo ya sabo.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Abo ko ogye eta ko otu go hoki, Oyesu yawu ikweyi ki inyawo kweyi webe wa. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ishini awo gboso mo ya yawu ikweyi ki inyawo ni, otu wa gbo, kweyi akamo, &lt;&lt;Omani wo oyi la!&gt;&gt; Kweyi akyegba koni oshi yuwa ku. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Ebebeni Oyesu kada wa mo: &lt;&lt;Ala gbo otu! Ami la. Ala ka yoshi lo.&gt;&gt; <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Obitrus kyogwu mo, &lt;&lt;Adole, owoni owa awo la,&gt;&gt; &lt;&lt;Kada ami na yawu ikweyi ki inyo webe wo.&gt;&gt; <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Oyesu kado Obitrus, &lt;&lt;Nyiso shino wa.&gt;&gt; Ebeni Obitrus nyiso kweyi bose bwi ipu ko owu kinyo, kweyi yawu ikweyi ki inyo ge ebe ko Oyesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ishini Obitrus mo owu ya ta loshu ni oshi yo ku kweyi oya gbebi gi inyo, okyegba mo Adole, tumabo shi na ka gbebe ipu ki inyo lo!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ebebeni, Oyesu na abo sho kweyi kamo &lt;&lt;Awine ko otuse gbayayikweyi hin, ojiya no oyotusun wo loshu lo.&gt;&gt; <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ishini agi ipu ko owu ni, owu hagye. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ebeni ashishini ase ni bi ipu ko owu ni kwagye ba sho Oyesu iye, ba kamo, &lt;&lt;Okwokwoshi owo Oyi ko Owuso la.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ishini asheyi ki ishu ni, aga agye ko Ogenesaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ishini awase ka agye ni gye mo owo Oyesu ni, ato eleho go ogya ni yo kuwa kpiri ni, abya awine ke kere kpiri we ebe nu. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Abo mo, awine kere na gwa abo akaka ko oshiye nu kin. Kpiri ka awine kere gwa abo oshiye nu kweyi pyo gege ki ikpiye wa.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Ozafofu ka awokyikyi</para>
  <para style="r">(<ref loc="MRK 7:1-3">oMak 7.1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ebeni, ashishini ka Awofarisi kpa awofono we ebe ko Oyesu bwo Ojerusele kweyi do oka mo, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Ojiya ni awogboso yo ono ka anyakwase yi yishi? Aba na abo ime ba roza lo?&gt;&gt; <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Oyesu kyogwu mo, &lt;&lt;Ojiya ni ala yo ono ko Owuso yi ishi ela ko odu kala? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Koni Owuso kamo, &lt;Geyagye da ada wo kpe ene wo,&gt; Kweyi &lt;Kpiri kase ni sa ada nu kwe inanu esa ana yo ngmo.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ala ke foza mo owoni ase gbo oza ko da ada nu kwe inanu kweyi kamo, &lt;Nyya tala abo lo, oza ni ngbo nshokoyi ko do Owuso la.&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Bwe ebe koni ala mo oshu ko geyagye de ene kpa ada wa lo. Ni olemani, bwe ebe ko odu kala ala yo ono ko Owuso yi yishi pi yoma. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ala awoyoziyi! Ela ni Ishaya bane ikweyi kala ni gyogye la,<verse eid="MAT 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;&lt;Awase mani ba geyagye do Owuso kpo okwunu wa kin la,</para>
  <para style="q2" vid="MAT 15:8">otu wa ke ye ebe le nu kpa anu.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Aba geyagye da ami yeye la,</para>
  <para style="q2" vid="MAT 15:9">oza ni aba fu ni wo ono ka asuse la, wa ko Owuso la lo.&gt;&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Ozani yaya ase ya Gbinyi ni</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Oyesu ye ewa kase gwu wo obutu nu kweyi kamo, &lt;&lt;Ala sha, sha ala pwo! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Oza ni bwo okwunu kase gipu nu pini, ya yo ya gbinyi la lo; so oza ni ke bwo okwunu ya wese ni pini ya yo ya gbinyi la.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Bwebe ni, awogboso wa doka mo, &lt;&lt;Ogye mo Awofarisi otu wa bya, ko oza ni oka ni?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Okyogwu mo, &lt;&lt;Kpiri kefu ni Ada hin ni yi iso nyi la lo aba yo shu tonu ko ogbogba. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Ala shuwa bita. Awofiyi la, awo pyo ofiyi abo, kpiri wa ba gbo go ogo.&gt;&gt; <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Ebeni Obitrus ka do Oyesu mo, &lt;&lt;Gwi ikweyi kelase mani daha.&gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Oyesu kadawa mo, &lt;&lt;Kwikyikye ni ala gye lo?&gt;&gt; <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />&lt;&lt;Ala gye mo, oza ni bwo okwunu gipu ka asuse ya bose bwe epu nu lo? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Oza ni bose bwo okwunu bwo otu la, awo oza ni pini ba ya ase ya gbinyi la. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Bwo otu kase pini awo oza bibi ba bose la, byo ngmase, ebaboba, owi, obasela, obiga-biwa. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Awo oza mani pini ya ase ya gbinyi la: ke wo roza na abo lo pini ya ya ase ya gbi inyi la lo.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Otuse ko onya ko Okana</para>
  <para style="r">(<ref loc="MRK 7:24-30">oMak 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Oyesu she ebeni bita go okpagye ko Otaya kpo Osidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ebeni, onya ka agye ko Okana bye egba we ebe nu kamo, &lt;&lt;Adole, Oyi ko Odawuda, miyinyinyi hin! Oyi hin nonya ya mowe kpo omaku bibi ba.&gt;&gt; <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Oyesu ko ojije lo. Ebeni awogboso we ebe nu kweyi bo mo, &lt;&lt;Pwe egba nu, shini na ga, oya gbosaha kpe egba.&gt;&gt; <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Ebeni Oyesu ka do onya ni mo, &lt;&lt;Nwwa ela ka wo otukpo ki ipwoma ki Izrayila ni gebi ni kin la.&gt;&gt; <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Onya ni wa kwagye obutu nu kweyi kamo, &lt;&lt;Adole, Oyesu tumabo.&gt;&gt; <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Oyesu kyogwu mo &lt;&lt;Ashoshi ko yo oza rore neneshi ka ayi yi di iwo lo.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Olemani ko okwokwoshi, &lt;&lt;Adole: iwo ba ro oza ka adole wa ni shonu okpagye ni.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ebeni Oyesu kyogwu mo, &lt;&lt;Onya, otuse wo loshu! Na lema byoni oba ni!&gt;&gt; Ishi oni oyinu pyo ogege.<verse eid="MAT 15:28" /></para>
  <para style="s">Oyesu dase nwashika Ogege</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Oyesu she ebeni bita kweyi di ishu ko Ogalili oye kweyi toshi gi iso ke efu ga yagye. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Lewa kase webe nu, abya awine ki ikpiye winyi kpo ofiyi kpa awopyepu agye kpa awine ki igbenu kyokye kpase shishini, kweyi akpuwa wo obutu nu, odawo ogege ki ikpiye. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Igbashi yuwa ku ni ama awine ki igbenu kyokye ba kela, awopyepu agye ba yawu, awine ki ikpiye winyi pyo ogege, ofiyi ba me ebe. Ebeni asho Owuso ki Izrayila iye.<verse eid="MAT 15:31" /></para>
  <para style="s">Oyesu dase okpaku ene oza rore</para>
  <para style="r">(<ref loc="MRK 8:1-10">oMak 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Oyesu ya awogboso ogwu kweyi ka da awa mo, &lt;&lt;Nyya miyinyinyi kawase ni bagye kpa ami eno eta kweyi gbo oza rore lo ni, nyya yimu ko shuwa bita naga kpe emye lo ela koni aya ga shekwu owe ni.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Awogboso kyogwu mo, &lt;&lt;Ebenya ipu ki imweshi mani, ni aha ba pyo ikyoga ko gya awe ewa mani?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Oyesu duwo oka mo, &lt;&lt;Ikyoga ema ni ala gbo?&gt;&gt; Akyogwu mo, &lt;&lt;Ahapa, kpe ebinyi gbayayi.&gt;&gt; <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Oyesu ka de ewa mo ana bagye okpagye. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ebeni ozo ikyoga ahapa ni kpe ebinyi, kweyi okeshi do Owuso, oyi fo kweyi da awogboso, ime awa da ase. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Kpiri wa ha yipu. Bwe ebeni awogboso kpo oza ni aha shishini ni mwo ogwugwu ahapa. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ewa kase ni ha ni wo okpaku ene, ijiji ka ango, anya kpa ayi leke akuwa ipunu lo. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Ni Oyesu ye ewa gawa ni, ogipu ko owu kweyi ga agye ko Omagadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Awofarisi ba tikpo ko oza ki igbashi</para>
  <para style="r">(<ref loc="MRK 8:11-13">oMak 8.11-13</ref>; <ref loc="LUK 12:54-56">oLuka 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Ebeni ashishini ka Awofarisi kpa awo Sadukiya wa, ko mo Oyesu ma kweyi ado oka mo, ona shiya awa oyi oye shini ana gye mo bwi iso ebe ko Owuso. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Oyesu kyogwu mo, &lt;&lt;Owoni eno sha ala mo, &lt;Ebe sha neshi; koni okpowuso yu, ala mo oki ebe ya shoshi.&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Kweyi owoni owo otukpokyi, &lt;Ebe pya ya yu koni okpowuso pya tobi kweyi owuso ya yimu ko yiwo.&gt; Ala gyi ipya ko okpowuso, ala ke gege ko gyi ishi lo. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Obibi kpa awobeba kese mani ba labo ko oza ko ya abo byo, ake ba pyo oza ko ya abo byo lo, so oza ni oYunana yani.&gt;&gt;</para>
  <para style="p" vid="MAT 16:4">Ebeni oshuwa bita kweyi ganu omoma.<verse eid="MAT 16:4" /></para>
  <para style="s">Akpaha Pyopyi Ikweyi ko oza fofu labi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Ishini awogboso fese ka anoni ni, aya mo anwanyi ko byo ikyoga. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Ebeni Oyesu ka da awa mo, &lt;&lt;Ala gbera, ala yawu myo kpo oyisi ka Awofarisi kpa Awosadukiya.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Ebeni adiyiwa oka mo, &lt;&lt;Koni aha byo ikyoga lo ni?&gt;&gt; <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Oyesu gyo otuwa kweyi ka da awa mo, &lt;&lt;Ala awine ko otuse gbayayi, oji ni ala baka kpiyi kala mo koni ala byo ikyoga lo ni? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ala gyelo kwikyikyeni? Ala nwanyi ko ikyoga eho kpase okpaku eho, ogwugwu ema ni ala kpo sho? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Kwe ikyoga ahapa kpase okpaku ene, ogwugwu ema ni ala kpo? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Kwikyikyeni ala gye lo? Nyya kela ikweyi ko ikyoga la lo, ke wi ikweyi ko ozafofu ka Awofarisi kpa Awosadukiya la.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Ebeni agye mo oya kela kpa awa mo ana gbera kpo ikyoga lalo, ke wo ozafofu ka Awofarisi kpa Awosadukiya la.<verse eid="MAT 16:12" /></para>
  <para style="s">Obitrus kamo Oyesu pini wo Okristi la</para>
  <para style="r">(<ref loc="MRK 8:27-30">oMak 8.27-30</ref>; <ref loc="LUK 9:18-21">oLuka 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Ishini Oyesu wo okpagye ko Okeseriya Filibi ni, oda awogboso oka mo, &lt;&lt;Anoho ni ase ba mo Oyi ka Asuse we?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Akamo, &lt;&lt;Ase shishini ba mo owo Oyohana ko yo batisma, ase shishini ba mo owi Iliya, ase shishini ba mo owi Irimiya, kwe ashe ipu kawo bane.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Ebeni oduwo oka mo, &lt;&lt;Ala ke mo nwwa anoho?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Obitrus kyogwu mo, &lt;&lt;Owo Okristi, Oyi ko Owuso ine ko gbo layi.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Oyesu ka danu mo, &lt;&lt;Otunehe yo kpa awo Osimo, oyi ko Oyunana! Koni ofoza mani bwe ebe ka asuse la lo, ke bwe ebe ka Ada hin ni yi iso ni. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ami ke ya ka da awo, owo Obitrus, ikweyi ko okpo mani pini nyya mo oda ko Owuso la, ni ikwu gboshu ikweyi nu lo. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nyya da awo oba kofunu ko obula ki iso. Ozani oyi gbo ese mani, ayi gbo iso oma, oza ni oyi yi ese mani ke, aba yi yi iso.&gt;&gt;<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Ebeni Oyesu pya awogboso akpaha ko otata mo ana ka ka da ashishe mo anu wo Okristi lo.<verse eid="MAT 16:20" /></para>
  <para style="s">Oyesu ke Edo ki Ikwu ni Oya Ga ni</para>
  <para style="r">(Omak 8.31-9.1; <ref loc="LUK 9:22-27">oLuka 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Bwi ishi oni Oyesu kwotu ko ka da awogboso mo, owo otiri shini anu na go Ojerusele, naga mo owe gogo-gogo abo ka awanyakwase, kpa Oteyi ka awosapa kpa awofono, aki ba yo ngmo, eno ko me eta oki ya nyiso.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Obitrus ke pyo go okoka kweyi kwotu ko ka danu mo, &lt;&lt;Adole! Owuso ya tasuwa yo oza ni ya gbodagye kpa awo lo!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Oyesu ke pyiyi mo Obitrus kweyi kamo, &lt;&lt;Ga sho obutun, Ibiri! Owino ya ase shikawu la, koni oya yela bya asuse byoni wo Owuso ya ya ni lalo.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ebeni Oyesu ka da awogboso mo, &lt;&lt;Owoni ase ni ya yimu ko gbosun, na sho yimu ki iyinu bita na zo oshi nu shini na gbosun. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Owoni ase ni ya yimu ko olayi nu oya pye lo. Ase ni ke pyo olayi nu lo ikweyin, oya pye. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Oji ni ase ya pye, owoni opyi iyo kese mani kpiri kweyi opyo olayi nu lo? Kwe oje yaba ni ase yayi sha kpo olayi nu? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Koni Oyi ka Asuse ya wa ipu ki igyashi ka Ada nu kpa ayoleho nu, kweyi oya da ananoho abola ko oza ni oya ni. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Nyya kadala okwokwoshi, ashishini kase hagye ebeni, aba gekwu lo gbi ishini Oyi ka Asuse yawa ipu ki Igabo nu.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Oyesu yi iyinu sha</para>
  <para style="r">(<ref loc="MRK 9:2-13">oMak 9.2-13</ref>; <ref loc="LUK 9:28-36">oLuka 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Itikpi ke eni ihiri Oyesu zo Obitrus kpo Oyakubu kpo Oyohana oyinanu kweyi byuwa gi iso ke efu jigiri awa fufuwa. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Ebebeni Oyesu yi iyinu sha obutuwa, aheyi nu yu bye enoni, kweyi oshiye nu pya wo nehe purututu. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ebebeni Omusa kpi Iliya bose da awa kweyi ba kela kpo Oyesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Obitrus ka do Oyesu mo, &lt;&lt;Adole, oshoshi ni aha bebeni. Owoni okyogwu, ahan gwa adaba eta ebeni, oye wa akakoho, oye wa ko Omusa, oye wa ki Iliya.&gt;&gt; <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Ni oyipu kela ya ka ni oyoyu ko okpowuso yuwagwu, kweyi oko kela bwo okpowuso ya kamo, &lt;&lt;Omani wo Oyi hin la, ni nyya yimu ni, kpa anu otu hin ya sha. Ala pwela nu!&gt;&gt; <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Ishini awogboso pwo mani ni oshi yuwa kwu, agbo kweyi yi iyi ka agye. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ebebeni Oyesu wa gawa abo mo, &lt;&lt;Ana yiso, ana ka yoshi lo.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ishini angi iyi iso ni, ama ashishi lo so Oyesu. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Ishini aba sa bwi iso ke efu ni, Oyesu pyuwa akpaha mo, &lt;&lt;Ana ka ka da ashishe oza ni ama ni lo, so Oyi ka Asuse nyiso ipu ka amiri.&gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Awogboso do oka mo, &lt;&lt;Ojiya ni awofono ba kamo inobane Iliya pini yawa ikyikyo la?&gt;&gt; <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Oyesu ka da awa mo, &lt;&lt;Ko tata, Iliya yawa kweyi wa kyoza kpiri atu. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Nyya ka dala, Iliya kwobonu wawa, ake agyo lo, kweyi ayo oza ni aba yimu ni. Mamani Oyi ka Asuse yawa mowe abo wa.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ebebeni awogboso gye mo oya kela kpa awa ikweyi ko Oyohana ino Obatisma la.<verse eid="MAT 17:13" /></para>
  <para style="s1">Oyesu do oyi ni gbo omaku bibi ni ogege ki ikpiye</para>
  <para style="r">(<ref loc="MRK 9:14-29">oMak 9.14-29</ref>; <ref loc="LUK 9:37-43a">oLuka 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ishini awe ebe ke ewa ni, ongo oye we ebe ko Oyesu kweyi wa kwagye obutu nu kweyi kamo, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Adole, miyinyinyi ko oyin, ogbo ose ki ikpikpi, oya mowe nwashika. Ishi nwashika oya gbo go ola kwe ipu ki inyo. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Nbyo we ebe ka awogboso, agege ko dano ogege ki ikpiye lo.&gt;&gt; <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Oyesu ka da awa mo, &lt;&lt;Ala ase ki ishi mani, awine ko otuse gbayayi kpo oza bibi, gbi ishi wonya ni nyya yagye kpa ala? Gbi ishi wonya ni nyya gbotu kpa ala? Ala byo we ebeni.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Ebebeni Oyesu gbo omaku bibi eha, kweyi obose shi ikpiye ko oyi oni. Bwi ishi oni opyo ogege ki ikpiye nu. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />Awogboso webe ko Oyesu ishini oyagye anu fufunu ni kweyi ado oka mo, &lt;&lt;Ojiya ni aha gege ko ngmo omaku bibi shi ikpiye ko oyi oni lo?&gt;&gt; <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Oyesu ka da awa mo, &lt;&lt;Koni otuse kala yo ti ni. Nyya ka dala okwokwoshi, owoni ala gbo otuse ti byi ikpo ko omusta, ni yo ti ipu ki ikpo ki izire ni, ala ba gege aka de efu mani mo, na ja ga anoni kweyi oya ja ga. Ojije ya sha ala oshu lo.&gt;&gt; <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Edo ko omaku bibi mani ba bose kin lo, tinarigwu kpo okunu kwokwu.<verse eid="MAT 17:21" /></para>
  <para style="s">Oyesu kela ikweyi ki ikwu nu</para>
  <para style="r">(<ref loc="MRK 9:30-32">oMak 9.30-32</ref>; <ref loc="LUK 9:43b-45">oLuka 9.43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ishini awogboso wa gbayi Ogalili ni, Oyesu ka da awa mo, &lt;&lt;Aba yo Oyi ka Asuse ya ra da awobonya nu, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />aba yo ngmo, kweyi eno ko me eta Owuso ya shiyi bwi ipu ka amiri.&gt;&gt;</para>
  <para style="p" vid="MAT 17:23">Ebeni awogboso byo otu ko tata.<verse eid="MAT 17:23" /></para>
  <para style="s1">Egba zoze ole ko Owuso.</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ishini Oyesu kpa awogboso wo Okapanahu ni, awo zegba epa kole ko Owuso wa to Obitrus kweyi do oka mo. &lt;&lt;Adole kala ya zegba kole ko Owuso lo la?&gt;&gt; <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Oka da awa mo, &lt;&lt;Oya sore.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Ishini Obitrus wo ole ni, Oyesu wa kikyikyo ni kela kpa anu ni mo, &lt;&lt;Oji ni oma ipu ko oka doda mani Osaminu? Bwe ebe ka anoho ni awose kese mani ba zegba, bwe ebe ka ayiwa kwe ebe ko ogboga?&gt;&gt; <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Obitrus ka danu mo, &lt;&lt;Bwe ebe ko ogboga.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Oyesu kamo, &lt;&lt;Ayi wa ba ze lo oma.&gt;&gt; <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Ni olemani, ahan ka yotu wa na bya kpa aha lo, ala gi ishu ga she eya. Ala gwo okwunu ke ebinyi ni ala kwu kikyikyo, ikwiri ni opye, ga zegba ka aha kpa anu.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Anoho wo onyakwu?</para>
  <para style="r">(<ref loc="MRK 9:33-37">oMak 9.33-37</ref>; <ref loc="LUK 9:46-48">oLuka 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ipu ki ishi oni, awogboso we ebe ko Oyesu kweyi do oka mo, &lt;&lt;Anoho wo onyakwu obula ki iso?&gt;&gt; <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Oyesu yo oyi leke oye ogu wa hagye otutehe wa, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />kweyi kamo, &lt;&lt;Nyya ka dala okwokwoshi, owoni ala lema byo ayi lekeke ni lo, ala ba go obula ki iso lo. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Kpiri kase ni zi iyinu wo ojije lo byo oyi leke mani, anu pini wo onyakwu obula ki iso la.&gt;&gt;<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />kweyi kpiri kase ni zo oyi leke mani ipu ki iyen ami pini oze oma.<verse eid="MAT 18:5" /></para>
  <para style="s">Oza ni ya ase ba yo ozalabi ni</para>
  <para style="r">(<ref loc="MRK 9:42-48">oMak 9.42-48</ref>; <ref loc="LUK 17:1-2">oLuka 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Ni olemani, kpiri kase ni ke ya ayi leke mani yo ozalabi, ashoshi she shini ana ye ego nyakwu gbo bo oko kweyi yo ta gi ishu. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Arigbetu de ese mani ela ko zani ya ase ba yo ozalabi ni! Awo otiri shini oza ni ya ase ba yo ozalabi ni na wa, arigbetu da ase ni gba abo ipu ko oza ni. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />&lt;&lt;Owoni abo wo, kwe ikpo wo ya yo ya yo ozalabi, yi go tonu. Ashoshi she shini opyo olayi ko gbogbo-gbogbo kpa abo oye gogo kwe oshikikini sho oni aba yo ta go ola kpa abo kwe ikpo epa ni. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Kweyi owoni iyi wo ya byo go ozalabi, yi ngma tonu. Ashoshi she shini opyo olayi ko gbogbo-gbogbo sho oni aba yo ata go ole ko ola ni gbo myomyi lo ni.&gt;&gt;<verse eid="MAT 18:9" /></para>
  <para style="s1">Elase ikweyi ko otukpo ni gebi ni. (OLk. 15.3-7)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ala gbera, ala ka mo oye ipu ka ayi leke mani gyiyi lo. Nyya ka dala mo ipu ki iso, ayoleho wa ba yo kpa Ada hin ishi nye. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Ikweyi koni Oyi ka Asuse wa ko ngma ase ni gebi ni.<note caller="+" style="f"><char style="fr" closed="false">18.11 </char><char style="ft" closed="false">Okpa shishini gbo omani lo</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Ala ma moji? &lt;&lt;Owoni ashe gbo otukpo ogbogbo oye, kweyi oye ipu wa gebi, oya gege ko sha awahane ayahane bita ikpokyi kweyi ga labo ko oye ni gebi ni lo? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Owoni opye, nyya ka dala okwokwoshi, oya shotunehe ikweyi ko oye ni opye ni ya sha awahane ayahane oni la. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Mamani, Ada kala ni yi iso ni ya yimu shini oyo oye ipu ka ayi leke mani na gebi lo.&gt;&gt;<verse eid="MAT 18:14" /></para>
  <para style="s1">Oyene ni yo ozalabi</para>
  <para style="r">(<ref loc="LUK 17:3">oLuka 17.3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Owoni oyene wo yo ozalabi, ga ka danu obibi nu, awo kpa anu ase epa. Owoni opwaha wo, oyo oyinawo pye pi yoma. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Owoni opwo lo ke, ya ase oye kwe epa ogwu, shini ala ge ebe nu, bwebe ka awo olobene epa kwe eta, ala ba yela kpiri ya gwo. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Owoni oyene wo tanu ko pwela wa, ga kadase ni kyogwu kpo oshu neshi ni, owoni otanu ko pwela wa, ana zo byase ni ya peka kwe bya awozegba. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Nyya ka dala okwokwoshi, kpiri ko oza ni ala gbo ese mani ayi gbo iso pi yoma, kweyi oza ni ala yiyi ese mani kpiri, ayiyi iso. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Nki ya ka dala okwokwoshi, owoni ase epa kwe eta ipu kala kyogwu kweyi doka koje ese, Ada hin ni yi iso ni ya da ala. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Ebeni ase epa kwe eta gbayi ipu ki iyen, ami yo kpa awa.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s1">Elase ikweyi ko oyole ni ya sho ozalabi bita lo ni</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Bwebe ni Obitrus wa do Oyesu oka mo, &lt;&lt;Adole, igbema ni nyya yo ozalabi ni oyene hin yun ni gbo? Igba ahapa?&gt;&gt; <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Oyesu kadanu mo, &lt;&lt;Owigba ahapa kin lalo, ke wigba awahapa ole ahapa.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Ikweyi koni, obula ki iso ya lema byo ose oye ni ya yimu ko ka arisawu ko odu nu ni ya abo ka ayole nu ni. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ishini okwotu ko ka arisawu ni, abyo ongo oye ni oya kanu ikwiri nwashika ni wa. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ikweyi koni oya gege ko sore lo ni, adole nu zo oko mo ana yo kpo onya nu kpa ayi nu kpo oza ni ogbo kpiri ni yi ra shini ana sore ki ikwiri ni okpa ni.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Oyole ni ke weyi kwagye kweyi bo kamo, &lt;Gbotu mene kpami, nyya sore ko ogye ni kpiri.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Ebebeni adole ko oyole mani miyinyinyi nu, yore nu gbo kweyi mo ona ga nu.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ishini oyole ni gese ni, omo oya ko oko nu oye ni kpanu ikwiri gbayayi ebe nu ni, osho oshiye to oko mo, &lt;Ona sore ko oza ni anu kpanu ni kpiri.&gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Ebebeni oya ko oko nu kwagye obutu nu kweyi bo mo, &lt;Gbotu mene kpami, nyya sore ki ikwiri wo.&gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Ebeni oyole mani ke tanu, oyo kwu ga yo to oruduru, gbi ishini ni osore ko ore ni kpiri. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Ishini awoya ko oko nu shishini pwo oza ni gbodagye ni, otu wa bya kpanu. Bwebe ni aga ka do ose oza ni gbodagye ni kpiri.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt;Ebebeni adole yo oyole oni ogwu kweyi ka danu mo, &lt;Owo oyole ni gbo otu labi ni.&gt; &lt;Nsho ore wo bita ikweyi koni odumoka ni. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Oshu ko miyinyinyi koya ko oko wo byo ni ami miyinyinyi wo ni lo?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Ose kyanya ko otata kpanu kweyi kadawa mo ana yo ta go oruduru gbishini osore ki ikwiri ni nkpa nu ni kpiri. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />&lt;&lt;Ada hin ni yi iso ni ya yigba ananoho ni sho ozalabi ko oyi na nu bita kpo otu oye iso.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Ozafofu ko Oyesu Ikweyi ko Kabo ko onya kpo oba</para>
  <para style="r">(<ref loc="MRK 10:1-12">oMak 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ishini Oyesu kela nu kweyi ni, osho Ogalili bita kweyi go okpagye ko Oyahudiya kweyi Osheyi ki ishu ko Ojoda. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ase lewa gboso, kweyi Odawa ase ni gbo ogege lo ni ogege ki ikpiye wa ebeni. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Ashishini ka Awofarisi wa tanu ko moma, kweyi adoka mo, &lt;&lt;Byoni ono ka aha kani ashoshi koni ase na kabo kpo onyanu ikweyi ko owe nye?&gt;&gt; <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Oyesu kyogwu mo, &lt;&lt;Ala ma ipu ko okpa lo, bwi ikyikyo Owuso yo ongo kpo onya lalo. <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Oki kamo, &lt;Ikweyi koni, ongo ya sha ada nu kpi inanu bita kweyi na gbayi kpo onyanu, shini ana wi ikpiye oye kponu.&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Bwe ebeni awase epa ke lo, ke wo oye kponu. Ikweyi koni, oza ni Owuso yigbo ashishe naka yiyi lo.&gt;&gt; <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Awofarisi wa do oka mo, &lt;&lt;Ojiya ni Omusa ka bwipu ko ono mo ongo na do onya nu okpa ko wo olobene ko kabo kpo onya nu kweyi mo ona ganu?&gt;&gt; <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Oyesu ka dawa mo, &lt;&lt;Ikweyi ko otu labi kala pini Omusa dala ono mo ala kabo kpa anya kala la. Bwi ikyikyo kese, oke lemani la lo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Nyya kadala mo, kpiri kase ni kabo kpo onya nu, owoni akwo ya beba la lo, kweyi ogbo onya oye hoha oya beba pi yoma.&gt;&gt; <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Awogboso do oka mo, &lt;&lt;Owoni omani we ela ebe ko ongo kpo onya nu la, ashoshi she ko gbo onya lo.&gt;&gt; <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Oyesu kyogwu mo, &lt;&lt;Kpiri kase pini ba kyogwu kpe ela mani la lo, sa awase ni Owuso tuwabo. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ashishini amuwa aba gba anya lo. Ashishini asuse pini yuwa la, ashishini yimu ko gbo onya lo ikweyi ko Obula ki Iso. Ase ni ya gege ya kyogwu ko lemani na lemani.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">Oyesu sa ayi le ke abo neshi.</para>
  <para style="r">(<ref loc="MRK 10:13-16">oMak 10.13-16</ref>; <ref loc="LUK 18:15-17">oLuka 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ebeni abya ayi leke wa do Oyesu shini na suwabo neshi shini na tuwi inarigwu. Awogboso gbawase ni byuwa wani apwo mo ana hagye. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Oyesu ke ka dawa mo, &lt;&lt;Ala sha ayi leke bita na webe hin, ala ka wuwobi lo, Obula ki Iso wa akakawa la.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Oya abo neshi suwi ikweyi, Oshe ebeni bita.<verse eid="MAT 19:15" /></para>
  <para style="s">Isongo ni gbo odu ni</para>
  <para style="r">(<ref loc="MRK 10:17-31">oMak 10.17-31</ref>; <ref loc="LUK 18:18-30">oLuka 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ongo oye wa to Oyesu kweyi do oka mo, &lt;&lt;Inofoza, oji neshi ni nyyaya shi na pyo olayi ko gbogbo-gbogbo?&gt;&gt; <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Oyesu kyogwu mo, &lt;&lt;Ojiya ni oya doka ko oza ni wo neshi ni? Ashe oye kponu kin pini wo neshi la. Owoni oya yimu ko gbo olayi ko gbogbo-gbogbo, geyagye do ono ko Owuso.&gt;&gt; <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Ongo ni do Oyesu oka mo, &lt;&lt;Olamu wonya?&gt;&gt; Oyesu kyogwu mo, &lt;&lt;Ka ngmase lo, ka beba lo, ka wiyi lo, ka base ela lo, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />geyagye da ada wo kpe ene wo; kweyi ki yimu kase ni yagye kwo byoni oyimu kiyo ni.&gt;&gt; <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Ebeni isongo ka do Oyesu mo, &lt;&lt;Ngeyagye doza mani kpiri wa, oji ki shishini?&gt;&gt; <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Oyesu ka danu mo, &lt;&lt;Owoni oya yimu shini owase neneshi, ga yoza ni ogbo kpiri ni yi ra shini oyi kwiri dawo oleha, shini ogbo odu Iso. Ime shini owa gbosun.&gt;&gt; <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ishini isongo mani pwo mani ni, oganu kpo otu byobya, koni ogbo odu nwashika ni. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Oyesu kada awogboso mo, &lt;&lt;Nyya ka dala okwokwoshi, oya lono do olodu ko go Obula ki Iso. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nki ya ka dala. Oya shoshi do onyakwimi ko bwowu ko onya, sho olodu ko go Obula ko Owuso.&gt;&gt; <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Ishini awogboso pwo mani ni, igbashi yuwa kwu kpiri kweyi ado oka mo, &lt;&lt;Owoni olemani anoho ni aba ngma nu?&gt;&gt; <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Oyesu tiyi muwa kweyi kamo, &lt;&lt;Ebe ka asuse ke oya lemani lo, ebe ko Owuso ke kpiri ko oza oyagege ko ya.&gt;&gt; <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Obitrus ka danu mo, &lt;&lt;Aha ke shojoji bita kweyi gboso! Oji ni aha ba pye?&gt;&gt; <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Oyesu ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, ese ni yawa ni, ishi ni Oyi ka Asuse ya yagye ebe ki igyashi oyi pepe kweyi ebeni ala wo gbosun igwepa ki ba bagye ebe ko kpogwu ki ipwoma ki Izrayila igwepa. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Kweyi kpiri kase ni sho ole nu bita kwe ayina nu nongo kpa anya kwe ada nu, kwe inanu, kwe ayi nu, kwe eho nu, ikweyi kela hin, oya pyo ole ogbogbo, kweyi ya pyo olayi ko gbogbo-gbogbo. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Kpiri kase ni ke wa kikyikyo ba wo gwejeji, ko gwejeji ba wa kikyikyo.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Elase ikweyi ka awo yo oko eho ki Inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Obula ki Iso lema bya adole oye ni bose ototukpokyi ko tiyi ka awo ga yo oko eho ki inabi nu ni. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Oyoyu kpa awa byoni aba sore ki ikwiri eno oye ni, kweyi okpuwa ge eho ki inabi nu.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />&lt;&lt;Abo kogye ahane ko otukpokyi, oki mawa ashe bagye yeye ipishi. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Oka da awa mo, &lt;Ala ge eho ki inabi hin ga yo oko nyya sa ala ore neneshi.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ebeni anyiso kweyi ga.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;Obose ogyigwepa kpo ogye eta ki isheno, oya mamani kpa awase ni omuwa ni. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Abo ko ogyeho ko onose, oki gipu ogya, oma awase shishini bagye yeye. Oduwoka mo, &lt;Ojiya ni ala hagye kin ba yo oko ko ojije lo.&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Akyogwu mo, &lt;&lt;Koni ashishe daha oko koya lo ni.&gt; Oka dawa kamo, &lt;Ala ge eho ki inabi hin ga yo oko.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt;Ishini eno shani, ada ke eho ka di ino gbeho ke eho nu mo, &lt;Yawo yo oko gwu shini osuwore. Kwotu bwa ase ko ogwejeji gi ikyikyo.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt;Awase ni azuwa ogyeho ko onose ni wa, ada awa ikwiri ni ashu ko suwore bwo ototukpokyi go onose ni. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Gbi ishini ofi ikweyi kawase ni azuwa ikyikyo ni. Aba ze ipu ko otuwa mo, aba suwore ki ikwiri sha awase ni wo oko onose ni. Kpiri wa ke ada oza ni ashu ko suwore eno ni. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ni azi ikwiri wa ni, akwotu ko shawa dine ke eho mo, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />&lt;Awa ase ni wa yo oko ki ishi oye ni, odawi ikwiri gyogye kpa aha ni mo owe ki gweno bwo ototukpokyi ni.&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;Adeho oni ke ka da ashe oye ipu wa mo, &lt;Oya, nyyo oje bibi la? Nmo kwa akyogwu koni nyya sore ki ikwiri ikweyi ke eno ni la lo? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Zi ikwiri wo shini oga. Ami pini yimu ko dawi ikwiri gyogye kpa awo la. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ngboshu ko yo oza ni shumotu kpi ikwiri hin ni lo? Oya yanya koni nyyo oza neshi ni la?&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Olemani la, awase ko gwejeji ba wa kikyikyo, kikyikyo ba wa ko gwejeji.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Oyesu ki kela ki ikwu nu</para>
  <para style="r">(<ref loc="MRK 10:32-34">oMak 10.32-34</ref>; <ref loc="LUK 18:31-34">oLuka 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Ishini Oyesu kwo owe ko go Ojerusele ni, oya awogboso igwepa ogwu go okoka kweyi ka da awa mo, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Aha ba go Ojerusele, kweyi aba yo Oyi ka Asuse ya ra do Oteyi ka awosapa kpa awofono kweyi aba kwe epwo ko yo ngmo. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Ebeni aba yo ya nabo da awase ni wo Ase ko Oyahuda lo ni shini ana gbo owuru, ana ya aboshi, ana yo poshi sepa. Eno ko me eta oya nyiso bwa amiri.&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">Ene ko Oyakubu kpo Oyohana wa bo Oyesu oza</para>
  <para style="r">(<ref loc="MRK 10:35-45">oMak 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ene ko Oyakubu kpo Oyohana, ayi ko Ozebedi webe ko Oyesu kpa ayi nu wa kwagye obutu ko Oyesu wa bo oza.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Oyesu do oka mo, &lt;&lt;Oji ni oya yimu?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Oka danu mo, &lt;&lt;Kyogwu shini ipu ka ayin oye na ya abore, oye na ya aboshe wo, ipu ko obula wo.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Oyesu ka da awa mo, &lt;&lt;Ala gyoza ni ala ba doka ni lo. Ala ba gege ko gwi inyi kpa abwa ko owe ni nyya yela ko gwa mani?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Akamo, &lt;&lt;Aba gege.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Oyesu ka dawa mo, &lt;&lt;Ala ba gege ko gwinyi ipu ka abwa ko owe hin mani. Yagye abore kwe aboshe hin ke ami gboshu ko dase lo. Ada hin ni yi Iso ni kya anu tu da awase ni oshuwa ni la.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ishini ashishini ka awogboso Oyesu igwo pwela mani ni, akyanya. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Oyesu ke yuwo ogwu tukpa kweyi kamo, &lt;&lt;Ala gye mo awo ose kawase ni wo Ase ko Oyahuda lo ni gboshu ko yuwa ono, anyakwase wa ba shiya wa mo agbo oshu ko buwi ikpo. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Oya lemani kpa ala lo, ikweyi koni kpiri kase ni ya yimu ko wo nyakwu ipu kala, oya wo otiri danu shini na meshe da ase shishini, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />kweyi kpiri kase ni ya yimu ko wo oteyi ipu kala na wo oshe kala. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Oyi ka Asuse wa shini ana meshe danu la lo, owa shini na wa meshe, naki wa dawo olayi nu ikweyi kase nwashika.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">Opwiyi epa Oyesu yuwa me ebe</para>
  <para style="r">(<ref loc="MRK 10:46-52">oMak 10.46-52</ref>; <ref loc="LUK 18:35-43">oLuka 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Ni Oyesu kpa awogboso ba sho Ojeriko bita ni, ase nwashika gbosuwa itikpi. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Opwiyi epa bagye ashikwu ko owe. Ishini apwo mo Oyesu yawa ni, ango oko iso kamo, &lt;&lt;Adole, Oyi ko Odawuda! Miyinyinyi ka aha!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ebeni ewa ka asuse ni gboso Oyesu ni gbuwa apwo mo ana sha. Akwotu ko ngo oko iso mo, &lt;&lt;Adole, Oyi ko Odawuda! Miyinyinyi ka aha!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Oyesu hagye kweyi yuwo ogwu kamo, &lt;&lt;Oji ni ala ba yimu na ya dala?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Aka danu mo, &lt;&lt;Adole, aba yimu ko me ebe.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Iyinyinyi kwo Oyesu kweyi ogawabo iyi. Ebebeni amebe! Kweyi agboso.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Oyesu go Ojerusele</para>
  <para style="r">(<ref loc="MRK 11:1-11">oMak 11.1-11</ref>; <ref loc="LUK 19:28-40">oLuka 19.28-40</ref>; <ref loc="JHN 12:12-19">Oyohana 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ishini Oyesu kpa awogboso fo ogya ko Obetafiji ni yo pee kpo Ojerusele ni, ebe ke Efu ko Ozetu ni, Oyesu ta awogboso epa oleho, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />kweyi ka da awa mo, &lt;&lt;Ala go ogya ni yo ohobu kala ni. Ogoga kala, ala bamo odagyi kpo oyi ko odagyi gbogbo. Ala yuwa yi shini ala byuwa wa dami. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Owoni ashe da ala oka, ala ka danu kamo, &lt;Adole pini ya yimu la.&gt; Aba kwikye anu anana mani.&gt;&gt; <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Omani gbodagye shini oza ni inobane kani na gya mo, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Ala kada ayi ko Osiyona mo, &lt;Ala mo ose kala yawa oma! Owine ko otu mene. Oyawa ikweyi ko odagyi, ikweyi ko oyi ko odagyi pini oya wa la.&gt;&gt; <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />Awogboso epa ni ga yo oza ni Oyesu ka dawa ni. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Aga byo odagyi oni kpo oyi ko odagyi wa, ayo oshiye wa ta ikweyi ko odagyi do Oyesu. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ase lewa to oshiye wa ikweyi ko owe, ase ashishini kye efu shi kweyi ko owe do Oyesu. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ewa ni bo ohobu nu kpa awase ni bi itikpi nu ni sheha kweyi ba mo, &lt;&lt;Shaniye, Shaniye, Oyi ko Odawuda! Otunehe yo kpase ni yawa ipu kiye ka Adole ni! Sho Owuso iye!&gt;&gt; <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />Ishini Oyesu go Ojerusele ni, kpiri ko ogya ja, aba doka mo, &lt;&lt;Omani ki wa anoho?&gt;&gt; <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Ewa ka asuse ni ba gboso ni kamo, &lt;&lt;Omani wo Oyesu la, inobane bwo Onazareti ko Ogalili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Oyesu go ole ko Owuso</para>
  <para style="r">(<ref loc="MRK 11:15-19">oMak 11.15-19</ref>; <ref loc="LUK 19:45-48">oLuka 19.45-48</ref>; <ref loc="JHN 2:13-22">Oyohana 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Oyesu gipu ko Ole ko Owuso, ga ta ase ba yi ipishi kweyi onuwenya. Oga so oka ka awo pyi ikwiri kpa aka awo tora ko otitiribi abo shonu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Oka dawa mo, &lt;&lt;Otota ipu ko okpa mo, &lt;Aba yo ole hin ogwu mo ole ko tinarigwu.&gt; Ala ke yo pya wo ole ka awowi. <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Awo pwiyi kpa awo pyefu-agye we ebe ko Oyesu ipu ko Ole ko Owuso, odawo gege ki kpiye wa. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ni awoteyi ka awosapa kpa awofono moza ki gbashi ni Oyesu yani, ka ayi leke ni bipu kole ko Owuso ni sheha kweyi bamo, &lt;&lt;Ahan sho Oyi ko Odawuda iye,&gt;&gt; awoteyi ke kyanya kpo oza ni gbodagye ni. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Ado Oyesu oka mo, &lt;&lt;Opwo oza ni awa mani ba ka ni?&gt;&gt; Oyesu kyogwu mo, &lt;&lt;Ala mo oza mani ebibye ipu ko kpa lo? &lt;Bwo okwunu ka ayi leke kpa ayi meme pini iye shosha wo ya bose la.&gt;&gt;&gt; <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Bwe ebeni oshu wa bita kweyi bose go Obetani kweyi ga kya.<verse eid="MAT 21:17" /></para>
  <para style="s">Oyesu te Efu ko Odegyo Igbe</para>
  <para style="r">(<ref loc="MRK 11:12-14">oMak 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ni ebe nya ni Oyesu kwikye ya go Ojerusele kweyi emye ya ngmo. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ome efu ko ofig okoka ko owe kweyi oga ko ga wo ogwogwa nu, oke ga te efu kin la. Ebeni oka de efu mo, &lt;&lt;Oya gwa ke lo!&gt;&gt; Ebebeni efu oni ngmongmo. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Ni awogboso mo aza ni gbodagye kpe efu ko ofig ni igbashi yuwa kwu. Ado oka mo, &lt;&lt;Olela ni efu ko ofig gekwu mani?&gt;&gt; <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Oyesu kyogwu mo, &lt;&lt;Nyya kadala okwokwoshi, owoni ala kyogwu kweyi gbo gbawashu lo, ala ba gege yayo oza ni sha ke efu ko ofig mani. Ala ba gege ba kade efu mo, &lt;Shu shini ogbo gipu ki ishu,&gt; Kweyi oya olemani byoni ala ka ni. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Owoni ala gbo otuse, oza ni ala ba ebe ko Owuso kpiri ala ba pye.<verse eid="MAT 21:22" /></para>
  <para style="s">Oka Doda Ikweyi ko Oshu ko Oyesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">oMak 11.27-33</ref>; <ref loc="LUK 20:1-8">oLuka 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ishini Oyesu kwikye go ole ko Owuso ni, oyipu ko oza ya fu kweyi awoteyi ka awosapa kpa awanyakwase we ebe nu wa do oka mo, &lt;&lt;Kpo oshu wonya ni oya yo oko mani? Anoho dawo oshu mani?&gt;&gt; <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Oyesu kyogwu mo, &lt;&lt;Ami ki ya da ala oka oye owoni ala ka dami nyya kadala kpo oshu wonya ni nyyaya awo oza mani. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Ebenya ni oshu ko Oyohana ni yayo obatisma ni bwanu, bwi iso la kwe ebe ka asuse la?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Ebeni akwotu ko tawashu kpi iyiwa mo, &lt;&lt;Owoni aha kamo obwebe ko Owuso la, oya kada aha mo, &lt;Ojiya ni ala tela ko kyogwu kpanu lo?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Owoni aha ke kamo obwebe ka asuse la, aba yoshi ase ba taha akyo koni akyogwu mo Oyohana wi inobane ni.&gt;&gt; <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Mani oni akamo, &lt;&lt;Aha gye lo.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Kweyi Oyesu ka dawa mo, &lt;&lt;Nyya kada ala kpo oshu wonya ni nyyaya awo oza mani lo.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s">Elase Ikweyi ko Ongo ni gba Ayi Epa ni</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Oyesu kamo, &lt;&lt;Ala ma moji ikweyi ko oza mani? Ongo oye gba ayi epa nongo kweyi oga ka do oyi kikyikyo mo, &lt;Oyi, ga yo oko eho ki inabi hin ikyeni.&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />&lt;&lt;Oyi oni kyogwu kamo, &lt;Nyya ga lo,&gt; Itikpi oke owa pya ga.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />Ada &lt;&lt;Ogebe ko oyi kome epa ga ka danu mamani. Oyi kyogwu, itikpi oke ga lo.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt;Anoho ipu ka ayi ase epa ni yo oza ni ada ya yimu ni?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Akamo, &lt;&lt;Oyi kikyikyo.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Oyesu ka dawa mo, &lt;&lt;Nyya ka dala okwokwoshi, awozegba kpa agbaza ba kwobonu da ala ba go Obula ko Owuso. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Koni Oyohana wa shiya ala owe neshi ko bwu, ala ke kyogwu kpanu lo, awozegba kpa agbaza kyogwu kpanu. Kweyi kpiri ko oza ni ala ma mani, ala tela ko kyogwu kweyi shagbotu sho ozalabi kala.<verse eid="MAT 21:32" /></para>
  <para style="s">Elase Ikweyi ka Awo osheho ka Abola</para>
  <para style="r">(<ref loc="MRK 12:1-12">oMak 12.1-12</ref>; <ref loc="LUK 20:9-19">oLuka 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Ala ya akpaha ze shini ala pwe elase mani. Ongo oye gbeho ki inabi, kweyi oto ngma gyehe to, obwo ogo ni aba pyi inyi ki inabi ipu nu ni, oki mo oda ki iso ko gbeho. Kweyi oye eho yi da awo yo oko ka abola abo, kweyi oganu gogya oye. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ni ishi gye ko kyi izire ni, ota ayole nu oleho ko ga zo ogwogwa ke efu mani ebe ka awo yo oko ka abola.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />&lt;&lt;Awo yo oko ka abola ni ke kwo oyole oye kweyi gwo, ayo oye ngmo, aki to oye akyo. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Oki ta ayole nwa sha awa ni oleho ko ga zo ogwogwa ke efu danu, awo yo oko ka abola ayuwa byoni aya kpase kikyikyo ni. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Itikpi oto oyi nu oleho kweyi okamo, &lt;Ko le mojoji, aba mo oyi hin ya gyiyi.&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />&lt;&lt;Ishini awo yo oko ka abola ke mo oyi nu yawa ni, akamo, &lt;Oyi nu yawa ma, ala wa shini an yo ngmo shini an rogwu ke eho!&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ayo kwu kweyi pyo ge ese ke eho ga yo ngmo.&gt;&gt;<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Oyesu doka mo, &lt;&lt;Ishini ada ke eho mani kwikye, oji ni ala ma byo oya ya kpa awo yo oko ka abola mani?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Akyogwu mo, &lt;&lt;Oya wa ya awase ni gbo otu labi mani ya ngmo kweyi ya ye eho ya da awa she hoha ni ba dani izire ke eho ni.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Oyesu ka dawa mo, &lt;&lt;Ala ma ebyibye ipu ko Okpa ko Owuso lo?</para>
  <para style="p" vid="MAT 21:42">&lt;&lt;&lt;Akyo ni awo mo oda tela ni, anu pini ya shoshi she la. Omani wo oyoya ka Adole la, oki shoshi koma!&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Nyya ka dala, aba yo obula ko Owuso ya bize sha ala abo kweyi ya yi da awase ni ba bi izire oni wa danu ni. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Kpiri kase ni gbo ikweyi ko okpo mani oya kyigbo wuruwuru, kweyi ase ni ogboso oya yo ya gba wo omu.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ishini awoteyi ka awosapa kpa awoteyi ka Awofarisi pwe elase mani ni, agye mo Oyesu ya kela ikweyi wa la. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Atikpo ko owe ko yo kwu, ake yoshi ikweyi koni ewa ka asuse zo wi inobane ni.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Elase ikweyi ki imya ko Onyape</para>
  <para style="r">(<ref loc="LUK 14:15-24">oLuka 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Oyesu ki kelase oye da awa mo, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Obula ki iso lema byelase ikweyi ko ose oye ni yi imya ko onyape do oyi nu ni. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Ota awo oshe nu oleho mo ana ga ya awase ni apawa ni ogwu na wa. Ishini aga ni, atela ko wa!<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Ebeni oki tawo oshe nu oye hoha oleho mo, &lt;&lt;Ala ga kada ase ni npawa ni mo, &lt;Nshoko kena kpi ikpowu. Ojoji kpiri yawa. Ala webe ki imya ko onyape mini!&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Awase ni apawa ni ke tela ko wa kweyi gawa gebye hoha. Ashe geho nu, ashe gebe ko otoyu nu. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ashishi ni kwa ayole nu kweyi dawa owe kotata, kweyi yuwa ngmo. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Otu ko ose ni bya kotata, kweyi otawa adakare nu oleho ga yawo ngmase mani yi ngmo kpiri kweyi ki yo ogya wa yi yola.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Ebeni oka dawo oshe nu mo, &lt;Ojoji ko onyape gbayi wa, awase ni npawa ni ke sho ogbayi mani lo. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ala gowe shepa shini ala kada ase ni ala ma kpiri mo ana webe ko onyape.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Awo oshe ni bose gowe shepa ga ya ananoho ni ama ni ogwu wa, kase neshi, kase labi kpiri, kweyi oyikpa mwu kpa asuse.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Ishini ose ke wipu ko ma awo ogboga ni, omo ongo oye ni sho obagidi ko gbayi lo ni. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Kweyi odo oka mo, &lt;Oya, oyamoji webe ni kpo obagidi ko gbayi lo?&gt; Ongo mani ke gege ko ojije lo.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Bwebe ni ose ka dawo yiyi kwo oko ko onyape mo, &lt;Ala yi ikpo kpa abo gbo shini ala yo ta gipu kebe dibu, ebeni aba kyegba kweyi ba shabo ahanu.&gt;&gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />&lt;&lt;Kweyi Oyesu kamo, aya ase nwashika ogwu, gbayayi pini aze la.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Oka doda Ikweyi ke Egba Zoze ko do Okesa</para>
  <para style="r">(<ref loc="MRK 12:13-17">oMak 12.13-17</ref>; <ref loc="LUK 20:20-26">oLuka 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Awofarisi gbayi kweyi gbe ela koni aba yo Oyesu ya kwu. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Kweyi ata awogbosuwa kpase ko Ohiridus oleho gebe nu kweyi kamo, &lt;&lt;Inofoza, aha gye mo owino ko okwokwoshi la, oki ya fa ase ela ko Owuso ipu ko okwokwoshi, oya za anaho gyogye, <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />kadaha byo onabani: Oya shoshi shini ahan ze egba do Okesa ose ko Oroma la kwe ahan ka ze lo?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Oyesu ke gyo oza bibi ni aba gbo ipu ko otuwa ni kweyi kamo, &lt;&lt;Ojiya ni ala ba yimu ko yun kwu awoyoziyi? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ala byi ikwiri na ase ba zegba kpa anu ni bi wa.&gt;&gt; Kweyi abyi ikwiri oni wa danu. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Oyesu duwo oka mo, &lt;&lt;Oyi ka anoho kpi iye ka anoho yi ikwiri mani?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Akamo, &lt;&lt;Oyi ko Okesa.&gt;&gt; Oyesu ka da awa mo, &lt;&lt;Oza ni wa ko Okesa ala yi do Okesa, ala do Owuso oza ni wa ko Owuso ni.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ni apwo mani ni, igbashi yuwa kwu. Ashobita kweyi gawa.<verse eid="MAT 22:22" /></para>
  <para style="s">Onyape kpo Onyiso Amiri</para>
  <para style="r">(<ref loc="MRK 12:18-27">oMak 12.18-27</ref>; <ref loc="LUK 20:27-40">oLuka 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Enoni Awosadukiya ni mo onyiso ka amiri yaba lo ni we ebe ko Oyesu wa kamo, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />&lt;&lt;Inofoza, Omusa kamo owoni ongo gbo onya kweyi omoyi kpa anu lo gbi ishini ogekwu, oyinanu na doka ko onya oni shini na mo oyi danu. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ishi oye agba ayine ahapa ni bagye kpa aha ni. Oyi kikyikyo ipu wa ogbo onya, omoyi lo gbishini ogekwu, osho onya ni bita. Oyinanu doka nu. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ogbodagye mani kpo oyi ko me epa, kpa ko me eta gbishini ase ahapa ni kpiri gekwu. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ogwejeji nu, onya ni gekwu. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Nabani onyiso ka amiri, oya wo onya ka anoho ipu wa ikweyi koni kpiri wa ase ahapa doka nu ni?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Oyesu kyogwu mo, &lt;&lt;Ala gebi owe. Ala gyo okpa ko Owuso lo. Ala ki gyo oshu ko Owuso lo. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ishi ko nyiso amiri, ashishe ya gbo onya kwe aba byo go oda ko oba lo. Ishi oni aba lema bya ayoleho ipu ki iso. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ikweyi kase ni gekwu nyiso amiri ni ke, ala ma ebyibye ipu ko okpa lo? Ni Owuso kamo, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Ami wo Owuso ki Ibirayi, Owuso ki Ishaku kpo Owuso ko Oyakubu.&gt; Anu wo Owuso kase ni gbo olayi ni la, wo Owuso kase ni gekwu ni la lo.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ishini ewa ka asuse pwo oza-fofu nu ni, igbashi yuwa kwu.<verse eid="MAT 22:33" /></para>
  <para style="s">Ono ni Loshu She ni</para>
  <para style="r">(<ref loc="MRK 12:28-38">oMak 12.28-38</ref>; <ref loc="LUK 10:25-28">oLuka 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ishini Awofarisi pwo mo, ogwa awo Sadukiya agye ni, agbayi dudu ko ki do oka kela. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ashe ipu wa wi inofono, kweyi ya mo Oyesu ma kpo oka doda.<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />Okamo, &lt;&lt;Inofoza, onya wo nyakwu ipu ko ono ni Omusa daha ni?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Oyesu kyogwu mo, &lt;&lt;&lt;Yimu ka Adole Owuso wo kpo otu wo oye, ipu ko oza yoya wo kpo oshu wo kpiri.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Oni wa kikyikyo, oki wo onyakwu ipu ko ono. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Kome epa ki lema, &lt;Yimu kase byoni oya yimu kiyo ni.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Kpiri ko ono ko Omusa kpo oza-fofu ka awi inobane bi ikweyi ko ono epa mani la.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Okristi wo Oyi ka anoho?</para>
  <para style="r">(<ref loc="MRK 12:35-37">oMak 12.35-37</ref>; <ref loc="LUK 20:41-44">oLuka 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ishini Awofarisi shogba toni, Oyesu duwo oka mo, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Ala ba ra moji ipu ko otu kala ikweyi ko Okristi? Oyi ka anoho ni owe?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Akyogwu mo, &lt;&lt;Owo Oyi ko Odawuda.&gt;&gt; <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Oyesu ka dawa mo, &lt;&lt;Ojiya ni Omaku ko Owuso yo Odawuda yayo ogwu mo, &lt;Adole?&gt; Koni Odawuda kamo,<verse eid="MAT 22:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt;&lt;Adole kado Adole hin mo: Yagye abore hin gbi ishini nyya yawo obonya wo kpiri ba beye ki ikpo wo.&gt; <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />Odawuda yo Okristi ogwu mo, &lt;Adole&gt; bwo owe wonya ni Okristi yawo oyi nu?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Ashishe gege ko kyogwu kela ke lo. Bwe enoni go ohobu ashishe gege ko do oka kela ke lo.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Oyesu yo otu ka awofono kpa Awofarisi yi tese</para>
  <para style="r">(<ref loc="MRK 12:38-39">oMak 12.38-39</ref>; <ref loc="LUK 11:43">oLuka 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Oyesu ka de ewa ka asuse kpa awogboso mo, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Awofono kpa Awofarisi pini Omusa dawa oshu ko fono la. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Mani oni owo otiri shini ala yo oza ni aba fu ni kpo oza ni aba ka dala ni. Ala ke ka ko oza ni aba ya ni lo koni aba yo oko kpo oza ni aba fu ni lo. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Aba gbi iyo ni lenu ko nga ni ya sa ase akya, awa ke ba ta ase abo ko ze lo.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Kpiri ko oza ni aba ya ni wa ki iyi ka asuse. Aba yawu kpo okpa ni atela ko Owuso anu ni gbo ogo kpa akya wa. Ayo ogwa wirikpo gbo oshiye wa.<note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false">Aba ya mani shini ase na gye mo awa ba geyagye do Owuso</char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Ayimu ko bagye oka ka anyakwase ebe ki imya kpo ekpa. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Aba yimu shini ase na tuwo ogbogba ishini aba yawu ipu ki ipishi, ana ki yuwogwu mo, &lt;Inofoza.&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Ala ke, ashishe naka ya ala gwu mo &lt;Inofoza lo,&gt; Koni inofoza wo oye la, kweyi kpiri kala wa ayine la. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Ala ka yashe ogwu mo &lt;Ada,&gt; Ese mani lo, koni Owuso kin pini wa Ada kala iso la. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kwe ashe na ya ala ogwu mo &lt;Inofoza&gt; lo, koni ala gbi inofoza oye la, Okristi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ase ni wa anyakwase ipu kala kpiri ya meshe da ala. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Koni ase ni ya ngi ikweyi iso kpiri, aba zo wo ojije lo. Ase ni ke ziyi nu wo ojije lo, aba zo wa anyakwase.<verse eid="MAT 23:12" /></para>
  <para style="s">Akpaha Pyopyi Ikweyi ka awoyoziyi</para>
  <para style="r">(<ref loc="MRK 12:40">oMak 12.40</ref>; <ref loc="LUK 11:39-42">oLuka 11.39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20.47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Igbe na tala awofono kpa Awofarisi. Ala awoyoziyi! Ala yofunu ko Obula ki Iso yi gwu, kweyi ala ba gege ba gipu nu lo, kweyi ala shase shishini bita na ganu lo. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Igbe na ta ala awofono kpa Awofarisi, awoyoziyi! Ala yi iyo ka anyokwu yi re, kweyi ala ba tinarigwu gbeji shini ase na ma ala. Ikweyi koni, ala ba mo owe ko otata.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Oya labi moji ya dala awofono kpa Awofarisi, ala awoyoziyi! Koni ala sheyi ki ishu go okpagye oye lenu shini ala pya ashe wa shagbotu. Ishini owa, ala yo gbotu labi sha aka kala ko yo go ola!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt;Igbe na tala, ala awofiyi ni ba pya ase abo ni! Koni ala kamo owo ojije lo ko, &lt;Gwene kpo Ole ko Owuso, ase ni ke gwene kpo ozinariya ko Ole ko Owuso, owo otiri shini na yo oza ni ogwene kpa anu ni.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ala awofiyi ki ikyo! Onya wo neneshi; ozinariya, kwe Ole ko Owuso ni yo ozinariya wo neshi ni? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ala ki kamo, &lt;Owoni ase ni gwene kpo okpe ko Ole ko Owuso, owo ojije lo; owoni ase ni ke gwene kpe eshi ni yikweyi ko okpe ko Ole ko Owuso ni na yo oza ni ogwene kpa anu ni. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ala awofiyi! Onya wo neneshi! Eshi ni yikweyi ko okpe ko Ole ko Owuso ni la kwe okpe ko Ole ko Owuso ni ye eshi wo oza neshi la? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Mani oni, ase ni gwene kpo okpe ko Ole ko Owuso, ogwene kpo oza ni yikweyi nu ni kpiri pini yoma; <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />kweyi ase ni ogwene kpo Ole ko Owuso, ogwene kpo Owuso ni yipu nu ni oma; <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />kweyi ase ni ogwene kpi iso, ogwene kpe ebe ko Owuso kpo Owuso ni ya yagye ikweyi nuni.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Igbe na tala, awofono kpa Awofarisi, ala awoyoziyi! Ala ba zo oye ipu ki igwo, bwipu ki inyeba kpi ikpako, ala ke pyitikpi to oza ni wo nyakwu ipu ko ono ni, byo okwokwoshi, iyinyinyi kpo otusose. Ala ya awo oza mani kpiri kweyi ka sha kikyikyo bita lo. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ala awofiyi ni ba pyase abo ni! Ala ba ngmi iyu ni yipu ki inyi ni, ala ke ba yo onyakwimi yi me!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Igbe na tala, awofono kpa Awofarisi, awoyoziyi! Ala ba yi itikpi ka abwa kpo ogo yina neneshi, ipu nu ke mwu kpo ozabibi kpi imu ki iyi kala. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ala awofiyi ka Awofarisi! Ala yipu ka abwa kpo ogo yina ime shini ese nu na lema neneshi.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Igbe na tala, awofono kpa Awofarisi. Awoyoziyi! Ala lema bya amiri ni anyi iyawu nehe ni shoshi koma ese, ipu nu ke hirinyi kpo okpokwu kawase ni gekwu ni. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Mamani ase ba ma ala bya ala wa ase neshi, ipu ko otu kala ke mwu kpo yoziyi kpo otu bibi.<verse eid="MAT 23:28" /></para>
  <para style="s">Oyesu Kedo ko Owe ni Aba Mani</para>
  <para style="r">(<ref loc="LUK 11:47-51">oLuka 11.47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Igbe na tala, awofono kpa Awofarisi, awoyoziyi! Ala ma amiri ka awinobane, ki gwa amiri kawase neshi agya kyarigada. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ala kamo, &lt;Owoni aha bi baba ishi ka awokyikyi ka aha, aha biba tuwabo ko ngma awinobane lo.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Bwebe ko omani, oya shiya ase kamo ala wa ayikayi kawase ni ngma awinobane ni oma. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ala yo shishini ko oko ni awokyikyi kala yani yiya! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Ala egwa! Ayi ki ifufule igboji! Ala baya moji ome ni ala ba bose shipu kepwo kole ko ola? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Mani oni, nyya to oleho ka awinobane kpa awofoza kpa awinoziyi. Ala ba ya ase shishini wa yi ngmo, ala ba ya ase shishini wa yi poshi sepa, ala ki ba ya ase shishini wa aboshi ipu ke ekpa, ala ki ba na ase shishini wa enya bwo ogya bwo ogya. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ikweyi koni oyi kawase neshi ni ala ngmo ese mani yikweyi kala, bwi ikweyi kase neshi Abila gi ikweyi ko Ozakariya oyi ko Oberikiya ni ala yi ngmo obepa ko Ole ko Owuso kpo okpe ko shokoyi ni. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Nyya ka dala okwokwoshi, kpiri ko oza mani ya gbodagye kpase ki ishi mani.<verse eid="MAT 23:36" /></para>
  <para style="s">Oyesu byotu do Ojerusele</para>
  <para style="r">(<ref loc="LUK 13:34-35">oLuka 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Aye, Ojerusele, Ojerusele, ala ni ngma awinobane ki ta awoleho ko Owuso akyo! Igbe ma ni nyya yimu ko kpa ayi kala tukpa byoni ogwu ya kpa ayi nu ya leba akya nuni, ala ke tela ko ya mani. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ala ma byo onabani, asho ole kala bita gba ashishe lo. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nyya ka dala, ala ba mun kelo gbishini ala ba kamo, &lt;Otunehe yo kpase ni wa ipu ki iye ka Adole!&gt;&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Oyi ko kweyi kishi mani</para>
  <para style="r">(<ref loc="MRK 13:1-2">oMak 13.1-2</ref>; <ref loc="LUK 21:5-6">oLuka 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ni Oyesu sho Ole ko Owuso bita ya ga ni, awogboso webe nu kweyi ba shiyanu ole kpiri. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Oyesu kadawa mo, &lt;&lt;Ala ma awole ni bagye mani? Nyya kadala okwokwoshi, kpiri ka awikyikpo mani ba wa sa sho okpagye. Oye ya yikweyi koye lo.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Oyesu yagye ikweyi ke Efu ko Ozetu, awogboso wa tanu ishini oyagye fufunu ni kweyi kamo, &lt;&lt;Kadaha, ishi wonya ni awo oza mani ba gbodagye? Aha baya moji agyo oyi ko owowa wo kpo okweyi ki ishi mani?&gt;&gt; <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Oyesu ka da awa mo, &lt;&lt;Ala gbera ela koni ashishe na ka bya ala gowe labi lo. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ase nwashika ba wa kpi iye hin, aba kamo, &lt;Ami wo Okristi la.&gt; Aba gyase nwashika egya gowe labi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ala ba pwela kefu kpa amo kefu kpokpo, ala ka yoshi lo. Awoza mani ba gbodagye, oke wo okweyi kese lalo. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Okpagye oye ba kpefu kpo okpagye oye, obula oye ba kpefu kpo obula oye. Ase ba ngme emye ebebenya kweyi okpagye ya ja jigi-jigi agye gogo-gogo. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Kpiri ko oza mani wo kwotu ko owe pini yoma.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Ishi oni aba yala dawa shini ana dala egye, kweyi ba yala ngmo, kweyi ananoho ba yanya kala ikweyi hin ese mani. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ipu kishi oni ase nwashika ba kwikye itikpi sho otuse wa. Ase ba tiyiwa anyi kweyi ba yiyiwa yi ra. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Awobane ko kame nwashika ba wa, kweyi wa gyase nwashika egya gowe labi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Otu bibi ya go ohobu, imu ni ase gbo ikweyi kiyiwa ni ya sha, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />ase ni ke zotu kotata gesese aba ngma nu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Kweyi aba tono koshu neshi ko Obula ko Owuso ge ebebenya ese mani shini ana pwo, ome ese ya kweyi la.<verse eid="MAT 24:14" /></para>
  <para style="s1">Owe labi ni yawa ni</para>
  <para style="r">(<ref loc="MRK 13:14-23">oMak 13.14-23</ref>; <ref loc="LUK 21:20-24">oLuka 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Ishini ala ba moza kebi ni ya gbodagye ebe neshi ko byebe kyokya wa byoni inobane Odaniyel ka ni, &lt;Inomokpa na gye.&gt; <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Ase ni bo okpagye ko Oyahudiya ni, na nyinya gi ikweyi ke efu. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ase ni yi iso ki inu kole nu naka sa wo okpagye zo ojije ipu kole lo. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ase ni ye eho naka kwikye ga kpo oshiye nu lo. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ishi oni ya labi da anya ni bipu, kpa anya ni bya ayi abo ni! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ala tinarigwu shini oza mani naka gbodagye ishi ko oshu kwe, eno ko minyo ka Ase ko Oyahuda lo. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ikweyi koni ishi oni aba mo owe labi ni edo nu gbodagye ebibye wa lo bwi ikyikyo kese gbi ishi mani, oza mani ya gbodagye kelo. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Owoni Owuso bi yi ishi mani shigbo lalo, ashishe bi ya gbo olayi lo. Oya yi ishi mani shigbo ela kawase ni oshu ni. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />&lt;&lt;Ipu ki ishi oni owoni ashe ka dala mo, &lt;Ma, Okristi yoma!&gt; Kwe &lt;Oyoma!&gt; Ala ka kyogwu lo. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Koni Okristi ko kame kpa awobane ko kame ba wa kpo oyi ba wa yo oza ki igbashi shini ana gya ase egya kawase ni Owuso shu ni owoni aba gege. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ma, nyya ka dala hagye ime ona gwudagye.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Owoni aka da ala mo, &lt;Ala ma! Oyo ododa oma, ala ka bose lo; kwe, akamo, &lt;Oyo oda ki ipu,&gt; Ala ka kyogwu lo. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Byoni ola ka akpula yayu bwa ohanokyi ge enone ni, owowa ko Oyi ka Asuse ya lemani la. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ebeni okwu tagye ni pini ayikyefu ba sa anu la.<verse eid="MAT 24:28" /></para>
  <para style="s1">Owowa ko Oyi ka Asuse.</para>
  <para style="r">(<ref loc="MRK 13:24-27">oMak 13.24-27</ref>; <ref loc="LUK 21:25-28">oLuka 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Itikpi ko owe ishi oni, &lt;Ebe ya dibu, oya ya yu lo; inyiwo ba shonu bwo okpowuso, kweyi okpowuso yaja.&gt;<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;Ishi oni aha ba mo oyi ko owowa ko Oyi ka Asuse bwo okpowuso, kweyi okpagye kpo ose kese mani kpiri ba kyegba. Aba mo Oyi ka Asuse yawa bwi ipu ka akpa kpo oshu kpi igyashi nyakwu ipu ki iye shosha nu. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Kweyi oya ta ayoleho nu oleho basa bwi iso kpa ajigwo ba ta nwa, kweyi aba kpa awase ni ashu ni gbayi bwagi ene kese mani ga anoni.<verse eid="MAT 24:31" /></para>
  <para style="s1">Oza fofu ko Oyesu ikweyi ke efu ko Ofigi</para>
  <para style="r">(<ref loc="MRK 13:28-31">oMak 13.28-31</ref>; <ref loc="LUK 21:29-33">oLuka 21.29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Ala fela koje ebe ke efu ko Ofig. Ishini ayabo nu ba fefu, ala agye mo, ogwa yo pee. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Mamani, ishini ala mawoza mani ba gbodagye, ala agye mo ishi oni shishini gbayayi kogya, ko kwotu. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Nyya ka dala okwokwoshi, ase ki ishi mani ba shigbo lo sa awo oza mani kpiri gbodagye. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Iso kpo okpagye ya shuga, ela hin ke ya shuga lo.<verse eid="MAT 24:35" /></para>
  <para style="s1">Ashishe gye eno kwi ishi ko owowa ko Oyesu lo</para>
  <para style="r">(<ref loc="MRK 13:32-37">oMak 13.32-37</ref>; <ref loc="LUK 17:26-30">oLuka 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ashishe gye eno kwe ishi oni lo, kwa ayoleho ko Owuso ni bi iso ni, kwe Oyi lo, ke sa Ada nu fufunu. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />&lt;&lt;Byoni ogbodagye ishi ko Onuhu ni, mamani oki ya gbodagye ishi ko wowa ko Oyi ka Asuse. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ishi oni, ome inyo nawa ye ese re, ase ba roza ba gwinyi. Ango ba gbanya, aba bya anya go oda ko oba, gbi ishini Onuhu gipu ko owu; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />ashishe gyo oza ni ya gbodagye ni lo gbi ishini inyo wa yuwa pe ga. Oya lemani ishini Oyi ka Asuse ya kwikye ya wa ni. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />&lt;&lt;Ishi oni ango epa ba yo oko ipu keho, aba yo oye ya bize ba sho oye bita. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Anya epa ba akpego ba gboza, aba yo oye bize ba sho oye bita.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Mani oni, ala gbera! Ikweyi koni ala gye eno ni Adole kala ya kwikye ya wa ni lo. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nyya yimu shini ala gyo mo: Owoni adole ya gyi ishini owi ya wo ole nu otutehe ko otu ni, obi ya gbeho kole nu, obi ya kyogwu shini owi na go ole nu lo. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ikweyi koni ala bagye kpe era. Oyi ka Asuse ya wa ishini ala ba gye lo ni.<verse eid="MAT 24:44" /></para>
  <para style="s">Oshe ni gbo otuse kpo oziyi ni</para>
  <para style="r">(<ref loc="LUK 12:41-48">oLuka 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Anoho wo oshe ni gbo otuse ki ziyi ni, ase ni adole nu ya yo otuso kweyi ki sho ole nu bita danu kweyi kamo na da awo oshe shishini oza rore ipu ki ishi neshi? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Oya shoshi owoni adole ko oshe mani wa ta anu yo oko nu neshi ishini okwikye wa. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Nyya ka dala okwokwoshi, oya yo oza ni ogbo ni kpiri yi danu abo. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Obi ke wo oshe bibi la, obi ya ka ipu ko otu nu mo, &lt;Adole hin ya ga gbeji,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Kweyi kwotu ko gwa ashishini ko oshe mani, kweyi bi ya roza ya gwinyi kpa ayi ki inyi. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Adole ko oshe mani ya wa eno ni oyo otutagye lo kweyi oya wa ishi ni ogye lo ni. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Adole ko oshe mani bi wa yo shigbo wuru-wuru kweyi yo tagye kpa awoyoziyi, ebe ni aba kyegba ba sha abo ahanu ni.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Elase ikweyi ki Isonya igwo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Ishi oni obula ki iso ya lema byo isonya igwo ni bya awikwomu wa kweyi ba yimu ko ga mo oba ko onyape ni. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ase eho ipu wa wo ogbowuru kweyi ase eho ziyi. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ishini ase eho ni wo ogbowuru mani za awikwomu wa ni abya ano ko de sho lo. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Awino ziyi mani bya ano nwashika ipu ko ogya kpa awikwomu wa. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Oba ko onyape bose papa lo, kpiri wa ba yola, kweyi agbola.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;Otutehe kotu ashuwa iyi kpo oga tota mo: &lt;Oba ko onyape yoma! Ala bose wa ta nu!&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />&lt;&lt;Ebeni kpiri ki isonya igwo mani nyiso kweyi kya awikwomu wa tu. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Awase ni wo ogbowuru mani ka da awino Ziyi mo, &lt;Ala baha ano kala, awikwomu ka aha ba gebi.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />&lt;&lt;Awino ziyi ke kyogwu mo, &lt;Aha gba ano nwashika ko gyaha kpiri ka aha lo. Ala gipishi shini ala ga mya.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;Ishini aba ga ko ga mya ano ni, oba ko onyape wa. Awa ni bebeni ni gboso oba ko onyape gipu kole ebe ki imya. Kweyi ayofunu kole yi ba.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt;Gbeji lo, isonya eho mani kwikye wa hagye ese ba yogu mo, &lt;Adole! Adole! Gwofunu daha!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />&lt;&lt;Oke kamo, &lt;Nyya ka dala okwokwoshi, ngya ala lo!&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />&lt;&lt;Ikweyi koni, ala bagye kpera! Ala gyeno kwi ishi lo.<verse eid="MAT 25:13" /></para>
  <para style="s1">Elase ikweyi ka Ayole Eta</para>
  <para style="r">(<ref loc="LUK 19:11-27">oLuka 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Mamani, obula ko Owuso ya lema bya Adole oye ni ya giyawu ni, oya awoyole nu ogwu, kweyi oyodu dawa abo. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ashe odanu ozinariya okpakwu eho, ashe ozinariya okpakwu epa, ashe ozinariya okpakwu oye, ananoho wa odanu gyogye kpo oshu nu. Bwebe ni oganu giyawu. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Oyole ni zo ozinariya okpakwu eho ni, ga yo otoyu kpa nu, opyo okpakwu eho manu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Mamani oyole ni zo ozinariya okpakwu epa ni ga yo otoyu kpa nu, opyo okpakwu epa manu. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Oyole ni ke zo ozinariya okpakwu oye ni ga bwogo yo okpakwu oye ka Adole nu yi teba anu.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Ipu kishi gbeji, adole ka ayole mani kwikye bwiyawu nu wani, oyuwogu shini ana wa koza ni aya kpikwiri ni odawa ni. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Oyole ni zo ozinariya okpakwu eho ni wa kwagye obutu nu kweyi kamo, &lt;Adole, odami ozinariya okpakwu eho ko yo otoyu. Ma, nki pyo okpakwu eho manu.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt;Adole nu kamo, &lt;Nngmagye, oyole neshi kpo otuse! Oyoza ko otuse kpo oza gbayayi; nyya yo ya wo oteyi koza nwashika. Wa shini an shotunehe dudu!&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Oyole ni zo ozinariya okpakwu epa ni wa kwagye obutu ka adole nu kweyi kamo, &lt;Adole, odami ozinariya okpaku epa ko yo otoyu. Ma, nki pyo okpakwu epa manu.&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt;Adole nu kamo, &lt;Nngmagye, oyole neshi kpo otuse! Oyoza ko otuse kpo oza gbayayi; nyya yo ya wo oteyi koza nwashika. Wa shini an shotunehe dudu!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />&lt;&lt;Oyole ni odanu ozinariya okpakwu oye ni wa kwagye kweyi kamo, &lt;Adole, ngyo kpo otu labi, oya kyi izire ebeni otu lo ni, oya kpi izire ebeni omyi lo ni. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Nyyo oshi, ela koni ikwiri wo ya gebi ni, nyyi teba okpagye. Ma, ozinariya wo yoma.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt;Adole nu kamo, &lt;Owo oyole bibi kpa ayaga! Ogye mo nyya kyi izire ebeni ntu lo ni, ya kpi izire ebeni nmyi lo ni. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Obi yi ikwiri ni to olashiko, koni ishini nwwa, nbi ya wa zi ikwiri hin kpi inyigwiye.&gt;<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt;&lt;Ikweyi koni ala zo ozinariya okpaku oye mani yi bize shabo nu kweyi yi dine ko ozinariya okpaku igwo oni. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Koni kpiri kase ni gboza aba fumanu danu, kweyi oya gbo nwashika. Ase ni gbojije lo, ko gbayayi ni agbo ni, aba yi kpo shabo. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ala yo oyole yeye mani ta gese ipu kebe dibu, ebe ni oya mowe kweyi ya shabo ahanu ni.&gt;&gt;&gt;<verse eid="MAT 25:30" /></para>
  <para style="s1">Epwo koka ko gwejeji</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Ishini Oyi ka Asuse ya wa ipu ko igyashi nu kpa ayoleho ko Owuso, oya wa yagye ebe nu ipu ko igyashi ki iso. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Kpiri ko okpagye kese mani ba wa gbayi obutu nu, kweyi oya ya asuse ya ko oyoye byoni inogwobize ya ko otukpo kpi ikpowu ni. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Oya kpo otukpo ya shabore nu, kweyi ikpowu ya shaboshe nu.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Bwebe ni Ose ya kada wo ba abore nu mo, &lt;Ala wa, ala ni Ada hin sala aboneshi ni; ala zo ogwu kala, obula ni akyanu tu dala bwishi ni aye ese ni. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Koni ishini emye ya ngmu ni, ala da ami ozarore. Igyini ya ngmu, ala dami inyi gwa. Nwwo ogboga, ala byun gole kala. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Nyyewewa, ala kpa akyi yumeyi. Nyya gbere, ala byere hin. Nyyo oruduru, ala webe hin.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />&lt;&lt;Ebeni awase neshi ba kamo, &lt;Adole, ishi nya ni emye ya ngmo kweyi aha dawo ozarore? Kwe igyini ya ngmo ni aha dawo inyi gwa? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Ishi nya ni owogboga ni aha byo gole ka? Kwe ishi nya in oye ewewa ni aha yaakyi? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ishi wonya ni aha mo oya gbere kwe ayo toruduru kweyi aha gebe wo?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt;Ose ya kamo, &lt;Nyya ka dala okwokwoshi, oza ni ala ya kpa ayene hin leke kpiri, ala ya kpa ami la.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Oki ya kada awase ni ba aboshe nu ni mo, &lt;Ala nyiso shobutu hin, ala ni atala igbe ni, gipu kola ko gbogbo-gbogbo ni agwo di ibiri kpa ayoleho nu ni. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Koni emye ya ngmu, ala dami ozarore lo. Igyini ya ngmu, ala da ami inyi gwa lo, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Nwwo ogboga, ala byun gole kala lo. Nyyewewa, ala yuma akyi lo. Nyya gbere, kweyi abyun go oruduru, ala ke tumabo lo.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Awa ki ba kamo, &lt;Adole, ebenya ni aha mo ya ngmemye kwe igyini kwe owogboga, kwe oyewewa kwe oya gbere, kwe ayo toruduru kweyi aha tuwabo lo?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Oya kamo, &lt;Nyya ka dala okwokwoshi, oza ni ala tela ko ya da ayene leke, ala tela ko ya dami pini yoma.&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />&lt;&lt;Ebeni aba mowe ko gbogbo-gbogbo, awo yoza neshi ke aba kpuwa ya sho olayi ko gbogbo-gbogbo.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Anyakwase ga gbela ko yo Oyesu ngmo</para>
  <para style="r">(<ref loc="MRK 14:1">oMak 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">oLuka 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Oyohana 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ishini Oyesu kela kweyi kpiri ni, oka da awogboso mo, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Ala gye mo, Imya ko Sheyi she eno epa go ohobu mina, kweyi aba yo Oyi ka Asuse ya kwu da awa kweyi aba yo poshi.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ebeni oteyi ka awosapa kpa awanyakwase ga gbela ole ko Okayafas oteyi ka awosapa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />aga gbe ela ko yo Oyesu kwu kweyi yo ngmo. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Akamo, &lt;&lt;Oke wi ishi ki Imya ko Shigbo lo, ela koni ewa ka asuse naka shawa lo.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Onya oye shotunehe do Oyesu Obetani</para>
  <para style="r">(<ref loc="MRK 14:3-9">oMak 14.3-9</ref>; <ref loc="LUK 7:37-38">oLuka 7.37-38</ref>; <ref loc="JHN 12:1-8">Oyohana 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ishini Oyesu tayayo yo ogya ko Obetani, ipwo ole ko Osimo, ni gbo ose ki iyiwa ni. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Onya oye wi ipwo ole kpe eyi ka ano kpeye ko shi ikpiye ni gbo ogye ni kweyi wa sho Oyesu ikweyi ishini oya roza ni.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ishini awogboso Oyesu mo oza mani, akyanya kweyi akamo, &lt;&lt;Ibya koji mani? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ano kpeye mani agye lo yi ra, ogye nu ya nwashika kweyi abi yo ogye do oleha.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Ni Oyesu ke gyo oza ni yo otuwa ni okamo, &lt;&lt;Ojiya ni ala ba jo onya mani abo? Oza ni oyun ni shoshi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Kpiri ki ishi ala bagye kpa awoleha, ami ke ya yo kpa ala ishi kpiri lo. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Ishini oya shu ma ano mani ikpiye, oya kya ami yatu gbeyi ke eno ni aba yun nyi ni la. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Nyya ka dala okwokwoshi, kpiri ke ebe ni okoshu neshi mani ipu kese mani, aba ko oza ni onya mani ya ni shini na wo oza ki igwu ikweyi nu.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s1">Oyahuda Kyogwu ko yo Oyesu yi Ra</para>
  <para style="r">(<ref loc="MRK 14:10-11">oMak 14.10-11</ref>; <ref loc="LUK 22:3-6">oLuka 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ebeni oye ipu ka awogboso igwepa ni aba yogwu mo Oyahuda Iskariyoti ni, ge ebe ka awoteyi ka awosapa, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />oga duwo oka mo, &lt;&lt;Oji ni ala ba da ami owoni nyyo Oyesu kwu da ala?&gt;&gt; Ebeni ada nu azurupa okpaku aweta. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Bwi ishi oni, Oyahuda ya tikpo ko owe ni oya yo Oyesu ya kwu da awa ni.<verse eid="MAT 26:16" /></para>
  <para style="s">Oyesu Roza ki Imya ko Sheyi kpa Awogboso</para>
  <para style="r">(<ref loc="MRK 14:12-21">oMak 14.12-21</ref>; <ref loc="LUK 22:7-13">oLuka 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Oyohana 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Eno kikyikyo ko ro oza ki Imya ki ikyoga ni gbo Oyisi lo ni, awogboso Oyesu we ebe nu wa do oka mo, &lt;&lt;Ebenya ni oya yimu shini ahan ga kyanutu ko roza ki Imya ko Sheyi do?&gt;&gt; <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Okamo, &lt;&lt;Ala gipu ko ogya, ebe ko ongo oye, ala ga ka danu mo, &lt;Adole kamo, ishi nu yo pee, anu kpa awogboso ba yimu kowa roza ki Imya ko Sheyi ole wo.&gt;&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Awogboso Oyesu yo oza ni oka da awani, aga yo oza rore ki Imya ko Sheyi.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Ishini eno shani, Oyesu yagye kpa awogboso igwepa ba roza. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Ni aba ro oza ni Oyesu kamo, &lt;&lt;Nyya ka dala okwokwoshi, ashe ipu kala ya yun ra.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Ebeni otuwa bya ko otata, akwotu ko diyiwa oka mo, &lt;&lt;Kwa ami la, Adole?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Oyesu kyogwu mo, &lt;&lt;Ashe oye, ni ya labo owatu kpa ami ni pini ya yun ya ra la. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Oyi ka Asuse ya ga byoni ayitota ipu ko okpa ni. Igbe na ta ase ni yo ra ni. Oya shoshi shini abi ka mo lo.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Bwe ebeni Oyahuda ni yo ra da awa ni do oka mo, &lt;&lt;Inofoza, ami la?&gt;&gt; Oyesu ka danu mo, &lt;&lt;Awo la.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Ikpiye ka Adole</para>
  <para style="r">(<ref loc="MRK 14:22-26">oMak 14.22-26</ref>; <ref loc="LUK 22:14-20">oLuka 22.14-20</ref>; 1 Okorenti 11.23-25)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Ishini aba roza ni, Oyesu zi Ikyoga kweyi keshi ko Owuso kweyi oyikyigbo kweyi da awogboso kamo, &lt;&lt;Ala ze shini ala ha, omani pini wi ikpiye hin la.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Oki za abwa ki inyi, okeshi do Owuso, oyi da awa kweyi kamo, &lt;&lt;Ala ze sha ala gwa kpiri kala bwi ipu nu. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Omani wo oyi hin la, oyi ko okoyi pepe, ko yozalabi gba asuse kpiri. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nyya ka dala, nyya gwinyi ki inabi ke lo, si ishi oye ni nki yawa gwo opepe kpa ala dudu ipu ko obula ka Ada hin.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ishini Oyesu kpa awogboso wigye ni, abose gi ikweyi ke Efu ko Ozetu.<verse eid="MAT 26:30" /></para>
  <para style="s">Oyesu kamo Obitrus ya Tawashu nu</para>
  <para style="r">(<ref loc="MRK 14:27-31">oMak 14.27-31</ref>; <ref loc="LUK 22:31-34">oLuka 22.31-34</ref>; <ref loc="JHN 13:36-38">Oyohana 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Kweyi Oyesu ka da awa mo, &lt;&lt;Otu ki ikyeni ala ba kya kala shun bita. Byoni ata ipu ko okpa ko Owuso kamo,</para>
  <para style="q" vid="MAT 26:31">&lt;&lt;&lt;Ami Owuso ya ngmi inogbeho ko obize, kweyi otukpo ba kya.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Owoni nyiso amiri, nyya kwobonu ya da ala ya go Ogalili.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Obitrus kyogwu mo, &lt;&lt;Owoni kpiri kase ba kya shobita, nyya shobita lo.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Oyesu ka danu mo, &lt;&lt;Nyya ka da awokwokwoshi Obitrus, ipu ko otu mani, ome obogwu na tono, oya tawashu hin igbe eta mo ogyun ebibye lo.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Obitrus hagye oko nu mo, &lt;&lt;Ko owako gekwu, nyya ga kpa awo, nyya shobita lo!&gt;&gt; Kpiri ka awogboso ka mamani.<verse eid="MAT 26:35" /></para>
  <para style="s">Oyesu Tinarigwu Ogetsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">oMak 14.32-42</ref>; <ref loc="LUK 22:39-46">oLuka 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Ebeni Oyesu kpa awogboso ge ebye ni aba yogwu mo Ogetsemani, kweyi oka da awa mo, &lt;&lt;Ala bagye ebeni, nyya ga anoni ga tinarigwu.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ozo Obitrus kpa ayi ko Ozebedi epa, kweyi okwotu ko byo otu ko tota. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Oka da awa mo, &lt;&lt;Otu hin ya bya byona gekwu ni. Ala hagye ebeni shini ala gbeho kpa ami dudu.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Oshaga kee kweyi ogbo yi iyi ka agye kweyi ya bo Owuso mo, &lt;&lt;Ada hin! Owoni okyogwu, ya abwa mani yi bize shun. Oza ko otu wo ke na gbodagye, wa akaka hin lalo.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Bwe ebeni okwikye we ebe ka awogboso, kweyi owa tawa ba gbola, kweyi oka do Obitrus mo, &lt;&lt;Ala bagege ya gbeho kpa ami kwa aki ishi oye lo? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Ala gbeho kpi inarigwu, shini ala ka gbo ipu ko omama lo. Ko kwokwoshi omaku ya yimu, ikpiye ke sha!&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Oyesu ki kwikye kome epa ge ebe ko tinarigwu mo, &lt;&lt;Ada hin! Owoni okyogwu, ya abwa mani yi bize shun lo, yo oza ni yipu ko otu wo na gbodagye.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ishini oki kwikye we ebe wa ni, oki wa tawa ba gbola, koni ola nwuwiyi ni. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Oshu wa bita kwikye ko omweta ge ebe ko tinarigwu, ya kyo oza ni oka ni ya ka.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Ebeni okwikye we ebe ka awogboso kweyi kamo, &lt;&lt;Ala tayayo ba gbola, ki ba minyo? Ala ma, ishi ke gye wa. Aba yo Oyi ka Asuse ya ra da awino ozalabi ikyeni.&gt;&gt; <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ala nyiso. Shan ga. Ma, ase ni ya yun ya ra da awa ni yoma!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s1">Ayo Oyesu Ra kweyi yo Kwu</para>
  <para style="r">(<ref loc="MRK 14:43-50">oMak 14.43-50</ref>; <ref loc="LUK 22:47-53">oLuka 22.47-53</ref>; <ref loc="JHN 18:3-12">Oyohana 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Oyesu yipu kela ya ka, Oyahuda ni wo oye ipu ka awogboso igwepa ni wa kpe ewa ka asuse kpe ewakpa kpo okposhi abo wa. Awoteyi ka awosapa kpa awanyakwase pini tuwo oleho la. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ase ni ya yo Oyesu ra da awa ni kwobonu ka da awa oza ni oyaya ni, okamo, &lt;&lt;Ase ni ami kwo botu, anu pini yoma, ala yo kwu!&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">26.48 </char><char style="ft" closed="false">Ebeni aba kamo, gwo okwunu la, koni okwunu gwogwa wo odu ka Ase ko Oyahuda ni</char></note> <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Owowa nu, okwu tiriri ge ebe ko Oyesu, kweyi kamo &lt;&lt;Nngmagye, Inofoza!&gt;&gt; Kweyi okwo botu.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Ebeni Oyesu ka danu mo, &lt;&lt;Oya hin yo oza ni byo wani.</para>
  <para style="p" vid="MAT 26:50">Ebeni asha go ohobu ga yo kwu. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ebebeni oye ipu kawase ni bagye kpo Oyesu pe ewakpa kweyi yo oshe ko oteyi ko osapa akpaha oye she.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Oyesu ka danu mo, &lt;&lt;Kye ewakpa wo la ape nu. Kpiri kase ni yayo oza kpe ewakpa, oya gekwu kpe ewakpa. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ala gye mo nyya gege ko ba Ada hin, na da ami ikpo ka awadakare ka ayoleho nu ni sho okpakwu igwepa lo? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Owoni nyya mani ke, ela ni okpa ko Owuso kani yamoji ya gya ikweyi ko oza ni ya gbodagye anani?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ishi oni Oyesu ka de ewa ka asuse mo, &lt;&lt;Nyyo oji ni ala wa kpe ewakpa kpo okposhi ko wa yun kwu byo nwwo owi? Nyyo kpa ala kpiri ki ishi ya foza Ole ko Owuso, kweyi ala gege ko yun kwu lo. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />&lt;&lt;Kpiri ka awoza mani ke gbodagye shini oza ni inobane ta ipu ko okpa ni na gyogye.&gt;&gt;</para>
  <para style="p" vid="MAT 26:56">Ebeni kpiri ka awogboso shobita kweyi nyinya wa.<verse eid="MAT 26:56" /></para>
  <para style="s1">Abyo Oyesu go Obutu ka Awonongbo</para>
  <para style="r">(<ref loc="MRK 14:53-65">oMak 14.53-65</ref>; <ref loc="LUK 22:54-55">oLuka 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Oyohana 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Awase ni yo Oyesu kwu ni byo ge ebe ko Okayafas oteyi ka awosapa, ebeni awofono kpa awanyakwase ba gbayi ni. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Obitrus ke gbosuwa itikpi ebe lenu ga akpada kole ko oteyi ko osapa. Oga yagye kpa awogbeho shini ona mo oza ni ya gbodagye ni.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Ebeni oteyi ka awosapa kpa awonongbo ba labo ko olobene ko okame ikweyi ko Oyesu shini ana yo ngmo. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Awolobene ko okame nwashika bose, ake pyela zoze lo.</para>
  <para style="p" vid="MAT 26:60">Itikpi ase epa bose, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />kweyi kamo, &lt;&lt;Ongo mani kamo, &lt;Nyya gege ko yo ole ko Owuso mani yi kye kweyi ya kyanu ya ma ipu ke eno eta.&gt;&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Ebebeni oteyi ka awosapa takpa nyiso kweyi ka do Oyesu mo, &lt;&lt;Oya kyogwu kela mani lo? Olobene ko okame ni awase mani ba ka ikweyi wo ni?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Oyesu ke ko ojije lo.</para>
  <para style="p" vid="MAT 26:63">Oteyi ka awosapa ka danu mo, &lt;&lt;Nyya kwikpo ko Owuso ni gbo olayi ni ebe wo: Ka daha owoni awo pini wo Okristi, Oyi ko Owuso la.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Oyesu ka danu mo, &lt;&lt;Byoni oka ni. Nke ya ka dala: bwi ishi mani go ohobu, ala ba mo Oyi ka Asuse ya yagye abore ki Ine ko Oshu kweyi ya awa ipu ko okpowuso ki iso.&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ebeni oteyi ka awosapa yo oshiye nu yi sha, kweyi kamo, &lt;&lt;Okela ka arigbetu! Olobene koji ni aha ba tikpo bwe ebenu ke? Ala pwo, okela ka arigbetu. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ala ma moji?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">Akyogwu mo, &lt;&lt;Oshu ko gekwu.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Ebeni atehe shiiyi kweyi aki gwo. Ashishini kase laabo akpaha <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />kweyi kamo, &lt;&lt;Bane daha Okristi. Anoho gwo?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s1">Obitrus Tawashu mo Anu Gyo Oyesu lo</para>
  <para style="r">(<ref loc="MRK 14:66-72">oMak 14.66-72</ref>; <ref loc="LUK 22:56-62">oLuka 22.56-62</ref>; <ref loc="JHN 18:15-18">Oyohana 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ni Obitrus yagye ikpakyo ni, oshe nonya oye wa ta anu kweyi kamo, &lt;&lt;Awo yo kpo Oyesu ko Ogalili mamani.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Obitrus ke tawashu obutuwa kpiri mo, &lt;&lt;Ngyo oza ni oya ka ni lo.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Onyiso gofunu ke ekpa, oyinonya oye ki mo kweyi ka da awase ni bagye ebeni mo, &lt;&lt;Ongo mani yo kpo Oyesu Onazareti mamani.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Oki tawashu kpe enegwogwa mo: Ngyo ongo mani lo!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Ishi kee awase ni hagye ebeni ni gebe ke Obitrus kweyi ka danu mo, &lt;&lt;Ko okwokwoshi owashe oye ipu wa la koni ela koka wo shiya aha ni.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Bwe ebeni okwotu ko tawashu kpe enegwogwa ya kamo, &lt;&lt;Anu gyo ongo mani lo!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Ebebeni obogwu tono. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Bwe ebeni Obitrus rela ni Oyesu ka danu ni mo, &lt;&lt;Ome obogwu na tono, oya tawashu hin igbeta.&gt;&gt; Kweyi obose ge ese ga kyegba kotata.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Oyesu Obutu ko ogbolamaga Obilatus</para>
  <para style="r">(<ref loc="MRK 15:1">oMak 15.1</ref>; <ref loc="LUK 23:1-2">oLuka 23.1-2</ref>; <ref loc="JHN 18:28-32">Oyohana 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ototukpoki, kpiri ka awoteyi ka awosapa kpa awanyakwase ga gbayi kweyi gbela ko yo Oyesu ngmo. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ayo gbo ogwa, kweyi abyo ga do ogbolamaga Obilatus.<verse eid="MAT 27:2" /></para>
  <para style="s">Ikwu ko Oyahuda</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ishini Oyahuda ni byo ga ra ni mana, aye epwo she mo aba yo Oyesu ngmo ni, obyotu kweyi okwikye we ebe ka awoteyi ka awosapa kpa awanyakwase ka Ase ko Oyahuda. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Owa kamo, &lt;&lt;Nyyo ozalabi koni nyya ase ni yo ozalabi lo ni yi kwu dala ko yo ngmo ni.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Akamo, &lt;&lt;Akakaha wo onya ke? Oni we ela wo la.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Ebeni Oyahuda yi ikwiri yi ta go ole ko Owuso. Bwebeni obose gese ga yogwa tiyinu piso kweyi ogekwu.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Awoteyi ka awosapa yi kwiri oni yi bize kweyi kamo, &lt;&lt;Oya shoshi ko yi ikwiri mani yi ta akpokyo ole ko Owuso lo, koni ikwiri mani wi ikwiri ko oyi la.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Aga gbela ko oza ni aba ya kpi ikwiri oni mo ana ro okpagye koni aba nyo ogboga anu ni. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Oza ni yani, aba ye ebeni ogwu kwikyikye ni mo, okpagye ko oyi ni oma. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Ogbodagye mani byoni inobane Irimiya kani mo, &lt;&lt;Ebeni aza azurupa okpaku aweta ni ase ka Ase ko Izrayila kyogwu mo ana sore ikweyi nu ni oma, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />kweyi ake re ebe ko nyo ogboga, byoni Adole ka dami ni.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Oyesu obutu ko Obilatus</para>
  <para style="r">(<ref loc="MRK 15:2-5">oMak 15.2-5</ref>; <ref loc="LUK 23:3-5">oLuka 23.3-5</ref>; <ref loc="JHN 18:33-38">Oyohana 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Ishini Oyesu hagye obutu ko Obilatus ogbolamaga ko Oroma ni. Ogbolamaga do okamo, &lt;&lt;Awo pini wo ose ka awoyahuda la?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Oyesu kamo, &lt;&lt;Ole mani byoni oka ni.&gt;&gt; <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ishini awoteyi ka awosapa kpa awanyakwase ko ogya ko okame to Oyesu ni, oke ko ojije lo, <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Ebeni Obilatus ka do Oyesu mo, &lt;&lt;Oya pwo oza ni aba ka ikweyi wo ni lo? <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Oyesu ke kojije lo. Ebeni igbashi yo ogbolamaga kwu.<verse eid="MAT 27:14" /></para>
  <para style="s1">Agbela ko yo Oyesu ngmo</para>
  <para style="r">(<ref loc="MRK 15:6-15">oMak 15.6-15</ref>; <ref loc="LUK 23:13-25">oLuka 23.13-25</ref>; Oyohana 18.39-19.16)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ishi ki Imya ko Sheyi, owodu shini ogbolamaga na yashe ni ewa ka asuse ba yimu ni ngma shoruduru. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ipu ki ishi oni, agbo oyi koruduru oye ni ananoho gyo aba yoogwu mo Obaraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Ishini ewa ka asuse gbayi ni, Obilatus duwo okamo, &lt;&lt;Anoho ni ala ba yimu shini na shobita da ala, Obaraba kwe Oyesu ni aba yo mo Okristi ni?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ogye neneshi mo ipu ka anya yoya pini ayo Oyesu kwu wa danu la.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Ni Obilatus yagye ebe ko kepwo ni, onya nu toleho webe nu mo, &lt;&lt;Ngma abo wo shepwo kongo mani koni owa aseneshi la, nmowe ko okwokwoshi ipu ka ana otu hin bya kotata ikyeni ikweyi nu.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ebeni awoteyi ka awosapa kpa awanyakwase ke kpuwo okwunu mo, ana sho Obaraba bita, ana yo Oyesu ngmo.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Ogbolamaga duwo oka mo, &lt;&lt;Anoho ipu kawase epa mani ni ala ba yimu shini na shobita?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Akamo, &lt;&lt;Obaraba!&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Ebeni Obilatus duwo okamo, &lt;Naya moji kpo Oyesu ni aba yo ogwu mo Okristi ni?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Kpiri wa kyogwu mo, &lt;&lt;Ana yo poshi!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Obilatus duwo okamo, &lt;&lt;Ojiya, Obibi koji ni oya?&gt;&gt; Lewa kase ngmegba nwa ba kamo, &lt;&lt;Ana yo poshi!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ni Obilatus mamo oya gege ko yo ojije kelo ni, lewa ka asuse kwotu ko shawa, oshi inyo kweyi na abo obutu wa kweyi kamo. &lt;&lt;Abo hin ye ese, oyi nu yikweyi kala!&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Kpiri ke ewa kamo, &lt;&lt;Oyi nu na yikweyi ka aha kpa ayi ka aha!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Ebeni Obilatus sho Obaraba bita da awa. Oyesu ke, oma awadakare na ya aboshi, kweyi ana byo ga poshi sepa.<verse eid="MAT 27:26" /></para>
  <para style="s1">Adakare yo Oyesu Ebe</para>
  <para style="r">(<ref loc="MRK 15:16-20">oMak 15.16-20</ref>; <ref loc="JHN 19:2-3">Oyohana 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Ebeni ashishini ka adakare ko byo Oyesu gipu ki ikpakyo kole ko ogbolamaga kweyi ya awadakare shishini wa shogba to. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ayo oshiye ngma kweyi ayo obagidi ko ose yi shi ikpiye. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ebeni agweka kigye, kweyi ayi likweyi. Ayo okposhi ko ose yi la abore, kweyi akwagye obutu nu ba ye ebe ba kamo, &lt;&lt;Abaga edu, Ose ko Ase ko Oyahuda!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Kweyi aki tehe sho, ayo okposhi ko ose bize kweyi ba gwi ikweyi. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ishini aye ebe kweyi ni, ayo obagidi ko ose ngma sho oko kweyi ayo oshiye nu yi shi ikpiye. Kweyi apyanu tohobu ge ebe ko yo poshi.<figure style="fig" alt="Crown of the Thorns" file="cn01828B.tif" size="col" loc="Omt 27.31" copy="Cook" ref="27.27-31">Agweka ki Igye lo Oyesu Ikweyi</figure><verse eid="MAT 27:31" /></para>
  <para style="s">Ayo Oyesu poshi sepa</para>
  <para style="r">(<ref loc="MRK 15:21-32">oMak 15.21-32</ref>; <ref loc="LUK 23:26-43">oLuka 23.26-43</ref>; <ref loc="JHN 19:17-27">Oyohana 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Ishini abyo ba ge ebe ko yo poshi sepa ni, agbayi kpo ongo oye bwo Osayirin, iyenu wo Osimo, abyo ko otiri mo ona zo oshi ko Oyesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Ni afebeni aba yogu mo Ogolgota, ni ase nu wo okpokwu ki ikweyi. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ebeni ado Oyesu inyi kpo oje lono mo ona gwa, ishini oma mani ni, otanu ko ogwa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Ishini ayo poshi sepa ni, ayo oshiye nu yiko diyiwa bwe ebe ke ebawowo. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Abagye, kweyi ba gbeho nu. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Iso ki ikweyi nu ato oza ni akamo oya ni ayo poshi ni mo: Omani wo Oyesu, Ose kawase ko Oyahuda. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Aya awowi epa yi poshi kpanu, oye abore nu, oye aboshe nu. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Awo shigbo ba ji ikweyi kweyi aba ye ebe ba sesa mo, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />awo ni kamo, &lt;&lt;Oya yo Ole ko Owuso ya kye kweyi ya kyanu ya ma ipu kene eta ni, ngmi iyo! Sa bwo oshi wo okpagye, owoni owo Oyi ko Owuso!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Mamani awoteyi ka awosapa, kpa awofono kpa awanyakwase ba ye ebe. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Aba kamo, &lt;&lt;Ongma ase shishini, oke gege ko ngmi iyinu lo. Anu pini wo Ose ki Izrayila la! Ona sa bwo oshi wo okpagye, kweyi ahan yo otuso. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ototuso Owuso. Owuso nawa ngma anu, owoni oya yimu nu! Koni okamo, &lt;Nwwo Oyi ko Owuso la ni.&gt;&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mamani awowi ni ayuwa poshi kpanu dudu ni ki seesa.<verse eid="MAT 27:44" /></para>
  <para style="s1">Ikwu ko Oyesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">oMak 15.33-41</ref>; <ref loc="LUK 23:44-49">oLuka 23.44-49</ref>; <ref loc="JHN 19:28-30">Oyohana 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Bwi isheno go ogye eta, kpiri ke ebe dibu okpagye ni. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Abo ko ogye eta, Oyesu kela kpo oko nwa ya kamo, &lt;&lt;Eloi, Eloi, lama sabatani?&gt;&gt; ikweyi nu wo, &lt;&lt;Owuso hin, Owuso hin, ojiyo pyitikpi tun?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ishini ashishini kase ni hagye ebeni pwo oza ni oya kani, akamo, &lt;&lt;Ongo mani ya yi Iliya ogwu la.&gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Ebebeni ashe ipu wa nyinya ga za akasa. Oyi linyi, kweyi yi lo okposhi, odo Oyesu mo ona gwa. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ashishini wa kamo, &lt;&lt;Nabani ahan shobita shini ahan ma kwe Iliya yawa ngma anu.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Kweyi ishini Oyesu kyegba kpo oko nwa ni, ozo Owushoshu nu.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ishi oni ayikyi ni yipu ko Ole ko Owuso ni ko we epa bwi iso wo okpagye. Okpagye ja kweyi ikyikpo kya. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Amiri gwa kweyi awase neshi ni gekwu ni nyiso bwa amiri wa. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Abose bwa amiri, ishini Oyesu nyiso amiri ni, agi ipu ko ogya neshi, kweyi ase nwashika muwa.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ishini oteyi ka adakare kpa awase ni ba gbeho ko Oyesu mo okpagye ja kpo oza ni gbodagye ni, oshi yuwa kwu, kweyi akamo, &lt;&lt;Ko okwokwoshi, anu mani wo Oyi ko Owuso la!&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Anya nwashika be ebeni, aha gye ebe lenu. Agboso Oyesu bwo Ogalili kweyi ba ta abo. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ipu wa wo Omeremu bwo Omagdalin, kpo Omeremu ene ko Oyakubu kpo Isu kpe ene ka ayi ko Ozebedi.<verse eid="MAT 27:56" /></para>
  <para style="s">Ayo Oyesu yi nyi</para>
  <para style="r">(<ref loc="MRK 15:42-47">oMak 15.42-47</ref>; <ref loc="LUK 23:50-56">oLuka 23.50-56</ref>; <ref loc="JHN 19:38-42">Oyohana 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ni eno ya sha ni, olodu oye bwo Arimatiya wa, iye nu wo Isu, ni wo oye ipu ka awo gboso Oyesu ni, <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Oge ebe ko Obilatus, ga doka ko okwu ko Oyesu, Obilatus zo okwunu mo ana yo okwu ko Oyesu danu. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Isu yo okwu ko Oyesu sa wo okpagye, kweyi gwa agya kpo opa nehe, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />kweyi oyo tagye ipu ka amiri nu ni obwu pepe ipu ki ikyikpo ni, oji ikyikpo nyakwu wayi ko okwunu ka amiri yigwu kweyi ganu. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Omeremu bwo Omagadaliya kpo Omeremu oye ni, bagye pi iyi ta amiri.<verse eid="MAT 27:61" /></para>
  <para style="s">Adakare ba gbeho ka Amiri</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Gbe ebenya ni we Eno ko Minyo ni, awoteyi ka awosapa kpa ashishini ka Awofarisi ge ebe ko Obilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Aga kamo, &lt;&lt;Adole! Aha ra, ishini ino gya ase egya mani tayayo yi iyi ni okamo, &lt;Itikpi ke ene eta nyya nyiso. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Zo oko shini ana ga gbeho ka amiri nu ke ene eta. Lalo, awogboso baga yo okwu nu ya wi kweyi aba ka da ase mo onyiso amiri. Lalo, egya ki itikpi mani wa labi ya sha akikyikyo.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Obilatus kamo, &lt;&lt;Ala ga kpa adakare, ana ga gbeho ka amiri nu neneshi.&gt;&gt;<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Ebeni akpa adakare ga gbeho ka amiri nu neneshi. Kweyi gwenena ikweyi ki ikyikpo ni.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Oyesu nyiso amiri</para>
  <para style="r">(<ref loc="MRK 16:1-8">oMak 16.1-8</ref>; <ref loc="LUK 24:1-12">oLuka 24.1-12</ref>; <ref loc="JHN 20:1-10">Oyohana 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Itikpi ke Eno ko Minyo, otukpokyi ke eno ko ginyi, Omeremu Omagdalin kpo Omeremu oye ni gebe ko ma amiri. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Okpagye ja ko otata, kweyi oyoleho ka Adole sa bwi iso wo okpagye kweyi wa gebe ka amiri, yi kyikpo bize, kweyi yagye ikweyi nu. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Oya yu byo ola ka akpula, oshiye nu nehe yayu byo omowu ni. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Oshi nu ya awadakare ni kwu kweyi ashekwu. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Ebeni oyoleho ni ka da anya ni mo, &lt;&lt;Alaka yoshi lo, ngye mo, ala ba tikpo ko Oyesu ni ayo poshi ni la. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Oye ebe ni kelo, onyiso nu byoni oka ni. Ala wa ga mebe ni ogwutagye ni. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ala ga papa, shini ala ga ka da awogboso mo, &lt;Onyiso amiri kweyi yo ohobu kala ya go Ogalili oma. Ebeni ala ba ga mo.&gt; Nka dala oma.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Anya ni nyinya papa bwebe ka amiri, kpo oshi ki shotunehe kweyi ga ka da awogboso. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ebeni Oyesu abiyinu gbayi kpawa. Otuwogbogba mo &lt;&lt;Ala nngmagye.&gt;&gt; Awebe nu wa bi ikpo kweyi geyagye danu. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Oyesu ka dawa mo, &lt;&lt;Ala ka yoshi lo. Ala ga ka da ayene hin mo ana go Ogalili, ebeni aba ga mun.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s1">Awadakare wa kyoleho</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ishini anya bowe ba gani, ashishini ka adakare gipu ko ogya ebe ka awoteyi ka awosapa ga ko oza ni gbodagye kpiri ni dawa. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Ishini awoteyi ka awosapa kpa awanyakwase ga gbayi ni, agbela kweyi ada awadakare ikwiri nwashika, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />kweyi ka dawa mo, &lt;&lt;Ala ga kamo, &lt;Awogboso wa otu wayo okwu nu yi wi ishini ala ba gbo ola ni.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Owoni oshu mani gobutu ko ogbolamaga, aha ba bo shini na sha ala bita.&gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Awadakare zi ikwiri kweyi gaya byoni aka dawa ni. Mani oni oshu mani gyehe tipu kawase ko Oyahuda kwikyikyeni.<verse eid="MAT 28:15" /></para>
  <para style="s1">Oko ni Oyesu da awogboso ni</para>
  <para style="r">(<ref loc="MRK 16:14-18">oMak 16.14-18</ref>; <ref loc="LUK 24:36-49">oLuka 24.36-49</ref>; <ref loc="JHN 20:19-23">Oyohana 20.19-23</ref>; Oko 1.6-8)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Ebeni awogboso igwoye ni go Ogalili, agikweyi ke efu ni Oyesu ka dawa mo ana ga ni. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ishini amo ni, ageyagye danu; ashishini wa ke ikpiye wa kpo kpanu lo. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Oyesu webe wa kweyi wa kamo &lt;&lt;Kpiri ko oshu ki iso kpo okpagye ayi dami la. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Ni olemani, ala ga ya ase kese mani kpiri na wa awo gbosun, ala ga yuwo obatisma ipu ki iye ka Ada kpa ko Oyi, kpa ko Omaku ko Owuso, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />kweyi ala fuwoza ni nka dala kpiri ni. Ko kwokwoshi, nyyo kpala kpiri ki ishi, go okweyi kese mani.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>