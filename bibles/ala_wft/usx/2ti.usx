<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Alago Bible Translation Project</book>
  <para style="h">2 Otimoti</para>
  <para style="toc1">Okpa ko Obulus komwepa do Otimoti</para>
  <para style="toc2">2 Otimoti</para>
  <para style="toc3">2 Otm</para>
  <para style="mt2">Okpa ko Obulus komwepa do</para>
  <para style="mt1">Otimoti</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Okpa mani bwebe hin Obulus oyikoko ko Okristi Oyesu ni Owuso shun ko ka dawo ikweyi ko olayi ko okoyi ni agbo ebe kema kaha kpo Okristi Oyesu ni.<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />Gebe ko oyi hin moshi, Otimoti:</para>
  <para style="p" vid="2TI 1:2">Owuso Ada kpo Okristi Oyesu Adole kaha na dawo oneshi nu, kpi iyinyinyi, kpo omene.<verse eid="2TI 1:2" /></para>
  <para style="s1">Otunehe do Owuso kpo Otugbagba</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Nshotunehe do Owuso, ni nyya yoko danu kpotu hin oye ni, byoni awokyikyi hin ya ni. Nshotunehe danu ishi kpiri ni nyya rela wo ipu kinarigwu hin ke eno kotu. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Nrela kegba ni okye ni kweyi nyya yimu komo, shini otu hin na sha. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />Nrela kotuse kokwokwoshi ni ogbo ni, edo kotuse ni obo wo ko Oloyis kpe ene wo ko Oyunisi gbo ni. Ngye mo ogbe edo kotuse oni. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Ni olemani, nyya rawo mo yabo byeshi ni Owuso dawo ishini nyya abo hin so ni. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Koni Owuso daha Omaku ko yoshi la lo. Omaku nu ke ya daha oshu, kpimu kpo kwiyi ka.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Ka yiweyi ko yolobene ka Adole ka, kwe ami ni ayun shetu ikweyi ko Okristi ni lo. Nke ya kamo gipu ko owe moma kpami ikweyi ko koshu neshi, ni Owuso dawo oshu ikweyi nu ni. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Ongmaha kweyi yahogwu shini an wa ase nu, wela koza ni aha ya ni la lo, ke wela ko gbogbo kotu nu kpo oneshi nu. Odaha eshi mani bwebe ko Okristi Oyesu ome ona yese, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Owuso ke sayi daha bwebe kowowa kino ngmaha, Okristi Oyesu. Oyoshu kikwu kyigbo kweyi bwebe koshu neshi odaha olayi ko gbogbo-gbogbo.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Owuso shun woyikoko ko Oyesu kpi inofoza ko tono koshu neshi, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />ikweyi koni pini nyya mowe mani la. Ami ke ikpiye hin ya loshu, ikweyi koni ngyase ni nyyo otuso ni, kweyi ngye mo oya gege ko gbeho koza ni oyi dami abo ni gbe Eno oni.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Byela ko kwokwoshi ni nfo ni pya, na woza ni oya doye ni, kweyi hagye loshu ipu kotuse kpimu yoya ni wakaka ipu ko Okristi Oyesu ni. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Bwebe ko oshu ko Omaku ko Owuso ni yo kpaha ni, gohobu ko yoza neshi ni ayi dawo abo ni.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Ogye kamo ananoho ipu kokpagye ka Asiya shun bita, ko Ofigelus, ko Ohamogenes.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Adole na miyinyinyi kipwoma ko Onesiforus, ikweyi koni otumotugbagba ishi nwashika. Oyiweyi ikweyi koni nyyo oruduru ni lo, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />ni oke sa okpagye ko Oroma ni, okwotu ko tikpo hin gbishini owa yun pye. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Adole na miyinyinyi nu Eno oni! Awo gyedo ko oza ni oya dami neneshi ishi ni nyye Efesu ni.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Adakare Neshi ko Okristi Oyesu</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Awo oyi hin, loshu bwebe keshi ni wakaka ipu kema kaha kpo Okristi Oyesu ni. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Zoza fofu ni omun ya fu iyi ka awolobene nwashika ni, gayi nabo dawase ni ba yo otusuwa, ni ba gege ko fase ashini oza mamani.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Zotu kpowe moma wo byoni owadakare neshi ko Okristi Oyesu ni. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Adakare ni yo ogo kefu ni ya yimu ko yoza ni shadole nu otu ni, mani oni oya byiyinu gipu koko kase ashini lo. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Mamani, ino myenya ni ya nyinya, oya gege ya rogwa lo owoni oyoko kpono kawo omyenya lalo. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Osheho ni gbotu ko yoko ona wa kikyikyo ko hizire keho nu. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Rela koza ni nyya ka mani, ikweyi koni Adole ya yo ya gyikweyi nu kpiri.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Rela ko Oyesu Okristi, ni nyiso bwikwu ni, obwipwoma ko Odawuda, byoni nfu ipu ko Oshu Neshi ni ntono ni. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Ikweyi koni ntono ko Oshu Neshi ni, nmowe gbishini ashuma ashirika byo owi. Ake shela ko Owuso ashirika lo, <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />mani oni nzotu kpojoji ela kawase ni Owuso shu ni, shini awa na ki pyolayi ipu ko Okristi Oyesu kweyi byigyashi nu kogbogbo-gbogbo.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Ela mani wo kwokwoshi:</para>
  <para style="q1" vid="2TI 2:11">&lt;&lt;Owoni aha gekwu kpanu,</para>
  <para style="q2" vid="2TI 2:11">aha ki ba gbo olayi kpanu.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Owoni aha gohobu ko zotu,</para>
  <para style="q2" vid="2TI 2:12">aha ki ba wa rose kpanu.</para>
  <para style="q1" vid="2TI 2:12">Owoni aha tawashu nu,</para>
  <para style="q2" vid="2TI 2:12">anu ya tawashu ikweyi kaha mamani;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Owoni aha gbo okwokwoshi lo,</para>
  <para style="q2" vid="2TI 2:13">anu wine kokwokwoshi,</para>
  <para style="q2" vid="2TI 2:13">ikweyi koni Okristi ya gege ya tawashu kiyinu lo.&gt;&gt;<verse eid="2TI 2:13" /></para>
  <para style="s1">Inoyoko Neshi</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Rawase wo awoza mani, pyuwakpaha kotata obutu ko Owuso shini ana ka tawashu ko okwunu lo. Oni ya byoneshi oyoye yawa lo, oke ya yawase ni ba pwo ni yishi kin la. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Takirikwu shini opyabokpa obutu ko Owuso; byino yoko ni ya yiweyi koko nu lo, ni ya fase ela kokwokwoshi gyogye ni. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Ka rema kawo kela sususu lo, edo kela mani ya yase ko kpo Owuso. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Koni oza fofu wa ya lema bya akrigya ni ya homu ki ikpiye ni la. Ipu wa asepa ni ba foza mani wo Ohimenayus kpo Ofiletus. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Ashowe kokwokwoshi bita kweyi ba yo otuse kase ashini yishi baka mo onyiso kawase ni gekwu ni kwobonu gbodagye wa. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />Omani ke yotu ko oda ni Owuso ma ni ojije lo; ikweyi nu ata mo, &lt;&lt;Adole gya awase ni wa akakanu ni&gt;&gt; kweyi &lt;&lt;Kpiri kase ni manu wa ka Adole ona sho ozalabi ko yoya bita.&gt;&gt;<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Ipu kole nyakwu ogo kpo owatu nwashika banu: ashishi aya kpo azurupa ashini kpo ozinariya, ashini agbogba kpe efu, ashini ama kpo ome; ashini wa ko oko neshi, ashini wa ko oko neshi lo. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Ase ni yi iyinu na neshi shoza bibi, aba yoko kpa anu ko oko neshi, ikweyi koni owiyinu shu da adole nu, ya gbeyi ko yoko neshi wonyonya.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Nyinya shi imoza ni ya mayileke ma ni, kweyi tikpo ko wase neshi, ko gbotuse, ko yimu kase, kweyi yagye ko omene, kpa awase ni ba shogwu ya Adole kpo otu oye ni. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Ishini awikyo ba tawashu ikweyi koza ni gbo oko ko ojije lo ni, ka gipu wa lo, ikweyi koni ogye mo oya byapwo wa. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Oyole ka Adole naka wino gbapwo lo, ona ke gbo otumene kpa nanoho, na gishi ko fase oza, ona zotu, <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />awase ni ba tawashu kpanu ni ona kyawatu ipu koko mene, kwe Owuso ya dawa ishi ko shagbotu, shini ana gyo kwokwoshi. <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />Shini ana kwikye wiyiwa shini ana bose she eda ki biri, ni oyuwa shetu koyoza ni oya yimu ni.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Eno ko Okweyi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Ra kamo eno ko kweyi, oza ya labi kotata da ase. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Asuse ba wawo yimu ki iyiwa, ba yimu kikwiri, ba zikweyi iso, ba gwabo otu, ba sesa, ba geyagye dase ni muwa ni lo, ba shotunehe dase ni yoza dawa ni lo, kweyi ba gyo Owuso lo; <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />ase ba yase oneshi lo, ba gbi iyinyinyi lo, ba yase ishi, ba yimu ka apwo, ba ngmase, ba yimu ko oza neshi lo; <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />aba rotu kiyiwa, aba yoza waya kweyi ba zikweyi iso, aba yimu ko monye ki ikpiye sho Owuso; <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />aba ya bya agyo Owuso, ake ba tela ko oshu nu. Ala ka rema ke edo ka asuse mani lo. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />Ashishini kase ba bwole-bwole ba gboso anya ni ba kwi iyiwa lo ni kweyi gyuwegya, koni enu ko ozalabi yuwa byi kpi imu ko ozalabi ni, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />anya ni ba takirikwu ko gyoza kwikyikyeni ake gyo okwokwoshi lo. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Byoni Ojanes kpo Ojambres taso Omusa eyi ni, mamani awase mani ba tela kokwokwoshi awase ni otu wa gekwu kweyi agbotuse lo. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Ake ba ge ebe lenu lo, ikweyi koni ananaho ba gye ma awikyo. Byoni ogbodagye kpo Ojanes kpo Ojambres ni.<verse eid="2TI 3:9" /></para>
  <para style="s1">Obulus do Otimoti Ela</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Awo ke kwobonu gboso oza fofu hin, kpoza yoya hin, kpimu yoya hin, kpo otu ko oyagye hin; omo otuse hin, kpo otumene hin, kpi imu yoya hin, kpo ozotu hin, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />ome egye ni nma ni, kpo owe moma hin. Ogyoza kpiri ni gbodagye kpa ami ogya ka Antakiya, kpi Ikoniyo kpo Olistra ni, ogye edo ke egye ni nzotu kpanu ni! Adole ke ngma ami shi ipu nu kpiri. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Kpiri kase ni ya yimu ko yagye neshi ipu ke ema kpo Okristi Oyesu aba danu egye; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />ase bibi kpa awo gyase egya ba gohobu ko yishi kurutu, aba gyase egya, kweyi awa abiyiwa aki ba gyuwegya. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Awo ke, gohobu ipu kokwokwoshi ni afo ni kweyi kyogwu kpanu kpo otu wo oye. Ogya awase ni fo oza ni, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />kweyi ora bwishi ni owo oyi leke ni, ogyo Okpa ko Owuso, ni gege ko dawo oziyi ni byo go ominyo bwebe ko otuse ipu ko Okristi Oyesu. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Ela kpiri ni yo Okpa wela ko Owuso kweyi aba yoko kpanu ko fo okwokwoshi, oya gbase ni yo oza gyogye lo apwo, oya kya ase ni gbepwo ni yatu, kweyi ya fase ela ko yagye neshi, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />shini ase ni ya yoko ko Owuso na gye neshi kweyi pyoshu ko yoko neshi owe wonyonya.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Obutu ko Owuso kpo Okristi Oyesu, ase ni ya kepwo ka awino olayi kpa awase ni gekwu, kweyi oya wa kwikye wa kpogwu ko Ose, nyya ka dala, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />ala ba gege ko tono kela, (kwi ishi gye kwo ogye lo,) ala kpuwokwunu, ala gbuwapwo kweyi tuwotugbabga byoni ala ba fuwoza kpo otumene ni. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Ikweyi koni ishi yawa ba ni ase ba tela koza fofu ko kwokwoshi, kweyi ake ba gboso oza ni otu wa ya yimu ni, aba wa tikpo kawo foza nwashika ko fuwoza ni akpaha wa ya woshosho ko pwo ni. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Aba pyitikpi tela kokwokwoshi kweyi pya akpaha wa ge ebe kawo gbigwu ko kame dawa. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Awo ke gbera kpoza kpiri ni oya ya ni ipu kojoji; zotu kpowe moma, yoko kino tono ko Oshu Neshi, kweyi yoko wo kpiri byo oyole ko Owuso.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Ami ke ishi kwobonu gye wa ni aba yun peshi; ishi yawa koni nyya she ese mani bita ni. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Nkwobonu nonu neshi wa, nyye enya nye kweyi wa, kweyi nbyo otuse hin pya. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Anani abola kase neshi ko Owuso pini ya gbeyi hin la, ni Adole ini kimu, Ino kepwo neshi ya dami Eno ni, ami fufun lalo, kpase kpiri ni ba gbeyi ko bose nu ni.<verse eid="2TI 4:8" /></para>
  <para style="s">Ela Hin kpa Awo</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Takirikwu shini owebe hin papa. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Odemas shawu kimu kese mani opyitikpi tun, kweyi ganu go Otesalonika. Okreses go Ogalatiya, Otitus go Odalmatiya. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Oluka fufunu pini yo kpami la. Yo Omarkus na wa kpawo, shini ona wa tumabo kpoko. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Nto Otukyikwus oleho go Efesu. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Ishini oya wa, byo oshiye hin ni nshibita ebe ko Okarpus ogya ko Otrowas ni wa, ki bya awokpa hin wa dami, ka nwanyi ako okpa kobize oni lo.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Alekzanda ni wo onowa ni yumo ofo nwashika; Adole ya so ore gyogye kpo oza ni oya ni. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Ala gbera kpanu, ikweyi koni ohagye giri yata so ozafofu ka eyi.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Ishini nnyepwo kikyikyo ni, ashishe gwagye tumotu lo; kpiri wa shunbita. Owuso naka kwuwepwo ikweyi nu lo! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Adole Owuso ke hagye kpami kweyi dami oshu, mani oni ntono kela nu dawase ni wase ko Oyahuda lo ni kweyi apwo; ongmami sho okwunu ka abaga. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Adole ngmami shipu ki ibiri kweyi byun gipu ko Obula nu kiso. Igyashi wakakanu ko gbogbo-gbogbo! Nalemani.<verse eid="2TI 4:18" /></para>
  <para style="s">Ogbogba ko Ogwejeji</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />To Oprisila kpa Akwila ogbogba dami kpase kole ko Onesiforus. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erastus hagye Okorentus, nsho Otrofimus bita Omiletus, ikweyi koni oya gbere ni. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Takirikwu shini owa ome owu na bose.</para>
  <para style="p" vid="2TI 4:21">Ewubulus, kpo Opudens, kpo Olinus, kpo Oklawudiya kpa ashini ka ayene kpiri ba talogbogba.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Adole na yo kpo omaku kala.</para>
  <para style="p" vid="2TI 4:22">Eshi ko Owuso na yo kpala kpiri.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>