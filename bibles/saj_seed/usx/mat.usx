<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">NT SAHU MAT CHP.01</book>
  <para style="h">Matius</para>
  <para style="toc3">Mat.</para>
  <para style="toc2">Matius</para>
  <para style="toc1">'A Matius</para>
  <para style="mt1">Habari Roanga</para>
  <para style="mt2">ga'a Matius 'a lefo</para>
  <para style="imt">Demo ma mulaingi</para>
  <para style="ip">Toma Habari Roanga ma dara nena-ne, Matius 'a lefo mangale Yesus 'ai do-doto'o romotoa, re unanga 'a sicapuru reo jarita mangale Yesus 'ai munara ḏi'i.</para>
  <para style="iot">Ma dara:</para>
  <para style="io1">Jarita (balangu 1-4): Sibuoro Yesus re Unanga 'o mulaingi munara.</para>
  <para style="io1">Do-doto'o (balangu 5-7): Yesus doto'o ngowa'a repe toma sau ma re'u.</para>
  <para style="io1">Jarita (Balangu 8:1–9:34): Ga'a hera-heranga gena-ge mangale Yesus sijumu 'ai kuasa.</para>
  <para style="io1">Do-doto'o (Balangu 9:35–11:1): Yesus 'o doto'o 'Ai me-mete'e, wakutu ananga 'aḏi tagi singadolo Habari Roanga.</para>
  <para style="io1">Jarita (Balangu 11:2–12:50): 'Oru ga'a 'i dadi toma daeraha Galilea sitarangi mangale Yesus gena-ge 'O Kristus.</para>
  <para style="io1">Do-doto'o (Balangu 13:1-52): 'Ade-'ade mangale Soroga ma Pareta.</para>
  <para style="io1">Jarita (Balangu 13:53–17:27): Yesus 'ai munara toma gamu-gamu toma daeraha Galilea, re 'Ai munara ma ḏo-ḏogumu toma Galilea.</para>
  <para style="io1">Do-doto'o (balangu 18): Yesus 'o doto'o 'Ai me-mete'e mangale de'oso re ḏegoro ma la.</para>
  <para style="io1">Jarita (Balangu 19-23): Yesus 'o tagi toma limau Yerusalem, osama limau Yerusalem re 'O ma'u sangoro reo Yahudi manga bi-biri'i.</para>
  <para style="io1">Do-doto'o (balangu 24-25): Yesus 'o matakasiri 'oru ga'a 'i dadi toma biono i'a.</para>
  <para style="io1">Jarita (balangu 26-28): Yesus 'ai se-sengene re dadunu 'o 'ahu moju.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Yesus 'ai ete re dotumu manga loma-lomanga</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Toma boku nena-ne, Yesus Kristus ga'a 'Olana Daud 'ai ju'uda re Abraham 'ai ju'uda ḏi'i, Unanga gena-ge 'Ai ete re dotumu manga loma-lomanga 'i silefo so'o ne:<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2-6a" style="v" sid="MAT 1:2-6a" />Abraham: Isak 'ai ḇaḇa</para>
  <para style="li" vid="MAT 1:2-6a">Isak: Yakub 'ai ḇaḇa</para>
  <para style="li" vid="MAT 1:2-6a">Yakub: Yehuda re 'ai ioro re nongoḏu manga ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Yehuda: Peres re 'a Zerah manga ḇaḇa re manga ngina ngo Tamar,</para>
  <para style="li" vid="MAT 1:2-6a">Peres: Hezron 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Hezron: Ram 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Ram: Aminadab 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Aminadab: Nahason 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Nahason: Salmon 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Salmon: Boas 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:2-6a">Boas: Obed 'ai ḇaḇa, Boas 'ai ngina ngo Rahab,</para>
  <para style="li" vid="MAT 1:2-6a">Obed: Isai 'ai ḇaḇa, Obed 'ai ngina ngo Rut,</para>
  <para style="li" vid="MAT 1:2-6a">re Isai: 'Olana Daud 'ai ḇaḇa.<verse eid="MAT 1:2-6a" /></para>
  <para style="p">
    <verse number="6b-11" style="v" sid="MAT 1:6b-11" />Ra 'Olana Daud singadolo ngowa'a Israel sanga upa'a toma Babel, Yesus 'ai ete re dotumu manga loma-lomanga 'i silefo so'o ne:</para>
  <para style="li" vid="MAT 1:6b-11">'Olana Daud: Salomo 'ai ḇaḇa re Salomo 'ai ngina 'a Uria 'ai balo,</para>
  <para style="li" vid="MAT 1:6b-11">Salomo: Rehabeam 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Rehabeam: Abia 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Abia: Asa 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Asa: Yosafat 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Yosafat: Yoram 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Yoram: Uzia 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Uzia: Yotam 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Yotam: Ahas 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Ahas: Hizkia 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Hizkia: Manasye 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Manasye: Amon 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">Amon: Yosia 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:6b-11">re Yosia: Yekhonya re 'ai ioro re nongoḏu manga ḇaḇa. <note caller="-" style="x"><char style="xo" closed="false">1:6b-11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2'Oln. 24:14-15</ref>; <ref loc="2CH 36:10">2Taw. 36:10</ref>; <ref loc="JER 27:20">Yer. 27:20</ref></char></note><verse eid="MAT 1:6b-11" /></para>
  <para style="p">
    <verse number="12-16" style="v" sid="MAT 1:12-16" />Wakutu ngowa'a Israel sanga upa'a toma Babel, singadolo ma 'orasa sibuoro Yesus Kristus, Unanga gena-ge 'Ai ete re dotumu manga loma-lomanga:</para>
  <para style="li" vid="MAT 1:12-16">Yekhonya: Sealtiel 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Sealtiel: Zerubabel 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Zerubabel: Abihud 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Abihud: Elyakin 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Elyakin: Azor 'ai ḇaḇa</para>
  <para style="li" vid="MAT 1:12-16">Azur: Zadok 'ai ḇaḇa</para>
  <para style="li" vid="MAT 1:12-16">Zadok: Akhim 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Akhim: Eliud 'ai ḇaḇa</para>
  <para style="li" vid="MAT 1:12-16">Eliud: Eleazar 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Eleazar: Matan 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">Matan: Yakub 'ai ḇaḇa,</para>
  <para style="li" vid="MAT 1:12-16">re Yakub: Yusuf 'ai ḇaḇa, re unanga ngo Maria 'ami nau'u. Re ngo Maria gena-ge ga'a sibuoro 'a Yesus, ga'a si'aro'o 'O Kristus.<verse eid="MAT 1:12-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Dadi ra Abraham singadolo ra 'Olana Daud, mo-moini nani nyagi moi re rata. Ra 'Olana Daud singadolo ngowa'a Israel sanga upa'a toma Babel, nani nyagi moi re rata ḏi'i. Toma wakutu ngowa'a Israel sanga upa'a toma Babel, singadolo sibuoro 'O Kristus, nani nyagi moi re rata.<verse eid="MAT 1:17" /></para>
  <para style="s">Sibuoro 'a Yesus</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Sibuoro 'a Yesus Kristus ma jarita so'o ne: Yesus 'ai ngina ga'a 'ami lomanga ngo Maria, munanga Yusuf 'ai ga-ganau. Mada'a wakutu ananga 'aḏi ma'u molo'ara nyangu, ngo Maria 'ami po'olo ri tegoro sababu Ma Ngagara 'Ofi-'Ofi ma kuasa.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">Luk. 1:27</ref></char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusuf, ngo Maria 'ami ga-ganu, sababu unanga ngowa'a loasa re banari 'o mau 'a sito-tola'a ananga nga muḏiḏi, mada'a unanga mi simara'a Maria ua toma mandan. Dadi unanga 'o sitantukanga 'a'a so'o gena-ge 'a siogo-ogoro. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Wakutu 'a Yusuf 'o matakasiri hali gena-ge, unanga 'o nanele. Tai nanele ma dara, unanga 'o oḏi'i Ma Jou'ongu Madutu 'ai mala'ekata matengo ga'a 'o kanau ra unanga ma betongo so'o ne: &lt;&lt;Yusuf, 'Olana Daud 'ai ju'uda<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u</char></note>, mojongo awa molo'ara ngo Maria, sababu 'ami la'ekata tami po'olo gena-ge ma dara 'i dadi mete'e Ma Ngagara 'Ofi-'Ofi ma kuasa. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Maria ḏuanga i'a mo sibuoro ngowa nau'u matengo. Ngowa kiau gena-ge ngana balasu no silomanga 'a Yesus, sababu Unanga nena-ne ḏuanga i'a 'O sisalamata 'Ai ngowa-ngowa'a tamanga ḏosa.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fk" closed="false">Yesus </char><char style="ft" closed="false">ma ngale: Ma Jou 'o sisalamata ngowa'a.</char></note> <note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">Luk. 1:31</ref></char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Mo-moini gena-ge 'i dadi so'o gena di'a sitotomo 'oru ga'a Ma Jou'ongu Madutu 'ai nabi-nabi raḏi kanau pasala ḏua so'o ne: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“We-were'a matengo mo waro nau'u nyangu, ḏuanga i'a 'ami po'olo tegoro, re mo sibuoro ngowa nau'u matengo. Ngowa kiau gena-ge ḏuanga i'a silomanga Imanuel” -- ga'a ma ngale: Ma Jou'ongu Madutu mamete'e ra ngene.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Yes. 7:14</ref></char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Wakutu 'a Yusuf 'o momi'i, unanga 'a si'a'a mete'e sa'olo mala'ekata 'o kanau ra unanga. Dadi unanga 'o molo'ara ngo Maria. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Mada'a ngo Maria mo sibuoro 'ami ngowa nau'u gena-ge nyangu, 'a Yusuf so'o mi dongotu i'a ua.<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">toma demo Sahu ma siḏa so'o ne: so'o mi lofo i'a ua.</char></note> Re wakutu munanga mo sibuoro ngowa nau'u gena-ge, Yusuf 'o silomanga Unanga Yesus.<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">Luk. 2:21</ref></char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Ngowa'a Majus da'a wangere ma la'o ino</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Wakutu sibuoro Yesus toma limau Betlehem toma daeraha Yudea, Herodes 'o dadi 'olana. Sibuoro Yesus pasala i'a, ngowa'a Majus nga muḏuo i'a 'aḏi sapolo da'a wangere ma la'o ino toma limau Yerusalem. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Ananga 'aḏi masano-sano, “Ngowa'a matengo Unanga le'a Yahudi manga 'olana ga'a ro sibuoro? Ngomi mi oḏi'i mumuḏungu toma wangere ma la'o. Enanga gena-ge 'i dadi nana'o rimoi mangale sibuoro 'Olana matengo. Sababu gena-ge, ngomi mi sapolo di'a mi silamo'o re siḏubuso Unanga.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Wakutu 'Olana Herodes 'a 'isene habari gena-ge unanga 'ai 'akala re sinyingara 'i kangela masala. So'o gena ḏi'i ngowa'a mo-moini ḏi'i toma limau Yerusalem. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Dadi Unanga 'o soma'a mo-moini 'imam-'imam ma sae'e re guru-guru 'agama, ananga 'aḏi malomu. Ḏua unanga 'o sano ra ananga, “Toma ngi'i le'a ḏuanga i'a sibuoro 'O Kristus<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">bolo </char><char style="bd">'O Mesias </char></note> ga'a Ma Jou'ongu Madutu ro sijaji?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Ananga ya sangoro, “Toma gamu Betlehem toma daeraha Yudea. Sababu nabi matengo ra silefo so'o nena-ne:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Hei ngowa'a Betlehem toma daeraha Yehuda.</para>
  <para style="q2" vid="MAT 2:6">Kalaha ngini ninga gamu ga'a 'i ceka'a, ḏuanga i'a 'i dadi gamu ma lamo'o,</para>
  <para style="q1" vid="MAT 2:6">sababu taninga sigolona ie baolo pareta ma bi-biri'i</para>
  <para style="q2" vid="MAT 2:6">ga'a sibi-biri'i 'Ari 'umata Israel.’ ”<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:1">Mi. 5:1</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Wakutu 'Olana Herodes 'a 'isene ma demo-demo gena-ge, unanga 'o 'aro'o ngowa'a Majus sigogoro. Re unanga 'o sano ananga gena-ge mangale 'au ngau ananga 'aḏi oḏi'i ma mulaingi mumuḏungu. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Gena ḏua, unanga 'o soma'a ananga 'aḏi tagi toma gamu Betlehem re 'o bererongo, “Ni tagi, re ni disa waro mode-mode'e ngowa 'olo gena-ge. Wakutu ngini ni sanga Unanga gena-ge, ni ḏibo re ni siajele ngoi, la ngoi ḏi'i to sapolo di'a to silamo'o re siḏubuso Unanga.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10" />Dadi, ngowa'a Majus gena-ge 'aḏi tagi. Tamanga ḏo-ḏagi toma gamu Betlehem, ananga 'aḏi oḏi'i ḏi'i mumuḏungu ga'a ananga ya oḏi'i toma wangere ma la'o pasala ḏua. Ananga manga 'akala re sinyingara 'i roanga masala, sababu ya oḏi'i mumuḏungu ḏi'i gena-ge! Mumuḏungu gena-ge 'i tagi tamanga biono, singadolo 'i togumu toma wala ma re'u ga'a 'age ngowa 'olo gena-ge 'ai ngi'i. <verse eid="MAT 2:9-10" /><verse number="11" style="v" sid="MAT 2:11" />Wakutu ananga 'aḏi osama toma wala ma dara, ananga 'aḏi oḏi'i Unanga gena-ge Rai ngina ngo Maria. Re ananga 'aḏi mapagara manga biono tala re silamo'o re siḏubuso Unanga. Gena ḏua, ananga ya welanga manga harata ma burua, re ya pula'a manga bu-bula'a ra Unanga. Manga bu-bula'a guraci, manyanyi, re mur.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">Manyanyi</char><char style="ft" closed="false">: dupa ma ijana lai hali, 'oro toma ate ino. </char><char style="fk" closed="false">Mur </char><char style="ft" closed="false">gena-ge 'oro toma ate ma da-daiti ga'a ri dudungu, ma bounu lai sa'i.</char></note> <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Tamanga nanele ma dara, Ma Jou'ongu Madutu 'o sipo-poma ra ananga, la 'aḏi ḏibo ma'u sanga rawara ra 'Olana Herodes. Dadi ngowa'a Majus gena-ge 'aḏi ḏibo malalo'o mete'e ngo'omo lelegu.<verse eid="MAT 2:12" /></para>
  <para style="s">Masilalo'o toma daeraha Mesir</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Wakutu ngowa'a Majus 'aḏi maḏibo pasala i'a, Ma Jou'ongu Madutu 'ai mala'ekata 'o waiti ra Yusuf tai nanele ma dara re 'o kanau so'o ne: “Yusuf! 'Olana Herodes 'o disa ngowa 'olo di'a 'o sisengene Unanga. Sababu gena-ge, momi'i re no tagi, gasa ngowa 'olo gena-ge re 'Ai ngina, re ni masilalo'o toma nagara Mesir. Tegoro 'age singadolo ḏuanga i'a Ngoi dadunu tini siajele ni maḏibo.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Gena ḏua, Yusuf 'o momi'i re 'o siwangolo ananga, kara utu gena-ge unanga 'o gasa ngowa 'olo re ma ngina ngo Maria, ananga 'aḏi tagi toma Mesir. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Ananga 'aḏi tegoro toma Mesir singadolo 'Olana Herodes 'o sengene, kara 'aḏi maḏibo ino. Gena-ge 'i sitotomo 'oru ga'a Ma Jou'ongu Madutu 'o kanau pasala ḏua Tai nabi-nabi so'o ne: “Ngoi ta 'aro'o 'Ari Ngowa'a Nau'u da'a Mesir ino.”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos. 11:1</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">'Olana Herodes 'o soma'a sisengene ngowa 'olo na-nau'u</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Wakutu Herodes 'a waro ngowa'a Majus 'aḏi sihaga unanga, unanga 'o ruta lai siḏi. Dadi unanga 'o soma'a sisengene mo-moini ngowa 'olo na-nau'u ga'a manga 'umuru musungu romoḏiḏi re tuwaḏi toma gamu Betlehem re daeraha ma sebanga. 'Umuru gena-ge Herodes 'a roimi mete'e ngowa'a Majus 'aḏi oḏi'i mumuḏungu ma mulaingi gena-ge re sino. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Dadi gena-ge 'i sitotomo 'oru ga'a nabi Yeremia 'a kanau pasala ḏua:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Toma gamu Rama ngowa'a matengo ma rerese ma gaḏi,</para>
  <para style="q1" vid="MAT 2:18">gena-ge ngo Rahel, munanga mo sigaḏi betongo 'ami ngowa-ngowa'a</para>
  <para style="q2" vid="MAT 2:18">re mo oḏu'u ngowa'a mi sisanangi 'ami 'akala re sinyingara,</para>
  <para style="q1" vid="MAT 2:18">sababu 'ami ngowa-ngowa'a raḏi cua.”<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Yer. 31:15</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">Maḏibo da'a Mesir ino</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Wakutu Yusuf, Maria re Yesus toma Mesir moju, 'Olana Herodes 'o sengene. Gena ḏua, Ma Jou'ongu Madutu 'ai mala'ekata matengo 'o waiti ra Yusuf tai nanele ma dara. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Mala'ekata gena-ge 'o kanau so'o ne: “Ngowa-ngowa'a ga'a disa di'a sisengene ngowa 'olo, ananga gena-ge raḏi sengene. Sababu gena-ge, momi'i re no tagi, gasa ngowa 'olo gena-ge re ma ngina, ngini ni maḏibo toma Israel.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Dadi 'a Yusuf 'o momi'i re ya'u gasa ngowa 'olo re ma ngina, re ananga 'aḏi maḏibo toma Israel.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Mada'a pasala i'a Yusuf 'o 'isene Arkhelaus,<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Oḏi'i </char><char style="fk" closed="false">Arkhelaus </char><char style="ft" closed="false">toma kamus.</char></note> 'Olana Herodes 'ai ngowa'a nau'u, unanga ro ngali 'ai ḇaḇa sa'olo 'olana toma daeraha Yudea, 'a Yusuf 'o mojongo sapolo i'a toma daeraha gena-ge. Ḏua, Ma Jou'ongu Madutu 'ai mala'ekata 'o sipo-poma Yusuf tai nanele, la ananga 'aḏi tagi re tegoro toma daeraha Galilea. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />I'a da'a, Yusuf 'o tegoro toma limau ga'a ma lomanga Nazaret. Dadi 'oru ga'a nabi-nabi ya siajele pasala ḏua mangale ngowa 'olo gena-ge 'i sitotomo: “Unanga, ngowa'a 'U si'aro'o Ngowa'a Nazaret.”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">Mrk. 1:24</ref>; <ref loc="LUK 2:39">Luk. 2:39</ref>; <ref loc="JHN 1:45">Yoh. 1:45</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Bobita ra Yohanes tukanga baptis</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mrk. 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk. 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Palisi'i musungu muḏuo i'a Yohanes tukanga baptis 'o sapolo toma daeraha Yudea toma daeraha baulaco re 'o mulaingi singadolo habari <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ma betongo so'o ne: “Ni maḏibo toma ngo'omo boloto sababu ti'ara riwara Soroga ma Pareta<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note> 'i ngadolo.”<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat. 4:17</ref>; <ref loc="MRK 1:15">Mrk. 1:15</ref></char></note> <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Nabi Yesaya 'o kanau pasala ḏua mangale Yohanes gena-ge ma betongo so'o ne:</para>
  <para style="q1" vid="MAT 3:3">“ 'Age rema ngowa'a matengo 'o kanau siduga-duga toma daeraha baulaco so'o ne:</para>
  <para style="q1" vid="MAT 3:3">‘Sidodahe ngo'omo di'a Ma Jou,</para>
  <para style="q2" vid="MAT 3:3">siboloto ngo'omo gena-ge di'a Unanga.’ ”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Yes. 40:3</ref></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohanes 'ai baju 'i si'a'a reo 'unta ma gogo re 'ai golona ma bi-biri'u 'i si'a'a reo haiwani ma eno'o,<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">'A Yohanes 'ai pakeanga ma tero sa'olo 'a Elia 'ai pakeanga.</char></note> re 'ai ngo-ngoromo 'o cocoḇiti re 'o madu bangana.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2'Oln. 1:8</ref></char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ngowa'a toma limau Yerusalem ino, ngowa'a toma daeraha Yudea mo-moini re ngowa'a toma daeraha lelegu mo-moini ga'a ma'u se-sebanga Ḇanyo Yordan, ananga manga repe 'aḏi matai sapolo ra Yohanes. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ananga 'aḏi mangaku manga ḏosa-ḏosa, kara 'a Yohanes ya'u baptis ananga toma Ḇanyo Yordan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ngowa'a Farisi re ngowa'a Saduki manga repe ḏi'i 'aḏi sapolo ra Yohanes di'a 'aḏi sanga baptis. Mada'a wakutu unanga oḏi'i ananga 'aḏi sapolo, unanga 'o kanau i'a ra ananga, “Ngini ngowa'a ma jira ma ju'uda ma tero sa'olo cuku'u rema bisa ma ngowa! 'A guna 'o kanau ra ngini mangale na'o 'aḏi sanga baptis ḇato ngini ḏuanga i'a sanga hukumu ua ra Ma Jou'ongu Madutu!<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref>, <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">Luk. 3:7</ref></char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Sijumu taninga de'oso re ḏegoro mangale ngini reni maḏibo mode-mode'e toma ngo'omo boloto! <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Awa ngini ni ta'ajiri taninga 'akala re sinyingara, ‘Ngomi mi sanga hukumu ua sababu Abraham ngomi minga ete re dotumu.’ Sababu Ngoi to siajele ra ngini nena-ne: Ma Jou'ongu Madutu nga'unu 'o sidadi maḏi-maḏi nena-ne 'i dadi Abraham 'ai ju'uda!<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoh. 8:33</ref></char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ma Jou'ongu Madutu ro ḏu-ḏuanga ḏua 'O sihukumu ngowa'a ga'a 'aḏi maḏibo ua toma ngo'omo boloto ma tero sa'olo tama'ono 'i ḏu-ḏuanga ḏua di'a sitawele ate re sitola'a ngadolo toma utu'u. Sababu gena-ge, na'o ate gena-ge ma sowo'o 'i rousu ua, ḏuanga i'a 'a tawele re 'a upa'a toma u'u ma dara.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat. 7:19</ref></char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Ngoi to baptis ngini reo ḇanyo sa'olo nana'o rimoi mangale ngini reni maḏibo toma ngo'omo boloto. Mada'a togumu i'a Unanga ga'a ḏuanga i'a 'O sapolo di'a baptis ngini rema Ngagara 'Ofi-'Ofi re u'u. Unanga lebe la-lamo'o ra ngoi, ta gasa 'Ai tarupa mai patasa ua. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Gena-ge ma tero sa'olo Tai giama 'age rema garpu lamo'o, re Unanga ḏuanga i'a 'o sitaro'o gandum mo-moini singadolo 'i 'ofi. Gandum rema la'eme ḏuanga i'a sigare toma titila ma dara, mada'a ma 'omanga 'i siupa'a toma u'u kama sengene ua.”<figure style="fig" alt="Winnowing grain" file="HK00097B.TIF" size="col" ref="3:12">Ngowa'a matengo 'o sitaro'o gandum reo garpu lamo'o</figure><verse eid="MAT 3:12" /></para>
  <para style="s">Yesus sanga baptis ra Yohanes</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mrk. 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Toma 'orasa gena-ge Yesus toma Galilea ino 'O sapolo toma Ḇanyo Yordan. I'a da'a Unanga ma'u sanga ra Yohanes, re 'O golo'o 'a Yohanes 'o baptis Unanga. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Mada'a Yohanes tai'i 'a itomo Yesus 'ai go-golo'o re 'o kanau, “Ngoi balasu mode-mode'e to sanga baptis ra Jou, mada'a nange-ne Jou no sapolo di'a sanga baptis ra ngoi!”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Mada'a Yesus 'a sangoro, “Nange-ne sieanga ḇato so'o gena sababu wa si'a'a so'o nena-ne ngene wo 'a'a mete'e Ma Jou'ongu Madutu 'ai 'akala ma mau.” Dadi 'a Yohanes 'o baptis Yesus.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Sanga baptis togumu i'a, Yesus 'o baolo toma ḇanyo, kage-kage diwanga 'i talanga re Yesus 'o oḏi'i Ma Ngagara 'Ofi-'Ofi 'i matuhu ma tero sa'olo namo dara 'i 'uci ra Unanga. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Gena ḏua, ananga 'aḏi 'isene Ma Jou'ongu Madutu 'ai iḏingi ma betongo so'o ne: “Unanga nena-ne, 'Ari Ngowa'a Nau'u Ta dadalara, Ngoi 'ari 'akala re sinyingara ma sanangi Ta sipa'ala ra Unanga.”<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Do. 22:2</ref>; <ref loc="PSA 2:7">Nya. 2:7</ref>; <ref loc="ISA 42:1">Yes. 42:1</ref>; <ref loc="MAT 12:18">Mat. 12:18</ref>, <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Mrk. 1:11</ref>; <ref loc="LUK 9:35">Luk. 9:35</ref></char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Yesus sanga bo-baja toma 'Iblisi</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mrk. 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Togumu i'a, Ma Ngagara 'Ofi-'Ofi 'u gasa Yesus toma daeraha baulaco, la Unanga nyengara sanga bo-baja toma 'Iblisi.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">'Ibr. 2:18</ref>, <ref loc="HEB 4:15">4:15</ref></char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Wange nyagi rata re utu nyagi rata Yesus kama oromo ua, dadi Unanga 'o basono sawini. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />'Iblisi 'i sapolo re 'i kanau ra Unanga, “Ngana nena-ne Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u. Dadi no soma'a maḏi nena-ne 'i dadi roti.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesus 'a sangoro, “Toma Boku 'Ofi-'Ofi 'i silefo so'o ne: ‘Manusia wo 'ahu pa'i wo oromo roti ḇato ua, mada'a wo 'ahu ḏi'i, sababu wo mete'e Ma Jou'ongu Madutu 'ai demo-demo mo-moini, ga'a Unanga ro kanau.’ ”<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Dad. 8:3</ref></char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ḏua 'Iblisi 'i gasa Yesus toma limau 'ofi-'ofi Yerusalem, re 'U side'oso Unanga ra Ma Jou'ongu Madutu 'ai Wala ma wanata. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Gena ḏua, 'Iblisi gena-ge 'i kanau ra Unanga, “Ngana nena-ne Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u. Dadi No masipoini tala. Sababu toma Boku 'Ofi-'Ofi 'i silefo so'o ne:</para>
  <para style="q1" vid="MAT 4:6">‘Ma Jou'ongu Madutu ḏuanga i'a 'o soma'a 'Ai mala'ekata-mala'ekata 'aḏi jaga Ngana la-la.</para>
  <para style="q1" vid="MAT 4:6">Re ḏi'i ananga 'aḏi 'alo Ngana,</para>
  <para style="q1" vid="MAT 4:6">la 'Ani rou 'i nga'unu toma maḏi awa.’ ”<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Nya. 91:11-12</ref></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesus 'a sangoro, “Mada'a ḏi'i toma Boku 'Ofi-'Ofi ma dara 'i silefo so'o ne: ‘Awa no tai'i Ma Jou'ongu Madutu, 'ani Jou.’ ”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Dad. 6:16</ref></char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Gena ḏua, 'Iblisi 'i gasa Yesus moju toma kie rimoi lai kau'u ma tubu re 'i sijumu ra Unanga dungia ma pareta mo-moini re pareta-pareta gena-ge ma kabasarana. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Re 'i kanau ra Unanga, “Mo-moini nena-ne to pula'a di'a Ngana, na'o Ngana no maḏipolono re No silamo'o re siḏubuso ngoi.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesus 'a sangoro, “ 'Iblisi no sisoi'i tala ngoi. Toma Boku 'Ofi-'Ofi ma dara 'i silefo so'o ne:</para>
  <para style="q1" vid="MAT 4:10">‘Silamo'o re siḏubuso Ma Jou'ongu Madutu, 'ani Jou</para>
  <para style="q2" vid="MAT 4:10">re de-de'oso pa'i Unanga ḇato.’ ”<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Dad. 6:13</ref></char></note><verse eid="MAT 4:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 4:11" />Togumu i'a, 'Iblisi 'i sisoi'i tala 'a Yesus, re mala'ekata-mala'ekata 'aḏi sapolo di'a de-de'oso Unanga.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesus 'o mulaingi munara toma daeraha Galilea</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mrk. 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Wakutu Yesus 'o 'isene 'a Yohanes sanga osama toma bui, Yesus dadunu 'o tagi toma daeraha Galilea.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat. 14:3</ref>; <ref loc="MRK 6:17">Mrk. 6:17</ref>; <ref loc="LUK 3:19-20">Luk. 3:19-20</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Gena ḏua, Unanga 'o sisoi'i tala limau Nazaret, re 'O tagi re 'O tegoro toma limau Kapernaum, toma talaga Galilea ma 'uḏu, toma daeraha Zebulon re Naftali.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yoh. 2:12</ref></char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Dadi 'oru ga'a nabi Yesaya 'o kanau pasala ḏua 'i sitotomo:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Daeraha Zebulon re Naftali</para>
  <para style="q2" vid="MAT 4:15">ga'a toma ngo'omo tagi talaga, daeraha ga'a toma Ḇanyo Yordan da'a kaci moi.</para>
  <para style="q2" vid="MAT 4:15">toma daeraha Galilea ga'a ngowa'a Yahudi ua manga daeraha.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Ngowa'a toma daeraha-daeraha gena-ge 'aḏi tegoro toma hafu-hafu sababu 'aḏi nana'o ua Ma Jou'ongu Madutu,</para>
  <para style="q2" vid="MAT 4:16">ananga gena-ge raḏi oḏi'i tarangi ma lamo'o.</para>
  <para style="q1" vid="MAT 4:16">Re ngowa'a gena-ge ḏi'i ga'a 'aḏi mojongo sengene sababu manga ḏosa,</para>
  <para style="q2" vid="MAT 4:16">nange-ne tarangi 'i pilata ḏua ra ananga!”<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Yes. 9:1-2</ref></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Mulaingi toma 'orasa gena-ge, Yesus 'o singadolo ma habari nena-ne: “Ni maḏibo toma ngo'omo boloto, sababu ti'ara riwara Soroga ma Pareta<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note> 'i ngadolo.”<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat. 3:2</ref></char></note><verse eid="MAT 4:17" /></para>
  <para style="s">Yesus 'o 'aro'o ngowa'a ngau-ngau nga ḏuata</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mrk. 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Wakutu Yesus 'o ḏingana 'o mete'e toma talaga Galilea ma 'uḏu, Unanga 'o oḏi'i ngowa'a ngau-ngau nga muḏiḏi: 'a Simon, si'aro'o 'a Petrus, re 'a Andreas, ananga gia nongoḏu. Ananga gena-ge 'aḏi disa nyao'o reo j̱ala toma talaga gena-ge. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesus 'o kanau ra ananga, “Ino mete'e Ngoi. Ngoi ḏuanga i'a to sidoto'o ngini ni lomu ngowa'a ma tero sa'olo nange-ne ngini ni lomu nyao'o, la ananga 'aḏi mete'e Ngoi.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ananga jau-jau ya sisoi'i tala manga j̱ala, kara 'aḏi mete'e Unanga.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yesus 'a dowanga 'Ai ḏo-ḏagi re 'O oḏi'i gia nongoḏu nga muḏiḏi ma lelegu: 'a Yakobus re 'a Yohanes, Zebedeus 'ai ngowa-ngowa'a nau'u. Ananga ya sidiai manga j̱ala toma oti ma dara, mamete'e remanga ḇaḇa. Yesus ya'u 'aro'o ananga ḏi'i di'a mete'e Unanga. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ananga jau-jau ya sisoi'i tala manga ḇaḇa re manga oti, kara 'aḏi mete'e Yesus.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesus 'o singadolo Habari Roanga re <optbreak /> 'O si-la ngowa-ngowa'a siḏi</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesus 'a sigoloḏi daeraha Galilea mo-moini re 'O doto'o toma wala-wala puji. Unanga 'o singadolo Habari Roanga mangale Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> Re Unanga ḏi'i 'O si-la ngowa-ngowa'a mo-moini remanga si-siḏi ma rupa 'oru ḇato.<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">Mat. 9:35</ref>; <ref loc="MRK 1:39">Mrk. 1:39</ref></char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Habari mangale Yesus, 'i rera re walata toma nagara Siria manga gamu, singadolo ngowa'a manga repe 'aḏi sapolo ra Unanga. Ananga 'aḏi gasa ngowa-ngowa'a siḏi, remanga si-siḏi ma rupa lai repe. Ngowa-ngowa'a ga'a roh ma jira ya'u dungosama, ngowa-ngowa'a sarasone, ngowa-ngowa'a ḇolo. Ananga mo-moini Yesus ya'u si-la. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Toma 'orasa gena-ge, ngowa'a manga repe 'aḏi mete'e Yesus. Ngowa'a repe 'aḏi sapolo ino: ngowa'a toma daeraha Galilea, ngowa'a toma Limau Nyagi Moi ino, ngowa'a toma limau Yerusalem, ngowa'a toma daeraha Yudea, re ngowa'a toma gamu Ḇanyo Yordan ma kaci moi.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Bobita toma sau</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Wakutu Yesus 'o oḏi'i ngowa'a repe, Unanga 'o pere ie re 'O tegoro toma sau. Gena ḏua, 'Ai me-mete'e 'aḏi sapolo ra Unanga. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ḏua Unanga ya'u doto'o ananga.<verse eid="MAT 5:2" /></para>
  <para style="s">Ngowa'a ga'a bara'utungu</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk. 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Bara'utungu ngowa'a ga'a 'aḏi basono tala ananga ngowa'a ya'u sipake-pake ua ra Ma Jou'ongu Madutu 'ai momina,</para>
  <para style="q2" vid="MAT 5:3">mada'a ananga manga ngo-nganono pa'i ra Ma Jou'ongu Madutu ḇato;</para>
  <para style="q3" vid="MAT 5:3">sababu ananga gena-ge 'aḏi osama nyo-nyoimi toma Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note><verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bara'utungu ngowa'a ga'a nange-ne 'aḏi rerese ma gaḏi,</para>
  <para style="q2" vid="MAT 5:4">sababu Ma Jou'ongu Madutu masiretene ḏuanga i'a 'O sihiburu ananga gena-ge.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">Yes. 61:2</ref></char></note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bara'utungu ngowa'a ga'a 'aḏi maholo tamanga 'akala re sinyingara,</para>
  <para style="q2" vid="MAT 5:5">sababu Ma Jou'ongu Madutu ḏuanga i'a 'O sitotomo 'Ai jaji ra ananga gena-ge.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">Nya. 37:11</ref></char></note><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bara'utungu ngowa'a ga'a 'aḏi nyafusu madutu dadi ngowa'a loasa re banari ra Ma Jou'ongu Madutu 'ai momina,</para>
  <para style="q2" vid="MAT 5:6">sababu Ma Jou'ongu Madutu masiretene ḏuanga i'a 'o sitotomo manga mau.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">Yes. 55:1-2</ref></char></note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bara'utungu ngowa'a ga'a 'aḏi sijumu manga 'akala re sinyingara la-la toma ngowa'a lelegu,</para>
  <para style="q2" vid="MAT 5:7">sababu Ma Jou'ongu Madutu ḏuanga i'a 'O sijumu 'Ai 'akala re sinyingara la-la ra ananga gena-ge ḏi'i.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bara'utungu ngowa'a ga'a manga 'akala re sinyingara 'i 'ofi-'ofi,</para>
  <para style="q2" vid="MAT 5:8">sababu ananga gena-ge 'aḏi 'ahu mamete'e ra Ma Jou'ongu Madutu.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">Nya. 24:3-4</ref></char></note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bara'utungu ngowa'a 'aḏi riono ngowa'a 'aḏi dadi ma'u dame moju,</para>
  <para style="q2" vid="MAT 5:9">sababu ananga gena-ge 'aḏi osama nyo-nyoimi ra Ma Jou'ongu Madutu 'ai ngowa-ngowa'a nau'u.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bara'utungu ngowa'a 'aḏi sanga sikisa sababu 'aḏi siḏagi Ma Jou'ongu Madutu 'ai 'akala ma mau,</para>
  <para style="q2" vid="MAT 5:10">sababu ananga gena-ge 'aḏi osama nyo-nyoimi toma Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note><note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1Pet. 3:14</ref></char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Bara'utungu ngini, na'o ngowa'a nu'u je-jengere re nu'u sikisa re nu'u jajaha demo pa'i sababu ni mete'e Ngoi ḇato.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1Pet. 4:14</ref></char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Nabi-nabi ma siḏa ḏi'i ya sanga sikisa ma tero so'o gena-ge. Dadi ngini ni maroanga re ni sanangi, sababu ngini ni sanga ngogele lai lamo'o toma soroga.”<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2Taw. 36:16</ref>; <ref loc="ACT 7:52">Som. 7:52</ref></char></note><verse eid="MAT 5:12" /></para>
  <para style="s">Ngowa'a ga'a 'aḏi mete'e Yesus ma tero sa'olo g̱asi re tarangi</para>
  <para style="r">(<ref loc="MRK 9:50">Mrk. 9:50</ref>; <ref loc="LUK 14:34-35">Luk. 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Ngini ga'a mete'e Ngoi, ngini ma tero sa'olo g̱asi di'a dungia nena-ne. Na'o g̱asi 'i rasa riwara, sanga ua ni siḏibo moju enanga ma rasa. Dadi enanga ma faeda ri cua, pa'i na upa'a re ngowa'a ya to'u-to'u.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">Mrk. 9:50</ref>; <ref loc="LUK 14:34-35">Luk. 14:34-35</ref></char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Ngini ga'a mete'e Ngoi, ngini ma tero sa'olo tarangi di'a dungia nena-ne. Sanga ua, limau toma sau ma tubu, ngowa'a ya oḏi'i ua!<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">Yoh. 8:12</ref>, <ref loc="JHN 9:5">9:5</ref></char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Re matengo i'a mai ua tagala 'o poci, kara 'a sidamunu reo tampayanga! Siḏibo ḏi'i, 'a sigare toma poci ma ngi'i, la 'i sitarangi ngowa'a mo-moini toma wala ma dara.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mrk. 4:21</ref>; <ref loc="LUK 8:16">Luk. 8:16</ref>, <ref loc="LUK 11:33">11:33</ref></char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />So'o gena ḏi'i, ninga ga'a ma la-la ga'a ma tero sa'olo tarangi, balasu na sijumu toma mandan, la ngowa'a ya oḏi'i kara 'aḏi puji re silamo'o nanga Ḇaḇa toma soroga.”<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1Pet. 2:12</ref></char></note><verse eid="MAT 5:16" /></para>
  <para style="s">Do-doto'o mangale Musa 'ai hukumu</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Awa ngini ta'ajiri Ngoi to sapolo ta singi-ngiranga 'a Musa 'ai hukumu, re nabi-nabi manga do-doto'o. Siḏibo ḏi'i, Ngoi to sapolo di'a ta sitotomo. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Na'o diwanga re tana'a 'age rema enanga moju, hukumu ma hurufu ngai moi i'a mai ua wa singi-ngiranga, na'o mo-moini ra Musa 'ai hukumu gena-ge ma dara 'i dadi nyangu.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luk. 16:17</ref></char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Sababu gena-ge, kalaha pa'i parenta ceka'a i'a ḇato, 'a guna ḇato 'o mete'e ua parenta mo-moini ra Musa 'ai hukumu gena-ge, re sidoto'o ngowa-ngowa'a lelegu ya si'a'a so'o gena ḏi'i, ananga gena-ge sanga ḏe-ḏegoro lai ceka'a toma Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta. Gena-ge ma tero toma bu-bula'a 20</char></note> Siḏibo ḏi'i, 'a guna ḇato ya mete'e Musa 'ai hukumu mo-moini gena-ge, re sidoto'o toma ngowa-ngowa'a lelegu ya si'a'a so'o gena ḏi'i, ananga gena-ge 'aḏi sanga ḏe-ḏegoro lai kau'u toma Soroga ma Pareta. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Dadi, Ngoi to siajele ra ngini nena-ne: Ngini balasu ni mete'e “Musa 'ai hukumu lebe cufala i'a reo guru-guru 'agama re ngowa'a Farisi. Na'o so'o gena-ge ua, ngini ni osama nyo-nyoimi yoḏu'u toma Soroga ma Pareta.”<verse eid="MAT 5:20" /></para>
  <para style="s">Awa ma'u ruta</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luk. 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Ngini reni waro parenta nena-ne ga'a 'i siajele tananga ete re dotumu 'ua re 'au wali: ‘Awa ni sisengene ngowa'a. Re 'a guna ḇato 'o sisengene ngowa'a, unanga ḏuanga i'a 'o sanga hukumu.’<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Sup. 20:13</ref>; <ref loc="DEU 5:17">Dad. 5:17</ref></char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Mada'a Ngoi to siajele ra ngini nena-ne: 'A guna ḇato 'o ruta toma ngowa'a lelegu, unanga gena-ge ḏuanga i'a 'o sanga hukumu. Re 'a guna ḇato ga'a do-doana ngowa'a lelegu, unanga ḏuanga i'a sitalaḏi toma Mahkamah 'Agama. Mada'a 'a guna ḇato ga'a si'aro'o ‘Haga’ toma ngowa'a lelegu, unanga gena-ge ḏuanga i'a sanga upa'a toma naraka ma dara.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Sababu gena-ge, na'o ngini ni osama ra Ma Jou'ongu Madutu 'ai Wala re ni talaḏi meja jou-jou ma biono re mau ni pula'a ninga jou-jou, mada'a ni si'elingi ie rema ngowa'a lelegu 'ai 'akala re sinyingara si-siḏi ra ngini; <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ngini balasu ni sisoi'i tala ninga jou-jou gena-ge toma meja jou-jou ma biono, re ni maḏibo jau-jau di'a ma'u dame toma ngowa'a gena-ge, kara dadunu ni tagi ni pula'a ninga jou-jou ra Ma Jou'ongu Madutu.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Si'ade-'ade 'age rema ngowa'a matengo 'o kalaki ngini toma mahkamah, no disa dame siḏa toma ngowa'a matengo gena-ge wakutu ngini ni tagi toma ḏo-ḏagi moju toma juruhakimi, la 'a sigasa awa toma mahkamah. Sababu na'o so'o gena ua, unanga ḏuanga i'a 'o sipula'a ngini toma juruhakimi. Togumu i'a juruhakimi ḏuanga i'a 'o sipula'a ngini toma polisi, re polisi ḏuanga i'a singosama ngini toma bui! <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ni ngaku mode'e 'Ari demo nena-ne: Na'o ngini ni fangu bo-bangu mo-moini ua, sanga ua ngini ni supu toma bui gena-ge!”<verse eid="MAT 5:26" /></para>
  <para style="s">Yesus 'ai do-doto'o mangale tinikai</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Ngini reni waro parenta nena-ne ga'a 'ua re 'au wali ri silefo so'o ne: ‘Awa ni tinikai.’<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Sup. 20:14</ref>; <ref loc="DEU 5:18">Dad. 5:18</ref></char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Mada'a Ngoi to siajele ra ngini nena-ne: 'A guna ḇato 'o oḏi'i we-were'a tai 'akala re sinyingara rema nyafusu, unanga gena-ge 'o tinikai toma we-were'a tai 'akala re sinyingara ma dara. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Na'o ninga la'o ma kuwiḏa sigasa ngini ni eta'a toma ḏosa, ni cuḇulenge re ni upa'a la'o gena-ge! Jobilaha pa'i ninga la'o kaci moi 'i iranga ḇato, reo ninga lese mo-moini 'i osama toma naraka ma dara raninga la'o kaci ḏiḏi.<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mat. 18:9</ref>; <ref loc="MRK 9:47">Mrk. 9:47</ref></char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Re na'o ninga giama ma kuwiḏa 'i sigasa ngini ni eta'a toma ḏosa, ni tola'a re ni upa'a giama gena-ge! Jobilaha pa'i ninga giama kaci moi 'i iranga ḇato, reo ninga lese mo-moini 'i osama toma naraka ma dara raninga giama kaci ḏiḏi.”<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mat. 18:8</ref>; <ref loc="MRK 9:43">Mrk. 9:43</ref></char></note><verse eid="MAT 5:30" /></para>
  <para style="s">Yesus 'ai do-doto'o mangale nau'u oḏu'u 'ai were'a</para>
  <para style="r">(<ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mrk. 10:11-12</ref>; <ref loc="LUK 16:18">Luk. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ 'Ua re 'au wali, 'age ḏi'i rema parenta so'o ne: ‘ 'A guna ḇato 'a oḏu'u 'ai were'a, unanga balasu 'a pula'a ma surata tola'a.’<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Dad. 24:1-4</ref>; <ref loc="MAT 19:7">Mat. 19:7</ref>; <ref loc="MRK 10:4">Mrk. 10:4</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Mada'a Ngoi to siajele ra ngini nena-ne: Nau'u matengo nyengara 'o oḏu'u 'ai were'a pa'i na'o munanga mo 'a'a tinikai ḇato. Na'o nau'u 'o oḏu'u 'ai were'a sababu 'alasana lelegu, unanga gena-ge 'o sigasa munanga toma tinikai, na'o munanga dadunu mo molo'ara moju. Re 'a guna ga'a 'o molo'ara munanga, unanga gena-ge ro 'a'a tinikai ḏi'i.”<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mrk. 10:11-12</ref>; <ref loc="LUK 16:18">Luk. 16:18</ref>; <ref loc="1CO 7:10-11">1Kor. 7:10-11</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">Awa ma'u sasi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Ngini reni waro parenta nena-ne ga'a 'i siajele tananga ete re dotumu 'ua re 'au wali: ‘Awa ni sito-to'u ninga jaji rema sasi, mada'a 'oru ga'a ngini ni sijaji rema sasi ra Ma Jou'ongu Madutu 'ai momina, gena-ge balasu ni si'a'a.’<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">'Im. 19:12</ref>; <ref loc="NUM 30:2">Nyo. 30:2</ref>; <ref loc="DEU 23:21">Dad. 23:21</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Mada'a, Ngoi to siajele ra ngini nena-ne: Ngini ni masisasi rawara: bae ni masisasi ni terongo diwanga, sababu diwanga gena-ge Ma Jou'ongu Madutu 'ai ḏe-ḏegoro,<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">Yak. 5:12</ref>; <ref loc="ISA 66:1">Yes. 66:1</ref>; <ref loc="MAT 23:22">Mat. 23:22</ref></char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />bae ni masisasi ni terongo tana'a, sababu tana'a Unanga gena-ge 'ai rou ma ba-bangini, bae ni masisasi ni terongo limau Yerusalem, sababu limau gena-ge Ma Jou'ongu Madutu 'ai limau, Unanga gena-ge ga'a 'Olana Lamo'o.<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Yes. 66:1</ref>; <ref loc="PSA 48:3">Nya. 48:3</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Re awa ḏi'i ngini ni masisasi ni terongo ninga sae'e, sababu pa'i ninga utu ma sua ngai moi ḇato ua, ngini masiretene ni waro ua 'a'a ninga utu bu-buḏo, bolo utu ko-kotu'u. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Mada'a pa'i kanau ḇato ‘Ya’, na'o 'i banari; bolo ‘Ua’, na'o 'i banari ua. Na'o ngini ni kanau lebe kiḏanga reo gena-ge, ḏua ma 'asala toma 'Iblisi.”<verse eid="MAT 5:37" /></para>
  <para style="s">Awa ma'u balasa</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk. 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Ngini reni waro parenta nena-ne ga'a 'ua re 'au wali ri silefo so'o ne: ‘Na'o matengo 'o sijira 'ani la'o, ngana nyengara no sijira 'ai la'o. Re na'o matengo 'o sijira 'ani ngiḏi, ngana nyengara no sijira 'ai ngiḏi.’<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Sup. 21:24</ref>; <ref loc="LEV 24:20">'Im. 24:20</ref>; <ref loc="DEU 19:21">Dad. 19:21</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Mada'a Ngoi to siajele ra ngini nena-ne: Awa ni mabalasa toma ngowa'a matengo ga'a 'o 'a'a jira ra ngini. Siḏibo ḏi'i na'o ngana 'ani bobongolo ma kuwiḏa ngowa'a matengo 'a sata, ḏua no pula'a ḏi'i ma kuḇali. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Re na'o ngowa'a matengo 'o pula'a da'awa toma juruhakimi mangale ngana re golo'o 'ani baju, nu pula'a ḏi'i 'ani juba. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Na'o sordado matengo 'o simau-mau 'ai gina ra ngana di'a na doiti ma giḏanga kilo moi, ngana na doiti ma giḏanga kilo ḏiḏi. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Na'o ngowa'a matengo 'o golo'o 'ori i'a rimoi i'a ra ngana, ngana no pula'a ḇato. Re ngana nu dusu'u awa ngowa'a matengo ga'a mau bau 'oru ḇato ra ngana.”<verse eid="MAT 5:42" /></para>
  <para style="s">Dadalara ninga lawana</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk. 6:27-28</ref>, <ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Ngini reni waro parenta nena-ne ga'a 'ua re 'au wali ri silefo so'o ne: ‘Ni dadalara ḏagilomu-ḏagilomu re ni emono lawana-lawana.’<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">'Im. 19:18</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Mada'a Ngoi to siajele ra ngini nena-ne: Ngini balasu ni dadalara ninga lawana-lawana, re ni nyiata ḏi'i ngowa-ngowa'a ga'a 'aḏi sisikisa ngini sababu ni mete'e Ngoi. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Na'o ni 'a'a so'o gena-ge ngini ni mete'e Ma Jou'ongu Madutu toma soroga, Unanga 'ai tabeata. Sababu Unanga 'o sijumu 'Ai dadalara toma ngowa-ngowa'a mo-moini: Unanga 'A siciḏoto wangere ma la'o pa'i di'a ngowa'a ma la-la ḇato ua, mada'a di'a ngowa'a ma jira ḏi'i. Unanga 'o 'a'a besa'a pa'i di'a ngowa'a loasa re banari ḇato ua, mada'a di'a ngowa'a ma jira ḏi'i. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Dadi na'o ni dadalara pa'i ngowa'a ga'a 'aḏi dadalara ngini ḇato, Ma Jou'ongu Madutu 'o pula'a ngogele ua ra ngini. Sababu ngini ma tero sa'olo ngowa'a golo-golo'o balastengi: Ananga ḏi'i pa'i 'aḏi dadalara ngowa'a ga'a ya'u dadalara! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Re na'o ngini ni pula'a tabea pa'i ra ngini ninga ḏagilomu ḇato, enanga ma rousu 'oru?! Ngowa-ngowa'a ga'a 'aḏi nana'o ua Ma Jou'ongu Madutu mai nga'unu ya si'a'a so'o gena-ge! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Sababu gena-ge, ngini nena-ne balasu ni dadalara ti-tiai ngowa'a mo-moini ma tero sa'olo nanga Ḇaḇa toma soroga ga'a 'o dadalara ti-tiai ngowa'a mo-moini.”<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">'Im. 19:2</ref>; <ref loc="DEU 18:13">Dad. 18:13</ref></char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Do-doto'o mangale bu-bula'a</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Ma'istiari: Awa ngini ni siḏagi ninga 'agama ma 'atoranga toma mandan, la ngowa'a ya oḏi'i. Na'o ngini ninga de'oso re ḏegoro so'o gena-ge, ḏuanga i'a ngini ni sanga ua enanga ma ngogele ra ngini ninga Ḇaḇa da'u toma soroga.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">Mat. 23:5</ref></char></note><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Sababu gena-ge na'o ngini ni pula'a ninga bu-bula'a toma ngowa'a ma dinga'unu ua, awa na si ie-tala--ie-tala toma ngowa'a lelegu ma tero sa'olo ngowa'a munafiki. Ananga 'aḏi nyanyaḏi ya si'a'a toma wala puji ma dara re toma ngo'omo lamo'o, la ngowa'a ya'u sihie-hie. Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Ananga gena-ge manga ngogele rema enanga ḏua! Tantu ḏua Ma Jou'ongu Madutu nu puji re silamo'o ua! <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Mada'a na'o ngini ni pula'a ninga bu-bula'a toma ngowa'a ma dinga'unu ua, pula'a siogo-ogoro, la matengo i'a mai ua ya waro. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Ḏua ngowa'a ya waro ua mangale ninga bu-bula'a pa'i ninga Ḇaḇa da'u toma soroga 'a oḏi'i. Dadi Unanga ḏuanga i'a 'o pula'a ngogele ra ngini.<verse eid="MAT 6:4" /></para>
  <para style="s">Do-doto'o mangale manyiata</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Re wakutu ngini ni manyiata, awa ni dadi sa'olo ngowa'a munafiki! Wakutu ananga gena-ge 'aḏi manyiata 'aḏi nyanyaḏi made-de'oso toma wala-wala puji re toma ngo'omo ma sola, la ngowa'a ya'u oḏi'i kara ya'u puji re silamo'o ananga. Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Ananga gena-ge manga ngogele rema enanga ḏua! Tantu ḏua Ma Jou'ongu Madutu nu puji re silamo'o ua!<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">Luk. 18:10-14</ref></char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Mada'a wakutu ngini ni manyiata, osama toma kamara re kuci ngalana, kara ni manyiata ra ninga Ḇaḇa ga'a wa oḏi'i ua. Ḏua Unanga ḏuanga i'a 'o pula'a ngogele ra ngini sababu pa'i ninga Ḇaḇa ḇato 'a oḏi'i ngini ni manyiata.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Wakutu ngini ni manyiata, awa na sida-dadunu ma tero sa'olo ngowa'a ga'a 'aḏi nana'o Ma Jou'ongu Madutu ua. Ananga gena-ge 'aḏi ta'ajiri Ma Jou'ongu Madutu 'a 'isene sababu manga go-golo'o lai kiḏanga. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Awa ma tero sa'olo ananga. Ninga Ḇaḇa 'a waro ḏua 'oru ga'a ni paralu, wakutu ni kanau ninga go-golo'o nyangu. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Dadi ni manyiata so'o ne:</para>
  <para style="q1" vid="MAT 6:9">‘Minga Baba da'u toma soroga,</para>
  <para style="q2" vid="MAT 6:9">'Ani lomanga ngowa'a ya silamo'o re siḏubuso,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />'Ani pareta 'i sapolo ino,</para>
  <para style="q2" vid="MAT 6:10">'Ani 'akala ma mau 'i dadi toma dungia nena-ne,</para>
  <para style="q2" vid="MAT 6:10">ma tero toma soroga.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Minga ngo-ngoromo toma wangere nange-ne, Na pula'a ino ga'a ngomi mi paralu.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Re No singi-ngiranga minga sala,</para>
  <para style="q2" vid="MAT 6:12">ma tero ngomi ḏi'i remi si'apongo ngowa'a ga'a 'aḏi 'a'a sala ḏua ra ngomi.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Re awa No sieanga i'a ngomi mi sanga bo-baja,</para>
  <para style="q2" vid="MAT 6:13">mada'a Na siwoi'i ngomi toma jira.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">bolo “toma 'Iblisi ma kuasa.”</char></note></para>
  <para style="q2" vid="MAT 6:13">[Sababu Baba 'ani Pareta, Kuasa re Mulia kasingado-ngadolo i'a. 'Amin]’<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Na'o ngini na si'apongo ngowa'a ga'a 'aḏi 'a'a sala ra ngini, ninga Ḇaḇa toma soroga ḏuanga i'a 'a singi-ngiranga ḏi'i ngini ninga sala. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Mada'a na'o ngini na si'apongo ua ngowa'a ga'a 'aḏi 'a'a sala ra ngini, ninga Baba toma soroga 'a singi-ngiranga ua ḏi'i ngini ninga sala.”<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">Mrk. 11:25-26</ref></char></note><verse eid="MAT 6:15" /></para>
  <para style="s">Do-doto'o mangale puasa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Wakutu ngini ni puasa, awa ninga biono ḇuta, ma tero sa'olo ngowa'a munafiki! Ananga gena-ge ya tuhu manga biono wa'alo, la ngowa'a ya waro ananga 'aḏi puasa kara ya'u puji re silamo'o ananga. Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Ananga gena-ge manga ngogele rema enanga ḏua! Tantu ḏua Ma Jou'ongu Madutu nu puji re silamo'o ua! <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Mada'a wakutu ngini ni puasa na loca'a ninga biono re na kuḇa ninga utu, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />la ngowa'a ya waro ua mangale ngini ni puasa, pa'i ninga Ḇaḇa ḇato, ga'a wu oḏi'i ua, Unanga ra waro. Ḏua Unanga ḏuanga i'a 'o pula'a ngogele ra ngini sababu pa'i ninga Ḇaḇa ḇato 'a oḏi'i; ngowa'a matengo i'a mai ua 'a oḏi'i!”<verse eid="MAT 6:18" /></para>
  <para style="s">Harata toma soroga</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk. 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Awa ni lomu harata toma dungia di'a ninga diri. Sababu enanga gena-ge nyengara 'i keho re nyanyao'o ya sijira re ngowa'a to-tori'i sapolo ya tori'i.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">Yak. 5:2-3</ref></char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Siḏibo ḏi'i ni lomu harata toma soroga. Sababu enanga gena-ge 'i keho ua re nyanyao'o ya sijira yoḏu'u re ngowa'a to-tori'i ya tori'i yoḏu'u. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Sababu ninga harata na gare gena ngi'a, 'akala re sinyingara mai gena ngi'a ḏi'i!”<verse eid="MAT 6:21" /></para>
  <para style="s">Tarangi di'a lese</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk. 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“La'o gena-ge 'i dadi sa'olo lese ma lapuru. Na'o ninga la'o 'i la-la, ninga lese rimoi mo-moini 'i tarangi. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Mada'a na'o ninga la'o 'i siḏi re karasa, ninga lese rimoi mo-moini 'i dadi hafu. Dadi na'o lapuru taninga lese 'i hafu, marai ḏua ninga lese 'i hafu masala!”<verse eid="MAT 6:23" /></para>
  <para style="s">Ma Jou'ongu Madutu re harata</para>
  <para style="r">(<ref loc="LUK 16:13">Luk. 16:13</ref>, <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Sanga ua, matengo 'o de-de'oso ti-tiai tuanga nga muḏiḏi! Sababu unanga 'ai 'akala re sinyingara 'i kucela: Unanga 'o lebe dadalara tuanga matengo reo tuanga ma lelegu. Bolo unanga 'o mete'e lebe cufala tai tuanga matengo reo tuanga ma lelegu. So'o gena ḏi'i, sanga ua ngini ni lomu harata toma dungia nena-ne simete'e ni de-de'oso ti-tiai Ma Jou'ongu Madutu!<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Sababu gena-ge, Ngoi to siajele ra ngini nena-ne: Awa ni dodato mangale ninga 'ahu: bae 'oru ga'a ni oromo bae 'oru ga'a ni ka'e. Re ḏi'i, awa ni madodato mangale ninga lese: 'Oru ga'a ni pake. Sababu tantu ḏua, ninga 'ahu lebe la-lamo'o i'a reo ngo-ngoromo re lese lebe la-lamo'o i'a reo pakeanga! <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Oḏi'i ḇato namo diwanga, enanga 'i so'ana mai ua, 'i 'utu'u mai ua, re 'i lomu mai ua guḏa ma hasili toma titila. Kalaha so'o gena, ninga Ḇaḇa toma soroga 'a pula'a enanga ma ngo-ngoromo. Tantu ḏua ngini reni waro, ngini lebe la-lamo'o i'a reo namo diwanga! <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Re ḏi'i, kalaha pa'i jam rimoi ḇato tai 'umuru ma giḏanga 'a guna ra ngini ninga sigolona nga'unu 'a dogo sababu 'o madodato?!<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />I'a sa'olo ngini ni madodato mangale pakeanga? Tai'i ni tailako la-la ino 'o saya-saya 'i konyo toma goroa. Saya-saya gena-ge kama munara ua re kama 'a'a ma pakeanga ua. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Mada'a, Ngoi to siajele ra ngini nena-ne: Kalaha 'Olana Salomo ngowa'a rema-enanga madutu, 'ai pakeanga ma rousu ma tero ua sa'olo saya-saya gena-ge.<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1'Oln. 10:4-7</ref>; <ref loc="2CH 9:3-6">2Taw. 9:3-6</ref></char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Saya-saya toma goroa 'i konyo wangere nange-ne, re da-daini ngowa'a ya tau'u. Kalaha so'o gena-ge, Ma Jou'ongu Madutu 'a diai saya-saya gena-ge lai rousu masala. Dadi ma la-lamo'o i'a ḏi'i Unanga 'o diai ngini! Dadi i'a sa'olo ninga ngo-ngaku pa'i ceka'a ua ra Ma Jou'ongu Madutu?! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Sababu gena-ge, awa ni madodato re ni kanau, ‘Ngene ḏuanga i'a wo oromo 'oru?’ bolo, ‘Ngene ḏuanga i'a wo ka'e 'oru?’ bolo, ‘Ngene ḏuanga i'a wo pake 'oru?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Mo-moini gena-ge ngowa-ngowa'a ga'a nana'o Ma Jou'ongu Madutu ua ananga ya disa. Mada'a ninga Ḇaḇa da'u toma soroga 'a waro ninga paralu mo-moini. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Mada'a siḏibo ḏi'i, siḏa-siḏa ngini ni makutale dadi ngowa'a loasa re banari re ninga 'ahu mete'e Ma Jou'ongu Madutu sa'olo ninga 'Olana. Ḏua Unanga 'o pula'a 'ori i'a mo-moini ga'a ngini ni paralu. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Sababu gena-ge, awa ni dodato mangale wangere da-daini, sababu enanga rema susa re sangisara masiretene. Wangere nange-ne enanga ma susa re sangisara ngadolo nena-ne ḇato, awa na dogo moju sababu ni dodato mangale wangere da-daini!”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Do-doto'o mangale sijuruhakimi ngowa'a</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk. 6:37-38</ref>, <ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Awa ngini ni sijuruhakimi ngowa'a, la Ma Jou'ongu Madutu ni sijuruhakimi ngini ua. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Sababu ma tero sa'olo ngini ni sijuruhakimi ngowa'a, so'o gena ḏi'i Ma Jou'ongu Madutu ḏuanga i'a 'o sijuruhakimi ngini. Re ninga du-duga ga'a ngini ni pake di'a situga toma ngowa'a lelegu, du-duga gena-ge ḏi'i Ma Jou'ongu Madutu 'a pake 'a situga ra ngini!<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mrk. 4:24</ref></char></note><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />I'a sa'olo ngini ni oḏi'i 'o ate ma bingana taninga ioronongoḏu manga la'o, mada'a jaro jule moi taninga la'o, ni siwaro i'a ua. <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />I'a sa'olo ngini ni kanau taninga ioronongoḏu, ‘Ino ngoi ta woi'i 'o ate ma bingana tani la'o,’ mada'a taninga la'o ma dara rema jaro jule moi? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Hai ngini ngowa'a munafiki! Ni sisupu siḏa 'o jaro jule moi tani la'o, la ni oḏi'i tarangi, kara nga'unu ni sisupu 'o ate ma bingana taninga ioronongoḏu 'ai la'o ma dara.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Awa no pula'a 'ori i'a 'ofi-'ofi toma nunu'u, la nunu'u gena-ge 'i macelolo re 'i goḏi ngana awa! Re awa no pula'a mutiara toma soto, la awa soto gena-ge ya jo'u la-la mutiara gena-ge.”<verse eid="MAT 7:6" /></para>
  <para style="s">Golo'o ra Ma Jou'ongu Madutu</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Ni golo'o, ḏuanga i'a ni dawongo. Ni disa, ḏuanga i'a ni sanga. Ni tolo'o ngalana, re ngalana ḏuanga i'a ya welanga. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Sababu 'a guna ḇato ga'a 'o golo'o, ḏuanga i'a 'o dawongo. 'A guna ḇato ga'a 'o disa, ḏuanga i'a 'o sanga. Re 'a guna ḇato ga'a 'o tolo'o ngalana, ḏuanga i'a ya welanga. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Sanga ua, 'age rema ḇaḇa matengo taninga sigolona ga'a 'o pula'a maḏi, na'o 'ai ngowa'a nau'u 'o golo'o roti! <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Bolo unanga 'o pula'a cuku'u, na'o 'ai ngowa'a nau'u 'o golo'o nyao'o! <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Kalaha ngini ngowa'a baraḏosa, ngini mai ni waro ḏi'i ni pula'a 'ori i'a ma la-la taninga ngowa-ngowa'a. Ma la-lamo'o i'a ḏi'i, ninga Ḇaḇa toma soroga! Tantu ḏua, Unanga 'o pula'a 'ori i'a ma la-la ra ananga ga'a 'aḏi golo'o ra Unanga.”<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Sababu gena-ge, 'a Musa 'ai hukumu ma do-doto'o re nabi-nabi manga do-doto'o ma ngale so'o ne: 'Oru ḇato ngini ni mau ngowa'a 'aḏi 'a'a ra ngini, ni 'a'a siḏa ra ananga.”<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">Luk. 6:31</ref></char></note><verse eid="MAT 7:12" /></para>
  <para style="s">Ngalana ga'a 'i tuḏu</para>
  <para style="r">(<ref loc="LUK 13:24">Luk. 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Osama mete'e ngalana ga'a 'i peletoro. Sababu ngalana re ngo'omo roata ga'a 'i sigasa ngowa'a toma naraka re ngowa'a repe ya mete'e. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Mada'a ngalana re ngo'omo ga'a 'i peletoro ga'a 'i sigasa ngowa'a toma 'ahu ma dara, ngowa'a repe ua ya sanga.<verse eid="MAT 7:14" /></para>
  <para style="s">Ate re enanga ma sowo'o</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Ni ma'istiari toma nabi-nabi sa-sakala. Ananga 'aḏi sapolo ra ngini ma tero sa'olo doba. Mada'a ma ba-banari ananga manga maksudu 'i sijira ninga ngo-ngaku ma tero sa'olo serigala ga'a 'i oro-oromo ngowa'a. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ngini ḏuanga i'a ni nana'o ananga sa'olo nabi sa-sakala mete'e manga ga'a. Ngini ni sanga ua 'anggur ma sowo'o toma rurubu dodowo'o, re ni sanga ua 'ara ma sowo'o toma goroa dodowo'o. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />So'o gena-ge ḏi'i, 'o ate 'i rousu, ma sowo'o 'i la-la. Mada'a 'o ate ma rousu ua, ma sowo'o 'i cira. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ate 'i rousu, sanga ua enanga ma sowo'o 'i cira. So'o gena-ge ḏi'i 'o ate 'i rousu ua, sanga ua enanga ma sowo'o la-la. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ate 'oru ḇato ga'a ma sowo'o rousu ua, wa tawele re tau'u toma u'u.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mat. 3:10</ref>; <ref loc="LUK 3:9">Luk. 3:9</ref></char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />So'o gena ḏi'i reo nabi-nabi sa-sakala. Tantu ḏua, ngini ni waro na'o ananga nabi sa-sakala sababu ananga manga de'oso re ḏegoro.”<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat. 12:33</ref></char></note><verse eid="MAT 7:20" /></para>
  <para style="s">Si'a'a, awa pa'i kanau ḇato</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk. 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Toma Kiamata ma Wangere, ngowa'a manga repe ḏuanga i'a 'aḏi 'aro'o Ngoi, ‘Ma Jou! Ma Jou!’ Mada'a ananga mo-moini ua 'aḏi osama nyo-nyoimi toma Soroga ma Pareta!<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note> Pa'i ngowa'a ga'a mete'e 'Ari Ḇaḇa 'ai mau, ananga gena-ge ḏuanga i'a 'aḏi sanga osama. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Toma wangere gena-ge, ngowa'a manga repe 'aḏi kanau ra Ngoi, ‘Ma Jou! Ma Jou! Wakutu ngomi mi nubuata mi pake 'Ani lomanga, re mi pake 'Ani lomanga di'a dusu'u roh ma jira, re ḏi'i mi pake 'Ani lomanga di'a 'a'a ga'a hera-heranga ma repe!’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Mada'a Ngoi ta sangoro, ‘Ngoi to nana'o ngini ua. Ni maḏagi ra Ngoi, sababu ngini ninga ga'a 'i cira!’ ”<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:9">Nya. 6:9</ref></char></note><verse eid="MAT 7:23" /></para>
  <para style="s">Wala ma tukanga ma pahe re wala ma tukanga ma haga</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk. 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Sababu gena-ge, ngowa'a mo-moini ga'a 'aḏi 'isene Ngoi 'ari demo re ya mete'e, ananga gena-ge ma tero sa'olo ngowa'a pahe matengo 'o side'oso 'ai wala toma maḏi ma re'u. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Kalaha besa'a lai lamo'o 'i sapolo singadolo ḇanyo dogo, re karawiana lai siḏi ya nga'unu wala gena-ge, enanga 'i ruba ua, sababu 'i side'oso toma maḏi ma re'u.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Mada'a ngowa'a mo-moini ga'a ya 'isene Ngoi 'ari demo, mada'a ya mete'e ua, ananga gena-ge ma tero sa'olo ngowa'a haga matengo ga'a side'oso wala toma dongi ma re'u. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Wakutu besa'a lai lamo'o 'i sapolo singadolo ḇanyo dogo re ma karawiana lai siḏi 'i nga'unu wala gena-ge, enanga 'i ruba singadolo 'i pinya'olo lai siḏi.”<verse eid="MAT 7:27" /></para>
  <para style="s">Yesus 'ai kuasa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Wakutu Yesus 'o doto'o togumu i'a, ngowa-ngowa'a toma ngi'i gena-ge ga'a 'aḏi 'isene 'Ai do-doto'o, ananga gena-ge 'aḏi dadi heranga madutu. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Sababu Unanga 'o doto'o rai kuasa ma tero ua sa'olo ananga manga guru-guru 'agama!<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">Mrk. 1:22</ref>; <ref loc="LUK 4:32">Luk. 4:32</ref></char></note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesus 'o si-la ngowa'a si-siḏi eno'o matengo</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mrk. 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Wakutu Yesus 'uci da'u kie tala, ngowa'a repe 'U mete'e Unanga. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Toma 'orasa gena-ge, ngowa'a si-siḏi eno'o matengo 'o sapolo re 'o maḏipolono ra Yesus 'ai biono re 'o kanau, “Jou na'o No nyengara, No si-la ngoi.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesus 'a sitoa'a i'a 'Ai giama re 'a siteru toma ngowa'a gena-ge re 'O kanau, “Ngoi to nyengara, ngana no la.” Toma 'orasa gena-ge ḏua, unanga 'ai si-siḏi ri iranga. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Ḏua Yesus 'o kanau, “ 'Elingi! Awa sijarita mangale gena-ge ra guna ḇato. Mada'a no tagi re no masijumu 'ani lese toma 'imam, la siwaro tala mangale ngana reno la. Pasala i'a no pula'a 'ani jou-jou ga'a mete'e Musa 'ai hukumu sa'olo bukiti rimoi toma ngowa-ngowa'a ḏi'i mangale ngana reno la.”<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">'Im. 14:1-32</ref></char></note><verse eid="MAT 8:4" /></para>
  <para style="s">Yesus 'o si-la Roma ma sordado ma sae'e matengo 'ai falalomu</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk. 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Wakutu Yesus 'o osama toma limau Kapernaum, Roma ma sordado ma sae'e matengo 'o sapolo ra Yesus 'o golo'o, la Yesus 'o riono unanga. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Unanga 'o kanau, “Jou, 'ari falalomu 'o siḏi toma wala, unanga 'o lu-lulu tai jingi'i re 'a cokutu 'ai lese mai nga'unu ua, sababu 'o basono tala lai si-siḏi madutu.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesus 'o kanau, “Ngoi to sapolo to si-la unanga.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Roma ma sordado ma sae'e gena-ge 'o sangoro i'a ra Yesus, “Jou, so'o gena-ge awa! Sababu ngoi to patasa ua to dawongo Jou tari wala. Jou, pa'i No siajele demo bale moi ḇato re 'ari falalomu ro la. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Sababu ngoi ḏi'i mai balasu to 'isene 'ari sae'e 'ai parenta. Re 'ari aḏutala sordado-sordado ananga ḏi'i balasu 'aḏi mete'e 'ari parenta. Na'o ngoi to soma'a 'ari aḏutala matengo, ‘Tagi!’ unanga 'o tagi, re na'o to 'aro'o 'ari aḏutala ma lelegu ‘Ino 'ane!’ unanga 'o sapolo ino. Na'o ngoi to soma'a 'ari budaka ‘No 'a'a ne!’ unanga ḏi'i 'o 'a'a.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Wakutu Yesus 'a 'isene Roma ma sordado ma sae'e 'o kanau so'o gena-ge togumu i'a, Unanga 'o heranga masala. Dadi Unanga 'o kanau i'a toma ngowa'a repe ga'a 'aḏi mete'e Unanga, “Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Toma ngowa'a Israel manga sigolona, Ngoi to sanga matengo i'a mai nyangu, ga'a 'ai ngo-ngaku ma de'e so'o nena-ne. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Mode'e! Ngowa'a Yahudi ua manga repe ḏuanga i'a 'aḏi sapolo da'a wangere ma la'o ino re toma wangere ma soḏu isa di'a oromo mamete'e rea Abraham, Ishak re Yakub toma Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note><note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">Luk. 13:29</ref></char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Momongolo ua ngowa'a Yahudi manga repe ga'a Ma Jou'ongu Madutu ro cumutu di'a dadi 'Ai 'umata, ananga gena-ge ḏuanga i'a 'aḏi sanga upa'a toma ngi'i hafu-hafu toma ḏuḏunu. Toma ngi'i gena-ge ananga ḏuanga i'a ya rerese ma gaḏi re ya doiti ma sangisara.”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mat. 22:13</ref>, <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk. 13:28</ref></char></note><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Ḏua Yesus 'o kanau i'a toma Roma ma sordado ma sae'e gena-ge, “No maḏibo, 'oru ga'a ngana na ngaku, gena-ge ḏua 'i dadi.”</para>
  <para style="p" vid="MAT 8:13">Re toma 'orasa gena-ge ḏua 'ai falalomu ro la.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesus 'o si-la ngowa'a manga repe</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mrk. 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Wakutu Yesus 'o osama ra Petrus 'ai wala ma dara, Unanga 'o oḏi'i 'a Petrus 'ai dedono we-were'a mo lu-lulu tami jingi'i sababu mo gagama. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesus 'a gu'u 'ami giama. Toma 'orasa gena-ge ḏua, 'ami gagama ri iranga. Gena ḏua, munanga mo momi'i re mo de-de'oso 'a Yesus.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Wakutu wangere tumunu, ngowa'a 'aḏi gasa ino ngowa'a ga'a roh ma jira ya'u dungosama manga repe ra Yesus. Unanga gena-ge pa'i 'o kanau demo bale moi ḇato, ḏua roh ma jira 'i supu re Unanga ya'u si-la ngowa'a mo-moini ga'a 'aḏi siḏi. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Mo-moini ga'a Yesus 'a si'a'a gena-ge, enanga 'i sitotomo 'oru ga'a Nabi Yesaya 'o kanau pasala ḏua:</para>
  <para style="q1" vid="MAT 8:17">“Unanga 'a doiti nanga sangisara,</para>
  <para style="q2" vid="MAT 8:17">re 'A si-la nanga si-siḏi.”<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">Yes. 53:4</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Ngowa-ngowa'a mau 'aḏi dadi Yesus 'ai me-mete'e</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Toma wangere rimoi, ngowa'a manga repe masala 'aḏi sigoloḏi 'a Yesus. Dadi wakutu Unanga ya'u oḏi'i ananga mo-moini, Unanga 'o soma'a 'ai me-mete'e la 'aḏi ḏu-ḏuanga ḏua di'a 'aḏi sidete si'a talaga kaci moi. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ḏua guru 'agama matengo sapolo ra Yesus re 'o kanau, “Guru, ngoi mau to mete'e Guru tagi le'a ḇato.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesus 'a sangoro ra unanga, “Serigala rema aḏu'u, re namo diwanga rema ngi'i, mada'a Ngoi, Manusia ma Ngowa'a Nau'u kari ngi'i ua di'a to masibatongo.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Gena ḏua, Yesus 'ai me-mete'e ma lelegu, 'o kanau, “Jou, pula'a loasa ngoi to maḏibo siḏa, la to palihara 'ari ḇaḇa. Gena ḏua kara tini mete'e.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Mada'a Yesus 'o sangoro ra unanga, “Ino mete'e Ngoi! Sieanga i'a ḇato ngowa'a sengene 'aḏi palihara ngowa'a sengene.”<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">Yesus 'ai maksudu so'o ne: Ngowa-ngowa'a ga'a ngaku Ngoi ua, ananga gena-ge ma tero sa'olo ngowa'a sengene. Dadi sieanga ḇato ananga gena-ge 'aḏi palihara ngowa'a sengene.</char></note><verse eid="MAT 8:22" /></para>
  <para style="s">Yesus 'a sitogumu rato</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mrk. 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yesus 'o mabalene toma oti Rai me-mete'e, kara 'aḏi sidete. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kage-kage rato 'i sapolo, talaga gena-ge ma momoku 'i baolo, singadolo oti ga'a ananga ya balene 'o momoku ya wa'ala i'a re ino, mada'a Yesus 'o otu ḇato. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ḏua 'Ai me-mete'e 'U tamanga Unanga re 'aḏi tuduba, “Jou! Riono! Ti'ara ua wo jala!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesus 'o kanau, “I'a sa'olo ni mojongo? Ngini ninga ngo-ngaku te'e ua ra Ngoi!” Gena ḏua, Yesus 'o te'oso re 'a ḇangata rato re talaga gena-ge. Re talaga 'i ogoro madutu sa'olo wag̱ele tau'u.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Yesus 'ai me-mete'e 'aḏi matai heranga madutu re 'aḏi kanau, “Ngowa'a 'oru Unanga nena-ne?! Singadolo rato re momoku mai ya mete'e 'Ai parenta!”<verse eid="MAT 8:27" /></para>
  <para style="s">Yesus 'o si-la ngowa'a nga muḏiḏi ga'a <optbreak /> roh ma jira ya'u dungosama</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mrk. 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Wakutu Yesus 'o ngadolo da'a talaga kaci moi toma daeraha Gadara, ngowa'a nga muḏiḏi ga'a roh ma jira ya'u dungosama 'aḏi supu da'a toma kubu ma 'aḏu'u ino re 'aḏi sapolo ra Yesus. Ananga nga muḏiḏi gena-ge 'aḏi pona lai cira madutu singadolo manga ngi'i gena-ge, matengo i'a mai ua nga'unu tola'a i'a. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ananga 'aḏi maboa-boa'a, “Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u, 'Ani maksudu 'oru ra ngomi? Kalaha ma 'orasa ngadolo nyangu, Ngana no mau sisikisa ngomi?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Kiḏanga ua toma ngi'i gena-ge 'age rema soto ma repe 'i disa ngo-ngoromo. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Roh-roh ma jira gena-ge 'i golo'o ra Yesus, “Na'o no soma'a ngomi mi supu, soma'a mi osama toma soto-soto gena-ge.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesus 'o kanau, “Supu!” Dadi roh-roh ma jira gena-ge 'i supu toma ngowa'a nga muḏiḏi, re 'i osama toma soto-soto. Ḏua, ma soto enanga 'i masiwale toma bawata ma 'uḏu singadolo masieta'a toma talaga, ḏua ri jala.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Soto ma sowohi ananga matai lalara sapolo toma limau re ya sijarita 'oru ga'a 'i dadi gena-ge, re ya sijarita ḏi'i mangale 'oru ga'a 'i dadi toma ngowa'a nga muḏiḏi ga'a roh ma jira ya'u dungosama. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Dadi ngowa-ngowa'a mo-moini toma limau gena-ge 'aḏi sapolo ma'u sanga ra Yesus. Wakutu ananga 'aḏi oḏi'i Yesus, ananga 'aḏi golo'o mode-mode'e, la Yesus jau-jau sisoi'i tala ananga manga daeraha gena-ge.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesus si-la ngowa'a ḇolo matengo</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mrk. 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Dadi Yesus 'o mabalene toma oti, kara 'o masala da'a talaga kaci moi re 'o maḏibo Tai gamu Kapernaum. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Toma gamu gena-ge ngowa'a nga muḏuo i'a 'aḏi gasa ino ngowa'a ḇolo matengo ga'a 'u sigare toma 'usungana. Wakutu Yesus 'o oḏi'i ananga manga ngo-ngaku lai te'e, Unanga 'o kanau i'a toma ngowa'a ḇolo gena-ge, “ 'Ari ngowa'a, awa 'ani 'akala re sinyingara 'i rapo'o, 'ani ḏosa-ḏosa 'i singi-ngiranga ḏua.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />'Age rema guru-guru 'agama nga muḏuo i'a ga'a 'aḏi 'isene Yesus 'ai demo-demo gena-ge re 'aḏi makanau tamanga 'akala re sinyingara ma dara, “Ngowa'a nena-ne 'o je-jengere Ma Jou'ongu Madutu!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesus 'a waro ananga manga fikirana, dadi 'O kanau, “I'a sa'olo ni mafikiri 'ori i'a ma jira taninga 'akala re sinyingara ma dara? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Le'a lebe gapanga si'a'a: Ngoi nyengara to kanau, ‘ 'Ani ḏosa ta singi-ngiranga ḏua’ bolo, nyengara to kanau, ‘Momi'i ie, re no tagi’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Mada'a nange-ne Ngoi ta sibukiti ra ngini mangale Ngoi, Manusia ma Ngowa'a Nau'u masiretene rari kuasa nga'unu ta singi-ngiranga ngowa-ngowa'a manga ḏosa toma dungia nena-ne.” Gena ḏua, Yesus 'o kanau i'a toma ngowa'a ḇolo gena-ge, “Momi'i ie, na tede 'ani 'usungana re no maḏibo!”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Ḏua ngowa'a ḇolo gena-ge 'o te'oso re 'o maḏibo tai wala. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Wakutu ngowa'a repe 'aḏi oḏi'i so'o gena, ananga 'aḏi mojongo re 'aḏi puji re silamo'o Ma Jou'ongu Madutu, sababu Unanga ro pula'a 'Ai kuasa lamo'o masala toma manusia.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesus 'o 'aro'o Matius dadi Unanga 'ai me-mete'e</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mrk. 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Gena ḏua, Yesus 'o sisoi'i tala ngi'i gena-ge. Tai ḏo-ḏagi ma dara 'o oḏi'i ngowa'a golo-golo'o balastengi matengo 'ai lomanga Matius 'o madi-dirini tai kantor. Yesus kanau i'a ra unanga, “Ino mete'e Ngoi.” Ḏua Matius ro te'oso, kara 'o mete'e Yesus.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Wakutu Yesus 'o oromo ra Matius 'ai wala, ngowa'a golo-golo'o balastengi manga repe 'aḏi sapolo, mamete'e reo ngowa'a ga'a si'aro'o ngowa'a baraḏosa. Ananga mo-moini 'aḏi oromo mamete'e rea Yesus re 'Ai me-mete'e. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />'Age rema ngowa'a Farisi ga'a 'aḏi oḏi'i i'a so'o gena, ananga 'aḏi sano ra Yesus 'ai me-mete'e, “I'a sa'olo ninga guru Unanga 'o oromo mamete'e reo ngowa-ngowa'a golo-golo'o balastengi re ngowa'a baraḏosa?”<note caller="-" style="x"><char style="xo" closed="false">9:10-11 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luk. 15:1-2</ref>, <ref loc="LUK 15:1-2">15:1-2</ref></char></note><verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesus 'a 'isene so'o gena re 'O kanau, “Ngowa'a kamanga si-siḏi ua 'aḏi paralu dotere ua. Pa'i ngowa'a remanga si-siḏi ḇato, ananga 'aḏi paralu dotere. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />So'o gena ḏi'i, Ngoi to sapolo ua di'a 'aro'o ngowa'a loasa re banari mada'a to sapolo di'a 'aro'o ngowa'a baraḏosa. Dadi ngini ni disa waro toma Boku 'Ofi-'Ofi ma dara bu-bula'a nena-ne ma ngale: ‘Ngoi to mau ngowa'a 'aḏi sijumu manga 'akala re sinyingara ma la-la toma ngowa'a lelegu, awa pa'i 'aḏi pula'a jou-jou haiwani ra Ngoi!’ ”<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos. 6:6</ref>; <ref loc="MAT 12:7">Mat. 12:7</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">Wakutu Yesus 'age Tai me-mete'e sigolona moju, <optbreak /> 'Ai me-mete'e 'aḏi puasa ua</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mrk. 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Togumu i'a, 'a Yohanes tukanga baptis, unanga gena-ge 'ai me-mete'e 'aḏi sapolo ra Yesus. Ananga 'aḏi sano, “I'a sa'olo 'Ani me-mete'e 'aḏi puasa ua, mada'a ngomi re ngowa'a Farisi, mi puasa?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesus 'a sangoro, “Sanga ua, ioro re nongoḏu toma molo'ara ma laya ananga 'aḏi garura, na'o geri molo'ara na-nau'u 'age tamanga sigolona moju. Mada'a ḏuanga i'a ma 'orasa 'i ngadolo na'o geri molo'ara gena-ge ananga 'u 'oro tamanga sigolona. Toma 'orasa gena-ge, ananga ḏuanga i'a 'aḏi puasa.”<verse eid="MAT 9:15" /></para>
  <para style="s">Awa capuru Yesus 'ai do-doto'o reo <optbreak /> ngowa'a Yahudi manga 'atoranga</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Matengo ua 'o pata 'ai baju ma siḏa reo ba-bata ma su-sungi. Sababu ba-bata ma su-sungi 'i taunu singadolo baju ma siḏa gena-ge 'i 'acingi lebe lamo'o i'a. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />So'o gena ḏi'i, 'anggur ma su-sungi sidai'i ua toma 'anggur ma ngi'i ma siḏa.<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">'anggur ma ngi'i si'a'a reo haiwani ma eno'o.</char></note> Sababu ngi'i ma siḏa gena-ge 'i 'acingi, kara 'anggur 'i pa'ala re 'anggur ma ngi'i ri cira ḏi'i! 'Anggur ma su-sungi balasu sidai'i toma 'anggur ma ngi'i ma su-sungi, la bae 'anggur bae ma ngi'i, enanga 'i la-la mo-moini.”<verse eid="MAT 9:17" /></para>
  <para style="s">Wala puji ma sae'e 'ai ngowa'a were'a re <optbreak /> we-were'a ga'a macigi Yesus 'ai juba</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mrk. 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Wakutu Yesus 'o ka-kanau moju ra Yohanes 'ai me-mete'e, wala puji ma sae'e 'o sapolo ra Yesus. Unanga 'o maḏipolono ra Yesus 'ai biono re 'o kanau, “ 'Ari ngowa'a were'a aro mo sengene i'a, na'o nyengara gari'a No sapolo re Nimi cigi, la munanga dadunu mo 'ahu.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Yesus 'o te'oso re 'o tagi mamete'e reo wala puji ma sae'e gena-ge re 'Ai me-mete'e mamete'e ḏi'i.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="MAT 9:20-21" />Toma ngo'omo ma golona we-were'a matengo mo siḏi, 'ami ngaunu pa'ala ma di'ara ri musungu nyagi moi re romoḏiḏi ḏua sa'olo mo maoḏi'i, munanga mo sapolo re mo maco-cori'i i'a ra Yesus, kara ma cigi Yesus 'ai juba ma dere da'a ḏuḏunu ino. Tami 'ulungu ma dara, “Na'o ta cigi 'Ai juba ḇato, ngoi to la.”<verse eid="MAT 9:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Toma 'orasa gena-ge Yesus 'o magelelo re 'o oḏi'i we-were'a gena-ge. Ḏua Yesus 'o kanau, “ 'Ari ngowa'a na site'e tala 'ani 'akala re sinyingara, sababu ngana 'ani ngo-ngaku ra Ngoi, ngana no la.” Toma 'orasa gena-ge ḏua, we-were'a gena-ge mo la.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Gena ḏua, Yesus 'o ngadolo toma wala puji ma sae'e 'ai wala. I'a da'a, Unanga 'o oḏi'i ngowa-ngowa'a ga'a ḇisa serulingi di'a palihara mayeti re ngowa'a repe ya rerese ma gaḏi. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Unanga 'o kanau ra ananga, “Ngini ni supu mo-moini. Ngowa 'olo nena-ne mo sengene ua munanga pa'i mo otu ḇato.”<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="ft" closed="false">Yesus 'ai maksudu so'o ne: Kalaha ngowa 'olo gena-ge mo sengene Unanga nyengara dadunu 'o si'ahu moju munanga ma tero sa'olo manusia nyengara 'aḏi simomi'i ngowa'a ga'a 'o otu ḏua.</char></note> Ananga mo-moini 'aḏi nye-nyelo'o Unanga.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Dadi ananga mo-moini 'aḏi matai supu. Ḏua, Yesus 'o osama toma ngowa 'olo gena-ge 'ami kamara kara 'a gu'u 'ami giama. Toma 'orasa gena-ge ḏua, ngowa 'olo were'a gena-ge dadunu mo 'ahu moju re mo momi'i. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Habari gena-ge ananga ya sihabari toma daeraha gena-ge mo-moini.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesus 'o si-la ngowa'a nga muḏiḏi manga la'o hafu</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesus 'o tagi sisoi'i tala ngi'i gena-ge re 'a dowanga 'ai ḏo-ḏagi. Toma ngo'omo ma golona, ngowa'a hafu nga muḏiḏi 'aḏi tutu'u ra Unanga 'ai ḏuḏunu. Ananga 'aḏi poa'a, “Jou, 'Olana Daud 'ai ju'uda,<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note> no sijumu 'Ani 'akala re sinyingara ma la-la ra ngomi!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Wakutu Yesus 'o osama toma wala, ngowa'a hafu nga muḏiḏi gena-ge 'aḏi sapolo ra Unanga. Yesus 'O sano ra ananga, “ 'Oru ngini ni ngaku mangale Ngoi nga'unu to si-la ngini?”</para>
  <para style="p" vid="MAT 9:28">Ananga 'aḏi sangoro, “Jou, ngomi ngaku gena-ge!”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ḏua Yesus 'a cigi ananga manga la'o re 'O kanau, “Sababu ninga ngo-ngaku, 'oru ga'a ngini ni mau, enanga 'i dadi.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Toma 'orasa gena-ge ḏua, ananga raḏi oḏi'i. Unanga 'o sipo-poma ananga, “Awa ni siajele hali nena-ne ra guna ḇato.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Mada'a ananga 'aḏi tagi re ya sihabari mangale Yesus toma daeraha sitabi donga.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesus 'o si-la ngowa'a mou matengo</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Wakutu ananga nga muḏiḏi gena-ge ga'a aro raḏi la 'aḏi tagi, 'age rema ngowa'a 'aḏi gasa ino ra Yesus ngowa'a mou matengo ga'a roh ma jira 'u dungosama. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesus 'a dusu'u roh ma jira gena-ge. Re toma 'orasa gena-ge ḏua, ngowa'a mou nga'unu ro kanau. Ngowa'a repe 'aḏi matai heranga re 'aḏi kanau, “Soi moi nyangu, ngomi oḏi'i ga'a hera-heranga ma duhu so'o nena-ne toma Israel!”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Mada'a ngowa-ngowa'a Farisi 'aḏi kanau, “Roh ma Jira ma 'Olana<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="fk" closed="false">“Roh ma Jira ma 'Olana” </char><char style="ft" closed="false">ma ngale 'Iblisi </char></note> ri pula'a kuasa ra Unanga nena-ne di'a dusu'u roh-roh ma jira.”<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">Mat. 10:25</ref>, <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mrk. 3:22</ref>; <ref loc="LUK 11:15">Luk. 11:15</ref></char></note><verse eid="MAT 9:34" /></para>
  <para style="s">Yesus 'o basono dadalara wakutu 'O oḏi'i ngowa'a repe</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesus 'o tagi 'o tuḏu limau-limau, re gamu-gamu toma daeraha sitabi donga. Unanga 'o doto'o toma wala-wala puji re singadolo Habari Roanga mangale Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> Unanga 'o si-la ngowa-ngowa'a mo-moini remanga si-siḏi ma rupa 'oru ḇato.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat. 4:23</ref>; <ref loc="MRK 1:39">Mrk. 1:39</ref>; <ref loc="LUK 4:44">Luk. 4:44</ref></char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Wakutu Yesus 'o oḏi'i ngowa'a repe Tai 'akala re sinyingara ma dara 'i baolo dadalara, sababu ananga manga susa re sangisara ma repe re ya riono manga diri nga'unu ua. Ananga gena-ge ma tero sa'olo doba kama sowohi ua.<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Nyo. 27:17</ref>; <ref loc="1KI 22:17">1'Oln. 22:17</ref>; <ref loc="2CH 18:16">2Taw. 18:16</ref>; <ref loc="EZK 34:5">Yeh. 34:5</ref>; <ref loc="ZEC 10:2">Za. 10:2</ref>; <ref loc="MRK 6:34">Mrk. 6:34</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Dadi Yesus 'o kanau Tai me-mete'e, “Ngowa-ngowa'a nena-ne ma tero sa'olo guḏa ma hasili lai lamo'o 'i 'utu'u nyangu, mada'a ngowa'a 'utu-'utu'u 'u 'aḏi repe ua. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Sababu gena-ge, ngini ni golo'o toma guḏa ma dutu, la Unanga 'o siḏingoto ngowa'a 'utu-'utu'u di'a ya lomu guḏa ma hasili.”<note caller="-" style="x"><char style="xo" closed="false">9:38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luk. 10:2</ref></char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesus 'ai so-soma'a nga nyagi moi re nga muḏiḏi</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mrk. 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />'Age wange rimoi, Yesus 'o 'aro'o 'Ai me-mete'e 'aḏi malomu. Ḏua 'o pula'a kuasa ra ananga, di'a 'aḏi dusu'u roh ma jira re 'aḏi si-la ngowa-ngowa'a mo-moini ga'a remanga si-siḏi ma rupa 'oru ḇato.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />So-soma'a nga nyagi moi re nga muḏiḏi manga lomanga: mulaingi, 'a Simon, ga'a si'aro'o ḏi'i 'a Petrus re 'a Andreas: ananga gia nongoḏu; kara 'a Yakobus re 'a Yohanes; ananga gena-ge gia nongoḏu ga'a manga ḇaḇa Zebedeus. <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Ḏua 'a Filipus re 'a Bartolomeus; 'a Tomas re 'a Matius golo-golo'o balastengi; 'a Yakobus Alfeus 'ai ngowa'a nau'u, re 'a Tadeus. <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Ma ḏo-ḏogumu 'a Simon ga'a 'o dadalara masala bangsa Israel re 'a Yudas Iskariot; unanga gena-ge 'o wu'unu 'a Yesus.<verse eid="MAT 10:4" /></para>
  <para style="s">Yesus 'o doto'o 'ai so-soma'a, la ya siḏagi 'Ai munara</para>
  <para style="r">(<ref loc="MRK 6:6b-13">Mrk. 6:6b-13</ref>; <ref loc="LUK 9:1-6">Luk. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesus 'ai so-soma'a nga nyagi moi re nga muḏiḏi gena-ge, Unanga ya'u 'utusu 'o bererongo so'o ne: “Awa ni tagi toma ngowa-ngowa'a Yahudi ua manga daeraha. Re awa tuḏu toma limau-limau ngowa'a Samaria. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Mada'a ni tagi toma ngowa-ngowa'a Israel: Ananga gena-ge ma tero sa'olo doba ga'a 'i iranga. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Siajele ra ananga: ‘Ti'ara riwara, Soroga ma Pareta<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta</char></note> 'i ngadolo toma dungia nena-ne.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ni si-la ngowa-ngowa'a siḏi, ni dadunu si'ahu moju ngowa'a ga'a raḏi sengene, ni si-la ngowa-ngowa'a si-siḏi eno'o, re ni dusu'u roh-roh ma jira. Ni sanga barakati gena-ge mo-moini kama fangu ua, dadi ni pula'a ḏi'i ni golo'o ma ngogele awa. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Awa ni gasa pipisi guraci, pipisi salaka, bolo pipisi tamḇaga. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Awa ni gasa ḏi'i tohe, bolo capato, bolo didiki re baju ga'i ḏiḏi toma ḏo-ḏagi ma dara. Sababu ngowa'a ga'a 'aḏi munara di'a Ma Jou'ongu Madutu, ananga gena-ge sanga manga 'ahu ma paralu toma ngowa'a ga'a ya'u de-de'oso.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1Kor. 9:14</ref>; <ref loc="1TI 5:18">1Tim. 5:18</ref></char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Na'o ngini ni ngadolo toma limau, bolo toma gamu, ni disa matengo ga'a nyengara 'o dawongo ngini. Tegoro ra unanga singadolo ngini ni dowanga ninga ḏo-ḏagi. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Wakutu ngini ni osama toma wala, ni kanau: ‘Na'o nga'unu Ma Jou'ongu Madutu 'o sibarakati ngini.’ <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Na'o ngowa'a toma wala gena-ge 'aḏi dawongo ngini, tantu ḏua Ma Jou'ongu Madutu 'o sibarakati ananga. Mada'a na'o ananga 'aḏi dawongo ngini ua, tantu ḏua Ma Jou'ongu Madutu 'o sibarakati ananga ua. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Na'o ngitu re ngale toma wala bolo ngowa-ngowa'a toma limau, ananga 'aḏi dawongo ngini ua, bolo ngowa'a 'aḏi oḏu'u 'isene ngini, sisoi'i tala ngi'i gena-ge re ni sesara ninga rou ma korou'u.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Som. 13:51</ref></char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Toma Kiamata ma Wangere, ngowa-ngowa'a toma limau gena-ge, ḏuanga i'a 'aḏi sanga hukumu lebe tubuso reo ngowa-ngowa'a toma limau Sodom re Gomora 'ua re 'au wali!”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luk. 10:4-12</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Do. 19:24-28</ref>; <ref loc="MAT 11:24">Mat. 11:24</ref> </char></note><verse eid="MAT 10:15" /></para>
  <para style="s">Sanga sikisa toma biono i'a</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mrk. 13:9-13</ref>; <ref loc="LUK 21:12-17">Luk. 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“Ni 'isene la-la: Ngoi nena-ne to 'utusu ngini sa'olo doba toma serigala ma sigolona. Ngini balasu ni pahe sa'olo cuku'u re ninga 'akala re sinyingara 'i boloto sa'olo namo dara.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">Luk. 10:3</ref></char></note><verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />Ni ma'istiari ino, sababu ngowa'a ḏuanga i'a 'aḏi cako'o ngini, re 'aḏi sitalaḏi toma mahkamah-mahkamah. Ngini ḏuanga i'a ni sanga ca'olo toma wala-wala puji. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ngowa'a ḏuanga i'a 'aḏi gasa ngini sitalaḏi toma ngowa'a la-lamo'o re 'olana-'olana, sababu ngini Ngoi 'ari me-mete'e. Toma 'orasa gena-ge, ngini ni sanga donga rimoi di'a ni pula'a sakisi mangale Ngoi ra ananga gena-ge re ngowa'a Yahudi ua ḏi'i. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Mada'a wakutu ngowa'a 'aḏi gasa ngini sitalaḏi toma juruhakimi, ni mojongo awa mangale 'oru ga'a balasu ngini ni siajele, bolo 'oru ga'a balasu ngini sangoro. Sababu toma 'orasa gena-ge, Ma Ngagara 'Ofi-'Ofi ḏuanga i'a 'i pula'a demo ra ngini. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Dadi ngini ninga demo-demo ma 'asala ra Ma Jou'ongu Madutu ga'a 'O tegoro toma soroga. Unanga ḏuanga i'a 'O pake Ma Ngagara 'Ofi-'Ofi, la ngini ni waro 'oru ga'a balasu ni siajele.<note caller="-" style="x"><char style="xo" closed="false">10:17-20 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Mrk. 13:9-11</ref>; <ref loc="LUK 12:11-12">Luk. 12:11-12</ref>, <ref loc="LUK 21:12-15">21:12-15</ref></char></note><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Toma 'orasa gena-ge ḏi'i, ngowa'a matengo ḏuanga i'a 'o sipula'a 'ai ioro bolo nongoḏu ga'a 'o ngaku Ngoi, di'a ngowa'a 'u sisengene. So'o gena-ge ḏi'i ḇaḇa ḏuanga i'a 'o sipula'a 'ai ngowa'a ga'a 'o ngaku Ngoi di'a ngowa'a 'u sisengene. Manga ngowa-ngowa'a masiretene ḏuanga i'a 'aḏi malawana tamanga ḇaḇa re ngina ga'a 'aḏi ngaku Ngoi re 'aḏi sipula'a ananga gena-ge di'a ngowa'a ya'u sisengene.<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">Mrk. 13:12</ref>; <ref loc="LUK 21:16">Luk. 21:16</ref></char></note> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ngowa'a mo-moini ḏuanga i'a 'aḏi emono ngini, sababu ngini Ngoi 'ari me-mete'e. Mada'a ngowa'a ga'a 'aḏi cako'o namo-namoto tamanga ngo-ngaku ra Ngoi singadolo ma ḏo-ḏogumu, ḏuanga i'a 'aḏi sanga salamata.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mat. 24:9</ref>, <ref loc="MAT 24:13">13</ref>; <ref loc="MRK 13:13">Mrk. 13:13</ref>; <ref loc="LUK 21:17">Luk. 21:17</ref></char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Na'o ngini ni sanga sikisa toma limau rimoi, ni wiḏi toma limau rimoi ḏi'i. Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Limau-limau Israel ngini na tuḏu mo-moini nyangu, Ngoi, Manusia ma Ngowa'a Nau'u ḏuanga i'a reto sapolo.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Murid matengo ua lebe pahe i'a reo 'ai guru, re 'o budaka lebe la-lamo'o ua i'a reo 'ai tuanga.<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">Luk. 6:40</ref>; <ref loc="JHN 13:16">Yoh. 13:16</ref>, <ref loc="JHN 15:20">15:20</ref></char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Lai rousu ḏua na'o murid 'o dadi sa'olo 'ai guru, re budaka 'o dadi sa'olo 'ai tuanga. Na'o Ngoi ma tero sa'olo sae'e toma ngale ma dara silomanga Beelzebul,<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fk" closed="false">Beelzebul: </char><char style="ft" closed="false">enanga Roh ma Jira ma 'Olana bolo 'Iblisi.</char></note> ma la-lamo'o i'a ḏi'i ngini toma wala ma dara, silomanga lebe cira i'a ḏi'i!”<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>, <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mrk. 3:22</ref>; <ref loc="LUK 11:15">Luk. 11:15</ref></char></note><verse eid="MAT 10:25" /></para>
  <para style="s">Pa'i mojongo Ma Jou'ongu Madutu ḇato</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk. 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Dadi mojongo awa manusia. 'Oru ḇato ga'a 'i gogono nange-ne, ḏuanga i'a 'i supu, re 'oru ḇato ga'a 'i rahasia nange-ne, ḏuanga i'a 'i waiti.<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mrk. 4:22</ref>; <ref loc="LUK 8:17">Luk. 8:17</ref></char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />'Oru ga'a Ngoi to kanau ra ngini toma hafu-hafu ngini balasu na dadunu kanau toma tarangi. Re 'oru ga'a to jujuḏu taninga ngau'u, ngini balasu ni siajele toma mandan. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Awa ni mojongo manusia. Sababu ananga pa'i 'aḏi sisengene ninga lese, mada'a manga kuasa 'i cua di'a sihukumu ngini toma naraka. Momongolo ua Ma Jou'ongu Madutu, Unanga rai kuasa, 'O sisengene ninga lese re 'O sihukumu ngini toma naraka. Sababu gena-ge, mojongo pa'i Ma Jou'ongu Madutu ḇato. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Pipisi senga moi, nyengara sitibo namo cuḇili romoḏiḏi. Kalaha so'o gena na'o Ḇaḇa 'ai mau ua, rimoi mai ua 'i eta'a toma tana'a. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ninga utu taninga sae'e mai Ma Jou'ongu Madutu 'a waro ma repe. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Sababu gena-ge ni mojongo awa! Ngini ninga ijana lebe lamo'o i'a reo namo cuḇili ma repe ra Ma Jou'ongu Madutu 'ai momina!”<verse eid="MAT 10:31" /></para>
  <para style="s">Mangaku mete'e Yesus toma mandan</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk. 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“ 'A guna ḇato 'o mangaku toma mandan mangale unanga 'Ari me-mete'e, Ngoi ga'a toma soroga Tari Ḇaḇa 'ai biono Ngoi nena-ne ḏi'i to mangaku unanga 'Ari me-mete'e. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Mada'a 'a guna ḇato 'o masoloto Ngoi toma mandan sababu 'o siajele mangale unanga 'Ari me-mete'e ua, Ngoi ga'a toma soroga Tari Ḇaḇa 'ai biono, Ngoi nena-ne ḏi'i to soloto unanga, To siajele unanga nena-ne 'Ari me-mete'e ua!”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2Tim. 2:12</ref></char></note><verse eid="MAT 10:33" /></para>
  <para style="s">Yesus 'o gasa dame ua, mada'a parangi</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk. 12:51-53</ref>, <ref loc="LUK 14:26-27">14:26-27</ref>, <ref loc="LUK 17:33">17:33</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Awa ngini ni ta'ajiri Ngoi to sapolo toma dungia di'a to gasa dame. Ngoi to gasa dame ua, mada'a parangi. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Sababu Ngoi 'ari ta-sapolo, ngowa'a nau'u 'o malawana 'ai ḇaḇa, ngowa were'a mo malawana 'ami ngina, dunungu tagi-tagi ino mo malawana 'ami dunungu wala. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Dadi ma'u saturu, ananga gena-ge 'aḏi 'ahu toma wala ḏu moi.<note caller="-" style="x"><char style="xo" closed="false">10:34-36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mi. 7:6</ref></char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />'A guna ḇato 'o lebe dadalara 'ai ḇaḇa bolo 'ai ngina reo Ngoi, unanga gena-ge 'o patasa ua 'o dadi Ngoi 'ari me-mete'e. So'o gena ḏi'i, ngowa'a ga'a lebe dadalara manga ngowa'a nau'u bolo ngowa'a were'a reo Ngoi, ananga gena-ge 'aḏi patasa ua 'aḏi dadi Ngoi 'ari me-mete'e.<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="LUK 14:26">Luk. 14:26</ref></char></note> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />'A guna ḇato 'o oḏu'u doiti 'ai salib re 'o mete'e Ngoi, unanga 'o patasa ua 'o dadi Ngoi 'ari me-mete'e sababu unanga 'o oḏu'u sanga susa re sangisara.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat. 16:24</ref>; <ref loc="MRK 8:34">Mrk. 8:34</ref>; <ref loc="LUK 9:23">Luk. 9:23</ref></char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />'A guna ḇato 'o kadiarata pa'i 'ai 'ahu toma dungia nena-ne ḇato, unanga gena-ge 'o sanga ua 'ahu kasingado-ngadolo i'a. Mada'a 'a guna ḇato 'o ḏu-ḏuanga ḏua di'a 'o sengene sababu 'o mete'e Ngoi; unanga gena-ge ḏuanga i'a 'o sanga 'ahu kasingado-ngadolo i'a.”<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mat. 16:25</ref>; <ref loc="MRK 8:35">Mrk. 8:35</ref>; <ref loc="LUK 9:24">Luk. 9:24</ref>, <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yoh. 12:25</ref></char></note><verse eid="MAT 10:39" /></para>
  <para style="s">Ga'a lai rousu, sanga ngogele</para>
  <para style="r">(<ref loc="MRK 9:41">Mrk. 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“ 'A guna ḇato 'o dawongo ngini, 'o dawongo Ngoi ḏi'i. Re 'a guna ḇato 'o dawongo Ngoi, 'o dawongo Unanga ga'a Ro 'utusu Ngoi.<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">Mrk. 9:37</ref>; <ref loc="LUK 9:48">Luk. 9:48</ref>, <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">Yoh. 13:20</ref></char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />'A guna ḇato 'o dawongo nabi sababu unanga nabi, ḏuanga i'a 'o sanga ngogele ma tero sa'olo nabi 'ai ngogele. Re 'a guna ḇato 'o dawongo ngowa'a loasa re banari sababu unanga 'o loasa re banari, ḏuanga i'a 'o sanga ngogele ma tero sa'olo ngowa'a loasa re banari. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />'A guna ḇato pula'a ḇanyo malata toma ngowa'a mapake ua matengo sababu unanga Ngoi 'ari me-mete'e, ni ngaku mode-mode'e 'Ari demo-demo nena-ne: tantu ḏua unanga gena-ge ḏuanga i'a 'o sanga 'ai ngogele!”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yesus re 'a Yohanes tukanga baptis</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesus 'o doto'o 'Ai me-mete'e nga nyagi moi re nga muḏiḏi pasala i'a, Unanga 'o tagi di'a 'O doto'o re 'O singadolo Habari Roanga toma limau-limau ma co-cori.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Wakutu Yohanes tukanga baptis, unanga gena-ge 'o osama bui re 'o 'isene mangale 'O Kristus 'ai munara, unanga 'o 'utusu 'ai me-mete'e nga muḏuo i'a 'aḏi tagi sano ra Yesus so'o ne: <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Mete'e Ma Jou'ongu Madutu 'ai jaji, Jou masiretene 'O Kristus, bolo ngomi mi totoma ngowa'a lelegu?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesus 'a sangoro, “Ni maḏibo re siajele ra Yohanes, mangale 'oru ga'a ngini ni 'isene re ni oḏi'i: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Ngowa'a hafu 'aḏi oḏi'i, ngowa'a ḇolo 'aḏi tagi, ngowa'a si-siḏi eno'o 'aḏi la, ngowa'a popongolo 'aḏi 'isene, ngowa'a raḏi sengene, dadunu 'aḏi 'ahu moju, re Habari Roanga ra Ma Jou'ongu Madutu ino Ngoi ta singadolo toma ngowa-ngowa'a ma dinga'unu ua.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Yes. 35:5-6</ref>, <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Bara'utungu ngowa'a ga'a manga ngo-ngaku kama elala ua ra Ngoi!”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Wakutu Yohanes tukanga baptis 'ai me-mete'e gena-ge 'aḏi tagi-tagi moju, Yesus mulaingi 'o kanau toma ngowa'a repe mangale Unanga. Unanga 'o kanau, “Ngini ni tagi toma daeraha baulaco di'a ni oḏi'i 'oru?! Sanga ua, ngini ni tagi oḏi'i matengo ga'a 'o sitaka-taka mangale 'Ai habari ma tero sa'olo rurubu ma so'a ngai moi ga'a karawiana ya wusu! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Dadi ngini ni tagi di'a ni oḏi'i 'oru?! Ngowa'a matengo ga'a mapake rousu?! Sanga ua! Sababu ngowa'a ga'a mapake rousu 'aḏi tegoro toma kadato! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Dadi ngini ni tagi di'a ni oḏi'i 'oru?! Nabi?! Tero mode'e. Sidogo ḏi'i, unanga gena-ge lebe la-lamo'o i'a reo nabi ma siḏa-siḏa i'a. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Sababu toma Boku 'Ofi-'Ofi 'age rema bu-bula'a nena-ne 'i silefo mangale 'a Yohanes. Ma Jou'ongu Madutu 'o kanau so'o ne:</para>
  <para style="q1" vid="MAT 11:10">‘Nena-ne Ngoi 'ari so-soma'a.</para>
  <para style="q1" vid="MAT 11:10">Ngoi ḏuanga i'a to 'utusu unanga siḏa, kara Ngana,</para>
  <para style="q1" vid="MAT 11:10">la unanga ḏuanga i'a 'a sidodahe ngo'omo di'a Ngana.’<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal. 3:1</ref></char></note><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Toma dungia nena-ne matengo i'a mai ua ga'a sibuoro lebe la-lamo'o i'a rea Yohanes tukanga baptis. Mada'a mulaingi nange-ne, ngowa'a ma pake ua ga'a 'o osama nyo-nyoimi toma Soroga ma Pareta,<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> unanga gena-ge 'o dadi ngowa'a lebe la-lamo'o i'a rea Yohanes. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Toma wakutu 'a Yohanes mulaingi 'o siḏagi Ma Jou'ongu Madutu 'ai munara singadolo nange-ne, Ma Jou'ongu Madutu 'ai 'umata 'aḏi sanga dola'aku toma ngowa-ngowa'a ga'a 'aḏi makutale mau 'aḏi kuasa ya siḏagi manga de'e. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Singadolo Yohanes gena-ge 'o sapolo, 'a Musa 'ai hukumu mo-moini re nabi manga do-doto'o, enanga 'i siajele mangale 'oru ga'a balasu 'i dadi.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luk. 16:16</ref></char></note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Re na'o ngini mau ni ngaku, Yohanes unanga 'o ma tero 'a Elia, unanga 'ai ta-sapolo ri sinubuata pasala ḏua.<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal. 4:5</ref>; <ref loc="MAT 17:10-13">Mat. 17:10-13</ref>; <ref loc="MRK 9:11-13">Mrk. 9:11-13</ref></char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Na'o reninga ngau'u ni 'isene la-la!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Ngowa-ngowa'a toma 'orasa nange-ne, Ngoi ta site-tero reo 'oru?! Ananga ma tero sa'olo ngowa 'olo 'aḏi maḏegoro toma pasara, toropo moi-toropo moi 'aḏi ma'u sangoro i'a re ino ma'u ngali-ngali,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘Ngomi ḇisa serulingi ḏua</para>
  <para style="q2" vid="MAT 11:17">mada'a ngini ni roje ua,</para>
  <para style="q1" vid="MAT 11:17">ngomi mi nyanyi-nyanyi duka re balisa</para>
  <para style="q2" vid="MAT 11:17">mada'a ngini ni rerese ma gaḏi ua.’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Ngoi 'ari maksudu so'o ne: Yohanes 'o sapolo re unanga 'o ka'e 'anggur ua re 'o puasa ḏi'i. Mada'a ngowa'a 'u dawongo ua 'aḏi kanau, ‘Unanga 'o roh ma jira 'u dungosama!’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Ngoi, Manusia ma Ngowa'a Nau'u reto sapolo, To oromo re ka'e 'anggur. Nange-ne ḏi'i ngowa'a raḏi dawongo Ngoi ua 'aḏi kanau, ‘Oḏi'i Unanga gena-ge 'O da-danata re 'O 'etolo, re Ma'u ḏagilomu reo ngowa-ngowa'a golo-golo'o balastengi re ngowa-ngowa'a baraḏosa!’ Kalaha so'o gena, Ma Jou'ongu Madutu 'ai 'akala ma soro'unu 'i waiti banari ra Ma Jou'ongu Madutu 'ai ngowa-ngowa'a manga de'oso re ḏegoro ma rousu.”<verse eid="MAT 11:19" /></para>
  <para style="s">Limau-limau ma manusia ga'a 'aḏi maḏibo toma <optbreak /> ngo'omo boloto ua</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ḏua Yesus mulaingi 'o ḇangata ngowa'a Yahudi ga'a tegoro limau-limau ga'a Unanga ro 'a'a ga'a hera-heranga lebe repe. Sababu toma limau-limau gena-ge, ngowa'a 'aḏi maḏibo toma ngo'omo boloto ua. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Unanga 'o kanau, “Bahala ra ngini ngowa'a toma limau Korasim re limau Betsaida. Ma Jou'ongu Madutu ḏuanga i'a 'o singe-ngeta'a hukumu ra ngini. Si'ade-'ade i'a Ngoi to 'a'a ga'a hera-heranga toma ngowa'a ma jira toma limau Tirus re Sidon ma tero sa'olo Ngoi ta si'a'a ḏua ra ngini ninga sigolona, tantu ḏua ananga da'a raḏi maḏibo toma ngo'omo boloto, re ananga 'aḏi mapake pakeanga si'a'a reo kaḏu re tamanga sae'e ya sidu-durono reo itomo ma korou'u.<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Gena-ge nana'o mangale ananga 'aḏi matuduba tamanga ḏosa.</char></note><note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Yes. 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Yeh. 26:1–28:26</ref>; <ref loc="JOL 3:4-8">Yl. 3:4-8</ref>; <ref loc="AMO 1:9-10">Am. 1:9-10</ref>; <ref loc="ZEC 9:2-4">Za. 9:2-4</ref></char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Mada'a, Ngoi to siajele ra ngini: toma Kiamata ma Wangere, ngini ngowa'a Yahudi toma limau Korasim re Betsaida ḏuanga i'a ni sanga hukumu lebe tubuso reo ngowa'a ma jira toma limau Tirus re Sidon!<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />Re ngini ngowa'a Yahudi toma limau Kapernaum! Awa ngini ni ta'ajiri mangale Ma Jou'ongu Madutu ḏuanga i'a 'o dawongo ngini toma soroga! So'o gena ua! Mada'a Unanga 'o siupa'a ngini toma naraka! Si'ade-'ade i'a Ngoi to 'a'a ga'a hera-heranga toma ngowa'a ma jira toma limau Sodom 'ua re 'au wali ma tero sa'olo Ngoi ta si'a'a ḏua ra ngini ninga sigolona, tantu ḏua limau Sodom gena-ge rema enanga singadolo nange-ne.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Do. 19:24-28</ref>; <ref loc="ISA 14:13-15">Yes. 14:13-15</ref></char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Mada'a, Ngoi to siajele ra ngini nena-ne: toma Kiamata ma Wangere, ngini ngowa'a Yahudi toma limau Kapernaum ḏuanga i'a ni sanga hukumu lebe tubuso reo ngowa'a ma jira toma limau Sodom!”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat. 10:15</ref>; <ref loc="LUK 10:12">Luk. 10:12</ref></char></note><verse eid="MAT 11:24" /></para>
  <para style="s">Yesus 'o manyiata</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Toma 'orasa gena-ge Yesus 'o kanau, “Baba, Ma Jou'ongu Madutu 'o kuasa toma diwanga re dungia, Ngoi to puji re silamo'o 'Ani lomanga sababu mo-moini gena-ge Baba na gogono toma ngowa'a pahe re ngowa'a 'akala soro'unu, mada'a Baba na sijumu toma ngowa-ngowa'a ga'a manga de'oso re ḏegoro ma tero sa'olo ngowa 'olo. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ya, Baba sababu enanga gena-ge 'i sisanangi 'Ani 'akala re sinyingara.”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Ḏua Yesus 'o kanau, “ 'Ori i'a mo-moini, 'Ari Ḇaḇa ra sidoa'a ra Ngoi. Matengo i'a mai ua 'o nana'o Ngoi ḏuga-ḏuga pa'i 'Ari Ḇaḇa ḇato. Matengo i'a mai ua 'o nana'o 'ari Ḇaḇa ḏuga-ḏuga pa'i Ngoi, 'Ai Ngowa'a Nau'u, re ra guna ḇato ga'a Ngoi to sinana'o 'Ari Ḇaḇa.<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yoh. 3:35</ref>, <ref loc="JHN 1:18">1:18</ref>, <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Ino ni sapolo ra Ngoi, ngini ga'a ni sibasono tala ni momoro re ninga gina lai tubuso; Ngoi masiretene ḏuanga i'a tini sikare ngini. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Pa'i ni mete'e ḇato 'Ari parenta re ni madoto'o ra Ngoi ḇato, sababu Ngoi 'ari 'akala re sinyingara 'i mereoso re maholo, re ngini ḏuanga i'a ni sanga ngomasa mamete'e ra Ngoi.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">Yer. 6:16</ref></char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Re parenta 'i tubuso ua, re gina ga'a To pula'a enanga 'i kare ḇato.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">So-sano mangale Sabata ma wangere</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mrk. 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Toma 'orasa rimoi Sabata ma wangere, Yesus 'O tola'a i'a toma guḏa gandum ḇotu moi re 'Ai me-mete'e raḏi sawini. Dadi ananga 'aḏi 'utu'u gandum kara 'aḏi oromo.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Dad. 23:25</ref></char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Wakutu ngowa-ngowa'a Farisi ya'u oḏi'i, ananga 'aḏi kanau ra Yesus, “Oḏi'i, 'Ani me-mete'e ananga ya mete'e ua nanga 'agama ma 'atoranga toma Sabata ma wangere!”<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">Ngowa'a Farisi 'aḏi kanau so'o gena-ge sababu Yesus 'ai me-mete'e 'aḏi 'a'a 'ori i'a ga'a 'i wosono toma Sabata ma wangere!</char></note><verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yesus 'a sangoro, “Tantu ḏua, ngini reni baca mangale 'oru ga'a Daud 'a si'a'a wakutu unanga re 'ai ḏagilomu raḏi sawini! <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Unanga gena-ge 'o osama ra Ma Jou'ongu Madutu 'ai Wala, re unanga re 'ai ḏagilomu ananga 'aḏi oromo roti ga'a sipula'a ḏua sa'olo jou-jou ra Ma Jou'ongu Madutu. Kalaha, mete'e nanga 'agama ma 'atoranga, pa'i 'imam-'imam ḇato nyengara ya oromo roti gena-ge, mada'a Daud re 'ai ḏagilomu ananga gena-ge 'aḏi 'a'a sala ua.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Sam. 21:1-6</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">'Im. 24:9</ref></char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Re tantu ḏua ngini ḏi'i reni baca ra Musa 'ai hukumu ma dara mangale 'imam-'imam 'aḏi munara ra Ma Jou'ongu Madutu 'ai Wala toma Sabata ma wangere. Dadi ananga ya mete'e ua Sabata ma 'atoranga, mada'a 'aḏi sisala ua?!<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">Nyo. 28:9-10</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Mada'a Ngoi to siajele ra ngini nena-ne: 'Ane-ne 'age lebe la-lamo'o i'a reo Ma Jou'ongu Madutu 'ai Wala.<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">Ḏa Yesus bolo 'Ai pareta lebe lamo'o i'a reo Ma Jou'ongu Madutu 'ai Wala.</char></note> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Toma Boku 'Ofi-'Ofi rema bu-bula'a rimoi ma betongo so'o ne: ‘Ngoi to mau ngowa'a 'aḏi sijumu manga 'akala re sinyingara ma la-la toma ngowa'a lelegu, awa pa'i 'aḏi pula'a jou-jou haiwani ra Ngoi ḇato.’ Na'o ngini ni sahe mode-mode'e ma bu-bula'a gena-ge, tantu ḏua ngini ni sisala ua ngowa-ngowa'a ga'a kamanga sala ua.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos. 6:6</ref>; <ref loc="MAT 9:13">Mat. 9:13</ref></char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ngoi nyengara to kanau so'o gena-ge, sababu Ngoi, Manusia ma Ngowa'a Nau'u to kuasa toma Sabata ma wangere!”<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">Yesus 'ai maksudu so'o ne: Unanga nyengara 'o sitantukanga 'oru ga'a si'a'a yoḏu'u, re 'oru ga'a nyengara si'a'a.</char></note><verse eid="MAT 12:8" /></para>
  <para style="s">Toma Sabata ma wangere, Yesus 'o si-la <optbreak /> ngowa'a matengo 'ai giama kaci moi 'i sengene</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mrk. 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesus 'a sisoi'i tala ngi'i gena-ge re 'o osama toma wala puji. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Toma wala puji gena-ge ma dara 'age rema ngowa'a matengo 'ai giama kaci moi 'i sengene. 'Age ḏi'i rema ngowa'a nga muḏuo i'a 'aḏi disa-disa Yesus 'ai sala. Dadi ananga 'aḏi sano ra Yesus, “Nyengara bolo ua, si-la ngowa'a siḏi toma Sabata ma wangere?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yesus 'a sangoro, “Na'o 'age rema ngowa'a matengo ra ngini ninga sigolona unanga rai doba rimoi re toma Sabata ma wangere, doba gena-ge 'i eta'a toma tana'a ma ḇuongo; sanga ua doba ma dutu 'a sieanga 'ai doba toma tana'a ma ḇuongo gena-ge! Tantu ḏua, unanga 'a iḏala sisupu doba gena-ge.<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luk. 14:5</ref></char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Manusia lebe la-lamo'o i'a reo doba! Dadi na'o so'o gena-ge, ngene nyengara wo riono ngowa'a toma Sabata ma wangere.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Gena ḏua, Yesus 'o kanau i'a toma ngowa'a 'ai giama kaci moi 'i sengene gena-ge, “Na toa'a ino 'ani giama.” Dadi, ngowa'a gena-ge 'a toa'a i'a 'ai giama. Toma 'orasa gena-ge ḏua, 'ai giama ga'a sengene ri la, ma tero sa'olo 'ai giama ma kaci moi ga'a 'i sengene ua. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Mada'a ngowa'a Farisi ya sisoi'i tala wala puji gena-ge re 'aḏi mafakati di'a 'aḏi sisengene Yesus.<verse eid="MAT 12:14" /></para>
  <para style="s">Yesus, Ma Jou'ongu Madutu 'ai 'utusana</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesus 'a waro mangale ngowa'a Farisi manga 'ulungu ma jira ra Unanga. Dadi Yesus tagi 'a sisoi'i tala ngi'i gena-ge re ngowa'a repe 'aḏi mamete'e ra Unanga. Re Unanga 'o si-la ngowa'a siḏi mo-moini. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Mada'a Yesus 'o simaha ua ananga 'aḏi siajele mangale Unanga ge 'a guna. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Enanga 'i dadi mete'e Ma Jou'ongu Madutu 'ai demo-demo ga'a nabi Yesaya 'a siajele so'o ne:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Unanga nena-ne Ngoi 'Ari falalomu ga'a Ngoi reto cumutu.</para>
  <para style="q2" vid="MAT 12:18">Unanga ga'a to dadalara re ga'a 'a sisanangi 'Ari 'akala re sinyingara</para>
  <para style="q1" vid="MAT 12:18">'Ari Ngagara 'Ofi-'Ofi ḏuanga i'a ta sipula'a ra Unanga.</para>
  <para style="q2" vid="MAT 12:18">Re Unanga ḏuanga i'a 'o sihabari mangale 'Ari 'adili toma bangsa-bangsa.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Unanga ḏuanga i'a kama rubutu mai ua bolo maboa-boa'a;</para>
  <para style="q2" vid="MAT 12:19">matengo i'a mai ua 'isene 'Ai bobita toma ngo'omo lamo'o.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Unanga 'o sijumu 'Ai 'akala re sinyingara ma mereoso toma ngowa'a lamahana ma tero sa'olo Unanga 'o poti ua lou'u ga'a ri tu'o,</para>
  <para style="q2" vid="MAT 12:20">re Unanga 'a sisengene ua poci ma lejanga ga'a ma subu ri ḇoḇi'i.<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">Ma duhu so'o gena-ge Unanga 'a sijumu 'ai 'akala re sinyingara ma mereoso toma ngowa'a lamahana.</char></note></para>
  <para style="q1" vid="MAT 12:20">Unanga 'o munara singadolo 'Ai 'adili 'i waiti toma dungia sitabi donga;<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />re bangsa mo-moini ḏuanga i'a manga ngo-nganono ra Unanga.”<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Yes. 42:1-4</ref></char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Ngowa'a Farisi 'aḏi ta'ajiri Yesus 'ai kuasa ra Beelzebul ino</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mrk. 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Gena ḏua, ananga 'aḏi gasa ino ra Yesus, ngowa'a matengo 'o hafu re 'o mou sababu 'o roh ma jira 'u dungosama. Yesus 'o si-la unanga gena-ge singadolo unanga 'o oḏi'i re 'o kanau ri nyengara. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ngowa'a mo-moini matai heranga re 'aḏi kanau, “Unanga nena-ne ḏa 'Olana Daud 'ai ju'uda<note caller="+" style="f"><char style="fr" closed="false">12:23 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note> ga'a ngene wo totoma?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Mada'a ngowa'a Farisi ya 'isene so'o gena, ananga ya sangoro, “Ngowa'a nena-ne pa'i nga'unu 'o dusu'u roh ma jira ḇato sababu Beelzebul, 'o Roh ma Jira ma 'Olana, enanga 'i pula'a watasa ra Unanga.”<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>, <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesus 'a waro ngowa'a Farisi manga fikirana, dadi Unanga 'o kanau i'a ra ananga, “Toma nagara rimoi, na'o ma manusia 'i palangu toropo moi-toropo moi ga'a 'aḏi ma'u parangi i'a re ino, tantu ḏua nagara gena-ge ḏuanga i'a 'i wejere. Re ḏi'i, na'o limau rimoi bolo ngitu re ngale rimoi 'aḏi ma'u lawana matengo re matengo, limau bolo ngitu re ngale gena-ge ḏuanga i'a 'i wejere. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />So'o gena ḏi'i reo 'Iblisi ma pareta. Na'o roh ma jira toropo moi ma'u dusu'u reo roh ma jira da'a toropo moi; ma ḏo-ḏogumu tala, 'Iblisi ma pareta gena-ge 'i pinya'olo re 'i wejere. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ngini ni ta'ajiri Ngoi to dusu'u roh ma jira sababu Beelzebul 'i pula'a watasa ra Ngoi. Na'o so'o gena-ge, ra guna 'ai kuasa ninga me-mete'e 'aḏi dusu'u roh ma jira?!<note caller="+" style="f"><char style="fr" closed="false">12:27 </char><char style="ft" closed="false">Yesus 'ai maksudu: ananga 'aḏi pake Ma Jou'ongu Madutu 'ai kuasa ḏi'i.</char></note> Sababu gena-ge, ninga me-mete'e gena-ge masiretene ya bukiti mangale ngini ni rapu! <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Mada'a Ngoi to dusu'u roh ma jira rea Ma Jou'ongu Madutu 'ai Roh ma kuasa. Gena-ge 'i dadi didina'o rimoi mangale Ma Jou'ongu Madutu ro mulaingi 'o parenta taninga sigolona.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Bolo na'o 'a guna ḇato 'o osama toma wala ḏu moi di'a 'o ra-rabasa 'ori i'a rana toma wala ma dutu ga'a lao te'e; siḏa-siḏa unanga balasu 'o piri'u wala ma dutu gena-ge si, kara 'o ra-rabasa 'ai 'ori i'a rana.<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false">'Iblisi ma tero sa'olo wala ma dutu ga'a lao te'e.</char></note><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />'A guna marimoi ra Ngoi ua, unanga gena-ge mode-mode'e 'o malawana Ngoi. Re 'a guna riono Ngoi ua, unanga gena-ge mode-mode'e 'a dola'aku Ngoi 'ari munara.<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mrk. 9:40</ref></char></note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Sababu gena-ge, Ngoi to siajele ra ngini nena-ne: na'o ngowa'a 'aḏi madaga'a ḏosa re 'aḏi sije-jengere ra guna ḇato, ananga manga ḏosa nga'unu 'i singi-ngiranga. Mada'a na'o ngowa'a 'aḏi sije-jengere Ma Ngagara 'Ofi-'Ofi, ngowa'a gena-ge manga ḏosa singi-ngiranga yoḏu'u. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />'A guna ḇato 'o kanau cira mangale Ngoi, Manusia ma Ngowa'a Nau'u, unanga gena-ge 'ai ḏosa nga'unu singi-ngiranga. Mada'a 'a guna ḇato 'o kanau cira mangale Ma Ngagara 'Ofi-'Ofi, unanga 'ai ḏosa singi-ngiranga 'i yoḏu'u: bae toma dungia nena-ne, bae dungia ma su-sungi.”<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">Yesus 'o kanau so'o gena-ge sababu 'age ngowa'a 'aḏi kanau Yesus 'o roh ma jira 'u dungosama. Oḏi'i Mk. 3:30</char></note> <note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk. 12:10</ref></char></note><verse eid="MAT 12:32" /></para>
  <para style="s">Ate rema sowo'o</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk. 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Yesus dadunu 'o kanau moju toma ngowa'a Farisi, “Na'o ate ma nga-ngamasa lai rousu, tantu ḏua ma sowo'o lai rousu ḏi'i. So'o gena ḏi'i, na'o ate ma nga-ngamasa 'i cira, tantu ḏua ma sowo'o 'i cira ḏi'i. Ate gena-ge bae 'i rousu bolo 'i cira 'i waiti toma sowo'o.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">Mat. 7:20</ref>; <ref loc="LUK 6:44">Luk. 6:44</ref></char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ngini, ngowa'a ma jira! Sanga ua ninga demo re ganau enanga 'i la-la, sababu ngini ni cira. Sababu 'oru ga'a 'i supu toma madanga, enanga gena-ge ma 'asala toma 'akala re sinyingara ma dara.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>, <ref loc="MAT 23:33">23:33</ref>, <ref loc="MAT 15:18">15:18</ref>; <ref loc="LUK 3:7">Luk. 3:7</ref>, <ref loc="LUK 6:45">6:45</ref></char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ngowa'a la-la manga demo re manga ganau 'i la-la, sababu manga 'akala re sinyingara ma dara enanga 'i la-la. Siḏibo ḏi'i ngowa'a ma jira manga demo re ganau 'i cira, sababu manga 'akala re sinyingara ma dara 'i romanga 'ori i'a ma jira.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Dadi Ngoi to siajele ra ngini nena-ne: Wakutu Kiamata ma Wangere 'i ngadolo, Ma Jou'ongu Madutu 'o sijuruhakimi ngowa'a manga demo re ganau mo-moini ga'a ma faeda 'i cua. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Sababu ninga demo re ganau masiretene Unanga ḏuanga i'a 'A pake di'a 'O sitantukanga ngini reninga sala bolo ua.”<verse eid="MAT 12:37" /></para>
  <para style="s">Ngowa'a Farisi 'aḏi golo'o Yesus 'o 'a'a didina'o heranga rimoi</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mrk. 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Gena ḏua, guru-guru 'agama nga muḏuo i'a re ngowa-ngowa'a Farisi, ananga 'aḏi kanau, “Guru, ngomi mau mi oḏi'i Ngana no 'a'a didina'o heranga.”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mat. 16:1</ref>; <ref loc="MRK 8:11">Mrk. 8:11</ref>; <ref loc="LUK 11:16">Luk. 11:16</ref></char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yesus 'a sangoro, “Ngowa-ngowa'a 'orasa nange-ne ngowa'a ma jira ga'a oḏu'u ngaku Ngoi! Ngini ni golo'o Ngoi to 'a'a didina'o heranga, mada'a rimoi i'a mai ua To pula'a ra ngini, pa'i ḏuga-ḏuga ga'a 'age ra ngini ḏua, gena-ge didina'o heranga mangale nabi Yunus:<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mat. 16:4</ref>; <ref loc="MRK 8:12">Mrk. 8:12</ref></char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Yunus 'o tegoro toma nyao'o la-lamo'o ma po'olo ma di'ara wangere ro'ange re utu ro'ange. So'o gena-ge ḏi'i Ngoi, Manusia ma Ngowa'a Nau'u, ḏuanga i'a To tegoro toma tana'a ma dara ma di'ara wangere ro'ange re utu ro'ange.<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">Yun. 1:17</ref></char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Toma Kiamata ma Wangere, ngowa-ngowa'a Niniwe ḏuanga i'a dadunu 'aḏi 'ahu moju mamete'e ra ngini ngowa-ngowa'a toma 'orasa nena-ne, re ananga gena-ge ḏuanga i'a 'aḏi kalaki ngini. Sababu ngowa'a Niniwe ananga raḏi maḏibo toma ngo'omo boloto, wakutu ananga 'aḏi 'isene nabi Yunus 'ai habari. Kalaha 'ane-ne, nange-ne Ngoi lebe la-lamo'o i'a rea Yunus taninga sigolona, mada'a ni ngaku Ngoi ua re ni maḏibo toma ngo'omo boloto ua!<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">Yun. 3:5</ref></char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Toma Kiamata ma Wangere, 'olana we-were'a toma kore mie ino, munanga ḏuanga i'a dadunu mo 'ahu moju mamete'e ra ngini ngowa-ngowa'a toma 'orasa nena-ne re mo kalaki ngini. Sababu munanga mo tagi toma ngi'i lai kiḏanga di'a mo 'isene Salomo 'ai 'akala ma soro'unu. Kalaha 'ane-ne, nange-ne Ngoi lebe la-lamo'o i'a ḏi'i rea Salomo taninga sigolona, mada'a ni ngaku Ngoi ua re ni maḏibo toma ngo'omo boloto ua!”<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1'Oln. 10:1-10</ref>; <ref loc="2CH 9:1-12">2Taw. 9:1-12</ref></char></note><verse eid="MAT 12:42" /></para>
  <para style="s">Roh ma jira dadunu 'i osama toma ngowa'a</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk. 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Wakutu roh ma jira enanga 'i supu toma ngowa'a matengo sababu sanga dusu'u, re enanga 'i tagi sigoloḏi toma ngi'i-ngi'i du-dudungu di'a disa ngi'i ma ngomasa, mada'a 'i sanga ua. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Ḏua enanga 'i kanau, ‘Ngoi ḏuanga i'a to maḏibo toma ngowa'a ga'a to supu ḏua nga'ene.’ Wakutu enanga 'i maḏibo toma ngowa'a gena-ge 'i sanga ua Ma Ngagara 'Ofi-'Ofi 'i tegoro tai 'ahu. Ngowa'a gena-ge ma tero sa'olo wala ma dara 'i batolo, 'i 'ofi-'ofi re 'i ḏu-ḏuanga ḏua di'a enanga dadunu 'i tegoro moju. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Sababu gena-ge, enanga 'i tagi re 'i gasa ino roh ma jira tumudingi ma lelegu ga'a lebe cira i'a. Ḏua enanga 'i osama re 'i tegoro toma ngowa'a gena-ge. Ma ḏo-ḏogumu tala ngowa'a gena-ge 'ai 'ahu nange-ne lebe cira i'a reo 'ahu 'au nga'ene. Gena-ge 'i dadi toma ngowa-ngowa'a ma jira toma 'orasa nena-ne sababu ananga 'aḏi dawongo Ngoi ua.”<verse eid="MAT 12:45" /></para>
  <para style="s">Yesus 'ai ngina re 'Ai ioro re nongoḏu</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mrk. 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Wakutu Yesus 'o ka-kanau moju toma ngowa'a repe, 'Ai ngina re 'Ai no-nongoḏu ananga 'aḏi sapolo. Ananga 'aḏi made-de'oso toma wala ma soana, disa ma donga di'a ma'u sanga re ma'u kanau ra Yesus. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Toma ngowa'a repe manga sigolona, 'age rema ngowa'a matengo 'o kanau ra Yesus, “Jou, 'Ani ngina, re 'Ani no-nongoḏu ananga da'a toma wala ma soana, ananga 'aḏi disa ma donga di'a ma'u sanga re ma'u kanau ra Jou.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Ḏua Yesus 'a sangoro, “ 'Ari ngina ngo guna? 'Ari ioro re nongoḏu 'a guna?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Ḏua Yesus 'o sijumu Tai me-mete'e kara 'O kanau i'a toma ngowa'a gena-ge, “Ananga nena-ne 'Ari ngina re 'Ari ioro re nongoḏu. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Ngowa-ngowa'a ga'a 'aḏi si'a'a 'Ari Ḇaḇa toma soroga, Unanga 'Ai mau, ananga gena-ge 'Ari ioro re nongoḏu re 'Ari biḏanga re 'Ari ngina.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">'Ade-'ade mangale ngowa'a guḏa matengo 'o siare gisisi</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mrk. 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Toma wangere gena-ge ḏi'i, Yesus 'o sisoi'i tala wala gena-ge, re 'O tagi da'a talaga Galilea ma 'uḏu, re 'o tegoro 'age. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Unanga 'o malage toma oti, sababu ngowa'a repe 'u gowolo Unanga re ananga gena-ge 'aḏi made-de'oso toma talaga ma 'uḏu.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Luk. 5:1-3</ref></char></note><verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Ḏua Yesus 'o doto'o ma rupa ma repe ra ananga reo pake 'ade-'ade. Unanga 'o kanau, “ 'Age rema ngowa'a 'a'a guḏa matengo 'o tagi di'a 'a siare 'ai gisisi. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Wakutu unanga 'a siare, 'age rema gisisi mamuni'a 'i eta'a toma ngo'omo ma 'uḏu. Ḏua namo diwanga 'i sapolo ya tubu'u simoini gisisi gena-ge. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />'Age mamuni'a ḏi'i 'i eta'a toma tana'a maḏi-maḏi. Gisisi gena-ge matai konyo lai caiti, sababu ma tana'a pa'i ceka'a ua. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Mada'a wakutu wangere ma la'o pere ie ya 'erese go-gonyo gena-ge ḏua 'i wa'alo caiti singadolo 'i ngonono sababu ma 'utu'u 'i osama ngido ua. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />'Age mamuni'a ḏi'i 'i eta'a toma rurubu dodowo'o ma golona. Ḏua rurubu dodowo'o gena-ge 'i konyo re ya pilatu gisisi ma go-gonyo gena-ge singadolo 'i sengene. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Mada'a 'age mamuni'a ḏi'i 'i eta'a toma tana'a ma la-la'eme, ḏua 'i konyo re 'i sowo'o. 'Age ma sowo'o sidu'o sou latu moi, 'age ma sowo'o sidu'o sou nyagi rarama, re 'age ma sowo'o sidu'o sou nyagi ro'ange. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Na'o reninga ngau'u, ni 'isene la-la.”<figure style="fig" alt="Man sowing seeds" file="lb00094b.tif" size="col" loc="13:1-9" ref="13:9">Ngowa'a matengo 'o siare 'ai gisisi</figure><verse eid="MAT 13:9" /></para>
  <para style="s">I'a sa'olo Yesus 'o pake 'ade-'ade</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mrk. 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Togumu i'a Yesus 'ai me-mete'e 'aḏi masebanga i'a ra Unanga re 'aḏi sano, “I'a sa'olo Jou no pake 'ade-'ade, na'o no kanau toma ngowa'a kawasa?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesus 'a sangoro, “Ngini reni sanga cocatu di'a ni sahe 'ori i'a go-gogono mangale Soroga ma Pareta,<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> mada'a toma ngowa'a lelegu so'o gena ua. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Sababu 'a guna ḇato ro sanga wo-waro mangale 'ori i'a go-gogono, Ma Jou'ongu Madutu 'a sidogo ḏi'i wo-waro gena-ge singadolo pai-pai'i. Mada'a 'a guna ḇato 'o sanga wo-waro ua mangale 'ori i'a go-gogono; 'oru ḇato, kalaha unanga ra sanga pa'i wo-waro ceka'a ua ḇato, gena-ge Ma Jou'ongu Madutu 'a 'oro ḏi'i.<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat. 25:29</ref>; <ref loc="MRK 4:25">Mrk. 4:25</ref>; <ref loc="LUK 8:18">Luk. 8:18</ref>, <ref loc="LUK 19:26">19:26</ref></char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ma sababu gena-ge, Ngoi to pake 'ade-'ade na'o to kanau toma ngowa'a kawasa. Sababu kalaha ananga nga'unu 'aḏi oḏi'i, ananga ya sahe ua 'oru ga'a 'i dadi. Kalaha ananga nga'unu ya 'isene, ananga ma tero sa'olo ngowa'a ga'a ya 'isene ua, re ya sahe ua ma maksudu.<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Dadi nabi Yesaya 'ai nubuata 'i sitotomo ra ananga. Ma Jou'ongu Madutu 'o kanau,</para>
  <para style="q1" vid="MAT 13:14">‘Ananga 'aḏi 'isene tau-taunu</para>
  <para style="q2" vid="MAT 13:14">mada'a ya sahe ua.</para>
  <para style="q1" vid="MAT 13:14">Ananga 'aḏi totoho tau-taunu,</para>
  <para style="q2" vid="MAT 13:14">mada'a ananga ya sahe ua, 'oru ga'a 'i dadi.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Sababu bangsa nena-ne manga 'akala re sinyingara lai te'e,</para>
  <para style="q2" vid="MAT 13:15">manga ngau'u ri popongolo,</para>
  <para style="q2" vid="MAT 13:15">re manga la'o ri ruutu.</para>
  <para style="q2" vid="MAT 13:15">Gena-ge 'i dadi, la remanga la'o ya oḏi'i ua,</para>
  <para style="q2" vid="MAT 13:15">remanga ngau'u ya 'isene ua,</para>
  <para style="q2" vid="MAT 13:15">re ananga manga 'akala re sinyingara ya sahe ua.</para>
  <para style="q1" vid="MAT 13:15">Dadi awa ananga 'aḏi ḏibo ra Ngoi,</para>
  <para style="q2" vid="MAT 13:15">la 'aḏi dawongo 'Ari salamata.’ ”<note caller="-" style="x"><char style="xo" closed="false">13:14-15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Yes. 6:9-10</ref></char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Yesus 'o kanau Tai me-mete'e, “Mada'a ngini bara'utungu madutu, sababu ngini mode-mode'e ni oḏi'i re ni 'isene. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Nabi re ngowa'a loasa re banari manga repe 'aḏi nyafusu ya oḏi'i 'oru ga'a ngini ni oḏi'i nange-ne, mada'a ananga ya oḏi'i ua. Ananga nyafusu 'aḏi 'isene 'oru ga'a ngini ni 'isene nange-ne, mada'a ya 'isene ua.”<note caller="-" style="x"><char style="xo" closed="false">13:16-17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">Luk. 10:23-24</ref></char></note><verse eid="MAT 13:17" /></para>
  <para style="s">Yesus 'a sitarangi 'ade-'ade mangale <optbreak /> ngowa'a guḏa matengo 'o siare gisisi</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mrk. 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“ 'Isene, Ngoi to sitarangi 'ade-'ade mangale ngowa'a guḏa matengo 'o siare gisisi: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Gisisi ga'a 'i eta'a toma ngo'omo ma 'uḏu, ma tero sa'olo ngowa'a ga'a 'isene habari mangale Soroga ma Pareta,<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta. Gena-ge ma tero toma bu-bula'a 24, 31, 33, 44, 45, 47, 52.</char></note> mada'a ya sahe ua. Dadi 'Iblisi sapolo re ya ra-rabasa 'oru ga'a 'i siare ḏua tamanga 'akala re sinyingara ma dara. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Gisisi ga'a 'i eta'a toma tana'a maḏi-maḏi, ma tero sa'olo ngowa'a 'aḏi 'isene habari gena-ge, re jau-jau ya dawongo remanga roanga tamanga 'akala re sinyingara, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />mada'a habari gena-ge 'i utu'u ua tamanga 'akala re sinyingara singadolo 'i tahana ti'ara ua. Dadi wakutu 'aḏi sanga susa re sangisara bolo sanga sikisa, sababu 'aḏi ngaku habari, ananga jau-jau 'aḏi celolo ḏuḏunu i'a. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Gisisi ga'a 'i eta'a toma rurubu dodowo'o ma sigolona, ma tero sa'olo ngowa'a ga'a 'aḏi 'isene habari gena-ge, mada'a 'aḏi dodato mangale manga 'ahu, re 'aḏi mau manga 'ahu pai-pai'i. Sababu gena-ge habari gena-ge 'i 'ahu peletoro tamanga 'akala re sinyingara singadolo 'i sowo'o ua. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Mada'a gisisi ga'a 'i eta'a toma tana'a ma la-la'eme, ma tero sa'olo ngowa'a ga'a 'aḏi 'isene habari gena-ge, ananga ya sahe re ma sowo'o lai repe: 'age ma sowo'o sidu'o soi latu moi, 'age ma sowo'o sidu'o soi nyagi rarama, re 'age ḏi'i ma sowo'o sidu'o soi nyagi ro'ange.”<verse eid="MAT 13:23" /></para>
  <para style="s">'Ade-'ade mangale 'usumu 'i konyo toma gandum ma sigolona</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesus 'o carita 'ade-'ade ma lelegu rimoi toma ngowa'a repe. Unanga 'o kanau, “Wakutu Soroga ma Pareta 'i ngadolo, gena-ge ma tero sa'olo 'ade-'ade so'o ne: Ngowa'a guḏa matengo 'o siare 'ai gisisi ma la-la tai guḏa. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Mada'a wakutu lobi'i rimoi re ngowa'a raḏi matara otu mo-moini, ngowa'a guḏa 'ai lawana 'o sapolo siare gisisi 'usumu toma gandum ma sigolona. Gena ḏua, unanga ro tagi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Toma 'orasa gisisi-gisisi gandum gena-ge 'i konyo re ma gutingana mai ri supu, gisisi 'usumu mai 'i konyo ma'u mete'e reo gandum ḏi'i. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Ḏua guḏa ma dutu 'ai budaka-budaka, 'aḏi sapolo, re 'aḏi kanau, ‘Tuanga, mode'e bolo ua, tuanga no siare tani guḏa gisisi ma la-la?! 'Oru ma sababu singadolo 'usumu ḏi'i mai ri konyo ma'u mete'e gandum.’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Guḏa ma dutu gena-ge 'o sangoro, ‘Gena-ge 'o lawana ma munara.’</para>
  <para style="p" vid="MAT 13:28">Mada'a 'ai budaka-budaka 'aḏi sano moju, ‘Tuanga no nyengara ngomi tagi ma wuru'u 'usumu gena-ge?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Unanga 'a sangoro, ‘Awa, sababu na'o ni wuru'u 'usumu gena-ge, marai ma gandum mai mete'e wuru'u ḏi'i. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Sieanga ḇato 'usumu gena-ge 'i konyo singadolo 'orasa 'utu'u gandum. Maha ngoi to kanau toma ngowa'a gu-gutu'u: ni lomu siḏa ma 'usumu, piri'u re na tau'u. Gena ḏua, ngini ni 'utu'u re lomu gandum re ni singati'i toma titila.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">'Ade-'ade mangale gisisi ma moi'i ngai moi lai 'alusu madutu</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mrk. 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesus 'o carita 'ade-'ade ma lelegu rimoi ḏi'i toma ngowa'a repe. Unanga 'o kanau, “Wakutu Soroga ma Pareta 'i ngadolo, gena-ge ma tero sa'olo 'ade-'ade so'o ne: Ngowa'a matengo 'o 'oro gisisi ma moi'i ngai moi lai 'alusu madutu re ya so'ana tai guḏa. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Kalaha gisisi ma moi'i gena-ge 'i 'alusu madutu, mada'a na'o ri konyo enanga ḏuanga i'a 'i dadi joro lai lamo'o masala. Enanga 'i dadi ate ḏu moi singadolo namo diwanga matai 'a'a ma ngi'i toma uma-umanga.”<verse eid="MAT 13:32" /></para>
  <para style="s">'Ade-'ade mangale ragi</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luk. 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesus 'o carita moju 'ade-'ade lelegu rimoi ḏi'i toma ngowa'a repe. Unanga 'o kanau, “Wakutu Soroga ma Pareta 'i ngadolo, gena-ge ma tero sa'olo 'ade-'ade so'o ne: We-were'a matengo mo 'oro ragi kara masicapuru reo tarigu litere nyagi rata singadolo enanga mo-moini 'i ramasa.”<verse eid="MAT 13:33" /></para>
  <para style="s">Ma sababu Yesus 'o pake 'ade-'ade</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mrk. 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Wakutu Yesus 'o doto'o ngowa'a kawasa nange-ge, Unanga pa'i 'o pake 'ade-'ade ḇato. Soi moi i'a mai ua, Unanga 'o pake ua 'ade-'ade na'o 'O doto'o ngowa'a kawasa. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Enanga 'i dadi so'o gena ma tero sa'olo nabi 'a siajele pasala ḏua:</para>
  <para style="q1" vid="MAT 13:35">“Ngoi to sipake 'ade-'ade na'o to doto'o ananga;</para>
  <para style="q2" vid="MAT 13:35">Ngoi to doto'o ananga 'oru ga'a 'i gogono mulaingi dungia 'i dadi re sino.”<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Nya. 78:2</ref></char></note><verse eid="MAT 13:35" /></para>
  <para style="s">Yesus 'a sitarangi 'ade-'ade mangale <optbreak /> 'usumu 'i konyo toma gandum ma sigolona</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Gena togumu i'a, Yesus 'o sisoi'i tala ngowa'a repe re 'o osama toma wala ma dara. Re 'Ai me-mete'e 'aḏi sapolo re 'aḏi kanau ra Unanga, “Tai'i Jou na sitarangi mangale 'ade-'ade 'usumu toma gandum ma sigolona.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yesus 'a sangoro, “Ngowa'a matengo ga'a siare gisisi ma la-la gena-ge Ngoi, Manusia ma Ngowa'a Nau'u. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Guḏa gena-ge dungia nena-ne. Gisisi ma la-la gena-ge Ma Jou'ongu Madutu 'ai ngowa-ngowa'a. 'Usumu gena-ge 'Iblisi ma ngowa-ngowa'a. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Re lawana ga'a siare gisisi 'usumu gena-ge 'Iblisi. 'Orasa 'utu'u gena-ge Kiamata ma Wangere, re ngowa'a gu-gutu'u gena-ge mala'ekata-mala'ekata. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Dadi 'usumu ya lomu kara ya tau'u toma u'u. So'o gena ḏi'i toma Kiamata ma Wangere enanga ḏua 'i dadi so'o gena. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Ngoi, Manusia ma Ngowa'a Nau'u ḏuanga i'a To soma'a 'Ari mala'ekata-mala'ekata 'aḏi tagi re 'aḏi lomu Tari 'umata ma sigolona ngowa'a mo-moini ga'a sigasa ngowa'a 'aḏi eta'a toma ḏosa re ma lelegu ga'a 'aḏi 'a'a kajahatana. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ananga mo-moini ḏuanga i'a sanga upa'a toma ḏiḏiana u'u ga'a leja-lejanga. Toma ngi'i gena-ge ananga ḏuanga i'a ya rerese ma gaḏi re ya doiti ma sangisara. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Mada'a ngowa-ngowa'a loasa re banari, ananga remanga cahaya ma tero sa'olo wangere ma la'o ra Ma Jou'ongu Madutu 'ai dungia su-sungi. Na'o reninga ngau'u ni 'isene la-la!”<verse eid="MAT 13:43" /></para>
  <para style="s">'Ade-'ade mangale harata toma tana'a ma dara</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Wakutu Soroga ma Pareta 'i ngadolo, gena-ge ma tero sa'olo 'ade-'ade nena-ne: Wakutu ngowa'a matengo 'o sanga harata toma tana'a ma dara, unanga dadunu 'a otomo toma tana'a gena-ge ma dara. Sababu unanga 'o maroanga siḏi woḏi, unanga 'o tagi 'a wu'unu 'ai 'ori i'a rana mo-moini, kara 'o ḏibo ino 'a tibo tana'a gena-ge ga'a rema harata.”<note caller="-" style="x"><char style="xo" closed="false">13:44 </char><char style="xt" closed="false"><ref loc="PSA 119:162">Nya. 119:162</ref></char></note><verse eid="MAT 13:44" /></para>
  <para style="s">'Ade-'ade mangale mutiara ma ijana lai hali</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Wakutu Soroga ma Pareta 'i ngadolo gena-ge ma tero sa'olo 'ade-'ade nena-ne: Ngowa'a rema-enanga matengo 'o disa mutiara-mutiara ga'a lai rousu i'a. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Wakutu unanga ra sanga mutiara ma ijana lai hali, unanga 'o tagi re 'a wu'unu 'ori i'a rana mo-moini kara rema pipisi 'a sitibo mutiara gena-ge.”<verse eid="MAT 13:46" /></para>
  <para style="s">'Ade-'ade mangale j̱ala</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Soi moi moju, wakutu Soroga ma Pareta 'i ngadolo gena-ge ma tero sa'olo 'ade-'ade nena-ne: Ngowa'a ngau-ngau 'aḏi upa'a j̱ala toma talaga re 'aḏi sanga nyao'o fara muḏuo i'a. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ngowa'a ngau-ngau ya totoma singadolo ma j̱ala 'i romanga reo nyao'o, kara ananga ya iḏala sibere j̱ala gena-ge toma tana'a du-dudungu. Gena ḏua, ananga ya siwo-wola nyao'o ma la-la sigae toma karajanga, re nyao'o ma la-la ua, ananga ya upa'a. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Toma Kiamata ma Wangere enanga 'i dadi so'o gena-ge ḏi'i: Ma Jou'ongu Madutu 'ai mala'ekata-mala'ekata 'aḏi siwo-wola ngowa'a loasa re banari reo ngowa'a ma jira. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Ngowa'a ma jira gena-ge, ananga ḏuanga i'a sanga upa'a toma ḏiḏiana u'u ga'a leja-lejanga. Toma ngi'i gena-ge, ananga ḏuanga i'a ya rerese ma gaḏi re ya doiti ma sangisara.”<verse eid="MAT 13:50" /></para>
  <para style="s">Harata ma su-sungi re harata ma siḏa</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesus 'o sano Tai me-mete'e, “Ngini na sahe ḏua mo-moini gena-ge?”</para>
  <para style="p" vid="MAT 13:51">Ananga sangoro, “Jou, ngomi ma sahe!”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Dadi Yesus 'o kanau, “Sababu gena-ge, guru 'agama mo-moini ga'a raḏi sahe do-doto'o mangale Soroga ma Pareta ma tero sa'olo wala ma dutu ga'a sisupu harata su-sungi re ma siḏa tai harata ma ngi'i.”<verse eid="MAT 13:52" /></para>
  <para style="s">Ngowa'a 'aḏi dawongo ua Yesus toma Nazaret</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mrk. 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Wakutu Yesus 'a sijarita toma ngowa'a kawasa mangale 'ade-'ade gena-ge, togumu i'a Unanga 'o tagi 'a sisoi'i tala ngi'i gena-ge. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Yesus 'o maḏibo toma limau Nazaret, Tai ji'o re gamu. I'a da'a, Unanga 'o doto'o toma wala puji, singadolo ngowa'a matai heranga! Ananga 'aḏi kanau, “Unanga 'o sanga le'a ino 'ai 'akala soro'unu gena-ge? Re 'O sanga 'Ai kuasa le'a ino singadolo Unanga nga'unu 'o 'a'a ga'a hera-heranga? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Unanga gena-ge 'Ai ḇaḇa pa'i 'o tukanga wala ḇato re 'Ai ngina ngo Maria, re 'Ai nongoḏu 'a Yakobus, 'a Yusuf, 'a Simon re 'a Yudas! <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Re Unanga 'ai nongoḏu biḏa-biḏanga ananga mo-moini 'aḏi tegoro 'ane-ne ḏi'i! Sababu gena-ge, Unanga 'o sanga le'a ino 'Ai 'akala soro'unu re 'Ai kuasa gena-ge?”<verse eid="MAT 13:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57" />Dadi Yesus masiretene Tai gamu re Tai rera, ananga 'U dawongo ua. Ḏua Yesus 'o kanau i'a ra ananga, “Nabi matengo ga'a 'o tegoro tai ji'o re gamu, unanga ngowa'a 'u silamo'o ua. Mada'a na'o nabi matengo 'o tegoro toma ngi'i lelegu, unanga ngowa'a 'u silamo'o.”<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoh. 4:44</ref></char></note> <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Sababu gena-ge, Yesus 'o 'a'a ga'a hera-heranga repe ua Tai gamu, sababu ananga 'aḏi ngaku Unanga ua.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Yohanes tukanga baptis 'o sengene</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mrk. 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Toma 'orasa gena-ge, 'Olana Herodes<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Oḏi'i </char><char style="bd">Herodes Antipas </char> toma kamus.</note> ga'a 'o pareta toma daeraha Galilea, unanga 'a 'isene habari mangale Yesus. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Herodes 'o kanau tai ngowa'a la-lamo'o, “Yesus gena-ge 'a Yohanes tukanga baptis, unanga gena-ge ro dadunu 'ahu moju. Ma sababu gena-ge, unanga nga'unu 'o 'a'a ga'a hera-heranga.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="MAT 14:3-4" />Herodes 'o kanau so'o gena, sababu 'au nga'ene wakutu Yohanes 'o sengene nyangu, 'a Herodes 'o molo'ara ngo Herodias ga'a 'a Filipus 'ai were'a, wakutu 'a Filipus 'o 'ahu moju. Sidogo ḏi'i, 'a Herodes re 'a Filipus, ananga nga muḏiḏi gia nongoḏu. Dadi Yohanes 'o ḇangata tau-taunu 'a Herodes, “Ngana na mete'e ua Musa 'ai hukumu, sababu ngana na molo'ara 'ani dau'u madutu, ngo Herodias.” Sababu gena-ge, Herodes ro soma'a sordado 'aḏi cako'o 'a Yohanes, re 'u piri'u re 'u singosama unanga toma bui.<note caller="-" style="x"><char style="xo" closed="false">14:3-4 </char><char style="xt" closed="false"><ref loc="MRK 6:17-18">Mrk. 6:17-18</ref>; <ref loc="LUK 3:19-20">Luk. 3:19-20</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">14:3-4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">'Im. 18:16</ref>, <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MAT 14:3-4" /><verse number="5" style="v" sid="MAT 14:5" />Herodes mau 'o sisengene 'a Yohanes, mada'a unanga ḏi'i 'o mojongo ngowa'a kawasa, sababu ananga 'aḏi ngaku 'a Yohanes gena-ge nabi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Wakutu Herodes 'ai musungu tero, ngo Herodias 'ami ngowa'a were'a matengo mo roje rousu masala tai ioronongoḏu singadolo Herodes 'ai 'akala re sinyingara 'i sanangi masala. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Dadi unanga 'o sijaji rema sasi mangale 'oru ḇato na'o munanga mo golo'o, unanga 'a pula'a.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Munanga mo sangoro, “Pula'a ra ngoi Yohanes tukanga baptis 'ai sae'e sigae toma baki.” Munanga mo golo'o gena-ge sababu 'ami ngina mi sido-doto'o munanga di'a golo'o so'o gena-ge.<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Wakutu Herodes 'a 'isene 'ami go-golo'o so'o gena, unanga 'ai 'akala re sinyingara 'i kangela masala. Mada'a sababu unanga ro sijaji rema sasi tai ioronongoḏu manga biono, unanga 'o soma'a 'ami go-golo'o balasu si'a'a so'o gena. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Dadi Herodes 'o soma'a sordado 'aḏi tola'a 'a Yohanes 'ai camala. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Gena ḏua, 'a Yohanes 'ai sae'e ya sigae toma baki re ya gasa ino, sipula'a toma mosolese gena-ge kara munanga mo gasa tami ngina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Togumu i'a, 'a Yohanes 'ai me-mete'e 'aḏi sapolo di'a 'oro re 'aḏi palihara unanga 'ai mayeti, kara siajele ra Yesus.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesus 'o pula'a oromo ngowa'a nga cala romotoa</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mrk. 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Wakutu Yesus 'a 'isene habari gena-ge, Unanga masiretene 'o mabalene toma oti di'a sisoi'i tala re 'o tagi disa ngi'i ga-garura. Mada'a wakutu ngowa'a kawasa ya 'isene Yesus ro tagi, ananga ya sisoi'i tala manga limau re 'aḏi siduu'u Unanga sitola'a ma ji'o mete'e tana'a dudungu. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Wakutu Yesus 'o 'uci toma oti ino re 'O oḏi'i ngowa'a repe, Tai 'akala re sinyingara 'i baolo dadalara ra ananga. Dadi Unanga 'o si-la ngowa-ngowa'a siḏi toma ngowa'a repe manga sigolona.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Ma 'orasa wangere so'o ne'o ḏua, Yesus 'ai me-mete'e 'aḏi sapolo ra Unanga re 'aḏi kanau, “Sa'i ri lobi'i re ngi'i ne 'i tiwongo i'a. Jobilaha Jou no soma'a ngowa'a repe nena-ne 'aḏi maḏibo, la 'aḏi tibo manga ngo-ngoromo toma gamu ga'a co-cori ngi'i nena-ne.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesus 'o sangoro, “Ngini nena-ne balasu pula'a ngo-ngoromo ra ananga. Awa simaha ananga 'aḏi maḏibo remanga sawini.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Yesus 'ai me-mete'e 'aḏi kanau, “Ngomi minga dodahe pa'i roti ngai romotoa re nyao'o ngai ḏiḏi!”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yesus 'o kanau, “Gasa gena-ge ino!” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Gena ḏua, Yesus 'o soma'a ngowa'a repe gena-ge 'aḏi tegoro toma rurubu ma re'u. Re Unanga 'o 'oro roti ngai romotoa re ma nyao'o ngai ḏiḏi 'O talaḏi ie da'u diwanga re 'O sibere ie murasa ma la ra Ma Jou'ongu Madutu. Togumu gena, Unanga 'A poti-poti roti re 'A sipula'a Tai me-mete'e, kara ananga ya sibalangu toma ngowa'a repe gena-ge. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Ananga mo-moini 'aḏi oromo singadolo 'aḏi wunusu. Togumu i'a, Yesus 'ai me-mete'e ya lomu ngo-ngoromo ma jingianga re ya sanga pipigu nyagi moi re romoḏiḏi roma-romanga. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Toma 'orasa gena-ge, ngowa'a repe ga'a 'aḏi oromo na-nau'u ḇato ḏa nga cala romotoa, gena-ge siroimi ua we-were'a re ngowa 'olo.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesus 'o tagi toma ḇanyo ma re'u</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mrk. 6:45-52</ref>; <ref loc="JHN 6:16-21">Yoh. 6:16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Togumu i'a, Yesus 'o soma'a 'Ai me-mete'e 'aḏi mabalene toma oti re 'aḏi sidete siḏa i'a da'a talaga kaci moi. Re Unanga 'o soma'a ngowa'a kawasa 'aḏi maḏibo. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Wakutu ngowa'a kawasa raḏi maḏibo, Unanga masiretene 'o pere ie toma sau di'a 'O manyiata. Wakutu lobi'i 'i ngadolo ḏua, 'age Yesus pa'i 'o matengo moju. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Mada'a toma 'orasa gena-ge ḏua, Yesus 'ai me-mete'e ananga raḏi amono lai kiḏanga re raḏi ngadolo toma talaga ma golona. Momoku ya wa'ala manga oti, sababu ananga 'aḏi tomo karawiana.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Wakutu cori wangere i'a, Yesus 'o sapolo ra ananga tagi mete'e ḇanyo ma re'u. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Mada'a wakutu Yesus 'ai me-mete'e 'aḏi oḏi'i Unanga tagi mete'e toma ḇanyo ma re'u, ananga 'aḏi sawana masala re mojongo 'aḏi poa'a, “ 'O ca'ata!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Mada'a Yesus jau-jau 'o kanau ra ananga, “Masiogoro! Ngoi ne Yesus. Dadi mojongo awa!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Ḏua 'a Petrus 'o kanau, “Ma Jou, na'o so'o gena, No soma'a ḇato ngoi to sapolo i'a to tagi mete'e ḇanyo ma re'u.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Unanga 'a sangoro, “Sapolo ino!” Ḏua 'a Petrus 'o 'uci toma oti re 'o tagi mete'e toma ḇanyo ma re'u jau i'a Yesus. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Mada'a wakutu Petrus 'a basono karawiana siḏi woḏi, unanga ro mojongo re ro mulaingi 'o jala. Dadi unanga 'o poa'a, “Ma Jou, No sisalamata ngoi!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Yesus jau-jau 'a toa'a 'ai giama re 'u cako'o 'a Petrus, re 'O kanau, “Petrus, ngana 'ani ngo-ngaku pa'i ceka'a ua ḇato ra Ngoi. I'a sa'olo 'ani 'akala re sinyingara 'i taka-taka?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Ḏua ananga nga muḏiḏi 'aḏi palene toma oti. Toma 'orasa gena-ge ḏua karawiana re momoku ḏi'i mai ri togumu. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yesus 'ai me-mete'e ananga mo-moini 'aḏi silamo'o re siḏubuso Unanga. Ananga gena-ge 'aḏi kanau, “Mode-mode'e, Jou Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u!”<verse eid="MAT 14:33" /></para>
  <para style="s">Yesus 'o si-la ngowa-ngowa'a siḏi toma daeraha Genesaret</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mrk. 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Wakutu Yesus rai me-mete'e raḏi ngadolo toma talaga kaci moi, ananga 'aḏi 'uci toma daeraha Genesaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Re wakutu ngowa-ngowa'a 'age 'aḏi oḏi'i Yesus ro sapolo, ananga ya sihabari toma daeraha mo-moini. Dadi ananga matai gasa ino ngowa-ngowa'a siḏi mo-moini ra Yesus. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Ananga 'aḏi golo'o ra Yesus mangale na'o nyengara gari'a ngowa-ngowa'a siḏi gena-ge taragolo'o ya cigi 'ai juba ma dere ḇato. Ḏua ananga mo-moini ga'a ya cigi Unanga 'ai juba gena-ge raḏi la.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">'Adata toma ete re dotumu</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mrk. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ngowa'a Farisi toropo moi re guru-guru 'agama nga muḏuo i'a, ananga 'aḏi sapolo da'a limau Yerusalem ino ra Yesus, re 'aḏi sano ra unanga, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“I'a sa'olo 'Ani me-mete'e 'aḏi mete'e ua nanga ete re dotumu manga 'adata? Wakutu ananga 'aḏi oromo, ya soso'o siḏa ua manga giama, gena-ge mete'e ua nanga 'atoranga!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesus 'a sangoro, “Re i'a sa'olo ngini ḏi'i ni mete'e ua Ma Jou'ongu Madutu 'ai parenta, la pa'i ni mete'e ninga ete re dotumu manga 'adata? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Sababu Ma Jou'ongu Madutu ro kanau, ‘Silamo'o ninga ḇaḇa re ninga ngina.’ Re Unanga ro kanau ḏi'i, ‘ 'A guna ḇato 'o sosowini 'ai ḇaḇa bolo 'ai ngina, balasu 'o sanga hukumu sengene.’<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Sup. 20:12</ref>, <ref loc="EXO 21:17">21:17</ref>; <ref loc="LEV 20:9">'Im. 20:9</ref>; <ref loc="DEU 5:16">Dad. 5:16</ref></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Mada'a ngini ni sidoto'o, ‘ 'A guna ḇato nyengara 'o kanau tai ḇaḇa bolo tai ngina so'o ne: 'Oru ga'a ngoi balasu to pula'a ra ḇaḇa re ngina, gena-ge ngoi reta pula'a mo-moini sa'olo 'ari jou-jou ra Ma Jou'ongu Madutu.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Dadi unanga gena-ge 'a silamo'o riwara 'ai ḇaḇa re ngina. Dadi sababu ninga ete re dotumu manga 'adata, ngini na si'u'ua Ma Jou'ongu Madutu 'ai parenta gena-ge. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ngini ngowa'a munafiki! Tero mode'e 'a Yesaya 'a sinubuata pasala ḏua mangale ngini: <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />Ma Jou'ongu Madutu 'o kanau so'o ne:</para>
  <para style="q1" vid="MAT 15:8">‘Ngowa-ngowa'a gena-ge 'aḏi silamo'o Ngoi pa'i tamanga 'uḏu ma betu'u</para>
  <para style="q2" vid="MAT 15:8">mada'a tamanga 'akala re sinyingara 'i kiḏanga ra Ngoi.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />'I parasaja ananga gena-ge 'aḏi silamo'o re siḏubuso Ngoi;</para>
  <para style="q2" vid="MAT 15:9">sababu ananga manga do-doto'o pa'i manusia manga 'atoranga ḇato, ga'a 'i mete'e Ngoi 'ari do-doto'o ua!’ ”<note caller="-" style="x"><char style="xo" closed="false">15:8-9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Yes. 29:13</ref></char></note><verse eid="MAT 15:9" /></para>
  <para style="s">'Oru ga'a si'a'a ngowa'a 'aḏi dadi najis ra <optbreak /> Ma Jou'ongu Madutu 'ai momina</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mrk. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Gena ḏua, Yesus 'o 'aro'o ngowa'a manga repe 'aḏi sapolo ra Unanga re 'o kanau i'a ra ananga, “Ni 'isene la-la, la ni sahe. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />'Oru ḇato ga'a 'i osama toma madanga, enanga gena-ge 'i si'a'a ua ngowa'a matengo 'o dadi najis ra Ma Jou'ongu Madutu 'ai momina. Mada'a 'oru ga'a 'i supu toma madanga, enanga gena-ge 'i si'a'a ngowa'a matengo 'o dadi najis ra Unanga 'ai momina.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ḏua 'Ai me-mete'e 'aḏi sapolo re 'aḏi kanau ra Unanga, “Jou na waro mangale ngowa-ngowa'a Farisi manga 'akala re sinyingara 'i gamamu wakutu ya 'isene Jou no kanau so'o gena-ge?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesus 'a sangoro, “ 'Oru ḇato ga'a 'Ari Ḇaḇa toma soroga 'A otomo ua, joro gena-ge ḏuanga i'a 'A wuru'u. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Dadi awa ni kalesanga ngowa'a gena-ge, ananga gena-ge 'o bi-biri'i--bi-biri'i ga'a masihafu. Re na'o ngowa'a hafu matengo 'o tuda ngowa'a hafu, ma ḏo-ḏogumu tala ananga nga muḏiḏi 'aḏi masieta'a toma koti'i ma dara.”<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luk. 6:39</ref></char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petrus 'o kanau, “Jou, tai'i na sitarangi 'ade-'ade nange-ge ma ngale ra ngomi.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yesus 'o sangoro, “Ngini na waro nyangu ḏi'i enanga ma ngale?! <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ngini ni sahe nyangu moju, 'oru ga'a 'i osama toma madanga ngadolo toma po'olo ma dara. Togumu i'a, enanga 'i supu tuwaḏi! <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Mada'a, 'oru ga'a 'i supu toma madanga, enanga gena-ge ma 'asala toma 'akala re sinyingara. Enanga gena-ge 'i si'a'a ngowa'a matengo 'o dadi najis ra Ma Jou'ongu Madutu 'ai momina.<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12:34</ref></char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Sababu toma 'akala re sinyingara 'i baolo 'ulungu ma jira, sisengene ngowa'a, su-sudala, tinikai, to-tori'i, sakisi sa-sakala ngowa'a, re sikanau ngowa'a. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Enanga mo-moini gena-ge si'a'a ngowa'a matengo 'o dadi najis ra Ma Jou'ongu Madutu 'ai momina. Siḏibo ḏi'i, oromo kama soso'o giama ua, enanga gena-ge si'a'a ua ngowa'a matengo 'o dadi najis ra Ma Jou'ongu Madutu 'ai momina.”<verse eid="MAT 15:20" /></para>
  <para style="s">We-were'a Yahudi ua matengo 'ami ngo-ngaku</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mrk. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Gena ḏua, Yesus 'a sisoi'i tala ngi'i gena-ge, re 'O tagi toma daeraha co-cori limau Tirus re limau Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />We-were'a Kanaan matengo toma daeraha gena-ge mo sapolo ra Yesus re mo poa-poa'a, “Ma Jou, 'Olana Daud 'ai ju'uda,<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note> No sijumu 'Ani 'akala re sinyingara ma la-la ra ngoi! 'Ari ngowa'a were'a roh ma jira mi dungosama, dadi munanga mo sangisara masala.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yesus kama kanau bale moi i'a mai ua toma we-were'a gena-ge. Dadi 'Ai me-mete'e 'aḏi sapolo ra Unanga re 'aḏi kanau, “Jou, soma'a we-were'a gena-ge mo tagi, munanga mo 'a'a nyiwere ra ngene nanga ḏuḏunu.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesus 'a sangoro toma we-were'a gena-ge, “Ngoi pa'i sanga 'utusu toma ngowa-ngowa'a Israel ḇato ga'a ma tero sa'olo doba ga'a 'i iranga ngo'omo.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />We-were'a gena-ge sapolo mo maḏipolono ra Yesus 'ai biono re mo kanau, “Ma Jou no riono ngoi!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesus 'a sangoro, “Enanga 'i rousu ua wo 'oro ngowa 'olo manga ngo-ngoromo, kara wa pula'a di'a nunu'u.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />We-were'a gena-ge mo kanau, “Tero mode'e Ma Jou, mada'a nunu'u mai 'i sanga oromo ngo-ngoromo ma so-sorono ga'a 'i eta'a tala ra madutu 'ai meja ma 'aḏu.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ḏua Yesus 'o kanau i'a ra munanga, “Meme 'ani ngo-ngaku lai lamo'o. Sababu gena-ge, 'oru ga'a ngana ni mau, enanga 'i dadi.” Toma 'orasa gena-ge ḏua, 'ami ngowa'a were'a remo la.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesus 'o si-la ngowa'a siḏi manga repe</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ḏua Yesus 'a sisoi'i tala ngi'i gena-ge, re 'o tagi mete'e talaga Galilea ma 'uḏu. Gena ḏua, Unanga 'o materu ie toma polono rimoi kara 'o tegoro. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ngowa'a kawasa 'aḏi sapolo gasa ngowa'a cug̱a, ngowa'a hafu, ngowa'a ḇolo, ngowa'a mou, re ngowa'a siḏi ma lelegu manga repe ḏi'i. Ngowa-ngowa'a siḏi gena-ge ananga ya'u sigare ra Yesus 'ai rou, re Unanga ya'u si-la mo-moini. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Ngowa'a kawasa toma ngi'i gena-ge 'aḏi heranga madutu wakutu ananga 'aḏi oḏi'i masiretene ngowa'a mou raḏi kanau, ngowa'a ḇolo raḏi la, ngowa'a cug̱a raḏi tagi, re ngowa'a hafu raḏi oḏi'i. Ḏua ananga mo-moini 'aḏi puji re silamo'o Ma Jou'ongu Madutu ga'a ngowa'a Israel 'aḏi silamo'o re siḏubuso.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesus pula'a oromo ngowa'a nga cala rata</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mrk. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Gena ḏua, Yesus 'o 'aro'o 'Ai me-mete'e kara 'O kanau ra ananga, “Tari 'akala re sinyingara 'i baolo dadalara toma ngowa'a kawasa nena-ne. Sababu ma di'ara wangere ro'ange ḏua ananga raḏi mamete'e ra Ngoi dadi nange-ne ananga manga ngo-ngoromo 'i moini ḏua. Ngoi to oḏu'u ananga 'aḏi maḏibo remanga sawini, sababu na'o so'o gena-ge awa-awa 'aḏi beberete toma ngo'omo ma golona.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Ḏua, 'Ai me-mete'e 'aḏi sangoro ra Unanga, “Ngi'i nena-ne 'i tiwongo i'a. Wo sanga le'a ngo-ngoromo di'a ngowa'a manga repe nena-ne?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesus 'o sano, “ 'Age roti ngai muḏuo i'a ra ngini?”</para>
  <para style="p" vid="MAT 15:34">Ananga ya sangoro, “Ngai tumudingi re pa'i nyao'o 'alusu ngai muḏuo i'a ḇato.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Ḏua, Unanga gena-ge 'o soma'a ananga ngowa'a kawasa 'aḏi tegoro toma tana'a. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Gena ḏua, Yesus 'a 'oro roti ngai tumudingi re ma nyao'o gena-ge re 'O sibere ie murasa ma la ra Ma Jou'ongu Madutu. Ḏua Unanga 'a poti-poti roti re nyao'o gena-ge re 'O sipula'a Tai me-mete'e di'a ya sibalangu toma ngowa'a kawasa. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Ananga mo-moini 'aḏi oromo singadolo 'aḏi wunusu. Togumu i'a, Yesus 'ai me-mete'e ya lomu ma jingianga ya sanga pipigu tumudingi roma-romanga. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ngowa'a repe ga'a 'aḏi oromo toma 'orasa gena-ge, ananga gena-ge na-nau'u ḇato nga cala rata. We-were'a re ngowa 'olo siroimi ua. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Gena ḏua, Yesus 'o soma'a ananga 'aḏi maḏibo, kara Yesus re 'Ai me-mete'e 'aḏi mabalene toma oti re 'aḏi sidete toma daeraha Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Ngowa'a Farisi re ngowa'a Saduki 'aḏi golo'o <optbreak /> Yesus 'o 'a'a didina'o heranga</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mrk. 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Ngowa'a Farisi re ngowa'a Saduki nga muḏuo i'a 'aḏi sapolo ra Yesus, mau 'aḏi disa Unanga 'ai sala. Dadi ananga 'aḏi golo'o Unanga 'o 'a'a didina'o heranga, la ananga ya waro mode-mode'e Unanga 'o sapolo da'u ra Ma Jou'ongu Madutu tala.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat. 12:38</ref>; <ref loc="LUK 11:16">Luk. 11:16</ref></char></note> <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Yesus 'a sangoro, “Na'o wangere sa'i soḏu re diwanga 'i ko-kolili, ngini kanau, ‘Da-daini i'a wangere ma rousu.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Re da-daini i'a ma wangere sa'i ri pilata na'o diwanga 'i ko-kolili re 'i hafu-hafu, ngini ni kanau, ‘Wangere nange-ne 'i besa'a.’ Ngini nga'unu ni ta'ajiri ni oḏi'i didina'o toma diwanga. Momongolo ua 'oru Ma Jou'ongu Madutu 'o 'a'a toma 'orasa nange-ne, ngini ni ta'ajiri na nga'unu ua! <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ngowa-ngowa'a 'orasa nange-ne ngowa'a ma jira ga'a oḏu'u ngaku Ngoi! Ngini ni golo'o Ngoi to 'a'a didina'o heranga, mada'a rimoi i'a mai ua To pula'a ra ngini, pa'i ḏuga-ḏuga ga'a 'age ra ngini ḏua gena-ge didina'o heranga mangale nabi Yunus. Togumu i'a, Yesus 'o sisoi'i tala ananga gena-ge.”<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat. 12:39</ref>; <ref loc="LUK 11:29">Luk. 11:29</ref></char></note><verse eid="MAT 16:4" /></para>
  <para style="s">Ngowa-ngowa'a Farisi re Saduki manga do-doto'o <optbreak /> 'i site-tero sa'olo ragi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mrk. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Wakutu Yesus rai me-mete'e 'aḏi ngadolo da'a talaga kaci moi, 'Ai me-mete'e aro ya waro mangale ananga 'aḏi gasa roti ua. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesus 'o kanau ra ananga, “Ni ma'istiari ino toma ngowa-ngowa'a Farisi re Saduki manga ragi.”<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk. 12:1</ref></char></note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Wakutu ananga gena-ge 'aḏi 'isene Yesus 'o kanau so'o gena, 'Ai me-mete'e 'aḏi makanau matengo re matengo, “Unanga 'o kanau so'o gena, sababu ngene wo gasa roti ua.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yesus 'a waro 'oru ga'a ananga 'aḏi ma'u kanau matengo re matengo. Dadi Unanga 'o kanau i'a ra ananga, “I'a sa'olo ngini ni ma'u kanau matengo re matengo mangale roti 'i cua?! Ngini ninga ngo-ngaku pa'i ceka'a ua ra Ngoi?! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ngini ni sahe nyangu moju! Ngini ni 'elingi bolo ua mangale 'o roti ngai romotoa ga'a Ngoi ta poti-poti di'a ngowa'a nga cala romotoa re ma bai'i pipigu muḏuo ga'a ngini na lomu?!<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat. 14:17-21</ref></char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Re sa'olo ḏi'i, roti ngai tumudingi, di'a ngowa'a nga cala rata re ma bai'i pipigu muḏuo ga'a ngini na lomu?!<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat. 15:34-38</ref></char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />I'a sa'olo ngini na sahe nyangu moju Ngoi to kanau ra ngini gena-ge mangale 'o roti ua. Ma'istiari toma ngowa-ngowa'a Farisi re Saduki manga ragi!”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Togumu i'a, Yesus 'ai me-mete'e ya sahe mangale Yesus soma'a ua ananga 'aḏi ma'istiari toma ragi ga'a sipake toma roti, mada'a ananga 'aḏi ma'istiari toma ngowa-ngowa'a Farisi re Saduki manga do-doto'o.<verse eid="MAT 16:12" /></para>
  <para style="s">Petrus 'o ngaku Yesus gena-ge 'O Kristus</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mrk. 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesus 'o tagi toma daeraha co-cori limau Kaisarea Filipi. Toma ngi'i gena-ge Unanga 'o sano Tai me-mete'e, “Ngowa'a 'aḏi kanau, Ngoi Manusia ma Ngowa'a Nau'u, ne 'a guna?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />'Ai me-mete'e 'aḏi sangoro, “ 'Age mamuni'a 'aḏi kanau Jou 'a Yohanes tukanga baptis, 'age mamuni'a 'aḏi kanau Jou 'a Elia, 'age mamuni'a ḏi'i 'aḏi kanau Jou 'a Yeremia, bolo nabi matengo i'a.”<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">Mat. 14:1-2</ref>; <ref loc="MRK 6:14-15">Mrk. 6:14-15</ref>; <ref loc="LUK 9:7-8">Luk. 9:7-8</ref></char></note><verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yesus dadunu 'o sano, “Mada'a na'o mete'e ngini masiretene nena-ne, Ngoi ne 'a guna?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simon Petrus 'a sangoro, “Jou 'O Kristus, Ma Jou'ongu Madutu 'o 'ahu-'ahu, Unanga gena-ge 'Ai Ngowa'a Nau'u.”<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">Yoh. 6:68-69</ref></char></note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesus 'o kanau, “Simon 'a Yona 'ai ngowa'a nau'u, ngana no bara'utungu madutu! Sababu manusia ua 'o siajele gena-ge ra ngana, mada'a 'Ari Ḇaḇa toma soroga. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Sababu gena-ge, Ngoi nena-ne to siajele ra ngana: Ngana nena-ne tini si'aro'o 'a Petrus: gena-ge ma ngale ‘maḏi’. Dadi ngana ma tero sa'olo maḏi di'a wala ma bangini. Re toma maḏi nena-ne ma re'u, Ngoi to simomi'i 'Ari jama'ata. Re kuasa sengene mai ya singi-ngiranga nga'unu ua. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Soroga ma pareta<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> ma kuci, Ngoi ḏuanga i'a to pula'a ra ngana. Dadi 'oru ga'a ngana toma dungia nena-ne no simaha ua, Ma Jou'ongu Madutu toma soroga mai Ra mete'e ḏi'i. Re 'oru ga'a ngana toma dungia nena-ne na simaha, Ma Jou'ongu Madutu toma soroga mai Ra mete'e ḏi'i.”<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat. 18:18</ref>; <ref loc="JHN 20:23">Yoh. 20:23</ref></char></note><verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Togumu i'a, Yesus 'a si'elingi Tai me-mete'e, awa ananga 'aḏi siajele ra guna ḇato mangale Unanga 'O Kristus.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesus 'o masiajele mangale Unanga 'ai sangisara re <optbreak /> 'Ai se-sengene</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mrk. 8:31–9:1</ref>; <ref loc="LUK 9:22-27">Luk. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Mulaingi toma 'orasa gena-ge, Yesus 'o kanau sitarangi Tai me-mete'e, Unanga balasu 'o tagi toma limau Yerusalem, re 'O sanga sangisara ma repe toma Yahudi manga bi-biri'i, 'imam-'imam ma sae'e, re guru-guru 'agama. Ngowa'a ḏuanga i'a 'aḏi sisengene Unanga, mada'a toma wangere ma soi ro'ange Unanga dadunu 'o 'ahu moju.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ḏua Petrus 'o taba'a Yesus 'ai giama re 'aḏi masai'i i'a, kara 'o ḇangata Yesus re 'o kanau, “Ma Jou, na'o nga'unu Ma Jou'ongu Madutu 'a sikiḏanga. Awa 'i dadi so'o gena ra Ma Jou!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesus 'o magelelo i'a ra Petrus re 'o kanau, “Tagi i'a da'a, 'Iblisi! Ngana no dola'aku Ngoi. 'Ani fikirana, gena-ge manusia manga fikirana, Ma Jou'ongu Madutu 'ai fikirana ua.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Gena ḏua, Yesus 'o kanau Tai me-mete'e, “ 'A guna ḇato mau 'o mete'e Ngoi, balasu 'a mete'e 'ai mau masiretene riwara<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Enanga ma ngale: pa'i mete'e Ma Jou'ongu Madutu 'ai 'akala ma mau ḇato.</char></note> re balasu 'o doiti 'ai salib<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Enanga ma ngale: matengo i'a 'o ḏu-ḏuanga ḏua sengene sababu 'o mete'e Yesus.</char></note> kara 'o mete'e Ngoi tau-taunu.<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat. 10:38</ref>; <ref loc="LUK 14:27">Luk. 14:27</ref></char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Sababu 'a guna ḇato ga'a 'o kadiarata pa'i 'ai 'ahu toma dungia nena-ne ḇato, unanga gena-ge 'o sanga ua 'ahu kasingado-ngadolo i'a. Mada'a 'a guna ḇato mete'e 'ai mau masiretene riwara sababu 'o mau mete'e Ngoi; unanga gena-ge ḏuanga i'a 'o sanga 'ahu kasingado-ngadolo i'a.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat. 10:39</ref>; <ref loc="LUK 17:33">Luk. 17:33</ref>; <ref loc="JHN 12:25">Yoh. 12:25</ref></char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Sababu ma 'utungu 'i cua na'o ngowa'a matengo 'o sanga 'ori i'a rana mo-moini toma dungia nena-ne ma dara, mada'a 'o sanga ua 'ahu kasingado-ngadolo i'a! Sababu 'ori i'a rana mo-moini toma dungia nena-ne ma dara 'i sipula'a ua 'ahu kasingado-ngadolo i'a!<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />Sababu rema kuasa Tari Ḇaḇa ti'ara riwara, Ngoi, Manusia ma Ngowa'a Nau'u mamete'e Rari mala'ekata-mala'ekata ḏuanga i'a 'aḏi sapolo. Toma 'orasa gena-ge, Ngoi to balasa mete'e matengo-matengo manga ga'a.<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat. 25:31</ref>; <ref loc="PSA 62:12">Nya. 62:12</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref></char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Taninga sigolona 'age rema ngowa'a ga'a 'aḏi 'ahu-'ahu moju re 'aḏi oḏi'i Ngoi, Manusia ma Ngowa'a Nau'u to sapolo sa'olo 'Olana.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">'U simulia Yesus</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mrk. 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Wangere rarama palisi'i i'a Yesus 'o gasa 'a Petrus, 'a Yakobus re 'a Yohanes, ananga nga muḏiḏi gena-ge gia nongoḏu. Ananga 'aḏi masai'i re mabere ie toma kie kau'u rimoi re toma ngi'i gena-ge ngowa'a lelegu cua, pa'i ananga ḇato. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Yesus 'ai rupa 'i ngali ra ananga nga ḏu'ange manga biono: 'Ai biono ma tarangi ma tero wangere ma la'o, re 'Ai pakeanga 'i dadi buḏo jama-jamanga. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Gena ḏua, Yesus 'ai me-mete'e nga ḏu'ange, ananga 'aḏi oḏi'i 'a Musa re 'a Elia, 'aḏi makanau ra Yesus. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Petrus 'o kanau i'a ra Yesus, “Ma Jou, rousu madutu ngene 'ane-ne. Na'o Ma Jou no nyanyaḏi, ngoi to side'oso suyu'u ḏu ro'ange toma ngi'i nena-ne: ḏu moi di'a Ma Jou, ḏu moi di'a Musa re ḏu moi ḏi'i di'a Elia.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Wakutu 'a Petrus 'o ka-kanau moju, kakamo lai tarangi ya'u sao ananga re toma kakamo gena-ge ma dara 'aḏi 'isene iḏingi ma betongo so'o ne: “Unanga nena-ne 'Ari Ngowa'a Nau'u ga'a Tu dadalara, Ngoi 'ari 'akala re sinyingara ma sanangi Ta sipa'ala ra Unanga. Ni 'isene Unanga!”<note caller="-" style="x"><char style="xo" closed="false">17:1-5 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2Pet. 1:17-18</ref></char></note> <note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Do. 22:2</ref>; <ref loc="PSA 2:7">Nya. 2:7</ref>; <ref loc="ISA 42:1">Yes. 42:1</ref>; <ref loc="MAT 3:17">Mat. 3:17</ref>, <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mrk. 1:11</ref>; <ref loc="LUK 3:22">Luk. 3:22</ref>; <ref loc="DEU 18:15">Dad. 18:15</ref></char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Wakutu Yesus 'ai me-mete'e 'aḏi 'isene so'o gena, ananga 'aḏi dadi mojongo lai siḏi re 'aḏi ruba paga-pagara manga biono tala toma tana'a. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Mada'a Yesus 'o sapolo re 'O cigi ananga re 'O kanau, “Ni momi'i, ni mojongo awa!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Wakutu ananga 'aḏi momi'i 'aḏi oḏi'i ngowa'a lelegu ua, pa'i Yesus masiretene.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Wakutu ananga 'aḏi 'uci da'u kie tala, Yesus 'o sipo-poma ra ananga, “Awa ni sijarita ra guna ḇato mangale 'oru ga'a ni oḏi'i nange-ge singadolo Ngoi, Manusia ma Ngowa'a Nau'u, dadunu to 'ahu moju toma ngowa'a senge-sengene manga sigolona.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Yesus 'ai me-mete'e 'aḏi sano ra Unanga, “I'a sa'olo guru-guru 'agama 'aḏi kanau mangale nabi Elia balasu sapolo siḏa, kara 'O Mesias 'o sapolo?”<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal. 4:5</ref></char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesus 'a sangoro, “Mode-mode'e nabi Elia ḏuanga i'a 'o sapolo, re unanga 'o sidiai 'ori i'a mo-moini di'a 'O Mesias. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Mada'a Ngoi to siajele ra ngini nena-ne: Elia ro sapolo, mada'a ngowa'a 'aḏi nana'o unanga ua re 'aḏi 'a'a cira ra unanga mete'e ananga manga mau ḇato. So'o gena ḏi'i, ananga ḏuanga i'a 'aḏi 'a'a cira ra Ngoi, Manusia ma Ngowa'a Nau'u, mete'e ananga manga mau.”<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat. 11:14</ref></char></note><verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Ḏua Yesus 'ai me-mete'e ya sahe wakutu Unanga 'o kanau mangale nabi Elia ga'a ro sapolo, 'Ai maksudu Yohanes tukanga baptis.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesus 'o si-la ngowa 'olo matengo roh ma jira 'u dungosama</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mrk. 9:14-29</ref>; <ref loc="LUK 9:37-43a">Luk. 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Wakutu Yesus re 'Ai me-mete'e nga ḏu'ange ananga 'aḏi maḏibo i'a toma ngowa'a kawasa gena-ge, na-nau'u matengo 'o sapolo re 'o maḏipolono ra Yesus 'ai biono. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Unanga 'o kanau, “Jou, no sijumu 'Ani 'akala re sinyingara ma la-la tari ngowa'a na-nau'u. Unanga 'o sarasone re 'o basono sangisara lai siḏi. Dadi soi rai o'o i'a unanga 'o eta'a toma u'u re toma ḇanyo. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ngoi reto gasa unanga Tani me-mete'e, mada'a unanga ananga 'u si-la yoḏu'u.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesus 'a sangoro, “Ngini mode-mode'e ngowa-ngowa'a ga'a ni ngaku Ngoi ua re ni iranga ninga ngo'omo! Singadolo ma di'ara ngau moju, Ngoi balasu to tegoro marimoi ra ngini?! Singadolo ma di'ara ngau moju, Ngoi to sidodai 'Ari 'akala ḇanyo ra ngini?! Gasa ino ngowa 'olo gena-ge!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Gena ḏua, Yesus 'a soma'a roh ma jira, ga'a 'i osama toma ngowa 'olo gena-ge, 'i supu. Dadi roh ma jira gena-ge 'i supu. Toma 'orasa gena-ge ḏua, ngowa 'olo gena-ge ro la.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Gena ḏua, wakutu Yesus pa'i 'o matengo ḇato, 'Ai me-mete'e 'aḏi sapolo ra Unanga re 'aḏi sano, “I'a sa'olo ngomi mi dusu'u yoḏu'u roh ma jira gena-ge?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesus 'a sangoro, “Sababu ngini ninga ngo-ngaku pa'i ceka'a ua. Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Na'o ngini ninga ngo-ngaku ma lamo'o sa'olo gisisi lai ceka'a ngai moi, ngini nga'unu kanau toma kie nena-ne ‘Malage i'a da'a’ re tantu ḏua enanga 'i malage. Na'o ngini ninga ngo-ngaku so'o gena, 'oru ḇato ngini nga'unu na 'a'a!” <note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">Mat. 21:21</ref>; <ref loc="MRK 11:23">Mrk. 11:23</ref>; <ref loc="1CO 13:2">1Kor. 13:2</ref> </char></note> [ <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Mada'a roh ma jira so'o nena-ne, ngini nyengara na dusu'u pa'i ni manyiata re puasa ḇato.]<verse eid="MAT 17:21" /></para>
  <para style="s">Yesus 'o kanau moju mangale 'Ai se-sengene</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mrk. 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luk. 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Wakutu Yesus re 'Ai me-mete'e, ananga 'aḏi malomu toma Galilea, Yesus 'o kanau ra ananga, “Ngoi, Manusia ma Ngowa'a Nau'u ḏuanga i'a sipula'a toma manusia ma kuasa. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Ngoi, ananga Ri sisengene, mada'a toma wangere ma soi ro'ange, Ngoi dadunu to 'ahu moju.”</para>
  <para style="p" vid="MAT 17:23">Re 'Ai me-mete'e 'aḏi garura madutu.<verse eid="MAT 17:23" /></para>
  <para style="s">Ma Jou'ongu Madutu 'ai Wala ma balastengi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Wakutu Yesus re 'Ai me-mete'e, ananga 'aḏi ngadolo toma limau Kapernaum, ngowa'a ga'a lomu balastengi di'a Ma Jou'ongu Madutu 'ai Wala, ananga 'aḏi sapolo re sano ra Petrus, “ 'Ani guru 'o fangu bolo ua balastengi di'a Ma Jou'ongu Madutu 'ai Wala?”<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">Sup. 30:13</ref>, <ref loc="EXO 38:26">38:26</ref></char></note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Petrus 'a sangoro i'a, “Unanga 'a fangu!”</para>
  <para style="p" vid="MAT 17:25">Wakutu Petrus 'o ḏibo ino 'o osama toma wala ma dara, Yesus 'o sano ra unanga siḏa, “Simon, mete'e 'ani wo-waro: 'a guna fangu balastengi re bea toma 'olana-'olana dungia nena-ne, manga rayata bolo ngowa'a sa-sapolo ino?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petrus 'a sangoro, “Ngowa'a sa-sapolo ino.”</para>
  <para style="p" vid="MAT 17:26">Yesus 'o kanau, “Na'o so'o gena, rayata paralu ua fangu balastengi. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Mada'a awa ngene wa'u caḏabi ngowa-ngowa'a ga'a lomu balastengi gena-ge. Dadi, ngana si'a toma talaga di'a no ga-gawolo nyao'o. Re ngana no 'oro nyao'o ga'a na tuono ma mulaingi re ngana no sanga pipisi-pipisi toma nyao'o ma madanga. Pipisi-pipisi gena-ge 'i site-tero ngene nga muḏiḏi nanga balastengi di'a Ma Jou'ongu Madutu 'ai Wala. Ḏua ngana no pula'a pipisi-pipisi gena-ge toma ngowa'a ga'a lomu balastengi di'a Ma Jou'ongu Madutu 'ai Wala.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">'A guna lebe la-lamo'o toma Soroga ma Pareta</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mrk. 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Toma 'orasa gena-ge Yesus 'ai me-mete'e 'aḏi sapolo sano ra Unanga, “ 'A guna lebe la-lamo'o toma Soroga ma Pareta?”<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta. Gena-ge ma tero toma bu-bula'a 3, 4, 23.</char></note><note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luk. 22:24</ref></char></note><verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesus 'o 'aro'o ngowa 'olo matengo re 'O side-de'oso tamanga biono. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Ḏua Unanga 'o kanau, “Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Na'o ngini ni dadi ua ma tero sa'olo ngowa 'olo nena-ne, ngini ni osama nyo-nyoimi yoḏu'u toma Soroga ma Pareta.<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">Mrk. 10:15</ref>; <ref loc="LUK 18:17">Luk. 18:17</ref></char></note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Sababu gena-ge, 'a guna ḇato 'o maholo 'ai diri ma tero sa'olo ngowa 'olo nena-ne, unanga gena-ge lebe la-lamo'o i'a toma Soroga ma Pareta. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Re 'a guna ḇato 'o dawongo ngowa 'olo ma tero sa'olo ngowa 'olo nena-ne sababu unanga 'o mete'e Ngoi, gena-ge ma tero sa'olo unanga 'o dawongo Ngoi ḏi'i.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Mada'a na'o 'a guna ḇato 'o sigasa ngowa-ngowa'a ma pake ua ma tero sa'olo ngowa 'olo nena-ne, singadolo ananga 'aḏi ngaku Ngoi riwara, Ma Jou'ongu Madutu 'o sihukumu unanga gena-ge lebe tubuso i'a. Jobilaha maḏi la-lamo'o 'i siḏobe tai camala, kara sijala unanga toma ngoloto. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Ngowa'a toma dungia nena-ne ḏuanga i'a sanga bahala sababu rema 'ori i'a ga'a si'a'a ananga 'aḏi baraḏosa. Tantu ḏua gena-ge 'i dadi, mada'a 'a guna ḇato 'o sigasa ngowa'a 'aḏi madaga'a ḏosa, unanga gena-ge 'o sanga bahala lamo'o!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Na'o ngini ninga giama kaci moi bolo ninga rou kaci moi 'i sigasa ngini ni madaga'a ḏosa; ni tola'a kara na upa'a. Jobilaha, ngini ni 'ahu ra Ma Jou'ongu Madutu pa'i reninga giama kaci moi ḇato bolo rou kaci moi ḇato reo reninga giama bolo rou kaci ḏiḏi sanga upa'a toma u'u malejanga kama sora riwara.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat. 5:30</ref></char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Re na'o ngini ninga la'o kaci moi 'i sigasa ngini ni madaga'a ḏosa, ni cuḇulenge kara na upa'a. Jobilaha ngini ni 'ahu ra Ma Jou'ongu Madutu pa'i reninga la'o kaci moi ḇato, reo reninga la'o kaci ḏiḏi sanga upa'a toma u'u malejanga kama sora riwara.”<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat. 5:29</ref></char></note><verse eid="MAT 18:9" /></para>
  <para style="s">'Ade-'ade mangale doba rimoi 'i iranga</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Awa si'u'ua ngowa'a ma pake ua ga'a raḏi ngaku Ngoi, ananga gena-ge ma tero sa'olo ngowa 'olo nena-ne. Sababu Ngoi to siajele ra ngini nena-ne: Mala'ekata-mala'ekata ga'a 'aḏi jaga ngowa 'olo gena-ge, 'age tau-taunu toma soroga ra Ma Jou'ongu Madutu 'ai momina.</para>
  <para style="p" vid="MAT 18:10">[ <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Sababu Ngoi, Manusia ma Ngowa'a Nau'u, to sapolo, di'a sisalamata ngowa-ngowa'a ga'a kiḏanga ra Ma Jou'ongu Madutu ma tero sa'olo doba-doba ga'a 'i iranga.]<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Toma kartasi lo-lolo lelegu, bu-bula'a gena-ge 'i cua.</char></note><note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">Luk. 19:10</ref></char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Ngini ninga 'akala ma sanga sa'olo? Na'o 'age rema ngowa'a matengo i'a rai doba latu moi, mada'a 'i iranga rimoi, unanga 'o 'a'a 'oru?! Tantu ḏua, unanga 'a sisoi'i tala ma nyagi siworo re siworo gena-ge toma polono re 'o tagi 'a disa ma rimoi ga'a 'i iranga. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Re na'o unanga ra sanga doba ga'a 'i iranga gena-ge -- ni ngaku mode-mode'e 'Ari demo-demo nena-ne -- unanga lebe maroanga mangale doba rimoi gena-ge reo ma nyagi siworo re siworo ga'a 'i iranga ua. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />So'o gena ḏi'i, ninga Ḇaḇa toma soroga 'O oḏu'u ngowa'a ma pake ua ga'a ro ngaku Ngoi 'o iranga kasingado-ngadolo i'a.”<verse eid="MAT 18:14" /></para>
  <para style="s">Na'o 'ani ioronongoḏu matengo 'o madaga'a ḏosa ra ngana</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Na'o 'ani ioronongoḏu matengo 'o madaga'a ḏosa ra ngana,<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Toma kartasi lo-lolo lelegu demo nena-ne 'i cua: </char><char style="fk" closed="false">ra ngana </char></note> ngana no tagi ra unanga re no siajele mangale 'ai sala 'oru, pa'i la'o ngai rata ḇato. Na'o unanga 'a mete'e 'ani demo-demo, ngini nga muḏiḏi dadunu ni marimoi moju.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">Luk. 17:3</ref></char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Mada'a na'o unanga 'o dawongo 'ani demo-demo ua, ngana dadunu no tagi ra unanga re no gasa ngowa'a matengo bolo nga muḏiḏi ḏi'i. Sababu toma Boku 'Ofi-'Ofi ri silefo so'o ne: ‘Ma kuranga ḏua nga muḏiḏi bolo nga ḏu'ange 'aḏi dadi sakisi di'a sibanari ngowa'a gena-ge 'ai sala.’<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Dad. 19:15</ref></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Na'o unanga mai 'o dawongo ua ananga manga demo-demo, ngana no siajele hali gena-ge toma jama'ata. Ma ḏo-ḏogumu na'o unanga mai 'o dawongo jama'ata manga demo-demo ua, awa ngini ni ma'u supu re osama ra unanga gena-ge, ma tero sa'olo unanga ngowa'a golo-golo'o balastengi, bolo ngowa'a ga'a nana'o ua Ma Jou'ongu Madutu.”<verse eid="MAT 18:17" /></para>
  <para style="s">'Oru ga'a 'i yoḏu'u re 'oru ga'a 'i nyengara</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: 'Oru ga'a ngini ni simaha ua toma dungia nena-ne, Ma Jou'ongu Madutu toma soroga mai Ra mete'e ḏi'i. Re 'oru ga'a ngini ni simaha toma dungia nena-ne, Ma Jou'ongu Madutu toma soroga mai Ra mete'e ḏi'i.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mat. 16:19</ref>; <ref loc="JHN 20:23">Yoh. 20:23</ref></char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Ngoi to siajele ra ngini nena-ne ḏi'i: Na'o toma dungia 'age nga muḏiḏi taninga sigolona ga'a marimoi mangale 'oru ḇato ngini ni manyiata Tari Ḇaḇa toma soroga, Unanga ḏuanga i'a 'a sitotomo ninga go-golo'o. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Sababu toma ngi'i le'a ḇato 'age nga muḏiḏi bolo nga ḏu'ange 'aḏi malomu sababu Ngoi, Ngoi 'age tamanga sigolona.”<verse eid="MAT 18:20" /></para>
  <para style="s">'Ade-'ade mangale budaka matengo 'o si'apongo ua <optbreak /> 'ai ḏagilomu budaka</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Gena ḏua, Petrus 'o sapolo ra Yesus re 'o sano, “Ma Jou, na'o 'ari ioronongoḏu 'a'a ḏosa ra ngoi, singadolo soi muḏuo ngoi balasu to si'apongo unanga? Singadolo soi tumudingi?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesus 'a sangoro, “Ngoi to kanau ra ngana, pa'i soi tumudingi ḇato ua, mada'a balasu si'apongo unanga soi nyagi tumudingi sidu'o soi tumudingi!<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">'Age toma kartasi lo-lolo lelegu 'i silefo so'o ne: </char><char style="bd">si'apongo unanga soi nyagi tumudingi re tumudingi!</char> </note> <note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Yesus 'ai maksudu so'o ne: Ngene balasu wo si'apongo ngowa'a kama bati ua!</char></note><note caller="-" style="x"><char style="xo" closed="false">18:21-22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">Luk. 17:3-4</ref></char></note> <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Sababu Soroga ma Pareta ma tero sa'olo 'ade-'ade so'o ne: 'Olana matengo mau 'ai budaka-budaka 'aḏi fangu manga banyatoro. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Siḏa-siḏa budaka matengo ga'a 'ai banyatoro rema juta-juta, ananga 'u sitalaḏi ra 'olana gena-ge. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Mada'a unanga 'a fangu 'a simoini 'a nga'unu ua. Dadi 'olana 'o parenta ngowa'a 'aḏi wu'unu budaka gena-ge, re 'ai ngowa'a re were'a, re 'ori i'a rana mo-moini, la sifangu 'ai banyatoro.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Budaka gena-ge 'o maḏipolono ra 'olana 'ai biono re madigaro'o, ‘Tuanga no sijumu 'ani 'akala ḇanyo ra ngoi, re maha ḏuanga i'a ngoi ta fangu ta simoini.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Dadi 'olana 'ai 'akala re sinyingara 'i baolo dadalara tai budaka gena-ge, singadolo budaka gena-ge 'ai banyatoro ma 'olana 'a singi-ngiranga re sibebasa unanga di'a 'o tagi maḏibo.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Mada'a wakutu budaka gena-ge 'o supu, unanga ma'u sanga 'ai ḏagilomu budaka matengo ga'a 'ai banyatoro cala muḏuo i'a ra unanga. Ḏua unanga 'u cako'o re 'u colokoko re 'o kanau, ‘Na fangu simoini 'ani banyatoro!’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Ḏua 'ai ḏagilomu gena-ge 'o mapagara 'ai biono tala re maḏigaro'o ra unanga, ‘Wolo, no sijumu 'ani 'akala ḇanyo ra ngoi, re maha ḏuanga i'a ngoi ta fangu ta simoini!’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Mada'a unanga 'a itomo. Siḏibo ḏi'i, unanga 'u singosama 'ai ḏagilomu budaka toma bui, singadolo 'ai banyatoro 'a fangu simoini. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Wakutu budaka-budaka ma lelegu ananga ya oḏi'i i'a gena-ge, ananga manga 'akala re sinyingara 'i kangela. Dadi ananga 'aḏi siajele mangale gena-ge ra 'olana. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Ḏua 'olana gena-ge 'o 'aro'o budaka ga'a 'ai 'akala re sinyingara ma jira re 'o kanau i'a ra unanga, ‘Budaka ma jira! Ngana 'ani banyatoro ngoi ta singi-ngiranga mo-moini, pa'i sababu no maḏigaro'o ḇato ra ngoi. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />I'a sa'olo, ngana no sijumu ua 'ani 'akala re sinyingara ma la-la tani ḏagilomu budaka, ma tero sa'olo ngoi reto sijumu 'ari 'akala re sinyingara ma la-la ra ngana?’<verse eid="MAT 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 18:34" />Dadi 'olana 'o ruta masala toma budaka gena-ge ga'a 'ai 'akala re sinyingara 'i cira re 'u singosama unanga toma bui, singadolo 'a fangu 'ai banyatoro simoini.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Yesus 'a siḏo-ḏogumu 'ai 'aḏe-'aḏe gena-ge so'o ne: “So'o gena ḏi'i, 'Ari Ḇaḇa da'u toma soroga ḏuanga i'a nu 'a'a ngini matengo re matengo, na'o ngini ni si'apongo ua taninga 'akala re sinyingara ninga ioronongoḏu ga'a 'a'a ḏosa ra ngini.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesus 'ai do-doto'o mangale were'a nau'u ma'u oḏu'u</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mrk. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Wakutu Yesus 'o doto'o togumu i'a Unanga 'a sisoi'i tala daeraha Galilea, re 'o tagi toma daeraha Yudea, toma Ḇanyo Yordan kaci moi <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Toma ngi'i gena-ge ngowa'a kawasa 'aḏi mete'e Unanga, re Unanga ya'u si-la ananga manga si-siḏi.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ngowa'a Farisi nga muḏuo i'a 'aḏi sapolo ra Yesus, ananga 'aḏi disa Yesus 'ai sala. Ananga 'aḏi sano, “Mete'e nanga 'agama ma hukumu, nau'u oḏu'u 'ai were'a sababu ma 'alasana 'oru ḇato, nyengara bolo ua?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesus 'a sangoro, “Tantu ḏua, ngini reni baca toma Boku 'Ofi-'Ofi mangale wakutu Ma Jou'ongu Madutu 'o sidadi manusia, ma mulaingi 'age 'o na-nau'u re we-were'a?!<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Do. 1:27</ref>, <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Togumu i'a, Ma Jou'ongu Madutu 'o kanau ra ananga nga muḏiḏi, ‘Sababu gena-ge, na-nau'u 'o sisoi'i tala 'ai ḇaḇa re 'ai ngina, re 'o marimoi tai were'a, kara ananga nga muḏiḏi 'aḏi dadi rimoi.’<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Do. 2:24</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Dadi ananga 'aḏi dadi nga muḏiḏi riwara, mada'a raḏi dadi rimoi. Sababu gena-ge, 'oru ga'a Ma Jou'ongu Madutu ra sirimoi, manusia wa sito-tola'a yoḏu'u.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Ḏua ngowa'a Farisi 'aḏi sano moju, “Na'o so'o gena, i'a sa'olo 'a Musa 'o soma'a nau'u balasu pula'a surata tola'a tai were'a ga'a unanga re mi oḏu'u?”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Dad. 24:1-4</ref>; <ref loc="MAT 5:31">Mat. 5:31</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesus 'a sangoro, “Musa 'o pula'a loasa ni oḏu'u ninga were'a sababu ngini ninga 'akala re sinyingara lai te'e. Mada'a ma ba-banari toma mulaingi i'a so'o gena ua. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Dadi, Ngoi to siajele ra ngini nena-ne: 'A guna ḇato 'a oḏu'u 'ai were'a, mada'a were'a gena-ge mo tinikai ua, kara 'o molo'ara we-were'a lelegu, unanga gena-ge 'o tinikai.”<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat. 5:32</ref>; <ref loc="1CO 7:10-11">1Kor. 7:10-11</ref></char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ḏua Yesus 'ai me-mete'e 'aḏi kanau ra Unanga, “Na'o so'o gena, jobilaha molo'ara awa!”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesus 'a sangoro, “Demo gena-ge ngowa'a mo-moini ua nga'unu ya mete'e, mada'a pa'i ngowa'a ga'a Ma Jou'ongu Madutu ra sitantukanga. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Sababu 'age rema ngowa'a ga'a masinge-ngeta'a da'u tala ga'a 'aḏi molo'ara 'i yoḏu'u. Re 'age rema ngowa'a ga'a 'aḏi molo'ara 'i yoḏu'u, sababu ngowa'a ya'u kabiri. Re 'age ḏi'i rema ngowa'a ga'a mau 'aḏi de-de'oso Ma Jou'ongu Madutu, dadi 'aḏi molo'ara ua. Ngowa'a ga'a nga'unu ya mete'e 'ani demo-demo gena-ge, lebe rousu ananga ya si'a'a.”<verse eid="MAT 19:12" /></para>
  <para style="s">Yesus sibarakati ngowa 'olo-ngowa 'olo</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mrk. 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />'Age 'orasa rimoi, ngowa-ngowa'a 'aḏi gasa i'a manga ngowa 'olo ra Yesus, la Unanga 'a siteru 'Ai giama ra ananga di'a ya'u sibarakati. Mada'a 'Ai me-mete'e 'aḏi ḇangata ngowa'a gena-ge ga'a gasa manga ngowa 'olo.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Ḏua Yesus 'o kanau Tai me-mete'e, “Sieanga i'a ḇato ngowa 'olo nena-ne 'aḏi sapolo ra Ngoi. Awa ni dola'aku ananga, sababu ngowa'a ga'a 'aḏi dadi ma tero sa'olo ngowa 'olo-ngowa 'olo nena-ne pa'i ananga gena-ge nyengara 'aḏi osama nyo-nyoimi toma Soroga ma Pareta.”<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta. Gena-ge ma tero toma bu-bula'a 23, 24.</char></note><verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Gena ḏua, Yesus 'a siteru 'Ai giama toma ngowa 'olo-ngowa 'olo matengo re matengo manga sae'e ma re'u kara 'O sibarakati ananga. Gena ḏua Unanga 'o tagi sisoi'i tala ngi'i gena-ge.<verse eid="MAT 19:15" /></para>
  <para style="s">Tubaie matengo ngowa'a rema-enanga</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mrk. 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Toma wangere rimoi, 'age tubaie matengo 'o sapolo ra Yesus, re 'o sano, “Guru, ngoi balasu to 'a'a ga'a ma la-la sa'olo, la to dawongo 'ahu kasingado-ngadolo i'a?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesus 'a sangoro, “I'a sa'olo no sano ra Ngoi mangale 'ori i'a ma la-la? Pa'i Matengo ḇato ma la-la. Na'o ngana mau no sanga 'ahu kasingado-ngadolo i'a, ngana balasu no mete'e parenta-parenta ra Ma Jou'ongu Madutu.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Tubaie gena-ge 'o sano, “Parenta-parenta sa'olo?”</para>
  <para style="p" vid="MAT 19:18">Yesus 'a sangoro, “No sisengene ngowa'a awa, no tinikai awa, no tori'i awa, no dadi sakisi sa-sakala awa,<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Sup. 20:13-16</ref>; <ref loc="DEU 5:17-20">Dad. 5:17-20</ref></char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />no silamo'o 'ani ḇaḇa re 'ani ngina, re no dadalara ngowa'a lelegu ma tero sa'olo no dadalara 'ani diri masiretene.”<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Sup. 20:12</ref>; <ref loc="DEU 5:16">Dad. 5:16</ref>; <ref loc="LEV 19:18">'Im. 19:18</ref></char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Tubaie gena-ge 'a sangoro, “Parenta mo-moini gena-ge ngoi reta mete'e. 'I kuranga 'oru moju?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesus 'o kanau, “Na'o ngana mau no dadi ti-tiai, no maḏibo re na wu'unu 'ani 'ori i'a rana mo-moini, re ma pipisi na sibalangu toma ngowa-ngowa'a ma dinga'unu ua. Dadi, ngana ḏuanga i'a no sanga 'ori i'a rana mode-mode'e toma soroga. Togumu i'a no sapolo re no mete'e Ngoi!”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Wakutu tubaie gena-ge 'a 'isene Yesus 'o kanau so'o gena, unanga 'o maḏibo rai 'akala re sinyingara 'i kangela, sababu unanga gena-ge ngowa'a rema-enanga madutu.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Ḏua Yesus 'o kanau Tai me-mete'e, “Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Kangela masala di'a ngowa'a rema-enanga 'aḏi osama nyo-nyoimi ra Ma Jou'ongu Madutu 'ai Pareta.<note caller="+" style="f"><char style="fr" closed="false">19:23 </char><char style="fk" closed="false">Ma Jou'ongu Madutu 'ai Pareta </char><char style="ft" closed="false">ma tero Soroga ma Pareta.</char></note> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Re Ngoi to siajele ra ngini nena-ne ḏi'i: Lebe gapanga 'o 'unta rimoi 'i osama toma j̱aiti ma duso'o reo ngowa'a rema-enanga 'aḏi osama nyo-nyoimi ra Ma Jou'ongu Madutu 'ai Pareta.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Wakutu 'ai me-mete'e ya 'isene Yesus 'o kanau so'o gena, ananga 'aḏi heranga masala re 'aḏi kanau, “Na'o so'o gena, 'a guna nga'unu sanga salamata?!”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesus 'o tatamo ananga re 'o kanau, “Toma manusia 'i osama 'akala ua, mada'a ra Ma Jou'ongu Madutu mo-moini 'i osama 'akala.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Ḏua Petrus 'o sangoro, “Ngomi remi sisoi'i tala mo-moini, la mi mete'e Jou! Dadi ngomi sanga 'oru?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesus 'o kanau ra ananga, “Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Toma dungia su-sungi Ngoi, Manusia ma Ngowa'a Nau'u ḏuanga i'a To tegoro Tari ḏe-ḏegoro ga'a mulia. Re toma 'orasa gena-ge, ngini Ngoi 'ari me-mete'e, ni tegoro toma ḏe-ḏegoro nyagi moi re romoḏiḏi, re ni sijuruhakimi ngowa'a Israel suku nyagi moi re romoḏiḏi.<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mat. 25:31</ref>; <ref loc="LUK 22:30">Luk. 22:30</ref></char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />'A guna ḇato ra sisoi'i tala 'ai wala, 'ai iḏanga re biḏanga, 'ai ḇaḇa re ngina, 'ai ngowa-ngowa'a bolo 'ai guḏa sababu mete'e Ngoi, unanga gena-ge ḏuanga i'a 'o dawongo maḏibo siḏuolo latu moi re 'o sanga ḏi'i 'ahu kasingado-ngadolo i'a. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Mada'a ngowa'a repe ga'a nange-ne 'aḏi dadi ngowa'a la-lamo'o, ḏuanga i'a 'aḏi dadi ngowa'a ma pake ua. Re ngowa'a repe ga'a nange-ne 'aḏi dadi ngowa'a ma pake ua, ḏuanga i'a 'aḏi dadi ngowa'a la-lamo'o.”<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat. 20:16</ref>; <ref loc="LUK 13:30">Luk. 13:30</ref></char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">'Ade-'ade mangale ngowa-ngowa'a munara toma guḏa 'anggur</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Wakutu Soroga ma Pareta<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> 'i ngadolo, enanga gena-ge ma tero sa'olo 'ade-'ade nena-ne: Da-daini i'a moju guḏa 'anggur ma dutu matengo 'o tagi 'o disa ngowa'a di'a 'aḏi munara tai guḏa 'anggur. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Unanga 'a si'aturu ananga manga ngogele wange moi pipisi salaka ngai moi. Togumu i'a 'o soma'a ananga 'aḏi munara tai guḏa 'anggur gena-ge. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Ca'olo siworo da-daini i'a, guḏa 'anggur ma dutu gena-ge dadunu 'o tagi ḏi'i, re 'o oḏi'i ngowa'a nga muḏuo i'a pa'i 'aḏi maro-roka ḇato toma pasara. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ḏua unanga 'o kanau i'a toma ngowa-ngowa'a gena-ge, ‘Tagi ni munara ra ngoi 'ari guḏa 'anggur. Ngoi ḏuanga i'a tini fangu ninga munara ma ijana ga'a ngoi reta putusu 'i 'adili.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Gena ḏua, ananga 'aḏi tagi munara,</para>
  <para style="p" vid="MAT 20:5">Ca'olo nyagi moi re romoḏiḏi wange 'olona tala, re wange so'o ne'o ca'olo ro'ange, guḏa 'anggur ma dutu gena-ge dadunu 'o tagi di'a 'o sewa ngowa'a munara. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Re ḏa ca'olo romotoa wangere so'o ne'o, unanga gena-ge dadunu 'o tagi, re 'o oḏi'i rema ngowa'a moju pa'i 'aḏi maro-roka ḇato. Unanga ya'u sano i'a ra ananga, ‘I'a sa'olo toma wange moi ma dara, ngini ni maga'a 'oru rimoi i'a mai ua?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Ngowa-ngowa'a gena-ge 'aḏi sangoro, ‘Ngowa'a 'aḏi sipula'a munara ngomi ua.’</para>
  <para style="p" vid="MAT 20:7">Dadi guḏa 'anggur ma dutu gena-ge 'o kanau, ‘Na'o so'o gena, ngini tagi re ni munara ra ngoi 'ari guḏa 'anggur.’ Dadi ananga gena-ge tagi munara.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Wakutu wangere so'o ne'o ḏa ca'olo rarama, guḏa 'anggur ma dutu 'o kanau tai ngowa'a munara ma sae'e, ‘ 'Aro'o re lomu ngowa'a munara mo-moini, la ta fangu ananga matengo re matengo manga munara ma ngogele; mulaingi toma ngowa'a munara ga'a sapolo ma siḏo-ḏogumu singadolo ngowa'a munara ga'a 'aḏi sapolo ma mulaingi.’<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">'Im. 19:13</ref>; <ref loc="DEU 24:15">Dad. 24:15</ref></char></note><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Ngowa'a munara ga'a 'aḏi osama munara ca'olo romotoa wange so'o ne'o, ananga gena-ge matai sapolo. Ananga matengo re matengo 'aḏi sanga pipisi salaka ngai moi. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Gena ḏua, sapolo ḏi'i ngowa'a munara ga'a 'aḏi osama munara da-daini i'a moju. Ananga 'aḏi mafikiri ananga 'aḏi sanga pipisi lai lamo'o. Momongolo ua, ananga matengo re matengo mai 'aḏi sanga pipisi salaka ngai moi. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Wakutu ananga 'aḏi sanga manga pipisi gena-ge, ananga 'aḏi kuḏubungu toma guḏa 'anggur ma dutu re 'aḏi kanau, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘Ananga ga'a osama munara ma siḏo-ḏogumu pa'i 'aḏi munara jam rimoi. Ngomi mi munara wange moi ma dara, re sidogo wangere ya 'erese ngomi singadolo wangere so'o ne'o, mada'a ngana no fangu minga munara ma tero sa'olo ananga gena-ge manga munara!’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Guḏa 'anggur ma dutu gena-ge 'a sangoro ra matengo tamanga sigolona, ‘Wolo, ngoi kai ri sala ua ra ngana. Ngana re ngoi, 'oru ngene wo nyengara ḏua: No munara wange moi, no sanga pipisi salaka ngai moi? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Dadi na 'oro 'ani pipisi kara no tagi. Ngoi mau to pula'a ngowa'a munara ga'a 'aḏi sapolo ma siḏo-ḏogumu manga pipisi ma lamo'o ma tero sa'olo ta ngana ḏi'i. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ngoi nyengara bolo ua to pula'a 'ari pipisi ra guna ḇato mete'e 'ari mau?! I'a sa'olo ngana 'ani 'akala re sinyingara 'i go-goḏi? 'Oru sababu 'ari 'akala re sinyingara lai mura?’ ”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“Dadi, ngowa'a ga'a ngowa'a mapake ua, ḏuanga i'a 'aḏi dadi ngowa'a la-lamo'o. Re ngowa'a ga'a ngowa'a la-lamo'o, ḏuanga i'a 'aḏi dadi ngowa'a mapake ua.”<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat. 19:30</ref>; <ref loc="MRK 10:31">Mrk. 10:31</ref>; <ref loc="LUK 13:30">Luk. 13:30</ref></char></note><verse eid="MAT 20:16" /></para>
  <para style="s">Yesus 'o masiajele mangale 'Ai se-sengene ma soi ro'ange</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mrk. 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Wakutu Yesus 'o tagi toma limau Yerusalem, toma ngo'omo ma golona Unanga 'o 'aro'o re ya'u lomu 'Ai me-mete'e nga nyagi moi re nga muḏiḏi re 'aḏi mawola i'a pa'i ananga re 'O kanau, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“ 'Isene! Ngene nange-ne wo si'a toma limau Yerusalem. I'a da'a Ngoi, Manusia ma Ngowa'a Nau'u, ḏuanga i'a sipula'a toma 'imam-'imam ma sae'e re guru-guru 'agama. Re Ngoi ḏuanga i'a ananga Ri singe-ngeta'a hukumu sengene. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Gena ḏua, Ngoi sipula'a ḏi'i toma ngowa-ngowa'a Yahudi ua. Ngoi, ananga Ri sije-jengere re Ri sipo, kara Ri sisalib. Mada'a toma wangere ma soi ro'ange, Ngoi dadunu to 'ahu moju.”<verse eid="MAT 20:19" /></para>
  <para style="s">Yakobus re 'a Yohanes manga ngina 'ami go-golo'o</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mrk. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Gena ḏua, 'a Zebedeus 'ai were'a re 'ami ngowa'a nau'u nga muḏiḏi, 'a Yakobus re 'a Yohanes, ananga 'aḏi sapolo ra Yesus. Munanga mo maḏipolono ra Unanga 'ai biono re mo golo'o 'ori i'a rimoi i'a.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesus 'o sano, “Meme no mau 'oru?”</para>
  <para style="p" vid="MAT 20:21">Munanga mo sangoro, “Ngoi to mau 'ari ngowa'a nga muḏiḏi nena-ne matengo 'o tegoro Tani giama ma kuwiḏa re matengo 'o tegoro Tani giama ma kuḇali, wakutu Jou ḏuanga i'a No dadi 'Olana.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesus 'o kanau ra Yakobus re 'a Yohanes, “Ngini ni sahe ua 'oru ga'a ni golo'o. Nga'unu bolo ua ni ka'e Tari sawo'o ga'a Ngoi balasu ta ka'e? 'Ari sawo'o ma dara gena-ge 'i romanga reo susa re sangisara?”</para>
  <para style="p" vid="MAT 20:22">Ananga ya sangoro, “Ngomi ma nga'unu.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesus 'o kanau ra ananga, “Mode-mode'e, ḏuanga i'a ngini ni ka'e Tari sawo'o. Mada'a mangale 'a guna 'o tegoro Tari giama ma kuwiḏa bolo Tari giama ma kuḇali, gena-ge Ngoi 'ari haku ua ta sitantukanga. 'Ari Ḇaḇa ra sitantukanga 'a guna tegoro toma ngi'i-ngi'i gena-ge.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Wakutu Yesus 'ai me-mete'e nga nyagi moi ya 'isene so'o gena, ananga 'aḏi ruta ra Yakobus re 'a Yohanes. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Dadi Yesus ya'u 'aro'o ananga mo-moini re 'O kanau, “Ngini ni waro mangale bangsa-bangsa manga sae'e ga'a nana'o ua Ma Jou'ongu Madutu, ananga gena-ge 'aḏi sikangela manga rayata. Re ngowa'a la-lamo'o 'aḏi simau-mau manga rayata, la ya mete'e manga parenta. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Mada'a ngini ni 'a'a so'o gena awa. Siḏibo ḏi'i, 'a guna ḇato mau 'o dadi ngowa'a la-lamo'o taninga sigolona, unanga balasu 'o dadi falalomu siḏa.<note caller="-" style="x"><char style="xo" closed="false">20:25-26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luk. 22:25-26</ref></char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Re 'a guna ḇato mau 'o dadi sae'e taninga sigolona, unanga balasu 'o dadi ninga budaka.<note caller="-" style="x"><char style="xo" closed="false">20:26-27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat. 23:11</ref>; <ref loc="MRK 9:35">Mrk. 9:35</ref>; <ref loc="LUK 22:26">Luk. 22:26</ref></char></note> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />So'o gena-ge ḏi'i ma tero sa'olo Ngoi, Manusia ma Ngowa'a Nau'u. Ngoi to sapolo di'a ngowa-ngowa'a 'aḏi de-de'oso Ngoi ua. Mada'a Ngoi to sapolo di'a To de-de'oso ngowa-ngowa'a, re Ta sidoa'a 'Ari 'ahu di'a To tuusu ngowa'a repe tamanga ḏosa.”<verse eid="MAT 20:28" /></para>
  <para style="s">Yesus 'o si-la ngowa'a hafu nga muḏiḏi</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mrk. 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Wakutu Yesus re 'Ai me-mete'e ananga 'aḏi tagi sisoi'i tala limau Yerikho, ngowa'a kawasa 'aḏi mete'e Unanga. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />'Age rema ngowa'a hafu nga muḏiḏi 'aḏi tegoro toma ngo'omo ma 'uḏu. Wakutu ananga 'aḏi 'isene Yesus 'o tola'a ino toma ngo'omo gena-ge, ananga 'aḏi poa'a, “Ma Jou, 'Olana Daud 'ai ju'uda,<note caller="+" style="f"><char style="fr" closed="false">20:30 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note> Na sijumu 'Ani 'akala re sinyingara ma la-la ra ngomi!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ngowa'a kawasa toma ngi'i gena-ge ananga ya'u ḇangata re 'aḏi soma'a ngowa'a hafu nga muḏiḏi gena-ge masiogoro. Mada'a ananga ganapu ya siduga manga iḏingi, “Ma Jou, 'Olana Daud 'ai ju'uda,<note caller="+" style="f"><char style="fr" closed="false">20:31 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note> Na sijumu 'Ani 'akala re sinyingara ma la-la ra ngomi!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Ḏua, Yesus 'o matogumu re ya'u 'aro'o ananga sapolo ra Unanga. Unanga ya'u sano i'a, “Ngini ni mau 'oru Ngoi ta si'a'a ra ngini?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Ananga ya sangoro, “Ma Jou, ngomi mau mi oḏi'i!”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Dadi Tai 'akala re sinyingara 'i baolo dadalara ra ananga re 'A cigi manga la'o. Toma 'orasa gena-ge ḏua, ananga raḏi oḏi'i kara 'aḏi mete'e Unanga.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Wakutu Yesus osama limau Yerusalem, <optbreak /> ngowa'a kawasa 'U puji re silamo'o</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mrk. 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Wakutu ananga 'aḏi co-cori limau Yerusalem, ananga 'aḏi ngadolo toma gamu Betfage toma Polono Zaitun. Toma ngi'i gena-ge Yesus 'o soma'a 'ai me-mete'e nga muḏiḏi, ananga tagi siḏa. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Unanga 'o kanau ra ananga gena-ge, “Ngini ni tagi siḏa i'a da'a toma gamu taninga biono. I'a da'a ni oḏi'i keledai rimoi rema ngowa, ngowa'a ya sipiri'u i'a. Na pasala enanga romoḏiḏi ma gumi re na gasa ino 'ane. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Na'o matengo i'a 'o sano ra ngini mangale 'oru ni 'a'a so'o gena-ge, ni kanau, ‘Ma Jou 'a paralu.’ Ḏua unanga gena-ge 'a dola'aku ua ngini na gasa keledai rimoi rema ngowa.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Enanga 'i dadi so'o gena, la sitotomo 'oru ga'a nabi 'a sinubuata pasala ḏua:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Siajele ngowa-ngowa'a toma limau Yerusalem.</para>
  <para style="q2" vid="MAT 21:5">‘Oḏi'i, ninga 'Olana 'o sapolo ra ngini ino,</para>
  <para style="q1" vid="MAT 21:5">Unanga 'ai 'akala re sinyingara 'i mereoso re 'O maholo tala</para>
  <para style="q2" vid="MAT 21:5">re 'O mabalene toma keledai rimoi,</para>
  <para style="q2" vid="MAT 21:5">toma keledai ra-ramasa ie.’ ”<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Za. 9:9</ref></char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Dadi 'Ai me-mete'e nga muḏiḏi gena-ge 'aḏi tagi, re ya si'a'a ma tero sa'olo 'oru ga'a Yesus 'o bererongo ra ananga. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ananga ya gasa keledai gena-ge rema ngowa. Ḏua ananga ya siwangini manga juba toma keledai romoḏiḏi ma ḏuḏunu, kara Yesus 'o mabalene. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ngowa'a kawasa ya woi'i manga juba re ya sisela toma ngo'omo. Re 'age rema ngowa'a lelegu ḏi'i 'aḏi tola'a ate ma umanga ya siwangini toma tapaka. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ngowa'a kawasa ga'a 'aḏi tagi siḏa-siḏa re ḏi'i ngowa'a kawasa ga'a 'aḏi tu-tuu'u ra Yesus, ananga mo-moini 'aḏi poa'a so'o ne:</para>
  <para style="q1" vid="MAT 21:9">“Puji re silamo'o 'Olana Daud 'ai ju'uda!”<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note></para>
  <para style="q1" vid="MAT 21:9">“Sibarakati Unanga ga'a 'o sapolo ra Ma Jou'ongu Madutu 'ai lomanga!”</para>
  <para style="q1" vid="MAT 21:9">“Puji re silamo'o Ma Jou'ongu Madutu toma Gau'u!”<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Nya. 118:26</ref></char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Wakutu Yesus 'o osama limau Yerusalem, ngowa'a mo-moini toma limau gena-ge 'aḏi nyiwere re 'aḏi ma'u sano, “Unanga nena-ne 'a guna?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Ngowa'a kawasa ga'a 'aḏi mamete'e ra Unanga 'aḏi sangoro, “Unanga nena-ne Yesus, nabi toma limau Nazaret toma daeraha Galilea ino.”<verse eid="MAT 21:11" /></para>
  <para style="s">Yesus 'o osama ra Ma Jou'ongu Madutu 'ai Wala</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mrk. 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Gena ḏua, Yesus 'o osama ra Ma Jou'ongu Madutu 'ai Wala ma soana re 'O dusu'u ngowa'a ga'a 'aḏi mawu'unu re matibo toma ngi'i gena-ge. Unanga 'a sipagara ngowa-ngowa'a singali-ngali pipisi manga meja re 'a siruba ngowa-ngowa'a mawu'unu namo dara manga bako-bako. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ḏua Unanga 'o kanau i'a ra ananga, “Toma Boku 'Ofi-'Ofi 'i silefo mangale Ma Jou'ongu Madutu 'o kanau so'o ne: ‘ 'Ari wala ngowa'a ḏuanga i'a ya silomanga manyiata ma wala.’ Mada'a ngini ni si'a'a ngowa'a to-tori'i manga ngi'i!”<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Yes. 56:7</ref>; <ref loc="JER 7:11">Yer. 7:11</ref></char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ngowa'a hafu re ngowa'a ḇolo 'aḏi sapolo ra Yesus ra Ma Jou'ongu Madutu 'ai Wala ma soana re Unanga ya'u si-la. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Mada'a 'imam-'imam ma sae'e re guru-guru 'agama, ananga gena-ge 'aḏi ruta ra Yesus. Sababu ananga gena-ge 'aḏi oḏi'i Unanga 'o 'a'a ga'a hera-heranga, re 'isene ngowa 'olo 'aḏi poa'a ra Ma Jou'ongu Madutu 'ai Wala ma soana: “Puji re silamo'o 'Olana Daud 'ai ju'uda!”<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="fk" closed="false">'Olana Daud 'ai ju'uda </char><char style="ft" closed="false">ma tero sa'olo: Daud 'ai Ngowa'a Nau'u.</char></note><verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Dadi ananga 'aḏi sano ra Yesus, “Ngana no 'isene ananga 'aḏi poa'a 'oru?”</para>
  <para style="p" vid="MAT 21:16">Yesus 'a sangoro, “Ya, Ngoi ta 'isene. Tantu ḏua ngini rena baca 'oru ga'a 'i silefo toma Boku 'Ofi-'Ofi so'o ne:</para>
  <para style="q1" vid="MAT 21:16">‘Ma Jou'ongu Madutu reno doto'o ngowa 'olo re ngowa kiau di'a 'aḏi puji re silamo'o ti-tiai Unanga.’ ”<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:3">Nya. 8:3</ref></char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Gena ḏua, Yesus 'o supu sisoi'i tala ananga toma limau Yerusalem re 'O tagi toma gamu Betania re 'O otu toma gamu gena-ge.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesus 'a sisasi ate 'ara</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mrk. 11:12-14</ref>, <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ma ḇiḇini ino da-daini i'a moju, wakutu Yesus 'o maḏibo toma limau Yerusalem, toma ngo'omo ma golona, Unanga 'o basono sawini. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Dadi wakutu Unanga 'o oḏi'i ate 'ara ḏu moi toma ngo'omo ma 'uḏu, Unanga 'o tagi sebanga i'a toma ate gena-ge. Mada'a kalaha ate gena-ge rema ma so'a, Unanga 'a oḏi'i ma sowo'o rimoi i'a mai ua!<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Biasa, na'o ate 'ara rema so'a, 'age sowo'o ceka'a i'a ḏi'i.</char></note> Ḏua Yesus 'a kanau i'a toma ate gena-ge, “Mulaingi toma 'orasa nena-ne re si'a, ngana kama sowo'o riwara!” Ate gena-ge jau-jau ri wa'alo.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Wakutu Yesus 'ai me-mete'e ya oḏi'i 'oru 'i dadi gena-ge, ananga 'aḏi heranga masala. Ananga 'aḏi sano, “I'a sa'olo ate ara gena-ge ri wa'alo caiti?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesus 'a sangoro, “Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Na'o ngini ni ngaku mode-mode'e re na sitaka-taka ua, ngini nga'unu na si'a'a ma tero sa'olo Ngoi ta si'a'a toma ate 'ara nena-ne. Re pa'i gena-ge ḇato ua, ngini nyengara ni kanau kie nena-ne, ‘No malage re no eta'a toma ngoloto.’ Re enanga gena-ge ḏuanga i'a 'i dadi.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat. 17:20</ref>; <ref loc="1CO 13:2">1Kor. 13:2</ref></char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Na'o ngini ni ngaku mode-mode'e, 'oru ḇato ngini golo'o taninga nyiata ma dara, ngini ḏuanga i'a na dawongo.”<verse eid="MAT 21:22" /></para>
  <para style="s">So-sano mangale Yesus 'ai kuasa</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mrk. 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Gena ḏua, Yesus dadunu 'o maḏibo re 'o osama ra Ma Jou'ongu Madutu 'ai Wala ma soana, di'a 'O doto'o. Wakutu Unanga 'o doto'o ngowa'a moju, 'imam-'imam ma sae'e re Yahudi manga bi-biri'i 'aḏi sapolo ra Unanga re 'aḏi sano, “No sanga 'Ani kuasa le'a ino, singadolo Ngana no 'a'a mo-moini gena-ge? Re 'a guna 'o pula'a kuasa ra Ngana?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesus 'a sangoro, “Ngoi ḏi'i mau to sano siḏa ra ngini. Na'o ngini nga'unu na sangoro, kara Ngoi ta siajele 'a guna pula'a kuasa ra Ngoi singadolo Ngoi ta si'a'a mo-moini gena-ge. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />'A Yohanes tukanga baptis, unanga gena-ge 'o sanga 'ai kuasa ra guna ino? Ra Ma Jou'ongu Madutu bolo toma manusia ino?”</para>
  <para style="p" vid="MAT 21:25">Ḏua 'imam-'imam ma sae'e re Yahudi manga bi-biri'i 'aḏi ma'u kanau tamanga sigolona, “Na'o ngene wo sangoro ‘ 'A Yohanes gena-ge 'o sanga kuasa ra Ma Jou'ongu Madutu ino,’ ḏua Unanga 'o sano, ‘Na'o so'o gena-ge, i'a sa'olo ngini ni ngaku Unanga ua?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Mada'a na'o wo sangoro, ‘Unanga 'o sanga kuasa toma manusia ino,’ ngene wo mojongo ngowa'a repe sababu ananga mo-moini 'aḏi ngaku Yohanes gena-ge 'o dadi nabi.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Dadi ananga 'aḏi sangoro, “Ngomi ma waro ua.”</para>
  <para style="p" vid="MAT 21:27">Ḏua Yesus 'o kanau ra ananga, “Na'o so'o gena, Ngoi mai ta siajele ua ra ngini mangale Ngoi to sanga kuasa ra guna ino, singadolo nga'unu ta si'a'a mo-moini gena-ge.”<verse eid="MAT 21:27" /></para>
  <para style="s">'Ade-'ade mangale ngowa'a nau'u nga muḏiḏi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yesus dadunu 'o kanau toma 'imam-'imam ma sae'e re Yahudi manga bi-biri'i, “Ngini ninga 'akala ma sanga sa'olo mangale nena-ne? 'Age rema ḇaḇa matengo ga'a 'ai ngowa'a nau'u nga muḏiḏi. Unanga 'o tagi ra ma ngowa'a nau'u ma ioro re 'o kanau, ‘ 'Ari ngowa'a nau'u, wangere nange-ne ngana no tagi munara toma guḏa 'anggur.’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Ngowa'a nau'u ma ioro 'a sangoro, ‘Ngoi to oḏu'u.’ Mada'a togumu i'a 'o madibanga 'a siḏibo 'ai 'akala re sinyingara re 'o tagi munara toma guḏa 'anggur. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Gena ḏua, ḇaḇa gena-ge 'o tagi tai ngowa'a ma nongoḏu re 'o kanau so'o gena ḏi'i. Ngowa'a ma nongoḏu gena-ge 'a sangoro, ‘Ya baba.’ Mada'a unanga 'o tagi ua.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Nah tai ngowa'a nga muḏiḏi gena-ge 'a guna ga'a 'a mete'e manga ḇaḇa 'ai mau?”</para>
  <para style="p" vid="MAT 21:31">Ananga gena-ge ya sangoro, “Ngowa'a nau'u ma ioro.”</para>
  <para style="p" vid="MAT 21:31">Ḏua, Yesus 'o kanau ra ananga, “Ni ngaku mode'e 'Ari demo nena-ne: Ngowa'a golo-golo'o balastengi re we-were'a su-sudala, ananga gena-ge 'aḏi osama nyo-nyoimi ra Ma Jou'ongu Madutu 'ai Pareta;<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fk" closed="false">Ma Jou'ongu Madutu 'ai Pareta </char><char style="ft" closed="false">ma tero Soroga ma Pareta. Gena-ge ma tero toma bu-bula'a 43.</char></note> mada'a ngini ua! <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Sababu Yohanes tukanga baptis, unanga ro sapolo re sijumu ra ngini mangale 'ahu ma duhu ga'a mete'e Ma Jou'ongu Madutu 'ai 'akala ma mau. Mada'a ngini ni ngaku ua unanga 'ai do-doto'o. Siḏibo ḏi'i, ngowa'a golo-golo'o balastengi re we-were'a su-sudala, ananga gena-ge raḏi ngaku 'ai do-doto'o. Sidogo ḏi'i, kalaha ngini reni oḏi'i gena-ge, ngini ni maḏibo ua toma ngo'omo boloto re ni ngaku ua moju Yohanes 'ai do-doto'o!”<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luk. 3:12</ref>, <ref loc="LUK 7:29-30">7:29-30</ref></char></note><verse eid="MAT 21:32" /></para>
  <para style="s">'Ade-'ade mangale ngowa'a munara toma guḏa 'anggur</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mrk. 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yesus 'o kanau moju, “ 'Isene toma 'ade-'ade ma lelegu rimoi ḏi'i: 'Age rema guḏa ma dutu matengo 'o otomo 'anggur tai guḏa ḇotu moi. Gena ḏua, unanga 'a hisa sigoloḏi re 'o paiti tana'a ma duso'o di'a 'anggur ma sowo'o ma jo-jo'o. Gena ḏua, side'oso wala teru di'a ngowa'a jaga. Togumu i'a, unanga 'o sisewa toma ngowa-ngowa'a munara toma guḏa kara 'o tagi toma nagara lelegu.<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Yes. 5:1-2</ref></char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Wakutu ma 'orasa 'utu'u 'anggur enanga 'i ngadolo, guḏa ma dutu 'o siḏingoto 'ai budaka-budaka 'aḏi tagi tai ngowa-ngowa'a munara toma guḏa di'a ya 'oro 'ai balangu.<figure style="fig" alt="walled vineyard" file="LB00103B.TIF" size="span" ref="21:33">Guḏa 'anggur</figure><verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />Mada'a ngowa-ngowa'a munara toma guḏa ya'u cako'o guḏa ma dutu 'ai budaka-budaka gena-ge: Matengo ya'u ca'olo, ma lelegu ya'u sisengene, ma lelegu ya'u poini reo maḏi singadolo 'o sengene. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ḏua guḏa ma dutu dadunu siḏingoto 'ai budaka-budaka ma lelegu lebe repe i'a reo ma mulaingi. Mada'a ngowa-ngowa'a munara toma guḏa ya'u 'a'a cira ma tero so'o gena ḏi'i. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ma ḏo-ḏogumu tala, guḏa ma dutu 'o siḏingoto 'ai ngowa'a nau'u masiretene. Unanga 'o fikiri so'o ne: ‘Tantu ḏua ngowa-ngowa'a munara toma guḏa, ananga 'aḏi silamo'o 'ai ngowa'a nau'u.’<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Mada'a wakutu ngowa-ngowa'a munara toma guḏa 'aḏi oḏi'i guḏa ma dutu 'ai ngowa'a nau'u 'o sapolo, ananga 'aḏi ma'u kanau matengo re matengo, ‘Unanga nena-ne 'o warisi ma gu-gu'u. Ino ngene wu sisengene unanga, la ngene wa sanga 'ai warisi!’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Dadi guḏa ma dutu 'ai ngowa'a nau'u, ananga 'u cako'o re 'u upa'a toma guḏa 'anggur ma di'anga, kara 'u sisengene.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Gena ḏua, Yesus 'o sano toma 'imam-'imam ma sae'e re Yahudi manga bi-biri'i, “Dadi, wakutu guḏa ma dutu ḏuanga i'a 'o sapolo, unanga 'o 'a'a 'oru tai ngowa-ngowa'a munara toma guḏa gena-ge?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Ananga ya sangoro, “Tantu ḏua unanga ya'u sisengene ngowa-ngowa'a ma jira gena-ge, kara guḏa ma dutu 'o sisewa 'ai guḏa 'anggur toma ngowa'a munara toma guḏa ma lelegu ga'a mau ya pula'a guḏa ma dutu 'ai balangu wakutu 'utu'u ma 'orasa 'i ngadolo.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Ḏua Yesus 'o kanau ra ananga, “Tantu ḏua ngini rena baca 'oru ga'a 'i silefo toma Boku 'Ofi-'Ofi so'o ne:</para>
  <para style="q1" vid="MAT 21:42">‘Maḏi ga'a wala ma tukanga ya upa'a ḏua,</para>
  <para style="q2" vid="MAT 21:42">ma nyonyata maḏi gena-ge ri dadi maḏi ma re'u i'a di'a wala ma bangini.</para>
  <para style="q1" vid="MAT 21:42">Gena-ge Ma Jou'ongu Madutu 'ai munara,</para>
  <para style="q2" vid="MAT 21:42">re tananga momina 'i rousu masala!’ ”<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Nya. 118:22-23</ref></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Sababu gena-ge, Ngoi to siajele ra ngini nena-ne: Ngini ninga haku sa'olo Ma Jou'ongu Madutu 'ai 'umata, gena-ge Ma Jou'ongu Madutu 'a 'oro re 'A sipula'a di'a bangsa lelegu ga'a manga 'ahu mete'e Ma Jou'ongu Madutu 'ai 'akala ma mau. [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Re ngowa'a 'aḏi eta'a toma maḏi gena-ge 'aḏi wejere rotu-rotu, re ngowa'a ga'a maḏi gena-ge ya'u pe-pe'ara, ananga 'aḏi wejere singadolo 'aḏi dadi korou'u.]”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Wakutu 'imam-'imam ma sae'e re ngowa'a Farisi ya 'isene Yesus 'ai 'ade-'ade gena-ge, ananga 'aḏi waro Unanga 'o kanau so'o gena-ge mangale ananga. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Dadi ananga 'aḏi disa ngo'omo di'a cako'o Unanga. Mada'a ananga 'aḏi mojongo ngowa'a repe sababu ananga 'aḏi ngaku Yesus gena-ge 'o dadi nabi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">'Ade-'ade mangale molo'ara ma laya</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesus 'o kanau ḏi'i toma ngowa'a kawasa re 'O pake 'ade-'ade, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Soroga ma Pareta ma tero sa'olo toma 'ade-'ade nena-ne: 'Age 'olana matengo ga'a 'o 'a'a molo'ara ma laya di'a 'ai ngowa'a nau'u. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />'Olana gena-ge 'o soma'a 'ai budaka-budaka 'aḏi tagi re 'aḏi 'aro'o ngowa-ngowa'a ga'a 'aḏi sanga saele di'a sapolo. Mada'a ananga gena-ge ga'a raḏi sanga saele 'aḏi oḏu'u sapolo.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Ḏua 'olana gena-ge 'o soma'a 'ai budaka-budaka ma lelegu 'aḏi tagi toma ngowa'a ga'a raḏi sanga saele. Unanga 'o kanau tai budaka gena-ge, ‘Ni siajele toma ngowa-ngowa'a ga'a reta'u saele mangale ngo-ngoromo toma laya, 'i ḏu-ḏuanga ḏua: Sapi ma la-lamo'o re sapi ma ngowa reta tola'a, mo-moini ri ḏuanga. Ino sapolo toma molo'ara ma laya.’<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Mada'a ngowa-ngowa'a gena-ge ga'a Unanga ya'u saele ḏua, ananga 'aḏi sikalesanga i'a ua. Ananga 'aḏi tagi tamanga munara: Mamuni'a 'aḏi tagi tamanga guḏa, mamuni'a ḏi'i 'aḏi tagi tamanga toko. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Re ngowa'a ma lelegu 'aḏi cako'o ma 'olana 'ai budaka, ya'u ca'olo singadolo ya'u sisengene. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Wakutu 'olana 'a 'isene 'oru ga'a 'i dadi, unanga 'o ruta madutu. Dadi unanga 'o siḏingoto 'ai sordado-sordado di'a tagi re 'aḏi sisengene ngowa-ngowa'a gena-ge ga'a 'aḏi sisengene 'ai budaka-budaka, kara ya tau'u ananga manga limau.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Togumu i'a, unanga 'o 'aro'o 'ai budaka-budaka re 'o kanau, ‘Molo'ara ma laya 'i ḏu-ḏuanga ḏua, mada'a ngowa'a ga'a ngoi ta'u saele, ananga 'aḏi patasa ua di'a mete'e toma laya gena-ge. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Sababu gena-ge ni tagi re 'a guna ḇato ga'a ma'u sanga toma tapaka-tapaka ni saele ananga, la 'aḏi sapolo ino toma molo'ara ma laya nena-ne.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ḏua 'ai budaka-budaka gena-ge 'aḏi tagi. Ananga 'aḏi tagi toma tapaka-tapaka re 'aḏi lomu ngowa-ngowa'a mo-moini ga'a 'aḏi ma'u sanga, bae ngowa'a la-la, bolo ngowa'a ma jira, singadolo molo'ara ma laya ma ngi'i 'i masituḏu-tuḏu i'a reo ioronongoḏu.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Gena ḏua, 'olana gena-ge 'o osama di'a oḏi'i ioronongoḏu-ioronongoḏu toma laya ma dara. Unanga 'o oḏi'i ngowa'a matengo 'o mapake 'ai pakeanga 'i patasa ua di'a molo'ara ma laya. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Dadi 'olana 'o sano toma ngowa'a gena-ge, ‘Wolo, i'a sa'olo ngana no osama toma laya ma dara, mada'a no mapake pakeanga 'i patasa ua di'a molo'ara ma laya?’ Ngowa'a gena-ge pa'i 'o masiogoro. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Ḏua 'olana gena-ge 'o kanau tai falalomu-falalomu, ‘Ngowa'a nena-ne nu piri'u 'ai rou re 'ai giama kara upa'a unanga toma hafu-hafu. Toma ngi'i gena-ge, 'age rema ngowa'a ya rerese ma gaḏi re ya doiti ma sangisara.’ ”<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>, <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk. 13:28</ref></char></note><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Ḏua Yesus 'a siḏo-ḏogumu 'ai 'ade-'ade so'o ne: “Repe ga'a sanga saele di'a osama nyo-nyoimi toma Soroga ma Pareta, mada'a sanga cumutu repe ua di'a 'aḏi dadi 'Ai ngowa-ngowa'a.”<verse eid="MAT 22:14" /></para>
  <para style="s">So-sano mangale fangu balastengi ra Kaisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mrk. 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Togumu i'a, ngowa-ngowa'a Farisi 'aḏi malomu. Ananga 'aḏi disa ma ngo'omo di'a disa Yesus 'ai sala remanga so-sano--so-sano. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Dadi ananga 'aḏi soma'a manga me-mete'e nga muḏuo i'a, re 'Olana Herodes 'ai ngowa-ngowa'a nga muḏuo i'a, 'aḏi sapolo ra Yesus. Ananga 'aḏi kanau, “Guru, ngomi waro Jou ngowa'a loasa re banari, No doto'o sitaḇela'a i'a mangale Ma Jou'ongu Madutu 'ai 'akala ma mau toma manusia. Re Jou no mete'e ua 'a guna ḇato 'ai mau sababu No siwola-wola ngowa'a ua, mete'e manga rupa re jamani. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Sababu gena-ge, Jou no siajele ra ngomi, 'oru 'ani 'akala ma sanga mangale nena-ne: Mete'e nanga 'agama ma 'atoranga, nyengara bolo ua, ngene wo fangu balastengi ra Kaisar?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Mada'a Yesus 'a waro ananga manga 'ulungu ma jira dadi 'O kanau, “Hei ngini ngowa'a munafiki. I'a sa'olo ni mau disa Ngoi 'ari sala? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Sijumu ino ra Ngoi, 'o pipisi ga'a ngini ni sifangu balastengi!” Ḏua ananga 'aḏi pula'a ra Unanga, pipisi salaka ngai moi.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />Yesus 'o sano i'a ra ananga, “Ne 'a guna 'ai biono, re 'a guna 'ai lomanga?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Ananga ya sangoro, “Kaisar”.</para>
  <para style="p" vid="MAT 22:21">Ḏua Yesus 'o kanau ra ananga, “Na'o so'o gena-ge, ta Kaisar pula'a di'a Kaisar, re ta Ma Jou'ongu Madutu, pula'a di'a Ma Jou'ongu Madutu.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ananga gena-ge 'aḏi dadi heranga wakutu 'aḏi 'isene Yesus 'o kanau so'o gena. Dadi ananga 'aḏi tagi sisoi'i tala Yesus.<verse eid="MAT 22:22" /></para>
  <para style="s">So-sano mangale ngowa'a dadunu 'aḏi 'ahu moju toma <optbreak /> ngowa'a senge-sengene manga sigolona</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mrk. 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Toma wangere gena-ge ḏi'i, ngowa'a Saduki nga muḏuo i'a 'aḏi sapolo ra Yesus. (Ananga gena-ge 'aḏi ngaku ua ngowa'a dadunu 'aḏi 'ahu moju toma ngowa'a senge-sengene manga sigolona.)<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Som. 23:8</ref></char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Ananga 'aḏi sano ra Unanga, “Guru, 'a Musa 'o doto'o so'o ne: Na'o nau'u matengo 'o sengene kai ngowa'a ua, 'ai ioro bolo 'ai nongoḏu balasu 'a molo'ara 'ai balo gena-ge, la ngowa'a sengene nange-ge 'ai ju'uda 'i iranga awa.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Dad. 25:5</ref></char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />'I dadi ḏua, toma ngowa'a nau'u gia nongoḏu nga tumudingi ga'a tegoro 'ane. Ma ioro ro molo'ara re 'o sengene, kai ngowa'a ua. Dadi ma nongoḏu 'a molo'ara ma ioro 'ai balo. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Mada'a 'ai nongoḏu gena-ge 'o sengene kai ngowa'a ua ḏi'i. Gena-ge 'i dadi ḏi'i tai nongoḏu nga ḏu'ange, singadolo nga tumudingi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ma ḏo-ḏogumu tala, were'a gena-ge mo sengene ḏi'i. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Sababu gena-ge toma 'orasa ngowa'a senge-sengene dadunu 'aḏi 'ahu moju, we-were'a gena-ge 'a guna 'ai were'a? Sababu munanga ma'u molo'ara mo-moini ananga nga tumudingi!”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesus 'a sangoro, “Ngini ni rapu masala, sababu ni sahe ua do-doto'o toma Boku 'Ofi-'Ofi ma dara. Re so'o gena-ge ḏi'i, ni sahe ua Ma Jou'ongu Madutu 'ai kuasa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Sababu wakutu ngowa'a senge-sengene dadunu 'aḏi 'ahu moju, ananga manga 'ahu ma tero sa'olo mala'ekata toma soroga: bae na-nau'u bolo we-were'a, ananga 'aḏi molo'ara riwara. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Tantu ḏua, ngini reni baca 'oru ga'a Ma Jou'ongu Madutu 'o kanau ra ngini mangale ngowa'a senge-sengene dadunu 'aḏi 'ahu moju! Ma Jou'ongu Madutu 'o kanau so'o ne: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ngoi nena-ne Ma Jou'ongu Madutu ga'a Abraham, Ishak re Yakub 'aḏi silamo'o re siḏubuso.’ Ngowa'a sengene 'aḏi silamo'o re siḏubuso yoḏu'u Ma Jou'ongu Madutu, pa'i ngowa'a 'ahu-'ahu ḇato nyengara 'aḏi silamo'o re siḏubuso Unanga!”<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Gena-ge ma ngale: Kalaha 'a Abraham, 'a Isak, 'a Yakub, ananga mo-moini raḏi sengene, ananga gena-ge 'aḏi 'ahu-'ahu moju ra Ma Jou'ongu Madutu 'ai biono!</char></note><note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Sup. 3:6</ref></char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Wakutu ngowa'a kawasa ya 'isene Yesus 'o kanau so'o gena, ananga 'aḏi dadi heranga madutu sababu Unanga 'ai do-doto'o.<verse eid="MAT 22:33" /></para>
  <para style="s">Parenta lebe la-lamo'o ma re'u i'a</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mrk. 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ngowa'a Farisi dadunu 'aḏi malomu sababu 'aḏi 'isene mangale Yesus 'o 'a'a ngowa-ngowa'a Saduki 'aḏi kanau bale moi i'a mai yoḏu'u. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Guru 'agama matengo tamanga sigolona, 'U tai'i mau sisala 'a Yesus, unanga 'U sano: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Guru, parenta le'a lebe la-lamo'o ma re'u i'a reo parenta mo-moini ra Musa 'ai hukumu?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesus 'o sangoro, “ ‘Dadalara Ma Jou'ongu Madutu, ninga Jou, reninga 'akala re sinyingara mo-moini, reninga nyawa mo-moini, reninga fikirana mo-moini.’<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Dad. 6:5</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Parenta gena-ge ma mulaingi re lebe la-lamo'o ma re'u i'a. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Parenta ma soi ḏiḏi ma tero sa'olo parenta ma mulaingi: Balasu ni dadalara ngowa'a lelegu ma tero sa'olo ni dadalara ninga diri masiretene.<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">'Im. 19:18</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Musa 'ai hukumu re nabi-nabi manga do-doto'o, gena-ge mo-moini 'i mete'e parenta romoḏiḏi nena-ne.”<note caller="-" style="x"><char style="xo" closed="false">22:35-40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luk. 10:25-28</ref></char></note><verse eid="MAT 22:40" /></para>
  <para style="s">So-sano mangale 'O Kristus</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mrk. 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Wakutu ngowa'a Farisi 'aḏi lomu-lomu moju toma ngi'i gena-ge, Yesus 'o sano ra ananga, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Mete'e ngini ninga wo-waro mangale 'O Kristus, 'a guna Unanga 'ai ete re dotumu?”</para>
  <para style="p" vid="MAT 22:42">Ananga 'aḏi sangoro, “ 'Olana Daud 'ai ju'uda.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesus 'o sano, “Na'o so'o gena, i'a sa'olo Ma Ngagara 'Ofi-'Ofi 'i sigaraki 'Olana Daud singadolo unanga 'o si'aro'o 'O Kristus, ‘ 'Ari Jou’? Sababu 'Olana Daud 'o kanau so'o nena-ne:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Ma Jou'ongu Madutu 'o kanau Tari Jou,</para>
  <para style="q2" vid="MAT 22:44">No tegoro Tari giama ma kuwiḏa i'a,</para>
  <para style="q1" vid="MAT 22:44">singadolo Ngoi ta 'a'a 'Ani lawa-lawana 'aḏi ta'aloko ra Jou.’<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Nya. 110:1</ref></char></note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Dadi na'o 'O Kristus gena-ge 'Olana Daud 'ai ju'uda, i'a sa'olo 'Olana Daud 'o si'aro'o Unanga, ‘ 'Ari Jou’?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Matengo i'a mai ua nga'unu 'U sangoro 'a Yesus. Mulaingi wangere gena-ge, matengo i'a mai ua 'o nau'u di'a sano 'oru ḇato ra Unanga, la sisala Unanga.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Ma'istiari ino toma guru-guru 'agama re <optbreak /> ngowa-ngowa'a Farisi</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mrk. 12:38-39</ref>; <ref loc="LUK 11:37-54">Luk. 11:37-54</ref>, <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Gena ḏua, Yesus 'o kanau toma ngowa'a kawasa re Tai me-mete'e. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Guru-guru 'agama re ngowa-ngowa'a Farisi 'aḏi sanga kuasa di'a doto'o 'a Musa 'ai hukumu. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Dadi ngini balasu na mete'e ti-tiai 'oru ga'a ananga 'aḏi doto'o mangale Musa 'ai hukumu. Mada'a awa na si'a'a mete'e ananga manga de'oso re ḏegoro, sababu ananga ya mete'e ua manga do-doto'o masiretene. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Ananga 'aḏi simau-mau ngowa'a 'aḏi mete'e 'atoranga ma ḏu-ḏubuso ma tero sa'olo 'aḏi piri'u gina-gina ma ḏu-ḏubuso, kara siteru toma ngowa-ngowa'a manga bele'asa. Mada'a ananga masiretene ceka'a i'a mai ua 'aḏi riono ngowa'a ya siḏagi 'atoranga gena-ge.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />'Oru ḇato ga'a ananga ya si'a'a, enanga gena-ge di'a pa'i ngowa'a ya oḏi'i ḇato: Ananga 'aḏi mapake gumi ma nyiata ma ro-roata tamanga sae'e re giama re 'aḏi mapake juba ma renge-renge lai ki-kiḏanga.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">Mat. 6:1</ref>; <ref loc="DEU 6:8">Dad. 6:8</ref>; <ref loc="NUM 15:38">Nyo. 15:38</ref></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Ananga nyanyaḏi tegoro toma ngi'i ga'a ngowa'a ya'u silamo'o toma laya-laya, re toma wala puji 'aḏi nyanyaḏi tegoro toma kursi ga'a di'a ngowa'a la-lamo'o. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Re ananga gena-ge 'aḏi nyanyaḏi ngowa'a ya'u silamo'o toma pasara-pasara, re ngowa'a ya'u si'aro'o ananga, ‘Rabi’.<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="fk" closed="false">Rabi </char><char style="ft" closed="false">toma demo Yunani &lt;&lt;Guru&gt;&gt; di'a ngowa'a ga'a 'o sayanga ma jingi'i.</char></note><verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Mada'a ngini awa simaha ngowa'a nu'u si'aro'o ngini re nu'u 'aro'o ngini ‘Guru’. Sababu ninga Guru pa'i matengo ḇato, re ngini mo-moini ni ioronongoḏu ngo-ngaku rimoi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Re awa ni silamo'o re ni 'aro'o matengo i'a toma dungia nena-ne ‘Baba’. Sababu ninga Ḇaḇa pa'i matengo ḇato re Unanga gena-ge tegoro toma soroga. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Re ngini awa simaha ngowa'a nu'u si'aro'o ngini re nu'u si'aro'o ngini ‘Ngowa'a Bi-biri'i’. Sababu ninga bi-biri'i pa'i matengo ḇato re Unanga gena-ge 'O Kristus. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />'A guna ga'a mau dadi ngowa'a lebe la-lamo'o i'a taninga sigolona, unanga balasu siḏa-siḏa 'o dadi ninga falalomu.<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat. 20:26-27</ref>; <ref loc="MRK 9:35">Mrk. 9:35</ref>, <ref loc="MRK 10:43-44">10:43-44</ref>; <ref loc="LUK 22:26">Luk. 22:26</ref></char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />'A guna ḇato 'o sihie 'ai diri, unanga gena-ge ḏuanga i'a Ma Jou'ongu Madutu 'u siholo. Mada'a 'a guna ḇato 'o maholo 'ai diri, unanga gena-ge Ma Jou'ongu Madutu ḏuanga i'a 'u sihie.” <note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luk. 14:11</ref>, <ref loc="LUK 18:14">18:14</ref></char></note><verse eid="MAT 23:12" /></para>
  <para style="s">Yesus 'o emono ngowa'a munafiki</para>
  <para style="r">(<ref loc="MRK 12:40">Mrk. 12:40</ref>; <ref loc="LUK 11:39-42">Luk. 11:39-42</ref>, <ref loc="LUK 11:44">44</ref>, <ref loc="LUK 11:52">52</ref>, <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi! Ngini, ngowa'a munafiki! Ngini ni simaha ua ngowa'a 'aḏi osama nyo-nyoimi toma Soroga ma Pareta.<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta.</char></note> Ngini masiretene ni oḏu'u osama nyo-nyoimi toma Soroga ma Pareta, re ni dola'aku ngowa'a lelegu ga'a mau osama nyo-nyoimi toma Soroga ma Pareta.</para>
  <para style="p" vid="MAT 23:13">[ <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi. Ngini ngowa'a munafiki! Ngini ni sihaga balo-balo, re ni ra-rabasa ananga manga 'ori i'a rana tamanga wala ma dara. Re ngini ni manyiata lai kiḏa-kiḏanga di'a na damunu ninga kajahatana. Sababu gena-ge, Ma Jou'ongu Madutu ḏuanga i'a 'o sihukumu lai tubuso madutu ra ngini!]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Toma kartasi lo-lolo lelegu, bu-bula'a gena-ge 'i cua</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi. Ngini ngowa'a munafiki! Ni tagi na sikiḏanga palene ngoloto re tana'a, pa'i ni disa ngowa'a matengo ḇato di'a 'o dadi ninga me-mete'e. Re na'o ngowa'a gena-ge ro dadi ninga me-mete'e, ngini nu'u doto'o di'a mete'e ninga de'oso re ḏegoro singadolo ma ḏo-ḏogumu unanga gena-ge lebe cira i'a reo ngini di'a osama naraka!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Bahala ra ngini, ngowa'a hafu ga'a sigasa ngowa'a ma lelegu 'aḏi iranga ngo'omo! Ngini ni doto'o nena-ne: ‘Na'o ngowa'a 'aḏi masisasi terongo Ma Jou'ongu Madutu 'ai Wala, ngowa'a gena-ge manga sasi 'i tike ananga ua. Mada'a na'o ananga 'aḏi masisasi terongo guraci ra Ma Jou'ongu Madutu 'ai Wala, manga sasi gena-ge 'i tike ananga!’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ngini ngowa'a ma haga ga'a hafu! Le'a lebe la-lamo'o i'a: Guraci ra Ma Jou'ongu Madutu 'ai Wala, bolo Ma Jou'ongu Madutu 'ai Wala ga'a 'i si'a'a guraci gena-ge 'i dadi 'ofi-'ofi?! <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ngini ni doto'o ḏi'i ne: ‘Na'o ngowa'a 'aḏi masisasi terongo jou-jou ma ngi'i, manga sasi gena-ge 'i tike ananga ua. Mada'a na'o ananga 'aḏi masisasi terongo jou-jou toma jou-jou ma ngi'i, manga sasi gena-ge 'i tike ananga!’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ngini ni masihafu lai siḏi! Le'a lebe la-lamo'o i'a: Jou-jou bolo jou-jou ma ngi'i ga'a si'a'a jou-jou gena-ge 'i dadi 'ofi-'ofi? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Sababu gena-ge, na'o matengo i'a 'o masisasi terongo jou-jou ma ngi'i, sasi gena-ge ma ngale jou-jou re jou-jou ma ngi'i ḏi'i. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Re na'o matengo i'a 'o masisasi terongo Ma Jou'ongu Madutu 'ai Wala, sasi gena-ge ma ngale Ma Jou'ongu Madutu 'ai Wala re Ma Jou'ongu Madutu ga'a 'a tegoro toma wala gena-ge ḏi'i. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Re na'o matengo 'o masisasi terongo soroga, gena-ge mangale unanga 'o masisasi Ma Jou'ongu Madutu 'ai ḏe-ḏegoro re Ma Jou'ongu Madutu ga'a 'o tegoro toma ḏe-ḏegoro gena-ge ḏi'i.<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Yes. 66:1</ref>; <ref loc="MAT 5:34">Mat. 5:34</ref></char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Bahala ra ngini guru-guru 'agama re ngowa'a Farisi! Ngini ngowa'a munafiki! Rampa-rampa sa'olo: selasi, adas mami, re 'o jintan, gena-ge ngini na pula'a jou-jou ga'a ma balangu moi toma balangu nyagi moi ino di'a Ma Jou'ongu Madutu. Momongolo ua, parenta ma re'u i'a ra Musa 'ai hukumu sa'olo: Ngini balasu ni 'adili toma ngowa'a lelegu, balasu ni sijumu ninga 'akala re sinyingara ma la-la, re balasu ni cufala mete'e Ma Jou'ongu Madutu 'ai parenta, gena-ge ngini na siwaro i'a ua! Mada'a ngini balasu na si'a'a, re ma lelegu ḏi'i mai na sidaioranga awa.<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">'Im. 27:30</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ngini mo-moini ni dadi sae'e, mada'a ngini ma tero sa'olo ngowa'a hafu! Botou'u taninga ngo-ngo'e na tafi, mada'a onta na nyamolo!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi. Ngini ngowa'a munafiki! Ninga moku-moku re ninga suḏe-suḏe ma ḏuḏunu na soso'o nya-nyangele. Momongolo ua, enanga ma dara faja madutu moju ma tero sa'olo ninga 'akala re sinyingara 'i romanga reo danata re nyafusu ngowa'a manga 'ori i'a rana. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ngowa'a Farisi ngini sa'olo ngowa'a hafu! Soso'o nya-nyangele ninga moku-moku re suḏe-suḏe ma dara, la ma ḏuḏunu 'i dadi nyangele ḏi'i.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi! Ngini ngowa'a munafiki! Ngini ma tero sa'olo kubu-kubu maceti bu-buḏo. Toma ḏuḏunu oḏi'i lai rousu, mada'a toma dara 'i romanga reo obongo re 'ori i'a fara muḏuo i'a ga'a 'i po-pokuru.<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">Som. 23:3</ref></char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />So'o gena ḏi'i, ngowa'a 'aḏi oḏi'i ninga ga'a re 'aḏi ta'ajiri ngini ngowa'a loasa re banari. Mada'a ngini mode-mode'e ngowa'a munafiki, re ninga 'akala re sinyingara ma dara 'i romanga reo kajahatana.”<verse eid="MAT 23:28" /></para>
  <para style="s">Yesus 'o nubuata mangale hukumu toma <optbreak /> ngowa-ngowa'a Farisi re guru-guru 'agama</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luk. 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Yesus dadunu 'o kanau moju, “Bahala ra ngini guru-guru 'agama re ngowa-ngowa'a Farisi! Ngini ngowa'a munafiki! Ngini ni 'a'a nabi-nabi manga kubu sirousu re ni sidiai ma ngasu-ngasu'u di'a si'elingi ngowa-ngowa'a loasa re banari. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Re ni kanau, ‘Na'o si'ade-'ade i'a ngomi mi 'ahu-'ahu toma 'orasa ete re dotumu ma siḏa, tantu ḏua ngomi mi mete'e ananga ua di'a sisengene nabi-nabi!’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Dadi ngini ni mangaku masiretene mangale ngini nena-ne 'o ju'uda ngowa-ngowa'a ga'a sisengene nabi-nabi! <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Na'o so'o gena-ge, na dowanga re na siḏuanga ḏosa-ḏosa ga'a ninga ete re dotumu reya si'a'a mulaingi i'a!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Ngini ngowa'a ma jira ma tero sa'olo cuku'u! Ngini ngowa'a ma jira ma ju'uda ma tero sa'olo cuku'u rema bisa ma ngowa!<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mat. 3:7</ref>, <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luk. 3:7</ref></char></note> Sanga ua, ngini nyengara sisalamata ninga diri toma hukumu naraka! <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ni 'isene la-la ino: Ma sababu gena-ge, Ngoi nena-ne ḏuanga i'a to 'utusu ra ngini nabi-nabi, ngowa-ngowa'a 'akala soro'unu re guru-guru 'agama. Mamuni'a ngini na'u sisengene re mamuni'a ngini na'u sisalib. 'Age ḏi'i mamuni'a ngini na'u sipo toma wala-wala puji, re na'u dedele ananga toma limau rimoi sigasa limau ma lelegu. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Dadi ngini ḏuanga i'a ni sanga hukumu di'a ngowa'a kamanga sala ua mo-moini ninga ete re dotumu ya'u sisengene. Mulaingi ra Habel, ngowa'a ga'a kai sala ua, singadolo ngini ni sisengene 'a Zakharia 'a Berekhya 'ai ngowa'a nau'u, ga'a nu sisengene wakutu unanga toma jou-jou ma ngi'i ra Ma Jou'ongu Madutu 'ai Wala ma sigolona. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ni ngaku mode-mode'e Ngoi 'Ari demo-demo nena-ne: Ma Jou'ongu Madutu ḏuanga i'a 'o sihukumu ngini ga'a 'ahu-'ahu toma 'orasa nena-ne, sababu ngini re ninga ete re dotumu ananga 'aḏi sisengene 'Ari ngowa-ngowa'a kamanga sala ua.”<verse eid="MAT 23:36" /></para>
  <para style="s">Yesus 'ai dadalara 'i baolo toma ngowa-ngowa'a Yerusalem</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Yerusalem, Yerusalem! Ngini, ngowa'a Yerusalem ga'a 'aḏi sisengene nabi-nabi re ni poini reo maḏi Ma Jou'ongu Madutu 'ai 'utusana singadolo 'aḏi sengene! Soi muḏuo i'a ḏua, Ngoi mau tini saolo ngini ma tero sa'olo namo ma ngina ya worongo ma ngowa-ngowa toma kalatu'u ma 'aḏu, mada'a ngini ni oḏu'u! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ni 'isene la-la ino: Ma Jou'ongu Madutu ḏuanga i'a 'O sisoi'i tala Unanga 'ai Wala nena-ne! <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Re Ngoi to siajele ra ngini nena-ne: Mulaingi nange-ne re si'a ngini ḏuanga i'a ni oḏi'i Ngoi riwara singadolo ngini ni kanau, ‘Sibarakati Unanga ga'a 'o sapolo rea Ma Jou'ongu Madutu 'ai lomanga!’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesus 'o siajele mangale Ma Jou'ongu Madutu 'ai Wala ya ruba</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mrk. 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Wakutu Yesus 'o sisoi'i tala Ma Jou'ongu Madutu 'ai Wala, 'Ai me-mete'e 'aḏi sapolo ra Unanga 'aḏi sijumu Ma Jou'ongu Madutu 'ai Wala re ma wala-wala mo-moini ga'a ma'u co-cori. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yesus 'o kanau ra ananga, “Ngini ni oḏi'i wala nena-ne mo-moini 'oru? Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Ḏuanga i'a maḏi rimoi i'a mai ua, 'age 'i ma'u fato re maḏi ma lelegu; mo-moini 'i perego.”<verse eid="MAT 24:2" /></para>
  <para style="s">Susa re sangisara</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mrk. 13:3-13</ref>; <ref loc="LUK 21:7-19">Luk. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Gena ḏua, Yesus 'o tagi toma Polono Zaitun, re 'O madi-dirini toma ngi'i gena-ge. 'Ai me-mete'e 'aḏi masebanga i'a ra Unanga re wakutu pa'i ananga ḇato ananga 'aḏi sano, “Siajele ra ngomi, ngau enanga mo-moini gena-ge 'i dadi. Rema didina'o 'oru Jou ḏuanga i'a no sapolo sa'olo 'olana re 'orasa ma ḏo-ḏogumu 'i ngadolo?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesus 'o sangoro, “Ma'istiari ino awa-awa ngowa'a 'aḏi sihaga ngini. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Sababu ngowa'a manga repe ḏuanga i'a 'aḏi sapolo, 'aḏi pake Ngoi 'ari lomanga, 'aḏi kanau, ‘Ngoi nena-ne 'O Kristus,’ singadolo 'aḏi sihaga ngowa'a repe. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ngini ḏuanga i'a ngini ni 'isene sanapanga ma iḏingi re ni 'isene habari-habari parangi, mada'a mojongo awa. Sababu mo-moini gena-ge balasu 'i dadi, mada'a kiamata ma 'orasa 'i ngadolo nyangu. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Bangsa rimoi ma'u parangi bangsa lelegu, re nagara rimoi ma'u parangi nagara lelegu. Toma ngi'i le'a ḇato 'i dadi ngowa'a repe 'aḏi matai sawini re 'i dadi wusu. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Mo-moini gena-ge aro ma mulaingi ma tero sa'olo were'a mi 'orasa ma ḏe-ḏegoro i'a sa'i ri ngadolo, dadi mo mabasono go-goḏi.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Toma 'orasa gena-ge, ngini sanga cako'o re sipula'a toma ngowa'a ma jira di'a sisikisa ngini re nu'u sisengene. Ngowa'a mo-moini toma dungia sitabi donga, ananga 'aḏi emono ngini sababu Ngoi 'ari me-mete'e.<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10:22</ref></char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Dadi ngowa'a manga repe 'aḏi masoloto re 'aḏi ma'u sipula'a matengo re matengo tamanga lawana re 'aḏi ma'u emono matengo re matengo. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Re ḏi'i 'age 'i baolo nabi sa-sakala manga repe di'a 'aḏi sihaga ngowa'a repe. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Toma 'orasa gena-ge, sababu kajahatana enanga 'i rera re walata ngowa'a repe 'aḏi ma'u dadalara riwara. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Mada'a ngowa'a ga'a 'aḏi ngaku Ngoi tau-taunu singadolo ma ḏo-ḏogumu, ananga gena-ge 'aḏi sanga salamata.<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10:22</ref></char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Re Habari Roanga mangale Soroga ma Pareta, enanga ḏuanga i'a 'i rera re walata toma dungia sitabi donga, la ngowa'a mo-moini ya 'isene, kara Kiamata ma Wangere 'i sapolo.”<verse eid="MAT 24:14" /></para>
  <para style="s">Susa re sangisara ḏuanga i'a 'i ngadolo</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mrk. 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Yesus dadunu 'o kanau moju, “Dadi wakutu ngini ni oḏi'i ‘Ngowa'a ma Jira ga'a Ma Jou'ongu Madutu 'u emono’ unanga gena-ge 'o made-de'oso toma ngi'i 'ofi-'ofi ga'a Nabi Daniel 'u sinubuata pasala ḏua ('a guna ḇato 'o baca nubuata gena-ge, 'a tailako la-la!),<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan. 9:27</ref>, <ref loc="DAN 11:31">11:31</ref>, <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ananga ga'a 'aḏi tegoro toma daeraha Yudea balasu 'aḏi wiḏi toma kie. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Ngowa'a ga'a toma wala ma wanata, 'uci awa di'a 'o 'oro 'oru ḇato tai wala ma dara. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ngowa'a ga'a tai guḏa, maḏibo awa di'a 'o 'oro 'ai juba.<note caller="-" style="x"><char style="xo" closed="false">24:17-18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk. 17:31</ref></char></note> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Toma 'orasa gena-ge, we-were'a--we-were'a remanga lese re ngina-ngina ga'a 'aḏi sisusu moju manga ngowa kiau, ananga gena-ge manga 'ahu kangela masala! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Manyiata ra Ma Jou'ongu Madutu, la awa-awa ngini balasu ni wiḏi na'o besa'a ma 'orasa, bolo Sabata ma wangere. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Toma 'orasa gena-ge, 'i dadi susa re sangisara lamo'o masala ga'a soi moi i'a mai ua 'i dadi nyangu, wakutu ma mulaingi dungia enanga 'i dadi, singadolo toma 'orasa nange-ne, re 'i dadunu riwara.<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan. 12:1</ref>; <ref loc="REV 7:14">Ting. 7:14</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Na'o Ma Jou'ongu Madutu 'a siḇoko'o ua ma 'orasa gena-ge, marai matengo i'a mai ua nga'unu wo 'ahu moju. Mada'a Unanga 'a siḇoko'o ma 'orasa gena-ge sababu Unanga 'o dadalara 'ai ngowa-ngowa'a ga'a Unanga ro cumutu.”<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Toma 'orasa gena-ge, na'o 'age rema ngowa'a matengo 'o kanau ra ngini, ‘Oḏi'i 'O Kristus unanga 'ane!’ bolo, 'age rema ngowa'a matengo ḏi'i 'o kanau ra ngini ‘Oḏi'i Unanga da'a!’ awa ni ngaku ngowa'a gena-ge. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Sababu kristus-kristus sa-sakala re nabi-nabi sa-sakala ḏuanga i'a 'aḏi sapolo. Ananga gena-ge 'aḏi 'a'a 'ori i'a hera-heranga re didina'o-didina'o heranga di'a sihaga ngowa'a repe re na'o nyengara ananga 'aḏi sihaga Ma Jou'ongu Madutu 'ai 'umata, mada'a gena-ge 'i yoḏu'u! <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />'Eli-'elingi! 'Ori i'a gena-ge 'i dadi nyangu, mada'a Ngoi ta siajele siḏa ḏua ra ngini.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Dadi na'o ngowa'a 'aḏi kanau ra ngini, ‘Oḏi'i 'O Kristus, Unanga da'a toma ngi'i baulaco,’ awa ngini si'a. Bolo na'o ananga 'aḏi kanau, ‘Oḏi'i Unanga 'o magogono 'ane toma kamara,’ awa ngini na'u ngaku. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Sababu Ngoi, Manusia ma Ngowa'a Nau'u, dadunu To sapolo moju ma tero sa'olo ḇeḇelanga pelete'e toma wangere ma la'o, mada'a enanga ma lalaki 'i lapasa ngadolo toma wangere ma soḏu.<note caller="-" style="x"><char style="xo" closed="false">24:26-27 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">Luk. 17:23-24</ref></char></note> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ngowa'a mo-moini 'aḏi waro na'o Ngoi dadunu to sapolo moju. Gena-ge ma tero sa'olo ngowa'a 'aḏi waro ngi'i le'a ḇato rema mayeti, sababu 'aḏi oḏi'i 'age rema namo-namo ga'a 'i 'omo-'omo mayeti.”<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">Luk. 17:37</ref></char></note><figure style="fig" alt="vultures eating carrion" file="LB00075B.TIF" size="span" ref="24:28">Namo-namo ga'a 'i 'omo-'omo mayeti</figure><verse eid="MAT 24:28" /></para>
  <para style="s">Manusia ma Ngowa'a Nau'u dadunu 'o sapolo moju</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mrk. 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Yesus 'o kanau moju, “Ti'ara ua susa re sangisara toma 'orasa gena-ge togumu i'a, wangere ma la'o 'i dadi hafu-hafu re ngara 'i taḏusu. Re mumuḏungu toma diwanga ḏuanga i'a 'i matai turono, re kuasa-kuasa toma ngawa-ngawa ḏuanga i'a 'i matai kaco.<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Yes. 13:10</ref>, <ref loc="ISA 34:4">34:4</ref>; <ref loc="EZK 32:7">Yeh. 32:7</ref>; <ref loc="JOL 2:10">Yl. 2:10</ref>, <ref loc="JOL 2:31">31</ref>, <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12-13">Ting. 6:12-13</ref></char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Gena ḏua, didina'o rimoi 'i waiti toma diwanga ga'a ma ngale: Ngoi, Manusia ma Ngowa'a Nau'u, dadunu to sapolo moju da'u diwanga tala. Toma 'orasa gena-ge bangsa-bangsa toma dungia sitabi donga, ananga 'aḏi rerese ma gaḏi, sababu ngowa'a mo-moini gena-ge 'aḏi oḏi'i Ngoi, Manusia ma Ngowa'a Nau'u, To sapolo da'u diwanga tala toma kakamo Rari kuasa lamo'o re Rari mulia lamo'o.<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan. 7:13</ref>; <ref loc="ZEC 12:10-14">Za. 12:10-14</ref>; <ref loc="REV 1:7">Ting. 1:7</ref></char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Gena ḏua, ngowa-ngowa'a 'aḏi 'isene torompet ma iḏingi lai siḏi. Ḏua Ngoi, Manusia ma Ngowa'a Nau'u, To soma'a 'Ari mala'ekata-mala'ekata 'aḏi lomu 'Ari 'umata ga'a Ma Jou'ongu Madutu ya'u cumutu ḏua toma dungia ḇuḇuku rata, toma diwanga ma didiki singadolo toma diwanga ma didiki.”<verse eid="MAT 24:31" /></para>
  <para style="s">Do-doto'o toma ate 'ara</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mrk. 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Totoho la-la do-doto'o mangale ate 'ara: Na'o ma umanga ma 'alusu 'i 'ijo 'i supu ju'uda, ngini ni waro gena-ge 'i dadi nana'o 'orasa ngogoro ri co-cori. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />So'o gena ḏi'i na'o ngini ni oḏi'i mo-moini ga'a Ngoi ta siajele ḏua enanga 'i dadi, ngini na waro Ngoi 'ari ta-sapolo ma 'orasa ri co-cori madutu. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Wakutu enanga gena-ge 'i dadi, ngowa'a ga'a 'aḏi 'ahu toma 'orasa nena-ne, 'aḏi sengene mo-moini nyangu. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Diwanga re dungia ḏuanga i'a 'i iranga, mada'a Ngoi 'ari demo-demo 'i iranga ua kasingado-ngadolo i'a.”<verse eid="MAT 24:35" /></para>
  <para style="s">Matengo i'a mai ua waro ma 'orasa wakutu <optbreak /> Yesus dadunu 'o sapolo moju</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mrk. 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk. 17:26-30</ref>, <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Mada'a matengo i'a mai ua 'o waro ma wangere ngau, bolo ca'olo muḏuo: Mala'ekata-mala'ekata toma soroga mai ya waro ua, re Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u masiretene mai 'A waro ua; pa'i 'Ari Ḇaḇa masiretene ḇato 'A waro. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Wakutu Ngoi, Manusia ma Ngowa'a Nau'u dadunu To sapolo moju, gena-ge ma tero sa'olo 'oru 'i dadi toma 'orasa nabi Nuh 'ua re 'au wali.<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Do. 6:5-8</ref></char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Wakutu ngu'uisi 'i sapolo nyangu, wangere re lobi'i ngowa-ngowa'a 'aḏi oromo re ka'e re 'aḏi ma'u molo'ara sa'olo biasa singadolo Nuh 'o osama toma kapala ma dara. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Pa'i wakutu ananga mo-moini ya basono ḇanyo ri romanga, ananga gena-ge aro sahe 'oru ga'a 'i dadi. So'o gena ḏi'i ḏuanga i'a 'i dadi na'o Ngoi, Manusia ma Ngowa'a Nau'u dadunu to sapolo moju.<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Do. 7:6-24</ref></char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Toma 'orasa gena-ge, na-nau'u nga muḏiḏi 'aḏi munara toma guḏa: Matengo ga'a 'o mete'e Ngoi 'o sanga salamata mada'a matengo ḏi'i 'o mete'e Ngoi ua 'o sanga salamata ua. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />We-were'a nga muḏiḏi 'aḏi mamete'e gulinga gandum: Matengo ga'a mo mete'e Ngoi mo sanga salamata mada'a matengo ḏi'i mo mete'e Ngoi ua mo sanga salamata ua.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Sababu gena-ge, ma'istiari sababu ngini ni waro ua ngau Ma Jou ḏuanga i'a dadunu 'o sapolo moju. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />'Eli-'elingi nena-ne: Na'o wala ma dutu 'o waro ca'olo muḏuo, lobi'i gena-ge ngowa'a to-tori'i 'o sapolo, wala ma dutu 'o otu ua, la ngowa'a to-tori'i osama yoḏu'u tai wala. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Sababu gena-ge, ngini nena-ne ḏi'i balasu ni maḏu-ḏuanga ḏua sababu Ngoi, Manusia ma Ngowa'a Nau'u, 'Ari ta-sapolo moju ma 'orasa ni masiwaro ua.”<note caller="-" style="x"><char style="xo" closed="false">24:43-44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">Luk. 12:39-40</ref></char></note><verse eid="MAT 24:44" /></para>
  <para style="s">Budaka fara ḏiḏi: matengo 'o cufala re matengo 'o cufala ua</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Yesus dadunu 'o kanau, “ 'Age rema budaka matengo i'a ga'a 'o pahe re lao cufala siḏagi 'ai munara singadolo ma tuanga 'o sitede 'u dadi sae'e tai falalomu sigolona di'a 'o pula'a ngo-ngoromo toma falalomu mo-moini wange moi-wange moi. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Bara'utungu masala budaka gena-ge na'o ma tuanga 'o maḏibo 'o sanga i'a unanga 'a siḏagi 'ai munara. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ni ngaku mode-mode'e 'Ari demo-demo nena-ne: Tuanga gena-ge ḏuanga i'a 'o siparatada 'ai 'ori i'a rana mo-moini tai budaka gena-ge. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Mada'a na'o budaka gena-ge 'ai 'akala re sinyingara 'i cira re unanga 'o kanau tai 'akala re sinyingara ma dara, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />‘ 'Ari tuanga ma di'ara moju kara unanga 'o maḏibo.’ Ḏua unanga mulaingi ca'olo 'ai ḏagilomu budaka-budaka re unanga 'o oromo re 'o ka'e marimoi reo ngowa-ngowa'a 'etolo. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Ḏua 'ai tuanga gena-ge 'o maḏibo toma 'orasa ca'olo muḏuo re wangere 'oru, ga'a budaka masiwaro ua. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Re budaka gena-ge sanga ca'olo singadolo dadi cira tai tuanga re 'o sanga upa'a toma ngi'i di'a ngowa'a munafiki. Toma ngi'i gena-ge, ananga ḏuanga i'a ya rerese ma gaḏi, re ya doiti ma sangisara.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">'Ade-'ade mangale mosolese nga nyagi moi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Toma 'orasa gena-ge wakutu Ngoi, Manusia ma Ngowa'a Nau'u, dadunu To sapolo moju, Soroga ma Pareta<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="fk" closed="false">Soroga ma Pareta </char><char style="ft" closed="false">ma tero Ma Jou'ongu Madutu 'ai Pareta. Gena-ge ma tero toma bu-bula'a 14, 34.</char></note> ma tero sa'olo 'ade-'ade nena-ne: Geri molo'ara were'a 'ami me-mete'e 'o mosolese nga nyagi moi, matengo re matengo remanga 'oboro, 'aḏi tagi totoma geri molo'ara na-nau'u.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luk. 12:35</ref></char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ananga nga mutoara ga'a ngowa'a haga re ananga nga mutoara ḏi'i ga'a ngowa'a pahe. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Mosolese ma haga nga mutoara, 'aḏi gasa 'oboro, mada'a ma goroho 'i pai'i ua. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Mosolese ma pahe nga mutoara, 'aḏi gasa 'oboro rema ma goroho pai-pai'i. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Geri molo'ara na-nau'u 'o sapolo lati, dadi mosolese mo-moini gena-ge 'aḏi kakadungu, kara 'aḏi otu.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />'Utu golona i'a, ananga gena-ge 'aḏi 'isene ngowa'a 'aḏi poa'a, ‘Geri molo'ara na-nau'u 'o sapolo. Ino ngene ma'u sanga unanga!’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Ḏua mosolese nga nyagi moi gena-ge 'aḏi momi'i, re ya sidodahe manga 'oboro. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Mosolese-mosolese haga 'aḏi kanau toma mosolese-mosolese pahe, ‘Ninga goroho pula'a ra ngomi ceka'a i'a, sababu minga 'oboro sa'i ri sengene.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Mosolese-mosolese pahe 'aḏi sangoro, ‘Gena-ge 'i yoḏu'u, sababu awa-awa ngene wo masingadolo ua mo-moini. Tagi ni tibo toma toko.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Ḏua mosolese ma haga gena-ge, 'aḏi tagi tibo manga goroho. Mada'a wakutu ananga 'aḏi tagi-tagi, geri molo'ara na-nau'u 'o sapolo. Mosolese-mosolese ga'a 'aḏi pahe, 'aḏi ḏu-ḏuanga ḏua, 'aḏi osama mamete'e reo geri molo'ara na-nau'u toma laya ma ngi'i, re ma ngalana ngowa'a ya kuci!<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Togumu i'a mosolese-mosolese ma haga 'aḏi ngadolo. Ananga 'aḏi kanau, ‘Tuanga, tuanga, na welanga ma ngalana, la ngomi mi osama.’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Mada'a geri molo'ara na-nau'u 'o sangoro, ‘Ni ngaku 'Ari demo nena-ne: Ngoi tunu nana'o ngini ua!’ ”<note caller="-" style="x"><char style="xo" closed="false">25:11-12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">Luk. 13:25</ref></char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Ḏua Yesus 'a siḏo-ḏogumu 'ai 'ade-'ade so'o ne: “Sababu gena-ge ni ma'istiari, sababu ngini ni waro ua ma wangere bolo ma 'orasa, Ngoi to sapolo.”<verse eid="MAT 25:13" /></para>
  <para style="s">'Ade-'ade mangale budaka nga ḏu'ange</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Toma 'orasa gena-ge wakutu Ngoi, Manusia ma Ngowa'a Nau'u, dadunu To sapolo moju, Soroga ma Pareta ma tero sa'olo 'ade-'ade nena-ne: Na-nau'u matengo mau tagi toma giḏanga. Dadi, unanga 'o 'aro'o 'ai budaka-budaka, re 'a siparatada 'ai 'ori i'a rana ra ananga. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Unanga 'o pula'a tai budaka-budaka mete'e ananga manga dinga'unu. Toma ngowa'a matengo unanga 'o pula'a pipisi guraci ma ngai cala romotoa. Ra matengo ḏi'i unanga 'o pula'a pipisi guraci ma ngai cala ḏiḏi. Re matengo moju unanga 'o pula'a pipisi guraci ma ngai cala moi, kara unanga 'o tagi. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Budaka ga'a 'o sanga pipisi guraci ma ngai cala romotoa, jau-jau unanga 'o tagi re 'a sikololo singadolo unanga 'o sanga ma 'utungu pipisi guraci ma ngai cala romotoa ḏi'i. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />So'o gena ḏi'i, budaka ga'a 'o sanga pipisi guraci ma ngai cala ḏiḏi, unanga 'o sanga ma 'utungu pipisi guraci ma ngai cala ḏiḏi ḏi'i. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Mada'a budaka ga'a 'o sanga pipisi guraci ma ngai cala moi, unanga 'o tagi re 'o tuso'o tana'a, 'a gogono tuanga 'ai pipisi.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Togumu i'a ma di'ara ino, tuanga gena-ge 'o ḏibo re ya'u sano mangale pipisi ga'a unanga 'o siparatada ḏua ra ananga. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Budaka ga'a ro dawongo pipisi guraci ma ngai cala romotoa 'o sapolo re 'o pula'a pipisi ma ngai cala nyagi moi tai tuanga. Unanga 'o kanau, ‘Tuanga no siparatada pipisi guraci ma ngai cala romotoa ra ngoi, oḏi'i ngoi ta sikololo re ta sanga ma 'utungu pipisi guraci ma ngai cala romotoa ḏi'i.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />'Ai tuanga 'o kanau, ‘Rousu, ngana budaka ma la-la re no setia! Ngana reno dadi ngowa'a cufala rema 'ori i'a i'a pa'i ceka'a ua. Dadi Ngoi ḏuanga i'a tini siparatada 'ori i'a i'a lebe lamo'o ma repe moju. Ino osama re no tegoro marimoi ra ngoi, re no basono 'ari sa-sanangi!’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Ḏua budaka ga'a ro dawongo pipisi guraci ma ngai cala ḏiḏi 'o sapolo re 'o kanau, ‘Tuanga, no siparatada pipisi guraci ma ngai cala ḏiḏi ra ngoi, oḏi'i ngoi ta sikololo re ta sanga ma 'utungu pipisi guraci ma ngai cala ḏiḏi ḏi'i.’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />'Ai tuanga 'o kanau, ‘Rousu, ngana budaka ma la-la re no setia! Ngana reno dadi ngowa'a cufala rema 'ori i'a i'a pa'i ceka'a ua. Dadi Ngoi ḏuanga i'a tini siparatada 'ori i'a i'a lebe lamo'o ma repe moju. Ino osama re no tegoro marimoi ra ngoi, re no basono 'ari sa-sanangi!’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Ḏua, budaka ga'a ro dawongo pipisi guraci ma ngai cala moi 'o sapolo, re 'o kanau, ‘Tuanga, ngoi to waro 'ani 'akala re sinyingara lai te'e. Ngana ma tero sa'olo ngowa'a 'aḏi maso'ana ua, mada'a no 'oro enanga ma hasili, re no lomu sowo'o toma guḏa ga'a tuanga na siare gisisi ua. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Ngoi to mojongo. Dadi ngoi ta gogono 'ani pipisi toma tana'a ma dara. Ne tuanga 'ani pipisi!’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />'Ai tuanga 'o kanau, ‘Ngana budaka ma jira ga'a no busenge! Na'o ngana rena ta'ajiri mangale ngoi to so'ana ua mada'a to 'oro ma hasili re lomu sowo'o toma guḏa ga'a ta siare gisisi ua! <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Na'o so'o gena, i'a sa'olo ngana na sigare ua ngoi 'ari pipisi toma bank, la wakutu ngoi toma ḏibo, ta sanga 'ari pipisi re enanga ma rete!<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Sababu gena-ge, 'oro 'ari pipisi ra unanga re pula'a toma budaka ga'a rai pipisi guraci ma ngai cala nyagi moi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Sababu 'a guna ḇato ro sanga repe, Ngoi ḏuanga ta sidogo ḏi'i singadolo pai-pai'i. Mada'a 'a guna ḇato 'o sanga ua; 'oru ḇato, kalaha unanga ra sanga pa'i ceka'a ua ḇato, gena-ge ḏi'i mai sanga 'oro!<note caller="+" style="f"><char style="fr" closed="false">25:29 </char><char style="ft" closed="false">Ḏa Yesus 'ai maksudu toma 'ade-'ade gena-ge so'o ne: Budaka ga'a ro sanga ua, 'ai 'ahu 'i iranga ga'a Ma Jou'ongu Madutu ra pula'a.</char></note><note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat. 13:12</ref>; <ref loc="MRK 4:25">Mrk. 4:25</ref>; <ref loc="LUK 8:18">Luk. 8:18</ref></char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Re budaka ga'a ma faeda 'i cua gena-ge, sanga upa'a toma ngi'i hafu-hafu toma ḏuḏunu. I'a da'a, ngowa-ngowa'a ḏuanga i'a 'aḏi rerese ma gaḏi re ya doiti ma sangisara!’ ”<note caller="-" style="x"><char style="xo" closed="false">25:14-30 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">Luk. 19:11-27</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8:12</ref>, <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luk. 13:28</ref></char></note><verse eid="MAT 25:30" /></para>
  <para style="s">Manusia ma Ngowa'a Nau'u 'o dadi Hakimi toma <optbreak /> Kiamata ma Wangere</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Wakutu Ngoi, Manusia ma Ngowa'a Nau'u To sapolo moju sa'olo 'Olana rari kabasarana lamo'o, mala'ekata mo-moini 'aḏi mete'e Ngoi, re Ngoi ḏuanga i'a to tegoro tari ḏe-ḏegoro ga'a 'i mulia.<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mat. 16:27</ref>, <ref loc="MAT 19:28">19:28</ref></char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Bangsa mo-moini toma dungia ma dara 'aḏi malomu ra Ngoi 'ari biono. Ḏua Ngoi ta'u siwo-wola ngowa-ngowa'a gena-ge dadi balangu romoḏiḏi, ma tero sa'olo sowohi siwo-wola doba reo 'abingi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ngowa'a ga'a 'aḏi mete'e Ma Jou'ongu Madutu 'ai 'akala ma mau Ta'u lomu Tari giama ma kuwiḏa, re ngowa'a ga'a mete'e ua Ma Jou'ongu Madutu 'ai 'akala ma mau Ta'u lomu Tari giama ma kuḇali.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />Togumu i'a, Ngoi 'Olana gena-ge, to kanau toma ngowa-ngowa'a Tari giama ma kuwiḏa, ‘Ino, ngini mo-moini ga'a 'Ari Ḇaḇa renu sibarakati. Ni osama toma Soroga ma Pareta ga'a Ngoi ta sidodahe ḏua di'a ngini wakutu dungia 'i dadi nyangu. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Sababu wakutu Ngoi to sawini, ngini rini pula'a 'omo. Ngoi 'ari camala dudungu, ngini pula'a ka'e. Kalaha ngoi ngowa'a tagi-tagi ino, ngini dawongo Ngoi taninga wala. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ngoi 'ari pakeanga 'i cua, ngini rini pula'a pakeanga ra Ngoi. Ngoi to siḏi, ngini rini kadiarata Ngoi. Ngoi toma bui ma dara, ngini rini sapolo tutumu Ngoi.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Ḏua ngowa'a loasa re banari gena-ge 'aḏi kanau, ‘Ngomi mi oḏi'i Ma Jou no sawini 'au ngau, ḏua ngomi mi pula'a 'omo, bolo Ma Jou 'ani camala dudungu, ḏua ngomi mi pula'a ka'e. <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Ngomi oḏi'i Ma Jou sa'olo ngowa'a tagi-tagi ino tola'a taminga wala 'au ngau, kara ngomi dawongo Ma Jou taminga wala? 'Au ngau Ma Jou 'ani pakeanga 'i cua, ḏua ngomi mi pula'a pakeanga ra Ma Jou? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ngomi oḏi'i Ma Jou no siḏi 'au ngau kara ngomi kadiarata Ma Jou; bolo Ma Jou no osama bui 'au ngau, ḏua ngomi tutumu?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Re Ngoi, 'Olana gena-ge 'o sangoro, ‘Ni ngaku mode-mode'e Ngoi 'Ari demo nena-ne: 'Oru ḇato ngini reni 'a'a di'a riono 'Ari ioronongoḏu nena-ne ga'a ngowa'a mapake ua, Ngoi ta 'oro ino ma tero ḇato sa'olo ngini na riono Ngoi!’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Gena ḏua, Ngoi 'Olana gena-ge to kanau toma ngowa-ngowa'a Tari kuḇali, ‘Ngini ngowa'a ma jira, ni tagi. Ni osama toma u'u ma lejanga ga'a kama sora-sora ua ga'a sidodahe ḏua di'a 'Iblisi re enanga ma mala'ekata-mala'ekata! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Sababu wakutu Ngoi to sawini, ngini pula'a oromo ua. Wakutu Ngoi 'ari camala dudungu, ngini pula'a ka'e ua. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ngoi ngowa'a tagi-tagi ino, ngini dawongo Ngoi ua taninga wala. Ngoi 'ari pakeanga 'i cua, ngini pula'a pakeanga ra Ngoi ua. Ngoi to siḏi re to osama bui, ngini tutumu Ngoi ua.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Ananga 'aḏi kanau ḏi'i, ‘ 'Au ngau ngomi oḏi'i Ma Jou no sawini, bolo 'Ani camala dudungu, bolo sa'olo ngowa'a tagi-tagi ino, bolo 'Ani pakeanga 'i cua, bolo No siḏi re No osama bui, ḏua ngomi riono Ma Jou ua?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Re Ngoi, 'Olana gena-ge ta sangoro, ‘Ni ngaku mode-mode'e Ngoi 'ari demo nena-ne: Wakutu ngini ni oḏu'u riono ngowa-ngowa'a ma pake ua nena-ne, ma tero ḇato sa'olo ngini ni oḏu'u riono Ngoi.’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Ḏua ngowa'a gena-ge ga'a Tari kuḇali, ananga 'aḏi tagi toma ngi'i di'a sanga hukumu kasingado-ngadolo i'a. Mada'a ngowa'a loasa re banari ga'a Tari kuwiḏa, ananga gena-ge 'aḏi tagi toma ngi'i lelegu di'a sanga 'ahu kasingado-ngadolo i'a.”<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">Dan. 12:2</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Ngowa'a Yahudi ma bi-biri'i disa ngo'omo di'a cako'o Yesus</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mrk. 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Wakutu Yesus 'o doto'o 'ori i'a mo-moini gena-ge togumu ḏua, Unanga 'o kanau Tai me-mete'e, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Ngini ni waro, wangere ḏiḏi moju Paskah ma Wangere 'i ngadolo. Re Ngoi, Manusia ma Ngowa'a Nau'u sipula'a Tari lawana di'a sisalib.”<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Sup. 12:1-27</ref></char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Toma 'orasa gena-ge 'imam-'imam ma sae'e re Yahudi manga bi-biri'i 'aḏi malomu toma 'imam 'agung Kayafas 'ai kadato. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ananga 'aḏi mafakati, la 'aḏi cako'o Yesus sigo-gogoro kara 'U sisengene Unanga. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Mada'a ananga 'aḏi kanau, “Awa ngene wa si'a'a toma 'orasa Paskah ma Wangere, awa-awa toma rayata manga sigolona 'i dadi kaco.”<verse eid="MAT 26:5" /></para>
  <para style="s">Side-dege bou-bounu ma hali madutu ra <optbreak /> Yesus toma limau Betania</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mrk. 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoh. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Wakutu Yesus da'a toma gamu Betania, Unanga 'o tagi ra Simon 'ai wala, unanga gena-ge ma siḏa 'o sanga si-siḏi eno'o. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Toma 'orasa gena-ge, we-were'a matengo mo sapolo ra Yesus, munanga mo gasa bou-bounu botol rimoi. Bou-bounu gena-ge ma ijana hali madutu. Wakutu Yesus 'o majoreke oromo moju, we-were'a gena-ge mo masiba-ba'ala bou-bounu gena-ge ra Unanga 'ai sae'e.<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">Luk. 7:37-38</ref></char></note><verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Wakutu Yesus 'ai me-mete'e ya oḏi'i i'a so'o gena-ge, ananga 'aḏi dadi porata re 'aḏi kanau, “Ma la 'oru munanga mo sibodiga 'ami bou-bounu simoini? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Na'o bou-bounu gena-ge mawu'unu ma ijana lai hali, kara ma pipisi na pula'a toma ngowa-ngowa'a ma dinga'unu ua!”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesus 'a waro ananga manga fikirana. Dadi Unanga 'o kanau, “I'a sa'olo ngini nimi sikangela 'ami 'akala re sinyingara?! Munanga mo 'a'a 'ori i'a ma la-la di'a mo silamo'o Ngoi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ngowa'a ma dinga'unu ua 'age taninga sigolona tau-taunu, mada'a Ngoi 'age ra ngini tau-taunu ua.<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Dad. 15:11</ref></char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Wakutu munanga mo siba-ba'ala bou-bounu gena-ge ra Ngoi, munanga sidodahe 'Ari lese di'a ḏuanga i'a sipalihara Ngoi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ni ngaku mode-mode'e Ngoi 'ari demo nena-ne: Toma ngi'i le'a ḇato ngowa'a 'aḏi singadolo Habari Roanga, we-were'a nena-ne 'ami ga'a ma la-la, ngowa'a ḏuanga i'a ya sijarita ḏi'i, la sidaioranga munanga awa.”<verse eid="MAT 26:13" /></para>
  <para style="s">Yudas mau 'o mawu'unu Yesus toma 'imam-'imam ma sae'e</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mrk. 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Togumu i'a, ngowa'a matengo ra Yesus 'ai me-mete'e nga nyagi moi re nga muḏiḏi manga sigolona, ga'a silomanga Yudas Iskariot, unanga gena-ge 'o tagi toma 'imam-'imam ma sae'e. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Unanga 'o sano ra ananga, “Na'o ngoi to sipula'a Yesus ra ngini, ngini ḏuanga i'a ni pula'a 'oru ra ngoi?” Dadi ananga ya roimi manga pipisi salaka guḏi ro'ange, kara ananga 'aḏi pula'a ra unanga.<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Za. 11:12</ref></char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Dadi, mulaingi toma 'orasa gena-ge unanga disa donga, la sipula'a Yesus ra ananga.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesus re 'Ai me-mete'e ananga 'aḏi oromo <optbreak /> ngo-ngoromo Paskah</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mrk. 14:12-21</ref>; <ref loc="LUK 22:7-14">Luk. 22:7-14</ref>, <ref loc="LUK 21-23">21–23</ref>; <ref loc="JHN 13:21-30">Yoh. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Toma wangere ma mulaingi toma Wangere Roti Kama Ragi Ua, Yesus 'ai me-mete'e 'aḏi sapolo ra Unanga. Ananga 'aḏi sano, “Jou no mau toma ngi'i le'a ngomi mi sidodahe ngo-ngoromo Paskah?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yesus 'a sangoro, “Ngini ni tagi toma limau ma dara. I'a da'a, ngini ni ma'u sanga matengo re ni siajele ra unanga, ‘Minga Guru 'o kanau: 'Ai 'orasa 'i ngadolo ḏua. Unanga re ngomi 'Ai me-mete'e mau mi silamo'o Paskah ma Wangere ra ngana 'ani wala.’ ”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Dadi 'Ai me-mete'e ya si'a'a ma tero sa'olo Yesus 'o soma'a. Ananga 'aḏi tagi ya sidodahe ngo-ngoromo Paskah gena-ge.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Wakutu lobi'i 'i ngadolo ḏua, Yesus re 'Ai me-mete'e nga nyagi moi re nga muḏiḏi ananga 'aḏi majoreke 'aḏi oromo.<figure style="fig" alt="Jesus eating the last supper" file="LB00320B.TIF" size="span" ref="26:20">Yesus re 'Ai me-mete'e 'aḏi majoreke 'aḏi oromo</figure> <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Re wakutu ananga 'aḏi oromo moju, Yesus 'o kanau, “Ni ngaku mode-mode'e Ngoi 'Ari demo-demo nena-ne: 'Age rema ngowa'a matengo taninga sigolona ḏuanga i'a 'o sipula'a Ngoi Tari lawana.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Wakutu ananga ya 'isene i'a so'o gena, manga 'akala re sinyingara 'i kangela. Dadi matengo re matengo 'aḏi sano ra Yesus, “Ma Jou, tantu ḇato ngoi ua?!”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesus 'a sangoro, “Ngowa'a ga'a sitono 'ai roti toma sawo'o ma dara mamete'e ra Ngoi, unanga gena-ge ḏuanga i'a 'o sipula'a Ngoi Tari lawana.<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:10">Nya. 41:10</ref></char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Mode'e Ngoi, Manusia ma Ngowa'a Nau'u, balasu To sengene, ma tero sa'olo 'i silefo ḏua toma Boku 'Ofi-'Ofi ma dara. Mada'a ngowa'a ga'a sipula'a Ngoi, Manusia ma Ngowa'a Nau'u, unanga gena-ge 'o sanga bahala lamo'o. Jobilaha unanga gena-ge ma ngina mo sibuoro awa ḇato!”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Ḏua Yudas ga'a ḏuanga i'a 'o sipula'a Yesus 'o kanau, “Guru, tantu ḇato ngoi ua?!”</para>
  <para style="p" vid="MAT 26:25">Yesus 'a sangoro, “Mode'e ngana nena-ne!”<verse eid="MAT 26:25" /></para>
  <para style="s">Ma Jou 'ai Perjamuan</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mrk. 14:22-26</ref>; <ref loc="LUK 22:14-20">Luk. 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Wakutu ananga gena-ge 'aḏi 'omo moju, Yesus 'a 'oro ma roti re 'O sibere ie murasa ma la ra Ma Jou'ongu Madutu kara 'A poti-poti ma roti gena-ge 'A pula'a Tai me-mete'e re 'O kanau, “ 'Oro re na oromo, nena-ne Ngoi 'ari lese.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Gena ḏua, Unanga 'a 'oro ḏi'i ma sawo'o ma dara rema 'anggur re 'O sibere ie murasa ma la ra Ma Jou'ongu Madutu kara 'A sipula'a Tai me-mete'e re 'O kanau, “Ngini mo-moini na ka'e. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Sababu nena-ne Ngoi 'ari ngaunu ga'a sitotomo Ma Jou'ongu Madutu 'ai jaji. 'Ari ngaunu nena-ne 'i pa'ala di'a singi-ngiranga ngowa'a repe manga ḏosa.<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Sup. 24:8</ref>; <ref loc="JER 31:31-34">Yer. 31:31-34</ref></char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ngoi to siajele ra ngini nena-ne: Ngoi ta ka'e riwara 'anggur singadolo 'Ari Ḇaḇa 'ai dungia su-sungi 'i ngadolo, kara Ngoi ta ka'e 'anggur su-sungi mamete'e ra ngini.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Gena ḏua, ananga 'aḏi manyanyi rimoi di'a puji re silamo'o Ma Jou'ongu Madutu togumu i'a, ananga 'aḏi tagi toma Polono Zaitun.<verse eid="MAT 26:30" /></para>
  <para style="s">Nubuata mangale Petrus 'o soloto Yesus</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mrk. 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ḏua Yesus 'o kanau i'a Tai me-mete'e, “Toma lobi'i nena-ne, ngini mo-moini ni wiḏi sisoi'i tala Ngoi. Sababu toma Boku 'Ofi-'Ofi ma dara Ma Jou'ongu Madutu 'o kanau so'o ne:</para>
  <para style="q1" vid="MAT 26:31">‘Ngoi ḏuanga i'a Tu sisengene sowohi gena-ge,</para>
  <para style="q2" vid="MAT 26:31">re 'Ai doba-doba matai are.’<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Za. 13:7</ref></char></note><verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />Mada'a wakutu Ngoi dadunu To 'ahu moju, Ngoi to tagi siḏa toma daeraha Galilea.”<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat. 28:16</ref></char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petrus 'o kanau ra Yesus, “Kalaha ananga mo-moini 'aḏi sisoi'i tala Jou, ngoi tini sisoi'i tala yoḏu'u!”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesus 'o sangoro, “No ngaku mode-mode'e Ngoi 'Ari demo-demo nena-ne: Toma utu nange-ne ḏua, namo 'i solene nyangu, ngana masiretene no soloto Ngoi soi ro'ange ḏua.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Petrus 'a sangoro, “Kalaha ngoi to sengene mamete'e ra Jou, ngoi tini soloto Jou ua!” Re 'Ai me-mete'e ma lelegu 'aḏi kanau so'o gena ḏi'i.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesus 'o manyiata toma Getsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mrk. 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Togumu i'a, Yesus re 'Ai me-mete'e ananga 'aḏi tagi toma ngi'i rimoi ma lomanga Getsemani. Toma ngi'i gena-ge Yesus 'o kanau ra ananga, “Ni tegoro 'ane ngomasa moi, Ngoi tagi i'a da'a, di'a to manyiata.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ḏua Yesus 'o sigaro'o pa'i 'a Petrus re 'a Zebedeus 'ai ngowa'a nau'u nga muḏiḏi ḇato, ananga 'aḏi tagi mamete'e ra Unanga. Re Yesus mulaingi basono 'ai 'akala re sinyingara 'i kangela masala. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Unanga 'o kanau Tai me-mete'e nga ḏu'ange gena-ge, “'Ari 'akala re sinyingara 'i kangela masala singadolo ta basono sa'i to sengene. Totoma 'ane-ne re ni ma'istiari ino.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Gena ḏua, Yesus 'o tagi i'a da'a masai'i i'a ra ananga kiḏanga siḏi ua kara 'O ruba paga-pagara 'Ai biono tala toma tana'a, sababu 'Ai 'akala re sinyingara 'i kangela masala, re 'O manyiata ma betongo so'o ne: “ 'Ari Baba, na'o No nyengara sangisara nena-ne Na silalo'o ra Ngoi. Mada'a awa mete'e Ngoi 'ari mau, ḏuga-ḏuga mete'e Baba 'ani mau ḇato.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Togumu i'a, Yesus 'o maḏibo i'a Tai me-mete'e nga ḏu'ange re 'O sanga i'a ananga 'aḏi otu. Unanga 'o kanau ra Petrus, “Pa'i jam rimoi ḇato ngini nga'unu ua ni matahana ma'istiari mamete'e ra Ngoi?! <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Ni ma'istiari re ni manyiata, la awa ngini sanga bo-baja. Mode'e ninga roh mau 'a'a 'ori i'a ma banari mada'a ngini ni nga'unu ua, sababu ngini pai'i manusia ḇato dadi ni lamahana.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Soi moi moju, Yesus 'o tagi 'o manyiata ma betongo so'o ne: “'Ari Baba na'o sangisara nena-ne Ngoi balasu ta basono re silalo'o ra Ngoi 'i yoḏu'u, sieanga ḇato Baba 'ani mau 'i dadi.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Togumu i'a, Yesus dadunu 'o maḏibo i'a ra ananga re 'O sanga i'a ananga 'aḏi otu moju, sababu 'aḏi kakadungu siḏi woḏi.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Soi moi moju, Unanga ya'u sisoi'i tala ananga re 'O tagi di'a manyiata ma soi ro'ange ma betongo ma tero sa'olo 'au nange-ge. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Gena ḏua, Yesus dadunu maḏibo i'a Tai me-mete'e nga ḏu'ange re 'O kanau, “Ngini ni mangomasa re ni otu moju?! Oḏi'i ma 'orasa 'i ngadolo ḏua, Ngoi, Manusia ma Ngowa'a Nau'u sipula'a toma ngowa'a baraḏosa. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Momi'i, ino ngene wo tagi! Oḏi'i! Unanga ga'a 'o sipula'a Ngoi toma ngowa'a baraḏosa, unanga gino!”<verse eid="MAT 26:46" /></para>
  <para style="s">Yesus ananga 'U cako'o</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mrk. 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Wakutu Yesus 'o ka-kanau moju, 'a Yudas 'o sapolo, unanga gena-ge 'o osama nyo-nyoimi ra Yesus 'ai me-mete'e nga nyagi moi re nga muḏiḏi. Re ngowa'a manga repe 'aḏi sapolo mamete'e ra Yudas, 'aḏi gasa manga samaranga re bu-butulu. Ananga gena-ge 'imam-'imam ma sae'e re Yahudi manga bi-biri'i ya'u soma'a. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Nyangu moju, 'a Yudas 'o pula'a nana'o rimoi ra ananga re 'o kanau, “Ngowa'a ga'a ngoi tu dume, Unanga gena-ge ngini nu cako'o!”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Re wakutu Yudas 'o sapolo, unanga 'o jau i'a ra Yesus re 'o kanau, “Tabea, Rabi!”<note caller="+" style="f"><char style="fr" closed="false">26:49 </char><char style="fk" closed="false">Rabi </char><char style="ft" closed="false">toma demo Yunani &lt;&lt;Guru&gt;&gt; di'a ngowa'a ga'a 'o sayanga ma jingi'i.</char></note> Gena ḏua, unanga 'o dume Yesus 'ai bobongolo.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesus 'a sangoro, “Wolo, si'a'a ḇato 'oru ga'a ngana mau na si'a'a.”<note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">bolo “Wolo, di'a 'oru ngana no sapolo 'ane?!”</char></note></para>
  <para style="p" vid="MAT 26:50">Ḏua ngowa'a repe 'aḏi jau i'a cako'o 'a Yesus.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />'Age rema ngowa'a matengo ra Yesus 'ai me-mete'e manga sigolona, unanga gena-ge 'a tuono 'ai samaranga toma sarumu, kara 'a cafa 'imam 'agung 'ai budaka 'ai ngau'u singadolo 'i tola'a! <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Yesus 'o kanau Tai me-mete'e matengo gena-ge, “Dadunu na singosama 'ani samaranga toma sarumu, sababu ngowa'a mo-moini ga'a 'aḏi pake samaranga, ananga ḏuanga i'a ngowa'a ya'u sisengene reo samaranga ḏi'i. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />'Oru ngana no waro ua mangale na'o Ngoi to golo'o ri-riono tari Ḇaḇa, Unanga jau-jau 'o siḏingoto pai'i pasukana<note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">pasukana rimoi: nyengara sordado nga cala rarama singadolo nga cala nyagi moi re cala romoḏiḏi.</char></note> mala'ekata nga nyagi moi re nga muḏiḏi di'a riono Ngoi?! <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Mada'a na'o so'o gena, tantu ḏua 'i dadi ua 'oru ga'a ri sinubuata ḏua toma Boku 'Ofi-'Ofi ma dara mangale balasu 'i dadi ma tero so'o nena-ne!”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Toma 'orasa gena-ge, Yesus 'o kanau toma ngowa'a kawasa gena-ge, “I'a sa'olo ngini ni sapolo re ninga samaranga re bu-butulu di'a ni cako'o ngoi ma tero sa'olo ngowa'a ma jira?! Ma wangere ma jelele i'a, Ngoi to tegoro di'a to doto'o ra Ma Jou'ongu Madutu 'ai Wala, mada'a ngini rini cako'o Ngoi ua!<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk. 19:47</ref>, <ref loc="LUK 21:37">21:37</ref></char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Mada'a balasu so'o nena-ne ḏua, la 'i mete'e 'oru ga'a nabi-nabi ya silefo pasala ḏua toma Boku 'Ofi-'Ofi ma dara.” Togumu i'a, 'Ai me-mete'e mo-moini matai wiḏi sisoi'i tala Unanga.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesus 'U sitalaḏi toma Mahkamah 'Agama</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mrk. 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk. 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoh. 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Ngowa'a ga'a 'aḏi cako'o Yesus 'aḏi gasa Unanga toma 'imam 'agung Kayafas 'ai wala. Toma ngi'i gena-ge guru-guru 'agama re Yahudi manga bi-biri'i raḏi malomu. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Petrus, unanga 'o tu-tuu'u toma giḏanga ra Yesus singadolo toma 'imam 'agung 'ai wala ma soana. I'a da'a, unanga 'o osama toma soana re 'o tegoro mamete'e reo ngowa'a jaga. Unanga mau disa waro mo-moini 'oru ga'a ananga 'aḏi 'a'a ra Yesus.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />'Imam-'imam ma sae'e re Mahkamah 'Agama mo-moini 'aḏi disa sakisi sa-sakala, la 'aḏi singe-ngeta'a hukumu sengene ra Yesus. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Kalaha 'age rema sakisi sa-sakala manga repe, ananga 'aḏi sanga 'ai sala dola moi i'a mai ua, ga'a 'i patasa Unanga sihukumu sengene. Ma ḏo-ḏogumu ngowa'a nga muḏiḏi, i'a toma biono. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />Ananga 'aḏi kanau, “Ngowa'a nena-ne 'o kanau, ‘Ngoi nyengara Ta siruba Ma Jou'ongu Madutu 'Ai wala, re toma wangere ro'ange nyengara Ta simomi'i.’ ”<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoh. 2:19</ref></char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Ḏua 'imam 'agung 'o made'oso re 'o kanau ra Yesus, “I'a sa'olo Ngana no sangoro ua ananga manga gamamu gena-ge ra Ngana?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Mada'a Yesus pa'i 'o masiogoro ḇato.</para>
  <para style="p" vid="MAT 26:63">Soi moi moju 'imam 'agung 'o sano ra Yesus, “Ra Ma Jou'ongu Madutu ga'a 'ahu-'ahu, sikanau ino ra ngomi mode-mode'e Ngana nena-ne 'O Kristus, Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u, bolo ua?”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesus 'a sangoro, “Ma tero sa'olo ngana no kanau. Mada'a 'elingi 'Ari demo nena-ne: ngini ḏuanga i'a ni oḏi'i Ngoi, Manusia ma Ngowa'a Nau'u, To tegoro ra Ma Jou'ongu Madutu 'ai giama ma kuwiḏa i'a, Unanga gena-ge 'Ai kuasa ma pari cua. Re Ngoi to sapolo ra Ma Jou'ongu Madutu toma kakamo ma re'u da'u diwanga tala!”<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan. 7:13</ref></char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Gena ḏua, 'imam 'agung 'a 'acingi 'ai juba masiretene sababu 'o porata re 'o kanau, “Unanga 'o je-jengere Ma Jou'ongu Madutu sababu Unanga 'o kanau ‘Unanga re Ma Jou'ongu Madutu marimoi!’ Dadi paralu riwara sakisi. Nange-ne ngini mo-moini na 'isene masiretene 'Ai demo-demo ga'a sije-jengere Ma Jou'ongu Madutu.<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />Dadi ninga 'akala ma sanga sa'olo?”</para>
  <para style="p" vid="MAT 26:66">Ananga 'aḏi sangoro, “Unanga balasu 'o sanga hukumu sengene.”<note caller="-" style="x"><char style="xo" closed="false">26:65-66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">'Im. 24:16</ref></char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Ḏua, ananga ya obi'i 'Ai biono re 'U tutu'u. Re 'age ḏi'i rema ngowa'a ma lelegu 'U sata,<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">Yes. 50:6</ref></char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />re 'aḏi kanau, “Na'o Ngana 'O Kristus, tai'i no disa waro re no siajele ra ngomi 'a guna ni sata Ngana!”<verse eid="MAT 26:68" /></para>
  <para style="s">Petrus 'o soloto Yesus</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mrk. 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh. 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Wakutu Petrus 'o tegoro moju toma ḏuḏunu da'a soana, falalomu we-were'a matengo mo sapolo re mo kanau ra unanga, “Ngana nena-ne ḏi'i no mamete'e ra Yesus ngowa'a Galilea gena-ge!”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Mada'a Petrus 'o masoloto ra ananga manga biono mo-moini re 'o kanau, “Ngoi ta waro ua 'ani maksudu 'oru!”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Gena ḏua, unanga 'o tagi toma soana ma ngalana. Ḏua falalomu we-were'a ma lelegu mo oḏi'i 'a Petrus re mo kanau toma ngowa-ngowa'a ga'a 'aḏi tegoro 'age, “Ngowa'a matengo nena-ne ḏi'i 'o mamete'e ra Yesus toma limau Nazaret.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ḏua Petrus 'o masoloto moju re 'o masisasi, “Mode-mode'e, ngoi to nana'o ngowa'a gena-ge ua!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Ti'ara mai nyangu, ngowa'a ga'a 'aḏi made-de'oso toma ngi'i gena-ge 'aḏi sapolo ra Petrus re 'aḏi kanau, “Tantu ḏua, ngana ḏi'i no osama nyo-nyoimi ra ananga, sababu 'ani demo ma lug̱o ma tero sa'olo ngowa'a Galilea.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Ḏua, 'a Petrus mulaingi 'o masisasi re 'o kanau, “Ngoi to nana'o ngowa'a gena-ge ua!”</para>
  <para style="p" vid="MAT 26:74">Gena ḏua, namo 'i solene. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Re 'a Petrus 'a si'elingi ie 'oru ga'a nange-ge Yesus ro kanau ra unanga, “ 'O namo 'i solene nyangu mada'a ngana reno soloto Ngoi soi ro'ange.” Petrus 'o tagi re 'o supu toma soana gena-ge, re 'o 'aḏi jomo-jomo.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesus 'U sigasa ra Pilatus</para>
  <para style="r">(<ref loc="MRK 15:1">Mrk. 15:1</ref>; <ref loc="LUK 23:1-2">Luk. 23:1-2</ref>; <ref loc="JHN 18:28-32">Yoh. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Da-daini i'a moju, 'imam ma sae'e re Yahudi manga bi-biri'i, ananga mo-moini 'aḏi masigaro'o re 'aḏi mafakati mangale Yesus balasu 'o sengene. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ananga 'aḏi piri'u Unanga 'ai giama, kara 'U sigasa re 'U sipula'a ra Pilatus, gubernur daeraha Yudea.<verse eid="MAT 27:2" /></para>
  <para style="s">Yudas 'o sengene</para>
  <para style="r">(<ref loc="ACT 1:18-19">Som. 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Wakutu 'a Yudas ga'a sipula'a Yesus di'a 'Ai lawana, 'a waro mangale Yesus sanga hukumu sengene unanga 'o matuduba masala. Dadi unanga 'a siḏibo pipisi salaka guḏi ro'ange gena-ge toma 'imam-'imam ma sae'e re Yahudi manga bi-biri'i. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Unanga 'o kanau, “Ngoi to baraḏosa sababu to sipula'a ngowa'a kama sala ua, singadolo Unanga sanga hukumu sengene!”</para>
  <para style="p" vid="MAT 27:4">Mada'a ananga ya sangoro, “Ngomi mi faduli ua, gena-ge ngana 'ani 'urusana!” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Dadi Yudas 'a upa'a pipisi gena-ge ra Ma Jou'ongu Madutu 'ai Wala ma dara, kara tagi sisoi'i tala ananga re 'o makole.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />'Imam-'imam ma sae'e ya 'oro pipisi gena-ge re 'aḏi kanau, “Pipisi nena-ne pipisi ngaunu. Dadi mete'e Musa 'ai hukumu pipisi so'o nena-ne sigare yoḏu'u toma jou-jou ma ngi'i ra Ma Jou'ongu Madutu 'ai Wala.”<note caller="-" style="x"><char style="xo" closed="false">27:6 </char><char style="xt" closed="false"><ref loc="DEU 23:18">Dad. 23:18</ref></char></note> <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Ḏua ananga 'aḏi mafakati pake pipisi gena-ge di'a sitibo tana'a ga'a si'aro'o ma lomanga Tana'a Tukanga 'a'a Giu'u. Tana'a gena-ge 'i si'a'a daeraha kubu di'a ngowa'a tagi-tagi ino. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Sababu gena-ge, singadolo wangere nange-ne ngowa'a ya si'aro'o tana'a gena-ge, “Tana'a Ngaunu”.<note caller="-" style="x"><char style="xo" closed="false">27:3-8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">Som. 1:18-19</ref></char></note><verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Nena-ne nabi Yeremia 'a sinubuata pasala ḏua ma betongo so'o ne: “Ananga 'aḏi dawongo pipisi salaka guḏi ro'ange ga'a ngowa'a Israel 'aḏi mafakati pasala ḏua di'a tibo Unanga.<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Mete'e Israel ma 'atoranga, budaka ma ijana pipisi salaka guḏi ro'ange.</char></note> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Pipisi gena-ge ananga ya pake di'a sitibo tana'a toma ngowa'a ya si'a'a giu'u ma tero sa'olo Ma Jou'ongu Madutu 'ai parenta ra ngoi.”<note caller="-" style="x"><char style="xo" closed="false">27:9-10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Za. 11:12-13</ref></char></note><verse eid="MAT 27:10" /></para>
  <para style="s">Yesus 'U sitalaḏi ra Pilatus</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mrk. 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk. 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoh. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Wakutu Yesus 'U sitalaḏi ra Pilatus, gubernur daeraha gena-ge, Pilatus 'o sano ra Yesus, “Ngana nena-ne, mode-mode'e ngowa'a Yahudi manga 'olana bolo ua?”</para>
  <para style="p" vid="MAT 27:11">Yesus 'a sangoro, “Tero mode'e sa'olo ngana no kanau.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Mada'a wakutu 'imam-'imam ma sae'e re Yahudi manga bi-biri'i ananga ya singadolo manga da'awa ra Yesus, Unanga kama sangoro riwara.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Ḏua Pilatus 'o kanau ra Unanga, “Ngana na 'isene manga da'awa ga'a ananga 'aḏi kalaki Ngana?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Mada'a Yesus kama sangoro ceka'a i'a mai ua singadolo 'a Pilatus 'o heranga madutu.<verse eid="MAT 27:14" /></para>
  <para style="s">Singe-ngeta'a hukumu sengene ra Yesus</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mrk. 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk. 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yoh. 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Gubernur toma Paskah ma Wangere biasa 'o sibebasa ngowa'a bui matengo, mete'e ngowa'a kawasa manga go-golo'o. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Toma 'orasa gena-ge, 'age rema ngowa'a bui matengo, ga'a ngowa'a ya waro le'a bolo le'a, unanga 'ai lomanga Yesus Barabas.<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Toma kartasi lo-lolo ma siḏa-siḏa ma repe, pa'i </char><char style="fk" closed="false">Barabas </char><char style="ft" closed="false">ḇato. Gena-ge ma tero toma bu-bula'a 17.</char></note> <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Dadi wakutu ngowa'a kawasa raḏi malomu, Pilatus 'o sano i'a ra ananga, “Ngini mau ngoi to sibebasa 'a guna? Yesus Barabas bolo Yesus ga'a si'aro'o 'O Kristus?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilatus 'o kanau so'o gena, sababu unanga 'a waro ḏua 'imam-'imam ma sae'e re Yahudi manga bi-biri'i, ananga 'aḏi sipula'a Yesus ra unanga sababu manga 'akala re sinyingara 'i go-goḏi.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Wakutu Pilatus 'o tegoro toma kursi juruhakimi moju, 'ai were'a mo siḏingoto bererongo ra unanga: “Awa ngana no macapuru toma parkara gena-ge mangale ngowa'a matengo gena-ge ga'a kai sala ua. Sababu mangale Unanga, ngoi to sanga nanele cira singadolo 'ari 'akala re sinyingara 'i kangela.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Mada'a 'imam-'imam ma sae'e re Yahudi manga bi-biri'i, ananga 'aḏi babata ngowa'a kawasa tau-taunu di'a 'aḏi golo'o ra Pilatus 'o sibebasa 'a Barabas, re singe-ngeta'a hukumu sengene ra Yesus. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Ḏua gubernur Pilatus dadunu 'o sano ra ananga, “Ngowa'a nga muḏiḏi gena-ge, ngini mau ngoi to sibebasa 'a guna?”</para>
  <para style="p" vid="MAT 27:21">Ananga ya sangoro, “Barabas!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilatus 'o sano i'a ra ananga, “Na'o so'o gena, ngoi balasu to 'a'a 'oru ra Yesus, ga'a si'aro'o 'O Kristus?”</para>
  <para style="p" vid="MAT 27:22">Ananga mo-moini ya sangoro, “Sisalib Unanga!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pilatus dadunu 'o sano ra ananga, “I'a sa'olo? Unanga 'ai sala 'oru?”</para>
  <para style="p" vid="MAT 27:23">Mada'a ananga ganapu poa'a ya siduga-duga, “Sisalib Unanga!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ma ḏo-ḏogumu tala, Pilatus 'a basono tala 'ai demo-demo ma faeda ri cua toma ngowa'a kawasa, re ananga ganapu 'aḏi manyiwere singadolo sa'i 'aḏi 'a'a kaco. Dadi unanga 'o 'oro ḇanyo re 'a soso'o 'ai giama toma mandan. Re unanga 'o kanau, “Unanga 'ai se-sengene pa'i ngini masiretene ninga 'urusana ḇato! Ngoi kari sala ua!”<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">Dad. 21:6-9</ref></char></note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Ngowa'a kawasa mo-moini 'aḏi sangoro, “Ya, sieanga i'a ngomi re minga ju'uda ma sanga enanga ma hukumu, sababu ngomi mi sisengene Unanga.”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Ḏua Pilatus 'o sibebasa 'a Barabas re 'o soma'a 'ai sordado 'aḏi sipo Yesus, kara Pilatus 'U sipula'a i'a di'a 'U sisalib.<verse eid="MAT 27:26" /></para>
  <para style="s">Sordado-sordado 'aḏi je-jengere Yesus</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mrk. 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoh. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Gena ḏua, gubernur Pilatus 'ai sordado-sordado gasa Yesus osama ra gubernur 'ai kadato. Ḏua ananga 'aḏi 'aro'o sordado mo-moini malomu sigoloḏi Unanga. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ananga ya woi'i Unanga 'ai baju re 'U sipake Unanga reo juba 'ungu. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ḏua, ananga 'aḏi 'oro ate ma umanga rema dodowo'o ya tuhu sa'olo lastari, kara ya siteru ra Unanga 'ai sae'e. Gena ḏua, ya siteru i'a didiki ra Unanga 'ai giama ma kuwiḏa, kara 'aḏi maḏipolono Tai biono re 'aḏi je-jengere Unanga re 'aḏi kanau, “Suba, Ngana Yahudi manga 'olana!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ananga 'aḏi obi'i Unanga re ya 'oro 'Ai didiki, kara 'U sica'olo 'Ai sae'e tau-taunu. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Wakutu ananga 'aḏi je-jengere Unanga togumu i'a, ananga ya woi'i juba 'ungu nange-ge, kara ya singali i'a 'Ai baju masiretene. Ḏua ananga 'aḏi sisupu Unanga ra Pilatus 'ai kadato re 'aḏi gasa toma ngi'i di'a 'U sisalib.<verse eid="MAT 27:31" /></para>
  <para style="s">Sordado 'aḏi sisalib Yesus</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mrk. 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Toma ḏo-ḏagi ma dara, sordado-sordado ma'u sanga matengo toma limau Kirene ino 'ai lomanga Simon, re ananga 'aḏi simau-mau unanga 'a doiti Yesus 'ai salib. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Ḏua ananga 'aḏi ngadolo toma ngi'i ma lomanga Golgota (gena-ge ma ngale: “Ḏoḏowi ma Ngi'i”). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Toma ngi'i gena-ge ananga pula'a Yesus ka'e 'anggur ya sicapuru midingi. Mada'a wakutu Unanga 'a tai'i, Unanga 'o oḏu'u 'A ka'e.<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:22">Nya. 69:22</ref></char></note><verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Gena ḏua, ananga sisalib Unanga kara sordado-sordado 'a'a loterei di'a 'aḏi sibalangu 'Ai pakeanga.<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:19">Nya. 22:19</ref></char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Togumu i'a, ananga 'aḏi tego-tegoro di'a 'aḏi dadanu Unanga. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Tai sae'e ma re'u toma salib co-cori ma tubu, sordado ya sipaku i'a Mahkamah 'Agama manga da'awa ra Unanga ma betongo so'o ne:</para>
  <para style="qc" vid="MAT 27:37">
    <char style="sc">“Unanga nena-ne Yesus,</char></para>
  <para style="qc" vid="MAT 27:37">
    <char style="sc">ngowa'a Yahudi manga 'Olana.”</char>
    <figure style="fig" alt="Jesus on cross with sign overhead" file="LB00324B.TIF" size="span" ref="27:37">Toma salib ma tubu, 'age da'awa ma betongo so'o ne: &lt;&lt;Unanga nena-ne Yesus, Ngowa'a Yahudi manga 'Olana.&gt;&gt; </figure><verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />'Age rema ngowa'a to-tori'i nga muḏiḏi ḏi'i 'aḏi sisalib simete'e ra Yesus; matengo Tai kuwiḏa re matengo Tai kuḇali.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Ngowa'a ga'a 'aḏi tola'a i'a ino toma ngi'i gena-ge, ananga ya elala manga sae'e re 'aḏi je-jengere Yesus,<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Nya. 22:8</ref>, <ref loc="PSA 109:25">109:25</ref></char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />'aḏi kanau, “Ngana nena-ne ga'a no mau siruba Ma Jou'ongu Madutu 'ai Wala re Na simomi'i moju pa'i ma di'ara wangere ro'ange, No sisalamata 'Ani diri! Na'o Ngana Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u, No 'uci toma salib gena-ge!”<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mat. 26:61</ref>; <ref loc="JHN 2:19">Yoh. 2:19</ref></char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />So'o gena ḏi'i, 'imam-'imam ma sae'e, guru-guru 'agama re Yahudi manga bi-biri'i 'aḏi je-jengere Yesus. Ananga 'aḏi kanau, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Unanga 'o sisalamata ngowa'a lelegu, momongolo ua 'Ai diri masiretene, Unanga 'a sisalamata yoḏu'u! Na'o Unanga Israel manga 'Olana tai'i i'a 'uci toma salib gena-ge, la ngomi mi ngaku Unanga. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Unanga 'o ngaku Ma Jou'ongu Madutu re Ro kanau, Unanga Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u. Nah ino ngene wo oḏi'i wangere nange-ne na'o Ma Jou'ongu Madutu mau 'U sisalamata Unanga bolo ua.”<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:9">Nya. 22:9</ref></char></note><verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />So'o gena-ge ḏi'i, ngowa'a to-tori'i ga'a sisalib simete'e ra Unanga mai 'aḏi je-jengere Unanga.<verse eid="MAT 27:44" /></para>
  <para style="s">Yesus 'o sengene</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mrk. 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ca'olo nyagi moi re romoḏiḏi wangere 'olona tala singadolo ca'olo ro'ange wangere so'o ne'o, wangere ma la'o 'i taḏusu, re daeraha gena-ge mo-moini 'i dadi hafu-hafu. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ḏa toma ca'olo ro'ange wangere so'o ne'o Yesus 'o poa'a 'a siduga-duga, “Eli, Eli lama sabakhtani?” Enanga ma ngale: “ 'Ari Jou'ongu Madutu, 'Ari Jou'ongu Madutu, i'a sa'olo No sieanga i'a Ngoi?”<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:2">Nya. 22:2</ref></char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Wakutu ngowa'a nga muḏuo i'a toma ngi'i gena-ge ya 'isene Yesus 'ai iḏingi so'o gena-ge, ananga 'aḏi kanau, “Unanga 'o 'aro'o 'a Elia!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />'Age matengo tamanga sigolona, unanga jau-jau tagi 'o 'oro bunga karang re 'a tono toma 'anggur ko-kowi'i. Gena ḏua, 'a sitopo'o toma ḏu-ḏubo ma dere, kara 'a situbo ie ra Yesus 'ai 'uḏu ma betu'u di'a Unanga 'a cono'o.<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:22">Nya. 69:22</ref></char></note><verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Mada'a ngowa'a lelegu 'aḏi kanau, “Toma si, ino ngene wa oḏi'i wari i'a si 'a Elia 'o sapolo 'U sisalamata Unanga!”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Ḏua Yesus 'o poa'a 'a siduga-duga, kara 'Ai sangagara 'i togumu.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ngalana ma da-daku kole-kole<note caller="+" style="f"><char style="fr" closed="false">27:51 </char><char style="ft" closed="false">Ngalana ma da-daku ga'a kole-kole, la matengo i'a mai ua nyengara osama toma Kamara Lai 'Ofi-'Ofi ra Ma Jou'ongu Madutu 'ai Wala ma dara, pa'i 'imam 'agung ḇato.</char></note> ra Ma Jou'ongu Madutu 'ai Wala ma dara, enanga 'i raca kaci ḏiḏi, da'u singadolo dau. Ḏua wusu 'i dadi re maḏi lamo'o 'i tiwa'a.<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Sup. 26:31-33</ref></char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Kubu-kubu ma repe matai welanga re Ma Jou'ongu Madutu 'ai ngowa-ngowa'a manga repe ga'a raḏi sengene, ananga dadunu 'aḏi 'ahu moju. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ananga gena-ge 'aḏi supu tamanga kubu. Mada'a ananga pa'i 'aḏi osama toma limau Yerusalem wakutu Yesus dadunu ro 'ahu moju.<note caller="+" style="f"><char style="fr" closed="false">27:53 </char><char style="ft" closed="false">'Age toma kartasi lo-lolo lelegu 'i silefo so'o ne: Re wakutu Yesus dadunu ro 'ahu moju, ananga gena-ge 'aḏi supu tamanga kubu re 'aḏi osama toma limau Yerusalem.</char></note> I'a da'a, ngowa'a repe ya'u oḏi'i ananga.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Sordado ma sae'e remanga sordado-sordado ga'a dadanu Yesus, ananga 'aḏi matai mojongo sababu 'aḏi basono wusu re raḏi oḏi'i 'ori i'a i'a 'i dadi. Ḏua ananga 'aḏi kanau, “Unanga nena-ne mode-mode'e Ma Jou'ongu Madutu 'ai Ngowa'a Nau'u!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Toma ngi'i gena-ge, 'age ḏi'i rema we-were'a manga repe 'aḏi oḏi'i toma giḏanga. Ananga gena-ge ma di'ara ḏua 'aḏi mete'e Yesus re 'aḏi riono Unanga, mulaingi da'a Galilea ino. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Tamanga sigolona, 'age ngo Maria Magdalena, Maria 'a Yakobus re 'a Yusuf manga ngina, re Zebedeus 'ai were'a.<note caller="-" style="x"><char style="xo" closed="false">27:55-56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luk. 8:2-3</ref></char></note><verse eid="MAT 27:56" /></para>
  <para style="s">Palihara Yesus</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mrk. 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57-58" style="v" sid="MAT 27:57-58" />Wakutu ma wangere sa'i ri lobi'i, 'age rema ngowa'a rema-enanga matengo ga'a 'ai 'asala toma limau Arimatea ino. Unanga 'ai lomanga Yusuf re unanga ro osama nyo-nyoimi ra Yesus 'ai me-mete'e ḏi'i. Unanga tagi ra Pilatus re 'o golo'o Yesus 'ai mayeti. Ḏua Pilatus 'o soma'a 'ai sordado 'aḏi pula'a Yesus 'ai mayeti ra Yusuf. <verse eid="MAT 27:57-58" /><verse number="59" style="v" sid="MAT 27:59" />Ḏua 'a Yusuf 'a 'oro Unanga 'ai mayeti re 'a sisao reo ḇa'a lenan buḏo ga'a 'ofi,<note caller="+" style="f"><char style="fr" closed="false">27:59 </char><char style="ft" closed="false">Ḏa ḇa'a ma sungi. </char></note> <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />kara 'a sigare Yesus 'ai mayeti gena-ge ra Yusuf masiretene 'ai kubu ma su-sungi ma 'aḏu'u. Kubu gena-ge ga'a ngowa'a 'aḏi tuso'o maḏi toma bawata ma gagoro. Togumu i'a, unanga lulu maḏi lamo'o rimoi di'a 'a sidaku kubu ma ngalana, kara 'o tagi sisoi'i tala ngi'i gena-ge. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Toma 'orasa gena-ge, Maria Magdalena re ngo Maria ma lelegu, ananga nga muḏiḏi 'aḏi tegoro ya talaḏi i'a kubu gena-ge.<verse eid="MAT 27:61" /></para>
  <para style="s">Sordado-Sordado ga'a dadanu Yesus 'ai kubu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ma ḇiḇini ino Sabata ma wangere re 'imam-'imam ma sae'e mamete'e reo ngowa-ngowa'a Farisi, ananga 'aḏi tagi re 'aḏi talaḏi ra Pilatus, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />re 'aḏi kanau, “Tuanga, ngomi mi 'elingi Yesus, tukanga sa-sakala, wakutu Unanga 'o 'ahu-'ahu moju Ro kanau, ‘Toma wangere ro'ange Ngoi dadunu to 'ahu moju.’<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat. 16:21</ref>, <ref loc="MAT 17:23">17:23</ref>, <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mrk. 8:31</ref>, <ref loc="MRK 9:31">9:31</ref>, <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luk. 9:22</ref>, <ref loc="LUK 18:31-33">18:31-33</ref></char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Sababu gena-ge, no soma'a sordado 'aḏi tagi di'a dadanu kubu gena-ge singadolo wangere ro'ange, la awa 'Ai me-mete'e ya tori'i 'Ai mayeti. Ḏua ananga gena-ge 'aḏi siajele toma ngowa-ngowa'a, ‘Unanga dadunu ro 'ahu moju toma ngowa'a senge-sengene manga sigolona.’ Dadi 'Ai sa-sakala ma ḏo-ḏogumu gena-ge lebe cira reo 'Ai sa-sakala ma siḏa.”<note caller="+" style="f"><char style="fr" closed="false">27:64 </char><char style="ft" closed="false">Oḏi'i Mat. 26:64</char></note><verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilatus 'o kanau ra ananga, “Da'a rema sordado-sordado. Ngini na'u sigasa ananga gena-ge di'a 'aḏi dadanu, la 'aḏi site'e kubu gena-ge.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Ḏua ananga mamete'e reo sordado gena-ge, ananga 'aḏi tagi toma kubu. Re ananga ya segele kubu ma da-damunu maḏi re 'aḏi soma'a sordado di'a dadanu kubu ma biono gena-ge, la ngowa'a ya 'oro Yesus 'ai mayeti yoḏu'u.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Yesus dadunu 'o 'ahu moju</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mrk. 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Sabata ma wangere palisi'i i'a migu ma wangere da-daini i'a moju, ngo Maria Magdalena re ngo Maria ma lelegu 'aḏi tagi ya oḏi'i kubu gena-ge.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Kage-kage 'i dadi wusu lai siḏi madutu re Ma Jou'ongu Madutu 'ai mala'ekata 'o 'uci da'u soroga tala. Ḏua unanga 'o tagi 'a lulu maḏi 'o kubu ma da-damunu, re 'o tegoro toma re'u. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Mala'ekata gena-ge 'ai jamani sa'olo ḇeḇelanga, re 'ai pakeanga 'i buḏo madutu. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Sordado ga'a dadanu kubu gena-ge, ananga 'aḏi dadi mojongo madutu singadolo 'aḏi terewete, re maeta'a toma tana'a re dadi sa'olo ngowa'a sengene.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Mala'ekata gena-ge 'o kanau toma we-were'a--we-were'a, “Ni mojongo awa! Ngoi to waro ngini disa Yesus, ga'a ngowa'a 'U sisalib. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Unanga 'o cua 'ane. Unanga dadunu ro 'ahu moju sa'olo 'au nga'ene Ro kanau ḏua ra ngini. Ino ni oḏi'i ga'a ngowa'a ya sigare 'Ai mayeti, <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />kara ni tagi ca-cautu ni siajele ra Unanga 'ai me-mete'e: ‘Unanga dadunu ro 'ahu moju re nange-ne Unanga ro tagi siḏa i'a da'a toma Galilea. I'a da'a kara ngini ni oḏi'i Unanga!’ 'Elingi 'ari habari gena-ge 'oru ga'a ngoi to kanau ra ngini nange-ne.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Dadi macautu i'a, we-were'a gena-ge ya sisoi'i tala kubu. Ananga gena-ge 'aḏi mojongo mada'a 'aḏi roanga masala, re ananga 'aḏi lalara di'a 'aḏi singadolo habari gena-ge ra Yesus 'ai me-mete'e.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Kage-kage, Yesus 'o sapolo ma'u sanga we-were'a gena-ge, re 'O kanau, “Tabea!” Ḏua ananga 'aḏi macori i'a ra Unanga re 'aḏi sibo'olo 'ai rou kara 'aḏi silamo'o re siḏubuso Unanga. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesus 'o kanau ra ananga, “Ni mojongo awa! Ni tagi re siajele ra Ngoi 'ari ioronongoḏu, la 'aḏi tagi da'a Galilea. I'a da'a ananga 'aḏi ma'u sanga ra Ngoi.”<verse eid="MAT 28:10" /></para>
  <para style="s">Sordado ga'a dadanu kubu 'aḏi singadolo mangale 'oru ga'a 'i dadi ḏua</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Wakutu we-were'a 'aḏi tagi moju di'a siajele ra Yesus 'ai me-mete'e, sordado nga muḏuo i'a ga'a dadanu kubu 'aḏi maḏibo i'a da'a limau, re 'aḏi siajele toma 'imam-'imam ma sae'e 'oru ga'a 'i dadi ḏua. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />'Imam-'imam ma sae'e re Yahudi manga bi-biri'i, ananga 'aḏi malomu re 'aḏi mafakati di'a pula'a pipisi ma lamo'o toma sordado ga'a 'aḏi dadanu kubu, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />'aḏi kanau, “Ngini balasu ni siajele, ‘ 'A Yesus 'ai me-mete'e ya tori'i 'Ai mayeti 'orasa utu i'a, wakutu ngomi matai otu.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Re na'o ma gubernur 'a 'isene, ngomi ḏuanga i'a mi makanau ra unanga, la ngini sanga susa awa.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Ḏua sordado ga'a 'aḏi dadanu kubu, ya dawongo pipisi gena-ge, re ya si'a'a ma tero sa'olo 'aḏi sanga bererongo ra ananga. Re jarita gena-ge singadolo wangere nange-ne, ngowa'a Yahudi ya sija-jarita.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesus 'o masibaiti Tai me-mete'e</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mrk. 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh. 20:19-23</ref>; <ref loc="ACT 1:6-8">Som. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Yesus 'ai me-mete'e nga nyagi moi re matengo, ananga 'aḏi tagi toma Galilea ma polono rimoi, mete'e Yesus ro siajele ra ananga.<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat. 26:32</ref>; <ref loc="MRK 14:28">Mrk. 14:28</ref></char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Wakutu ananga 'aḏi oḏi'i 'a Yesus, ananga 'aḏi silamo'o re siḏubuso Unanga. Mada'a mamuni'a 'aḏi wa-waḏunu. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesus 'o macori i'a ra ananga re 'o kanau, “Kuasa mo-moini bae toma soroga, bae toma dungia gena-ge Ri sipula'a ra Ngoi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Sababu gena-ge, ni tagi toma bangsa mo-moini toma dungia sitabi donga, ni singadolo Habari mangale Ngoi, la ngowa'a 'aḏi dadi 'Ari me-mete'e. Ni baptis ananga gena-ge re siterongo Ḇaḇa 'ai lomanga, Ma Ngowa'a Nau'u 'ai lomanga, re Ma Ngagara 'Ofi-'Ofi ma lomanga.<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Som. 1:8</ref></char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Re ni doto'o 'Ari me-mete'e gena-ge di'a 'aḏi 'ahu mete'e 'Ari parenta mo-moini ga'a Ngoi reta siajele pasala ḏua ra ngini. Re 'elingi nena-ne: Ngoi ḏuanga i'a tini sieanga i'a ua ngini, singadolo dungia nena-ne ma ḏo-ḏogumu.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>