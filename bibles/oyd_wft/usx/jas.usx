<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Oyda New Testament</book>
  <para style="h">Yayqooba</para>
  <para style="toc1">Yayqooba Xaafide Kiita</para>
  <para style="toc2">Yayqooba</para>
  <para style="toc3">Yay.</para>
  <para style="mt1">Yayqooba Xaafide Kiita</para>
  <para style="imt1">Gele</para>
  <para style="ip">Yayqooba kiita, ammanze asuntsi fa yeze yestte kaallodes beezize qofito aykkida. Hyanna kiita xaafinttidanna, sa7a ubbanne lalinttide taphpho lam77i Ayhude zaruntsis. Hyay maxaafize xaafize, cinccatitsi nu oochalla feeshize oge, ammanze asi mokkize bazin lo77o woga oge beezize ohito misile gaar qonccizane.</para>
  <para style="ip">Yayqooba kiita, dahatitsbaz, duretitsbaz, fatanabaz, lo77o wogabaz, qanaatizebaz, ammanobaz, lo77o oochabaz, il7ants hyaarizebaz, cinccitumobaz, fete fetera kacinttizebaz, uturabaz, ashkketitsibaz, melle asalla afa firddizebaz, ceeqinttize baz, dandda7abaz, woosa bazin ammanze asi oochchodes koshshizebaz ubba bilii xaafida.</para>
  <para style="ip">Yayqooba kiita, ammano yessi ammano oochalla feeshize hyanotitsi qonccizi beezane.</para>
  <para style="iot">Aafe Qofuntsi</para>
  <para style="io1">Saritse <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">Ammanon cinccatitsi <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Dahitumon durtumon <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">Faatana <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">Xoozze qaala sissin oochalla feeshe <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">Asi asappa dummuze koshshosanno <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Ammanon oocha <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">Il7antsi naagebaz <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">Ammanze asin hyanna alamito <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Dumma dumma zore <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>Xoozzen Laatstse Yesuus Kiristtoosa aro, Yayqooba, sa7a ubba lalinttide taphpho lam77i kochchuntsis kiittide kiita.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Maato. 13:55</ref>; <ref loc="MRK 6:3">Mar. 6:3</ref>; <ref loc="ACT 15:13">Hawa. 15:13</ref>; <ref loc="GAL 1:19">Gala. 1:19</ref></char></note></para>
  <para style="p" vid="JAS 1:1">Saro yinttis maaqqe.<verse eid="JAS 1:1"/></para>
  <para style="s1">Ammanon cinccatitsin</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>Ta ishuntso, yinttana dumma dumma faatana yellize wode yin lo77o baz denggide fana kumutsi ufayssara ekkote. <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>Yin ammantto fattanizanna dandda7a yinttis inggizanno erane. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>Yin wurssutsi yellodes dandda7iko akko facce baayzin folon kumutsi maaqqade fana oochchiza maaqqe. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>Yinttappa oodesin cinccatitsi dhabiko Xooz woosso. Ees ingginttoda. Xoozii ooden borikaayzara ubbuntsis keehatitsara inggize Xoozii. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>Yezin E woossize wode so7ikaayzara ammanora Xooz woosso. So7ize ooden baqo urqqin en7ize abba gaar. <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>Lam77i qofa yezen fa ogite eqqoosse ooden Laatstsappa akkon denggoda ga7i qoppipe.<verse eid="JAS 1:7-8"/></para>
  <para style="s1">Daha asin dure asi</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>Ammanze dahuntsi, Xoozii unttana dhoqi oochchize wode ufaytto. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>Mahi ammanze duruntsi Xoozii unttana ziqqii oochchize wode ufaytto. Dure asuntsi fudhe fana dhaboda.<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa. 40:6-7</ref></char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Awa fa mishara kezane maato melizane, fudhitan gufane; E lo77otitsitan dhabane. Yinnii fana, dure asuntsi fa oochite cer lalitera dhaboda.<verse eid="JAS 1:11"/></para>
  <para style="s1">As yellize faatana</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>Madha gamii aadhidannip suuba, Xoozii fana siiqizuntsis inggoda ga7i qaala gelide de7o worqqa zawude ekkode gisho madhite genccize asi anjjinttidaya. <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>Ooden fattaninttize wode «Tana Xoozii fattanane» gayppe. Xoozii iitara fattaninttoos; mahi E ooden fattanoos. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>Yezin fettii fettii asi fa iita amora gochinttize woden ciminttize wode fattaninttane. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>Yinnippa suuba, amotitsi wodaxii nagara yelane; mahi nagara diccii hyayqo yelane.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>Ta siiqo ishuntso, ciminttippete. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>Lo77o imon kumutsi anjjo ubba saloppan salo foo7ito medhdhide Xoozze adeppa ye7ine. Xoozii dasho fana ubba wode laaminttoos. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>Nuunii, E medhdhide bazis anggis maaqqade fana nuna turii qaalara qoppii yelida.<verse eid="JAS 1:18"/></para>
  <para style="s1">Sissin oochan</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>Ta siiqo ishuntso, hyanno qoppote. Asi ubba si7odes elliso, yezin ohodesin hyanqodes ellisippe. <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>As hyanqo Xoozze koyze xillotitsi ko7oos. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>Yinnii gisho, tuna oochan iita baz ubba hyaasii, Xoozii yin wozintte tukkide yin shemppito ashshodes dandda7ize qaala aadatitsara ekkote.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>Yezin Xoozze qaala oochalla feeshotep attin yin ommite balinttitera si7izuntsana xalaala maaqqippete. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>Qaala si7i oochchoose asi, E fa sintto masttootera be7ize atstse fana. <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>E fa sintto bi7i qitane, yezin E akko aazizako ellisii botane. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>Yezin ooden nagara arotitsappa kessize folo higge qoppii bi7i, miinggi eqqize, si7idanno botikaayzara oochalla feeshize atstsay, fa oocha ubbanne anjjinttoda.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>Fa il7antsito naagikaayzara goynane gaaze atstsay fana cimmane; E goynita hyarii. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>Xoozze Aday tiino bore baayze geeshi goyno hyanno: inddan aden baayze na7untsanan azinii baayzutsana un madhite maadden alame tunappa fana naage.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">Asi shaakkippe</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>Ta ishuntso, yin nu bonchcho Laatstse Yesuus Kiristtoosa ammanzebaz maaqqiko, as sino bi7i as bonchchippete. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>Aazizes, worqqa migiddo aatsii, lo77o ma7o ma77ide dure asi yin shiiqite yi7ida. Mahi curqqa ma7o ma77ide daha asin yi7ida. <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>Lo77o ma7o ma77ide atstsa yin aatsii bonchchii, «Ne hyanne lo77ize oydalla betto» ga7i, mahi daha atstsa, «Ne yeyga eqqo woy hyanne ta tohiti kale sa7ite betto» gaane. <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>Yeezin, yin, yin gidda shaako medhdhizuntsana iita qofara yeze daynnuntsi fana baane?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>Ta siiqo ishuntso, si7ote. Ammanora dure maaqqade fanan fana siiqizuntsis inggoda gayde salo ka7itumo laattode gaar hyanna sa7ite yeze dahuntsana Xoozii doorikaane? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>Yezin yin dahuntsana toochane. Yinttana un7itsizuntsin firdda keetstsa gochchizuntsi duruntsana baane? Yinttana daynna tiino gochchizuntsi unttana baane? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>Yin xeeginttize yinna lo77o suntsito cazhizuntsi unttana baane?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>Yezin Geeshi Maxaafite, «As ubba nena ne kadhizanni gaara kadho» ga7intti xaafinttide Xoozze ka7itumo higgito yin foliko lo77o oochchane.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>Yezin yin as sino bi7i bonchchiko, nagara oochchane; mahi higgen yinttana higge mentside asi fana firddoda. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>Ooden Xoozze higge ubbappa feta mentsii, attidanno ubba naagiko ubbanno mentside fana faydinttane. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«Laammippe» gayde Laatstse, mahi «Wodhippe» gayda. Yezin ne laammanxi ashshii wodhide baz maaqqiko, higge mentsida.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Keze 20:13-14</ref>; <ref loc="DEU 5:17-18">Mahe 5:17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>Arotitsappa kessize higge tiino firdda ekkodes yeze asi fana ohinttoten oochchote. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>As maaroosa oonan Xoozii maarikaayzara firddoda. Yezin maarotitsi firdda gamane.<verse eid="JAS 2:13"/></para>
  <para style="s1">Ammanon oocha</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>Ta ishuntso, yinttappa fettii asi taas ammano yene ga7i, fa ammantto oochara beezanxiko eza akko maaddode? E ammantta eza ashshodes dandda7ane? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>Aazizes fettii ishay woy fettii mishita kallidhikon unttis mu7izebaz dhabiko, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>yinttappa fettii asi unttago, «Saro qitote! Yinttana tama kaazhote! Mizhote!» ga7i, koshshize baz unttis ingganxiko unttana akko maadde? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>Yinnii gisho, oocha baayze ammano fa ommite hyayqqidaya.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>Yezin fettii asi, «Nees ammano yene; mahi taas oocha yene. Neenii ne ammantto ne oochitippa shagii tana beezo; taanin ta ammantto ta oochite nena beessada» gawuda. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>Neenii, fettii Xoozii yezanno ammanane; yinna lo77o. Tuna ayyaanuntsin ammanane; zhashimora goqane. <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>Naate boozayo! Ammano oochappa shaakkintti maaddoosanno erodes koyane? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>Nu aday Abrahama, fa na7a Yisaaqa zharsho bessalla gaddide wode fa oochitira xillikaane?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medho 22:1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>E ammanttan E oochita wolla timinttidanno bo7osa? E ammantta E oochite folinttida. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>Geeshi Maxaafta, «Abrahama Xooz ammanida. Xoozii yinno ees xillotitsi mahi faydida» gaydanna folinttida. Mahi E Xoozze igina ga7intti xeeginttida.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medho 15:6</ref>; <ref loc="2CH 20:7">2 Zeena 20:7</ref>; <ref loc="ISA 41:8">Isa. 41:8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>Asi ammano xalaalara maaqqikaayzin oochara xillizanno be7ine.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>Yinnii fana, olale hyanttize Ra7aaba Isra7eeleppa kiitinttiduntsana mokkii melle ogera unttana moyzide wode fa oochite xillikaane?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iya. 2:1-21</ref></char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>Shemppo shaakkinttide asho hyayqo maaqqizannifana, oocha shaakkinttide ammanon hyayqo.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">Il7ants naage</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>Ta ishuntso, yinttappa gaamuntsi asttamaare maaqqippe. Nu, asttamaaruntsi melluntsappa aadhize firdda ekkodanno yin erane. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>Nu ubbanna gaama bazara balinttane. Fa ohite balinttoosse ooden fanatitsito naagodes dandda7ize folo asi. <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>Faara nuus kiitinttode fana lugaame barssii nu koyze bessa ubba kanttane. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>Markkabe akko fana damma maaqqii damma baqora urqqinttikon, eza izhize atstse fa koyze zala mahi eerats izhize bazara izhii qitane. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>Yinnii fana il7antsii galla giddappa eerats maaqqikon gaama damma baza ceeqinttane.</para>
  <para style="p" vid="JAS 3:5">Eerats tama damma gurdde michchane. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>Il7antsii tama fana. Il7antsii nu ashitii gidda iitara kumide alame; galla ubba tunizane. Gaannameppa kezize tama gaar nu de7o yestto ubba michchane. Fa ommitisin gaanname michinttoda. <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>Xootsin landdan, sazar gochunttizuntsin abba yeze medhinttide baz ubba asi ahane; unttin aqane. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>Yezin ooden il7antsi hyaarodes dandda7ikaaya. Il7antsii wodhize marze kumide aqoosse iita medho. <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>Nu il7antsite, nu, Laatstsin ade maaqqide nu Xoozza galatane. Mahi eera Xooz aazii medhinttide asi baaddane. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>Fettii doonappa galatan baadditsin kezane. Ta ishuntso, yinnii gaara yi7ades beezoos.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medho 1:26</ref></char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Hyaatsi aafe fettii doochappa mal77ize hyaatstsin canggize hyaatstsi goggodes dandda7ane? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>Ta ishuntso, belese minxa shamahe aafodes dandda7ane? Woy woyne minxa belese minxa aafe aafodes dandda7ane? Camo hyaatsi aafeppa mal77o hyaatsi kessades dandda7oos.<verse eid="JAS 3:12"/></para>
  <para style="s1">Salo cinccatitsin sa7a cinccatitsin</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>Yin gidda cinccan akaakize oode? Fa lo77o yestto, ashkketitsaran cinccatitsaran yezii beezo. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>Yezin yin wozintte camo qanaaten fana kadhizebaz yeziko yinna cinccatitsite ceeqinttippete; turilla afa worddidhdhippete. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>Yinnii gaarize cinccatitsi saloppa yi7idebaz maaqqikaayzin yinna asappa, alameppa, xalaheppa. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>Qanaaten fana kadhizebaz yeze bessa kachchin iita oocha ubba yene. <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>Yezin saloppa ye7ize cinccatitsi ubbappa tiino geeshi. Mahi sarotitsi, lo77otitsi, kiitintte, as maare, lo77o aafe kumidaya, asi shagoosan cubbotitsi baayzaya. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>Sarotitsi kadhizuntsi sarotitsi budi xillotitsi aafe maxane.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">Hyanna alamito kadhippete</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>Olan kachchi yin gidda abappa ye7e? Un ye7izanna yin ashto hyaarodes olinttize yin asho amoppa baane? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>Yin amudhdhane, yezin denggoos; yinnii gisho, as wodhane. Mintstsii koyane, yezin denggodes dandda7oos; yinnii gisho, kacinttanen olinttane. Yin Xooz woossoose gisho koyze baz denggoos. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>Yin woossane, yezin denggoos. Yin asho amuto folodes wobbo oge woossize gisho denggoos. <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>Yin, ammaninttoosuntso! Hyanna alamito kadhize Xoozara morkke maaqqizanno erosa? Hyanna alamttira igintsodes koyze ooden Xoozara morkke. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>Geeshi Maxaafite, «Xoozii nu gidda yessade fana gaddide Ayyaanize, nu ees buzo maaqqade fana damma amudhdhane» gaydanna cer gaydebaz aazane? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>Yezin Geeshi Maxaafite, «Xoozii uturtizuntsana ixxane, yezin fana toochizuntsis aadho keehatitsi inggane» yagaaze gisho Xoozii aadho keehatitsi gaantsi inggane.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Aazi. 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>Yinnii gisho, Xoozis aqote; Xalahera ixinttote; E yinttappa hyaakkoda. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>Xoozago shiiqote; E yinttago shiiqoda. Yin, nagaranchchuntso, yin kushito meecote; lam77i qofa yezuntso, yin wozintto geeshote. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>Azzanote, yeekkoten afuxxote. Yin miichita yeefora, yin ufayssita azzanora laamintto. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>Laatstse tiino yinttanatitsito ziqii yiizote; E yinttana dhoqi dhoqi yiissada.<verse eid="JAS 4:10"/></para>
  <para style="s1">Firddippete</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>Ta ishuntso, fetay fetaya cazhippen zigirippete. Fa isha zigirizay eella afa firddize higge zigiranen higgella afa firddane. Ne higgella afa firddiko higgella afa firddizaya maaqqanep attin higge folizaya maaqqoos. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>Higge inggizen firddize Xoozza xalaala. Ashshodesin dhabsodes dandda7ize eza. Yeezin, asalla afa firddizay ne oode?<verse eid="JAS 4:12"/></para>
  <para style="s1">Ceeqinttippete</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>Yin, «Nu hyayno woy wontta seko katama woy hyankko katama qitoda; ize fettii bere gam7oda; zal77i tirfisada» yaga7izuntso, si7ote.<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">Aazi. 27:1</ref></char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>Wontta akko hyanod yezako yin eroos. Yin de7ita wayadyezako erize oode? Yin eerats wode benttii dhabize qayqayo fana. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>Yinno ashshii, «Laatstsi gayko nuunii yessada; hyanno woy yinno oochchoda» gawudes beezane. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>Yezin yin hyatte uturanen ceeqinttane. Yinnii gaarize ceeqo ubba iita.<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>Yinnii gisho, lo77o baz oochchodes eriite oochchoose atstses yinna nagara.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">Duruntsis ingginttide zore</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Yin, duruntso, yinttalla afa iita madha ye7ize gisho uukoten yeekkoten. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>Yin qoltta buuqqida; yin afulttan bilara mu7inttida.<note caller="-" style="x"><char style="xo" closed="false">5:2-3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Maato. 6:19</ref></char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>Yin worqqitan yin birtta birida. Yinna biridanna yinttalla afa markka maaqqada. E yin ashtto tama gaar michchoda. Yin hyanna hyal7ide qammite yinttis qolo shiishida. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>Yin gadite oochchii feezhide asunts kira birtto ciggikaaya. Yinna yinttalla afa ukkane. Yentsi katstsa maxize asunts wuysita wolqqara yeze Laatstse hyayte sinttida.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Mahe 24:14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Hyanna sa7ite yin saza xalaalas qoppii, giigin yezida. Shufos giiginttide hyarsifana yinttana dhiikkida. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>Yinttara eqinttodes dandda7oose xillo asalla afa firddane; ezan wodhida.<verse eid="JAS 5:6"/></para>
  <para style="s1">Genccen woosan</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>Ta ishuntso, Laatstsi yo7ode wontsis genccote. Sa7a oochchize torchche iran seete ira yo7ode wontsis gencci al77o katstsa naagii wayzi yeltsi ekkizako qoppote. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>Ye sa7a oochchizay fana yinttin genccote. Laatstse ye7ita ukkide gisho ufayssara naagote.<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>Ta ishuntso, Xoozii yinttalla afa firddaame gaar fetay fetella afa zuuzinggippete. Firddizay furtsa eqqida. <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>Ta ishuntso, Laatstse suntsite ohide nabuntsi madha dandda7ara ekkii aazize maaqqiduntsana bo7ote. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>Dandda7ara gencciduntsana nuunii anjjinttiduntsana gaane. Iyyooba wayzi genccezako yin si7ida. Laatstsi wurssutsite eza wayzi maaddezako bi7ida. E maarotitsin yiqsimo kumide Laatstsi maaqqide gisho yinno oochchida.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyo. 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Maz. 103:8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>Yezin ubbappa tiino, ta ishuntso, saloran maaqqin woy sa7aran maaqqin woy melle akko bazaran caaqqippete. Xoozze firdda yin gelaame fana yin ohita yee maaqqiko, «Yee» ga7ote; ade maaqqiko, «Ade» ga7ote.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Maato. 5:34-37</ref></char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>Yin gidda madha ekkize ooden yeziko Xooz woosso. Ufayttize ooden yeziko galatara yexxo. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>Yinttappa hyargginttize ooden yeziko woosa keetstsi cimuntsana xeego. Un Laatstse suntsite zayte tizhii ees Xooz woosso.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Maato. 5:34-37</ref></char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>Ammanora woosside woosita hyargginttiza fatstsoda. Laatstsi eza, hyarggitippa dentsoda; E nagara oochchidebaz maaqqikon Laatstsi eza maaroda. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>Yinnii gisho, yin faxode gaar yin nagartto fetay fetes faaxoten fete fetes woossote. Xillo as woosita damman wolqqaama oocha oochchane. <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>Eeliyaasa nu fana asi. Ira sa7alla bukkaame gaar mintsii Xooz woossin hyaydzdzii beren izipun agina sa7alla ira bukkikaaya.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kat. 17:1</ref>; <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>Mahi E Xooz woossin saloppa ira bukkida; sa7itan katstsa inggida.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 Kat. 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>Ta ishuntso, yinttappa ooden turii ogeppa balinttiko, melle asi eza turigo mahiko, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>nagaranchchiza E iita ogitippa mahize ooden, E shemppito hyayqoppa ashshizayan E gaama nagarttis maarotitsi inggizanno ero.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Aazi. 10:12</ref>; <ref loc="1PE 4:8">1 Phex. 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
