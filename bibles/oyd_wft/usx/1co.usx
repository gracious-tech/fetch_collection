<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Oyda New Testament</book>
  <para style="h">1 Qoronttoosa</para>
  <para style="toc1">Phawuloosa Qoronttoosa Asuntsis Xaafide Tiino Kiita</para>
  <para style="toc2">1 Qoronttoosa</para>
  <para style="toc3">1 Qoro.</para>
  <para style="mt1">Phawuloosa Qoronttoosa Asuntsis</para>
  <para style="mt2">Xaafide Tiino Kiita</para>
  <para style="imt1">Gele</para>
  <para style="ip">Phawuloosa Qoronttoosa asuntsis xaafide tiino kiita xaafinttidanna, Phawuloosa Qoronttoosa gidda esside woosa keetsite ammanze as de7ite ammanolla afa denddize madhitis mahe immades. Ye wode Qoronttoosa katama sa7alla yeze dumma dumma asuntsi yeze Girike awurajja kataman Akkaya ga7inttize Roome waanna katama. Yinna katamita zal77era erinttide, wogara miinggide, dumma dumma iita de7or dalggidannon haymaanote gaamatitsara erinttidanno.</para>
  <para style="ip">Hawaarize mintsii ohodes koydanna, yinna woosa keetsiti gidda medhinttide shaakkinttebaz, dumma dumma iita de7obaz, olale baz, ekken gelebaz, woosa keetsi wogabaz, Geeshi Ayyaana inggize bazin hyayqoppa denddo baz. Wonggele hyanna oocito wayzi mahod yezako hawaarize mintsii ohine.</para>
  <para style="ip">Siiqo Xoozii fa asuntsis inggide aadho imotitsi maaqqidanno zofane taphpho hyaydzdzii beezane; mahi zofane taphpho hyaydzdzii hyay maxaafize gidda gaama erinttide kifile ga7intti erinttane.</para>
  <para style="iot">Aafe Qofuntsi</para>
  <para style="io1">Gele qofa <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">Ammanze asuntsi gidda medhinttide shaakkintte <char style="ior"><ref loc="1CO 1:9-4:21">1:9—4:21</ref> </char></para>
  <para style="io1">Olale hyantten kara as yessi woga <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">Ammanze asin ammanoose asi <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">Woosa keetstsin goyno woga <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">Kiristtoosa dendditon ammanze as denddito <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">Yihuda gidda yeze madhidhide ammanze asuntsis maade <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">Xaatsi qofa <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>Xoozze qofara Yesuus Kiristtoosa hawaare maaqqades xeeginttide Phawuloosan, nu ishe Sostenisa, <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>Qoronttoosa yeze Xoozze woosa keetsitis, Yesuus Kiristtoosara geezhiduntsis unttisin nuus Laatstsi maaqqide nu Laatstse Yesuus Kiristtoosa suntsito ubba bessa xeegize ubbuntsis;<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">Hawa. 18:1</ref></char></note><verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>Xoozze, nu Adeppan Laatstse Yesuus Kiristtoosappa yinttis aadho keehatitsin sarotitsi maaqqe.<verse eid="1CO 1:3"/></para>
  <para style="s1">Phawuloosa Xooz galatane</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>Xoozii Kiristtoos Yesuusa baggara yinttis inggide aadho keehatitsiti gisho taanii ubba wode Xoozza galatane. <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>Ubba bazara oheran maaqqin eratitsara Kiristtoosara duridhdhida. <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>Nu Kiristtoosa baz ohide markkatitsita yin gidda minggida. <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>Yinnii gisho, yin nu Laatstse Yesuus Kiristtoosa qonccitsito naagitera yeziko akko ayyaana imon yinttis faccoos. <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>Ezin mahi nu Laatstse Yesuus Kiristtoosa lam7intsa ye7ite bore baayzuntsana maaqqii wurssutsi yellode gaar yinttana miintsoda. <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>Fa Na7aygo, nu Laatstse Yesuus Kiristtoosa fettetitsago xeegide Xoozze ammaninttidaya.<verse eid="1CO 1:9"/></para>
  <para style="s1">Ammanze asunts gidda medhinttide shaakkintte</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>Ta ishuntso, yin gidda shaakkintte yezippe; ubbuntsi giigii fettii wozinaran fettii qofara maaqqii yezote, yaga7i nu Laatstse Yesuus Kiristtoosa suntsite ta yinttana woossane. <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>Ta ishuntso, Qelo7e kara asuntsi yin gidda lalle yezanno taas ohida. <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>Yinttappa fete fete, «Taanii Phawuloosas; taanii Aphiloosas; taanii Phexiroosas; taanii Kiristtoosas» yagaane.<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">Hawa. 18:24</ref></char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>Yeezin Kiristtoosa shaakkinttidaane? Yin gisho masqalalla afa suxunttide Phawuloosaane? Woy yin Phawuloosa suntsite xammaqinttidane?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>Taanii Qarisphoosappan Gaayoosappan melle yinttappa ooden xammaqikaayze gisho Xooz galatane.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">Hawa. 18:8</ref>; <ref loc="ACT 19:29">Hawa. 19:29</ref>; <ref loc="ROM 16:23">Rome 16:23</ref></char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>Yinnii gisho, ooden yinttana ta suntsite xammaqinttida ga7i ohodes dandda7ize baaya. <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>[Mahi Isxifaanosa kara asuntsana ta xammaqida, gujjii melle oona xammaqezakon tiirinttoos.]<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 Qoro. 16:15</ref></char></note> <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>Kiristtoosa tana kiittidanna Wonggele ohode gaarap attin xammaqode gaar baaya. Kiristtoosa masqala cer maaqqaame gaar Wonggele qaala ta tamaarssizanna as cinccatitsi qaalara baaya.<verse eid="1CO 1:17"/></para>
  <para style="s1">Kiristtoosa Xoozze cinccatitsin wolqqa</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>Masqala qaaltta dhabizuntsis eeyatitsi, yezin nuus attiduntsis Xoozze wolqqa. <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>Geeshi Maxaafite,</para>
  <para style="q1" vid="1CO 1:19">«Taanii cinccuntsi cinccatitsito dhabssoda;</para>
  <para style="q2" vid="1CO 1:19">eruntsi eratitsito dhabisoda»</para>
  <para style="m" vid="1CO 1:19">yagaane.<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">Isa. 29:14</ref></char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>Yeezin, cincca aba yene? Higge asttamaarize aba yene? Woy hyanna alame eruntsi aba yene? Xoozii hyanna alame cinccatitsito eeyatitsi mahikaane?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">Iyo. 12:17</ref>; <ref loc="ISA 19:12">Isa. 19:12</ref>; <ref loc="ISA 33:18">33:18</ref>; <ref loc="ISA 44:25">44:25</ref></char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>Hyanna alame asuntsi fa cinccatitsara Xoozza eraame fana Xoozii fa cinccatitsara gorddida; yezin eeyatitsara faydinttize, nu ohize Wonggele qaala ammaniduntsii attode gaar Xoozze lo77o qofa maaqqida. <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>Ayhuduntsi kille baz be7ades koyane; mahi Girikuntsi cinccatitsi koyane. <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>Yezin nuunii masqalalla afa suxunttide Kiristtoosa sabbakane. Yinna Ayhuduntsis dhube; mahi Girikuntsis eeyatitsi. <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>Yezin Xoozii xeeginttiduntsis, Ayhude maaqqin, Girike maaqqin Kiristtoosa Xoozze wolqqan Xoozze cinccatitsi. <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>Xoozze eeyatitsita as cinccatitsappa aadhane; mahi Xoozze labitsita as xaalatitsappa aadhane.<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>Yikke, ta ishuntso, yin xeegitsito bo7ote; asi fana cincca maaqqide gaamuntsi, wolqqara yeze gaamuntsi, shuuma maaqqide gaamuntsi xeeginttikaaya. <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>Yezin Xoozii cinccuntsana yeellisades alame yeze eeyuntsana doorida; mahi miintsuntsana yeellisades alame yeze labitsuntsana doorida. <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>Xoozii hyanna alamite damma ga7inttidebaz dhabssodes, hyanna alamite labitsuntsana, leqqinttiduntsana akko hyanosuntsana doorida. <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>Ooden Xoozze tiino ceeqqinttippe. Yezin ceeqinttize ooden Xoozalla ceqintto. <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>Yezin Xoozii yinttis Kiristtoos Yesuusara fettetitsa yessade gaar yiizida. E nuus Xoozappa cinccatitsi, xillotitsi, geeshshatitsin wozon maaqqida. <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>Yinnii gisho, Geeshi Maxaafite, «Ceeqinttize ooden Laatstsara ceeqqo» yagayda.<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">Er. 9:24</ref></char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">Kiristtoosa suxuntto</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>Ta ishuntso, taanii yinttago Xoozze qaala yinttis ohitera yi7ize wode qaalaran cinccatitsara aadhii yi7ikaaya. <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>Taanii yinttara yeze wode Yesuus Kiristtoosa ezin masqalalla afa suxunttideppa melle erodes koyoos ga7i ta qofa accida. <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>Ta yinttara yeze wode labitsimora, zhashimoran gaama goqera yezida.<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">Hawa. 18:9</ref></char></note> <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>Ta ohitan ta sabbakita sa7a eraran doona cinccatitsara maaqqikaayzin Xoozze Geeshi Ayyaana wolqqa qonccitsite. <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>Yinnan, yin ammantta Xoozze wolqqara fattin as cinccatitsalla kataame fana.<verse eid="1CO 2:5"/></para>
  <para style="s1">Xoozze cinccatitsi</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>Ayyaana de7o dicciduntsis nuunii cinccatitsi qaalara ohine. Yezin yinna cinccatitsita, hyanna alame cinccatitsito woy dhabodes yeze hyanna alamito ahizunts cinccatitsito baaya. <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>Yezin nuunii ohize cinccatitsita, gaama wodeppa tiino Xoozii nu bonchchos giigizidannon aachintti yeze Xoozze cinccatitsito. <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>Hyanna alamtto ahizuntsappa ooden hyanna cinccatitsito erikaaya. Un erizebaz maaqqezako, bonchcho Laatstse masqalalla afa suxxaama yeshsha. <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>Yezin Geeshi Maxaafite,</para>
  <para style="q1" vid="1CO 2:9">«Aafe bi7ikaayze baz,</para>
  <para style="q2" vid="1CO 2:9">hyaye si7ikaayzebaz,</para>
  <para style="q2" vid="1CO 2:9">wozina qoppikaayzebaz,</para>
  <para style="q2" vid="1CO 2:9">Xoozii fana siiqizuntsis giigizida» yagaane.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">Isa. 64:4</ref></char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>Nuus Xoozii Geeshi Ayyaana baggara qonccizida. Geeshi Ayyaana melle atto yezin Xoozze gaatsi qofa ubba qurichchane. <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>As gidda yeze baz atstse gidda yeze ayyaanza fattin as baz ooden eroos. Yinnii gaar, Xoozze baz Xoozze Ayyaana fattin ooden eroos. <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>Xoozii nuus hyarii inggidanno nu erode gaar Xoozze Ayyaana ekkida fattin hyanna alamtti ayyaana ekkikaaya.<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>Yinnii gisho nuunii ayyaana qofa, ayyaana asuntsana tamaarssizanna as cinccatitsara maaqqikaayzin Xoozze Ayyaana inggize cinccatitsara. <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>Yezin Geeshi Ayyaana baayze asi Xoozze Ayyaanappa ingginttize imo ekkodes dandda7oos. Yinna ees eeyatitsi; ubbanna Geeshi Ayyaanara qurichinttizanni gisho E erodes dandda7oos. <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>Yezin Geeshi Ayyaana yeze asi ubba baz qurichchane, yezin eza ooden qurichchoos. <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>Geeshi Maxaafite,</para>
  <para style="q1" vid="1CO 2:16">«Laatstse wozintto erize oode?</para>
  <para style="q2" vid="1CO 2:16">eza zorodes dandda7ize oode?»</para>
  <para style="m" vid="1CO 2:16">ga7intti xaafinttidanni fana. Yezin nuus Kiristtoosa wozina yene.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">Isa. 40:13</ref></char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">Xoozis oochizuntsana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>Ta ishuntso, yin Kiristtoosa gidda hyaga zhoogan ammanoose asuntsi fana yeze gisho taanii ayyaanabaz yinttis ohodes dandda7ikaaya. <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>Yin mintsi katstsa maades dandda7ikaayze gisho taanii yinttana maatsi shichchida; hyatten maaqqiko yin dandda7ikaaya.<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">Ibr. 5:12-13</ref></char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>Hyatten hyaga yin asho qofara yene. Yin gidda yeze qanaaten lallen yin ammanoose asi fana yezanno erisosaane? Yin oochchizanna asho qofara yeze asi fana baane? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>Yinttappa fete, «Taanii Phawuloosas» melluntsi mahi, «Taanii Aphiloosas» gayko, Xooz Ayyaana baayze asi fana baane?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 Qoro. 1:12</ref></char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>Yeezin, Aphiloosa oode? Phawuloosa oode? Un yin ammanode fana oochchide Xoozze oochanchcho. Xoozii fetes fetes inggide oochiti gaar oochchane. <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>Ta tukkida; Aphiloosa hyaatsi ushshida, yezin dichchide Xoozii.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">Hawa. 18:4-11</ref>, <ref loc="ACT 18:24-28">24-28</ref></char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>Yinnii gisho, dichchide Xoozza fattin tukkizen hyaatsi ushshizen akkon baaya. <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>Tukkizen hyaatsi ushshizen wolla fetto, yezin fete fete fa oochchii labbide gaar anjjo ekkoda. <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>Nuunii Xoozis oochchize gade; Xoozze keetstsa eera wolla oochchizuntsana. <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>Xoozii taas inggide aadho keehatitsiti gaar yiillar yeze anaaxe fana baasa olida. Melle asi eella afa keexxane. Yezin eella afa keexxize ooden wayzi keexizako, faas naagintto. <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>Fettii tohe olinttide baasappa melle ooden baasa olodes dandda7oos. Ezin Yesuus Kiristtoosa. <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>Yezin hyay baasizella afa ooden worqqara woy birara maaqqin, al77o shuchchara woy minxara maaqqin, maatara woy hyawulera keexxiko, <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>fete fete ye baasizella afa akkora keexizako firdda wode tamar qonccoda. <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>Ooden ye baasizella afa keexxide keetsita tamar mu7inttanxiko, fa anjjito ekkoda. <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>Yezin oode oochitan tamar mu7inttiko, qohinttoda; yezin, E fa ommite attodan tamappa attizaya maaqqoda.<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>Yin Xoozze keetsi maaqqidannon Xoozze Ayyaana yinttara yezanno erosaane?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 Qoro. 6:19</ref>; <ref loc="2CO 6:16">2 Qoro. 6:16</ref></char></note> <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>Ooden Xoozze keetsito laliko, Xoozin eza laloda. Xoozze keetsita geeshi; yinnan yinttana.<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>Ooden fana cimmippe. Hyanna alamite cincca fana aazizide yeziko Xoozze turii cinccito denggode fana ooden cinccatitsito eeyatitsi mahi faydo. <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>Hyanna alamiti cinccatitsita Xoozze tiino eeyatitsi. Geeshi Maxaafite,</para>
  <para style="q1" vid="1CO 3:19">«Xoozii cinccuntsana un gene oochitira aykkida» yagayda.<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">Iyo. 5:13</ref></char></note><verse eid="1CO 3:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="1CO 3:20"/>Mahi, «Cinccuntsi qoftta maaddoose baz maaqqidanno Laatstsi erane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">Maz. 94:11</ref></char></note><verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>Yinnii gisho, ubba bazi yinttis maaqqade gisho ooden asalla ceeqinttippe. <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>Phawuloosa maaqqin, Aphiloosa maaqqin Phexiroosa maaqqin, hyanna alamito maaqqin, de7o maaqqin, hyayqo maaqqin, yezaya maaqqin, tiinoppa ye7odaya maaqqin, ubbanna yinttis. <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>Yinttin Kiristtoosas; Kiristtoosan Xoozis.<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">Kiristtoosa hawaaruntsana</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>Yinnii fana asi nuna Kiristtoosa aro fana Xoozze gaatsi qofa qonccizi tamaarssize hyadara ingginttide asi fana mahi faydo. <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>Tamaarssizuntsi Laatstses ammaninttiduntsana maaqqades beezane. <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>Yezin yin woy melluntsi taalla firddiko, taas akkon baaya. Melle atto, taanin taalla afa firddodes dandda7oos. <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>Ta erzanni gaar maaqqiko ta wozintta taalla firddoos, yezin yinnan ta xillotitsito beezoos. Taalla afa firddoday Laatstsa xalaala. <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>Yinnii gisho, wode yellikaayzin, Laatstsii yi7ikaayzin oodellan firddifete. E dhuma aachinttide baz foo7o kessoda; as wozina aachinttide qofa qonccissada. Ye wode fete fete Xoozzeppa beezize galata ekkoda.<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>Ta ishuntso, yinttana maaddo ga7i tanan Aphiloosan aazize mahi ta ohida. Yinno ta yiizidanna, «Xaafinttidannippa aadhifite» yagaaze zortto yin nuuppa tamaarode fana. Yinnii gisho, ooden feta nashshii hyankkaya leqqodes beezoos. <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>Neenii melluntsappa akkora aadhe? Neenii ekkikaayzebaz akko yeze? Yeezin, neenii ubba baz melle asappa ekkidebaz maaqqiko, ekkikaayze asi fana akkos ceeqintte?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>Hyatte yin mizhida. Hyatte yin duridhdhida. Nu shaakkintti yin xalaala ka7itida. Yin turo ka7itezako, nuunin yinttara ka7itod yeshsha. <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>Xoozii nuna hawaaruntsana, hyayqo firddinttide asi fana as ubbappa nuna suub aatsida taas aazane. Nuunii hyanna alamitis, kiitanchchosin asisin kaas baz maaqqida.<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>Nuunii Kiristtoosa gisho eeya maaqqida, yezin yin Kiristtoosa gidda cinccuntsana maaqqida. Nuunii labitsi, yezin yin mintsi maaqqida. Yin bonchchinttida, yezin nuunii toochinttida. <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>Hyayno yellodes nu naydhdhane, baridhdhane, kallidhane, hyadhinttane; yessade keetsi dhabin madha be7ine. <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>Nuunii nu kushite oochchii aqane. Nuna asi cazhodera anjjane; nuna bay7ize wode dandda7ane.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">Hawa. 18:3</ref></char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>Un nuna cazhize woden nu suntsito iissize wode aadatitsara mahane. Nu hyano yellodes alame buuren alla olinttide fixo maaqqida.<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>Taanii yinno xaafidanna, ta kadhize na7unts fana, yinttana zorodes xaafida fattin yeellisades baaya. <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>Kiristtoosa gidda yinttana dichchize gaama kaalitsizunts yezikon, yinttis gaama aduntsi baaya. Ta yinttana Kiristtoos Yesuusa Wonggelera yelida. <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>Yikke, yin tana aazote ga7i yinttana woossane.<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 Qoro. 11:1</ref>; <ref loc="PHP 3:17">Filph. 3:17</ref></char></note> <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>Yinnii gisho, ammantsizen, ta kadhize, Laatstse baggara ta na7a maaqqide, Ximotiyoosa yinttago kiittida. E dumma dumma bessa yeze woosa keetstsa ta tamaarsside, Kiristtoosa Yesuusa gidda yeze ta ogito yinttana qofissada.<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>Taanii yinttago ye7aame fana aazin, uturara kumide fettii fettii asuntsi yene. <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>Yezin Laatstsii gayko, ukkera taanii yinttago yo7oda. Ye wode taanii uturanchchunts ohito xalaala baayzin un wolqqiton erodes koyane. <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>Xoozze ka7itumo wolqqara fattin ohera baaya. <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>Taanii yinttago gufera yo7onene woy siiqoran aadatits ayyaanara yo7one? Yin aayya doorete?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">Ammanze as gidda yeze yeellize oocha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>Yin gidda olale hyantta yezanna zigirinttane. Yinnii fana yeze olale hyantta melle atto yezin, ammanoose asuntsin oochchoos. Yin gidda fa aday machchitira tunide asi yene.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">Mahe 22:30</ref></char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>Yinne yin azzanodesin yeellidhodes beezane, yezin yin utirida. Yinnii gaar borsizebaz oochchide atstsa yin giddappa kessodes beezoso?<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>Taanii ashora yinttara yezanxikon ayyaanara ta yinttara yene. Taanii yinttara yeze asi fana yii7i yinnii gaarize oocha oochchide atstsella firddida. <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>Nu Laatstse Yesuus Kiristtoosa suntsite yin shiiqize wode taanii ayyaanara yinttara yessada. Yinne Laatstse Yesuus Kiristtoosa wolqqa yinttara maaqqada. <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>Ye atstse nagara ashita<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fqa" closed="false">Nagara asho: </char><char style="ft" closed="false">Nagara medho woy nagara asatits. </char></note> dhabii, E ayyaanize Laatstse Yesuusa firdda wode attode fana E Xalahes aadhii inggintto.<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>Yin ceeqita lo77o baaya. Eerats irshsho buka ubba dentsizanno erosaane?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">Gala. 5:9</ref></char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>Yin hyatte irshsho baayze buka maaqqade gaar, nagara irshsho yinttappa kessote. Nu Faasiga duro maaqqide Kiristtoosa zharshinttida.<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">Keze 12:5</ref></char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>Yinnii gisho, genen iitatitsi yeze irshshora maaqqikaayzin turetitsin geeshshatitsi yeze boorara nu baalito bonchchoda.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">Keze 13:7</ref>; <ref loc="DEU 16:3">Mahe 16:3</ref></char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>Ta tiino xaafide kiitite yin olale asuntsara yellinttaame gaar yinttis ohida. <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>Yinno gaazanna hyanna alamite yeze olale hyanttizuntsana woy zhaaridhizuntsara woy kaystizuntsara woy eeqa goynizuntsara mulo yellinttippete ga7e baaya. Yinno maaqqiko, hyanna alamttippa yin kessades beezane yeshsha. <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>Yezin ammanane ga7ite olale hyanttizuntsara woy zhaaridhizuntsara woy eeqa goynizuntsara woy cazhizuntsara woy matsnttizuntsara woy kaystizuntsara yellinttippete ga7i yinttis ohine. Yentses gaarize asara melle atto yezin, katstsan mu7ippete.<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>Woosa keetstsappa balera yezuntsalla afa firddodes tana akko madhe? Woosa keetsite yezuntsalla afa yin firddosaane? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>Yezin balera yezuntsalla afa Xoozii firddoda. Yinna iita baz oochchize atstsa yin giddappa kessote.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">Mahe 13:5</ref>; <ref loc="DEU 17:7">17:7</ref></char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">Ammanze asunts gidda yeze mooto</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>Yin giddappa fete fetera mooto yeziko, yinno ammanze as tiino firddinttodanno ashshii ammanoose as tiino firddinttodes wayzi qite? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>Geeshshuntsi alamella firddodanno yin eroso? Yeezin, yin alamella firddizebaz maaqqiko, hyannii fana eeratsbaz firddodes wayzi dandda7oso? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>Nuunii kiitanchcholla firddodanno erosaane? Yeezin, hyanna sa7a yessi bazalla afa firddodanna yinttana wayzi game? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>Yeezin, yinnii fana mooto yin gidda medhinttiko, woosa keetstsa leqinttide asunts tiino firddinttodes wayzi kanggete? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>Taanii yinttana yeellisades yinno gaane. Yin gidda kacinttide asuntsana giigisades dandda7ize akaakize asi baa? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>Yeezin, fettii ammanzay hyankkay ammanzaya firdda keetstsa ammanoose as tiino mootodes beezane?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>Yikke, yin fete feta kasasii mootizanna yinna yinttis lo77o baaya. Yinnippa aadhii yin qohinttizakon ciminttizako lo77oso? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>Yezin yinttii wol gidda ammanzuntsi fete feta qohanen cimmane.<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>Genuntsi Xoozze ka7itumo gelaamanno yin erosaane? Yinttana cimmippete; olale hyanttizuntsi woy eeqa goynizuntsi woy qayxizuntsi woy dhiiratsi dhiiratsara woy7izuntsi, <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>woy kayisttizuntsi woy zharidhizuntsi woy matsinttizuntsi woy cazhizuntsi woy bonqizuntsi Xoozze ka7itumo geloos. <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>Yinttappa fettii fettii asuntsi tiino yinnii gaar. Yezin yin hyatte Laatstse Yesuus Kiristtoosa suntsiten Xooz Ayyaanara meeccinttida; geezhida; xillida.<verse eid="1CO 6:11"/></para>
  <para style="s1">Yin gallite Xoozi bonchchote</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>Yin, «Nu koydebaz oochchodes dandda7ane» yagaane. Yezin ubbanna yinttana maaddoos. Taanii koydebaz ubba oochchodes dandda7ane, yezin akkon tana ahoos.<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1 Qoro. 10:23</ref></char></note> <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>Yin, «Katstsa sazas; sazan katstsas» gaane. Yezin Xoozii saziton katsito dhabssodanno ta yinttis ohine. Nu gallita Laatstsis fattin olale hyanttas baaya. Laatstsin nu gallitis. <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>Xoozii Laatstsa hyayqoppa dentsidanni fana, nunan hyayqoppa fa wolqqitira dentsoda.<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>Yin asatitsita Kiristtoosa galla kifile maaqqidanno erosaane? Yeezin, taanii Kiristtoosa galla kifile maaqqidanno kanggi olale hyanttize galla maaqqade fana yiissane? Mulon koshshoos! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>Olale hyanttize atstse E yellinttize maachitira fettii asho maaqqizanno erosaane? Geeshi Maxaafite, «Un lam77untsi fettii asho maaqqada» ga7intti xaafinttida.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medho 2:24</ref></char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>Yezin Laatstsara fetto maaqqize atstse E ayyaanzera fetto maaqqane.<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>Olaleppa hyaakkote. Fettii atstse oochchize melle nagara ubba E gallitippa balera oochinttane, yezin olalize asi fa gallitilla afa nagara oochchane. <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>Yin gallita Xoozii yinttis inggidanna yinggida yeze Geeshi Ayyaana keetsi maaqqidanno erosaane? Yin yin baz baaya.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 Qoro. 3:16</ref>; <ref loc="2CO 6:16">2 Qoro. 6:16</ref></char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>Xoozii yinttana wagar wonggida. Yinnii gisho, yin gallite Xooz bonchchote.<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">Ekken gele bazi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>Yin taas xaafide kiittis mahita hyanno. Fettii asi maacho bochchikaayzar yeziko lo77o. <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>Yezin olaleppa attodes fetes fetes machcha yesse; mahi fettis fettis azinii yesse.<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>Azinze fa machchitis, machchitan fa azinzes koshshize baz kuntso. <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>Machchitis fa ashtilla afa iis adetits wolqqa baaya, yezin adetits wolqqa I azinzes. Yinnii fana, azinzes E ashtilla afa adetits wolqqa baaya, yezin adetits wolqqa machchitis. <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>Yin woosara eerats wode gam7odes zorera maaqqanxiko, fete feta kayppete. Yinnii gisho yin yinttana ahodes gamin, Xalahe yinttana fattanaame gaar wolla yezote. <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>Yezin taanii yinttana zorodes hyanno gaane fattin kiita baaya. <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>Asi ubba ta gaar machcho ekkikaayzara yezako kadhane, yezin Xoozii fetes fetes inggide dumma imo yene. Fetes hyannii fana imo hyankkays yinnii fana imo yene.<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>Machcho ekkikaayzuntsisin azinii gelikaayzuntsisin mahi azinii hyayqqiduntsis taanii gaazanna, ta gaar ekkikaayzara woy gelikaayzara yezote ga7i zorane. <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>Yezin amora eexinttizannippa ekkizannan gelizanna lo77o maaqqide gisho un fana ahodes dandda7anxiko, ekkon gele.<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>Taanii ekkiduntsanan geliduntsana hyannigaara ga7i zorane; tana baayzin Laatstsii kiittane; machchita fa azinzeppa shaakkinttippe.<note caller="-" style="x"><char style="xo" closed="false">7:10-11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato. 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11-12">Mar. 10:11-12</ref>; <ref loc="LUK 16:18">Luqa. 16:18</ref></char></note> <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>Yezin shaakkinttiko melle azinii gelikaayzara faas yezo woy fa azinzera giigo. Azinze fa machchito billippe.<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>Yezin melluntsis Laatstsii baayzin taanii hyannigaara gaane. Ammanoose machcha yeze ammanze azinii yeziko, E machchita eera fettilla yessades koyko izo dakkippe. <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>Mahi ammanoose azinii yeze ammanze machcha yeziko, I azinze iira fettilla yessades koyko eeppa dakkinttippe. <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>Ammanoose azinze fa ammanze machchiti baggara geezhane; mahi ammanoose machchita fa ammanze azinze baggara geezhane. Yinna baayzako, un na7untsi tuna maaqqane, yezin hyatte un geeshi. <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>Yezin ammanoose azinze woy machchita billodes koyko billo. Ammanze machcha woy azinii yinnii gaarze bazara acinttoos. Xoozii nuna sarora yessade gaar xeegida. <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>Ammanze maachite, neenii ammanoose ne azinza ashshod yezako akko ere? Woy ammanze azinzayo, neenii ammanoose ne machchito ashshod yezako akko ere?<verse eid="1CO 7:16"/></para>
  <para style="s1">Xoozii yinttana xeegidanni gaar yezote</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>Fettii fettii as Laatstsii ees inggide imotitsite Xoozii eza xeegidanni gaar yezo. Woosa keetstsa ubba taanii tamaarsside wogita hyanno. <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>Ooden garrazinttii ammanida maaqqiko, garrazinttikaayze fana yi7ippe. Garazinttii ammanide ooden yeziko, garrazinttodes koyppe. <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>Xoozze kiitto folodes beezane fattin garrazinttin garrazinttanxi ashshin akkon maaddoos.<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>Fettii fettii asi Xoozii eza xeegize wodite yezanni fana yezo. <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>Xoozii nena xeegide wodite neenii aro? Akko baaya yinnis un77inttippe. Yezin neenii arotitsappa wallo kessades dandda7iko neeppa attippe kezo. <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>Aro maaqqii yezitera Laatstse gidda xeeginttide asi Laatstse gidda arotitsappa wallo kezida. Yinnii gaar, aro maaqqikaayzara yezitera, Laatstse gidda xeeginttide asi Kiristtoosa aro. <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>Xoozii yinttana wagar wonggide gisho as aro maaqqippete. <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>Ta ishuntso, yin fete fete xeeginttide wode yeze yestte Xoozara wolla yezote.<verse eid="1CO 7:24"/></para>
  <para style="s1">Ekkikaayzen, gelikaayze asunts bazin azinii hyayqiduntsi baz</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>Wuduruntsibaz Laatstsii tana kiittidebaz baaya. Yezin Laatstsii taas inggide maarotitsite ammaninttidaya maaqqii ta yinttana zorane. <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>Yikke, hyatte madhiti gisho ekkikaayzara woy gelikaayzara yessii taas lo77o aazane. <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>Ne machcho ekkezebaz maaqqiko, billodes koyppe. Ne machcho ekkikaayzebaz maaqqiko, ekkodes koyppe. <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>Yezin ne machcho ekkiko nagara baaya. Yinnii gaar wudurttan azinii geliko nagara baaya. Yezin ekkizen gelize asuntsis hyanna sa7ite gaama madha yeze gisho yinttii yinnippa attode gaar ta koyane.<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>Ta ishuntso, ta gaazanna hyanno; wode hyal7ida. Yikkeppa tiino machcha yeze machcho ekkikaayze gaar yezo. <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>Yeekkizuntsi yeekkoosse gaar, ufayttizuntsi ufayttoosse gaar, wonggizuntsi akkon baayzuntsi gaar fana faydo. <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>Hyanna sa7a qoltte maadinttizuntsi maadinttoosse fana yii7i yezo. Hyanna alamtti bishshita aadhoda.<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>Yin yirga baytsi yessade gaar ta kadhane. Machcho ekkikaayze Laatstsa ufayssodes koyze gisho Laatstse baz qoppane. <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>Yezin machcho ekkiday fa machchito ufayssodes koyze gisho hyanna sa7itibaz qoppane. <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>E qoftta lam77i bessa shaakkinttane. Azinii gelikaayze wudurtta fa ashiten fa shemppite geezhi Laatstsa ufayssodes koyze gisho Laatstsi baz qoppane. Yezin azinii gelidanna fa azinza ufayssodes koyze gisho sa7abaz qoppane.<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>Taanii yinno yinttis ohizanna, yin maadinttode gaar ga7i fattin yinttana un77itsodes baaya. Yezin yin qoftta shaakkinttikaayzin wogara yezii Laatstsa ufayssize baz yin oochchode gaar taanii ohine.<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>Ooden fa oocide wuduritis gelize wode aadhida ga7i izo ashshodes qoppiko, yinna mahi iis lo77o maaqqoosanna ees sinttiko, fa koydanno oochcho; un ekkon, gelon; yinne nagara baaya. <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>Yezin fettii asi un7itsizebaz dhabin, fa wozintte miinggi, fana naagii, fa oocide wudurito ekkanxi ashshodes koyko loytsida. <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>Yinnii gisho, wudurito ekkize atstse loytsida; mahi ekkoosse atstse gaama loytsida.<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>Machchita fa azinze faxa yeze wode ubba eera acinttida. Yezin I azinze hyayqqiko, fa koyde azinii gelodes dandda7ane. Maaqqoyezin, iza gelize dhiiratse ammanze as maaqqades beezane. <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>Ta qofa maaqqiko, iza gelikaayzara yeziko ufayssara yessada. Mahi taasin, taara Xoozze Ayyaana yeza aazane.<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">Eeqas zharshinttide katstsa baz</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>Eeqas zharshinttide katstsabaz maaqqiko nu ubbuntsis era yene. Eratitsi uturssane, yezin siiqo dichchane. <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>Ooden fana erane ga7i qoppiko, E hyaga erodes beezzanno erikaaya. <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>Yezin ooden Xooz kadhiko E Xoozze kale erinttidaya.<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>Yinnii gisho, eeqas zharshinttide katstsa muuze baz maaqqiko hyanna alamite Laatstsii fettii Xoozzeppa fattin melle baayze gisho eeqa fatstsoosse baz maaqqidanno nuunii erane. <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>Xooz maaqqikaayzin salon sa7an xoozii ga7intti xeeginttide gaama xoozzuntsin laatstsuntsi yezikon, <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ubba baz medhdhide, nu E baz maaqqide, fettii Xoozii, Ade, nuus yene. Ubbuntsi E baggara medhinttida, nuunin E baggara de7o denggida fettii Laatstsi, Yesuus Kiristtoosa nuus yene.<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>Yezin hyanno erize ubba baaya. Fettii fettii asuntsi eeqa goynora erinttide gisho katstsa muuze wode eeqa zharshinttidebaz mahi ekkane. Ye wode un wozintta labitsi maaqqide gisho tunane. <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>Yezin katstsa nuna Xoozara igintsoos. Nu mu7ikaayzara ashshin akkon qohinttoos; mahi mu7i dumma maadinttoos.<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>Yezin yin koydebaz mo7odes wallotitsi yinttis yezikon yinna ammanora miinggikaayzuntsana dhubbaame fana naaginttote. <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>Neenii nena era ga7i eeqa zharshinttide katstsa mo7odes eeqa keetstsa bettezin, ammanora miinggikaayze nena bi7iko yinna eza eeqas zharshinttide katstsa mo7ode gaar dentsitsosa? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>Yikke, ne eratitsiti baggara Kiristtoosa E gisho hyayqqida, ammanora miinggikaayze ne ishe, dhabida. <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>Yinnii gaar yiizii, ammanora miinggikaayze yin ishuntsana qohitte un wozintto hyarggizii Kiristtoosa qohane. <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>Yinnii gisho, katstsa ta isha dhubbize baz maaqqiko, E dhubinttaame fana asho mulon mo7oos.<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">Hawaaruntsi adetitsi wolqqa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>Taanii wallotitsa yeze asi baane? Ta hawaare baane? Taanii nu Laatstsa Yesuus Kiristtoosa bi7ika? Yin Laatstsara ta waaye aafe baane? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>Yin Laatstse baz maaqqide gisho ta melluntsis hawaare maaqqanxikon, yinttis hawaare maaqqidannis yin markka.<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>Tana hawaare baaya gaazuntsis ta inggize mahita hyanno. <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>Nu yinttappa mo7odesin ushshadesin turo nuus adetits wolqqa baa? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>Hyanizako hawaaruntsi fana, Laatstse ishuntsi fanan Phexiroosa fana, ammanze nu machchuntsana ekkii yedhdhades nuus adetits wolqqa baa? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>Woy oochchii mo7odes beezize tanan Barnnabaasan xalaala? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>Fa miishera wottaddaretitsi oochchize oode? Woy woyne tukkii, izippa aafe mo7oosse oode? Woy wude yenggittera, yinna wuditippa maatsi uzhoosse oode?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>Taanii yinno as qofa gaar gaanene? Higge yinno ga7osaane? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>Muse Higgite, «Uduma katstsa yedhdhize borize doontto accippe» ga7intti xaafinttida. Yeezin Xoozii yinno boras qoppii gaydaane?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Mahe 25:4</ref>; <ref loc="1TI 5:18">1 Ximo. 5:18</ref></char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>Xoozii yinno gaydanna nuus qoppii baane? Yee nu gishos. Wootizen, katstsa geeshizen fana yellizanno ekkoda ga7i ufayssara oochchodes beezane ga7intti turo nu gisho xaafinttida. <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>Nuunii yin gidda ayyaana budutsi budezebaz maaqqiko ashos beezzebaz nu yinttappa ekkiko, yinna damma bazone?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">Rome 15:27</ref></char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>Melluntsi yinno yinttappa ekkodes unttis adetits wolqqa yeziko, nuus unttappa aadhize adetitsi wolqqa yene.</para>
  <para style="p" vid="1CO 9:12">Yezin nuunii Kiristtoosa Wonggeles dhube maaqqaame gaar, ubbanne genccane fattin yinna adetitsi wolqqitira maadinttikaaya. <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>Xoozze keetstsa oochchize asuntsi fa katsito Xoozze keetstsappa ekkizanno erosaane? Mahi zharsho besite oochchizuntsi zharshitippa ekkizanno erosaane?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Mahe 25:4</ref>; <ref loc="1TI 5:18">1 Ximo. 5:18</ref></char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>Yinnii fana, Wonggele markkidhizuntsi yessis koshshize baz Wonggeleppa ekkode fana Laatstsii kiittida.<note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">Maato. 10:10</ref>; <ref loc="LUK 10:7">Luqa. 10:7</ref></char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>Yezin taanii hyanna adetitsi wolqqito ubba akkon maadinttikaaya. Taanii hyanno xaafidanna ta adetetsi wolqqito bonchchisades koyi baaya. Ooden ta ceeqito hyarii ashshodannippa hyayqo taas lo77o. <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>Taanii Wonggele ohizanna tana kiittide gisho fattin tana ceeqizebaz baaya. Wonggele ohanxiko, tana bade. <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>Taanii Wonggele kadhii sabbakiko taas damooze yene. Yezin taanii Wonggele kadhikaayzara kiittin sabbakizebaz maaqqiko yinno Xoozii taas hyadara inggida. <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>Yeezin, ta damoozita akko? Taanii Wonggele sabbakize wode ta adetits wolqqa maadinttikaayzara Wonggele hyarii sabbakizanna taas damooze.<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>Taanii oodesin aro maaqqoos, yezin gaamuntsana ko7odes ubbuntsis aro maaqqida. <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>Taanii Ayhuduntsi attode fana unttara unttana maaqqida. Ta ommite higgeppa oomora yezoos, yezin higgeppa oomora yezuntsi attode fana higgeppa oomora yeze asi maaqqida. <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>Xoozze higgeppa balera kezikaayzara, Kiristtoosa higgitis kiitinttite, higge baayzuntsi attode fana higge baayze asi fana maaqqida. <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>Taanii ammanora labbiduntsi attode fana labitsi maaqqida. Taanii eeratsuntsi attode fana unttar unttana maaqqida. <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>Taanii Wonggele maabara asi maaqqadesin anjjito shaakkinttodes, hyanno ubba Wonggele gisho yiizida.<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>Galgaade wotstsi ubbuntsi woxxane, yezin fete xalaala shilimaate ekkizanno erosaane? Yinnii fana yinttin shilimaatto ekkodes woxxote. <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>Galgaade as ubbuntsi ubbabazite fana ahane. Un yinno labbizanna dhabize worqqa zawude ekkodes. Yezin nuunii labbizanna medhina dhaboose worqqa zawude ekkodes. <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>Yinnii gisho, taanii qofa baayze asi fana woxxoos. Baqo zhulttize asi fana hyarii kushe dentsoos. <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>Yinnii gisho taanii melluntsis Wonggele sabbakidannippa suuba ta ommite olinttide asi maaqqaame fana ta ashito wolqqara ahi taas kiitinttode fana yiizane.<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">Eeqas goynippete</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>Ta ishuntso, taanii yin hyanno tiirode fana koyane. Nu aduntsi ubbuntsi dhonneppa yeekkara yedhdhida; ubbuntsi abba fiinggida.<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Keze 13:21-22</ref>; <ref loc="EXO 14:22-29">14:22-29</ref></char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>Un Musera wolla maaqqades dhonne giddan Abba gidda xammaqinttida. <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>Un ubbuntsi fettii ayyaana katstsa mu7ida.<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">Keze 16:35</ref></char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>Mahi ubbuntsi fettii ayyaana ushi uzhida. Un uzhiden unttana kaalliter yeze ye ayyaana lallizeppa kezzaya; ye lallizen Kiristtoosa.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">Keze 17:6</ref>; <ref loc="NUM 20:11">Faydo 20:11</ref></char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>Yezin Xoozii unttappa gaamite ufayttikaayze gisho un ahita akko baayze sa7a wodhdhii attida.<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">Faydo 14:29-30</ref></char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>Un iita baz amudhdhidanni gaar, nuunin iita baz amudhdhaame gaar yinna ubbanna nuus aazize maaqqida.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">Faydo 11:4</ref></char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>Geeshi Maxaafite, «Asuntsi mo7odesin ushshadesin bettida; mahi yexxodes denddida» ga7inttidanni gaar unttappa fete fete eeqa goynidanni gaar yin eeqa goynippete.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">Keze 32:6</ref></char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>Unttappa fete fete olalidanni gaar nu olalodes beezoos. Yinnii gisho unttappa fettii wode lam7itam hyaydzdzii mukul asi hyayqqida.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">Faydo 25:1-18</ref></char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>Unttappa fete fete Laatstsa fattani shooshara dha7intti hyayqqidanni gaar nu Laatstsa fattanodes beezoos.<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">Faydo 21:5-6</ref></char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>Unttappa fete fete zuuzinggii hyayqo ki7ize kiitanchchora dhabidanni gaara yinttin zuuzinggippete.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">Faydo 16:41-49</ref></char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>Hyanna unttalla afa yellidanna mulo nu naaginttode gaar nuus aazize maaqqida. Mahi wode wurssutsalla afa yeze nuus timirtte maaqqade gaar hyanna ubba xaafinttida.<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>Yinnii gisho, ta eqqida gaaze ooden gol7aame gaar fana naago. <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>As ubba yellize faatana fattin dumma faatana yinttana yellikaaya. Yin wolqqita dandda7izannippa aadhize faatana yin fattaninttaame gaar aatsii inggoosse Xoozze ammaininttidaya. Yinttana faatana yellize wode yinna fatantto E yinttana dandda7isada. Mahi yinna fatanttippa yin kessade ogito E giigisada.<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>Yikke, ta al77o ishuntso, eeqa goynizannippa hyaakkote. <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>Yin wozinaama as maaqqide gisho ta hyanno ohine. Taanii gaazanna turo maaqqidanno yin yin ommite firddote. <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>Nuunii Xooz galatii gishinttize anjjo xuu7ita Kiristtoosa suutsara fettetitsi yezanno baane? Mahi nuunii baxxize daabbize Kiristtoosa ashtira fettetitsi yezanno baane?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">Maato. 26:26-28</ref>; <ref loc="MRK 14:22-24">Mar. 14:22-24</ref>; <ref loc="LUK 22:19-20">Luqa. 22:19-20</ref></char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>Nuunii gaama maaqqikon daabbize fetto, nu ye fettii daabbo gishinttize gisho fettii asho.<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>Ane Isra7eele asuntsi oochchidanno qoppote. Zharshinttide zharshita muuzuntsis zharsho bessara fettetitsi baane?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">Leewe 7:6</ref></char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>Taanii akko ga7odes koyi ga7e? Eeqas zharshinttide katsita woy eeqa maaddize baz baaya. <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>Un zharshizanna Xoozis maaqqikaayzin tuna ayyaanas. Yinnii gisho, yinttis tuna ayyaanara fettetitsi yessade gaar ta koyoos.<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">Mahe 32:17</ref></char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>Yin Laatstse xuu7itippa uzhitera, mahi tuna ayyaana xuu7itippa ushshades dandda7oos. Laatstse leematippa mu7itera mahi tuna ayyaana leematippa mo7odes dandda7oos. <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>Nu yinno yiizii Laatstsa zhilissane? Nu eeppa aadhize miintstsone?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Mahe 32:21</ref></char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>Yin, «Ubba baz oochaame gaar kayzebazi baaya» gaane, yezikon ubbanna maaddoos. Yin, «Ubba baz oochaame gaar kayzebazi baaya» gaane, yezin ubbanna xaalizoos.<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1 Qoro. 6:12</ref></char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>Fettii fettii asi, melle asi maaddize baz qoppodes beezane fattin fana maaddize baz xalaala qoppipe.<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>Yin wozintte medhinttize so7ito hyaasii gabe bayzinttize asho cer mo7ote. <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>Akkos gayko, «Sa7an sa7alla yeze ubba Laatstsis.»<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">Maz. 24:1</ref></char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>Fettii ammanoose asi yinttana mokkodes koyi xeegiko hyammades koyko hyanggote. Yin wozintte so7ikaayzara yin tiino aatsidanno ubba mo7ote. <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>Yezin fettii asi, «Hyanna eeqas zharshinttidebaz» gayko, ye yinttis ohide atstse gishon yin wozintti gisho yinna katstsito mu7ippete. <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>Taanii, wozina gisho gaazanna yinno yinttis ohide atstse wozintti gisho fattin yin wozintti gisho baaya.</para>
  <para style="p" vid="1CO 10:29">Melle as wozina gisho ga7i taanii ta wallotitsalla akkos firddode? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>Taanii muuze katsitis Xooz galatii mu7iko akkos hyalide fana Xooz galatize baza oocintte?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>Yikke, yin akko mu7izako akko uzhizakon, woy akko oochchizako ubbanno Xoozze bonchchos oochchote. <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>Ayhuduntsana maaqqin Girikuntsanan maaqqin woy Xoozze woosa keetsite maaqqin oodesin dhube maaqqippete. <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>Taanii ubba wode gaamuntsi attode fana un maaddinttode oge koyane fattin tana maaddode oge koyoos.<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>Taanii Kiristtoosa aazii kaallizannifana, yinttin tana kaallote.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 Qoro. 4:16</ref>; <ref loc="PHP 3:17">Filph. 3:17</ref></char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">Goyno woga</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>Yin ubba baza tana qoppize gishon ta tamaarsside timirttito mintsii aykkide gisho ta yinttana galatane. <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>Yezin Kiristtoosa dhiiratsi ubbas omma, dhiiratsi maachis omma, mahi Xoozii Kiristtoosas omma maaqqidanno yin erode fana ta koyane. <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>Fa ommito guulunttii Xooz woossize woy tinbbite ohize dhiiratsi ubba omma maaqqide Kiristtoosa toochane. <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>Fa ommito guulunttikaayzara Xooz woossize woy tinbbite ohize maachita omma maaqqide fa azinza toochane. Fa ommito guulunttikaayze maachita fa ommito meedinttide maachiti fana.<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>Maacha fa ommito guulunttanxiko, fa ommito cuqintto. Yezin iis ommito cuqqizanna woy meedizanna borsiko fa ommito guulintto. <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>Dhiiratsi Xooz aazii Xoozze bonchcho maaqqide gisho fa ommito guulinttodes beezoos, yezin maacha dhiiratsi bonchchoos.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">Medho 1:26-27</ref></char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>Maacha dhiiratsappa medhinttida fattin dhiiratsi maachippa medhinttikaaya.<note caller="-" style="x"><char style="xo" closed="false">11:8-9 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">Medho 2:18-23</ref></char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>Maacha dhiiratsis medhinttida fattin dhiiratsi maachis medhinttikaaya. <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>Hyannii gishon kiitanchchuntsi gisho maacha faas adetits wolqqa yezanno beezize malla fa ommito guulunttodes beezane.<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>Yezin Laatstse qofara maacha dhiiratsi baayzin yezoos; dhiiratsin maacha baayzin yezoos. <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>Maacha dhiiratsappa medhinttidanni fana dhiiratsin maachippa yelinttida. Yezin ubbuntsin Xoozappa medhinttida.<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>Ane yin firddote. Maacha fa ommito guulinttikaayzara Xooz woossodes beezane? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>Dhiiratsi fa ommito dichchiko ees boriso maaqqidanno melle atto yezin medhetitsi yinttana tamaarssoso? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>Yezin maacha fa ommito dichchiko iis bonchcho baane? Maachis omma ingginttidanna iza fana kammode fana. <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>Yinnii gisho hyannilla lallodes koyze asi yeziko, nuus maaqqin woy Xoozze woosa keetsis maaqqin hyannippa melle woga baaya.<verse eid="1CO 11:16"/></para>
  <para style="s1">Laatstse kawo ekkize woga</para>
  <para style="r">(<ref loc="MAT 26:26-29">Maato. 26:26-29</ref>; <ref loc="MRK 14:22-25">Mar. 14:22-25</ref>; <ref loc="LUK 22:14-20">Luqa. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>Yin fettilla shiiqizanna lo77oos maaqqikaayzin qohes maaqqide gisho hyatte ta inggize kiitte yinttana nashshoos. <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>Ta tiino si7idannna, yin woosa keetsite shiiqize wode yin gidda shaako yezanno. Yinno ta si7idannippa baggita turo maaqqidanno ammanane. <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>Yin gidda fa oochite turii yezuntsi oona yezako erinttode gaar yin gidda shaako yessadanna attoos. <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>Yin wolla shiiqize wode yin shiiqizanna Laatstse kawo maades baaya. <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>Yin katstsa mu7ize wode fete feta naagikaayzara faasito faasito muuze gisho feta nayane hyankkay mahi matsinttane. <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>Turo yin mo7odesin ushshades yinttis keetsi baane? Woy Xoozze woosa keetsito leqqane? Dahuntsana yeellizane? Ta yinttana waago? Hyannis ta yinttana nashsho? Mulon nashshoos.<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>Taanii yinttis inggide timirttito Laatstsappa ekkida. Laatstse Yesuusa aadhii ingginttize qammite boora ekkii, <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>Xooz galatida. Boorito baxxi «Hya7ate; mo7ote. Hyanna yinttis ingginttide ta ashito. Hyanno mu7itera tana qoppote» yagayda. <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>Yinnii gaara, kawo mu7i maaqqin, ushi ekkii, «Hyanna ushita ta suutsite eqqide kille caaqo. Yin iippa uzhide wode ubba tana qoppote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Keze 24:6-8</ref>; <ref loc="JER 31:31-34">Er. 31:31-34</ref></char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>Yin hyay booriza mu7ize woden hyanna ushito uzhize wodeppa dentsi Laatstsii ye7ode wontsis E hyayqito ohoda.<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>Yinnii gisho, beezoosse ogera Laatstse boorito mu7ize woy Laatstse ushito uzhize ooden E ashiton suutsiton toochide gisho fa nagarite oocinttane. <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>Yinnii gisho asi fana fattano. Yeyzi boorito mo7o; ushitippan uzho. <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>Laatstse ashitibaz shaakkii eroosse, boortippa mu7izen ushitippa uzhize, faalla afa firdda muunen uzhane. <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>Yinnii gisho, yin gidda fa gaamuntsi labbida; hyargginttida; mahi unddenna asuntsi hyayqqida. <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>Yezin nu nuna fattanii be7ezako, nuulla afa firddinttaama yeshsha. <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>Alame firddinttize wode nu alamttira firddinttaame gaar hyatte Laatstsii nuna kaccane.<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>Yinnii gisho, ta ishuntso, Laatstse kawo maades yin shiiqize wode wol yeltsi ekkote. <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>Yin shiiqita firddas maaqqaame gaar naydhdhide ooden yeziko, fa kara mo7o.</para>
  <para style="p" vid="1CO 11:34">Attide bazito ta ize hyanggi yinttis ohoda.<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">Geeshi Ayyaana imotitsi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>Ta ishuntso, Geeshi Ayyaana imotitsibaz yin erode fana ta koyane. <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>Yin Xooz ammanoose wode doona baayze eequntsago gochinttii, yin eroosse oge hyanggidanno yin erane. <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>Xoozze Ayyaana kaalitsize asi ooden, «Yesuusa baaddintto» yaga7oos. Mahi Geeshi Ayyaana kaalitsikaayzin, ooden, «Yesuusa Laatstsii» ga7odes dandda7oosanno yin erode fana koyane.<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>Dumma dumma Ayyaana imotitsi yene, yezin imotitsito inggize Ayyaanize fetto.<note caller="-" style="x"><char style="xo" closed="false">12:4-11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">Rome 12:6-8</ref></char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>Nu Laatstses dumma dumma oocha yene, yezin Laatstse fetto. <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>Nu Laatstses oochchize dumma dumma oge yene, yezin yinna ogite as ubbara oochchize Xoozze fetto. <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>Yezin fetes fetes ingginttide imotitsito melluntsana maaddode fana Geeshi Ayyaana qonccane.<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>Geeshi Ayyaana fetes cinccatitsi kumide qaala inggane; mahi fetes eratitsi kumide qaala inggane. <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>Ye Geeshi Ayyaanize fetes ammano, hyankkays mahi fatstsize imo inggane. <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>Geeshi Ayyaana fetes kille baz oochchize imo, fetes tinbbite ohize imo inggane. Fetes ayyaanappa ayyaana shaakkii erize wolqqa, fetes dumma dumma doonara ohize imo, mahi fetes dumma dumma doonara ohinttidanno billize imo inggane. <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>Yinnii gisho hyanno ubba oochchize ye fettii Geeshi Ayyaaniza. E koyde fana fetes fetes dumma dumma imo inggane.<verse eid="1CO 12:11"/></para>
  <para style="s1">Fettii galla dumma dumma billite</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>Fettii gallite gaama billite yene, yezin yinna dumma dumma billituntsi fettii galla. Yinnii fana, Kiristtoosa dumma dumma billituntsi yeze fettii galla fana.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">Rome 12:4-5</ref></char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>Nuunii Ayhude maaqqin Girike maaqqin aro maaqqin wallo asi maaqqin, ubbuntsi fettii galla maaqqades Geeshi Ayyaanara xammaqinttida. Mahi nu ubbuntsi fettii Geeshi Ayyaana uzhida.<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>Nu gallite dumma dumma billite yene fattin fettii galla billite baaya. <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>Tohe, «Taanii kushe maaqqoosse gisho billite baaya» gayko, E yinno gayde gisho billite maaqqizanna attodaane? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>Hyaye, «Taanii aafe maaqqoosse gisho galla billite baaya» gayko, E yinno gayde gisho gallappa fettii billite maaqqizanna attodaane? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>Galla ubba aafe xalaala maaqqizako, nu akkora si7ode? Mahi galla ubba hyaye xalaala maaqqizako nu akkora singgode?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>Yezin Xoozii fa koydanni gaara, galla gidda dumma dumma billituntsana gaddida. <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>Ubbuntsi fettii billite maaqqizako galla wayzi yessade? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>Yezin billituntsi gaama maaqqikon, galla fetto.<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>Aafe kushego, «Ne taas koshshoos» ga7odes dandda7oos. Woy omma tohego, «Ne taas koshshoos» ga7odes dandda7oos. <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>Yezin labitsi aazize galla billituntsi nuus aadhii koshshane. <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>Bonchcho koshshoos ga7i nu qoppize billituntsappa bagguntsana gaama bonchchane. Mahi nu borssize nu galla billituntsana aatsii bonchchii naagane. <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>Be7adera borssoose galla billituntsis bonchcho koshshoos. Yezin Xoozii nu galla billituntsana wol yeltsi borssize billituntsis aadhize bonchcho inggida. <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>Galla billituntsi fete fetera shaako medhdhikaayzara wolis qoppode gaar mahi medhdhida. <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>Galla billituntsappa fete hyargginttiko billituntsi ubba eera hyargginttane. Galla billituntsappa fete bonchchinttiko billituntsi ubba eera ufayttane.<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>Yin ubbuntsi Kiristtoosa galla; mahi yin fete fete E billite. <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>Woosa keetsite Xoozii, tiino hawaaruntsana, lam7intsa nabuntsana, hyaydzintsa asttamaaruntsana, mahi kille baz oochchizuntsana, fatstsizuntsana, melluntsana maaddizuntsana, woosa keetstsa ahizuntsana, dumma dumma doonara ohizuntsana doorida.<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">Efe. 4:11</ref></char></note><verse eid="1CO 12:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="1CO 12:29"/>Ubbuntsi hawaare? Ubbuntsi nabe? Ubbuntsi asttamaare? Ubbuntsi kille baz oochchane? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>Ubbuntsis fatstsize imo yene? Ubbuntsi dumma dumma doonara ohine? Ubbuntsi dumma dumma doonara ohizanno billane? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>Yinnii gisho ubbappa aadhize imotitsi mintsii koyote.</para>
  <para style="p" vid="1CO 12:31">Mahi ubbappa aadhize ogito ta yinttana beessada.<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">Turii siiqo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>Taanii as qaalaran kiitanchcho qaala ohinttodes dandda7ikon, taas siiqo dhabiko, cer girize luulle fana. <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>Tinbbite ohize imotitsi taas yezikon, gaatsi qofa ubba erikon, eratitsi ubba yezikon, mahi dere dentsii melle bessa kanggize ammano taas yezikon, siiqo dhabiko, tana akkon maaddoos hyari.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato. 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">Mar. 11:23</ref></char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>Taas yeze baz ubba dahuntsis inggikon, melle atto yezin, tana tamas aatsii inggikon, siiqo dhabiko tana akkon maaddoos.<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>Siiqo dandda7a. Siiqo keeha. Siiqo qanaatoos. Siiqo ceeqinttoos. Siiqo uturtoos. <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>Siiqo beezoosse baz oochchoos. Siiqo qiiridhdhoos. Siiqo zhilidhdhoos. Siiqo fa qohito faydoos. <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>Siiqo turira ufayttane fattin worddora ufayttoos. <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>Siiqo ubba dandda7ane; ubba ammanane; lo77o baz hyanoda ga7i, ufayssara naagane; ubba genccane.<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>Siiqo wurssutsi yellodes dhaboos. Yezin tinbbite attoda; dumma dumma doonara ohinttizanna attoda; eratitsin aadhoda. <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>Nu eratitsappan eeratsito erane; tinbbiteppa baggito ohine. <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>Yezin folo maaqqide ye7ize wode folo maaqqikaayze attoda.<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>Taanii na7a yeze wode na7a gaar ohine; na7a gaar qoppane; na7a gaar qurichchane. Ta wozanttide wode na7atitsi hyanto ashshida. <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>Hyatte foo7o baayze bessa masttootera be7izannigaara be7ine, yezin ye wode nu geeshi be7ada. Hyatte ta eratitsappa eeratsi erane, yezin ye wode Xoozii tana erzanni gaar folii eroda.<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>Yikke, ammano, ufayssin siiqo, hyantsi hyaydzdzuntsi miinggi yessada. Yezin hyantsesappa aadhize siiqo.<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">Tinbbiten dumma dumma doona</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>Siiqo koyote. Ayyaana imotitsi mintsii koyote; ubbappa aatsii, tinbbite imo mintsii koyote. <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>Dumma dumma doonara ohinttize asi Xoozis ohine fattin asis ohoos. Yezin asis benttikaayze gancce qofa Ayyaana wolqqara ohize gisho ooden E ohizanno tiiroos. <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>Yezin tinbbite ohizuntsi as Ayyaanar dichchodes, mintsitsodesin mintsodes asis ohine. <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>Dumma dumma doonara ohize asi fana Ayyaanar dichchane. Yezin tinbbite ohize asi woosa keetsito Ayyaanar dichchane.<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>Yin ubbuntsi dumma dumma doonara ohinttizako ta kadhane, yezin tinbbite ohizanno aatsii kadhane. Dumma dumma doonara ohinttizanno woosa keetstsi dichchodes billize asi dhabiko, dumma dumma doonara ohinttizannifa tinbbite ohizanna aadhane.<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>Yikke ta ishuntso, taanii yinttago hyanggi qonccitsara woy eratitsara woy tinbbite ohera woy timirttera maaqqaanxi dumma dumma doonara ohinttiko yinttana akko maaddode? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>Dumma dumma yetsis fettii kochchi ootsi yeziko, suulunqe ootsin diitsi ootsi wayzi shagii erode? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>Mahi moyze oolle loytsii erinttanxiko olas giiginttode oode? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>Yinnii gaar, dumma dumma doonara yin ohizanna geeshi maaqqanxiko yin ohizanno oode erode? Yinna baqos ohize fana.<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>Alamella gaama doona yene; bilitsii baayze doona baaya. <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>Yikke fettii asi ohinttize doona taanii eranxiko E taas zaqqo maaqqane; taanin ees zaqqo maaqqane. <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>Yinnii gaar, Geeshi Ayyaana imo yin ekkodes mintsii koyzako, woosa keetstsi dichchodes ubbappa aadhize imotitsi koyote.<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>Dumma dumma doonara ohize asuntsi ohito billodes billize imotitsi ingginttode gaar Xooz woosso. <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>Taanii dumma dumma doonara Xooz woossiko, ta ayyaanze woossane, yezin ta qoftippa akkon shaakkii eroos. <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>Yeezin, ta akko oochchodes beeze? Taanii ta ayyaantte woossane; ta wozintten woossane. Taanii ta ayyaantte yexxane; ta wozintten yexxane. <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>Yinno maaqqanxiko neenii ne ayyaantte Xooz galatize wode yinna besite neenii gaazanno eroosse asi ne galatizanno waagii, «Amin77e» gawude? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>Neenii Xooz galatizanna lo77o, yezin melle asi maaddoos.<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>Ta yin ubbappa aatsii dumma dumma doonara ohizanni gisho Xooz galatane. <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>Yezin taanii woosa keetstsa melluntsana tamaarssodes dumma dumma doonara taphphi mukul qaala ohodannippa erinttize doonara ichchin qaala ohizanno kadhane.<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>Ta ishuntso, yin qofara na7a fana maaqqippete. Yin iitabazis na7a fana maaqqote fattin yin qofara wozinaamuntsana maaqqote. <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>Laatstsii, Geeshi Maxaafite,</para>
  <para style="q1" vid="1CO 14:21">«Taanii hyantsi asuntsis,</para>
  <para style="q2" vid="1CO 14:21">dumma dumma doonara ohize asin</para>
  <para style="q2" vid="1CO 14:21">zaqqo il7antsara ohize asara ohoda.</para>
  <para style="q1" vid="1CO 14:21">Yezin yinno maaqqikon tana si7oos» yagaane.<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">Isa. 28:11-12</ref></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>Yikke, dumma dumma doonara ohizanna, ammanoosse asuntsis malla maaqqane fattin ammanze asis baaya. Tinbbite ammanze asis malla maaqqane fattin ammanoosse asuntsis baaya.<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>Woosa keetstsa asuntsi fettilla shiiqize wode ubbuntsi dumma dumma doonara ohinttiko eroosse woy ammanoosse asuntsi yin shiiqite yi7i, «Hyantses zhashitane» ga7osaane? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>Yezin eroosse woy ammanoosse asuntsi woosa keetstsa ye7ize wode asuntsi tinbbite ohodera, si7iko fa nagartto tiiroda; mahi E si7ide qaaltte firddinttoda. <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>Un E wozintte geenggide qoftto qonccissada. Yinnii gaar, «Turii Xoozii yin gidda yene» yaga7i markkidhii, zuggii Xoozis goynoda.<verse eid="1CO 14:25"/></para>
  <para style="s1">Goyno woga</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>Ta ishuntso, nu akko ga7o? Yin wolla shiiqize wode fetes mazmure yene; fetes tamaarsse imotitsi yene; fetes qonccitsi yene; fetes dumma dumma doonara ohize imotitsi yene; fetes billize imotitsi yene. Yinna ubba woosa keetstsi dichchizebaz maaqqades beezane. <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>Dumma dumma doonara ohize asuntsi yeziko, lam77i woy ganggiko hyaydzdzii maaqqii tarar tarar ohodes beezane. Un ohizanno melle asi billo. <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>Yezin billize asi dhabiko, dumma dumma doonara ohize woosa keetsite si77i ga7o. Faasin fa Xoozzesin oho.<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>Tinbbite ohizuntsi lam77i woy hyaydzdzii maaqqii oho. Mahi melluntsi un gaazanno shago. <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>Yinna shiiqite yeze melle asis fettibaz qoncciko tiino ohize si77i ga7o. <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>Ubbuntsi tamaarode gaaran ubbuntsi minggode gaar tarar tarar tinbbite ohodes dandda7ane. <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>Nabunts ayyaana nabuntsis kiitinttane. <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>Geeshshuntsi woosa keetstsa ubba lammadinttidanni gaar Xoozii sarotitsi Xooz fattin wacalize Xooz baaya.<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>Maacha woosa keetstsa si77i ga7o. Muse higge gaazanni fana un aqo fattin woosa keetstsa ohodes unttis adetits wolqqa baaya. <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>Maachuntsi woosa keetstsa ohizanna borssizebaz maaqqide gisho fettibaz erodes koyko kara fa azinuntsana ooco.<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>Xoozze qaala tiino yin ki7idaane? Woy Xoozze qaala yin xalaalago yi7idaane? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>Ooden fana nabe woy fana Xoozze asi ga7i qoppiko, taanii yinttis xaafizanna Laatstse kiita maaqqidanno ero. <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>Yinnii gisho ooden ekkanxiko nuunin eza ekkoos.<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>Yinnii gisho, ta ishuntso, tinbbite ohodes mintsii amudhdhote; mahi dumma dumma doonara ohizanno kayippete. <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>Yezin ubbannan wogaran tarar maaqqe.<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">Kiristtoosa hyayqoppa denddito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>Ta ishuntso, ta yinttis markkidhide Wonggele yin ekkidanne yin ammantte E gidda eqqidanno yin qoppode gaar koyane. <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>Ta tamaarsside Wonggele mintsii aykkiko yin E gidda attoda. Yinno yi7anxiko yin ammantta hyarii maaqqada.<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>Taanii ekkide ubbappa aadhize kiita tiinidhii yinttis inggida. Yinnan, Geeshi Maxaafite gaazanni gaara, Kiristtoosa nu nagartti gisho hyayqqida;<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">Isa. 53:5-12</ref></char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>Mooginttida; Geeshi Maxaafite gaazanni gaara, hyaydzdzintsa qamma hyayqoppa denddida;<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">Maz. 16:8-10</ref>; <ref loc="MAT 12:40">Maato. 12:40</ref>; <ref loc="ACT 2:24-32">Hawa. 2:24-32</ref></char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>Phexiroosas<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="fk" closed="false">Phexiroosa: </char><char style="ft" closed="false">Ga7inttize Keefa.</char></note> benttida; Yinnippa suuba, taphpho lam77i hawaaruntsis benttida;<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">Maato. 28:16-17</ref>; <ref loc="MRK 16:14">Mar. 16:14</ref>; <ref loc="LUK 24:34">Luqa. 24:34</ref>, <ref loc="LUK 24:36">36</ref>; <ref loc="JHN 20:19">Waha. 20:19</ref></char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>Yinnippa suuba, ichchin xeetappa gaanggize asuntsis fettii tohe benttida; Unttappa aadhize baggita hyatte yellodes faxa yene, yezin eeratsuntsi hyayqqida. <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>Yinnippa suuba, Yayqoobas benttida; suubappa fa hawaaruntsis ubbuntsis benttida.<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>Mahi wurssutsite bochinttide gaar yeze taas qonccida.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">Hawa. 9:3-6</ref></char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>Taanii Yesuusa hawaaruntsi ubbappa laafa. Taanii Xoozze woosa keetstsa bay7ide gisho Yesuusa hawaare ga7intti xeeginttodes beezoosaayya.<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa. 8:3</ref></char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>Yezin Xoozze aadho keehatitsite ta hyatte yezanni gaar maaqqida; E taas inggide aadho keehatitsiti hyarii attikaaya. Taanii mellunts hawaaruntsappa aadhii labbida. Yezin taara yeze Xoozze aadho keehatitsite fattin tana baaya. <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>Yikke, tana maaqqin unttin, nu ubba tamaarssizanna yinno; yinttin yinna kiitto ammanida.<verse eid="1CO 15:11"/></para>
  <para style="s1">Hyayqoppa dendde</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>Kiristtoosa hyayqoppa denddidanno nu sabbakize wode yinttappa fete fete yeezin, wayzi, «Hyayqoppa denddo baaya» yaga7e? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>Hyayqoppa denddo baayze baz maaqqiko Kiristtoosa hyayqoppa denddikaaya ga7e. <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>Kiristtoosa hyayqoppa denddikaayze baz maaqqiko nu timirttitan maaqqin yin ammanttan hyarii. <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>Hyayqoppa denddo baayzin, nuunii Xoozii, «Kiristtoosa hyayqoppa dentsizida» yaga7i sabbakitera Xoozze worddanchcho markka maaqqida ga7e. <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>Hyayqqide asuntsi hyayqoppa denddikaayze baz maaqqiko yikke, Kiristtoosa hyayqoppa denddikaaya. <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>Kiristtoosa hyayqoppa denddoosse baz maaqqiko, yin ammantta hyarii; mahi yin hyayno yellodes yin nagarara yene. <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>Yikke, Kiristtoosa ammanii hyayqqiduntsin dhabida ga7e. <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>Nuunii hyanna alamite de7o xalaalas Kiristtoosa gidda ufayssi oochchidebaz maaqqiko, hyanna alamite yeze as ubbappa nu bazita aadhide iita.<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>Yezin Kiristtoosa hyayqqiduntsis hyayqoppa denddera anggisi maaqqii turo denddida. <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>Hyayqo fettii as baggara hyanna alamite yi7idanni gaar hyayqoppa denddon fettii as baggara yi7ida. <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>Addaama baggara as ubba hyayqqidanni gaara Kiristtoosa baggara asi ubba de7o yessada. <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>Yezin fete fete fa tarar denddoda. Kiristtoosa ubbappa tiinii denddida; yinnippa suuba, Kiristtoosa ye7ize wode eesuntsi denddoda.<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>Yinnippa suuba, Kiristtoosa ka7itumo, adetitsin wolqqa ubba dhabsi, ka7itumo Xoozze Ades inggodera wode wurssutsi ye7oda. <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>Xoozii E morkkuntsana ubba E tohitippa oomora yedhdhissade wontsis Kiristtoosa ahodes beezane.<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz. 110:1</ref></char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>Wurssutsite E dhabssodes yeze morkkizes hyayqo. <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>Geeshi Maxaafite, «Xoozii ubba baz E adetitsi wolqqappa oomora ahizane» ga7intti xaafinttida. Yezin ubba E adetitsi wolqqappa oomora ahane gaazanna, ubbabazito E adetitsi wolqqappa oomora ahide Xoozza Adaya gujjoos.<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Maz. 8:6</ref></char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>Ubba bazita Kiristtoosa adetitsi wolqqappa oomora aqidannippa suuba Xoozze Ades ubbanna maaqqade fana Kiristtoosa mahi fa ommite ubba baz Xoozis aqizida. Ye wode Xoozii fa xalaala ubba ahoda.<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>Hyayqqiduntsi denddoosse baz maaqqiko un gisho xammaqinttize asuntsis akko tirfe yeze? Hyayqqiduntsi denddoosse baz maaqqiko yeezin, akkos, asunts hyayqqiduntsi gisho xammaqintte?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>Yeezin, nuunii akkos ubba wode nuna madhas aatsii ingge? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>Ta ishuntso, ta qammite qammite hyayqos aadhii ingginttane. Yinnan, Laatstse Kiristtoos Yesuusa baggara yinttalla yeze ceeqita turo maaqqide gisho. <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>As qofa gaar maaqqiko, taanii Efesoone gidda xootsara butunttidanna tana akko maadde? Hyayqqiduntsi hyayqoppa denddoosse baz maaqqiko, «Wontta nu hyayqqize gisho hyayno maada ushshada» yagaaze asi fana maaqqane.<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">Isa. 22:13</ref></char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>Ciminttippete! Iita laggetitsi lo77o duse iissane. <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>Yin wozinttigo maaqqote. Nagara oochchippete. Yinttappa fettii fettii asuntsi Xooz eroos. Ta yinttana yeellisades yinno gaane.<verse eid="1CO 15:34"/></para>
  <para style="s1">Denddo galla</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>Fettii asi, «Hyayqqide asi wayzi denddode? Un akko fana yeze gallara ye7ode?» yaga7i oocize yezikaayzara attoos. <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>Hyay eeyizayo, neenii sa7alla budize budutsita hyayqqikaayzara doloos. <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>Neenii budize zarga maaqqin woy melle katstsa kochchi aafe fattin suubappa dolize doltto baaya. <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>Yezin Xoozii budutsis fa kadhide gaar galla inggane. Dumma dumma budutsis dumma dumma galla inggane. <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>Medho ubbas asho fetto baaya. As asho fetto; hyaars asho dumma; landda asho dumma; maaqqii molo asho dumma.<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>Salo galla yene; mahi sa7a gallan yene. Yezin salo gallas bonchchita fetto; maaqqii sa7a gallas bonchchitan dumma. <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>Awa bonchcho fetto; agina bonchcho dumma; xoolintto bonchcho dumma; fettii xoolinttize hyankay xoolinttizeppa bonchchora dummudhane.<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>Hyayqqiduntsi hyayqoppa denddize wode yinnii gaara yi7ada. Hyayqqize galla budunttane; hyayqqoose galla maaqqii denddoda. <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>Toochera budunttii, bonchchora denddoda; labitsimor budunttii, wolqqara denddoda. <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>Medhetitsi galla budunttii, ayyaana galla maaqqii denddoda. Medho galla yeziko, ayyaana galla<note caller="+" style="f"><char style="fr" closed="false">15:44 </char><char style="fk" closed="false">Ayyaana galla: </char><char style="ft" closed="false">Geeshi Ayyaana ahide woy Geeshi Ayyaana de7o inggide galla ga7inttane. </char></note> yene.<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>Yinnii gaar, Geeshi Maxaafite, «Tiino atstse, Addaama, faxa yeze medho maaqqida»<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">Medho 2:7</ref></char></note>yagayda. Yezin wurssutsi Addaama, Kiristtoosa, de7o inggize ayyaana maaqqida. <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>Yezin medhetits asi tiino yi7in, suubappa ayyaana asi yi7ida fattin ayyaana asi tiino yi7ikaaya. <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>Tiino Addaama sa7appa medhinttide sa7a asi; lam7intsa Addaama saloppa yi7ide salo asi. <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>Sa7appa medhinttiduntsi sa7appa medhinttidaya aazane. Saloppa maaqqiduntsi saloppa yi7idaya aazane. <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>Nuunii sa7appa medhinttide atstsa aazanni fana saloppa yi7ide atstsa aazoda.<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>Ta ishuntso, ta gaazanna hyanno; hyatte nu ma77ide gallita Xoozze ka7itumo gelodes dandda7oos. Wooqize gallita wooqoosse galla laattoos.<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>Ta yinttis fettii gancce qofa ohoda. Nu ubbuntsi hyayqqoos, yezin wurssutsite ubbuntsi laaminttoda; <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>Moyze oollinttize wode aafe qiphi be7ades qoppikaayzin laaminttoda. Hyayqqide asuntsi wooqoosse as maaqqii denddoda; nuunin laaminttoda.<note caller="-" style="x"><char style="xo" closed="false">15:52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 Tese. 4:15-17</ref></char></note> <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>Hyay wooqqizay wooqqoosaya, hyay hyayqqizay hyayqqoosaya ma77odes beezane.<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>Hyay wooqqize wooqqoosaya, maaqqii hyay hyayqqize hyayqqoosaya ma77ize wode Geeshi Maxaafite, «Hyayqo gaminttii qoodhinttida.<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">Isa. 25:8</ref></char></note>Gaaze qaaltta folinttoda. <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>Yinnii gaar,</para>
  <para style="q1" vid="1CO 15:55">«Hyayqo, ne gamizanna aba yene?</para>
  <para style="q2" vid="1CO 15:55">Hyayqo, ne caddize wolqqita aba yene?»<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">Hose. 13:14</ref></char></note></para>
  <para style="m" vid="1CO 15:55">gayde qaaltta folinttoda. <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>Hyayqo caddize wolqqa nagara; mahi nagara wolqqa higge. <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>Yezin nu Laatstse Yesuus Kiristtoosa baggara nuus game inggize Xoozzes galata maaqqe.<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>Yinnii gisho, ta siiqo ishuntso, en7inttanxi miinggi eqqote. Laatstse oochite yin labbizanna cer baayzanno erii ubba wode Laatstse oochito azal7ikaayzara oochchote.<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">Ammanze Asuntsis shiiqide maade miishe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>Ammanze asuntsis miishe shiishebaz Galaatiya woosa keetsis taanii kiittidanni fana yinttin oochchote.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">Rome 15:25-26</ref></char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>Miishe shiishita ta yinttago hyanggize wode maaqqaame fana fettii fettii saaminttappa tiino qamma, wogga wode wogga wode fa denggizanippa kessii fa kara shiisho. <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>Taanii ize hyanggide wode miishito Yerusalaame yeltsode fana yin dooride asuntsis dabddaabbe inggi unttana Yerusalaame kiittoda. <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>Unttara ta hyanggizanna koshshize baz maaqqiko un taara hyammades dandda7ane.<verse eid="1CO 16:4"/></para>
  <para style="s1">Phawuloosa qofa</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>Taanii Maqedooniyara aadhodes qoppide gisho ize hyanggi yinttago ye7oda.<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">Hawa. 19:21</ref></char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>Ta hyanggizanna aba maaqqikon, ta qitizanne yin tana moyzode gaar yin kale eerats wode gam7ikaayzara ashshoos. Seete aginuntsana yin kale aatsikaayzara waayi ashshoda. <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>Taanii ogera aadhitera yinttana be7ades koyoos. Laatstsii gayko, yin kale eerats wode gam7odes qoppane.<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>Yezin taanii Phenxeqosxe Ba7ale yellodes Efesoone gam77oda. <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>Taas oocha kumide dalgga furtsi bugunttida, yezin gaama olinttize morkkuntsi yene.<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">Leewe 23:15-21</ref>; <ref loc="DEU 16:9-11">Mahe 16:9-11</ref>; <ref loc="ACT 19:8-10">Hawa. 19:8-10</ref></char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>E ta gaar Laatstse oocha oochchize asi maaqqide gisho Ximotiyoosa yinttago hyanggiko, yin kale E yirggikaayzara yessade gaar yiizote.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1 Qoro. 4:17</ref></char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>Ooden eza leqqippe. E taago sarora maaqqade gaar eza maaddii moyzote. Taanii E hyankutsi ammanzuntsara maaqqadanno naagane.<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>Nu ishe Aphiloosa hyankkuntsi ammanzuntsara yinttago hyammade gaar ta eza mintsii woossane. Hyatte yinttago hyammades koykaaya, yezin eesi wottide wode yinttago hyammada.<verse eid="1CO 16:12"/></para>
  <para style="s1">Wurssutsi zoren saritse</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>Barkkote; Ammanora eqqote; xaalote; minggote. <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>Oochito ubba siiqora oochchote.<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>Ta ishuntso, Isxifaanosan E kara asuntsi Akkaya gidda un tiino ammaniduntsana maaqqidanno ammanzuntsana maaddodes fana aatsii inggidanno yin erane.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1 Qoro. 1:16</ref></char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>Yinttin un gaar asuntsisin, unttara oochara labbize ubbuntsis kiitinttode gaar ta yinttana woossane.<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>Isxifaanosa, Ferddonaxisan Akkayqoosa taago yi7idanna tana ufayssida. Yin baayze besite un yinttana maaqqii ta facito kuntsida. <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>Un yinttana ufayssidanni fana tanan ufayssida. Yinnii fana asuntsana botifete.<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>Isiya woosa keetstsa asuntsi yinttana saro gaane. Aqiilan Phirisqilan fa kara shiiqize woosa keetstsa asuntsara wolla yinttana Laatstse suntsite wozinappa sarotsida.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Hawa. 18:2</ref></char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>Ammanze ishunts ubbuntsi yinttana saro yagayda.</para>
  <para style="p" vid="1CO 16:20">Geeshi yeerintte yeerinttitera fete feta sarotsote. <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>Taanii, Phawuloosa, hyanna sarotitsito ta kushtira xaafida.<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>Laatstsa kadhoosse asi yeziko, baaddinttidaya maaqqe. Nu Laatstsayo, yo7o!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>Laatstse Yesuus Kiristtoosa aadho keehatitsita yinttara maaqqe.<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>Ta siiqita Kiristtoos Yesuusa gidda yeze yin ubbuntsara maaqqe. Amin77e.<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
