<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Oyda New Testament</book>
  <para style="h">Filmmoona</para>
  <para style="toc1">Phawuloosa Filmmoonas xaafide Kiita</para>
  <para style="toc2">Filmmoona</para>
  <para style="toc3">Filmo.</para>
  <para style="mt1">Phawuloosa Filmmoonas</para>
  <para style="mt2">Xaafide Kiita</para>
  <para style="imt1">Gele</para>
  <para style="ip">Filmmoona erinttide ammanze asi. E Qolaasiyasa woosa keetstsa asi maaqqikaayzara attoos. Filmmoonas Anasmoosa gaaze aro yene. Ye arize fa laatstseppa bettii qitide wode achi keetstsa yeze Phawuloosara yellinttida. Anasmoosa Yesuusa ammanode gaar oochchide Phawuloosa. Phawuloosa Filmmoonas xaafide kiitiza, Filmmoona suub maaqqii eego hyanggize fa arizera giigode fana qoppizane. Gujjii hyatte Anasmoosa ammanze as maaqqide gisho yikkeppa suuba ammanze ishe fana eza mokkii ekkode gaar fattin aro fana eza faydaame fana ees ohida.</para>
  <para style="iot">Aafe Qofuntsi</para>
  <para style="io1">Saritse <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">Galatan woosa <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">Phawuloosa Anasmoosa gisho Filmmoona woossida <char style="ior"><ref loc="PHM 1:8-21">8-21</ref> </char></para>
  <para style="io1">Xaatsi qofa <char style="ior"><ref loc="PHM 1:22-25">22-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Taanii Phawuloosa, Yesuus Kiristtoosa gisho achcha yezayin nu ishe Ximotiyoosa, nuura oochchize nuunii kadhize Filmmoonas, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>yinnii fana ne kara shiiqize ammanzuntsis, nu mishta Afibiyasasin nuura wolla yeze wottaddare Arkkiphaasas xaafide kiita.<note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">Qola. 4:17</ref></char></note><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Xoozze nu Adeppan nu Laatstse Yesuus Kiristtoosappa aadho keehatitsin sarotitsi yinttis maaqqe.<verse eid="PHM 1:3"/></para>
  <para style="s1">Filmmoona siiqon ammanon</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5"/>Neenii geeshshuntsana kadhizannon Laatstse Yesuusa ammanzanno taanii si7ide gisho Xoozza woossittera nena qoppize wode ubba ta Xooz galatane. <verse eid="PHM 1:4-5"/><verse number="6" style="v" sid="PHM 1:6"/>Neenii ne ammantto melluntsis shaakkizanna nuus Kiristtoos Yesuusa baggara ye7ize lo77o baz ubba erode fana taanii Xooz woossane. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Ammanzunts wozintta ne oochite shemppide gisho ta ishayo, taanii ne siiqite gaama ufayssin mintsitimo denggida.<verse eid="PHM 1:7"/></para>
  <para style="s1">Phawuloosa Anasmoosas woosside woosa</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Yinnii gisho, neenii oochchodes beezzebaz oochchode fana nena kiittodes Kiristtoosa baggara taas mintsii qofa yene. <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>Taanii, cimize Phawuloosa, Kiristtoos Yesuusas hyatten achi keetstsa yezay, siiqora nena woossane. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>Taanii achi keetstsa yezitera Kiristtoosara taas na7a maaqqide Anasmoosa gisho nena woossane.<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">Qola. 4:9</ref></char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>E zaga nena maaddoos, yezin hyatte nenan tanan turippa maaddode asi.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PHM 1:12-13"/>Taanii wozinappa kadhize Anasmoosa neego dakkida. Taanii Wonggele gisho acinttii yezin, ne gisho mahi tana maaddode fana ta kale eza ashshodes koyda. <verse eid="PHM 1:12-13"/><verse number="14" style="v" sid="PHM 1:14"/>Yezin ne qofa gaar oochchodes koydap attin neera zorinttikaayzara wolqqara akkon oochchodes koyoos.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Anasmoosa eerats wode neeppa shaakkinttide, oode erode maaqqii ubba wode neera yezikaayzara attaama. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Yikke, hyannippa suuba Anasmoosa aro baayzin aroppa E gaama aadhane. E taas akko gaar siiqo ishe! Mahi E nees asho baggaran Laatstse baggara aadhide ishe.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Yikke, neenii tana nees lagge gaazebaz maaqqiko tana mokkizannifana eza mokko. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>E nena qohide baz woy ees gale yeziko taappa ekko. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Yinna acito ta ciggada ga7i taanii, Phawuloosa, ta kushite xaafane. Neenii taas ne shemppito galidhii bettidaya taanii nena tiirissades koshshoos.<verse eid="PHM 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20"/>Ta ishayo, Laatstse baggara neeppa maade denggodes koyda. Kiristtoosa baggara tana mintsitso. <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>Taanii gaydannifa gaama ne oochchodanno erii mahi ne taas kiitinttodanno ammanii hyanno xaafane.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>Xoozii yin woosito si7i tana yinttago suub mahoda ga7i qoppize gisho taas aqize keetsi giigizo.<verse eid="PHM 1:22"/></para>
  <para style="s1">Wurssutsi saritse</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Kiristtoos Yesuusa gisho taara achcha yeze Ephafira nena saro saro gaane.<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">Qola. 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>Mahi taara wolla oochchize Marqqoosa, Arsxirokoosa, Deemasan Luqasa nena saro saro gaane.<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">Hawa. 12:12</ref>, <ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Qola. 4:10</ref>, <ref loc="COL 4:14">14</ref>; <ref loc="2TI 4:10-11">2 Ximo. 4:10-11</ref></char></note><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Laatstse Yesuus Kiristtoosa aadho keehatitsita yinttara maaqqe.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
