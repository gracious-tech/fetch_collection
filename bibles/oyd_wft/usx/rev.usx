<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Oyda New Testament</book>
  <para style="h">Wahannisa Qonccitsi</para>
  <para style="toc1">Wahannisa Qonccitsi</para>
  <para style="toc2">Wahannisa Qonccitsi</para>
  <para style="toc3">Qon.</para>
  <para style="mt1">Wahannisa Qonccitsi</para>
  <para style="imt1">Gele</para>
  <para style="ip">Wahannisa qonccitsi xaafinttidanna, ammanze asuntsi Yesuus Kiristtoosa faas Laatstsii mahi, ammanide gisho unttana baytsin waaye yellide wode. Xaafize loytsi bi7ide aafe qoftta, ammanze asis ufayssita kumutsi maaqqade gaar unttana mintsitsi, unttana yellide baytsin madha gidda fa ammantte miinggi eqqode gaar dentsitsodes.</para>
  <para style="ip">Maxaafite aadhize kifiltta gaaman kaallii kaallii qonccide qonccitsito aykkane. Yinna qonccitsita ye wode yeze asuntsis gelane, yezin melluntsis saza qofa maaqqii gam7ida. Un ohinttidannan misile aazize ohera. Hyay maxaafize gidda yeze faydita, makkize miishuntsin xootsuntsi deruntsin ayyaana medhetits aazize. Mazmure azmaachche mahi mahi zammarinttizanni fana, hyay maxaafize gidda yeze aafe qoftta dumma dumma qonccits baggara dumma dumma ogera mahi mahi shiiqida. Hyay maxaafize bilitsitis dumma dumma qofa yezikon, aafe qoftta qoncce. Yinnan, «Xoozii Laatstse Kiristtoosa baggara lam7intsoose ogera fa morkkuntsana, Xalahera gujjii, fettii tohe wurssutsi yellodes gamoda. Yinna gamtippa suuba, ees ammaninttii yezide fa bagguntsana kille salon kille sa7a anjjo laatisada» gaazanno.</para>
  <para style="iot">Aafe Qofuntsi</para>
  <para style="io1">Gele qofa <char style="ior"><ref loc="REV 1:1-8">1:1-8</ref> </char></para>
  <para style="io1">Laappun woosa keetsuntsis gidda1:9-20</para>
  <para style="io1">Laappun woosa keetsuntsis xaafinttide kiita <char style="ior"><ref loc="REV 2:1-3:22">2:1—3:22</ref> </char></para>
  <para style="io1">Araatiza, xaaxinttide maxaafizan Duriza <char style="ior"><ref loc="REV 4:1-5:14">4:1—5:14</ref> </char></para>
  <para style="io1">Laappun mahitamito <char style="ior"><ref loc="REV 6:1-8:1">6:1—8:1</ref> </char></para>
  <para style="io1">Laappun moyze <char style="ior"><ref loc="REV 8:2-11:19">8:2—11:19</ref> </char></para>
  <para style="io1">Dawan lam77i xootsuntsana <char style="ior"><ref loc="REV 12:1-13:18">12:1—13:18</ref> </char></para>
  <para style="io1">Dumma dumma qonccuntsana <char style="ior"><ref loc="REV 14:1-15:8">14:1—15:8</ref> </char></para>
  <para style="io1">Laappun Xoozze hyanqo xuu7untsana <char style="ior"><ref loc="REV 16:1-21">16:1-21</ref> </char></para>
  <para style="io1">Baabiloone gol7e, xootsizan, worddo nabizan Dabuloosa gamintte17:1—20:10</para>
  <para style="io1">Wurssutsi firdda <char style="ior"><ref loc="REV 20:11-15">20:11-15</ref> </char></para>
  <para style="io1">Kille salo, kille sa7an kille Yerusalaame <char style="ior"><ref loc="REV 21:1-22:5">21:1—22:5</ref> </char></para>
  <para style="io1">Xaatsi qofa <char style="ior"><ref loc="REV 22:6-21">22:6-21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>Ellera yi7ades yeze baz fa aruntsana beessade fana Xoozii Yesuus Kiristtoosas inggide qonccitsita hyanno. Yesuusa fa Kiitanchcho kiittii, fa arize Wahannisas qonccitsito beezida. <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>Wahannisa Xoozze qaalan, Yesuus Kiristtoosa markkatitsi bi7idannon oochchidanno ubba markkidhida. <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>Hyanna ubba yi7ades wode ukkide gisho hyanna tinbbite qaaltto nabbabize ooden anjjinttidaya; mahi hyanna qaaltto si7izuntsin xaafinttide qaaltto naagize ubbuntsi anjjinttiduntsana.<verse eid="REV 1:3"/></para>
  <para style="s1">Laappun Isiya woosa keetsunsis kiitinttide saritse</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5"/>Hyay dabddaabbiza, Wahannisappa, Isiya sa7a yeze laappun woosa keetsunsis xaafinttida. Zagan, hyatten yeze, tiinosin yo7odes yeze Xoozappa, mahi E araatize tiintte yeze laappun ayyaanutsappa, yinnii fana, hyayqoppa denddora tiino maaqqideppa, sa7a kaatuntsana ahize ammantsize markka maaqqide Yesuus Kiristtoosappa, aadho keehatitsin sarotitsi yinttis maaqqe.</para>
  <para style="p" vid="REV 1:4-5">Yesuusa nuna siiqane, mahi fa suutsitira nagara arotitsappa nuna wallo kessida.<note caller="-" style="x"><char style="xo" closed="false">1:4-5 </char><char style="xt" closed="false"><ref loc="ISA 55:4">Isa. 55:4</ref>; <ref loc="PSA 89:27">Maz. 89:27</ref>; <ref loc="EXO 3:14">Keze 3:14</ref>; <ref loc="REV 4:5">Qon. 4:5</ref></char></note> <verse eid="REV 1:4-5"/><verse number="6" style="v" sid="REV 1:6"/>Nuunii Xoozze E Adays oochchode gaar nuna ka7itumtte kahinuntsana mahida. Ees medhinappa medhina yellodes bonchchon wolqqan maaqqe. Amin77e.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Keze 19:6</ref>; <ref loc="REV 5:10">Qon. 5:10</ref></char></note><verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>Yikke, Yesuusa dhonnera yo7oda. Asi ubbuntsi melle atto yezin, eza caddide asunts ubba eza bo7oda. Sa7a yeze asi ubba E gisho yeekkoda. Yinna turo hyanoda! Amin77e.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dane. 7:13</ref>; <ref loc="MAT 24:30">Maato. 24:30</ref>; <ref loc="MRK 13:26">Mar. 13:26</ref>; <ref loc="LUK 21:27">Luqa. 21:27</ref>; <ref loc="1TH 4:17">1 Tese. 4:17</ref>; <ref loc="ZEC 12:10">Zakka. 12:10</ref>; <ref loc="JHN 19:34">Waha. 19:34</ref></char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>Zagan, hyatten yezay, tiinosin ye7ode Laatstse, Ubbappa Damma Xoozii, «Alfan Oomega tana»<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fk" closed="false">Alfan Oomega: </char><char style="ft" closed="false">Girike doonara Alfan Oomegan tiinon wurssutsi fidaaluntsana; bilitsitan tiinon wurssutsi ga7e. </char></note> yagaane Laatstsii Xoozze.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="REV 22:13">Qon. 22:13</ref>; <ref loc="EXO 3:14">Keze 3:14</ref></char></note><verse eid="REV 1:8"/></para>
  <para style="s1">Laatstse qonccits</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>Taanii, Wahannisa, yin ishay, yinttara wolla Yesuusara madha, E ka7itumtton E dandda7ito bi7ida. Taanii Xoozze qaala gishon Yesuusa baz markkidhide gisho Faximo gaaze hyaatsara teqinttide sa7a yene. <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>Laatstse qamma ta Geeshi Ayyaanara maaqqii yene; taappa suubara moyze oolle fana damma ootsi si7ida. <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>Ye ootsize tana, «Ne be7ezanno maxaafite xaafii, Isiya yeze laappun woosa keetsunsis, Efesoone, Semirneese, Pherggamoone, Tiyatiroone, Sarddeese, Filaadelfiyan Loodoqiya dakko» yagayda.<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>Taanii taas ohize ootsito be7ades suub maaqqii xomppe gaddize laappun worqqa xomppe gaddize besito bi7ida. <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>Yentsi xomppe gaddize bessuntsi gidda as na7a aazizaya bi7ida. E phargo afula fa tohito yeltsi ma77ida, worqqa dancora fa dadabito accida.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dane. 7:13</ref>; <ref loc="DAN 10:5">Dane. 10:5</ref></char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>E ommitan E omma isintsita bootsi duro isintse fana woy shachchi fana bootsi; E aafuntsii tama loxe aazane.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="DAN 7:9">Dane. 7:9</ref> </char></note><note caller="-" style="x"><char style="xo" closed="false">1:14-15 </char><char style="xt" closed="false"><ref loc="DAN 10:6">Dane. 10:6</ref></char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>E tohita tama teellii zoqqide naase meqo aazane; E ootsita damma soso hyaatsi ootse fana.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">Hiz. 1:24</ref>; <ref loc="EZK 43:2">43:2</ref></char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>E fa mizaqi kushtira laappun xoolintto aykkida. E doonttippa lam77i zallara leefinttide mashsha kezane. E sintta awara foo7ize awa aafe aazane.<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>Ta eza bi7ize wode hyayqqide asi fana yii7i E tohiti kale gol7ida. E fa mizaqi kushito taalla afa gaddii, «Zhashtippe; Tiinizen folize tana.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">Isa. 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 2:8">Qon. 2:8</ref>; <ref loc="REV 22:13">22:13</ref></char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>Taanii de7o yene; taanii hyayqqida, yezin hyaychche medhii medhinas de7o yene. Hyayqon Si7oole qulfe ta kushite yene. <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>Yikke, hyatte hyanidannon tiinoppa yi7adebaz ne bi7idanno xaafo. <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>Neenii ta mizaqi kushite bi7ide laappun xoolinttuntsanan laappun worqqa xomppe gaddize besitii bilitsitan hyanno: Laappun xoolinttuntsi laappun woosa keetsuntsi kiitanchchuntsana; laappun worqqa xomppe bessuntsi laappun woosa keetsuntsana.»<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">Efesoone woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>«Efesoone woosa keetstsa kiitanchchos hyannii gaar ga7i xaafo.</para>
  <para style="pi" vid="REV 2:1">Fa mizaqi kushite laappun xoolintto aykkidayin laappun worqqa xomppe gaddize besi giddara hyanttizay hyannigaara yagaane: <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>Taanii ne oochito, ne labbitsiton ne genccito erane. Neenii iita asuntsbaz genccodes dandda7ikaayzanno erane. Mahi hawaare maaqqikaayzara fana, hawaare gaazuntsana qurichi erii un worddanchcho maaqqin denggidanno ta erane. <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>Neenii genccida; ta suntsiti gisho madha dandda7ida; gaminttikaaya. <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>Maaqqikon, hyatte ta nena borizebaz yene; yinnan neenii tiino siiqito ashshida. <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>Yikke, ne akko gaar dhoqqa bessappa gol7ezako qoppo! Ne nagarttippa maaqqo; neenii tiino oochchize oochito oochcho. Neenii ne nagarttippa maaqqanxiko, ta neego yo7oda, ne xomppe gaddize besito iza besitippa ekkoda. <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>Hyatte ta nena nashshize fettii bazi yene; ta ixxize Niqoolawuntsi oochito neenin ixxida.<verse eid="REV 2:6"/></para>
  <para style="pi">
    <verse number="7" style="v" sid="REV 2:7"/>Geeshi Ayyaana woosa keetsunsis gaazebaz si7odes hyaye yeze ooden si7o. Gamii denddide ooden Xoozze gannate yeze de7o minxa aafeppa ma7ade fana adetits wolqqa inggoda.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medho 2:9</ref>; <ref loc="REV 22:2">Qon. 22:2</ref>; <ref loc="EZK 28:13">Hiz. 28:13</ref>; <ref loc="EZK 31:8">31:8</ref></char></note><verse eid="REV 2:7"/></para>
  <para style="s1">Semirneese woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>«Samirneesa woosa keetstsa kiitanchchos hyannigaar ga7i xaafo.</para>
  <para style="pi" vid="REV 2:8">Tiinon wurssutsize, hyayqqiden hyayqoppa denddiday hyannigaara yagaane:<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">Isa. 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 1:17">Qon. 1:17</ref>; <ref loc="REV 22:13">22:13</ref></char></note><verse eid="REV 2:8"/></para>
  <para style="pi">
    <verse number="9" style="v" sid="REV 2:9"/>Taanii ne waayton ne dahatitsiton erane; maaqqikon ne dure. Ayhude baayzara fana Ayhude gaazuntsi cazhize cashito ta erane, yezin un Xalahe maabara yene. <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>Neenii ekkodes yeze madhito zhashtippe. Xalahe yinttappa fetaya fetaya fattanodes achi keetstsa oloda; taphphi qamma yellodes yin madhidhoda. Hyayqqode wontsis ammaninttidaya maaqqo; ta nees de7o barneexa inggoda.<verse eid="REV 2:10"/></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 2:11"/>Geeshi Ayyaana woosa keetsuntsis gaazebaz si7odes hyaye yeze ooden si7o. Gamide ooden lam7intsa hyayqo qohinttoos.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 20:14">Qon. 20:14</ref>; <ref loc="REV 21:8">21:8</ref></char></note><verse eid="REV 2:11"/></para>
  <para style="s1">Pherggamoone woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>«Pherggamoone woosa keetstsa kiitanchchos hyannigaar ga7i xaafo.</para>
  <para style="pi" vid="REV 2:12">Lam77i zalara leefinttide mashsha yezay hyannigaara yagaane: <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>Taanii ne yeze besito erane; ne Xalahe araata yeze bessa yene; ta suntsito mintsii naagida. Melle atto yezin, Xalahe yeze yin katamite hyayqqide taas ammaninttide markka, Antiphaasa, yeze woden ammano kaddikaaya.<verse eid="REV 2:13"/></para>
  <para style="pi">
    <verse number="14" style="v" sid="REV 2:14"/>Maaqqikon, ta nena borize eeratsi bazi yene. Yinnan Isra7eele asuntsi eeqas zharshinttide katstsa mu7i tunode fanan gome woy7e nagara oochchode fana Baalaqa mana zoride Balaama timirttito ekkide fettii fettii asuntsi neera yene.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">Faydo 22:5</ref></char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>Yinnii fana, Niqoolawuntsi timirttito tamaarize asuntsi neera yene. <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>Yinnii gisho, neenii ne nagarttippa maaqqo. Yinna hyananxiko, ta neego ellera yi7i yentsi asuntsana ta doonttippa kezze mashshara caddoda.<verse eid="REV 2:16"/></para>
  <para style="pi">
    <verse number="17" style="v" sid="REV 2:17"/>Geeshi Ayyaana woosa keetsuntsis gaazebaz si7odes hyaye yeze ooden si7o. Gamide oodesin aachichcha yeze mannappa<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fk" closed="false">Manna: </char><char style="ft" closed="false">Isra7eele asuntsi akko baayze sa7a yedhdhize wode saloppa Xoozii unttis inggide dumma katstsa woy kiitanchcho katstsa. </char></note> inggoda. Mahi ekkize atstsap attin melle asi eroosse kille suntsi xaafinttide bootsi shuchchi ta ees inggoda.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="EXO 16:14">Keze 16:14</ref></char></note><verse eid="REV 2:17"/></para>
  <para style="s1">Tiyaxiroone woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>«Tiyatiroone woosa keetstsa kiitanchchos hyannigaar ga7i xaafo.</para>
  <para style="pi" vid="REV 2:18">Tama loxe aazize aafe yezay, mahi tamara teellide naase meqo aazize tohe yezay, Xoozze na7ay, hyannigaar gaane: <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>Taanii ne oochito, ne siiqito, ne ammantto, ne oochiton ne genccito erane. Ne tiino oochchizannippa hyatte aatsii oochchizanno erane.<verse eid="REV 2:19"/></para>
  <para style="pi">
    <verse number="20" style="v" sid="REV 2:20"/>Maaqqikon, ta nena borize fettibazi yene; fana nabe gaaze maachito, Elzaabelo, si7i ga7i bi7i akkon gaykaaya. Yinna maachita eeqas zharshinttide katstsa mu7i amudhdhode fana tunode fanan olalode fana oochchii ta aruntsana balitstsida.<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 Kat. 16:31</ref>; <ref loc="2KI 9:22">2 Kat. 9:22</ref></char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>Iza fa nagarttippa maaqqade gaar ta iis wode inggida, yezin iza maaqqades koyikaaya. <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>Un I bala ogitippa maaqqanxiko, ta izo iita hyarggella oloda; iira olale hyanttizuntsin iita waaye waayinttoda. <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>Ta I na7untsana wodhoda; mahi woosa keetstsa ubba ta asi qofan as wozina eriza maaqqidanno eroda. Ta fetes fetes yin oochitigaara oochitigaara inggoda.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="PSA 7:9">Maz. 7:9</ref>; <ref loc="JER 17:10">Er. 17:10</ref>; <ref loc="PSA 62:12">Maz. 62:12</ref></char></note> <verse eid="REV 2:23"/><verse number="24" style="v" sid="REV 2:24"/>Yezin Tiyatiroone yeze melluntsana, yinna iita timirttito ekkikaayzuntsana, «Xalahe damma gaatsi qofa» ga7inttize hyanna timirttito tamaarikaayze yinttana melle deexo toofo toossoos. <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>Maaqqoyezin, ta ye7ode wontsis yinttis yeze baz mintsii naagote.<verse eid="REV 2:25"/></para>
  <para style="pi">
    <verse number="26" style="v" sid="REV 2:26"/>Gamidesin wurssutsi yellodes taas kiitinttide oodesin ka7itumtto ahode gaar adetits wolqqa inggoda.<note caller="-" style="x"><char style="xo" closed="false">2:26-28 </char><char style="xt" closed="false"><ref loc="PSA 2:8-9">Maz. 2:8-9</ref></char></note><verse eid="REV 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="REV 2:27"/>«E unttana meqo gufera ahoda;</para>
  <para style="q2" vid="REV 2:27">sa7appa medhdhize hyayqize miishe fana tinchchoda.»</para>
  <para style="mi" vid="REV 2:27">Yinna adetits wolqqita taanii ta adeppa ekkide wolqqiti fana. <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>Mahi ta ees goolixe xoolintto inggoda. <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>Geeshi Ayyaana woosa keetsuntsis gaazebaz si7ize hyaye yeze ooden si7o.<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">Sarddeese woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>«Sarddeese woosa keetstsa kiitanchchos hyannigaara yaga7i xaafo.</para>
  <para style="pi" vid="REV 3:1">Laappun Xoozze ayyaanuntsanan laappun xoolinttuntsanan aykkiday hyannigaara yagaane: Ta ne oochito erane; suntsis faxa; yezin ne hyayqqida. <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>Barkko! Eerats attidebazin hyayqqodes ukkidebaz miintso. Ne oochita Xoozze tiino folo maaqqikaayzanno denggida. <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>Yikke, ne ekkide baziton si7idebaziton qoppii; naago; ne nagarttippa maaqqo. Ne barkkaanxiko ta kayzo gaar yo7oda; ta ayde ye7odyezako ne eroos.<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato. 24:43</ref></char></note><verse eid="REV 3:3"/></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 3:4"/>Yezin fa ma7ito qitizikaayze eerats asuntsi Sarddeese gidda yene. Unttis koshshize baz maaqqide gisho bootsi ma7o ma77i taara yedhdhada. <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>Gamide ooden unttinnigaara bootsi ma7o ma77oda. Ta E suntsito de7o maxaafeppa uccoos. Taanii ta Aday tiinon E kiitanchchuntsi tiinon ta E baz markkidhada.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Keze 32:32</ref></char></note> <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/>Geeshi Ayyaana woosa keetsuntsis gaazebaz si7ize hyaye yeze ooden si7o.<verse eid="REV 3:6"/></para>
  <para style="s1">Filaadelfiya woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>«Filaadelfiya woosa keetstsa kiitanchchos hyannigaara ga7i xaafo.</para>
  <para style="pi" vid="REV 3:7">Geeshin turo maaqqiday, Dawute qulfe fa kushite aykkiday, hyannigaara gaane: E gorddin ooden bugodes dandda7oos; mahi E bugin ooden gorddodes dandda7oos.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">Isa. 22:22</ref>; <ref loc="JOB 12:14">Iyo. 12:14</ref></char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>«Ta ne oochito erida; yikke ta ne tiino ooden gorddodes dandda7oosse bugunttide furtsi gaddida. Ne wolqqita eeratsi maaqqikon, ta qaaltto naagida; tana kaddikaaya. <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>Ayhude maaqqikaayzara fana Ayhude gaaze wordduntsanan Xalahe bagguntsana neego ko7oda ne tiino gulbbatisada. Mahi ta nena kadhizanno un erode fana yiissada.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ISA 49:23">Isa. 49:23</ref>; <ref loc="ISA 60:14">60:14</ref>; <ref loc="ISA 43:4">Isa. 43:4</ref></char></note> <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>Neenii, ‹Dandda7a asi maaqqo› ga7i ta kiittide kiitto naagide gisho kumutsi alamito fattanodes ye7ize madha woditippa taanii nena naagoda.<verse eid="REV 3:10"/></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 3:11"/>Ta ellisii yo7oda; ooden ne worqqa zawudito ekkaame gaar nees yezanno mintsii aykko. <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>Gamidaya ta Xoozze Keetsite tuusi mahoda; E ize medhinas yessada. Taanii ta Xoozze suntsiton ta Xoozze katamttii suntsito eella afa xaafoda; izan ta Xoozze kaleppa wodhdhize kille Yerusalaame. Mahi ta ta kille suntsiton eella afa xaafoda.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">Qon. 21:2</ref>; <ref loc="ISA 62:2">Isa. 62:2</ref>; <ref loc="ISA 65:15">65:15</ref></char></note> <verse eid="REV 3:12"/><verse number="13" style="v" sid="REV 3:13"/>Geeshi Ayyaana woosa keetsis gaazebaz si7ize hyaye yeze ooden si7o».<verse eid="REV 3:13"/></para>
  <para style="s1">Loodoqiya woosa keetsitis kiitinttide kiita</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>«Loodoqiya woosa keetstsa kiitanchchos hyannigaara ga7i xaafo.</para>
  <para style="pi" vid="REV 3:14">‹Amin77e› maaqqide ammaninttide turo markka maaqqiday, Xoozii medhetitsi ubbas bentte maaqqiday hyannigaara gaane:<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PRO 8:22">Aazi. 8:22</ref></char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>Taanii ne oochito ubba erane; neenii toya woy misha baaya; neenii lam77untsappa feta maaqqizako lo77o! <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>Neenii toya woy misha maaqqikaayzin bol77a maaqqide gisho ta nena ta doonttippa cuttodes yi7ine. <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>Yikke, neenii, ‹Taanii dure, qolora yene, taas akkon faccikaaya› gaane. Yezin neenii waayinttane, daha, qooqen kallidhide asi maaqqizanno nena eroos. <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>Yinnii gisho, ne duridhodes tamara geezhide worqqa, nena yeellize kallito aachchodes bootsi ma7on loytsii be7ades maaddize aafe gaalla taappa wonggi tishshade fana nena zorane.<verse eid="REV 3:18"/></para>
  <para style="pi">
    <verse number="19" style="v" sid="REV 3:19"/>Ta kadhizuntsana seeranen firccaane; yikke minggo; ne nagarttippa maaqqo.<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">Aazi. 3:12</ref>; <ref loc="HEB 12:6">Ibr. 12:6</ref></char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>Yikke, ta bale eqqii nena xeegoda. Ooden ta xeegizanno si7i, furtsito bugiko, eego geloda; eera wolla kawo mo7oda; ezin taara wolla mo7oda.<verse eid="REV 3:20"/></para>
  <para style="pi">
    <verse number="21" style="v" sid="REV 3:21"/>Ta gamii denddii ta Adera E araatalla bettidannifana gamide taara ta araatalla bettode gaar adetits wolqqa inggoda. <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/>Geeshi Ayyaana woosa keetsuntsis gaazebaz si7ize hyaye yeze ooden si7o» gayda.<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">Salo yeze goyno</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>Yinnippa suuba, taanii salo be7ize wode bugunttide furtsi bi7ida. Mahi ta tiino si7ide moyze oolle gaarze ootsi taago, «Hyankka kezo; hyannippa suuba, yi7ades yeze baz ta nena beessada» gayda. <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>Ye wode ta Ayyaana qofara yene. Yikke, salo araata bi7ida; araatizella afa fete bettidaya bi7ida.<note caller="-" style="x"><char style="xo" closed="false">4:2-3 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">Hiz. 1:26-28</ref>; <ref loc="EZK 10:1">10:1</ref></char></note> <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>Ye bettiday bishshita iyaspheden sarddiyoone gaaze al77o shuchchi fana. E araatize kantto wutii al77o shuchchi aazize zuulla yene. <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>Ye araatize kantto wutii lam7itam oyddii araatuntsi yene; unttalla afa bootsi ma7o ma77i, ommite worqqa zawude gaddide lam7itam oyddii cimuntsi bettida. <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>Araatizeppa dada, zelintsin dhoge kezane. Araatize tiintte laappun foo7ize xomppuntsi yene; un laappun Xoozze ayyaanutsana.<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">Keze 19:16</ref>; <ref loc="REV 1:4">Qon. 1:4</ref>; <ref loc="REV 8:5">Qon. 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="EZK 1:13">Hiz. 1:13</ref>; <ref loc="ZEC 4:2">Zakka. 4:2</ref></char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>Araatize tiino birille aazize foo7ize burccuqo aazze abba yene.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EZK 1:22">Hiz. 1:22</ref> </char></note><note caller="-" style="x"><char style="xo" closed="false">4:6-7 </char><char style="xt" closed="false"><ref loc="EZK 1:5-10">Hiz. 1:5-10</ref>; <ref loc="EZK 10:14">10:14</ref></char></note></para>
  <para style="p" vid="REV 4:6">Tiinoran suubara aafe kumide oyddii xoots medhetuntsi araatize kantte yene. <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>Tiino xootsize bishshita gaammo aazane; lam7antsize bora aazane; hyaydzantsize as sino aazize sino yene; mahi oydantsize firize ankko aazane. <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>Oyddii xootsuntsi ubbuntsis izipun qefe yene; un galtta ubban qefitis kattaran ommita ubba aafera kumida.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">Hiz. 1:18</ref>; <ref loc="EZK 10:12">10:12</ref>; <ref loc="ISA 6:2">Isa. 6:2</ref></char></note>Un qamman awaran ashshikaayzara,</para>
  <para style="q1" vid="REV 4:8">«Geeshshayo, geeshshayo, geeshshayo,</para>
  <para style="q2" vid="REV 4:8">Laatstsayo, Ubbappa Wolqqaama Xoozayo,</para>
  <para style="q2" vid="REV 4:8">zagan, hyatten yezayo, tiinos yo7odayo»</para>
  <para style="m" vid="REV 4:8">yagaane. <verse eid="REV 4:8"/><verse number="9" style="v" sid="REV 4:9"/>Ye xootsuntsi araatizella bettidaysin medhina yezes nashsho, bonchchon galata inggide wode <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>lam7itam oyddii cimuntsi araatizella bettidays medhina yezays tiintte zuggii goynida; fa worqqa zawuduntsana tiintte gaddii,<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>«Nu Laatstsayo, nu Xoozayo,</para>
  <para style="q2" vid="REV 4:11">neenii bonchcho, nashshon wolqqa ekkodes beezane.</para>
  <para style="q2" vid="REV 4:11">Ne ubba medhdhida;</para>
  <para style="q2" vid="REV 4:11">ubba bazi ne qoftti gaar hyanida, medhinttida»</para>
  <para style="m" vid="REV 4:11">yagayda.<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">Durizan xaaxinttide maxaafiza</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>Yinnippa suuba, araatizella afa bettiday mizaqi kushera gancceran kattara xaafinttide laappun mahitamera gorddunttide xaaxinttide maxaafe bi7ida.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="EZK 2:9">Hiz. 2:9</ref></char></note> <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>Fettii mintsi kiitanchchize fa qaaltto dhoqi yiizii, «Mahitamiza billodesin maxaafiza bugodes dandda7ize oode?» yaga7i awaajjodera bi7ida. <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>Yezin salo maaqqin sa7a woy sa7appa oomora maaqqin ye xaaxinttide maxaafiza billodesin ganccito be7ades dandda7ize ooden benttikaaya.<figure style="fig" alt="Scroll" file="HK00150B.TIF" size="span" ref="5:3">Xaaxinttide maxaafe</figure> <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>Xaatsi maxaafiza billodesin E ganccito be7ades beezize asi benttikaayze gisho ta gaama yeekkida. <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>Yeezin, cimuntsappa fetay taago, «Yeekkippe! Yikke, Yihuda bagga maaqqide gaammo, Dawute kochchi, laappun mahitamtto billodesin maxaafiza bugodes dandda7ane» gayda.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">Medho 49:9</ref>; <ref loc="ISA 11:1">Isa. 11:1</ref></char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>Yinnippa suuba, shukinttide Durizay araatizella, oyddii shemppora yeze medhetuntsisin cimuntsis gidda, eqqidaya bi7ida. Ees laappun gumurin laappun aafuntsii yene. Yentses alame ubba kiitinttide Xoozze laappun ayyaanutsana.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">Isa. 53:7</ref>; <ref loc="ZEC 4:10">Zakka. 4:10</ref></char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>Ye Durizay hyanggi, araatizella afa bettiday mizaqi kusheppa xaaxinttide maxaafiza ekkida. <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>E ye xaaxinttide maxaafiza ekkide wode oyddii shemppora yeze medhetuntsisin lam7itam oyddii cimuntsi Durize tiino gol7ida. Un fete fete diitsin geeshshuntsi woosa maaqqide ixaane kumide worqqa shaate aykkida.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">Maz. 141:2</ref></char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>Un,</para>
  <para style="q1" vid="REV 5:9">«Xaaxinttide maxaafiza ekkodes,</para>
  <para style="q2" vid="REV 5:9">mahitamiza billodes nees beezane.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">Maz. 33:3</ref>; <ref loc="PSA 98:1">98:1</ref>; <ref loc="ISA 42:10">Isa. 42:10</ref></char></note></para>
  <para style="q1" vid="REV 5:9">Akkos gayko, neenii shukinttida;</para>
  <para style="q2" vid="REV 5:9">kochchi ubbappa, dumma dumma doonappa,</para>
  <para style="q2" vid="REV 5:9">kochchuntsappa ka7itumo ubbappa</para>
  <para style="q2" vid="REV 5:9">ne suutsite Xoozis wozida.<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>Un nu Xoozze Ades oochchode fana</para>
  <para style="q2" vid="REV 5:10">unttana kahinunts ka7itumo mahida.</para>
  <para style="q1" vid="REV 5:10">Unttin sa7a ubba ka7itoda»</para>
  <para style="m" vid="REV 5:10">yaga7i kille mazmure yexxida.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Keze 19:6</ref>; <ref loc="REV 1:6">Qon. 1:6</ref></char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>Ta bi7ide wode mukul tohe mukulin taphpho mukul tohe taphpho mukul maaqqade kiitanchchuntsi ootsi si7ida. Unttin araatizes, oyddii shemppora yeze medhetuntsin, cimuntsi kantto wutida.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">Dane. 7:10</ref></char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>Yentsi kiitanchchuntsi dhoqi gayde qaalara,</para>
  <para style="q1" vid="REV 5:12">«Shukinttide Durizay wolqqa, durtumo,</para>
  <para style="q2" vid="REV 5:12">cinccatitsin mintsitimo,</para>
  <para style="q2" vid="REV 5:12">bonchcho, saban galata ekkodes beezane»</para>
  <para style="m" vid="REV 5:12">gayda.<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>Yinnippa suuba, sa7an, salo, sa7appa oomora abba gidda yeze medhetitsi ubba,</para>
  <para style="q1" vid="REV 5:13">«Araatizella afa bettidaysin Durizes,</para>
  <para style="q2" vid="REV 5:13">galata, bonchcho, saban wolqqa</para>
  <para style="q1" vid="REV 5:13">medhii medhinas maaqqe»</para>
  <para style="m" vid="REV 5:13">ga7i yexxodera si7ida.<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>Oyddii shemppora yeze medhetuntsi, «Amin77e» yagayda; mahi cimuntsi sinora zuugii goynida.<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">Mahitamuntsi buguntto</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>Durize laappun mahitamuntsappa feta bugodera bi7ida. Mahi oyddii shemppora yeze medhetuntsappa fete, dada dhoge fana ootsara, «Yo7o!» yagaazin si7ida. <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>Yikke bootsi fara bi7ida. Ye faraza toggide dongge aykkida; Ees worqqa zawude ingginttida. Ezin gamii denddidaya maaqqii gamodes kezida.<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ZEC 1:7">Zakka. 1:7</ref></char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>Mahi durize lam7intsa mahitamiza bugide wode lam7intsa shemppora yeze medhetitsize, «Yo7o!» gaazin si7ida. <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>Mahi melle suuts zoqo fara kezida. Ye faraza toggides sa7appa saro dhabssode gaaran asuntsi wol hyaasode gaar wolqqan damma mashsha ingginttida.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="ZEC 1:7">Zakka. 1:7</ref></char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>Durize hyaydzdzintsa mahitamiza bugide wode hyaydzdzintsa shemppora yeze medhetitsize, «Yo7o!» gaazin si7ida. Yikke kartsi fara bi7ida; ezin fa kushite mizaane aykkida.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">Zakka. 6:2</ref></char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>Oyddii shemppora yeze medhetunts giddappa, «Fettii wode oochas damooze, bagga kilo zarga; mahi fettii wode oochas damooze, fettii kilon bagge bangga maaqqe. Yezin zayten woyne qohippe» gaazin si7ida.<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>Durize oydintsa mahitamiza bugide wode oydintsa shemppora yeze medhetitsize, «Yo7o!» gaazin si7ida. <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>Hyaychche bootsi fara bi7ida. Ye faraza toggide suntsita hyayqo; E suubite Si7oole kaallane. Unttis sa7a oyddii kusheppa fettii kushe olara, nayera, bay7eran xootsara wodhissade fanan adetits wolqqa ingginttida.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">Hiz. 14:21</ref></char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>Durize ichchintsa mahitamiza bugide wode un Xoozze qaala ohide gishon fa markkatitsite ammaninttide gisho shukinttide asunts shemppito zharsho bestippa oomora bi7ida. <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>Un fa qaaltto dhoqi yiizii, «Ubbanno ahize Laatstsayo, geeshshayo, turizayo, sa7a yeze asalla afa ne firddoossanna nu suutsiti gisho kushe mahosanna ayde yellodesi?» gayda. <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>Un fetes fetes bootsi pharggo ma7o ingginttida. Unttin fana yii7i hyayqqodes beezize un lagguntsi faydita kumode wontsis eerats wode shemppode fana unttis ohida.<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>Durize izippuntsa mahitamiza bugide wode ta bi7ida; damma sa7a en7e hyanida. Awa aafe karttii azzano ma7o aazida. Aginan zoqqii suutsi aazida.<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="REV 11:13">Qon. 11:13</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="JER 2:10">Er. 2:10</ref></char></note> <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>Mintsi baqo baqqii belese minxa qami7e aafto gufizanni fana salo xoolinttuntsi sa7a gufida.<note caller="-" style="x"><char style="xo" closed="false">6:13-14 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa. 34:4</ref></char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>Salo xaaxinttide maxaafe fana xaaxintti hyal7ida; deren hyaatsara teqinttide sa7ita fa bestippa dhabida.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="REV 16:20">Qon. 16:20</ref></char></note> <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>Gade kaatuntsi, worzha ahizuntsi, ola kaalitsizuntsi, duruntsi, wolqqaamuntsi, aruntsin, laatstsuntsi wom7on derella afa yeze lalla wom7on aachinttida.<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 2:19">Isa. 2:19</ref></char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>Unttin deregon lallago, «Nuulla afa wodhdhote; nuna geentsote; araatizella bettiday aafitippan Durize hyanqitippa nuna aachchote.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hose. 10:8</ref>; <ref loc="LUK 23:30">Luqa. 23:30</ref></char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>Yikke, damma hyanqo qamma yellida; oonii dandda7i eqqode?» yagayda.<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="JER 2:11">Er. 2:11</ref>; <ref loc="MAL 3:2">Mil. 3:2</ref></char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">144, 000 Asuntsalla mahitame gaddinttida</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>Yinnippa suuba, oyddii kiitanchchuntsi oyddii sa7a gaxa eqqiduntsana bi7ida. Yentsi kiitanchchuntsi sa7alla woy abballa woy minxalla afa akkon baqo oyddii sa7a gaxappa baqqaame gaar teqqida.<note caller="-" style="x"><char style="xo" closed="false">7:1-2 </char><char style="xt" closed="false"><ref loc="JER 49:36">Er. 49:36</ref>; <ref loc="DAN 7:2">Dane. 7:2</ref>; <ref loc="ZEC 6:5">Zakka. 6:5</ref></char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>Mahi de7o Xoozze mahitame aykkide melle kiitanchcho awa kessi zalappa kezzaya bi7ida. Ye kiitanchchize fa qaaltto dhoqi yiizii, sa7an abba qohodes wolqqa ingginttide oyddii kiitanchchuntsana, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>xeegii, «Nuunii Xoozze arunts sinolla mahitame gaddode wontsis sa7a woy abba woy minxa qohippete» gayda.<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz. 9:4</ref></char></note><verse eid="REV 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4"/>Taanii Xoozze mahitame sinolla gaddiduntsi faydito si7ida. Isra7eele kochchi ubbap xeeti oyttam oyddii mukul asuntsis sintte mahitame gaddida.<verse eid="REV 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 7:5"/>Yihuda kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:5">Roobela kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:5">Gaade kochchappa taphpho lam77i mukul,<verse eid="REV 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 7:6"/>Aseere kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:6">Niftaaleme kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:6">Minaase kochchappa taphpho lam77i mukul,<verse eid="REV 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 7:7"/>Simoona kochchappa taphpho lam77i mukul;</para>
  <para style="q1" vid="REV 7:7">Leewe kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:7">Yisaakore kochchappa taphpho lam77i mukul,<verse eid="REV 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 7:8"/>Zaabiloone kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:8">Yoosefa kochchappa taphpho lam77i mukul,</para>
  <para style="q1" vid="REV 7:8">Biniyame kochchappa taphpho lam77i mukul,</para>
  <para style="m" vid="REV 7:8">asunts sintte mahitame gaddida.<verse eid="REV 7:8"/></para>
  <para style="s1">Bootsi ma7o ma77ide gaama asuntsana</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>Yinnippa suuba, kochchi ubbappa, ka7itumo ubbappa, worizha ubbappan dumma dumma doonappa faydo baayze gaama asuntsana bi7ida. Yentsi asuntsi bootsi pharggo ma7o ma77i, qiile hyaye fa kushite aykkii, araatize tiinon Durize tiino eqqida. <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>Un fa qaaltto dhoqi yiizii, «Atotitsi araatizella bettide nu Xoozzeppan Durizeppa ye7ine» gayda.<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>Kiitanchchuntsi ubba, araatizen, cimuntsin oyddii medhetuntsi kantto wutii eqqida. Un araatize tiino zuggii Xooz goynida.<verse eid="REV 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12"/>«Amin77e!</para>
  <para style="q2" vid="REV 7:12">Anjjo, bonchcho, cinccatitsi, galata, saba</para>
  <para style="q2" vid="REV 7:12">wolqqan, mintsitimo medhii medhinas</para>
  <para style="q2" vid="REV 7:12">nu Xoozzes maaqqe.</para>
  <para style="q2" vid="REV 7:12">Amin77e!»</para>
  <para style="m" vid="REV 7:12">gayda.<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>Cimuntsappa fetay taago, «Hyanna bootsi ma7ito ma77ide asuntsi un oode yessa? Un abappa yi7ido?» ga7i oocida.<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>Taanii mahi, «Laatstso, ne erane» gayda.</para>
  <para style="p" vid="REV 7:14">Ezin taago, «Hyantses gaama waaye waayi aadhiduntsana. Un fa ma7ito Durize suutsite meeccii bootsida.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dane. 12:1</ref>; <ref loc="MAT 24:21">Maato. 24:21</ref>; <ref loc="MRK 13:19">Mar. 13:19</ref></char></note> <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>Yinnii gisho,</para>
  <para style="q1" vid="REV 7:15">«Un Xoozze araatize tiintte</para>
  <para style="q2" vid="REV 7:15">qamman awara E keetsite oochchane.</para>
  <para style="q2" vid="REV 7:15">Mahi araatizella bettide unttis dunkkaane maaqqada.<verse eid="REV 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16"/>Yikkeppa suuba, un naydhdhaama, baridhdhaama.</para>
  <para style="q2" vid="REV 7:16">Awa woy micha unttana denggaama.<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">Isa. 49:10</ref></char></note><verse eid="REV 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17"/>Araatizella bettide Durize unttis wude adaya maaqqada.</para>
  <para style="q2" vid="REV 7:17">De7o hyaatsi aafego unttana kaalitsoda.<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">Maz. 23:1</ref>; <ref loc="EZK 34:23">Hiz. 34:23</ref>; <ref loc="PSA 23:2">Maz. 23:2</ref>; <ref loc="ISA 49:10">Isa. 49:10</ref>; <ref loc="ISA 25:8">Isa. 25:8</ref></char></note></para>
  <para style="q2" vid="REV 7:17">Xoozii un aafitippa afutsito ubba uccoda»</para>
  <para style="m" vid="REV 7:17">gayda.<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">Laappuntso mahitamize bugunttida</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>Durize laappuntso mahitame bugide wode bagga saate maaqqade fana salo si77i gayda.<verse eid="REV 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2"/>Yinnippa suuba, taanii laappun moyze ingginttide laappun kiitanchchuntsana Xoozze tiino eqqizuntsana bi7ida.<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>Ixaane cugize worqqa shaate aykkide melle kiitanchcho yi7i, zharsho bessiti kale eqqida. E araatize tiino yeze worqqa zharsho besttilla geeshshuntsi ubba woosara gujjii zharshode fana ees gaama ixaane ingginttida. <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>Ixaanize cugita geeshshunts woosara wolla Kiitanchcho kusheppa ude Xoozago kezida. <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>Yinnippa suuba, kiitanchchize ixaane cugize shaatiza ekkii, ize zharsho bestippa qaaqa tama kumutsi sa7a sulle olida. Yeyi maaqqin, dada dhogen, zelintsin sa7a en7e hyanida.<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">Leewe 16:12</ref>; <ref loc="EZK 10:2">Hiz. 10:2</ref>; <ref loc="EXO 19:16">Keze 19:16</ref>; <ref loc="REV 11:19">Qon. 11:19</ref>; <ref loc="REV 16:18">16:18</ref></char></note><verse eid="REV 8:5"/></para>
  <para style="s1">Laappun moyzuntsana</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>Yinnippa suuba, laappun kiitanchchuntsi fa moyzito oollodes giiginttida.<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>Tiino kiitanchchize fa moyza oollize wode shachcharan suutsara worqqinttide tama saloppa bukkida. Sa7a hyaydzappa fettii kushe eexinttida; minxa hyaydzappa fettii kushe eexinttida; zhil7o maata ubba eexinttida.<note caller="-" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">Keze 9:23-25</ref>; <ref loc="EZK 38:22">Hiz. 38:22</ref></char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>Lam7intsa kiitanchchize fa moyza oollide wode damma dere aazize bazi tama eexitera abba olinttida. Yeyin, abba hyaydzappa fettii kushe suutsi maaqqida. <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>Abba gidda shemppora yeze medhetitsi hyaydzappa fettii kushe hyayqqida; markkabuntsi hyaydzappa fettii kushe dhabida.<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>Hyayzintsa kiitanchchize fa moyza oollide wode xomppe fana eexize damma xoolinttize borkka hyaydzappa fettii kushellan hyaatsi aafella afa saloppa wodhdhida.<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">Isa. 14:12</ref></char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>Ye xoolinttize suntsita Camo ga7inttane. Hyaatsi hyaydzappa fettii kushsha canggizida; hyaatsita canggide gisho gaama asuntsi yinna hyaatsito uzhii hyayqqida.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="JER 9:15">Er. 9:15</ref></char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>Oydintsa kiitanchcho fa moyza oollida. Awappa, aginappan xoolunttuntsappa hyaydzappa fettii kushe guuddinttida; un foo7iti hyaydzappa fettii kushe dhumida. Awara hyaydzappa fettii kushen, qamma hyaydzappa fettii kushe dhumida.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="EZK 32:7">Hiz. 32:7</ref>; <ref loc="JOL 2:10">Iyu. 2:10</ref></char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>Fettii ankko salo dhoqi ga7i, aalodera bi7ida. Ye ankkize fa qaaltto dhoqi yiizii, «Attide hyaydzdzii kiitanchchuntsi fa moyzito oollodes yeze gisho sa7a yeze asuntsana Bade! Bade! Bade!» gaazin si7ida.<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>Yinnippa suuba, ichchintsa kiitanchchize fa moyziza oollin saloppa sulle sa7a wodhdhide xoolintto bi7ida. Ees damma doochii bugize qulfe ingginttida. <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>Xoolinttize damma doochito bugide wode dalgga cooceppa kezize cuga fana cugize yinna doochitippa kezida. Yinna doochitippa kezide cugitippa awan salon dhumida.<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">Medho 19:28</ref></char></note><verse eid="REV 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 9:3"/>Yinna cugitippa booluntsi sa7a kezida. Sa7a yeze masmasuntsis yeze wolqqa fana wolqqa booluntsis ingginttida.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 10:12">Keze 10:12</ref></char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>Xoozze mahitame sintte baayze asunts xalaalap attin sa7a yeze wolqqa woy minxa woy akko zhil7o baz maaqqin qohaame gaar booluntsis ohinttida.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz. 9:4</ref></char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>Booluntsi asmana ichchin agina yellodes faxa un7itsode fana wolqqa ingginttidap attin as wodhode fana baaya. Masmaso asi dha7in hyaazhizanni gaar boole dha7in hyaazhane. <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>Yinna qammite asi hyayqo koyoda, yezin denggoos. Un hyayqqodes amudhdhoda, yezin hyayqo unttap hyaakkoda.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">Iyo. 3:21</ref>; <ref loc="JER 8:3">Er. 8:3</ref></char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>Booluntsi olas giigii bettide faruntsana aazane. Un ommita worqqa zawude aazane; un sinttan as sino aazane.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">Iyu. 2:4</ref></char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>Un omma isintsitan maachi omma isintse fana pharggo. Un achchitan gaammo achchi aazane.<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="JOL 1:6">Iyu. 1:6</ref></char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>Unttis dadabitilla afa gaddize meqo xurure yene; un qefiti ootsita olinttodes gallabize faran fara gaare ootsi aazane.<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">Iyu. 2:5</ref></char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>Unttis masmaso unkko fana yeze unkkon dha7i hyaazhize yiishshii yene. Yinna unkkite ichchin agina asmana qohode fana adetits wolqqa ingginttida. <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>Unttana ahize kaati yene; ye kaatize damma doochiti kiitanchcho. E suntsita Ibraysxe doonara Abddoona; mahi Girike doonara Apholiyoona ga7inttane. E suntsiti bilitsitan «Dhabsiza» ga7inttane.<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>Tiino badize aadhida; yikke, melle lam77i baduntsi hyaga ye7oda.<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>Izippuntso kiitanchchize fa moyza oollida. Xoozze tiino eqqide, worqqa zharsho besite yeze oyddii gumuruntsappa fettii ootsii si7ida.<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="EXO 30:1">Keze 30:1</ref></char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>Ye ootsize moyze aykkide izippuntso kiitanchchizego, «Efiraxiise gaaze damma borkka acinttide oyddii kiitanchchuntsana billote» yagayda. <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>Sa7alla yeze asappa hyaydzdzii kushito wodhode gaar yinna saatis, yinna qammitis, yinna aginttis yinna beritis giigii bettide oyddii kiitanchchuntsi bilinttida. <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>Ola fara toggide olanchchunts faydita lam77i xeeti miloone maaqqizanno si7ida.<verse eid="REV 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17"/>Mahi ta qonccitsite faruntsanan yentsi faruntsana toggide asuntsana bi7ida. Yentsi asunts dadabite gaddize meqo xurure tama bonqo fana zoqo, yaakintte fana, kaarts salo fanan diinne fana cililo. Faruntsis ommita gaammos tiino zaltto aazane; un doonttippa tama, cugan diinne kezida. <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>Farunts doonttippa kezize tama, cugan diinne yinna hyaydzdzii hyanqite sa7a yeze asappa hyaydzappa fettii kushita hyayqqida. <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>Yentsi faruntsis wolqqita un doonttii giddan unkkite yene. Un unkkitan shooshi omma fana yene; un iira asi qohane.<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>Hyanna hyanqitippa attiduntsi fa kushe oochchitippa ashshii maaqqikaaya. Un tuna ayyaanara worqqappa, birappa, naase meqoppan shuchchappan minxappa oochinttide eeqas goynane.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="PSA 115:4">Maz. 115:4</ref></char></note>Be7ades, si7ades, yedhdhades dandda7oosse eequntsis goynizanno ashshikaaya. <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>As wodhizanno, bitizanno, olalizanno kaystizanno ashshii maarotitsi oocikaaya.<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">Kiitanchchizan eeratsi maxaafiza</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>Yinnippa suuba, ta melle mintsi kiitanchcho saloppa sa7a wodhdhodera bi7ida. E dhonne ma77ida; E ommitilla afa zuulla yene. E sintta awa fana; E tohita tama tuus fana. <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>Ye kiitanchchize bugutsi yeze fettii eerats xaaxinttide maxaafe fa kushite aykkii, fa mizaqi tohiza abballa afa, fa workkita tohiza sa7alla afa essida. <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>Dhazize gaammo fana fa qaaltto dhoqi yiizii uukkida. E wuyside wode laappun daduntsi fa dhogito sissida.<verse eid="REV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 10:4"/>Laappun daduntsi fa dhogito sisside wode ta xaafodes giiginttida. Yezin saloppa, «Laappun daduntsi ohidanno mahitamera gorddop attin xaafippe» yagaaze ootsi si7ida.<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>Yinnippa suuba, abballa afan sa7alla afa eqqide, ta bi7ide kiitanchchize, fa mizaqi kushito salo ude miccida.<note caller="-" style="x"><char style="xo" closed="false">10:5-7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Keze 20:11</ref>; <ref loc="DEU 32:40">Mahe 32:40</ref>; <ref loc="DAN 12:7">Dane. 12:7</ref>; <ref loc="AMO 3:7">Amo. 3:7</ref></char></note> <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>E salon I gidda yeze baz ubba, sa7an I gidda yeze baz ubba, abban I gidda yeze baz ubba medhdhide, medhina yeze Xoozze suntsite caaqqii, «Yikkeppa suuba, Xoozii gam7aama. <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>Yezin laappuntso kiitanchchize fa moyza oollide wode Xoozii fa aro maaqqide nabunts baggara qonccizide gaatsi qofita folinttoda» gayda.<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>Yinnippa suuba, abballa afan sa7alla afa eqqii, «E kushite bugunttii yeze xaaxinttide maxaafiza Kiitanchchize kushtippa ekko» yaga7i lam7intsa saloppa taas ohodera si7ida.<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>Taanii ye kiitanchchizego hyanggi, eerats xaaxinttide maxaafiza inggo ga7i oocida. E taago, «Ekkii mo7o; iza ne sazite canggoda, yezin ne doontte shida fana mal7oda» gayda.<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>Taanii Kiitanchchize kusheppa ye eerats xaaxinttide maxaafiza ekkii mu7ida; ta doontte shida fana mal77ida, yezin ta sazite canggida. <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>Yinnippa suuba, taago, «Neenii kochchi ubbas, worzha ubbas, dumma dumma doonara ohinttizuntsisin kaatuntsis tinbbite mahi ohodes beezane» yagayda.<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">Lam77i markkuntsana</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>Gufe aazize hyadha taas inggida, «Hyanggi Xoozze Keetsiton zharsho besito hyadhdho; ize goynize asuntsanan faydo.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">Hiz. 40:3</ref>; <ref loc="ZEC 2:1">Zakka. 2:1</ref></char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>Yezin Xoozze Keetstsa bale bucita Ayhude maaqqoosse asuntsis ingginttide gisho mixxippe ashshii aadho. Unttin oyttam lam77i agina geeshi katama ahoda.<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">Luqa. 21:24</ref></char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>Taanii lam77i markkuntsi azzano ma7o ma77i 1, 260 qamma tinbbite ohode fana wolqqa inggoda».<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>Yentses alame Laatstse tiino eqqize lam77i shamahe minxan lam77i xomppe gaddize kocuntsana.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">Zakka. 4:3</ref></char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>Ooden unttana qohodes koyko un doonttippa tama kessada, un morkkuntsana mo7oda. Ooden qohodes koyko yinnii fana hyayqo hyayqqoda. <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>Un tinbbite ohize yinna qammite ira bukkaame fana salo gorddodes unttis adetits wolqqa yene. Unttis hyaatsi suutsi laammodesin, mahi un koyde wode ubba fa koyde hyanqora sa7ito dhabssodes unttis adetits wolqqa yene.<note caller="-" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kat. 17:1</ref>; <ref loc="EXO 7:17">Keze 7:17</ref></char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>Un fa markkatitsito hyaasidannippa suuba, doochappa kezze xootsize unttara olintti, caddoda, gamoda, wodhoda.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Dane. 7:7</ref>; <ref loc="REV 13:5">Qon. 13:5</ref></char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>Un Laatstse masqalalla afa suxinttide damma katama ogitilla afa un ahita olinttoda. Yinna katamita aazizera Soodome woy Gibxxe ga7intti xeeginttane.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="ISA 1:9">Isa. 1:9</ref></char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>Mahi bagga ubbappa, kochchi ubbappa, dumma dumma doonappan worzha ubbappa yi7ide asuntsi un ahito hyaydzdzii qamman bagga yellodes be7ada. Un ahita mooginttaame fana asuntsi kayoda. <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>Hyantsi lam77i nabuntsi sa7a yeze asuntsana un7itside gisho asuntsi un hyayqite ufayttoda. Fa ufaysitis ba7aale oochchoda fete fetes imon inggoda.<verse eid="REV 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11"/>Hyaydzdzii qamma baggeppa suuba, de7o ayyaana Xoozze kaleppa yi7i un gidda gelin, un denddii eqqida. Unttana bi7ide ubba damma zhashimo zhashtida.<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">Hiz. 37:10</ref></char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>Yinnippa suuba, yentsi lam77i nabuntsi, «Ude kezote» gaaze qaala saloppa si7ida. Un morkkuntsi unttana beezin, dhonne gidda gelii ude salo kezida.<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 Kat. 2:11</ref></char></note><verse eid="REV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13"/>Yinna saatte sa7a damma en7e en7in, katamappa taphphi kushe maaqqade dhabida. Mahi sa7a en7ite laappun mukul asi hyayqqida. Attide asuntsi gaama goqii zhashtii; salo Xoozis bonchcho inggidda.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 6:12">Qon. 6:12</ref>; <ref loc="REV 16:18">16:18</ref></char></note><verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>Lam7intsa badize aadhida, yezin hyaychche hyaydzintsa badize ellisii yo7oda.<verse eid="REV 11:14"/></para>
  <para style="s1">Laappuntso moyze</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>Laappuntsa kiitanchchize fa moyza oollida. Saloppa, «Sa7a ka7itumo nu Laatstsesin Kiristtoosas maaqqida; E medhinappa medhina yellodes ka7itoda» gaaze damma girsuntsi sinttida.<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">Keze 15:18</ref>; <ref loc="DAN 2:44">Dane. 2:44</ref>; <ref loc="DAN 7:14">7:14</ref></char></note> <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>Xoozze tiino, fa araatuntsalla bettide lam7itam oyddii cimuntsi zuggii, Xoozzes,<verse eid="REV 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17"/>«Yezen yezide,</para>
  <para style="q2" vid="REV 11:17">Laatstso, Ubbappa damma Xoozzayo,</para>
  <para style="q2" vid="REV 11:17">neenii damma wolqqa aykkida.</para>
  <para style="q2" vid="REV 11:17">Neenii ka7itide gisho</para>
  <para style="q2" vid="REV 11:17">nuunii nena galatane.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="EXO 3:14">Keze 3:14</ref></char></note><verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>Ayhude maaqqoosse asuntsi hyanqinttida, yezin ne hyanqitan yi7ida.<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">Maz. 2:5</ref>; <ref loc="PSA 110:5">110:5</ref>; <ref loc="PSA 115:13">115:13</ref></char></note></para>
  <para style="q2" vid="REV 11:18">Hyayqqiduntsalla ne firddize wode yi7ida.</para>
  <para style="q2" vid="REV 11:18">Neenii nees oochchizuntsis, nabuntsis</para>
  <para style="q1" vid="REV 11:18">geeshshuntsisin ne suntsitis zhashtizuntsis,</para>
  <para style="q2" vid="REV 11:18">eeratsuntsisin dammuntsis, un oochiti gaar inggize wode yellida.</para>
  <para style="q2" vid="REV 11:18">Alame dhabsizuntsana dhabsize wode yi7ida»</para>
  <para style="m" vid="REV 11:18">yagayda.<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>Salo yeze Xoozze Keetsita bugunttida; I gidda Xoozze caaqo taabote benttida. Mahi zeelintsi zeelinggida, dhoge dhogida; dada dhuqqida; sa7a en7ida; shachchi bukkida.<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="REV 8:5">Qon. 8:5</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="REV 21">21</ref></char></note><verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">Maachiton dawiza</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>Yinnippa suuba, salo damma malla benttida. Awa ma77ide, aginalla eqqide, taphpho lam77i xoolintto worqqa zawude fa ommite gaddide, fettii maachita yene. <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>Yinna maachita wodatsi yezin, izo yelo dha7e aykkin un7intti uukkida.<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>Mahi melle malla salo benttida. Laappun omman taphphi gumuri yeze damma zoqo dawa benttida. E fa ommuntsalla afa laappun worqqa zawuduntsana gaddida.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Dane. 7:7</ref></char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>Ye dawize fa unkkite xooluntto hyaydzappa fettii kushito saloppa gochchi sa7a olida. Ye dawize na7ay yelintti wodhdhide fana qoodhdhodes koyi, yelodes dha7inttize maachiti tiintte eqqida.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">Dane. 8:10</ref></char></note><verse eid="REV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 12:5"/>Yinna maachita ka7itumo ubba meqo gufera ahodes yeze dhiiratsi na7a yelida. Na7ay Xoozagon E araatizego salo ekinttida.<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">Isa. 66:7</ref>; <ref loc="PSA 2:9">Maz. 2:9</ref></char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>Maachita 1260 qamma yellodes izo naagode fana Xoozii iis giigizii gaddide bessa akko baayze sa7a aachinttida.<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>Salo ola medhinttida. Mika7eele fa kiitanchchuntsara wolla dawara olinttida; dawize fa kiitanchchuntsara maaqqii mahi olinttida.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">Dane. 10:13</ref></char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>Yezin dawize gaminttin salo unttis yeze bessi dhabida. <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>Damma dawize, zaga shooshe, sa7a wodhdhida. Ezin Dabuloosa woy Xalahe ga7inttize alame balitsizaya. E fa kiitanchchuntsara wolla sulle alame olinttida.<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">Medho 3:1</ref>; <ref loc="LUK 10:18">Luqa. 10:18</ref></char></note><verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>Yinnippa suuba, salo hyannigaara yagaaze qaala si7ida.</para>
  <para style="q1" vid="REV 12:10">«Hyatte atotitsi, wolqqan ka7itumo, nu Xoozzes;</para>
  <para style="q2" vid="REV 12:10">adetits wolqqa Kiristtoosas maaqqida.</para>
  <para style="q1" vid="REV 12:10">Yikke, qamman awara Xoozze tiintte,</para>
  <para style="q2" vid="REV 12:10">nu ishuntsana mootizay saloppa sulle olinttida.<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="JOB 1:9">Iyo. 1:9</ref></char></note><verse eid="REV 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11"/>Un durize suutsiten fa markkatitsi qaaltte,</para>
  <para style="q2" vid="REV 12:11">eza olii gamida.</para>
  <para style="q1" vid="REV 12:11">Un fa shemppitis yiqsinttikaayzara</para>
  <para style="q2" vid="REV 12:11">fana hyayqos aatsii inggida.<verse eid="REV 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12"/>Yinnii gisho, salon E gidda yezuntso ufayttote.</para>
  <para style="q2" vid="REV 12:12">Yezin sa7an abba bade!</para>
  <para style="q1" vid="REV 12:12">Yikke, Dabuloosa faas eerats wode attidanno eride gisho</para>
  <para style="q2" vid="REV 12:12">damma hyanqora yinttago wodhdhida»</para>
  <para style="m" vid="REV 12:12">yagayda.<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>Mahi dawize fana sa7a olidanno bi7ide wode dhiiratsi na7a yelide maachito bay7ida. <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>Maachito shooshe qohaame gaar hyaydzdzii beren bagga mu7iteran uzhitera iza naaginttize bessi akko baayze ganasa firii qitode gaar lam77i damma ankko qefe iis ingginttida.<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">Dane. 7:25</ref>; <ref loc="DAN 12:7">12:7</ref></char></note><verse eid="REV 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 12:15"/>Yeyzi, maachito hyaro goggii shokkii ekkode fana dawize borkka hyaatsi fana fa doonappa maachiti suubara coozhida. <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>Yezin sa7ita maachito maaddida; sa7ita fa doontto bugii dawize doonappa kezide hyaatsito qoodhdhida. <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>Ye dawize maachitilla afa gaama shenidhii, I zaruntsana, Xoozze kiita naagizuntsanan Yesuusa qonccizide turetitsitis ammanittiduntsana olodes hyanggi, <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>dawize abba gaxa yeze shaftte eqqida.<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">Grike maxaafite E eqqida; melluntsi maxaafite ta eqqida gaane.</char></note><verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s1">Lam77i xootsuntsana</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>Yinnippa suuba, fettii xootsize abbap kessadera bi7ida. Ees taphphi gumurin laappun omma yene. Yentsi taphphi gumuruntsalla afa taphphi zawuduntsi yene. Yentsi ommuntsalla afa cashshi suntsi yene.<note caller="-" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">Dane. 7:3</ref>; <ref loc="REV 17:3">Qon. 17:3</ref></char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>Ta bi7ide xootsize worba aazane; E tohitan babbantsi tohe aazane; E doonttan gaammo doona aazane. Dawize fa wolqqito, fa araatizan fa adetitsito ye xootsizes inggida.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="DAN 7:4">Dane. 7:4</ref></char></note><verse eid="REV 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3"/>Ye xootsize ommitippa fete hyayqos yeltsize hyarggize bessi yezanno bi7ida, yezin yinna hyarggize bessita faxida. Alame ubba gaama qoppii ye xootsiza kaallida. <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>Dawize fa adetitsito xootsizes inggide gisho asi ubba dawizes goynida. Mahi asuntsi, «Xootsiza aazize oode? Ezara olinttodes dandda7ize oode?» yaga7i xootsizes goynida.<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>Ye xootsizes uturtode gaaran cashshade gaar doona ingginttida; oyttam lam77i agina ahode gaar wolqqa ees ingginttida.<note caller="-" style="x"><char style="xo" closed="false">13:5-6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">Dane. 7:8</ref>, <ref loc="DAN 7:25">25</ref>; <ref loc="DAN 11:36">11:36</ref></char></note> <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>Ye xootsize Xoozza, E suntsito, E yeze bestton salo yezuntsana cashshi aykkida. <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>Ye xootsize geeshshuntsana olii, gamode gaar wolqqa ees ingginttida. Kochchi ubba, worzha ubba, dumma dumma doona ohize ubban worzha ubballa afa adetitsi ees ingginttida.<note caller="-" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">Dane. 7:21</ref></char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>Alame medhinttidannippa aykkii, shukinttide Durize de7o maxaafite un suntsita xaafinttikaayze hyanna sa7ite yeze asi ubba ye xootsizes goynoda.<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">Maz. 69:28</ref></char></note><verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>Si7ize hyaye yeze asi si7o. <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>Ooden di7inttodes yeze di7inttoda. Mashshara hyayqqodes yeze mashshara hyayqqoda. Geeshshuntsi dandda7itan ammanora erinttode yinne.<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 15:2">Er. 15:2</ref>; <ref loc="JER 43:11">43:11</ref></char></note><verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>Mahin, melle xootsi sa7appa kessadera bi7ida. Ees duro gumuri aazize lam77i gumuri yene; E ohitan dawize fana. <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>E tiino xootsize adetitsi wolqqara oochchane. Een hyayqos yeltsize hyarggize bessappa faxide tiino xootsizes; sa7a yeze ubba goyinode gaar yiizane. <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>Ye lam7intsa xootsize melle atto yezin, tama saloppa as ubba tiino ketstsode wontsis damma kille baz oochchida. <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>Tiino xootsize tiintte oochchode fana, ees ingginttide kille baz sa7a yeze asi ubba balitstsida. Mashshara hyarggizide bessi faxide xootsize bonchchos misile giigissade fana unttana kiittida. <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>Lam7intsa xootsize tiino xootsize misilizes shemppo inggi ohinttode fanan ees goynoosuntsi hyayqqode fana oochchize adetitsi ingginttida.<verse eid="REV 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 13:16"/>Ye lam7intsa xootsize damman eeratsi, dahan dure, laatstsin aro fa mizaqi kushite woy fa sintte malla gaddode fana yiizida. <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>Ye xootsize suntsita woy E suntsiti fayditi malla baayze asi ooden bayzodesin wonggodes dandda7oos.<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>Cinccatitsi koshshize hyanne. Qofa yeze ooden ye xootsize fayditi bilitsito ero; yinna fayditan as faydo. Yinna faydita izipun xeeti izippuntam izippun.<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">Durizan 144, 000 asuntsana</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>Durize Xiyoone Derizella afa eqqezin bi7ida. Eera E suntsitan E Aday suntsita un sintte xaafinttide, 144, 000 asuntsi yene.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz. 9:4</ref>; <ref loc="REV 7:3">Qon. 7:3</ref></char></note> <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>Saloppa damma hyaatsi guumen dada dhoge ootsi aazize ootsi si7ida. Mahi ta si7ide yinna ootsitan diitsi diixxodera sinttize ootsi fana. <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>Attide144, 000 asuntsi araatize tiino, oyddii medhetuntsi tiinon cimuntsi tiino eqqide unttappa melle ooden tamaarodes dandda7oose kille mazmure yexxida. <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>Yentses maachira fana tunizikaayzara naagide geeshshuntsana. Un durize hyanggize bessa ubba kaallane. Un Xoozzesin Durizes anggis maaqqii, shiiqodes sa7a as giddappa wozinttida. <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>Unttalla worddon bore baaya.<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="ZEP 3:13">Sofo. 3:13</ref></char></note><verse eid="REV 14:5"/></para>
  <para style="s1">Hyaydzdzi kiitanchchuntsana</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>Yinnippa suuba, medhina Wonggele sa7alla afa yeze ka7itumo ubbas, kochchi ubbas, dumma dumma doona ubbasin dumma dumma bagga ubbas markkidhades salora firize melle kiitanchcho bi7ida. <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>Ye kiitanchchize fa qaaltto dhoqi yiizii, «Xoozii alame firddize saata yellide gisho Xoozis zhashitote; eza bonchchote. Salo, sa7a, abban hyaatsi aafe medhdhide Xoozza goynote» gayda.<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>Tiinoya kaallii melle lam7intsa kiitanchchize, «Worzha ubba tunara matstsize woyne ushshide, damma Baabiloone gol7ida! gol7ida!» yaga7i uukkida.<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">Isa. 21:9</ref>; <ref loc="JER 51:8">Er. 51:8</ref>; <ref loc="REV 18:2">Qon. 18:2</ref></char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>Hyaydzdzintsa kiitanchchize unttana kaallii, fa qaaltto dhoqi yiizii, «Xootsizan E misiltto goynize mahi E mallito fa sintte woy fa kushite gaddide ooden yeziko, <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>E hyanqo xuu7a kumide Xoozze hyanqo woyne ushshada. Un geeshi kiitanchchuntsi tiinon Durize tiino eexize diinne tama waayinttoda.<note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">Isa. 51:17</ref>; <ref loc="GEN 19:24">Medho 19:24</ref>; <ref loc="EZK 38:22">Hiz. 38:22</ref></char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>Un waayinttize tamiti cugita medhii medhinas cugitera yessada. Xootsizan E misiltto goynizen mahi ye xootsize suntsiti malla yeze ooden qamman awara shemppo baytsi ka7inttoda» yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">Isa. 34:10</ref></char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>Xoozze kiita naagizuntsin Yesuusa ammanii genccizunts geeshshuntsi dandda7ita yinne.<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>Yinnippa suuba, «Yikkeppa Laatstsara hyayqqizuntsi anjjinttiduntsana» yagaaze qaala saloppa si7ida; hyanno xaafo.</para>
  <para style="p" vid="REV 14:13">Ayyaana, «Yee turo, un oochita unttana kaallide gisho un fa waaytippa shemppoda» yagaane.<verse eid="REV 14:13"/></para>
  <para style="s1">Katstsa shiishize wode</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>Yinnippa suuba, bootsi dhonnella afa bettide As Na7a aazizaya bi7ida. E fa ommite worqqa zawude gaddida; mahi fa kushite oco baaca aykkida.<note caller="-" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 7:13-14">Dane. 7:13-14</ref></char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>Melle kiitanchcho Xoozze keetstsappa kezii, dhonnella afa bettezego fa qaaltto dhoqi yiizii, «Baha shiishize wode yellide gisho ne baaca ekkii bahito man7o; gadite yeze bahita boottida» gayda.<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">Iyu. 3:13</ref></char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>Dhonnella afa bettide fa baaca gade dakkii, gade yeze bahito man7ida.<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>Mahin salo yeze Xoozze keetstsappa melle kiitanchcho kezida; eesin oco baaca yene.<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>Tamalla afa adetits wolqqa yeze melle kiitanchcho zharsho bessappa kezida. E fa qaaltto dhoqi yiizii oco baaca aykkide kiitanchchizego, «Woyne aafita diilide gisho ne oco baaciza ekkii, gade yeze woynttippa zhanggito gachcho» yagayda. <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>Ye kiitanchchize fa baaciza ekkii, gade yeze woynttippa gachchii, Xoozze damma hyanqo cicize besite olida. <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>Yinna woyne aafe cicize besita katamappa gaxa yedhinttida. Suutsi woyne cicize bessappa kezii hyaydzdzii xeeti kilo mitire fana hyaakkii, fara bixaale yellode fana eellii dhoqi gayda.<note caller="-" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">Isa. 63:3</ref>; <ref loc="LAM 1:15">Kayo Er. 1:15</ref>; <ref loc="REV 19:15">Qon. 19:15</ref></char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">Wurssutsi hyanqo</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>Taanii salo melle damman gaama qofize malla bi7ida. Xoozze wurssutsi hyanqo qonccize laappun boshuntsana aykkide laappun kiitanchchuntsana bi7ida.<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>Mahi tamara worqqinttide burccuqo abba aaziza bi7ida. Yinna abba gaxite xootsin, E misiltton E suntsiti faydito gammiduntsana bi7ida. Xoozii unttis inggide bagana aykkii eqqida. <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>Un Xoozze arize Muse mazmuren Durize mazmure hyannii gaar yag7i yexxida.</para>
  <para style="q1" vid="REV 15:3">«Laatstso, Ubbappa Damma Xoozayo,</para>
  <para style="q2" vid="REV 15:3">ne oochita damman gaama qofize baz.</para>
  <para style="q2" vid="REV 15:3">Worzha ubba kaatayo,</para>
  <para style="q2" vid="REV 15:3">ne ogita xillon turo.<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">Keze 15:1</ref></char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>Geeshi ne xalaala maaqqide gisho</para>
  <para style="q2" vid="REV 15:4">Laatstso, nees zhashitoosen</para>
  <para style="q2" vid="REV 15:4">ne suntsito bonchchoosse oode?</para>
  <para style="q2" vid="REV 15:4">Ne xillo oochita qonccide gisho</para>
  <para style="q2" vid="REV 15:4">ka7itumo ubba ne tiino yi7i goynoda»</para>
  <para style="m" vid="REV 15:4">yaga7i yexxane.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="JER 10:7">Er. 10:7</ref>; <ref loc="PSA 86:9">Maz. 86:9</ref></char></note><verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>Yinnippa suuba, salo bugunttin Xoozze Keetstsa, Markkatitsi Dunkkaane bi7ida.<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">Keze 38:21</ref></char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>Laappun boshuntsana aykkide laappun kiitanchchuntsi Xoozze keetstsappa kezida. Un geeshin focize liino ma7o ma77ida; fa dadabite worqqa saqqe danccida. <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>Oyddii medhetuntsappa fetay, medhinas yeze Xoozze hyanqo kumide laappun worqqa xuu7uto laappun kiitanchchuntsis inggida. <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>Xoozze bonchchoppan E wolqqitippa denddidanne Xoozze Keetsita cugara kumida. Laappun kiitanchchuntsi aykkide laappun bochuntsi folinttode wontsis Xoozze Keetstsa ooden gelodes dandda7ikaaya.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">Keze 40:34</ref>; <ref loc="1KI 8:10">1 Kat. 8:10</ref></char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">Xoozze hyanqo kumide xuu7a</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>Yinnippa suuba, Xoozze keetstsappa laappun kiitanchchuntsago, «Hyanggi Xoozze hyanqo laappun xuu7untsappa sa7a gussote» yaga7i, ohize dhoqi gayde qaala si7ida.<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>Tiino kiitanchchize hyanggi, fa xuu7ite yezanno sa7a lalin, xootsize malla yezuntsalla afan E misiltto goyniduntsalla afa iita hyaazhi hyarggize bessi kezida.<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">Keze 9:10</ref></char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>Lam7intsa kiitanchchize fa xuu7ite yezanno abba lalin, abbize hyayqqide as suutsi lanttide baz aazida. Mahi abba yeze medhetitsi ubba hyayqqida.<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>Hyaydzdzintsa kiitanchchize fa xuu7ite yezanno borkkan hyaatsi aafella lalin, hyaatsita suutsi maaqqida.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="EXO 7:17">Keze 7:17</ref></char></note> <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>Yinnippa suuba, hyaatsitilla afa adetitsi yeze kiitanchcho hyannii gaar yagaazin si7ida.</para>
  <para style="q1" vid="REV 16:5">«Hyatten zagan yeze geeshizayo,<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">Keze 3:14</ref></char></note></para>
  <para style="q2" vid="REV 16:5">hyannii gaar ne firddide gisho ne xillo.<verse eid="REV 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6"/>Un geeshuntsi suutsin nabunts suutsi lalide gisho</para>
  <para style="q2" vid="REV 16:6">un suutsi ushshade gaar yiida.</para>
  <para style="q2" vid="REV 16:6">Un beezize firdda ekkida»</para>
  <para style="m" vid="REV 16:6">yagayda. <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>Zharsho bessappa,</para>
  <para style="q1" vid="REV 16:7">«Yee, ubba ahize Laatstsi Xoozayo,</para>
  <para style="q2" vid="REV 16:7">ne firddita turon xillo»</para>
  <para style="m" vid="REV 16:7">yagaaze qaala si7ida.<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>Oydintsa kiitanchchize fa xuu7ite yezanno awalla lalin, awa fa michara asuntsana micisade fana awas wolqqa ingginttida. <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>Asuntsi damma teellar michinttida, yinna bochuntsalla afa adetitsi yeze Xoozze suntsito baaddida; fa nagarttippa maarinttii Xoozza bonchchikaaya.<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>Ichchintsa kiitanchchize fa xuu7ite yezanno xootsize araatizella afa lalin, ye xootsize ka7itumtta dhumida. Asuntsi un7ide gisho fa il7antsito dha7ane.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="EXO 10:21">Keze 10:21</ref></char></note> <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>Mahi asuntsana un7ide gishon hyarggize bessiti gisho salo Xoozza cazhida; fa oochchide nagarttippa maaqqikaaya.<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>Izippuntso kiitanchchize fa xuu7ite yezanno damma Efiraxiise borkka lalin, awa kessi zalappa ye7ode kaatuntsis ogita giigode gaar hyaatsita melida.<note caller="-" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="ISA 11:15">Isa. 11:15</ref></char></note> <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>Yinnippa suuba, onaqqe aazize hyaydzdzii tuna ayyaanuntsi dawize doonappa, xootsize doonappan worddo nabize doonappa kezzin bi7ida. <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>Yentsesin malla oochchize tuna ayyaanuntsana. Yentsesi hyaydzdzii tuna ayyaanuntsi Ubbappa Wolqqaama Xoozze qammite hyanodes yeze olas shiishodes alame ubba kaatuntsago kezoda.<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>«Yikke, ta kayzo gaar yo7oda! Kallidhaame fanan borsunttaame fana barkki, fa ma7ito naagize atstse anjjinttidaya!» yagayda.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato. 24:43</ref></char></note><verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>Yentsi tuna ayyaanuntsi kaatuntsana Ibraysxe doonara Armmagedoone gaaze bessa shiishida.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 Kat. 23:29</ref>; <ref loc="ZEC 12:11">Zakka. 12:11</ref></char></note><verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>Laappuntso kiitanchchize fa xuu7ite yezanno carkkolla afa lalin, Xoozze Keetstsa yeze araatizeppa, «Folinttida» yagaaze damma qaala kezida. <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>Yinnippa zeelintsi zeelinggida; dada dhogida, sa7a en7ida. Asi sa7alla medhinttideppa hyanno yellodes yinnii fana en7e en7ikaaya. Ubbappa aadhida.<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="REV 8:5">Qon. 8:5</ref>; <ref loc="REV 11:13">11:13</ref></char></note> <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>Damma katamita hyaydzdzii kezii shaakkinttida; Sa7a yeze katamita ubba dhabida. Xoozii damma katamito Baabiloone qoppii, fa iita hyanqo woyne ushi kumide xuu7iza ushshade gaar inggida.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">Isa. 51:17</ref></char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>Hyaatsar teqinttide sa7ita dhabida; deruntsin benttikaaya.<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="REV 6:14">Qon. 6:14</ref></char></note> <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>Asalla afa ichchintam kilo giiraame fana damma shachchi saloppa bukkida. Hyanqita gaama iita maaqqide gisho asuntsi yinna shachchi hyanqiti gisho Xoozza cazhida.<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">Keze 9:23</ref></char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">Damma olalize maachito</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>Laappun xuu7ito aykkide laappun kiitanchchuntsappa fetay taago yi7i, «Yo7o; gaama hyaatsalla afa bettide damma olalitilla yo7odes yeze firdda ta nena beessada.<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="JER 51:13">Er. 51:13</ref></char></note> <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>Alame kaatuntsi iira olalida; alame yeze asuntsi I olale woyniza uzhii matsinttida» yagayda.<note caller="-" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa. 23:17</ref>; <ref loc="JER 51:7">Er. 51:7</ref></char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>Ye kiitanchchize tana Geeshi Ayyaanara akko baayze sa7a kanggida. Yeyga fettii maachita cashshi suntsi kumide, laappun omman taphphi gumuri yeze zoqo xootsi toggidanno bi7ida.<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">Qon. 13:1</ref></char></note> <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>Yinna maachita bonchcho ma7on zoqo ma7o ma77ida; iza worqqara, bonchcho shuchcharan inqo gaaze al77o shuchchara shuurinttida. Iza fa kushite borssizebazin olale tunara kumide worqqa xuu7a aykkida.<note caller="-" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="JER 51:7">Er. 51:7</ref></char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>I sintte aachinttide suntsi, «Damma Baabiloone, olalesin sa7a yeze tuna baz ubbas inddo» yagaaze xuufe xaafintti yene. <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>Mahi yinna maachita geeshshuntsi suutsin Yesuusas markkidhitera hyayqqiduntsi suutsito uzhii matsinttidanno ta bi7i gaama qoppida.<verse eid="REV 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 17:7"/>Kiitanchchize taago, «Neenii akkos gaama qoppe? Taanii nees maachiti gaatsi qofan iza tookkide laappun omman taphphi gumuri yeze xootsizes gaatsi qofa ohoda. <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>Neenii bi7ide xootsize tiino yene, hyatte baaya. Ye xootsize damma olappa kezii dhabodes qitoda. Sa7a medhinttidannippa aykkii, de7o maxaafite un suntsita xaafinttikaayze sa7a yeze asuntsi xootsiza bi7i gaama qoppida. Yikke, E tiino yene; hyatte baaya, yezin tiinos yo7oda.<note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Dane. 7:7</ref>; <ref loc="REV 11:7">Qon. 11:7</ref>; <ref loc="PSA 69:28">Maz. 69:28</ref></char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>«Cinccatitsin qofa koshshize hyanne. Laappun ommuntsi maachita bettide laappun deruntsana; yentses mahi laappun kaatuntsana. <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>Unttappa ichchin kaatuntsi gol7ida. Fetay hyayno yellodes ahane; hyankay hyaga yi7ikaaya. E yi7i eerats wode gami7odes beezane. <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>Tiino yezide xootsize, hyatte baayzay, E fa ommite osfuntso xootsi. E laappun xootsuntsappa fetaya; E dhabodes qitane.<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>«Neenii bi7ide taphphi gumuruntsi ahe aykkikaayze taphphi kaatuntsana. Yezin un xootsizera wolla fettii saate ka7iti ahodes unttis adetitsi wolqqa inginttoda.<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">Dane. 7:24</ref></char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>Un ubbuntsis fettii qofa yene; un fa wolqqiton fa adetits wolqqito xootsizes inggoda. <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>Un Durizera olinttoda, yezin durize laatstsuntsi Laatstsaya kaatuntsi Kaataya maaqqide gisho E xeegidunts, dooriduntsin ammaninttiduntsii yentsi kaatuntsana eera gamoda» yagayda.<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>Kiitanchchize mahi taago, «Olalita bettide ye neenii bi7ide hyaatsita worzhuntsi, asuntsi, kochchin dumma dumma doonara ohizuntsana. <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>Mahi ne bi7ide taphphi gumuruntsin xootsize olale maachito ixxoda. Un iis yeze ubbabazito ekkoda. Mahi izo hyarii ashshoda I ashito mo7oda; yinnippa izo tama michchoda. <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>Yikke, Xoozze qaalita folinttode wontsis un qoftta fetto maaqqade fana ka7itumo adetits wolqqito xootsizes inggode fana Xoozii qoppidanno un oochchode fana un wozintte Xoozii amotetsi gaddida. <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>Ye ne bi7ide maachita sa7a kaatuntsalla ka7itize damma katamito» yagayda.<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">Baabiloone gol7ito</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>Yinnippa suuba, damma wolqqa yeze melle kiitanchcho saloppa wodhdhodera ta bi7ida. E bonchchitippa denddii sa7a foo7ida. <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>Dhoqqa ootsara,</para>
  <para style="q1" vid="REV 18:2">«Damma Baabiloone gol7ida! Gol7ida!</para>
  <para style="q2" vid="REV 18:2">Tuna ayyaanuntsi aqize bessi maaqqida.</para>
  <para style="q1" vid="REV 18:2">Iita ayyaanuntsis keetstsi maaqqida;</para>
  <para style="q2" vid="REV 18:2">tunan ixinttide landduntsis shemppize bessi maaqqida.<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="ISA 21:9">Isa. 21:9</ref>; <ref loc="JER 51:8">Er. 51:8</ref>; <ref loc="REV 14:8">Qon. 14:8</ref>; <ref loc="ISA 13:21">Isa. 13:21</ref>; <ref loc="JER 50:39">Er. 50:39</ref></char></note><verse eid="REV 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3"/>Worzha ubba iza fa olale hyanqo woyne ushshida.</para>
  <para style="q2" vid="REV 18:3">Sa7a kaatuntsi iira olalida.</para>
  <para style="q1" vid="REV 18:3">Iis wottidannippa denddii</para>
  <para style="q2" vid="REV 18:3">sa7a yeze zal7izuntsi duridhdhida»</para>
  <para style="m" vid="REV 18:3">yagayda.<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa. 23:17</ref>; <ref loc="JER 51:7">Er. 51:7</ref></char></note><verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>Yinnippa suuba, ta saloppa hyannii gaar yagaaze melle qaala si7ida.</para>
  <para style="q1" vid="REV 18:4">«I nagartto iira koxxaame fanan,</para>
  <para style="q2" vid="REV 18:4">iza ekkodes yeze hyanqito yin ekkaame fana,</para>
  <para style="q2" vid="REV 18:4">ta worzhuntso I kaleppa kezote.<note caller="-" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa. 23:17</ref>; <ref loc="JER 51:7">Er. 51:7</ref></char></note><verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>Yikke, I nagartta salo yellodes doorinttida.</para>
  <para style="q2" vid="REV 18:5">Xoozii I qohito qoppida.<note caller="-" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="GEN 18:20">Medho 18:20</ref></char></note><verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>Iza inggidanni fana lam77i kushe iis inggote.</para>
  <para style="q2" vid="REV 18:6">Iza oochchide oochitis lam77i kushe iis mahote.</para>
  <para style="q2" vid="REV 18:6">Iza giigizide ushshitilla afa yin lam77i kushe matstsize ushi I xuu7ite worqqote.<note caller="-" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">Maz. 137:8</ref>; <ref loc="JER 50:29">Er. 50:29</ref></char></note><verse eid="REV 18:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="REV 18:7"/>Iza bonchchinttidanni fanan iis giigidanni fana,</para>
  <para style="q2" vid="REV 18:7">izo waytsoten azzantsote.</para>
  <para style="q2" vid="REV 18:7">Iza fa wozintte,</para>
  <para style="q2" vid="REV 18:7">‹Taanii kaat maaqqii bettoda; taanii azinii baayze maacho maaqqoos;</para>
  <para style="q2" vid="REV 18:7">taanii azzanon mahi azzanoos› gayda.<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>Yinnii gisho, hyanqo,</para>
  <para style="q2" vid="REV 18:8">hyargge, azzanon naye izo fettii qamma aykkoda.</para>
  <para style="q1" vid="REV 18:8">Mahi iza tamar mu7inttoda;</para>
  <para style="q2" vid="REV 18:8">akkos gayko, Iilla afa firddize Laatstsi Xoozze mintsi»</para>
  <para style="m" vid="REV 18:8">gayda.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="ISA 47:7-9">Isa. 47:7-9</ref></char></note><verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>«Iira olale hyanttiduntsin iis wottide yestte yezide, alame kaatuntsi yinna katamita mu7inttin kezize cugito bi7ide wode wuysi yeekkoda.<note caller="-" style="x"><char style="xo" closed="false">18:9-10 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">Hiz. 26:16-17</ref></char></note> <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>Un yinna katamiti waayito bi7i zhashtide gisho hyaakkii eqqii,</para>
  <para style="q1" vid="REV 18:10">« ‹Hyanna damma katamite! Wolqqara yezanne!</para>
  <para style="q2" vid="REV 18:10">Baabiloone, nena bade! Bade!</para>
  <para style="q2" vid="REV 18:10">Nena fettii saate gidda firdda yellida› gawuda.<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>«Un markkabite yeze caantto yikkeppa gode wonggize asi baayze gisho sa7a yeze zal7izuntsi yinna katamitis yeekkoda azzanoda;<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="EZK 27:31">Hiz. 27:31</ref></char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>Un worqqa, bira, bonchcho shuchchi, inqo gaaze al77o shuchchi, bonchcho ma7o, liino ma7o, haare ma7o, zoqo ma7o, dumma dumma sawo minxa, danggars achchi, al77on bonchcho minxa, naase, meqqon, ibine beredeppa medhinttide miishe ubba,<note caller="-" style="x"><char style="xo" closed="false">18:12-13 </char><char style="xt" closed="false"><ref loc="EZK 27:12-13">Hiz. 27:12-13</ref>, <ref loc="EZK 27:22">22</ref></char></note> <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>qerefa, qimaame, sawize minxa, karbbe, ixaane, woyne, zayte, liiqo dhiilla, zarga, hyaari, duro, fara, fara gaare, aron melle asuntsin yene.<verse eid="REV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14"/>«Zal7izuntsi, ‹Neenii amudhdhide lo77o baz ubba neeppa aadhida. Ne yessitan ne falimo miishita ubba neeppa hyaakkida. Asuntsi yikkeppa mahi yinno denggaama› yagayda. <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>Yinno zal7i duridhdhide ubba yeekkiteran azzanitera,<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">Hiz. 27:31</ref></char></note><verse eid="REV 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 18:16"/>« ‹Liino ma7o, lee7o ma7on zoqo ma7o ma77i,</para>
  <para style="q2" vid="REV 18:16">worqqara, bonchcho shuchchin</para>
  <para style="q2" vid="REV 18:16">inqo gaaze al7o shuchchara</para>
  <para style="q2" vid="REV 18:16">bonchchinttidanna aadhii lo77ida,</para>
  <para style="q2" vid="REV 18:16">yinna damma katamito bade! Bade!<verse eid="REV 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17"/>Hyannii fana damma duretetsi!›</para>
  <para style="p" vid="REV 18:17">«Fettii saate dhabida yaga7i hyanqito zhashtidannippa denddii hyaako eqqida.</para>
  <para style="p" vid="REV 18:17">«Markkabiza izhize ubba, markkabzera qitize ubba, markkabizella afa oochchize ubba Abballa zal7ize ubba hyaakkii eqqida.<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">Isa. 23:14</ref>; <ref loc="EZK 27:26">Hiz. 27:26</ref></char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>Yinna katamita eexin kezize cugito bi7ide wode ‹Hyanna damma katamito aazize melle katama yene yessane?› yaga7i uukkida.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">Hiz. 27:32</ref></char></note> <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>Un fa ommite bul7a gussii, yeekkiteran kaayidhitera,</para>
  <para style="q1" vid="REV 18:19">« ‹Abballa markkabe yeze ubba,</para>
  <para style="q2" vid="REV 18:19">fa duretitsitippa denddii dure mahide,</para>
  <para style="q2" vid="REV 18:19">damma katamite bade! bade!</para>
  <para style="q2" vid="REV 18:19">Fettii saate dhabida yaga7i› uukkida.<verse eid="REV 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20"/>Saltte,</para>
  <para style="q2" vid="REV 18:20">Geeshshuntso, hawaaruntso, nabuntso,</para>
  <para style="q2" vid="REV 18:20">Xoozii yin gisho iilla afa firddide gisho ufayttote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EZK 27:30">Hiz. 27:30</ref>; <ref loc="DEU 32:43">Mahe 32:43</ref>; <ref loc="JER 51:48">Er. 51:48</ref></char></note><verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>Fettii mintsi kiitanchcho woxa aazize damma shuchchi dentsii abba dhogii, «Damma katamite Baabiloone hyannigaara urqqintti gol7oda; yikkeppa suuba mulon benttoos.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="JER 51:63">Er. 51:63</ref></char></note> <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>Bagana guuddizuntsin mazmure yexxizunts, suulunqen moyze oollizunts, yikkeppa suuba ne gidda mulon sinttoos. Akko bazin kushe yiillar oochchize asin ne gidda benttoos. Woxa ootsi yikkeppa suuba ne gidda mulon sinttoos.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="ISA 24:8">Isa. 24:8</ref>; <ref loc="EZK 26:13">Hiz. 26:13</ref> </char></note><note caller="-" style="x"><char style="xo" closed="false">18:22-23 </char><char style="xt" closed="false"><ref loc="JER 7:34">Er. 7:34</ref>; <ref loc="JER 25:10">25:10</ref></char></note> <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>Xomppe foo7o mahi ne gidda foo7oos. Machcho ekkizen azinii gelize ufayssi qaala yikkeppa suuba ne gidda mulon sinttoos. Zal7izuntsi sa7a erinttide gisho ne bititira ka7itumo mulo balitstsida» gayda.<verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>Nabunts suutsi, geeshshuntsi suutsitan sa7alla afa hyayqqide asunts ubbunts suutsita I gidda benttida.<note caller="-" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="JER 51:49">Er. 51:49</ref></char></note><verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>Yinnippa suuba, salo gaama asunts,</para>
  <para style="q1" vid="REV 19:1">«Xoozze galatintto!</para>
  <para style="q2" vid="REV 19:1">Atotitsi, bonchchon wolqqa nu Xoozzes maaqqe.<verse eid="REV 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2"/>E firddita turon xillo.</para>
  <para style="q2" vid="REV 19:2">Sa7a tunizide damma olalito Xoozii firddide gishon</para>
  <para style="q1" vid="REV 19:2">fa arunts suutsito iippa mahida»</para>
  <para style="m" vid="REV 19:2">gaazin si7ida.<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Mahe 32:43</ref>; <ref loc="2KI 9:7">2 Kat. 9:7</ref></char></note><verse eid="REV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3"/>Mahin fa qaaltto dhoqi yiizii,</para>
  <para style="q1" vid="REV 19:3">«Xoozza galata yello.</para>
  <para style="q2" vid="REV 19:3">Cugitan medhippa medhina yellodes cugoda»</para>
  <para style="m" vid="REV 19:3">yagayda.<note caller="-" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">Isa. 34:10</ref></char></note><verse eid="REV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4"/>Lam7itam oyddii cimuntsin oyddii medhetuntsi araatizella bettide Xoozzes bunqitii,</para>
  <para style="q1" vid="REV 19:4">«Amin77e! Xoozza galata yello»</para>
  <para style="m" vid="REV 19:4">yaga7i goynida.<verse eid="REV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>Yinnippa suuba ootsara,</para>
  <para style="q1" vid="REV 19:5">«Aruntso,</para>
  <para style="q2" vid="REV 19:5">Eza zhashtizuntso eeratsuntso dammuntso,</para>
  <para style="q2" vid="REV 19:5">nu Xoozza galatote»</para>
  <para style="m" vid="REV 19:5">yagaaze qaala zufanzeppa kezida.<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">Maz. 115:13</ref></char></note><verse eid="REV 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6"/>Gaama asunts ootsi fana, damma goggize borkka hyaatsi guume fana, dada fana dhogize ootsara,</para>
  <para style="q1" vid="REV 19:6">«Xoozza galata yello;</para>
  <para style="q2" vid="REV 19:6">ubba ahize nu Laatstse, ka7itida.<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">Hiz. 1:24</ref>; <ref loc="PSA 93:1">Maz. 93:1</ref>; <ref loc="PSA 97:1">97:1</ref>; <ref loc="PSA 99:1">99:1</ref></char></note><verse eid="REV 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7"/>Nu ufayttoda, galatoda eza bonchchoda.</para>
  <para style="q2" vid="REV 19:7">Akkos gayko Durize sarge yellide gishon eza gelizanna giigide gisho.<verse eid="REV 19:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="REV 19:8"/>Gelodes giigidanna focizan geeshi maaqqide</para>
  <para style="q2" vid="REV 19:8">liino ma7o ma77ode fana iis ingginttida»</para>
  <para style="m" vid="REV 19:8">gawudera ta si7ida. (Liino ma7o geeshuntsi xillo oocha aazize.)<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>Yinnippa suuba, kiitanchchize taago, «Durize sargito xeeginttiduntsi anjjinttiduntsana» ga7i xaafo. Mahin, «Hyanna Xoozze turii qaala» yagayda.<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 22:2">Maato. 22:2</ref></char></note><verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>Ye wode ta ees goynodes E tohitilla afa gol7ida. Yezin E, «Yinno oochaame fana naagintto! Taanii Yesuusa baz markkidhize ne fanan ne ishuntsi fana aro. Ne Xoozzes goyno» yagayda. Yikke, Yesuusa markkatitsita nabetitsi ayyaana.<verse eid="REV 19:10"/></para>
  <para style="s1">Bootsi faara toggidaya</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>Salo bugunttin bi7ida, hyaychche bootsi fariza toggiday Ammaninttidayan Turii asi ga7inttane. E xillotitsara firddanen olinttane.<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">Hiz. 1:1</ref></char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>E aafita tama loxe fana; E ommite gaama worqqa zawude yene. Eeppa attin melle ooden eroosse xaafinttide suntsi yene.<note caller="-" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">Dane. 10:6</ref></char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>E suutsar wuxurkkinttide ma7o ma77ida; E suntsitan Xoozze Qaala ga7inttida. <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>Focizan geeshi maaqqide liino ma7o ma77ide salo olanchuntsi bootsi faruntsana toggii E suubito kaallane. <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>Worzhito gachchize mashsha E doonttippa kezane. E meqo gufera asuntsana ahane. Ezin Ubbappa Damma Xoozze hyanqo woyne ushito gum7ize bessito E yedhdhoda.<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">Maz. 2:9</ref>; <ref loc="ISA 63:3">Isa. 63:3</ref>; <ref loc="JOL 3:13">Iyu. 3:13</ref>; <ref loc="REV 14:20">Qon. 14:20</ref></char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>E ma7itillan E magatsitilla afa, «Kaatuntsi Kaati Laatstsuntsi Laatstsi» yagaaze suntsi xaafinttida.<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>Yinnippa suuba, fettii kiitanchchize awalla afa eqqidaya bi7ida. Ezin salora firize landda ubbuntsis fa qaaltto dhoqi yiizii, «Hyayga yo7ote! Xoozze diggisa ma7ades fettii bessa shiiqote.<note caller="-" style="x"><char style="xo" closed="false">19:17-18 </char><char style="xt" closed="false"><ref loc="EZK 39:17-20">Hiz. 39:17-20</ref></char></note> <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>Yi7i kaatuntsi asho, shalaqunts asho, wottaddarunts asho, farunts asho, faruntsana toggizunts asho, as ubba asho, arunts asho, laatstsuntsi asho, dammuntsin eeratsuntsi asho mo7ote» gayda.<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>Fariza toggidayran olinttizuntsara olinttodes sa7a kaatuntsin unttis olinttize olanchuntsi fettii bessa shiiqezin bi7ida. <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>Yezin xootsizen E suntsite kille baz oochchide xootsize malla ekkiden E misilito goyniduntsana balitside worddo nabize eera wolla aykinttida. Lam77untsin diinne eexize tama abba faxa olinttida.<note caller="-" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">Qon. 13:1-18</ref></char></note> <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>Attiduntsi fara toggiday doonappa kezize mashshara hyayqqida. Landduntsi ubba un ashito mu7i mizhida.<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">Mukul bere</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>Wurssutsi baayze olla qulfen damma santsalaata fa kushite aykkide fettii kiitanchchize saloppa wodhdhodera bi7ida. <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>E dawiza aykkii mukul beres accida. Ye dawizen zaga shoosha, Dabuloosa woy Xalahe.<note caller="-" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">Medho 3:1</ref></char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>Kiitanchchize wurssutsi baayze olla eza olii, mukul bere hyal7ode wontsis worzha mahi balitsaame fana gorddii attamida. Yinnippa suuba, dawize eerats wodes bilinttodes beezane.<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>Yinnippa suuba, araatuntsana bi7ida. Unttalla afa bettiduntsis adetits wolqqa ingginttida. Yesuusa markkatitsisin Xoozze qaala gisho fa ommito gachchinttide asunts shemppo, xootsizes woy xootsize misilito goynikaayzuntsanan malla fa sintte woy fa kushite aykkikaayzuntsana bi7ida. Unttin eera hyayqoppa denddii Kiristtoosara wolla mukul bere ka7itida.<note caller="-" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">Dane. 7:9</ref></char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>Yinna tiino denddo; attide hyayqqiduntsi mukul bere hyal7ode wontsis hyayqoppa denddikaaya. <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>Tiino denddes ixa yezuntsi anjjinttiduntsanan geeshshuntsana. Unttalla afa lam7intsa hyayqo adetits wolqqa baaya. Un Xoozzesin Kiristtoosas kahinunts maaqqada; eera wolla mukul bere ka7itoda.<verse eid="REV 20:6"/></para>
  <para style="s1">Xalahe gamintte</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>Mukul bere hyal7idannippa suuba Xalahe achchappa bilinttoda. <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>Oyddii sa7a zala yellodes yeze worzha, unttin, Googen Maagoge ga7inttizuntsana balitsii olas shiishodes kessada. Un faydita abba gaxa yeze shafe fana.<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EZK 38:2">Hiz. 38:2</ref></char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>Un sa7a ubba kezii, geeshshunts gutan Xoozii kadhide katamito wutii aykkida. Yezin tama saloppa wodhdhii unttana mu7ida.<verse eid="REV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 20:10"/>Unttana balitside Xalahize, xootsizen worddo nabize olinttide taman eexize diinne abba olinttida. Un qamman awara medhinas faxa ka7inttoda.<verse eid="REV 20:10"/></para>
  <para style="s1">Wurssutsi firdda</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>Yinnippa suuba, damma bootsi araatizella afa bettidaya bi7ida. Sa7an salon E tiinoppa aachinttida; mahi benttikaaya.<note caller="-" style="x"><char style="xo" closed="false">20:11-12 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">Dane. 7:9-10</ref></char></note> <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>Hyayqqiduntsi, dammuntsin eeratsuntsi araatize tiino eqqezin bi7ida; maxaafen bugunttida; mahi melle maxaafen bugunttida ezin de7o maxaafe, hyayqqiduntsi maxaafite xaafintti yezanni fana fa oochchitigaara firdda ekkida. <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>Abba fa gidda yeze hyayqqiduntsana inggida; hyayqon Si7oole fa gidda yeze hyayqqiduntsana inggidda. Fete fete fa oochchitigaara firdda ekkida. <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>Hyayqon Si7oole tama abba olinttida. Yinnan tama abbita lam7intsa hyayqo. <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>De7o maxaafite E suntsita xaafinttikaayze ooden tama abba olinttida.<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">Kille salon kille sa7a</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>Taanii kille salon kille sa7a bi7ida. Tiino salon tiino sa7a aadhida; abban yikkeppa gode yezoos.<note caller="-" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">Isa. 65:17</ref>; <ref loc="ISA 66:22">66:22</ref>; <ref loc="2PE 3:13">2 Phex. 3:13</ref></char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>Geeshi katamttan, kille Yerusalaame, azinii gelodes fana loytsii giigii yeze maachi fana saloppa Xoozze kaleppa wodhdhizin bi7ida.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">Isa. 52:1</ref>; <ref loc="REV 3:12">Qon. 3:12</ref>; <ref loc="ISA 61:10">Isa. 61:10</ref></char></note><verse eid="REV 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 21:3"/>Araatizeppa hyannigaara yaga7i, ohize damma qaala si7ida; «Xoozze Keetsita asunts gidda yene; unttara wolla aqoda, unttin E worzha maaqqada; Xoozii fa ommite unttara yessada; E unttis Xooz maaqqada.<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">Hiz. 37:27</ref>; <ref loc="LEV 26:11">Leewe 26:11</ref></char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>Xoozii un aaftippa afutsito ubba uccoda. Yikkeppa hyayqo woy azzano woy wuyse woy waaye yezoos. Tiino wogita ubba aadhida» gayda.<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">Isa. 25:8</ref>; <ref loc="ISA 35:10">Isa. 35:10</ref>; <ref loc="ISA 65:19">65:19</ref></char></note><verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>Araatizella bettide, «Taanii ubbanno kille mahoda» yagayda. Mahi taago, «Taanii ohidanna ammantsizanon turo maaqqide gisho xaafo» yagayda. <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>Mahi taago, «Folinttida! Taanii Alfan Oomega; Tiinon wurssutsi.<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">Isa. 55:1</ref></char></note>Baridhdhide oodesin de7o hyaatsi aafeppa ta hyarii ushshoda. <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>Gamide ooden yinno ubba laattoda; taanii ees Xooz maaqqada; ezin taas na7a maaqqada.<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Sam. 7:14</ref>; <ref loc="PSA 89:26">Maz. 89:26</ref></char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>Yezin zhashtizuntsin, ammanoosuntsi, tununtsi, shemppo wodhizuntsi, olalizuntsi, amudhizuntsii, bitizuntsii, eeqa goynizuntsin worddidhdhizuntsi ubbunts ixita diinne eexize tama abba maaqqada. Yinna lam7intsa hyayqo» yagayda.<verse eid="REV 21:8"/></para>
  <para style="s1">Kille Yerusalaame</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>Laappun wurssutsi hyanqo kumide laappun xuu7uto aykkide laappun kiitanchchuntsappa fetay taago yi7i, «Yo7o, gelodes giigide Durize machchito beessada» yagayda. <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>Kiitanchchize tana damma dhoqqa dere omma Ayyaanara kessii, geeshi katama, Yerusalaame, salo Xoozze kaleppa wodhdhodera beezida.<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="EZK 40:1">Hiz. 40:1</ref></char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>Yinna katamita Xoozze bonchchora foo7ane. Foo7itan iyasphphiide gaaze al77o shuchche fanan; kille geeshi birille fana. <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>Damman dhoqqa gase yene. Yinna gasitis taphpho lam77i furtsi yene. Yinna furtsito naagize taphpho lam77i kiitanchchuntsi yene. Furtsuntsalla afa taphpho lam77i Isra7eele zarunts suntsita xaafintti yene.<note caller="-" style="x"><char style="xo" closed="false">21:12-13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">Hiz. 48:30-35</ref></char></note> <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>Awa kessi zalara hyaydzdzii furtstsuntsi, wookka zalara hyaydzdzii furtstsuntsi, yeekka zalar hyaydzdzii furtstsuntsin awa gelo zalara hyaydzdzii furtstsuntsi yene. <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>Katama gasitis taphpho lam77i baasa yene. Unttalla afa taphpho lam77i Durize hawaaruntsi suntsita xaafintti yene.<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>Taas ohizes kiitanchchizes, katamtton, I furtsiton I gasito hyadhdhize worqqa gufe yene.<note caller="-" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">Hiz. 40:3</ref></char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>Katamttis oyddii zalara yene; pharggotitsitan I dalggatitsiti fana. Katamito fa gufizera hyadhdhin, lam77i mukul oyddii xeet kilo mitire maaqqida; pharggotitsita, dalggatitsitan dhoqqatitsita wolkke. <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>Gasito hyadhdhin, as kushera fettii xeeti oyttam oyddii hyadha maaqqida yinnan kiitanchcho hyadhas ekkizanno.<verse eid="REV 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 21:18"/>Gasita iyasphphiide gaaze shuchchara gasinttida. Katamita burccuqo fana geeshi worqqara oochinttida. <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>Katamttii gasita baasaran bonchcho shuchchara ubba lo77ida. Tiino baasize iyasphphiide, lam7intsize sanppeere, hyaydzantsize kelqqedoone, oydantsize meregid, <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>ichchintsize sarddonkise, izippuntsize sarddiyoone, laappuntsize kiristiloobe, osppuntsize birille, uddufuntsize wurawure, taphphintsize kirisphiraasise, taphpho fettintsize yaakintte, taphpho lam7antsize ametesxinoose.<verse eid="REV 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 21:21"/>Taphpho lam77i furtsuntsis taphpho lam77i inqo yene. Furtsuntsi fete fete inqora oochinttida. Katamiti furtsita burccuqo fana foo7ize geeshi worqqappa oochinttida.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">Isa. 54:11-12</ref></char></note><verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>Ubba ahize Laatstsi Xoozze Durize Xoozze keetstsi, yinne Xoozze keetstsi bi7ikaaya. <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>Xoozze bonchchita yinna katamttis foo7ize gishon Durize iis xomppe maaqqide gisho katamitis awa woy agina foo7o koshshoos.<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="ISA 60:19">Isa. 60:19</ref></char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>Derita yinna katamiti foo7ite hyanttoda; sa7a kaatuntsin fa bonchchito hyankka iigo ko7oda.<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">Isa. 60:3</ref></char></note> <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>Qamma yeyga baayze gisho katamiti furtstsuntsi ubba wode bugutsi maaqqada; gorddinttoos.<note caller="-" style="x"><char style="xo" closed="false">21:25-26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">Isa. 60:11</ref></char></note> <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>Ka7itumo saban bonchcho iigo ko7oda. <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>Durizes maaqqide de7o maxaafite suntsita xaafinttiduntsana xalaala fattin tuna baz woy yeellize baz oochchize woy worddo ooden yinna katamite mulo geloos.<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">Isa. 52:1</ref>; <ref loc="EZK 44:9">Hiz. 44:9</ref></char></note><verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>Yinnippa suuba, kiitanchchize tana Xoozzeppan Durize araatizeppa kezize burccuqqo fana foo7ize de7o hyaatsi borkka beezida.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">Hiz. 47:1</ref>; <ref loc="ZEC 14:8">Zakka. 14:8</ref></char></note> <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>Ye borkkize katama ogitis giddara goggane; borkkitis seekkan hyankka zala agina agina aafii bere taphpho lam77i tohe aafe inggize de7o minxa yene.<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Grike maxaafe minxize borkkasin oges gidda yene.</char></note> Ye minxize hyayita hyarggeppa fatstsane.<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medho 2:9</ref></char></note><verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>Yikkeppa gode aatse yezoos. Xoozzen Durize araatize ize maaqqada. Aruntsii Xoozzes goynoda.<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ZEC 14:10">Zakka. 14:10</ref></char></note> <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>Ezan be7ada; E suntsita un sintte maaqqada. <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>Yikkeppa qamma baaya; Laatstse Xoozze unttis xomppe maaqqide gisho unttis xomppe woy awa foo7o koshshoos. Un medhii medhinas ka7itoda.<note caller="-" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">Isa. 60:19</ref>; <ref loc="DAN 7:18">Dane. 7:18</ref></char></note><verse eid="REV 22:5"/></para>
  <para style="s1">Yesuusa ye7e</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>Kiitanchchize taago, «Hyanna ta ohize qaaltta ammaninttidannon turon. Laatstse Xoozze Geeshi Ayyaana fa nabuntsis inggide, ellera hyanodebaz fa aruntsana beessades fa Kiitanchcho kiittida» gayda. <verse eid="REV 22:6"/><verse number="7" style="v" sid="REV 22:7"/>Yesuusa, «Yikke ta ellisii yo7oda; hyanna maxaafite yeze tinbbite qaaltto naagize ooden anjjinttidaya» yagayda.<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>Taanii, Wahannisa, yinno si7ida; bi7ida. Taanii yinno si7ide woden bi7ide wode tana beezide Kiitanchchizes goynodes E tohitilla afa gol7ida. <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>Yezin ezin taago, «Yinno yiizippe! Taanii ne fana, nabunts fanan ne ishunts fana hyanna maxaafite yeze qaala naagize asuntsara wolla aro; Xoozzes goyno» yagayda.<verse eid="REV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10"/>Kiitanchchize taago, «Wode ukkida hyanna maxaafite xaafinttide tinbbite qaaltto mahitamera gorddippe. <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>Yikkeppa iita oochchize gujjii iita oochcho; tunize gujjii tuno. Xillizen gujjii xillo; geezhizay gujjii geezho» yagayda.<note caller="-" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">Dane. 12:10</ref></char></note><verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>«Yikke, taanii ellera yo7oda. Fetes fetes E oochchiti gaar immades waaga taara yene.<note caller="-" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">Isa. 40:10</ref>; <ref loc="ISA 62:11">62:11</ref>; <ref loc="PSA 28:4">Maz. 28:4</ref>; <ref loc="JER 17:10">Er. 17:10</ref></char></note> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>Alfan Oomegan; Tiinizen Wurssutsizen Dentsizen Folizen; Tana.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="REV 1:8">Qon. 1:8</ref>, <ref loc="REV 1:17">17</ref>; <ref loc="REV 2:8">2:8</ref>; <ref loc="ISA 44:6">Isa. 44:6</ref>; <ref loc="ISA 48:12">48:12</ref></char></note><verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>«De7o minxago yellodes adetits wolqqa yessade fanan, furtsara katamito gelodes fa ma7ito meeccizuntsi anjjinttiduntsana.<note caller="-" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medho 2:9</ref>; <ref loc="GEN 3:22">3:22</ref></char></note> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>Yezin kanuntsi, bitizuntsii, olale oochchizuntsi, shemppo wodhizuntsi, eeqa goynizuntsi, wordduntsin oochchizuntsi ubba bale yene.<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>«Taanii, Yesuusa, hyanna markkatitsito yinttis, woosa keetsuntsis ohode fana ta Kiitanchchiza kiittida. Taanii Dawute xaphon kochchi. Taanii foo7ize wontta goolixe» yagayda.<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">Isa. 11:1</ref></char></note><verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>Geeshi Ayyaanan gelodes giigide maachita, «Yo7o» ga7o. Si7ize «Hyankka yo7o» Baridhdhide hyankka yo7o; koyze ooden de7o hyaatsi hyarii ekko.<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">Isa. 55:1</ref></char></note><verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>Hyanna maxaafite xaafinttide tinbbite qaaltto si7ize oodesin ta markkidhada. Ooden hyanna qaalttilla afa fettibaz gujjiko, Xoozii hyanna maxaafite xaafinttide hyanqito eella afa gujjoda.<note caller="-" style="x"><char style="xo" closed="false">22:18-19 </char><char style="xt" closed="false"><ref loc="DEU 4:2">Mahe 4:2</ref>; <ref loc="DEU 12:32">12:32</ref></char></note> <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>Ooden hyanna tinbbite maxaafite xaafinttide qaalappa fettibaz facciziko, Xoozii hyanna maxaafite xaafinttide de7o minxa aafitippan geeshi katamttippa E ixito faccisada.<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>Hyanna ubba markkidhize, «Turo, taanii ellera yo7oda» yagaane.</para>
  <para style="p" vid="REV 22:20">Amin77e; Laatstsi Yesuusa, yo7o.<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>Laatstse Yesuus Kiristtoosa aadho keehatitsita yin ubbuntsara maaqqe. Amin77e.<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
