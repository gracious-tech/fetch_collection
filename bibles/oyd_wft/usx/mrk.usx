<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Oyda New Testament</book>
  <para style="h">Marqqoosa</para>
  <para style="toc1">Marqqoosa Xaafide Yesuus Kiristtoosa Wonggele</para>
  <para style="toc2">Marqqoosa</para>
  <para style="toc3">Mar.</para>
  <para style="mt1">Marqqoosa Xaafide</para>
  <para style="mt2">Yesuus Kiristtoosa Wonggele</para>
  <para style="imt1">Gele</para>
  <para style="ip">Marqqoosa Wonggele, «Hyay Xoozze na7a Yesuus Kiristtoosa Wonggele dentstse» yaga7i tiinii dentsane. Hyanna Wonggeltte Yesuusa oocha asin adetits wolqqa aden maaqqii shiiqida. E adetits wolqqita E timirttite, tuna ayyaanalla afa yeze wolqqiten asuntsana nagarappa maarizanne benttida. Yesuusa, «Taanii, asuntsana nagara arotitsappa kessodes tanatitsito aatsii inggodes yi7ide As Na7a» yaga7i fa doonara ohida.</para>
  <para style="ip">Marqqoosa Yesuusa taarikito luule ogeran wolqqa kumide ogera ohida. Marqqoosa Yesuusa qaaltton timirttito maaqqikaayzin E oochchide gaama qofize oochito tiinizi ohida. Marqqoosa Xammaqize Wahannisa taarikito, Yesuusa xinqqate E fattaninttidanno hyaatara ohi maaqqii, Yesuusa timirttiton E fatstsizanno dalggizii ohida. Aqii aqii hyammadera Yesuusa tamaaruntsi Yesuusa loytsii erii erii hyanggida, yezin Yesuusa ixxizuntsi wozzii ixxii ixxii hyanggida. Hyal7e zofanuntsi Yesuusa yessi hyaase saamintte folinttide oochchiti baz ohine. Yentsesin E suxintton E dendditi baz ohine. Wonggele faaditsite teqera benttide zofanuntsi fettii fettii maxaafite xalaala yene.</para>
  <para style="iot">Aafe Qofuntsi</para>
  <para style="io1">Wonggele dentstse <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Yesuusa Galila sa7a fa oocha aykkidanno <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Yesuusa Yerusalaame oochchide oocha <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Wurssutsi saamintta Yerusalaame kara gancce <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">Yesuusa hyayqoppa denddito <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Hyayqoppa denddide Laatstse qonccitsin Salo keze <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">Xammaqize Wahannisa oge giigizane</para>
  <para style="r">(<ref loc="MAT 3:1-12">Maato. 3:1-12</ref>; <ref loc="LUK 3:1-18">Luqa. 3:1-18</ref>; <ref loc="JHN 1:19-28">Waha. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Hyay Xoozze Na7a Yesuus Kiristtoosa Wonggele dentstse. <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Nabe Isayaasa xaafide maxaafite Xoozii,</para>
  <para style="q1" vid="MRK 1:2">«Yikke, taanii ta Kiitanchcho</para>
  <para style="q2" vid="MRK 1:2">neeppa tiino dakkoda.</para>
  <para style="q2" vid="MRK 1:2">E ne ogito giigisada.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil. 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Fetay akko baayze ganasa fa qaaltto dhoqi yiizii,</para>
  <para style="q2" vid="MRK 1:3">‹Laatstse ogito giigizote;</para>
  <para style="q2" vid="MRK 1:3">E yedhdhade wustto</para>
  <para style="q2" vid="MRK 1:3">ees giigizote gayda› »</para>
  <para style="m" vid="MRK 1:3">yagayda.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa. 40:3</ref></char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Xammaqize Wahannisa asuntsana xammaqittera, «Yin nagarttippa maaqqii xammaqinttote; Xoozii yin nagartto atto ga7oda» yaga7i qaala ohitera akko baayze ganasara yi7ida. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Yihuda sa7a yeze asuntsi ubban Yerusalaame katama asuntsi ubba Wahannisago ye7ine. Fa nagartto faaxin, Wahannisa unttana Yorddanoosa borkka xammaqida.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Wahannisa gimale isintseppa dadinttide afula ma77ida. Fa qazintte saqqe danccida; mahi boolen dekera shida mu7ida.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Kat. 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Wahannisa qaala ohitera, «Taappa suubara damma miinggize ye7ine. Melle atto yezin, taanii E caamma gaadiza zuggii billodes beezoos. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Taanii yinttana hyaatsara xammaqane, yezin E yinttana Geeshi Ayyaanara xammaqoda» yagayda.<verse eid="MRK 1:8"/></para>
  <para style="s1">Yesuusa Xammaqintton fattaninttidanno</para>
  <para style="r">(<ref loc="MAT 3:13-17">Maato. 3:13-17</ref>; <ref loc="MAT 4:1-11">4:1-11</ref>; <ref loc="LUK 3:21-22">Luqa. 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Yesuusa ye wode Galila awrajja yeze Naazirete katamappa yi7in, Wahannisa Yorddaanosa borkka xammaqida. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Yesuusa hyaatsitippa kezze wode salo bugunttin, Geeshi Ayyaana eella afa wolle gaara wodhdhodera bi7ida. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Mahi saloppa, «Taanii kadhize ta na7ay nena; ta neella ufayttane» yagaaze qaala yi7ida.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medho 22:2</ref>; <ref loc="PSA 2:7">Maz. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 3:17">Maato. 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar. 9:7</ref>; <ref loc="LUK 3:22">Luqa. 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Iira Geeshi Ayyaana Yesuusa akko baayze ganasa kanggida. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Yesuusa akko baayze ganasa Xalahera fattaninttitera oyttam qamma gam7ida. Xootsara yezida, yezin kiitanchchuntsi yi7i eza maaddida.<verse eid="MRK 1:13"/></para>
  <para style="s1">Yesuusa molo aykkize oyddii asuntsana xeegida</para>
  <para style="r">(<ref loc="MAT 4:12-22">Maato. 4:12-22</ref>; <ref loc="LUK 4:14-15">Luqa. 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Wahannisa acinttidannippa suuba Yesuusa Xoozze ka7itumo Wonggele ohitera Galila awrajja qitida. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>Ize, «Wode yellida; Xoozze ka7itumo ukkida. Yin nagarttippa maaqqii, Wonggele ammanote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Maato. 3:2</ref></char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Yesuusa Galila Abba kalera aadhitera, molo aykkize, Simoonaran E ishe Inddirasera, fa gitito<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="fqa" closed="false">Gite: </char><char style="ft" closed="false">Molo aykkize afula aazize baz.</char></note> Abba olizuntsana bi7ida. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Unttago, «Tana kaallote; ta yinttana as ayfo tamaarssoda» yagayda <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Unttii iira fa gitito olii ashshii Yesuusa kaallida.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Yesuusa eeratsi tiino hyanggi, lam77i ishuntsana Zabdoosa na7untsana, Yayqoobaran Wahannisara gongge gidda fa gitito giigizuntsana bi7ida. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>E unttana bi7ide gaar xeegida. Un fa adaya Zabdoosan, ees oochchizuntsara gongge gidda olii ashshii Yesuusa kaallii qitida.<verse eid="MRK 1:20"/></para>
  <para style="s1">Tuna ayyaana aykkide atstse faxida</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luqa. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Unttii Qifirnahoome katama yellida. Sambbata gelide gaar Yesuusa ellisii Ayhude woosa keetstsa gelii tamaarsse aykkida. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Adetits wolqqara yeze asi fana tamaarssanep attin higge asttamaarunts fana tamaarssoosse gisho asuntsi E timirttite gaama qoppida.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Maato. 7:28</ref></char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Ye wode tuna ayyaana aykkide fettii atstse Ayhude woosa keetstsa gelii fa qaaltto dhoqi yeyzi, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«Naazirete Yesuusa, neenii nuuppa akko koye? Nuna dhabssodes ne yi7ida? Ne oona yezako ta erane; ne Xoozze Geeshi.» Yagayda.<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Yesuusa ye tuna ayyaanza, «Hyayzo, hyay atstseppa kezo» ga7i seerida.<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>Tuna ayyaana atstsa labbizii, wuysizii ezappa kezida. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Asuntsi ubba gaama qoppii, «Hyanna akko? Hyay atstse fa adetits wolqqara melle atto yezin tuna ayyaanan kiittane. Unttii ees kiittinttane; hyanna akko kille timirtte?» yaga7i, fa gidda fete feta oocida.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Yesuusa markkatitsita ellisii Galila sa7a yeze guta ubba kezida.<verse eid="MRK 1:28"/></para>
  <para style="s1">Yesuusa gaama hyargginttizuntsana fatstsida</para>
  <para style="r">(<ref loc="MAT 8:14-17">Maato. 8:14-17</ref>; <ref loc="LUK 4:38-41">Luqa. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Yesuusa Ayhude woosa keetstsappa kezii, Yayqoobaran Wahannisaran Simoona karan Inddirase kara qitida. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Simoona machchiti intta damma otstsi michara hyarggintti woy7idanno Yesuusa ize yellin ees ohida. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>E iigo shiiqii, I kushito aykkii, izo dentsii essida. Otstsi michita ashshin iza unttana mokkida.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Hyargginttide asuntsanan tuna ayyaana aykkide asuntsana ubba ugure awa gelin eego ki7ida. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Katamite yeze asunts ubbuntsi yinna keetsiti bale shiiqida. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Yesuusa dumma dumma hyarggera aykinttide gaama asuntsana fatstsi, gaama tuna ayyaanuntsana kessida. E oode yezako tuna ayyaanuntsi eride gisho unttana ohaame fana kayda.<verse eid="MRK 1:34"/></para>
  <para style="s1">Yesuusa Galila tamaarssida</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luqa. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Yesuusa wontti maatse denddii, asi baayze bessa hyanggi, ize Xooz woossida. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Simoonaran eera yezuntsi eza koyitera qitida. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Unttii eza denggi, «Asi ubba nena koyane» yagayda.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Yesuusa mahi unttana, «Yinna gutute yeze seko katamite yedhdhote. Taanii yi7idanna Wonggele ohodes maaqqide gisho ize yeze guta ohodes beezane» yagayda. <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Ayhude woosa keetstsa qaala ohiteran tuna ayyaanuntsana kessitera, Galila sa7a ubba wutida.<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Maato. 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">Yesuusa qursuma hyargginttiza fatstsida</para>
  <para style="r">(<ref loc="MAT 8:1-4">Maato. 8:1-4</ref>; <ref loc="LUK 5:12-17">Luqa. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Qursuma hyargge aykkide fettii atstse Yesuusago yi7i, E tiintte bunqqunttii, «Neenii koyko tana geeshodes dandda7ane» yaga7i woossida.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Yesuusa ees yiqsinttii, fa kushito dakkii eza bochchi, «Taanii kadhane, geezho» yagayda. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Iira qursumtta atstsa dakkin atstse geezhida. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Yesuusa atstsa mintsii naagintto ga7i kessii dakkida. <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>Yesuusa eza, «Nena ero, hyanno oodesin ohippe. Yezin hyanggi ne galtto kahine beezo. Neenii hyatte geeshi maaqqidanno asuntsana ersodes, Muse kiittide zharshito zharsho» yagayda.<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">Leewe 14:1</ref></char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Yezin atstsay hyanggi, kara gancce as ubbuntsis ohida. Yinnii gisho, Yesuusa benttii kezii, katama gelodes dandda7ikaaya. Yezin asi baayze bessa gaxa yezida; mahi asuntsi ubba fa yeze bessappa eego ye7ine.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">Yesuusa wobbo atstsa fatstsida</para>
  <para style="r">(<ref loc="MAT 9:1-8">Maato. 9:1-8</ref>; <ref loc="LUK 5:17-26">Luqa. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Eeratsi qammappa suuba Yesuusa Qifirnahoome maaqqii, keetstsa yene gaaze wore sinttida. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Asuntsana keetstsita ekkaanxxi ixxin, melle atto yezin balttan un7ode wontsis gaama asuntsi shiiqin, Yesuusa qaala tamaarssane. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Oyddii asunts fettii wobbo atstsa tookkii eego ki7ida. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Asuntsi gaanggide gisho atstsa Yesuusago shiishodes unttis dandda7inttanxi ixxin, Yesuusa yeze zalara keetstsi aafto tookkii atstsa E woy7ide alggizera sulle ketstsii Yesuusa tiintte gaddida. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Yesuusa un ammantto bi7i, ye wobbo atstsa, «Ta na7ayo, ne nagartta atto ga7inttida» yagayda.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Higge asttamaaruntsappa yinna besite bettide fete fete fa wozintte, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«Naate hyay atstse hyannii gaar iita baz Xoozalla akkos ohe? Xoozza xalaalap attin melle oode nagara atto ga7odes dandda7ize?» ga7i qoppida.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Unttii fa wozintte yinnii gaara qoppidanno Yesuusa iira fa ayyaantte erii, unttago, «Yinttii yin wozintte akkos hyannigaara qoppete? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Wobbo atstsa, ‹Ne nagartta atto ga7inttida› gaazanna ukkeene? Woy, ‹Denddii eqqii ne alggiza tookkii qito› gaazanna ukke? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Yezin taas, As Na7ays, sa7alla afa nagara atto ga7odes adetits wolqqa yezanno yin erode gaar» ga7i ye wobbo atstsa, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«Nena gaane, denddii eqqii ne alggiza tookkii ne kara qito» yagayda.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>Atstse ellisii denddii eqqii, fa alggiza tookkii asi ubba be7izin qitida. Asuntsi ubba gaama qoppii, «Nuunii hyannii gaar gaama qofize baz bi7i eroos» yaga7i Xooz galatida.<verse eid="MRK 2:12"/></para>
  <para style="s1">Yesuusa Leewe xeegida</para>
  <para style="r">(<ref loc="MAT 9:9-13">Maato. 9:9-13</ref>; <ref loc="LUK 5:27-32">Luqa. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesuusa mahi Galila Abba gaxa hyanggi, faago yi7ide asuntsana ubba tamaarssida. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Iira aadhitera, Ilfiyoosa na7ay Leewe ga7inttize qaraxe gachchize besite bettidaya bi7i, «Tana kaallo» yagayda. Leewize denddii eqqii eza kaallida.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Yesuusa katstsa ma7ades Lewii keetstsa bettida. Eza kaallize asuntsi gaama maaqqide gisho qaraxe gachchize gaama asuntsin nagaranchchuntsi eeran E tamaaruntsara wolla bettida. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Higge asttamaare maaqqide fettii fettii Farisaawuntsi Yesuusa nagaranchchuntsaran qaraxe gachchizuntsara katstsa ma7adera bi7i, «E akkos nagaranchchuntsaran qaraxe gachchizuntsara katstsa me7e?» yaga7i, E tamaaruntsana oocida.<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Yesuusa un gaazanno si7i, «Hyargginttizes fattin faxas akime koshshoos. Taanii nagaranchchuntsana xeegodes yiiddap attin xilluntsana xeegodes yi7ikaaya» yaga7i unttis mahida.<verse eid="MRK 2:17"/></para>
  <para style="s1">Xooma baz erodes shiiqide ooce</para>
  <para style="r">(<ref loc="MAT 9:14-17">Maato. 9:14-17</ref>; <ref loc="LUK 5:33-39">Luqa. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Xammaqize Wahannisa tamaaruntsin Farisaawuntsi xoomane. Fettii fettii asunts Yesuusago yi7i, «Wahannisa tamaaruntsin Farisaawunts tamaaruntsi xoomane, yezin ne tamaaruntsi akkos xoomoso?» yagayda.<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Yesuusa unttago, «Sarge yi7ide asunts machcho ekkize unttara yezin, xoomodes dandda7ane? Machcho ekkize unttara yezin, xoomodes dandda7oos. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Yezin machcho ekkize un kaleppa ekinttodes wode ye7oda, un ye wode xoomoda.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«Gal7a ma7olla kille carqqe gaddii sikkize asi baaya. Gaddii sikkikon, killize gal7a ma7iza feedhane; feedhitsitan kasennippa aadhane. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Mahi mal7antto woyne gal7a silphe gujjize asi baaya. Mahi gujjikon, ye woynize silphiza feedhane, faasin lanttane, silphizen iitane. Yezin mal7antto woyne kille silphe gujjinttane» yagayda.<verse eid="MRK 2:22"/></para>
  <para style="s1">Sambbata baz erodes shiiqide ooce</para>
  <para style="r">(<ref loc="MAT 12:1-8">Maato. 12:1-8</ref>; <ref loc="LUK 6:1-5">Luqa. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Yesuusa fettii Sambbata qamma bangga gade giddara aadhodera, E tamaaruntsi eera hyanggitera bangga tizha shiccii dha7ane.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Mahe 23:25</ref></char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Farisaawuntsi Yesuusago, «Yikke, ne tamaarunts Sambbata qamma woga baayze baz akkos oochche?» yagayda.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Yesuusa unttago, «Dawute naydhdhii, muuze baz koyde wode faara yezuntsara oochchidanno ne nabbabika?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam. 21:1-6</ref></char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Abiyaatar kahinunts hyalaqa maaqqii yeze wode Dawute Xoozze keetstsa gelii, kahinunts xalaala ma7adep attin ooden ma7ades woga baayzanno Laatstse tiino gaddide daabbuto mu7ida, faara yezuntsisin inggida» yagayda.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Leewe 24:9</ref></char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Mahin Yesuusa unttago, «Sambbata as na7a maades ga7i medhinttidap attin asi Sambbatas medhinttikaaya. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Yinnii gisho, As Na7ay, melle atto yezin Sambbatasin Laatstsii» yagayda.<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Yesuusa kushe gundda atstsa fatstsida</para>
  <para style="r">(<ref loc="MAT 12:9-14">Maato. 12:9-14</ref>; <ref loc="LUK 6:6-11">Luqa. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Yesuusa Ayhude woosa keetstsa maaqqii gelida. Ize kushe gunddide fettii asi yene. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Fettii fettii asuntsi Yesuusa mootodes kezii, kushe gunddide atstsa Sambbata wode E fatstsikon ashshiko ga7i be7ades koyi mintsii naagane. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Yesuusa kushe gunddide atstsa, «Denddii eqqii hyankka gidda yo7o» yagayda. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Yinnippa suuba, asuntsago, «Sambbata wode lo77o baz oochchizanna wogaane iita baz oochchizanna woga? As shemppo ashshizannone woy wodhizanno?» yaga7i oocida.</para>
  <para style="p" vid="MRK 3:4">Yezin asuntsi si77i gayda. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Yesuusa antsinttii, unttana wututsii dakkii bi7i, un ohin si7oosuntsana maaqqide gisho unttalla afa gaama zhilidhdhida. Ye atstsego, «Ne kuciza fiddii yiizo» yagayda. Ezii fiddii yiizin E kucizen faxida. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Ellisii Farisaawuntsi Ayhude woosa keetstsappa bale kezii, Yesuusa wayzi wodhod yezako zorinttodes Heroodisa bagguntsara fettii bessa shiiqida.<verse eid="MRK 3:6"/></para>
  <para style="s1">Asuntsi Yesuusago shiiqida</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesuusa fa tamaaruntsara Galila Abbago hyanggida. Galilappan Yihudappa yi7ide gaama asuntsi eza kaallida. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Mahin Yerusalaameppa, Edumiyasappa, Yorddaanosa borkka fintsappa, Xiroosa katamappan Sidoona katamappa Yesuusa oochchidanno si7i, gaama asuntsi eego yi7ida. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Asi gaanggidannippa denddii eza un7itsaame fana E tamaaruntsi gongge ees giigisade gaar kiittida.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar. 4:1</ref>; <ref loc="LUK 5:1-3">Luqa. 5:1-3</ref></char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Gaama asuntsana E fatstside gisho hyargginttize asunts ubba eza bochchodes urqqinttane. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Tuna ayyaana aykkide asuntsi eza bi7ide wode E tiintte bunqitii, fa qaaltto dhoqi yiizii, «Neenii Xoozze Na7a baane?» yagayda.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>Yesuusa gaama wode tuna ayyaanuntsi fa oonatitsito qonccizaame fana unttana mintsii kiittida.<verse eid="MRK 3:12"/></para>
  <para style="s1">Yesuusa taphpho lam77i hawaaruntsana doorida</para>
  <para style="r">(<ref loc="MAT 10:1-4">Maato. 10:1-4</ref>; <ref loc="LUK 6:12-16">Luqa. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Yesuusa derella afa kezii, fa koyze asuntsana faago xeegida; unttin eego shiiqida. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Un faara yessade gaaran qaala tamaarssode gaar taphpho lam77untsana doorii, unttana, «Hawaare»<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fk" closed="false">Hawaare: </char><char style="ft" closed="false">Hawaare gaazanna kiitinttiduntsana ga7e. </char></note> ga7i suntsida. <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>Tuna ayyaana kessode gaar unttis adetitsi wolqqa inggida.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>E dooride taphpho lam77untsi hyantsesana: Phexiroosa ga7i suntside Simoona, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Bo7anergges (Dada aazize asuntsana) yaga7i suntsiduntsana, Zabdoosa na7unts Yayqoobaran Yayqooba ishe Wahannisa, <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Inddirase, Filphoosa, Barttolomiyoosa, Maatoosa, Toomaasa, Ilfiyoosa na7a Yayqooba, Taadiyosa, Kananeppa yi7ide Simoonara, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>Yesuusa aatsii inggide Asqorootu Yihuda.<verse eid="MRK 3:19"/></para>
  <para style="s1">Yesuusan Bi7elzebuulan</para>
  <para style="r">(<ref loc="MAT 12:22-32">Maato. 12:22-32</ref>; <ref loc="LUK 11:14-23">Luqa. 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Yinnippa suuba, Yesuusa kara hyanggida. Mahi gaama asunts shiiqin, ezin E tamaarunts melle atto yezin katstsa ma7adesin un dandda7ikaaya. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Asunts eza, «Zhaashtane» gaaze gisho E iginuntsi yinno si7i eza ekkodes hyanggida.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Higge asttamaaruntsappa fete fete Yerusalaameppa yi7i, «Eella afa Bi7elzebuula yene», E, «Xalahe wolqqara tuna ayyaana kessane» yaga7i wolla ohinttida.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato. 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Yesuusa asuntsana faago xeegii aazizer ohida. «Xalahe Xalahe wayzi kessodes dandda7e? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Fettii ka7itumo fa gidda shaakkinttiko yinna ka7itumtta eqqodes dandda7oos. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Yinnii gaara, fettii keetstsa asuntsi fa gidda shaakkinttiko dhabodap attin yessades dandda7oos. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Yikke, Xalahe faara kacinttii shaakkinttiko dhabodap attin yessades dandda7oos.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«Yinnii gaara tiino wolqqar yeze atstsa accikaayzara E keetstsa gelii, E qoltto bonqodes dandda7ize asi baaya. Accii maaqqii E keetsito bonqodes dandda7ane.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«Taanii yinttis turo ohine; Xoozii as na7untsis nagara ubbannon un cazhize cashito ubba atto ga7oda. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Yezin Geeshi Ayyaanalla iita baz ohize medhinas nagara gale maaqqadep attin Xoozii mulon eza maaroos» yagayda.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luqa. 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Yesuusa yinno ga7idanna, fettii fettii asunts, «Eella afa tuna ayyaana yene» yagayde gisho.<verse eid="MRK 3:30"/></para>
  <para style="s1">Yesuusa intton E ishuntsanan</para>
  <para style="r">(<ref loc="MAT 12:46-50">Maato. 12:46-50</ref>; <ref loc="LUK 8:19-21">Luqa. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>E inttan E ishuntsin yi7i bale eqqii, eego asi kiittii eza xeegida. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>E kale bettide gaama asuntsi, «Yikke, ne inttan ne ishuntsin bale eqqii nena koyane» yagayda.<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Yesuusa mahi, «ta intta oode? Mahi ta ishuntsin aanuntsana?» yagayda. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Fa kantte bettide asuntsana wututsii dakkii bi7i, «Yikke, ta inttan ta ishuntsin hyantsesana. <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Xoozze qofa oochchize ubbuntsi taas ishen, taas mishon taas inddo» yagayda.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Budutsi budize atstse aazize</para>
  <para style="r">(<ref loc="MAT 13:1-9">Maato. 13:1-9</ref>; <ref loc="LUK 8:4-8">Luqa. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Yesuusa mahi Galila Abba kale tamaarssane. Gaama asunts E kantte wutii shiiqin, abballa yeze gonggite gelii bettida, asunts ubba Abba kale yene. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>E unttana gaama baz aazizera tamaarssida. Tamaarssitera hyannigaara yagayda:<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>«Yikke! Fettii atstse budutstsi budodes kezida. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>E budodera, fettii fettii budutstsita oge gaxa wodhdhida; Landda yi7i mu7ida. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Fettii fettii budutstsita forchcho sa7alla wodhdhida. Gaama sa7a baayze gisho yinna budutstsita ellisii dolida. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Yezin awa kezze wode shullida. Loytsii xapho dakkikaayze gisho ellisii melida. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Fettii fettii budutsita anggatsi gidda wodhdhida. Dolidanno anggatsita diccii cuullide gisho aafe aafikaayzara attida. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Fettii fettii budutstsita aradda sa7a wodhdhii dolida. Diccii fete hyasttam, fete izippun tam fete xeet aafida» yagayda. <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>«Si7ize hyaye yeze ooden si7o» yagayda.<verse eid="MRK 4:9"/></para>
  <para style="s1">Yesuusa aazizera akko ohezako</para>
  <para style="r">(<ref loc="MAT 13:10-17">Maato. 13:10-17</ref>; <ref loc="LUK 8:9-10">Luqa. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Yesuusa ohidanno si7ide fettii fettii asuntsi taphpho lam77i tamaaruntsara yezunts Yesuusa fa xalaala yessadera, eego shiiqii yinna aazizitis bilitsito oocida. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Yesuusa unttago hyannii gaar yagayda: «Yinttis Xoozze ka7itumo gaatsi qofa erodes ingginttida. Yezin melluntsis ka7itumoppa balera yezuntsis ubba bazi aazizera ohinttane. <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Hyanna hyanidanna,</para>
  <para style="q1" vid="MRK 4:12">«Unttii be7ine, yezin denggoos.</para>
  <para style="q2" vid="MRK 4:12">Si7ine, yezin tiiroos.</para>
  <para style="q2" vid="MRK 4:12">Unttii denggizakon tiirzako,</para>
  <para style="q2" vid="MRK 4:12">Xoozago maaqqada</para>
  <para style="q2" vid="MRK 4:12">ezin unttana maaroda yeshsha»</para>
  <para style="m" vid="MRK 4:12">yagayda.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa. 6:9</ref></char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">Budutsi aazize bilitsito</para>
  <para style="r">(<ref loc="MAT 13:18-23">Maato. 13:18-23</ref>; <ref loc="LUK 8:11-15">Luqa. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Yesuusa unttago, «Hyanna aazizta yinttis geloso? Yeezin, aazize ubba yin wayzi tiirode? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Budizay Xoozze qaala budane. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Qaala budinttize wode oge gaxa wodhdhidunts qaala si7izuntsana. Yezin Xalahe iira yi7i, un wozintte budinttide qaaltto maxii hyaasane. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Yinnii gaara, forchcho sa7a budinttide qaala si7i, ellisii ufaytti ekkizuntsana. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Yezin unttis mintsii xapho baayze gisho hyattes fattin gam7oos. Eerats wodeppa suuba qaala gisho madhan woy baytstsii yellide wode ellisii dhubunttane. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Anggatsi gidda budinttide qaala si7izuntsana. <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>Yezin hyanna sa7a yessis yirggan, durtumo kadhen dumma dumma amotitsi un wozintte gelii qaaltto cuullize gisho aafe aafikaayzara attida. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Yezin aradda sa7a budunttezuntsi qaala si7i ekkizuntsana. Unttii fete hyasttam, fete izipuntam fete xeet aafida» yagayda.<verse eid="MRK 4:20"/></para>
  <para style="s1">Aachichcha yeze xomppe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luqa. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Yesuusa gujjii, «Xomppe ekkii, gabate gidda woy algga oomo gaddize asi yene? Dhoqqa bessa gaddosaane?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Maato. 5:15</ref>; <ref loc="LUK 11:33">Luqa. 11:33</ref></char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Yikke, aachinttide baz ubba qoncce kessada; aachinttide baz ubba erinttikaayzara attaama.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Maato. 10:26</ref>; <ref loc="LUK 12:2">Luqa. 12:2</ref></char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Si7ize hyaye yeze ooden si7o» yagayda.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Mahi unttago, «Yin si7ize baz qofar si7ote! Xoozze qaala yin si7izanni fana E yinttis qofa inggoda. Yinttis makkizanne gaantsi inggoda. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Yeze atstses gaantsi ingginttoda, baayze atstseppa melle atto yezin, ees yeze yinna eeratsitan ekinttoda» yagayda.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Maato. 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luqa. 19:26</ref></char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">Diccize budutstsiti aazize</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Yesuusa mahi, «Xoozze ka7itumo fa gadite budutstsi budize atstse fana. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Ye atstse qamma genttane wontta denddane. E fa ommite wayzakon erikaayzara yessadera yinna budutsita dolii diccane. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Gaditan katstsa fa faas inggane. Tiino dolii diccane, suubite aafodes gambbuxane, wurssutsite kumutsi aafe aafane. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Yezin katsita yellide wode atstse maxane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">Iyu. 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">Aafe eeratsi minxa aazize</para>
  <para style="r">(<ref loc="MAT 13:31-34">Maato. 13:31-34</ref>; <ref loc="LUK 13:18-19">Luqa. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Yesuusa, «Nuunii Xoozze ka7itumo akko fana ga7ode? Woy akkora aazissade? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Xoozze ka7itumo aafe eerats minxa aazane. Ye minxa aafize budize wode sa7alla yeze minxa aafe ubbappa laafane. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Budin dolii minxa ubbappa dammane; damma daashi daazhane. Landduntsi E tirshitilla afa keexxii bettode wontsis daazhane» yagayda.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yesuusa hyannii gaar gaama aazizera asunts tiirodes dandda7ode gaar qaala ohida. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Asuntsis aazize baytsi ohoos. Yezin Yesuusa fa tamaaruntsara xalaala yeze wode unttis ubbabazito billii ohida.<verse eid="MRK 4:34"/></para>
  <para style="s1">Yesuusa abba zuluntto si7i yiizida</para>
  <para style="r">(<ref loc="MAT 8:23-27">Maato. 8:23-27</ref>; <ref loc="LUK 8:22-25">Luqa. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Ye wode sa7ita ugurin, Yesuusa fa tamaaruntsago, «Abbappa seko gaxa fiinggoda» gayda. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>E tamaarunts gaama asuntsana olii ashshii ashshii, Yesuusa tiino gelii bettide gonggize gidda gelii Yesuusa faara ekkii qitida. Melle gongguntsin ize yene. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Damma gote denddii, zuluntta gonggiza guuddin, hyaatsita kumode wontsis gonggize gidda gelida. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Ye wode Yesuusa gonggizes suuba zalara borkkotsi gaddii genttida. E tamaarunts eza barkkizii, «Asttamaazayo, nu dhabize wode nena yiqsosaane?» yagayda.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Yezin, E barkki zuluntto, «Seerii», abbizan, «Si7i ga7o» yagayda. Zulunttan si77i ga7in ubba bazi woppu gayda. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Yesuusa fa tamaaruntsago, «Akkos hyannigaara zhashitete? Yinttis ammano wayzi dhabido?» yagayda.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Unttii gaama zhashtii fa gidda, «Hyay melle atto yezin, goten abban kiitinttize oode?» yagayda.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">Tuna ayyaana aykkide atstse faxida</para>
  <para style="r">(<ref loc="MAT 8:28-34">Maato. 8:28-34</ref>; <ref loc="LUK 8:26-39">Luqa. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Yesuusan E tamaaruntsi abba fiinggi, Gerggesoone gaaze sa7a yellida. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Yesuusa gonggizeppa wodhdhize wode tuna ayyaana aykkide fettii atstse boozappa kezii eera yellinttida. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Ye atstse booza gidda aqii feezhii yene. Eza ooden gaadera accodes dandda7oos. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>E gaama tohe duullaran santsalaatara acinttii yene. Yezin santsalaaton duutsane, duullizan mentsitsane. Eza mahodes dandda7ize ooden baaya. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>E qamman awara yinna booziten derellan wuyssane, fa galtton shuchchara qawuxane.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Yesuusa hyaakora bi7ide wode woxxii hyanggi E tiintte bunqunttida. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>Ye atstse fa qaaltto dhoqi yiizii, «Ubbappa kattara yeze Xoozze Na7a Yesuusa, neera tana akko yeltsize? Tana dhabssaame gaar taanii nena Xoozze suntsite woossane» yagayda. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>E yinno gaydanna Yesuusa eza, «Naate hyay tuna ayyaanzayo, hyay atstseppa kezo» yagayde gisho.<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Yesuusa eego, «Ne suntsita oode?» yaga7i oocida.</para>
  <para style="p" vid="MRK 5:9">E, «Nuunii gaama maaqqide gisho ta suntsita Leegiyona» yagayda. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Tuna ayyaanuntsi fana yinna gaditippa kessii dakkaame gaar Yesuusa mintsii woossida.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Ye derizella gaama gudayille wude yengginttane. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Tuna ayyaanuntsi Yesuusago, «Nuna sekka gudayille wudute dakkoya, un gidda hyanggi geloda» yaga7i woossida. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Yesuusa unttago, «Qitote» yagayda. Yeezin tuna ayyaanuntsi atstseppa kezii gudayluntsi gidda gelida. Lam77i mukul maaqqade gudayille wude gaga doonara woxxii hyanggi abba gelii qoodhdhinttida.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Gudayille wude yenggizuntsi woxxii hyanggi hyanidanno katamaran gaxarera ohida. Yezin asuntsi hyanidanno be7ades kezida. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Asuntsi Yesuusago ye7ize wode tuna Ayyaanara aykinttide atstsa bi7ida. E fa wozintte maaqqii, ma7o ma77i, ize bettidanno be7ize wode ubbuntsi zhashtida. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Yinno bi7ide gaar asuntsi tuna ayyaanuntsi aykkide atstsella afan gudayluntsalla afa hyanidanno ubba asuntsis ohida. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Yinnii gisho, asunts fa sa7itippa Yesuusa kezode gaar woossida.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Yesuusa gonggite gelze wode tiino tuna ayyaana aykkii dakkide atstse, Yesuusara hyanggodes eza woossida. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Yezin Yesuusa ixxii eego, «Ne kara maaqqii, Laatstsii nees akko gaar damma baz oochchezakon akko gaar maarezako ne kara asuntsis oho» yagayda. <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Atstsay hyanggi Taphphi Katama ga7inttize sa7a wutii, Yesuusa faas akko gaar damma baz oochchezako ohida. E ohidanno si7ide asunts ubbuntsi gaama qoppida.<verse eid="MRK 5:20"/></para>
  <para style="s1">Hyayqide na7iton Yesuusa ma7ito bochchide maachito</para>
  <para style="r">(<ref loc="MAT 9:18-26">Maato. 9:18-26</ref>; <ref loc="LUK 8:40-56">Luqa. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Yesuusa maaqqii, gongge gelii, abba fiinggidannippa suuba gaama asuntsi abba gaxa E kale wutii shiiqida. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Iyaroosa gaaze Ayhude woosa Keetstsa hyalaquntsappa fete, Yesuusa bi7ide wode eego yi7i E tohitilla afa <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>gol7i, «Ta naata hyargginttii hyayqqodes yi7ine. Iza faxii yessade gaar yi7i ne kushito iilla afa gaddoya» yaga7i Yesuusa mintsii woossida.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Yesuusa Iyaroosara qitida. E hyammadera gaama asuntsi Eza kaallii un7itsida.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Taphpho lam77i bere I gallitippa suutsi goggize fettii maachita yene. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Gaama akimuntsi izo akimida, yezin iza faxa ka7inttida. Iza fa qoltto ubba hyaasinin iisi hyanka iitidap attin akkon maaddikaaya. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Yinna maachita Yesuusa baz si7i, asuntsana aadhii Yesuusa suubara yi7i E ma7ito bochchida. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Iza, «Taanii melle atto yezin E ma7ito bochchizako faxoda» ga7i qoppida.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Iippa goggize suutsita iira eqqii attida. Iza fa waaytippa faxidanno fa gallite erida. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Yesuusa iira faappa wolqqa kezidanno fa ommite erii, gaama as gidda suub maaqqii, «Ta ma7ito bochchide oode?» yagayda.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>E tamaaruntsi, «Asuntsi nena urqqizanno bi7itera, ‹Wayzi tana oode bochchide ga7e?› » yagayda.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Yesuusa yinno oonii oochchezako be7ades wututsii dakkii bi7ida. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Yezin maachita faas hyanidanno erii, zhashimora goqitera yi7i Yesuusa tiintte gol7ida; mahi hyanidanno ubba turtto ees ohida. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Yeyin, Yesuusa iigo, «Na7ite, nena ne ammantta fatstsida, sarora qito, ne waaytippa faxo» yagayda.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Yesuusa hyaga yinno ohodera, Ayhude woosa Keetstsa hyalaqa karappa kiitinttide asuntsi yi7i, «Ne naata hyayqqida, asttamaariza akkos labbize?» yagayda.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Yezin Yesuusa un gaazanno si7i, Ayhude woosa Keetstsa hyalaqizego, «Ammano xalaala ammanop attin zhashtippe» yagayda. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Yesuusa Phexiroosappa, Yayqoobappan Yayqooba ishe Wahannisappa melle ooden fana kaallaame gaar kayda. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Unttii Ayhude woosa Keetstsa hyalaqize kara yellide wode Yesuusa asuntsi wozina dhabii yeekkizuntsanan zeleluntsana bi7ida. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Gelii asuntsago, «Akkos muuzhii yeekkete? Naata genttidap attin hyayqqikaaya» yagayda.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Asuntsi eella afa miicida. Yezin asuntsana ubba bale kessii, naatii adayan, intton hyaydzdzii tamaaruntsana faara ekkii naata yeze besite gelida. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Yesuusa naatii kushito aykkii, «Xaalita, quumii» (Eeratsi na7ite, nena gaane denddo) yagayda.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Naata iira denddii eqqii yedhdhida. Iza taphpho lam77i bere na7a. Yinne asuntsi gaama qoppida. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Yesuusa yinno un oodesin ohaame gaar unttana mintsii kiittida. Unttii iis mu7ize baz immade gaar ohida.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">Yesuusa Naazirete ixinttida</para>
  <para style="r">(<ref loc="MAT 13:53-58">Maato. 13:53-58</ref>; <ref loc="LUK 4:16-30">Luqa. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Yesuusa izippa kezii, fa tamaaruntsana kaalitsi, fa katama Naazirete yi7ida. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Sambbata wode Ayhude woosa Keetstsa tamaarsse aykkida. E tamaarssizanno si7ide gaama asuntsi gaama qoppii, «Hyay hyanno ubba abappa denggido? Hyanna cinccatitsita ees anapp inginttido? Hyanna E kushite oochinttize kille bazito oochchize wolqqa Ees oonii inggido?<figure style="fig" alt="Man reading inside synagogue" file="LB00244B.TIF" size="span" ref="6:2">Asi na7ay Ayhude woosa keetsa nabbabane </figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Hyay anaaxe na7a baane? Mayrami na7a, Yayqooba, Yoosa, Yihudan Simoona ishe baane? E mishuntsi nuura hyanne yezuntsana baane?» yaga7i, E gaazanno si7anxi ixxida.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Yesuusa yentsi asuntsago, «Nabe fa gade, fa iginuntsi giddan fa kara asunts gidda bonchchinttoos fattin melluntsi kale bonchchinttane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">Waha. 4:43</ref></char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>E yinna besite fa kushito eeratsi asuntsalla afa gaddii fatstsidannip attin melle gaama qofize baz oochchodes dandda7ikaaya. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Asuntsi ammanikaayze gisho gaama qoppida. Yinnippa suuba Yesuusa yinna gutute yeze asuntsana tamaarssane.<verse eid="MRK 6:6"/></para>
  <para style="s1">Yesuusa taphpho lam77i tamaaruntsana kiittida</para>
  <para style="r">(<ref loc="MAT 10:5-15">Maato. 10:5-15</ref>; <ref loc="LUK 9:1-6">Luqa. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>Yesuusa taphpho lam77i tamaaruntsana faago xeegii, lam77i lam77i mahi kiittida. Unttis tuna ayyaanalla adetits wolqqa inggida. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Unttana, «Oges gufep attin katstsa, karxite, yin kiistte bira akko bazin aykkippete.<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luqa. 10:4-11</ref></char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Yin tohite caamma aatstsote, fattin lam77i afula aykkippete» yagayda. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Mahin, «Yinttana asi mokkize keetstsa aba maaqqikon yinna bessitippa kezii qitode wontsis yinna keetstsite gam7ote. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Yinttana asi mokkoosse bessa woy yin ohizanno si7oosse bessa aban maaqqiko, yinna sa7ite yeze asuntsis yin markka maaqqade gaar yinna bessitippa kezitera, yin tohite yeze xurito fixxote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Hawa. 13:51</ref></char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Taphpho lam77i tamaaruntsi hyanggi, asuntsi fa nagarttippa maaqqade gaar qaala ohida. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Unttii asappa gaama tuna Ayyaana kessida. Gaama hyargginttizuntsana zayte tizhii fatstsida.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yay. 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">Xammaqize Wahannisa hyayqo</para>
  <para style="r">(<ref loc="MAT 14:1-12">Maato. 14:1-12</ref>; <ref loc="LUK 9:7-9">Luqa. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Yesuusa suntsita ubba bessa kezide gisho Kaat Heroodisa E baz si7ida. Fettii fettii asuntsi, «Xammaqize Wahannisa hyayqoppa denddida, yinnii gisho hyanna kille bazito oochchize eza» yagayda.<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Maato. 16:14</ref>; <ref loc="MRK 8:28">Mar. 8:28</ref>; <ref loc="LUK 9:19">Luqa. 9:19</ref></char></note><verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Bagguntsi, «Hyay Eeliyaasa» yagayda.</para>
  <para style="p" vid="MRK 6:15">Melluntsi mahi, «Hyay zaga wode nabuntsappa fetaya» yagayda.<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Yezin Heroodisa yinno si7ide wode «Hyay taanii afurtto gachchizide Xammaqize Wahannisa. E hyayqoppa denddida» yagayda.<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Heroodisa fa ishe Filphoosa machchito Heroodiyada ekkide gisho I mikinaatis Wahannisa aytstsii accizida. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Wahannisa Heroodisago, «Neenii ne ishe machchito ekkodes beezoos» yagayda.<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luqa. 3:19-20</ref></char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Heroodiyada Wahannisa fa wozintte ixxii eza wodhissades koyda, yezin dandda7ikaaya. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Wahannisa xillon geeshi as maaqqidanno Heroodisa eride gisho ees zhashtii loytsii naagizane. Heroodisa Wahannisa gaaze baz si7ize wode tannane. Yezin ufaytti si7ine.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Heroodisa fa yelinttide qammito bonchchodes gade ahizuntsana, shaalaquntsisin Galila yeze damma asuntsis diggisa giigizida. Yinna Heroodiyadas wottize wode maaqqida. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Heroodiyada na7ita zaqquntsi mokunttize keetstsa gelii durii, Heroodisan E zaquntsana ufayssida. Kaatize naatigo, «Ne koyze akko maaqqikon tana ooco, ta nees inggoda» yagayda. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Mahi iisi caaqqii, «Neenii oocize akko maaqqikon, taanii nees inggoda. Melle atto yezin, ta ka7itumtti baggito maaqqikon ta nees inggoda» yagayda.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Naata bale kezii fa inttigo, «Akko inggo gawune?» ga7i oocida.</para>
  <para style="p" vid="MRK 6:24">I intta, «Xammaqize Wahannisa ommito inggo ga7o» yagayda.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Naata ellisii kaatizego hyanggi, «Xammaqize Wahannisa ommito saane gidda gaddii hyatte taas immade gaar koyane» gayda.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Yaga7in Kaatize gaama zhilidhdhida, yezin fa zaqqunts gisho iisi caaqqide fa caaqito ashshodes koykaaya. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Yinnii gisho, ellisii naagizego Wahannisa ommito ko7ode gaar kiittida. Naagizen achchi keetstsa hyanggi Wahannisa afurtto gachchida. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>Ye gachchinttide ommiza saane gidda gaddii ki7i naatis inggida. Naata mahi fa inttis inggida. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Wahannisa tamaaruntsi yinno si7ide wode hyanggi E ahito ekkii kanggi moogida.<verse eid="MRK 6:29"/></para>
  <para style="s1">Yesuusa ichchin mukul asuntsana muuzida</para>
  <para style="r">(<ref loc="MAT 14:13-21">Maato. 14:13-21</ref>; <ref loc="LUK 9:10-17">Luqa. 9:10-17</ref>; <ref loc="JHN 6:1-14">Waha. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Taphpho lam77i hawaaruntsi maaqqii yi7i un oochchidannon tamaarssidanno ubba Yesuusas ohida. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Unttago yi7ize asuntsin qitize asuntsi gaanggide gisho Yesuusaran E tamaaruntsara, melle atto yezin katstsa maadesin unttana yeltsanxi ixxida. Yeyin, Yesuusa unttago, «Ye7ote wolla eeratsi shemppodes asi baayze bessa yedhdhote» yagayda. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Yinnii gisho, unttii fa faas gongge gelii asi baayze bessa qitida.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Unttii hyammadera gaama asuntsi unttana bi7i erida. Yezin, katama ubbappa asuntsi tohera woxxii hyanggi un qitize bessito unttappa tiinii yellida. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Yesuusa gonggizeppa wodhdhii gaama asuntsana bi7ida. Asuntsi yenggize asi baayze duro fana maaqqidanno bi7i unttis yiqsinttii unttana gaama baz tamaarssida.<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Faydo 27:17</ref>; <ref loc="1KI 22:17">1 Kat. 22:17</ref>; <ref loc="EZK 34:5">Hiz. 34:5</ref>; <ref loc="MAT 9:36">Maato. 9:36</ref></char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Sa7ita ugurize wode Yesuusa tamaaruntsi eego yi7i, «Hyanna bessita asi baayze bessi; hyatte sa7itan qammida. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Asuntsi kara ganccen katama hyanggi faas muuze baz wonggode gaar asuntsana dakko» yagayda.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Yezin Yesuusa mahi unttago, «Asuntsis muuze baz yin inggote» yagayda.</para>
  <para style="p" vid="MRK 6:37">Un, «Nuunii hyanggi lam77i xeet dinaarer<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Dinaare gaaze fettii asis oochchii feezhidannis ingginttize bira</char></note> boora wonggi asuntsana muuzode gaar koyane?» yaga7i oocida.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Yesuusa unttago, «Yinttis wantsi boora yeze? Ane hyanggi bo7ote» yagayda.</para>
  <para style="p" vid="MRK 6:38">Unttii bi7i, «Ichchin booran lam77i molon» yagayda.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Yesuusa fa tamaaruntsana asuntsana ubba gachcho gachcho tagii betitsode gaar kiittida. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Asuntsi baggita xeet, bagita ichintam maaqqii likkera likkera tagintti bettida. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Yesuusa ichchin boortton lam77i moluntsana ekkii, ude salo bi7i Xooz galatida. Boortto baxxi asuntsis yeltsode gaar tamaaruntsis inggida. Mahi lam77i moluntsana un ubbuntsis gishida. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Asunts ubba mu7i mizhida. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Attide boora gupan molo gufan, E tamaaruntsi taphpho lam77i leemate kumutsi dentstsida. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Boortto mu7ide dhiiratsi asuntsi xalaala ichchin mukul maaqqada.<verse eid="MRK 6:44"/></para>
  <para style="s1">Yesuusa abballa afa yedhdhida</para>
  <para style="r">(<ref loc="MAT 14:22-33">Maato. 14:22-33</ref>; <ref loc="JHN 6:15-21">Waha. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Ellisii Yesuusa fa tamaaruntsi gongge gelii, abbappa seko fintsa yeze Beetesayda faappa tiinii qitode gaar kiittida. Yezin faas asuntsana moyzodes suub attida. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Asuntsana moyzidannippa suuba Xooz woossodes derella afa kezida.<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>Sa7ita qammize wode gonggize abba gidda yene, yezin Yesuusa abbappa gaxa faas yene. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Baqo E tamaaruntsago baqize gisho abba fidhizanna waaysizanno Yesuusa bi7ida. Wontti maatse Lukule oollodes yi7ize wode E abballa afa yedhdhitera unttago yi7i, unttana olii aadhades koyda. <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>Yezin E abballa afa yedhdhadera, un bi7i, unttis meeshe aazin uukkida. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Un ubbuntsi eza bi7i, zhashmora tannida.</para>
  <para style="p" vid="MRK 6:50">Yezin Yesuusa ellisii unttago, «Tana, akkon baaya; zhashtippete» yagayda. <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>E gongge gelii unttara wolla bettin baqita woppu gayda. Unttii gaama qoppida. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Un wozintta doccide gisho un boorttii baz tiirikaaya.<verse eid="MRK 6:52"/></para>
  <para style="s1">Yesuusa Gensareexe hyargginttizuntsana fatstsida</para>
  <para style="r">(<ref loc="MAT 14:34-36">Maato. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Unttii abba fiinggi, Gensareexe sa7a yellii, gonggiza gaxalla shiishii accida. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Unttii gonggizeppa wodhdhize wode asunts ellisii Yesuusa erida. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Unttii kara gancce yeze sa7a ubba woxxii yellii hyargginttizuntsana shanchafara tookkii, «Yesuusa yene» ga7in si7ide besite ki7ida. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Asuntsi E hyanggide keetstsa ubba, gaxare maaqqikon, katama, yeze hyargginttizuntsana asi shiiqize bessa kanggane. Hyargganchchuntsii E afula macartto maaqqikon bochchode gaar asuntsi eza woossida. Bochchide ubbuntsi faxida.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Zaga adunts woga</para>
  <para style="r">(<ref loc="MAT 15:1-9">Maato. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Yerusalaameppa yi7ide fettii fettii Farisaawuntsin higge asttamaaruntsin Yesuusa kale shiiqida. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Yesuusa tamaaruntsappa fete fete geezhikaayze kushera, yinnan kushe meeccikaayzara katstsa muuzuntsana un bi7ida.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>Farisaawuntsin Ayhude asunts ubba fa adunts wogiti gaar fa kushito meeccikaayzara mo7oos. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Yinnii gaara, un gabeppa wonggi maaqqii meeccinttikaayzar mo7oos. Mahi un fa aduntsappa ekkide melle gaama woga yene: yinnan sine, xaaro, meqo miishe datsan geeshize woga naagane.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Farisaawuntsin higge asttamaaruntsin Yesuusa, «Ne tamaaruntsi akkos adunts woga mentsii fa kushito meeccikaayzara katstsa me7e?» yaga7i oocida.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Yesuusa unttago, «Isayaasa yin cubbuntso,</para>
  <para style="q1" vid="MRK 7:6">«Hyantsi asuntsi tana fa doonara xalaala bonchchanep,</para>
  <para style="q2" vid="MRK 7:6">attin un wozintta taappa hyaako yene.<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa. 29:13</ref></char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Asi medhdhide woga Xoozze higge aazizi tamaarssize gisho</para>
  <para style="q2" vid="MRK 7:7">un tana hyappo goynane»</para>
  <para style="m" vid="MRK 7:7">ga7i xaafide tinbita turo.<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>«Yinttii Xoozze kiita ashshii as woga naagane» yagayda.<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Mahin Yesuusa, «Yin yin woga naagii Xoozze kiitto olii ashshodes lo77o oge denggida. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Muse, ‹Ne adayan ne intton bonchcho›, mahi ‹Fa adayan woy fa intto cazhide hyayqqodes beezane› yagayda.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Keze 20:12</ref>; <ref loc="DEU 5:16">Mahe 5:16</ref>; <ref loc="EXO 21:17">Keze 21:17</ref>; <ref loc="LEV 20:9">Leewe 20:9</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Yezin fettii asi fa adayan woy fa intton maaddodanno ashshii, ‹Yinna Xoozze zharsho› ga7iko, <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>E fa adayan woy fa intton maaddaame gaar oochchane. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Yinnii gaara, yin melluntsana tamaarsside yin wogitira Xoozze qaala leqqida. Yinnii fana melle gaama baz oochchane» yagayda.<verse eid="MRK 7:13"/></para>
  <para style="s1">As tunize baz</para>
  <para style="r">(<ref loc="MAT 15:10-20">Maato. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Yesuusa gaama asuntsana mahi faago xeegii, «Ubbuntsi ta ohizanno si7ote tiirote. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>As wozinappa kezze baz asi tunizanep attin baleppa as saza gelii asi tunize akkon baaya. <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Si7ize hyaye yeze ooden si7o» yagayda.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Faydo 16 Grike maxaafe baaya.</char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Yesuusa gaama asuntsana ashshii ashshii keetstsa gelin E tamaaruntsi yinna aaziziti baz eza oocida. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>E unttago, «Yinttisin mahi gelikaane? Baleppa as wozina gelize akko bazin asi tunissades dandda7osanna gelosaane? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Akkos gayko, katstsa as saza gidda gelii fa ogitira aadhanep attin as wozina gidda geloos» yagayda. Yinne Yesuusa katstsa ubba geeshi maaqqizanno ersida.<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Kaallii, Yesuusa, «Asi tunize baz as wozina giddappa kezze baz. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>As wozina giddappa kezze bazi iita qofa, gome woy7e, kayzo, as wodhe, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>olale, zhinbbartimo, iitatitsi, gene, qayxe, cimo, qana7e, cashshi, uturan boozatitsi. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Hyanna iitabazita ubba as wozina giddappa kezii asi tunizane» yagayda.<verse eid="MRK 7:23"/></para>
  <para style="s1">Fettii maachiti ammano</para>
  <para style="r">(<ref loc="MAT 15:21-28">Maato. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Yesuusa yinnippa kezii, Xiroosa katama kale yeze sa7a qitida. E fettii keetstsa gelii ize yezanno ooden erode gaar koyikaaya. Yinno maaqqikon aachintti gam77odes dandda7ikaaya. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Yezin I eeratsi na7ito tuna ayyaana aykkide fettii maachita Yesuusa baz si7i ellisii eego yi7i E tohitilla afa gol7ida. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Iza yelinttidanna Sooriya gidda Finqqe gaaze sa7a yelinttide Grike maacho. Iza, fa naatippa tuna ayyaanza kessode gaar Yesuusa woossida.<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>Yezin Yesuusa mahi, «Na7untsi tiinidhii katstsa mu7i mizho; na7unts katsito ekkii kanuntsis olizanna lo77o maaqqoos» yagayda.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Maachita mahi, «Ta Laatstsayo yinna turo, yezin leemate kale yeze kanuntsi na7untsappa wodhdhide gufto muune» yagayda.<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Yesuusa mahi iigo, «Hyanno ne ohide gisho ne kara qito; tuna ayyaanze ne naatippa kezida» yagayda.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Maachita fa kara hyanggize wode tuna ayyaanze naatippa kezin yitstsa woy7idanno bi7ida.<verse eid="MRK 7:30"/></para>
  <para style="s1">Yesuusa tullen doona muume atstsa fatstsida</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Yesuusa Xiroosa katamappa kezii, Sidoonaran Taphphi Katama gaaze sa7ara aadhii Galila Abbago qitida. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Asuntsi tullen doona muume asi Yesuusago ki7i, fa kushito eella gaddode gaar eza woossida. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Yesuusa faas ye atstsa gaama asappa gaxa kessii, fa gil7iza E hyayte dakkida. Mahi cuchchi cuttii E il7antsito bochchida. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Salo ude bi7i, gaddii shemppii, «Eftah» gayda. Bilitsitan «Buguntto» ga7e. <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Atstse hyayta ellisii buginttida, acinttide il7antsitan bilinttida, atstse geeshi ohinttida.<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>Yesuusa asuntsago, «Hyanno oodesin ohippete» yagayda. Yezin E gaama mintsii ohippete ga7in, asuntsi ohito gode gaantsida. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Yinno si7ide asuntsi ubba gaama qoppii, «Ubbabazito E loytsii oochchane. Melle atto yezin, tulliza sissane, muumiza ohizane» yagayda.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">Yesuusa oyddii mukul asuntsana muuzida</para>
  <para style="r">(<ref loc="MAT 15:32-39">Maato. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Eerats wodeppa suuba, gaama asuntsi Yesuusago shiiqida. Asuntsis mu7izebaz dhabin Yesuusa fa tamaaruntsana faago xeegii, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«Hyantsi asuntsi taara hyaydzdzii qamma yellodes gam7i, akkon muuze baz denggikaayze gisho tana asunts bazita yiqsane. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Taanii asuntsana nayera kara dakkiko asunts hyanggitera oge labbii gol7oda, bagge asuntsi hyaako bessappa yi7ida» yagayda.<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Yesuusa tamaarunts mahi, «Hyanna akko baayze ganasa hyantsi asuntsana ubba muussades maaqqade katstsa denggodes dandda7ode oode?» yagayda.<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Yesuusa unttago, «Yin kale wantsi boora yeze?» ga7i oocida.</para>
  <para style="p" vid="MRK 8:5">Un mahi, «Laappun boora yene» yagayda.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Yesuusa asunts sa7alla bettode gaar kiittida. Yeyzi, laappun boortto ekkii Xooz galatii maaqqii boortto baxxi, asuntsana yeltsode gaar fa tamaaruntsis inggida. E tamaarunts asuntsis gizhida. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Unttis mahi eeratsin yishsha molunts yene. Yesuusa yentsi molunts gisho Xooz galatii, asuntsis yeltsode gaar fa tamaaruntsana kiittida. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Asunts ubbuntsi mu7i mizhida. E tamaaruntsi mu7in attide gufa laappun leemate kumutsi dentsida. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Katstsa mu7ide asunts faydita oyddii mukul maaqqada. Yinnippa suuba, Yesuusa asuntsana moyzida. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>E mahi fa tamaaruntsara ellisii gongge gelii Dalmmanuuta gaaze sa7a qitida.<verse eid="MRK 8:10"/></para>
  <para style="s1">Malla oochinttode gaar oocida</para>
  <para style="r">(<ref loc="MAT 16:1-4">Maato. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Farisaawuntsi yi7i Yesuusa oocodes koyi, saloppa fana malla beessade gaar Yesuusara lalle aykkida.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Maato. 12:38</ref>; <ref loc="LUK 11:16">Luqa. 11:16</ref></char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>Yesuusa gaddii shemppii, «Hyanna wode asuntsi akkos malla koye? Taanii yinttis turo ohine; hyanna wode asuntsis akko mallan ingginttoos» yagayda.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Maato. 12:39</ref>; <ref loc="LUK 11:29">Luqa. 11:29</ref></char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>E unttana ize olii ashshii mahi gongge gelii abbappa seko fintsa fiinggida.<verse eid="MRK 8:13"/></para>
  <para style="s1">Farisaawuntsin Heroodisa irshsho</para>
  <para style="r">(<ref loc="MAT 16:5-12">Maato. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>E tamaaruntsi katstsa aykkodanno botida; unttis gongge gidda fettii boorappa melle baaya. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Yesuusa unttago, «Yinttana erote. Farisaawunts irshitippan Heroodisa irshitippa naaginttote» yaga7i kiittida.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luqa. 12:1</ref></char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Un wol gidda, «E hyanno gaazanna nuus boora baayze gisho» yagayda.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Yesuusa un gaazanno erii unttago, «Yinttis boora baayze gisho akkos ohintte? Hyatten erosite? Woy tiirosite? Yin wozintta doccida? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Yinttis aafe yezin bo7osite? Hyaye yezin si7osite? Yin tiirane?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Er. 5:21</ref>; <ref loc="EZK 12:2">Hiz. 12:2</ref>; <ref loc="MRK 4:12">Mar. 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Taanii ichchin boora ichchin mukul asuntsis yeltsize wode wantsi leemate kumutsi gufa dentsido?» yagayda.</para>
  <para style="p" vid="MRK 8:19">Unttin, «Taphpho lam77i leemate kumutsi» yagayda.<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>«Yinnii gaara, taanii laappun boora oyddii mukul asuntsis yeltside wode wantsi leemate kumutsi gufa dentsido?» yagayda.</para>
  <para style="p" vid="MRK 8:20">Un, «Laappun leemate kumutsi dentsida» yagayda.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Yeezin, «Hyatten tiirikaane?» yagayda.<verse eid="MRK 8:21"/></para>
  <para style="s1">Yesuusa Beetesayda fettii qooqe fatstsida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Unttii Beetesayda katama qitida. Eerats asuntsi qooqe atstsa Yesuusago ki7i ye atstsa girmode gaar eza woossida. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Yesuusa qooqe atstse kushito aykkii katamappa gaxa kessida. E aafte cuttii fa kushito aafitilla afa gaddii, «Nees akko benttane?» yaga7i oocida.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Atstsay dhoqi ga7i bi7i, «Taas asunts benttane, yezin asuntsi minxa gaar en7ane» yagayda.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Yinnippa suuba, Yesuusa mahi, atstse aafte fa kushito gaddida. Atstsayin loytsii bi7ida, faxin ubba baz shaakkii bi7ida. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Yesuusa atstsego, «Ne kara qito, yezin katama gelippe» yaga7i kiittida.<verse eid="MRK 8:26"/></para>
  <para style="s1">Phexiroosa markkatitsito</para>
  <para style="r">(<ref loc="MAT 16:13-20">Maato. 16:13-20</ref>; <ref loc="LUK 9:18-21">Luqa. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Yesuusa fa tamaaruntsara Qisaariya Filphoosa kale yeze kara gancce qitida. Unttii hyammadera ogella yezin Yesuusa, «Tana asuntsi oona ga7e?» yaga7i fa tamaaruntsana oocida.<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>E tamaaruntsi, «Fettii fettii asuntsi nena, ‹Xammaqize Wahannisa› gaane; melluntsi, ‹Eeliyaasa gaane› mahi melluntsi, ‹Nabuntsappa feta› gaane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mar. 6:14</ref></char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Yesuusa unttago, «Yeezin yin tana oona ga7e?» yaga7i oocida.</para>
  <para style="p" vid="MRK 8:29">Phexiroosa, «Neenii Kiristtoosa<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Kirsttoosa ga7inttizanna meesii bilitsitan tizhinttidaya ga7e</char></note>» yaga7i mahida.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Yesuusa, «Ta baz oodesin ohippete» yaga7i unttana kiittida.<verse eid="MRK 8:30"/></para>
  <para style="s1">Yesuusa fana yellode madhan waaye ohida</para>
  <para style="r">(<ref loc="MAT 16:21-28">Maato. 16:21-28</ref>; <ref loc="LUK 9:22-27">Luqa. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Yesuusa fa tamaaruntsago, «As Na7ay, gaama madha ekkodes beezane; cimuntsi, kahinunts hyalaquntsin higge asttamaaruntsi eza ixxodes beezane. Unttii eza wodhodesin hyaydzdzii qammappa suuba, E hyayqoppa denddodes beezane» yaga7i unttana tamaarssida. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>E yinno unttis loytsii ohida. Phexiroosa eza fettii zala mahi kaccida.<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>Yezin Yesuusa suuba maaqqii, fa tamaaruntsana bi7i, Phexiroosa kaccii, «Hyay Xalahizay, taappa hyaakko. Neenii asi kadhizebaz qoppanep attin Xoozii kadhizebaz qoppoos» yagayda.<verse eid="MRK 8:33"/></para>
  <para style="s1">Yesuusa kaallodes fana zharshe beezane</para>
  <para style="r">(<ref loc="MAT 10:38-39">Maato. 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luqa. 9:23-27</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Mahika Yesuusa gaama asin fa tamaaruntsana faago xeegii, «Tana kaallodes koyze ooden fana kaaddo; fa masqaltto tookkii tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Maato. 10:38</ref>; <ref loc="LUK 14:27">Luqa. 14:27</ref></char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Fa shemppito ashshodes koyze atstse dhabssoda. Yezin ta gishon Wonggele gishon fa shemppito dhabsize atstse ashshoda.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato. 10:39</ref>; <ref loc="LUK 17:33">Luqa. 17:33</ref>; <ref loc="JHN 12:25">Waha. 12:25</ref></char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Asi sa7alla yeze alamito tirfizako, fa shemppito dhabsiko eza akko maaddode? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Asi fa shemppito wozodes akko immades dandda7e? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Xooz ammanoose hyanna iita yeletuntsappa, fettii asi ta giddan ta qaaltten yeellidhiko, As Na7ay, mahi fa Aday bonchchora geeshi kiitanchchuntsara ye7ize wode yeyga yeellidhoda» yagayda.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="r">(<ref loc="MAT 17:1-13">Maato. 17:1-13</ref>; <ref loc="LUK 9:28-36">Luqa. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Yesuusa unttago, «Taanii yinttis turo ohine; Xoozze ka7itumo wolqqara yi7izanno bi7ikaayzara hyayqqaame fettii fettii asuntsi hyanne yene» yagayda.<verse eid="MRK 9:1"/></para>
  <para style="s1">Yesuusa bishshita laaminttida</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Yesuusa izipun qammappa suuba, faara Phexiroosa, Yayqooban Wahannisa ekkii, unttana xalaala damma derella afa kessii un tiino laaminttida.<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phex. 1:17-18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>E ma7itan focida; sa7alla ma7o meeccize ooden geeshshodes dandda7oose fana gaama booxxida. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Eliyaasan Musen Yesuusara ohinttodera un bi7ida.<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>Phexiroosa Yesuusa, «Asttamaarizayo, nuunii hyanne yezanna nuus lo77o; nu hyaydzdzii gaabba feta nees, feta Muses, mahi feta Eliyaasas gaabboda» yagayda. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Hyankkuntsi gaama tannide gisho E akko gaazakon erikaaya.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Yinnippa suuba, dhonne yi7i unttana goozin dhonne garsappa, «Hyayni ta kadhize, ta Na7aya, E gaazanno si7ote» gaaze qaala yi7ida. <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Ellisii unttii wututsi dakkii be7ize wode Yesuusa fattin melle ooden fa kale bi7ikaaya.<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Maato. 3:17</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 3:22">Luqa. 3:22</ref></char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Unttii derizeppa wodhdhodera, Yesuusa unttago, «As Na7ay, hyayqoppa denddode wontsis, yin bi7idanno oodesin ohippete» yaga7i kiittida.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>E kiittidanno un, «Ye7e» ga7i, «Hyanna hyayqoppa dendde gaazanna akko ga7e» ga7i, wol gidda ohinttida.<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>Un mahi, «Higge asttamaaruntsi, ‹Eeliyaasa tiinidhii yo7odes beezane› akkos ga7e?» yaga7i oocida.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>; <ref loc="MAT 11:14">Maato. 11:14</ref></char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Yesuusa mahi «Eeliyaasa tiinidhii yi7i, ubbabazito loytsoda; yeezin, akkos Geeshi Maxaafite, ‹As Na7ay gaama waayinttoda ixinttoda› yagaane ga7i oocida. <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Yezin taanii yinttis ohine; Eeliyaasa yi7ida; mahi E baz Geeshi Maxaafite xaafinttidannigaara, asuntsi eella afa fa koydanno oochchida» yagayda.<verse eid="MRK 9:13"/></para>
  <para style="s1">Yesuusa tuna ayyaana aykkide na7a fatstsida</para>
  <para style="r">(<ref loc="MAT 17:14-21">Maato. 17:14-21</ref>; <ref loc="LUK 9:37-43">Luqa. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Yesuusan, hyaydzdzuntsi tamaaruntsago maaqqii ye7ize wode gaama asuntsi un kale eqqiduntsanan higge asttamaare maaqqide eerats asuntsi unttara lallizanno bi7ida. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Yinna gaama asuntsi Yesuusa bi7ide wode gaama qoppii, ellisii eego woxxii yi7i, eza sarotsida. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Yesuusa, Xaafuntsago «Unttara akko lalle?» yaga7i oocida.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Yentsi gaama asunts giddappa fettii atstse mahi, «Asttamaarizayo, ta na7aylla afa ohinttodanno kayze tuna ayyaana yeze gisho eza neego ekkii yi7ida. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Hyay tuna ayyaanze eza aykkide wode ubba, eza guuddii olane; E donttira dubba ye7ine; mahi achchi garccizane; gallitan minggane. Eeppa hyay tuna ayyaanza kessode gaar, ne tamaaruntsis ohida, yezin kessodes un dandda7ikaaya» yagayda.<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Yesuusa mahi unttago, «Ammanoose hyanna wode asuntso! Taanii yinttara ayde yellodes yessade? Mahi yinttana ayde yellodes dandda7ode? Na7aya taas hyanka ekkii yo7ote» yagayda. <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Unttii na7aya eego ki7ida; ye tuna ayyaanze Yesuusa bi7ide fana na7aya goqizida; na7ay sa7a gol7i, doonara goppuntto cuttitera gol7inttida. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Yesuusa ye na7ay adaygo, «Hyay ne na7aya aykkidannippa wantsi wode maaqqade?» yaga7i oocida.</para>
  <para style="p" vid="MRK 9:21">Na7ay aday, «E eerats yezin aykkida. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Eza wodhodes gaama wode taman hyaatsan olane, yezin nees dandda7inttiko, nuus yiqsinttoya, nuna maaddoya» yagayda.<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Yesuusa eego, « ‹Ne dandda7iko gaane?› Ammanze oodesin ubba bazi dandda7inttane» yagayda.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Ellisii na7ay aday fa qaaltto dhoqi yiizii, «Taanii ammanane, yezin gujjii ammanode gaar tana maaddoya» yagayda.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Yesuusa asunts gaanggi gaanggi hyanggizanno bi7i, tuna ayyaanza, «Hyay tullen muume ayyaanzayo, hyay na7ayppa kezo ga7i nena ta kiittane; mahi lam7intsa E gidda gelippe» yagayda.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Ye tuna ayyaanze uukki, na7aya gaama goqizii, eeppa kezida. Na7ay hyayqqide gaara yi7in, gaama asuntsi, «Na7ay hyayqqida» yagayda. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Yezin Yesuusa na7ay kushito aykkii dentsin, na7ay denddii eqqida.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Yesuusa keetstsa gelidannippa suuba E tamaaruntsi, «Nuunii ye tuna ayyaanza kessodes akkos dandda7ikaaya?» yaga7i Yesuusa shaakkii dumma oocida.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Yesuusa mahi, «Yinnii gaarize woosaran [xoomaran] fattin melle bazara kessades dandda7oos» yagayda.<verse eid="MRK 9:29"/></para>
  <para style="s1">Yesuusa fana yellode madhito mahi ohida</para>
  <para style="r">(<ref loc="MAT 17:22-23">Maato. 17:22-23</ref>; <ref loc="LUK 9:43-45">Luqa. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Unttii yinna bestippa denddii, Galilara aadhii qitida; Yesuusa fa yeze bestto ooden erode gaar koykaaya. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>E fa tamaaruntsago, «As Na7aya, asi asis aatsii inggoda wodhoda; E hyaydzdzii qammappa suuba, hyayqoppa denddoda» yaga7i tamaarssitera yene.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Yezin unttis E gaazanna gelikaaya; mahi eza oocodesin zhashtida.<verse eid="MRK 9:32"/></para>
  <para style="s1">Ubbappa aadhize oode?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Maato. 18:1-5</ref>; <ref loc="LUK 9:46-48">Luqa. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Unttii Qifirnahoome katama hyanggi keetstsa gelidannippa suuba Yesuusa unttago, «Oge akkos lalle?» yaga7i oocida. <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Yezin un, «Nu gidda ubbappa aadhode oode?» yaga7i lallide gisho si77i gayda.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa. 22:24</ref></char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Yesuusa bettii, taphpho lam77i tamaaruntsana xeegii, «Ooden tiino aadhodes koyko, ubbappa suuba aadhii, ubbuntsis aro maaqqades beezane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Maato. 20:26</ref></char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>Fettii eeratsi na7a ekkii, un gidda essida; ye eerats na7aya iringgi unttago, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«Hyantses gaar eerats na7untsappa feta ta suntsite mokkize ooden tana mokkane; mahi tana mokkize ooden tana kiittezayan mokkanep attin tana xalaala mokkoos» yagayda.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Maato. 10:40</ref>; <ref loc="LUK 10:16">Luqa. 10:16</ref>; <ref loc="JHN 13:20">Waha. 13:20</ref></char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">Nuna ixxoose atstse nu bagga</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luqa. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Wahannisa, «Asttamaarizayo, fettii asi ne suntsite tuna Ayyaana kessodera nuunii bi7i, nu bagga maaqqoosse gisho eza kayda» yagayda.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Yezin Yesuusa, «Ooden ta suntsite Xoozii oochchize gaama qofize baz oochchii, ellisii taalla afa iita baz ohinttodes dandda7ize baayze gisho kayppete. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Nu baz ixxoose atstse nu bagga.<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Maato. 12:30</ref>; <ref loc="LUK 11:23">Luqa. 11:23</ref></char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Taanii yinttis turo ohine; yin taasuntsana maaqqide gisho ooden yinttis ta suntsite hyale hyaatsi ushshades inggikon, fa anjjito ekkoda.<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Maato. 10:42</ref></char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">Nagarara fattanintte</para>
  <para style="r">(<ref loc="MAT 18:6-9">Maato. 18:6-9</ref>; <ref loc="LUK 17:1-2">Luqa. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>«Tana ammanze hyantsi eeratsuntsappa feta balitstsize ooden, gaacize damma woxa fa afurtte accii, Abba gidda gelizako ees lo77o. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Ne kushita nena balitstsizako, gachchii olo. Neenii lam77i kushera dhaboose gaanname tama olinttodannippa, duuxutsi kushera de7o gelzako nees lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Maato. 5:30</ref></char></note> <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>Gaanname zaqiltta hyayqoosse taman dhaboose bessi. <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Ne tohita nena balitstsizako, gachchii olo. Neenii lam77i tohera gaanname tama olinttodannippa, duuxa maaqqii de7o gelizanna nees lo77o. <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>Gaanname zaqiltta hyayqoosse taman dhaboose bessi. <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Ne aafta nena balitstsizako, woocii kessii olo. Neenii lam77i aafera gaanname tama olinttodannippa, fettii aafera Xoozze ka7itumo gelizanna nees lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Maato. 5:29</ref></char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Ize zaqilttan hyayqqoos, tamttan dhaboos.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa. 66:24</ref></char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«Zharsho soogera geezhanni fana asi ubba tamara geeshshada. <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>Sooge lo77o, yiikon E mal7anxi ixxiko, mahi wayzi mal7issade? Yin gidda sooge yesse. Yi7i fetay fetayra sarora yezote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Maato. 5:13</ref>; <ref loc="LUK 14:34">Luqa. 14:34</ref></char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">Machcho dakkodes beezoos</para>
  <para style="r">(<ref loc="MAT 19:1-2">Maato. 19:1-2</ref>; <ref loc="LUK 16:18">Luqa. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Yesuusa yinnippa denddii, Yihuda sa7a hyanggi Yorddaanosa borkka fiinggida. Gaama asuntsi mahi eego shiiqin, tiinosttifana yentsi asuntsana tamaarssida.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Fettii fettii Farisaawuntsi fattanodes koyi Yesuusa, «Fettii asi fa machchito dakkode gaar Muse higgita kiittane?» yaga7i eza oocida.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>E mahi, «Muse yinttana waaga7i kiittido?» yagayda.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Unttii, «Muse, ‹Fettii asi fa machchitis dafo warqqate inggi dakko› gayda» yagayda.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1">Mahe 24:1</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Yesuusa mahi, unttana «Yin ohin si7oosuntsana maaqqide gisho Muse hyanna kiitto yinttis xaafida. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Yezin Xoozii tiino medhdhize wode dhiiratsin maachon mahi medhdhida.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medho 1:27</ref>; <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Yinnii gisho, fettii asi fa adayan fa intton ashshii, fa machchitira wolla yezane.<note caller="-" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medho 2:24</ref></char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>Un lam77untsi fettii asho maaqqane; yikkeppa, un fettii asho maaqqanep attin lam77i asi maaqqoos. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Yinnii gisho, Xoozii accidanno asi shagippe» yagayda.<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Un kara maaqqide wode E tamaaruntsi hyanna ohiti baz Yesuusa lam7intsa oocida. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Yesuusa unttago, «Fa machchito dakkii melle ekkize ooden olalane.<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato. 5:32</ref>; <ref loc="1CO 7:10-11">1 Qoro. 7:10-11</ref></char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Mahi machchitan fa azinzeppa kezii melle azinii geliko olalida» yagayda.<verse eid="MRK 10:12"/></para>
  <para style="s1">Yesuusa eerats na7untsana anjjida</para>
  <para style="r">(<ref loc="MAT 19:13-15">Maato. 19:13-15</ref>; <ref loc="LUK 18:15-17">Luqa. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Yesuusa eerats na7untsana bochchode fana, fettii fettii asunts na7untsana eego ki7ida, yezin E tamaaruntsi yentsi asuntsana kaccida. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Yesuusa yinno bi7i, fa tamaaruntsana kaccii; unttago, «Eerats na7untsi taago yi7izanno kayppete; Xoozze ka7itumo yentses gaarzuntsis. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Taanii yinttis turo ohine; Xoozze ka7itumo eerats na7a fana ekkoosse atstse ooden yinna ka7itumtto mulon geloos» yagayda.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Maato. 18:3</ref></char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Eerats na7untsana iringgi, fa kushito fetella fetella afa gaddii anjjida.<verse eid="MRK 10:16"/></para>
  <para style="s1">Qolo yiqsimo ki7ize madha</para>
  <para style="r">(<ref loc="MAT 19:16-30">Maato. 19:16-30</ref>; <ref loc="LUK 18:18-30">Luqa. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Yesuusa qitodes kezide wode fettii atstse woxxii yi7i, E tiintte bunqqunttii, «Keeha asttamaarzayo, medhina de7o laattodes taanii akko oochcho?» yaga7i oocida.<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Yesuusa, «Akkos tana keehizayo ga7i xeege? Xoozze xalaalap attin melle keeha ooden baaya. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Xoozze kiitto, wodhippe; olalippe; kaystippe; worddo markkidhippe; il7antsite laammippe; ne adayan ne intto bonchcho yagaazanno erane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Keze 20:12-16</ref>; <ref loc="DEU 5:16-20">Mahe 5:16-20</ref></char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Atstse, «Asttamaarizayo, taanii yinno ubba na7atitsappa aykkii hyayno yellodes naagane» yagayda.<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Yesuusa atstsa dakkii bi7i kadhida; «Nees fettii bazi faccane; hyanggi nees yeze baz mulo bayzi, yinna birtto dahuntsis inggo; neenii salo duridhdhada. Yeyzi maaqqii tana kaallo» yagayda. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Yezin atstse yinno si7i, E gaama dure maaqqide gisho fa sintto kartsii, ufayttikaayzara ashshii qitida.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Yesuusa fa tamaaruntsana wututsii dakkii bi7i, «Dure asi Xoozze ka7itumo gelodanna wayzi madhodyessa!» yagayda.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>E tamaaruntsi E timirttite gaama qoppida. Yezin Yesuusa mahi unttago, «Na7untso, Xoozze ka7itumo gelodanna wayzi madhodyessa! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Dure asi Xoozze ka7itumo gelodannippa, gimale marppe uruntsara aadhizanna laafane» yagayda.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>E tamaaruntsi gaama qoppii, «Yeezin, oode attode?» yaga7i, fete feta oocida.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Yesuusa unttana dakki bi7i, «Hyanna Xoozzes dandda7inttanep attin asis dandda7inttoos; Xoozzes ubba bazi dandda7inttane» yagayda.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Phexiroosa Yesuusago, «Ero; nuunii nu baz ubba ashshii, nena kaallane» yagayda.<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Yesuusa «Taanii yinttis turo ohine; ta gishon Wonggele gishon keetsito woy ishuntsana woy mishuntsana woy adaya woy intto woy machchito woy na7untsana woy oochchize gadito ashshize ooden, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>hyatte hyanna wodite xeet kushe keetsito, ishuntsana, mishito, intto, na7untsana, oochchize gadito, baytstsara wolla ekkoda. Tiinoppa ye7ode woden medhina de7o ekkoda. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Yezin gaamuntsi tiino maaqqiduntsi suub maaqqada, mahi gaamuntsi hyatte suub maaqqiduntsi tiino maaqqada» yagayda.<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Maato. 20:16</ref>; <ref loc="LUK 13:30">Luqa. 13:30</ref></char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">Yesuusa fana yellode madhito hyaydzdzintsa ohida</para>
  <para style="r">(<ref loc="MAT 20:17-19">Maato. 20:17-19</ref>; <ref loc="LUK 18:31-34">Luqa. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Yesuusaran E tamaaruntsara Yerusalaame hyammadera, Yesuusa fa tamaarunts tiintte yedhdhane. Un gaama qoppida. Eza kaallizuntsin zhashtida. Lam7intsa, taphpho lam77i tamaaruntsana gaxa kessii, fana yellode baz shagii unttago hyannigaara yaga7i ohida. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«Hyaychche, nuunii Yerusalaame hyatte kezane. Ize As Na7ay, kahinunts hyalaquntsisin higge asttamaaruntsis aatsii ingginttoda. Unttii eella afa hyayqo firdda firddoda; mahi Ayhude maaqqoosse asuntsis eza aatsii inggoda. <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Ye Ayhude maaqqoosse asuntsi eza leqqoda, eella afa cuttoda, allanggara garaafoda wodhoda. E hyaydzdzii qammappa suuba, hyayqoppa denddoda» yagayda.<verse eid="MRK 10:34"/></para>
  <para style="s1">Yayqooban Wahannisa woosside woosa</para>
  <para style="r">(<ref loc="MAT 20:20-28">Maato. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Zabdoosa na7unts Yayqooban Wahannisa Yesuusago yi7i, «Asttamaarizayo, nuunii nena woossize fettibaz nuus oochchoya» yagayda.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Yesuusa unttago, «Taanii yinttis akko oochcho?» yagayda.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Unttii, «Neenii ne bonchcho ka7itumtte bettize wode nuuppa feta mizaqi zalara mahi feta workkita zalara betitsoya» yagayda.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Yezin Yesuusa unttago, «Yinttii akko woossizako eroos, ta ushshades yeze xuu7a ushshades dandda7odate? Mahi taanii xammaqinttodes yeze xinqqatto xammaqinttodes dandda7odate?» yagayda.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luqa. 12:50</ref></char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Un mahi, «Ye dandda7oda» yagayda.</para>
  <para style="p" vid="MRK 10:39">Yesuusa mahi, «Turo ta ushshades yeze xuu7a yin ushshada, taanii xammaqinttodes yeze xinqqatto yin xammaqinttoda. <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>Yezin taappa mizaqi zalaran workkita zalara bettoduntsana doorodes taas adetits wolqqa baaya, yezin yinna bessita Xoozii immades giigizii gaddiduntsis» yagayda.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Attiduntsi taphphi tamaaruntsi yinno si7ide wode Yayqooballan Wahannisalla shenidhdhida. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Yesuusa unttana ubba faago xeegii, «Ayhude maaqqin Ayhude maaqqoosse asunts hyalaquntsi worzha ahizuntsana ga7intti xeeginttizuntsanan ahizuntsis worzhuntsalla afa adetits wolqqa yezanno yin erane.<note caller="-" style="x"><char style="xo" closed="false">10:42-44 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luqa. 22:25-26</ref>; <ref loc="MAT 23:11">Maato. 23:11</ref>; <ref loc="MRK 9:35">Mar. 9:35</ref>; <ref loc="LUK 22:26">Luqa. 22:26</ref></char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Yezin yin gidda yinnii fana maaqqades beezoos; yin gidda damma maaqqades koyze ooden yinttis aro maaqqades beezane. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Mahi yin gidda ubbappa aatsii maaqqades koyze ooden yin ubbuntsis aro maaqqades beezane. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Melle atto yezin, As Na7ayin, as maaddodesin gaamuntsana ashshodes fa shemppito aatsii immades yi7idap attin asi ees oochchode gaar yi7ikaaya» yagayda.<verse eid="MRK 10:45"/></para>
  <para style="s1">Yesuusa qooqe Barxxemoosa aafto fatstsida</para>
  <para style="r">(<ref loc="MAT 20:29-34">Maato. 20:29-34</ref>; <ref loc="LUK 18:35-43">Luqa. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Unttii Iyaarkko katama hyanggida. Yesuusa fa tamaaruntsaran gaama asara Iyaarkkoppa kessadera, Ximoosa na7a, qooqize, Barxximoosa ga7inttize, oge gaxa woossittera bettida. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Barxximoosa, yeygara aadhize Naazirete Yesuusa maaqqidanno si7ide wode fa qaaltto dhoqi yiizii, «Dawute na7a Yesuusa, tana maaroya!» yaga7e aykkida.<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Gaama asuntsi eza, «si7i ga7o!» ga7i kaccida.</para>
  <para style="p" vid="MRK 10:48">Yezin, E fa qaaltto kasennippa gaama dhoqi yiizii, «Dawute na7ayo, tana maaroya!» yagayda.<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Yesuusa eqqii, «Eza hyankka xeegote» yagayda.</para>
  <para style="p" vid="MRK 10:49">Unttii qooqizego, «Akko baaya, denddii eqqo, nena xeegane» yagayda. <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Qooqize fa ma7ito olii ashshii, doollii denddii eqqii, Yesuusago hyanggida.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Yesuusa, «Taanii nees akko oochchode gaar koye?» yagayda.</para>
  <para style="p" vid="MRK 10:51">Qooqize, «Asttamaarizayo, ta be7ades koyane» yagayda.<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Yesuusa eego, «Qito, ne ammantta nena fatstsida» yagayda. Iira E aafta bi7in, Yesuusa kaallida.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">Yesuusa damma bonchchora Yerusalaame gelida</para>
  <para style="r">(<ref loc="MAT 21:1-11">Maato. 21:1-11</ref>; <ref loc="LUK 19:28-40">Luqa. 19:28-40</ref>; <ref loc="JHN 12:12-19">Waha. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Un Yerusalaame ukkitera, Shamahe Derize kale yeze Beetefaagen Bitaaniya katamito yellida. Yesuusa fa tamaaruntsappa lam77untsana tiino dakkii, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«Yinttappa tiino yeze kara gancce qitote; ize gelide gaar ooden toggii bi7ikaayze acinttii yeze hyare na7a yin denggoda, eza billii, hyayga ekkii yo7ote. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Ooden yinttana, ‹Hyanno akkos oochche?› yaga7i oociko, ‹Laatstsii eza koyane, ellisii eza hyankka dakkoda› ga7ote» yagayda.<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Un hyanggi, hyare na7aya bale oge kale acinttii yezaya denggi billida. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Yinna besite eqqide fettii fettii asunts unttago, «Hyare na7aya wayssades bille?» yagayda. <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>E tamaaruntsi Yesuusa fana kiittezanno ohin, asunts ashshii ashshida. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Unttii hyare na7aya Yesuusago ki7i, fa ma7ito E bantte yiixxin Yesuusa ye hyare na7aya toggida. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Gaama asuntsi fa ma7ito ogite yiixxida; mahi melluntsi minxa tashe shaqqii, ogite yiixxida. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Yesuusappa tiino yedhdhize asuntsin eza kaallize asuntsi fa qaaltto dhoqi yiizii,</para>
  <para style="q1" vid="MRK 11:9">«Hosaana!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">Hosaana: </char><char style="ft" closed="false">Maato 21:9 bo7ote. </char></note></para>
  <para style="q2" vid="MRK 11:9">Laatstse suntsite ye7ize anjjinttidaya.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Maz. 118:25</ref></char></note><verse eid="MRK 11:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MRK 11:10"/>Ye7ize nu aday Dawute ka7itumtta anjjinttidanno.</para>
  <para style="q2" vid="MRK 11:10">Hosaana! Salo»</para>
  <para style="m" vid="MRK 11:10">yagayda.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Yesuusa Yerusalaame hyanggi, Xoozze Keetstsa gelida. Mahi ubbabazito wutii bi7idannippa suuba, sa7ita qammize gisho taphpho lam77i tamaaruntsara Bitaaniya katama qitida.<verse eid="MRK 11:11"/></para>
  <para style="s1">Yesuusa baaddide belese minxito</para>
  <para style="r">(<ref loc="MAT 21:18-19">Maato. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Wonttistti wode un Bitaaniyappa kezii hyammadera, Yesuusa nayzida. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Hyaakora fettii belese minxitis zhil7o hyaye yezanno bi7i, Iilla afa aafe benttiko ga7i, be7ades izigo hyanggida, yezin izigo E hyanggize wode hyaye xalaalap attin fettii aafen denggikaaya; akkos gayko, belese aafze wode yellikaayze gisho. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Yesuusa yinna belesito, «Yikke, neeppa asi aafe miippe» yagayda. E tamaaruntsi E gaazanno si7ida.<verse eid="MRK 11:14"/></para>
  <para style="s1">Yesuusa Xoozze Keetstsa zal7izuntsana kessida</para>
  <para style="r">(<ref loc="MAT 21:12-17">Maato. 21:12-17</ref>; <ref loc="LUK 19:45-48">Luqa. 19:45-48</ref>; <ref loc="JHN 2:13-22">Waha. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Un Yerusalaame qitida; Yesuusa Xooze Keetstsa gelii, ize bayzizuntsanan wonggizuntsana bale bay7e aykkida; mahi bira laammizuntsana xarphezan wolle bayzizuntsana oyda dakkii olii, <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>asi akko bazin tookkii, Xoozze Keetstsa giddara aadhaame fana kayda. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Yesuusa asuntsana hyannigaara yaga7i tamaarssida: «Geeshi Maxaafite, ‹Ta keetsita asi ubba Xooz woossize keetstsi maaqqada› ga7intti xaafinttida. Yezin yinttii izo faanno aachinttize wom7o mahida» yagayda.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa. 56:7</ref>; <ref loc="JER 7:11">Er. 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Kahinunts hyalaquntsin higge asttamaaruntsi yinno si7i, eza wodhodes oge koye aykkida. Yezin gaama asuntsi E timirttite gaama qoppize gisho ees zhashtida.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Sa7ita ugurize wode Yesuusan E tamaaruntsin katamappa gaxa kezida.<verse eid="MRK 11:19"/></para>
  <para style="s1">Belese minxita melida</para>
  <para style="r">(<ref loc="MAT 21:20-22">Maato. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Un wonttistti wode yinna ogitira aadhitera, yinna belesta xaphora melidaanno bi7ida. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Phexiroosa tiirii, «Asttamaarizayo, yikke, neenii baaddide belesita melida» yagayda.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Yesuusa mahi, «Xoozza ammanote. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Taanii yinttis turo ohine; ooden fa wozintte so7ikaayzara gaydebazi hyanodanno ammanii, hyay deriza, ‹Denddii Abba wodhdho› yagayko ees hyanoda.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato. 17:20</ref>; <ref loc="1CO 13:2">1 Qoro. 13:2</ref></char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Yinnii gisho, taanii yinttis ohine; Xoozza yin woossize bazin oocizebaz akko maaqqikon ekkide gaara ammanote, yin ekkoda. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Xooz woossodes yin eqqize wode salo yeze yin Aday yin nagartto atto gawude fana, ooden yinttana naaqqidebaz yeziko, ees atto ga7ote. <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>[Yezin as nagara yin atto ga7anxi ixxiko, salo yeze yin Adayn yin nagartto yinttis atto ga7oos» yagayda].<verse eid="MRK 11:26"/></para>
  <para style="s1">Yesuusa akko adetits wolqqara oochchizako oocinttida</para>
  <para style="r">(<ref loc="MAT 21:23-27">Maato. 21:23-27</ref>; <ref loc="LUK 20:1-8">Luqa. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Un mahi Yerusalaame hyanggida. Yesuusa Xoozze Keetstsa hyanttodera, kahinunts hyalaquntsi, higge asttamaaruntsin cimuntsi eego yi7i, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«Neenii hyanno oochchodes nees akko adetits wolqqa yeze? Woy nees hyanna adetits wolqqito inggide oode?» yagayda.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesuusa mahi unttago, «Ta yinttana fettibaz oocoda, taas ohote. Ta mahi hyanno akko adetits wolqqara oochchizako, yinttis ohoda. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Wahannisa xinqqata Xoozappane woy asappa? Taas ohote» yagayda.<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Unttii fa gidda lalle aykkii, «Nuunii, ‹Xoozappa› gayko, E nuugo, ‹Yeezin, Wahannisa ohizanno akkos ammananxido?› yagawuda. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‹Asappa gayko› asi ubba Wahannisa nabe maaqqizanno erane.» Maaqqide gisho asuntsis zhashtida. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Yinnii gisho, unttii Yesuusago, «Nuunii eroos» yaga7i mahida;</para>
  <para style="p" vid="MRK 11:33">Yesuusa, «Taanin hyanno akko adetits wolqqara oochchizako, yinttis ohoos» yagayda.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Woyne tukkii oochchizunts aazize</para>
  <para style="r">(<ref loc="MAT 21:33-46">Maato. 21:33-46</ref>; <ref loc="LUK 20:9-19">Luqa. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Yesuusa unttis aazizera yaga7i ohida; «Fettii atstse woyne atakiltte tukkii, gaxito wututsii gase gasida. Mahi ye woyniza cicize ollan bookkida. Eza kafodes pharggo shakko shakkida. Yinnippa suuba, kotstse oochchize asuntsis inggi, melle sa7a qitida.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa. 5:1</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Woyne aafta diilii maxize wode yellin, fana yellizanno ekkii ye7ode gaar, fettii fa ariza kotstse aduntsago kiittida.<figure style="fig" alt="Woman with child bringing grapes to wine press" file="LB00106B.TIF" size="span" ref="12:2">Gaditi aday fa arito woyne aafito ko7ode gaar </figure> <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Kotstse ekkide asuntsi E ariza aykkii hyadhdhii, hyarii kushe dakkida. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Lam7intsa melle aro unttago kiittin, un ye arizes ommito shuchchara qawuxii kawushizii dakkida. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Woyne taakilte laatstsay mahin melle aro kiittida. Ye ariza wodhida, mahi melle gaamuntsana yinnii gaara yeyzida, feta feta hyadhdhii, melluntsana wodhida.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>«Woyne atakiltte laatstses kiittodes ubbappa lasite E gaama kadhize fa na7aya dakkodanna xalaala attida. E, ‹Un ta na7aya bonchchikaayzara ashshaama› ga7i, fa na7aya unttago kiittida.<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>«Yezin kotstse aduntsi fa gidda, ‹Laattoday hyaya; yedhdhote eza wolla wodhoda; E laatita nuus maaqqada!› yagayda. <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Na7aya aykkii wodhii, E ahito woyne atakiltte giddappa gaxa kessii olida.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«Yikke, woyne atakiltte laatstsay wayssade? Yi7i yentsi kotstse aduntsana wodhii hyaasii, woyne kotstse oochchize melle asis inggoda.<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>« ‹Keexizuntsi leqqii ixxide shuchchize</para>
  <para style="q2" vid="MRK 12:10-11">Keetsiti mayzentto xaalize,</para>
  <para style="q2" vid="MRK 12:10-11">ubbappa aadhize mintsi shuchchi maaqqida.</para>
  <para style="q1" vid="MRK 12:10-11">Hyanno Laatstsii oochchidebaz;</para>
  <para style="q2" vid="MRK 12:10-11">mahi nu aaftisin gaama qofize baz</para>
  <para style="m" vid="MRK 12:10-11">yagaazanno Geeshi Maxaafeppa nabbabika?› » yagayda.<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Maz. 118:22-23</ref></char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Kahinunts hyalaquntsi, higge asttamaaruntsin cimuntsi Yesuusa yinna aazizito unttalla afa ohidanno eride gisho eza aykkodes koyda, yezin asuntsis zhashtii, ashshii qitida.<verse eid="MRK 12:12"/></para>
  <para style="s1">Giira giirize bazis shiiqide ooce</para>
  <para style="r">(<ref loc="MAT 22:15-22">Maato. 22:15-22</ref>; <ref loc="LUK 20:20-26">Luqa. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Mahi yinna ohitippa bala denggi, eza aykkode gaar, Farisaawuntsappa Heroodisa bagguntsappa eerats asuntsana eego kiittida. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Unttii eego yi7i, «Asttamaarizayo, neenii turibaz ohinttizanno asappa as shaakkoosanno nuunii erane. Neenii as shaakkoos; mahi Xoozze ogito turetitsara tamaarssane. Nuunii Roome gade Kaat Qeesares giira giirizanna likken likke baa? Giira giironene ashshone?» yagayda.<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Yezin un cubbotitsito Yesuusa erii, «Tana akkos fattane? Ane fettii santime tana beezote» yagayda. <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Unttii ees ki7ida, «Hyanna bishshitan suntsita oodeso?» yaga7i unttana oocida.</para>
  <para style="p" vid="MRK 12:16">Unttii, «Qeesares<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">Qeesare-Roome kaat</char></note>» yagayda.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Yesuusa mahi, «Yeezako, Qeesarestto Qeesares, Xoozzesito Xoozis inggote» yaga7in un E baz gaama qoppida.<verse eid="MRK 12:17"/></para>
  <para style="s1">Hyayqoppa denddebaz</para>
  <para style="r">(<ref loc="MAT 22:23-33">Maato. 22:23-33</ref>; <ref loc="LUK 20:27-40">Luqa. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Hyayqqide asi denddoos gaaze Saduqaawuntsappa fettii fettii asuntsi Yesuusago yi7i, hyannigaara yaga7i, eza oocida.<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa. 23:8</ref></char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«Asttamaarizayo, Muse nuus higge xaafittera, ‹Machcho ekkide asi na7a yelikaayzara hyayqqiko, ye hyayqqide ishe E machchito ekkii, fa ishes na7a yelodes beezane› yagaazanno xaafida.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Mahe 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Zaga wode laappun ishuntsi yezuntsappa anggisse machcho ekkii, na7a yelikaayzara hyayqqida. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Lam7antsize izo ekkida, ezin na7a yelikaayzara hyayqqida. Hyaydzantsize yinnii gaar yi7ida. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Laappununtsin yinnii gaara izo ekkii, na7a yelikaayzara hyayqqida. Ubbappa suuba, mahi yinna maachita hyayqqida. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Yeezin, laappununtsi mulo izo ekkide gisho hyayqqide asuntsi hyayqoppa denddide wode, iza unttappa aayyes machcho maaqqade?» yagayda.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Yesuusa mahi, «Yinttii balinttizanna, Geeshi Maxaafito woy Xoozze wolqqa erikaayze gisho! <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Hyayqqide asuntsi hyayqoppa denddide wode, salo yeze kiitanchcho maaqqanep attin dhiiratsin ekkoos; maachan geloos. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Yezin hyayqqiduntsi denddebaz maaqqiko, Muse maxaafite xaafinttide eexize hyaburtutibaz ohize besite, Xoozii Musego, ‹Taanii, Abrahama Xoozii, Yisaaqa Xoozii, Yayqooba Xoozii› gaydanno nabbabikate?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Keze 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Yinnii gisho, E, shemppora yezunts Xoozap attin hyayqqiduntsi Xoozii baaya. Yin gaama balida» yagayda.<verse eid="MRK 12:27"/></para>
  <para style="s1">Ubbappa aadhize kiita</para>
  <para style="r">(<ref loc="MAT 22:34-40">Maato. 22:34-40</ref>; <ref loc="LUK 10:25-28">Luqa. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Higge asttamaaruntsappa fete un lallizanno shiiqii si7ida. Mahi Yesuusa unttis loytsii mahidanno si7i, «Kiita ubbappa aadhize kiitta aanno?» yaga7i Yesuusa oocida.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa. 10:25-28</ref></char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Yesuusa mahi, eego hyannigaara yagayda: «Kiita ubbappa aadhize kiita si7ote; ‹Isra7eele asuntso, Laatstse nu Xoozze fettii Laatstsii.<note caller="-" style="x"><char style="xo" closed="false">12:29-30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">Mahe 6:4-5</ref></char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Ne Laatstsa ne Xoozza ne kumutsi wozinappa, ne kumutsi shemppoppa, ne kumutsi qofappa, ne kumutsi wolqqappa kadho› yagayda. <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Mahi kiita ubbappa aadhize lam7intsa kiitize; ‹As ubba ne ommiti gaar kadho› yagaazanno; hyantsesappa aadhize melle kiita baaya» yagayda.<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Higge asttamaarize Yesuusago, «Asttamaarzayo, turo gayda; neenii ‹Xoozii fettii Xoozii xalaala. Eeppa melle baaya› gaydanna turo.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">Mahe 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Xoozza kumutsi wozinappa, kumutsi qofappa kumutsi wolqqappa kadhizannon mahi as ubba fa ommiti gaar kadhizanna, michchize zharshoppan melle zharsho ubbappa aadhane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hose. 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Yesuusa higge asttamaarize mahidanna aadhize era as mahe maaqqidanno bi7i, «Neenii Xoozze ka7itumoppa hyaakkikaaya» yagayda; yinnippa suuba, Yesuusa mellebaz oocodes ooden miinggikaaya.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa. 10:25-28</ref></char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">Kiristtoosa oode na7a</para>
  <para style="r">(<ref loc="MAT 22:41-46">Maato. 22:41-46</ref>; <ref loc="LUK 20:41-46">Luqa. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Yesuusa Xoozze Keetstsa tamaarssite, hyannigaara yagayda: «Higge asttamaaruntsi Kiristtoosa ‹wayzi Dawute na7a ga7e?› <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Dawute Geeshi Ayyaanara kaallii,</para>
  <para style="q1" vid="MRK 12:36">« ‹Laatstsii, ta Laatstsaya, «Taanii ne morkkuntsana</para>
  <para style="q2" vid="MRK 12:36">ne tohita yedhdhize bessi mahode wontsis,</para>
  <para style="q2" vid="MRK 12:36">hyanne taappa mizaqi zala betto» gayda› yagayda.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz. 110:1</ref></char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>Dawute fa ommite Kiristtoosa, ‹Laatstso› ga7i xeegiko, yeezin, Kiristtoosa wayzi, Dawute na7a maaqqe» yagayda.</para>
  <para style="p" vid="MRK 12:37">Gaama asuntsi Yesuusa gaazanno ufaytti si7ida.<verse eid="MRK 12:37"/></para>
  <para style="s1">Yesuusa higge asttamaaruntsanan Farisaawuntsana leqqida</para>
  <para style="r">(<ref loc="MAT 23:1-36">Maato. 23:1-36</ref>; <ref loc="LUK 20:45-47">Luqa. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Yesuusa tamaarssitera, hyannigaara yagayda: «Higge asttamaaruntsappa naaginttote; un pharggo ma7o ma77i wutizannon gaben asi unttana bonchchii sarotsizanno koyane. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Unttii Ayhude woosa keetstsa gaama lo77o oyda koyane; mahi asi fana mokkize bessa bonchcho bessi koyane. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Un budan keetstsi bonqii, fana beessades pharggizii woossane; un ubbappa aadhize firdda ekkoda» yagayda.<verse eid="MRK 12:40"/></para>
  <para style="s1">Budantti muxaate</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luqa. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Yesuusa Xoozze Keetstsa muxaate olize saaxine kale bettii, asuntsi fa birtto yinna saaxintte olizanno bi7ida; gaama dure asuntsi gaama bira yinna saaxintte olane. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Fettii daha budantta yi7i, lam77i sikkinna yinna saaxintte olida. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Yesuusa fa tamaaruntsana xeegii, «Taanii yinttis turo ohine; muxaate saaxintte olide asunts ubbappa hyanna daha budantta gaantsi olida. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Akkos gayko, melluntsi ubba faas kumii attide birappa olane. Yezin iza fa facitippa, faas yeze qoltto ubba inggida» yagayda.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Yesuusa Xoozze Keetsita wul7inttodanno tiinii ohida</para>
  <para style="r">(<ref loc="MAT 24:1-2">Maato. 24:1-2</ref>; <ref loc="LUK 21:5-6">Luqa. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Yesuusa Xoozze keetstsappa kessadera, E tamaaruntsappa fete, «Asttamaarizayo, hyanna lo77o shuchchiton hyanna lo77o shuchchi keetsito be7ine!» yagayda.<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Yesuusa mahi, «Hyanna damma shuchchi keetsito be7ine? Hyanna keetsita shuchchi shuchchalla afa gimbbinttide fana wul7inttikaayzara attoos; fettii shuchchin attikaayzara ubba wul7inttoda» yagayda.<verse eid="MRK 13:2"/></para>
  <para style="s1">Laatstsii yo7odannippa tiino yellode baytstsin madha</para>
  <para style="r">(<ref loc="MAT 24:3-14">Maato. 24:3-14</ref>; <ref loc="LUK 21:7-19">Luqa. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Yesuusa Xoozze keetstsappa seko zalara Shamahe Derizella afa bettezin, Phexiroosa, Yayqooba, Wahannisan Inddiriyase eego yi7i, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«Hyanna ayde yi7adyezako, nuus oho; hyanna ubba folinttodes wodito erisize mallita akko?» yaga7i oocida.<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Yesuusa mahi unttago hyannigaara yaga7i ohida: «Yinttana ooden balitsaame fana naaginttote. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Gaama asuntsi ta suntsite, ‹Taanii Kiristtoosa› ga7i gaama asuntsana balitstsoda. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Olan ola wore si7ize wode yirggippete. Yinnii gaarize hyanodes beezane, yezin wurssutsita hyaga. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Fettii gade asuntsi melle gade asuntsara olinttoda; mahi fettii ka7itumo melle ka7itumora olinttoda; sa7a eni7e ubba bessa hyanoda; naye yessada, yezin yinna ubbanna yelo zooqe fana.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«Yezin yinttii, yin ommite naaginttote. Akkos gayko, asi yinttana aykkii, firdda keetstsis aatsii inggoda; mahi Ayhude woosa Keetstsiten yinttana alanggara garaafoda; gade ahizuntsii tiinon kaatuntsi tiino ta gisho yin markkidhades eqqoda.<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Maato. 10:17-20</ref>; <ref loc="LUK 12:11-12">Luqa. 12:11-12</ref></char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Wurssutsita yellodannippa tiino Wonggele asi ubbas ohinttodes beezane. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Unttii yinttana firdda keetstsa ki7ize woden aatsii inggize wode waagii ohodyezako tiino yirggippete; yinna saate Xoozii yinttis inggide baz ohote. Yin gidda Geeshi Ayyaana ohinep attin yinttana baaya.<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>«Ishe fa isha, aday fa na7aya wodhissada. Na7untsi fana yeliduntsalla denddii, unttana wodhoda. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Asi ubba yinttana ta suntsiti gisho ixxoda, yezin wurssutsi yellodes miinggide attoda.<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Maato. 10:22</ref></char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">Yerusalaame yellode iita madha</para>
  <para style="r">(<ref loc="MAT 24:15-28">Maato. 24:15-28</ref>; <ref loc="LUK 21:20-24">Luqa. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«Yezin dhabsize tunize eqqodes beezoosse bessa eqqezin yin be7ada.» Yinna akko ga7inttizako nabbabize akaako! «Yihuda sa7a ye wode yezuntsi derego woxxii aachintto.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 9:27">Mahe 9:27</ref>; <ref loc="DEU 11:31">11:31</ref>; <ref loc="DEU 12:11">12:11</ref></char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Bale yeze keetstsa gelii keetstsappa fettibaz ekkodes gode, fa keetstsa gelippe.<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luqa. 17:31</ref></char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Gade yeze fa ma7ito ekkodes suuba maaqqippe. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Ye wode wodatsi maachuntsisin dhantsize maachuntsis gaama madha maaqqada. <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Yezin hyanna ubba hyanize wodita seete maaqqaame gaar, Xooz woossote. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Akkos gayko, Xoozii alamito medhdhide woditippa aykkii, hyayno yellodes hyanikaayze madhan tiinosin hyanoosse kille madha asalla afa ye wode hyanoda.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 12:1">Mahe 12:1</ref>; <ref loc="REV 7:14">Qon. 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Laatstsii yinna qammiti faydito eeritsikaayzako, asi maaqqide ooden attoos. Yezin E fa dooride asunts gisho yinna faydito eeritsane.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>«Ye wode ooden yinttana, ‹Yikke, Kiristtoosa hyanne yene woy Kiristtoosa sekka yene› yagayko, yinno ammanippete. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Worddo Kiristtoosan worddo nabuntsi denddii faas dandda7inttiko, melle atto yezin Xoozii dooriduntsappa balitstsode wontsis kille bazin gaama qofize baz beessada. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Yezin yinttii naaginttote, taanii yinttis ubba baz tiinidhii ohida.<verse eid="MRK 13:23"/></para>
  <para style="s1">Kiristtoosa lam7intsa ye7e</para>
  <para style="r">(<ref loc="MAT 24:29-31">Maato. 24:29-31</ref>; <ref loc="LUK 21:25-28">Luqa. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«Yezin ye wode yinna madhitippa suuba,</para>
  <para style="q1" vid="MRK 13:24">«Awa dhumoda;</para>
  <para style="q2" vid="MRK 13:24">agina foo7ito ashshoda;<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="JER 2:10">Er. 2:10</ref></char></note><verse eid="MRK 13:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="MRK 13:25"/>Xoolinttuntsi saloppa gol7oda;</para>
  <para style="q2" vid="MRK 13:25">mahi salo yeze wolqqitan en7oda.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa. 34:4</ref>; <ref loc="REV 6:13">Qon. 6:13</ref>; <ref loc="JER 2:10">Er. 2:10</ref></char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>Ye wode As Na7ay, damma wolqqaran bonchchora dhonne giddara ye7odera un be7ada.<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dane. 7:13</ref>; <ref loc="REV 1:7">Qon. 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Ye wode E kiitanchchuntsana kiittoda. Oyddii zala sa7a gaxappa salo gaxa yellodes, Xoozze dooride asuntsana shiishoda.<verse eid="MRK 13:27"/></para>
  <para style="s1">Wode yellidanno erisize belese minxito</para>
  <para style="r">(<ref loc="MAT 24:32-35">Maato. 24:32-35</ref>; <ref loc="LUK 21:29-33">Luqa. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«Aaziztto belese minxappa tiirote; belesta aacize wode I hyayta cil7e aykkide wode torchche yellidanno yin erane. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Yinnii gaar, yinttii yinna ubba bazita hyanizanno be7ize wode ukkii furtsa yellidanno erote. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Taanii yinttis turo ohine; hyanna ubba bazita hyanode wontsis hyanne yeze asuntsi ubba hyayqqoos. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Salon sa7an aadhoda, yezin ta qaaltta mulon aadhoos.<verse eid="MRK 13:31"/></para>
  <para style="s1">Laatstsii ye7ode qammiton saatto ooden eroos</para>
  <para style="r">(<ref loc="MAT 24:36-44">Maato. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«Yezin yinna qammiton yinna saatto Aday xalaalap attin melle atto yezin salo yeze kiitanchchuntsana maaqqikon woy Na7aya maaqqikon ooden erize baaya.<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">Maato. 24:36</ref></char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Yinna wodita ayde maaqqizako, yin eroosse gisho naaginttoten minggote. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Ta ye7ita fa keetsito ashshii, oge qitide atstse gaara. Atstsay fa aruntsis ommar ommar oocha inggi unttana oochitis ade mahida; mahi naagizen mintstsii naagode gaar kiittida.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">Luqa. 12:36</ref></char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>«Yinnii gisho, minggote. Akkos gayko, karttii aday ugure maaqqiko woy qamma bilahe maaqqin woy Lukule oollize wode maaqqin woy wontta gooda maaqqin ayde ye7ode yezako, yin eroos. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Yin tiirikaayzin E yi7i yinttana gentto yezin denggaame gaar minggote. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Taanii yinttis ohizanno asi ubbuntsis ohine; minggote» yagayda.<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">Kiristtoosalla afa maaqqinttida</para>
  <para style="r">(<ref loc="MAT 26:1-5">Maato. 26:1-5</ref>; <ref loc="LUK 22:1-2">Luqa. 22:1-2</ref>; <ref loc="JHN 11:45-53">Waha. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Faasiga Ba7aale bonchchize qamman boora Ba7ale bonchchize qamma yellodes lam77i qamma attida. Kahinunts hyalaquntsin higge asttamaaruntsi asi erikaayzin Yesuusa genii aykkii wodhodes oge koyane.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Keze 12:1</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>«Asuntsi kachchi kessaame fana Faasiga bonchchize qammite yinno oochchoos» yagayda.<verse eid="MRK 14:2"/></para>
  <para style="s1">Yesuusa shitto tizhide maachito</para>
  <para style="r">(<ref loc="MAT 26:6-13">Maato. 26:6-13</ref>; <ref loc="JHN 12:1-8">Waha. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Yesuusa Bitaaniya katamite qursumara hyargginttide Simoona keetstsa munttalla afa bettezin, fettii maachita albasxiroose bilqqaaxe kumutsi narddoosa gaaze gaama al77o shitto ekkii yi7ida. Ye bilqqaaxiza mentsii shitto Yesuusa ommite gussida.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luqa. 7:37</ref></char></note><figure style="fig" alt="Alabaster jars" file="HK00142B.TIF" size="span" ref="14:3">Albasxiroose Bilqqaaxe </figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Yinna besite yeze asuntsappa fete fete zhilidhdhii, «Hyay shittiza cer hyarii lalizanna akkoso? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Hyay shittiza hyaydzdzii xeet dinaares<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fk" closed="false">Dinaar: </char><char style="ft" closed="false">Fettii asis fettii qamma oochas ciginttize miishe.</char></note> bayzi, birtto dahuntsis immades dandda7inttane» yaga7i fa gidda ohinttida. Yeyzi, yinna maachito gaama leqqida.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Yezin Yesuusa «Hyanna maachito akkon ga7ippete; izo akkos waytsete? Iza taas lo77o baz oochchida. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Dahuntsi ubba wode yinttara yene. Yin koyeze wode ayden yin unttana maaddodes dandda7ane, yezin taanii ubba wode yinttara yezoos.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Mahe 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Iza fa dandda7idanno oochchida; mahi tana mooges giigisades tiinidhdhii shitto tizhida. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Taanii yinttis turo ohine; sa7a ubbanne Wonggele ohinttize aban, asuntsi izo tiirode fana hyanna iza oochchidanna ohinttoda» yagayda.<verse eid="MRK 14:9"/></para>
  <para style="s1">Yihuda Yesuusa aatsii immades zorinttida</para>
  <para style="r">(<ref loc="MAT 26:14-16">Maato. 26:14-16</ref>; <ref loc="LUK 22:3-6">Luqa. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Taphpho lam77i tamaaruntsappa fete Asqorootu Yihuda ga7inttize Yesuusa kahinunts hyalaquntsis aatsii immades unttago hyanggida. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Unttii yinno si7eze wode ufaytti, «Nuunii nees bira inggoda» yagayda; Yihuda Yesuusa aatsii immades wottize wode koyane.<verse eid="MRK 14:11"/></para>
  <para style="s1">Yesuusa fa tamaaruntsara Faasiga mu7ida</para>
  <para style="r">(<ref loc="MAT 26:17-25">Maato. 26:17-25</ref>; <ref loc="LUK 22:7-14">Luqa. 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Waha. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Boora Ba7aale bonchchinttize tiino qamma, Faasiga katstsa ma7ades mara shukkize wode Yesuusa tamaaruntsi eego, «Faasiga bonchchize qamma ne ma7ade katstsa nu aba hyanggi giigisade?» ga7i oocida.<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Yesuusa fa tamaaruntsappa lam77untsana hyannii gaara yaga7i kiittida: «Katama qitote; yin hyammadera, xuggara hyaatsi tookkii fettii atstse yinttara yellinttoda; eza kaallote. <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>E hyanggi gelize karttii adego, ‹Asttamaarize neego, «Taanii ta tamaaruntsara Faasiga ma7ades zaqqo keetstsita aba yene?» gayda› yaga7ote. <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Karttii adday yinttana fooqella yeze giigii bettide dalgga kifile beessada; yeyga giigizote» yagayda.<figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.TIF" size="span" ref="14:15">Fooqella yeze kifile gidda</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Yentsi tamaaruntsi kezii, katama hyanggida; Yesuusa unttago ohidanni gaara denggi, Faasiga katstsa giigizida.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Saata ugurize wode Yesuusa taphpho lam77i tamaaruntsara yeyga hyanggida. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Unttii bettii katstsa ma7adera, Yesuusa unttago, «Taanii yinttis turo ohine; yinttappa fete taara mu7ize, tana aatsii inggoda» yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz. 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>E tamaaruntsi azzanii, fa ommite ommite, «Turo tana yessane?» yaga7i eza oocida.<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Yesuusa mahi, «Ye atstse yin taphpho lam77untsappa feta; E taara fettilla fa kushito gabate dakkizaya. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>As Na7ay, Geeshi Maxaafite hyayqqoda ga7idanni gaara hyayqqoda, yezin As Na7aya, aatsii inggize atstsa bade. Ye atstse yelinttikaayzar attezako ees lo77o yeshsha» yagayda.<verse eid="MRK 14:21"/></para>
  <para style="s1">Laatstse kawo</para>
  <para style="r">(<ref loc="MAT 26:26-30">Maato. 26:26-30</ref>; <ref loc="LUK 22:14-20">Luqa. 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Qoro. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Unttii ma7adera, Yesuusa boora ekkii, Xooz galatida; ye booriza baxxi, fa tamaaruntsis inggitera, «Hya7ate, hyanna ta ashito» yagayda.<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Xuu7a ekkii, Xooz galatii, unttis inggin ubbuntsin ye xuu7izeppa uzhida. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Yesuusa, «Hyanna gaama asuntsi gisho goggize caaqo suutsi. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Taanii yinttis turo ohine; ta Xoozze ka7itumtte kille woyne ushshade qammita yellodes mahi hyay woynizeppa uzhoos» yagayda.<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Mazmure yexxidannippa suuba Shamahe Derizella afa kezida.<verse eid="MRK 14:26"/></para>
  <para style="s1">Phexiroosa kaddodanno Yesuusa tiinidhii ohida</para>
  <para style="r">(<ref loc="MAT 26:31-35">Maato. 26:31-35</ref>; <ref loc="LUK 22:31-34">Luqa. 22:31-34</ref>; <ref loc="JHN 13:36-38">Waha. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Yesuusa unttago, «Yin ubba tana ashshii ashshii lalinttoda;» Xaafinttidanni fana,</para>
  <para style="q1" vid="MRK 14:27">« ‹Xoozze duro yenggizaya wodhoda,</para>
  <para style="q2" vid="MRK 14:27">duruntsi ubbanna lalinttoda›</para>
  <para style="m" vid="MRK 14:27">yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zakka. 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Yezin taanii hyayqoppa denddidannippa suuba yinttappa tiinidhii Galila aadhoda» yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Maato. 28:16</ref></char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Phexiroosa mahi, «Unttii ubbuntsi nena ashshii ashshii dhabikon, ta nena ashshoos» yagayda.<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Yesuusa Phexiroosago, «Taanii nees turo ohine; hyayno qamma lukule lam77i tohe oollodannippa tiino ne tana hyaydzdzii tohe kaddoda» yagayda.<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Yezin Phexiroosa kasennippa mintstsii, «Taanii melle atto yezin, neera wolla hyayqqizakon, nena kaddoos» yagayda. Mahi melluntsi ubbuntsi yinnii fana gayda.<verse eid="MRK 14:31"/></para>
  <para style="s1">Yesuusa Geetesemaane woossida</para>
  <para style="r">(<ref loc="MAT 26:36-46">Maato. 26:36-46</ref>; <ref loc="LUK 22:39-46">Luqa. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Geetesemaane gaaze bessa hyanggida; Yesuusa fa tamaaruntsago, «Taanii Xooz woossii maaqqade wontsis yin hyanne bettote» yagayda.<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>Yesuusa Phexiroosa, Yayqoobaran Wahannisa faara ekkii qitida; gaama waayintti un7inttida. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Mahi unttago, «Taanii hyayqqode wontsis azzanida, hyanne gam7ote; genttippete» yagayda.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Eeratsi tiino shiiqii, sa7alla bunqunttii, dandda7inttize baz maaqqiko, hyanna waaye saata faappa aadhode gaar, Xooz woossida. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Mahi, «Ababa, ta Adayo, ubba bazita nees dandda7inttane, hyanna waaye xuu7uto taappa hyaaso. Yezin ne qoftta hyanop attin ta qoftta hyanippe» yagayda.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Yesuusa maaqqii yi7i, un genttezin denggi, Phexiroosago, «Simoona, genttida? Neenii fettii saaten barkki naagodes dandda7osa? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Madha yin gelaame gaar barkki naagii Xooz woossote. Ayyaana giigida, yezin yin ashita labbitsi» yagayda.<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Mahika hyanggi tiinosttifana Xooz woossida. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Fa tamaaruntsago suub maaqqii ye7ize wode genttezin denggida. Un aafto gentto goozii aykkide gisho E akko ohizakon eroos.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Hyaydzintsa unttago yi7i, «Hyanno yellodes genttii shemppolla? Yikke, maaqqada; saata yellida; bo7ote! As Na7ay, nagaranchcha asuntsis aadhii ingginttode wodita yellida. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Denddii yedhdhote; bo7ote, tana aatsii inggoday yellida» yagayda.<verse eid="MRK 14:42"/></para>
  <para style="s1">Yesuusa fa morkkunts kushite aykinttida</para>
  <para style="r">(<ref loc="MAT 26:47-56">Maato. 26:47-56</ref>; <ref loc="LUK 22:47-53">Luqa. 22:47-53</ref>; <ref loc="JHN 18:3-12">Waha. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Yesuusa yinno hyaga ohodera, taphpho lam77i E tamaaruntsappa fete, Yihuda, ellisii yellii ashshida. Mahi kahinunts hyalaquntsi, higge asttamaaruntsin cimuntsi kiittin, mashshan gufen aykkii gaama asuntsi eera wolla yi7ida. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Yesuusa aatsii inggiday yentsi gaama asuntsis, «Taanii yeerizay eza; eza aykkii, mintstsii naagii, ekkii kanggote» yaga7i malla ohi gaddida.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Yihuda yellii wodhdhide gaar Yesuusago shiiqii, «Asttamaarzayo» yaga7i Yesuusa yeerii ekkida. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Yentsi gaama asuntsi Yesuusa aykkida. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Yezin kale eqqiduntsappa fete fa mashshiza shoddii kahinunts hyalaqize ariza guuddii, E hyayza gachchii olida.<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>Yesuusa mahi, yentsi asuntsago, «Tana faanno mahi, faanno aykkzefana aykkodes mashshan gufen aykkii yi7idate? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Taanii Xoozze Keetstsa tamaarsitera, ubba wode yinttara yeze wode tana aykkikaayzara, yezin Geeshi Maxaafite ga7idanna folinttodes beezane» yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa. 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>E tamaaruntsi ubbuntsi eza ashshii ashshii lalinttida.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Laxana xalaala ma77ide fettii na7atitsi atstsa Yesuusa kaallizaya asuntsi aykkida. <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Yezin ye atstse laxinza ashshii ashshii, xira kallo woxxii qitida.<verse eid="MRK 14:52"/></para>
  <para style="s1">Yesuusa firdda Shanggo tiino kanggida</para>
  <para style="r">(<ref loc="MAT 26:57-68">Maato. 26:57-68</ref>; <ref loc="LUK 22:54-55">Luqa. 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Waha. 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Asuntsi Yesuusa kahinunts hyalaqize keetstsa kanggida. Ize kahinunts hyalaquntsi, cimuntsin higge asttamaaruntsi shiiqii yene. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Phexiroosa kahinunts hyalaqize woofa yellodes hyaakora eza kaallii hyanggi ize kiitinttizuntsara bettii tama kaazhane.<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>Kahinunts hyalaquntsin firdda shangguntsi ubba Yesuusa wodhodes eella afa markka koyda, yezin akkon denggikaaya. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Gaama asuntsi eella afa worddo markkidhida, yezin un markkatitsita fetto baaya.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>Fettii fettii asuntsi denddii eqqii Yesuusalla, «E, ‹Taanii asi keexide hyanna Xoozze Keetsito lalii, asi kushera keexinttikaayze melle Xoozze Keetstsi hyaydzdzii qamma gidda keexxoda› ga7odera nuunii si7ida» yaga7i worddo markkidhida.<note caller="-" style="x"><char style="xo" closed="false">14:57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Waha. 2:19</ref></char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>Maaqqo yezin, un markkatitsita yinnan fetto baaya.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Kahinunts hyalaqize as ubbunts tiintte denddii eqqii, «Hyantses nena mootize mootis ne mahizebaz baa?» yaga7i Yesuusa oocida. <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Yezin Yesuusa si77i gayda; akkon mahikaaya. Kahinunts hyalaqize, «Anjjinttide Xoozze Na7ay, Kiristtoosa nenane?» yaga7i mahi oocida.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Yesuusa mahi, «Yee tana, yin As Na7ay, wolqqaama Xoozzeppa mizaqi zalara bettezin mahi salo dhonnera ye7odera be7ada» yagayda.<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dane. 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Kahinunts hyalaqize fa ma7ito feedhii, «Nuus melle markka akko koshshe? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Yin E cashito si7ida; yin qoftta akko?» yagayda. Un ubbuntsi, «E hyayqqodes beezane» yaga7i eella afa firddida.<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">Leewe 24:15</ref></char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Unttappa fete fete eella afa cutte aykkida. E aafto goozii baqqittera, «Nena qoxxide oode? Ane nuus oho!» yagayda. Naagizuntsi eza guudditera kanggida.<verse eid="MRK 14:65"/></para>
  <para style="s1">Phexiroosa Yesuusa kaddida</para>
  <para style="r">(<ref loc="MAT 26:69-75">Maato. 26:69-75</ref>; <ref loc="LUK 22:56-62">Luqa. 22:56-62</ref>; <ref loc="JHN 18:15-18">Waha. 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Phexiroosa kahinunts hyalaqize woofa yeekka zalara yezin, kahinunts hyalaqize maachi aruntsappa fetta ize yi7ida. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Phexiroosa tama kaazhanno bi7i, dakkii loytsii bi7i, «Neenin Naazirete Yesuusara yene» yagayda.<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Yezin Phexiroosa, «Ne gaazana akko yezakon ta eroosin, taas tiirinttoos» yaga7i kaddida. Yaga7i maaqqii woofa kezida [iira lukule oollida]<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">Fettii fettii maxaafite iira lukule oollida gaazana baaya</char></note>.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Yinna arita Phexiroosa bi7i, E kale eqqide asuntsago, «Hyay atstsen unttara yene» ga7i mahi ohida. <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Yezin Phexiroosa mahin kaddida. Eeratsi gam7odera, kale eqqide asuntsi mahi Phexiroosago, «Neenii Galila sa7a asi maaqqide gisho turo unttara yene» yagayda.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Yezin Phexiroosa, «Taanii yin gaaze atstsa eroos!» yaga7i fana baadditera caaqo aykkida.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Iira lukule lam7intsa oollii ashshida. Phexiroosa Yesuusa eego, «Neenii lukule lam77i tohe oollodannippa tiino hyaydzdzii tohe tana kaddoda» eego gaydanno tiirii yeekkida.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">Yesuusa Philaaxoosago kanggida</para>
  <para style="r">(<ref loc="MAT 27:1-2">Maato. 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luqa. 23:1-5</ref>; <ref loc="JHN 18:28-38">Waha. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Wontta gooda ellisii kahinunts hyalaquntsi, cimuntsi, higge asttamaaruntsin firdda shangguntsi ubba shiiqii zorinttida. Unttii Yesuusa accii kanggi Philaaxoosas aatsii inggidda.<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>Philaaxoosa eego, «Neenii Ayhudunts kaati?» yaga7i oocida.</para>
  <para style="p" vid="MRK 15:2">Yesuusa mahi, «Ne gayda» yagayda.<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Kahinunts hyalaquntsi Yesuusa gaama bazara mootida. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Yezin Philaaxoosa mahi Yesuusago, «Nees mahizebaz baa? Unttii neella akko mooto ke7izako bo7oso?» yagayda.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Yezin Yesuusa mellebaz mahanxi ixxin, Philaaxoosa gaama qoppida.<verse eid="MRK 15:5"/></para>
  <para style="s1">Yesuusa hyayqqo ga7i firddida</para>
  <para style="r">(<ref loc="MAT 27:15-26">Maato. 27:15-26</ref>; <ref loc="LUK 23:13-25">Luqa. 23:13-25</ref>; <ref loc="JHN 18:39-40">Waha. 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Philaaxoosas Faasiga Ba7aale bonchchize qammite asuntsi koyze fettii asi achchappa billize woga yene. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Ye wode fettii Barbaana gaaze atstse kachchi dentsii shemppo wodhide asuntsara wolla achi keetstsa yene. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Gaama asuntsi Philaaxoosago yi7i tiinoppa yiizitera gam7ide fana oochchode gaar eza oocida. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Philaaxoosa asuntsana mahi, «Taanii yinttis Ayhudunts kaatiza billode gaar koyane?» yaga7i oocida. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Yinno E ga7idanna, kahinunts hyalaquntsi Yesuusa qanaatii aatsii inggidanno erize gisho.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Yezin kahinunts hyalaquntsi E gisho Barbaana billode gaar, yentsi shiiqide asuntsi Philaaxoosa woossode gaar asuntsana zorida. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Philaaxoosa mahi, «Yeezin, yin Ayhude kaati gaazaya wayssa?» yagayda.<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Asuntsi Philaaxoosalla afa uukki, «Masqalalla afa eza suxxo» yagayda.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Philaaxoosa asuntsago, «Akkoso? E akko iita baz oochchido?» yagayda.</para>
  <para style="p" vid="MRK 15:14">Yezin asuntsi tiinostippa gujjii uukki, «Masqalalla eza suxxo» yagayda.<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Philaaxoosa asuntsana ufayssodes koyi, Barbaana asuntsis billida; yeyzi allanggara Yesuusa garafii, masqalalla afa suxxode gaar aatsii inggida.<verse eid="MRK 15:15"/></para>
  <para style="s1">Wottaddaruntsi Yesuusa leqqida</para>
  <para style="r">(<ref loc="MAT 27:27-31">Maato. 27:27-31</ref>; <ref loc="JHN 19:2-3">Waha. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Yinnippa maaqqii, wottaddaruntsi Yesuusa ekkii Piratoriya gaaze Poolis xaaba kanggi, melle wottaddaruntsana ubba fettilla xeegida. <figure style="fig" alt="Head of Jesus wearing crown of thorns" file="LB00321B.TIF" size="span" ref="15:16">Yesuusa omitilla anggatsi gaddida </figure> <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Mahi zoqo afula eza mayzida; anggatsi zawude giigizii, E ommite gaddida. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Yinnippa maaqqii, eego, «Ayhudunts kaatizayo saro» yaga7i, kushe dentsida. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>E ommite gufera guuddida; mahi eella cuttida; bunqquntii ees goynida. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Eza toochidannippa maaqqii zoqo afula eeppa qaarii ekkii, E afultto eza ma7isii masqalalla afa eza suxxodes ekkii kanggida.<verse eid="MRK 15:20"/></para>
  <para style="s1">Yesuusa suxxida</para>
  <para style="r">(<ref loc="MAT 27:32-44">Maato. 27:32-44</ref>; <ref loc="LUK 23:26-43">Luqa. 23:26-43</ref>; <ref loc="JHN 19:17-27">Waha. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Un hyanggitera, Iskkinddirenen Rufoosa aday, Simoona gaaze Qereena sa7a asi, gaxareppa katama ye7izera yellintti, Yesuusa masqala wolqqara toossida.<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">Rome 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Yeyzi Golggotta gaaze bessa Yesuusa kanggida. «Golggotta» gaazanna «Omma ota» ga7e. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Hyargaame fana karbbe gaaze gaalla worqqinttide woyne uzho ga7i ees inggida. Yezin E uzhanxi ixxida. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Unttii masqalalla afa eza suxxida. Oona akko yellodyezakon ga7i E afultto shagii ixa olida.<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>Un masqalalla afa eza suxxize wode wonttappa hyaydzdzii saate. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Un, «Ayhudunts kaat» yaga7i eza mootize xuufe xaafii gaddida. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Yesuusara lam77i faanuntsana feta eeppa mizaqi zalara hyankkaya eeppa workkita zalara masqalalla afa suxxida. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>Geeshi Maxaafite, «Iita baz oochchide asuntsara E faydinttida» ga7inttidanna folinttida.<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa. 53:12</ref></char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Ogera aadhize asuntsi Yesuusa leqqii, fa ommito en7izi cazhida; «Zambbay! Xoozze Keetsito lalii hyaydzdzii qamma gidda keexizayo, ne ommito ashsho;<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maz. 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar. 14:58</ref>; <ref loc="JHN 2:19">Waha. 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ane masqalizeppa wodhdhii nena ashsho» yagayda.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Yinnii gaara, kahinunts hyalaquntsi higge tamaarssizuntsara fettilla Yesuusa leqqii, «Melluntsana ashshida, yezin fana ashshodes dandda7oos; <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>nuunii bi7i ammanode gaar Kiristtoosa, Isra7eele Kaati, ane masqalappa hyatte wodhdho» yagayda. Mahi melle atto yezin, eera masqalalla afa suxunttiduntsappa eza leqqida.<verse eid="MRK 15:32"/></para>
  <para style="s1">Yesuusa hyayqqida</para>
  <para style="r">(<ref loc="MAT 27:45-56">Maato. 27:45-56</ref>; <ref loc="LUK 23:44-49">Luqa. 23:44-49</ref>; <ref loc="JHN 19:28-30">Waha. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Izippun saateppa dentsii, uddufun saate yellodes sa7ita ubba dhumida. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Uddufun saate Yesuusa fa qaaltto dhoqi yiizii, «Elohee, Elohee, laama sabaqitani?» yagayda. Yinnii bilitsita, «Ta Xoozayo, ta Xoozayo, tana akkos ashshido?» ga7e.<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maz. 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Ize eqqide asappa fete fete yinno si7i, «Yikke, Eeliyaasa xeegane» yagayda. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Yentsi asuntsappa fete woxxii, gurba fuzara caala woyne baazhii; gufe bertstsalla gaddii, «Naagote; Eeliyaasa masqalappa eza ketstsodes ye7odyezako ane bo7oda» yaga7i Yesuusa doonago ushshodes shiishida.<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz. 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Yesuusa fa qaaltto dhoqi yiizii uukki, hyayqqida.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Xoozze Keetstsa suxunttide magaraajita wokkappa sulle gaxa yellodes, lam77i kezii feedhinttii wodhdhida.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Keze 26:31</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Masqalzeppa tiino zalara ize eqqide fettii mato hyalaqize, Yesuusa wayzi hyayqqezako bi7ide wode «Hyay atstse turo Xoozze Na7a» yagayda.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Yinno hyaakora eqqii be7ize eerats maachuntsi yene. Un gidda Magdela Mayrama, geezze Yayqooban Yoosa intta Mayramiran Salooma yene. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Yentsi maachuntsi Yesuusa Galila yeze wode eza kaalliduntsanan eza mokkiduntsana mahi Yesuusara wolla Yerusalaame hyanggide melle gaama maachuntsi ize yene.<note caller="-" style="x"><char style="xo" closed="false">15:41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luqa. 8:2-3</ref></char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">Yesuusa mooginttida</para>
  <para style="r">(<ref loc="MAT 27:57-61">Maato. 27:57-61</ref>; <ref loc="LUK 23:50-56">Luqa. 23:50-56</ref>; <ref loc="JHN 19:38-42">Waha. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>Sa7ita uguride wode shiiqide asunts gidda bonchchinttide Ayhude shangguntsappa fete, Yoosefa gaaze atstse, Xoozze ka7itumo yo7odanno naagitera yeze, Armmatiyasa katama asi yezay yi7ida. Wonttistte Sambbatas giiginttize qamma maaqqide gisho Yoosefa miinggi Philaaxoosago hyanggi, Yesuusa ahito ekkodes woossida. <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>Philaaxoosa Yesuusa hyayqqidanno si7ide wode gaama qoppida; mato hyalaqiza xeegii, «E hyayqqi gam7ida?» yaga7i oocida. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Philaaxoosa Yesuusa hyayqqidanno mato hyalaqizeppa si7i E ahito Yoosefas inggida. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Yoosefa moogo afula wonggi; Yesuusa ahito masqalappa ketstsii, afulara xaaxii, shuchchappa woocinttide booza gidda E ahito moogida. Mahi yinna booziti doontte damma shuchchi gol7izi gaddida. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Magdela Mayramiran Yoosa intta Mayrama Yesuusa ahito un aanne gaddizako be7ine.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Yesuusa hyayqoppa denddida</para>
  <para style="r">(<ref loc="MAT 28:1-8">Maato. 28:1-8</ref>; <ref loc="LUK 24:1-12">Luqa. 24:1-12</ref>; <ref loc="JHN 20:1-10">Waha. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Sambbata aadhidannippa suuba Magdela Mayramo, Yayqooba intta Mayramiran Salooma hyanggi, Yesuusa ahito tishshades shitto wonggida. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Wogga wode wontta gooda xalqe kessadera, booza hyanggida. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Un fa gidda fetay fetayra, «Booziti doonttippa nuus shuchchito oode gol7izi hyaasode?» yaga7i ohinttida.<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>Un be7ize wode ye anddir damma shuchchize bunbbulunttii hyal7idanno bi7ida. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Yesuusa mooginttide booziti gidda gelize wode fettii yidhdho dhiiratsay bootsi ma7o ma77i, mizaqi zalara bettiday bi7i tannida.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Yezin E unttago, «Tannippete; masqalalla afa suxunttide, Naazirete Yesuusa yin koyzanno taanii erane. E hyanne baaya, hyayqoppa denddida. Un eza moogide bessito hyanno bo7ote. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Hyatte hyanggi Yesuusa tamaaruntsisin Phexiroosas, ‹Yesuusa yinttappa tiinidhii Galila aadhida. E yinttis ohidanni fana yin eza yeyga be7ada› ga7i ohote» yagayda.<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Maato. 26:32</ref>; <ref loc="MRK 14:28">Mar. 14:28</ref></char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Maachuntsi zhashmora goqii boozitippa kezii aachinttida. Mahi un zhashtize gisho yinno oodesin akkon ohikaaya.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Fettii fettii zaga maxaafuntsi Marqqoosa Wonggele faydo 8 lla afa essane. Mahi fettii fettii maxaafuntsi faydo 9-20 yellodes yeze qoftto gujjoos. Maaqqikon melluntsi, faydo 8 kaallii yezanno gujjane. Yinnan [Maachuntsi hyanggi, kiitanchcho ohidanno ubba Phexiroosan eera yezuntsis hyaatara ohida. Yinnippa suuba, Yesuusa fa tamaaruntsana geeshin medhina atotitsi Wonggele kiitto awa kessappa awa gelo yellodes kiittida]</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">Yesuusa Magdela Mayramis benttida</para>
  <para style="r">(<ref loc="MAT 28:9-10">Maato. 28:9-10</ref>; <ref loc="JHN 20:11-18">Waha. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Yesuusa hyayqoppa denddidannippa maaqqii wogga wode wontta, laappun tuna ayyaanuntsana kesside Magdela Mayramis tiinidhii benttida. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Iza hyanggi eera tiino yezuntsis, un azzaniteran yeekkittera yezin ohida. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Yezin Yesuusa faxa yezannon iis benttidanno un si7ide wode iza gaazanno ammanikaaya.<verse eid="MRK 16:11"/></para>
  <para style="s1">Yesuusa lam77i fa tamaaruntsis benttida</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luqa. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Yinnippa suuba, unttappa lam77untsi katamappa kezii hyammadera, ogella afa Yesuusa tiinoppa dumudhii unttis benttida. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Un suub maaqqii, melluntsis ohidap, attin melluntsin un ohito turo gaykaaya.<verse eid="MRK 16:13"/></para>
  <para style="s1">Yesuusa taphpho fettii fa tamaaruntsis benttida</para>
  <para style="r">(<ref loc="MAT 28:16-20">Maato. 28:16-20</ref>; <ref loc="LUK 24:36-49">Luqa. 24:36-49</ref>; <ref loc="JHN 20:19-23">Waha. 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Suubappa taphpho fettii E tamaaruntsi katstsa ma7adera, Yesuusa unttis benttida. Unttis ammano baayze gishon hyayqoppa E denddidanno bi7ide asuntsi ohin un ammananxii ixxide gisho E unttana borida.<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>E unttago, «Sa7a ubba qitii as ubbuntsis Wonggele ohote.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Hawa. 1:8</ref></char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ammanidayin xammaqinttiday attoda, yezin ammanoose firddinttoda. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Ammanzuntsis hyanna mallita ingginttoda. Un ta suntsite tuna ayyaana kessoda, kille doonara ohinttoda. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Un shooshi aykkikon woy wodhizebaz uzhikon unttana qohaama. Mahi un fa kushito hyargginttizuntsalla afa gaddii unttana fatstsoda» yagayda.<verse eid="MRK 16:18"/></para>
  <para style="s1">Yesuusa ude Salo kezida</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luqa. 24:50-53</ref>; <ref loc="ACT 1:9-11">Hawa. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Laatstsii Yesuusa tamaaruntsara ohinttidannippa suuba ude salo kezida; Xoozzeppa mizaqi zalara bettida.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">Hawa. 1:9</ref></char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>E tamaaruntsi qitide bessa ubba qaala ohida. Laatstsin unttara wolla oochchane. Unttii ohize qaaltta turo maaqqidanno Xoozii unttis inggide mallite miintsane.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
