<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Ehebǝritǝpǝ</para>
  <para style="toc3">Ehe</para>
  <para style="toc2">Ehebǝritǝpǝ</para>
  <para style="toc1">Kǝfwɛɛkǝ we pǝ la ŋʊrʊ pǝ la maŋ Ehebǝritǝpǝ wǝ</para>
  <para style="mt2">Kǝfwɛɛkǝ we pǝ la ŋʊrʊ pǝ la maŋ</para>
  <para style="mt1">Ehebǝritǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pǝ lee ci kǝfwɛɛkǝ sa la ŋʊrʊtǝyǝ, wǝ́ pǝ laa lɛ pǝ ci epǝ we kororo nyiyǝ sa ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ na maŋ wǝ. Paa kǝ ya kǝ láa wɛɛlɩ kǝ ŋ tíi ekǝrisotǝpǝ rɛ pǝ leh mǝ ri Oyudatǝpǝ pǝ kpii rǝ acʊcʊʊrʊyǝ, wǝ́ wǝ la pia mǝ pǝ wǝ. Wǝ́ pǝ lǝ lǝǝrǝ faawǝ we pǝ ka ŋ nya rǝ kǝsǝŋkǝ, wǝ́ arɛɛpǝ rǝ pǝlǝ mǝrǝ kʊraa pǝ ka ŋ yɩrɩ pǝ nyarǝ lɔnuŋrǝ rǝ Kǝriso pǝ co rǝ wǝ. Nyiyǝ sa ŋ na ŋʊrʊ kǝfwɛɛkǝ sa lee ri Oyudatǝpǝ paape cii Dieparǝtǝnǝkuukuurǝ we la wǝfwɛɛkpǝ le etieyǝ ŋpa. Kǝfwɛɛkǝ sa la ŋʊrʊtǝyǝ ya láa ta pǝlo turuwǝ pǝ tɔ pǝ yaa kiŋkiŋ rǝ lɔnuŋrǝ sa mǝrǝ. Duturǝ ɖi Kǝriso yǝ we ŋ ri otoolutǝmumuŋpǝ le ceeceeceeceeyǝ we, le fii fɛɛkenikeniwǝ le kenikeniwǝ rǝ yulaarǝ mǝ na ŋpǝrayǝ eniyǝ we ŋ kpǝ̀ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. Saŋ rǝ Kǝriso we, alɔnuŋtǝpǝ pǝ lóo koru oruu pǝ kǝlǝ mǝ Worokoyǝ mǝ kpɛɛtɛɛwǝ. Kǝfwɛɛkǝ sa kǝ la tɛŋ ǝkǝnǝŋ Worokoyǝ la pɔrʊ na wɛ la kaŋ fee saŋ rǝ ne Piyǝ Yesu Kǝriso lo oŋuŋkǝ (<char style="xt"><ref loc="HEB 1:13">1:13</ref></char>).</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Worokoyǝ la apɔrʊkaŋkǝ saŋ rǝ Kǝriso 1:1-3</para>
  <para style="io">- Kǝriso teeri epicoŋpipǝ 1:4–2:18</para>
  <para style="io">- Kǝriso teeri Mose mǝ Yoswa 3:1–4:13</para>
  <para style="io">- Kǝriso ri toolutǝyǝ teeri otoolutǝtuturupǝ 4:12–7:28</para>
  <para style="io">- Kǝriso le dieparǝtǝnǝrǝ lo to le teeri etieparǝtǝnǝtuturuyǝ 8:1–9:28</para>
  <para style="io">- Kǝriso lo otoolukǝ sa ŋ ne yee kǝ lo to milimili kǝ le teeri 10:1-39</para>
  <para style="io">- Lɔnuŋrǝ lo okururuyǝ 11:1–12:29</para>
  <para style="io">- Ecikaŋtuturukǝ 13:1-25</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Worokoyǝ la wɛɛlɩ mǝ lǝ saŋ rǝ ne Pi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Rǝ gakarǝ we, Worokoyǝ wɛ̀ɛlɩ mǝ lǝh ǝtǝtǝpǝ kǝpakakǝpaka mǝ wǝlǝkpǝ kpookpoo sanǝ rǝ akpɛɛnuŋtɛŋtǝpǝ. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Paa rǝkǝsa we, rǝ enituturuyǝ sa mǝrǝ we, Worokoyǝ la wɛɛlɩ mǝ lǝ la saŋ rǝ ne Piyǝ. Piyǝ sa wǝ́ ŋwǝŋwǝ ŋ na saa ŋ nǝ tǝnǝ wǝ́ ŋ nǝ fǝ otuyǝ kpǝlo kɩɩkɩ ŋ ne kpii ŋwǝ rǝ akaakǝ wǝ. La saŋ rǝ ŋwǝ Piyǝ sa lo co ǝrǝkǝ. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Worokoyǝ la wǝnyɩɩnɩkpǝ kpǝlo kɩɩkɩ wǝ láa nyɩnɩ rǝ Piyǝ sa. Worokoyǝ lǝ wǝlǝpoŋpikpǝ kpaŋ wǝ kaamǝ Piyǝ sa. Piyǝ sa lǝ fǝ ŋwǝŋwǝ ne dierǝ lo okopiyǝ la ta ǝrǝkǝ re. Kǝ́ ŋ na lɛrɩ enyipǝ ŋ no ru rǝ pǝlo oturɔɔrɔɔyǝ ŋ na lɛ we, wǝ́ ŋ ne ke tii rǝ Woroko Kopilǝtǝyǝ le kǝnirisiɛɛkǝ rǝ yulaarǝ.<verse eid="HEB 1:3" /></para>
  <para style="s">Worokoyǝ le Pi teeri epicoŋpipǝ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Ŋwǝ Piyǝ sa le pe ri mumuŋyǝ ŋpa le teeri epicoŋpipǝ, wǝ́ Worokoyǝ ŋ kpìi na nyɩŋrǝ lo ru okuruyǝ ŋpa le teeri epicoŋpipǝ la nɛŋrǝ. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Wǝ́ Worokoyǝ fee tíi epicoŋpipǝ la rɛ ŋ nyɩŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:5">«Ŋlǝ́ e ri mǝ Piyǝ,</para>
  <para style="q1" vid="HEB 1:5">ŋmǝ ŋ́ nǝ mǝ lǝ́ ruŋruŋ».</para>
  <para style="m" vid="HEB 1:5">Wǝ́ faa lɛ ŋ tɛŋ ŋ nyɩŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:5">«Ŋmǝ we, ŋ́ née ri tǝyǝ ŋ́ koonu ŋwǝ,</para>
  <para style="q1" vid="HEB 1:5">kǝ ŋwǝ we, ŋ ri piyǝ ŋ koonu mǝ».<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Paa kǝ́ Worokoyǝ ŋ ke ŋ kpii ne Pisǝŋmǝyǝ rǝ ǝrǝkǝ we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:6">«Wǝ kpii kǝ Worokoyǝ le epicoŋpipǝ kpǝlo kɩɩkɩ pǝ sʊma ŋwǝ».<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Paa Worokoyǝ tɛnɩ rù rǝ epicoŋpipǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:7">«Worokoyǝ lǝ́ǝ fǝ ne epicoŋpipǝ mǝ ŋ yee kǝnǝnɛkǝ mǝŋ kǝ́ ŋ nǝ́ǝ fǝ ǝrǝfuŋkǝ mǝ ŋ yee kǝnǝnɛkǝ kǝtǝ,</para>
  <para style="q1" vid="HEB 1:7">wǝ́ ŋ nǝ́ǝ fǝ na asʊmatǝpǝ mǝ ŋ yee kǝnǝnɛkǝ mǝŋ kǝ́ ŋ nǝ́ǝ fǝ naapǝlapǝlawǝ mǝ ŋ yee kǝnǝnɛkǝ kǝtǝ».<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Paa la tɛŋ lo ru rǝ Piyǝ lo oŋuŋkǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:8">«Oo Worokoyǝ, lé wǝpilirikpǝ wǝ le tii kǝkpakǝkpa.</para>
  <para style="q1" vid="HEB 1:8">Ǝ lǝ fǝ wǝkʊʊkpǝ a ya lée ri wǝpilirikpǝ.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />A láa taa wǝkʊʊkpǝ lǝ kǝǝwǝ, wǝ́ ǝ lǝ́ǝ kpǝlǝ rɔɔrɔɔwǝ lǝ kǝǝwǝ.</para>
  <para style="q1" vid="HEB 1:9">Oo Worokoyǝ! Wǝ kǝto ló Worokoyǝ ŋ na saa lǝ́ ŋ na pɔrʊ,</para>
  <para style="q1" vid="HEB 1:9">wǝ́ ŋ no nuŋ lǝ́ faawǝ la apɔŋpǝ, wǝ́ ŋ na lɛ ŋ na taa lǝ́ kǝǝwǝ ŋ ne teeri lǝ́ ǝtǝŋpǝ wǝǝ».<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Worokoyǝ lǝ tǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:10">«Kulǝtǝyǝ, rǝ kǝsǝŋkǝ we, ŋlǝ́ o cò kǝtǝǝwǝ,</para>
  <para style="q1" vid="HEB 1:10">wǝ́ yulaarǝ ɖi lá wǝkaakpǝ la kǝnǝnɛyeekǝ.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Ŋyǝ otuyǝ sa yǝ lǝh pǝ nǝŋ, paa ŋlǝ́ we, e kpii kǝkpakǝkpa.</para>
  <para style="q1" vid="HEB 1:11">Yǝ loh po kuukuu mǝŋ kǝ́ kǝkpakǝ kǝ lóo kuukuu kǝtǝ<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />e leh pe piri yǝ mǝŋ kǝ́ pǝ lée piri vǝŋkǝrǝ kǝtǝ.</para>
  <para style="q1" vid="HEB 1:12">Awo, pǝ lah pa cɛkɛlɛ yǝ mǝŋ kǝ́ pǝ láa cɛkɛlɛ wǝkpakpǝ kǝtǝ.</para>
  <para style="q1" vid="HEB 1:12">Ŋlǝ́ paa we, kǝ́ ǝ lǝ wǝ́ ǝ tǝ ǝ lǝ rǝ ko, lá vɔrʊrǝ lǝŋ pa lɛ!»<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Wǝ́ epicoŋpipǝ lǝ yǝ rǝ fǝŋ wǝ́ Worokoyǝ ŋ ne tíi ŋ na nyɩŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 1:13">«Sɔ e tii rǝ mǝ kǝnirisiɛɛkǝ,</para>
  <para style="q1" vid="HEB 1:13">ko ro eniyǝ we ŋ́ nǝ́ǝ fǝ lǝ́ ǝkǝǝkpǝlǝtǝpǝ ŋ́ yee</para>
  <para style="q1" vid="HEB 1:13">ló tutɛakparǝyǝ» wǝ?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Mǝŋkǝ epicoŋpipǝ pǝ ri rǝ awɛɛyǝ yǝ lée yee anǝnɛyǝ yǝ ŋ koonu Worokoyǝ wǝ? Lée kpii pǝ pǝ ŋ ko pǝ ŋ yee anǝnɛyǝ pǝ toŋ enyipǝ we wǝ kpii kǝ pǝ nya alɔkuŋkǝ mǝŋ tǝtuwǝ kǝtǝ wǝ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Rɛ ŋ pǝǝ sǝ́ŋ Worokoyǝ la alɔkuŋmumuŋkǝ sa le dierǝ ŋ co</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Wǝ kǝto we, mǝŋ yǝ lǝŋ pǝ́ lǝ pǝ lǝǝ we, wǝ kpii kǝ la kpaa la maarǝ mǝ dierǝ we yǝ lo nuŋ kpamama. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Duturǝ ɖi, dierǝ we epicoŋpipǝ pǝ pǝlǝ pǝ tɛnɩ pǝ tìi lǝh ǝtǝtǝpǝ yeli kǝnǝnɛkǝ, wǝ́ nyiyǝ lǝ yǝ ŋ nee siimǝ dierǝ sa amaa ŋ tǝ̀nǝ kǝtukoŋkǝ rǝ dierǝ sa we, lɔ̀ tukoŋtawǝ we wǝ kaamǝ wǝ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Mǝŋ wǝ lǝ ǝnǝ wǝǝ, kǝ ŋlǝ lo koru osuu la cɛ tukoŋtawǝ sa la saŋ nɛ mǝŋ yǝ lǝ fǝ alɔkuŋkǝ sa wǝrʊʊkpǝ yǝ le kpii rǝ kǝpɛŋkǝ wǝ? Kulǝtǝyǝ ŋwǝŋwǝ ŋ tìe alɔkuŋkǝ sa le dierǝ la atɛŋkǝ. Wǝ́ epǝ we pǝ nunu Kulǝtǝyǝ le dierǝ sa we, pǝ le pe ri rǝla anʊkɔrǝyǝ pǝ le tíi lǝ. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Wǝ́ Worokoyǝ ŋ tɛ̀ɛ pǝla ɖaŋsieyǝ sa la gaapirǝ saŋ rǝ apayǝ, otuyǝ kǝkpǝŋkǝ rɛ ŋ faa nyɩŋ ŋ tǝnǝ mǝ otucovurǝ. Tǝ fǝ kʊla we, wǝ́ Worokoyǝ ŋ na lɛmɩ pǝ la Wɛɛkenikenirǝ lo otukoonuyǝ mǝŋ kǝ́ ŋwǝŋwǝ ŋ nǝ pǝ́ wǝ.<verse eid="HEB 2:4" /></para>
  <para style="s">Yǝ we ŋ no koonu enyipǝ la alɔkuŋkǝ wǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Duturǝ ɖi ǝrǝkǝ sa kǝ kpii kǝ lǝ́ǝ pǝ lo tuwǝ la ya yǝ láa tɛŋ we, ŋkǝ epicoŋpipǝ kǝnǝŋkǝ wǝ́ Worokoyǝ ŋ nǝ fǝ kǝ ŋ ne kpii. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Paa rǝ Wǝŋʊrʊkenikenikpǝ la fɛɛwǝ rɛ we, rɛ le ri ɖaŋsieyǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 2:6">«Kǝ́ wǝ́ nyɩmaasɩyǝ ŋ ri kǝ a ya mǝ taalǝ ŋwǝ wǝ?</para>
  <para style="q1" vid="HEB 2:6">Amaa nyɩmaasɩkpaakpaayǝ sa rǝ, kǝ a mǝ yɩrɩ no yurǝ?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />A pɛ̀ɛlɩ ŋwǝ e tèeri epicoŋpipǝ koonu enipiyǝ rɛ.</para>
  <para style="q1" vid="HEB 2:7">Ǝ lǝ fǝ anaanǝkǝ mǝ ǝkǝkǝ o lo koonu ŋwǝ,<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />ǝ lǝ fǝ tu ri ŋ tu e le kpii ŋwǝ rǝ akparǝyǝ kǝnǝŋkǝ.»</para>
  <para style="m" vid="HEB 2:8">Kǝ́ Worokoyǝ ŋ pɛ̀ɛlɩ tu ri ŋ tu ŋ kòonu ŋwǝ we, kǝceece laa maa tǝrɛ ŋ tǝnǝ kǝ o turu wǝ laa pɛɛlɩ wǝ koonu ŋwǝ. Paape we, rǝkǝsa la faa maa la nyɩŋ kǝ́ tu ri ŋ tu wǝ la pɛɛlɩ wǝ lo koonu ŋwǝ wǝ. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Paa tuwǝ la ya yǝ láa nyɩŋ wǝ kaamǝ wǝ ǝnǝ: Yesu yǝ we pǝ pɛ̀ɛlɩ pǝ tèeri epicoŋpipǝ koonu enipiyǝ rɛ we, ŋwǝ wǝ́ pǝ lǝ fǝ anaanǝkǝ mǝ arɛɛrɩmǝkǝ pǝ lo koonu kpiikǝ ŋ cʊ̀ʊrʊ wǝ́ ŋ kpǝ̀ kǝto. Mǝŋkǝsa we, saŋ rǝ Worokoyǝ la lɛsiɛrɩwǝ wǝ́ Yesu ŋ kpǝ̀ rǝ enyipǝ kpǝlo kɩɩkɩ lo yuwǝ. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Worokoyǝ we ŋ no co tu ri ŋ tu, ǝkǝ tu ri ŋ tu wǝ kpii wǝ koonu ŋwǝ we, kǝ ŋ pǝ́ ŋ re ne epipǝ wa ŋ fii na wǝnyɩɩnɩkpǝ. Wǝ kǝto wǝ ka kaamǝ kǝ ŋ koonu Yesu ŋ to milimili saŋ rǝ acʊcʊʊrʊyǝ mǝrǝ. Duturǝ ɖi yǝ we lǝ kpǝŋ pǝla alɔkuŋkǝ sa kǝ lo ru we, ŋ kaamǝ Yesu. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Wǝ́ Yesu yǝ we ŋ náa lɛrɩ anyɩmaasɩpǝ mǝ ŋ ru rǝ pǝlo oturɔɔrɔɔyǝ, mǝ epǝ we pǝ la lɛrɩ pǝ lo ru rǝ pǝlo oturɔɔrɔɔyǝ we, pǝlo kpǝlo pǝ lǝǝmǝ Tǝyǝ ceŋceŋ. Wǝ kǝto wǝ loo co Yesu la nʊŋsɔɔwǝ kǝ́ ŋ nóo pwo pǝ na apaanʊpǝ wǝǝ. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Yesu tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 2:12">«Worokoyǝ, ŋ́ náa wɛɛlɩ ŋ ru rǝ lǝ́ ŋ tíi mǝ apaanʊpǝ,</para>
  <para style="q1" vid="HEB 2:12">ŋ́ nǝ́ǝ kǝ lǝ́ rǝ apaanʊpǝ la mǝrǝ vǝ́ pǝ lo ku pǝ lah sʊma lǝ́ wǝ».<verse eid="HEB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HEB 2:13" />Wǝ́ ŋ lɛ̀ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 2:13">«Ŋmǝ we, ŋ́ náa tɛɛ mǝ kpɛɛwǝ fee rǝ lǝ́».</para>
  <para style="m" vid="HEB 2:13">Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 2:13">«Ŋmǝ ǝyǝǝ, ŋlǝ mǝ epipǝ we Worokoyǝ ŋ no koonu mǝ wǝ».<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Mǝŋkǝsa we, kǝ́ wǝ ri ǝkǝnǝŋ epipǝ sa pǝ ri rǝ anyɩmaasɩpǝ mǝ kǝwɛlɛŋkakǝ mǝ ŋpǝrayǝ kǝto we, wǝ́ Yesu ŋwǝ ŋkpɛ ŋ sìɛrɩ ŋ yeli nyɩmaasɩyǝ mǝ kǝwɛlɛŋkakǝ mǝ ŋpǝrayǝ mǝŋ ŋpǝ kǝtǝ. Yeli wǝ ǝnǝ, kǝ saŋ rǝ na gbɛŋrǝ sa we, ŋ nya fɛɛ ŋ nǝǝnǝ Abʊŋsamʊyǝ lo okopiyǝ, ŋwǝ yǝ we ŋ ke re gbɛŋrǝ lo okopiyǝ wǝ. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Yesu yeli wǝ ǝnǝ kǝ ŋ nya fɛɛ ŋ pɔrʊ epǝ we pǝ sìɛrɩ pǝ yeli arɔŋpǝ pǝ kòonu gbɛŋrǝ lo vusuurǝ rǝ pǝla vɔrʊrǝ le eciyǝ kpǝlo kɩɩkɩ wǝ. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Duturǝ ɖi, kǝceece ŋkǝ epicoŋpipǝ wǝ́ ŋ nǝ pǝ ŋ po toŋ, paa Abǝrahamǝ lǝ wǝmǝkpǝ wǝ́ ŋ nǝ pǝ ŋ po toŋ wǝ. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Wǝ kǝto wǝ ke kpii kǝ ŋ ru na apaanʊpǝ rǝ wǝlǝ ri ŋ wǝlǝ mǝrǝ, kǝ ŋ nya fɛɛ ŋ ri toolutǝmumuŋyǝ we ŋ náa nyɩŋ enyipǝ la tǝlarǝwǝ wǝ́ ŋ née yee Worokoyǝ la kǝnǝnɛkǝ mǝ anʊkɔrǝyǝ koonu kǝkpǝŋkǝ lo oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Duturǝ ɖi kǝ́ ŋwǝŋwǝ ŋ na cʊʊrʊ wǝ́ pǝ le kpii nǝ gbǝǝrǝ pǝ la nyɩŋ we, lóo koru otoŋ epǝ we pǝ le fii rǝ gbǝǝrǝ wǝ.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yesu naanǝ teeri Mose</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Lǝh ǝtǝŋ ekǝrisotǝpǝ, ŋnǝ epǝ we Worokoyǝ ŋ no pwo wǝ, nǝ mǝ yɩrɩ rǝ Yesu. Worokoyǝ le kpii ŋwǝ ŋ pe ri loh toolutǝmumuŋyǝ. Saŋ rǝ ŋwǝ wǝ́ yǝ la lɔ yǝ lo nuŋ wǝ. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Le ri anʊkɔrǝyǝ lo koonu Worokoyǝ we ŋ ne tiini ŋwǝ, mǝŋ kǝ́ Mose ŋ rili anʊkɔrǝyǝ rǝ Worokoyǝ la nyarǝwǝ kpǝlo kɩɩkɩ kǝtǝ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Mǝŋ kǝ́ pǝ lǝ́ǝ kǝ kumarǝtǝyǝ pǝ ŋ teeri wǝkukpǝ ŋkpǝŋkpǝ we, kaa Yesu ŋ na lɔ ǝkǝkǝ ŋpaŋpa ŋ ne teeri Mose wǝǝ. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Duturǝ ɖi wǝku ri ŋ ku we, wǝ lǝǝmǝ wǝla marǝtǝyǝ, paa tu ri ŋ tu la marǝtǝyǝ we, ŋ kaamǝ Worokoyǝ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Rǝ Mose la kǝtakǝ we, rili anʊkɔrǝyǝ rǝ Worokoyǝ la nyarǝwǝ kpǝlo kɩɩkɩ. Ke ri sʊmatǝyǝ kǝ ŋ nya fɛɛ ŋ ri ɖaŋsieyǝ ŋ ru rǝ tuwǝ we Worokoyǝ ŋ kǝ ŋ pǝ ŋ pa tɛŋ wǝ. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Kǝriso ŋwǝ paa we, le ri anʊkɔrǝyǝ mǝŋ Piyǝ ŋ ya ŋ náa yɩrɩ Worokoyǝ la nyarǝwǝ lo yurǝ kǝtǝ. Wǝ́ ŋlǝ le ri na nyarǝwǝ we, mǝŋ yǝ la ta lah kpɛɛtɛɛwǝ mǝ lǝh ǝrǝŋkǝ we yǝ le kpii lǝ nimifiiwǝ le re wǝǝ.<verse eid="HEB 3:6" /></para>
  <para style="s">Worokoyǝ ya láa kpaka etiiwɛɛkǝ mǝ ŋ tǝnǝ alɔnuŋtǝpǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Wǝ kǝto mǝŋ kǝ́ Wɛɛkenikenirǝ la tɛŋ wǝ kǝtǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 3:7">«Mǝŋ nǝ nyo nuŋ Worokoyǝ la kpɛɛwǝ ruŋruŋ we,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />nǝ paa lɛnyɩ yurǝ, mǝŋ kǝ́ eniyǝ nɔ nǝ ǝtǝtǝpǝ pǝ yili pǝ tɛ̀ɛ rǝ ŋwǝ wǝ,</para>
  <para style="q1" vid="HEB 3:8">jirǝ we pǝ tìe ŋwǝ pǝ yɩ̀rɩ rǝ nyɔŋkpaakǝtǝǝwǝ wǝ.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Rǝ fɛɛwǝ we, wǝ́ nǝ ǝtǝtǝpǝ pǝ wù mǝ akpaŋyǝ kǝ pǝ nyɩŋ tuwǝ ŋ́ née yee wǝ,</para>
  <para style="q1" vid="HEB 3:9">mǝŋkǝ́ pǝ nyɩnɩ mǝ anǝnɛyeeyǝ <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />rǝ cɛŋwǝ tǝniǝ lǝ mǝrǝ paape.</para>
  <para style="q1" vid="HEB 3:10">Wǝ kǝto ŋ́ fǝ̀ kpɛɛmʊrʊwǝ mǝ pǝ wǝǝ,</para>
  <para style="q1" vid="HEB 3:10">wǝ́ ŋ́ tìi mǝ wɛ ǝkǝnǝŋ: “Eni ri ŋ ni pǝ lǝ́ǝ fǝ rǝ ŋpǝŋpǝ pǝla cawǝ,</para>
  <para style="q1" vid="HEB 3:10">kpiikǝ pǝ lǝ sǝ́ŋ pǝ lǝŋ ci mǝ akʊŋyǝ kǝto”.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Rǝ mǝ kpɛɛmʊrʊwǝ mǝrǝ we, ŋ́ no tu ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 3:11">Pǝle kǝniekǝ kǝ lǝŋ fii etiiwɛɛkǝ we ŋ́ na kpaka ŋ́ nǝ tǝnǝ pǝ pwi!»<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Lǝh ǝtǝŋ, nǝ yee yurǝ! Rɛ rǝ nǝ mǝrǝ ŋ pǝǝ lǝmǝ ziɔŋrɔɔrɔɔrǝ lǝŋ lɔ nuŋ wǝ, kǝ oturu lóo ruu ŋwǝ jɛ rǝ Worokoyǝ we ŋ kpii vɔrʊrǝ lǝ kpǝŋ wǝ. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Paa we, nǝ kpii awɛ la wɛɛlɛŋwǝ ji ri ŋ ji, kǝ́ eniyǝ yǝ nya yǝ kpii rǝ ko. Mǝŋkǝsa we, turɔɔrɔɔwǝ wǝ lǝŋ pǝ tǝǝnǝ rɛ rǝ nǝ mǝrǝ kǝ yǝ we ŋ tǝnǝ ziɔŋrǝ. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Duturǝ ɖi, mǝŋ yǝ la nya yǝ la ta lah kpɛɛtɛɛwǝ we lǝ kǝ lǝǝmǝ rǝ kǝsǝŋkǝ yǝ le re kpoŋkpoŋ ǝrǝ kǝtǝǝlǝkǝ we, o lóo turu yǝ la siɛrɩ yǝ le yee Kǝriso la akɛrɩnǝnɛyeetǝpǝ.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Paa Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 3:15">«Mǝŋ nǝ nyo nuŋ Worokoyǝ la kpɛɛwǝ ruŋruŋ we,</para>
  <para style="q1" vid="HEB 3:15">nǝ paa lɛnyɩ yurǝ, mǝŋ kǝ́ eniyǝ nɔ nǝ ǝtǝtǝpǝ pǝ yili pǝ tɛ̀ɛ rǝ ŋwǝ wǝ.»<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Ǝpǝ rǝ fǝŋ pǝ kaamǝ epǝ we pǝ nunu Worokoyǝ la kpɛɛwǝ wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ ŋwǝ wǝ? Mǝŋkǝ epǝ we kpǝlo kɩɩkɩ Mose ŋ pɔ̀rʊ ŋ rù rǝ Ejipǝte pǝ lǝǝwe? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Ǝpǝ rǝ fǝŋ pǝ kaamǝ epǝ we Worokoyǝ ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋ tɛ̀ɛ rǝ, cɛŋwǝ tǝniǝ milimili wǝ? Mǝŋkǝ epǝ we pǝ yeli turɔɔrɔɔwǝ, wǝ́ pǝ kpǝ̀ǝlǝ rǝ nyɔŋkpaakǝtǝǝwǝ pǝ lǝǝwe? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Wǝ́ ǝpǝ rǝ fǝŋ wǝ́ ŋ tù ŋ tìi ǝkǝnǝŋ «Pǝle kǝniekǝ kǝ lǝŋ fii etiiwɛɛkǝ we ŋ́ na kpaka ŋ́ nǝ tǝnǝ pǝ pwi!» wǝ? Mǝŋkǝ epǝ we pǝ loo co kǝtukoŋkǝ rǝ ŋwǝ pǝ lǝǝwe? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Wǝ́ yǝ la nyɩŋ wǝ sɩsiɛrɩ ǝkǝnǝŋ pǝ loo koru e ke fii kǝtǝǝwǝ we, kpiikǝ pǝ laa lɔ pǝ nuŋ kǝto.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Worokoyǝ lo co lǝ garǝ lǝ tǝnǝ ǝkǝnǝŋ ŋlǝ yǝ leh ke fii ne etiiwɛɛkǝ mǝrǝ. Wǝ́ kacowǝ sa wǝ tǝ wǝ kpii wǝ kpɛlɩ. Kǝto we, kǝ le yee yurǝ kǝ rɛ rǝ nǝ mǝrǝ ŋ paa pa ka nyɩŋ ǝkǝnǝŋ ŋwǝ ŋ na fɔ etiiwɛɛkǝ sa mǝrǝ le efiikǝ. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Duturǝ ɖi yǝ lo nuŋ Dieceeceerǝ sa mǝŋ epǝ we pǝ ke kpii rǝ nyɔŋkpaakǝtǝǝwǝ kǝtǝ. Paape pǝ lǝǝ fǝ dierǝ sa pǝ nunu pǝ yee tǝrɛ. Duturǝ ɖi kǝ́ pǝ nunu rǝ we, pǝ laa lɔ rǝ pǝ nuŋ. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Ŋlǝ epǝ we yǝ la lɔ yǝ lo nuŋ we, yǝ lée fii etiiwɛɛkǝ we mǝrǝ. Etiiwɛɛkǝ sa le dierǝ wǝ́ Worokoyǝ ŋ na tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 4:3">«Rǝ mǝ kpɛɛmʊrʊwǝ mǝrǝ wǝ́ ŋ́ no tu ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 4:3">“Pǝle kǝniekǝ kǝ lǝŋ fii etiiwɛɛkǝ we ŋ́ na kpaka ŋ́ nǝ tǝnǝ pǝ pwi!”»</para>
  <para style="m" vid="HEB 4:3">Worokoyǝ tɛnɩ tuwǝ sa paa màrǝ yeli na kǝnǝnɛkǝ lɛ̀ ǝrǝ kǝ́ ŋ cò ǝrǝkǝ wǝ. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Duturǝ ɖi pǝ la tɛŋ rǝ Wǝŋʊrʊkenikenikpǝ la fɛɛrɛɛwǝ pǝ lo ru rǝ jipǝrɩmatatǝrǝ ǝkǝnǝŋ: «Jipǝrɩmatatǝrǝ we wǝ́ Worokoyǝ ŋ tini ŋ wɛ̀ɛ mǝ na kǝnǝnɛkǝ we kpǝlo kɩɩkɩ ŋ yeli wǝ». <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Wǝ́ rǝ ŋ wǝ fɛɛkǝwǝ sa ke we, Worokoyǝ la tɛŋ ǝkǝnǝŋ: «Pǝle kǝniekǝ kǝ lǝŋ fii etiiwɛɛkǝ we ŋ́ na kpaka ŋ́ nǝ tǝnǝ pǝ pwi». <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Epǝ we pǝ sǝnǝ Dieceeceerǝ we lo onuŋkǝ we, pǝ lee yee pǝ saŋ rǝ rǝ. Tuwǝ kǝto pǝ lee ke fii etiiwɛɛkǝ we mǝrǝ wǝǝ. Paa gʊŋrǝ dǝ gbɛlɩ goonu enyipʊŋpwapǝ kǝ pǝ fii etiiwɛɛkǝ sa mǝrǝ. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Lǝ tǝ lǝ tǝnǝ jipʊŋpwarǝ rɛ ŋ no pwo ǝkǝnǝŋ «Ruŋruŋ». Kǝmaamaa wǝ́ ŋ wɛ̀ɛlɩ ŋ rù rǝ jirǝ sa saŋ rǝ Davidǝ, rǝ dierǝ sa yǝ la tɛŋ yǝ la pa tɛlɩ wǝ. Ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 4:7">«Mǝŋ nǝ nyo nuŋ Worokoyǝ la kpɛɛwǝ ruŋruŋ we,</para>
  <para style="q1" vid="HEB 4:7">nǝ paa lɛnyɩ yurǝ».<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Duturǝ ɖi mǝŋ Yoswa ke re pǝ fii etiiwɛɛkǝ sa mǝrǝ we, rǝ wǝla kǝmaakǝ Worokoyǝ lǝǝ kǝ tǝ ŋ wɛɛlɩ ŋ ru rǝ jipʊŋpwarǝ rɛ. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />We etiiwɛɛpʊŋpwakǝ rɛ kǝ lo tuuru kǝ kpɛlɩ kǝ koonu Worokoyǝ lǝ kǝkpǝŋkǝ. Kǝ lo ru jipǝrɩmatatǝrǝ le etiiwɛɛkǝ we. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Duturǝ ɖi yǝ we ŋ ne fii etiiwɛɛkǝ sa Worokoyǝ ŋ na kpaka ŋ nǝ tǝnǝ mǝrǝ we, yǝ we ya lée tii mǝ ŋ wɛɛ mǝ na anǝnɛyǝ mǝŋ kǝ́ Worokoyǝ ŋ tini ŋ wɛ̀ɛ mǝ na anɛŋyǝ kǝtǝ. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Kǝto we, nǝ pǝ kǝ la fia kǝ le fii etiiwɛɛkǝ sa mǝrǝ, kǝ kǝtukoŋloocokǝ sa wǝrʊʊkpǝ we kǝ poo koonu rɛ la atɔɔkǝ. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Worokoyǝ le dierǝ gbii vɔrʊrǝ wǝ́ lǝǝmǝ okopiyǝ. Lée pie lǝ ŋ teeri tʊkʊ ri ŋ tʊkʊ wǝ lée pie mǝŋ wǝkʊŋ mǝŋ kǝmaa wǝ. Lée fii lǝ ŋ sʊʊ, ǝ lǝ ŋ kǝ sǝpǝ kǝrukǝ mǝ wɛɛrǝ, otoŋyǝ mǝ wǝmɔlɩɩkpǝ. Ŋrǝ láa nyɩŋ nyɩmaasɩyǝ lo otucakpɛɛyǝ mǝ oyupuyǝ lǝ ŋ ci wǝ. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Worokoyǝ lo otuyǝ we ŋ no co kpǝlo kɩɩkɩ la rɛ wǝ laa ŋwaa wǝ kpii ŋwǝ Worokoyǝ. Tu ri ŋ tu wǝ la wala wǝ yaa feŋteŋ rǝ ne enimiyǝ, wǝ́ ŋwǝ wǝ́ loh kpǝlo kɩɩkɩ yǝ leh pe ke yee akʊŋtayǝ lo koonu wǝ.<verse eid="HEB 4:13" /></para>
  <para style="s">Yesu ŋ ri otoolutǝmumuŋpǝ lo mumuŋyǝ wǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Lǝ lǝǝmǝ toolutǝmumuŋyǝ rɛ ŋ lɛnyɩ wǝ. La tɛlɩ lo ko ǝrǝ yulaarǝ mǝrǝ: Ŋwǝ ŋ kaamǝ Yesu, Worokoyǝ le Piyǝ. Kǝto kǝ la ta lɔnuŋrǝ sa la ya yǝ láa pɔrʊ yǝ ŋ tɛŋ le re kpoŋkpoŋ. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Duturǝ ɖi ŋkǝ toolutǝmumuŋyǝ rɛ ŋ nǝŋ koru acʊʊrʊ ŋ kʊla mǝ lǝ rǝ lah wǝfɔkpǝ mǝrǝ wǝ́ lǝ lǝǝmǝ. Paa we, Satana le tie ŋwǝ la yɩrɩ rǝ tu ri ŋ tu mǝrǝ mǝŋ ŋlǝ kǝtǝ, paape lee yee turɔɔrɔɔwǝ rɛ. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Kǝto nǝ pǝ kǝ lo ruu lǝ kǝlǝ mǝ Worokoyǝ we ŋ née yee lɛsiɛrɩwǝ le bilisaarǝ we mǝ kpɛɛtɛɛwǝ. Láa nyɩŋ lǝ tǝlarǝwǝ kǝ ŋ yee lǝ lɛsiɛrɩwǝ. Mǝŋkǝsa we, loh po toŋ lǝ mǝ eniceeceeyǝ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Yǝ we ŋ nya ŋ ri toolutǝmumuŋyǝ we, pǝ la saa ŋwǝ pǝ la pɔrʊ rǝ anyɩmaasɩpǝ mǝrǝ rǝ. Pǝ le tiini ŋwǝ mǝ ŋ yee anǝnɛyǝ mǝ ŋ koonu Worokoyǝ rǝ enyipǝ lo yuwǝ. Láa lɔ otukoonuyǝ mǝ ŋ toolu mǝ ŋ kuŋ Worokoyǝ, wǝ́ ŋ náa lɛ mǝ ŋ lɔ akɛɛpǝ rǝ enyipǝ mǝ ŋ toolu koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Toolutǝmumuŋyǝ sa lóo koru onuŋ epǝ we pǝ lee ci tǝrɛ mǝ epǝ we pǝ lǝ́ǝ tǝǝlǝ pǝ ŋ yee turɔɔrɔɔwǝ lo duturǝ. Kpiikǝ ŋwǝ ŋkpɛ lǝǝmǝ wǝfɔkpǝ rǝ kǝta ri ŋ kǝta. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Wǝ́ kpiikǝ ŋwǝ ŋkpɛ ŋ ri fɔlɔfɔtǝyǝ kǝto we, lóo toolu mǝ ŋ koonu ŋwǝŋwǝ no oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ kpɛŋ, ŋ ci otoolu ŋ koonu kǝkpǝŋkǝ lo oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Rɛ lee kpii ŋ náa ca turuwǝ ŋ fǝ ŋwǝŋwǝ na wɛ ŋ yee toolutǝmumuŋyǝ. Worokoyǝ ŋ nóo pwo nyiyǝ, ŋ fǝ ŋwǝ ŋ yee toolutǝmumuŋyǝ, mǝŋ kǝ́ ŋ pwò Arɔŋ kǝtǝ.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Kǝ́ wǝ lǝ Kǝriso ŋwǝ ŋkpɛ wǝǝ. Ŋwǝŋwǝ laa ca turuwǝ ŋ rɛɛrɩ mǝ na wɛ ŋ yee toolutǝmumuŋyǝ. Lɔ̀ wǝ ru rǝ Worokoyǝ. Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 5:5">«Ŋlǝ́ e ri mǝ Piyǝ,</para>
  <para style="q1" vid="HEB 5:5">ŋmǝ ŋ́ nǝ mǝ lǝ́ ruŋruŋ».<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Wǝ́ ŋ na lɛ ŋ na tɛŋ rǝ fɛɛwǝ rɛ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 5:6">«E ri toolutǝyǝ kǝkpakǝkpa,</para>
  <para style="q1" vid="HEB 5:6">mǝŋ wǝlǝkpǝ we Mɛlǝkisedɛkǝ ŋ ke ri toolutǝyǝ ŋ fǝ̀ kǝtǝ».<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Rǝ na vɔrʊrǝ le eciyǝ rǝ kǝtǝǝwǝ sa we, Yesu mwɛnɩ nyuŋkpǝ, kpìi atɔɔkpɛɛyǝ wǝ́ ŋ cà anarǝyǝ mǝ enimiyǝ ŋ pwò Worokoyǝ we ŋ nóo koru apɔrʊ ŋwǝ ŋ ru rǝ gbɛŋrǝ wǝ. Wǝ́ Worokoyǝ ŋ nunu na kpɛɛwǝ rǝ na wɛɛpɛɛlɩwǝ kǝto. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Mǝŋkǝ́ ŋ ke ri Worokoyǝ le Piyǝ paape, kàrǝ kǝ́ pǝ lóo co kǝtukoŋkǝ saŋ rǝ na acʊcʊʊrʊyǝ kpǝlo kɩɩkɩ mǝrǝ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Worokoyǝ lo koonu wǝ́ ŋ no to milimili. La siɛrɩ le yee nyiyǝ we lǝ kpǝŋ alɔkuŋlaalɛɛkǝ kǝ lóo ru kǝ ŋ koonu epǝ we kpǝlo kɩɩkɩ pǝ lóo co kǝtukoŋkǝ rǝ ŋwǝ wǝ. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Duturǝ ɖi Worokoyǝ le tiini ŋwǝ toolutǝmumuŋyǝ mǝŋ wǝlǝkpǝ we ŋ tìini Mɛlǝkisedɛkǝ ŋ fǝ̀ kǝtǝ.<verse eid="HEB 5:10" /></para>
  <para style="s">Wǝ loo poŋ kǝ rɛ ŋ nyarǝ lɔnuŋrǝ ŋ co</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Otuyǝ kǝkpǝŋkǝ yǝ kpii lǝ yǝ láa tɛŋ lo ru rǝ dierǝ sa oŋuŋkǝ, paape yǝ lɛnyɩ dutupɔrʊrǝ. Kpiikǝ nǝ nyǝǝ tǝ nǝ ya nǝ nyǝ́ǝ fǝǝlǝ onuŋ otuyǝ lo duturǝ. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Wǝ la lɔ eniyǝ ŋpa kaa kǝ oturu nǝ nyée ri otukaŋtǝpǝ kaŋfɩ! Paape wǝ lǝ pǝ́ pǝ tǝ pǝ kaŋ nǝ Worokoyǝ le etieyǝ lo otusǝsǝŋsǝsǝŋyǝ we. Kaa kǝ nǝ pǝ́ keeriwǝ wǝ tǝnǝ we, nǝ tǝ nǝ ya nǝ nyǝ́ǝ pǝ́ rǝ akɔɔrʊnyɩŋpǝ. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Nyiyǝ we ŋ tǝ ŋ ya ŋ nǝ́ǝ pǝ́ pǝ ŋ kaŋ ŋwǝ Worokoyǝ le etieyǝ lo otusǝsǝŋyǝ rǝ we, lo ru laatiepirǝ we lǝ́ǝ pǝ́ rǝ akɔɔrʊnyɩŋpǝ wǝ. Wǝ́ yǝ we lee ci tǝrɛ ŋ ru rǝ tuwǝ wǝ kʊʊ wǝ. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Paa ǝpǝ pǝ le yee omumuŋpǝ pǝ lée ri keeritǝnǝwǝ wǝ. Ŋpǝ paa we, pǝ lóo koru opu yurǝ kǝ pǝ kpii wǝsǝpǝkpǝ rǝ tuceeceewǝ mǝ turɔɔrɔɔwǝ mǝrǝ.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Kǝto we, rɛ ŋ pǝǝ tǝ ŋ pǝlǝ eniyǝ ŋ koonu otusǝsǝŋyǝ we pǝ la kaŋ lǝ pǝ lo ru rǝ Kǝriso. Nǝ pǝ kǝ la siɛrɩ lo ko rǝ otukaŋyǝ we yǝ kaamǝ yǝ koonu omumuŋpǝ lǝ kpǝŋ. Yǝ lǝŋ tǝ lǝ kpǝlǝŋ lǝ pǝ otuyǝ we yǝ ri otukaŋyǝ sa la kǝtɛɛkǝ lo oŋuŋkǝ. Le reemǝ kǝ́ nyiyǝ ŋ náa wɛɛ mǝ otuyǝ we yǝ lóo ko mǝ ŋwǝ rǝ gbɛŋrǝ le eyeekǝ, mǝ kǝ́ nyiyǝ ŋ náa lɔ Worokoyǝ ŋ nuŋ wǝ, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />otukaŋyǝ ru rǝ ewiikǝ lo wǝsuŋkpǝ mǝ akaatɛɛkǝ rǝ nyiyǝ, enyiǝtǝpǝ la asaanǝkǝ mǝ wǝkpaŋtɛŋtuturukpǝ. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Mǝŋ Worokoyǝ la tɛɛnɩ we, yǝ lah mǝ kaŋ rǝ otuyǝ we yǝ kaamǝ yǝ koonu omumuŋpǝ wǝ.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Paa epǝ we Worokoyǝ la wǝnyɩɩnɩkpǝ wǝ la nyɩnɩ wǝ la nyɩŋ, wǝ́ pǝ la ra yulaarǝ lo tukoonuwǝ pǝ la nyɩŋ, wǝ́ pǝ la lɔ Wɛɛkenikenirǝ pǝ la nyɩŋ, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />wǝ́ pǝ la nyɩŋ Worokoyǝ le diepoŋrǝ we la wǝraŋkpǝ pǝ la nyɩŋ, wǝ́ pǝ la lɔ ǝrǝkǝ we kǝ kpii kǝ lǝ́ǝ pǝ lo okopiyǝ pǝ la nyɩŋ, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />wǝ́ paa pǝ la siɛnɩ pǝ la ka tɔɔ rǝ pǝla vɔrʊkuukuurǝ we mǝrǝ we, pǝ lǝŋ tǝ pǝ koru ǝpǝ mǝ enyipǝ sa pǝ pa siɛrɩ vɔrʊrǝ kǝyitǝkǝ. Duturǝ ɖi pǝ lǝ tǝ pǝ lǝ kpǝlǝŋ pǝ ya pǝ láa kpaa Worokoyǝ le Piyǝ pǝ ŋ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ koonu pǝla wɛ, wǝ́ pǝ lǝ fǝ ŋwǝ pǝ la fɛlɩ pǝ lo koonu afǝfɛɛpiyǝ.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Vǝ́ ŋʊŋtɛyǝ ya lǝ́ǝ pǝ mǝ ŋ kpii atɛɛkǝ rɛ rǝ eni rǝ eni, wǝ́ atɛɛtɛɛtuyǝ yǝ le wii wǝ́ yǝ lo poŋ yǝ lo koonu atɛɛlǝtǝpǝ we we, oturu Worokoyǝ la pɛɛrɩ atɛɛkǝ sa wǝǝ. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Paa mǝŋ kǝ le wii kɛɛfʊrɛyǝ mǝ kpaŋkpaŋkororoyǝ we, atɛɛkǝ sa kǝ lǝǝ lǝmǝ vasʊyǝ rɛ, kǝ lǝǝ lǝǝrǝ mǝ afwɛɛrɩkǝ, o po turu pǝ lo tu kǝ la naawǝ.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, le ke ce la mǝ wɛɛlɩ ǝnǝ we, le cii wǝ sɩsiɛrɩ ǝkǝnǝŋ nǝ kpii rǝ caceeceewǝ, alɔkuŋkǝ la nɛŋwǝ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Duturǝ ɖi Worokoyǝ lee ri nyilaakʊʊyǝ! Lǝŋ koru oyuu nǝ kǝnǝnɛkǝ la kpɛɛ, amaa kǝǝtaawǝ we nǝ lǝǝmǝ nǝ koonu ŋwǝ, ǝkǝ nǝ nya pɔrʊ wǝ nǝ nya kaŋ saŋ rǝ kǝnǝnɛkǝ we nǝ nye yee nǝ nyo koonu ekǝrisotǝpǝ nǝ nya pa tɛlɩ wǝ́ nǝ tǝ nǝ re nǝ nyée yee kǝ nyǝ ŋ koonu pǝ rǝkǝsa wǝ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Paa la ya yǝ lǝ́ǝ pǝ́ kǝ nyi ri ŋ nyi rǝ nǝ mǝrǝ mǝ ŋ kpii wɛɛlɛŋwǝ sa ǝnǝ ko ro ǝrǝ alɛɛkǝ, kǝ tuwǝ we nǝ ya nǝ nyǝ́ǝ rǝŋ we, wǝ nya fɛɛ wǝ pǝ wǝ ko to rǝ. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Kǝto nǝ paa tɔɔ fanaciwǝ, paa nǝ karǝ epǝ we pǝ la lɔ pǝ lo nuŋ wǝ́ pǝ la tɔ pǝ la yaa ǝkǝ pǝ la lɔ tuwǝ we Worokoyǝ ŋ no co garǝ wǝ.<verse eid="HEB 6:12" /></para>
  <para style="s">Worokoyǝ la kacowǝ wǝ lǝŋ cɛkɛlɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Kǝ́ Worokoyǝ ŋ cò Abǝrahamǝ la garǝ we, tù ŋwǝŋwǝ na wɛ tìi ŋwǝ, kpiikǝ rɛ lee kpii ŋ ka naanǝ ŋ teeri ŋwǝ Worokoyǝ kaa kǝ ŋ tu yǝ we. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="p" vid="HEB 6:14">«Ŋ́ náa pɛɛrɩ lǝ́ ŋpa taa kǝ ŋ́ koonu lǝ́ wǝmǝkpǝ wǝ yaarǝ». <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Wǝ́ Abǝrahamǝ ŋ tàarǝ lɛrǝ ŋ kǝ ŋ rǝŋ, wǝ́ ŋ lɔ̀ tuwǝ we Worokoyǝ ŋ cò na garǝ wǝ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Vǝ́ nyɩmaasɩyǝ loh tu tuwǝ rɛ we, lóo tu tuwǝ we wǝ naanǝ wǝ teeri ŋwǝ wǝ. Tuwǝ rɛ lo otukǝ we, wǝ láa kaŋ ǝkǝnǝŋ yǝ we le dierǝ ɖi anʊkɔrǝyǝ, kǝ wǝ fǝ wǝ sǝ dierǝ. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Kaa wǝǝ, Worokoyǝ lǝ pǝ́ ǝkǝnǝŋ epǝ we pǝ lah pa lɔ kacowǝ sa we, pǝ nyɩŋ wǝ pǝ ci feŋteŋ pǝ teeri ǝkǝnǝŋ no tutɛŋwǝ wǝ lǝŋ cɛkɛlɛ. Wǝ kǝto ŋ no tu ŋ na kʊla mǝ garǝ we ŋ no co pǝ wǝǝ. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Worokoyǝ le yee tuwǝ yi wǝ lǝŋ cɛkɛlɛ. Tuwǝ sa yiwǝ wǝ lǝŋ cɛkɛlɛ we, wǝ kaamǝ garǝ we ŋ no co mǝ tuwǝ we ŋ no tu wǝ. Worokoyǝ lǝŋ koru ania rǝ tuwǝ sa yiwǝ lǝ mǝrǝ. Wǝ kǝto ŋlǝ epǝ we yǝ lo suu yǝ la ŋʊrʊ rǝ ŋwǝ we, yǝ la nya turutawǝ ŋpa wǝǝ, kǝ la nya fɛɛ la ta ǝrǝŋkǝ sa pǝ lo koonu lǝ le re kpoŋkpoŋ. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Ǝrǝŋkǝ sa kǝ la tɔ lah vɔrʊrǝ kǝ la yaalǝ kiŋkiŋ, wǝ́ kǝ lée fii nyaŋrǝ we pǝ lǝ sǝŋ rǝ Worokoyǝ lo wǝkukpǝ rǝ yulaarǝ lǝ mǝrǝ kǝ ŋ tɛlɩ kǝ ŋ ko ǝrǝ fɛɛkenikeniwǝ le kenikeniwǝ. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Fɛɛwǝ we wǝ́ Yesu ŋ ne fii ŋ no koonu lǝ mǝŋ coŋtǝyǝ kǝtǝ wǝ, duturǝ ɖi la siɛrɩ le yee toolutǝmumuŋyǝ kǝkpakǝkpa mǝŋ Mɛlǝkisedɛkǝ kǝtǝ.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Mɛlǝkisedɛkǝ ri piliyǝ wǝ́ ŋ lɛ ŋ ri toolutǝyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mɛlǝkisedɛkǝyǝ sa ke ri tǝŋtǝǝwǝ we pǝ lóo pwo Salɛmǝ le piliyǝ wǝ́ ŋ ka lɛ̀ ŋ ri toolutǝyǝ ŋ kòonu Worokoyǝ ŋ tɛɛ rǝ Oŋuŋkǝ wǝ. Mɛlǝkisedɛkǝ ŋ rù ŋ kolu ŋ kù mǝ Abǝrahamǝ, kǝ́ ŋwǝ Abǝrahamǝ ŋ kolu ŋ yeli akɔŋkǝ ŋ rili epilipǝ lo yurǝ ŋ lɛ̀ wǝ́ ŋ kpìi ŋ kpǝ̀lǝŋ ŋ kǝ ŋ pǝ wǝ. Wǝ́ Mɛlǝkisedɛkǝ ŋ pɛ̀ɛrɩ ŋwǝ. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Ŋwǝ wǝ́ Abǝrahamǝ ŋ fǝ̀ tu ri ŋ tu ŋ rè ŋ rù rǝ akɔŋkǝ we ŋ pǝlǝ lǝ tǝtǝwǝ ŋ kòonu wǝ. Tusǝsǝŋwǝ, Mɛlǝkisedɛkǝ la nyɩŋrǝ sa lo duturǝ ɖi «Wǝkʊʊkpǝ le piliyǝ». Tǝ fǝ kʊla we, lɛ ri Salɛmǝ le piliyǝ wǝlo duturǝ ɖi «Wǝtaarǝkpǝ le piliyǝ». <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Lǝǝ lǝmǝ tǝyǝ, lǝǝ lǝmǝ leeyǝ, lǝǝ lǝmǝ ǝtǝtǝpǝ rɛ. Pǝ lee ci tǝrɛ pǝ ru rǝ nǝ ǝmǝkǝ amaa nǝ ǝkpǝ́kǝ. Lǝ rǝ mǝŋ Worokoyǝ le Piyǝ kǝtǝ. Ri rǝ toolutǝyǝ kǝkpakǝkpa.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Nǝ yɩrɩ kǝ́ nyiyǝ sa ŋ no ru okuruyǝ re! Lǝh tǝtǝ Abǝrahamǝ fee rǝ, ŋ fǝ̀ otuyǝ we ŋ fàa rǝ akɔŋkǝ sa lǝ tǝtǝwǝ ŋ kòonu ŋwǝ! <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Paa epǝ we pǝ ri Levi lǝ wǝmǝkpǝ ǝkǝ pǝ ri otoolutǝpǝ we, Mose le seyǝ lǝ pǝ́ lo ru rǝ pǝ, pǝ lɔ tǝtǝwǝ rǝ Isǝrayɛlǝ lǝ kǝkpǝŋkǝ ŋ́ reemǝ pǝla apaanʊpǝ, mǝŋkǝ́ ŋpǝ ŋkpɛ pǝ ri Abǝrahamǝ lǝ wǝmǝkpǝ paape. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Mɛlǝkisedɛkǝ ŋwǝ paa lee ke ri Levi lǝ wǝmǝkpǝ, paape lɔ̀ tǝtǝwǝ rǝ Abǝrahamǝ. Tǝ fǝ kʊla we, ŋwǝ ŋ pɛ̀ɛrɩ nyiyǝ sa ŋ lɔ̀ Worokoyǝ la akacoyǝ wǝ. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Wǝ́ nyi ri ŋ nyi cii wǝ ǝkǝnǝŋ mumuŋyǝ ŋ náa pɛɛrɩ pipiyǝ wǝ. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Rǝ otoolutǝpǝ la kǝtakǝ we, epǝ we pǝ láa lɔ tǝtǝwǝ we, anyɩmaasɩpǝ pǝ lǝ́ǝ kpǝ́ wǝ́ pǝ ri. Paa rǝ Mɛlǝkisedɛkǝ la kǝtakǝ we, Wǝŋʊrʊkenikenikpǝ wǝ le ri ɖaŋsieyǝ ǝkǝnǝŋ kpii vɔrʊrǝ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Rǝ kǝtǝǝlǝkǝ we, yǝ lóo koru atɛŋ wǝ ǝkǝnǝŋ saŋ rǝ Abǝrahamǝ lo oŋuŋkǝ wǝ́ Levi lǝ wǝmǝkpǝ wǝ láa lɔ tǝtǝwǝ. Ŋpǝ ŋkpɛ pǝ lo koonu tǝtǝwǝ. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Duturǝ ɖi eniyǝ we Mɛlǝkisedɛkǝ ŋ kolu ŋ kù mǝ Abǝrahamǝ we, anyɩŋ Levi tǝ kpii rǝ nǝ tǝtǝ Abǝrahamǝ lǝ mǝrǝ pǝ fǝǝ kǝ mǝ ŋwǝ.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Rǝ Mose le seyǝ we pǝ koonu Isǝrayɛlǝ lǝ kǝkpǝŋkǝ we, Levi lǝ wǝmǝkpǝ mǝrǝ wǝ́ pǝ láa pɔrʊ otoolutǝpǝ wǝ. Pǝ lée ri otoolutǝpǝ mǝŋ Arɔŋ kǝtǝ. Paa wǝlǝkpǝ we pǝ láa saŋ pǝ ri otoolutǝpǝ we, wǝ loo to milimili. Mǝŋ ŋkǝ kaa wǝǝ we, wǝ lǝǝ kǝ tǝ wǝ pǝ́ kǝ toolutǝpʊŋpwayǝ rɛ mǝŋ Mɛlǝkisedɛkǝ kǝtǝ ŋ pǝ! <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Duturǝ ɖi vǝ́ wǝlǝkpǝ we pǝ láa saŋ pǝ ri otoolutǝpǝ wǝ la cɛkɛlɛ we, wǝ kpii kǝ seyǝ ŋwǝ ŋkpɛ ŋ cɛkɛlɛ taa. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Wǝ́ yǝ we lo oŋuŋkǝ pǝ la wɛɛlɩ etieyǝ sa pǝ lo ru rǝ we, ŋwǝ ŋ kaamǝ loh Kulǝtǝyǝ, lo ru rǝ gbǝŋpʊŋpwarǝ rɛ. Wǝ́ gbǝŋrǝ sa le nyiyǝ rɛ fee yee toolutǝyǝ la kǝnǝnɛkǝ rǝ otoolucuukǝ ŋ nyɩŋ pwi. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Nyi ri ŋ nyi cii wǝ sɩsiɛrɩ ǝkǝnǝŋ loh Kulǝtǝyǝ lo ru rǝ Yuda lǝ gbǝŋrǝ. Wǝ́ Mose laa tɛŋ tǝrɛ ŋ ru rǝ gbǝŋrǝ sa, kǝ́ ŋ wɛ̀ɛlɩ ŋ ru rǝ otoolutǝpǝ wǝ.<verse eid="HEB 7:14" /></para>
  <para style="s">Toolutǝpʊŋpwayǝ rɛ ŋ no ru Mɛlǝkisedɛkǝ wǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Tuwǝ sa wǝ lǝ tǝ wǝ lo koonu otuyǝ sa kpǝlo yǝ la nyɩnɩ feŋteŋ yǝ le teeri, mǝ kǝ́ toolutǝpʊŋpwayǝ ŋ no ru Mɛlǝkisedɛkǝ ŋ na nyaa ŋ no ru wǝ. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Lee pe ri toolutǝyǝ saŋ rǝ seyǝ we ŋ náa yɩrɩ gbǝŋrǝ rǝ fǝŋ wǝ́ yǝ we ŋ no ru wǝ, paa le ri toolutǝyǝ saŋ rǝ vɔrʊrǝ we tǝrɛ wǝ lǝŋ koru ǝnǝǝnǝ lo okopiyǝ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ le ri ɖaŋsieyǝ wǝ lo koonu ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 7:17">«E ri toolutǝyǝ kǝkpakǝkpa</para>
  <para style="q1" vid="HEB 7:17">mǝŋ wǝlǝkpǝ we Mɛlǝkisedɛkǝ ŋ ke ri toolutǝyǝ ŋ fǝ̀ kǝtǝ».<verse eid="HEB 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 7:18" />Rǝ kǝtarɛɛkǝ we, pǝ la pɔrʊ sekuukuuyǝ we pǝ la cɛ kpiikǝ lǝǝ kǝ lǝmǝ okopiyǝ wǝ́ ŋ nǝǝ kǝ lǝmǝ vasʊyǝ rɛ. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Kǝceece Mose le Seyǝ we, lee yee tǝrɛ kǝ oturu wǝ lo to milimili. Rǝ kǝtapʊŋpwakǝ we, Worokoyǝ lo koonu lǝ ǝrǝŋkǝ rɛ kǝ ponu kǝ teeri wǝ. Wǝ́ saŋ rǝ ŋkǝ ǝrǝŋkǝ sa we, la ya yǝ lóo ruu yǝ ŋ kǝlǝ mǝ ŋwǝ Worokoyǝ.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Tǝ fǝ kʊla we, Worokoyǝ tù ǝkǝnǝŋ ŋ ne tiini Yesu toolutǝyǝ. Paa otoolutǝtuturupǝ we pǝ tìini we, Worokoyǝ loo tu tǝrɛ. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Paa Yesu la nɛŋwǝ we, Worokoyǝ tù tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 7:21">«Ŋmǝ Ǝtǝ Woroko ŋ́ no tu,</para>
  <para style="q1" vid="HEB 7:21">wǝ́ ŋ́ nǝŋ pa siɛrɩ rǝ mǝ dierǝ, ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 7:21">“E ri toolutǝyǝ kǝkpakǝkpa”».<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Mǝŋkǝsa we, yǝ la nya dieparǝtǝnǝrǝ rɛ bonu deeri wǝ, wǝ́ Yesu ŋ ri yǝ we ŋ na yaa rǝla kǝmaakǝ ŋ no koonu lǝ wǝ.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Tǝ fǝ kʊla we, eniyǝ nɔ lo otoolutǝpǝ pǝ ka naanǝ kpǝŋwǝ kpiikǝ gbɛŋrǝ laa ka ŋ maa pǝ pǝ tii pǝ ŋ yee pǝla kǝnǝnɛkǝ kǝkpakǝkpa. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Yesu ŋwǝ paa we, kpii vɔrʊrǝ kǝkpakǝkpa. Wǝ́ no otoolukǝ la kǝnǝnɛkǝ sa kǝ lǝŋ pa lɛ pwi! <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Tuwǝ kǝto ŋ nóo koru alɔ ŋ koonu enyipǝ we pǝ lóo ruu pǝ ŋ kǝlǝ mǝ Worokoyǝ saŋ rǝ no oŋuŋkǝ kǝkpakǝkpa wǝǝ. Duturǝ ɖi ŋwǝ Yesu kpii vɔrʊrǝ kǝkpakǝkpa kǝ mǝ ŋ mwɛŋ nyuŋkpǝ mǝ ŋ koonu pǝ rǝ Worokoyǝ lǝ kpǝŋ. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Yesu ŋ ri toolutǝmumuŋyǝ we ŋ kaamǝ lǝ wǝ. Lǝ kenikeni, lǝǝ lǝmǝ bɔtɔɔrǝ rɛ, lǝǝ lǝmǝ arɛɛyǝ rɛ, la waarǝ mǝ oturɔɔrɔɔyeetǝpǝ, wǝ́ Worokoyǝ ŋ na rɛɛrɩ mǝ ŋwǝ rǝ oŋuŋ rǝ oŋuŋ rǝ yulaarǝ. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Lǝǝ lǝ rǝ mǝŋ otoolutǝmumuŋtuturupǝ we kǝtǝ. Wǝ lǝǝ pǝ́ kǝ mǝŋ yee otoolukǝ ji ri ŋ ji koonu ŋwǝŋwǝ no oturɔɔrɔɔyǝ kpɛŋ, kǝ ŋ ci o toolu ŋ koonu kǝkpǝŋkǝ la anɛŋyǝ. Le yee otoolukǝ sa kǝceŋceŋ ko, wǝ la lɛ kǝkpakǝkpa, mǝ eniyǝ we ŋ fǝ ŋwǝŋwǝ na wɛ ŋ yeli otoolukǝ wǝ. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Mose le seyǝ lo otoolutǝmumuŋpǝ we ŋ née tiini we, pǝ ri rǝ anyɩmaasɩpǝ pǝ lǝǝmǝ wǝfɔkpǝ. Paa Worokoyǝ lo otukǝ we ŋ tù ŋ tǝ̀nǝ rǝ Mose le seyǝ sa la kǝmaakǝ we, lǝ fǝ ne Piyǝ le tiini toolutǝmumuŋyǝ, ŋwǝ yǝ we ŋ no to milimili kǝkpakǝkpa wǝ.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yesu, loh toolutǝmumuŋyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ teeri rǝ dierǝ sa yǝ lǝ́ǝ pǝ́ la tɛŋ wǝ kaamǝ wǝ ǝnǝ: Toolutǝmumuŋyǝ sa wǝrʊʊkpǝ kǝceece wǝ́ lǝ lǝǝmǝ wǝ, ŋwǝ yǝ we ŋ na sɔ ŋ ne tii rǝ Worokomumuŋmumuŋyǝ le bilisaarǝ we le kǝnirisiɛɛkǝ rǝ yulaarǝ wǝ. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Ya lée yee na anǝnɛyǝ rǝ fɛɛkenikeniwǝ, ŋ́ reemǝ bwiipoŋpirǝ we Ǝtǝ Woroko ŋ na tɔ wǝ, ŋkǝ nyɩmaasɩyǝ ŋ na tɔ rǝ.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Yǝ we ŋ nya ŋ ri toolutǝmumuŋyǝ rǝ we, pǝ le tiini ŋwǝ mǝ ŋ lɔ enyipǝ lo otukoonuyǝ mǝ pǝla akɛɛpǝ mǝ ŋ yee otoolukǝ mǝ ŋ koonu Worokoyǝ rǝ. Kǝto wǝ kpii kǝ Yesu, yǝ we ŋ ri lah nɛŋ toolutǝmumuŋyǝ we, ŋwǝ ŋkpɛ ŋ nya tuwǝ rɛ ŋ fǝ ŋ yee otoolukǝ. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Mǝŋ Kǝriso keh kpii rǝ kǝtǝǝwǝ sa we, lǝŋ ke ce ŋ ri toolutǝyǝ ǝkǝŋtǝ kpiikǝ otoolutǝpǝ pǝ marǝ pǝ kpii rǝ kǝtǝǝwǝ sa pǝ lée yee otoolukǝ saŋ rǝ Mose le seyǝ. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Kǝnǝnɛkǝ we ŋpǝ otoolutǝpǝ sa pǝ ya pǝ lée yee pǝ ŋ koonu Worokoyǝ we, kǝ ri rǝ cɛrɛcɛrɛyǝ mǝ sisiwǝ kǝ koonu tupoŋpiwǝ we wǝ kpii rǝ yulaarǝ wǝ. Kǝ́ Mose ŋ kǝ ŋ pǝ́ ŋ tɔ Worokoyǝ le bwiirǝ we, Worokoyǝ tɛnɩ tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="p" vid="HEB 8:5">«Yɩrɩ re, yee tu ri ŋ tu kǝ wǝ kaa mǝ wǝlǝkpǝ we ŋ́ kanǝ lǝ́ rǝ dutupirǝ we lo oŋuŋkǝ wǝ».<verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />Paa rǝkǝsa we, Yesu la lɔ kǝnǝnɛkǝ rɛ kǝ teeri otoolutǝtuturupǝ we la kǝnɛŋkǝ. Kpiikǝ ri rǝ tatǝyǝ koonu dieparǝtǝnǝrǝ rɛ bonu deeri, pǝ lo co kǝtɛɛkǝ pǝ la tɛɛ rǝ akacoyǝ we yǝ ponu yǝ teeri wǝ. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Mǝŋ kǝceece Dieparǝtǝnǝkuukuurǝ we lǝǝ kǝ lǝmǝ wǝfɔkpǝ rɛ we, wǝ lǝŋ kǝ lǝ kpuŋkpuruŋ kǝ pǝ cɛkɛlɛ rǝ mǝ yitǝrǝ rɛ. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Paa kǝceece Worokoyǝ kpanǝ mǝ nǝ kǝkpǝŋkǝ rǝ kǝ́ ŋ tìi pǝ ǝkǝnǝŋ, Ǝtǝ Woroko la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 8:8">«Eciyǝ yǝ kpii yǝ lǝ́ǝ pǝ,</para>
  <para style="q1" vid="HEB 8:8">ŋ́ nah pa parǝ dieŋwɛŋrǝ</para>
  <para style="q1" vid="HEB 8:8">mǝ Isǝrayɛlǝ lǝ kǝkpǝŋkǝ fǝ kʊla mǝ Yuda lǝ kǝkpǝŋkǝ ŋ́ tǝnǝ.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Dieparǝtǝnǝŋwɛŋrǝ sa lǝŋ tǝ bǝ lǝ mǝŋ ɖǝ we ŋ́ pàrǝ ŋ́ tǝ̀nǝ mǝ pǝlǝ ǝtǝtǝpǝ</para>
  <para style="q1" vid="HEB 8:9">jirǝ we ŋ́ tà pǝ mǝ akaa mǝ akaa ŋ́ pɔ̀rʊ ŋ́ rù rǝ Ejipǝte wǝ.</para>
  <para style="q1" vid="HEB 8:9">Pǝ lee yee pǝ saŋ rǝ Dieparǝtǝnǝkuukuurǝ we,</para>
  <para style="q1" vid="HEB 8:9">Fɛɛwǝ ŋmǝ ŋkpɛ ŋ́ nǝǝ tǝ ŋ́ co oku rǝ pǝ wǝǝ!<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Ǝtǝ Woroko lǝ tǝ la tɛŋ ǝkǝnǝŋ, dierǝ we ŋ́ nah parǝ mǝ Isǝrayɛlǝ lǝ kǝkpǝŋkǝ ŋ́ tǝnǝ gaamǝ ɖǝ ǝnǝ,</para>
  <para style="q1" vid="HEB 8:10">rǝ eciyǝ sa la kǝmaakǝ we,</para>
  <para style="q1" vid="HEB 8:10">ŋ́ nǝh pǝ fǝ mǝ esepǝ ŋ́ kpii pǝ rǝ pǝlo yupurǝ,</para>
  <para style="q1" vid="HEB 8:10">kǝ ŋ́ ŋʊrʊ pǝ ŋ tɛɛ rǝ pǝla asiɔŋyǝ,</para>
  <para style="q1" vid="HEB 8:10">ŋ́ née ri pǝlo Worokoyǝ, kǝ pǝ ri mǝ kǝkpǝŋkǝ!<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Rɛ lǝŋ tǝ ŋ pa kaŋ na kɛrɩyǝ amaa na paanʊyǝ lo otuyǝ kǝ mǝ ŋ tíi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 8:11">“Ci Ǝtǝ Woroko”!</para>
  <para style="q1" vid="HEB 8:11">Duturǝ ɖi pǝlo kpǝlo kɩɩkɩ pǝ lée ci mǝ, fǝ ǝrǝ pipipipiyǝ po ru ǝrǝ mumuŋmumuŋyǝ.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Kpiikǝ ŋ́ nǝ́ǝ fǝ pǝlo oturɔɔrɔɔyǝ ŋ́ cɛɛ pǝ, ŋ́ nǝŋ tǝ ŋ́ pa taalǝ pǝla wǝfɔkpǝ».<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Kǝ́ Worokoyǝ ŋ ya ŋ náa wɛɛlɩ mǝ ŋ ru rǝ Dieparǝtǝnǝŋwɛŋrǝ we, we lǝ fǝ zǝsǝŋrǝ we le yee guukuurǝ. Wǝ́ tuwǝ wǝ lo kuukuu wǝ́ wǝ lo kuru we, wǝ lǝŋ tǝ wǝ panǝ oturu wǝ lǝ nǝŋ. <figure style="fig" alt="Le grand sacrificateur" file="hk00267c.tif" size="col" copy="Horace Knowles" ref="8:3">Toolutǝmumuŋyǝ</figure><verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Dieparǝtǝnǝkuukuurǝ we mǝ Dieparǝtǝnǝŋwɛŋrǝ we</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Dieparǝtǝnǝkuukuurǝ we gǝ lǝǝmǝ rǝle esepǝ koonu zʊmarǝ, wǝ́ ga lɛ lǝǝmǝ fɛɛwǝ pǝ láa sʊma Worokoyǝ rǝ kǝtǝǝwǝ sa wǝ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Pǝ tɔ̀ Worokoyǝ le bwiirǝ, wǝ́ pǝ sǝ̀pǝ rǝ fɛɛwǝ yi. Pǝ ko ŋ pwo fɛɛsǝsǝŋwǝ we ǝkǝnǝŋ fɛɛkenikeniwǝ. Rǝ fɛɛwǝ sa we, kaŋreciiwǝ wǝ ka kpɛlɩ, kpǝlɔyǝ ka kpɛlɩ, wǝ́ akpɔnɔpǝ we pǝ lo koonu Worokoyǝ pǝ ka tɛɛ rǝ ŋwǝ kpǝlɔyǝ sa. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Fɛɛyitǝwǝ we wǝ́ pǝ lóo pwo fɛɛkenikeniwǝ le kenikeniwǝ. Pǝ lǝ fǝ nyaŋyitǝrǝ rɛ pǝ lǝ sǝpǝ ŋ wǝ fɛɛwǝ sa mǝ fɛɛkenikeniwǝ we. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Rǝ fɛɛyitǝwǝ sa we, asɩkatoolucuukǝ we pǝ ko ŋ tu alifuyǝ la naawǝ kǝ ka kpɛlɩ, dieparǝtǝnǝrǝ we la arakayǝ pǝ nunu sɩkayǝ kpǝlo kɩɩkɩ we, yǝ ka kpɛlɩ. Zɩkakpɛɛrǝ rɛ ge kpii mǝ manayǝ, Arɔŋ le ciisaŋwǝ we wǝ tàrǝ wǝ, fǝ kʊla mǝ oruyǝ we pǝ ŋʊ̀rʊ dieparǝtǝnǝrǝ sa le etieyǝ pǝ tɛ̀ɛ we, yǝ ke kpii rǝ arakayǝ sa mǝrǝ. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Pǝ fǝ̀ sɩkayǝ pǝ màrǝ Ekerubipǝ pǝ tɛ̀ɛ rǝ arakayǝ sa. Ŋpǝ Ekerubipǝ sa pǝ ke ri barǝ ǝkǝnǝŋ Worokoyǝ kpii rǝ fɛɛwǝ sa. Pǝla wǝkʊŋkpǝ le sisiwǝ wǝ sìi fɛɛwǝ we pǝ láa wɛrɛ ŋpǝrayǝ koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ wǝ. Paa ŋkǝ eniyǝ yǝ láa wala otuyǝ le fii mǝrǝ wǝǝ.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Kǝ́ pǝ tǝ̀nǝ otuyǝ sa pǝ fǝ̀ wǝǝ. Eni ri ŋ ni, otoolutǝpǝ pǝ ke ŋ fii fɛɛsǝsǝŋwǝ we pǝ ŋ ko pǝ ŋ yee pǝla kǝnǝnɛkǝ. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Paa fɛɛyitǝwǝ we we, toolutǝmumuŋyǝ ŋwǝ ceŋceŋ ko ŋ née fii wǝ kǝceŋceŋ rǝ cɛŋwǝ. Lee kpii ŋ née fii fɛɛwǝ we kǝ oturu lee re akɛɛpǝ we pǝ lo toolu la ŋpǝrayǝ ŋ ko koonu Worokoyǝ rǝ ŋwǝŋwǝ mǝ kǝkpǝŋkǝ la wǝfɔkpǝ lo yurǝ. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Wɛɛkenikenirǝ lǝ pǝ́ bɔrʊ gaŋ ǝkǝnǝŋ eniyǝ we bwiirǝ sa la fɛɛsǝsǝŋwǝ sa wǝ nya wǝ kpii rǝ ko we, fɛɛkenikeniwǝ le kenikeniwǝ la kʊŋwǝ wǝ faa maa wǝ taanǝ. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Tuwǝ sa wǝ ri rǝ tufǝcamǝwǝ rɛ wǝ koonu ruŋruŋ le jirǝ sa. Wǝ ya wǝ lǝ́ǝ pǝ́ wǝ tɛŋ ǝkǝnǝŋ otukoonuyǝ we mǝ otoolukǝ we pǝ lée yee pǝ ŋ koonu Worokoyǝ we, yǝ lǝŋ koru asiɛ nyiyǝ we ŋ no koonu otuyǝ sa lo oturɔɔrɔɔyǝ yǝ cɛ kǝ ŋ nya fɛɛ ŋ lɛrɩ. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Ŋyǝ otuyǝ sa yǝ ri rǝ anyɩmaasɩpǝ lo kǝsuŋkǝ ru rǝ ekeeriyǝ, tuŋuŋwǝ mǝ ewiikǝ kpookpookpoo. Pǝ kǝ ŋ tǝ pǝ ŋ yee ŋkpǝ wǝsuŋkpǝ sa ko ro eniyǝ we Worokoyǝ ŋ pǝlǝ mǝ otuŋwɛŋyǝ wǝ. <verse eid="HEB 9:10" /><verse number="11" style="v" sid="HEB 9:11" />Paa Kǝriso lǝ pǝ mǝŋ toolutǝmumuŋyǝ ŋ po koonu lǝ otuceeceeyǝ we yǝ marǝ yǝ kpɛlɩ<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Otulǝmǝyǝ we yǝ kpii yǝ lǝ́ǝ pǝ».</char></note> wǝ. Le fii bwiirǝ rɛ naanǝ deeri wǝ́ lo to milimili wǝ. Bwiirǝ sa lee ri bwiirǝ rɛ pǝ la tɔ mǝ anyɩmaasɩpǝ la wǝkaakpǝ, wǝlo duturǝ ɖi bwiirǝ sa laa kʊla mǝ otuyǝ we Worokoyǝ ŋ no co rǝ ǝrǝkǝ sa wǝ. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Kǝriso le fii fɛɛkenikeniwǝ le kenikeniwǝ kǝceŋceŋ ko kǝkpakǝkpa. Lee re bereceekpaturǝ rɛ la ŋpǝrayǝ amaa nɛŋpirǝ rɛ la ŋpǝrayǝ ŋ ko koonu, paa ŋwǝŋwǝ na wɛ la ŋpǝrayǝ wǝ́ ŋ kòonu wǝ́ ŋ na pɔrʊ lǝ ŋ no ru kǝkpakǝkpa. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Wǝ́ mǝŋ epereceekpatuyǝ la ŋpǝrayǝ mǝ anɛŋnuŋyǝ la ŋpǝrayǝ mǝ nɛŋyeeyǝ pǝ lo tu naawǝ la atʊkpɔrɔyǝ pǝ lǝ fǝ pǝ le fieni enyipǝ we pǝ tɛɛ mǝ arɛɛyǝ, yǝ láa lɛrɩ pǝla wɛlɛŋrǝ sa we, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Kǝriso la ŋpǝrayǝ tǝ lǝǝmǝ okopiyǝ ŋpa teeri! Duturǝ ɖi saŋ rǝ Wɛɛlaalɛɛrǝ we, Kǝriso fǝ̀ ŋwǝŋwǝ na wɛ kòonu Worokoyǝ mǝŋ toolutuwǝ rɛ wǝ lǝǝ lǝmǝ bɔtɔɔrǝ rɛ. Kǝto na ŋpǝrayǝ lah pa lɛrɩ lah asiɔŋyǝ ŋ ru rǝ otuyeeyǝ we yǝ lóo ko mǝ nyiyǝ rǝ gbɛŋrǝ wǝ. Mǝŋkǝsa we, kǝ la nya fɛɛ la mǝ sʊma Worokoyǝ we ŋ kpii vɔrʊrǝ wǝ.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Nǝ nyǝŋ nyɩŋ tuwǝ kǝto Kǝriso ŋ ri tatǝyǝ ŋ koonu Dieparǝtǝnǝŋwɛŋrǝ wǝǝ. Na gbɛŋrǝ sa lǝ pǝ kǝ bɔrʊ anyɩmaasɩpǝ ɖu rǝ oturɔɔrɔɔyǝ pǝ yeli mǝ eniyǝ we pǝ ke kpii rǝ Dieparǝtǝnǝkuukuurǝ kǝnǝŋkǝ wǝ. Kǝto epǝ we Worokoyǝ ŋ no pwo we, pǝ lóo koru alɔ otuceeceeyǝ we ŋ no co garǝ ǝkǝ yǝ lǝŋ pa lɛ wǝ. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Duturǝ ɖi vǝ́ pǝ la pɔrʊ ǝtǝtuyǝ la kǝfwɛɛkǝ pǝ lo ru kǝ pǝ sǝpǝ ǝtǝtuyǝ we, wǝ lǝ kpuŋkpuruŋ kǝ pǝ pɔrʊ wǝ pǝ kaŋ ǝkǝnǝŋ yǝ we ŋ na ŋʊrʊ kǝ ŋ nǝ tǝnǝ we, lǝ kpǝ́. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Mǝŋ yǝ we ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ nǝ tǝnǝ kpii vɔrʊrǝ we, kǝfwɛɛkǝ sa kǝ lǝŋ yee kǝnǝnɛkǝ pwi. Yǝ we lǝ́ǝ kpǝ́ kpɛŋ kǝ kǝ ci e yee kǝnǝnɛkǝ. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Wǝ kǝto ŋpǝrayǝ lʊ̀ʊ pe, wǝ́ Dieparǝtǝnǝkuukuurǝ we ǝkǝŋtǝ ji etìe kǝnǝnɛkǝ. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Mose kǝ̀ otutɛŋyǝ we kpǝlo kɩɩkɩ mǝŋ kǝ́ yǝ kpii rǝ Seyǝ mǝrǝ kǝtǝ, rǝ kǝkpǝŋkǝ kpǝlo kɩɩkɩ la kǝnyɩŋkǝ kpɛŋ. Rǝ wǝla kǝmaakǝ we, wǝ́ ŋ fǝ̀ anɛŋpipǝ la ŋpǝrayǝ, epereceekpatuyǝ la ŋpǝrayǝ mǝ mɛŋwǝ ŋ kpìi rǝ yawayǝ ŋ tǝ̀nǝ. Wǝ́ ŋ kǝ ŋ fǝ eweyǝ rɛ pǝ lóo pwo izɔpǝyǝ mǝ mɛɛromwɛɛrɩrǝ mǝ ŋ yɔɔ ŋpǝrayǝ we mǝ ŋ wɛrɛ seyǝ la kǝfwɛɛkǝ we mǝŋ kǝkpǝŋkǝ we kpǝlo kɩɩkɩ. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Dierǝ we Worokoyǝ ŋ na parǝ ŋ nǝ tǝnǝ mǝ nǝ la ŋpǝrayǝ ŋ kaamǝ yǝ ǝnǝ». <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Wǝ́ ŋ lɛ̀ ŋ wɛ̀rɛ bwiirǝ we mǝ wǝsiɛkpǝ we kpǝlo kɩɩkɩ pǝ lǝ́ǝ fǝ pǝ ŋ yee kǝnǝnɛkǝ rǝ zʊmarǝ la ŋpǝrayǝ sa. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Seyǝ la tɛŋ ǝkǝnǝŋ, otupiyǝ rɛ kpekperee ko wǝ́ pǝ lǝŋ koru ǝfǝ ŋpǝrayǝ pǝ lɛrɩ wǝ. Wǝ́ mǝŋ ŋpǝrayǝ laa lʊ we, pǝ lǝŋ fǝ oturɔɔrɔɔyǝ pǝ cɛɛ. <verse eid="HEB 9:22" /><verse number="23" style="v" sid="HEB 9:23" />Wǝ́ mǝŋ wǝ kpii kǝ pǝ lɛrɩ otuyǝ sa yǝ ri rǝ otupoŋpiyǝ we rǝ yulaarǝ la anyɩŋkǝ fee mǝŋkǝsa we, we otupoŋpiyǝ sa rǝ yulaarǝ ŋyǝŋyǝ yǝ lǝ pǝ́ otoolukǝ we kǝ ponu kǝ teeri wǝ. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Duturǝ ɖi, ŋkǝ fɛɛkenikeniwǝ we anyɩmaasɩpǝ pǝ la tɔ mǝ wǝkaakpǝ, ǝkǝ wǝ ri fɛɛkenikenipoŋpiwǝ we la anyɩŋkǝ fee wǝ́ Kǝriso ŋ ne fii. Paa yulaarǝ ŋrǝŋrǝ lǝ mǝrǝ wǝ́ Kǝriso ŋ ne fii, fɛɛwǝ ŋ kpii rǝkǝsa ŋ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu lǝ rǝ Worokoyǝ la kǝnyɩŋkǝ. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Cɛŋ ri cɛŋ we, Oyudatǝpǝ lo toolutǝmumuŋyǝ lée fii fɛɛkenikeniwǝ le kenikeniwǝ mǝ ŋpǝrayǝ ŋ nee ri ŋwǝŋwǝ na wɛ la ŋpǝrayǝ wǝ. Paa Kǝriso ŋwǝ we, lee fii yulaarǝ ŋ kǝ fǝ na wɛ ŋ yee otoolukǝ pǝrǝŋwǝ kǝpakakǝpaka. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Wǝ kǝh lǝ ǝnǝ we, ǝrǝ kǝ́ Worokoyǝ ŋ no co ǝrǝkǝ we, o koh mǝ pwo Kǝriso la cʊʊrʊ pǝrǝŋwǝ kǝpakakǝpaka! Paa rǝkǝsa we, rǝ enituturuyǝ sa mǝrǝ wǝ́ ŋ na pɔrʊ na wɛ ŋ na kaŋ kǝceŋceŋ ko kǝkpakǝkpa, kǝ ŋ nǝǝnǝ turɔɔrɔɔwǝ saŋ rǝ kǝ́ ŋ nǝ fǝ ŋwǝŋwǝ na wɛ ŋ ne yee otoolukǝ wǝ. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Wǝ kpii wǝ koonu nyɩmaasɩyǝ ŋ kpǝ́ kǝceŋceŋ ko, rǝ wǝla kǝmaakǝ Worokoyǝ ŋ tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Kaa wǝǝ, Kǝriso ŋwǝ ŋkpɛ ŋ fǝ̀ na wɛ ŋ yeli otoolukǝ kǝceŋceŋ ko kǝkpakǝkpa kǝ ŋ pɔrʊ enyipǝ wa lo oturɔɔrɔɔyǝ ŋ cɛ. Lǝh pǝ tǝ ŋ pɔrʊ na wɛ ŋ kaŋ kǝyitǝkǝ, ŋkǝ kǝ ŋ tǝ ŋ pɔrʊ turɔɔrɔɔwǝ ŋ cɛ, paa kǝ ŋ lɔ ŋ koonu epǝ we pǝ ya pǝ lǝ́ǝ rǝŋ ŋwǝ wǝ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Mose le seyǝ we, lǝŋ pɔrʊ otuceeceeyǝ we yǝ kpii yǝ lǝ́ǝ pǝ ŋ kaŋ kpaŋ mǝŋ kǝ́ yǝ lǝ wǝ. Paa ŋwǝ seyǝ sa ri rǝ otuceeceeyǝ we la cɛrɛcɛrɛyǝ ko feepi wǝǝ. Kǝto we, lǝŋ koru okoonu kǝ epǝ we pǝ lóo ruu pǝ ŋ kǝlǝ mǝ Worokoyǝ pǝ to milimili pwi, mǝŋkǝ́ pǝ ke re otoolukǝ kǝceŋceŋ pǝ ke ŋ yee cɛŋ ri ŋ cɛŋ pǝ lǝŋ lɛ wǝ. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Mǝŋ koh mǝ koru wǝle eyeekǝ we, o koh mǝ pwo pǝ la wɛɛ mǝ otoolukǝ. A kah nyɩŋ epǝ we pǝ lóo ko mǝ akɛɛpǝ pǝ ŋ koonu Worokoyǝ pǝ la lɛrɩ kǝceŋceŋ ko kǝkpakǝkpa. Pǝla ziɔŋrǝ lǝŋ kǝ tǝ lǝŋ tɔɔ pǝ la bɔrǝ ǝkǝnǝŋ pǝ lǝǝmǝ oturɔɔrɔɔyǝ. Pǝ lǝŋ kǝ tǝ pǝ ŋ yee otoolukǝ rɛ. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Paa saŋ rǝ otoolukǝ sa we, pǝ ya pǝ láa taalǝ pǝlo oturɔɔrɔɔyǝ cɛŋ ri ŋ cɛŋ rǝ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Kpiikǝ anɛŋnuŋyǝ mǝ epereceekpatuyǝ la ŋpǝrayǝ lǝŋ koru anyɩɩrɩ oturɔɔrɔɔyǝ rǝ nyɩmaasɩyǝ ŋ cɛ.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Wǝ́ kǝto eniyǝ we Kǝriso ŋ kǝ ŋ pǝ ǝrǝkǝ we, wǝ́ ŋ tìi Worokoyǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:5">«Ǝ lǝǝ pǝ́ otoolukǝ amaa otukoonuyǝ rɛ,</para>
  <para style="q1" vid="HEB 10:5">paa e le yee wɛlɛŋrǝ o lo koonu mǝ.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Akɛɛpǝ we pǝ lo tu naawǝ rǝ otoolucuukǝ, mǝ</para>
  <para style="q1" vid="HEB 10:6">otoolukǝ koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ la rɛ wǝ laa ca lá kpɛɛ.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Wǝ́ ŋ́ ne tíi lǝ́ ǝkǝnǝŋ: “Ŋmǝ ǝyǝǝ, ŋ́ no furu</para>
  <para style="q1" vid="HEB 10:7">ŋ́ pe yee lǝ́ kǝǝpǝ́wǝ,</para>
  <para style="q1" vid="HEB 10:7">mǝŋ kǝ́ kǝfwɛɛkenikenikǝ kǝ la tɛŋ wǝ kǝ lo ru rǝ mǝ wǝ”».<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />La tɛŋ lo coonu ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:8">«Ǝ lǝǝ pǝ́ otoolukǝ amaa otukoonuyǝ rɛ,</para>
  <para style="q1" vid="HEB 10:8">ǝ lǝǝ pǝ́ akɛɛpǝ we pǝ lo tu naawǝ rǝ otoolucuukǝ,</para>
  <para style="q1" vid="HEB 10:8">amaa otoolukǝ koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ,</para>
  <para style="q1" vid="HEB 10:8">wǝ́ yǝ lǝŋ ce yǝ ca lá kpɛɛ».</para>
  <para style="p" vid="HEB 10:8">Paa ŋyǝ otuyǝ sa kpǝlo kɩɩkɩ we, Mose le seyǝ ŋ nǝ pǝ́ pǝ ŋ yee yǝ. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Wǝ́ ŋ nǝ tǝ ŋ na tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:9">«Ŋmǝ ǝyǝǝ, ŋ́ no furu kǝ ŋ́ pe yee lǝ́ kǝǝpǝ́wǝ».</para>
  <para style="p" vid="HEB 10:9">Kǝriso la siɛ zʊmasǝsǝŋrǝ we la cɛ wǝ́ ŋ nǝ tǝnǝ yitǝrǝ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Yesu Kǝriso le yee Worokoyǝ lǝ kǝǝpǝ́wǝ. Lǝ fǝ ŋwǝŋwǝ na wɛlɛŋrǝ lo koonu kǝceŋceŋ ko kǝkpakǝkpa. Wǝ́ ŋ na lɛrɩ lǝ ŋ no ru rǝ turɔɔrɔɔwǝ mǝrǝ.<verse eid="HEB 10:10" /></para>
  <para style="s">Ǝfǝcɛɛkǝ mǝ otomilimilikǝ rǝ Kǝriso mǝrǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Toolutǝ ri ŋ toolutǝ lée yi mǝ ŋ yaa ji ri ŋ ji kǝ ŋ yee na kǝnǝnɛkǝ. Otoolukǝ we kǝle kǝceŋceŋ wǝ́ ŋ ya ŋ née yee eni ri ŋ ni, paape kǝ lǝŋ koru anyɩɩrɩ nyɩmaasɩyǝ lo turɔɔrɔɔwǝ kǝ cɛ. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Kǝriso ŋwǝ paa we, le yee otoolukǝ lo koonu oturɔɔrɔɔyǝ kǝceŋceŋ ko wǝ́ ŋ ne ke tii rǝ Worokoyǝ le kǝnirisiɛɛkǝ kǝkpakǝkpa. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Rǝkǝsa we, ya lǝ́ǝ rǝŋ Worokoyǝ ŋ fǝ nǝ ǝkǝǝkpǝlǝtǝpǝ ŋ yee no tutɛakparǝyǝ. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Kpiikǝ saŋ rǝ otoolukǝ kǝceŋceŋ lo oŋuŋkǝ we, lo koonu epǝ we ŋ na lɛrɩ ŋ no ru rǝ turɔɔrɔɔwǝ pǝ lo to milimili kǝkpakǝkpa. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Tuwǝ wɛɛkenikenirǝ ŋrǝ ŋkpɛ ya lée ri ɖaŋsieyǝ lǝ ŋ tíi lǝ wǝǝ. Duturǝ ɖi la tɛŋ lo coonu ǝkǝnǝŋ:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />«Ǝtǝ Woroko la tɛŋ ǝkǝnǝŋ, dierǝ we ŋ́ náa parǝ mǝ pǝ ŋ́ tǝnǝ gaamǝ ɖǝ ǝnǝ,</para>
  <para style="q1" vid="HEB 10:16">rǝ eciyǝ sa la kǝmaakǝ we,</para>
  <para style="q1" vid="HEB 10:16">ŋ́ nǝ́ǝ fǝ mǝ esepǝ ŋ kpii pǝ rǝ pǝla asiɔŋyǝ</para>
  <para style="q1" vid="HEB 10:16">ŋ́ náa ŋʊrʊ pǝ ŋ́ kpii rǝ pǝlo oyupuyǝ. <verse eid="HEB 10:16" /><verse number="17" style="v" sid="HEB 10:17" />Ŋ́ nǝŋ tǝ ŋ pa taalǝ pǝlo oturɔɔrɔɔyǝ mǝ pǝla wǝfɔkpǝ».<verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />Vǝ́ pǝ lǝ fǝ oturɔɔrɔɔyǝ pǝ la cɛɛ we, wǝ lǝǝ tǝ wǝ pǝ́ kǝ pǝ yee otoolukǝ pǝ nyɩɩrɩ yǝ.<verse eid="HEB 10:18" /></para>
  <para style="s">Nǝ pǝ kǝ lo ruu lǝ kǝlǝ mǝ Worokoyǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Wǝ kǝto we, lǝh ǝtǝŋ, lǝ lǝǝmǝ turutawǝ yǝ lée fii fɛɛkenikeniwǝ le kenikeniwǝ saŋ rǝ Yesu la ŋpǝrayǝ we ŋ na lʊ wǝ. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />La taanǝ gʊŋŋwɛŋrǝ rɛ gbii mǝ vɔrʊrǝ lo koonu lǝ saŋ rǝ nyaŋrǝ we pǝ lǝ sǝŋ rǝ Worokoyǝ lo gukpǝ we wǝ. Ŋ́ reemǝ saŋ rǝ ŋwǝŋwǝ na wɛlɛŋrǝ. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Wǝ́ lǝ lǝǝmǝ toolutǝmumuŋyǝ rɛ ŋ re Worokoyǝ la nyarǝwǝ wǝ. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Kǝto we, nǝ pǝ kǝ lo ruu lǝ kǝlǝ mǝ Worokoyǝ mǝ ziɔŋrǝ lée ri anʊkɔrǝyǝ mǝ lɔnuŋrǝ fee, ziɔŋrǝ we la lɛrɩ lo ru rǝ tu ri ŋ tu wǝ láa tɔɔ rǝla bɔrǝ, mǝ wɛlɛŋrǝ pǝ le wiiri mǝ mɛŋkenikeniwǝ wǝ. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Nǝ pǝ kǝ la ta lah lɔnuŋrǝ we la ya yǝ láa pɔrʊ yǝ ŋ tɛŋ le re kpoŋkpoŋ rɛ ŋ pee kpii wɛɛyɔɔwǝ, duturǝ ɖi yǝ we ŋ no co lǝ garǝ we, nʊkɔrǝlǝtǝyǝ wǝ́ ŋ ri. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Nǝ pǝ kǝ lǝ rǝŋ awɛ kǝ wǝ nya fɛɛ wǝ kpii lǝ okopiyǝ koonu kǝǝtaawǝ mǝ tuceeceewǝ le eyeekǝ. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />La paa nyarǝ lah wǝcakukpǝ lo co mǝŋ kǝ́ arɛɛpǝ pǝ lée pi pǝ ŋ yee wǝ kǝtǝ wǝ. Paa we, nǝ pǝ kǝ le kpii awɛ lo okopiyǝ. Wǝ kpii kǝ le mǝ yee wǝ ǝnǝ otukpǝlo kǝ́ nǝ ya nǝ nyáa nyɩŋ Kulǝtǝyǝ le jirǝ we ya lǝ́ǝ kǝlǝ wǝ.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Duturǝ ɖi mǝŋ lǝ tǝ la ya yǝ láa kʊʊrʊ yǝ ŋ yee oturɔɔrɔɔyǝ kǝ́ yǝ le ci anʊkɔrǝyǝ we yǝ la lɛ we, otoolukǝ rɛ kǝ lǝǝ tǝ kǝ kpii kǝ lóo koru apɔrʊ oturɔɔrɔɔyǝ kǝ cɛ. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />We wǝ lo tuuru lǝ la ya lǝ mǝ rǝŋ mǝ vu mǝ vu wǝkpaŋtɛŋkpǝ mǝ naamumuŋwǝ sa wǝ leh pǝ yee Worokoyǝ lǝ ǝkǝǝkpǝlǝtǝpǝ wǝ. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Mǝŋ rɛ lee yee ŋ saŋ rǝ Mose le seyǝ, wǝ́ enyi eyi amaa enyi ata pǝ le ri ɖaŋsieyǝ pǝ lo ru rǝ no turɔɔrɔɔwǝ sa we, pǝ láa wʊ yǝ we rǝ. Tǝlarǝnyɩŋwǝ rɛ wǝ lee kpii! <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Nyiyǝ we ŋ nǝ́ǝ fǝ Worokoyǝ le Piyǝ mǝ ŋ siɛ akparǝyǝ we, no tukoŋtawǝ wǝ láa lɛnyɩ ŋpa wǝ teeri, ama? Duturǝ ɖi ŋwǝ nyiyǝ sa laa ya lǝ́ǝ fǝ Dieparǝtǝnǝŋwɛŋrǝ sa la ŋpǝrayǝ we pǝ lǝ fǝ pǝ la lɛrɩ ŋwǝ pǝ lo ru rǝ turɔɔrɔɔwǝ mǝ ŋ parǝ. Wǝ́ ŋ náa lɛ mǝ ŋ fɛɛpɩ Wɛɛrǝ we lée yee lǝ lɛsiɛrɩwǝ wǝ. <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Duturǝ ɖi le cii ŋwǝ, yǝ we ŋ na tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:30">«Ŋmǝ ŋ́ náa ca tuwǝ la kpawǝ,</para>
  <para style="q1" vid="HEB 10:30">ŋmǝ ŋ́ náa mwara nyiyǝ lo tuwǝ wǝ kaamǝ ŋwǝ wǝ».</para>
  <para style="p" vid="HEB 10:30">Wǝ́ ŋ nǝ tǝ ŋ na tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:30">«Ǝtǝ Woroko lah pa tɛŋ nǝ kǝkpǝŋkǝ la wǝkpaŋkpǝ».<verse eid="HEB 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 10:31" />Mǝŋ Worokoyǝ we ŋ kpii vɔrʊrǝ lo ro ŋlǝ́ rɛ la ta we, paapɔ mǝ lá aria! <verse eid="HEB 10:31" /><verse number="32" style="v" sid="HEB 10:32" />Nǝ taalǝ ecisǝsǝŋyǝ we, kǝ́ nǝ lɔ̀ Worokoyǝ la wǝnyɩɩnɩkpǝ nǝ lɛ̀ eni ko, wǝ́ nǝ fìi rǝ acʊcʊʊrʊyǝ ŋpa, wǝ́ nǝ tɔ̀ nǝ yàa rǝ afiakǝ rɛ kǝ lɛnyɩ mǝrǝ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Enirɛɛyǝ pǝ ka ŋ fɛɛpɩ nǝ wǝ́ pǝ ke ŋ pieeli nǝ rǝ canɩtiwǝ, enirɛɛyǝ nǝ ko ŋ fuu nyǝ ŋ toŋ epǝ we pǝ ya pǝ lée yee mǝ otuyǝ sa wǝrʊʊkpǝ wǝ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Awo, nǝ nya cʊʊrʊ nǝ nya kʊla mǝ okukpɛɛtǝpǝ, wǝ́ nǝ tɛ̀ɛnɩ mǝ faawǝ pǝ ta no otulǝmǝyǝ pǝ lɔ rǝ nǝ, kpiikǝ nǝ ke cii wǝ ǝkǝnǝŋ ŋnǝ nǝ lǝǝmǝ otulǝmǝyǝ rɛ rǝ yulaarǝ yǝ ponu yǝ teeri wǝ, wǝ́ yǝ kpɛlɩ nǝ kǝkpakǝkpa. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Kǝto nǝ pǝǝ lǝǝrǝ nǝ kpɛɛtɛɛwǝ, wǝtoomwaramumuŋkpǝ rɛ wǝ kpɛlɩ wǝ koonu ŋ wǝ kpɛɛtɛɛwǝ sa. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Nǝ nyǝ pǝ́ atɔyaakǝ kǝ nǝ yee Worokoyǝ lǝ kǝǝpǝ́wǝ, mǝŋkǝsa we, kǝ nǝ nya fɛɛ nǝ lɔ tuwǝ we ŋ no co garǝ wǝ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 10:37">«Wǝ lǝ tǝ wǝ lo tuuru eniyǝ kpekperee,</para>
  <para style="q1" vid="HEB 10:37">wǝ lǝŋ ce wǝ panǝ,</para>
  <para style="q1" vid="HEB 10:37">kǝ yǝ we ŋ no furu we, ŋ pe fii,</para>
  <para style="q1" vid="HEB 10:37">lǝŋ pǝ tǝǝlǝ.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Worokoyǝ la tɛŋ ǝkǝnǝŋ yǝ we ŋ na lɔ mǝ ŋ no nuŋ wǝ́ ŋ kʊʊ we, lée tii vɔrʊrǝ.</para>
  <para style="q1" vid="HEB 10:38">Paa mǝŋ le kpii lǝ kpǝlǝŋ we, no tuwǝ wǝ lǝŋ tǝ wǝ pa ca mǝ kpɛɛ.»<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />Ŋlǝ paa we, yǝ lee ri enyipǝ we pǝ lée kpii pǝ ŋ kpǝlǝŋ, ǝ pǝ ŋ kǝ lǝǝ wǝ. Paa la kʊla mǝ epǝ we pǝ la lɔ Worokoyǝ pǝ lo nuŋ wǝ́ pǝ kpii rǝ alɔkuŋkǝ la cawǝ wǝ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Lɔnuŋrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Lɔnuŋrǝ gaamǝ kǝ́ nyɩmaasɩyǝ ŋ na tɛɛ kpɛɛwǝ ǝkǝnǝŋ ŋ na marǝ anya tuwǝ we ŋ ya ŋ nǝ́ǝ rǝŋ wǝ. Wǝ́ lɔnuŋrǝ lɛ gaamǝ kǝ́ nyɩmaasɩyǝ ŋ na lɔ ŋ no nuŋ ǝkǝnǝŋ otuyǝ we ŋ nǝŋ nyɩŋ yǝ kpii kǝceece wǝ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Akakatǝpǝ la lɔnuŋrǝ kǝto wǝ́ pǝlo tuwǝ wǝ ko ponu mǝ Worokoyǝ wǝ.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Lɔnuŋrǝ kǝto wǝ́ yǝ lóo nuŋ duturǝ ǝkǝnǝŋ Worokoyǝ cò ǝrǝkǝ kpǝlo sanǝ rǝ ne dierǝ. Wǝ́ saŋ rǝ otuyǝ we nyɩmaasɩyǝ ŋ nǝŋ nyɩŋ wǝ́ Worokoyǝ ŋ no co otuyǝ sa yǝ láa nyɩŋ wǝ.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Abɛlǝ la lɔnuŋrǝ kǝto wǝ́ ŋ yeli otoolukǝ ŋ kòonu Worokoyǝ, wǝ́ no otoolukǝ sa kǝ ko ponu kǝ teeri Kayɩŋ la kǝnɛŋkǝ. Abɛlǝ la lɔnuŋrǝ kǝto wǝ́ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ yeli nyikʊʊyǝ, duturǝ ɖi Abɛlǝ lo otukoonuyǝ sa yǝ cà Worokoyǝ ŋwǝŋwǝ la kpɛɛwǝ. Abɛlǝ la lɔnuŋrǝ kǝto we, mǝŋkǝ́ ŋ nǝ kpǝ́ paape tǝ ya láa wɛɛlɩ.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Enɔkǝ la lɔnuŋrǝ kǝto wǝ́ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ rɛ̀ yulaarǝ, kǝ ŋ paa nya fɛɛ ŋ kpǝ́. Rɛ lǝǝ tǝ ŋ pa nyɩŋ ŋwǝ, duturǝ ɖi Worokoyǝ fǝ̀ ŋwǝ rɛ̀ yulaarǝ. Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Kpɛŋ kǝ Worokoyǝ ŋ pǝ fǝ Enɔkǝ ŋ rɛ yulaarǝ we, Enɔkǝ lo tuwǝ wǝ ko ponu mǝ ŋwǝ». <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Paa mǝŋ nyiyǝ rɛ laa lɔ ŋ nuŋ we, yǝ we lo tuwǝ wǝ lǝŋ koru opoŋ mǝ Worokoyǝ kʊrakʊra. Duturǝ ɖi yǝ we ŋ nǝ́ǝ pǝ Worokoyǝ lǝ kpǝŋ we, wǝ kpii kǝ ŋ lɔ ŋ nuŋ ǝkǝnǝŋ Worokoyǝ kpii, wǝ́ ŋ náa mwara epǝ we pǝ láa taa na akʊŋyǝ wǝ. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Nowa la lɔnuŋrǝ kǝto wǝ́ ŋ nunu Worokoyǝ le ecikaŋkǝ ru rǝ otuyǝ we yǝ kǝ ŋ pǝ yǝ pǝ pǝ ǝkǝ rɛ ŋ naa maa ŋ ka ŋ nyɩŋ wǝ. Nowa lǝǝ fǝ Worokoyǝ le dierǝ we ŋ tìi ŋwǝ ŋ wʊrʊ, wǝ́ ŋ kpǝ̀ gbanǝŋwaarǝ kǝ ŋ nya fɛɛ ŋ pɔrʊ na anyarǝtǝpǝ. Na lɔnuŋrǝ kǝto wǝ́ ŋ tɔ̀ɔ ǝrǝkǝ la bɔrǝ wǝ. Fɛɛwǝ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ yeli nyikʊʊyǝ rǝ na lɔnuŋrǝ we kǝto wǝǝ.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Abǝrahamǝ la lɔnuŋrǝ kǝto, wǝ́ ŋ cò kǝtukoŋkǝ kǝ́ Worokoyǝ ŋ pwò ŋwǝ wǝ, wǝ́ ŋ yili ŋ pwɛ̀yɩ ŋ ko ŋ ko gǝŋrǝ rɛ Worokoyǝ ŋ kǝ ŋ fǝ ŋ koonu ŋwǝ kǝ ɖi na nɛŋ wǝ. Wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko lee ke ci fɛɛwǝ ŋ ko ŋ ko wǝ. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ Abǝrahamǝ ŋ kolu ŋ tini mǝŋ sǝǝyǝ kǝtǝ rǝ gǝŋrǝ we Worokoyǝ ŋ cò na garǝ wǝ. Tɔ̀ bwiirǝ ke kpii ŋpǝ mǝ Isakǝ mǝ Yakɔbǝ. Isakǝ mǝ Yakɔbǝ ŋpǝ ŋkpɛ pǝ kʊla mǝ garǝ we Worokoyǝ ŋ cò Abǝrahamǝ wǝ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Duturǝ ɖi Abǝrahamǝ kǝ ŋ rǝŋ tǝŋtǝǝwǝ we pǝ la tɔ mǝ kǝtɛɛkǝ kǝ lɛnyɩ wǝ. Ŋ wǝ tǝŋtǝǝwǝ sa we, Worokoyǝ ŋwǝŋwǝ ŋ na kaa wǝ, wǝ́ ŋ na lɛ ŋ na tɔ wǝ.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Saŋ rǝ Sara la lɔnuŋrǝ kǝto, wǝ́ Worokoyǝ ŋ yeli wǝ́ ŋwǝ ŋkpɛ ŋ kòru anya wǝmǝkpǝ. Duturǝ ɖi lɔ̀ nunu ǝkǝnǝŋ vǝ́ Worokoyǝ lo co garǝ we, ŋ yee wǝ. Kaŋfɩ kuru wǝ́ ŋ naa ka ŋ lɛ mǝ ŋ mǝ. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Abǝrahamǝ kùru kɔfɩkɔfɩ paape ŋwǝ ceŋceŋ lǝ mǝ wǝmǝmumuŋkpǝ rɛ mǝŋ wǝŋɔŋkpǝ rǝ yulaarǝ kǝtǝ, wǝ́ wǝ lɛ wǝ naanǝ ŋpa mǝŋ apʊyǝ la naŋrǝ kǝtǝ, rɛ lǝŋ koru kpǝ lǝ ǝkǝ.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Lɔnuŋrǝ lǝ mǝrǝ wǝ́ ŋpǝ enyipǝ sa kpǝlo kɩɩkɩ pǝ kpǝ̀. Pǝ laa lɔ otuyǝ we Worokoyǝ ŋ cò pǝ la garǝ wǝ, paa pǝ nyɩnɩ yǝ pǝ manǝ, wǝ́ pǝ nya faawǝ wǝ́ pǝ nyɩnɩ wǝ pǝ cii ǝkǝnǝŋ ŋpǝ pǝ ri ǝsǝǝpǝ mǝ akʊŋsaŋtǝpǝ rǝ kǝtǝǝwǝ sa. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Duturǝ ɖi epǝ we pǝ láa wɛɛlɩ mǝŋkǝsa we, pǝ láa pɔrʊ pǝ ŋ kaŋ ǝkǝnǝŋ pǝ ya pǝ láa taa gǝŋrǝ rɛ ɖi pǝla nɛŋ rǝ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />O koh nuŋ gǝŋrǝ we pǝ pwɛ̀yɩ dǝ ga ŋ ca pǝla kpɛɛ we, pǝ kǝ tǝ pǝ nyà eniyǝ pǝ siɛnɩ pǝ ko rǝ. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Paa rǝ anʊkɔrǝyǝ we, pǝ kǝ ŋ pǝ́ rǝ gǝŋrǝ rɛ dǝ bonu deeri wǝ, ɖǝ we gbii rǝ yulaarǝ wǝ. Tuwǝ kǝto wǝ lǝŋ co Worokoyǝ la nʊŋsɔɔwǝ, vǝ́ enyipǝ pǝ lo pwo ŋwǝ pǝlo Worokoyǝ wǝ. Duturǝ ɖi la kpaka tǝŋtǝǝwǝ rɛ lǝ tǝnǝ pǝ. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ Abǝrahamǝ ŋ fǝ̀ ne piyǝ Isakǝ ŋ ke yee otoolukǝ mǝ kǝ́ Worokoyǝ ŋ tiè ŋwǝ ŋ yɩ̀rɩ wǝ. Abǝrahamǝ yǝ we Worokoyǝ ŋ cò garǝ we, ne piceŋceŋyǝ we wǝ́ ŋ fǝ̀ ŋ yeli otoolukǝ we.<verse eid="HEB 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HEB 11:18" />Paa kaŋfɩ Worokoyǝ tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 11:18">«Isakǝ le epipǝ pǝ lée ri lǝ́ wǝmǝkpǝ wǝ».<verse eid="HEB 11:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="HEB 11:19" />Abǝrahamǝ ko ŋ pu wǝ ǝkǝnǝŋ Worokoyǝ lǝǝmǝ okopiyǝ ŋ náa saanǝ nyiǝtǝyǝ, tuwǝ kǝto Worokoyǝ ŋ sìɛnɩ mǝ ne piyǝ ŋ kòonu ŋwǝ, kǝ a tɛŋ la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ rǝ.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Saŋ rǝ lɔnuŋrǝ kǝto wǝ́ Isakǝ ŋ pɛ̀ɛrɩ Yakɔbǝ mǝ Esawʊ ŋ tǝnǝ soosowǝ sa wǝ lo furu wǝ.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Saŋ rǝ lɔnuŋrǝ kǝto we, kǝ́ Yakɔbǝ ŋ nah ta ŋ pǝ kpǝ́ we, wǝ́ ŋ pɛ̀ɛrɩ Yosɛfʊ le pi ri ŋ pi. Wǝ́ ŋ ta ne ciisaŋwǝ, wǝ́ ŋ pɛ̀ɛlɩ ŋ sʊ̀ma Worokoyǝ.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Saŋ rǝ lɔnuŋrǝ kǝto kǝ́ Yosɛfʊ ŋ nah ta ŋ pǝ kpǝ́ we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ Isǝrayɛlǝtǝpǝ pǝ lah pa pwɛyɩ rǝ Ejipǝte, wǝ́ ŋ cìi ŋ tìi pǝ kǝ́ pǝ leh pe yee mǝ no okopiyǝ we wǝ.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ Mose lǝ ǝmǝtǝpǝ pǝ fǝ̀ Mose pǝ ŋwàa akɛɛnyɔŋpǝ ata, kǝ́ pǝ lǝ mǝ ŋwǝ pǝ la lɛ wǝ. Duturǝ ɖi pǝ nyɩnɩ piyǝ we lo wǝpoŋkpǝ kǝto pǝ laa cɩɩlɩ rǝ piliyǝ we le seyǝ we ŋ pɔ̀rʊ ŋ rù wǝ.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Saŋ rǝ lɔnuŋrǝ kǝto kǝ́ Mose ŋ na pa naanǝ we, wǝ́ ŋ sǝ́nǝ pǝ pǝǝ tǝ pǝ pwo ŋwǝ Farawo la kɔrʊ le piyǝ. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Sàa pɔ̀rʊ ǝkǝnǝŋ wǝ ponu kǝ ŋwǝ ŋ cʊʊrʊ ŋ kʊla mǝ Worokoyǝ lǝ kǝkpǝŋkǝ wǝ teeri kǝ́ ŋ neh tii mǝ ŋ ri vɔrʊrǝ rǝ turɔɔrɔɔwǝ mǝrǝ koonu enipiyǝ rɛ rǝ ko wǝ.<verse eid="HEB 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 11:26" />Nyɩnɩ wǝ ǝkǝnǝŋ vǝ́ pǝ la fʊʊ ŋwǝ pǝ lǝ sǝǝlǝ mǝŋ Kǝriso kǝtǝ we, wǝ lóo ru okuruyǝ wǝ teeri Ejipǝte lo otulǝmǝyǝ. Duturǝ ɖi ne enimiyǝ yǝ ka tɛɛ rǝ sooso lo wǝtoomwarakpǝ lo oŋuŋkǝ. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Saŋ rǝ lɔnuŋrǝ kǝto, Mose loo suu piliyǝ la kpɛɛmʊrʊwǝ, wǝ́ ŋ pwɛ̀yɩ rǝ Ejipǝte, duturǝ ɖi tɔ̀ yàa kǝ atɛŋ ya ka ŋ nyɩŋ Worokoyǝ we pǝ lǝŋ nyɩŋ wǝ.<verse eid="HEB 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 11:28" />Na lɔnuŋrǝ kǝto, wǝ́ ŋ rili Eyinyapǝkǝ la wǝcɛkpǝ we. Wǝ́ ŋ tìi enyipǝ pǝ fǝ ŋpǝrayǝ pǝ nuŋ rǝ anyarǝyǝ lo okuŋpoluciiyǝ kǝ gbɛŋrǝ le picoŋpiyǝ ŋ paa nya fɛɛ ŋ ruu Isǝrayɛlǝtǝpǝ le episǝŋmǝpǝ.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ Isǝrayɛlǝtǝpǝ pǝ tà Apʊmwɛɛrɩyǝ pǝ kolu pǝ tɛ̀lɩ mǝŋ fɛɛwosowosowǝ kǝtǝ. Paa kǝ́ Ejipǝtetǝpǝ pǝ ka ŋ ta pǝ yɩrɩ we, wǝ́ apʊyǝ we ŋ rili pǝ. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Saŋ rǝ lɔnuŋrǝ kǝto, kǝ́ Isǝrayɛlǝtǝpǝ pǝ la saŋ pǝ le siri Yeriko le ekiriŋyǝ we wǝcukpǝ wǝpǝrɩmata we, wǝ́ ekiriŋyǝ we yǝ tɔ̀ɔlʊ. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ tuutuuyǝ we pǝ lóo pwo Rahabǝ ŋ nǝǝ kpǝ́ ŋ kʊla mǝ epǝ we pǝ yili pǝ tɛ̀ɛ rǝ Worokoyǝ wǝ. Duturǝ ɖi lɔ̀ enyiwɛtǝpǝ we lǝ kǝsǝǝkǝ sɩsiɛrɩ.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Kǝ ŋ́ tǝ ŋ́ tɛŋ kǝ́ lo tu? Mǝŋ ŋ́ nǝ́ǝ tǝ ŋ wɛɛlɩ we, eniyǝ yǝ lǝŋ po ro mǝ kǝ ŋ́ wɛɛlɩ ŋ́ ru rǝ Gedewɔŋ, Barakǝ, Samǝsɔŋ, Yɛfǝte, Davidǝ, Samiɛlɩ mǝ akpɛɛnuŋtɛŋtǝpǝ. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Saŋ rǝ lɔnuŋrǝ kǝto, wǝ́ enyirɛɛpǝ pǝ rili ǝkǝŋyǝ lo yurǝ. Arɛɛpǝ pǝ yeli pǝ sanǝ rǝ wǝkʊʊkpǝ, wǝ́ pǝ lɔ̀ otuyǝ we Worokoyǝ ŋ cò pǝ la garǝ wǝ. Wǝ́ apʊŋpwapǝ pǝ lɛ̀ pǝ sìi akɛɛlɔpǝ lo nyuŋkpǝ. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Enyirɛɛpǝ pǝ rǝ̀ǝnǝ anaayǝ we yǝ ka ŋ ta mǝ okopiyǝ wǝ. Pǝ pǝlǝ pǝ pa wʊ enyirɛɛpǝ mǝ tʊkʊwǝ, paape saŋ rǝ pǝla lɔnuŋrǝ kǝto we, pǝ lǝǝ tǝ pǝ wʊ pǝ. Arɛɛpǝ pǝ fǝ̀rǝ paape saŋ rǝ pǝla lɔnuŋrǝ wǝ́ pǝ kpàa. Apʊŋpwapǝ pǝ pɔ̀rʊ pǝlo okopiyǝ pǝ kanǝ rǝ akɔŋkǝ, wǝ́ pǝ pìri ǝsǝǝpǝ la akɔŋtǝpǝ pǝ canǝ. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Saŋ rǝ lɔnuŋrǝ kǝto wǝ́ etierɛɛpǝ le enyipǝ pǝ sàanǝ pǝ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ. Pǝ kpìi arɛɛpǝ la acʊcʊʊrʊyǝ wǝ́ pǝ kolu pǝ kpǝ̀ rǝ. Ŋpǝŋpǝ pǝ laa tɛ̀ɛnɩ rɛ ŋ pɔrʊ pǝ rǝ gbɛŋrǝ sa mǝrǝ. Pǝ yeli wǝ ǝnǝ kǝ Worokoyǝ ŋ nya fɛɛ ŋ pa saanǝ pǝ koonu vɔrʊkpatɩrǝ. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Pǝ fɛ̀ɛpɩ arɛɛpǝ wǝ́ pǝ cùlu pǝ. Pǝ kpìi arɛɛpǝ la akpɛtɛɛyǝ, wǝ́ pǝ tanǝ pǝ. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Pǝ tìeni arɛɛpǝ lo oruyǝ pǝ wʊlʊ, wǝ́ pǝ sǝ̀ǝrǝ arɛɛpǝ mǝ sayayǝ. Pǝ sìeni arɛɛpǝ la atʊkʊyǝ pǝ wʊlʊ, wǝ́ arɛɛpǝ pǝ còolu pǝ ka ŋ tɛlɩ mǝ mɛɛfwɛɛwǝ amaa pereceefwɛɛwǝ la wǝkpakpǝ, wǝ́ pǝ fii ariaayǝ, wǝ́ enyipǝ pǝ yili pǝ tɛ̀ɛ rǝ pǝ, wǝ́ pǝ ke ŋ pieeli pǝ. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Enyipǝ sa pǝ ko ponu kururu kǝto ǝrǝkǝ sa kǝ laa ka kaamǝ kǝ pǝ tii vɔrʊrǝ rǝ kǝ. Pǝ còolu pǝ ka ŋ tɛlɩ rǝ anyɔŋkpaakǝtǝǝyǝ, otutupiyǝ, wǝnyaŋkpǝ mǝrǝ mǝ okoŋfuŋyǝ mǝrǝ.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Saŋ rǝ enyipǝ sa la lɔnuŋrǝ kǝto, wǝ́ pǝlo tuwǝ wǝ càa Worokoyǝ la kpɛɛwǝ wǝ. Paape pǝ laa lɔ tuwǝ we Worokoyǝ ŋ cò pǝ la garǝ wǝ. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Duturǝ ɖi Worokoyǝ ka ŋ kpaka otuyǝ yǝ tǝ yǝ ponu yǝ teeri ŋ koonu lǝ. Kǝto mǝŋ ŋlǝ yǝ laa kʊla we, ŋpǝ enyipǝ sa pǝ lǝŋ koru oto milimili.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Lǝh Tǝ Worokoyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Wǝ kǝto ŋla ŋkpɛ we, kǝ́ wǝ ri araŋsielǝtǝpǝ wa pǝ lo co pǝ le siri lǝ we, nǝ pǝ kǝ le tie eleeyǝ we kpǝlo kɩɩkɩ yǝ lóo co lǝ nuruwǝ lo co, kǝ le tie turɔɔrɔɔwǝ we wǝ lée mili mǝ lǝ putepute we, lo co kǝ la nya fɛɛ la nyɩɩ lo suu osuukǝ we pǝ le kpii lǝ lo suu la ka lɛ rǝ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Kǝ la tɔ enimiyǝ rǝ Yesu rǝ ko. Ŋwǝ yǝ we ŋ ri lah lɔnuŋrǝ la kǝtɛɛkǝ, wǝ́ ŋ náa lɛ mǝ ŋ yee oturu lɔnuŋrǝ sa lo to milimili wǝ. Sǝnǝ faawǝ we wǝ ke ri na nɛŋ wǝ, wǝ́ ŋ tɛ̀ɛnɩ kpɛtɛkpǝlɛciiwǝ la gbɛŋrǝ. Loo co oku rǝ nʊŋsɔɔwǝ we wǝ kpii rǝ gbɛŋrǝ sa mǝrǝ wǝ. Wǝ́ rǝkǝsa ŋ tini rǝ Worokoyǝ le bilisaarǝ le kǝnirisiɛɛkǝ.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Nǝ pu yurǝ nǝ ru rǝ Yesu, rǝ wǝlǝkpǝ oturɔɔrɔɔyeetǝpǝ pǝ yili pǝ tɛ̀ɛ rǝ ŋwǝ wǝ, paape wǝ́ ŋ tàarǝ lɛrǝ ŋ lɔ̀ tu ri ŋ tu. Mǝŋkǝsa we, nǝ nyǝŋ maa wɛɛyɔɔwǝ wǝ ri nǝ yurǝ. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Duturǝ ɖi rǝ nǝ akɔŋkǝ we nǝ ya nǝ nyée yee mǝ turɔɔrɔɔwǝ we, nǝ faa maa nǝ fia ko ro ǝrǝ gbɛŋrǝ. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Amaa nǝ nyo yuu ecikaŋkǝ we Worokoyǝ ŋ ya ŋ nóo koonu nǝ mǝŋ epipǝ kǝtǝ la kpɛɛ? Ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 12:5">«Mǝ pi, pǝǝ fǝ Ǝtǝ Woroko lo tukoŋtawǝ e yee mɔŋkpɛɛtuwǝ.</para>
  <para style="q1" vid="HEB 12:5">Mǝŋ la kpaŋ mǝ lǝ́ we, wǝ paa yɔ lǝ́ wɛɛwǝ.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Duturǝ ɖi Ǝtǝ Woroko láa ta yǝ we ŋ náa taa kǝǝwǝ lo kǝtukoŋkǝ,</para>
  <para style="q1" vid="HEB 12:6">Yǝ we ŋ na tɛɛ akaa ǝkǝnǝŋ ri ne piyǝ we, ŋwǝ wǝ́ ŋ nóo culu wǝ.»<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Vǝ́ Worokoyǝ ya láa ta nǝ kǝtukoŋkǝ wǝ́ nǝ ya nǝ nyóo fuu we, nǝ nyɩɩ nǝ tɔ nǝ yaa rǝ vuurǝ sa mǝrǝ. Worokoyǝ ya lée re nǝ mǝŋ ne epipǝ kǝtǝ. Duturǝ ɖi, piyǝ rɛ lee kpii tǝyǝ ŋ nǝŋ kʊʊrʊ wǝ. <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Mǝŋ tǝyǝ rɛ lah ta ne epipǝ kpǝlo kɩɩkɩ lo kǝtukoŋkǝ, wǝ́ ŋ na pɔrʊ ŋnǝ arɛɛpǝ paa ŋ na cɛ we, we nǝ nyee ri ne epipoŋpipǝ, paa okpookpoopipǝ wǝ́ nǝ ri. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Kǝ la taalǝ ǝkǝnǝŋ ŋlǝ lǝ lǝǝmǝ ǝtǝpǝ rǝ kǝtǝǝwǝ sa. Pǝ ka ŋ ta lǝ kǝtukoŋkǝ, wǝ́ lo ko ŋ co kǝtukoŋkǝ rǝ pǝ. Kǝto wǝ laa laka kǝ la pɛɛlɩ lah wɛ lo koonu lǝh Tǝyǝ rǝ yulaarǝ le teeri kǝ la nya fɛɛ le tii vɔrʊrǝ? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Lǝh ǝtǝpǝ ŋpǝ we, pǝ ka ŋ ta lǝ kǝtukoŋkǝ mǝŋ kǝ́ wǝ ponu mǝ pǝ koonu enipiyǝ rɛ ko. Paa Worokoyǝ we, láa ta lǝ kǝtukoŋkǝ koonu leh ceeceewǝ rǝ, kǝ ŋla ŋkpɛ la nya fɛɛ lǝ pǝ lǝ kenikeni mǝŋ ŋwǝ kǝtǝ. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Kǝceece, vǝ́ pǝ la ta nyiyǝ lo kǝtukoŋkǝ we, wǝ lǝŋ ri faawǝ lo tuwǝ wǝ koonu ŋwǝ rǝ kǝyaakǝ we, paa wǝ lóo koonu yǝ we ŋ fii gʊʊpirǝ rǝ. Paa kǝmaamaa we, epǝ we pǝ la ta kǝtukoŋkǝ rǝ wǝlǝkpǝ sa we, pǝ láa siɛrɩ pǝ ŋ yee enyikʊʊpǝ, pǝ ŋ nya wǝtaarǝkpǝ.<verse eid="HEB 12:11" /></para>
  <para style="s">Ecikaŋtuturukǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Ŋnǝ epǝ we wǝnukpǝ mǝ onuunuuyǝ yǝ lǝ kpǝ́ we, nǝ kpii nǝ wɛ lo okopiyǝ. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Nǝ tɛɛ akʊŋkʊʊyǝ nǝ koonu nǝ wɛ, kǝ ǝsǝ́ŋpǝ pǝ paa pa nyɩkɩ, paa kǝ pǝ kpaa rǝ.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Nǝ nyɩɩ kǝ nǝ tii rǝ wǝtaarǝkpǝ mǝ nyi ri ŋ nyi, kǝ nǝ tii vɔrʊrǝ we láa ca Worokoyǝ la kpɛɛwǝ wǝ. Mǝŋ nǝ nyee tii vɔrʊrǝ we láa ca Worokoyǝ la kpɛɛwǝ we nǝ nyǝŋ pa nyɩŋ Kulǝtǝyǝ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Nǝ yee yurǝ, rɛ ŋ paa pɔrʊ na wɛ ŋ cɛ rǝ Worokoyǝ la lɛsiɛrɩwǝ lǝ mǝrǝ. Wǝ́ rɛ rǝ nǝ mǝrǝ ŋ paa siɛrɩ ŋ yee kuruŋkuwǝ rɛ mǝ kaawǝ wǝ leh wii rǝ nǝ mǝrǝ kǝ wǝ pǝ fǝ wǝla wǝpwɛkpǝ we wǝ taapǝ enyipǝ wa rǝ nǝ mǝrǝ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Rɛ ŋ pee ri nuŋruyeetǝyǝ, rɛ ŋ pee ri nyiyǝ ŋ náa fʊ Worokoyǝ lo otuyǝ mǝŋ sǝǝlǝ mǝŋ Esawʊ kǝtǝ wǝ, ŋwǝ yǝ we, rǝ keeriwǝ sa hawee kǝto, wǝ́ ŋ sìiri no kǝmumuŋkǝ wǝ! <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Mǝŋ kǝ́ nǝ cii wǝ kǝtǝ we, kǝmaamaa we, Esawʊ pǝ̀ nǝ tǝ ŋ pɛɛrɩ ŋwǝ paape lǝǝ tǝ ŋ nya kpǝ. Laa nya kʊŋwǝ rɛ kǝ ŋ cɛkɛlɛ wǝlǝkpǝ sa mǝrǝ ŋ ke kpii wǝ mǝŋkǝ́ ŋ kǝ ŋ pǝ́ wǝ mǝ eweekǝ paape!<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Duturǝ ɖi, nǝ nyoo ruu nǝ kǝlǝ mǝ tǝrɛ pǝ lóo koru oruu mǝŋ kǝ́ Isǝrayɛlǝtǝpǝ pǝ rùu pǝ kǝ̀lǝ mǝ Sinayi lo dutupirǝ mǝ eniyǝ we pǝ ke kpii rǝ nyɔŋkpaakǝtǝǝwǝ: Rǝ Sinayi lo dutupirǝ we we, pǝ nyɩnɩ naamumuŋwǝ rɛ, wǝ pǝ nyɩnɩ nuŋtumumumuŋwǝ rɛ mǝ ǝrǝfuŋmumuŋkǝ rɛ. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />Pǝ nunu kǝpɛrɩkǝ la kpɛɛwǝ mǝ kpɛɛwǝ rɛ lo tutɛŋwǝ. Kǝ́ Isǝrayɛlǝtǝpǝ pǝ lo nuŋ kpɛɛwǝ sa we, wǝ́ pǝ tɛnɩ ǝkǝnǝŋ ŋpǝ pǝ lǝŋ tǝ pǝ pǝ́ pǝ nuŋ kpɛɛwǝ sa. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Duturǝ ɖi pǝ ko ŋ suu dierǝ sa lo vurǝ. Dierǝ sa la tɛŋ ǝkǝnǝŋ: «Yǝ we ŋ nóo ruu dutupirǝ sa we, wǝ ke ce wǝ ri kɛɛyǝ oo, pǝ tieni no oruyǝ pǝ wʊ.» <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Otuyǝ pǝ nyɩnɩ rǝ fɛɛwǝ we yǝ cò vurǝ kururu, wǝ kǝto Mose ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 12:21">«Ŋ́ na cɩɩlɩ, ŋ́ náa ca kpakpa.»<verse eid="HEB 12:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 12:22" />Ŋnǝ paa we, nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ dutupirǝ we pǝ lóo pwo Ziɔŋ, mǝ Worokoyǝ we ŋ kpii vɔrʊrǝ lǝ tǝŋtǝǝwǝ, Yerusalɛmǝ yǝ we ŋ kpii rǝ yulaarǝ wǝ, fɛɛwǝ we epicoŋpipǝ lafawǝ pakapaka pǝ kpii, wǝ́ pǝ ya pǝ lée ri wǝcɛkpǝ wǝ. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ Worokoyǝ le episǝŋmǝpǝ la wǝcakukpǝ, ŋpǝ epǝ we la anyɩŋyǝ pǝ la ŋʊrʊ rǝ yulaarǝ wǝ. Nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ Worokoyǝ we ŋ ri enyikpǝlo la kpaŋtɛŋtǝyǝ wǝ. Wǝ́ nǝ nya lɛ nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ enyikʊʊpǝ we pǝ lǝ kpǝ́ ǝkǝ pǝ lo to milimili wǝ. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ Yesu. Ŋwǝ Yesu ŋ ri tatǝyǝ rǝ dieŋwɛŋrǝ we Worokoyǝ ŋ na parǝ mǝ lǝ ŋ nǝ tǝnǝ wǝ. Wǝ́ nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ na ŋpǝrayǝ we ŋ lʊ̀ ǝkǝ ŋ náa wɛɛlɩ sɩsiɛrɩ ŋpa mǝ ŋ teeri Abɛlǝ la nɛŋyǝ wǝ. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Kǝto nǝ yee yurǝ, nǝ pǝǝ sǝ́ŋ kǝtukoŋcokǝ rǝ nyiyǝ we ŋ ya ŋ náa wɛɛlɩ mǝ nǝ wǝ! Duturǝ ɖi mǝŋ epǝ we pǝ sǝ́nǝ pǝ loo co kǝtukoŋkǝ rǝ yǝ we ŋ ka ŋ wɛɛlɩ mǝ ŋ tíi pǝ rǝ kǝtǝǝwǝ pǝ loo koru osuu pǝ cɛ tukoŋtawǝ sa wǝǝ, kǝ ŋlǝ paa, lo po koru osuu la cɛ tukoŋtawǝ sa mǝŋ yǝ la siɛrɩ amaakǝ yǝ la kaa Worokoyǝ we ŋ náa wɛɛlɩ rǝ yulaarǝ mǝ ŋ maŋ lǝ wǝ? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Ŋwǝ yǝ we la kpɛɛwǝ wǝ tìkili kǝtǝǝwǝ rǝ kakawǝ we, ŋwǝ ŋ ya ŋ nóo co lǝ garǝ sa rǝkǝsa ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 12:26">«Ŋ́ nǝ́ǝ tǝ ŋ́ tikili kǝceŋceŋ ke, ŋkǝ kǝtǝǝwǝ ceŋceŋ paa mǝŋ yulaarǝ.»<verse eid="HEB 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 12:27" />«Kǝceŋceŋ ke» wǝ ya wǝ láa kaŋ ǝkǝnǝŋ, otuyǝ we Worokoyǝ ŋ cò we ǝkǝ yǝ lée tikili we, yǝ leh pe tikili kǝ yǝ nǝŋ. Mǝŋkǝsa we, kǝ otuyǝ we yǝ lǝŋ tikili ko yǝ tuuru.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Ŋlǝ we, yǝ láa lɔ gǝŋrǝ rɛ rɛ ŋ nǝŋ koru etikili wǝ. Kǝto we, nǝ pǝ kǝ le ceeni Worokoyǝ, kǝ lǝ fǝ vusuurǝ mǝ wɛɛpɛɛlɩwǝ la sʊma ŋwǝ mǝ wǝlǝkpǝ we wǝ láa ca na kpɛɛwǝ wǝ. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Duturǝ ɖi loh Worokoyǝ sa we, naawǝ rɛ wǝ lée yee otuyǝ pukupuku wǝ́ ŋ ri.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Kǝ́ wǝ́ yǝ lée yee kǝ loh tuwǝ wǝ ca Worokoyǝ la kpɛɛwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Nǝ re nǝ mǝ taa awɛ lǝ kǝǝwǝ mǝŋ apaanʊpǝ kǝtǝ. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Nǝ poo yuu kǝsǝǝlɔkǝ la kpɛɛ. Duturǝ ɖi arɛɛpǝ lǝ kǝsǝǝlɔkǝ kǝto wǝ́ pǝ pǝlǝ pǝ lɔ̀ epicoŋpipǝ lǝ kǝsǝǝkǝ pǝ lee ci wǝ<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 18:18">1Mo 18:18</ref>, <ref loc="GEN 19:13">19:13</ref></char>.</char></note>. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Nǝ mǝ taalǝ okukpɛɛtǝpǝ kǝ atɛŋ ŋnǝ nǝ kpii rǝ wǝkukpɛɛkpǝ we nǝ kʊla mǝ pǝ rǝ. Nǝ mǝ taalǝ enyipǝ we pǝ ya pǝ lée pieeli wǝ, kǝ atɛŋ ŋnǝ wǝ́ pǝ ya pǝ lée pieeli ǝnǝ.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Nyi ri ŋ nyi ŋ kpii dielɔrǝ le nimifiiwǝ ŋpa. Tieyǝ mǝ no nuŋyǝ pǝ ri anʊkɔrǝyǝ pǝ koonu awɛ duturǝ ɖi Worokoyǝ lah pa tɛŋ onuŋruyeetǝpǝ, ofuuyɩɩtǝpǝ mǝ epǝ we pǝ lée yee kǝtienaakǝ la wǝkpaŋkpǝ. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Rǝ nǝ vɔrʊtiirǝ we, sɩkayǝ ŋ paa mwɛɛrɩ nǝ nimirǝ. Nǝ nya faawǝ rǝ tuwǝ we nǝ lǝǝmǝ wǝ. Duturǝ ɖi Worokoyǝ ŋwǝŋwǝ la tɛŋ ǝkǝnǝŋ: «Ow, ŋ́ nǝŋ pa nyarǝ lǝ́ ŋ́ co, ŋ́ nǝŋ pa maa lǝ́ ŋ́ co pwi.» <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Kǝto yǝ lóo koru atɛŋ mǝ turutawǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="HEB 13:6">«Ǝtǝ Woroko ŋ ri yǝ we ŋ nóo toŋ mǝ wǝ,</para>
  <para style="q1" vid="HEB 13:6">ŋ́ nǝŋ po suu tǝrɛ lo vurǝ!</para>
  <para style="q1" vid="HEB 13:6">Kǝ́ wǝ́ nyɩmaasɩyǝ ŋ nóo koru eyee mǝ mǝ?»<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Nǝ taalǝ nǝ eretǝpǝ we pǝ tɛnɩ Worokoyǝ le dierǝ pǝ tìi nǝ wǝ! Nǝ yɩrɩ kǝ́ pǝ tini vɔrʊrǝ pǝ fǝ wǝ́ pǝ pǝlǝ pǝ kpǝ̀ rǝ wǝ, kǝ nǝ karǝ pǝla lɔnuŋrǝ. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yesu Kǝriso lǝŋ cɛkɛlɛ pwi. Kǝ́ ŋ kǝ lǝ eniyǝ nɔ we, kǝ́ ŋ tǝ ŋ lǝ rǝkǝsa wǝǝ, wǝ́ kǝ́ ŋ nǝ́ǝ tǝ mǝ ŋ lǝ kǝkpakǝkpa. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Nǝ paa nyarǝ nǝ wɛ nǝ co nǝ koonu anianiatǝtukaŋyǝ rɛ kpookpoo, yǝ lǝǝrǝ nǝ. Duturǝ ɖi wǝ ponu kǝ la nya okopiyǝ lo ru rǝ lɛsiɛrɩwǝ we Worokoyǝ ŋ ne yee lǝ wǝ. Paa kǝ wǝ pee ri ŋlǝ yǝ la anya okopiyǝ sa yǝ lo ru rǝ ǝkpǝlǝyǝ ko rǝ ekeeriyǝ la kǝtakǝ. Epǝ we pǝ lée yee pǝ ŋ saŋ rǝ ǝkpǝlǝyǝ sa we, pǝ lǝŋ nya tǝrɛ pǝ ru rǝ yǝ pwi<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="ROM 14:2-23">Oro 14:2-23</ref>, <ref loc="1CO 8:8">1Ok 8:8</ref>, <ref loc="COL 2:16-22">Oko 2:16-22</ref>, <ref loc="1TI 4:3">1Ti 4:3</ref></char>.</char></note>. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Ŋlǝ we, lǝ lǝǝmǝ otoolucuukǝ rɛ, wǝ́ gʊŋrǝ laa kpɛɛ goonu Oyudatǝpǝ lo otoolutǝpǝ kǝ pǝ wo tuwǝ we pǝ lo toolu rǝ loh otoolucuukǝ sa wǝ. Duturǝ ɖi ŋpǝ we, pǝ lée yee anǝnɛyǝ rǝ bwiirǝ. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Oyudatǝpǝ lo toolutǝmumuŋyǝ lǝ́ǝ fǝ akɛɛpǝ we pǝ lo toolu la ŋpǝrayǝ mǝ ŋ fii fɛɛkenikeniwǝ le kenikeniwǝ koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ. Paa akɛɛpǝ we pǝ lǝ fǝ pǝ lo toolu we, pǝ láa pɔrʊ pǝ pǝ ŋ ru rǝ tǝŋtǝǝwǝ we pǝ ŋ ko pǝ ŋ tu naawǝ. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Tuwǝ kǝto Yesu ŋwǝ ŋkpɛ we, kǝ ŋ nya fɛɛ ŋ lɛrɩ kǝkpǝŋkǝ ŋ ru rǝ pǝlo oturɔɔrɔɔyǝ saŋ rǝ na ŋpǝrayǝ we, wǝ́ ŋ kpǝ̀ rǝ tǝŋtǝǝwǝ sa la kpaalǝwǝ wǝǝ. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Kǝto we, nǝ pǝ kǝ lo ru rǝ tǝŋtǝǝwǝ sa lo ko ku mǝ ŋwǝ, kǝ la tɛɛnɩ le fii kǝyepukǝ mǝŋ ŋwǝ kǝtǝ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Duturǝ ɖi rǝ kǝtǝǝwǝ sa we, yǝ lǝǝ lǝmǝ fɛɛwǝ rɛ yǝ lée tii kǝ wǝ ri lah nɛŋ kǝkpakǝkpa, paa la ya yǝ láa taa fɛɛwǝ rǝ yulaarǝ yǝ leh pe ke tii rǝ soosowǝ sa wǝ kpii wǝ lǝ́ǝ pǝ wǝ. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Saŋ rǝ Yesu we, nǝ pǝ kǝ lǝ fǝ ǝkǝkǝ mǝŋ toolutuwǝ kǝtǝ lo mǝ koonu Worokoyǝ eni ri ŋ ni. Le reemǝ etieyǝ we yǝ lóo ru rǝ loh nyuŋkpǝ yǝ ŋ kǝ na nyɩŋrǝ wǝ. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Nǝ poo yukpɛ wǝceeceeyeekpǝ mǝ awɛ lo otoŋkǝ la kpɛɛ. Duturǝ ɖi otoolutuyǝ sa yǝ láa ca Worokoyǝ la kpɛɛwǝ wǝ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Nǝ co kǝtukoŋkǝ rǝ nǝ eretǝpǝ kǝ nǝ pɛɛlɩ nǝ koonu pǝ, duturǝ ɖi ŋpǝ pǝ lǝ́ǝ rǝŋ nǝ wǝrukpǝ eni ri ŋ ni kpiikǝ ŋpǝ pǝ leh ke yee akʊŋtayǝ pǝ ru rǝ nǝ pǝ koonu Worokoyǝ wǝ. Kǝto we, nǝ koonu kǝ pǝ ŋ yee kǝnǝnɛkǝ sa mǝ faawǝ, ŋkǝ mǝ anʊmʊkǝ. Mǝŋ ŋkǝ kaa wǝǝ we, wǝ lǝŋ po toŋ nǝ. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu lǝ. Le cii wǝ sɩsiɛrɩ ǝkǝnǝŋ yǝ lǝǝ lǝmǝ tǝrɛ yǝ láa tɔɔ lah wɛ la bɔrǝ. Kpiikǝ yǝ lǝ pǝ́ le re lah wɛ sɩsiɛrɩ rǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ mǝ ŋ ru rǝ nǝ kpǝŋ kpuŋkpuruŋ nǝ mwɛŋ nyuŋkpǝ kǝ ŋ́ nya fɛɛ ŋ́ siɛnɩ ŋ́ pǝ nǝ kpǝŋ kalaŋ.<verse eid="HEB 13:19" /></para>
  <para style="s">Nyuŋmwɛŋwǝ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Wǝtaarǝkpǝ lo Worokoyǝ we la saanǝ loh Kulǝtǝyǝ Yesu lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. Ŋwǝ Yesu ŋ na pa siɛrɩ ŋ ne yee amɛɛpǝ lǝ rǝŋtǝmumuŋyǝ, saŋ rǝ na ŋpǝrayǝ le dieparǝtǝnǝlaalɛɛrǝ we wǝ. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Worokoyǝ ŋ koonu kǝ nǝ koru e mǝ yee otuceeceeyǝ kpǝlo kɩɩkɩ kǝ nǝ nya fɛɛ nǝ yee nǝ kǝǝpǝ́wǝ. Saŋ rǝ Yesu Kǝriso we, Worokoyǝ ŋ yee tuwǝ we wǝ láa ca na kpɛɛwǝ rǝ lǝh mǝrǝ! Yesu Kǝriso ŋ kaamǝ ǝkǝkǝ kǝkpakǝkpa! Amɛnǝ!<verse eid="HEB 13:21" /></para>
  <para style="s">Ecikaŋkǝ mǝ eceenituturukǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Lǝh ǝtǝŋ, ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ nǝ, nǝ taarǝ lɛrǝ nǝ nuŋ oturutatieyǝ sa. Duturǝ ɖi kǝfwɛɛkǝ sa ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ we, kǝ loo koŋ kpaa. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Nǝ ci wǝ ǝkǝnǝŋ pǝ la nyarǝ lah paanʊ Timote pǝ lo co. Vǝ́ lǝ fǝǝlǝ e pe fii we, ŋlǝ mǝ ŋwǝ yǝ lǝ́ǝ pǝ la pa nyɩŋ nǝ. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />Nǝ ceeni nǝ eretǝpǝ we kpǝlo kɩɩkɩ mǝŋ Worokoyǝ lǝ kǝkpǝŋkǝ we kpǝlo kɩɩkɩ. Epǝ we pǝ kpii rǝ Itali pǝ lée ceeni nǝ. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />Worokoyǝ la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ kpǝlo kɩɩkɩ!<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>