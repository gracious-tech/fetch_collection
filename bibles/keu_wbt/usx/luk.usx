<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Luka</para>
  <para style="toc3">Luk</para>
  <para style="toc2">Luka</para>
  <para style="toc1">Luka le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Luka</para>
  <para style="mt2">le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Kǝfwɛɛkǝ sa kǝ ri Dieceeceetatǝrǝ rǝ Dieparǝtǝnǝŋwɛŋrǝ lǝ mǝrǝ. Nyiyǝ rɛ pǝ lóo pwo Luka ŋ na ŋʊrʊ kǝ (Luka 1:3-4, Anǝnɛyeeyǝ 1:1). Ŋwǝ Luka ŋ lɛ̀ ŋ ŋʊ̀rʊ Anǝnɛyeeyǝ la kǝfwɛɛkǝ. Luka ke ri wɛɛcátǝyǝ. Ŋʊ̀rʊ kǝfwɛɛkǝ sa manǝ nyiyǝ rɛ pǝ lóo pwo Tofilǝ mǝ asʊmatǝpǝ we pǝ lee ri Oyudatǝpǝ wǝ. Luka la tɛŋ rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ ǝkǝnǝŋ Oyudatǝpǝ pǝ yà pǝ kǝ ŋ rǝŋ Mesiyayǝ rɛ ŋ pa pɔrʊ pǝ. Ŋwǝ Mesiyayǝ sa lo oŋuŋkǝ wǝ́ oworokokpɛɛnuŋtɛŋtǝpǝ pǝ wɛ̀ɛlɩ pǝ rù rǝ ǝkǝnǝŋ Worokoyǝ ŋ neh pe kpii ŋ maŋ wǝ. Worokoyǝ ke cìi wǝ ǝkǝnǝŋ mǝŋ Mesiyayǝ sa lǝǝ pǝ we, anyɩmaasɩpǝ la vɔrʊrǝ lǝŋ kǝ lǝmǝ duturǝ. Yesu Kǝriso ŋ ri Mesiyayǝ we. Luka la tɛŋ ǝkǝnǝŋ wǝlǝkpǝ we Marɩya ŋ fǝ̀ ŋ rè no wǝkulukpǝ we, wǝ la cɛkɛlɛ mǝ kǝ́ pǝ lée re enyituturupǝ lo wǝkulukpǝ wǝ (Luka 1:26-38). Yesu la anǝnɛyǝ we ŋ pǝlǝ ŋ yeli yǝ kaamǝ ǝyǝ ǝnǝ: Ka ŋ kaŋ enyipǝ lo otuyǝ mǝ ŋ ru rǝ Worokoyǝ la alɔkuŋkǝ, ka ŋ taa enyipǝ lǝ kǝǝwǝ, ka ŋ cá anyaatǝpǝ, wǝ́ ŋ ke ŋ yee otucovurǝ (Luka 13:10-17, Luka 14:1-6). Paape Oyudatǝmumuŋpǝ pǝ yili pǝ tɛ̀ɛ rǝ ŋwǝ ŋpa, wǝ́ pǝ kpàa ŋwǝ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ (Luka 23:26-49). Paape juutatǝrǝ we, wǝ́ Worokoyǝ ŋ sàanǝ ŋwǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ (Luka 24). Wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ no otukarǝtǝpǝ mǝ enyipʊŋpwapǝ kpɛŋ wǝ́ ŋ ci ǝpǝlǝ ŋ ka ŋ rɛ yulaarǝ rǝ Worokoyǝ lǝ kpǝŋ (<char style="xt"><ref loc="LUK 19:29-41">Luk 19:29-41</ref>, <ref loc="LUK 22:1-6">22:1-6</ref>,<ref loc="LUK 22:39-71">39-71</ref></char>).</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-4</para>
  <para style="io">- Yowanɛsɩ worokomɛŋwiiritǝyǝ we mǝ Yesu lǝ ǝmǝkǝ 1:5–2:52</para>
  <para style="io">- Yowanɛsɩ worokomɛŋwiiritǝyǝ we la anǝnɛyeeyǝ 3:1-20</para>
  <para style="io">- Yesu lo worokomɛŋwiiriwǝ mǝ ne etieyɩrɩkǝ 3:21–4:13</para>
  <para style="io">- Yesu la anǝnɛyeeyǝ rǝ enyikpǝlo la kǝnyɩŋkǝ rǝ Galileya 4:14–9:50</para>
  <para style="io">- Yesu la gʊŋsaŋrǝ ru rǝ Galileya ko Yerusalɛmǝ 9:51–19:27</para>
  <para style="io">- Yesu le ecituturuyǝ coŋ koonu nǝ ǝkpǝ́kǝ 19:28–23:56</para>
  <para style="io">- Yesu la assaanǝkǝ mǝ na wɛ la apɔrʊkaŋkǝ 24:1-53</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Tofilǝ, otuyǝ rɛ yǝ pǝlǝ rǝ lǝh mǝrǝ. Wǝ́ enyipǝ pǝ fǝ̀ pǝ tɛ̀ɛ rǝ pǝla wɛ, wǝ́ pǝ ŋʊ̀rʊ yǝ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Wǝ́ ŋpǝ enyipǝ sa pǝ tɛnɩ otuyǝ we mǝŋ kǝ́ epǝ we pǝ nyɩnɩ ŋyǝ otuyǝ sa lǝ kǝsǝŋkǝ pǝ pɔ̀ lǝ yǝla amayǝ kǝtǝ. Enyipǝ we pǝ nyɩnɩ otuyǝ we lǝ kǝsǝŋkǝ pǝ kaamǝ epǝ we Worokoyǝ ŋ nǝ fǝ kǝnǝnɛkǝ ŋ ne kpii rǝ akaakǝ kǝ pǝ pa tɛŋ ne dierǝ wǝ. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Kǝto ŋmǝ ŋkpɛ ŋ́ nǝ pǝ́ otuyǝ sa yǝ pǝlǝ ǝrǝ kǝsǝŋkǝ lo yurǝ ŋ́ no nuŋ sɩsiɛrɩ. Kulǝtǝyǝ Tofilǝ, ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ wǝ kaamǝ kǝ ŋ́ ŋʊrʊ otuyǝ sa rǝ tɛɛ rǝ tɛɛ ŋ́ maŋ lǝ́, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />kǝ a nya fɛɛ a nyɩŋ anʊkɔrǝyǝ we yǝ kpii rǝ otuyǝ we pǝ la kaŋ lǝ́ e ci.<verse eid="LUK 1:4" /></para>
  <para style="s">Picoŋpiyǝ rɛ la pa tɛŋ Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ lǝ ǝpǝmǝkǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Eniyǝ we Erodɛsɩ ŋ ke ri pilimumuŋyǝ rǝ Yudeya we, toolutǝyǝ rɛ ke kpii. Pǝ lóo pwo ŋwǝ Zakari. Ka kʊla mǝ toolutǝyǝ we pǝ lóo pwo Abiya la wǝcakukpǝ. Zakari le tie wǝ́ pǝ lóo pwo Elizabɛtǝ. Toolutǝmumuŋyǝ we pǝ ko ŋ pwo Arɔŋ le pilepiyǝ wǝ́ Elizabɛtǝ ŋ ke ri. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Pǝle eyi pǝ ke ri enyikʊʊpǝ rǝ Worokoyǝ le enimiyǝ, wǝ́ pǝ ke ŋ yee pǝ ŋ saŋ rǝ Ǝtǝ Woroko le esepǝ kpǝlo kɩɩkɩ mǝ anʊkɔrǝyǝ. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Paape pǝ lǝǝ kǝ lǝmǝ piyǝ. Duturǝ ɖi Elizabɛtǝ lǝǝ kǝ ŋ mǝ, wǝ́ pǝle eyi pǝ lɛ̀ pǝ kùru.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Jirɛɛrǝ Zakari ka ya ke ŋ yee na kǝnǝnɛkǝ rǝ Worokoyǝ lo gukpǝ. Kpiikǝ pǝla wǝcakukpǝ we le eniyeekǝsuŋkǝ yǝ rò. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Kǝ́ wǝ ke kpii wǝ kpɛlɩ rǝ otoolutǝpǝ lǝ kpǝŋ we, pǝ ko ŋ co eciiyǝ, oturu pǝ la pɔrʊ toolutǝyǝ we ŋ neh fii Ǝtǝ Woroko lo gukpǝ ŋ ko tu alifuyǝ la naa ŋ koonu Worokoyǝ. Wǝ́ kǝ́ pǝ lo co eciiyǝ we, wǝ́ wǝ tɔ̀ rǝ Zakari. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Eniyǝ we Zakari ŋ ya ŋ nóo tu alifuyǝ we la naa we, anyɩŋ kǝkpǝŋkǝ kpǝlo kǝ ya kǝ láa mwɛŋ nyuŋkpǝ rǝ Worokoyǝ la nyarǝwǝ le etikeŋtikǝ. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />Wǝ́ Ǝtǝ Worokoyǝ le picoŋpiyǝ rɛ ŋ pǝlǝ ŋ yàa rǝ otoolucuukǝ we pǝ lóo tu alifuyǝ la naa le kǝnirisiɛɛkǝ. Wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Zakari. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Kǝ́ Zakari ŋ na nyɩŋ ŋwǝ we, wǝ́ ŋ lǝ̀ǝ rǝ na wɛ lǝ mǝrǝ. Wǝ́ vurǝ vìi ŋwǝ. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Paape wǝ́ picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Zakari, poo suu vurǝ duturǝ ɖi Worokoyǝ lo nuŋ ló nyuŋmwɛŋwǝ. Lé tie Elizabɛtǝ lée re kǝ ŋ mǝ bǝrǝŋpirǝ ŋ koonu lǝ́, kǝ o mǝ pwo ŋwǝ Yowanɛsɩ. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />A láa nya faamumuŋwǝ rɛ rǝ piyǝ sa lo oŋuŋkǝ, kǝ enyipǝ wa pǝ lɛ pǝ nya faawǝ rǝ nǝ ǝmǝkǝ. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Duturǝ ɖi ŋwǝ piyǝ sa leh pe ri Ǝtǝ Woroko la sʊmatǝyǝ we ŋ no ru okuruyǝ wǝ. Lǝŋ po ŋuŋ vɛŋyǝ amaa ǝfǝŋlɛŋpǝ rɛ kʊrakʊra. Lǝ́ǝ lǝ mǝ Wɛɛkenikenirǝ ǝrǝ ne lee la lɛrǝ kpɛŋ kǝ pǝ ci ǝmǝ ŋwǝ. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Ŋwǝ piyǝ sa ŋ noh po kuŋ kǝ Isǝrayɛlǝtǝpǝ wa pǝ siɛnɩ pǝ pǝ Ǝtǝ Woroko, pǝlo Worokoyǝ lǝ kpǝŋ. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Piyǝ sa lǝh pǝ mǝŋ Worokoyǝ le nyikpiiyǝ kǝtǝ. Wɛɛrǝ we mǝ okopiyǝ we yǝ ke kpii rǝ worokokpɛɛnuŋtɛŋtǝyǝ we pǝ lóo pwo Eliya we, yǝ lée kpii rǝ ŋwǝ piyǝ sa. Lah pa ca ǝtǝpǝ mǝ pǝle epipǝ ŋ kpii rǝ awɛ, kǝ ŋ kuŋ kǝ epǝ we pǝ lǝŋ yee pǝ saŋ rǝ Worokoyǝ le seyǝ pǝ siɛrɩ kǝ pǝ nya fɛɛ pǝ ci otuyǝ. Eniyǝ we pǝ la siɛrɩ pǝ le yee enyikʊʊpǝ, kǝ ŋ kpaka kǝkpǝŋkǝ ŋ tǝnǝ Ǝtǝ Woroko.» <verse eid="LUK 1:17" /><verse number="18" style="v" sid="LUK 1:18" />Wǝ́ Zakari ŋ pǝ̀ picoŋpiyǝ we ǝkǝnǝŋ: «Kǝ́ wǝ́ ŋ́ nǝ́ǝ fǝ ŋ́ nyɩŋ wǝ ŋ́ ci ǝkǝnǝŋ tuwǝ sa kǝceece wǝ lǝǝwe? Duturǝ ɖi lǝ mǝ mǝ tie yǝ lo kuru.» <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />Wǝ́ picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Gabiɛlɩ. Wǝ́ ŋ́ náa yaa rǝ Worokoyǝ le enimiyǝ eni ri ŋ ni mǝ ŋ sʊma ŋwǝ. Ŋwǝ Worokoyǝ ŋ ne kpii mǝ ŋ́ pa wɛɛlɩ mǝ lǝ́, kǝ ŋ́ pe tíi lǝ́ dieceeceerǝ sa. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Otuyǝ sa ŋ́ ne tíi lǝ́ we, yǝ lǝ́ǝ pǝ rǝ eniyǝ we Worokoyǝ ŋ nǝ tǝnǝ wǝ. Paape kǝ́ a laa lɔ mǝ etieyǝ sa o nuŋ kǝto we, e lée yee omumuuyǝ. Ǝ lǝŋ tǝ o koru awɛɛlɩ ko ro ǝrǝ jirǝ we otuyǝ sa yǝ lǝ pǝ wǝ.» <figure style="fig" alt="Le sacrificateur en train de faire le sacrifice sur lʼautel" file="hk00260c.tif" size="col" copy="Horace Knowles" ref="1:8-9">Toolutǝmumuŋyǝ ya lée yee otoolukǝ</figure><verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Rǝ eniyǝ we lǝ mǝrǝ we, anyɩŋ nyikpǝŋwǝ we wǝ ya wǝ lǝ́ǝ rǝŋ Zakari. Kǝ́ Zakari ŋ ya ŋ náa panǝ rǝ fɛɛkenikeniwǝ we we, wǝ́ wǝ yeli nyikpǝŋwǝ sa la tǝrɛ. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Kǝ́ Zakari ŋ no po ru we, wǝ́ ŋ yeli omumuuyǝ. Lǝǝ tǝ ko ŋ koru awɛɛlɩ mǝ nyikpǝŋwǝ we. Wǝ́ ŋ ka ŋ kaa mǝ akaakǝ mǝ ŋ kaŋ pǝ rǝ. Wǝ́ pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ la nyɩŋ tǝrɛ rǝ fɛɛkenikeniwǝ we.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Kǝ́ Zakari le eniyeekǝnǝnɛkǝ rǝ Worokoyǝ la nyarǝwǝ yǝ la lɛ we, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko nyarǝwǝ. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Rǝ eciyǝ we la kǝmaakǝ we, wǝ́ ne tie Elizabɛtǝ ŋ rè wǝkulukpǝ. Wǝ́ ŋ ŋwàa na wɛ akɛɛnyɔŋpǝ atʊʊ. Wǝ́ ŋ tìi na wɛ ǝkǝnǝŋ: <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />«Tuwǝ we Ǝtǝ Woroko ŋ ne yee ŋ no koonu mǝ ǝwǝǝ, rǝ eniyǝ we ŋ na taalǝ mǝ wǝ́ ŋ na pɔrʊ mǝ nʊŋsɔɔwǝ rǝ enyipǝ le enimiyǝ».<verse eid="LUK 1:25" /></para>
  <para style="s">Picoŋpiyǝ we pǝ lóo pwo Gabiɛlɩ la pa tɛŋ Yesu lǝ ǝpǝmǝkǝ le tíi Marɩya</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Wǝla kɛɛkʊʊraŋtǝyǝ we, wǝ́ Worokoyǝ ŋ kpìi picoŋpiyǝ we pǝ lóo pwo Gabiɛlɩ ŋ manǝ rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Nazarɛtǝ, rǝ Galileya lǝ gǝŋrǝ. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />Kpìi ŋwǝ rǝ kɔrʊyǝ rɛ pǝ lóo pwo Marɩya, ŋ fee ke ci pǝrǝŋyǝ lǝ kpǝŋ. Pǝ tɔ̀ɔ ŋwǝ pǝ kòonu nyiyǝ rɛ pǝ lóo pwo Yosɛfʊ, ŋ no ru rǝ Davidǝ la nyarǝwǝ. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Kǝ́ picoŋpiyǝ we ŋ ne ke fii Marɩya lǝ kpǝŋ we, wǝ́ ŋ wɛ̀ɛlɩ mǝ ŋwǝ ǝkǝnǝŋ: «Nya faawǝ, Worokoyǝ le yee lǝ́ lɛsiɛrɩwǝ. Ǝtǝ Woroko kpii kʊla mǝ lǝ́.» <verse eid="LUK 1:28" /><verse number="29" style="v" sid="LUK 1:29" />Kǝ́ ŋ no nuŋ etieyǝ sa we, wǝ́ wǝ rili no mumuŋ ŋpa, wǝ́ ŋ yà ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ eceenikǝ sa lo duturǝ ɖi nɛ? <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Wǝ́ picoŋpiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo suu vurǝ, Marɩya, duturǝ ɖi Worokoyǝ le yee lǝ́ lɛsiɛrɩwǝ. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />A lǝŋ nyɩŋ, e lée re wǝkulukpǝ, kǝ ǝ mǝ bǝrǝŋpirǝ, kǝ o mǝ pwo ŋwǝ Yesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Leh pe ri nyimumuŋyǝ rɛ, pǝ loh mǝ pwo ŋwǝ Worokoyǝ ŋ tɛɛ rǝ oŋuŋkǝ le Piyǝ. Ǝtǝ Woroko lǝ́ǝ fǝ ŋwǝ ŋ yee piliyǝ mǝŋ nǝ tǝtǝ Davidǝ kǝtǝ. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Lée tii wǝpilikpǝ kǝkpakǝkpa rǝ Isǝrayɛlǝ kpǝlo. Ne wǝpilirikpǝ wǝ lǝŋ pa lɛ.» <verse eid="LUK 1:33" /><verse number="34" style="v" sid="LUK 1:34" />Wǝ́ Marɩya ŋ pǝ̀ picoŋpiyǝ we ǝkǝnǝŋ: «Tuwǝ sa wǝ lǝ́ǝ pǝ wǝ fǝ nɛ, kpiikǝ ŋ́ fee ci pǝrǝŋyǝ?» <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" />Wǝ́ picoŋpiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wɛɛkenikenirǝ láa sʊʊ rǝ lǝ́, kǝ Worokoyǝ ŋ tɛɛ rǝ oŋuŋkǝ lo okopiyǝ yǝ sii lǝ́ mǝŋ sisiwǝ kǝtǝ. Kǝto, pikenikeniyǝ wǝ́ ǝ lǝ́ǝ mǝ, kǝ pǝ ŋ pwo ŋwǝ Worokoyǝ le Piyǝ. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />A lǝŋ nyɩŋ, ló tuuluyǝ Elizabɛtǝ, wǝ́ pǝ ko ŋ pwo lǝǝmǝtǝyǝ. Lo kuru paape ŋwǝ ŋkpɛ le re bǝrǝŋpirǝ lo wǝkulukpǝ. Wǝ́ ŋ kpii rǝ na kɛɛkʊʊraŋtǝyǝ lǝ mǝrǝ, <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />duturǝ ɖi tǝrɛ wǝ laa lɛnyɩ mǝ Worokoyǝ.» <verse eid="LUK 1:37" /><verse number="38" style="v" sid="LUK 1:38" />Wǝ́ Marɩya ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko la sʊmatǝyǝ wǝ́ ŋ́ ri. Wǝ pǝ wǝ koonu mǝ mǝŋ kǝ́ a la tɛŋ wǝ kǝtǝ.» Wǝ́ picoŋpiyǝ sa ŋ pwɛ̀yɩ rǝ nǝ kpǝŋ.<verse eid="LUK 1:38" /></para>
  <para style="s">Marɩya le siri lo ko Elizabɛtǝ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Wǝla kǝmaakǝ we, wǝ́ Marɩya ŋ yili kalaŋ ŋ ko ŋ ko tǝŋtǝǝwǝ rɛ wǝ kpii rǝ Yudeya lǝ gǝŋrǝ, rǝ otutupiyǝ la gaarǝ. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Kǝ́ ŋ ne ke fii we, wǝ́ ŋ ko ŋ ko Zakari la nyarǝwǝ. Kǝ́ ŋ ne ke fii we, wǝ́ ŋ cèeni Elizabɛtǝ. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Kǝ́ Elizabɛtǝ ŋ na nya ŋ no nuŋ Marɩya le eceenikǝ sa ko we, wǝ́ piyǝ we ŋ rù wɛɛwǝ rǝ na lɛrǝ. Wǝ́ Elizabɛtǝ ŋ lǝ̀ mǝ Wɛɛkenikenirǝ. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Wǝ́ ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ la pɛɛrɩ lǝ́ rǝ etiepǝ lǝ mǝrǝ. Wǝ́ ŋ na lɛ ŋ na pɛɛrɩ piyǝ we lo wǝkulukpǝ e re wǝ! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Kǝ́ wǝ́ ŋmǝ yǝ ŋ́ ri, kǝ mǝ Kulǝtǝyǝ le leeyǝ ŋ pǝ mǝ kpǝŋ? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Duturǝ ɖi kǝ́ ŋ́ na nya ŋ́ no nuŋ e le ceeni mǝ ko we, wǝ́ piyǝ sa ŋ no ru wɛɛwǝ mǝ faawǝ rǝ mǝ lɛrǝ. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Ŋlǝ́ yǝ o lo co yǝ, duturǝ ɖi a la lɔ o lo nuŋ ǝkǝnǝŋ dierǝ we Kulǝtǝyǝ ŋ ne tíi lǝ́ lǝ́ǝ pǝ.»<verse eid="LUK 1:45" /></para>
  <para style="s">Marɩya la nɔŋ lǝ kǝ Worokoyǝ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Wǝ́ Marɩya ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 1:46">«Kǝceece Ǝtǝ Woroko naanǝ ŋpa.<verse eid="LUK 1:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47" />Ŋ́ nǝh kpǝ́ mǝ faawǝ rǝ Worokoyǝ,</para>
  <para style="q1" vid="LUK 1:47">mǝ lɔkuŋtǝyǝ lo yurǝ kǝto.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />Duturǝ ɖi na sʊmatǝyǝ sa ŋ naa lɔ okuruyǝ wǝ́ ŋ́ ri. Paape la taalǝ mǝ.</para>
  <para style="q1" vid="LUK 1:48">Kǝceece fǝ rǝ rǝkǝsa mǝ ko we, wǝmǝkpǝ kpǝlo wǝ láa mǝ tɛŋ ǝkǝnǝŋ ŋmǝ yǝ ŋ́ no co yǝ.<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />Duturǝ ɖi Woroko Kopilǝtǝyǝ le yee otukpatɩyǝ lo koonu mǝ.</para>
  <para style="q1" vid="LUK 1:49">Ǝtǝ Woroko lǝ kenikeni.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Láa nyɩŋ epǝ we pǝ lóo suu ŋwǝ la tǝlarǝwǝ eni ri ŋ ni.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Ǝtǝ Woroko la pɔrʊ no okopiyǝ la kaŋ saŋ rǝ kǝnǝnɛkǝ sa ŋ ne yee wǝ.</para>
  <para style="q1" vid="LUK 1:51">Duturǝ ɖi la caŋ epǝ we pǝ láa rɛɛrɩ mǝ pǝla wɛ rǝ oŋuŋkǝ.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />La sʊʊrʊ mǝ epilipǝ rǝ asaayǝ.</para>
  <para style="q1" vid="LUK 1:52">Wǝ́ ŋ na rɛɛrɩ mǝ epǝ we pǝ láa pɛɛlɩ pǝla wɛ wǝ.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Ǝtǝ Woroko ŋ no koonu atɛŋwʊʊtǝpǝ lo otuceeceeyǝ ŋpa, wǝ́ yǝ lo ro pǝ.</para>
  <para style="q1" vid="LUK 1:53">Ŋwǝ ŋ no co asɩkalǝtǝpǝ la kʊŋ akaakpaakpa.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54-55" style="v" sid="LUK 1:54-55" />Ǝtǝ Woroko la pa lɔ lo koonu na asʊmatǝpǝ, Isǝrayɛlǝ lǝ kǝkpǝŋkǝ.</para>
  <para style="q1" vid="LUK 1:54-55">La taalǝ Abǝrahamǝ mǝ ne epilepipǝ. Wǝ́ ŋ ne yee pǝ le wǝceeceekpǝ kǝkpakǝkpa,</para>
  <para style="q1" vid="LUK 1:54-55">mǝŋ kǝ́ ŋ tɛnɩ ŋ tìi pǝ kǝtǝ.»<verse eid="LUK 1:54-55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Wǝ́ Marɩya ŋ tini rǝ Elizabɛtǝ lǝ kpǝŋ wǝ lóo ro akɛɛnyɔŋpǝ ata. Wǝla kǝmaakǝ wǝ́ ŋ kpǝlǝŋ ŋ ko ŋ ko na fɛɛwǝ.<verse eid="LUK 1:56" /></para>
  <para style="s">Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ lǝ ǝmǝkǝ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Elizabɛtǝ le enimǝyǝ yǝ rò. Wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Kǝ́ na anyarǝlɛɛrɩtǝpǝ mǝ no otuulupǝ pǝ lo nuŋ ǝkǝnǝŋ Ǝtǝ Woroko le yee Elizabɛtǝ le wǝceeceemumuŋkpǝ rɛ we, wǝ́ pǝ yà pǝ ka ŋ nya faawǝ pǝ ŋ kʊla mǝ ŋwǝ. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />Kǝ́ pǝ lǝ mǝ piyǝ sa lo juunɛŋtǝrǝ we, wǝ́ pǝ pǝlǝ pǝ pǝ kǝǝlǝ ŋwǝ. Wǝ́ pǝ kǝ ŋ pǝ́ pǝ fǝ nǝ tǝ Zakari la nyɩŋrǝ pǝ kpii ŋwǝ. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Paape wǝ́ piyǝ we le leeyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ow, pǝ loh mǝ pwo ŋwǝ Yowanɛsɩ». <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Wǝ́ enyipǝ we pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Rɛ lee kpii ŋ ne ri nyɩŋrǝ sa rǝ nǝ gbǝŋrǝ ǝnǝ». <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Wǝ́ pǝ kǝ ŋ pǝ́ nǝ tǝ Zakari mǝ akaakǝ ǝkǝnǝŋ: «Nɛ wǝ́ ǝ lǝ pǝ́ pǝ ŋ pwo le piyǝ sa?» <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Wǝ́ Zakari ŋ tìi pǝ mǝ akaakǝ ǝkǝnǝŋ pǝ taa ɖurǝ pǝ láa ŋʊrʊ otuyǝ pǝ ŋ tɛɛ pǝ koonu ŋwǝ. Wǝ́ ŋ ŋʊ̀rʊ ǝkǝnǝŋ: «Na nyɩŋrǝ ɖi Yowanɛsɩ». Wǝ́ tuwǝ sa wǝ yeli enyipǝ we kpǝlo la tǝrɛ. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Rǝ kǝyaakǝ we, wǝ́ Zakari la kǝraakpakǝ kǝ sàanǝ. Wǝ́ ŋ ka ŋ wɛɛlɩ mǝ ŋ kǝ Worokoyǝ. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Wǝ́ vurǝ vìi na anyarǝlɛɛrɩtǝpǝ kpǝlo. Wǝ́ epǝ we pǝ ke kpii rǝ Yudeya lo otutupiyǝ we la gaarǝ kpǝlo kɩɩkɩ pǝ ka ŋ wɛɛlɩ pǝ ŋ ru rǝ otuyǝ sa kpǝlo. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Vǝ́ nyi ri ŋ nyi la nya lo nuŋ otuyǝ sa ko oturu ya lóo pu yurǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: «Nyiyǝ rǝ fǝŋ kǝtǝŋ wǝ́ piyǝ sa ŋ nǝh pǝ ŋ pe ri?» Duturǝ ɖi Ǝtǝ Woroko la akaakǝ kǝ ka tɛ̀ɛ rǝ ŋwǝ.<verse eid="LUK 1:66" /></para>
  <para style="s">Zakari la nɔŋ lǝ kǝ Worokoyǝ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Wǝ́ piyǝ we lǝ tǝ Zakari ŋ lǝ̀ mǝ Wɛɛkenikenirǝ, wǝ́ ŋ ka ŋ wɛɛlɩ mǝŋ worokokpɛɛnuŋtɛŋtǝyǝ kǝtǝ. Ka ŋ tɛŋ ǝkǝnǝŋ:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />«Ǝtǝ Woroko, Isǝrayɛlǝ lo Worokoyǝ kaamǝ ǝkǝkǝ.</para>
  <para style="q1" vid="LUK 1:68">Duturǝ ɖi la pa lɔ lo koonu nǝ kǝkpǝŋkǝ, wǝ́ ŋ na pɔrʊ pǝ.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />La maŋ lǝ Lɔkuŋtǝyǝ ŋ lǝǝmǝ okopiyǝ.</para>
  <para style="q1" vid="LUK 1:69">Lo ru rǝ na sʊmatǝyǝ Davidǝ la nyarǝwǝ.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Saŋ rǝ na Akpɛɛnuŋtɛŋtǝkenikenipǝ lo oŋuŋkǝ wǝ́ ŋ tɛnɩ tuwǝ sa ŋ tǝnǝ ǝrǝ gakarǝ ǝkǝnǝŋ<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />ŋwǝ Lɔkuŋtǝyǝ sa láa pɔrʊ lǝ rǝ lǝh ǝkǝǝkpǝlǝtǝpǝ</para>
  <para style="q1" vid="LUK 1:71">mǝ epǝ we kpǝlo kɩɩkɩ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ yee mǝ lǝ turɔɔrɔɔwǝ la akaakǝ.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Kǝ́ Ǝtǝ Woroko, ŋ yeli wǝceeceekpǝ ŋ kòonu lǝh ǝtǝtǝpǝ wǝǝ.</para>
  <para style="q1" vid="LUK 1:72">Wǝ́ ruŋruŋ le jirǝ ke, loo yuu diekenikenirǝ we ŋpǝ mǝ Abǝrahamǝ pǝ pàrǝ pǝ tǝ̀nǝ la kpɛɛ.<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />Duturǝ ɖi Ǝtǝ Woroko tù tìi lǝh tǝtǝ Abǝrahamǝ ǝkǝnǝŋ<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />vǝ́ ŋ na pɔrʊ lǝ rǝ lǝh ǝkǝǝkpǝlǝtǝpǝ la akaakǝ ŋ na lɛ we,</para>
  <para style="q1" vid="LUK 1:74">ŋ nóo koonu, kǝ la nya fɛɛ la sʊma ŋwǝ vu lee kpii.<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />Eniyǝ we yǝ láa siɛrɩ yǝ le yee enyikenikenipǝ mǝ enyikʊʊpǝ rǝ</para>
  <para style="q1" vid="LUK 1:75">ŋwǝ Ǝtǝ Woroko le enimiyǝ rǝ lah vɔrʊrǝ le eciyǝ kpǝlo kɩɩkɩ.»<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Wǝ́ Zakari ŋ tǝ tɛnɩ ǝkǝnǝŋ: «Ŋlǝ́ mǝ pi, Ǝtǝ Woroko ŋ tɛɛ rǝ oŋuŋkǝ</para>
  <para style="q1" vid="LUK 1:76">la kpɛɛnuŋtɛŋtǝyǝ wǝ́ e leh pe ri. Duturǝ ɖi o lóo coŋ o koonu Kulǝtǝyǝ Yesu, kǝ o po toolu na akʊŋyǝ.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Kǝ o po kuŋ kǝ nǝ kǝkpǝŋkǝ kǝ ci wǝ ǝkǝnǝŋ</para>
  <para style="q1" vid="LUK 1:77">ŋwǝ Ǝtǝ Woroko lo furu ŋ pǝ fǝ pǝlo oturɔɔrɔɔyǝ ŋ cɛɛ pǝ, kǝ ŋ pɔrʊ pǝ.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Loh Worokoyǝ la lɛsiɛrɩwǝ wǝ naanǝ ŋpa.</para>
  <para style="q1" vid="LUK 1:78">Na lɛsiɛrɩwǝ sa wǝ lóo kuŋ kǝ oŋuŋkǝ la wǝnyɩɩnɩkpǝ wǝ nyɩnɩ wǝ koonu lǝ mǝŋ cɔkɔŋpoŋyǝ kǝtǝ.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />Wǝnyɩɩnɩkpǝ sa wǝ láa nyɩnɩ wǝ koonu epǝ we pǝ kpii rǝ nuŋtumuwǝ wǝ́ pǝ ya pǝ lóo suu gbɛŋrǝ lo vurǝ wǝ.</para>
  <para style="q1" vid="LUK 1:79">Wǝnyɩɩnɩkpǝ sa wǝ lée re lǝ wǝ saŋ rǝ wǝtaarǝkpǝ la gʊŋrǝ.»<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Wǝ́ Yowanɛsɩ ŋ ka ŋ naanǝ, wǝ́ ŋ pǝlǝ ŋ lɛ̀nyɩ rǝ wɛɛrǝ mǝrǝ. Ke kpii rǝ fɛɛwǝ rɛ wǝ lǝǝ kǝlǝ mǝ tǝŋtǝǝwǝ, po ro eniyǝ we ŋ pǝlǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Isǝrayɛlǝtǝpǝ.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Yesu lǝ ǝmǝkǝ</para>
  <para style="r">(<ref loc="MAT 1:18-25">Matewu 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Rǝ eniyǝ we lǝ mǝrǝ wǝ́ pilimumuŋyǝ Kayizaro Ogusio ŋ pɔ̀rʊ seyǝ ŋ rù ǝkǝnǝŋ pǝ kǝ enyipǝ rǝ ǝrǝkǝ kpǝlo<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Rǝ gakarǝ we, ǝrǝkǝ kpǝlo kǝ ka kaamǝ Roma lǝ gǝŋrǝ mǝ ǝkǝŋtuturuyǝ we yǝ ke kpii rǝ Roma lǝ kǝnǝŋkǝ wǝ.</char></note>. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Eniyǝ we Kureni ŋ ke ri piliyǝ rǝ Siri lǝ gǝŋrǝ<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Siri lǝ gǝŋrǝ ga kʊla mǝ ǝkǝŋyǝ we yǝ ke kpii rǝ Roma lǝ kǝnǝŋkǝ.</char></note> wǝ́ pǝ yeli kǝnyikǝsǝsǝŋkǝ sa. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Nyi ri ŋ nyi ko ŋ ko mǝ ŋ ŋʊrʊ nyɩŋrǝ rǝ ŋwǝŋwǝ nǝ tǝŋtǝǝwǝ. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />Wǝ́ Yosɛfʊ ŋwǝ ŋkpɛ ŋ rù rǝ Nazarɛtǝ lǝ tǝŋtǝǝwǝ rǝ Galileya ŋ kolu Davidǝ lǝ tǝŋtǝǝwǝ we pǝ lóo pwo Bɛtǝlɛhɛmǝ rǝ Yudeya. Duturǝ ɖi Davidǝ lǝ pilepiyǝ wǝ́ ŋ ri. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Ŋpǝ mǝ ne tietɔɔyǝ Marɩya pǝ kolu pǝ ka ŋʊrʊ nyɩŋrǝ. Marɩya ke re wǝkulukpǝ. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Pǝ kǝ tǝ pǝ kpii rǝ Bɛtǝlɛhɛmǝ, wǝ́ ŋ pǝlǝ ŋ ko ŋ roonu. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Wǝ́ ŋ mǝnǝ nǝ bǝrǝŋpisǝsǝŋrǝ. Wǝ́ ŋ fǝ̀ tukpɛɛwǝ ŋ mùlu ŋwǝ. <figure style="fig" alt="Jésus dans une crèche avec Marie et Joseph" file="Nt11b.jpg" size="col" copy="The Art of Reading" ref="2:7">Marɩya lo mulu Yesu le kpii rǝ tukpiiakɛɛpǝ le keeriwǝ lǝ mǝrǝ</figure>Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kpɛ̀ɛlɩ rǝ tukpiiakɛɛpǝlekeeriwǝ lǝ mǝrǝ, kpiikǝ pǝ laa nya fɛɛwǝ pǝ koonu pǝ rǝ fɛɛlɔǝsǝǝpǝ.<verse eid="LUK 2:7" /></para>
  <para style="s">Worokoyǝ le picoŋpiyǝ la ka tɛŋ Yesu lǝ ǝmǝkǝ le tíi amɛɛrǝŋtǝpǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Amɛɛrǝŋtǝpǝ rɛ pǝ ke kpii rǝ gaarǝ we. Pǝ ke ŋ tii dumurǝ pǝ ŋ rǝŋ pǝla akɛɛpǝ rǝ bɔɔrǝ. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Wǝ́ Ǝtǝ Woroko le picoŋpiyǝ rɛ ŋ pǝlǝ ŋ rù rǝ pǝ kǝtǝrǝceŋceŋ, wǝ́ Ǝtǝ Woroko la wǝnyɩɩnɩkpǝ wǝ cò wǝ sìri pǝ. Wǝ́ tuwǝ sa wǝ cò pǝlo vurǝ ŋpa. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Wǝ́ picoŋpiyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ poo su vurǝ, duturǝ ɖi ŋ́ nǝ pǝ ŋ́ pe tíi nǝ dieceeceerǝ rɛ, wǝ lée ri faamumuŋwǝ rɛ wǝ koonu kǝkpǝŋkǝ kpǝlo. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Pǝ lǝ mǝ Lɔkuŋtǝyǝ rɛ pǝ lo koonu nǝ ruŋruŋ rǝ David lǝ tǝŋtǝǝwǝ, ŋwǝ ŋ ri Kǝriso Kulǝtǝyǝ. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Tuwǝ sa wǝ́ nǝ nyǝ́ǝ fǝ nǝ nyɩŋ ŋwǝ nǝ ci, nǝ nyáa nyɩŋ piŋwɛŋyǝ rɛ pǝ lǝ fǝ tukpɛɛwǝ pǝ lo mulu, wǝ́ pǝ lǝ fǝ ŋwǝ, pǝ la kpɛɛlɩ rǝ tukpiiakɛɛpǝlekeeriwǝ lǝ mǝrǝ.» <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />Kǝtǝrǝceŋceŋ ko, wǝ́ Worokoyǝ le epicoŋpipǝ lǝ kpǝŋmumuŋwǝ rɛ wǝ pǝlǝ wǝ tùu picoŋpiyǝ sa mǝ anɔŋyǝ, wǝ́ pǝ kǝ ŋ kǝ Worokoyǝ ǝkǝnǝŋ:<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />«Ǝkǝkǝ kǝ ri lá kǝ nɛŋ Worokoyǝ rǝ yulaarǝ,</para>
  <para style="q1" vid="LUK 2:14">kǝ wǝtaarǝkpǝ wǝ pǝ rǝ kǝtǝǝwǝ wǝ koonu enyipǝ we Worokoyǝ ŋ náa taa kǝǝwǝ».<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Kǝ́ epicoŋpipǝ we pǝ la pwɛyɩ rǝ pǝlǝ kpǝŋ pǝ la tɛlɩ yulaarǝ we, wǝ́ amɛɛrǝŋtǝpǝ sa pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Nǝ pǝ kǝ lo ko Bɛtǝlɛhɛmǝ kǝ la ka nyɩŋ tuwǝ we wǝ lǝ pǝ wǝ, tuwǝ sa Ǝtǝ Woroko ŋ na pɔrʊ ŋ na kaŋ lǝ wǝ.» <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />Wǝ́ pǝ yili pǝ ko ŋ ko kalaŋkalaŋ, wǝ́ pǝ kolu pǝ nyɩnɩ Marɩya, Yosɛfʊ mǝ piŋwɛŋyǝ we ŋ kpɛlɩ rǝ tukpiiakɛɛpǝlekeeriwǝ lǝ mǝrǝ. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Kǝ́ pǝ la nyɩŋ ŋwǝ pǝ la lɛ we, wǝ́ pǝ fǝ̀ etieyǝ we kpǝlo picoŋpiyǝ we ŋ na tɛŋ ŋ no ru rǝ piyǝ we, pǝ tɛnɩ. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Wǝ́ wǝ rili enyipǝ we kpǝlo pǝ yà pǝ ko ŋ nuŋ amɛɛrǝŋtǝpǝ sa le etieyǝ lo mumuŋ. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Marɩya ŋwǝ paa we, yà ka ŋ lɔ etieyǝ sa kpǝlo mǝ ŋ kpii rǝ yurǝ, wǝ́ ŋ ko ŋ pu yurǝ mǝ ŋ ru rǝ yǝ. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Wǝ́ amɛɛrǝŋtǝpǝ we pǝ sìɛnɩ pǝ ko ŋ ko, wǝ́ pǝ ka ŋ nɔŋ pǝ ŋ kǝ Worokoyǝ, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: Worokoyǝ naanǝ, rǝ tuwǝ we pǝ lo nuŋ wǝ́ pǝ la nyɩŋ kǝto. Duturǝ ɖi, tuwǝ we pǝ la pa nyɩŋ wǝ kaa rǝ mǝ dierǝ we picoŋpiyǝ we ŋ tìi pǝ wǝ.<verse eid="LUK 2:20" /></para>
  <para style="s">Pǝ lǝ kǝǝlǝ piyǝ we wǝ́ pǝ le kpii na nyɩŋrǝ ǝkǝnǝŋ Yesu</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Kǝ́ pǝ lǝ mǝ ŋwǝ lo juunɛŋtǝrǝ wǝ́ piyǝ sa le enikǝǝlǝyǝ yǝ rò, wǝ́ pǝ kpìi na nyɩŋrǝ ǝkǝnǝŋ Yesu mǝŋ kǝ́ picoŋpiyǝ ŋ pwò ŋ tǝ̀nǝ kpɛŋ kǝ pǝ pe re no wǝkulukpǝ wǝ.<verse eid="LUK 2:21" /></para>
  <para style="s">Pǝ la pɔrʊ Yesu pǝ la kaŋ rǝ Worokoyǝ la nyarǝwǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Rǝ wǝla kǝmaakǝ wǝ́ eniyǝ yǝ rò kǝ Yosɛfʊ mǝ Marɩya pǝ ke yee ewiikǝ lo kǝsuŋkǝ mǝŋ kǝ́ Mose le seyǝ ŋ na tɛŋ wǝ wǝ. Wǝ́ pǝ fǝ̀ piyǝ sa pǝ kolu Yerusalɛmǝ kǝ pǝ ka pɔrʊ ŋwǝ pǝ kaŋ Ǝtǝ Woroko, <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />kpiikǝ pǝ la ŋʊrʊ rǝ Ǝtǝ Woroko le seyǝ lǝ mǝrǝ ǝkǝnǝŋ: «Bǝrǝŋpi ri ŋ bǝrǝŋpi ɖi pisǝŋmǝyǝ we, pǝ lǝ́ǝ fǝ ŋwǝ pǝ koonu Ǝtǝ Woroko.» <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Yosɛfʊ mǝ Marɩya pǝ kolu Yerusalɛmǝ kǝ pǝ ke yee otoolukǝ mǝŋ kǝ́ Ǝtǝ Woroko le seyǝ ŋ na tɛŋ wǝ kǝtǝ, pǝ lóo koonu: «Olootopǝ eyi amaa otookpaapipǝ eyi.» <verse eid="LUK 2:24" /><verse number="25" style="v" sid="LUK 2:25" />Rǝ eniyǝ we lǝ mǝrǝ we, kɛrɩyǝ rɛ ke kpii rǝ Yerusalɛmǝ pǝ lóo pwo ŋwǝ Simewɔŋ, nyikʊʊyǝ wǝ́ ŋ ke ri wǝ́ ŋ ka ŋ sʊma Worokoyǝ ŋpa. Kǝ ŋ rǝŋ ŋ pa nyɩŋ yǝ we ŋ nǝh pǝ ŋ pa ta Isǝrayɛlǝ lo turuwǝ, wǝ́ Wɛɛkenikenirǝ ge kpii rǝ ŋwǝ. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Wɛɛkenikenirǝ bɔ̀rʊ ganǝ ŋwǝ ǝkǝnǝŋ láa nyɩŋ Ǝtǝ Woroko la Lɔkuŋtǝyǝ kpɛŋ kǝ ŋ ci ǝ kpǝ́. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Wǝ́ Wɛɛkenikenirǝ vǝ̀ ŋwǝ go ŋ ko Worokoyǝ la nyarǝwǝ. Kǝ́ Yosɛfʊ mǝ Marɩya pǝ lǝ fǝ Yesu, piŋwɛŋyǝ sa pǝ loh ko pǝ ke yee kǝsuŋkǝ we Worokoyǝ le seyǝ ŋ na tɛŋ pǝ koonu ŋwǝ we, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Wǝ́ Simewɔŋ ŋ lɔ̀ ŋwǝ ŋ rè mǝ wǝkaakpǝ wǝ́ ŋ cèeni Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: <verse eid="LUK 2:28" /><verse number="29" style="v" sid="LUK 2:29" />«Ǝtǝ Woroko, rǝkǝsa we, o lóo koru ama la sʊmatǝyǝ ŋ kpǝ́ mǝ ŋ ko rǝ wǝtaarǝkpǝ lǝ mǝrǝ mǝŋ kǝ́ a la tɛŋ wǝ kǝtǝ. <verse eid="LUK 2:29" /><verse number="30" style="v" sid="LUK 2:30" />Kpiikǝ ŋ́ na nyɩŋ lá alɔkuŋkǝ mǝ mǝ enimiyǝ. <verse eid="LUK 2:30" /><verse number="31" style="v" sid="LUK 2:31" />A la kpaka alɔkuŋkǝ sa ǝ lǝ tǝnǝ rǝ wǝkpǝŋkpǝ kpǝlo la kǝnyɩŋkǝ, <verse eid="LUK 2:31" /><verse number="32" style="v" sid="LUK 2:32" />Alɔkuŋkǝ sa kǝ ri wǝnyɩɩnɩkpǝ wǝ láa pɔrʊ lǝ́ wǝ kaŋ epǝ we pǝ lee ri Oyudatǝpǝ, wǝ́ kǝ láa lɛ kǝ kuŋ Isǝrayɛlǝ, lǝ́ kǝkpǝŋkǝ kǝ ru nyɩŋrǝ.» <verse eid="LUK 2:32" /><verse number="33" style="v" sid="LUK 2:33" />Tuwǝ sa Simewɔŋ ŋ tɛnɩ ŋ rù rǝ piyǝ sa lo oŋuŋkǝ wǝ rili nǝ tǝ mǝ ne lee lo mumuŋ. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Wǝ́ Simewɔŋ ŋ pɛ̀ɛrɩ pǝ, wǝ́ ŋ tìi piyǝ sa le lee Marɩya ǝkǝnǝŋ: «Yɩrɩ re, piyǝ sa kpii koonu enyipǝ wa la atɔɔkǝ mǝ enyipǝ wa le eyiyaakǝ rǝ Isǝrayɛlǝ. Lah pa pɔrʊ Worokoyǝ lo otuyǝ ŋ kaŋ paape enyipǝ pǝ lée yi pǝ tɛɛ rǝ ŋwǝ. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Lóo kuŋ kǝ pǝ nya fɛɛ pǝ nyɩŋ enyipǝ wa lo oyupuyǝ we yǝ la ŋwaa pǝ ci. Ŋlǝ́ paa we, wǝ lǝ́ǝ fǝrǝ lǝ́ ǝrǝ lǝ́ mǝrǝ mǝŋ kǝ́ pǝ lo tu lǝ́ tʊkʊwǝ kǝtǝ.» <verse eid="LUK 2:35" /><verse number="36" style="v" sid="LUK 2:36" />Tieyǝ rɛ ke kpii, ŋwǝ ŋkpɛ ke ri worokokpɛɛnuŋtɛŋtǝyǝ, pǝ lóo pwo ŋwǝ Ana. Faniɛlǝ ŋ no ru rǝ Asɛrǝ la nyarǝwǝ la kɔrʊyǝ ŋ lǝǝwe. Tieyǝ sa kùru ŋpa. Cà wǝnuŋkpǝ rǝ na kǝkɔsɔkɔrʊkǝ wǝ́ ŋpǝ mǝ no nuŋ pǝ kpìi pǝ tini cɛŋwǝ pɩrɩmata. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Wǝla kǝmaakǝ wǝ́ ŋ yeli kpeetieyǝ, wǝ́ ŋ pǝlǝ ŋ ka ŋ lɔ cɛŋwǝ tǝnɛŋ mǝ niǝ. Loo ko ŋ ru rǝ Worokoyǝ la nyarǝwǝ, ka ŋ sʊma Worokoyǝ mǝŋ dumu mǝŋ jɔkɔŋ. Ka ŋ parǝ nyuŋkpǝ wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Eniyǝ we tutu wǝ́ tieyǝ sa ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ rù, wǝ́ ŋ yà ŋ kǝ ŋ kǝ Worokoyǝ. Wǝ́ ŋ yà ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ piyǝ sa mǝ ŋ tíi epǝ we kpǝlo pǝ kǝ ŋ rǝŋ Worokoyǝ ŋ pɔrʊ Yerusalɛmǝ wǝ.<verse eid="LUK 2:38" /></para>
  <para style="s">Yosɛfʊ mǝ Marɩya pǝ lǝ kpǝlǝŋ pǝ lo ko Nazarɛtǝ, Yesu la kǝlaatiekǝ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Kǝ́ Yosɛfʊ mǝ Marɩya pǝ le yee tu ri ŋ tu Ǝtǝ Woroko le seyǝ ŋ na tɛŋ pǝ la lɛɛ we, wǝ́ pǝ kpǝ̀lǝŋ pǝ ko ŋ ko pǝlǝ tǝŋtǝǝwǝ Nazarɛtǝ wǝ kpii rǝ Galileya lǝ gǝŋrǝ. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Wǝ́ piyǝ sa ŋ ka ŋ naanǝ, wǝ́ ŋ kǝ lǝǝmǝ okopiyǝ. Kǝ lǝǝmǝ otuciyǝ wǝ́ Worokoyǝ la lɛsiɛrɩwǝ wǝ ka tɛɛ rǝ ŋwǝ.<verse eid="LUK 2:40" /></para>
  <para style="s">Yesu la lɔ cɛŋ tǝ mǝ yi wǝ́ ŋ no ko Worokoyǝ la nyarǝwǝ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Cɛŋ ri cɛŋ Yesu lǝ tǝ mǝ ne lee pǝ ko ŋ ko Yerusalɛmǝ pǝ ŋ ko pǝ ŋ ri eyinyapǝkǝ la wǝcɛkpǝ<note caller="+" style="f"><char style="fr" closed="false">2:41 </char><char style="ft" closed="false">Eyinyapǝkǝ la wǝcɛkpǝ wǝ ri Isǝrayɛlǝtǝpǝ la wǝcɛkpǝ pǝ lǝ́ǝ fǝ pǝ ŋ taalǝ jirǝ we Worokoyǝ ŋ pɔ̀rʊ pǝ ŋ rù rǝ Ejipǝte wǝ.</char></note>. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Kǝ́ Yesu ŋ na lɔ cɛŋ tǝ mǝ yi we, wǝ́ pǝ rè ŋwǝ pǝ kolu wǝcɛkpǝ sa rǝ Yerusalɛmǝ mǝŋ kǝ́ pǝ lée ce pǝ ŋ yee wǝ kǝtǝ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Kǝ́ wǝcɛkpǝ sa le eciyǝ yǝ la lɛ we, wǝ́ pǝ kpìi pǝ kpǝ̀lǝŋ. Wǝ́ Yesu ŋ lɔ̀ ŋ tini rǝ Yerusalɛmǝ nǝ tǝ mǝ ne lee pǝ lee ci wǝ. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Pǝ ko ŋ pu wǝ ǝkǝnǝŋ Yesu sìimǝ pǝlǝ ǝtǝŋ akʊŋsaŋtǝpǝ kǝto, wǝ́ pǝ sanǝ jirǝ jeŋceŋ kpɛŋ wǝ́ pǝ ci ekpii pǝ ka ŋ taa ŋwǝ rǝ pǝlo otuulupǝ mǝ pǝle enyicipǝ lǝ kpǝŋ. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Kǝ́ pǝ la taa pǝ laa nyɩŋ ŋwǝ we, wǝ́ pǝ kpìi pǝ kpǝ̀lǝŋ pǝ tàa ŋwǝ pǝ ko ŋ ko Yerusalɛmǝ. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Juutatǝrǝ wǝ́ pǝ kolu pǝ ka ŋ nyɩŋ ŋwǝ rǝ Worokoyǝ la nyarǝwǝ tini rǝ otukaŋtǝpǝ le kǝtiitiikǝ lóo co kǝtukoŋkǝ rǝ pǝ, wǝ́ ŋ kǝ ŋ pǝ́ pǝle etieyǝ. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Epǝ we kpǝlo kɩɩkɩ pǝ yà pǝ ko ŋ nuŋ ne etieyǝ we, wǝ rili pǝlo mumuŋ rǝ no otuciyǝ mǝ ne eciatɛŋkǝ kǝto. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Kǝ́ nǝ tǝ mǝ ne lee pǝ la nyɩŋ ŋwǝ we, wǝ́ wǝ rili pǝlo mumuŋ, wǝ́ ne lee ŋ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Mǝ pi, kǝ́ kǝto wǝ́ e le yee mǝ lǝ ǝnǝ? Ŋlǝ mǝ lǝ́ tǝ yǝ la taa lǝ́ yǝ lǝh kpǝ́ mǝ kǝǝnǝwǝ.» <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Wǝ́ ŋ kpǝ̀lǝŋ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyáa taa mǝ wǝ? Nǝ nyee ci wǝ ǝkǝnǝŋ wǝ kaamǝ kǝ ŋ tii rǝ mǝ tǝ la nyarǝwǝ?» <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Paape pǝ loo nuŋ tuwǝ sa ŋ tìi pǝ lo duturǝ. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />Wǝ́ Yesu ŋ yili ŋ sìimǝ pǝ ŋ ko ŋ ko Nazarɛtǝ, ko ŋ nuŋ pǝlo tutɛŋwǝ. Ne lee lɔ̀ɔ otuyǝ sa kpǝlo kɩɩkɩ kpìi rǝ yurǝ. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Wǝ́ Yesu ŋ ka ŋ naanǝ wǝ́ no otuciyǝ yǝ ka ŋ ta yǝ ŋ kpii. No tuwǝ wǝ ko ponu mǝ Worokoyǝ mǝŋ enyipǝ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yowanɛsɩ worokomɛŋwiiritǝyǝ lo worokoŋtietɛŋrǝ</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matewu 3:1-12</ref>, <ref loc="MRK 1:1-8">Marǝko 1:1-8</ref>, <ref loc="JHN 1:19-28">Yowanɛsɩ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Eniyǝ we Tibero Kayizaro ŋ ke ri pilimumuŋyǝ la cɛŋ tǝ mǝ tʊʊtǝwǝ we, anyɩŋ Pɔŋto Pilato ke ri kǝŋyɩrɩtǝyǝ rǝ Yudeya. Erodɛsɩ ke ri piliyǝ rǝ Galileya. Na paanʊ Filipo ke ri piliyǝ rǝ Iture mǝ Tǝrakonitidǝ. Wǝ́ Lizania ŋ ke ri piliyǝ rǝ Abilɛnǝ lǝ gǝŋrǝ. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Eniyǝ we Ana mǝ Kayifa pǝ ke ri otoolutǝmumuŋpǝ we, wǝ́ Worokoyǝ ŋ wɛ̀ɛlɩ mǝ Zakari le pi Yowanɛsɩ rǝ nyɔŋkpaakǝtǝǝwǝ. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Wǝ́ Yowanɛsɩ ŋ kolu ǝtǝŋtǝǝyǝ we yǝ kpii rǝ kpanǝwǝ we pǝ lóo pwo Yɔrǝdaŋ la gaarǝ. Wǝ́ ŋ ka ŋ tɛŋ mǝ ŋ tíi enyipǝ ǝkǝnǝŋ: «Nǝ cɛkɛlɛ vɔrʊrǝ, nǝ kuŋ kǝ pǝ wiiri nǝ worokomɛŋwǝ, kǝ Worokoyǝ ŋ fǝ nǝ oturɔɔrɔɔyǝ ŋ cɛɛ nǝ.» <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Mǝŋ kǝ́ pǝ la ŋʊrʊ wǝ rǝ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya la kǝfwɛɛkǝ lǝ mǝrǝ ǝkǝnǝŋ: «Nyiyǝ rɛ ya lóo woolu rǝ nyɔŋkpaakǝtǝǝwǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: “Nǝ toolu Ǝtǝ Woroko la gʊŋrǝ. Nǝ kʊʊrʊ na akʊŋpiyǝ. <verse eid="LUK 3:4" /><verse number="5" style="v" sid="LUK 3:5" />Nǝ lǝǝrǝ gbɛnɛŋ ri ŋ gbɛnɛŋ. Nǝ wɔɔ dutupi ri ŋ dutupi. Nǝ kʊʊrʊ akʊŋpiyǝ we yǝ la mɛŋ wǝ, nǝ tɛkʊ akʊŋyǝ we yǝ lǝ pǝlǝ wǝ. <verse eid="LUK 3:5" /><verse number="6" style="v" sid="LUK 3:6" />Eniyǝ we nyi ri ŋ nyi láa nyɩŋ kǝ́ Worokoyǝ ŋ nah pɔrʊ lǝ wǝ.”» <verse eid="LUK 3:6" /><verse number="7" style="v" sid="LUK 3:7" />Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ pǝlǝ kǝ Yowanɛsɩ ŋ wiiri pǝ lo worokomɛŋwǝ. Wǝ́ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Amatakpapǝ rɛ pǝ kpii pǝ láa tɛlɩ, ǝlǝ ŋ ne ci ŋ na kaŋ nǝ ǝkǝnǝŋ ŋnǝ nǝ suu nǝ cɛ Worokoyǝ la kpɛɛmʊrʊwǝ sa wǝ lo furu wǝ? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Rǝkǝsa nǝ nyɩŋ ǝtǝnǝyǝ yǝ láa pɔrʊ yǝ kaŋ ǝkǝnǝŋ ŋnǝ nǝ nya cɛkɛlɛ vɔrʊrǝ, kǝ nǝ pǝǝ tǝ nǝ tíi nǝ wɛ ǝkǝnǝŋ: “Lǝh tǝtǝ ǝrǝ Abǝrahamǝ”. Duturǝ ɖi ŋ́ ya ŋ́ née tíi nǝ wǝ ǝkǝnǝŋ oruyǝ sa nǝ ya nǝ nyáa nyɩŋ we, Worokoyǝ lóo koru asiɛrɩ yǝ ŋ yee Abǝrahamǝ le epilepipǝ. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Pǝ la marǝ pǝ lǝ fǝ kǝsɔɔkǝ pǝ loh nuuru eciiyǝ. Kǝto wǝcii ri ŋ cii wǝ lǝŋ nyɩŋ dǝnǝceeceerǝ we, pǝ lóo co kpǝ, kǝ pǝ tu kpǝ la naa.»<verse eid="LUK 3:9" /></para>
  <para style="s">Tuwǝ we wǝ láa kaŋ ǝkǝnǝŋ nyiyǝ la siɛrɩ na wɛ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Wǝ́ enyipǝ we pǝ kǝ ŋ pǝ́ Yowanɛsɩ ǝkǝnǝŋ: «Rǝkǝsa kǝ́ wǝ́ yǝ lée yee?» <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Yǝ we ŋ lǝǝmǝ wǝkpakpǝ wǝyi we, ŋ fǝ kǝceŋceŋ ŋ koonu yǝ we ŋ nǝǝ lǝmǝ wǝ. Yǝ we ŋ lǝǝmǝ keeriwǝ we, ŋ koonu na kɛrɩyǝ.» <verse eid="LUK 3:11" /><verse number="12" style="v" sid="LUK 3:12" />Wǝ́ alaŋpoolɔtǝpǝ ŋpee pǝ pǝlǝ kǝ Yowanɛsɩ ŋ wiiri pǝ lo worokomɛŋwǝ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, kǝ́ wǝ́ yǝ lée yee?» <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ paa lɔ sɩkayǝ rɛ nǝ teeri yǝ we pǝ le tíi nǝ nǝ lɔ wǝ.» <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />Wǝ́ otuusiitǝpǝ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Wǝ́ ŋlǝ pa, kǝ́ wǝ́ yǝ lée yee?» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ paa lɔ rɛ la sɩkayǝ mǝ okopiyǝ, nǝ paa lɛ nǝ nia nǝ tɛɛ rǝ rɛ. Wǝkɛnyɔŋkpǝ́tookpǝ we nǝ nyáa lɔ we, nǝ fǝ wǝ ǝnǝ.»<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Kǝ́ kǝkpǝŋkǝ we kǝ kǝ ŋ rǝŋ mǝ kpɛɛtɛɛwǝ kǝto we, wǝ́ nyi ri ŋ nyi ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ: Kǝto nyiyǝ sa ŋkǝ Kǝriso ŋ lǝǝwe? <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Wǝ́ Yowanɛsɩ ŋ tìi pǝlo kpǝlo ǝkǝnǝŋ: «Ŋmǝ we, mɛŋwǝ wǝ́ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née wiiri nǝ worokomɛŋwǝ, paape nyiyǝ rɛ lo furu, lɛnyɩ teeri mǝ. Wǝ́ ŋ́ naa kaamǝ kǝ ŋ́ wuru na afʊkpayǝ la aŋwɛɛyǝ. Ŋwǝ nyiyǝ sa lǝ́ǝ fǝ Wɛɛkenikenirǝ mǝ naawǝ ŋ wiiri nǝ worokomɛŋwǝ. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Re waawǝ mǝ akaakǝ ŋ pa fɛɛ apɔɔtuyǝ ŋ pɔrʊ rǝ ekeeripiyǝ lǝ mǝrǝ, kǝ ŋ fǝ ekeeripiyǝ we ŋ ko toolu ŋ tǝnǝ rǝ no wulǝŋwǝ lǝ mǝrǝ, paa kǝ ŋ tu apɔɔtuyǝ we la naa rǝ naawǝ we wǝ lǝŋ rǝŋ lǝ mǝrǝ.» <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Wǝ́ Yowanɛsɩ ŋ tǝ ŋ ka ŋ tɛŋ dieceeceerǝ we mǝ ŋ tíi kǝkpǝŋkǝ sa, wǝ́ ŋ ke ŋ ci mǝ ŋ kaŋ pǝ.<verse eid="LUK 3:18" /></para>
  <para style="s">Pǝ la lɔ Yowanɛsɩ worokomɛŋwiiritǝyǝ we pǝ la taŋ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Wǝ́ Yowanɛsɩ ŋ ka ŋ kpamǝ piliyǝ Erodɛsɩ rǝ Erodia lo yurǝ. Erodia ke ri ne mǝtee Filipo le tieyǝ we ŋ fǝ̀ ŋ lɔ̀ wǝ. Fǝ kʊla mǝ oturɔɔrɔɔpʊŋpwayǝ ŋ yeli wǝ. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Turɔɔrɔɔwǝ lǝ wǝ ŋ tǝ yeli ŋ kʊ̀la wǝ kaamǝ kǝ́ ŋ lɔ̀ Yowanɛsɩ ŋ tanǝ rǝ gukpɛɛkpǝ wǝ.<verse eid="LUK 3:20" /></para>
  <para style="s">Pǝ le wiiri Yesu lo worokomɛŋwǝ</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matewu 3:13-17</ref>, <ref loc="MRK 1:9-11">Marǝko 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Kǝ́ Yowanɛsɩ ŋ ya ŋ née wiiri enyipǝ lo worokomɛŋwǝ we, wǝ́ ŋ wìiri Yesu ŋwǝ ŋkpɛ. Wǝ́ Yesu ŋ yà ŋ ka ŋ mwɛŋ nyuŋkpǝ, wǝ́ yulaarǝ dàanǝ. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ Yesu mǝŋ tookpaayǝ kǝtǝ. Wǝ́ pǝ nunu kpɛɛwǝ rɛ rǝ yulaarǝ ǝkǝnǝŋ: «Ŋlǝ́ e ri mǝ piyǝ ŋ́ náa taa kǝǝwǝ wǝ, ŋ́ ya ŋ́ náa nya faamumuŋwǝ rɛ rǝ ló yurǝ».<verse eid="LUK 3:22" /></para>
  <para style="s">Yesu lǝ ǝtǝtǝpǝ</para>
  <para style="r">(<ref loc="MAT 1:1-17">Matewu 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesu lɔ̀ mǝŋ cɛŋwǝ tǝta, wǝ́ ŋ tìe na kǝnǝnɛkǝ. Ke ri Yosɛfʊ le piyǝ mǝŋ kǝ́ enyipǝ pǝ láa tɛŋ wǝ kǝtǝ. Yosɛfʊ lǝ tǝ ŋ ri Eli, wǝ́ Eli lǝ tǝ ŋ ri Matatǝ. <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Matatǝ lǝ tǝ ŋ ri Levi, wǝ́ Levi lǝ tǝ ŋ ri Mɛlǝki. Mɛlǝki lǝ tǝ ŋ ri Yana, wǝ́ Yana lǝ tǝ ŋ ri Yosɛfʊ. <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Yosɛfʊ lǝ tǝ ŋ ri Matatia, wǝ́ Matatia lǝ tǝ ŋ ri Amosǝ. Amosǝ lǝ tǝ ŋ ri Nawumǝ, wǝ́ Nawumǝ lǝ tǝ ŋ ri Ɛsǝli. Ɛsǝli lǝ tǝ ŋ ri Nagayi, wǝ́ Nagayi lǝ tǝ ŋ ri Mahatǝ. <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Mahatǝ lǝ tǝ ŋwǝ ŋkpɛ ŋ ri Matatia, wǝ́ Matatia lǝ tǝ ŋ ri Simeyi. Simeyi lǝ tǝ ŋ ri Yosɛ, wǝ́ Yosɛ lǝ tǝ ŋ ri Yoda <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Yoda lǝ tǝ ŋ ri Yowana, wǝ́ Yowana lǝ tǝ ŋ ri Resa. Resa lǝ tǝ ŋ ri Zorobabɛlǝ, wǝ́ Zorobabɛlǝ lǝ tǝ ŋ ri Salatiɛlǝ. Salatiɛlǝ lǝ tǝ ŋ ri Neri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />wǝ́ Neri lǝ tǝ ŋwǝ ŋkpɛ ŋ ri Mɛlǝki. Mɛlǝki lǝ tǝ ŋ ri Adi, wǝ́ Adi lǝ tǝ ŋ ri Kosamǝ. Kosamǝ lǝ tǝ ŋ ri Ɛlǝmadamǝ, wǝ́ Ɛlǝmadamǝ lǝ tǝ ŋ ri Era. <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Era lǝ tǝ ŋ ri Yoswa, wǝ́ Yoswa lǝ tǝ ŋ ri Eliazɛrǝ. Eliazɛrǝ lǝ tǝ ŋ ri Yorimǝ, wǝ́ Yorimǝ lǝ tǝ ŋwǝ ŋkpɛ ŋ ri Matatǝ. Matatǝ lǝ tǝ ŋ ri Levi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />wǝ́ Levi lǝ tǝ ŋ ri Simewɔŋ. Simewɔŋ lǝ tǝ ŋ ri Yuda, wǝ́ Yuda lǝ tǝ ri ŋ ri Yosɛfʊ. Yosɛfʊ lǝ tǝ ŋ ri Yonamǝ, wǝ́ Yonamǝ lǝ tǝ ŋ ri Eliakimǝ. <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Eliakimǝ lǝ tǝ ri Meleya, wǝ́ Meleya lǝ tǝ ŋ ri Mena. Mena lǝ tǝ ŋ ri Matata, wǝ́ Matata lǝ tǝ ŋ ri Nataŋ. Nataŋ lǝ tǝ ŋ ri Davidǝ, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />wǝ́ Davidǝ lǝ tǝ ŋ ri Isayi. Isayi lǝ tǝ ŋ ri Obɛdǝ, wǝ́ Obɛdǝ lǝ tǝ ŋ ri Bowazǝ. Bowazǝ lǝ tǝ ŋ ri Sala, wǝ́ Sala lǝ tǝ ŋ ri Nasɔŋ. <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Nasɔŋ lǝ tǝ ŋ ri Aminadabǝ, wǝ́ Aminadabǝ lǝ tǝ ŋ ri Adǝminǝ. Adǝminǝ lǝ tǝ ŋ ri Ani, wǝ́ Ani lǝ tǝ ŋ ri Ɛsǝrɔŋ. Ɛsǝrɔŋ lǝ tǝ ŋ ri Perɛzǝ, wǝ́ Perɛzǝ lǝ tǝ ŋ ri Yuda. <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yuda lǝ tǝ ŋ ri Yakɔbǝ, wǝ́ Yakɔbǝ lǝ tǝ ŋ ri Isakǝ. Isakǝ lǝ tǝ ŋ ri Abǝrahamǝ, wǝ́ Abǝrahamǝ lǝ tǝ ŋ ri Tara. Tara lǝ tǝ ŋ ri Nakɔrǝ, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />wǝ́ Nakɔrǝ lǝ tǝ ŋ ri Serukǝ. Serukǝ lǝ tǝ ŋ ri Rago, wǝ́ Rago lǝ tǝ ŋ ri Falɛkǝ. Falɛkǝ lǝ tǝ ŋ ri Ebɛrǝ, wǝ́ Ebɛrǝ lǝ tǝ ŋwǝ ŋkpɛ ŋ ri Sala. <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Sala lǝ tǝ ŋ ri Kayɩna, wǝ́ Kayɩna lǝ tǝ ŋ ri Afadǝ. Afadǝ lǝ tǝ ŋ ri Semǝ, wǝ́ Semǝ lǝ tǝ ŋ ri Nowa. Nowa lǝ tǝ ŋ ri Lamɛkǝ, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />wǝ́ Lamɛkǝ lǝ tǝ ŋ ri Metusela. Metusela lǝ tǝ ŋ ri Enɔkǝ, wǝ́ Enɔkǝ lǝ tǝ ŋ ri Yarɛtǝ. Yarɛtǝ lǝ tǝ ŋ ri Malele, wǝ́ Malele lǝ tǝ ŋwǝ ŋkpɛ ŋ ri Kayɩna. <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kayɩna lǝ tǝ ŋ ri Enɔsǝ, wǝ́ Enɔsǝ lǝ tǝ ŋ ri Seeti. Seeti lǝ tǝ ŋ ri Adamǝ, wǝ́ Adamǝ lǝ tǝ ŋ ri Worokoyǝ.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Satana le tie Yesu la yɩrɩ</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matewu 4:1-11</ref>, <ref loc="MRK 1:12-13">Marǝko 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Rǝkǝsa kǝ́ Yesu ŋ nǝ lǝ mǝ Wɛɛkenikenirǝ we, wǝ́ ŋ pwɛ̀yɩ rǝ kpanǝwǝ we pǝ lóo pwo Yɔrǝdaŋ. Wǝ́ Wɛɛkenikenirǝ vǝ̀ ŋwǝ go ŋ ko nyɔŋkpaakǝtǝǝwǝ. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Fɛɛwǝ we wǝ́ Abʊŋsamʊyǝ ŋ kolu ŋ ke ŋ tie ŋwǝ mǝ ŋ yɩrɩ juu tǝniǝ wɩlɩwɩlɩ. Yesu lee ke ŋ ri tǝrɛ rǝ eciyǝ we lǝ mǝrǝ. Kǝ́ eciyǝ we yǝ la lɛ we, wǝ́ kǝtɛŋkǝ kǝ ka ŋ wʊ ŋwǝ. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Wǝ́ Abʊŋsamʊyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ e ri Worokoyǝ le Piyǝ we, tíi ɖurǝ sa ziɛrɩ yee keeriwǝ». <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ ŋkǝ keeriwǝ ko wǝ́ nyɩmaasɩyǝ ŋ née tii vɔrʊrǝ ŋ koonu». <verse eid="LUK 4:4" /><verse number="5" style="v" sid="LUK 4:5" />Wǝ́ Abʊŋsamʊyǝ ŋ fǝ̀ Yesu ŋ rùu ŋ rɛ̀ oŋuŋkǝ, wǝ́ ŋ pɔ̀rʊ kǝtǝǝwǝ lǝ ǝkǝŋyǝ kpǝlo ŋ kanǝ ŋwǝ rǝ enipiyǝ rɛ lǝ mǝrǝ <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ fǝ ǝkǝŋyǝ sa lo okopiyǝ kpǝlo mǝ yǝlo otulǝmǝyǝ kpǝlo ŋ koonu lǝ́, duturǝ ɖi pǝ lǝ fǝ otuyǝ sa kpǝlo pǝ le kpii mǝ rǝ akaakǝ, wǝ́ ŋ́ nóo koru ǝfǝ yǝ ŋ́ koonu nyiyǝ we ŋ ponu mǝ mǝ wǝ. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Mǝŋ a la sʊʊ a la kʊŋ mǝ wǝ́ a la sʊma mǝ we, tu ri ŋ tu wǝ láa siɛrɩ wǝ yee lá nɛŋ.» <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ la ŋʊrʊ ǝkǝnǝŋ: “Ǝtǝ Woroko ló Worokoyǝ wǝ́ a láa pɛɛlɩ o koonu. Ŋwǝ ceŋceŋ ko wǝ́ a láa sʊma.”» <verse eid="LUK 4:8" /><verse number="9" style="v" sid="LUK 4:9" />Wǝ́ Abʊŋsamʊyǝ ŋ fǝ̀ Yesu ŋ ko ŋ ko Yerusalɛmǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kolu ŋ tɛ̀ɛ rǝ Worokoyǝ la nyarǝwǝ lo oŋuŋkǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ e ri Worokoyǝ le Piyǝ we, kpa e yi rǝ fɛɛwǝ sa a ka tɔɔ rǝ kǝtǝǝwǝ. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Duturǝ ɖi pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ Worokoyǝ lée tíi ne epicoŋpipǝ pǝ pǝ rǝŋ lǝ́, <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />kǝ pǝ lɛ pǝ lɔ lǝ́ pǝ re mǝ pǝla wǝkaakpǝ, kǝ lá kǝkparǝkǝ kǝ paa nya fɛɛ kǝ kpara mǝ ɖurǝ rɛ.» <verse eid="LUK 4:11" /><verse number="12" style="v" sid="LUK 4:12" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ la ŋʊrʊ rǝ Worokoŋtierǝ mǝrǝ ǝkǝnǝŋ: “Pee tie Ǝtǝ Woroko, ló Worokoyǝ a yɩrɩ.”» <verse eid="LUK 4:12" /><verse number="13" style="v" sid="LUK 4:13" />Kǝ́ Abʊŋsamʊyǝ ŋ na lɛ nǝ ǝkpǝǝyǝ we kpǝlo kɩɩkɩ ŋ ke ŋ kpii Yesu we, wǝ́ ŋ ce ŋ pwɛ̀yɩ rǝ nǝ kpǝŋ.<verse eid="LUK 4:13" /></para>
  <para style="s">Yesu le tie na anǝnɛyǝ rǝ Galileya</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matewu 4:12-17</ref>, <ref loc="MRK 1:14-15">Marǝko 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Wǝ́ Yesu ŋ sìɛnɩ ŋ kǝ ŋ pǝ Galileya mǝ Wɛɛkenikenirǝ lo okopiyǝ. Wǝ́ na nyɩŋrǝ dò kpoo rǝ gǝŋrǝ we. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Wǝ́ ŋ ka ŋ kaŋ otuyǝ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ mǝŋ tɛlɩ, wǝ́ nyi ri ŋ nyi ŋ kǝ ŋ kǝ ŋwǝ.<verse eid="LUK 4:15" /></para>
  <para style="s">Pǝ lǝ sǝŋ Yesu le dierǝ rǝ Nazarɛtǝ</para>
  <para style="r">(<ref loc="MAT 13:54-58">Matewu 13:54-58</ref>, <ref loc="MRK 6:1-6">Marǝko 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Wǝ́ ŋ pǝlǝ Nazarɛtǝ, tǝŋtǝǝwǝ sa wǝ́ ŋ ne tíi ŋ na naanǝ. Kǝ́ sabatǝyǝ le jirǝ lo ro we, wǝ́ ŋ kolu Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ mǝŋ kǝ́ ŋ ne ce mǝ ŋ yee wǝ kǝtǝ, wǝ́ ŋ yili ŋ yàa ŋ kǝ otuyǝ. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Wǝ́ pǝ fǝ̀ worokokpɛɛnuŋtɛŋtǝyǝ we pǝ lóo pwo Ezaya la kǝfwɛɛkǝ pǝ kòonu ŋwǝ. Wǝ́ ŋ wùru kǝfwɛɛkǝ we, wǝ́ ŋ nyɩnɩ fɛɛwǝ we pǝ la ŋʊrʊ ǝkǝnǝŋ: <verse eid="LUK 4:17" /><verse number="18" style="v" sid="LUK 4:18" />«Ǝtǝ Woroko la Wɛɛrǝ dɛɛ rǝ mǝ, duturǝ ɖi Worokoyǝ la pɔrʊ mǝ, kǝ ŋ́ pa tɛŋ Worokoŋtierǝ ŋ tíi ariariatǝpǝ. Le kpii mǝ, kǝ ŋ pe tíi okukpɛɛtǝpǝ ǝkǝnǝŋ pǝ la nyarǝ pǝ pǝ lo co. Kǝ ŋ́ po wuru alaanyɩŋtǝpǝ le enimiyǝ, kǝ ŋ́ po kuŋ enyipǝ we pǝ le si pǝ la maarǝ le diiwɛɛrǝ. <verse eid="LUK 4:18" /><verse number="19" style="v" sid="LUK 4:19" />Kǝ ŋ́ pa tɛŋ ŋ́ tíi enyipǝ ǝkǝnǝŋ eniyǝ we Worokoyǝ ŋ neh yee enyipǝ la wǝsiɛrɩkpǝ yǝ lo ro.» <verse eid="LUK 4:19" /><verse number="20" style="v" sid="LUK 4:20" />Wǝ́ Yesu ŋ pìri kǝfwɛɛkǝ sa, wǝ́ ŋ fǝ̀ kǝ ŋ koonu nyiyǝ we ŋ nóo toŋ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ wǝ, wǝ́ ŋ sɔ̀ ŋ tini. Wǝ́ nyi ri ŋ nyi rǝ gukpǝ we ŋ tɔ̀ enimiyǝ ŋ ka ŋ yɩrɩ Yesu pʊrɩpʊrɩ. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Wǝ́ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Dierǝ sa nǝ nyo nuŋ ŋ́ nǝ kǝ we, lǝ pǝ ruŋruŋ.» <verse eid="LUK 4:21" /><verse number="22" style="v" sid="LUK 4:22" />Wǝ́ nyi ri ŋ nyi ŋ ka ŋ wɛɛlɩ sɩsiɛrɩ mǝ ŋ ru rǝ Yesu. Wǝ́ etieceeceeyǝ we Yesu ŋ yà ŋ ka ŋ tɛŋ yǝ rili nyi ri ŋ nyi lo mumuŋ, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Mǝŋkǝ Yosɛfʊ le piyǝ ŋ lǝǝwe?» <verse eid="LUK 4:22" /><verse number="23" style="v" sid="LUK 4:23" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ cii wǝ, nǝ nyǝ́ǝ pǝ́ nǝ ca mǝ duturǝ ǝkǝnǝŋ wɛɛcatǝyǝ, ŋlǝ́ŋlǝ́ cá lá wɛ. Yǝ lo nuŋ otuyǝ we kpǝlo e le yee rǝ Kapɛrǝnawumǝ lǝ tǝŋtǝǝwǝ, kǝto yee ŋyǝ otuyǝ we ke rǝ lǝ́ tǝŋtǝǝwǝ rǝ ɖǝǝnǝ. <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Ŋ́ ya ŋ́ née tíi nǝ wǝ kǝceece, worokokpɛɛnuŋtɛŋtǝyǝ rɛ lee kpii ŋ nóo ko nǝ gǝŋrǝ, kǝ pǝ lɔ ŋwǝ sɩsiɛrɩ pwi. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Ŋ ya ŋ́ née tíi nǝ wǝ kǝceece, rǝ Eliya le eniyǝ we ŋʊŋtɛyǝ ŋ nǝǝ tǝ ŋ kǝ ŋ pǝ, cɛŋwǝ ta mǝ akɛɛnyɔŋpǝ akʊraŋ, wǝ́ kǝtɛŋmumuŋkǝ rɛ kǝ fìi gǝŋrǝ kpǝlo we, ekpeetiepǝ pǝ ke kpii rǝ Isǝrayɛlǝ. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Worokoyǝ lee kpii Eliya ŋ ko pǝla rɛ lǝ kpǝŋ, paa wǝ́ ŋ kpìi ŋwǝ ŋ kolu kpeetieyǝ rɛ lǝ kpǝŋ, rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Sarɛpǝta rǝ Zidoŋ lǝ gǝŋrǝ. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Enyikuurupǝ pǝ ka naanǝ rǝ Isǝrayɛlǝ rǝ Elisa le eniyǝ, Worokoyǝ laa cá rɛ ŋ ri rɛ rǝ pǝlǝ mǝrǝ, paape wǝ́ ŋ kolu ŋ cá Siri tǝ nyiyǝ rɛ pǝ lóo pwo Naamanǝ.» <verse eid="LUK 4:27" /><verse number="28" style="v" sid="LUK 4:28" />Kǝ́ enyipǝ sa pǝ lo nuŋ Yesu le etieyǝ sa we, wǝ́ pǝlo kpǝlo pǝ fǝ̀ kpɛɛmʊrʊwǝ rǝ gumwɛŋnyuŋkpǝ we. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Wǝ́ pǝ yili pǝ tìini Yesu pǝ rù rǝ tǝŋtǝǝwǝ we lǝ mǝrǝ, wǝ́ pǝ fǝ̀ ŋwǝ pǝ ko ŋ ko dutupirǝ we pǝ la tɔ Nazarɛtǝ lo oŋuŋkǝ, kǝ pǝ nya fɛɛ pǝ tu ŋwǝ kǝ ŋ ru rǝ dutupirǝ we lo oŋuŋkǝ ŋ pa tɔɔ. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Paape wǝ́ Yesu ŋ sanǝ ŋ fìi rǝ enyipǝ we mǝrǝ, wǝ́ ŋ pwɛyɩ ŋ ko ŋ ko.<verse eid="LUK 4:30" /></para>
  <para style="s">Yesu le piri wɛɛrɔɔrɔɔrǝ rǝ nyiyǝ rɛ lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MAT 7:28-29">Matewu 7:28-29</ref>, <ref loc="MRK 1:21-28">Marǝko 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Wǝ́ Yesu ŋ kolu Kapɛrǝnawumǝ, rǝ Galileya lǝ gǝŋrǝ. Wǝ́ ŋ kolu ŋ ka ŋ kaŋ enyipǝ lo otuyǝ mǝ sabatǝyǝ le jirǝ. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Wǝ́ Yesu lo otukaŋyǝ sa yǝ rili enyipǝ lo mumuŋ, duturǝ ɖi okopiyǝ yǝ ke kpii rǝ Yesu le etieyǝ we lǝ mǝrǝ ŋpa. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />Wɛɛrɔɔrɔɔrǝ ge kpii rǝ nyiyǝ rɛ lǝ mǝrǝ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ we, wǝ́ nyiyǝ sa ŋ lɔ̀ɔ narǝwǝ kelele: <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />«Keyi! Nazarɛtǝtǝ Yesu, kǝ́ wǝ́ a ya láa taa rǝ lǝh kpǝŋ? Ǝ lǝ pǝ e pe piri lǝ ǝ lǝǝrǝ rǝ. Ŋ́ cii nyiyǝ we kǝtǝŋkǝ e ri wǝ, Worokoyǝ le Nyikenikeniyǝ.» <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />Wǝ́ Yesu ŋ fanǝ wɛɛrɔɔrɔɔrǝ we ǝkǝnǝŋ: «Rǝŋ yiriri, kǝ a tɛlɩ o ru rǝ nyiyǝ sa lǝ mǝrǝ.» Wǝ́ nyiyǝ we ŋ rù ŋ tɔ̀ɔ rǝ pǝle kǝtiitiikǝ, wǝ́ wɛɛrɔɔrɔɔrǝ we ɖù rǝ ŋwǝ, lee yee mǝ no turɔɔrɔɔwǝ rɛ. <verse eid="LUK 4:35" /><verse number="36" style="v" sid="LUK 4:36" />Wǝ́ vurǝ vìi nyi ri ŋ nyi, wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Kǝ́ le dierǝ lǝmǝ ɖǝ? Láa fáŋ awɛɛrɔɔrɔɔyǝ mǝ okopiyǝ oturu yǝ lo ru.» <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Wǝ́ Yesu la nyɩŋrǝ dò kpoo rǝ gaarǝ we kpǝlo.<verse eid="LUK 4:37" /></para>
  <para style="s">Yesu la cá enyipǝ</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matewu 8:14-17</ref>, <ref loc="MRK 1:29-34">Marǝko 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Kǝ́ Yesu ŋ na pwɛyɩ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ we, wǝ́ ŋ ko ŋ ko Sɩmɔ la nyarǝwǝ. A nyɩŋ Sɩmɔ lo nutǝtieyǝ ya lǝ́ǝ fǝrǝ ŋpa, láa rɛ naawǝ pʊrɩpʊrɩ, wǝ́ enyipǝ pǝ ka ŋ tɔɔ pǝ ŋ kpɛɛ Yesu ŋ cá ŋwǝ. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Wǝ́ Yesu ŋ rùu ŋ kǝ̀lǝ mǝ tieyǝ we, wǝ́ ŋ fanǝ nyarǝpirǝ we, wǝ́ nyarǝpirǝ we lɛ̀. Wǝ́ tieyǝ we ŋ yili rǝ kɔɔwǝ we, wǝ́ ŋ lɔ̀ pǝ lǝ kǝsǝǝkǝ. <verse eid="LUK 4:39" /><verse number="40" style="v" sid="LUK 4:40" />Wǝla ɖiɔrǝ we, wǝ́ enyipǝ we pǝ kǝ lǝǝmǝ anyaatǝpǝ pǝ fǝ̀ pǝ pǝ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ ŋ ka ŋ tɛɛ pǝ la aka mǝ ŋ cá pǝ. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Wǝ́ awɛɛrɔɔrɔɔyǝ ŋyǝ ŋkpɛ yǝ ko ŋ ru rǝ anyaatǝpǝ wa, wǝ́ yǝ ka ŋ lɔ anarǝyǝ ǝkǝnǝŋ: «Worokoyǝ le piyǝ wǝ́ e ri.» Wǝ́ Yesu ŋ ka ŋ fáŋ awɛɛrɔɔrɔɔyǝ sa, loo ko ŋ kuŋ yǝla kʊŋwǝ kǝ yǝ wɛɛlɩ, duturǝ ɖi awɛɛrɔɔrɔɔyǝ sa yǝ ke cii wǝ ǝkǝnǝŋ Yesu ŋ ri Kǝrisoyǝ.<verse eid="LUK 4:41" /></para>
  <para style="s">Yesu la tɛŋ Worokoŋtierǝ rǝ Galileya lǝ gǝŋrǝ</para>
  <para style="r">(<ref loc="MRK 1:35-39">Marǝko 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Kǝ́ kǝ la kaalǝ we, wǝ́ Yesu ŋ yili ŋ kolu fɛɛwǝ rɛ enyipǝ pǝ lǝǝ kǝlǝ wǝ. Wǝ́ nyikpǝŋwǝ wǝ ya wǝ ka ŋ taa ŋwǝ. Kǝ́ pǝ lo ko tuu ŋwǝ we, wǝ́ pǝ pǝ̀ pǝ lɔ ŋwǝ pǝ tǝnǝ kǝ ŋ paa nya fɛɛ ŋ pwɛyɩ ŋ maa pǝ. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Paape wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ kaamǝ kǝ ŋ́ ko ǝtǝŋtǝǝpʊŋpwayǝ ŋ́ ka tɛŋ Worokoyǝ le wǝpilirikpǝ le Dieceeceerǝ we ŋ́ tɛlɩ, duturǝ ɖi tuwǝ Worokoyǝ ŋ ne kpii mǝ ŋ́ pe yee wǝǝ.» <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Wǝ́ ŋ ka ŋ tɛŋ Worokoŋtierǝ mǝ ŋ tɛlɩ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ rǝ Yudeya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yesu la siɛrɩ asafʊcotǝpǝ le yee no otukarǝtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Jirɛɛrǝ, Yesu ka yaa rǝ Genezarɛtǝ lo puŋkɔwǝ<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Genezarɛtǝ lo puŋkɔwǝ wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Galileya lo puŋkɔwǝ.</char></note> la kǝlɛɛrɩkǝ, wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ pǝlǝ wǝ kù rǝ ŋwǝ sisi kǝ pǝ nuŋ Worokoŋtierǝ. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Wǝ́ ŋ nyɩnɩ akʊrɔyǝ eyi yǝ kpɛlɩ rǝ puŋkɔwǝ we la kǝlɛɛrɩkǝ. Asafʊcotǝpǝ we pǝ lo ru rǝ yǝ pǝ la ka ya pǝ láa wɛ pǝla asafʊpǝ. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Wǝ́ Yesu ŋ kolu ŋ fìi akʊrɔyǝ sa le jeŋceŋ lǝ mǝrǝ. Sɩmɔ la nɛŋrǝ gǝ lǝǝwe, wǝ́ Yesu ŋ tìi Sɩmɔ ŋ po tu gʊrɔrǝ sa ŋ ru ŋ fii mɛŋwǝ lǝ mǝrǝ tɩpɩrɩ. Wǝ́ ŋ sɔ̀ ŋ tini rǝ gʊrɔrǝ we lǝ mǝrǝ, wǝ́ ŋ ka ŋ kaŋ enyipǝ we lo otuyǝ. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />Kǝ́ ŋ na wɛɛlɩ ŋ na lɛ we, wǝ́ ŋ tìi Sɩmɔ ǝkǝnǝŋ: «Ruu o ko buŋrǝ la fɛɛwǝ, kǝ nǝ ko co nǝ asafʊpǝ rǝ we, kǝ nǝ lɔ wǝpwɛɛkpǝ.» <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />Wǝ́ Sɩmɔ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, yǝ le yee anǝnɛyǝ dumurǝ sa kpǝlo kɩɩkɩ, yǝ laa lɔ tǝrɛ, paape saŋ rǝ lé dierǝ sa kǝto ŋ́ nóo ko ŋ́ ko co.» <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Wǝ́ pǝ cò pǝla asafʊpǝ, wǝ́ pǝ lɔ̀ wǝpwɛɛmumuŋkpǝ rɛ ŋpa. Wǝ́ pǝla asafʊpǝ we pǝ ka ŋ laarǝ. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Wǝ́ pǝ pwò pǝlǝ ǝtǝŋpǝ mǝ akaakǝ pǝ manǝ, rǝ gʊrɔrǝ lǝ ɖǝǝni, kǝ pǝ po toŋ pǝ. Wǝ́ pǝ pǝlǝ pǝ tùu pǝ, wǝ́ pǝ lǝ̀ǝrǝ akʊrɔyǝ we yǝle eyi pwɩpwɩ mǝ wǝpwɛɛkpǝ, wǝ́ yǝ kǝ ŋ pǝ kʊraa yǝ nǝŋ. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Kǝ́ Sɩmɔ Pɛtǝro ŋ na nyɩŋ tuwǝ sa we, wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ Yesu, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ Yesu, ruu o ru rǝ mǝ kpǝŋ, duturǝ ɖi turɔɔrɔɔyeetǝyǝ wǝ́ ŋ́ ri.» <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Vurǝ vìi Sɩmɔ mǝŋ enyipǝ we kpǝlo pǝ ka kʊla mǝ ŋwǝ, rǝ wǝpwɛɛmumuŋkpǝ sa pǝ la lɔ kǝto. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Vurǝ vìi Zebede le epipǝ sa ŋpee: Yakubu mǝ Yowanɛsɩ. Ŋpǝ pǝ ke rì Sɩmɔ lǝ ǝtǝŋpǝ. Wǝ́ Yesu ŋ tìi Sɩmɔ ǝkǝnǝŋ: «Poo su vurǝ. Fǝ rǝ ruŋruŋ mǝ ko we, anyɩmaasɩpǝ wǝ́ a lah mǝ pɔrʊ.» <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Kǝ́ pǝ lo ru mǝ akʊrɔyǝ sa pǝ lǝ pǝ tǝnǝ rǝ dǝǝtǝǝrǝ we, wǝ́ pǝ màa pǝlo otuyǝ kpǝlo kɩɩkɩ pǝ cò, wǝ́ pǝ sìimǝ Yesu pǝ ko ŋ ko. <figure style="fig" alt="Pierre et ses compagnons attrapent beaucoup de poissons et demandent de lʼaide" file="WA03818b.tif" size="col" copy="Graham Wade" ref="5:7">Pɛtǝro mǝ nǝ ǝtǝŋpǝ pǝ la lɔ wǝpwɛɛkpǝ ŋpa wǝ́ pǝ lo pwo enyipǝ pǝ po toŋ pǝpǝ</figure><verse eid="LUK 5:11" /></para>
  <para style="s">Yesu la cá nyikuuruyǝ rɛ</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matewu 8:1-4</ref>, <ref loc="MRK 1:40-45">Marǝko 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Jirɛɛrǝ Yesu ke kpii rǝ tǝŋtǝǝwǝ rɛ, wǝ́ nyiyǝ rɛ ŋ ne fii nyarǝpimwɛɛrɩrǝ ŋ pǝlǝ ŋ rù rǝ ŋwǝ. Kǝ́ ŋ na nyɩŋ Yesu we, wǝ́ ŋ pǝlǝ ŋ kʊnʊ ŋwǝ kǝtukǝ kǝ tɔ̀ rǝ kǝtǝǝwǝ wǝ́ ŋ kpìi na dɔɔkpɛɛrǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ wǝ ponu mǝ lǝ́ we, o lóo koru aca mǝ.» <verse eid="LUK 5:12" /><verse number="13" style="v" sid="LUK 5:13" />Wǝ́ Yesu ŋ kòonu kǝnukǝ wǝ́ ŋ rùu ŋwǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ ponu mǝ mǝ, kpaa!» Rǝ kǝyaakǝ we, wǝ́ nyarǝpimwɛɛrɩrǝ we jɛ̀ rǝ ŋwǝ. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Wǝ́ Yesu ŋ kpìi seyǝ ŋ kòonu ŋwǝ ǝkǝnǝŋ: «Paa tɛŋ wǝ e tíi rɛ ŋ ri rɛ, paa mǝ ko, kǝ fǝ lá wɛ a kaŋ toolutǝyǝ kǝ o koonu otuyǝ we Mose ŋ na tɛŋ pǝ kuŋ wǝ, kǝ wǝ nya fɛɛ wǝ ri ɖaŋsieyǝ wǝ koonu pǝ». <verse eid="LUK 5:14" /><verse number="15" style="v" sid="LUK 5:15" />Wǝ́ Yesu ŋ tǝ ŋ ko ŋ ru nyɩŋrǝ mǝ ŋ kʊla rǝ. Wǝ́ wǝkpǝŋmumuŋkpǝ rɛ wǝ kǝ ŋ pǝ wǝ ŋ ku pǝ ŋ nuŋ ne etieyǝ kǝ ŋ nya fɛɛ ŋ cá pǝla anyarǝpiyǝ. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Paa Yesu ka ŋ cɛ mǝ ŋ ko fɛɛwǝ enyipǝ pǝ lǝǝ kǝlǝ mǝ ŋ ko mǝ ŋ mwɛŋ nyuŋkpǝ.<verse eid="LUK 5:16" /></para>
  <para style="s">Yesu la cá sǝŋyǝ rɛ</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matewu 9:1-8</ref>, <ref loc="MRK 2:1-12">Marǝko 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Jirɛɛrǝ Yesu ka ya ka ŋ kaŋ otuyǝ. Afarisitǝpǝ mǝ oworokosekaŋtǝpǝ rɛ pǝ ke tini rǝ fɛɛwǝ we. Pǝ rù rǝ Galileya lǝ ǝtǝŋtǝǝyǝ kpǝlo kɩɩkɩ mǝ Yudeya mǝŋ Yerusalɛmǝ. Ǝtǝ Woroko lo okopiyǝ yǝ ka tɛɛ rǝ Yesu kǝ ŋ nya fɛɛ ŋ cá anyaatǝpǝ. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Wǝ́ enyipǝ rɛ pǝ pǝlǝ pǝ rù, pǝ re nyiyǝ rɛ ŋ nǝ kpǝ́ otoŋyǝ kɩɩkɩ mǝ vǝŋkǝrǝ pǝ lǝ́ǝ pǝ. Wǝ́ pǝ kǝ ŋ pǝ́ pǝ fii mǝ ŋwǝ pǝ kǝ tǝnǝ rǝ Yesu la kǝnyɩŋkǝ. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Enyipǝ pǝ ka naanǝ kǝto pǝ laa nya fɛɛwǝ pǝ fii mǝ ŋwǝ, wǝ́ pǝ rɛ̀ gukpǝ we lo oŋuŋkǝ wǝ́ pǝ wǝ̀ǝrǝ akpanyaŋkǝ we pǝ sʊ̀ʊ mǝ ŋwǝ mǝ nǝ vǝŋkǝrǝ rǝ enyikpǝlo le kǝtiitiikǝ rǝ Yesu la kǝnyɩŋkǝ. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Kǝ́ Yesu ŋ na nyɩŋ enyipǝ sa la lɔnuŋrǝ we, wǝ́ ŋ tìi nyaatǝyǝ sa ǝkǝnǝŋ: «Mǝ kɛrɩyǝ, pǝ lǝ fǝ ló oturɔɔrɔɔyǝ pǝ la cɛɛ lǝ́». <verse eid="LUK 5:20" /><verse number="21" style="v" sid="LUK 5:21" />Wǝ́ esekaŋtǝpǝ mǝ Afarisitǝpǝ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Ǝlǝ ŋ kaamǝ yǝ ǝnǝ ŋ ya ŋ náa wɛɛlɩ opusuŋtǝtuyǝ ǝnǝ? Ǝlǝ ŋ nóo koru ǝfǝ oturɔɔrɔɔyǝ ŋ cɛɛ wǝ? We Worokoyǝ ceŋceŋ.» <verse eid="LUK 5:21" /><verse number="22" style="v" sid="LUK 5:22" />Wǝ́ Yesu ŋ nyɩnɩ pǝlo oyupuyǝ ŋ cìi wǝ́ ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo pu wǝ ǝnǝ? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Etieyǝ sa lǝ ɖǝ rǝ fǝŋ yɔlʊ atɛŋkǝ deeri wǝ? Pǝ lǝ fǝ ló oturɔɔrɔɔyǝ pǝ la cɛɛ lǝ́, amaa yi kǝ a mǝ saŋ. <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Kǝ nǝ fǝ nǝ ci wǝ ǝkǝnǝŋ Nyɩmaasɩ le Pi lǝǝmǝ okopiyǝ rǝ kǝtǝǝwǝ ŋ nǝ́ǝ fǝ oturɔɔrɔɔyǝ ŋ cɛɛ we, wǝ́ Yesu ŋ sìɛrɩ ŋ tìi sǝŋyǝ sa ǝkǝnǝŋ, ŋ́ ya ŋ́ née tíi lǝ́ yi, piri lǝ́ vǝŋkǝrǝ kǝ o mǝ ko nyarǝwǝ.» <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Rǝ kǝyaakǝ we wǝ́ nyiyǝ sa ŋ yili rǝ pǝle enimiyǝ wǝ́ ŋ fǝ̀ nǝ vǝŋkǝrǝ wǝ́ ŋ kǝ̀ Worokoyǝ ŋ ko ŋ ko na nyarǝwǝ. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Tuwǝ sa wǝ rili enyipǝ we kpǝlo kɩɩkɩ lo mumuŋ, wǝ́ pǝ fìi vurǝ, wǝ́ pǝ kǝ ŋ kǝ Worokoyǝ, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ruŋruŋ yǝ la nyɩŋ otuyǝ la faa nyɩŋ lǝ tǝnǝ wǝ».<verse eid="LUK 5:26" /></para>
  <para style="s">Yesu lo pwo levi ŋ pe siimǝ ŋwǝ</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matewu 9:9-13</ref>, <ref loc="MRK 2:13-17">Marǝko 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Wǝla kǝmaakǝ wǝ́ Yesu ŋ rù, wǝ́ ŋ nyɩnɩ laŋpoolɔtǝyǝ rɛ pǝ lóo pwo Levi tini rǝ fɛɛlɔlaŋpooyǝ. Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siimǝ mǝ!» <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Wǝ́ Levi ŋ màa tu ri ŋ tu ŋ tǝ̀nǝ wǝ́ ŋ yili ŋ sìimǝ ŋwǝ. <verse eid="LUK 5:28" /><verse number="29" style="v" sid="LUK 5:29" />Wǝ́ Levi ŋ càa keerimumuŋwǝ rɛ rǝ na nyarǝwǝ ŋ lɔ̀ Yesu. Alaŋpoolɔtǝpǝ lǝ kpǝŋmumuŋwǝ rɛ mǝ enyipʊŋpwapǝ rɛ pǝ ke tini pǝ ke ŋ ri pǝ ŋ kʊla mǝ pǝ. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Wǝ́ Afarisitǝpǝ mǝ pǝle epǝ we pǝ ri esekaŋtǝpǝ pǝ ka ŋ kpaŋ pǝ ŋ tíi Yesu lo otukarǝtǝpǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ tini nǝ nyée ri, nǝ nyóo ŋuŋ nǝ nyǝ ŋ kʊla mǝ alaŋpoolɔtǝpǝ mǝŋ oturɔɔrɔɔyeetǝpǝ ǝnǝ?» <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Anyaatǝpǝ pǝ lǝ pǝ́ wɛɛcátǝyǝ wǝ, ŋkǝ epǝ we pǝ kpaa purupuru wǝ. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ŋ́ nǝǝ pǝ ŋ́ po pwo enyikʊʊpǝ, oturɔɔrɔɔyeetǝpǝ wǝ́ ŋ́ nǝ pǝ ŋ́ po pwo kǝ pǝ nya fɛɛ pǝ siɛrɩ.»<verse eid="LUK 5:32" /></para>
  <para style="s">Pǝ lǝ pǝ́ Yesu le dierǝ pǝ lo ru rǝ nyuŋparǝkpǝ</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matewu 9:14-17</ref>, <ref loc="MRK 2:18-22">Marǝko 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Wǝ́ Afarisitǝpǝ pǝ tìi Yesu ǝkǝnǝŋ: «Yowanɛsɩ lo otukarǝtǝpǝ pǝ láa parǝ nyuŋkpǝ eni ri ŋ ni wǝ́ pǝ lée yee onyuŋmwɛŋyǝ, kaa wǝǝ Afarisitǝnɛŋpǝ ŋpǝ ŋkpɛ pǝ lée yee wǝǝ. Paa lá anɛŋ otukarǝtǝpǝ sa we, pǝ lée ri, wǝ́ pǝ lóo ŋuŋ eni ri ŋ ni.» <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nyóo koru etíi tiɛŋwɛŋlǝtǝyǝ lǝ ǝtǝŋpǝ pǝ parǝ nyuŋkpǝ kǝ́ tiɛŋwɛŋlǝtǝyǝ ŋ tini ŋ kʊla mǝ pǝ wǝ? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Paa eciyǝ rɛ yǝ lo furu, pǝ lǝh pǝ fǝ tiɛŋwɛŋlǝtǝyǝ pǝ cɛ rǝ pǝlǝ kpǝŋ, eniyǝ we lǝ mǝrǝ we, pǝ lah mǝ parǝ nyuŋkpǝ.» <verse eid="LUK 5:35" /><verse number="36" style="v" sid="LUK 5:36" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Rɛ lǝŋ la na kǝkpaŋwɛŋkǝ lo tuwǝ ŋ fǝ ŋ ka tɛɛ kǝkpakuukuukǝ. Mǝŋ rɛ le yee wǝ we, la laarǝ kǝkpaŋwɛŋkǝ we rǝ, wǝ́ kǝlo tuwǝ sa wǝ lǝŋ ka kaamǝ kǝkpakuukuukǝ we. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Kaa wǝǝ rɛ lǝŋ kpii ǝfǝŋŋwɛŋpǝ rǝ fwɛɛwǝ le diikuukuurǝ. Ǝfǝŋŋwɛŋpǝ sa pǝ láa la fwɛɛwǝ le diirǝ we, kǝ pǝ lʊ. Eniyǝ we fwɛɛwǝ le diirǝ sa ŋre lǝ pǝlǝ. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Kǝto wǝ kaamǝ kǝ pǝ kpii ǝfǝŋŋwɛŋpǝ rǝ fwɛɛwǝ le diiŋwɛŋrǝ. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Wǝ́ rɛ lee kpii ŋ nóo ŋuŋ ǝfǝŋkurupǝ ŋ lɛ kǝ ŋ tǝ ŋ taa aŋʊŋwɛŋpǝ, kpiikǝ pǝ láa tɛŋ ǝkǝnǝŋ okukurupǝ we pǝ ri eceeceepǝ.»<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Yesu ri kulǝtǝyǝ koonu sabatǝyǝ le jirǝ</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matewu 12:1-8</ref>, <ref loc="MRK 2:23-28">Marǝko 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Sabatǝyǝ le jirɛɛrǝ we, wǝ́ Yesu mǝ no otukarǝtǝpǝ pǝ sanǝ pǝ kolu pǝ ka ŋ tɛlɩ bǝleyǝ la wǝtɛɛkpǝ rɛ. Wǝ́ no otukarǝtǝpǝ sa pǝ ka ŋ pɔɔpʊ bǝleyǝ we le epiyǝ pǝ ŋ pʊsa mǝ wǝkaakpǝ pǝ ŋ wo. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Wǝ́ Afarisitǝpǝ rɛ pǝ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyée yee tuwǝ sa mǝ sabatǝyǝ le jirǝ ǝnǝ? Leh seyǝ lǝ kpǝlǝ wǝ!» <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Kǝto nǝ nyǝǝ kǝ tuwǝ Davidǝ ŋ yeli jirǝ we kǝtɛŋkǝ kǝ ka ŋ wʊ ŋpǝ mǝ enyipǝ we pǝ ke siimǝ ŋwǝ wǝ? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Davidǝ fìi Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ fǝ̀ akpɔnɔpǝ we pǝ lo koonu Worokoyǝ ŋ wolu. Wǝ́ ŋ kòonu enyipǝ we pǝ ke siimǝ ŋwǝ ŋpe pǝ wolu. Paa leh seyǝ la tɛŋ ǝkǝnǝŋ rɛ lǝŋ wo akpɔnɔpǝ sa, we Otoolutǝpǝ ko.» <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Nyɩmaasɩ le Pi ri kulǝtǝyǝ koonu sabatǝyǝ le jirǝ».<verse eid="LUK 6:5" /></para>
  <para style="s">Yesu la cá nyiyǝ rɛ ŋ nǝ kpǝ́ kǝnukǝ mǝ sabatǝyǝ le jirǝ</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matewu 12:9-14</ref>, <ref loc="MRK 3:1-6">Marǝko 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Sabatǝyǝ le jipʊŋpwarǝ rɛ wǝ́ Yesu ŋ kolu Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ. Wǝ́ ŋ yà ŋ ka ŋ kaŋ otuyǝ. Nyiyǝ rɛ ka ya rǝ we, lǝ kpǝ́ kǝnirinukǝ. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Wǝ́ oworokosekaŋtǝpǝ mǝ Afarisitǝpǝ pǝ cò nimirǝ pǝ ka ŋ yɩrɩ Yesu rɛyɩɩ kǝ pǝ nyɩŋ mǝŋ láa cá rɛ mǝ sabatǝyǝ le jirǝ wǝ. Eniyǝ we pǝ la nya tuwǝ pǝ lǝ́ǝ fǝ pǝ yee dierǝ mǝ ŋwǝ wǝ. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Paa Yesu ke ci pǝlo oyupuyǝ. Wǝ́ ŋ tìi nyiyǝ sa ŋ nǝ kpǝ́ kǝnukǝ ǝkǝnǝŋ: «Yi a pa yaa rǝ kǝtiitiikǝ sa, rǝ enyipǝ kpǝlo la kǝnyɩŋkǝ». Wǝ́ nyiyǝ sa ŋ yili ŋ pǝlǝ ŋ yàa. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ pǝ́ nǝ oo, leh seyǝ lo kuŋ gʊŋrǝ pǝ yee wǝceeceekpǝ mǝ sabatǝyǝ le jirǝ, amaa wǝrɔɔrɔɔkpǝ? Pǝ lɔ pǝ koonu nyiyǝ amaa pǝ maa ŋwǝ ŋ kpǝ́?» <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Wǝ́ Yesu ŋ yɩ̀rɩ pǝlo kpǝlo ŋ sìri ŋ pǝlǝ ŋ kù. Wǝ́ ŋ tìi nyiyǝ sa ŋ nǝ kpǝ́ kǝnukǝ ǝkǝnǝŋ: «Nwiɛnɩ ló kǝnukǝ.» Wǝ́ ŋ nwìɛnɩ kǝ. Wǝ́ no kǝnukǝ we kǝ sàanǝ. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Paa wǝ́ esekaŋtǝpǝ we mǝ Afarisitǝpǝ we pǝ fǝ̀ kpɛɛmʊrʊwǝ ŋpa wǝ́ pǝ kǝ ŋ pǝ́ awɛ tuwǝ pǝ lóo koru eyee mǝ Yesu wǝ.<verse eid="LUK 6:11" /></para>
  <para style="s">Yesu la saa enyipǝ tǝ mǝ eyi pǝ ri ne enyikpiipǝ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matewu 10:1-4</ref>, <ref loc="MRK 3:13-19">Marǝko 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Jirɛɛrǝ wǝ́ Yesu ŋ rɛ̀ dutupirǝ rɛ ŋ ka mwɛŋ nyuŋkpǝ. Wǝ́ ŋ mwɛnɩ nyuŋkpǝ ŋ pwò Worokoyǝ mǝ dumurǝ we kpǝlo kɩɩkɩ. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Kǝ́ ǝrǝkǝ kǝ la kaalǝ we, wǝ́ ŋ pwò no otukarǝtǝpǝ ŋ pǝlǝ. Wǝ́ ŋ sàa enyipǝ tǝ mǝ eyi ŋ pɔ̀rʊ wǝ́ ŋ kpìi pǝla nyɩŋrǝ ǝkǝnǝŋ enyikpiipǝ. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Ŋpǝ enyipǝ we pǝ kaamǝ: Sɩmɔ, ŋwǝ wǝ́ Yesu ŋ kpìi nyɩŋrǝ ǝkǝnǝŋ Pɛtǝro, mǝ na paanʊ Aŋdǝre, Yakubu mǝ Yowanɛsɩ, Filipo mǝ Batelemi, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Matewu mǝ Toma, Alǝfe le pi Yakubu mǝ Sɩmɔ, yǝ we ŋ náa kɔŋ mǝ ŋ kuŋ nǝ gǝŋrǝ wǝ, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Yakubu le pi Yude mǝ Yuda Isǝkario yǝ we ŋ pǝlǝ ŋ fǝ̀ Yesu ŋ kpìi nǝ ǝkǝǝkpǝlǝtǝpǝ rǝ akaakǝ wǝ.<verse eid="LUK 6:16" /></para>
  <para style="s">Yesu la kaŋ nyikpǝŋmumuŋwǝ rɛ lo otuyǝ wǝ́ ŋ na lɛ ŋ na cá anyaatǝpǝ</para>
  <para style="r">(<ref loc="MAT 4:23-25">Matewu 4:23-25</ref>, <ref loc="MRK 3:7-13">Marǝko 3:7-13</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Wǝ́ Yesu ŋ rù ŋ ka ŋ sʊʊ dutupirǝ we ŋpǝ mǝ no otukarǝtǝpǝ. Wǝ́ ŋ pǝlǝ ŋ yàa rǝ fɛɛtapɩtapɩwǝ rɛ. Enyipǝ we pǝ ke ŋ sìimǝ ŋwǝ lǝ kpǝŋmumuŋwǝ rɛ wǝ ka yaa rǝ we, fǝ kʊla mǝ enyipʊŋpwapǝ lǝ kpǝŋmumuŋwǝ rɛ. Enyipǝ sa pǝ rù rǝ Yudeya lǝ gǝŋrǝ kpǝlo, Yerusalɛmǝ, Tiro mǝ Zidɔŋ yǝ yaa rǝ apʊyǝ la kǝlɛɛrɩkǝ wǝ. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Pǝ pǝlǝ pǝ po nuŋ Yesu lo otukaŋyǝ kǝ ŋ ca pǝla anyarǝpiyǝ. Wǝ́ Yesu ŋ lɛ̀ ŋ cà mǝŋ enyipǝ we awɛɛrɔɔrɔɔyǝ yǝ ya yǝ lée kpii awɛɛlɩkǝ wǝ. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Nyi ri ŋ nyi kǝ ŋ pǝ́ ŋ ruu Yesu. Duturǝ ɖi okopiyǝ rɛ yǝ ko ŋ ru rǝ ŋwǝ yǝ ŋ cá pǝlo kpǝlo.<verse eid="LUK 6:19" /></para>
  <para style="s">Yesu la wɛɛlɩ lo ru rǝ wǝsiɛrɩkpǝ mǝ wǝrɔɔrɔɔkpǝ</para>
  <para style="r">(<ref loc="MAT 5:1-12">Matewu 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Wǝ́ Yesu ŋ yìili ŋ yɩ̀rɩ no otukarǝtǝpǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 6:20">«Ŋnǝ ariariatǝpǝ, nǝ nyóo co yǝ.</para>
  <para style="q1" vid="LUK 6:20">Duturǝ ɖi Worokoyǝ le wǝpilirikpǝ we wǝ ri nǝ wǝnɛŋ.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Ŋnǝ epǝ we kǝtɛŋkǝ kǝ ya kǝ láa wʊ rǝkǝsa we,</para>
  <para style="q1" vid="LUK 6:21">nǝ nyóo co yǝ, duturǝ ɖi keeriwǝ wǝ lah pa nya nǝ.</para>
  <para style="q1" vid="LUK 6:21">Ŋnǝ epǝ we nǝ ya nǝ nyée wee rǝkǝsa we, nǝ nyóo co yǝ.</para>
  <para style="q1" vid="LUK 6:21">Duturǝ ɖi nǝ nyah pa mɔŋ.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />Mǝŋ enyipǝ pǝ lǝ kpǝlǝ nǝ kǝǝwǝ, wǝ́ pǝ lǝ sǝ́ŋ nǝ pǝ lo co, wǝ́ pǝ la fɛɛpɩ nǝ wǝ́ pǝ la wɛɛlɩ rɔɔrɔ pǝ lo ru rǝ nǝ, rǝ kǝ́ nǝ nya lɔ Nyɩmaasɩ le Pi nǝ nyo nuŋ kǝto we, nǝ nyóo co yǝ,<verse eid="LUK 6:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="LUK 6:23" />Mǝŋ otuyǝ sa yǝ lǝ pǝ ǝnǝ we, nǝ nya faawǝ. Nǝ mǝ yo mǝ faawǝ, duturǝ ɖi wǝtoomwaramumuŋkpǝ rɛ wǝ kpɛlɩ nǝ rǝ yulaarǝ. Kǝceece, kaa wǝǝ pǝlǝ ǝtǝtǝpǝ pǝ ke ŋ pieeli oworokokpɛɛnuŋtɛŋtǝpǝ wǝǝ.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />Paa ŋnǝ epǝ we nǝ lǝǝmǝ nǝ wɛ we, nǝ paapɔ mǝ nǝ aria.</para>
  <para style="q1" vid="LUK 6:24">Duturǝ ɖi nǝ nya marǝ nǝ nya lɔ nǝ wǝsiɛrɩkpǝ.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Ŋnǝ epǝ we nǝ nyo wu rǝkǝsa we, nǝ paapɔ mǝ nǝ aria.</para>
  <para style="q1" vid="LUK 6:25">Duturǝ ɖi kǝtɛŋkǝ kǝ lah pa wʊ nǝ.</para>
  <para style="q1" vid="LUK 6:25">Ŋnǝ epǝ we nǝ ya nǝ nyáa mɔŋ rǝkǝsa we,</para>
  <para style="q1" vid="LUK 6:25">nǝ paapɔ mǝ nǝ aria.</para>
  <para style="q1" vid="LUK 6:25">Duturǝ ɖi nǝ nyeh pe fii gʊʊpirǝ, kǝ nǝ wee.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />Mǝŋ nyi ri ŋ nyi láa wɛɛlɩ mǝ ŋ kǝ nǝ rǝ ko we, nǝ paapɔ mǝ nǝ aria. Duturǝ ɖi kaa wǝǝ pǝlǝ ǝtǝtǝpǝ pǝ ke ŋ yee mǝ</para>
  <para style="q1" vid="LUK 6:26">anianiatǝworokokpɛɛnuŋtɛŋtǝpǝ wǝǝ.»<verse eid="LUK 6:26" /></para>
  <para style="s">Taa lǝ́ ǝkǝǝkpǝlǝtǝpǝ lǝ kǝǝwǝ</para>
  <para style="r">(<ref loc="MAT 5:38-48">Matewu 5:38-48</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />«Paa, ŋnǝ epǝ we nǝ ya nǝ nyóo co kǝtukoŋkǝ rǝ mǝ etieyǝ we, ŋ́ ya ŋ́ née tíi nǝ tuwǝ sa, nǝ taa nǝ ǝkǝǝkpǝlǝtǝpǝ lǝ kǝǝwǝ. Nǝ yee epǝ we pǝ lǝ́ǝ kpǝlǝ nǝ kǝǝwǝ le wǝceeceekpǝ. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Nǝ pɛɛrɩ epǝ we pǝ ya pǝ láa fwɛɛrɩ nǝ wǝ, kǝ nǝ mwɛŋ nyuŋkpǝ nǝ koonu epǝ we pǝ ya pǝ lée pieeli nǝ wǝ. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Mǝŋ nyiyǝ rɛ la ca lǝ́ kaafieliwǝ rǝ kalawǝ sa we, siɛrɩ kalayitǝwǝ o koonu ŋwǝ. Mǝŋ rɛ la ta lá nyaŋsiirǝ la lɔ rǝ lǝ́ we, maa ŋwǝ ŋ lɔ lá kǝkpapoŋpikǝ ŋkee. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Nyi ri ŋ nyi ŋ na nya ŋ na ria lǝ́ tuwǝ rɛ we, koonu ŋwǝ. Wǝ́ mǝŋ rɛ lǝ fǝ ló tuwǝ we, pǝǝ pǝ́ nǝ wǝ. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Tuwǝ we nǝ nyǝ́ǝ pǝ́ enyipǝ pǝ yee pǝ koonu nǝ we, nǝ yee wǝ mǝŋkɔɔwe nǝ koonu pǝ. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />Mǝŋ epǝ we pǝ láa taa nǝ kǝǝwǝ sɔŋ wǝ́ nǝ nyáa taa kǝǝwǝ wǝǝ, nǝ nyóo pu wǝ ǝkǝnǝŋ Worokoyǝ lah pa mwara nǝ wǝlo wǝtookpǝ? Duturǝ ɖi oturɔɔrɔɔyeetǝpǝ ŋpǝ ŋkpɛ pǝ láa taa epǝ we pǝ láa taa pǝlǝ kǝǝwǝ. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Wǝ́ mǝŋ epǝ we pǝ lée yee wǝceeceekpǝ pǝ ŋ koonu nǝ sɔŋ wǝ́ nǝ nyée yee wǝceeceekpǝ nǝ nyǝ ŋ koonu wǝǝ, nǝ nyóo pu wǝ ǝkǝnǝŋ Worokoyǝ lah pa mwara nǝ wǝlo wǝtookpǝ? Oturɔɔrɔɔyeetǝpǝ ǝkǝŋtǝ pǝ lée yee wǝ mǝŋ ŋnǝ kǝtǝ. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Mǝŋ epǝ we nǝ nya tɛɛ kpɛɛwǝ ǝkǝnǝŋ pǝ lah pa mwara nǝ sɔŋ ko wǝ́ nǝ nyóo tuu tuwǝ wǝǝ, nǝ nyóo pu wǝ ǝkǝnǝŋ Worokoyǝ lah pa mwara nǝ wǝlo wǝtookpǝ? Oturɔɔrɔɔyeetǝpǝ ǝkǝŋtǝ pǝ lóo tuu oturɔɔrɔɔyeetǝpǝ la sɩkayǝ kǝ pǝ nya fɛɛ pǝ pa mwara pǝla sɩkayǝ we pɛpɛ. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Paa nǝ taa nǝ ǝkǝǝkpǝlǝtǝpǝ lǝ kǝǝwǝ. Nǝ yee pǝ le wǝceeceekpǝ. Nǝ tuu enyipǝ lo otuyǝ, nǝ pǝǝ rǝŋ pǝ pa mwara nǝ. Eniyǝ we nǝ nyah ka lɔ wǝtoomwarakpǝ lo wǝmumuŋkpǝ rǝ Worokoyǝ lǝ kpǝŋ, kǝ nǝ ke ri Worokoyǝ ŋ tɛɛ rǝ oŋuŋkǝ le epipǝ. Duturǝ ɖi lée yee wǝceeceekpǝ mǝ ŋ koonu epǝ we pǝ lǝŋ nyɩŋ tuwǝ we pǝ le yee pǝ lo kuŋ pǝ pǝ ci wǝ, mǝ epǝ we pǝ ri oyulɛŋtǝpǝ wǝ. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Nǝ nyɩŋ enyipǝ la tǝlarǝwǝ mǝŋ kǝ́ nǝ Tǝ ŋ náa nyɩŋ enyipǝ la tǝlarǝwǝ kǝtǝ.»<verse eid="LUK 6:36" /></para>
  <para style="s">Paa tɛŋ rɛ la wǝkpaŋkpǝ</para>
  <para style="r">(<ref loc="MAT 7:1-5">Matewu 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />«Nǝ paa tɛŋ rɛ la wǝkpaŋkpǝ, kǝ Worokoyǝ ŋ paa tɛŋ nǝ wǝkpaŋkpǝ. Nǝ paa tɔɔ rɛ la bɔrǝ kǝ Worokoyǝ ŋ paa tɔɔ nǝ bɔrǝ. Nǝ fǝ nǝ cɛɛ enyipǝ, kǝ Worokoyǝ ŋ fǝ ŋ cɛɛ nǝ. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Nǝ koonu enyipǝ lo otuyǝ, kǝ Worokoyǝ ŋwǝ ŋkpɛ ŋ koonu nǝ otuyǝ. Láa kaa kǝ wǝ lǝ. Lée tikili wǝ, kǝ ŋ ta wǝ, kǝ wǝ lǝ mǝ ayɛɛlɩyǝ, kǝ ŋ fǝ ŋ kpii nǝ rǝ nǝ olootoyǝ. Kpiikǝ tuwǝ we nǝ nyǝ́ǝ fǝ nǝ nyǝ ŋ kaa nǝ nyǝ ŋ koonu enyipǝ we, ŋ wǝ wǝ́ Worokoyǝ ŋwǝ ŋkpɛ ŋ nǝ́ǝ fǝ ŋ kaa ŋ koonu nǝ.»<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Wǝ́ Yesu ŋ tǝ ŋ cà pǝlo duturǝ sa ǝkǝnǝŋ: «Laanyɩŋtǝyǝ lǝŋ koru ocoŋ mǝ laanyɩŋtǝyǝ. Ŋ́ na nia rǝ? Pǝle eyi pǝ lah ka tɔɔ fuŋwǝ. <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Tukarǝtǝpiyǝ lǝŋ teeri no tukaŋtǝyǝ. Paa tukarǝtǝpiyǝ we pǝ la kaŋ tu ri ŋ tu sɩsiɛrɩ wǝ́ ŋ ne ci we, kaa rǝ mǝ no tukaŋtǝyǝ.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />A ya láa yɩrɩ kǝyurookǝ we kǝ kpii rǝ lá paanʊyǝ le nimirǝ. Paa ciituwǝ we wǝ kpii rǝ ŋlǝ́ŋlǝ́ lé nimirǝ we, a laa ya láa nyɩŋ wǝ e mǝ ŋ ci. Kǝ́ kǝto? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Nɛ kǝto wǝ́ o lóo koru etíi lá paanʊyǝ ǝkǝnǝŋ: “Mǝ paanʊ, maa kǝ ŋ́ pɔrʊ kǝyurookǝ sa kǝ kpii lǝ́ rǝ nimirǝ.” Ŋlǝ́ yǝ ǝnǝ e lee ce a ya láa nyɩŋ ciituwǝ sa wǝ kpii rǝ lá nɛŋrǝ wǝ. Lakpatǝnyiyǝ rɛ! Pɔrʊ ciituwǝ sa rǝ lé nimirǝ kpɛŋ. Eniyǝ we a láa nyɩŋ sɩsiɛrɩ, kǝ a nya fɛɛ a pɔrʊ kǝyurookǝ we kǝ kpii rǝ lá paanʊ le nimirǝ.»<verse eid="LUK 6:42" /></para>
  <para style="s">Pǝ láa nyɩŋ wǝciiceeceekpǝ pǝ ŋ ci saŋ rǝ wǝlǝ ǝtǝnǝyǝ</para>
  <para style="r">(<ref loc="MAT 7:16-20">Matewu 7:16-20</ref>, <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />«Wǝciiceeceekpǝ wǝ lǝŋ nyɩŋ ǝtǝnǝrɔɔrɔɔyǝ. Wǝ́ wǝciirɔɔrɔɔkpǝ wǝ lǝŋ nyɩŋ ǝtǝnǝceeceeyǝ. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Pǝ láa nyɩŋ eciyǝ pǝ ŋ ci saŋ rǝ yǝlǝ ǝtǝnǝyǝ. Nǝ ci wǝ ǝkǝnǝŋ pǝ lǝŋ lɛ ocootǝnǝyǝ rǝ wǝwuciikpǝ. Wǝ́ pǝ lǝŋ lɛ kǝfɛrɩkǝ rǝ kekeremeseyǝ. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Nyiceeceeyǝ we, lée yee rǝ otuceeceeyǝ. Kpiikǝ na ziɔŋrǝ lǝ lǝ mǝ otuceeceeyǝ. Paa nyirɔɔrɔɔyǝ we, lée yee rǝ oturɔɔrɔɔyǝ. Kpiikǝ na ziɔŋrǝ lǝ lǝ mǝ oturɔɔrɔɔyǝ. Kǝceece tuwǝ we wǝ lǝ lǝ wǝ kpii nyiyǝ rǝ ziɔŋrǝ we, ŋ wǝ wǝ lóo ru ŋwǝ rǝ nyuŋkpǝ wǝ.»<verse eid="LUK 6:45" /></para>
  <para style="s">Yesu le ci la kaŋ enyipǝ pǝ fǝ ne dierǝ pǝ yee kǝnǝnɛkǝ</para>
  <para style="r">(<ref loc="MAT 7:24-27">Matewu 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />«Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo pwo mǝ ǝkǝnǝŋ “Kulǝtǝyǝ, Kulǝtǝyǝ”, paa nǝ nyǝŋ yee tuwǝ ŋ́ née tíi nǝ wǝ? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Nyi ri ŋ nyi ŋ nǝ pǝ mǝ kpǝŋ, wǝ́ ŋ no nuŋ mǝ dierǝ wǝ́ ŋ ne yee ŋ na saŋ rǝ rǝ we, ŋ́ náa kaŋ nǝ yǝ we kǝtǝŋkǝ ŋ no ru wǝ. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Lo ru nyiyǝ ŋ nah tɔ nyarǝwǝ. Wǝ́ ŋ ne nyiŋ kǝtǝǝwǝ ŋ na sʊʊ, wǝ́ ŋ no ko tuu ɖutɛɛrǝ. Wǝ́ ŋ no co ne giriŋrǝ la kǝtɛɛkǝ ŋ na tɛɛ rǝ rǝ. Kǝ́ ŋʊŋtɛyǝ ŋ nǝ pǝ we, wǝ́ kpanǝwǝ wǝ lǝ lǝ, wǝ́ wǝ ya wǝ lée re wǝ ŋ pǝ wǝ ŋ ca rǝ nyarǝwǝ sa. Paape wǝ loo koru wǝ le ere co. Kpiikǝ nyiyǝ sa la tɔ nyarǝwǝ sa sɩsiɛrɩ kǝto. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Paa yǝ we ŋ no nuŋ mǝ etieyǝ, wǝ́ ŋ nee yee ŋ saŋ rǝ yǝ we, lo ru nyiyǝ ŋ na tɔ nyarǝwǝ wǝ́ ŋ nee nyiŋ kǝtǝǝwǝ kǝ ŋ co giriŋrǝ la kǝtɛɛkǝ. Kǝ́ ŋʊŋtɛyǝ ŋ nǝ pǝ we, wǝ́ kpanǝwǝ wǝ lǝ lǝ, kǝ́ mɛŋwǝ wǝ le re wǝ la pa ca nyarǝwǝ sa kǝtǝrǝceŋceŋ ko, wǝ́ wǝ la tɔɔ. Wǝ́ wǝ la wɔ kɩɩkɩ.»<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Oromatǝpǝ lo otuusiitǝpǝ lo mumuŋyǝ rɛ la pɔrʊ na lɔnuŋrǝ la kaŋ</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matewu 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Kǝ́ Yesu ŋ na tɛŋ otuyǝ sa kpǝlo ŋ ne tíi nyikpǝŋwǝ we ŋ na lɛ we, wǝ́ ŋ kolu Kapɛrǝnawumǝ. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Oromatǝpǝ lo otuusiitǝpǝ lo mumuŋyǝ rɛ ke kpii rǝ tǝŋtǝǝwǝ we. Anyɩŋ na sʊmatǝyǝ rɛ ŋ náa taa kǝǝwǝ ŋpa ya lǝ́ǝ fǝrǝ kpuŋkpuruŋ lǝh kpǝ́. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Kǝ́ otuusiitǝpǝ lo mumuŋyǝ sa ŋ no nuŋ pǝ la wɛɛlɩ pǝ lo ru rǝ Yesu we, wǝ́ ŋ kpìi Oyudatǝpǝ lo omumuŋpǝ rɛ pǝ ke tíi ŋwǝ kǝ ŋ pa cá na sʊmatǝyǝ sa. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Kǝ́ pǝ lo po tu Yesu we, wǝ́ pǝ ke ŋ kpii na dɔɔkpɛɛrǝ ŋpa ǝkǝnǝŋ: «Wǝ kaamǝ kǝ e yee tuwǝ sa o koonu nyiyǝ sa. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Duturǝ ɖi láa taa lǝh kǝkpǝŋkǝ lǝ kǝǝwǝ. Ŋwǝ ŋ na lɛ ŋ na tɔ loh gumwɛŋnyuŋkpǝ.» <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Wǝ́ Yesu ŋ sìimǝ pǝ ŋ ko ŋ ko. Kǝ́ pǝ lah ta pǝ fii nyarǝwǝ we we, wǝ́ ŋ kpìi nǝ ǝtǝŋpǝ pǝ pe tíi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, pǝǝ tǝ e kpii lá wɛ la awɛɛlɩkǝ, duturǝ ɖi ŋ́ naa kaamǝ kǝ e fii mǝ nyarǝwǝ. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Tuwǝ kǝto ŋmǝŋmǝ ŋ́ noo tu turuwǝ ŋ́ pǝ lǝ́ kpǝŋ wǝǝ. Paape tɛŋ dierǝ rɛ jeŋceŋ kǝ mǝ sʊmatǝyǝ ŋ kpaa. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Duturǝ ɖi ŋmǝŋmǝ ŋ́ lǝǝmǝ okulǝtǝpǝ. Wǝ́ ŋ́ lɛ ŋ́ lǝǝmǝ otuusiitǝpǝ ŋ́ née kpii akʊŋyǝ. Vǝ́ ŋ́ ne tíi yǝ ǝnǝ ŋ ko ɖeeni, ŋ ko. Vǝ́ ŋ́ ne tíi yǝ eni ŋ pǝ, ŋ pǝ. Vǝ́ ŋ́ ne tíi mǝ sʊmatǝyǝ ŋ yee tuwǝ sa, ŋ yee wǝ.» <verse eid="LUK 7:8" /><verse number="9" style="v" sid="LUK 7:9" />Kǝ́ Yesu ŋ no nuŋ ne etieyǝ sa we, wǝ́ wǝ rili no mumuŋ, wǝ́ wǝ cà na kpɛɛ. Wǝ́ Yesu ŋ sìɛrɩ ŋ ke ŋ tíi nyikpǝŋwǝ we wǝ ke siimǝ ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, ŋ́ faa nyɩŋ nyiyǝ rɛ ŋ na lɔ ŋ no nuŋ mǝŋkǝsa ŋ́ nyɩŋ. Mǝŋ Isǝrayɛlǝ lǝ gǝŋrǝ sa ǝkǝŋtǝ, rɛ lee kpii.» <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Kǝ́ otuusiitǝpǝ lo mumuŋyǝ sa le enyikpiipǝ we pǝ la siɛnɩ pǝ le ke fii nyarǝwǝ we, wǝ́ pǝ nyɩnɩ sʊmatǝyǝ we la kpa purupuru.<verse eid="LUK 7:10" /></para>
  <para style="s">Yesu la saanǝ kpeetieyǝ rɛ lǝ bǝrǝŋpirǝ gbǝ̀ wǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Wǝla kǝmaakǝ wǝ́ Yesu ŋ kolu tǝŋtǝǝwǝ rɛ pǝ lóo pwo Nayinǝ. No otukarǝtǝpǝ mǝ nyikpǝŋmumuŋwǝ rɛ pǝ ke siimǝ ŋwǝ. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Kǝ́ ŋ nǝ kǝ kǝlǝ mǝ tǝŋtǝǝwǝ we lo guŋpolurǝ we<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Rǝ gakarǝ we, pǝ ko ŋ co giriŋrǝ pǝ ŋ siri ǝtǝŋtǝǝyǝ oturu pǝ le kpii guŋpolurǝ.</char></note>, anyɩŋ pǝ lǝ fǝ nyiǝtǝyǝ rɛ pǝ loh ko pǝ ka ŋwaa. Nyiǝtǝyǝ sa ke ri kpeetieyǝ rɛ lǝ bǝrǝŋpiceŋceŋrǝ. Wǝ́ tǝŋtǝǝwǝ we le nyikpǝŋmumuŋwǝ rɛ wǝ ka kʊ̀la mǝ ŋwǝ kpeetieyǝ we. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Kǝ́ Yesu ŋ na nyɩŋ kpeetieyǝ we we, wǝ́ no tuwǝ wǝ cò na tǝlarǝwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝǝ tǝ e wee!» <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Wǝ́ Yesu ŋ sanǝ ŋ kolu ŋ rù akpayǝ we. Wǝ́ epǝ we pǝ ke re yǝ pǝ tùmǝ pǝ yàa. Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Kosopi, ŋ́ ya ŋ́ née tíi lǝ́ wǝ, saanǝ!» <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Wǝ́ kosopiyǝ we ŋ yili ŋ tini, wǝ́ ŋ yà ŋ ka ŋ wɛɛlɩ. Wǝ́ Yesu ŋ fǝ̀ ŋwǝ ŋ koonu ne lee. <verse eid="LUK 7:15" /><verse number="16" style="v" sid="LUK 7:16" />Wǝ́ vurǝ vìi enyipǝ we kpǝlo. Wǝ́ pǝ yà pǝ kǝ ŋ kǝ Worokoyǝ ǝkǝnǝŋ: «Worokoyǝ lo kuŋ worokokpɛɛnuŋtɛŋtǝmumuŋyǝ rɛ la nyaa lo ru rǝ lǝ mǝrǝ. Worokoyǝ la pa lɔ lo koonu nǝ kǝkpǝŋkǝ.» <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Tuwǝ sa Yesu ŋ yeli we, wǝ tò kpoo rǝ Yudeya lǝ gǝŋrǝ we kpǝlo kɩɩkɩ mǝŋ akpaalǝyǝ.<verse eid="LUK 7:17" /></para>
  <para style="s">Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ le kpii enyipǝ rǝ Yesu lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MAT 11:2-19">Matewu 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Wǝla kǝmaakǝ, wǝ́ Yowanɛsɩ lo otukarǝtǝpǝ pǝ fǝ̀ otuyǝ sa kpǝlo pǝ pǝlǝ pǝ pɔ ŋwǝ Yowanɛsɩ la amayǝ. Wǝ́ Yowanɛsɩ ŋ pwò enyipǝ eyi rǝ pǝlǝ mǝrǝ. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Wǝ́ ŋ kpìi pǝ pǝ kǝ pǝ́ Kulǝtǝyǝ Yesu ǝkǝnǝŋ: «Ŋlǝ́ e ri Mesiyayǝ we ŋ nǝh pǝ wǝ, amaa lǝ tǝ lǝ mǝ rǝŋ nyipʊŋpwayǝ rɛ?» <verse eid="LUK 7:19" /><verse number="20" style="v" sid="LUK 7:20" />Kǝ́ pǝ le ke fii Yesu lǝ kpǝŋ we, wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ ŋ ne kpii lǝ, lǝ pǝ pǝ́ lǝ́ ǝkǝnǝŋ: “Ŋlǝ́ e ri Lɔkuŋtǝyǝ we Worokoyǝ ŋ na tɛŋ ŋ née kpii ŋ maŋ wǝ, amaa yǝ lǝ́ǝ tǝ lǝ mǝ rǝŋ nyipʊŋpwayǝ rɛ?”» <verse eid="LUK 7:20" /><verse number="21" style="v" sid="LUK 7:21" />Rǝ ŋyǝ eniyǝ we, wǝ́ Yesu ŋ cà anyaatǝpǝ wa. Wǝ́ ŋ pìri awɛɛrɔɔrɔɔyǝ rǝ enyipǝ wa lǝ mǝrǝ. Wǝ́ ŋ lɛ̀ ŋ wùru alaanyɩŋtǝpǝ wa le enimiyǝ. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Wǝ́ ŋ tìi Yowanɛsɩ le enyikpiipǝ we ǝkǝnǝŋ: «Nǝ mǝ ko nǝ ka tɛŋ otuyǝ we nǝ nya nyɩŋ, wǝ́ nǝ nyo nuŋ, nǝ tíi Yowanɛsɩ. Nǝ tíi ŋwǝ ǝkǝnǝŋ alaanyɩŋtǝpǝ pǝ ya pǝ láa nyɩŋ, ǝsǝ́ŋpǝ pǝ ya pǝ láa saŋ, anyarǝpimwɛɛrɩlǝtǝpǝ pǝ la kpaa, oloonuŋtǝpǝ pǝ ya pǝ lóo nuŋ, enyiǝtǝpǝ pǝ ya pǝ láa saanǝ, ariariatǝpǝ pǝ ya pǝ lóo nuŋ Dieceeceerǝ we. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Yǝ we ŋ nǝǝ lǝǝrǝ na lɔnuŋrǝ rǝ mǝ yurǝ we, ŋwǝ yǝ lo co yǝ.»<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Kǝ́ Yowanɛsɩ le enyikpiipǝ we pǝ la pwɛyɩ we, wǝ́ Yesu ŋ yà ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Yowanɛsɩ mǝ ŋ tíi nyikpǝŋwǝ we ǝkǝnǝŋ: «Kǝ́ nǝ nyo ko nyɔŋkpaakǝtǝǝwǝ wǝǝ, kǝ́ wǝ́ nǝ nya ka nyɩŋ? Ŋkǝ gaarǝ rɛ ǝrǝkǝ kǝ ya kǝ lóo fuŋ lǝǝwe? Ow! <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />We kǝ́ wǝ́ nǝ nya ka nyɩŋ? Nyiyǝ rɛ ŋ na cɛ wǝ? Ow, epǝ we pǝ la cɛ mǝ wǝkpakpǝ we wǝ la lɔ okuruyǝ, wǝ́ pǝ rili vɔrʊrǝ pǝ láa tɛlɩ we, epilipǝ la anyarǝyǝ wǝ́ pǝ kpii. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />We kǝ́ wǝ́ nǝ nya ka nyɩŋ? Worokokpɛɛnuŋtɛŋtǝyǝ rɛ? Awo, ŋ́ ya ŋ́ née tíi nǝ wǝ, teeri worokokpɛɛnuŋtɛŋtǝyǝ kʊraa. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Duturǝ ɖi Yowanɛsɩyǝ sa le dierǝ wǝ́ pǝ la tɛŋ rǝ Worokoyǝ la kǝfwɛɛkǝ mǝrǝ ǝkǝnǝŋ: “A lǝŋ nyɩŋ ŋ́ née kpii mǝ nyikpiiyǝ ŋ coŋ ŋ koonu lǝ́, loh ko toolu lá gʊŋrǝ ŋ tǝnǝ lǝ́.”»<verse eid="LUK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rɛ lee kpii rǝ anyɩmaasɩpǝ lǝ mǝrǝ ŋ teeri Yowanɛsɩ. Paape yǝ we ŋ ri pipipipiyǝ rǝ Worokoyǝ le wǝpilirikpǝ we lǝ mǝrǝ we, naanǝ teeri ŋwǝ. <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />Enyipǝ kpǝlo kɩɩkɩ, mǝŋ alaŋpoolɔtǝpǝ pǝ lɔ̀ Yowanɛsɩ le dierǝ sa pǝ nunu wǝ́ pǝ tɛnɩ ǝkǝnǝŋ Worokoyǝ kʊʊ. Wǝ́ ŋ wìiri pǝ lo worokomɛŋwǝ. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Paape Afarisitǝpǝ mǝ oworokosekaŋtǝpǝ pǝ sǝnǝ tuwǝ Worokoyǝ ŋ kǝ ŋ pǝ́ ŋ yee ŋ koonu pǝ wǝ. Wǝ́ pǝ lɛ̀ pǝ sǝnǝ Yowanɛsɩ ŋ pee wiiri pǝ lo worokomɛŋwǝ».<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Wǝ́ Yesu ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝlǝ wǝ́ ŋ́ noh koru ǝfǝ rǝkǝsa le enyipǝ ŋ́ ca mǝ? Enyipǝ rǝ fǝŋ wǝ́ pǝ lo ru? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Pǝ lo ru alaatiepipǝ pǝ tini rǝ canɩyǝ, wǝ́ arɛɛpǝ pǝ ya pǝ láa ca narǝwǝ pǝ ŋ tíi apʊŋpwapǝ ǝkǝnǝŋ: “Yǝ la ca bǝŋrǝ yǝ le kpii nǝ paape nǝ nyoo yo! Yǝ le kpii akpɩtɩnɔŋyǝ paape nǝ nyee wee!” <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Duturǝ ɖi, kǝ́ Yowanɛsɩ worokomɛŋwiiritǝyǝ we ŋ pǝlǝ we, lee ke ŋ ri keeriwǝ mǝŋkǝsa, wǝ́ ŋ noo ko ŋ ŋuŋ vɛŋyǝ. Wǝ́ nǝ ka ŋ tɛŋ ǝkǝnǝŋ: “Wɛɛrɔɔrɔɔrǝ gbii rǝ ŋwǝ”. <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Kǝ́ Nyɩmaasɩ le Pi ŋ nǝ pǝ we, lée ri wǝ́ ŋ nóo ŋuŋ. Wǝ́ nǝ nyáa tɛŋ ǝkǝnǝŋ: “Rikpaatǝyǝ mǝ fǝŋŋuŋtǝyǝ wǝ́ ŋ ri. Alaŋpoolɔtǝpǝ mǝ oturɔɔrɔɔyeetǝpǝ la kɛrɩyǝ wǝ́ ŋ ri.” <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Paape epǝ we kpǝlo kɩɩkɩ pǝ ci otuyǝ we, pǝ láa nyɩŋ wǝ pǝ ŋ ci ǝkǝnǝŋ Worokoyǝ lo otuciyǝ yǝ ponu.»<verse eid="LUK 7:35" /></para>
  <para style="s">Yesu lo ko ku mǝ turɔɔrɔɔyeetǝtieyǝ rɛ rǝ Sɩmɔ la nyarǝwǝ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Farisitǝnyiyǝ rɛ tìi Yesu ŋ pǝ ŋ pe ri rǝ nǝ kpǝŋ. Wǝ́ Yesu ŋ kolu. Kǝ́ ŋ ne ke fii we, wǝ́ ŋ kolu ŋ tini ŋ ke ŋ ri. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Tieyǝ rɛ ke kpii rǝ tǝŋtǝǝwǝ we, ke ŋ ri vɔrʊrɔɔrɔɔrǝ. Kǝ́ tieyǝ sa ŋ no nuŋ ǝkǝnǝŋ Yesu tini lée ri rǝ Farisitǝnyiyǝ sa la nyarǝwǝ we, wǝ́ ŋ kolu ŋ fǝ̀ pʊrʊŋtwawǝ rɛ wǝ kpii mǝ apɔŋfɛŋfɛŋpǝ pwɩ ŋ pǝlǝ ŋ rù. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Wǝ́ ŋ pǝlǝ ŋ yà rǝ Yesu la akparǝpɔɔlʊyǝ. Wǝ́ ŋ yà ŋ ke ŋ wee mǝ ŋ fieni na akparǝyǝ. Wǝ́ ŋ fǝ̀ no oyurooyǝ ŋ ka ŋ siɛ enimiyǝ we. Wǝ́ ŋ yà ŋ ka ŋ pala mǝ Yesu la akparǝyǝ, wǝ́ ŋ fǝ̀ apɔŋfɛŋfɛŋpǝ we ŋ ke ŋ fìeni yǝ. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Kǝ́ Farisitǝnyiyǝ we lǝ kpǝŋ Yesu ŋ ke tini ŋ na nyɩŋ tuwǝ sa we, wǝ́ ŋ ka ŋ tɛŋ rǝ nǝ mǝrǝ ǝkǝnǝŋ: «O koh nuŋ worokokpɛɛnuŋtɛŋtǝyǝ wǝ́ nyiyǝ sa ŋ ri we, kah nyɩŋ tieyǝ lǝ yǝ wǝrʊʊkpǝ ŋ ya ŋ nóo ru ŋwǝ ŋ ci, duturǝ ɖi turɔɔrɔɔyeetǝyǝ wǝ́ ŋ ri.» <verse eid="LUK 7:39" /><verse number="40" style="v" sid="LUK 7:40" />Wǝ́ Yesu ŋ tìi Farisitǝnyiyǝ sa ǝkǝnǝŋ: «Sɩmɔ, ŋ́ lǝǝmǝ dierǝ rɛ ŋ́ neh tíi lǝ́.» Wǝ́ Sɩmɔ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ tɛŋ, Tukaŋtǝyǝ.» <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Enyipǝ rɛ eyi pǝ ke re kɛrɩyǝ rɛ lo wǝtookpǝ. Kɛrɩyǝ sa lóo tuu enyipǝ la sɩkayǝ. Nyisǝsǝŋyǝ ke re ŋwǝ sɩkakpotokpotoyǝ tuurutʊʊ, wǝ́ nyiyitǝyǝ ŋ ke re ŋwǝ sɩkakpotokpotoyǝ tǝtʊʊ. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Kǝ́ pǝle eyi pǝ laa ya pǝ lóo koru wǝtookpǝ sa la amwara we, wǝ́ kɛrɩyǝ we ŋ fǝ̀ wǝtookpǝ we ŋ cɛ̀ɛ pǝ. Rǝ enyipǝ sa eyi lǝ mǝrǝ wǝǝ, ǝlǝ ŋ nah taa kɛrɩyǝ sa lǝ kǝǝwǝ ŋ teeri wǝ?» <verse eid="LUK 7:42" /><verse number="43" style="v" sid="LUK 7:43" />Wǝ́ Sɩmɔ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Rǝ mǝ anyɩŋkǝ we, yǝ we lo wǝtoomumuŋkpǝ pǝ lǝ fǝ pǝ la cɛɛ ŋ lǝǝwe.» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «A la tɛŋ wǝ ponu». <figure style="fig" alt="Une femme pleure sur les pieds de Jésus et les essuie avec ses cheveux" file="WA03839b.tif" size="col" copy="Graham Wade" ref="7:38">Tieyǝ rɛ le wee le fieni Yesu la akparǝyǝ wǝ́ ŋ nǝ fǝ no oyurooyǝ ŋ na siɛ yǝ</figure><verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Wǝ́ Yesu ŋ sìɛrɩ ŋ ka ŋ yɩrɩ tieyǝ we, wǝ́ ŋ tìi Sɩmɔ ǝkǝnǝŋ: «A ya láa nyɩŋ tieyǝ sa? Kǝ́ ŋ́ nǝ pǝ lǝ́ kpǝŋ we, o loo koonu mǝ mɛŋwǝ ŋ́ wɛ akparǝyǝ. Paape ŋwǝ paa, le wee enimiyǝ le fieni mǝ akparǝyǝ, wǝ́ ŋ nǝ fǝ no oyurooyǝ ŋ na siɛ mǝ yǝ. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Kǝ́ ŋ́ ne pe fii e lee ce o munu mǝ mǝ, paape ǝrǝ kǝ́ ŋ́ na nya ŋ́ ne pe fii we, wǝ́ tieyǝ sa ŋ ya ŋ náa pala mǝ akparǝyǝ. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />O loo co apɔŋpǝ e fieni mǝ yurǝ<note caller="+" style="f"><char style="fr" closed="false">7:46 </char><char style="ft" closed="false">Rǝ gakarǝ we, Oyudatǝpǝ pǝ ke ŋ fieni sǝǝyǝ la apɔŋpǝ kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ pǝ la lɔ ŋwǝ sɩsiɛrɩ.</char></note>, tieyǝ sa ŋwǝ paa, lǝ fǝ apɔŋfɛŋfɛŋpǝ le fieni mǝ akparǝyǝ. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Kǝto ŋ́ ya ŋ́ née tíi lǝ́ wǝ ǝkǝnǝŋ kǝǝtaamumuŋwǝ sa tieyǝ sa ŋ nǝ fǝ ŋ no koonu mǝ we, wǝ ya wǝ láa pɔrʊ wǝ ŋ kaŋ ǝkǝnǝŋ pǝ lǝ fǝ no oturɔɔrɔɔmumuŋyǝ we ŋ ne yee kpǝlo pǝ la cɛɛ ŋwǝ. Paa mǝŋ rɛ le yee oturɔɔrɔɔyǝ yǝ laa naanǝ kpǝŋwǝ, wǝ́ pǝ lǝ fǝ yǝ pǝ la cɛɛ ŋwǝ we, ŋwǝ ŋkpɛ nǝ kǝǝtaawǝ wǝ lǝŋ naanǝ.» <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />Wǝ́ Yesu ŋ tìi tieyǝ sa ǝkǝnǝŋ: «Ŋ́ nǝ fǝ ló oturɔɔrɔɔyǝ ŋ́ na cɛɛ lǝ́». <verse eid="LUK 7:48" /><verse number="49" style="v" sid="LUK 7:49" />Wǝ́ enyipǝ we pǝ ke tini pǝ ke ŋ ri mǝ Yesu pǝ ka ŋ tɛŋ rǝ pǝlǝ mǝrǝ ǝkǝnǝŋ: «Yǝ rǝ fǝŋ ŋ lǝmǝ yǝ ǝnǝ ŋ ya ŋ́ nóo tu turuwǝ mǝ ŋ fǝ oturɔɔrɔɔyǝ mǝ ŋ cɛɛ wǝ?» <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />Paape wǝ́ Yesu ŋ tìi tieyǝ we ǝkǝnǝŋ: «A la lɔ mǝ o lo nuŋ wǝ́ a la nya alɔkuŋkǝ. Mǝ ko rǝ wǝtaarǝkpǝ lǝ mǝrǝ.»<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Etiepǝ we pǝ ke siimǝ Yesu la anyɩŋyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Yesu ŋ kolu ŋ ka ŋ tɛŋ Worokoyǝ le wǝpilirikpǝ le Dieceeceerǝ mǝ ŋ tɛlɩ rǝ ǝtǝŋtǝǝyǝ mǝ ǝtǝŋtǝǝpiyǝ. Ne enyikpiipǝ we tǝ mǝ eyi pǝ ke siimǝ ŋwǝ. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Etiepǝ rɛ lǝ mǝrǝ Yesu ŋ pìri awɛɛrɔɔrɔɔyǝ mǝ arɛɛpǝ ŋ cà anyarǝpiyǝ ŋpee pǝ ka kʊla. Ŋpǝ pǝ kaamǝ: Marɩya, yǝ we ŋ no ru rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Magǝdala. Ŋwǝ Marɩyayǝ sa lǝ mǝrǝ wǝ́ awɛɛrɔɔrɔɔyǝ apǝrɩmata yǝ rù rǝ wǝ. <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Kuza le tie Yowana. Kuza ke ri Erodɛsɩ la nǝnɛyeetǝyǝ, Suzana mǝ epǝ we kpǝlo kɩɩkɩ pǝ kǝ ŋ fǝ pǝlo otulǝmǝyǝ pǝ ŋ toŋ Yesu mǝ ne enyikpiipǝ we wǝ.<verse eid="LUK 8:3" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ tɛɛtɛɛkpɛŋtǝyǝ rɛ</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matewu 13:1-9</ref>, <ref loc="MRK 4:1-9">Marǝko 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Enyipǝ pǝ ko ŋ ru rǝ tǝŋtǝ ri ŋ tǝŋtǝ pǝ ŋ pǝ Yesu lǝ kpǝŋ. Wǝ́ kǝ́ Yesu ŋ na nyɩŋ nyikpǝŋmumuŋwǝ rɛ wǝ lo po ku we, wǝ́ ŋ cà duturǝ sa ŋ tɛnɩ ǝkǝnǝŋ: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />«Tɛɛtɛɛkpɛŋtǝyǝ rɛ kolu ŋ ka caŋ otuyǝ rǝ na atɛɛkǝ. Kǝ́ ŋ ya ŋ nóo co otuyǝ we we, wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ kʊŋlɛɛrɩwǝ yǝ kolu. Wǝ́ enyipǝ pǝ yàpǝ yǝ, wǝ́ ofuripǝ pǝ pǝlǝ pǝ sìeni yǝ pǝ pɔ̀ɔlʊ kɩɩkɩ. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ zwiɛŋrǝ lǝ kǝtǝǝwǝ. Kǝ́ yǝ le wiili we, wǝ́ yǝ yeli naa. Duturǝ ɖi yǝ laa nya kǝtǝǝtaarǝwǝ. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ owuyǝ lǝ mǝrǝ. Wǝ́ epiyǝ we mǝ owuyǝ we yǝ wìili cɛɛcɛ. Wǝ́ owuyǝ we yǝ lɔ̀ yǝ. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ kǝtǝǝceeceewǝ. Wǝ́ yǝ wìili, wǝ́ yǝ nyɩnɩ ŋpa.» Wǝ́ Yesu ŋ tǝ rɛɛrɩ mǝ kpɛɛwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Yǝ we ŋ lǝǝmǝ otukoŋyǝ ŋ nóo nuŋ tuwǝ we, ŋ nuŋ oo!»<verse eid="LUK 8:8" /></para>
  <para style="s">Kǝ́ kǝto wǝ́ Yesu ŋ náa wɛɛlɩ mǝ ŋ ca rǝ otutuyǝ wǝ?</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matewu 13:10-17</ref>, <ref loc="MRK 4:10-12">Marǝko 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Wǝ́ Yesu lo otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ Yesu ǝkǝnǝŋ: «Duturǝ sa a la ca lǝ mǝrǝ ɖi nɛ?» <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝ wǝ́ Worokoyǝ ŋ na pɔrʊ ne wǝpilirikpǝ lo otuŋwaayǝ ŋ na kaŋ wǝ. Paa ŋ́ ya ŋ́ náa tɛŋ otuyǝ sa mǝ ŋ tíi enyipʊŋpwapǝ mǝ otutucayǝ. Tuwǝ kǝto pǝ lóo koru a mǝ nyɩŋ mǝŋkǝsa, paape pǝ lǝŋ nyɩŋ pǝ ci, kǝ pǝ lɛ pǝ koru o mǝ nuŋ, paape pǝ lǝŋ nuŋ yǝlo dutu.»<verse eid="LUK 8:10" /></para>
  <para style="s">Yesu la pɔrʊ duturǝ we ŋ na ca lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matewu 13:18-23</ref>, <ref loc="MRK 4:13-20">Marǝko 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Rǝkǝsa we, duturǝ sa ŋ́ na ca lǝ mǝrǝ gaamǝ wǝ: Oturʊʊyǝ we yǝ kaamǝ Worokoŋtierǝ. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Kʊŋlɛɛrɩwǝ we epiyǝ yǝ la tɔɔlʊ yǝ lo ko we wǝ kaamǝ enyipǝ we pǝ lóo nuŋ Worokoŋtierǝ, paa Abʊŋsamʊyǝ ŋ pa pɔrʊ dierǝ we rǝ pǝlo yurǝ, kǝ pǝ paa nya fɛɛ pǝ lɔ pǝ nuŋ kǝ pǝ nya alɔkuŋkǝ. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Zwiɛŋrǝ lǝ kǝtǝǝwǝ epirɛɛyǝ yǝ la tɔɔlʊ we, wǝ kaamǝ enyipǝ we pǝ lóo nuŋ Worokoŋtierǝ oturu pǝ la lɔ rǝ mǝ faawǝ. Paa pǝ lǝŋ maa dierǝ sa ɖu okuruŋkuyǝ rǝ pǝlǝ mǝrǝ. Pǝ lǝŋ lɔ pǝ nuŋ pǝ ko wǝlǝǝrǝkpǝ. Vǝ́ vuupirǝ rɛ la nya lǝ pǝ ko, oturu pǝ la nyarǝ lɔnuŋrǝ pǝ lo co. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Epiyǝ we yǝ la tɔɔlʊ rǝ owuyǝ lǝ mǝrǝ yǝ kaamǝ enyipǝ we pǝ lóo nuŋ Worokoŋtierǝ. Paape oyupuyǝ, otulǝmǝyǝ mǝ vɔrʊrǝ sa lo otucakpɛɛyǝ yǝ la lɔ pǝ, pǝ lǝŋ re pǝ ko kǝnyɩŋkǝ. Wǝ́ pǝla lɔnuŋrǝ lǝŋ kuru. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Epiyǝ we yǝ la tɔɔlʊ rǝ kǝtǝǝceeceewǝ yǝ kaamǝ enyipǝ we pǝ lǝ́ǝ fǝ pǝla ziɔŋceeceerǝ fee pǝ ŋ nuŋ Worokoŋtierǝ sɩsiɛrɩ, pǝ ŋ lɔ rǝ pǝ re. Wǝ́ pǝ láa lɛ pǝ ŋ nyɩɩ pǝ ŋ tɔ pǝ ŋ yaa, pǝ ŋ nyɩŋ ǝtǝnǝyǝ.»<verse eid="LUK 8:15" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ kaŋrewǝ</para>
  <para style="r">(<ref loc="MRK 4:21-25">Marǝko 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />Rɛ lǝŋ too kaŋrewǝ ŋ lɛ kǝ ŋ fǝ yawayǝ ŋ punu wǝ amaa kǝ ŋ fǝ wǝ ŋ ke kpii rǝ buluŋrǝ. Paa pǝ lǝ́ǝ fǝ wǝ pǝ ŋ tɛɛ rǝ tutɛɛkaŋrewǝ, kǝ wǝ nya fɛɛ wǝ ŋ nyɩnɩ epǝ we pǝ leh fii nyarǝwǝ wǝ. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Duturǝ ɖi tu ri ŋ tu wǝ la ŋwaa we, pǝ lǝ́ǝ pǝ pǝ ŋ pɔrʊ wǝ pǝ ŋ fɛlɩ. Wǝ́ tuŋwaawǝ rɛ wǝ laa lɛ wǝ kpii kǝ oturu pǝ lǝŋ pe ci wǝ. Tu ri ŋ tu wǝ loh po ru wǝnyɩɩnɩkpǝ. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Kǝto nǝ yee nǝ wɛ lo yurǝ kǝ nǝ nuŋ etieyǝ sa ŋ́ ya ŋ́ née tíi nǝ sɩsiɛrɩ. Duturǝ ɖi yǝ we ŋ lǝǝmǝ tuwǝ we, pǝ lǝ́ǝ tǝ pǝ ŋ koonu ŋwǝ pǝ kʊla. Paa yǝ we ŋ nǝǝ lǝmǝ tǝrɛ we, pǝ láa lɔ tuwǝ rǝ ŋwǝ, mǝŋ pipiwǝ we ŋ ya ŋ nóo pu ǝkǝnǝŋ wǝ kpɛɛlɩ ŋwǝ wǝ.<verse eid="LUK 8:18" /></para>
  <para style="s">Yesu le lee mǝ Yesu la apaanʊpǝ pǝ lǝ pǝ Yesu lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matewu 12:46-50</ref>, <ref loc="MRK 3:31-35">Marǝko 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Yesu le lee mǝ Yesu la apaanʊpǝ pǝ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ kǝ́ enyipǝ pǝ ka naanǝ kǝto we, pǝ laa nya kʊŋwǝ pǝ kǝlǝ mǝ ŋwǝ. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Wǝ́ nyiyǝ rɛ ŋ kolu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lé lee mǝ lá apaanʊpǝ pǝ yaa rǝ koruwǝ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ nyɩŋ lǝ́.» <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Epǝ we pǝ ya pǝ lóo nuŋ Worokoŋtierǝ, wǝ́ pǝ lée yee pǝ ŋ saŋ rǝ rǝ we, ŋpǝ pǝ ri mǝ lee mǝ mǝ apaanʊpǝ.»<verse eid="LUK 8:21" /></para>
  <para style="s">Yesu la taarǝ kǝkpǝkǝ</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matewu 8:23-27</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Jirɛɛrǝ, Yesu fìi gʊrɔrǝ ŋpǝ mǝ no otukarǝtǝpǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝ la ta puŋkɔwǝ sa lo ko kǝtakǝ nɔ.» Wǝ́ pǝ ko ŋ ko. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Kǝ́ pǝ kpìi pǝ lóo ko we, wǝ́ Yesu ŋ kolu ŋ kpɛlɩ eniŋrieyǝ. Wǝ́ kǝkpǝmumuŋkǝ rɛ kǝ pǝlǝ kǝ ko ŋ fuŋ rǝ puŋkɔwǝ sa. Wǝ́ mɛŋwǝ wǝ ke ŋ yi wǝ ŋ fii gʊrɔrǝ we. Wǝ́ nimirǝ mwɛ̀ɛrɩ pǝ ŋpa. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ sàanǝ ŋwǝ pǝ tìi ǝkǝnǝŋ: «Tukaŋtǝyǝ, Tukaŋtǝyǝ, yǝ lǝh kpǝ́!» Kǝ́ Yesu ŋ na saanǝ we, wǝ́ ŋ fanǝ ǝrǝfuŋkǝ we mǝ mɛŋwǝ we wǝ ke ŋ yi wǝ ŋ ca wǝ, wǝ́ fɛɛwǝ we wǝ rǝnǝ yiriri. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Wǝ́ ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Kǝnǝ nǝ lɔnuŋrǝ wǝǝ?» Wǝ́ wǝ cò pǝlo vurǝ, wǝ́ wǝ lɛ̀ wǝ rili pǝlo mumuŋ. Wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Ǝlǝ ŋ kaamǝ nyiyǝ sa kǝtǝŋkǝ ŋ náa wɛɛlɩ mǝ ŋ tíi ǝrǝfuŋkǝ mǝ mɛŋwǝ, oturu yǝ lo nuŋ no tutɛŋwǝ?»<verse eid="LUK 8:25" /></para>
  <para style="s">Yesu la cá yufiitǝyǝ rɛ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Wǝ́ pǝ kolu pǝ rò puŋkɔwǝ we la kǝlɛɛrɩkǝ, kǝ ri Ekerasetǝpǝ lǝ gǝŋrǝ, láa yɩrɩ Galileya lǝ ŋ maŋ. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Kǝ́ Yesu ŋ na nya ŋ na sʊʊ ŋ na pa yaa rǝ kǝtǝǝwǝ eni we, wǝ́ nyiyǝ rɛ rǝ tǝŋtǝǝwǝ we ŋ rù ŋ kǝ ŋ pǝ ŋ po ku mǝ ŋwǝ. Awɛɛrɔɔrɔɔyǝ yǝ ke kpii rǝ nyiyǝ sa. Fǝǝ tǝ ŋ kpii kǝkpakǝ ŋ nyɩŋ wǝ la panǝ. Lǝǝ kǝ tǝ ŋ kpii rǝ nyarǝwǝ, ofuŋtɔŋyǝ lǝ mǝrǝ wǝ́ ŋ ka ŋ kpɛɛ. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Kǝ́ ŋ na nyɩŋ Yesu we, wǝ́ ŋ kolu ŋ kʊnʊ ŋwǝ, wǝ́ ŋ yà ŋ ka ŋ lɔ anarǝyǝ, wǝ́ ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Yesu, Worokoyǝ ŋ tɛɛ rǝ oŋuŋkǝ le Piyǝ, kǝ́ wǝ kpii rǝ ŋlǝ mǝ lǝ́ lǝ mǝrǝ? Dɔɔkpɛ, poo kuŋ kǝ ŋ́ nyɩŋ ariaayǝ.» <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Wǝ́ Yesu ŋ fanǝ wɛɛrɔɔrɔɔrǝ sa ɖu rǝ nyiyǝ sa lǝ mǝrǝ. Wɛɛrǝ sa ge ŋ kpii nyiyǝ sa la awɛɛlɩkǝ eni ŋ ri eni. Pǝ ke ŋ kpii na akpɛtɛɛyǝ pǝ ŋ tǝnǝ, paape ŋ sǝǝrǝ yǝ. Oturu wɛɛrɔɔrɔɔrǝ sa lǝ fǝ ŋwǝ la tɛlɩ fɛɛwǝ we nyiyǝ rɛ ŋ nǝǝ kǝlǝ wǝ. <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Lá nyɩŋrǝ ɖi nɛ?» Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ «Kpǝŋwǝ», kpiikǝ awɛɛrɔɔrɔɔyǝ yǝ ke kpii rǝ ŋwǝ yǝ naanǝ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Wǝ́ yǝ yà yǝ ke ŋ kpii Yesu la dɔɔkpɛɛrǝ ŋ pee piri yǝ ŋ kpii rǝ arianyɩŋyǝ lo koŋfuŋwǝ<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Arianyɩŋyǝ lo koofuŋwǝ wǝ ri rǝ fɛɛwǝ rɛ Oyudatǝpǝ pǝ la lɔ pǝ lo nuŋ ǝkǝnǝŋ wǝ ri enyiǝtǝpǝ la fɛɛtiiwǝ. Wǝ kpii rǝ kǝtǝǝwǝ. Fɛɛwǝ ke Worokoyǝ ŋ na lɔ awɛɛrɔɔrɔɔyǝ ŋ nǝ tǝnǝ kǝ ŋ pa ta yǝ lo kǝtukoŋkǝ mǝ jitutururǝ we wǝǝ. </char></note>. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />Eniyǝ we lǝ mǝrǝ we, fáŋkpǝŋmumuŋwǝ rɛ wǝ ka yaa wǝ ke ŋ ri rǝ dutupirǝ rɛ. Wǝ́ awɛɛrɔɔrɔɔyǝ sa yǝ kpìi Yesu la dɔɔkpɛɛrǝ ŋ maa yǝ yǝ ke fii rǝ afáŋpǝ we. Wǝ́ Yesu ŋ kòonu yǝ la gʊŋrǝ. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Wǝ́ awɛɛrɔɔrɔɔyǝ we yǝ rù rǝ nyiyǝ sa yǝ kolu yǝ fìi rǝ afáŋpǝ we. Wǝ́ fáŋkpǝŋwǝ we wǝ rù rǝ kǝlaŋlaŋkǝ we wǝ pǝlǝ wǝ tɔ̀ɔlʊ rǝ puŋkɔwǝ we, wǝ́ pǝ ŋunu mɛŋwǝ pǝ kpǝ̀. <verse eid="LUK 8:33" /><verse number="34" style="v" sid="LUK 8:34" />Kǝ́ afáŋrǝŋtǝpǝ we pǝ la nyɩŋ tuwǝ sa we, wǝ́ pǝ sùu pǝ pwɛ̀yɩ pǝ kolu pǝ tɛnɩ tuwǝ sa rǝ tǝŋtǝǝwǝ we mǝ epwiitǝŋyǝ. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Wǝ́ enyipǝ pǝ rù pǝ kǝ ŋ pǝ pǝ pa yɩrɩ tuwǝ we wǝ lǝ pǝ wǝ. Kǝ́ pǝ lo po tuu Yesu we, wǝ́ pǝ nyɩnɩ nyiyǝ we lǝ mǝrǝ awɛɛrɔɔrɔɔyǝ yǝ lo ru wǝ, le kpii wǝkpakpǝ tini rǝ Yesu lǝ kpǝŋ, enimiyǝ yǝ le celi ŋwǝ. Wǝ́ wǝ cò pǝ lo vurǝ. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Wǝ́ enyipǝ we pǝ nyɩnɩ tuwǝ sa we, pǝ fǝ̀ pǝ pɔ̀ kǝkpǝŋkǝ sa la amayǝ, kǝ́ wǝ le yee wǝ́ nyiyǝ sa ŋ na kpaa wǝ. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Wǝ́ Ekerasetǝpǝ we kpǝlo pǝ ke ŋ tíi Yesu ǝkǝnǝŋ ŋ pwɛyɩ rǝ pǝlǝ kpǝŋ, duturǝ ɖi pǝ fìi vumumuŋrǝ rɛ ŋpa. Wǝ́ Yesu ŋ fìi gʊrɔrǝ ŋ kpìi ŋ kpǝ̀lǝŋ. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Wǝ́ nyiyǝ we lǝ mǝrǝ awɛɛrɔɔrɔɔyǝ yǝ rù ŋ ke ŋ kpii Yesu la dɔɔkpɛɛrǝ kǝ ŋ siimǝ ŋwǝ. Paape wǝ́ Yesu ŋ sìɛnɩ ŋwǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />«Kpǝlǝŋ o mǝ ko lá nyarǝwǝ kǝ a ka tɛŋ tuwǝ we Worokoyǝ ŋ ne yee ŋ no koonu lǝ́ e tíi enyipǝ.» Wǝ́ nyiyǝ sa ŋ ko ŋ ko, wǝ́ ŋ kolu ŋ tɛnɩ tuwǝ we Yesu ŋ ne yee ŋ no koonu ŋwǝ ŋ tɛ̀lɩ, rǝ tǝŋtǝǝwǝ we kpǝlo.<verse eid="LUK 8:39" /></para>
  <para style="s">Tieyǝ rɛ lo ru Yesu la kǝkpakǝ wǝ́ ŋ na kpaa, wǝ́ Yesu ŋ na saanǝ Yayiro la gɔrʊpirǝ lǝ kpǝ́ wǝ</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matewu 9:18-26</ref>, <ref loc="MRK 5:21-43">Marǝko 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Kǝ́ Yesu ŋ nǝ kpǝlǝŋ ŋ nǝ pǝ ŋ neh fii we, wǝ́ enyipǝ pǝ pǝlǝ pǝ kù mǝ ŋwǝ, duturǝ ɖi pǝlo kpǝlo pǝ yà pǝ kǝ ŋ rǝŋ ŋwǝ. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Wǝ́ nyiyǝ rɛ pǝ lóo pwo Yayiro ŋ pǝlǝ ŋ ko ŋ ru. Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ lo mumuŋyǝ wǝ́ ŋ ri. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ ŋ ke ŋ kpii Yesu la dɔɔkpɛɛrǝ kǝ ŋ pǝ na nyarǝwǝ. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Duturǝ ɖi, ne diepiceŋceŋrǝ, láa lɔ mǝŋ cɛŋwǝ tǝ mǝ yi ga kpɛlɩ gǝ ŋ kpǝ́. Kǝ́ Yesu ŋ no ru ŋ noh ko Yayiro la nyarǝwǝ we, wǝ́ enyipǝ pǝ kù rǝ ŋwǝ sisi pǝ ko ŋ ko. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Tieyǝ rɛ ka yaa rǝ fɛɛwǝ we, Tieyǝ sa ka ŋ sʊʊ ŋpǝrayǝ cɛŋwǝ tǝ mǝ yitǝwǝ wǝǝ. Wǝ́ ŋ lɛ̀ no otulǝmǝyǝ kɩɩkɩ rǝ awɛɛcátǝpǝ lǝ kpǝŋ, paape rɛ ŋ ri rɛ loo koru ŋwǝ la acá. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Wǝ́ tieyǝ sa ŋ ko ŋ ruu mǝ ŋ kǝlǝ mǝ Yesu rǝ kǝmaakǝ, wǝ́ ŋ rùu na kǝkpakǝ la laawǝ. Wǝ́ na ŋpǝrayǝ we ŋ sǝnǝ rǝ kǝyaakǝ we. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Wǝ́ Yesu ŋ pǝ̀ ǝkǝnǝŋ: «Ǝlǝ ŋ no ruu mǝ wǝ?» Yǝ o nuŋ ŋkǝ ŋwǝ, yǝ o nuŋ ŋkǝ ŋwǝ. Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, enyipǝ sa pǝ le sii lǝ́ we, pǝ ya pǝ láa nyɩnɩ lǝ́.» <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />Paape wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ rɛ lo ruu mǝ, ŋ́ na nyɩŋ wǝ ŋ́ ne ci, okopiyǝ rɛ yǝ lo ru rǝ mǝ mǝrǝ.» <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Kǝ́ tieyǝ sa ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ nǝŋ tǝ ŋ koru na wɛ la aŋwaa we, wǝ́ ŋ rù ŋ kǝ pǝ, láa ca kpakpa, wǝ́ ŋ pǝlǝ ŋ kʊnʊ Yesu. Wǝ́ ŋ ka ŋ tɛŋ tuwǝ we wǝ lo koonu kǝto wǝ́ ŋ no po ruu Yesu la kǝkpakǝ mǝ kǝ́ wǝ le yee wǝ́ ŋ na kpaa kǝtǝrǝceŋceŋ mǝ ŋ tíi kǝkpǝŋkǝ we kpǝlo. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ kɔrʊ, lá lɔnuŋrǝ la pɔrʊ lǝ́. Mǝ ko rǝ wǝtaarǝkpǝ lǝ mǝrǝ.» <verse eid="LUK 8:48" /><verse number="49" style="v" sid="LUK 8:49" />Eniyǝ we Yesu ŋ tǝ ŋ ya ŋ náa wɛɛlɩ we, wǝ́ nyikpiiyǝ rɛ ŋ rù rǝ Yayiro la nyarǝwǝ ŋ pǝlǝ ŋ tìi Yayiro ǝkǝnǝŋ: «Lá kɔrʊ lǝ kpǝ́. Pǝǝ tǝ ekpii tukaŋtǝyǝ la awɛɛlɩkǝ.» <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />Ke ci Yesu lo nuŋ dierǝ sa, wǝ́ ŋ tìi Yayiro ǝkǝnǝŋ: «Poo suu vurǝ, lɔ o nuŋ rǝ ko, lé piyǝ láa saanǝ.» <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />Kǝ́ Yesu ŋ ne ke fii nyarǝwǝ we we, laa tɛɛnɩ rɛ ŋ fii ŋ kʊla mǝ ŋwǝ ŋ teerɩ Pɛtǝro, Yowanɛsɩ mǝ Yakubu fǝ kʊla mǝ piyǝ we lǝ tǝ mǝ ne lee. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Enyipǝ kpǝlo pǝ yà pǝ ke ŋ wee, wǝ́ pǝ ka ŋ nʊmʊ rǝ piyǝ sa lo yurǝ. Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pǝǝ tǝ nǝ wee, lǝǝ kpǝ́, ya láa kpɛɛ eniŋrieyǝ rǝ.» <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />Wǝ́ enyipǝ we pǝ yà pǝ ka ŋ mɔɔnʊ Yesu, duturǝ ɖi pǝ ke ci wǝ ǝkǝnǝŋ gɔrʊpirǝ sa lǝ kpǝ́. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Wǝ́ Yesu ŋ tà na akaakǝ, wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Mǝ piyǝ, yi a yaa!» <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Wǝ́ piyǝ sa la wɛɛrǝ zìɛnɩ bǝlǝ na wɛ lǝ mǝrǝ, wǝ́ ŋ yili ŋ yàa kǝtǝrǝceŋceŋ, wǝ́ Yesu ŋ tìi pǝ pǝ koonu piyǝ sa le keeriwǝ ŋ ri. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Wǝ́ wǝ rili piyǝ sa lǝ tǝ peni lo mumuŋ ŋpa, wǝ́ Yesu ŋ tìi pǝ pǝ paa tɛŋ tuwǝ sa wǝ lǝ pǝ pǝ tíi rɛ.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesu le kpii ne enyikpiitǝmeyipǝ we la kǝnǝnɛkǝ</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matewu 10:5-15</ref>, <ref loc="MRK 6:7-13">Marǝko 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yesu kù mǝ ne enyikpiipǝ we pǝlǝ tǝ mǝ eyi. Wǝ́ ŋ kòonu pǝ lo okopiyǝ kǝ pǝ ŋ piri awɛɛrɔɔrɔɔyǝ kpǝlo kɩɩkɩ, kǝ pǝ ŋ lɛ pǝ ŋ cá anyarǝpiyǝ. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Wǝla kǝmaakǝ we, wǝ́ ŋ kpìi pǝ pǝ ka tɛŋ Worokoyǝ le wǝpilirikpǝ le dierǝ pǝ tíi enyipǝ, kǝ pǝ lɛ pǝ cá anyaatǝpǝ. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pee re tǝrɛ nǝ saŋ. Nǝ pee re cisaŋwǝ, akpoyǝ, keeriwǝ amaa sɩkayǝ, nǝ paa lɛ nǝ re wǝkpakpǝ wǝyi. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Vǝ́ rɛ la ka lɔ nǝ kǝsǝǝkǝ rǝ na nyarǝwǝ we, nǝ tii rǝ nyarǝwǝ we po ro eniyǝ we nǝ nya pwɛyɩ nǝ nya tɛlɩ tǝŋtǝǝpʊŋpwawǝ. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Vǝ́ nǝ nyée ke fii tǝŋtǝǝwǝ rɛ, wǝ́ enyipǝ pǝ laa lɔ nǝ kǝsǝǝkǝ we, nǝ tɛrɩ naŋrǝ we dɛɛ rǝ nǝ akparǝyǝ nǝ tǝnǝ<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Kǝ́ Oyudatǝpǝ pǝ ke ŋ yee wǝǝ kǝ pǝ fǝ pǝ kaŋ ǝkǝnǝŋ: «Mǝ akparǝ, mǝ onu ŋ́ naa kʊla».</char></note>, kǝ nǝ pwɛyɩ rǝ tǝŋtǝǝwǝ we, kǝ pǝ nyɩŋ wǝ pǝ ci ǝkǝnǝŋ pǝ le yee wǝ loo poŋ.» <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Wǝ́ enyikpiipǝ we pǝ pwɛyɩ pǝ ko ŋ ko. Wǝ́ pǝ ke ŋ fii tǝŋtǝǝpi ri ŋ tǝŋtǝǝpi pǝ ŋ tɛŋ Dieceeceerǝ we, wǝ́ pǝ ka ŋ cá anyaatǝpǝ.<verse eid="LUK 9:6" /></para>
  <para style="s">Erodɛsɩ ya lǝ́ǝ pǝ́ ŋ nyɩŋ yǝ we kororo pǝ lóo pwo Yesu wǝ</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matewu 14:1-12</ref>, <ref loc="MRK 6:14-29">Marǝko 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Erodɛsɩ ke ri piliyǝ rǝ Galileya. Wǝ́ ŋ nunu otuyǝ we kpǝlo kɩɩkɩ Yesu ŋ ya ŋ née yee, lee ci kǝ́ ŋ neh yee ŋ fǝ. Duturǝ ɖi enyirɛɛpǝ pǝ yà pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.» <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Arɛɛpǝ ǝkǝnǝŋ: «Eliya ŋ na siɛnɩ ŋ nǝ pǝ.» Wǝ́ apʊŋpwapǝ ke pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Akakatǝworokokpɛɛnuŋtɛŋtǝpǝ we la rɛ ŋ na siɛnɩ ŋ no po ru.» <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Wǝ́ Erodɛsɩ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ Yowanɛsɩ we, ŋmǝŋmǝ ŋ́ no koonu pǝ lǝ sǝ no yurǝ. Ǝlǝ paa ŋ kaamǝ nyiyǝ sa le etieyǝ pǝ ya pǝ láa tɛŋ wǝ, wǝ́ ŋ́ ya ŋ́ nóo nuŋ ǝnǝ?» Wǝ́ Erodɛsɩ ŋ kǝ ŋ pǝ́ ŋ nyɩŋ Yesu.<verse eid="LUK 9:9" /></para>
  <para style="s">Yesu lo koonu nyikpǝŋmumuŋwǝ rɛ le keeriwǝ</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matewu 14:13-21</ref>, <ref loc="MRK 6:30-44">Marǝko 6:30-44</ref>, <ref loc="JHN 6:1-14">Yowanɛsɩ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Kǝ́ enyikpiipǝ we pǝ la siɛnɩ pǝ le pe fii we, wǝ́ pǝ fǝ̀ otuyǝ we kpǝlo kɩɩkɩ pǝ kolu pǝ yeli pǝ pɔ̀ Yesu la amayǝ. Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ pǝ siimǝ ŋwǝ. Wǝ́ pǝ rùu pǝ rù rǝ nyikpǝŋwǝ we lǝ kpǝŋ. Wǝ́ pǝ ko ŋ ko tǝŋtǝǝwǝ rɛ pǝ lóo pwo Besayɩda. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Paape kǝ́ nyikpǝŋwǝ we wǝ la nyɩŋ wǝ wǝ le ci ǝnǝ we, wǝ́ ŋpǝ ŋkpɛ pǝ yili pǝ sìimǝ pǝ. Wǝ́ Yesu ŋ tɛ̀ɛnɩ ŋ lɔ̀ pǝ. Wǝ́ ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ le wǝpilirikpǝ mǝ ŋ tíi pǝ. Wǝ́ ŋ lɛ ŋ cá enyipǝ we pǝ laa ka kpaa wǝ. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />Kǝ́ kǝ lah ta kǝ cɩɩ we, wǝ́ enyikpiitǝmeyipǝ we pǝ rùu pǝ kǝ̀lǝ mǝ Yesu wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Co nyikpǝŋwǝ sa la kʊŋ pǝ ŋ ko ǝtǝŋtǝǝpiyǝ we mǝ epwitǝŋyǝ we yǝ kpii rǝ gaarǝ sa wǝ, kǝ pǝ ka taa tǝrɛ pǝ ri kǝ pǝ kpɛɛ rǝ we. Duturǝ ɖi nyarǝwǝ rɛ wǝ laa yaa rǝ fɛɛwǝ sa la yaa wǝ.» <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />Paape wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝŋnǝ nǝ koonu pǝ le keeriwǝ pǝ ri.» Wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Kpɔnɔyǝ tʊʊ mǝ wǝpwɛɛkpǝ wǝyi ko wǝ kpɛlɩ lǝ. Amaa ǝ lǝ pǝ́ e ke kpii lǝ lo ko fuu keeriwǝ lo po koonu enyipǝ sa kpǝlo?» <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Ǝpǝrǝŋpǝ pǝ ka yaa rǝ fɛɛwǝ we, pǝ lóo ro lafawǝ tʊʊ. Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Nǝ sǝpǝ pǝ nǝ tiini enyipǝ tǝtʊʊ tǝtʊʊ.» <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Wǝ́ pǝ yeli mǝŋ kǝ́ Yesu ŋ ne tíi pǝ wǝ. Wǝ́ enyipǝ we pǝ sɔ̀ pǝ tini pǝlo kpǝlo. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Wǝ́ Yesu ŋ fǝ̀ kpɔnɔyǝ we na tʊʊ mǝ wǝpwɛɛkpǝ we wǝle wǝyi. Wǝ́ ŋ yìili ŋ yɩ̀rɩ yulaarǝ, wǝ́ ŋ mwɛnɩ nyuŋkpǝ ŋ pɛ̀ɛrɩ kpɔnɔyǝ we mǝ wǝpwɛkpǝ we. Wǝ́ ŋ pòolu yǝ, wǝ́ ŋ fǝ̀ ŋ kòonu no otukarǝtǝpǝ kǝ ŋpǝ ŋkpɛ pǝ fǝ pǝ sǝpǝ nyikpǝŋwǝ we. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Wǝ́ nyi ri ŋ nyi ŋ rili ŋ fɔ̀. Wǝ́ enyipǝ pǝ wʊ̀ʊ keerituturuwǝ we kɛŋtɛwǝ tǝ mǝ yi pǝ rè pǝ pwɛ̀yɩ.<verse eid="LUK 9:17" /></para>
  <para style="s">Pɛtǝro la pɔrʊ la tɛŋ ǝkǝnǝŋ Yesu ŋ ri Mesiyayǝ</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matewu 16:13-20</ref>, <ref loc="MRK 8:27-29">Marǝko 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Jirɛɛrǝ Yesu kolu ka ŋ mwɛŋ nyuŋkpǝ rǝ fɛɛwǝ rɛ nyiyǝ rɛ ŋ nǝǝ kǝlǝ wǝ. No otukarǝtǝpǝ pǝ ka kʊla mǝ ŋwǝ. Wǝ́ ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Ǝlǝ wǝ́ enyipǝ pǝ láa tɛŋ ǝkǝnǝŋ ŋmǝ ŋ́ ri?» <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Arɛɛpǝ pǝ láa tɛŋ ǝkǝnǝŋ ŋlǝ́ e ri Yowanɛsɩ worokomɛŋwiiritǝyǝ. Apʊŋpwapǝ ǝkǝnǝŋ ŋlǝ́ e ri worokokpɛɛnuŋtɛŋtǝyǝ Eliya. Arɛɛpǝ ke ǝkǝnǝŋ akakatǝworokokpɛɛnuŋtɛŋtǝpǝ we le ceŋceŋ ŋ na saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ ŋ nǝ pǝ.» <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Wǝ́ ŋnǝ pa, ǝlǝ wǝ́ nǝ ya nyáa tɛŋ ǝkǝnǝŋ ŋmǝ ŋ́ ri?» Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Worokoyǝ la Mesiyayǝ wǝ́ e ri.» <verse eid="LUK 9:20" /><verse number="21" style="v" sid="LUK 9:21" />Wǝ́ Yesu ŋ kanǝ ŋ tìi pǝ kpuŋkpuruŋ ǝkǝnǝŋ pǝ paa tɛŋ wǝ pǝ tíi rɛ. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Wǝ́ ŋ tǝ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Wǝ kpii kǝ Nyɩmaasɩ le Pi ŋ cʊʊrʊ ŋpa, kǝ ǝtǝŋtǝǝtǝmumuŋpǝ, otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ pǝ sǝ́ŋ ŋwǝ pǝ co, pǝ láa wʊ ŋwǝ, kǝ juutatǝrǝ ŋ saanǝ.»<verse eid="LUK 9:22" /></para>
  <para style="s">Mǝŋ ǝ lǝ pǝ́ e siimǝ Yesu wǝǝ, nɛ wǝ́ e lée yee?</para>
  <para style="r">(<ref loc="MAT 16:24-28">Matewu 16:24-28</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Yesu yà ka ŋ wɛɛlɩ mǝ ŋ tíi enyipǝ we kpǝlo ǝkǝnǝŋ: «Mǝŋ rɛ lǝ́ǝ pǝ́ ŋ siimǝ mǝ we, yǝ we ŋ yuu na wɛ la kpɛɛ ŋ co, kǝ ŋ fǝ na kpɛtɛkpǝlɛciiwǝ ŋ re ji ri ŋ ji, kǝ ŋ siimǝ mǝ. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Duturǝ ɖi yǝ we ŋ nǝ́ǝ pǝ́ ŋ pɔrʊ na wɛ la vɔrʊrǝ we, lǝ́ǝ lǝǝrǝ rǝ. Paa yǝ we ŋ nǝ́ǝ kpǝ́ rǝ mǝ yurǝ we, láa pɔrʊ na wɛ la vɔrʊrǝ. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Mǝŋ nyiyǝ rɛ la nya ǝrǝkǝ sa kpǝlo kɩɩkɩ lo otuyǝ, wǝ́ paa ŋ nǝ lǝǝrǝ na vɔrʊrǝ amaa ŋ nǝ kpǝ́ ŋ nǝ nǝŋ wǝǝ, vasʊyǝ rǝ fǝŋ wǝ́ nyiyǝ sa ŋ na nya? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Duturǝ ɖi yǝ we ŋ nóo suu mǝ nʊŋsɔɔwǝ, wǝ́ ŋ no suu mǝ etieyǝ la nʊŋsɔɔwǝ we, Nyɩmaasɩ le Pi ŋwǝ ŋkpɛ loh po suu nyiyǝ we la nʊŋsɔɔwǝ mǝ jirǝ we ŋ nah pa siɛnɩ ŋ pǝ rǝ ŋpǝ mǝ nǝ Tǝ mǝ epicoŋpikenikenipǝ la wǝnyɩɩnɩkpǝ lǝ mǝrǝ. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, rǝ enyipǝ sa pǝ yaa rǝ fɛɛwǝ sa lǝ mǝrǝ we, arɛɛpǝ pǝ lǝŋ kpǝ́ kpɛŋ kǝ pǝ ci anyɩŋ Worokoyǝ le wǝpilirikpǝ.»<verse eid="LUK 9:27" /></para>
  <para style="s">Yesu la nyɩnɩ mǝ Worokoyǝ la wǝnyɩɩnɩkpǝ</para>
  <para style="r">(<ref loc="MAT 17:1-8">Matewu 17:1-8</ref>, <ref loc="MRK 9:2-8">Marǝko 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ, wǝ lǝh mǝ lǝ mǝŋ juunɛŋ, wǝ́ ŋ fǝ̀ Pɛtǝro, Yowanɛsɩ mǝ Yakubu ŋ re ŋ kolu pǝ ka mwɛŋ nyuŋkpǝ rǝ dutupirǝ rɛ. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Kǝ́ Yesu ŋ ya ŋ náa mwɛŋ nyuŋkpǝ we, wǝ́ na anyɩŋkǝ kǝ sìɛrɩ. Wǝ́ na kǝkpakǝ kǝ kpɛ̀ɛlɩ fuu, wǝ́ kǝ ke ŋ sie ŋaŋa. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Kǝtǝrǝceŋceŋ wǝ́ ǝpǝrǝŋpǝ rɛ eyi pǝ pǝlǝ pǝ yà pǝ ka ŋ tɛɛrɩ mǝ Yesu. Mose mǝ Eliya pǝ kǝ lǝǝwe. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Pǝ ke kpii rǝ Worokoyǝ la wǝnyɩɩnɩkpǝ lǝ mǝrǝ, wǝ́ pǝ ya pǝ ka ŋ wɛɛlɩ pǝ ŋ ru rǝ kǝ́ Yesu ŋ noh ko ŋ kǝ kpǝ́ rǝ Yerusalɛmǝ kǝ ŋ fǝ ŋ lɛ na kǝnǝnɛkǝ wǝ. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Anyɩŋ eniyǝ we Pɛtǝro mǝ nǝ ǝtǝŋpǝ pǝ la kpɛɛ eniŋrieyǝ kpo. Kǝ́ pǝ la saanǝ we, wǝ́ pǝ nyɩnɩ kǝ́ Yesu ŋ ya ŋ née sie ŋaŋa. Wǝ́ pǝ lɛ pǝ nyɩnɩ enyipǝ we eyipǝ pǝ ka yaa rǝ Yesu lǝ kpǝŋ wǝ. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Kǝ́ enyipǝ sa pǝ lah pwɛyɩ rǝ Yesu lǝ kpǝŋ we, wǝ́ Pɛtǝro ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, wǝ ponu kǝ le tii rǝ fɛɛwǝ sa. Yǝ láa tɔ epwiiyǝ ata. Lá nɛŋrǝ jeŋceŋ, Mose la nɛŋrǝ jeŋceŋ, Eliya la nɛŋrǝ jeŋceŋ.» Paape Pɛtǝro lee ke ci wǝ ŋ yà ŋ ka ŋ tɛŋ wǝ. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Kǝ́ Pɛtǝro ŋ ya ŋ náa tɛŋ etieyǝ sa we, wǝ́ ŋɔɔrǝ rɛ bǝlǝ zìi pǝlo kpǝlo. Kǝ́ Pɛtǝro mǝ nǝ ǝtǝŋpǝ pǝ la nyɩŋ wǝ ǝnǝ we, wǝ́ vurǝ vìi pǝ. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Wǝ́ pǝ nunu kpɛɛwǝ rɛ rǝ ŋɔɔrǝ we lǝ mǝrǝ ǝkǝnǝŋ: «Nyiyǝ sa ŋ ri mǝ piyǝ. Ŋwǝ wǝ́ ŋ́ na pɔrʊ ŋ́ nǝ tǝnǝ. Nǝ nuŋ ne dierǝ.» <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Kǝ́ kpɛɛwǝ sa wǝ la wɛɛlɩ wǝ la lɛ we, pǝ lǝǝ tǝ pǝ nyɩŋ Mose mǝ Eliya. Yesu ceŋceŋ ko ŋ tùuru. Wǝ́ otukarǝtǝpǝ we pǝ rǝnǝ kpiri. Rǝ eciyǝ we lǝ mǝrǝ we, pǝ laa tɛŋ tuwǝ we pǝ nyɩnɩ la tǝrɛ pǝ tíi rɛ.<verse eid="LUK 9:36" /></para>
  <para style="s">Yesu la cá piyǝ rɛ wɛɛrɔɔrɔɔrǝ ge kpii rǝ wǝ</para>
  <para style="r">(<ref loc="MAT 17:14-18">Matewu 17:14-18</ref>, <ref loc="MRK 9:14-27">Marǝko 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Gaalǝǝrǝkǝ we, wǝ́ pǝ pwɛ̀yɩ rǝ dutupirǝ we pǝ ka ŋ sʊʊ. Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ pǝlǝ wǝ kù mǝ Yesu. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Kǝtǝrǝceŋceŋ wǝ́ kɛrɩyǝ rɛ ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Tukaŋtǝyǝ, dɔɔkpɛ siɛrɩ a yɩrɩ mǝ piyǝ sa. Ŋwǝ ŋ ri mǝ bǝrǝŋpiceŋceŋrǝ. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Wɛɛrɔɔrɔɔrǝ rɛ lée kpii na awɛɛlɩkǝ. Vǝ́ yaa we, ŋ pa ya mǝ ŋ lɔ anarǝyǝ kǝtǝrǝceŋceŋ. Anyɩŋ wɛɛrɔɔrɔɔrǝ we ya lée tikili ŋwǝ mǝ okopiyǝ, oturu dutomirǝ ya lóo ru ŋwǝ rǝ nyuŋkpǝ fʊkʊfʊkʊ. Lée kpii na awɛɛlɩkǝ ŋpa. Wǝ láa lɛnyɩ kpɛŋ wɛɛrɔɔrɔɔrǝ sa lǝ ŋ ci acɛ rǝ ŋwǝ. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ŋ́ na pa tɔɔ ŋ́ na kpɛɛ ló otukarǝtǝpǝ sa pǝ piri rǝ, paape pǝ loo koru.» <verse eid="LUK 9:40" /><verse number="41" style="v" sid="LUK 9:41" />Wǝ́ Yesu ŋ tà ŋ yìili ǝkǝnǝŋ: «Ŋnǝ rǝkǝsa le enyipǝ, enyirɔɔrɔɔpǝ rɛ pǝ laa lɔ pǝ nuŋ wǝ́ nǝ ri! Ŋ́ tǝ ŋ́ tii ŋ́ kʊla mǝ nǝ ko ro ɖeci? Ŋ́ tǝ ŋ́ re nǝ ko ro ɖeci?» Wǝ́ Yesu ŋ tìi kɛrɩyǝ we ǝkǝnǝŋ: «Fǝ le piyǝ we ǝ pǝ fɛɛwǝ sa.» <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />Kǝ́ piyǝ we ŋ no ru ŋ nǝ́ǝ pǝ we, wǝ́ wɛɛrɔɔrɔɔrǝ we vǝ̀ ŋwǝ gbǝ̀ jà, wǝ́ dìkili ŋwǝ mǝ okopiyǝ. Paape wǝ́ Yesu ŋ fanǝ wɛɛrɔɔrɔɔrǝ we. Wǝ́ ŋ cà piyǝ we. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ koonu nǝ tǝ. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Wǝ́ tuwǝ sa wǝ yeli nyi ri ŋ nyi la tǝrɛ. Wǝ́ pǝ yà pǝ ka ŋ tɛŋ ǝkǝnǝŋ Worokoyǝ naanǝ.</para>
  <para style="s" vid="LUK 9:43">Yesu lǝ tǝ la wɛɛlɩ lo ru rǝ nǝ ǝpǝkpǝ́kǝ</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Matewu 17:22-23</ref>, <ref loc="MRK 9:30-32">Marǝko 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Rǝ eniyǝ we Yesu lo otuyeeyǝ we kpǝlo yǝ tǝ yǝ ya yǝ lóo co nyi ri ŋ nyi lo vurǝ we, wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />«Nǝ nuŋ dierǝ sa ŋ́ neh tíi nǝ nǝ re sɩsiɛrɩ. Pǝ lǝh pǝ fǝ Nyɩmaasɩ le Pi pǝ kpii enyipǝ rǝ akaakǝ.» <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Paape otukarǝtǝpǝ we pǝ loo ko ŋ nuŋ dierǝ sa lo duturǝ. Worokoyǝ lǝ fǝ etieyǝ sa lo duturǝ la ŋwaa pǝ. Kǝ pǝ poo koru yǝlo duturǝ lo onuŋ. Vurǝ ke lɛ ge ŋ yee pǝ, kǝ́ pǝ lée yee kǝ pǝ pǝ́ Yesu lǝ wǝ lo duturǝ pǝ nuŋ wǝ.<verse eid="LUK 9:45" /></para>
  <para style="s">Ǝlǝ ŋ ri mumuŋyǝ rǝ Yesu ló otukarǝtǝpǝ lǝ mǝrǝ wǝ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matewu 18:1-5</ref>, <ref loc="MRK 9:33-37">Marǝko 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Wǝ́ Yesu lo otukarǝtǝpǝ pǝ yili pǝ kǝ ŋ pǝ́ awɛ pǝ ŋ nuŋ yǝ we ŋ ri mumuŋyǝ rǝ pǝlǝ mǝrǝ wǝ. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Wǝ́ Yesu ŋ nyɩnɩ pǝlo oyupuyǝ ŋ cìi. Wǝ́ ŋ fǝ̀ laatiepiyǝ rɛ ŋ pǝlǝ ŋ yàalǝ rǝ nǝ kpǝŋ. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Yǝ we ŋ na lɔ piyǝ sa sɩsiɛrɩ rǝ mǝ yurǝ we, ŋmǝ wǝ́ ŋ na lɔ. Wǝ́ yǝ we ŋ na lɔ mǝ sɩsiɛrɩ we, yǝ we ŋ ne kpii mǝ wǝ́ ŋ na lɔ. Duturǝ ɖi yǝ we ŋ ri pipipipiyǝ rǝ nǝ kpǝlo lǝ mǝrǝ we, ŋwǝ ŋ ri nǝ mumuŋyǝ.»<verse eid="LUK 9:48" /></para>
  <para style="s">Yǝ we ŋ nee yi ŋ tɛɛ rǝ nǝ we, kʊla mǝ nǝ</para>
  <para style="r">(<ref loc="MRK 9:38-40">Marǝko 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Wǝ́ Yowanɛsɩ ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, yǝ la nyɩŋ nyiyǝ rɛ ya lée piri awɛɛrɔɔrɔɔyǝ saŋ rǝ lá nyɩŋrǝ. Wǝ́ yǝ lǝ pǝ́ lǝ kǝ sǝ́ŋ wǝ lo koonu ŋwǝ, duturǝ ɖi laa kʊla mǝ ŋlǝ ǝpǝ le siimǝ lǝ́ wǝ.» <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />Paape wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nǝ pǝǝ sǝ́ŋ wǝ nǝ koonu ŋwǝ. Duturǝ ɖi yǝ we ŋ nee yi ŋ tɛɛ rǝ nǝ we, yǝ we kʊla mǝ nǝ.»<verse eid="LUK 9:50" /></para>
  <para style="s">Samariatǝtǝŋtǝǝwǝ rɛ wǝ laa lɔ Yesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Kǝ́ eniyǝ yǝ lah ta yǝ ro, kǝ Worokoyǝ ŋ fǝ Yesu ŋ pwɛyɩ rǝ kǝtǝǝwǝ sa we, wǝ́ Yesu ŋ fǝ̀ ŋ tɛ̀ɛ rǝ na wɛ ǝkǝnǝŋ ŋ nóo ko Yerusalɛmǝ. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Wǝ́ ŋ kpìi enyipǝ pǝ conu pǝ kòonu ŋwǝ. Wǝ́ enyipǝ we pǝ pwɛ̀yɩ pǝ ko ŋ ko. Wǝ́ pǝ kolu pǝ fìi Samaria lǝ dǝŋtǝǝpirǝ rɛ kǝ pǝ taa fɛɛwǝ we pǝ lah pa lɔ Yesu pǝ tǝnǝ. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Paape ǝtǝŋtǝǝtǝpǝ we pǝ laa pa lɔ ŋwǝ kpiikǝ ŋ ko ŋ ko Yerusalɛmǝ kǝto. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Kǝ́ otukarǝtǝpǝ we pǝ lóo pwo Yakubu mǝ Yowanɛsɩ pǝ la nyɩŋ wǝ ǝnǝ we, wǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ǝ lǝ́ǝ pǝ́ lo pwo naawǝ kǝ wǝ ru rǝ yulaarǝ wǝ pe yee pǝ pukupuku?» <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Wǝ́ Yesu ŋ sìɛrɩ ŋ kpanǝ mǝ pǝ. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko dǝŋtǝǝpipʊŋpwarǝ.<verse eid="LUK 9:56" /></para>
  <para style="s">Enyipǝ rɛ pǝ lǝ pǝ́ pǝ siimǝ Yesu wǝ</para>
  <para style="r">(<ref loc="MAT 8:19-22">Matewu 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Kǝ́ pǝ sanǝ pǝ lóo ko we, wǝ́ nyiyǝ rɛ ŋ tìi Yesu ǝkǝnǝŋ: «Fɛɛ ri ŋ fɛɛ o lóo ko we, ŋ́ née siimǝ lǝ́ mǝ ŋ tɛlɩ.» <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Osupǝ pǝ lǝǝmǝ pǝlo ofuŋyǝ, wǝ́ ofuripǝ pǝ lǝǝmǝ pǝlo okuyǝ. Paape Nyɩmaasɩ le Pi lǝǝ lǝmǝ fɛɛwǝ ŋ náa kpɛɛ ŋ wɛɛ wǝ.» <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />Wǝ́ Yesu ŋ tìi nyipʊŋpwayǝ ǝkǝnǝŋ: «Siimǝ mǝ!» Wǝ́ nyiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, koonu mǝ gʊŋrǝ ŋ́ ka ŋwaa mǝ tǝ kpɛŋ kǝ mǝ ŋ pǝ.» <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Maa enyiǝtǝpǝ pǝ ŋ ŋwaa pǝle enyiǝtǝpǝ. Ŋlǝ́ paa we, ko e ke tíi enyipǝ a tɛlɩ ǝkǝnǝŋ Worokoyǝ ya lée ri wǝpilikpǝ.» <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />Wǝ́ nyipʊŋpwayǝ rɛ ŋ tǝ ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ née siimǝ lǝ́, paape maa kǝ ŋ́ ka kǝra mǝ enyipǝ kǝ mǝ ŋ pǝ.» <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Yǝ we ŋ ya ŋ náa ca atɔŋyǝ mǝ anɛŋpǝ, wǝ́ ŋ ya ŋ náa yɩrɩ kǝmaakǝ we, nyiyǝ we kǝtǝŋkǝ laa kaamǝ kǝ ŋ kʊla rǝ Worokoyǝ le wǝpilirikpǝ».<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yesu le kpii no otukarǝtǝpǝ tǝpǝrɩmata mǝ eyi la gʊŋrǝ</para>
  <para style="r">(<ref loc="MRK 6:7-16">Marǝko 6:7-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Rǝ wǝla kǝmaakǝ wǝ́ Kulǝtǝyǝ Yesu ŋ sàa otukarǝtǝpʊŋpwapǝ tǝpǝrɩmata mǝ eyi. Wǝ́ ŋ kpìi pǝ ŋ coonu eyi eyi rǝ ǝtǝŋtǝǝyǝ we mǝ epwiitǝŋyǝ we kpǝlo ŋwǝŋwǝ ŋ noh po ko wǝ. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Atɛɛtɛɛtuyǝ yǝ le fii ŋpa. Paa alɛɛtǝpǝ pǝ laa naanǝ. Nǝ tɔɔ nǝ kpɛɛ tɛɛlǝtǝyǝ we ŋ kpii alɛɛtǝpǝ ŋ maŋ pǝ pa lɛ atɛɛtɛɛtuyǝ sa. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Nǝ mǝ ko! Nǝ nyɩŋ re, nǝ lǝ rǝ mǝŋ amɛɛpipǝ kǝtǝ. Wǝ́ ŋ́ neh kpii nǝ ŋ́ maŋ rǝ ecekeeteeyǝ lǝ mǝrǝ. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Nǝ pee re zɩkalotorǝ, amaa akpoyǝ amaa afʊkpayǝ rɛ. Nǝ poo ko tumǝ nǝ yaa nǝ mǝ ceeni rɛ rǝ kʊŋwǝ. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Vǝ́ nǝ nye fii nyarǝwǝ rɛ we, tusǝsǝŋwǝ nǝ nyée yee we, nǝ ceeni pǝ ǝkǝnǝŋ: “Wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ”. <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Mǝŋ wǝtaarǝkpǝ le nyiyǝ rɛ kpii rǝ nyarǝwǝ sa we, wǝtaarǝkpǝ sa nǝ nyǝ pǝ́ we, wǝ lée tii wǝ kʊla mǝ ŋwǝ. Wǝ́ mǝŋ wǝtaarǝkpǝ le nyiyǝ rɛ lee kpii rǝ fɛɛwǝ we we, nǝ wǝtaarǝkpǝ sa nǝ nyǝ pǝ́ we, wǝ siɛnɩ wǝ po tuu nǝ. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Nǝ tii rǝ nyarǝwǝ sa. Nǝ ri kǝ nǝ ŋuŋ tu ri ŋ tu pǝ lo koonu nǝ wǝ. Duturǝ ɖi wǝ kaamǝ kǝ nǝnɛyeetǝyǝ ŋ lɔ no wǝtoomwarakpǝ. Nǝ paa pwɛyɩ rǝ nyarǝwǝ sa nǝ ko pʊŋpwawǝ rɛ. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Vǝ́ nǝ nye fii tǝŋtǝǝwǝ rɛ wǝ́ ǝtǝŋtǝǝtǝpǝ we pǝ la lɔ nǝ we, nǝ ri keeriwǝ we pǝ lóo koonu nǝ wǝ. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Nǝ ca anyaatǝpǝ rǝ tǝŋtǝǝwǝ sa. Kǝ nǝ tíi ǝtǝŋtǝǝtǝpǝ sa ǝkǝnǝŋ: “Worokoyǝ le wǝpilirikpǝ wǝ lǝ kǝlǝ mǝ nǝ oo.” <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Paa vǝ́ nǝ nye fii tǝŋtǝǝwǝ rɛ wǝ́ ǝtǝŋtǝǝtǝpǝ we pǝ laa lɔ nǝ we, nǝ ka yaa rǝ canɩtiwǝ kǝ nǝ tíi pǝ ǝkǝnǝŋ: <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />“Nǝ tǝŋtǝǝwǝ sa la naŋrǝ ǝkǝŋtǝ dɛɛ rǝ lah akparǝyǝ we, yǝ la fɛlɩ rǝ yǝ lǝ tǝnǝ <note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="LUK 9:5">9:5</ref></char>.</char></note> nǝ oo. Paa nǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ Worokoyǝ le wǝpilirikpǝ wǝ lǝ kǝlǝ.” <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, jirǝ we Worokoyǝ ŋ náa tɛŋ akpaŋyǝ we, láa ta ǝtǝŋtǝǝtǝpǝ sa lo kǝtukoŋkǝ ŋ teeri Osodomǝtǝpǝ.»<verse eid="LUK 10:12" /></para>
  <para style="s">Yesu la fwɛɛrɩ ǝtǝŋtǝǝyǝ we yǝ lǝ sǝ́ŋ yǝ laa lɔ ŋwǝ yǝ nuŋ wǝ</para>
  <para style="r">(<ref loc="MAT 11:20-24">Matewu 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />Ŋnǝ Okoraziŋtǝpǝ, nǝ paapɔ mǝ nǝ aria. Ŋnǝ Abɛsayɩdatǝpǝ, ŋnǝ ŋkpɛ nǝ paapɔ mǝ nǝ aria. Duturǝ ɖi ŋ́ yeli otuyǝ yǝ lóo co vurǝ rǝ nǝ kpǝŋ. Mǝŋ ŋ́ ke yeli yǝ ǝnǝ rǝ Tiro mǝ Zidɔŋ we, o koh mǝ pwo Etirotǝpǝ mǝ Ezidɔŋtǝpǝ pǝ le kpii wǝkpekpekotokukpakpǝ pǝ tini rǝ atʊkpɔrɔyǝ kaka kǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ pǝ la siɛrɩ vɔrʊrǝ. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Wǝ kǝto jitɛŋakpaŋyǝ we, Worokoyǝ láa ta nǝ kǝtukoŋkǝ ŋ teeri Etirotǝpǝ mǝ Ezidɔŋtǝpǝ. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Ŋnǝ Akapɛrǝnawumǝtǝpǝ ŋnǝ ŋkpɛ, nǝ nyo pu wǝ ǝkǝnǝŋ Worokoyǝ lah rɛɛrɩ mǝ nǝ ǝrǝ yulaarǝ? Bomu lah sʊʊrʊ mǝ nǝ ǝrǝ akpɛŋtɛkǝ. <verse eid="LUK 10:15" /><verse number="16" style="v" sid="LUK 10:16" />Wǝ́ Yesu ŋ tǝ ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Yǝ we ŋ no co kǝtukoŋkǝ rǝ nǝ we, lo co kǝtukoŋkǝ rǝ mǝ. Yǝ we ŋ naa lɔ nǝ we, ŋmǝ wǝ́ ŋ naa lɔ. Wǝ́ mǝŋ rɛ laa lɔ mǝ we, we laa lɔ yǝ we ŋ ne kpii mǝ ŋ na maŋ wǝ.»<verse eid="LUK 10:16" /></para>
  <para style="s">Yesu lo otukarǝtǝpǝ we tǝpǝrɩmata mǝ eyi ŋ ne kpii gʊŋrǝ pǝ la siɛnɩ pǝ lǝ pǝ pǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Otukarǝtǝpǝ we tǝpǝrɩmata mǝ eyi pǝ sìɛnɩ pǝ pǝlǝ mǝ faawǝ, wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, vǝ́ yǝ láa wɛɛlɩ rǝ lá nyɩŋrǝ we, mǝŋ awɛɛrɔɔrɔɔyǝ yǝ ŋ nuŋ loh tutɛŋwǝ.» <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ na nyɩŋ kǝ́ Satana ŋ no ru rǝ Yulaarǝ ŋ na pa tɔɔ mǝŋ kǝ́ ǝrǝkǝ kǝ le sie kǝtǝ. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Nǝ nuŋ sɩsiɛrɩ. Ŋ́ no koonu nǝ okopiyǝ, kǝ nǝ saŋ rǝ wǝpɔɔkpǝ mǝ anaŋpǝ nǝ ka tɛlɩ, kǝ nǝ pǝlǝ kǝǝkpǝlǝtǝyǝ lo okopiyǝ kpǝlo kɩɩkɩ, tǝrɛ wǝ lǝŋ yee nǝ. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Paape nǝ paa nya faawǝ mǝ kǝ́ awɛɛrɔɔrɔɔyǝ yǝ la pɛɛlɩ yǝ lo koonu nǝ wǝ. Nǝ nya faawǝ bomu rǝ kǝ́ Worokoyǝ ŋ na ŋʊrʊ nǝ anyɩŋyǝ ŋ nǝ tǝnǝ rǝ Yulaarǝ wǝ.»<verse eid="LUK 10:20" /></para>
  <para style="s">Yesu la pɔrʊ nǝ tǝ Worokoyǝ la kaŋ no otukarǝtǝpǝ</para>
  <para style="r">(<ref loc="MAT 11:25-27">Matewu 11:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Rǝ eniyǝ we mǝrǝ wǝ́ Wɛɛkenikenirǝ gòonu Yesu ŋ nyà faawǝ ŋpa. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ Tǝ, yulaarǝ mǝ kǝtǝǝwǝ lo Kulǝtǝyǝ, e le yeekǝ. Duturǝ ɖi tuwǝ we ǝ lǝ fǝ a la ŋwaa enimisietǝpǝ mǝ otucitǝpǝ we, ǝ lǝ fǝ wǝ a la kaŋ alaatiepipǝ. Kǝceece mǝ tǝ, ŋlǝ́ŋlǝ́ ǝ lǝ pǝ́ wǝ lǝ ǝnǝ.» <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />«Mǝ tǝ lǝ fǝ tu ri ŋ tu le kpii mǝ rǝ akaakǝ. Rɛ lee ci nyiyǝ we kǝtǝŋkǝ ŋwǝ Piyǝ ŋ ri wǝ. We Tǝyǝ ceŋceŋ ko ŋ cii wǝ. Wǝ́ rɛ lee ci yǝ we ŋ ri Tǝyǝ. Ŋwǝ Piyǝ ceŋceŋ ko, mǝ enyipǝ we ŋ nǝ pǝ́ ŋ fǝ Tǝyǝ ŋ kaŋ wǝ.» <verse eid="LUK 10:22" /><verse number="23" style="v" sid="LUK 10:23" />Wǝ́ Yesu ŋ sìɛrɩ ŋ kolu rǝ no otukarǝtǝpǝ lǝ kpǝŋ. Wǝ́ ŋ ŋwàa ŋ tìi pǝ, ŋpǝ ceŋceŋ ǝkǝnǝŋ: «Ŋnǝ ǝpǝ ǝnǝ nǝ ya nǝ nyáa nyɩŋ tuwǝ sa we, nǝ nyóo co yǝ mǝ kǝ́ nǝ nya nyɩŋ wǝ wǝ. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, duturǝ ɖi, oworokokpɛɛnuŋtɛŋtǝpǝ wa mǝ epilipǝ wa pǝ lǝ pǝ́ pǝ ka nyɩŋ tuwǝ sa nǝ ya nǝ nyáa nyɩŋ wǝ. Paape pǝ laa nya wǝ pǝ nyɩŋ. Pǝ lǝ pǝ́ pǝ ko nuŋ tuwǝ sa nǝ ya nǝ nyóo nuŋ wǝ. Paape pǝ laa nya wǝ pǝ nuŋ.»<verse eid="LUK 10:24" /></para>
  <para style="s">Taa Worokoyǝ lǝ kǝǝwǝ, kǝ a taa la kɛrɩyǝ lǝ kǝǝwǝ</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matewu 22:34-40</ref>, <ref loc="MRK 12:28-31">Marǝko 12:28-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Worokosekaŋtǝyǝ rɛ kǝ ŋ pǝ́ ŋ kɔŋ Yesu la kpɛrɛwǝ ŋ yɩrɩ. Wǝ́ ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, kǝ́ wǝ́ ŋ́ née yee kǝ ŋ́ nya vɔrʊlaalɛɛrǝ?» <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ pǝ la ŋʊrʊ rǝ Worokoyǝ le seyǝ<note caller="+" style="f"><char style="fr" closed="false">10:26 </char><char style="ft" closed="false">Worokoyǝ le seyǝ: Worokoyǝ le esepǝ we ŋ kòonu Mose wǝ.</char></note> we mǝrǝ? O lo nuŋ seyǝ we lo duturǝ ǝ lǝ fǝ nɛ?» <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />Wǝ́ worokosekaŋtǝyǝ we ŋ tɛnɩ ǝkǝnǝŋ: «A lah mǝ taa Worokoyǝ lǝ kǝǝwǝ mǝ lá ziɔŋrǝ kpǝlo, mǝ ló kǝrukǝ kpǝlo, ló otuciyǝ kpǝlo mǝ ló okopiyǝ kpǝlo, kǝ a lɛ a taa lá kɛrɩyǝ lǝ kǝǝwǝ mǝŋ ŋlǝ́ŋlǝ́ lá wɛ kǝtǝ.» <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «A la tɛŋ wǝ wǝ ponu, mǝ yee mǝŋ kɔɔwe, kǝ e tii vɔrʊrǝ».<verse eid="LUK 10:28" /></para>
  <para style="s">Ǝlǝ ŋ ri mǝ kɛrɩyǝ?</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Kpiikǝ worokosekaŋtǝyǝ we ŋ kǝ ŋ pǝ ŋ pɛɛnɩ na wɛ kǝto, wǝ́ ŋ tǝ ŋ pǝ́ Yesu ǝkǝnǝŋ: «Ǝlǝ ŋ ri mǝ kɛrɩyǝ?» <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nyiyǝ rɛ rù rǝ Yerusalɛmǝ lǝ tǝŋtǝǝwǝ ka ŋ sʊʊ Yeriko lǝ tǝŋtǝǝwǝ, wǝ́ ayɩlayɩtǝpǝ pǝ kolu pǝ sǝ̀ ŋwǝ rǝ gʊŋrǝ, wǝ́ pǝ lɔ̀ no otuyǝ kpǝlo kɩɩkɩ, wǝ́ pǝ lɛ pǝ cùlu ŋwǝ, wǝ́ ŋ kǝ ŋ kpǝ́ mǝ ŋ sàanǝ. Wǝ́ pǝ pwɛyɩ pǝ màa ŋwǝ pǝ cò rǝ gʊŋrǝ. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Wǝ laa panǝ, wǝ́ toolutǝyǝ rɛ ŋ rù mǝ kʊŋwǝ we ŋ ka ŋ sʊʊ. Kǝ́ ŋ na nyɩŋ nyiyǝ sa ŋ kpɛlɩ we, wǝ́ ŋ nyàlǝ ŋ kolu ŋ tɛ̀lɩ ŋwǝ. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Kaa wǝǝ leviyǝ<note caller="+" style="f"><char style="fr" closed="false">10:32 </char><char style="ft" closed="false">Leviyǝ: Nyiyǝ we ŋ nóo toŋ toolutǝyǝ rǝ Worokoyǝ la nyarǝwǝ.</char></note> rɛ ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ ka ŋ tɛlɩ wǝǝ. Kǝ́ ŋ na nyɩŋ nyiyǝ we ŋ kpɛlɩ we, wǝ́ ŋ nyàlǝ ŋ kolu ŋ tɛ̀lɩ ŋwǝ. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Paa, Samariatǝnyiyǝ rɛ, ko ŋ ko gʊŋrǝ wǝ́ ŋ kolu ŋ rù rǝ ŋwǝ. Kǝ́ ŋ na nyɩŋ nyiyǝ sa ŋ kpɛlɩ we, wǝ́ wǝ cò na tǝlarǝwǝ ŋpa. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Wǝ́ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ ŋ cò apɔŋpǝ mǝ vɛŋyǝ<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Rǝ Oyudatǝpǝ lǝ kpǝŋ we, pǝ kǝ ŋ fǝ̀ apɔŋpǝ pǝ ŋ fìeni kǝrɛŋkǝ kǝ kǝ pǝǝ tǝ kǝ fuu nyiyǝ. Vɛŋyǝ wǝ́ pǝ lǝ́ǝ fǝ pǝ ŋ siɛ kǝrɛŋkǝ.</char></note> ŋ fìeni na wǝrɛŋkpǝ we, wǝ́ ŋ pàrǝ nǝ kpǝ. Kǝ́ ŋ na lɛ, wǝ́ ŋ fǝ̀ ŋwǝ ŋ tɛ̀ɛ rǝ no rookɛtɛyǝ, wǝ́ ŋ fǝ̀ ŋwǝ ŋ ko ŋ ko fɛɛlɔǝsǝǝpǝ. Wǝ́ ŋ yɩ̀rɩ no yurǝ. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Galǝǝrǝkǝ we, wǝ́ Samariatǝnyiyǝ sa ŋ pɔ̀rʊ sɩkayǝ<note caller="+" style="f"><char style="fr" closed="false">10:35 </char><char style="ft" closed="false">Sɩkayǝ sa pǝ reemǝ rǝ fɛɛwǝ sa we, Oromatǝpǝ la sɩkayǝ ŋ lǝǝwe, rǝ wǝŋʊrʊkpǝ sa lǝ mǝrǝ sɩkayǝ kpotokpoto yi ŋ lǝǝwe. Wǝ́ ceŋceŋ ŋ kaamǝ pǝla jɔkɔŋcirǝ la Paasɩkayǝ.</char></note> ŋ kòonu nyiyǝ we ŋ náa yɩrɩ nyarǝwǝ we, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Yɩrɩ no yurǝ o koonu mǝ. Vǝ́ ŋ́ no ko ru ŋ́ náa tɛlɩ we, otooyǝ we e le re a la kʊla rǝ no yurǝ we, ŋ́ náa mwara lǝ yǝ.”» <verse eid="LUK 10:35" /><verse number="36" style="v" sid="LUK 10:36" />Wǝ́ Yesu ŋ pǝ̀ sekaŋtǝyǝ sa ǝkǝnǝŋ: «Rǝ lá anyɩŋkǝ wǝǝ, enyipǝ sa ata lǝ ǝlǝ ŋ ri nyiyǝ sa ayɩlayɩtǝpǝ pǝ lo culu la kɛrɩyǝ?» <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />Wǝ́ worokosekaŋtǝyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nyiyǝ we ŋ ne yee ne wǝceeceekpǝ ŋ lǝǝwe». Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ ko, kǝ ŋlá ŋkpɛ e ke yee mǝŋkɔɔwe».<verse eid="LUK 10:37" /></para>
  <para style="s">Yesu le siri lo ko Marǝta mǝ Marɩya lǝ kpǝŋ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yesu ke kpii ko ŋ ko mǝ kʊŋwǝ ŋpǝ mǝ no otukarǝtǝpǝ. Wǝ́ ŋ kolu ŋ fìi dǝŋtǝǝpirǝ rɛ. Wǝ́ tieyǝ rɛ pǝ lóo pwo Marǝta ŋ lɔ̀ ŋwǝ rǝ na nyarǝwǝ. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Tieyǝ sa kǝ lǝǝmǝ paatɛyǝ pǝ lóo pwo ŋwǝ Marɩya. Wǝ́ Marɩya ŋ pǝlǝ ŋ tini rǝ Kulǝtǝyǝ Yesu la wǝkʊŋkpǝ. Wǝ́ ŋ tini ŋ ko ŋ nuŋ no otukaŋyǝ. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Rǝ ŋyǝ eniyǝ we mǝrǝ we, wǝ́ Marǝta ŋ yà ŋ kǝ ŋ fǝ yowǝ. Ŋwǝ ceŋceŋ ŋ ko rǝ sa, ŋ pǝ rǝ sa. Wǝ́ ŋ pǝlǝ ŋ rù rǝ Yesu lǝ kpǝŋ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝ paatɛ la maa mǝ ceŋceŋ ŋ́ ya ŋ́ née yee anǝnɛyǝ sa. Wǝ lǝŋ yee lǝ́ tǝrɛ? Kǝto tíi ŋwǝ ŋ po toŋ mǝ oo.» <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />Wǝ́ Kulǝtǝyǝ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Marǝta, yɩrɩ re, a ya lǝ́ǝ kǝǝnǝ wǝ́ a ya lóo pu yurǝ o mǝ ŋ ru rǝ otuyǝ wa. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Paa tuwǝ rɛ ceŋceŋ ko wǝ lǝ kpuŋkpuruŋ wǝ. Marɩya la saa tuceeceeceeceewǝ la pɔrʊ. Wǝ́ rɛ lǝŋ pa lɔ wǝ rǝ ŋwǝ.»<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yesu la kaŋ no otukarǝtǝpǝ lo nyuŋmwɛŋwǝ</para>
  <para style="r">(<ref loc="MAT 6:9-13">Matewu 6:9-13</ref>, <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Jirɛɛrǝ Yesu yà ka ŋ mwɛŋ nyuŋkpǝ rǝ fɛɛwǝ rɛ. Kǝ́ ŋ na lɛ we, wǝ́ no tukarǝtǝyǝ rɛ ceŋceŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ Yesu, kaŋ lǝ kǝ́ pǝ láa mwɛŋ nyuŋkpǝ mǝŋ kǝ́ Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ ŋ kanǝ no otukarǝtǝpǝ kǝtǝ». <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Vǝ́ nǝ nyah mwɛŋ nyuŋkpǝ we, nǝ tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 11:2">Lǝh tǝ,</para>
  <para style="q1" vid="LUK 11:2">kuŋ kǝ pǝ ci wǝ ǝkǝnǝŋ lá nyɩŋrǝ lǝ kenikeni.</para>
  <para style="q1" vid="LUK 11:2">Lé wǝpilirikpǝ wǝ pǝ.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Koonu lǝ ji ri ŋ ji le keeriwǝ we yǝ lée ri wǝ.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Fǝ loh oturɔɔrɔɔyǝ a cɛɛ lǝ,</para>
  <para style="q1" vid="LUK 11:4">kpiikǝ ŋla ŋkpɛ yǝ lǝ́ǝ fǝ yǝ ŋ cɛɛ epǝ we kpǝlo kɩɩkɩ pǝ lo wu lǝ wǝ.</para>
  <para style="q1" vid="LUK 11:4">Paa maa kǝ pǝ kpii lǝ gbǝǝrǝ.»<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝ lǝ fǝ wǝ, rɛ rǝ nǝ mǝrǝ lo ko na kɛrɩyǝ lǝ kpǝŋ mǝ kǝ́ kǝ la cɩɩ kǝ lǝ sǝpǝ wǝ, wǝ́ ŋ ne ke tíi ŋwǝ ǝkǝnǝŋ: Mǝ kɛrɩyǝ, tuu mǝ keeriwǝ. <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Kaa wǝǝ ŋ́ na lɔ sǝǝyǝ rɛ wǝ́ ŋ́ nǝǝ lǝmǝ tǝrɛ ŋ́ noh koonu ŋwǝ.» <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Kǝ na kɛrɩyǝ we ŋ tíi ŋwǝ rǝ gukpǝ mǝrǝ ŋ maŋ ǝkǝnǝŋ: «Pee kpii mǝ awɛɛlɩkǝ. Ŋ́ na marǝ ŋ́ na taŋ ŋwaarǝ mǝ safweyǝ. Lǝ mǝ mǝ epipǝ yǝ la kpɛɛ. Ŋ́ nǝŋ koru eyi ŋ́ po koonu lǝ́ keeriwǝ.» <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ŋ́ ya ŋ́ née tíi nǝ wǝ mǝŋ nyiyǝ sa le yi ŋ pǝ fǝ keeriwǝ we ŋ koonu ŋwǝ we, ŋkǝ kǝ́ pǝ ri epwetapǝ kǝto, paape kǝ́ yǝ we ŋ ya ŋ nǝ́ǝ pǝ́ tuwǝ we ŋ noo co oku ǝkǝnǝŋ ŋ ya née kpii yǝ eni la awɛɛlɩkǝ kǝto. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ: «Nǝ pǝ́ kǝ pǝ koonu nǝ. Nǝ taa kǝ nǝ nya. Nǝ ca ŋwaarǝ kǝ pǝ taanǝ nǝ rǝ. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Duturǝ ɖi yǝ we ŋ na nya ŋ nǝ pǝ́ tuwǝ ko láa lɔ wǝ. Yǝ we ŋ na taa láa nya, wǝ́ yǝ we ŋ na ca ŋwaarǝ we, pǝ láa taanǝ nǝ rǝ. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Tǝyǝ rǝ fǝŋ rǝ nǝ mǝrǝ, mǝŋ ne piyǝ lǝ pǝ́ na kǝpwɛɛkǝ, kǝ yǝ we ŋ fǝ kǝpɔɔkǝ ŋ koonu ŋwǝ rǝ kǝpwɛɛkǝ la fɛɛwǝ? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Amaa vǝ́ piyǝ we lǝ pǝ́ nǝ zǝlǝrǝ wǝǝ, lóo koru ǝfǝ naŋyǝ ŋ koonu ŋwǝ? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Enyirɔɔrɔɔpǝ wǝ́ nǝ ri, paape nǝ cii kǝ́ nǝ nyóo koonu nǝ epipǝ lo otuceeceeyǝ wǝ. Kǝ Tǝyǝ rǝ yulaarǝ ŋ wɛɛ ŋ pǝǝ fǝ Wɛɛkenikenirǝ ŋ koonu epǝ we pǝ ya pǝ lǝ́ǝ pǝ́ nǝ rǝ wǝ?»<verse eid="LUK 11:13" /></para>
  <para style="s">Yesu lǝǝmǝ okopiyǝ teeri awɛɛrɔɔrɔɔyǝ</para>
  <para style="r">(<ref loc="MAT 12:22-30">Matewu 12:22-30</ref>, <ref loc="MRK 3:22-27">Marǝko 3:22-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Jirɛɛrǝ Yesu yà ke ŋ piri wɛɛrɔɔrɔɔrǝ rɛ rǝ nyiyǝ rɛ lǝ mǝrǝ. Wɛɛrɔɔrɔɔrǝ we vǝ̀ nyiyǝ we yeli omumuuyǝ. Wǝ́ wɛɛrɔɔrɔɔrǝ sa ɖù rǝ omumuuyǝ sa. Wǝ́ ŋ ka ŋ wɛɛlɩ. Wǝ́ wǝ rili kǝnyikpǝŋkǝ we kǝ ka yaa rǝ fɛɛwǝ we lo mumuŋ. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Paa wǝ́ arɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Awɛɛrɔɔrɔɔyǝ le piliyǝ Bɛzebulǝ ŋ no koonu no okopiyǝ ŋ ya ŋ née piri awɛɛrɔɔrɔɔyǝ.» <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Wǝ́ arɛɛpǝ pǝ kǝ ŋ pǝ́ pǝ tie ŋwǝ pǝ yɩrɩ. Wǝ́ pǝ tìi ŋwǝ ŋ yee tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii ŋwǝ ŋ na maŋ wǝ. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Paa Yesu ke cìi pǝlo oyupuyǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ wǝpilirikpǝ rɛ le enyipǝ pǝ lǝ sǝpǝ wǝ́ pǝ le yi pǝ la tɛɛ rǝ awɛ we, wǝpilirikpǝ sa wǝ lǝ́ǝ pǝ wǝ ŋ wɔ. Wǝlo okuyǝ yǝ láa tɔɔlʊ yǝ ŋ si awɛ. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Nǝ ya nyáa tɛŋ ǝkǝnǝŋ Bɛzebulǝ ŋ no koonu mǝ okopiyǝ wǝ́ ŋ́ ya ŋ́ née piri awɛɛrɔɔrɔɔyǝ. Mǝŋ Satana ŋwǝ ŋkpɛ lǝ sǝpǝ wǝ́ ŋ ne yi ŋ na tɛɛ rǝ na wɛ wǝǝ, ne wǝpilirikpǝ wǝ lée yee nɛ kǝ wǝ tǝ wǝ tɔ wǝ yaa? <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Wǝ́ mǝŋ Bɛzebulǝ ŋ no koonu mǝ okopiyǝ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née piri awɛɛrɔɔrɔɔyǝ, ŋnǝ nǝ otukarǝtǝpǝ wǝǝ, ǝlǝ ŋ no koonu pǝ lo okopiyǝ pǝ lǝ́ǝ fǝ pǝ ŋ piri awɛɛrɔɔrɔɔyǝ wǝ? Kǝto nǝ otukarǝtǝpǝ ŋpǝŋpǝ pǝ ya pǝ láa tɔɔ nǝ bɔrǝ. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Wǝ́ mǝŋ Worokoyǝ lo okopiyǝ wǝ́ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née piri awɛɛrɔɔrɔɔyǝ we, we wǝ ya wǝ láa pɔrʊ wǝ ŋ kaŋ ǝkǝnǝŋ Worokoyǝ le wǝpilirikpǝ we wǝ le pe fii nǝ kpǝŋ wǝ la lɛ. <verse eid="LUK 11:20" /><verse number="21" style="v" sid="LUK 11:21" />Vǝ́ kopilǝtǝyǝ rɛ la kpaka tini mǝ akɔŋtuyǝ lǝ́ǝ rǝŋ na nyarǝwǝ we, anyɩŋ no otulǝmǝyǝ yǝ kpɛlɩ ŋwǝ rʊŋ. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Paa mǝŋ nyiyǝ rɛ ŋ lɛnyɩ ŋ teeri ŋwǝ la pa fia mǝ ŋwǝ, wǝ́ ŋ ne ri no yurǝ we, láa lɔ na akɔŋtuyǝ we ŋ ya ŋ náa tɛɛ kpɛɛwǝ rǝ ŋwǝ, kǝ ŋ fǝ no otulǝmǝyǝ we ŋ lɛmɩ nǝ ǝtǝŋpǝ. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />Nyiyǝ we ŋ naa kʊla mǝ mǝ we, le yi la tɛɛ rǝ mǝ. Yǝ we ŋ naa ya nóo toŋ mǝ kǝ la ca enyipǝ lo ku lo koonu Worokoyǝ we, ya lée piri enyipǝ rǝ.»<verse eid="LUK 11:23" /></para>
  <para style="s">Wɛɛrɔɔrɔɔrǝ lóo koru asiɛnɩ bǝ rǝle kǝtiikuukuukǝ</para>
  <para style="r">(<ref loc="MAT 12:43-45">Matewu 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />«Vǝ́ wɛɛrɔɔrɔɔrǝ lo ru rǝ nyiyǝ we, a lǝ ŋ ka ya lǝ ŋ siri rǝ nyɔŋkpaakǝtǝǝwǝ lǝ ŋ taa fɛɛtiiwǝ. Mǝŋ laa nya fɛɛwǝ we, a lǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋ́ náa siɛnɩ ŋ́ ko mǝ kǝtiikǝ we ŋ́ no ru wǝ.” <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Vǝ́ wɛɛrɔɔrɔɔrǝ sa la siɛnɩ lǝ pǝ fɛɛtiikuukuuwǝ sa, wǝ́ lo turu wǝ la cɛɛlɩ wǝ lo toolu we, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />oturu la siɛnɩ la ka taa awɛɛrɔɔrɔɔpʊŋpwayǝ apǝrɩmata, yǝ pǝlǝ yǝ teeri rǝ gʊla mǝ rǝla wɛ. Yǝ ŋ mǝ pǝ yǝ pe tii rǝ nyiyǝ we lǝ mǝrǝ. Nyiyǝ we la vɔrʊrǝ lǝ ŋ siɛnɩ bǝlǝ deeri kǝsǝŋkǝ.»<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Kǝ́ Yesu ŋ ya ŋ́ náa tɛŋ etieyǝ sa we, wǝ́ tieyǝ rɛ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ rǝ enyipǝ we lǝ mǝrǝ ŋ tɛnɩ ǝkǝnǝŋ: «Tieyǝ we ŋ ne re lǝ́ wǝkulukpǝ, wǝ́ ŋ na mɛɛnɩ lǝ́, ŋwǝ yǝ lo co yǝ!» <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />Paa wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Epǝ we bomu pǝ lóo nuŋ Worokoŋtierǝ, wǝ́ pǝ lée yee pǝ ŋ saŋ rǝ rǝ we, ŋpǝ pǝ lo co yǝ wǝ».<verse eid="LUK 11:28" /></para>
  <para style="s">Enyipǝ pǝ lǝ pǝ́ Yesu ŋ yee tucovurǝ rɛ ŋ kaŋ pǝ</para>
  <para style="r">(<ref loc="MAT 12:38-42">Matewu 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Kǝ́ nyikpǝŋwǝ we wǝ tǝ wǝ ya wǝ láa naanǝ wǝ ŋ kʊla we, wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Ruŋruŋ le enyipǝ sa pǝ pǝlǝ. Pǝ ya pǝ lǝ́ǝ pǝ́ tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii mǝ ŋ na maŋ. Pǝ lǝŋ pa nyɩŋ tucovurǝ sa wǝrʊʊkpǝ pwi, we tɛŋ worokokpɛɛnuŋtɛŋtǝyǝ Yona la nɛŋwǝ we ceŋceŋ rǝ. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Mǝŋ kǝ́ Yona ŋ ke ri tucovurǝ ŋ kòonu Eninivetǝpǝ we, kaa wǝǝ Nyɩmaasɩ le Pi ŋ neh pe ri tucovurǝ ŋ koonu ruŋruŋ le enyipǝ wǝǝ. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Wǝkpaŋtɛŋkpǝ le jirǝ we, pilitieyǝ we ŋ no ru rǝ gǝŋrǝ we pǝ lóo pwo Saba we, leh pe yi ŋ yaa rǝ rǝkǝsa le enyipǝ la kǝnyɩŋkǝ, kǝ ŋ tɔɔ pǝ la bɔrǝ. Duturǝ ɖi rù rǝ gǝŋrǝ rɛ ciriciri ŋ po nuŋ Salomo lo otuciyǝ le etieyǝ. Paa nǝ yɩrɩ re, nyiyǝ rɛ yaa rǝ fɛɛwǝ sa teeri Salomo. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Wǝkpaŋtɛŋkpǝ le jirǝ we, Eninivetǝpǝ pǝ lée yi pǝ ya rǝ rǝkǝsa le enyipǝ la kǝnyɩŋkǝ, kǝ pǝ tɔɔ pǝ la bɔrǝ. Duturǝ ɖi Eninivetǝpǝ pǝ nunu Yona lo Worokoŋtierǝ wǝ́ pǝ sìɛrɩ vɔrʊrǝ. Paa nǝ yɩrɩ re, nyiyǝ rɛ yaa rǝ fɛɛwǝ sa teeri Yona.»<verse eid="LUK 11:32" /></para>
  <para style="s">Enimiyǝ yǝ ri kaŋrewǝ yǝ koonu wɛlɛŋrǝ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />Rɛ lǝŋ too kaŋrewǝ ŋ lɛ kǝ ŋ fǝ wǝ ŋ ŋwaa amaa kǝ ŋ fǝ zomurǝ ŋ punu wǝ. Paa pǝ lǝ́ǝ fǝ wǝ pǝ ŋ tɛɛ rǝ tutɛɛkaŋrewǝ kǝ wǝ nya fɛɛ wǝ ŋ nyɩnɩ epǝ we pǝ leh fii nyarǝwǝ. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Lé enimiyǝ yǝ ri lá wɛlɛŋrǝ la kaŋrewǝ. Mǝŋ lé enimiyǝ yǝ ponu lǝ́ we, lá wɛɛlɛŋrǝ kpǝlo kɩɩkɩ gbii rǝ wǝnyɩɩnɩkpǝ. Paa mǝŋ lé enimiyǝ yǝ loo poŋ lǝ́ we, lá wɛlɛŋrǝ gbii rǝ nuŋtumuwǝ. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Kǝto yee lá wɛ lo yurǝ kǝ wǝnyɩɩnɩkpǝ we wǝ kpii rǝ lǝ́ wǝ pee fii nuŋtumuwǝ. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Mǝŋ lá wɛɛlɛŋrǝ kpǝlo gbii rǝ wǝnyɩɩnɩkpǝ wǝ́ lá fɛɛpiwǝ rɛ wǝ loo turu we, lá wɛɛlɛŋrǝ kpǝlo kɩɩkɩ lah mǝ nyɩnɩ, mǝŋ kǝ́ kaŋrewǝ wǝ láa nyɩnɩ lǝ́ sɩsiɛrɩ kǝtǝ.<verse eid="LUK 11:36" /></para>
  <para style="s">Yesu la kpamǝ Afarisitǝpǝ mǝ oworokosekaŋtǝpǝ</para>
  <para style="r">(<ref loc="MAT 23:4-36">Matewu 23:4-36</ref>, <ref loc="MRK 12:38-40">Marǝko 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ Farisitǝnyiyǝ rɛ ŋ pwò ŋwǝ ŋ pe ri rǝ nǝ kpǝŋ. Wǝ́ Yesu ŋ kolu nyarǝwǝ we. Wǝ́ ŋ kolu ŋ tini ŋ ke ŋ ri. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Kǝ́ Farisitǝnyiyǝ sa ŋ na nyɩŋ ǝkǝnǝŋ Yesu laa naŋ mǝŋ kǝ́ pǝlo kǝsuŋkǝ<note caller="+" style="f"><char style="fr" closed="false">11:38 </char><char style="ft" closed="false">Rǝ Isǝrayɛlǝtǝpǝ lǝ kpǝŋ we, anaŋkǝ sa kǝ ke ri rǝ pǝla zʊmarǝ lo kǝsuŋkǝ.</char></note> kǝ lǝ pǝ́ wǝ́ ŋ ya ŋ née ri we, wǝ́ wǝ yeli na tǝrɛ. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Wǝ́ Kulǝtǝyǝ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ nǝ lǝ wǝǝ ŋnǝ Afarisitǝpǝ sa. Nǝ nyáa wɛɛ kɔpʊwǝ mǝ kǝsiɛkǝ la kǝmaakǝ kǝ yǝ lɛrɩ rǝ Worokoyǝ le enimiyǝ. Paa nǝ ziɔŋrǝ lǝ lǝ mǝ kǝnyisisikǝ mǝ yulɛnyɩrǝ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Otuleecitǝpǝ sa! Worokoyǝ we ŋ ne yee dǝǝtǝǝrǝ wǝǝ, ŋkǝ ŋwǝ ke ŋ ne yee mǝrǝ? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Kǝto nǝ fǝ tuwǝ we wǝ kpii rǝ nǝ akɔpʊyǝ mǝ nǝ wǝsiɛkpǝ lǝ mǝrǝ nǝ koonu ariariatǝpǝ. Eniyǝ we tu ri ŋ tu wǝ láa siɛrɩ kenikeni wǝ koonu nǝ.» <verse eid="LUK 11:41" /><verse number="42" style="v" sid="LUK 11:42" />Ŋnǝ Afarisitǝpǝ nǝ paapɔ mǝ nǝ aria. Duturǝ ɖi nǝ nyóo koonu Worokoyǝ lo tutǝtǝwǝ koru mǝŋ ayɩlɩtuyǝ mǝ eweyǝ we pǝ lée ri wǝ. Paape nǝ nyǝŋ yee nǝ saŋ rǝ wǝkʊʊkpǝ, wǝ́ nǝ nyǝŋ lɛ nǝ taa Worokoyǝ lǝ kǝǝwǝ. Ŋyǝ otuyǝ sa wǝ́ wǝ kaamǝ kǝ nǝ yee kpɛŋ. Paa kǝ nǝ poo yuu otuturuyǝ we la kpɛɛ. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />Ŋnǝ Afarisitǝpǝ nǝ paapɔ mǝ nǝ aria. Nǝ nyáa taa nǝ mǝ tii rǝ omumuŋpǝ la afɛɛtiiyǝ rǝ okumwɛŋnyuŋyǝ, wǝ́ nǝ nyáa taa pǝ ŋ pɛɛlɩ pǝ ŋ ceeni nǝ rǝ acanɩtiyǝ. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Nǝ paapɔ mǝ nǝ aria. Nǝ nyo ru ofuŋtɔŋyǝ we yǝ lǝ tǝ<note caller="+" style="f"><char style="fr" closed="false">11:44 </char><char style="ft" closed="false">Ofuŋtɔŋyǝ we yǝ lǝ tǝ: Isǝrayɛlǝtǝpǝ pǝ ka ŋ tɔ tuwǝ rǝ pǝlo ofuŋtɔŋyǝ kǝ rɛ ŋ paa nya fɛɛ ŋ saŋ rǝ yǝ. Kpiikǝ vǝ́ rɛ la saŋ rǝ vuŋtɔŋrǝ ko, yǝ we la cɩɩrɩ na wɛ.</char></note>, enyipǝ pǝ láa yapǝ pǝ ŋ ko pǝ ŋ tɛlɩ oturu pǝ lǝŋ ci wǝ ǝkǝnǝŋ ofuŋtɔŋyǝ yǝ lǝǝwe. <verse eid="LUK 11:44" /><verse number="45" style="v" sid="LUK 11:45" />Wǝ́ oworokosekaŋtǝpǝ le ceŋceŋ ŋ tìi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ mǝŋ a la tɛŋ wǝ ǝnǝ, o lóo turu a la fɛɛ ŋla ŋkpɛ rǝ!» <verse eid="LUK 11:45" /><verse number="46" style="v" sid="LUK 11:46" />«Ŋnǝ, oworokosekaŋtǝpǝ ŋnǝ ŋkpɛ nǝ paapɔ mǝ nǝ aria! Nǝ ya nǝ nyáa tɛɛ enyipǝ le eleeyǝ yǝ lɛnyɩ ereekǝ wǝ. Paa ŋnǝŋnǝ nǝ nyǝŋ ce nǝ ruu eleeyǝ sa mǝ nǝ gaapirǝ ǝkǝŋtǝ nǝ yɩrɩ. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Nǝ paapɔ mǝ nǝ aria! Nǝ ya nǝ nyáa marǝ oworokokpɛɛnuŋtɛŋtǝpǝ lo ofuŋtɔŋyǝ. Paa nǝ ǝtǝpǝ pǝ la wʊʊlʊ pǝ. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Mǝŋkǝsa we, nǝ ya nǝ nyáa pɔrʊ nyǝ ŋ kaŋ ǝkǝnǝŋ nǝ nyáa tɛɛ akaa rǝ nǝ ǝtǝtǝpǝ lo otuyeeyǝ. Duturǝ ɖi pǝ la wʊ oworokokpɛɛnuŋtɛŋtǝpǝ. Wǝ́ ŋnǝ, nǝ ya nǝ nyáa marǝ pǝlo ofuŋtɔŋyǝ! <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Wǝ kǝto Worokoyǝ we ŋ ci tu ri ŋ tu, ŋ na tɛŋ ǝkǝnǝŋ: “Ŋ́ née kpii oworokokpɛɛnuŋtɛŋtǝpǝ mǝ enyikpiipǝ ŋ maŋ pǝ. Pǝ lah pa wʊʊlʊ arɛɛpǝ kǝ pǝ yi pǝ tɛɛ rǝ arɛɛpǝ.” <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Kǝto, ŋnǝ rǝkǝsa le enyipǝ we, Worokoyǝ láa ta nǝ kǝtukoŋkǝ. Rǝ oworokokpɛɛnuŋtɛŋtǝpǝ we kpǝlo kɩɩkɩ enyipǝ pǝ la wʊʊlʊ lo yurǝ, ru ǝrǝ ǝrǝkǝ lǝ kǝsǝŋkǝ fǝ mǝ pǝ. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Wǝ lǝ sǝŋ rǝ Abɛlǝ la awʊʊkǝ po ru ǝrǝ Zakari la awʊʊkǝ. Pǝ wʊlʊ Zakari rǝ otoolucuukǝ mǝ Worokoyǝ lo gukpǝ le kǝtiitiikǝ. Kǝceece, ŋ́ ya ŋ́ née tíi nǝ wǝ. Worokoyǝ láa ta rǝkǝsa le enyipǝ lo kǝtukoŋkǝ rǝ kǝnyiwʊʊlʊkǝ sa kǝto. <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />Ŋnǝ esekaŋtǝpǝ, nǝ paapɔ mǝ nǝ aria! Nǝ nya taŋ ŋwaarǝ we lóo koonu kǝ pǝ ci Worokoyǝ, wǝ́ nǝ re safweyǝ we. Ŋnǝŋnǝ nǝ nyee fii, wǝ́ nǝ nya lɛ nǝ nyǝ sǝŋ gʊŋrǝ nǝ nyo koonu epǝ we pǝ ya pǝ lǝ́ǝ pǝ́ pǝ fii wǝ.» <verse eid="LUK 11:52" /><verse number="53" style="v" sid="LUK 11:53" />Kǝ́ Yesu ŋ no ru rǝ Farisitǝnyiyǝ we la nyarǝwǝ we, wǝ́ esekaŋtǝpǝ mǝ Afarisitǝpǝ pǝ fǝ̀ kpɛɛmʊrʊwǝ ŋpa. Wǝ́ pǝ kǝ ŋ pǝ́ ne etieyǝ ru rǝ otuyǝ wa. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Pǝ kǝ ŋ pǝ́ pǝ ta no nyuŋkpǝ kǝ pǝ fǝ no tutɛŋwǝ rɛ pǝ yee dierǝ mǝ ŋwǝ.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Nǝ pee yee alakpayǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Rǝ eniyǝ we lǝ mǝrǝ we, wǝ́ enyipǝ lafawǝ pakapaka pǝ pǝlǝ pǝ kù sisi, kǝto pǝ ka ŋ yapǝ awɛ rǝ. Wǝ́ Yesu ŋ ka ŋ wɛɛlɩ mǝ no otukarǝtǝpǝ kpɛŋ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ yee yurǝ rǝ Afarisitǝpǝ la dafaŋrǝ, ŋ́ reemǝ pǝla alakpayǝ. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Tu ri ŋ tu wǝ la ŋwaa we, pǝ lǝ́ǝ pǝ pǝ ŋ nyɩŋ wǝ. Wǝ́ tuŋwaawǝ rɛ wǝ lee kpii enyipǝ pǝ lǝŋ pe ci wǝ. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Kǝto tu ri ŋ tu nǝ nyáa tɛŋ rǝ nuŋtumuwǝ we, jɔkɔŋrǝ ketekete wǝ́ enyipǝ pǝ loh po nuŋ wǝ. Tuwǝ we a láa ŋwaa e tíi la kɛrɩyǝ rǝ kǝtukoŋkǝ, rǝ kǝ́ nǝ nya taŋ ŋwaarǝ nǝ kpii rǝ wǝkukpǝ we, pǝ lah pa ca wǝlo goŋkoŋrǝ rǝ canɩyǝ.»<verse eid="LUK 12:3" /></para>
  <para style="s">Ǝlǝ wǝ́ wǝ kaamǝ kǝ pǝ suu wǝ?</para>
  <para style="r">(<ref loc="MAT 10:28-31">Matewu 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />«Ŋnǝ ǝpǝ nǝ ri mǝ ǝtǝŋpǝ, ŋ́ ya ŋ́ née tíi nǝ wǝ, nǝ poo suu epǝ we pǝ láa wʊ wɛlɛŋrǝ, rǝ wǝla kǝmaakǝ we, pǝ lǝŋ koru tǝrɛ le eyee pǝ kʊla wǝ. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Ŋ́ náa kaŋ nǝ yǝ we wǝ kaamǝ kǝ nǝ suu wǝ. Nǝ suu Worokoyǝ. Duturǝ ɖi vǝ́ nǝ nyǝ́ǝ kpǝ́ la kǝmaa we, lǝǝmǝ okopiyǝ ŋ nǝ́ǝ fǝ nǝ kǝrukǝ ŋ kpii rǝ naalaalɛwǝ. Kǝceece, ŋ́ ya ŋ́ née tíi nǝ wǝ, ŋwǝ wǝ́ wǝ kaamǝ kǝ nǝ suu wǝ. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Enyipǝ pǝ cii wǝ ǝkǝnǝŋ pǝ lóo koru esiiri akpaŋsapǝ atʊʊ bie. Paape Worokoyǝ láa yɩrɩ pǝlo kpǝlo kɩɩkɩ lo yurǝ. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Wǝ́ nǝ oyurooyǝ ǝkǝŋtǝ we, Worokoyǝ cii yǝlo kuruyuwǝ. Nǝ poo suu vurǝ! Nǝ nya lɔ okuruyǝ ŋpa nǝ nye teeri akpaŋsapǝ.»<verse eid="LUK 12:7" /></para>
  <para style="s">Wǝ kaamǝ kǝ nǝ ri Yesu la anɛŋpǝ rǝ enyikpǝlo le enimiyǝ</para>
  <para style="r">(<ref loc="MAT 10:32-33">Matewu 10:32-33</ref>, <ref loc="MAT 12:32">12:32</ref>, <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />Ŋ́ ya ŋ née tíi nǝ wǝ ǝkǝnǝŋ: «Nyi ri ŋ nyi ŋ náa tɛŋ rǝ enyipǝ le enimiyǝ ǝkǝnǝŋ ŋwǝ ŋ ri mǝ nɛŋyǝ we, Nyɩmaasɩ le Pi ŋwǝ ŋkpɛ lah ka nyɩŋ ŋwǝ ŋ ci rǝ Worokoyǝ le epicoŋpipǝ le enimiyǝ ǝkǝnǝŋ ri na nɛŋyǝ. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Paa nyiyǝ we ŋ náa tɛŋ rǝ enyipǝ le enimiyǝ ǝkǝnǝŋ ŋwǝ ŋ nee ci mǝ we, Nyɩmaasɩ le Pi ŋwǝ ŋkpɛ lah ka tɛŋ rǝ Worokoyǝ le epicoŋpipǝ le enimiyǝ ǝkǝnǝŋ ŋ nee ci ŋwǝ.» <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Yǝ we ŋ náa tɛŋ tuwǝ rɛ ŋ tɛɛ rǝ Nyɩmaasɩ le Pi we, Worokoyǝ lǝ́ǝ fǝ ŋ cɛɛ ŋwǝ. Paa yǝ we ŋ na tɛŋ pusuŋtǝtuwǝ rɛ ŋ tɛɛ rǝ Wɛɛkenikenirǝ we, Worokoyǝ lǝŋ pǝ fǝ wǝ ŋ cɛɛ ŋwǝ pwi. <verse eid="LUK 12:10" /><verse number="11" style="v" sid="LUK 12:11" />Mǝŋ pǝ lo ko mǝ nǝ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ pǝ ka tɛŋ wǝkpaŋkpǝ mǝ nǝ we, amaa pǝ lo ko mǝ nǝ rǝ epilipǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ la kǝnyɩŋkǝ we, nǝ pǝǝ kǝǝnǝ kǝ́ nǝ nyah ka tɛŋ nǝ pɛɛnɩ nǝ wɛ nǝ fǝ wǝ amaa tuwǝ nǝ nyah ka tɛŋ wǝ. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Kpiikǝ vǝ́ eniyǝ yǝ lo ro we, Wɛɛkenikenirǝ láa kaŋ nǝ tuwǝ nǝ nyáa tɛŋ wǝ.<verse eid="LUK 12:12" /></para>
  <para style="s">Tuwǝ we wǝ lǝ́ǝ pǝ wǝ ŋ tu epǝ we pǝ láa kʊʊ otulǝmǝyǝ pǝ ŋ tǝnǝ pǝla wɛ wǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Wǝ́ nyiyǝ rɛ rǝ nyikpǝŋwǝ we lǝ mǝrǝ ŋ tìi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, tíi mǝ paanʊ kǝ ŋlǝ mǝ ŋwǝ lǝ sǝpǝ lǝh ǝtǝtuyǝ.» <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kɛrɩ, ǝlǝ ŋ na pɔrʊ mǝ ŋ́ tɛŋ nǝ etieyǝ amaa ŋ́ sǝpǝ nǝ otulǝmǝyǝ?» <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Wǝ́ Yesu ŋ tìi enyipǝ we kpǝlo ǝkǝnǝŋ: «Nǝ yee nǝ wɛ lo yurǝ. Nǝ paa mwɛɛrɩ nimirǝ taa rǝ otulǝmǝyǝ. Duturǝ ɖi ŋkǝ otulǝmǝyǝ yǝ lóo koonu vɔrʊrǝ.» <verse eid="LUK 12:15" /><verse number="16" style="v" sid="LUK 12:16" />Wǝ́ ŋ cà pǝ lo duturǝ sa ǝkǝnǝŋ: «Sɩkalǝtǝyǝ rɛ ke kpii. Wǝ́ na atɛɛtɛɛtuyǝ yǝ pònu ŋwǝ ŋpa. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Wǝ́ ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ: “Kǝ́ wǝ́ ŋ́ neh yee? Fɛɛwǝ wǝ laa kpɛɛ mǝ ŋ́ nǝ́ǝ fǝ ekeeriyǝ sa kpǝlo ŋ́ tǝnǝ.” <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: “Tuwǝ sa wǝ́ ŋ́ née yee. Ŋ́ náa wɔɔ mǝ owulǝŋyǝ, kǝ ŋ́ tɔ ayǝyɔkɔɔyǝ. Kǝ ŋ́ wʊʊ mǝ ekeeriyǝ mǝ mǝ otulǝmǝpʊŋpwayǝ ŋ́ ke kpii.” <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Wǝla kǝmaakǝ kǝ mǝ ŋ tíi mǝ wɛ ǝkǝnǝŋ: “Ŋ́ lǝǝmǝ otuyǝ ŋpa. Yǝ lóo koru oro mǝ cɛŋwǝ pakapaka. Rǝkǝsa we, ŋ́ née tii ŋ́ wɛɛ. Kǝ mǝ ŋ ri, kǝ mǝ ŋ ŋuŋ kǝ mǝ ŋ ri vʊrʊrǝ.”» <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Paape wǝ́ Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tuleecitǝyǝ, ruŋruŋ lo dumurǝ sa ǝ lǝ́ǝ kpǝ́. We otuyǝ we o lo toolu ǝ lǝ tǝnǝ wǝǝ, yǝ láa siɛrɩ yǝ yee ǝlǝ la anɛŋ?» <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />Tuwǝ sa kǝtǝŋkǝ wǝ lǝ́ǝ pǝ wǝ ŋ tuu epǝ we pǝ la kʊʊ otulǝmǝyǝ pǝ lǝ kǝŋ pǝla wɛ wǝ. Paa oturu pǝlo otulǝmǝyǝ sa yǝ lee ri tǝrɛ rǝ Worokoyǝ le enimiyǝ.<verse eid="LUK 12:21" /></para>
  <para style="s">Tɛɛ kpɛɛwǝ rǝ Worokoyǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Wǝ́ Yesu ŋ tǝ ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ, nǝ pǝǝ kǝǝnǝ tuwǝ nǝ nyée ri, mǝ tuwǝ nǝ nyóo ŋuŋ kǝ nǝ tii vɔrʊrǝ wǝ amaa kǝkpakǝ nǝ nyée kpii wɛlɛŋrǝ wǝ. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Duturǝ ɖi, nǝ vɔrʊrǝ lo ru okuruyǝ le teeri keeriwǝ. Wǝ́ nǝ wɛlɛŋrǝ lo ru okuruyǝ le teeri kǝkpakǝ. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Nǝ yɩrɩ akwakwapǝ re, pǝ lǝŋ rʊ tǝrɛ, wǝ́ pǝ lǝŋ fa tǝrɛ. Pǝ lǝŋ toolu keeri pǝ tǝnǝ rǝ wulǝŋ! Paape Worokoyǝ lóo kuŋ pǝ le keeriwǝ. Nǝ nyo ru okuruyǝ ŋpa nǝ nye teeri ofuripǝ! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ǝlǝ ŋ kpii rǝ nǝ mǝrǝ ŋ nóo koru ata enipiyǝ rɛ tɩpɩrɩ ŋ tɛɛ rǝ na vɔrʊrǝ le eciyǝ<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="ft" closed="false">Pǝ lóo koru onuŋ wǝ lo duturǝ ǝkǝnǝŋ: Rǝ oyupuyǝ kǝto kǝ nyiyǝ ŋ kǝŋ ŋ kʊla?</char></note> rǝ kǝǝnǝwǝ kǝto? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Mǝŋ nǝ nyǝŋ koru eyee tupiwǝ sa ǝkǝŋtǝ, kǝ́ kǝto wǝ́ nǝ ya nǝ nyǝ́ǝ kǝǝnǝ otututuruyǝ wǝ? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Nǝ yɩrɩ otumɔŋyǝ rǝ bɔɔrǝ re! Yǝ lǝŋ yee kǝnǝnɛkǝ rɛ wǝ́ yǝ lǝŋ yaa nyaŋrǝ rɛ. Paape ŋ́ ya ŋ́ née tíi nǝ wǝ: Piliyǝ Salomo kǝ lǝǝmǝ na wɛ ŋpa. Paape na wǝkpakpǝ wǝ loo poŋ wǝ kaamǝ otumɔŋyǝ sa la rɛ. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Worokoyǝ láa cɛ mǝ bɔɔrǝ lo otumɔŋyǝ sa yǝ yaa ruŋruŋ. Paape Sooso ko, pǝ le tie rǝ pǝ le kpii rǝ naawǝ wǝǝ, kǝ ŋ wɛɛ lǝŋ cɛ mǝ nǝ ŋ teeri? Kǝ́ kǝto wǝ́ nǝ lɔnuŋrǝ laa naanǝ mǝŋ tɩ ǝnǝ? <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Ŋnǝ we, nǝ pǝǝ tǝ nǝ kpii nǝ wɛ la vaŋrǝ nǝ ya nǝ mǝ taa, tuwǝ nǝ nyée ri amaa tuwǝ nǝ nyóo ŋuŋ wǝ. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Epǝ we pǝ lee ci Worokoyǝ we, ŋpǝ pǝ re pǝ yaa mǝ otuyǝ sa kpǝlo la ataakǝ kǝtiikǝ kǝ lee kpii. Paa ŋnǝ we, nǝ Tǝ cii wǝ ǝkǝnǝŋ yǝ ya yǝ lée yee nǝ ariaayǝ. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Nǝ mǝ taa Worokoyǝ le wǝpilirikpǝ bomu, mǝŋkǝsa we, lǝ́ǝ fǝ otututuruyǝ we ŋ koonu nǝ ŋ kʊla.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />Ŋnǝ ǝpǝ nǝ ri mǝ anɛŋpǝ we, nǝ poo suu vurǝ. Duturǝ ɖi wǝ lo poŋ mǝ nǝ tǝ ŋ fǝ nǝ ŋ kʊla mǝ ne wǝpilirikpǝ.»<verse eid="LUK 12:32" /></para>
  <para style="s">Nǝ toolu nǝ otulǝmǝyǝ nǝ tǝnǝ rǝ Worokoyǝ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33" />«Nǝ siiri nǝ otulǝmǝyǝ kǝ nǝ fǝ sɩkayǝ we nǝ yee wǝceeceekpǝ nǝ koonu ariariatǝpǝ. Nǝ yee asɩkalotoyǝ we yǝ lǝŋ laarǝ nǝ koonu nǝ wɛ. Nǝ toolu nǝ otulǝmǝyǝ nǝ tǝnǝ rǝ yulaarǝ, fɛɛwǝ yǝ lǝŋ lǝǝ wǝ. Fɛɛwǝ we yɩlayɩtǝyǝ rɛ ŋ nǝŋ koru yǝ la ayɩ amaa zaŋrǝ lǝŋ koru yǝ lo owo wǝ. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Duturǝ ɖi fɛɛwǝ we nǝ otulǝmǝyǝ yǝ kpɛlɩ we, fɛɛwǝ nǝ yurǝ dɛɛ wǝǝ.»<verse eid="LUK 12:34" /></para>
  <para style="s">Nǝ kpaka nǝ mǝ rǝŋ Nyɩmaasɩ le Pi</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />Nǝ kpaka, nǝ kɔmǝ nǝ parǝ kǝ nǝ too nǝ akaŋreyǝ. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Nǝ tii nǝ mǝ rǝŋ, mǝŋ kǝ́ asʊmatǝpǝ pǝ lée tii pǝ ŋ rǝŋ pǝlo kulǝtǝyǝ ŋ no ko fɛɛlɔtieyǝ kǝtǝ. Vǝ́ lo ko ru lǝ́ǝ pǝ, wǝ́ ŋ na ca ŋwaarǝ we, kǝ pǝ nya fɛɛ pǝ taanǝ ŋwǝ. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Asʊmatǝpǝ we kulǝtǝyǝ ŋ nah pa nyɩŋ pǝ tini pǝ lǝ́ǝ rǝŋ ŋwǝ we, pǝ lo co yǝ. Ŋ́ ya ŋ́ née tíi nǝ anʊkɔrǝyǝ, kulǝtǝyǝ ŋwǝ ŋkpɛ lah ka cɛkɛlɛ na wɛ, kǝ ŋ koonu pǝ la asaayǝ pǝ tii, kǝ ŋ pa lɛmɩ pǝ le keeriwǝ. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Kulǝtǝyǝ we ŋ ke ce ŋ ko ru mǝ ŋ pǝ mǝ kǝ́ kǝ la cɩɩ kǝ lǝ sǝpǝ amaa mǝ rokoŋpikaalǝwǝ, wǝ́ ŋ na pa nyɩŋ asʊmatǝpǝ sa pǝ tini pǝ lǝ́ǝ rǝŋ ŋwǝ we, ŋpǝ asʊmatǝpǝ sa pǝ lo co yǝ.<verse eid="LUK 12:38" /></para>
  <para style="r">(<ref loc="MAT 24:45-51">Matewu 24:45-51</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 12:39" />Nǝ cii wǝ ǝkǝnǝŋ mǝŋ nyarǝlǝtǝyǝ keh ci eniyǝ we yɩlayɩtǝyǝ ŋ nǝ́ǝ pǝ na nyarǝwǝ we, kah saanǝ ŋ tii ŋ rǝŋ. Lǝŋ ka maa ŋwǝ ŋ wǝǝrǝ giriŋrǝ ŋ fii na nyarǝwǝ. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Ŋnǝ ŋkpɛ nǝ kpaka nǝ tii, duturǝ ɖi Nyɩmaasɩ le Pi lǝh pǝ pǝ mǝ eniyǝ we nǝ nyǝǝ kǝ wǝ wǝ.<verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Wǝ́ Pɛtǝro ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋlǝ ló otukarǝtǝpǝ sa sɔŋ wǝ́ a ya láa ca duturǝ sa amaa mǝŋ enyituturupǝ?» <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Wǝ́ Kulǝtǝyǝ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝlǝ ŋ ri nʊkɔrǝtǝsʊmatǝyǝ we ŋ sieni nimirǝ wǝ? Ŋwǝ ŋ kaamǝ yǝ we kulǝtǝyǝ ŋ nǝ́ǝ fǝ na nyarǝwǝ mǝ ŋ kpii rǝ akaakǝ mǝ ŋ yɩrɩ kǝ mǝ ŋ lɛ mǝ ŋ koonu kulǝtǝyǝ la asʊmatǝpǝ le keeriwǝ rǝ eniyǝ. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Ŋwǝ sʊmatǝyǝ sa lo co yǝ mǝŋ no kulǝtǝyǝ lo ko ru lǝ́ǝ pǝ, wǝ́ ŋ na pa nyɩŋ ŋwǝ ya lée yee kǝnǝnɛkǝ sa sɩsiɛrɩ wǝ! <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, kulǝtǝyǝ sa lǝ́ǝ fǝ no otulǝmǝyǝ kpǝlo kɩɩkɩ ŋ kpii ŋwǝ rǝ akaakǝ mǝ ŋ yɩrɩ yurǝ. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Paa mǝŋ sʊmatǝyǝ sa la tɛŋ ǝkǝnǝŋ “Mǝ kulǝtǝyǝ lǝŋ pa maa ŋ pǝ”, eniyǝ we leh kpii mǝ ŋ culu asʊmatǝpǝ we mǝŋ etie mǝŋ ǝpǝrǝŋ, kǝ mǝ ŋ ri kǝ mǝ ŋ ŋuŋ ŋ mǝ ŋ piemu. <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />Kulǝtǝyǝ leh pe fii mǝ jirǝ we sʊmatǝyǝ sa ŋ naa tɛɛ kpɛɛwǝ wǝ, mǝ eniyǝ we ŋ nee ci wǝ. Kulǝtǝyǝ sa lée piri ŋwǝ kǝ ŋ ta no kǝtukoŋkǝ ŋpa mǝŋ kǝ́ pǝ láa ta epǝ we pǝ lǝŋ yee anʊkɔrǝyǝ lo kǝtukoŋkǝ kǝtǝ. <verse eid="LUK 12:46" /><verse number="47" style="v" sid="LUK 12:47" />Sʊmatǝyǝ le yǝ we ŋ ci tuwǝ wǝ ponu mǝ no kulǝtǝyǝ, paa wǝ́ ŋ nee yee wǝ ŋ tǝnǝ ŋwǝ, wǝ́ ŋ naa lɛ ŋ yee no kulǝtǝyǝ lǝ kǝǝpǝ́wǝ we, láa lɔ ocuculupiyǝ ŋpa. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Paape sʊmatǝyǝ le yǝ we ŋ nee ci tuwǝ we no kulǝtǝyǝ ŋ nǝ́ǝ pǝ́ wǝ, wǝ́ ŋ ne yee tuwǝ wǝ kaamǝ tukoŋtawǝ we, no kulǝtǝyǝ lǝŋ culu ŋwǝ ŋpa. Vǝ́ pǝ lo koonu rɛ ŋpa we, pǝ lah pa lɔ rǝ ŋwǝ ŋpa. Vǝ́ pǝ lǝ fǝ otumumuŋyǝ rɛ pǝ le kpii rɛ rǝ akaakǝ we, pǝ lǝh pǝ pǝ́ ŋwǝ pǝ teeri kɔɔwǝ we.»<verse eid="LUK 12:48" /></para>
  <para style="s">Yesu lo yurǝ kǝto enyipǝ pǝ lǝ́ǝ sǝpǝ rǝ awɛ</para>
  <para style="r">(<ref loc="MAT 10:34-36">Matewu 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />«Ŋ́ nǝ pǝ ŋ́ pe kpii naawǝ rǝ kǝtǝǝwǝ rǝ. Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ kǝ o ko turu wǝ la marǝ wǝ la lɔ kaka! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Ŋ́ neh wii acʊcʊʊrʊpiyǝ wǝlǝ kǝtǝŋkǝ wǝ lee kpii. Ŋ́ nǝh kpǝ́ mǝ kǝǝnǝwǝ, kǝ o po nuŋ tuwǝ sa wǝ lǝ pǝ wǝ la ka lɛ rǝ. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Nǝ nyóo pu wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝ pǝ mǝ wǝtaarǝkpǝ rǝ kǝtǝǝwǝ rǝ? Kʊrakʊra! Paa ŋ́ nǝ pǝ ŋ́ pe kpii wǝsǝpǝkpǝ rǝ enyipǝ mǝrǝ rǝ. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Fǝ rǝkǝsa mǝ ko we, nyarǝwǝ ceŋceŋ le enyipǝ pǝ lǝŋ mǝ nuŋ awɛ lo duturǝ. Mǝŋ pǝ lǝ enyipǝ atʊʊ we, ata pǝ lée yi pǝ tɛɛ rǝ eyi, kǝ eyi pǝ yi pǝ tɛɛ rǝ ata. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Tǝyǝ lée yi ŋ tɛɛ rǝ no kosopiyǝ, kǝ kosopiyǝ ŋ yi ŋ tɛɛ rǝ nǝ tǝyǝ. Leeyǝ lée yi ŋ tɛɛ rǝ na kɔrʊyǝ, kǝ kɔrʊyǝ ŋ yi ŋ tɛɛ rǝ ne leeyǝ. Nuŋleeyǝ lée yi ŋ tɛɛ rǝ ne piletieyǝ, kǝ piletieyǝ ŋ yi ŋ tɛɛ rǝ no nuŋleeyǝ.»<verse eid="LUK 12:53" /></para>
  <para style="s">Nǝ nyɩŋ ǝrǝkǝ le eniyǝ nǝ ci</para>
  <para style="r">(<ref loc="MAT 16:2-3">Matewu 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Wǝ́ Yesu ŋ tìi kǝkpǝŋkǝ we ǝkǝnǝŋ: «Vǝ́ ǝrǝkǝ kǝ le rimi rǝ kǝlo yurǝ we, nǝ nyáa tɛŋ kǝtǝrǝceŋceŋ ǝkǝnǝŋ ŋʊŋtɛyǝ lo furu. Kǝceece ŋʊŋtɛyǝ ŋ pǝ. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Vǝ́ nǝ nya nyɩŋ ǝrǝkǝ kǝ ya kǝ lóo fuŋ kǝ ŋ rɛɛrɩ we, nǝ nyáa tɛŋ ǝkǝnǝŋ naawʊrǝ lah wʊ ŋpa. Kǝceece ǝ lǝ ŋ wʊ ŋpa. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Alakpatǝpǝ wǝ́ nǝ ri! Nǝ nyóo koru anyɩŋ kǝtǝǝwǝ mǝ ǝrǝkǝ lǝ wǝlǝkpǝ nǝ ci. Kǝ́ kǝto wǝ́ nǝ nyǝŋ nuŋ rǝkǝsa lo otuyǝ lo duturǝ wǝ?»<verse eid="LUK 12:56" /></para>
  <para style="s">Yee nyuŋceŋceŋ ŋnǝ mǝ lǝ́ kǝǝkpǝlǝtǝyǝ</para>
  <para style="r">(<ref loc="MAT 5:25-26">Matewu 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />«Wǝ lée yee nɛ, wǝ́ nǝ nyǝŋ nyɩŋ nǝ ci ŋnǝŋnǝ, tuwǝ we wǝ kaamǝ kǝ nǝ yee wǝ? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Kǝ lǝ fǝ wǝ, ŋnǝ mǝ rɛ nǝ lǝǝmǝ dierǝ. Wǝ́ nǝ eyi nǝ nyo ru nǝ nyoh ko fɛɛtɛŋakpaŋyǝ. Nyɩɩ, kǝ nǝ nuŋ awɛ lo duturǝ rǝ gʊŋrǝ. Mǝŋ ŋkǝ kaa wǝǝ we, leh ke tiini lǝ́ rǝ kpaŋtɛŋtǝyǝ we le enimiyǝ, kǝ kpaŋtɛŋtǝyǝ sa ŋ fǝ lǝ́ ŋ kpii otuusiitǝpǝ rǝ akaakǝ. Eniyǝ we otuusiitǝpǝ sa pǝ lǝ fǝ lǝ́ pǝ la ka taŋ. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, mǝŋ a laa mwara ló wǝtookpǝ we a lɛ kɩɩkɩ we, o lǝŋ po ru rǝ gukpɛɛkpǝ we pwi.»<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Yesu la kaŋ otuyǝ ǝkǝnǝŋ mǝŋ enyipǝ pǝ laa siɛrɩ vɔrʊrǝ we, pǝ lǝ́ǝ kpǝ́ pǝ pǝlǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ we, wǝ́ enyipǝ rɛ pǝ pǝlǝ pǝ pɔ̀ Yesu la amayǝ, mǝ kǝ́ piliyǝ Pilato ŋ kòonu pǝ wʊlʊ Agalileyatǝpǝ rɛ pǝ pǝlǝ pǝ ke ŋ yee otoolukǝ lo kǝsuŋkǝ rǝ Worokoyǝ la nyarǝwǝ, wǝ́ pǝla ŋpǝrayǝ ŋ lʊ̀ ŋ kʊ̀la mǝ otoolukɛɛpǝ we la ŋpǝrayǝ. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nyóo pu wǝ ǝkǝnǝŋ Agalileyatǝpǝ sa pǝ le yee oturɔɔrɔɔyǝ pǝ le teeri Agalileyatǝnyituturupǝ, fɛɛwǝ kǝto pǝ lǝ kpǝ́ gbɛŋrǝ sa wǝrʊʊkpǝ wǝǝ? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ŋ́ ya née tíi nǝ wǝ, wǝ lǝǝ lǝ ǝnǝ. Paa mǝŋ nǝ nyaa siɛrɩ nǝ vɔrʊrǝ we, nǝ kpǝlo nǝ nyǝ́ǝ kpǝ́ nǝ pǝlǝ mǝŋ Agalileyatǝpǝ sa kǝtǝ. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Nǝ nyáa taalǝ enyipǝ we tǝ mǝ anɛŋ baŋsʊrʊkǝŋyǝ we rǝ Silo ŋ tɔ̀ɔ ŋ sìi wǝ́ pǝ kpǝ̀ wǝ? Nǝ nyo pu wǝ ǝkǝnǝŋ ŋpǝ pǝ le yee oturɔɔrɔɔyǝ pǝ le teeri enyituturupǝ sa kpǝlo pǝ kpii rǝ Yerusalɛmǝ wǝ? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, wǝ lǝǝ lǝ ǝnǝ. Paa mǝŋ nǝ nyaa siɛrɩ nǝ vɔrʊrǝ we, nǝ kpǝlo nǝ nyǝ́ǝ kpǝ́ nǝ pǝlǝ mǝŋ enyipǝ sa kǝtǝ.»<verse eid="LUK 13:5" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ wǝcookpǝ wǝ laa nyɩŋ wǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Wǝ́ Yesu ŋ ca duturǝ sa ŋ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ rɛ tɔ̀ wǝcookpǝ rǝ na atɛɛkǝ. Wǝ́ nyiyǝ sa ŋ pǝlǝ ŋ pa lɛ wǝcookpǝ sa lǝ ǝtǝnǝyǝ<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">Rǝ eniyǝ we we, Oyudatǝpǝ pǝ ke ŋ ri ocootǝnǝyǝ ŋpa.</char></note>. Paape laa nyà ŋ lɛ. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Wǝ́ ŋ tìi na paalǝtǝyǝ ǝkǝnǝŋ: “Yɩrɩ re, cɛŋtatǝwǝ wǝǝ, wǝ́ ŋ́ ya ŋ́ nǝ́ǝ pǝ mǝ ŋ taa ocootǝnǝyǝ rǝ wǝcookpǝ sa. Paape ŋ́ faa nya. Kǝto sǝ kpǝ o co. Duturǝ ɖi wǝ ya wǝ lǝ́ǝ pǝlǝ kǝtǝǝwǝ rǝ tuŋtuŋ.”» <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Paape wǝ́ paalǝtǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, tǝ a maa kpǝ cɛŋwǝ sa a yɩrɩ. Ŋ́ née nyiŋ wǝla alɛɛrɩyǝ ŋ́ po ku. Kǝ ŋ́ re nɛŋpǝŋrǝ ŋ́ kpii kpǝ. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Ayɩrɛ acɛŋ wǝ láa nyɩŋ. Wǝ́ mǝŋ wǝ laa nyɩŋ we, kǝ o kuŋ pǝ co kpǝ.»<verse eid="LUK 13:9" /></para>
  <para style="s">Yesu la cá tieyǝ rɛ mǝ sabatǝyǝ le jirǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Jirɛɛrǝ we, Yesu yà ka ŋ kaŋ otuyǝ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ. Sabatǝyǝ le jirǝ gǝ lǝǝwe. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Tieyǝ rɛ ŋ naa ka kpaa cɛŋwǝ tǝ mǝ nɛŋtǝwǝ wǝǝ, ŋwǝ ŋkpɛ ke tini rǝ we. Wɛɛrɔɔrɔɔrǝ le yee mǝ ŋwǝ, wǝ́ ŋ ne si kokoro. Lǝŋ tǝ ŋ koru eyiili. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Kǝ́ Yesu ŋ na nyɩŋ tieyǝ sa we, wǝ́ ŋ pwò ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ lee, o lo ru rǝ lá nyarǝpirǝ sa la akaakǝ.» <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Wǝ́ Yesu ŋ fǝ̀ akaakǝ ŋ tɛ̀ɛ rǝ ŋwǝ. Rǝ kǝyaakǝ we, wǝ́ tieyǝ sa ŋ yìili. Wǝ́ ŋ yà ŋ kǝ ŋ kǝ Worokoyǝ. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />Paape wǝ́ gumwɛŋnyuŋkpǝ sa lo mumuŋyǝ ŋ fǝ̀ kpɛɛmʊrʊwǝ mǝ kǝ́ Yesu ŋ na cá nyiyǝ mǝ sabatǝyǝ le jirǝ wǝ. Wǝ́ mumuŋyǝ sa ŋ ke ŋ tíi kǝkpǝŋkǝ we ǝkǝnǝŋ: «Juukʊʊraŋ rǝ kuluwǝ lǝ mǝrǝ wǝ́ nyiyǝ ŋ nóo koru eyee kǝnǝnɛkǝ. Kǝto nǝ mǝ pǝ kǝ pǝ ŋ cá nǝ rǝ ŋyǝ eciyǝ sa. Ŋkǝ sabatǝyǝ le jirǝ wǝ́ pǝ láa cá nyiyǝ.» <verse eid="LUK 13:14" /><verse number="15" style="v" sid="LUK 13:15" />Wǝ́ Kulǝtǝyǝ Yesu ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Alakpatǝpǝ wǝ́ nǝ ri. Mǝŋkǝ nyi ri ŋ nyi rǝ nǝ mǝrǝ lóo wuru na nɛŋyǝ amaa no rookɛtɛyǝ rǝ na fɛɛwowǝ, ŋ ko mǝ ŋwǝ ŋ ko ŋuŋ mɛŋwǝ mǝ sabatǝyǝ le jirǝ? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Nǝ yɩrɩ tieyǝ sa ree, Abǝrahamǝ le pilepiyǝ ŋ lǝǝwe. Wǝ́ Satana ŋ na parǝ ŋwǝ ŋ nǝ tǝnǝ cɛŋwǝ tǝ mǝ nɛŋ milimili. Wǝ laa laka kǝ ŋ́ wuru ŋwǝ mǝ sabatǝyǝ le jirǝ?» <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Yesu le etieyǝ sa yǝ kpìi nǝ ǝkǝǝkpǝlǝtǝpǝ kpǝlo la nʊŋsɔɔwǝ. Paa wǝ́ kǝkpǝŋkǝ we kpǝlo kǝ nyà faawǝ rǝ Yesu lo otukpatɩyǝ we kpǝlo ŋ yà ŋ ke ŋ yee kǝto.<verse eid="LUK 13:17" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ durʊʊpiŋɩnɩŋɩnɩrǝ rɛ</para>
  <para style="r">(<ref loc="MAT 13:31-32">Matewu 13:31-32</ref>, <ref loc="MRK 4:30-32">Marǝko 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ lo tu wǝ́ Worokoyǝ le wǝpilirikpǝ wǝ lo ru? Kǝ́ lo tu wǝ́ ŋ́ nóo koru ǝfǝ ŋ́ ca mǝ kpǝ? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Wǝ lo ru durʊʊŋɩnɩŋɩnɩpirǝ rɛ nyiyǝ rɛ ŋ na ka rʊ rǝ na atɛɛkǝ. Kǝ́ le wi we, wǝ́ le yee wǝciikpǝ. Wǝ́ ofuripǝ pǝ lo co okuyǝ rǝ wǝla alaŋyǝ.»<verse eid="LUK 13:19" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ dafaŋrǝ</para>
  <para style="r">(<ref loc="MAT 13:33">Matewu 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Wǝ́ Yesu ŋ tǝ ŋ cà duturǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ lo tu wǝ́ ŋ́ nǝ́ǝ fǝ ŋ́ cá mǝ Worokoyǝ le wǝpilirikpǝ wǝ? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Worokoyǝ le wǝpilirikpǝ wǝ lǝ rǝ mǝŋ dafaŋrǝ tieyǝ rɛ ŋ na tʊʊ ŋ nǝ fǝ ŋ no furu fuŋtumumuŋwǝ rɛ. Wǝ́ fuŋtuwǝ we kpǝlo kɩɩkɩ wǝ lo fuunu.»<verse eid="LUK 13:21" /></para>
  <para style="s">Worokoyǝ le wǝpilirikpǝ</para>
  <para style="r">(<ref loc="MAT 7:13-14">Matewu 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Yesu rù ko ŋ ko Yerusalɛmǝ, wǝ́ ŋ kanǝ otuyǝ ŋ ko ŋ ko rǝ ǝtǝŋtǝǝyǝ we mǝ ǝtǝŋtǝǝpiyǝ we ŋ na nya ŋ ne fii rǝ ko. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Wǝ́ rɛ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, kǝceece enyipipǝ rɛ ko wǝ́ Worokoyǝ ŋ nah pa pɔrʊ?» Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />«Nǝ nyɩɩ kǝ nǝ fǝ rǝ guŋpolumʊlɩŋtɩŋrǝ we nǝ fii Worokoyǝ le wǝpilirikpǝ we lǝ mǝrǝ. Duturǝ ɖi ŋ́ ya ŋ́ née tíi nǝ wǝ kǝceece, enyipǝ wa pǝ lah pa taa kʊŋwǝ pǝ fii paape pǝ lǝŋ po koru.<verse eid="LUK 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 13:25" />Eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ, nyarǝlǝtǝyǝ leh pe yi, kǝ ŋ taŋ ŋwaarǝ ŋ co nǝ. Eniyǝ we nǝ yaa rǝ koruwǝ. O lóo turu nǝ nyée yi nǝ ya nǝ nyáa ca ŋwaarǝ kǝ nǝ mǝ tɛŋ ǝkǝnǝŋ: “Kulǝtǝyǝ taanǝ lǝ!” Eniyǝ we leh tíi nǝ ǝkǝnǝŋ: “Ŋ́ nee ci nǝ.” <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />O lóo turu nǝ nyeh tíi ŋwǝ ǝkǝnǝŋ: “Yǝ le tii yǝ le ri wǝ́ yǝ lo ŋuŋ fɛɛceŋceŋ mǝ lǝ́. Wǝ́ a la kaŋ enyipǝ lo otuyǝ rǝ lǝh tǝŋtǝǝwǝ la acanɩtiyǝ.” <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Paape lǝ́ǝ tǝ ŋ kpǝlǝŋ ŋ tíi nǝ ǝkǝnǝŋ: “Ŋ́ nee ci nǝ. Nǝ lǝǝ rǝ mǝ enimiyǝ. Nǝ kpǝlo nǝ nyaa kʊʊ.”» <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Vǝ́ nǝ nyáa pa ka nyɩŋ Abǝrahamǝ, Isakǝ, Yakɔbǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ kpǝlo kɩɩkɩ nǝ nya maŋ pǝ kpii rǝ Yulaarǝ we, wǝ́ ŋnǝ paa pǝ la pɔrʊ nǝ pǝ lo co rǝ koruwǝ we, wǝ lée fii nǝ. Fɛɛwǝ nǝ nyeh pe wee kǝ nǝ wo oroŋciiyǝ wǝǝ. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Enyipǝ pǝ lóo ru rǝ kǝcɔkɔŋpoŋkǝ, kǝcɔkɔŋtɔɔkǝ, kǝŋuŋsiɛɛkǝ mǝ kǝpɔɔlʊsiɛɛkǝ pǝ pǝ, kǝ pǝ pe tii pǝ ri fɛɛceŋceŋ rǝ Worokoyǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Kǝto enyitǝtǝǝlǝpǝ pǝ kpii pǝ lǝ́ǝ pǝ pǝ pe ri ǝsǝsǝŋpǝ, Wǝ́ enyisǝsǝŋpǝ pǝ kpii pǝ lǝ́ǝ pǝ pǝ pe ri ǝtǝtǝǝlǝpǝ.<verse eid="LUK 13:30" /></para>
  <para style="s">Yesu la tɛŋ Yerusalɛmǝ la awɔɔkǝ</para>
  <para style="r">(<ref loc="MAT 23:37-39">Matewu 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Eniyǝ we Yesu ŋ tǝ ŋ ya ŋ náa wɛɛlɩ we, wǝ́ Afarisitǝpǝ rɛ pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pwɛyɩ rǝ fɛɛwǝ sa. Mǝ ko fɛɛpʊŋpwa. Duturǝ ɖi Erodɛsɩ ya lǝ́ǝ pǝ́ ŋ kpii pǝ pa wʊ lǝ́.» <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Yɩrɩ re! Nǝ ke tíi dasɩrǝ<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Rǝ Oyudatǝpǝ lǝ kpǝŋ we, pɔkpaacɩkɛɛyǝ ŋ ri kɛɛyǝ lǝ yǝ ŋ pieli wǝ.</char></note> sa ǝkǝnǝŋ we, ŋmǝ ŋ́ nǝ́ǝ fǝ ruŋruŋ mǝ sooso ŋ́ piri awɛɛrɔɔrɔɔyǝ kǝ ŋ́ cá anyaatǝpǝ. Soosokǝma wǝ́ ŋ́ náa lɛ mǝ kǝnǝnɛkǝ. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Paa wǝ kpii kǝ mǝ ŋ ko mǝ mǝ kʊŋwǝ sa ruŋruŋ, sooso mǝ soosokǝma. Duturǝ ɖi worokokpɛɛnuŋtɛŋtǝyǝ rɛ lǝŋ kpǝ́ rǝ fɛɛpʊŋpwawǝ rɛ pwi ŋ teeri Yerusalɛmǝ.»<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />«Ŋnǝ Eyerusalɛmǝtǝpǝ, ŋnǝ epǝ we nǝ nyáa wʊʊlʊ oworokokpɛɛnuŋtɛŋtǝpǝ, wǝ́ nǝ nyée tieni Worokoyǝ le enyipǝ we ŋ ne kpii ŋ na maŋ nǝ lo oruyǝ nǝ nyǝ ŋ wʊʊlʊ wǝ. Ŋ́ nǝ pǝ́ eni ri ŋ ni ŋ́ kparǝ nǝ ŋ́ maarǝ mǝ mǝ wɛ mǝŋ kǝ́ kʊkɔyǝ ŋ náa kparǝ ne epipǝ mǝ ŋ kpii rǝ na wǝkʊŋkpǝ kǝtǝ. Paape nǝ nyaa tɛɛnɩ wǝ! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Kǝto Worokoyǝ láa maa nǝ nyarǝwǝ ŋ tǝnǝ nǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ ko ro jirǝ we nǝ nyáa tɛŋ ǝkǝnǝŋ: Worokoyǝ ŋ pɛɛrɩ yǝ we ŋ no furu rǝ Ǝtǝ Woroko la nyɩŋrǝ wǝ.»<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesu la cá nyaatǝyǝ rɛ mǝ sabatǝyǝ le jirǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Jirɛɛrǝ Yesu kolu ŋ ke ri rǝ Afarisitǝpǝ lo mumuŋyǝ rɛ lǝ kpǝŋ mǝ sabatǝyǝ le jirǝ. Wǝ́ enyipǝ we pǝ ka yaa pǝ cò nimirǝ pǝ ka ŋ yɩrɩ ŋwǝ rɛyɩɩ. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Rǝ fɛɛwǝ we ko wǝ́ ŋ nyɩnɩ kǝ́ nyiyǝ rɛ ŋ na waalǝ akparɩyǝ ŋ yaa wǝ. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Wǝ́ Yesu ŋ kǝ ŋ pǝ́ oworokosekaŋtǝpǝ mǝ Afarisitǝpǝ ǝkǝnǝŋ: «Leh seyǝ lo kuŋ gʊŋrǝ ǝkǝnǝŋ pǝ cá nyiyǝ mǝ sabatǝyǝ le jirǝ?» <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Wǝ́ pǝ rǝnǝ yiriri. Wǝ́ Yesu ŋ rù nyiyǝ we, wǝ́ ŋ cá ŋwǝ. Wǝ́ ŋ tìi ŋwǝ mǝ ŋ ko. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Mǝŋ rɛ rǝ nǝ mǝrǝ le piyǝ amaa la nɛŋyǝ la tɔɔ mɛŋfuŋwǝ wǝǝ, nyiyǝ sa lǝŋ ko ŋ ka pɔrʊ ŋwǝ kǝtǝrǝceŋceŋ wǝ ke ce wǝ ri sabatǝyǝ le jirǝ?» <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Oworokosekaŋtǝpǝ we mǝ Afarisitǝpǝ we pǝ loo koru tǝrɛ la atɛŋ.<verse eid="LUK 14:6" /></para>
  <para style="s">Vǝ́ pǝ lo pwo lǝ́ rǝ wǝcɛkpǝ we, ke tii rǝ fɛɛtitǝtǝǝlǝwǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yesu cò nimirǝ ka ŋ yɩrɩ enyipǝ we pǝ pǝlǝ wǝcɛkpǝ we. Wǝ́ ŋ nyɩnɩ pǝ ya pǝ lóo ko pǝ ŋ tiili rǝ kǝnyɩŋkǝ. Wǝ́ ŋ cìi ŋ kanǝ enyipǝ we ǝkǝnǝŋ: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />«Vǝ́ pǝ lo pwo lǝ́ rǝ dielɔrǝ la wǝcɛkpǝ we, pee ke tii rǝ kǝnyɩŋkǝ. Ayɩrɛ pǝ lo pwo nyiyǝ rɛ ŋwǝ ŋkpɛ. Wǝ́ nyiyǝ we ŋ no ru okuruyǝ ŋ ne teeri lǝ́, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />kǝ nyiyǝ we ŋ no pwo nǝ eyi we, ŋ pee pe tíi lǝ́ ǝkǝnǝŋ: “Yi a cɛ nyiyǝ sa kǝ ŋ tii.” Eniyǝ we e le yi mǝ nʊŋsɔɔ mǝ nʊŋsɔɔ e ke tii rǝ kǝmaakǝ. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Kǝto mǝŋ pǝ lo pwo lǝ́ rǝ wǝcɛkpǝ rɛ we, ke tii rǝ kǝmaakǝ. Vǝ́ nyiyǝ we ŋ no pwo lǝ́ la pa nyɩŋ lǝ́ we, eniyǝ we le tíi lǝ́ ǝkǝnǝŋ: “Mǝ kɛrɩyǝ pǝ e pe tii rǝ kǝnyɩŋkǝ”. Eniyǝ we wǝ la rɛɛrɩ mǝ lǝ́ rǝ oŋuŋkǝ, rǝ enyipǝ we kpǝlo nǝ mǝ pǝ nǝ tini nǝ nyée ri le enimiyǝ. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Kpiikǝ yǝ we ŋ na rɛɛrɩ mǝ na wɛ rǝ oŋuŋkǝ we, Worokoyǝ láa sʊʊrʊ mǝ ŋwǝ. Wǝ́ yǝ we ŋ na pɛɛlɩ na wɛ we, Worokoyǝ láa rɛɛrɩ mǝ ŋwǝ rǝ oŋuŋkǝ.»<verse eid="LUK 14:11" /></para>
  <para style="s">Vǝ́ e leh ri wǝcɛkpǝ we, pwo ariariatǝpǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Wǝ́ Yesu ŋ sìɛrɩ ŋ tìi yǝ we ŋ pwò ŋwǝ rǝ wǝcɛkpǝ we ǝkǝnǝŋ: «Mǝŋ ǝ lǝ pǝ́ o pwo enyipǝ pǝ pe ri rǝ lǝ́ kpǝŋ mǝ jɔkɔŋrǝ amaa mǝ ɖiɔrǝ we, poo pwo lǝ́ ǝtǝŋpǝ, poo pwo lá apaanʊpǝ, poo pwo lá anyarǝlɛɛrɩtǝpǝ we pǝ lǝǝmǝ pǝla wɛ wǝ. Mǝŋ ŋkǝ kaa wǝǝ we, ŋpǝ ŋkpɛ pǝ loh po pwo lǝ́, kǝ pǝ ca lǝ wǝ la kpawǝ. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Kǝto mǝŋ e leh ri wǝcɛkpǝ, wǝ́ a la caa keeriwǝ we, pwo ariariatǝpǝ, epǝ we pǝ lǝŋ koru asaŋ, ǝsǝ́ŋpǝ mǝ alaanyɩŋtǝpǝ bomu. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Mǝŋ e le yee wǝ ǝnǝ we, lǝ́ yǝ o lo co yǝ. Duturǝ ɖi enyipǝ sa kǝtǝŋkǝ pǝ lǝŋ koru aca lǝ́ tuwǝ sa e le yee o lo koonu pǝ la kpawǝ. Paape Worokoyǝ lah pa mwara lǝ́ wǝ mǝ eniyǝ we ŋ nah pa saanǝ enyikʊʊpǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.»<verse eid="LUK 14:14" /></para>
  <para style="s">Nyiyǝ rɛ la caa keerimumuŋwǝ rɛ lah lɔ ǝsǝǝpǝ</para>
  <para style="r">(<ref loc="MAT 22:1-10">Matewu 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Kǝ́ nyiyǝ rɛ rǝ epǝ we pǝ tini pǝ ke ŋ ri lǝ mǝrǝ ŋ no nuŋ Yesu le etieyǝ sa ŋ na lɛ we, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ we ŋ neh pe ri mǝ Worokoyǝ rǝ ne wǝpilirikpǝ lǝ mǝrǝ we, ŋwǝ yǝ lo co yǝ». <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />Wǝ́ Yesu ŋ cà duturǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nyiyǝ rɛ yà ka ŋ caa keerimumuŋwǝ rɛ, wǝ́ ŋ pwòlu enyipǝ ŋpa kǝ pǝ pǝ pǝ pe ri wǝ. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Kǝ́ eniyǝ yǝ lo ro kǝ pǝ ri we, wǝ́ ŋ kpìi na sʊmatǝyǝ ŋ ke tíi pǝ ǝkǝnǝŋ: “Nǝ mǝ pǝ, ŋ́ na lɛ.” <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Kǝ́ ŋ ne siri enyipǝ we ŋ no po ku we, yǝ mǝ yǝ o nuŋ ŋ na kpara. Wǝ́ nyisǝsǝŋyǝ we ŋ tìi sʊmatǝyǝ we ǝkǝnǝŋ: “Ŋ́ no fuu kǝtǝǝwǝ rɛ, wǝ kaamǝ kǝ ŋ́ ka yɩrɩ wǝ. Kǝto tíi ŋwǝ na dɔɔkpɛ ŋmǝ ŋ́ nǝŋ koru ǝpǝ.” <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Wǝ́ nyipʊŋpwayǝ ŋ tɛnɩ ǝkǝnǝŋ: “Ŋ́ no fuu anɛŋpǝ tǝ. Wǝ́ ŋ́ noh ko ŋ́ ka yɩrɩ mǝŋ pǝ lóo koru anǝnɛyǝ le eyee. Kǝto ke tíi ŋwǝ na dɔɔkpɛ mǝ nǝŋ koru ǝpǝ.” <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Wǝ́ nyipʊŋpwayǝ ŋ tɛnɩ ǝkǝnǝŋ: “Ŋ́ ne ci alɔ tieyǝ rǝ kǝto ŋ́ nǝŋ koru ǝpǝ.” <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Kǝ́ sʊmatǝyǝ we ŋ na siɛnɩ ŋ ne ke fii we, wǝ́ ŋ fǝ̀ etieyǝ sa ŋ pɔ no kulǝtǝyǝ. Wǝ́ kulǝtǝyǝ we ŋ fǝ̀ kpɛɛmʊrʊwǝ. Wǝ́ ŋ tìi sʊmatǝyǝ we ǝkǝnǝŋ: “Kalaŋ! Mǝ ko tǝŋtǝǝwǝ la atɔŋlɛɛrɩyǝ mǝ acanɩtiyǝ o ko pwolu ariariatǝpǝ, epǝ we pǝ lǝŋ koru asaŋ wǝ, alaanyɩŋtǝpǝ mǝ ǝsǝ́ŋpǝ pǝ pǝ.” <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Wǝ́ sʊmatǝyǝ we ŋ kolu. Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ ŋ tìi kulǝtǝyǝ we ǝkǝnǝŋ: “Kulǝtǝyǝ, ŋ́ ne yee kǝnǝnɛkǝ we e le kpii mǝ wǝ. Paape afɛɛtiiyǝ yǝ lǝ tǝ yǝ lo turu.” <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Wǝ́ kulǝtǝyǝ we ŋ tǝ ŋ tìi sʊmatǝyǝ we ǝkǝnǝŋ: “Mǝ ko o ko pwolu enyipǝ rǝ akʊŋlɛɛrɩyǝ mǝ wǝtɛɛkpǝ kǝ a nyɩɩ mǝ pǝ kǝ pǝ pǝ, kǝ mǝ nyarǝwǝ wǝ nya fɛɛ wǝ lǝ mǝ enyipǝ. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, enyipǝ we ŋ́ nǝ sǝŋ pwolu la rɛ ŋ ri rɛ lǝŋ ta mǝ keeriwǝ sa kʊlɩ.”»<verse eid="LUK 14:24" /></para>
  <para style="s">Taa Yesu lǝ kǝǝwǝ e teeri tu ri ŋ tu kpɛŋ kǝ e ci e siimǝ ŋwǝ</para>
  <para style="r">(<ref loc="MAT 10:37-38">Matewu 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Wǝla kǝmaakǝ we, wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ sìimǝ Yesu wǝ ko ŋ ko. Wǝ́ ŋ sìɛrɩ ŋ tìi pǝlo kpǝlo ǝkǝnǝŋ: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />«Mǝŋ rɛ lǝ́ǝ pǝ́ ŋ siimǝ mǝ we, wǝ kaamǝ kǝ yǝ we ŋ taa mǝ kǝǝwǝ ŋ teeri nǝ tǝ, ne lee, ne tie, ne epipǝ, na apaanʊpǝ, na apaatɛpǝ mǝ ŋwǝŋwǝ na wɛ kʊraa. Mǝŋ ŋkǝ kaa wǝǝ we, yǝ we lǝŋ koru eri mǝ tukarǝtǝyǝ. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Yǝ we ŋ nǝǝ rǝǝrǝ na kpɛtɛkpǝlɛciiwǝ ŋ re kǝ ŋ siimǝ mǝ we, lǝŋ koru eri mǝ tukarǝtǝyǝ. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />Mǝŋ rɛ rǝ nǝ mǝrǝ lǝh pǝ́ ŋ tɔ nyarǝmumuŋwǝ rɛ wǝǝ, mǝŋkǝ yǝ we láa taarǝ mǝ ŋ tii, ŋ yee akʊŋtayǝ ŋ yɩrɩ, nyarǝwǝ we ŋ nah tɔ wǝ láa lɔ ŋwǝ nɛ, kǝ ŋ nyɩŋ mǝŋ sɩkayǝ we ŋ kpɛlɩ ŋwǝ lóo roo pǝ tie kpǝ kǝ pǝ pa lɛ kpǝ rǝ? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Mǝŋ ŋkǝ kaa wǝǝ, vǝ́ le tie gumumuŋkpǝ sa la atɔkǝ, wǝ́ ŋ naa pa lɛ we, vǝ́ enyipǝ kpǝlo pǝ la pa nyɩŋ wǝ we, pǝ láa mǝ mɔɔnʊ ŋwǝ kǝ pǝ ŋ tɛŋ ǝkǝnǝŋ: <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />“Nyiyǝ sa le tie gukpǝ sa la atɔkǝ, paape loo koru kpǝ la alɛ.” <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />Amaa mǝŋ piliyǝ rɛ loh ko ŋ ka kɔŋ pilipʊŋpwayǝ rɛ wǝǝ, mǝŋkǝ lée tii mǝ ŋ yaa yurǝ mǝ ŋ yɩrɩ kpɛŋ, mǝŋ lóo koru ǝfǝ otuusiitǝpǝ lafawǝ tǝ ŋ ke yee akɔŋkǝ mǝ nǝ kǝǝkpǝlǝtǝyǝ lo otuusiitǝpǝ lafawǝ tiyi? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Mǝŋ lǝŋ koru we, eniyǝ we le kpii enyipǝ la maŋ piliyǝ lǝ yǝ eni, mǝ eniyǝ ŋ fǝǝ pǝ kǝlǝ wǝ, kǝ pǝ kǝ pǝ́ otuyǝ we ŋ náa lɔ kǝ wǝtaarǝkpǝ wǝ nya fɛɛ wǝ pǝ pǝlǝ mǝrǝ. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Kǝto mǝŋ rɛ rǝ nǝ mǝrǝ loo yuu no otulǝmǝyǝ kpǝlo ŋ co we, yǝ we lǝŋ koru eri mǝ tukarǝtǝyǝ.»<verse eid="LUK 14:33" /></para>
  <para style="s">Mǝŋ atǝraŋpǝ pǝ lǝ lǝǝrǝ pǝla wǝraŋkpǝ we oturu pǝ lǝǝ tǝ pǝ lǝmǝ wǝceeceekpǝ</para>
  <para style="r">(<ref loc="MAT 5:13">Matewu 5:13</ref>, <ref loc="MRK 9:50">Marǝko 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Tuceeceewǝ rɛ wǝ́ atǝraŋpǝ pǝ ri. Paape mǝŋ pǝ lǝ lǝǝrǝ pǝla wǝraŋkpǝ wǝǝ, kǝ́ wǝ́ pǝ lǝ́ǝ tǝ pǝ fǝ pǝ raanǝ pǝ wǝ? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Pǝ lǝŋ koru ǝfǝ atǝraŋpǝ sa pǝ tɔɔ kǝtǝǝwǝ la wǝpɔŋkpǝ<note caller="+" style="f"><char style="fr" closed="false">14:35 </char><char style="ft" closed="false">Rǝ gakarǝ we, Isǝrayɛlǝtǝpǝ pǝ kǝ ŋ fǝ atǝraŋpǝ pǝ ŋ kpii kǝtǝǝwǝ kǝ wǝ nya fɛɛ wǝ poŋ otuyǝ. Wǝ́ pǝ ka ŋ lɛ pǝ ŋ fǝ pǝ pǝ ŋ kpii nɛŋpǝŋrǝ pǝ ŋ kpaalǝ, kǝ pǝ fǝ pǝ ŋ kpii naawǝ.</char></note>, wǝ́ pǝ lǝŋ lɛ pǝ koru ǝfǝ pǝ pǝ kpaalǝ nɛŋpǝŋrǝ. We pǝ lǝ́ǝ fǝ pǝ pǝ co rǝ. Yǝ we ŋ lǝǝmǝ otukoŋyǝ ŋ nóo nuŋ tuwǝ we, ŋ nuŋ dierǝ sa sɩsiɛrɩ.»<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ mɛɛyǝ rɛ ŋ nǝ lǝǝ wǝ́ pǝ la nyɩŋ ŋwǝ wǝ</para>
  <para style="r">(<ref loc="MAT 18:12-14">Matewu 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Alaŋpoolɔtǝpǝ mǝ oturɔɔrɔɔyeetǝpǝ pǝlo kpǝlo kɩɩkɩ pǝ ke ŋ pi pǝ ŋ pǝ pǝ ŋ tii rǝ Yesu lǝ kpǝŋ pǝ ŋ co kǝtukoŋkǝ rǝ ne etieyǝ. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Wǝ́ Afarisitǝpǝ mǝ oworokosekaŋtǝpǝ pǝ fǝ pǝ kaŋ wɛɛlɩ pǝ ŋ ru rǝ Yesu ǝkǝnǝŋ: «Keyi, nǝ yɩrɩ nyiyǝ lǝ yǝ re! Láa lɔ oturɔɔrɔɔyeetǝpǝ rǝ nǝ kpǝŋ, wǝ́ ŋ née ri mǝ pǝ.» <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />Wǝ́ Yesu ŋ cà pǝ lo duturǝ sa ǝkǝnǝŋ: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />«Mǝŋ rɛ rǝ nǝ mǝrǝ lǝǝmǝ amɛɛpǝ tuuru, wǝ́ ŋ nǝ lǝǝrǝ ceŋceŋ rǝ pǝlǝ mǝrǝ wǝǝ, lǝŋ maa amɛɛtuturupǝ we tǝfaŋceŋceŋ mǝ afaŋceŋceŋ ŋ tǝnǝ rǝ bɔɔrǝ we, kǝ ŋ taa ceŋceŋyǝ we ŋ nǝ lǝǝ mǝ ŋ tɛlɩ kǝ ŋ ka nyɩŋ ŋwǝ rǝ? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Vǝ́ la ka nyɩŋ ŋwǝ we, láa nya faawǝ. Lǝ́ǝ fǝ ŋwǝ ŋ tɛɛ rǝ akpakpaturuyǝ. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Kǝ ŋ fǝ ŋwǝ mǝ ŋ pǝ nyarǝwǝ. Vǝ́ le pe fii we, lóo pwolu nǝ ǝtǝŋpǝ mǝ na anyarǝlɛɛrɩtǝpǝ, kǝ ŋ tíi pǝ ǝkǝnǝŋ: “Lǝh ǝtǝŋ! Nǝ nya faawǝ nǝ toŋ mǝ. Duturǝ ɖi ŋ́ na nyɩŋ mǝ mɛɛyǝ we ŋ nǝ lǝǝ wǝ.” <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Ŋ́ ya née tíi nǝ wǝ, kǝ́ wǝ lǝ wǝǝ. Vǝ́ mǝŋ turɔɔrɔɔyeetǝyǝ rɛ ceŋceŋ la siɛrɩ vɔrʊrǝ we, Worokoyǝ mǝ ne epicoŋpipǝ pǝ láa nya faawǝ ŋpa rǝ yulaarǝ. Faawǝ sa wǝ teeri faawǝ we pǝ láa nya rǝ enyikʊʊpǝ tǝfaŋceŋceŋ mǝ afaŋceŋceŋ pǝ lǝǝ tǝ pǝ pǝ́ vɔrʊsiɛrɩrǝ wǝ.»<verse eid="LUK 15:7" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ sɩkayǝ rɛ ŋ nǝ lǝǝ wǝ́ pǝ la nyɩŋ ŋwǝ wǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Wǝ́ Yesu ŋ tǝ ŋ cà duturǝ ǝkǝnǝŋ: «Mǝŋ tieyǝ rɛ lǝǝmǝ sɩkakpotokpotoyǝ tǝ. Wǝ́ ŋ nǝ lǝǝrǝ ceŋceŋ rǝ gukpǝ mǝrǝ wǝǝ, kǝto lǝŋ too kaŋrewǝ kǝ ŋ nya fɛɛ nyɩŋ ŋ cɛɛlɩ gukpǝ we, kǝ ŋ co nimirǝ ŋ taa sɩkayǝ sa rɛyɩɩ ko ro eniyǝ we ŋ na nyɩŋ ŋwǝ rǝ? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Vǝ́ la nyɩŋ ŋwǝ we, lóo pwolu nǝ ǝtǝŋpǝ mǝ na anyarǝlɛɛrɩtǝpǝ, kǝ ŋ tíi pǝ ǝkǝnǝŋ: “Lǝh ǝtǝŋ! Nǝ nya faawǝ nǝ toŋ mǝ. Duturǝ ɖi ŋ́ na nyɩŋ mǝ sɩkayǝ we ŋ nǝ lǝǝ wǝ.” <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Ŋ́ ya ŋ́ née tíi nǝ, kǝ́ wǝ lǝ wǝǝ. Vǝ́ mǝŋ turɔɔrɔɔyeetǝyǝ rɛ ceŋceŋ la siɛrɩ vɔrʊrǝ we, Worokoyǝ le epicoŋpipǝ we pǝ kpii rǝ Yulaarǝ pǝ láa nya faawǝ ŋpa.»<verse eid="LUK 15:10" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ piyǝ rɛ ŋ nǝ lǝǝ wǝ́ pǝ la nyiŋ ŋwǝ wǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Wǝ́ Yesu ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kɛrɩyǝ rɛ kǝ lǝǝmǝ ǝpǝrǝŋpipǝ eyi. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Wǝ́ pipiyǝ we ŋ pǝlǝ ŋ tìi nǝ tǝ ǝkǝnǝŋ: “Mǝ tǝ, fǝ ǝtǝtuyǝ we yǝ ri mǝ anɛŋyǝ o koonu mǝ”. Wǝ́ kǝceece nǝ tǝ ŋ sǝ̀pǝ no otulǝmǝyǝ ŋ kòonu ne epipǝ we pǝle eyi. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Wǝ laa lɔ ecipiyǝ rɛ, wǝ́ pipiyǝ sa ŋ sìiri nǝ ǝtǝtuyǝ we. Wǝ́ ŋ fǝ̀ sɩkayǝ we ŋ pwɛ̀yɩ ŋ ko ŋ ko gǝŋrǝ rɛ ciriciri. Kǝ́ ŋ ne ke fii we, wǝ́ ŋ fǝ̀ sɩkayǝ we ŋ rili vɔrʊrǝ ŋ pǝ̀lǝ. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Kǝ́ ŋ ne ri sɩkayǝ we kpǝlo ŋ na lɛ we, wǝ́ kǝtɛŋmumuŋkǝ rɛ kǝ fii gǝŋrǝ we. Wǝ́ ŋ tie arianyɩŋyǝ. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Wǝ́ ŋ kolu ŋ lɔ̀ kǝnǝnɛkǝ rǝ nyiyǝ rɛ lǝ kpǝŋ rǝ gǝŋrǝ we. Wǝ́ nyiyǝ sa ŋ fǝ̀ ŋwǝ ŋ kolu ŋ tǝ̀nǝ rǝ ne epwiiyǝ mǝ ŋ rǝŋ na afáŋpǝ. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Wǝ́ kǝtɛŋkǝ kǝ pǝlǝ kǝ tèeri ŋwǝ. Wǝ́ ŋ ka ŋ yɩrɩ ŋ ka rɔsɩ ŋ nya afáŋpǝ sa le keeriwǝ ŋ ta kuluwǝ rǝ. Paape ǝlǝ ŋ nóo koonu nǝ wǝ? <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Rǝ fɛɛwǝ we, wǝ́ ŋ fìi rǝ yupurǝ ŋ ru rǝ wǝlǝkpǝ we kǝtǝŋkǝ mǝrǝ ŋ ke kpii wǝ. Wǝ́ ŋ ke ŋ tíi na wɛ ǝkǝnǝŋ: “Mǝ tǝ la apaalǝtǝpǝ pǝ lée ri pǝ ŋ fɔ. Wǝ́ ŋmǝ paa ŋ́ tini ŋ́ náa wʊ kǝtɛŋkǝ rǝ fɛɛwǝ sa. <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Ŋ́ náa siɛnɩ mǝ ŋ ko mǝ tǝ lǝ kpǝŋ kǝ ŋ́ ke tíi ŋwǝ ǝkǝnǝŋ: Mǝ tǝ, ŋ́ ne yee wǝ loo poŋ rǝ Worokoyǝ lǝ kpǝŋ. Wǝ́ ŋ́ na lɛ ŋ́ ne yee wǝ loo poŋ rǝ lǝ́ kpǝŋ. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Ŋ́ nǝǝ tǝ ŋ́ kaamǝ kǝ o pwo mǝ ǝkǝnǝŋ le piyǝ. Fǝ mǝ mǝŋ lá apaalǝtǝpǝ sa le ceŋceŋ wǝ́ ŋ́ ri.” <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Wǝ́ ŋ pwɛ̀yɩ ŋ kpǝ̀lǝŋ ŋ ko ŋ ko nǝ tǝ lǝ kpǝŋ. Kǝ́ nah ta ŋ pǝ kǝlǝ mǝ nyarǝwǝ we, wǝ́ nǝ tǝ ŋ nyɩnɩ ŋwǝ ŋ manǝ. Wǝ́ wǝ cò nǝ tǝ la tǝlarǝwǝ ŋpa. Wǝ́ ŋ sù ŋ kolu ŋ kù mǝ ŋwǝ. Wǝ́ ŋ pùru ŋwǝ ŋ rè atuu. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Wǝ́ ne piyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: “Mǝ tǝ, ŋ́ ne yee wǝ loo poŋ rǝ Worokoyǝ lǝ kpǝŋ. Wǝ́ ŋ́ ne yee wǝ loo poŋ rǝ lǝ́ kpǝŋ. Ŋ́ nǝǝ tǝ ŋ́ kaamǝ kǝ o pwo mǝ ǝkǝnǝŋ le piyǝ.” <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Paa kǝ́ pǝ le pe fii nyarǝwǝ pǝ la lɛ we, wǝ́ nǝ tǝ ŋ tìi na asʊmatǝpǝ ǝkǝnǝŋ: “Nǝ fǝǝlǝ! Nǝ kǝ fǝ kǝkpaceececeecekǝ nǝ pe kpii ŋwǝ, kǝ nǝ fǝ warǝpirǝ nǝ kpii ŋwǝ rǝ gaapirǝ. Kǝ nǝ kpii na afʊkpayǝ. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Nǝ ka lɔ nɛŋtǝŋrǝ we la tɔɔ wǝpɔŋkpǝ nǝ wʊ. Kǝ le ri wǝcɛkpǝ. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Duturǝ ɖi mǝ piyǝ sa nǝ ya nǝ nyáa nyɩŋ ŋ tini we, Wǝ yeli mǝ mǝŋ kpǝ̀ rǝ. Wǝ́ ŋ na siɛnɩ ŋ nǝ pǝ vɔrʊrǝ. Lǝ̀ǝ wǝ́ ŋ́ na nyɩŋ ŋwǝ.” Wǝ́ pǝ tìe wǝcɛkpǝ le erikǝ. <verse eid="LUK 15:24" /><verse number="25" style="v" sid="LUK 15:25" />Eniyǝ we mǝrǝ we, kɛrɩyǝ sa le pimumuŋyǝ we kpìi rǝ atɛɛkǝ. Kǝ́ ŋ no ko ru ŋ nǝh pǝ, ŋ nǝ pǝ ŋ nǝh kǝlǝ mǝ nyarǝwǝ we, wǝ́ ŋ nunu ǝpǝŋyǝ yǝ ya yǝ láa tɔɔ, pǝ ya pǝ lóo yo. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Wǝ́ ŋ pwò asʊmatǝpǝ we le ceŋceŋ. Wǝ́ ŋ pǝ̀ ŋwǝ tuwǝ wǝ ya wǝ lǝ́ǝ pǝ wǝ. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Wǝ́ sʊmatǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: “Lá paanʊ la siɛnɩ lǝ pǝ pǝ. Wǝ́ lǝ́ tǝ ŋ ne tíi pǝ la lɔ nɛŋtǝŋrǝ we la tɔɔ wǝpɔŋkpǝ pǝ la wʊ. Duturǝ ɖi la nyɩŋ ne piyǝ purupuru.” <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />Rǝ fɛɛwǝ we, wǝ́ pimumuŋyǝ sa ŋ fǝ̀ kpɛɛmʊrʊwǝ. Wǝ́ ŋ sǝnǝ ŋ nǝŋ tǝ ŋ fii nyarǝwǝ. Wǝ́ nǝ tǝ ŋ rù ŋ pǝlǝ ŋ ka ŋ tɔɔ mǝ ŋ kpɛɛ ŋwǝ kǝ mǝ ŋ fii nyarǝwǝ. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Wǝ́ ŋ yìili ŋ ke ŋ tíi nǝ tǝ ǝkǝnǝŋ: “Ŋlǝ́ŋlǝ́ yɩrɩ re! Wǝ loh ko cɛŋwǝ pakapaka wǝ́ ŋ́ ya náa sʊma lǝ́. E fee tíi mǝ ŋ́ yee tǝrɛ kǝ ŋ sǝ́ŋ ŋ́ nyɩŋ. Paape o foo koonu mǝ bereceepirǝ ǝkǝŋtǝ, ŋ́ fǝ ŋ́ ri wǝcɛkpǝ lǝ mǝ mǝ ǝtǝŋpǝ a nyɩŋ. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />A lǝŋ nyɩŋ, lé piyǝ sa, le ri lá sɩkayǝ kɩɩkɩ ŋpǝ mǝ ekpeŋkpenikɔrʊpǝ. Paa kǝ́ ŋ na siɛnɩ ŋ ne pe fii we, wǝ́ o lo kuŋ pǝ la wʊ nɛŋtǝŋrǝ la tɔɔ wǝpɔŋkpǝ o lo koonu ŋwǝ.” <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Wǝ́ nǝ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Mǝ pi, ŋlǝ mǝ lǝ́ le kpii eni ri ŋ ni. Wǝ́ mǝ otuyǝ kpǝlo kɩɩkɩ yǝ ri lá anɛŋ. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Paa wǝ kaa kǝ le ri wǝcɛkpǝ la nya faawǝ. Duturǝ ɖi lá paanʊyǝ sa ŋ tini we, wǝ yeli mǝ mǝŋ kpǝ̀ rǝ, wǝ́ ŋ na siɛnɩ ŋ nǝ pǝ vɔrʊrǝ. Lǝ̀ǝ, wǝ́ ŋ́ na nyɩŋ ŋwǝ.”»<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ nǝnɛyeetǝyǝ rɛ ŋ sieni nimirǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Jirɛɛrǝ Yesu tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Nyiyǝ rɛ kǝ lǝǝmǝ na wɛ. Wǝ́ ŋ lɔ̀ nyiyǝ ŋ ka yɩrɩ no otuyǝ lo yurǝ. Wǝ́ enyipǝ pǝ pǝlǝ pǝ tìi ŋwǝ ǝkǝnǝŋ nǝnɛyeetǝyǝ sa ya lǝ́ǝ pǝlǝ no otuyǝ.» <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Wǝ́ kulǝtǝyǝ sa ŋ pwò na nǝnɛyeetǝyǝ sa. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ le etie wǝ́ ŋ́ ya ŋ́ nóo nuŋ mǝ ŋ ru rǝ lo oŋuŋkǝ ǝnǝ? Yee la anǝnɛyǝ la akʊŋtayǝ o koonu mǝ. Duturǝ ɖi ǝ lǝŋ tǝ o koru mǝ otuyǝ lo yurǝ la ayɩrɩ.» <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Wǝ́ nǝnɛyeetǝyǝ sa ŋ ke ŋ tíi na wɛ ǝkǝnǝŋ: «Mǝ kulǝtǝyǝ leh piri mǝ rǝ kǝnǝnɛkǝ sa. Ŋ́ neh yee nɛ rǝ? Ŋ́ nǝǝ lǝmǝ okopiyǝ ŋ́ neh yee atɛɛtɛɛcʊmayǝ. Wǝ́ ŋ́ nǝŋ lɛ ŋ́ koru otuyǝ la mǝ ria. Wǝ lóo co mǝ nʊŋsɔɔwǝ. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Yaa, ŋ́ ci tuwǝ ŋ́ neh yee wǝ. Mǝŋkǝsa we, vǝ́ kulǝtǝyǝ la lɔ kǝnǝnɛkǝ rǝ mǝ we, kǝ enyipǝ pǝ nya fɛɛ pǝ lɔ mǝ rǝ pǝlǝ kpǝŋ.» <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Wǝ́ ŋ pwòlu enyipǝ we kpǝlo kɩɩkɩ pǝ re no kulǝtǝyǝ lo otooyǝ ŋ pǝlǝ jeŋceŋ jeŋceŋ. Wǝ́ ŋ pǝ̀ nyisǝsǝŋyǝ we ǝkǝnǝŋ: «E re mǝ kulǝtǝyǝ nɛ?» <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Apɔŋpǝ tikoyǝ tuuru». Wǝ́ nǝnɛyeetǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lɔ lá kǝfwɛɛkǝ. Sɔɔ e tii kalaŋ kǝ a ŋʊrʊ tikoyǝ tǝtʊʊ.» <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Wǝ́ ŋ tǝ ŋ pǝ̀ rɛɛyǝ ǝkǝnǝŋ: «Wǝ́ ŋlǝ́, e re ŋwǝ nɛ?» Wǝ́ nyiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ekeeripiyǝ kotokuwǝ tuuru». Wǝ́ nǝnɛyeetǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lɔ lá kǝfwɛɛkǝ kǝ a ŋʊrʊ ekeeripiyǝ kotokuwǝ tǝnɛŋ». <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Wǝ́ kulǝtǝyǝ sa ŋ kǝ̀ nǝnɛyeetǝyǝ sa ŋ nǝŋ ri anʊkɔrǝyǝ wǝ. Duturǝ ɖi le yee nimisietǝtuwǝ. Enyipǝ we pǝ kpii pǝ láa taa rǝ ǝrǝkǝ lo otuyǝ ko we, pǝ lée yee enimisietǝtuyǝ mǝ awɛ pǝ ŋ teeri epǝ we pǝ kpii rǝ Worokoyǝ la wǝnyɩɩnɩkpǝ wǝ.<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />Wǝ́ Yesu ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ́ ŋmǝ ŋkpɛ ŋ́ ya ŋ́ née tíi nǝ we, nǝ fǝ ǝrǝkǝ lo otulǝmǝyǝ sa yǝ lǝ́ǝ tǝǝnǝ enyipǝ we, nǝ mwɛŋ enyipǝ le wǝpwetaakpǝ. Mǝŋkǝsa, vǝ́ mǝŋ otuyǝ sa yǝ la pa lɛ we, Worokoyǝ láa pa lɔ nǝ ŋ tǝnǝ rǝ na fɛɛtiilaalɛwǝ we. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Mǝŋ nyiyǝ rɛ le ri anʊkɔrǝyǝ rǝ otupipiyǝ lǝ mǝrǝ we, kǝ́ ŋ née ri anʊkɔrǝyǝ rǝ omumuŋyǝ lǝ mǝrǝ wǝǝ. Wǝ́ mǝŋ rɛ le yee alakpayǝ rǝ otupipiyǝ lǝ mǝrǝ we, kǝ́ ŋ née yee alakpayǝ rǝ omumuŋyǝ lǝ mǝrǝ wǝǝ. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Mǝŋ e lee ri anʊkɔrǝyǝ rǝ ǝrǝkǝ lo otulǝmǝyǝ sa yǝ lǝ́ǝ tǝǝnǝ enyipǝ lǝ mǝrǝ we, Worokoyǝ lǝŋ pǝ fǝ otulǝmǝpoŋpipoŋpiyǝ ŋ koonu lǝ́ pwi. <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Wǝ́ mǝŋ e lee ri anʊkɔrǝyǝ rǝ otulǝmǝyǝ yǝ lee ri la anɛŋ lǝ mǝrǝ we, Worokoyǝ lǝŋ pǝ fǝ otulǝmǝyǝ we ŋ na kpaka ŋ nǝ tǝnǝ lǝ́ ŋ koonu lǝ́ pwi. <verse eid="LUK 16:12" /><verse number="13" style="v" sid="LUK 16:13" />Sʊmatǝyǝ rɛ lee kpii ŋ nóo koru asʊma okulǝtǝpǝ eyi kǝtǝrǝ ceŋceŋ. We lǝh mǝ kpǝlǝ ceŋceŋ lǝ kǝǝwǝ kǝ mǝ ŋ taa ceŋceŋ lǝ kǝǝwǝ, amaa láa kpaa ŋ maarǝ mǝ ceŋceŋ kǝ ŋ sǝ́ŋ ceŋceŋ. Nǝ nyǝŋ koru asʊma Worokoyǝ mǝ sɩkayǝ kǝtǝrǝceŋceŋ.»<verse eid="LUK 16:13" /></para>
  <para style="s">Yesu la kaŋ enyipǝ lo otuyǝ kǝkpǝŋkǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Afarisitǝpǝ pǝ nunu etieyǝ sa kpǝlo kɩɩkɩ. Wǝ́ pǝ yà pǝ ka ŋ mɔɔnʊ Yesu. Duturǝ ɖi pǝ láa taa sɩkayǝ lǝ kǝǝwǝ. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyǝ́ǝ pǝ́ enyipǝ pǝ ŋ nyɩŋ nǝ ǝkǝnǝŋ enyikʊʊpǝ wǝ́ nǝ ri. Worokoyǝ paa ci tuwǝ we kǝtǝŋkǝ nǝ ri wǝ. Tuwǝ we enyipǝ pǝ láa nyɩŋ ǝkǝnǝŋ tumumuŋwǝ rɛ kwa we, Worokoyǝ ŋwǝ paa lǝ kpǝlǝ wǝ lǝ kǝǝwǝ. <verse eid="LUK 16:15" /><verse number="16" style="v" sid="LUK 16:16" />Pǝ ka ŋ kaŋ Mose le seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ le etieyǝ po ru ǝrǝ Yowanɛsɩ yǝ we ŋ née wiiri worokomɛŋwǝ lǝ ǝpǝkǝ. Fǝ rǝ Yowanɛsɩ le eniyǝ mǝ pǝ we, Worokoyǝ le wǝpilirikpǝ le Dieceeceerǝ wǝ́ pǝ ya pǝ láa tɛŋ. Wǝ́ nyi ri ŋ nyi ŋ ya ŋ náa nyɩɩ kǝ ŋ nya fɛɛ ŋ fii yulaarǝ. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Wǝ laa lɛnyɩ kǝ yulaarǝ mǝ kǝtǝǝwǝ yǝ pa tɛlɩ. Paa wǝ láa lɛnyɩ ŋpaŋpa kǝ pǝ pa pɔrʊ Worokoyǝ le seyǝ la ŋʊrʊwǝ lo tupiwǝ rɛ pǝ cɛ. <verse eid="LUK 16:17" /><verse number="18" style="v" sid="LUK 16:18" />Vǝ́ mǝŋ nyiyǝ rɛ lǝ sǝ́ŋ ne tieyǝ, wǝ́ ŋ nǝ fǝ pʊŋpwayǝ rɛ ŋ na lɔ we, nyiyǝ we le yee kǝtienaakǝ. Wǝ́ mǝŋ nyiyǝ rɛ lǝ kǝ fǝ rɛ le tieyǝ ŋ nǝ sǝ́ŋ la lɔ we, yǝ we ŋwǝ ŋkpɛ le yee kǝtienaakǝ.»<verse eid="LUK 16:18" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ sɩkalǝtǝyǝ rɛ mǝ Lazaro</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />«Sɩkalǝtǝyǝ rɛ ke kpii. Ke ŋ kpii wǝkpaceeceekpǝ wǝ la lɔ okuruyǝ. Ji ri ji láa caa ekeerinyɔnyɔyǝ mǝ ŋ ri wǝcɛkpǝ. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Wǝ́ riariatǝyǝ rɛ ŋwǝ ŋkpɛ ŋ ke kpii. Pǝ lóo pwo ŋwǝ Lazaro. Wǝrɛŋkpǝ cɩkɩcɩkɩ rǝ na wɛlɛŋrǝ. Ka kpɛlɩ rǝ sɩkalǝtǝyǝ sa la nyarǝwǝ lo guŋpolurǝ. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Ekeerituyǝ we yǝ kaŋ tɔɔlʊ rǝ sɩkalǝtǝyǝ sa la kpǝlɔyǝ kǝnǝŋkǝ we, yǝ ka ŋ ca na kpɛɛ, ŋ ka rɔsɩ ŋ nya yǝ ŋ ta kuluwǝ rǝ. Paa acɩkɛɛpǝ pǝ kǝ ŋ pǝ pǝ ŋ rɛŋ na wǝrɛŋkpǝ we bomu. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />Wǝ́ riariatǝyǝ sa ŋ pǝlǝ ŋ kpǝ̀. Wǝ́ Worokoyǝ le epicoŋpipǝ pǝ pǝlǝ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ tiini rǝ Abǝrahamǝ la kǝlɛɛrɩkǝ. Wǝ́ sɩkalǝtǝyǝ sa ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ kpǝ̀. Wǝ́ pǝ kolu pǝ ŋwàa ŋwǝ. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Wǝ́ ŋ kpii ŋ ka ŋ cʊʊrʊ ŋpa rǝ akpɛŋtɛkǝ. Wǝ́ ŋ pǝlǝ ŋ yìili ŋ yɩ̀rɩ. Wǝ́ ŋ nyɩnɩ Abǝrahamǝ ŋ manǝ ciriciri. Wǝ́ ŋ nyɩnɩ Lazaro tini rǝ Abǝrahamǝ la kǝlɛɛrɩkǝ. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Rǝ fɛɛwǝ we wǝ́ ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: “Mǝ tǝ Abǝrahamǝ, nyɩŋ mǝ tǝlarǝwǝ, kǝ e kpii Lazaro ŋ ta mɛŋwǝ mǝ na gaapirǝ ŋ fǝ ŋ pa taarǝ mǝ kǝroŋfwɛɛkǝ. Duturǝ ɖi ŋ́ ya ŋ́ náa cʊʊrʊ rǝ naawǝ sa lǝ mǝrǝ ŋpa.”» <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />Wǝ́ Abǝrahamǝ ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ piyǝ, taalǝ ǝkǝnǝŋ a lɔ̀ wǝceeceekpǝ kǝ́ e ke tini vɔrʊrǝ wǝ. Wǝ́ Lazaro ŋwǝ paa ŋ lɔ̀ wǝrɔɔrɔɔkpǝ. Rǝkǝsa Worokoyǝ ya láa ta no turuwǝ rǝ fɛɛwǝ sa, wǝ́ ŋlǝ́ paa a ya láa cʊʊrʊ. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Tǝ fǝ kʊla we, koŋfuŋmumuŋwǝ rɛ wǝ kpii rǝ lǝ mǝ nǝ le kǝtiitiikǝ. Kǝto mǝŋ rɛ lǝ pǝ́ ŋ ru rǝ lǝh kpǝŋ ŋ po tuu nǝ we, yǝ we lǝŋ koru. Wǝ́ rɛ ŋwǝ ŋkpɛ lǝŋ koru oru rǝ nǝ kpǝŋ ŋ ta ŋ pǝ lǝh kpǝŋ.» <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Wǝ́ sɩkalǝtǝyǝ sa ŋ ke ŋ tíi Abǝrahamǝ ǝkǝnǝŋ: «Mǝ tǝ, dɔɔkpɛ, we kpii Lazaro ŋ ko lah nyarǝwǝ. <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />Mǝ apaanʊpǝ atʊʊ pǝ kpii. Kǝ ŋ ka wɛɛlɩ ŋ tíi pǝ, pǝ pee re vɔrʊrǝ mǝŋ mǝ kǝtǝ. Kǝ ŋpǝ paa pǝ pǝǝ pǝ pǝ fɛɛwǝ sa ŋ́ kpii ŋ́ náa cʊʊrʊ wǝ.» <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />Wǝ́ Abǝrahamǝ ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mose le seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ wǝ kpɛlɩ. Wǝ kaamǝ kǝ pǝ yee pǝ saŋ rǝ etieyǝ sa pǝ la ŋʊrʊ pǝ le kpii rǝ wǝfwɛɛkpǝ sa lǝ mǝrǝ wǝ.» <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Wǝ́ sɩkalǝtǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, mǝ tǝ Abǝrahamǝ, wǝ sɔŋ wǝ loo ro! Paa mǝŋ rɛ lo ru rǝ akpɛŋtɛkǝ la ka nyɩŋ pǝ we, pǝ láa siɛrɩ vɔrʊrǝ.» <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ pǝ lee yee pǝ saŋ rǝ Mose le seyǝ sa mǝ etieyǝ we pǝ la ŋʊrʊ pǝ le kpii rǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ sa we, rɛ ŋ kǝ tǝ ŋ saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ ŋ pa wɛɛlɩ ŋ tíi pǝ we, pǝ lǝŋ pa lɔ pǝ nuŋ».<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Rɛ ŋ poo kuŋ kǝ na kɛrɩyǝ ŋ yee turɔɔrɔɔwǝ</para>
  <para style="r">(<ref loc="MAT 18:6-7">Matewu 18:6-7</ref>, <ref loc="MRK 9:42">Marǝko 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Jirɛɛrǝ Yesu tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Otuyǝ we yǝ lóo tu nyiyǝ yǝ ŋ kpii rǝ turɔɔrɔɔwǝ we, yǝ lǝŋ pa lɛ kʊrakʊra. Paape yǝ we ŋ no koonu, wǝ́ na kɛrɩyǝ ŋ ne yee turɔɔrɔɔwǝ we, yǝ we na paapɔ mǝ na aria! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Mǝŋ pǝ le kpii yǝ we lǝ wǝtǝǝkpǝ rǝ dǝreerǝ, wǝ́ pǝ lǝ fǝ ŋwǝ pǝ le tie pǝ le kpii rǝ apʊyǝ we, wǝ lóo poŋ ŋwǝ wǝ teeri kǝ́ ŋ no tu epipǝ sa la rɛ ŋ ne kpii rǝ turɔɔrɔɔwǝ lǝ mǝrǝ. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Nǝ yee nǝ wɛ lo yurǝ! Mǝŋ lá paanʊyǝ le yee turɔɔrɔɔwǝ rɛ we, wɛɛlɩ e tíi ŋwǝ sɩsiɛrɩ kǝ ŋ ci wǝ ǝkǝnǝŋ ŋ ne yee wǝ loo poŋ. Mǝŋ la nyɩŋ wǝ le ci ǝkǝnǝŋ ŋ ne yee wǝ loo poŋ we, fǝ a cɛɛ ŋwǝ. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Mǝŋ le yee mǝ lǝ́ turɔɔrɔɔwǝ rɛ kǝpǝrɩmata rǝ jirǝ jeŋceŋ lǝ mǝrǝ, wǝ́ ŋ na siɛnɩ ŋ ne pe kpii lǝ́ dɔɔkpɛɛrǝ kǝpǝrɩmata we, fǝ a cɛɛ ŋwǝ.»<verse eid="LUK 17:4" /></para>
  <para style="s">Lɔnuŋrǝ lǝǝmǝ okopiyǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Yesu le enyikpiipǝ we pǝ tìi Kulǝtǝyǝ Yesu ǝkǝnǝŋ: «Kuŋ kǝ lah lɔnuŋrǝ naanǝ gʊla.» <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />Wǝ́ Kulǝtǝyǝ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «O koh nuŋ nǝ nya lɔ nǝ nyo nuŋ tɩpɩrɩ rǝ ko we, nǝ koh koru etíi wǝciikpǝ sa wǝ nuru kǝ wǝ ka tɔ rǝ apʊyǝ, kǝ wǝ lɛ wǝ pǝ ǝnǝ.»<verse eid="LUK 17:6" /></para>
  <para style="s">Sʊmatǝyǝ la anǝnɛyǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝ lǝ fǝ wǝ, mǝŋ rɛ rǝ nǝ mǝrǝ, lǝǝmǝ sʊmatǝyǝ ŋ náa kpɛŋ ŋwǝ amaa ŋ nǝ́ǝ rǝŋ na akɛɛpǝ. Vǝ́ sʊmatǝyǝ sa lo ko ru rǝ atɛɛkǝ lǝ́ǝ pǝ wǝǝ, ŋlǝ́ kulǝtǝyǝ sa o lóo koru etíi ŋwǝ ǝkǝnǝŋ: “Mǝ pǝ kalaŋkalaŋ e pe ri?” <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Kʊrakʊra. Bomu e lée tíi ŋwǝ ǝkǝnǝŋ: “Ka caa keeriwǝ o koonu mǝ. Kǝ a ka cɛkɛlɛ lá kǝkpakǝ kǝ a pa nyɛ keeriwǝ we o koonu mǝ ko ro eniyǝ we ŋ́ ne ri, wǝ́ ŋ́ no ŋuŋ ŋ́ na lɛ. Wǝla kǝmaakǝ we, o lóo koru e ke ri lá nɛŋwǝ kǝ o ŋuŋ.” <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Ŋlǝ́ kulǝtǝyǝ sa ǝ lǝŋ koru eceeni lá sʊmatǝyǝ sa. Duturǝ ɖi sʊmatǝyǝ sa le yee anǝnɛyǝ we e le kpii ŋwǝ ŋ yee wǝ. <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Kaa wǝǝ ŋnǝ ŋkpɛ, mǝŋ Worokoyǝ le kpii nǝ kǝnǝnɛkǝ rɛ, wǝ́ nǝ nye yee kǝlo kpǝlo we, nǝ tíi nǝ wɛ ǝkǝnǝŋ: “Asʊmatǝpǝ ko wǝ́ le ri, ŋlǝ we, lah kǝnǝnɛkǝ ko wǝ́ yǝ le yee.”»<verse eid="LUK 17:10" /></para>
  <para style="s">Yesu la cá anyarǝpimwɛɛrɩlǝtǝpǝ ǝtǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Jirɛɛrǝ Yesu ko ŋ ko Yerusalɛmǝ, wǝ́ ŋ fǝ̀ rǝ Samaria mǝ Galileya la bɛŋrǝ. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Kǝ́ ŋ nah ta ŋ fii dǝŋtǝǝpirǝ rɛ we, wǝ́ anyarǝpimwɛɛrɩlǝtǝpǝ rɛ ǝtǝ pǝ sanǝ pǝ kǝ ŋ pǝ pǝ po ku mǝ ŋwǝ. Wǝ́ pǝ pǝlǝ pǝ yàa rǝ nɔ. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Wǝ́ pǝ cà narǝwǝ pǝ tɛnɩ ǝkǝnǝŋ: «Ao Kulǝtǝyǝ Yesu nyɩŋ lǝ tǝlarǝwǝ oo!» <verse eid="LUK 17:13" /><verse number="14" style="v" sid="LUK 17:14" />Kǝ́ Yesu ŋ na nyɩŋ pǝ we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ ko otoolutǝpǝ lǝ kpǝŋ kǝ nǝ kǝ fǝ nǝ wɛ nǝ kaŋ pǝ». Kǝ́ pǝ kpii pǝ lóo ko we, wǝ́ pǝ kolu pǝ nyɩnɩ pǝ la kpaa. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Kǝ́ nyirɛɛyǝ rǝ pǝlǝ mǝrǝ ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ ŋ na kpaa we, wǝ́ ŋ sìɛnɩ ŋ kǝ ŋ pǝ Yesu lǝ kpǝŋ, wǝ́ ŋ kǝ̀ Worokoyǝ ŋ kǝ ŋ pǝ kelele. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Wǝ́ ŋ pǝlǝ ŋ sʊ̀ʊ ŋ kʊnʊ Yesu kǝrɩka. Wǝ́ ŋ fǝ̀ na anyɩŋkǝ ŋ pùnu rǝ kǝtǝǝwǝ, wǝ́ ŋ yà ŋ ke ŋ ceeni ŋwǝ. Asamariatǝpǝ wǝ́ nyiyǝ we ŋ ke ri. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ ŋkǝ enyipǝ tǝ wǝ́ ŋ́ na cá? Wǝ́ afaŋceŋceŋtuturupǝ we pa? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Wǝ́ pǝla rɛ loo koru atɛŋ ǝkǝnǝŋ ŋ nǝ́ǝ pǝ ŋ pe ceeni Worokoyǝ, sǝǝyǝ sa ko?» <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Wǝ́ Yesu ŋ tìi nyiyǝ we ǝkǝnǝŋ: «Yi o mǝ ko, lá lɔnuŋrǝ la pɔrʊ lǝ́».<verse eid="LUK 17:19" /></para>
  <para style="s">Worokoyǝ ya lée ri wǝpilikpǝ rǝ nǝ mǝrǝ</para>
  <para style="r">(<ref loc="MAT 24:23-28">Matewu 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Afarisitǝpǝ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Eniyǝ rǝ fǝŋ wǝ́ Worokoyǝ ŋ nǝh pǝ ŋ pe ri wǝpilikpǝ wǝ?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Worokoyǝ le wǝpilirikpǝ wǝ lee ri tǝrɛ pǝ láa nyɩŋ mǝ nimirǝ.» <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Wǝ́ rɛ lǝŋ pe tíi nǝ ǝkǝnǝŋ: «Nǝ yɩrɩ re, Worokoyǝ le wǝpilirikpǝ we ǝkpǝǝ» amaa «ŋkpǝ wǝ ya rǝ ɖeeni ǝnǝ!» Paape nǝ ci wǝ ǝkǝnǝŋ Worokoyǝ marǝ ya lée ri wǝpilikpǝ rǝ nǝ mǝrǝ.<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Eniyǝ yǝ lo furu, Nyɩmaasɩ le Pi lah pa ya mǝ ŋ ca nǝ kpɛɛ nǝ rɔsɩ nǝ nyɩŋ jirǝ jeŋceŋ rǝ ko, paape nǝ nyǝŋ nyɩŋ ŋwǝ. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Pǝ lée pe tíi nǝ ǝkǝnǝŋ: “Ya rǝ ɖeeni amaa ya rǝ sa!” Paape nǝ poo suu nǝ ko. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Duturǝ ɖi jirǝ we Nyɩmaasɩ le Pi ŋ nǝh pǝ we, wǝ lǝ́ǝ lǝ mǝŋ kǝ́ ǝrǝkǝ kǝ lée sie, kǝ ŋ nyɩnɩ fɛɛ ri ŋ fɛɛ kǝtǝ. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Paape wǝ kaamǝ kǝ Nyɩmaasɩ le Pi ŋ cʊʊrʊ ŋ coonu ŋpa, kǝ rǝkǝsa le enyipǝ pǝ sǝ́ŋ ŋwǝ pǝ co. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Tuwǝ we wǝ pǝlǝ rǝ Nowa le eniyǝ we we, ŋ wǝ ke wǝ lǝ́ǝ tǝ wǝ pǝ mǝ jirǝ we Nyɩmaasɩ le Pi ŋ nǝh pǝ pǝ wǝ. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Rǝ Nowa le eniyǝ we we, enyipǝ pǝ ke ŋ ri, wǝ́ pǝ ko ŋ ŋuŋ. Pǝ ka ŋ lɔ etiepǝ, wǝ́ enyipǝ pǝ kǝ ŋ fǝ pǝla akɔrʊpǝ pǝ ŋ koonu wǝnuŋkpǝ, ko ro ǝrǝ jirǝ we Nowa ŋ kolu ŋ fìi arakayǝ we ŋ kpǝ̀ lǝ mǝrǝ wǝ. Wǝ́ ŋʊŋtɛmumuŋyǝ rɛ ŋ tìe ǝpǝkǝ, wǝ́ mɛŋwǝ wǝ lǝ̀ kǝtǝǝwǝ pwɩ. Wǝ́ enyipǝ kpǝlo pǝ kpǝ̀. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Wǝ lǝh pǝ lǝ mǝŋ Lɔtǝ le eniyǝ we kǝtǝ. Rǝ Lɔtǝ le eniyǝ we we, enyipǝ pǝ ke ŋ ri, wǝ́ pǝ ko ŋ ŋuŋ, pǝ ko ŋ fuu otuyǝ, wǝ́ pǝ ke ŋ siiri otuyǝ, pǝ ka ŋ kpɛŋ wǝtɛɛkpǝ, wǝ́ pǝ ka ŋ tɔ okuyǝ. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Paape jirǝ we Lɔtǝ ŋ pwɛ̀yɩ rǝ Sodomǝ we, wǝ́ naawǝ mǝ anaaruyǝ yǝ ka ŋ sʊʊ piripiri mǝŋ ŋʊŋtɛyǝ kǝtǝ. Wǝ́ enyipǝ kpǝlo pǝ kpǝ̀ <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Jirǝ we Nyɩmaasɩ le Pi ŋ noh po ru we, kǝ́ wǝ lǝh pǝ lǝ wǝǝ. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Ŋrǝ jirǝ we we, mǝŋ rɛ tɛɛ rǝ akpanyaŋkǝ we, ŋ paa sʊʊ ŋ fii gukpǝ ŋ kǝ fǝ no otuyǝ. Yǝ we ŋ kpii rǝ atɛɛkǝ we, ŋ paa siɛnɩ ŋ pǝ nyarǝwǝ. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Nǝ taalǝ tuwǝ wǝ pǝlǝ wǝ tuu Lɔtǝ le tie. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Yǝ we ŋ ya ŋ nǝ́ǝ pǝ́ ŋ pɔrʊ na wɛ we, lǝ́ǝ kpǝ́. Yǝ we ŋ nǝ́ǝ pǝ́ ŋ lǝǝrǝ na vɔrʊrǝ we, lée tii vɔrʊrǝ. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ eniyǝ we we, enyi eyi pǝ láa kpɛɛ rǝ fɛɛwǝ ceŋceŋ mǝ dumurǝ. Pǝ lǝ́ǝ fǝ nyiyǝ ceŋceŋ pǝ pwɛyɩ, kǝ pǝ maa rɛɛyǝ. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Etiepǝ eyi pǝ láa ya pǝ ŋ tǝǝ fuŋtuwǝ fɛɛceŋceŋ, pǝ lǝ́ǝ fǝ ceŋceŋ pǝ pwɛyɩ, kǝ pǝ maa ceŋceŋ pǝ tǝnǝ. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Ǝpǝrǝŋpǝ eyi pǝ láa yaa rǝ atɛɛkǝ, pǝ lǝ́ǝ fǝ ceŋceŋ pǝ pwɛyɩ, kǝ pǝ maa ceŋceŋ.» <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />Wǝ́ otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, fǝŋ la fɛɛ wǝ́ otuyǝ sa yǝ lǝh pǝ yǝ pǝ pǝ wǝ?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Fɛɛwǝ we kɛɛkpǝ́yǝ ŋ kpɛlɩ we, fɛɛwǝ we wǝ́ otoŋtoŋkɛɛpǝ pǝ lóo ku wǝ». <figure style="fig" alt="Le plafond dʼune maison au temps de Jésus" file="lb00234c.tif" size="col" copy="Louise Bass" ref="17:31">Gukpǝ la akpanyaŋkǝ rǝ Yesu le eniyǝ</figure><verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ kpaŋtɛŋtǝyǝ rɛ mǝ kpeetieyǝ rɛ lo oŋuŋkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Wǝ́ Yesu ŋ cà no otukarǝtǝpǝ lo duturǝ rɛ, kǝ ŋ fǝ ŋ kaŋ pǝ ǝkǝnǝŋ pǝ láa mǝ mwɛŋ nyuŋkpǝ eni ri ŋ ni, kǝ pǝ pee yee wɛɛyɔɔwǝ. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Kpaŋtɛŋtǝyǝ rɛ ke kpii rǝ tǝŋtǝǝwǝ rɛ. Lǝŋ suu Worokoyǝ, wǝ́ lǝŋ lɛ ŋ co oku rǝ nyiyǝ. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Kpeetieyǝ rɛ ŋwǝ ŋkpɛ ke kpii rǝ tǝŋtǝǝwǝ sa. Wǝ́ ŋ ko ŋ ko mǝ ŋ nyɩŋ kpaŋtɛŋtǝyǝ sa eni ri ŋ ni, ŋ tíi ŋwǝ ǝkǝnǝŋ: “Pɛɛnɩ mǝ rǝ wǝkpaŋkpǝ sa wǝ kpii rǝ ŋlǝ mǝ mǝ kǝǝkpǝlǝtǝyǝ mǝrǝ.” <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Wǝ́ kpaŋtɛŋtǝyǝ sa ŋ kǝ ŋ sǝ́ŋ tuwǝ sa kǝpakakǝpaka, wǝ́ wǝ pànǝ ŋpa. Wǝ́ ŋ pǝlǝ ŋ tìi na wɛ ǝkǝnǝŋ: “Wǝ ke ce wǝ ri ŋ́ nǝŋ suu Worokoyǝ, wǝ́ ŋ́ noo co oku rǝ nyiyǝ we, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />kpiikǝ kpeetieyǝ sa ŋ ya ŋ née kpii mǝ awɛɛlɩkǝ kururu kǝto we, ŋ́ náa tɛŋ wǝkpaŋkpǝ sa ŋ́ pɛɛnɩ ŋwǝ. Mǝŋ ŋkǝ kaa wǝǝ we, lée re mǝ ŋ kpii mǝ awɛɛlɩkǝ, ŋ́ náa yɔɔ rʊkparʊkpa.” <verse eid="LUK 18:5" /><verse number="6" style="v" sid="LUK 18:6" />Wǝ́ Kulǝtǝyǝ ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: “Nǝ nuŋ re! Mǝŋ kpaŋtɛŋtǝrɔɔrɔɔyǝ sa ceecee rǝ ŋ na tɛŋ tuwǝ sa ǝnǝ wǝǝ, <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />kǝ Worokoyǝ ŋ wɛ lǝŋ tɛŋ ŋ koonu na anɛŋpǝ we pǝ ya pǝ lóo woolu pǝ ŋ pwo ŋwǝ mǝŋ dumu mǝŋ jɔkɔŋ wǝ? Kǝ ŋ ya mǝŋ tǝǝlǝ mǝ pǝlo otoŋkǝ? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, lah pa tɛŋ ŋ koonu pǝ kalaŋ. Paa jirǝ we Nyɩmaasɩ le Pi ŋ nǝ́ǝ pǝ wǝǝ, láa pa nya enyipǝ pǝ la lɔ Worokoyǝ pǝ lo nuŋ rǝ kǝtǝǝwǝ?”»<verse eid="LUK 18:8" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ Farisitǝnyiyǝ rɛ mǝ laŋpoolɔtǝyǝ rɛ lo oŋuŋkǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Enyirɛɛpǝ pǝ ka ŋ nyɩŋ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ kʊʊ rǝ Worokoyǝ le enimiyǝ. Wǝ́ pǝ ka ŋ nyɩŋ otuturupǝ mǝŋ pǝ lee ri tǝrɛ. Ŋpǝ wǝ́ Yesu ŋ cà duturǝ sa ǝkǝnǝŋ: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />«Enyipǝ rɛ eyi pǝ kolu Worokoyǝ la nyarǝwǝ pǝ ka mwɛŋ nyuŋkpǝ. Ceŋceŋ ke ri Farisitǝnyiyǝ wǝ́ ceŋceŋ ŋ ke ri laŋpoolɔtǝyǝ. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Wǝ́ yǝ we ŋ ri Farisitǝnyiyǝ ŋ yili ŋ yàa. Wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ rǝ nǝ mǝrǝ ǝkǝnǝŋ: “Ao Worokoyǝ, ŋ́ ya ŋ́ née ceeni lǝ́. Duturǝ ɖi ŋ́ nǝǝ lǝ mǝŋ enyituturupǝ kǝtǝ. Pǝ ri ayɩlayɩtǝpǝ, enyilaakʊʊpǝ mǝ epǝ we pǝ lée yee kǝtienaakǝ wǝ. Wǝ́ ŋ́ tǝ ŋ́ ya ŋ́ née ceeni lǝ́. Duturǝ ɖi ŋ́ nǝǝ lǝ mǝŋ laŋpoolɔtǝyǝ sa kǝtǝ. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ŋ́ náa parǝ nyuŋkpǝ kǝyi rǝ kuluwǝ. Ŋ́ nóo koonu lǝ́ mǝ tu ri ŋ tu ŋ́ na nya lǝ tǝtǝwǝ.” <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />Wǝ́ laŋpoolɔtǝyǝ we ŋwǝ paa ŋ kolu ŋ yàa rǝ kǝmaakǝ. Lee ce ŋ tu turuwǝ ŋ yiili ŋ yɩrɩ oŋuŋkǝ ǝkǝŋtǝ. Paa wǝ́ ŋ cà na wɛ lo turuwǝ wa. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Ao Worokoyǝ, nyɩŋ mǝ tǝlarǝwǝ, kpiikǝ turɔɔrɔɔyetǝyǝ wǝ́ ŋ́ ri.” <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ, ŋ́ ya ŋ́ née tíi nǝ wǝ, Worokoyǝ fǝ̀ laŋpoolɔtǝyǝ sa lo oturɔɔrɔɔyǝ cɛ̀ɛ ŋwǝ. Wǝ́ ŋ kpǝ̀lǝŋ ŋ ko ŋ ko nyarǝwǝ. Paa lǝǝ fǝ̀ Farisitǝnyiyǝ sa lo oturɔɔrɔɔyǝ ŋ cɛɛ ŋwǝ. Kǝto yǝ we ŋ náa rɛɛrɩ mǝ na wɛ we, Worokoyǝ láa sʊʊrʊ mǝ ŋwǝ. Paa yǝ we ŋ náa pɛɛlɩ na wɛ we, Worokoyǝ láa rɛɛrɩ mǝ ŋwǝ.»<verse eid="LUK 18:14" /></para>
  <para style="s">Epǝ we pǝ lǝ mǝŋ alaatiepǝ kǝtǝ we, ŋpǝ pǝ loh po ko Yulaarǝ wǝ</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matewu 19:13-15</ref>, <ref loc="MRK 10:13-16">Marǝko 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Wǝ́ enyipǝ pǝ fǝ̀ mǝŋ epiŋwɛŋpǝ pǝ pǝlǝ Yesu lǝ kpǝŋ, kǝ ŋ nya fɛɛ ŋ ruu pǝ. Kǝ́ Yesu lo otukarǝtǝpǝ pǝ la nyɩŋ tuwǝ sa ǝnǝ we, wǝ́ pǝ yà pǝ ka ŋ kpaŋ mǝ enyipǝ we. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Paa wǝ́ Yesu ŋ tìi pǝ ruu epipǝ we pǝ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: «Nǝ maa alaatiepipǝ pǝ pǝ mǝ kpǝŋ. Nǝ pǝǝ sǝŋ wǝla gʊŋrǝ nǝ koonu pǝ. Duturǝ ɖi epǝ we pǝ lǝ mǝŋ alaatiepipǝ sa kǝtǝ we, pǝ lǝǝmǝ fɛɛtiiwǝ rǝ Worokoyǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Ŋ́ ya ŋ́ née tíi nǝ wǝ kǝceece yǝ we ŋ náa tɛɛnɩ Worokoyǝ ŋ ri ne piliyǝ mǝŋ kǝ́ laatieyǝ ŋ náa tɛnɩ tuwǝ kǝtǝ we, ŋwǝ ŋ noh po ko yulaarǝ wǝ.»<verse eid="LUK 18:17" /></para>
  <para style="s">Yesu mǝ sɩkalǝtǝyǝ rɛ</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matewu 19:16-30</ref>, <ref loc="MRK 10:17-31">Marǝko 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Oyudatǝpǝ lo mumuŋyǝ rɛ pǝ̀ Yesu ǝkǝnǝŋ: «Tukaŋtǝceeceeyǝ, kǝ́ wǝ́ ŋ́ née yee kǝ ŋ́ nya vɔrʊlaalɛɛrǝ?» <verse eid="LUK 18:18" /><verse number="19" style="v" sid="LUK 18:19" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ o lóo pwo mǝ nyiceeceeyǝ wǝ? Nyiceeceeyǝ rɛ lee kpii, we Worokoyǝ ceŋceŋ ko. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />E cii esepǝ we, pǝ la tɛŋ ǝkǝnǝŋ: Pee yee kǝtienaakǝ, paa wʊ nyiyǝ, paa yɩɩ, paa nia a tɛɛ rǝ rɛ, nuŋ lǝ́ tǝ mǝ lé lee lo tutɛŋwǝ.» <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />Wǝ́ kɛrɩyǝ sa ŋ tìi Yesu ǝkǝnǝŋ: «Ŋ́ née yee mǝ ŋ saŋ rǝ esepǝ sa kpǝlo kɩɩkɩ ru ǝrǝ mǝ kǝlaatiekǝ.» <verse eid="LUK 18:21" /><verse number="22" style="v" sid="LUK 18:22" />Kǝ́ Yesu ŋ no nuŋ wǝ ǝnǝ we, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ lǝ tǝ wǝ lo tuuru lǝ́ tuwǝ rɛ ceŋceŋ e yee. Siiri ló otulǝmǝyǝ kpǝlo kɩɩkɩ, kǝ ǝ fǝ sɩkayǝ we ǝ sǝpǝ ariariatǝpǝ, eniyǝ we, ǝ lǝ́ǝ lǝmǝ otuyǝ rǝ yulaarǝ, kǝ ǝ mǝ pǝ e pe siimǝ mǝ.» <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Kǝ́ ŋ no nuŋ tuwǝ sa we, wǝ́ wǝ pǝ̀lǝ mǝ ŋwǝ, duturǝ ɖi kǝ lǝǝmǝ na wɛ ŋpa. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Kǝ́ Yesu ŋ na nyɩŋ ŋ ne ci ǝkǝnǝŋ wǝ lǝ pǝlǝ mǝ nyiyǝ sa we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ wǝ lɛnyɩ wǝ koonu epǝ we pǝ lǝǝmǝ pǝla wɛ kǝ pǝ fii Worokoyǝ le wǝpilirikpǝ we mǝrǝ we! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Kǝceece o, wǝ yɔlʊ wǝ koonu kpɔŋkɔyǝ kǝ ŋ fii ŋ ka tɛlɩ rǝ nimiwǝ lo ŋuŋrǝ wǝ teeri kǝ́ sɩkalǝtǝyǝ ŋ neh fii Worokoyǝ le wǝpilirikpǝ we mǝrǝ wǝ.» <verse eid="LUK 18:25" /><verse number="26" style="v" sid="LUK 18:26" />Wǝ́ epǝ we pǝ ko ŋ nuŋ Yesu le etieyǝ sa pǝ pǝ́ ŋwǝ ǝkǝnǝŋ: «We ǝlǝ ŋ nóo koru anya alɔkuŋkǝ wǝ?» <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Tuwǝ we anyɩmaasɩpǝ pǝ lǝŋ koru eyee we, Worokoyǝ lóo koru eyee wǝ». <verse eid="LUK 18:27" /><verse number="28" style="v" sid="LUK 18:28" />Wǝ́ Pɛtǝro ŋ tìi Yesu ǝkǝnǝŋ: «Yɩrɩ re, ŋlǝ paa, yǝ la maa loh otulǝmǝyǝ yǝ lo co wǝ́ yǝ le siimǝ lǝ́.» <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ kǝceece, mǝŋ rɛ la maa na nyarǝwǝ, ne tie, na apaanʊpǝ, nǝ tǝ mǝ ne leeyǝ, amaa ne epipǝ lo co rǝ Worokoyǝ le wǝpilirikpǝ kǝto we, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />Worokoyǝ lóo koonu nǝ yǝ ŋ teeri rǝ eniyǝ sa lǝ mǝrǝ, kǝ ŋ lɛ ŋ pa nya vɔrʊlaalɛɛrǝ rǝ soosowǝ sa wǝ lo furu wǝ».<verse eid="LUK 18:30" /></para>
  <para style="s">Yesu lǝ tǝ la tɛŋ nǝ ǝkpǝ́kǝ mǝ na asaanǝkǝ le dierǝ</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matewu 20:17-19</ref>, <ref loc="MRK 10:32-34">Marǝko 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yesu ŋ pwò ne enyikpiipǝ we pǝlǝ tǝ mǝ eyi ŋ kǝ̀lǝ mǝ na wɛ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyǝŋ nyɩŋ, yǝ loh ko Yerusalɛmǝ. Fɛɛwǝ we wǝ́ otuyǝ we kpǝlo kɩɩkɩ oworokokpɛɛnuŋtɛŋtǝpǝ pǝ la ŋʊrʊ pǝ lo ru rǝ Nyɩmaasɩ le Pi yǝ loh ko yǝ kǝ pǝ wǝǝ. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Duturǝ ɖi pǝ lǝh kǝ fǝ ŋwǝ pǝ kpii epǝ we pǝ lee ri Oyudatǝpǝ rǝ akaakǝ, kǝ pǝ mɔɔnʊ ŋwǝ, kǝ pǝ fɛɛpɩ ŋwǝ, kǝ pǝ toopǝ otutomiyǝ pǝ fieni ŋwǝ. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Pǝ loh ko culu ŋwǝ mǝ fwɛɛpǝlawǝ, kǝ pǝ wʊ ŋwǝ, kǝ juutatǝrǝ ŋ saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.» <verse eid="LUK 18:33" /><verse number="34" style="v" sid="LUK 18:34" />Paape Yesu le enyikpiipǝ sa pǝ loo nuŋ otuyǝ sa la rɛ lo duturǝ. Etieyǝ sa lo duturǝ ŋwàa gbìi pǝ. Pǝ lee ke ci wǝ Yesu ŋ ke reemǝ wǝ.<verse eid="LUK 18:34" /></para>
  <para style="s">Yesu la cá laanyɩŋtǝyǝ rɛ rǝ Yeriko</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matewu 20:29-34</ref>, <ref loc="MRK 10:46-52">Marǝko 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Kǝ́ Yesu ŋ nǝh kǝlǝ mǝ Yeriko we, a nyɩŋ laanyɩŋtǝyǝ rɛ tini rǝ kʊŋlɛɛrɩwǝ láa rialǝ otuyǝ. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Wǝ́ ŋ nunu kǝ́ nyikpǝŋwǝ rɛ wǝ lǝ pǝ wǝ láa tɛlɩ wǝ. Wǝ́ ŋ kǝ ŋ pǝ́ enyipǝ ǝkǝnǝŋ: «Kǝ́ wǝ ya wǝ lǝ́ǝ pǝ?» <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Nazarɛtǝtǝ Yesu ŋ nǝ pǝ ŋ náa tɛlɩ.» <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />Wǝ́ ŋ yà ŋ ko ŋ woolu ǝkǝnǝŋ: «Yesu, Davidǝ le Pilepi, nyɩŋ mǝ tǝlarǝwǝ oo!» <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />Wǝ́ enyipǝ we pǝ ko conu pǝ yà pǝ ka ŋ kpaŋ mǝ ŋwǝ, kǝ ŋ nya fɛɛ ŋ rǝŋ. Paape wǝ́ ŋ ci ǝtǝ ŋ yà ŋ ko ŋ woolu ŋpa ǝkǝnǝŋ: «Davidǝ le Pilepi, nyɩŋ mǝ tǝlarǝwǝ oo!» <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />Wǝ́ Yesu ŋ tùmǝ ŋ yàa. Wǝ́ ŋ kpìi pǝ ka ta ŋwǝ pǝ po koonu ŋwǝ. Kǝ́ laanyɩŋtǝyǝ sa ŋ nǝ pǝ kǝlǝ mǝ ŋwǝ we, wǝ́ Yesu ŋ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />«Kǝ́ wǝ́ a ya lǝ́ǝ pǝ́ ŋ́ yee ŋ́ koonu lǝ́?» Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ tǝ mǝ ŋ nyɩŋ.» <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «We mǝ nyɩŋ ǝkǝ. Lá lɔnuŋrǝ la pɔrʊ lǝ́.» <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Rǝ kǝyaakǝ we wǝ́ ŋ ka ŋ nyɩŋ. Wǝ́ ŋ sìimǝ Yesu ŋ ko ŋ ko. Wǝ́ ŋ yà ŋ kǝ ŋ kǝ Worokoyǝ. Kǝ́ kǝkpǝŋkǝ we kǝ la nyɩŋ tuwǝ sa ǝnǝ we, wǝ́ pǝlo kpǝlo pǝ yà pǝ kǝ ŋ kǝ Worokoyǝ.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yesu lo ko Zahewu lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Kǝ́ Yesu ŋ ne ke fii Yeriko we, wǝ́ ŋ sǝ̀ ŋ tɛ̀lɩ ŋ ko ŋ ko. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Nyiyǝ rɛ ke kpii rǝ tǝŋtǝǝwǝ sa. Alaŋpoolɔtǝpǝ lo mumuŋyǝ wǝ́ ŋ ke ri. Pǝ ko ŋ pwo ŋwǝ Zahewu. Sɩkalǝtǝyǝ wǝ́ ŋ ke ri, <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />kǝ ŋ pǝ́ ŋ nyɩŋ yǝ we pǝ lóo pwo Yesu. Paape kpiikǝ ŋ nǝǝ kǝ kǝŋ kǝto we, loo ko ŋ koru ŋwǝ la anyɩŋ. Duturǝ ɖi enyipǝ pǝ ka naanǝ, wǝ́ pǝ kǝ ŋ sǝŋ ŋwǝ. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Wǝ́ ŋ sù ŋ conu ŋ kolu ŋ rɛ̀ wǝciikpǝ rɛ, mǝŋ kɔɔwe vǝ́ Yesu lǝ pǝ lah tɛlɩ rǝ we we, kǝ ŋ nya fɛɛ ŋ nyɩŋ ŋwǝ. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Kǝ́ Yesu ŋ no po ro fɛɛwǝ we we, wǝ́ ŋ yìili ŋ yɩ̀rɩ ŋwǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Zahewu, sʊʊ kalaŋ. Wǝ kpii kǝ ŋ́ sʊʊrʊ rǝ lǝ́ kpǝŋ ruŋruŋ.» <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Wǝ́ Zahewu ŋ sʊ̀ʊ rǝ wǝciikpǝ we kalaŋ. Wǝ́ ŋ kolu ŋ lɔ̀ Yesu rǝ na nyarǝwǝ mǝ faawǝ. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Kǝ́ enyipǝ we kpǝlo pǝ la nyɩŋ tuwǝ sa ǝnǝ we, wǝ́ pǝ ka ŋ wɛɛlɩ pǝ ŋ ru rǝ Yesu ǝkǝnǝŋ: «Keyi! Nyiyǝ sa la pa sʊʊrʊ rǝ turɔɔrɔɔyeetǝyǝ lǝ kpǝŋ!» <verse eid="LUK 19:7" /><verse number="8" style="v" sid="LUK 19:8" />Wǝ́ Zahewu ŋ yili ŋ yàa, wǝ́ ŋ tìi Kulǝtǝyǝ ǝkǝnǝŋ: «Rǝkǝsa we, Tukaŋtǝyǝ, ŋ́ nǝ́ǝ sǝpǝ mǝ otulǝmǝyǝ kpeewǝ yi cɛɛcɛ kǝ ŋ́ fǝ kǝtarɛɛkǝ ŋ́ lɛmɩ ariariatǝpǝ. Mǝŋ ŋ́ ne sisi rɛ ŋ́ na lɔ sɩkayǝ we, ŋ́ náa mwara yǝ we fɛɛwǝ kpeewǝ niǝ.» <verse eid="LUK 19:8" /><verse number="9" style="v" sid="LUK 19:9" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ruŋruŋ nyarǝwǝ sa wǝ la nya alɔkuŋkǝ. Kpiikǝ ŋlá ŋkpɛ e ri Abǝrahamǝ le pilepiyǝ kǝto. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Duturǝ ɖi Nyɩmaasɩ le Pi lǝ pǝ ŋ pa taa epǝ we pǝ lǝ lǝǝ wǝ, kǝ ŋ pɔrʊ pǝ.»<verse eid="LUK 19:10" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ sɩkayǝ nyiyǝ rɛ ŋ sǝ̀pǝ na asʊmatǝpǝ kǝ pǝ fǝ pǝ ŋ siɛrɩ kǝ pǝ pe yee akʊŋtayǝ pǝ koonu ŋwǝ</para>
  <para style="r">(<ref loc="MAT 25:14-30">Matewu 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Wǝ́ Yesu ŋ tǝ ŋ cà enyipǝ we pǝ yà pǝ ko ŋ nuŋ etieyǝ sa lo duturǝ rɛ. Eniyǝ we oturu lǝ kǝ kǝlǝ mǝ Yerusalɛmǝ. Wǝ́ enyipǝ we pǝ ko ŋ pu wǝ ǝkǝnǝŋ Worokoyǝ le wǝpilirikpǝ we wǝ lǝh pǝ rǝ kǝyaakǝ we. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Sɩkalǝtǝyǝ rɛ ka ŋ pwɛyɩ ŋ ko tǝŋtǝǝlǝǝrǝwǝ rɛ, kǝ pǝ ke tiini ne wǝpilikpǝ rǝ we, kǝ mǝ ŋ pǝ. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Wǝ́ ŋ pwò na asʊmatǝpǝ tǝ. Wǝ́ ŋ fǝ̀ sɩkakpotokpotoyǝ rɛ tǝ, ŋ no ru okuruyǝ ŋpa, ŋ kòonu nyi ri ŋ nyi ceŋceŋ ceŋceŋ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: “Nǝ fǝ sɩkayǝ sa nǝ mǝ ri wǝraakpǝ ko ro eniyǝ ŋ́ náa siɛnɩ ŋ́ pǝ wǝ.” <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Paa sɩkalǝtǝyǝ sa lǝ ǝtǝŋtǝǝtǝpǝ pǝ kǝ ŋ kpǝ̀lǝ nǝ kǝǝwǝ. Wǝ́ pǝ kpìi enyipǝ rǝ na kǝmaakǝ pǝ ka tɛŋ ǝkǝnǝŋ: “Yǝ laa ya yǝ lǝ́ǝ pǝ́ nyiyǝ sa ŋ ri leh piliyǝ.” <verse eid="LUK 19:14" /><verse number="15" style="v" sid="LUK 19:15" />Paape wǝ́ pǝ kolu pǝ fǝ̀ ŋwǝ pǝ yeli piliyǝ. Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ nǝ tǝŋtǝǝwǝ. Wǝ́ ŋ kpìi pǝ pwolu na asʊmatǝpǝ we ŋ kòonu sɩkayǝ wǝ. Wǝ́ ŋ tìi pǝ pǝ yee akʊŋtayǝ pǝ koonu ŋwǝ. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Wǝ́ sǝsǝŋyǝ ŋ pǝlǝ ŋ yàa, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, ŋ́ na nya sɩkakpotokpotoyǝ tǝ ŋ́ na kʊla mǝ yǝ we o kòonu mǝ wǝ.” <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Wǝ́ piliyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: “E le yee wǝ ponu, sʊmatǝceeceeyǝ wǝ́ e ri. Kǝ́ e le yee anʊkɔrǝyǝ rǝ tupiwǝ sa lǝ mǝrǝ we, ŋ́ nǝ́ǝ fǝ lǝ́ ŋ́ yee tǝŋtǝǝwǝ tǝ lǝ kǝŋyɩrɩtǝyǝ.” <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Wǝ́ yitǝyǝ ŋ pǝlǝ ŋ yàa, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Kulǝtǝyǝ, ŋ́ na nya sɩkakpotokpotoyǝ tʊʊ ŋ́ na kʊla mǝ yǝ we o kòonu mǝ wǝ.” <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Wǝ́ piliyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: “Lá ŋkpɛ ŋ́ nǝ́ǝ fǝ lǝ́ ŋ́ yee tǝŋtǝǝwǝ tʊʊ lǝ kǝŋyɩrɩtǝyǝ.” <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Wǝ́ sʊmatǝpʊŋpwayǝ ŋ pǝlǝ ŋ yàa, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, lá sɩkayǝ we o kòonu mǝ ǝ yǝǝ. Ŋ́ na ca na gʊʊrǝ rǝ apɔsɔyǝ ŋ́ nǝ tǝnǝ. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Ŋ́ yà ŋ́ ko ŋ suu lǝ́ vurǝ. Duturǝ ɖi, yulɛnyɩtǝyǝ wǝ́ e ri. Tuwǝ we ǝ lǝǝ tǝnǝ we, ŋ wǝ wǝ́ ǝ lǝ́ǝ fǝ wǝ. Tuwǝ we a laa rʊʊ we, ŋ wǝ wǝ́ a láa lɛɛ wǝ.” <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Wǝ́ kulǝtǝyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: “Sʊmatǝrɔɔrɔɔyǝ rɛ wǝ́ e ri, ŋ́ nǝ́ǝ fǝ ŋlǝ́ŋlǝ́ lé etieyǝ ŋ́ tɛŋ wǝkpaŋkpǝ mǝ lǝ́. E cii wǝ ǝkǝnǝŋ yulɛnyɩtǝyǝ wǝ́ ŋ́ ri, wǝ́ tuwǝ we ŋ́ nǝǝ tǝnǝ we, ŋ wǝ wǝ́ ŋ́ nǝ́ǝ fǝ wǝ. Tuwǝ we ŋ́ naa rʊʊ, ŋ wǝ wǝ́ ŋ́ náa lɛɛ wǝǝ, <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />kǝ́ kǝto wǝ́ o loo koru ǝ fǝ sɩkayǝ sa ŋ́ no koonu lǝ́ ǝ kǝ tǝnǝ rǝ fɛɛtǝnǝsɩkayǝ kǝ mǝ ŋ ta mǝ ŋ tɛɛ wǝ? A kah nyɩŋ kǝ́ ŋ́ na siɛnɩ ŋ́ nǝ pǝ pǝ we, ŋ́ koh ko ŋ́ ka lɔ ŋwǝ mǝŋ tǝtatɛɛyǝ”. <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Wǝ́ ŋ tìi epǝ we pǝ ka yaa ǝkǝnǝŋ: “Nǝ ta sɩkayǝ we nǝ lɔ rǝ ŋwǝ, kǝ nǝ fǝ ŋwǝ nǝ koonu yǝ we ŋ na nya sɩkakpotokpotoyǝ tǝ wǝ.” <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Wǝ́ enyipǝ we pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: “He, kulǝtǝyǝ, nyiyǝ sa marǝ lǝǝmǝ sɩkakpotokpotoyǝ tǝ oo.” <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />Wǝ́ kulǝtǝyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: “Ŋ́ ya ŋ́ née tíi nǝ wǝ, yǝ we ŋ lǝǝmǝ tuwǝ we, ŋwǝ wǝ́ pǝ lóo koonu tuwǝ pǝ ŋ kʊla wǝ. Paa yǝ we ŋ nǝǝ lǝmǝ tǝrɛ we, pǝ láa lɔ pipiwǝ we ǝkǝŋtǝ wǝ lo tuuru ŋwǝ we, rǝ ŋwǝ. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Rǝkǝsa mǝ ǝkǝǝkpǝlǝtǝpǝ we pǝ laa ya pǝ lǝ́ǝ pǝ́ mǝ ŋ́ ri wǝpilikpǝ we, nǝ fǝ pǝ nǝ pǝ fɛɛwǝ sa kǝ nǝ wʊʊlʊ pǝ rǝ mǝ enimiyǝ.”»<verse eid="LUK 19:27" /></para>
  <para style="s">Yesu lah ta ŋ fii Yerusalɛmǝ mǝŋ piliyǝ kǝtǝ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matewu 21:1-11</ref>, <ref loc="MRK 11:1-11">Marǝko 11:1-11</ref>, <ref loc="JHN 12:12-19">Yowanɛsɩ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ conu mǝ nyikpǝŋwǝ we ŋ ko ŋ ko Yerusalɛmǝ. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Kǝ́ pǝ lǝ pǝ kǝlǝ mǝ Befage mǝ Betania yǝ yaa rǝ dutupirǝ we pǝ lóo pwo Oliviepǝ lo dutupirǝ la kǝlɛɛrɩkǝ, wǝ́ ŋ kpìi no otukarǝtǝpǝ eyi, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ko dǝŋtǝǝpirǝ sa yaa rǝ nǝ kǝnyɩŋkǝ. Vǝ́ nǝ nyée ke fii eni we, nǝ nyáa nyɩŋ pǝ la kɔŋ rookɛtɛpirǝ rɛ. Rɛ faa rɛ ŋ tii rǝ rǝ ŋ nyɩŋ, kǝ nǝ wuru rǝ nǝ po koonu mǝ. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Wǝ́ mǝŋ rɛ lǝ pǝ́ nǝ ǝkǝnǝŋ “Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo wuru rǝ?” we, nǝ tíi ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ ya lǝ́ǝ pǝ́ rǝ.”» <verse eid="LUK 19:31" /><verse number="32" style="v" sid="LUK 19:32" />Wǝ́ otukarǝtǝpǝ we pǝ ko ŋ ko. Wǝ́ pǝ kolu pǝ nyɩnɩ tu ri ŋ tu mǝŋ kǝ́ Yesu ŋ tìi pǝ kǝtǝ. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Kǝ́ pǝ ya pǝ lóo wuru rookɛtɛyǝ we we, wǝ́ ǝtǝlǝtǝpǝ pǝ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo wuru ɖookɛtɛpirǝ we wǝ?» <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />Wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Kulǝtǝyǝ ŋ ya ŋ nǝ́ǝ pǝ́ rǝ.» <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Wǝ́ pǝ wuru ŋwǝ pǝ kolu pǝ kòonu Yesu. Wǝ́ pǝ fǝ̀ pǝla wǝkpakpǝ pǝ fǝ̀ pǝ tɛ̀ɛ rǝ rookɛtɛyǝ we la amaakǝ. Wǝ́ pǝ rǝ̀ǝrǝ Yesu pǝ tìini rǝ ŋwǝ. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Wǝ́ enyipǝ pǝ kǝ ŋ fǝ pǝla anyaŋyǝ pǝ ŋ co gʊŋrǝ we. Wǝ́ rookɛtɛyǝ we ŋ sanǝ rǝ yǝ ŋ ko ŋ ko. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />Kǝ́ ŋ nah ta ŋ kǝlǝ mǝ Yerusalɛmǝ we, rǝ gʊŋrǝ we lo ru rǝ oliviepǝ lo dutupirǝ láa sʊʊ we, wǝ́ otukarǝtǝpǝ we lǝ kpǝŋwǝ we kpǝlo kɩɩkɩ pǝ nya faawǝ pǝ yà pǝ kǝ ŋ kǝ Worokoyǝ kelele rǝ otuyǝ we kpǝlo yǝ lóo co vurǝ pǝ la nyɩŋ Yesu ŋ ne yee kǝto. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />Pǝ yà pǝ ka ŋ nɔŋ ǝkǝnǝŋ: «Worokoyǝ ŋ pɛɛrɩ piliyǝ sa ŋ nǝ́ǝ pǝ rǝ Kulǝtǝyǝ la nyɩŋrǝ wǝ! Wǝtaarǝkpǝ wǝ pǝ rǝ yulaarǝ! Ǝkǝkǝ kǝ ri Worokoyǝ la kǝnɛŋ.» <verse eid="LUK 19:38" /><verse number="39" style="v" sid="LUK 19:39" />Wǝ́ Afarisitǝpǝ rɛ pǝ ka kʊla mǝ nyikpǝŋwǝ we pǝ ke ŋ tíi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, tíi ló otukarǝtǝpǝ sa pǝ rǝ́ŋ!» <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />Wǝ́ Yesu ŋ tìi Afarisitǝpǝ we ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, enyipǝ sa pǝ ke ce pǝ rǝ́ŋ we, oruyǝ yǝ lóo woolu». <figure style="fig" alt="Jésus entrant à Jérusalem sur un ânon" file="CN01782C.TIF" size="span" copy="David C Cook" ref="19:36">Yesu tɛɛ rǝ rookɛtɛyǝ leh fii Yerusalɛmǝ</figure><verse eid="LUK 19:40" /></para>
  <para style="s">Yesu le wee rǝ Yerusalɛmǝ lo yurǝ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Kǝ́ Yesu ŋ nǝ kǝ kǝlǝ mǝ Yerusalɛmǝ we, wǝ́ ŋ nyɩnɩ tǝŋtǝǝwǝ sa, wǝ́ ŋ weli rǝ wǝlo yurǝ. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «O koh nuŋ ŋnǝ Eyerusalɛmǝtǝpǝ sa ŋnǝ ŋkpɛ nǝ cii kǝ́ nǝ nyée yee kǝ nǝ nya wǝtaarǝkpǝ ruŋruŋwǝ sa we! Paape rǝkǝsa wǝ la ŋwaa wǝ le kpii nǝ. Nǝ nyǝŋ tǝ nǝ koru anyɩŋ wǝ nǝ ci. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Duturǝ ɖi eniyǝ yǝ lo furu, nǝ ǝkǝǝkpǝlǝtǝpǝ pǝ lah pa tɔ giriŋrǝ pǝ co pǝ siri nǝ. Kǝ pǝ co pǝ siri nǝ kǝta ri ŋ kǝta, kǝ pǝ yee akɔŋkǝ mǝ nǝ. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Pǝ láa wɔɔ nǝ tǝŋtǝǝwǝ sa kǝ pǝ wʊʊlʊ nǝ kpǝlo kɩɩkɩ. Pǝ lǝŋ maa kukǝriŋwǝ rɛ kǝ o turu pǝ laa wɔɔ wǝ. Duturǝ ɖi nǝ nyaa nyɩŋ eniyǝ we Worokoyǝ ŋ nǝ pǝ ŋ pa lɔ ŋ koonu nǝ nǝ ci.»<verse eid="LUK 19:44" /></para>
  <para style="s">Yesu le piri otusiiritǝpǝ rǝ Worokoyǝ la nyarǝwǝ</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matewu 21:12-17</ref>, <ref loc="MRK 11:15-19">Marǝko 11:15-19</ref>, <ref loc="JHN 2:13-22">Yowanɛsɩ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Kǝ́ Yesu ŋ ne ke fii Worokoyǝ la nyarǝwǝ we, wǝ́ ŋ yà ŋ ke piri otusiiritǝpǝ. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoŋtierǝ la tɛŋ ǝkǝnǝŋ: “Mǝ nyarǝwǝ wǝ ri rǝ fɛɛmwɛŋnyuŋkpǝ. Paape ŋnǝ nǝ nyǝ fǝ wǝ nǝ nye yee ayɩlayɩtǝpǝ la fɛɛŋwaawǝ.”» <verse eid="LUK 19:46" /><verse number="47" style="v" sid="LUK 19:47" />Wǝ́ Yesu ŋ ka ŋ kaŋ otuyǝ ji ri ŋ ji rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ otoolutǝmumuŋpǝ, oworokosekaŋtǝpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ yà pǝ ka ŋ taa kʊŋwǝ kǝ pǝ wʊ ŋwǝ. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Paape pǝ lee ci kǝ́ pǝ leh yee kǝ pǝ wʊ ŋwǝ, duturǝ ɖi kǝkpǝŋkǝ we kpǝlo kǝ cò kǝtukoŋkǝ kǝ yà kǝ ko ŋ nuŋ Yesu le etieyǝ we sɩsiɛrɩ.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Pǝ lǝ pǝ́ Yesu ǝkǝnǝŋ ǝlǝ ŋ no koonu no okopiyǝ sa</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matewu 21:23-27</ref>, <ref loc="MRK 11:27-33">Marǝko 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Jirɛɛrǝ Yesu yà ka ŋ kaŋ enyipǝ lo otuyǝ rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ ka ŋ tɛŋ Dieceeceerǝ we mǝ ŋ tíi pǝ. Wǝ́ otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ, fǝ kʊla mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ pǝlǝ pǝ rù. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ lo okopi wǝ́ a la nya a ya lée yee otuyǝ sa ǝnǝ? Ǝlǝ ŋ no koonu lǝ́ ŋyǝ okopiyǝ sa wǝ? Tíi lǝ!» <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋkpɛ ŋ́ nǝ́ǝ pǝ́ nǝ dierǝ jeŋceŋ. Nǝ tíi mǝ <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Yowanɛsɩ lo worokomɛŋwiiriwǝ we wǝǝ, wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ amaa anyɩmaasɩpǝ lǝ kpǝŋ?» <verse eid="LUK 20:4" /><verse number="5" style="v" sid="LUK 20:5" />Wǝ́ pǝ ka ŋ ŋwaa pǝ ŋ tíi awɛ ǝkǝnǝŋ: «Mǝŋ yǝ la tɛŋ Worokoyǝ we, lǝ́ǝ pǝ́ lǝ ǝkǝnǝŋ: “Kǝ́ kǝto wǝ́ nǝ nyaa lɔ Yowanɛsɩ nǝ nuŋ wǝ? <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Wǝ́ mǝŋ yǝ la tɛŋ ǝkǝnǝŋ anyɩmaasɩpǝ lǝ kpǝŋ we, kǝkpǝŋkǝ kpǝlo kɩɩkɩ kǝ lée tieni lǝ oruyǝ kǝ wʊ. Duturǝ ɖi pǝlo kpǝlo kɩɩkɩ pǝ la lɔ pǝ lo nuŋ ǝkǝnǝŋ Yowanɛsɩ ke ri worokokpɛɛnuŋtɛŋtǝyǝ.”» <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Fɛɛwǝ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lee ci yǝ we ŋ kpìi ŋwǝ.» <verse eid="LUK 20:7" /><verse number="8" style="v" sid="LUK 20:8" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋkpɛ ŋ́ nǝŋ tíi nǝ okopiyǝ we ŋ́ nǝ fǝ ŋ́ ya ŋ́ née yee otuyǝ sa wǝ».<verse eid="LUK 20:8" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ apaalǝtǝpǝ rɛ pǝ ri oyulɛŋtǝpǝ wǝ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matewu 21:33-46</ref>, <ref loc="MRK 12:1-12">Marǝko 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Wǝla kǝmaakǝ wǝ́ Yesu ŋ cà kǝkpǝŋkǝ we lo duturǝ ǝkǝnǝŋ: «Nyiyǝ rɛ kpɛnɩ arɛzɛŋtɛɛkǝ<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Rɛzɛŋyǝ wǝ́ pǝ lǝ́ǝ fǝ pǝ ŋ yee vɛŋyǝ.</char></note>. Wǝ́ ŋ fǝ̀ atɛɛkǝ sa ŋ kpìi apaalǝtǝpǝ rǝ akaakǝ pǝ ŋ yɩrɩ yurǝ. Wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko gʊŋrǝ. Wǝ́ ŋ kolu ŋ pànǝ ŋpa. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Kǝ́ eniŋlɛɛyǝ yǝ lo ro we, wǝ́ ŋ kpìi na sʊmatǝyǝ rɛ ŋ manǝ apaalǝtǝpǝ we, kǝ ŋ ka lɔ na nɛŋ rɛzɛŋyǝ ŋ po koonu ŋwǝ. Paa wǝ́ apaalǝtǝpǝ sa pǝ lɔ̀ sʊmatǝyǝ sa pǝ cùlu. Wǝ́ pǝ pìri ŋwǝ ŋ ko ŋ ko akaakpaakpa. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Wǝ́ tɛɛlǝtǝyǝ we ŋ tǝ ŋ kpìi sʊmatǝpʊŋpwayǝ. Wǝ́ apaalǝtǝpǝ we pǝ cùlu ŋwǝ ŋkpɛ, wǝ́ pǝ fɛ̀ɛpɩ ŋwǝ. Wǝ́ pǝ pìri ŋwǝ, pǝ loo kuŋ na tǝrɛ. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Wǝ́ ŋ tǝ ŋ kpìi tatǝyǝ, wǝ́ pǝ nyàanǝ ŋwǝ. Wǝ́ pǝ pìri ŋwǝ ŋkpɛ. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Wǝ́ tɛɛlǝtǝyǝ sa ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ: “Ŋ́ neh yee nɛ? Ŋ́ née kpii mǝ piyǝ sa ŋ́ náa taa kǝǝwǝ ŋ́ koonu pǝ. Ŋ́ cii wǝ pǝ lóo suu ŋwǝ yǝ le enimiyǝ.” <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Paa kǝ́ apaalǝtǝpǝ sa pǝ la nyɩŋ ŋwǝ we, wǝ́ pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: “Nyiyǝ sa ŋ nǝh pǝ ŋ pe ri ǝtǝtuyǝ sa wǝ! Nǝ pǝ kǝ la wʊ ŋwǝ, kǝ ǝtǝtuyǝ sa yǝ nya fɛɛ yǝ pe yee lah anɛŋ.” <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Wǝ́ pǝ rù mǝ ŋwǝ rǝ arɛzɛŋtɛɛkǝ we pǝ tìe pǝ cò. Wǝ́ pǝ wʊlʊ ŋwǝ.» Wǝ́ Yesu ŋ pǝ̀ ǝkǝnǝŋ: «Rǝkǝsa kǝ́ wǝ́ tɛɛlǝtǝyǝ sa ŋ neh yee mǝ apaalǝtǝpǝ sa? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Lǝ́ǝ pǝ ŋ pa wʊʊlʊ apaalǝtǝpǝ sa, kǝ ŋ fǝ arɛzɛŋtɛɛkǝ sa ŋ kpii apaalǝtǝpʊŋpwapǝ rǝ akaakǝ.» Kǝ́ enyipǝ sa pǝ lo nuŋ tuwǝ sa we, wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Keyi! Wǝ lǝŋ koru ǝpǝ ǝnǝ kʊrakʊra!» <verse eid="LUK 20:16" /><verse number="17" style="v" sid="LUK 20:17" />Wǝ́ Yesu ŋ yà ŋ ka ŋ yɩrɩ pǝ pʊrɩpʊrɩ. Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «We dierǝ sa pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 20:17">“Ɖurǝ we okumarǝtǝpǝ pǝ lǝ sǝ́ŋ we,</para>
  <para style="q1" vid="LUK 20:17">ŋrǝ le pe yee yusirurǝ wǝǝ” lo duturǝ ɖi nɛ? <verse eid="LUK 20:17" /><verse number="18" style="v" sid="LUK 20:18" />Nyi ri ŋ nyi ŋ nóo ru ŋ pa tɔɔ rǝ ɖurǝ sa we, lóo poolu. Wǝ́ mǝŋ ɖurǝ sa lo ru la tɔɔ rɛ we, yǝ we lǝ́ǝ tǝǝ kɩɩkɩ.»<verse eid="LUK 20:18" /></para>
  <para style="s">Wǝ lǝ kpuŋkpuruŋ kǝ pǝ mwara Kayizaro la laŋpooyǝ?</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matewu 22:15-22</ref>, <ref loc="MRK 12:13-17">Marǝko 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Esekaŋtǝpǝ mǝ otoolutǝmumuŋpǝ pǝ ka ŋ taa kʊŋwǝ kǝ pǝ lɔ Yesu kǝtǝrǝceŋceŋ. Duturǝ ɖi pǝ ke cii wǝ ǝkǝnǝŋ ŋpǝ wǝ́ Yesu ŋ na ca duturǝ we. Paape pǝ ko ŋ suu kǝkpǝŋkǝ we lo vurǝ. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Wǝ́ pǝ fǝ̀ pǝ kaŋ wɛ ŋwǝ rǝ, kǝ pǝ nya fɛɛ pǝ ro ŋwǝ pǝ ta, kǝ pǝ fǝ ŋwǝ pǝ kpii kǝŋyɩrɩtǝyǝ we ŋ lǝǝmǝ okopiyǝ rǝ gǝŋrǝ we rǝ akaakǝ. Wǝ kǝto pǝ ŋwàa pǝ kpìi enyipǝ pǝ siimǝ ŋwǝ, kǝ pǝ re pǝla wɛ mǝŋ enyiceeceepǝ rɛ kǝtǝ. Paa kǝ pǝ ŋ kɔŋ na akpɛrɛyǝ rǝ pǝle etiepǝ́yǝ. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Wǝ́ enyipǝ sa pǝ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, le cii wǝ ǝkǝnǝŋ lé etietɛŋyǝ mǝ ló otukaŋyǝ yǝ kʊʊ. A lǝŋ yɩrɩ rǝ anyɩŋkǝ. Wǝ́ kǝceece, Worokoyǝ la akʊŋyǝ wǝ́ a ya láa kaŋ mǝ anʊkɔrǝyǝ. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Tíi lǝ, leh seyǝ lo kuŋ gʊŋrǝ la mwara Kayizaro la laŋpooyǝ? Amaa loo kuŋ guŋrǝ?» <verse eid="LUK 20:22" /><verse number="23" style="v" sid="LUK 20:23" />Wǝ́ Yesu ŋ nyɩnɩ wǝ ŋ cìi ǝkǝnǝŋ kpɛrɛwǝ wǝ́ pǝ la kɔŋ ŋwǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />«Nǝ fǝ sɩkakpotokpotoyǝ ceŋceŋ nǝ pǝ ŋ́ yɩrɩ.» Wǝ́ ŋ pǝ̀ ǝkǝnǝŋ: «Ǝlǝ la anyɩŋkǝ mǝ nyɩŋrǝ yǝ tɛɛ rǝ sɩkayǝ sa ǝnǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kayizaro ŋ lǝǝwe». <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «We nǝ fǝ otuyǝ we yǝ ri Kayizaro la anɛŋyǝ nǝ koonu Kayizaro, kǝ nǝ fǝ Worokoyǝ lo otuyǝ nǝ koonu Worokoyǝ». <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />Pǝ laa nyà dierɔɔrɔɔrǝ rɛ pǝ rù rǝ Yesu la awɛɛlɩkǝ pǝ lǝh fǝ pǝ lɔ ŋwǝ rǝ kǝkpǝŋkǝ le enimiyǝ. Yesu le dierǝ we ŋ kpǝ̀lǝŋ ŋ kòonu pǝ ɖili pǝlo mumuŋ. Pǝ lǝǝ tǝ pǝ tɛŋ tǝrɛ.<verse eid="LUK 20:26" /></para>
  <para style="s">Asadukitǝpǝ pǝ lǝ pǝ́ Yesu mǝŋ enyiǝtǝpǝ pǝ lah pa saanǝ wǝ</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matewu 22:23-33</ref>, <ref loc="MRK 12:18-27">Marǝko 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Asadukitǝpǝ rɛ pǝ pǝlǝ Yesu lǝ kpǝŋ. Ŋpǝ pǝ láa tɛŋ ǝkǝnǝŋ enyiǝtǝpǝ pǝ lǝŋ pa saanǝ wǝ. Wǝ́ pǝ pǝ̀ Yesu le dierǝ sa ǝkǝnǝŋ: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />«Tukaŋtǝyǝ, Mose la ŋʊrʊ le kpii lǝ rǝ seyǝ la kǝfwɛɛkǝ mǝrǝ ǝkǝnǝŋ: “Mǝŋ nyiyǝ rɛ, le mǝteeyǝ lǝ kpǝ́ la maa ne tieyǝ. Wǝ́ tieyǝ sa ŋ nǝǝ mǝ piyǝ ŋ koonu ŋwǝ. Wǝ kpii kǝ nyiyǝ sa ŋ fǝ ne mǝtee le kpeetieyǝ sa ŋ lɔ. Kǝ ŋ tǝnǝ yuwǝ ŋ koonu yǝ we ŋ nǝ kpǝ́ wǝ.” <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Rǝkǝsa apaanʊpǝ rɛ apǝrɩmata pǝ ke kpii. Wǝ́ pǝlo mumuŋyǝ ŋ lɔ̀ tieyǝ. Pǝ lǝǝ mǝ, wǝ́ pǝrǝŋyǝ we ŋ kpǝ̀. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Wǝ́ paanʊyitǝyǝ ŋ fǝ̀ kpeetieyǝ we ŋ lɔ̀. Lǝǝ mǝ piyǝ wǝ́ ŋwǝ ŋkpɛ ŋ kpǝ̀. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Tatǝyǝ mǝŋ kaa wǝǝ, niǝtǝyǝ mǝŋ kaa wǝǝ. Wǝ́ pǝla apǝrɩmata pǝ kpǝ̀ pǝ kolu pǝ lɛ rǝ. Rɛ lǝǝ mǝ piyǝ. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Wǝla kǝmaakǝ wǝ́ tieyǝ we ŋwǝ ŋkpɛ ŋ kpǝ̀. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Kǝ́ wǝ ri tieyǝ sa la ca pǝla apǝrɩmata la nyɩŋ wǝǝ, rǝkǝsa jirǝ we enyiǝtǝpǝ pǝ láa saanǝ wǝǝ, tieyǝ sa leh pe ri pǝlǝ ǝlǝ le tieyǝ?» <verse eid="LUK 20:33" /><verse number="34" style="v" sid="LUK 20:34" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Rǝkǝsa le enyipǝ pǝ láa lɔ etiepǝ wǝ́ pǝ láa ca wǝnuŋkpǝ wǝ. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Paa epǝ we Worokoyǝ ŋ na nyɩŋ pǝ kaamǝ, pǝ lah pa saanǝ pǝ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ, kǝ pǝ pe tii vɔrʊrǝ rǝ eniyǝ we yǝ kpii yǝ lǝ́ǝ pǝ we, pǝ lǝŋ tǝ pǝ pa lɔ tieyǝ amaa pǝ lǝŋ tǝ pǝ pa caa wǝnuŋkpǝ. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Pǝ lǝŋ tǝ pǝ po koru ǝkpǝ́. Duturǝ ɖi, pǝ lǝ mǝŋ epicoŋpipǝ kǝtǝ. Pǝ ri Worokoyǝ le epipǝ, duturǝ ɖi la saanǝ pǝ lo ru rǝ gbɛŋrǝ. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Mose la tɛŋ wǝ sǝsiɛrɩ la pa tɛlɩ ǝkǝnǝŋ enyiǝtǝpǝ pǝ lah pa saanǝ. La tɛŋ wǝ rǝ fɛɛwǝ we ŋ na wɛɛlɩ ŋ no ru rǝ goŋkupirǝ we ga ŋ ta naawǝ. Eniyǝ we ŋ pwò Ǝtǝ Woroko ǝkǝnǝŋ Abǝrahamǝ lo Worokoyǝ, Isakǝ lo Worokoyǝ mǝ Yakɔbǝ lo Worokoyǝ wǝ.» <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Wǝ́ Yesu ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ lee ri enyiǝtǝpǝ lo Worokoyǝ, epǝ we pǝ kpii vɔrʊrǝ lo Worokoyǝ wǝ́ ŋ ri. Duturǝ ɖi pǝlo kpǝlo kɩɩkɩ pǝ kpii vɔrʊrǝ pǝ koonu ŋwǝ.» <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />Wǝ́ esekaŋtǝpǝ rɛ pǝ lɔ̀ kpɛɛwǝ, wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, a la wɛɛlɩ sǝsiɛrɩ to.» <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Kǝto rɛ lǝǝ tǝ ŋ tu turuwǝ ŋ pǝ́ ne dierǝ rɛ.<verse eid="LUK 20:40" /></para>
  <para style="s">Yesu la kaŋ otuyǝ ǝkǝnǝŋ Davidǝ lo kulǝtǝyǝ ǝrǝ Mesiyayǝ we</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matewu 22:41-46</ref>, <ref loc="MRK 12:35-37">Marǝko 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Wǝ́ Yesu ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Enyipǝ pǝ láa tɛŋ ǝkǝnǝŋ Mesiyayǝ ri Davidǝ le pilepiyǝ. Nɛ kǝto wǝ́ pǝ láa tɛŋ wǝ ǝnǝ?» <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Duturǝ ɖi Davidǝ ŋwǝŋwǝ la tɛŋ rǝ Opusomǝpǝ la kǝfwɛɛkǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 20:42">«Ǝtǝ Woroko le tíi mǝ Kulǝtǝyǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="LUK 20:42">Pe tii rǝ mǝ kǝnirisiɛɛkǝ,<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />ko ro eniyǝ ŋ́ nǝ fǝ lǝ́ ǝkǝǝkpǝlǝtǝpǝ</para>
  <para style="q1" vid="LUK 20:43">ŋ́ kpii lǝ́ rǝ lá akparǝyǝ lǝ kǝnǝŋkǝ.<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Kǝto Davidǝ lóo pwo ŋwǝ ǝkǝnǝŋ Kulǝtǝyǝ. Wǝ́ wǝ lée yee nɛ kǝ ŋ pe ri Davidǝ le pilepiyǝ wǝ?»<verse eid="LUK 20:44" /></para>
  <para style="s">Yesu le ci la kaŋ no otukarǝtǝpǝ lo ru rǝ oworokosekaŋtǝpǝ lo oŋuŋkǝ</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matewu 23:1-36</ref>, <ref loc="MRK 12:38-40">Marǝko 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Kǝkpǝŋkǝ we kpǝlo kɩɩkɩ kǝ ko ŋ co kǝtukoŋkǝ rǝ Yesu. Wǝ́ Yesu ŋ ke ŋ tíi no otukarǝtǝpǝ, rǝ enyipǝ we le enimiyǝ ǝkǝnǝŋ: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />«Nǝ yee yurǝ rǝ esekaŋtǝpǝ lǝ kpǝŋ. Pǝ láa taa pǝ ŋ kpii wǝkpakpurumukpǝ pǝ ŋ siri pǝ ŋ tɛlɩ. Wǝ́ pǝ láa taa enyipǝ pǝ ŋ pɛɛlɩ pǝ ŋ ceeni pǝ rǝ acanɩtiyǝ. Pǝ láa taa pǝ ŋ tii rǝ omumuŋpǝ la afɛɛtiiyǝ rǝ okumwɛŋnyuŋyǝ mǝ afɛɛtiiriyǝ. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Ŋpǝ pǝ lée sisi ekpeetiepǝ pǝ ŋ lɔ pǝlo otuyǝ kɩɩkɩ. Pǝ kah ya pǝ ŋ mwɛŋ nyuŋkpǝ, o lóo ko ǝrǝ fǝŋ, kǝ ǝ pǝ, pǝ faa lɛ. Pǝ láa kʊrʊ pǝ ŋ yee wǝ pǝ ŋ kaŋ enyipǝ kǝ pǝ nyɩŋ pǝ. Worokoyǝ lah pa ta pǝlo kǝtukoŋkǝ ŋpa ŋ teeri enyituturupǝ.»<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Riariatǝkpeetieyǝ rɛ lo koonu sɩkayǝ le teeri enyituturupǝ</para>
  <para style="r">(<ref loc="MRK 12:41-44">Marǝko 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Kǝ́ Yesu ŋ ne pe yiili ŋ na yɩrɩ we, wǝ́ ŋ nyɩnɩ kǝ́ asɩkalǝtǝpǝ pǝ ya pǝ lóo ko pǝ ŋ kpii sɩkayǝ rǝ kǝsiɛkǝ we pǝ lée kpii sɩkayǝ rǝ Worokoyǝ la nyarǝwǝ. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Wǝ́ ŋ nyɩnɩ riariatǝkpeetieyǝ rɛ ŋwǝ ŋkpɛ le ke kpii sɩkakpotokpotoyǝ yi. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, riariatǝkpeetieyǝ sa le kpii sɩkayǝ le teeri nyi ri ŋ nyi. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Duturǝ ɖi enyituturupǝ sa kpǝlo kɩɩkɩ we, pǝla sɩkayǝ we ŋ no to pǝ ŋ no turu wǝ́ pǝ lǝ fǝ pǝ le pe kpii. Paa kpeetieyǝ sa ŋwǝ we, mǝŋ na ariaayǝ paape, lǝ fǝ tuwǝ we kɩɩkɩ ŋ na tɛɛ kpɛɛwǝ ŋ tini lo po kuŋ.»<verse eid="LUK 21:4" /></para>
  <para style="s">Yesu la wɛɛlɩ lo ru rǝ Worokoyǝ la nyarǝwǝ la awɔɔkǝ</para>
  <para style="r">(<ref loc="MAT 24:1-2">Matewu 24:1-2</ref>, <ref loc="MRK 13:1-2">Marǝko 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Enyipǝ rɛ pǝ yà pǝ ka ŋ tɛɛrɩ pǝ ŋ raarǝ Worokoyǝ la nyarǝwǝ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Nyarǝwǝ sa wǝ lóo poŋ ayɩrɩ. Pǝ lǝ fǝ orukpatɩyǝ pǝ la tɔ wǝ, fǝ kʊla mǝ enyipǝ lo otuceeceeyǝ we pǝ lo koonu Worokoyǝ.» <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />Paa wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ya nǝ nyáa nyɩŋ otuyǝ sa? Jirǝ rɛ gbii lǝ́ǝ pǝ ɖurǝ rɛ mǝŋ jeŋceŋ lǝŋ po tuuru dɛɛ rǝ ɖupʊŋpwarǝ rɛ. Pǝ lée re yǝ pǝ co kpǝlo kɩɩkɩ.»<verse eid="LUK 21:6" /></para>
  <para style="s">Otuyǝ we yǝ lǝh pǝ yǝ coŋ yǝ koonu ǝrǝkǝ la alɛɛkǝ wǝ</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matewu 24:3-14</ref>, <ref loc="MRK 13:3-13">Marǝko 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Wǝ́ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, eniyǝ rǝ fǝŋ wǝ́ tuwǝ sa wǝ lǝh pǝ wǝ? Kǝ́ wǝ́ yǝ lǝ́ǝ fǝ la nyɩŋ le ci ǝkǝnǝŋ tuwǝ sa le eniyǝ yǝ lǝ kǝlǝ wǝ?» <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ yee yurǝ. Nǝ paa maa rɛ ŋ tǝǝnǝ nǝ. Duturǝ ɖi enyipǝ wa pǝ loh po ru, kǝ pǝ fǝ mǝ nyɩŋrǝ pǝ kpii pǝla wɛ, kǝ yǝ mǝ yǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋmǝ ŋ́ ri Mesiyayǝ we, wǝ́ eniyǝ yǝ lo ro.” Nǝ pee siimǝ pǝ. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Vǝ́ nǝ nyoh po nuŋ pǝ ya pǝ láa wɛɛlɩ pǝ ŋ ru rǝ akɔŋkǝ, wǝ́ enyipǝ pǝ le yi pǝ la tɛɛ rǝ pǝle epilipǝ we, turuwǝ wǝ paa nyaa nǝ mɛŋwǝ. Wǝ kpii kǝ tuwǝ sa wǝ pǝ wǝ coonu. Paa wǝ lǝŋ maa wǝ ri ǝrǝkǝ sa la alɛɛkǝ.» <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ǝkǝŋyǝ yǝ leh pe yi yǝ tɛɛ rǝ awɛ, kǝ epilipǝ pǝ yi pǝ tɛɛ rǝ awɛ. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Kǝtǝǝwǝ wǝ leh mǝ tikili ŋpa rǝ afɛɛ mǝ afɛɛyǝ. Kǝtɛŋkǝ mǝ anyarǝpirɔɔrɔɔyǝ yǝ loh po ru. Otumumuŋyǝ yǝ lóo co vurǝ yǝ lah mǝ nyɩnɩ rǝ oŋuŋkǝ, kǝ vurǝ vii enyipǝ ŋpa.»<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />Paape kpɛŋ kǝ otuyǝ sa yǝ pǝ pǝ we, pǝ lah pa lɔɔlʊ nǝ kǝ pǝ pieeli nǝ. Kǝ pǝ fǝ nǝ pǝ ko Oyudatǝpǝ lo okumwɛŋnyuŋyǝ pǝ ka tɛŋ akpaŋyǝ mǝ nǝ. Kǝ pǝ taŋ nǝ. Mǝ yurǝ kǝto pǝ loh po ko mǝ nǝ rǝ epilipǝ mǝ ǝkǝŋyɩrɩtǝpǝ lǝ kpǝŋ, <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />kǝ nǝ nya fɛɛ nǝ ri ɖaŋsieyǝ nǝ ru rǝ mǝ. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Nǝ ci wǝ sǝsiɛrɩ ǝkǝnǝŋ wǝ lǝǝ pǝ́ kǝ nǝ kpaka dierǝ we nǝ nyah ka tɛŋ nǝ pɛɛnɩ nǝ wɛ wǝ. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Ŋmǝŋmǝ ŋ́ noh mǝ koonu nǝ eciatɛŋkǝ. Vǝ́ nǝ nya wɛɛlɩ we, nǝ ǝkǝǝkpǝlǝtǝpǝ la rɛ lǝŋ tǝ ŋ nya dierǝ rɛ ŋ tɛŋ. Amaa rɛ lǝŋ koru atɛŋ ŋ teeri nǝ. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Nǝ ǝtǝpǝ mǝ nǝ eleepǝ ǝkǝŋtǝ, nǝ apaanʊpǝ, nǝ otuulupǝ mǝ nǝ ǝtǝŋpǝ pǝ lǝ́ǝ fǝ nǝ pǝ kpii enyipǝ rǝ akaakǝ, kǝ pǝ wʊʊlʊ enyipǝ ŋpa rǝ nǝ mǝrǝ. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Mǝ yurǝ kǝto, enyipǝ kpǝlo kɩɩkɩ pǝ lǝh mǝ kpǝlǝ nǝ kǝǝwǝ. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Paape, nǝ kǝyurookǝ mǝŋ kǝceŋceŋ kǝ lǝŋ lǝǝ. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Nǝ tɔ nǝ yaa ŋpa. Kǝ́ nǝ nyée yee kǝ nǝ pɔrʊ nǝ wɛ la vɔrʊrǝ wǝǝ.<verse eid="LUK 21:19" /></para>
  <para style="s">Yesu la tɛŋ Yerusalɛmǝ la awɔɔkǝ</para>
  <para style="r">(<ref loc="MAT 24:15-21">Matewu 24:15-21</ref>, <ref loc="MRK 13:14-19">Marǝko 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Wǝ́ Yesu ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Vǝ́ nǝ nyah pa nyɩŋ akɔŋtǝpǝ pǝ lo co pǝ lǝ kǝrǝŋ Yerusalɛmǝ we, kǝ nǝ ci wǝ ǝkǝnǝŋ na awɔɔkǝ le eniyǝ yǝ lǝ kǝlǝ. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Rǝ eniyǝ we lǝ mǝrǝ we, epǝ we pǝ kpii rǝ Yudeya we, pǝ suu pǝ ŋ ko otutupiyǝ. Epǝ we pǝ kpii rǝ Yerusalɛmǝ we, pǝ ru pǝ pwɛyɩ, kǝ epǝ we pǝ kpii rǝ wǝtɛɛkpǝ we, pǝ pǝǝ tǝ pǝ siɛnɩ pǝ pǝ tǝŋtǝǝwǝ. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Duturǝ ɖi eciyǝ we mǝrǝ wǝ́ Worokoyǝ ŋ nah ta nǝ kǝkpǝŋkǝ lo kǝtukoŋkǝ, kǝ tu ri ŋ tu pǝ la ŋʊrʊ pǝ lǝ tǝnǝ wǝ nya fɛɛ wǝ pǝ. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Okuluretǝpǝ mǝ epǝ we pǝ re epipǝ pǝ láa mɛɛnɩ rǝ ŋyǝ eciyǝ we mǝrǝ we, pǝla paapɔ mǝ pǝla aria! Duturǝ ɖi enyipǝ pǝ láa cʊʊrʊ ŋpa rǝ gǝŋrǝ sa. Worokoyǝ la kpɛɛmʊrʊwǝ wǝ láa sʊʊ rǝ kǝkpǝŋkǝ sa. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Pǝ láa wʊʊlʊ arɛɛpǝ mǝ atʊkʊyǝ. Pǝ láa lɔ otuturupǝ pǝ ko ɖɔŋpirǝ rǝ ǝkǝŋtuturuyǝ, kǝ epǝ we pǝ lee ri Oyudatǝpǝ pǝ wɔɔ Yerusalɛmǝ kpǝlo kɩɩkɩ, ko ro eniyǝ we Worokoyǝ ŋ nǝ tǝnǝ pǝ wǝ.»<verse eid="LUK 21:24" /></para>
  <para style="s">Yesu la wɛɛlɩ lo ru rǝ Nyɩmaasɩ le Pi lǝ ǝpǝkǝ</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matewu 24:29-31</ref>, <ref loc="MRK 13:24-27">Marǝko 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />Enyipǝ pǝ lah pa nyɩŋ otuyǝ yǝ lóo co vurǝ rǝ cɔkɔŋyǝ, kɛɛnyɔŋyǝ mǝ wǝŋɔŋkpǝ. Enyipǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ pǝ láa cɩɩlɩ, kǝ pǝ ŋ kǝǝnǝ ŋpa rǝ apʊyǝ la kɔɔrʊwǝ mǝ na alʊlʊyǝ kǝto. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Okopiyǝ we yǝ kpii rǝ oŋuŋkǝ yǝ lée tikili. Enyipǝ pǝ loh mǝ pu yurǝ pǝ ŋ ru rǝ tuwǝ we wǝ lǝh pǝ wǝ pǝ pǝ rǝ kǝtǝǝwǝ wǝ. A láa nyɩŋ pǝ lǝh kpǝ́ yiriri mǝ vurǝ. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Rǝ eniyǝ we lǝ mǝrǝ we, pǝ láa nyɩŋ kǝ́ Nyɩmaasɩ le Pi ŋ no ru ŋ nǝ́ǝ pǝ rǝ ŋɔɔrǝ, mǝ okopimumuŋyǝ mǝ wǝnyɩɩnɩkpǝ. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Vǝ́ otuyǝ sa yǝ le tie ǝpǝkǝ we, nǝ toolu nǝ tii kǝ nǝ ta nǝ wɛ. Duturǝ ɖi eniyǝ we Worokoyǝ ŋ nah pɔrʊ nǝ yǝ lǝ kǝlǝ.<verse eid="LUK 21:28" /></para>
  <para style="s">Wǝ kaamǝ kǝ enyipǝ pǝ ci eniyǝ we Worokoyǝ ŋ neh ri wǝpilikpǝ wǝ</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matewu 24:32-35</ref>, <ref loc="MRK 13:28-31">Marǝko 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Wǝ́ Yesu ŋ cà pǝ lo duturǝ ǝkǝnǝŋ: «Nǝ yɩrɩ wǝcookpǝ mǝ ecituturuyǝ kpǝlo kɩɩkɩ re. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Vǝ́ nǝ nya nyɩŋ yǝ loh ru eweŋwɛŋyǝ we, ŋnǝŋnǝ nǝ nyée ci wǝ ǝkǝnǝŋ aŋʊŋtɛniyǝ yǝ lǝ kǝlǝ. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Kaa wǝǝ ŋnǝ ŋkpɛ, vǝ́ nǝ nya nyɩŋ otuyǝ sa yǝ ya yǝ lǝ́ǝ pǝ we, kǝ nǝ ci wǝ ǝkǝnǝŋ Worokoyǝ le wǝpilirikpǝ le eniyǝ yǝ lǝ kǝlǝ. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />Ŋ́ ya ŋ́ née tíi nǝ wǝ rǝ anʊkɔrǝyǝ we, rǝkǝsa le enyipǝ pǝ lǝŋ pǝ kpǝ́ pǝ lɛ kpɛŋ kǝ otuyǝ sa kpǝlo kɩɩkɩ yǝ ci ǝpǝ. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Yulaarǝ mǝ kǝtǝǝwǝ yǝ lah pa tɛlɩ. Paa mǝ etieyǝ yǝ lǝŋ pa tɛlɩ kʊrakʊra.»<verse eid="LUK 21:33" /></para>
  <para style="s">Yesu le ci la kaŋ enyipǝ pǝ kpaka pǝ tii mǝ ǝrǝŋkǝ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />«Nǝ yee yurǝ. Nǝ pee kpii nǝ koonu erikǝ mǝ ǝfǝŋŋuŋpǝ mǝ vɔrʊrǝ sa lǝ kǝǝnǝwǝ rǝ ko. Mǝŋ ŋkǝ kaa wǝǝ we, Nyɩmaasɩ le Pi le jirǝ we ŋ nǝ́ǝ pǝ, loh po somu nǝ rǝ. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Mǝŋ kǝ́ kpɛrɛwǝ wǝ lóo somu kɛɛyǝ kǝtǝ we, kǝ́ jirǝ we loh po somu enyipǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ wǝǝ. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Kǝto nǝ paa kpɛɛ eniŋrieyǝ. Nǝ paa wɛ mǝ nyuŋmwɛŋwǝ. Eniyǝ we nǝ nyáa nya okopiyǝ nǝ tɔ nǝ yaa rǝ otuyǝ sa kpǝlo kɩɩkɩ yǝ lǝh pǝ pǝ lǝ mǝrǝ, kǝ nǝ koru aka yaa rǝ Nyɩmaasɩ le Pi la kǝnyɩŋkǝ.» <verse eid="LUK 21:36" /><verse number="37" style="v" sid="LUK 21:37" />Vǝ́ kǝ la kaalǝ we, Yesu ŋ mǝ kaŋ otuyǝ rǝ Worokoyǝ la nyarǝwǝ. Ɖiɔrǝ we, ŋ mǝ ko ŋ ka kpɛɛ rǝ dutupirǝ we pǝ lóo pwo «Oliviepǝ lo dutupirǝ.» <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Enyipǝ kpǝlo kɩɩkɩ pǝ kǝ ŋ fǝlǝ eyi pǝ ŋ ko pǝ ŋ tuu ŋwǝ rǝ Worokoyǝ la nyarǝwǝ, kǝ pǝ nya fɛɛ pǝ nuŋ ne etieyǝ.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Pǝ le ri nyuŋkpǝ pǝ la tɛɛ rǝ Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matewu 26:1-5</ref>, <ref loc="MRK 14:1-2">Marǝko 14:1-2</ref>, <ref loc="JHN 11:45-53">Yowanɛsɩ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Kǝ́ eyinyapǝkǝ la wǝcɛkpǝ pǝ lǝ́ǝ tǝ pǝ ŋ pwo kpɔnɔyǝ we pǝ lee kpii dafaŋrǝ la wǝcɛkpǝ le eniyǝ yǝ lo ro we, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />wǝ́ otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ pǝ yà pǝ ka ŋ taa kʊŋwǝ kǝ pǝ wʊ Yesu. Paape pǝ yà pǝ ko ŋ suu kǝkpǝŋkǝ we lo vurǝ. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Wǝ́ Satana ŋ fìi Yuda yǝ we pǝ lóo pwo Isǝkario lǝ mǝrǝ. Ke ri enyikpiipǝ we tǝ mǝ eyipǝ le ceŋceŋ. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Wǝ́ Yuda ŋ kolu ŋ rili nyuŋkpǝ mǝ otoolutǝmumuŋpǝ mǝ Worokoyǝ la anyarǝrǝŋtǝpǝ lo omumuŋpǝ, kǝ ŋ pa nya fɛɛ ŋ fǝ Yesu ŋ kpii pǝ rǝ akaakǝ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Wǝ́ pǝ nyà faawǝ ŋpa. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ pǝ loh po koonu na sɩkayǝ. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Wǝ́ Yuda ŋ tɛ̀ɛnɩ. Wǝ́ ŋ ka ŋ taa eniyǝ ŋ náa nya kʊŋwǝ kǝ ŋ fǝ Yesu ŋ kpii pǝ rǝ akaakǝ, kǝ kǝkpǝŋkǝ we kǝ pee ci wǝ.<verse eid="LUK 22:6" /></para>
  <para style="s">Yesu lo kuŋ pǝ la caa eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matewu 26:17-25</ref>, <ref loc="MRK 14:12-21">Marǝko 14:12-21</ref>, <ref loc="JHN 13:21-30">Yowanɛsɩ 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Kpɔnɔyǝ we pǝ lee kpii dafaŋrǝ la wǝcɛkpǝ le jirǝ ɖò. Wǝ ke kpii kǝ pǝ wʊ eyinyapǝkǝ la wǝcɛkpǝ la amɛɛpipǝ mǝ ŋrǝ jirǝ sa. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Wǝ́ Yesu ŋ kpìi Pɛtǝro mǝ Yowanɛsɩ, wǝ́ ŋ tíi pǝ ǝkǝnǝŋ: «Nǝ coŋ nǝ mǝ ko nǝ ka caa eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ kǝ le ri.» <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />Wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Fǝŋ wǝ́ ǝ lǝ́ǝ pǝ́ la ka caa wǝ?» <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Vǝ́ nǝ nye ke fii tǝŋtǝǝwǝ we lǝ mǝrǝ we, nǝ nyoh ko ku mǝ nyiyǝ rɛ re mɛŋwǝ mǝ wǝpwɛŋkpǝ. Nǝ siimǝ ŋwǝ nǝ mǝ ko nyarǝwǝ we ŋ noh ko wǝ. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Kǝ nǝ ke tíi nyarǝlǝtǝyǝ we ǝkǝnǝŋ: “Tukaŋtǝyǝ le kpii lǝ lǝ pǝ pǝ́ lǝ́ ǝkǝnǝŋ, gukpǝ we ŋ neh pe tii ŋ ri eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ ŋpǝ mǝ no otukarǝtǝpǝ pa?” <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Eniyǝ we láa kaŋ nǝ guyɔkɔɔkpǝ rɛ rǝ baŋsʊrʊyǝ. Tu ri ŋ tu wǝ kpɛlɩ rǝ gukpǝ we. Fɛɛwǝ nǝ nyah ka caa keeriwǝ we wǝǝ.» <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />Wǝ́ pǝ ko ŋ ko. Wǝ́ pǝ kolu pǝ nyɩnɩ tu ri ŋ tu mǝŋ kǝ́ Yesu ŋ tìi pǝ wǝ. Wǝ́ pǝ càa eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ we.<verse eid="LUK 22:13" /></para>
  <para style="s">Keerikenikeniwǝ</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matewu 26:26-30</ref>, <ref loc="MRK 14:22-26">Marǝko 14:22-26</ref>, <ref loc="1CO 11:23-25">1 Okorɛŋtotǝpǝ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Kǝ́ eniŋriyǝ yǝ lo ro we, wǝ́ Yesu ŋ kolu ŋ tini ŋpǝ mǝ ne enyikpiipǝ we. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ nǝ pǝ́ wǝ ŋpa ŋ́ ri eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ sa mǝ nǝ kpɛŋ, kǝ ŋ́ ci apa cʊʊrʊ. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Duturǝ ɖi, ŋ́ ya ŋ́ née tíi nǝ wǝ, ŋ́ nǝŋ tǝ ŋ́ pe ri keeriwǝ sa po ro eniyǝ we Worokoyǝ ŋ nah pa pɔrʊ wǝ lo duturǝ mǝ eniyǝ we ŋ neh pe ri wǝpilikpǝ wǝ.» <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />Kǝ́ ŋ na wɛɛlɩ ŋ na lɛ we, wǝ́ ŋ fǝ̀ vɛŋyǝ mǝ kɔpʊwǝ, wǝ́ ŋ cèeni Worokoyǝ. Wǝ́ ŋ tìi enyikpiipǝ we ǝkǝnǝŋ: «Nǝ lɔ vɛŋyǝ sa nǝ ŋuŋ nǝ kpǝlo. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Duturǝ ɖi, ŋ́ ya ŋ́ née tíi nǝ wǝ, fǝ rǝkǝsa mǝ ko we, ŋ́ nǝŋ tǝ ŋ́ po ŋuŋ vɛŋ ko ro eniyǝ we Worokoyǝ le wǝpilikpǝ we wǝ lǝ́ǝ pǝ wǝ.» <verse eid="LUK 22:18" /><verse number="19" style="v" sid="LUK 22:19" />Wǝ́ ŋ fǝ̀ kpɔnɔyǝ. Kǝ́ ŋ ne ceeni Worokoyǝ ŋ na lɛ we, wǝ́ ŋ pò ŋwǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kòonu pǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Kpɔnɔyǝ sa ŋ kaamǝ mǝ kǝwɛlɛŋkakǝ pǝ lǝ fǝ pǝ loh koonu Worokoyǝ rǝ nǝ yurǝ. Nǝ mǝ yee tuwǝ sa mǝŋkǝsa kǝ nǝ mǝ fǝ nǝ mǝ taalǝ mǝ.» <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Kǝ́ pǝ le ri pǝ la lɛ we, wǝ́ ŋ tǝ fǝ̀ vɛŋyǝ mǝ kɔpʊwǝ ŋ kòonu pǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Vɛŋyǝ sa ŋ kpii rǝ kɔpʊwǝ sa ŋ kaamǝ Worokoyǝ mǝ nǝ kǝkpǝŋkǝ le dieŋwɛŋrǝ pǝ la parǝ pǝ lǝ tǝnǝ wǝ. Duturǝ ɖi, mǝ ŋpǝrayǝ lah lʊ rǝ nǝ yurǝ. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Nǝ nyǝŋ nyɩŋ, nyiyǝ we ŋ nǝh fǝ̀ mǝ ŋ kpii enyipǝ rǝ akaakǝ tini rǝ fɛɛwǝ sa lée ri mǝ mǝ. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ŋ́ cii wǝ ǝkǝnǝŋ Nyɩmaasɩ le Pi lǝ́ǝ kpǝ́ mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ wǝ kǝtǝ. Paa yǝ we ŋ nǝ fǝ ŋwǝ ŋ ne kpii enyipǝ rǝ akaakǝ we, yǝ we na paapɔ mǝ na aria.» <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Wǝ́ otukarǝtǝpǝ we pǝ yili pǝ kǝ ŋ pǝ́ awɛ le etieyǝ kǝ pǝ ci yǝ we ŋ neh yee tuwǝ sa kǝtǝŋkǝ wǝ. <figure style="fig" alt="Dernier repas de Jésus avec ses disciples" file="DN00489b.tif" size="col" copy="Darwin Dunham" ref="22:19">Yesu le ri ne keerituturuwǝ mǝ no otukarǝtǝpǝ</figure><verse eid="LUK 22:23" /></para>
  <para style="s">Ǝlǝ ŋ ri mumuŋyǝ?</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Wǝla kǝmaakǝ we, wǝ́ otukarǝtǝpǝ we pǝ yà pǝ ke ŋ tiini etieyǝ mǝ awɛ kǝ pǝ ci yǝ we ŋ nóo koru eri mumuŋyǝ rǝ pǝlǝ mǝrǝ wǝ. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Epilipǝ pǝ ya pǝ lée ri wǝpilikpǝ rǝ ǝkǝŋyǝ, wǝ́ pǝ la rɛ pǝ la tɛɛ rǝ enyipǝ, wǝ́ okopilǝtǝpǝ rǝ ǝkǝŋyǝ pǝ lǝ́ǝ pǝ́ enyipǝ pǝ ŋ pwo pǝ ǝkǝnǝŋ: “Eceeceeyeetǝpǝ”. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ŋnǝ paa we, nǝ pee yee wǝ ǝnǝ. Paa yǝ we ŋ ri mumuŋyǝ rǝ nǝ mǝrǝ we, ŋ fǝ na wɛ ŋ yee mǝŋ laatieyǝ kǝtǝ. Kǝ yǝ we ŋ re kǝkpǝŋkǝ we, ŋ fǝ na wɛ ŋ yee mǝŋ sʊmatǝyǝ kǝtǝ. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Rǝ yǝ we ŋ ya ŋ nǝ́ǝ sǝpǝ keeriwǝ mǝ yǝ we ŋ tini ŋ née ri rǝ kpǝlɔyǝ wǝǝ, ǝlǝ ŋ ri mumuŋyǝ? Mǝŋkǝ yǝ we ŋ tini rǝ kpǝlɔyǝ ŋ née ri wǝ? Ŋmǝ paa we, ŋ́ kpii rǝ nǝ mǝrǝ mǝŋ yǝ we ŋ ya ŋ nǝ́ǝ sǝpǝ keeriwǝ kǝtǝ. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Ŋnǝ we, nǝ ri epǝ we pǝ la nyɩɩ pǝ siimǝ mǝ rǝ acʊcʊʊrʊpiyǝ lǝ mǝrǝ. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Tuwǝ kǝto ŋ́ nóo koonu kǝ nǝ ri wǝpilikpǝ mǝ mǝ mǝŋ kǝ́ mǝ Tǝ ŋwǝ ŋkpɛ ŋ no koonu ŋ́ ri wǝpilikpǝ mǝ ŋwǝ kǝtǝ. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Eniyǝ we ŋ́ neh pe yi mǝ ŋ ri wǝpilikpǝ we, ŋlǝ mǝ nǝ yǝ leh pe tii le ri kǝ lo ŋuŋ rǝ fɛɛwǝ ceŋceŋ. Kǝ nǝ lɛ nǝ pe tii rǝ epilisaayǝ nǝ tɛŋ wǝkpaŋkpǝ mǝ Isǝrayɛlǝ lǝ ǝkpǝŋtǝmeyiyǝ we.»<verse eid="LUK 22:30" /></para>
  <para style="s">Yesu la tɛŋ ǝkǝnǝŋ Pɛtǝro lǝ́ǝ pǝ sǝ́ŋ ŋwǝ ŋ co</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matewu 26:31-35</ref>, <ref loc="MRK 14:27-31">Marǝko 14:27-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yesu tìi Sɩmɔ ǝkǝnǝŋ: «Sɩmɔ, Sɩmɔ, nuŋ, Satana lǝ pǝ́ kʊŋwǝ kǝ ŋ fɛɛ nǝ mǝŋ kǝ́ pǝ láa fɛɛ wǝfaakpǝ kǝtǝ. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Paape ŋ́ na mwɛŋ nyuŋkpǝ ŋ́ no koonu lǝ́, kǝ a paa pa nyarǝ lá lɔnuŋrǝ o co. Mǝŋkɔɔwe we, vǝ́ a la siɛnɩ o lo po tuu mǝ we, kǝ e kpii lá apaanʊpǝ la wɛɛlɛŋwǝ.» <verse eid="LUK 22:32" /><verse number="33" style="v" sid="LUK 22:33" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ na tɛɛnɩ ŋ́ siimǝ lǝ́ ŋ́ ko gukpɛɛkpǝ kǝ pǝ lɛ pǝ wʊ le eyi faa.» <verse eid="LUK 22:33" /><verse number="34" style="v" sid="LUK 22:34" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pɛtǝro, ŋ́ ya ŋ́ née tíi lǝ́ wǝ, ǝ lǝ́ǝ sǝ́ŋ mǝ pǝrǝŋwǝ kǝta ruŋruŋ kpɛŋ kǝ kʊkɔyǝ ŋ ci ǝsǝŋ ǝkpǝǝkǝ».<verse eid="LUK 22:34" /></para>
  <para style="s">Nǝ fǝ nǝ zɩkalotorǝ, akpoyǝ mǝ nǝ tʊkʊwǝ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ ŋ́ kpìi nǝ nǝ ke yee kǝnǝnɛkǝ, wǝ́ ŋ́ tìi nǝ nǝ pee re zɩkalotorǝ, akpoyǝ mǝ afʊkpayǝ wǝǝ, tǝrɛ wǝ kolu wǝ yeli nǝ ariaayǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Tǝrɛ wǝ lee yee lǝ aria» <verse eid="LUK 22:35" /><verse number="36" style="v" sid="LUK 22:36" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Paape rǝkǝsa we, yǝ we ŋ lǝǝmǝ zɩkalotorǝ we, ŋ fǝ rǝ. Yǝ we ŋ lǝǝmǝ akpoyǝ we, ŋ fǝ yǝ. Yǝ we ŋ nǝǝ lǝmǝ tʊkʊwǝ we, ŋ siiri na kǝkpakǝ, kǝ ŋ fǝ ŋ ko fuu tʊkʊwǝ. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Ŋ́ ya ŋ́ née tìi nǝ tuwǝ sa, duturǝ ɖi pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ: “Enyipǝ pǝ lǝ kǝ ŋwǝ pǝ la kʊla mǝ enyiwʊʊlʊtǝpǝ.” Kǝto wǝ kaamǝ kǝ otuyǝ sa yǝ pǝ yǝ tuu mǝ. Duturǝ ɖi tuwǝ sa pǝ la ŋʊrʊ rǝ mǝ oŋuŋkǝ we, wǝ lǝh pǝ.» <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />Wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, le re tʊkʊwǝ yi.» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ la ka ǝnǝ».<verse eid="LUK 22:38" /></para>
  <para style="s">Yesu ya láa mwɛŋ nyuŋkpǝ rǝ dutupirǝ we pǝ lóo pwo Oliviepǝ lo dutupirǝ</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matewu 26:36-46</ref>, <ref loc="MRK 14:32-42">Marǝko 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yesu rù ko ŋ ko Oliviepǝ lo dutupirǝ mǝŋ kǝ́ ŋ née ce mǝ ŋ yee wǝ kǝtǝ. Wǝ́ no otukarǝtǝpǝ pǝ siimǝ ŋwǝ. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Kǝ́ pǝ le ke fii fɛɛwǝ we we, wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ mwɛŋ nyuŋkpǝ, kǝ Satana ŋ paa nya fɛɛ kpii nǝ gbǝǝrǝ.» <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Wǝ́ ŋ pwɛ̀yɩ rǝ pǝlǝ kpǝŋ ŋ kolu ŋ yàa rǝ nɔ mǝŋ wǝnukpǝ tǝ mǝ wǝyi kǝtǝ. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ ŋ ka ŋ mwɛŋ nyuŋkpǝ <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />mǝ ŋ tɛŋ ǝkǝnǝŋ: «Mǝ Tǝ, mǝŋ a la tɛɛnɩ we, paa maa kǝ acʊcʊʊrʊpiyǝ sa yǝ pǝ mǝ oŋuŋkǝ. Paape yee rǝ ŋlǝ́ŋlǝ́ lǝ́ kǝǝpǝ́wǝ, pee yee rǝ mǝ nɛŋwǝ.» <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Wǝ́ picoŋpiyǝ rɛ ŋ rù rǝ yulaarǝ ŋ pǝlǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ kǝ ŋ kpii no okopiyǝ. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Yesu fii vurǝ mǝ kǝǝnǝwǝ ŋpa. Wǝ́ ŋ tǝ ŋ mwɛnɩ nyuŋkpǝ mǝ okopiyǝ ŋpa. Wǝ́ na naawʊrǝ we ga ŋ sʊʊ ŋwǝ lǝ ŋ tɔɔlʊ rǝ kǝtǝǝwǝ bǝlǝ ziɛrɩ mǝŋ ŋpǝrayǝ kǝtǝ. <verse eid="LUK 22:44" /><verse number="45" style="v" sid="LUK 22:45" />Kǝ́ ŋ na mwɛŋ nyuŋkpǝ ŋ na lɛ we, wǝ́ ŋ yili. Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ otukarǝtǝpǝ we lǝ kpǝŋ. Wǝ́ ŋ nyɩnɩ pǝ la kpɛɛ eniŋrieyǝ mǝ tǝlarǝ mǝ tǝlarǝ. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyáa kpɛɛ wǝ? Nǝ yi kǝ nǝ mwɛŋ nyuŋkpǝ kǝ nǝ paa nya fɛɛ nǝ fii rǝ gbǝǝrǝ.»<verse eid="LUK 22:46" /></para>
  <para style="s">Pǝ la pa lɔ Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matewu 26:47-56</ref>, <ref loc="MRK 14:43-50">Marǝko 14:43-50</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Kǝ́ Yesu ŋ tǝ ŋ ya ŋ náa wɛɛlɩ we, wǝ́ nyikpǝŋwǝ rɛ wǝ pǝlǝ wǝ rù. Enyikpiitǝmeyipǝ we le ceŋceŋ pǝ lóo pwo Yuda ŋ ko conu mǝ pǝ. Wǝ́ ŋ rù ŋ kǝ̀lǝ mǝ Yesu, wǝ́ ŋ pùru ŋwǝ. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Yuda, o lo po puru Nyɩmaasɩ le Pi kǝ ǝ fǝ ŋwǝ e kpii ǝkǝǝkpǝlǝtǝpǝ rǝ akaakǝ rǝ?» <verse eid="LUK 22:48" /><verse number="49" style="v" sid="LUK 22:49" />Kǝ́ epǝ we pǝ ke siimǝ Yesu pǝ la nyɩŋ tuwǝ wǝ lǝh pǝ wǝ tuu Yesu we, wǝ́ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, amaa kǝ le sieni pǝ la atʊkʊyǝ?» <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Wǝ́ pǝle ceŋceŋ ŋ fǝ̀ tʊkʊwǝ ŋ furu toolutǝmumuŋyǝ la sʊmatǝyǝ. Wǝ́ ŋ wàarǝ ne kǝniritukoŋkǝ. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pee yee, nǝ maa pǝ.» Wǝ́ Yesu ŋ fǝ̀ akaakǝ ŋ rù nyiyǝ we lo kǝtukoŋkǝ wǝ́ ŋ cà ŋwǝ. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />Wǝ́ Yesu ŋ tìi otoolutǝmumuŋpǝ, Worokoyǝ la nyarǝwǝ lǝ ǝrǝŋtǝpǝ lo omumuŋpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ we pǝ pǝlǝ pǝ pa lɔ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nyǝ pǝ mǝ atʊkʊyǝ mǝ eleŋkpeyǝ nǝ pa lɔ mǝ, mǝŋ yɩlayɩtǝyǝ rɛ wǝ́ ŋ́ ri kǝtǝ wǝ? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Ji ri ŋ ji yǝ láa nyɩŋ awɛ rǝ Worokoyǝ la nyarǝwǝ, paape nǝ nyaa lɔ mǝ rǝ fɛɛwǝ we. Paape eniyǝ sa we yǝ ri eniceeceeyǝ yǝ koonu ŋnǝ mǝ nuŋtumuwǝ lo okopiyǝ.»<verse eid="LUK 22:53" /></para>
  <para style="s">Pɛtǝro la cwɩɩ ǝkǝnǝŋ ŋ nee ci Yesu</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matewu 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>, <ref loc="MRK 14:53-54">Marǝko 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>, <ref loc="JHN 18:12-18">Yowanɛsɩ 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Kǝ́ enyipǝ sa pǝ la lɔ Yesu we, wǝ́ pǝ fǝ̀ ŋwǝ pǝ ko ŋ ko toolutǝmumuŋyǝ la nyarǝwǝ. Wǝ́ Pɛtǝro ŋ sìimǝ pǝ ŋ ko ŋ ko rǝ kǝmaakǝ. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Kǝ́ pǝ le ke fii nyarǝwǝ we we, anyɩŋ enyipǝ rɛ pǝ lo toŋ naawǝ rǝ etikeŋtikǝ we, wǝ́ pǝ tini pǝ ke ŋ wii wǝ. Wǝ́ Pɛtǝro ŋ kolu ŋ tini rǝ pǝlǝ mǝrǝ. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Wǝ́ tieyǝ rɛ ŋ née yee kǝnǝnɛkǝ rǝ nyarǝwǝ we ŋ nyɩnɩ ŋwǝ rǝ naawǝ we la kǝlɛɛrɩkǝ. Wǝ́ tieyǝ sa ŋ yà ŋ ka ŋ yɩrɩ ŋwǝ pʊrɩpʊrɩ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ sa ŋwǝ ŋkpɛ ka kʊla mǝ Yesu.» <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />Wǝ́ Pɛtǝro ŋ cwɩ̀ɩ wǝ, wǝ́ ŋ tìi tieyǝ we ǝkǝnǝŋ: «Ŋ́ nee ci ŋwǝ oo.» <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />Wǝ laa panǝ, wǝ́ nyipʊŋpwayǝ rɛ ŋ nyɩnɩ ŋwǝ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Lá ŋkpɛ a kʊla mǝ Yesu lo otukarǝtǝpǝ.» Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, ŋ́ naa kʊla oo.» <verse eid="LUK 22:58" /><verse number="59" style="v" sid="LUK 22:59" />Rǝ eniyǝ buŋrǝ jeŋceŋ la kǝmaa we, wǝ́ nyipʊŋpwayǝ rɛ ŋ tǝ ŋ ka ŋ nyɩɩ mǝŋ tɛŋ wǝ ǝkǝnǝŋ: «Kǝceece, nyiyǝ sa ka kʊla mǝ ŋwǝ, duturǝ ɖi lo ru rǝ Galileya». <verse eid="LUK 22:59" /><verse number="60" style="v" sid="LUK 22:60" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nee ci dierǝ lǝ ɖǝ a ya láa tɛŋ wǝ». Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ Pɛtǝro ŋ ya ŋ náa wɛɛlɩ we, wǝ́ kʊkɔyǝ ŋ kpǝ̀ǝ. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Wǝ́ Kulǝtǝyǝ Yesu ŋ sìɛrɩ ŋ ka ŋ yɩrɩ Pɛtǝro pʊrɩpʊrɩ. Wǝ́ Pɛtǝro ŋ tàalǝ dierǝ we Kulǝtǝyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝ lǝ́ǝ sǝ́ŋ mǝ pǝrǝŋwǝ kǝta kpɛŋ kǝ kʊkɔyǝ ŋ ci ǝkpǝǝ ruŋruŋ». <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Wǝ́ Pɛtǝro ŋ rù, wǝ́ ŋ weli ŋpa.<verse eid="LUK 22:62" /></para>
  <para style="s">Pǝ la fɛɛpɩ Yesu wǝ́ pǝ la lɛ pǝ lo culu ŋwǝ</para>
  <para style="r">(<ref loc="MAT 26:67-68">Matewu 26:67-68</ref>, <ref loc="MRK 14:65">Marǝko 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Enyipǝ we pǝ kǝ ŋ rǝŋ Yesu we, pǝ yà pǝ ka ŋ mɔɔnʊ ŋwǝ, wǝ́ pǝ lɛ pǝ ko ŋ culu ŋwǝ. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Pǝ kǝ ŋ fǝ tuwǝ pǝ ŋ parǝ na anyɩŋkǝ, oturu pǝ la ca ŋwǝ. Ǝ pǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Nyɩŋ yǝ we ŋ na ca lǝ́ e tíi lǝ.» <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Wǝ́ pǝ kǝ ŋ tǝ pǝ ŋ tíi ne etiepʊŋpwayǝ pǝ ŋ fɛɛpɩ ŋwǝ pǝ ŋ kʊla.<verse eid="LUK 22:65" /></para>
  <para style="s">Pǝ lǝ fǝ Yesu pǝ lo ko Oyudatǝpǝ la fɛɛtɛŋakpaŋyǝ</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matewu 26:59-66</ref>, <ref loc="MRK 14:55-64">Marǝko 14:55-64</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Kǝ́ kǝ la kaalǝ we, wǝ́ Oyudatǝpǝ lo omumuŋpǝ, otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ pǝ pǝlǝ pǝ kù. Wǝ́ pǝ fǝ̀ Yesu pǝ kolu pǝla fɛɛtɛŋakpaŋyǝ. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tíi lǝ, ŋlǝ́ e ri Mesiyayǝ we?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ ŋ́ ne tíi nǝ wǝ we, nǝ nyǝŋ lɔ mǝ nǝ nuŋ. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />Wǝ́ mǝŋ ŋ́ na lɛ ŋ́ nǝ pǝ́ dierǝ rɛ we, nǝ nyǝŋ pǝ kpǝlǝŋ mǝ. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Paape fǝ rǝ ruŋruŋ mǝ ko we, Nyɩmaasɩ le Pi loh ko ŋ ke tii rǝ Woroko Kopilǝtǝyǝ le kǝniritakǝ.» <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />Wǝ́ pǝlo kpǝlo pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «We Worokoyǝ le Piyǝ wǝ́ e ri?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝ nǝ ya nyáa tɛŋ wǝ, Worokoyǝ le Piyǝ wǝ́ ŋ́ ri.» <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Yǝ lǝǝ tǝ lǝ pǝ́ ɖaŋsielǝtǝyǝ! Ŋlǝŋlǝ yǝ lo nuŋ ŋwǝŋwǝ no nyuŋkpǝ le etieyǝ.»<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Pǝ lǝ fǝ Yesu pǝ lo ko kǝŋyɩrɩtǝyǝ Pilato lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matewu 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>, <ref loc="MRK 15:1-5">Marǝko 15:1-5</ref>, <ref loc="JHN 18:28-38">Yowanɛsɩ 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Wǝla kǝmaakǝ we, wǝ́ pǝlo kpǝlo pǝ yili, wǝ́ pǝ fǝ̀ Yesu pǝ ko ŋ ko Pilato lǝ kpǝŋ. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Wǝ́ pǝ kolu pǝ ka ŋ tɛŋ etieyǝ pǝ ŋ tɛɛ rǝ ŋwǝ ǝkǝnǝŋ: «Yǝ lóo ko ru rǝ nyiyǝ sa ya lée kpii lǝh kǝkpǝŋkǝ lo otukoŋyǝ mǝ ŋ tíi pǝ ǝkǝnǝŋ pǝ pǝǝ tǝ pǝ mwara pilimumuŋyǝ we la laŋpooyǝ. Wǝ́ ŋ ya ŋ náa tɛŋ ǝkǝnǝŋ ŋwǝ ŋ ri Mesiyayǝ mǝ piliyǝ.» <verse eid="LUK 23:2" /><verse number="3" style="v" sid="LUK 23:3" />Wǝ́ Pilato ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Ŋlǝ́ e ri Oyudatǝpǝ le piliyǝ?» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ŋlǝ́ a la tɛŋ wǝ.» <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />Wǝ́ Pilato ŋ tìi otoolutǝmumuŋpǝ we mǝ kǝkpǝŋkǝ we ǝkǝnǝŋ: «Ŋ́ naa nyɩŋ turɔɔrɔɔwǝ nyiyǝ sa ŋ ne yee wǝ láa kaamǝ kǝ la tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ kǝ la tɔɔ na bɔrǝ.» <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />Paape wǝ́ enyipǝ we pǝ tǝ pǝ ka ŋ nyɩɩ pǝ ŋ tɛŋ ǝkǝnǝŋ: «Ya lée kpii enyipǝ lo otukoŋyǝ mǝ no otukaŋyǝ, kǝ pǝ yi pǝ tɛɛ rǝ pǝle epilipǝ. Le tie otuyǝ sa la akaŋkǝ rǝ Galileya, wǝ́ ŋ ne siri Yudeya kpǝlo kɩɩkɩ. Wǝ́ rǝkǝsa ŋ ne pe fii ɖǝǝnǝ.»<verse eid="LUK 23:5" /></para>
  <para style="s">Pǝ lǝ fǝ Yesu pǝ lo ko piliyǝ Erodɛsɩ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Kǝ́ Pilato ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Agalileyatǝpǝ wǝ́ nyiyǝ sa ŋ ri?» <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Kǝ́ ŋ na nya ŋ no nuŋ ǝkǝnǝŋ Yesu lo ru rǝ gǝŋrǝ we piliyǝ Erodɛsɩ ŋ náa yɩrɩ we, wǝ́ ŋ cò pǝ la kʊŋ pǝ fǝ Yesu pǝ ko koonu ŋwǝ. Anyɩŋ Erodɛsɩ lǝ pǝ kpii rǝ Yerusalɛmǝ rǝ eciyǝ we. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu nǝ kpǝŋ. Kǝ́ Erodɛsɩ ŋ na nyɩŋ Yesu we, wǝ́ ŋ nyà faawǝ ŋpa. Duturǝ ɖi lo nuŋ pǝ la wɛɛlɩ pǝ lo ru rǝ Yesu, wǝ́ ŋ kǝ ŋ pǝ́ ŋ nyɩŋ ŋwǝ ǝrǝ eniyǝ nɔ, kǝ ŋ rǝŋ mǝŋ la nyɩŋ Yesu we, kǝ ŋ yee tucovurǝ rɛ kǝ ŋ nyɩŋ. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Wǝ́ Erodɛsɩ ŋ pǝ̀ Yesu le etieyǝ ŋpa, paape Yesu lǝǝ kpǝlǝŋ ŋwǝ. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ pǝ ka ya rǝ we. Wǝ́ pǝ yà pǝ ka ŋ nyɩɩ pǝ ŋ tɛŋ etieyǝ mǝ kpɛɛmʊrʊ mǝ kpɛɛmʊrʊ pǝ ŋ tɛɛ rǝ Yesu. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Wǝ́ Erodɛsɩ mǝ no otuusiitǝpǝ pǝ yà pǝ ka ŋ mɔɔnʊ ŋwǝ pǝ ŋ kpii kǝyepukǝ. Wǝ́ pǝ fǝ̀ kǝkpakpatɩkǝ rɛ pǝ kpii ŋwǝ, wǝ́ Erodɛsɩ ŋ tǝ ŋ fǝ̀ ŋwǝ pǝ manǝ Pilato. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Erodɛsɩ mǝ Pilato pǝ laa ka ŋ ta awɛ lǝ kǝǝwǝ mǝ eniyǝ we, paape wǝ́ pǝ sìɛrɩ pǝ yeli epwetapǝ jirǝ we.<verse eid="LUK 23:12" /></para>
  <para style="s">Pilato lo koonu kʊŋwǝ pǝ wʊ Yesu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matewu 27:15-26</ref>, <ref loc="MRK 15:6-15">Marǝko 15:6-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Pilato kù mǝ otoolutǝmumuŋpǝ, ǝtǝŋtǝǝtǝmumuŋpǝ mǝ kǝkpǝŋkǝ. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyǝ fǝ nyiyǝ sa nǝ nyǝ pǝ mǝ kpǝŋ, wǝ́ nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ ya lée kpii enyipǝ lo otukoŋyǝ kǝ pǝ yi pǝ tɛɛ rǝ Oromatǝpǝ lo omumuŋpǝ. Paa kǝ́ ŋ́ nǝ pǝ́ ne etieyǝ rǝ nǝ enimiyǝ we, ŋ́ naa nyɩŋ etieyǝ sa nǝ ya nyáa tɛŋ la rɛ rǝ ŋwǝ. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Erodɛsɩ ŋwǝ ŋkpɛ laa nyɩŋ tǝrɛ rǝ ŋwǝ, wǝ kǝto ŋ na siɛnɩ mǝ ŋwǝ ŋ na maŋ lǝ wǝǝ. Kǝto we, nyiyǝ sa lee yee turɔɔrɔɔwǝ rɛ kǝ o turu wǝ kaamǝ gbɛŋrǝ. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Kǝto ŋ́ noh kuŋ pǝ culu ŋwǝ mǝ fwɛɛpǝlawǝ, kǝ ŋ́ nyarǝ ŋwǝ ŋ́ co.» <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Eyinyapǝkǝ la wǝcɛ ri ŋ cɛ we, wǝ kpii kǝ Pilato ŋ nyarǝ kukpɛɛtǝyǝ rɛ ŋ co<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ wa mǝrǝ.</char></note>. <verse eid="LUK 23:17" /><verse number="18" style="v" sid="LUK 23:18" />Wǝ́ enyipǝ we kpǝlo pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Koonu kǝ pǝ wʊ nyiyǝ sa kǝ a nyarǝ Baraba o co.» <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Pǝ lɔ̀ Baraba pǝ tanǝ, duturǝ ɖi ka kʊla mǝ enyipǝ we pǝ yili pǝ tɛ̀ɛ rǝ Oromatǝpǝ rǝ tǝŋtǝǝwǝ we, wǝ́ ŋ lɛ̀ ŋ wʊlʊ nyiyǝ. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />Pilato kǝ ŋ pǝ́ ŋ nyarǝ Yesu ŋ co. Wǝ kǝto wǝ́ ŋ tǝ ŋ ka ŋ wɛɛlɩ mǝ kǝkpǝŋkǝ we wǝǝ. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Paape wǝ́ pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ! Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ!» <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />Wǝ́ Pilato ŋ tǝ ŋ tìi pǝ kǝtatǝkǝ ǝkǝnǝŋ: «Turɔɔrɔɔwǝ rǝ fǝŋ wǝ́ nyiyǝ sa ŋ ne yee? Ŋ́ naa nyɩŋ turɔɔrɔɔwǝ lǝ wǝ ŋ ne yee kǝ oturu wǝ kaamǝ kǝ ŋ kpǝ́. Kǝto ŋ́ noh kuŋ pǝ culu ŋwǝ mǝ fwɛɛpǝlawǝ kǝ ŋ́ nyarǝ ŋwǝ ŋ́ co.» <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />Wǝ́ pǝ tǝ pǝ yà pǝ ko ŋ woolu kelele pǝ ŋ tɛŋ ǝkǝnǝŋ pǝ kpa Yesu pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ. Wǝ́ pǝlo owoolukǝ we kǝ lɔ̀ fɛɛwǝ we kpǝlo kɩɩkɩ. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Wǝ́ Pilato ŋ pǝlǝ ŋ fanǝ, wǝ́ ŋ tɛ̀ɛnɩ pǝle dierǝ we. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Wǝ́ Pilato ŋ nyàrǝ Baraba ŋ cò. Ŋwǝ wǝ́ enyipǝ we pǝ kǝ ŋ pǝ́ ŋ nyarǝ ŋ co wǝ. Ŋwǝ Baraba ŋ wʊlʊ nyiyǝ, wǝ́ pǝ lɔ̀ ŋwǝ pǝ tanǝ, wǝ́ ŋ lɛ̀ ŋ ka kʊla mǝ epǝ we pǝ yili pǝ tɛ̀ɛ rǝ Oromatǝpǝ wǝ. Wǝ́ ŋ fǝ̀ Yesu paa ŋ kpìi pǝ rǝ akaakǝ, kǝ pǝ fǝ ŋwǝ pǝ ke yee tuwǝ we wǝ ponu mǝ pǝ wǝ.<verse eid="LUK 23:25" /></para>
  <para style="s">Pǝ la kpaa Yesu pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matewu 27:32-44</ref>, <ref loc="MRK 15:21-32">Marǝko 15:21-32</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Kǝ́ otuusiitǝpǝ pǝ lǝ fǝ Yesu pǝ lóo ko we, wǝ́ pǝ kolu pǝ kù mǝ Sɩmɔyǝ rɛ. Lo ru rǝ atɛɛkǝ lǝ́ǝ pǝ. Esirɛnǝtǝpǝ wǝ́ ŋ ri. Wǝ́ pǝ rǝ̀ǝrǝ kpɛtɛkpǝlɛciiwǝ we pǝ tɛ̀ɛ ŋwǝ mǝ okopi mǝ okopi, kǝ ŋ nya fɛɛ ŋ re wǝ ŋ siimǝ Yesu. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Nyikpǝŋmumuŋwǝ rɛ wǝ ke siimǝ Yesu. Mǝŋ etiepǝ we pǝ yà pǝ ke ŋ wee pǝ ŋ nʊmʊ rǝ no yurǝ wǝ. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Wǝ́ Yesu ŋ siɛrɩ ŋ tìi etiepǝ we ǝkǝnǝŋ: «Eyerusalɛmǝtǝtiepǝ sa, nǝ pǝǝ tǝ nǝ wee mǝ. Nǝ mǝ wee nǝ wɛ mǝ nǝ epipǝ bomu. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Duturǝ ɖi eniyǝ yǝ lo furu, pǝ láa pa ya pǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋnǝ ǝlǝǝmǝtǝpǝ, ŋnǝ epǝ we nǝ fee re wǝkulukpǝ nǝ nyɩŋ mǝ epǝ we pǝ faa mɛɛnɩ piyǝ pǝ nyɩŋ we, nǝ nyo co yǝ!” <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Eniyǝ we enyipǝ pǝ lah pa ya pǝ ŋ tíi otutupiyǝ ǝkǝnǝŋ “Nǝ pa tɔɔ nǝ si lǝ”, kǝ pǝ tíi otutupikpaŋyǝ ǝkǝnǝŋ “Nǝ pe sii lǝ”. <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Duturǝ ɖi mǝŋ otuyǝ sa yǝ ya yǝ lǝ́ǝ pǝ yǝ ŋ tuu wǝciikookookpǝ ǝnǝ wǝǝ, nɛ wǝ́ wǝciikpaakpǝ la nɛŋwǝ wǝ lǝ́ǝ lǝ wǝ fǝ?» <verse eid="LUK 23:31" /><verse number="32" style="v" sid="LUK 23:32" />Wǝ́ otuusiitǝpǝ we pǝ lɛ pǝ rè enyipʊŋpwapǝ eyi pǝ pǝlǝ, kǝ pǝ pa wʊʊlʊ pǝ pǝ kʊla mǝ Yesu. Enyiwʊʊlʊtǝpǝ wǝ́ enyipǝ we pǝ ke ri. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Kǝ́ pǝ le pe fii fɛɛwǝ we pǝ lóo pwo ǝkǝnǝŋ «Yufoopiwǝ» we, wǝ́ pǝ kpàa Yesu pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ rǝ fɛɛwǝ we. Wǝ́ pǝ kpàa enyiwʊʊlʊtǝpǝ we ŋpǝ ŋkpɛ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ, ceŋceŋ rǝ Yesu le kǝniritakǝ, ceŋceŋ rǝ na kǝpɛŋtakǝ. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ tǝ, fǝ a cɛɛ pǝ. Duturǝ ɖi pǝ lee ci tuwǝ we pǝ ya pǝ lée yee wǝ.» Wǝ́ Otuusiitǝpǝ we pǝ cò eciyǝ pǝ sǝ̀pǝ Yesu la wǝkpakpǝ. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Kǝkpǝŋkǝ we kǝ ka yaa rǝ fɛɛwǝ we kǝ ka ŋ yɩrɩ. Wǝ́ Oyudatǝpǝ lo omumuŋpǝ we pǝ yà pǝ ka ŋ mɔɔnʊ ŋwǝ pǝ ŋ tɛŋ ǝkǝnǝŋ: «Lo koru enyipʊŋpwapǝ la apɔrʊ. Mǝŋ ŋwǝ ŋ ri Mesiyayǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ we, ŋ pɔrʊ ŋwǝŋwǝ na wɛ kǝ la nyɩŋ.» <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Wǝ́ Otuusiitǝpǝ we ŋpǝ ŋkpɛ pǝ yà pǝ ka ŋ mɔɔnʊ ŋwǝ. Wǝ́ pǝ rù pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ fǝ̀ ǝfǝŋnyarǝpǝ pǝ ko ŋ koonu ŋwǝ ŋ ŋuŋ. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ e ri Oyudatǝpǝ le piliyǝ we, pɔrʊ ŋlǝ́ŋlǝ́ la wɛ kǝ la nyɩŋ.» <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />Wǝ́ pǝ ŋʊ̀rʊ pǝ tɛ̀ɛ rǝ ɖurǝ rɛ rǝ no yuteewǝ ǝkǝnǝŋ: «Nyiyǝ sa ŋ ri Oyudatǝpǝ le piliyǝ». <verse eid="LUK 23:38" /><verse number="39" style="v" sid="LUK 23:39" />Wǝ́ ayɩlayɩtǝpǝ we pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ le ceŋceŋ ŋ yà ŋ ka ŋ fɛɛpɩ ŋwǝ ǝkǝnǝŋ: «Mǝŋ ŋkǝ a ya láa tɛŋ ǝkǝnǝŋ ŋlǝ́ e ri Mesiyayǝ? We pɔrʊ ŋlǝ́ŋlǝ́ lá wɛ, kǝ a pa pɔrʊ ŋla ŋkpɛ ee.» <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />Paape wǝ́ yɩlayɩtǝyǝ lǝ yǝ eni ŋ ka ŋ kpamǝ ŋwǝ ǝkǝnǝŋ: «Ǝ lǝŋ suu Worokoyǝ lo vurǝ? Ŋnǝ mǝ nyiyǝ sa nǝ ya nyáa lɔ tukoŋtawǝ ceŋceŋ. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Ŋlǝ mǝ lǝ́ lo tukoŋtawǝ sa we, wǝ kaa mǝ. Duturǝ ɖi turɔɔrɔɔwǝ we yǝ lee yee lo wǝtoomwarakpǝ wǝ́ la ya yǝ láa lɔ. Paape ŋwǝ paa lee yee turɔɔrɔɔwǝ rɛ.» <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Wǝ́ yɩlayɩtǝyǝ sa ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Yesu, vǝ́ ǝ lǝh pǝ e pe ri wǝpilikpǝ we, kǝ a taalǝ mǝ oo.» <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi lǝ́ wǝ kǝceece, ŋlǝ mǝ lǝ́ yǝ lée fii yulaarǝ<note caller="+" style="f"><char style="fr" closed="false">23:43 </char><char style="ft" closed="false">Yulaarǝ rǝ fɛɛwǝ sa wǝ kaamǝ paradisoyǝ mǝ Kǝhelatǝkǝ.</char></note> ruŋruŋ ruŋruŋ».<verse eid="LUK 23:43" /></para>
  <para style="s">Yesu lǝ ǝkpǝ́kǝ</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matewu 27:45-56</ref>, <ref loc="MRK 15:33-41">Marǝko 15:33-41</ref>, <ref loc="JHN 19:28-38">Yowanɛsɩ 19:28-38</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Kǝ́ cɔkɔŋyǝ ŋ nah ta ŋ tii zaarǝ we, wǝ́ kǝtǝǝwǝ kpǝlo wǝ fìi nuŋtumuwǝ ko ro ǝrǝ ɖiɔrǝ eniyǝ ta. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Duturǝ ɖi cɔkɔŋyǝ nǝnǝ. Wǝ́ nyaŋrǝ we pǝ fǝ̀ pǝ sǝnǝ rǝ Worokoyǝ la nyarǝwǝ làrǝ kpeewǝ yi cɛɛcɛ. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Wǝ́ Yesu ŋ cà narǝwǝ kelele ǝkǝnǝŋ: «Mǝ tǝ, ŋ́ nǝ fǝ mǝ wɛɛrǝ ŋ́ ne kpii lǝ́ rǝ akaakǝ.» Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ kpǝ̀. <verse eid="LUK 23:46" /><verse number="47" style="v" sid="LUK 23:47" />Kǝ́ Romatǝtuusiitǝmumuŋyǝ we ŋ na nyɩŋ tuwǝ sa we, wǝ́ ŋ yà ŋ kǝ ŋ kǝ Worokoyǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: «Nyikʊʊyǝ wǝ́ nyiyǝ sa ŋ ke ri kǝceecee.» <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Wǝ́ nyikpǝŋwǝ we kpǝlo kɩɩkɩ wǝ pǝlǝ wǝ pa yɩrɩ otuyǝ we, wǝ nyɩnɩ tuwǝ we wǝ pǝlǝ wǝ. Wǝ́ pǝ sìɛnɩ pǝ ko ŋ ko mǝ tǝlaarǝ mǝ tǝlaarǝ. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Yesu lǝ ǝtǝŋpǝ kpǝlo kɩɩkɩ mǝ etiepǝ we pǝ sìimǝ ŋwǝ ǝrǝ Galileya pǝ pǝlǝ we, pǝ pǝlǝ pǝ yàa rǝ nɔ pǝ ka ŋ yɩrɩ tuwǝ we wǝ ya wǝ lǝ́ǝ pǝ wǝ. <figure style="fig" alt="Le voile du temple se dechire en deux" file="lb00265c.tif" size="col" copy="Louise Bass" ref="23:45">Nyaŋrǝ we pǝ fǝ̀ pǝ sǝnǝ rǝ Worokoyǝ la nyarǝwǝ làrǝ kpeewǝ yi cɛɛcɛ</figure><verse eid="LUK 23:49" /></para>
  <para style="s">Pǝ lǝ fǝ Yesu pǝ la ka ŋwaa</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matewu 27:57-61</ref>, <ref loc="MRK 15:42-47">Marǝko 15:42-47</ref>, <ref loc="JHN 19:38-42">Yowanɛsɩ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Nyiyǝ rɛ pǝ lóo pwo Yosɛfʊ ka yaa. Nyiyǝ sa rù rǝ Oyudatǝpǝ lǝ tǝŋtǝǝwǝ we pǝ lóo pwo Arimata. Nyiceeceeyǝ mǝ nyikʊʊyǝ wǝ́ ŋ ke ri. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Nyiyǝ sa kǝ ŋ rǝŋ ŋ pa nyɩŋ Worokoyǝ le wǝpilirikpǝ. Ka kʊ̀la mǝ akpaŋtɛŋtǝmumuŋpǝ we la wǝcakukpǝ. Otuyǝ we akpaŋtɛŋtǝtuturupǝ we pǝ tɛnɩ, wǝ́ pǝ yeli we, yǝ loo ko poŋ mǝ ŋwǝ. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Wǝ́ Yosɛfʊ yǝ sa ŋ kolu ŋ nyɩnɩ Pilato, wǝ́ ŋ pǝ̀ nyiǝtǝyǝ we rǝ ŋwǝ. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Wǝ́ ŋ kolu ŋ wàarǝ nyiǝtǝyǝ we rǝ kpɛtɛkpǝlɛciiwǝ ŋ sʊ̀ʊ. Wǝ́ ŋ fǝ̀ kɛlɛlɛyǝ ŋ mìli ŋwǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kolu ŋ ŋwàa rǝ wǝfuŋkpǝ rɛ pǝ nyini rǝ wǝnyaŋkpǝ lǝ mǝrǝ. Pǝ faa ka ŋwaa rɛ rǝ wǝfuŋkpǝ we pǝ nyɩŋ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Firayǝ ŋ kǝ lǝǝwe. Anyɩŋ sabatǝyǝ le jirǝ loh ro. <verse eid="LUK 23:54" /><verse number="55" style="v" sid="LUK 23:55" />Etiepǝ we pǝ sìimǝ Yesu ǝrǝ Galileya we, pǝ sìimǝ Yosɛfʊ pǝ pǝlǝ wǝfuŋkpǝ we la fɛɛwǝ. Wǝ́ pǝ yà pǝ ka ŋ yɩrɩ wǝfuŋkpǝ we mǝ kǝ́ Yosɛfʊ ŋ na kpɛɛlɩ Yesu nǝ fǝ rǝ wǝfuŋkpǝ we lǝ mǝrǝ wǝ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Wǝ́ etiepǝ sa pǝ sìɛnɩ pǝ ko ŋ ko tǝŋtǝǝwǝ. Wǝ́ pǝ kolu pǝ càa apɔŋpǝ mǝ ewefɛŋfɛŋyǝ pǝ tǝ̀nǝ pǝ po ko nuŋ nyiǝtǝyǝ we. Kǝ́ sabatǝyǝ le jirǝ lo ro we, wǝ́ pǝ tini pǝ wɛ̀ mǝŋ kǝ́ seyǝ ŋ na tɛŋ kǝtǝ.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Yesu la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matewu 28:1-10</ref>, <ref loc="MRK 16:1-8">Marǝko 16:1-8</ref>, <ref loc="JHN 20:1-10">Yowanɛsɩ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Kɔsɩrayǝ lo ɖokoŋpirǝ ŋalaŋala we, wǝ́ etiepǝ we pǝ yili pǝ ko ŋ ko vuŋtɔŋrǝ we la fɛɛwǝ. Wǝ́ pǝ fǝ̀ apɔŋfɛŋfɛŋpǝ we pǝ la kpaka pǝ lǝ tǝnǝ pǝ re. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Kǝ́ pǝ le ke fii fɛɛwǝ we we, wǝ́ pǝ nyɩnɩ rɛ lǝ pǝǝlǝ ɖurǝ we pǝ lǝ fǝ pǝ la taŋ wǝfuŋkpǝ we lǝ kǝ tǝnǝ rǝ kǝlɛɛrɩkǝ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Wǝ́ pǝ fìi wǝfuŋkpǝ we lǝ mǝrǝ. Pǝ laa nyɩŋ Kulǝtǝyǝ Yesu le kǝnyiǝtǝkǝ we. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Wǝ́ wǝ yeli pǝ kpǝǝŋ, pǝ lee ci wǝ pǝ lah tɛŋ pǝ ru rǝ tuwǝ sa lo oŋuŋkǝ. Wǝ́ ǝpǝrǝŋpǝ rɛ eyi pǝ pǝlǝ pǝ rù rǝ pǝ kǝtǝrǝceŋceŋ. Pǝ le kpii wǝkpakpǝ wǝ lée sie ŋaŋa. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Wǝ́ etiepǝ sa pǝ fìi vurǝ ŋpa. Wǝ́ pǝ pɛ̀ɛlɩ anyɩŋkǝ pǝ kaŋ yɩrɩ rǝ kǝtǝǝwǝ. Wǝ́ enyipǝ we pǝ kǝ ŋ pǝ́ etiepǝ sa ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ kpii nǝ nyáa taa nyiyǝ we ŋ kpii vɔrʊrǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Lee kpii rǝ fɛɛwǝ sa. La saanǝ. Nǝ taalǝ tuwǝ we ŋ tìi nǝ kǝ́ ŋ ke kpii rǝ Galileya wǝ.» <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Tɛnɩ ǝkǝnǝŋ: «Wǝ kpii kǝ pǝ fǝ Nyɩmaasɩ le Pi pǝ kpii oturɔɔrɔɔyeetǝpǝ rǝ akaakǝ. Pǝ láa kpaa ŋwǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ. Kǝ juutatǝrǝ ŋ saanǝ.» <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Wǝ́ etiepǝ sa pǝ tàalǝ Yesu le etieyǝ sa. <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />Wǝ́ pǝ pwɛ̀yɩ rǝ wǝfuŋkpǝ sa la fɛɛwǝ. Wǝ́ pǝ kolu pǝ fǝ̀ tuwǝ sa kpǝlo pǝ pɔ̀ Yesu le enyikpiipǝ we tǝ mǝ ceŋceŋ, mǝ otukarǝtǝtuturupǝ we kpǝlo la amayǝ. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Etiepǝ sa pǝ kaamǝ: Marɩya ŋ no ru rǝ Magǝdala, Yowana, Yakubu le lee Marɩya. Etietuturupǝ we pǝ ka kʊla mǝ pǝ we, ŋpǝ ŋkpɛ pǝ fǝ̀ tuwǝ sa pǝ pɔ̀ enyikpiipǝ we la amayǝ. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Yesu le enyikpiipǝ sa pǝ nyɩnɩ rǝ ǝkǝnǝŋ etiepǝ sa le etieyǝ sa yǝ lǝǝ lǝmǝ duturǝ. Kǝto pǝ laa lɔ pǝ pǝ nuŋ. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Paape, wǝ́ Pɛtǝro ŋ yili ŋ sù ŋ ko ŋ ko wǝfuŋkpǝ we la fɛɛwǝ. Kǝ́ ŋ ne ke fii we, wǝ́ ŋ pɛɛlɩ ŋ cò kpɛɛ ŋ yɩrɩ wǝfuŋkpǝ we lǝ mǝrǝ. Wǝ́ ŋ nyɩnɩ rǝ kɛlɛlɛyǝ we pǝ ŋwàa ŋwǝ ko ŋ kpɛlɩ. Wǝ́ ŋ kpǝ̀lǝŋ ŋ ko ŋ ko nyarǝwǝ. Wǝ́ tuwǝ sa wǝ rili no mumuŋ.<verse eid="LUK 24:12" /></para>
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ no otukarǝtǝpǝ rɛ eyi pǝ ko ŋ ko Emayisǝ wǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Jirǝ we jirǝ we, wǝ́ enyi eyi rǝ epǝ we pǝ ke sìimǝ Yesu pǝ rù pǝ ko ŋ ko dǝŋtǝǝpirǝ we pǝ lóo pwo Emayisǝ wǝ. Fǝ rǝ Yerusalɛmǝ ko dǝŋtǝǝpirǝ sa we, wǝ lǝ kpaarayǝ tǝ mǝ ceŋceŋ. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Wǝ́ pǝ tɛ̀ɛrɩ pǝ rù rǝ otuyǝ we kpǝlo yǝ pǝlǝ pǝ ko ŋ ko. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Eniyǝ we pǝ tɛɛrɩ pǝ lóo ko we, wǝ́ Yesu ŋwǝŋwǝ ŋ kolu ŋ tù pǝ. Wǝ́ ŋ sanǝ mǝ pǝ ŋ ko ŋ ko. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Pǝ ya pǝ láa nyɩŋ ŋwǝ, paape pǝ laa nyɩŋ ŋwǝ pǝ ci, duturǝ ɖi tǝrɛ wǝ sǝnǝ pǝle enimiyǝ. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nǝ tɛnɩ nǝ nyóo ko mǝ kʊŋwǝ?» Wǝ́ pǝ tùmǝ pǝ yàa. Anyɩŋ pǝ yàa mǝ tǝlarǝ mǝ tǝlarǝ. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Wǝ́ pǝle ceŋceŋ, pǝ lóo pwo Kǝlewopa ŋ yìili ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «We ŋlǝ́ ceŋceŋ ko eri nyiyǝ rǝ Yerusalɛmǝ, ŋ nee ci tuwǝ wǝ lǝ pǝ rǝ eciyǝ sa mǝrǝ wǝ?» <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ lǝ pǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yesu ŋ no ru rǝ Nazarɛtǝ we, le dierǝ wǝ́ le reemǝ. Ke ri worokokpɛɛnuŋtɛŋtǝmumuŋyǝ rɛ. Ke ŋ yee otuyǝ yǝ lóo co vurǝ, wǝ́ ne dierǝ gǝ lǝǝmǝ okopiyǝ rǝ Worokoyǝ mǝ enyipǝ kpǝlo le enimiyǝ. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Wǝ́ loh otoolutǝmumuŋpǝ mǝ leh epilipǝ pǝ fǝ̀ ŋwǝ pǝ kpìi Pilato rǝ akaakǝ kǝ ŋ tɔ̀ɔ na bɔrǝ. Wǝ́ pǝ kpàa ŋwǝ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ pǝ wʊlʊ. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />La ka ŋ tɛɛ kpɛɛwǝ ǝkǝnǝŋ ŋwǝ ŋ kaamǝ yǝ we Worokoyǝ ŋ ne kpii ŋ pa pɔrʊ Isǝrayɛlǝ wǝ. Paape, tǝ fǝ kʊla we, ruŋruŋ wǝ ri juutatǝrǝ kǝ́ tuwǝ sa wǝ lǝ pǝ wǝ. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Paape etiepǝ rɛ pǝ ke sìimǝ Yesu mǝŋ lǝ kǝtǝ we, pǝ le pe tíi lǝ dierǝ rɛ le ri lǝ mumuŋ kǝceece. Ɖokoŋpirǝ sa ŋalaŋala we wǝ́ pǝ le yi pǝ lo ko vuŋtɔŋrǝ we la fɛɛwǝ. <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />Pǝ laa ka nyɩŋ Yesu le kǝnyiǝtǝkǝ we. Wǝ́ pǝ la siɛnɩ pǝ le pe tíi lǝ ǝkǝnǝŋ Worokoyǝ le epicoŋpipǝ rɛ pǝ lo po ru rǝ pǝ. Wǝ́ pǝ le tíi pǝ ǝkǝnǝŋ Yesu kpii vɔrʊrǝ. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Lǝh ǝtǝŋrɛɛpǝ ŋpǝ ŋkpɛ pǝ lo ko vuŋtɔŋrǝ we la fɛɛwǝ. Wǝ́ pǝ la ka nyɩŋ tu ri ŋ tu mǝŋ kǝ́ etiepǝ we pǝ la tɛŋ wǝ kǝtǝ. Paa pǝ laa nyɩŋ Yesu.» <verse eid="LUK 24:24" /><verse number="25" style="v" sid="LUK 24:25" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ puru ŋpa. Kǝ́ kǝto wǝ́ oworokokpɛɛnuŋtɛŋtǝpǝ lo otuyǝ we kpǝlo pǝ la tɛŋ yǝ mumu yǝ lɛnyɩ mǝ nǝ alɔnuŋkǝ ǝnǝ? <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Wǝ kpii kǝ Mesiyayǝ we ŋ cʊʊrʊ mǝŋkǝsa. Kǝ Worokoyǝ ŋ nya fɛɛ ŋ rɛɛrɩ mǝ ŋwǝ.» <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Wǝ́ Yesu ŋ yà ŋ ka ŋ pɔrʊ Worokoyǝ la kǝfwɛɛkǝ la afɛɛyǝ we kpǝlo kɩɩkɩ yǝ la wɛɛlɩ yǝ lo ru rǝ ŋwǝ lo duturǝ mǝ ŋ tìi pǝ. Tìe rǝ Mose la wǝfwɛɛkpǝ, wǝ́ ŋ fǝ̀ ŋ kolu ŋ rù ǝrǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ kpǝlo kɩɩkɩ.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Wǝ́ pǝ kpìi pǝ ko ŋ ko. Kǝ́ pǝ lǝ kǝ kǝlǝ mǝ dǝŋtǝǝpirǝ we pǝ ko ŋ ko we, wǝ́ Yesu ŋ yeli mǝŋ lǝh sǝ mǝ ŋ tɛlɩ rǝ. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Paa wǝ́ pǝ nyɩ̀ɩ mǝ ŋwǝ, wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pa sʊʊrʊ rǝ lǝh kpǝŋ. Duturǝ ɖi ɖiɔrǝ la marǝ oro. Wǝ́ ǝrǝkǝ kǝ lah cɩɩ rǝ wǝǝ.» Wǝ́ ŋ kolu ŋ sʊ̀ʊrʊ rǝ pǝlǝ kpǝŋ. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Kǝ́ pǝ le ke tii pǝ leh ri we, wǝ́ ŋ fǝ̀ kpɔnɔyǝ we. Wǝ́ ŋ cèeni Worokoyǝ, wǝ́ ŋ pò ŋwǝ, wǝ́ ŋ fǝ̀ ŋwǝ ŋ kòonu pǝ. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Rǝ fɛɛwǝ we we, wǝ́ enimiyǝ yǝ wùru pǝ. Wǝ́ pǝ nyɩnɩ ŋwǝ pǝ cìi. Wǝ́ pǝ yɩ̀rɩ ŋwǝ fee. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Wǝ́ pǝ ke ŋ tìi awɛ ǝkǝnǝŋ: «A laa nyɩŋ kǝ́ wǝ la yà wǝ lah raŋ mǝ lǝ rǝ kʊŋwǝ kǝ́ ŋ na ya ŋ náa wɛɛlɩ mǝ ŋ pɔrʊ oworokoŋtieyǝ we lo duturǝ mǝ ŋ tíi lǝ wǝ?» <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />Wǝ́ pǝ yili kǝtǝrǝceŋceŋ pǝ kpǝ̀lǝŋ pǝ kǝ ŋ pǝ Yerusalɛmǝ. Kǝ́ pǝ le pe fii wǝ́ pǝ nyɩnɩ otukarǝtǝtǝmǝceŋceŋpǝ we mǝ pǝlǝ ǝtǝŋtuturupǝ kpǝlo kɩɩkɩ pǝ lo ku pǝ tini. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Wǝ́ pǝlo kpǝlo pǝ ke ŋ tíi pǝ ǝkǝnǝŋ: «Kǝceece, Kulǝtǝyǝ la saanǝ. Sɩmɔ la nyɩŋ ŋwǝ.» <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Wǝ́ pǝ le eyi, ŋpǝ ŋkpɛ pǝ ci ǝfǝ amayǝ pǝ pɔ̀, tuwǝ wǝ lǝ pǝ rǝ gʊŋrǝ, mǝŋ kǝ́ wǝ le yee wǝ lǝ fǝ ǝkǝ pǝ la nyɩŋ Yesu pǝ le ci rǝ kǝ́ ŋ no po kpɔnɔyǝ wǝ.<verse eid="LUK 24:35" /></para>
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ no otukarǝtǝpǝ rǝ Yerusalɛmǝ</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matewu 28:16-20</ref>, <ref loc="MRK 16:14-18">Marǝko 16:14-18</ref>, <ref loc="JHN 20:19-23">Yowanɛsɩ 20:19-23</ref>, <ref loc="ACT 1:6-8">Anǝnɛyeeyǝ 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Eniyǝ we enyipǝ sa eyipǝ pǝ ya pǝ láa pɔ pǝla amayǝ sa we, wǝ́ Yesu ŋwǝŋwǝ ŋ pǝlǝ ŋ rù rǝ pǝlo kpǝlo kɩɩkɩ le kǝtiitiikǝ kǝtǝrǝceŋceŋ. Wǝ́ ŋ cèeni pǝ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ la wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ.» <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />Pǝ cɩ̀ɩlɩ, wǝ́ pǝ fìi vurǝ ŋpa. Wǝ́ pǝ pù wǝ ǝkǝnǝŋ ŋpǝ pǝ la nyɩŋ wɛɛrǝ rɛ rǝ. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nyǝ lǝ rǝ nǝ wɛ lǝ mǝrǝ ǝnǝ? Kǝ́ kǝto wǝ́ nǝ ya nǝ nyǝ́ǝ tǝmǝlǝ rǝ nǝ wɛ lǝ mǝrǝ ǝnǝ? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Nǝ yɩrɩ mǝ wǝkaakpǝ mǝ mǝ wǝkparǝkpǝ re. Nǝ ci wǝ ǝkǝnǝŋ kǝceece ŋmǝ ŋ́ lǝǝwe. Nǝ ruu mǝ nǝ yɩrɩ re. Wɛɛrǝ lǝǝ lǝmǝ wɛlɛŋrǝ amaa gopirǝ mǝŋ kǝ́ nǝ ya nǝ nyáa nyɩŋ wǝ rǝ mǝ kǝtǝ.» <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Kǝ́ ŋ ya ŋ náa tɛŋ otuyǝ sa we, wǝ́ ŋ fǝ̀ na wǝkaakpǝ mǝ na wǝkparǝkpǝ ŋ ka ŋ kaŋ pǝ. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Wǝ́ tuwǝ sa wǝ rili pǝlo mumuŋ, wǝ́ pǝ nyà faawǝ ŋpa. Pǝ loo ko ŋ koru alɔnuŋ. Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Keeriwǝ rɛ wǝ laa kpɛɛ nǝ rǝ sa?» <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Wǝ́ pǝ fǝ̀ kǝpwɛɛcɩɩnɩkǝ rɛ lo toowǝ pǝ kòonu ŋwǝ. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Wǝ́ ŋ lɔ̀ kǝ ŋ wolu rǝ pǝle enimiyǝ. <verse eid="LUK 24:43" /><verse number="44" style="v" sid="LUK 24:44" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Tuwǝ ŋ́ ke ŋ tíi nǝ eniyǝ we ŋ́ ke kpii rǝ nǝ mǝrǝ wǝǝ. Ŋ́ tɛnɩ ǝkǝnǝŋ wǝ kpii kǝ otuyǝ we kpǝlo kɩɩkɩ pǝ la ŋʊrʊ pǝ lo ru rǝ mǝ rǝ Mose le seyǝ la wǝfwɛɛkpǝ, oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ mǝ Opusomǝpǝ lǝ mǝrǝ yǝ pǝ.» <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />Wǝ́ ŋ tàanǝ pǝlo oyupuyǝ kǝ pǝ nya fɛɛ pǝ nuŋ otuŋʊrʊyǝ we lo duturǝ. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Pǝ la ŋʊrʊ rǝ Worokoyǝ la kǝfwɛɛkǝ lǝ mǝrǝ ǝkǝnǝŋ Mesiyayǝ we láa cʊʊrʊ ŋpa, kǝ ŋ kpǝ́. Paape juutatǝrǝ we, láa saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.» <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Kǝ no otukarǝtǝpǝ pǝ tɛŋ wǝ pǝ tɛlɩ rǝ na nyɩŋrǝ pǝ tíi wǝkpǝŋkpǝ kpǝlo kɩɩkɩ ǝkǝnǝŋ pǝ siɛrɩ vɔrʊrǝ, kǝ Worokoyǝ ŋ fǝ pǝlo oturɔɔrɔɔyǝ ŋ cɛɛ pǝ. Pǝ lǝ́ǝ sǝŋ wǝ rǝ Yerusalɛmǝ. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ŋnǝ nǝ ri otuyǝ sa la araŋsielǝtǝpǝ. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Ŋmǝŋmǝ ŋ́ náa maa tuwǝ we mǝ tǝ ŋ no co garǝ wǝ sʊʊ rǝ no oŋuŋkǝ. Nǝ paa we, nǝ tii rǝ tǝŋtǝǝwǝ sa mǝrǝ ko ro eniyǝ we nǝ nyáa lɔ Worokoyǝ lo okopiyǝ wǝ.<verse eid="LUK 24:49" /></para>
  <para style="s">Yesu la rɛ yulaarǝ</para>
  <para style="r">(<ref loc="MRK 16:19-20">Marǝko 16:19-20</ref>, <ref loc="ACT 1:9-11">Anǝnɛyeeyǝ 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Wǝ́ Yesu ŋ fǝ̀ no otukarǝtǝpǝ sa ŋ ko ŋ ko ǝrǝ tǝŋtǝǝwǝ we pǝ lóo pwo Betania lǝ kpǝŋ. Rǝ fɛɛwǝ we we, wǝ́ ŋ rɛ̀ɛrɩ mǝ wǝkaakpǝ, wǝ́ ŋ pɛ̀ɛrɩ pǝ. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Eniyǝ we ŋ ya ŋ náa pɛɛrɩ pǝ we, wǝ́ ŋ ko ŋ ruu mǝ ŋ ru rǝ pǝ. Wǝ́ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ ka ŋ rɛ yulaarǝ. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Wǝ́ ŋpǝ paa pǝ yà pǝ kǝ ŋ kǝ ŋwǝ. Wǝ́ pǝ kpǝ̀lǝŋ pǝ kǝ ŋ pǝ Yerusalɛmǝ mǝ faamumuŋwǝ rɛ. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Pǝ lǝǝ kǝ ŋ sǝrǝ mǝ Worokoyǝ la nyarǝwǝ, eni ri ŋ ni, pǝ kpii pǝ lǝ́ǝ kǝ Worokoyǝ rǝ wǝ.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>