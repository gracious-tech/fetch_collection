<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Yowanɛsɩ</para>
  <para style="toc3">Yow</para>
  <para style="toc2">Yowanɛsɩ</para>
  <para style="toc1">Yowanɛsɩ le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Yowanɛsɩ</para>
  <para style="mt2">le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Yowanɛsɩ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa. Ke ri Yesu le enyikpiipǝ we le ceŋceŋ. Ŋwǝ ŋ ke ri nyikpiiyǝ we Yesu ŋ ka ŋ taa kǝǝwǝ mǝ ŋ teeri wǝ. Rǝ na kǝfwɛɛkǝ sa lǝ kǝsǝŋkǝ we, Yowanɛsɩ la tɛŋ ǝkǝnǝŋ Yesu ŋ ri Worokoŋtierǝ we. Wǝ́ ŋrǝ Worokoŋtierǝ sa la pa siɛrɩ le yee nyɩmaasɩyǝ. Wǝla kǝmaakǝ wǝ́ ŋ pɔ̀rʊ ŋ kanǝ ǝkǝnǝŋ Yesu ŋ ri Mesiyayǝ we, Worokoyǝ le Piyǝ mǝ wǝnyɩɩnɩpoŋpikpǝ. Ŋwǝ Yesu ke kpii conu kòonu tu ri ŋ tu, wǝ́ saŋ rǝ ŋwǝ wǝ́ Worokoyǝ ŋ no co tu ri ŋ tu (Yowanɛsɩ 1:1-14). Yowanɛsɩ la kaŋ anʊkɔrǝtieyǝ sa saŋ rǝ otufǝcamǝyǝ wa. La wɛɛlɩ lo ru rǝ mɛŋwǝ we wǝ lóo koonu vɔrʊrǝ wǝ (Yowanɛsɩ 4), keeriwǝ we wǝ lóo koonu vɔrʊrǝ wǝ (Yowanɛsɩ 6), mɛɛrǝŋtǝceeceeyǝ mǝ na amɛɛpǝ (Yowanɛsɩ 10), rɛzɛŋkuŋrǝ (Yowanɛsɩ 15). Yowanɛsɩ la wɛɛlɩ lo ru rǝ Yesu lo otucovurǝ we ŋ ne yee wǝ. Ŋyǝ otucovurǝ sa lo mumuŋwǝ wǝ kaamǝ kǝ́ Lazaro ŋ kpǝ̀ wǝ́ ŋ sàanǝ ŋwǝ wǝ. Wǝ kǝto Yowanɛsɩ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa we, wǝ kaamǝ wǝ ǝnǝ: Ŋ pɔrʊ ŋ kaŋ enyipǝ ǝkǝnǝŋ Yesu ŋ ri Worokoyǝ le Piyǝ, wǝ́ mǝŋ enyipǝ pǝ la lɔ ŋwǝ pǝ lo nuŋ we, pǝ láa nya vɔrʊlaalɛɛrǝ (Yowanɛsɩ 20:31).</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-18</para>
  <para style="io">- Yowanɛsɩ worokomɛŋwiiritǝyǝ we mǝ Yesu lo otukarǝtǝsǝsǝŋpǝ 1:19-51</para>
  <para style="io">- Yesu la kǝnǝnɛyeekǝ rǝ enyikpǝlo la kǝnyɩŋkǝ 2:1–12:50</para>
  <para style="io">- Yesu le ecituturuyǝ coŋ koonu nǝ ǝkpǝ́kǝ 13:1–19:42</para>
  <para style="io">- Yesu la asaanǝkǝ mǝ na wɛ la apɔrʊkaŋkǝ 20:1-31</para>
  <para style="io">- Yesu la wɛ lǝ ǝtǝpɔrʊkaŋkǝ rǝ Galileya 21:1-25</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Dierǝ we lóo koonu wǝnyɩɩnɩkpǝ mǝ vɔrʊrǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Coŋ koonu tu ri ŋ tu lǝ kǝsǝŋkǝ we, Dierǝ ge kpii wǝ. Dierǝ we, ge kpii gʊ̀la mǝ Worokoyǝ, wǝ́ Dierǝ we ge ri Worokoyǝ. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Dierǝ sa ge kpii gʊ̀la mǝ Worokoyǝ ǝrǝ kǝsǝŋkǝ. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Worokoyǝ yeli otuyǝ kpǝlo kɩɩkɩ saŋ rǝ Dierǝ sa lo oŋuŋkǝ. Wǝ́ tǝrɛ wǝ lee kpii Worokoyǝ ŋ nee yee ŋ saŋ rǝ rǝ. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Vɔrʊrǝ ge kpii rǝ Dierǝ sa lǝ mǝrǝ. Vɔrʊrǝ sa ge ri wǝnyɩɩnɩkpǝ gòonu anyɩmaasɩpǝ, <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />wǝnyɩɩnɩkpǝ sa wǝ láa nyɩnɩ rǝ nuŋtumuwǝ paape nuŋtumuwǝ wǝ laa lɔ kpǝ.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Nuŋtumuwǝ wǝ loo koru e ri kpǝ lo yurǝ.»</char></note> <verse eid="JHN 1:5" /><verse number="6" style="v" sid="JHN 1:6" />Worokoyǝ kpìi nyiyǝ rɛ manǝ, ŋwǝ ŋ ri Yowanɛsɩ. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Pǝlǝ mǝŋ ɖaŋsielǝtǝyǝ kǝtǝ, kǝ ŋ pe ri ɖaŋsieyǝ ŋ ru rǝ wǝnyɩɩnɩkpǝ sa, kǝ enyipǝ kpǝlo kɩɩkɩ pǝ nya fɛɛ pǝ lɔ pǝ nuŋ saŋ rǝ no oŋuŋkǝ. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Nyiyǝ sa ŋwǝŋwǝ lee ke ri wǝnyɩɩnɩkpǝ, paa pǝlǝ ŋ pe ri ɖaŋsieyǝ ŋ ru rǝ wǝnyɩɩnɩkpǝ sa rǝ. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Dierǝ we ɖi wǝnyɩɩnɩpoŋpikpǝ wǝ. We wǝ lǝ pǝ ǝrǝkǝ, kǝ wǝ pa nyɩnɩ anyɩmaasɩpǝ kpǝlo kɩɩkɩ.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Dierǝ we, ge kpii rǝ ǝrǝkǝ, wǝ́ Worokoyǝ cò ǝrǝkǝ saŋ rǝ rǝ, paape ǝrǝkǝ kǝ laa nyɩŋ Dierǝ sa kǝ ci. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Dierǝ sa lǝ pǝ ŋrǝŋrǝ rǝlǝ gǝŋrǝ, paape rǝle enyipǝ pǝ laa lɔ rǝlǝ kǝsǝǝkǝ. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Paa epǝ we pǝ la lɔ rǝ, wǝ́ pǝ la lɔ rǝ pǝ lo nuŋ we, ŋrǝ Dierǝ sa lo koonu pǝlo okopiyǝ pǝ siɛrɩ pǝ yee Worokoyǝ le epipǝ. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Ŋkǝ saŋ rǝ ǝmǝkǝ sa pǝ lǝ́ǝ mǝ nyiyǝ amaa nyɩmaasɩyǝ lǝ kǝǝpǝ́wǝ rɛ kǝto wǝ́ pǝ la siɛrɩ pǝ le yee Worokoyǝ le epipǝ wǝ. Paa Worokoyǝ ŋwǝŋwǝ ŋ nǝ fǝ pǝ ŋ ne yee ne epipǝ.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Wǝ́ Dierǝ we, la pa siɛrɩ le yee nyɩmaasɩyǝ. Wǝ́ nyiyǝ sa ŋ ne pe kpii ŋ na kʊla mǝ lǝ. Lǝǝmǝ lɛsiɛrɩwǝ mǝ anʊkɔrǝyǝ ŋpaŋpa. Wǝ́ yǝ la nyɩŋ no okuruyǝ ŋ na lɔ wǝ. Okuruyǝ sa we, Tǝyǝ lo okuruyǝ ŋ no koonu ne Piceŋceŋyǝ yǝ lǝǝwe. <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />Yowanɛsɩ le ri ɖaŋsieyǝ lo ru rǝ nyiyǝ sa le tíi enyipǝ, wǝ́ ŋ na ca anarǝyǝ kelele ŋ na tɛŋ ǝkǝnǝŋ: «A lǝŋ nyɩŋ yǝ we ŋ́ ke re mǝ kǝ́ ŋ́ tɛnɩ ǝkǝnǝŋ: “Nyiyǝ we ŋ nǝh pǝ rǝ mǝ kǝmaakǝ we, lo ru okuruyǝ le teeri mǝ. Duturǝ ɖi ke kpii kaka kpɛŋ wǝ́ ŋ́ ne ci oru ǝrǝkǝ.”» <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />La pɛɛrɩ loh kpǝlo kɩɩkɩ ŋpa, wǝ́ ŋ ne yee lǝ lɛsiɛrɩwǝ wǝ́ ŋ nǝ tǝ ŋ ne yee lǝ wǝ. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Worokoyǝ lo koonu lǝ seyǝ saŋ rǝ Mose. Paa wǝ́ ŋ na pɔrʊ na lɛsiɛrɩwǝ mǝ na anʊkɔrǝyǝ ŋ na kaŋ lǝ saŋ rǝ Yesu Kǝriso. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Rɛ faa nyɩŋ Worokoyǝ ŋ tǝnǝ. Paa ne Piceŋceŋyǝ we ŋ ri Worokoyǝ, wǝ́ ŋ maarǝ mǝ Tǝyǝ kpamama we, ŋwǝ ceŋceŋ ko ŋ na pa pɔrʊ yǝ we Worokoyǝ ŋ ri ŋ na kaŋ lǝ wǝ.<verse eid="JHN 1:18" /></para>
  <para style="s">Yowanɛsɩ worokomɛŋwiiritǝyǝ la ɖaŋsieyǝ we ŋ ne ri ŋ no ru rǝ Yesu wǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Oyudatǝpǝ lo omumuŋpǝ pǝ kpìi otoolutǝpǝ mǝ elevipǝ pǝ rù rǝ Yerusalɛmǝ pǝ ko Yowanɛsɩ lǝ kpǝŋ, pǝ kǝ pǝ́ ŋwǝ ǝkǝnǝŋ: «Ǝlǝ wǝ́ e ri wǝ?» Yowanɛsɩ la ɖaŋsietierǝ gaamǝ ɖǝ ǝnǝ. <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Laa ŋwàa pǝla tǝrɛ, wǝ́ ŋ pɔ̀rʊ ŋ tìi pǝ feŋteŋ ǝkǝnǝŋ: «Ŋkǝ ŋmǝ ŋ́ ri Kǝrisoyǝ we». <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «We ŋlǝ́ e ri ǝlǝ? Ŋlǝ́ e ri Eliya?» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ow! Ŋkǝ ŋmǝ ŋ́ ri Eliya.» Wǝ́ pǝ tǝ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ e ri worokokpɛɛnuŋtɛŋtǝyǝ we?» Wǝ́ ŋ tìi pǝ: «Ow». <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />Wǝ́ pǝ tǝ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «We ŋlǝ́ e ri ǝlǝ kororo? Wǝ kpii kǝ la nya kpǝkpǝlǝŋkuŋwǝ la ka pɔ epǝ we pǝ le kpii lǝ la amayǝ! Ǝlǝ wǝ́ lǝ́ŋlǝ a ya láa tɛŋ ŋ ŋlǝ́ e ri wǝ?» <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />Wǝ́ Yowanɛsɩ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri yǝ we ŋ ya náa ca anarǝyǝ rǝ nyɔŋkpaakǝtǝǝwǝ:</para>
  <para style="q1" vid="JHN 1:23">“Nǝ kʊʊrʊ Ǝtǝ Woroko la gʊŋrǝ”, mǝŋ kǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya ŋ na tɛŋ wǝ kǝtǝ».<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Enyipǝ we pǝ kpìi pǝ ko Yowanɛsɩ lǝ kpǝŋ we, Afarisitǝpǝ pǝ kǝ lǝǝwe<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Afarisitǝpǝ pǝ ka kʊla rǝ pǝlǝ mǝrǝ.»</char></note>. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Wǝ́ pǝ tǝ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Mǝŋ e lee ri Kǝrisoyǝ we, amaa Eliya, amaa worokokpɛɛnuŋtɛŋtǝyǝ we wǝǝ, kǝ́ kǝto wǝ́ a ya lée wiiri enyipǝ lo worokomɛŋwǝ wǝ?» <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />Wǝ́ Yowanɛsɩ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ we, mɛŋwǝ wǝ́ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née wiiri enyipǝ lo worokomɛŋwǝ. Paape nyiyǝ rɛ kpii rǝ nǝ mǝrǝ, nǝ nyee ci ŋwǝ. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Kpii lǝ́ǝ pǝ rǝ mǝ kǝmaakǝ wǝ́ ŋ́ nee ce ŋ́ kaamǝ kǝ ŋ wuru na afʊkpayǝ la aŋwɛɛyǝ ǝkǝŋtǝ.» <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />Tuwǝ sa wǝ kǝ ŋ pǝ rǝ Betania, rǝ kpanǝwǝ we pǝ lóo pwo Yɔrǝdaŋ la kǝtakǝ nɔ. Fɛɛwǝ Yowanɛsɩ ŋ ke ŋ wiiri enyipǝ lo worokomɛŋwǝ wǝǝ.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesu ŋ ri Worokoyǝ le piyǝ wǝ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Gaalǝǝrǝkǝ we, wǝ́ Yowanɛsɩ ŋ nyɩnɩ Yesu lǝ́ǝ pǝ rǝ nǝ kpǝŋ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ yɩrɩ re, Worokoyǝ la mɛɛpirǝ we láa nyɩɩrɩ ǝrǝkǝ lo oturɔɔrɔɔyǝ lǝ ŋ cɛ wǝǝ. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Ŋwǝ wǝ́ ŋ́ ke reemǝ ǝkǝnǝŋ: “Nyiyǝ rɛ lǝh pǝ rǝ mǝ kǝmaakǝ, lo ru okuruyǝ le teeri mǝ. Duturǝ ɖi ke kpii kaka kpɛŋ wǝ́ ŋ́ ne ci oru ǝrǝkǝ.” <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ŋmǝŋmǝ ŋ́ nee ke ci ŋwǝ. Paape ŋ́ ne pe wiiri enyipǝ lo worokomɛŋwǝ mǝ mɛŋwǝ kǝ wǝ nya fɛɛ wǝ pɔrʊ ŋwǝ wǝ kaŋ Isǝrayɛlǝtǝpǝ.» <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />Wǝ́ Yowanɛsɩ ŋ rili ɖaŋsieyǝ ŋ rù rǝ ŋwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ na nyɩŋ Worokoyǝ la Wɛɛrǝ, lo ru rǝ yulaarǝ mǝŋ tookpaayǝ láa sʊʊ, wǝ́ la pa tɛɛ rǝ ŋwǝ. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ŋmǝ we, ŋ́ nee ke ci ŋwǝ. Paa yǝ we ŋ ne kpii mǝ ŋ́ pe wiiri enyipǝ lo worokomɛŋwǝ mǝ mɛŋwǝ we, ŋ ne tíi mǝ ǝkǝnǝŋ: “Nyiyǝ we lo oŋuŋkǝ a lah pa nyɩŋ Wɛɛrǝ la sʊʊ la pa tɛɛ rǝ we, ŋwǝ ŋ nǝh pǝ fǝ Wɛɛkenikenirǝ ŋ wiiri enyipǝ lo worokomɛŋwǝ wǝ.” <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ŋmǝ we, ŋ́ na nyɩŋ wǝ mǝ mǝ enimiyǝ, wǝ́ ŋ́ ya née ri wǝla ɖaŋsieyǝ mǝ ŋ tíi nǝ ǝkǝnǝŋ nyiyǝ sa ŋ ri Worokoyǝ le Piyǝ wǝ.»<verse eid="JHN 1:34" /></para>
  <para style="s">Yesu lo otukarǝtǝsǝsǝŋpǝ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Gaalǝǝrǝkǝ we, wǝ́ Yowanɛsɩ ŋ tǝ ŋ kolu ŋ yàa rǝ fɛɛwǝ we ke, ŋpǝ mǝ no otukarǝtǝpǝ rɛ eyi. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Kǝ́ Yesu ŋ nǝ pǝ ŋ nah tɛlɩ we, wǝ́ Yowanɛsɩ ŋ yà ŋ ka ŋ yɩrɩ ŋwǝ pʊrɩpʊrɩ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ yɩrɩ Worokoyǝ la mɛɛpirǝ we re!» <verse eid="JHN 1:36" /><verse number="37" style="v" sid="JHN 1:37" />Wǝ́ Yowanɛsɩ lo otukarǝtǝpǝ we eyipǝ pǝ nunu tuwǝ we ŋ na tɛŋ wǝ, wǝ́ pǝ yili pǝ sìimǝ Yesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Kǝ́ Yesu ŋ na siɛrɩ we, wǝ́ ŋ nyɩnɩ kǝ́ pǝ sìimǝ ŋwǝ wǝ. Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nǝ ya nǝ nyáa taa?» Wǝ́ pǝ yìili ǝkǝnǝŋ: «Rabi e kpii rǝ fǝŋ?» Rabi lo duturǝ ɖi Tukaŋtǝyǝ. <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ pǝ kǝ nǝ pa nyɩŋ». Wǝ́ kǝceece pǝ ko ŋ ko, wǝ́ pǝ kolu pǝ nyɩnɩ fɛɛwǝ ŋ kpii wǝ. Wǝ lǝh mǝ lǝ mǝŋ ɖiɔrǝ le eniyǝ niǝ. Wǝ́ pǝ mùmu pǝ fǝ̀ jirǝ we le enituturuyǝ pǝ tini rǝ nǝ kpǝŋ.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Otukarǝtǝpǝ we eyipǝ pǝ nunu tuwǝ we Yowanɛsɩ ŋ tɛnɩ, ǝkǝ pǝ yili pǝ sìimǝ Yesu we, pǝle ceŋceŋ ŋ kaamǝ Aŋdǝre, Sɩmɔ Pɛtǝro la paanʊyǝ. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Nyisǝsǝŋyǝ Aŋdǝre ŋ noh kumǝ we, ŋ kaamǝ ne mǝtee Sɩmɔ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la nyɩŋ Mesiyayǝ we!» Wǝlo duturǝ ɖi Kǝrisoyǝ we. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Wǝ́ ŋ kolu mǝ Sɩmɔ rǝ Yesu lǝ kpǝŋ. Wǝ́ Yesu ŋ yɩ̀rɩ ŋwǝ pʊrɩpʊrɩ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋlǝ́ e ri Sɩmɔ, Yowanɛsɩ le piyǝ. Pǝ loh mǝ pwo lǝ́ Kefasǝ.» Nyɩŋrǝ sa lo duturǝ ɖi Ɖurǝ.<verse eid="JHN 1:42" /></para>
  <para style="s">Yesu lo pwo Filipo mǝ Nataniɛlǝ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Galǝǝrǝkǝ we, wǝ́ Yesu ŋ fǝ̀ ŋ tɛɛ rǝ na wɛ ǝkǝnǝŋ ŋ nóo ko Galileya. Wǝ́ ŋ nyɩnɩ Filipo, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siimǝ mǝ!» <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Filipo ri Abɛsayɩdatǝpǝ. Aŋdǝre mǝ Pɛtǝro lǝ tǝŋtǝǝwǝ wǝ kaamǝ Bɛsayɩda. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Wǝ́ Filipo ŋ kolu ŋ nyɩnɩ Nataniɛlǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la nyɩŋ nyiyǝ we Mose ŋ na wɛɛlɩ ŋ no ru rǝ, rǝ Seyǝ la kǝfwɛɛkǝ mǝrǝ wǝ́ oworokokpɛɛnuŋtɛŋtǝpǝ ŋpǝ ŋkpɛ pǝ la wɛɛlɩ pǝ lo ru rǝ wǝ! Ŋwǝ ŋ kaamǝ Nazarɛtǝtǝ Yesu, Yosɛfʊ le piyǝ.» <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />Wǝ́ Nataniɛlǝ ŋ pǝ̀ ǝkǝnǝŋ: «Tuceeceewǝ rɛ wǝ lóo koru oru rǝ Nazarɛtǝ?» Wǝ́ Filipo ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ a pa nyɩŋ».<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Kǝ́ Yesu ŋ na nyɩŋ Nataniɛlǝ ŋ no ru ŋ nǝ́ǝ pǝ rǝ nǝ kpǝŋ we, wǝ́ ŋ tɛnɩ ŋ rù rǝ ŋwǝ ǝkǝnǝŋ: «A lǝŋ nyɩŋ Isǝrayɛlǝtǝpiyǝ capɩcapɩ wǝǝ, alakpayǝ yǝ lee kpii rǝ ŋwǝ.» <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />Wǝ́ Nataniɛlǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «E cii mǝ rǝ fǝŋ?» Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Ŋ́ na nyɩŋ lǝ́ kǝ́ a ka yaa rǝ wǝcookpǝ we kǝnǝŋkǝ, kpɛŋ wǝ́ Filipo ŋ ne ci opwo lǝ́.» <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />Wǝ́ Nataniɛlǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, Worokoyǝ le Piyǝ wǝ́ e ri. Isǝrayɛlǝtǝpiliyǝ wǝ́ e ri.» <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kpiikǝ ŋ́ ne tíi lǝ́ ǝkǝnǝŋ ŋ́ na nyɩŋ lǝ́ rǝ wǝcookpǝ we kǝnǝŋkǝ kǝto wǝ́ a la lɔ o lo nuŋ! A lah pa nyɩŋ otumumuŋyǝ e teeri.» <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, nǝ nyah pa nyɩŋ kǝ́ yulaarǝ la taanǝ, wǝ́ Worokoyǝ le epicoŋpipǝ pǝ láa rɛ, pǝ láa sʊʊ rǝ Nyɩmaasɩ le Pi wǝ».<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Yesu la siɛrɩ mɛŋwǝ le yee ǝfǝŋpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Juutatǝrǝ we, wǝ́ pǝ ka ŋ lɔ tieyǝ rǝ Kana lǝ tǝŋtǝǝwǝ, wǝ kpii rǝ Galileya lǝ gǝŋrǝ wǝ. Yesu le lee pǝlǝ ka yaa rǝ fɛɛwǝ we. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Wǝ́ pǝ pwò Yesu mǝ no otukarǝtǝpǝ pǝ pǝ dielɔrǝ sa. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Kǝ́ vɛŋyǝ ŋ na pa lɛ ŋ ne kpii pǝ we, wǝ́ Yesu le lee ŋ kolu ŋ tìi Yesu ǝkǝnǝŋ: «vɛŋyǝ la lɛ le kpii pǝ.» <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ lee, wǝ fǝ lǝ́ fǝŋ? Mǝ eniyǝ yǝ foo ro.» <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />Wǝ́ Yesu le lee ŋ tìi asʊmatǝpǝ we ǝkǝnǝŋ: «Tu ri ŋ tu ŋ née tíi nǝ ko we, nǝ yee wǝ.» <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />Akpanǝkpɛɛyǝ rɛ akʊraŋ yǝ ka kpɛlɩ rǝ fɛɛwǝ we, Oyudatǝpǝ pǝ ka ŋ tʊʊ yǝla mɛŋwǝ pǝ ŋ wɛɛ pǝla wɛ mǝŋ kǝ́ pǝlo kǝsuŋkǝ kǝ lǝ pǝ́ wǝ kǝtǝ. Akpanǝkpɛɛyǝ sa we, ɖǝ ri ŋ ɖǝ láa lɔ mɛŋwǝ tuuriyǝ yi amaa ta. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Wǝ́ Yesu ŋ tìi asʊmatǝpǝ we ǝkǝnǝŋ: «Nǝ lǝǝrǝ akpanǝkpɛɛyǝ sa mǝ mɛŋwǝ.» Wǝ́ pǝ lǝ̀ǝrǝ yǝ mǝ mɛŋwǝ pɛrɛkɛpɛrɛkɛ. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Rǝkǝsa we, nǝ tʊʊ wǝ nǝ ko koonu yǝ we ŋ ya náa yɩrɩ ekeeriyǝ we wǝ». Wǝ́ pǝ tʊ̀ʊ wǝ pǝ kolu pǝ kòonu ŋwǝ. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Wǝ́ ŋ rà mɛŋwǝ we wǝ la siɛrɩ wǝ le yee vɛŋyǝ ŋ yɩ̀rɩ. Lee ke ci fɛɛwǝ vɛŋyǝ sa ŋ no ru, paa asʊmatǝpǝ sa pǝ tʊ̀ʊ mɛŋwǝ we we, pǝ ke cii wǝ. Wǝ́ yǝ we ŋ ya náa yɩrɩ ekeeriyǝ we ŋ pwò tiɛŋwɛŋlǝtǝyǝ we ŋ pǝlǝ. <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Vɛŋceeceeyǝ wǝ́ nyi ri ŋ nyi ŋ nóo koonu mǝ ŋ coonu kpɛŋ. Vǝ́ enyipǝ pǝ lo ŋuŋ pǝ pǝ le piemu pǝ la lɛ we, e ci oru mǝ yǝ we ŋ noo poŋ wǝ. Wǝ́ ŋlǝ́ paa we, a la ka kʊʊ vɛŋceeceeyǝ ǝ lǝ tǝnǝ po ro eniyǝ sa!» <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />Tuwǝ sa wǝ ri Yesu lo otucovurǝ lǝ sǝsǝŋwǝ ŋ yeli wǝ lóo co vurǝ wǝǝ. Yeli wǝ rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Kana wǝ kpii rǝ Galileya lǝ gǝŋrǝ wǝ. Wǝ́ ŋ fǝ̀ ŋ pɔ̀rʊ na anaanǝkǝ ŋ kanǝ, wǝ́ no otukarǝtǝpǝ pǝ lɔ̀ ŋwǝ pǝ nunu. <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />Rǝ wǝla kǝmaakǝ wǝ́ ŋ fǝ̀ ŋ ko ŋ ko Kapɛrǝnawumǝ ŋpǝ mǝ ne lee, na apaanʊpǝ mǝ no otukarǝtǝpǝ. Paa pǝ kolu pǝ tini rǝ we wǝcupikpǝ rɛ ko.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesu le piri otusiiritǝpǝ rǝ Worokoyǝ la nyarǝwǝ</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matewu 21:12-17</ref>, <ref loc="MRK 11:15-17">Marǝko 11:15-17</ref>, <ref loc="LUK 19:45-46">Luka 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Anyɩŋ Oyudatǝpǝ le eyinyapǝkǝ la wǝcɛkpǝ wǝ kǝlǝ, wǝ́ Yesu ŋ kolu Yerusalɛmǝ. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Wǝ́ ŋ nyɩnɩ enyipǝ we pǝ lée siiri anɛŋpǝ, amɛɛpǝ, mǝ otookpaapǝ, pǝ ya pǝ lée siiri pǝla akɛɛpǝ rǝ Worokoyǝ la nyarǝwǝ le etikeŋtikǝ. Epǝ we pǝ láa nyaa sɩkayǝ ŋpǝ ŋkpɛ pǝ tini pǝ láa nyaa sɩkayǝ rǝ Worokoyǝ la nyarǝwǝ le etikeŋtikǝ. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Wǝ́ ŋ pɛnɩ golurǝ ŋ yeli fwɛɛpǝlawǝ ŋ fǝ̀ ŋ pìri pǝlo kpǝlo kɩɩkɩ rǝ Worokoyǝ la nyarǝwǝ we le etikeŋtikǝ, mǝŋ amɛɛpǝ we mǝ anɛŋpǝ we. Wǝ́ ŋ rè asɩkanyaatǝpǝ we la akpǝlɔpǝ we ŋ cò wǝ́ sɩkayǝ we ŋ canǝ rǝ kǝtǝǝwǝ. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Wǝ́ ŋ tìi otookpaasiiritǝpǝ we ǝkǝnǝŋ: «Nǝ kʊlaŋ otuyǝ sa kpǝlo kɩɩkɩ nǝ cɛ rǝ fɛɛwǝ sa! Nǝ pǝǝ fǝ mǝ Tǝ la nyarǝwǝ nǝ yee fɛɛsiiri otuyǝ.» <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Wǝ́ no otukarǝtǝpǝ pǝ tàalǝ Worokoŋtierǝ sa la tɛŋ ǝkǝnǝŋ: «Ao Worokoyǝ, kǝǝtaawǝ we ŋ́ lǝǝmǝ ŋ́ koonu lá nyarǝwǝ we, wǝ ya wǝ láa ta rǝ mǝ mǝŋ naawǝ kǝtǝ».<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Wǝ́ Oyudatǝmumuŋpǝ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Kǝ́ lo tucovurǝ wǝ́ o lóo koru eyee kǝ wǝ pɔrʊ wǝ kaŋ lǝ ǝkǝnǝŋ ŋlǝ́ ǝ lǝǝmǝ okopiyǝ kǝ e yee otuyǝ sa ǝnǝ?» <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ wɔɔ Worokoyǝ la nyarǝwǝ sa, rǝ wǝcukpǝ wǝta lǝ mǝrǝ we, ŋ́ née yiili wǝ.» <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />Wǝ́ Oyudatǝmumuŋpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ lǝ fǝ cɛŋwǝ tǝniǝ mǝ kʊʊraŋ pǝ la tɔ Worokoyǝ la nyarǝwǝ sa, wǝ́ ŋlǝ́, a láa tɛŋ ǝkǝnǝŋ rǝ wǝcukpǝ wǝta lǝ mǝrǝ ŋlǝ́ e lée yiili wǝ?» <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />Paa kǝ́ Yesu ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ la nyarǝwǝ we, ke reemǝ na wɛlɛŋrǝ rǝ. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Kǝto kǝ́ Yesu ŋ na saanǝ ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, wǝ́ no otukarǝtǝpǝ we pǝ tàalǝ ǝkǝnǝŋ tɛnɩ tuwǝ sa. Wǝ́ pǝ lɔ̀ Wǝŋʊrʊkenikenikpǝ we pǝ nunu, mǝŋ dierǝ we ŋ tɛnɩ wǝ.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesu cii tuwǝ wǝ kpii rǝ nyɩmaasɩyǝ la ziɔŋrǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Eniyǝ we Yesu ŋ kǝ tǝ ŋ kpii rǝ Yerusalɛmǝ mǝ eyinyapǝkǝ la wǝcɛkpǝ we we, wǝ́ enyipǝ wa pǝ lɔ̀ ŋwǝ pǝ nunu kǝ́ pǝ la nyɩŋ otucovurǝ we ŋ ke ŋ yee wǝ. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Yesu ŋwǝ paa we, laa tɛɛ kpɛɛwǝ rǝ pǝ, duturǝ ɖi ke cii pǝlo kpǝlo kɩɩkɩ sɩsiɛrɩ. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Wǝ́ laa lɛ ŋ pǝ́ rɛ ŋ pa wɛɛlɩ ŋ ru rǝ rɛ ŋ ri rɛ ŋ tíi ŋwǝ. Duturǝ ɖi ŋwǝŋwǝ cii tuwǝ wǝ kpii rǝ nyɩmaasɩyǝ la ziɔŋrǝ wǝ.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesu mǝ Nikodɛmǝ la atɛɛrɩkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Nyiyǝ rɛ ke kpii rǝ Afarisitǝpǝ lǝ mǝrǝ. Ŋwǝ ŋ ri Nikodɛmǝ. Oyudatǝpǝ lo omumuŋpǝ le ceŋceŋ ŋ lǝǝwe. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Jirɛɛrǝ we, wǝ́ ŋ pǝlǝ Yesu lǝ kpǝŋ mǝ dumurǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, le cii wǝ ǝkǝnǝŋ tukaŋtǝyǝ ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ wǝ́ e ri. Duturǝ ɖi rɛ lǝŋ koru eyee otucovurǝ sa a ya lée yee mǝŋ Worokoyǝ lee kpii ŋ kʊla mǝ ŋwǝ wǝ.» <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ pǝ laa siɛnɩ pǝ mǝ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ əkǝnǝŋ: «Wǝ kpii kǝ pǝ mǝ nǝ pǝ ru rǝ yulaarǝ.»</char></note> nyiyǝ rɛ we, yǝ we lǝŋ koru anyɩŋ Worokoyǝ le wǝpilirikpǝ». <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />Wǝ́ Nikodɛmǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Pǝ lǝ́ǝ tǝ pǝ koru asiɛnɩ pǝ mǝ nyiyǝ ŋ no kuru pǝ saŋ nɛ? Yǝ we lǝ́ǝ tǝ ŋ koru asiɛnɩ ŋ fii ne lee la lɛrǝ kǝ pǝ mǝ ŋwǝ kǝyitǝkǝ?» <verse eid="JHN 3:4" /><verse number="5" style="v" sid="JHN 3:5" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ pǝ laa siɛnɩ pǝ mǝ nyiyǝ pǝ ru rǝ mɛŋwǝ mǝ Wɛɛkenikenirǝ we, rɛ lǝŋ koru efii Worokoyǝ le wǝpilirikpǝ we lǝ mǝrǝ. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Nyɩmaasɩyǝ pǝ la nya pǝ lǝ mǝ ko we, nyɩmaasɩyǝ wǝ́ ŋ ri. Paa tuwǝ we wǝ lo ru rǝ Wɛɛkenikenirǝ we, Wɛɛkenikenirǝ lo tuwǝ wǝ lǝǝwe. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Wǝ pee yee lǝ́ yaa mǝŋ ŋ́ na tɛŋ ǝkǝnǝŋ: “Wǝ kpii kǝ pǝ siɛnɩ pǝ mǝ nǝ.” <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ǝrǝkǝ kǝ lóo fuŋ kǝ ŋ ko rǝ fɛɛwǝ we wǝ ponu mǝ kǝ wǝ, o mǝ nuŋ kǝlo oturuuyǝ, paa e lee ci fɛɛwǝ kǝ lo ru amaa fɛɛwǝ kǝ loh ko. Kǝ́ wǝ lǝ wǝ koonu nyi ri ŋ nyi pǝ lǝ mǝ pǝ lo ru rǝ Wɛɛkenikenirǝ wǝǝ.»<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Wǝ́ Nikodɛmǝ ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Tuwǝ sa wǝ lóo koru eyee wǝ saŋ nɛ?» <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ wǝ́ e ri rǝ Isǝrayɛlǝ wǝ́ e lee ci otuyǝ sa? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we: Tuwǝ le cii wǝ́ yǝ láa tɛŋ wǝ. Wǝ́ yǝ lée ri ɖaŋsieyǝ yǝ ŋ ru rǝ tuwǝ yǝ la nyɩŋ wǝ. Paape nǝ nyaa ya nǝ nyǝ́ǝ pǝ́ nǝ lɔ lah ɖaŋsieriyǝ sa nǝ nuŋ. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Mǝŋ nǝ nyaa lɔ mǝ nǝ nuŋ kǝ́ ŋ́ ya ŋ́ náa wɛɛlɩ mǝ ŋ ru rǝ otuyǝ we yǝ ya yǝ lǝ́ǝ pǝ rǝ kǝtǝǝwǝ mǝ ŋ tíi nǝ wǝǝ, nǝ nyée yee nɛ kǝ nǝ pa lɔ mǝ nǝ nuŋ mǝŋ ŋ́ na wɛɛlɩ ŋ́ no ru rǝ otuyǝ we yǝ ya yǝ lǝ́ǝ pǝ rǝ yulaarǝ ŋ́ ne tíi nǝ wǝ? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Rɛ faa rɛ yulaarǝ ŋ nyɩŋ. We yǝ we ŋ no ru rǝ yulaarǝ ŋ na sʊʊ ceŋceŋ. Ŋwǝ ŋ kaamǝ Nyɩmaasɩ le Pi. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Mǝŋ kǝ́ Mose ŋ tɔ̀ ciiwǝ ŋ rɛ̀ɛrɩ mǝ kǝpɔɔkǝ<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="NUM 21:8-9">4Mo 21:8-9</ref></char>.</char></note> rǝ nyɔŋkpaakǝtǝǝwǝ we, kǝ́ pǝ lǝh pǝ fǝ Nyɩmaasɩ le Pi pǝ rɛɛrɩ mǝ wǝǝ, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />kǝ nyi ri ŋ nyi ŋ náa nya ŋ lɔ ŋwǝ ŋ nuŋ we, ŋ nya vɔrʊlaalɛɛrǝ. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Duturǝ ɖi Worokoyǝ la taa ǝrǝkǝ sa lǝ kǝǝwǝ ŋpa, wǝ́ ŋ nǝ fǝ ne piceŋceŋyǝ ŋ no koonu, kǝ nyi ri ŋ nyi ŋ náa nya ŋ lɔ ŋwǝ ŋ nuŋ we, ŋ pǝǝ kpǝ́ ŋ nǝŋ, paa kǝ ŋ nya vɔrʊlaalɛɛrǝ. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Duturǝ ɖi Worokoyǝ lee kpii ne Piyǝ ŋ pǝ ǝrǝkǝ kǝ ŋ pa tɔɔ kǝla bɔrǝ. Paa saŋ rǝ no oŋuŋkǝ we, kǝ ǝrǝkǝ kǝ nya alɔkuŋkǝ. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Yǝ we ŋ na lɔ Piyǝ sa ŋ no nuŋ we, Worokoyǝ lǝŋ tɔɔ yǝ we la bɔrǝ. Paa yǝ we ŋ naa lɔ ŋ nuŋ we, Worokoyǝ la tɔɔ na bɔrǝ kaka. Duturǝ ɖi laa lɔ Worokoyǝ le Piceŋceŋyǝ we ŋ nuŋ. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Bɔrǝ we Worokoyǝ ŋ na tɔɔ ŋwǝ we, gaamǝ ɖǝ ǝnǝ: Wǝnyɩɩnɩkpǝ wǝ lǝ pǝ ǝrǝkǝ lǝ mǝrǝ, paa wǝ́ enyipǝ pǝ la taa nuŋtumuwǝ lǝ kǝǝwǝ pǝ le teeri wǝnyɩɩnɩkpǝ we. Kpiikǝ pǝlo otuyeeyǝ yǝ ri rǝ oturɔɔrɔɔyǝ kǝto. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Duturǝ ɖi nyi ri ŋ nyi ŋ née yee turɔɔrɔɔwǝ we, lǝ́ǝ kpǝlǝ wǝnyɩɩnɩkpǝ lǝ kǝǝwǝ, wǝ́ lǝŋ ru wǝnyɩɩnɩkpǝ. Duturǝ ɖi lóo suu vurǝ ǝkǝnǝŋ no oturɔɔrɔɔyǝ we yǝ lah pa nyɩnɩ. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Paa yǝ we ŋ née ri anʊkɔrǝyǝ we, lóo ru wǝnyɩɩnɩkpǝ kǝ pǝ nya fɛɛ pǝ nyɩŋ feŋteŋ ǝkǝnǝŋ lée yee no otuyeeyǝ mǝ ŋ saŋ rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ.»<verse eid="JHN 3:21" /></para>
  <para style="s">Yesu mǝ Yowanɛsɩ worokomɛŋwiiritǝyǝ we</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Rǝ wǝla kǝmaakǝ we, wǝ́ Yesu ŋ ko ŋ ko Yudeya la gaarǝ ŋpǝ mǝ no otukarǝtǝpǝ. Wǝ́ ŋ ce ŋ kolu ŋ kpìi rǝ we ŋpǝ mǝ pǝ. Wǝ́ ŋ ke ŋ wiiri enyipǝ lo worokomɛŋwǝ. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yowanɛsɩ ŋwǝ ŋkpɛ ke ŋ wiiri enyipǝ lo worokomɛŋwǝ rǝ Enɔŋ, wǝ lǝǝ lǝǝrǝ mǝ Salimǝ wǝ, duturǝ ɖi mɛŋwǝ wǝ ke kpii rǝ we ŋpa kǝto. Wǝ́ enyipǝ pǝ kǝ ŋ pǝ nǝ kpǝŋ. Wǝ́ ŋ ke ŋ wiiri pǝ lo worokomɛŋwǝ. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Eniyǝ we we, pǝ faa ka maa pǝ lɔ Yowanɛsɩ pǝ taŋ. <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Wǝ́ Yowanɛsɩ lo otukarǝtǝpǝ pǝ ke ŋ tiini dierǝ mǝ Yudatǝnyiyǝ rɛ pǝ ŋ ru rǝ ewiikǝ lo kǝsuŋkǝ. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Wǝ́ pǝ pǝlǝ pǝ tùu Yowanɛsɩ wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, a láa taalǝ nyiyǝ we ŋnǝ mǝ ŋwǝ nǝ ke kpii rǝ Yɔrǝdaŋ la kǝtakǝ nɔ wǝ? Yǝ we lo oŋuŋkǝ e rili ɖaŋsieyǝ o rù pa, a lǝŋ nyɩŋ kǝ́ ŋwǝ ŋkpɛ ŋ ya ŋ née wiiri enyipǝ lo worokomɛŋwǝ wǝ? Wǝ́ enyipǝ kpǝlo kɩɩkɩ pǝ lóo ko rǝ nǝ kpǝŋ!» <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />Wǝ́ Yowanɛsɩ ŋ yìili ǝkǝnǝŋ: «Rɛ lǝŋ koru ǝ lǝmǝ tǝrɛ, mǝŋ ŋkǝ Worokoyǝ ŋ no koonu nǝ wǝ wǝ. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Ŋnǝŋnǝ nǝ ri mǝ araŋsielǝtǝpǝ, ŋ́ na tɛŋ ǝkǝnǝŋ: “Ŋ́ nee ri Kǝrisoyǝ we. Paa pǝ le kpii mǝ ŋ́ coŋ ŋ́ koonu ŋwǝ rǝ.” <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Yǝ we ŋ lǝǝmǝ tieŋwɛŋyǝ we, ŋwǝ ŋ ri tiɛŋwɛŋlǝtǝyǝ wǝ. Paa tieŋwɛŋlǝtǝ le pwetaayǝ we, láa yaa rǝ na kǝlɛɛrɩkǝ, ŋ mǝ co kǝtukoŋkǝ rǝ ŋwǝ. Oturu la nya faawǝ ŋpa mǝ kǝ́ ŋ no nuŋ tieŋwɛŋlǝtǝ la kpɛɛwǝ wǝ. Kǝ́ mǝ faawǝ wǝ lǝ wǝǝ, wǝ lo to milimili. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Wǝ kpii kǝ na nyɩŋrǝ lǝ ŋ rɛ oŋuŋkǝ, kǝ mǝ nɛŋrǝ paa lǝ ŋ sʊʊ rǝ.»<verse eid="JHN 3:30" /></para>
  <para style="s">Yǝ we ŋ no ru rǝ yulaarǝ wǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />«Yǝ we ŋ no ru rǝ oŋuŋkǝ ŋ na sʊʊ we, teeri enyipǝ kpǝlo kɩɩkɩ. Yǝ we ŋ no ru rǝ kǝtǝǝwǝ we, ri kǝtǝǝwǝ la nɛŋ, wǝ́ láa wɛɛlɩ mǝ ŋ ru rǝ ǝkǝtǝǝtuyǝ. Yǝ we ŋ no ru rǝ yulaarǝ we, <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />lée ri ɖaŋsieyǝ mǝ ŋ ru rǝ tuwǝ we ŋ na nyɩŋ mǝ wǝ we ŋ no nuŋ wǝ. Wǝ́ rɛ lǝŋ lɔ na ɖaŋsieyǝ sa ŋ nuŋ. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Paa yǝ we ŋ na lɔ na ɖaŋsieyǝ sa we, yǝ we la tɛɛ gaapirǝ ǝkǝnǝŋ Worokoyǝ ri rǝ nʊkɔrǝlǝtǝyǝ. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Nyiyǝ we Worokoyǝ ŋ ne kpii we, láa tɛŋ rǝ Worokoyǝ le etieyǝ. Duturǝ ɖi Worokoyǝ lǝ fǝ na Wɛɛrǝ lǝ lǝǝrǝ ŋwǝ pwɩ. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Tǝyǝ láa taa Piyǝ lǝ kǝǝwǝ, wǝ́ ŋ nǝ fǝ tu ri ŋ tu ŋ ne kpii ŋwǝ rǝ akaakǝ. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Yǝ we ŋ na lɔ Piyǝ we ŋ no nuŋ we, lǝǝmǝ vɔrʊlaalɛɛrǝ. Yǝ we ŋ naa lɔ Piyǝ we ŋ nuŋ we, lǝŋ pa nya vɔrʊrǝ sa. Paa Worokoyǝ la kpɛɛmʊrʊwǝ wǝ tɛɛ rǝ ŋwǝ.»<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesu lo ku mǝ Samariatǝtieyǝ rɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Yesu nunu Afarisitǝpǝ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ ŋ ya ŋ náa nya otukarǝtǝpǝ mǝ ŋ teeri Yowanɛsɩ. Wǝ́ ŋ na lɛ ŋ ya ŋ née wiiri enyipǝ lo worokomɛŋwǝ mǝ ŋ teeri ŋwǝ. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Rǝ anʊkɔrǝyǝ we, Yesu ŋwǝŋwǝ lee ke ŋ wiiri enyipǝ lo worokomɛŋwǝ. No otukarǝtǝpǝ pǝ ke ŋ wiiri enyipǝ lo worokomɛŋwǝ wǝ. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Wǝ kǝto ŋ pwɛ̀yɩ rǝ Yudeya la gaarǝ we ŋ kpǝ̀lǝŋ ŋ ko ŋ ko Galileya la gaarǝ wǝǝ. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Paa wǝ ke kpii wǝ kòonu Yesu kǝ ŋ fǝ rǝ Samaria la gaarǝ we ŋ ka tɛlɩ mǝ ŋ ko. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Wǝ́ Yesu ŋ kolu ŋ fìi Samariatǝtǝŋtǝǝwǝ rɛ pǝ lóo pwo Sikarǝ wǝ. Wǝ lǝǝ lǝǝrǝ mǝ kǝtǝǝwǝ we Yakɔbǝ ŋ kòonu ne pi Yosɛfʊ wǝ. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Yakɔbǝ la mɛŋfuŋwǝ wǝ ka yaa rǝ fɛɛwǝ we. Anyɩŋ Yesu la saŋ la faŋ. Wǝ́ ŋ sɔ̀ ŋ tini rǝ mɛŋfuŋwǝ we la kǝlɛɛrɩkǝ. Wǝ lǝh mǝ lǝ mǝŋ cɔkɔŋtiizaarǝ.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Wǝ́ Samariatǝtieyǝ rɛ ŋ pǝlǝ ŋ pa tʊʊ mɛŋwǝ. Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Koonu mǝ mɛŋwǝ ŋ́ ŋuŋ». <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Anyɩŋ no otukarǝtǝpǝ we pǝ le fii tǝŋtǝǝwǝ we pǝ ko fuu keeriwǝ. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />Wǝ́ Samariatǝtieyǝ sa ŋ tìi Yesu ǝkǝnǝŋ: «Keyi! Eniyǝ we nɛ? Ŋlǝ́ Yudatǝpiyǝ, ǝ pǝ́ ŋmǝ Samariatǝtieyǝ la mɛŋwǝ o ŋuŋ?» Duturǝ ɖi Oyudatǝpǝ pǝ lǝŋ toomu kǝloŋkǝ rɛ mǝ Asamariatǝpǝ. <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «E keh ci Worokoyǝ lo tukoonuwǝ, mǝ nyiyǝ we ŋ ya ŋ née tíi lǝ́ ǝkǝnǝŋ “Koonu mǝ mɛŋwǝ ŋ́ ŋuŋ” we, ŋlǝ́ ǝ kǝh pǝ́ na mɛŋwǝ wǝ, kǝ ŋ koonu lǝ́ vɔrʊrǝ la mɛŋwǝ.» <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />Wǝ́ tieyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, e lee re tǝrɛ ǝ lǝh fǝ a tʊʊ, wǝ́ mɛŋfuŋwǝ sa wǝ lɛ wǝ suunu. We fǝŋ wǝ́ a lah nya ŋ wǝ vɔrʊrǝ la mɛŋwǝ sa o ru?<verse eid="JHN 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 4:12" />We e teeri lǝh tǝtǝ Yakɔbǝ, ŋ ne nyiŋ mɛŋfuŋwǝ sa ŋ no koonu lǝ wǝ? Ŋwǝŋwǝ lo ŋuŋ wǝla mɛŋwǝ. Ne epipǝ ŋpǝ ŋkpɛ pǝ lo ŋuŋ wǝ mǝŋ na akɛɛpǝ.» <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nyi ri ŋ nyi ŋ nóo ŋuŋ mɛŋwǝ sa we, kǝmɛŋtɛŋkǝ kǝ lǝ́ǝ tǝ kǝ ŋ wʊ ŋwǝ. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Paa yǝ we ŋ nóo ŋuŋ mɛŋwǝ we ŋ́ nóo koonu ŋwǝ we, kǝmɛŋtɛŋkǝ kǝ lǝŋ tǝ kǝ pa wʊ ŋwǝ pwi. Duturǝ ɖi mɛŋwǝ we ŋ́ nóo koonu ŋwǝ we, wǝ lah pa siɛrɩ wǝ yee mɛŋwǝ wǝ leh mǝ wee wǝ ŋ ru rǝ ŋwǝ, wǝ lóo koonu na vɔrʊlaalɛɛrǝ wǝ.» <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />Wǝ́ tieyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, we koonu mǝ mɛŋwǝ sa ŋ́ ŋuŋ kǝ kǝmɛŋtɛŋkǝ kǝ pǝǝ tǝ kǝ pa wʊ mǝ, kǝ ŋ́ pǝǝ tǝ ŋ́ pǝ pǝ fɛɛwǝ sa ŋ́ pa tʊʊ mɛŋwǝ».<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ko o ko pwo lo nuŋ kǝ a siɛnɩ ǝ pǝ fɛɛwǝ sa». <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />Wǝ́ tieyǝ sa ŋ yìili ǝkǝnǝŋ: «Ŋ́ nǝǝ lǝmǝ nuŋyǝ». Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «E le yee wǝ ponu kǝ́ a la tɛŋ ǝkǝnǝŋ “Ŋ́ nǝǝ lǝmǝ nuŋyǝ” wǝ. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Duturǝ ɖi a la caa ǝpǝrǝŋpǝ atʊʊ a la pa tɛlɩ. Wǝ́ pǝrǝŋyǝ we lǝ kpǝŋ e kpii rǝkǝsa we, lee ri ló nuŋyǝ. Kǝto a la tɛŋ anʊkɔrǝyǝ.» <verse eid="JHN 4:18" /><verse number="19" style="v" sid="JHN 4:19" />Wǝ́ tieyǝ sa ŋ yìili ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ worokokpɛɛnuŋtɛŋtǝyǝ wǝ́ e ri! <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Lǝh ǝtǝtǝpǝ pǝ la sʊma Worokoyǝ rǝ dutupirǝ sa. Wǝ́ ŋnǝ Oyudatǝpǝ paa nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ Yerusalɛmǝ ŋ ri fɛɛwǝ wǝ kaamǝ kǝ pǝ sʊma Worokoyǝ wǝ.» <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kuleleyǝ, lɔ mǝ dierǝ sa o nuŋ, ǝkǝnǝŋ eniyǝ yǝ lo furu, nǝ nyǝŋ tǝ nǝ pa sʊma Tǝyǝ rǝ dutupirǝ sa amaa Yerusalɛmǝ. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Ŋnǝ Asamariatǝpǝ we, nǝ ya nǝ nyáa sʊma tuwǝ nǝ nyee ci wǝ. Paa ŋlǝ Oyudatǝpǝ we, le cii tuwǝ we la ya yǝ láa sʊma wǝ. Duturǝ ɖi alɔkuŋkǝ kǝ lo ru rǝ Oyudatǝpǝ lǝ kpǝŋ. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Paa eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ, wǝ́ yǝ la marǝ yǝ lo ro, kǝ asʊmatǝpoŋpipǝ pǝ ŋ sʊma Tǝyǝ rǝ Wɛɛrǝ mǝ anʊkɔrǝyǝ. Duturǝ ɖi asʊmatǝpǝ sa wǝrʊʊkpǝ wǝ́ Tǝyǝ ŋ nǝ́ǝ pǝ́ wǝ. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Worokoyǝ ri rǝ Wɛɛrǝ. Kǝto epǝ we pǝ láa sʊma ŋwǝ we, wǝ kpii kǝ pǝ sʊma ŋwǝ rǝ Wɛɛrǝ mǝ anʊkɔrǝyǝ.» <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />Wǝ́ tieyǝ sa ŋ tìi Yesu ǝkǝnǝŋ: «Ŋ́ cii wǝ ǝkǝnǝŋ Mesiyayǝ, yǝ we pǝ lóo pwo Kǝriso we, kpii lǝ́ǝ pǝ. Vǝ́ lǝ pǝ we, lah pa pɔrʊ tu ri ŋ tu lo duturǝ ŋ tíi lǝ.» <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ yǝ sa ŋ́ ya ŋ́ náa wɛɛlɩ mǝ lǝ́ we, ŋmǝ ŋ́ ri Mesiyayǝ we».<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Eniyǝ we wǝ́ Yesu lo otukarǝtǝpǝ we pǝ pǝlǝ pǝ ko ŋ ru. Wǝ́ wǝ rili pǝlo mumuŋ kǝ́ Yesu ŋ ya ŋ náa wɛɛlɩ mǝ tieyǝ wǝ. Paape pǝla rɛ loo tu turuwǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ «Kǝ́ wǝ́ a ya lǝ́ǝ pǝ́ ŋwǝ?» amaa «Kǝ́ kǝto wǝ́ a ya láa wɛɛlɩ mǝ ŋwǝ wǝ?» <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />Wǝ́ tieyǝ sa ŋ nyàrǝ na bwɛŋpirǝ ŋ tǝ̀nǝ, wǝ́ ŋ sùu ŋ ko ŋ ko tǝŋtǝǝwǝ ŋ kolu ŋ tìi enyipǝ ǝkǝnǝŋ: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />«Nǝ pǝ nǝ pa yɩrɩ nyiyǝ rɛ re! La tɛŋ tu ri ŋ tu ŋ́ ne yee le tíi mǝ! Kǝto ŋkǝ Kǝrisoyǝ we ŋ lǝǝwe?» <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Wǝ́ enyipǝ pǝ rù rǝ tǝŋtǝǝwǝ sa pǝ kǝ ŋ pǝ Yesu lǝ kpǝŋ. <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />Eniyǝ we mǝrǝ we, anyɩŋ otukarǝtǝpǝ we pǝ ya pǝ láa tɔɔ pǝ ŋ kpɛɛ Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, dɔɔkpɛ pǝ e pe ri.» <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ lǝǝmǝ keeriwǝ rɛ ŋ́ neh ri nǝ nyee ci wǝ». <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />Wǝ́ otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Amaa rɛ lo po koonu ne keeriwǝ?» <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ keeriwǝ wǝ kaamǝ ŋ́ yee yǝ we ŋ ne kpii mǝ ŋ na maŋ lǝ kǝǝpǝ́wǝ, kǝ ŋ́ yee na kǝnǝnɛkǝ. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Mǝŋkǝ ŋnǝŋnǝ nǝ nyáa tɛŋ ǝkǝnǝŋ: “Wǝ lo tuuru akɛɛnyɔŋpǝ eniǝ ko eniyǝ we eniŋceyǝ yǝ lo ro”? Paa ŋmǝ ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ nǝ yiili nǝ yɩrɩ wǝtɛɛkpǝ re, ekeeripiyǝ yǝ la yɔɔ kaka kǝ pǝ ce yǝ! <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Cetǝyǝ we marǝ ya láa lɔ no wǝtoomwarakpǝ kaka. Wǝ́ ŋ ya ŋ náa ca epiyǝ we lo kuwǝ koonu vɔrʊlaalɛɛrǝ. Mǝŋkǝsa we, yǝ we ŋ na caŋ, mǝ yǝ we ŋ ne ce we, pǝ láa nya faawǝ fɛɛceŋceŋ. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Duturǝ ɖi duturǝ we pǝ láa ca ǝkǝnǝŋ: “Rɛɛyǝ láa caŋ, rɛɛyǝ ŋ pe ce” we, kǝceece wǝ lǝǝwe. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ŋ́ ne kpii nǝ nǝ ke ce keeriwǝ rǝ atɛɛkǝ nǝ nyaa nyɩŋ aria nǝ kpɛŋ wǝ. Enyipʊŋpwapǝ pǝ la kpɛŋ kǝ pǝ la faŋ. Wǝ́ ŋnǝ paa nǝ ya nǝ nyáa nya vasʊyǝ nǝ nyǝ ŋ ru rǝ pǝla vaŋrǝ.»<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Wǝ́ Asamariatǝpǝ wa rǝ tǝŋtǝǝwǝ sa, pǝ lɔ̀ Yesu pǝ nunu, rǝ tieyǝ we la ɖaŋsieyǝ ŋ rili kǝto. Tɛnɩ ǝkǝnǝŋ: «La tɛŋ tu ri ŋ tu ŋ́ ne yee le tíi mǝ». <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Kǝto kǝ́ Asamariatǝpǝ sa pǝ lo po tuu ŋwǝ we, wǝ́ pǝ tɔ̀ɔ pǝ kpɛlɩ ŋwǝ ŋ tii pǝlǝ kpǝŋ. Wǝ́ Yesu ŋ tini pǝlǝ kpǝŋ wǝcukpǝ wǝyi. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Wǝ́ enyipʊŋpwapǝ wa ŋpǝ ŋkpɛ pǝ tǝ pǝ lɔ̀ Yesu pǝ nunu rǝ ŋwǝŋwǝ ne etieyǝ ŋ tɛnɩ kǝto. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Wǝ́ pǝ ke ŋ tíi tieyǝ we ǝkǝnǝŋ: «Rǝkǝsa we, ŋkǝ lé etieyǝ we e le pe tíi lǝ sɔŋ kǝto wǝ́ yǝ la lɔ yǝ lo nuŋ oo. Ŋlǝŋlǝ yǝ lo po nuŋ ŋwǝ. Wǝ́ yǝ le ci wǝ ǝkǝnǝŋ ri ǝrǝkǝ la Lɔkuŋtǝyǝ kǝceece.»<verse eid="JHN 4:42" /></para>
  <para style="s">Yesu la cá nǝnɛyeetǝmumuŋyǝ rɛ le piyǝ</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matewu 8:5-13</ref>, <ref loc="LUK 7:1-10">Luka 7:1-10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Juuyi la kǝmaakǝ we, wǝ́ Yesu ŋ pwɛ̀yɩ rǝ fɛɛwǝ sa ŋ ko ŋ ko Galileya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Ŋwǝŋwǝ tɛnɩ wǝ ǝkǝnǝŋ: «Pǝ lǝŋ kǝ worokokpɛɛnuŋtɛŋtǝyǝ rɛ rǝ ŋwǝŋwǝ nǝ gǝŋrǝ pwi». <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Paape kǝ́ ŋ ne ke fii Galileya la gaarǝ we we, wǝ́ Agalileyatǝpǝ pǝ lɔ̀ nǝ kǝsǝǝkǝ sɩsiɛrɩ. Duturǝ ɖi ŋpǝ ŋkpɛ pǝ kolu eyinyapǝkǝ la wǝcɛkpǝ sa rǝ Yerusalɛmǝ. Wǝ́ pǝ nyɩnɩ otuyǝ we kpǝlo kɩɩkɩ Yesu ŋ yeli wǝ.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Wǝ́ Yesu ŋ tǝ ŋ sìɛnɩ ŋ kolu Kana, wǝ kpii rǝ Galileya la gaarǝ wǝ. Fɛɛwǝ ŋ sìɛrɩ mɛŋwǝ ŋ yeli vɛŋyǝ wǝǝ. Piliyǝ la nǝnɛyeetǝmumuŋyǝ rɛ ke kpii rǝ Kapɛrǝnawumǝ. Ne piyǝ laa ka kpaa. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Kǝ́ ŋ no nuŋ ǝkǝnǝŋ Yesu lo ru rǝ Yudeya lǝ pǝ pǝ Galileya we, wǝ́ ŋ pǝlǝ ŋ nyɩnɩ ŋwǝ. Wǝ́ ŋ tɔ̀ɔ ŋ kpɛlɩ ŋwǝ ŋ pǝ Kapɛrǝnawumǝ ŋ pa cá ne pi bǝrǝŋpirǝ ga kpɛlɩ gǝ ŋ kpǝ́ ŋ koonu ŋwǝ. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ nǝ nyaa nyɩŋ otucovurǝ mǝ otumumuŋyǝ, nǝ nyǝŋ lɔ nǝ nuŋ pwi!» <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />Wǝ́ nǝnɛyeetǝmumuŋyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ ǝ lǝǝ fǝǝlǝ we, mǝ piyǝ lǝ́ǝ kpǝ́!» <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ ko, lé piyǝ kpii vɔrʊrǝ». Wǝ́ nyiyǝ sa ŋ lɔ̀ dierǝ we Yesu ŋ tìi ŋwǝ ŋ nunu. Wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Kpii lóo ko mǝ gʊŋrǝ wǝ́ na asʊmatǝpǝ pǝ pǝlǝ pǝ kùu mǝ ŋwǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Lé piyǝ la fɔrʊ!» <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Wǝ́ ŋ pǝ̀ pǝ le eniyǝ piyǝ we la wɛɛwǝ wǝ cò na garǝ wǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ǝsǝǝkǝ, oturu wǝ la ca ɖiɔrǝ le enisǝsǝŋyǝ wǝ́ wɛɛkuunaawǝ we wǝ cɛ̀ rǝ ŋwǝ». <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Wǝ́ piyǝ sa lǝ tǝ ŋ nyɩnɩ ŋ cìi ǝkǝnǝŋ eniyǝ we tutu wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lé piyǝ la fɔrʊ». Fǝ rǝ eniyǝ we wǝ́ ŋpǝ mǝ na nyarǝwǝ kpǝlo kɩɩkɩ pǝ lɔ̀ pǝ nunu. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Ŋ wǝ tuwǝ sa ǝnǝ wǝ ke ri tucovuyitǝwǝ Yesu ŋ yeli kǝ́ ŋ rù rǝ Yudeya ŋ kpǝ̀lǝŋ ŋ pǝlǝ Galileya wǝǝ.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesu la cá sǝŋyǝ rɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Oyudatǝpǝ pǝ ke ŋ ri pǝla wǝcɛkpǝ rɛ rǝ Yerusalɛmǝ, wǝ́ Yesu ŋ kolu. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Puŋkɔwǝ rɛ wǝ ka yaa rǝ Yerusalɛmǝ, rǝ guŋpolurǝ we pǝ lóo pwo «Amɛɛpǝ lo guŋpolurǝ» la kǝlɛɛrɩkǝ. Pǝ lóo pwo puŋkɔwǝ sa mǝ Kǝhebǝritǝkǝ ǝkǝnǝŋ Bɛtǝzata<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Rǝ wǝŋʊrʊkuukuurɛɛkpǝ lǝ mǝrǝ we, pǝ la ŋʊrʊ ǝkǝnǝŋ «Betɛsǝda».</char></note>. Puŋkɔwǝ sa wǝ kǝ lǝǝmǝ fɛɛlǝwǝ tʊʊ. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Nyaatǝkpǝŋmumuŋwǝ rɛ wǝ lǝ̀ afɛɛlǝyǝ sa wǝ ka kpɛlɩ: alaanyɩŋtǝpǝ, ǝsǝ́ŋpǝ mǝ epǝ we pǝ lǝ kpǝ́ otoŋyǝ wǝ. Pǝ kǝ ŋ rǝŋ mɛŋwǝ we wǝ kutu. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Duturǝ ɖi enirɛɛyǝ we, Ǝtǝ Woroko le picoŋpiyǝ rɛ láa sʊʊ mǝ ŋ pǝ mǝ ŋ kutu puŋkɔwǝ sa la mɛŋwǝ. Nyaatǝyǝ lǝ yǝ ŋ nǝ sǝŋ ke fii mɛŋwǝ sa wǝ lo kutu we, na nyarǝpirǝ gǝ tǝ lǝ nɛ, láa kpaa.<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Fɛɛkǝtatǝwǝ la kǝlɛɛkǝ mǝ fɛɛkǝniǝtǝwǝ we, wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ wa lǝ mǝrǝ.</char></note> <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Nyiyǝ rɛ ke kpii rǝ pǝlǝ mǝrǝ. Lǝ kpǝ́ otoŋyǝ cɛŋwǝ tǝta mǝ nɛŋ milimili. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Wǝ́ Yesu ŋ nyɩnɩ ŋwǝ kǝ́ ŋ kpɛlɩ wǝ. Kǝ́ ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ la tɔ nyarǝpirǝ sa wǝ la marǝ wǝ la panǝ we, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ǝ lǝ́ǝ pǝ́ a kpaa?» <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />Wǝ́ nyaatǝyǝ sa ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ nǝǝ lǝmǝ rɛ ŋ nǝh fǝ mǝ ŋ kpii rǝ puŋkɔwǝ sa. Vǝ́ eniyǝ we mɛŋwǝ sa wǝ le tie okutukǝ we, o po nuŋ ŋ́ née yi mǝ ŋ ko we, rɛ lo coŋ mǝ e ke fii.» <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi, fǝ lǝ́ vǝŋkǝrǝ kǝ a mǝ saŋ». <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Rǝ kǝyaakǝ we, wǝ́ kɛrɩyǝ sa ŋ kpàa. Wǝ́ ŋ fǝ̀ nǝ vǝŋkǝrǝ wǝ́ ŋ ka ŋ saŋ. Jirǝ we we, sabatǝyǝ le jirǝ gǝ lǝǝwe.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />Wǝ́ Oyudatǝpǝ lo omumuŋpǝ pǝ ke ŋ tíi nyiyǝ sa ŋ na kpaa ǝkǝnǝŋ: «Sabatǝyǝ le jirǝ lǝǝwe, gʊŋrǝ lee kpii e lée re lǝ́ vǝŋkǝrǝ.» <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />Wǝ́ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Nyiyǝ we ŋ na cá mǝ we, ŋwǝ ŋ ne tíi mǝ ǝkǝnǝŋ: “Fǝ lǝ́ vǝŋkǝrǝ kǝ a mǝ saŋ”». <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />Wǝ́ enyipǝ sa pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Ǝlǝ ŋ kaamǝ nyiyǝ we ŋ ne tíi lǝ́ ǝkǝnǝŋ: “Fǝ lǝ́ vǝŋkǝrǝ kǝ a mǝ saŋ” wǝ?» <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />Paa nyiyǝ sa ŋ na kpaa we, lee ke ci yǝ we ŋ cà ŋwǝ wǝ. Duturǝ ɖi Yesu màrǝ cɛ̀ wɛɛwǝ rǝ nyikpǝŋwǝ we wǝ ka yaa rǝ fɛɛwǝ we lǝ mǝrǝ. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />Wǝla kǝmaakǝ we, wǝ́ Yesu ŋ kolu ŋ nyɩnɩ ŋwǝ rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «A la nyɩŋ, rǝkǝsa a la kpaa! Pǝǝ tǝ e yee turɔɔrɔɔwǝ o. Mǝŋ ŋkǝ kaa wǝǝ, tuwǝ wǝ lǝ́ǝ pǝ wǝ tuu lǝ́ we, wǝ lǝ́ǝ pǝlǝ wǝ teeri!» <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Wǝ́ nyiyǝ sa ŋ kolu ŋ tìi Oyudatǝpǝ lo omumuŋpǝ we ǝkǝnǝŋ Yesu ŋ na ca ŋwǝ wǝ. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Fǝ ǝrǝ eniyǝ we, wǝ́ Oyudatǝpǝ pǝ yili pǝ tɛ̀ɛ rǝ Yesu mǝ kǝ́ ŋ yeli tuwǝ sa mǝ sabatǝyǝ le jirǝ kǝto. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ Tǝ re yaa mǝ kǝnǝnɛkǝ po ro ruŋruŋ, wǝ́ ŋmǝ ŋkpɛ ŋ́ re ŋ́ yaa mǝ kǝnǝnɛkǝ». <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />Dierǝ sa kǝto wǝ́ Oyudatǝmumuŋpǝ pǝ tǝ pǝ ka ŋ nyɩɩ pǝ ŋ taa akʊŋyǝ kǝ pǝ wʊ Yesu taa. Duturǝ ɖi ŋkǝ sabatǝyǝ le seyǝ we ko wǝ́ ŋ tɔ̀ɔ wǝ! Otukpǝlo we, yà ko ŋ pwo Worokoyǝ ǝkǝnǝŋ nǝ Tǝ mǝtǝyǝ. Mǝŋkǝsa we, anyɩŋ ya lǝ́ǝ fǝ na wɛ mǝ ŋ kaamǝ Worokoyǝ rǝ.<verse eid="JHN 5:18" /></para>
  <para style="s">Worokoyǝ lǝ fǝ no okopiyǝ kpǝlo lo koonu ne Piyǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Wǝ́ Yesu ŋ lɔ̀ kpɛɛwǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, Piyǝ ŋwǝŋwǝ lǝŋ koru eyi ko, kǝ mǝ ŋ yee tǝrɛ rǝ! We tuwǝ we ŋ na nyɩŋ Tǝyǝ ŋ ya ŋ née yee ceŋceŋ. Tuwǝ we Tǝyǝ ŋ ya ŋ née yee we, Piyǝ ŋwǝ ŋkpɛ lée yee wǝ. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Duturǝ ɖi Tǝyǝ láa taa Piyǝ lǝ kǝǝwǝ ŋpa. Kǝto tu ri ŋ tu ŋwǝŋwǝ ŋ née yee we, láa kaŋ Piyǝ lǝ wǝ. Wǝ́ lǝh pǝ tǝ ŋ kaŋ na anǝnɛyǝ ŋ yee ŋ teeri ǝyǝ ǝnǝ, wǝ lée ri nǝ mumuŋ! <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Duturǝ ɖi mǝŋ kǝ́ Tǝyǝ ŋ náa saanǝ enyiǝtǝpǝ ŋ koonu pǝla vɔrʊrǝ we, kaa wǝǝ Piyǝ ŋ nóo koonu yǝ we ŋ ponu mǝ ŋwǝ la vɔrʊrǝ wǝǝ. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Tǝyǝ lǝŋ tɛŋ rɛ la wǝkpaŋkpǝ. Paa lǝ fǝ okopiyǝ kpǝlo kɩɩkɩ le kpii Piyǝ rǝ akaakǝ ŋ tɛŋ akpaŋyǝ. <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />Kǝ enyipǝ kpǝlo kɩɩkɩ pǝ nya fɛɛ pǝ ŋ pu Piyǝ mǝŋ kǝ́ pǝ lóo pu Tǝyǝ kǝtǝ. Yǝ we ŋ nǝŋ pu Piyǝ we, we lǝŋ pu Tǝyǝ we ŋ ne kpii Piyǝ wǝ.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, yǝ we ŋ nóo nuŋ mǝ kpɛɛwǝ wǝ́ ŋ na lɔ nyiyǝ we ŋ ne kpii mǝ ŋ no nuŋ we, Yǝ we la nya vɔrʊlaalɛɛrǝ. Pǝ lǝŋ pa tɔɔ na bɔrǝ. Paa lo ru rǝ gbɛŋrǝ lo ko vɔrʊrǝ. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, Eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ, wǝ́ yǝ la marǝ yǝ lo ro, kǝ enyiǝtǝpǝ pǝ nuŋ Worokoyǝ le Piyǝ la kpɛɛwǝ. Epǝ we pǝ lóo nuŋ wǝ we, pǝ lée tii vɔrʊrǝ. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Duturǝ ɖi, mǝŋ kǝ́ Tǝyǝ ŋ lǝǝmǝ vɔrʊrǝ rǝ ŋwǝŋwǝ na wɛ lǝ mǝrǝ we, kǝ́ ŋ no koonu Piyǝ ŋ lǝmǝ rǝ rǝ na wɛ lǝ mǝrǝ wǝǝ. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Lo koonu Piyǝ lo okopiyǝ ŋ tɛŋ akpaŋyǝ kpiikǝ ŋwǝ ŋ ri Nyɩmaasɩ le Pi wǝ. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Tuwǝ sa kpǝlo kɩɩkɩ wǝ pee ri nǝ mumuŋ! Eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ kǝ epǝ we kpǝlo kɩɩkɩ pǝ kpɛlɩ rǝ wǝfuŋkpǝ lǝ mǝrǝ pǝ nuŋ Nyɩmaasɩ le Pi la kpɛɛwǝ, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />kǝ pǝ ru pǝ pǝ. Epǝ we pǝ le yee eceeceeyǝ we, pǝ láa saanǝ kǝ pǝ tii vɔrʊrǝ. Paa epǝ we pǝ le yee oturɔɔrɔɔyǝ we, pǝ láa saanǝ, kǝ ŋ tɔɔ pǝ la bɔrǝ. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Ŋmǝ we, ŋ́ nǝŋ koru tǝrɛ le eyee rǝ ŋmǝŋmǝ mǝ okopiyǝ. Ŋ́ náa tɛŋ wǝkpaŋkpǝ mǝ ŋ saŋ rǝ tuwǝ we ŋ́ no nuŋ ŋ́ no ru rǝ Worokoyǝ lǝ kpǝŋ wǝ. Wǝ́ mǝ wǝkpaŋtɛŋkpǝ wǝ kʊʊ. Duturǝ ɖi ŋ́ nǝŋ taa ŋ́ yee ŋmǝŋmǝ mǝ kǝǝpǝ́wǝ. Paa yǝ we ŋ ne kpii mǝ lǝ kǝǝpǝ́wǝ wǝ́ ŋ́ née yee. <verse eid="JHN 5:30" /><verse number="31" style="v" sid="JHN 5:31" />Mǝŋ ŋmǝŋmǝ ŋ́ keh mǝ ri mǝ wɛ la ɖaŋsieyǝ we, mǝ ɖaŋsieyǝ sa lǝŋ ke ri anʊkɔrǝyǝ. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Paa nyipʊŋpwayǝ ŋ ya ŋ née ri ɖaŋsieyǝ mǝ ŋ koonu mǝ. Wǝ́ ŋ́ cii wǝ ǝkǝnǝŋ tuwǝ we ŋ ya ŋ náa tɛŋ mǝ ŋ ru rǝ mǝ we, anʊkɔrǝyǝ yǝ lǝǝwe. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Nǝ nye kpii enyipǝ nǝ nya maŋ Yowanɛsɩ. Wǝ́ ŋ ne ri ɖaŋsieyǝ ŋ no ru rǝ anʊkɔrǝyǝ lo oŋuŋkǝ. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ŋmǝ we, ŋ́ nǝǝ pǝ́ rɛ ŋ ri ɖaŋsieyǝ ŋ ru rǝ mǝ oŋuŋkǝ. Paape ŋ ya ŋ́ náa wɛɛlɩ ǝnǝ we, kǝ nǝ nya fɛɛ nǝ nya alɔkuŋkǝ rǝ. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yowanɛsɩ kǝ lǝ rǝ mǝŋ kaŋrewǝ pǝ lo too wǝ ya wǝ láa nyɩnɩ wǝ. Wǝ́ nǝ tɛ̀ɛnɩ nǝ nya faawǝ rǝ na wǝnyɩɩnɩkpǝ we, rǝ enipiyǝ rɛ lǝ mǝrǝ ko. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Paa ŋmǝ we, ŋ́ lǝǝmǝ ɖaŋsieyǝ ŋ naanǝ ŋ teeri Yowanɛsɩ la nɛŋyǝ. Duturǝ ɖi anǝnɛyǝ we Tǝyǝ ŋ ne kpii mǝ ŋ́ pe yee, ǝkǝ ŋ́ ya ŋ́ née yee we, ŋyǝŋyǝ yǝ ya yǝ lée ri ɖaŋsieyǝ yǝ ŋ ru rǝ mǝ, ǝkǝnǝŋ Tǝyǝ ŋ ne kpii mǝ. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Wǝ́ Tǝyǝ we ŋ ne kpii mǝ we, ŋwǝŋwǝ ya lée ri ɖaŋsieyǝ mǝ ŋ koonu mǝ. Paa nǝ foo nuŋ na kpɛɛwǝ nǝ tǝnǝ. Wǝ́ nǝ faa lɛ nǝ nyɩŋ na anyɩŋkǝ nǝ tǝnǝ. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Ne dierǝ lee kpii rǝ nǝ mǝrǝ. Kpiikǝ nǝ nyaa lɔ yǝ we Worokoyǝ ŋ ne kpii ŋ na maŋ nǝ nuŋ kǝto. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Nǝ ya nǝ nyée kpii nimirǝ nǝ nyǝ ŋ karǝ otuyǝ rǝ Wǝŋʊrʊkenikenikpǝ lǝ mǝrǝ ŋpa. Kpiikǝ nǝ ya nǝ nyóo pu wǝ ǝkǝnǝŋ ŋnǝ nǝ nyáa nya vɔrʊlaalɛɛrǝ rǝ wǝlǝ mǝrǝ! Ŋkpǝ Wǝŋʊrʊkenikenikpǝ we wǝ ya wǝ lée ri ɖaŋsieyǝ wǝ ŋ ru rǝ mǝ wǝ. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Paape nǝ nyǝ sǝ́ŋ nǝ nyǝŋ pǝ mǝ kpǝŋ kǝ nǝ nya ŋrǝ vɔrʊrǝ sa.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Ŋ́ nǝǝ pǝ́ anyɩmaasɩpǝ pǝ kǝ mǝ. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Wǝ́ paa, ŋ́ cii nǝ! Ŋ́ cii wǝ ǝkǝnǝŋ Worokoyǝ lǝ kǝǝwǝ wǝ lee kpii rǝ nǝ mǝrǝ. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ŋ́ nǝ pǝ rǝ mǝ Tǝ la nyɩŋrǝ. Wǝ́ nǝ nyǝ sǝ́ŋ nǝ nyaa lɔ mǝ kǝsǝǝkǝ. Paa mǝŋ rɛ lǝ pǝ rǝ ŋwǝŋwǝ na nyɩŋrǝ we, nǝ nyáa lɔ yǝ we! <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Nǝ nyǝ́ǝ pǝ́ nǝ mǝ kǝ awɛ. Paa nǝ nyǝŋ taa ǝkǝkǝ we kǝ lo ru rǝ Worokoyǝ ceŋceŋ lǝ kpǝŋ wǝ. Kǝto nǝ nyée yee nɛ kǝ nǝ koru alɔ mǝ nǝ nuŋ?<note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false">Fɛɛkǝtǝniǝ mǝ niǝtǝwǝ sa lǝ kǝtǝǝlǝkǝ sa kǝ lee kpii rǝ wǝŋʊrʊrɛɛkpǝ lǝ mǝrǝ.</char></note> <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Nǝ pǝǝ kǝ wǝ ǝkǝnǝŋ ŋmǝ ŋ́ neh ke kpii nǝ wǝkpaŋkpǝ rǝ Tǝyǝ la kǝnyɩŋkǝ o. Mose yǝ we nǝ nya tɛɛ kpɛɛwǝ nǝ tini we, ŋwǝ ŋ neh ke kpii nǝ wǝkpaŋkpǝ wǝ. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Mǝŋ nǝ nya ka lɔ Mose nǝ nyo nuŋ kǝceece we, nǝ kah lɔ mǝ nǝ nuŋ. Duturǝ ɖi Mose la ŋʊrʊ lo ru rǝ mǝ rǝ na wǝfwɛɛkpǝ lǝ mǝrǝ. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Wǝ́ mǝŋ nǝ nyaa lɔ otuyǝ we ŋ na ŋʊrʊ nǝ nuŋ wǝǝ, nǝ nyée yee nɛ kǝ nǝ pa lɔ tuwǝ sa ŋ́ ya ŋ́ náa tɛŋ nǝ nuŋ wǝ?»<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesu lo koonu enyipǝ lafawǝ tʊʊ le keeriwǝ</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matewu 14:13-21</ref>, <ref loc="MRK 6:30-44">Marǝko 6:30-44</ref>, <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Yesu ŋ ka ŋ ta Galileya lo puŋkɔwǝ ŋ ko wǝla kǝtakǝnɔ. Puŋkɔwǝ sa wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo ǝkǝnǝŋ Tiberia lo puŋkɔwǝ. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ yili wǝ sìimǝ ŋwǝ. Duturǝ ɖi pǝ nyɩnɩ otucovurǝ ŋ yà ŋ ke ŋ yee kǝ́ ŋ ya ŋ náa cá anyaatǝpǝ wǝ. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Wǝ kǝto Yesu ŋ rɛ̀ dutupirǝ ŋ kolu ŋ tini ŋpǝ mǝ no otukarǝtǝpǝ wǝǝ. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Oturu Oyudatǝpǝ la wǝcɛkpǝ we pǝ lóo pwo Eyinyapǝkǝ wǝ lǝ kǝlǝ. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Kǝ́ Yesu ŋ ne yiili anyɩŋkǝ we, wǝ́ ŋ nyɩnɩ kǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ lǝ́ǝ pǝ rǝ nǝ kpǝŋ wǝ. Wǝ́ ŋ pǝ̀ Filipo ǝkǝnǝŋ: «Fǝŋ wǝ́ yǝ lah nya kpɔnɔyǝ lo fuu lo koonu enyipǝ sa kǝ pǝ ri?» <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yesu pǝ̀ dierǝ sa kǝ ŋ ta Filipo lo nyuŋkpǝ ŋ yɩrɩ rǝ. Duturǝ ɖi Yesu ke cìi tuwǝ ŋwǝŋwǝ ŋ neh yee wǝ. <verse eid="JHN 6:6" /><verse number="7" style="v" sid="JHN 6:7" />Wǝ́ Filipo ŋ tìi ŋwǝ ǝkǝnǝŋ: «Le ke ce lo fuu kpɔnɔyǝ sɩkakpotokpotoyǝ<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Rǝ Yesu le diirǝ we, sɩkakpotokpotoyǝ ceŋceŋ ŋ ke ri nǝnɛyeetǝyǝ lo wǝtoomwarakpǝ rǝ jɔkɔŋcirǝ.</char></note> tuuruyi we, wǝ lǝŋ ro kǝ nyi ri ŋ nyi ŋ lɔ gbɔnɔtoopirǝ ǝkǝŋtǝ.» <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />Wǝ́ no otukarǝtǝpǝ we la rɛɛyǝ, pǝ lóo pwo Aŋdǝre, Sɩmɔ Pɛtǝro la paanʊyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />«Kosopiyǝ rɛ re kpɔnɔyǝ tʊʊ mǝ wǝpwɛɛkpǝ wǝyi rǝ sa. Paape wǝ lóo ro nyiyɔwǝ sa lǝ fǝŋ?» <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ tíi enyipǝ we kpǝlo kɩɩkɩ pǝ sɔ pǝ tii.» Bɔɔrǝ ge kpii rǝ fɛɛwǝ we ŋpa. Wǝ́ kǝceece pǝ sɔ̀ pǝ tini. Pǝ lǝh mǝ lǝ mǝŋ ǝpǝrǝŋpǝ lafawǝ tʊʊ. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Wǝ́ Yesu ŋ fǝ̀ kpɔnɔyǝ we, wǝ́ ŋ cèeni Worokoyǝ. Wǝ́ ŋ fǝ̀ ŋ sǝ̀pǝ enyipǝ we pǝ ke tini wǝ. Wǝ́ ŋ yeli mǝ wǝpwɛɛkpǝ we wǝ ŋkpɛ mǝŋ kɔɔwe. Wǝ́ ŋ sǝ̀pǝ kpǝ ŋ kòonu pǝ. Wǝ́ nyi ri ŋ nyi ŋ lɔ̀ mǝŋ kǝ́ ŋ nǝ pǝ wǝ. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Kǝ́ pǝ le ri pǝ lo wu pǝ la lɛ we, wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: «Nǝ rɛmɩ otoopiyǝ we yǝ lo tuuru wǝ, tǝrɛ wǝ pǝǝ lǝ.» <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Wǝ́ pǝ wʊ̀ʊ kpɔnɔyǝ we tʊʊyǝ pǝ rili lo otoopiyǝ we yǝ tùuru wǝ. Wǝ́ yǝ lǝ̀ kɛŋtɛwǝ tǝ mǝ yi. <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />Kǝ́ enyipǝ pǝ la nyɩŋ tucovurǝ sa Yesu ŋ yeli we, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Kǝceece nyiyǝ sa ri worokokpɛɛnuŋtɛŋtǝyǝ. Yǝ we ŋ nǝh pǝ ǝrǝkǝ wǝ.» <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Wǝ́ Yesu paa ŋ nyɩnɩ wǝ ŋ cìi ǝkǝnǝŋ pǝ lǝh pǝ pǝ pa lɔ ŋwǝ pǝ tiini wǝpilikpǝ. Wǝ́ ŋ tǝ ŋ pwɛ̀yɩ ŋ kolu ŋ kpìi rǝ otutupikpaŋyǝ ŋwǝ ceŋceŋ.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesu la saŋ rǝ mɛŋwǝ lo oŋuŋkǝ</para>
  <para style="r">(<ref loc="MAT 14:22-27">Matewu 14:22-27</ref>, <ref loc="MRK 6:45-52">Marǝko 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Kǝ́ wǝ lo ro ɖiɔrǝ we, wǝ́ no otukarǝtǝpǝ we pǝ sʊ̀ʊ pǝ pǝlǝ ǝrǝ puŋkɔwǝ we la kǝlɛɛrɩkǝ. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Wǝ́ pǝ fìi gʊrɔrǝ pǝ ka ŋ ta puŋkɔwǝ sa pǝ ko Kapɛrǝnawumǝ. Oturu ǝrǝkǝ kǝ la marǝ kǝ la cɩɩ. Yesu faa ka maa ŋ po tuu pǝ. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Wǝ́ ǝrǝkǝ kǝ pǝlǝ kǝ ko ŋ fuŋ mǝ okopiyǝ. Wǝ́ puŋkɔwǝ we la mɛŋwǝ wǝ ke ŋ yi wǝ ŋ ca. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Otukarǝtǝpǝ sa pǝ màrǝ pǝ càa gʊrɔrǝ sa pǝ rùu pǝ kolu, wǝ lǝ́ǝ lǝ mǝŋ kpaarayǝ tʊʊ amaa kʊʊraŋ. Wǝ́ pǝ nyɩnɩ kǝ́ Yesu ŋ sanǝ rǝ mɛŋwǝ we lo oŋuŋkǝ ŋ nǝ́ǝ pǝ rǝ gʊrɔrǝ we lǝ kpǝŋ wǝ. Wǝ́ vurǝ vìi pǝ. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Paa wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ lǝǝwe, nǝ poo suu vurǝ!» <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Wǝ́ otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ pǝ fǝ ŋwǝ pǝ kpii rǝ gʊrɔrǝ we. Kǝtǝrǝ ceŋceŋ wǝ́ gʊrɔrǝ we golu ɖò kǝpǝŋpǝŋkǝ rǝ fɛɛwǝ we pǝ ko ŋ ko wǝ.<verse eid="JHN 6:21" /></para>
  <para style="s">Kǝnyikpǝŋkǝ we kǝ ya kǝ láa taa Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Nyikpǝŋwǝ we wǝ tùumǝ wǝ yàa rǝ puŋkɔwǝ sa la kǝtakǝ nɔ. Kǝ́ ǝrǝkǝ kǝ la kaalǝ we, wǝ́ enyipǝ sa pǝ nyɩnɩ ǝkǝnǝŋ gʊrɔrǝ jeŋceŋ ko ga kpɛlɩ rǝ fɛɛwǝ we. Pǝ ke cii wǝ ǝkǝnǝŋ Yesu lee fii gʊrɔrǝ we ŋ kʊla mǝ no otukarǝtǝpǝ we. Paa ŋpǝ sɔŋ pǝ fìi rǝ pǝ pwɛ̀yɩ. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Paa akʊrɔpʊŋpwayǝ rɛ yǝ rù rǝ Tiberia yǝ pǝlǝ yǝ yàa rǝ puŋkɔwǝ we lǝ kǝpǝŋpǝŋkǝ. Rǝ fɛɛwǝ we Kulǝtǝyǝ ŋ mwɛnɩ nyuŋkpǝ ŋ cèeni Worokoyǝ ŋ tɛ̀ɛ rǝ kpɔnɔyǝ ǝkǝ enyipǝ pǝ rili we, la kǝlɛɛrɩkǝ.<verse eid="JHN 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 6:24" />Kǝ́ nyikpǝŋwǝ we wǝ la nyɩŋ ǝkǝnǝŋ Yesu laa yaa rǝ we, wǝ́ no otukarǝtǝpǝ we ŋpǝ ŋkpɛ pǝ laa yaa we, wǝ́ pǝ fìi akʊrɔyǝ pǝ kǝ ŋ pǝ Kapɛrǝnawumǝ pǝ pa taa Yesu. <verse eid="JHN 6:24" /><verse number="25" style="v" sid="JHN 6:25" />Kǝ́ pǝ la pa nyɩŋ ŋwǝ rǝ puŋkɔwǝ we la kǝtakǝ sa we, wǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, eniyǝ rǝ fǝŋ wǝ́ e le pe fii sa?» <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋkǝ kǝ́ nǝ nya nyɩŋ otucovurǝ kǝto wǝ́ nǝ taa mǝ nǝ nyáa tɛlɩ o. Paa kpɔnɔyǝ we nǝ nye ri nǝ nyo wu kǝto. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Nǝ paa mǝ fia koonu keeriwǝ we wǝ lǝ́ǝ pǝlǝ wǝ. Paa nǝ mǝ fia koonu keeriwǝ we wǝ láa kpɛɛ ko ru ǝrǝ vɔrʊlaalɛɛrǝ wǝ. Keeriwǝ sa wǝ́ Nyɩmaasɩ le Pi ŋ noh po koonu nǝ wǝ. Duturǝ ɖi ŋwǝ wǝ́ Worokoyǝ we ŋ ri Tǝyǝ we, ŋ na tɛɛ akaakǝ wǝ.» <verse eid="JHN 6:27" /><verse number="28" style="v" sid="JHN 6:28" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ yǝ lée yee kǝ la nya fɛɛ le mǝ yee Worokoyǝ la anǝnɛyǝ?» <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Kǝnǝnɛkǝ we Worokoyǝ ŋ nǝ́ǝ pǝ́ we, kǝ kaamǝ ǝkǝnǝŋ ŋnǝ nǝ lɔ nyiyǝ we ŋ ne kpii ŋ na maŋ we, nǝ nuŋ.» <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́, kǝ́ lo tucovurǝ wǝ́ e leh yee a kaŋ lǝ, kǝ la nya fɛɛ la lɔ lǝ́ lo nuŋ wǝ? Kǝ́ la kǝnǝnɛ wǝ́ e leh yee? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Lǝh ǝtǝtǝpǝ pǝ rili manayǝ<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false">Manayǝ ŋ kaamǝ keeriwǝ we Isǝrayɛlǝtǝpǝ pǝ ke ŋ ri rǝ nyɔŋkpaakǝtǝǝwǝ. Wǝ ko ŋ ru rǝ yulaarǝ wǝ ŋ sʊʊ. </char></note> rǝ nyɔŋkpaakǝtǝǝwǝ. Mǝŋ kǝ́ pǝ la ŋʊrʊ wǝ pǝ lǝ tǝnǝ kǝtǝ ǝkǝnǝŋ: “Lo koonu pǝ le keeriwǝ we wǝ lo ru rǝ yulaarǝ pǝ ri.”» <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋkǝ Mose ŋ kòonu nǝ yulaarǝ le keeriwǝ. Mǝ Tǝ bomu ŋ nóo koonu nǝ yulaarǝ le keeripoŋpiwǝ wǝ. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Duturǝ ɖi Worokoyǝ le keeriwǝ we, ŋ wǝ wǝ ri keeriwǝ we wǝ lo ru rǝ yulaarǝ wǝ la sʊʊ wǝ. Wǝ́ wǝ lóo koonu ǝrǝkǝ la vɔrʊrǝ wǝ.» <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, we mǝ koonu lǝ keeriwǝ sa eni ri ŋ ni.» <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri keeriwǝ we wǝ lóo koonu vɔrʊrǝ wǝ. Yǝ we ŋ nǝ́ǝ pǝ mǝ kpǝŋ we, kǝtɛŋkǝ kǝ lǝŋ pa wʊ ŋwǝ pwi. Yǝ we ŋ náa lɔ mǝ ŋ nuŋ we, kǝmɛŋtɛŋkǝ kǝ lǝŋ pa wʊ ŋwǝ pwi. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Paa ŋ́ na marǝ ŋ́ ne tíi nǝ wǝ, nǝ nya nyɩŋ mǝ. Paape nǝ nyaa ya nǝ nyáa lɔ nǝ nyǝ ŋ nuŋ. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Epǝ we kpǝlo kɩɩkɩ Tǝyǝ ŋ nóo koonu mǝ we, pǝ lǝ́ǝ pǝ mǝ kpǝŋ. Wǝ́ yǝ we ŋ nǝ́ǝ pǝ mǝ kpǝŋ we, ŋ́ nǝŋ sǝŋ ŋwǝ ŋ́ co. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Duturǝ ɖi ŋ́ no ru rǝ yulaarǝ ŋ́ na sʊʊ, ŋkǝ ŋ́ pe yee ŋmǝŋmǝ mǝ kǝǝpǝ́wǝ. Paa yǝ we ŋ ne kpii mǝ lǝ kǝǝpǝ́wǝ. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Yǝ we ŋ ne kpii mǝ lǝ kǝǝpǝ́wǝ wǝ kaamǝ ǝkǝnǝŋ: Ŋ́ pǝǝ lǝǝrǝ epǝ we ŋ no koonu mǝ le ceŋceŋ ri ŋ ceŋceŋ. Paa kǝ ŋ́ saanǝ pǝ ŋ́ ru rǝ gbɛŋrǝ lǝ mǝrǝ rǝ jitutururǝ we. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Mǝ Tǝ lǝ kǝǝpǝ́wǝ wǝ kaamǝ ǝkǝnǝŋ: Nyi ri ŋ nyi ŋ na nyɩŋ Piyǝ, wǝ́ ŋ na lɔ ŋwǝ ŋ no nuŋ we, ŋ nya vɔrʊlaalɛɛrǝ. Kǝ ŋmǝ we, ŋ pa saanǝ ŋwǝ ŋ ru rǝ gbɛŋrǝ lǝ mǝrǝ rǝ jitutururǝ we.»<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Wǝ́ Oyudatǝpǝ pǝ ka ŋ ŋwaa pǝ ŋ wɛɛlɩ pǝ ŋ ru rǝ Yesu kpiikǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri keeriwǝ we wǝ lo ru rǝ yulaarǝ wǝ la sʊʊ wǝ.» <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kǝto ŋkǝ Yosɛfʊ le pi Yesu ǝyǝǝ? Yǝ lee ci nǝ tǝ mǝ ne lee? Rǝkǝsa nɛ kǝto wǝ́ ŋ nóo koru atɛŋ ǝkǝnǝŋ: “Ŋ́ no ru rǝ yulaarǝ ŋ́ na sʊʊ wǝ”?» <verse eid="JHN 6:42" /><verse number="43" style="v" sid="JHN 6:43" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ wɛ mǝ etieyǝ we nǝ ya nǝ nyáa ŋwaa nǝ nyǝ ŋ tɛŋ wǝ! <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Rɛ lǝŋ koru ǝpǝ mǝ kpǝŋ, mǝŋ ŋkǝ Tǝyǝ we ŋ ne kpii mǝ, ŋ ne re ŋwǝ ŋ nǝ pǝ wǝ. Ŋmǝ we, ŋ́ nah pa saanǝ ŋwǝ ŋ ru rǝ gbɛŋrǝ lǝ mǝrǝ rǝ jitutururǝ we. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Pǝ la ŋʊrʊ rǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ lǝ mǝrǝ ǝkǝnǝŋ: “Worokoyǝ láa kaŋ pǝlo kpǝlo kɩɩkɩ lo otuyǝ.” Nyi ri ŋ nyi ŋ nóo co kǝtukoŋkǝ rǝ Tǝyǝ, wǝ́ ŋ na lɔ no otukaŋyǝ we, lǝ́ǝ pǝ mǝ kpǝŋ. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Ŋkǝ wǝlo duturǝ ɖi ǝkǝnǝŋ rɛ la nyɩŋ Tǝyǝ lǝ tǝnǝ rǝ oo, we yǝ we ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ ŋ nǝ pǝ ceŋceŋ, ŋ na nyɩŋ Tǝyǝ wǝ. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ, yǝ we ŋ na lɔ ŋ no nuŋ we, lǝǝmǝ vɔrʊlaalɛɛrǝ. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ŋmǝ ŋ́ ri keeriwǝ we wǝ lóo koonu vɔrʊrǝ wǝ. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Nǝ ǝtǝtǝpǝ pǝ rili manayǝ rǝ nyɔŋkpaakǝtǝǝwǝ. Paape wǝ́ pǝ kpǝ̀. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Paa keeriwǝ lǝ wǝ ǝnǝ wǝ lo ru rǝ yulaarǝ we, mǝŋ rɛ le ri wǝ we, yǝ we lǝŋ kpǝ́. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ŋmǝ ŋ́ ri vɔrʊrǝ le keeriwǝ we wǝ lo ru rǝ yulaarǝ wǝ la sʊʊ wǝ. Yǝ we ŋ née ri keeriwǝ sa we, lée tii vɔrʊrǝ kǝkpakǝkpa. Wǝ́ keeriwǝ we ŋ́ noh po koonu we, wǝ kaamǝ mǝ kǝwɛlɛŋkakǝ. Ŋ́ nǝ fǝ kǝ ŋ́ no koonu kǝ ǝrǝkǝ kǝ nya fɛɛ kǝ tii vɔrʊrǝ.» <verse eid="JHN 6:51" /><verse number="52" style="v" sid="JHN 6:52" />Etieyǝ sa kǝto wǝ́ Oyudatǝpǝ pǝ tìini dierǝ mǝ awɛ ŋpa. Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kǝ nyiyǝ sa ŋ koru ǝfǝ na kǝwɛlɛŋkakǝ ŋ koonu lǝ lo wo rǝ nɛ ǝnǝ?»<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ nǝ nyoo wo Nyɩmaasɩ le Pi la kǝwɛlɛŋkakǝ, wǝ́ nǝ nyoo ŋuŋ na ŋpǝrayǝ we, nǝ nyǝŋ lǝmǝ vɔrʊrǝ. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Yǝ we ŋ nóo wo mǝ kǝwɛlɛŋkakǝ wǝ́ ŋ nóo ŋuŋ mǝ ŋpǝrayǝ we lǝǝmǝ vɔrʊlaalɛɛrǝ. Ŋmǝ we, ŋ́ náa pa saanǝ ŋwǝ ŋ́ ru rǝ gbɛŋrǝ lǝ mǝrǝ rǝ jitutururǝ we. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Duturǝ ɖi, mǝ kǝwɛlɛŋkakǝ kǝ ri keeripoŋpiwǝ wǝ́ mǝ ŋpǝrayǝ ŋ ri tuŋuŋpoŋpiwǝ. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Yǝ we ŋ nóo wo mǝ kǝwɛlɛŋkakǝ wǝ́ ŋ nóo ŋuŋ mǝ ŋpǝrayǝ we, yǝ we kpii rǝ mǝ, wǝ́ ŋmǝ ŋkpɛ ŋ́ kpii rǝ ŋwǝ. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Mǝŋ kǝ́ Tǝyǝ we ŋ kpii vɔrʊrǝ, ŋ ne kpii mǝ ŋ na maŋ, ǝkǝ ŋ́ kpii vɔrʊrǝ saŋ rǝ Tǝyǝ we, kaa wǝǝ yǝ we ŋ nóo wo mǝ we, lée tii vɔrʊrǝ saŋ rǝ mǝ. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Nǝ nyǝŋ nyɩŋ keeriwǝ we wǝ lo ru rǝ yulaarǝ wǝ la sʊʊ wǝ. Wǝ la cɛkɛlɛ mǝ wǝ we nǝ ǝtǝtǝpǝ pǝ rili wǝ. Ŋpǝ paa pǝ lǝ kpǝ́. Paape yǝ we ŋ née ri keeriwǝ lǝ wǝ ǝnǝ we, lée tii vɔrʊrǝ kǝkpakǝkpa.» <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Otuyǝ Yesu ŋ tɛnɩ kǝ́ ŋ ka ŋ kaŋ otuyǝ rǝ gumwɛŋnyuŋkpǝ rǝ Kapɛrǝnawumǝ wǝǝ.<verse eid="JHN 6:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Kǝ́ Yesu lo otukarǝtǝpǝ pǝ lo nuŋ Yesu le etieyǝ sa pǝ la lɛ we, wǝ́ pǝla arɛɛpǝ wa pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Dierǝ sa lɛnyɩ oo! Ǝlǝ ŋ nóo koru rǝ lo onuŋ?» <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />Kǝ́ Yesu ŋ cii wǝ rǝ nǝ mǝrǝ ǝkǝnǝŋ no otukarǝtǝpǝ we pǝ ya pǝ láa ŋwaa pǝ ŋ wɛɛlɩ pǝ ŋ ru rǝ dierǝ sa we, wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Dierǝ sa le kpii nǝ gbaraarǝ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />We mǝŋ nǝ nya pa nyɩŋ kǝ́ Nyɩmaasɩ le Pi ŋ náa rɛ fɛɛwǝ we ŋ kǝ sǝnǝ ekpii pa! Nǝ nyáa tɛŋ nɛ? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Worokoyǝ la Wɛɛrǝ lóo koonu vɔrʊrǝ wǝ. Paa nyɩmaasɩyǝ sɔŋ we, lǝŋ koru tǝrɛ le eyee. Etieyǝ sa ŋ́ ne tíi nǝ we, yǝ ri rǝ Wɛɛrǝ mǝ vɔrʊrǝ. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Paape enyirɛɛpǝ pǝ kpii rǝ nǝ mǝrǝ pǝ laa lɔ pǝ nuŋ.» Kpiikǝ ǝrǝ kǝsǝŋkǝ we, Yesu ke cii epǝ we pǝ la lɔ ŋwǝ pǝ lo nuŋ, mǝ yǝ we ŋ nǝ́ǝ pǝ ŋ pǝ fǝ ŋwǝ ŋ kpii enyipǝ rǝ akaakǝ wǝ. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ kǝto ŋ́ ne tíi nǝ ǝkǝnǝŋ: “Rɛ lǝŋ koru ǝpǝ mǝ kpǝŋ mǝŋ ŋkǝ Tǝyǝ ŋ no koonu na kʊŋwǝ wǝ”».<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Fǝ ǝrǝ eniyǝ we wǝ́ no otukarǝtǝpǝ wa pǝ pwɛ̀yɩ rǝ nǝ kpǝŋ. Wǝ́ pǝ wɛ̀ɛ mǝ ne esiimǝtɛlɩkǝ. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Wǝ́ Yesu ŋ pǝ̀ enyikpiipǝ we tǝ mǝ eyipǝ ǝkǝnǝŋ: «Wǝ́ ŋnǝ pa, nǝ nyǝŋ pwɛyɩ?» <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />Wǝ́ Sɩmɔ Pɛtǝro ŋ yìili ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, kǝ lo mǝ ko rǝ ǝlǝ lǝ kpǝŋ? Ǝ lǝǝmǝ vɔrʊlaalɛɛrǝ le etieyǝ. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ŋlǝ we, yǝ la lɔ yǝ lo nuŋ, wǝ́ yǝ la nyɩŋ yǝ le ci ǝkǝnǝŋ ŋlǝ́ e ri Worokoyǝ le Nyikenikeniyǝ.» <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋkǝ ŋmǝ ŋ́ na saa nǝ nǝ enyi tǝ mǝ eyipǝ sa? Paape ceŋceŋ rǝ nǝ mǝrǝ we, Satana le nyiyǝ ŋ lǝǝwe.» <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Sɩmɔ Isǝkario le pi Yuda wǝ́ ŋ ke reemǝ. Duturǝ ɖi Yuda ŋ kǝ ŋ pǝ ŋ pǝ fǝ Yesu ŋ kpii enyipǝ rǝ akaakǝ wǝ. Enyikpiitǝmeyipǝ we le ceŋceŋ wǝ́ ŋ ri.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yesu la apaanʊpǝ pǝ laa lɔ Yesu pǝ nuŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Yesu ŋ sìri ŋ tɛ̀lɩ rǝ Galileya la gaarǝ. Lǝǝ pǝ̀ ŋ siri Yudeya la gaarǝ we duturǝ ɖi Oyudatǝmumuŋpǝ pǝ kǝ ŋ pǝ́ pǝ wʊ ŋwǝ. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Anyɩŋ Oyudatǝpǝ la wǝcɛkpǝ we pǝ lóo pwo epwiiyǝ la wǝcɛkpǝ we, wǝ lǝ kǝlǝ. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Wǝ́ Yesu la apaanʊpǝ pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Pwɛyɩ rǝ fɛɛwǝ sa, kǝ o mǝ ko Yudeya la gaarǝ, kǝ ló otukarǝtǝpǝ sa ŋpǝ ŋkpɛ pǝ nya fɛɛ pǝ ka nyɩŋ lá anǝnɛyǝ we a ya lée yee wǝ. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Duturǝ ri yǝ we ŋ nǝ́ǝ pǝ́ enyipǝ pǝ ci ŋwǝ we, lǝŋ yee anǝnɛyǝ rǝ kǝŋwaakǝ. Kǝ́ wǝ ri ǝkǝnǝŋ a ya lée yee otumumuŋyǝ sa ǝnǝ we, we mumu a pɔrʊ lá wɛ a kaŋ ǝrǝkǝ.» <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Duturǝ ɖi Yesu la apaanʊpǝ sa ŋpǝŋpǝ ǝkǝŋtǝ pǝ laa lɔ ŋwǝ pǝ nuŋ. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ eniyǝ yǝ foo ro. Ŋnǝ paa we, eni ri ŋ ni yǝ ri rǝ eniceeceeyǝ yǝ koonu nǝ. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ǝrǝkǝ kǝ lǝŋ koru ǝkpǝlǝ nǝ kǝǝwǝ. Paa ŋmǝ we, ǝrǝkǝ kǝ lǝ kpǝlǝ mǝ kǝǝwǝ. Kpiikǝ ŋ́ ya ŋ́ née ri ɖaŋsieyǝ ǝkǝnǝŋ kǝlo otuyeeyǝ yǝ pǝlǝ. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Ŋnǝ we, nǝ mǝ ko wǝcɛkpǝ sa. Ŋmǝ paa we, ŋ́ nǝŋ ko kpǝ. Kpiikǝ mǝ eniyǝ yǝ faa maa yǝ ro.» <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Kǝ́ ŋ na wɛɛlɩ ǝnǝ ŋ na lɛ we, wǝ́ ŋ sìɛnɩ ŋ tini rǝ Galileya.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Paa kǝ́ na apaanʊpǝ we pǝ la pwɛyɩ pǝ la tɛlɩ wǝcɛkpǝ we we, wǝ́ ŋwǝ ŋkpɛ ŋ ci ǝ pǝlǝ ŋ yili ŋ ko ŋ ko. Laa maa enyipǝ pǝ nyɩŋ ŋwǝ, kolu rǝ kǝŋwaakǝ. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Rǝ wǝcɛkpǝ sa mǝrǝ we, wǝ́ Oyudatǝmumuŋpǝ pǝ kpìi pǝ ka ŋ taa ŋwǝ. Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Fǝŋ wǝ́ ŋ yaa paa?» <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Wǝ́ enyipǝ pǝ yà pǝ ka ŋ ŋwaa pǝ tɛɛrɩ pǝ ŋ ru rǝ ŋwǝ ŋpa rǝ nyikpǝŋwǝ we lǝ mǝrǝ. Arɛɛpǝ ǝkǝnǝŋ: «Yesu ri nyiceeceeyǝ rɛ». Paa apʊŋpwapǝ ǝkǝnǝŋ: «Kʊrakʊra, ya lǝ́ǝ tǝǝnǝ enyipǝ rǝ». <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Paape rɛ loo tu turuwǝ ŋ rɛɛrɩ mǝ kpɛɛwǝ ŋ wɛɛlɩ ŋ ru rǝ ŋwǝ. Duturǝ ɖi pǝ ko ŋ suu Oyudatǝmumuŋpǝ we lo vurǝ.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Anyɩŋ wǝcɛkpǝ sa le eciyǝ yǝ lǝ sǝpǝ, wǝ́ Yesu ŋ pǝlǝ Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ pǝlǝ ŋ ya ŋ ka ŋ kaŋ otuyǝ. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Wǝ́ wǝ rili Oyudatǝpǝ lo mumuŋ. Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Rɛ laa kaŋ nyiyǝ sa lo otuyǝ ŋ ru rǝ Mose le seyǝ ŋ nyɩŋ, wǝ́ le yee nɛ wǝ́ ŋ cii otuyǝ ǝnǝ?» <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Otuyǝ sa ŋ́ ya ŋ́ náa kaŋ we, yǝ loo ru rǝ ŋmǝŋmǝ mǝ kpǝŋ. Paa yǝ lo ru rǝ yǝ we ŋ ne kpii mǝ lǝ kpǝŋ. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Mǝŋ rɛ lǝ́ǝ pǝ́ ŋ yee Worokoyǝ lǝ kǝǝpǝ́wǝ we, yǝ we lée ci wǝ mǝŋ otukaŋyǝ sa yǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ amaa ŋmǝŋmǝ ŋ́ ya ŋ́ náa wɛɛlɩ rǝ mǝ nyɩŋrǝ! <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Nyiyǝ we ŋ náa wɛɛlɩ rǝ ŋwǝŋwǝ na nyɩŋrǝ we, yǝ we láa taa ŋwǝŋwǝ na wɛ lǝ ǝkǝkǝ rǝ. Paa nyiyǝ we ŋ náa taa pǝ kǝ yǝ we ŋ ne kpii ŋwǝ ŋ na maŋ we, lée ri anʊkɔrǝyǝ. Wǝ́ niarǝ lee kpii rǝ ŋwǝ. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mǝŋkǝ Mose ŋ no koonu nǝ seyǝ? Paape, nǝ rɛ ri ŋ rɛ laa ya lée yee mǝ ŋ saŋ rǝ seyǝ. Kǝ́ kǝto wǝ́ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ wʊ mǝ wǝ?» <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />Wǝ́ nyikpǝŋwǝ we wǝ tìi ŋwǝ ǝkǝnǝŋ: «Wɛɛrɔɔrɔɔrǝ rɛ gbii rǝ lǝ́! Ǝlǝ ŋ ya ŋ nǝ́ǝ pǝ́ ŋ wʊ lǝ́ wǝ?»<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Kǝnǝnɛkǝ kǝceŋceŋ ko wǝ́ ŋ́ ne yee, wǝ́ wǝ le ri nǝ kpǝlo kɩɩkɩ lo mumuŋ! <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Ǝkǝǝlǝkǝ we, kǝ loo ru rǝ Mose lǝ kpǝŋ. Kǝ lo ru rǝ nǝ ǝtǝtǝpǝ lǝ kpǝŋ. Paa Mose ŋ no koonu nǝ seyǝ sa ǝkǝnǝŋ ŋnǝ nǝ mǝ kǝǝlǝ ǝpǝrǝŋpipǝ. Wǝ kǝto nǝ nyáa tɛɛnɩ nǝ kǝǝlǝ nyiyǝ mǝŋ sabatǝyǝ le jirǝ wǝǝ! <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Wǝ́ mǝŋ pǝ lǝ́ǝ kǝǝlǝ nyiyǝ mǝ sabatǝyǝ le jirǝ, kǝ oturu pǝ laa tɔɔ Mose le seyǝ wǝǝ, kǝ́ kǝto wǝ́ nǝ ya nǝ nyǝ́ǝ fǝ mǝ kpɛɛmʊrʊwǝ mǝ kǝ́ ŋ́ na cá nyiyǝ milimili mǝ sabatǝyǝ le jirǝ wǝ? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Nǝ pǝǝ tǝ nǝ mǝ yɩrɩ rǝ enimiyǝ nǝ mǝ tɛŋ akpaŋyǝ. Paa nǝ mǝ tɛŋ akpaŋyǝ rǝ wǝkʊʊkpǝ.»<verse eid="JHN 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Wǝ́ Eyerusalɛmǝtǝrɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Kǝto ŋkǝ nyiyǝ sa wǝ́ pǝ ya pǝ láa taa pǝ wʊ wǝ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Nǝ yɩrɩ re! Ŋwǝ ŋ ya ŋ náa wɛɛlɩ rǝ enyipǝ la kǝnyɩŋkǝ ǝnǝ. Rɛ lee tíi na tǝrɛ! Amaa loh omumuŋpǝ sa pǝ la nyɩŋ wǝ pǝ le ci ǝkǝnǝŋ nyiyǝ sa ŋ ri Mesiyayǝ kǝceece? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Paa nyiyǝ sa we, le cii fɛɛwǝ ŋ no ru wǝ. Vǝ́ paa Mesiyayǝ lǝ́ǝ pǝ we, rɛ lǝŋ pe ci fɛɛwǝ ŋ no ru wǝ.»<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Rǝ eniyǝ we we, oturu Yesu ya láa kaŋ otuyǝ rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝto kǝceece nǝ cii yǝ we ŋ́ ri wǝ? Wǝ́ nǝ cii fɛɛwǝ we ŋ́ no ru wǝ? Paape ŋ́ nǝǝ pǝ rǝ ŋmǝŋmǝ mǝ okopiyǝ. Yǝ we ŋ ne kpii mǝ we, lée ri anʊkɔrǝyǝ. Ŋwǝ paa we, nǝ nyee ci ŋwǝ. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Ŋmǝ paa we, ŋ́ cii ŋwǝ. Kpiikǝ ŋ́ no ru rǝ nǝ kpǝŋ, wǝ́ ŋwǝ ŋ ne kpii mǝ ŋ na maŋ wǝ.» <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />Rǝ fɛɛwǝ we wǝ́ pǝ kǝ ŋ pǝ́ pǝ lɔ ŋwǝ. Paape rɛ loo ruu ŋwǝ. Duturǝ ɖi ne eniyǝ yǝ foo ko ro. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Paa enyipǝ wa rǝ nyikpǝŋwǝ sa lǝ mǝrǝ pǝ lɔ̀ Yesu pǝ nunu. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Vǝ́ Mesiyayǝ we lǝ pǝ pǝ wǝǝ, leh pe yee otucovurǝ ŋ teeri ǝyǝ ǝnǝ nyiyǝ sa ŋ ne yee wǝ?»<verse eid="JHN 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Wǝ́ Afarisitǝpǝ pǝ nunu tuwǝ sa enyipǝ pǝ ya pǝ láa ŋwaa pǝ ŋ tɛŋ rǝ nyikpǝŋwǝ we lǝ mǝrǝ pǝ ŋ ru rǝ Yesu wǝ. Wǝ́ otoolutǝmumuŋpǝ mǝ Afarisitǝpǝ pǝ kpìi otuusiitǝpǝ pǝ ka lɔ ŋwǝ. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ tǝ ŋ́ kpii mǝ nǝ rǝ eniyǝ rɛ kpekperee lǝ mǝrǝ kpɛŋ. Eniyǝ we ŋ́ nóo ko yǝ we ŋ ne kpii mǝ ŋ na maŋ lǝ́ kpǝŋ. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Nǝ nyah pa taa mǝ paape nǝ nyǝŋ nyɩŋ mǝ. Duturǝ ɖi nǝ nyǝŋ koru ǝpǝ fɛɛwǝ we ŋ́ noh ko wǝ.» <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />Rǝ fɛɛwǝ we wǝ́ Oyudatǝpǝ we pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Fǝŋ la fɛɛ wǝ́ ŋ noh ko kǝ lǝ pǝǝ tǝ la pa nyɩŋ ŋwǝ wǝ? Amaa loh ko Oyudatǝpǝ we pǝ la caŋ pǝ kpii rǝ Ehelatǝpǝ lǝ mǝrǝ lǝ kpǝŋ? Lah ka kaŋ Ehelatǝpǝ lo otuyǝ? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Dierǝ sa ŋ na tɛŋ ǝkǝnǝŋ “Nǝ nyah pa taa mǝ paape nǝ nyǝŋ nyɩŋ mǝ. Duturǝ ɖi nǝ nyǝŋ koru ǝpǝ fɛɛwǝ we ŋ́ noh ko wǝ” lo duturǝ ɖi nɛ?»<verse eid="JHN 7:36" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ Wɛɛkenikenirǝ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Wǝcɛkpǝ we le jitutururǝ we, ge ri jimumuŋrǝ wǝ. Jirǝ we we, wǝ́ Yesu ŋ yili ŋ yàa. Wǝ́ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ ŋ ka ŋ tɛŋ ǝkǝnǝŋ: «Mǝŋ kǝmɛŋtɛŋkǝ kǝ láa wʊ rɛ we, yǝ we ŋ pǝ mǝ kpǝŋ kǝ ŋ po ŋuŋ mɛŋwǝ! <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />“Yǝ we ŋ na lɔ mǝ ŋ no nuŋ we, mɛŋwǝ we wǝ lóo koonu vɔrʊrǝ we, la akpanǝyǝ yǝ lah mǝ wʊʊ rǝ nǝ mǝrǝ”, mǝŋ kǝ́ Wǝŋʊrʊkpǝ wǝ la tɛŋ wǝ kǝtǝ.» <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yesu ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ la Wɛɛrǝ rǝ. Wɛɛrǝ we epǝ we pǝ la lɔ Yesu pǝ lo nuŋ pǝ lah pa lɔ wǝ. Kpiikǝ pǝ foo ko koonu Wɛɛrǝ we. Duturǝ ɖi Worokoyǝ faa ka maa ŋ pɔrʊ Yesu la anaanǝkǝ ŋ kaŋ kǝto.<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Rǝ nyikpǝŋwǝ we wǝ yà wǝ ko ŋ nuŋ etieyǝ sa lǝ mǝrǝ we, arɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Kǝceece, nyiyǝ sa ŋ ri worokokpɛɛnuŋtɛŋtǝyǝ we!» <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />Wǝ́ apʊŋpwapǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋwǝ ŋ ri Mesiyayǝ we». Paa wǝ arɛɛpǝ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Mesiyayǝ we lóo koru oru rǝ Galileya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Mǝŋkǝ Wǝŋʊrʊkpǝ wǝ la tɛŋ ǝkǝnǝŋ Mesiyayǝ we leh pe ri Davidǝ le pilepiyǝ, wǝ́ lóo ru rǝ Bɛtǝlɛhɛmǝ, dǝŋtǝǝpirǝ we Davidǝ ŋ no ru wǝ?» <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Kǝ́ wǝ yeli wǝ fǝ̀ wǝǝ, wǝ́ kǝkpǝŋkǝ we kǝ sǝ̀pǝ rǝ Yesu lo yurǝ. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Wǝ́ arɛɛpǝ pǝ kǝ ŋ pǝ́ pǝ lɔ ŋwǝ. Paape rɛ lo ruu ŋwǝ.<verse eid="JHN 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Wǝ́ otuusiitǝpǝ we pǝ sìɛnɩ pǝ pǝlǝ otoolutǝmumuŋpǝ we mǝ Afarisitǝpǝ we lǝ kpǝŋ. Wǝ́ enyipǝ sa pǝ pǝ̀ otuusiitǝpǝ we ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nyee re ŋwǝ nǝ pǝ wǝ?» <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />Wǝ́ otuusiitǝpǝ we pǝ tìi pǝ ǝkǝnǝŋ: «Rɛ faa wɛɛlɩ ŋ nyɩŋ mǝŋ nyiyǝ sa kǝtǝ pwi!» <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />Wǝ́ Afarisitǝpǝ sa pǝ tìi pǝ ǝkǝnǝŋ: «We ŋnǝ ŋkpɛ nǝ nya ka maa lǝ tǝǝnǝ nǝ? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Nǝ nya nyɩŋ ǝtǝŋtǝǝtǝmumuŋpǝ sa la rɛ ceŋceŋ amaa ŋlǝ Afarisitǝpǝ sa la rɛ ceŋceŋ la lɔ nyiyǝ sa lo nuŋ? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />We kǝnyikpǝŋkǝ sa ceŋceŋ, kǝ lee ci Mose le seyǝ, enyipǝ pǝ la fwɛɛrɩ wǝ́ pǝ ri!» <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" />Nikodɛmǝyǝ sa ŋ ce ŋ kolu ŋ nyɩnɩ Yesu we, ke tini rǝ fɛɛwǝ we. Farisitǝnyiyǝ wǝ́ ŋ ri. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />«Rǝ leh seyǝ we, yǝ lǝŋ koru atɔɔ rɛ la bɔrǝ kǝ oturu yǝ loo nuŋ ne dierǝ, wǝ́ pǝ laa lɛ pǝ ci tuwǝ ŋ ne yee wǝ!» <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />Wǝ́ otuturupǝ we pǝ yìili pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Galileyatǝpiyǝ wǝ́ ŋlá ŋkpɛ e ri? Mǝ kǝ Wǝŋʊrʊkpǝ we sɩsiɛrɩ! A lah ka nyɩŋ ǝkǝnǝŋ worokokpɛɛnuŋtɛŋtǝyǝ rɛ mǝŋ ceŋceŋ foo ru rǝ Galileya ŋ tǝnǝ.»<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />Rǝ wǝla kǝmaakǝ wǝ́ nyi ri ŋ nyi ŋ pwɛ̀yɩ ŋ ko ŋ ko na nyarǝwǝ.<note caller="+" style="f"><char style="fr" closed="false">7:53 </char><char style="ft" closed="false">Fǝ rǝ yupǝrɩmatatǝrǝ la fɛɛkǝtǝtʊʊ mǝ ta fǝ ko yunɛŋtǝrǝ la fɛɛkǝwǝ tǝ mǝ ceŋceŋ we, wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ we lǝ mǝrǝ. Wǝŋʊrʊrɛɛkpǝ wǝ le ke kpii fɛɛwǝ sa rǝ fɛɛpʊŋpwawǝ rɛ, rǝ kǝfwɛɛkǝ sa la alɛɛkǝ.</char></note><verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Pǝ la ka lɔ tieyǝ rɛ ya láa yɩɩ vúurǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Wǝ́ Yesu ŋwǝ paa ŋ ko ŋ ko oliviepǝ lo dutupirǝ. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Gaalǝǝrǝkǝ, ɖokoŋpirǝ ŋalaŋala we, wǝ́ ŋ sìɛnɩ ŋ kǝ ŋ pǝ Worokoyǝ la nyarǝwǝ. Wǝ́ enyipǝ kpǝlo kɩɩkɩ pǝ ko ŋ ruu pǝ ŋ kǝlǝ mǝ ŋwǝ. Wǝ́ ŋ sɔ̀ ŋ tini ŋ ka ŋ kaŋ pǝ lo otuyǝ. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Wǝ́ esekaŋtǝpǝ mǝ Afarisitǝpǝ pǝ kolu pǝ rù mǝ tieyǝ rɛ pǝ la ka lɔ, ŋ ya ŋ náa yɩɩ vúurǝ pǝ kǝ ŋ pǝ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ pǝlǝ pǝ yàalǝ rǝ nyikpǝŋwǝ we le kǝtiitiikǝ. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Wǝ́ pǝ ke ŋ tìi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, yǝ láa ka lɔ tieyǝ sa ya láa yɩɩ vúurǝ. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Rǝ seyǝ we mǝrǝ we, Mose le tíi lǝ ǝkǝnǝŋ etiepǝ sa wǝrʊʊkpǝ we ŋlǝ le tieni pǝ lo oruyǝ la wʊ. Wǝ́ ŋlǝ́ pa, ɖǝ rǝ fǝŋ wǝ́ a ya láa tɛŋ rǝ wǝlo oŋuŋkǝ?»<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />Pǝ ka ŋ wɛɛlɩ ǝnǝ kǝ pǝ kɔŋ na kpɛrɛwǝ rǝ. Duturǝ ɖi pǝ kǝ ŋ pǝ́ pǝ nya tuwǝ pǝ lǝ́ǝ fǝ pǝ yee dierǝ mǝ ŋwǝ rǝ. Paa wǝ́ Yesu ŋ pɛ̀ɛlɩ. Wǝ́ ŋ fǝ̀ na gaapirǝ ŋ ya ŋ ka ŋ ŋʊrʊ rǝ kǝtǝǝwǝ. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Kǝ́ pǝ tǝ pǝ ya pǝ lǝ́ǝ pǝ́ ne etieyǝ rǝ ko we, wǝ́ Yesu ŋ yìili anyɩŋkǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Yǝ we rǝ nǝ mǝrǝ ŋ fee yee turɔɔrɔɔwǝ ŋ tǝnǝ we, ŋ ri nyisǝsǝŋyǝ ŋ née tie tieyǝ sa lo ɖurǝ wǝ.» <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Wǝ́ Yesu ŋ tǝ ŋ pɛ̀ɛlɩ wǝ́ ŋ tǝ ŋ ka ŋ ŋʊrʊ rǝ kǝtǝǝwǝ. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Kǝ́ pǝ lo nuŋ tuwǝ sa we, wǝ́ pǝ ka ŋ pwɛyɩ jeŋceŋ jeŋceŋ. Wǝ sǝnǝ rǝ onyumupǝ. Wǝ́ wǝ kolu wǝ tùuru Yesu ceŋceŋ ŋpǝ mǝ tieyǝ we ŋ kǝ tǝ ŋ yàa rǝ na kǝnyɩŋkǝ wǝ. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Wǝ́ Yesu ŋ yìili anyɩŋkǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kuleleyǝ, enyipǝ we pa? Rɛ laa tɔɔ lǝ́ bɔrǝ?» <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, rɛ laa tɔɔ mǝ bɔ.» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ ŋkpɛ ŋ́ nǝŋ tɔɔ lǝ́ bɔrǝ. O lóo koru o mǝ ko. Paa fǝ rǝ ruŋruŋ mǝ ko we, pǝǝ tǝ e pe yee turɔɔrɔɔwǝ.»<verse eid="JHN 8:11" /></para>
  <para style="s">Yesu ŋ ri ǝrǝkǝ la wǝnyɩɩnɩkpǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Wǝ́ Yesu ŋ tǝ ŋ ka ŋ wɛɛlɩ mǝ kǝnyikpǝŋkǝ we. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri ǝrǝkǝ la wǝnyɩɩnɩkpǝ. Yǝ we ŋ née siimǝ mǝ we, lǝŋ pa saŋ nuŋtumuwǝ. Láa nya wǝnyɩɩnɩkpǝ we wǝ lóo koonu vɔrʊrǝ wǝ.» <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />Wǝ́ Afarisitǝpǝ pǝ ke ŋ tìi ŋwǝ ǝkǝnǝŋ: «A ya lée ri lá wɛ la ɖaŋsieyǝ? Lá ɖaŋsieyǝ sa lee ri anʊkɔrǝyǝ!» <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Kǝceece ŋmǝŋmǝ ŋ́ ya ŋ́ née ri mǝ wɛ la ɖaŋsieyǝ. Paape we, mǝ ɖaŋsieyǝ sa we, ri anʊkɔrǝyǝ. Kpiikǝ ŋ́ cii fɛɛwǝ ŋ́ no ru, mǝ fɛɛwǝ ŋ́ noh ko wǝ. Paa ŋnǝ we, nǝ nyee ci fɛɛwǝ ŋ́ no ru wǝ́ nǝ nyee ci fɛɛwǝ ŋ́ noh ko wǝ. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Ŋnǝ we, nǝ nyáa tɛŋ wǝkpaŋkpǝ nǝ nyǝ ŋ saŋ rǝ anyɩmaasɩpǝ lo otunyɩŋyǝ. Ŋmǝ we, ŋ́ nǝŋ tɛŋ rɛ la wǝkpaŋkpǝ. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Wǝ́ mǝŋ wǝ lǝ pǝ ǝkǝnǝŋ ŋmǝ ŋ́ tɛŋ wǝkpaŋkpǝ rɛ we, ŋ́ náa tɛŋ kpǝ rǝ wǝkʊʊkpǝ. Duturǝ ɖi ŋkǝ ŋmǝ ceŋceŋ ŋ́ náa tɛŋ wǝkpaŋkpǝ. Tǝyǝ we ŋ ne kpii mǝ ŋ na maŋ we, kpii kʊla mǝ mǝ. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Pǝ la ŋʊrʊ rǝ nǝ seyǝ we lǝ mǝrǝ ǝkǝnǝŋ, mǝŋ enyi eyi pǝ le ri ɖaŋsieyǝ ceŋceŋ pǝ lo ru rǝ tǝrɛ lo oŋuŋkǝ we, anʊkɔrǝyǝ yǝ lǝǝwe. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ŋ́ ya ŋ́ née ri mǝ wɛ la ɖaŋsieyǝ. Wǝ́ Tǝyǝ we ŋ ne kpii mǝ ŋ na maŋ we, ŋwǝ ŋkpɛ ŋ ya ŋ née ri mǝ ɖaŋsieyǝ.» <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />Wǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Kǝnǝ lǝ́ Tǝyǝ wǝǝ?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyee ci mǝ, wǝ́ nǝ nyee ci mǝ Tǝ. Mǝŋ nǝ keh ci mǝ we, nǝ keh ci mǝ Tǝyǝ ŋwǝ ŋkpɛ.»<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yesu tɛnɩ etieyǝ sa, mǝ eniyǝ we ŋ yà ŋ ka ŋ kaŋ otuyǝ rǝ Worokoyǝ la nyaarǝwǝ. Rǝ fɛɛwǝ we pǝ lǝ́ǝ tǝnǝ tukpiisɩkayǝ wǝ. Rɛ loo ruu ŋwǝ, kpiikǝ ne eniyǝ yǝ foo ko ro. <verse eid="JHN 8:20" /><verse number="21" style="v" sid="JHN 8:21" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ we, ŋ́ náa pwɛyɩ. Nǝ nyah pa taa mǝ, paape nǝ nyǝ́ǝ kpǝ́ rǝ nǝ turɔɔrɔɔwǝ mǝrǝ. Nǝ nyǝŋ koru oko fɛɛwǝ we ŋ́ noh ko wǝ.» <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />Wǝ́ Oyudatǝpǝ we pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Amaa loh ko ŋ ka wʊ na wɛ rǝ? Kpiikǝ ya láa tɛŋ ǝkǝnǝŋ “Nǝ nyǝŋ koru oko fɛɛwǝ we ŋ́ noh ko wǝ.”» <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝ we, nǝ ri rǝ ǝkǝtǝǝtǝpǝ. Ŋmǝ paa we, oŋuŋkǝ le nyiyǝ wǝ́ ŋ́ ri. Ǝrǝkǝ sa le enyipǝ wǝ́ nǝ ri. Ŋmǝ paa we, ŋ́ nee ri ǝrǝkǝ sa le nyiyǝ. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Wǝ kǝto ŋ́ ne tíi nǝ ǝkǝnǝŋ nǝ nyǝ́ǝ kpǝ́ rǝ nǝ oturɔɔrɔɔyǝ mǝrǝ. Mǝŋ nǝ nyaa lɔ nǝ nuŋ ǝkǝnǝŋ: “Ŋmǝ ŋ́ ri ŋmǝ” we, nǝ nyǝ́ǝ kpǝ́ rǝ nǝ oturɔɔrɔɔyǝ mǝrǝ.» <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />Wǝ́ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Ǝlǝ wǝ́ e ri?» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ yǝ we ŋ ri wǝ ru ǝrǝ kǝsǝŋkǝ. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Ŋ́ lǝǝmǝ otuyǝ wa ŋ́ náa wɛɛlɩ ŋ́ ru rǝ nǝ, kǝ ŋ́ tɛŋ akpaŋyǝ mǝ nǝ. Paape yǝ we ŋ ne kpii mǝ ŋ na maŋ we, nʊkɔrǝlǝtǝyǝ wǝ́ ŋ ri. Wǝ́ tuwǝ we ŋ́ no nuŋ ŋ́ no ru rǝ nǝ kpǝŋ we, ŋ wǝ wǝ́ ŋ́ ya ŋ́ náa tɛŋ mǝ ŋ tíi ǝrǝkǝ wǝ.»<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Pǝ loo nuŋ wǝlo duturǝ ǝkǝnǝŋ Yesu ya láa wɛɛlɩ mǝ ŋ ru rǝ Tǝyǝ mǝ ŋ tíi pǝ rǝ! <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Ŋ wǝ kǝto wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Vǝ́ nǝ nyáa pa rɛɛrɩ mǝ Nyɩmaasɩ le Pi we, nǝ nyée ci wǝ ǝkǝnǝŋ: “Ŋmǝ ŋ́ ri ŋmǝ.” Nǝ nyée ci wǝ ǝkǝnǝŋ ŋ́ nǝŋ yee tǝrɛ rǝ ŋmǝŋmǝ mǝ okopiyǝ. Paa tuwǝ we Tǝyǝ ŋ na kaŋ mǝ we, ŋ wǝ wǝ́ ŋ́ náa tɛŋ wǝ. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Nyiyǝ we ŋ ne kpii mǝ ŋ na maŋ we, kpii kʊla mǝ mǝ. Laa maa mǝ ŋmǝ ceŋceŋ, kpiikǝ eni ri ŋ ni we, tuwǝ we wǝ ponu mǝ ŋwǝ wǝ́ ŋ́ née yee wǝ.» <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Kǝ́ ŋ ya ŋ náa wɛɛlɩ ǝnǝ we, wǝ́ enyipǝ wa pǝ lɔ̀ ŋwǝ pǝ nunu.<verse eid="JHN 8:30" /></para>
  <para style="s">Abǝrahamǝ le epipǝ mǝ Satana le epipǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Wǝ́ Yesu ŋ tìi Oyudatǝpǝ we pǝ la lɔ ŋwǝ pǝ lo nuŋ ǝkǝnǝŋ: «Mǝŋ nǝ nyée yee nǝ nyǝ ŋ saŋ rǝ mǝ dierǝ we, o lóo turu nǝ ri mǝ otukarǝtǝpǝ kǝceece. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Nǝ nyée ci anʊkɔrǝyǝ we, kǝ anʊkɔrǝyǝ we yǝ koonu nǝ diiwɛɛrǝ.» <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />Wǝ́ pǝ yìili pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Abǝrahamǝ lǝ wǝmǝkpǝ wǝ́ le ri. Rɛ fǝǝ fǝ lǝ ŋ yee arɔŋpǝ ŋ nyɩŋ pwi. Nɛ kǝto wǝ́ a láa tɛŋ ǝkǝnǝŋ: “Nǝ nyáa lɔ diiwɛɛrǝ” wǝ?» <verse eid="JHN 8:33" /><verse number="34" style="v" sid="JHN 8:34" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, yǝ we ŋ née yee turɔɔrɔɔwǝ we, ri turɔɔrɔɔwǝ la rɔŋyǝ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Rɔŋyǝ lǝŋ tii ŋ kʊla mǝ anyarǝlǝtǝpǝ kǝkpakǝkpa. Kulǝtǝyǝ le piyǝ, ŋwǝ paa, lée tii rǝ nyarǝwǝ kǝkpakǝkpa. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Kǝto mǝŋ Piyǝ ŋ no koonu nǝ diwɛɛrǝ we, nǝ nyée tíi nǝ koonu nǝ wɛ kǝceece. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ŋ́ cii wǝ ǝkǝnǝŋ nǝ ri Abǝrahamǝ lǝ wǝmǝkpǝ. Paape nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ wʊ mǝ! Kpiikǝ nǝ nyǝ sǝ́ŋ mǝ etieyǝ kǝto. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ŋmǝ we, tuwǝ we ŋ́ na nyɩŋ rǝ mǝ Tǝ lǝ kpǝŋ wǝ́ ŋ́ náa tɛŋ wǝ. Paa ŋnǝ we, tuwǝ we nǝ nyo nuŋ rǝ nǝ tǝ lǝ kpǝŋ wǝ́ nǝ nyée yee.» <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Lǝh tǝtǝ ŋ kaamǝ Abǝrahamǝ.» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ keh ri Abǝrahamǝ le epipǝ we, nǝ keh mǝ yee otuyǝ mǝŋ Abǝrahamǝ kǝtǝ. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Paa rǝkǝsa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ wʊ mǝ. Ŋmǝ yǝ we ŋ́ ne tíi nǝ anʊkɔrǝyǝ we ŋ́ no nuŋ rǝ Worokoyǝ lǝ kpǝŋ wǝ! Abǝrahamǝ lee yee tuwǝ sa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ yee wǝ. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Paa ŋnǝ we, nǝ tǝ lo otuyeeyǝ wǝ́ nǝ ya nǝ nyée yee.» Wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Yǝ lee ri okpookpoopipǝ! Tǝyǝ ceŋceŋ ko wǝ́ lǝ lǝǝmǝ. Ŋwǝ ŋ kaamǝ Worokoyǝ!» <verse eid="JHN 8:41" /><verse number="42" style="v" sid="JHN 8:42" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ Worokoyǝ keh ri nǝ Tǝyǝ we, nǝ kah taa mǝ kǝǝwǝ. Duturǝ ɖi ŋ́ no ru rǝ Worokoyǝ lǝ kpǝŋ. Wǝ́ no yurǝ kǝto wǝ́ ŋ́ yaa rǝ fɛɛwǝ sa wǝ. Ŋ́ nǝǝ pǝ rǝ ŋmǝŋmǝ mǝ okopiyǝ, ŋwǝ ŋ ne kpii mǝ ŋ na maŋ. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Kǝ́ kǝto wǝ́ nǝ nyaa ya nǝ nyóo nuŋ mǝ dierǝ ŋ́ ya ŋ́ née tíi nǝ lo duturǝ wǝ? Duturǝ ɖi nǝ nyǝŋ koru onuŋ mǝ etieyǝ. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Nǝ tǝ ŋ kaamǝ Satana. Wǝ́ nǝ nyǝ́ǝ pǝ́ nǝ mǝ yee rǝ otuyǝ we yǝ ponu mǝ nǝ tǝ wǝ. Nyiwʊʊlʊtǝyǝ wǝ́ ŋ ri ǝrǝ kǝsǝŋkǝ. Wǝ́ lǝŋ ri anʊkɔrǝyǝ pwi, kpiikǝ anʊkɔrǝyǝ yǝ lee kpii rǝ ŋwǝ. Na nɛŋwǝ wǝ kaamǝ ǝkǝnǝŋ ŋ nia, wǝ lǝŋ yee na tǝrɛ! Kpiikǝ nianiatǝyǝ wǝ́ ŋ ri, wǝ́ ŋ lɛ ŋ ri anianiatǝpǝ lǝ tǝyǝ. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ŋmǝ paa we, kpiikǝ ŋ́ ya ŋ́ née tíi nǝ anʊkɔrǝyǝ kǝto wǝ́ nǝ nyaa ya nǝ nyáa lɔ mǝ nyǝ ŋ nuŋ wǝ. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Nǝ ǝlǝ ŋ nóo koru apɔrʊ ŋ kaŋ mǝ ǝkǝnǝŋ ŋmǝ ŋ́ ne yee oturɔɔrɔɔyǝ wǝ? Wǝ́ mǝŋ ŋ́ ya ŋ́ náa tɛŋ anʊkɔrǝyǝ wǝǝ, kǝ́ kǝto wǝ́ nǝ nyaa ya nǝ nyáa lɔ mǝ nyǝ ŋ nuŋ wǝ? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Yǝ we ŋ ri Worokoyǝ la nɛŋyǝ we, lóo co kǝtukoŋkǝ rǝ Worokoyǝ le etieyǝ. Wǝ́ kpiikǝ nǝ nyee ri Worokoyǝ la anɛŋpǝ kǝto, wǝ́ nǝ nyǝŋ co kǝtukoŋkǝ rǝ mǝ wǝ.» <verse eid="JHN 8:47" /><verse number="48" style="v" sid="JHN 8:48" />Wǝ́ Oyudatǝpǝ we pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Kǝto yǝ laa pɛŋ, kǝ́ yǝ la tɛŋ ǝkǝnǝŋ Samariatǝnyiyǝ wǝ́ e ri, wǝ́ wɛɛrɔɔrɔɔrǝ rɛ gbii rǝ lǝ́ wǝ?» <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ow, wɛɛrɔɔrɔɔrǝ rɛ lee kpii rǝ mǝ! Paa we, ŋ́ ya ŋ́ nǝ́ǝ kǝ mǝ Tǝ rǝ. Ŋnǝ paa we, nǝ nyǝ sǝ́ŋ nǝ nyǝŋ kǝ mǝ! <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ŋ́ naa ya ŋ nǝ́ǝ pǝ́ enyipǝ pǝ kǝ mǝ. Nyiyǝ rɛ kpii ŋ ya ŋ nǝ́ǝ pǝ́ pǝ kǝ mǝ, wǝ́ ŋ náa tɛŋ akpaŋyǝ wǝ. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Ŋ́ ya ŋ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ, mǝŋ rɛ le yee la saŋ rǝ mǝ etieyǝ we, yǝ we lǝŋ pǝ kpǝ́ pwi.» <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />Wǝ́ Oyudatǝpǝ we pǝ ke ŋ tíi Yesu ǝkǝnǝŋ: «Rǝkǝsa yǝ le ci wǝ ǝkǝnǝŋ wɛɛrɔɔrɔɔrǝ rɛ gbii rǝ lǝ́! Abǝrahamǝ lǝ kpǝ́, oworokokpɛɛnuŋtɛŋtǝpǝ ŋpǝ ŋkpɛ pǝ lǝ kpǝ́. Wǝ́ ŋlǝ́, ǝ lǝ pǝ a láa tɛŋ ǝkǝnǝŋ: “Mǝŋ rɛ le yee la saŋ rǝ lé etieyǝ we, yǝ we lǝŋ pǝ kpǝ́ pwi.” <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />We a lah mǝ nyɩŋ rǝ ǝkǝnǝŋ ŋlǝ́ a naanǝ e teeri lǝh tǝ Abǝrahamǝ ŋ nǝ kpǝ́ wǝ? Oworokokpɛɛnuŋtɛŋtǝpǝ we ŋpǝ ŋkpɛ pǝ lǝ kpǝ́! Wǝ́ ŋlǝ́, ǝlǝ wǝ́ a ya láa nyɩŋ ǝkǝnǝŋ ŋlǝ́ e ri?» <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ ŋmǝŋmǝ ŋ́ kǝh mǝ kǝ mǝ wɛ we, ǝkǝkǝ sa kǝ lǝŋ kǝ lǝmǝ okuruyǝ rɛ. Yǝ we ŋ nǝ́ǝ kǝ mǝ ŋ kaamǝ mǝ Tǝ. Ŋwǝ wǝ́ nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ ŋ ri nǝ Worokoyǝ. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Paa nǝ nyee ci ŋwǝ. Ŋmǝ paa we, ŋ́ cii ŋwǝ. Mǝŋ ŋ́ na ka tɛŋ ǝkǝnǝŋ ŋ́ nee ci ŋwǝ we, o koh turu ŋ́ ri rǝ nianiatǝyǝ mǝŋ ŋnǝ kǝtǝ. Paa we, ŋ́ cii ŋwǝ, wǝ́ ŋ́ née yee mǝ ŋ saŋ rǝ ne dierǝ. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Nǝ tǝ Abǝrahamǝ nyà faawǝ ŋpa kǝ́ ŋ yà ŋ ko ŋ pu yurǝ ǝkǝnǝŋ ŋwǝ ŋ na nyɩŋ jirǝ we ŋ́ nǝ́ǝ pǝ wǝ. Wǝ́ ŋ nyɩnɩ rǝ, wǝ́ ŋ nyà faawǝ ŋpa.» <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />Wǝ́ Oyudatǝpǝ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «E fee ce a lɔ cɛŋwǝ tǝtʊʊ wǝ́ a ya láa tɛŋ ǝkǝnǝŋ ŋlǝ́ a la nyɩŋ Abǝrahamǝ?» <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋ́ kpii kaka kpɛŋ wǝ́ Abǝrahamǝ ŋ ne ci oru ǝrǝkǝ!» <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Wǝ́ pǝ rɛ̀mɩ oruyǝ pǝ leh tieni ŋwǝ. Rǝ kɔɔwe wǝ́ Yesu ŋ ŋwàa. Wǝ́ ŋ rù ŋ pwɛ̀yɩ rǝ Worokoyǝ la nyarǝwǝ.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesu la cá laanyɩŋtǝyǝ rɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Kǝ́ Yesu ŋ nǝ pǝ ŋ nah tɛlɩ we, wǝ́ ŋ nyɩnɩ nyiyǝ rɛ. Laanyɩŋtǝyǝ wǝ́ ŋ ri ǝrǝ kǝ́ pǝ lǝ mǝ ŋwǝ wǝ. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Wǝ́ no otukarǝtǝpǝ we pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, pǝ lǝ mǝ nyiyǝ sa laanyɩŋtǝyǝ! Ǝlǝ ŋ ne yee turɔɔrɔɔwǝ wǝ́ wǝ lǝ ŋwǝ ǝnǝ, ŋwǝŋwǝ amaa nǝ ǝmǝtǝpǝ?» <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋkǝ ŋwǝ ŋ ne yee turɔɔrɔɔwǝ rɛ. Wǝ laa lɛ wǝ ri nǝ ǝmǝtǝpǝ pǝ le yee turɔɔrɔɔwǝ rɛ. Paa pǝ lǝ mǝ nyiyǝ sa ǝnǝ, kǝ Worokoyǝ ŋ nya fɛɛ ŋ pɔrʊ na anǝnɛyǝ ŋ kaŋ saŋ rǝ nyiyǝ sa lo oŋuŋkǝ. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Kǝ́ ǝrǝkǝ kǝ la nya kǝ la kaalǝ we, wǝ kpii kǝ le yee yǝ we ŋ ne kpii mǝ ŋ na maŋ la anǝnɛyǝ. Ǝrǝkǝ kǝ lǝh pǝ kǝ pa cɩɩ, kǝ́ rɛ ŋ nǝŋ koru anǝnɛyǝ le eyee wǝ! <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Kǝ́ ŋ́ nya ŋ́ kpii rǝ ǝrǝkǝ sa we, ŋmǝ ŋ́ ri ǝrǝkǝ sa la wǝnyɩɩnɩkpǝ.» <verse eid="JHN 9:5" /><verse number="6" style="v" sid="JHN 9:6" />Kǝ́ Yesu ŋ na tɛŋ tuwǝ sa ŋ na lɛ we, wǝ́ ŋ tò dutomirǝ ŋ tǝ̀nǝ rǝ kǝtǝǝwǝ. Wǝ́ ŋ lɔ̀ rǝ ŋ pǝ̀ǝlǝ mǝ naŋrǝ ŋ yeli kǝpwɛkǝ. Wǝ́ ŋ fǝ̀ kǝpwɛkǝ we ŋ nùkuti laanyɩŋtǝyǝ we rǝ enimiyǝ. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ ko a ka wɛɛ enimiyǝ rǝ Silowe lo puŋkɔwǝ we.» Silowe lo duturǝ ɖi Kpii a maŋ. Wǝ́ laanyɩŋtǝyǝ sa ŋ kolu ŋ wɛ̀ɛ enimiyǝ rǝ we. Wǝ́ ŋ sìɛnɩ ŋ kǝ ŋ pǝ, ya láa nyɩŋ! <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />Wǝ́ na anyarǝlɛɛrɩtǝpǝ mǝ epǝ we pǝ ke ŋ pi pǝ ŋ nyɩŋ ŋwǝ tini láa rialǝ otuyǝ we, pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kǝto ŋkǝ nyiyǝ sa ŋ née tii mǝ ŋ rialǝ otuyǝ wǝǝ?» <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Arɛɛpǝ ǝkǝnǝŋ: «Ŋwǝ ŋ lǝǝwe!» Apʊŋpwapǝ ǝkǝnǝŋ: «Ow, nyiyǝ sa lo ru ŋwǝ rǝ!» Wǝ́ ŋwǝŋwǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ lǝǝwe kǝceece». <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Wǝ le yee nɛ wǝ́ a ya láa nyɩŋ rǝkǝsa wǝ?» <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nyiyǝ we pǝ lóo pwo Yesu ŋ ne yee mǝ kǝpwɛkǝ ŋ no nukuti mǝ enimiyǝ. Wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ: “Mǝ ko Silowe kǝ a ka wɛɛ enimiyǝ.” Wǝ́ ŋ́ no ko fɛɛwǝ sa ŋ́ na ka wɛɛ enimiyǝ, wǝ́ ŋ́ ya ŋ́ náa nyɩŋ!» <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Wǝ́ ŋwǝ nyiyǝ we pa?» Wǝ́ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ nee ci». <figure style="fig" alt="Jésus guérit un aveugle" file="DN00456b.tif" size="col" copy="Darwin Dunham" ref="9:6">Yesu la cá laanyɩŋtǝyǝ rɛ</figure><verse eid="JHN 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Wǝ́ pǝ fǝ̀ nyiyǝ we ŋ naa ka ŋ nyɩŋ eniyǝ nɔ we, pǝ kolu Afarisitǝpǝ lǝ kpǝŋ. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Jirǝ we Yesu ŋ yeli mǝ kǝpwɛkǝ ŋ cà nyiyǝ we le enimiyǝ we, sabatǝyǝ le jirǝ gǝ lǝǝwe. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Wǝ́ Afarisitǝpǝ we ŋpǝ ŋkpɛ pǝ pǝ̀ nyiyǝ sa kǝ́ wǝ le yee wǝ lǝ fǝ, wǝ́ ŋ ya ŋ náa nyɩŋ wǝ. Wǝ́ nyiyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: «Le yee mǝ kǝpwɛkǝ lo nukuti mǝ enimiyǝ. Wǝ́ ŋ́ na ka wɛɛ enimiyǝ, wǝ́ ŋ́ ya ŋ́ náa nyɩŋ rǝkǝsa.» <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />Wǝ́ Afarisitǝrɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Nyiyǝ sa loo ru rǝ Worokoyǝ lǝ kpǝŋ. Duturǝ ɖi lǝŋ yee ŋ saŋ rǝ sabatǝyǝ le seyǝ.» Paa wǝ́ apʊŋpwapǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Turɔɔrɔɔyeetǝyǝ lée yee nɛ kǝ ŋ koru otucovurǝ sa wǝrʊʊkpǝ le eyee?» Wǝ́ wǝsǝpǝkpǝ wǝ pǝlǝ rǝ enyipǝ sa lǝ mǝrǝ. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />Wǝ́ Afarisitǝpǝ sa pǝ tǝ pǝ pǝ̀ laanyɩŋtǝyǝ sa ŋ na kpaa ǝkǝnǝŋ: «Wǝ́ ŋlǝ́ pa, kǝ́ wǝ́ a ya láa tɛŋ o mǝ ŋ ru rǝ nyiyǝ sa ŋ na cá lǝ́ enimiyǝ wǝ?» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokokpɛɛnuŋtɛŋtǝyǝ ŋ lǝǝwe.»<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Paape Oyudatǝpǝ lo omumuŋpǝ we pǝ sǝ́nǝ pǝ laa lɔ pǝ nuŋ ǝkǝnǝŋ nyiyǝ sa lǝ tǝrǝ la nyɩŋ, wǝ́ ŋ ya ŋ náa nyɩŋ rǝkǝsa! Wǝ kǝto pǝ kpìi pǝ ko pwo nǝ ǝmǝtǝpǝ pǝ pǝ kpɛŋ wǝǝ. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Wǝ́ Oyudatǝpǝ lo omumuŋpǝ we pǝ pǝ̀ nyiyǝ sa lǝ ǝmǝtǝpǝ ǝkǝnǝŋ: «Kǝceece nǝ piyǝ ŋ kaamǝ nyiyǝ sa? Wǝ́ nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ laanyɩŋtǝyǝ wǝ́ ŋ ri ǝrǝ kǝ́ nǝ nyǝ mǝ ŋwǝ wǝ? Wǝ́ wǝ le yee nɛ wǝ́ ŋ ya ŋ náa nyɩŋ rǝkǝsa wǝ?» <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />Wǝ́ nǝ ǝmǝtǝpǝ we pǝ tìi pǝ ǝkǝnǝŋ: «Le cii wǝ sɩsiɛrɩ ǝkǝnǝŋ leh piyǝ ŋ lǝǝwe. Laanyɩŋtǝyǝ wǝ́ ŋ ri ǝrǝ kǝ́ lǝ mǝnǝ ŋwǝ wǝ. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Paa yǝ lee ci kǝ́ wǝ le yee wǝ́ ŋ ya ŋ náa nyɩŋ rǝkǝsa wǝ. Yǝ laa lɛ le ci yǝ we ŋ na cá ne enimiyǝ wǝ. Nyiyǝ sa la wasa, nǝ mǝ pǝ́ ŋwǝ láa tɛŋ ne dierǝ!» <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Nǝ ǝmǝtǝpǝ pǝ ko ŋ suu Oyudatǝpǝ lo omumuŋpǝ sa kǝto wǝ́ pǝ wɛɛlɩ ǝnǝ. Duturǝ ɖi pǝ la tɛŋ wǝ pǝ lǝ tǝnǝ kaka, ǝkǝnǝŋ, mǝŋ rɛ la tɛŋ ǝkǝnǝŋ Yesu ŋ ri Mesiyayǝ we we, pǝ lée piri yǝ we rǝ pǝlo gumwɛŋnyuŋkpǝ. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Wǝ kǝto nǝ ǝmǝtǝpǝ pǝ tɛnɩ ǝkǝnǝŋ «Nyiyǝ sa la wasa, nǝ mǝ pǝ ŋwǝ» wǝǝ.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Wǝ́ Afarisitǝpǝ sa pǝ tǝ pǝ pwò nyiyǝ sa ŋ naa ka ŋ nyɩŋ wǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Tɛŋ anʊkɔrǝyǝ rǝ Worokoyǝ le enimiyǝ! Ŋlǝ we, le cii wǝ ǝkǝnǝŋ nyiyǝ sa, turɔɔrɔɔyeetǝyǝ ŋ lǝǝwe.» <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />Wǝ́ nyiyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ nee ci mǝŋ turɔɔrɔɔyeetǝyǝ wǝ́ ŋ ri wǝ. Tuwǝ ceŋceŋ ko wǝ́ ŋ́ cii, wǝ kaamǝ ǝkǝnǝŋ laanyɩŋtǝyǝ wǝ́ ŋ́ ke ri. Paa rǝkǝsa we, ŋ́ ya ŋ́ náa nyɩŋ!» <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />Wǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ ŋ ne yee mǝ lǝ́? Nɛ wǝ́ ŋ ne yee wǝ́ ŋ na cá lé enimiyǝ wǝ?» <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ na marǝ etii nǝ wǝ. Paape nǝ nyoo co kǝtukoŋkǝ! Kǝ́ kǝto wǝ́ nǝ tǝ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ nuŋ wǝ wǝ? Amaa nǝ ya nǝ nyǝ́ǝ pǝ́ ŋnǝ ŋkpɛ nǝ siɛrɩ nǝ yee no otukarǝtǝpǝ rǝ?» <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />Wǝ́ Afarisitǝpǝ we pǝ ya pǝ ka ŋ fɛɛpɩ ŋwǝ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋlǝ́ e ri no tukarǝtǝyǝ rǝ! Ŋlǝ we, Mose lo otukarǝtǝpǝ wǝ́ le ri. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Le cii wǝ ǝkǝnǝŋ Worokoyǝ wɛ̀ɛlɩ mǝ Mose. Paa yǝ ǝnǝ we, yǝ lee ce le ci fɛɛwǝ ŋ no ru!» <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />Wǝ́ nyiyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ wǝ tuwǝ sa wǝ lóo co vurǝ wǝ! Duturǝ ɖi nǝ nyee ci fɛɛwǝ ŋ no ru, paape la cá mǝ enimiyǝ! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Le cii wǝ ǝkǝnǝŋ Worokoyǝ lǝŋ co kǝtukoŋkǝ rǝ oturɔɔrɔɔyeetǝpǝ. Paa lóo co kǝtukoŋkǝ rǝ nyiyǝ we ŋ náa sʊma ŋwǝ mǝ anʊkɔrǝyǝ wǝ́ ŋ née yee rǝ nǝ kǝǝpǝ́wǝ wǝ. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Lo foo nuŋ pǝ tɛŋ pǝ nyɩŋ pwi ǝkǝnǝŋ rɛ la cá nyiyǝ ŋ nǝŋ nyɩŋ ǝrǝ kǝ́ pǝ lǝ mǝ ŋwǝ le enimiyǝ! <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Mǝŋ nyiyǝ sa loo ko ru rǝ Worokoyǝ lǝ kpǝŋ we, lǝŋ ko koru tǝrɛ le eyee.» <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ yǝ fee, ǝrǝ kǝ́ pǝ lǝ mǝ lǝ́ e kpii rǝ turɔɔrɔɔwǝ lǝ mǝrǝ! Wǝ́ ǝ lǝ pǝ́ a kaŋ lǝ otuyǝ?» Wǝ́ pǝ pìri ŋwǝ pǝ rù.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Wǝ́ Yesu ŋ nunu wǝ ǝkǝnǝŋ Afarisitǝpǝ we pǝ le piri laanyɩŋtǝyǝ sa ŋ na kpaa wǝ. Kǝ́ Yesu ŋ na ka nyɩŋ ŋwǝ we, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́, a la lɔ Nyɩmaasɩ le Pi o lo nuŋ?» <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />Wǝ́ nyiyǝ sa ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋwǝ ŋ kaamǝ ǝlǝ, kǝ ŋ́ nya fɛɛ ŋ́ lɔ ŋwǝ ŋ́ nuŋ?» <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ ponu, a ya láa nyɩŋ ŋwǝ wǝǝ! Ŋwǝ ŋ ya ŋ náa wɛɛlɩ mǝ lǝ́ ǝnǝ.» <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />Wǝ́ nyiyǝ sa ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ na lɔ ŋ́ no nuŋ.» Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ. <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ pǝ ǝrǝkǝ sa ŋ́ pa tɛŋ wǝkpaŋkpǝ rɛ rǝ, kǝ epǝ we pǝ laa ka ŋ nyɩŋ we, pǝ ŋ nyɩŋ. Epǝ we pǝ ka ŋ nyɩŋ we pǝ siɛrɩ pǝ yee alaanyɩŋtǝpǝ.» <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />Wǝ́ Afarisitǝpǝ we pǝ ka yaa rǝ fɛɛwǝ we pǝ nunu etieyǝ sa. Wǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Kǝto ŋla ŋkpɛ alaanyɩŋtǝpǝ wǝ́ le ri?» <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ nǝ keh ri alaanyɩŋtǝpǝ we, nǝ nyǝŋ ke ri oturɔɔrɔɔyeetǝpǝ! Paa kǝ́ wǝ ri, nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ “Yǝ láa nyɩŋ” we, nǝ oturɔɔrɔɔyǝ yǝ tɛɛ rǝ nǝ.»<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Mɛɛrǝŋtǝceeceeyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, yǝ we ŋ nǝŋ fǝ rǝ guŋpolurǝ ŋ fii mɛɛpwiirǝ lǝ mǝrǝ, paa ŋ ka rɛ giriŋrǝ we rǝ kǝtarɛɛkǝ ŋ fii we, yǝ we ri rǝ yɩlayɩtǝyǝ, nyiwʊʊlʊtǝyǝ. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Paa yǝ we ŋ nǝ́ǝ fǝ rǝ guŋpolurǝ mǝ ŋ fii we, ŋwǝ ŋ ri mɛɛrǝŋtǝyǝ wǝ. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Yǝ we ŋ nǝ́ǝ rǝŋ mɛɛpwiirǝ we láa taanǝ na ŋwaarǝ. Wǝ́ amɛɛpǝ we pǝ lóo nuŋ mɛɛrǝŋtǝyǝ we la kpɛɛwǝ. Lóo pwo na amɛɛpǝ, yǝ ri ŋ yǝ mǝ na nyɩŋrǝ ŋ ne kpii ŋwǝ wǝ, ŋ pɔrʊ pǝ ŋ ru. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Vǝ́ la pɔrʊ pǝlo kpǝlo lo ru la lɛɛ we, ŋ coŋ mǝ pǝ. Amɛɛpǝ we pǝ ŋ tɛɛmǝ ŋwǝ, kpiikǝ pǝ cii na kpɛɛwǝ. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Pǝ lǝŋ pe siimǝ nyiyǝ rɛ pǝ lee ci pwi. Paa pǝ loh mǝ suu rǝ nǝ kpǝŋ rǝ! Duturǝ ɖi pǝ lee ci na kpɛɛwǝ.» <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />Yesu cà pǝ lo duturǝ sa paape pǝ loo nuŋ tuwǝ sa ŋ ke ŋ tíi pǝ lo duturǝ. <verse eid="JHN 10:6" /><verse number="7" style="v" sid="JHN 10:7" />Wǝ́ Yesu ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋmǝ ŋ́ ri guŋpolurǝ ŋ koonu amɛɛpǝ. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Epǝ we kpǝlo kɩɩkɩ pǝ lǝ pǝ pǝ lo coŋ pǝ lo koonu mǝ we, ayɩlayɩtǝpǝ mǝ enyiwʊʊlʊtǝpǝ wǝ́ pǝ ri. Paa amɛɛpǝ we pǝ loo co kǝtukoŋkǝ rǝ pǝ. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ŋmǝ ŋ́ ri guŋpolurǝ wǝ. Mǝŋ rɛ lǝ fǝ rǝ mǝ le fii we, láa nya alɔkuŋkǝ. Leh mǝ fii, ŋ ru. Láa nya keeriwǝ. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Yɩlayɩtǝyǝ we, lǝ pǝ ŋ pa yɩɩ rǝ, ŋ pa wʊ rǝ, ŋ pǝ nǝǝnǝ rǝ ko feepi wǝǝ. Ŋmǝ paa we, ŋ́ nǝ pǝ kǝ anyɩmaasɩpǝ pǝ nya fɛɛ pǝ nya vɔrʊrǝ, kǝ pǝ nya rǝ ŋpaŋpa. <verse eid="JHN 10:10" /><verse number="11" style="v" sid="JHN 10:11" />Ŋmǝ ŋ́ ri mɛɛrǝŋtǝceeceeyǝ wǝ. Mɛɛrǝŋtǝceeceeyǝ lǝ́ǝ fǝ na vɔrʊrǝ mǝ ŋ koonu rǝ na amɛɛpǝ lo yurǝ. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Nyiyǝ we ŋ née yee kǝnǝnɛkǝ mǝ ŋ lɔ rǝ sɩkayǝ we, lee ri mɛɛrǝŋtǝpoŋpiyǝ. Wǝ́ amɛɛpǝ we pǝ laa lɛ pǝ ri ŋwǝŋwǝ na anɛŋ! Vǝ́ la nyɩŋ jekeeteerǝ lo furu we, ŋ maa amɛɛpǝ we ŋ co, oturu lo suu la pwɛyɩ. Jekeeteerǝ sa lǝ ŋ lɔ arɛɛpǝ. Oturu la caŋ mɛɛkpǝŋwǝ we. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Kpiikǝ nyiyǝ sa ya lée yee anǝnɛyǝ mǝ ŋ taa sɩkayǝ rǝ. Kǝto loo co oku rǝ amɛɛpǝ sa. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Ŋmǝ ŋ́ ri mɛɛrǝŋtǝceeceeyǝ. Ŋ́ cii mǝ amɛɛpǝ wǝ́ mǝ amɛɛpǝ pǝ cii mǝ, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />mǝŋ kǝ́ mǝ Tǝ ŋ cii mǝ wǝ́ ŋmǝ ŋkpɛ ŋ́ cii mǝ Tǝ kǝtǝ. Ŋ́ nǝ́ǝ fǝ mǝ vɔrʊrǝ mǝ ŋ koonu rǝ mǝ amɛɛpǝ lo yurǝ. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Ŋ́ lǝǝmǝ amɛɛpʊŋpwapǝ. Pǝ lee kpii rǝ mɛɛpwiirǝ sa lǝ mǝrǝ. Wǝ kpii kǝ ŋ́ re pǝ ŋ́ pǝ ŋpǝ ŋkpɛ, pǝ loh po nuŋ mǝ kpɛɛwǝ. Eniyǝ we pǝlo kpǝlo pǝ le yee mɛɛkpǝŋwǝ ceŋceŋ, mǝ mɛɛrǝŋtǝyǝ ceŋceŋ. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />Kǝto Tǝyǝ láa taa mǝ kǝǝwǝ duturǝ ɖi ŋ́ nǝ́ǝ fǝ mǝ vɔrʊrǝ mǝ ŋ koonu kǝ ŋ́ tǝ ŋ́ siɛnɩ ŋ́ pa lɔ rǝ ke. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Rɛ lǝŋ ta mǝ vɔrʊrǝ ŋ lɔ rǝ mǝ! Paa ŋmǝŋmǝ ŋ́ nǝ́ǝ fǝ rǝ mǝ ŋ koonu. Ŋ́ lǝǝmǝ okopiyǝ ŋ́ nǝ́ǝ fǝ mǝ vɔrʊrǝ ŋ́ koonu, wǝ́ ŋ́ lǝǝmǝ okopiyǝ ŋ́ náa siɛnɩ ŋ́ lɔ rǝ. Tuwǝ mǝ Tǝ ŋ ne tíi mǝ ŋ́ yee wǝǝ.» <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />Wǝ́ etieyǝ sa yǝ tǝ yǝ kpii wǝsǝpǝkpǝ rǝ Oyudatǝpǝ we lǝ mǝrǝ ke. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Wǝ́ enyipǝ wa rǝ pǝlǝ mǝrǝ pǝ kaŋ tɛŋ ǝkǝnǝŋ: «Wɛɛrɔɔrɔɔrǝ gbii rǝ ŋwǝ! Ya lée fii yurǝ rǝ! Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo co kǝtukoŋkǝ rǝ ŋwǝ wǝ?» <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />Paa wǝ́ arɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋkǝ nyiyǝ ŋ kpii mǝ wɛɛrɔɔrɔɔrǝ le etietɛŋyǝ wǝǝ! Wɛɛrɔɔrɔɔrǝ lóo koru alaanyɩŋtǝpǝ le enimiyǝ la acá?» <figure style="fig" alt="Un enclos avec un berger et ses brebis" file="lb00014c.tif" size="col" copy="Louise Bass" ref="10:2">Mɛɛrǝŋtǝceeceeyǝ lǝ́ǝ fǝ rǝ guŋpolurǝ mǝ ŋ fii na amɛɛpǝ lǝ kpǝŋ</figure><verse eid="JHN 10:21" /></para>
  <para style="s">Pǝ lǝ sǝ́ŋ Yesu pǝ lo co</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Oyudatǝpǝ pǝ ke ŋ ri Worokoyǝ la nyarǝwǝ le etiinikǝ la wǝcɛkpǝ<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">Esiritǝpǝ pǝ cɩ̀ɩrɩ Worokoyǝ la nyarǝwǝ, kǝto wǝ ke kpii kǝ Oyudatǝpǝ pǝ tiini wǝ rǝ pǝlo kǝsuŋkǝ.</char></note> rǝ Yerusalɛmǝ. Anyɩŋ asiɛniyǝ yǝ lǝǝwe. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Wǝ́ Yesu ŋ yà ŋ ka ŋ saŋ mǝ ŋ ko mǝ ŋ pǝ rǝ fɛɛwǝ we pǝ lóo pwo ǝkǝnǝŋ Salomɔ la fɛɛlǝwǝ, rǝ Worokoyǝ la nyarǝwǝ wǝ. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Wǝ́ Oyudatǝpǝ pǝ kolu pǝ cò pǝ sìri ŋwǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «A láa maa lǝ lǝ mǝ tǝmǝlǝ ko ro ǝrǝ eniyǝ rǝ fǝŋ? Mǝŋ ŋlǝ́ e ri Mesiyayǝ we we, pɔrʊ wǝ e tíi lǝ feŋteŋ!» <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ na marǝ ŋ́ ne tíi nǝ wǝ! Paape nǝ nyaa lɔ mǝ nǝ nuŋ. Anǝnɛyǝ sa ŋ́ ya ŋ́ née yee rǝ mǝ Tǝ la nyɩŋrǝ we, yǝ ya yǝ lée ri mǝ ɖaŋsieyǝ wǝ. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Paape nǝ nyaa ya nǝ nyáa lɔ mǝ nyǝ ŋ nuŋ. Kpiikǝ nǝ nyaa kʊla mǝ amɛɛpǝ kǝto! <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Mǝ amɛɛpǝ pǝ lóo nuŋ mǝ kpɛɛwǝ. Ŋ́ cii pǝ, wǝ́ pǝ lée siimǝ mǝ. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ŋ́ nóo koonu pǝ la vɔrʊlaalɛɛrǝ. Pǝ lǝŋ pǝ kpǝ́ pǝ nǝŋ pwi! Wǝ́ rɛ lee kpii ŋ noh po koru pǝ la ata lɔ rǝ mǝ akaakǝ. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Mǝ Tǝyǝ we ŋ no koonu mǝ pǝ we, naanǝ teeri tu ri ŋ tu. Wǝ́ rɛ lǝǝ lǝmǝ okopiyǝ ŋ náa ta pǝ ŋ lɔ rǝ mǝ Tǝ la akaakǝ<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">Rǝ wǝŋʊrʊrɛɛkpǝ mǝrǝ we, pǝ la tɛŋ ǝkǝnǝŋ: Tuwǝ we mǝ Tǝ ŋ no koonu mǝ we, wǝ naanǝ wǝ teeri tu ri ŋ tu. </char></note>. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ŋlǝ mǝ mǝ Tǝ lǝ lǝ nyiceŋceŋ.»<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Wǝ́ Oyudatǝpǝ pǝ tǝ pǝ rɛ̀mɩ oruyǝ pǝ leh tieni ŋwǝ. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Anǝnɛceeceeyǝ we mǝ Tǝ ŋ no koonu mǝ ŋ́ yee we, ŋ́ na pɔrʊ yǝ wa ŋ́ na kaŋ nǝ. Yǝ lǝ gǝ rǝ fǝŋ kǝto wǝ nǝ nyeh tieni mǝ oruyǝ wǝ?» <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />Wǝ́ Oyudatǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ŋkǝ kǝnǝnɛceeceekǝ rɛ kǝto wǝ́ yǝ lǝ́ǝ pǝ́ le tieni lǝ́ oruyǝ wǝ. Paa rǝ pusuŋtǝtuwǝ rɛ a la tɛŋ kǝto! Duturǝ ɖi ŋlǝ́ nyɩmaasɩyǝ rǝ, kǝ ǝ fǝ lá wɛ e yee Worokoyǝ?» <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Pǝ laa ŋʊrʊ pǝ le kpii rǝ seyǝ la kǝfwɛɛkǝ mǝrǝ ǝkǝnǝŋ: “Ŋ́ na tɛŋ we, nǝ lǝ mǝŋ Worokoyǝ kǝtǝ”? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Mǝŋ nǝ seyǝ sa la tɛŋ ǝkǝnǝŋ epǝ we pǝ la tɛŋ Worokoŋtierǝ pǝ le tíi pǝ lǝ mǝŋ Worokoyǝ we, rɛ lee kpii ŋ nóo koru asiɛ Wǝŋʊrʊkenikenikpǝ. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Wǝ́ nǝ nyée tíi mǝ, ŋmǝ yǝ sa Tǝyǝ ŋ na saa ŋ na pɔrʊ, wǝ́ ŋ ne kpii mǝ ŋ na maŋ rǝ ǝrǝkǝ ǝkǝnǝŋ, ŋmǝ ŋ ya ŋ náa wɛɛlɩ opusuŋtǝtuyǝ! Kpawe ŋ́ na tɛŋ ǝkǝnǝŋ Worokoyǝ le Piyǝ wǝ́ ŋ́ ri kǝto? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Mǝŋ ŋ́ naa ya ŋ́ nee yee mǝ Tǝ la anǝnɛyǝ we, kǝ nǝ paa lɔ mǝ nǝ nuŋ! <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Wǝ́ paa mǝŋ ŋ́ ya ŋ́ née yee yǝ, wǝ́ nǝ nyǝŋ lɔ mǝ nǝ nuŋ rǝ we, we nǝ lɔ ŋyǝ anǝnɛyǝ sa ǝkǝŋtǝ nǝ nuŋ. Mǝŋkǝsa we, nǝ nyóo nuŋ wǝlo duturǝ, kǝ nǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ Tǝyǝ kpii rǝ mǝ, wǝ́ ŋ́ kpii rǝ Tǝyǝ lǝ mǝrǝ.» <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Wǝ́ pǝ tǝ pǝ yili pǝ kǝ ŋ pǝ́ pǝ lɔ Yesu. Wǝ́ ŋ pɔ̀ɔ ŋ rù rǝ pǝla akaakǝ. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ ko ŋ ko Yɔrǝdaŋ la kǝtakǝ nɔ. Fɛɛwǝ we Yowanɛsɩ ŋ sǝnǝ enyipǝ lo Worokomɛŋwiiriwǝ wǝ. Wǝ́ ŋ kolu ŋ kpìi rǝ fɛɛwǝ we. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Wǝ́ enyipǝ wa pǝ kǝ ŋ pǝ nǝ kpǝŋ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Yowanɛsɩ lee yee tucovurǝ rɛ mǝŋ ceŋceŋ. Paape tu ri ŋ tu ŋ na tɛŋ ŋ no ru rǝ nyiyǝ sa we, anʊkɔrǝyǝ yǝ lǝǝwe.» <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Wǝ́ enyipǝ wa pǝ lɔ̀ ŋwǝ pǝ nunu rǝ fɛɛwǝ we.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Yesu la saanǝ Lazaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Nyiyǝ rɛ pǝ lóo pwo Lazaro we, laa ka kpaa. Ke kpii rǝ tǝŋtǝǝwǝ rɛ pǝ lóo pwo Betania. Marɩya mǝ na paatɛ Marǝta lǝ tǝŋtǝǝwǝ wǝ lǝǝwe. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Marɩyayǝ sa ŋ nunu Kulǝtǝyǝ la apɔŋfɛŋfɛŋpǝ rǝ akparǝyǝ, wǝ́ ŋ fǝ̀ no oyurooyǝ ŋ sìɛ yǝ wǝ. Na paanʊyǝ ŋ kaamǝ Lazaro, ŋ kǝ ŋ fǝrǝ wǝ. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Wǝ́ apaatɛpǝ sa eyipǝ pǝ kpìi nyiyǝ ŋ ke tíi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, lé pwetaa ya lǝ́ǝ fǝrǝ». <verse eid="JHN 11:3" /><verse number="4" style="v" sid="JHN 11:4" />Kǝ́ Yesu ŋ no nuŋ tuwǝ sa we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nyarǝpirǝ sa lǝŋ wʊ ŋwǝ. Lóo koonu kǝ pǝ kǝ Worokoyǝ. Saŋ rǝ rǝlo oŋuŋkǝ we, enyipǝ pǝ lǝ́ǝ kǝ Worokoyǝ le Piyǝ ŋwǝ ŋkpɛ.»<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yesu ka ŋ taa Marǝta mǝ na paatɛ mǝŋ Lazaro lǝ kǝǝwǝ. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Paape kǝ́ ŋ no nuŋ ǝkǝnǝŋ Lazaro laa kpaa we, wǝ́ ŋ tǝ ŋ lɔ̀ ŋ tini rǝ fɛɛwǝ we ŋ ke kpii wǝcukpǝ wǝyi. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Wǝla kǝmaakǝ wǝ́ ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Nǝ pǝ kǝ lǝ kpǝlǝŋ lo ko Yudeya.» <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />Wǝ́ no otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, wǝ faa panǝ kǝ́ Oyudatǝpǝ pǝ kǝ ŋ pǝ́ pǝ tieni lǝ́ oruyǝ. Wǝ́ ǝ tǝ a ya lǝ́ǝ pǝ́ ǝ kpǝlǝŋ o ko we?» <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Enipuŋyǝ tǝ mǝ eyi yǝ kpii rǝ jɔkɔŋcirǝ. Mǝŋ rɛ sanǝ lóo ko mǝ jɔkɔŋrǝ we, lǝŋ kpara ŋ tɔɔ. Duturǝ ɖi ya láa nyɩŋ ǝrǝkǝ sa la wǝnyɩɩnɩkpǝ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Wǝ́ mǝŋ rɛ sanǝ lóo ko mǝ dumurǝ we, yǝ we láa kpara ŋ tɔɔ. Duturǝ ɖi wǝnyɩɩnɩkpǝ wǝ lee kpii rǝ ŋwǝ.» <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Kǝ́ Yesu ŋ na tɛŋ tuwǝ sa ŋ na lɛ we, wǝ́ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Leh pwetaa Lazaro la kpɛɛ eniŋrieyǝ. Paape ŋ́ nóo ko ŋ ka saanǝ ŋwǝ.» <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />Wǝ́ otukarǝtǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ wǝ ri la kpɛɛ eniŋrieyǝ rǝ we, we láa kpaa.» <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Yesu kǝ ŋ pǝ́ ŋ tɛŋ ǝkǝnǝŋ Lazaro lǝ kpǝ́ rǝ. Paa otukarǝtǝpǝ we we, pǝ ko ŋ pu wǝ ǝkǝnǝŋ eniŋriepoŋpiyǝ wǝ́ Yesu ŋ ke reemǝ. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Wǝ́ Yesu ŋ pɔ̀rʊ wǝ ŋ tìi pǝ feŋteŋ ǝkǝnǝŋ: «Lazaro lǝ kpǝ́. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Ŋ́ ya ŋ́ náa nya faawǝ rǝ nǝ yurǝ, mǝ kǝ́ ŋ́ nee ke kpii rǝ fɛɛwǝ we wǝ. Mǝŋkǝsa we, kǝ nǝ nya fɛɛ nǝ lɔ mǝ nǝ nuŋ. Paape, nǝ pǝ kǝ lo ko nǝ kpǝŋ.» <verse eid="JHN 11:15" /><verse number="16" style="v" sid="JHN 11:16" />Wǝ́ Toma, pǝ lǝ́ǝ tǝ pǝ ŋ pwo ǝkǝnǝŋ Wɛɛpiyǝ we, ŋ tìi nǝ ǝtǝŋtukarǝtǝpǝ we ǝkǝnǝŋ: «Nǝ pǝ kǝ lo ko ŋla ŋkpɛ, kǝ lǝ kǝ kpǝ́ la kʊla mǝ loh Kulǝtǝyǝ».<verse eid="JHN 11:16" /></para>
  <para style="s">Yesu ŋ ri asaanǝkǝ mǝ vɔrʊrǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Kǝ́ Yesu ŋ ne ke fii we, wǝ́ ŋ nunu ǝkǝnǝŋ wǝ la marǝ alɔ juuniǝ kǝ́ pǝ la ka ŋwaa Lazaro wǝ. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Betania ka maarǝ mǝ Yerusalɛmǝ rǝ. Wǝ lǝ́ǝ lǝ mǝŋ kpaarayǝ ta. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Kǝto wǝ́ Oyudatǝpǝ wa pǝ rù pǝ pǝlǝ pǝ pa ta Marǝta mǝ Marɩya lo turuwǝ mǝ pǝla paanʊ lǝ ǝkpǝ́kǝ. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Kǝ́ Marǝta ŋ no nuŋ ǝkǝnǝŋ Yesu lo furu we, wǝ́ ŋ yili ŋ ko ŋ ko ŋ ko ku mǝ ŋwǝ. Marɩya ŋwǝ paa ke tini rǝ nyarǝwǝ. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Wǝ́ Marǝta ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ e ke kpii rǝ sa we, mǝ paanʊ lǝǝ kǝ kpǝ́! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Paape wǝ kǝ tǝ wǝ ri rǝkǝsa ǝkǝŋtǝ we, ŋ́ cii wǝ, ǝkǝnǝŋ tu ri ŋ tu ǝ lǝ́ǝ pǝ́ Worokoyǝ we, Worokoyǝ lóo koonu lǝ́ wǝ.» <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá paanʊ láa saanǝ ŋ ru rǝ gbɛŋrǝ». <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />Wǝ́ Marǝta ŋ yìili ǝkǝnǝŋ: «Ŋ́ cii wǝ ǝkǝnǝŋ lah pa saanǝ ŋ ru rǝ gbɛŋrǝ vǝ́ enyiǝtǝpǝ pǝ la saanǝ, mǝ jitutururǝ we wǝ.» <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri asaanǝkǝ mǝ vɔrʊrǝ. Yǝ we ŋ na lɔ mǝ ŋ no nuŋ we, ŋ ke ce ŋ kpǝ́ we, lée tii vɔrʊrǝ. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Wǝ́ yǝ we ŋ kpii vɔrʊrǝ wǝ́ ŋ na lɔ mǝ ŋ no nuŋ we, lǝŋ pǝ kpǝ́ pwi. A la lɔ tuwǝ sa o lo nuŋ?» <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />Wǝ́ Marǝta ŋ tìi ŋwǝ ǝkǝnǝŋ: «Awo, Kulǝtǝyǝ, ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ ŋlǝ́ e ri Mesiyayǝ we. Worokoyǝ le Piyǝ. Yǝ we ŋ nǝh pǝ ǝrǝkǝ wǝ.» <verse eid="JHN 11:27" /><verse number="28" style="v" sid="JHN 11:28" />Kǝ́ Marǝta ŋ na tɛŋ tuwǝ sa ŋ na lɛ we, wǝ́ ŋ ko ŋ ko ŋ kolu ŋ pwò na paatɛ Marɩya. Wǝ́ ŋ ŋwàa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ le pe fii, wǝ́ ya lóo pwo lǝ́.» <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Kǝ́ Marɩya ŋ no nuŋ tuwǝ sa we, wǝ́ ŋ yili kalaŋ ŋ ko ŋ ko nǝ kpǝŋ. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Eniyǝ we Yesu fee fii tǝŋtǝǝwǝ sa. Kǝ tǝ yaa rǝ fɛɛwǝ we Marǝta ŋ pǝlǝ ŋ kù mǝ ŋwǝ wǝ. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Oyudatǝpǝ we pǝ ke tini pǝ kʊ̀la mǝ Marɩya rǝ nyarǝwǝ pǝ ka ŋ ta no turuwǝ. Kǝ́ pǝ la nyɩŋ ŋwǝ ŋ ne yi kǝtǝrǝceŋceŋ ŋ no ru we, wǝ́ pǝ yili pǝ sìimǝ ŋwǝ. Duturǝ ɖi pǝ ko ŋ pu wǝ ǝkǝnǝŋ loh ko vuŋtɔŋrǝ we la fɛɛwǝ ŋ ke wee. <verse eid="JHN 11:31" /><verse number="32" style="v" sid="JHN 11:32" />Wǝ́ Marɩya ŋ kolu ŋ ro fɛɛwǝ we Yesu ŋ ka yaa wǝ. Mǝŋ anyɩŋ Yesu eni we, wǝ́ ŋ rù ŋ tɔ̀ɔ rǝ na wǝkʊŋkpǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ e ke kpii rǝ sa we, mǝ paanʊ lǝǝ kǝ kpǝ́!» <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />Kǝ́ Yesu ŋ na nyɩŋ Marɩya ŋ ya ŋ née wee, mǝŋ Oyudatǝpǝ we pǝ ke siimǝ ŋwǝ ŋpǝ ŋkpɛ pǝ ya pǝ lée wee we, wǝ́ wǝ yeli na tǝrɛ ŋpaŋpa, wǝ́ wǝ kpii na awɛɛlɩkǝ. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Wǝ́ ŋ pǝ̀ ǝkǝnǝŋ: «Fǝŋ wǝ́ nǝ nya ŋwaa ŋwǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, pǝ a pa nyɩŋ». <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />Wǝ́ Yesu ŋ weli. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Wǝ́ Oyudatǝpǝ we pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Nǝ yɩrɩ re, ka ŋ taa nǝ kǝǝwǝ oo!» <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />Paa wǝ́ arɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋkǝ ŋwǝ ŋ cà laanyɩŋtǝyǝ we le enimiyǝ? Wǝ́ ŋ noo koru eyee kǝ Lazaro ŋ pǝǝ kpǝ́?» <verse eid="JHN 11:37" /><verse number="38" style="v" sid="JHN 11:38" />Wǝ́ wǝ tǝ wǝ yeli Yesu la tǝrɛ ŋpaŋpa. Wǝ́ ŋ ko ŋ ko wǝfuŋkpǝ we la fɛɛwǝ. Wǝnyaŋkpǝ rɛ wǝ kǝ lǝǝwe. Ɖurǝ ge sii rǝ wǝlo nyuŋkpǝ. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ wuru ɖurǝ we!» Wǝ́ nyiyǝ we ŋ nǝ kpǝ́ la paatɛ Marǝta ŋ ke ŋ tíi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, o lóo po ya láa wɛɛ kaka. Duturǝ ɖi wǝ la marǝ eyee juuniǝ kǝ́ pǝ la ŋwaa ŋwǝ wǝǝ.» <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nee tíi lǝ́ ǝkǝnǝŋ mǝŋ a la lɔ o lo nuŋ, a láa nyɩŋ Worokoyǝ la anaanǝkǝ?» <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Wǝ́ pǝ wùru ɖurǝ we pǝ cɛ̀. Wǝ́ Yesu ŋ yìili ŋ yɩ̀rɩ oŋuŋkǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ Tǝ, ŋ́ ya ŋ́ née ceeni lǝ́ kǝ́ o lo co kǝtukoŋkǝ rǝ mǝ wǝ. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ŋ́ cii wǝ ǝkǝnǝŋ o lóo co kǝtukoŋkǝ rǝ mǝ eni ri ŋ ni. Paape, enyipǝ sa pǝ yaa rǝ fɛɛwǝ sa kǝto wǝ́ ŋ́ na tɛŋ tuwǝ sa ǝnǝ, kǝ pǝ nya fɛɛ pǝ lɔ pǝ nuŋ ǝkǝnǝŋ ŋlǝ́ e le kpii mǝ a la maŋ.» <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Kǝ́ ŋ na tɛŋ ǝnǝ we, wǝ́ ŋ cà narǝwǝ kelele ǝkǝnǝŋ: «Lazaro, ru ǝ pǝ!» <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Wǝ́ nyiǝtǝyǝ sa ŋ rù ŋ pǝlǝ. Pǝ la parǝ no wǝnukpǝ mǝ akparǝyǝ mǝ kɛlɛlɛyǝ la wǝpakpǝ. Ɖukupimumuŋrǝ rɛ zìi ŋwǝ rǝ anyɩŋkǝ. Wǝ́ Yesu ŋ tìi enyipǝ we ǝkǝnǝŋ: «Nǝ wuru ŋwǝ, kǝ nǝ maa ŋwǝ mǝ ŋ ko!» <figure style="fig" alt="Résurrection de Lazare" file="DN00459b.tif" size="col" copy="Darwin Dunham" ref="11:44">Yesu la saanǝ Lazaro lo ru rǝ gbɛŋrǝ</figure><verse eid="JHN 11:44" /></para>
  <para style="s">Oyudatǝpǝ pǝ le ri nyuŋkpǝ pǝ la tɛɛ rǝ Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matewu 26:1-5</ref>, <ref loc="MRK 14:1-2">Marǝko 14:1-2</ref>, <ref loc="LUK 22:1-2">Luka 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ŋpǝ Oyudatǝpǝ we wa pǝ kolu Marɩya lǝ kpǝŋ wǝ́ pǝ nyɩnɩ tuwǝ we Yesu ŋ yeli we, pǝ lɔ̀ ŋwǝ pǝ nunu. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Paa wǝ́ arɛɛpǝ pǝ kolu pǝ tùu Afarisitǝpǝ. Wǝ́ pǝ fǝ̀ tuwǝ we Yesu ŋ yeli pǝ pɔ̀ pǝ la amayǝ. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Wǝ́ otoolutǝmumuŋpǝ we mǝ Afarisitǝpǝ pǝ kù mǝ Oyudatǝkpaŋtɛŋtǝpǝ. Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Yǝ leh yee nɛ? Nyiyǝ sa ya lée yee otucovurǝ ŋpa. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Mǝŋ yǝ la maa ŋwǝ ŋ tǝ ŋ re mǝ ŋ ko ǝnǝ we, enyipǝ kpǝlo kɩɩkɩ pǝ lah pa lɔ ŋwǝ pǝ nuŋ. O loh po turu Oromatǝmumuŋpǝ pǝ leh kpii nyuŋkpǝ. Pǝ lah pa wɔɔ Worokoyǝ la nyarǝwǝ sa, kǝ pǝ wɔɔ lǝh gǝŋrǝ sa.» <verse eid="JHN 11:48" /><verse number="49" style="v" sid="JHN 11:49" />Wǝ́ pǝla rɛɛyǝ pǝ lóo pwo Kayifa, ŋwǝ ŋ ke ri toolutǝmumuŋyǝ mǝ cɛŋwǝ we. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ nyaa ya nǝ nyóo nuŋ tuwǝ wǝ ya wǝ lǝ́ǝ pǝ lo duturǝ! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Nǝ pu wǝ nǝ yɩrɩ! Mǝŋ nyiyǝ ceŋceŋ lǝ kpǝ́ la tɛɛ rǝ kǝkpǝŋkǝ sa lo yurǝ we, wǝ ponu wǝ teeri. Mǝŋkǝsa we rɛ lǝŋ tǝ ŋ pa wɔɔ lǝh gǝŋrǝ sa kpǝlo.» <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Kayifa le etieyǝ sa ŋ tɛnɩ we, ŋkǝ ŋwǝŋwǝ ko ŋ ka ŋ tɛŋ yǝ. Duturǝ ɖi ŋwǝ ŋ ke ri toolutǝmumuŋyǝ cɛŋwǝ we. Kǝto tɛnɩ dierǝ tǝnǝ rǝ ǝkǝnǝŋ wǝ kpii kǝ Yesu ŋ kpǝ́ rǝ Oyudatǝpǝ lǝ gǝŋrǝ lo yuwǝ. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Wǝ́ ŋkǝ kǝkpǝŋkǝ sa ceŋceŋ lo yuwǝ. Paa kǝ ŋ nya fɛɛ ŋ ca Worokoyǝ le epipǝ we pǝ kpii pǝ láa tɛlɩ rǝ ǝrǝkǝ ŋ ku, kǝ pǝ yee kǝkpǝŋkǝ kǝceŋceŋ.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Fǝ rǝ jirǝ we, wǝ́ Oyudatǝmumuŋpǝ pǝ fǝ̀ pǝ tɛ̀ɛ rǝ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ láa wʊ Yesu. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Fɛɛwǝ Yesu ŋ nǝǝ tǝ ŋ ka ŋ tɛɛnɩ mǝ ŋ ru wǝnyɩɩnɩkpǝ rǝ Oyudatǝpǝ lǝ mǝrǝ wǝǝ. Wǝ́ ŋ pwɛ̀yɩ ŋ kolu ŋ kpìi rǝ gaarǝ we maarǝ mǝ nyɔŋkpaakǝtǝǝwǝ, rǝ tǝŋtǝǝwǝ rɛ pǝ lóo pwo Efǝrayimǝ wǝ. Wǝ́ ŋ ce ŋ kpìi rǝ we ŋpǝ mǝ no otukarǝtǝpǝ.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Wǝ́ Oyudatǝpǝ le Eyinyapǝkǝ la wǝcɛkpǝ wǝ pǝlǝ wǝ kǝ ŋ kǝlǝ. Wǝ́ enyipǝ wa pǝ ko ŋ ru rǝ pǝla afɛɛyǝ pǝ ŋ ko Yerusalɛmǝ, pǝ ke yee ewiikǝ lo kǝsuŋkǝ kpɛŋ kǝ wǝcɛkpǝ we wǝ ci oro. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Wǝ́ pǝ ka ŋ taa Yesu rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Nǝ ya nǝ nyóo pu wǝ nɛ rǝ? Kǝto Yesu lǝŋ pǝ wǝcɛkpǝ sa?» <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Otoolutǝmumuŋpǝ we mǝ Afarisitǝpǝ we pǝ tɛnɩ wǝ pǝ tìi enyipǝ ǝkǝnǝŋ, mǝŋ rɛ cii fɛɛwǝ Yesu ŋ kpii we, yǝ we ŋ kuŋ ŋpǝ pǝ ci wǝ kǝ pǝ nya fɛɛ pǝ kpii pǝ ka lɔ ŋwǝ.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Marɩya le fieni Yesu la apɔŋfɛŋfɛŋpǝ rɛ rǝ akparǝyǝ</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matewu 26:6-13</ref>, <ref loc="MRK 14:3-9">Marǝko 14:3-9</ref>, <ref loc="LUK 7:36-50">Luka 7:36-50</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Kǝ́ wǝ lo tuuru wǝcukpǝ wǝkʊraŋ kǝ Eyinyapǝkǝ la wǝcɛkpǝ wǝ ro we, wǝ́ Yesu ŋ kolu Betania. Fɛɛwǝ Lazaro, yǝ we Yesu ŋ sàanǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ ŋ ke kpii wǝǝ. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Wǝ́ pǝ càa keeriwǝ pǝ lɔ̀ ŋwǝ rǝ fɛɛwǝ we. Wǝ́ Marǝta ŋ ya ŋ kǝ ŋ sǝpǝ keeriwǝ we. Anyɩŋ Lazaro ka kʊla mǝ epǝ we pǝ ke tini pǝ ke ŋ ri pǝ ŋ kʊla mǝ Yesu wǝ. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Wǝ́ Marɩya ŋ fǝ̀ apɔŋfɛŋfɛŋpǝ rɛ pǝ la lɔ okuruyǝ, litayǝ la yarǝ, ŋ pǝlǝ ŋ fìeni Yesu la akparǝyǝ. Narǝyǝ<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">Narǝyǝ ri rǝ wǝciikpǝ rɛ. Wǝla mɛŋwǝ wǝ láa wɛɛ fɛŋfɛŋ.</char></note> wǝ́ pǝ lǝ fǝ pǝ le yee apɔŋpǝ sa. Wǝ́ ŋ fǝ̀ no oyurooyǝ ŋ sìɛ yǝ. Wǝ́ apɔŋfɛŋfɛŋpǝ sa la jwɩɩrǝ dò nyarǝwǝ sa kpǝlo kɩɩkɩ. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Wǝ́ Yesu lo otukarǝtǝpǝ we la rɛɛyǝ pǝ lóo pwo Yuda Isǝkario, ŋwǝ yǝ we ŋ pǝlǝ ŋ sìiri Yesu, ŋ pǝ̀ ǝkǝnǝŋ: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />«Kǝ́ kǝto wǝ́ pǝ lee siiri apɔŋfɛŋfɛŋpǝ sa sɩkakpotokpotoyǝ tuuruta, kǝ pǝ fǝ pǝ koonu ariariatǝpǝ wǝ?» <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Kǝ́ ŋ tɛnɩ tuwǝ sa we, ŋkǝ kǝ ŋ kǝǝnǝ ariariatǝpǝ rǝ oo! Paa yɩlayɩtǝyǝ ŋ lǝǝwe. Ŋwǝ ŋ ke ŋ re zɩkalotorǝ wǝ. Wǝ́ ŋ ka ŋ yɩɩ sɩkayǝ we pǝ le kpii rǝ rǝ wǝ. <verse eid="JHN 12:6" /><verse number="7" style="v" sid="JHN 12:7" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Maa tieyǝ sa rɛyɩɩ! Ya lée yee tuwǝ sa mǝ ŋ tǝnǝ jirǝ we pǝ láa ŋwaa mǝ wǝ.<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Maa ŋwǝ ŋ kʊʊ tuwǝ we ŋ lǝǝmǝ ŋ tǝnǝ jirǝ we pǝ láa ŋwaa mǝ wǝ».</char></note> <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Ariariatǝpǝ we, pǝ kpii mǝ nǝ kǝkpakǝkpa. Paa ŋmǝ we, ŋ́ nee kpii mǝ nǝ kǝkpakǝkpa.»<verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Wǝ́ Oyudatǝpǝ lǝ kpǝŋmumuŋwǝ rɛ wǝ nunu ǝkǝnǝŋ Yesu kpii rǝ Betania. Wǝ́ pǝ rù pǝ kǝŋ pǝ, ŋkǝ rǝ Yesu ceŋceŋ lo yurǝ. Paa kǝ pǝ pa nyɩŋ Lazaro yǝ we Yesu ŋ sàanǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Wǝ́ otoolutǝmumuŋpǝ we pǝ fǝ pǝ tɛ̀ɛ rǝ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ lóo kuŋ pǝ wʊ Lazaro ŋwǝ ŋkpɛ. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />Kpiikǝ ŋwǝ Lazaro kǝto wǝ́ Oyudatǝpǝ wa pǝ cɛ̀ rǝ pǝla kǝmaakǝ, wǝ́ pǝ lɔ̀ Yesu pǝ nunu wǝ.<verse eid="JHN 12:11" /></para>
  <para style="s">Pǝ lo po ku mǝ Yesu mǝ faawǝ pǝ le fii Yerusalɛmǝ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matewu 21:1-11</ref>, <ref loc="MRK 11:1-11">Marǝko 11:1-11</ref>, <ref loc="LUK 19:28-40">Luka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Gaalǝǝrǝkǝ, wǝ́ nyikpǝŋmumuŋwǝ we wǝ lǝ pǝ wǝcɛkpǝ we wǝ nunu ǝkǝnǝŋ Yesu lo furu Yerusalɛmǝ. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Wǝ́ enyipǝ pǝ fǝ̀ epieŋyǝ, wǝ́ pǝ rù pǝ ko ŋ ko pǝ ko ku mǝ ŋwǝ. Wǝ́ pǝ yà pǝ ko ŋ woolu pǝ tɛŋ ǝkǝnǝŋ: «Kǝ lǝ kǝ Worokoyǝ! Worokoyǝ ŋ pɛɛrɩ yǝ we ŋ no furu rǝ na nyɩŋrǝ wǝ. Worokoyǝ ŋ pɛɛrɩ Isǝrayɛlǝ le Piliyǝ.» <verse eid="JHN 12:13" /><verse number="14" style="v" sid="JHN 12:14" />Wǝ́ Yesu ŋ nyɩnɩ ɖookɛtɛtǝŋrǝ rɛ. Wǝ́ ŋ rɛ̀ ŋ tini rǝ rǝ, mǝŋ kǝ́ pǝ la ŋʊrʊ wǝ rǝ Wǝŋʊrʊkenikenikpǝ kǝtǝ ǝkǝnǝŋ:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />«Ziɔŋ lǝ tǝŋtǝǝwǝ, poo suu vurǝ!</para>
  <para style="q1" vid="JHN 12:15">Yɩrɩ re! Le piliyǝ ŋ nǝ́ǝ pǝ ǝnǝ!</para>
  <para style="q1" vid="JHN 12:15">Tini rǝ ɖookɛtɛtǝŋrǝ.»<verse eid="JHN 12:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="JHN 12:16" />Yesu lo otukarǝtǝpǝ sa pǝ laa maa pǝ nuŋ otuyǝ sa yǝ kǝ ŋ pǝ lo duturǝ mǝ kǝsǝŋkǝ. Paa kǝ́ Worokoyǝ ŋ na pa rɛɛrɩ mǝ Yesu ŋ na lɛ we, wǝ́ pǝ tàalǝ ǝkǝnǝŋ wǝŋʊrʊkpǝ wǝ tɛnɩ tuwǝ sa wǝ rù rǝ ŋwǝ. Ŋ wǝ tuwǝ sa wǝ́ pǝ yeli mǝ ŋwǝ wǝ.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Epǝ we kpǝlo kɩɩkɩ pǝ ka kʊla mǝ Yesu, eniyǝ we ŋ pwò Lazaro ŋ rù rǝ wǝfuŋkpǝ, wǝ́ ŋ sàanǝ ŋwǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ we, pǝ ke ŋ ri wǝla ɖaŋsieyǝ. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Kǝ́ kǝkpǝŋkǝ sa kǝ nunu ǝkǝnǝŋ Yesu le yee tucovurǝ sa kǝto wǝ́ pǝ rù pǝ ko ku mǝ ŋwǝ. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Wǝ́ Afarisitǝpǝ we pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Nǝ ya nǝ nyáa nyɩŋ, nǝ nyǝŋ po koru tǝrɛ le eyee oo. Enyipǝ kpǝlo kɩɩkɩ pǝ siimǝ ŋwǝ!»<verse eid="JHN 12:19" /></para>
  <para style="s">Ehelatǝpǝ rɛ pǝ lǝ pǝ́ pǝ nyɩŋ Yesu</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Ehelatǝpǝ rɛ pǝ ka kʊla mǝ epǝ we pǝ pǝlǝ Yerusalɛmǝ pǝ pa sʊma Worokoyǝ mǝ wǝcɛkpǝ sa lǝ mǝrǝ. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Wǝ́ pǝ rùu pǝ kǝ̀lǝ mǝ Filipo ŋ no ru rǝ Bɛsayɩda, wǝ kpii rǝ Galileya la gaarǝ wǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, yǝ lǝ́ǝ pǝ́ la nyɩŋ Yesu». <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Wǝ́ Filipo ŋ kolu ŋ tìi Aŋdǝre lǝ wǝ. Wǝ́ pǝle eyi pǝ tìi Yesu lǝ wǝ. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Eniyǝ yǝ lo ro kǝ Worokoyǝ ŋ rɛɛrɩ mǝ Nyɩmaasɩ le Pi. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ pǝ la rʊ durʊʊpirǝ rɛ wǝ́ lee fwe we, anyɩŋ gbii ŋrǝ ceŋceŋ. Wǝ́ paa vǝ́ le fwe we, lǝ ŋ wi, lǝ ŋ nyɩŋ ŋpa. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Yǝ we ŋ náa taa na wɛ la vɔrʊrǝ we, lǝ́ǝ lǝǝrǝ rǝ. Paa yǝ we ŋ nǝ́ǝ kpǝlǝ na vɔrʊrǝ lǝ kǝǝwǝ rǝ ǝrǝkǝ sa lǝ mǝrǝ we, lóo toolu rǝ ŋ tǝnǝ koonu vɔrʊlaalɛɛrǝ. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Mǝŋ rɛ lǝ́ǝ pǝ́ ŋ sʊma mǝ we, wǝ kpii kǝ yǝ we ŋ siimǝ mǝ. Mǝŋkǝsa we, fɛɛwǝ we ŋ́ kpii we, fɛɛwǝ mǝ sʊmatǝyǝ ŋwǝ ŋkpɛ ŋ née kpii wǝǝ. Mǝŋ rɛ ya láa sʊma mǝ we, Mǝ Tǝ lǝ́ǝ kǝ ŋwǝ.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Rǝkǝsa ŋ́ nǝǝ tǝ ŋ́ lǝmǝ yuceeceerǝ rɛ. Kǝ́ wǝ́ ŋ́ nah tɛŋ? Ŋ́ tɛŋ ǝkǝnǝŋ mǝ Tǝ, pɔrʊ mǝ o ru rǝ acʊcʊʊrʊpiniyǝ sa lǝ mǝrǝ? Paa ŋyǝ eniyǝ sa kǝto wǝ́ ŋ́ nǝ pǝ wǝ. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Mǝ Tǝ, koonu kǝ pǝ kǝ lá nyɩŋrǝ.» Wǝ́ kpɛɛwǝ rɛ wǝ rù rǝ yulaarǝ wǝ sʊ̀ʊ ǝkǝnǝŋ: «Ŋ́ no koonu pǝ lǝ kǝ rǝ kaka. Wǝ́ ŋ́ nǝ́ǝ tǝ ŋ koonu pǝ kǝ rǝ ke.» <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Kǝkpǝŋkǝ we kǝ ka yaa rǝ fɛɛwǝ we kǝ nunu. Wǝ́ kǝ ka ŋ tɛŋ ǝkǝnǝŋ ǝrǝkǝ kǝ la tɔɔ. Wǝ́ arɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ picoŋpiyǝ rɛ la wɛɛlɩ mǝ ŋwǝ. <verse eid="JHN 12:29" /><verse number="30" style="v" sid="JHN 12:30" />Wǝ́ Yesu ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Ŋkǝ ŋmǝ kǝto wǝ́ kpɛɛwǝ sa wǝ la wɛɛlɩ wǝ. Paa ŋnǝ kǝto. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Rǝkǝsa eniyǝ yǝ lo ro, Worokoyǝ lah tɛŋ ǝrǝkǝ sa la wǝkpaŋkpǝ. Rǝkǝsa eniyǝ yǝ lo ro, pǝ leh piri nyiyǝ we ŋ na lɔ ǝrǝkǝ sa ŋ na kaa wǝ. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Ŋmǝ we, vǝ́ pǝ lǝ fǝ mǝ rǝ kǝtǝǝwǝ pǝ la rɛ oŋuŋkǝ we, ŋ́ née tiini anyɩmaasɩpǝ kpǝlo kɩɩkɩ ŋ́ pǝ mǝ kpǝŋ.» <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Yesu tɛnɩ tuwǝ sa ǝnǝ kǝ ŋ fǝ ŋ kaŋ gbɛŋrǝ we wǝrʊʊkpǝ ŋ nǝh pǝ ŋ pǝ kpǝ́ wǝ. <verse eid="JHN 12:33" /><verse number="34" style="v" sid="JHN 12:34" />Wǝ́ kǝkpǝŋkǝ we kǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lo nuŋ wǝ rǝ seyǝ la wǝfwɛɛkpǝ lǝ mǝrǝ ǝkǝnǝŋ Mesiyayǝ we lée tii vɔrʊrǝ kǝkpakǝkpa. Wǝ́ wǝ lée yee nɛ wǝ́ a láa tɛŋ ǝkǝnǝŋ wǝ kpii kǝ pǝ rɛɛrɩ mǝ Nyɩmaasɩ le Pi wǝ? Wǝ́ ǝlǝ ŋ ri Nyɩmaasɩ le Pi rǝ oŋuŋkǝ wǝ?» <verse eid="JHN 12:34" /><verse number="35" style="v" sid="JHN 12:35" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Wǝnyɩɩnɩkpǝ wǝ tǝ wǝ kpii wǝ kʊla mǝ nǝ rǝ enipiyǝ rɛ lǝ mǝrǝ. Kǝ́ wǝnyɩɩnɩkpǝ wǝ nya wǝ kpii we, nǝ mǝ saŋ kǝ nuŋtumuwǝ wǝ poo po somu nǝ. Duturǝ ɖi yǝ we ŋ sanǝ mǝ nuŋtumuwǝ ŋ nóo ko we, lee ci fɛɛwǝ ŋ noh ko. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Nǝ lɔ wǝnyɩɩnɩkpǝ nǝ nuŋ, eniyǝ we wǝ tǝ wǝ kpii mǝ nǝ wǝ, kǝ nǝ nya fɛɛ nǝ siɛrɩ nǝ yee wǝnyɩɩnɩkpǝ le epipǝ.» Kǝ́ Yesu ŋ ne tíi pǝ lo tuwǝ sa ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ rǝ pǝlǝ kpǝŋ ŋ kolu ŋ ŋwàa.<verse eid="JHN 12:36" /></para>
  <para style="s">Oyudatǝpǝ pǝ laa lɔ Yesu pǝ nuŋ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Mǝŋ kǝ́ Yesu ŋ yeli otucovurǝ rǝ pǝle enimiyǝ paape pǝ laa lɔ ŋwǝ pǝ nuŋ. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Kǝ́ wǝ yeli wǝǝ wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya lo tuwǝ ŋ tɛnɩ wǝ pǝlǝ wǝǝ. Tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="JHN 12:38">«Ǝtǝ Woroko, ǝlǝ ŋ na lɔ dierǝ we la tɛnɩ le tìi pǝ ŋ no nuŋ wǝ?</para>
  <para style="q1" vid="JHN 12:38">Ǝlǝ wǝ́ Ǝtǝ Woroko ŋ pɔ̀rʊ no okopiyǝ ŋ kanǝ wǝ?» <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />Ezaya lɛ̀ tɛnɩ tuwǝ kǝto wǝ́ pǝ loo koru alɔ pǝ nuŋ wǝ. Tɛnɩ ǝkǝnǝŋ: <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />«Worokoyǝ lǝ tǝrǝ pǝle enimiyǝ.</para>
  <para style="q1" vid="JHN 12:40">Wǝ́ ŋ ne kpii pǝ lo yulɛnyɩrǝ,</para>
  <para style="q1" vid="JHN 12:40">kǝ pǝle enimiyǝ yǝ paa nyɩŋ,</para>
  <para style="q1" vid="JHN 12:40">kǝ pǝ paa lɛ pǝ nuŋ tǝrɛ lo duturǝ,</para>
  <para style="q1" vid="JHN 12:40">kǝ pǝ paa siɛrɩ pǝ pǝ mǝ kpǝŋ,</para>
  <para style="q1" vid="JHN 12:40">kǝ ŋ́ pa cá pǝ!»<verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />Ezaya tɛnɩ tuwǝ sa kpiikǝ ŋ nyɩnɩ Yesu la wǝnyɩɩnɩkpǝ, wǝ́ ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ ŋwǝ kǝto.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Paape rǝ Oyudatǝpǝ lo omumuŋpǝ we ŋpǝŋpǝ lǝ mǝrǝ we, enyipǝ wa pǝ lɔ̀ Yesu pǝ nunu. Paape Afarisitǝpǝ we kǝto, pǝ loo ko ŋ tu turuwǝ pǝ ŋ pɔrʊ wǝ pǝ ŋ tɛŋ. Duturǝ ɖi pǝ ko ŋ suu vurǝ ǝkǝnǝŋ pǝ leh pe piri pǝ rǝ pǝlo gumwɛŋnyuŋkpǝ. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Kpiikǝ pǝ ka ŋ taa anyɩmaasɩpǝ pǝ kǝ pǝ pǝ ŋ teeri kǝ́ Worokoyǝ ŋ nǝ́ǝ kǝ pǝ wǝ.<verse eid="JHN 12:43" /></para>
  <para style="s">Yesu le dierǝ wǝ́ pǝ lǝh pǝ fǝ pǝ tɛŋ wǝkpaŋkpǝ</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Wǝ́ Yesu ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Yǝ we ŋ na lɔ mǝ ŋ no nuŋ we, rǝ anʊkɔrǝyǝ we, ŋkǝ ŋmǝ ceŋceŋ wǝ́ ŋ na lɔ ŋ no nuŋ, paa la lɔ mǝŋ yǝ we ŋ ne kpii mǝ ŋ na maŋ lo nuŋ. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Yǝ we ŋ ya ŋ náa nyɩŋ mǝ we, ya láa nyɩŋ yǝ we ŋ ne kpii mǝ ŋ na maŋ ŋwǝ ŋkpɛ. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ŋmǝ we, ŋ́ nǝ pǝ ǝrǝkǝ mǝŋ wǝnyɩɩnɩkpǝ kǝtǝ. Mǝŋkǝsa we, yǝ we ŋ na lɔ mǝ ŋ no nuŋ we, lǝŋ pe kpii rǝ nuŋtumuwǝ. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Mǝŋ rɛ lóo nuŋ mǝ etieyǝ, paa lǝŋ yee ŋ saŋ rǝ yǝ we, ŋkǝ ŋmǝ ŋ́ náa tɔɔ na bɔrǝ wǝ. Duturǝ ɖi ŋ́ nǝǝ pǝ ŋ́ pa tɔɔ ǝrǝkǝ la bɔrǝ rǝ. Paa ŋ́ nǝ pǝ ŋ́ pa lɔ ŋ koonu ǝrǝkǝ rǝ. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Yǝ we ŋ nǝ sǝ́ŋ mǝ, wǝ́ ŋ naa lɔ mǝ etieyǝ we, yǝ we la nya tuwǝ wǝ lah tɔɔ na bɔrǝ wǝ. Etieyǝ we ŋ́ na tɛŋ we, ŋyǝ yǝ láa tɔɔ na bɔrǝ rǝ jitutururǝ we wǝ. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Duturǝ ɖi ŋ́ naa wɛɛlɩ rǝ ŋmǝŋmǝ mǝ okopiyǝ. Paa Tǝyǝ we ŋ ne kpii mǝ ŋ na maŋ we, ŋwǝŋwǝ ŋ no koonu mǝ dierǝ we ŋ nah pa tɛŋ kǝ ŋ́ kaŋ wǝ. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Wǝ́ ŋ́ cii ǝkǝnǝŋ ne seyǝ sa lóo koonu vɔrʊlaalɛɛrǝ. Kǝto otuyǝ we ŋ́ ya ŋ́ náa tɛŋ we, ŋ́ náa tɛŋ yǝ mǝŋ kǝ́ mǝ Tǝ ŋ ne tíi mǝ yǝ wǝ.»<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesu la wɛɛ no otukarǝtǝpǝ la akparǝyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Jitutururǝ we kǝ pǝ ŋ ri Eyinyapǝkǝ la wǝcɛkpǝ gǝ lǝǝwe. Yesu ke cii wǝ ǝkǝnǝŋ ne eniyǝ yǝ lo ro ŋ nah pwɛyɩ rǝ ǝrǝkǝ sa ŋ mǝ ŋ ko Tǝyǝ lǝ kpǝŋ. Ka ŋ taa na anɛŋpǝ we pǝ ke kpii rǝ ǝrǝkǝ lǝ kǝǝwǝ. Wǝ́ ŋ taa pǝlǝ kǝǝwǝ ŋ kolu ŋ lɛ̀ rǝ<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Tàa pǝ lǝ kǝǝwǝ wǝlǝ kǝtǝŋkǝ wǝ lee kpii.»</char></note>. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />Yesu mǝ no otukarǝtǝpǝ pǝ ke tini pǝ ke ŋ ri riɔkeeriwǝ. Anyɩŋ wɛɛrɔɔrɔɔrǝ la marǝ alɔ Sɩmɔ Isǝkario le pi Yuda la ziɔŋrǝ kǝ ŋ fǝ Yesu ŋ kpii enyipǝ rǝ akaakǝ. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesu ke cii wǝ ǝkǝnǝŋ ŋwǝ ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ ŋ nǝ pǝ. Wǝ́ ŋ nǝh tǝ mǝ ŋ ko Worokoyǝ lǝ kpǝŋ. Wǝ́ ka lɛ cii wǝ ǝkǝnǝŋ Tǝyǝ fǝ̀ tu ri ŋ tu kpìi ŋwǝ rǝ akaakǝ. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Wǝ́ Yesu ŋ yili rǝ fɛɛriwǝ we, wǝ́ ŋ pɔ̀rʊ na kǝkpakǝ ŋ tǝ̀nǝ. Wǝ́ ŋ fǝ̀ fwatuwǝ ŋ tonu rǝ kǝtɔŋkǝ. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Wǝ́ ŋ cò mɛŋwǝ ŋ kpìi rǝ yawayǝ rɛ. Wǝ́ ŋ yà ŋ ka ŋ wɛɛ no otukarǝtǝpǝ la akparǝyǝ. Wǝ́ ŋ ka ŋ siɛ pǝlǝ yǝ mǝ fwatuwǝ we ŋ ko tonu wǝ. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Wǝ́ ŋ kolu ŋ rò Sɩmɔ Pɛtǝro lǝ kpǝŋ. Wǝ́ Sɩmɔ Pɛtǝro ŋ ke ŋ tíi Yesu ǝkǝnǝŋ: «Ŋlǝ́ Kulǝtǝyǝ a wɛɛ mǝ akparǝyǝ!» <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tuwǝ sa ŋ́ ya ŋ́ née yee we, o lǝŋ koru e ci wǝ rǝkǝsa. Paa e kpii ǝ lǝ́ǝ pǝ o po nuŋ wǝlo duturǝ kǝmaamaa.» <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, a lǝŋ wɛɛ mǝ akparǝyǝ, pwi!» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ ŋ́ naa wɛɛ lá akparǝyǝ we, a lǝŋ pa nya tǝrɛ rǝ mǝ kpǝŋ.» <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />Wǝ́ Sɩmɔ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, we ŋkǝ mǝ akparǝyǝ sɔŋ, paa wɛɛ mǝ wǝkaakpǝ mǝ yurǝ yǝ ŋkpɛ!» <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ we ŋ ne wi we, wǝ lǝǝ pǝ́ kǝ ŋ tǝ ŋ wi. We akparǝyǝ ko wǝ́ ŋ náa wɛɛ wǝ.<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">Wǝŋʊrʊkuukuurɛɛkpǝ wǝ lee kpii fɛɛwǝ sa wǝ la tɛŋ ǝkǝnǝŋ: We akparǝyǝ ko wǝ́ ŋ náa wɛɛ wǝ.</char></note> Duturǝ ɖi yǝ we la wɛlɛŋrǝ kpǝlo kɩɩkɩ lo ru kaka. Ŋnǝ we, nǝ wɛlɛŋrǝ lo ru, paa ŋkǝ nǝ kpǝlo kɩɩkɩ.» <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesu ke cii yǝ we ŋ nǝh fǝ ŋwǝ ŋ kpii enyipǝ rǝ akaakǝ wǝ. Wǝ kǝto ŋ tɛnɩ ǝkǝnǝŋ: «Ŋkǝ nǝ kpǝlo kɩɩkɩ nǝ nyo ru» wǝǝ. <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" />Kǝ́ ŋ na wɛɛ pǝla akparǝyǝ ŋ na lɛ we, wǝ́ Yesu ŋ tǝ ŋ fǝ̀ na kǝkpakǝ ŋ kpìi. Wǝ́ ŋ tǝ ŋ pǝlǝ ŋ tini rǝ fɛɛriwǝ we, wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nyo nuŋ tuwǝ sa ŋ́ ne yee ŋ́ no koonu nǝ lo duturǝ? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Nǝ nyóo pwo mǝ ǝkǝnǝŋ “Tukaŋtǝyǝ” mǝ “Kulǝtǝyǝ”, nǝ nyée yee wǝ ponu. Duturǝ ɖi tuwǝ ŋ́ ri wǝǝ. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Wǝ́ mǝŋ ŋmǝ, nǝ Kulǝtǝyǝ mǝ nǝ Tukaŋtǝyǝ, ŋ́ na wɛɛ nǝ akparǝyǝ we, wǝ kpii kǝ ŋnǝ ŋkpɛ nǝ mǝ wɛɛ awɛ la akparǝyǝ. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Duturǝ ɖi, ŋ́ ne yee wǝ ŋ́ na kaŋ nǝ rǝ. Tuwǝ sa ŋ́ ne yee we, ŋnǝ ŋkpɛ nǝ mǝ yee wǝ. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, sʊmatǝyǝ lǝŋ ru okuruyǝ ŋ teeri no kulǝtǝyǝ. Kaa wǝǝ nyikpiiyǝ lǝŋ ru okuruyǝ ŋ teeri yǝ we ŋ ne kpii ŋwǝ wǝ. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Rǝkǝsa we, nǝ nye ci tuwǝ sa. Mǝŋ nǝ nyǝ fǝ wǝ nǝ nye yee kǝnǝnɛkǝ we, nǝ nyo co yǝ. <verse eid="JHN 13:17" /><verse number="18" style="v" sid="JHN 13:18" />Ŋkǝ nǝ kpǝlo kɩɩkɩ wǝ́ ŋ́ reemǝ. Ŋ́ cii epǝ we ŋ́ na saa ŋ́ na pɔrʊ wǝ. Paa wǝ kpii kǝ tuwǝ we pǝ la ŋʊrʊ rǝ Wǝfwɛɛkenikenikpǝ lǝ mǝrǝ we, wǝ pǝ. Pǝ la ŋʊrʊ ǝkǝnǝŋ: “Ŋlǝ mǝ yǝ we la ya yǝ lée ri mǝ keeriwǝ we, le yi la tɛɛ rǝ mǝ”. <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ŋ́ ya ŋ́ née tíi nǝ wǝ rǝkǝsa kpɛŋ kǝ tuwǝ sa wǝ ci ǝ pǝ pǝ. Mǝŋkǝsa we, vǝ́ wǝ lǝ pǝ wǝ lǝ́ǝ pǝ we, kǝ nǝ nya fɛɛ nǝ lɔ nǝ nuŋ ǝkǝnǝŋ “Ŋmǝ ŋ́ ri ŋmǝ.” <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, yǝ we ŋ na lɔ nyiyǝ we ŋ́ ne kpii we, ŋmǝ wǝ́ ŋ na lɔ. Wǝ́ yǝ we ŋ na lɔ mǝ we, la lɔ yǝ we ŋ ne kpii mǝ wǝ.»<verse eid="JHN 13:20" /></para>
  <para style="s">Yesu la tɛŋ wǝ ǝkǝnǝŋ Yuda ŋ ne siiri ŋwǝ wǝ</para>
  <para style="r">(<ref loc="MAT 26:20-25">Matewu 26:20-25</ref>, <ref loc="MRK 14:17-21">Marǝko 14:17-21</ref>, <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Kǝ́ Yesu ŋ na wɛɛlɩ ǝnǝ ŋ na lɛ we, wǝ́ wǝ kpìi na awɛɛlɩkǝ ŋpa. Wǝ́ ŋ pɔ̀rʊ ŋ tìi pǝ feŋteŋ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, nǝ rɛ lǝh fǝ mǝ ŋ kpii enyipǝ rǝ akaakǝ.» <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />Wǝ́ Yesu lo otukarǝtǝpǝ we pǝ ya pǝ ka ŋ yɩrɩ awɛ, pǝ lee ke ci yǝ ŋ reemǝ. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Otukarǝtǝpǝ we le ceŋceŋ, yǝ we kororo Yesu ŋ ka ŋ taa kǝǝwǝ we, ke tini rǝ Yesu la kǝlɛɛrɩkǝ. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Wǝ́ Sɩmɔ Pɛtǝro ŋ kàa ŋ kanǝ ŋwǝ ǝkǝnǝŋ: «Pǝ́ ŋwǝ ǝkǝnǝŋ ǝlǝ wǝ́ ŋ reemǝ?» <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />Wǝ́ tukarǝtǝyǝ sa ŋ kpɛ̀ɛlɩ ŋ tɛ̀ɛ Yesu rǝ turuwǝ. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ǝlǝ wǝ́ e reemǝ?» <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nah fʊʊ keeriwǝ, kǝ ŋ́ yɔɔ oyupǝ. Yǝ we ŋ́ nǝ́ǝ fǝ wǝ ŋ́ koonu we, ŋwǝ ŋ lǝǝwe.» Wǝ́ Yesu ŋ fʊ̀ʊ keeriwǝ we. Wǝ́ ŋ yɔ̀ɔ oyupǝ. Wǝ́ ŋ fǝ̀ wǝ ŋ kòonu Sɩmɔ le pi Yuda Isǝkario. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Kǝ́ Yuda ŋ na nya ŋ na lɔ wǝ eni we, wǝ́ Satana ŋ kolu ŋ fìi nǝ mǝrǝ. Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tuwǝ we e leh yee we, yee wǝ kalaŋ». <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Epǝ we pǝ ke tini rǝ fɛɛwǝ we la rɛ lee ke ci wǝ kǝto Yesu ŋ tìi no tuwǝ sa wǝ. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Kǝ́ wǝ ke ri ǝkǝnǝŋ Yuda ŋ ke ŋ re sɩkayǝ kǝto we, arɛɛpǝ pǝ ko ŋ pu ǝkǝnǝŋ Yesu le tíi ŋwǝ ŋ ko fuu wǝcɛkpǝ we lo otuyǝ rǝ. Amaa ŋ fǝ tǝrɛ ŋ ko koonu ariariatǝpǝ rǝ. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Kǝ́ Yuda ŋ na lɔ keeriwǝ we la gʊʊrǝ ko, wǝ́ ŋ tɛ̀lɩ ŋ rù kǝtǝrǝceŋceŋ. Oturu kǝ la cɩɩ.<verse eid="JHN 13:30" /></para>
  <para style="s">Yesu lo koonu no otukarǝtǝpǝ le seŋwɛŋyǝ rɛ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Kǝ́ Yuda ŋ no ru we, wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Rǝkǝsa we, Worokoyǝ la pɔrʊ Nyɩmaasɩ le Pi la anaanǝkǝ la kaŋ. Wǝ́ saŋ rǝ ŋwǝ we, pǝ láa nyɩŋ Worokoyǝ la anaanǝkǝ. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Mǝŋ pǝ la nyɩŋ Worokoyǝ la anaanǝkǝ rǝ Nyɩmaasɩ le Pi we,<note caller="+" style="f"><char style="fr" closed="false">13:32 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊrɛɛkpǝ. </char></note> Worokoyǝ ŋwǝ ŋkpɛ, láa pɔrʊ Nyɩmaasɩ le Pi la anaanǝkǝ ŋ kaŋ ŋwǝŋwǝ na wɛ. Wǝ lǝŋ panǝ, láa pɔrʊ kpǝ ŋ kaŋ. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Mǝ epipǝ, ŋ́ tǝ ŋ́ kpii mǝ nǝ koonu enipiyǝ rɛ ko. Nǝ nyah pa taa mǝ. Tuwǝ we ŋ́ ne tíi Oyudatǝpǝ we, ŋ wǝ ke wǝ́ ŋ́ ya ŋ́ née tíi nǝ rǝkǝsa ǝkǝnǝŋ: “Fɛɛwǝ we ŋ́ noh ko we, nǝ nyǝŋ koru wǝ lo oko.” <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Ŋ́ ya ŋ́ née kpii seŋwɛŋyǝ rɛ mǝ ŋ koonu nǝ ǝkǝnǝŋ nǝ taa awɛ lǝ kǝǝwǝ. Mǝŋ kǝ́ ŋ́ na taa nǝ kǝǝwǝ kǝtǝ we, ŋnǝ ŋkpɛ nǝ taa awɛ lǝ kǝǝwǝ ǝnǝ. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Mǝŋ nǝ nyáa taa awɛ lǝ kǝǝwǝ we, enyipǝ pǝ láa nyɩŋ wǝ pǝ ci ǝkǝnǝŋ ŋnǝ nǝ ri mǝ otukarǝtǝpǝ.»<verse eid="JHN 13:35" /></para>
  <para style="s">Yesu la tɛŋ wǝ ǝkǝnǝŋ Pɛtǝro lǝh pǝ sǝ́ŋ ŋwǝ ŋ co</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matewu 26:31-35</ref>, <ref loc="MRK 14:27-31">Marǝko 14:27-31</ref>, <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Wǝ́ Sɩmɔ Pɛtǝro ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, fǝŋ wǝ́ o loh ko?» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Fɛɛwǝ we ŋ́ noh ko we, o lǝŋ koru esiimǝ mǝ rǝkǝsa. Paa ekpii ǝ lǝ́ǝ pǝ e pe siimǝ mǝ kǝmaamaa.» <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />Wǝ́ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Kulǝtǝyǝ kǝ́ kǝto wǝ́ ŋ́ nǝŋ koru esiimǝ lǝ́ rǝkǝsa wǝ? Ŋ́ nóo koru ǝkpǝ́ rǝ ló yurǝ!» <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝ kpǝ́ rǝ mǝ yurǝ! Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, ǝ lǝ́ǝ sǝ́ŋ mǝ pǝrǝŋwǝ kǝta kpɛŋ kǝ kʊkɔyǝ ŋ ci ǝkpǝǝ».<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesu ŋ ri kʊŋwǝ we wǝ lóo ko mǝ nyiyǝ rǝ Tǝyǝ lǝ kpǝŋ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Nǝ pǝǝ kǝǝnǝ. Nǝ lɔ Worokoyǝ nǝ nuŋ, kǝ nǝ lɔ ŋmǝ ŋkpɛ nǝ nuŋ. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Rǝ mǝ Tǝ la nyarǝwǝ we, afɛɛtiiyǝ yǝ naanǝ. Mǝŋ wǝ lǝǝ kǝ lǝ ǝnǝ we, ŋ́ nǝŋ ke tíi nǝ wǝ ǝkǝnǝŋ ŋ́ noh ko ŋ ka kpaka fɛɛtiiwǝ ŋ́ tǝnǝ nǝ. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Vǝ́ ŋ́ no ko ŋ́ na ka kpaka fɛɛwǝ ŋ́ nǝ tǝnǝ nǝ ŋ́ na lɛ we, ŋ́ náa siɛnɩ ŋ́ pǝ, kǝ ŋ́ pǝ fǝ nǝ ŋ́ kʊla mǝ mǝ wɛ. Mǝŋkǝsa we, fɛɛwǝ we ŋ́ neh ke kpii we, kǝ ŋnǝ ŋkpɛ nǝ ke kpii rǝ we. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Wǝ́ nǝ cii fɛɛwǝ we ŋ́ noh ko la gʊŋrǝ.» <verse eid="JHN 14:4" /><verse number="5" style="v" sid="JHN 14:5" />Wǝ́ Toma ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, yǝ lee ce le ci fɛɛwǝ o loh ko wǝ. Yǝ lée yee nɛ kǝ lo koru eci kʊŋwǝ?» <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri gʊŋrǝ, anʊkɔrǝyǝ mǝ vɔrʊrǝ. Rɛ lee kpii ŋ nǝ́ǝ pǝ Tǝyǝ lǝ kpǝŋ, kǝ oturu laa saŋ rǝ mǝ oŋuŋkǝ wǝ. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Mǝŋ nǝ cii mǝ we, nǝ nyée ci mǝ Tǝ ŋwǝ ŋkpɛ.<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Mǝŋ nǝ keh ci mǝ we, nǝ keh ci mǝ Tǝ.»</char></note> Fǝ rǝkǝsa mǝ ko we, nǝ nye ci ŋwǝ wǝ́ nǝ nya nyɩŋ ŋwǝ.» <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />Wǝ́ Filipo ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ kaŋ lǝ Tǝyǝ, eniyǝ we wǝ lo ro lǝ.» <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Filipo, ǝrǝ eniyǝ nɔ wǝ́ ŋ́ kpii mǝ nǝ wǝ́ e lee ci mǝ? Yǝ we ŋ na nyɩŋ mǝ we, la nyɩŋ Tǝyǝ. Nɛ kǝto wǝ́ a láa tɛŋ ǝkǝnǝŋ “Kaŋ lǝ Tǝyǝ” wǝ? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />A laa lɔ o nuŋ ǝkǝnǝŋ ŋmǝ ŋ́ kpii rǝ Tǝyǝ lǝ mǝrǝ, wǝ́ Tǝyǝ ŋ kpii rǝ mǝ mǝrǝ? Etieyǝ sa ŋ́ ya ŋ́ née tíi nǝ we, yǝ loo ru rǝ ŋmǝŋmǝ mǝ kpǝŋ! Paa Tǝyǝ we ŋ kpii rǝ mǝ mǝrǝ we, ŋ ya ŋ née yee na anǝnɛyǝ. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Nǝ lɔ mǝ nǝ nuŋ! Ŋ́ kpii rǝ Tǝyǝ lǝ mǝrǝ, wǝ́ Tǝyǝ ŋ kpii rǝ mǝ mǝrǝ. Wǝ́ mǝŋ nǝ nyaa lɔ mǝ dierǝ sa nǝ nuŋ we, nǝ lɔ nǝ nuŋ ǝkǝŋtǝ rǝ anǝnɛyǝ sa kǝto. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ, yǝ we ŋ na lɔ mǝ ŋ no nuŋ we, ŋwǝ ŋkpɛ lée yee anǝnɛyǝ sa ŋ́ ya ŋ́ née yee wǝ. Lée yee ǝyǝ yǝ naanǝ yǝ teeri kʊraa! Duturǝ ɖi ŋ́ noh ko Tǝyǝ lǝ kpǝŋ. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ rǝ mǝ nyɩŋrǝ we, ŋ́ née yee wǝ. Mǝŋkǝsa we, kǝ wǝ pɔrʊ Tǝyǝ la anaanǝkǝ wǝ kaŋ saŋ rǝ Piyǝ. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Mǝŋ nǝ nyǝ pǝ́ mǝ tǝrɛ rǝ mǝ nyɩŋrǝ we, ŋ́ née yee wǝ.»<verse eid="JHN 14:14" /></para>
  <para style="s">Yesu lo co garǝ lǝ tǝnǝ ǝkǝnǝŋ Tǝyǝ láa maŋ Wɛɛkenikenirǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />«Mǝŋ nǝ nyáa taa mǝ kǝǝwǝ we, nǝ mǝ yee nǝ mǝ saŋ rǝ mǝ esepǝ. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Ŋmǝ we, ŋ́ nah ka tɔɔ ŋ kpɛɛ Tǝyǝ. Láa maŋ nǝ kɔɔlʊtǝpʊŋpwayǝ rɛ ŋ nǝh pe tii ŋ kʊla mǝ nǝ kǝkpakǝkpa. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Ŋwǝ ŋ kaamǝ anʊkɔrǝyǝ la Wɛɛrǝ. Ǝrǝkǝ kǝ lǝŋ po koru alɔ rǝlǝ kǝsǝǝkǝ. Duturǝ ɖi ǝrǝkǝ kǝ lǝŋ koru Wɛɛrǝ sa la anyɩŋ, wǝ́ kǝ laa lɛ kǝ ci rǝ. Paa ŋnǝ we, nǝ cii rǝ, kpiikǝ gbii gʊla mǝ nǝ. Wǝ́ leh pe kpii rǝ nǝ mǝrǝ. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Ŋ́ nǝŋ maa nǝ ŋ́ co, mǝŋ akʊʊpipǝ kǝtǝ. Ŋ́ náa siɛnɩ ŋ́ pǝ nǝ kpǝŋ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Rǝ enipiyǝ rɛ lǝ mǝrǝ we, ǝrǝkǝ kǝ lǝŋ tǝ kǝ pa nyɩŋ mǝ. Ŋnǝ we, nǝ nyah pa nyɩŋ mǝ ŋ́ kpii vɔrʊrǝ, kǝ ŋnǝ ŋkpɛ nǝ tii vɔrʊrǝ. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Jirǝ we we, nǝ nyée ci wǝ ǝkǝnǝŋ ŋmǝ ŋ́ kpii rǝ mǝ Tǝ lǝ mǝrǝ. Wǝ́ ŋnǝ we, nǝ kpii rǝ mǝ mǝrǝ, wǝ́ ŋmǝ ŋkpɛ ŋ́ kpii rǝ nǝ mǝrǝ. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Yǝ we ŋ na lɔ mǝ esepǝ ŋ re kpoŋkpoŋ wǝ́ ŋ née yee mǝ ŋ saŋ rǝ pǝ we, ŋwǝ ŋ náa taa mǝ kǝǝwǝ wǝ. Wǝ́ yǝ we ŋ náa taa mǝ kǝǝwǝ we, mǝ Tǝ láa taa nǝ kǝǝwǝ. Ŋmǝ ŋkpɛ we, ŋ́ nah mǝ taa nǝ kǝǝwǝ, kǝ mǝ ŋ pɔrʊ mǝ wɛ mǝ ŋ kaŋ ŋwǝ.» <verse eid="JHN 14:21" /><verse number="22" style="v" sid="JHN 14:22" />Wǝ́ Yuda, ŋkǝ Yuda Isǝkario, ŋ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, wǝ lée yee nɛ wǝ́ a lah mǝ pɔrʊ lá wɛ a mǝ kaŋ lǝ, paa a lǝŋ pɔrʊ lá wɛ a kaŋ ǝrǝkǝ wǝ?» <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ rɛ láa taa mǝ kǝǝwǝ we, leh mǝ yee mǝ ŋ saŋ rǝ mǝ etieyǝ, kǝ mǝ Tǝ mǝ ŋ taa nǝ kǝǝwǝ. Ŋlǝ mǝ mǝ Tǝ yǝ loh mǝ ko nǝ kpǝŋ, kǝ lǝ tǝnǝ leh kǝtiikǝ rǝ nǝ kpǝŋ. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Yǝ we ŋ nǝŋ taa mǝ kǝǝwǝ we, lǝŋ yee ŋ saŋ rǝ mǝ etieyǝ. Wǝ́ ŋrǝ dierǝ sa nǝ ya nǝ nyóo nuŋ we, lee ri mǝ nɛŋ. Paa mǝ Tǝyǝ we ŋ ne kpii mǝ ŋ na maŋ la nɛŋ. <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />Ŋ́ ne tíi nǝ etieyǝ sa rǝ eniyǝ sa ŋ́ tǝ ŋ́ kpii ŋ kʊla mǝ nǝ wǝ. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Paa we, Kɔɔlʊtǝyǝ we ŋ ɖi Wɛɛkenikenirǝ we mǝ Tǝ ŋ nǝh pǝ fǝ ŋ maŋ nǝ rǝ mǝ nyɩŋrǝ we, lah pa kaŋ nǝ tu ri ŋ tu. Otuyǝ we kpǝlo kɩɩkɩ ŋ́ ne tíi nǝ we, lah pa taalǝ nǝ yǝ. <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />Ŋ́ na maa wǝtaarǝkpǝ ŋ́ nǝ tǝnǝ nǝ. Ŋ́ nǝ fǝ mǝ wǝtaarǝkpǝ ŋ́ no koonu nǝ. Ŋ́ noo koonu nǝ kpǝ, mǝŋ kǝ́ ǝrǝkǝ kǝ lóo koonu wǝtaarǝkpǝ kǝtǝ. Turuwǝ wǝ pǝǝ tǝ wǝ nyaa nǝ mɛŋ, nǝ poo suu vurǝ. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Nǝ nyo nuŋ kǝ́ ŋ́ ne tíi nǝ wǝ ŋ́ na pa tɛlɩ ǝkǝnǝŋ: “Ŋ́ noh ko, paa ŋ́ nǝ́ǝ tǝ ŋ́ siɛnɩ ŋ́ pǝ nǝ kpǝŋ.” Mǝŋ nǝ nyáa taa mǝ kǝǝwǝ we, nǝ kah mǝ nya faawǝ rǝ mǝ kǝ́ nǝ nyo nuŋ ǝkǝnǝŋ ŋmǝ ŋ́ noh ko Tǝyǝ lǝ kpǝŋ wǝ. Duturǝ ɖi Tǝyǝ naanǝ teeri mǝ. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Ŋ́ ne tíi nǝ tuwǝ sa rǝkǝsa kpɛŋ kǝ wǝ ci ǝ pǝ pǝ. Mǝŋkǝsa vǝ́ wǝ lǝ pǝ wǝ lǝ́ǝ pǝ we, kǝ nǝ nya fɛɛ nǝ lɔ nǝ nuŋ. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ŋ́ nǝŋ tǝ ŋ́ pa tɛɛrɩ mǝ nǝ kpaa, duturǝ ɖi yǝ we ŋ na lɔ ǝrǝkǝ sa ŋ na kaa we, lo furu. Kǝceece, lǝǝ lǝmǝ okopiyǝ rɛ rǝ mǝ oŋuŋkǝ. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Paa wǝ kpii kǝ ǝrǝkǝ kǝ ci wǝ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa Tǝyǝ lǝ kǝǝwǝ. Wǝ́ ŋmǝ ŋ́ née yee tu ri ŋ tu mǝŋ kǝ́ Tǝyǝ ŋ ne tíi mǝ kǝtǝ. Nǝ yi kǝ la pwɛyɩ rǝ fɛɛwǝ sa!»<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesu ŋ ri rɛzɛŋkuŋpoŋpirǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />«Ŋmǝ ŋ́ ri rɛzɛŋkuŋpoŋpirǝ, wǝ́ mǝ Tǝ ŋ ri arɛzɛŋtɛɛkǝ sa lǝ tǝyǝ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Laŋwǝ le wǝ we wǝ lo ru rǝ mǝ, wǝ́ wǝ lǝŋ nyɩŋ ǝtǝnǝyǝ we, lǝ́ǝ sǝ wǝ mǝ ŋ co. Paa laŋwǝ we wǝ láa nyɩŋ ǝtǝnǝyǝ we, lóo toolu wǝ kǝ wǝ nya fɛɛ wǝ tǝ wǝ nyɩŋ ǝtǝnǝyǝ ŋpa. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Etieyǝ sa ŋ́ ne tíi nǝ we, yǝ la marǝ yǝ la lɛrɩ nǝ kaka. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Nǝ kpii rǝ mǝ mǝrǝ mǝŋ kǝ́ ŋ́ kpii rǝ nǝ mǝrǝ kǝtǝ. Mǝŋ rɛzɛŋlaŋwǝ rɛ wǝ laa tɔ rǝ wǝlo guŋrǝ we, wǝ lǝŋ koru anyɩŋ ǝtǝnǝyǝ ŋ wǝ ceŋceŋ. Kaa wǝǝ, vǝ́ nǝ nyaa tɔ rǝ mǝ we, nǝ nyǝŋ koru anyɩŋ ǝtǝnǝyǝ. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />Ŋmǝ ŋ́ ri rɛzɛŋkuŋrǝ we, wǝ́ ŋnǝ nǝ ri alaŋyǝ. Yǝ we ŋ kpii rǝ mǝ mǝrǝ, wǝ́ ŋ́ kpii rǝ yǝ we lǝ mǝrǝ we, yǝ we láa nyɩŋ ǝtǝnǝyǝ ŋpa. Duturǝ ɖi mǝŋ ŋ́ naa kʊla mǝ nǝ we, nǝ nyǝŋ koru tǝrɛ le eyee. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Mǝŋ rɛ lee kpii rǝ mǝ mǝrǝ we, pǝ láa pɔrʊ ŋwǝ pǝ ŋ co rǝ koruwǝ mǝŋ kǝ́ pǝ lǝ́ǝ sǝ arɛzɛŋlaŋyǝ pǝ ŋ co kǝtǝ. Yǝ ŋ kpaa. Oturu pǝ la wʊʊ yǝ, pǝ ŋ tie yǝ pǝ kpii rǝ naawǝ, yǝ ŋ yee naa. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Mǝŋ nǝ kpii rǝ mǝ mǝrǝ, wǝ́ mǝ etieyǝ yǝ kpii rǝ nǝ mǝrǝ we, nǝ pǝ́ tuwǝ nǝ nyǝ́ǝ pǝ́ wǝ, wǝ lǝ́ǝ pǝ wǝ koonu nǝ. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Mǝŋ nǝ nya nyɩŋ ǝtǝnǝyǝ ŋpa, wǝ́ nǝ nya pɔrʊ nǝ nya kaŋ ǝkǝnǝŋ ŋnǝ nǝ ri mǝ otukarǝtǝpǝ we, eniyǝ we we, enyipǝ kpǝlo kɩɩkɩ pǝ láa nyɩŋ wǝ pǝ ci ǝkǝnǝŋ mǝ Tǝ naanǝ. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Ŋ́ náa taa nǝ kǝǝwǝ mǝŋ kǝ́ mǝ Tǝ ŋ náa taa mǝ kǝǝwǝ kǝtǝ. Nǝ tii rǝ mǝ kǝǝtaawǝ lǝ mǝrǝ. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Mǝŋ nǝ nye yee nǝ nya saŋ rǝ mǝ tutɛŋwǝ we, nǝ nyée kpii rǝ mǝ kǝǝtaawǝ lǝ mǝrǝ, mǝŋ kǝ́ ŋmǝ ŋkpɛ ŋ́ ne yee ŋ́ na saŋ rǝ mǝ Tǝ lo tutɛŋwǝ, wǝ́ ŋ́ kpii rǝ nǝ kǝǝtaawǝ lǝ mǝrǝ kǝtǝ.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Ŋ́ ya ŋ́ náa tɛŋ wǝ ǝnǝ kǝ mǝ faawǝ wǝ nya fɛɛ wǝ kpii rǝ nǝ mǝrǝ kǝ nǝ faawǝ wǝ nya fɛɛ wǝ to milimili. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Mǝ seyǝ ŋ kaamǝ yǝ ǝnǝ: “Nǝ taa awɛ lǝ kǝǝwǝ mǝŋ kǝ́ ŋ́ náa taa nǝ kǝǝwǝ kǝtǝ”. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Kǝǝtaawǝ lo mumuŋmumuŋwǝ we nyɩmaasɩyǝ ŋ nóo koru ǝfǝ koonu nǝ ǝtǝŋpǝ wǝ kaamǝ ǝkǝnǝŋ ŋ kpǝ́ ŋ tɛɛ rǝ pǝlo yurǝ. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Mǝŋ nǝ nye yee nǝ nya saŋ rǝ tuwǝ we ŋ́ ne tíi nǝ we, eniyǝ we ŋnǝ nǝ ri mǝ ǝtǝŋpǝ wǝ. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ŋ́ nǝŋ tǝ ŋ́ pwo nǝ ǝkǝnǝŋ mǝ asʊmatǝpǝ. Duturǝ ɖi sʊmatǝyǝ lee ci tuwǝ we no kulǝtǝyǝ ŋ ya ŋ née yee wǝ. Paa ŋ́ nóo pwo nǝ mǝ ǝtǝŋpǝ duturǝ ɖi tu ri ŋ tu ŋ́ no nuŋ rǝ mǝ Tǝ lǝ kpǝŋ we, ŋ́ no koonu wǝ́ nǝ nye ci yǝlo kpǝlo. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ŋkǝ ŋnǝ nǝ nya saa mǝ nǝ nya pɔrʊ, ŋmǝ ŋ́ na saa nǝ ŋ́ na pɔrʊ wǝ. Wǝ́ ŋ́ ne kpii nǝ ŋ́ na maŋ kǝ nǝ ka nyɩŋ ǝtǝnǝyǝ, eyǝ we yǝ láa panǝ wǝ, kǝ Tǝyǝ ŋ nya fɛɛ ŋ koonu nǝ tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ ŋwǝ rǝ mǝ nyɩŋrǝ wǝ. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Tuwǝ we ŋ́ ya ŋ née tíi nǝ wǝ kaamǝ ǝkǝnǝŋ nǝ taa awɛ lǝ kǝǝwǝ.<verse eid="JHN 15:17" /></para>
  <para style="s">Ǝrǝkǝ lǝ kǝǝkpǝlǝwǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Mǝŋ ǝrǝkǝ kǝ lǝ kpǝlǝ nǝ kǝǝwǝ we, nǝ ci wǝ ǝkǝnǝŋ kǝ lǝ kpǝlǝ mǝ kǝǝwǝ kǝ lo coonu. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Mǝŋ nǝ keh ri ǝrǝkǝ le enyipǝ we, ǝrǝkǝ kǝ kah mǝ taa nǝ kǝǝwǝ duturǝ ɖi nǝ marǝ nǝ ri kǝla anɛŋ. Paape ŋ́ na saa nǝ ŋ́ na pɔrʊ, wǝ́ ŋ́ nǝ fǝ nǝ ŋ́ no ru rǝ ǝrǝkǝ lǝ mǝrǝ. Kǝto nǝ nyǝǝ tǝ nǝ ri ǝrǝkǝ la anɛŋpǝ. Wǝ kǝto kǝ ya kǝ lǝ́ǝ kpǝlǝ nǝ kǝǝwǝ wǝǝ. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Nǝ taalǝ dierǝ we ŋ́ ne tíi nǝ ǝkǝnǝŋ: “Sʊmatǝyǝ lǝŋ koru e teeri no kulǝtǝyǝ.” Mǝŋ enyipǝ pǝ le yi pǝ la tɛɛ rǝ mǝ we, ŋnǝ ŋkpɛ pǝ lée yi pǝ tɛɛ rǝ nǝ. Mǝŋ pǝ lo co kǝtukoŋkǝ rǝ mǝ otukaŋyǝ we, ŋnǝ ŋkpɛ pǝ lóo co kǝtukoŋkǝ rǝ nǝ anɛŋyǝ. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ŋmǝ kǝto pǝ lée yee mǝ nǝ ŋyǝ otuyǝ sa, duturǝ ɖi pǝ lee ci yǝ we ŋ ne kpii mǝ wǝ. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />O koh nuŋ ŋ́ nǝǝ pǝ kǝ ŋ́ pa wɛɛlɩ ŋ tíi pǝ we, pǝ lǝŋ kǝ lǝmǝ turɔɔrɔɔwǝ. Rǝkǝsa we, pǝ lǝŋ koru ǝsǝrǝ kafǝrawǝ rǝ pǝlo oturɔɔrɔɔyǝ. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Yǝ we ŋ nǝ kpǝlǝ mǝ kǝǝwǝ we, lǝ kpǝlǝ mǝ Tǝ ŋwǝ ŋkpɛ lǝ kǝǝwǝ. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />O koh nuŋ ŋ́ nee yee anǝnɛyǝ we rɛ ŋ fee yee ŋ nyɩŋ rǝ pǝlǝ mǝrǝ we, pǝ lǝŋ kǝ lǝmǝ oturɔɔrɔɔyǝ. Rǝkǝsa pǝ la nyɩŋ yǝ pǝ la lɛ paa, wǝ́ pǝ tǝ pǝ ya pǝ lǝ́ǝ kpǝlǝ ŋlǝ mǝ mǝ Tǝ lǝ kǝǝwǝ. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Paape otuyǝ sa yǝ lǝ pǝ ǝnǝ kǝ yǝ nya fɛɛ yǝ tɛɛ durǝ rǝ etieyǝ we pǝ la ŋʊrʊ rǝ pǝle seyǝ lǝ mǝrǝ ǝkǝnǝŋ: “Pǝ lǝ kpǝlǝ mǝ kǝǝwǝ tuŋtuŋ”.<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Ŋ́ née kpii Kɔɔlʊtǝyǝ ŋ́ maŋ nǝ, lóo ru rǝ mǝ Tǝ lǝ kpǝŋ. Anʊkɔrǝyǝ la Wɛɛrǝ we lo ru rǝ Tǝyǝ lǝ kpǝŋ lǝǝwe. Ŋwǝ Kɔɔlʊtǝyǝ sa ŋ neh pe ri ɖaŋsieyǝ ŋ koonu mǝ wǝ. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Ŋnǝ ŋkpɛ nǝ nyée ri ɖaŋsieyǝ nǝ koonu mǝ duturǝ ɖi ǝrǝ kǝtiekǝ wǝ́ nǝ siimǝ mǝ.»<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />«Ŋ́ ne tíi nǝ tuwǝ sa kǝ nǝ paa pa nya fɛɛ nǝ nyarǝ lɔnuŋrǝ nǝ co. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Pǝ leh pe piri nǝ rǝ okumwɛŋnyuŋyǝ. Wǝ́ eniyǝ kʊraa yǝ kpii yǝ lǝ́ǝ pǝ, kǝ oturu epǝ we pǝ láa wʊ nǝ we, pǝ lah mǝ nyɩŋ rǝ ǝkǝnǝŋ ŋpǝ pǝ ya pǝ láa sʊma Worokoyǝ rǝ! <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Pǝ leh mǝ yee wǝ ǝnǝ duturǝ ɖi pǝ lee ci Tǝyǝ, wǝ́ pǝ lee ci mǝ. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Paa ŋ́ ne tíi nǝ wǝ, mǝŋkǝsa vǝ́ pǝle eniyǝ we yǝ lo po ro we, kǝ nǝ nya fɛɛ nǝ mǝ taalǝ ǝkǝnǝŋ ŋmǝ ŋ tìi nǝ wǝ. Ŋ́ naa maa ŋ́ tíi nǝ tuwǝ sa rǝ kǝsǝŋkǝ. Duturǝ ɖi ŋ́ ke kpii ŋ́ kʊ̀la mǝ nǝ kǝto.»<verse eid="JHN 16:4" /></para>
  <para style="s">Wɛɛkenikenirǝ la kǝnǝnɛkǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />«Rǝkǝsa we, ŋ́ noh ko yǝ we ŋ ne kpii mǝ ŋ na maŋ lǝ kpǝŋ. Wǝ́ rɛ lee kpii rǝ nǝ mǝrǝ ŋ nǝ́ǝ pǝ́ mǝ ǝkǝnǝŋ: “Fǝŋ wǝ́ o loh ko?” <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Paa kǝ́ ŋ́ ne tíi nǝ wǝ kǝto, wǝ́ nǝ nye fii gʊʊpirǝ. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Paape anʊkɔrǝyǝ wǝ́ ŋ́ ne tíi nǝ. Mǝŋ ŋ́ na tɛlɩ we, wǝ lóo poŋ wǝ koonu nǝ wǝ teeri. Duturǝ ɖi mǝŋ ŋ́ naa pwɛyɩ we, Kɔɔlʊtǝyǝ we lǝŋ pǝ pǝ nǝ kpǝŋ. Paa vǝ́ ŋ́ na pwɛyɩ we, ŋ́ nǝh kǝ fǝ ŋwǝ ŋ́ maŋ nǝ. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Vǝ́ lǝ pǝ we, lah pa pɔrʊ ŋ kaŋ ǝrǝkǝ le enyipǝ ǝkǝnǝŋ pǝ lǝ tǝǝlǝ ko rǝ tuwǝ turɔɔrɔɔwǝ wǝ ri. Pǝ lǝ tǝǝlǝ ko rǝ tuwǝ akʊʊkǝ kǝ ri wǝ, wǝ́ pǝ la lɛ pǝ lǝ tǝǝlǝ ko rǝ tuwǝ Worokoyǝ la wǝkpaŋtɛŋkpǝ wǝ ri wǝ. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Rǝ turɔɔrɔɔwǝ la gaarǝ we, kǝ́ pǝ laa lɔ mǝ pǝ nuŋ kǝto. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Rǝ akʊʊkǝ la gaarǝ we, kǝ́ ŋ́ noh ko Tǝyǝ lǝ kpǝŋ, wǝ́ nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ kǝto. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Rǝ Worokoyǝ la wǝkpaŋtɛŋkpǝ la gaarǝ we, kǝ́ Worokoyǝ ŋ na tɔɔ yǝ we ŋ na lɔ ǝrǝkǝ sa ŋ na kaa la bɔrǝ kaka kǝto. <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />Ŋ́ tǝ ŋ́ lǝǝmǝ otuyǝ kǝkpǝŋkǝ ŋ́ née tíi nǝ. Paape nǝ nyǝŋ po koru yǝ lo onuŋ re rǝkǝsa. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Vǝ́ anʊkɔrǝyǝ la Wɛɛrǝ we lǝ pǝ we, leh pe re nǝ rǝ anʊkɔrǝyǝ kpǝlo kɩɩkɩ lǝ mǝrǝ. Lǝŋ pa wɛɛlɩ rǝ ŋrǝŋrǝ lo okopiyǝ. Paa lah mǝ tɛŋ tu ri ŋ tu lo nuŋ lǝ ŋ tíi nǝ. Lah mǝ tɛŋ tuwǝ we wǝ lǝh pǝ pǝ lǝ ŋ tíi nǝ. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Láa pɔrʊ mǝ anaanǝkǝ gaŋ. Duturǝ ɖi tuwǝ we lah mǝ tɛŋ lǝ ŋ tíi nǝ we, láa lɔ wǝ ɖu rǝ mǝ kpǝŋ. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Otuyǝ we kpǝlo kɩɩkɩ mǝ Tǝ ŋ lǝǝmǝ we, yǝ ri mǝ anɛŋ. Fɛɛwǝ ŋ́ na tɛŋ ǝkǝnǝŋ tuwǝ we láa lɔ ɖu rǝ mǝ kpǝŋ wǝ́ lah mǝ tɛŋ lǝ ŋ tíi nǝ wǝ.»<verse eid="JHN 16:15" /></para>
  <para style="s">Otukarǝtǝpǝ la gʊʊpifiirǝ la siɛrɩ le yee faawǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />«Rǝ enipiyǝ rɛ lǝ mǝrǝ we nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ. Wǝ́ rǝ enipiyǝ rɛ la kǝmaakǝ we, nǝ nyǝ́ǝ tǝ nǝ nyɩŋ mǝ.» <verse eid="JHN 16:16" /><verse number="17" style="v" sid="JHN 16:17" />Wǝ́ no otukarǝtǝpǝ we la arɛɛpǝ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Tuwǝ sa ŋ na tɛŋ ŋ ne tíi lǝ lo duturǝ ɖi nɛ? Ǝkǝnǝŋ: “Rǝ enipiyǝ rɛ lǝ mǝrǝ we, nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ. Wǝ́ rǝ enipiyǝ rɛ la kǝmaakǝ we, nǝ nyǝ́ǝ tǝ nǝ nyɩŋ mǝ”. Lǝ tǝ la tɛŋ ǝkǝnǝŋ: “Ŋ́ noh ko Tǝyǝ lǝ kpǝŋ”». <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Wǝ́ otukarǝtǝpǝ we pǝ tǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Tuwǝ sa ŋ na tɛŋ ǝkǝnǝŋ “Rǝ enipiyǝ rɛ” wǝǝ, lo duturǝ ɖi nɛ? Yǝ loo nuŋ tuwǝ sa ŋ na tɛŋ lo duturǝ!» <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />Yesu ke cii wǝ ǝkǝnǝŋ pǝ lǝǝmǝ dierǝ rɛ pǝ lǝh pǝ́ ŋwǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ya nǝ nyǝ́ǝ pǝ́ awɛ le etieyǝ nǝ nyǝ ŋ ru rǝ tuwǝ sa ŋ́ na tɛŋ lo duturǝ ǝkǝnǝŋ: “Rǝ enipiyǝ rɛ lǝ mǝrǝ we, nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ. Wǝ́ rǝ enipiyǝ rɛ la kǝmaakǝ we, nǝ nyǝ́ǝ tǝ nǝ nyɩŋ mǝ”. <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, nǝ nyée we, kǝ nǝ mǝ nʊmʊ. Paa ǝrǝkǝ le enyipǝ pǝ láa nya faawǝ. Nǝ nyée fii gʊʊpirǝ, paape nǝ gʊʊpifiirǝ sa lah pa siɛrɩ yee faawǝ. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Vǝ́ tieyǝ lǝh mǝ we, oturu le fii kǝǝnǝwǝ. Duturǝ ɖi na acʊcʊʊrʊyǝ le eniyǝ yǝ lo ro. Paa vǝ́ lǝ mǝ piyǝ we la lɛ we, ŋ yuu na acʊcʊʊrʊyǝ la kpɛɛ. Oturu la nya faawǝ, duturǝ ɖi lǝ mǝ piyǝ lǝ tǝnǝ rǝ ǝrǝkǝ. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Kaa wǝǝ, ŋnǝ ŋkpɛ nǝ kpii rǝ kǝǝnǝwǝ rǝkǝsa. Paa ŋ́ kpii ŋ́ nǝ́ǝ pǝ ŋ́ pǝ tǝ ŋ́ nyɩŋ nǝ. Eniyǝ we nǝ ziɔŋrǝ la nya faawǝ. Nǝ faawǝ sa we, rɛ lǝŋ po koru alɔ wǝ rǝ nǝ. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Jirǝ we we, nǝ nyǝŋ tǝ nǝ pǝ pǝ́ mǝ dierǝ rɛ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ Tǝyǝ rǝ mǝ nyɩŋrǝ we, lóo koonu nǝ wǝ. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Po ro eniyǝ sa nǝ fǝǝ pǝ́ tǝrɛ rǝ mǝ nyɩŋrǝ. Nǝ pǝ́ kǝ nǝ nya fɛɛ nǝ lɔ, kǝ nǝ faawǝ wǝ to milimili.»<verse eid="JHN 16:24" /></para>
  <para style="s">Yesu le ri ǝrǝkǝ lo yurǝ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />«Ŋ́ ne tíi nǝ otuyǝ sa kpǝlo kɩɩkɩ saŋ rǝ otutucayǝ. Paa eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ, ŋ́ nǝŋ tǝ ŋ́ ya mǝ ŋ wɛɛlɩ mǝ nǝ mǝŋ kɔɔwe. Ŋ́ náa mǝ wɛɛlɩ mǝ ŋ ru rǝ Tǝyǝ mǝ ŋ tíi nǝ feŋteŋ. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Jirǝ we we, nǝ nyǝ́ǝ mǝ pǝ́ tuwǝ rǝ mǝ nyɩŋrǝ. Paa ŋ́ nee tíi nǝ ǝkǝnǝŋ ŋ́ nǝ́ǝ pǝ́ tǝrɛ rǝ Tǝyǝ ŋ́ koonu nǝ o. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Duturǝ ɖi Tǝyǝ ŋwǝŋwǝ láa taa nǝ kǝǝwǝ, kpiikǝ nǝ nyáa taa mǝ kǝǝwǝ kǝto. Wǝ́ nǝ nya lɔ nǝ nyo nuŋ ǝkǝnǝŋ ŋ́ no ru rǝ Worokoyǝ lǝ kpǝŋ ŋ́ nǝ pǝ. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Tǝyǝ lǝ kpǝŋ wǝ́ ŋ́ no ru ŋ́ nǝ pǝ ǝrǝkǝ. Rǝkǝsa ŋ́ nah pwɛyɩ rǝ ǝrǝkǝ kǝ ŋ́ kpǝlǝŋ mǝ ŋ ko Tǝyǝ lǝ kpǝŋ.» <verse eid="JHN 16:28" /><verse number="29" style="v" sid="JHN 16:29" />Wǝ́ no otukarǝtǝpǝ pǝ tìi ŋwǝ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, rǝkǝsa a ya láa wɛɛlɩ feŋteŋ e mǝ ŋ tíi lǝ. Ǝ lǝǝ tǝ a ya láa ca lǝ otutuyǝ. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Rǝkǝsa yǝ le ci wǝ ǝkǝnǝŋ e cii tu ri ŋ tu. Wǝ́ wǝ lǝǝ tǝ wǝ kaamǝ kǝ rɛ ŋ pǝ́ lé dierǝ rɛ. Wǝ kǝto yǝ la lɔ yǝ lo nuŋ ǝkǝnǝŋ o lo ru rǝ Worokoyǝ lǝ kpǝŋ ǝ lǝ pǝ wǝǝ.» <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Rǝkǝsa nǝ nya lɔ nǝ nyo nuŋ kǝceece? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Nǝ nya nyɩŋ! Eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ. Wǝ́ yǝ la marǝ yǝ lo ro. Pǝ lah pa caŋ nǝ, eniyǝ we yǝ ŋ ri yǝ la tɛlɩ mǝ na cawǝ, kǝ nǝ maa mǝ, ŋmǝ ceŋceŋ. Paa ŋkǝ ŋmǝ ceŋceŋ ŋ́ kpii, Tǝyǝ kpii kʊla mǝ mǝ. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Ŋ́ ne tíi nǝ otuyǝ sa kǝ nǝ nya fɛɛ nǝ nya wǝtaarǝkpǝ saŋ rǝ mǝ. Nǝ nyáa cʊʊrʊ rǝ ǝrǝkǝ sa mǝrǝ. Paape nǝ ta nǝ wɛ! Ŋ́ ne ri ǝrǝkǝ lo yurǝ!»<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yesu la mwɛŋ nyuŋkpǝ lo koonu no otukarǝtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Kǝ́ Yesu ŋ na wɛɛlɩ ǝnǝ ŋ na lɛ we, wǝ́ ŋ yìili ŋ ka ŋ yɩrɩ yulaarǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ Tǝ, eniyǝ yǝ lo ro. Rɛɛrɩ mǝ lé Piyǝ, kǝ lé Piyǝ ŋ nya fɛɛ ŋ rɛɛrɩ mǝ lǝ́. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />O lo koonu no okopiyǝ rǝ enyipǝ kpǝlo kɩɩkɩ lo oŋuŋkǝ. Kǝto epǝ we kpǝlo kɩɩkɩ ǝ lǝ fǝ o lo koonu ŋwǝ we, lóo koonu pǝ la vɔrʊlaalɛɛrǝ. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Wǝ́ vɔrʊlaalɛɛrǝ we gaamǝ ǝkǝnǝŋ enyipǝ pǝ ci lǝ́, ŋlǝ́ yǝ we ceŋceŋ e ri Worokopoŋpiyǝ, mǝ Yesu Kǝriso, yǝ we e le kpii a la maŋ wǝ. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ŋ́ na pɔrʊ lá anaanǝkǝ ŋ́ na kaŋ rǝ kǝtǝǝwǝ sa. Ŋ́ na lɛ kǝnǝnɛkǝ we o lo koonu mǝ ŋ́ yee wǝ. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Kǝto rǝkǝsa we, mǝ Tǝ, rǝ lé enimiyǝ we, tǝ ǝ fǝ okuruyǝ we ŋ́ kǝ lǝǝmǝ rǝ lǝ́ kpǝŋ kpɛŋ kǝ o po co ǝrǝkǝ we, o koonu mǝ. <verse eid="JHN 17:5" /><verse number="6" style="v" sid="JHN 17:6" />A la saa enyipǝ a la pɔrʊ rǝ ǝrǝkǝ. Wǝ́ ǝ lǝ fǝ pǝ o lo koonu mǝ. Ŋ́ na pɔrʊ lǝ́ ŋ́ na kaŋ pǝ. Pǝ ke ri lá anɛŋ, wǝ́ ǝ lǝ fǝ pǝ o lo koonu mǝ. Wǝ́ pǝ le yee pǝ la saŋ rǝ lé dierǝ. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Rǝkǝsa we, pǝ cii wǝ ǝkǝnǝŋ tu ri ŋ tu ŋlǝ́ o lo koonu mǝ we, wǝ lo ru rǝ lǝ́ kpǝŋ. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Duturǝ ɖi etieyǝ we ŋ́ nǝ fǝ ŋ́ no po koonu pǝ we, yǝ kaamǝ eyǝ we o lo koonu mǝ wǝ. Wǝ́ pǝ la lɔ yǝ. Pǝ le ci wǝ kǝceece ǝkǝnǝŋ ŋmǝ ŋ́ no ru rǝ lǝ kpǝŋ ŋ́ nǝ pǝ. Wǝ́ pǝ la lɔ pǝ lo nuŋ ǝkǝnǝŋ ŋlǝ́ e le kpii mǝ a la maŋ.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu pǝ. Ŋ́ naa ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu ǝrǝkǝ! Paa ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu epǝ we ǝ lǝ fǝ e le kpii mǝ rǝ akaakǝ wǝ. Duturǝ ɖi pǝ ri lá anɛŋ. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Tu ri ŋ tu wǝ ri mǝ nɛŋ we, wǝ ri lá nɛŋ, mǝŋ kǝ́ tu ri ŋ tu wǝ ri lá nɛŋ we, wǝ ri mǝ nɛŋ wǝ. Wǝ́ ŋ́ na pɔrʊ mǝ anaanǝkǝ ŋ́ na kaŋ saŋ rǝ pǝ. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Rǝkǝsa we, ŋ́ nǝǝ tǝ ŋ́ kpii rǝ ǝrǝkǝ. Ŋpǝ paa we, pǝ kpii rǝ ǝrǝkǝ mǝrǝ. Ŋmǝ we, ŋ́ no furu lǝ́ kpǝŋ. Tǝkenikeniyǝ, re pǝ rǝ lá nyɩŋrǝ lo okopiyǝ, nyɩŋrǝ we e kpìi mǝ wǝ. Mǝŋkǝsa we, kǝ pǝ nya fɛɛ pǝ yee nyiceŋceŋ mǝŋ kǝ́ ŋlǝ mǝ lǝ́ lǝ lǝ nyiceŋceŋ kǝtǝ. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Kǝ́ ŋ́ ke kpii ŋlǝ mǝ pǝ we, ŋ́ ke ŋ re pǝ rǝ lá nyɩŋrǝ lo okopiyǝ, ɖǝ we e kpìi mǝ wǝ. Ŋ́ nǝ kǝrǝŋ pǝ, wǝ́ rɛ lǝǝ lǝǝ rǝ pǝlǝ mǝrǝ. We yǝ we wǝ kpii wǝ koonu kǝ ŋ lǝǝ taa ceŋceŋ, kǝ tuwǝ we Wǝŋʊrʊkpǝ wǝ la tɛŋ we, wǝ nya fɛɛ wǝ pǝ. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Rǝkǝsa we, ŋ́ no furu lǝ́ kpǝŋ. Paa ŋ́ ya ŋ́ náa tɛŋ otuyǝ sa rǝ ǝrǝkǝ mǝrǝ, kǝ pǝ nya fɛɛ pǝ nya mǝ faawǝ we rǝ pǝlǝ mǝrǝ. Faawǝ we wǝ lo to milimili wǝ. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ŋmǝ we, ŋ́ na tɛŋ lé dierǝ we ŋ́ ne tíi pǝ. Wǝ́ ǝrǝkǝ kǝ lǝ kpǝlǝ pǝlǝ kǝǝwǝ. Duturǝ ɖi pǝ lee ri ǝrǝkǝ le enyipǝ, mǝŋ kǝ́ ŋ́ nee ri ǝrǝkǝ le nyiyǝ kǝtǝ. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ŋ́ naa ya ŋ́ nǝ́ǝ pǝ́ lǝ́ a pɔrʊ pǝ a cɛ rǝ ǝrǝkǝ mǝrǝ. Paa ŋ́ nǝ pǝ́ ǝ kǝrǝŋ pǝ rǝ Nyirɔɔrɔɔyǝ la kǝnyɩŋkǝ. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Pǝ lee ri ǝrǝkǝ le enyipǝ mǝŋ kǝ́ ŋ́ nee ri ǝrǝkǝ le nyiyǝ kǝtǝ. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Kaŋ pǝ la anʊkɔrǝyǝ kǝ pǝ nya fɛɛ pǝ ri lé enyipǝ fee. Lé dierǝ ɖi anʊkɔrǝyǝ. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Ŋ́ ne kpii pǝ ŋ́ na maŋ rǝ ǝrǝkǝ mǝŋ kǝ́ e le kpii mǝ a la maŋ rǝ ǝrǝkǝ kǝtǝ. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ŋmǝŋmǝ ŋ́ nǝ fǝ mǝ wɛ ŋ́ no koonu lǝ́ fee rǝ pǝlo yurǝ, kǝ ŋpǝ ŋkpɛ pǝ nya fɛɛ pǝ fǝ pǝla wɛ pǝ koonu lǝ́ mǝ anʊkɔrǝyǝ.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />Ŋ́ naa ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu mǝ otukarǝtǝpǝ ceŋceŋ. Ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu epǝ we ŋpǝ ŋkpɛ pǝ lah pa lɔ mǝ pǝ nuŋ saŋ rǝ dierǝ we ŋpǝ otukarǝtǝpǝ sa pǝ lah pa tɛŋ pǝ tíi pǝ wǝ. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ ǝkǝnǝŋ pǝlo kpǝlo kɩɩkɩ pǝ yee nyiceŋceŋ! Mǝ Tǝ, mǝŋ kǝ́ ŋlǝ́ e kpii rǝ mǝ, wǝ́ ŋ́ kpii rǝ lǝ́ kǝtǝ we, kǝ ŋpǝ ŋkpɛ pǝ kpii rǝ lǝ ǝnǝ. Mǝŋkǝsa we, kǝ ǝrǝkǝ kǝ lɔ kǝ nuŋ ǝkǝnǝŋ ŋlǝ́ e le kpii mǝ a la maŋ. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ŋmǝ we, okuruyǝ we o kòonu mǝ we, ŋ́ nǝ fǝ yǝ ŋ́ no koonu pǝ, kǝ pǝ nya fɛɛ pǝ yee nyiceŋceŋ mǝŋ kǝ́ ŋlǝ mǝ lǝ́ lǝ lǝ nyiceŋceŋ kǝtǝ. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ŋmǝ we, ŋ́ kpii rǝ pǝ. Wǝ́ ŋlǝ́ e kpii rǝ mǝ, kǝ pǝ nya fɛɛ pǝ to nyiceŋceŋ milimili. Mǝŋkǝsa we, ǝrǝkǝ kǝ lée ci wǝ ǝkǝnǝŋ ŋlǝ́ e le kpii mǝ a la maŋ. Wǝ́ ŋlǝ́ a la taa pǝlǝ kǝǝwǝ mǝŋ kǝ́ a la taa mǝ kǝǝwǝ kǝtǝ. <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />Mǝ Tǝ, ǝ lǝ fǝ pǝ o lo koonu mǝ. Wǝ́ ŋ́ nǝ pǝ́ ǝkǝnǝŋ fɛɛwǝ we ŋ́ kpii we, kǝ ŋpǝ ŋkpɛ pǝ tii rǝ we. Mǝŋkǝsa we, kǝ pǝ nya fɛɛ pǝ nyɩŋ mǝ okuruyǝ, okuruyǝ we o lo koonu mǝ wǝ. Duturǝ ɖi a la taa mǝ kǝǝwǝ kpɛŋ wǝ́ e le ci o po co ǝrǝkǝ. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Mǝ Tǝ, ŋlǝ́ yǝ we a kʊʊ wǝ, ǝrǝkǝ kǝ lee ci lǝ́. Paa ŋmǝ ŋ́ cii lǝ́. Wǝ́ ǝpǝ ǝnǝ pǝ la nyɩŋ wǝ pǝ le ci ǝkǝnǝŋ ŋlǝ́ e le kpii mǝ a la maŋ. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ŋ́ no koonu pǝ le ci lá nyɩŋrǝ. Wǝ́ ŋ́ nǝh pǝ tǝ ŋ́ koonu pǝ ci lǝ́ ke. Mǝŋkǝsa we, kǝ kǝǝtaawǝ we ǝ lǝ fǝ a la taa mǝ we, wǝ kpii rǝ pǝ, kǝ ŋmǝ ŋkpɛ ŋ́ kpii rǝ pǝ.»<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Otuusiitǝpǝ pǝ la lɔ Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matewu 26:47-56</ref>, <ref loc="MRK 14:43-50">Marǝko 14:43-50</ref>, <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko rǝ Sedǝrɔŋ la gbɛnɛŋpirǝ we la kǝtakǝ nɔ, ŋpǝ mǝ no otukarǝtǝpǝ. Atɛɛkǝ rɛ kǝ ka ya rǝ we. Wǝ́ ŋpǝ mǝ no otukarǝtǝpǝ pǝ fii kǝlǝ mǝrǝ. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Yǝ we ŋ neh siiri Yesu ŋ ke ri Yuda. Ke cii fɛɛwǝ we, duturǝ ɖi Yesu lée ce mǝ ŋ ko fɛɛwǝ we ŋpǝ mǝ no otukarǝtǝpǝ.<verse eid="JHN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 18:3" />Wǝ́ Yuda ŋ kolu otoolutǝmumuŋpǝ mǝ Afarisitǝpǝ lǝ kpǝŋ. Wǝ́ otoolutǝmumuŋpǝ sa mǝ Afarisitǝpǝ sa pǝ kòonu no otuusiitǝpǝ lǝ kpǝŋwǝ, mǝ epǝ we pǝ lǝ́ǝ rǝŋ Worokoyǝ la nyarǝ wǝ. Wǝ́ ŋ conu mǝ pǝ pǝ pǝlǝ pǝ fìi atɛɛkǝ we mǝ akaŋreyǝ mǝ akatɩpǝ fǝ kʊla mǝ akɔŋtuyǝ. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Kpiikǝ Yesu ŋ ke cii tuwǝ we wǝ lǝh pǝ wǝ tuu ŋwǝ we, wǝ́ ŋ sanǝ ŋ kolu pǝlǝ kpǝŋ wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Ǝlǝ wǝ́ nǝ ya nǝ nyáa taa?» <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Nazarɛtǝtǝ Yesu.» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ.» Yuda ka yaa rǝ enyipǝ we lǝ kpǝŋ rǝ we. Ŋwǝ ŋ kǝ ŋ fǝ Yesu ŋ kpii pǝ rǝ akaakǝ wǝ. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Kǝ́ Yesu ŋ na nya ŋ ne tíi enyipǝ we ǝkǝnǝŋ «Ŋmǝ ǝyǝǝ» we, wǝ́ pǝ rùu pǝ kolu kǝmaakǝ wǝ́ pǝ rù pǝ tɔ̀ɔlʊ. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Wǝ́ Yesu ŋ tǝ ŋ sìɛnɩ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Ǝlǝ wǝ́ nǝ ya nǝ nyáa taa?» Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Nazarɛtǝtǝ Yesu.» <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ na marǝ etii nǝ ǝkǝnǝŋ ŋmǝ ǝyǝǝ. Mǝŋ ŋmǝ wǝ́ nǝ ya nǝ nyáa taa we, we nǝ maa ǝpǝ ǝnǝ pǝ pwɛyɩ.» <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Yesu tɛnɩ wǝ ǝnǝ kǝ wǝ nya fɛɛ wǝ fǝ wǝ tɛɛ ɖurǝ rǝ dierǝ we ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ nǝǝ lǝǝrǝ epǝ we ǝ lǝ fǝ o lo koonu mǝ la rɛ». <note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="JHN 10:28">10:28</ref>, <ref loc="JHN 17:12">17:12</ref></char>.</char></note><verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Sɩmɔ Pɛtǝro ke re tʊkʊwǝ. Wǝ́ ŋ tìini wǝ ŋ pùuru, wǝ́ ŋ fùru toolutǝmumuŋyǝ we la sʊmatǝyǝ, wǝ́ ŋ ràarǝ ne kǝnirikǝ lo kǝtukoŋkǝ. Sʊmatǝyǝ we la nyɩŋrǝ ge ri Malǝkusǝ. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Paape wǝ́ Yesu ŋ tìi Pɛtǝro ǝkǝnǝŋ: «Siɛnɩ mǝ lá tʊkʊwǝ e kpii rǝ wǝla vɔrǝ. O lo pu wǝ ǝkǝnǝŋ eniyǝ yǝ foo ro kǝ ŋ́ cʊʊrʊ mǝŋ kǝ́ mǝ Tǝ ŋ nǝ pǝ́ wǝ wǝ?»<verse eid="JHN 18:11" /></para>
  <para style="s">Pǝ lo ko mǝ Yesu rǝ Ana lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matewu 26:57-58</ref>, <ref loc="MRK 14:53-54">Marǝko 14:53-54</ref>, <ref loc="LUK 22:54">Luka 22:54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Wǝ́ otuusiitǝpǝ lǝ kpǝŋwǝ mǝ pǝlo mumuŋyǝ fǝ kʊla mǝ Oyudatǝmumuŋpǝ lǝ ǝrǝŋtǝpǝ pǝ lɔ̀ Yesu wǝ́ pǝ pàrǝ ŋwǝ. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu Ana lǝ kpǝŋ kpɛŋ. Ana ke ri Kayifa lo nutǝyǝ, ŋwǝ ŋ lɛ̀ ŋ ke ri toolutǝmumuŋyǝ mǝ cɛŋwǝ we. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Ŋwǝ Kayifa ŋ cìi ŋ kanǝ Oyudatǝmumuŋpǝ we ǝkǝnǝŋ: «Mǝŋ nyiyǝ ceŋceŋ lǝ kpǝ́ la tɛɛ rǝ kǝkpǝŋkǝ kpǝlo lo yurǝ we, wǝ ponu wǝ teeri».<verse eid="JHN 18:14" /></para>
  <para style="s">Pɛtǝro la cwɩ wǝ ǝkǝnǝŋ ŋ nee ri Yesu lo tukarǝtǝyǝ</para>
  <para style="r">(<ref loc="MAT 26:69-70">Matewu 26:69-70</ref>, <ref loc="MRK 14:66-68">Marǝko 14:66-68</ref>, <ref loc="LUK 22:54">Luka 22:54</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Sɩmɔ Pɛtǝro mǝ tukarǝtǝpʊŋpwayǝ rɛ pǝ ke siimǝ Yesu. Toolutǝmumuŋyǝ we ke cii tukarǝtǝpʊŋpwayǝ sa sɩsiɛrɩ. Wǝ́ tukarǝtǝpʊŋpwayǝ sa ŋ fìi toolutǝmumuŋyǝ we la nyarǝwǝ le etikeŋtikǝ ŋ kʊ̀la mǝ Yesu. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Pɛtǝro ŋwǝ paa tùmǝ yàa rǝ koruwǝ rǝ guŋpolurǝ la kǝlɛɛrɩkǝ. Wǝ́ tukarǝtǝyǝ lǝ yǝ eni toolutǝmumuŋyǝ ŋ cii ŋ sìɛnɩ ŋ rù ŋ pǝlǝ ŋ wɛ̀ɛlɩ mǝ tieyǝ we ŋ kǝ ŋ rǝŋ guŋpolurǝ we wǝ. Wǝ́ ŋ rè Pɛtǝro ŋ fìi. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Wǝ́ Sʊmatǝtieyǝ we ŋ kǝ ŋ rǝŋ guŋpolurǝ we ŋ pǝ̀ Pɛtǝro ǝkǝnǝŋ: «Mǝŋkǝ ŋlá ŋkpɛ a kʊla mǝ nyiyǝ sa lo otukarǝtǝpǝ?» Wǝ́ Pɛtǝro ŋ tɛnɩ ǝkǝnǝŋ: «Ow, ŋ́ nee ri no tukarǝtǝyǝ».<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Kǝ́ ziɛrǝ ge kpii kǝto we, asʊmatǝpǝ we mǝ ǝrǝŋtǝpǝ we pǝ kpìi naawǝ pǝ tini pǝ ke ŋ wii. Wǝ́ Pɛtǝro ŋ kolu ŋ tini ŋ kʊ̀la mǝ pǝ, wǝ́ ŋ ke ŋ wii wǝ ŋwǝ ŋkpɛ.<verse eid="JHN 18:18" /></para>
  <para style="r">(<ref loc="MAT 26:59-66">Matewu 26:59-66</ref>, <ref loc="MRK 14:55-64">Marǝko 14:55-64</ref>, <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Wǝ́ toolutǝmumuŋyǝ we ŋ kǝ ŋ pǝ́ Yesu le etieyǝ mǝ ŋ ru rǝ no otukarǝtǝpǝ mǝ no otukaŋyǝ. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Eni ri eni we ŋ́ na wɛɛlɩ ŋ ne tíi nyi ri ŋ nyi rǝ enyikpǝlo le enimiyǝ, wǝ́ ŋ́ na lɛ ŋ́ na kaŋ otuyǝ rǝ okumwɛŋnyuŋyǝ mǝ Worokoyǝ la nyarǝwǝ. Afɛɛyǝ sa wǝ́ Oyudatǝpǝ kpǝlo pǝ lǝ́ǝ pǝ pǝ ŋ ku wǝ. Wǝ́ ŋ́ naa tɛŋ tǝrɛ ŋ́ ŋwaa. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Kǝ́ kǝto wǝ́ a ya ǝ lǝ́ǝ pǝ́ mǝ etieyǝ wǝ? Pǝ́ enyipǝ we pǝ nunu mǝ etieyǝ wǝ, ŋpǝ paa we pǝ cii dierǝ le ɖǝ we ŋ tɛnɩ wǝ.» <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa we, wǝ́ ǝrǝŋtǝpǝ we le ceŋceŋ ŋ ka yaa rǝ kǝlɛɛrɩkǝ we ŋ cà Yesu la kaafieliwǝ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ pǝ láa wɛɛlɩ mǝ toolutǝmumuŋyǝ wǝǝ?» <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ ŋ́ na tɛŋ turɔɔrɔɔwǝ we, tɛŋ wǝ. Paa mǝŋ ŋ́ na tɛŋ dierǝ gʊʊ wǝǝ, kǝ́ kǝto wǝ́ a la ca mǝ wǝ?» <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Ǝ tǝ anyɩŋ pǝ la parǝ Yesu yaa, wǝ́ Ana ŋ fǝ̀ ŋwǝ ŋ manǝ toolutǝmumuŋyǝ we pǝ lóo pwo Kayifa wǝ.<verse eid="JHN 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Rǝ eniyǝ we lǝ mǝrǝ we, anyɩŋ Sɩmɔ Pɛtǝro ŋwǝ paa tini rǝ fɛɛwǝ we lée wii naawǝ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Mǝŋkǝ ŋlá ŋkpɛ e ri no otukarǝtǝpǝ le ceŋceŋ?» Wǝ́ Pɛtǝro ŋ cwɩ̀ɩ wǝ ǝkǝnǝŋ: «Ŋ́ nee ri no tukarǝtǝyǝ!» <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />Wǝ́ toolutǝmumuŋyǝ we la sʊmatǝyǝ ceŋceŋ ŋ pǝ́ Pɛtǝro ǝkǝnǝŋ: «Mǝŋkǝ ŋ́ na nyɩŋ ŋnǝ mǝ Yesu rǝ atɛɛkǝ we?» Ŋwǝ sʊmatǝyǝ sa ŋ ke ri yǝ we Pɛtǝro ŋ ràarǝ kǝtukoŋkǝ lo tuuluyǝ wǝ. <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Wǝ́ Pɛtǝro ŋ tǝ ŋ cwɩ̀ɩ wǝ. Rǝ eniyǝ we lǝ mǝrǝ we, wǝ́ kʊkɔyǝ ŋ kpǝ̀ǝ.<verse eid="JHN 18:27" /></para>
  <para style="s">Pǝ lo ko mǝ Yesu rǝ Pilato lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matewu 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>, <ref loc="MRK 15:1-5">Marǝko 15:1-5</ref>, <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Wǝ́ pǝ fǝ̀ Yesu rǝ Kayifa lǝ kpǝŋ, wǝ́ pǝ ko ŋ ko mǝ ŋwǝ rǝ Oromatǝpǝ lǝ kǝŋyɩrɩtǝyǝ la nyarǝwǝ mǝ ɖokoŋpirǝ ŋalaŋala. Epǝ we pǝ rè ŋwǝ pǝ kolu we, pǝ lee fii nyarǝwǝ we. Pǝ yeli wǝ ǝnǝ kǝ pǝ paa nya fɛɛ pǝ cɩɩrɩ pǝla wɛ, kǝ pǝ ke ri Eyinyapǝkǝ la wǝcɛkpǝ. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Wǝ́ Pilato ŋ pǝlǝ ŋ tùu pǝ rǝ koruwǝ, wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nyiyǝ sa ŋ ne yee?» <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «O koh nuŋ nyiyǝ sa lee yee turɔɔrɔɔwǝ rɛ we, yǝ lǝŋ kǝ fǝ ŋwǝ le pe kpii lǝ́ rǝ akaakǝ.» <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />Wǝ́ Pilato ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ fǝ ŋwǝ nǝ mǝ ko, kǝ ŋnǝŋnǝ nǝ kǝ fǝ nǝ seyǝ nǝ tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ.» Wǝ́ Oyudatǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ laa pɔrʊ gʊŋrǝ pǝ koonu lǝ la wʊ nyiyǝ.» <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Wǝ pǝlǝ ǝnǝ kǝ dierǝ we Yesu ŋ tɛnɩ nya fɛɛ bǝ. Duturǝ ɖi wɛ̀ɛlɩ ru rǝ gbɛŋrǝ we kǝtǝŋkǝ ŋ no furu ŋ pǝ kpǝ́ wǝ. <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />Wǝ́ Pilato ŋ sìɛnɩ ŋ fìi nyarǝwǝ wǝ́ ŋ pwò Yesu ŋ pǝlǝ wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ e ri Oyudatǝpǝ le piliyǝ?» <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ŋlǝ́ a ya láa tɛŋ wǝ amaa enyipʊŋpwapǝ pǝ le tíi lǝ́ wǝ pǝ lo ru rǝ mǝ?» <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />Wǝ́ Pilato ŋ tíi ŋwǝ ǝkǝnǝŋ: «A la nyɩŋ mǝ ŋ́ ri Oyudatǝpǝ? Ŋlǝ́ŋlǝ́ lǝ gǝŋrǝ le enyipǝ mǝ otoolutǝmumuŋpǝ pǝ lǝ fǝ lǝ́ pǝ le kpii mǝ rǝ akaakǝ. Kǝ́ wǝ́ e le yee?» <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ wǝpilirikpǝ wǝ loo ru rǝ ǝrǝkǝ sa. O koh nuŋ mǝ wǝpilirikpǝ wǝ lo ru rǝ ǝrǝkǝ sa we, mǝ enyipǝ pǝ kah kɔŋ kǝ pǝ paa nya fɛɛ pǝ fǝ mǝ pǝ kpii Oyudatǝpǝ rǝ akaakǝ. Wǝ́ kǝ́ mǝ wǝpilirikpǝ wǝ loo ru rǝ ǝrǝkǝ sa kǝto.» <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />Wǝ́ Pilato ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «We piliyǝ wǝ́ e ri?» Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ a ya láa tɛŋ wǝ ǝkǝnǝŋ ŋmǝ ŋ́ ri piliyǝ wǝ. Ŋmǝ we, pǝ lǝ mǝ mǝ, wǝ́ ŋ́ nǝ pǝ ǝrǝkǝ ŋ́ pe ri anʊkɔrǝyǝ la ɖaŋsieyǝ. Yǝ we ŋ nya ŋ kpii rǝ anʊkɔrǝyǝ lǝ mǝrǝ we, lóo co kǝtukoŋkǝ rǝ mǝ.» <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />Wǝ́ Pilato ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ ri anʊkɔrǝyǝ?» Kǝ́ Pilato ŋ nǝ pǝ́ dierǝ sa we, wǝ́ ŋ sanǝ ŋ kolu ŋ tùu Oyudatǝpǝ rǝ koruwǝ wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Rǝ ŋmǝ mǝ anyɩŋkǝ we, ŋ́ naa nyɩŋ turɔɔrɔɔwǝ lǝ wǝ ŋ ne yee kǝ ŋ́ tɔɔ na bɔrǝ.<verse eid="JHN 18:38" /></para>
  <para style="s">Pǝ la tɔɔ Yesu la gbɛŋpɔrǝ</para>
  <para style="r">(<ref loc="MAT 27:15-31">Matewu 27:15-31</ref>, <ref loc="MRK 15:6-20">Marǝko 15:6-20</ref>, <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Paape rǝ nǝ kǝsuŋkǝ kǝto we, wǝ kaamǝ kǝ ŋ́ nyarǝ kukpɛɛtǝyǝ rɛ ŋ́ co ŋ koonu nǝ rǝ Eyinyapǝkǝ la wǝcɛkpǝ le jirǝ. Nǝ nyǝ́ǝ pǝ́ ŋ́ nyarǝ Oyudatǝpǝ le piliyǝ ŋ́ co ŋ́ koonu nǝ?» <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />Wǝ́ pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Yǝ lǝŋ tɛɛnɩ wǝ, ŋkǝ yǝ ǝnǝ. Nyarǝ Baraba o co o koonu lǝ!» Paa we, nyiwʊʊlʊtǝyǝ wǝ́ Baraba ŋ ke ri.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Wǝ́ Pilato ŋ tìi pǝ fǝ̀ Yesu pǝ ŋ ko, wǝ́ ŋ koonu pǝ cùlu ŋwǝ mǝ fwɛɛpǝlawǝ. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Wǝ́ otuusiitǝpǝ we pǝ yàa bilituurǝ rɛ mǝ owuyǝ, wǝ́ pǝ fǝ̀ rǝ pǝ sìi ŋwǝ rǝ yurǝ. Wǝ́ pǝ fǝ̀ kǝkpakpurumumwɛɛrɩkǝ rɛ pǝ kpìi ŋwǝ. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Wǝ́ pǝ rùu pǝ kǝlǝ mǝ Yesu wǝ́ pǝ ke ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yudatǝpiliyǝ ŋ tii vɔrʊrǝ!» Wǝ́ pǝ yà pǝ ka ŋ waarǝ na akaafieliyǝ.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Wǝ́ Pilato ŋ tǝ ŋ sìɛnɩ ŋ rù wǝ́ ŋ tìi Oyudatǝpǝ we ǝkǝnǝŋ: «Nǝ nya nyɩŋ, ŋ́ nǝh pǝ mǝ ŋwǝ ŋ́ po koonu nǝ rǝ koruwǝ, kǝ nǝ ci wǝ ǝkǝnǝŋ ŋ́ naa nyɩŋ turɔɔrɔɔwǝ lǝ wǝ ŋ ne yee kǝ ŋ́ tɔɔ na bɔrǝ oo.» <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Wǝ́ Yesu ŋ rù ŋ pǝlǝ ŋ yàa rǝ koruwǝ, anyɩŋ bilituurǝ we mǝ owuyǝ zìi ŋwǝ rǝ yurǝ, le kpii kǝkpakpurumumwɛɛrɩkǝ we yàa. Wǝ́ Pilato ŋ tìi pǝ ǝkǝnǝŋ: «Nyiyǝ we ǝyǝǝ!» <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />Kǝ́ otoolutǝmumuŋpǝ we mǝ ǝrǝŋtǝpǝ we pǝ la nyɩŋ ŋwǝ we, wǝ́ pǝ yà pǝ ko ŋ woolu ǝkǝnǝŋ: «Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ, kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ!» Wǝ́ Pilato ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝŋnǝ nǝ fǝ ŋwǝ nǝ kpaa nǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ. Ŋmǝ paa we, ŋ́ naa nyɩŋ turɔɔrɔɔwǝ lǝ wǝ ŋ ne yee kǝ ŋ́ tɔɔ na bɔrǝ wǝ.» <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />Wǝ́ Oyudatǝpǝ we pǝ tìi Pilato ǝkǝnǝŋ: «Lǝ lǝǝmǝ seyǝ. Wǝ́ saŋ rǝ seyǝ sa lo oŋuŋkǝ we, wǝ kpii kǝ ŋ kpǝ́. Duturǝ ɖi lǝ fǝ na wɛ le yee Worokoyǝ le Piyǝ.» <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />Kǝ́ Pilato ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ tǝ ŋ fìi vurǝ ŋ kʊ̀la ŋpa. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Wǝ́ ŋ tǝ ŋ sìɛnɩ ŋ fìi nyarǝwǝ, wǝ́ ŋ pǝ́ Yesu ǝkǝnǝŋ: «Ǝpǝ rǝ fǝŋ tǝ wǝ́ e ri?» Paape Yesu lǝǝ kpǝlǝŋ ŋwǝ. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Wǝ́ Pilato ŋ tìi Yesu ǝkǝnǝŋ: «He, ǝ lǝŋ kpǝlǝŋ mǝ? E lee ci wǝ ǝkǝnǝŋ ŋ́ lǝǝmǝ okopiyǝ ŋ́ nóo koru anyarǝ lǝ́ ŋ́ co, wǝ́ ŋ́ lɛ ŋ́ lǝǝmǝ okopiyǝ ŋ́ nóo koru okoonu kǝ pǝ kpaa lǝ́ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ?» <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝ lǝǝ lǝmǝ okopiyǝ rɛ rǝ mǝ oŋuŋkǝ. We tɛŋ okopiyǝ we Worokoyǝ ŋ no koonu lǝ́ rǝ ceŋceŋ. Kǝto yǝ we ŋ nǝ fǝ mǝ ŋ ne kpii lǝ́ rǝ akaakǝ we, no turɔɔrɔɔwǝ wǝ teeri lá nɛŋwǝ.»<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Kǝ́ Pilato ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ kǝ ŋ pǝ́ ŋ nyarǝ Yesu ŋ co. Paape wǝ́ Oyudatǝpǝ we pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Vǝ́ a la nyarǝ ŋwǝ o lo co, we ǝ lǝǝ tǝ e ri Kayizaro la kɛrɩyǝ. Duturǝ ɖi yǝ we ŋ na nya ŋ no pwo na wɛ piliyǝ we, le yi la tɛɛ rǝ Kayizaro.» <verse eid="JHN 19:12" /><verse number="13" style="v" sid="JHN 19:13" />Kǝ́ Pilato ŋ na nya ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ rù mǝ Yesu rǝ koruwǝ. Wǝ́ ŋwǝŋwǝ ŋ kolu ŋ tini rǝ fɛɛtiitɛŋakpaŋyǝ rǝ fɛɛwǝ we pǝ lo co oruyǝ wǝ. Pǝ lóo pwo wǝ mǝ Kǝhebǝritǝkǝ ǝkǝnǝŋ Gabata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Jitutururǝ we kǝ pǝ ŋ ri Eyinyapǝkǝ la wǝcɛkpǝ gǝ lǝǝwe. Wǝ lǝh mǝ lǝ mǝŋ cɔkɔŋtiizaarǝ le eniyǝ. Wǝ́ Pilato ŋ tìi Oyudatǝpǝ we ǝkǝnǝŋ: «Nǝ piliyǝ we ǝyǝǝ!» <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />Wǝ́ pǝ yà pǝ ko ŋ woolu ǝkǝnǝŋ: «Wʊ ŋwǝ, wʊ ŋwǝ! Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ!» Wǝ́ Pilato ŋ yìili ŋ pǝ́ pǝ ǝkǝnǝŋ: «Ŋ́ kpaa nǝ piliyǝ ŋ́ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ?» Wǝ́ otoolutǝmumuŋpǝ we pǝ yìili ǝkǝnǝŋ: «Yǝ lǝǝ tǝ lǝ lǝmǝ pilipʊŋpwayǝ rɛ le teeri Kayizaro». <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />Fɛɛwǝ Pilato ŋ pǝlǝ ŋ nyàrǝ ŋwǝ ŋ cò ŋ kòonu pǝ kǝ pǝ ka kpaa ŋwǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ wǝǝ. Wǝ́ pǝ fǝ̀ Yesu pǝ ko ŋ ko.<verse eid="JHN 19:16" /></para>
  <para style="s">Pǝ la kpaa Yesu pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matewu 27:32-44</ref>, <ref loc="MRK 15:21-32">Marǝko 15:21-32</ref>, <ref loc="LUK 23:26-43">Luka 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Wǝ́ Yesu ŋ rù rǝ tǝŋtǝǝwǝ we anyɩŋ re na kpɛtɛkpǝlɛciiwǝ. Wǝ́ ŋ ko ŋ ko fɛɛwǝ we pǝ lóo pwo ǝkǝnǝŋ Yufoopiwǝ. Pǝ lóo pwo fɛɛwǝ we mǝ Kǝhebǝritǝkǝ ǝkǝnǝŋ Golǝgota. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Fɛɛwǝ we wǝ́ pǝ kolu pǝ kpàa ŋwǝ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. Pǝ kpàa enyipʊŋpwapǝ rɛ eyi ŋpǝ ŋkpɛ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ pǝ kʊ̀la mǝ ŋwǝ kǝta mǝ kǝta. Anyɩŋ Yesu kpii rǝ kǝtiitiikǝ. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Wǝ́ Pilato ŋ tìi pǝ ŋʊ̀rʊ tǝrɛ pǝ kolu pǝ tɛ̀ɛ rǝ oŋuŋkǝ rǝ kpɛtɛkpǝlɛciiwǝ we. Pǝ ŋʊ̀rʊ ǝkǝnǝŋ: «Nazarɛtǝtǝ Yesu, Oyudatǝpǝ le piliyǝ». <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Oyudatǝpǝ wa pǝ kǝ̀ tuwǝ we Pilato ŋ tìi pǝ ŋʊ̀rʊ wǝ. Duturǝ ɖi fɛɛwǝ we pǝ kpàa Yesu pǝ màarǝ we, wǝ kǝ kǝlǝ mǝ tǝŋtǝǝwǝ. Tǝ fǝ kʊla we, pǝ ŋʊ̀rʊ otuyǝ we mǝ Kǝhebǝritǝkǝ, Kǝromatǝkǝ mǝ Kǝhelatǝkǝ. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Wǝ́ otoolutǝmumuŋpǝ we pǝ tìi Pilato ǝkǝnǝŋ: «Paa ŋʊrʊ “Oyudatǝpǝ le piliyǝ”. Ŋʊrʊ ǝkǝnǝŋ: “Nyiyǝ sa ya láa tɛŋ ǝkǝnǝŋ ŋwǝ ŋ ri Oyudatǝpǝ le piliyǝ.”» <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />Wǝ́ Pilato ŋ tìi pǝ ǝkǝnǝŋ: «Tuwǝ we ŋ́ na ŋʊrʊ we, ŋ́ na ŋʊrʊ wǝ ŋ́ na lɛ».<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Kǝ́ otuusiitǝpǝ we pǝ la kpaa Yesu pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ pǝ la lɛ we, wǝ́ pǝ fǝ̀ na wǝkpakpǝ pǝ sǝ̀pǝ fɛɛwǝ kpeewǝ niǝ. Wǝ́ yǝ mǝ yǝ ŋ lɔ̀ kpeewǝ ceŋceŋ. Wǝ́ wǝ kolu wǝ tùuru na kǝkpakpurumukǝ. Pǝ laa kala kǝ, pǝ yàa kǝ mǝ nyaŋrǝ jeŋceŋ ru rǝ oŋuŋkǝ pa sʊʊ rǝ. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Wǝ́ otuusiitǝpǝ we pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Rɛ ŋ paa laarǝ kǝ. Nǝ pǝ kǝ lo co ciiwǝ kǝ la nyɩŋ lǝh ǝlǝ ŋ nǝ́ǝ fǝ kǝ wǝ.» Kǝ́ wǝ yeli wǝ sanǝ wǝ́ Wǝŋʊrʊkpǝ la fɛɛwǝ we wǝ la tɛŋ ǝkǝnǝŋ: «Pǝ lǝ fǝ mǝ wǝkpakpǝ pǝ lǝ sǝpǝ awɛ. Wǝ́ pǝ lo co ciiwǝ kǝ pǝ nyɩŋ pǝlǝ yǝ ŋ nǝ́ǝ fǝ mǝ kǝkpakpurumukǝ wǝ» wǝ pǝlǝ wǝǝ. Tuwǝ otuusiitǝpǝ we pǝ yeli wǝǝ.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Yesu le lee mǝ ne lee la paatɛ mǝ Kǝlopasǝ le tie Marɩya fǝ kʊla mǝ Marɩya ŋ no ru rǝ Magǝdala wǝ, pǝ ka yaa rǝ Yesu la kpɛtɛkpǝlɛciiwǝ we la kǝlɛɛrɩkǝ. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Kǝ́ Yesu ŋ na nyɩŋ ne lee we, wǝ́ ŋ nyɩnɩ kǝ́ tukarǝtǝyǝ we ŋ ka ŋ taa kǝǝwǝ ŋ yaa ŋ maarǝ mǝ ŋwǝ wǝ. Wǝ́ Yesu ŋ tìi ne lee ǝkǝnǝŋ: «Mǝ lee, a lǝŋ nyɩŋ, lé piyǝ ǝyǝǝ.» <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />Wǝ́ ŋ tìi tukarǝtǝyǝ we ǝkǝnǝŋ: «A lǝŋ nyɩŋ, lé lee ǝyǝǝ.» Fǝ ǝrǝ eniyǝ we, wǝ́ tukarǝtǝyǝ sa ŋ fǝ̀ ŋwǝ ŋ kolu ŋ rè rǝ na nyarǝwǝ.<verse eid="JHN 19:27" /></para>
  <para style="s">Yesu lǝ ǝkpǝ́kǝ</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matewu 27:45-56</ref>, <ref loc="MRK 15:33-41">Marǝko 15:33-41</ref>, <ref loc="LUK 23:44-49">Luka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Rǝ wǝla kǝmaakǝ we, anyɩŋ Yesu cii wǝ ǝkǝnǝŋ rǝkǝsa tu ri ŋ tu wǝ la lɛ, kǝ Wǝŋʊrʊkpǝ le etieyǝ we yǝ nya fɛɛ yǝ pǝ ko to rǝ we, wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Kǝmɛŋtɛŋkǝ kǝ ya kǝ láa wʊ mǝ.» <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Wǝpwɛŋkpǝ wǝ lǝ̀ mǝ vɛŋnyarǝyǝ wǝ ka kpɛlɩ rǝ fɛɛwǝ we. Wǝ́ otuusiitǝpǝ we pǝ fǝ̀ tutuuwǝ pǝ tɛ̀kɛ rǝ vɛŋnyarǝyǝ we. Wǝ pǝ fǝ̀ wǝ pǝ yɔ̀ɔ rǝ izɔpǝyǝ<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">Rǝ Oyudatǝpǝ lǝ kpǝŋ we, izɔpǝyǝ le eweyǝ wǝ́ pǝ kǝ ŋ fǝ pǝ ŋ yee ewiikǝ lo kǝsuŋkǝ.</char></note> le jiirǝ. Wǝ́ pǝ fǝ̀ pǝ kǝ ŋ kǝlǝ mǝ Yesu lo nyuŋkpǝ. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Kǝ́ Yesu ŋ na nya ŋ no ŋuŋ vɛŋnyarǝyǝ we eni we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Tu ri ŋ tu wǝ la lɛ.» Wǝ́ ŋ pɛ̀ɛlɩ yurǝ ko wǝ́ ŋ kpǝ̀.<verse eid="JHN 19:30" /></para>
  <para style="s">Tuusiitǝyǝ rɛ lo tu Yesu lo gulorǝ rǝ lɛɛrɩwǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Jirǝ we kǝ kǝ fǝ gǝ ŋ kaalǝ sabatǝyǝ le jirǝ gǝ lǝǝwe. Oyudatǝmumuŋpǝ we pǝ lǝǝ pǝ́ enyiǝtǝpǝ sa pǝ pa tɛɛ rǝ kpɛtɛkpǝlɛciiwǝ mǝ sabatǝyǝ le jirǝ. Duturǝ ɖi sabatǝyǝ lǝ yǝǝ we, ke ri jimumuŋrǝ rɛ ŋpa. Wǝ́ pǝ kolu pǝ tìi Pilato ǝkǝnǝŋ ŋ koonu pǝ ko poolu enyipǝ we pǝ la kpaa pǝ la maarǝ rǝ akpɛtɛkpǝlɛciiyǝ la acɩɩnɛyǝ, kǝ pǝ faarǝ enyiǝtǝpǝ we. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Wǝ́ otuusiitǝpǝ pǝ kolu. Wǝ́ pǝ pòolu nyisǝsǝŋyǝ we, mǝ yitǝyǝ we pǝ kpàa pǝ màarǝ pǝ kʊ̀la mǝ Yesu we, la acɩɩnɛyǝ. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Kǝ́ pǝ lo ko ro Yesu lǝ kpǝŋ we, pǝ tùru la marǝ lǝ kpǝ́. Kǝto pǝ lǝǝ tǝ pǝ poolu na acɩɩnɛyǝ. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Paa wǝ́ otuusiitǝpǝ we la rɛɛyǝ ŋ tù no gulerǝ rǝ lɛɛrɩwǝ. Kǝtǝrǝceŋceŋ wǝ́ ŋpǝrayǝ mǝ mɛŋwǝ yǝ ko ŋ ru. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Yǝ we ŋ nyɩnɩ otuyǝ sa we, ŋwǝ ŋ ne ri yǝla ɖaŋsieyǝ wǝ. Wǝ́ na ɖaŋsieyǝ sa ŋ ne ri we, anʊkɔrǝyǝ yǝ lǝǝwe. Nyiyǝ sa we, cii wǝ ǝkǝnǝŋ ŋ ya ŋ náa tɛŋ anʊkɔrǝyǝ kǝ ŋnǝ ŋkpɛ nǝ nya fɛɛ nǝ lɔ nǝ nuŋ. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Duturǝ ɖi tuwǝ sa wǝ lǝ pǝ ǝnǝ kǝ dierǝ we Wǝŋʊrʊkpǝ wǝ la tɛŋ ǝkǝnǝŋ «No okopiyǝ la ɖɛ ri ɖɛ lǝŋ polu» we, wǝ nya fɛɛ wǝ pǝ. <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Wǝ́ Wǝŋʊrʊkpǝ la fɛɛrɛɛwǝ wǝ ŋkpɛ wǝ la tɛŋ ǝkǝnǝŋ: «Pǝ lah mǝ yɩrɩ yǝ we pǝ lo tu pǝ lǝ wǝǝrǝ wǝ».<verse eid="JHN 19:37" /></para>
  <para style="s">Pǝ la ka ŋwaa Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matewu 27:57-61</ref>, <ref loc="MRK 15:42-47">Marǝko 15:42-47</ref>, <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Yosɛfʊ ŋ no ru rǝ arimata we, ke ri Yesu lo tukarǝtǝyǝ rǝ kǝŋwaakǝ. Duturǝ ɖi ko ŋ suu Oyudatǝmumuŋpǝ we lo vurǝ. Kǝ́ Yesu ŋ nǝ kpǝ́ ŋ na lɛ we, wǝ́ Yosɛfʊ ŋ kolu ŋ pǝ̀ gʊŋrǝ rǝ Pilato lǝ kpǝŋ, kǝ ŋ ka faarǝ Yesu le kǝnyiǝtǝkǝ we. Wǝ́ Pilato ŋ tɛ̀ɛnɩ. Wǝ́ Yosɛfʊ ŋ kolu ŋ fàarǝ nyiǝtǝyǝ we. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Wǝ́ Nikodɛmǝ, yǝ we ŋ kolu Yesu lǝ kpǝŋ jirɛɛrǝ mǝ dumurǝ we, ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ rù. Ke re apɔŋfɛŋfɛŋpǝ rɛ pǝ lǝ fǝ mirǝyǝ mǝ alowɛsɩyǝ pǝ le yee wǝ. Yǝ lǝh mǝ lǝ mǝŋ kiloyǝ tǝta. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Wǝ́ pǝle eyi pǝ fǝ̀ Yesu le kǝnyiǝtǝkǝ we, wǝ́ pǝ fǝ̀ kɛlɛlɛyǝ la wǝpakpǝ pǝ mìli ŋwǝ. Wǝ́ pǝ nunu na apɔŋfɛŋfɛŋpǝ we. Rǝ Oyudatǝpǝ lo kǝsuŋkǝ we, kǝ́ pǝ la ŋwaa nyiyǝ pǝ ŋ saŋ wǝǝ. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Atɛɛkǝ rɛ kǝ ka yaa rǝ fɛɛwǝ we pǝ kpàa Yesu pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. Rǝ atɛɛkǝ sa lǝ mǝrǝ we, wǝfuŋŋwɛŋkpǝ rɛ wǝ ka yaa. Pǝ faa ka ŋwaa nyiyǝ rǝ kpǝ pǝ nyɩŋ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Kǝ́ wǝ ke ri Oyudatǝpǝ le jikpakaarǝ fǝ kaalǝ sabatǝyǝ kǝto, wǝ́ Yosɛfʊ mǝ Nikodɛmǝ pǝ fǝ̀ Yesu pǝ ŋwàa rǝ we. Duturǝ ɖi wǝfuŋkpǝ sa wǝ kǝ kǝlǝ mǝ pǝ wǝ.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Yesu la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matewu 28:1-10</ref>, <ref loc="MRK 16:1-8">Marǝko 16:1-8</ref>, <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Kɔsɩrayǝ lo rokoŋpikaalǝwǝ yuu, wǝ́ Marɩya ŋ no ru rǝ Magǝdala ŋ yili ŋ kolu vuŋtɔŋrǝ we la fɛɛwǝ. Wǝ́ ŋ nyɩnɩ pǝ lǝ pǝǝlǝ ɖurǝ we pǝ la cɛ rǝ wǝfuŋkpǝ we. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Wǝ́ ŋ sùu ŋ ko ŋ ko, ŋ kolu ŋ nyɩnɩ Sɩmɔ Pɛtǝro mǝ tukarǝtǝyǝ nɔ, yǝ we Yesu ŋ ka ŋ taa kǝǝwǝ wǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Pǝ la pɔrʊ Kulǝtǝyǝ rǝ wǝfuŋkpǝ we pǝ la pwɛyɩ. Wǝ́ yǝ lee ci fɛɛwǝ pǝ le ke kpii ŋwǝ.» <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />Wǝ́ Pɛtǝro mǝ tukarǝtǝyǝ nɔ pǝ rù pǝ ko ŋ ko vuŋtɔŋrǝ we la fɛɛwǝ. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Wǝ́ pǝle eyi pǝ sùu pǝ ko ŋ ko. Paa tukarǝtǝyǝ nɔ sùu teeri Pɛtǝro. Wǝ́ ŋ conu ŋ kolu ŋ fìi vuŋtɔŋrǝ we la fɛɛwǝ. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Wǝ́ ŋ pɛ̀ɛlɩ ŋ cò kpɛɛ ŋ yɩ̀rɩ, wǝ́ ŋ nyɩnɩ kɛlɛlɛyǝ we la wǝpakpǝ sɔŋ wǝ kpɛlɩ rǝ kǝtǝǝwǝ rǝ we. Paa lee fii wǝfuŋkpǝ we mǝrǝ. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Wǝ́ Sɩmɔ Pɛtǝro ŋ ke siimǝ ŋwǝ we, ŋ cìi ǝ pǝlǝ ŋ rù. Wǝ́ ŋ fìi wǝfuŋkpǝ we. Wǝ́ ŋ nyɩnɩ kɛlɛlɛyǝ we ŋ ka kpɛlɩ rǝ kǝtǝǝwǝ rǝ we wǝ. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Wǝ ŋ lɛ̀ ŋ nyɩnɩ nyaŋrǝ we pǝ fǝ̀ pǝ sìi Yesu lo yurǝ wǝ. Laa ka kpɛɛ gʊla mǝ kɛlɛlɛyǝ we la wǝpakpǝ. Paa bìri ga kpɛlɩ rǝ fɛɛwǝ rɛ kpoo. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Wǝ́ tukarǝtǝ yǝnɔ, yǝ we ŋ conu ŋ kolu ŋ fìi vuŋtɔŋrǝ we la fɛɛwǝ we ŋwǝ ŋkpɛ ŋ cìi e ke ŋ fii wǝfuŋkpǝ we. Wǝ́ ŋ nyɩnɩ, wǝ́ ŋ lɔ̀ ŋ nunu. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Wǝŋʊrʊkpǝ wǝ la tɛŋ ǝkǝnǝŋ wǝ kpii kǝ Yesu ŋ saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. Paape rǝ eniyǝ we lǝ mǝrǝ we, otukarǝtǝpǝ we pǝ faa ka maa pǝ nuŋ wǝlo duturǝ. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Wǝ́ otukarǝtǝpǝ sa pǝle eyi pǝ kpǝ̀lǝŋ pǝ ko ŋ ko pǝla anyarǝyǝ.<verse eid="JHN 20:10" /></para>
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ Marɩya ŋ no ru rǝ Magǝdala wǝ</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matewu 28:9-10</ref>, <ref loc="MRK 16:9-11">Marǝko 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Wǝ́ Marɩya ŋ tùmǝ ŋ yàa rǝ vuŋtɔŋrǝ we la kǝlɛɛrɩkǝ rǝ dǝǝtǝǝrǝ. Wǝ́ ŋ yà ŋ ke ŋ wee. Ya lée wee wǝ́ ŋ ko ŋ co kpɛɛ mǝ ŋ yɩrɩ wǝfuŋkpǝ we. <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />Wǝ́ ŋ nyɩnɩ epicoŋpipǝ eyi. Pǝ le kpii wǝkpakpɛɛlɩkpǝ pǝ tini rǝ fɛɛwǝ we pǝ kpɛ̀ɛlɩ Yesu le kǝnyiǝtǝkǝ wǝ. Ceŋceŋ rǝ yuteewǝ, ceŋceŋ rǝ akparǝpɔɔlʊyǝ. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kuleleyǝ, kǝ́ kǝto wǝ́ a ya lée wee wǝ?» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Pǝ la pa pɔrʊ mǝ Kulǝtǝyǝ pǝ la pwɛyɩ. Wǝ́ ŋ́ nee ci fɛɛwǝ pǝ le ke kpii ŋwǝ.» <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Ya láa wɛɛlɩ, mǝŋ a pa siɛrɩ eni we, wǝ́ ŋ nyɩnɩ kǝ́ Yesu ŋ yaa wǝ. Paape lee ke ci wǝ ǝkǝnǝŋ ŋwǝ ŋ lǝǝwe. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ a ya lée wee wǝ? Ǝlǝ wǝ́ a ya láa taa?» Wǝ́ ŋ ko ŋ pu ǝkǝnǝŋ tɛɛlǝtǝyǝ we ŋ lǝǝwe. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ ŋlǝ́ a la pɔrʊ ŋwǝ we, kǝ e tíi mǝ fɛɛwǝ e le ke kpii ŋwǝ wǝ, kǝ ŋ́ nya fɛɛ ŋ́ kǝ fǝ ŋwǝ ŋ́ pwɛyɩ.» <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />Wǝ́ Yesu ŋ pwò ŋwǝ ǝkǝnǝŋ: «Marɩya!» Wǝ́ ŋ sìɛrɩ, wǝ́ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Rabuni». Wǝlo duturǝ ɖi Tukaŋtǝyǝ. <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo ruu mǝ! Duturǝ ɖi ŋ́ faa maa ŋ ko mǝ Tǝ lǝ kpǝŋ rǝ yulaarǝ. Ŋlǝ́ we, mǝ ko o ko tuu mǝ apaanʊpǝ, kǝ e tíi pǝ ǝkǝnǝŋ ŋmǝ ŋ́ nah rɛ mǝ Tǝ lǝ kpǝŋ. Ŋwǝ ŋ ri ŋnǝ ŋkpɛ nǝ Tǝ. Ŋ́ nah rɛ mǝ Worokoyǝ lǝ kpǝŋ. Ŋwǝ ŋ ri ŋnǝ ŋkpɛ nǝ Worokoyǝ.» <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />Wǝ́ Marɩya ŋ no ru rǝ Magǝdala ŋ pǝlǝ ŋ tɛnɩ wǝ ŋ tìi otukarǝtǝpǝ we ǝkǝnǝŋ: «Ŋ́ na nyɩŋ Kulǝtǝyǝ!» Wǝ́ ŋ fǝ tu ri ŋ tu Kulǝtǝyǝ ŋ ne tíi ŋwǝ ŋ pɔ̀ pǝ la amayǝ.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ no otukarǝtǝpǝ</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matewu 28:16-20</ref>, <ref loc="MRK 16:14-18">Marǝko 16:14-18</ref>, <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Ŋwǝ kɔsɩrayǝ we la ɖiɔrǝ we, anyɩŋ otukarǝtǝpǝ we pǝ lo ku pǝ kpii rǝ nyarǝwǝ rɛ. Wǝ́ pǝ tanǝ aŋwaayǝ mǝ asafwepǝ duturǝ ɖi pǝ ko ŋ suu Oyudatǝmumuŋpǝ we lo vurǝ. Wǝ́ Yesu ŋ pǝlǝ ŋ rù ŋ yàa rǝ pǝle kǝtiitiikǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoyǝ la wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ.» <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Kǝ́ ŋ ne tíi pǝlo tuwǝ sa we, wǝ́ ŋ fǝ̀ na wǝkaakpǝ mǝ na lɛɛrɩwǝ ŋ ka ŋ kaŋ pǝ. Kǝ́ pǝ la nyɩŋ Kulǝtǝyǝ we, wǝ́ otukarǝtǝpǝ we pǝ nyà faawǝ ŋpa. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoyǝ la wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ. Mǝŋ kǝ́ Tǝyǝ ŋ ne kpii mǝ ŋ na maŋ we, ŋmǝ ŋkpɛ ŋ́ ya ŋ́ née kpii nǝ mǝ ŋ maŋ.» <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Kǝ́ ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ fùru wɛɛrǝ ŋ fìeni pǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ lɔ Wɛɛkenikenirǝ. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Mǝŋ nǝ nyǝ fǝ nyiyǝ rɛ lo oturɔɔrɔɔyǝ nǝ nya cɛɛ ŋwǝ we, Worokoyǝ lǝ́ǝ fǝ yǝ ŋ cɛɛ ŋwǝ. Vǝ́ mǝŋ nǝ nyǝǝ fǝ rɛ lo oturɔɔrɔɔyǝ nǝ cɛɛ ŋwǝ we, Worokoyǝ lǝŋ fǝ yǝ ŋ cɛɛ ŋwǝ.»<verse eid="JHN 20:23" /></para>
  <para style="s">Yesu le ci la kaŋ Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Eniyǝ we Yesu ŋ pǝlǝ we, anyɩŋ enyikpiitǝmeyipǝ we le ceŋceŋ, Toma pǝ lǝ́ǝ tǝ pǝ ŋ pwo Wɛɛpiyǝ we laa ka kʊla mǝ pǝ. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Wǝ́ otuturupǝ we pǝ pǝlǝ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la nyɩŋ Kulǝtǝyǝ.» Wǝ́ Toma ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ ŋ́ naa nyɩŋ afɛɛyǝ we pǝ cà na awarǝpiyǝ rǝ na wǝkaakpǝ, mǝŋ ŋ́ noo ruu afɛɛyǝ we pǝ cà na awarǝpiyǝ mǝ mǝ gaapirǝ, kǝ ŋ́ fǝ mǝ akaakǝ ŋ ruu na lɛɛrɩwǝ we, ŋ́ nǝŋ pa lɔ ŋ́ nuŋ pwi».<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Juunɛŋtǝrǝ we, wǝ́ otukarǝtǝpǝ we pǝ tǝ pǝ kolu pǝ kùu rǝ nyarǝwǝ we. Toma ka kʊla mǝ pǝ. Pǝ la taŋ aŋwaayǝ we mǝ asafwepǝ. Wǝ́ Yesu ŋ pǝlǝ ŋ rù rǝ pǝle kǝtiitiikǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoyǝ la wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ.» <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Wǝ́ ŋ tìi Toma ǝkǝnǝŋ: «Fǝ lá gaapirǝ o ruu ɖǝǝnǝ, kǝ a yɩrɩ mǝ wǝkaakpǝ re. Pǝ mǝ lá akaakǝ, kǝ ǝ fǝ a tɛɛ rǝ mǝ lɛɛrɩwǝ sa a yɩrɩ re! Wɛɛ mǝ ǝtǝmǝlǝkǝ kǝ a lɔ o nuŋ!» <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />Wǝ́ Toma ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ Kulǝtǝyǝ mǝ mǝ Worokoyǝ.» <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ a la nyɩŋ mǝ kǝto wǝ́ a la lɔ o lo nuŋ wǝ? Epǝ we pǝ laa nyɩŋ mǝ paa wǝ́ pǝ la lɔ pǝ lo nuŋ we, pǝ lo co yǝ.»<verse eid="JHN 20:29" /></para>
  <para style="s">Kǝ́ kǝto wǝ́ pǝ la ŋʊrʊ kǝfwɛɛkǝ sa wǝ?</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesu tǝ yeli otupʊŋpwayǝ wa yǝ lóo co vurǝ rǝ no otukarǝtǝpǝ le enimiyǝ. Paa pǝ laa ŋʊrʊ yǝ pǝ kpii rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Pǝ ŋʊ̀rʊ ǝyǝ ǝnǝ pǝ kpii, kǝ nǝ nya fɛɛ nǝ lɔ nǝ nuŋ ǝkǝnǝŋ Yesu ŋ ri Mesiyayǝ we, Worokoyǝ le Piyǝ. Wǝ́ mǝŋ nǝ nya lɔ ŋwǝ nǝ nyo nuŋ we, nǝ nyáa nya vɔrʊrǝ saŋ rǝ na nyɩŋrǝ.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ no otukarǝtǝpǝ apǝrɩmata</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Yesu ŋ tǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ no otukarǝtǝpǝ rǝ Tiberia lo puŋkɔwǝ we la kǝlɛɛrɩkǝ. Nǝ nyɩŋ wǝlǝkpǝ ŋ fǝ̀ ŋ pɔ̀rʊ na wɛ ŋ kanǝ pǝ wǝ. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Sɩmɔ Pɛtǝro mǝ Toma pǝ lóo pwo Wɛɛpiyǝ mǝ Nataniɛlǝ ŋ no ru rǝ Kana rǝ Galileya lǝ gǝŋrǝ wǝ, mǝ Zebede le epipǝ, fǝ kʊla mǝ Yesu lo otukarǝtǝrɛɛpǝ eyi pǝ ke kpii fɛɛceŋceŋ. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Wǝ́ Sɩmɔ Pɛtǝro ŋ pǝlǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ noh ko ŋ ko co safʊyǝ». Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lée siimǝ lǝ́ lo ko». Wǝ́ pǝ rù pǝ ko ŋ ko pǝ kolu pǝ fìi gʊrɔrǝ. Paape pǝ laa lɔ tǝrɛ mǝ dumurǝ we. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Kǝ́ ǝrǝkǝ kǝ la kaalǝ we, wǝ́ Yesu ŋ pǝlǝ ŋ yàa rǝ kǝpǝŋpǝŋkǝ rǝ we. Paa no otukarǝtǝpǝ we pǝ lee ke ci wǝ ǝkǝnǝŋ Yesu ŋ lǝǝwe. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: Mǝ epipǝ, nǝ nya lɔ wǝpwɛɛkpǝ rɛ? Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ow». <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ co nǝ safʊyǝ rǝ gʊrɔrǝ we le kǝnirisiɛɛkǝ, nǝ nyáa lɔ». Wǝ́ pǝ cò safʊyǝ we. Pǝ loo kòru etiini ŋwǝ pǝ ru, kpiikǝ ŋ lǝ̀ mǝ wǝpwɛkpǝ tiŋtiŋ kǝto. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />Wǝ́ Yesu lo tukarǝtǝyǝ we ŋ ka ŋ taa kǝǝwǝ ŋ tìi Pɛtǝro ǝkǝnǝŋ: «Kulǝtǝyǝ ŋ lǝǝwe!» Kǝ́ Sɩmɔ Pɛtǝro ŋ no nuŋ ǝkǝnǝŋ Kulǝtǝyǝ ŋ lǝǝwe we, wǝ́ ŋ fǝ̀ na kǝkpakǝ ŋ kpìi. Duturǝ ɖi pɔ̀rʊ kǝ tǝ̀nǝ. Wǝ́ ŋ tɔ̀ mɛŋwǝ ŋ wili ŋ ko ŋ ko. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Wǝ́ otuturupǝ we pǝ sìɛnɩ pǝ kǝ ŋ pǝ mǝ gʊrɔrǝ we, wǝ́ pǝ tìini safʊyǝ we ŋ nǝ lǝ mǝ wǝpwɛɛkpǝ tiŋtiŋ pǝ kǝ ŋ pǝ. Pǝ lǝǝ kǝ lǝǝrǝ mǝ kǝpǝŋpǝŋkǝ kpaa. Wǝ lǝh mǝ lǝ mǝŋ mɛtayǝ tuuru. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Kǝ́ pǝ la pa sʊʊ kǝtǝǝwǝ we, wǝ́ pǝ nyɩnɩ pǝ le kpii naawǝ wǝ́ pǝ lǝ fǝ wǝpwɛɛkpǝ pǝ la tɛɛ rǝ wǝ. Kpɔnɔyǝ kpɛlɩ rǝ kǝlɛɛrɩkǝ we. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pɔrʊ wǝpwɛɛkpǝ we nǝ nya lɔ rǝkǝsa la wǝ rɛ nǝ pǝ kǝ la nyɩŋ.» <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Wǝ́ Sɩmɔ Pɛtǝro ŋ fìi gʊrɔrǝ we. Wǝ́ ŋ tìini safʊyǝ we ŋ pǝlǝ ŋ cò rǝ kǝtǝǝwǝ. Anyɩŋ lǝ lǝ kpii mǝ wǝpwɛɛkpoopukpǝ tuuru mǝ tǝtʊʊ mǝ wǝta. Mǝŋ wǝpwɛɛkpǝ sa la anaanǝkǝ paape, safʊyǝ we laa larǝ. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ pǝ nǝ pe ri». Otukarǝtǝpǝ sa la rɛ loo tu turuwǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ ǝlǝ ǝ lǝǝwe?» Kpiikǝ pǝ ke cii wǝ sɩsiɛrɩ ǝkǝnǝŋ Kulǝtǝyǝ ŋ lǝǝwe. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Wǝ́ Yesu ŋ rùu ŋ kǝ̀lǝ. Wǝ́ ŋ fǝ̀ kpɔnɔyǝ ŋ kòonu pǝ. Wǝ́ ŋ fǝ̀ wǝpwɛɛkpǝ wǝ ŋkpɛ ŋ kòonu pǝ. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Kǝtatǝkǝ Yesu ŋ pɔ̀rʊ na wɛ ŋ kanǝ no otukarǝtǝpǝ kǝ́ ŋ sàanǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝǝ.<verse eid="JHN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Kǝ́ pǝ le ri pǝ la lɛ we, wǝ́ Yesu ŋ pǝ̀ Sɩmɔ Pɛtǝro ǝkǝnǝŋ: «Yowanɛsɩ le pi Sɩmɔ, a láa taa mǝ kǝǝwǝ mǝ ŋ teeri ǝpǝ ǝnǝ?» Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Awo, Kulǝtǝyǝ, e cii wǝ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa lǝ́ kǝǝwǝ». Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ yɩrɩ mǝ amɛɛpipǝ lo yurǝ.» <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ kǝyitǝkǝ ǝkǝnǝŋ: «Yowanɛsɩ le pi Sɩmɔ, a láa taa mǝ kǝǝwǝ?» Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Awo, Kulǝtǝyǝ, e cii wǝ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa lǝ́ kǝǝwǝ». Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ rǝŋ mǝ amɛɛpǝ». <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ kǝtatǝkǝ ǝkǝnǝŋ: «Yowanɛsɩ le pi Sɩmɔ, a láa taa mǝ kǝǝwǝ?» Wǝ́ wǝ kpìi Pɛtǝro la awɛɛlɩkǝ, duturǝ ɖi kǝtatǝkǝ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «A láa taa mǝ kǝǝwǝ?» wǝǝ. Wǝ́ ŋ tǝ ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, e cii tu ri ŋ tu! E cii wǝ sɩsiɛrɩ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa lǝ́ kǝǝwǝ». Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yɩrɩ mǝ amɛɛpǝ lo yurǝ. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, kǝ́ e ke ri gosopifɔŋrǝ we, ŋlǝ́ŋlǝ́ a ka ŋ parǝ lá apɔsɔyǝ. O ko fɛɛwǝ wǝ ponu mǝ lǝ́ wǝ. Vǝ́ e le pe yee nyumuyǝ a la lɛ we, e leh mǝ yiili wǝnukpǝ, nyipʊŋpwayǝ ŋ parǝ lǝ́ lá apɔsɔyǝ, ŋ ko mǝ lǝ́ rǝ fɛɛwǝ we ǝ lǝǝ pǝ́ wǝ.» <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yesu wɛ̀ɛlɩ ǝnǝ kǝ ŋ fǝ ŋ kaŋ gbɛŋrǝ lǝ ɖǝ kǝtǝŋkǝ Pɛtǝro ŋ nǝh pǝ kpǝ́ kǝ wǝ kǝ Worokoyǝ wǝ. Wǝla kǝmaakǝ wǝ́ ŋ tìi Pɛtǝro ǝkǝnǝŋ: «Siimǝ mǝ!»<verse eid="JHN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Kǝ́ Pɛtǝro ŋ na pa siɛrɩ we, wǝ́ ŋ nyɩnɩ tukarǝtǝyǝ we Yesu ŋ náa taa kǝǝwǝ rǝ pǝla kǝmaakǝ. Kǝ́ pǝ ke ŋ ri, le yǝ we ŋ kpɛ̀ɛlɩ ŋ tɛ̀ɛ Yesu rǝ turuwǝ, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ǝlǝ ŋ nǝh fǝ lǝ́ ŋ kpii enyipǝ rǝ akaakǝ wǝ?» <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Kǝ́ Pɛtǝro ŋ na nyɩŋ ŋwǝ we, wǝ́ ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, wǝ́ yǝ ǝnǝ pa, kǝ́ wǝ lǝh pǝ pǝ wǝ tuu ŋwǝ?» <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ ŋ́ nǝ pǝ́ ŋ tii vɔrʊrǝ ko ro kǝ́ ŋ́ náa siɛnɩ ŋ́ pǝ wǝǝ, wǝ fǝ lǝ́ fǝŋ? Ŋlǝ́ siimǝ mǝ rǝ.» <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Wǝ́ tuwǝ sa wǝ tò kpoo rǝ alɔnuŋtǝpǝ we lǝ mǝrǝ ǝkǝnǝŋ tukarǝtǝyǝ sa lǝŋ pǝ kpǝ́. Paa we, Yesu laa tɛŋ ŋ tíi Pɛtǝro ǝkǝnǝŋ tukarǝtǝyǝ sa lǝŋ pǝ kpǝ́ oo! Tɛnɩ ǝkǝnǝŋ: «Mǝŋ ŋ́ nǝ pǝ́ ŋ tii vɔrʊrǝ ko ro kǝ́ ŋ́ náa siɛnɩ ŋ́ pǝ wǝǝ wǝ fǝ lǝ́ fǝŋ?<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Wǝŋʊrʊkuukuurɛɛkpǝ wǝ lee kpii «wǝ fǝ lǝ́ fǝŋ». </char></note>»<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Ŋwǝ tukarǝtǝyǝ sa ŋ ya ŋ née ri otuyǝ sa la ɖaŋsieyǝ, wǝ́ ŋ na lɛ ŋ na ŋʊrʊ yǝ wǝ. Wǝ́ le cii wǝ ǝkǝnǝŋ na ɖaŋsieyǝ sa ŋ ne ri we, anʊkɔrǝyǝ yǝ lǝǝwe.<note caller="+" style="f"><char style="fr" closed="false">21:24 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="JHN 19:35">19:35</ref></char>.</char></note><verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Yesu tǝ yeli otupʊŋpwayǝ ŋpa. Mǝŋ pǝ ka mǝ ŋʊrʊ yǝ jeŋceŋ jeŋceŋ we, rǝ mǝ anyɩŋkǝ we, ǝrǝkǝ sa kpǝlo kɩɩkɩ kǝ lǝŋ ka kaa wǝfwɛɛkpǝ we pǝ kah ŋʊrʊ wǝ.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>