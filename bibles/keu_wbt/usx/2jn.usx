<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">Akebou: La Bible en akebou</book>
  <para style="h">2 Yowanɛsɩ</para>
  <para style="toc3">2Yo</para>
  <para style="toc2">2 Yowanɛsɩ</para>
  <para style="toc1">Yowanɛsɩ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Yowanɛsɩ</para>
  <para style="mt2">la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Kǝfwɛɛkǝ sa kǝ kaamǝ Yowanɛsɩ la wǝfwɛɛkpǝ we wǝta ŋ na ŋʊrʊ le kǝyitǝkǝ wǝ. La ŋʊrʊ kǝ la maŋ kuleleeyǝ rɛ mǝ ne epipǝ. Wǝ leh mǝ ri zʊmarǝ rɛ mǝ rǝla asʊmatǝpǝ. Rǝ eniyǝ we lǝ mǝrǝ we, enyipǝ rɛ pǝ ka ŋ kaŋ otuyǝ yǝ la cɛkɛlɛ mǝ Dieceeceerǝ we. Fɛɛwǝ Yowanɛsɩ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ pǝ kǝ ŋ fǝ ŋ kpii pǝ lo okopiyǝ kǝ pǝ nya fɛɛ pǝ tɔ pǝ yaa rǝ lɔnuŋrǝ. La kaŋ pǝ kǝ́ pǝ láa taa awɛ pǝ fǝ wǝ, wǝ́ ŋ na lɛ ŋ ne ci ŋ na kaŋ kǝ pǝ ci asaŋ rǝ epǝ we pǝ ya pǝ láa kaŋ oturɔɔrɔɔyǝ sa lǝ kpǝŋ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-3</para>
  <para style="io">- Anʊkɔrǝyǝ mǝ kǝǝtaawǝ 1:4-11</para>
  <para style="io">- Eceenituturukǝ 1:12-13</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Ŋmǝ zʊmarǝ lo mumuŋyǝ ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa mǝ ŋ maŋ Kuleleyǝ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Dierǝ sa pǝ la tɛŋ rǝ fɛɛwǝ sa ǝkǝnǝŋ Kuleleyǝ we, wǝ leh mǝ ri zʊmarǝ, wǝ́ ne epipǝ we pǝ leh mǝ ri asʊmatǝpǝ.</char></note> we Worokoyǝ ŋ na saa ŋ na pɔrʊ wǝ mǝ ne epipǝ. Rǝ anʊkɔrǝyǝ we, ŋ́ náa taa nǝ kǝǝwǝ. Wǝ́ ŋkǝ ŋmǝ ceŋceŋ ko ŋ́ náa taa nǝ kǝǝwǝ, paa mǝŋ epǝ we kpǝlo pǝ cii anʊkɔrǝyǝ we ŋpǝ ŋkpɛ wǝ. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Duturǝ ɖi anʊkɔrǝyǝ yǝ kpii rǝ lǝh mǝrǝ, wǝ́ yǝ láa lɛ yǝ kpii yǝ kʊla mǝ lǝ kǝkpakǝkpa. <verse eid="2JN 1:2" /><verse number="3" style="v" sid="2JN 1:3" />Worokoyǝ we ŋ ri Tǝyǝ mǝ Yesu Kǝriso, yǝ we ŋ ri Piyǝ ŋ koonu Tǝyǝ we, pǝ yee lǝ lɛsiɛrɩwǝ, pǝ nyɩŋ lǝ tǝlarǝwǝ kǝ pǝ koonu lǝ wǝtaarǝkpǝ kǝ la nya fɛɛ le tii vɔrʊrǝ rǝ anʊkɔrǝyǝ mǝ kǝǝtaawǝ lǝ mǝrǝ.<verse eid="2JN 1:3" /></para>
  <para style="s">Anʊkɔrǝyǝ mǝ kǝǝtaawǝ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Kuleleyǝ, ŋ́ na nya faawǝ ŋpa mǝ kǝ́ ŋ́ na nyɩŋ lé epirɛɛpǝ pǝ ya pǝ lée tii vɔrʊrǝ rǝ anʊkɔrǝyǝ we mǝrǝ mǝŋ kǝ́ Tǝyǝ ŋ ne tíi lǝ wǝ kǝtǝ wǝ. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Rǝkǝsa we Kuleleyǝ, tuwǝ ŋ́ nǝh pǝ́ ŋ́ ru rǝ lá akaakǝ wǝ kaamǝ wǝ ǝnǝ: Kǝ la taa awɛ lǝ kǝǝwǝ. Wǝ lee ri seŋwɛŋyǝ rɛ wǝ́ ŋ́ ya ŋ́ náa ŋʊrʊ mǝ ŋ koonu lǝ́. Yǝ we pǝ kòonu lǝ ǝrǝ kǝsǝsǝŋkǝ ŋ lǝǝwe. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Kǝǝtaawǝ wǝ kaamǝ ǝkǝnǝŋ ŋlǝ le tii vɔrʊrǝ la saŋ rǝ Worokoyǝ le esepǝ. Wǝ́ seyǝ we nǝ cii ǝrǝ kǝsǝŋkǝ we, ŋwǝ ŋ kaamǝ ǝkǝnǝŋ ŋnǝ nǝ tii vɔrʊrǝ rǝ kǝǝtaawǝ mǝrǝ. <verse eid="2JN 1:6" /><verse number="7" style="v" sid="2JN 1:7" />Enyitǝǝnǝtǝpǝ pǝ la nya rǝ ǝrǝkǝ. Wǝ́ pǝ lǝ sǝ́ŋ pǝ lǝŋ lɔ pǝ nuŋ ǝkǝnǝŋ kǝceece Yesu Kǝriso lǝ pǝ ǝrǝkǝ sa mǝŋ nyɩmaasɩyǝ kǝtǝ. Saŋ rǝ ŋ wǝ tuwǝ sa wǝ́ yǝ láa nyɩŋ nyitǝǝnǝtǝyǝ mǝ yǝ we ŋ ri Kǝriso lǝ kǝǝkpǝlǝtǝyǝ yǝ ŋ ci wǝ. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Kǝto nǝ yee nǝ wɛ lo yurǝ, kǝ nǝ paa nya fɛɛ nǝ lǝǝrǝ lah anǝnɛyǝ lǝ ǝtǝnǝyǝ. Paa kǝ nǝ lɔ yǝlo wǝtoomwaraceeceekpǝ bomu. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Nyiyǝ lǝ yǝ ŋ nǝŋ nya ŋ kaŋ otuyǝ saŋ rǝ Kǝriso lo otukaŋyǝ, wǝ́ paa ŋ nǝ́ǝ fǝ otupʊŋpwayǝ mǝ ŋ kaŋ mǝ ŋ kʊla we, yǝ we ŋpǝ mǝ Worokoyǝ pǝ lǝǝ lǝ nyiceŋceŋ. Paa yǝ we ŋ náa kaŋ otuyǝ mǝŋ saŋ rǝ Yesu la anɛŋyǝ we, yǝ we ŋpǝ mǝ Tǝyǝ mǝ Piyǝ pǝ lǝ nyiceŋceŋ. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Mǝŋ rɛ lǝ pǝ nǝ kpǝŋ, wǝ́ ŋ nee re Yesu lo otukaŋyǝ sa ŋ pa kaŋ nǝ we, nǝ paa lɔ ŋwǝ, nǝ pee ce nǝ ceeni ŋwǝ. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Duturǝ ɖi yǝ we ŋ ne ceeni ŋwǝ we, we kʊla mǝ na anǝnɛrɔɔrɔɔyǝ we.<verse eid="2JN 1:11" /></para>
  <para style="s">Ecikaŋtuturukǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Ŋ́ tǝ ŋ́ lǝǝmǝ otuyǝ ŋpa ŋ́ née tíi nǝ. Paape ŋ́ nǝŋ ŋʊrʊ yǝ ŋ́ kpii rǝ kǝfwɛɛkǝ ŋ́ maŋ nǝ rǝ. Ŋ́ ya ŋ́ nǝ́ǝ rǝŋ ŋ́ pǝ pǝ nǝ kpǝŋ, kǝ ŋmǝŋmǝ ŋ pa tɛɛrɩ yǝ ŋ́ tíi nǝ niminimi, kǝ lah faawǝ wǝ nya fɛɛ wǝ to milimili. <verse eid="2JN 1:12" /><verse number="13" style="v" sid="2JN 1:13" />Lá paatɛyǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ le epipǝ pǝ lée ceeni lǝ́.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>