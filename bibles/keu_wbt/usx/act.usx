<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">Akebou: La BIBLE en Akebou</book>
  <para style="h">Anǝnɛyeeyǝ</para>
  <para style="toc3">Anǝ</para>
  <para style="toc2">Anǝnɛyeeyǝ</para>
  <para style="toc1">Enyikpiipǝ la anǝnɛyeeyǝ</para>
  <para style="mt1">Enyikpiipǝ la anǝnɛyeeyǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Kǝfwɛɛkǝ sa yǝ lóo pwo ǝkǝnǝŋ Enyikpiipǝ la anǝnɛyeeyǝ we, kǝ kaamǝ Luka la kǝfwɛɛyitǝkǝ ŋ na ŋʊrʊ wǝ. Kǝsǝsǝŋkǝ we kǝ kaamǝ Luka le dieceeceerǝ we ŋ na ŋʊrʊ wǝ. Ŋʊ̀rʊ wǝfwɛɛkpǝ sa wǝle wǝyi manǝ ne pwetaa Tofilǝ (Luka 1:1 mǝ Anǝnɛyeeyǝ 1:1). Wɛɛcátǝyǝ wǝ́ Luka ŋ ke ri.</para>
  <para style="ip">Rǝ kǝfwɛɛyitǝkǝ sa lǝ mǝrǝ we, Luka ya láa wɛɛlɩ mǝŋ ru rǝ kǝ́ Wɛɛkenikenirǝ ɖè Yesu lo otukarǝtǝsǝsǝŋpǝ we, wǝ́ pǝ nyà okopiyǝ pǝ tɛnɩ Yesu le Dieceeceerǝ we pǝ ka ŋ tɛlɩ. Pǝ tìe kǝnǝnɛkǝ sa rǝ Yerusalɛmǝ kpɛŋ, Yudeya mǝ Samaria la gaarǝ we fǝ ko ru ǝrǝ ǝrǝkǝ la kǝkpaakǝ (Luka 24:47-48 mǝ Anǝnɛyeeyǝ 1:8). Kǝfwɛɛkǝ sa kǝ la wɛɛlɩ kǝ lo ru rǝ kǝ́ wǝ yeli wǝ́ enyipǝ pǝ pǝlǝ pǝ ka ŋ siɛrɩ pǝ ŋ yee Ekǝrisotǝpǝ rǝ Oyudatǝpǝ mǝrǝ, wǝ́ pǝ ka ŋ ta pǝ ŋ kʊla ǝkǝ wǝ la pa siɛrɩ wǝ le yee lɔnuŋrǝ rǝ ǝrǝkǝ kpǝlo wǝ. Epǝ we pǝ lɔ̀ Yesu pǝ nunu wǝ́ pǝ sìimǝ na akʊŋyǝ we wǝ́ pǝ lóo pwo «Alɔnuŋtǝsǝsǝŋpǝ». Tuwǝ we wǝ lǝ kpuŋkpuruŋ rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ wǝ kaamǝ kǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ alɔnuŋtǝsǝsǝŋpǝ we rǝ Yerusalɛmǝ mǝ Paŋtekotǝyǝ le jirǝ we. Tǝ fǝ kʊla we, Wɛɛkenikenirǝ zʊ̀ʊ rǝ alɔnuŋtǝpǝ we pǝ lee ri Oyudatǝpǝ wǝ, mǝ eniyǝ we pǝ nunu Dieceeceerǝ wǝ, wǝ́ wǝ rili Oyudatǝpǝ lo mumuŋ. Ŋ wǝ tuwǝ sa wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ láa taa nyi ri ŋ nyi lǝ kǝǝwǝ mǝŋ kǝ́ ŋ naa lɛmɩ na Wɛɛkenikenirǝ ŋ yuu rɛ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io1">- Alɔnuŋtǝsǝsǝŋpǝ we la akpakaakǝ koonu ɖaŋsieriyǝ 1:1-26</para>
  <para style="io1">- Ɖaŋsieriyǝ rǝ Yerusalɛmǝ 2:1–8:3</para>
  <para style="io1">- Ɖaŋsieriyǝ rǝ Yudeya mǝ Samaria 8:4–12:25</para>
  <para style="io1">- Pɔlʊ la anǝnɛyeeyǝ 13:1–28:31</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Tofilǝ, rǝ mǝ kǝfwɛɛsǝsǝŋkǝ we lǝ mǝrǝ we, ŋ́ na ŋʊrʊ otuyǝ we Yesu ŋ ne yee mǝ eyǝ we ŋ na kaŋ kpǝlo kɩɩkɩ ŋ́ ne kpii, ru ǝrǝ yǝlǝ kǝsǝŋkǝ, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />po ru ǝrǝ eniyǝ we Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ rɛ̀ yulaarǝ wǝ. Pe kǝ Worokoyǝ ŋ pǝ fǝ Yesu ŋ rɛ yulaarǝ we, Yesu sanǝ rǝ Wɛɛkenikenirǝ lo okopiyǝ lo oŋuŋkǝ, wǝ́ ŋ kanǝ kǝ́ ne enyikpiipǝ we ŋ pɔ̀rʊ pǝ lée yee wǝ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Rǝ na gbɛŋrǝ la kǝmaakǝ we, pɔ̀rʊ na wɛ kanǝ ne enyikpiipǝ we rǝ wǝlǝkpǝ kpookpookpoo juu tǝniǝ, kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ kpii vɔrʊrǝ, wǝ́ ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ le wǝpilirikpǝ mǝ ŋ tíi pǝ. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Jirɛɛrǝ, kǝ́ ŋ tini ŋ née ri mǝŋ ŋpǝ we, wǝ́ ŋ cìi ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ paa pwɛyɩ rǝ Yerusalɛmǝ! Nǝ rǝŋ tuwǝ we Tǝyǝ ŋ cò garǝ wǝ. Wǝ lo oŋuŋkǝ wǝ́ ŋ́ na wɛɛlɩ ŋ́ ne tíi nǝ. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yowanɛsɩ wìiri enyipǝ lo worokomɛŋwǝ mǝ mɛŋwǝ. Paa, ŋnǝ we, rǝ ecipiyǝ rɛ mǝrǝ we, Worokoyǝ lǝ́ǝ fǝ Wɛɛkenikenirǝ ŋ wiiri nǝ worokomɛŋwǝ.»<verse eid="ACT 1:5" /></para>
  <para style="s">Yesu lah rɛ yulaarǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Jirɛɛrǝ kǝ́ Yesu mǝ no otukarǝtǝpǝ we pǝ lo po ku we, wǝ́ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, eniyǝ sa lǝ mǝrǝ wǝ́ a láa siɛnɩ mǝ wǝpilikpǝ we o koonu Isǝrayɛlǝ?» <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ laa hiaŋ kǝ nǝ ci eniyǝ we Tǝyǝ ŋwǝŋwǝ ŋ nǝ tǝnǝ rǝ no okopiyǝ wǝ. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Paa, vǝ́ Wɛɛkenikenirǝ la sʊʊ rǝ nǝ we, nǝ nyáa nya okopiyǝ kǝ nǝ ri mǝ araŋsielǝtǝpǝ rǝ Yerusalɛmǝ mǝ Yudeya kpǝlo kɩɩkɩ, mǝ Samaria koru ǝrǝ kǝtǝǝwǝ la kǝkpaakǝ». <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ ka ŋ rɛ yulaarǝ rǝ pǝle enimiyǝ, wǝ́ ŋ kolu ŋ nǝnǝ rǝ ŋɔɔrǝ rɛ lǝ mǝrǝ, pǝ lǝǝ tǝ pǝ nyɩŋ ŋwǝ. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Kǝ́ pǝ la tɔ enimiyǝ pǝ ya pǝ láa yɩrɩ kǝ́ Yesu ŋ náa rɛ yulaarǝ we, wǝ́ enyipǝ rɛ eyi pǝ le kpii wǝkpakpɛɛlɩkpǝ fuu pǝ pǝlǝ pǝ rù rǝ pǝ kǝtǝrǝceŋceŋ. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Agalileyatǝpǝ sa, kǝ́ kǝto wǝ́ nǝ nyo tumǝ nǝ yaa nǝ nyáa yɩrɩ yulaarǝ ǝnǝ? Yesuyǝ sa Worokoyǝ ŋ nǝ fǝ ŋ na pwɛyɩ rǝ nǝ mǝrǝ ŋ no ko yulaarǝ we, lǝ́ǝ tǝ ŋ siɛnɩ ŋ pǝ mǝŋ kǝ́ nǝ nya nyɩŋ ŋwǝ ŋ koh ko kǝtǝ.» <figure style="fig" alt="Jésus monte au Ciel" file="DN00497b.tif" size="col" copy="Darwin Dunham" ref="1:9">Yesu lo yulaarǝ la arɛɛkǝ</figure><verse eid="ACT 1:11" /></para>
  <para style="s">Enyikpiipǝ we lǝ kǝkpǝŋkǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Wǝ́ Yesu le enyikpiipǝ we pǝ pwɛ̀yɩ rǝ dutupipirǝ we pǝ lóo pwo Oliviepǝ lo dutupirǝ pǝ kǝ ŋ pǝ Yerusalɛmǝ. Fǝ rǝ we pǝ Yerusalɛmǝ we, wǝ lǝ́ǝ lǝ mǝŋ kpaarayǝ ceŋceŋ. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Kǝ́ pǝ le ke fii Yerusalɛmǝ we, wǝ́ pǝ ka ŋ rɛ ǝrǝ baŋsʊrʊyǝ we lo guŋuŋnɛŋkpǝ. Fɛɛwǝ we wǝ́ pǝ lée ce pǝ ŋ ku eni ri ŋ ni. Enyikpiipǝ we pǝ ka kaamǝ: Pɛtǝro, Yowanɛsɩ, Yakubu mǝ Aŋdǝre, Filipo mǝ Toma, Batelemi mǝ Matewu, Alǝfe le pi Yakubu, Sɩmɔyǝ we ŋ náa kɔŋ mǝ ŋ kuŋ nǝ tǝŋtǝǝwǝ mǝ Yakubu le pi Yuda. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Wǝ́ pǝlo kpǝlo pǝ yeli nyuŋceŋceŋ, wǝ́ pǝ tɔ̀ pǝ yàa rǝ nyuŋmwɛŋwǝ eni ri ŋ ni. Etiepǝ rɛ pǝ ka kʊla mǝ pǝ mǝŋ Yesu le lee Marɩya, mǝ Yesu la apaanʊpǝ.<verse eid="ACT 1:14" /></para>
  <para style="s">Pǝ la pɔrʊ Matiasɩ ŋ yaa Yuda lo yuwǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Jirɛɛrǝ kǝ́ pǝ lo po ku we, pǝ kǝ lǝ mǝŋ enyipǝ tuuru mǝ tiyi rǝ fɛɛwǝ we. Wǝ́ Pɛtǝro ŋ yili rǝ nǝ ǝtǝŋpǝ lǝ mǝrǝ wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«Lǝh ǝtǝŋ, wǝ kaamǝ kǝ dierǝ we Wɛɛkenikenirǝ la tɛŋ lǝ tǝnǝ rǝ wǝfwɛɛkenikenikpǝ lǝ mǝrǝ we, yee anǝnɛyǝ. Saŋ rǝ Davidǝ wǝ́ Wɛɛkenikenirǝ wɛ̀ɛlɩ ɖù rǝ Yuda, ŋwǝ yǝ we ŋ conu mǝ enyipǝ we pǝ pǝlǝ pǝ lɔ̀ Yesu wǝ». <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Ŋwǝ ŋkpɛ ka kʊla mǝ lǝ, wǝ́ ŋ kǝ lǝǝmǝ na kǝnǝnɛkǝ rǝ lǝh mǝrǝ. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />Ŋwǝ nyiyǝ sa yeli turɔɔrɔɔwǝ kǝ́ ŋ kòonu pǝ lɔ̀ Yesu wǝ. Wǝ́ ŋ fǝ̀ sɩkayǝ we pǝ mwàra ŋwǝ ŋ fùu kǝtǝǝwǝ. Atɛɛkǝ we lǝ mǝrǝ, wǝ́ ŋ rù ŋ pǝlǝ ŋ tɔ̀ɔ, wǝ́ na lɛrǝ nyàlǝ mǝŋ okuluyǝ saŋ. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Tuwǝ sa wǝ tò kpoo rǝ Yerusalɛmǝ. Wǝ kǝto pǝ lóo pwo kǝtǝǝwǝ we mǝ pǝlǝ kǝrǝkǝ ǝkǝnǝŋ «Akɛlǝdama». Wǝlo duturǝ ɖi «Ŋpǝrayǝ lǝ kǝtǝǝwǝ». <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />Pǝ la ŋʊrʊ rǝ Opusomǝpǝ la kǝfwɛɛkǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 1:20">«Na nyarǝwǝ wǝ taŋ aŋwaayǝ,</para>
  <para style="q1" vid="ACT 1:20">kǝ rɛ ŋ pee tii rǝ wǝlǝ mǝrǝ».<verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21-22" style="v" sid="ACT 1:21-22" />Kǝto wǝ kaamǝ kǝ la pɔrʊ nyiyǝ rɛ ceŋceŋ ŋ pa kʊla mǝ lǝ, kǝ ŋ ri ɖaŋsieyǝ ŋ ru rǝ Kulǝtǝyǝ Yesu lǝ ǝkpǝ́saanǝkǝ. Nyiyǝ we lée ri epǝ we pǝ ke ŋ siimǝ lǝ eni ri ŋ ni le ceŋceŋ, wǝ́ ŋ nyɩnɩ fǝ ǝrǝ kǝ́ Yowanɛsɩ ŋ wìiri Kulǝtǝyǝ Yesu lo worokomɛŋwǝ kǝ́ ŋ ke re lǝ ŋ ka ŋ tɛlɩ wǝ. Wǝ́ ŋ lɛ̀ ŋ nyɩnɩ fǝ ǝrǝ kǝ́ Yowanɛsɩ ŋ wìiri na mɛŋwǝ ko ro jirǝ we Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ rɛ̀ yulaarǝ wǝ.<verse eid="ACT 1:21-22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Wǝ́ pǝ pɔ̀rʊ enyi eyi pǝ pǝlǝ pǝ yàa: Yosɛfʊ mǝ Matiasɩ. Yosɛfʊ wǝ́ pǝ lóo pwo Basaba. Na jɛnyɩŋrǝ ɖi Yuso. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Wǝ́ kǝkpǝŋkǝ we kǝ mwɛnɩ nyuŋkpǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋlǝ́ e ci nyi ri ŋ nyi la ziɔŋrǝ wǝ. Kaŋ lǝ yǝ we a la saa a la pɔrʊ rǝ enyipǝ sa eyipǝ lǝ mǝrǝ, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />kǝ ŋ pe ri nyikpiiyǝ, kǝ mǝ ŋ yee kǝnǝnɛkǝ we Yuda ŋ màa ŋ tǝ̀nǝ, wǝ́ ŋ ko ŋ ko fɛɛwǝ wǝ kaamǝ ŋwǝ wǝ.» <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Wǝ́ pǝ cò eciiyǝ, wǝ́ wǝ tɔ̀ɔ rǝ Matiasɩ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kʊ̀la mǝ enyikpiitǝmǝceŋceŋpǝ we.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Wɛɛkenikenirǝ la sʊʊ rǝ Yesu lo otukarǝtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Kǝ́ Paŋtekotǝyǝ le jirǝ we lo ro we, wǝ́ Yesu lo otukarǝtǝpǝ we kpǝlo kɩɩkɩ pǝ tǝ pǝ kolu pǝ kù rǝ fɛɛwǝ we. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Kǝtǝrǝceŋceŋ, wǝ́ pǝ nunu tǝrɛ wǝ la kpaa wǝ lo ru rǝ yulaarǝ wǝ lǝ́ǝ pǝ mǝŋ ǝrǝfuŋmumuŋkǝ kǝtǝ. Wǝ́ wǝ tòo nyaarǝwǝ we pǝ ke tini kɩɩkɩ. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Rǝ kɔɔwǝ we, wǝ́ pǝ nyɩnɩ otuyǝ rɛ mǝŋ naawǝ lo wǝroŋfwɛɛkpǝ kǝtǝ. Wǝ́ wǝ sǝ̀pǝ wǝ tɛ̀ɛ rǝ nyi ri ŋ nyi. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Wǝ́ pǝlo kpǝlo pǝ lǝ̀ mǝ Wɛɛkenikenirǝ pwɩ. Wǝ́ pǝ ka ŋ wɛɛlɩ wǝrǝpʊŋpwakpǝ mǝŋ kǝ́ Wɛɛkenikenirǝ gòonu pǝ pǝ wɛɛlɩ kǝtǝ. <figure style="fig" alt="Les langues de feu sur les disciples" file="DN00498b.tif" size="col" copy="Darwin Dunham" ref="2:3">Wɛɛkenikenirǝ la sʊʊ rǝ Yesu lo otukarǝtǝpǝ mǝŋ naawǝ lo wǝroŋfwɛɛkpǝ kǝtǝ</figure><verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Oyudatǝpǝ we pǝ láa sʊma Worokoyǝ rǝ seyǝ, pǝ rù rǝ ǝkǝŋyǝ kpǝlo pǝ pǝlǝ pǝ ke kpii rǝ Yerusalɛmǝ rǝ eniyǝ we mǝrǝ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Kǝ́ enyipǝ pǝ lo nuŋ tuwǝ we wǝ la kpaa we, wǝ́ pǝ pǝlǝ pǝ kù sisi. Wǝ́ wǝ yeli pǝ yaa, duturǝ ɖi nyi ri ŋ nyi ko ŋ nuŋ otukarǝtǝpǝ we pǝ ya pǝ láa wɛɛlɩ ŋwǝŋwǝ nǝ kǝrǝkǝ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Wǝ́ wǝ rili pǝ lo mumuŋ, wǝ́ wǝ cà pǝla kpɛɛ. Wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Kǝto ŋpǝ enyipǝ sa pǝ ya pǝ láa wɛɛlɩ wǝǝ, mǝŋkǝ Agalileyatǝpǝ wǝ́ pǝ ri?» <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Wǝ le yee nɛ, wǝ́ nyi ri ŋ nyi rǝ lǝh mǝrǝ ŋ ya ŋ nóo nuŋ pǝ ya pǝ láa wɛɛlɩ nǝ kǝrǝkǝ wǝ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Aparǝtiatǝpǝ, Emediatǝpǝ, Elamǝtǝpǝ, epǝ we pǝ lo ru rǝ Mezopotami, Yudeya mǝ Kapadɔ, Pɔŋto mǝ Azi, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Fǝrizi mǝ Paŋfili, Ejipǝte mǝ Libi la kǝtakǝ we kǝ maarǝ mǝ Sirɛnǝ. Enyirɛɛpǝ pǝ rù rǝ Roma, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />mǝŋ Akǝrɛtǝtǝpǝ, mǝŋ Arabiatǝpǝ, mǝŋ Oyudatǝpǝ, mǝŋ enyipǝ we pǝ la siɛrɩ pǝla wɛ pǝ le yee Oyudatǝpǝ pǝ láa saŋ rǝ Mose le seyǝ wǝ. Loh kpǝlo la ya yǝ lóo nuŋ pǝ ya pǝ láa wɛɛlɩ mǝ lǝh wǝrǝkpǝ pǝ ŋ ru rǝ Worokoyǝ lo otumumuŋyǝ ŋ ne yee wǝ. <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Wǝ́ tuwǝ sa wǝ rili pǝ lo mumuŋ. Pǝ lǝǝ kǝ tǝ pǝ ci kǝ́ pǝ láa tɛŋ, wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Tuwǝ sa lo duturǝ ɖi nɛ?» <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Wǝ́ enyirɛɛpǝ pǝ ka ŋ mɔɔnʊ pǝ ǝkǝnǝŋ: «Pǝ lo ŋuŋ ǝfǝŋraŋpǝ pǝ le piemu pǝ la lɛ».<verse eid="ACT 2:13" /></para>
  <para style="s">Pɛtǝro ya láa wɛɛlɩ mǝ ŋ tíi kǝkpǝŋkǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Wǝ́ Pɛtǝro ŋ yili ŋ yàa ŋpǝ mǝ enyikpiitǝmǝceŋceŋpǝ we, wǝ́ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ Oyudatǝpǝ, mǝ ŋnǝ enyipǝ sa kpǝlo nǝ nyǝ pǝ nǝ kpii rǝ Yerusalɛmǝ, nǝ nuŋ tuwǝ sa wǝ ya wǝ lǝ́ǝ pǝ nǝ ci sɩsiɛrɩ, kǝ nǝ co kǝtukoŋkǝ rǝ dierǝ sa ŋ́ náa tɛŋ wǝ! <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Ŋkǝ ǝfǝŋpǝ wǝ́ enyipǝ sa pǝ lo ŋuŋ pǝ le piemu, mǝŋ kǝ́ nǝ ya nyáa tɛŋ wǝ kǝtǝ. Duturǝ ɖi, le ci ekpii rǝ ɖokoŋpirǝ le eniyǝ faŋceŋceŋ lǝ mǝrǝ rǝ. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Paa tuwǝ we worokokpɛɛnuŋtɛŋtǝyǝ Yowɛlɩ ŋ tɛnɩ we, wǝ ya wǝ lǝ́ǝ pǝ ǝnǝ.<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />Tɛnɩ ǝkǝnǝŋ: “Worokoyǝ la tɛŋ we, rǝ ecituturuyǝ lǝ mǝrǝ we,</para>
  <para style="q1" vid="ACT 2:17">ŋ́ náa maa mǝ Wɛɛrǝ zʊʊ rǝ nyi ri ŋ nyi.</para>
  <para style="q1" vid="ACT 2:17">Nǝ ǝpǝrǝŋpipǝ mǝ nǝ etiepipǝ pǝ láa siɛrɩ pǝ yee mǝ akpɛɛnuŋtɛŋtǝpǝ.</para>
  <para style="q1" vid="ACT 2:17">Nǝ okosopipǝ mǝ nǝ akɔsɔkɔrʊpǝ pǝ lah mǝ nyɩŋ mǝ otupɔrʊkaŋyǝ.</para>
  <para style="q1" vid="ACT 2:17">Ŋ́ noh mǝ co nǝ onyumupǝ mǝ nǝ etiekurupǝ la wǝtʊkpɛɛkpǝ.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Kǝceece, rǝ ŋyǝ eciyǝ we lǝ mǝrǝ we,</para>
  <para style="q1" vid="ACT 2:18">ŋ́ náa maa mǝ Wɛɛrǝ zʊʊ rǝ mǝ asʊmatǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ,</para>
  <para style="q1" vid="ACT 2:18">kǝ pǝ ŋ nuŋ mǝ kpɛɛwǝ pǝ ŋ tɛŋ.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Ŋ́ née yee otumumuŋyǝ rǝ oŋuŋkǝ rǝ yulaarǝ,</para>
  <para style="q1" vid="ACT 2:19">mǝ otucovurǝ rǝ pɔɔlʊwǝ rǝ kǝtǝǝwǝ,</para>
  <para style="q1" vid="ACT 2:19">ŋpǝrayǝ, naawǝ mǝ nuŋmumuŋrǝ.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Cɔkɔŋyǝ láa siɛrɩ nuŋtumuwǝ, kǝ kɛɛnyɔŋyǝ ŋ siɛrɩ ŋpǝrayǝ,</para>
  <para style="q1" vid="ACT 2:20">kpɛŋ kǝ Ǝtǝ Woroko le jirǝ ji oro, jimumuŋrǝ we mǝ jikpatɩrǝ we.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Paa, yǝ we ŋ nóo pwo Ǝtǝ Woroko la nyɩŋrǝ we, láa nya alɔkuŋkǝ.”»<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />Wǝ́ Pɛtǝro ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ, lǝh ǝtǝŋ Isǝrayɛlǝtǝpǝ, nǝ nuŋ dierǝ sa ŋ́ nah tɛŋ ŋ́ tíi nǝ wǝ: «Worokoyǝ la pɔrʊ yǝ we Yesu ŋ no ru rǝ Nazarɛtǝ ŋ ri la kaŋ nǝ. Saŋ rǝ ŋwǝ Yesu wǝ́ Worokoyǝ ŋ ne yee otucovurǝ mǝ otumumuŋyǝ rǝ nǝ enimiyǝ, mǝŋ kǝ́ ŋnǝŋnǝ nǝ cii wǝ kǝtǝ. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Ŋwǝ nyiyǝ sa, wǝ́ nǝ nyàrǝ nǝ cò nǝ kòonu epǝ we pǝ lee ci Worokoyǝ. Wǝ́ pǝ kpàa ŋwǝ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ, wǝ́ ŋ kpǝ̀, mǝŋ kǝ́ Worokoyǝ ŋ ke cìi wǝ ŋ còonu, wǝ́ ŋ tɛnɩ wǝ ŋ tǝ̀nǝ kǝtǝ. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Paape Worokoyǝ la pɔrʊ ŋwǝ lo ru rǝ gbɛŋrǝ lo vuurǝ lǝ mǝrǝ, wǝ́ ŋ na saanǝ ŋwǝ. Duturǝ ɖi gbɛŋrǝ lǝǝ lǝmǝ okopiyǝ láa lɔ ŋwǝ dǝnǝ. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Wǝ kǝto Davidǝ ŋ na wɛɛlɩ ŋ no ru rǝ Yesu ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 2:25">“Ŋ́ ka ŋ nyɩŋ Kulǝtǝyǝ rǝ mǝ enimiyǝ eni ri ŋ ni.</para>
  <para style="q1" vid="ACT 2:25">Kpiikǝ ŋ yaa rǝ mǝ kǝnirisiɛɛkǝ</para>
  <para style="q1" vid="ACT 2:25">kǝto ŋ́ nǝŋ tɔɔ.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Wǝ kǝto ŋ́ ya ŋ́ náa nya faawǝ ŋpa rǝ mǝ mǝrǝ mǝ ŋ nɔŋ.</para>
  <para style="q1" vid="ACT 2:26">Ŋ́ ke ce ŋ́ kpǝ́ we, ŋ́ nah ka kpɛɛ mǝ ŋ wɛɛ mǝ ǝrǝŋkǝ.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />A lǝŋ pa maa mǝ o co rǝ akpɛŋtɛkǝ,</para>
  <para style="q1" vid="ACT 2:27">wǝ́ a lǝŋ pa lɛ a maa lé nyikenikeniyǝ ŋ yɛɛlɩ ŋ co rǝ wǝfuŋkpǝ mǝrǝ.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />A la kaŋ mǝ vɔrʊrǝ la akʊŋyǝ.</para>
  <para style="q1" vid="ACT 2:28">Kǝ́ wǝ ri e kpii a kʊla mǝ mǝ we, ŋ́ náa mǝ nya faawǝ eni ri ŋ ni.”»<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />Wǝ́ Pɛtǝro ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Lǝh ǝtǝŋ apaanʊpǝ, nǝ maa kǝ ŋ́ tíi nǝ dierǝ sa sɩsiɛrɩ, lǝh tǝtǝ Davidǝ kpǝ̀, wǝ́ pǝ ŋwàa ŋwǝ, no vuŋtɔŋrǝ yaa po ro ruŋruŋ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Kpiikǝ ŋ ke ri worokokpɛɛnuŋtɛŋtǝyǝ, wǝ́ ŋ ke cii wǝ ǝkǝnǝŋ Worokoyǝ lo tu le tíi ŋwǝ ǝkǝnǝŋ: “Ŋ́ nǝ́ǝ fǝ lé pilepiyǝ rɛ ŋ́ tiini wǝpilikpǝ”. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Wǝ kǝto Davidǝ ŋ nyɩnɩ Kǝriso lǝ ǝkpǝ́kǝ mǝ na asaanǝkǝ ŋ còonu wǝǝ. Ŋwǝ wǝ́ ŋ ke reemǝ kǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Worokoyǝ laa maa ŋwǝ ŋ co rǝ akpɛŋtɛkǝ, wǝ́ ŋ naa maa ŋwǝ ŋ yɛɛlɩ ŋ co rǝ wǝfuŋkpǝ mǝrǝ”. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Yesuyǝ sa we, Worokoyǝ la saanǝ ŋwǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ, wǝ́ loh kpǝlo yǝ la nyɩŋ ŋwǝ mǝ leh enimiyǝ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Worokoyǝ la rɛɛrɩ mǝ ŋwǝ, wǝ́ ŋ ne tiini ŋwǝ rǝ ne kǝnirisiɛɛkǝ. Rǝkǝsa la lɔ Wɛɛkenikenirǝ we Tǝyǝ ŋ cò lǝ garǝ wǝ. Ŋrǝ wǝ́ ŋ na maa la sʊʊ rǝ lǝ mǝŋ kǝ́ nǝ ya nǝ nyáa nyɩŋ wǝ, wǝ́ nǝ ya nǝ nyóo nuŋ wǝ kǝtǝ wǝ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Davidǝ laa rɛ yulaarǝ, paape ŋwǝŋwǝ la tɛŋ ǝkǝnǝŋ: “Kulǝtǝyǝ le tíi mǝ kulǝtǝyǝ ǝkǝnǝŋ: Sɔ e tii rǝ mǝ kǝnirisiɛɛkǝ, <verse eid="ACT 2:34" /><verse number="35" style="v" sid="ACT 2:35" />po ro eniyǝ ŋ́ nǝ fǝ lǝ́ ǝkǝǝkpǝlǝtǝpǝ ŋ́ kpii lǝ́ rǝ lá akparǝyǝ lǝ kǝnǝŋkǝ.” <verse eid="ACT 2:35" /><verse number="36" style="v" sid="ACT 2:36" />Wǝ kaamǝ rǝkǝsa kǝ Isǝrayɛlǝtǝpǝ kpǝlo pǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ: Worokoyǝ lǝ fǝ Yesuyǝ sa nǝ nya kpaa nǝ nya maarǝ rǝ kpɛtɛkpǝlɛciiwǝ, le yee Kulǝtǝyǝ mǝ Lɔkuŋtǝyǝ.»<verse eid="ACT 2:36" /></para>
  <para style="s">Enyipǝ lafawǝ ta pǝ la lɔ Yesu pǝ lo nuŋ rǝ kǝyaakǝ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Kǝ́ pǝ lo nuŋ dierǝ sa we, wǝ́ wǝ yeli pǝ la tǝrɛ ŋpa, wǝ́ pǝ kǝ ŋ pǝ́ Pɛtǝro mǝ nǝ ǝtǝŋenyikpiituturupǝ we ǝkǝnǝŋ: «Lǝh ǝtǝŋ, rǝkǝsa nɛ wǝ́ yǝ lée yee?» <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />Wǝ́ Pɛtǝro ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ siɛrɩ nǝ vɔrʊrǝ! Nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ kuŋ kǝ pǝ wiiri no worokomɛŋwǝ rǝ Yesu Kǝriso la nyɩŋrǝ, kǝ Worokoyǝ ŋ fǝ nǝ oturɔɔrɔɔyǝ ŋ cɛɛ nǝ, kǝ ŋ koonu nǝ Wɛɛkenikenirǝ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Duturǝ ɖi Worokoyǝ la tɛŋ ǝkǝnǝŋ ŋ nǝ́ǝ fǝ Wɛɛkenikenirǝ ŋ koonu nǝ, nǝ epipǝ mǝ epǝ we pǝ kpii rǝ wǝlǝǝrǝkpǝ, kǝkpǝŋmumuŋkǝ we Kulǝtǝyǝ loh Worokoyǝ ŋ noh po pwo wǝ.»<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Wǝ́ Pɛtǝro ŋ tǝ ŋ wɛ̀ɛlɩ ŋ tìi pǝ le etiepʊŋpwayǝ ŋpa. Wǝ́ ŋ rili ɖaŋsieyǝ ŋ tìi pǝ, wǝ́ ŋ cìi ŋ kanǝ pǝ ŋ tà pǝlo turuwǝ ǝkǝnǝŋ: «Nǝ pɔrʊ nǝ wɛ nǝ ru rǝ ruŋruŋ le nyikpǝŋrɔɔrɔɔrǝ sa lǝ mǝrǝ kǝ Worokoyǝ ŋ lɔ ŋ koonu nǝ».<verse eid="ACT 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 2:41" />Epǝ we pǝ lɔ̀ Pɛtǝro le dierǝ pǝ nunu jirǝ we we, pǝ lǝ́ǝ lǝ mǝŋ lafawǝ ta, wǝ́ pǝ wìiri pǝ lo worokomɛŋwǝ. Wǝ́ Kulǝtǝyǝ ŋ lɔ̀ pǝ ŋ kʊ̀la mǝ alɔnuŋtǝpǝ lǝ kpǝŋwǝ.<verse eid="ACT 2:41" /></para>
  <para style="s">Alɔnuŋtǝsǝsǝŋpǝ we la vɔrʊrǝ</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />Alɔnuŋtǝpǝ we pǝ tɔ̀ pǝ yàa, wǝ́ pǝ ko ŋ co kǝtukoŋkǝ rǝ enyikpiipǝ we lo otukaŋyǝ eni ri ŋ ni. Pǝ kǝ lǝ nyuŋceŋceŋ, pǝ ke ŋ ri fɛɛceŋceŋ, wǝ́ pǝ ka ŋ nyɩɩ pǝ ŋ mwɛŋ nyuŋkpǝ. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />Wǝ́ vurǝ vìi nyi ri ŋ nyi rǝ otumumuŋyǝ mǝ otucovurǝ Worokoyǝ ŋ ke ŋ yee mǝ ŋ saŋ rǝ enyikpiipǝ we lo oŋuŋkǝ. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Alɔnuŋtǝpǝ we kpǝlo pǝ kǝ lǝ nyuŋceŋceŋ. Wǝ́ pǝ lee ke ŋ kpii wǝsǝpǝkpǝ rǝ pǝlo otulǝmǝyǝ. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Pǝ ke ŋ siiri pǝlo otulǝmǝyǝ, ǝ pǝ ŋ fǝ sɩkayǝ we pǝ la nya pǝ sǝpǝ awɛ, yǝ ri ŋ yǝ kǝ́ wǝ lóo ro ŋwǝ wǝ. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Pǝ ko ŋ ku ji ri ŋ ji rǝ Worokoyǝ la nyarǝwǝ. Pǝ ka ŋ wasa wɛɛwǝ pǝ ŋ ri rǝ awɛ la anyarǝyǝ mǝ faawǝ, rǝ nyuŋceŋceŋkpǝ lǝ mǝrǝ. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Alɔnuŋtǝpǝ we pǝ ka ŋ nɔŋ pǝ ŋ kǝ Worokoyǝ, wǝ́ enyipǝ kpǝlo pǝ ka ŋ taa pǝ lǝ kǝǝwǝ. Wǝ́ Kulǝtǝyǝ ŋ ko ŋ kuŋ enyipǝ pǝ ŋ siɛrɩ wɛɛwǝ ji ri ŋ ji, wǝ́ alɔnuŋtǝpǝ we lǝ kǝkpǝŋkǝ kǝ ka ŋ ta kǝ ŋ kʊla. <figure style="fig" file="GPS_Pentecost B&amp;W.tif" size="col" loc="2:9-11" ref="2:47" /><verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Pɛtǝro mǝ Yowanɛsɩ pǝ la cá sǝŋyǝ rɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Jirɛɛrǝ wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ ko ŋ ko Worokoyǝ la nyarǝwǝ pǝ ka mwɛŋ nyuŋkpǝ. Anyɩŋ wǝ la ca ɖiɔrǝ le eniyǝ ta. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Nyiyǝ rɛ ke ri sǝŋyǝ ǝrǝ kǝ́ pǝ mǝnǝ ŋwǝ wǝ. Wǝ́ pǝ rè ŋwǝ pǝ pǝlǝ pǝ tǝ̀nǝ rǝ Worokoyǝ la nyarǝwǝ lo guŋpolurɛɛrǝ, ɖǝ we pǝ lóo pwo «Jeeceerǝ» wǝ. Pǝ ke ŋ re nyiyǝ sa pǝ ŋ pǝ ji ri ŋ ji kǝ ŋ nya fɛɛ mǝ ŋ ria epǝ we pǝ leh fii gukpǝ we lo otuyǝ. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Kǝ́ sǝŋyǝ sa ŋ na nyɩŋ Pɛtǝro mǝ Yowanɛsɩ pǝ la tɛlɩ pǝ leh fii gukpǝ we we, wǝ́ ŋ ka ŋ ria pǝ la sɩkayǝ. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ yà pǝ ka ŋ yɩrɩ ŋwǝ pʊrɩpʊrɩ, wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yɩrɩ lǝ ree!» <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Kǝceece wǝ́ ŋ yà ŋ ka ŋ yɩrɩ pǝ mǝ kpɛɛtɛɛwǝ ǝkǝnǝŋ pǝ lóo koonu na tǝrɛ. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝǝ lǝmǝ sɩka ŋ́ nóo koonu lǝ́. Paa tuwǝ we ŋ́ lǝǝmǝ we ŋ́ nóo koonu lǝ́ wǝ. Rǝ Yesu Kǝriso Nazarɛtǝtǝpiyǝ la nyɩŋrǝ we, yi a yaa kǝ a mǝ saŋ.» <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Wǝ́ Pɛtǝro ŋ tà sǝŋyǝ sa le kǝnirikǝ, wǝ́ ŋ yìili ŋwǝ ŋ yàa. Wǝ́ na akparǝyǝ mǝ na fɛɛtoŋatɛrɛmɩyǝ yǝ sàanǝ kǝtǝrǝceŋceŋ. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Wǝ́ ŋ kpà ŋ yili ŋ yàa, wǝ́ ŋ tìe asaŋkǝ. Wǝ́ ŋ tɛ̀ɛmǝ Pɛtǝro mǝ Yowanɛsɩ ŋ fìi Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ ka ŋ saŋ mǝ ŋ kpa mǝ ŋ yi wǝ́ ŋ ka ŋ nɔŋ mǝ ŋ kǝ Worokoyǝ. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Wǝ́ kǝkpǝŋkǝ kpǝlo kǝ nyɩnɩ ŋwǝ ya láa saŋ, wǝ́ ŋ ya ŋ náa nɔŋ mǝ ŋ kǝ Worokoyǝ. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Kǝ́ pǝ la nyɩŋ wǝ pǝ le ci ǝkǝnǝŋ sǝŋyǝ we ŋ ke ŋ tii rǝ guŋpolurǝ we pǝ lóo pwo jeeceerǝ mǝ ŋ ria otuyǝ ŋ lǝǝwe we, wǝ́ wǝ rili pǝ lo mumuŋ, wǝ́ pǝ fìi vurǝ rǝ tuwǝ we pǝ le yee pǝ lo koonu ŋwǝ kǝto. <verse eid="ACT 3:10" /><verse number="11" style="v" sid="ACT 3:11" />Kǝ́ pǝ la nyɩŋ nyiyǝ sa ŋ naa ya ŋ náa waarǝ mǝ Pɛtǝro mǝ Yowanɛsɩ we, wǝ́ wǝ cò kǝkpǝŋkǝ we lo vurǝ, wǝ́ pǝ sùu pǝ kolu pǝ tùu pǝ rǝ fɛɛlǝwǝ we pǝ lóo pwo Salomo la fɛɛlǝwǝ.<verse eid="ACT 3:11" /></para>
  <para style="s">Pɛtǝro la wɛɛlɩ le tíi kǝkpǝŋkǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 3:12" />Kǝ́ Pɛtǝro ŋ na nyɩŋ nyikpǝŋwǝ sa we, wǝ́ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ Isǝrayɛlǝtǝpǝ, kǝ́ kǝto wǝ́ tuwǝ sa wǝ lée ri nǝ mumuŋ wǝ? Kǝ́ kǝto wǝ́ nǝ ya nǝ nyáa yɩrɩ lǝ pʊrɩpʊrɩ ǝnǝ? Nǝ ya nǝ nyǝ́ǝ kǝ wǝ ǝkǝnǝŋ loh okopiyǝ amaa lah akʊʊkǝ rǝ Worokoyǝ le enimiyǝ kǝto wǝ́ nyiyǝ sa ŋ ya ŋ náa saŋ wǝ?» <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Abǝrahamǝ lo Worokoyǝ, Isakǝ lo Worokoyǝ, Yakɔbǝ lo Worokoyǝ mǝ lǝh ǝtǝtǝpǝ lo Worokoyǝ la rɛɛrɩ mǝ na sʊmatǝyǝ Yesu. Ŋwǝ Yesuyǝ sa wǝ́ nǝ fǝ̀ nǝ kpìi enyipǝ rǝ akaakǝ, kǝ pǝ wʊ ŋwǝ. Wǝ́ nǝ nyǝ sǝ́ŋ ŋwǝ nǝ nyo co rǝ Pilato le enimiyǝ, kaŋfɩ ŋwǝ pǝ̀ ŋ nyarǝ Yesu ŋ co. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Nǝ nyǝ sǝ́ŋ Yesu, nyikenikeniyǝ sa mǝ nyikʊʊyǝ sa, wǝ́ paa nǝ nye tíi Pilato ŋ nyarǝ nyiwʊʊlʊtǝyǝ ŋ co. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Wǝ́ nǝ nyo kuŋ pǝ la wʊ Yesuyǝ sa ŋ nóo koonu vɔrʊrǝ. Paape Worokoyǝ la saanǝ ŋwǝ. Wǝ́ le ri wǝla araŋsielǝtǝpǝ. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Yesu la nyɩŋrǝ, mǝ kǝ́ yǝ la lɔ ŋrǝ nyɩŋrǝ sa yǝ lo nuŋ we, wǝ lo kuŋ nyiyǝ sa nǝ cii, wǝ́ nǝ ya nyáa nyɩŋ ŋ no koru asaŋ wǝ. Lah alɔnuŋkǝ rǝ Yesu wǝ lo kuŋ nyiyǝ sa ŋ na kpaa purupuru ŋ ya rǝ nǝ enimiyǝ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />Rǝkǝsa we lǝh ǝtǝŋ, ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ ŋnǝ mǝ nǝ omumuŋpǝ nǝ nyee ke ci rǝ kǝto, wǝ́ nǝ yeli mǝ Yesu lo tuwǝ sa. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Paa tuwǝ we Worokoyǝ ŋ tɛnɩ ŋ tǝ̀nǝ ǝrǝ gakarǝ saŋ rǝ akpɛɛnuŋtɛŋtǝpǝ kpǝlo lo nyuŋkpǝ we, wǝ lǝ pǝ ǝnǝ. Tɛnɩ ǝkǝnǝŋ Lɔkuŋtǝyǝ láa cʊʊrʊ. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Kǝto nǝ siɛrɩ nǝ wɛ, kǝ nǝ siɛnɩ nǝ pǝ Worokoyǝ lǝ kpǝŋ, kǝ ŋ nya fɛɛ ŋ siɛ nǝ oturɔɔrɔɔyǝ. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Eniyǝ we Kulǝtǝyǝ lóo kuŋ kǝ wǝtaarǝkpǝ le eniyǝ yǝ pǝ yǝ koonu nǝ, kǝ ŋ lɛ ŋ fǝ Lɔkuŋtǝyǝ we ŋ na pɔrʊ ŋ nǝ tǝnǝ ǝrǝ kǝsǝŋkǝ ŋ maŋ nǝ, ŋwǝ ŋ kaamǝ Yesu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Ŋwǝ Yesuyǝ sa lée ce ŋ tii rǝ yulaarǝ ko ro jirǝ we Worokoyǝ ŋ nóo toolu tu ri ŋ tu ŋ lɛ, mǝŋ kǝ́ na akpɛɛnuŋtɛŋtǝkenikenipǝ pǝ la tɛŋ wǝ pǝ lǝ tǝnǝ ǝrǝ gakarǝ kǝtǝ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Kǝceece Mose tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko lǝ́ǝ fǝ kpɛɛnuŋtɛŋtǝyǝ rɛ mǝŋ ŋmǝ kǝtǝ ŋ maŋ nǝ. Lóo ru rǝ nǝ mǝrǝ. Tu ri ŋ tu ŋ nah mǝ tɛŋ mǝ ŋ tíi nǝ we, nǝ nuŋ wǝ. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Paa yǝ we ŋ nǝ́ǝ sǝ́ŋ ŋ nǝŋ nuŋ kpɛɛnuŋtɛŋtǝyǝ sa le dierǝ we, pǝ láa pɔrʊ ŋwǝ pǝ cɛ rǝ Worokoyǝ lǝ kǝkpǝŋkǝ mǝrǝ, kǝ pǝ wʊ ŋwǝ.» <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Oworokokpɛɛnuŋtɛŋtǝpǝ kpǝlo, fǝ rǝ Samiɛlɩ mǝ pǝ, pǝ la wɛɛlɩ rǝ tɛɛ rǝ tɛɛ pǝ lo ru rǝ otuyǝ sa yǝ ya yǝ lǝ́ǝ pǝ rǝ eciyǝ sa lǝ mǝrǝ wǝ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Tuwǝ we Worokoyǝ ŋ na tɛŋ ŋ nǝ tǝnǝ saŋ rǝ na akpɛɛnuŋtɛŋtǝpǝ we, wǝ ri nǝ nɛŋ. Wǝ́ dierǝ we ŋ pàrǝ mǝ nǝ ǝtǝtǝpǝ ŋ tǝ̀nǝ we, ŋrǝ ŋkpɛ ɖi nǝ nɛŋ. Tìi Abǝrahamǝ ǝkǝnǝŋ: «Ŋ́ náa pɛɛrɩ wǝkpǝŋkpǝ kpǝlo rǝ kǝtǝǝwǝ saŋ rǝ lǝ́ wǝmǝkpǝ». <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Nǝ kpǝŋ wǝ́ Worokoyǝ ŋ ne kpii na sʊmatǝyǝ ŋ pǝ kpɛŋ. Le kpii ŋwǝ ŋ pa pɛɛrɩ nǝ, kǝ ŋ kuŋ nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ wɛɛ mǝ no oturɔɔrɔɔyǝ.<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Pǝ lo pwo Pɛtǝro mǝ Yowanɛsɩ rǝ Oyudatǝpǝ lo omumuŋpǝ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Eniyǝ we Pɛtǝro mǝ Yowanɛsɩ pǝ tǝ pǝ yà pǝ ka ŋ wɛɛlɩ pǝ ŋ tíi kǝkpǝŋkǝ we, wǝ́ Otoolutǝpǝ, epǝ we pǝ lǝ́ǝ rǝŋ Worokoyǝ la nyarǝwǝ lo mumuŋyǝ mǝ Asadukitǝpǝ, pǝ pǝlǝ pǝ rù rǝ pǝ. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Kǝ́ pǝ la nyɩŋ Pɛtǝro mǝ Yowanɛsɩ pǝ ya pǝ láa kaŋ kǝkpǝŋkǝ lo otuyǝ ǝkǝnǝŋ Worokoyǝ la saanǝ Yesu, kǝto enyiǝtǝpǝ ŋpee pǝ kpii pǝ lǝ́ǝ pǝ pǝ pa saanǝ we, wǝ́ wǝ fìi pǝ. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Wǝ́ pǝ lɔ̀ Pɛtǝro mǝ Yowanɛsɩ. Kǝ́ ǝrǝkǝ kǝ ka ŋ cɩɩ kǝto wǝ́ pǝ tanǝ pǝ ǝrǝ gaalǝǝrǝkǝ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Wǝ́ kǝkpǝŋkǝ we kǝ yà kǝ ko ŋ nuŋ Pɛtǝro mǝ Yowanɛsɩ le etieyǝ we la kǝtamumuŋkǝ kǝ lɔ̀ kǝ nunu. Pǝlo kuruyuwǝ wǝ lǝ́ǝ lǝ mǝŋ lafawǝ tʊʊ. <verse eid="ACT 4:4" /><verse number="5" style="v" sid="ACT 4:5" />Galǝǝrǝkǝ wǝ́ Oyudatǝpilipǝ, Oyudatǝpǝ lo omumuŋpǝ mǝ Esekaŋtǝpǝ pǝ pǝlǝ pǝ kù rǝ Yerusalɛmǝ.<verse eid="ACT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 4:6" />Enyipǝ we pǝ kù pǝ ke tini pǝ kaamǝ toolutǝmumuŋyǝ we pǝ loo pwo Ana, Kayifa, Yowanɛsɩ, Alɛsaŋto mǝ otoolutǝmumuŋpǝ la nyarǝwǝ kpǝlo. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Wǝ́ pǝ kpìi pǝ kolu pǝ fǝ̀ Pɛtǝro mǝ Yowanɛsɩ pǝ pǝlǝ pǝ la kǝnyɩŋkǝ. Wǝ́ pǝ pǝ̀ pǝ ǝkǝnǝŋ: «Saŋ rǝ okopiyǝ rǝ fǝŋ amaa saŋ rǝ ǝlǝ la nyɩŋrǝ wǝ́ nǝ nya cá nyiyǝ sa wǝ?» <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ Pɛtǝro wǝ́ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />«Epilipǝ mǝ Oyudatǝpǝ lo omumuŋpǝ, yǝ le yee sǝŋyǝ rɛ le wǝceeceekpǝ, wǝ́ ruŋruŋ le jirǝ nǝ ya nǝ nyǝ́ǝ pǝ́ lǝ ǝkǝnǝŋ wǝ le yee wǝ la saŋ nɛ wǝ́ nyiyǝ sa ŋ na kpaa wǝ! <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Nǝ kpǝlo nǝ ci wǝ, kǝ Isǝrayɛlǝtǝpǝ kpǝlo pǝ ci wǝ ǝkǝnǝŋ saŋ rǝ Yesu Kǝriso Nazarɛtǝtǝpiyǝ la nyɩŋrǝ kǝto wǝ́ sǝŋyǝ sa ŋ na kpaa purupuru ŋ yaa rǝ nǝ kǝnyɩŋkǝ. Ŋwǝ Yesuyǝ sa wǝ́ nǝ nyáa kpaa nǝ nya maarǝ rǝ kpɛtɛkpǝlɛciiwǝ, paape Worokoyǝ la saanǝ ŋwǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Ŋwǝ Yesuyǝ sa ŋ ri ɖurǝ we ŋnǝ okumarǝtǝpǝ nǝ nyǝ sǝ́ŋ nǝ nyo co. Ŋrǝ ɖurǝ sa la pa siɛrɩ le yee yusirurǝ ɖe gukpǝ wǝ. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Ŋwǝ ceŋceŋ ko ŋ nóo koru apɔrʊ lǝ, duturǝ ɖi rǝ ǝrǝkǝ kpǝlo Worokoyǝ lǝǝ tǝ ŋ koonu nyipʊŋpwayǝ rɛ ŋ nóo koru alɔ ŋ koonu lǝ wǝ.»<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Pɛtǝro mǝ Yowanɛsɩ pǝ lee ke ci kǝfwɛɛkǝ, wǝ́ pǝ laa lɛ pǝ ru okuruyǝ rǝ enyipǝ le enimiyǝ, paape kǝ́ pǝ ya pǝ láa wɛɛlɩ mǝ turutawǝ we, wǝ́ wǝ rili akpaŋtɛŋtǝpǝ we lo mumuŋ. Wǝ́ pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ enyipǝ sa pǝ ke ŋ siimǝ Yesu pǝ ŋ tɛlɩ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Wǝ́ kǝ́ akpaŋtɛŋtǝpǝ we pǝ la nyɩŋ sǝŋyǝ sa ŋ na kpaa ŋ yaa rǝ Pɛtǝro mǝ Yowanɛsɩ lǝ kpǝŋ we, pǝ lǝǝ tǝ pǝ nya dierǝ rɛ pǝ láa tɛŋ. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Wǝ́ pǝ tìi Pɛtǝro mǝ Yowanɛsɩ pǝ tɛlɩ pǝ ru rǝ wǝkpaŋtɛŋkukpǝ we. Wǝ́ pǝ ka ŋ ta dierǝ we pǝ ŋ yɩrɩ. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Yǝ leh yee mǝ enyipǝ sa nɛ? Pǝ le yee tucovurǝ kǝceece, wǝ lee ri tuŋwaawǝ. Eyerusalɛmǝtǝpǝ kpǝlo pǝ cii wǝ, wǝ́ yǝ lǝŋ koru acwɩɩ wǝ. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Paa kǝ tuwǝ sa wǝ poo to kpoo we, nǝ pǝ kǝ la kpaŋ mǝ pǝ kǝnyǝnyakǝnyǝnya, kǝ lǝ sǝ́ŋ lo koonu pǝ pǝ pǝǝ tǝ pǝ wɛɛlɩ pǝ ru rǝ Yesu la nyɩŋrǝ pǝ tíi rɛ.»<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Wǝ́ pǝ kpǝ̀lǝŋ pǝ pwò Pɛtǝro mǝ Yowanɛsɩ, wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Fǝ rǝ ruŋruŋ mǝ ko, nǝ pǝǝ tǝ nǝ wɛɛlɩ amaa nǝ kaŋ otuyǝ nǝ ru rǝ Yesu la nyɩŋrǝ nǝ tíi rɛ». <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ yìili pǝ tìi pǝ ǝkǝnǝŋ: «Ŋnǝŋnǝ nǝ yɩrɩ, wǝ kaamǝ kǝ le yee Worokoyǝ lǝ kǝǝpǝ́wǝ amaa nǝ kǝǝpǝ́wǝ? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Ŋlǝ paa we, tuwǝ we yǝ la nyɩŋ, wǝ́ yǝ lo nuŋ we, yǝ lǝŋ koru awɛ mǝ wǝ la atɛŋkǝ».<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />Wǝ́ akpaŋtɛŋtǝpǝ we pǝ tǝ pǝ kpanǝ mǝ Pɛtǝro mǝ Yowanɛsɩ pǝ kpìi vurǝ. Pǝ laa nya diecɛtɛɛrǝ pǝ lǝ́ǝ fǝ pǝ ta pǝlo kǝtukoŋkǝ, wǝ́ pǝ nyàrǝ pǝ pǝ cò. Kpiikǝ kǝkpǝŋkǝ we kǝ ka ya kǝ kǝ ŋ kǝ Worokoyǝ rǝ tuwǝ we wǝ pǝlǝ kǝto. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Nyiyǝ we Pɛtǝro mǝ Yowanɛsɩ pǝ cà, ǝkǝ wǝ rili nyi ri ŋ nyi lo mumuŋ we, teeri cɛŋwǝ tǝniǝ.<verse eid="ACT 4:22" /></para>
  <para style="s">Alɔnuŋtǝpǝ lo nyuŋmwɛŋwǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Kǝ́ pǝ la nyarǝ pǝ pǝ lo co we, wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ kolu pǝ tù pǝlǝ ǝtǝŋpǝ, wǝ́ pǝ fǝ̀ tu ri ŋ tu otoolutǝmumuŋpǝ mǝ Oyudatǝpǝ lo omumuŋpǝ pǝ le tíi pǝ, pǝ pɔ̀ pǝ la amayǝ. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Kǝ́ pǝ lo nuŋ pǝla amayǝ sa pǝ la lɛ we, wǝ́ pǝlo kpǝlo pǝ yeli nyuŋceŋceŋ pǝ mwɛnɩ nyuŋkpǝ pǝ pwò Worokoyǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋlǝ́ yǝ we e le yee yulaarǝ, kǝtǝǝwǝ, apʊyǝ mǝ tu ri ŋ tu wǝ kpii rǝ apʊyǝ lǝ mǝrǝ wǝ. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Ŋlǝ́ yǝ we o kòonu lǝh tǝtǝ Davidǝ, lá sʊmatǝyǝ la Wɛɛkenikenirǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Kǝ́ kǝto wǝ́ ǝrǝkǝnyipǝ pǝ tini pǝ láa kpaŋ wǝ? Kǝ́ kǝto wǝ́ pǝ ya pǝ láa yaa oyukpaakpaayǝ wǝ? <verse eid="ACT 4:25" /><verse number="26" style="v" sid="ACT 4:26" />Ǝkǝtǝǝpilipǝ pǝ la kpaka akɔŋkǝ, wǝ́ okopilǝtǝpǝ pǝ le yee nyuŋceŋceŋ wǝ́ pǝ le yi pǝ la tɛɛ rǝ Ǝtǝ Woroko mǝ ne Kǝrisoyǝ.” <verse eid="ACT 4:26" /><verse number="27" style="v" sid="ACT 4:27" />Kǝceece Erodɛsɩ mǝ Pɔŋto Pilato pǝ rili nyuŋkpǝ mǝ ǝrǝkǝnyipǝ fǝ kʊla mǝ Isǝrayɛlǝtǝpǝ rǝ tǝŋtǝǝwǝ sa pǝ tɛ̀ɛ rǝ Yesu, lá sʊmatǝkenikeniyǝ we a la saa a la pɔrʊ ŋ ri Lɔkuŋtǝyǝ wǝ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Pǝ le yee tuwǝ we a tɛnɩ ǝ tǝ̀nǝ ǝrǝ gakarǝ wǝ, wǝ lǝh pǝ pǝ rǝ ló okopiyǝ mǝ lǝ́ kǝǝpǝ́wǝ mǝrǝ. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Ǝtǝ Woroko! Yɩrɩ kǝ́ rǝkǝsa pǝ ya pǝ lée kpii lǝ vurǝ ree! Rǝkǝsa, koonu ŋlǝ epǝ we le ri lá asʊmatǝpǝ lo okopiyǝ, kǝ la tɛŋ lé dierǝ mǝ turutawǝ. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Pɔrʊ ló okopiyǝ a kaŋ, kǝ anyaatǝpǝ pǝ kpaa, kǝ le yee otucovurǝ mǝ otumumuŋyǝ rǝ Yesu, lá sʊmatǝkenikeniyǝ la nyɩŋrǝ.» <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Kǝ́ pǝ la mwɛŋ nyuŋkpǝ pǝ la lɛ we, wǝ́ fɛɛwǝ we pǝ lo ku pǝ yaa wǝ tìkili. Wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ pǝlo kpǝlo, wǝ́ pǝ ka ŋ tɛŋ Worokoŋtierǝ mǝ turutawǝ.<verse eid="ACT 4:31" /></para>
  <para style="s">Alɔnuŋtǝpǝ pǝ kǝ ŋ sǝpǝ pǝlo otulǝmǝyǝ pǝ ŋ koonu awɛ rǝ nyuŋceŋceŋkpǝ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Alɔnuŋtǝpǝ we lǝ kǝkpǝŋkǝ pǝ kǝ lǝ nyuŋceŋceŋ, yupurǝ jeŋceŋ mǝ ziɔŋrǝ jeŋceŋ, wǝ́ pǝla rɛ laa ka ŋ tɛŋ ǝkǝnǝŋ: «Tuwǝ sa wǝ ri mǝ nɛŋ». Paa pǝ kǝ ŋ tǝnǝ tu ri ŋ tu fɛɛceŋceŋ. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Enyikpiipǝ we pǝ fǝ̀ okopimumuŋyǝ rɛ pǝ ka ŋ wɛɛlɩ pǝ ŋ ru rǝ Kulǝtǝyǝ Yesu la asaanǝkǝ. Wǝ́ Worokoyǝ la lɛsiɛrɩwǝ wǝ ka tɛɛmǝ pǝ ŋpa. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Tǝrɛ wǝ lee ke ŋ yee pǝla rɛ la ariaayǝ, duturǝ ɖi epǝ we pǝ kǝ lǝǝmǝ ǝkǝtǝǝyǝ amaa anyarǝyǝ we, pǝ ke ŋ siiri yǝ, pǝ ŋ fǝ sɩkayǝ we pǝ la lɔ we, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />pǝ pe kpii enyikpiipǝ we rǝ akaakǝ, oturu pǝ lǝ fǝ pǝ lǝ sǝpǝ awɛ. Nyi ri ŋ nyi ŋ lɔ kǝ́ wǝ lóo ro ŋwǝ wǝ. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />Nyiyǝ rɛ pǝ lóo pwo Yosɛfʊ, leviyǝ wǝ́ ŋ ri. Pǝ mǝnǝ ŋwǝ rǝ Kipǝro. Yesu le enyikpiipǝ we pǝ lóo pwo ŋwǝ Banaba. Nyɩŋrǝ sa lo duturǝ ɖi «Turutatǝyǝ». <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Sìiri nǝ kǝtǝǝwǝ, wǝ́ ŋ fǝ̀ sɩkayǝ we ŋ pǝlǝ ŋ kpìi enyikpiipǝ we rǝ akaakǝ.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Anania mǝ ne tie Safira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Nyiyǝ rɛ pǝ lóo pwo Anania, ŋwǝ paa sìiri nǝ kǝtǝǝwǝ ŋpǝ mǝ ne tie Safira. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Wǝ́ ŋ rili nyuŋkpǝ mǝ ne tie, wǝ́ ŋ pɔ̀rʊ sɩkayǝ we la rɛɛyǝ ŋ ŋwàa. Wǝ́ ŋ fǝ̀ tuturuyǝ ŋ pǝlǝ ŋ kòonu enyikpiipǝ we. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Wǝ́ Pɛtǝro ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Anania, kǝ́ kǝto wǝ́ a la maa Satana ŋ na nya kǝtiikǝ rǝ lǝ́ mǝrǝ ǝnǝ? A la nia rǝ Wɛɛkenikenirǝ le enimiyǝ, wǝ́ ǝ lǝ fǝ sɩkayǝ sa la kǝtarɛɛkǝ a la ŋwaa. <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Mǝŋkǝ kǝtǝǝwǝ sa lá nɛŋ wǝ́ wǝ ri? Kǝ́ e le siiri wǝ, o lóo koru ǝfǝ sɩkayǝ we ǝ tǝnǝ lá wɛ ama? Kǝ́ kǝto wǝ́ o lo koru tuwǝ sa kǝtǝŋkǝ le eyee ǝnǝ? Worokoyǝ wǝ́ ǝ lǝ tǝǝnǝ, ŋkǝ ŋlǝ anyɩmaasɩpǝ!» <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Kǝ́ Anania ŋ no nuŋ Pɛtǝro le etieyǝ sa ko, wǝ́ ŋ rù ŋ tɔ̀, wǝ́ ŋ kpǝ̀. Wǝ́ vumumuŋrǝ rɛ vìi enyipǝ we kpǝlo pǝ nunu tuwǝ sa wǝ. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Wǝ́ okosopipǝ pǝ fǝ̀ nyaŋrǝ pǝ mìli ŋwǝ, wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ ŋwàa.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Wǝ lǝ́ǝ lǝ mǝŋ enipuŋyǝ ata la kǝmaakǝ, wǝ́ Anania le tie Safira ŋ pǝlǝ ŋ ko ŋ ru. Ŋwǝ paa loo nuŋ tuwǝ we wǝ lǝ pǝ wǝ láa lɛ wǝ. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Wǝ́ Pɛtǝro ŋ pwò ŋwǝ, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tíi mǝ, kǝceece okuruyǝ sa wǝ́ nǝ nye siiri kǝtǝǝwǝ we?» Wǝ́ Safira ŋ tɛ̀ɛnɩ ǝkǝnǝŋ: «Kǝceece! Okuruyǝ sa wǝ́ kǝtǝǝwǝ we wǝ la lɔ». <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nye ri nyuŋkpǝ ŋnǝ mǝ ló nuŋ kǝ nǝ tie Ǝtǝ Woroko la Wɛɛkenikenirǝ nǝ yɩrɩ ǝnǝ? A lǝŋ nyɩŋ, enyipǝ we pǝ la ka ŋwaa ló nuŋ pǝ lǝ́ǝ pǝ ǝnǝ, pǝ lǝ́ǝ fǝ ŋlá ŋkpɛ pǝ ka ŋwaa.» <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Kǝtǝrǝceŋceŋ ko, wǝ́ tieyǝ sa ŋ rù ŋ tɔ̀ɔ rǝ Pɛtǝro la kǝnyɩŋkǝ, wǝ́ ŋ kpǝ̀. Kǝ́ okosopipǝ we pǝ le pe fii gukpǝ we we, wǝ́ pǝ nyɩnɩ kǝ́ Safira ŋ nǝ kpǝ́ ŋ kpɛlɩ wǝ. Wǝ́ pǝ fǝ̀ ŋwǝ ŋkpɛ pǝ kolu pǝ ŋwàa rǝ no nuŋ la kǝlɛɛrɩkǝ. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Wǝ́ vurǝ rɛ vìi alɔnuŋtǝpǝ lǝ kǝkpǝŋkǝ we ŋpa mǝŋ epǝ we pǝ nunu tuwǝ sa wǝ.<verse eid="ACT 5:11" /></para>
  <para style="s">Enyikpiipǝ pǝ le yee otucovurǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Enyikpiipǝ pǝ ke ŋ yee otucovurǝ ŋpa mǝ otumumuŋyǝ rǝ kǝkpǝŋkǝ lǝ mǝrǝ. Alɔnuŋtǝpǝ kpǝlo pǝ ko ŋ ku rǝ Salomo la fɛɛlǝwǝ we. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Yǝ we ŋ naa lɔ ŋ nuŋ loo ko ŋ tu turuwǝ ŋ ka kʊla mǝ pǝ. Paa nyi ri ŋ nyi ka ŋ wɛɛlɩ mǝ ŋ ru rǝ pǝ sɩsiɛrɩ. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Wǝ́ kǝkpǝŋmumuŋkǝ rɛ, mǝŋ etie mǝŋ ǝpǝrǝŋ pǝ tǝ pǝ lɔ̀ Kulǝtǝyǝ Yesu pǝ nunu. Wǝ́ pǝ pǝlǝ pǝ kʊ̀la mǝ alɔnuŋtǝpǝ we. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Wǝ́ enyipǝ pǝ ko ŋ ru mǝ anyaatǝpǝ pǝ ŋ tǝnǝ rǝ akʊŋyǝ mǝ akpasapǝ ama ǝfǝŋkǝyǝ. Vǝ́ Pɛtǝro lah tɛlɩ we, kǝ na cɛrɛcɛrɛyǝ ǝkǝŋtǝ ŋ ru anyaatǝpǝ we la rɛ. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Enyipǝ pǝ ko ŋ ru rǝ ǝtǝŋtǝǝpiyǝ we yǝ kǝlǝ mǝ Yerusalɛmǝ pǝ ŋ pǝ mǝ anyaatǝpǝ mǝ epǝ we wɛɛrɔɔrɔɔrǝ ya lée kpii awɛɛlɩkǝ wǝ. Pǝlo kpǝlo a pǝ ŋ kpaa purupuru.<verse eid="ACT 5:16" /></para>
  <para style="s">Pǝ la lɔ enyikpiipǝ we pǝ la taŋ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Wǝ́ tuwǝ sa wǝ fìi toolutǝmumuŋyǝ we ŋpa mǝŋ Asadukitǝpǝ lǝ kǝkpǝŋkǝ we kǝ ke tini kǝ kʊ̀la mǝ ŋwǝ. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Wǝ́ pǝ lɔ̀ enyikpiipǝ we pǝ tanǝ rǝ tǝŋtǝǝwǝ we lo gukpɛɛkpǝ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Paape, kǝ́ kǝ la cɩɩ we, wǝ́ Ǝtǝ Woroko le picoŋpiyǝ ŋ pǝlǝ ŋ tàanǝ gukpɛɛkpǝ we la aŋwaayǝ, wǝ́ ŋ pɔ̀rʊ pǝ ŋ rù, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«Nǝ mǝ ko Worokoyǝ la nyarǝwǝ nǝ ka tɛŋ vɔrʊŋwɛŋrǝ sa le etieyǝ nǝ tíi kǝkpǝŋkǝ!» <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Wǝ́ enyikpiipǝ we pǝ yeli pǝ sanǝ rǝ dierǝ sa picoŋpiyǝ ŋ ne tíi pǝ wǝ. Wǝ́ pǝ yili ŋalaŋala mǝ rokoŋpikaalǝwǝ pǝ kolu pǝ yà pǝ ka ŋ kaŋ otuyǝ rǝ Worokoyǝ la nyarǝwǝ.</para>
  <para style="p" vid="ACT 5:21">Eniyǝ we lǝ mǝrǝ wǝ́ toolutǝmumuŋyǝ mǝ epǝ we pǝ ka kʊla mǝ ŋwǝ, pǝ kù mǝ Oyudatǝpǝ lo omumuŋpǝ, ŋpǝ enyipǝ sa pǝ ri Oyudatǝpǝ la akpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ. Wǝ́ pǝ kpìi enyipǝ pǝ ka pɔrʊ enyikpiipǝ we rǝ gukpɛɛkpǝ pǝ pǝ. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Paape kǝ́ okukpɛɛtǝpǝ we lǝ ǝrǝŋtǝpǝ pǝ lo ko we, pǝ laa ka nyɩŋ pǝ rǝ gukpɛɛkpǝ we. Wǝ́ pǝ kpǝ̀lǝŋ pǝ kòlu wǝkpaŋtɛŋkukpǝ we pǝ kòlu pǝ pɔ̀ pǝla amayǝ ǝkǝnǝŋ: <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />«Yǝ lo ko, kǝceece yǝ la ka nyɩŋ gukpɛɛkpǝ we wǝ tanǝ sɩsiɛrɩ, wǝ́ otuusiitǝpǝ we ŋpǝ ŋkpɛ pǝ yaa rǝ okuŋpoluyǝ we pǝ lǝ́ǝ rǝŋ. Paa kǝ́ yǝ la taanǝ ŋwaarǝ we we, yǝ laa nyɩŋ rɛ rǝ gukpǝ we.» <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Kǝ́ epǝ we pǝ lǝ́ǝ rǝŋ Worokoyǝ la nyarǝwǝ lo mumuŋyǝ we mǝ otoolutǝmumuŋpǝ we pǝ lo nuŋ tuwǝ sa we, wǝ́ wǝ rili pǝlo mumuŋ. Pǝ lǝǝ kǝ tǝ pǝ ci wǝ pǝ láa tɛŋ pǝ ru rǝ enyikpiipǝ sa lo oŋuŋkǝ, wǝ́ pǝ lee ke ci wǝ wǝ lǝ pǝ wǝ lo tuu pǝ. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Wǝ́ nyiyǝ rɛ ŋ pǝlǝ ŋ rù, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Enyipǝ we nǝ nya ka taŋ we, ŋpǝ pǝ kpii rǝ Worokoyǝ la nyarǝwǝ ǝnǝ. Pǝ ya pǝ láa kaŋ enyipǝ lo otuyǝ!»<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />Wǝ́ epǝ we pǝ lǝ́ǝ rǝŋ Worokoyǝ la nyarǝwǝ lo mumuŋyǝ we mǝ no otuusiitǝpǝ pǝ kolu pǝ lɔ̀ enyikpiipǝ sa pǝ pǝlǝ. Pǝ lee yee mǝ pǝlo turɔɔrɔɔwǝ rɛ, duturǝ ɖi pǝ ko ŋ suu vurǝ ǝkǝnǝŋ nyikpǝŋwǝ sa wǝ lée tieni pǝ lo oruyǝ. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Kǝ́ pǝ lo po ru mǝ enyikpiipǝ sa rǝ Oyudatǝpǝ la akpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we la kǝnyɩŋkǝ we, wǝ́ toolutǝmumuŋyǝ we ŋ pǝ̀ pǝ ǝkǝnǝŋ: <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />«Mǝŋkǝ yǝ lǝ sǝ́ŋ wǝ yǝ lo koonu nǝ ŋpa, nǝ pǝǝ tǝ nǝ kaŋ enyipǝ lo otuyǝ rǝ nyiyǝ sa la nyɩŋrǝ? Nǝ yɩrɩ kǝ́ nǝ nyo kuŋ nǝ otukaŋyǝ sa yǝ lo to Yerusalɛmǝ lǝ tǝŋtǝǝwǝ sa kpǝlo ree. Nǝ nyǝ́ǝ pǝ́ nǝ fǝ ŋwǝ nyiyǝ sa la gbɛŋrǝ nǝ tɛɛ rǝ lǝ?» <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Wǝ́ Pɛtǝro mǝ enyikpiituturupǝ we pǝ yìili pǝ ke ŋ tíi pǝ ǝkǝnǝŋ: «Wǝ kpii kǝ lo nuŋ rǝ Worokoyǝ lo tutɛŋwǝ le teeri enyipǝ lo tutɛŋwǝ. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Nǝ nya kpaa Yesu rǝ kpɛtɛkpǝlɛciiwǝ nǝ nyáa wʊ, paape lǝh ǝtǝtǝpǝ lo Worokoyǝ la saanǝ ŋwǝ. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Worokoyǝ la rɛɛrɩ mǝ ŋwǝ wǝ́ ŋ nǝ tǝnǝ ŋwǝ rǝ ne kǝnirisiɛɛkǝ. Lǝ fǝ ŋwǝ le yee Piliyǝ mǝ Lɔkuŋtǝyǝ, kǝ Isǝrayɛlǝtǝpǝ pǝ cɛkɛlɛ vɔrʊrǝ kǝ Worokoyǝ ŋ nya fɛɛ ŋ fǝ pǝlo oturɔɔrɔɔyǝ ŋ cɛɛ pǝ. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Le ri otuyǝ sa la araŋsielǝtǝpǝ, ŋlǝ mǝ Wɛɛkenikenirǝ we Worokoyǝ ŋ no koonu epǝ we pǝ lóo nuŋ no tutɛŋwǝ wǝ.»<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Kǝ́ akpaŋtɛŋtǝpǝ sa pǝ lo nuŋ etieyǝ sa we, wǝ́ pǝ fǝ̀ kpɛɛmʊrʊwǝ ŋpa. Wǝ́ pǝ pǝ̀ pǝ wʊ enyikpiipǝ sa. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Wǝ́ Farisitǝnyiyǝ rɛ rǝ akpaŋtɛŋtǝpǝ sa lǝ mǝrǝ ŋ yili ŋ yàa. Pǝ lóo pwo ŋwǝ Gamaliɛlɩ, sekaŋtǝyǝ wǝ́ ŋ ri. Enyipǝ kpǝlo pǝ lóo pu ŋwǝ. Wǝ́ ŋ tìi pǝ ce pǝ ru mǝ enyikpiipǝ sa pǝ cɛ tɩ kpɛŋ. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ Isǝrayɛlǝtǝpǝ, nǝ yee yurǝ mǝ tuwǝ sa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ yee mǝ enyipǝ sa wǝ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Duturǝ ɖi wǝ faa panǝ, wǝ́ nyiyǝ rɛ pǝ lóo pwo Teda ŋ pǝlǝ ŋ ka ŋ kaŋ na wɛ mǝŋ nyimumuŋyǝ rɛ wǝ́ ŋwǝ ŋ ri. Wǝ́ enyipǝ mǝŋ tuuruniǝ pǝ yili pǝ sìimǝ ŋwǝ. Paape pǝ wʊlʊ ŋwǝ wǝ́ epǝ we pǝ ke siimǝ ŋwǝ pǝlo kpǝlo pǝ canǝ awɛ ceŋceŋ ri ceŋceŋ loo tuuru. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Wǝla kǝmaakǝ la nyɩnɩ nyiyǝ rɛ pǝ lóo pwo Yuda. Rù rǝ Galileya pǝlǝ. Ŋwǝ ŋkpɛ kǝkpǝŋmumuŋkǝ rɛ kǝ yili kǝ sìimǝ ŋwǝ rǝ eniyǝ we pǝ kǝ ŋ kǝ enyipǝ rǝ gǝŋrǝ wǝ. Paape wǝ́ pǝ wʊlʊ ŋwǝ ŋkpɛ. Wǝ́ epǝ we pǝ ke siimǝ ŋwǝ pǝ canǝ awɛ pǝlo kpǝlo. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Rǝkǝsa ŋ́ ya ŋ́ née tíi nǝ we, nǝ pǝǝ tǝ nǝ kpǝlǝŋ enyipǝ sa. Nǝ nyarǝ pǝ nǝ co pǝ ŋ ko kpǝri! Mǝŋ wǝ ri tuwǝ we pǝ lǝ kǝ amaa pǝ ya pǝ lée yee wǝ lo ru rǝ nyɩmaasɩyǝ lǝ kpǝŋ we, wǝ lǝŋ ko kǝnyɩŋkǝ wǝ lǝ́ǝ pǝlǝ. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Wǝ́ mǝŋ wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ we, nǝ nyǝŋ po koru wǝ lǝ ǝpǝlǝ. Nǝ yee yurǝ, nǝ pee ci kǝ nǝ yee akɔŋkǝ mǝ Worokoyǝ oo!» Wǝ́ akpaŋtɛŋtǝpǝ sa pǝ tɛ̀ɛnɩ Gamaliɛlɩ le dierǝ we. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Wǝ́ pǝ pǝlǝ mǝ enyikpiipǝ we, wǝ́ pǝ culu pǝ, wǝ́ pǝ sǝnǝ pǝ kòonu pǝ, pǝ pǝǝ tǝ pǝ wɛɛlɩ rǝ Yesu la nyɩŋrǝ, wǝ́ pǝ nyarǝ pǝ pǝ cò. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Wǝ́ enyikpiipǝ sa pǝ pwɛ̀yɩ rǝ fɛɛtɛŋakpaŋyǝ sa pǝ ko ŋ ko mǝ faawǝ ŋpa ǝkǝnǝŋ wǝ kaamǝ kǝ pǝ kpii pǝ le kǝyepukǝ ŋpee rǝ Yesu la nyɩŋrǝ sa kǝto. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Enyikpiipǝ sa pǝ laa wɛ mǝ otukaŋyǝ. Ji ri ŋ ji pǝ ka ŋ kaŋ otuyǝ rǝ Worokoyǝ la nyarǝwǝ mǝ anyarǝyǝ pǝ ŋ tɛŋ Dieceeceerǝ we ǝkǝnǝŋ Yesu ŋ ri Kǝrisoyǝ we.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Pǝ lǝ tǝnǝ zʊmarǝ lo omumuŋpǝ apǝrɩmata</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Rǝ ŋyǝ eniyǝ we mǝrǝ we, anyɩŋ Yesu lo otukarǝtǝpǝ sa lǝ kǝkpǝŋkǝ kǝ ya kǝ láa ta kǝ ŋ kpii ŋpa, wǝ́ Oyudatǝpǝ we pǝ láa wɛɛlɩ Kǝhelatǝkǝ pǝ ka ŋ ŋwaa pǝ ŋ wɛɛlɩ pǝ ŋ ru rǝ Ehebǝritǝpǝ ǝkǝnǝŋ: «Vǝ́ ji ri ŋ ji pǝ lah nya pǝ ŋ sǝpǝ keeriwǝ ko, ǝ pǝ ŋ yuu leh ekpeetiepǝ la kpɛɛ.» <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Wǝ́ enyikpiitǝmeyipǝ we pǝ kù mǝ otukarǝtǝtuturupǝ we kpǝlo kɩɩkɩ wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Yǝ lǝŋ koru awɛ mǝ Worokoŋtierǝ la atɛŋkǝ kǝ la pa ya lǝ mǝ sǝpǝ rǝ ekeeriyǝ. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Kǝto we, lǝh ǝtǝŋ, nǝ pɔrʊ ǝpǝrǝŋpǝ apǝrɩmata rǝ nǝ mǝrǝ, epǝ we nǝ nya nyɩŋ pǝ kaamǝ, wǝ́ nyi ri ŋ nyi ŋ nóo pu wǝ, epǝ we pǝ lǝ lǝ mǝ Wɛɛkenikenirǝ wǝ́ pǝ lɛ pǝ ci otuyǝ wǝ, kǝ la nya fɛɛ lǝ fǝ kǝnǝnɛkǝ sa le kpii pǝ rǝ akaakǝ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Eniyǝ we, ŋlǝ paa, yǝ láa nya aka la mǝ mwɛŋ nyuŋkpǝ kǝ la mǝ tɛŋ Worokoŋtierǝ.» <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Wǝ́ kǝkpǝŋkǝ kpǝlo kɩɩkɩ kǝ tɛ̀ɛnɩ pǝle dierǝ sa. Wǝ́ pǝ pɔ̀rʊ Etiɛnɩ. Ri nyiyǝ rɛ ŋ lǝǝmǝ lɔnuŋrǝ wǝ́ ŋ nǝ lǝ mǝ Wɛɛkenikenirǝ. Wǝ́ pǝ pɔ̀rʊ Filipo, Pǝroko, Nikano, Timɔ, Pamenasɩ mǝ Nikola ŋ no ru rǝ Aŋtiokia wǝ́ ŋ na siɛrɩ ŋ ne yee Oyudatǝpǝ wǝ. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Wǝ́ pǝ fǝ̀ pǝ pǝ kanǝ enyikpiipǝ we. Wǝ́ pǝ mwɛnɩ nyuŋkpǝ pǝ koonu pǝ, wǝ́ pǝ tɛ̀ɛ pǝ la wǝkaakpǝ.<verse eid="ACT 6:6" /></para>
  <para style="s">Pǝ la lɔ Etiɛnɩ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Wǝ́ Worokoŋtierǝ ga ŋ nyɩɩ lǝ ŋ ta lǝ ŋ kpii. Wǝ́ otukarǝtǝpǝ pǝ ka ŋ ta pǝ ŋ kpii rǝ Yerusalɛmǝ ŋpa. Wǝ́ otoolutǝpǝ wa pǝ lɔ̀ Yesu pǝ nunu. <verse eid="ACT 6:7" /><verse number="8" style="v" sid="ACT 6:8" />Worokoyǝ pɛ̀ɛrɩ Etiɛnɩ, wǝ́ ŋ nya okopiyǝ ŋ ke ŋ yee otucovurǝ mǝ otumumuŋyǝ rǝ kǝkpǝŋkǝ lǝ mǝrǝ. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Wǝ́ enyipǝ rɛ pǝ ke ŋ yee etieyǝ mǝ ŋwǝ. Ŋpǝ enyipǝ sa pǝ láa sʊma rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ we pǝ lóo pwo ǝkǝnǝŋ «Arɔŋpǝ we pǝ la lɔ diiwɛɛrǝ lo gumwɛŋnyuŋkpǝ». Rǝ pǝlǝ mǝrǝ, yǝ láa nyɩŋ Oyudatǝpǝ we pǝ lo ru rǝ Sirɛnǝ, Alɛsaŋdǝri, Silisi mǝ Azi. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Paape Oyudatǝpǝ sa pǝ loo koru Etiɛnɩ lo yurǝ le eri, duturǝ ɖi Wɛɛkenikenirǝ gòonu ne eciatɛŋkǝ. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Kǝ́ pǝ la nyɩŋ wǝ ǝnǝ we, wǝ́ pǝ tìe enyipǝ, pǝ pa tɛŋ ǝkǝnǝŋ: «Yǝ lo nuŋ kǝ́ ŋ ya ŋ náa wɛɛlɩ opusuŋtǝtuyǝ mǝ ŋ ru rǝ Mose mǝ Worokoyǝ». <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Wǝ́ pǝ kpìi enyipǝ lo otukoŋyǝ, Oyudatǝpǝ lo omumuŋpǝ mǝ oworokosekaŋtǝpǝ, wǝ́ pǝ pǝlǝ pǝ rù rǝ Etiɛnɩ kǝtǝrǝceŋceŋ, wǝ́ pǝ lɔ̀ ŋwǝ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu Oyudatǝkpaŋtɛŋtǝpǝ la wǝcacumumumuŋkpǝ lǝ kpǝŋ. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Wǝ́ pǝ rè enyipǝ pǝ kolu fɛɛwǝ we, wǝ́ pǝ kolu pǝ ka ŋ nia pǝ ŋ tɛɛ rǝ Etiɛnɩ ǝkǝnǝŋ: «Nyiyǝ sa nǝ ya nǝ nyáa nyɩŋ, opusuŋtǝtuyǝ ko wǝ́ ŋ re ŋ ya ŋ náa wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ la nyarǝkenikeniwǝ mǝ Mose le seyǝ. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Duturǝ ɖi yǝ lo nuŋ la tɛŋ ǝkǝnǝŋ ŋwǝ Yesuyǝ sa ŋ rù rǝ Nazarɛtǝ we, láa wɔɔ Worokoyǝ la nyarǝwǝ, kǝ ŋ siɛrɩ Mose lo kǝsuŋkǝ we ŋ no koonu lǝ wǝ.» <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Wǝ́ akpaŋtɛŋtǝpǝ we kpǝlo pǝ tɔ̀ enimiyǝ pǝ ka ŋ yɩrɩ Etiɛnɩ pʊrɩpʊrɩ. Wǝ́ pǝ nyɩnɩ kǝ́ na anyɩŋkǝ kǝ la siɛrɩ mǝŋ Worokoyǝ le picoŋpiyǝ la anyɩŋkǝ kǝtǝ.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Etiɛnɩ la awɛɛlɩkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Wǝ́ toolutǝmumuŋyǝ we ŋ pǝ̀ Etiɛnɩ ǝkǝnǝŋ: «Etieyǝ sa enyipǝ sa pǝ la tɛŋ wǝǝ, yǝ lǝ ǝnǝ?» <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />Wǝ́ Etiɛnɩ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ tǝ peni, mǝ apaanʊpǝ, nǝ nuŋ mǝ dierǝ sa. Kpɛŋ kǝ lǝh tǝtǝ Abǝrahamǝ ŋ pe ke tii rǝ Haraŋ we, wǝnyɩɩnɩkpǝ lo Worokoyǝ pɔ̀rʊ na wɛ kanǝ ŋwǝ, anyɩŋ ke kpii rǝ Mezopotami, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />“Pwɛyɩ rǝ lǝ́ gǝŋrǝ mǝ lo otuulupǝ lǝ kpǝŋ, kǝ o mǝ ko gǝŋrǝ we ŋ́ náa kaŋ lǝ́ wǝ.” <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Wǝ́ kǝceece, Abǝrahamǝ ŋ pwɛ̀yɩ rǝ Akalǝdeyatǝpǝ lǝ gǝŋrǝ, wǝ́ ŋ kolu ŋ tini rǝ Haraŋ. Kǝ́ Abǝrahamǝ lǝ tǝ ŋ nǝ kpǝ́ la kǝmaakǝ we, wǝ́ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ pǝlǝ ŋ tiini rǝ gǝŋrǝ sa nǝ tini rǝkǝsa wǝ. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Worokoyǝ lee ce ŋ fʊʊ gǝŋrǝ sa ŋ koonu Abǝrahamǝ, mǝŋ fɛɛpiwǝ rɛ ŋ náa nya ŋ tǝnǝ kǝkparǝkǝ ǝkǝŋtǝ, kǝ wǝ ri ŋwǝŋwǝ no tuwǝ. Paape Worokoyǝ tìi ŋwǝ ǝkǝnǝŋ ŋ nǝ́ǝ fǝ gǝŋrǝ sa ŋ koonu ŋpǝ mǝ nǝ wǝmǝkpǝ, paa Abǝrahamǝ lǝǝ kǝ lǝmǝ pi. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Dierǝ Worokoyǝ ŋ tìi ŋwǝ gamǝ ɖǝ ǝnǝ: “Lǝ́ wǝmǝkpǝ wǝ leh pe ri ǝsǝǝpǝ rǝ gǝŋpʊŋpwarǝ, kǝ enyipǝ pǝ fǝ pǝ pǝ yee arɔŋpǝ, kǝ pǝ pieeli pǝ cɛŋwǝ tuuruniǝ. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Paape, ŋ́ náa tɛŋ wǝkpaŋkpǝ mǝ epǝ we pǝ lǝ fǝ pǝ pǝ le yee arɔŋpǝ wǝ. Wǝla kǝmaakǝ we, pǝ láa pwɛyɩ rǝ gǝŋrǝ we, kǝ pǝ pa sʊma mǝ rǝ fɛɛwǝ sa.” <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Wǝ́ Worokoyǝ mǝ Abǝrahamǝ pǝ pàrǝ ǝkǝǝlǝkǝ le dierǝ pǝ tǝ̀nǝ. Tuwǝ kǝto, kǝ́ Abǝrahamǝ ŋ nǝ mǝ Isakǝ lo junɛŋtǝrǝ wǝ́ ŋ kǝ̀ǝlǝ ŋwǝ. Isakǝ ŋwee kǝ́ ŋ nǝ mǝ Yakɔbǝ wǝ́ ŋ kǝ̀ǝlǝ ŋwǝ, wǝ́ Yakɔbǝ ŋwee ŋ kǝ̀ǝlǝ ne epipǝ we pǝlǝ tǝ mǝ eyi. Ŋpǝ pǝ ri lǝh ǝtǝtǝpǝ.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />Lǝh ǝtǝtǝpǝ sa pǝ kǝ ŋ kpǝ̀lǝ pǝla paanʊ Yosɛfʊ lǝ kǝǝwǝ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ sìiri, kǝ ŋ nya fɛɛ ŋ ke yee rɔŋyǝ rǝ Ejipǝte. Paape Worokoyǝ ka kʊla mǝ ŋwǝ, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />wǝ́ ŋ pɔ̀rʊ ŋwǝ ŋ rù rǝ na arianyɩŋyǝ kpǝlo kɩɩkɩ lǝ mǝrǝ. Wǝ́ Worokoyǝ ŋ kòonu Yosɛfʊ lo otuciyǝ. Wǝ́ ŋ lɛ̀ ŋ yeli wǝ́ Yosɛfʊ lo tuwǝ wǝ ponu mǝ Farawo ŋ ri ejipǝtetǝpiliyǝ. Wǝ́ Farawo ŋ fǝ̀ ŋwǝ ŋ tìini kǝŋyɩrɩtǝyǝ rǝ Ejipǝte mǝ ŋwǝ Farawo la nyarǝwǝ kpǝlo. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ, wǝ́ kǝtɛŋkǝ kǝ fìi Ejipǝte kpǝlo mǝŋ Kanaŋ. Kǝtɛŋkǝ kǝ wʊlʊ enyipǝ ŋpa, wǝ́ pǝ nyɩnɩ ariaayǝ. Lǝh ǝtǝtǝpǝ pǝ lǝǝ kǝ tǝ pǝ lǝmǝ keeriwǝ pǝ lée ri. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Kǝ́ Yakɔbǝ ŋ no nuŋ ǝkǝnǝŋ keeriwǝ wǝ kpii rǝ Ejipǝte we, wǝ́ ŋ kpìi lǝh ǝtǝtǝpǝ pǝ kolu kǝsǝsǝŋkǝ. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Kǝ́ pǝ lǝ tǝ pǝ la siɛnɩ pǝ lo ko kǝyitǝkǝ we, wǝ́ Yosɛfʊ ŋ pɔ̀rʊ na wɛ ŋ kanǝ na apaanʊpǝ. Fɛɛwǝ Farawo ŋ pǝlǝ ŋ cìi fɛɛwǝ we Yosɛfʊ ŋ no ru wǝǝ. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Wǝ́ Yosɛfʊ ŋ kpìi enyipǝ pǝ kolu pǝ fǝ̀ nǝ tǝ Yakɔbǝ mǝ nǝ gbǝŋrǝ. Pǝlo kpǝlo pǝ kǝ lǝ enyipǝ tǝpǝrɩmata mǝ atʊʊ. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Wǝ́ Yakɔbǝ mǝ nǝ gbǝŋrǝ pǝ kolu pǝ tini rǝ Ejipǝte, wǝ́ ŋ kpǝ̀ rǝ we mǝŋ lǝ ǝtǝtǝpǝ we. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Wǝ́ pǝ kolu pǝ ŋwàa pǝ rǝ Sikɛmǝ rǝ wǝfuŋkpǝ we Abǝrahamǝ ŋ fùu rǝ Emɔ le epipǝ lǝ kpǝŋ rǝ Sikɛmǝ wǝ.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />Kǝ́ eniyǝ yǝ lah ta yǝ ro kǝ dierǝ we Worokoyǝ ŋ tìi Abǝrahamǝ yee kǝnǝnɛkǝ we, wǝ́ Yakɔbǝ lǝ gbǝŋrǝ ga ŋ yaarǝ ŋpa rǝ Ejipǝte, <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />po ru eniyǝ we piliŋwɛŋyǝ rɛ ŋ pǝlǝ ŋ tini zaarǝ wǝ. Ŋwǝ piliŋwɛŋyǝ sa lee ke ci Yosɛfʊ. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Wǝ́ ŋ yili ŋ tɛ̀ɛ rǝ lǝh gbǝŋrǝ mǝ wǝpiekpǝ, wǝ́ ŋ pìeeli lǝh ǝtǝtǝpǝ, wǝ́ ŋ sì pǝ kǝ pǝ maa pǝ le epiŋwɛŋpǝ pǝ co, kǝ pǝ paa fɔrʊ. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ, wǝ́ pǝ mǝnǝ Mose. Ko ŋ poŋ ayɩrɩ, wǝ́ no tuwǝ wǝ ko ponu mǝ Worokoyǝ. Wǝ́ pǝ rè ŋwǝ rǝ nǝ tǝ la nyarǝwǝ, akɛɛnyɔŋpǝ ata. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Kǝ́ pǝ la maa ŋwǝ pǝ lo co we, wǝ́ Farawo la kɔrʊyǝ ŋ kolu ŋ rɛ̀mɩ ŋwǝ. Wǝ́ ŋ yɩ̀rɩ no yurǝ mǝŋ ŋwǝŋwǝ ne piyǝ kǝtǝ. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Wǝ́ pǝ fǝ̀ Ejipǝtetǝtuciyǝ kpǝlo pǝ kanǝ Mose. Ke ŋ ci awɛɛlɩ, wǝ́ ŋ ka lɛ ŋ lɛnyɩ rǝ otuyeeyǝ. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />Kǝ́ Mose ŋ na lɔ cɛŋwǝ tǝniǝ we, wǝ́ ŋ yeli yurǝ ǝkǝnǝŋ ŋ née siri ŋ ko na apaanʊ Isǝrayɛlǝtǝpǝ lǝ kpǝŋ. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Wǝ́ ŋ kolu ŋ rù rǝ kǝ́ Ejipǝtetǝnyiyǝ rɛ ŋ ya ŋ nóo culu Isǝrayɛlǝtǝnyiyǝ, wǝ́ Mose ŋ kɔ̀ɔlʊ Isǝrayɛlǝtǝnyiyǝ we, wǝ́ ŋ lɔ̀ Ejipǝtetǝnyiyǝ we ŋ cùlu, wǝ́ ŋ wʊlʊ ŋwǝ saŋ. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Wǝ́ Mose ŋ nyɩnɩ rǝ ǝkǝnǝŋ na apaanʊ Isǝrayɛlǝtǝpǝ pǝ láa nyɩŋ wǝ pǝ ci ǝkǝnǝŋ Worokoyǝ le kpii ŋwǝ ŋ pa pɔrʊ pǝ. Ŋpǝ paa pǝ lǝǝ fǝ wǝ ǝnǝ. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Galǝǝrǝkǝ, wǝ́ Mose ŋ tǝ ŋ kolu ŋ kù mǝ kǝ́ Isǝrayɛlǝtǝpipǝ eyi pǝ ya pǝ láa fia wǝ. Wǝ́ ŋ kolu ŋ tà pǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: “Lǝh ǝtǝŋ, apaanʊpǝ wǝ́ nǝ ri, kǝ́ kǝto wǝ́ nǝ ya nǝ nyáa fia wǝ?” Wǝ́ ŋ kǝ ŋ pǝ́ ŋ ca pǝ ŋ kpii rǝ awɛ. <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Paape, wǝ́ yǝ we ŋ ko ŋ culu na kɛrɩyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Ǝlǝ ŋ nǝ fǝ lǝ́ ŋ ne yee loh mumuŋyǝ mǝ lah kpaŋtɛŋtǝyǝ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Amaa ǝ lǝ́ǝ pǝ́ a wʊ mǝ mǝŋ kǝ́ a wʊlʊ Ejipǝtetǝnyiyǝ we ǝsǝǝkǝ wǝ?” <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Kǝ́ Mose ŋ na nya ŋ no nuŋ dierǝ sa ko we, wǝ́ ŋ sù ŋ kolu ŋ ŋwàa rǝ Amadiaŋtǝpǝ lǝ gǝŋrǝ. Fɛɛwǝ we, wǝ́ Mose ŋ mǝnǝ epipǝ eyi.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />Cɛŋwǝ tǝniǝ la kǝmaakǝ we, wǝ́ picoŋpiyǝ rɛ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Mose rǝ nyɔŋkpaakǝtǝǝwǝ we wǝ kǝlǝ mǝ dutupirǝ we pǝ lóo pwo Sinayi. Ŋwǝ picoŋpiyǝ sa pɔ̀rʊ na wɛ kanǝ Mose rǝ goŋkupirǝ rɛ ga ŋ ta naawǝ wǝ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Kǝ́ Mose ŋ na nyɩŋ tuwǝ sa we, wǝ́ wǝ rili no mumuŋ. Wǝ́ ŋ ko ŋ ru mǝ ŋ kǝlǝ kǝ ŋ nya fɛɛ ŋ yɩrɩ wǝ sɩsiɛrɩ. Fɛɛwǝ we ko, wǝ́ ŋ nunu Ǝtǝ Woroko la kpɛɛwǝ ǝkǝnǝŋ: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />“Ŋmǝ ŋ́ ri lǝ́ ǝtǝtǝpǝ lo Worokoyǝ, Abǝrahamǝ, Isakǝ mǝ Yakɔbǝ lo Worokoyǝ.” Wǝ́ Mose ŋ ka ŋ ca kpakpa, lǝh kpǝ́ mǝ vurǝ, lǝǝ tǝ ŋ tu turuwǝ ŋ yɩrɩ tuwǝ we. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: “Pɔrʊ lá afʊkpayǝ, kpiikǝ fɛɛwǝ sa a yaa we wǝ ri rǝ kǝtǝǝkenikeniwǝ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Ŋ́ na nyɩŋ kǝ́ mǝ kǝkpǝŋkǝ kǝ ya kǝ láa cʊʊrʊ rǝ Ejipǝte. Ŋ́ no nuŋ pǝla anʊmʊkǝ, wǝ́ ŋ́ na sʊʊ ŋ́ pa pɔrʊ pǝ. Rǝkǝsa we, ŋ́ née kpii lǝ́ o ko Ejipǝte.”<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />Moseyǝ sa Isǝrayɛlǝtǝpǝ pǝ sǝnǝ pǝ cò mǝ kǝ́ pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: “Ǝlǝ ŋ nǝ fǝ lǝ́ ŋ ne yee mumuŋyǝ mǝ kpaŋtɛŋtǝyǝ?” we, ŋwǝ Moseyǝ sa, wǝ́ Worokoyǝ ŋ ne kpii ŋ na maŋ ŋ pe ri pǝlo mumuŋyǝ mǝ pǝla lɔkuŋtǝyǝ. Worokoyǝ kpìi Mose la kǝnǝnɛkǝ sa sanǝ rǝ picoŋpiyǝ we ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ rǝ goŋkupirǝ we ga ŋ ta naawǝ wǝ. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Ŋwǝ Mose ŋ pɔ̀rʊ Isǝrayɛlǝtǝpipǝ ŋ rù rǝ Ejipǝte. Yeli otucovurǝ mǝ otumumuŋyǝ rǝ Ejipǝte rǝ apʊmwɛɛrɩyǝ mǝ nyɔŋkpaakǝtǝǝwǝ cɛŋwǝ tǝniǝ milimili. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Ŋwǝ Mose ŋ tǝ ŋ tìi Isǝrayɛlǝtǝpǝ ǝkǝnǝŋ: “Worokoyǝ leh pe kpii kpɛɛnuŋtɛŋtǝyǝ rɛ mǝŋ ŋmǝ kǝtǝ ŋ maŋ nǝ. Lóo ru rǝ nǝ mǝrǝ.” <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Eniyǝ we Isǝrayɛlǝtǝpǝ pǝ kolu pǝ tini rǝ nyɔŋkpaakǝtǝǝwǝ we, Mose ka kʊla. Worokoyǝ le picoŋpiyǝ we ŋ wɛ̀ɛlɩ mǝ Mose rǝ Sinayi lo dutupirǝ we, kǝ ŋ tǝ mǝ ŋ wɛɛlɩ mǝ ŋwǝ ŋ fǝ ŋ tɛŋ ŋ tíi lǝh ǝtǝtǝpǝ. Ŋwǝ Mose ŋ nunu etieyǝ we yǝ kpii vɔrʊrǝ kǝ ŋ fǝ ŋ tíi lǝ. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />Paape lǝh ǝtǝtǝpǝ pǝ lǝǝ kǝ ŋ pǝ́ pǝ nuŋ no tutɛŋwǝ wǝ́ pǝ sǝ́nǝ ŋwǝ. Pǝlo yurǝ ga tɛɛ rǝ Ejipǝte. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Wǝ́ pǝ tìi Arɔŋ ǝkǝnǝŋ: “Yee oworokopǝ o koonu lǝ, kǝ pǝ coŋ mǝ lǝ. Kpiikǝ yǝ lee ci tuwǝ wǝ le ke yee Moseyǝ sa ŋ pɔ̀rʊ lǝ ŋ rù rǝ Ejipǝte wǝ.” <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Wǝ́ pǝ màrǝ diŋrǝ rɛ lo ru nɛŋpirǝ, wǝ́ pǝ wʊlʊ kɛɛyǝ pǝ kòonu diŋrǝ sa le erikǝ. Wǝ́ pǝ nyà faawǝ ŋpa, wǝ́ pǝ rili wǝcɛkpǝ mǝ kǝ́ ŋpǝŋpǝ pǝ lǝ fǝ pǝla wǝkaakpǝ pǝ le yee kǝnǝnɛkǝ sa wǝ. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Wǝ́ Worokoyǝ ŋ cɛ̀ rǝ pǝla kǝmaakǝ. Wǝ́ ŋ màa pǝ pǝ ka ŋ sʊma cɔkɔŋyǝ, kɛɛnyɔŋyǝ mǝ wǝŋɔŋkpǝ mǝŋ kǝ́ pǝ la ŋʊrʊ wǝ pǝ le kpii rǝ oworokokpɛɛnuŋtɛŋtǝpǝ la kǝfwɛɛkǝ mǝrǝ kǝtǝ. Pǝ la ŋʊrʊ ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 7:42">“Isǝrayɛlǝtǝpǝ, nǝ nye yee cɛŋwǝ tǝniǝ mili mili rǝ nyɔŋkpaakǝtǝǝwǝ,</para>
  <para style="q1" vid="ACT 7:42">nǝ nyǝ fǝ akɛɛpǝ nǝ nyo toolu nǝ nyo koonu mǝ nǝ nya nyɩŋ?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Paa nǝ nyǝ kǝ rǝǝrǝ nǝ worokoyǝ Mɔlɔkǝ le bwiirǝ mǝ nǝ worokoyǝ Refanǝ la kǝŋɔŋkǝ nǝ re nǝ nyáa tɛlɩ. Nǝ ya nǝ nyáa sʊma otuyǝ sa nǝ nye yee mǝ nǝ wǝkaakpǝ wǝ. Tuwǝ sa nǝ nye yee kǝto ŋmǝ ŋkpɛ ŋ́ nóo ko mǝ nǝ ŋ kǝ tǝnǝ ciriciri ǝrǝ Babilonia la kǝmaakǝ.”<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />Eniyǝ we lǝh ǝtǝtǝpǝ pǝ ke tini rǝ nyɔŋkpaakǝtǝǝwǝ we, pǝ kǝ lǝǝmǝ bwiirǝ we láa kaŋ ǝkǝnǝŋ Worokoyǝ kpii kʊla mǝ pǝ. Worokoyǝ ŋ tìi Mose ŋ tɔ bwiirǝ sa. Wǝ́ kǝceece ŋ tɔ̀ rǝ mǝŋ kǝ́ Worokoyǝ ŋ pɔ̀rʊ rǝ ŋ kanǝ ŋwǝ kǝtǝ. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Wǝla kǝmaakǝ wǝ́ lǝh ǝtǝtǝpǝ pǝ màa bwiirǝ sa pǝ tǝnǝ pǝle epipǝ. Eniyǝ we we, Yoswa ŋ ko conu mǝ pǝ wǝ́ pǝ fǝ̀ bwiirǝ sa pǝ pwɛ̀yɩ. Wǝ́ Worokoyǝ ŋ pìri enyipǝ we pǝ ke tini rǝ ǝkǝtǝǝyǝ we ŋ cɛ̀ pǝ. Wǝ́ bwiirǝ sa gbɛlɩ gʊ̀la mǝ pǝ po ru ǝrǝ Davidǝ le diirǝ. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Davidǝ lo tuwǝ wǝ ko ponu mǝ Worokoyǝ. Wǝ́ ŋ pǝ̀ gʊŋrǝ rǝ nǝ kpǝŋ kǝ ŋ tɔ nyarǝwǝ ŋ koonu Yakɔbǝ lo Worokoyǝ. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Paa Salomo ŋ pǝlǝ ŋ tɔ̀ nyarǝwǝ sa ŋ kòonu Worokoyǝ. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Paape Worokoyǝ ŋ tɛɛ rǝ yulaarǝ we, lǝŋ tii nyarǝwǝ we anyɩmaasɩpǝ pǝ la tɔ wǝ. Mǝŋ kǝ́ worokokpɛɛnuŋtɛŋtǝyǝ ŋ na tɛŋ ǝkǝnǝŋ:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“Yulaarǝ ɖi mǝ bilisaarǝ, wǝ́ kǝtǝǝwǝ wǝ ri mǝ fɛɛ sǝrǝ akparǝyǝ.</para>
  <para style="q1" vid="ACT 7:49">Kǝ́ la nyarǝ kǝtǝŋ wǝ́ nǝ nyah tɔ nǝ koonu mǝ?</para>
  <para style="q1" vid="ACT 7:49">Amaa fǝŋ la fɛɛ wǝ ri mǝ fɛɛtiiwɛɛwǝ wǝ?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Kǝto ŋkǝ mǝ wǝkaakpǝ wǝ le yee ŋyǝ otuyǝ sa kpǝlo kɩɩkɩ?”<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Ŋnǝ enyipǝ sa nǝ lɛnyɩ yurǝ ŋpa, nǝ nya taŋ otukoŋyǝ kpɛŋ, wǝ́ nǝ nyǝ sǝ́ŋ nǝ nyǝŋ nuŋ Wɛɛkenikenirǝ lo tutɛŋwǝ! Nǝ lǝ mǝŋ nǝ ǝtǝtǝpǝ kǝtǝ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Oworokokpɛɛnuŋtɛŋtǝpǝ lǝ yǝ rǝ fǝŋ wǝ́ nǝ ǝtǝtǝpǝ pǝ lee yì pǝ tɛɛ rǝ wǝ? Pǝ wʊlʊ epǝ we pǝ ka ŋ wɛɛlɩ pǝ ŋ tɛŋ nyikʊʊyǝ we lǝ ǝpǝkǝ wǝ. Rǝkǝsa ŋnǝ ŋkpɛ nǝ nyǝ fǝ nyikʊʊyǝ sa nǝ nye siiri wǝ́ nǝ nya wʊ ŋwǝ. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Nǝ nya lɔ Worokoyǝ le seyǝ nǝ nya saŋ rǝ epicoŋpipǝ la wǝkaakpǝ, paape nǝ nyǝŋ yee nǝ saŋ rǝ ŋwǝ seyǝ sa lo oŋuŋkǝ!»<verse eid="ACT 7:53" /></para>
  <para style="s">Pǝ le tieni Etiɛnɩ lo oruyǝ pǝ la wʊ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Kǝ́ akpaŋtɛŋtǝpǝ sa pǝ lo nuŋ Etiɛnɩ le etieyǝ sa we, wǝ́ wǝ fìi pǝ ŋpa. Wǝ́ pǝ yà pǝ ko ŋ wo oroŋciiyǝ kǝrǝrǝkǝrǝrǝ pǝ ŋ tɛɛ rǝ ŋwǝ. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Eniyǝ we lǝ mǝrǝ we, anyɩŋ Etiɛnɩ ŋwǝ paa lǝ lǝ mǝ Wɛɛkenikenirǝ. Wǝ́ ŋ tɔ̀ enimiyǝ ŋ ka ŋ yɩrɩ rǝ yulaarǝ. Wǝ́ ŋ nyɩnɩ Worokoyǝ la wǝnyɩɩnɩkpǝ mǝ Yesu kǝ́ ŋ ne yi ŋ yaa rǝ Worokoyǝ le kǝnirisiɛɛkǝ wǝ. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Wǝ́ ŋ ka ŋ tɛŋ ǝkǝnǝŋ: «Nǝ yɩrɩ re! Ŋ́ na nyɩŋ yulaarǝ la taanǝ. Wǝ́ ŋ́ na nyɩŋ Nyɩmaasɩ le Pi le yi yaa rǝ Worokoyǝ le kǝnirisiɛɛkǝ.» <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Wǝ́ enyipǝ sa kpǝlo pǝ yà pǝ ko ŋ woolu wuu, wǝ́ pǝ fǝ̀ wǝkaakpǝ pǝ tanǝ otukoŋyǝ. Wǝ́ pǝ làrǝ pǝ kolu pǝ sìi Etiɛnɩ. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Wǝ́ pǝ tìini ŋwǝ pǝ rù rǝ tǝŋtǝǝwǝ we, wǝ́ pǝ tieni no oruyǝ pǝ wʊlʊ. Araŋsielǝtǝpǝ pǝ pɔ̀rʊ pǝla wǝkpakpǝ pǝ tǝ̀nǝ rǝ kosopiyǝ rɛ pǝ lóo pwo Sɔlʊ lǝ kpǝŋ. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Kǝ́ pǝ ya pǝ lée tieni no oruyǝ we, wǝ́ ŋ yà ŋ ka mwɛŋ nyuŋkpǝ ǝkǝnǝŋ: «Kulǝtǝyǝ Yesu, lɔ mǝ wɛɛrǝ.» <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ, wǝ́ ŋ cà narǝwǝ mǝ no okopiyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, fǝ pǝlo turɔɔrɔɔwǝ sa a cɛɛ pǝ!» Mǝŋ anya tɛŋ dierǝ sa ko we, wǝ́ ŋ kpǝ̀. <figure style="fig" alt="La lapidation dʼÉtienne" file="cn01923C.tif" size="col" copy="Graham Wade" ref="7:59">Pǝ le tieni Etiɛnɩ lo oruyǝ pǝ la wʊ</figure><verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Etiɛnɩ la awʊkǝ kǝ ko ponu mǝ Sɔlʊ ŋwǝ ŋkpɛ.</para>
  <para style="s" vid="ACT 8:1">Sɔlʊ le yi la tɛɛ rǝ ekǝrisotǝpǝ rǝ Yerusalɛmǝ</para>
  <para style="p" vid="ACT 8:1">Jirǝ we jirǝ we, wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ alɔnuŋtǝpǝ we pǝ kpii rǝ Yerusalɛmǝ ŋpaŋpa. Wǝ́ pǝlo kpǝlo pǝ sùu pǝ pwɛ̀yɩ pǝ ko ŋ ko Yudeya mǝ Samaria la akaayǝ we, enyikpiipǝ we ko pǝ laa ka kʊla wǝ. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Wǝ́ enyipǝ rɛ pǝ láa taa Worokoyǝ lǝ kǝǝwǝ pǝ kolu pǝ fǝ̀ Etiɛnɩ pǝ ŋwàa wǝ́ pǝ weli ŋwǝ ŋpa. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Sɔlʊ ŋwǝ paa we, kǝ ŋ pǝ́ ŋ nǝǝnǝ alɔnuŋtǝpǝ. Wǝ́ ŋ ke ŋ fii anyarǝyǝ mǝ ŋ lɔ alɔnuŋtǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ mǝ ŋ ko mǝ ŋ taŋ. <verse eid="ACT 8:3" /><verse number="4" style="v" sid="ACT 8:4" />Enyipǝ we pǝ sùu pǝ pwɛ̀yɩ we, pǝ ka ŋ tɛŋ Worokoŋtierǝ rǝ fɛɛ ri ŋ fɛɛ pǝ le ke fii wǝ.<verse eid="ACT 8:4" /></para>
  <para style="s">Filipo la tɛŋ Worokoŋtierǝ rǝ Samaria</para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 8:5" />Wǝ́ Filipo ŋwǝ paa ŋ ka ŋ sʊʊ Samaria lǝ tǝŋtǝǝwǝ<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Samaria lǝ tǝŋtǝǝwǝ rɛ».</char></note>. Wǝ́ ŋ kolu ŋ tɛnɩ Worokoŋtierǝ ŋ wɛ̀ɛlɩ ŋ rù rǝ Kǝriso ŋ tìi enyipǝ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Ǝtǝŋtǝǝtǝpǝ we kpǝlo pǝ fǝ̀ yupurǝ jeŋceŋ pǝ lɔ̀ Filipo le etieyǝ pǝ nunu. Duturǝ ɖi pǝ ko ŋ nuŋ wǝ́ pǝ ka ŋ nyɩŋ otucovurǝ ŋ ke ŋ yee wǝ. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Kǝceece, awɛɛrɔɔrɔɔyǝ yǝ ko ŋ ru rǝ enyipǝ wa, a yǝ ŋ mǝ ca anarǝmumuŋyǝ rɛ. Wǝ́ enyipǝ we pǝ lǝ kpǝ́ wɛlɛŋrǝ mǝ ǝsǝ́ŋpǝ pǝ ka ŋ kpaa. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Wǝ́ enyipǝ pǝ nyà faamumuŋwǝ rɛ rǝ tǝŋtǝǝwǝ sa.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Nyiyǝ rɛ pǝ lóo pwo Sɩmɔ ke kpii rǝ tǝŋtǝǝwǝ sa wǝ lɔ̀ eniyǝ. Ke ŋ yee majikiyǝ. Wǝ́ no tuwǝ wǝ ko ŋ co Asamariatǝpǝ lo vurǝ. Wǝ́ ŋ ke ŋ tíi enyipǝ ǝkǝnǝŋ ŋwǝ ŋ ri nyimumuŋyǝ rɛ. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Wǝ́ pǝlo kpǝlo mǝŋ epipi mǝŋ omumuŋ pǝ lɔ̀ ŋwǝ pǝ nunu. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Worokoyǝ lo okopiyǝ yǝ kaamǝ nyiyǝ sa, eyǝ we pǝ lóo pwo okopimumuŋyǝ». <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Pǝ ka ŋ lɔ ŋwǝ pǝ ŋ nuŋ kpiikǝ ke ŋ yee otuyǝ yǝ lóo co vurǝ mǝ na majikiyǝ we wǝ la panǝ. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Paape kǝ́ Filipo ŋ na pa tɛŋ Worokoŋtierǝ ŋ no ru rǝ Worokoyǝ le wǝpilirikpǝ mǝ Yesu Kǝriso la nyɩŋrǝ ŋ ne tíi pǝ we, wǝ́ pǝ lɔ̀ ŋwǝ pǝ nunu. Wǝ́ pǝ wìiri pǝlo worokomɛŋwǝ, mǝŋ etie mǝŋ ǝpǝrǝŋ. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Sɩmɔ ŋwǝŋwǝ ǝkǝŋtǝ lɔ̀ nunu, wǝ́ pǝ wìiri no worokomɛŋwǝ. Laa ka ŋ waarǝ mǝ Filipo. Kǝ́ ŋ na nyɩŋ otucovurǝ mǝ otumumuŋyǝ sa yǝ ya yǝ lǝ́ǝ pǝ we, wǝ́ wǝ rili no mumuŋ.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Enyikpiipǝ we pǝ ke kpii rǝ Yerusalɛmǝ. Wǝ́ pǝ nunu wǝ ǝkǝnǝŋ Asamariatǝpǝ pǝ la lɔ Worokoŋtierǝ. Wǝ́ pǝ kpìi Pɛtǝro mǝ Yowanɛsɩ pǝ manǝ pǝ. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Kǝ́ pǝ le ke fii Samaria we, wǝ́ pǝ mwɛnɩ nyuŋkpǝ pǝ kòonu alɔnuŋtǝpǝ we kǝ pǝ nya fɛɛ pǝ lɔ Wɛɛkenikenirǝ. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Kpiikǝ Wɛɛkenikenirǝ vaa ka ma zʊʊ rǝ pǝla rɛ nyɩŋ. Worokomɛŋwǝ ko wǝ́ pǝ wìiri pǝ rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ ka ŋ tɛɛ pǝ la wǝkaakpǝ. Wǝ́ pǝ lɔ̀ Wɛɛkenikenirǝ. <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />Kǝ́ Sɩmɔ ŋ na nyɩŋ ǝkǝnǝŋ enyikpiipǝ sa pǝ ya pǝ láa tɛɛ alɔnuŋtǝpǝ we la wǝkaakpǝ oturu pǝ la lɔ Wɛɛkenikenirǝ we, wǝ́ ŋ kolu ŋ fǝ̀ sɩkayǝ ŋ po koonu pǝ. <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ koonu mǝ okopiyǝ sa ŋmǝ ŋkpɛ. Eniyǝ we we, vǝ́ ŋmee ŋ́ na tɛɛ rɛ la akaakǝ we, yǝ we ŋ lɔ Wɛɛkenikenirǝ.» <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Wǝ́ Pɛtǝro ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kpǝ́ ǝ nǝŋ mǝŋ lá sɩkayǝ. O lo pu wǝ ǝkǝnǝŋ sɩkayǝ lóo koru Worokoyǝ lo tukoonuwǝ lo ofuu? <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Lá tǝrɛ wǝ laa kʊla rǝ sa. Wǝ́ tuwǝ sa wǝ laa lɛ wǝ fǝ lá fɛɛwǝ rɛ. Kpiikǝ lá ziɔŋrǝ laa kʊʊ rǝ Worokoyǝ le enimiyǝ. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Pɔrʊ ló susurɔɔrɔɔyǝ sa o co, kǝ a mwɛŋ nyuŋkpǝ e kpii Ǝtǝ Woroko la dɔɔkpɛɛrǝ. Ayɩrɛ lǝ́ǝ fǝ ló susurɔɔrɔɔyǝ sa ŋ cɛɛ lǝ́. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Kǝceece ŋ́ na nyɩŋ e lée yee nimimwɛɛrɩwǝ ŋpa. Wǝ́ turɔɔrɔɔwǝ wǝ le ri lǝ́ yurǝ.» <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Wǝ́ Sɩmɔ ŋ tìi Pɛtǝro mǝ Yowanɛsɩ ǝkǝnǝŋ: «Ŋnǝŋnǝ nǝ kpii Ǝtǝ Woroko la dɔɔkpɛɛrǝ nǝ koonu mǝ, kǝ otuyǝ sa nǝ nya tɛŋ la rɛ wǝ poo tuu mǝ.» <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Wǝ́ Pɛtǝro mǝ Yowanɛsɩ pǝ rili ɖaŋsieyǝ pǝ rù rǝ Kulǝtǝyǝ Yesu. Wǝ́ pǝ tɛnɩ Kulǝtǝyǝ Yesu le dierǝ. Wǝla kǝmaakǝ wǝ́ pǝ kpǝ̀lǝŋ pǝ ko ŋ ko Yerusalɛmǝ. Wǝ́ pǝ tɛnɩ Dieceeceerǝ we rǝ Asamariatǝtǝŋtǝǝyǝ wa.<verse eid="ACT 8:25" /></para>
  <para style="s">Filipo la tɛŋ Worokoŋtierǝ le tíi nǝnɛyeetǝmumuŋyǝ rɛ ŋ no ru rǝ Etiopi wǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Wǝ́ jirɛɛrǝ Kulǝtǝyǝ le picoŋpiyǝ rɛ ŋ tìi Filipo ǝkǝnǝŋ: «Mǝ ko rǝ kǝpɔɔlʊsiɛɛkǝ rǝ dɔŋrǝ we lo ru rǝ Yerusalɛmǝ láa sʊʊ Gaza wǝ». Rɛ lǝǝ kǝlǝ rǝ fɛɛwǝ we. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Wǝ́ Filipo ŋ yili kǝtǝrǝceŋceŋ ŋ ko ŋ ko. Kpii lóo ko mǝ dɔŋrǝ we, wǝ́ ŋ nyɩnɩ nyiyǝ rɛ. Ke ri nyimumuŋyǝ rɛ. Rù rǝ Etiopi. Nǝnɛyeetǝmumuŋyǝ rɛ ŋ lǝǝwe. Ŋwǝ ŋ náa yɩrɩ pilitieyǝ we rǝ Etiopi pǝ lóo pwo Kaŋdake la asɩkatuyǝ. Nyiyǝ sa pǝlǝ Yerusalɛmǝ ŋ pa sʊma Worokoyǝ. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Kpǝ̀lǝŋ ko ŋ ko na fɛɛwǝ rǝ. Ke kpii rǝ na gɔŋtǝŋwaarǝ. Kǝ ŋ kǝ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya la kǝfwɛɛkǝ. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Wǝ́ Wɛɛkenikenirǝ dìi Filipo ǝkǝnǝŋ: «Mǝ ko, ru ǝ kǝlǝ mǝ ŋwaarǝ we!» <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Wǝ́ Filipo ŋ sùu ŋ ko ŋ ko. Wǝ́ ŋ kolu ŋ kǝ̀lǝ mǝ ŋwaarǝ we. Wǝ́ ŋ nunu kǝ́ Etiopitǝnyiyǝ sa ŋ ya ŋ nǝ́ǝ kǝ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya la kǝfwɛɛkǝ. Wǝ́ Filipo ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «A ya lóo nuŋ tuwǝ we a ya lǝ́ǝ kǝ lo duturǝ?» <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Wǝ́ nyiyǝ sa ŋ pǝ̀ Filipo ǝkǝnǝŋ: «Ŋ́ née yee nɛ kǝ ŋ́ nuŋ wǝlo duturǝ mǝŋ rɛ loo toŋ mǝ wǝ?» Wǝ́ ŋ tìi Filipo ŋ fii ŋwaarǝ we ŋ pe tii rǝ nǝ kpǝŋ. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Wǝŋʊrʊkpǝ la fɛɛwǝ we ŋ kǝ ŋ kǝ wǝ kaamǝ wǝ ǝnǝ.</para>
  <para style="q1" vid="ACT 8:32">«Pǝ lǝ fǝ ŋwǝ pǝ lóo ko mǝŋ mɛɛyǝ pǝ loh ko pǝ ka wʊ kǝtǝ,</para>
  <para style="q1" vid="ACT 8:32">mǝŋ kǝ́ mɛɛpirǝ le sii nyuŋkpǝ ya láa yɩrɩ nyiyǝ we ŋ ya nóo pu rǝlo ɖorǝ we, kǝ́ ŋwǝ ŋkpɛ ŋ noo wuru nyuŋkpǝ wǝǝ.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Pǝ le kpii ne kǝyepukǝ. Rɛ laa tɛŋ na wǝkpaŋkpǝ ŋ koonu ŋwǝ.</para>
  <para style="q1" vid="ACT 8:33">Ǝlǝ ŋ nóo po koru awɛɛlɩ ŋ ru rǝ nǝ wǝmǝkpǝ ŋ kaŋ wǝ?</para>
  <para style="q1" vid="ACT 8:33">Kpiikǝ pǝ la wʊ ŋwǝ.»<verse eid="ACT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 8:34" />Wǝ́ nǝnɛyeetǝmumuŋyǝ sa ŋ kǝ ŋ pǝ́ Filipo ǝkǝnǝŋ: «Dɔɔkpɛ, ǝlǝ wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ ŋ reemǝ? Reemǝ na wɛ? Amaa nyipʊŋpwayǝ rɛ wǝ́ ŋ reemǝ?» <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Wǝ́ Filipo ŋ lɔ̀ kpɛɛwǝ. Saŋ rǝ fɛɛwǝ sa pǝ lǝ kǝ rǝ wǝŋʊrʊkpǝ lǝ mǝrǝ we, wǝ́ ŋ fǝ̀ Dieceeceerǝ we ŋ tìi ŋwǝ ŋ ru rǝ Yesu. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Wǝ́ pǝ kpìi pǝ ko ŋ ko mǝ gʊŋrǝ. Wǝ́ pǝ kolu pǝ rù rǝ mɛŋwǝ la fɛɛwǝ. Wǝ́ nǝnɛyeetǝmumuŋyǝ sa ŋ tɛnɩ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, mɛŋwǝ ǝwǝǝ. Kǝ́ wǝ láa kpara kǝ e wiiri mǝ worokomɛŋwǝ?» [<verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" /><note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ lǝ mǝrǝ.</char></note>] <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Wǝ́ ŋ tìi pǝ yàalǝ ŋwaarǝ sa. Wǝ́ ŋpǝ mǝ Filipo pǝ sʊ̀ʊ. Wǝ́ pǝ fìi mɛŋwǝ lǝ mǝrǝ. Wǝ́ Filipo ŋ wìiri no worokomɛŋwǝ. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Wǝ́ pǝ ru rǝ mɛŋwǝ we pǝ pǝlǝ dǝǝtǝǝrǝ. Wǝ́ Ǝtǝ Woroko la Wɛɛrǝ bǝlǝ vǝ̀ Filipo jɛ̀. Nǝnɛyeetǝmumuŋyǝ sa lǝǝ tǝ ŋ nyɩŋ ŋwǝ. Wǝ́ ŋwǝ ŋkpɛ ŋ nya faawǝ ŋ ko ŋ ko mǝ na kʊŋwǝ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Wǝ́ Filipo ŋwǝ paa ŋ kolu ŋ rù ǝrǝ Asɔ. Tǝŋtǝ ri ŋ tǝŋtǝ ŋ née fii we, láa tɛŋ Dieceeceerǝ sa. Wǝ́ ŋ kolu ŋ fìi ǝrǝ Sezare.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Kulǝtǝyǝ Yesu lo ku mǝ Sɔlʊ wǝ́ Sɔlʊ ŋ na siɛrɩ vɔrʊrǝ</para>
  <para style="r">(<ref loc="ACT 22:6-16">22:6-16</ref>, <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Eniyǝ we mǝrǝ we, Sɔlʊ re ya lée kpii Kulǝtǝyǝ lo otukarǝtǝpǝ sa la awɛɛlɩkǝ rǝ ko, ǝkǝnǝŋ ŋ náa wʊlʊ pǝ taa. Wǝ́ ŋ kolu ŋ nyɩnɩ toolutǝmumuŋyǝ. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Wǝ́ Sɔlʊ ŋ tìi ŋwǝ ŋ yee wǝfwɛɛkpǝ ŋ koonu ŋwǝ, ŋ re ŋ ko koonu rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ we yǝ kpii rǝ Damasǝko wǝ. Wǝ́ mǝŋ la nyɩŋ enyipǝ rɛ pǝ tɛɛmǝ Kulǝtǝyǝ la kʊŋwǝ we, kǝ ŋ nya fɛɛ ŋ lɔ pǝ ŋ re ŋ pǝ Yerusalɛmǝ, mǝŋ etie mǝŋ ǝpǝrǝŋ. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Wǝ́ Sɔlʊ ŋ yili ŋ ko ŋ ko. Kpii lóo ko, kǝ́ ŋ nǝ kǝ kǝlǝ mǝ Damasǝko we, kǝtǝrǝceŋceŋ wǝ́ wǝnyɩɩnɩkpǝ rɛ wǝ rù rǝ oŋuŋkǝ wǝ pǝlǝ wǝ cò wǝ sìri ŋwǝ. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Wǝ́ ŋ rù ŋ tɔ̀ɔ. Wǝ́ ŋ nunu kpɛɛwǝ rɛ wǝ ya wǝ lée tíi ŋwǝ ǝkǝnǝŋ: «Sɔlʊ, Sɔlʊ, kǝ́ kǝto wǝ́ e le yi a la tɛɛ rǝ mǝ ǝnǝ?» <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Wǝ́ ŋ yìili ŋ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋlǝ́ ǝlǝ ǝ lǝǝwe?» Wǝ́ kpɛɛwǝ we wǝ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ Yesu ŋ́ lǝǝwe. Ŋmǝ wǝ́ e le yi a la tɛɛ rǝ wǝ. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Paape yi kǝ e mǝ fii tǝŋtǝǝwǝ sa lǝ mǝrǝ. Pǝ lée ke tíi lǝ́ tuwǝ we wǝ kpii kǝ e yee wǝ.» <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Wǝ́ nǝ ǝtǝŋpǝ we pǝ ke siimǝ ŋwǝ pǝ kpǝ̀ pǝ yàa, pǝ lǝǝ lǝmǝ wǝ pǝ láa tɛŋ. Pǝ yà pǝ ko ŋ nuŋ kpɛɛwǝ we, paa pǝ laa nyɩŋ rɛ. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Wǝ́ Sɔlʊ ŋ yili rǝ kǝtǝǝwǝ. Wǝ́ ŋ wùru enimiyǝ, paape laa nyɩŋ. Wǝ́ pǝ tà ŋwǝ mǝ aka mǝ aka pǝ rè pǝ kolu pǝ fìi Damasǝko. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Wǝ́ ŋ tǝ̀rǝ ŋ tini wǝcukpǝ wǝta, lee ri, loo ŋuŋ.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Rǝ eniyǝ we lǝ mǝrǝ we, anyɩŋ Yesu lo tukarǝtǝyǝ rɛ ke kpii rǝ Damasǝko. Ŋwǝ ŋ ri Anania. Wǝ́ Kulǝtǝyǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ rǝ kǝtʊkpɛɛkǝ. Wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Anania», wǝ́ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ, Kulǝtǝyǝ.» <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Wǝ́ Kulǝtǝyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi kǝ o mǝ ko dɔŋrǝ we pǝ lóo pwo Dɔŋkʊʊrǝ wǝ. Mǝ ko Yuda la nyarǝwǝ, kǝ ǝ kǝ pǝ́ nyiyǝ rɛ pǝ lóo pwo Sɔlʊ, ŋ no ru rǝ Taaso lo yurǝ. Ya láa mwɛŋ nyuŋkpǝ. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Wǝ́ ŋ́ na pɔrʊ nyiyǝ rɛ pǝ lóo pwo Anania ŋ́ na kaŋ ŋwǝ rǝ kǝtʊkpɛɛkǝ. Le pe fii wǝ́ ŋ na tɛɛ na wǝkaakpǝ kǝ ŋ nya fɛɛ ŋ tǝ mǝ ŋ nyɩŋ.» <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />Wǝ́ Anania ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, enyipǝ wa pǝ la tɛŋ nyiyǝ sa le dierǝ pǝ le tíi mǝ mǝŋ oturɔɔrɔɔyǝ we kpǝlo kɩɩkɩ ŋ ne yee mǝ ló otukarǝtǝpǝ we pǝ kpii rǝ Yerusalɛmǝ wǝ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />La lɔ okopiyǝ lo ru rǝ otoolutǝmumuŋpǝ lǝ kpǝŋ lǝ pǝ sa rǝ, kǝ ŋ nya fɛɛ ŋ lɔɔlʊ enyipǝ we kpǝlo kɩɩkɩ pǝ lóo pwo lá nyɩŋrǝ wǝ.» <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Paape, wǝ́ Kulǝtǝyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ ko, kpiikǝ ŋ́ na saa nyiyǝ sa ŋ́ na pɔrʊ, ŋ ri mǝ nǝnɛtuwǝ. Lóo kuŋ kǝ ǝkǝŋpʊŋpwayǝ mǝ yǝle epilipǝ mǝ Isǝrayɛlǝtǝpǝ pǝ ci mǝ nyɩŋrǝ. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Ŋmǝŋmǝ ŋ́ náa kaŋ ŋwǝ kǝ́ ŋ náa cʊʊrʊ ŋ fǝ rǝ mǝ nyɩŋrǝ kǝto.» <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />Wǝ́ Anania ŋ yili ŋ ko ŋ ko, wǝ́ ŋ kolu ŋ fìi nyarǝwǝ we. Wǝ́ ŋ tɛ̀ɛ na wǝkaakpǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ paanʊ Sɔlʊ, Kulǝtǝyǝ Yesuyǝ we ŋ pɔ̀rʊ na wɛ ŋ kanǝ lǝ́ rǝ kʊŋwǝ kǝ́ o rù ǝ kǝ ŋ pǝ we, ŋwǝ ŋ ne kpii mǝ rǝ lǝ́ kpǝŋ. Ŋwǝ ŋ ne kpii mǝ kǝ a nya fɛɛ ǝ tǝ a mǝ nyɩŋ, kǝ ǝ lǝ mǝ Wɛɛkenikenirǝ.» <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Rǝ kǝyaakǝ we, wǝ́ otuyǝ rɛ yǝ rù rǝ ne enimiyǝ yǝ tɔ̀ɔlʊ mǝŋ kǝpwɛɛkǝ la awaayǝ kǝtǝ. Wǝ́ Sɔlʊ ŋ ci ǝtǝ ŋ ka ŋ nyɩŋ. Wǝ́ ŋ yili, wǝ́ pǝ wìiri no worokomɛŋwǝ. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Wǝ́ ŋ rili. Kǝ́ ŋ ne ri ŋ na lɛ we, wǝ́ ŋ tǝ ŋ nya okopiyǝ.</para>
  <para style="s" vid="ACT 9:19">Sɔlʊ la tɛŋ Worokoŋtierǝ rǝ Damasǝko</para>
  <para style="p" vid="ACT 9:19">Sɔlʊ tini rǝ Yesu lo otukarǝtǝpǝ we pǝ kpìi rǝ Damasǝko lǝ kpǝŋ wǝ lɔ̀ eciyǝ. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Wǝ́ ŋ tɛnɩ Worokoŋtierǝ ŋ ka ŋ tɛlɩ rǝ Oyudatǝkumwɛŋnyuŋyǝ kǝtǝrǝceŋceŋ. Wǝ́ ŋ ka ŋ tɛŋ ǝkǝnǝŋ Yesu ŋ ri Worokoyǝ le piyǝ. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Enyipǝ we kpǝlo kɩɩkɩ pǝ ko ŋ nuŋ ne etieyǝ sa we, wǝ rili pǝlo mumuŋ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Mǝŋkǝ nyiyǝ sa ŋ ke ŋ pieeli enyipǝ we pǝ lóo pwo Yesu la nyɩŋrǝ sa rǝ Yerusalɛmǝ wǝ? Kǝto ŋkǝ lǝ pǝ sa ŋ pa lɔ pǝ ŋ ko koonu otoolutǝmumuŋpǝ we rǝ?» <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Paape wǝ́ Sɔlʊ ŋ tǝ ŋ ka ŋ nyɩɩ mǝ ŋ wɛɛlɩ mǝ ŋ pɔrʊ mǝ ŋ kaŋ ǝkǝnǝŋ Yesu ŋ ri Kǝrisoyǝ we. Oyudatǝpǝ we pǝ ke kpii rǝ Damasǝko pǝ lǝǝ kǝ tǝ pǝ ci wǝ pǝ lah tɛŋ pǝ tíi ŋwǝ.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Rǝ eciyǝ rɛ la kǝmaakǝ we, wǝ́ Oyudatǝpǝ sa pǝ yeli nyuŋceŋceŋ kǝ pǝ wʊ Sɔlʊ. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Wǝ́ Sɔlʊ ŋ nunu tuwǝ sa. Wǝ́ pǝ ke ŋ tii pǝ ŋ rǝŋ tǝŋtǝǝwǝ sa lo okuŋpoluyǝ mǝŋ dumu mǝŋ jɔkɔŋ, kǝ pǝ nya fɛɛ pǝ ro ŋwǝ pǝ wʊ. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Paape jirɛɛrǝ lo dumurǝ we, wǝ́ Sɔlʊ lo otukarǝtǝpǝ pǝ fǝ̀ ŋwǝ pǝ kpìi rǝ kɛŋtɛwǝ. Wǝ́ pǝ sʊ̀ʊ mǝ ŋwǝ pǝ tǝ̀nǝ rǝ giriŋrǝ we la kǝmaakǝ. <figure style="fig" alt="Paul est descendu derrière le mur dans un panier" file="hk00332c.tif" size="col" copy="Horace Knowles" ref="9:25">Pǝ lǝ fǝ Pɔlʊ pǝ le kpii rǝ kɛŋtɛwǝ wǝ́ pǝ la sʊʊ mǝ ŋwǝ pǝ lǝ tǝnǝ rǝ giriŋrǝ la kǝmaakǝ</figure><verse eid="ACT 9:25" /></para>
  <para style="s">Sɔlʊ le ke fii Yerusalɛmǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Kǝ́ Sɔlʊ ŋ ne ke fii Yerusalɛmǝ we, wǝ́ ŋ pǝ̀ ŋ ka kʊla mǝ otukarǝtǝpǝ we. Paape pǝ ko ŋ suu no vurǝ. Pǝ laa lɔ pǝ nuŋ ǝkǝnǝŋ kǝceece Sɔlʊ la siɛrɩ le yee Yesu lo tukarǝtǝyǝ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Wǝ́ Banaba ŋ fǝ̀ ŋwǝ ŋ kolu enyikpiipǝ lǝ kpǝŋ. Wǝ́ ŋ pɔ̀ pǝ la amayǝ kǝ́ Sɔlʊ ŋ nyɩnɩ Kulǝtǝyǝ rǝ gʊŋrǝ, wǝ́ ŋ wɛ̀ɛlɩ mǝ ŋwǝ wǝ. Wǝ́ ŋ lɛ̀ ŋ tìi pǝ kǝ́ Sɔlʊ ŋ tɛnɩ Dieceeceerǝ rǝ Damasǝko mǝ turutawǝ rǝ Yesu la nyɩŋrǝ wǝ. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Fǝ rǝ eniyǝ we we, wǝ́ Sɔlʊ ŋ kolu ŋ kʊ̀la mǝ enyikpiipǝ we. Wǝ́ ŋ ka ŋ tɛŋ Dieceeceerǝ mǝ turutawǝ mǝ ŋ tɛlɩ rǝ Yerusalɛmǝ lǝ tǝŋtǝǝwǝ mǝrǝ rǝ Kulǝtǝyǝ la nyɩŋrǝ. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Wǝ́ ŋ ka ŋ lɛ mǝ ŋ wɛɛlɩ mǝ ŋ tɛɛrɩ mǝ Oyudatǝpǝ we pǝ láa wɛɛlɩ Kǝhelatǝkǝ wǝ. Paape wǝ́ ŋpǝ enyipǝ sa pǝ kǝ ŋ pǝ́ pǝ wʊ ŋwǝ. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Kǝ́ apaanʊpǝ pǝ lo nuŋ tuwǝ sa we, wǝ́ pǝ fǝ̀ Sɔlʊ pǝ ko ŋ ko Sezare pǝ kolu pǝ cò kʊŋ rǝ we. Wǝ́ ŋ ko ŋ ko Taaso.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Eniyǝ we mǝrǝ wǝ́ asʊmatǝpǝ we pǝ ke kpii rǝ Yudeya kpǝlo, Galileya mǝ Samaria pǝ ci anya wǝtaarǝkpǝ. Wǝ́ Wɛɛkenikenirǝ go ŋ toŋ pǝ, wǝ́ pǝ ka ŋ ta pǝ ŋ kʊla. Wǝ́ pǝ ka ŋ tɔ pǝ ŋ yaa wǝ́ pǝ ke ŋ re vɔrʊrǝ pǝ ŋ saŋ rǝ Kulǝtǝyǝ le dierǝ.<verse eid="ACT 9:31" /></para>
  <para style="s">Pɛtǝro lo ko Lida wǝ́ ŋ na ca Ene</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Wǝ pǝlǝ wǝ yeli Pɛtǝro ke ŋ siri mǝ ŋ tɛlɩ rǝ gǝŋrǝ we kpǝlo. Wǝ́ jirɛɛrǝ ŋ pǝlǝ ŋ kolu alɔnuŋtǝpǝ we pǝ kpii rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Lida lǝ kpǝŋ. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Wǝ́ ŋ nyɩnɩ nyiyǝ rɛ pǝ lóo pwo Ene lo poolu kpɛlɩ rǝ ɖaŋraŋrǝ cɛŋnɛŋtǝwǝ wǝǝ. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ene, Yesu Kǝriso la cá lǝ́. Yi kǝ lǝ́ŋlǝ o toolu ló otuyǝ o co.» Wǝ́ ŋ yili kǝtǝrǝceŋceŋ. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Kǝ́ enyipǝ we kpǝlo pǝ kpii rǝ Lida mǝ Sarɔŋ pǝ la nyɩŋ ŋwǝ we, wǝ́ pǝ lɔ̀ Kulǝtǝyǝ pǝ nunu.<verse eid="ACT 9:35" /></para>
  <para style="s">Tabita lǝ kpǝ́ wǝ́ Pɛtǝro ŋ na saanǝ ŋwǝ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Tieyǝ rɛ ke kpii rǝ Yope. Yesu lo tukarǝtǝyǝ wǝ́ ŋ ke ri. Pǝ lóo pwo ŋwǝ Tabita. Nyɩŋrǝ sa mǝ Kǝhelatǝkǝ gaamǝ Dɔrǝkasǝ. Wǝlo duturǝ ɖi fɔkpɛyǝ. Ke ŋ yee eceeceeyǝ ŋpa, wǝ́ ŋ ko ŋ toŋ ariariatǝpǝ. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Rǝ eciyǝ we lǝ mǝrǝ we, wǝ́ ŋ pǝlǝ ŋ kǝ ŋ fǝrǝ, wǝ́ ŋ kpǝ̀. Kǝ́ pǝ le wiiri ŋwǝ pǝ la lɛ we, wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ kpɛ̀ɛlɩ rǝ baŋsʊrʊyǝ lo guŋuŋnɛŋkpǝ. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Wǝ́ otukarǝtǝpǝ we pǝ kpii rǝ Yope pǝ nunu ǝkǝnǝŋ Pɛtǝro lǝ pǝ kpii rǝ Lida. Tǝŋtǝǝwǝ sa wǝ lǝǝ lǝǝrǝ mǝ Yope. Wǝ́ pǝ kpìi enyi eyi pǝ kòonu ŋwǝ, pǝ ke tíi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ! Yi pǝra a pa yɩrɩ lǝ, pǝǝ tǝǝlǝ.» <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Wǝ́ Pɛtǝro ŋ yili kǝtǝrǝceŋceŋ ŋ sìimǝ pǝ ŋ ko ŋ ko. Kǝ́ ŋ ne ke fii we, wǝ́ pǝ conu mǝ ŋwǝ pǝ kolu baŋsʊrʊyǝ we lo guŋuŋnɛŋkpǝ we. Wǝ́ ekpeetiepǝ kpǝlo kɩɩkɩ pǝ ko ŋ ruu pǝ ŋ kǝlǝ mǝ ŋwǝ. Pǝ lée wee rǝ. Wǝ́ pǝ fǝ̀ wǝkpapikpǝ we pǝ lée kpii rǝ mǝrǝ mǝ wǝkpakpǝ we Tabita ŋ ka ŋ kala rǝ kǝ́ ŋ ke kpii vɔrʊrǝ pǝ ka ŋ kaŋ ŋwǝ. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Wǝ́ Pɛtǝro ŋ pɔ̀rʊ enyipǝ we kpǝlo kɩɩkɩ ŋ rù rǝ gukpǝ we. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ, wǝ́ ŋ mwɛnɩ nyuŋkpǝ. Wǝ́ ŋ sìɛrɩ ŋ kolu rǝ nyiǝtǝyǝ we lǝ kpǝŋ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Tabita, yi!» Wǝ́ tieyǝ sa ŋ wùru enimiyǝ. Kǝ́ ŋ na nyɩŋ Pɛtǝro we, wǝ́ ŋ yili ŋ tini. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Wǝ́ Pɛtǝro ŋ tà na akaakǝ, wǝ́ ŋ yìili ŋwǝ ŋ yàalǝ. Wǝ́ ŋ pwò alɔnuŋtǝpǝ we mǝ ekpeetiepǝ we. Wǝ́ ŋ fǝ̀ Tabita ŋ kanǝ pǝ, la saanǝ. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Wǝ́ tuwǝ sa wǝ tò kpoo rǝ Yope. Wǝ́ enyipǝ wa pǝ lɔ̀ Kulǝtǝyǝ Yesu pǝ nunu. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Pɛtǝro tini Yope wǝ pànǝ. Ke kpii rǝ Sɩmɔyǝ rɛ ŋ nóo pu afwɛɛyǝ lǝ kpǝŋ.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Worokoyǝ le picoŋpiyǝ rɛ la pɔrʊ na wɛ la kaŋ Kɔnelio wǝ́ ŋ na wɛɛlɩ mǝ ŋwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Nyiyǝ rɛ ke kpii rǝ Sezare, pǝ lóo pwo ŋwǝ Kɔnelio. Ke ri Oromatǝpǝ lo tuusiitǝkpǝŋwǝ rɛ pǝ lóo pwo Italitǝtuusiitǝkpǝŋwǝ lo mumuŋyǝ. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Ka ŋ taa Worokoyǝ lǝ kǝǝwǝ ŋpa, wǝ́ ŋpǝ mǝ na nyarǝwǝ pǝ ke ŋ yee pǝ ŋ saŋ rǝ Worokoyǝ le seyǝ sɩsiɛrɩ. Ke ŋ yee wǝceeceekpǝ mǝ ŋ koonu Oyudatǝpǝ, wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ eni ri ŋ ni mǝ ŋ pwo Worokoyǝ. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Jirɛɛrǝ la ɖiɔrǝ we, kǝ́ wǝ la ca mǝŋ eniyǝ ta we, wǝ́ ŋ nyɩnɩ Worokoyǝ le picoŋpiyǝ rɛ Kayɩŋ le pe fii nǝ kpǝŋ, wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Kɔnelio!» <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Wǝ́ Kɔnelio ŋ tɔ̀ enimiyǝ ŋ ka ŋ yɩrɩ picoŋpiyǝ we pʊrɩpʊrɩ, wǝ́ vurǝ vìi ŋwǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, kǝ́ wǝ lǝ pǝ?» Wǝ́ picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Worokoyǝ lo nuŋ ló onyuŋmwɛŋyǝ, wǝ́ ŋ na nyɩŋ lé wǝceeceekpǝ we a ya lée yee wǝ, wǝ́ ŋ na taalǝ lǝ́. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Rǝkǝsa we, kpii enyipǝ a maŋ rǝ Yope, kǝ pǝ ko pwo Sɩmɔyǝ rɛ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Pɛtǝro ŋ pǝ. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />La sʊʊrʊ rǝ Sɩmɔ pʊŋpwayǝ rɛ lǝ kpǝŋ, yǝ we ŋ nóo pu afwɛɛyǝ wǝ. Na nyarǝwǝ wǝ yaa rǝ apʊyǝ la kǝlɛɛrɩkǝ.» <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Kǝ́ picoŋpiyǝ we ŋ na pwɛyɩ we, wǝ́ Kɔnelio ŋ pwo na asʊmatǝpǝ eyi mǝ no tuusiitǝyǝ rɛ rǝ epǝ we pǝ kǝ ŋ rǝŋ ŋwǝ lǝ mǝrǝ. Ŋwǝ tuusiitǝyǝ sa ko ŋ suu Worokoyǝ <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Kǝ́ ŋ na pɔrʊ tu ri ŋ tu lǝ mǝrǝ ŋ ne tíi pǝ ŋ na lɛ we, wǝ́ ŋ kpìi pǝ rǝ Yope.<verse eid="ACT 10:8" /></para>
  <para style="s">Worokoyǝ le picoŋpiyǝ rɛ la pɔrʊ na wɛ la kaŋ Pɛtǝro</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Galǝǝrǝkǝ we, kǝ́ enyikpiipǝ we pǝ lǝh kǝlǝ mǝ Yope we, wǝ́ Pɛtǝro ŋ ka ŋ rɛ gukpǝ lo oŋuŋkǝ ŋ ka mwɛŋ nyuŋkpǝ rǝ fɛɛlǝwǝ, anyɩŋ wǝ la ca mǝŋ cɔkɔŋtiizaarǝ. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Wǝ́ kǝtɛŋkǝ kǝ pǝlǝ kǝ ka ŋ wʊ ŋwǝ, wǝ́ ŋ kǝ ŋ pǝ́ ŋ ri. Eniyǝ we pǝ ya pǝ láa caa keeriwǝ we pǝ koonu ŋwǝ we, wǝ́ ŋ lǝ̀ǝ rǝ na wɛ lǝ mǝrǝ wǝ́ ŋ nyɩnɩ tǝrɛ. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Nyɩnɩ yulaarǝ la taanǝ, wǝ́ tǝrɛ wǝ rù wǝ ka ŋ sʊʊ mǝŋ nyaŋyɔkɔɔrǝ rɛ kǝtǝ. Pǝ la ta wǝ rǝ wǝla wǝtakpǝ we wǝniǝ, wǝ́ wǝ pǝlǝ wǝ kpɛlɩ rǝ kǝtǝǝwǝ. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Wǝkparǝniǝkpǝ, akɛɛtiinipǝ mǝ ofuripǝ pǝ ke kpii rǝ nyaŋrǝ we lǝ mǝrǝ. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Wǝ́ kpɛɛwǝ rɛ wǝ wɛ̀ɛlɩ mǝ ŋwǝ ǝkǝnǝŋ: «Pɛtǝro, yi kǝ a wʊ akɛɛpǝ sa o wo!» <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Wǝ́ Pɛtǝro ŋ tɛnɩ ǝkǝnǝŋ: «Kwa! Kulǝtǝyǝ, ŋ́ nǝŋ koru, duturǝ ɖi ŋ́ fee ri tǝrɛ Worokoyǝ ŋ nǝ́ǝ kpǝlǝ wǝ́ pǝ lǝŋ lɛ pǝ ri ŋ́ nyɩŋ rǝ mǝ vɔrʊrǝ». <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />Wǝ́ kpɛɛwǝ we wǝ tǝ wǝ wɛ̀ɛlɩ mǝ ŋwǝ kǝyitǝkǝ ǝkǝnǝŋ: «Tuwǝ we Worokoyǝ ŋ na tɛŋ ǝkǝnǝŋ wǝ lǝ kenikeni we, ŋlǝ́ poo pu wǝ ǝkǝnǝŋ wǝ lǝǝ lǝ kenikeni!» <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Kpɛɛwǝ sa wǝ wɛ̀ɛlɩ pǝrǝŋwǝ kǝta. Wǝ́ tuwǝ we wǝ yili wǝ kaŋ rɛ, wǝ́ wǝ kolu wǝ nǝnǝ rǝ yulaarǝ kǝtǝrǝceŋceŋ. <figure style="fig" alt="La vision de Pierre avec les animaux" file="WA03963b.tif" size="col" copy="Graham Wade" ref="10:12">Worokoyǝ la pɔrʊ nyaŋmumuŋrǝ rɛ kpii mǝ akɛɛpǝ kpookpoo la kaŋ Pɛtǝro</figure><verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Eniyǝ we Pɛtǝro ŋ ya ŋ nóo pu yurǝ rǝ na wɛ lǝ mǝrǝ mǝ ŋ ru rǝ tuwǝ we ŋ na nyɩŋ we, wǝ́ Kɔnelio le enyikpiipǝ we pǝ kǝ ŋ pǝ́ Sɩmɔ la nyarǝwǝ lo yurǝ. Pǝ pǝlǝ pǝ ka ŋ ca pǝla ŋwaarǝ. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Wǝ́ pǝ ko ŋ pwo pǝ ŋ pǝ́ ǝkǝnǝŋ: «Nyarǝwǝ sa wǝ́ Sɩmɔ, yǝ we pǝ lóo pwo Pɛtǝro ŋ na sʊʊrʊ wǝ?» <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Anyɩŋ Pɛtǝro tǝ tini lóo pu yurǝ mǝ ŋ ru rǝ tuwǝ we ŋ na nyɩŋ wǝ, wǝ́ Wɛɛkenikenirǝ dìi ŋwǝ ǝkǝnǝŋ: «Yɩrɩ re, enyipǝ ata pǝ ya pǝ láa yɩrɩ lǝ́. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Yi a mǝ sʊʊ, kǝ e siimǝ pǝ o mǝ ko. Poo tuuru, duturǝ ɖi ŋmǝ ŋ́ ne kpii pǝ.» <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Wǝ́ Pɛtǝro ŋ sʊ̀ʊ ŋ pǝlǝ ŋ tùu enyipǝ sa, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri nyiyǝ we nǝ ya nǝ nyáa taa wǝ. Mǝ kpǝŋ wǝ taarǝ, nǝ gʊŋrǝ la amayǝ.» <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kɔnelio, otuusiitǝpǝ lo mumuŋyǝ ŋ ne kpii lǝ. Nyikʊʊyǝ wǝ́ ŋ ri, láa taa Worokoyǝ lǝ kǝǝwǝ ŋpa, wǝ́ Oyudatǝpǝ kpǝlo pǝ láa tɛŋ ne dieceeceerǝ. Worokoyǝ le picoŋpikenikeniyǝ rɛ la wɛɛlɩ mǝ ŋwǝ, wǝ́ ŋ ne tíi ŋwǝ ǝkǝnǝŋ ŋ pǝ fǝ lǝ́ ŋ pǝ na nyarǝwǝ, kǝ ŋ nya fɛɛ ŋ nuŋ lé dierǝ.» <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Wǝ́ Pɛtǝro ŋ lɔ̀ pǝ, wǝ́ ŋ kòonu pǝ lo gukpǝ pǝ kpɛlɩ pǝ kàalǝ.</para>
  <para style="p" vid="ACT 10:23">Gaalǝǝrǝkǝ, wǝ́ Pɛtǝro ŋ sìimǝ enyikpiipǝ we ŋ ko ŋ ko. Apaanʊpǝ rɛ rǝ Yope pǝ ke sìimǝ pǝ. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Wǝ́ pǝ kolu pǝ fìi Sezare mǝ gaalǝǝrǝkǝ. Kɔnelio yà kǝ ŋ rǝŋ pǝ ŋpǝ mǝ no otuulupǝ mǝ nǝ ǝtǝŋkǝǝtaatǝpǝ we ŋ pwò wǝ. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Kǝ́ Pɛtǝro ŋ nǝ pǝ ŋ neh fii we, wǝ́ Kɔnelio ŋ kolu ŋ kù mǝ ŋwǝ, wǝ́ ŋ tɔ̀ɔ ŋ kʊnʊ ŋwǝ. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Paape wǝ́ Pɛtǝro ŋ tà ŋwǝ ŋ yìili, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi, ŋmǝ ŋkpɛ nyɩmaasɩyǝ wǝ́ ŋ ri». <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Wǝ́ pǝ tɛ̀ɛrɩ pǝ ke ŋ fii nyarǝwǝ. Wǝ́ Pɛtǝro ŋ nyɩnɩ nyikpǝŋmumuŋwǝ rɛ wǝ ke tini, <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ cii wǝ ǝkǝnǝŋ gbǝlǝrǝ wǝ́ wǝ ri wǝ koonu Yudatǝpiyǝ ŋ pǝǝ kǝlǝ mǝ nyiyǝ we ŋ nee ri Yudatǝpiyǝ amaa ŋ pee fii na nyarǝwǝ. Paape Worokoyǝ le ci la kaŋ mǝ ǝkǝnǝŋ ŋmǝ ŋ́ pǝǝ tǝ mǝ ŋ́ nyɩŋ rɛ ǝkǝnǝŋ lǝǝ lǝ kenikeni amaa laa laka. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Tuwǝ kǝto, kǝ́ pǝ le kpii pǝ po pwo mǝ we, ŋ́ nǝǝ sǝ́ŋ. Rǝkǝsa ŋ́ nǝ́ǝ pǝ́ nǝ, kǝ́ kǝto wǝ́ nǝ nye kpii pǝ po pwo mǝ wǝ?» <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />Wǝ́ Kɔnelio ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ruŋruŋ juutatǝrǝ wǝǝ, wǝ lǝ́ǝ mǝ lǝ mǝŋ eniyǝ sa, anyɩŋ ɖiɔrǝ le eniyǝ ta yǝ la ca. Wǝ́ ŋ́ yà ŋ́ ka ŋ mwɛŋ nyuŋkpǝ rǝ mǝ nyarǝwǝ. Kǝtǝrǝceŋceŋ ko wǝ́ nyiyǝ rɛ ŋ pǝlǝ ŋ yàa rǝ mǝ kǝnyɩŋkǝ, le kpii wǝkpakpɛɛlɩkpǝ fuu wǝ lée sie ŋaŋa. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Wǝ́ ŋ tìi mǝ ǝkǝnǝŋ: “Kɔnelio, Worokoyǝ lo nuŋ ló nyuŋmwɛŋwǝ, wǝ́ ŋ na taalǝ lé wǝceeceeyeekpǝ. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Kǝto kpii enyipǝ rǝ Yope pǝ ko pwo Sɩmɔ, yǝ we pǝ lǝ́ǝ tǝ pǝ ŋ pwo Pɛtǝro ŋ pǝ. La sʊʊrʊ rǝ Sɩmɔ lǝ kpǝŋ, yǝ we ŋ nóo pu afwɛɛyǝ wǝ. Na nyarǝwǝ wǝ yaa rǝ apʊyǝ la kǝlɛɛrɩkǝ”. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Fɛɛwǝ kǝto ŋ́ ne kpii enyipǝ kǝtǝrǝceŋceŋ, pǝ po pwo lǝ́ pǝ pǝ, wǝ́ wǝ lo poŋ mǝ lǝ́ ǝ pǝ. Rǝkǝsa loh kpǝlo la yaa rǝ Worokoyǝ la kǝnyɩŋkǝ, kǝ lo nuŋ tu ri ŋ tu Kulǝtǝyǝ ŋ ne tíi lǝ́ e pe tíi lǝ wǝ.»<verse eid="ACT 10:33" /></para>
  <para style="s">Pɛtǝro le etietɛŋyǝ</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Wǝ́ Pɛtǝro ŋ lɔ̀ kpɛɛwǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Rǝkǝsa ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ Worokoyǝ lǝŋ lɛmɩ ŋ yuu rɛ. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Rǝ ǝkǝŋyǝ kpǝlo, ŋlǝ́ yǝ we o lóo suu Worokoyǝ, wǝ́ a láa saŋ rǝ wǝkʊʊkpǝ we, Worokoyǝ lǝ kǝǝtaawǝ wǝ láa tɛɛmǝ lǝ́. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Lǝ fǝ ne dierǝ la maŋ Isǝrayɛlǝtǝpǝ. Wǝtaarǝkpǝ le Dieceeceerǝ we ŋ nǝ fǝ ŋ na maŋ saŋ rǝ Yesu Kǝriso, yǝ we ŋ ri enyipǝ kpǝlo lo Kulǝtǝyǝ wǝ. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Nǝ cii tuwǝ we wǝ lǝ pǝ rǝ Yudeya kpǝlo. Wǝ le tie rǝ Galileya, kǝ́ Yowanɛsɩ ŋ na tɛŋ worokomɛŋwiiriwǝ le dierǝ ŋ na lɛ wǝ. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Nǝ cii kǝ́ Worokoyǝ ŋ màa Wɛɛkenikenirǝ lo okopiyǝ yǝ sʊ̀ʊ rǝ Nazarɛtǝtǝ Yesu, wǝ́ ŋ yeli wǝceeceekpǝ ŋ ka ŋ tɛlɩ, wǝ́ ŋ ka ŋ cá enyipǝ we satana ŋ na parǝ wǝ, duturǝ ɖi Worokoyǝ ka kʊla mǝ ŋwǝ. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Ŋlǝ le ri anǝnɛyǝ we ŋ yeli kpǝlo kɩɩkɩ rǝ Oyudatǝpǝ lǝ gǝŋrǝ mǝ Yerusalɛmǝ la araŋsielǝtǝpǝ. Ŋwǝ nyiyǝ sa wǝ́ pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ pǝ wʊlʊ wǝ. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Paape juutatǝrǝ we, wǝ́ Worokoyǝ ŋ saanǝ ŋwǝ, wǝ́ ŋ pɔ̀rʊ ŋwǝ ŋ kanǝ enyipǝ. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Ŋkǝ nyi ri ŋ nyi wǝ́ Worokoyǝ ŋ pɔ̀rʊ Yesu ŋ kanǝ, paa pɔ̀rʊ ŋwǝ kanǝ epǝ we ŋ na saa ŋ na pɔrʊ ǝrǝ kǝsǝŋkǝ, ŋlǝ epǝ we le rili, wǝ́ lo ŋunu mǝ ŋwǝ kǝ́ ŋ nǝ kpǝ́ ŋ na saanǝ la kǝmaakǝ wǝ. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Wǝ́ ŋ nǝ pǝ́ ŋ no ru rǝ lah akaakǝ ǝkǝnǝŋ ŋlǝ la tɛŋ wǝ kǝ le ri wǝ la ɖaŋsieyǝ le tíi enyipǝ ǝkǝnǝŋ ŋwǝ Yesu, wǝ́ Worokoyǝ ŋ nǝ fǝ ŋ ne yee kpaŋtɛŋtǝyǝ ŋ no koonu epǝ we pǝ kpii vɔrʊrǝ mǝ enyiǝtǝpǝ wǝ. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Oworokokpɛɛnuŋtɛŋtǝpǝ kpǝlo kɩɩkɩ pǝ la wɛɛlɩ pǝ lo ru rǝ ŋwǝ ǝkǝnǝŋ yǝ we ŋ náa nya ŋ lɔ ŋwǝ ŋ nuŋ ko we, Worokoyǝ lǝ́ǝ fǝ no oturɔɔrɔɔyǝ ŋ cɛɛ ŋwǝ saŋ rǝ na nyɩŋrǝ lo okopiyǝ.»<verse eid="ACT 10:43" /></para>
  <para style="s">Wɛɛkenikenirǝ la sʊʊ rǝ epǝ we pǝ lee ri Oyudatǝpǝ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Eniyǝ we Pɛtǝro ŋ tǝ ŋ yà ŋ ka ŋ tɛŋ etieyǝ we we, wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ enyipǝ we pǝ yà pǝ ko ŋ nuŋ yǝ wǝ. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Oyudatǝpǝ we pǝ lɔ̀ Yesu pǝ nunu pǝ sìimǝ Pɛtǝro pǝ pǝlǝ. Kǝ́ pǝ la nyɩŋ Wɛɛkenikenirǝ la sʊʊ rǝ epǝ we pǝ lee ri Oyudatǝpǝ we, wǝ́ wǝ rili pǝlo mumuŋ. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Duturǝ ɖi pǝ yà pǝ ko ŋ nuŋ kǝ́ pǝ ya pǝ láa wɛɛlɩ wǝrǝpʊŋpwakpǝ pǝ ŋ kǝ Worokoyǝ la anaanǝkǝ. Wǝ́ Pɛtǝro ŋ tɛnɩ ǝkǝnǝŋ: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />«Rɛ lóo koru ǝsǝ́ŋ ŋ koonu enyipǝ sa pǝ la lɔ Wɛɛkenikenirǝ mǝŋ ŋlǝ kǝtǝ ǝkǝnǝŋ pǝ pee wii worokomɛŋwǝ?» <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Wǝ́ Pɛtǝro ŋ kòonu gʊŋrǝ kǝ pǝ wiiri pǝ lo worokomɛŋwǝ rǝ Yesu Kǝriso la nyɩŋrǝ. Wǝ́ pǝ tìi ŋwǝ ŋ tǝ ŋ yee eciyǝ rɛ rǝ pǝlǝ kpǝŋ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Pɛtǝro la pa pɔ nǝ ǝtǝŋpǝ we pǝ kpii rǝ Yerusalɛmǝ la amayǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Enyikpiipǝ we mǝ apaanʊpǝ we pǝ ke kpii rǝ Yudeya pǝ nunu ǝkǝnǝŋ epǝ we pǝ lee ri Oyudatǝpǝ ŋpee pǝ la lɔ Worokoŋtierǝ pǝ lo nuŋ. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Kǝ́ Pɛtǝro ŋ na siɛnɩ ŋ nǝ pǝ Yerusalɛmǝ we, wǝ́ alɔnuŋtǝpǝ we pǝ ri Oyudatǝpǝ pǝ yili pǝ ke ŋ yee etieyǝ mǝ ŋwǝ ǝkǝnǝŋ: <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />«Kǝ́ kǝto wǝ́ e le ke fii ofufoolǝtǝpǝ la nyarǝwǝ, wǝ́ ŋnǝ mǝ pǝ nǝ nyée ri wǝ?» <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Wǝ́ Pɛtǝro ŋ fǝ̀ etieyǝ we jeŋceŋ jeŋceŋ ǝrǝ yǝlǝ kǝsǝŋkǝ ŋ pɔ̀ pǝ la amayǝ ǝkǝnǝŋ: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />«Ŋ́ ke kpii rǝ Yope ŋ́ ka ŋ mwɛŋ nyuŋkpǝ. Wǝ́ ŋ́ lǝ̀ǝ rǝ mǝ wɛ lǝ mǝrǝ. Wǝ́ ŋ́ nyɩnɩ tǝrɛ. Ŋ́ nyɩnɩ mǝŋ nyaŋyɔkɔɔrǝ rɛ kǝtǝ. Pǝ la ta wǝ rǝ wǝla wǝtakpǝ we wǝniǝ, wǝ lo ru rǝ yulaarǝ wǝ láa sʊʊ, wǝ́ wǝ pǝlǝ wǝ kpɛlɩ rǝ kǝtǝǝwǝ rǝ mǝ kpǝŋ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Wǝ́ ŋ́ yɩ̀rɩ otuyǝ we yǝ ke kpii rǝ wǝlǝ mǝrǝ sɩsiɛrɩ. Wǝ́ ŋ́ nyɩnɩ wǝkparǝniǝkpǝ, apɔɔkpaakɛɛpǝ, akɛɛtiinipǝ mǝ ofuripǝ. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Wǝ́ ŋ́ nunu kpɛɛwǝ rɛ wǝ ya wǝ lée tíi mǝ ǝkǝnǝŋ: “Pɛtǝro, yi kǝ a wʊ akɛɛpǝ sa o wo!” <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Wǝ́ ŋ́ tɛnɩ ǝkǝnǝŋ: “Kwa! Kulǝtǝyǝ, ŋ́ nǝŋ koru, duturǝ ɖi ŋ́ fee ri tǝrɛ wǝ lǝǝ lǝ kenikeni wǝ́ pǝ lǝ́ǝ kpǝlǝ ŋ́ nyɩŋ rǝ mǝ vɔrʊrǝ.” <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Wǝ́ kpɛɛwǝ we wǝ tǝ wǝ tɛnɩ kǝyitǝkǝ ǝkǝnǝŋ: “Tuwǝ we Worokoyǝ ŋ na tɛŋ ǝkǝnǝŋ wǝ lǝ kenikeni we, ŋlǝ́, paa nyɩŋ wǝ ǝkǝnǝŋ wǝ lǝǝ lǝ kenikeni.” <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Kpɛɛwǝ sa wǝ wɛ̀ɛlɩ pǝrǝŋwǝ kǝta. Wǝ́ tuwǝ we wǝ yili wǝ kaŋ rɛ, wǝ́ wǝ kolu wǝ nǝnǝ rǝ yulaarǝ. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ we, wǝ́ enyikpiipǝ ata pǝ pǝlǝ pǝ ko ŋ ru rǝ nyarǝwǝ we le ke kpii wǝ. Pǝ kpìi pǝ rǝ Sezare pǝ manǝ mǝ. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Wǝ́ Wɛɛkenikenirǝ dìi mǝ ǝkǝnǝŋ ŋmǝ ŋ́ yi ŋ́ siimǝ pǝ, ŋmǝ ŋ́ poo tuuru. Apaanʊpǝ sa akʊraŋ ŋ́ ne re ŋ́ nǝ pǝ we, pǝ sìimǝ mǝ pǝ kolu. Wǝ́ loh kpǝlo le fìi Kɔnelio la nyarǝwǝ. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Wǝ́ ŋ fǝ̀ amayǝ ŋ pɔ̀ lǝ, kǝ́ ŋ nyɩnɩ picoŋpiyǝ rɛ ŋ na pa yaa ŋwǝ rǝ nyarǝwǝ wǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ ŋ kpii enyipǝ rǝ Yope pǝ ko pwo Sɩmɔ, yǝ we pǝ lǝ́ǝ tǝ pǝ ŋ pwo Pɛtǝro ŋ pǝ. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Kǝ ŋ pa tɛŋ etieyǝ we yǝ láa pɔrʊ ŋwǝ Kɔnelio mǝ na nyarǝwǝ ŋ tíi pǝ. <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Kǝ́ ŋ́ ne tie awɛɛlɩkǝ we, wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ pǝ mǝŋ kǝ́ zʊ̀ʊ rǝ lǝ mǝ jisǝsǝŋrǝ we kǝtǝ. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Wǝ́ ŋ́ tàalǝ Kulǝtǝyǝ Yesu le dierǝ we ŋ tɛnɩ ǝkǝnǝŋ: “Yowanɛsɩ le wiiri enyipǝ lo worokomɛŋwǝ mǝ mɛŋwǝ. Paa ŋnǝ we, Worokoyǝ lǝ́ǝ fǝ Wɛɛkenikenirǝ ŋ wiiri nǝ”. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Wɛɛkenikenirǝ we Worokoyǝ ŋ kòonu lǝ kǝ́ la lɔ̀ Kulǝtǝyǝ Yesu Kǝriso lo nunu we, ŋrǝ Wɛɛkenikenirǝ sa ke la sʊʊ rǝ enyipǝ sa. Mǝŋ wǝ lǝ ǝnǝ wǝǝ, kǝ́ lo okopi wǝ́ ŋmǝ Pɛtǝro ŋ́ lǝǝmǝ ŋ́ nǝh sǝ́ŋ tuwǝ ŋ́ koonu Worokoyǝ wǝ?» <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />Kǝ́ pǝ lo nuŋ Pɛtǝro le etieyǝ sa we, wǝ́ lɛrǝ dàarǝ pǝ, wǝ́ pǝ kǝ ŋ kǝ Worokoyǝ ǝkǝnǝŋ: «We Worokoyǝ la pɔrʊ gʊŋrǝ kǝ epǝ we pǝ lee ri Oyudatǝpǝ ŋpee pǝ siɛrɩ pǝla wɛ, kǝ pǝ tíi vɔrʊrǝ!»<verse eid="ACT 11:18" /></para>
  <para style="s">Alɔnuŋtǝpǝ we pǝ kpii rǝ Aŋtiokia</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Kǝ́ Oyudatǝpǝ pǝ wʊlʊ Etiɛnɩ pǝ lɛ̀ la kǝmaa we, wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ alɔnuŋtǝpǝ. Tuwǝ kǝto alɔnuŋtǝpǝ sa pǝ canǝ awɛ wǝǝ. Wǝ́ arɛɛpǝ pǝ ko ŋ ko Fenisi, arɛɛpǝ pǝ fǝ̀ rǝ Kipǝro, wǝ́ arɛɛpǝ pǝ ko ŋ ko Aŋtiokia. Oyudatǝpǝ ko wǝ́ pǝ ka ŋ tɛŋ Worokoŋtierǝ pǝ ŋ tìi. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Paape, kǝ́ epǝ we pǝ ke ri Ekipǝrotǝpǝ mǝ Esirɛnǝtǝpǝ pǝ le pe fii Aŋtiokia we, wǝ́ pǝ ka ŋ tɛŋ Kulǝtǝyǝ Yesu le Dieceeceerǝ we pǝ ŋ tíi mǝŋ Ehelatǝpǝ. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Kulǝtǝyǝ lo okopiyǝ yǝ ka kʊla mǝ pǝ, wǝ́ enyipǝ wa pǝ lɔ̀ Kulǝtǝyǝ pǝ nunu, wǝ́ pǝ sìɛrɩ pǝla wɛ. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Wǝ́ alɔnuŋtǝpǝ la wǝcakukpǝ we wǝ ke kpii rǝ Yerusalɛmǝ wǝ nunu tuwǝ sa. Wǝ́ pǝ kpìi Banaba rǝ Aŋtiokia. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Kǝ́ ŋ na ka nyɩŋ kǝ́ Worokoyǝ la lɛsiɛrɩwǝ wǝ kʊla mǝ pǝ we, wǝ́ ŋ nyà faawǝ. Wǝ́ ŋ kpìi pǝ lo okopiyǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ pǝ nyɩɩ pǝ ta Kulǝtǝyǝ Yesu pǝ re kpoŋkpoŋ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Banaba ke ri nyiceeceeyǝ rɛ ŋ lǝ̀ mǝ Wɛɛkenikenirǝ, wǝ́ ŋ kǝ lǝǝmǝ lɔnuŋrǝ ŋpa. Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ lɔ̀ Kulǝtǝyǝ wǝ nunu, wǝ́ pǝ sìɛrɩ pǝla wɛ.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Wǝ́ Banaba ŋ pwɛ̀yɩ ŋ ko ŋ ko Taaso ŋ ka taa Sɔlʊ. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Kǝ́ ŋ na ka nyɩŋ ŋwǝ we, wǝ́ ŋ rè ŋwǝ ŋ pǝlǝ Aŋtiokia. Wǝ́ pǝ pǝlǝ pǝ tini cɛŋwǝ ceŋceŋ rǝ alɔnuŋtǝpǝ we lǝ kpǝŋ, wǝ́ pǝ ka ŋ kaŋ nyikpǝŋmumuŋwǝ rɛ lo otuyǝ. Aŋtiokia wǝ́ pǝ sǝnǝ otukarǝtǝpǝ we lo opwokǝ ǝkǝnǝŋ ekǝrisotǝpǝ.<verse eid="ACT 11:26" /></para>
  <para style="s">Alɔnuŋtǝpǝ pǝ lo toŋ pǝlǝ ǝtǝŋpǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ we, wǝ́ oworokokpɛɛnuŋtɛŋtǝpǝ pǝ rù rǝ Yerusalɛmǝ pǝ pǝlǝ Aŋtiokia. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Pǝ lóo pwo rɛɛyǝ rǝ pǝlǝ mǝrǝ Agabo. Wɛɛkenikenirǝ ɖùu ŋwǝ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ wǝ lǝŋ panǝ, kǝtɛŋmumuŋkǝ rɛ kǝ lée fii rǝ ǝrǝkǝ kpǝlo. Wǝ́ kǝceece kǝtɛŋkǝ sa kǝ pǝlǝ kǝ fìi mǝ eniyǝ we pilimumuŋyǝ we pǝ lóo pwo Kǝlodǝ ŋ ke ŋ ri wǝpilikpǝ rǝ Roma lǝ gǝŋrǝ kpǝlo wǝ. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Wǝ́ Yesu lo otukarǝtǝpǝ we pǝ kpìi gbǝrǝ, kǝ nyi ri ŋ nyi ŋ koonu tuwǝ we ŋ nóo koru o koonu, kǝ pǝ fǝ pǝ toŋ apaanʊpǝ we pǝ kpii rǝ Yudeya. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Wǝ́ kǝceece pǝ kpǝ̀ gbǝrǝ sa pǝ kòonu Banaba mǝ Sɔlʊ, pǝ fǝ pǝ ko koonu alɔnuŋtǝpǝ lo omumuŋpǝ rǝ Yudeya.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Pǝ la wʊ Yakubu wǝ pǝ la lɔ Pɛtǝro pǝ la taŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />6 Eniyǝ we lǝ mǝrǝ wǝ́ piliyǝ Erodɛsɩ ŋ yili ŋ tɛ̀ɛ rǝ zʊmarǝ le enyirɛɛpǝ. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Wǝ́ ŋ kòonu pǝ wʊlʊ Yowanɛsɩ la paanʊ Yakubu mǝ tʊkʊwǝ. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Kǝ́ ŋ na nyɩŋ ǝkǝnǝŋ tuwǝ sa wǝ ponu mǝ Oyudatǝpǝ we, wǝ́ ŋ koonu pǝ lɔ̀ Pɛtǝro. Pǝ lɔ̀ ŋwǝ rǝ eciyǝ we pǝ ke ŋ ri wǝcɛkpǝ we pǝ lóo pwo keerilaanyarǝwǝ la wǝcɛkpǝ<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">Pǝ lée ri wǝcɛkpǝ sa, la gaalǝǝrǝkǝ pǝ ŋ mǝ ri eyinyapǝkǝ la wǝcɛkpǝ. Wǝle wǝyi wǝ lǝ tuceŋceŋ. Oyudatǝpǝ pǝ lée ri kpǝ pǝ ŋ fǝ pǝ ŋ taalǝ jirǝ we Worokoyǝ ŋ pɔ̀rʊ pǝ ŋ rù rǝ Ejipǝte wǝ.</char></note>. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Kǝ́ pǝ la ka lɔ Pɛtǝro we, wǝ́ Erodɛsɩ ŋ fǝ̀ ŋwǝ ŋ tanǝ, wǝ́ ŋ kòonu otuusiitǝpǝ eniǝ eniǝ fɛɛwǝ kpee niǝ pǝ ŋ rǝŋ Pɛtǝro. Kǝ́ ŋ pǝ́ pǝ ri Eyinyapǝkǝ la wǝcɛkpǝ pǝ lɛ we, kǝ pǝ tɛŋ wǝkpaŋkpǝ mǝ Pɛtǝro rǝ enyipǝ kpǝlo kɩɩkɩ le enimiyǝ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Eniyǝ we pǝ la taŋ Pɛtǝro we, wǝ́ asʊmatǝpǝ pǝ ka ŋ mwɛŋ nyuŋkpǝ kpuŋkuruŋ pǝ ŋ pwo Worokoyǝ rǝ Pɛtǝro lo yurǝ.<verse eid="ACT 12:5" /></para>
  <para style="s">Picoŋpiyǝ rɛ la pa pɔrʊ Pɛtǝro</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Erodɛsɩ pǝ̀ ŋ ru mǝ Pɛtǝro rǝ enyipǝ kpǝlo le enimiyǝ kǝ ŋ tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ. Dumurǝ we coŋ koonu gbaŋtɛŋcirǝ sa we, oturu Pɛtǝro la kpɛɛ. Pǝ la parǝ ŋwǝ mǝ akpɛtɛɛyǝ kpeewǝ yi. Kpɛlɩ rǝ otuusiitǝpǝ eyi le kǝtiitiikǝ. Otuusiitǝpǝ pǝ ka lɛ pǝ yàa rǝ guŋpolurǝ pǝ lǝ́ǝ rǝŋ gukpǝ we. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Wǝ́ Kulǝtǝyǝ le picoŋpiyǝ ŋ pǝlǝ ŋ rù rǝ gukpǝ we kǝtǝrǝceŋceŋ. Wǝ́ wǝnyɩɩnɩkpǝ rɛ wǝ kàalǝ gukpǝ sa wee. Wǝ́ picoŋpiyǝ sa ŋ cà Pɛtǝro rǝ lɛɛrɩwǝ pǝpǝ ŋ sàanǝ ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi ca!» Ko wǝ́ akpɛtɛɛyǝ we yǝ wùru rǝ na wǝkaakpǝ yǝ tɔ̀ɔ. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Wǝ́ picoŋpiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Parǝ lá apɔsɔyǝ kǝ a ca lá afʊkpayǝ la aŋwɛŋyǝ». Wǝ́ ŋ yeli mǝŋ kɔɔwe. Wǝ́ picoŋpiyǝ sa ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kpii lá kǝkpaŋuŋnɛŋkǝ kǝ e siimǝ mǝ.» <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Wǝ́ Pɛtǝro ŋ rù rǝ gukpǝ we, wǝ́ ŋ sìimǝ ŋwǝ. Pɛtǝro lee ke ci wǝ ǝkǝnǝŋ picoŋpiyǝ sa lo tuwǝ sa ŋ ya ŋ née yee we, kǝceece wǝ lǝǝwe. Fǝ̀ wǝ mǝŋ kǝtʊkpɛɛkǝ rɛ kǝ lǝǝwe. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Kǝ́ pǝ la tɛlɩ ǝrǝŋtǝsǝsǝŋpǝ mǝ eyitǝpǝ we, wǝ́ pǝ kolu pǝ tùu gukpɛɛkpǝ we lo guŋpolurǝ mǝ dʊkʊtuŋwaarǝ láa taanǝ lǝ ŋ tɛɛ rǝ tǝŋtǝǝwǝ we. Wǝ́ ŋwaarǝ we ŋrǝŋrǝ dàanǝ rǝ pǝla kǝnyɩŋkǝ. Wǝ́ pǝ rù pǝ ko ŋ ko mǝ dɔŋrǝ rɛ. Kǝtǝrǝceŋceŋ wǝ́ picoŋpiyǝ sa ŋ cɛ̀ ŋ màa Pɛtǝro. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />Fɛɛwǝ we wǝ́ Pɛtǝro ŋ ci a sàanǝ rǝ na wɛ lǝ mǝrǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Rǝkǝsa ŋ́ ne ci wǝ ǝkǝnǝŋ kǝceece Kulǝtǝyǝ le kpii ne picoŋpiyǝ la pa pɔrʊ mǝ lo ru rǝ Erodɛsɩ la akaakǝ. Wǝ́ ŋ na lɛ ŋ nǝ kǝrǝŋ mǝ ŋ no ru rǝ Oyudatǝpǝ la akpɛɛmɩrɔɔrɔɔyǝ we pǝ ya pǝ lée kpii pǝ ŋ tɛɛ rǝ mǝ wǝ.»<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Kǝ́ ŋ na nyɩŋ tuwǝ sa ŋ ne ci we, wǝ́ ŋ ko ŋ ko Yowanɛsɩ pǝ lóo pwo Marǝko le lee la nyarǝwǝ. Tieyǝ sa ŋ ri Marɩya. Enyipǝ kǝkpǝŋkǝ pǝ kùu rǝ nyarǝwǝ sa pǝ ka ŋ mwɛŋ nyuŋkpǝ. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Wǝ́ Pɛtǝro ŋ cà ŋwaarǝ. Kǝ́ gɔrʊpirǝ rɛ pǝ lóo pwo Roda ŋ ri sʊmatǝyǝ rǝ nyarǝwǝ sa ŋ no nuŋ we, wǝ́ ŋ kǝ ŋ pǝ ŋ pa taanǝ. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Wǝ́ ŋ nunu Pɛtǝro la kpɛɛwǝ ŋ cìi. Wǝ́ ŋ nyà faamumuŋwǝ rɛ ŋpa. Kaa kǝ ŋ taanǝ ŋwaarǝ we we, wǝ́ ŋ fǝ̀ ŋ sùu ŋ ke ŋ fii ŋ kolu ŋ tɛnɩ ǝkǝnǝŋ Pɛtǝro yaa rǝ koruwǝ. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «E lée fii yurǝ rǝ?» Wǝ́ ŋ ke ŋ tìi pǝ ǝkǝnǝŋ kǝceece wǝ́ ŋ́ ya ŋ́ náa tɛŋ. Wǝ́ pǝ yìili ǝkǝnǝŋ: «We Pɛtǝro le picoŋpiyǝ ŋ lǝǝwe.» <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />Eniyǝ we Pɛtǝro tǝ re ya láa ca ŋwaarǝ we rǝ. Wǝ́ pǝ kolu pǝ tàanǝ rǝ. Kǝ́ pǝ la nyɩŋ Pɛtǝro we, wǝ́ wǝ rili pǝlo mumuŋ. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Wǝ́ ŋ kàa akaakǝ ŋ kanǝ pǝ pǝ rǝŋ. Wǝ́ ŋ pɔ̀ pǝ kǝ́ Kulǝtǝyǝ ŋ pɔ̀rʊ ŋwǝ rǝ gukpɛɛkpǝ we ŋ fǝ wǝ. Wǝ́ Pɛtǝro ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ke tíi Yakubu<note caller="+" style="f"><char style="fr" closed="false">12:17 </char><char style="ft" closed="false">Yakubuyǝ sa ŋ ri Kulǝtǝyǝ Yesu la paanʊyǝ wǝ.</char></note> mǝ apaanʊtuturupǝ lǝ wǝ.» Wǝ́ ŋ rù ŋ pwɛ̀yɩ ŋ ko ŋ ko fɛɛpʊŋpwaawǝ. <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />Kǝ́ ǝrǝkǝ kǝ la kaalǝ we, wǝ́ otuusiitǝpǝ sa pǝ ko ŋ su pǝ ŋ ko pǝ ŋ pǝ. Pǝ lee ke ci tuwǝ wǝ le yee Pɛtǝro. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Wǝ́ Erodɛsɩ ŋ kpìi pǝ taa ŋwǝ, pǝ laa nyɩŋ ŋwǝ. Wǝ́ ŋ pǝ̀ otuusiitǝpǝ we pǝ kǝ ŋ rǝŋ Pɛtǝro le etieyǝ, wǝ́ ŋ kòonu kpɛɛwǝ pǝ wʊ pǝ. Wǝla kǝmaakǝ wǝ́ piliyǝ Erodɛsɩ ŋ pwɛ̀yɩ rǝ Yudeya ŋ ko ŋ ko Sezare ŋ kolu ŋ tini ko kuŋ eniyǝ rɛ.<verse eid="ACT 12:19" /></para>
  <para style="s">Piliyǝ Erodɛsɩ lǝ ǝkpǝ́kǝ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Erodɛsɩ fǝ̀ kpɛɛmʊrʊwǝ tɛ̀ɛ rǝ Etirotǝpǝ mǝ Ezidɔŋtǝpǝ. Wǝ́ pǝ yeli nyuŋceŋceŋ pǝ ka nyɩŋ ŋwǝ. Wǝ́ pǝ sanǝ rǝ piliyǝ lo kurǝŋtǝyǝ lo oŋuŋkǝ. Nyiyǝ sa ŋ ri Bǝlatusǝ. Wǝ́ pǝ kolu pǝ tìi Erodɛsɩ ŋ yee wǝtaarǝkpǝ mǝ pǝ. Duturǝ ɖi Tiro mǝ Zidɔŋ pǝ lóo ru mǝ pǝle keeriwǝ rǝ Erodɛsɩ lǝ gǝŋrǝ. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Kǝ́ jirǝ we pǝ lǝ tǝnǝ lo ro we, wǝ́ Erodɛsɩ ŋ kpìi ne wǝpilikpakpǝ ŋ kolu ŋ tini rǝ ne bilisaarǝ. Wǝ́ ŋ wɛ̀ɛlɩ ŋ tìi kǝkpǝŋkǝ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Wǝ́ enyipǝ pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Worokoyǝ rɛ ŋ ya ŋ náa wɛɛlɩ, ŋkǝ nyɩmaasɩyǝ». <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Rǝ eniyǝ we wǝ́ Kulǝtǝyǝ le picoŋpiyǝ rɛ ŋ cà Erodɛsɩ kǝtǝrǝceŋceŋ mǝ kǝ́ ŋ nǝǝ fǝ Worokoyǝ lǝ ǝkǝkǝ ŋ koonu ŋwǝ kǝto. Wǝ́ ŋ fìi akɛɛpǝ, wǝ́ ŋ kpǝ̀.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Wǝ́ Worokoŋtierǝ ga ŋ naanǝ wǝ́ ga ŋ yàarǝ. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Kǝ́ Banaba mǝ Sɔlʊ pǝ la lɛ pǝla kǝnǝnɛkǝ we mǝ alɔnuŋtǝpǝ rǝ Yerusalɛmǝ we, wǝ́ pǝ kpìi pǝ kpǝ̀lǝŋ. Wǝ́ pǝ fǝ̀ Yowanɛsɩ pǝ lóo pwo Marǝko pǝ kʊ̀la mǝ pǝla wɛ.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Wɛɛkenikenirǝ la saa Banaba mǝ Sɔlʊ la pɔrʊ wǝ́ le kpii pǝ la kʊŋwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Rǝ Aŋtiokia la zʊmarǝ mǝrǝ we, oworokokpɛɛnuŋtɛŋtǝpǝ mǝ otukaŋtǝpǝ pǝ ke kpii. Ŋpǝ pǝ kaamǝ: Banaba, Simewɔŋ yǝ we pǝ lóo pwo Nyitiyǝ, Lukio yǝ we ŋ no ru rǝ Sirɛnǝ, Manayɛnǝ yǝ we ŋ ke ri Erodɛsɩ la kɛrɩwʊrʊyǝ mǝ kǝlaatiekǝ mǝ Sɔlʊ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Jirɛɛrǝ kǝ́ pǝ ya pǝ láa sʊma Kulǝtǝyǝ rǝ nyuŋparǝwǝ lǝ mǝrǝ we, wǝ́ Wɛɛkenikenirǝ dìi pǝ ǝkǝnǝŋ: «Nǝ pɔrʊ Banaba mǝ Sɔlʊ nǝ tǝnǝ kǝta, kǝ pǝ yee kǝnǝnɛkǝ we ŋ́ no pwo pǝ pǝ pe yee wǝ.» <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Kǝ́ pǝ la parǝ nyuŋkpǝ pǝ la mwɛŋ nyuŋkpǝ pǝ la lɛ we, wǝ́ pǝ tɛ̀ɛ pǝla wǝkaakpǝ, wǝ́ pǝ màa pǝ pǝ ko ŋ ko.<verse eid="ACT 13:3" /></para>
  <para style="s">Banaba mǝ Sɔlʊ pǝ le ke fii Kipǝro</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Kǝ́ Wɛɛkenikenirǝ le kpii Banaba mǝ Sɔlʊ ǝnǝ we, wǝ́ pǝ fǝ̀ rǝ Selesi pǝ kolu pǝ fìi gbanǝŋwaarǝ pǝ ko ŋ ko Kipǝro. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Kǝ́ pǝ le ke fii Salami we, wǝ́ pǝ ka ŋ tɛŋ Worokoŋtierǝ pǝ ŋ tɛlɩ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ. Yowanɛsɩ<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Yowanɛsɩyǝ sa wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Marǝko. </char></note> ka kʊla mǝ pǝ, wǝ́ ŋ ko ŋ toŋ pǝ. <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />Kǝ́ pǝ la saŋ rǝ gbanǝcakporǝ we kpǝlo kɩɩkɩ pǝ le pe fii Pafo we, wǝ́ pǝ nyɩnɩ Yudatǝkɛrɩyǝ rɛ pǝ lóo pwo Barǝyesu. Majikilǝtǝyǝ mǝ nianiatǝkpɛɛnuŋtɛŋtǝyǝ wǝ́ ŋ ke ri. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Ke kpìi rǝ kǝŋyɩrɩtǝyǝ we pǝ lóo pwo Sɛrǝgio Pɔlʊ la nyarǝwǝ. Kǝŋyɩrɩtǝyǝ sa ke ri tucitǝyǝ. Kǝ ŋ pǝ́ ŋ nuŋ Worokoŋtierǝ, wǝ́ ŋ pwò Banaba mǝ Sɔlʊ pǝ pǝ na nyarǝwǝ. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Paape wǝ́ majikilǝtǝyǝ sa pǝ ko ŋ pwo Elimasǝ mǝ Kǝhelatǝkǝ ŋ kǝ ŋ sǝŋ Banaba mǝ Sɔlʊ la gʊŋrǝ, wǝ́ ŋ kǝ ŋ pǝ́ ŋ yee mǝ kǝŋyɩrɩtǝyǝ sa kǝ ŋ paa nya fɛɛ ŋ lɔ ŋ nuŋ. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Wǝ́ Sɔlʊ pǝ kǝ ŋ tǝ pǝ ŋ pwo Pɔlʊ ŋ lǝ̀ mǝ Wɛɛkenikenirǝ. Wǝ́ ŋ tɔ̀ enimiyǝ ŋ ka ŋ yɩrɩ ŋwǝ pʊrɩpʊrɩ, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Nianiatǝyǝ wǝ́ e ri, turɔɔrɔɔyeetǝyǝ wǝ́ e ri, Satana le piyǝ wǝ́ e ri. A lǝŋ taa tuceeceewǝ kʊrakʊra, a lǝŋ wɛɛ mǝ Kulǝtǝyǝ la akʊŋkʊʊyǝ lǝ ǝpǝlǝkǝ? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Yɩrɩ re, Kulǝtǝyǝ lah ca lǝ́ rǝkǝsa, kǝ ǝ tǝrǝ, ǝ lǝŋ tǝ a maa anyɩŋ cɔkɔŋyǝ.» Rǝ kǝyaakǝ we we, wǝ́ enimiyǝ yǝ sìi Elimasǝ tala, wǝ́ ŋ fìi nuŋtumuwǝ. Wǝ́ ŋ yà ŋ ko ŋ yo mǝ ŋ siri mǝ ŋ taa yǝ we ŋ noh coŋ mǝ ŋwǝ wǝ. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Kǝ́ kǝŋyɩrɩtǝyǝ sa ŋ na nyɩŋ tuwǝ sa ǝnǝ we, wǝ́ ŋ lɔ̀ ŋ nunu, duturǝ ɖi Kulǝtǝyǝ lo otukaŋyǝ yǝ yeli kǝnǝnɛkǝ rǝ na vɔrʊrǝ ŋpa.<verse eid="ACT 13:12" /></para>
  <para style="s">Pɔlʊ mǝ Banaba pǝ la tɛlɩ Aŋtiokia rǝ Pisidi lǝ gǝŋrǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Wǝ́ Pɔlʊ mǝ nǝ ǝtǝŋpǝ pǝ fìi gbanǝŋwaarǝ pǝ kolu pǝ sʊ̀ʊ rǝ Pɛrǝga rǝ Paŋfili lǝ gǝŋrǝ. Wǝ́ Yowanɛsɩ pǝ lóo pwo Marǝko ŋ màa pǝ rǝ we, wǝ́ ŋ sìɛnɩ ŋ kǝ ŋ pǝ Yerusalɛmǝ. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Wǝ́ Pɔlʊ mǝ Banaba pǝ fǝ̀ pǝ ko ŋ ko Aŋtiokia rǝ Pisidi lǝ gǝŋrǝ. Kǝ́ sabatǝyǝ le jirǝ lo ro we, wǝ́ pǝ kolu Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ, wǝ́ pǝ fìi pǝ kolu pǝ tini. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Kǝ́ pǝ lǝ kǝ Mose le Seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ la kǝfwɛɛkǝ pǝ la lɛ we, wǝ́ gumwɛŋnyuŋkpǝ we lo omumuŋpǝ pǝ tìi pǝ ǝkǝnǝŋ: «Apaanʊpǝ, mǝŋ nǝ lǝǝmǝ ecikaŋkǝ rɛ nǝ nyǝ́ǝ fǝ nǝ kpii kǝkpǝŋkǝ lo okopiyǝ we, yǝ lǝ fǝ kpɛɛwǝ yǝ lo koonu nǝ.» <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Wǝ́ Pɔlʊ ŋ yili ŋ yàa, wǝ́ ŋ yìili akaakǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋnǝ Isǝrayɛlǝtǝpǝ mǝ ŋnǝ epǝ we nǝ nyóo suu Worokoyǝ, nǝ nuŋ mǝ dierǝ. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ŋlǝ Isǝrayɛlǝtǝpǝ lo Worokoyǝ la saa lǝh ǝtǝtǝpǝ la pɔrʊ, wǝ́ ŋ kòonu pǝ yàarǝ mǝ eniyǝ we pǝ kolu pǝ tini rǝ Ejipǝte, wǝ́ ŋ fǝ̀ no okopiyǝ ŋ tǝ ŋ pɔ̀rʊ pǝ ŋ rù rǝ tǝŋtǝǝwǝ sa lǝ mǝrǝ. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Wǝ́ ŋ yɩ̀rɩ pǝlo yurǝ wǝ lóo ro cɛŋwǝ tǝniǝ rǝ nyɔŋkpaakǝtǝǝwǝ. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Kǝ́ ŋ na wɔɔ wǝkpǝŋkpǝ wǝpǝrɩmata rǝ Kanaŋ lǝ gǝŋrǝ we ŋ na lɛ we, wǝ́ ŋ fǝ̀ gǝŋrǝ sa ŋ kòonu pǝ kǝ ziɛrɩ yee pǝlǝ tǝtuwǝ. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Otuyǝ sa kpǝlo yǝ pǝlǝ wǝ lǝh mǝ lǝ mǝŋ cɛŋwǝ tuuruniǝ mǝ tǝtʊʊ lǝ mǝrǝ. Wǝla kǝmaakǝ, wǝ́ Worokoyǝ ŋ tìini akpaŋtɛŋtǝpǝ ŋ kòonu pǝ fǝ ko ru ǝrǝ kpɛɛnuŋtɛŋtǝyǝ we pǝ lóo pwo Samiɛlɩ le diirǝ. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Wǝ́ pǝ kǝ ŋ pǝ́ piliyǝ, wǝ́ Worokoyǝ ŋ tìini Kisǝ le pi Sawilǝ le wǝpilikpǝ ŋ koonu pǝ. Ŋwǝ Sawilǝ lo ru rǝ Bɛnǝyaminǝ la nyarǝwǝ, wǝ́ ŋ rili wǝpilikpǝ cɛŋwǝ tǝniǝ. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Kǝ́ Worokoyǝ ŋ na sʊʊrʊ mǝ Sawilǝ rǝ bilisaarǝ we we, wǝ́ ŋ fǝ̀ Davidǝ ŋ tìini wǝpilikpǝ ŋ kòonu pǝ. Ŋwǝ Davidǝ lo oŋuŋkǝ wǝ́ Worokoyǝ ŋ rili ɖaŋsieyǝ ǝkǝnǝŋ: “Ŋ́ na nya Isayi le pi Davidǝ, yǝ we ŋ́ na taa kǝǝwǝ wǝ. Ŋwǝ ŋ neh pe yee mǝ kǝtaawǝ kpǝlo.” <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Ne epilepipǝ lǝ mǝrǝ wǝ́ Worokoyǝ ŋ na pɔrʊ Yesu, kǝ ŋ pe ri Isǝrayɛlǝ la Lɔkuŋtǝyǝ mǝŋ kǝ́ ŋ cò wǝla garǝ wǝ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Kpɛŋ kǝ Yesu ŋ pǝ pǝ we, Yowanɛsɩ wɛ̀ɛlɩ tìi Isǝrayɛlǝtǝpǝ kpǝlo. Kǝ pǝ siɛrɩ vɔrʊrǝ, kǝ pǝ wiiri pǝlo worokomɛŋwǝ. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Kǝ́ Yowanɛsɩ ŋ nah lɛ na kǝnǝnɛkǝ sa we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Rǝ nǝ anyɩŋkǝ wǝǝ, ǝlǝ wǝ́ nǝ ya nǝ nyóo pu ǝkǝnǝŋ ŋmǝ ŋ́ ri? Ŋkǝ ŋmǝ ŋ́ ri nyiyǝ we nǝ ya nǝ nyǝ́ǝ rǝŋ wǝ. Paa nǝ nuŋ wǝ sɩsiɛrɩ, nyiyǝ sa kpii lǝ́ǝ pǝ rǝ mǝ kǝmaakǝ, wǝ́ ŋ́ naa kaamǝ kǝ ŋ́ pɔrʊ na afʊkpayǝ.”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />Lǝh ǝtǝŋ, ŋnǝ epǝ we nǝ ri Abǝrahamǝ le epilepipǝ mǝ nǝ epǝ we nǝ nyóo suu Worokoyǝ we, ŋlǝ wǝ́ Worokoyǝ ŋ nǝ fǝ alɔkuŋkǝ le dierǝ sa ŋ na maŋ. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Eyerusalɛmǝtǝpǝ mǝ pǝlo omumuŋpǝ pǝ laa nyɩŋ Yesu pǝ ci. Wǝ́ pǝ loo ko ŋ nuŋ etieyǝ we pǝ kǝ ŋ kǝ rǝ oworokokpɛɛnuŋtɛŋtǝpǝ la kǝfwɛɛkǝ eni ri ŋ ni mǝ sabatǝyǝ le jirǝ. Paa wǝ́ pǝ yeli pǝ sanǝ rǝ ŋyǝ etieyǝ we mǝ kǝ́ pǝ tɔ̀ɔ Yesu la bɔrǝ wǝ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Kpiikǝ pǝ laa nya diecɛtɛɛrǝ rɛ pǝ lǝh fǝ pǝ wʊ ŋwǝ kǝto we, wǝ́ pǝ tìi Pilato ŋ wʊ ŋwǝ. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Kǝ́ pǝ le yee otuyǝ we kpǝlo Worokoŋtierǝ la tɛŋ lǝ tǝnǝ rǝ Yesu lo oŋuŋkǝ pǝ la lɛ we, wǝ́ pǝ wàarǝ ŋwǝ rǝ kpɛtɛkpǝlɛciiwǝ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ ŋwàa. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Paape wǝ́ Worokoyǝ ŋ sàanǝ ŋwǝ ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Wǝ́ Yesu ŋ ka ŋ pɔrʊ na wɛ mǝ ŋ kaŋ epǝ we pǝ sìimǝ ŋwǝ pǝ ru rǝ Galileya pǝ pǝlǝ Yerusalɛmǝ wǝcukpǝ wǝpakawǝpaka. Rǝkǝsa ŋpǝ enyipǝ sa pǝ ri Yesu la araŋsielǝtǝpǝ rǝ Isǝrayɛlǝ lǝ kǝkpǝŋkǝ la kǝnyɩŋkǝ. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Ŋla ŋkpɛ, la ya yǝ láa tɛŋ Dieceeceerǝ sa le ŋ tíi nǝ. Tuwǝ we Worokoyǝ ŋ no co lǝh ǝtǝtǝpǝ la garǝ we, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />le yee wǝ lo koonu ŋlǝ epǝ we le ri pǝle epilepipǝ, mǝ kǝ́ ŋ na saanǝ Yesu ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ mǝŋ kǝ́ pǝla ŋʊrʊ rǝ Pusomǝyitǝyǝ lǝ mǝrǝ ǝkǝnǝŋ,</para>
  <para style="q1" vid="ACT 13:33">“Ŋlǝ́ e ri mǝ Piyǝ,</para>
  <para style="q1" vid="ACT 13:33">ŋmǝ ŋ́ nǝ mǝ lǝ́ ruŋruŋ”.<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />Worokoyǝ la saanǝ Yesu lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ, kǝ ŋ paa nya fɛɛ ŋ yɛɛlɩ, mǝŋ kǝ́ ŋ tɛnɩ wǝ ŋ tǝ̀nǝ ǝkǝnǝŋ: “Ŋ́ nǝ́ǝ fǝ Davidǝ la wǝpɛɛrɩkenikenikpǝ we wǝ ri wǝpɛɛrɩpoŋpikpǝ ŋ́ koonu nǝ”. <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />Tuwǝ kǝto Worokoyǝ ŋ nǝ tǝ ŋ na tɛŋ rǝ fɛɛpʊŋpwaawǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 13:35">“A lǝŋ pa maa lé nyikenikeniyǝ</para>
  <para style="q1" vid="ACT 13:35">ŋ yɛɛlɩ ŋ co rǝ wǝfuŋkpǝ”.<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />Davidǝ yeli kǝnǝnɛkǝ rǝ ne eniyǝ mǝŋ kǝ́ Worokoyǝ ŋ pǝ̀ wǝ. Wǝ́ ŋ pǝlǝ ŋ kpǝ̀. Wǝ́ pǝ ŋwàa ŋwǝ rǝ nǝ ǝtǝtǝpǝ la kǝlɛɛrɩkǝ. Wǝ́ ŋ yɛ̀ɛlɩ rǝ wǝfuŋkpǝ. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Paape yǝ we Worokoyǝ ŋ sàanǝ we, ŋwǝ paa laa yɛɛlɩ rǝ wǝfuŋkpǝ. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Kǝto mǝ apaanʊpǝ, nǝ ci wǝ ǝkǝnǝŋ ŋwǝ Yesu lo oŋuŋkǝ kǝto, wǝ́ pǝ ya pǝ láa tɛŋ oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ le dierǝ pǝ ŋ tíi nǝ. Mose le seyǝ loo koru ǝfǝ nǝ oturɔɔrɔɔyǝ ŋ cɛɛ nǝ. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Paape yǝ we ŋ náa nya ŋ lɔ Yesu ŋ nuŋ ko we, pǝ lǝ́ǝ fǝ no oturɔɔrɔɔyǝ kpǝlo kɩɩkɩ pǝ cɛɛ ŋwǝ. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Kǝto nǝ yee yurǝ, kǝ etieyǝ we oworokokpɛɛnuŋtɛŋtǝpǝ pǝ la tɛŋ pǝ lǝ tǝnǝ yǝ pee ri nǝ. <verse eid="ACT 13:40" /><verse number="41" style="v" sid="ACT 13:41" />Pǝ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 13:41">“Nǝ yɩrɩ re! Ŋnǝ epǝ we nǝ nyáa rɛɛrɩ mǝ nǝ wɛ rǝ oŋuŋkǝ,</para>
  <para style="q1" vid="ACT 13:41">Dierǝ sa ɖi nǝ mumuŋ! Kǝ nǝ kpǝ́ nǝ nǝŋ.</para>
  <para style="q1" vid="ACT 13:41">Duturǝ ɖi tuwǝ we ŋ́ neh yee rǝ nǝ diirǝ we,</para>
  <para style="q1" vid="ACT 13:41">vǝ́ rɛ la pa pɔ nǝ wǝla amayǝ we, nǝ nyǝŋ lɔ nǝ nuŋ.”»<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Kǝ́ Pɔlʊ mǝ Banaba pǝ lo ru rǝ gumwɛŋnyuŋkpǝ we we, wǝ́ enyipǝ pǝ ka ŋ tɔɔ pǝ ŋ kpɛɛ pǝ kǝ pǝ tǝ pǝ siɛnɩ pǝ pa tɛŋ dierǝ sa ke pǝ tíi pǝ mǝ sabatǝyǝ le jirǝ sa lo furu wǝ. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Kǝ́ pǝ la pɔmʊ rǝ okukǝ we we, wǝ́ Oyudatǝpǝ lǝ kpǝŋmumuŋwǝ rɛ mǝ epǝ we pǝ la siɛrɩ pǝla wɛ pǝ le yee Oyudatǝpǝ, pǝ ko ŋ ko pǝ ko co pǝ la kʊŋ. Wǝ́ Pɔlʊ mǝ Banaba pǝ ka ŋ tɛɛrɩ mǝ pǝ. Wǝ́ pǝ ke ŋ kpii pǝ lo okopiyǝ ǝkǝnǝŋ pǝ nyɩɩ pǝ tɔ pǝ yaa rǝ Worokoyǝ lǝ kǝǝtaawǝ lǝ mǝrǝ kiŋkiŋ.<verse eid="ACT 13:43" /></para>
  <para style="s">Pɔlʊ mǝ Banaba pǝ la tɛŋ Worokoŋtierǝ pǝ le tíi epǝ we pǝ lee ri Oyudatǝpǝ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Kǝ́ sabatǝyǝ le jirǝ la siɛnɩ lo po ku we, wǝ́ tǝŋtǝǝwǝ we kpǝlo wǝ pǝlǝ pǝ kù kǝ pǝ nuŋ Kulǝtǝyǝ le dierǝ. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Kǝ́ Oyudatǝpǝ pǝ la nyɩŋ nyikpǝŋmumuŋwǝ sa we, wǝ́ wǝ ke ŋ fii pǝ. Wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ Pɔlʊ. Wǝ́ pǝ ka ŋ fɛɛpɩ pǝ. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Wǝ́ pɔlʊ mǝ Banaba pǝ wɛ̀ɛlɩ pǝ tìi pǝ sɩsiɛrɩ ǝkǝnǝŋ: «Kaŋfɩ ŋnǝ wǝ́ wǝ kaamǝ kǝ la tɛŋ Worokoŋtierǝ le tíi kpɛŋ. Wǝ́ kǝ́ nǝ ya nǝ nyǝ́ǝ sǝ́ŋ rǝ, duturǝ ɖi nǝ nya nyɩŋ nǝ wɛ ǝkǝnǝŋ nǝ nyaa kaamǝ vɔrʊlaalɛɛrǝ we, we rǝkǝsa yǝ lǝ́ǝ fǝ lo mǝ ko rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Duturǝ ɖi Ǝtǝ Woroko le tíi lǝ la pa tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="ACT 13:47">“Ŋ́ nǝ fǝ lǝ́ ŋ́ ne yee wǝnyɩɩnɩkpǝ ŋ́ no koonu epǝ we kpǝlo pǝ lee ri Oyudatǝpǝ wǝ,</para>
  <para style="q1" vid="ACT 13:47">kǝ a nya fɛɛ a tɛŋ alɔkuŋkǝ le etieyǝ o ko ru ǝrǝ</para>
  <para style="q1" vid="ACT 13:47">ǝrǝkǝ la kǝkpaakǝ.”»<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Kǝ́ epǝ we pǝ lee ri Oyudatǝpǝ pǝ lo nuŋ dierǝ sa we, wǝ́ pǝ nyà faawǝ, wǝ́ pǝ yà pǝ kǝ ŋ kǝ Kulǝtǝyǝ le dierǝ. Wǝ́ epǝ we Worokoyǝ ŋ na saa ŋ nǝ tǝnǝ koonu vɔrʊlaalɛɛrǝ pǝ lɔ̀ pǝ nunu. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Wǝ́ Kulǝtǝyǝ le dierǝ dò rǝ gǝŋrǝ we kpoo. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Paape wǝ́ Oyudatǝpǝ pǝ kpìi asʊmatǝtiepǝ we pǝ kǝ lǝǝmǝ pǝla wɛ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ lo otukoŋyǝ. Wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ Pɔlʊ mǝ Banaba wǝ́ pǝ pìri pǝ rǝ pǝlǝ tǝŋtǝǝwǝ. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Wǝ́ Pɔlʊ mǝ Banaba pǝ tɛ̀rɩ naŋrǝ rǝ pǝla afʊkpayǝ pǝ tǝ̀nǝ pǝ, wǝ́ pǝ ko ŋ ko Ikonio. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Paa enyipǝ we pǝ lɔ̀ pǝ nunu rǝ tǝŋtǝǝwǝ we pǝ yà pǝ ka ŋ nya faawǝ, wǝ́ pǝ lǝ̀ mǝ Wɛɛkenikenirǝ. <figure style="fig" file="GPS_Paul1-BW.tif" size="col" copy="Wycliffe Global Alliance" ref="13:52" /><verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Pɔlʊ mǝ Banaba pǝ le ke fii Ikonio</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Kǝ́ pǝ le ke fii Ikonio we, wǝ́ pǝ tǝ pǝ kolu Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ ke. Wǝ́ pǝ kolu pǝ ka ŋ tɛŋ Worokoŋtierǝ. Wǝ́ pǝle dierǝ we pǝ yà pǝ ka ŋ tɛŋ gòonu Oyudatǝpǝ mǝ Ehelatǝpǝ le nyikpǝŋmumuŋwǝ rɛ wǝ lɔ̀ wǝ nunu. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Paape Oyudatǝpǝ la arɛɛpǝ pǝ laa lɔ pǝ nuŋ. Wǝ́ pǝ kolu pǝ kpìi epǝ we pǝ lee ri Oyudatǝpǝ lo otukoŋyǝ kǝ pǝ ŋ pu oyurɔɔrɔɔyǝ pǝ ŋ tɛɛ rǝ alɔnuŋtǝpǝ we. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Paape Pɔlʊ mǝ Banaba pǝ tìni pǝ pànǝ rǝ Ikonio. Wǝ́ pǝ tɛ̀ɛ kpɛɛwǝ rǝ Kulǝtǝyǝ pǝ ka ŋ tɛŋ Worokoŋtierǝ mǝ turutawǝ. Wǝ́ ŋ kòonu pǝ lo okopiyǝ pǝ ke ŋ yee otucovurǝ. Wǝ́ wǝ fǝ̀ wǝ kanǝ anʊkɔrǝyǝ we yǝ ke kpii rǝ na lɛsiɛrɩwǝ we le dierǝ pǝ yà pǝ ka ŋ tɛŋ wǝ. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Wǝ́ tǝŋtǝǝwǝ we wǝ sǝ̀pǝ fɛɛwǝ kpeewǝ yi. Kǝtarɛɛkǝ kǝ ke siimǝ Oyudatǝpǝ, wǝ́ kǝtarɛɛkǝ kǝ ke siimǝ enyikpiipǝ we. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Wǝ́ epǝ we pǝ lee ri Oyudatǝpǝ mǝ Oyudatǝpǝ fǝ kʊla mǝ pǝle epilipǝ pǝ rili nyuŋkpǝ kǝ pǝ pieeli pǝ kǝ pǝ tieni pǝ lo oruyǝ pǝ wʊ. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Kǝ́ Pɔlʊ mǝ Banaba pǝ la nyɩŋ wǝ pǝ le ci we, wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko Likawoni lǝ ǝtǝŋtǝǝyǝ we pǝ lóo pwo Lisǝra mǝ Dɛrǝbǝ mǝ ǝtǝŋtǝǝyǝ we yǝ kpii rǝ gaarǝ we wǝ. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Wǝ́ pǝ kolu pǝ ka ŋ tɛŋ Dieceeceerǝ we pǝ ŋ tɛlɩ rǝ fɛɛwǝ we wǝ ŋkpɛ.<verse eid="ACT 14:7" /></para>
  <para style="s">Pɔlʊ mǝ Banaba pǝ la cá sǝŋyǝ rɛ rǝ Lisǝra</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Nyiyǝ rɛ ke kpii rǝ Lisǝra. Sǝŋyǝ wǝ́ ŋ ke ri ǝrǝ na kǝlaatiekǝ. Faa saŋ rǝ na vɔrʊrǝ ŋ nyɩŋ. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Jirɛɛrǝ ko ŋ nuŋ kǝ́ Pɔlʊ ŋ yà ŋ náa wɛɛlɩ wǝ, wǝ́ Pɔlʊ ŋ tɔ̀ enimiyǝ ŋ ka ŋ yɩrɩ ŋwǝ pʊrɩpʊrɩ. Kǝ́ ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ nyiyǝ sa la lɔnuŋrǝ lóo koru aca ŋwǝ we, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />wǝ́ ŋ cà narǝwǝ kelele ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi a ya tɔŋtɔŋ!» Wǝ́ nyiyǝ we ŋ kpà ŋ yili. Wǝ́ ŋ yà ŋ ka ŋ saŋ mǝ ŋ tɛlɩ. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Kǝ́ kǝkpǝŋkǝ we kǝ la nyɩŋ tuwǝ we Pɔlʊ ŋ ne yee we, wǝ́ pǝ ka ŋ tɛŋ kelele mǝ Kǝlikawonitǝkǝ ǝkǝnǝŋ: «Oworokopǝ pǝ la siɛrɩ pǝ le yee anyɩmaasɩpǝ, wǝ́ pǝ la sʊʊ pǝ lǝ pǝ lǝh kpǝŋ.» <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Wǝ́ pǝ ko ŋ pwo Banaba ǝkǝnǝŋ Zesǝ, kǝ́ wǝ ke ri Pɔlʊ ŋ yà ŋ ka ŋ wɛɛlɩ kǝto we, wǝ́ pǝ ko ŋ pwo ŋwǝ ǝkǝnǝŋ Ɛrǝmɛsǝ.<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">Zesǝ mǝ Ɛrǝmɛsǝ pǝ ri rǝ </char><char style="ft" closed="false">Ehelatǝpǝ lo oworokopǝ.</char></note> <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Pǝlo Worokoyǝ we pǝ lóo pwo Zesǝ lo gukpǝ wǝ ka yaa rǝ tǝŋtǝǝwǝ we la kǝlɛɛrɩkǝ. Wǝ́ no toolutǝyǝ ŋ kolu ŋ fǝ̀ anɛŋnuŋyǝ pǝ lǝ fǝ otumɔŋyǝ pǝ la cɛ mǝ ŋ kǝ ŋ pǝ gukpǝ we lo guŋpolurǝ, kǝ ŋpǝ mǝ kǝkpǝŋkǝ we pǝ pa wʊ pǝ toolu pǝ koonu Pɔlʊ mǝ Banaba. <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />Kǝ́ Pɔlʊ mǝ Banaba pǝ lo nuŋ dierǝ sa we, wǝ́ pǝ làarǝ pǝla wǝkpakpǝ. Wǝ́ pǝ sùu pǝ cà anarǝyǝ pǝ ko ŋ ko rǝ kǝkpǝŋkǝ we lǝ kpǝŋ ǝkǝnǝŋ: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«Lǝh ǝtǝŋ, kǝ́ wǝ́ nǝ ya nǝ nyée yee ǝnǝ? Ŋla ŋkpɛ enyipǝ wǝ́ le ri mǝŋ ŋnǝ kǝtǝ. La ya yǝ láa tɛŋ Dieceeceerǝ sa yǝ ŋ tíi nǝ kǝ nǝ pǝǝ tǝ nǝ sʊma otukpaakpaayǝ sa. Eniyǝ we nǝ nyǝ fǝ nǝ wɛ nǝ nyo koonu Worokoyǝ we ŋ ne yee yulaarǝ, kǝtǝǝwǝ, apʊyǝ mǝ tu ri ŋ tu wǝ kpii rǝ apʊyǝ lǝ mǝrǝ wǝ. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Rǝ gakarǝ we, Worokoyǝ pɔ̀rʊ gʊŋrǝ koonu ǝpǝ ri ŋ pǝ pǝ tii vɔrʊrǝ mǝŋ kǝ́ wǝ ponu mǝ pǝ wǝ. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Paape tǝ re ya láa taa nǝ kǝǝwǝ. Ŋ koonu ŋʊŋtɛyǝ ŋ pǝ, ekeeriyǝ ǝ yǝ ŋ poŋ rǝ yǝle eniyǝ. Ŋ koonu nǝ keeriwǝ, oturu nǝ ya nǝ nyáa nya faawǝ.» <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Mǝŋ Etieyǝ sa Pɔlʊ mǝ Banaba pǝ yà pǝ ka ŋ tɛŋ pǝ ŋ tíi enyipǝ sa paape we, wǝ́ pǝ kǝ ŋ pǝ́ pǝ yee kǝsuŋkǝ we pǝ koonu pǝ taa.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Wǝ́ Oyudatǝpǝ rɛ pǝ rù rǝ Aŋtiokia mǝ Ikonio pǝ pǝlǝ pǝ kpìi kǝkpǝŋkǝ we lo otukoŋyǝ. Wǝ́ pǝ tìeni Pɔlʊ lo oruyǝ. Wǝ́ pǝ tìini ŋwǝ pǝ rù rǝ tǝŋtǝǝwǝ we. Wǝ́ pǝ ko ŋ pu wǝ ǝkǝnǝŋ lǝ kpǝ́. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Paape kǝ́ otukarǝtǝpǝ we pǝ lo co pǝ le siri ŋwǝ we, wǝ́ ŋ yili ŋ ke ŋ fìi tǝŋtǝǝwǝ we. Galǝǝrǝkǝ wǝ́ ŋpǝ mǝ Banaba pǝ pwɛ̀yɩ pǝ ko ŋ ko Dɛrǝbǝ.<verse eid="ACT 14:20" /></para>
  <para style="s">Pɔlʊ mǝ Banaba pǝ la siɛnɩ pǝ lǝ pǝ Aŋtiokia yǝ we ŋ kpii rǝ Siri</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Kǝ́ pǝ le ke fii Dɛrǝbǝ we, wǝ́ pǝ tɛnɩ Dieceeceerǝ we. Wǝ́ enyipǝ wa pǝ lɔ̀ pǝ nunu. Wǝ́ pǝ sìɛnɩ pǝ fǝ̀ rǝ Lisǝra, Ikonio mǝ Aŋtiokia yǝ we ŋ kpii rǝ Pisidi. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Wǝ́ pǝ ke ŋ kpii alɔnuŋtǝpǝ lo okopiyǝ, wǝ́ pǝ ka ŋ ta pǝlo turuwǝ pǝ tɔ pǝ yaa rǝ lɔnuŋrǝ pǝ ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ kpii kǝ la saŋ rǝ arianyɩŋyǝ lǝ mǝrǝ lo ko Worokoyǝ le wǝpilirikpǝ lǝ mǝrǝ.» <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Wǝ́ Pɔlʊ mǝ Banaba pǝ pɔ̀rʊ omumuŋpǝ pǝ kòonu zʊma ri ŋ zʊma. Wǝ́ pǝ pàrǝ nyuŋkpǝ, wǝ́ pǝ mwɛnɩ nyuŋkpǝ pǝ fǝ̀ pǝ pǝ kpìi Kulǝtǝyǝ, yǝ we pǝ la lɔ pǝ lo nuŋ, rǝ akaakǝ.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Wǝ́ pǝ fǝ̀ rǝ Pisidi pǝ pǝlǝ pǝ rù rǝ Paŋfili. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Wǝ́ pǝ tɛnɩ Worokoŋtierǝ rǝ Pɛrǝga wǝ́ pǝ fǝ̀ pǝ ko ŋ ko Atali. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Wǝ́ pǝ fìi gbanǝŋwaarǝ rǝ we pǝ kpǝ̀lǝŋ pǝ ko ŋ ko Aŋtiokia. Tǝŋtǝǝwǝ sa wǝ́ pǝ sǝnǝ pǝ fǝ̀ pǝ pǝ kpìi Lɛsiɛrɩtǝwororokoyǝ rǝ akaakǝ koonu kǝnǝnɛkǝ sa pǝ le ke yee pǝ lǝ́ǝ pǝ wǝ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Kǝ́ pǝ le pe fii Aŋtiokia we, wǝ́ pǝ kùu mǝ asʊmatǝpǝ we. Wǝ́ pǝ fǝ̀ tu ri ŋ tu Worokoyǝ ŋ ne yee pǝ pɔ̀ pǝ la amayǝ, otukpǝlo kǝ́ Worokoyǝ ŋ no koonu wǝ́ epǝ we pǝ lee ri Oyudatǝpǝ pǝ la lɔ pǝ lo nuŋ wǝ. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Wǝ́ Pɔlʊ mǝ Banaba pǝ tini wǝ pànǝ rǝ asʊmatǝpǝ we lǝ kpǝŋ.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Dierǝ lǝ pǝ rǝ Aŋtiokia la zʊmarǝ ru rǝ ǝkǝǝlǝkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Enyipǝ rɛ pǝ rù rǝ Yudeya pǝ pǝlǝ Aŋtiokia. Wǝ́ pǝ ka ŋ kaŋ apaanʊpǝ lo otuyǝ ǝkǝnǝŋ: «Mǝŋ pǝ lǝǝ kǝǝlǝ nǝ mǝŋ kǝ́ Mose le seyǝ ŋ nǝ pǝ́ wǝ kǝtǝ we, nǝ nyǝŋ koru anya alɔkuŋkǝ.» <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Pɔlʊ mǝ Banaba pǝ laa tɛɛnɩ wǝ. Wǝ́ pǝ yeli etieyǝ mǝ enyipǝ sa ŋpa. Fɛɛwǝ pǝ tɛnɩ ǝkǝnǝŋ Pɔlʊ mǝ Banaba, fǝ kʊla mǝ enyipʊŋpwapǝ pǝ ri Aŋtiokiatǝpǝ pǝ ko Yerusalɛmǝ, kǝ pǝ ke tii pǝ tɛɛrɩ mǝ enyikpiipǝ fǝ kʊla mǝ zʊmarǝ lo omumuŋpǝ ru rǝ dierǝ sa lo oŋuŋkǝ. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Wǝ́ zʊmarǝ dàa tǝrɛ pǝ fǝ̀ pǝ cò pǝla kʊŋ. Wǝ́ pǝ fǝ̀ rǝ Fenisi mǝ Samaria. Wǝ́ pǝ pɔ̀ alɔnuŋtǝpǝ rǝ we la amayǝ kǝ́ enyipǝ we pǝ lee ri Oyudatǝpǝ pǝ la lɔ Kulǝtǝyǝ Yesu pǝ lo nuŋ wǝ. Wǝ́ pǝ nyà faawǝ ŋpa. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Kǝ́ pǝ le ke fii Yerusalɛmǝ we, wǝ́ enyikpiipǝ mǝ zʊmarǝ lo omumuŋpǝ mǝ zʊmarǝ pǝ lɔ̀ pǝ sɩsiɛrɩ. Wǝ́ pǝ fǝ̀ tu ri ŋ tu Worokoyǝ ŋ ne yee ŋ na saŋ rǝ pǝ, pǝ pɔ̀ pǝla amayǝ. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Wǝ́ Afarisitǝpǝ rɛ pǝ la siɛrɩ pǝ le yee alɔnuŋtǝpǝ paa pǝ yìili ǝkǝnǝŋ, wǝ kpii kǝ pǝ kǝǝlǝ alɔnuŋtǝpǝ we pǝ lee ri Oyudatǝpǝ, kǝ pǝ tíi pǝ pǝ ŋ saŋ rǝ Mose le seyǝ.<verse eid="ACT 15:5" /></para>
  <para style="s">Pǝ lǝ sǝ ǝkǝǝlǝkǝ le dierǝ we rǝ Yerusalɛmǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Wǝ́ enyikpiipǝ we mǝ zʊmarǝ lo omumuŋpǝ pǝ kù kǝ pǝ fii rǝ dierǝ sa pǝ yɩ̀rɩ. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Wǝ́ pǝ tìini dierǝ sa ŋpa rǝ fɛɛwǝ we. Wǝ́ Pɛtǝro ŋ lɔ̀ kpɛɛwǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, nǝ cii wǝ ǝkǝnǝŋ Worokoyǝ la saa mǝ la pɔrʊ rǝ nǝ mǝrǝ wǝ la panǝ, kǝ ŋ́ nya fɛɛ ŋ́ tɛŋ Dieceeceerǝ sa ŋ́ tíi epǝ we pǝ lee ri Oyudatǝpǝ wǝ, kǝ pǝ nya fɛɛ pǝ nuŋ rǝ, kǝ pǝ lɔ pǝ nuŋ. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Worokoyǝ we ŋ cii anyɩmaasɩpǝ la asiɔŋyǝ, la pɔrʊ la kaŋ ǝkǝnǝŋ ŋ na lɔ pǝ atuu. Duturǝ ɖi lo koonu pǝ la Wɛɛkenikenirǝ mǝŋ ŋlǝ kǝtǝ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Kǝ́ wǝ ri la wɛɛ pǝla asiɔŋyǝ wǝ́ pǝ la lɔ pǝ lo nuŋ kǝto we, lee kpii wǝsǝpǝkpǝ rɛ mǝŋ tɩ rǝ ŋlǝ mǝ pǝ lǝ mǝrǝ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Rǝkǝsa kǝ́ kǝto wǝ́ la ya yǝ lóo wu Worokoyǝ wǝ? Nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ tɛɛ alɔnuŋtǝpǝ le eleeyǝ we ŋlǝ mǝ lǝh ǝtǝtǝpǝ yǝ loo koru ere wǝ! <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Paa yǝ la lɔ yǝ lo nuŋ ǝkǝnǝŋ yǝ la nya alɔkuŋkǝ saŋ rǝ Kulǝtǝyǝ Yesu la lɛsiɛrɩwǝ. Kǝ́ ŋpǝ ŋkpɛ wǝ lǝ pǝ wǝǝ.» <verse eid="ACT 15:11" /><verse number="12" style="v" sid="ACT 15:12" />Wǝ́ enyipǝ we kpǝlo pǝ rǝnǝ yiriri. Wǝ́ pǝ tini pǝ ko ŋ nuŋ kǝ́ Banaba mǝ Pɔlʊ pǝ ya pǝ láa pɔ amayǝ. Pǝ tɛnɩ kǝ́ Worokoyǝ ŋ ne yee otucovurǝ mǝ otumumuŋyǝ na saŋ rǝ pǝlo oŋuŋkǝ rǝ enyipǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Kǝ́ pǝ la wɛɛlɩ pǝ la lɛ we, wǝ́ Yakubu ŋwǝ ŋkpɛ ŋ lɔ̀ kpɛɛwǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, nǝ co kǝtukoŋkǝ rǝ mǝ kpǝŋ! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Sɩmɔ la pɔrʊ wǝlǝ mǝrǝ le tíi lǝ, wǝ́ ŋ na tɛŋ ǝkǝnǝŋ ǝrǝ kǝsǝŋkǝ wǝ́ Worokoyǝ ŋ na saa kǝkpǝŋkǝ rɛ ŋ na pɔrʊ rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ, wǝ́ ŋ na yɩrɩ pǝlo yurǝ, wǝ́ pǝ ri na anɛŋ. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Etieyǝ we oworokokpɛɛnuŋtɛŋtǝpǝ pǝ tɛnɩ pǝ tǝ̀nǝ we, yǝ kaamǝ tuwǝ sa kpaŋ. Pǝ la ŋʊrʊ ǝkǝnǝŋ:<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“Rǝ wǝla kǝmaakǝ we, ŋ́ nah pa siɛnɩ ŋ pǝ, kǝ ŋ́ siɛnɩ ŋ́ tɔ Davidǝ la nyarǝwǝ we wǝ la tɔɔ wǝ.</para>
  <para style="q1" vid="ACT 15:16">Ŋ́ náa tɛɛ ekiriŋtooyǝ we, kǝ ŋ́ yiili wǝ ŋ́ yaalǝ.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Mǝŋkǝsa we, enyituturupǝ pǝ láa taa Kulǝtǝyǝ la akʊŋyǝ,</para>
  <para style="q1" vid="ACT 15:17">mǝŋ ǝkǝŋyǝ kpǝlo kɩɩkɩ le enyipǝ we ŋ́ no pwo pǝ pe ri mǝ anɛŋ wǝ.</para>
  <para style="q1" vid="ACT 15:17">Tuwǝ Kulǝtǝyǝ ŋ na tɛŋ wǝǝ.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Ŋwǝ yǝ we ŋ na pɔrʊ otuyǝ ŋ na kaŋ enyipǝ ŋkǝ ruŋruŋ lo tu.”<verse eid="ACT 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ACT 15:19" />Wǝ́ ŋwǝ Yakubu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: “Mǝ yupurǝ gaamǝ ɖǝǝnǝ: Le cii wǝ ǝkǝnǝŋ enyipǝ sa pǝ la siɛrɩ pǝ lǝ pǝ Worokoyǝ lǝ kpǝŋ we pǝ lee ri Oyudatǝpǝ. Kǝto wǝ laa kaamǝ kǝ le kpii pǝla gbaraarǝ rɛ. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Paa kǝ la ŋʊrʊ kǝfwɛɛkǝ la maŋ pǝ, kǝ le tíi pǝ ǝkǝnǝŋ pǝ poo wo kɛɛyǝ we pǝ la wʊ pǝ lo toolu wǝfɛɛkpǝ la gakǝ, pǝ pee yee nuŋruwǝ, pǝ poo wo kɛɛyǝ we ŋ nǝ kpǝ́ cʊrʊcʊrʊ la gakǝ, kǝ pǝ paa lɛ pǝ wo jɩmɩrǝ. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Ǝrǝ gakarǝ, tǝŋtǝǝ ri ŋ tǝŋtǝǝ wǝ lǝǝmǝ enyipǝ pǝ láa wɛɛlɩ pǝ ŋ ru rǝ Mose le seyǝ pǝ ŋ tɛlɩ. Duturǝ ɖi pǝ lǝ́ǝ kǝ seyǝ sa rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ sabatǝ ri ŋ sabatǝ.”»<verse eid="ACT 15:21" /></para>
  <para style="s">Pǝ la ŋʊrʊ kǝfwɛɛkǝ pǝ la maŋ alɔnuŋtǝpǝ rǝ Aŋtiokia</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Wǝ́ enyikpiipǝ we mǝ zʊmarǝ lo omumuŋpǝ mǝ asʊmatǝpǝ we kpǝlo kɩɩkɩ pǝ tɛ̀ɛnɩ dierǝ sa, ǝkǝnǝŋ pǝ pɔrʊ enyipǝ rǝ pǝlǝ mǝrǝ pǝ siimǝ Pɔlʊ mǝ Banaba pǝ ko Aŋtiokia. Wǝ́ pǝ pɔ̀rʊ Yude pǝ lǝ́ǝ tǝ pǝ ŋ pwo Basaba mǝ Silasǝ. Enyipǝ sa pǝle eyi pǝ ke ri anyɩŋyaatǝpǝ rǝ apaanʊpǝ lǝ mǝrǝ. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Wǝ́ pǝ fǝ̀ kǝfwɛɛkǝ sa pǝ kpìi pǝ rǝ akaakǝ. Pǝ ŋʊ̀rʊ ǝkǝnǝŋ: «Ŋlǝ enyikpiipǝ we mǝ zʊmarǝ lo omumuŋpǝ mǝ apaanʊpǝ rǝ zʊmarǝ yǝ la ŋʊrʊ kǝfwɛɛkǝ sa. Yǝ lée ceeni ŋnǝ apaanʊpǝ we nǝ nyee ri Oyudatǝpǝ, wǝ́ nǝ kpii rǝ Aŋtiokia mǝ Siri mǝ Silisi wǝ. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Yǝ lo nuŋ ǝkǝnǝŋ enyipǝ rɛ pǝ lo ru rǝ lǝh mǝrǝ pǝ le pe kpii nǝ kǝwɛɛlɩkǝ. Wǝ́ pǝle etieyǝ yǝ le kpii nǝ kǝǝnǝwǝ. Ŋkǝ ŋlǝ le kpìi pǝ. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Wǝ kǝto loh kpǝlo yǝ le yee nyuŋceŋceŋ, wǝ́ yǝ la pɔrʊ enyipǝ yǝ le kpii yǝ la maŋ nǝ. Pǝ lée siimǝ lǝh ǝkǝǝtaatǝpǝ Banaba mǝ Pɔlʊ pǝ pǝ. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Banaba mǝ Pɔlʊ we, pǝ ri enyipǝ pǝ lǝ fǝ pǝla vɔrʊrǝ pǝ lo koonu loh Kulǝtǝyǝ Yesu Kǝriso la kǝnǝnɛkǝ. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Enyipǝ we yǝ le kpii yǝ la maŋ nǝ pǝ kaamǝ Yude mǝ Silasǝ. Ŋpǝŋpǝ pǝ leh pe tíi nǝ etieyǝ sa. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Wɛɛkenikenirǝ fǝ kʊla mǝ ŋlǝŋlǝ yǝ la tɛŋ wǝ. Yǝ lǝŋ tɛɛ nǝ eleeyǝ rɛ le teeri otuyǝ we yǝ lǝ kpuŋkpuruŋ kǝ nǝ yee wǝ. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Nǝ poo wo kɛɛyǝ we pǝ la wʊ pǝ lo toolu wǝfɛɛkpǝ la gakǝ. Nǝ poo wo jɩmɩrǝ amaa kɛɛyǝ we ŋ nǝ kpǝ́ cʊrʊcʊrʊ wǝ. Nǝ pee yee nuŋruwǝ. Vǝ́ nǝ nyǝ kpǝlǝ otuyǝ sa we, a láa nyɩŋ nǝ nye yee wǝ ponu ŋpa. Yǝ lée ceeni nǝ.»<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Wǝ́ pǝ cò enyipǝ sa la kʊŋ pǝ ko ŋ ko Aŋtiokia. Kǝ́ pǝ le ke fii we, wǝ́ pǝ kù mǝ alɔnuŋtǝpǝ we kpǝlo kɩɩkɩ. Wǝ́ pǝ fǝ̀ kǝfwɛɛkǝ we pǝ kòonu pǝ. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Kǝ́ pǝ lǝ kǝ kǝfwɛɛkǝ sa we, wǝ́ pǝ nyà faawǝ ŋpa. Duturǝ ɖi etieyǝ sa yǝ tà pǝlo turuwǝ ŋpa. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yude mǝ Silasǝ pǝ ri rǝ oworokokpɛɛnuŋtɛŋtǝpǝ we pǝ wɛ̀ɛlɩ pǝ tìi alɔnuŋtǝpǝ sa ŋpa wǝ. Wǝ́ wǝ tà pǝlo turuwǝ, wǝ́ wǝ kpìi pǝ lo okopiyǝ wǝ kʊla. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Wǝ́ pǝ tini tǝŋtǝǝwǝ sa wǝ kolu wǝ rò eniyǝ rɛ. Wǝ́ apaanʊpǝ sa pǝ cò pǝla kʊŋ rǝ wǝtaarǝkpǝ pǝ ko tuu epǝ we pǝ kpìi pǝ wǝ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Wǝ́ paa Silasǝ ŋ lɔ̀ ŋ tini<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ lǝ mǝrǝ.</char></note>. <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Paa Pɔlʊ mǝ Banaba pǝ sìɛnɩ pǝ tini Aŋtiokia. Wǝ́ ŋpǝ mǝ enyirɛɛpǝ wa pǝ ka ŋ kaŋ otuyǝ wǝ́ pǝ ka ŋ tɛŋ Kulǝtǝyǝ le dierǝ.<verse eid="ACT 15:35" /></para>
  <para style="s">Pɔlʊ mǝ Banaba pǝ lǝ sǝpǝ awɛ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Eciyǝ rɛ la kǝmaa we, wǝ́ Pɔlʊ ŋ tìi Banaba ǝkǝnǝŋ: «Pǝ kǝ le siri ǝtǝŋtǝǝyǝ we kpǝlo yǝ la tɛŋ Kulǝtǝyǝ le dierǝ yǝ la pa tɛlɩ wǝ. Kǝ la ka nyɩŋ kǝ́ apaanʊpǝ pǝ kpii pǝ fǝ wǝ.» <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Wǝ́ Banaba ŋ pǝ̀ pǝ re Yowanɛsɩ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Marǝko pǝ kʊla mǝ pǝla wɛ. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Pɔlʊ ŋwǝ paa laa tɛɛnɩ pǝ re ŋwǝ. Duturǝ ɖi sǝnǝ kolu pwɛ̀yɩ màa pǝ rǝ Paŋfili. Lǝǝ tǝ ŋ yee kǝnǝnɛkǝ ŋ kʊla mǝ pǝ ŋ ko. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Wǝ́ pǝ tìini dierǝ sa ŋpa. Wǝ́ pǝ sǝ̀pǝ awɛ. Wǝ́ Banaba ŋ fǝ̀ Marǝko ŋ kʊ̀la mǝ na wɛ. Wǝ́ pǝ fìi gbanǝŋwaarǝ pǝ ko ŋ ko Kipǝro <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Pɔlʊ ŋwǝ paa pɔ̀rʊ Silasǝ kʊ̀la mǝ na wɛ. Wǝ́ apaanʊpǝ pǝ fǝ̀ ŋwǝ pǝ kpìi Kulǝtǝyǝ rǝ akaakǝ. Wǝ́ pǝ pǝ́ na lɛsiɛrɩwǝ pǝ tɛ̀ɛ rǝ ŋwǝ. Wǝ́ ŋ ko ŋ ko. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Fǝ̀ rǝ Siri mǝ Silisi, wǝ́ ŋ kpìi asʊmayǝ we lo okopiyǝ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timote le siimǝ Pɔlʊ mǝ Silasǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Wǝ́ Pɔlʊ ŋ kolu ŋ fìi Dɛrǝbǝ mǝ Lisǝra. Lɔnuŋtǝyǝ rɛ ke kpii rǝ fɛɛwǝ we. Pǝ lóo pwo ŋwǝ Timote. Ne lee ŋ kaamǝ Yudatǝtieyǝ rɛ ŋ na siɛrɩ ŋ ne yee kǝrisotǝyǝ. Nǝ tǝ Ehelatǝpǝ pǝ lǝǝwe. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Apaanʊpǝ we pǝ kpii rǝ Lisǝra mǝ Ikonio pǝ wɛ̀ɛlɩ pǝ rù rǝ Timote sɩsiɛrɩ. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Pɔlʊ kǝ ŋ pǝ́ ŋ fǝ ŋwǝ ŋ re ŋ pwɛyɩ kǝto wǝ́ ŋ kǝ̀ǝlǝ ŋwǝ. Oyudatǝpǝ we pǝ ke kpii rǝ gaarǝ we kǝto wǝ́ ŋ yeli wǝ ǝnǝ, duturǝ ɖi pǝlo kpǝlo pǝ ke cii wǝ ǝkǝnǝŋ Timote lǝ tǝ ri Ehelatǝpǝ. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Vǝ́ Pɔlʊ mǝ Silasǝ pǝ la nya pǝ le fii tǝŋtǝǝwǝ rɛ ko, ǝ pǝ ŋ fǝ etieyǝ we enyikpiipǝ we mǝ zʊmarǝ lo omumuŋpǝ rǝ Yerusalɛmǝ pǝ la tɛŋ wǝ́ pǝ la tɛɛ akaa pǝ tíi alɔnuŋtǝpǝ we. Ǝ pǝ ŋ lɛ pǝ tíi pǝ, pǝ ŋ yee pǝ ŋ saŋ rǝ ŋyǝ etieyǝ sa lo oŋuŋkǝ. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Wǝ́ asʊmayǝ sa yǝ tɔ̀ yǝ yàa rǝ lɔnuŋrǝ. Wǝ́ alɔnuŋtǝpǝ pǝ ka ŋ ta pǝ ŋ kʊla ji ri ŋ ji.<verse eid="ACT 16:5" /></para>
  <para style="s">Worokoyǝ la pɔrʊ tǝrɛ la kaŋ Pɔlʊ rǝ Tǝrowa</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Wɛɛkenikenirǝ loo kuŋ Pɔlʊ mǝ Silasǝ la kʊŋwǝ pǝ tɛŋ Worokoŋtierǝ rǝ Azi. Wǝ kǝto pǝ sǝ̀ Fǝrizi mǝ Galatia la akaayǝ we pǝ tɛ̀lɩ wǝǝ. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Kǝ́ pǝ lǝ kǝ kǝlǝ mǝ Misi we, wǝ́ pǝ kǝ ŋ pǝ́ pǝ nyɩɩ pǝ ko Bitini. Paape Yesu la Wɛɛrǝ loo kuŋ pǝ la kʊŋwǝ. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Wǝ́ pǝ sǝ̀ Misi pǝ tɛ̀lɩ pǝ ka ŋ sʊʊ Tǝrowa. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Wǝlo dumurǝ, wǝ́ Worokoyǝ ŋ pɔ̀rʊ tǝrɛ ŋ kanǝ Pɔlʊ. Wǝ́ ŋ nyɩnɩ Makedoniatǝnyiyǝ rɛ yàa. Wǝ́ ŋ ke ŋ kpii Pɔlʊ la dɔɔkpɛɛrǝ ǝkǝnǝŋ: «Fǝ rǝ Makedonia, kǝ a pa lɔ o koonu lǝ.» <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Kǝ́ Pɔlʊ ŋ na nyɩŋ tuwǝ sa we, wǝ́ le yili kǝtǝrǝceŋceŋ lo ko ŋ ko Makedonia. Duturǝ ɖi yǝ la nyɩŋ wǝ yǝ le ci ǝkǝnǝŋ Worokoyǝ ŋ no pwo lǝ la ka tɛŋ Dieceeceerǝ we le tíi enyipǝ we pǝ kpii rǝ gaarǝ we wǝ.<verse eid="ACT 16:10" /></para>
  <para style="s">Lidia rǝ Filipi la lɔ Kulǝtǝyǝ Yesu lo nuŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Le fìi gbanǝŋwaarǝ rǝ Tǝrowa lo ko ŋ ko kǝtǝrǝceŋceŋ ǝrǝ Samorake. Gaalǝǝrǝkǝ wǝ́ lo ko ŋ ko Napoli. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Wǝ́ lo rù rǝ we lo kolu Filipi. Filipi ŋ ri tǝŋtǝǝmumuŋwǝ rǝ Makedonia lǝ gǝŋrǝ wǝ. Oromatǝpǝ lǝ tǝŋtǝǝwǝ wǝ lǝǝwe. La lɔ̀ eciyǝ rǝ tǝŋtǝǝwǝ sa. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Sabatǝyǝ le jirǝ we, wǝ́ lo rù rǝ tǝŋtǝǝwǝ sa lo kolu kpanǝwǝ rɛ kǝlɛɛrɩkǝ. Lǝ kǝ ŋ kǝ wǝ ǝkǝnǝŋ yǝ láa nyɩŋ Oyudatǝpǝ la fɛɛmwɛŋnyuŋkpǝ rɛ rǝ we. Wǝ́ la sɔ̀ le tini la ka ŋ wɛɛlɩ mǝ etiepǝ rɛ pǝ kù pǝ ka yaa rǝ fɛɛwǝ we wǝ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Etiepǝ sa la rɛɛyǝ ŋ ri Lidia. Rù rǝ Tiatira. Ke ŋ siiri anyaŋmwɛɛrɩyǝ yǝ la lɔ okuruyǝ ŋpa wǝ. Wǝ́ ŋ ka ŋ sʊma Worokoyǝ. Tieyǝ sa yà ko ŋ co kǝtukoŋkǝ rǝ lǝh kpǝŋ, wǝ́ Kulǝtǝyǝ ŋ rù na ziɔŋrǝ kǝ Pɔlʊ le etieyǝ sa yǝ nya fɛɛ yǝ tɔɔ no otukoŋyǝ. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Kǝ́ pǝ le wìiri no worokomɛŋwǝ ŋpǝ mǝ na anyarǝtǝpǝ pǝ la lɛ we, wǝ́ ŋ yà ŋ ka ŋ tɔɔ mǝ ŋ kpɛɛ lǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: «Mǝŋ nǝ nya tɛɛnɩ ǝkǝnǝŋ ŋ́ na lɔ Kulǝtǝyǝ Yesu ŋ́ no nuŋ kǝceece we, we nǝ mǝ pǝ nǝ pa sʊʊrʊ rǝ mǝ nyarǝwǝ.» Wǝ́ ŋ ka ŋ nyɩɩ mǝ lǝ kǝ la tɛɛnɩ.<verse eid="ACT 16:15" /></para>
  <para style="s">Pǝ la lɔ Pɔlʊ mǝ Silasǝ pǝ la taŋ rǝ Filipi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Jirɛɛrǝ lo rù lo ko ŋ ko fɛɛmwɛŋnyuŋkpǝ. Wǝ́ gɔrʊpirǝ rɛ ɖù bǝlǝ gù mǝ lǝ. Rɔŋyǝ wǝ́ ŋ ke ri, wǝ́ wɛɛrɔɔrɔɔrǝ rɛ ge kpii rǝ ŋwǝ. Wǝ́ ŋ ka ŋ kpaa mǝ ŋ tíi enyipǝ. Na akpaakǝ sa kǝ kǝ ŋ pǝ mǝ sɩkayǝ kǝ ŋ koonu no okulǝtǝpǝ ŋpa. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Wǝ́ gɔrʊpirǝ sa dɛ̀ɛmǝ lǝ ga ŋ tɛlɩ, ŋlǝ mǝ Pɔlʊ. Wǝ́ ga ŋ wɛɛlɩ kelele lǝ ŋ tɛŋ ǝkǝnǝŋ: «Enyipǝ sa pǝ láa sʊma Worokoyǝ ŋ tɛɛ rǝ oŋuŋkǝ wǝ. Pǝ ya pǝ láa wɛɛlɩ pǝ ŋ kaŋ kǝ́ nǝ nyée yee kǝ nǝ nya alɔkuŋkǝ.» <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Ke ŋ yee tuwǝ sa wǝ lɔ̀ eciyǝ. Wǝ́ wǝ pǝlǝ wǝ fìi Pɔlʊ, wǝ́ ŋ sìɛrɩ ŋ tìi wɛɛrǝ we ǝkǝnǝŋ: «Rǝ Yesu Kǝriso la nyɩŋrǝ, ru rǝ nǝ mǝrǝ». Wǝ́ wɛɛrǝ we ɖù rǝ kǝyaakǝ we. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />Kǝ́ gɔrʊpirǝ we lo okulǝtǝpǝ pǝ la nyɩŋ wǝ pǝ le ci ǝkǝnǝŋ kpɛɛtɛɛwǝ rɛ wǝ lǝǝ kǝ tǝ wǝ kpii pǝ pǝ pa nya sɩkayǝ saŋ rǝ gɔrʊpirǝ sa we, wǝ́ pǝ lɔ̀ Pɔlʊ mǝ Silasǝ. Wǝ́ pǝ fǝ̀ pǝ pǝ kolu canɩyǝ rǝ epilipǝ la kǝnyɩŋkǝ. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Wǝ́ pǝ fǝ̀ pǝ pǝ kolu Oromatǝkpaŋtɛŋtǝpǝ<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Rǝ gakarǝ we, Oromatǝpǝ pǝ ke ŋ ri wǝpilikpǝ rǝ Oyudatǝpǝ lo oŋuŋkǝ.</char></note> lǝ kpǝŋ. Wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Enyipǝ sa pǝ ya pǝ lée kpii kǝwɛɛlɩkǝ rǝ lǝh tǝŋtǝǝwǝ sa. Oyudatǝpǝ wǝ́ pǝ ri. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Pǝ ya pǝ láa kaŋ kǝsuŋkǝ rɛ. Wǝ́ wǝ laa laka kǝ ŋlǝ Oromatǝpǝ la tɛɛnɩ, amaa kǝ le yee kǝ.»<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Wǝ́ kǝkpǝŋkǝ ŋke kǝ yili kǝ tɛ̀ɛ rǝ pǝ. Wǝ́ Oromatǝkpaŋtɛŋtǝpǝ sa pǝ tìi enyipǝ pǝ pɔrʊ Pɔlʊ mǝ Silasǝ la wǝkpakpǝ. Wǝ́ pǝ tìi pǝ culu pǝ mǝ fwɛɛpǝlawǝ. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Kǝ́ pǝ lo culu pǝ sɩsiɛrɩ pǝ la lɛ we, wǝ́ pǝ kolu pǝ tanǝ pǝ. Wǝ́ pǝ tìi nyiyǝ we ŋ nǝ́ǝ rǝŋ gukpɛɛkpǝ sa mǝ ŋ yɩrɩ pǝ sɩsiɛrɩ. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Kǝ́ pǝ la kaŋ pǝ le tíi ŋwǝ ǝnǝ we, wǝ́ ŋ fǝ̀ pǝ ŋ kolu ŋ kpìi rǝ gumǝnɛŋkpǝ. Wǝ́ ŋ kpìi pǝlo gborǝ rǝ akparǝyǝ. <verse eid="ACT 16:24" /><verse number="25" style="v" sid="ACT 16:25" />Kǝ́ kǝ la cɩɩ kǝ lǝ sǝpǝ we, wǝ́ Pɔlʊ mǝ Silasǝ pǝ yà pǝ ka ŋ mwɛŋ nyuŋkpǝ, wǝ́ pǝ ka ŋ nɔŋ pǝ ŋ kǝ Worokoyǝ. Wǝ́ okukpɛɛtǝtuturupǝ we pǝ yà pǝ ko ŋ nuŋ pǝ. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Kǝtǝrǝceŋceŋ wǝ́ kǝtǝǝwǝ wǝ tìkili ŋpa. Wǝ́ gukpǝ we le ekiriŋyǝ yǝ tìkili ru ǝrǝ kǝtɛɛkǝ. Rǝ kǝyaakǝ we wǝ́ gukpɛɛkpǝ sa la aŋwaayǝ kpǝlo kɩɩkɩ yǝ tàanǝ. Wǝ́ akpɛtɛɛyǝ we pǝ le kpii okukpɛɛtǝpǝ we kɩɩkɩ yǝ wùru yǝ tɔ̀ɔlʊ. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Kǝ́ rǝŋtǝyǝ sa ŋ na saanǝ we, wǝ́ ŋ nyɩnɩ gukpǝ we la aŋwaayǝ kpǝlo yǝ la taanǝ. Wǝ́ ŋ pùuru tʊkʊwǝ ŋ nah wʊ na wɛ. Pù wǝ ǝkǝnǝŋ okukpɛɛtǝpǝ sa pǝ lo ru pǝ lo suu. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Wǝ́ Pɔlʊ ŋ cà narǝwǝ mǝ no okopiyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pee yee lá wɛ lo turɔɔrɔɔwǝ. Loh kpǝlo le kpii rǝ sa.» <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />Wǝ́ rǝŋtǝyǝ sa ŋ tìi pǝ koonu na kaŋrewǝ. Wǝ́ ŋ fǝ̀ǝlǝ ŋ kolu ŋ fìi gukpǝ we mǝrǝ. Wǝ́ ŋ kolu ŋ kʊnʊ rǝ Pɔlʊ mǝ Silasǝ la kǝnyɩŋkǝ, láa ca kpakpa lǝh kpǝ́ mǝ vurǝ. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Wǝ́ ŋ pɔ̀rʊ pǝ ŋ rù, wǝ́ ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Okulǝtǝpǝ, kǝ́ wǝ́ ŋ́ née yee kǝ ŋ́ nya alɔkuŋkǝ?» <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Lɔ Kulǝtǝyǝ Yesu o nuŋ a láa nya alɔkuŋkǝ ŋnǝ mǝ la nyarǝwǝ.» <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Wǝ́ pǝ tɛnɩ Kulǝtǝyǝ le dierǝ pǝ tìi ŋpǝ mǝ enyipǝ we kpǝlo kɩɩkɩ pǝ kpii rǝ na nyarǝwǝ wǝ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Eniyǝ we mǝrǝ we, wǝ́ rǝŋtǝyǝ sa ŋ fǝ̀ Pɔlʊ mǝ Silasǝ ŋ kolu ŋ sìɛ pǝla wǝrɛŋkpǝ mǝ dumukururǝ we lǝ mǝrǝ. Wǝ́ pǝ wìiri rǝŋtǝyǝ sa lo worokomɛŋwǝ kǝtǝrǝceŋceŋ, mǝŋ na anyarǝtǝpǝ <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Wǝ́ ŋ fǝ̀ Pɔlʊ mǝ Silasǝ ŋ kolu na nyarǝwǝ. Wǝ́ ŋ kòonu pǝ le keeriwǝ pǝ rili. Wǝ́ nyiyǝ sa mǝ na nyarǝwǝ kpǝlo kɩɩkɩ pǝ nyà faawǝ mǝ kǝ́ pǝ la lɔ Worokoyǝ pǝ lo nuŋ wǝ. <figure style="fig" alt="Paul et Silas en prison" file="lb00337c.tif" size="col" copy="Louise Bass" ref="16:24">Pǝ la taŋ Pɔlʊ mǝ Silasǝ wǝ́ pǝ le kpii pǝ lo gborǝ rǝ akparǝyǝ</figure><verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Kǝ́ kǝ la kaalǝ we, wǝ́ Oromatǝkpaŋtɛŋtǝpǝ we pǝ kpìi otuusiitǝpǝ pǝ ke tíi nyiyǝ we ŋ nǝ́ǝ rǝŋ gukpɛɛkpǝ we ŋ nyarǝ enyipǝ we ŋ co. <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Wǝ́ rǝŋtǝyǝ sa ŋ kolu ŋ tìi Pɔlʊ lǝ wǝ ǝkǝnǝŋ: «Akpaŋtɛŋtǝpǝ we pǝ le kpii pǝ pe tíi mǝ ǝkǝnǝŋ ŋmǝ ŋ́ nyarǝ nǝ ŋ́ co. Kǝto nǝ nyo koru oru nǝ mǝ ko rǝ wǝtaarǝkpǝ.» <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Wǝ́ Pɔlʊ ŋ tìi otuusiitǝpǝ sa ǝkǝnǝŋ: «Kǝ́! Pǝ laa tɛŋ wǝkpaŋ mǝ lǝ, wǝ́ paa pǝ kòonu pǝ cùlu lǝ rǝ enyikpǝlo le enimiyǝ, wǝ́ pǝ tanǝ lǝ. Ŋlǝ Oromatǝpǝ rǝ! Wǝ́ rǝkǝsa pǝ ya pǝ lǝ́ǝ pǝ́ pǝ ŋwaa pǝ pɔrʊ lǝ rǝ? Yǝ lǝŋ tɛɛnɩ wǝ. Ŋpǝŋpǝ pǝ pǝ pǝ pa pɔrʊ lǝ.» <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />Wǝ́ otuusiitǝpǝ sa pǝ kolu pǝ pɔ akpaŋtɛŋtǝpǝ we la amayǝ. Kǝ́ pǝ lo nuŋ wǝ ǝkǝnǝŋ Pɔlʊ mǝ Silasǝ pǝ ri rǝ Oromatǝpǝ we, wǝ́ pǝ fìi vurǝ ŋpa. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Wǝ́ akpaŋtɛŋtǝpǝ sa pǝ pǝlǝ pǝ kpìi pǝ la dɔɔkpɛɛrǝ, wǝ́ pǝ pɔrʊ pǝ rǝ gukpǝ we. Wǝ́ pǝ tìi pǝ pǝ pwɛyɩ rǝ tǝŋtǝǝwǝ sa. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Kǝ́ Pɔlʊ mǝ Silasǝ pǝ lo ru rǝ gukpǝ sa ko we, wǝ́ pǝ ko ŋ ko Lidia la nyarǝwǝ. Wǝ́ pǝ kù mǝ alɔnuŋtǝpǝ we. Kǝ́ pǝ la tɛɛrɩ mǝ pǝ pǝ la ta pǝlo turuwǝ pǝ la lɛ we, wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Pɔlʊ mǝ Silasǝ pǝ le ke fii Tesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Pɔlʊ mǝ Silasǝ pǝ fǝ̀ rǝ Aŋfipoli mǝ Apoloni pǝ kolu pǝ fìi Tesalonika. Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ wǝ ka yaa rǝ fɛɛwǝ we. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Wǝ́ Pɔlʊ ŋ fii ŋ kolu ŋ tuu Oyudatǝpǝ mǝŋ kǝ́ ŋ née ce mǝ ŋ yee wǝ kǝtǝ. Wǝ́ ŋ fǝ̀ asabatǝpǝ ata milimili ŋ ka ŋ tɛɛrɩ mǝ pǝ mǝ ŋ ru rǝ Worokoŋtierǝ. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Wǝ́ ŋ ka ŋ pɔrʊ rǝlo duturǝ mǝ ŋ tíi pǝ, ŋ lɛ ŋ kaŋ sɩsiɛrɩ saŋ rǝ Worokoŋtierǝ we ǝkǝnǝŋ wǝ kpii kǝ Mesiyayǝ ŋ cʊʊrʊ kǝ ŋ kpǝ́, kǝ ŋ saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. Wǝ́ ŋ ke ŋ tìi pǝ ǝkǝnǝŋ: «Yesuyǝ sa le dierǝ ŋ́ ya ŋ́ náa tɛŋ mǝ ŋ́ tíi nǝ we, ŋwǝ ŋ kaamǝ Mesiyayǝ we.» <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Wǝ́ Oyudatǝpǝ sa la arɛɛpǝ pǝ lɔ̀ pǝ nunu. Wǝ́ pǝ kolu pǝ kʊ̀la mǝ Pɔlʊ mǝ Silasǝ. Wǝ́ Ehelatǝpǝ lǝ kpǝŋmumuŋwǝ rɛ pǝ láa sʊma Worokoyǝ ŋpǝ ŋkpɛ pǝ kolu pǝ kʊ̀la mǝ pǝ, mǝŋ etiepǝ rɛ pǝ ri omumuŋpǝ wǝ. <verse eid="ACT 17:4" /><verse number="5" style="v" sid="ACT 17:5" />Paa wǝ́ wǝ fìi Oyudatǝrɛɛpǝ. Wǝ́ pǝ kolu pǝ tàa ekpeŋkpenipǝ rǝ atɔŋyǝ pǝ kʊ̀la mǝ pǝla wɛ. Wǝ́ pǝ kolu pǝ kù, wǝ́ pǝ lɔ̀ gasarǝ pǝ kpìi awɛɛlɩkǝ pǝ ka ŋ tɛlɩ rǝ tǝŋtǝǝwǝ we lǝ mǝrǝ. Wǝ́ pǝ wʊ̀ʊ pǝ kolu pǝ fìi Yasɔŋ la nyarǝwǝ pǝ ka ŋ taa Pɔlʊ mǝ Silasǝ, kǝ pǝ nya fɛɛ pǝ lɔ pǝ pǝ ko kǝkpǝŋkǝ kpǝlo la kǝnyɩŋkǝ. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Kǝ́ pǝ laa nyɩŋ pǝ we, wǝ́ pǝ lɔ̀ Yasɔŋ mǝ apaanʊlɔnuŋtǝpǝ rɛ. Wǝ́ pǝ kolu mǝ pǝ rǝ tǝŋtǝǝwǝ we lo omumuŋpǝ lǝ kpǝŋ. Wǝ́ pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Enyipǝ sa pǝ le kpii awɛɛlɩkǝ rǝ ǝrǝkǝ kpǝlo we, pǝ le pe fii lǝh kpǝŋ rǝkǝsa. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Wǝ́ Yasɔŋ ŋ na lɔ pǝ ŋ nǝ tǝnǝ rǝ nǝ kpǝŋ. Enyipǝ sa kpǝlo lo otuyeeyǝ yǝ le yi yǝ la tɛɛ rǝ pilimumuŋyǝ Kayɩzaro le esepǝ. Pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ pilipʊŋpwayǝ rɛ kpii. Ŋwǝ ŋ ri Yesu.» <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Kǝ́ kǝkpǝŋkǝ we mǝ tǝŋtǝǝwǝ we lo omumuŋpǝ pǝ lo nuŋ etieyǝ sa we, wǝ́ pǝ fìi kǝǝnǝwǝ. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Wǝ́ pǝ sǝ̀ wǝtookpǝ pǝ tɛ̀ɛ Yasɔŋ mǝ nǝ ǝtǝŋpǝ we pǝ mwàra, wǝ́ akpaŋtɛŋtǝpǝ sa pǝ ci a nyàrǝ pǝ pǝ cò.<verse eid="ACT 17:9" /></para>
  <para style="s">Pɔlʊ mǝ Silasǝ pǝ le ke fii Bere</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Kǝ́ ǝrǝkǝ kǝ la cɩɩ we, wǝ́ apaanʊpǝ we pǝ cò Pɔlʊ mǝ Silasǝ la kʊŋ pǝ ko ŋ ko Bere. Kǝ́ pǝ le ke fii we, wǝ́ pǝ ko ŋ ko Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Oyudatǝpǝ we rǝ Bere pǝ lɔ̀ pǝ sɩsiɛrɩ pǝ teeri epǝ we rǝ Tesalonika. Wǝ́ pǝ lɔ̀ Worokoŋtierǝ mǝ faawǝ. Pǝ ke ŋ kpii nimirǝ rǝ Wǝfwɛɛkenikenikpǝ we ji ri ŋ ji pǝ ŋ yɩrɩ kǝ pǝ nyɩŋ mǝŋ Pɔlʊ le etieyǝ we yǝ kaa rǝ mǝ Wǝŋʊrʊkpǝ sa wǝ. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Wǝ́ enyipǝ wa rǝ pǝlǝ mǝrǝ pǝ sìɛrɩ pǝ yeli alɔnuŋtǝpǝ. Mǝŋ Ehelatǝtiepǝ rɛ pǝ ri omumuŋpǝ rǝ tǝŋtǝǝwǝ we fǝ kʊla mǝ ǝpǝrǝŋpǝ wa pǝ lɔ̀ pǝ nunu. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Paa kǝ́ Oyudatǝpǝ we pǝ kpii rǝ Tesalonika pǝ lo nuŋ ǝkǝnǝŋ Pɔlʊ la ka ya láa tɛŋ Worokoŋtierǝ rǝ Bere lǝ tǝŋtǝǝwǝ ŋ wǝ ŋkpɛ we, wǝ́ pǝ tǝ pǝ pǝlǝ pǝ ke ŋ kpii awɛɛlɩkǝ pǝ ŋ kpii enyipǝ lo otukoŋyǝ. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Wǝ́ apaanʊpǝ we pǝ kolu pǝ cò Pɔlʊ la kʊŋ kǝtǝrǝceŋceŋ rǝ apʊyǝ lǝ kpǝŋ. Wǝ́ Silasǝ mǝ Timote paa pǝ sìɛnɩ pǝ tini rǝ Bere. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Enyipǝ we pǝ kolu pǝ ko co Pɔlʊ la kʊŋ we, pǝ kolu mǝ ŋwǝ ǝrǝ Atɛnǝ. Wǝ́ pǝ kpǝ̀lǝŋ pǝ kǝ ŋ pǝ. Wǝ́ Pɔlʊ ŋ cò pǝla tɔɔwǝ pǝ ke tíi Silasǝ mǝ Timote pǝ saŋ ca pǝ po tuu ŋwǝ.<verse eid="ACT 17:15" /></para>
  <para style="s">Pɔlʊ le ke fii Atɛnǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Eniyǝ we Pɔlʊ ŋ tini ŋ nǝ́ǝ rǝŋ pǝ rǝ Atɛnǝ we, wǝ́ ŋ nyɩnɩ etiŋyǝ cɩkɩcɩkɩ rǝ tǝŋtǝǝwǝ sa. Wǝ́ wǝ kpii na awɛɛlɩkǝ ŋpa. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Wǝ́ ŋ kolu ŋ ka tɛɛrɩ mǝ Oyudatǝpǝ rǝ pǝlo gumwɛŋnyuŋkpǝ, mǝŋ epǝ we pǝ lee ri Oyudatǝpǝ paa pǝ láa sʊma Worokoyǝ wǝ. Ji ri ŋ ji, vǝ́ la nya la nyɩŋ enyipǝ rǝ canɩyǝ ko, láa tɛɛrɩ mǝ pǝ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Wǝ́ Epikurotǝtucitǝpǝ rɛ mǝ Osutoyitǝtucitǝpǝ rɛ ŋpǝ ŋkpɛ pǝ pǝlǝ pǝ ka ŋ tɛɛrɩ mǝ Pɔlʊ. Wǝ́ arɛɛpǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Kǝ́ wǝ́ wɛɛlɩtǝyǝ sa ŋ ya ŋ náa tɛŋ?» Kǝ́ Arɛɛpǝ pǝ lo nuŋ ǝkǝnǝŋ ya láa tɛŋ Dieceeceerǝ we mǝ ŋ ru rǝ Yesu mǝ enyiǝtǝpǝ la asaanǝkǝ we, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Wǝ lǝ mǝŋ ya láa wɛɛlɩ mǝ ŋ ru rǝ ǝsǝǝworokopǝ rɛ rǝ.» <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Wǝ́ pǝ lɔ̀ Pɔlʊ. Wǝ́ pǝ kolu mǝ ŋwǝ rǝ fɛɛtɛŋakpaŋyǝ we pǝ lóo pwo Arepago. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lǝ́ǝ pǝ́ a wɛɛlɩ o ru rǝ ló otukaŋŋwɛŋyǝ sa e tíi lǝ. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Kpiikǝ lé etieyǝ sa yǝ ri rǝ etieŋwɛŋyǝ rɛ, lo foo nuŋ yǝ lǝ tǝnǝ. Kǝto yǝ lǝ́ǝ pǝ́ a pɔrʊ yǝlǝ mǝrǝ e tíi lǝ kǝ la nya fɛɛ lo nuŋ yǝlo duturǝ.» <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Kǝceece Atɛnǝtǝpǝ kpǝlo mǝŋ ǝsǝǝpǝ we pǝ ke kpii pǝ kʊ̀la mǝ pǝ we, pǝ kǝ ŋ fǝ pǝle eniyǝ kpǝlo pǝ ŋ tii pǝ ŋ tɛŋ amaa pǝ ŋ nuŋ etieŋwɛŋyǝ. <verse eid="ACT 17:21" /><verse number="22" style="v" sid="ACT 17:22" />Wǝ́ Pɔlʊ ŋ yili ŋ yàa rǝ ǝtǝŋtǝǝtǝmumuŋpǝ sa le kǝtiitiikǝ. Wǝ́ ŋ lɔ̀ kpɛɛwǝ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Atɛnǝtǝpǝ, ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ nǝ nyóo suu Worokoyǝ lo vurǝ ŋpa rǝ nǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Kǝ́ ŋ́ siri ŋ́ náa tɛlɩ rǝ nǝ atɔŋyǝ sa we, ŋ́ no co nimirǝ rǝ nǝ otuyǝ we nǝ nyáa sʊma wǝ. Wǝ́ ŋ́ na nyɩŋ diŋrǝ rɛ kʊraa. Pǝ la ŋʊrʊ pǝ la tɛɛ rǝ rǝ ǝkǝnǝŋ: “Worokoyǝ we rɛ ŋ nee ci la nɛŋ”. Rǝkǝsa tuwǝ we nǝ ya nyáa sʊma paa nǝ nyee ci we, wǝle dierǝ wǝ́ ŋ́ ya ŋ́ náa tɛŋ mǝ ŋ tíi nǝ wǝ. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Worokoyǝ we ŋ no co ǝrǝkǝ mǝ otuyǝ we kpǝlo yǝ kpii rǝ kǝlǝ mǝrǝ, ŋwǝ yǝ we ŋ ri yulaarǝ mǝ kǝtǝǝwǝ lo Kulǝtǝyǝ we, lǝŋ kpii rǝ nyarǝwǝ we anyɩmaasɩpǝ pǝ la tɔ wǝ. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Wǝ́ laa lɛ ŋ pǝ́ rɛ ŋ fǝ na akaakǝ ŋ yee tuwǝ rɛ ŋ koonu ŋwǝ, wǝ lée yee rǝ mǝŋ tǝrɛ wǝ ya wǝ lée yee na ariaayǝ rǝ. Ŋwǝ ŋ nóo koonu enyipǝ kpǝlo la vɔrʊrǝ mǝ wɛɛnwanwarǝ mǝ otututuruyǝ kpǝlo. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Saŋ rǝ nyiyǝ ceŋceŋ lo oŋuŋkǝ wǝ́ ŋ no co wǝnyikpǝŋkpǝ kpǝlo kɩɩkɩ, kǝ pǝ lɔ kǝtǝǝwǝ kpǝlo kɩɩkɩ pǝ tii. Lǝ tǝnǝ eniyǝ lo koonu pǝ, wǝ́ ŋ ne kpii ǝpǝ ri ǝpǝ lǝ gǝŋrǝ la apɛŋyǝ. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Worokoyǝ le yee wǝ ǝnǝ kǝ enyipǝ pǝ nya fɛɛ pǝ ŋ taa ŋwǝ kǝtǝ mǝ kǝtǝ. Ayɩrɛ pǝ láa ka nyɩŋ ŋwǝ. Kǝceece we, kaŋfɩ Worokoyǝ lee ce ŋ lǝǝrǝ mǝ lah rɛ.<verse eid="ACT 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 17:28" />Ŋwǝ kǝto wǝ́ le kpii vɔrʊrǝ, wǝ́ yǝ láa saŋ, wǝ́ la lɛ le kpii le tini. Ne etienɔŋtǝpǝ rɛ ŋpǝ ŋkpɛ pǝ la tɛŋ wǝ ǝkǝnǝŋ: “Ŋla ŋkpɛ le ri nǝ wǝmǝkpǝ.”<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />Kǝ́ le ri Worokoyǝ lǝ wǝmǝkpǝ kǝto we, wǝ laa laka kǝ lǝ fǝ Worokoyǝ la ca mǝ diŋrǝ we nyɩmaasɩyǝ ŋ ne tii ŋ na yaa yurǝ wǝ́ ŋ nǝ fǝ sɩkamwɛɛrɩyǝ amaa sɩkakpɛɛlɩyǝ amaa ɖurǝ, ŋ na marǝ mǝ ŋwǝŋwǝ no susuyǝ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Worokoyǝ la ca eniyǝ we anyɩmaasɩpǝ pǝ lee ke ci ŋwǝ la kǝtakǝ le sii. Rǝkǝsa we, ya láa tɛŋ mǝ ŋ tíi enyipǝ kpǝlo kɩɩkɩ rǝ fɛɛ ri ŋ fɛɛ pǝ siɛrɩ vɔrʊrǝ. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Lǝ tǝnǝ jirǝ ŋ nah pa tɛŋ ǝrǝkǝ kpǝlo la wǝkpaŋkpǝ rǝ wǝkʊʊkpǝ saŋ rǝ nyiyǝ we ŋ na pɔrʊ ŋ nǝ tǝnǝ wǝ. Worokoyǝ lo kuŋ kǝ enyipǝ kpǝlo pǝ ci wǝ ǝkǝnǝŋ ŋ née yee wǝ taa, kǝ́ ŋ na saanǝ ŋwǝ nyiyǝ sa ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ.»<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Kǝ́ pǝ lo nuŋ Pɔlʊ ŋ na wɛɛlɩ ŋ no ru rǝ enyiǝtǝpǝ la asaanǝkǝ we, wǝ́ enyirɛɛpǝ pǝ ka ŋ mɔɔnʊ ŋwǝ, wǝ́ arɛɛpǝ pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Jipʊŋpwa kǝ a pa tɛŋ dierǝ sa e tíi lǝ.» <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Wǝ́ Pɔlʊ ŋ pwɛ̀yɩ rǝ pǝlǝ kpǝŋ. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Paape enyirɛɛpǝ pǝ kolu pǝ kʊ̀la mǝ ŋwǝ, wǝ́ pǝ sìɛrɩ pǝ yeli alɔnuŋtǝpǝ. Rǝ pǝlǝ mǝrǝ we, yǝ láa nyɩŋ Deni ŋ kʊla mǝ ǝtǝŋtǝǝtǝmumuŋpǝ la wǝcakukpǝ wǝ. Tieyǝ rɛ pǝ lóo pwo Damari fǝ kʊla mǝ enyirɛɛpǝ. <figure style="fig" file="GPS_Paul2-BW.tif" size="col" copy="Wycliffe Global Alliance" ref="17:34" /><verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Pɔlʊ lo ko Korɛŋto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Wǝla kǝmaakǝ we wǝ́ Pɔlʊ ŋ pwɛyɩ rǝ Atɛnǝ ŋ ko ŋ ko tǝŋtǝǝwǝ we pǝ lóo pwo Korɛŋto wǝ. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Wǝ́ ŋ kolu ŋ kù mǝ Yudatǝnyiyǝ rɛ. Lo ru rǝ Pɔŋto la gaarǝ. Pǝ lóo pwo ŋwǝ Akila. Ŋpǝ mǝ ne tie Pirisikila pǝ le ci oru rǝ Itali pǝ le pe fii Korɛŋto wǝ faa panǝ, duturǝ ɖi pilimumuŋyǝ Kǝlodǝ pɔ̀rʊ seyǝ rù ǝkǝnǝŋ Oyudatǝpǝ kpǝlo pǝ pwɛyɩ rǝ Roma lǝ tǝŋtǝǝwǝ. Wǝ́ Pɔlʊ ŋ fǝ̀ pǝ le wǝpwetaakpǝ. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Kǝnǝnɛkǝ we Pɔlʊ ŋ ke ŋ yee we, ŋkǝ ke wǝ́ Akila mǝ ne tie pǝ ke ŋ yee. Pǝ kǝ ŋ fǝ afwɛɛyǝ pǝ ŋ tɔ epwiiyǝ. Tuwǝ kǝto Pɔlʊ ŋ kolu ŋ tini rǝ pǝlǝ kpǝŋ, wǝ́ ŋ ke ŋ yee kǝnǝnɛkǝ sa wǝǝ. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Sabatǝ ri ŋ sabatǝ le jirǝ we, Pɔlʊ ko ŋ ko mǝŋ tɛɛrɩ ŋpǝ mǝ Oyudatǝpǝ mǝ Ehelatǝpǝ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ. Ŋ mǝ pǝ́ ŋ tɛŋ kǝ pǝ lɔ pǝ nuŋ.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Kǝ́ Silasǝ mǝ Timote pǝ lo ru rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Makedonia pǝ le pe fii we, wǝ́ Pɔlʊ ŋ fǝ̀ ne eniyǝ kpǝlo ŋ ka ŋ tɛŋ Worokoŋtierǝ, wǝ́ ŋ ka ŋ nyɩɩ mǝ ŋ tɛŋ mǝ okopiyǝ rǝ Oyudatǝpǝ le enimiyǝ ǝkǝnǝŋ Yesu ŋ ri Kǝrisoyǝ. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Paape wǝ́ Oyudatǝpǝ pǝ sǝnǝ wǝ́ pǝ ka ŋ fɛɛpɩ ŋwǝ. Wǝ́ Pɔlʊ ŋ tɛ̀rɩ na wǝkpakpǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ gbɛŋrǝ vǝ nǝ oo! Ŋ́ naa kʊla. Fǝ rǝ ruŋruŋ mǝ ko, epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ wǝ́ ŋ́ noh mǝ ko.» <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Wǝ́ Pɔlʊ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we. Wǝ́ ŋ ko ŋ ko nyiyǝ rɛ pǝ lóo pwo Tito Yuso lǝ kpǝŋ. Láa sʊma Worokoyǝ, wǝ́ na nyarǝwǝ wǝ ka maarǝ mǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Wǝ́ nyiyǝ rɛ pǝ lóo pwo Kǝripo ŋpǝ mǝ na nyarǝwǝ pǝ lɔ̀ Kulǝtǝyǝ pǝ nunu. Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ lo mumuŋyǝ wǝ́ ŋ ri. Wǝ́ Okorɛŋtotǝpǝ wa pǝ lɔ̀ pǝ nunu, kǝ́ pǝ ya pǝ lóo nuŋ Pɔlʊ le etieyǝ wǝ. Wǝ́ pǝ wìiri pǝ lo worokomɛŋwǝ.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Dumurǝ rɛ, wǝ́ Kulǝtǝyǝ ŋ tíi Pɔlʊ rǝ kʊtʊkpɛɛkǝ ǝkǝnǝŋ: «Poo suu vurǝ, tǝ e re a mǝ wɛɛlɩ rǝ ko, pǝǝ rǝŋ. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Duturǝ ɖi ŋ́ kpii ŋ́ kʊla mǝ lǝ́. Wǝ́ rɛ ri ŋ rɛ lǝŋ fǝ na akaakǝ ŋ ruu lǝ́, kǝ ŋ yee mǝ lǝ́ turɔɔrɔɔwǝ rɛ. Duturǝ ɖi mǝ enyipǝ pǝ naanǝ rǝ tǝŋtǝǝwǝ sa.» <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Wǝ́ Pɔlʊ ŋ tini rǝ enyipǝ sa lǝ kpǝŋ cɛŋwǝ ceŋceŋ mǝ akɛɛnyɔŋpǝ akʊraŋ. Wǝ́ ŋ ka ŋ kaŋ Worokoŋtierǝ.<verse eid="ACT 18:11" /></para>
  <para style="s">Pǝ la lɔ Pɔlʊ pǝ lo ko kǝŋyɩrɩtǝyǝ we pǝ lóo pwo Galiɔŋ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Eniyǝ we Galiɔŋ ŋ ke ri kǝŋyɩrɩtǝyǝ rǝ gǝŋrǝ we pǝ lóo pwo Akayi we, wǝ́ Oyudatǝpǝ pǝ rili nyuŋkpǝ mǝ awɛ, wǝ́ pǝ yili pǝ tɛ̀ɛ rǝ Pɔlʊ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu fɛɛtɛŋakpaŋyǝ. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Wǝ́ pǝ kolu pǝ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ sa ya lǝ́ǝ tǝǝnǝ enyipǝ kǝ pǝ paa mǝ sʊma Worokoyǝ mǝŋ kǝ́ seyǝ ŋ na tɛŋ wǝ». <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />Kǝ́ Pɔlʊ ŋ no ko kǝ ŋ wɛɛlɩ eni we, wǝ́ Galiɔŋ ŋ ke ŋ tíi Oyudatǝpǝ we ǝkǝnǝŋ: «Ao, Oyudatǝpǝ! O koh nuŋ la fʊmʊ seyǝ amaa le yee turɔɔrɔɔmumuŋwǝ rɛ we, ŋ́ kǝh fǝ eniyǝ ŋ́ nuŋ nǝ etieyǝ sa. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Wǝ́ kǝ́ wǝ le yee otukaŋyǝ rɛ le etieyǝ, anyɩŋyǝ le etieyǝ mǝ ŋnǝŋnǝ nǝ seyǝ le etieyǝ we, wǝ fǝ nǝ. Mǝ paa ŋ́ nǝŋ kooru etieyǝ sa kǝtǝŋkǝ la atɛŋ.» <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Wǝ́ Galiɔŋ ŋ pìri pǝ rǝ fɛɛtɛŋakpaŋyǝ we. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Wǝ́ pǝ lɔ̀ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ lo mumuŋyǝ we pǝ lóo pwo Sosǝtɛnǝ pǝ ya pǝ ko ŋ culu rǝ fɛɛtɛŋakpaŋyǝ la kǝnyɩŋkǝ. Paape Galiɔŋ lǝǝ kpǝlǝŋ pǝ.<verse eid="ACT 18:17" /></para>
  <para style="s">Pɔlʊ la siɛnɩ lo ko Aŋtiokia yǝ we ŋ kpii rǝ Siri lǝ gǝŋrǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Wǝ́ Pɔlʊ ŋ tǝ ŋ tini wǝ pànǝ rǝ Korɛŋto. Wǝla kǝmaakǝ wǝ́ ŋ pwɛyɩ rǝ alɔnuŋtǝpǝ we lǝ kpǝŋ. Wǝ́ ŋ fìi gbanǝŋwaarǝ ŋ ko ŋ ko Siri ŋpǝ mǝ Pirisikila mǝ Akila. Kǝ́ pǝ le fii tǝŋtǝǝwǝ we pǝ lóo pwo Saŋkǝre we, wǝ́ Pɔlʊ ŋ pùu no yurǝ, duturǝ ɖi yɩ̀rɩ gɔrǝ rǝ. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Kǝ́ pǝ le ke fii tǝŋtǝǝwǝ we pǝ lóo pwo Efeso we, wǝ́ Pɔlʊ ŋ màa Pirisikila mǝ Akila rǝ we. Wǝ́ ŋ ko ŋ ko Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ ŋ kolu ŋ ka ŋ tɛrɩ mǝ Oyudatǝpǝ. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Wǝ́ Oyudatǝpǝ we pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ ŋ tǝ ŋ yee eniyǝ rɛ rǝ pǝlǝ kpǝŋ. Paape wǝ́ ŋ sǝnǝ. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Wǝ́ ŋ pwɛ̀yɩ rǝ pǝlǝ kpǝŋ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ Worokoyǝ la tɛɛnɩ we, ŋ́ nǝh pǝ tǝ ŋ́ siɛnɩ ŋ́ pǝ nǝ kpǝŋ». Wǝ́ ŋ fìi gbanǝŋwaarǝ rǝ Efeso ŋ ko ŋ ko Sezare. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Kǝ́ ŋ ne ke fii Sezare we, wǝ́ ŋ rɛ̀ ŋ kolu ŋ cèeni alɔnuŋtǝpǝ we pǝ ke kpii rǝ Yerusalɛmǝ.<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Kǝhelatǝkǝ kǝ la tɛŋ ǝkǝnǝŋ: «Wǝ́ ŋ kolu ŋ cèeni alɔnuŋtǝpǝ. Pǝ lee kpii Yerusalɛmǝ, paape wǝ lée mǝ ri Yerusalɛmǝ».</char></note> Wǝ́ ŋ fǝ̀ ŋ ka ŋ sʊʊ Aŋtiokia. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Wǝ́ ŋ kolu ŋ tini rǝ we tɩpɩrɩ. Wǝla kǝmaakǝ wǝ́ ŋ kolu ŋ kpìi alɔnuŋtǝpǝ la wɛɛlɛŋwǝ rǝ Galatia mǝ Fǝrizi.<verse eid="ACT 18:23" /></para>
  <para style="s">Nyiyǝ rɛ pǝ lóo pwo Apolo lǝ pǝ Efeso mǝ Korɛŋto</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Yudatǝnyiyǝ rɛ pǝ lóo pwo Apolo pǝlǝ Efeso. Alɛsaŋdǝritǝpǝ wǝ́ ŋ ri. Ka ŋ wɛɛlɩ sɩsiɛrɩ, wǝ́ ŋ ke cii Worokoŋtierǝ sɩsiɛrɩ. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Pǝ kanǝ ŋwǝ kǝ́ pǝ lée yee Kulǝtǝyǝ lǝ kǝǝpǝ́wǝ. Wǝ́ ŋ fǝ̀ wɛɛlɛŋwǝ ŋ ka ŋ tɛŋ Worokoŋtierǝ, wǝ́ ŋ ka ŋ lɛ mǝ ŋ kaŋ otuyǝ mǝ ŋ ru rǝ Yesu pɛpɛpɛ. Paape Yowanɛsɩ lo Worokomɛŋwiiriwǝ le dierǝ ko wǝ́ ŋ ke cii. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Wǝ́ ŋ kolu ŋ ka ŋ wɛɛlɩ rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ mǝ turutawǝ. Kǝ́ Pirisikila mǝ Akila pǝ lo nuŋ ne etieyǝ we, wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝlǝ kpǝŋ. Wǝ́ pǝ kolu pǝ pɔ̀rʊ Worokoyǝ la gʊŋrǝ le etieyǝ lǝ mǝrǝ pǝ tíi ŋwǝ sɩsiɛrɩ. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Wǝ́ kǝ́ Apolo kǝ ŋ pǝ́ ŋ ko tǝŋtǝǝwǝ we pǝ lóo pwo Akayi we, wǝ́ alɔnuŋtǝpǝ pǝ kpìi na wɛɛlɛŋwǝ, wǝ́ pǝ ŋʊ̀rʊ kǝfwɛɛkǝ pǝ manǝ alɔnuŋtǝpǝ we pǝ kpii rǝ Akayi, kǝ pǝ lɔ ŋwǝ sɩsiɛrɩ. Wǝ́ Worokoyǝ ŋ tonu, kǝ́ ŋ ne ke fii we, wǝ́ ŋ tonu alɔnuŋtǝpǝ we ŋpaŋpa. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Duturǝ ɖi ne etieyǝ yǝ kǝ lǝǝmǝ okopiyǝ, wǝ́ yǝ sàarǝ Oyudatǝpǝ rǝ enyipǝ kpǝlo le enimiyǝ. Wǝ́ ŋ yà ŋ ka ŋ pɔrʊ mǝ ŋ kaŋ pǝ saŋ rǝ Worokoŋtierǝ ǝkǝnǝŋ Yesu ŋ ri Kǝrisoyǝ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Pɔlʊ lo ko Efeso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Eniyǝ we Apolo ŋ ke kpii rǝ Korɛŋto we, wǝ́ Pɔlʊ ŋ sanǝ ŋ fǝ̀ rǝ otutupiyǝ la gaarǝ wǝ́ ŋ kolu ŋ fìi Efeso. Wǝ́ ŋ kolu ŋ nyɩnɩ alɔnuŋtǝpǝ rɛ rǝ we. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ nǝ nya lɔ nǝ nyo nuŋ wǝǝ, nǝ nya lɔ Wɛɛkenikenirǝ lo okopiyǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lee ce lo nuŋ pǝ tɛŋ Wɛɛkenikenirǝ le dierǝ rǝ fɛɛwǝ rɛ la nyɩŋ.» <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />Wǝ́ Pɔlʊ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Worokomɛŋwǝ rǝ fǝŋ wǝ́ pǝ le wiiri nǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yowanɛsɩ lo worokomɛŋwǝ we ŋ ke ŋ wiiri enyipǝ wǝ.» <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />Wǝ́ Pɔlʊ ŋ tìi pǝ ǝkǝnǝŋ: «Wɛɛsiɛrɩwǝ lo worokomɛŋwǝ wǝ́ Yowanɛsɩ ŋ wìiri enyipǝ. Wǝ́ ŋ ke ŋ tíi enyipǝ ǝkǝnǝŋ pǝ lɔ yǝ we ŋ nǝh pǝ ŋ pǝ pǝ rǝ na kǝmaakǝ pǝ nuŋ. Yǝ we ŋ ri Yesu.» <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Kǝ́ alɔnuŋtǝpǝ sa pǝ lo nuŋ etieyǝ sa we, wǝ́ pǝ wìiri pǝ lo worokomɛŋwǝ rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Wǝ́ Pɔlʊ ŋ tɛ̀ɛ pǝ la wǝkaakpǝ, wǝ́ Wɛɛkenikenirǝ zʊ̀ʊ rǝ pǝ. Wǝ́ pǝ ka ŋ wɛɛlɩ wǝrǝpʊŋpwakpǝ. Wǝ́ pǝ ko ŋ nuŋ Worokoyǝ le etieyǝ pǝ ŋ tɛŋ. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Enyipǝ sa pǝ lo kpǝlo pǝ lóo ro tǝ mǝ eyi.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Wǝ́ Pɔlʊ ŋ ko ŋ ko mǝ ŋ tɛɛrɩ eni ri ŋ ni rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ akɛɛnyɔŋpǝ ata. Wǝ́ ŋ ka ŋ lɔ kpɛɛwǝ mǝ ŋ wɛɛlɩ mǝ turutawǝ. Ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ le wǝpilirikpǝ, wǝ́ ŋ ka ŋ nyɩɩ mǝ ŋ pɔrʊ wǝ lo duturǝ mǝ ŋ tíi enyipǝ, kǝ pǝ lɔ wǝ pǝ nuŋ. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Paape arɛɛpǝ pǝ ka lɛnyɩ yurǝ pǝ sǝnǝ, pǝ laa lɔ pǝ nuŋ. Wǝ́ pǝ yà pǝ ka ŋ mɔɔnʊ Pɔlʊ le etieyǝ we ŋ yà ŋ ka ŋ tɛŋ mǝŋ ru rǝ Kulǝtǝyǝ la kʊŋwǝ rǝ nyikpǝŋwǝ we la kǝnyɩŋkǝ. Wǝ́ Pɔlʊ ŋ fǝ̀ alɔnuŋtǝpǝ we, wǝ́ pǝ pwɛ̀yɩ rǝ kǝkpǝŋkǝ we lǝ kpǝŋ. Wǝ́ ŋ ko ŋ ko mǝ ŋ kaŋ pǝ lo otuyǝ ji ri ŋ ji rǝ nyiyǝ rɛ pǝ lóo pwo Tirano lo sukuuwǝ. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Pɔlʊ kanǝ otuyǝ sa cɛŋwǝ yi wɩlɩwɩlɩ. Wǝ́ enyipǝ we kpǝlo pǝ ke kpii rǝ Azi lǝ gǝŋrǝ, mǝŋ Oyudatǝpǝ mǝŋ Ehelatǝpǝ pǝ nunu Kulǝtǝyǝ le dierǝ.<verse eid="ACT 19:10" /></para>
  <para style="s">Wɛɛrɔɔrɔɔrǝ la nyaanǝ nyiyǝ rɛ pǝ lóo pwo Seva le epipǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Worokoyǝ ke ŋ yee otucovumumuŋyǝ mǝ ŋ saŋ rǝ Pɔlʊ. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Wǝ́ wǝ pǝlǝ wǝ yeli, vǝ́ pǝ lǝ fǝ orukupiyǝ pǝ lo ko ru Pɔlʊ, wǝ́ pǝ lǝ fǝ pǝ lo po ru anyaatǝpǝ we, oturu pǝ la kpaa, awɛɛrɔɔrɔɔyǝ yǝ ŋ ru rǝ pǝ. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Oyudatǝpǝ rɛ pǝ ke ŋ piri awɛɛrɔɔrɔɔyǝ rǝ anyaatǝpǝ pǝ ŋ tɛlɩ. Wǝ́ pǝ pǝlǝ pǝ fǝ Yesu la nyɩŋrǝ pǝ ko ŋ pwo pǝ ŋ piri awɛɛrɔɔrɔɔyǝ sa. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ náa fáŋ nǝ rǝ Yesu la nyɩŋrǝ, yǝ we le dierǝ Pɔlʊ ŋ ya náa tɛŋ wǝ!» <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Toolutǝmumuŋyǝ rɛ pǝ lóo pwo Seva le epipǝ apǝrɩmata pǝ yili pǝ ke ŋ yee ŋ wǝ tuwǝ sa ǝnǝ. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Jirɛɛrǝ we, wǝ́ wɛɛrɔɔrɔɔrǝ we ge ŋ tíi pǝ ǝkǝnǝŋ: «Ŋ́ cii Yesu, wǝ́ ŋ́ lɛ ŋ́ cii Pɔlʊ sɩsiɛrɩ. Wǝ́ ŋnǝ wǝǝ, ǝlǝ wǝ́ nǝ ri?» <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Wǝ́ nyiyǝ we lǝ mǝrǝ wɛɛrɔɔrɔɔrǝ sa ge kpii ŋ yili ŋ tà pǝ, wǝ́ ŋ cùlu pǝlo kpǝlo ŋ nyàanǝ. Wǝ́ pǝ sùu kǝtaŋkpa pǝ rù rǝ nyarǝwǝ we mǝ wǝrɛŋkpǝ. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Wǝ́ Efesotǝpǝ kpǝlo mǝŋ Oyudatǝpǝ mǝŋ Ehelatǝpǝ pǝ nunu tuwǝ sa. Wǝ́ vurǝ vìi nyi ri ŋ nyi. Wǝ́ pǝ kǝ ŋ kǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Wǝ́ enyipǝ wa pǝ lɔ̀ pǝ nunu. Wǝ́ pǝ pǝlǝ pǝ ka ŋ tɛŋ pǝlo oturɔɔrɔɔyǝ pǝ le yee kelele rǝ kǝkpǝŋkǝ la kǝnyɩŋkǝ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Wǝ́ amajikiyeetǝpǝ we la kǝtarɛɛkǝ wa, pǝ fǝ̀ pǝla wǝfwɛɛkpǝ pǝ pǝlǝ pǝ tùu naawǝ rǝ kǝkpǝŋkǝ we la kǝnyɩŋkǝ. Kǝ́ pǝ lo pu wǝfwɛɛkpǝ we lo okuruyǝ we, wǝ́ pǝ nyà sɩkakpotokpoyǝ lafawǝ tǝtʊʊ. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Wǝ́ Kulǝtǝyǝ le dierǝ ga ŋ nyɩɩ lǝ ŋ ko kǝnyɩŋkǝ mǝ okopiyǝ.<verse eid="ACT 19:20" /></para>
  <para style="s">Efesotǝpǝ pǝ le yi pǝ la tɛɛ rǝ Pɔlʊ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Rǝ tuwǝ sa la kǝmaakǝ we, wǝ́ Pɔlʊ ŋ yeli yurǝ ǝkǝnǝŋ ŋ nǝ́ǝ fǝ rǝ ǝkǝŋyǝ we pǝ lóo pwo Makedonia mǝ Akayi ŋ ko Yerusalɛmǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Vǝ́ ŋ́ ne ke fii Yerusalɛmǝ we, wǝ kaamǝ kǝ ŋ́ ko Roma.» <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Wǝ́ ŋ kpìi no otoŋtǝpǝ eyi, Timote mǝ Erasǝ ŋ manǝ rǝ Makedonia. Wǝ́ ŋwǝ paa ŋ cè ŋ sɔ̀ ŋ tini rǝ Azi. <verse eid="ACT 19:22" /><verse number="23" style="v" sid="ACT 19:23" />Ŋyǝ eniyǝ we wǝ́ enyipǝ pǝ yili pǝ ke ŋ kpìi awɛɛlɩkǝ ŋpa rǝ Efeso, rǝ Kulǝtǝyǝ la kʊŋwǝ kǝto. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Nyiyǝ rɛ pǝ lóo pwo Demetio, ke ŋ yee asɩkatukoŋwarǝpiyǝ. Ŋwǝ nyiyǝ sa kǝ ŋ fǝ sɩkakpɛɛlɩyǝ mǝ ŋ yee worokoyǝ we pǝ lóo pwo Arǝtemi lo okupiyǝ mǝ ŋ siiri wǝ. Epǝ we pǝ ke ŋ yee kǝnǝnɛkǝ sa pǝ ka ŋ nya sɩkayǝ ŋpa. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Wǝ́ Demetio ŋ kolu ŋ kùu mǝ nǝ ǝtǝŋpǝ we pǝ lée yee kǝnǝnɛkǝ sa mǝŋ epǝ we pǝ lée yee kǝnǝnɛkǝ sa wǝrʊʊkpǝ kpǝlo, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, ŋnǝŋnǝ nǝ cii wǝ ǝkǝnǝŋ kǝnǝnɛkǝ sa la ya yǝ lée yee kǝto wǝ́ yǝ la nya lah wɛ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Paape Pɔlʊyǝ sa ya láa tɛŋ ǝkǝnǝŋ oworokopǝ we anyɩmaasɩpǝ pǝ le yee we, pǝ lee ri oworoko. Nǝ nyo nuŋ wǝ́ nǝ nya nyɩŋ tuwǝ sa wǝ ya wǝ lǝ́ǝ pǝ wǝ. Wǝ́ ŋkǝ rǝ Efeso lǝ tǝŋtǝǝwǝ sa ceŋceŋ, wǝ lah ta wǝ to Azi lǝ gǝŋrǝ sa kpǝlo wǝ́ ŋ na nyɩɩ ŋ na siɛrɩ enyipǝ lo oyupuyǝ. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Tuwǝ sa wǝ lóo koonu lah atɔɔkǝ, kǝ wǝ lɛ wǝ koonu kǝ enyipǝ pǝ pǝǝ tǝ pǝ fǝ pǝlo woroko Arǝtemisǝmumuyǝ sa lo gukpǝ sa pǝ parǝ. Eniyǝ we enyipǝ pǝ lǝŋ tǝ pǝ pa ya pǝ ŋ kǝ wǝfɛɛkpǝ sa pǝ láa sʊma rǝ Azi lǝ gǝŋrǝ sa mǝ ǝrǝkǝ sa kpǝlo wǝ.» <verse eid="ACT 19:27" /><verse number="28" style="v" sid="ACT 19:28" />Kǝ́ enyipǝ sa pǝ lo nuŋ etieyǝ sa we, wǝ́ pǝ fǝ̀ kpɛɛmʊrʊwǝ pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Efesotǝpǝ la Arǝtemisǝ ŋ ri mumuŋyǝ!» <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Wǝ́ tuwǝ sa wǝ tòo tǝŋtǝǝwǝ we kpǝlo. Wǝ́ enyipǝ pǝ rù ŋpa pǝ sanǝ pǝ ko ŋ ko fɛɛwʊrʊwǝ. Wǝ́ pǝ kolu pǝ lɔ̀ Pɔlʊ lǝ ǝtǝŋpǝ, Gayo mǝ Aritakǝ. Pǝ ke ri Amakedoniatǝpǝ. Wǝ́ pǝ tìini pǝ pǝ ko ŋ ko. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Wǝ́ Pɔlʊ ŋ pǝ́ ŋ ka wɛɛlɩ mǝ kǝkpǝŋkǝ we. Paape alɔnuŋtǝ pǝ we pǝ laa maa ŋwǝ. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Wǝ́ Azi lǝ ǝkǝŋyɩrɩtǝpǝ rɛ pǝ ke ri na akɛrɩpǝ ŋpee pǝ kpìi enyipǝ pǝ pe tíi ŋwǝ ǝkǝnǝŋ ŋ poo ko fɛɛwǝ we pǝ lée yee awʊrʊkǝ wǝ. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Wǝ́ kǝkpǝŋkǝ we kǝ yà kǝ ka ŋ lɔ gasarǝ rǝ fɛɛwǝ we, enyipǝ lǝ epǝ pǝ ya pǝ lóo woolu pǝ ŋ tɛŋ kpoo, ǝpǝ ŋpee pǝ ya pǝ lóo woolu pǝ ŋ tɛŋ kpoo. Wǝ́ enyirɛɛpǝ wa pǝ lee ke ci tuwǝ kǝto pǝ lo po ku rǝ fɛɛwǝ we. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Wǝ́ enyipǝ rɛ rǝ kǝkpǝŋkǝ we lǝ mǝrǝ pǝ kolu pǝ pɔrʊ tuwǝ we wǝ ya wǝ lǝ́ǝ pǝ lǝ mǝrǝ pǝ tìi Yudatǝnyiyǝ rɛ pǝ lóo pwo Alɛsaŋto. Ŋwǝ wǝ́ Oyudatǝpǝ pǝ fǝ̀ pǝ yàalǝ rǝ kǝnyɩŋkǝ. Wǝ́ Alɛsaŋto ŋ yìili akaakǝ kǝ ŋ wɛɛlɩ. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Paape kǝ́ nyikpǝŋwǝ we wǝ la nyɩŋ wǝ le ci ǝkǝnǝŋ Yudatǝnyiyǝ wǝ́ ŋ ri we, wǝ́ pǝlo kpǝlo pǝ yà pǝ ko ŋ woolu wǝ lóo ro enipuŋyǝ eyi pǝ ŋ tɛŋ dierǝ we jeŋceŋ ǝkǝnǝŋ: «Efesotǝpǝ la Arǝtemisǝ ŋ ri mumuŋyǝ!» <verse eid="ACT 19:34" /><verse number="35" style="v" sid="ACT 19:35" />Wǝ́ tǝŋtǝǝwǝ we la fwɛɛŋʊrʊtǝyǝ paa ŋ pǝlǝ ŋ kòru pǝ lǝ ǝrǝǝnǝ. Wǝ́ ŋ tíi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ Efesotǝpǝ, nyi ri ŋ nyi cii wǝ ǝkǝnǝŋ Arǝtemisǝ ri Efeso lǝ tǝŋtǝǝwǝ sa la nɛŋ, mǝŋ ne diŋrǝ we lo ru rǝ yulaarǝ la sʊʊ wǝ. <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Wǝ́ kǝ́ rɛ ŋ nǝŋ koru wǝ la acwɩ we, nǝ nyée yee rɛyɩɩ. Nǝ poo fuunu nǝ yee tǝrɛ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Nǝ nya nyɩŋ enyipǝ sa nǝ nya lɔ nǝ nyǝ pǝ wǝ, pǝ lee yee turɔɔrɔɔwǝ rɛ pǝ ko rǝ loh worokoyǝ sa lǝ kpǝŋ, wǝ́ pǝ laa lɛ pǝ fɛɛ ŋwǝ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Mǝŋ Demetio mǝ nǝ ǝtǝŋpǝ pǝ ya pǝ lée yee akpaŋyǝ ŋpǝ mǝ rɛ we, pǝ lóo koru o ko pǝ ko pwo nyiyǝ we rǝ ǝkǝŋyɩrɩtǝpǝ lǝ kpǝŋ. Akpaŋtɛŋtǝpǝ pǝ kpii, wǝ́ ecitɛŋakpaŋyǝ yǝ lɛ yǝ kpii. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Wǝ́ mǝŋ nǝ tǝ nǝ lǝǝmǝ dierǝ rɛ nǝ nyǝ́ǝ pǝ́ we, fɛɛtɛŋakpaŋyǝ wǝ́ nǝ nyóo ko nǝ ka tɛŋ rǝ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Mǝŋ yǝ lee yee yurǝ, pǝ lǝh pǝ fǝ dierǝ pǝ tɛɛ rǝ lǝ mǝ tuwǝ sa yǝ le yee ruŋruŋ wǝ. Pǝ leh pe tíi lǝ ǝkǝnǝŋ ŋlǝ la ya yǝ lée kpii enyipǝ lo otukoŋyǝ kǝ pǝ ru pǝ ŋ woolu. Mǝŋ pǝ lǝ pǝ pǝ́ lǝ ǝkǝnǝŋ kǝ́ kǝto wǝ́ yǝ lo ku rǝ fɛɛwǝ sa we, yǝ lǝŋ koru anya dierǝ rɛ yǝ lǝ́ǝ fǝ la pɛɛnɩ lah wɛ.» <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Kǝ́ fwɛɛŋʊrʊtǝyǝ sa ŋ na wɛɛlɩ ŋ na lɛ we, wǝ́ ŋ pìri kǝkpǝŋkǝ we kpǝlo.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Pɔlʊ la siɛnɩ lo ko Makedonia mǝ Ehelatǝpǝ lǝ tǝŋtǝǝwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Kǝ́ gasarǝ sa la lɛ we, wǝ́ Pɔlʊ ŋ pwò alɔnuŋtǝpǝ we, wǝ́ ŋ kpìi pǝla wɛɛlɛŋwǝ, wǝ́ ŋ kǝ̀ra pǝ, wǝ́ ŋ ko ŋ ko Makedonia. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Kǝ́ ŋ nǝ fǝ rǝ Makedonia lǝ gǝŋrǝ sa we, wǝ́ ŋ kpìi enyipǝ la wɛɛlɛŋwǝ ŋpa. Wǝ́ ŋ ko ŋ ko Ehelatǝpǝ lǝ gǝŋrǝ. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Wǝ́ ŋ yeli akɛɛnyɔŋpǝ ata rǝ gǝŋrǝ sa. Wǝ́ ŋ kǝ ŋ pǝ́ ŋ fii gʊrɔrǝ mǝ ŋ ko Siri. Kǝ́ ŋ no ŋ nuŋ ǝkǝnǝŋ Oyudatǝpǝ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ yee mǝ no turɔɔrɔɔwǝ we, wǝ́ ŋ sìɛnɩ ŋ fǝ̀ rǝ Makedonia. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Enyipǝ we pǝ ka kʊla mǝ ŋwǝ pǝ kaamǝ: Piro le pi Sopatɛrǝ, Eberetǝpǝ wǝ́ ŋ ri. Aritakǝ mǝ Sekuŋdo pǝ ka kʊla, Etesalonikatǝpǝ wǝ́ pǝ ri, Dɛrǝbǝtǝnyiyǝ we pǝ lóo pwo Gayo, Timote fǝ kʊla mǝ Tisiko mǝ Tǝrofimo ŋpǝ pǝ ke ri Azitǝpǝ wǝ. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Ŋpǝ enyipǝ sa pǝ conu pǝ kolu pǝ kǝ ŋ rǝŋ lǝ rǝ Tǝrowa. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Ŋlǝ paa we, kǝ́ yǝ le ri keerilaanyarǝwǝ la wǝcɛkpǝ yǝ la lɛ we, wǝ́ le fìi gʊrɔrǝ rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Filipi lo ko ŋ ko. Juu tʊʊ la kǝmaa, wǝ́ le ci okolu lo tùu pǝ rǝ Tǝrowa. Wǝ́ le yeli juu pǝrɩmata rǝ tǝŋtǝǝwǝ sa.<verse eid="ACT 20:6" /></para>
  <para style="s">Pʊlʊ lo ko ŋ ka kǝra alɔnuŋtǝpǝ rǝ Tǝrowa</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Kuluwǝ le jisǝsǝŋrǝ we, wǝ́ lǝ pǝlǝ lo kùu kǝ le ri Kulǝtǝyǝ le keeriwǝ. Wǝ́ Pɔlʊ ŋ ka ŋ tɛɛrɩ mǝ alɔnuŋtǝpǝ we mǝ ŋ kpii pǝ lo okopiyǝ. Kǝ́ ŋ kǝ ŋ pǝ́ ŋ pwɛyɩ mǝ gaalǝǝrǝkǝ kǝto we, wǝ́ ŋ rè ŋ yà mǝ atɛɛrɩkǝ we wɩɩ, wǝ́ kǝ kolu kǝ cɩ̀ɩ kǝ sǝ̀pǝ. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Pǝ tòo akaŋreyǝ pǝ tǝ̀nǝ rǝ baŋsʊrʊyǝ we lo guŋuŋnɛŋkpǝ we lo kùu le ke tini wǝ. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Kosopiyǝ rɛ pǝ lóo pwo Etike ke tini rǝ fasǝrɛyǝ la kǝlɛɛrɩkǝ. Wǝ́ eniŋriemumuŋyǝ rɛ yǝ yà yǝ kaŋ rɔɔnʊ ŋwǝ, a nyɩŋ Pɔlʊ tǝ re ya láa wɛɛlɩ rǝ ko. Eniŋrieyǝ we lǝ mǝrǝ wǝ́ ŋ rù rǝ baŋsʊrʊyǝ we lo gutatǝkpǝ ŋ pǝlǝ ŋ tɔ̀ɔ. Kǝ́ pǝ la ta ŋwǝ pǝ leh yiili we, wǝ́ pǝ nyɩnɩ lǝ kpǝ́. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Wǝ́ Pɔlʊ ŋ sʊ̀ʊ kalaŋkalaŋ ŋ pǝlǝ ŋ tùu ŋwǝ. Wǝ́ ŋ pɛ̀ɛlɩ ŋ sìi ŋwǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ rè. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ poo suu vurǝ, kpii vɔrʊrǝ.» <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Kǝ́ Pɔlʊ ŋ na siɛnɩ ŋ na ka rɛ gukpǝ we we, wǝ́ ŋ sǝ̀pǝ keeriwǝ we. Wǝ́ ŋ rili. Wǝ́ ŋ tǝ rè atɛɛrɩkǝ we ŋ yà wɩɩ ǝrǝ rokoŋpikaalǝwǝ. Wǝla kǝmaakǝ, wǝ́ ŋ pwɛ̀yɩ. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Kosopiyǝ we paa we, pǝ rè ŋwǝ pǝ ko ŋ ko a nyɩŋ kpii vɔrʊrǝ purupuru. Wǝ́ tuwǝ sa wǝ kpii nyi ri ŋ nyi lo okopimumuŋyǝ rɛ ŋpa.<verse eid="ACT 20:12" /></para>
  <para style="s">Pɔlʊ lo ru rǝ Tǝrowa lo ko tǝŋtǝǝwǝ we pǝ lóo pwo Mile</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Wǝ́ ŋlǝ paa lǝ fìi gʊrɔrǝ lo conu lo ko ŋ ko tǝŋtǝǝwǝ we pǝ lóo pwo Asosǝ. Tǝŋtǝǝwǝ sa wǝ́ yǝ loh ko lǝ kǝ fǝ Pɔlʊ. Kpiikǝ tɛnɩ wǝ ǝkǝnǝŋ ŋ náa saŋ ŋ fǝ rǝ gbarǝkʊŋrǝ ŋ ko tǝŋtǝǝwǝ sa. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Kǝ́ ŋ no po tu lǝ rǝ Asosǝ we, wǝ́ lǝ fǝ̀ ŋwǝ mǝ gʊrɔrǝ we lo ko ŋ ko tǝŋtǝǝwǝ we pǝ lóo pwo Mitilɛnǝ. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Fɛɛwǝ we, wǝ́ lǝ fǝ̀ rǝ apʊyǝ lo ko ŋ ko. Wǝ́ lo kolu lǝ kǝ̀lǝ mǝ tǝŋtǝǝwǝ we pǝ lóo pwo Sio mǝ gaalǝǝrǝkǝ. Juuyitǝrǝ we, wǝ́ lo kolu le fìi tǝŋtǝǝwǝ we pǝ lóo pwo Samosǝ. Juutatǝrǝ wǝ́ lo kolu le fìi tǝŋtǝǝwǝ we pǝ lóo pwo Mile. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Kpiikǝ Pɔlʊ ŋ nǝǝ kǝ ŋ pǝ́ ŋ kǝ pǝlǝ eniyǝ rǝ Azi kǝto we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ ŋ nǝŋ yaa rǝ Efeso. Yà kǝ ŋ fǝǝlǝ kǝ ŋ nyɩɩ ŋ ke fii Yerusalɛmǝ mǝ Paŋtekotǝyǝ le jirǝ. <figure style="fig" file="GPS_Paul3-BW.tif" size="col" copy="Wycliffe Global Alliance" ref="20:16" /><verse eid="ACT 20:16" /></para>
  <para style="s">Pɔlʊ la wɛɛlɩ le tíi alɔnuŋtǝpǝ we pǝ kpii rǝ Efeso lo omumuŋpǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Wǝ́ Pɔlʊ ŋ kpìi enyipǝ rǝ Mile pǝ kolu pǝ pwò alɔnuŋtǝpǝ we rǝ Efeso lo omumuŋpǝ pǝ pǝ. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Kǝ́ pǝ le pe fii we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ cii wǝ sɩsiɛrɩ, kǝ́ ŋ́ ne re mǝ wɛ rǝ nǝ mǝrǝ fǝ rǝ jisǝsǝŋrǝ we ŋ́ pǝlǝ ŋ́ fìi Azi wǝ. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ŋ́ nǝ fǝ wɛɛpɛɛlɩwǝ ŋ́ ne yee kǝnǝnɛkǝ ŋ no koonu Kulǝtǝyǝ Yesu, mǝ enimiyǝ, mǝ arianyɩŋyǝ we ŋ́ na nyɩŋ saŋ rǝ Oyudatǝpǝ lo nyuŋrikpǝ lo oŋuŋkǝ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Ŋ́ nǝǝ fǝ tǝrɛ ŋ́ ŋwaa nǝ. Tuwǝ we wǝ lóo koru nǝ otoŋ we, ŋ́ na kaŋ nǝ wǝ, rǝ enyipǝ lǝ mǝrǝ mǝŋ nǝ anyarǝyǝ. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Wǝ́ ŋ́ na nyɩɩ mǝ Oyudatǝpǝ mǝ Ehelatǝpǝ kǝ pǝ siɛrɩ pǝ pǝ Worokoyǝ lǝ kpǝŋ, kǝ pǝ lɔ loh Kulǝtǝyǝ Yesu pǝ nuŋ. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Rǝkǝsa we, ŋ́ noh ko Yerusalɛmǝ. Wɛɛkenikenirǝ ya lóo tu mǝ ǝkǝnǝŋ mǝ ŋ ko. Ŋ́ nee ci tuwǝ we wǝ loh ko wǝ ke yee mǝ. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Paape ŋ́ cii wǝ, Wɛɛkenikenirǝ ya láa nyɩɩ lǝ ŋ tíi mǝ rǝ tǝŋtǝ ri ŋ tǝŋtǝ ǝkǝnǝŋ akpɛtɛɛyǝ mǝ acʊcʊʊrʊyǝ yǝ ya yǝ lǝ́ǝ rǝŋ mǝ. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Ŋmǝ paa we, mǝ vɔrʊrǝ lee ri tǝrɛ mǝ mǝ. Tuwǝ we wǝ lǝ mǝ kpuŋkpuruŋ wǝ kaamǝ ŋ ko tu mǝ kǝnǝnɛkǝ sa la kǝtɛɛkǝ, Kulǝtǝyǝ Yesu la kǝnǝnɛkǝ we ŋ ne kpii mǝ wǝ, ŋkǝ kǝnǝnɛkǝ sa kǝ kaamǝ Worokoyǝ la lɛsiɛrɩwǝ le dieceeceerǝ we la atɛŋkǝ.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />Rǝkǝsa ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ ŋnǝ epǝ we kpǝlo lǝ kpǝŋ ŋ́ nǝ pǝ ŋ́ na pa tɛŋ Worokoyǝ le wǝpilirikpǝ le dierǝ ŋ́ ne tíi we, nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Kǝto ruŋruŋ le jirǝ ŋ́ nóo koru atɛŋ dierǝ sa rǝ nǝ enimiyǝ ǝkǝnǝŋ ŋ́ ne yee mǝ kǝnǝnɛkǝ. Wǝ́ mǝŋ sooso, rɛ loo po koru eyee ŋ saŋ rǝ etieyǝ sa ŋ́ ne tíi nǝ we, wǝ fǝ ŋwǝ oo. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Duturǝ ɖi ŋ́ nǝǝ fǝ tǝrɛ ŋ́ ŋwaa nǝ. Tuwǝ we Worokoyǝ ŋ nǝ́ǝ pǝ́ we, ŋ wǝ wǝ́ ŋ́ na tɛŋ ŋ́ ne tíi nǝ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Nǝ re nǝ wɛ sɩsiɛrɩ, kǝ nǝ re amɛɛpǝ we Wɛɛkenikenirǝ lǝ fǝ le kpii nǝ rǝ akaakǝ nǝ mǝ yɩrɩ wǝ. Nǝ re Worokoyǝ la zʊmarǝ sɩsiɛrɩ. Ŋpǝ kǝto wǝ́ ŋ lʊ̀ʊ ŋwǝŋwǝ na ŋpǝrayǝ wǝ. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ŋ́ cii wǝ sɩsiɛrɩ, vǝ́ ŋ́ na pwɛyɩ la kǝmaa we, enyipǝ pǝ lo ru akɛɛlɔpǝ pǝ leh pe fii nǝ mǝrǝ. Wǝ́ pǝ lǝŋ fǝ pǝ cɛɛ amɛɛpǝ we. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Enyipǝ pǝ leh pe yi rǝ nǝ mǝrǝ pǝ ŋ tɛŋ anianiatǝtuyǝ kǝ alɔnuŋtǝpǝ pǝ nya fɛɛ pǝ siimǝ pǝ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Kǝto nǝ yee nǝ wɛ lo yurǝ, kǝ nǝ mǝ taalǝ wǝ ǝkǝnǝŋ cɛŋwǝ ta, wǝ́ ŋ́ nǝ fǝ ŋ́ ya náa kaŋ nǝ otuyǝ sa mǝŋ dumu mǝŋ jɔkɔŋ mǝ enimiyǝ. Ŋ́ naa pa wɛɛ.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />Kǝto rǝkǝsa ŋ́ ya ŋ́ nǝ́ǝ fǝ nǝ mǝ ŋ kpii Worokoyǝ rǝ akaakǝ mǝ na lɛsiɛrɩwǝ le dierǝ mǝrǝ. Ŋrǝ dierǝ sa lǝǝmǝ okopiyǝ lóo koonu nǝ otuceeceeyǝ we Worokoyǝ ŋ na kʊʊ ŋ nǝ tǝnǝ epǝ we kpǝlo pǝ ri na anɛŋ wǝ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ŋ́ naa mwɛɛrɩ rɛ la sɩkakpɛɛlɩ amaa sɩkamwɛɛrɩ amaa rɛ la kǝkpa le nimi. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Ŋnǝŋnǝ nǝ cii wǝ ǝkǝnǝŋ mǝ wǝkaakpǝ sa wǝ́ ŋ́ nǝ́ǝ fǝ mǝ ŋ yee kǝnǝnɛkǝ oturu ŋlǝ mǝ mǝ ǝtǝŋpǝ yǝ láa nya tuwǝ we wǝ ya wǝ lée yee lǝ ariaayǝ wǝ. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Wǝ́ ŋ́ náa lɛ mǝ ŋ kaŋ nǝ wǝ eni ri ŋ ni ǝkǝnǝŋ vǝ́ a ya lée yee kǝnǝnɛkǝ mǝŋkǝsa we, fɛɛwǝ we wǝ́ o lóo koru otoŋ ariariatǝpǝ wǝ. Kǝ nǝ mǝ taalǝ Kulǝtǝyǝ Yesu le etieyǝ ŋwǝŋwǝ ŋ tɛnɩ ǝkǝnǝŋ pǝ láa pɛɛrɩ yǝ we ŋ nóo koonu tuwǝ pǝ ŋ teeri yǝ we ŋ náa lɔ tuwǝ wǝ.»<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Kǝ́ ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ pǝlo kpǝlo pǝ sʊ̀ʊ pǝ kʊnʊ, wǝ́ ŋ mwɛnɩ nyuŋkpǝ. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Wǝ́ pǝlo kpǝlo pǝ yà pǝ ke ŋ wee ŋpaŋpa. Wǝ́ pǝ kolu pǝ ko ŋ puru ŋwǝ. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Tuwǝ kororo wǝ tǝ wǝ cò pǝla tǝlarǝwǝ wǝ kaamǝ dierǝ we ŋ tɛnɩ ǝkǝnǝŋ pǝ lǝŋ tǝ pǝ pa nyɩŋ na anyɩŋkǝ. Wǝ́ pǝ kolu pǝ cò na kʊŋ ǝrǝ gbanǝŋwaarǝ lǝ kpǝŋ.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Pɔlʊ la tɛlɩ Yerusalɛmǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Kǝ́ yǝ la kǝra pǝ yǝ la lɛ we, wǝ́ le fìi gbanǝŋwaarǝ lo ko ŋ ko kǝtǝrǝceŋceŋ ǝrǝ Kɔsǝ. Gaalǝǝrǝkǝ wǝ́ lo kolu le fìi Rodɛsǝ. Wǝ́ lǝ fǝ̀ rǝ we lo kolu le fìi Patara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Wǝ́ la nyà gbanǝŋwaarǝ rɛ loh ko Fenisi. Wǝ́ le fìi rǝ la pwɛ̀yɩ lo ko ŋ ko. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Kǝ́ yǝ la nyɩŋ Kipǝro yǝ la maŋ we, wǝ́ la cà wǝ lo cò rǝ kǝpɛŋkǝ. Wǝ́ lǝ fǝ̀ lo ko ŋ ko Siri. Wǝ́ lo kolu la sʊ̀ʊ rǝ Tiro. Fɛɛwǝ sa wǝ́ gbanǝŋwaarǝ sa gǝ ŋ pǝ ba pɔrʊ eleeyǝ dǝnǝ wǝ. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Wǝ́ la nyɩnɩ alɔnuŋtǝpǝ rɛ rǝ fɛɛwǝ we. Wǝ́ le tini pǝlǝ kpǝŋ juu pǝrɩmata. Wǝ́ Wɛɛkenikenirǝ bɔ̀rʊ ganǝ pǝ ǝkǝnǝŋ Pɔlʊ ŋ poo ko Yerusalɛmǝ, wǝ́ pǝ tìi nǝ wǝ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Kǝ́ kuluwǝ we wǝ lo ko wǝ lah lɛ ko wǝ́ la ka ŋ pwɛyɩ. Wǝ́ pǝlo kpǝlo mǝŋ pǝle etiepǝ mǝŋ epipǝ pǝ yili pǝ sìimǝ lǝ. Wǝ́ pǝ rù mǝ lǝ rǝ tǝŋtǝǝwǝ sa, wǝ́ pǝ kolu pǝ cò lǝ kʊŋ kpa ǝrǝ apʊyǝ kǝlɛɛrɩkǝ. Wǝ́ loh kpǝlo la sʊ̀ʊ la kʊnʊ rǝ fɛɛwǝ we, wǝ́ la mwɛnɩ nyuŋkpǝ. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Kǝ́ yǝ la kǝra awɛ yǝ la lɛ we, wǝ́ le ke ŋ fii gbanǝŋwaarǝ. Wǝ́ pǝ kpìi pǝ kpǝ̀lǝŋ pǝ ko ŋ ko pǝla anyarǝyǝ. <verse eid="ACT 21:6" /><verse number="7" style="v" sid="ACT 21:7" />Ru rǝ Tiro ko Polemayi wǝ́ le fìi gbanǝŋwaarǝ la kpà. Wǝ́ lo kolu le cèeni alɔnuŋtǝpǝ rǝ tǝŋtǝǝwǝ sa, wǝ́ le tini pǝlǝ kpǝŋ ji ceŋceŋ. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Gaalǝǝrǝkǝ wǝ́ la pwɛ̀yɩ. Wǝ́ lo kolu le fìi Sezare. Wǝ́ lo kolu la sʊ̀ʊrʊ rǝ Worokoŋtietɛŋtɛlɩtǝyǝ we pǝ lóo pwo Filipo la nyarǝwǝ. Ka kʊ̀la mǝ enyi apǝrɩmatapǝ we pǝ sàa pǝ pɔ̀rʊ rǝ Yerusalɛmǝ wǝ. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Kǝ lǝǝmǝ akɔrʊpǝ eniǝ. Pǝ lee ke ci pǝrǝŋyǝ. Oworokokpɛɛnuŋtɛŋtǝpǝ wǝ́ pǝ ke ri. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Le tini rǝ we wǝ lɔ̀ eciyǝ. Wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ rɛ pǝ lóo pwo Agabo ŋ rù rǝ Yudeya ŋ pǝlǝ. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Kǝ́ ŋ na pa nyɩŋ lǝ we, wǝ́ ŋ fǝ̀ Pɔlʊ la apɔsɔyǝ ŋ pàrǝ na wɛ la akparǝyǝ mǝ wǝkaakpǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Wɛɛkenikenirǝ ya láa tɛŋ ǝkǝnǝŋ we, nyiyǝ we ŋ lǝǝmǝ apɔsɔyǝ sa we, kǝ́ Oyudatǝpǝ pǝ lah ka parǝ ŋwǝ rǝ Yerusalɛmǝ wǝǝ, kǝ pǝ fǝ ŋwǝ pǝ kpii epǝ we pǝ lee ri Oyudatǝpǝ rǝ akaakǝ». <verse eid="ACT 21:11" /><verse number="12" style="v" sid="ACT 21:12" />Kǝ́ yǝ lo nuŋ etieyǝ sa we, wǝ́ ŋlǝ mǝ alɔnuŋtǝpǝ we rǝ Sezare le kpìi Pɔlʊ la dɔɔkpɛɛrǝ ŋ poo ko Yerusalɛmǝ. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Wǝ́ Pɔlʊ ŋ pǝ̀ lǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyée wee wǝ? Nǝ ya nǝ nyée kpii mǝ ziɔŋrǝ la awɛɛlɩkǝ rǝ. Ŋmǝ we, ŋ́ na kpaka ŋ tini rǝ. Ŋkǝ pǝ parǝ mǝ ko feepi wǝǝ. Ŋ́ nóo koru ǝkpǝ́ rǝ Yerusalɛmǝ ŋ́ koonu Kulǝtǝyǝ Yesu la nyɩŋrǝ.» <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Kǝ́ ŋ naa tɛɛnɩ ŋ lɔ leh dierǝ kǝto yǝ lǝǝ tǝ la nyɩɩ mǝ ŋwǝ. Wǝ́ la tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ lǝ kǝǝpǝ́wǝ wǝ pǝ».<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Rǝ ecipiyǝ rɛ lǝ mǝrǝ, kǝ́ yǝ la kpaka yǝ la lɛ wǝ́ lo ko ŋ ko Yerusalɛmǝ. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Alɔnuŋtǝrɛɛpǝ rǝ Sezare ŋpǝ ŋkpɛ pǝ sìimǝ lǝ. Wǝ́ pǝ fǝ̀ lǝ pǝ kolu Kipǝrotǝnyiyǝ rɛ pǝ lóo pwo Nasɔŋ la nyarǝwǝ. Fɛɛwǝ lo kolu la sʊ̀ʊrʊ wǝǝ. Nyiyǝ sa láa sʊma wǝ la panǝ ŋpa.<verse eid="ACT 21:16" /></para>
  <para style="s">Pɔlʊ lo ko Yakubu lǝ kpǝŋ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Kǝ́ yǝ le ke fii Yerusalɛmǝ we, wǝ́ apaanʊpǝ pǝ lɔ̀ lǝ mǝ faawǝ. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Gaalǝǝrǝkǝ wǝ́ Pɔlʊ ŋ yili mǝ lǝ lo kolu Yakubu la nyarǝwǝ. Wǝ́ zʊmarǝ lo omumuŋpǝ kpǝlo ŋpǝ ŋkpɛ pǝ pǝlǝ fɛɛwǝ we. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Wǝ́ Pɔlʊ ŋ cèeni pǝ. Wǝ́ ŋ fǝ̀ tu ri ŋ tu Worokoyǝ ŋ ne yee, saŋ rǝ ŋwǝ Pɔlʊ la kǝnǝnɛkǝ rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ we, ŋ pɔ̀ pǝ la amayǝ. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Kǝ́ pǝ lo nuŋ amayǝ sa we, wǝ́ pǝ kǝ̀ Worokoyǝ. Wǝ́ pǝ tìi Pɔlʊ ǝkǝnǝŋ: «Kɛrɩ, yɩrɩ re. Oyudatǝpǝ pǝ loh ko lafawǝ pakapaka pǝ la siɛrɩ pǝ le yee alɔnuŋtǝpǝ. Pǝ lǝŋ kuŋ Mose le seyǝ lo oruukǝ. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Paa pǝ lo nuŋ enyipǝ pǝ ya pǝ láa wɛɛlɩ pǝ ŋ ru rǝ lǝ́, ǝkǝnǝŋ ŋlǝ́ a ya láa kaŋ Oyudatǝpǝ we pǝ kpii rǝ enyipǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ lo otuyǝ, pǝ nyarǝ Mose le seyǝ pǝ co. Wǝ́ a ya lée tíi pǝ pǝ pǝǝ tǝ pǝ kǝǝlǝ pǝle epipǝ, pǝ nyarǝ Oyudatǝpǝ lo kǝsuŋkǝ pǝ co. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Yǝ leh yee nɛ rǝkǝsa? Duturǝ ɖi enyipǝ pǝ lóo nuŋ wǝ taa ǝkǝnǝŋ ŋlǝ́ ǝlǝ pǝ. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Rǝkǝsa we, yee tuwǝ sa yǝ leh tíi lǝ́ wǝ. Enyipǝ eniǝ rǝ lǝh mǝrǝ pǝ la yɩrɩ gɔrǝ. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Fǝ pǝ a kʊla mǝ lá wɛ, kǝ nǝ ke yee ewiikǝ lo kǝsuŋkǝ. Lɔ pǝlo otooyǝ kɩɩkɩ a mwara, kǝ pǝ nya fɛɛ pǝ kɔlɩ yurǝ. Eniyǝ we nyi ri ŋ nyi le ci wǝ ǝkǝnǝŋ otuyǝ we pǝ la wɛɛlɩ pǝ lo ru rǝ lǝ́ we, pǝ la kaa pǝ la tɛɛ lǝ́ rǝ. Pǝ láa lɛ pǝ nyɩŋ pǝ ci ǝkǝnǝŋ ŋlǝ́ŋlǝ́ e lée yee a mǝ ŋ saŋ rǝ Mose le seyǝ. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Paa alɔnuŋtǝpǝ we pǝ lee ri Oyudatǝpǝ we, yǝ la ŋʊrʊ yǝ la maŋ pǝ lo ru rǝ etieyǝ we yǝ le si ɖurǝ wǝ: Pǝ poo wo kɛɛyǝ pǝ la wʊ pǝ lo toolu wǝfɛɛkpǝ la gakǝ. Pǝ poo wo jɩmɩrǝ. Pǝ poo wo kɛɛyǝ we ŋ nǝ kpǝ́ cʊrʊcʊrʊ wǝ. Pǝ pee yee nuŋruwǝ.»<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Gaalǝǝrǝkǝ wǝ́ Pɔlʊ ŋ fǝ̀ enyipǝ sa eniǝ ŋ kʊ̀la mǝ na wɛ. Wǝ́ ŋ yeli ewiikǝ lo kǝsuŋkǝ kǝtǝrǝceŋceŋ mǝŋ pǝ. Wǝ́ ŋ ko ŋ ko Worokoyǝ la nyarǝwǝ kǝ ŋ ka tɛŋ jirǝ we ewiikǝ sa le eciyǝ yǝ loh ku wǝ, kǝ nyi ri ŋ nyi ŋ nya fɛɛ ŋ pǝ mǝ no toolutuwǝ.<verse eid="ACT 21:26" /></para>
  <para style="s">Pǝ la pa lɔ Pɔlʊ rǝ Worokoyǝ la nyarǝwǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Wǝcukpǝ we wǝpǝrɩmatakpǝ wǝ lah ta wǝ lɛ rǝ. Wǝ́ Oyudatǝpǝ rɛ pǝ rù rǝ Azi pǝ nyɩnɩ Pɔlʊ rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ pǝ kpìi kǝkpǝŋkǝ kpǝlo kɩɩkɩ la gasarǝ. Wǝ́ pǝ lɔ̀ ŋwǝ. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Wǝ́ pǝ ko ŋ woolu ǝkǝnǝŋ: «Isǝrayɛlǝtǝpǝ, nǝ pa lɔ nǝ koonu lǝ oo! Ŋwǝ ǝyǝǝ! Nyiyǝ sa ŋ ya ŋ náa kaŋ enyipǝ kpǝlo kɩɩkɩ rǝ fɛɛ ri ŋ fɛɛ lo otuyǝ. Wǝ́ no otukaŋyǝ sa yǝ le yi yǝ la tɛɛ rǝ lǝh kǝkpǝŋkǝ, leh seyǝ mǝ Worokoyǝ la nyarǝwǝ sa. Wǝ́ ŋ ne re enyipǝ pǝ lee ri Oyudatǝpǝ ŋ ne fii Worokoyǝ la nyarǝwǝ. Kǝsa la cɩɩrɩ fɛɛkenikeniwǝ sa.» <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Pǝ sǝnǝ pǝ nyɩnɩ Pɔlʊ ŋpǝ mǝ Tǝrofimǝ ŋ no ru rǝ Efeso rǝ tǝŋtǝǝwǝ sa. Wǝ́ pǝ ko ŋ pu wǝ ǝkǝnǝŋ Pɔlʊ rè ŋwǝ fìi Worokoyǝ la nyarǝwǝ. <verse eid="ACT 21:29" /><verse number="30" style="v" sid="ACT 21:30" />Wǝ́ tǝŋtǝǝwǝ sa wǝ yili kpiti. Wǝ́ enyipǝ pǝ làrǝ pǝ pǝlǝ pǝ kù sisi. Wǝ́ pǝ lɔ̀ Pɔlʊ. Wǝ́ pǝ tìini ŋwǝ pǝ rù rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ pǝ tanǝ wǝla aŋwaayǝ kǝtǝrǝceŋceŋ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Pǝ kǝ ŋ pǝ́ pǝ wʊ Pɔlʊ. Wǝ́ Romatǝkɔŋtǝpiliyǝ we ŋ kpii rǝ Yerusalɛmǝ ŋ nunu wǝ ǝkǝnǝŋ kaa wǝǝ Yerusalɛmǝ lǝ tǝŋtǝǝwǝ kpǝlo kɩɩkɩ wǝ ya wǝ láa lɔ gasarǝ. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Kǝtǝrǝceŋceŋ wǝ́ ŋ fǝ̀ otuusiitǝpǝ mǝ otuusiitǝmumuŋpǝ ŋ kʊ̀la mǝ na wɛ. Wǝ́ pǝ sù pǝ ko ŋ ko kǝkpǝŋkǝ we lǝ kpǝŋ. Kǝ́ enyipǝ pǝ la nyɩŋ Romatǝkɔŋtǝpiliyǝ sa mǝ no otuusiitǝpǝ ko, wǝ́ pǝ wɛ̀ɛ mǝ Pɔlʊ lo oculukǝ. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ ŋ tìi pǝ lɔ̀ Pɔlʊ. Wǝ́ pǝ pàrǝ ŋwǝ mǝ akpɛtɛɛyǝ kpeewǝ yi. Wǝ́ ŋ kǝ ŋ pǝ́ ŋ ci nyiyǝ we kǝtǝŋkǝ Pɔlʊ ŋ ri wǝ mǝ tuwǝ ŋ ne yee wǝ. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Paape ǝpǝ pǝ láa tɛŋ wǝ, ǝpǝ pǝ láa tɛŋ pʊŋpwa. Kǝto Romatǝkɔŋtǝpiliyǝ sa loo koru onuŋ tukpatɩwǝ rɛ. Duturǝ ɖi enyipǝ pǝ ka ŋ wɛɛlɩ woowoo kururu. Wǝ́ ŋ tìi pǝ fǝ̀ Pɔlʊ pǝ ŋ ko otuusiitǝpǝ la nyarǝwǝ. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Kǝ́ Pɔlʊ ŋ no ko ro orusaŋrɛguŋpolurǝ we, wǝ́ otuusiitǝpǝ we pǝ fǝ̀ ŋwǝ rǝ. Duturǝ ɖi kǝkpǝŋkǝ we kǝ ko ŋ yururu kǝto. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Kǝceece kǝkpǝŋkǝ we kpǝlo kǝ wòolu kǝ sìimǝ ŋwǝ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Nǝ wʊ ŋwǝ!»<verse eid="ACT 21:36" /></para>
  <para style="s">Pɔlʊ lǝ fǝ ne dierǝ la tɛŋ rǝ Oyudatǝpǝ la kǝnyɩŋkǝ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Eniyǝ we pǝ lǝ fǝ Pɔlʊ pǝ leh fii otuusiitǝpǝ we la nyarǝwǝ we, wǝ́ Pɔlʊ ŋ wɛɛlɩ mǝ Romatǝkɔŋtǝpiliyǝ we. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋ́ nóo koru atɛŋ tǝrɛ?» Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ kpǝ̀lǝŋ ŋ pǝ̀ Pɔlʊ ǝkǝnǝŋ: «A láa wɛɛlɩ Kǝhelatǝkǝ? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />We ŋkǝ ŋlǝ́ e ri Ejipǝtetǝnyiyǝ sa ŋ pǝlǝ ŋ kpìi gasarǝ wǝ faa panǝ wǝ? Wǝ́ ŋ fǝ̀ enyiwʊʊlʊtǝpǝ lafawǝ niǝ pǝ kolu pǝ kpìi rǝ nyɔŋkpaakǝtǝǝwǝ?» <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Wǝ́ Pɔlʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ we, Yudatǝpiyǝ wǝ́ ŋ́ ri. Ŋ́ no ru rǝ Taaso, wǝ kpii rǝ Silisi. Ŋ́ noo ru rǝ tǝŋtǝǝyɔkɔyɔkɔwǝ rɛ. Dɔɔkpɛ, koonu mǝ kʊŋwǝ ŋ́ wɛɛlɩ ŋ́ tíi kǝkpǝŋkǝ.» <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ kòonu na kʊŋwǝ. Wǝ́ Pɔlʊ ŋ yili ŋ yàa rǝ orusaŋrɛguŋpolurǝ we. Wǝ́ ŋ kàa kǝkpǝŋkǝ la akaakǝ. Wǝ́ pǝlo kpǝlo pǝ rǝnǝ yiriri. Wǝ́ ŋ wɛ̀ɛlɩ ŋ tìi pǝ mǝ Kǝhebǝritǝkǝ.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />Wǝ́ Pɔlʊ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ apaanʊpǝ, mǝ tǝ peni, nǝ nuŋ dierǝ sa ŋ́ nah tɛŋ ŋ pɛɛnɩ mǝ wɛ rǝkǝsa wǝ.» <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Kǝ́ pǝ lo nuŋ Pɔlʊ ŋ ya ŋ náa wɛɛlɩ Kǝhebǝritǝkǝ we, wǝ́ pǝ rǝnǝ yiriri. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />«Yudatǝpiyǝ wǝ́ ŋ́ ri. Pǝ lǝ mǝ mǝ rǝ Taaso rǝ Silisi lǝ gǝŋrǝ mǝrǝ. Paape Yerusalɛmǝyǝ sa lǝ mǝrǝ wǝ́ ŋ́ ne tíi ŋ́ na naanǝ. Wǝ́ Gamaliɛlɩ ŋ na kaŋ mǝ otuyǝ ŋ no ru rǝ lǝh ǝtǝtǝpǝ le esepǝ lo oŋuŋkǝ pɛpɛpɛ. Ŋ́ noo ko ŋ kuŋ Worokoyǝ lo oru, mǝŋ kǝ́ ruŋruŋ ŋnǝ ŋkpɛ nǝ nyǝŋ kuŋ Worokoyǝ lo oru wǝ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Wǝ́ ŋ́ yili ŋ́ tɛ̀ɛ rǝ epǝ we pǝ ke sìimǝ Kulǝtǝyǝ Yesu la kʊŋwǝ. Wǝ́ ŋ́ wʊlʊ pǝ. Wǝ́ ŋ́ pàrǝ enyipǝ mǝŋ etie mǝŋ ǝpǝrǝŋ. Wǝ́ ŋ́ lɔ̀ pǝ ŋ́ tanǝ. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Toolutǝmumuŋyǝ mǝ Oyudatǝpǝ lo omumuŋpǝ la wǝcakukpǝ pǝ lóo koru eri ɖaŋsieyǝ pǝ tíi nǝ. Pǝlǝ kpǝŋ kʊraa wǝ́ ŋ́ lɔ̀ wǝfwɛɛkpǝ ŋ́ kolu ŋ́ kòonu lǝh ǝtǝŋ Oyudatǝpǝ we pǝ kpii rǝ Damasǝko wǝ. Wǝ́ ŋ́ kolu kǝ ŋ́ ka lɔ alɔnuŋtǝpǝ we pǝ kpii rǝ tǝŋtǝǝwǝ sa ŋ́ pǝ Yerusalɛmǝ, kǝ ŋ́ pa ta pǝlo kǝtukoŋkǝ.»<verse eid="ACT 22:5" /></para>
  <para style="s">Pɔlʊ la tɛŋ na wɛɛsiɛrɩwǝ le dierǝ le tíi enyipǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />«Wǝ́ ŋ́ kpìi ŋ́ ko ŋ ko rǝ Damasǝko la gʊŋrǝ. Kǝ́ ŋ́ nah ta ŋ́ kǝlǝ mǝ Damasǝko we, a nyɩŋ wǝ lah ca mǝŋ cɔkɔŋtiizaarǝ. Kǝtǝrǝceŋceŋ wǝ́ wǝnyɩɩnɩmumuŋkpǝ rɛ wǝ rù rǝ yulaarǝ wǝ pǝlǝ wǝ cò wǝ sìri mǝ. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Wǝ́ ŋ́ rù ŋ́ tɔ̀ɔ rǝ kǝtǝǝwǝ. Wǝ́ kpɛɛwǝ rɛ wǝ ke ŋ tìi mǝ ǝkǝnǝŋ: “Sɔlʊ, Sɔlʊ, kǝ́ kǝto wǝ́ e le yi a la tɛɛ rǝ mǝ wǝ?” <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Wǝ́ ŋ́ pǝ̀ kpɛɛwǝ we ǝkǝnǝŋ: “Ŋlǝ́ ǝlǝ ǝ lǝǝwe, Kulǝtǝyǝ?” Wǝ́ kpɛɛwǝ we wǝ tɛnɩ ǝkǝnǝŋ: “Ŋmǝ Yesu, Nazarɛtǝtǝnyiyǝ we e le yi a la tɛɛ rǝ ŋ́ lǝǝwe.” <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Mǝ ǝtǝŋpǝ we pǝ nyɩnɩ wǝnyɩɩnɩkpǝ we. Paape pǝ loo nuŋ kǝ́ kpɛɛwǝ we wǝ yà wǝ ka ŋ wɛɛlɩ mǝ mǝ wǝ. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Wǝ́ ŋ́ pǝ̀ kpɛɛwǝ we ǝkǝnǝŋ: “Kǝ́ wǝ́ ŋ́ neh yee, Kulǝtǝyǝ?” Wǝ́ Kulǝtǝyǝ ŋ tìi mǝ ǝkǝnǝŋ: “Yi, kǝ o mǝ ko Damasǝko. Fɛɛwǝ we wǝ́ pǝ lah ka tɛŋ kǝnǝnɛkǝ we e leh yee pǝ tíi lǝ́.” <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Wǝ́ mǝ ǝtǝŋpǝ we pǝ ta mǝ rǝ akaakǝ pǝ ko ŋ ko Damasǝko, duturǝ ɖi wǝnyɩɩnɩkpǝ we wǝ kòonu ŋ́ nǝǝ tǝ ŋ́ ka ŋ nyɩŋ.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />Nyiyǝ rɛ ke kpii rǝ tǝŋtǝǝwǝ we. Pǝ lóo pwo ŋwǝ Anania. Láa sʊma Worokoyǝ mǝ anʊkɔrǝyǝ, wǝ́ ŋ née yee mǝ ŋ saŋ rǝ Mose le seyǝ pɛpɛpɛ. Wǝ́ Oyudatǝpǝ pǝ láa wɛɛlɩ sɩsiɛrɩ pǝ ŋ ru rǝ ŋwǝ. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Wǝ́ ŋ pǝlǝ ŋ yàa rǝ mǝ kǝlɛɛrɩkǝ, wǝ́ ŋ tìi mǝ ǝkǝnǝŋ: “Mǝ paanʊ Sɔlʊ, mǝ nyɩŋ”. Wǝ́ ŋ́ ka ŋ nyɩŋ rǝ kǝyaakǝ we. Wǝ́ ŋ́ nyɩnɩ ŋwǝ. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Wǝ́ ŋ tìi mǝ ǝkǝnǝŋ: “Lǝh ǝtǝtǝpǝ lo Worokoyǝ la pɔrʊ lǝ́ lǝ tǝnǝ ǝrǝ eniyǝ nɔ, kǝ a nya fɛɛ e ci nǝ kǝǝpǝ́wǝ, kǝ a lɛ a nyɩŋ ne nyikʊʊyǝ, kǝ o nuŋ na kpɛɛwǝ. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Duturǝ ɖi e lée ri na ɖaŋsielǝtǝyǝ, kǝ a tɛŋ tuwǝ we a la nyɩŋ, wǝ́ o lo nuŋ e tíi nyi ri ŋ nyi. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Rǝkǝsa, kǝ́ wǝ́ a ya lǝ́ǝ rǝŋ? Yi, kǝ pǝ wiiri lǝ́ worokomɛŋwǝ, kǝ pǝ wɛɛ ló oturɔɔrɔɔyǝ pǝ cɛ rǝ na nyɩŋrǝ.”»<verse eid="ACT 22:16" /></para>
  <para style="s">Yesu le tíi Pɔlʊ ŋ pwɛyɩ rǝ Yerusalɛmǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />Wǝla kǝmaakǝ wǝ́ ŋ́ sìɛnɩ ŋ́ kolu Yerusalɛmǝ. Wǝ́ ŋ́ kolu ŋ́ ka ŋ mwɛŋ nyuŋkpǝ rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ́ lǝ̀ǝ rǝ mǝ wɛ lǝ mǝrǝ. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Wǝ́ ŋ́ nyɩnɩ Kulǝtǝyǝ, wǝ́ ŋ tìi mǝ ǝkǝnǝŋ: «Fǝǝlǝ kǝ a pwɛyɩ rǝ Yerusalɛmǝ. Duturǝ ɖi pǝ lǝŋ pa tɛɛnɩ dierǝ sa a ya láa tɛŋ o mǝ ŋ ru rǝ mǝ wǝ.» <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Wǝ́ ŋ́ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ pǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ ŋmǝ ŋ́ ko ŋ ko Oyudatǝpǝ lo okumwɛŋnyuŋyǝ kpǝlo. Oturu ŋ́ na ka lɔ enyipǝ we pǝ la lɔ lǝ́ pǝ lo nuŋ, ŋ́ na pa taŋ. Wǝ́ ŋ́ ko ŋ koonu pǝ ŋ culu pǝ. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Eniyǝ we enyipǝ pǝ wʊlʊ lá ɖaŋsielǝtǝyǝ we pǝ lóo pwo Etiɛnɩ we, ŋmǝŋmǝ ŋ́ ka yaa. Wǝ́ wǝ ka lɛ wǝ ponu mǝ mǝ. Ŋmǝ ŋ́ lɔ̀ enyipǝ we pǝ wʊlʊ ŋwǝ la wǝkpakpǝ ŋ rè kʊraa.» <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Paape wǝ́ Kulǝtǝyǝ ŋ tìi mǝ ǝkǝnǝŋ: «Mǝ ko, ŋ́ neh kpii lǝ́ rǝ nɔ, rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ.»<verse eid="ACT 22:21" /></para>
  <para style="s">Pɔlʊ mǝ Romatǝkɔŋtǝpiliyǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Kǝ́ Oyudatǝpǝ pǝ lo co kǝtukoŋkǝ rǝ Pɔlʊ pǝ lo po ro ǝrǝ dierǝ sa we, wǝ́ pǝlo kpǝlo pǝ yà pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Nǝ wʊ ŋwǝ! Nyiyǝ sa kǝtǝŋkǝ laa laka ŋ tii vɔrʊrǝ rǝ kǝtǝǝwǝ.» <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Wǝ́ pǝ yà pǝ ka ŋ lɔ anarǝyǝ. Wǝ́ pǝ ke ŋ tie pǝla wǝkpakpǝ pǝ ŋ coolu. Wǝ́ pǝ ke ŋ yiili guŋguŋrǝ. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Wǝ́ Romatǝkɔŋtǝpiliyǝ we ŋ tɛnɩ ǝkǝnǝŋ pǝ fǝ Pɔlʊ pǝ fii otuusiitǝpǝ lo gukpǝ, kǝ pǝ culu ŋwǝ mǝ fwɛɛpǝlawǝ, kǝ Pɔlʊ ŋ nya fɛɛ ŋ tɛŋ tuwǝ kǝto pǝ ya pǝ lóo woolu ŋwǝ wǝ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Kǝ́ pǝ ya pǝ láa parǝ Pɔlʊ we, wǝ́ ŋ pǝ̀ tuusiitǝmumuŋyǝ we ǝkǝnǝŋ: «Pǝ la pɔrʊ gʊŋrǝ ǝkǝnǝŋ pǝ culu Romatǝpiyǝ mǝ fwɛɛpǝlawǝ, rǝ kǝ́ pǝ laa tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ wǝ?» <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />Kǝ́ tuusiitǝmumuŋyǝ sa ŋ no nuŋ dierǝ sa we, wǝ́ ŋ kolu ŋ tìi kɔŋtǝpiliyǝ we lǝ wǝ ǝkǝnǝŋ: «E leh yee mǝ nyiyǝ sa nɛ? Romatǝpiyǝ wǝ́ ŋ ri oo.» <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Wǝ́ kɔŋtǝpiliyǝ we ŋ pǝlǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tíi mǝ, Oromatǝpǝ wǝ́ e ri?» Wǝ́ Pɔlʊ ŋ tɛ̀ɛnɩ. <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋmǝ we, sɩkamumuŋyǝ rɛ wǝ́ ŋ na mwara kpɛŋ wǝ́ ŋ́ ne ci asiɛrɩ ŋ́ ne yee Oromatǝpǝ». Wǝ́ Pɔlʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ we, pǝ lǝ mǝ mǝ Romatǝpiyǝ». <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Wǝ́ enyipǝ we pǝ kǝ ŋ pǝ́ pǝ pǝ́ ne etieyǝ pǝ pwɛ̀yɩ rǝ nǝ kpǝŋ kǝtǝrǝceŋceŋ. Kǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ kǝceece Romatǝpiyǝ wǝ́ ŋ no kuŋ pǝ la parǝ we, wǝ́ vurǝ vìi ŋwǝ.<verse eid="ACT 22:29" /></para>
  <para style="s">Pǝ lo ko mǝ Pɔlʊ rǝ Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we lǝ kpǝŋ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Galǝǝrǝkǝ we, wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ kǝ ŋ pǝ́ ŋ ci tuwǝ kǝto Oyudatǝpǝ pǝ le yi pǝ la tɛɛ rǝ Pɔlʊ wǝ. Wǝ́ ŋ kùu mǝ otoolutǝpǝ lo omumuŋpǝ mǝ Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we. Wǝ́ ŋ kòonu pǝ wùru Pɔlʊ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ pǝlǝ pǝla kǝnyɩŋkǝ.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Wǝ́ Pɔlʊ ŋ yɩ̀rɩ Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we pʊrɩpʊrɩ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, ŋ́ cii wǝ ǝkǝnǝŋ ŋ́ ne re mǝ wɛ rǝ Worokoyǝ le enimiyǝ po ro ruŋruŋ mǝ ziɔŋrǝ laa tɔɔ mǝ bɔrǝ.» <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Wǝ́ toolutǝmumuŋyǝ we pǝ lóo pwo Anania ŋ tìi enyipǝ we pǝ kǝ kǝlǝ mǝ ŋwǝ ǝkǝnǝŋ pǝ ca Pɔlʊ rǝ nyuŋkpǝ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Wǝ́ Pɔlʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ bomu wǝ́ Worokoyǝ ŋ nah ca wǝ. Kǝ́ e tini ǝnǝ e lee ri lá wɛ le nyiyǝ<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">Rǝ Kǝhelatǝkǝ we, pǝ la ŋʊrʊ ǝkǝnǝŋ «Giriŋrǝ pǝ lo nuŋ sereyǝ».</char></note>. E le pe tii wǝ́ a ya láa tɛŋ ǝkǝnǝŋ ŋlǝ́ ǝ lǝh fǝ seyǝ a tɛŋ mǝ wǝkpaŋkpǝ, paa wǝ́ e le tíi pǝ ca mǝ. Wǝ lee kpii rǝ seyǝ ǝnǝ.» <verse eid="ACT 23:3" /><verse number="4" style="v" sid="ACT 23:4" />Wǝ́ epǝ we pǝ ka yaa pǝ tìi Pɔlʊ ǝkǝnǝŋ: «Keyi! A ya láa fɛɛ Worokoyǝ lo toolutǝmumuŋyǝ?» <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Wǝ́ Pɔlʊ ŋ tìi pǝ ǝkǝnǝŋ: «Ao, lǝh ǝtǝŋ ŋ́ nee ci wǝ ǝkǝnǝŋ toolutǝmumuŋyǝ wǝ́ ŋ ri. Pǝ la ŋʊrʊ rǝ seyǝ lǝ mǝrǝ ǝkǝnǝŋ: “Paa wɛɛlɩ rɔɔrɔ o ru rǝ lǝ́ kǝkpǝŋkǝ le piliyǝ.”»<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Pɔlʊ ke cii wǝ ǝkǝnǝŋ Oyudatǝkpaŋtɛŋtǝpǝ we la kǝtarɛɛkǝ kǝ ke ri Asadukitǝpǝ. Wǝ́ kǝtarɛɛkǝ kǝ ke rì Afarisitǝpǝ. Tuwǝ kǝto ŋ ka ŋ wɛɛlɩ kelele ǝkǝnǝŋ: «Lǝh ǝtǝŋ, Afarisitǝpǝ wǝ́ ŋ́ ri. Afarisitǝpǝ pǝ lǝ mǝ mǝ. Pǝ ya pǝ láa tɛŋ wǝkpaŋkpǝ mǝ mǝ, mǝ kǝ́ ŋ́ na lɔ ŋ no nuŋ ǝkǝnǝŋ enyiǝtǝpǝ pǝ láa saanǝ kǝto.» <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Kǝ́ Pɔlʊ ŋ na nya ŋ na tɛŋ dierǝ sa ko we, wǝ́ wǝkpaŋkpǝ wǝ pǝlǝ Afarisitǝpǝ mǝ Asadukitǝpǝ lǝ mǝrǝ. Wǝ́ kǝkpǝŋkǝ we kǝ sǝ̀pǝ. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Duturǝ ɖi Asadukitǝpǝ pǝ láa tɛŋ ǝkǝnǝŋ enyiǝtǝpǝ pǝ lǝŋ pa saanǝ, picoŋpiyǝ rɛ lee kpii, wǝ́ wɛɛrǝ la lɛ gbii, wǝ́ Afarisitǝpǝ ŋpǝ paa pǝ láa tɛŋ ǝkǝnǝŋ otuyǝ sa kpǝlo kɩɩkɩ yǝ kpii. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Wǝ́ pǝ yà pǝ ka ŋ wɛɛlɩ woowoo. Esekaŋtǝpǝ rɛ pǝ ri Afarisitǝpǝ pǝ ka kʊla. Wǝ́ pǝ yili pǝ sǝnǝ mǝ okopiyǝ ǝkǝnǝŋ: «Yǝ laa nyɩŋ bɔtɔɔrǝ rɛ rǝ nyiyǝ sa. Ayɩrɛ wɛɛrǝ rɛ amaa picoŋpiyǝ rɛ ŋ na wɛɛlɩ mǝ ŋwǝ.» <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Wǝ́ akpaŋyǝ we yǝ ka ŋ nyɩɩ yǝ ŋ naanǝ yǝ ŋ kʊla. Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ yà ŋ ko ŋ suu vurǝ ǝkǝnǝŋ pǝ lah pa laarǝ Pɔlʊ. Wǝ́ ŋ tìi no otuusiitǝpǝ ǝkǝnǝŋ pǝ ko pǝ kǝ fǝ Pɔlʊ rǝ enyipǝ we le kǝtiitiikǝ pǝ pwɛyɩ, kǝ pǝ fǝ ŋwǝ pǝ ŋ ko otuusiitǝpǝ lo gukpǝ. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />Kǝ́ kǝ la cɩɩ we, wǝ́ Kulǝtǝyǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Pɔlʊ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ nyɩɩ, a la wɛɛlɩ o lo ru rǝ mǝ rǝ Yerusalɛmǝ. Tǝ a ka wɛɛlɩ mǝŋkǝsa ke rǝ Roma.»<verse eid="ACT 23:11" /></para>
  <para style="s">Oyudatǝpǝ pǝ le ri nyuŋkpǝ kǝ pǝ wʊ Pɔlʊ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Galǝǝrǝkǝ we, wǝ́ Oyudatǝpǝ pǝ rili nyuŋkpǝ. Wǝ́ pǝ tù tuwǝ pǝ kpìi pǝla wɛ ǝkǝnǝŋ pǝ lǝŋ ri, pǝ lǝŋ ŋuŋ tu ri ŋ tu, ko ro eniyǝ we pǝ la wʊ Pɔlʊ wǝ. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Epǝ we pǝ rili nyuŋkpǝ sa pǝ lǝ́ǝ lǝ mǝŋ enyipǝ tǝniǝ fǝ mǝ ko. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Wǝ́ pǝ kolu pǝ tù otoolutǝmumuŋpǝ mǝ Oyudatǝpǝ lo omumuŋpǝ. Wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Yǝ lo tu yǝ le kpii lah wɛ ǝkǝnǝŋ yǝ lǝŋ ri tu ri ŋ tu ko ro eniyǝ we yǝ la wʊ Pɔlʊ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Kǝto we, ŋnǝ mǝ Oyudatǝkpaŋtɛŋtǝpǝ nǝ tíi Romatǝkɔŋtǝpiliyǝ we ŋ fǝ ŋwǝ ŋ po koonu nǝ, kǝ nǝ tǝǝnǝ ŋwǝ ǝkǝnǝŋ nǝ nyǝh pǝ́ nǝ ta ne dierǝ we nǝ yɩrɩ sɩsiɛrɩ. Ŋlǝ paa we, yǝ la kpaka, kǝ la wʊ ŋwǝ rǝ gʊŋrǝ kpɛŋ kǝ ŋ ci epe fii ɖǝǝnǝ.»<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Wǝ́ Pɔlʊ lǝ kpǝrǝyǝ rɛ ŋ nunu kǝ́ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ kɔŋ Pɔlʊ la kpɛrɛwǝ rɛ wǝ. Wǝ́ ŋ ko ŋ ko otuusiitǝpǝ lo gukpǝ we ŋ kolu ŋ tìi Pɔlʊ. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Wǝ́ Pɔlʊ ŋ pwò tuusiitǝmumuŋyǝ ceŋceŋ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Fǝ kosopiyǝ sa o ko Romatǝkɔŋtǝpiliyǝ we lǝ kpǝŋ. Lǝǝmǝ dierǝ rɛ ŋ neh tíi ŋwǝ.» <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Wǝ́ tuusiitǝmumuŋyǝ we ŋ fǝ̀ ŋwǝ ŋ ko ŋ ko kɔŋtǝpiliyǝ we lǝ kpǝŋ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kukpɛɛtǝyǝ we pǝ lóo pwo Pɔlʊ ŋ no pwo mǝ. Wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ ŋmǝ ŋ́ fǝ kosopiyǝ sa ŋ́ pǝ lǝ́ kpǝŋ. Lǝǝmǝ dierǝ rɛ ŋ neh tíi lǝ́.» <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />Wǝ́ kɔŋtǝpiliyǝ sa ŋ tà kosopiyǝ sa rǝ akaakǝ. Wǝ́ ŋpǝ mǝ ŋwǝ pǝ cɛ̀ pǝ kolu pǝ yàa kǝtakǝ kǝceŋceŋ. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ le die wǝ́ a ya lǝ́ǝ pǝ́ e tíi mǝ?» <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Wǝ́ kosopiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Oyudatǝpǝ pǝ le ke ri nyuŋkpǝ, kǝ pǝ pe tíi lǝ́ ǝkǝnǝŋ ŋlǝ́ ǝ fǝ Pɔlʊ ǝ pǝ Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ lǝ kpǝŋ sooso. Pǝ leh pe tíi lǝ́ ǝkǝnǝŋ pǝ lǝh pǝ́ pǝ ta ne dierǝ we pǝ yɩrɩ sɩsiɛrɩ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Paa lɔ pǝle dierǝ o nuŋ. Duturǝ ɖi enyipǝ pǝ teeri tǝniǝ rǝ pǝlǝ mǝrǝ pǝ lah kɔŋ Pɔlʊ la kpɛrɛwǝ, pǝ lo tu pǝ le kpii pǝla wɛ ǝkǝnǝŋ pǝ lǝŋ ri, pǝ lǝŋ ŋuŋ tu ri ŋ tu ko ro eniyǝ we pǝ la wʊ Pɔlʊ. Rǝkǝsa pǝ la kpaka pǝ tini rǝ. Wǝ́ pǝ ya pǝ lǝ́ǝ rǝŋ kǝ a nya a tɛɛnɩ rǝ ko.» <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Wǝ́ kɔŋtǝpiliyǝ we ŋ tìi kosopiyǝ we ǝkǝnǝŋ ŋ pee ci kǝ ŋ ka tɛŋ wǝ ŋ tíi rɛ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ mǝ ŋ ko.<verse eid="ACT 23:22" /></para>
  <para style="s">Pǝ lǝ fǝ Pɔlʊ pǝ la maŋ kǝŋyɩrɩtǝyǝ Felisǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ pwò otuusiitǝmumuŋpǝ eyi, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pɔrʊ otuusiitǝpǝ tuuru yi, orootɛtǝpǝ tǝpǝrɩmata mǝ okulocireetǝpǝ tuuru yi, kǝ nǝ kpaka nǝ ko Sezare mǝ dumurǝ le eniyǝ faŋceŋceŋ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Nǝ kpaka oroopǝ kǝ pǝ ree Pɔlʊ cʊrʊcʊrʊ pǝ ko kǝŋyɩrɩtǝyǝ Felisǝ lǝ kpǝŋ.» <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Wǝ́ Romatǝkɔŋtǝpiliyǝ sa ŋ ŋʊ̀rʊ ŋ manǝ ŋwǝ ǝkǝnǝŋ: <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />«Ŋmǝ Kǝlodǝ Lisia ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ́ na maŋ lǝ́, Kulǝtǝyǝ kǝŋyɩrɩtǝyǝ Felisǝ. Ŋ́ ya ŋ́ née ceeni lǝ́. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Nyiyǝ sa ŋ́ nǝ fǝ ŋ́ na maŋ lǝ́ we, Oyudatǝpǝ pǝ la lɔ̀ ŋwǝ pǝ lah wʊ. Kǝ́ ŋ́ no nuŋ ǝkǝnǝŋ Romatǝpiyǝ wǝ́ ŋ ri we, wǝ́ ŋlǝ mǝ mǝ otuusiitǝpǝ lo kolu la lɔ̀ ŋwǝ rǝ pǝ. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Wǝ́ ŋ́ fǝ̀ ŋwǝ ŋ́ kolu Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ lǝ kpǝŋ kǝ ŋ́ nya fɛɛ ŋ́ ci tuwǝ kǝto wǝ́ pǝ le yi pǝ la tɛɛ rǝ ŋwǝ wǝ. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Wǝ́ ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ pǝle esepǝ kǝto wǝ́ pǝ le yi pǝ la tɛɛ rǝ ŋwǝ. Paape ŋ́ naa nyɩŋ tǝrɛ rǝ etieyǝ sa lǝ mǝrǝ kǝ oturu wǝ lóo koru okuŋ kǝ pǝ wʊ nyiyǝ sa amaa kǝ pǝ lɔ ŋwǝ pǝ taŋ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Wǝ́ nyiyǝ rɛ ŋ ne pe tíi mǝ ǝkǝnǝŋ Oyudatǝpǝ pǝ ya pǝ lée ri nyuŋkpǝ pǝ ŋ tɛɛ rǝ ŋwǝ. Kǝto ŋ́ nǝ fǝ ŋwǝ ŋ́ na maŋ lǝ́. Wǝ́ ŋ́ na lɛ ŋ́ ne tíi epǝ we pǝ le yi pǝ la tɛɛ rǝ ŋwǝ, pǝ ŋ pǝ pǝ pa tɛŋ wǝkpaŋkpǝ mǝ ŋwǝ rǝ lǝ́ kpǝŋ.»<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Wǝ́ otuusiitǝpǝ we pǝ yeli pǝ sanǝ rǝ dierǝ sa pǝlo mumuŋyǝ we ŋ ne tíi pǝ wǝ. Wǝ́ pǝ kolu mǝ Pɔlʊ mǝŋ dumu mǝŋ dumu rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Aŋtipatǝ. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Gaalǝǝrǝkǝ we, wǝ́ otuusiitǝpǝ pǝ sìɛnɩ pǝ ko ŋ ko pǝlo gukpǝ we. Wǝ́ pǝ màa orootɛtǝpǝ we pǝ ko ŋ ko mǝ Pɔlʊ. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Kǝ́ pǝ le ke fii Sezare we, wǝ́ pǝ fǝ̀ kǝfwɛɛkǝ we pǝ kòonu kǝŋyɩrɩtǝyǝ we. Wǝ́ pǝ fǝ̀ Pɔlʊ pǝ kanǝ ŋwǝ. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Kǝ́ kǝŋyɩrɩtǝyǝ sa ŋ nǝ kǝ kǝfwɛɛkǝ we ŋ na lɛ we, wǝ́ ŋ pǝ̀ Pɔlʊ ǝkǝnǝŋ lo ru rǝ gǝŋrǝ rǝ fǝŋ. Kǝ́ ŋ no nuŋ ǝkǝnǝŋ Pɔlʊ lo ru rǝ Silisi lǝ gǝŋrǝ we, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ vǝ́ enyipǝ we pǝ le yi pǝ la tɛɛ rǝ ŋwǝ pǝ le pe fii we, kǝ ŋ pǝ pǝ́ ne etieyǝ. Wǝ́ ŋ tìi pǝ pǝ fǝ ŋwǝ pǝ kǝ tǝnǝ rǝ Erodɛsɩ la nyarǝmumuŋwǝ we.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Oyudatǝpǝ pǝ la tɛŋ wǝkpaŋkpǝ mǝ Pɔlʊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Wǝcukpǝ wǝtʊʊ la kǝmaakǝ wǝ́ toolutǝmumuŋyǝ Anania ŋ kolu Sezare. Ŋpǝ mǝ Oyudatǝpǝ lo omumuŋrɛɛpǝ mǝ nyiyǝ rɛ pǝ lóo pwo Tɛtulio. Lɔyayǝ wǝ́ ŋ ri. Pǝ pǝlǝ pǝ sàma Pɔlʊ rǝ kǝŋyɩrɩtǝyǝ Felisǝ lǝ kpǝŋ. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Wǝ́ pǝ pwò Pɔlʊ pǝ pǝlǝ. Wǝ́ Tɛtulio ŋ fǝ̀ pǝle etieyǝ pǝ lǝǝmǝ pǝ tɛɛ rǝ ŋwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Mumuŋyǝ, ŋlǝ́ kǝto wǝ́ yǝ la nya wǝtaarǝkpǝ rǝ gǝŋrǝ sa wǝ. O lo kuŋ pǝ lo toolu otuyǝ kǝkpǝŋkǝ. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />La ya yǝ láa lɔ lé ceeceeyeyǝ eni ri ŋ ni rǝ fɛɛ ri ŋ fɛɛ. Wǝ́ la ya yǝ lée ceeni lǝ́. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ŋ́ nǝǝ pǝ́ ŋ́ lǝǝrǝ lé eniyǝ. Kǝto ŋ́ na tɔɔ ŋ́ na kpɛɛ lǝ́, lɔ lɛtaarǝwǝ kǝ ǝ fǝ enipiyǝ rɛ kpekperee o co kǝtukoŋkǝ rǝ lǝ. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Yǝ la nyɩŋ wǝ yǝ le ci ǝkǝnǝŋ nyiyǝ sa ri nyirɔɔrɔɔyǝ rɛ ŋpa. Ya lóo co akpaŋyǝ rǝ Oyudatǝpǝ lǝ mǝrǝ rǝ ǝrǝkǝ sa kpǝlo. Ŋwǝ ŋ ri Anazarɛtǝtǝpǝ la wǝcakukpǝ we lo mumuŋyǝ. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Lo tu turuwǝ kʊraa ŋ ka cɩɩrɩ Worokoyǝ la nyarǝwǝ. Wǝ́ yǝ la lɔ ŋwǝ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Wǝ́ kǝ́ kɔŋtǝpiliyǝ Lisia ŋ no po ku mǝ dierǝ sa we, wǝ́ ŋ na lɔ ŋwǝ rǝ lah akaakǝ mǝ okopi mǝ okopi ŋ na pwɛyɩ. Wǝla kǝmaakǝ wǝ́ ŋwǝ Lisia ŋ tìi epǝ we pǝ lǝǝmǝ dierǝ mǝ Pɔlʊ we, pǝ ŋ pǝ lǝ́ kpǝŋ<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊrɛɛkpǝ lǝ mǝrǝ.</char></note>. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Ŋlǝ́ŋlǝ́ o lóo koru ǝpǝ́ ŋwǝ o nuŋ. A láa nyɩŋ wǝ e ci ǝkǝnǝŋ etieyǝ sa yǝ la tɛŋ yǝ la tɛɛ rǝ ŋwǝ we, yǝ lǝ ǝnǝ.» <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Wǝ́ Oyudatǝpǝ we pǝ lɔ̀ pǝ kʊ̀la mǝ ŋwǝ. Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Kǝ́ wǝ lǝ wǝǝ».<verse eid="ACT 24:9" /></para>
  <para style="s">Pɔlʊ la tɛŋ la kɔɔlʊ na wɛ rǝ Felisǝ la kǝnyɩŋkǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Wǝ́ kǝŋyɩrɩtǝyǝ we ŋ kàa akaakǝ ŋ kanǝ Pɔlʊ ŋ wɛɛlɩ. Wǝ́ Pɔlʊ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ cii wǝ ǝkǝnǝŋ e ri kpaŋtɛŋtǝyǝ rǝ lǝh gǝŋrǝ sa wǝ la lɔ acɛŋyǝ. Kǝto ŋ́ náa tɛŋ ŋ́ kɔɔlʊ mǝ wɛ mǝ kpɛɛtɛɛwǝ. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />O lóo koru ǝpǝ́ o nuŋ. Kǝ́ ŋ́ nǝ pǝ ŋ kpii rǝ Yerusalɛmǝ we, wǝ faa tɛlɩ juutǝ mǝ wǝyi. Ŋ́ nǝ pǝ ŋ́ pa sʊma Worokoyǝ. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Rɛ laa nyɩŋ mǝ ŋ́ tii mǝ ŋ tɛɛrɩ mǝ rɛ, amaa ŋ́ ya mǝ ŋ kpii enyipǝ rɛ la gasarǝ. Rǝ Worokoyǝ la nyarǝwǝ? Amaa rǝ Oyudatǝpǝ lo gumwɛŋnyuŋkpǝ? Amaa rǝ tǝŋtǝǝwǝ sa la fɛɛwǝ rɛ? Ow. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Enyipǝ sa pǝ lǝŋ koru anya tuwǝ pǝ lǝ́ǝ fǝ pǝ kaŋ lǝ́ etieyǝ sa pǝ la tɛŋ pǝ la tɛɛ rǝ mǝ rǝkǝsa wǝ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Paa ŋ́ náa pɔrʊ wǝ ŋ́ tíi lǝ́: Ŋ́ ya náa sʊma lǝh ǝtǝtǝpǝ lo Worokoyǝ mǝ ŋ saŋ rǝ caŋwɛŋwǝ rɛ. Ŋpǝ paa we, pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ carɔɔrɔɔwǝ wǝ lǝǝwe. Ŋ́ na lɔ tu ri ŋ tu pǝ la ŋʊrʊ pǝ le kpii rǝ Mose le seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ mǝrǝ ŋ́ no nuŋ. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Ŋ́ na tɛɛ kpɛɛwǝ, wǝ́ ŋpǝ ŋkpɛ pǝ lǝǝmǝ kpɛɛtɛɛwǝ sa ǝkǝnǝŋ Worokoyǝ lah pa saanǝ enyipǝ kpǝlo kɩɩkɩ, mǝŋ eceeceepǝ, mǝŋ arɔɔrɔɔpǝ ŋ ru rǝ gbɛŋrǝ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Wǝ kǝto ŋ́ ya ŋ́ náa nyɩɩ kǝ ŋ́ re mǝ wɛ sɩsiɛrɩ rǝ Worokoyǝ mǝ enyipǝ la kǝnyɩŋkǝ wǝǝ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />Ŋ́ na pwɛyɩ rǝ Yerusalɛmǝ wǝ la lɔ acɛŋyǝ. Wǝ́ ŋ́ na siɛnɩ ŋ́ nǝ pǝ ŋ́ pa cɛɛ mǝ ǝtǝŋtǝǝtǝpǝ lo otuyǝ, kǝ ŋ́ lɛ ŋ́ toolu ŋ kuŋ Worokoyǝ. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Tuwǝ ŋ́ yà ŋ́ ke ŋ yee wǝǝ. Wǝ́ pǝ pǝlǝ pǝ ka ŋ nyɩŋ mǝ rǝ Worokoyǝ la nyarǝwǝ, ŋ́ ne yee ewiikǝ lo kǝsuŋkǝ. Nyikpǝŋwǝ rɛ wǝ laa ka ya rǝ mǝ kpǝŋ. Wǝ́ enyipǝ rɛ pǝ laa ka ŋ lɔ gasarǝ rǝ fɛɛwǝ we. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Oyudatǝpǝ rɛ pǝ rù rǝ Azi ko pǝ ka yaa rǝ we. Ŋpǝ bomu pǝ kǝh pǝ pǝ po pwo mǝ rǝ lǝ́ kpǝŋ, mǝŋ pǝ lǝǝmǝ dierǝ rɛ mǝ mǝ wǝǝ. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Amaa ŋpǝ enyipǝ sa pǝ tɛŋ, kǝ́ ŋ́ no ko Oyudatǝkpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we la kǝnyɩŋkǝ wǝǝ, pǝ la nya tuwǝ pǝ lǝh fǝ pǝ tɔɔ mǝ bɔrǝ? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Mǝŋ ŋkǝ dierǝ sa jeŋceŋ ŋ́ yili ŋ́ yàa ŋ́ tɛnɩ mǝ kpɛɛlɛŋwǝ rǝ pǝla kǝnyɩŋkǝ ǝkǝnǝŋ: “Kǝ́ ŋ́ na tɛɛ kpɛɛwǝ ǝkǝnǝŋ enyiǝtǝpǝ pǝ lah pa saanǝ kǝto, wǝ́ ruŋruŋ le jirǝ pǝ lah tɛŋ mǝ wǝkpaŋkpǝ rǝ nǝ kǝnyɩŋkǝ wǝ?”»<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Kǝ́ Felisǝ ŋ cii tu ri ŋ tu ŋ ru rǝ Kulǝtǝyǝ la cawǝ sa kǝto, wǝ́ ŋ lɔ̀ etieyǝ sa ŋ tǝ̀nǝ enipʊŋpwayǝ rɛ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Jirǝ we Romatǝkɔŋtǝpiliyǝ Lisia ŋ nǝ́ǝ pǝ we, kǝ ŋ́ pa tɛŋ nǝ etieyǝ sa.» <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Wǝ́ ŋ tìi tuusiitǝmumuŋyǝ we ǝkǝnǝŋ: «Fǝ Pɔlʊ a ka taŋ. Paa kǝ o kuŋ na kʊŋwǝ mǝ ŋ yee tuwǝ we wǝ ponu mǝ ŋwǝ wǝ. Pǝǝ sǝ́ŋ o koonu ne enyipǝ pǝ yɩrɩ no yurǝ.»<verse eid="ACT 24:23" /></para>
  <para style="s">Pǝ lo ruu mǝ Pɔlʊ pǝ lǝ pǝ Felisǝ mǝ Derasilǝ le enimiyǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Ecipiyǝ rɛ la kǝmaakǝ wǝ́ Felisǝ ŋ pǝlǝ ŋpǝ mǝ ne tie Derasilǝ. Ne tie ri Oyudatǝpǝ. Wǝ́ Felisǝ ŋ kpìi pǝ kolu pǝ pwò Pɔlʊ pǝ kòonu ŋwǝ. Wǝ́ ŋ tini ŋ ko ŋ co kǝtukoŋkǝ kǝ́ Pɔlʊ ŋ ya ŋ náa wɛɛlɩ mǝ ŋ ru rǝ Yesu Kǝriso la alɔnuŋkǝ. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Kǝ́ Pɔlʊ ŋ ne yi ŋ na wɛɛlɩ ŋ no ru rǝ wǝkʊʊkpǝ, mǝ kǝ́ nyɩmaasɩyǝ ŋ née ri na wɛ lo yurǝ, mǝ soosowǝ sa wǝ lo furu la wǝkpaŋtɛŋkpǝ we, wǝ́ wǝ cò Felisǝ lo vurǝ. Wǝ́ ŋ tìi Pɔlʊ ǝkǝnǝŋ: «Ce o mǝ ko kpɛŋ. Vǝ́ mǝŋ doloŋrǝ rɛ la pa kpɛɛ mǝ we, ŋ́ nǝh pǝ tǝ ŋ́ pwo lǝ́.» <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Felisǝ ka ŋ tɛɛ kpɛɛwǝ ayɩrɛ Pɔlʊ loh po koonu ŋwǝ na sɩkayǝ. Wǝ kǝto ŋ ko ŋ pwo ŋwǝ mǝ ŋ pǝ, pǝ ŋ tɛɛrɩ mǝ enirɛɛyǝ wǝǝ. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Wǝ́ cɛŋwǝ yi wǝ lɛ̀. Wǝ́ Pɔrǝkio Fɛso ŋ pǝlǝ ŋ tini Felisǝ lo yuwǝ. Kǝ́ Felisǝ ŋ kǝ ŋ pǝ ŋ poŋ mǝ Oyudatǝpǝ kǝto wǝ́ ŋ màa Pɔlʊ ŋ kpìi rǝ gukpɛɛkpǝ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Pɔlʊ lǝ pǝ́ pǝ fǝ ne dierǝ pǝ ko Kayizaro lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Kǝ́ Fɛso ŋ ne pe fii gǝŋrǝ we ŋ nah yɩrɩ we, wǝ́ ŋ yeli wǝcukpǝ wǝta. Wǝ́ ŋ rù rǝ Sezare ŋ kolu Yerusalɛmǝ. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Wǝ́ otoolutǝmumuŋpǝ mǝ Oyudatǝpǝ lo omumuŋpǝ pǝ kolu pǝ nyɩnɩ ŋwǝ. Wǝ́ pǝ fǝ̀ etieyǝ we pǝ lǝ fǝ pǝ la tɛɛ rǝ Pɔlʊ pǝ tìi ŋwǝ. Wǝ́ pǝ kpìi na dɔɔkpɛɛrǝ <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />ŋ kpǝlǝŋ mǝ Pɔlʊ ŋ pǝ Yerusalɛmǝ. Rǝ anʊkɔrǝyǝ we, pǝ rili nyuŋkpǝ pǝ ke tíi ŋwǝ rǝ kʊŋwǝ kǝ pǝ pa wʊ ŋwǝ. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Wǝ́ Fɛso ŋ tìi pǝ ǝkǝnǝŋ pǝ la taŋ Pɔlʊ rǝ Sezare. Wǝ́ ŋwǝŋwǝ ŋ náa siɛnɩ ŋ ko wǝ lǝŋ panǝ. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Wǝ́ ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Vǝ́ ŋ́ noh ko we, kǝ nǝ omumuŋpǝ pǝ siimǝ mǝ pǝ ko Sezare. Mǝŋ nyiyǝ sa le yee turɔɔrɔɔwǝ rɛ we, kǝ pǝ ka tɛŋ wǝ.» <verse eid="ACT 25:5" /><verse number="6" style="v" sid="ACT 25:6" />Fɛso tini rǝ pǝlǝ kpǝŋ wǝ lǝh mǝ lǝ mǝŋ wǝcukpǝ wǝnɛŋ ko wǝcukpǝ wǝtǝ. Wǝ́ ŋ kpǝ̀lǝŋ ŋ ko ŋ ko Sezare. Gaalǝǝrǝkǝ we, wǝ́ ŋ kolu ŋ lɔ̀ kǝtiikǝ rǝ fɛɛtɛŋakpaŋyǝ. Wǝ́ ŋ kpìi pǝ kǝ fǝ Pɔlʊ pǝ pǝ. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Kǝ́ Pɔlʊ ŋ no po ru we, wǝ́ Oyudatǝpǝ we pǝ rù rǝ Yerusalɛmǝ pǝ pǝlǝ we, pǝ kolu pǝ cò pǝ sìri ŋwǝ. Wǝ́ pǝ tɛnɩ etierɔɔrɔɔyǝ rɛ kǝkpǝŋkǝ pǝ tɛ̀ɛ rǝ ŋwǝ. Paape pǝ laa nyà tuwǝ wǝ láa kaŋ pǝle etieyǝ sa pǝ tɛnɩ wǝ. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Wǝ́ Pɔlʊ ŋ tɛnɩ ne dierǝ ŋ kɔ̀ɔlʊ na wɛ ǝkǝnǝŋ: «Ŋ́ nee yee turɔɔrɔɔwǝ rɛ ŋ́ ko rǝ Oyudatǝpǝ le seyǝ lǝ kpǝŋ amaa Worokoyǝ la nyarǝwǝ lǝ kpǝŋ amaa Kayɩzaro lǝ kpǝŋ».<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Fɛso kǝ ŋ pǝ́ ŋ poŋ mǝ Oyudatǝpǝ. Wǝ́ ŋ pǝ̀ Pɔlʊ ǝkǝnǝŋ: «Ǝ lǝ́ǝ pǝ́ o ko Yerusalɛmǝ kǝ pǝ ka tɛŋ lé dierǝ sa rǝ mǝ enimiyǝ?» <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Wǝ́ Pɔlʊ ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ yaa rǝ pilimumuŋyǝ Kayizaro la fɛɛtɛŋakpaŋyǝ. Kǝto fɛɛwǝ pǝ láa tɛŋ mǝ wǝkpaŋkpǝ wǝǝ. Ŋ́ nee yee mǝ Oyudatǝpǝ lo turɔɔrɔɔwǝ rɛ. Mǝŋ kǝ́ ŋlǝ́ŋlǝ e cii wǝ sɩsiɛrɩ kǝtǝ.» <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Mǝŋ kǝceece ŋ́ na tɔɔ bɔrǝ we, mǝŋ ŋ́ ne yee turɔɔrɔɔwǝ rɛ wǝ kaamǝ kǝ ŋ kpǝ́ we, ŋ́ nǝŋ sǝ́ŋ gbɛŋrǝ. Wǝ́ paa mǝŋ etieyǝ sa enyipǝ sa pǝ la tɛŋ pǝ la tɛɛ rǝ mǝ yǝ lǝǝ lǝ ǝnǝ we, rɛ lǝǝ lǝmǝ okopiyǝ ŋ nǝ́ǝ fǝ mǝ ŋ kpii pǝ rǝ akaakǝ. Ŋ́ nǝ fǝ mǝ dierǝ ŋ́ no koonu Kayizaro ŋ tɛŋ. <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />Wǝ́ Fɛso mǝ na acaamɩpǝ pǝ tà dierǝ we pǝ yɩ̀rɩ. Wǝ́ ŋ kpǝ̀lǝŋ ŋ tìi Pɔlʊ ǝkǝnǝŋ: «Ǝ lǝ fǝ lé dierǝ e le kpii Kayizaro rǝ akaakǝ, we o lóo ko Kayizaro lǝ kpǝŋ».<verse eid="ACT 25:12" /></para>
  <para style="s">Pǝ lo ruu mǝ Pɔlʊ pǝ lǝ pǝ Agǝripa mǝ Bɛrǝnike la kǝnyɩŋkǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Ecipiyǝ rɛ la kǝmaakǝ we, wǝ́ piliyǝ Agǝripa mǝ Bɛrǝnike pǝ pǝlǝ Sezare. Wǝ́ pǝ kolu pǝ ke ceeni Fɛso. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Wǝ́ pǝ tini rǝ we pǝ lɔ̀ eciyǝ. Wǝ́ Fɛso ŋ fǝ̀ Pɔlʊ le dierǝ ŋ pɔ̀ piliyǝ la amayǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Felisǝ la taŋ nyiyǝ rɛ wǝ́ ŋ na maa ŋwǝ ŋ kpìi rǝ gukpɛɛkpǝ. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Kǝ́ ŋ́ no ko Yerusalɛmǝ we, wǝ́ otoolutǝmumuŋpǝ mǝ Oyudatǝpǝ lo omumuŋpǝ pǝ pǝlǝ pǝ wɛ̀ɛlɩ pǝ rù rǝ ŋwǝ pǝ tìi mǝ. Wǝ́ pǝ tìi mǝ ǝkǝnǝŋ ŋmǝ ŋ́ tɔɔ na bɔrǝ. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Wǝ́ ŋ́ tìi pǝ we, rǝ Oromatǝpǝ lǝ kpǝŋ we, mǝŋ rɛ lǝ fǝ dierǝ la tɛɛ rǝ na kɛrɩyǝ we, pǝ lǝŋ marǝ pǝ tɔɔ nyiyǝ we pǝ lǝ fǝ dierǝ pǝ la tɛɛ rǝ la bɔrǝ. We Pǝle eyi pǝ láa yaa pǝ tɛŋ mǝ awɛ, kǝ nyiyǝ sa ŋ tɛŋ ŋ kɔɔlʊ na wɛ kpɛŋ. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Kǝto kǝ́ ŋ́ nǝh pǝ we, wǝ́ pǝ sìimǝ mǝ pǝ pǝlǝ, ŋ́ nǝǝ rǝŋ. Gaalǝǝrǝkǝ ko wǝ́ ŋ́ kolu ŋ́ lɔ̀ kǝtiikǝ rǝ fɛɛtɛŋakpaŋyǝ. Wǝ́ ŋ́ kpìi pǝ kolu pǝ fǝ̀ ŋwǝ nyiyǝ sa pǝ pǝlǝ. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Wǝ́ epǝ we pǝ lǝǝmǝ dierǝ mǝ ŋwǝ pǝ pǝlǝ pǝ yàa. Paape pǝ laa tɛŋ oturɔɔrɔɔyǝ sa ŋ́ ya ŋ́ nóo pu la rɛ pǝ tɛɛ rǝ ŋwǝ. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Pǝ yeli etieyǝ mǝ ŋwǝ ru rǝ pǝla zʊmarǝ mǝ nyiyǝ rɛ pǝ lóo pwo Yesu wǝ. Nyiyǝ sa lǝ kpǝ́, paa Pɔlʊ ya láa tɛŋ ǝkǝnǝŋ kpii vɔrʊrǝ. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Ŋ́ nee ke ci kǝ́ ŋ́ neh yee ŋ́ fǝ. Fɛɛwǝ ŋ́ kǝ ŋ pǝ́ Pɔlʊ ŋ́ yɩrɩ mǝŋ láa tɛɛnɩ ŋ ko Yerusalɛmǝ kǝ pǝ ka tɛŋ etieyǝ sa rǝ we? <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Wǝ́ Pɔlʊ ŋ tɛnɩ ǝkǝnǝŋ Kayizaro ko ŋ nǝ́ǝ sǝ na wǝkpaŋkpǝ sa wǝ. Wǝ́ ŋ́ tìi pǝ fǝ̀ ŋwǝ pǝ kolu pǝ tanǝ ko ro eniyǝ we ŋ́ nǝ́ǝ fǝ ŋwǝ ŋ́ maŋ pilimumuŋyǝ wǝ.» <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />Wǝ́ Agǝripa ŋ tìi Fɛso ǝkǝnǝŋ: «Ŋ́ nǝ pǝ́ ŋmǝ ŋkpɛ ŋ́ nuŋ nyiyǝ sa ŋ wɛɛlɩ». Wǝ́ Fɛso ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «O lóo nuŋ kǝ́ ŋ nah wɛɛlɩ sooso».<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Gaalǝǝrǝkǝ wǝ́ Agǝripa mǝ Bɛrǝnike pǝ pǝlǝ pǝ ko ŋ ru kǝpilikǝpili. Wǝ́ pǝ ke ŋ fii wǝkpaŋtɛŋkukpǝ we. Ŋpǝ mǝ akɔŋtǝpilipǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ. Wǝ́ Fɛso ŋ kpìi pǝ kolu pǝ fǝ̀ Pɔlʊ pǝ pǝlǝ. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Wǝ́ Fɛso ŋ tɛnɩ ǝkǝnǝŋ: «Piliyǝ Agǝripa mǝ ŋnǝ ǝpǝ kpǝlo nǝ tini nǝ kʊ̀la mǝ lǝ wǝ, nǝ ya nǝ nyáa nyɩŋ nyiyǝ sa. No yurǝ kǝto wǝ́ Oyudatǝpǝ kpǝlo pǝ pǝlǝ pǝ nyɩnɩ mǝ rǝ Yerusalɛmǝ mǝŋ fɛɛwǝ sa. Wǝ́ pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ wǝ laa kaamǝ kǝ pǝ maa nyiyǝ sa ŋ tii vɔrʊrǝ. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ŋmǝ paa we, ŋ́ naa nyɩŋ tuwǝ ŋ ne yee wǝ kaamǝ kǝ ŋ kpǝ́ wǝ. Paa kǝ́ wǝ ri ŋwǝŋwǝ ŋ nǝ pǝ́ ǝkǝnǝŋ Kayizaro ŋ tɛŋ na wǝkpaŋkpǝ kǝto ŋ́ na tɛŋ ŋ́ nǝ́ǝ fǝ ŋwǝ ŋ́ maŋ ŋwǝ. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Paape ŋ́ nǝǝ lǝmǝ tuwǝ kororo ŋ́ nah ŋʊrʊ ŋ́ ru rǝ no oŋuŋkǝ ŋ́ maŋ pilimumuŋyǝ. Fɛɛwǝ kǝto ŋ́ no ruu mǝ ŋwǝ ŋ́ nǝ pǝ nǝ kǝnyɩŋkǝ wǝǝ. Otukpǝlo, ŋlǝ́ piliyǝ Agǝripa, vǝ́ ǝ lǝ pǝ́ ne etieyǝ a la lɛ we, kǝ ŋ́ nya tuwǝ rɛ ŋ́ ŋʊrʊ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Rǝ mǝ anyɩŋkǝ we, wǝ lǝǝ lǝmǝ dutu kǝ pǝ fǝ kukpɛɛtǝyǝ pǝ maŋ, kǝ oturu pǝ laa ŋʊrʊ tuwǝ ŋ ne yee pǝ kʊla.»<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Pɔlʊ ya láa tɛŋ mǝŋ pɛɛnɩ na wɛ rǝ Agǝripa lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Wǝ́ Agǝripa ŋ tìi Pɔlʊ ǝkǝnǝŋ: «Pǝ la pɔrʊ gɔŋrǝ pǝ lo koonu lǝ́ kǝ a tɛŋ a pɛɛnɩ lá wɛ.» Wǝ́ Pɔlʊ ŋ yìili akaakǝ wǝ́ ŋ tɛnɩ ŋ pɛ̀ɛnɩ na wɛ ǝkǝnǝŋ: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«Piliyǝ Agǝripa, ŋ́ ya ŋ́ náa nya faawǝ mǝ kǝ́ pǝ lo koonu mǝ gʊŋrǝ ruŋruŋ kǝ ŋ́ tɛŋ ŋ́ pɛɛnɩ mǝ wɛ rǝ lá kǝnyɩŋkǝ, rǝ etieyǝ sa kpǝlo Oyudatǝpǝ pǝ ya pǝ láa tɛŋ pǝ ŋ tɛɛ rǝ mǝ wǝ. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Duturǝ ɖi e cii Oyudatǝpǝ lo kǝsuŋkǝ kpǝlo mǝ pǝla atɛɛrɩkǝ. Kǝto ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ lǝ́, kǝ ǝ fǝ lɛtaarǝwǝ o nuŋ mǝ dierǝ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />Oyudatǝpǝ kpǝlo pǝ cii mǝ vɔrʊrǝ we ŋ́ ne tii wǝ, fǝ ǝrǝ mǝ kǝkosopikǝ. Pǝ cii mǝ ǝrǝ kǝsǝŋkǝ, kǝ́ ŋ́ ke kpii rǝ mǝ kǝkpǝŋkǝ mǝ Yerusalɛmǝ mǝrǝ wǝ. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Pǝ cii mǝ wǝ la panǝ. Mǝŋ wǝ ponu mǝ pǝ we, pǝ lóo koru atɛŋ wǝ ǝkǝnǝŋ ŋmǝ ŋ́ ka kʊla mǝ Afarisitǝpǝ la wǝcakukpǝ. Wǝcakukpǝ sa wǝ loo ko ŋ kuŋ tuwǝ lo oru rǝ lah zʊmarǝ mǝrǝ wǝ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Wǝ́ rǝkǝsa pǝ ya pǝ láa tɛŋ wǝkpaŋkpǝ mǝ mǝ, duturǝ ɖi ŋ́ na lɔ tuwǝ we Worokoyǝ ŋ no co lǝh ǝtǝtǝpǝ la garǝ ŋ́ no nuŋ. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ŋrǝ garǝ sa Worokoyǝ ŋ no co wǝ́ lǝh wǝkpǝŋtǝmǝyikpǝ sa wǝ ya wǝ lǝ́ǝ rǝŋ wǝ pa nyɩŋ wǝ. Tuwǝ sa kǝto wǝ́ pǝ ya pǝ láa sʊma Worokoyǝ mǝŋ dumu mǝŋ jɔkɔŋ wǝ. Piliyǝ, tuwǝ sa kǝto wǝ́ Oyudatǝpǝ pǝ le yi pǝ la tɛɛ rǝ mǝ. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Kǝ́ kǝto wǝ́ ŋnǝ Oyudatǝpǝ nǝ nyǝ sǝ́ŋ nǝ nyǝŋ lɔ nǝ nuŋ ǝkǝnǝŋ Worokoyǝ láa saanǝ enyiǝtǝpǝ wǝ? <verse eid="ACT 26:8" /><verse number="9" style="v" sid="ACT 26:9" />Ŋmǝŋmǝ ŋ́ pù wǝ ǝkǝnǝŋ ŋ́ náa saŋ rǝ gʊŋ ri ŋ gʊŋ kǝ ŋ́ yi ŋ́ tɛɛ rǝ Nazarɛtǝtǝ Yesu la nyɩŋ rǝ. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Wǝ́ ŋ́ yeli wǝ rǝ Yerusalɛmǝ. Otoolutǝmumuŋpǝ pǝ kòonu mǝ okopiyǝ, wǝ́ ŋ́ lɔ̀ enyikʊʊpǝ ŋ́ tanǝ. Wǝ́ mǝŋ pǝ la tɛŋ ǝkǝnǝŋ pǝ láa wʊ ŋpǝ enyikʊʊpǝ sa we, oturu ŋmǝ ŋkpɛ ŋ́ na tɛɛnɩ. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Wǝ́ Oyudatǝpǝ lo gumwɛŋnyuŋ ri ŋ gumwɛŋnyuŋ ŋ́ nóo ko we, ŋ́ ko ŋ kuŋ pǝ ŋ kpii enyipǝ la acʊcʊʊrʊpiyǝ, kǝ pǝ nya fɛɛ pǝ nyarǝ pǝla lɔnuŋrǝ pǝ co. Ŋ́ fǝ̀ kpɛɛmʊrʊwǝ ŋ́ tɛ̀ɛ rǝ pǝ ŋpa kǝto ŋ́ ke ŋ yi mǝ ŋ tɛɛ rǝ pǝ ko ru ǝrǝ ǝsǝǝtǝŋtǝǝyǝ.»<verse eid="ACT 26:11" /></para>
  <para style="s">Pɔlʊ la tɛŋ na wɛɛsiɛrɩwǝ le dierǝ le tíi Agǝripa</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />«Kaa wǝǝ jirɛɛrǝ ŋ́ kpìi ŋ́ ko ŋ ko rǝ Damasǝko la gʊŋrǝ. Anyɩŋ otoolutǝmumuŋpǝ pǝ la pɔrʊ gʊŋrǝ pǝ lo koonu mǝ wǝ́ pǝ lɛ pǝ kòonu mǝ okopiyǝ. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Kǝ́ wǝ lah ca mǝŋ cɔkɔŋtiizaarǝ we, piliyǝ, wǝ́ ŋ́ nyɩnɩ kǝ́ wǝnyɩɩnɩkpǝ rɛ wǝ lo ru rǝ yulaarǝ wǝ lo po co wǝ le siri ŋlǝ mǝ mǝ ǝtǝŋpǝ. Wǝnyɩɩnɩkpǝ sa wǝ láa nyɩnɩ wǝ ŋ teeri cɔkɔŋyǝ la wǝnyɩɩnɩkpǝ. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Wǝ́ lo rù la tɔ̀ɔlʊ. Wǝ́ ŋ́ nunu kǝ́ kpɛɛwǝ rɛ wǝ ya wǝ lée tíi mǝ mǝ Kǝhebǝritǝkǝ ǝkǝnǝŋ: “Sɔlʊ, Sɔlʊ, kǝ́ kǝto wǝ́ e le yi a la tɛɛ rǝ mǝ wǝ? Pǝ lǝŋ rɛ pǝ tɛɛ rǝ vaŋrǝ mǝ akparǝkpaakpaayǝ.” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Wǝ́ ŋ́ pǝ̀ kpɛɛwǝ we ǝkǝnǝŋ: “Ŋlǝ́ ǝlǝ ǝ lǝǝwe, Kulǝtǝyǝ?” Wǝ́ Kulǝtǝyǝ ŋ tɛnɩ ǝkǝnǝŋ: “Ŋmǝ Yesu ŋ́ lǝǝwe. Yǝ we e le yi a la tɛɛ rǝ wǝ. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Rǝkǝsa we, yi a yaa. Ŋ́ na pɔrʊ mǝ wɛ ŋ́ na kaŋ lǝ́ kǝ ŋ́ nya fɛɛ ŋ́ fǝ lǝ́ ŋ́ yee mǝ sʊmatǝyǝ. E leh ri mǝ ɖaŋsielǝtǝyǝ, kǝ a tɛŋ kǝ́ a la nyɩŋ mǝ ruŋruŋ e tíi enyipǝ, kǝ a lɛ a tɛŋ otuyǝ we ŋ́ nǝh pǝ tǝ ŋ́ pɔrʊ ŋ́ kaŋ lǝ́ e tíi enyipǝ. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Ŋ́ náa pɔrʊ lǝ́ rǝ Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ la akaakǝ. Pǝlǝ kpǝŋ wǝ́ ŋ́ neh kpii lǝ́ o ko, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />kǝ o ko wuru pǝle enimiyǝ, kǝ pǝ nya fɛɛ pǝ ru rǝ nuŋtumuwǝ lǝ mǝrǝ pǝ pǝ wǝnyɩɩnɩkpǝ lǝ kpǝŋ, kǝ pǝ pwɛyɩ rǝ Satana lo okopiyǝ lǝ kpǝŋ pǝ pǝ Worokoyǝ lǝ kpǝŋ. Mǝŋ pǝ la lɔ mǝ pǝ lo nuŋ we, Worokoyǝ lǝ́ǝ fǝ pǝlo oturɔɔrɔɔyǝ ŋ cɛɛ pǝ, kǝ ŋ toolu fɛɛtiiwǝ ŋ tǝnǝ pǝ rǝ enyipǝ we pǝ ri Worokoyǝ la anɛŋpǝ lǝ mǝrǝ.”»<verse eid="ACT 26:18" /></para>
  <para style="s">Pɔlʊ la wɛɛlɩ lo ru rǝ na kǝnǝnɛkǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />«Fǝ rǝ eniyǝ we mǝ pǝ we, piliyǝ, ŋ́ nǝǝ sǝ́ŋ tuwǝ we Worokoyǝ ŋ na pɔrʊ ŋ na kaŋ mǝ wǝ lo ru rǝ yulaarǝ wǝ. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Wǝ́ ŋ́ tìe worokoŋtietɛŋrǝ rǝ Damasǝko kpɛŋ, wǝ́ ŋ́ fìi Yerusalɛmǝ mǝ Yudeya kpǝlo kɩɩkɩ, wǝ́ ŋ́ kolu epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ. Wǝ́ ŋ́ tìi pǝ ǝkǝnǝŋ pǝ siɛrɩ pǝla wɛ pǝ pǝ Worokoyǝ lǝ kpǝŋ, kǝ pǝ pɔrʊ pǝ kaŋ saŋ rǝ pǝla akparǝtǝnǝyǝ ǝkǝnǝŋ pǝ la siɛrɩ kǝceece.» <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Tuwǝ sa kǝto wǝ́ Oyudatǝpǝ pǝ pǝlǝ pǝ lɔ̀ mǝ rǝ Worokoyǝ la nyarǝwǝ, wǝ́ pǝ pǝ́ pǝ ka wʊ mǝ wǝ. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Paape Worokoyǝ lo otoŋkǝ kǝto, ŋ́ kpii vɔrʊrǝ po ro ruŋruŋ. Wǝ́ ŋ́ ya ŋ́ née ri ɖaŋsieyǝ sa mǝ ŋ tíi mǝŋ alaatie mǝŋ omumuŋ. Wǝ́ ŋ́ naa tɛŋ diepʊŋpwarǝ rɛ ŋ́ kʊla mǝ eyǝ we oworokokpɛɛnuŋtɛŋtǝpǝ mǝ Mose pǝ la tɛŋ pǝ lǝ tǝnǝ ǝkǝnǝŋ yǝ lǝh pǝ pǝ wǝ. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Pǝ la tɛŋ ǝkǝnǝŋ Kǝriso lah pa nyɩŋ ariaayǝ. Wǝ́ ŋ neh pe ri nyisǝsǝŋyǝ Worokoyǝ ŋ nah pa saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ, kǝ ŋ pa tɛŋ wǝnyɩɩnɩkpǝ le dierǝ ŋ tíi lǝh kǝkpǝŋkǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ wǝ.<verse eid="ACT 26:23" /></para>
  <para style="s">Pɔlʊ la awɛɛlɩkǝ kǝ lǝ pǝ kǝ ko koonu Agǝripa ŋ siɛrɩ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Kǝ́ Pɔlʊ ŋ ya ŋ náa wɛɛlɩ mǝ ŋ pɛɛnɩ na wɛ we, wǝ́ kǝŋyɩrɩtǝyǝ we pǝ lóo pwo Fɛso ŋ kǝ ŋ pǝ́ Pɔlʊ kelele ǝkǝnǝŋ: «Pɔlʊ, a ya lée fii yurǝ rǝ? Ló sukumumuŋwǝ sa o lo ko wǝ ya wǝ lée kpii lǝ́ yufiirǝ!» <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />Wǝ́ Pɔlʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝŋyɩrɩtǝyǝ, ŋ́ naa ya ŋ́ née fii yurǝ. Etieyǝ sa ŋ́ ya ŋ́ náa tɛŋ we, yǝ kpii wǝ́ yǝ lǝǝmǝ duturǝ. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Piliyǝ ŋwǝ ŋkpɛ cii ŋyǝ otuyǝ sa kpǝlo. Kǝto ŋ́ nóo koru atɛŋ yǝ rǝ na kǝnyɩŋkǝ vurǝ lǝŋ yee mǝ. Ŋ́ cii wǝ ǝkǝnǝŋ cii otuyǝ sa. Duturǝ ɖi pǝ laa ŋwaa pǝ yee otuyǝ sa rǝ fɛɛwǝ rɛ rǝ. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Piliyǝ Agǝripa, a la lɔ oworokokpɛɛnuŋtɛŋtǝpǝ le etieyǝ o lo nuŋ? Ŋ́ cii wǝ ǝkǝnǝŋ a la lɔ yǝ o lo nuŋ.» <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />Wǝ́ Agǝripa ŋ tìi Pɔlʊ ǝkǝnǝŋ: «Wǝ lo tuuru tɩpɩrɩ, a ka asiɛrɩ mǝ e yee kǝrisotǝnyiyǝ!» <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Wǝ́ Pɔlʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ ke ce wǝ ri tɩpɩrɩ amaa ŋpa we, ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ, kǝ Worokoyǝ ŋ yee kǝ wǝ pee ri ŋlǝ́ ceŋceŋ ko a la siɛrɩ e le yee kǝrisotǝnyiyǝ. Paa ŋ́ ya ŋ́ nǝ́ǝ pǝ́ kǝ nǝ kpǝlowǝ sa nǝ ya nǝ nyo nuŋ mǝ etieyǝ ruŋruŋ we, nǝ siɛrɩ mǝŋ ŋmǝ kǝtǝ. Paape kǝ ŋnǝ paa we, pǝ pee kpii nǝ akpɛtɛɛyǝ sa.»<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Wǝ Piliyǝ we mǝ kǝŋyɩrɩtǝyǝ we mǝ Bɛrǝnike mǝ enyipǝ we kpǝlo pǝ ke tini pǝ kʊ̀la mǝ pǝ pǝ yili. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Kǝ́ pǝ le yi pǝ loh ru we, wǝ́ pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Nyiyǝ sa lee yee tǝrɛ wǝ kaamǝ kǝ ŋ kpǝ́ amaa kǝ pǝ taŋ ŋwǝ». <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Wǝ́ Agǝripa ŋ ke ŋ tíi Fɛso ǝkǝnǝŋ: «Mǝŋ ŋkǝ kǝ́ ŋ no pwo Kayɩzaro we, lo koh koru anyarǝ nyiyǝ sa lo co.»<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Pǝ le fǝ Pɔlʊ pǝ la maŋ rǝ Roma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Kǝ́ pǝ la tɛŋ wǝ pǝ lǝ sǝ ǝkǝnǝŋ pǝ lée kpii lǝ rǝ gbanǝŋwaarǝ lo ko Itali we, wǝ́ pǝ fǝ̀ Pɔlʊ mǝ okukpɛɛtǝrɛɛpǝ pǝ kpìi tuusiitǝmumuŋyǝ rɛ pǝ lóo pwo Yulio rǝ akaakǝ. Pilimumuŋyǝ Ogusio lo otuusiitǝpǝ le ceŋceŋ ŋ lǝǝwe. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Wǝ́ le fìi gbanǝŋwaarǝ rɛ ɖù rǝ Adamito. Go ŋ ko Azi la akpanǝŋwaayǝ la fɛɛyaawǝ. Wǝ́ lo ko ŋ ko. Aritako ka kʊ̀la mǝ lǝ, rù rǝ Makedonia rǝ Tesalonika lǝ gǝŋrǝ. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Gaalǝǝrǝkǝ we, wǝ́ lo kolu la sʊ̀ʊ rǝ Zidɔŋ. Yulio ke re Pɔlʊ sɩsiɛrɩ. Wǝ́ ŋ kòonu na kʊŋwǝ ŋ ko nǝ ǝtǝŋpǝ lǝ kpǝŋ kǝ pǝ ko toŋ ŋwǝ. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Kǝ́ yǝ le yi rǝ we we, wǝ́ la màarǝ mǝ Kipǝro la gbanǝcakporǝ we lo ko ŋ ko. Kpiikǝ ǝrǝkǝ kǝ ko ŋ fuŋ kǝ ŋ tie lǝ rǝ anyɩŋkǝ kǝto. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Kǝ́ yǝ la ta Silisi mǝ Paŋfili la apʊyǝ yǝ lo ko ru we, wǝ́ lo kolu le fìi Mira rǝ Liki lǝ gǝŋrǝ. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Rǝ we wǝ́ tuusiitǝmumuŋyǝ we ŋ nyà gbanǝŋwaarǝ rɛ ɖù rǝ Alɛsaŋdǝri go ŋ ko Itali. Wǝ́ ŋ fǝ̀ lǝ ŋ kpìi rǝ rǝ. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Wǝ́ gbanǝŋwaarǝ sa gbìi mǝ lǝ go ŋ ko rɛyɩɩ, wǝcukpǝ wǝpakawǝpaka. Anyɩɩkǝ rǝ wǝ́ lo kolu lo ko ŋ ru rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Kǝnidǝ la kǝlɛɛrɩkǝ. Ǝrǝfuŋkǝ we kǝ loo koonu lǝ kʊŋwǝ lo mǝ ko mǝ lah kǝnyɩŋkǝ. Wǝ́ la màarǝ mǝ Samone lo kolu lo rù Kǝrɛtǝ la gbanǝcakporǝ. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Afia mǝ akɔŋ wǝ́ la màarǝ lo kolu lo rù fɛɛwǝ rɛ pǝ lóo pwo ǝkǝnǝŋ Akpanǝŋwaayǝ la afɛɛyaaceeceeyǝ. Wǝ maarǝ mǝ tǝŋtǝǝwǝ we pǝ lóo pwo Lase.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Lǝ lǝ̀ǝrǝ eniyǝ ŋpa. Wǝ́ gʊŋsaŋrǝ mǝ gbanǝŋwaarǝ ga ŋ lɛ lǝ ŋ co vurǝ. Otukpǝlo, nyuŋparǝkpǝ le eciyǝ yǝ la marǝ yǝ la tɛlɩ kaka. Wǝ kǝto Pɔlʊ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«Lǝh ǝtǝŋ, ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ lah gʊŋsaŋrǝ sa lɛnyɩ. Gbanǝŋwaarǝ sa mǝŋ eleeyǝ sa yǝ lǝ́ǝ pǝlǝ ŋpa. Wǝ́ ŋkǝ ŋyǝ sɔŋ! Mǝŋ ŋlǝŋlǝ yǝ lee ci we, yǝ lǝ́ǝ kpǝ́.» <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Paape Romatǝtuusiitǝmumuŋyǝ sa loo co oku rǝ Pɔlʊ le dierǝ sa. Ka ŋ tɛɛ kpɛɛwǝ rǝ kpanǝŋwaacaatǝyǝ we mǝ rǝlǝ tǝyǝ lo tutɛŋwǝ. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Tǝ fǝ kʊla we, akpanǝŋwaayǝ la fɛɛyaawǝ sa wǝ lǝŋ poŋ etii mǝ asiɛniyǝ. Fɛɛwǝ enyipǝ kǝtamumuŋkǝ rǝ gbanǝŋwaarǝ sa pǝ tɛnɩ kǝ pǝ pwɛyɩ rǝ we wǝǝ. Pǝ ka ŋ tɛŋ ayɩrɛ ŋpǝ pǝ lée fii akpanǝŋwaayǝ la fɛɛyaawǝ we pǝ lóo pwo Fenisi. Wǝ kpii rǝ Kǝrɛtǝ lǝ gǝŋrǝ. Wǝ láa yɩrɩ rǝ kǝcɔkɔŋtɔɔkǝ la kǝpɔɔlʊsiɛɛkǝ mǝ kǝcɔkɔŋtɔɔkǝ lo kǝŋuŋsiɛɛkǝ. Pǝ kǝ ŋ pǝ́ pǝ ke tii rǝ we mǝ asiɛniyǝ.<verse eid="ACT 27:12" /></para>
  <para style="s">Kǝkpǝkǝ kǝ lǝ pǝ kǝ kǝ nǝǝnǝ gbanǝŋwaarǝ we Pɔlʊ ŋ ke kpii wǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Ǝrǝkǝ kǝ ko ŋ fuŋ rɛyɩɩ kǝ ŋ ru rǝ kǝpɔɔlʊsiɛɛkǝ. Wǝ́ pǝ ka ŋ nyɩŋ rǝ ǝkǝnǝŋ ŋpǝ pǝ lóo koru eyee tuwǝ we pǝ lǝ pǝ́ wǝ. Wǝ́ gbanǝŋwaarǝ we yili mǝ pǝ. Wǝ́ pǝ màarǝ mǝ Kǝrɛtǝ la gbanǝcakporǝ we pǝ ko ŋ ko mǝ apʊyǝ. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Paa wǝ laa panǝ wǝ́ ǝrǝfuŋmumuŋkǝ rɛ kǝ funu kǝ rù rǝ Kǝrɛtǝ lo otutupiyǝ kǝ pǝlǝ kǝ sʊ̀ʊ. Pǝ lóo pwo ǝrǝfuŋkǝ sa ǝkǝnǝŋ Erakilɔŋ<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">Erakilɔŋ lo duturǝ gaamǝ ǝrǝfuŋkǝ we kǝ lo ru rǝ kǝcɔkɔŋpoŋkǝ lo kǝŋuŋsiɛɛkǝ.</char></note>. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Wǝ́ ǝrǝfuŋkǝ we kǝ pǝlǝ kǝ kù mǝ gbanǝŋwaarǝ sa. Lǝǝ tǝ goru asaŋ go mǝ kǝyɩŋkǝ. Wǝ́ la màa ǝrǝfuŋkǝ sa kǝ rè gbanǝŋwaarǝ sa kǝ ko ŋ ko mǝ kǝla cawǝ. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Wǝ́ gbanǝŋwaarǝ sa zùu mǝ lǝ golu ɖù ǝrǝ gbanǝcakpopirǝ rɛ pǝ lóo pwo Koda la kǝpɔɔlʊsiɛɛkǝ. Afia mǝ akɔŋ wǝ́ le ci ata gʊrɔpirǝ<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Pǝ lée kpii gʊrɔpirǝ rɛ rǝ gbanǝŋwaarǝ lǝ mǝrǝ. Mǝŋ gbanǝŋwaarǝ lǝh nǝŋ we, gʊrɔpirǝ sa wǝ́ pǝ lǝ́ǝ fǝ pǝ ŋ pɔrʊ enyipǝ.</char></note> we lǝ tǝnǝ. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Wǝ́ akpanǝŋwaacaatǝpǝ we pǝ yìili rǝ pǝ rɛ̀ɛrɩ rǝ gbanǝŋwaarǝ we lo oŋuŋkǝ. Wǝ́ pǝ kpìi okoluyǝ pǝ pàrǝ gbanǝŋwaarǝ sa pǝ pǝlǝ pǝ kù. Pǝ ko ŋ suu vurǝ ayɩrɛ ŋpǝ pǝ lée ke fii rǝ kpanǝnaŋkuwǝ rɛ rǝ Libi la apʊlɛɛrɩyǝ. Wǝ kǝto pǝ fǝ̀ tʊkʊtuwǝ we wǝ lǝǝmǝ nuruwǝ ŋpa wǝ láa ta gbanǝŋwaarǝ wǝ ŋ re rǝ apʊyǝ lǝ mǝrǝ pǝ kpìi rǝ apʊyǝ wǝǝ. Wǝ́ pǝ màa ǝrǝfuŋkǝ we kǝ rè pǝ kǝ ko ŋ ko. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Gaalǝǝrǝkǝ we, anyɩŋ ǝrǝfuŋkǝ we kǝ tǝ kǝ re kǝ ya kǝ lée tikili lǝ ŋpaŋpa. Wǝ́ akpanǝŋwaacaatǝpǝ sa pǝ pɔ̀rʊ eleerɛɛyǝ pǝ tìe pǝ kpìi rǝ apʊyǝ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Juutatǝrǝ wǝ́ ŋpǝŋpǝ pǝ wʊ̀ʊ gbanǝŋwaarǝ we la anǝnɛtuyǝ pǝ cò rǝ apʊyǝ. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Wǝ́ le yeli wǝcukpǝ wǝpakawǝpaka cɔkɔŋyǝ mǝ wǝŋɔŋkpǝ wǝ laa nyɩnɩ. Wǝ́ ǝrǝfuŋkǝ sa kǝ rè kǝ yà kǝ ko ŋ fuŋ mǝ okopiyǝ. Yǝ lǝǝ tǝ la tɛɛ kpɛɛwǝ mǝŋ tɩ ǝkǝnǝŋ ŋlǝ yǝ lóo ru rǝ wǝ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Wǝcukpǝ wǝpakawǝpaka yǝ lee ri tu ri ŋ tu. Wǝ́ Pɔlʊ ŋ pǝlǝ ŋ yili ŋ yàa rǝ pǝla kǝnyɩŋkǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, ke ci nǝ ko nuŋ mǝ tutɛŋwǝ, kǝ nǝ paa ka pwɛyɩ rǝ Kǝrɛtǝ. Nǝ kah cɛ vaŋrǝ sa mǝ otupǝlǝyǝ sa. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Paa rǝkǝsa we, ŋ́ ya ŋ́ née tíi nǝ nǝ ta nǝ wɛ lo turuwǝ. Kpiikǝ rɛ ri ŋ rɛ lǝŋ kpǝ́ rǝ nǝ mǝrǝ. Gbanǝŋwaarǝ sa ko lǝ́ǝ pǝlǝ jo wǝ. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Kǝceece, dumurǝ sa we, Worokoyǝ we ŋ́ kpii ŋ́ koonu wǝ́ ŋ́ náa sʊma we, le picoŋpiyǝ la pa yaa rǝ mǝ kpǝŋ. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />Wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ: “Pɔlʊ, poo suu vurǝ! O lóo ko kǝ Kayizaro ŋ tɛŋ lá wǝkpaŋkpǝ taa. Ŋlǝ́ kǝto wǝ́ Worokoyǝ ŋ na pɔrʊ enyipǝ sa kpǝlo pǝ kpii rǝ gbanǝŋwaarǝ sa pǝ kʊla mǝ lǝ́ wǝ.” <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Kǝto lǝh ǝtǝŋ, nǝ ta nǝ wɛ. Ŋ́ na tɛɛ kpɛɛwǝ rǝ Worokoyǝ. Tuwǝ we ŋ na tɛŋ ŋ ne tíi mǝ we, kǝ́ wǝ lǝ́ǝ lǝ wǝǝ. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Paa we, yǝ lah ka tɔɔ rǝ gbanǝcakporǝ rɛ lǝ kǝpǝŋpǝŋkǝ.»<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Dumutǝmǝniǝtǝrǝ wǝ́ ǝrǝfuŋkǝ we kǝ rè lǝ kǝ kolu kǝ rù apʊyǝ we pǝ lóo pwo ǝkǝnǝŋ Mediterane la apʊyǝ. Kǝ́ ǝrǝkǝ kǝ la cɩɩ kǝ lǝ sǝpǝ we, wǝ́ wǝ ke ŋ yee akpanǝŋwaacaatǝpǝ sa rǝ mǝŋ ŋlǝ yǝ lǝh kǝlǝ mǝ kǝtǝǝwǝ rɛ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Wǝ́ pǝ kpìi ɖurǝ la ŋwɛɛwǝ pǝ cò pǝ yɩ̀rɩ mɛŋwǝ we lo osuunukǝ. Wǝ́ pǝ nyɩnɩ wǝ lǝ mɛtayǝ tǝta mǝ pǝrɩmata. Kǝ́ pǝ lo ruu pǝ lo ko wǝ́ pǝ tǝ pǝ cò pǝ yɩrɩ. Wǝ́ pǝ nyà mɛtayǝ tiyi mǝ nɛŋ. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Wǝ́ pǝ ko ŋ suu vurǝ ǝkǝnǝŋ gbanǝŋwaarǝ sa leh ke fii rǝ orutɛɛyǝ rɛ. Wǝ kǝto pǝ kpìi tʊkʊtuwǝ we wǝ lǝǝmǝ nuruwǝ ŋpa, wǝ́ wǝ láa ta gbanǝŋwaarǝ wǝ ŋ re we, niǝ rǝ rǝla kǝmaakǝ. Wǝ́ pǝ yà pǝ kǝ ŋ rǝŋ ǝrǝkǝ kǝ kaalǝ ca. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Paa wǝ́ akpanǝŋwaacaatǝpǝ sa pǝ kǝ ŋ pǝ́ pǝ ru pǝ suu. Wǝ́ pǝ fàarǝ gʊrɔpirǝ we. Wǝ́ pǝ ka ŋ cɛ pǝ ŋ tɛɛ ǝkǝnǝŋ ŋpǝ pǝ loh ko pǝ ke kpii tʊkʊtuwǝ we rǝ gbanǝŋwaarǝ sa la kǝnyɩŋkǝ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Wǝ́ Pɔlʊ ŋ tìi otuusiitǝpǝ lo mumuŋyǝ we mǝ otuusiitǝpǝ we ǝkǝnǝŋ: «Mǝŋ enyipǝ sa pǝ lee tii rǝ gbanǝŋwaarǝ sa lǝ mǝrǝ we, nǝ nyǝŋ ru rǝ wǝ.» <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Wǝ́ otuusiitǝpǝ sa pǝ sǝ̀ǝrǝ okoluyǝ we yǝ tà gʊrɔpirǝ sa yǝ re wǝ. Wǝ́ pǝ màa rǝ wʊ̀ʊ go ŋ ko.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Kǝ́ ǝrǝkǝ kǝ lah ta kǝ kaalǝ we, wǝ́ Pɔlʊ ŋ ka ŋ tà pǝlo turuwǝ pǝ ri. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ruŋruŋ wǝ ri juutǝmǝniǝtǝrǝ wǝ́ nǝ ya nǝ nyǝ́ǝ rǝŋ. Nǝ nyee ri tu ri ŋ tu. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Kǝto nǝ ri. Duturǝ ɖi wǝ lóo toŋ nǝ kǝ nǝ ru rǝ wǝ. Rɛ lo kǝyurookǝ mǝŋ kǝceŋceŋ ǝkǝŋtǝ kǝ lǝŋ lǝǝ.» <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Kǝ́ Pɔlʊ ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ ŋ fǝ̀ kpɔnɔyǝ. Wǝ́ ŋ cèeni Worokoyǝ rǝ pǝlo kpǝlo le enimiyǝ. Wǝ́ ŋ pò ŋwǝ. Wǝ́ ŋ yà ŋ ko ŋ wo ŋwǝ. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Wǝ́ pǝlo kpǝlo pǝ tà pǝla wɛ. Wǝ́ pǝ ke ŋ ri. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Loh kpǝlo rǝ gbanǝŋwaarǝ we lǝ kǝ lǝ enyipǝ tuuruyi mǝ tǝpǝrɩmata mǝ akʊraŋ. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Kǝ́ pǝ le ri pǝ lo wu pǝ la lɛ we, wǝ́ pǝ fǝ̀ ekeeriyǝ we pǝ tìe pǝ kpìi rǝ apʊyǝ, kǝ gbanǝŋwaarǝ we nya fɛɛ yi nuruwǝ.<verse eid="ACT 27:38" /></para>
  <para style="s">Gbanǝŋwaarǝ we la wɔ, paape enyipǝ we pǝ lo ru cʊrʊcʊrʊ</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Kǝ́ ǝrǝkǝ kǝ la kaalǝ we, akpanǝŋwaacaatǝpǝ sa pǝ lee ci kǝtǝǝwǝ sa. Wǝ́ pǝ nyɩnɩ apʊyǝ lǝ kǝpǝŋpǝŋkǝ rɛ. Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ mǝŋ ŋpǝ pǝ lóo koru we, kǝ pǝ siɛrɩ gbanǝŋwaarǝ sa lo mǝ ko fɛɛwǝ we. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Wǝ́ kǝceece pǝ wùru atʊkʊtuyǝ we yǝ láa ta gbanǝŋwaarǝ yǝ ŋ re rǝ apʊyǝ. Wǝ́ yǝ wʊ̀ʊ yǝ ko ŋ ko. Wǝ́ pǝ lɛ̀ pǝ wùru tuwǝ we wǝ lée re gbanǝŋwaarǝ la ŋwɛɛwǝ. Wǝ́ pǝ tonu nyaŋrǝ we ǝrǝfuŋkǝ kǝ lóo tu oturu gbanǝŋwaarǝ we ya láa saŋ lǝ ŋ ko kǝnyɩŋkǝ wǝ. Wǝ́ pǝ fǝ̀ pǝ ko ŋ ko kǝpǝŋpǝŋkǝ we. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Paa wǝ́ gbanǝŋwaarǝ we golu dɔ̀ɔ kpanǝnaŋkuwǝ rɛ rǝ mɛŋtiriwǝ yi le kǝtiitiikǝ. Wǝ́ bàa rǝ kǝnyɩŋkǝ. Wǝ́ paa mɛŋwǝ wǝ ke ŋ yi wǝ ŋ pǝ wǝ ŋ ca rǝ gbanǝŋwaarǝ sa la kǝmaakǝ mǝ okopiyǝ. Wǝ́ kǝmaakǝ we kǝ wɔ̀ rǝ kǝnǝŋkǝ. <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />Otuusiitǝpǝ we pǝ pǝ̀ pǝ wʊ okukpɛɛtǝpǝ we. Duturǝ ɖi pǝ ko ŋ suu vurǝ ǝkǝnǝŋ arɛɛpǝ pǝ lée wii pǝ suu pǝ kpii pǝ. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Paa Romatǝtuusiitǝmumuŋyǝ sa kǝ ŋ pǝ́ ŋ pɔrʊ Pɔlʊ. Kǝto wǝ́ ŋ sǝnǝ tuwǝ sa ŋ kòonu pǝ. Wǝ́ ŋ tìi epǝ we pǝ lée ci ewii we, pǝ coŋ pǝ ka tɔɔ mɛŋwǝ we, kǝ pǝ wii pǝ ko ru. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Otuturupǝ we we, arɛɛpǝ pǝ tɛ̀ɛ rǝ okpoŋkpǝlociiyǝ. Arɛɛpǝ gbanǝŋwaarǝ we lo otoopiyǝ. Kǝ́ wǝ yeli wǝ fǝ̀ wǝǝ, wǝ́ enyipǝ we kpǝlo kɩɩkɩ pǝ rù cʊrʊcʊrʊ. <figure style="fig" file="GPS_Paul4-BW.tif" size="col" copy="Wycliffe Global Alliance" ref="27:44" /><verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Pɔlʊ le ke fii gbanǝcakporǝ lǝ tǝŋtǝǝwǝ rɛ pǝ lóo pwo Malǝta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Kǝ́ yǝ la nya yǝ le ke fii we, wǝ́ pǝ tìi lǝ ǝkǝnǝŋ pǝ lóo pwo tǝŋtǝǝwǝ sa Malǝta. Gbanǝcakporǝ lǝǝwe. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Wǝ́ ǝtǝŋtǝǝtǝpǝ we pǝ lɔ̀ lǝ wǝlǝ kǝtǝŋkǝ wǝ lee kpii. Kpiikǝ ŋʊŋtɛyǝ ŋ yà ŋ kǝ ŋ pǝ, wǝ́ ziɛrǝ ga ŋ wʊ kǝto we, wǝ́ pǝ lɔ̀ lǝ lo kolu le tini rǝ naamumuŋwǝ rɛ pǝ kpìi la kǝlɛɛrɩkǝ. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Wǝ́ Pɔlʊ ŋ rɛ̀mɩ ǝrǝǝtupiyǝ rɛ ŋ kolu kpii rǝ naawǝ we. Kǝ́ naawǝ we wǝ le wii ǝrǝǝtuyǝ we we, wǝ́ matakpayǝ rɛ ŋ rù rǝ yǝlǝ mǝrǝ ŋ cò ŋ mìli Pɔlʊ rǝ akaakǝ. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Kǝ́ ǝtǝŋtǝǝtǝpǝ we pǝ la nyɩŋ kǝpɔɔkǝ we kǝ sɔ̀ɔmʊ rǝ Pɔlʊ la akaakǝ we, wǝ́ pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Nyirɔɔrɔɔyǝ wǝ́ nyiyǝ sa ŋ neh mǝ ri. Duturǝ ɖi kǝ́ ŋ nǝǝ tǝ ŋ kpǝ́ rǝ apʊyǝ lǝ mǝrǝ we, wǝ́ Worokoyǝ lo wǝtoomwarakpǝ wǝ lǝǝ pǝ́ ŋ tǝ ŋ tii vɔrʊrǝ.» <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Paape wǝ́ Pɔlʊ ŋ tɛ̀rɩ kǝpɔɔkǝ sa ŋ kpii rǝ naawǝ. Wǝ́ wǝ laa lɛ wǝ fǝrǝ ŋwǝ. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Wǝ́ enyipǝ pǝ yà pǝ kǝ ŋ rǝŋ pǝ nyɩŋ kǝ́ Pɔlʊ ŋ nah waalǝ amaa kǝ́ ŋ nah tɔɔ ŋ kpǝ́ kǝtǝrǝceŋceŋ wǝ. Paape kǝ́ pǝ lǝ rǝŋ wɩɩ pǝ laa nyɩŋ tǝrɛ wǝ pǝ wǝ tu ŋwǝ we, wǝ́ pǝ sìɛnɩ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Worokoyǝ rɛ wǝ́ ŋ ri».<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Piliyǝ rɛ pǝ ko ŋ pwo Pobilio lǝ kǝtǝǝwǝ wǝ ke kpii rǝ gaarǝ we. Wǝ́ piliyǝ sa ŋ lɔ̀ lǝ sɩsiɛrɩ. Wǝ́ le yeli juu ta rǝ nǝ kpǝŋ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Pobilio lǝ tǝ ka kpɛlɩ kǝ ŋ fǝrǝ. Ciwǝ wǝ fìi ŋwǝ, wǝ́ nyɩŋcʊkʊŋrǝ ge ŋ yee ŋwǝ. Wǝ́ Pɔlʊ ŋ kolu ŋ yɩ̀rɩ ŋwǝ. Wǝ́ ŋ mwɛnɩ nyuŋkpǝ, wǝ́ ŋ tɛ̀ɛ na akaakǝ, wǝ́ ŋ cà ŋwǝ. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Wǝ́ anyaatǝpǝ we pǝ ke kpii rǝ tǝŋtǝǝwǝ we ŋpǝ ŋkpɛ pǝ pǝlǝ. Wǝ́ Pɔlʊ ŋ cà pǝ. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Wǝ́ pǝ fǝ̀ ǝkǝmumuŋkǝ rɛ pǝ kòonu lǝ. Wǝ́ kǝ́ yǝ lah pwɛyɩ we, wǝ́ pǝ fǝ̀ otuyǝ we yǝ ke ŋ yee lǝ ariaayǝ pǝ kòonu lǝ.<verse eid="ACT 28:10" /></para>
  <para style="s">Pɔlʊ lǝ fǝ rǝ Malǝta lo ko Roma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Kǝ́ yǝ le yee akɛɛnyɔŋpǝ ata rǝ Malǝta lǝ gǝŋrǝ we we, wǝ́ le fìi tǝŋtǝǝwǝ we pǝ lóo pwo Alɛsaŋdǝri la gbanǝŋwaarǝ rɛ. Pǝ lóo pwo gbanǝŋwaarǝ sa ǝkǝnǝŋ Awɛɛpiworokopǝ. Pǝ pǝlǝ pǝ kɔnʊ ŋrǝ gbanǝŋwaarǝ sa rǝ Malǝta mǝ asiɛniyǝ. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Wǝ́ lo kolu le fìi tǝŋtǝǝwǝ we pǝ lóo pwo Sirakusa. Wǝ́ le yeli juu ta rǝ tǝŋtǝǝwǝ sa. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Wǝla kǝmaakǝ, wǝ́ lǝ fǝ̀ rǝ apʊyǝ we la kǝlɛɛrɩkǝ mǝ gbanǝŋwaarǝ we lo kolu le fìi tǝŋtǝǝwǝ we pǝ lo pwo Rego. Wǝla gaalǝǝrǝkǝ we, wǝ́ kǝpɔɔlʊsiɛɛkǝ lǝ ǝrǝfuŋkǝ kǝ ko ŋ fuŋ. Ŋ wǝ wǝ tonu lǝ, wǝ́ le yeli juu yi ko, wǝ́ lo kolu le fìi tǝŋtǝǝwǝ we pǝ lóo pwo Pusɔlʊ. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Tǝŋtǝǝwǝ sa wǝ́ lo kolu la nyɩnɩ lǝh ǝtǝŋpǝ. Wǝ́ pǝ tìi lǝ ǝkǝnǝŋ ŋlǝ le yee juu pǝrɩmata rǝ pǝlǝ kpǝŋ. Kǝ́ wǝ yeli wǝ́ lo kolu le fìi Roma wǝǝ. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Kǝ́ apaanʊpǝ we rǝ tǝŋtǝǝwǝ sa pǝ lo nuŋ ǝkǝnǝŋ ŋlǝ yǝ lóo furu we, wǝ́ pǝ pǝlǝ pǝ kù mǝ lǝ ǝrǝ tǝŋtǝǝwǝ we pǝ lóo pwo Apiwu la wǝraakpǝ mǝ fɛɛlɔǝsǝǝpǝ we pǝ lóo pwo ǝkǝnǝŋ Fɛɛlɔǝsǝǝpǝta wǝ. Kǝ́ Pɔlʊ ŋ na nyɩŋ pǝ we, wǝ́ ŋ cèeni Worokoyǝ. Wǝ́ ŋ tà na wɛ.<verse eid="ACT 28:15" /></para>
  <para style="s">Pɔlʊ le ke fii Roma</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Kǝ́ yǝ le ke fii Roma we, wǝ́ pǝ pɔ̀rʊ gʊŋrǝ pǝ kòonu Pɔlʊ, kǝ ŋpǝ mǝ tuusiitǝyǝ we ŋ kǝ ŋ rǝŋ ŋwǝ pǝ ke tii rǝ gupʊŋpwakpǝ. <verse eid="ACT 28:16" /><verse number="17" style="v" sid="ACT 28:17" />Juu ta la kǝmaakǝ we, wǝ́ Pɔlʊ ŋ pwòlu Oyudatǝpǝ lo omumuŋpǝ. Kǝ́ pǝ lo po ku we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Apaanʊpǝ, ŋ́ nee yee mǝ lǝh kǝkpǝŋkǝ la tǝrɛ, wǝ́ ŋ́ naa lɛ ŋ́ fʊmʊ lǝh ǝtǝtǝpǝ lo kǝsuŋkǝ. Paa wǝ́ pǝ la lɔ mǝ rǝ Yerusalɛmǝ, wǝ́ pǝ lǝ fǝ mǝ pǝ le kpii rǝ Oromatǝpǝ la akaakǝ.» <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Kǝ́ Oromatǝpǝ pǝ lǝ pǝ́ mǝ etieyǝ we, pǝ laa nyɩŋ tǝrɛ wǝ lóo koru okoonu kǝ ŋ́ kpǝ́. Wǝ́ pǝ kǝ ŋ pǝ́ pǝ nyarǝ mǝ pǝ co. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Wǝ́ Oyudatǝpǝ pǝ sǝnǝ. Tuwǝ sa wǝ kòonu wǝ́ ŋ́ pǝlǝ ŋ́ ka ŋ tɛŋ ǝkǝnǝŋ: «Mǝŋ wǝ lǝ ǝnǝ we, ŋ́ nóo ko mǝ etieyǝ sa rǝ Kayizaro lǝ kpǝŋ. Kaŋfɩ ŋ́ nǝǝ pǝ́ ŋ́ tɛŋ wǝkpaŋkpǝ mǝ mǝ kǝkpǝŋkǝ.» <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Tuwǝ kǝto ŋ́ nǝ pǝ́ ŋ́ nyɩŋ nǝ, kǝ ŋ́ wɛɛlɩ mǝ nǝ wǝǝ. Duturǝ ɖi nyiyǝ we Isǝrayɛlǝtǝpǝ pǝ lǝ fǝ pǝ la kpɛɛwǝ pǝ la tɛɛ rǝ we, ŋwǝ kǝto wǝ́ pǝ le kpii mǝ akpɛtɛɛyǝ sa wǝ. <verse eid="ACT 28:20" /><verse number="21" style="v" sid="ACT 28:21" />Wǝ́ Oyudatǝpǝ lo omumuŋpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ laa lɔ kǝfwɛɛkǝ rɛ rǝ Yudeya lo ru rǝ lǝ́. Wǝ́ paanʊyǝ rɛ laa lɛ ŋ pǝ ŋ pa pɔ lǝ amayǝ amaa ŋ pa tɛŋ turɔɔrɔɔwǝ rɛ ŋ ru rǝ lǝ́ ŋ tíi lǝ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Paape yǝ lǝ́ǝ pǝ́ ŋlǝ́ŋlǝ́ a wɛɛlɩ, kǝ a tɛŋ yupurǝ we ǝ lǝǝmǝ wǝ. Duturǝ ɖi le cii wǝ ǝkǝnǝŋ pǝ le yi pǝ la tɛɛ rǝ lá wǝcakukpǝ sa rǝ fɛɛ ri ŋ fɛɛ.»<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Wǝ́ pǝ tǝ̀nǝ jirǝ. Kǝ́ jirǝ we lo ro we, wǝ́ pǝ tǝ pǝ pǝlǝ pǝ kù rǝ gukpǝ we Pɔlʊ ŋ ke kpii wǝ. Wǝ́ enyipǝ pǝ pǝlǝ pǝ kʊ̀la. Wǝ́ Pɔlʊ ŋ yà ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Worokoyǝ le wǝpilirikpǝ mǝ ŋ tíi pǝ fǝ rǝ ɖokoŋpirǝ fǝ pǝ ɖiɔrǝ. Ka ŋ saŋ rǝ Mose le seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ le etieyǝ, wǝ́ ŋ ka ŋ nyɩɩ mǝ ŋ wɛɛlɩ mǝ ŋ ru rǝ Yesu, kǝ pǝ nuŋ wǝ lo duturǝ sɩsiɛrɩ, kǝ pǝ lɛ pǝ lɔ Yesu pǝ nuŋ. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Wǝ́ arɛɛpǝ pǝ lɔ̀ Pɔlʊ le dierǝ we ŋ yà ŋ ka ŋ tɛŋ pǝ nunu. Arɛɛpǝ pǝ laa lɔ pǝ nuŋ. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Kǝ́ enyipǝ we pǝ lah pwɛyɩ we, pǝ loo nuŋ awɛ lo duturǝ. Wǝ́ Pɔlʊ ŋ fǝ̀ dierǝ sa ŋ kʊ̀la pǝ ǝkǝnǝŋ: «Wɛɛkenikenirǝ dìi nǝ ǝtǝtǝpǝ sɩsiɛrɩ saŋ rǝ worokokpɛɛnuŋtɛŋtǝyǝ Esaya<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />ǝkǝnǝŋ: “Mǝ ko enyipǝ sa lǝ kpǝŋ kǝ a ka tɛŋ ǝkǝnǝŋ we</para>
  <para style="q1" vid="ACT 28:26">pǝ lée mǝ tíi nǝ wǝ</para>
  <para style="q1" vid="ACT 28:26">paape nǝ nyǝŋ po nuŋ wǝ lo duturǝ.</para>
  <para style="q1" vid="ACT 28:26">Nǝ nya mǝ yɩrɩ wǝ</para>
  <para style="q1" vid="ACT 28:26">paape nǝ nyǝŋ pa nyɩŋ wǝ.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Duturǝ ɖi enyipǝ sa pǝ lɛnyɩ yurǝ.</para>
  <para style="q1" vid="ACT 28:27">Pǝ la taŋ pǝlo otukoŋyǝ,</para>
  <para style="q1" vid="ACT 28:27">wǝ́ pǝ la lɛ pǝ le simi pǝle enimiyǝ</para>
  <para style="q1" vid="ACT 28:27">kǝ pǝ paa nya fɛɛ pǝ nuŋ amaa pǝ nyɩŋ.</para>
  <para style="q1" vid="ACT 28:27">Pǝ le yee wǝ ǝnǝ kǝ pǝ paa nya fɛɛ pǝ nuŋ wǝlo duturǝ kǝ pǝ siɛnɩ pǝ pǝ mǝ kpǝŋ kǝ ŋ́ cá pǝ. Worokoyǝ ŋ na tɛŋ wǝ.”»<verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Wǝ́ Pɔlʊ ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝ nǝ cii wǝ ǝkǝnǝŋ Worokoyǝ lǝ fǝ na alɔkuŋkǝ le Dieceeceerǝ la maŋ enyipǝ we pǝ lee ri Oyudatǝpǝ oo. Ŋpǝ paa pǝ láa lɔ rǝ pǝ nuŋ.»<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />Kǝ́ ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ Oyudatǝpǝ we pǝ pwɛ̀yɩ. Wǝ́ pǝ kpanǝ pǝ ko ŋ ko<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊrɛɛkpǝ lǝ mǝrǝ.</char></note>. <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />Wǝ́ Pɔlʊ ŋ tini cɛŋwǝ yi milimili rǝ gukpǝ we wǝ́ ŋ ka ŋ mwara wǝkutookpǝ. Ka ŋ lɔ epǝ we kpǝlo kɩɩkɩ pǝ ke ŋ siri pǝ ŋ pǝ pǝ ŋ yɩrɩ ŋwǝ. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Wǝ́ ŋ fǝ̀ wɛɛlɛŋwǝ ŋ ka ŋ tɛŋ Worokoŋtierǝ mǝ ŋ ru rǝ Worokoyǝ le wǝpilirikpǝ. Wǝ́ ŋ ka ŋ lɛ mǝ ŋ kaŋ otuyǝ mǝ ŋ ru rǝ Kulǝtǝyǝ Yesu Kǝriso. Tǝrɛ wǝ lee ke ŋ kpii na gbaraarǝ.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>