<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Tito</para>
  <para style="toc3">Tit</para>
  <para style="toc2">Tito</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Tito wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Tito</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Tito ri Pɔlʊ la kɛrɩnǝnɛyeetǝyǝ. Kǝrisotǝpiyǝ wǝ́ ŋ ri, paa lee ri Oyudatǝpǝ. Ehelatǝpǝ wǝ́ ŋ ri. Yeli kǝnǝnɛkǝ ŋpa rǝ eniyǝ we gbaraarǝ bǝlǝ rǝ Pɔlʊ mǝ Okorɛŋtotǝpǝ le kǝtiitiikǝ wǝ. Ŋ wǝ wǝ kòonu wǝ́ Pɔlʊ mǝ Okorɛŋtotǝpǝ sa pǝ cà awɛ pǝ kpìi wǝ (2 Okorɛŋtotǝpǝ 7:6-16). Tito ke kpii rǝ Kǝrɛtǝ la gbanǝcakporǝ, wǝ́ Pɔlʊ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ ŋwǝ (Tito 1:5). Kǝ kpii ke ŋ re apaanʊkǝrisotǝpǝ rǝ Kǝrɛtǝ rǝ. Rǝ kǝfwɛɛkǝ sa lo yusǝsǝŋrǝ lǝ mǝrǝ we, Pɔlʊ tàalǝ wɛ̀ɛlɩ rù rǝ zʊmarǝ lo omumuŋpǝ lǝ wǝlǝkpǝ tìi Tito. Rǝ yuyitǝrǝ lǝ mǝrǝ we, Pɔlʊ cìi kanǝ Tito kǝ́ ŋ née re na wɛ ŋ fǝ ko rǝ zʊmarǝ le wǝnyikpǝŋkpǝ lǝ kpǝŋ wǝ: Onyumupǝ mǝ etiekurupǝ, etiemǝlepǝ, okosopipǝ mǝ akɔsɔkɔrʊpǝ mǝ arɔŋpǝ (<char style="xt"><ref loc="TIT 2:1-15">2:1-15</ref></char>). Rǝ yutatǝrǝ lǝ mǝrǝ we, Pɔlʊ la wɛɛlɩ lo ru rǝ ekǝrisotǝpǝ la kǝnǝnɛkǝ. Wǝ lǝ kpuŋkpuruŋ kǝ pǝ tii rǝ wǝtaarǝkpǝ, ǝsǝpǝkǝ kǝ lee kpii. Rǝ kǝfwɛɛkǝ sa la kǝlɛɛkǝ we Pɔlʊ le kpii Tito la kǝnǝnɛkǝ rɛ wǝ́ ŋ na lɛ ŋ ne ceeni asʊmatǝpǝ ŋ na maŋ (<char style="xt"><ref loc="TIT 3:1-15">3:1-15</ref></char>). Yǝ ŋ nǝ́ǝ kǝ kǝfwɛɛkǝ sa we, láa nyɩŋ wǝ ŋ ci ǝkǝnǝŋ ŋ kǝ Tito ceŋceŋ wǝ́ pǝ le ci pǝ la kaŋ. Duturǝ ɖi akparaayǝ sa yǝ lǝ́ǝ pǝ eni ri ŋ ni rǝ zʊmarǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-4</para>
  <para style="io">- Anǝnɛyeetǝpǝ rǝ zʊmarǝ sa 1:5-16</para>
  <para style="io">- Wǝkpǝŋkpǝ kpookpookpoo rǝ wǝcakukpǝ sa la anǝnɛyǝ 2:1-15</para>
  <para style="io">- Ecikaŋkǝ 3:1-11</para>
  <para style="io">- Gʊʊcatierǝ 3:12-15</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Ŋmǝ Pɔlʊ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa. Worokoyǝ la sʊmatǝyǝ mǝ Yesu Kǝriso le nyikpiiyǝ wǝ́ ŋ́ ri. Worokoyǝ le kpii mǝ ŋ́ po toŋ epǝ we ŋ na saa ŋ na pɔrʊ kǝ pǝ nya fɛɛ pǝ lɔ pǝ nuŋ sɩsiɛrɩ. Le kpii mǝ ŋ́ pa kaŋ pǝ la anʊkɔrǝyǝ kǝ pǝ tii vɔrʊrǝ rǝ wǝkʊʊkpǝ rǝ Worokoyǝ le enimiyǝ, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />kǝ pǝ nya fɛɛ pǝ ŋ rǝŋ vɔrʊlaalɛɛrǝ we. Worokoyǝ we ŋ nǝŋ nia we, cò lǝ vɔrʊrǝ sa la garǝ tǝ̀nǝ kpɛŋ wǝ́ ŋ ci o cò ǝrǝkǝ. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />Kǝ́ eniyǝ we Worokoyǝ lah Lɔkuŋtǝyǝ ŋ tǝ̀nǝ yǝ lo ro we, wǝ́ ŋ na pɔrʊ no tutɛŋwǝ ŋ na kaŋ saŋ rǝ ne dierǝ we ŋ nǝ fǝ ŋ ne kpii mǝ rǝ akaakǝ, wǝ́ ŋ ne tíi mǝ ŋmǝ ŋ́ tɛŋ wǝ. <verse eid="TIT 1:3" /><verse number="4" style="v" sid="TIT 1:4" />Ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa mǝ ŋ maŋ ŋlǝ́ Tito. Kǝceece mǝ pipoŋpiyǝ wǝ́ e ri duturǝ ɖi a la lɔ Yesu o lo nuŋ mǝŋ ŋmǝ kǝtǝ. Lǝh Tǝ Worokoyǝ mǝ lah Lɔkuŋtǝyǝ Yesu Kǝriso pǝ yee lǝ́ lɛsiɛrɩwǝ kǝ pǝ koonu lǝ́ wǝtaarǝkpǝ.<verse eid="TIT 1:4" /></para>
  <para style="s">Kǝnǝnɛkǝ we Tito ŋ ne yee rǝ Kǝrɛtǝ wǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Ŋ́ na maa lǝ́ ŋ́ nǝ tǝnǝ rǝ Kǝrɛtǝ kǝ a nya fɛɛ o toolu tu ri ŋ tu a lɛ. Tǝnǝ zʊmarǝ lo omumuŋpǝ a tɛlɩ rǝ tǝŋtǝ ri ŋ tǝŋtǝ mǝŋ kǝ́ ŋ́ tìi lǝ́ wǝ kǝtǝ: <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />Zʊmarǝ lo mumuŋyǝ we, ŋ ri nyiyǝ ŋ nǝǝ lǝmǝ bɔtɔɔrǝ rɛ. Yǝ we ŋ na lɔ tieyǝ ceŋceŋ wǝ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Ŋ ri anʊkɔrǝyǝ ŋ koonu ne tie».</char></note>. Wǝ kpii kǝ ne epipǝ pǝ ri ekǝrisotǝpǝ. Rɛ ŋ paa nya turɔɔrɔɔwǝ rɛ ŋ tɛŋ ŋ ru rǝ pǝlǝ wǝlǝkpǝ. Rɛ ŋ paa nyɩŋ kǝnyiloopukǝ la tǝrɛ rǝ pǝlǝ mǝrǝ. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Wǝ kpii kǝ zʊmarǝ lo mumuŋyǝ ŋ pǝǝ lǝmǝ bɔtɔɔrǝ rɛ. Kpiikǝ ŋwǝ ŋ náa yɩrɩ Worokoyǝ lo otuyǝ lo yurǝ wǝ. Kǝto wǝ kpii kǝ ŋ paa mǝ rɛɛrɩ mǝ na wɛ, ŋ pee ri kpɛɛmʊrʊfǝtǝyǝ, fǝŋŋuŋtǝyǝ amaa kpaŋtaatǝyǝ. Ŋ paa mǝ taa sɩkakookooyǝ. <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />Zʊmarǝ lo mumuŋyǝ lée ri nyiyǝ ŋ náa lɔ ǝsǝǝpǝ, wǝ́ ŋ náa taa tuceeceewǝ wǝ. Wǝ kpii kǝ ŋ ri nyiyǝ ŋ nóo pu yuceeceerǝ wǝ, lée ri nyikʊʊyǝ, lée ri nyiyǝ ŋ nǝ fǝ na wɛ kpǝlo ŋ no koonu Worokoyǝ, kǝ ŋ lɛ ŋ ri nyiyǝ ŋ náa ta na wɛ mǝ ŋ re wǝ. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />Wǝ kpii kǝ ŋ tɔ ŋ yaa rǝ diepoŋpirǝ sa mǝŋ kǝ́ yǝ la kaŋ ŋwǝ wǝ. Mǝŋ le yee wǝ ǝnǝ we, lóo koru ekpii otuturupǝ lo okopiyǝ mǝ no otukaŋyǝ sa yǝ kʊʊ wǝ. Saŋ rǝ no otukaŋyǝ we, lóo koru apɔrʊ ŋ kaŋ epǝ we pǝ ya pǝ láa kaŋ otupʊŋpwayǝ ǝkǝnǝŋ pǝ la tɔɔ bɔrǝ.<verse eid="TIT 1:9" /></para>
  <para style="s">Anianiatǝtukaŋtǝpǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Kǝceece enyipǝ wa otukpǝlo Oyudatǝpǝ we pǝ la siɛrɩ pǝ le yee ekǝrisotǝpǝ we, pǝ lǝŋ nuŋ tutɛŋwǝ, wǝ́ pǝ kpii pǝ lǝ́ǝ tǝǝnǝ enyipǝ mǝ pǝle etiekpaakpaayǝ rɛ. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />Sii pǝlo nyuŋkpǝ, duturǝ ɖi vǝ́ pǝ le fii nyarǝwǝ rɛ we, ǝ pǝ ŋ pǝlǝ nyarǝwǝ we kpǝlo kɩɩkɩ le enyipǝ lo oyupuyǝ. Otuyǝ we yǝ laa laka akaŋ wǝ́ pǝ ya pǝ láa kaŋ kǝ pǝ fǝ pǝ taa sɩkakookooyǝ. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Akǝrɛtǝtǝpǝ ŋpǝŋpǝ pǝle nyiyǝ rɛ ceŋceŋ ŋ ri worokokpɛɛnuŋtɛŋtǝyǝ, la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="TIT 1:12">«Anianiatǝpǝ wǝ́ Akǝrɛtǝtǝpǝ pǝ ri ǝrǝ gakarǝ,</para>
  <para style="q1" vid="TIT 1:12">akɛɛrɔɔrɔɔpǝ, afanacitǝpǝ mǝ erikpaatǝpǝ wǝ́ pǝ ri!»<verse eid="TIT 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="TIT 1:13" />Wǝ́ tuwǝ sa ŋ na tɛŋ we, anʊkɔrǝyǝ yǝ lǝǝwe. Kǝto we, sǝ́ŋ tuwǝ o koonu pǝ kǝnyǝnya kǝnyǝnya kǝ pǝ nya fɛɛ pǝ kʊʊ rǝ lɔnuŋrǝ, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />kǝ pǝ pǝǝ tǝ pǝ co kǝtukoŋkǝ rǝ Oyudatǝpǝ le etiekpǝtɛŋyǝ, kǝ pǝ paa lɛ pǝ siimǝ anyɩmaasɩpǝ le esepǝ. Ŋpǝ anyɩmaasɩpǝ sa pǝ lǝ sǝ́ŋ anʊkɔrǝyǝ wǝ. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Tu ri ŋ tu wǝ lǝ kenikeni wǝ koonu epǝ we pǝ lǝ kenikeni wǝ. Paa epǝ we pǝ lǝǝ lǝ kenikeni, pǝ lǝ sǝ́ŋ pǝ lǝŋ lɔ pǝ nuŋ we, tǝrɛ wǝ lǝǝ lǝ kenikeni mǝ pǝ. Pǝlo oyupuyǝ mǝ pǝla ziɔŋrǝ la cɩɩ. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Pǝ láa tɛŋ ǝkǝnǝŋ ŋpǝ pǝ cii Worokoyǝ, paa pǝlo otuyeeyǝ we, yǝ laa kaŋ ǝkǝnǝŋ pǝ cii ŋwǝ. Enyipǝ pǝ lǝ kpǝlǝ pǝlǝ kǝǝwǝ. Pǝ lǝŋ pɛɛlɩ pǝla wɛ pǝ koonu Worokoyǝ wǝ́ pǝ lǝŋ koru tuceeceewǝ rɛ le eyee pwi.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Otukaŋyǝ we yǝ kaamǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Ŋlǝ́ paa we, mǝ kaŋ otuyǝ we yǝ kaamǝ otukaŋceeceeyǝ we wǝ. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Tíi onyumupǝ ǝkǝnǝŋ pǝ re pǝla wɛ sɩsiɛrɩ, pǝ ŋ pu pǝla wɛ, pǝ ŋ pu oyuceeceeyǝ, pǝ tɔ pǝ yaa rǝ lɔnuŋrǝ, kǝǝtaawǝ mǝ turutawǝ. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Kaa wǝǝ, tíi etiekurupǝ ŋpǝ ŋkpɛ ǝkǝnǝŋ pǝ re vɔrʊrǝ láa ca Worokoyǝ la kpɛɛ wǝ. Pǝ paa mǝ tɛŋ enyipǝ, pǝ paa lɛ pǝ tɔɔ ǝfǝŋŋuŋpǝ. Wǝ kaamǝ kǝ pǝ ŋ ci pǝ ŋ kaŋ enyipǝ sɩsiɛrɩ. <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />Wǝ kpii kǝ pǝ ci pǝ kaŋ akɔsɔkɔrʊpǝ we pǝ la caa pǝ tini ǝkǝnǝŋ we, pǝ taa pǝlo onuŋpǝ mǝ pǝle epipǝ lǝ kǝǝwǝ, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />pǝ ŋ pu oyuceeceeyǝ, pǝ paa cɩɩrɩ pǝla vɔrʊrǝ. Wǝ kpii kǝ pǝ ci pǝla nyarǝwǝ le ere. Pǝlǝ wǝlǝkpǝ wǝ poŋ mǝ enyipǝ. Pǝ pɛɛlɩ pǝla wɛ pǝ koonu pǝlo onuŋpǝ. Mǝŋkǝsa we, rɛ lǝŋ po koru atɛŋ turɔɔrɔɔwǝ rɛ ŋ ru rǝ Worokoyǝ le dierǝ.<verse eid="TIT 2:5" /></para>
  <para style="s">Okosopifɔŋyǝ mǝ akɔsɔkɔrʊfɔŋyǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Kaa wǝǝ, ci a kaŋ okosopifɔŋyǝ mǝ akɔsɔkɔrʊfɔŋyǝ ŋpǝ ŋkpɛ pǝ ŋ pu oyuceeceeyǝ. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Ŋlǝ́ŋlǝ́ we, mǝ yee otuceeceeyǝ rǝ tu ri ŋ tu lǝ mǝrǝ, kǝ enyituturupǝ pǝ nya fɛɛ pǝ karǝ lǝ́. Kaŋ otuyǝ mǝ anʊkɔrǝyǝ, paa wʊrʊ. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />Tɛŋ anʊkɔrǝtieyǝ kǝ oturu rɛ lǝŋ koru eyi ŋ tɛɛ rǝ yǝ. Mǝŋkǝsa we, lǝh ǝkǝǝkpǝlǝtǝpǝ pǝ lée fii nʊŋsɔɔwǝ duturǝ ɖi pǝ lǝŋ nya dierɔɔrɔɔrǝ rɛ pǝ lah tɛŋ pǝ ru rǝ lǝ.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Tíi arɔŋpǝ pǝ pɛɛlɩ pǝ koonu pǝlo okulǝtǝpǝ rǝ tu ri ŋ tu lǝ mǝrǝ. Pǝ koonu kǝ pǝlo tuwǝ wǝ poŋ mǝ pǝlo okulǝtǝpǝ. Pǝ pǝǝ sǝ́ŋ pǝlo tutɛŋwǝ, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />pǝ paa lɛ pǝ yɩɩ pǝlo tu ri ŋ tu. Eni ri ŋ ni we, pǝ ri anʊkɔrǝyǝ pǝ koonu pǝlo okulǝtǝpǝ. Mǝŋkǝsa we, tu ri ŋ tu pǝ lée yee we, wǝ lǝh mǝ kǝ Worokoyǝ, lah Lɔkuŋtǝyǝ lo otukaŋyǝ sa.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Duturǝ ɖi Worokoyǝ la pɔrʊ na lɛsiɛrɩwǝ we wǝ láa lɔ wǝ koonu anyɩmaasɩpǝ kpǝlo kɩɩkɩ la kaŋ. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />Na lɛsiɛrɩwǝ sa wǝ ya wǝ láa kaŋ lǝ otuyǝ ǝkǝnǝŋ ŋlǝ la nyarǝ vɔrʊrɔɔrɔɔrǝ mǝ ǝrǝkǝ sa lo otucakpɛɛyǝ lo co, kǝ la nya fɛɛ lo pu yuceeceerǝ, kǝ le tii vɔrʊrǝ rǝ ǝrǝkǝ sa rǝ wǝkʊʊkpǝ mǝ anʊkɔrǝyǝ lo koonu Worokoyǝ. <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />Kǝ́ yǝ lǝh mǝ rǝŋ jikpatɩrǝ we yǝ la tɛɛ kpɛɛwǝ le tini wǝǝ. Jirǝ we we, loh Worokomumuŋyǝ mǝ Lɔkuŋtǝyǝ Yesu Kǝriso<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Lah Lɔkuŋtǝyǝ Yesu Kǝriso».</char></note> lah pa pɔrʊ na wɛ ŋ kaŋ rǝ na wǝnyɩɩnɩkpǝ lǝ mǝrǝ. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />Lǝ fǝ na vɔrʊrǝ lo koonu rǝ loh yurǝ, kǝ ŋ nya fɛɛ ŋ pɔrʊ lǝ ŋ ru rǝ turɔɔrɔɔ ri turɔɔrɔɔ lǝ mǝrǝ. Lǝ pǝ́ ŋ wiiri lǝ kǝ ŋ fǝ lǝ ŋ yee ŋwǝŋwǝ nǝ kǝkpǝŋkǝ we kǝ lée yee wɛɛlɛŋwǝ rǝ tuceeceewǝ le eyeekǝ. <verse eid="TIT 2:14" /><verse number="15" style="v" sid="TIT 2:15" />Otuyǝ a lah mǝ kaŋ enyipǝ wǝǝ. Kpii enyipǝ lo okopiyǝ amaa kpaŋ mǝ pǝ. Mǝ yee wǝ mǝ ló okopiyǝ kpǝlo kɩɩkɩ. Poo po koonu rɛ la kʊŋwǝ ŋ fʊʊ lǝ́ ŋ sǝǝlǝ.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Ekǝrisotǝpǝ lǝ wǝlǝkpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Taalǝ e tíi alɔnuŋtǝpǝ we kpǝlo kɩɩkɩ ǝkǝnǝŋ wǝ kpii kǝ pǝ pɛɛlɩ pǝ koonu epilipǝ mǝ ǝkǝŋyɩrɩtǝpǝ, pǝ co kǝtukoŋkǝ rǝ pǝ, kǝ pǝ kpaka pǝ ŋ rǝŋ tuceeceewǝ le eyeekǝ. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />Pǝ paa tɛŋ rɛ le dierɔɔrɔɔ, pǝ sǝ́ŋ wǝkpaŋkpǝ. Pǝ ri enyitaarǝpǝ kǝ pǝ lɛ pǝ poŋ mǝ nyi ri ŋ nyi eni ri ŋ ni. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Eniyǝ nɔ we, ŋla ŋkpɛ yǝ loo ko ŋ nuŋ tǝrɛ lo dutu, oturuyeetǝpǝ wǝ le ke ri, lǝ lǝ̀ǝ caceeceewǝ we. Le ke ri arɔŋpǝ lo kòonu otucakpɛɛyǝ kpǝlo mǝ araŋpiyǝ kpǝlo. La ka lɛnyɩ yurǝ wǝ́ la ka ŋ mwɛɛrɩ otuyǝ le nimirǝ. Enyipǝ pǝ kǝ ŋ kpǝlǝ lǝ kǝǝwǝ, wǝ́ ŋlǝŋlǝ lǝ kǝ ŋ kpǝlǝ awɛ lǝ kǝǝwǝ. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Paa kǝ́ Worokoyǝ lah Lɔkuŋtǝyǝ ŋ na pɔrʊ ne wǝceeceekpǝ mǝ nǝ kǝǝtaawǝ ŋ lǝǝmǝ ŋ koonu anyɩmaasɩpǝ ŋ na kaŋ we, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />wǝ́ ŋ na lɔ ŋ no koonu lǝ, ŋkǝ kǝ́ yǝ le yee otuceeceeyǝ kǝto. La nyɩŋ lǝ tǝlarǝwǝ rǝ kǝto. La lɔ lo koonu lǝ, wǝ́ ŋ no kuŋ pǝ lǝ kpǝlǝŋ pǝ lǝ mǝ lǝ mǝ kǝ́ ŋ na siɛ lo oturɔɔrɔɔyǝ wǝ. Wǝ́ Wɛɛkenikenirǝ lo koonu lǝ vɔrʊŋwɛŋrǝ. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />Worokoyǝ la nyarǝ Wɛɛkenikenirǝ sa lo co lo koonu lǝ ŋpa saŋ rǝ lah Lɔkuŋtǝyǝ Yesu Kǝriso lo oŋuŋkǝ. <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />Mǝŋkǝsa we, Worokoyǝ lǝ fǝ lǝ le yee enyikʊʊpǝ saŋ rǝ na lɛsiɛrɩwǝ we mǝrǝ, kǝ la nya fɛɛ la pa nya vɔrʊlaalɛɛrǝ we la ya yǝ lǝ́ǝ rǝŋ wǝ. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Dierǝ sa ɖi rǝ anʊkɔrǝyǝ. Kǝto ŋ́ nǝ pǝ́ a mǝ nyɩɩ a mǝ tɛŋ rǝ kpuŋkpuruŋ, kǝ epǝ we pǝ la lɔ Worokoyǝ pǝ lo nuŋ we pǝ nya fɛɛ pǝ fǝ pǝ tɛɛ rǝ pǝla wɛ ŋpa pǝ ŋ yee otuceeceeyǝ. Tuwǝ wǝ ponu wǝ́ wǝ lǝǝmǝ vasʊyǝ wǝ koonu enyikpǝlo wǝǝ. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Sǝ́ŋ etietiinikpaakpaayǝ, ǝtǝtǝtǝtǝpǝ lǝ wǝmǝkpǝ lǝ ǝkǝkǝ, akpaŋyǝ mǝ etietiiniyǝ ru rǝ Mose le seyǝ lo oŋuŋkǝ, otukpaakpaayǝ yǝ lǝǝwe yǝ lǝǝ lǝmǝ vasʊyǝ rɛ. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Yǝ we ŋ née kpii wǝsǝpǝkpǝ rǝ enyipǝ lǝ mǝrǝ we, sǝ́ŋ wǝ o koonu ŋwǝ kǝrɛyɩ, kǝyi. Kǝtatǝkǝ we, pɔrʊ ŋwǝ a cɛ. <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />E cii wǝ ǝkǝnǝŋ nyiyǝ sa wǝrʊʊkpǝ we, la nyalǝ mǝ carɔɔrɔɔwǝ. Kǝ́ ŋ re ŋ yaa mǝ turɔɔrɔɔwǝ le eyeekǝ we, oturu ŋwǝŋwǝ la tɔɔ na wɛ la bɔrǝ.<verse eid="TIT 3:11" /></para>
  <para style="s">Ecikaŋtuturukǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Ŋ́ née kpii Atema amaa Tisiko ŋ maŋ lǝ́. Vǝ́ pǝ le pe fii we, nyɩɩ kǝ ǝ pǝ a pa nyɩŋ mǝ rǝ Nikopoli. Fɛɛwǝ ŋ́ na tɛŋ ŋ́ noh ko ŋ́ ke tii mǝ asiɛniyǝ sa wǝǝ. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Nyɩɩ kǝ o co kpaŋtɛŋtǝyǝ we pǝ lóo pwo Zena la kʊŋ, mǝŋ Apolo. Kpaka pǝla kʊŋcowǝ sa sɩsiɛrɩ, kǝ tǝrɛ wǝ pee ke yee pǝla ariaayǝ rǝ gʊŋrǝ. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Wǝ kpii kǝ lǝh ǝtǝŋ ekǝrisotǝpǝ ŋpǝ ŋkpɛ pǝ karǝ eceeceeyeeyǝ ŋpa. Mǝŋkǝsa vǝ́ mǝŋ rɛ le fii rǝ gbaraarǝ we, pǝ ŋ nya fɛɛ pǝ toŋ yǝ we. Pǝ pee tii vɔrʊrǝ lǝǝ lǝmǝ vasʊyǝ wǝ. <verse eid="TIT 3:14" /><verse number="15" style="v" sid="TIT 3:15" />Epǝ we kpǝlo kɩɩkɩ pǝ kpii rǝ mǝ kpǝŋ we, pǝ lée ceeni lǝ́. Ceeni lǝh ǝtǝŋ alɔnuŋtǝpǝ. Worokoyǝ ŋ yee nǝ kpǝlo kɩɩkɩ la lɛsiɛrɩwǝ.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>