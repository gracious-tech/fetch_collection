<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">Akebou: La Bible en akebou</book>
  <para style="h">Filemɔ</para>
  <para style="toc3">Fil</para>
  <para style="toc2">Filemɔ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Filemɔ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Filemɔ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ na maŋ ne pwetaa Filemɔ. Filemɔ ri kǝrisotǝpiyǝ rǝ Kolose la zʊmarǝ. Pɔlʊ ŋ tɛnɩ Worokoŋtierǝ ŋ tìi ŋwǝ wǝ́ ŋ sìɛrɩ vɔrʊrǝ. Filemɔ kǝ lǝǝmǝ rɔŋyǝ, ŋwǝ ŋ ri Onesimǝ. Wǝ́ rɔŋyǝ sa ŋ pǝlǝ ŋ sùu rǝ nǝ kpǝŋ. Rǝ no osuupwɛyɩkǝ sa mǝrǝ wǝ́ ŋ kolu ŋ kùumǝ Pɔlʊ, eniyǝ we ŋ ke kpii rǝ gukpɛɛkpǝ wǝ. Saŋ rǝ Pɔlʊ lo oŋuŋkǝ wǝ́ Onesimǝ ŋ pǝlǝ ŋ yeli kǝrisotǝpiyǝ. Wǝ́ Pɔlʊ ŋ fǝ̀ ŋ tɛ̀ɛ rǝ na wɛ ǝkǝnǝŋ ŋwǝ nóo co Onesimǝ la kʊŋ ŋ kpǝlǝŋ mǝ ŋ ko no kulǝtǝyǝ lǝ kpǝŋ. Fɛɛwǝ ŋ náa ŋʊrʊ kǝfwɛɛkǝ ŋ maŋ Filemɔ kǝ ŋ tɔɔ ŋ kpɛɛ ŋwǝ ŋ lɔ Onesimǝ atuu, ŋ pǝǝ fǝ ŋwǝ mǝŋ na rɔŋyǝ ŋ no suu kǝtǝ! Paa ŋ lɔ ŋwǝ mǝŋ paanʊyǝ rǝ lɔnuŋrǝ kǝtǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1-3</para>
  <para style="io">- Pɔlʊ lǝ kǝ Filemɔ 4-7</para>
  <para style="io">- Pɔlʊ la dɔɔkpɛɛkpiirǝ koonu Onesimǝ 8-22</para>
  <para style="io">- Eceenituturukǝ 23-25</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Ŋmǝ Pɔlʊ pǝ la lɔ pǝ la taŋ kpiikǝ ŋ́ ya ŋ́ náa sʊma Yesu Kǝriso wǝ. Ŋlǝ mǝ paanʊyǝ Timote yǝ la ŋʊrʊ kǝfwɛɛkǝ sa yǝ la maŋ ŋlǝ́ Filemɔ lǝh kǝǝtaatǝyǝ mǝ lah kɛrɩyǝ rǝ anǝnɛyǝ, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />fǝ kʊla mǝ paatɛyǝ Apia, mǝ lah kɛrɩ Arisipǝ, yǝ we ŋ ya ŋ naa fia mǝŋ ŋlǝ kǝtǝ mǝ ŋ koonu Kǝriso wǝ, mǝ asʊmatǝpǝ we pǝ lóo ku rǝ lá nyarǝwǝ pǝ ŋ sʊma Worokoyǝ wǝ. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />Lǝh Tǝ Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ, kǝ pǝ koonu nǝ wǝtaarǝkpǝ!<verse eid="PHM 1:3" /></para>
  <para style="s">Filemɔ la lɔnuŋrǝ mǝ nǝ kǝǝtaawǝ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Filemɔ, eni ri ŋ ni vǝ́ ŋ́ nah mwɛŋ nyuŋkpǝ we, ŋ́ náa taalǝ lǝ́. Oturu ŋ́ ne ceeni mǝ Worokoyǝ rǝ ló yurǝ. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Duturǝ ɖi ŋ́ nóo nuŋ ǝkǝnǝŋ ŋlǝ́ a láa taa alɔnuŋtǝpǝ kpǝlo kɩɩkɩ lǝ kǝǝwǝ. Wǝ́ a la lɛ a la lɔ Kulǝtǝyǝ Yesu o lo nuŋ sɩsiɛrɩ. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ Worokoyǝ kǝ lɔnuŋrǝ sa ǝ lǝǝmǝ a kʊla mǝ lǝ we, nyɩnɩ rǝ lǝ́. Wǝceeceekpǝ we kpǝlo kɩɩkɩ lǝ lǝǝmǝ rǝ lah vɔrʊrǝ, kǝ́ la ya yǝ láa sʊma Kǝriso we, kǝ a nya fɛɛ a pɔrʊ kpǝ a kaŋ. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Paanʊyǝ, ŋ́ na nya faawǝ ŋpa, wǝ́ turuwǝ wǝ la ta mǝ. Duturǝ ɖi a láa taa alɔnuŋtǝpǝ lǝ kǝǝwǝ, wǝ́ lɛrǝ la taarǝ pǝ.<verse eid="PHM 1:7" /></para>
  <para style="s">Pɔlʊ le kpii Filemɔ la dɔɔkpɛɛrǝ lo koonu Onesimǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Kǝ́ wǝ lǝ mǝŋkɔɔwe kǝto we, kaŋfɩ gʊŋrǝ gbɛlɩ mǝ faa rǝ Kǝriso mǝrǝ ŋ́ née tíi lǝ́ tuwǝ wǝ kaamǝ kǝ e yee. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Paape, rǝ kǝǝtaawǝ kǝto we, ŋ́ nǝ pǝ́ ŋ́ pǝ́ lǝ́ tuwǝ sa. Awo, ŋmǝ Pɔlʊ nyumuyǝ sa! Ŋmǝ yǝ ǝnǝ pǝ la lɔ pǝ la taŋ kpiikǝ ŋ́ ya ŋ́ náa sʊma Yesu Kǝriso kǝto! <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ lǝ́ tuwǝ sa mǝ ŋ koonu Onesimǝ. La siɛrɩ le yee mǝ pimǝyǝ rǝ gukpɛɛkpǝ sa. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Eniyǝ nɔ we, lǝǝ kǝ lǝmǝ vasʊyǝ rɛ ŋ koonu lǝ́. Paa rǝkǝsa we, lǝǝmǝ vasʊyǝ koonu lǝ, ŋlǝ mǝ lǝ́.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Ŋ́ náa siɛnɩ ŋ́ co na kʊŋ ŋ́ maŋ lǝ́. Wǝ ya wǝ lée yee mǝ rǝ mǝŋ ŋmǝŋmǝ mǝ ziɔŋrǝ<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Mǝŋ mǝ kǝtakǝ kǝceŋceŋ kǝtǝ».</char></note> wǝ́ ŋ́ no co kʊŋ ŋ́ na maŋ lǝ́ ǝnǝ! <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Ŋ́ kah lɔ ŋwǝ ŋ́ tǝnǝ rǝ mǝ kpǝŋ, kǝ ŋ mǝ ŋ sʊma mǝ rǝ ló yuwǝ rǝ gukpɛɛkpǝ sa ŋ́ kpii rǝ Dieceeceerǝ sa lo yurǝ kǝto wǝ. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Paa ŋ́ nǝǝ pǝ́ ŋ́ yee tǝrɛ kǝ o turu ŋ́ nǝǝ pǝ́ lǝ́ ŋ nuŋ tuwǝ a láa tɛŋ wǝ! Ŋ́ nǝŋ taa ŋ́ pa nyɩɩnɩ lǝ́ kɩnɩkɩnɩ e yee wǝceeceekpǝ. Ŋ́ nǝ pǝ́ ŋlǝ́ŋlǝ́ e yee wǝ mǝ lá ziɔŋrǝ faa.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Ayɩrɛ Onesimǝ la pwɛyɩ rǝ lǝ́ kpǝŋ rǝ enipiyǝ rɛ lǝ mǝrǝ kǝ a nya fɛɛ a nya ŋwǝ kǝkpakǝkpa! <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Duturǝ ɖi rǝkǝsa we, lǝǝ tǝ ŋ ri rɔŋyǝ rǝ ko. Le teeri rɔŋyǝ! La siɛrɩ le yee paanʊkǝǝtaatǝyǝ. Otukpǝlo ŋmǝ we, ŋ́ náa taa nǝ kǝǝwǝ ŋpa. Paa lá nɛŋwǝ wǝ lǝ́ǝ tǝ wǝ teeri. Duturǝ ɖi we, ri lá rɔŋyǝ rǝ nyɩmaasɩyǝ lǝ wǝlǝkpǝ, wǝ́ ŋ lɛ ŋ ri lá paanʊyǝ rǝ Kǝriso lǝ mǝrǝ.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Kǝto mǝŋ a la nyɩŋ ǝkǝnǝŋ ŋmǝ ŋ́ ri lé pwetaayǝ we, we lɔ ŋwǝ atuu mǝŋ kǝ́ a kah lɔ ŋmǝŋmǝ kǝtǝ. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Wǝ́ mǝŋ le yee tǝrɛ la fɔ rǝ lǝ́ kpǝŋ we, amaa re lǝ́ wǝtookpǝ rɛ we, ŋ́ na lɔ kpǝ ŋ́ na tɛɛ rǝ mǝ wɛ. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Ŋmǝ Pɔlʊ ŋ́ na ŋʊrʊ etieyǝ sa mǝ mǝ akaakǝ ŋ́ ya ŋ́ náa tɛŋ ǝkǝnǝŋ we, ŋ́ nah pa mwara wǝtookpǝ we. Ŋlǝ́ŋlǝ́ e cii wǝ ǝkǝnǝŋ ŋlǝ́ e re mǝ wǝtookpǝ rɛ, wǝtookpǝ sa wǝ kaamǝ lá vɔrʊrǝ! <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Awo, paanʊyǝ, dɔɔkpɛ yee tuwǝ sa o koonu mǝ rǝ Kulǝtǝyǝ lo yurǝ kǝto. Ta mǝ turuwǝ rǝ Kǝriso la nyɩŋrǝ.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Kǝ́ ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa we, ŋ́ na marǝ alɔ ŋ́ no nuŋ ǝkǝnǝŋ e lée yee tuwǝ we ŋ́ nǝ pǝ́ lǝ́ wǝ. Wǝ́ ŋ́ cii wǝ ǝkǝnǝŋ e lée yee e teeri wǝ we ŋ́ nǝ pǝ́ lǝ́ wǝ. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Tǝ fǝ kʊla we, taa gukpǝ ǝ tǝnǝ mǝ. Duturǝ ɖi nǝ onyuŋmwɛŋyǝ kǝto we, ŋ́ na tɛɛ kpɛɛwǝ ǝkǝnǝŋ wǝ lǝŋ panǝ pǝ láa nyarǝ mǝ pǝ co pǝ koonu nǝ.<verse eid="PHM 1:22" /></para>
  <para style="s">Eceenituturukǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Epafǝrasɩ lée ceeni nǝ. Ŋwǝ ŋkpɛ kpii kʊla mǝ mǝ rǝ gukpɛɛkpǝ sa rǝ Kǝriso lo yurǝ kǝto. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Marǝko, Arisǝtako, Demasǝ mǝ Luka pǝ ya pǝ lée yee anǝnɛyǝ pǝ ŋ kʊla mǝ mǝ we, ŋpǝ ŋkpɛ pǝ lée ceeni nǝ.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ!<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>