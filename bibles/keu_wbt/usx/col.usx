<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">Akebou: La Bible en akebou</book>
  <para style="h">Okolosetǝpǝ</para>
  <para style="toc3">Oko</para>
  <para style="toc2">Okolosetǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Okolosetǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Okolosetǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Bibǝlayǝ la kǝfwɛɛkǝ sa pǝ lóo pwo Okolosetǝpǝ la kǝfwɛɛkǝ we, kǝ kaamǝ kǝfwɛɛkǝ we Pɔlʊ ŋ na ŋʊrʊ ŋ na maŋ zʊmarǝ we ge kpii rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Kolose wǝ. Tǝŋtǝǝwǝ sa wǝ ke kpii rǝ Azi la kǝcɔkɔŋtɔɔkǝ. Ŋ wǝ tǝŋtǝǝwǝ sa wǝ kaamǝ gǝŋrǝ we pǝ lóo pwo ruŋruŋ le jirǝ ǝkǝnǝŋ Turǝki wǝ. Ŋkǝ Pɔlʊ ŋ tǝ̀nǝ zʊmarǝ sa, paa na kɛrɩnǝnɛyeetǝyǝ we pǝ lóo pwo Epafǝrasɩ ŋ tǝ̀nǝ rǝ. Pɔlʊ ke kpii rǝ gukpɛɛkpǝ wǝ́ ŋ nunu ǝkǝnǝŋ anianiatǝtukaŋtǝpǝ rɛ pǝ ya pǝ lǝ́ǝ tǝǝnǝ asʊmatǝpǝ sa rǝ tǝŋtǝǝwǝ sa. Ŋpǝ anianiatǝtukaŋtǝpǝ sa pǝ ya pǝ ka ŋ kaŋ pǝlo otuyǝ ǝkǝnǝŋ pe kǝ pǝ pe ci Worokoyǝ, kǝ pǝ nya alɔkuŋkǝ we, wǝ kpii kǝ pǝ ŋ sʊma okopiyǝ rɛ rǝ wɛɛrǝ, kǝ pǝ ŋ yee pǝ saŋ rǝ erikǝ le esepǝ rɛ. Kǝ́ Pɔlʊ ŋ na nya ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ zʊmarǝ we gbii rǝ Kolose wǝ. Wǝ́ ŋ tìi pǝ sɩsiɛrɩ ǝkǝnǝŋ Worokoyǝ la alɔkuŋkǝ sa ŋ na lɔ ŋ no koonu lǝ saŋ rǝ Yesu Kǝriso we kǝ lo ro kaka!</para>
  <para style="ip">Dierǝ we Pɔlʊ ŋ tɛnɩ rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ we, dǝ ya lée yee kǝnǝnɛkǝ po ru ruŋruŋ le jirǝ sa. Ŋrǝ gaamǝ ǝkǝnǝŋ Kǝriso ceŋceŋ ko ŋ náa pɔrʊ enyipǝ mǝ ŋ ru rǝ wɛɛrǝ lo okopiyǝ mǝrǝ wǝ, wǝ́ ŋkǝ ǝkǝǝlǝkǝ mǝ keeriwǝ le esepǝ yǝ lóo koonu kǝ nyɩmaasɩyǝ ŋ kʊʊ rǝ Worokoyǝ le enimiyǝ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Pɔlʊ la wɛ la apɔrʊkaŋkǝ mǝ Worokoyǝ le eceenikǝ 1:1-14</para>
  <para style="io">- Kǝriso, zʊmarǝ lo mumuŋyǝ 1:15–2:3</para>
  <para style="io">- Vɔrʊŋwɛŋrǝ le etiikǝ rǝ Kǝriso mǝrǝ 2:20–4:6</para>
  <para style="io">- Eceenikǝ 4:7-18</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Ŋmǝ Pɔlʊ, Yesu Kǝriso le <char style="w">nyikpiiyǝ</char> wǝ́ ŋ́ ri mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ wǝ wǝ. Ŋlǝ mǝ paanʊyǝ Timote la ya yǝ láa ŋʊrʊ kǝfwɛɛkǝ sa yǝ ŋ maŋ ŋnǝ epǝ we nǝ ri <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />lǝh ǝtǝŋpǝ rǝ Kolose, wǝ́ nǝ ri Worokoyǝ la anɛŋpǝ mǝ kǝ́ nǝ nya lɔ Kǝriso nǝ nyo nuŋ kǝceece wǝ.</para>
  <para style="p" vid="COL 1:2">Lǝh Tǝ Worokoyǝ ŋ yee nǝ lɛsiɛrɩwǝ kǝ ŋ koonu nǝ wǝtaarǝkpǝ.<verse eid="COL 1:2" /></para>
  <para style="s">Pɔlʊ ya lée ceeni Worokoyǝ rǝ Okolosetǝpǝ lo yurǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Eni ri ŋ ni vǝ́ yǝ lah mwɛŋ nyuŋkpǝ yǝ ŋ koonu nǝ we, yǝ lée ceeni Worokoyǝ rǝ nǝ yurǝ. Ŋwǝ Worokoyǝ sa ŋ ri loh Kulǝtǝyǝ Yesu Kǝriso lǝ Tǝyǝ wǝ. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />Duturǝ ɖi yǝ lo nuŋ pǝ la wɛɛlɩ pǝ lo ru rǝ wǝlǝkpǝ we nǝ nya lɔ Yesu Kǝriso nǝ nyo nuŋ mǝ wǝlǝkpǝ we nǝ ya nǝ nyáa taa epǝ we pǝ ri Worokoyǝ la anɛŋpǝ lǝ kǝǝwǝ nǝ nyǝ ŋ fǝ wǝ. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />Nǝ ya nǝ nyée yee wǝ ǝnǝ kpiikǝ nǝ ya nǝ nyǝ́ǝ rǝŋ tuwǝ we Worokoyǝ ŋ na kʊʊ ŋ nǝ tǝnǝ nǝ rǝ yulaarǝ wǝ. Kǝ́ pǝ la tɛŋ anʊkɔrǝyǝ le dierǝ we ɖi Dieceeceerǝ we pǝ le tíi nǝ kǝto, wǝ́ nǝ nye ci ǝrǝŋkǝ sa wǝ. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />Dieceeceerǝ sa lǝ pǝ nǝ kpǝŋ, wǝ́ lɛ gbii rǝ ǝrǝkǝ sa kpǝlo lǝ mǝrǝ. Ŋrǝ Dieceeceerǝ sa ya láa ta lǝ ŋ kʊla, wǝ́ ya láa lɛ lǝ ŋ ko kǝnyɩŋkǝ rǝ ǝrǝkǝ sa kpǝlo lǝ mǝrǝ. Kǝnǝnɛkǝ sa ke wǝ́ Dieceeceerǝ sa ya lée yee rǝ nǝ mǝrǝ ǝrǝ jirǝ we nǝ nunu wǝ́ nǝ nyɩnɩ wǝ nǝ cìi ǝkǝnǝŋ kǝceece Worokoyǝ lée yee enyipǝ la lɛsiɛrɩwǝ.<verse eid="COL 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 1:7" />Lǝh kǝǝtaatǝyǝ Epafǝrasɩ ŋ ri lah kɛrɩnǝnɛyeetǝyǝ ŋ na kaŋ nǝ ŋyǝ otuyǝ sa. Ya lée yee kǝnǝnɛkǝ mǝ ŋ koonu nǝ mǝŋ Kǝriso la nʊkɔrǝtǝnǝnɛyeetǝyǝ kǝtǝ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />Ŋwǝ ŋ na wɛɛlɩ ŋ no ru rǝ kǝǝtaawǝ we wɛɛkenikenirǝ lǝ fǝ le kpii rǝ nǝ mǝrǝ ŋ ne tíi lǝ.<verse eid="COL 1:8" /></para>
  <para style="s">Pɔlʊ la mwɛŋ nyuŋkpǝ lo koonu Okolosetǝpǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Kǝto kǝ́ ŋla ŋkpɛ yǝ lo nuŋ pǝ la wɛɛlɩ pǝ lo ru rǝ nǝ ǝnǝ we, wǝ́ la ya yǝ láa mwɛŋ nyuŋkpǝ yǝ ŋ tɛɛ rǝ nǝ eni ri ŋ ni. Rǝ loh onyuŋmwɛŋyǝ sa lǝ mǝrǝ we, yǝ lée tíi Worokoyǝ ŋ koonu nǝ otuciyǝ kpǝlo mǝ nimisiewǝ we wǝ lo ru rǝ Wɛɛkenikenirǝ lǝ kpǝŋ, kǝ nǝ nya fɛɛ nǝ ci tuwǝ we ŋ náa taa kǝǝwǝ wǝ. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Mǝŋkǝsa we, nǝ nyóo koru ere nǝ wɛ mǝŋ kǝ́ Kulǝtǝyǝ ŋ nǝ pǝ́, kǝ nǝ tuwǝ wǝ poŋ mǝ ŋwǝ rǝ tu ri ŋ tu lǝ mǝrǝ. Duturǝ ɖi otuyǝ we kpǝlo yǝ nya yǝ ponu lǝ ǝtǝnǝyǝ wǝ́ pǝ lah mǝ nyɩŋ rǝ nǝ, kǝ nǝ tǝ nǝ mǝ ci Worokoyǝ nǝ mǝ kʊla. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />La ya yǝ láa mwɛŋ nyuŋkpǝ ke kǝ Worokoyǝ ŋ fǝ no okopimumuŋyǝ we ŋ kpii nǝ okopiyǝ rǝ tu ri ŋ tu lǝ mǝrǝ. Mǝŋkǝsa we nǝ nyáa nya lɛtaarǝwǝ, kǝ nǝ tɔ nǝ yaa. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Nǝ fǝ faawǝ nǝ mǝ ceeni Tǝyǝ, duturǝ ɖi ŋwǝ ŋ no koonu wǝ́ ŋnǝ ŋkpɛ nǝ nyo koru eri ǝtǝtuyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ rǝ wǝnyɩɩnɩkpǝ koonu na anɛŋpǝ wǝ. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Ŋwǝ ŋ na pɔrʊ lǝ rǝ nuŋtumuwǝ lo okopiyǝ mǝrǝ, wǝ́ ŋ nǝ fǝ lǝ ŋ nǝ pǝ ne Pikǝǝtaatǝyǝ le wǝpilirikpǝ mǝrǝ. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />Worokoyǝ la lɔ lǝ lo fuu saŋ rǝ ne Piyǝ sa wǝ́ ŋ nǝ fǝ loh oturɔɔrɔɔyǝ ŋ na cɛɛ lǝ.<verse eid="COL 1:14" /></para>
  <para style="s">Pɔlʊ la nɔŋ lǝ kǝ Kǝriso</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />Worokoyǝ we pǝ lǝŋ nyɩŋ we, lǝ wǝlǝkpǝ wǝ kaamǝ Kǝriso. Ŋwǝ ŋ ri pisǝŋmǝyǝ. Ke kpii kaka kpɛŋ, wǝ́ Worokoyǝ ŋ ci ocò tu ri ŋ tu. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Duturǝ ɖi saŋ rǝ ŋwǝ Kǝriso wǝ́ Worokoyǝ ŋ no co tu ri ŋ tu wǝ kpii rǝ yulaarǝ mǝ kǝtǝǝwǝ, otuyǝ we pǝ láa nyɩŋ mǝ eyǝ we pǝ lǝŋ nyɩŋ, epilipǝ lo okopiyǝ mǝ okulǝtǝpǝ lo okopiyǝ, okopiyǝ mǝ okopilǝtǝpǝ. Ŋyǝ otuyǝ sa kpǝlo we, ŋwǝ Worokoyǝ ŋ ne yee yǝ saŋ rǝ Kǝriso ŋ no koonu na wɛ. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Ŋwǝ Worokoyǝ le Piyǝ sa kpii conu kòonu tu ri ŋ tu, wǝ́ saŋ rǝ ŋwǝ wǝ́ tu ri ŋ tu wǝ kpii wǝ. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Ŋwǝ ŋ ri yurǝ ŋ koonu wɛlɛŋrǝ. Wɛlɛŋrǝ sa gaamǝ ekǝrisotǝpǝ kpǝlo la wǝcakukpǝ. Ŋwǝ ŋ ri kǝsǝsǝŋkǝ, wǝ́ ŋ lɛ ŋ ri yǝ we ŋ no coŋ asaanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ, kǝ ŋ nya fɛɛ ŋ pa lɔ fɛɛsǝsǝŋwǝ rǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Duturǝ ɖi Worokoyǝ lǝ pǝ́ ŋ pe tii fee rǝ ne Pi lǝ mǝrǝ. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />Wǝ́ saŋ rǝ ne Piyǝ sa we, Worokoyǝ lǝ pǝ́ ŋ ca ǝrǝkǝ sa kpǝlo ŋ kpii mǝ na wɛ. Saŋ rǝ ne Piyǝ lǝ ǝkpǝ́kǝ rǝ kpɛtɛkpǝlɛciiwǝ we, wǝ́ Worokoyǝ ŋ no koonu nyi ri ŋ nyi la wǝtaarǝkpǝ rǝ kǝtǝǝwǝ mǝ yulaarǝ. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Eniyǝ nɔ we, ŋnǝ ŋkpɛ nǝ kǝ lǝǝrǝ mǝ Worokoyǝ, nǝ ke ri nǝ ǝkǝǝkpǝlǝtǝpǝ saŋ rǝ turɔɔrɔɔwǝ we nǝ ko ŋ pu, wǝ́ nǝ ke ŋ yee kǝto. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Paape rǝkǝsa we, Worokoyǝ la ca ŋnǝ mǝ ŋwǝ le kpii rǝ awɛ saŋ rǝ ne Pi la gbɛŋrǝ. Cʊ̀ʊrʊ ŋpa rǝ na wɛlɛŋrǝ wǝ́ ŋ ci ǝkpǝ́. Kǝto rǝkǝsa we, nǝ nyóo koru a ka yaa rǝ Worokoyǝ la kǝnyɩŋkǝ mǝŋ enyikenikenipǝ rɛ pǝ lǝǝ lǝmǝ arɛɛyǝ, wǝ́ pǝ lǝŋ lɛ pǝ nyɩŋ wǝfɔkpǝ rɛ rǝ wǝ. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />Paa wǝ kaamǝ kǝ nǝ tɔ nǝ yaa kiŋkiŋ rǝ lɔnuŋrǝ, kǝ nǝ lɛnyɩ. Nǝ poo ruu nǝ cɛ rǝ etieyǝ we nǝ nunu rǝ Dieceeceerǝ we lǝ mǝrǝ. Ŋrǝ Dieceeceerǝ sa ɖi tuwǝ we nǝ ya nǝ nyǝ́ǝ rǝŋ wǝ. Ŋrǝ wǝ́ pǝ tɛnɩ pǝ tíi anyɩmaasɩpǝ rǝ ǝrǝkǝ kpǝlo. Wǝ́ ŋmǝ Pɔlʊ ŋ́ na siɛrɩ ŋ́ ne yee Dieceeceerǝ sa la sʊmatǝyǝ.<verse eid="COL 1:23" /></para>
  <para style="s">Pɔlʊ la fia rǝ asʊmatǝpǝ lo yurǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Rǝkǝsa we, ŋ́ ya ŋ́ náa nya faawǝ rǝ acʊcʊʊrʊyǝ we ŋ́ ya ŋ́ náa cʊʊrʊ rǝ nǝ yurǝ wǝ. Duturǝ ɖi ŋ́ ya ŋ́ náa lɛ acʊcʊʊrʊyǝ we Kǝriso ŋ no pwo mǝ ŋ́ pa cʊʊrʊ ŋ koonu na wɛlɛŋrǝ wǝ. Na wɛlɛŋrǝ sa gaamǝ ekǝrisotǝpǝ kpǝlo la wǝcakukpǝ. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Ŋ́ na siɛrɩ ŋ́ ne yee sʊmatǝyǝ ŋ́ no koonu ŋpǝ ekǝrisotǝpǝ sa rǝ kǝnǝnɛkǝ we Worokoyǝ ŋ ne kpii mǝ ŋ́ pe yee ŋ́ koonu nǝ kǝto. Le kpii mǝ ŋ́ pa tɛŋ ne Dierǝ kpǝlo kɩɩkɩ ŋ́ tíi nǝ. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Dierǝ sa gaamǝ dierǝ we la ŋwaa ǝrǝ gakakakarǝ, wǝ́ paape rǝkǝsa Worokoyǝ la pɔrʊ rǝ la kaŋ epǝ we pǝ ri na anɛŋpǝ wǝ. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Duturǝ ɖi Worokoyǝ lǝ pǝ́ ŋ pɔrʊ dieŋwaarǝ sa lo ru okuruyǝ wǝ́ naanǝ ŋ kaŋ wǝkpǝŋkpǝ kpǝlo. Dieŋwaarǝ sa gaamǝ ǝkǝnǝŋ Kǝriso kpii kʊla mǝ nǝ, wǝ́ mǝŋ kpii kʊla mǝ nǝ we, nǝ lǝmǝ kpɛɛtɛɛwǝ ǝkǝnǝŋ kǝtiikǝ kǝ kpɛlɩ nǝ rǝ Worokoyǝ la <char style="w">wǝnyɩɩnɩkpǝ</char> we mǝrǝ. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />La ya yǝ láa tɛŋ Kǝrisoyǝ sa le dierǝ yǝ ŋ tíi nyi ri ŋ nyi. Yǝ lǝ fǝ otuciyǝ kpǝlo kɩɩkɩ la ya yǝ lée ci yǝ ŋ kaŋ nyi ri ŋ nyi wǝ́ la ya yǝ láa kaŋ nyi ri ŋ nyi lo otuyǝ kǝ enyipǝ kpǝlo pǝ nya fɛɛ pǝ kuru rǝ wɛɛrǝ rǝ Kǝriso lǝ mǝrǝ. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Tuwǝ kǝto ŋ́ ya ŋ́ née yee anǝnɛyǝ, wǝ́ ŋ́ nǝ fǝ Kǝriso lo okopimumuŋyǝ we yǝ ya yǝ lée yee anǝnɛyǝ rǝ mǝ mǝ ŋ fia wǝǝ.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Ŋ́ nǝ pǝ́ nǝ ci wǝ ǝkǝnǝŋ ŋ́ ya ŋ́ náa fia ŋpa mǝ ŋ koonu ŋnǝ mǝ ekǝrisotǝpǝ we pǝ kpii rǝ Lawodike fǝ kʊla mǝ epǝ we pǝ faa nyɩŋ mǝ pǝ nyɩŋ wǝ. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Ŋ́ ya ŋ́ náa fia mǝŋkǝsa kǝ ŋnǝ mǝ pǝ nǝ nya fɛɛ nǝ nya wɛɛlɛŋwǝ, kǝ nǝ nya fɛɛ nǝ tǝ nǝ mǝ taa awɛ lǝ kǝǝwǝ nǝ mǝ kʊla. Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ lǝmǝ kpɛɛtɛɛmumuŋwǝ we nimisiepoŋpiwǝ wǝ lóo koonu wǝ. Mǝŋkǝsa we, nǝ nyóo koru eci Worokoyǝ lo tuŋwaawǝ we nǝ fii mǝrǝ sɩsiɛrɩ. Tuŋwaawǝ sa wǝ kaamǝ Kǝriso ŋwǝŋwǝ. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Ŋwǝ Kǝriso lǝ mǝrǝ wǝ́ otuciyǝ mǝ nimisiewǝ lo otulǝmǝyǝ yǝ la ŋwaa yǝ kpii wǝ. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Ŋ́ ya ŋ́ née tíi nǝ dierǝ sa kǝ rɛ ŋ paa nya fɛɛ ŋ pǝ tǝǝnǝ nǝ mǝ nyuŋraŋkpǝ le etieyǝ ŋ lǝǝrǝ. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Wǝ ke ce wǝ ri ǝkǝnǝŋ ŋmǝ ŋ́ nee kpii rǝ nǝ mǝrǝ we, nǝ ci wǝ ǝkǝnǝŋ ŋ́ ya ŋ́ náa taalǝ nǝ eni ri ŋ ni. Wǝ́ ŋ́ ya ŋ́ náa nya faawǝ mǝ kǝ́ ŋ́ ya ŋ́ nóo nuŋ kǝ́ nǝ ya nǝ nyée yee otuyǝ rǝ wǝlǝceeceekpǝ, wǝ́ nǝ nya tɔ nǝ nya yaa rǝ lɔnuŋrǝ rǝ Kǝriso lǝ mǝrǝ wǝ.<verse eid="COL 2:5" /></para>
  <para style="s">Kǝriso ceŋceŋ ŋ nóo koonu tu ri ŋ tu wǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Rǝkǝsa kǝ́ nǝ nya tɛɛnɩ Yesu Kǝriso ŋ ri nǝ Kulǝtǝyǝ we, nǝ mǝ tii vɔrʊrǝ we gaamǝ ŋwǝ Kǝriso wǝ. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Nǝ ru okuruŋkuyǝ nǝ sʊʊ rǝ Kǝriso lǝ mǝrǝ, kǝ nǝ tɔ nǝ vɔrʊrǝ kpǝlo kɩɩkɩ nǝ tɛɛ rǝ ŋwǝ. Nǝ tɔ nǝ yaa rǝ lɔnuŋrǝ lo otuyǝ we pǝ la kaŋ nǝ wǝ, kǝ nǝ lɛ nǝ re nǝ ya nǝ mǝ ceeni Worokoyǝ ŋpaŋpa. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />Nǝ yee yurǝ, rɛ ŋ pǝǝ pǝ fǝ anyɩmaasɩpǝ lo otucikpaakpaayǝ mǝ dǝǝnǝkpiirǝ ŋ tǝǝnǝ nǝ. Ŋyǝ otuyǝ sa kǝtǝŋkǝ we, yǝ loo ru rǝ Kǝriso lǝ kpǝŋ, anyɩmaasɩpǝ lo kǝsuŋkǝ lǝ kpǝŋ mǝ ǝrǝkǝ sa lo okopiyǝ lǝ kpǝŋ wǝ́ yǝ lo ru. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Duturǝ ɖi Worokoyǝ lǝ wǝlǝkpǝ fee wǝ ke kpii rǝ Kǝriso lǝ mǝrǝ wǝ. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />Wǝ́ saŋ rǝ ŋwǝ Kǝriso kǝto wǝ́ Worokoyǝ ŋ na wʊʊ otuyǝ ŋ no koonu nǝ wǝ. Kǝriso ŋ ri okopiyǝ kpǝlo mǝ okopilǝtǝpǝ kpǝlo lo mumuŋyǝ wǝ. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />Kǝ́ nǝ nye yee nyiŋceŋceŋ mǝ Kǝriso kǝto wǝ́ pǝ lǝ kǝǝlǝ nǝ wǝ. Wǝ́ ǝkǝǝlǝkǝ sa we ŋkǝ anyɩmaasɩpǝ pǝ lǝ́ǝ kǝǝlǝ kǝ, Kǝriso lǝ kpǝŋ wǝ́ kǝ lo ru. Ŋ kǝ ǝkǝǝlǝkǝ sa kǝ la pɔrʊ tuwǝ we wǝ kpii rǝ nǝ mǝrǝ, wǝ́ wǝ ko ŋ tu nǝ wǝ ŋ kpii rǝ oturɔɔrɔɔyǝ wǝ. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />Duturǝ ɖi kǝ́ pǝ wìiri nǝ worokomɛŋwǝ we, wǝ lǝ mǝŋ kǝ́ nǝ nyǝ kpǝ́ wǝ́ pǝ la ŋwaa nǝ pǝ la kʊla mǝ Kǝriso kǝtǝ. Wǝ́ nǝ nya lɛ nǝ nya saanǝ ŋnǝ mǝ ŋwǝ kpiikǝ nǝ nya lɔ Worokoyǝ lo okopiyǝ we yǝ la saanǝ ŋwǝ yǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ nǝ nyo nuŋ kǝto. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Eniyǝ nɔ we, nǝ kpǝ̀ rǝ nǝ oturɔɔrɔɔyǝ fǝ kʊla mǝ kǝ́ nǝ nyǝǝ kǝǝlǝ kǝto. Paape rǝkǝsa we, Worokoyǝ la saanǝ ŋnǝ mǝ Kǝriso. Wǝ́ ŋ nǝ fǝ loh oturɔɔrɔɔyǝ kpǝlo ŋ na cɛɛ lǝ. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Worokoyǝ la laarǝ kǝfwɛɛkǝ we kǝ ke kpii mǝ otuyǝ we yǝ ka ŋ tɔɔ lǝ bɔrǝ rǝ seyǝ la kǝnyɩŋkǝ wǝ. Lǝ pǝlǝ kǝfwɛɛkǝ sa mǝ eniyǝ we pǝ kpàa Yesu pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ. Wǝ lǝ rǝ mǝŋ kǝ́ pǝ la kpàa kǝfwɛɛkǝ sa pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ kǝtǝ. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Worokoyǝ la lɔ okopiyǝ rǝ okopiyǝ mǝ okopilǝtǝpǝ la akaakǝ. Wǝ́ ŋ pɔ̀rʊ okopiyǝ mǝ okopilǝtǝpǝ sa, wǝ́ ŋ pɔ̀rʊ pǝ ŋ fɛlɩ rǝ enyikpǝlo le enimiyǝ. Wǝ́ ŋ tìini pǝ ŋ ko ŋ ko mǝŋ arɔŋpǝ kǝtǝ rǝ ne Pi lo yurirǝ we mǝrǝ.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Kǝto rɛ ŋ paa tɛŋ nǝ wǝkpaŋkpǝ rǝ keeriwǝ we nǝ nyée ri, amaa tuwǝ we nǝ nyóo ŋuŋ, amaa wǝcɛkpǝ amaa kɛɛnyɔŋŋwɛŋyǝ amaa sabatǝyǝ la tǝrɛ. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Ŋyǝ otuyǝ sa kpǝlo we, yǝ ri rǝ otuyǝ we yǝ kǝ ŋ pǝ yǝ pǝ pǝ la cɛrɛcɛrɛyǝ. Paa tuwǝ we ŋ wǝ ŋ wǝ we, wǝ kaamǝ Kǝriso. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Enyipǝ rɛ pǝ láa taa nianiatǝwɛɛpɛɛlɩwǝ mǝ epicoŋpipǝ la asʊmakǝ, wǝ́ pǝ láa lɛ pǝ ŋ nya akaa kururu rǝ pǝla wǝtʊkpɛɛkpǝ. Nǝ paa maa ŋpǝ enyipǝ sa la rɛ ŋ tɔɔ nǝ bɔrǝ. Pǝla anyɩmaasɩyupuyǝ yǝ lo koonu wǝ́ pǝ láa rɛɛrɩ mǝ pǝla wɛ wǝ. Paa rǝ anʊkɔrǝyǝ we, pǝ lee ri tǝrɛ. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />Ŋpǝ enyipǝ sa pǝ lǝŋ kpaa pǝ maarǝ mǝ Kǝriso yǝ we ŋ ri yurǝ. Wǝ́ ŋnǝ ekǝrisotǝpǝ la wǝcakukpǝ wǝ ri na wɛlɛŋrǝ. Kaŋfɩ ŋrǝ yurǝ sa lóo koonu wɛlɛŋrǝ kpǝlo le keeriwǝ. Ŋrǝ yurǝ sa ke lóo koonu oturu otoŋyǝ mǝ efiiniyǝ yǝ la ta awɛ yǝ re, wǝ́ wɛlɛŋrǝ kpǝlo láa naanǝ mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ wǝ.<verse eid="COL 2:19" /></para>
  <para style="s">Tii vɔrʊrǝ o koonu Kǝriso</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Kǝ́ nǝ nyǝ kpǝ́ nǝ nya kʊla mǝ Kǝriso kǝto nǝ nyo ru rǝ ǝrǝkǝ sa lo okopiyǝ mǝrǝ. Wǝ́ kǝ́ kǝto wǝ́ nǝ ya nǝ nyée yee mǝ nǝ wɛ mǝŋ ŋnǝ nǝ tǝ nǝ kpii nǝ koonu ǝrǝkǝ, wǝ́ pǝ ya pǝ lée kpii esepǝ pǝ ŋ koonu nǝ ǝkǝnǝŋ <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />«Pǝǝ fǝ tuwǝ sa», «Paa ra tuwǝ sa a yɩrɩ», «Poo ruu wǝ ǝnǝ» wǝ? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Ŋpǝ esepǝ sa we, vǝ́ pǝ lǝ fǝ pǝ pǝ le yee anǝnɛyǝ we, o po turu pǝ lǝ nǝŋ. Anyɩmaasɩpǝ le esepǝ mǝ pǝlo otukaŋyǝ yǝ lǝǝwe. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Paa kǝceece we, vǝ́ a la yɩrɩ esepǝ o lo ko we, a láa tɛŋ ǝkǝnǝŋ pǝ kpii mǝ otuciyǝ kwa. Duturǝ ɖi esepǝ sa pǝ láa kaŋ otuyǝ ǝkǝnǝŋ nyɩmaasɩyǝ ŋ sʊma Worokoyǝ mǝ okopiyǝ, kǝ ŋ pɛɛlɩ na wɛ, kǝ ŋ kpii na wɛ lo vuurǝ. Paa we, esepǝ sa pǝ lǝŋ toŋ nyɩmaasɩyǝ kǝ ŋ ri na wɛlɛŋrǝ lo otucakpɛɛyǝ lo yurǝ mǝŋ tɩ.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Kǝ́ wǝ ri ǝkǝnǝŋ ŋnǝ mǝ Kǝriso nǝ nya saanǝ we, we nǝ taa yulaarǝ lo otuyǝ, rǝ fɛɛwǝ we Kǝriso ŋ tini, rǝ Worokoyǝ le kǝnirisiɛɛkǝ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Nǝ pǝǝ fǝ nǝ oyupuyǝ nǝ tɛɛ rǝ ǝkǝtǝǝtuyǝ lo oŋuŋkǝ, paa nǝ fǝ nǝ oyupuyǝ nǝ tɛɛ rǝ yulaarǝ lo otuyǝ eni ri ŋ ni. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Duturǝ ɖi nǝ nyǝ kpǝ́ wǝ́ pǝ lǝ fǝ nǝ vɔrʊrǝ pǝ la kʊla mǝ Kǝriso pǝ la ŋwaa rǝ Worokoyǝ lǝ mǝrǝ. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Vǝ́ Kǝriso la pa siɛnɩ lǝ pǝ we, ŋnǝ mǝ ŋwǝ nǝ nyǝ́ǝ pǝ rǝ na <char style="w">wǝnyɩɩnɩkpǝ</char> we mǝrǝ.<verse eid="COL 3:4" /></para>
  <para style="s">Vɔrʊŋwɛŋrǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Nǝ koonu kǝ otuyǝ we yǝ kpii rǝ nǝ mǝrǝ wǝ́ yǝ ri ǝkǝtǝǝtuyǝ yǝ kpǝ́. Ŋyǝ otuyǝ sa yǝ kaamǝ: Kǝtienaakǝ amaa vuuyɩɩrǝ amaa nuŋruwǝ, arɛɛyǝ lo otuyeeyǝ, otucakpɛɛrɔɔrɔɔyǝ, nimimwɛɛrɩmumuŋwǝ. Rǝ anʊkɔrǝyǝ we, nimimwɛɛrɩmumuŋwǝ vɛɛsʊmarǝ lǝǝwe. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Ŋyǝ otuyǝ sa yǝ lóo koonu oturu Worokoyǝ la kpɛɛmʊrʊwǝ wǝ la sʊʊ rǝ epǝ we pǝ lǝ sǝ́ŋ pǝ lǝŋ nuŋ no tutɛŋwǝ wǝ. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Ŋnǝ ŋkpɛ we, ŋyǝ otuyǝ sa wǝ́ nǝ ke ŋ yee eniyǝ nɔ, eniyǝ we yǝ lɔ̀ kǝtiikǝ rǝ nǝ vɔrʊrǝ wǝ.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />Paape rǝkǝsa we, nǝ sǝ́ŋ ŋyǝ otuyǝ sa nǝ co. Ŋyǝ yǝ kaamǝ, kpɛɛmʊrʊwǝ, akpɛɛmʊrʊfǝyǝ, kǝnyipielikǝ. Kǝnyifɛɛpɩkǝ fǝ kʊla mǝ etieyǝ we yǝ laa laka atɛŋkǝ we, yǝ poo mǝ ru rǝ nǝ nyuŋkpǝ. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Nǝ pǝǝ tǝ nǝ mǝ nia nǝ mǝ tíi awɛ, duturǝ ɖi nǝ wǝlǝkuukuukpǝ we mǝ wǝlo otuyeeyǝ we, nǝ nya nyarǝ yǝ nǝ nyo co. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />Wǝ́ kǝ́ nǝ nya nya wǝlǝŋwɛŋkpǝ kǝto we, nǝ nya siɛrɩ nǝ nye yee enyiŋwɛŋpǝ. Wǝ́ Worokoyǝ ŋ ya ŋ nóo toolu nǝ mǝ ŋ yee aŋʊŋwɛŋ eni ri ŋ ni, kǝ nǝ nya fɛɛ nǝ ru ŋwǝ, kǝ nǝ lɛ nǝ ci ŋwǝ sɩsiɛrɩ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Rǝkǝsa we, wǝcɛkɛlɛkpǝ rɛ wǝ lǝǝ tǝ wǝ kpii rǝ yǝ we ŋ nee ri Yudatǝnyiyǝ mǝ yǝ we ŋ ri Yudatǝnyiyǝ lǝ mǝrǝ, yǝ we pǝ lǝ kǝǝlǝ mǝ yǝ we pǝ lǝǝ kǝǝlǝ lǝ mǝrǝ. Sǝǝyǝ lǝǝ tǝ ŋ kpii, epǝ we pǝ loo wuru enimiyǝ pǝ lǝǝ tǝ pǝ kpii, rɔŋyǝ lǝǝ tǝ ŋ kpii, yǝ we pǝ la nyarǝ pǝ lo co lǝǝ tǝ ŋ kpii, pǝlo kpǝlo pǝ kaa rǝ. Kǝriso ŋ lǝ kpuŋkpuruŋ wǝ, wǝ́ ŋ ri tu ri ŋ tu. Ŋwǝ ŋ lɛ ŋ kpii rǝ enyipǝ sa kpǝlo kɩɩkɩ lǝ mǝrǝ wǝ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Rǝkǝsa kǝ́ Worokoyǝ ŋ na taa nǝ kǝǝwǝ, wǝ́ ŋ na saa nǝ ŋ na pɔrʊ we, nǝ nya siɛrɩ nǝ nye yee ŋwǝ Worokoyǝ la anɛŋpǝ. Kǝto nǝ maa kǝ nǝ wǝlǝkpǝ wǝ lǝ mǝ tǝlarǝnyɩŋwǝ, lɛsiɛrɩwǝ, wɛɛpɛɛlɩwǝ, wǝlǝtaarǝkpǝ mǝ lɛtaarǝwǝ. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Nǝ tɛɛnɩ nǝ re awɛ mǝ lɛtaarǝwǝ. Mǝŋ rɛ rǝ nǝ mǝrǝ lǝǝmǝ dierǝ ŋpǝ mǝ na kɛrɩyǝ we, pǝ fǝ pǝ cɛɛ awɛ. Mǝŋ kǝ́ Kulǝtǝyǝ ŋ nǝ fǝ ŋ na cɛɛ nǝ kǝtǝ we ŋnǝ ŋkpɛ nǝ fǝ nɛ cɛɛ awɛ. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Otukpǝlo we, nǝ taa awɛ lǝ kǝǝwǝ. Kǝǝtaawǝ wǝ ri tuwǝ wǝ láa ca enyipǝ wǝ ŋ kpii rǝ awɛ sɩsiɛrɩ wǝ. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Kǝriso la wǝtaarǝkpǝ wǝ ri wǝpilikpǝ rǝ nǝ mǝrǝ. Duturǝ ɖi wǝtaarǝkpǝ sa kǝto wǝ́ Worokoyǝ ŋ no pwo nǝ nǝ pe yee wɛlɛŋrǝ jeŋceŋ wǝ. Nǝ nyɩŋ tuwǝ we Worokoyǝ ŋ ne yee ŋ no koonu nǝ nǝ ci, kǝ nǝ mǝ ceeni ŋwǝ. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Kǝriso le dierǝ lɔ kǝtiikǝ rǝ nǝ mǝrǝ ŋpaŋpa. Nǝ fǝ otuciyǝ kpǝlo nǝ kaŋ awɛ lo otuyǝ, kǝ nǝ lɛ nǝ ci nǝ kaŋ awɛ. Nǝ fǝ nǝ ziɔŋrǝ kpǝlo nǝ nɔŋ Opusomǝpǝ, anɔŋyǝ mǝ Wɛɛrǝ la anɔŋyǝ nǝ ceeni Worokoyǝ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Tu ri ŋ tu nǝ nyée yee, wǝ ke ce wǝ ri rǝ awɛɛlɩkǝ amaa rǝ anǝnɛyǝ we, nǝ yee yǝlo kpǝlo saŋ rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ. Nǝ lɛ nǝ ceeni Worokoyǝ we ŋ ri Tǝyǝ saŋ rǝ ŋwǝ Yesu.<verse eid="COL 3:17" /></para>
  <para style="s">Ǝpǝrǝŋpǝ, etiepǝ mǝ epipǝ lǝ wǝlǝkpǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Ŋnǝ etiepǝ, nǝ pɛɛlɩ nǝ wɛ nǝ koonu nǝ onuŋpǝ, mǝŋ kǝ́ wǝ kaamǝ kǝ epǝ we pǝ ri Kulǝtǝyǝ la anɛŋpǝ pǝ yee wǝ kǝtǝ. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Ŋnǝ ǝpǝrǝŋpǝ, nǝ taa nǝ etiepǝ lǝ kǝǝwǝ, kǝ nǝ paa lɛnyɩ yurǝ mǝ pǝ. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Ŋnǝ epipǝ, nǝ co kǝtukoŋkǝ rǝ nǝ ǝmǝtǝpǝ lo tutɛŋwǝ rǝ tu ri ŋ tu lǝ mǝrǝ. Kǝ́ Kulǝtǝyǝ ŋ nǝ pǝ́ wǝǝ. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Ŋnǝ ǝtǝpǝ, nǝ pee mǝ kpii nǝ epipǝ la kpɛɛmʊrʊwǝ, kǝ wɛɛyɔɔwǝ wǝ pe fii pǝ.<verse eid="COL 3:21" /></para>
  <para style="s">Kǝ́ rɔŋyǝ mǝ kulǝtǝyǝ pǝ lée re awɛ pǝ fǝ wǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />Ŋnǝ arɔŋpǝ, nǝ co kǝtukoŋkǝ rǝ tu ri ŋ tu nǝ okulǝtǝpǝ rǝ kǝtǝǝwǝ sa pǝ lée tíi nǝ wǝ. Ŋkǝ eniyǝ we pǝ yaa pǝ láa yɩrɩ nǝ ko wǝ́ nǝ nyeh mǝ yee anǝnɛyǝ, kǝ wǝ pe ri ǝkǝnǝŋ ŋnǝ nǝ ya nǝ nyǝ́ǝ pǝ́ pǝ kǝ nǝ rǝ. Paa nǝ fǝ ziɔŋceeceerǝ nǝ mǝ yee wǝ mǝŋ eniyǝ we pǝ laa yaa wǝ. Nǝ mǝ yee wǝ rǝ Kulǝtǝyǝ Yesu lo vusuurǝ mǝrǝ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Kǝnǝnɛ ri ŋ kǝnǝnɛ nǝ nyée yee we, nǝ fǝ nǝ ziɔŋrǝ kpǝlo nǝ yee kǝ. Nǝ fǝ wǝ mǝŋ Kulǝtǝyǝ wǝ́ nǝ ya nǝ nyée yee kǝ nǝ nyǝ ŋ koonu, ŋkǝ anyɩmaasɩpǝ. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Nǝ ci wǝ ǝkǝnǝŋ Kulǝtǝyǝ lah pa mwara nǝ wǝlo wǝtookpǝ. Nǝ nyeh pe ri ǝtǝtuyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ na anɛŋpǝ wǝ. Duturǝ ɖi Kulǝtǝyǝ we nǝ ya nǝ nyáa sʊma we, ŋwǝ ŋ kaamǝ Kǝriso. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Paa yǝ we ŋ ne yee turɔɔrɔɔwǝ we, láa lɔ turɔɔrɔɔwǝ lo wǝtoomwarakpǝ. Duturǝ ɖi Worokoyǝ lǝŋ pa yɩrɩ rǝ anyɩŋkǝ ŋ yee tǝrɛ.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Ŋnǝ Okulǝtǝpǝ, kǝ nǝ mǝ taalǝ ǝkǝnǝŋ ŋnǝ ŋkpɛ nǝ lǝǝmǝ Kulǝtǝyǝ rɛ rǝ yulaarǝ. Kǝto nǝ re nǝ arɔŋpǝ mǝ wǝkʊʊkpǝ, kǝ nǝ re pǝ mǝŋ kǝ́ wǝ lǝ pǝ́ wǝ.<verse eid="COL 4:1" /></para>
  <para style="s">Ecikaŋkǝ</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Nǝ mǝ nyɩɩ rǝ nyuŋmwɛŋwǝ lǝ mǝrǝ. Vǝ́ nǝ ya nǝ nyáa mwɛŋ nyuŋkpǝ we, nǝ oyupuyǝ yǝ tɛɛ rǝ nyuŋmwɛŋ we, kǝ nǝ mǝ ceeni Worokoyǝ. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Nǝ lɛ nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu lǝ, kǝ Worokoyǝ ŋ nya fɛɛ ŋ koonu lǝ gʊŋrǝ kǝ la tɛŋ ne dierǝ, kǝ la pɔrʊ Kǝriso le dieŋwaarǝ we la tɛŋ. Duturǝ ɖi ŋrǝ dierǝ sa kǝto wǝ́ ŋ́ kpii rǝ gukpɛɛkpǝ wǝ. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Kǝto nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu mǝ kǝ ŋ́ nya fɛɛ ŋ́ pɔrʊ dieŋwaarǝ sa ŋ tɛŋ sɩsiɛrɩ mǝŋ kǝ́ wǝ kaamǝ kǝ ŋ́ tɛŋ rǝ wǝ. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Nǝ mǝ re nǝ wɛ mǝ otuciyǝ ko rǝ epǝ we pǝ lee ri ekǝrisotǝpǝ lǝ kpǝŋ. Vǝ́ nǝ nya nya doloŋrǝ rɛ we, nǝ pǝǝ pǝlǝ eniyǝ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Nǝ maa kǝ nǝ etieyǝ yǝ ŋ ca enyipǝ la kpɛɛ, kǝ yǝ lɛ yǝ raŋ. Nǝ ci kǝ́ nǝ nyǝ́ǝ kpǝlǝŋ dierǝ nǝ koonu nyiyǝ sɩsiɛrɩ nǝ fǝ wǝ.<verse eid="COL 4:6" /></para>
  <para style="s">Eceenituturukǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Tisiko lah pa wɛɛlɩ ŋ ru rǝ mǝ ŋ tíi nǝ. Ŋwǝ ŋ ri lah paanʊkǝǝtaatǝyǝ, nʊkɔrǝtǝnǝnɛyeetǝyǝ mǝ mǝ kɛrɩyǝ rǝ Kulǝtǝyǝ la kǝnǝnɛkǝ mǝrǝ. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Kǝto ŋ́ neh kpii ŋwǝ ŋ́ maŋ nǝ kǝ ŋ pe tíi nǝ kǝ́ le kpii lǝ fǝ wǝ, kǝ ŋ pa ta nǝ turuwǝ. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Ŋ́ ne kpii ŋwǝ ŋpǝ mǝ Onesimǝ. Onesimǝ ŋ ri lah paanʊnʊkɔrǝtǝyǝ mǝ kǝǝtaatǝyǝ. Nǝ nyiyǝ ŋ lǝǝwe. Pǝ leh pe tíi nǝ tu ri ŋ tu wǝ ya wǝ lǝ́ǝ pǝ rǝ fɛɛwǝ sa wǝ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Arisǝtako lée ceeni nǝ. Ŋlǝ mǝ ŋwǝ le kpii rǝ gukpɛɛkpǝ. Banaba lo tuuluyǝ Marǝko ŋwǝ ŋkpɛ lée ceeni nǝ. Pǝ la marǝ eci pǝ la kaŋ nǝ ru rǝ ŋwǝ Marǝko. Mǝŋ lǝ pǝ nǝ kpǝŋ we, nǝ lɔ ŋwǝ sɩsiɛrɩ. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Yoswa, yǝ we pǝ lǝ́ǝ tǝ pǝ ŋ pwo Yusǝto we, ŋwǝ ŋkpɛ lée ceeni nǝ. Ŋpǝ enyipǝ sa atapǝ ko pǝ ri Oyudatǝpǝ we pǝ la lɔ Kǝriso pǝ lo nuŋ wǝ, wǝ́ pǝ ya pǝ lée yee anǝnɛyǝ sa pǝ ŋ kʊla mǝ mǝ koonu Worokoyǝ le <char style="w">wǝpilirikpǝ</char>. Pǝ lo toŋ mǝ ŋpa. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Epafǝrasɩ lée ceeni nǝ. Ŋwǝ ŋkpɛ ri nǝ nyiyǝ. Yesu Kǝriso la sʊmatǝyǝ sa we, láa mwɛŋ nyuŋkpǝ eni ri ŋ ni mǝ ŋ koonu nǝ kpuŋkpuruŋ, kǝ nǝ nya fɛɛ nǝ tɔ nǝ yaa mǝŋ epǝ we pǝ lo kuru rǝ lɔnuŋrǝ kǝtǝ, kǝ nǝ nya fɛɛ nǝ mǝ yee Worokoyǝ lǝ kǝǝpǝ́wǝ kpǝlo kɩɩkɩ. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Ŋ́ nóo koru eri ɖaŋsieyǝ ŋ koonu ŋwǝ ǝkǝnǝŋ ya lée yee anǝnɛyǝ ŋpa mǝ ŋ koonu nǝ, wǝ́ ŋ ya ŋ née yee mǝ ŋ koonu ekǝrisotǝpǝ we pǝ kpii rǝ Lawodike mǝ epǝ we pǝ kpii rǝ Yerapolisi. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Lah kɛrɩ Luka, yǝ we ŋ ri wɛɛcátǝyǝ mǝ Demasǝ pǝ lée ceeni nǝ. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Nǝ ceeni lǝh ǝtǝŋpǝ we pǝ kpii rǝ Lawodike. Nǝ ceeni Niŋfa fǝ kʊla mǝ ekǝrisotǝpǝ la wǝcakukpǝ we wǝ lóo ku rǝ na nyarǝwǝ wǝ. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Vǝ́ nǝ nyǝ kǝ kǝfwɛɛkǝ sa nǝ nya lɛ rǝ nǝ kpǝŋ we, kǝ nǝ fǝ kǝ nǝ maŋ ekǝrisotǝpǝ la wǝcakukpǝ we rǝ Lawodike, kǝ ekǝrisotǝpǝ we pǝ kpii rǝ we pǝ nya fɛɛ pǝ kǝ kǝ ŋpǝ ŋkpɛ. Ŋnǝ ŋkpɛ nǝ kǝ kǝfwɛɛkǝ we kǝ lóo ru rǝ Lawodike kǝ po tuu nǝ wǝ. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Nǝ tíi Arikipo ŋ re Kulǝtǝyǝ la kǝnǝnɛkǝ we pǝ lǝ fǝ pǝ le kpii ŋwǝ rǝ akaakǝ sɩsiɛrɩ. Ŋ yee kǝ sɩsiɛrɩ. <verse eid="COL 4:17" /><verse number="18" style="v" sid="COL 4:18" />Ŋmǝ Pɔlʊ ŋ́ ya ŋ́ née ceeni nǝ. Ŋmǝŋmǝ ŋ́ nǝ fǝ mǝ akaakǝ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa le dietǝtǝǝlǝrǝ sa. Nǝ mǝ taalǝ ǝkǝnǝŋ ŋmǝ ŋ́ kpii rǝ gukpɛɛkpǝ.</para>
  <para style="p" vid="COL 4:18">Worokoyǝ la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>