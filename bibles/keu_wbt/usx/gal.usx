<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Agalatiatǝpǝ</para>
  <para style="toc3">Aga</para>
  <para style="toc2">Agalatiatǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Agalatiatǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Agalatiatǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa. Yesu Kǝriso le nyikpiiyǝ wǝ́ ŋ ri. Eniyǝ we Pɔlʊ ŋ ka ŋ tɛŋ Worokoŋtierǝ mǝ ŋ tɛlɩ we, pǝlǝ kolu gǝŋrǝ we pǝ lóo pwo Galatia. Wǝ́ ŋ kolu ŋ tɛnɩ Worokoŋtierǝ rǝ gǝŋrǝ sa, wǝ́ enyipǝ pǝ lɔ̀ pǝ nunu. Wǝ́ ŋ tǝ̀nǝ asʊmayǝ rǝ gǝŋrǝ sa. Worokoŋtierǝ we Pɔlʊ ŋ tɛnɩ ŋ tìi pǝ gaamǝ ǝkǝnǝŋ, vǝ́ nyɩmaasɩyǝ la nya la lɔ Yesu Kǝriso lo nuŋ ko we, Worokoyǝ lǝ́ǝ fǝ ŋwǝ mǝŋ nyikʊʊyǝ kǝtǝ. Paape rǝ acɛŋyǝ rɛ la kǝmaakǝ we, wǝ́ enyipʊŋpwapǝ ŋpǝ ŋkpɛ pǝ pǝlǝ pǝ kolu Galatia. Wǝ́ pǝ kolu pǝ ke ŋ kpii pǝ lo otukoŋyǝ ǝkǝnǝŋ Worokoŋtierǝ we pǝ nunu rǝ Pɔlʊ lǝ kpǝŋ we, loo to. Ŋpǝ paa pǝ ka ŋ tɛŋ ǝkǝnǝŋ kǝ́ Agalatiatǝpǝ pǝ lee ri Oyudatǝpǝ wǝ́ paa pǝ la lɔ Yesu Kǝriso pǝ lo nuŋ we, wǝ kaamǝ kǝ pǝ yee pǝ saŋ rǝ Mose le seyǝ otukpǝlo wǝ kaamǝ kǝ pǝ kǝǝlǝ. Ŋ wǝ tuwǝ sa wǝ lóo koonu kǝ Worokoyǝ ŋ fǝ̀ pǝ mǝŋ enyikʊʊpǝ kǝtǝ wǝ. Kǝ́ Pɔlʊ ŋ no nuŋ ǝkǝnǝŋ Agalatiatǝpǝ pǝ la lɔ enyipǝ sa pǝ lo nuŋ we, wǝ́ ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋpa. Fɛɛwǝ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ kpanǝ mǝ ekǝrisotǝpǝ rǝ Galatia ŋ manǝ, wǝ́ ŋ lɛ̀ ŋ taalǝ pǝ sɩsiɛrɩ ǝkǝnǝŋ Yesu Kǝriso la alɔnuŋkǝ ko kǝ lóo koru okoonu kǝ pǝ kʊʊ rǝ Worokoyǝ le enimiyǝ wǝ. Lɔnuŋrǝ sa ke lóo koonu kǝ pǝ tii vɔrʊrǝ we bonu mǝ Worokoyǝ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Eceenikǝ 1:1-10</para>
  <para style="io">- Pɔlʊ la pɔrʊ la kaŋ ǝkǝnǝŋ nyikpiiyǝ wǝ́ ŋwǝ ŋ ri 1:11–2:21</para>
  <para style="io">- Worokoyǝ le Dieceeceerǝ we ŋ na maŋ lǝ wǝ 3:1–4:31</para>
  <para style="io">- Ekǝrisotǝpǝ le diiwɛɛrǝ mǝ tuwǝ wǝ kpii wǝ koonu pǝ kǝ pǝ yee wǝ 5:1–6:10</para>
  <para style="io">- Pɔlʊ le etietuturuyǝ 6:11-18</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Ŋmǝ Pɔlʊ, ŋ́ ri nyikpiiyǝ. Ŋkǝ nyɩmaasɩyǝ ŋ na pɔrʊ mǝ ŋ́ yee nyikpiiyǝ, wǝ laa lɛ wǝ saŋ rǝ nyɩmaasɩyǝ rɛ. Paape Yesu Kǝriso mǝ Worokoyǝ we ŋ ri Tǝyǝ, wǝ́ ŋ na saanǝ Yesu Kǝriso ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ pǝ la pɔrʊ mǝ ŋ́ yee nyikpiiyǝ.<verse eid="GAL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 1:2" />Ŋlǝ mǝ apaanʊpǝ we kpǝlo pǝ kpii pǝ kʊla mǝ mǝ rǝ ɖǝǝnǝ yǝ la ŋʊrʊ kǝfwɛɛkǝ sa yǝ la maŋ asʊmayǝ we yǝ kpii rǝ Galatia wǝ.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Lǝh Tǝ Worokoyǝ mǝ loh Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ koonu nǝ wǝtaarǝkpǝ. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Kǝriso lǝ fǝ ŋwǝŋwǝ na wɛ lo koonu kǝ ŋ pɔrʊ lǝ rǝ loh oturɔɔrɔɔyǝ mǝrǝ, kǝ ŋ nya fɛɛ ŋ pɔrʊ lǝ rǝ rǝkǝsa lǝ ǝrǝrɔɔrɔɔkǝ sa lo okopiyǝ mǝrǝ mǝŋ kǝ́ lǝh Tǝ Worokoyǝ ŋ nǝ pǝ́ wǝ kǝtǝ. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Ŋwǝ Worokoyǝ sa ŋ kaamǝ ǝkǝkǝ kǝkpakǝkpa. Amɛnǝ.<verse eid="GAL 1:5" /></para>
  <para style="s">Dieceeceerǝ rɛ lǝǝ tǝ gbii deeri ɖǝǝnǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Worokoyǝ ŋ nǝ fǝ na lɛsiɛrɩwǝ ŋ no pwo nǝ saŋ rǝ Kǝriso. Paape wǝ le ri mǝ mumuŋ mǝ kǝ́ rǝkǝsa rǝkǝsa wǝ́ nǝ nya marǝ asiɛrɩ amaakǝ nǝ nya kaa Worokoyǝ wǝ́ nǝ nye ke siimǝ dieceeceepʊŋpwarǝ wǝ. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Kaŋfɩ we, dieceeceepʊŋpwarǝ rɛ lǝǝ tǝ gbii. Paa we, enyipǝ rɛ ko pǝ ya pǝ láa caka nǝ, wǝ́ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ siɛrɩ Kǝriso le Dieceeceerǝ we. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Paape mǝŋ nyiyǝ rɛ, wǝ ke ce wǝ ri ŋlǝ amaa picoŋpiyǝ rɛ ŋ no ru rǝ yulaarǝ ŋ na pa tɛŋ Dieceeceerǝ rɛ ŋ ne tíi nǝ, wǝ́ la cɛkɛlɛ mǝ ɖǝ we la tɛnɩ le tìi nǝ we, Worokoyǝ ŋ fwɛɛrɩ ŋwǝ. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Dierǝ sa we, le tìi nǝ rǝ lǝ pǝlǝ la tɛ̀lɩ, wǝ́ ŋ́ tǝ ŋ́ ya ŋ́ née tíi nǝ rǝ rǝkǝsa ǝkǝnǝŋ mǝŋ nyiyǝ rɛ la pa tɛŋ Dieceeceerǝ rɛ le tíi nǝ, wǝ́ la cɛkɛlɛ mǝ ɖǝ we nǝ nunu we, Worokoyǝ ŋ fwɛɛrɩ ŋwǝ.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Mǝŋ ŋ́ na tɛŋ wǝ ǝnǝ wǝǝ, o lo nuŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ anyɩmaasɩpǝ pǝ tɛɛ akaa rǝ mǝ dierǝ amaa Worokoyǝ ŋ tɛɛ akaa rǝ mǝ dierǝ? O lo nuŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ poŋ mǝ anyɩmaasɩpǝ rǝ? Kʊrakʊra, o koh nuŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ poŋ mǝ anyɩmaasɩpǝ rǝ we, ŋ́ nǝŋ ke ri Kǝriso la rɔŋyǝ.<verse eid="GAL 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Lǝh ǝtǝŋ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ ci wǝ ǝkǝnǝŋ we, Dieceeceerǝ sa ŋ́ ya ŋ́ náa tɛŋ we, lee ri anyɩmaasɩpǝ la tǝrɛ. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Duturǝ ɖi ŋ́ naa lɔ Dieceeceerǝ sa ŋ́ ru rǝ nyɩmaasɩyǝ rɛ lǝ kpǝŋ. Wǝ́ ŋkǝ nyɩmaasɩyǝ rɛ ŋ na kaŋ mǝ rǝ. Paa Yesu Kǝriso ŋ na pɔrʊ rǝ ŋ na kaŋ mǝ.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Duturǝ ɖi nǝ nyo nuŋ pǝ la wɛɛlɩ pǝ lo ru rǝ kǝ́ ŋ́ ke ŋ re mǝ wɛ mǝ ŋ fǝ mǝ eniyǝ we ŋ ka kʊla mǝ Oyudatǝpǝ la zʊmarǝ wǝ. Nǝ cii kǝ́ ŋ́ ke ŋ yi mǝ ŋ tɛɛ rǝ asʊmatǝpǝ la wǝcakukpǝ mǝ okopiyǝ, wǝ́ ŋ́ ka ŋ nyɩɩ kǝ ŋ́ nǝǝnǝ pǝ wǝ. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ŋ́ ko ŋ ko kǝnyɩŋkǝ rǝ Oyudatǝpǝ la zʊmarǝ mǝ ŋ teeri mǝ ǝtǝŋ Oyudatǝpǝ. Ŋ́ ka ŋ fia ŋpa mǝ ŋ koonu lǝh ǝtǝtǝpǝ lo wǝsuŋkpǝ.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Paape keci Worokoyǝ la saa mǝ la pɔrʊ ǝrǝ mǝ lee la lɛrǝ. Wǝ́ ŋ no pwo mǝ saŋ rǝ na lɛsiɛrɩwǝ. <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />Kǝ́ wǝ lo poŋ mǝ ŋwǝ ŋ pɔrʊ ne piyǝ ŋ kaŋ mǝ kǝ ŋ́ nya fɛɛ ŋ́ tɛŋ ne Dieceeceerǝ ŋ́ tíi epǝ we pǝ lee ri Oyudatǝpǝ we, ŋ́ noo ko ŋ́ ke tíi rɛ ŋ ci ŋ kaŋ mǝ. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Ŋ́ naa lɛ ŋ́ ko Yerusalɛmǝ ŋ ko tuu epǝ we pǝ ke ri enyikpiipǝ pǝ conu pǝ koonu mǝ wǝ. Paa wǝ́ ŋ́ kolu Arabia kǝtǝrǝceŋceŋ, wǝ́ ŋ́ sìɛnɩ ŋ pǝlǝ Damasǝko. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Cɛŋwǝ ta la kǝmaakǝ we, wǝ́ ŋ́ ci okolu Yerusalɛmǝ ŋ kolu ŋ́ cìi Kefasǝ, wǝ́ ŋ́ tini rǝ nǝ kpǝŋ juutǝ mǝ wǝtʊʊ. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ŋ́ naa nyɩŋ nyikpiipʊŋpwayǝ rɛ, we Kulǝtǝyǝ la paanʊ Yakubu ko. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Otuyǝ sa ŋ́ ya ŋ́ náa ŋʊrʊ mǝ ŋ maŋ nǝ we, Worokoyǝ cii wǝ ǝkǝnǝŋ ŋkǝ niarǝ. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Wǝla kǝmaakǝ wǝ́ ŋ́ kolu Siri mǝ Silisi la gaarǝ. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Ekǝrisotǝpǝ la acakuyǝ we rǝ Yudeya pǝ faa nyɩŋ mǝ mǝŋkǝsa pǝ tǝnǝ. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Dierǝ we pǝ lo nuŋ pǝ lo ru rǝ mǝ ko gaamǝ ǝkǝnǝŋ: «Nyiyǝ sa ŋ yili ŋ tɛɛ rǝ lǝ eniyǝ nɔ we, rǝkǝsa, ya láa tɛŋ lɔnuŋrǝ le dierǝ we ŋ kǝ ŋ pǝ́ ŋ nǝǝnǝ wǝ.» <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Wǝ́ pǝ kǝ ŋ kǝ Worokoyǝ rǝ mǝ yurǝ.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Pɔlʊ mǝ enyikpiituturupǝ we</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Cɛŋwǝ tǝ mǝ niǝ la kǝmaakǝ kpɛŋ wǝ́ ŋlǝ mǝ Banaba lo kolu Yerusalɛmǝ, wǝ́ ŋ́ rè Tito ŋwǝ ŋkpɛ ŋ́ kolu. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Ŋ́ kolu Yerusalɛmǝ duturǝ ɖi Worokoyǝ ŋ pɔrʊ wǝ ŋ kanǝ mǝ ǝkǝnǝŋ ŋmǝ ŋ́ ko. Kǝ́ ŋ́ ne ke fii we, wǝ́ ŋ́ kù mǝ zʊmarǝ lo omumuŋpǝ kpoo. Wǝ́ ŋ́ pɔ̀rʊ Dieceeceerǝ we ŋ́ ya ŋ́ náa tɛŋ mǝ ŋ tíi epǝ we pǝ lee ri Oyudatǝpǝ ŋ́ tìi pǝ. Ŋ́ yeli wǝ ǝnǝ kǝ kǝnǝnɛkǝ we ŋ́ ne yee ŋ́ na pa tɛlɩ mǝ gǝ we ŋ́ ya ŋ́ née yee rǝkǝsa kǝ paa nya fɛɛ kǝ pǝlǝ kǝ co. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Mǝ kɛrɩ Tito ri Ehelatǝpǝ paape, rɛ loo koru anyɩɩnɩ ŋwǝ ŋ kǝǝlǝ. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Paape apaanʊrɔɔrɔɔpǝ we pǝ pǝlǝ pǝ ŋwàa pǝ fii lǝh mǝrǝ kǝ pǝ nya fɛɛ pǝ ŋ wɛ lǝ we, pǝ kǝ ŋ pǝ́ Tito ŋ kǝǝlǝ. Pǝ kaŋ wɛ lǝ kǝ pǝ nyɩŋ kaanyawǝ we yǝ la nya rǝ Yesu Kǝriso lǝ kpǝŋ. Duturǝ ɖi pǝ kǝ ŋ pǝ́ la siɛrɩ le yee Oyudatǝpǝ le seyǝ la arɔŋpǝ. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Paape yǝ loo koonu enyipǝ sa la gʊŋrǝ mǝŋ jeŋceŋ, kǝ anʊkɔrǝyǝ we yǝ kpii rǝ Dieceeceerǝ we yǝ nya fɛɛ yǝ kpɛɛ sɩsiɛrɩ yǝ koonu nǝ.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Epǝ we pǝ ri zʊmarǝ lo omumuŋpǝ we, pǝ laa nyɩŋ tǝrɛ pǝ tɛŋ pǝ kʊla. Wǝ́ pǝlo kǝmumuŋkǝ we kǝ lǝǝ kǝ lǝ mǝ kpuŋkpuruŋ. Duturǝ ɖi Worokoyǝ lǝŋ yɩrɩ rǝ kǝmumuŋkǝ kǝ ŋ ci eyee tuwǝ. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Paape ŋpǝ enyipǝ sa pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ Worokoyǝ le kpii mǝ kǝnǝnɛkǝ ŋmǝ ŋ́ tɛŋ Dieceeceerǝ we ŋ́ tíi epǝ we pǝ lee ri Oyudatǝpǝ, wǝ́ ŋ ne kpii Pɛtǝro paa la kǝnǝnɛkǝ ŋ tɛŋ ɖǝ ŋ tíi Oyudatǝpǝ. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Duturǝ ɖi Worokoyǝ lǝ fǝ mǝ le yee nyikpiiyǝ lo koonu epǝ we pǝ lee ri Oyudatǝpǝ mǝŋ kǝ́ ŋ nǝ fǝ Pɛtǝro ŋ ne yee nyikpiiyǝ ŋ no koonu Oyudatǝpǝ kǝtǝ. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Yakubu, Kefasǝ mǝ Yowanɛsɩ wǝ́ pǝ kǝ ŋ fǝ pǝ ŋ yee zʊmarǝ le etiitiikpaayǝ wǝ. Pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ Worokoyǝ lǝ fǝ kǝnǝnɛkǝ rɛ kǝtǝŋkǝ le kpii mǝ rǝ akaakǝ. Wǝ́ pǝ lɔ̀ ŋlǝ mǝ Banaba la kǝtakǝ, kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ pǝ la tɛɛ akaa rǝ leh dierǝ we. Wǝ́ lo nunu awɛ lo duturǝ ǝkǝnǝŋ ŋlǝ yǝ lóo ko le ke yee anǝnɛyǝ rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ, kǝ ŋpǝ paa pǝ ŋ ko rǝ Oyudatǝpǝ lǝ kpǝŋ. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Tuwǝ ceŋceŋ pǝ pǝ̀ pǝ rù rǝ lah akaakǝ wǝ kaamǝ ŋlǝ la mǝ taalǝ pǝla zʊmarǝ la ariariatǝpǝ. Ŋ wǝ tuwǝ sa wǝ́ ŋ́ yeli sɩsiɛrɩ wǝ.<verse eid="GAL 2:10" /></para>
  <para style="s">Pɔlʊ la kpaŋ mǝ Kefasǝ rǝ Aŋtiokia</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Paape Kefasǝ yeli tǝrɛ wǝ loo ko poŋ kǝ́ ŋ pǝlǝ Aŋtiokia wǝ. Wǝ́ ŋ́ kpanǝ mǝ ŋwǝ rǝ nyi ri ŋ nyi le enimiyǝ. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Duturǝ ɖi, ke ŋ ce mǝ ŋ ri mǝ alɔnuŋtǝpǝ we pǝ lee ri Oyudatǝpǝ fɛɛwǝ ceŋceŋ. Paa kǝ́ alɔnuŋtǝpǝ we pǝ ri Oyudatǝpǝ pǝ lo ru rǝ Yakubu lǝ kpǝŋ pǝ lo po tuu pǝ we, wǝ́ ŋ pwɛ̀yɩ rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ kpǝŋ. Lǝǝ tǝ ke ŋ ri mǝ pǝ. Duturǝ ɖi ko ŋ suu Oyudatǝpǝ sa pǝ lo po tuu pǝ wǝ, kpiikǝ pǝ tɛnɩ ǝkǝnǝŋ alɔnuŋtǝpǝ we pǝ lee ri Oyudatǝpǝ pǝ kǝǝlǝ kǝto. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Apaanʊtuturupǝ we pǝ ri Oyudatǝpǝ we, ŋpǝ ŋkpɛ pǝ ke ŋ re wǝlǝrɔɔrɔɔkpǝ sa mǝŋ Pɛtǝro kǝtǝ. Ŋ wǝ wǝ pǝlǝ wǝ kòonu wǝ́ Banaba ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ sìimǝ enyipǝ sa lǝ wǝlǝkpǝ sa. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Kǝ́ ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ pǝlǝ wǝlǝkpǝ sa wǝ laa kaa mǝ anʊkɔrǝyǝ we yǝ kpii rǝ Dieceeceerǝ we we, fɛɛwǝ ŋ́ pǝlǝ ŋ́ tìi Pɛtǝro rǝ pǝlo kpǝlo le enimiyǝ ǝkǝnǝŋ: «Ŋlǝ́ Kefasǝ, Oyudatǝpǝ wǝ́ e ri. Paape e le re lá wɛ rǝ fɛɛwǝ sa mǝŋ yǝ we ŋ nee ri Oyudatǝpǝ kǝtǝ, e lee re lá wɛ mǝŋ Oyudatǝpǝ kǝtǝ. Mǝŋ o lo koru wǝ le eyee ǝnǝ wǝǝ, kǝ́ kǝto wǝ́ a ya lǝ́ǝ pǝ́ e si apaanʊpǝ sa pǝ lee ri Oyudatǝpǝ kǝ pǝ tii vɔrʊrǝ mǝŋ Oyudatǝpǝ kǝtǝ wǝ?»<verse eid="GAL 2:14" /></para>
  <para style="s">Pǝ la pɔrʊ Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ saŋ rǝ lɔnuŋrǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Ŋlǝ we, Oyudatǝpǝ wǝ́ le ri, duturǝ ɖi Oyudatǝpǝ pǝ lǝ mǝ lǝ. Yǝ lee ri epǝ we pǝ lee ci Worokoyǝ le seyǝ wǝ. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Paape le cii wǝ ǝkǝnǝŋ nyiyǝ we ŋ kʊʊ rǝ Worokoyǝ le enimiyǝ we, ŋwǝ ŋ kaamǝ yǝ we ŋ na lɔ Yesu Kǝriso ŋ no nuŋ wǝ, ŋkǝ yǝ we ŋ née yee mǝŋ saŋ rǝ Mose le seyǝ wǝ. Tuwǝ kǝto ŋla ŋkpɛ yǝ la lɔ Yesu Kǝriso yǝ lo nuŋ, kǝ la nya fɛɛ le ri enyikʊʊpǝ mǝ kǝ́ yǝ la lɔ Kǝriso yǝ lo nuŋ kǝto, ŋkǝ mǝ kǝ́ yǝ le yee yǝ la saŋ rǝ Mose le seyǝ kǝto. Duturǝ ɖi Worokoyǝ lǝŋ pa nyɩŋ rɛ nyikʊʊyǝ mǝ kǝ́ ŋ ne yee ŋ na saŋ rǝ Mose le seyǝ kpǝlo kǝto. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Wǝ́ mǝŋ ŋlǝ Oyudatǝpǝ la ya yǝ láa nyɩɩ kǝ la nya fɛɛ le ri enyikʊʊpǝ saŋ rǝ Kǝriso, wǝ́ pǝ tǝ pǝ ya pǝ láa nyɩŋ lǝ ŋla ŋkpɛ mǝŋ oturɔɔrɔɔyeetǝpǝ wǝǝ, we eniyǝ we wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Kǝriso la tɛɛ akaa rǝ turɔɔrɔɔwǝ e? Kʊrakʊra. <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Duturǝ ɖi, mǝŋ ŋ́ nǝ sǝ́ŋ Mose le seyǝ ŋ́ no co, wǝ́ ŋ́ nǝ tǝ ŋ́ ne pe yi ŋ́ ya ŋ́ née yee mǝŋ saŋ rǝ ŋwǝ seyǝ sa we, we ŋmǝŋmǝ ŋ́ ya ŋ́ náa tɔɔ mǝ wɛ la bɔrǝ. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Rǝ ŋmǝ mǝ kpǝŋ we, Mose le seyǝ sa ŋwǝŋwǝ ŋ no koonu kǝto wǝ́ ŋwǝ seyǝ ŋ nǝǝ tǝ ŋ lǝmǝ okopiyǝ rǝ mǝ wǝ. Ŋ́ ne yee wǝ ǝnǝ kǝ ŋ́ nya fɛɛ ŋ́ tii vɔrʊrǝ ŋ́ koonu Worokoyǝ. Duturǝ ɖi ŋlǝ mǝ Kǝriso yǝ lǝ́ǝ kpǝ́ rǝ kpɛtɛkpǝlɛciiwǝ. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Kǝto wǝ lǝǝ tǝ wǝ ri ŋmǝ ŋ́ kpii vɔrʊrǝ, paa Kǝriso ŋ kpii vɔrʊrǝ rǝ mǝ mǝrǝ. Duturǝ ɖi mǝ nyɩmaasɩvɔrʊrǝ sa ŋ́ lǝǝmǝ rǝkǝsa we, ŋ́ ya ŋ́ née tii rǝ saŋ rǝ kǝ́ ŋ́ na lɔ Worokoyǝ le Piyǝ ŋ́ no nuŋ wǝ, ŋwǝ yǝ we ŋ na taa mǝ kǝǝwǝ, wǝ́ ŋ nǝ kpǝ́ rǝ mǝ yurǝ wǝ. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Kǝto ŋ́ nǝŋ sǝ́ŋ Worokoyǝ la lɛsiɛrɩwǝ sa ŋ́ co. Duturǝ ɖi mǝŋ Mose le seyǝ ŋ nóo koonu oturu nyɩmaasɩyǝ la kʊʊ rǝ Worokoyǝ le enimiyǝ we, o koh turu Kǝriso lǝ pǝ kpǝ́ gbɛŋkpaakpaarǝ.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Pɔlʊ la kpamǝ Agalatiatǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Kǝ́ kǝto wǝ́ ŋnǝ Agalatiatǝpǝ nǝ nyee ci otuyǝ ǝnǝ? Amaa rɛ ŋ ne yee mǝ nǝ? Kaŋfɩ ŋ́ na pɔrʊ wǝlǝkpǝ we Yesu Kǝriso ŋ kpǝ́ rǝ kpɛtɛkpǝlɛciiwǝ ŋ́ ne tíi nǝ sɩsiɛrɩ. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ŋ́ nǝ́ǝ pǝ́ nǝ dierǝ jeŋceŋ kǝ nǝ tíi mǝ oo: Kǝ́ nǝ nye yee nǝ nya saŋ rǝ Mose le seyǝ kǝto wǝ́ Worokoyǝ ŋ no koonu nǝ Wɛɛkenikenirǝ amaa kǝ́ nǝ nyo nuŋ Dieceeceerǝ we wǝ́ nǝ nya lɔ rǝ nǝ nyo nuŋ kǝto wǝ́ ŋ no koonu nǝ rǝ wǝ? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Kǝ́ kǝto wǝ́ nǝ nyee ci otuyǝ ǝnǝ? Kǝ́ nǝ nye tie mǝ Wɛɛkenikenirǝ wǝ́ rǝkǝsa nǝ nyǝh pǝ́ nǝ kǝ tǝǝlǝ mǝ ŋnǝŋnǝ nǝ okopiyǝ? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />We otuceeceeyǝ sa kpǝlo kɩɩkɩ Wɛɛkenikenirǝ le yee lo koonu nǝ wǝǝ, otukpaakpaayǝ yǝ lǝǝwe? Ow, yǝ lǝŋ koru eri otukpaakpaayǝ kʊrakʊra. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Nǝ nyo pu wǝ ǝkǝnǝŋ kǝ́ nǝ ya nǝ nyée yee nyǝ ŋ saŋ rǝ Mose le seyǝ kǝto amaa kǝ́ nǝ nyo nuŋ Dieceeceerǝ we nǝ nya lɔ rǝ nǝ nyo nuŋ kǝto wǝ́ Worokoyǝ ŋ no koonu nǝ na Wɛɛrǝ, wǝ́ ŋ ya ŋ née yee otucovurǝ rǝ nǝ mǝrǝ wǝ?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Worokoŋtierǝ la tɛŋ lo ru rǝ Abǝrahamǝ ǝkǝnǝŋ: «Lɔ̀ Worokoyǝ nunu, wǝ́ Worokoyǝ ŋ fǝ ŋwǝ mǝŋ nyikʊʊyǝ kǝtǝ».<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 15:6">1Mo 15:6</ref></char>.</char></note> <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Kǝto wǝ kaamǝ kǝ nǝ ci wǝ ǝkǝnǝŋ epǝ we pǝ la lɔ pǝ lo nuŋ we, ŋpǝ pǝ kaamǝ Abǝrahamǝ le epilepipǝ. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Worokoŋtierǝ la tɛŋ wǝ lo coonu ǝkǝnǝŋ Worokoyǝ lah pa siɛrɩ epǝ we pǝ lee ri Oyudatǝpǝ ŋ yee enyikʊʊpǝ saŋ rǝ pǝla lɔnuŋrǝ. Tuwǝ kǝto ŋ tɛnɩ Dieceeceerǝ sa ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: «Ŋ́ náa pɛɛrɩ ǝkǝŋyǝ kpǝlo rǝ kǝtǝǝwǝ sa saŋ rǝ ló oŋuŋkǝ».<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 21:3">1Mo 21:3</ref></char>.</char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Kǝto epǝ we kpǝlo kɩɩkɩ pǝ láa lɔ Worokoyǝ pǝ nuŋ mǝŋ Abǝrahamǝ kǝtǝ we, Worokoyǝ láa pɛɛrɩ pǝ mǝŋ kǝ́ ŋ na pɛɛrɩ Abǝrahamǝ kǝtǝ.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Paa epǝ we pǝ ya pǝ lóo pu wǝ ǝkǝnǝŋ Worokoyǝ lǝh pǝ fǝ pǝ ŋ yee enyikʊʊpǝ saŋ rǝ Mose le seyǝ we, vwɛɛrɩrǝ lǝ́ǝ pǝ lǝ ŋ tuu pǝ. Duturǝ ɖi Worokoŋtierǝ la tɛŋ ǝkǝnǝŋ: «Worokoyǝ láa fwɛɛrɩ yǝ we ŋ nǝŋ yee ŋ saŋ rǝ otuyǝ we kpǝlo pǝ la ŋʊrʊ pǝ le kpii rǝ seyǝ la kǝfwɛɛkǝ sa wǝ».<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 27:26">1Mo 27:26</ref></char>.</char></note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Kǝto wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ lǝŋ pǝ fǝ nyiyǝ rɛ ŋ yee nyikʊʊyǝ mǝ kǝ́ ŋ ne yee ŋ na saŋ rǝ Mose le seyǝ kʊrakʊra. Duturǝ ɖi Worokoŋtierǝ la tɛŋ: «Yǝ we ŋ kʊʊ saŋ rǝ na lɔnuŋrǝ we, ŋwǝ ŋ née tii vɔrʊrǝ». <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Tǝrɛ wǝ lee kpii rǝ Mose le seyǝ mǝ lɔnuŋrǝ le kǝtiitiikǝ. Paa Worokoŋtierǝ la tɛŋ ǝkǝnǝŋ: «Nyiyǝ we ŋ née yee mǝ ŋ saŋ rǝ Mose le seyǝ lo otutɛŋyǝ we, lée tii vɔrʊrǝ saŋ rǝ yǝ».<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="LEV 18:5">3Mo 18:5</ref></char>.</char></note> <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Kǝriso la pa mwara wǝtookpǝ lo koonu lǝ wǝ́ ŋ na pɔrʊ lǝ ŋ no ru rǝ Mose le seyǝ sa la vwɛɛrɩrǝ we ga tɛɛ rǝ lǝ wǝ, wǝ́ ŋwǝ paa ŋ na lɔ vwɛɛrɩrǝ we ŋ na tɛɛ rǝ na wɛ ŋ no koonu lǝ. Duturǝ ɖi pǝ la ŋʊrʊ rǝ Worokoŋtierǝ ǝkǝnǝŋ: «Worokoyǝ la fwɛɛrɩ yǝ we pǝ lo toŋ golurǝ wǝ».<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="DEU 21:23">5Mo 21:23</ref></char>.</char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Tuwǝ kǝto, saŋ rǝ Yesu Kǝriso wǝ́ wǝpɛɛrɩkpǝ we Worokoyǝ ŋ no co Abǝrahamǝ la garǝ wǝ lǝ pǝ wǝ lo koonu epǝ we pǝ lee ri Oyudatǝpǝ wǝǝ. Kǝto saŋ rǝ lɔnuŋrǝ we, yǝ lóo koru alɔ Wɛɛkenikenirǝ we Worokoyǝ ŋ no co lǝ garǝ wǝ.<verse eid="GAL 3:14" /></para>
  <para style="s">Mose le seyǝ mǝ Worokoyǝ la garǝ we ŋ no co wǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Lǝh ǝtǝŋ, ŋ́ náa wɛɛlɩ ŋ́ ca mǝ vɔrʊrǝ sa le kpii lo otuyǝ kǝ nǝ nya fɛɛ nǝ nuŋ wǝlo duturǝ. Mǝŋ nyiyǝ rɛ la tɛŋ tǝrɛ lǝ tǝnǝ, wǝ́ ŋ na ŋʊrʊ wǝ ŋ nǝ tǝnǝ, wǝ́ ŋ na tɛɛ wǝ la gaapirǝ we, rɛ lee kpii ŋ nóo koru wǝ lǝ ǝsǝ́ŋ amaa ŋ nóo koru aŋʊrʊ tupʊŋpwawǝ rɛ ŋ kʊla. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Kaa wǝǝ, Worokoyǝ ŋwǝ ŋkpɛ lo co Abǝrahamǝ mǝ ne pilepi la garǝ. Worokoyǝ laa tɛŋ ǝkǝnǝŋ: «Mǝ ne epilepipǝ». Ka tɛnɩ wǝ ǝnǝ we, a kah nyɩŋ Abǝrahamǝ lǝ wǝmǝkpǝ kpǝlo wǝ́ ŋ reemǝ. Paa tɛnɩ ǝkǝnǝŋ: «Mǝ lé pilepiyǝ». Wǝ lo duturǝ wǝ ri ǝkǝnǝŋ nyiyǝ ceŋceŋ wǝ́ ŋ ke reemǝ, wǝ́ nyiyǝ we ŋ kaamǝ Kǝriso. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Tuwǝ ŋ́ nǝ pǝ́ ŋ́ tɛŋ wǝ kaamǝ ǝkǝnǝŋ: «Worokoyǝ la tɛŋ dierǝ lǝ tǝ̀nǝ wǝ́ ŋ na ŋʊrʊ rǝ ŋ nǝ tǝnǝ, wǝ́ ŋ na tɛɛ rǝ la gaapirǝ. Cɛŋwǝ tuuruniǝ mǝ tǝta la kǝmaakǝ wǝ́ Mose le seyǝ ŋ ci orù. Paape seyǝ sa lǝŋ koru ǝsǝ́ŋ rǝ. Mǝŋ seyǝ sa lo koru wǝ lǝ ǝsǝ́ŋ we, o koh turu Worokoyǝ lo co gakpaakpaarǝ wǝǝ. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Mǝŋ tuceeceewǝ we Worokoyǝ ŋ nóo koonu wǝ lóo ru rǝ Mose le seyǝ mǝrǝ we, we tuceeceewǝ sa wǝ loo ru rǝ kacowǝ. Paa Worokoyǝ pǝlǝ pɛɛrɩ Abǝrahamǝ saŋ rǝ garǝ we ŋ cò ŋwǝ wǝ.»<verse eid="GAL 3:18" /></para>
  <para style="s">Mose le Seyǝ la vasʊyǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Kǝ́ kǝto wǝ́ pǝ kpìi Mose le seyǝ wǝ? Pǝ fǝ̀ Mose le seyǝ sa pǝ kʊ̀la kǝ pǝ fǝ pǝ kaŋ enyipǝ lo otuyǝ pǝ ru rǝ turɔɔrɔɔwǝ. Ŋwǝ seyǝ sa lée yee anǝnɛyǝ ko ro eniyǝ we Abǝrahamǝ le pilepiyǝ we ŋ nǝ́ǝ pǝ wǝ. Ŋwǝ pilepiyǝ sa wǝ́ Worokoyǝ ŋ yeli kacowǝ ŋ koonu wǝ. Wǝ́ ŋwǝ seyǝ sa we, epicoŋpipǝ pǝ pǝlǝ pǝ tɛnɩ ŋwǝ saŋ rǝ nyiyǝ ceŋceŋ. Ŋwǝ nyiyǝ sa ŋ ri yǝ we ŋ kpii rǝ epicoŋpipǝ mǝ anyɩmaasɩpǝ le kǝtiitiikǝ wǝ. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Enyi eyi pǝ lǝ pǝ́ poopooyǝ wǝ. Paa rǝ kacowǝ la kǝtakǝ we, Worokoyǝ yeli wǝ ŋwǝ ceŋceŋ.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />We Mose le seyǝ le yi la tɛɛ rǝ otuyǝ we Worokoyǝ ŋ no co garǝ wǝ? Wǝ lǝǝ lǝ ǝnǝ kʊrakʊra. Mǝŋ pǝ ko koonu seyǝ rɛ ŋ nóo koonu enyipǝ la vɔrʊrǝ we, Worokoyǝ kah mǝ nyɩŋ lǝ enyikʊʊpǝ saŋ rǝ seyǝ. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Paa Worokoŋtierǝ la tɛŋ ǝkǝnǝŋ oturɔɔrɔɔyǝ lo okopiyǝ yǝ ya yǝ lée ri ǝrǝkǝ sa kpǝlo lo yurǝ. Tuwǝ kǝto wǝ kaamǝ kǝ tuwǝ we Worokoyǝ ŋ no co garǝ we, wǝ pǝ wǝ koonu alɔnuŋtǝpǝ mǝ kǝ́ pǝ la lɔ Yesu Kǝriso pǝ lo nuŋ kǝto. <verse eid="GAL 3:22" /><verse number="23" style="v" sid="GAL 3:23" />Kpɛŋ kǝ Kǝriso la lɔnuŋrǝ sa bǝ pǝ we, seyǝ lɔ̀ lǝ tanǝ kpii rǝ gukpǝ ŋ tǝnǝ, ko ro ǝrǝ eniyǝ we Worokoyǝ ŋ pɔ̀rʊ lɔnuŋrǝ sa ŋ kanǝ wǝ. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Kǝto Seyǝ sa ŋ ke ri lǝh rǝŋtǝyǝ, po ro eniyǝ we Kǝriso ŋ pǝlǝ wǝ, kǝ la nya fɛɛ le ri enyikʊʊpǝ rǝ Worokoyǝ la kǝnyɩŋkǝ saŋ rǝ lɔnuŋrǝ. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Rǝkǝsa kǝ́ Kǝriso la lɔnuŋrǝ sa le pe fii we, yǝ lǝǝ tǝ le kpii rǝ rǝŋtǝyǝ rɛ lǝ kǝnǝŋkǝ. <verse eid="GAL 3:25" /><verse number="26" style="v" sid="GAL 3:26" />Duturǝ ɖi nǝ kpǝlo kɩɩkɩ nǝ nye yee Worokoyǝ le epipǝ mǝ kǝ́ nǝ nya lɔ nǝ nyo nuŋ wǝ́ nǝ nye yee nyiceŋceŋ mǝ Kǝriso kǝto. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Awo, ŋnǝ enyipǝ we kpǝlo kɩɩkɩ pǝ le wiiri worokomɛŋwǝ we, nǝ nye yee nyiceŋceŋ mǝ Kǝriso, wǝ́ nǝ nyǝ fǝ Kǝriso nǝ nye kpii mǝŋ kǝ́ pǝ lée kpii kǝkpakǝ kǝtǝ. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Kǝto we, wǝsǝpǝkpǝ rɛ wǝ lǝǝ tǝ wǝ kpii rǝ, Yudatǝnyiyǝ mǝ yǝ we ŋ nee ri Yudatǝnyiyǝ lǝ mǝrǝ, rɔŋyǝ mǝ nyiyǝ ŋ tini ŋ koonu na wɛ lǝ mǝrǝ, pǝrǝŋyǝ mǝ tieyǝ lǝ mǝrǝ. Duturǝ ɖi nǝ kpǝlo kɩɩkɩ nǝ nye yee nyiceŋceŋ rǝ Yesu Kǝriso mǝrǝ. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Wǝ́ mǝŋ nǝ ri Kǝriso la anɛŋpǝ we, we Abǝrahamǝ lǝ wǝmǝkpǝ wǝ́ nǝ ri, we nǝ nyah pa lɔ otuyǝ we Worokoyǝ ŋ no co garǝ ŋ nǝ tǝnǝ wǝ.<note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="ROM 4:13">Oro 4:13</ref></char>.</char></note><verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s">Ǝ lǝǝ tǝ e ri rɔŋyǝ, e le yee Worokoyǝ le piyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />A lǝŋ nyɩŋ, tuwǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ tɛŋ we, wǝ kaamǝ wǝ ǝnǝ: Mǝŋ nyiyǝ we ŋ neh pe ri nǝ tǝ lo otuyǝ tǝ ri rǝ laatieyǝ we, nyiyǝ sa laa cɛkɛlɛ mǝ rɔŋyǝ. Mǝŋkǝ́ otuyǝ we kpǝlo kɩɩkɩ yǝ ri na anɛŋ paape. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Lée kpii rǝ epǝ we pǝ láa yɩrɩ no yurǝ mǝ epǝ we pǝ láa yɩrɩ no otulǝmǝyǝ we lo yurǝ lǝ kǝnǝŋkǝ, ko ro eniyǝ we nǝ tǝ ŋ nǝ tǝnǝ wǝ. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Kaa wǝǝ, ŋla ŋkpɛ we, kǝ́ lǝ kǝ lǝ mǝŋ alaatiepǝ kǝtǝ we, le ke ri arɔŋpǝ lo koonu ǝrǝkǝ la awɛɛyǝ. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Paa kǝ́ eniyǝ we Worokoyǝ ŋ nǝ tǝnǝ yǝ lo ro we, wǝ́ ŋ ne kpii ne Piyǝ ŋ na maŋ. Tieyǝ ŋ mǝnǝ ŋwǝ. Wǝ́ ŋ tini vɔrʊrǝ ŋ sanǝ rǝ Mose le seyǝ, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />kǝ ŋ nya fɛɛ ŋ pɔrʊ epǝ we pǝ kpii rǝ seyǝ we lǝ kǝnǝŋkǝ ŋ ru kǝ ŋ lɛ ŋ fǝ lǝ ŋ yee Worokoyǝ le epipǝ. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Kǝceece Worokoyǝ le epipǝ wǝ́ nǝ ri. Worokoyǝ la pɔrʊ wǝ la kaŋ saŋ rǝ kǝ́ ŋ ne kpii ne Pi la Wɛɛrǝ ŋ na maŋ rǝ lah asiɔŋyǝ. Wɛɛrǝ sa ya láa ca narǝwǝ ǝkǝnǝŋ: «Aba, mǝ Tǝ!» <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Kǝto we, ǝ lǝǝ tǝ e ri rɔŋyǝ. E ri Worokoyǝ le piyǝ. Wǝ́ kǝ́ wǝ ri ǝkǝnǝŋ ŋlǝ́ e ri ne piyǝ we, lǝ́ǝ fǝ ǝtǝtuyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ ne epipǝ we, ŋ koonu lǝ́.<verse eid="GAL 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Eniyǝ nɔ we, nǝ nyee ke ci Worokoyǝ wǝ kǝto wǝ́ nǝ sìɛrɩ nǝ yeli arɔŋpǝ nǝ kòonu otuyǝ we rǝ anʊkɔrǝyǝ yǝ laa laka kǝ pǝ sʊma wǝ. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Paa rǝkǝsa we, nǝ nye ci Worokoyǝ, amaa Worokoyǝ bomu ŋ ne ci nǝ ǝkǝnǝŋ ŋnǝ nǝ ri na anɛŋ. Wǝ lée yee nɛ kǝ nǝ tǝ nǝ koru asiɛnɩ nǝ mǝ ko awɛɛyǝ sa lǝ kpǝŋ wǝ? Yǝ lǝǝ lǝmǝ okopiyǝ rɛ, wǝ́ yǝ laa lɛ yǝ lǝmǝ vasʊyǝ rɛ! Nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ tǝ nǝ ke ri arɔŋpǝ nǝ koonu yǝ rǝ? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Kʊraa wǝ́ nǝ ya nǝ nyǝ́ǝ kpǝlǝ ecirɛɛyǝ, akɛɛnyɔŋrɛɛpǝ, enirɛɛyǝ mǝ acɛŋrɛɛyǝ! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Ŋ́ ya ŋ́ nǝ́ǝ kǝǝnǝ ǝkǝnǝŋ ŋ́ na cʊʊrʊ mǝ nǝ ŋ́ no co rǝ!<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Lǝh ǝtǝŋ nǝ dɔɔkpɛ, nǝ ru mǝ. Kpiikǝ ŋ́ na siɛrɩ ŋ́ ne yee mǝŋ ŋnǝ kǝtǝ. Nǝ nyee yee mǝ wǝrɔɔrɔɔkpǝ rɛ. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Nǝ cii wǝ ǝkǝnǝŋ mǝ nyarǝpirǝ kǝto wǝ́ ŋ́ pǝlǝ ŋ́ tɛnɩ Dieceeceerǝ we ŋ́ tìi nǝ rǝ kǝsǝsǝŋkǝ wǝ. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Mǝ nyaatǝwɛlɛŋrǝ we ŋ́ ke re we, go koru okoonu kǝ nǝ fʊʊ mǝ nǝ sǝǝlǝ amaa nǝ sǝ́ŋ mǝ nǝ co. Paape nǝ nye eyee wǝ ǝnǝ. Bomu nǝ lɔ̀ mǝ mǝŋ Worokoyǝ le picoŋpiyǝ rɛ amaa Yesu Kǝriso kǝtǝ. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Rǝ eniyǝ we we, nǝ ka ŋ nya faawǝ ŋpa! Ŋ wǝ faawǝ sa wǝ lǝ fǝ rǝ fǝŋ rǝkǝsa? Ŋmǝŋmǝ ŋ́ nóo koru eri ɖaŋsieyǝ ŋ́ koonu nǝ ǝkǝnǝŋ, rǝ eniyǝ we we, wǝ keh ri tǝrɛ pǝ lóo koru eyee we, nǝ ka pɔrʊ ne enimiyǝ kʊraa nǝ kòonu mǝ. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />We rǝkǝsa ŋ́ na siɛrɩ ŋ́ ne yee nǝ kǝǝkpǝlǝtǝyǝ mǝ kǝ́ ŋ́ na tɛŋ anʊkɔrǝyǝ ŋ́ ne tíi nǝ wǝ?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Enyipǝ sa pǝ ya pǝ lóo poŋ mǝ nǝ. Paape pǝ lǝ́ǝ tǝǝnǝ nǝ rǝ. Pǝ ya pǝ lǝ́ǝ pǝ́ pǝ waarǝ nǝ pǝ cɛ rǝ mǝ kǝ nǝ nya fɛɛ nǝ poŋ mǝ pǝ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Wǝ ponu kǝ lo poŋ mǝ enyipǝ koonu tuceeceewǝ le eyeekǝ. Wǝ kaamǝ kǝ nǝ mǝ yee wǝ eni ri ŋ ni, wǝ pee ri eniyǝ we ŋ́ kpii rǝ nǝ mǝrǝ ceŋceŋ ko wǝ́ nǝ nyeh mǝ yee wǝ wǝ. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Mǝ epipǝ, ŋ́ tǝ ŋ́ ya ŋ́ náa cʊʊrʊ rǝ nǝ yurǝ mǝŋ tieyǝ ŋ ya ŋ nóo roonu kǝtǝ, ko ro eniyǝ we Kǝriso lǝ wǝlǝkpǝ wǝ láa nyɩnɩ rǝ nǝ mǝrǝ wǝ. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />O ko turu nǝ kpǝŋ wǝ́ ŋ́ kpii rǝkǝsarǝkǝsa we, wǝ koh poŋ, ŋ́ kah wɛɛlɩ mǝ nǝ mǝ wǝlǝpʊŋpwakpǝ rɛ. Duturǝ ɖi ŋ́ nee ci kǝ́ ŋ́ neh yee ŋ́ fǝ mǝ nǝ.<verse eid="GAL 4:20" /></para>
  <para style="s">Sara mǝ Agarǝ le dierǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ŋnǝ epǝ we nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ kpii rǝ seyǝ we lǝ kǝnǝŋkǝ we, nǝ tíi mǝ! Nǝ nyaa ya nǝ nyóo nuŋ tuwǝ seyǝ we ŋ ya ŋ náa tɛŋ wǝ? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Seyǝ sa ya láa tɛŋ ǝkǝnǝŋ Abǝrahamǝ mǝnǝ ǝpǝrǝŋpipǝ eyi. Ceŋceŋ we, rɔŋyǝ ŋ mǝnǝ ŋwǝ ŋ kòonu ŋwǝ. Yitǝyǝ we, tieyǝ ŋ tini ŋ koonu na wɛ ŋ mǝnǝ ŋwǝ ŋ kòonu ŋwǝ. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Rɔŋyǝ we le piyǝ we, pǝ mǝnǝ ŋwǝ mǝŋ kǝ́ pǝ lǝ́ǝ mǝ piyǝ rǝ ko. Paa tieyǝ we ŋ tini ŋ koonu na wɛ le piyǝ we we, Worokoyǝ ŋ cò nǝ ǝmǝtǝpǝ la garǝ ŋ tǝ̀nǝ.<note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 17:16">1Mo 17:16</ref></char>.</char></note> <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />Dierǝ sa dǝ lǝǝmǝ dutunuŋpʊŋpwarǝ rɛ. Etiepǝ sa eyipǝ pǝ ri Worokoyǝ le Etieparǝtǝnǝyǝ eyi. Dieparǝtǝnǝsǝsǝŋrǝ we we, Worokoyǝ parǝ rǝ rǝ dutupirǝ we pǝ lóo pwo Sinayi lo oŋuŋkǝ. Rǝle epipǝ we lǝ́ǝ mǝ we, arɔŋpǝ wǝ́ pǝ ri. Dieparǝtǝnǝrǝ sa gaamǝ Agarǝ. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Wǝ́ Agarǝ we, kaa rǝ mǝ dutupirǝ we pǝ lóo pwo Sinayi gbii rǝ Arabia lǝ gǝŋrǝ wǝ. Ŋrǝ gaamǝ ruŋruŋ le Yerusalɛmǝ yǝ sa. Duturǝ ɖi tǝŋtǝǝwǝ sa mǝ wǝle enyipǝ kpǝlo kɩɩkɩ we, arɔŋpǝ wǝ́ pǝ ri. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Paa yulaarǝ le Yerusalɛmǝ yǝ we we, ri rǝ tǝŋtǝǝwǝ rɛ wǝ kpii wǝ koonu wǝla wɛ. Ŋ wǝ wǝ ri leh leeyǝ wǝ. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Duturǝ ɖi Wǝŋʊrʊkpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GAL 4:27">«Nya faawǝ, ŋlǝ́ tieyǝ sa ǝ lǝǝ lǝmǝ piyǝ wǝ!</para>
  <para style="q1" vid="GAL 4:27">Ca faapupuuwǝ, ŋlǝ́ yǝ o loo fuu oroonukǝ lo vuurǝ a nyɩŋ wǝ!</para>
  <para style="q1" vid="GAL 4:27">Duturǝ ɖi tieyǝ we nuŋyǝ ŋ na maa ŋ no co we, lǝh pǝ lǝmǝ epipǝ ŋ teeri</para>
  <para style="q1" vid="GAL 4:27">tieyǝ we ŋ tini mǝ nuŋyǝ wǝ».<verse eid="GAL 4:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="GAL 4:28" />Lǝh ǝtǝŋ, ŋnǝ we, nǝ lǝ rǝ mǝŋ Isakǝ kǝtǝ! Worokoyǝ la garǝ we ŋ cò le epipǝ wǝ́ nǝ ri. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Eniyǝ nɔ we, piyǝ we pǝ mǝnǝ mǝŋ kǝ́ pǝ lǝ́ǝ mǝ piyǝ rǝ ko we, yili tɛ̀ɛ rǝ piyǝ we pǝ mǝnǝ saŋ rǝ Worokoyǝ la Wɛɛrǝ wǝ. Kǝ́ wǝ tǝ wǝ lǝ ruŋruŋ le jirǝ sa wǝǝ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Paape kǝ́ wǝ́ Wǝŋʊrʊkpǝ we wǝ la tɛŋ? Wǝ la tɛŋ ǝkǝnǝŋ: «Piri rɔŋyǝ we mǝ ne piyǝ a pwɛyɩ! Duturǝ ɖi rɔŋyǝ le piyǝ lee kpii ŋ née ri ǝtǝtuyǝ ŋ kʊla mǝ tieyǝ we ŋ tini ŋ koonu na wɛ le piyǝ.»<note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 21:10">1Mo 21:10</ref></char>.</char></note> <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Kǝto we, lǝh ǝtǝŋ, yǝ lee ri rɔŋyǝ le epipǝ, tieyǝ we ŋ tini ŋ koonu na wɛ le epipǝ wǝ́ le ri.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Ci lé diiwɛɛrǝ le ere</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Kǝriso la pɔrʊ lǝ lo ru, kǝ la nya fɛɛ le tii la wɛɛ kǝceece. Kǝto we lǝh ǝtǝŋ, nǝ tɔ nǝ yaa! Nǝ poo kuŋ kǝ rɛ ŋ tǝ fǝ nǝ ŋ yee arɔŋpǝ.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Nǝ nuŋ! Ŋmǝ Pɔlʊ ŋ́ ya ŋ́ née tíi nǝ wǝ ǝkǝnǝŋ: Vǝ́ nǝ nya maa pǝ lǝ kǝǝlǝ nǝ we, we Kǝriso lo tuwǝ we ŋ ne yee rǝ nǝ yurǝ we, wǝ lǝǝ tǝ wǝ lǝmǝ vasʊyǝ rɛ wǝ koonu nǝ oo. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Ŋ́ tǝ ŋ́ ya ŋ́ náa tɛŋ wǝ ǝkǝnǝŋ pǝrǝŋyǝ le yǝ we ŋ náa maa pǝ kǝǝlǝ ŋwǝ we, wǝ kpii kǝ ŋ yee ŋ saŋ rǝ seyǝ we kpǝlo kɩɩkɩ ŋ ko to rǝ! <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Ŋnǝ epǝ we nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ ri enyikʊʊpǝ rǝ Worokoyǝ le enimiyǝ saŋ rǝ seyǝ we we, nǝ nya waarǝ rǝ Kǝriso. Nǝ nya siɛrɩ amaakǝ nǝ nya kaa Worokoyǝ la lɛsiɛrɩwǝ. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ŋlǝ paa we, yǝ la lɔ yǝ lo nuŋ wǝ́ yǝ la tɛɛ kpɛɛwǝ ǝkǝnǝŋ Worokoyǝ lǝ́ǝ fǝ lǝ ŋ yee enyikʊʊpǝ rǝ na kǝnyɩŋkǝ. Tuwǝ la ya yǝ lǝ́ǝ rǝŋ saŋ rǝ Wɛɛkenikenirǝ wǝǝ. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Duturǝ ɖi yǝ we ŋ ne yee nyiceŋceŋ mǝ Yesu Kǝriso we, pǝ kǝǝlǝ ŋwǝ oo, pǝ lǝǝ kǝǝlǝ ŋwǝ oo, wǝ lee ri tǝrɛ mǝ ŋwǝ. Tuwǝ wǝ lǝ ŋwǝ kpuŋkpuruŋ we, wǝ kaamǝ lɔnuŋrǝ. Lɔnuŋrǝ sa lóo koonu lǝ kǝ la taa awɛ lǝ kǝǝwǝ wǝ.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Kaŋfɩ nǝ tìe sɩsiɛrɩ! Ǝlǝ ŋ nǝ pǝ sǝŋ nǝ gʊŋrǝ wǝ́ ŋ nǝ sǝ́ŋ ŋ no koonu nǝ nǝ pǝǝ tǝ nǝ siimǝ anʊkɔrǝyǝ we wǝ? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Tuwǝ we pǝ le ke tíi nǝ wǝ́ pǝ la siɛrɩ no oyupuyǝ we, wǝ loo ru rǝ Worokoyǝ we ŋ no pwo nǝ lǝ kpǝŋ. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Pǝ la ca duturǝ ǝkǝnǝŋ: «Dafaŋrǝ ŋɩnɩŋɩnɩ ko lóo kuŋ fuŋtufuruwǝ kpǝlo kɩɩkɩ wǝ ŋ fuunu». <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Paape rǝ Kulǝtǝyǝ lo yurǝ kǝto we, ŋ́ na tɛɛ kpɛɛwǝ rǝ nǝ ǝkǝnǝŋ nǝ oyupuyǝ yǝ lǝŋ cɛkɛlɛ mǝ mǝ anɛŋyǝ. Paa yǝ we ŋ ya ŋ náa siɛrɩ nǝ yupurǝ we, ŋ ke ce ŋ ri rǝ kǝ́ oo, Worokoyǝ lah pa ta no kǝtukoŋkǝ taa.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Lǝh ǝtǝŋ, ŋmǝ paa we, mǝŋ wǝ keh ri ŋ́ tǝ ŋ́ re ŋ́ yaa ŋ́ náa tɛŋ Worokoŋtierǝ ǝkǝnǝŋ wǝ kpii kǝ enyipǝ pǝ kǝǝlǝ we, rɛ lǝŋ kǝ tǝ ŋ yi ŋ tɛɛ rǝ mǝ. A kah nyɩŋ Kǝriso yǝ sa ŋ nǝ kpǝ́ rǝ kpɛtɛkpǝlɛciiwǝ le dierǝ ŋ́ ya ŋ́ náa tɛŋ lǝŋ ka kpara rɛ! <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Epǝ we pǝ ya pǝ láa siɛrɩ nǝ oyupuyǝ we, pǝ ko mumu pǝ waarǝ pǝla wɛ la wǝkʊŋkpǝ kǝ wǝ lɛ ee! <verse eid="GAL 5:12" /><verse number="13" style="v" sid="GAL 5:13" />Ŋnǝ paa we, lǝh ǝtǝŋ, pǝ lo pwo nǝ pǝ lo koonu diiwɛɛrǝ. Paa ŋkǝ kǝ́ nǝ nya nya diiwɛɛrǝ sa kǝto kǝ wǝ yee tucɛtɛɛwǝ wǝ koonu nǝ, kǝ nǝ mǝ yee rǝ wɛlɛŋrǝ lo otucakpɛɛyǝ oo! Paa we, nǝ fǝ kǝǝtaawǝ nǝ sʊma awɛ. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Duturǝ ɖi dierǝ sa jeŋceŋ la ca Mose le seyǝ we kpǝlo kɩɩkɩ la gʊʊrǝ ǝkǝnǝŋ: «Taa lá kɛrɩyǝ lǝ kǝǝwǝ mǝŋ lá wɛ kǝtǝ»<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="LEV 19:18">3Mo 19:18</ref></char>.</char></note>. <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Wǝ́ paa mǝŋ nǝ nyóo roonu awɛ, nǝ nyáa laarǝ awɛ mǝŋ apɔɔkɛɛpǝ kǝtǝ we, nǝ yee yurǝ! Nǝ nyǝ́ǝ nǝǝnǝ awɛ.<verse eid="GAL 5:15" /></para>
  <para style="s">Nǝ maa Wɛɛkenikenirǝ ɖe nǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Dierǝ ŋ́ ya ŋ́ née tíi nǝ gaamǝ ɖǝ ǝnǝ: Nǝ maa Wɛɛkenikenirǝ ɖe nǝ vɔrʊrǝ. Mǝŋkǝsa we, nǝ nyǝŋ pe siimǝ nǝ wɛlɛŋrǝ lo otucakpɛɛyǝ. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Duturǝ ɖi lah wɛlɛŋrǝ lo otucakpɛɛyǝ sa we, yǝ le yi yǝ la tɛɛ rǝ Wɛɛkenikenirǝ la anɛŋyǝ. Wǝ́ Wɛɛkenikenirǝ lo otucakpɛɛyǝ yǝ le yi yǝ la tɛɛ rǝ wɛlɛŋrǝ la anɛŋyǝ. Yǝle kpee wǝle yi yǝ le yi yǝ la tɛɛ rǝ awɛ. Ŋ wǝ kǝto nǝ nyǝŋ koru eyee tuwǝ we nǝ ya nǝ nyǝ́ǝ pǝ́ wǝ. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Paa mǝŋ Wɛɛkenikenirǝ ɖe nǝ we, nǝ nyǝŋ tǝ nǝ kpii rǝ seyǝ lǝ kǝnǝŋkǝ. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Wɛlɛŋrǝ lo otucakpɛɛyǝ yǝ láa nyɩnɩ yǝ ŋ ci. Ŋyǝ yǝ kaamǝ: nuŋruwǝ, kǝtienaakǝ amaa vuuyɩɩrǝ, vɔrʊrɔɔrɔɔrǝ, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />vɛɛsʊmarǝ, kǝcokǝ, kǝǝkpǝlǝwǝ, akpaŋyǝ, wǝtɛlɩkpǝ, kpɛɛmʊrʊwǝ, mǝ nɛŋwǝ ko wǝ poŋ, wǝsǝpǝkpǝ, dutuloonuŋrǝ, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />nimimwɛɛrɩwǝ, ǝfǝŋpiemupǝ, erikpaakǝ, mǝ otupʊŋpwayǝ yǝ lo ru ǝyǝ wǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ mǝ ŋ tǝnǝ, mǝŋ kǝ́ ŋ́ nǝ sǝŋ tíi nǝ wǝ ŋ́ na pa tɛlɩ kǝtǝ ǝkǝnǝŋ: «Epǝ we pǝ lée yee otuyǝ sa wǝrʊʊkpǝ we, pǝ lǝŋ pa ka nya kǝtiikǝ rǝ Worokoyǝ le wǝpilirikpǝ we lǝ mǝrǝ». <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />Paa Wɛɛkenikenirǝ lǝ dǝnǝrǝ gaamǝ ǝyǝ ǝnǝ: Kǝǝtaawǝ, faawǝ, wǝtaarǝkpǝ, lɛtaarǝwǝ, wǝceeceeyeekpǝ, wǝpoŋkpǝ, anʊkɔrǝyǝ, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />wǝlǝtaarǝkpǝ, wɛɛtarewǝ. Seyǝ lǝǝ sǝ́ŋ otuyǝ sa la rɛ! <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Epǝ we pǝ ri Yesu Kǝriso la anɛŋpǝ we, pǝ la kpaa pǝla wɛlɛŋrǝ mǝ rǝlo otucakpɛɛkpookpookpooyǝ we pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Mǝŋ Wɛɛkenikenirǝ lo koonu lǝ vɔrʊrǝ we, kǝ la maa ŋrǝ ŋkpɛ ɖe lah vɔrʊrǝ. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />La paa mǝ rɛɛrɩ mǝ lah wɛ! Kǝwɛɛlɩkǝ rɛ kǝ pee kpii rǝ lǝh mǝrǝ! Rɛ ŋ pee yee awɛ la wǝtɛlɩkpǝ!<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Nǝ toŋ awɛ rǝ gbaraarǝ lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Lǝh ǝtǝŋ, mǝŋ nǝ nyo ko ru rǝ rɛ ya lée yee turɔɔrɔɔwǝ we, ŋnǝ epǝ we Worokoyǝ la Wɛɛrǝ ɖe we, nǝ fǝ lɛtaarǝwǝ nǝ kʊʊrʊ ŋwǝ. Paa ŋnǝ ŋkpɛ nǝ yee yurǝ, kǝ nǝ rɛ ŋ paa pa tɔɔ turɔɔrɔɔwǝ mǝrǝ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Nǝ cʊʊrʊ nǝ toŋ awɛ. Mǝŋkǝsa we, o lóo turu nǝ nye yee nya saŋ rǝ Kǝriso le seyǝ <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Mǝŋ rɛ ya láa nyɩŋ ǝkǝnǝŋ ŋwǝ ŋ no ru okuruyǝ, paa rǝ anʊkɔrǝyǝ lee ri tǝrɛ we, ŋwǝŋwǝ ya lǝ́ǝ tǝǝnǝ na wɛ rǝ! <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Nyi ri ŋ nyi ŋ tǝnǝ nimirǝ ŋ yɩrɩ ŋwǝŋwǝ no otuyeeyǝ. Mǝŋ la nyɩŋ yǝ ponu we, we ŋ nya faawǝ ŋ koonu na wɛ ceŋceŋ! Ŋ pǝǝ fǝ na wɛ ŋ ca mǝ nyipʊŋpwayǝ rɛ. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Duturǝ ɖi nyi ri ŋ nyi leh pe re ŋwǝŋwǝ ne eleeyǝ.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Ŋlǝ́ yǝ we pǝ ya pǝ láa kaŋ otuyǝ pǝ ŋ ru rǝ Worokoyǝ le dierǝ we, wǝ kpii kǝ ǝ sǝpǝ ló otuceeceeyǝ kpǝlo kɩɩkɩ ŋnǝ mǝ yǝ we ŋ ya ŋ náa kaŋ lǝ́ otuyǝ wǝ.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Nǝ pǝǝ tǝǝnǝ nǝ wɛ! Pǝ lǝŋ kpii Worokoyǝ le kǝyepukǝ. Tuwǝ we nyiyǝ ŋ na rʊʊ we, ŋ wǝ wǝ́ ŋ náa lɛ. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Yǝ we ŋ na rʊʊ tuwǝ koonu wɛlɛŋrǝ lo otucakpɛɛyǝ we, tuwǝ ŋ nah pa lɛ wǝ kaamǝ gbɛŋrǝ. Paa yǝ we ŋ na rʊʊ tuwǝ koonu Wɛɛkenikenirǝ la kpɛɛcawǝ we, tuwǝ ŋ nah pa lɛ wǝ kaamǝ vɔrʊlaalɛɛrǝ. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />La paa faŋ mǝ tuceeceewǝ le eyeekǝ. Duturǝ ɖi mǝŋ yǝ lee kpii wɛɛyɔɔwǝ we, vǝ́ eniyǝ yǝ lo ro we, yǝ lah pa lɛ otuyǝ. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Kǝto we, kǝ́ wǝ ri yǝ lǝ́ǝ tǝ yǝ ŋ nya kʊŋwǝ we, nǝ pǝ kǝ le mǝ yee nyi ri ŋ nyi le wǝceeceekpǝ, otukpǝlo lǝh ǝtǝŋ alɔnuŋtǝpǝ.<verse eid="GAL 6:10" /></para>
  <para style="s">Ecikaŋtuturukǝ mǝ Eceenikǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Nǝ yɩrɩ wǝŋʊrʊpikɔɔrʊkɔɔrʊkpǝ sa re! Ŋmǝŋmǝ ŋ́ nǝ fǝ mǝ akaakǝ ŋ́ ya ŋ́ náa ŋʊrʊ mǝ ŋ maŋ nǝ. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Epǝ we pǝ ya pǝ láa nyɩɩ mǝ nǝ ǝkǝnǝŋ ŋnǝ nǝ kǝǝlǝ we, pǝ ya pǝ lǝ́ǝ pǝ́ pǝ poŋ rǝ enyipǝ le enimiyǝ rǝ. Pǝ ya pǝ lée yee wǝ ǝnǝ, kǝ rɛ ŋ pee yi ŋ tɛɛ rǝ pǝ rǝ Kǝriso la kpɛtɛkpǝlɛciiwǝ sa kǝto. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Duturǝ ɖi ŋpǝ enyipǝ sa pǝ lǝ́ǝ kǝǝlǝ we, ŋpǝŋpǝ pǝ laa ya pǝ lée yee pǝ ŋ saŋ rǝ seyǝ. Paape pǝ ya pǝ lǝ́ǝ pǝ́ nǝ kǝǝlǝ, kǝ pǝ fǝ wǝ pǝ ŋ kǝ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ la nyɩɩ mǝ nǝ wǝ́ nǝ nya lɔ barǝ sa rǝ wɛlɛŋrǝ. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ŋmǝ paa we, ŋ́ nǝŋ pǝ́ ŋ́ kǝ mǝ wɛ rǝ tǝrɛ ŋ́ teeri loh Kulǝtǝyǝ Yesu Kǝriso la kpɛtɛkpǝlɛciiwǝ ceŋceŋ ko. Kpɛtɛkpǝlɛciiwǝ sa kǝto we, ǝrǝkǝ lo otuyǝ yǝ le yee otukpǝ́yǝ rǝ mǝ enimiyǝ. Wǝ́ ŋmǝ ŋkpɛ ŋ́ na siɛrɩ ŋ́ ne yee tukpǝ́wǝ ŋ́ no koonu ǝrǝkǝ. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Kǝto we, rɛ kǝǝlǝ oo, rɛ lǝǝ kǝǝlǝ oo, wǝ lǝǝ lǝ kpuŋkpuruŋ! Tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ kaamǝ ǝkǝnǝŋ Worokoyǝ ŋ fǝ lǝ ŋ yee enyiŋwɛŋpǝ. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Epǝ we kpǝlo kɩɩkɩ pǝ siimǝ cawǝ sa ǝnǝ we, Worokoyǝ ŋ koonu pǝ la wǝtaarǝkpǝ, kǝ ŋ yee pǝ le wǝceeceekpǝ. Ŋ lɛ ŋ yee wǝ mǝŋkǝsa ŋ koonu Worokoyǝ lǝ kǝkpǝŋkǝ kpǝlo kɩɩkɩ.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Fǝ rǝkǝsa mǝ ko we, rɛ ŋ pǝǝ tǝ ŋ kpara mǝ. Duturǝ ɖi akpɛɛpǝ sa pǝ tɛɛ mǝ rǝ wɛlɛŋrǝ we, pǝ ya pǝ láa kaŋ ǝkǝnǝŋ ŋmǝ ŋ́ na cʊʊrʊ ŋ́ no koonu Yesu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Lǝh ǝtǝŋ, loh Kulǝtǝyǝ Yesu Kǝriso ŋ yee nǝ lɛsiɛrɩwǝ! Amɛnǝ.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>