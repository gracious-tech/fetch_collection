<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">1 Pɛtǝro</para>
  <para style="toc3">1Pɛ</para>
  <para style="toc2">1 Pɛtǝro</para>
  <para style="toc1">Pɛtǝro la kǝfwɛɛsǝsǝŋkǝ</para>
  <para style="mt1">Pɛtǝro</para>
  <para style="mt2">la kǝfwɛɛsǝsǝŋkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɛtǝro la ŋʊrʊ kǝfwɛɛkǝ sa la maŋ Worokoyǝ lǝ kǝkpǝŋkǝ we ŋ na saa ŋ na pɔrʊ wǝ́ pǝ la caŋ awɛ wǝ́ pǝ le yee ǝsǝǝpǝ pǝ kpii rǝ Pɔŋto la gaarǝ, Galatia la gaarǝ, Kapadɔ la gaarǝ, Azi la gaarǝ mǝ Bitini la gaarǝ wǝ (<char style="xt"><ref loc="1PE 1:1">1:1</ref></char>). Ekǝrisotǝpǝ sa we, pǝ ke kpii rǝ acʊcʊʊrʊyǝ mǝrǝ ŋpa mǝ kǝ́ pǝ la lɔ Yesu pǝ lo nuŋ kǝto. Pɛtǝro la ŋʊrʊ kǝfwɛɛkǝ sa la maŋ pǝ kǝ ŋ fǝ ŋ kpii pǝla wɛɛlɛŋwǝ rǝ lɔnuŋrǝ. Tǝ ya lée kpii pǝla wɛɛlɛŋwǝ koonu pǝlǝ ǝrǝŋkǝ rǝ Kulǝtǝyǝ Yesu la asiɛnɩpǝkǝ, kǝ pǝ lɛ pǝ tii vɔrʊrǝ láa pɔrʊ gaŋ ǝkǝnǝŋ pǝ ri Worokoyǝ lǝ kǝkpǝŋkǝ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-2</para>
  <para style="io">- Vɔrʊŋwɛŋrǝ rǝ Worokoyǝ mǝrǝ 1:3-12</para>
  <para style="io">- Ecikaŋkǝ ru rǝ vɔrʊkenikenirǝ le etiikǝ 1:13–2:10</para>
  <para style="io">- Kǝrisotǝpiyǝ la anyɩɩkǝ rǝ acʊcʊʊrʊyǝ mǝrǝ wǝ 2:11–4:19</para>
  <para style="io">- Kǝrisotǝyǝ la wɛɛpɛɛlɩwǝ 5:1-11</para>
  <para style="io">- Eceenituturukǝ 5:12-14</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Ŋmǝ Pɛtǝro ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa. Yesu Kǝriso le nyikpiiyǝ wǝ́ ŋ́ ri. Ŋ́ ya ŋ́ náa ŋʊrʊ kǝ ŋ́ mǝ ŋ maŋ epǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ wǝ́ pǝ la caŋ awɛ pǝ le yee ǝsǝǝpǝ pǝ kpii rǝ Pɔŋto la gaarǝ, Galatia la gaarǝ, Kapadɔ la gaarǝ, Azi la gaarǝ mǝ Bitini la gaarǝ wǝ. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />Worokoyǝ we ŋ ri Tǝyǝ la saa nǝ lo coonu mǝŋ kǝ́ ŋ yeli no yupurǝ ŋ tǝ̀nǝ wǝ. Na Wɛɛrǝ lǝ fǝ nǝ le yee kǝkpǝŋkǝ rɛ kǝ lǝ kenikeni, kǝ nǝ nya fɛɛ nǝ co kǝtukoŋkǝ rǝ Yesu Kǝriso, kǝ ŋ lɛ ŋ fǝ na ŋpǝrayǝ we ŋ wɛɛ nǝ. Worokoyǝ ŋ yee nǝ lɛsiɛrɩwǝ kǝ ŋ koonu nǝ wǝtaarǝkpǝ ŋpa!<verse eid="1PE 1:2" /></para>
  <para style="s">Worokoyǝ lo koonu lǝ vɔrʊŋwɛŋrǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Kǝ lǝ kǝ Worokoyǝ, loh Kulǝtǝyǝ Yesu Kǝriso lǝ Tǝyǝ! La nyɩŋ lǝ tǝlarǝmumuŋwǝ rɛ wǝ́ ŋ no koonu lǝ vɔrʊŋwɛŋrǝ mǝ kǝ́ ŋ na saanǝ Yesu Kǝriso ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ. Mǝŋkǝsa we, kǝ la nya fɛɛ la nya kpɛɛtɛɛpoŋpiwǝ, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />lǝ mǝ rǝŋ ǝtǝtuyǝ we Worokoyǝ ŋ na kʊʊ ŋ nǝ tǝnǝ na anɛŋpǝ wǝ. Ǝtǝtuyǝ sa we, yǝ lǝŋ pǝlǝ, yǝ lǝŋ cɩɩ wǝ́ yǝ lǝŋ lɛ yǝ riaka. Worokoyǝ lǝ tǝnǝ nǝ yǝ rǝ yulaarǝ. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />Ŋnǝ epǝ we nǝ nya lɔ nǝ nyo nuŋ we, Worokoyǝ lǝ kǝrǝŋ nǝ mǝ no okopiyǝ kǝ ŋ nya fɛɛ ŋ pa lɔ ŋ koonu nǝ. Worokoyǝ la kpaka tini rǝ, kǝ ŋ pɔrʊ alɔkuŋkǝ sa ŋ kaŋ mǝ jitutururǝ. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />Tuwǝ sa kǝto we, nǝ mǝ nya faawǝ ŋpa, wǝ ke ce wǝ ri ǝkǝnǝŋ acʊcʊʊrʊyǝ kpookpoo yǝ lóo kuŋ kǝ nǝ fii gʊʊpirǝ rǝkǝsa koonu enipiyǝ rɛ wǝ. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />Acʊcʊʊrʊyǝ sa yǝ láa pɔrʊ yǝ kaŋ ǝkǝnǝŋ ŋnǝ nǝ lǝǝmǝ lɔnuŋpoŋpirǝ. Duturǝ ɖi sɩkamwɛɛrɩyǝ lǝ́ǝ pǝ mǝ ŋ pǝlǝ paape pǝ lée kpii ŋwǝ rǝ naawǝ kǝ pǝ nyɩŋ mǝŋ sɩkapoŋpiyǝ ŋ lǝǝwe wǝ. Kǝ́ wǝ lǝ wǝ koonu nǝ lɔnuŋrǝ wǝǝ. Lo ru okuruyǝ le teeri sɩkamwɛɛrɩyǝ ŋpa, paape pǝ lée tie rǝ pǝ yɩrɩ kǝ pǝ nya fɛɛ pǝ nyɩŋ mǝŋ lɔnuŋpoŋpirǝ lǝǝwe wǝ. Mǝŋkǝsa we, jirǝ we Yesu Kǝriso ŋ noh po ru we, Worokoyǝ lǝ́ǝ kǝ nǝ, láa rɛɛrɩ mǝ nǝ, kǝ ŋ kpii nǝ nimifiiwǝ. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Nǝ nyaa nyɩŋ ŋwǝ paape nǝ nyáa taa nǝ kǝǝwǝ. Nǝ nyaa ya nǝ nyáa nyɩŋ ŋwǝ rǝkǝsa paape nǝ nya lɔ ŋwǝ nǝ nyo nuŋ. Wǝ kǝto nǝ nya nya faamumuŋwǝ rɛ wǝlǝ kǝtǝŋkǝ wǝ lee kpii wǝǝ, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />kpiikǝ nǝ nya nya alɔkuŋkǝ kǝto. Ŋkǝ alɔkuŋkǝ sa kǝ ri nǝ wǝtoomwarakpǝ mǝ kǝ́ nǝ nya lɔ Yesu Kǝriso nǝ nyo nuŋ wǝ. <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />Oworokokpɛɛnuŋtɛŋtǝpǝ pǝ lo kooru pǝ la taa ŋpa kǝ pǝ ci tu ri ŋ tu sɩsiɛrɩ pǝ ru rǝ alɔkuŋkǝ sa. Pǝ la wɛɛlɩ pǝ lo ru rǝ alɔkuŋkǝ sa mǝŋ tukoonuwǝ rɛ Worokoyǝ ŋ kpàka ŋ tǝ̀nǝ nǝ wǝ. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />Kǝriso la Wɛɛrǝ ge kpii rǝ pǝ. Wǝ́ dɛnɩ acʊcʊʊrʊyǝ we Kǝriso ŋ nah pa nyɩŋ mǝ otumumuŋkpatɩyǝ we yǝ lah pa tɛɛmǝ yǝ dǝ̀nǝ. Oworokokpɛɛnuŋtɛŋtǝpǝ sa pǝ ka ŋ nyɩɩ kǝ pǝ ci eniyǝ otuyǝ sa yǝ lǝ́ǝ pǝ, mǝ wǝlǝkpǝ yǝ lǝ́ǝ pǝ yǝ fǝ wǝ. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Worokoyǝ pɔ̀rʊ kanǝ akpɛɛnuŋtɛŋtǝpǝ sa ǝkǝnǝŋ dierǝ sa pǝ ka ŋ tɛŋ we, pǝ laa ka ŋ tɛŋ rǝ pǝ ŋ tǝnǝ pǝla wɛ, paa ŋnǝ wǝ́ pǝ ke ŋ yee kǝnǝnɛkǝ sa pǝ ŋ koonu. Duturǝ ɖi rǝkǝsa we, epǝ we pǝ láa tɛŋ Dieceeceerǝ we we, pǝ la tɛŋ otuyǝ sa pǝ le tíi nǝ. Wɛɛkenikenirǝ we Worokoyǝ ŋ ne kpii rǝ yulaarǝ ŋ na maŋ lo okopiyǝ wǝ́ pǝ lǝ fǝ pǝ la tɛŋ dierǝ sa. Dierǝ sa we, epicoŋpipǝ ŋpǝŋpǝ kʊraa wǝ láa ca pǝla kpɛɛwǝ ŋpa pǝ kpii nimirǝ rǝ rǝ.<verse eid="1PE 1:12" /></para>
  <para style="s">Worokoyǝ lo pwo lǝ le pe tii vɔrʊkenikenirǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Kǝto we, nǝ kpaka nǝ tii! Nǝ fǝ nǝ ǝrǝŋkǝ kpǝlo kɩɩkɩ nǝ kpii rǝ lɛsiɛrɩwǝ we Worokoyǝ ŋ neh pǝ yee nǝ mǝ jirǝ we Yesu Kǝriso ŋ noh po ru wǝ. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />Mǝŋ epipǝ pǝ lóo co kǝtukoŋkǝ rǝ Worokoyǝ kǝtǝ we, nǝ pee tii vɔrʊrǝ nǝ kaamǝ otucakpɛɛyǝ we yǝ ke kpii rǝ nǝ eniyǝ nɔ, kǝ́ nǝ faa ka maa nǝ ci Dieceeceerǝ we wǝ. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />Paa nǝ re nǝ wɛ kenikeni rǝ nǝ wǝkparǝtǝnǝkpǝ kpǝlo kɩɩkɩ mǝŋ kǝ́ Worokoyǝ we ŋ no pwo nǝ ŋ lǝ kenikeni kǝtǝ. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Kpiikǝ Worokoyǝ la tɛŋ rǝ Wǝŋʊrʊkenikenikpǝ mǝrǝ ǝkǝnǝŋ: «Wǝ kpii kǝ nǝ lǝ kenikeni kpiikǝ ŋmǝ we, ŋ́ lǝ kenikeni». <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />Mǝŋ rǝ nǝ onyuŋmwɛŋyǝ mǝrǝ, nǝ nyóo pwo Worokoyǝ ǝkǝnǝŋ Tǝyǝ, ŋwǝ yǝ we ŋ nǝŋ yɩrɩ rǝ anyɩŋkǝ, ǝkǝ ŋ náa tɛŋ wǝkpaŋkpǝ mǝ ŋ saŋ rǝ nyi ri ŋ nyi lo tuwǝ ŋ ne yee we, we nǝ re nǝ wɛ mǝ vusuurǝ rǝ Worokoyǝ la kǝnyɩŋkǝ rǝ nǝ vɔrʊrǝ le eciyǝ rǝ kǝtǝǝwǝ sa. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />Nǝ kàrǝ nǝ ǝtǝtǝpǝ la vɔrʊkpaakpaarǝ we lǝ wǝlǝkpǝ. Wǝ́ nǝ cii wǝ ǝkǝnǝŋ Worokoyǝ lǝ fǝ okurumumuŋyǝ rɛ la pɔrʊ nǝ lo ru rǝ wǝlǝkpǝ sa mǝrǝ. Ŋkǝ otuyǝ yǝ lǝ́ǝ pǝlǝ, mǝŋ sɩkakpɛɛlɩyǝ amaa sɩkamwɛɛrɩyǝ wǝ́ ŋ nǝ fǝ ŋ na pɔrʊ nǝ, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />paa saŋ rǝ Kǝriso la ŋpǝrayǝ we ŋ no ru okuruyǝ wǝ. Kǝriso lǝ fǝ na wɛ le yee otoolukǝ mǝŋ mɛɛpirǝ lo to milimili pǝ lǝ fǝ pǝ lo toolu kǝtǝ. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />Worokoyǝ sàa ŋwǝ tǝ̀nǝ kpɛŋ wǝ́ ŋ ci ocò ǝrǝkǝ. Wǝ́ ŋ na pɔrʊ ŋwǝ ŋ na kaŋ rǝ enituturuyǝ sa mǝrǝ rǝ nǝ yurǝ kǝto. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />Ŋwǝ Kǝriso yǝ sa ŋ no koonu wǝ́ nǝ nya lɔ Worokoyǝ nǝ nyo nuŋ. Worokoyǝ ŋ na saanǝ ŋwǝ ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ, wǝ́ ŋ na lɛ ŋ na rɛɛrɩ mǝ ŋwǝ rǝ oŋuŋkǝ ŋpa. Wǝ kǝto nǝ nya lɔ Worokoyǝ nǝ nyo nuŋ wǝ́ nǝ nya tɛɛ kpɛɛwǝ rǝ ŋwǝ wǝǝ.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Kǝ́ nǝ nyo co kǝtukoŋkǝ rǝ anʊkɔrǝyǝ sa we, nǝ nye wiiri nǝ wɛ, kǝ nǝ nya fɛɛ nǝ fǝ kǝǝtaapoŋpiwǝ nǝ taa nǝ ǝtǝŋ alɔnuŋtǝpǝ lǝ kǝǝwǝ. Kǝto we, nǝ fǝ nǝ ziɔŋrǝ fee nǝ taa awɛ lǝ kǝǝwǝ ŋpa. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />Pǝ lǝ kpǝlǝŋ pǝ lǝ mǝ nǝ, ŋkǝ nyɩmaasɩyǝ sa ŋ nǝ́ǝ kpǝ́ ŋ nǝ kpǝlǝŋ ŋ nǝ mǝ nǝ. Paa Worokoyǝ we ŋ nǝŋ kpǝ́ ŋ nǝ kpǝlǝŋ ŋ nǝ mǝ nǝ saŋ rǝ ne dierǝ we gbii vɔrʊrǝ, wǝ́ gbii kǝkpakǝkpa wǝ. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1PE 1:24">«Anyɩmaasɩpǝ kpǝlo kɩɩkɩ pǝ lǝ rǝ mǝŋ bɔɔrǝ kǝtǝ,</para>
  <para style="q1" vid="1PE 1:24">wǝ́ pǝla nyɩŋrurǝ lǝ rǝ mǝŋ bɔɔrǝ lo otumɔŋyǝ kǝtǝ.</para>
  <para style="q1" vid="1PE 1:24">Vǝ́ bɔɔrǝ la pɩlaŋ we, otumɔŋyǝ sa ǝ yǝ ŋ ru yǝ tɔɔlʊ,<verse eid="1PE 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25" />paa Ǝtǝ Woroko le dierǝ gbii kǝkpakǝkpa».</para>
  <para style="m" vid="1PE 1:25">Dierǝ sa gaamǝ Dieceeceerǝ we pǝ tɛnɩ pǝ tìi nǝ wǝ.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">Yesu ŋ ri yusirurǝ we wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Kǝto nǝ wɛɛ mǝ rɔɔrɔɔwǝ kpǝlo kɩɩkɩ, wǝpiekpǝ kpǝlo kɩɩkɩ, alakpayǝ, nimimwɛɛrɩwǝ mǝ kǝnyipǝlǝkǝ. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />Mǝŋ kǝ́ epiŋwɛŋpǝ pǝ láa taa akɔɔrʊnyɩŋpǝ kǝtǝ we, ŋnǝ ŋkpɛ Worokoŋtierǝ la akɔɔrʊnyɩŋpǝ capɩcapɩ pǝ ca nǝ kpɛɛwǝ ŋpa. Mǝŋkǝsa vǝ́ nǝ ya nǝ nyóo ŋuŋ pǝ we, kǝ nǝ nya fɛɛ nǝ mǝ wasa rǝ wɛɛrǝ mǝrǝ, kǝ nǝ nya alɔkuŋkǝ. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />Kpiikǝ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Nǝ nya ra nǝ nya nyɩŋ kǝ́ Kulǝtǝyǝ ŋ ponu ŋ fǝ wǝ». <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />Nǝ ruu nǝ kǝlǝ mǝ Kulǝtǝyǝ Yesu. Ŋwǝ ŋ ri ɖurǝ we gbii vɔrʊrǝ anyɩmaasɩpǝ pǝ lǝ sǝ́ŋ pǝ lo co wǝ, paape Worokoyǝ la saa rǝ la pɔrʊ wǝ́ la lɔ okuruyǝ ŋpa rǝ ne enimiyǝ. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />Ŋnǝ ŋkpɛ nǝ lǝ rǝ mǝŋ oruyǝ yǝ kpii vɔrʊrǝ kǝtǝ. Kǝto nǝ fǝ nǝ wɛ nǝ tɔ Wɛɛkenikenirǝ la nyarǝwǝ. Rǝ nyarǝwǝ sa mǝrǝ we, nǝ nyée ri otoolutǝpǝ lǝ kpǝŋwǝ wǝ kpii wǝ koonu Worokoyǝ, kǝ nǝ mǝ yee otoolukǝ rǝ Wɛɛrǝ nǝ mǝ koonu ŋwǝ. Ŋkǝ otoolukǝ sa kǝ láa ca na kpɛɛwǝ rǝ tuwǝ we Yesu Kǝriso ŋ ne yee kǝto. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Duturǝ ɖi Worokoyǝ la tɛŋ rǝ Wǝŋʊrʊkenikenikpǝ lǝ mǝrǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1PE 2:6">«Nǝ yɩrɩ re!</para>
  <para style="q1" vid="1PE 2:6">Ŋ́ nah tɔ yusirurǝ<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Yesu ŋ kaamǝ Yusirurǝ sa.</char></note> rɛ rǝ Ziɔŋ</para>
  <para style="q1" vid="1PE 2:6">Ŋ́ na saa rǝ ŋ́ na pɔrʊ, la lɔ okuruyǝ,</para>
  <para style="q1" vid="1PE 2:6">wǝ́ yǝ we ŋ na tɛɛ kpɛɛwǝ rǝ rǝ we, lǝŋ pe fii nʊŋsɔɔwǝ pwi».<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />Ɖurǝ sa lǝǝmǝ okurumumuŋyǝ rɛ goonu ŋnǝ epǝ we nǝ nya lɔ nǝ nyo nuŋ wǝ. Paa epǝ we pǝ laa lɔ pǝ nuŋ we, Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1PE 2:7">«Ɖurǝ we okumarǝtǝpǝ pǝ lǝ sǝ́ŋ pǝ lo co we,</para>
  <para style="q1" vid="1PE 2:7">ŋrǝ le pe ri yusirurǝ wǝ».<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />Wǝ́ Wǝŋʊrʊkenikenikpǝ we wǝ lǝ tǝ wǝ la tɛŋ rǝ fɛɛrɛɛwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1PE 2:8">«Ɖurǝ lóo kuŋ enyipǝ pǝ tuu niɛpirǝ lǝǝwe,</para>
  <para style="q1" vid="1PE 2:8">ɖurǝ we lóo coolu enyipǝ wǝ».</para>
  <para style="m" vid="1PE 2:8">Enyipǝ sa pǝ lóo tuu niɛpirǝ kpiikǝ pǝ lǝ sǝ́ŋ pǝ lǝŋ lɔ Worokoyǝ le dierǝ we pǝ nuŋ kǝto, wǝ́ tuwǝ Worokoyǝ ŋ kpàka ŋ tǝ̀nǝ pǝ wǝǝ.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />Paa ŋnǝ we, nǝ ri gbǝŋrǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ wǝ, Worokoyǝ we ŋ ri piliyǝ lo otoolutǝpǝ lǝ kpǝŋwǝ wǝ́ nǝ ri, kǝkpǝŋkenikenikǝ wǝ́ nǝ ri. Worokoyǝ ŋwǝŋwǝ lǝ kǝkpǝŋkǝ wǝ́ nǝ ri. Worokoyǝ lo pwo nǝ nǝ ru rǝ nuŋtumuwǝ nǝ pǝ na wǝnyɩɩnɩkpatɩkpǝ sa mǝrǝ kǝ nǝ nya fɛɛ nǝ tɛŋ no otukpatɩmumuŋyǝ we ŋ ne yee wǝ. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />Eniyǝ nɔ we, nǝ nyee ke ri Worokoyǝ lǝ kǝkpǝŋkǝ. Paa rǝkǝsa nǝ ri nǝ kǝkpǝŋkǝ. Eniyǝ nɔ we, Worokoyǝ laa ka ŋ nyɩŋ nǝ tǝlarǝwǝ, paa rǝkǝsa la nyɩŋ nǝ tǝlarǝwǝ.<verse eid="1PE 2:10" /></para>
  <para style="s">Nǝ tii vɔrʊrǝ mǝŋ Worokoyǝ la asʊmatǝpǝ kǝtǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, nǝ ri rǝ ǝsǝtɛlɩtǝpǝ mǝ ǝsǝǝpǝ rǝ kǝtǝǝwǝ sa. Kǝto ŋ́ ya ŋ́ née ci mǝ ŋ kaŋ nǝ ǝkǝnǝŋ nǝ pee siimǝ wɛlɛŋrǝ lo otucakpɛɛrɔɔrɔɔyǝ we yǝ ya yǝ lée yee akɔŋkǝ mǝ nǝ wǝ. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />Nǝ fǝ wǝlǝceeceekpǝ nǝ tii vɔrʊrǝ rǝ epǝ we pǝ laa lɔ Worokoyǝ pǝ nuŋ lǝ mǝrǝ. Mǝŋkǝsa we, pǝ ke ce pǝ ŋ tɛŋ nǝ ǝkǝnǝŋ ŋnǝ nǝ ri enyirɔɔrɔɔpǝ we, pǝ lah pa nyɩŋ otuceeceeyǝ we nǝ ya nǝ nyée yee pǝ ci. Mǝŋkǝsa we, jirǝ we Worokoyǝ ŋ nǝ́ǝ pǝ we, pǝ lǝ́ǝ kǝ ŋwǝ.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Rǝ Kulǝtǝyǝ lo yurǝ kǝto we, nǝ pɛɛlɩ nǝ koonu asaatiitǝpǝ kpǝlo. Nǝ pɛɛlɩ nǝ koonu pilimumuŋyǝ, ŋwǝ ŋ lǝǝmǝ okopiyǝ rǝ tu ri ŋ tu lo oŋuŋkǝ wǝ. <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />Nǝ pɛɛlɩ nǝ koonu ǝkǝŋyɩrɩtǝpǝ ŋpǝ ŋkpɛ. Pilimumuŋyǝ ŋ ne kpii pǝ pǝ pa ta enyirɔɔrɔɔpǝ lo kǝtukoŋkǝ, kǝ pǝ kǝ epǝ we pǝ ya pǝ lée yee ceeceewǝ wǝ. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Duturǝ ɖi tuwǝ Worokoyǝ ŋ nǝ́ǝ pǝ́ wǝ kaamǝ ǝkǝnǝŋ vǝ́ nǝ ya nǝ nyée yee ceeceewǝ we, otuleecitǝpǝ pǝ lǝŋ tǝ pǝ nya pǝlo otuleecitǝtieyǝ we pǝ tɛŋ. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />Nǝ nyǝǝ tǝ nǝ ri arɔŋpǝ, kǝto nǝ re nǝ wɛ mǝŋ enyipǝ pǝ la lɔ diiwɛɛrǝ kǝtǝ. Paa nǝ diiwɛɛrǝ sa baa siɛrɩ yee tucɛtɛɛwǝ goonu nǝ kǝ nǝ mǝ yee oturɔɔrɔɔyǝ. Paa nǝ re nǝ wɛ mǝŋ enyipǝ pǝ ri Worokoyǝ la asʊmatǝpǝ kǝtǝ. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Nǝ pu nyi ri ŋ nyi. Nǝ taa nǝ ǝtǝŋ ekǝrisotǝpǝ lǝ kǝǝwǝ. Nǝ suu Worokoyǝ, kǝ nǝ pɛɛlɩ nǝ koonu pilimumuŋyǝ. <verse eid="1PE 2:17" /><verse number="18" style="v" sid="1PE 2:18" />Ŋnǝ asʊmatǝpǝ nǝ mǝ co kǝtukoŋkǝ rǝ no okulǝtǝpǝ mǝ wɛɛpɛɛlɩwǝ kpǝlo kɩɩkɩ. Ŋkǝ nǝ nyoh mǝ co kǝtukoŋkǝ mǝ wɛɛpɛɛlɩwǝ rǝ okulǝtǝpǝ we pǝ ponu, pǝ láa taa enyipǝ lǝ kǝǝwǝ ceŋceŋ ko, paa mǝŋ okulǝtǝpǝ we pǝ lɛnyɩ yurǝ wǝ. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Mǝŋ rɛ, la taarǝ lɛrǝ ya láa cʊʊrʊ acʊcʊʊrʊyǝ rɛ wǝ laa kaamǝ kǝ ŋ cʊʊrʊ, wǝ́ ŋ cii wǝ ǝkǝnǝŋ Worokoyǝ kpii kʊla mǝ ŋwǝ we, tuceeceewǝ rɛ wǝ́ wǝ ri. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Mǝŋ nǝ nye yee rɔɔrɔɔwǝ rɛ, wǝ́ nǝ nya taarǝ lɛrǝ nǝ ya nǝ nyáa lɔ ocuculupiyǝ wǝǝ, ǝlǝ ŋ nǝ́ǝ kǝ nǝ? Paa mǝŋ nǝ nya taarǝ lɛrǝ nǝ nya cʊʊrʊ rǝ kǝ́ nǝ nye yee ceeceewǝ we, tuceeceewǝ rɛ wǝ́ wǝ ri rǝ Worokoyǝ le enimiyǝ. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Ŋ wǝ tuwǝ sa le eyeekǝ wǝ́ Worokoyǝ ŋ no pwo nǝ ŋ no koonu wǝ. Duturǝ ɖi Kǝriso ŋwǝ ŋkpɛ la cʊʊrʊ lo koonu nǝ, la kaŋ nǝ cawǝ kǝ nǝ nya fɛɛ nǝ siimǝ ne wǝniekpǝ. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />Lee yee turɔɔrɔɔwǝ rɛ. Nianiatǝtierǝ rɛ loo po ru ŋwǝ rǝ nyuŋkpǝ nyɩŋ pwi. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />Kǝ́ enyipǝ pǝ ka ŋ fɛɛpɩ ŋwǝ we, laa fɛɛ rɛ ŋ kpii wǝlo yuwǝ. Kǝ́ enyipǝ pǝ ke ŋ kpii na acʊcʊʊrʊyǝ we, laa ma rɛ, paa wǝ́ ŋ fǝ̀ wǝ ŋ kòonu Worokoyǝ we ŋ náa tɛŋ wǝkpaŋkpǝ rǝ wǝkʊʊkpǝ wǝ. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />Yesu ŋwǝŋwǝ la lɔ loh oturɔɔrɔɔyǝ le re rǝ na wɛlɛŋrǝ mǝrǝ rǝ kpɛtɛkpǝlɛciiwǝ lo oŋuŋkǝ. Kǝto rǝ turɔɔrɔɔwǝ la kǝnyɩŋkǝ we, lǝ lǝ rǝ mǝŋ yǝ lǝ kpǝ́, kǝ la nya fɛɛ le tii vɔrʊrǝ rǝ wǝkʊʊkpǝ. Saŋ rǝ na wǝrɛŋkpǝ ŋ lɔ̀ kǝto wǝ́ nǝ nya kpaa wǝ. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Kǝceece we, nǝ kǝ lǝ rǝ mǝŋ amɛɛpǝ pǝ lǝ lǝǝ cawǝ kǝtǝ, paa rǝkǝsa we, nǝ nya siɛnɩ nǝ nyǝ pǝ yǝ we ŋ ri nǝ rǝŋtǝyǝ mǝ nǝ kǝrǝŋtǝyǝ lǝ kpǝŋ.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">Kǝloŋkǝ we kǝ kpii rǝ tieyǝ mǝ no nuŋyǝ mǝrǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Ŋnǝ etiepǝ ŋnǝ ŋkpɛ we, nǝ pɛɛlɩ nǝ wɛ nǝ koonu nǝ onuŋpǝ. Mǝŋkǝsa we, wǝ ke ce wǝ ri ǝkǝnǝŋ ǝpǝrǝŋrɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ lǝ sǝ́ŋ pǝ lǝŋ lɔ Worokoyǝ le dierǝ pǝ nuŋ we, nǝ wǝlǝceeceekpǝ sa kǝto kǝ pǝ lɔ pǝ nuŋ wǝ ke ce wǝ ri nǝ nyaa tɛŋ dierǝ rɛ nǝ tíi pǝ. <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />Duturǝ ɖi pǝ láa nyɩŋ kǝ́ nǝ wǝlǝkpǝ wǝ ponu wǝ fǝ wǝ, mǝ kǝ́ nǝ nyóo pu pǝ nǝ nyǝ ŋ fǝ wǝ. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />Nǝ paa taa nǝ wǝpoŋkpǝ nǝ ru rǝ ǝtǝǝtǝǝtuyǝ we nǝ nyǝ́ǝ fǝ nǝ cɛ mǝ nǝ wɛ wǝ, mǝŋ yuparǝrǝ we lo ru okuruyǝ, asɩkakpɛtɛɛlaayǝ mǝ wǝkurukpakpǝ. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />Paa tuwǝ we nǝ ri rǝ nǝ ziɔŋrǝ mǝrǝ we, ŋ wǝ wǝ ri nǝ wǝpoŋkpǝ wǝ. Ziɔŋrǝ we lǝ rɛyɩɩ wǝ́ daarǝ lo wǝpoŋkpǝ wǝ la lɔ okurumumuŋyǝ rǝ Worokoyǝ la kǝnyɩŋkǝ wǝ. Wǝpoŋkpǝ sa wǝ lǝŋ yuu fiawǝ. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Rǝ gakarǝ we, etiepǝ we pǝ lɔ̀ pǝ nunu ǝkǝ pǝ tɛ̀ɛ kpɛɛwǝ rǝ Worokoyǝ we, kǝ́ pǝ ka ŋ cɛ mǝ pǝla wɛ pǝ ŋ fǝ wǝǝ. Pǝ pɛ̀ɛlɩ pǝla wɛ pǝ kòonu pǝlo onuŋpǝ. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />Kǝ́ Sara ŋ ke ŋ yee wǝǝ, ko ŋ pu Abǝrahamǝ, wǝ́ ŋ ko ŋ pwo ŋwǝ ǝkǝnǝŋ: «Mǝ kulǝtǝyǝ!» Mǝŋ nǝ nyée yee eceeceeyǝ wǝ́ nǝ nyǝŋ maa tu ri ŋ tu wǝ cɩɩlɩ nǝ we, nǝ nyáa siɛrɩ nǝ yee Sara la akɔrʊpǝ. <verse eid="1PE 3:6" /><verse number="7" style="v" sid="1PE 3:7" />Kaa wǝǝ ŋnǝ ǝpǝrǝŋpǝ nǝ tii vɔrʊrǝ mǝ nǝ etiepǝ mǝ dutunuŋrǝ ǝkǝnǝŋ pǝ ri rǝ afɔlɔfɔtǝpǝ. Nǝ re pǝ mǝŋ kǝ́ wǝ lǝ pǝ́ wǝ, duturǝ ɖi pǝ lah pa ka lɔ vɔrʊpoŋpirǝ lo tukoonuwǝ rǝ Worokoyǝ lǝ kpǝŋ mǝŋ ŋnǝ kǝtǝ. Nǝ mǝ yee ǝnǝ kǝ tǝrɛ wǝ pee pe yee gbaraarǝ wǝ koonu nǝ onyuŋmwɛŋyǝ.<verse eid="1PE 3:7" /></para>
  <para style="s">Nǝ kpaka nǝ tíi koonu acʊcʊʊrʊyǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Kǝ ŋ́ fǝ ŋ́ tǝǝlǝ we, wǝ kpii kǝ nǝ kpǝlo kɩɩkɩ nǝ lǝmǝ yupurǝ jeŋceŋ mǝ dutunuŋrǝ jeŋceŋ, nǝ mǝ nyɩŋ nyiyǝ la tǝlarǝwǝ, nǝ taa awɛ lǝ kǝǝwǝ mǝŋ apaanʊpǝ mǝ apaatɛpǝ kǝtǝ. Nǝ mǝ yee eceeceeyǝ, nǝ pɛɛlɩ nǝ koonu awɛ. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />Nǝ pǝǝ fǝ rɔɔrɔɔwǝ nǝ ca rɔɔrɔɔwǝ la kpawǝ amaa vǝfɛɛpirǝ nǝ ca vǝfɛɛpirǝ la kpawǝ. Paa nǝ pɛɛrɩ enyipǝ rǝ, duturǝ ɖi tuwǝ kǝto Worokoyǝ ŋ no pwo nǝ wǝǝ, kǝ ŋ nya fɛɛ ŋ koonu nǝ wǝpɛɛrɩkpǝ. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1PE 3:10">«Nyiyǝ we ŋ nǝ́ǝ pǝ́ ŋ tii vɔrʊrǝ kǝ ŋ nyɩŋ rǝla wǝraŋkpǝ, kǝ ŋ nyɩŋ eciceeceeyǝ we,</para>
  <para style="q1" vid="1PE 3:10">yǝ we ŋ paa tɛŋ rɔɔrɔɔwǝ rɛ ŋ ru rǝ apʊŋpwapǝ, yǝ we ŋ paa mǝ nia<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />Yǝ we ŋ wɛɛ mǝ rɔɔrɔɔwǝ le eyeekǝ, kǝ ŋ mǝŋ yee rǝ ceeceewǝ,</para>
  <para style="q1" vid="1PE 3:11">kǝ yǝ we ŋ tɔ ŋ yaa mǝ ŋ taa wǝtaarǝkpǝ.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />Duturǝ ɖi Ǝtǝ Woroko le nimirǝ dɛɛ rǝ enyipǝ we pǝ kʊʊ wǝ,</para>
  <para style="q1" vid="1PE 3:12">lóo co kǝtukoŋkǝ rǝ pǝlo onyuŋmwɛŋyǝ,</para>
  <para style="q1" vid="1PE 3:12">paa le yi la tɛɛ rǝ epǝ we pǝ le yee rɔɔrɔɔwǝ wǝ.»<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Ǝlǝ ŋ née yee nǝ rɔɔrɔɔwǝ mǝŋ nǝ nyǝ fǝ nǝ ziɔŋrǝ fee nǝ ya nǝ nyée yee ceeceewǝ wǝ? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Wǝ ke ce wǝ ri ǝkǝnǝŋ nǝ nyáa cʊʊrʊ mǝ kǝ́ nǝ ya nǝ nyée yee tuwǝ wǝ kʊʊ we, nǝ nyo co yǝ! Nǝ poo suu pǝlo vurǝ, nǝ paa lɛ nǝ cɩɩlɩ! <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />Paa nǝ nyɩŋ Kǝriso yǝ we ŋ ri Kulǝtǝyǝ rǝ nǝ ziɔŋrǝ mǝrǝ nǝ ci ǝkǝnǝŋ lǝ kenikeni. Eni ri ŋ ni we, nǝ kpaka nǝ mǝ rǝŋ kǝ́ nǝ nyáa pɔrʊ dierǝ nǝ tíi epǝ we kpǝlo kɩɩkɩ pǝ lǝ́ǝ pǝ́ pǝ nuŋ ǝrǝŋkǝ sa nǝ lǝǝmǝ rǝ nǝ mǝrǝ lo duturǝ wǝ. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />Paa nǝ taarǝ rɛyɩɩ nǝ yee wǝ mǝ kǝnyipukǝ. Nǝ ziɔŋrǝ baa tɔɔ nǝ bɔrǝ, mǝŋkǝsa vǝ́ enyipǝ pǝ la tɛɛ nǝ acɛɛyǝ rǝ tuwǝ rɛ lo yurǝ we, epǝ we pǝ ya pǝ láa fɛɛpɩ wǝlǝceeceekpǝ we wǝ kpii rǝ ŋnǝ ekǝrisotǝpǝ we, pǝ lée fii nʊŋsɔɔwǝ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Duturǝ ɖi mǝŋ nyiyǝ láa cʊʊrʊ mǝ kǝ́ ŋ ya ŋ née yee ceeceewǝ wǝ́ wǝ nya wǝ ri Worokoyǝ lǝ kǝǝpǝ́wǝ we, wǝ ponu wǝ teeri kǝ́ ŋ náa cʊʊrʊ mǝ kǝ́ ŋ ya ŋ née yee rɔɔrɔɔwǝ wǝ.<verse eid="1PE 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 3:18" />Duturǝ ɖi Kǝriso ŋwǝŋwǝ la cʊʊrʊ rǝ anyɩmaasɩpǝ lo oturɔɔrɔɔyǝ lo yurǝ kǝceŋceŋ ko, wǝ la lɛ kǝkpakǝkpa. Ŋwǝ yǝ we ŋ nee yee tǝrɛ, lǝ kpǝ́ lo koonu enyirɔɔrɔɔpǝ, kǝ ŋ nya fɛɛ ŋ re nǝ ŋ ko koonu Worokoyǝ. Pǝ la wʊ ŋwǝ rǝ na wɛlɛŋrǝ, paape Wɛɛkenikenirǝ la saanǝ ŋwǝ. <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />Fɛɛwǝ ŋ kolu ŋ tɛnɩ Dieceeceerǝ we ŋ tìi awɛɛyǝ we yǝ kpii rǝ gukpɛɛkpǝ wǝǝ. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />Ŋpǝ pǝ kaamǝ epǝ we pǝ sǝ́nǝ pǝ loo co kǝtukoŋkǝ rǝ Worokoyǝ eniyǝ nɔ wǝ. Wǝ́ Worokoyǝ ŋ tàarǝ lɛrǝ ŋ kǝ ŋ rǝŋ pǝ. Ŋyǝ eniyǝ we mǝrǝ wǝ́ Nowa ŋ kǝ ŋ kpǝ gbanǝŋwaarǝ wǝ. Enyipǝ rɛ kpekperee, enyi anɛŋ ko pǝ fìi gbanǝŋwaarǝ sa, wǝ́ Worokoyǝ ŋ lɔ̀ ŋ kòonu pǝ saŋ rǝ mɛŋwǝ. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />Otuyǝ sa yǝ ka kaa rǝ mǝ worokomɛŋwiiriwǝ sa wǝ ya wǝ láa lɔ wǝ ŋ koonu nǝ rǝkǝsa wǝ. Worokomɛŋwiiriwǝ sa wǝ lee ri wɛlɛŋrǝ la acɩcɩɩyǝ la awɛɛkǝ. Paa wǝ ri rǝ kǝ́ ǝ lǝ́ǝ pǝ́ Worokoyǝ ŋ koonu lǝ́ ziɔŋrǝ we lǝŋ tɔɔ nyiyǝ la bɔrǝ wǝ. Worokomɛŋwiiriwǝ wǝ láa lɔ wǝ ŋ koonu nǝ saŋ rǝ kǝ́ Yesu Kǝriso ŋ na saanǝ ŋ no ru rǝ gbɛŋrǝ wǝ. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />Lo ko yulaarǝ, wǝ́ ŋ yaa rǝ Worokoyǝ le kǝnirisiɛɛkǝ. Epicoŋpipǝ, asaatiitǝpǝ mǝ okopiyǝ we rǝ yulaarǝ yǝ la pɛɛlɩ yǝ lo koonu ŋwǝ.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">Alɔnuŋtǝpǝ la vɔrʊŋwɛŋrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Kǝto kǝ́ wǝ ri ǝkǝnǝŋ Kǝriso la cʊʊrʊ rǝ na wɛlɛŋrǝ we, ŋnǝ ŋkpɛ we, nǝ lɔ ŋrǝ yupurǝ sa nǝ re kǝ gbii nǝ okopiyǝ ǝkǝnǝŋ, yǝ we ŋ na cʊʊrʊ rǝ wɛlɛŋrǝ we, lǝ sǝrǝ mǝ turɔɔrɔɔwǝ le eyeekǝ, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />kǝ eniyǝ sa yǝ lo tuuru ŋwǝ ŋ yee rǝ kǝtǝǝwǝ sa we, yǝ we ŋ pee tii vɔrʊrǝ ŋ saŋ rǝ anyɩmaasɩpǝ lo otucakpɛɛrɔɔrɔɔyǝ, paa ŋ tii vɔrʊrǝ saŋ rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Wǝ la kaa ǝnǝ! Eniyǝ nɔ we, nǝ fǝ̀ eniyǝ nǝ ke ŋ yee otuyǝ we yǝ ponu mǝ epǝ we pǝ laa lɔ Worokoyǝ pǝ nuŋ wǝ. Nǝ ke ŋ yee nuŋruwǝ, nǝ ke ŋ yee rǝ nǝ otucakpɛɛrɔɔrɔɔyǝ, nǝ ke ŋ piemu ǝfǝŋpǝ, nǝ ke ŋ yee erikpaakǝ, nǝ ko ŋ ŋuŋ ǝfǝŋpǝ kururu wǝ́ nǝ ka ŋ sʊma afɛɛyǝ, pusuŋtǝtuwǝ wǝ lǝǝwe. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />Rǝkǝsa we, wǝ le yee pǝ yaa mǝ kǝ́ nǝ nyǝǝ tǝ nǝ nyarǝ nǝ wɛ nǝ co nǝ kʊla mǝ pǝ rǝ dʊkpaatǝfɔrʊrǝ sa lǝ sǝ fɛɛwǝ le etiikǝ, wǝ́ pǝ ya pǝ láa fɛɛpɩ nǝ. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />Paa pǝ leh pe ke yee akʊŋtayǝ ru rǝ pǝlo otuyeeyǝ pǝ koonu Worokoyǝ we ŋ na kpaka ŋ tini ŋ pa tɛŋ enyipǝ we pǝ kpii vɔrʊrǝ mǝ enyiǝtǝpǝ la wǝkpaŋkpǝ wǝ. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Ŋ wǝ kǝto wǝ́ pǝ la tɛŋ Dieceeceerǝ sa pǝ le tíi mǝŋ enyiǝtǝpǝ wǝ. Mǝŋkǝsa we, vǝ́ pǝ la tɛŋ pǝla wǝkpaŋkpǝ mǝŋ anyɩmaasɩpǝ kpǝlo kɩɩkɩ kǝtǝ rǝ wɛlɛŋrǝ pǝ la lɛ we, rǝkǝsa we, pǝ lóo koru etii vɔrʊrǝ mǝŋ Worokoyǝ kǝtǝ saŋ rǝ Wɛɛrǝ.<verse eid="1PE 4:6" /></para>
  <para style="s">Worokoyǝ lo koonu nyi ri ŋ nyi lo tukoonuwǝ lǝ fǝ le re awɛ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Tu ri ŋ tu la alɛɛkǝ kǝ lǝ kǝlǝ. Kǝto nǝ sie nimirǝ, nǝ ta nǝ wɛ kǝ nǝ nya fɛɛ nǝ mǝ koru amwɛŋ nyuŋkpǝ. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />Tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ teeri tu ri ŋ tu wǝ kaamǝ wǝ ǝnǝ: Nǝ taa awɛ lǝ kǝǝwǝ ŋpa, duturǝ ɖi mǝŋ nǝ nyáa taa awɛ lǝ kǝǝwǝ we, nǝ nyóo koru ǝfǝ nǝ cɛɛ awɛ. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />Nǝ lɔ awɛ lǝ kǝsǝǝkǝ, rɛ ŋ paa ca cwɩɩwǝ. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />Nyi ri ŋ nyi rǝ nǝ mǝrǝ mǝ no tukoonuwǝ Worokoyǝ ŋ no koonu ŋwǝ wǝ. Nǝ fǝ nǝ tukoonuwǝ nǝ toŋ otuturupǝ. Mǝŋkǝsa we, nǝ nyée ri anǝnɛyeetǝceeceepǝ pǝ láa yɩrɩ Worokoyǝ lo otukoonuyǝ we yǝ lǝǝmǝ wǝrʊʊkpǝ kpookpoo lo yurǝ wǝ. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Mǝŋ rɛ láa tɛŋ Worokoŋtierǝ we, ŋ tɛŋ rǝ mǝŋ nyiyǝ ŋ na lɔ kpɛɛwǝ ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ ŋ tíi enyipǝ kǝtǝ. Mǝŋ rɛ láa sʊma nǝ ǝtǝŋpǝ we, ŋ fǝ okopiyǝ we Worokoyǝ ŋ no koonu ŋwǝ ŋ yee wǝ. Mǝŋkǝsa we, rǝ tu ri ŋ tu lǝ mǝrǝ we, kǝ pǝ nya fɛɛ pǝ kǝ Worokoyǝ saŋ rǝ Yesu Kǝriso. Ŋwǝ ŋ kaamǝ ǝkǝkǝ mǝ okopiyǝ kǝkpakǝkpa! Amɛnǝ.<verse eid="1PE 4:11" /></para>
  <para style="s">Cʊʊrʊ mǝŋ kǝrisotǝyǝ kǝtǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Mǝ ǝkǝǝtaatǝpǝ, nǝ kpii rǝ acʊcʊʊrʊyǝ la naawǝ mǝrǝ, wǝ pee ri nǝ mumuŋ mǝŋ tuŋwɛŋwǝ rɛ wǝ ya wǝ lǝ́ǝ pǝ wǝ ŋ tuu nǝ. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />Paa we, nǝ nya faawǝ ǝkǝnǝŋ nǝ ya nǝ nyáa cʊʊrʊ mǝŋ Kǝriso kǝtǝ. Mǝŋkǝsa we, jirǝ we ŋ náa pɔrʊ na anaanǝkǝ ŋ kaŋ we, kǝ nǝ nya faawǝ nǝ sǝ nǝ tɛlɩ. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Mǝŋ rǝ Kǝriso la nyɩŋrǝ kǝto wǝ́ rɛ ŋ na fɛɛ nǝ we, nǝ nya faawǝ! Duturǝ ɖi Wɛɛrǝ we lǝǝmǝ okopiyǝ, ɖi Worokoyǝ la Wɛɛrǝ we, gbii rǝ nǝ mǝrǝ. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Rɛ rǝ nǝ mǝrǝ ŋ paa cʊʊrʊ kǝ oturu wǝ ri ǝkǝnǝŋ la wʊ nyiyǝ, amaa la yɩɩ, amaa le yee rɔɔrɔɔwǝ rɛ, amaa le kpii rɛ le dierǝ lo nyuŋkpǝ kǝto. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />Paa mǝŋ rɛ ya láa cʊʊrʊ kpiikǝ ŋ ri kǝrisotǝyǝ kǝto we, wǝ poo co yǝ we la nʊŋsɔɔwǝ, bomu yǝ we ŋ kǝ Worokoyǝ ǝkǝnǝŋ ŋwǝ ŋ ne ri nyɩŋrǝ sa. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Eniyǝ yǝ lo ro kǝ pǝ tie wǝkpaŋtɛŋkpǝ, wǝ́ wǝ lée tie rǝ Worokoyǝ la nyarǝwǝ. Wǝ́ mǝŋ wǝ le tie rǝ ŋlǝ wǝǝ, we epǝ we pǝ lǝ sǝ́ŋ pǝ lǝŋ lɔ Worokoyǝ le Dieceeceerǝ we pǝ nuŋ wǝǝ, pǝlǝ kǝtǝǝlǝkǝ kǝ lǝh kǝ lǝ nɛ? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Mǝŋ afia mǝ akɔŋ wǝ́ nyikʊʊyǝ ŋ ne ci anya alɔkuŋkǝ wǝǝ, we yǝ we ŋ nǝŋ suu Worokoyǝ mǝ turɔɔrɔɔyeetǝyǝ la nɛŋwǝ wǝ lǝ́ǝ lǝ nɛ?» <verse eid="1PE 4:18" /><verse number="19" style="v" sid="1PE 4:19" />Kǝto we, epǝ we pǝ ya pǝ láa cʊʊrʊ ǝkǝ wǝ ri rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ we, pǝ fǝ pǝla wɛ pǝ kpii yǝ we ŋ no co pǝ rǝ akaakǝ kǝ pǝ ŋ yee tuceeceewǝ.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">Pɛtǝro le ci la kaŋ zʊmarǝ lo omumuŋpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Wǝ kǝto ŋ́ ya ŋ́ née ci mǝ ŋ kaŋ zʊmarǝ lo omumuŋpǝ we pǝ kpii rǝ nǝ mǝrǝ wǝǝ, ŋmǝ ŋkpɛ ŋ́ ri zʊmarǝ lo mumuŋyǝ mǝŋ ŋpǝ kǝtǝ, wǝ́ ŋ́ ri ɖaŋsielǝtǝyǝ ŋ́ koonu Kǝriso la acʊcʊʊrʊyǝ, wǝ́ ŋ́ nah pa kʊla rǝ wǝnyɩɩnɩkpǝ we Worokoyǝ ŋ nah pa pɔrʊ ŋ kaŋ wǝ. <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />Nǝ yɩrɩ Worokoyǝ la mɛɛkpǝŋwǝ we ŋ nǝ fǝ ŋ ne kpii nǝ rǝ akaakǝ lo yurǝ. Nǝ rǝŋ wǝ, ŋkǝ kǝ oturu rɛ ya lée si nǝ rǝ, paa nǝ yee wǝ mǝ nǝ ziɔŋrǝ fee, mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ wǝ kǝtǝ. Nǝ mǝ yee kǝnǝnɛkǝ sa ŋkǝ kǝ nǝ fǝ nǝ nya sɩkayǝ rǝ ko, paa nǝ fǝ wɛɛlɛŋwǝ nǝ mǝ yee kǝ. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />Nǝ pǝǝ fǝ okopiyǝ mǝŋ kulǝtǝyǝ rɛ kǝtǝ nǝ re epǝ we Worokoyǝ ŋ nǝ fǝ ŋ ne kpii nǝ rǝ akaakǝ nǝ yɩrɩ yurǝ wǝ, paa nǝ siɛrɩ nǝ yee tunyɩŋcamǝwǝ nǝ koonu mɛɛkpǝŋwǝ we. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Mǝŋkǝsa we, eniyǝ we rǝŋtǝmumuŋyǝ we ŋ noh po ru we, nǝ nyáa lɔ yurituukpatɩrǝ we wǝ lǝŋ pǝ pǝlǝ pwi wǝ.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Ŋnǝ okosopipǝ mǝ akɔsɔkɔrʊpǝ ŋnǝ ŋkpɛ, nǝ pɛɛlɩ nǝ koonu omumuŋpǝ. Nǝ kpǝlo kɩɩkɩ nǝ fǝ wɛɛpɛɛlɩwǝ nǝ re awɛ. Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Worokoyǝ lée yi mǝ ŋ tɛɛ rǝ epǝ we pǝ láa rɛɛrɩ mǝ pǝla wɛ wǝ, paa epǝ we pǝ láa pɛɛlɩ pǝla wɛ we, lée yee pǝ la lɛsiɛrɩwǝ.» <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Kǝto we, nǝ pɛɛlɩ nǝ wɛ rǝ Worokoyǝ la akaalɛnyɩkǝ we lǝ kǝnǝŋkǝ kǝ ŋ nya fɛɛ ŋ rɛɛrɩ mǝ nǝ mǝ eniyǝ we ŋ nǝ tǝnǝ wǝ. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />Nǝ nyarǝ nǝ otukǝǝnǝyǝ kpǝlo kɩɩkɩ nǝ co nǝ tɛɛ rǝ Worokoyǝ, duturǝ ɖi ŋwǝ ŋ náa yɩrɩ nǝ yurǝ wǝ. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />Nǝ ta nǝ wɛ, nǝ tii nǝ mǝ rǝŋ! Nǝ kǝǝkpǝlǝtǝyǝ, Abʊŋsamʊyǝ we, lǝ rǝ mǝŋ kɛɛlɔyǝ rɛ ŋ ca ɖɔɔrǝ ŋ siri ŋ náa tɛlɩ kǝtǝ. Taa yǝ we ŋ nah lɔ ŋ laarǝ láa tɛlɩ. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Nǝ tɔ nǝ yaa rǝ lɔnuŋrǝ kǝ nǝ yi nǝ tɛɛ rǝ ŋwǝ. Nǝ taalǝ ǝkǝnǝŋ nǝ ǝtǝŋpǝ rǝ ǝrǝkǝ kpǝlo kɩɩkɩ pǝ kpii rǝ ŋyǝ acʊcʊʊrʊyǝ sa lǝ mǝrǝ. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Paa vǝ́ nǝ nya cʊʊrʊ rǝ enipiyǝ rɛ lǝ mǝrǝ we, Worokoyǝ we lǝ kpǝŋ lɛsiɛrɩwǝ kpǝlo kɩɩkɩ wǝ lo ru, wǝ́ ŋ no pwo nǝ ŋ nǝ pǝ na wǝnyɩɩnɩlaalɛɛkpǝ we mǝrǝ kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kǝriso we, ŋwǝŋwǝ lóo toolu tu ri ŋ tu ŋ koonu nǝ, lée kpii nǝ okopiyǝ rǝ nǝ lɔnuŋrǝ, lóo koonu kǝ nǝ lɛnyɩ kǝ ŋ koonu nǝ tɔ nǝ yaa kiŋkiŋ. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Ŋwǝ ŋ kaamǝ okopiyǝ kǝkpakǝkpa! Amɛnǝ.<verse eid="1PE 5:11" /></para>
  <para style="s">Eceenituturukǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ Silǝvɛŋ ri paanʊyǝ rɛ ŋ née ri anʊkɔrǝyǝ. Ŋ́ na saŋ rǝ na akaakǝ ŋ́ na ŋʊrʊ etiepiyǝ sa ŋ́ na maŋ nǝ, ŋ́ fǝ ŋ kpii nǝ okopiyǝ kǝ ŋ́ ri ɖaŋsieyǝ ŋ tíi nǝ ǝkǝnǝŋ Worokoyǝ la lɛsiɛrɩpoŋpiwǝ we wǝ́ nǝ nya kpaa nǝ nya maarǝ mǝ wǝ. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />Kǝkpǝŋkǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ kǝ kpii rǝ Babilonia we, kǝ lée ceeni nǝ. Mǝ pi Marǝko ŋwǝ ŋkpɛ lée ceeni nǝ. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Nǝ ceeni awɛ sɩsiɛrɩ mǝ kǝǝtaawǝ mǝŋ apaanʊpǝ mǝ apaatɛpǝ kǝtǝ.</para>
  <para style="p" vid="1PE 5:14">Wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ ŋnǝ epǝ we kpǝlo kɩɩkɩ nǝ kpii rǝ Kǝriso mǝrǝ wǝ!<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>