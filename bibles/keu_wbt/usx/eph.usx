<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">AKebou: La Bible en Akebou</book>
  <para style="h">Efesotǝpǝ</para>
  <para style="toc3">Efe</para>
  <para style="toc2">Efesotǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Efesotǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Efesotǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ na maŋ zʊmarǝ we gbii rǝ Efeso wǝ. Rǝ anʊkɔrǝyǝ we, kǝfwɛɛkǝ sa kǝ ka ŋ wɛɛlɩ gǝ ŋ tíi alɔnuŋtǝpǝ la wǝcakukpǝ we kpǝlo wǝ ke kpii rǝ Azi wǝ. Kǝfwɛɛkǝ sa kǝ la pɔrʊ Worokoyǝ la alɔkuŋkǝ lo yupurǝ we kǝ la kaŋ. Yupurǝ we gaamǝ ǝkǝnǝŋ Kǝriso le ri Kɛrɩrɔɔrɔɔyǝ we lo yurǝ rǝ ǝrǝkǝ kpǝlo. Rǝ kǝfwɛɛkǝ sa le kǝtiekǝ we, Pɔlʊ lǝ kǝ Worokoyǝ kpiikǝ ŋ na saa lǝ ŋ na pɔrʊ kpɛŋ wǝ́ ŋ ne ci oco ǝrǝkǝ, wǝ́ ŋ na pɔrʊ lǝ kǝ la nya fɛɛ le yee nyiceŋceŋ mǝ Kǝriso (Efes 1). Lǝ tǝ la wɛɛlɩ lo ru rǝ wǝsǝpǝkpǝ we wǝ ke kpii rǝ Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ, wǝ́ ŋ na tɛŋ ǝkǝnǝŋ kǝ́ Kǝriso ŋ nǝ kpǝ́ we, wǝ́ ŋ ne re giriŋrǝ we gǝ ŋ sǝpǝ wǝkpǝŋkpǝ sa wǝyikpǝ ŋ no co. Rǝkǝsa we, wǝ la siɛrɩ wǝ le yee kǝkpǝŋkǝ kǝceŋceŋ, ŋ wǝ wǝ ri Worokoyǝ lo tuŋwaawǝ we wǝ (<char style="xt"><ref loc="EPH 2-3">2–3</ref></char>). Rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ we, Pɔlʊ tǝ ya láa kaŋ kǝ́ ekǝrisotǝpǝ: Tie mǝ no nuŋ pǝ lée re awɛ pǝ fǝ, piyǝ mǝ nǝ ǝmǝtǝpǝ pǝ le re awɛ pǝ fǝ, rɔŋyǝ mǝ no kulǝtǝyǝ pǝ lée re awɛ pǝ fǝ (<char style="xt"><ref loc="EPH 4:1-6:9">4:1–6:9</ref></char>). Rǝ kǝlɛɛkǝ we, Pɔlʊ ya lée kpii alɔnuŋtǝpǝ lo okopiyǝ pǝ tɔ pǝ yaa rǝ acʊcʊʊrʊyǝ lǝ mǝrǝ (<char style="xt"><ref loc="EPH 6:11-13">6:11-13</ref></char>).</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-2</para>
  <para style="io">- Kǝriso mǝ zʊmarǝ 1:3–3:21</para>
  <para style="io">- Vɔrʊŋwɛŋrǝ rǝ Kǝriso mǝrǝ 4:1–6:20</para>
  <para style="io">- Pɔlʊ le etietuturuyǝ 6:21-24</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Ŋmǝ Pɔlʊ, ŋ́ ri Yesu Kǝriso le nyikpiiyǝ saŋ rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ. Ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa mǝ ŋ́ maŋ ŋnǝ epǝ we nǝ ri Worokoyǝ la anɛŋpǝ rǝ Efeso ǝkǝ nǝ nya lɔ Yesu Kǝriso nǝ nyo nuŋ kǝceece wǝ. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Lǝh Tǝ Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ lɛ pǝ koonu nǝ wǝtaarǝkpǝ.<verse eid="EPH 1:2" /></para>
  <para style="s">Otuceeceeyǝ we Worokoyǝ ŋ nóo koonu nǝ kǝkpǝŋkǝ saŋ rǝ Kǝriso wǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Kǝ lǝ kǝ Worokoyǝ, yǝ we ŋ ri loh Kulǝtǝyǝ Yesu Kǝriso lǝ Tǝyǝ wǝ. La pɛɛrɩ lǝ mǝ wɛɛrǝ la wǝpɛɛrɩkpǝ we kpǝlo kɩɩkɩ wǝ kpii rǝ yulaarǝ, kpiikǝ yǝ le yee nyiceŋceŋ mǝ Kǝriso kǝto. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Rǝ nǝ kǝǝtaawǝ mǝrǝ we, ŋwǝ Worokoyǝ sàa lǝ tǝ̀nǝ kaka saŋ rǝ Kǝriso kpɛŋ wǝ́ ŋ cìi o cò ǝrǝkǝ, kǝ la nya fɛɛ lǝ lǝ kenikeni, lǝ pǝǝ lǝmǝ bɔtɔɔrǝ rɛ rǝ na kǝnyɩŋkǝ. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Fǝ̀ tɛ̀ɛ rǝ na wɛ còonu ǝkǝnǝŋ ŋ nǝ́ǝ fǝ lǝ ŋ yee ne epipǝ saŋ rǝ Yesu Kǝriso. Tuwǝ ŋ nǝ pǝ́ rǝ ne wǝceeceeyeekpǝ mǝrǝ wǝǝ. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Kǝto nǝ pǝ kǝ lǝ kǝ Worokoyǝ rǝ ne wǝceeceemumuŋkpǝ sa ŋ ne yee ŋ no koonu lǝ faa, kpiikǝ yǝ le yee nyiceŋceŋ mǝ ne Pi ŋ náa taa kǝǝwǝ ŋpa wǝ.<verse eid="EPH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7" />Worokoyǝ lǝ fǝ ne Pi la ŋpǝrayǝ la pɔrʊ lǝ lo ru rǝ rɔɔrɔɔwǝ wǝ́ ŋ na lɛ ŋ nǝ fǝ loh oturɔɔrɔɔyǝ ŋ na cɛɛ lǝ kpiikǝ yǝ le yee nyiceŋceŋ mǝ ŋwǝ Kǝriso kǝto. Mǝŋkǝsa we, Worokoyǝ la pɔrʊ na lɛsiɛrɩmumuŋwǝ sa la kaŋ lǝ. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Le yee lǝ lɛsiɛrɩwǝ sa ŋpaŋpa mǝ kǝ́ ŋ no koonu lǝ mǝŋ nimisiewǝ mǝŋ otuciyǝ kpǝlo. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Lo koonu lǝ yǝ le ci nǝ kǝǝpǝ́wǝ lo tuŋwaawǝ we. Fǝ̀ tɛ̀ɛ rǝ na wɛ kaka, rǝ ne wǝceeceeyeekpǝ mǝrǝ ǝkǝnǝŋ ŋ née yee tuwǝ sa saŋ rǝ Kǝriso. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Tuŋwaawǝ sa wǝ kaamǝ ǝkǝnǝŋ vǝ́ eniyǝ yǝ lo ro we, láa ca otuyǝ kpǝlo kɩɩkɩ rǝ yulaarǝ mǝ kǝtǝǝwǝ ŋ ku, kǝ Kǝriso ceŋceŋ ko ŋ ri yǝlo mumuŋyǝ.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Kǝ́ yǝ le yee nyiceŋceŋ mǝ Kǝriso we, yǝ la lɔ lah nɛŋ tuwǝ we Worokoyǝ ŋ cò lǝ garǝ wǝ. Duturǝ ɖi Worokoyǝ sàa lǝ tǝ̀nǝ kaka saŋ rǝ no yupurǝ. Worokoyǝ le yee otuyǝ sa kpǝlo kɩɩkɩ mǝŋ kǝ́ ŋ no pu wǝ wǝ́ ŋ nǝ pǝ́ wǝ kǝtǝ, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />kǝ ŋlǝ epǝ we le ri ǝsǝsǝŋpǝ yǝ la tɛɛ kpɛɛwǝ rǝ Kǝriso we, la nya fɛɛ lǝ mǝ kǝ Worokoyǝ la anaanǝkǝ. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Ŋnǝ ŋkpɛ nǝ nye yee nyiceŋceŋ mǝ Kǝriso kpiikǝ nǝ nyo nuŋ anʊkɔrǝyǝ le dierǝ we, ŋ́ reemǝ Dieceeceerǝ we lǝ pǝ mǝ alɔkuŋkǝ lo koonu nǝ wǝ. Nǝ nya lɔ Yesu Kǝriso nǝ nyo nuŋ wǝ́ Worokoyǝ ŋ na tɛɛ nǝ barǝ. Barǝ sa gaamǝ Wɛɛkenikenirǝ we ŋ cò garǝ wǝ. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Wɛɛkenikenirǝ sa ŋ no koonu lǝ we, ɖi rǝ tutagbarǝrǝ. Wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ lǝh pǝ fǝ otuceeceeyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ nǝ kǝkpǝŋkǝ ŋ koonu lǝ. Vǝ́ la pa pɔrʊ lǝ rǝ rɔɔrɔɔwǝ mǝrǝ la lɛ kɩɩkɩ we, ǝtǝtuyǝ sa yǝ lée fii lah akaakǝ. Kǝto nǝ pǝ kǝ lǝ kǝ Worokoyǝ la anaanǝkǝ.<verse eid="EPH 1:14" /></para>
  <para style="s">Pɔlʊ lo nyuŋmwɛŋwǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Tuwǝ kǝto ŋmǝ ŋkpɛ we, ǝrǝ kǝ́ ŋ́ no nuŋ wǝlǝkpǝ we nǝ nya lɔ Kulǝtǝyǝ Yesu Kǝriso nǝ nyo nuŋ nǝ nyǝ fǝ, mǝ wǝlǝkpǝ we nǝ nyáa taa epǝ we kpǝlo kɩɩkɩ pǝ ri na anɛŋpǝ lǝ kǝǝwǝ nǝ nyǝŋ fǝ we, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />ŋ́ nǝŋ wɛɛ mǝ Worokoyǝ le eceenikǝ rǝ nǝ yurǝ. Ŋ́ náa taalǝ nǝ rǝ mǝ onyuŋmwɛŋyǝ, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />wǝ́ ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ loh Kulǝtǝyǝ Yesu Kǝriso lo Worokoyǝ we, Tǝyǝ we ŋ kaamǝ ǝkǝkǝ we, ŋ koonu nǝ nimisiewǝ la Wɛɛrǝ we láa pɔrʊ ŋwǝ Worokoyǝ gaŋ nǝ, kǝ lɛ goonu nǝ nǝ ci ŋwǝ sɩsiɛrɩ wǝ. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Ŋ́ ya ŋ́ náa lɛ mǝ ŋ tɔɔ mǝ ŋ kpɛɛ ŋwǝ kǝ na wǝnyɩɩnɩkpǝ wǝ wuru nǝ enimiyǝ, kǝ nǝ nya fɛɛ nǝ ci tuwǝ we ŋ no pwo nǝ ŋ nǝ pǝ nǝ pǝ rǝŋ wǝ. Ŋ́ reemǝ otulǝmǝkpatɩkpatɩyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ epǝ we pǝ ri na anɛŋpǝ wǝ. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Nǝ nyée ci Worokoyǝ lo okopimumuŋyǝ we ŋ lǝǝmǝ ŋ koonu ŋlǝ alɔnuŋtǝpǝ wǝ. Okopiyǝ sa la wǝrʊʊkpǝ wǝ lee kpii. Ŋyǝ okopimumuŋyǝ sa yǝ kaamǝ eyǝ we ŋ pɔ̀rʊ ŋ kanǝ <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />mǝ eniyǝ we ŋ sàanǝ Kǝriso ŋ rù rǝ enyiǝtǝpǝ lǝ mǝrǝ, wǝ́ ŋ nǝ fǝ ŋwǝ ŋ ne ke tiini rǝ ne kǝnirisiɛɛkǝ rǝ yulaarǝ wǝ. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Rǝ fɛɛwǝ we we, asaatiitǝpǝ kpǝlo kɩɩkɩ, okopiyǝ kpǝlo kɩɩkɩ, alɛnyɩkǝ kpǝlo kɩɩkɩ omumuŋpǝ kpǝlo kɩɩkɩ, nyɩŋ ri ŋ nyɩŋ pǝ lóo koru opwo, ŋkǝ rǝ ǝrǝkǝ sa mǝrǝ le kpii ceŋceŋ paa mǝŋ ǝrǝkǝ we kǝ kpii kǝ lǝ́ǝ pǝ we, Kǝriso tɛɛ rǝ yǝlo oŋuŋkǝ. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Worokoyǝ lǝ fǝ tu ri ŋ tu le kpii Kǝriso rǝ akparǝyǝ kǝnǝŋkǝ, wǝ́ ŋ nǝ fǝ ŋwǝ ŋ na tɛɛ rǝ tu ri ŋ tu lo oŋuŋkǝ. Worokoyǝ lǝ fǝ Kǝriso lo koonu ŋ ri mumuŋyǝ ŋ koonu alɔnuŋtǝpǝ la wǝcakukpǝ. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Alɔnuŋtǝpǝ sa pǝ ri Kǝriso la wɛlɛŋrǝ wǝ. Kǝriso kpii rǝ pǝlǝ mǝrǝ milimili, ŋwǝ yǝ we Worokoyǝ ŋ kpii rǝ nǝ mǝrǝ milimili wǝ.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Ru rǝ gbɛŋrǝ ko vɔrʊrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Eniyǝ nɔ we, nǝ wǝfɔkpǝ mǝ nǝ oturɔɔrɔɔyǝ kǝto nǝ kǝ lǝ rǝ mǝŋ enyipǝ pǝ lǝ kpǝ́ kǝtǝ. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Nǝ ke ŋ tii vɔrʊrǝ mǝŋ kǝ́ ǝrǝkǝ le enyipǝ pǝ lée tii vɔrʊrǝ kǝtǝ. Nǝ ke ŋ yee nyǝ ŋ saŋ rǝ awɛɛrɔɔrɔɔyǝ lo kulǝtǝyǝ we ŋ kpii rǝ yulaarǝ mǝ kǝtǝǝwǝ le kǝtiitiikǝ lo tutɛŋwǝ. Ŋrǝ wɛɛrǝ sa ya lée yee anǝnɛyǝ rǝkǝsa rǝ enyipǝ we pǝ le yi pǝ la tɛɛ rǝ Worokoyǝ wǝ. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Loh kpǝlo lǝ kǝ lǝ mǝŋ ŋpǝ kǝtǝ. Le ke ŋ tii vɔrʊrǝ saŋ rǝ lah wɛlɛŋrǝ lo otucakpɛɛyǝ, le ke ŋ yee rǝ tuwǝ we lah wɛlɛŋrǝ mǝ loh yupurǝ yǝ lǝ pǝ́ wǝ. Lǝh wǝlǝkpǝ sa kǝto wǝ́ Worokoyǝ la kpɛɛmʊrʊwǝ wǝ ka tɛɛ rǝ lǝ mǝŋ kǝ́ wǝ tɛɛ rǝ otuturupǝ kǝtǝ wǝ. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Paape Worokoyǝ la tǝlarǝnyɩŋwǝ wǝ naanǝ, wǝ́ ŋ nǝ fǝ kǝǝtaamumuŋwǝ rɛ ŋ na taa lǝ kǝǝwǝ. <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />Ŋ wǝ kǝto we, mǝŋkǝ́ lǝ kpǝ̀ rǝ lah wǝfɔkpǝ paape, wǝ́ ŋ nǝ tǝ ŋ no koonu lǝ vɔrʊrǝ saŋ rǝ Kǝriso. Saŋ rǝ Worokoyǝ la lɛsiɛrɩwǝ kǝto wǝ́ nǝ nya nya alɔkuŋkǝ wǝ. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Kpiikǝ yǝ le yee nyiceŋceŋ mǝ Yesu Kǝriso kǝto, Worokoyǝ la saanǝ lǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ la kʊla mǝ ŋwǝ Kǝriso, wǝ́ ŋ na lɛ ŋ nǝ fǝ lǝ ŋ na kʊla mǝ ŋwǝ ŋ ne ke tiini rǝ yulaarǝ. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Worokoyǝ le yee wǝ ǝnǝ kpiikǝ ŋ náa taa lǝ kǝǝwǝ ŋpa saŋ rǝ Kǝriso kǝto. Mǝŋkǝsa we, lǝ pǝ́ ŋ pɔrʊ na lɛsiɛrɩmumuŋwǝ we wǝ lǝǝ lǝmǝ kǝkpaakǝ ŋ kaŋ epǝ we kpǝlo kɩɩkɩ pǝ kpii pǝ lǝ́ǝ pǝ pǝ pǝ pǝ wǝ. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Duturǝ ɖi saŋ rǝ Worokoyǝ la lɛsiɛrɩwǝ wǝ́ nǝ nya nya alɔkuŋkǝ kpiikǝ nǝ nya lɔ nǝ nyo nuŋ kǝto. Alɔkuŋkǝ sa kǝ loo ru rǝ nǝ kpǝŋ, Worokoyǝ lo tukoonuwǝ wǝ lǝǝwe. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Kǝ laa lɛ kǝ ru rǝ nǝ anǝnɛyeeyǝ rɛ, mǝŋkǝsa kǝ rɛ ŋ paa ca wǝla arekpeyǝ. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Duturǝ ɖi Worokoyǝ ŋ na yaa lǝ. Lo co lǝ rǝ Yesu Kǝriso mǝrǝ kǝ la nya fɛɛ le mǝ yee otuceeceeyǝ we ŋwǝ Worokoyǝ ŋ na kpaka ŋ nǝ tǝnǝ ŋ no coonu wǝ.<verse eid="EPH 2:10" /></para>
  <para style="s">Yǝ le yee nyiceŋceŋ rǝ Kǝriso mǝrǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Nǝ taalǝ tuwǝ nǝ ke ri eniyǝ nɔ wǝ! Nǝ nyee ri Oyudatǝpǝ. Oyudatǝpǝ pǝ lóo pwo nǝ ǝkǝnǝŋ ofufoolǝtǝpǝ<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Rǝ Oyudatǝpǝ lǝ kpǝŋ we, ofufoolǝtǝpǝ pǝ kaamǝ epǝ we pǝ lee ri Worokoyǝ lǝ kǝkpǝŋkǝ, wǝ́ enyikǝǝlǝpǝ pǝ kaamǝ Worokoyǝ lǝ kǝkpǝŋkǝ.</char></note>. Paa pǝ lóo pwo pǝla wɛ ǝkǝnǝŋ enyikǝǝlǝpǝ kpiikǝ pǝ lǝ kǝǝlǝ pǝ kǝto, wǝ́ anyɩmaasɩpǝ pǝ lǝ kǝǝlǝ pǝ ǝnǝ. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Nǝ taalǝ ǝkǝnǝŋ eniyǝ we we, nǝ nyǝǝ kǝ lǝmǝ Mesiyayǝ, wǝ́ nǝ nyǝǝ kǝ lǝmǝ fɛɛtiiwǝ rǝ Isǝrayɛlǝtǝpǝ mǝrǝ, nǝ nyaa ka kʊla mǝ Worokoyǝ le etieyǝ we ŋ pàrǝ ŋ tǝ̀nǝ mǝ nǝ kǝkpǝŋkǝ wǝ. Nǝ ke kpii rǝ ǝrǝkǝ nǝ nyǝǝ kǝ lǝmǝ kpɛɛtɛɛwǝ rɛ wǝ́ nǝ nyee ke ci Worokoyǝ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Paa rǝkǝsa we, ŋnǝ epǝ we nǝ kǝ lǝǝrǝ mǝ Worokoyǝ we, nǝ nye yee nyiceŋceŋ mǝ Yesu Kǝriso, wǝ́ nǝ nyo ruu nǝ nyǝ kǝlǝ mǝ Worokoyǝ saŋ rǝ Yesu Kǝriso la ŋpǝrayǝ we ŋ na lʊ wǝ. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Duturǝ ɖi Kǝriso ŋ nǝ pǝ mǝ wǝtaarǝkpǝ ŋ no koonu lǝ wǝ. La ca Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ le kpii rǝ awɛ wǝ́ pǝ le yee kǝkpǝŋkǝ kǝceŋceŋ. Eniyǝ we ŋ fǝ̀ na wɛlɛŋrǝ ŋ cɛ̀ɛ we, wǝ́ ŋ rè giriŋrǝ we gǝ ŋ sǝpǝ pǝ wǝ́ pǝ kǝ ŋ kpǝlǝ awɛ lǝ kǝǝwǝ ŋ cò. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Yesu la pɔrʊ Mose le seyǝ, ne etietɛŋyǝ mǝ no wǝsuŋkpǝ la cɛ. Le yee wǝ ǝnǝ wǝ́ ŋ na nya fɛɛ ŋ nǝ fǝ Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ ŋ ne yee kǝkpǝŋŋwɛŋkǝ kǝceŋceŋ kpiikǝ pǝ le yee nyiceŋceŋ mǝ ŋwǝ kǝto. Kǝ́ ŋ nǝ pǝ mǝ wǝtaarǝkpǝ ŋ nǝ fǝ wǝǝ. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Saŋ rǝ Kǝriso la gbɛŋrǝ rǝ kpɛtɛkpǝlɛciiwǝ we, lǝ fǝ Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ le yee nyiceŋceŋ, wǝ́ ŋ na ca pǝ ŋ ne kpii mǝ Worokoyǝ. Rǝ kpɛtɛkpǝlɛciiwǝ lo oŋuŋkǝ wǝ́ ŋ nǝ nǝǝnǝ kǝǝkpǝlǝwǝ we wǝ ke kpii rǝ pǝlǝ mǝrǝ wǝ. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Yesu Kǝriso lǝ pǝ la pa tɛŋ wǝtaarǝkpǝ le Dieceeceerǝ we le tíi ŋnǝ epǝ we nǝ kǝ lǝǝrǝ mǝ Worokoyǝ mǝŋ epǝ we pǝ kǝ kǝlǝ mǝ ŋwǝ wǝ. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Yesu Kǝriso kǝto wǝ́ loh kpǝlo, Oyudatǝpǝ mǝ epǝ we pǝ lee ri Oyudatǝpǝ yǝ lóo koru oruu lǝ kǝlǝ mǝ Tǝyǝ la kǝnyɩŋkǝ saŋ rǝ Wɛɛkenikenirǝ we rǝle jeŋceŋ ko.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Wǝ kǝto ŋnǝ epǝ we nǝ nyee ri Oyudatǝpǝ we, nǝ nyǝǝ tǝ nǝ ri ǝsǝǝpǝ amaa ǝsǝtɛlɩtǝpǝ. Paa nǝ ri rǝ Worokoyǝ lǝ kǝkpǝŋkǝ le enyipǝ, nǝ ri Worokoyǝ la kǝsiɛrikǝ le enyipǝ. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Nǝ nya siɛrɩ nǝ nye yee oruyǝ we pǝ lǝ fǝ pǝ la tɔ nyarǝwǝ we wǝ. Enyikpiipǝ we mǝ akpɛɛnuŋtɛŋtǝpǝ pǝ ri kǝtɛɛkǝ wǝ. Wǝ́ Yesu Kǝriso ŋwǝŋwǝ ŋ ri yusirurǝ. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Ŋwǝ ŋ no kuŋ wǝ́ oruyǝ sa yǝ la ta yǝ re wǝ́ giriŋrǝ we gbii láa rɛ kǝ be yee Worokoyǝ la nyarǝkenikeniwǝ koonu Ǝtǝ Woroko. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kǝriso kǝto wǝ́ ŋnǝ ŋkpɛ nǝ kʊla mǝ nyarǝwǝ sa la atɔkǝ, kǝ ŋnǝ mǝ otuturupǝ kpǝlo kɩɩkɩ nǝ pe ri nyarǝwǝ we Worokoyǝ ŋ kpii saŋ rǝ na Wɛɛkenikenirǝ wǝ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Pɔlʊ la kǝnǝnɛkǝ rǝ epǝ we pǝ lee ri Oyudatǝpǝ lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Wǝ kǝto ŋmǝ Pɔlʊ ŋ ya ŋ́ née yee mǝ nyuŋmwɛŋwǝ mǝ ŋ koonu Worokoyǝ rǝ nǝ yurǝ. Ŋ́ ri kukpɛɛtǝyǝ ŋ koonu Yesu Kǝriso rǝ ŋnǝ epǝ we nǝ nyee ri Oyudatǝpǝ lo yurǝ. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Nǝ nyo nuŋ ǝkǝnǝŋ Worokoyǝ le yee mǝ lɛsiɛrɩwǝ wǝ́ ŋ ne kpii mǝ kǝnǝnɛkǝ sa ŋ́ yee ŋ́ koonu nǝ. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Mǝŋ kǝ́ ŋ́ na tɛŋ wǝ tɩpɩrɩ ŋ́ na pa tɛlɩ we, Worokoyǝ la pɔrʊ na kǝnǝnɛkǝ lo tuŋwaawǝ we la kaŋ mǝ kǝ ŋ́ nya fɛɛ ŋ́ ci wǝ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Vǝ́ nǝ nyǝ kǝ mǝ kǝfwɛɛkǝ sa we, nǝ nyóo nuŋ wǝlo duturǝ ǝkǝnǝŋ kǝceece ŋmǝ ŋ́ cii tuŋwaawǝ we ru rǝ Kǝriso. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Eniyǝ nɔ we, Worokoyǝ laa pɔrʊ tuŋwaawǝ sa ŋ kaŋ anyɩmaasɩpǝ. Paa rǝkǝsa we, la pɔrʊ wǝ la kaŋ ne enyikpiikenikenipǝ we mǝ na akpɛɛnuŋtɛŋtǝpǝ saŋ rǝ na Wɛɛkenikenirǝ. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Tuŋwaawǝ we wǝ kaamǝ wǝ ǝnǝ: Kǝ́ epǝ we pǝ lee ri Oyudatyǝpǝ pǝ le yee nyiceŋceŋ mǝ Yesu Kǝriso saŋ rǝ Dieceeceerǝ we pǝ la lɔ pǝ lo nuŋ kǝto we, ŋpǝ ŋkpɛ pǝ láa lɔ ǝtǝtuyǝ we Worokoyǝ ŋ na kʊʊ ŋ nǝ tǝnǝ Oyudatǝpǝ wǝ. Pǝ ri okpuŋtuyǝ pǝ koonu wɛlɛŋrǝ we rǝle jeŋceŋ, ŋpǝ ŋkpɛ pǝ kʊla mǝ Worokoyǝ la garǝ we ŋ no co saŋ rǝ Kǝriso wǝ. <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />Worokoyǝ la saŋ rǝ no okopiyǝ le yee mǝ lɛsiɛrɩwǝ, wǝ́ ŋ na lɔ mǝ rǝ na kǝnǝnɛkǝ kǝ ŋ́ mǝ ŋ tɛŋ ŋrǝ Dieceeceerǝ sa ŋ́ mǝ ŋ tíi epǝ we pǝ lee ri Oyudatǝpǝ wǝ. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Kaŋfɩ ŋmǝ ŋ́ ri ǝtǝtǝǝlǝpǝ lǝ tǝtǝǝlǝyǝ rǝ alɔnuŋtǝpǝ mǝrǝ paape Worokoyǝ le yee mǝ lɛsiɛrɩwǝ ŋmǝ ŋ́ tɛŋ Kǝriso lo otulǝmǝyǝ we yǝ lǝŋ pa lɛ le Dieceeceerǝ ŋ́ tíi epǝ we pǝ lee ri Oyudatǝpǝ wǝ. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Wǝ kpii kǝ ŋ́ lɛ ŋ́ pɔrʊ wǝ ŋ́ kaŋ enyipǝ kpǝlo feŋteŋ, wǝlǝkpǝ Worokoyǝ ŋ ya ŋ née yee no tuŋwaawǝ sa la kǝnǝnɛkǝ mǝ ŋ fǝ wǝ. Ŋwǝ Worokoyǝ we ŋ no co tu ri ŋ tu we, la ŋwaa tuwǝ sa rǝ na wɛ lǝ mǝrǝ ǝrǝ eniyǝ nɔ. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Mǝŋkǝsa we, fǝ rǝkǝsa mǝ ko we, asaatiitǝpǝ mǝ okopiyǝ rǝ yulaarǝ pǝ láa nyɩŋ Worokoyǝ le nimisiewǝ lǝ ǝfǝŋyǝ kpǝlo pǝ ci saŋ rǝ ekǝrisotǝpǝ la wǝcakukpǝ. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Tuwǝ sa wǝ kaa rǝ mǝ Worokoyǝ lo yupulaalɛɛrǝ we ŋ yeli ŋ tǝnǝ ǝrǝ eniyǝ nɔ wǝ. Lo koonu yupurǝ sa lǝ pǝ la saŋ rǝ loh Kulǝtǝyǝ Yesu Kǝriso. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Kǝ́ yǝ le yee nyiceŋceŋ mǝ Kǝriso wǝ́ yǝ la lɔ ŋwǝ yǝ lo nuŋ kǝto we<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Saŋ rǝ Kǝriso la lɔnuŋrǝ».</char></note>, gʊŋrǝ gbɛlɩ goonu lǝ kǝ lǝ kǝlǝ mǝ Worokoyǝ mǝ kpɛɛtɛɛwǝ kpǝlo kɩɩkɩ. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Wǝ kǝto ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ nǝ, nǝ paa maa acʊcʊʊrʊyǝ sa ŋ́ ya ŋ́ náa cʊʊrʊ rǝ nǝ yurǝ we, yǝ kpii nǝ wɛɛyɔɔwǝ. Yǝ lóo koonu nǝ ru okuruyǝ nǝ kʊla rǝ.<verse eid="EPH 3:13" /></para>
  <para style="s">Kǝ́ Yesu ŋ náa taa lǝ kǝǝwǝ mǝ ŋ fǝ wǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Wǝ kǝto ŋ́ náa sʊʊ mǝ ŋ kʊŋ rǝ Tǝyǝ la kǝnyɩŋkǝ, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ŋwǝ yǝ we lǝ kpǝŋ kǝsiɛri ri kǝsiɛri rǝ yulaarǝ mǝŋ kǝtǝǝwǝ kǝ la lɔ kǝla nyɩŋrǝ kǝ lo ru wǝ <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Worokoyǝ naanǝ ŋpa wǝ́ ŋ lǝǝmǝ tu ri ŋ tu, kǝto ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ ŋwǝ ŋ kpii nǝ okopiyǝ ŋpa saŋ rǝ na Wɛɛrǝ. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Worokoyǝ ŋ koonu kǝ Kǝriso ŋ lɔ kǝtiikǝ rǝ nǝ asiɔŋyǝ kpiikǝ nǝ nya lɔ ŋwǝ nǝ nyo nuŋ kǝto. Ŋ lɛ ŋ koonu kǝ nǝ kǝǝtaawǝ wǝ tɔ okuruŋkuyǝ wǝ sʊʊ, kǝ wǝ ta wǝ re kiŋkiŋ. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />Mǝŋkǝsa we, ŋnǝ mǝ Worokoyǝ lǝ kǝkpǝŋkǝ kpǝlo kɩɩkɩ we, nǝ nyóo koru onuŋ duturǝ kǝ́ Kǝriso lǝ kǝǝtaawǝ wǝ yɔkɔ, wǝ konu, wǝ kǝnǝ wǝ́ wǝ suunu wǝ fǝ wǝ, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />kǝ nǝ lɛ nǝ ci Kǝriso lǝ kǝǝtaawǝ we wǝ teeri tu ri ŋ tu nyɩmaasɩyǝ ŋ nóo koru eci wǝ, mǝŋkǝsa we, kǝ nǝ nya fɛɛ nǝ nya Worokoyǝ la vɔrʊrǝ kpǝlo kɩɩkɩ, kǝ ŋ nya kǝtiikǝ rǝ nǝ mǝrǝ milimili.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Ŋwǝ Worokoyǝ we ŋ nóo koru tu ri ŋ tu le eyee mǝ ŋ teeri tuwǝ yǝ lǝ́ǝ pǝ́ ŋwǝ amaa yǝ lóo pu saŋ rǝ no okopiyǝ we yǝ ya yǝ lée yee anǝnɛyǝ rǝ lǝ we, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ŋwǝ kaamǝ ǝkǝkǝ rǝ alɔnuŋtǝpǝ la wǝcakukpǝ mǝ Yesu Kǝriso mǝrǝ eni ri ŋ ni fǝ mǝ ko kǝkpakǝkpa, Amɛnǝ.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Nǝ pǝ kǝ le yee nyuŋceŋceŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Kǝto ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ nǝ, ŋmǝ yǝ ǝnǝ ŋ́ kpii rǝ gukpɛɛkpǝ, kpiikǝ ŋ́ ya ŋ́ née yee anǝnɛyǝ mǝ ŋ koonu Kulǝtǝyǝ kǝto, ǝkǝnǝŋ ŋnǝ epǝ we Worokoyǝ ŋ no pwo we, nǝ tii vɔrʊrǝ nǝ kaamǝ opwokǝ we ŋ no pwo nǝ wǝ. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Nǝ pɛɛlɩ nǝ wɛ fee, kǝ nǝ lɛ nǝ lǝmǝ wǝlǝtaarǝkpǝ mǝ lɛtaarǝwǝ. Nǝ re awɛ mǝ kǝǝtaawǝ. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Wɛɛkenikenirǝ lo koonu nǝ wǝ́ nǝ tini rǝ wǝtaarǝkpǝ mǝrǝ. Wǝtaarǝkpǝ sa wǝ lo koonu wǝ́ nǝ nye yee wǝnyuŋceŋceŋ, kǝto nǝ nyɩɩ nǝ tii rǝ wǝnyuŋceŋceŋkpǝ sa mǝrǝ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Wɛlɛŋrǝ jeŋceŋ ko gbii, wǝ́ Wɛɛkenikenirǝ jeŋceŋ ko gbii, kaa wǝǝ Worokoyǝ lo pwo nǝ koonu ǝrǝŋkǝ kǝceŋceŋ. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Kulǝtǝyǝ ceŋceŋ ko ŋ kpii, tuwǝ we yǝ la lɔ yǝ lo nuŋ we, wǝ lǝ lǝ ceŋceŋ, worokomɛŋwiiriwǝ ceŋceŋ ko wǝ kpii. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Worokoyǝ ceŋceŋ ko ŋ kpii, ŋwǝ ŋ ri Tǝyǝ ŋ koonu enyikpǝlo, ya lée ri wǝpilikpǝ rǝ enyikpǝlo lo oŋuŋkǝ, lée yee anǝnɛyǝ mǝ ŋ saŋ rǝ enyikpǝlo lo oŋuŋkǝ, wǝ́ ŋ kpii rǝ enyikpǝlo lǝ mǝrǝ.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Paape, loh kpǝlo nyi ri ŋ nyi la lɔ Worokoyǝ la lɛsiɛrɩwǝ kpookpoo, mǝŋ kǝ́ Kǝriso ŋ nǝ pǝ́ ŋ koonu lǝ ŋ fǝ wǝ. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Wǝ kǝto Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="EPH 4:8">«Kǝ́ ŋ na rɛ ŋ no ko oŋuŋkǝ we,</para>
  <para style="q1" vid="EPH 4:8">wǝ́ ŋ na lɔ nǝ ǝkǝǝkpǝlǝtǝpǝ ŋ ne re ŋ no ko ɖɔŋpirǝ,</para>
  <para style="q1" vid="EPH 4:8">wǝ́ ŋ na cɛɛ enyipǝ lo otuyǝ».<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />«La rɛ». Wǝlo duturǝ ɖi nɛ? Wǝ ya wǝ láa kaŋ ǝkǝnǝŋ la sʊʊ lo ko ǝrǝ kǝtǝǝwǝ lǝ ǝmǝfuŋyǝ<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Arɛɛpǝ pǝ lo nuŋ wǝlo duturǝ ǝkǝnǝŋ: «La sʊʊ pɔɔlʊwǝ, rǝ kǝtǝǝwǝ.»</char></note>. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Yǝ we ŋ na sʊʊ we, ŋwǝ ke ŋ na rɛ ŋ no ko oŋuŋkǝ lo oŋuŋkǝ ŋ ne teeri kǝ ŋ nya fɛɛ ŋ lǝ ǝrǝkǝ kpǝlo kɩɩkɩ. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Ŋwǝ ŋ na lɛmɩ otukoonuyǝ wǝ. Lo koonu arɛɛpǝ pǝ ri enyikpiipǝ, arɛɛpǝ akpɛɛnuŋtɛŋtǝpǝ, arɛɛpǝ ke Oworokotietɛŋtɛlɩtǝpǝ, apʊŋpwapǝ eretǝpǝ mǝ otukaŋtǝpǝ. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />La lɛmɩ otukoonuyǝ sa ǝnǝ kǝ pǝ fǝ pǝ kpaka Worokoyǝ lǝ kǝkpǝŋkǝ, eniyǝ we we, nyi ri ŋ nyi lóo koru eyee kǝnǝnɛkǝ, kǝ ekǝrisotǝpǝ la wǝcakukpǝ we wǝ tɔ wǝ yaa kiŋkiŋ. Ŋkpǝ wǝcakukpǝ sa wǝ ri Kǝriso la wɛlɛŋrǝ wǝ. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Mǝŋkǝsa we, o lóo turu loh kpǝlo yǝ lǝ lǝmǝ lɔnuŋrǝ jeŋceŋ, kǝ la lɛ le yee nyiceŋceŋ rǝ Worokoyǝ le Piyǝ le ecikǝ, kǝ la wasa le yee ǝpǝrǝŋpǝ la ka kaa mǝ Kǝriso lǝ wǝlǝkpǝ kpaŋ. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />O lóo turu we, yǝ lǝŋ tǝ le ri alaatiepipǝ rɛ otukaŋyǝ kpǝlo yǝ lée re yǝ ŋ ko rǝ sa, yǝ ŋ pǝ rǝ sa mǝŋ kǝ́ mɛŋwǝ wǝ lée siŋki mǝ gbanǝŋwaarǝ kǝtǝ wǝ. Nianiatǝyǝ rɛ lǝŋ tǝ ŋ pǝ fǝ na anianiatǝtukaŋyǝ ŋ tǝǝnǝ lǝ mǝ wǝpiekpǝ ŋ lǝǝrǝ. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Kǝto wǝ kpii kǝ la mǝ taa awɛ lǝ kǝǝwǝ kǝ la mǝ tɛŋ anʊkɔrǝyǝ le mǝ tíi awɛ, kǝ la nya fɛɛ la mǝ wasa rǝ tu ri ŋ tu rǝ Kǝriso, yǝ we ŋ ri yurǝ lǝ mǝrǝ. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Ŋwǝ kǝto wǝ́ wɛlɛŋrǝ kpǝlo kɩɩkɩ la ta ɖe cocoroo, wǝ́ otoŋyǝ yǝ la lɔ wɛlɛŋrǝ yǝ lo toomu fɛɛceŋceŋ. Wǝ́ mǝŋ gbuŋtu ri gbuŋtu ya lée yee rǝla kǝnǝnɛkǝ mǝŋ kǝ́ wǝ lǝ pǝ́ we, o lo turu wɛlɛŋrǝ kpǝlo kɩɩkɩ naanǝ láa rɛ sɩsiɛrɩ kǝ lɛ dɔ yaa kiŋkiŋ rǝ kǝǝtaawǝ mǝrǝ.<verse eid="EPH 4:16" /></para>
  <para style="s">Vɔrʊŋwɛŋrǝ rǝ Kǝriso mǝrǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Kǝto we, tuwǝ ŋ́ ya ŋ́ née tíi nǝ kpuŋkpuruŋ rǝ Kulǝtǝyǝ lǝ mǝrǝ wǝ kaamǝ wǝ ǝnǝ: Nǝ pǝǝ tǝ nǝ tii vɔrʊrǝ mǝŋ enyipǝ we pǝ lee ci Worokoyǝ kǝtǝ wǝ. Pǝlo oyupuyǝ we, tukpaakpaawǝ wǝ lǝǝwe. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Nuŋtumuwǝ wǝ la lɔ kǝtiikǝ rǝ pǝlo oyupuyǝ mǝrǝ, pǝ laa kʊla mǝ vɔrʊrǝ we Worokoyǝ ŋ nóo koonu wǝ, kpiikǝ pǝ lee ci tu ri ŋ tu, wǝ́ pǝ tǝnǝ ziɔŋrǝ. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Pǝ lo yo pǝla nʊŋsɔɔwǝ pǝ lo wo. Pǝ la nyarǝ pǝla wɛ pǝ lo co pǝ lo koonu kǝtuutuukǝ, wǝ́ rǝkǝsa pǝ lǝŋ tǝ pǝ koru awɛɛ mǝ apɔlɔpɔtǝtuyǝ kpǝlo kɩɩkɩ le eyeekǝ.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ŋnǝ paa we, ŋkǝ tuwǝ nǝ nya karǝ nǝ nyo ru rǝ Kǝriso wǝǝ. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Kǝto kǝceece Kǝriso lo oŋuŋkǝ wǝ́ nǝ nyo nuŋ pǝ la wɛɛlɩ pǝ lo ru? Wǝ́ pǝ la kaŋ nǝ otuyǝ pǝ lo ru rǝ anʊkɔrǝyǝ we yǝ kpii rǝ ŋwǝ Yesu mǝrǝ? <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Mǝŋ wǝ lǝ ǝnǝ we, we nǝ nyarǝ nǝ vɔrʊkuukuurǝ we nǝ co. Ŋkpǝ wǝlǝkuukuukpǝ sa wǝ kǝ ŋ pǝlǝ nǝ saŋ rǝ otucakpɛɛrɔɔrɔɔyǝ we yǝ kǝ ŋ tǝǝnǝ nǝ wǝ. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Wǝ kaamǝ kǝ nǝ maa Wɛɛkenikenirǝ ziɛrɩ nǝ ziɔŋrǝ mǝ nǝ oyupuyǝ yee aŋʊŋwɛŋ. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Mǝŋ kǝ́ pǝ lée kpii kǝkpaŋwɛŋkǝ kǝtǝ we, nǝ siɛrɩ nǝ yee nyiŋwɛŋyǝ. Ŋwǝ nyiŋwɛŋyǝ sa we, Worokoyǝ ŋ no co ŋwǝ mǝŋ kǝ́ ŋ nǝ pǝ́ kǝtǝ<note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="ft" closed="false">Pǝ lóo koru alɛ pǝ nuŋ wǝlo duturǝ ǝkǝnǝŋ: «Kǝ ŋ ru Worokoyǝ».</char></note>, kǝ nǝ nya fɛɛ nǝ tii vɔrʊrǝ gʊʊ, lǝ kenikeni lo ru rǝ anʊkɔrǝyǝ wǝ.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Kǝto we, nǝ pǝǝ tǝ nǝ mǝ nia. Nyi ri ŋ nyi ŋ tɛŋ anʊkɔrǝyǝ ŋ tíi na kɛrɩyǝ duturǝ ɖi loh kpǝlo le ri okpuŋtuyǝ lo koonu wɛlɛŋrǝ jeŋceŋ. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Vǝ́ nǝ nyǝ fǝ kpɛɛmʊrʊwǝ we, nǝ pee yee turɔɔrɔɔwǝ. Nǝ kpɛɛmʊrʊwǝ we wǝ taarǝ nǝ kpɛŋ kǝ cɔkɔŋyǝ ŋ ci atɔɔ. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Nǝ poo koonu Abʊŋsamʊyǝ la gʊŋrǝ ŋ nya nǝ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Nyiyǝ we ŋ ka ŋ yɩɩ we, ŋ wɛɛ mǝ ayɩɩkǝ, kǝ ŋ fǝ ŋ tɛɛ rǝ na wɛ mǝ ŋ yee anǝnɛyǝ mǝ na wǝkaakpǝ mǝ anʊkɔrǝyǝ. Mǝŋkǝsa we, lóo koru anya tuwǝ rɛ ŋ toŋ riariatǝyǝ. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Wǝ lee kpii kǝ dierɔɔrɔɔrǝ rɛ ɖu nǝ rǝ nyuŋkpǝ. Nǝ mǝ tɛŋ rǝ etieceeceeyǝ yǝ lóo koru otoŋ kǝ enyipǝ pǝ tɔ pǝ yaa, kǝ pǝ wasa kǝ pǝ lɛ pǝ nya wǝsiɛrɩkpǝ wǝ. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Nǝ pee kpii Wɛɛkenikenirǝ we Worokoyǝ ŋ nǝ fǝ ŋ na tɛɛ nǝ barǝ la kpɛɛmʊrʊwǝ. Duturǝ ɖi ŋrǝ ya lóo koonu nǝ kpɛɛtɛɛwǝ ǝkǝnǝŋ jirǝ rɛ gbii lǝ́ǝ pǝ Worokoyǝ ŋ nah pa pɔrʊ nǝ fee ŋ ru rǝ rɔɔrɔɔwǝ mǝrǝ. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Nǝ paa lɔ nyiyǝ nǝ kpii rǝ kpɛɛwǝ, otuyǝ yǝ pǝǝ tǝ yǝ ŋ fii nǝ wɛɛwǝ, nǝ pǝǝ tǝ nǝ mǝ fǝ kpɛɛmʊrʊwǝ, nǝ pǝǝ tǝ nǝ mǝ kpaŋ, nǝ pǝǝ tǝ nǝ mǝ fɛɛpɩ enyipǝ, nǝ pɔrʊ oyulɛnyɩtuyǝ kpǝlo kɩɩkɩ nǝ cɛ rǝ nǝ mǝrǝ. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Nǝ poŋ mǝ awɛ, kǝ nǝ nya kǝǝnyawǝ mǝ awɛ. Nǝ mǝ fǝ nǝ mǝ cɛɛ awɛ mǝŋ kǝ́ Worokoyǝ ŋ nǝ fǝ ŋ na cɛɛ nǝ saŋ rǝ Kǝriso wǝ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Nǝ tii vɔrʊrǝ rǝ wǝnyɩɩnɩkpǝ lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Kpiikǝ nǝ ri epipǝ Worokoyǝ ŋ náa taa kǝǝwǝ kǝto we, nǝ karǝ ŋwǝ Worokoyǝ lǝ wǝlǝkpǝ. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Nǝ tii vɔrʊrǝ rǝ kǝǝtaawǝ lǝ mǝrǝ mǝŋ kǝ́ Kǝriso ŋ na taa lǝ kǝǝwǝ kǝtǝ, wǝ́ ŋ nǝ fǝ na wɛ la vɔrʊrǝ ŋ no koonu rǝ loh yurǝ, mǝŋ tukoonuwǝ rɛ mǝ toolukɛɛyǝ rɛ la jwɩɩrǝ láa ca Worokoyǝ la kpɛɛwǝ wǝ.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Worokoyǝ le enyipǝ wǝ́ nǝ ri, kǝto we, wǝ laa laka kǝ pǝ ce pǝ tɛŋ nuŋruwǝ la tǝrɛ, apɔlɔpɔtǝtuyǝ la tǝrɛ amaa otulǝmǝyǝ ŋpa le nimimwɛɛrɩwǝ la tǝrɛ rǝ nǝ mǝrǝ. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Wǝ laa lɛ wǝ kaamǝ kǝ nǝ mǝ tɛŋ etieyǝ yǝ lǝŋ poŋ mǝ onuŋkǝ, opurutieyǝ, atʊkpaatuyǝ. Bomu nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ ceeni Worokoyǝ. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Nǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ epǝ we pǝ lée yee nuŋruwǝ, apɔlɔpɔtǝtuyǝ amaa otulǝmǝyǝ ŋpa le nimimwɛɛrɩwǝ we, pǝ lǝŋ pa ka kʊla mǝ Kǝriso mǝ Worokoyǝ le wǝpilirikpǝ we pwi. Duturǝ ɖi otulǝmǝyǝ ŋpa le nimimwɛɛrɩwǝ we, vɛɛsʊmarǝ lǝǝwe.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Rɛ ŋ pǝǝ fǝ ne etiekpaakpaayǝ rɛ ŋ pǝ tǝǝnǝ nǝ, ŋyǝ otuyǝ sa kǝto wǝ́ Worokoyǝ ŋ nǝ́ǝ pǝ mǝ ŋ fǝ kpɛɛmʊrʊwǝ mǝ ŋ tɛɛ rǝ epǝ we pǝ lée yi pǝ ŋ tɛɛ rǝ ŋwǝ wǝ. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Kǝto nǝ paa kʊla mǝ enyipǝ sa wǝrʊʊkpǝ. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Eniyǝ nɔ we, nǝ ke ri rǝ nuŋtumuwǝ le enyipǝ, paa rǝkǝsa kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kulǝtǝyǝ we, nǝ nya siɛrɩ nǝ nye yee wǝnyɩɩnɩkpǝ le enyipǝ. Kǝto nǝ tii vɔrʊrǝ mǝŋ wǝnyɩɩnɩkpǝ le enyipǝ kǝtǝ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Duturǝ ɖi wǝnyɩɩnɩkpǝ lǝ ǝtǝnǝyǝ yǝ kaamǝ eceeceeyeeyǝ, wǝkʊʊkpǝ mǝ anʊkɔrǝyǝ. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Nǝ nyɩɩ kǝ nǝ nyɩŋ tuwǝ we wǝ láa ca Kulǝtǝyǝ la kpɛɛ nǝ ci. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Nǝ paa kʊla mǝ nuŋtumuwǝ le enyipǝ lo otuyǝ we pǝ lée yee yǝ lǝǝ lǝmǝ vasʊyǝ rɛ wǝ! Bomu nǝ saarǝ pǝlǝ yǝ. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Wǝ lóo co nʊŋsɔɔwǝ kʊraa, mǝŋ pǝ la wɛɛlɩ pǝ lo ru rǝ ŋpǝ enyipǝ sa lo otuyǝ pǝ lée yee rǝ kǝŋwaakǝ wǝ. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Paa tu ri ŋ tu pǝ la saarǝ we, wǝ lóo ru wǝnyɩɩnɩkpǝ. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Duturǝ ɖi tuwǝ we wǝ lo ru wǝnyɩɩnɩkpǝ we, wǝ láa siɛrɩ wǝ ŋ yee wǝnyɩɩnɩkpǝ. Wǝ kǝto pǝ láa tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="EPH 5:14">«Saanǝ, ŋlǝ́ yǝ we a ya láa kpɛɛ wǝ,</para>
  <para style="q1" vid="EPH 5:14">yi oru rǝ enyiǝtǝpǝ lǝ mǝrǝ</para>
  <para style="q1" vid="EPH 5:14">kǝ Kǝriso ŋ nyɩnɩ lǝ́». <note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Pǝ lee ci fɛɛwǝ pǝ la pɔrʊ dierǝ sa pǝ lo ru, wǝ lée ri kǝrisotǝnɔŋwǝ rɛ wǝ lǝǝwe.</char></note><verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Kǝto nǝ yee yurǝ sɩsiɛrɩ rǝ wǝlǝkpǝ nǝ nyée tii vɔrʊrǝ nǝ fǝ wǝ. Nǝ pee re nǝ wɛ mǝŋ owuupǝ rɛ kǝtǝ, paa nǝ re nǝ wɛ mǝŋ enimisitǝpǝ kǝtǝ. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Doloŋ ri ŋ doloŋ nǝ nyáa nya we, nǝ yee kǝnǝnɛceeceekǝ rǝ rǝ, duturǝ ɖi eciyǝ sa mǝrǝ le kpii we, yǝ pǝlǝ. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Kǝto nǝ pee ri otuleecitǝpǝ, paa nǝ nyɩɩ kǝ nǝ nuŋ tuwǝ Kulǝtǝyǝ ŋ nǝ́ǝ pǝ́ lo duturǝ.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Nǝ pee mǝ piemu ǝfǝŋpǝ. Ǝfǝŋpiemupǝ pǝ lǝ́ǝ pǝlǝ nyiyǝ la vɔrʊrǝ. Paa nǝ lǝ mǝ Wɛɛkenikenirǝ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Nǝ fǝ Opusomǝpǝ mǝ oworokonɔŋyǝ mǝ Wɛɛrǝ la anɔŋyǝ nǝ ta awɛ lo turuwǝ. Nǝ fǝ ziɔŋrǝ fee nǝ mǝ nɔŋ nǝ mǝ kǝ Kulǝtǝyǝ. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Eni ri ŋ ni we, nǝ mǝ ceeni Woroko Tǝyǝ rǝ tu ri ŋ tu lo yurǝ, saŋ rǝ loh Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ.<verse eid="EPH 5:20" /></para>
  <para style="s">Kǝloŋkǝ we wǝ kaamǝ kǝ kǝ kpii rǝ etiepǝ mǝ pǝlo onuŋpǝ mǝrǝ wǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Ŋnǝ epǝ we nǝ nyóo suu Kǝriso we, nǝ pɛɛlɩ nǝ koonu awɛ. <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />Etiepǝ, nǝ pɛɛlɩ nǝ wɛ nǝ koonu nǝ onuŋpǝ mǝŋ kǝ́ nǝ nyáa pɛɛlɩ nyǝ ŋ koonu Kulǝtǝyǝ kǝtǝ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Duturǝ ɖi pǝrǝŋyǝ ŋ ri yurǝ ŋ koonu tieyǝ mǝŋ kǝ́ Kǝriso ŋ ri yurǝ ŋ koonu ekǝrisotǝpǝ la wǝcakukpǝ kǝtǝ, kpiikǝ Kǝriso ŋ ri Lɔkuŋtǝyǝ ŋ koonu wǝcakukpǝ sa wǝ ri na wɛlɛŋrǝ wǝ. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Mǝŋ kǝ́ ekǝrisotǝpǝ la wǝcakukpǝ wǝ láa pɛɛlɩ wǝ ŋ koonu Kǝriso kǝtǝ we, kǝ́ etiepǝ pǝ láa pɛɛlɩ pǝ koonu pǝlo onuŋpǝ rǝ tu ri ŋ tu mǝrǝ wǝǝ.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Ŋnǝ ǝpǝrǝŋpǝ, nyi ri ŋ nyi ŋ taa ne tieyǝ lǝ kǝǝwǝ mǝŋ kǝ́ Kǝriso ŋ na taa wǝcakukpǝ sa lǝ kǝǝwǝ kǝtǝ wǝ́ ŋ nǝ fǝ na vɔrʊrǝ ŋ no koonu rǝ wǝlo yurǝ wǝ. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />Tuwǝ kǝto ŋ nǝ fǝ mɛŋwǝ mǝ ne Dierǝ ŋ ne wiiri wǝcakukpǝ sa kǝ wǝ nya fɛɛ wǝ ri Worokoyǝ la wǝnɛŋ. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Mǝŋkǝsa we, kǝ ŋ nya fɛɛ ŋ po ru mǝ wǝcakukpǝ sa rǝ ŋwǝŋwǝ na kǝnyɩŋkǝ kǝ anyɩŋ wǝ ponu fee, fɔlɩfɔlɩ fǝ mǝ arɛɛyǝ lo tupiwǝ rɛ rǝ kpǝ, narǝwǝ rɛ wǝ laa tɛɛ rǝ kpǝ, wǝ́ wǝfɔkpǝ rɛ wǝ laa tɛɛ rǝ kpǝ. Lǝ pǝ́ ekǝrisotǝpǝ la wǝcakukpǝ sa wǝ lǝ kenikeni, wǝ pǝǝ lǝmǝ bɔtɔɔrǝ rɛ. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Kaa wǝǝ wǝ kpii kǝ pǝrǝŋyǝ ŋ taa ne tieyǝ lǝ kǝǝwǝ mǝŋ na wɛ kǝtǝ. Pǝrǝŋyǝ we ŋ náa taa ne tieyǝ lǝ kǝǝwǝ we, yǝ we láa taa ŋwǝŋwǝ na wɛlɛŋrǝ lǝ kǝǝwǝ. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Duturǝ ɖi rɛ lee kpii ŋ nǝ́ǝ kpǝlǝ ŋwǝŋwǝ na wɛlɛŋrǝ lǝ kǝǝwǝ. Bomu lóo koonu rǝle keeriwǝ, ŋ yɩrɩ rǝlo yurǝ sɩsiɛrɩ mǝŋ kǝ́ Kǝriso ŋ ne yee mǝ na wǝcakukpǝ sa kǝtǝ wǝ. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Le ri okpuŋtuyǝ lo koonu Kǝriso la wɛlɛŋrǝ. Wǝ kǝto pǝ la tɛŋ rǝ Worokoŋtierǝ mǝrǝ ǝkǝnǝŋ: <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />«Wǝ kǝto pǝrǝŋyǝ lah mǝ pwɛyɩ rǝ nǝ tǝ mǝ ne lee lǝ kpǝŋ ŋ ka kpaa ŋ maarǝ mǝ ne tie. Pǝle eyi pǝ ŋ siɛrɩ pǝ yee nyiceŋceŋ» <note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 2:24">1Mo 2:24</ref></char>. </char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Tuŋwaawǝ we wǝ kpii rǝ fɛɛwǝ sa wǝ naanǝ. Ŋmǝ we, ŋ́ ya ŋ́ náa tɛŋ ǝkǝnǝŋ Kǝriso mǝ wǝcakukpǝ sa wǝ́ pǝ reemǝ. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Paa we, pǝ reemǝ ŋnǝ ŋkpɛ, wǝ kpii kǝ nyi ri ŋ nyi ŋ taa ne tieyǝ lǝ kǝǝwǝ mǝŋ ŋwǝŋwǝ na wɛ kǝtǝ, kǝ tie ri ŋ tie ŋwǝ ŋkpɛ ŋ pu no nuŋyǝ.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Kǝloŋkǝ we wǝ kaamǝ kǝ kǝ kpii rǝ epipǝ mǝ pǝlǝ ǝmǝtǝpǝ mǝrǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Epipǝ, nǝ co kǝtukoŋkǝ rǝ nǝ ǝmǝtǝpǝ lo tutɛŋwǝ, mǝŋ kǝ́ Kulǝtǝyǝ ŋ nǝ pǝ́ wǝ kǝtǝ, duturǝ ɖi tuwǝ wǝ lǝ pǝ́ kǝ piyǝ ŋ yee wǝǝ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Worokoyǝ lo tutɛŋwǝ rɛ wǝ la tɛŋ ǝkǝnǝŋ: «Pu lǝ́ tǝ mǝ lé le». Ŋ wǝ wǝ ri tutɛŋsǝsǝŋwǝ Worokoyǝ ŋ nǝ fǝ kacowǝ ŋ na kʊla wǝ. <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />«Kǝ wǝ poŋ wǝ koonu lǝ́, kǝ a lɛ e tii wǝkpaakpǝ rǝ kǝtǝǝwǝ sa».<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Ŋnǝ ǝtǝpǝ, nǝ pee mǝ kpii nǝ epipǝ la kpɛɛmʊrʊwǝ, paa nǝ re pǝ sɩsiɛrɩ kǝ nǝ kʊʊrʊ pǝ mǝŋ kǝ́ Kulǝtǝyǝ ŋ nǝ pǝ́ wǝ kǝtǝ.<verse eid="EPH 6:4" /></para>
  <para style="s">Kǝloŋkǝ we wǝ kaamǝ kǝ kǝ kpii rǝ arɔŋpǝ mǝ pǝlo okulǝtǝpǝ mǝrǝ wǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Ŋnǝ arɔŋpǝ, nǝ co kǝtukoŋkǝ rǝ nǝ okulǝtǝpǝ rǝ kǝtǝǝwǝ sa mǝ vusuurǝ mǝ wɛɛpɛɛlɩwǝ mǝ ziɔŋceeceerǝ kǝ atɛŋ Kǝriso wǝ́ nǝ ya nǝ nyáa sʊma. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Ŋkǝ eniyǝ we pǝ ya pǝ láa yɩrɩ nǝ ceŋceŋ ko wǝ́ nǝ nyée mǝ yee wǝ ǝnǝ, kǝ atɛŋ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ poŋ mǝ enyipǝ rǝ. Paa mǝŋ Kǝriso la arɔŋpǝ kǝtǝ we, nǝ fǝ nǝ ziɔŋrǝ fee nǝ mǝ yee Worokoyǝ lǝ kǝǝpǝ́wǝ. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Nǝ fǝ ziɔŋceeceerǝ nǝ sʊma pǝ kǝ atɛŋ ŋnǝ nǝ ya nǝ nyáa sʊma Kulǝtǝyǝ rǝ, ŋkǝ anyɩmaasɩpǝ. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Nǝ cii wǝ ǝkǝnǝŋ nyi ri ŋ nyi le ceeceewǝ ŋ ne yee we, yǝ we ŋ ke ri rɔŋyǝ amaa nyiyǝ ŋ tini ŋ koonu na wɛ we, lah ka lɔ wǝlo wǝtoomwarakpǝ rǝ Kulǝtǝyǝ lǝ kpǝŋ.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Ŋnǝ okulǝtǝpǝ, ŋnǝ ŋkpɛ nǝ mǝ yee mǝŋkǝsa ko rǝ nǝ arɔŋpǝ lǝ kpǝŋ. Nǝ pǝǝ tǝ nǝ mǝ fapǝ pǝ. Nǝ cii wǝ ǝkǝnǝŋ mǝŋ ŋnǝ, mǝŋ ŋpǝ nǝ lǝǝmǝ Kulǝtǝyǝ ceŋceŋ ŋ kpii rǝ yulaarǝ. Ŋwǝ we, lǝŋ yɩrɩ rǝ anyɩŋkǝ ŋ yee tǝrɛ.<verse eid="EPH 6:9" /></para>
  <para style="s">Worokoyǝ la akɔŋtuyǝ we ŋ nóo koonu wǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Mǝ dietutururǝ ŋ́ neh tíi nǝ gaamǝ ɖǝ ǝnǝ: Kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kulǝtǝyǝ we, nǝ lɔ okopiyǝ nǝ ru rǝ no okopimumuŋyǝ we lǝ mǝrǝ. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Nǝ fǝ Worokoyǝ la akɔŋtuyǝ we kpǝlo kɩɩkɩ nǝ po, kǝ nǝ koru eyi nǝ tɛɛ rǝ Abʊŋsamʊyǝ le wǝpiekpǝ. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Duturǝ ɖi ŋkǝ la ya yǝ lée yee akɔŋkǝ mǝ anyɩmaasɩpǝ, paa la ya yǝ lée yee akɔŋkǝ mǝ awɛɛrɔɔrɔɔyǝ lo okopiyǝ we yǝ kpii rǝ yulaarǝ, asaatiitǝpǝ mǝ okulǝtǝpǝ we pǝ re otumurǝkǝ sa wǝ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Kǝto rǝkǝsa we, nǝ fǝ Worokoyǝ la akɔŋtuyǝ we kpǝlo kɩɩkɩ nǝ po. Mǝŋkǝsa vǝ́ jirɔɔrɔɔrǝ we lo ro we, kǝ nǝ koru atɔ nǝ yaa. Vǝ́ nǝ nya kɔŋ nǝ nya ka lɛ rǝ we, kǝ anyɩŋ nǝ tǝ nǝ yaa kiŋkiŋ. <figure style="fig" alt="Les armes dʼun soldat romain" file="hk00194c.tif" size="col" copy="Horace Knowles" ref="6:11">Akɔŋtuyǝ</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Kǝto nǝ yi nǝ yaa! Nǝ fǝ anʊkɔrǝyǝ nǝ parǝ kǝtɔŋkǝ mǝŋ apɔsɔyǝ kǝtǝ. Nǝ fǝ wǝkʊʊkpǝ nǝ kpii mǝŋ kǝtʊkʊkpakǝ kǝtǝ <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Nǝ fǝ wɛɛlɛŋwǝ nǝ kpii rǝ Dieceeceerǝ we lóo koonu wǝtaarǝkpǝ la atɛŋkǝ mǝŋ kǝ́ yǝ lée kpii afʊkpayǝ kǝtǝ. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Eni ri ŋ ni we, nǝ ta lɔnuŋrǝ nǝ re mǝŋ kǝ́ pǝ lée re tukaawɛɛwǝ mǝ akaakǝ kǝtǝ. Wǝ lóo toŋ nǝ kǝ nǝ fǝ nǝ rǝǝnǝ Kɛrɩrɔɔrɔɔyǝ we<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Satana wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo rǝ Bibǝlayǝ mǝrǝ ǝkǝnǝŋ: «Kɛrɩrɔɔrɔɔyǝ».</char></note> la wǝtɛnɩkpǝ we kpǝlo kɩɩkɩ wǝ ya wǝ láa ta naawǝ wǝ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Nǝ fǝ Worokoyǝ la alɔkuŋkǝ sa nǝ sii yurǝ mǝŋ dʊkʊtuurǝ kǝtǝ, kǝ nǝ lɔ Wɛɛkenikenirǝ la tʊkʊwǝ sa, wǝ kaamǝ Worokoyǝ le Dierǝ. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Nǝ maa Wɛɛkenikenirǝ ɖe nǝ rǝ nǝ eni ri ŋ ni lo onyuŋmwɛŋyǝ mǝ otupǝ́yǝ kpǝlo kɩɩkɩ. Nǝ kpaka nǝ tii nǝ mǝ rǝŋ, kǝ nǝ mǝ mwɛŋ nyuŋkpǝ kpuŋkpuruŋ nǝ mǝ koonu Worokoyǝ lǝ kǝkpǝŋkǝ we kpǝlo. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu ŋmǝ ŋkpɛ, kǝ Worokoyǝ ŋ fǝ ne Dierǝ ŋ kpii mǝ rǝ nyuŋkpǝ, kǝ ŋ́ nya fɛɛ ŋ́ pɔrʊ tuŋwaawǝ we wǝ kpii rǝ Dieceeceerǝ sa ŋ́ kaŋ mǝ turusǝŋwǝ. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Duturǝ ɖi ŋrǝ kǝto wǝ́ ŋ́ ri nyikpiiyǝ, wǝ́ ŋ́ lɛ ŋ́ kpii rǝ gukpɛɛkpǝ wǝ. Kǝto nǝ mwɛŋ nyuŋkpǝ nǝ koonu mǝ kǝ ŋ́ nya fɛɛ mǝ ŋ tɛŋ rǝ mǝ turusǝŋwǝ mǝŋ kǝ́ wǝ kaamǝ kǝ ŋ́ tɛŋ rǝ wǝ.<verse eid="EPH 6:20" /></para>
  <para style="s">Eceenituturukǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Ŋ́ nǝ pǝ́ kǝ ŋnǝ ŋkpɛ nǝ ci kǝ́ wǝ ya wǝ lóo ko wǝ ŋ fǝ rǝ mǝ kpǝŋ wǝ. Lah paanʊkǝǝtaatǝyǝ Tisiko ŋ ya ŋ née yee anǝnɛyǝ mǝ anʊkɔrǝyǝ mǝ ŋ koonu Kulǝtǝyǝ we, lah pa pɔ nǝ mǝ amayǝ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Kǝto ŋ́ neh kpii ŋwǝ ŋ́ maŋ nǝ, kǝ ŋ pe tíi nǝ kǝ́ le kpii lǝ fǝ wǝ, kǝ ŋ pa ta nǝ turuwǝ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Worokoyǝ we ŋ ri Tǝyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso pǝ koonu lǝh ǝtǝŋpǝ we kpǝlo kɩɩkɩ la wǝtaarǝkpǝ, kǝǝtaawǝ mǝ lɔnuŋrǝ. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Epǝ we kpǝlo kɩɩkɩ pǝ láa taa loh Kulǝtǝyǝ Yesu Kǝriso lǝ kǝǝwǝ mǝ kǝǝtaawǝ we wǝ lǝŋ pa lɛ we, Worokoyǝ ŋ yee pǝ la lɛsiɛrɩwǝ.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>