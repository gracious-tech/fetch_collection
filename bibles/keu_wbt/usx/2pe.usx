<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">2 Pɛtǝro</para>
  <para style="toc3">2Pɛ</para>
  <para style="toc2">2 Pɛtǝro</para>
  <para style="toc1">Pɛtǝro la kǝfwɛɛyitǝkǝ</para>
  <para style="mt1">Pɛtǝro</para>
  <para style="mt2">la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɛtǝro la ŋʊrʊ kǝfwɛɛyitǝkǝ sa la maŋ epǝ we ŋ manǝ na kǝfwɛɛsǝsǝŋkǝ we wǝ. No yupurǝ kororo gaamǝ ǝkǝnǝŋ ŋ yi ŋ tɛɛ rǝ enyipǝ we pǝ ya pǝ láa kaŋ otuyǝ yǝ laa kaamǝ Dieceeceerǝ we, mǝ vɔrʊrɔɔrɔɔrǝ we pǝ ya pǝ láa kaŋ enyipǝ saŋ rǝ pǝlo otukaŋyǝ sa wǝ. Pɛtǝro le tíi ekǝrisotǝpǝ ǝkǝnǝŋ, tuwǝ pǝ lée yee kǝ pǝ ri otuyǝ sa lo yurǝ wǝ kaamǝ wǝ ǝnǝ: Pǝ ci Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso sɩsiɛrɩ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-2</para>
  <para style="io">- Kǝ́ Worokoyǝ ŋ no pwo lǝ, wǝ́ ŋ na saa lǝ ŋ na pɔrʊ ŋ nǝ fǝ wǝ 1:3-21</para>
  <para style="io">- Anianiatǝtukaŋtǝpǝ 2:1-22</para>
  <para style="io">- Yesu la asiɛnɩpǝkǝ 3:1-18</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Ŋmǝ Sɩmɔ Pɛtǝro, ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa. Yesu Kǝriso la sʊmatǝyǝ mǝ ne nyikpiiyǝ wǝ́ ŋ́ ri. Ŋ́ ya ŋ́ náa ŋʊrʊ ŋ́ maŋ epǝ we pǝ la lɔ lɔnuŋrǝ rɛ lo ru okuruyǝ la kaamǝ lah nɛŋrǝ sa wǝ. Loh Worokoyǝ mǝ Lɔkuŋtǝyǝ Yesu Kǝriso ŋ no koonu pǝ la lɔnuŋrǝ sa kpiikǝ ŋ kʊʊ kǝto. <verse eid="2PE 1:1" /><verse number="2" style="v" sid="2PE 1:2" />Worokoyǝ la lɛsiɛrɩwǝ mǝ na wǝtaarǝkpǝ wǝ pǝ wǝ koonu nǝ ŋpaŋpa saŋ rǝ kǝ́ nǝ cii Worokoyǝ mǝ loh Kulǝtǝyǝ Yesu kǝto.<verse eid="2PE 1:2" /></para>
  <para style="s">Worokoyǝ lo pwo lǝ wǝ́ ŋ na saa lǝ ŋ na pɔrʊ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Saŋ rǝ no okopiyǝ we, Worokoyǝ lo koonu lǝ tu ri ŋ tu wǝ lǝ kpuŋkpuruŋ wǝ koonu kǝ́ yǝ lée tii vɔrʊrǝ kǝ la sʊma ŋwǝ wǝ. Awo, lo koonu lǝ yǝ le ci ŋwǝ yǝ we ŋ no pwo lǝ saŋ rǝ ŋwǝŋwǝ na anaanǝkǝ mǝ no okopiyǝ we yǝ lée yee anǝnɛyǝ wǝ. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Saŋ rǝ na anaanǝkǝ sa mǝ no okopiyǝ sa we, wǝ́ Worokoyǝ ŋ nǝ fǝ otuceeceeyǝ we yǝ la lɔ okurumumuŋyǝ yǝ le teeri ŋ no koonu lǝ. Ŋyǝ otuyǝ sa wǝ́ ŋ cò lǝ garǝ wǝ. Mǝŋkǝsa we, saŋ rǝ ŋyǝ otuyǝ sa nǝ nya lɔ we, nǝ nyóo koru awaarǝ nǝ cɛ rǝ otucakpɛɛrɔɔrɔɔyǝ we yǝ ya yǝ lǝ́ǝ pǝlǝ enyipǝ rǝ ǝrǝkǝ mǝrǝ, kǝ nǝ nya fɛɛ nǝ ka kaa mǝ Worokoyǝ lǝ wǝlǝkpǝ. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Ŋ wǝ kǝto we, nǝ nyɩɩ ŋpa kǝ nǝ fǝ wǝlǝceeceekpǝ nǝ kʊla mǝ nǝ lɔnuŋrǝ. Fǝ kʊla mǝ nǝ wǝlǝceeceekpǝ sa we, Worokoyǝ le ecikǝ. <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />Fǝ kʊla mǝ Worokoyǝ le ecikǝ we, lá wɛ lo yurirǝ. Fǝ kʊla mǝ lá wɛ lo yurirǝ we, atɔyaakǝ. Fǝ kʊla mǝ atɔyaakǝ we, worokoŋsʊmarǝ. <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />Fǝ kʊla mǝ worokoŋsʊmarǝ we, kǝpaanʊyeekǝ. Fǝ kʊla mǝ kǝpaanʊyeekǝ we, kǝǝtaawǝ. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Duturǝ ɖi mǝŋ wǝlǝceeceekpǝ sa wǝ kpii rǝ nǝ mǝrǝ wǝ́ wǝ la lɔ kǝtiikǝ ŋpa we, wǝ lóo koonu kǝ nǝ mǝ yee kǝnǝnɛkǝ kǝ nǝ tǝ nǝ mǝ ci loh Kulǝtǝyǝ Yesu Kǝriso nǝ mǝ kʊla. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Paa mǝŋ rɛ lǝǝ lǝmǝ wǝlǝceeceekpǝ sa we, yǝ we ri rǝ laanyɩŋtǝyǝ, ne enimiyǝ yǝ le simi. Lo yukpɛ ǝkǝnǝŋ no oturɔɔrɔɔyǝ we ŋ yeli ŋ pǝlǝ ŋ tɛ̀lɩ eniyǝ nɔ we, pǝ la wɛɛ yǝ pǝ la cɛ rǝ ŋwǝ. <verse eid="2PE 1:9" /><verse number="10" style="v" sid="2PE 1:10" />Kǝto we lǝh ǝtǝŋ, nǝ tǝ nǝ mǝ nyɩɩ nǝ mǝ kʊla kǝ nǝ tɔ nǝ yaa, kǝ wǝ fǝ wǝ pɔrʊ opwokǝ we Worokoyǝ ŋ no pwo nǝ mǝ asaapɔrʊkǝ we ŋ na saa nǝ ŋ na pɔrʊ wǝ kaŋ. Mǝŋ nǝ ya nǝ nyée yee wǝ ǝnǝ we, nǝ nyǝŋ po ru nǝ tɔɔ rǝ nǝ lɔnuŋrǝ pwi. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Mǝŋkǝsa we, loh Kulǝtǝyǝ mǝ lah Lɔkuŋtǝyǝ Yesu Kǝriso le wǝpilirilaalɛɛkpǝ we la aŋwaayǝ yǝ láa taanǝ yǝ koonu lǝ feŋteŋ.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Nǝ nyǝŋ nyɩŋ tuwǝ kǝto ŋ́ nǝ pǝ́ ŋ́ mǝ ŋ taalǝ nǝ ŋyǝ otuyǝ sa eni ri ŋ ni, mǝŋkǝ́ nǝ cii yǝ wǝ́ nǝ nya tɔ nǝ nya yaa rǝ anʊkɔrǝyǝ sa paape. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Kǝ́ ŋ́ nya ŋ́ kpii vɔrʊrǝ ko we, ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ wǝ kaamǝ kǝ mǝ ŋ saanǝ nǝ saŋ rǝ kǝ́ ŋ́ náa mǝ taalǝ nǝ otuyǝ sa wǝ. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />Duturǝ ɖi ŋ́ cii wǝ sɩsiɛrɩ mǝŋ kǝ́ loh Kulǝtǝyǝ Yesu Kǝriso ŋ no koonu mǝ ŋ́ ne ci wǝ ǝkǝnǝŋ mǝ enikpǝ́yǝ yǝ lǝ kǝlǝ. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Paape ŋ́ náa nyɩɩ, kǝ oturu rǝ mǝ ǝkpǝ́kǝ la kǝmaa we, kǝ nǝ koru a mǝ taalǝ ŋyǝ otuyǝ sa eni ri ŋ ni.<verse eid="2PE 1:15" /></para>
  <para style="s">Epǝ we pǝ la nyɩŋ Kǝriso la wǝnyɩɩnɩkpǝ wǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Yǝ lo koonu nǝ nye ci kǝ́ loh Kulǝtǝyǝ Yesu Kǝriso ŋ nǝh pǝ pǝ mǝ okopiyǝ wǝ, wǝ lee ri etiekpǝtɛŋyǝ rɛ pǝ la kpaka mǝ eceŋ mǝ eceŋ wǝ́ le siimǝ. Paa we, yǝ la nyɩŋ ŋwǝ rǝ na wǝnyɩɩnɩkpǝ kpǝlo kɩɩkɩ lǝ mǝrǝ mǝ leh enimiyǝ. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Duturǝ ɖi lɔ̀ ǝkǝkǝ mǝ anaanǝkǝ rù rǝ Worokoyǝ we ŋ ri Tǝyǝ lǝ kpǝŋ. Eniyǝ we wǝ́ ŋ nunu Woroko Kopilǝtǝyǝ la kpɛɛwǝ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ ri mǝ Piyǝ ŋ́ náa taa kǝǝwǝ ŋpa wǝ. Ŋ́ na nya mǝ faawǝ kɩɩkɩ rǝ ŋwǝ.» <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Ŋlǝŋlǝ lo nunu kpɛɛwǝ sa wǝ rù rǝ yulaarǝ wǝ, eniyǝ we la ka yaa la kʊ̀la mǝ ŋwǝ Yesu rǝ dutupikenikenirǝ we lo oŋuŋkǝ. <verse eid="2PE 1:18" /><verse number="19" style="v" sid="2PE 1:19" />Tǝ fǝ kʊla we, lǝ lǝǝmǝ kpɛɛtɛɛwǝ ŋpa rǝ oworokokpɛɛnuŋtɛŋtǝpǝ le dierǝ. Wǝ́ nǝ tuwǝ wǝ ponu mǝ kǝ́ nǝ nyo co nimirǝ rǝ ŋrǝ dierǝ sa wǝ. Duturǝ ɖi lǝ rǝ mǝŋ kaŋrewǝ rɛ wǝ ya wǝ láa nyɩnɩ rǝ fɛɛwǝ rɛ wǝ lǝ kurukuru kǝtǝ, ko ro ǝrǝ kǝ́ rǝkaalǝwǝ wǝ láa nyɩnɩ wǝ, kǝ́ kǝrokoŋpiŋɔŋkǝ kǝ lóo poŋ rǝ nǝ asiɔŋyǝ mǝrǝ wǝ. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Coŋ koonu tu ri ŋ tu we, nǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ rɛ lee kpii ŋ née yi ŋwǝŋwǝ ko kǝ ŋ pɔrʊ Wǝŋʊrʊkenikenikpǝ la kpɛɛnuŋtɛŋwǝ rɛ lo duturǝ. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Kpiikǝ kpɛɛnuŋtɛŋwǝ rɛ mǝŋ ceŋceŋ wǝ lee kpii wǝ lo ru rǝ nyɩmaasɩyǝ lǝ kǝǝpǝ́wǝ. Paa Wɛɛkenikenirǝ lée re yǝ, oturu anyɩmaasɩpǝ pǝ lo nuŋ yǝ pǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ pǝ la tɛŋ.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Anianiatǝtukaŋtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Eniyǝ nɔ we, anianiatǝkpɛɛnuŋtɛŋtǝpǝ pǝ ke kpii pǝ kʊ̀la mǝ kǝkpǝŋkǝ, kaa wǝǝ anianiatǝtukaŋtǝpǝ pǝ leh pe kpii rǝ nǝ mǝrǝ. Pǝ láa ŋwaa mǝ wǝpiekpǝ pǝ re anianiatǝtukaŋyǝ yǝ lǝ́ǝ lǝǝrǝ enyipǝ pǝ pǝ, pǝ lǝ́ǝ sǝ́ŋ pǝlo Kulǝtǝyǝ we ŋ na lɔ pǝ ŋ no fuu pǝ co kʊraa. Mǝŋkǝsa we, pǝ láa taa wǝrɔɔrɔɔkpǝ rɛ wǝ lǝ́ǝ lǝǝrǝ pǝ pǝ co pǝla wɛ wǝ lǝŋ panǝ. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Wǝ́ enyipǝ wa pǝ leh pe yi pǝ siimǝ pǝ rǝ pǝla kǝtʊkpaakǝ we mǝrǝ. Pǝlo yurǝ kǝto enyipǝ pǝ lah pa ya pǝ ŋ wɛɛlɩ rɔɔrɔɔ pǝ ŋ ru rǝ anʊkɔrǝyǝ la cawǝ sa. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Wǝ́ kpiikǝ pǝ láa mwɛɛrɩ nimirǝ rǝ sɩkayǝ kǝto we, pǝ lǝh pǝ fǝ etiekpǝtɛŋyǝ rɛ pǝ ŋ tǝǝnǝ nǝ pǝ ŋ ri. Ŋpǝ enyipǝ sa we, ǝrǝ eniyǝ nɔ wǝ́ pǝ la kpaka pǝla wǝkpaŋtɛŋkpǝ pǝ lǝ tǝnǝ pǝ, wǝ́ pǝlǝ ǝkpǝ́nǝŋkǝ kǝ lǝǝ lǝǝrǝ.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Duturǝ ɖi Worokoyǝ laa nyɩŋ epicoŋpipǝ we pǝ yeli turɔɔrɔɔwǝ la tǝlarǝwǝ, fǝ̀ pǝ tìe kpìi rǝ naalaalɛɛwǝ, wǝ́ ŋ kpìi pǝ la akpɛtɛɛyǝ ŋ tǝ̀nǝ rǝ nuŋtumuwǝ koonu wǝkpaŋtɛŋkpǝ le jirǝ. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Worokoyǝ laa lɛ ŋ nyɩŋ akakatǝpǝ we la tǝlarǝwǝ, wǝ́ ŋ kòonu ŋʊŋtɛmumuŋyǝ we ŋ nǝ̀ǝnǝ enyirɔɔrɔɔpǝ rǝ ǝrǝkǝ, paa wǝ́ ŋ pɔ̀rʊ Nowa yǝ we ŋ ka ŋ tɛŋ mǝ ŋ tíi enyipǝ ǝkǝnǝŋ pǝ tii vɔrʊrǝ gʊʊ wǝ. Ŋwǝ ŋ ke ri nyinɛŋtǝyǝ ŋ ka kʊla mǝ enyituturupǝ we apǝrɩmatapǝ wǝ. <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Worokoyǝ lɛ̀ tɔ̀ɔ Sodomǝ mǝ Gomora lǝ ǝtǝŋtǝǝyǝ la bɔrǝ wǝ́ ŋ kòonu yǝ yeli naawǝ pukupuku kǝ wǝ ri tunyɩŋcamǝwǝ wǝ koonu enyirɔɔrɔɔpǝ we pǝ kpii pǝ lǝ́ǝ pǝ pǝ pe tii wǝ. <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Paa wǝ́ ŋ pɔ̀rʊ Lɔtǝ, ŋ ke ri nyikʊʊyǝ wǝ. Enyirɔɔrɔɔpǝ lo nuŋruyeetǝfɔrʊrǝ we pǝ ke re ge ŋ kpii Lɔtǝ la awɛɛlɩkǝ ŋpa. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Duturǝ ɖi ŋwǝ nyikʊʊyǝ sa ke kpii rǝ enyirɔɔrɔɔpǝ we lǝ mǝrǝ, ka ŋ nyɩŋ pǝla vɔrʊrɔɔrɔɔrǝ wǝ́ ŋ ko ŋ nuŋ pǝle etierɔɔrɔɔyǝ we pǝ ka ŋ tɛŋ wǝ. Kǝto ji ri ŋ ji we, wǝ ke ŋ kpii ŋwǝ nyikʊʊyǝ sa la ziɔŋrǝ la awɛɛlɩkǝ mǝŋ ŋ kpǝ́ rǝ. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />We wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Ǝtǝ Woroko lóo koru apɔrʊ enyikʊʊpǝ ŋ ru rǝ acʊcʊʊrʊyǝ mǝrǝ, kǝ ŋ maa enyilaakʊʊpǝ ŋ tǝnǝ ŋ pa ta pǝlo kǝtukoŋkǝ mǝ jirǝ we ŋ náa tɛŋ akpaŋyǝ wǝ, <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />otukpǝlo láa ta epǝ we pǝ suu pǝ tɛɛmǝ pǝla wɛlɛŋrǝ lo otucakpɛɛrɔɔrɔɔyǝ pǝ láa tɛlɩ lo kǝtukoŋkǝ. Apɔlɔpɔtǝtuyǝ ko yǝ láa sʊʊ ŋpǝ enyipǝ sa, pǝ lǝŋ kǝ Ǝtǝ Woroko le wǝpilirikpǝ pǝ kpii rǝ tǝrɛ.</para>
  <para style="p" vid="2PE 2:10">Ŋpǝ anianiatǝtukaŋtǝpǝ sa pǝ láa nyɩŋ pǝla wɛ kururu, pǝ láa rɛɛrɩ mǝ pǝla wɛ, wǝ́ wǝ lǝŋ lɛ wǝ co pǝ lo vurǝ kǝ́ pǝ láa fɛɛ otuyǝ we yǝ kpii vɔrʊrǝ rǝ yulaarǝ yǝ lo ru okuruyǝ wǝ. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Nǝ yɩrɩ re, epicoŋpipǝ pǝ lǝǝmǝ okopiyǝ pǝ teeri ŋyǝ otuyǝ sa, wǝ́ pǝ lɛnyɩ pǝ teeri yǝ. Paape pǝ lǝŋ tɛŋ dierǝ rɛ pǝ fɛɛ yǝ rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ! <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Ŋpǝ enyipǝ sa we, pǝ lǝ rǝ mǝŋ apɔɔkɛɛpǝ pǝ lee ci otuyǝ, pǝ lo ru ǝrǝkǝ pǝ pa tɔɔ kpɛrɛwǝ kǝ pǝ kpǝ́ pǝ co rǝ, paape pǝ ya pǝ láa fɛɛpɩ tuwǝ we pǝ lee ci wǝ. Pǝ lǝh pǝ kpǝ́ pǝ co mǝŋ kǝ́ apɔɔkɛɛpǝ pǝ lǝ́ǝ kpǝ́ pǝ ŋ co kǝtǝ. <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />Pǝ láa lɔ rɔɔrɔɔwǝ we pǝ le yee lo wǝtoomwarakpǝ. Jɔkɔŋrǝ ketekete a pǝ ŋ nyarǝ pǝla wɛ pǝ co pǝ ŋ yee pǝlo otucakpɛɛrɔɔrɔɔyǝ we, wǝ́ tuwǝ wǝ láa ca pǝla kpɛɛwǝ wǝǝ. Arɛɛyǝ mǝ otucɛɛlɩyǝ ko wǝ́ pǝ ri, pǝ láa nya faawǝ rǝ pǝla niarǝ vǝ́ pǝ tini pǝ lée ri wǝcɛkpǝ mǝ nǝ. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Onuŋruyeetǝnimiyǝ wǝ́ pǝ re pǝ láa tɛlɩ, pǝ lǝŋ faŋ mǝ turɔɔrɔɔwǝ le eyeekǝ, pǝ lǝ́ǝ tǝǝnǝ enyipǝ we pǝ laa tɔ pǝ yaa sɩsiɛrɩ pǝ ŋ kpii. Sɩkanimimwɛɛrɩwǝ wǝ la kaa pǝla asiɔŋyǝ le nimirǝ. Ŋpǝ enyipǝ sa we, Worokoyǝ la vwɛɛrɩrǝ dɛɛ rǝ pǝ. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Pǝ la nyarǝ gʊŋkʊʊrǝ pǝ lo co, wǝ́ pǝ lǝ lǝǝ pǝ le siimǝ Bosɔɔ le pi Balamǝ la cawǝ. Balamǝ wǝ́ pǝ mwàra sɩkayǝ kǝ ŋ ke yee turɔɔrɔɔwǝ wǝ. Wǝ́ ŋ màa sɩkayǝ sa ŋ cà na kpɛɛ. <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />Paa Worokoyǝ kpanǝ mǝ ŋwǝ rǝ no turɔɔrɔɔwǝ we ŋ yeli wǝ. Rookɛtɛyǝ ŋ nǝǝ lǝmǝ kǝrǝkǝ ŋ náa wɛɛlɩ rǝ, ŋ wɛ̀ɛlɩ nyɩmaasɩkpɛɛwǝ, wǝ́ ŋ yàalǝ kpɛɛnuŋtɛŋtǝyǝ lo yufiitǝtuwǝ we ŋ ke ŋ yee wǝ. <verse eid="2PE 2:16" /><verse number="17" style="v" sid="2PE 2:17" />Anianiatǝtukaŋtǝpǝ sa pǝ lǝ rǝ mǝŋ amɛŋfuŋpiyǝ rɛ yǝ lǝŋ wee mɛŋwǝ kǝtǝ, amaa aŋɔɔyǝ rɛ ǝrǝfuŋmumuŋkǝ kǝ suu mǝ kǝ láa tɛlɩ. Worokoyǝ la kpaka nuŋtumuwǝ wǝ la ta fwafwa<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="JUD 1:3">Yud 1:3</ref></char>.</char></note> lǝ tǝnǝ pǝ. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Pǝ láa wɛɛlɩ otukǝŋkǝŋtuyǝ paape yǝ lǝǝ lǝmǝ duturǝ. Pǝ lǝ́ǝ fǝ wɛlɛŋrǝ lo otucakpɛɛyǝ we yǝ lóo co nʊŋsɔɔwǝ pǝ ŋ tǝǝnǝ epǝ we pǝ le ci ǝsǝrǝ mǝ enyipǝ we pǝ kpii vɔrʊrǝ rǝ ǝlǝǝkǝ lǝ mǝrǝ wǝ. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Ŋpǝ anianiatǝtukaŋtǝpǝ sa we, diiwɛɛrǝ la garǝ wǝ́ pǝ lóo co enyipǝ, rǝ kǝ́ ŋpǝŋpǝ paa pǝ ri arɔŋpǝ pǝ koonu pǝlǝ kǝǝpǝ́wǝ we wǝ lǝ́ǝ nǝǝnǝ pǝ wǝ. Duturǝ ɖi nyi ri ŋ nyi ri rɔŋyǝ koonu tuwǝ we wǝ le ri no yurǝ wǝ. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Mǝŋ epǝ we pǝ la pɔrʊ pǝla wɛ pǝ la cɛ rǝ ǝrǝkǝ la arɛɛyǝ saŋ rǝ kǝ́ pǝ le ci loh Kulǝtǝyǝ mǝ Lɔkuŋtǝyǝ Yesu Kǝriso, pǝ lǝ tǝ pǝ la nyarǝ pǝla wɛ pǝ lo co pǝ lo koonu arɛɛyǝ sa yǝ ri pǝlo yurǝ we, rǝ kǝtǝǝlǝkǝ we, pǝla vɔrʊrǝ lǝ́ǝ pǝlǝ lǝ ŋ teeri kǝsǝŋkǝ. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Mǝŋ pǝ lee ke ce pǝ ci wǝkʊʊkpǝ la cawǝ sa kʊraa we, wǝ koh poŋ pǝ wǝ teeri kǝ́ pǝ le ci wǝ pǝ la lɛ, wǝ́ paa pǝ le kpii pǝ lǝ kpǝlǝŋ rǝ Worokoyǝ lo tutɛŋkenikeniwǝ we pǝ la tɛŋ pǝ le tíi pǝ wǝ. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Tuwǝ sa wǝ lǝ pǝ wǝ lo tuu pǝ we, wǝ la pɔrʊ otutuyǝ sa pǝ láa ca la anʊkɔrǝyǝ wǝ la kaŋ ǝkǝnǝŋ «Cɩkɛɛyǝ lǝ kpǝlǝŋ lǝ kǝ fǝ no otupɔrʊyǝ le ri», wǝ́ «Fáŋyǝ we pǝ le wiiri pǝ láa lɛ we, ŋwǝ ŋ tǝ ŋ tɛkɛ ŋ née wii kǝpwɛkǝ ǝnǝ».<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Pǝ lo co Yesu lǝ ǝpǝkǝ la garǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, kǝfwɛɛyitǝkǝ ŋ́ na marǝ ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ wǝǝ. Rǝ wǝfwɛɛkpǝ sa wǝle wǝyi mǝrǝ we, ŋ́ ya ŋ́ náa taalǝ nǝ otukaŋyǝ we nǝ nya lɔ wǝ, kǝ ŋ́ fǝ ŋ́ saanǝ nǝ susuyǝ rǝ wǝlǝkʊʊkpǝ we nǝ nyóo mǝ pu yurǝ wǝ. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Nǝ taalǝ etieyǝ we akpɛɛnuŋtɛŋtǝkenikenipǝ pǝ tɛnɩ pǝ tìi nǝ pǝ còonu wǝ. Nǝ taalǝ Kulǝtǝyǝ mǝ Lɔkuŋtǝyǝ lo tutɛŋwǝ we nǝ enyikpiipǝ we pǝ la tɛŋ pǝ le tíi nǝ wǝ. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />Coŋ koonu tu ri ŋ tu we, nǝ ci wǝ ǝkǝnǝŋ rǝ ecituturuyǝ mǝrǝ we, enyimɔɔnʊtǝpǝ pǝ loh po ru, pǝlo otucakpɛɛyǝ yǝ re pǝla vɔrʊrǝ yǝ láa tɛlɩ. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />Pǝ lah mǝ tɛŋ ǝkǝnǝŋ: «Ŋkǝ cò nǝ garǝ ǝkǝnǝŋ ŋ nǝ́ǝ pǝ, ama? Wǝ́ ŋwǝ pa? Duturǝ ɖi ru ǝrǝ kǝ́ lǝh ǝtǝtǝpǝ pǝ lǝ kpǝ́, tu ri ŋ tu wǝ tǝ wǝ lǝ mǝŋ kǝ́ wǝ kǝ lǝ rǝ kǝsǝŋkǝ kǝ́ pǝ cò ǝrǝkǝ wǝ.» <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Kǝ́ pǝ ya pǝ láa tɛŋ wǝ ǝnǝ we, pǝ la kʊʊrʊ pǝ yuu tuwǝ rɛ ceŋceŋ la kpɛɛ ǝkǝnǝŋ wǝ la panǝ ŋpa kǝ́ Worokoyǝ ŋ cò yulaarǝ mǝ kǝtǝǝwǝ saŋ rǝ no tutɛŋwǝ wǝ. Kǝtǝǝwǝ wǝ nyàa wǝ rù rǝ mɛŋwǝ mǝrǝ, wǝ́ wǝ kpii saŋ rǝ mɛŋwǝ. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Kaa wǝǝ, ŋʊŋtɛmumuŋyǝ we la mɛŋwǝ wǝ́ Worokoyǝ ŋ fǝ̀ ŋ nǝ̀ǝnǝ eniyǝ nɔ lǝ ǝrǝkǝ. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Ŋrǝ dierǝ we ke la ta rǝkǝsa lo yulaarǝ mǝ rǝkǝsa lǝ kǝtǝǝwǝ ɖe. La kʊʊ yǝ lǝ tǝnǝ koonu naawǝ. La maa yǝ lǝ tǝnǝ koonu jitɛŋakpaŋyǝ, jirǝ we pǝ lǝ́ǝ nǝǝnǝ epǝ we pǝ lǝŋ suu Worokoyǝ wǝ. <verse eid="2PE 3:7" /><verse number="8" style="v" sid="2PE 3:8" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, tuwǝ rɛ wǝ kpii wǝ laa laka kǝ nǝ yuu wǝla kpɛɛ, wǝ ri ǝkǝnǝŋ rǝ Ǝtǝ Woroko lǝ kpǝŋ we, jirǝ jeŋceŋ lǝ rǝ mǝŋ cɛŋwǝ lafawǝ ceŋceŋ, wǝ́ cɛŋwǝ lafawǝ ceŋceŋ wǝ lǝ rǝ mǝŋ jirǝ jeŋceŋ. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Ǝtǝ Woroko lǝŋ tǝǝlǝ mǝ tuwǝ we ŋ no co garǝ le eyeekǝ. Paape arɛɛpǝ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ lǝ tǝǝlǝ. Paa we, ya láa pɔrʊ na lɛtaarǝwǝ mǝ ŋ kaŋ nǝ rǝ, duturǝ ɖi laa ya lǝ́ǝ pǝ́ nyiyǝ mǝŋ ceŋceŋ ŋ kpǝ́ ŋ nǝŋ, paa ya lǝ́ǝ pǝ́ enyipǝ kpǝlo kɩɩkɩ pǝ cɛkɛlɛ vɔrʊrǝ rǝ.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Paape we, Kulǝtǝyǝ le jirǝ we we, lǝh pǝ pǝ mǝŋ kǝ́ yɩlayɩtǝyǝ ŋ nǝ́ǝ pǝ kǝtǝ. Jirǝ we we, yulaarǝ láa nara kǝ nǝŋ, otunyɔŋyǝ rǝ yulaarǝ yǝ láa lɔ naawǝ kǝ yǝ yee naa pukupuku, kǝ kǝtǝǝwǝ mǝ wǝlo otuyǝ yǝ yee naa. <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />Kǝ́ wǝ ri ǝkǝnǝŋ tu ri ŋ tu wǝ lǝh pǝ nǝŋ wǝ fǝ mǝŋkǝsa wǝǝ, we kǝ́ le enyi wǝrʊ wǝ́ wǝ la laka nǝ ri wǝ? Wǝ kpii kǝ nǝ tii vɔrʊkenikenirǝ, nǝ pu Worokoyǝ, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />ŋnǝ epǝ we nǝ ya nǝ nyǝ́ǝ rǝŋ wǝ́ nǝ ya nǝ nyóo fuunu ǝkǝnǝŋ Worokoyǝ le jirǝ we bǝ kalaŋ wǝ. Jirǝ we we, yulaarǝ láa lɔ naawǝ kǝ yee naa, kǝ otunyɔŋyǝ we yǝ la lɔ naawǝ yǝ yakɩlɩ. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Ŋlǝ paa la ya yǝ lǝ́ǝ rǝŋ yulaaŋwɛŋrǝ we mǝ kǝtǝǝŋwɛŋwǝ we Worokoyǝ ŋ còo lǝ garǝ wǝ. Fɛɛwǝ sa wǝ́ wǝkʊʊkpǝ wǝ la lɔ kǝtiikǝ wǝ.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Wǝ kǝto we, lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, rǝ ǝrǝŋkǝ sa mǝrǝ we, nǝ mǝ nyɩɩ kǝ tǝrɛ wǝ paa cɩɩrɩ nǝ, nǝ pǝǝ lǝmǝ bɔtɔɔrǝ rɛ, kǝ nǝ tii rǝ wǝtaarǝkpǝ mǝ Worokoyǝ. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Nǝ nyɩŋ tuwǝ sa nǝ ci ǝkǝnǝŋ Kulǝtǝyǝ la taarǝ lɛrǝ ya lǝ́ǝ rǝŋ kǝ nǝ nya fɛɛ nǝ nya alɔkuŋkǝ rǝ! Tuwǝ lah paanʊkǝǝtaatǝyǝ Pɔlʊ, ŋ na ŋʊrʊ ŋ na maŋ nǝ saŋ rǝ Worokoyǝ le nimisiewǝ we ŋ no koonu ŋwǝ wǝǝ. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Tuwǝ ŋ náa lɛ mǝ ŋ ŋʊrʊ mǝ ŋ kpii rǝ na wǝfwɛɛmaŋkpǝ kpǝlo kɩɩkɩ mǝrǝ vǝ́ lah wɛɛlɩ mǝ ŋ ru rǝ dierǝ sa wǝǝ. Rǝ na wǝfwɛɛkpǝ sa mǝrǝ we, afɛɛrɛɛyǝ yǝ lɛnyɩ dutunuŋrǝ. Ŋ wǝ wǝ lóo koonu wǝ́ enyipǝ we pǝ lee ci tǝrɛ, wǝ́ pǝ laa lɛ pǝ tɔ pǝ yaa sɩsiɛrɩ we, pǝ láa siɛrɩ yǝlo duturǝ wǝ. Kǝ́ pǝ láa lɛ pǝ ŋ yee mǝ Wǝŋʊrʊkenikenikpǝ la afɛɛrɛɛyǝ wǝǝ. Mǝŋkǝsa we, pǝ ya pǝ lǝ́ǝ nǝǝnǝ pǝla wɛ rǝ. <verse eid="2PE 3:16" /><verse number="17" style="v" sid="2PE 3:17" />Ŋnǝ paa we, lǝh ǝtǝŋkǝǝtaatǝpǝ, rǝkǝsa we, ŋ́ ne ci ŋ́ ne tíi nǝ, kǝto nǝ yee nǝ wɛ lo yurǝ. Nǝ paa maa enyipǝ we pǝ lǝŋ suu Worokoyǝ, pǝ ya pǝ lǝ́ǝ lǝǝ cawǝ we, pǝ tǝǝnǝ nǝ pǝ kpii. Mǝŋkǝsa we, rǝ nǝ atɔyaakǝ sa mǝrǝ we, nǝ nyǝŋ po ru nǝ tɔɔ. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Paa nǝ mǝ wasa rǝ loh Kulǝtǝyǝ mǝ Lɔkuŋtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ mǝ ne ecikǝ mǝrǝ. Ŋwǝ ŋ kaamǝ ǝkǝkǝ fǝ rǝkǝsa mǝ ko alaalɛɛkǝ. Amɛnǝ!<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>