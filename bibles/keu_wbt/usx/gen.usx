<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">Akebou: La Bible En Akebou</book>
  <para style="h">1 Mose</para>
  <para style="toc3">1Mo</para>
  <para style="toc2">1 Mose</para>
  <para style="toc1">Mose la kǝfwɛɛsǝsǝŋkǝ</para>
  <para style="mt1">Mose la kǝfwɛɛsǝsǝŋkǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Kǝfwɛɛkǝ sa kǝ ri Wǝŋʊrʊkenikenikpǝ la kǝfwɛɛsǝsǝŋkǝ. Ŋkǝ kǝ ri Mose la wǝfwɛɛkpǝ we wǝtʊʊkpǝ lǝ kǝsǝsǝŋkǝ. Kǝto pǝ lóo pwo kǝ ǝkǝnǝŋ «Mose la kǝfwɛɛsǝsǝŋkǝ». Kǝfwɛɛkǝ sa kǝ la wɛɛlɩ kǝ lo ru rǝ kǝ́ Worokoyǝ ŋ tìe ǝrǝkǝ kpǝlo lo ocokǝ mǝ tu ri ŋ tu lǝ kǝsǝsǝŋkǝ: anyɩmaasɩpǝ, akɛɛpǝ, turɔɔrɔɔwǝ, yulaarǝ mǝ kǝtǝǝwǝ, apʊyǝ mǝ otututuruyǝ.</para>
  <para style="ip">Yǝ lóo koru anya wǝtamumuŋkpǝ wǝyi rǝ kǝfwɛɛkǝ sa mǝrǝ. Fǝ rǝ yusǝsǝŋrǝ fǝ ko dǝmǝceŋceŋtǝrǝ we, pǝ la wɛɛlɩ pǝ lo ru rǝ kǝ́ Worokoyǝ ŋ ko ŋ co ǝrǝkǝ, akɛɛpǝ, anyɩmaasɩpǝ mǝ tu ri ŋ tu wǝ kpii rǝ kǝtǝǝwǝ mǝ yulaarǝ wǝ. Pǝ la lɛ pǝ la wɛɛlɩ pǝ lo ru rǝ turɔɔrɔɔsǝsǝŋwǝ, anyɩmaasɩpǝ la vɔrʊrɔɔrɔɔrǝ mǝ tukoŋtawǝ we wǝ pǝlǝ wǝ tùu pǝ wǝ. Fǝ rǝ yutǝmǝyitǝrǝ fǝ ko dǝtʊʊtǝrǝ we, pǝ la wɛɛlɩ pǝ lo ru rǝ Isǝrayɛlǝtǝpǝ lǝ ǝtǝtǝtǝtǝpǝ la vɔrʊrǝ: Abǝrahamǝ la vɔrʊrǝ, Isakǝ mǝ Yakɔbǝ fǝ kʊla mǝ Yosɛfʊ la vɔrʊrǝ.</para>
  <para style="ip">Kǝfwɛɛkǝ sa kǝ ya kǝ láa kaŋ lǝ ǝkǝnǝŋ Worokoyǝ ŋ no co ǝrǝkǝ kpǝlo mǝ otuyǝ we kpǝlo kɩɩkɩ yǝ kpii rǝ kǝ wǝ. Kǝ ya kǝ láa wɛɛlɩ kǝ ŋ ru rǝ kǝ́ Worokoyǝ ŋ náa taa anyɩmaasɩpǝ lǝ kǝǝwǝ wǝ́ ŋ náa lɛ mǝ ŋ yɩrɩ pǝlo yurǝ wǝ. Worokoyǝ la pɔrʊ na wɛ la kaŋ ǝkǝnǝŋ ŋwǝ ŋ ri nǝ kǝkpǝŋkǝ la kpaŋtɛŋtǝyǝ mǝ kǝle retǝyǝ. Worokoyǝ lǝ pǝ́ ǝkǝnǝŋ anyɩmaasɩpǝ pǝ lɔ ŋwǝ pǝ nuŋ, kǝ pǝ tɛɛ kpɛɛwǝ rǝ otuyǝ we ŋ no co pǝ la garǝ wǝ. La lɛ lǝ pǝ́ anyɩmaasɩpǝ pǝ tii vɔrʊrǝ pǝ saŋ rǝ ŋwǝ Worokoyǝ le esepǝ we lo oŋuŋkǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ǝrǝkǝ mǝ nyɩmaasɩyǝ lo ocokǝ 1:1–2:25</para>
  <para style="io">- Turɔɔrɔɔwǝ mǝ arianyɩŋyǝ lǝ kǝsǝŋkǝ 3:1-24</para>
  <para style="io">- Fǝ rǝ Adamǝ le diirǝ fǝ pǝ Nowa le diirǝ 4:1–5:32</para>
  <para style="io">- Ŋʊŋtɛmumuŋyǝ we lǝ ǝpǝkǝ 6:1–10:32</para>
  <para style="io">- Babɛlǝ la baŋsʊrʊyǝ we la atɔkǝ 11:1-9</para>
  <para style="io">- Fǝ rǝ Semǝ lǝ wǝmǝkpǝ fǝ ko Abǝrahamǝ 11:10-32</para>
  <para style="io">- Abǝrahamǝ, Isakǝ mǝ Yakɔbǝ le etieyǝ 12:1–35:29</para>
  <para style="io">- Esawʊ lǝ wǝmǝkpǝ 36:1-43</para>
  <para style="io">- Yosɛfʊ mǝ na apaanʊpǝ 37:1–45:28</para>
  <para style="io">- Isǝrayɛlǝtǝpǝ pǝ le ke tii rǝ Ejipǝte 46:1–50:26</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Kǝ́ Worokoyǝ ŋ ko ŋ co ǝrǝkǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Rǝ kǝtiekǝ we, Worokoyǝ cò yulaarǝ mǝ kǝtǝǝwǝ. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Anyɩŋ kǝtǝǝwǝ wǝ kpɛlɩ akpaakpa, wǝ lǝǝ kǝ lǝmǝ wǝlǝkpǝ rɛ. Wǝ́ nuŋtumuwǝ wǝ sìi apʊsǝsǝŋyǝ we. Wǝ́ Worokoyǝ la wɛɛrǝ go ŋ fuŋ lǝ ŋ tɛlɩ rǝ mɛŋwǝ we lo oŋuŋkǝ. <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />Wǝ́ Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝnyɩɩnɩkpǝ wǝ ru!» Wǝ́ wǝnyɩɩnɩkpǝ wǝ rù. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ wǝnyɩɩnɩkpǝ we wǝ ponu. Wǝ́ Worokoyǝ ŋ sǝ̀ wǝnyɩɩnɩkpǝ ŋ cɛ̀ rǝ nuŋtumuwǝ lǝ kpǝŋ. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Wǝ́ ŋ pwò wǝnyɩɩnɩkpǝ ǝkǝnǝŋ: «Jɔkɔŋrǝ». Wǝ́ ŋ pwò nuŋtumuwǝ ǝkǝnǝŋ: «Dumurǝ». Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ, jisǝsǝŋrǝ wǝǝ. <verse eid="GEN 1:5" /><verse number="6" style="v" sid="GEN 1:6" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Tǝrɛ wǝ ru rǝ mɛŋwǝ we le kǝtiitiikǝ, kǝ wǝ sǝpǝ wǝ kpeewǝ yi!» <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Wǝ́ wǝ pǝlǝ ǝnǝ. Wǝ́ Worokoyǝ ŋ yeeli ŋ wǝ tuwǝ sa wǝ sǝ̀pǝ mɛŋwǝ we. Anyɩŋ mɛŋrɛɛwǝ wǝ kpìi rǝ tuwǝ we la pɔɔlʊwǝ rɛɛwǝ wǝ kpìi rǝ tuwǝ we lo oŋuŋkǝ. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Wǝ́ Worokoyǝ ŋ pwò tuwǝ we ǝkǝnǝŋ yulaarǝ. Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ: Jiyitǝrǝ wǝǝ. <verse eid="GEN 1:8" /><verse number="9" style="v" sid="GEN 1:9" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Mɛŋwǝ we wǝ kpii rǝ yulaarǝ lǝ kǝnǝŋkǝ wǝ ca wǝ ku rǝ fɛɛceŋceŋ, kǝ fɛɛwosowosowǝ wǝ ru!» Wǝ́ wǝ pǝlǝ ǝnǝ. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Wǝ́ Worokoyǝ ŋ pwò fɛɛwosowosowǝ we ǝkǝnǝŋ kǝtǝǝwǝ, wǝ́ ŋ pwò mɛŋwǝ we wǝ la ca wǝ lo ku ǝkǝnǝŋ: «Apʊyǝ». Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ tuwǝ sa wǝ ponu. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝtǝǝwǝ wǝ wii bɔɔrǝ mǝ eciiyǝ. Bɔɔrǝ nyɩŋ rǝle epiyǝ. Ɖǝ mǝ ɖǝ mǝ rǝle epiyǝ, kǝ eciiyǝ yǝ nyɩŋ ǝtǝnǝyǝ yǝ kpii mǝ epiyǝ wǝ. Wǝcii ri ŋ cii rǝ kǝtǝǝwǝ we, mǝ wǝlǝ ǝtǝnǝyǝ!» Wǝ́ wǝ pǝlǝ ǝnǝ. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Wǝ́ kǝtǝǝwǝ wǝ wìli bɔɔrǝ mǝ eciiyǝ. Wǝ́ bɔɔ ri ŋ bɔɔ nyɩ̀nɩ rǝle epiyǝ. Wǝ́ wǝcii ri ŋ cii wǝ nyɩ̀nɩ wǝlǝ ǝtǝnǝyǝ yǝ kpii mǝ epiyǝ. Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ wǝ ponu. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ: Jitatǝrǝ wǝǝ.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Otuyǝ we yǝ láa nyɔŋ yǝ ru yǝ pa tɛ rǝ yulaarǝ, kǝ yǝ sǝpǝ jɔkɔŋrǝ mǝ dumurǝ lǝ mǝrǝ. Yǝ lée ri barǝ rɛ lah mǝ kaŋ wǝcɛkpǝ le eniyǝ, eciyǝ mǝ acɛŋyǝ. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Yǝ lée ri otuyǝ we yǝ láa nyɔŋ rǝ yulaarǝ. Yǝ lah mǝ nyɩnɩ kǝtǝǝwǝ.» Wǝ́ wǝ pǝlǝ ǝnǝ. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Wǝ́ Worokoyǝ ŋ yeeli tunyɔŋmumuŋwǝ we yiwǝ. Mumuŋwǝ we wǝ ŋ nyɔŋ mǝ jɔkɔŋrǝ, kǝ pipiwǝ we wǝ ŋ nyɔŋ mǝ dumurǝ. Wǝ́ ŋ yeeli wǝŋɔŋkpǝ ŋkpǝ ŋkpɛ. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Wǝ́ Worokoyǝ ŋ fǝ̀ yǝ ŋ tɛ̀ɛ rǝ yulaarǝ kǝ yǝ ŋ nyɩnɩ kǝtǝǝwǝ, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />kǝ yǝ ŋ nyɔŋ mǝ jɔkɔŋrǝ mǝ dumurǝ, kǝ yǝ sǝpǝ wǝnyɩɩnɩkpǝ mǝ nuŋtumuwǝ lǝ mǝrǝ. Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ wǝ ponu. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ: Jiniǝtǝrǝ wǝǝ.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Mɛŋwǝ wǝ lǝ mǝ akɛɛpipǝ. Ofuripǝ pǝ ŋ yi rǝ yulaarǝ rǝ kǝtǝǝwǝ lo oŋuŋkǝ.» <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Wǝ́ Worokoyǝ ŋ cò apʊyǝ la akɛɛmumuŋpǝ we pǝ lóo co vurǝ wǝ. Wǝ́ ŋ cò otuyǝ we kpǝlo kɩɩkɩ yǝ kpii vɔrʊrǝ wǝ́ yǝ lóo ruu wɛɛwǝ yǝ ŋ tɛlɩ rǝ mɛŋwǝ, wǝ mǝ wǝ mǝ wǝlǝ kǝkpǝŋkǝ. Wǝ́ ŋ cò wǝfurikpǝŋkpǝ kpǝlo kɩɩkɩ. Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ wǝ ponu. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Wǝ́ Worokoyǝ ŋ pɛ̀ɛrɩ yǝ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ mǝ kǝ nǝ yaarǝ, nǝ lǝǝrǝ apʊyǝ. Ofuripǝ pǝ yaarǝ rǝ kǝtǝǝwǝ.» <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ: Jitʊʊtǝrǝ wǝǝ. <verse eid="GEN 1:23" /><verse number="24" style="v" sid="GEN 1:24" />Wǝ́ Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝtǝǝwǝ wǝ mǝ akɛɛpǝ lǝ ǝkpǝŋyǝ. Ǝtǝŋtǝǝkɛɛpǝ, akɛɛtiinipǝ, apɔɔkɛɛpǝ lǝ ǝkpǝŋyǝ!» Wǝ́ wǝ pǝlǝ ǝnǝ. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Wǝ́ Worokoyǝ ŋ yeeli apɔɔkɛɛpǝ lǝ ǝkpǝŋyǝ, ǝtǝŋtǝǝkɛɛpǝ lǝ ǝkpǝŋyǝ, mǝ akɛɛtiinipǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ lǝ ǝkpǝŋyǝ. Wǝ́ Worokoyǝ ŋ nyɩnɩ ǝkǝnǝŋ wǝ ponu.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ le yee nyɩmaasɩyǝ rǝ lǝh wǝlǝkpǝ, kǝ ŋ ru lǝ. Lée ri wǝpwɛɛkpǝ rǝ apʊyǝ, ofuripǝ rǝ yulaarǝ, anyarǝkɛɛpǝ, kǝtǝǝwǝ kpǝlo kɩɩkɩ, apɔɔkɛɛpǝ mǝ akɛɛtiinipǝ we kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ lo yurǝ!»<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Worokoyǝ cò nyɩmaasɩyǝ rǝ ŋwǝŋwǝ nǝ wǝlǝkpǝ,</para>
  <para style="q1" vid="GEN 1:27">rǝ ŋwǝŋwǝ Worokoyǝ lǝ wǝlǝkpǝ wǝ́ ŋ cò nyɩmaasɩyǝ.</para>
  <para style="q1" vid="GEN 1:27">Cò pǝ pǝrǝŋyǝ mǝ tieyǝ.<verse eid="GEN 1:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="GEN 1:28" />Wǝ́ Worokoyǝ ŋ pɛ̀ɛrɩ pǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ, nǝ yaarǝ, kǝ nǝ lǝ kǝtǝǝwǝ, kǝ nǝ ri wǝlo yurǝ. Nǝ ri wǝpwɛɛkpǝ rǝ apʊyǝ, ofuripǝ rǝ yulaarǝ mǝ akɛɛpǝ kpǝlo kɩɩkɩ pǝ kpii pǝ láa tɛlɩ rǝ kǝtǝǝwǝ lo yurǝ!» <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />Wǝ́ Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Yɩrɩ re, ŋ́ nǝ fǝ bɔɔrǝ sa kpǝlo kɩɩkɩ láa nyɩŋ epiyǝ rǝ kǝtǝǝwǝ kpǝlo kɩɩkɩ lo oŋuŋkǝ mǝ eciiyǝ we kpǝlo kɩɩkɩ yǝ láa nyɩŋ ǝtǝnǝyǝ yǝ kpii mǝ epiyǝ we, ŋ́ no koonu nǝ. Yǝ ri nǝ keeriwǝ. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Ŋ́ nǝ fǝ bɔɔkookoorǝ kpǝlo kɩɩkɩ ŋ́ no koonu akɛɛpǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ, ofuripǝ kpǝlo kɩɩkɩ rǝ yulaarǝ mǝ akɛɛpǝ we kpǝlo kɩɩkɩ pǝ lée tiini rǝ kǝtǝǝwǝ, kǝ lǝ fǝ wǝ tu ri ŋ tu wǝ nya wǝ kpii vɔrʊrǝ rǝ ko, pǝ yee pǝle keeriwǝ.» Wǝ́ wǝ pǝlǝ ǝnǝ. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />Wǝ́ Worokoyǝ ŋ yɩ̀rɩ otuyǝ we kpǝlo kɩɩkɩ ŋ ne yee wǝ. Wǝ́ ŋ nyɩnɩ yǝ ko ponu ŋpa. Wǝ́ kǝ cɩ̀ɩ, wǝ́ kǝ kàalǝ: Jikʊraŋtǝrǝ wǝǝ.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Kǝ́ Worokoyǝ ŋ cò yulaarǝ mǝ kǝtǝǝwǝ mǝ otuyǝ we kpǝlo kɩɩkɩ yǝ kpii rǝ yǝ ŋ lɛ̀ wǝǝ.<verse eid="GEN 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 2:2" />Jipǝrɩmatatǝrǝ we, oturu Worokoyǝ la lɛ kǝnǝnɛkǝ we ŋ yeli wǝ,</para>
  <para style="q1" vid="GEN 2:2">wǝ́ ŋ tini ŋ wɛ̀ mǝ kǝnǝnɛkǝ we kpǝlo kɩɩkɩ ŋ ke ŋ yee wǝ. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Wǝ́ Worokoyǝ ŋ pɛ̀ɛrɩ jipǝrɩmatatǝrǝ we. Wǝ́ ŋ yeli mǝ rǝ kenikeni duturǝ ɖi ŋ rǝ jirǝ we wǝ́ ŋ wɛ̀ mǝ kǝnǝnɛkǝ we kpǝlo ŋwǝ ŋwǝ ŋ yeli kǝ́ ŋ ko ŋ co otuyǝ wǝ. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />Yulaarǝ mǝ kǝtǝǝwǝ lo ocokǝ le dierǝ gaamǝ ɖǝ ǝnǝ.</para>
  <para style="s" vid="GEN 2:4">Anyarǝtɛɛkǝ we rǝ Edɛnǝ wǝ</para>
  <para style="p" vid="GEN 2:4">Jirǝ we Ǝtǝ Woroko ŋ yeli yulaarǝ mǝ kǝtǝǝwǝ we, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />wǝciipikpǝ la tǝrɛ wǝ laa ka maa wǝ yaa rǝ kǝtǝǝwǝ, wǝ́ bɔɔrǝ la tǝrɛ wǝ faa ka maa wǝ wii. Duturǝ ɖi Ǝtǝ Woroko laa maa ŋ koonu ŋʊŋtɛyǝ ŋ pǝ ŋ kpii kǝtǝǝwǝ, wǝ́ nyɩmaasɩyǝ lee ke kpii kǝ ŋ kpɛŋ kǝtǝǝwǝ. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Paa dusiirǝ go ŋ ru rǝ kǝtǝǝwǝ mǝrǝ lǝ ŋ co mɛŋrǝ rǝ kǝtǝǝwǝ lo oŋuŋkǝ kpǝlo kɩɩkɩ.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Wǝ́ Ǝtǝ Woroko ŋ fʊ̀ kǝnyaanǝkǝ ŋ fǝ̀ ŋ yàa pǝrǝŋyǝ. Wǝ́ ŋ fùru vɔrʊrǝ la wɛɛrǝ ŋ kpìi ŋwǝ rǝ aŋwɛɛŋuŋyǝ. Wǝ́ pǝrǝŋyǝ sa ŋ sìɛrɩ ŋ yeli nyiyǝ ŋ kpii vɔrʊrǝ wǝ. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />Wǝ́ Ǝtǝ Woroko ŋ kpɛnɩ anyarǝtɛɛkǝ rɛ rǝ Edɛnǝ rǝ kǝcɔkɔŋpoŋkǝ la gaarǝ. Wǝ́ ŋ fǝ̀ pǝrǝŋyǝ we ŋ na yaa ŋ kolu ŋ tǝ̀nǝ rǝ we. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Wǝ́ Ǝtǝ Woroko ŋ kòonu kǝtǝǝwǝ wǝ wili eciiyǝ kpǝlo kɩɩkɩ yǝ lóo poŋ ayɩrɩ wǝ́ yǝ lóo poŋ eri wǝ. Wǝ́ ŋ fǝ̀ wǝciikpǝ we wǝ lóo koonu vɔrʊrǝ mǝ wǝciikpǝ we wǝ lóo koonu pǝ lée ci ceeceewǝ mǝ rɔɔrɔɔwǝ ŋ kolu ŋ yàalǝ rǝ anyarǝtɛɛkǝ sa le kǝtiitiikǝ.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Wǝ́ kpanǝwǝ rɛ wǝ rù rǝ Edɛnǝ wǝ pǝlǝ wǝ tɛ̀lɩ anyarǝtɛɛkǝ sa. Wǝ́ wǝ ke ŋ kpii anyarǝtɛɛkǝ sa la mɛŋwǝ. Kǝ́ wǝ la tɛlɩ anyarǝtɛɛkǝ sa we, wǝ́ wǝ nyàlǝ farǝwǝ niǝ. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Kpanǝwǝ sa la farǝsǝsǝŋwǝ wǝ ri Pisonǝ. Ŋ wǝ wǝ lo co wǝ le siri Avila lǝ gǝŋrǝ kpǝlo kɩɩkɩ. Fɛɛwǝ sɩkamwɛɛrɩyǝ ŋ kpii wǝǝ. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Gǝŋrǝ sa la sɩkamwɛɛrɩyǝ sa ponu. Wǝciikpǝ rɛ la mɛŋfɛŋfɛŋwǝ mǝ ɖurǝ rɛ la lɔ okuruyǝ pǝ lóo pwo Onisǝyǝ ŋyǝ ŋkpɛ yǝ ke kpii rǝ we. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Wǝla farǝyitǝwǝ we wǝ ri Gihonǝ. Ŋ wǝ wǝ lo co wǝ le siri Kusǝ lǝ gǝŋrǝ kpǝlo kɩɩkɩ. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Farǝtatǝwǝ we wǝ ri Idekɛlɩ<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Idekɛlɩ wǝ́ arɛɛpǝ pǝ lo pwo ǝkǝnǝŋ Tigǝrǝ.</char></note>. Ŋ wǝ wǝ la tɛlɩ rǝ Asiri la kǝcɔkɔŋpoŋkǝ la gaarǝ wǝ. Farǝniǝtǝwǝ wǝ kaamǝ Efǝrata.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Wǝ́ Ǝtǝ Woroko ŋ fǝ̀ pǝrǝŋyǝ sa ŋ kolu ŋ tìini rǝ anyarǝtɛɛkǝ we rǝ Edɛnǝ wǝ, kǝ mǝ ŋ kpɛŋ kǝ, kǝ mǝ ŋ rǝŋ kǝ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Wǝ́ Ǝtǝ Woroko ŋ kpìi seyǝ ŋ kòonu ŋwǝ ǝkǝnǝŋ: «Gʊŋrǝ gbɛlɩ, o lóo koru e mǝ ri eciiyǝ sa kpǝlo yǝ yaa rǝ anyarǝtɛɛkǝ sa lǝ ǝtǝnǝyǝ. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />Paa, pee pe ri wǝciikpǝ we wǝ lóo koonu pǝ lée ci ceeceewǝ mǝ rɔɔrɔɔwǝ lǝ ǝtǝnǝyǝ. Jirǝ we e lée ri kpǝ we, ǝ lǝ́ǝ kpǝ́ taa».<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ loo poŋ kǝ pǝrǝŋyǝ ŋ tii ŋwǝ ceŋceŋ. Ŋ́ née yee toŋtǝyǝ ŋ náa kaa mǝ ŋwǝ we, ŋ́ koonu ŋwǝ». <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />Wǝ́ Ǝtǝ Woroko ŋ fǝ̀ kǝnyaanǝkǝ ŋ yàa apɔɔkɛɛpǝ kpǝlo kɩɩkɩ mǝ ofuripǝ kpǝlo rǝ yulaarǝ. Wǝ́ ŋ fǝ̀ pǝ ŋ pǝlǝ pǝrǝŋyǝ sa lǝ kpǝŋ kǝ ŋ nyɩŋ kǝ́ pǝrǝŋyǝ ŋ neh kpii pǝla anyɩŋyǝ ŋ fǝ wǝ. Kǝ́ pǝrǝŋyǝ ŋ náa nya ŋ pwo tu ri ŋ tu wǝ kpii vɔrʊrǝ ŋ fǝ ko we, nyɩŋrǝ we lée ri wǝla nyɩŋrǝ wǝ. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Wǝ́ pǝrǝŋyǝ ŋ kpìi ǝtǝŋtǝǝkɛɛpǝ kpǝlo kɩɩkɩ, Ofuripǝ kpǝlo rǝ yulaarǝ mǝ apɔɔkɛɛpǝ kpǝlo kɩɩkɩ la anyɩŋyǝ. Paa pǝrǝŋyǝ ŋwǝŋwǝ we, laa nya toŋtǝyǝ ŋ kaa mǝ ŋwǝ wǝ. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Wǝ́ Ǝtǝ Woroko ŋ kòonu eniŋriemumuŋyǝ rɛ yǝ rɔ̀ɔnʊ pǝrǝŋyǝ, wǝ́ ŋ kpɛ̀lɩ kpo. Wǝ́ Worokoyǝ ŋ pɔ̀rʊ na alɛɛrɩciiyǝ le ceŋceŋ, wǝ́ ŋ fǝ̀ kasɩwǝ we ŋ rìini fɛɛwǝ we. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Wǝ́ Ǝtǝ Woroko ŋ sìɛrɩ lɛɛrɩciiwǝ we ŋ pɔ̀rʊ rǝ pǝrǝŋyǝ we ŋ yeli tieyǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ pǝlǝ ŋ kòonu pǝrǝŋyǝ we. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />Wǝ́ pǝrǝŋyǝ we ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 2:23">«Akaanɛŋ oo! A lǝŋ nyɩŋ, mǝ gopirǝ wǝ́ pǝ lǝ fǝ pǝ le yee nyiyǝ sa lo okopiyǝ,</para>
  <para style="q1" vid="GEN 2:23">mǝ kǝwɛlɛŋkakǝ wǝ́ pǝ lǝ fǝ pǝ le yee na kǝwɛlɛŋkakǝ.</para>
  <para style="q1" vid="GEN 2:23">Yǝ ǝnǝ we, pǝ loh mǝ pwo ŋwǝ ǝkǝnǝŋ tieyǝ.</para>
  <para style="q1" vid="GEN 2:23">Duturǝ ɖi pǝ la pɔrʊ ŋwǝ pǝ lo ru rǝ pǝrǝŋyǝ lǝ mǝrǝ».<verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Wǝ kǝto pǝrǝŋyǝ lah mǝ pwɛyɩ rǝ nǝ tǝyǝ mǝ ne leeyǝ lǝ kpǝŋ, ŋ ka maarǝ mǝ ne tie kpaŋ. Pǝ ŋ siɛrɩ pǝ yee nyiyǝ ceŋceŋ.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Pǝrǝŋyǝ we mǝ ne tie pǝle eyi pǝ ka ŋ tɛlɩ kǝtaŋkpa. Paape wǝ loo ko ŋ co pǝla nʊŋsɔɔwǝ rɛ.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">Kǝpɔɔkǝ kǝ lǝ tǝǝnǝ tieyǝ kǝ le kpii</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Kǝpɔɔkǝ kǝ ke pìeli kǝ teeri apɔɔkɛɛtuturupǝ kpǝlo Ǝtǝ Woroko ŋ yeli wǝ. Wǝ́ jirɛɛrǝ kǝ pǝlǝ kǝ pǝ̀ tieyǝ we ǝkǝnǝŋ: «Kǝto kǝceece Worokoyǝ le tíi nǝ ǝkǝnǝŋ: “Ŋnǝ nǝ pee pe ri eciiyǝ sa kpǝlo kɩɩkɩ rǝ anyarǝtɛɛkǝ sa la wǝ rɛ?”» <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />Wǝ́ tieyǝ sa ŋ tìi kǝpɔɔkǝ ǝkǝnǝŋ: «Yǝ lóo koru eri eciiyǝ sa rǝ anyarǝtɛɛkǝ sa lǝ ǝtǝnǝyǝ. <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />Paa mǝŋ wǝciikpǝ we wǝ yaa rǝ anyarǝtɛɛkǝ sa le kǝtiitiikǝ lǝ ǝtǝnǝyǝ we, Worokoyǝ la tɛŋ ǝkǝnǝŋ: “Nǝ pee pe ri yǝ, nǝ pee ce nǝ po ruu yǝ. Mǝŋ ŋkǝ kaa wǝǝ nǝ nyǝ́ǝ kpǝ́.”» <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />Wǝ́ kǝpɔɔkǝ kǝ tìi tieyǝ sa ǝkǝnǝŋ: «Ow, nǝ nyǝŋ kpǝ́ tǝrɛ, <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />kpiikǝ Worokoyǝ cii wǝ ǝkǝnǝŋ jirǝ we nǝ nyée ri yǝ we, nǝ enimiyǝ yǝ lóo wuru, kǝ nǝ ci ceeceewǝ mǝ rɔɔrɔɔwǝ mǝŋ ŋwǝ<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ: Mǝŋ oworokopǝ.</char></note> kǝtǝ».<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Wǝ́ tieyǝ sa ŋ nyɩnɩ ǝkǝnǝŋ wǝciikpǝ we wǝ lóo poŋ eri wǝ́ wǝ lóo poŋ ayɩrɩ. Wǝ́ wǝ láa kaa mǝ kǝ wǝ koonu otuciyǝ. Wǝ́ ŋ lɛ̀ wǝlǝ dǝnǝrǝ ŋ rili, wǝ́ ŋ kòonu no nuŋyǝ we ŋwǝ ŋkpɛ ŋ ka yaa rǝ nǝ kpǝŋ wǝ. Wǝ́ ŋ rili rǝ. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Wǝ́ pǝle eyi le enimiyǝ yǝ wùru. Wǝ́ pǝ nyɩnɩ pǝ cìi ǝkǝnǝŋ ŋpǝ pǝ yaa kǝtaŋkpa. Wǝ́ pǝle eyi pǝ fǝ̀ wǝcookpǝ le eweyǝ pǝ yeli anyaŋyǝ pǝ kɔ̀mʊ.<verse eid="GEN 3:7" /></para>
  <para style="s">Worokoyǝ le piri pǝrǝŋyǝ sa mǝ ne tieyǝ rǝ anyarǝtɛɛkǝ we rǝ Edɛnǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Ɖiɔrǝ, kǝ́ ǝrǝpikǝ rɛ kǝ ya kǝ lóo fuŋ we, wǝ́ pǝrǝŋyǝ sa mǝ ne tie pǝ nunu Ǝtǝ Woroko lo oturuuyǝ, sanǝ láa tɛlɩ rǝ anyarǝtɛɛkǝ sa lǝ mǝrǝ. Wǝ́ pǝrǝŋyǝ sa mǝ ne tie pǝ sùu pǝ kolu pǝ ŋwàa Ǝtǝ Woroko rǝ anyarǝtɛɛkǝ sa le eciiyǝ mǝrǝ. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Wǝ́ Ǝtǝ Woroko ŋ pwò pǝrǝŋyǝ we, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «E kpii rǝ fǝŋ?» <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />Wǝ́ pǝrǝŋyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no nuŋ ló oturuuyǝ rǝ anyarǝtɛɛkǝ sa. Wǝ́ vurǝ le yee mǝ, duturǝ ɖi ŋ́ yaa kǝtaŋkpa kǝto, wǝ́ ŋ́ no suu ŋ́ na ŋwaa.» <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ǝlǝ ŋ ne tíi lǝ́ ǝkǝnǝŋ ŋlǝ́ a yaa kǝtaŋkpa wǝ? Amaa e le ri wǝciikpǝ we lǝ ǝtǝnǝyǝ ŋ́ ne kpii seyǝ ŋ́ no koonu lǝ́ e pee pe ri wǝ?» <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />Wǝ́ pǝrǝŋyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tieyǝ sa ǝ lǝ pǝ tǝnǝ rǝ mǝ kpǝŋ we, ŋwǝ ŋ no koonu mǝ wǝciikpǝ sa lǝ dǝnǝrǝ. Wǝ́ ŋ́ ne ri rǝ».<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ tieyǝ we ǝkǝnǝŋ: «Kǝ́ lo tu wǝ́ e le yee ǝnǝ?» Wǝ́ tieyǝ we ŋ yìili ǝkǝnǝŋ: «Kǝpɔɔkǝ kǝ lǝ tǝǝnǝ mǝ wǝ́ ŋ́ ne ri rǝ».<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Rǝ fɛɛwǝ we wǝ́ Ǝtǝ Woroko ŋ tìi kǝpɔɔkǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 3:14">«Kǝ́ wǝ ri e le yee tuwǝ sa kǝto we, ŋ́ náa fwɛɛrɩ lǝ́ rǝ ǝtǝŋtǝǝkɛɛpǝ kpǝlo kɩɩkɩ, mǝ</para>
  <para style="q1" vid="GEN 3:14">apɔɔkɛɛpǝ kpǝlo kɩɩkɩ lǝ mǝrǝ.</para>
  <para style="q1" vid="GEN 3:14">E leh mǝ tiini rǝ lá lɛrǝ.</para>
  <para style="q1" vid="GEN 3:14">Guŋkuŋrǝ wǝ́ e leh mǝ ri</para>
  <para style="q1" vid="GEN 3:14">rǝ lá vɔrʊrǝ le eciyǝ kpǝlo kɩɩkɩ.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Ŋ́ née kpii kǝǝkpǝlǝwǝ rǝ ŋnǝ mǝ tieyǝ le kǝtiitiikǝ.</para>
  <para style="q1" vid="GEN 3:15">Nǝ wǝmǝkpǝ mǝ lá wǝnɛŋkpǝ wǝ lǝh mǝ kpǝlǝ awɛ lǝ kǝǝwǝ.</para>
  <para style="q1" vid="GEN 3:15">Nǝ wǝmǝkpǝ wǝ lah mǝ nyanyaa ló yurǝ,</para>
  <para style="q1" vid="GEN 3:15">Ŋlǝ́ paa o loh mǝ roŋ ŋwǝ rǝ niɛtiŋtiŋrǝ.»<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Wǝ́ ŋ tìi tieyǝ we ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 3:16">«Ŋ́ náa ta ló wǝkulurekpǝ la jʊʊrʊrǝ ŋ́ kʊla lǝ́ ŋpa.</para>
  <para style="q1" vid="GEN 3:16">A lah mǝ cʊʊrʊ ŋpa kpɛŋ e ci ǝmǝ.</para>
  <para style="q1" vid="GEN 3:16">Ló nuŋyǝ lah mǝ ca lá kpɛɛ.</para>
  <para style="q1" vid="GEN 3:16">Ŋwǝ paa lée ri lǝ́ yurǝ».<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Rǝkǝsa wǝ́ ŋ tìi pǝrǝŋyǝ we ǝkǝnǝŋ: «Kǝ́ o lo nuŋ lé tie lo tutɛŋwǝ wǝ́ e le ri wǝciikpǝ we lǝ dǝnǝrǝ ŋ́ kpìi seyǝ ŋ́ kòonu lǝ́ e pee pe ri we,</para>
  <para style="q1" vid="GEN 3:17">ŋlǝ́ kǝto ŋ́ náa fwɛɛrɩ kǝtǝǝwǝ.</para>
  <para style="q1" vid="GEN 3:17">A lah mǝ cʊʊrʊ kpɛŋ e ci a nya lé keeriwǝ o ru rǝ kǝtǝǝwǝ,</para>
  <para style="q1" vid="GEN 3:17">rǝ lá vɔrʊrǝ le eciyǝ kpǝlo kɩɩkɩ.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Kǝtǝǝwǝ wǝ lée wii owuyǝ</para>
  <para style="q1" vid="GEN 3:18">mǝ bɔɔrɔɔrɔɔrǝ wǝ koonu lǝ́,</para>
  <para style="q1" vid="GEN 3:18">kǝ e mǝ ri atɛɛkǝ le ewetuyǝ.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />A lah mǝ sʊʊ naawʊrǝ kpɛŋ,</para>
  <para style="q1" vid="GEN 3:19">e ci a nya lé keeriwǝ e ri,</para>
  <para style="q1" vid="GEN 3:19">ko ro eniyǝ we a la siɛnɩ e le ke fii kǝtǝǝwǝ.</para>
  <para style="q1" vid="GEN 3:19">Duturǝ ɖi kǝtǝǝwǝ wǝ́ pǝ la pɔrʊ lǝ́ pǝ lo ru.</para>
  <para style="q1" vid="GEN 3:19">Kǝnyaanǝkǝ wǝ́ e ri,</para>
  <para style="q1" vid="GEN 3:19">wǝ́ ǝ lǝh pǝ tǝ a siɛrɩ e yee kǝnyaanǝkǝ ke».<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Wǝ́ pǝrǝŋyǝ sa ŋ kpìi ne tie la nyɩŋrǝ ǝkǝnǝŋ Awa. Rǝlo duturǝ ɖi vɔrʊrǝ. Kpiikǝ ŋwǝ ŋ ri ǝpǝ pǝ kpii vɔrʊrǝ kpǝlo kɩɩkɩ le leeyǝ wǝ. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />Wǝ́ Ǝtǝ Woroko ŋ fǝ̀ fwɛɛwǝ ŋ yàa wǝkpakpǝ ŋ kpìi Adamǝ mǝ ne tie. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ rǝkǝsa nyɩmaasɩyǝ ŋ na siɛrɩ ŋ ne yee mǝŋ lah rɛ kǝtǝ wǝ́ ŋ cii ceeceewǝ mǝ rɔɔrɔɔwǝ we, ŋ pee pe yi ŋ koonu akaakǝ ŋ ka lɛ vɔrʊrǝ le wǝciikpǝ we lǝ dǝnǝrǝ ŋrǝ ŋkpɛ ŋ ri, kǝ ŋ pe tii vɔrʊrǝ kǝkpakǝkpa oo!» <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Wǝ́ Ǝtǝ Woroko ŋ pìri ŋwǝ ŋ rù rǝ anyarǝtɛɛkǝ sa rǝ Edɛnǝ wǝ, kǝ ŋ ka ya mǝ ŋ kpɛŋ kǝtǝǝwǝ we pǝ la pɔrʊ ŋwǝ pǝ lo ru wǝ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Kǝ́ ŋ ne piri nyɩmaasɩyǝ ŋ na lɛ we, wǝ́ ŋ fǝ̀ Ekerubipǝ<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">Epicoŋpipǝ rɛ la nyɩŋrǝ lǝǝwe.</char></note> ŋ pǝlǝ ŋ tǝ̀nǝ rǝ anyarǝtɛɛkǝ sa la kǝtakǝ we kǝ kolu rǝ kǝcɔkɔŋpoŋkǝ wǝ. Pǝ ke re tʊkʊwǝ pǝ kǝ ŋ rǝŋ vɔrʊrǝ le wǝciikpǝ we la gʊŋrǝ. Tʊkʊwǝ sa wǝ ko ŋ ru naawǝ mǝlamǝla wǝ ŋ siɛrɩ wǝ ŋ pǝ wǝ ŋ ku.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">Kayɩŋ mǝ Abɛlǝ le dierǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Wǝ́ Adamǝ ŋ tòomu mǝ ne tie Awa, wǝ́ Awa ŋ rè wǝkulukpǝ. Wǝ́ ŋ mǝnǝ Kayɩŋ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko lo toŋ mǝ wǝ́ ŋ́ nǝ mǝ pǝrǝŋyǝ.» <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Wǝla kǝmaakǝ wǝ́ ŋ mǝnǝ Kayɩŋ la paanʊ Abɛlǝ.</para>
  <para style="p" vid="GEN 4:2">Abɛlǝ kǝ ŋ rǝŋ amɛɛpǝ, wǝ́ Kayɩŋ ŋ ke ri tɛɛtɛɛkpɛŋtǝyǝ. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Rǝ eniyǝ rɛ la kǝmaakǝ wǝ́ Kayɩŋ ŋ fǝ̀ na atɛɛtɛɛtuyǝ la arɛɛyǝ ŋ pǝlǝ ŋ kòonu Ǝtǝ Woroko. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Wǝ́ Abɛlǝ ŋwǝ ŋkpɛ ŋ pɔ̀rʊ na amɛɛpisǝsǝŋpǝ rǝ na akɛɛpǝ lǝ mǝrǝ ŋ pǝlǝ mǝ. Wǝ́ ŋ wʊlʊ pǝ. Wǝ́ ŋ fǝ̀ gakǝ we la afɛɛceeceeyǝ ŋ kòonu Ǝtǝ Woroko. Wǝ́ Ǝtǝ Woroko ŋ lɔ̀ Abɛlǝ mǝ no tukoonuwǝ we sɩsiɛrɩ. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />Paa laa lɔ Kayɩŋ mǝ no tukoonuwǝ sɩsiɛrɩ. Wǝ́ Kayɩŋ ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋpa, wǝ́ ŋ lɔ̀ anyɩŋkǝ ŋ nyàrǝ. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ Kayɩŋ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ ǝ lǝ fǝ̀ kpɛɛmʊrʊwǝ? Wǝ́ kǝ́ kǝto wǝ́ a la lɔ anyɩŋkǝ a la nyarǝ wǝ? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Mǝŋ e lée yee sɩsiɛrɩ we, ŋ́ náa lɔ ŋnǝ mǝ ló tukoonuwǝ sɩsiɛrɩ. Mǝŋ ǝ lǝŋ yee sɩsiɛrɩ we, turɔɔrɔɔwǝ wǝ lo co tuwǝ wǝ kpɛlɩ lǝ́ rǝ guŋpolurǝ. Wǝ ya wǝ lǝ́ǝ pǝ́ wǝ ri lǝ́ yurǝ. Paape we, ŋlǝ́ ri wǝlo yurǝ».<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Wǝla kǝmaakǝ we, wǝ́ Kayɩŋ ŋ tìi na paanʊ Abɛlǝ ǝkǝnǝŋ: «Pǝ kǝ lo ko atɛɛkǝ». Kǝ́ pǝ le ke fii atɛɛkǝ we, wǝ́ Kayɩŋ ŋ yili ŋ ka ŋ lɔ na paanʊ Abɛlǝ, wǝ́ ŋ wʊlʊ ŋwǝ. <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ Kayɩŋ ǝkǝnǝŋ: «Kǝnǝ lá paanʊ Abɛlǝ ǝyǝ?» Wǝ́ Kayɩŋ ŋ yìili ǝkǝnǝŋ: «Ŋ́ nee ci. Ŋmǝ ŋ́ ri mǝ paanʊ lǝ rǝŋtǝyǝ?» <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ e le yee ǝnǝ? Lá paanʊ la ŋpǝrayǝ la kpɛɛwǝ wǝ lo woolu wǝ lo ru rǝ kǝtǝǝwǝ wǝ lo po tuu mǝ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Fǝ rǝkǝsa mǝ ko we, ŋ́ na fwɛɛrɩ lǝ́ rǝ kǝtǝǝwǝ<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ: Ŋ́ na fwɛɛrɩ lǝ́ wǝ́ ŋ́ ne piri lǝ́ rǝ kǝtǝǝwǝ.</char></note> we wǝ lo ŋuŋ lá paanʊ la ŋpǝrayǝ we a la lʊ wǝ. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Vǝ́ a la kpɛŋ atɛɛkǝ we, kǝtǝǝwǝ wǝ lǝŋ tǝ wǝ poŋ otuyǝ wǝ koonu lǝ́. O lóo co a mǝ tɛlɩ rǝ kǝtǝǝwǝ, o ko rǝ sa ǝ pǝ rǝ sa.» <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />Wǝ́ Kayɩŋ ŋ tìi Ǝtǝ Woroko ǝkǝnǝŋ: «Mǝ tukoŋtawǝ sa wǝ naanǝ kururu, ŋ́ nǝŋ koru wǝ la alɔ. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Yɩrɩ re! Ruŋruŋwǝ sa a ya lée piri mǝ rǝ kǝtǝǝkpɛŋwǝ sa lo oŋuŋkǝ, kǝ ŋ́ lǝǝ rǝ lá kǝnyɩŋkǝ, ŋ́ nóo co mǝ ŋ tɛlɩ rǝ kǝtǝǝwǝ mǝ ŋ ko rǝ sa mǝ ŋ pǝ rǝ sa. Nyi ri ŋ nyi ŋ nóo ku mǝ mǝ we, láa wʊ mǝ.» <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ ponu! Mǝŋ rɛ la wʊ Kayɩŋ we, pǝ láa ca yǝ we lǝ wǝ la kpawǝ pǝrǝŋwǝ kǝpǝrɩmata». Wǝ́ Ǝtǝ Woroko ŋ tɛ̀ɛ Kayɩŋ la barǝ kǝ mǝŋ rɛ lo kumǝ ŋwǝ we, kǝ yǝ we ŋ paa wʊ ŋwǝ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Wǝ́ Kayɩŋ ŋ pwɛ̀yɩ rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ wǝ́ ŋ kolu ŋ kpìi rǝ Nodǝ lǝ gǝŋrǝ rǝ Edɛnǝ la kǝcɔkɔŋpoŋkǝ.<verse eid="GEN 4:16" /></para>
  <para style="s">Kayɩŋ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Wǝ́ Kayɩŋ ŋ tòomu mǝ ne tie, wǝ́ ŋ rè, wǝ́ ŋ mǝnǝ Enɔkǝ. Wǝ́ Kayɩŋ ŋ yili ŋ ka ŋ tɔ tǝŋtǝǝwǝ. Wǝ́ ŋ fǝ̀ ne pi Enɔkǝ la nyɩŋrǝ ŋ kpìi tǝŋtǝǝwǝ we. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Wǝ́ pǝ mǝnǝ Iradǝ pǝ kòonu Enɔkǝ, wǝ́ Iradǝ ŋ mǝnǝ Mewuyayɛlǝ. Mewuyayɛlǝ ŋ mǝnǝ Metusayɛlǝ, wǝ́ Metusayɛlǝ ŋ mǝnǝ Lamɛkǝ.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Lamɛkǝ lɔ̀ etiepǝ eyi, sǝsǝŋyǝ ŋ ke ri Ada, wǝ́ yitǝyǝ ŋ ke ri Sila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Wǝ́ Ada ŋ mǝnǝ Yabalǝ. Ŋwǝ ŋ ke ri epǝ we pǝ lée kpii rǝ epwiiyǝ wǝ́ pǝ láa yaalǝ akɛɛpǝ lǝ tǝtǝtǝtǝyǝ. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Na paanʊyǝ ŋ ke ri Yubalǝ. Yubalǝ ŋ ke ri epǝ we pǝ láa ca ɖuleyǝ wǝ́ pǝ lǝ́ǝ kpǝǝ delɛɛrǝ lǝ tǝtǝtǝtǝyǝ wǝ. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Wǝ́ Sila ŋwǝ ŋkpɛ ŋ mǝnǝ Tubalǝ Kayɩŋ. Ŋwǝ ŋ kǝ ŋ fǝ tʊkʊtuwǝ mǝ tʊkʊtutiwǝ mǝ ŋ kʊʊ otuyǝ kpǝlo kɩɩkɩ wǝ. Tubalǝ Kayɩŋ la paatɛyǝ ŋ ka kaamǝ Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Wǝ́ Lamɛkǝ ŋ tìi ne etiepǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 4:23">«Ada mǝ sila, nǝ nuŋ mǝ kpɛɛwǝ!</para>
  <para style="q1" vid="GEN 4:23">Lamɛkǝ le etiepǝ, nǝ co kǝtukoŋkǝ rǝ dierǝ sa ŋ́ nah tɛŋ wǝ!</para>
  <para style="q1" vid="GEN 4:23">Ŋ́ na wʊ nyiyǝ mǝ kǝ́ pǝ la nyaanǝ mǝ kǝto,</para>
  <para style="q1" vid="GEN 4:23">ŋ́ na wʊ piyǝ mǝ kǝ́ pǝ la fʊfwɛ mǝ kǝto<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Mǝŋ pǝ láa wʊ enyipǝ apǝrɩmata</para>
  <para style="q1" vid="GEN 4:24">pǝ ca Kayɩŋ la kpawǝ we,</para>
  <para style="q1" vid="GEN 4:24">pǝ láa wʊ tǝpǝrɩmata mǝ apǝrɩmata</para>
  <para style="q1" vid="GEN 4:24">pǝ ca Lamɛkǝ la kpawǝ».<verse eid="GEN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Wǝ́ Adamǝ ŋ tǝ ŋ tòomu mǝ ne tie, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Seeti, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ lǝ tǝ lo koonu mǝ wǝmǝpʊŋpwakpǝ rǝ Abɛlǝ lo yuwǝ, kpiikǝ Kayɩŋ la wʊ ŋwǝ.» <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Wǝ́ pǝ mǝnǝ bǝrǝŋpirǝ pǝ kòonu Seeti ŋwǝ ŋkpɛ. Wǝ́ ŋ kpìi na nyɩŋrǝ Enɔsǝ. Fǝ rǝ eniyǝ we wǝ́ enyipǝ pǝ tìe Worokoyǝ la asʊmakǝ pǝ ŋ pwo ŋwǝ Ǝtǝ Woroko.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">Adamǝ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Adamǝ lǝ wǝmǝkpǝ le dierǝ gaamǝ ɖǝ ǝnǝ:</para>
  <para style="m" vid="GEN 5:1">Kǝ́ Worokoyǝ ŋ cò nyɩmaasɩyǝ we, cò ŋwǝ rǝ ŋwǝŋwǝ Worokoyǝ lǝ wǝlǝkpǝ. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Cò pǝrǝŋyǝ mǝ tieyǝ. Jirǝ we ŋ cò pǝ we, wǝ́ ŋ pɛ̀ɛrɩ pǝ, wǝ́ ŋ kpìi pǝla nyɩŋrǝ ǝkǝnǝŋ nyɩmaasɩyǝ.<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Adamǝ lɔ̀ cɛŋwǝ tuuru mǝ tǝta wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ rǝ nǝ wǝlǝkpǝ, wǝ́ ŋ rù ŋwǝ. Wǝ́ ŋ kpìi na nyɩŋrǝ Seeti. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Kǝ́ Adamǝ ŋ nǝ mǝ Seeti la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Adamǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tǝta wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Seeti lɔ̀ cɛŋwǝ tuuru mǝ tʊʊ wǝ́ ŋ mǝnǝ Enɔsǝ. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Kǝ́ Seeti ŋ nǝ mǝ Enɔsǝ ŋ na lɛ la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ mǝ pǝrɩmata. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Seeti la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tǝ mǝ yi wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Enɔsǝ lɔ̀ cɛŋwǝ tǝfaŋceŋceŋ wǝ́ ŋ mǝnǝ Kenanǝ. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Kǝ́ Enɔsǝ ŋ nǝ mǝ Kenanǝ la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ mǝ tǝ mǝ tʊʊ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Enɔsǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tʊʊ, wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kenanǝ lɔ̀ cɛŋwǝ tǝpǝrɩmata wǝ́ ŋ mǝnǝ Mahalalɛlǝ. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Kǝ́ Kenanǝ ŋ nǝ mǝ Mahalalɛlǝ la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ mǝ tǝniǝ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Kenanǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tǝ, wǝ́ ŋ ci ǝ kpǝ̀. <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />Mahalalɛlǝ lɔ̀ cɛŋwǝ tǝkʊraŋ mǝ tʊʊ wǝ́ ŋ mǝnǝ Yerɛdǝ. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Kǝ́ Mahalalɛlǝ ŋ nǝ mǝ Yerɛdǝ la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ mǝ tǝta. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Mahalalɛlǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurunɛŋ mǝ tǝfaŋceŋceŋ mǝ tʊʊ wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Yerɛdǝ lɔ̀ cɛŋwǝ tuuru mǝ tǝkʊraŋ mǝ yi wǝ́ ŋ mǝnǝ Enɔkǝ. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Kǝ́ Yerɛdǝ ŋ nǝ mǝ Enɔkǝ la kǝmaakǝ we, wǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuurunɛŋ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Yerɛdǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tǝkʊraŋ mǝ yi wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Enɔkǝ lɔ̀ cɛŋwǝ tǝkʊraŋ mǝ tʊʊ wǝ́ ŋ mǝnǝ Metusela. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Kǝ́ Enɔkǝ ŋ nǝ mǝ Metusela la kǝmaakǝ we, wǝ́ ŋ sìimǝ Worokoyǝ cɛŋwǝ tuuruta. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Enɔkǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuuruta mǝ tǝkʊraŋ mǝ tʊʊ. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Enɔkǝ sìimǝ Worokoyǝ. Wǝ́ ŋ pǝlǝ ŋ lǝ̀ rǝ, duturǝ ɖi Worokoyǝ ŋ pǝlǝ ŋ fǝ̀ ŋwǝ ŋ pwɛ̀yɩ.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Metusela lɔ̀ cɛŋwǝ tuuru mǝ tǝnɛŋ mǝ pǝrɩmata wǝ́ ŋ mǝnǝ Lamɛkǝ. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Kǝ́ Metusela ŋ nǝ mǝ Lamɛkǝ la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurupǝrɩmata mǝ tǝnɛŋ mǝ yi. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Metusela la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurufaŋceŋceŋ mǝ tǝkʊraŋ mǝ faŋceŋceŋ wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Lamɛkǝ lɔ̀ cɛŋwǝ tuuru mǝ tǝnɛŋ mǝ yi wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Wǝ́ ŋ kpìi na nyɩŋrǝ Nowa, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ nah pa ta lǝ turuwǝ rǝ anǝnɛyǝ sa mǝ vaŋrǝ sa kǝtǝǝwǝ sa wǝ ya wǝ lée kpii lah wǝkaakpǝ wǝ. Kpiikǝ Ǝtǝ Woroko ŋ na fwɛɛrɩ kǝtǝǝwǝ wǝ.» <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Kǝ́ Lamɛkǝ ŋ nǝ mǝ Nowa la kǝmaakǝ we, wǝ́ ŋ tini vɔrʊrǝ cɛŋwǝ tuurutʊʊ mǝ tǝfaŋceŋceŋ mǝ tʊʊ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Lamɛkǝ la acɛŋyǝ kpǝlo kɩɩkɩ ŋ tini vɔrʊrǝ yǝ kǝ lǝ cɛŋwǝ tuurupǝrɩmata mǝ tǝpǝrɩmata mǝ pǝrɩmata wǝ́ ŋ ci ǝ kpǝ̀.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Nowa lɔ̀ cɛŋwǝ tuurutʊʊ wǝ́ ŋ mǝnǝ Semǝ, Hamǝ mǝ Yafɛtǝ.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">Worokoyǝ lǝ fǝ la tɛ rǝ na wɛ ŋ nǝ́ǝ nǝǝnǝ anyɩmaasɩpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Kǝ́ anyɩmaasɩpǝ pǝ tìe ayaarǝkǝ rǝ kǝtǝǝwǝ we, wǝ́ pǝ kǝ ŋ mǝǝnǝ etiepipǝ pǝ ŋ koonu pǝ we, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />wǝ́ Worokoyǝ lǝ ǝpǝrǝŋpipǝ<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Pǝ reemǝ Worokoyǝ le epicoŋpipǝ amaa yulaarǝ le enyipǝ.</char></note> pǝ nyɩnɩ ǝkǝnǝŋ anyɩmaasɩpǝ le etiepipǝ sa pǝ lóo poŋ ayɩrɩ. Wǝ́ ŋpǝŋpǝ pǝ ka ŋ pɔrʊ epǝ we pǝ ponu mǝ pǝ pǝ ŋ lɔ wǝtiekpǝ. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ wɛɛrǝ lǝŋ kpii rǝ nyɩmaasɩyǝ lǝ mǝrǝ kǝkpakǝkpa, duturǝ ɖi lǝh pǝ kpǝ́ jirǝ rɛ taa. Kǝto ŋ́ nóo koonu kǝ na vɔrʊrǝ la acɛŋyǝ yǝ lǝ tuuru mǝ tiyi.» <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />Rǝ eniyǝ we lǝ mǝrǝ we, enyipǝ rɛ pǝ lo ru kǝnyikǝ pǝ ke kpii rǝ kǝtǝǝwǝ. Ŋpǝ enyipǝ sa pǝ kǝ tǝ pǝ kpii mǝ eniyǝ we Worokoyǝ lǝ ǝpǝrǝŋpipǝ pǝ pǝlǝ pǝ nyɩnɩ anyɩmaasɩpǝ le etiepipǝ wǝ́ pǝ ka ŋ kpɛɛ mǝ pǝ ǝkǝ pǝ kǝ ŋ mǝǝnǝ epipǝ wǝ. Ŋpǝ enyipǝ sa pǝ lo ru kǝnyikǝ pǝ ke ri okopilǝtǝpǝ rɛ pǝ le tii pǝ la pa tɛlɩ, wǝ́ pǝ la lɛ pǝ lo ru nyɩŋrǝ wǝ.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Wǝ́ Ǝtǝ Woroko ŋ pǝlǝ ŋ nyɩnɩ ǝkǝnǝŋ anyɩmaasɩpǝ lo yulɛnyɩrǝ ya láa naanǝ lǝ ŋ kʊla rǝ kǝtǝǝwǝ rǝ ko. Ji ri ŋ ji vǝ́ pǝ lah nya pǝ ŋ pu yurǝ rɛ ko we, turɔɔrɔɔwǝ lo yurǝ wǝ́ pǝ lóo pu. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Wǝ́ wǝ fìi Ǝtǝ Woroko mǝ kǝ́ ŋ no co anyɩmaasɩpǝ rǝ kǝtǝǝwǝ wǝ. Wǝ pìa mǝ ŋwǝ ŋpa. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ náa siɛ anyɩmaasɩpǝ sa ŋ́ no co ŋ cɛ rǝ kǝtǝǝwǝ. Fǝ rǝ enyipǝ, akɛɛpǝ ko ru mǝŋ akɛɛtiinipǝ, mǝŋ ofuripǝ sa pǝ lée yi pǝ ŋ tɛlɩ wǝ. Duturǝ ɖi wǝ ya wǝ lée fii mǝ kǝ́ ŋ́ no co pǝ wǝ.» <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Paa wǝ́ Ǝtǝ Woroko ŋ yeli Nowa la lɛsiɛrɩwǝ.<verse eid="GEN 6:8" /></para>
  <para style="s">Nowa lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Nowa lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ. Nowa ke ri nyikʊʊyǝ mǝ nʊkɔrǝlǝtǝyǝ rɛ rǝ ne eniyǝ we le enyipǝ lǝ mǝrǝ. Ke ŋ siimǝ Worokoyǝ la akʊŋyǝ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Mǝnǝ ǝpǝrǝŋpipǝ ata: Semǝ, Hamǝ mǝ Yafɛtǝ. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />Wǝ́ kǝtǝǝwǝ wǝ pǝ̀lǝ rǝ Worokoyǝ le enimiyǝ, anyɩŋ enyipǝ lǝ wǝlǝrɔɔrɔɔkpǝ wǝ la lɔ kǝtiikǝ rǝ kǝtǝǝwǝ la fɛɛ ri ŋ fɛɛ. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Kǝ́ Worokoyǝ ŋ na yɩrɩ kǝtǝǝwǝ we, wǝ́ ŋ nyɩnɩ ǝkǝnǝŋ wǝ lǝ pǝlǝ. Duturǝ ɖi anyɩmaasɩpǝ kpǝlo pǝ ya pǝ lée ri vɔrʊrɔɔrɔɔrǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Wǝ́ Worokoyǝ ŋ tìi Nowa ǝkǝnǝŋ: «Ŋ́ nǝ fǝ ŋ́ na tɛ rǝ mǝ wɛ, eniyǝ yǝ lo ro kǝ anyɩmaasɩpǝ kpǝlo pǝ kpǝ́ pǝ nǝŋ. Duturǝ ɖi ŋpǝ kǝto wǝ́ wǝlǝrɔɔrɔɔkpǝ wǝ lǝ lǝ kǝtǝǝwǝ wǝ, kǝto ŋ́ nǝ́ǝ nǝǝnǝ pǝ mǝŋ kǝtǝǝwǝ.<verse eid="GEN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 6:14" />Fǝ wǝciilɛnyɩkpǝ rɛ ǝ kpǝ gbanǝŋwaarǝ o koonu lá wɛ, kǝ e kpii okuyǝ rǝ mǝrǝ we, kǝ o nuŋ rǝ la aŋɔyǝ mǝŋ mǝrǝ mǝŋ dǝǝtǝǝrǝ. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />A lǝŋ nyɩŋ kǝ́ ǝ lǝh kpǝ gbanǝŋwaarǝ we ǝ fǝ wǝ: Rǝlo wǝkoŋkpǝ wǝ lǝ́ǝ lǝ mɛtayǝ tuuru mǝ tǝtʊʊ. Rǝla wǝyɔkɔɔkpǝ wǝ lǝ́ǝ lǝ mɛtayǝ tiyi mǝ tʊʊ, kǝ rǝlǝ wǝkǝŋkpǝ wǝ lǝ mɛtayǝ tǝ mǝ tʊʊ. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Yee gbanǝŋwaarǝ we la kpaalǝwǝ. Vǝ́ e leh sii rǝ, kǝ a pɔrʊ doloŋrǝ mɛtafarǝ rǝ gbanǝŋwaarǝ we mǝ kpaalǝwǝ we le kǝtiitiikǝ. Kpii guŋpolurǝ rǝ rǝla kǝtarɛɛkǝ. Sǝpǝ gbanǝŋwaarǝ we fɛɛwǝ kpeewǝ ta fǝ rǝ pɔɔlʊwǝ fǝ rɛ: fɛɛrɛɛwǝ rǝ pɔɔlʊwǝ, fɛɛrɛɛwǝ rǝ kǝtiitiikǝ, fɛɛrɛɛwǝ rǝ oŋuŋkǝ. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Ŋmǝ paa we, ŋ́ noh koonu kǝ ŋʊŋtɛmumuŋyǝ rɛ ŋ pǝ kǝ kǝtǝǝwǝ wǝ lǝ mǝ mɛŋwǝ pwɩ kǝ wǝ nǝǝnǝ tu ri ŋ tu wǝ kpii vɔrʊrǝ rǝ kǝtǝǝwǝ wǝ. Tu ri ŋ tu wǝ kpii rǝ kǝtǝǝwǝ wǝ lǝ́ǝ kpǝ́. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Paa ŋ́ náa parǝ dierǝ ŋ́ tǝnǝ rǝ ŋlǝ mǝ lǝ́ le kǝtiitiikǝ. E lée fii gbanǝŋwaarǝ we lǝ mǝrǝ, ŋlǝ́, lǝ́ ǝpǝrǝŋpipǝ, lé tie mǝ le epiletiepǝ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Rǝ akɛɛpǝ we kpǝlo kɩɩkɩ pǝ kpii vɔrʊrǝ lǝ mǝrǝ we, ǝ lǝ́ǝ fǝ kɛɛ ri ŋ kɛɛ eyi eyi, yiyee mǝ nunuŋ, e kpii rǝ gbanǝŋwaarǝ we lǝ mǝrǝ kǝ pǝ nya fɛɛ pǝ tii vɔrʊrǝ pǝ kʊla mǝ lǝ́. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Furi ri ŋ furi rǝ ofuripǝ lǝ mǝrǝ, kɛɛ ri ŋ kɛɛ rǝ akɛɛpǝ lǝ mǝrǝ kɛɛtiini ri ŋ kɛɛtiini rǝ akɛɛtiinipǝ lǝ mǝrǝ rǝ kǝtǝǝwǝ. Akɛɛpǝ sa kpǝlo kɩɩkɩ eyi eyi pǝ lah pa kʊla mǝ lǝ́ kǝ pǝ tii vɔrʊrǝ. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Ŋlǝ́ we, fǝ tu ri ŋ tu pǝ láa nya pǝ ŋ ri rǝ ko o toolu ǝ tǝnǝ lá wɛ. Ŋ wǝ wǝ lée ri lé keeriwǝ mǝ akɛɛpǝ we le keeriwǝ.» <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />Wǝ́ Nowa ŋ yeli tu ri ŋ tu mǝŋ kǝ́ Worokoyǝ ŋ tìi ŋwǝ ŋ yee pɛpɛ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Nowa le fii gbanǝŋwaarǝ we mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Wǝ́ Ǝtǝ Woroko ŋ tìi Nowa ǝkǝnǝŋ: «Ŋnǝ mǝ lá anyarǝtǝpǝ kpǝlo kɩɩkɩ nǝ mǝ fii gbanǝŋwaarǝ we lǝ mǝrǝ, duturǝ ɖi ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ ŋlǝ́ ceŋceŋ ko e ri nyikʊʊyǝ rǝ mǝ enimiyǝ rǝ rǝkǝsa le enyipǝ sa mǝrǝ. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Rǝ akɛɛpǝ we kpǝlo kɩɩkɩ ŋ́ nǝŋ kpǝlǝ lǝ mǝrǝ we, fǝ akɛɛpǝ eyi eyi yiyee mǝ nunuŋ fɛɛwǝ kpeewǝ pǝrɩmata, kǝ a pɔrʊ akɛɛpǝ eyi eyi, yiyee mǝ nunuŋ, rǝ epǝ we ŋ́ nǝ́ǝ kpǝlǝ lǝ mǝrǝ, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />kǝ a lɛ a pɔrʊ ofuripǝ eyi eyi, yiyee mǝ nunuŋ, fɛɛwǝ kpeewǝ pǝrɩmata rǝ ofuripǝ lǝ mǝrǝ kǝ a nya fɛɛ ǝ tǝnǝ pǝlǝ wǝmǝkpǝ rǝ kǝtǝǝwǝ kpǝlo kɩɩkɩ. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Duturǝ ɖi rǝ juu pǝrɩmata lǝ mǝrǝ we, ŋ́ noh koonu kǝ ŋʊŋtɛyǝ ŋ ya mǝ ŋ pǝ rǝ kǝtǝǝwǝ, mǝŋ dumu mǝŋ jɔkɔŋ, wǝcukpǝ tǝniǝ. Ŋ́ nǝ́ǝ nǝǝnǝ tu ri ŋ tu ŋ́ no co rǝ kǝtǝǝwǝ.» <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />Wǝ́ Nowa ŋ yeli ŋ sanǝ rǝ tu ri ŋ tu Ǝtǝ Woroko ŋ tìi ŋwǝ ŋ yee wǝ. <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />Nowa kǝ lǝǝmǝ cɛŋwǝ tuurukʊʊraŋ mǝ eniyǝ we mɛŋwǝ wǝ lǝ̀ kǝtǝǝwǝ pwɩ wǝ.<verse eid="GEN 7:6" /></para>
  <para style="s">Ŋʊŋtɛmumuŋyǝ we lǝ ǝpǝkǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 7:7" />Rǝ ŋʊŋtɛmumuŋyǝ we ŋ no furu kǝto wǝ́ Nowa ŋ kolu ŋ fìi gbanǝŋwaarǝ we lǝ mǝrǝ ŋpǝ mǝ ne epipǝ mǝ ne tie mǝ ne epiletiepǝ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Wǝ́ akɛɛpǝ we Worokoyǝ ŋ nǝŋ kpǝlǝ wǝ, mǝ epǝ we Worokoyǝ ŋ nǝ́ǝ kpǝlǝ wǝ, ofuripǝ mǝ akɛɛpǝ we kpǝlo pǝ lée tiini rǝ kǝtǝǝwǝ, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />eyi eyi, yiyee mǝ nunuŋ, pǝ kǝ ŋ pǝ pǝ ŋ tuu Nowa rǝ gbanǝŋwaarǝ we lǝ mǝrǝ mǝŋ kǝ́ Worokoyǝ ŋ tìi ŋwǝ kǝtǝ. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Juu pǝrɩmata la kǝmaakǝ, wǝ́ ŋʊŋtɛmumuŋyǝ we la mɛŋwǝ wǝ kǝ ŋ lǝ kǝtǝǝwǝ. <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />Rǝ Nowa la cɛŋtuurukʊʊraŋtǝwǝ, rǝ kɛɛyitǝyǝ lo juu tǝ mǝ pǝrɩmatatǝrǝ we, jirǝ we we, wǝ́ mɛŋwǝ we wǝ kpii rǝ kǝtǝǝwǝ lǝ kǝnǝŋkǝ wǝ ka ŋ nyaa wǝ ŋ ru siasia. Wǝ́ yulaarǝ nyàlǝ mǝ mɛŋwǝ. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Wǝ́ ŋʊŋtɛyǝ ŋ yà ŋ ka ŋ sʊʊ mǝŋ dumu mǝŋ jɔkɔŋ wǝcukpǝ tǝniǝ milimili. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />Ŋrǝ jirǝ we wǝ́ Nowa mǝ ne epipǝ Semǝ, Hamǝ mǝ Yafɛtǝ fǝ kʊla mǝ Nowa le tie mǝ ne epiletiepǝ ata pǝ kolu pǝ fìi gbanǝŋwaarǝ we lǝ mǝrǝ. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Wǝ́ akɛɛpǝ kɩɩkɩ lǝ ǝkpǝŋyǝ kpǝlo mǝŋ epipi mǝŋ omumuŋ, akɛɛtiinipǝ lǝ ǝkpǝŋyǝ kpǝlo, ofuripǝ lǝ ǝkpǝŋyǝ kpǝlo, kɛɛ ri ŋ kɛɛ ŋ nya ŋ lǝmǝ wǝrookpǝ ŋ née yi wǝ. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Kɛɛ ri ŋ kɛɛ ŋ nya ŋ kpii vɔrʊrǝ, pǝ pǝlǝ pǝ tùu Nowa rǝ gbanǝŋwaarǝ we mǝrǝ eyi eyi. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Akɛɛpǝ lǝ ǝkpǝŋyǝ we kpǝlo kɩɩkɩ pǝ ke ŋ fii gbanǝŋwaarǝ we mǝrǝ pǝ kǝ lǝ yiyee mǝ nunuŋ mǝŋ kǝ́ Worokoyǝ ŋ tìi Nowa kǝtǝ. Wǝ́ Ǝtǝ Woroko ŋ lɔ̀ ŋwaarǝ we ŋ tanǝ ŋ kpìi Nowa. <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />Wǝ́ ŋʊŋtɛmumuŋyǝ we ŋ yà ŋ kǝ ŋ pǝ juu tǝniǝ milimili. Wǝ́ mɛŋwǝ we wǝ ko ŋ fuunu, wǝ́ wǝ fǝ̀ gbanǝŋwaarǝ we wǝ tɛ̀ɛ rǝ oŋuŋkǝ. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Wǝ́ mɛŋwǝ we wǝ tǝ wǝ ko ŋ fuunu wǝ ŋ kʊla rǝ, wǝ́ wǝ ka ŋ rɛ. Wǝ́ gbanǝŋwaarǝ we dɛ̀ rǝ mɛŋwǝ we lo oŋuŋkǝ go ŋ ko. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Wǝ́ mɛŋwǝ we wǝ pǝlǝ wǝ lǝ̀ kǝtǝǝwǝ ŋpa, wǝ́ otutupikǝŋyǝ kpǝlo kɩɩkɩ yǝ nǝnǝ. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Wǝ́ mɛŋwǝ we wǝ tɛ̀lɩ otutupiyǝ wǝ rɛ mɛtayǝ pǝrɩmata mǝ otuyǝ. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Wǝ́ kɛɛ ri ŋ kɛɛ ŋ ke kpii vɔrʊrǝ rǝ kǝtǝǝwǝ ŋ kpǝ̀. Ofuripǝ, anyarǝkɛɛpǝ, apɔɔkpaakɛɛpǝ, akɛɛtiinipǝ kpǝlo rǝ kǝtǝǝwǝ fǝ kʊla mǝ anyɩmaasɩpǝ pǝ kpǝ̀. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Tu ri ŋ tu wǝ ka ŋ wɛɛ wǝ ŋ suu rǝ kǝtǝǝwǝ mǝ eyǝ we kpǝlo yǝ ke kpii rǝ kǝtǝǝwǝ yǝ kpǝ̀. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Wǝ́ Ǝtǝ Worokoyǝ ŋ nǝ̀ǝnǝ tu ri ŋ tu wǝ ke kpii rǝ kǝtǝǝwǝ wǝ, fǝ rǝ anyɩmaasɩpǝ ko ru ǝrǝ anyarǝkɛɛpǝ mǝ apɔɔkpaakɛɛpǝ mǝ akɛɛtiinipǝ, fǝ kʊla mǝ ofuripǝ. Pǝlo kpǝlo pǝ kpǝ̀ pǝ nǝnǝ rǝ kǝtǝǝwǝ, we Nowa mǝ epǝ we pǝ ka kʊla mǝ ŋwǝ rǝ gbanǝŋwaarǝ we lǝ mǝrǝ ko pǝ tùuru pǝ tini vɔrʊrǝ. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />Wǝ́ mɛŋwǝ we wǝ lǝ̀ wǝ yàa rǝ kǝtǝǝwǝ wǝcukpǝ tuuru mǝ tǝtʊʊ.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Nowa lo ru rǝ gbanǝŋwaarǝ we mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Wǝ́ Worokoyǝ ŋ taalǝ Nowa mǝ apɔɔkpaakɛɛpǝ we mǝ anyarǝkɛɛpǝ we kpǝlo pǝ ke kpii pǝ kʊ̀la mǝ ŋwǝ rǝ gbanǝŋwaarǝ we mǝrǝ wǝ. Wǝ́ ŋ kòonu ǝrǝkǝ rɛ kǝ funu rǝ kǝtǝǝwǝ, wǝ́ mɛŋwǝ we wǝ tìe ǝrǝǝnǝkǝ. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Wǝ́ mɛŋwǝ we wǝ ko ŋ ru rǝ kǝtǝǝwǝ wǝ sǝnǝ. Wǝ́ Yulaarǝ danǝ. Wǝ́ ŋʊŋtɛyǝ we ŋ kàalǝ. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Wǝ́ mɛŋwǝ we wǝ kǝ ŋ rǝǝnǝ tɩpɩtɩpɩ. Kǝ́ wǝ lo ko wǝ loh ro wǝcukpǝ tuuru mǝ tǝtʊʊ we, wǝ́ mɛŋwǝ we wǝ rǝǝnǝ wǝ kolu wǝ sʊ̀ʊ. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Kɛɛpǝrɩmatatǝyǝ lo juu tǝ mǝ pǝrɩmatatǝrǝ we, wǝ́ gbanǝŋwaarǝ we golu dɛ̀ rǝ Araratǝ lo otutupiyǝ. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Wǝ́ mɛŋwǝ we wǝ tǝ wǝ kǝ ŋ rǝǝnǝ ko ro ǝrǝ kɛɛtǝtǝyǝ. Rǝ kɛɛtǝtǝyǝ sa le jisǝsǝŋrǝ we, wǝ́ otutupiteeyǝ yǝ ka ŋ nyɩnɩ. <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />Rǝ juutǝniǝ la kǝmaakǝ we, wǝ́ Nowa ŋ tàanǝ fasǝrɛyǝ we ŋ kpìi gbanǝŋwaarǝ we wǝ. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />Wǝ́ ŋ nyàrǝ kwakwayǝ ŋ cò. Wǝ́ kwakwayǝ we ŋ ke ŋ yi mǝ ŋ ko mǝ ŋ pǝ ko ro eniyǝ we mɛŋwǝ we wǝ rǝ̀ǝnǝ rǝ kǝtǝǝwǝ wǝ. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Wǝ́ ŋ tǝ ŋ nyàrǝ tookpaayǝ ŋ cò kǝ ŋ nyɩŋ mǝŋ mɛŋwǝ we wǝ la sʊʊ rǝ kǝtǝǝwǝ wǝ. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Paape tookpaayǝ we laa ka nya fɛɛwǝ ŋ nah tɛ kǝkparǝkǝ, wǝ́ ŋ sìɛnɩ ŋ pǝlǝ ŋ tùu Nowa rǝ gbanǝŋwaarǝ lǝ mǝrǝ. Duturǝ ɖi mɛŋwǝ we wǝ kǝ tǝ wǝ kpìi rǝ kǝtǝǝwǝ la fɛɛ ri ŋ fɛɛ. Wǝ́ Nowa ŋ kòonu akaakǝ ŋ tà tookpaayǝ we ŋ fìi mǝ rǝ arakayǝ we mǝrǝ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Wǝ́ ŋ tǝ ŋ rǝnǝ juu pǝrɩmata, wǝ́ ŋ tǝ ŋ nyàrǝ tookpaayǝ we ŋ cò. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Wǝ́ tookpaayǝ we ŋ kolu ŋ rù ŋ kǝ ŋ pǝ mǝ ɖiɔrǝ anyɩŋ rè olivǝciikpǝ le kǝwekookookǝ rǝ nyuŋkpǝ. Wǝ́ Nowa ŋ nyɩnɩ wǝ ŋ cìi ǝkǝnǝŋ mɛŋwǝ we wǝ la sʊʊ rǝ kǝtǝǝwǝ. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Wǝ́ Nowa ŋ tǝ ŋ rǝnǝ juu pǝrɩmata, wǝ́ ŋ tǝ ŋ nyarǝ tookpaayǝ we ŋ cò. Paape tookpaayǝ we lǝǝ tǝ ŋ ka siɛnɩ ŋ po tuu ŋwǝ.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Kǝ́ Nowa ŋ na lɔ cɛŋwǝ tuurukʊʊraŋ mǝ ceŋceŋ la kɛɛsǝsǝŋyǝ le jisǝsǝŋrǝ we, wǝ́ mɛŋwǝ we wǝ rǝ̀ǝnǝ rǝ kǝtǝǝwǝ. Wǝ́ Nowa ŋ wùru gbanǝŋwaarǝ we la kpaalǝwǝ, wǝ́ ŋ nyɩnɩ ǝkǝnǝŋ kǝtǝǝwǝ wǝ la kpaa. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Kɛɛyitǝyǝ lo juu tiyi mǝ bǝrɩmatatǝrǝ we, anyɩŋ kǝtǝǝwǝ wǝ la kpaa. <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />Wǝ́ Worokoyǝ ŋ tìi Nowa ǝkǝnǝŋ: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />«Ŋlǝ́, lé tie, lé epipǝ mǝ lé epiletiepǝ nǝ ru rǝ gbanǝŋwaarǝ we lǝ mǝrǝ. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Pɔrʊ akɛɛpǝ we kpǝlo kɩɩkɩ pǝ kpii pǝ kʊla mǝ lǝ́ o ru, kɛɛ ri ŋ kɛɛ lǝ kǝkpǝŋkǝ, ofuripǝ, akɛɛpǝ mǝ akɛɛtiinipǝ rǝ kǝtǝǝwǝ wǝ. Pɔrʊ pǝ o ru, kǝ pǝ mǝǝnǝ, kǝ pǝ yaarǝ rǝ kǝtǝǝwǝ, kǝ pǝ lǝ kǝtǝǝwǝ pǝ ŋ tɛlɩ.» <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />Wǝ́ Nowa mǝ ne epipǝ mǝ ne tie fǝ kʊla mǝ ne epiletiepǝ pǝ rù rǝ gbanǝŋwaarǝ we. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Wǝ́ akɛɛpǝ kpǝlo, akɛɛtiinipǝ we kpǝlo, ofuripǝ we kpǝlo mǝ akɛɛpǝ kpǝlo pǝ láa saŋ rǝ kǝtǝǝwǝ ŋpǝ ŋkpɛ pǝ rù, ǝ pǝ ri ŋ pǝ mǝ pǝlǝ kpǝŋwǝ. <verse eid="GEN 8:19" /><verse number="20" style="v" sid="GEN 8:20" />Wǝ́ Nowa ŋ tɔ̀ otoolucuukǝ ŋ kòonu Ǝtǝ Woroko. Wǝ́ ŋ pɔ̀rʊ akɛɛpǝ we Worokoyǝ ŋ nǝŋ kpǝlǝ kpǝlo kɩɩkɩ la arɛɛpǝ mǝ ofuripǝ we kpǝlo kɩɩkɩ ŋ nǝŋ kpǝlǝ la arɛɛpǝ ŋ wʊlʊ ŋ tù naawǝ rǝ otoolucuukǝ we ŋ kòonu Ǝtǝ Worokoyǝ. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Kǝ́ Ǝtǝ Woroko ŋ no nuŋ akɛɛpǝ we pǝ lo tu naa la jwɩɩrǝ we, wǝ́ na lɛrǝ dàarǝ. Wǝ́ ŋ tɛnɩ rǝ na wɛ lǝ mǝrǝ ǝkǝnǝŋ: «Fǝ rǝ ruŋruŋ mǝ ko ŋ́ nǝŋ tǝ ŋ́ pa kɔlʊ mǝ nyɩmaasɩyǝ kǝ ŋ́ fwɛɛrɩ kǝtǝǝwǝ kʊrakʊra. Ŋ́ cii wǝ ǝkǝnǝŋ nyɩmaasɩyǝ we, fǝ ǝrǝ na vɔŋrǝ turɔɔrɔɔwǝ lo yurǝ ko wǝ́ ŋ nóo pu. Paape ŋ́ nǝŋ tǝ ŋ́ pa wʊ tu ri ŋ tu wǝ kpii vɔrʊrǝ mǝŋ kǝ́ ŋ́ ne yee wǝ ǝnǝ kʊrakʊra.<verse eid="GEN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 8:22" />Kǝ́ kǝtǝǝwǝ wǝ nya wǝ kpii rǝ ko we,</para>
  <para style="q1" vid="GEN 8:22">Tuwǝ la arʊʊkǝ mǝ tuwǝ la alɛɛkǝ,</para>
  <para style="q1" vid="GEN 8:22">Ziɛrǝ mǝ naawʊrǝ,</para>
  <para style="q1" vid="GEN 8:22">Asiɛniyǝ mǝ anaawʊniyǝ,</para>
  <para style="q1" vid="GEN 8:22">Jɔkɔŋrǝ mǝ dumurǝ, yǝ lǝŋ pa wɛ.»<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Worokoyǝ la pɛɛrɩ Nowa wǝ́ ŋ ne kpii seyǝ ŋ no koonu ŋwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Worokoyǝ pɛ̀ɛrɩ Nowa mǝ nǝ ǝpǝrǝŋpipǝ tɛnɩ ǝkǝnǝŋ: «Nǝ mǝ, kǝ nǝ yaarǝ, kǝ nǝ lǝ kǝtǝǝwǝ. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Akɛɛpǝ kpǝlo rǝ kǝtǝǝwǝ mǝ ofuripǝ kpǝlo rǝ yulaarǝ, akɛɛtiinipǝ kpǝlo mǝ acakparǝpǝ kpǝlo kɩɩkɩ rǝ apʊyǝ pǝ loh mǝ suu nǝ ŋpa. Ŋ́ nǝ fǝ pǝ ŋ́ ne kpii nǝ rǝ akaakǝ. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Kɛɛ ri ŋ kɛɛ ŋ nya ŋ kpii vɔrʊrǝ rǝ kǝtǝǝwǝ, wǝ́ ŋ nóo ru wɛɛwǝ we, nǝ nyóo koru owo na gakǝ. Mǝŋ kǝ́ ŋ́ kòonu nǝ ewetuyǝ we, kǝ́ ŋ́ tǝ ŋ́ ya ŋ́ nǝ́ǝ fǝ tu ri ŋ tu mǝ ŋ koonu nǝ wǝǝ. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />Nǝ poo wo gakǝ we kǝ tǝ kǝ kpii mǝ ŋpǝrayǝ. Duturǝ ɖi ŋpǝrayǝ ŋ nóo koonu anyɩŋ kɛɛyǝ kpii vɔrʊrǝ wǝ. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Nǝ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ, vǝ́ rɛ la lʊ ŋnǝ ŋkpɛ nǝ ŋpǝrayǝ we ŋ ri nǝ vɔrʊrǝ we, ŋ́ nǝh pǝ pǝ́ yǝ we lǝ wǝ la akʊŋtayǝ. Wǝ ke ce wǝ ri kɛɛyǝ ŋ na wʊ nyɩmaasɩyǝ oo, ŋ́ nǝ́ǝ pǝ́ nǝ wǝ la akʊŋtayǝ. Wǝ ke ce wǝ ri nyɩmaasɩyǝ ŋ na wʊ na kɛrɩ nyɩmaasɩyǝ o, ŋ́ nǝ́ǝ pǝ́ nǝ wǝ la akʊŋtayǝ. Ŋ́ nǝ́ǝ pǝ́ nyi ri ŋ nyi la akʊŋtayǝ ŋ́ ru rǝ na kɛrɩyǝ la vɔrʊrǝ. <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />Yǝ we ŋ na lʊ nyɩmaasɩyǝ la ŋpǝrayǝ we,</para>
  <para style="q1" vid="GEN 9:6">Nyɩmaasɩyǝ ke ŋ náa lʊ ŋwǝ nyiyǝ we la ŋpǝrayǝ.</para>
  <para style="q1" vid="GEN 9:6">Duturǝ ɖi Worokoyǝ yàa nyɩmaasɩyǝ</para>
  <para style="q1" vid="GEN 9:6">rǝ ŋwǝŋwǝ nǝ wǝlǝkpǝ.»<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tìi Nowa ǝkǝnǝŋ: «Ŋnǝ paa we, nǝ mǝǝnǝ epipǝ kǝ nǝ yaarǝ. Nǝ lǝ kǝtǝǝwǝ, kǝ nǝ yaarǝ rǝ wǝ.»<verse eid="GEN 9:7" /></para>
  <para style="s">Worokoyǝ la parǝ dierǝ mǝ Nowa</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Wǝ́ Worokoyǝ ŋ tìi Nowa mǝ nǝ ǝpǝrǝŋpipǝ we ǝkǝnǝŋ: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />«Ŋmǝ we, ŋ́ nah parǝ dierǝ mǝ nǝ, mǝ nǝ wǝmǝkpǝ we wǝ lǝh pǝ pǝ rǝ nǝ kǝmaakǝ wǝ, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />fǝ kʊla mǝ akɛɛpǝ sa kpǝlo pǝ kʊla mǝ nǝ wǝ: ofuripǝ, anyarǝkɛɛpǝ mǝ apɔɔkpaakɛɛpǝ we kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ pǝ kʊla mǝ nǝ wǝ. Kǝ lǝ fǝ wǝ, tu ri ŋ tu wǝ lo ru rǝ gbanǝŋwaarǝ we mǝrǝ, mǝŋ akɛɛpǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Ŋ́ ya ŋ́ náa parǝ dierǝ mǝ nǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋ́ nǝŋ tǝ ŋ́ pǝ fǝ ŋʊŋtɛmumuŋyǝ sa la mɛŋwǝ ŋ́ nǝǝnǝ nyɩmaasɩyǝ rɛ amaa kɛɛyǝ rɛ kʊrakʊra. Ŋ́ nǝŋ tǝ ŋ́ pa lɛ ŋ́ koonu kǝ ŋʊŋtɛmumuŋyǝ rɛ ŋ pǝ kǝ ŋ pǝlǝ kǝtǝǝwǝ kʊrakʊra.”» <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ nyǝŋ nyɩŋ dierǝ we ŋ́ na parǝ ŋ́ nǝ tǝnǝ kǝkpakǝkpa rǝ ŋlǝ mǝ nǝ mǝ akɛɛpǝ we kpǝlo kɩɩkɩ pǝ kʊla mǝ nǝ, mǝ wǝmǝkpǝ kpǝlo wǝ lǝh pǝ pǝ la barǝ wǝǝ. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Ŋ́ nǝ fǝ mǝ sɩnawǝ ŋ́ ne kpii rǝ aŋɔɔyǝ lǝ mǝrǝ, ŋ wǝ wǝ lée ri mǝ dierǝ sa ŋ́ na parǝ ŋ́ nǝ tǝnǝ rǝ ŋlǝ mǝ kǝtǝǝwǝ le kǝtiitiikǝ la barǝ. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Mǝŋ jirǝ rɛ ŋ́ no po koonu ǝrǝkǝ kǝ le rimi, wǝ́ sɩnawǝ wǝ lo ru we, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />eniyǝ we ŋ́ náa taalǝ mǝ dierǝ we ŋ́ pàrǝ ŋ́ tǝ̀nǝ rǝ ŋlǝ mǝ nǝ mǝ akɛɛpǝ we kpǝlo kɩɩkɩ le kǝtiitiikǝ ǝkǝnǝŋ: “Ŋ́ nǝŋ tǝ ŋ́ po koonu kǝ ŋʊŋtɛmumuŋyǝ rɛ ŋ pǝ kǝ ŋ nǝǝnǝ anyɩmaasɩpǝ mǝ akɛɛpǝ.” <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Vǝ́ sɩnawǝ we wǝ la nya wǝ lo ru rǝ aŋɔɔyǝ we, ŋ́ náa nyɩŋ wǝ kǝ ŋ́ taalǝ dierǝ we ŋmǝ Worokoyǝ ŋ na parǝ ŋ́ nǝ tǝnǝ kǝkpakǝkpa rǝ ŋlǝ mǝ anyɩmaasɩpǝ kpǝlo mǝ akɛɛpǝ kpǝlo rǝ kǝtǝǝwǝ le kǝtiitiikǝ.» <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />Wǝ́ Worokoyǝ ŋ tǝ ŋ sìɛnɩ ŋ tìi Nowa ǝkǝnǝŋ: «Sɩnawǝ wǝ ri mǝ dierǝ we ŋ́ na parǝ ŋ́ nǝ tǝnǝ rǝ ŋlǝ mǝ anyɩmaasɩpǝ mǝ akɛɛpǝ rǝ kǝtǝǝwǝ le kǝtiitiikǝ la barǝ».<verse eid="GEN 9:17" /></para>
  <para style="s">Nowa lǝ ǝpǝrǝŋpipǝ le dierǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Semǝ, Hamǝ mǝ Yafɛtǝ pǝ ke ri Nowa lǝ ǝpǝrǝŋpipǝ we pǝ rù rǝ gbanǝŋwaarǝ we wǝ. Hamǝ ŋ ri Kanaŋ lǝ tǝ. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Pǝla atapǝ sa pǝ ke ri Nowa lǝ ǝpǝrǝŋpipǝ. Saŋ rǝ pǝla atapǝ sa wǝ́ enyipǝ pǝ lo to kǝtǝǝwǝ kpǝlo. <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />Nowa ŋ ke ri tɛɛtɛɛkpɛŋtǝsǝsǝŋyǝ. Wǝ́ ŋ kpɛnɩ arɛzɛŋtɛɛkǝ. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Wǝ́ jirɛɛrǝ ŋ ŋunu vɛŋyǝ ŋ pìemu, wǝ́ ŋ kolu ŋ kpɛlɩ kǝtaŋkpa rǝ ne bwiirǝ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Kǝ́ Kanaŋ lǝ tǝ Hamǝ ŋ na ka nyɩŋ nǝ tǝ la kǝtaŋkpaakǝ we, wǝ́ ŋ fǝ̀ ŋ kolu ŋ tìi na apaanʊpǝ we eyipǝ rǝ koruwǝ. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Wǝ́ Semǝ mǝ Yafɛtǝ pǝ fǝ̀ kǝkpakpurumukǝ wǝ́ pǝ wùru kǝ pǝ tɛ̀ɛ rǝ pǝlo okoŋkoŋyǝ, wǝ́ pǝ sanǝ pǝ ko ŋ ko mǝ kǝmaa mǝ kǝmaa. Wǝ́ pǝ kolu pǝ sìi pǝlǝ tǝ la kǝtaŋkpaakǝ. Kǝ́ pǝ sìɛrɩ anyɩŋkǝ kǝto pǝ laa nyɩŋ pǝlǝ tǝ la kǝtaŋkpaakǝ. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />Kǝ́ ǝfǝŋpǝ we pǝ le pe yi rǝ Nowa we, wǝ́ ŋ nunu tuwǝ we nǝ bǝrǝŋpipipirǝ we le yee mǝ ŋwǝ wǝ. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />Wǝ́ Nowa ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 9:25">«Ŋ́ na fwɛɛrɩ Kanaŋ!</para>
  <para style="q1" vid="GEN 9:25">Ŋ yee na apaanʊpǝ la rɔŋtuturututuruyǝ.»<verse eid="GEN 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="GEN 9:26" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 9:26">«Ŋ́ ya ŋ́ née ceeni Ǝtǝ Woroko, yǝ we ŋ ri Semǝ lo Worokoyǝ wǝ!</para>
  <para style="q1" vid="GEN 9:26">Kanaŋ ŋ siɛrɩ ŋ yee Semǝ la rɔŋyǝ.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Worokoyǝ ŋ ta Yafɛtǝ lǝ ǝkǝtǝǝyǝ ŋ kʊla!</para>
  <para style="q1" vid="GEN 9:27">Yafɛtǝ lǝ wǝmǝkpǝ mǝ Semǝ lǝ wǝmǝkpǝ wǝ tii fɛɛceŋceŋ,</para>
  <para style="q1" vid="GEN 9:27">kǝ Kanaŋ ŋ yee Yafɛtǝ la rɔŋyǝ.»<verse eid="GEN 9:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="GEN 9:28" />Rǝ ŋʊŋtɛmumuŋyǝ we la kǝmaakǝ we, Nowa tǝ tini vɔrʊrǝ cɛŋwǝ tuuruta mǝ tǝtʊʊ. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Nowa la acɛŋyǝ kpǝlo kɩɩkɩ yǝ kǝ lǝ tuurufaŋceŋceŋ mǝ tǝtʊʊ, wǝ́ ŋ kpǝ̀.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">Nowa le epipǝ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Nowa lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Semǝ, Hamǝ mǝ Yafɛtǝ. Rǝ ŋʊŋtɛmumuŋyǝ we la kǝmaakǝ wǝ́ pǝ mǝǝnǝ ǝpǝrǝŋpipǝ. Nowa lǝ ǝpǝrǝŋpipǝ sa lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ: <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />Yafɛtǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Gomɛrǝ, Magɔɔgǝ, Madayi, Yavaŋ, Tubalǝ, Mesɛkǝ mǝ Tirasǝ. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />Gomɛrǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Asekenasǝ, Rifa mǝ Togaama. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />Yavaŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Elisa, Tarǝsisǝ, Kitimǝ mǝ Rodanimǝ. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Ŋpǝ ǝpǝ ǝnǝ pǝ mǝnǝ wǝkpǝŋkpǝ we wǝ sǝ̀pǝ wǝ tini rǝ akpanǝcakpoyǝ wǝ. Ǝpǝ ri ŋ pǝ mǝ pǝla gaarǝ mǝ pǝlǝ kǝrǝkǝ, rǝ wǝsiɛrikpǝ rǝ pǝlǝ wǝkpǝŋkpǝ mǝrǝ. <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />Hamǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Kusǝ, Misǝrayimǝ, Putǝ mǝ Kanaŋ. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />Kusǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Seba, Avila, Sabǝta, Rama mǝ Sabǝteka. Rama lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Saba mǝ Dedaŋ. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />Kusǝ ŋ mǝnǝ Nimǝrodǝ. Ŋwǝ ŋ ke ri nyɩŋkalǝtǝsǝsǝŋyǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Ke ri kpaŋyǝ ŋ lǝǝmǝ nyɩŋkawǝ rǝ Ǝtǝ Woroko le enimiyǝ. Wǝ kǝto pǝ láa tɛŋ ǝkǝnǝŋ: «Ri kpaŋyǝ ŋ lǝǝmǝ nyɩŋkawǝ rǝ Ǝtǝ Woroko le enimiyǝ mǝŋ Nimǝrodǝ kǝtǝ wǝǝ.» <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Ǝtǝŋtǝǝsǝsǝŋyǝ we ŋ rili wǝpilikpǝ yǝ kaamǝ: Babɛlǝ, Erɛkǝ, Akadǝ mǝ Kaline rǝ Sineya lǝ gǝŋrǝ. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Wǝ́ Nimǝrodǝ ŋ rù rǝ gǝŋrǝ sa ŋ kolu Asurǝ lǝ gǝŋrǝ, wǝ́ ŋ kolu ŋ tɔ̀ ǝtǝŋtǝǝyǝ sa ǝnǝ: Ninive, Rewobɔtǝ Irǝ, Kala, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />mǝ Resɛŋ. Resɛŋ kpii rǝ Ninive mǝ Kala le kǝtiitiikǝ. Kala ŋ ri tǝŋtǝǝmumuŋwǝ.<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />Misǝrayimǝ ŋ ke ri enyipǝ we pǝ ke kpii rǝ Ludǝ, Anamǝ, Lehavǝ, Nafǝtuwa, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />Patǝrɔsǝ, Kasǝluwa wǝ ri fɛɛwǝ Efilisitǝpǝ pǝ lo ru wǝ, mǝ Kafǝtɔrǝ lǝ tǝtǝtǝtǝyǝ.<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />Kanaŋ le epipǝ pǝ kaamǝ: Ne pisǝŋmǝyǝ Zidɔŋ mǝ Hɛtǝ, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />mǝ Eyebusitǝpǝ, Amoritǝpǝ, Egirǝgasitǝpǝ, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />Ehevitǝpǝ, Arǝkitǝpǝ, Sinitǝpǝ, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />Arǝvadǝtǝpǝ, Semaritǝpǝ, Ahamatitǝpǝ. Rǝ wǝla kǝmaakǝ wǝ́ Kanaŋ la wǝsiɛrikpǝ we le enyipǝ pǝ canǝ awɛ. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Kanaŋtǝkǝtǝǝwǝ wǝ ka kpɛlɩ ru rǝ Zidɔŋ mǝ ko mǝ Gera la gaarǝ, ko ru ǝrǝ Gaza. Fǝ rǝ Sodomǝ mǝ Gomora la gaarǝ, Adǝma mǝ Seboyimǝ la gaarǝ kpa ko ru ǝrǝ Lesa. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />Hamǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ ǝnǝ, rǝ pǝla wǝsiɛrikpǝ, pǝlǝ wǝrǝkpǝ, pǝlǝ ǝkǝŋyǝ mǝ pǝlǝ wǝkpǝŋkpǝ.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Yafɛtǝ le mǝtee Semǝ ŋwǝ ŋkpɛ mǝnǝ ǝpǝrǝŋpipǝ. Ŋwǝ Semǝ ŋ ri Ebɛrǝ mǝ nǝ wǝmǝkpǝ kpǝlo kɩɩkɩ lǝ tǝtǝtǝtǝyǝ. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />Semǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Elamǝ, Asurǝ, Arǝpasadǝ, Ludǝ mǝ Aramǝ. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />Aramǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ Usǝ, Hulǝ, Getɛrǝ mǝ Masǝ. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />Arǝpasadǝ ŋ mǝnǝ Sela. Wǝ́ Sela ŋ mǝnǝ Ebɛrǝ. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />Ebɛrǝ mǝnǝ ǝpǝrǝŋpipǝ eyi: Sǝsǝŋyǝ ŋ ke ri Pelɛkǝ, duturǝ ɖi ne eniyǝ wǝ́ pǝ sǝ̀pǝ kǝtǝǝwǝ. Na paanʊ ŋ ke ri Yɔkǝtaŋ. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />Yɔkǝtaŋ ŋ mǝnǝ Alǝmodadǝ, Selɛfǝ, Asarǝmavɛtǝ, Yera, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Adoramǝ, Usalǝ, Dikǝla, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obalǝ, Abimayɛlǝ, Seba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofirǝ, Avila, Yobabǝ. Ŋpǝ ǝpǝ kpǝlo kɩɩkɩ pǝ ke ri Yɔkǝtaŋ lǝ ǝpǝrǝŋpipǝ. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Pǝla fɛɛwǝ we pǝ ke tini we, wǝ ka kpɛlɩ fǝ rǝ Mesa ko ru ǝrǝ Sefarǝ lo otutupiyǝ la gaarǝ rǝ kǝcɔkɔŋpoŋkǝ. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />Ŋpǝ ǝpǝ pǝ ke ri Semǝ lǝ ǝpǝrǝŋpipǝ rǝ pǝla wǝsiɛrikpǝ mǝ pǝlǝ wǝrǝkpǝ rǝ pǝlǝ ǝkǝŋyǝ mǝ pǝlǝ wǝkpǝŋkpǝ.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Kǝ́ Nowa lǝ ǝpǝrǝŋpipǝ la wǝsiɛrikpǝ wǝ kǝ lǝ wǝǝ, rǝ pǝlǝ wǝmǝkpǝ mǝ pǝlǝ wǝkpǝŋkpǝ. Fǝ rǝ ŋpǝ ǝpǝ wǝ́ wǝkpǝŋkpǝ wǝ sǝ̀pǝ awɛ rǝ kǝtǝǝwǝ, rǝ ŋʊŋtɛmumuŋyǝ we la kǝmaakǝ.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">Babɛlǝ la baŋsʊrʊyǝ we la atɔkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Rǝ eniyǝ we lǝ mǝrǝ we, enyipǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ pǝ kǝ ŋ fǝ dierǝ jeŋceŋ pǝ ŋ wɛɛlɩ kǝrǝkǝ kǝceŋceŋ. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Wǝ́ jirɛɛrǝ pǝ pǝlǝ pǝ yili pǝ pwɛ̀yɩ rǝ kǝcɔkɔŋpoŋkǝ la gaarǝ, wǝ́ pǝ kolu pǝ nyɩnɩ kǝtǝǝtapɩtapɩwǝ rɛ rǝ Sineya lǝ gǝŋrǝ. Wǝ́ pǝ kolu pǝ tini rǝ we. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />Wǝ́ pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Nǝ pǝ kǝ lǝ sǝ oruyǝ kǝ lo yo yǝ rǝ naawǝ mǝrǝ.» Wǝ́ pǝ sǝ̀ oruyǝ pǝ yolu, wǝ́ pǝ yeli aŋɔyǝ pǝ pa tɛ oruyǝ we. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Wǝ́ pǝ tǝ pǝ tɛnɩ ǝkǝnǝŋ: «Nǝ pǝ kǝ la tɔ tǝŋtǝǝwǝ, kǝ la tɔ baŋsʊrʊyǝ kǝ no yuteewǝ wǝ ka yɔ yulaarǝ, kǝ la nya fɛɛ lo ru nyɩŋrǝ, kǝ la paa caŋ la tɛlɩ rǝ kǝtǝǝwǝ kpǝlo kɩɩkɩ». <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />Wǝ́ Ǝtǝ Woroko ŋ sʊ̀ʊ ŋ pa yɩrɩ tǝŋtǝǝwǝ we mǝ baŋsʊrʊyǝ we anyɩmaasɩpǝ pǝ ya pǝ láa tɔ wǝ. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ yɩrɩ re, kǝkpǝŋkǝ kǝceŋceŋ le enyipǝ wǝ́ pǝ ri wǝ́ pǝ lo kpǝlo pǝ láa wɛɛlɩ kǝrǝkǝ kǝceŋceŋ. Kǝ́ pǝ le tie mǝŋkǝsa wǝǝ, we tuwǝ we pǝ ya pǝ lóo pu pǝ yee wǝ lǝŋ pe teeri pǝ re! <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Nǝ pǝ kǝ la sʊʊ lo ko kputu pǝlǝ kǝrǝkǝ sa, kǝ pǝ pǝǝ tǝ pǝ nuŋ awɛ lo duturǝ» <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />Fɛɛwǝ Ǝtǝ Woroko ŋ canǝ pǝ rǝ kǝtǝǝwǝ kpǝlo wǝǝ. Wǝ́ pǝ wɛ̀ mǝ tǝŋtǝǝwǝ we la atɔkǝ. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Fɛɛwǝ pǝ ko ŋ pwo wǝ ǝkǝnǝŋ Babɛlǝ wǝǝ. Duturǝ ɖi fɛɛwǝ Ǝtǝ Woroko ŋ kpùtu kǝtǝǝwǝ kpǝlo lǝ kǝrǝkǝ wǝǝ. Fɛɛwǝ we wǝ́ ŋ lɛ̀ ŋ canǝ anyɩmaasɩpǝ kpǝlo rǝ kǝtǝǝwǝ.<verse eid="GEN 11:9" /></para>
  <para style="s">Semǝ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Semǝ lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ: Rǝ ŋʊŋtɛmumuŋyǝ we la cɛŋyitǝwǝ we, wǝ́ Semǝ ŋ lɔ̀ cɛŋwǝ tuuru wǝ́ ŋ mǝnǝ Arǝpasadǝ. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Kǝ́ Semǝ ŋ nǝ mǝ Arǝpasadǝ la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuurutʊʊ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />Arǝpasadǝ lɔ̀ cɛŋwǝ tǝta mǝ tʊʊ wǝ́ ŋ mǝnǝ Sela. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Kǝ́ Arǝpasadǝ ŋ nǝ mǝ Sela la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuruniǝ mǝ ta. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />Sela lɔ̀ cɛŋwǝ tǝta wǝ́ ŋ mǝnǝ Ebɛrǝ. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Kǝ́ Sela ŋ nǝ mǝ Ebɛrǝ la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuruniǝ mǝ ta. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />Ebɛrǝ lɔ̀ cɛŋwǝ tǝta mǝ niǝ wǝ́ ŋ mǝnǝ Pelɛkǝ <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Kǝ́ Ebɛrǝ ŋ nǝ mǝ Pelɛkǝ la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuru mǝ tǝta. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />Pelɛkǝ lɔ̀ cɛŋwǝ tǝta wǝ́ ŋ mǝnǝ Rewu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Kǝ́ Pelɛkǝ ŋ nǝ mǝ Rewu la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuruyi mǝ faŋceŋceŋ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />Rewu lɔ̀ cɛŋwǝ tǝta mǝ yi wǝ́ ŋ mǝnǝ Serukǝ. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Kǝ́ Rewu ŋ nǝ mǝ Serukǝ la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuruyi mǝ pǝrɩmata. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />Serukǝ lɔ̀ cɛŋwǝ tǝta wǝ́ ŋ mǝnǝ Nakɔrǝ. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Kǝ́ Serukǝ ŋ nǝ mǝ Nakɔrǝ la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuruyi. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />Nakɔrǝ lɔ̀ cɛŋwǝ tiyi mǝ faŋceŋceŋ wǝ́ ŋ mǝnǝ Tera. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Kǝ́ Nakɔrǝ ŋ nǝ mǝ Tera la kǝmaakǝ we, wǝ́ ŋ tǝ ŋ tini vɔrʊrǝ cɛŋwǝ tuuru mǝ tǝ mǝ faŋceŋceŋ. Wǝ́ ŋ mǝnǝ ǝpǝrǝŋpipǝ mǝ etiepipǝ. <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />Tera lɔ̀ cɛŋwǝ tǝpǝrɩmata wǝ́ ŋ mǝnǝ Abǝramǝ mǝ Nakɔrǝ mǝ Haraŋ.<verse eid="GEN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Tera lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ: Tera ŋ mǝnǝ Abǝramǝ mǝ Nakɔrǝ mǝ Haraŋ, wǝ́ Haraŋ ŋ mǝnǝ Lɔtǝ. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Haraŋ conu nǝ tǝ Tera lǝ ǝkpǝ̀ rǝ gǝŋrǝ we pǝ mǝnǝ ŋwǝ wǝ, rǝ akalǝdeyatǝpǝ lǝ tǝŋtǝǝwǝ we pǝ lóo pwo Urǝ. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Wǝ́ Abǝramǝ mǝ Nakɔrǝ pǝ lɔ̀ etiepǝ. Abǝramǝ le tie ŋ ka kaamǝ Sarayɩ wǝ́ Nakɔrǝ le tie ŋ ka kaamǝ Haraŋ la kɔrʊ Milǝka. Haraŋ ŋ mǝnǝ Milǝka mǝ Yisǝka. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Sarayɩ lǝǝ kǝ ŋ mǝ kǝto lǝǝ kǝ lǝmǝ pi. <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />Wǝ́ Tera ŋ fǝ̀ ne pi Abǝramǝ mǝ ne pilepi Lɔtǝ yǝ we ŋ ri Haraŋ le piyǝ wǝ, mǝ ne pi Abǝramǝ le tie Sarayɩ, wǝ́ pǝ pwɛ̀yɩ rǝ Akalǝdeyatǝpǝ lǝ tǝŋtǝǝwǝ we pǝ lóo pwo Urǝ pǝ ko ŋ ko Kanaŋ. Kǝ́ pǝ le ke fii Haraŋ we, wǝ́ pǝ tɔ̀ pǝle kǝtiikǝ rǝ we. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />Tera tini vɔrʊrǝ cɛŋwǝ tuuruyi mǝ tʊʊ, wǝ́ ŋ kpǝ̀ rǝ Haraŋ.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">Worokoyǝ le tíi Abǝramǝ ŋ pwɛyɩ rǝ nǝ gǝŋrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Jirɛɛrǝ Worokoyǝ tìi Abǝramǝ ǝkǝnǝŋ: «Ŋlǝ́, pwɛyɩ rǝ lǝ́ gǝŋrǝ mǝ ló otuulupǝ lǝ kpǝŋ mǝ lǝ́ tǝ la nyarǝwǝ, kǝ o mǝ ko gǝŋrǝ we ŋ́ nah kaŋ lǝ́ wǝ<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="ACT 7:24">Anǝ 7:24</ref></char>. </char></note>.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />Ŋ́ nóo koonu kǝ lǝ́ kǝkpǝŋkǝ kǝ naanǝ ŋpa kǝ kǝ lɛ kǝ lɛnyɩ.</para>
  <para style="q1" vid="GEN 12:2">Ŋ́ náa pɛɛrɩ lǝ́,</para>
  <para style="q1" vid="GEN 12:2">kǝ ŋ́ kuŋ kǝ o ru nyɩŋrǝ.</para>
  <para style="q1" vid="GEN 12:2">A láa siɛrɩ eyee wǝpɛɛrɩkpǝ o koonu enyipʊŋpwapǝ.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Ŋ́ náa pɛɛrɩ epǝ we pǝ láa pɛɛrɩ lǝ́ wǝ,</para>
  <para style="q1" vid="GEN 12:3">paa ŋ́ náa fwɛɛrɩ epǝ we pǝ lǝŋ kǝ lǝ́ pǝ kpii rǝ tǝrɛ wǝ.</para>
  <para style="q1" vid="GEN 12:3">Ŋ́ náa pɛɛrɩ ǝkǝŋyǝ kpǝlo rǝ kǝtǝǝwǝ saŋ rǝ ló oŋuŋkǝ.<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="ACT 3:25">Anǝ 3:25</ref></char>. </char></note>»<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Wǝ́ Abǝramǝ ŋ pwɛ̀yɩ mǝŋ kǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ kǝtǝ, wǝ́ Lɔtǝ ŋwe ŋ sìimǝ ŋwǝ. Lɔ̀ cɛŋwǝ tǝpǝrɩmata mǝ tʊʊ kǝ́ ŋ ka ŋ pwɛyɩ rǝ Haraŋ wǝ. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Wǝ́ ŋ fǝ̀ ne tie Sarayɩ mǝ na paanʊ le pi Lɔtǝ mǝ pǝlo otulǝmǝyǝ kpǝlo mǝ pǝla arɔŋpǝ pǝ fùu rǝ Haraŋ, wǝ́ pǝ ko ŋ ko Kanaŋ lǝ gǝŋrǝ. Kǝ́ pǝ le ke fii we, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />wǝ́ pǝ sǝ̀ pǝ tɛ̀lɩ wǝ́ pǝ kolu pǝ rù ǝrǝ Sikɛmǝ, rǝ More le wǝciimumuŋkpǝ rɛ lǝ kpǝŋ. Anyɩŋ eniyǝ we Akanaŋtǝpǝ pǝ kpii rǝ gaarǝ we.<verse eid="GEN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 12:7" />Wǝ́ Ǝtǝ Woroko ŋ pɔrʊ na wɛ ŋ kanǝ Abǝramǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ fǝ gǝŋrǝ sa ŋ koonu lǝ́ wǝmǝkpǝ.» Wǝ́ Abǝramǝ ŋ tɔ̀ otoolucuukǝ ŋ kòonu Ǝtǝ Woroko rǝ fɛɛwǝ we ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ wǝ. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />Wǝ́ Abǝramǝ ŋ pwɛ̀yɩ rǝ we ŋ ko ŋ ko otutupiyǝ la gaarǝ, rǝ Bɛtɛlǝ la kǝcɔkɔŋpoŋkǝ la kǝtakǝ, wǝ́ ŋ kolu ŋ tɔ̀ ne bwiirǝ rǝ Bɛtɛlǝ mǝ Ayɩ le kǝtiitiikǝ: anyɩŋ Bɛtɛlǝ yaa rǝ kǝcɔkɔŋtɔɔkǝ la gaarǝ wǝ́ Ayɩ ŋ yaa rǝ kǝcɔkɔŋpoŋkǝ la gaarǝ. Wǝ́ ŋ tǝ ŋ tɔ̀ otoolucuukǝ ŋ kòonu Worokoyǝ wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ mǝ ŋ pwo ŋwǝ ǝkǝnǝŋ Ǝtǝ Woroko. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Tɩpɩtɩpɩ, wǝ́ Abǝramǝ ŋ kolu ŋ fìi gǝŋrǝ we la kǝpɔɔlʊsiɛɛkǝ la gaarǝ.<verse eid="GEN 12:9" /></para>
  <para style="s">Abǝramǝ le ke fii Ejipǝte</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Kǝtɛŋkǝ kǝ pǝlǝ kǝ fìi gǝŋrǝ we, wǝ́ Abǝramǝ ŋ pwɛ̀yɩ ŋ ce ŋ kolu ŋ tini rǝ Ejipǝte, duturǝ ɖi kǝtɛŋkǝ we kǝ ka naanǝ ŋpa. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Kǝ́ Abǝramǝ ŋ neh fii Ejipǝte we, wǝ́ ŋ tìi ne tie ǝkǝnǝŋ: «A lǝŋ nyɩŋ, ŋ́ cii wǝ ǝkǝnǝŋ o lóo poŋ ayɩrɩ. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Vǝ́ Ejipǝtetǝpǝ pǝ la ka nyɩŋ lǝ́ we, pǝ láa tɛŋ ǝkǝnǝŋ ŋlǝ́ e ri mǝ tie. Eniyǝ we pǝ la wʊ mǝ, kǝ ŋlǝ́ paa pǝ maa lǝ́. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Kǝto dɔɔkpɛ mǝŋ pǝ lǝ kǝ pǝ́ lǝ́ we, tíi pǝ ǝkǝnǝŋ ŋlǝ́ e ri mǝ paatɛ. Ŋlǝ́ kǝto we, pǝ láa lɔ mǝ sɩsiɛrɩ, kǝ ŋ́ lɛ ŋ́ tíi vɔrʊrǝ».<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Kǝ́ Abǝramǝ ŋ ne ke fii we, wǝ́ Ejipǝtetǝpǝ pǝ nyɩnɩ ǝkǝnǝŋ ne tie ponu ŋpa. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Wǝ́ Farawo<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Nyɩŋrǝ sa lo duturǝ gaamǝ: Ejipǝtetǝpiliyǝ.</char></note> la anǝnɛyeetǝpǝ pǝ nyɩnɩ tieyǝ sa, wǝ́ pǝ kolu pǝ ràarǝ ŋwǝ pǝ tìi Farawo. Wǝ́ pǝ fǝ̀ tieyǝ sa pǝ kolu Farawo la nyarǝwǝ. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Rǝ tieyǝ sa lo yurǝ kǝto wǝ́ Farawo ŋ lɔ̀ Abǝramǝ sɩsiɛrɩ. Wǝ́ ŋ koonu na amɛɛpǝ, epereceepǝ, anɛŋpǝ, asʊmatǝpǝ, mǝŋ etie mǝŋ ǝpǝrǝŋ, orookɛtɛpǝ mǝŋ eyiyee mǝŋ onunuŋ mǝ akpɔŋkɔpǝ.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Paape wǝ́ Ǝtǝ Woroko ŋ koonu nyarǝpirɔɔrɔɔrǝ rɛ vìi Farawo mǝ na nyarǝwǝ rǝ Abǝramǝ le tie Sarayɩ lo yurǝ. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Wǝ́ Farawo ŋ pwò Abǝramǝ wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ e le yee mǝ mǝ ǝnǝ? Kǝ́ kǝto wǝ́ e lee tíi mǝ ǝkǝnǝŋ lé tie ŋ lǝǝwe wǝ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Kǝ́ kǝto wǝ́ e le tíi mǝ ǝkǝnǝŋ lá paatɛyǝ ŋ lǝǝwe, wǝ́ ŋmǝ paa ŋ́ nǝ fǝ̀ ŋwǝ ŋ ne yee mǝ tieyǝ wǝ? Rǝkǝsa we, lé tie ŋ yaa lǝ́ ǝnǝ, fǝ ŋwǝ kǝ o mǝ ko oo!» <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Wǝ́ Farawo ŋ tìi na asʊmatǝpǝ ǝkǝnǝŋ pǝ fǝ Abǝramǝ, ne tie mǝ no otuyǝ kpǝlo kǝ pǝ ko co pǝla na kʊŋ.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Wǝ́ Abǝramǝ ŋ tǝ ŋ sìɛnɩ rǝ Ejipǝte ŋ kolu gǝŋrǝ we la kǝpɔɔlʊsiɛɛkǝ ŋpǝ mǝ ne tie mǝ no otulǝmǝyǝ kpǝlo fǝ kʊla mǝ Lɔtǝ.<verse eid="GEN 13:1" /></para>
  <para style="s">Abǝramǝ mǝ Lɔtǝ pǝ lǝ sǝpǝ awɛ</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 13:2" />Abǝramǝ nyà na wɛ ŋpa. Kǝ lǝǝmǝ akɛɛpǝ ŋpa, wǝ́ ŋ kǝ lǝǝmǝ sɩkamwɛɛrɩyǝ mǝ sɩkakpɛɛlɩyǝ ŋpa. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Tɩpɩtɩpɩ wǝ́ ŋ kolu ŋ fìi ǝrǝ Bɛtɛlǝ, rǝ fɛɛwǝ we ŋ ne tii ŋ na pa tɛlɩ wǝ, rǝ Bɛtɛlǝ mǝ Ayɩ le kǝtiitiikǝ. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Fɛɛwǝ sa wǝ́ ŋ ce ŋ tɔ̀ otoolucuukǝ wǝ. Wǝ́ Abǝramǝ ŋ tǝ ŋ mwɛnɩ nyuŋkpǝ ŋ pwò Worokoyǝ la nyɩŋrǝ ǝkǝnǝŋ Ǝtǝ Woroko. <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />Lɔtǝ ke siimǝ Abǝramǝ, ŋwǝ ŋkpɛ kǝ lǝǝmǝ amɛɛpǝ mǝ epereceepǝ mǝ anɛŋpǝ fǝ kʊla mǝ epwiiyǝ.<verse eid="GEN 13:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="GEN 13:6-7" />Kǝ́ pǝlo otulǝmǝyǝ yǝ ka naanǝ kǝto we, gǝŋrǝ we lǝǝ tǝ go ŋ ro pǝ tii pǝ marǝ mǝ awɛ. Anyɩŋ Akanaŋtǝpǝ mǝ Eperisitǝpǝ ŋpǝ ŋkpɛ pǝ ke kpii rǝ gǝŋrǝ we. Wǝ́ akpaŋyǝ yǝ pǝlǝ Abǝramǝ mǝ Lɔtǝ la akɛɛrǝŋtǝpǝ lǝ mǝrǝ. <verse eid="GEN 13:6-7" /><verse number="8" style="v" sid="GEN 13:8" />Wǝ́ Abǝramǝ ŋ tìi Lɔtǝ ǝkǝnǝŋ: «Nyarǝwǝ ceŋceŋ le enyipǝ wǝ́ le ri kǝto we, rɛ ŋ paa maa wǝkpaŋkpǝ wǝ pǝ lǝh mǝrǝ amaa lah akɛɛrǝŋtǝpǝ lǝ mǝrǝ oo. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Pǝ kǝ lǝ sǝpǝ awɛ. A lǝŋ nyɩŋ kǝ́ gǝŋrǝ sa gbɛlɩ lóo ko wǝ. Mǝŋ ǝ lǝ fǝ kǝŋuŋsiɛɛkǝ we, ŋ́ nǝ́ǝ fǝ kǝpɔɔlʊsiɛɛkǝ. Mǝŋ ǝ lǝ fǝ kǝpɔɔlʊsiɛɛkǝ we, ŋ́ nǝ́ǝ fǝ kǝŋuŋsiɛɛkǝ.» <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />Wǝ́ Lɔtǝ ŋ yìili anyɩŋkǝ ŋ yɩ̀rɩ Yɔrǝdaŋ la gaarǝ we kpǝlo kɩɩkɩ, mɛŋwǝ wǝ kpii sɩsiɛrɩ ko ru ǝrǝ Sowarǝ. Eniyǝ we Worokoyǝ ŋ fǝǝ kǝ nǝǝnǝ Sodomǝ mǝ Gomora we, gaarǝ we gǝ lǝ rǝ mǝŋ Ǝtǝ Woroko la anyarǝtɛɛkǝ we pǝ lóo pwo Edɛnǝ amaa Ejipǝte kǝtǝ. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Wǝ́ Lɔtǝ ŋ pɔ̀rʊ Yɔrǝdaŋ la gaarǝ wǝ́ ŋ kolu ŋ tini rǝ kǝcɔkɔŋpoŋkǝ la kǝtakǝ. Wǝ́ pǝ sǝpǝ awɛ. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Wǝ́ Abǝramǝ ŋ tini rǝ Kanaŋ. Lɔtǝ ŋwǝ paa ke kpii rǝ ǝtǝŋtǝǝyǝ we rǝ Yɔrǝdaŋ la gaarǝ. Wǝ́ ŋ pǝlǝ ŋ kolu ŋ tɔ̀ ne bwiirǝ ǝrǝ Sodomǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Osodomǝtǝpǝ sa la vɔrʊrǝ gǝ pǝlǝ ŋpa, wǝ́ pǝ ke ŋ yee oturɔɔrɔɔyǝ rǝ Ǝtǝ Woroko le enimiyǝ.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Kǝ́ Lɔtǝ ŋ na pwɛyɩ rǝ Abǝramǝ lǝ kpǝŋ la kǝmaakǝ we, wǝ́ Ǝtǝ Woroko ŋ tìi Abǝramǝ ǝkǝnǝŋ: «Yiili anyɩŋkǝ rǝ fɛɛwǝ we a yaa wǝ, kǝ a yɩrɩ kǝŋuŋsiɛɛkǝ mǝ kǝpɔɔlʊsiɛɛkǝ, kǝcɔkɔŋpoŋkǝ mǝ kǝcɔkɔŋtɔɔkǝ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Ŋ́ nǝ́ǝ fǝ gǝŋrǝ sa kpǝlo a ya láa nyɩŋ ŋ́ koonu ŋnǝ mǝ lǝ́ wǝmǝkpǝ kǝkpakǝkpa. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Ŋ́ nóo koonu kǝ lǝ́ wǝmǝkpǝ wǝ naanǝ ŋpa kǝ oturu rɛ lǝŋ koru kpǝ lǝ ǝkǝ, mǝŋ kǝ́ pǝ lǝŋ koru naŋrǝ lǝ ǝkǝ kǝtǝ wǝ. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Yi, kǝ e siri a yɩrɩ kǝtǝǝwǝ sa lo wǝkoŋkpǝ mǝ wǝla wǝyɔkɔɔkpǝ, duturǝ ɖi ŋlǝ́ wǝ́ ŋ́ nǝh fǝ wǝ ŋ́ koonu.» <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />Wǝ́ Abǝramǝ ŋ nùru ne bwiirǝ, wǝ́ ŋ kolu ŋ tini rǝ nyiyǝ we pǝ lóo pwo Mamǝre le eciimumuŋyǝ we lǝ kpǝŋ rǝ Hebǝrɔŋ la kǝlɛɛrɩkǝ. Wǝ́ ŋ tɔ̀ otoolucuukǝ rǝ we ŋ koonu Ǝtǝ Woroko.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">Abǝramǝ le ri epilipǝ lo yurǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Rǝ eniyǝ we lǝ mǝrǝ we, epilipǝ pǝ ke ŋ yee akɔŋkǝ mǝ awɛ. Sineyatǝpiliyǝ we pǝ lóo pwo Amǝrafɛlǝ mǝ Elasarǝtǝpiliyǝ we pǝ lóo pwo Ariyoke mǝ Elamǝtǝpiliyǝ we pǝ lóo pwo Kedɔlamɛrǝ mǝ Goyimǝtǝpiliyǝ we pǝ lóo pwo Tidalǝ pǝ cà pǝ kù. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />Wǝ́ pǝ ke ŋ yee akɔŋkǝ mǝ Sodomǝtǝpiliyǝ we pǝ lóo pwo Bera, Gomoratǝpiliyǝ we pǝ lóo pwo Biresa, Adǝmatǝpiliyǝ we pǝ lóo pwo Sineyabǝ, Seboyimǝtǝpiliyǝ we pǝ lóo pwo Semebɛrǝ fǝ kʊla mǝ Belatǝpiliyǝ. Bela wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Sowarǝ. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Epilipǝ sa pǝla atʊʊ pǝ kolu pǝ kù rǝ Sidimǝ la gbɛnɛŋrǝ. Atǝraŋpǝ la apʊyǝ yǝ la lɔ ŋrǝ gbɛnɛŋrǝ sa ruŋruŋ le jirǝ. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Pǝ kǝ sǝnǝ pǝ tini rǝ Kedɔlamɛrǝ lǝ kǝnǝŋkǝ wǝ́ pǝ ka ŋ sʊma ŋwǝ cɛŋwǝ tǝ mǝ yi milimili, paape cɛŋtǝmǝtatǝwǝ we, wǝ́ pǝ yìli pǝ tɛ̀ɛ rǝ ŋwǝ. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />Cɛŋtǝmǝniǝtǝwǝ, wǝ́ Kedɔlamɛrǝ mǝ nǝ ǝtǝŋpilipǝ pǝ yili pǝ kǝ ŋ pǝ pǝ pe yee akɔŋkǝ mǝ pǝ. Kǝ́ Kedɔlamɛrǝ mǝ nǝ ǝtǝŋpilipǝ we pǝ lo ru pǝ lǝh pǝ we, wǝ́ pǝ yeli akɔŋkǝ mǝ Erefayitǝpǝ rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Asǝtarotǝ Kanayimǝ. Wǝ́ pǝ yeli akɔŋkǝ mǝ Osuzitǝpǝ rǝ Hamǝ. Wǝ́ pǝ yeli akɔŋkǝ mǝ Emititǝpǝ rǝ Kiriatamǝ lǝ kǝtǝǝtapɩtapɩwǝ. Wǝ́ pǝ rili pǝlo kpǝlo lo yurǝ. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />Wǝ́ pǝ rili Orititǝpǝ lo yurǝ rǝ pǝlo otutupiyǝ la gaarǝ rǝ Seyirǝ ko ru ǝrǝ Ɛlǝ Paraŋ rǝ nyɔŋkpaakǝtǝǝwǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Wǝ́ pǝ sìɛnɩ pǝ kǝ ŋ pǝ Ɛnǝ Misepatǝ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Kadɛsǝ wǝ, wǝ́ pǝ cùlu Amalɛkǝtǝpǝ kpǝlo rǝ pǝlǝ ǝtǝŋtǝǝyǝ mǝŋ Amoritǝpǝ we pǝ ke kpii rǝ Asasɔŋ Tamarǝ wǝ. <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />Rǝkǝsa wǝ́ Sodomǝtǝpiliyǝ mǝ Gomoratǝpiliyǝ mǝ Adǝmatǝpiliyǝ mǝ Seboyimǝtǝpiliyǝ mǝ Bela pǝ lǝ́ǝ tǝ pǝ ŋ pwo Sowarǝ le piliyǝ pǝ yili pǝ kolu pǝ yàa rǝ Sidimǝ la gbɛnɛŋrǝ we kǝ pǝ yee akɔŋkǝ <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />mǝ Elamǝtǝpiliyǝ we pǝ lóo pwo Kedɔlamɛrǝ mǝ Goyimǝtǝpiliyǝ Tidalǝ mǝ Sineyatǝpiliyǝ Amǝrafɛlǝ mǝ Elasarǝtǝpiliyǝ Ariyoke. Epilipǝ eniǝ pǝ leh yee akɔŋkǝ mǝ epilipǝ atʊʊ. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Anyɩŋ ofuŋyǝ cɩkɩcɩkɩ rǝ Sidimǝ la gbɛnɛŋrǝ we. Ofuŋyǝ we yǝ ke kpii mǝ aŋɔyǝ. Kǝ́ pǝ ya pǝ lóo suu we, wǝ́ Sodomǝtǝpiliyǝ mǝ Gomoratǝpiliyǝ we pǝ kolu pǝ tɔ̀ɔ ofuŋyǝ we, wǝ́ otuturupǝ pǝ suu pǝ kolu pǝ ŋwàa rǝ dutupirǝ. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Wǝ́ epǝ we pǝ rili yurǝ pǝ wʊ̀ʊ Osodomǝtǝpǝ mǝ Ogomoratǝpǝ lo otulǝmǝyǝ mǝ pǝle ekeeriyǝ wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Anyɩŋ eniyǝ we Abǝramǝ la paanʊ le pi Lɔtǝ ke kpii rǝ Sodomǝ. Wǝ́ pǝ lɔ̀ ŋwǝ ŋkpɛ, wǝ́ pǝ rè ŋwǝ pǝ pwɛ̀yɩ mǝŋ no otulǝmǝyǝ.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Wǝ́ nyirɛɛyǝ pǝ loo ro pǝ lɔ we, ŋ pǝlǝ ŋ pɔ̀ Abǝramǝ la amayǝ. Ŋwǝ Abǝramǝ ŋ ke ri Hebǝritǝnyiyǝ we ŋ ke kpii rǝ Amoritǝnyiyǝ we pǝ lóo pwo Mamǝre le eciimumuŋyǝ we lǝ kǝnǝŋkǝ wǝ. Mamǝre mǝ Ɛsǝkɔlǝ mǝ Anɛrǝ pǝ ke ri otuulupǝ. Ŋpǝ enyipǝ sa mǝ Abǝramǝ pǝ kǝ lǝ nyuŋceŋceŋ. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Kǝ́ Abǝramǝ ŋ no nuŋ ǝkǝnǝŋ pǝ la lɔ na paanʊ le piyǝ we, wǝ́ ŋ kpàka na anyarǝtǝpǝ tuuruta mǝ tǝ mǝ anɛŋ, epǝ we pǝ láa sʊma ŋwǝ wǝ. Wǝ́ ŋ yili ŋ sìimǝ pǝla akʊŋyǝ ŋ ko ŋ ko ŋ kolu ŋ rù ǝrǝ Daŋ. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Wǝ́ Abǝramǝ ŋ sǝ̀pǝ ne enyipǝ we, wǝ́ pǝ yeli akɔŋkǝ mǝ pǝ mǝŋ dumu mǝŋ dumu. Wǝ́ pǝ wʊ̀ʊlʊ pǝ, wǝ́ pǝ lɛ pǝ pìri pǝ pǝ kolu pǝ ru ǝrǝ Hova rǝ Damasǝko lo kǝŋuŋsiɛɛkǝ. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Wǝ́ ŋ lɔ̀ otulǝmǝyǝ we kpǝlo ŋ rè ŋ pǝlǝ. Wǝ́ ŋ lɛ̀ ŋ rè na paanʊ le pi Lɔtǝ mǝ no otulǝmǝyǝ mǝŋ etiepǝ fǝ kʊla mǝ enyipʊŋpwapǝ ŋ pǝlǝ.<verse eid="GEN 14:16" /></para>
  <para style="s">Mɛlǝkisedɛkǝ la pɛɛrɩ Abǝrahamǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Kǝ́ Abǝramǝ ŋ ne ke ri Kedɔlamɛrǝ mǝ nǝ ǝtǝŋpilipǝ we lo yurǝ ŋ nǝ́ǝ pǝ we, wǝ́ Sodomǝtǝpiliyǝ ŋ pǝlǝ ŋ kù mǝ ŋwǝ rǝ Save la gbɛnɛŋrǝ, wǝlo duturǝ ɖi piliyǝ la gbɛnɛŋrǝ. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />Wǝ́ Worokoyǝ ŋ tɛ rǝ oŋuŋkǝ lo toolutǝyǝ we ŋ ri Salɛmǝ le piliyǝ pǝ lóo pwo Mɛlǝkisedɛkǝ<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="HEB 5:6">Ehe 5:6</ref></char>. </char></note> ŋ fǝ̀ kpɔnɔyǝ mǝ vɛŋyǝ ŋ pǝlǝ. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Wǝ́ ŋ pɛ̀ɛrɩ Abǝramǝ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 14:19">«Worokoyǝ we ŋ tɛ rǝ oŋuŋkǝ,</para>
  <para style="q1" vid="GEN 14:19">yǝ we ŋ ne yee yulaarǝ mǝ kǝtǝǝwǝ ŋ pɛɛrɩ Abǝramǝ!<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Worokoyǝ sa ŋ tɛ rǝ oŋuŋkǝ le yeekǝ</para>
  <para style="q1" vid="GEN 14:20">mǝ kǝ́ ŋ nǝ fǝ lǝ́ ǝkǝǝkpǝlǝtǝpǝ ŋ ne kpii lǝ́ rǝ akaakǝ wǝ!» Wǝ́ Abǝramǝ ŋ fǝ̀ no otulǝmǝyǝ kpǝlo kɩɩkɩ lǝ tǝtǝwǝ ŋ koonu ŋwǝ.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Wǝ́ Sodomǝtǝpiliyǝ ŋ tìi Abǝramǝ ǝkǝnǝŋ: «Fǝ enyipǝ sa o koonu mǝ kǝ ŋlǝ́ paa ǝ fǝ otulǝmǝyǝ we.» <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />Wǝ́ Abǝramǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no tu Ǝtǝ Woroko, Worokoyǝ we ŋ tɛ rǝ oŋuŋkǝ wǝ́ ŋ ne yee yulaarǝ mǝ kǝtǝǝwǝ wǝ, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ŋ́ nǝŋ fǝ lá tǝrɛ mǝŋ ceŋceŋ, wǝ ke ce wǝ ri nyʊŋwɛɛnimirǝ amaa kǝfʊkpakǝ la ŋwɛɛwǝ we, ŋ́ nǝŋ fǝ̀. Eniyǝ we o lǝŋ po koru atɛŋ ǝkǝnǝŋ: “Ŋmǝ kǝto wǝ́ Abǝramǝ ŋ na nya na wɛ wǝ”. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Ŋ́ nǝŋ lɔ tǝrɛ, we keeriwǝ we mǝ enyipǝ pǝ le ri ko. Paa epǝ we pǝ la ca mǝ pǝ lo ko we, ŋpǝŋpǝ pǝ láa lɔ pǝla kǝtakǝ. Ŋpǝ pǝ kaamǝ Anɛrǝ, Ɛsǝkɔlǝ mǝ Mamǝre.»<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">Worokoyǝ mǝ Abǝramǝ pǝ la parǝ dierǝ pǝ lǝ tǝnǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Rǝ otuyǝ sa la kǝmaakǝ we, wǝ́ Ǝtǝ Woroko ŋ pɔ̀rʊ na wɛ ŋ kanǝ Abǝramǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo suu vurǝ Abǝramǝ! Ŋmǝ ŋ́ ri lǝ́ kǝrǝŋtǝyǝ wǝ́ ŋ́ náa lɛ ŋ́ mwara lǝ́ wǝtoomumuŋkpǝ rɛ.» <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />Wǝ́ Abǝramǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝtǝ Woroko, a lah mwara mǝ wǝtookpǝ ŋ́ fǝ ŋ́ yee kǝ? Ŋ́ nǝh pǝ ŋ́ pǝ kpǝ́ paa ŋ́ nǝǝ lǝmǝ piyǝ. Eliazɛrǝ ŋ no ru rǝ Damasǝko ŋ nǝh pǝ ŋ pe ri mǝ otuyǝ rǝ mǝ nyarǝwǝ.» <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Wǝ́ Abǝramǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Kpiikǝ o loo koonu mǝ piyǝ we kǝto we, mǝ sʊmatǝyǝ ŋ neh pe ri mǝ otuyǝ wǝ.» <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, ŋkǝ ŋwǝ ŋ neh pe ri ló otuyǝ, ŋlǝ́ŋlǝ lé pimǝyǝ ŋ neh pe ri ló otuyǝ wǝ.» <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Wǝ́ Ǝtǝ Woroko ŋ rù mǝ Abǝramǝ rǝ koruwǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yiili a yɩrɩ yulaarǝ, kǝ ǝ kǝ wǝŋɔŋkpǝ a yɩrɩ mǝŋ o lóo koru wǝ.» Wǝ́ Ǝtǝ Woroko ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ lǝ́ wǝmǝkpǝ wǝ lah pa yaarǝ wǝǝ.» <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />Wǝ́ Abǝramǝ ŋ tɛ̀ɛ kpɛɛwǝ rǝ Ǝtǝ Woroko. Wǝ́ Ǝtǝ Woroko ŋ fǝ̀ ŋwǝ mǝŋ nyikʊʊyǝ kǝtǝ.<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="ROM 4:3">Oro 4:3</ref>, <ref loc="GAL 3:6">Aga 3:6</ref>, <ref loc="JAS 2:23">Yak 2:23</ref></char>. </char></note><verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Wǝ́ ŋ tìi Abǝramǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Ǝtǝ Worokoyǝ we ŋ na pɔrʊ lǝ́ ŋ no ru rǝ Urǝ rǝ Akalǝdeyatǝpǝ lǝ gǝŋrǝ, kǝ ŋ́ fǝ gǝŋrǝ sa ŋ́ koonu lǝ́ kǝ ziɛrɩ yee lá nɛŋ.» <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />Wǝ́ Abǝramǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko, nɛ wǝ́ ŋ́ née yee kǝ ŋ́ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ gǝŋrǝ sa láa siɛrɩ yee mǝ nɛŋ wǝ?» <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: «Taa cɛŋ ta la nɛŋgɔrʊrǝ mǝ cɛŋ ta le pereceeyeeyǝ mǝ cɛŋ ta la mɛɛkpaturǝ mǝ lootoyǝ mǝ tookpaayǝ o koonu mǝ.» <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />Wǝ́ Abǝramǝ ŋ tàa akɛɛpǝ sa kpǝlo ŋ kòonu ŋwǝ. Wǝ́ Abǝramǝ ŋ sìe pǝ wǝ́ ŋ nyàa pǝ cɛɛcɛ. We tookpaayǝ we mǝ lootoyǝ we ko wǝ́ ŋ naa nyaa wǝ. Wǝ́ ŋ fǝ̀ kɛɛ ri ŋ kɛɛ la wǝnyalǝkpǝ ŋ tǝnǝ kǝta mǝ kǝta ŋ kolu. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Wǝ́ otoŋtoŋkɛɛpǝ pǝ pǝlǝ pǝ tɛ̀ɛ rǝ gakǝ we, paape wǝ́ Abǝramǝ ŋ pìri pǝ. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />Kǝ́ cɔkɔŋyǝ ŋ na ka tɔɔ we, wǝ́ eniŋriemumuŋyǝ rɛ yǝ fǝ̀ Abǝramǝ. Wǝ́ nuŋtumumumuŋwǝ rɛ wǝ pǝlǝ wǝ sìi ŋwǝ kurukuru, wǝ́ vumumuŋrǝ rɛ vìi ŋwǝ ŋpa. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ci wǝ ǝkǝnǝŋ lǝ́ wǝmǝkpǝ wǝ leh pe tii rǝ gǝŋrǝ rɛ lee ri pǝla nɛŋ wǝ, kǝ pǝ yee arɔŋpǝ, kǝ pǝ lɛ pǝ si pǝ pǝ maarǝ cɛŋwǝ tuuruniǝ milimili. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Paape vǝ́ ŋ́ na ta gǝŋrǝ we pǝ la sʊma lo kǝtukoŋkǝ ŋ́ na lɛ we, eniyǝ we pǝ la wʊʊ otulǝmǝyǝ ŋpa pǝ la pwɛyɩ. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Ŋlǝ́ paa we, o lóo kuru wǝtakpǝ kǝ ǝkpǝ́ rǝ wǝtaarǝkpǝ lǝ mǝrǝ kǝ pǝ ŋwaa lǝ́. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Lǝ́ wǝmǝniǝtǝkpǝ le eniyǝ wǝ́ lé epilepipǝ pǝ lah pa siɛnɩ pǝ pǝ fɛɛwǝ sa wǝ, duturǝ ɖi Amoritǝpǝ lo oturɔɔrɔɔyǝ yǝ lǝŋ maa yǝ sǝ fɛɛwǝ kǝ ŋ́ piri pǝ rǝ kǝtǝǝwǝ we».<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Kǝ́ cɔkɔŋyǝ ŋ na ka tɔɔ we, wǝ́ ǝrǝkǝ kǝ cɩ̀ɩ kurukuru. Wǝ́ katɩmumuŋyǝ rɛ mǝ naawǝ pǝlapǝla mǝŋ nuŋrǝ ŋ pǝlǝ ŋ fìi ŋ tɛ̀lɩ rǝ akɛɛpǝ we la wǝnyalǝkpǝ le kǝtiitiikǝ ŋ kolu. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Jirǝ we wǝ́ Ǝtǝ Woroko ŋ pàrǝ dierǝ mǝ Abǝramǝ ŋ tǝnǝ. Wǝ́ ŋ tìi Abǝramǝ ǝkǝnǝŋ: «Ŋ́ nǝ fǝ kǝtǝǝwǝ sa ŋ́ no koonu lǝ́ wǝmǝkpǝ, fǝ rǝ Ejipǝte la kpanǝwǝ we fǝ ko kpanǝmumuŋwǝ we pǝ lóo pwo Efǝrata wǝ. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Ekenitǝpǝ mǝ Ekenisitǝpǝ mǝ Akamonitǝpǝ, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />Ehititǝpǝ mǝ Eperisitǝpǝ mǝ Erefayitǝpǝ mǝ <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />Amoritǝpǝ mǝ Akanaŋtǝpǝ mǝ Egigazitǝpǝ mǝ Eyebusitǝpǝ lǝ kǝtǝǝwǝ wǝ lǝǝwe».<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">Abǝramǝ mǝ Agarǝ pǝ lǝ mǝ Isǝmayɛlǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Sarayɩ lǝǝ mǝ piyǝ ŋ koonu no nuŋ Abǝramǝ. Paa kǝ lǝǝmǝ sʊmatǝkɔrʊyǝ rɛ pǝ ko ŋ pwo Agarǝ. Ejipǝtetǝpǝ wǝ́ ŋ ke ri. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Wǝ́ Sarayɩ ŋ tìi no nuŋ ǝkǝnǝŋ: «A la nyɩŋ, kǝ́ Ǝtǝ Woroko ŋ naa ya ŋ nóo koonu mǝ piyǝ ŋ́ mǝ kǝto we, ka kpɛɛ mǝ mǝ sʊmatǝkɔrʊyǝ sa, ayɩrɛ ŋ́ náa nya piyǝ saŋ rǝ ŋwǝ.» Wǝ́ Abǝramǝ ŋ tɛ̀ɛnɩ Sarayɩ le dierǝ we. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Abǝramǝ tini rǝ Kanaŋ wǝ lɔ̀ cɛŋwǝ tǝ kpɛŋ wǝ́ Sarayɩ ŋ ci ǝfǝ̀ na sʊmatǝyǝ Agarǝ ŋ koonu no nuŋ Abǝramǝ. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Wǝ́ Abǝramǝ ŋ kpɛlɩ mǝ Agarǝ, wǝ́ ŋ rè. Kǝ́ ŋ na nyɩŋ wǝ ŋ ne ci ǝkǝnǝŋ ŋ ne re we, wǝ́ ŋ nǝǝ tǝ ŋ ko ŋ pu no kuleleeyǝ. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Wǝ́ Sarayɩ ŋ tìi Abǝramǝ ǝkǝnǝŋ: «Wǝ kpii kǝ e yee tǝrɛ rǝ afǝfɛɛpiyǝ sa ŋ́ ya ŋ náa lɔ wǝ. Ŋmǝŋmǝ ŋ́ nǝ fǝ mǝ sʊmatǝyǝ ŋ́ no koonu lǝ́. Wǝ́ kǝ́ ŋ na nya ŋ na nyɩŋ ǝkǝnǝŋ ŋ ne re we, wǝ́ ŋ nǝǝ tǝ ŋ ya ŋ nóo pu mǝ. Ǝtǝ Woroko ya láa nyɩŋ oo.» <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />Wǝ́ Abǝramǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá sʊmatǝyǝ wǝ́ ŋ ri, wǝ́ a lɛ ǝ lǝǝmǝ okopiyǝ rǝ ŋwǝ. Yee mǝ no tuwǝ we wǝ ponu mǝ lǝ́ wǝ.» Wǝ́ Sarayɩ ŋ ke ŋ pieeli Agarǝ, wǝ́ Agarǝ ŋ pǝlǝ ŋ sùu.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Wǝ́ Worokoyǝ le picoŋpiyǝ ŋ kolu ŋ nyɩnɩ ŋwǝ rǝ nyɔŋkpaakǝtǝǝwǝ rǝ mɛŋfuŋpirǝ rɛ la kǝlɛɛrɩkǝ rǝ Surǝ la dɔŋrǝ. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Wǝ́ picoŋpiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Agarǝ, Sarayɩ la sʊmatǝyǝ, o lo ru rǝ fǝŋ wǝ́ o loh ko rǝ fǝŋ?» Wǝ́ Agarǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no suu rǝ mǝ kuleleeyǝ Sarayɩ lǝ kpǝŋ». <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />Wǝ́ Ǝtǝ Woroko le picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siɛnɩ o mǝ ko ló kuleleeyǝ lǝ kpǝŋ kǝ a ka ya a mǝ pɛɛlɩ lá wɛ o mǝ koonu ŋwǝ. <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Ǝtǝ Woroko lóo koonu kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ ŋpa kǝ oturu rɛ lǝŋ koru kpǝ lǝ ǝkǝ.<verse eid="GEN 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 16:11" />Ǝ lǝh mǝ bǝrǝŋpirǝ,</para>
  <para style="q1" vid="GEN 16:11">kǝ o mǝ pwo ŋwǝ Isǝmayɛlǝ<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">Isǝmayɛlǝ lo duturǝ ɖi Worokoyǝ lo nuŋ.</char></note></para>
  <para style="q1" vid="GEN 16:11">duturǝ ɖi Ǝtǝ Woroko lo nuŋ ló owoolukǝ.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Na vɔrʊrǝ lǝ́ǝ lǝ mǝŋ pɔɔkpaakɛɛyǝ la vɔrʊrǝ kǝtǝ,</para>
  <para style="q1" vid="GEN 16:12">kǝ ŋ yee akɔŋkǝ mǝ nyi ri ŋ nyi,</para>
  <para style="q1" vid="GEN 16:12">kǝ nyi ri ŋ nyi ŋ yee akɔŋkǝ mǝ ŋwǝ.</para>
  <para style="q1" vid="GEN 16:12">Láa pɔrʊ na wɛ rǝ no otuulupǝ lǝ mǝrǝ ŋ ke tii ŋwǝ ceŋceŋ.»<verse eid="GEN 16:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="GEN 16:13" />Wǝ́ Agarǝ ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ: «O lo nuŋ kǝceecee yǝ we ŋ ya ŋ náa nyɩŋ mǝ wǝ́ ŋ́ na nyɩŋ wǝ?» Wǝ́ ŋ pwò Ǝtǝ Worokoyǝ we ŋ wɛ̀ɛlɩ mǝ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ e ri Ɛlǝ Royi, Worokoyǝ we ŋ ya ŋ náa nyɩŋ mǝ wǝ.» <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Tuwǝ kǝto pǝ lóo pwo mɛŋfuŋwǝ we wǝ kpii rǝ Kadɛsǝ mǝ Berɛdǝ le kǝtiitiikǝ ǝkǝnǝŋ Lahayi Royi la mɛŋfuŋwǝ wǝlo duturǝ ɖi yǝ we ŋ kpii vɔrʊrǝ wǝ́ ŋ ya náa nyɩŋ mǝ la mɛŋfuŋwǝ. <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />Wǝ́ Agarǝ ŋ mǝnǝ bǝrǝŋpirǝ ŋ kòonu Abǝramǝ. Wǝ́ Abǝramǝ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Isǝmayɛlǝ. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Abǝramǝ kǝ lǝǝmǝ cɛŋwǝ tǝnɛŋ mǝ kʊʊraŋ wǝ́ Agarǝ ŋ mǝnǝ piyǝ we ŋ koonu ŋwǝ.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Worokoyǝ lǝ fǝ ǝkǝǝlǝkǝ la tɛ dierǝ we ŋ na parǝ ŋ nǝ tǝnǝ lo ɖurǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Kǝ́ Abǝramǝ ŋ na lɔ cɛŋwǝ tǝfaŋceŋceŋ mǝ faŋceŋceŋ we, wǝ́ Ǝtǝ Woroko ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Woroko Kopilǝtǝyǝ. Tii vɔrʊrǝ sɩsiɛrɩ rǝ mǝ enimiyǝ, paa fʊmʊ <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />kǝ ŋ́ nya fɛɛ ŋ́ parǝ dierǝ ŋ tǝnǝ rǝ ŋlǝ mǝ lǝ́ le kǝtiitiikǝ, kǝ ŋ́ koonu kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ ŋpa.» <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />Wǝ́ Abǝramǝ ŋ sʊ̀ʊ ŋ kʊnʊ wǝ́ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ, wǝ́ Worokoyǝ ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />«Dierǝ we ŋ́ nah parǝ rǝ ŋlǝ mǝ lǝ́ le kǝtiitiikǝ gaamǝ ɖǝ ǝnǝ: E leh pe ri ǝkǝŋyǝ wa lǝ tǝtǝtǝtǝyǝ. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Pǝ lǝŋ tǝ pǝ ŋ pwo lǝ́ Abǝramǝ, paa pǝ loh mǝ pwo lǝ́ Abǝrahamǝ, duturǝ ɖi ŋ́ náa siɛrɩ lǝ́ ŋ́ yee ǝkǝŋyǝ wa lǝ tǝtǝtǝtǝyǝ. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Ŋ́ nóo koonu kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ ŋpa kǝ pǝ sǝ ǝkǝŋyǝ, kǝ pǝ lɛ pǝ mǝ epilipǝ. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Ŋ́ náa parǝ dierǝ mǝ lǝ́, mǝ lé epipǝ, mǝ lǝ́ wǝmǝkpǝ kpǝlo. Dierǝ sa ŋ nah parǝ ŋ́ tǝnǝ we, láa kpɛɛ kǝkpakǝkpa, kǝ goonu kǝ ŋnǝ mǝ lǝ́ wǝmǝkpǝ nǝ fǝ mǝ nǝ yee nǝ Worokoyǝ. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Kanaŋ lǝ kǝtǝǝwǝ sa e tini we, wǝ lee ri lá nɛŋ, paape ŋ́ nǝ́ǝ fǝ wǝlo kpǝlo ŋ́ koonu ŋnǝ mǝ lǝ́ wǝmǝkpǝ, kǝ wǝ siɛrɩ wǝ yee pǝla nɛŋ kǝkpakǝkpa, kǝ ŋ́ lɛ ŋ́ ri pǝlo Worokoyǝ».<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: «Ŋlǝ́ paa we, wǝ kaamǝ kǝ ŋnǝ mǝ lé epipǝ mǝ lǝ́ wǝmǝkpǝ kpǝlo nǝ mǝ yee nǝ mǝ saŋ rǝ mǝ dierǝ sa ŋ́ na parǝ ŋ́ nǝ tǝnǝ wǝ. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Seyǝ we ŋ́ ne kpii ŋ́ no koonu ŋnǝ mǝ lǝ́ wǝmǝkpǝ ŋ kaamǝ yǝ ǝnǝ, wǝ kaamǝ kǝ nǝ mǝ yee nǝ mǝ saŋ rǝ ŋwǝ: Yǝ we ŋ nya ŋ ri bǝrǝŋpirǝ rǝ nǝ mǝrǝ we, pǝ lǝ́ǝ kǝǝlǝ ŋwǝ. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Nǝ ǝkǝǝlǝkǝ sa kǝ leh ri dierǝ sa ŋ́ na parǝ ŋ́ nǝ tǝnǝ rǝ ŋlǝ mǝ nǝ lǝ mǝrǝ la barǝ. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Fǝ rǝkǝsa mǝ ko we, vǝ́ pǝ lǝ mǝ bǝrǝŋpi ri ŋ bǝrǝŋpi lo juunɛŋtǝrǝ pǝ lǝ́ǝ kǝǝlǝ ŋwǝ. Pǝ lǝh mǝ kǝǝlǝ arɔŋpǝ we pǝ lǝ mǝ rǝ lá nyarǝwǝ wǝ, mǝŋ epǝ we o lo fuu rǝ ǝsǝǝpǝ lǝ kpǝŋ, paa pǝ lee ri ló otuulupǝ wǝ. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Wǝ kaamǝ kǝ pǝ kǝǝlǝ rɔŋyǝ we pǝ lǝ mǝ rǝ lá nyarǝwǝ amaa yǝ we o lo fuu wǝ, kǝ wǝ fǝ wǝ ŋʊrʊ mǝ dierǝ sa ŋ́ na parǝ ŋ́ nǝ tǝnǝ rǝ nǝ kǝwɛlɛŋfwɛɛkǝ kǝkpakǝkpa. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Yǝ we ŋ nǝǝ kǝǝlǝ we, wǝ kaamǝ kǝ pǝ pɔrʊ ŋwǝ pǝ cɛ rǝ kǝkpǝŋkǝ lǝ mǝrǝ duturǝ ɖi lo wuru mǝ dieparǝtǝnǝrǝ sa».<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Wǝ́ Worokoyǝ ŋ tǝ ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: «Lé tie Sarayɩ we, ǝ lǝŋ tǝ o mǝ pwo ŋwǝ Sarayɩ. Fǝ rǝ ruŋruŋ mǝ ko o lóo mǝ pwo ŋwǝ Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Ŋ́ náa pɛɛrɩ ŋwǝ, kǝ ŋ́ yee kǝ ŋ mǝ bǝrǝŋpirǝ ŋ koonu lǝ́. Ŋ́ náa pɛɛrɩ ŋwǝ kǝ ŋ siɛrɩ ŋ yee ǝkǝŋyǝ la paapapaapayǝ, kǝ ne epilepirɛɛpǝ pǝ yee epilipǝ.» <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />Wǝ́ Abǝrahamǝ ŋ sʊ̀ʊ ŋ kʊnʊ, wǝ́ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ, wǝ́ ŋ mɔnʊ, wǝ́ ŋ tɛnɩ rǝ na wɛ lǝ mǝrǝ ǝkǝnǝŋ: «Ŋmǝ yǝ ŋ́ na ka lɔ cɛŋwǝ tuuru, ŋ́ nǝ́ǝ tǝ mǝ ŋ koru piyǝ rɛ lǝ ǝmǝ tɩ? Amaa cɛŋwǝ tǝfaŋceŋceŋ la Sara ŋ nǝh tǝ mǝ ŋ koru piyǝ lǝ ǝmǝ wǝ?» <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Wǝ́ ŋ tìi Worokoyǝ ǝkǝnǝŋ: «We koonu kǝ Isǝmayɛlǝ ŋ tii vɔrʊrǝ sɩsiɛrɩ, kǝ a yɩrɩ no yurǝ rǝ ko.» <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />Wǝ́ Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ow! Lé tie Sara lǝ́ǝ mǝ bǝrǝŋpirǝ ŋ koonu lǝ́, kǝ o mǝ pwo ŋwǝ Isakǝ<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="ft" closed="false">Isakǝ lo duturǝ ɖi la mɔŋ.</char></note>. Ŋ́ née yee ŋ́ saŋ rǝ mǝ dierǝ we ŋ na parǝ ŋ nǝ tǝnǝ rǝ ŋlǝ mǝ ŋwǝ mǝ nǝ wǝmǝkpǝ le kǝtiitiikǝ kǝkpakǝkpa. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Ŋ́ no nuŋ dierǝ we e le tíi mǝ o lo ru rǝ Isǝmayɛlǝ wǝ. Ŋ́ náa pɛɛrɩ ŋwǝ, kǝ ŋ́ koonu kǝ ŋ mǝ epipǝ mǝ epilepipǝ ŋpa. Lǝ́ǝ mǝ okulǝtǝpǝ tǝ mǝ eyi, kǝ pǝ ru nyɩŋrǝ, kǝ ŋ ri kǝkpǝŋmumuŋkǝ rɛ lǝ tǝtǝtǝtǝyǝ. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Paape Isakǝyǝ sa lé tie ŋ nǝh mǝ ŋ koonu lǝ́ acɛŋ mǝ eniyǝ sa we, ŋ́ née yee ŋ́ saŋ rǝ mǝ dierǝ we ŋ́ na parǝ ŋ́ nǝ tǝnǝ ŋlǝ mǝ ŋwǝ.» <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Kǝ́ Worokoyǝ ŋ na wɛɛlɩ mǝ Abǝrahamǝ ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ ŋ ka ŋ rɛ.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Jirǝ we jirǝ we, wǝ́ Abǝrahamǝ ŋ kǝ̀ǝlǝ ne pi Isǝmayɛlǝ mǝ arɔŋpǝ we pǝ lǝ mǝ rǝ na nyarǝwǝ mǝŋ epǝ we ŋ no fuu wǝ. Wǝ́ ŋ kǝ̀ǝlǝ ǝpǝrǝŋpǝ we kpǝlo rǝ na nyarǝwǝ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Abǝrahamǝ kǝ lǝǝmǝ cɛŋwǝ tǝfaŋceŋceŋ mǝ faŋceŋceŋ wǝ́ ŋ kǝ̀ǝlǝ na wɛ. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Isǝmayɛlǝ kǝ lǝǝmǝ cɛŋwǝ tǝ mǝ ta wǝ́ pǝ kǝ̀ǝlǝ ŋwǝ. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Abǝrahamǝ mǝ ne pi Isǝmayɛlǝ pǝ kǝ̀ǝlǝ jirǝ jeŋceŋ <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />mǝŋ ǝpǝrǝŋpǝ we pǝ ke kpii rǝ na nyarǝwǝ: arɔŋpǝ we pǝ lǝ mǝ rǝ na nyarǝwǝ mǝ epǝ we ŋ no fuu wǝ.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Worokoyǝ lo po co Sara la garǝ ǝkǝnǝŋ lǝ́ǝ mǝ bǝrǝŋpirǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Ǝtǝ Woroko pɔ̀rʊ na wɛ kanǝ Abǝrahamǝ rǝ Mamǝre le eciimumuŋyǝ we lǝ kǝnǝŋkǝ. Anyɩŋ cɔkɔŋyǝ lo ku, wǝ́ Abǝrahamǝ ŋ ke tini rǝ ne bwiirǝ lo guŋpolurǝ. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Kǝ́ ŋ ne yiili anyɩŋkǝ kǝtǝrǝceŋceŋ ko we, wǝ́ ŋ nyɩnɩ enyi ata pǝ yaa rǝ nɔ rǝ na kǝnyɩŋkǝ. Kǝ́ ŋ na nyɩŋ pǝ ǝnǝ we, wǝ́ ŋ sùu rǝ guŋpolurǝ we ŋ kolu ŋ tù pǝ, wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ ŋ cèeni pǝ. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />Wǝ́ ŋ tìi ceŋceŋ rǝ pǝlǝ mǝrǝ ǝkǝnǝŋ: «Kulǝtǝyǝ dɔɔkpɛ, yee mǝ lɛsiɛrɩwǝ, kǝ ǝ pǝǝ sǝ ŋmǝ lá sʊmatǝyǝ a tɛlɩ. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Nǝ dɔɔkpɛ pǝ lóo koonu nǝ mɛŋwǝ nǝ wɛ akparǝyǝ<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">Rǝ gaarǝ we we, vǝ́ pǝ la lɔ sǝǝyǝ ǝ pǝ ŋ koonu na mɛŋwǝ ŋ wɛɛ akparǝyǝ kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ pǝ la lɔ ŋwǝ sɩsiɛrɩ.</char></note>, kǝ nǝ tii nǝ wɛɛ rǝ wǝciikpǝ sa lǝ kǝnǝŋkǝ. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Ŋ́ náa taa tǝrɛ ŋ́ koonu nǝ nǝ ri, kǝ nǝ nya okopiyǝ, kǝ nǝ ci o mǝ ko. Eniyǝ we ŋ́ ne ci wǝ ǝkǝnǝŋ nǝ nyaa pa tɛlɩ rǝ ŋmǝ, nǝ sʊmatǝyǝ lǝ kpǝŋ akpaakpa.» Wǝ́ ǝsǝǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ ŋ yee mǝŋ kǝ́ ŋ na tɛŋ wǝ. <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />Wǝ́ Abǝrahamǝ ŋ sìɛnɩ kalaŋkalaŋ ŋ kolu ŋ fìi bwiirǝ, wǝ́ ŋ tìi Sara ǝkǝnǝŋ: «Fǝǝlǝ! Kaa fuŋtuceeceewǝ yawayǝ ta a fɔrʊ, kǝ o yo kpɔnɔyǝ.» <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />Wǝ́ ŋ sùu ŋ kolu na anɛŋpǝ lǝ mǝrǝ, ŋ kolu ŋ lɔ̀ nɛŋtǝŋrǝ we la tɔɔ wǝpɔŋkpǝ sɩsiɛrɩ wǝ. Wǝ́ ŋ fǝ̀ rǝ ŋ kòonu na sʊmatǝyǝ rɛ ŋ wʊlʊ kalaŋ, wǝ́ ŋ tonu gakǝ we. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Kǝ́ gakǝ we kǝ le pie we, wǝ́ Abǝrahamǝ ŋ fǝ̀ kɔɔrʊnyɩŋsiwǝ mǝ akɔrʊnyɩŋŋwɛŋpǝ mǝ kǝnɛŋkakǝ we ŋ pǝlǝ ŋ tǝnǝ ǝsǝǝpǝ we. Wǝ́ pǝ ke ŋ ri, anyɩŋ Abǝrahamǝ yaa rǝ pǝla kǝlɛɛrɩkǝ rǝ wǝciikpǝ we lǝ kǝnǝŋkǝ. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />Wǝ́ enyipǝ we pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Lé tie Sara pa?» Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Tini rǝ bwiirǝ rǝ ɖeeni.» <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />Wǝ́ ǝsǝǝpǝ we la rɛɛyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nah pa siɛnɩ ŋ́ pǝ lǝ́ kpǝŋ acɛŋ mǝ eniyǝ sa taa. Lé tie lée re bǝrǝŋpirǝ mǝ akaakǝ.» Anyɩŋ Sara tini lóo nuŋ etieyǝ we rǝ bwiirǝ we lo guŋpolurǝ rǝ Abǝrahamǝ la kǝmaakǝ. <verse eid="GEN 18:10" /><verse number="11-12" style="v" sid="GEN 18:11-12" />Wǝ́ ŋ mʊnʊ rǝ nǝ mǝrǝ, duturǝ ɖi ŋpǝ mǝ Abǝrahamǝ pǝ lo kuru pǝ lɔ̀ acɛŋyǝ, wǝ́ Sara ŋ lɛ̀ ŋ tǝ̀ ǝmǝkǝ. Wǝ́ Sara ŋ tɛnɩ ǝkǝnǝŋ: «Ŋmǝ yǝ ŋ́ no ko kuru kɔfɩkɔfɩ ŋ́ na lɛ, wǝ́ mǝ kulǝtǝyǝ ŋwǝ ŋkpɛ ŋ no ko kuru kɔfɩkɔfɩ ŋ na lɛ, ŋ́ nǝ́ǝ tǝ ŋ́ nyɩŋ wǝraŋkpǝ rɛ tɩ?» <verse eid="GEN 18:11-12" /><verse number="13" style="v" sid="GEN 18:13" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ Abǝrahamǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ Sara ŋ na mʊŋ wǝ? Kǝ́ kǝto wǝ́ ŋ ya ŋ náa tɛŋ ǝkǝnǝŋ: “Kǝto kǝceecee ŋ́ nǝ́ǝ tǝ ŋ́ koru piyǝ lǝ ǝmǝ wǝ? Ŋmǝ yǝ ŋ́ no kuru kururu wǝ?” <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Tǝrɛ wǝ kpii kǝ oturu wǝ lɛnyɩ kururu wǝ koonu Ǝtǝ Woroko? Po nuŋ kǝ́ ŋ́ náa siɛnɩ ŋ́ pǝ lǝ́ kpǝŋ acɛŋ mǝ eniyǝ sa ke we, Sara lée re bǝrǝŋpirǝ mǝ akaakǝ.» <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />Wǝ́ vurǝ vìi Sara, wǝ́ ŋ cwɩ̀ɩ ǝkǝnǝŋ: «Ŋ́ naa mʊŋ oo.» Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, a la mʊŋ!»<verse eid="GEN 18:15" /></para>
  <para style="s">Abǝrahamǝ lǝ pǝ́ ǝfǝcɛɛkǝ lo koonu Osodomǝtǝpǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Wǝ́ enyipǝ we pǝ yili pǝ ko ŋ ko, wǝ́ pǝ ka ŋ yɩrɩ rǝ Sodomǝ la gaarǝ. Wǝ́ Abǝrahamǝ ŋ sanǝ mǝ pǝ ŋ ko ŋ ko ŋ ko co pǝla kʊŋ. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Wǝ́ Ǝtǝ Woroko ŋ pǝ̀ na wɛ ǝkǝnǝŋ: «Kǝ ŋ́ fǝ tuwǝ sa ŋ́ neh yee ŋ́ ŋwaa Abǝrahamǝ? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Ŋwǝ ŋ nǝh pǝ ŋ pe ri gǝŋnaanǝrǝ rɛ lɛnyɩ lǝ tǝtǝtǝtǝyǝ. Saŋ rǝ ŋwǝ we, ŋ́ náa pɛɛrɩ ǝkǝŋyǝ kpǝlo rǝ kǝtǝǝwǝ. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Ŋ́ na pɔrʊ ŋwǝ kǝ ŋ nya fɛɛ ŋ ci ŋ kaŋ ne epipǝ mǝ epilepipǝ sɩsiɛrɩ, kǝ pǝ saŋ rǝ Ǝtǝ Woroko la gʊŋrǝ. Kǝ pǝ ŋ yee kǝnʊkɔrǝkǝ, kǝ pǝ ŋ lɛ pǝ ŋ yee pǝ ŋ saŋ rǝ wǝkʊʊkpǝ. Mǝŋkǝsa we, kǝ ŋ́ nya fɛɛ ŋ́ yee tuwǝ we ŋ́ no co na garǝ wǝ.» <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />Wǝ́ Ǝtǝ Woroko ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: «Etierɔɔrɔɔyǝ we pǝ ya pǝ láa tɛŋ pǝ ŋ tɛɛ rǝ Osodomǝtǝpǝ mǝ Ogomoratǝpǝ yǝ le teeri fɛɛwǝ. Pǝlo oturɔɔrɔɔyǝ yǝ naanǝ ŋpa. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Kǝto wǝ kaamǝ kǝ ŋ́ sʊʊ ŋ́ ka yɩrɩ mǝŋ etieyǝ sa ŋ́ ya ŋ́ nóo nuŋ pǝ ya pǝ láa tɛŋ pǝ ŋ tɛɛ rǝ pǝ wǝǝ, kǝceecee amaa niarǝ. Mǝŋ kǝceecee we, ŋ́ née ci wǝ, mǝŋ niarǝ we ŋ́ née ci wǝ.» <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />Wǝ́ enyi eyi rǝ ǝsǝǝpǝ we lǝ mǝrǝ pǝ pwɛ̀yɩ pǝ ko ŋ ko Sodomǝ. Wǝ́ Ǝtǝ Woroko mǝ Abǝrahamǝ pǝ tùmǝ pǝ yà<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Rǝ wǝŋʊrʊpʊŋpwakpǝ pǝ la tɛŋ ǝkǝnǝŋ: «Wǝ́ Abǝrahamǝ ŋ tùmǝ ŋ yàa rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ amaa Wǝ́ Ǝtǝ Woroko ŋ tùmǝ ŋ yàa rǝ Abǝrahamǝ la kǝnyɩŋkǝ». </char></note>. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Wǝ́ Abǝrahamǝ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko, kǝto kǝceece a lah wʊ nyikʊʊyǝ a kʊla mǝ nyirɔɔrɔɔyǝ? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Mǝŋ ayɩrɛ enyikʊʊpǝ tǝtʊʊ pǝ kpii rǝ Sodomǝ lǝ tǝŋtǝǝwǝ sa wǝǝ, a láa nyɩɩ a wɔɔ wǝ? Ǝ lǝŋ fǝ a yɩrɩ rǝ enyikʊʊpǝ we tǝtʊʊ kǝ a fǝ a cɛɛ tǝŋtǝǝwǝ sa? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Kwa! O lǝŋ koru tuwǝ sa kǝtǝŋkǝ le eyee. Kǝ a wʊ nyikʊʊyǝ a kʊla mǝ nyirɔɔrɔɔyǝ? Kǝ nyikʊʊyǝ mǝ nyirɔɔrɔɔyǝ pǝ kpǝ́ gbɛŋrǝ jeŋceŋ? Kwa! Wǝ lǝŋ koru ǝ pǝ ǝnǝ! Kǝtǝǝwǝ kpǝlo la kpaŋtɛŋtǝyǝ lǝŋ koru eyee tuwǝ wǝ laa kʊʊ wǝ.» <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ ŋ́ na nya enyikʊʊpǝ tǝtʊʊ rǝ Sodomǝ we, ŋ́ nǝ́ǝ fǝ ŋ́ cɛɛ tǝŋtǝǝwǝ sa kpǝlo rǝ pǝlo yurǝ kǝto».<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Wǝ́ Abǝrahamǝ ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝtǝ Woroko, dɔɔkpɛ fǝ a cɛɛ mǝ oo. Ŋmǝ yǝ ŋ́ nee ce ŋ́ ri tǝrɛ rǝ lé enimiyǝ, wǝ́ ŋ́ ya ŋ́ nóo tu turuwǝ mǝ ŋ wɛɛlɩ mǝ lǝ́. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />Mǝŋ ayɩrɛ enyikʊʊpǝ we pǝ lǝǝ tǝ pǝ ko ro tǝtʊʊ, wǝ́ pǝ lǝ mǝŋ tǝniǝ mǝ atʊʊ wǝǝ, rǝ atʊʊpǝ we pǝ lo ru pǝ lǝ sǝǝlǝ kǝto a láa wɔɔ tǝŋtǝǝwǝ sa kpǝlo?» Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ ŋ́ na nya enyikʊʊpǝ tǝniǝ mǝ atʊʊ we, ŋ́ nǝŋ wɔɔ wǝ.» <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />Wǝ́ Abǝrahamǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ayɩrɛ pǝ lǝ tǝniǝ.» Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ pǝ lǝ tǝniǝ we, ŋ́ nǝŋ wɔɔ wǝ.» <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />Wǝ́ Abǝrahamǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko, dɔɔkpɛ pǝǝ fǝ kpɛɛmʊrʊwǝ mǝŋ ŋ́ tǝ ŋ́ ya ŋ́ náa wɛɛlɩ mǝ lǝ́ oo. Ayɩrɛ pǝ lǝ tǝta.» Wǝ́ Ǝtǝ Worokoyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ ŋ́ na nya tǝta we, ŋ́ nǝŋ wɔɔ wǝ.» <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />Wǝ́ Abǝrahamǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko dɔɔkpɛ, fǝ a cɛ mǝ mǝŋ ŋ́ no tu turuwǝ ŋ tǝ ŋ́ ya ŋ́ náa wɛɛlɩ mǝ lǝ́ oo. Ayɩrɛ pǝ lǝ tiyi.» Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Rǝ enyipǝ sa tiyi lo yurǝ kǝto ŋ́ nǝŋ wɔɔ tǝŋtǝǝwǝ sa.» <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />Wǝ́ Abǝrahamǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko, dɔɔkpɛ pǝǝ fǝ kpɛɛmʊrʊwǝ oo. Kǝtuturukǝ wǝ́ ŋ́ nah wɛɛlɩ mǝ lǝ́ ǝnǝ o. Ayɩrɛ pǝ lǝ enyipǝ tǝ.» Wǝ́ Ǝtǝ Woroko ŋ tɛnɩ ǝkǝnǝŋ: «Rǝ enyipǝ sa tǝ lo yurǝ kǝto ŋ́ nǝŋ wɔɔ tǝŋtǝǝwǝ sa». <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />Kǝ́ Ǝtǝ Woroko ŋ na wɛɛlɩ mǝ Abǝrahamǝ ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko. Wǝ́ Abǝrahamǝ ŋ sìɛnɩ ŋ ko ŋ ko na fɛɛwǝ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">Worokoyǝ la pɔrʊ Lɔtǝ la cɛ kpɛŋ wǝ́ ŋ ne ci awɔɔ Sodomǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Ariɔniyǝ wǝ́ epicoŋpipǝ we eyipǝ pǝ kolu pǝ ke ŋ fii Sodomǝ. Anyɩŋ Lɔtǝ tini rǝ tǝŋtǝǝwǝ sa lo guŋpolurǝ. Kǝ́ ŋ na nyɩŋ pǝ we, wǝ́ ŋ yili ŋ kolu ŋ kù mǝ pǝ. Wǝ́ ŋ kʊnʊ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ rǝ pǝla kǝnyɩŋkǝ ŋ cèeni pǝ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ okulǝtǝpǝ nǝ dɔɔkpɛ, nǝ pǝ kǝ lo ko mǝ nyarǝwǝ, nǝ sʊmatǝyǝ wǝ́ ŋ́ ri, kǝ nǝ ka wɛɛ akparǝyǝ, kǝ nǝ kpɛɛ. Sooso ɖokoŋpirǝ ŋalaŋala we, kǝ nǝ yi nǝ mǝ ko.» Wǝ́ epicoŋpipǝ we pǝ tìi Lɔtǝ ǝkǝnǝŋ: «Ow, yǝ láa kpɛɛ rǝ koruwǝ rǝ canɩtiwǝ.» <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />Paape wǝ́ Lɔtǝ ŋ yà ŋ ka ŋ nyɩɩ mǝ pǝ rǝ, wǝ́ pǝ ci ǝ pǝlǝ pǝ tɛ̀ɛnɩ pǝ kolu pǝ sʊ̀ʊrʊ rǝ nǝ kpǝŋ. Wǝ́ ŋ tìi pǝ yolu kpɔnɔyǝ we pǝ lee kpii dafaŋrǝ wǝ, wǝ́ pǝ càa keericeeceewǝ rɛ pǝ kòonu pǝ pǝ rili. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Pǝ faa ka maa pǝ kpɛɛ, wǝ́ pǝ pǝlǝ pǝ tùru Osodomǝtǝpǝrǝŋpǝ kpǝlo kɩɩkɩ pǝ lo po co pǝ lǝ kǝrǝŋ Lɔtǝ la nyarǝwǝ. Fǝ rǝ okosopifɔŋyǝ po ru onyumupǝ, rɛ loo tuuru. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Wǝ́ pǝ pwò Lɔtǝ, wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝnǝ enyipǝ we pǝ la pa sʊʊrʊ lǝ́ mǝ dumurǝ sa wǝǝ? Pɔrʊ pǝ o ru o po koonu lǝ, kǝ la kpɛɛ mǝ pǝ.» <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />Wǝ́ Lɔtǝ ŋ rù ŋ kolu ŋ tùu pǝ rǝ guŋpolurǝ. Wǝ́ ŋ lɔ̀ ŋwaarǝ ŋ tanǝ rǝ kǝmaakǝ. <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋ, nǝ dɔɔkpɛ, nǝ pee yee turɔɔrɔɔwǝ sa kǝtǝŋkǝ. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Nǝ dɔɔkpɛ, ŋ́ lǝǝmǝ akɔsɔkɔrʊpǝ eyi pǝ fee ci pǝrǝŋyǝ pǝ tǝnǝ. Ŋ́ náa pɔrʊ pǝ ŋ́ koonu nǝ, tuwǝ we wǝ ponu mǝ nǝ we, kǝ nǝ yee mǝ pǝ. Paa enyipǝ sa eyipǝ we, nǝ pee yee mǝ pǝ la tǝrɛ oo, duturǝ ɖi mǝ kpǝŋ wǝ́ pǝ la pa sʊʊrʊ. Kǝto ŋ́ nǝŋ koru amaa tǝrɛ wǝ yee pǝ.» <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />Wǝ́ Osodomǝtǝpǝ sa pǝ tìi Lɔtǝ ǝkǝnǝŋ: «Lǝǝ rǝ leh enimiyǝ! Ŋlǝ́ sǝǝyǝ rǝ, kǝ e yee seyǝ o koonu lǝ? Mǝŋ e lee yee yurǝ, yǝ lée yee mǝ lǝ́ turɔɔrɔɔwǝ le teeri wǝ yǝ leh yee mǝ pǝ wǝ!» Wǝ́ pǝ tù Lɔtǝ pǝ cɛ̀ mǝ okopi mǝ okopi, wǝ́ pǝ rùu pǝ kǝ̀lǝ mǝ ŋwaarǝ we kǝ pǝ nya fɛɛ pǝ wɔɔ rǝ. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Rǝ we ko, wǝ́ epicoŋpipǝ we eyipǝ pǝ kòonu pǝ tà Lɔtǝ rǝ kǝnukǝ wǝ́ pǝ tìini ŋwǝ pǝ fìi nyarǝwǝ. Wǝ́ pǝ lɔ̀ ŋwaarǝ we pǝ tanǝ. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Wǝ́ epicoŋpipǝ sa pǝ kòonu wǝ́ enyipǝ we kpǝlo kɩɩkɩ pǝ ka yaa rǝ guŋpolurǝ we la kǝnyɩŋkǝ, mǝŋ alaatie mǝŋ omumuŋ pǝ tǝ̀rǝ kǝtǝrǝceŋceŋ, kǝto pǝ loo koru anyɩŋ guŋpolurǝ we. <verse eid="GEN 19:11" /><verse number="12" style="v" sid="GEN 19:12" />Wǝ́ epicoŋpipǝ we pǝ pǝ́ Lɔtǝ ǝkǝnǝŋ: «Tuuluyǝ rɛ tǝ kpii lǝ́ rǝ sa? Nutǝyǝ? Lǝ́ ǝpǝrǝŋpipǝ? Lé etiepipǝ? Yǝ we ŋ nya ŋ ri lé nyiyǝ rǝ tǝŋtǝǝwǝ sa we, fǝ pǝ kǝ nǝ pwɛyɩ rǝ wǝ. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />Duturǝ ɖi yǝ lah wɔɔ tǝŋtǝǝwǝ sa. Ǝtǝ Woroko lo nuŋ enyipǝ le etiemumuŋyǝ pǝ ya pǝ láa tɛŋ pǝ ŋ ru rǝ ǝtǝŋtǝǝtǝpǝ sa lo oturɔɔrɔɔyǝ pǝ ya pǝ lée yee wǝ. Fɛɛwǝ ŋ ne kpii lǝ la pa wɔɔ tǝŋtǝǝwǝ sa wǝǝ.» <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />Wǝ́ Lɔtǝ ŋ rù ŋ kolu ŋ nyɩnɩ no onutǝpǝ, epǝ we pǝ tɔ̀ɔ na akɔrʊpǝ pǝ lɔ wǝtiekpǝ wǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ fǝǝlǝ nǝ! Nǝ ru nǝ pwɛyɩ rǝ tǝŋtǝǝwǝ sa duturǝ ɖi Ǝtǝ Woroko lah wɔɔ wǝ.» Wǝ́ Lɔtǝ lo onutǝpǝ sa pǝ nyɩnɩ rǝ ǝkǝnǝŋ Lɔtǝ ya lóo co amɔŋkpɛɛyǝ rǝ. <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />Rokoŋpikaalǝwǝ wǝ́ epicoŋpipǝ sa pǝ ko ŋ tu Lɔtǝ rǝ ŋ yi ŋ pwɛyɩ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yi! Fǝ lé tie mǝ lá akɔrʊpǝ sa pǝle eyi kǝ nǝ ru nǝ pwɛyɩ rǝ tǝŋtǝǝwǝ sa. Mǝŋ ŋkǝ kaa wǝǝ, vǝ́ tǝŋtǝǝwǝ sa wǝ lah lɔ wǝlo tukoŋtawǝ we, nǝ nyǝ́ǝ kpǝ́.» <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />Wǝ́ Lɔtǝ ŋ tǝ ŋ yà ŋ ko ŋ tuuru. Wǝ́ Ǝtǝ Woroko ŋ nyɩnɩ na tǝlarǝwǝ. Wǝ́ epicoŋpipǝ we pǝ tà Lɔtǝ, ne tie mǝ na akɔrʊpǝ we pǝle eyi rǝ kǝnukǝ wǝ́ pǝ rù mǝ pǝ pǝ cɛ̀ rǝ tǝŋtǝǝwǝ sa. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Kǝ́ pǝ lo ru mǝ pǝ pǝ la cɛ rǝ tǝŋtǝǝwǝ sa we, wǝ́ epicoŋpipǝ we le ceŋceŋ ŋ tìi Lɔtǝ ǝkǝnǝŋ: «Mǝ suu kǝ a nya fɛɛ apɔrʊ lá wɛ la vɔrʊrǝ! Paa ka yɩrɩ kǝmaakǝ oo, paa ka yaa rǝ gaarǝ sa la fɛɛwǝ rɛ oo. Mǝŋ ǝ lǝ́ǝ pǝ́ e tii vɔrʊrǝ we, suu a ka ŋʊrʊ rǝ otutupiyǝ.» <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />Wǝ́ Lɔtǝ ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Keyi! Ow, Kulǝtǝyǝ dɔɔkpɛ. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Kǝceece, e le yee lá sʊmatǝyǝ le wǝceeceekpǝ. A la nyɩŋ mǝ tǝlarǝwǝ ŋpa, wǝ́ a la lɔ o lo koonu mǝ. Paape ŋmǝ we, ŋ́ nǝŋ po koru osuu ŋ́ ko ro otutupiyǝ we kpɛŋ kǝ turɔɔrɔɔwǝ sa wǝ ci ǝpǝ, ŋ́ nǝ́ǝ kpǝ́. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Dɔɔkpɛ, a la nyɩŋ dǝŋtǝǝpirǝ sa, loo mumu lǝǝrǝ mǝ sa, ŋ́ nóo koru osuu ŋ́ ke fii we. Wǝ́ laa lɛ ŋ naanǝ. Dɔɔkpɛ maa kǝ ŋ́ suu ŋ́ ka ŋʊrʊ rǝ we, kǝ ŋ́ nya fɛɛ ŋ́ tii vɔrʊrǝ.» <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />Wǝ́ picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ ponu, ŋ́ nǝ tǝ ŋ́ na nyɩŋ lǝ́ tǝlarǝwǝ! Ŋ́ nǝŋ wɔɔ dǝŋtǝǝpirǝ sa a la tɛŋ wǝ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Mǝ ko a ka ŋʊrʊ rǝ we kalaŋ, duturǝ ɖi ŋ́ nǝŋ maa ŋ́ koru eyee tǝrɛ, e leh ke fii kpɛŋ.» Wǝ kǝto pǝ lóo pwo tǝŋtǝǝwǝ sa ǝkǝnǝŋ Sowarǝ. <verse eid="GEN 19:22" /><verse number="23" style="v" sid="GEN 19:23" />Kǝ́ Lɔtǝ ŋ no ko ŋ neh fii Sowarǝ we, anyɩŋ cɔkɔŋyǝ lo poŋ. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Eniyǝ we wǝ́ Ǝtǝ Woroko ŋ kòonu orukuunayǝ mǝ naawǝ yǝ ko ŋ ru rǝ oŋuŋkǝ yǝ ŋ pǝ yǝ ŋ tɔɔlʊ Sodomǝ mǝ Gomora piripiri. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Wǝ́ tǝŋtǝǝwǝ sa wǝle yi wǝ yeli naa pukupuku mǝŋ wǝle enyipǝ, wǝ́ gaarǝ we kpǝlo kɩɩkɩ yeli naa pukupuku mǝŋ eciiyǝ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Wǝ́ Lɔtǝ le tie ŋ sìɛrɩ ŋ yɩ̀rɩ kǝmaakǝ, wǝ́ ŋ sìɛrɩ ŋ yeli dǝraŋrurǝ ŋ yàa. <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />Gaalǝǝrǝkǝ wǝ́ Abǝrahamǝ ŋ yili mǝ ɖokoŋpirǝ ŋalaŋala ŋ kolu fɛɛwǝ we ŋ yàa rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ wǝ. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Wǝ́ ŋ yɩ̀rɩ ŋ kolu rǝ Sodomǝ mǝ Gomora la kǝtakǝ mǝ gaarǝ we kpǝlo kɩɩkɩ, wǝ́ ŋ nyɩnɩ kǝtǝrǝceŋceŋ kǝ́ nuŋrǝ láa rɛ kumukumu rǝ fɛɛwǝ we kǝ a tɛŋ naamumuŋwǝ rɛ lo nuŋrǝ kǝtǝ. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />Kǝ́ Worokoyǝ ŋ yili ŋ nah wɔɔ ǝtǝŋtǝǝyǝ we rǝ gaarǝ we Lɔtǝ ŋ ke kpii we, wǝ́ ŋ tàalǝ Abǝrahamǝ, wǝ́ ŋ pɔ̀rʊ Lɔtǝ ŋ cɛ̀ kpɛŋ wǝ́ ŋ ci awɔ̀ɔ ǝtǝŋtǝǝyǝ sa.<verse eid="GEN 19:29" /></para>
  <para style="s">Lɔtǝ mǝ na akɔrʊpǝ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Wǝ́ Sowarǝ le etiikǝ kǝ pǝlǝ kǝ ko ŋ co Lɔtǝ lo vurǝ. Wǝ́ ŋ pwɛ̀yɩ rǝ tǝŋtǝǝwǝ sa. Wǝ́ na akɔrʊpǝ we eyipǝ pǝ sìimǝ ŋwǝ. Wǝ́ ŋ kolu ŋ tini rǝ otutupiyǝ, rǝ wǝnyaŋkpǝ rɛ mǝrǝ ŋpǝ mǝ na akɔrʊpǝ. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Wǝ́ jirɛɛrǝ na kɔrʊmumuŋyǝ we ŋ pǝlǝ ŋ tìi na paatɛ ǝkǝnǝŋ: «Lǝh tǝ lo kuru, wǝ́ pǝrǝŋyǝ rɛ lee kpii rǝ gaarǝ sa ŋ nǝh pǝ fǝ lǝ ŋ lɔ mǝŋ kǝ́ pǝ lée yee rǝ fɛɛ ri ŋ fɛɛ kǝtǝ wǝ. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />E cii? Pǝ kǝ lo koonu lǝh tǝ lǝ ǝfǝŋpǝ ŋ ŋuŋ ŋ piemu kǝ ŋ kpɛɛ mǝ lǝ, kǝ la nya fɛɛ lǝ mǝ epipǝ lo koonu ŋwǝ pǝ ri nǝ wǝmǝkpǝ.» <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />Wǝ́ ɖiɔrǝ we pǝ kòonu pǝlǝ tǝ lǝ ǝfǝŋpǝ ŋ ŋunu ŋ pìemu, wǝ́ mumuŋyǝ we ŋ kolu ŋ kpɛlɩ nǝ tǝ lǝ kpǝŋ. Nǝ tǝ lee ke ci wǝla rɛ. Lee ke ci eniyǝ we ŋ pǝlǝ ŋ kpɛlɩ mǝ eniyǝ we ŋ yili ŋ pwɛ̀yɩ wǝ. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />Gaalǝǝrǝkǝ wǝ́ kɔrʊmumuŋyǝ we ŋ tìi na paatɛ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, ŋ́ kpɛlɩ mǝ tǝ lǝ kpǝŋ ǝsǝǝkǝ mǝ dumurǝ. Kǝ lǝ tǝ lo koonu nǝ ǝfǝŋpǝ ŋ ŋuŋ ŋ piemu mǝ ɖiɔrǝ sa kǝ ŋlá ŋkpɛ a ka kpɛɛ nǝ kpǝŋ, kǝ la nya fɛɛ lǝ mǝ epipǝ lo koonu ŋwǝ kǝ pǝ ri nǝ wǝmǝkpǝ.» <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Wǝ́ kǝceece kǝ́ ɖiɔrǝ lǝ tǝ lo ro we, wǝ́ pǝ tǝ pǝ kòonu pǝlǝ tǝ lǝ ǝfǝŋpǝ ŋ ŋunu ŋ pìemu, wǝ́ pipiyǝ we ŋ kolu ŋ kpɛlɩ nǝ tǝ lǝ kpǝŋ. Lɔtǝ lee ci wǝla rɛ, lee ci eniyǝ ŋ pǝlǝ ŋ kpɛlɩ nǝ kpǝŋ mǝ eniyǝ ŋ yili ŋ pwɛ̀yɩ wǝ. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />Wǝ́ Lɔtǝ la akɔrʊpǝ we pǝle eyi pǝ rè pǝ kòonu pǝlǝ tǝ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Wǝ́ mumuŋyǝ we ŋ mǝnǝ bǝrǝŋpirǝ, wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Mowabǝ. Ŋwǝ ŋ ri Omowabǝtǝpǝ we pǝ ke kpii lǝ tǝtǝtǝtǝyǝ po ro ruŋruŋ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Wǝ́ pipiyǝ we ŋwǝ ŋkpɛ ŋ mǝnǝ bǝrǝŋpirǝ wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Bɛnami. Ŋwǝ ŋ ri Amonitǝpǝ we pǝ ke kpii lǝ tǝtǝtǝtǝyǝ po ro ruŋruŋ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Abǝrahamǝ lǝ tǝǝnǝ Abimelɛkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Abǝrahamǝ pwɛ̀yɩ ko ŋ ko Negɛvǝ la gaarǝ. Wǝ́ ŋ kolu ŋ tini rǝ Kadɛsǝ mǝ Surǝ le kǝtiitiikǝ. Wǝ́ ŋ pǝlǝ ŋ yili ŋ kolu ŋ ce ŋ kpìi rǝ Gera. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Abǝrahamǝ ke ŋ tíi enyipǝ mǝ ŋ ru rǝ ne tie Sara ǝkǝnǝŋ: «Mǝ paatɛyǝ ŋ lǝǝwe.» Fɛɛwǝ Geratǝpiliyǝ Abimelɛkǝ, ŋ kpìi pǝ kolu pǝ fǝ̀ Sara pǝ pǝlǝ pǝ tǝnǝ rǝ na nyarǝwǝ wǝǝ. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />Wǝlo dumurǝ we, wǝ́ Worokoyǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Abimelɛkǝ rǝ kǝtʊkpɛɛkǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tieyǝ sa ǝ lǝ kǝ fǝ ǝ lǝ pǝ tǝnǝ kǝto we, ǝ lǝ́ǝ kpǝ́. Duturǝ ɖi la caa.» <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />Abimelɛkǝ faa ka maa ŋ ru tieyǝ sa. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko, ŋlǝ mǝ mǝ kǝkpǝŋkǝ yǝ lee yee turɔɔrɔɔwǝ rɛ! Kǝ a wʊ lǝ? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Abǝrahamǝ ŋwǝŋwǝ le tíi mǝ ǝkǝnǝŋ na paatɛyǝ ŋ lǝǝwe. Wǝ́ Sara ŋwǝ ŋkpɛ ŋ na tɛɛnɩ ǝkǝnǝŋ ne mǝteeyǝ ǝrǝ Abǝrahamǝ. Kǝto ŋ́ ne yee wǝ turuwǝ wǝ laa nyaa mǝ mɛŋwǝ, wǝ́ ŋ́ nee yee turɔɔrɔɔwǝ rɛ.» <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />Rǝ kǝtʊkpɛɛkǝ we wǝ́ Worokoyǝ ŋ yìili ǝkǝnǝŋ: «Ŋmǝ ŋkpɛ ŋ́ cii wǝ ǝkǝnǝŋ ló turuwǝ wǝ laa nyaa lá mɛŋ. Ŋmǝ ŋ́ nǝ sǝŋ kʊŋwǝ ŋ́ no koonu lǝ́ e pee yee turɔɔrɔɔwǝ ǝ pǝ rǝ mǝ kpǝŋ, wǝ kǝto ŋ́ naa maa lǝ́ o ru Sara wǝǝ. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Rǝkǝsa, kpǝlǝŋ mǝ tieyǝ sa o koonu no nuŋ. Worokokpɛɛnuŋtɛŋtǝyǝ wǝ́ ŋ ri, láa mwɛŋ nyuŋkpǝ ŋ koonu lǝ́ kǝ a nya fɛɛ e tii vɔrʊrǝ. Paa mǝŋ ǝ lǝ sǝ́ŋ ǝ lǝǝ kpǝlǝŋ mǝ ŋwǝ o koonu ŋwǝ we, ci wǝ ǝkǝnǝŋ ŋlǝ́ ǝ lǝ́ǝ kpǝ́ taa mǝŋ le enyipǝ kpǝlo kɩɩkɩ.»<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Wǝ́ Abimelɛkǝ ŋ yili mǝ ɖokoŋpirǝ ŋalaŋala wǝ́ ŋ pwò na acaamɩpǝ ŋ pǝlǝ, wǝ́ ŋ fǝ̀ etieyǝ sa ŋ pɔ̀ pǝla amayǝ. Wǝ́ pǝ fìi vurǝ ŋpa. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Wǝ́ Abimelɛkǝ ŋ pwò Abǝrahamǝ ŋ pǝlǝ, wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ e le yee mǝ lǝ ǝnǝ? Kǝ́ lo turɔɔrɔɔ wǝ́ ŋ́ ne yee mǝ lǝ́ wǝ́ e le re ŋlǝ mǝ mǝ kǝkpǝŋkǝ e le kpii kǝ le ke yee turɔɔrɔɔmumuŋwǝ sa ǝnǝ? Rɛ lǝŋ yee tuwǝ sa e le yee mǝ mǝ kʊrakʊra.» <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Wǝ́ Abimelɛkǝ ŋ pǝ̀ Abǝrahamǝ ǝkǝnǝŋ: «Kǝ́ wǝ le fii lé enimiyǝ wǝ́ e le yee tuwǝ sa ǝnǝ?» <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no pu wǝ ǝkǝnǝŋ enyipǝ sa rǝ fɛɛwǝ sa pǝ lǝŋ suu Worokoyǝ lo vurǝ kʊrakʊra. Pǝ lah pa wʊ mǝ rǝ mǝ tie lo yurǝ. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Paa kǝceece, mǝ paatɛyǝ ŋ lǝǝwe, ŋlǝ mǝ ŋwǝ tǝceŋceŋ eleepǝ kpookpoo, wǝ́ ŋ́ nǝ fǝ ŋwǝ ŋ́ na lɔ wǝǝ. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Kǝ́ Worokoyǝ ŋ ne tíi mǝ ŋ́ ru ŋ́ pwɛyɩ rǝ mǝ tǝ la nyarǝwǝ we, wǝ́ ŋ́ ne tíi Sara ǝkǝnǝŋ: “Fɛɛ ri ŋ fɛɛ yǝ lóo ko we, yee mǝ wǝceeceekpǝ sa oo, mǝ tɛŋ ǝkǝnǝŋ lé mǝteeyǝ wǝ́ ŋ́ ri oo.”»<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Kǝ́ Abimelɛkǝ ŋ nǝ kpǝlǝŋ mǝ Sara ŋ noh koonu Abǝrahamǝ we, wǝ́ ŋ fǝ̀ amɛɛpǝ, epereceepǝ mǝ anɛŋpǝ ŋ tɛ̀ɛ, wǝ́ ŋ tǝ ŋ fǝ̀ asʊmatǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ ŋ kʊ̀la ŋ kòonu ŋwǝ. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Wǝ́ Abimelɛkǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ gǝŋrǝ sa gbɛlɩ goonu lǝ́. Fɛɛwǝ we wǝ ponu mǝ lǝ́ we, ke tii rǝ wǝ.» <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />Wǝ́ ŋ tìi Sara ǝkǝnǝŋ: «Yɩrɩ re, ŋ́ nǝ fǝ sɩkakpotokpotoyǝ lafa ceŋceŋ ŋ́ no koonu lé mǝtee kǝ wǝ fǝ wǝ kaŋ enyipǝ we pǝ kʊla mǝ lǝ́ ǝkǝnǝŋ ŋlǝ́ e lee yee turɔɔrɔɔwǝ rɛ rǝ dierǝ sa mǝrǝ». <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />Wǝ́ Abǝrahamǝ ŋ mwɛnɩ nyuŋkpǝ ŋ pwò Worokoyǝ, wǝ́ Worokoyǝ ŋ tàanǝ Abimelɛkǝ, ne tie mǝ etiepǝ we pǝ ka ŋ sʊma ŋwǝ la gʊŋrǝ, wǝ́ pǝ cìi ǝtǝ pǝ ke ŋ re pǝ ŋ mǝ. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />Kaŋfɩ Ǝtǝ Woroko sǝnǝ etiepǝ we kpǝlo kɩɩkɩ pǝ ke kpii rǝ Abimelɛkǝ la nyarǝwǝ lǝ ǝmǝkǝ rǝ tuwǝ we wǝ pǝlǝ wǝ tùu Abǝrahamǝ le tie Sara kǝto.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Isakǝ lǝ ǝmǝkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Ǝtǝ Woroko yeli Sara le wǝceeceekpǝ mǝŋ kǝ́ ŋ tɛnɩ wǝ kǝtǝ. Yeli tuwǝ we ŋ cò na garǝ wǝ. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Wǝ́ Sara ŋ rè mǝ eniyǝ we Abǝrahamǝ ŋ no kuru ŋ na lɛ wǝ. Wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ mǝ eniyǝ we Woroko ŋ tɛnɩ wǝ. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Wǝ́ Abǝrahamǝ ŋ kpìi piyǝ we Sara ŋ mǝnǝ ŋ kòonu ŋwǝ la nyɩŋrǝ ǝkǝnǝŋ Isakǝ. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Kǝ́ piyǝ we ŋ na lɔ wǝcukpǝ wǝnɛŋ we, wǝ́ ŋ kǝ̀ǝlǝ ŋwǝ mǝŋ kǝ́ Worokoyǝ ŋ tɛnɩ wǝ ŋ tìi ŋwǝ kǝtǝ. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Abǝrahamǝ lɔ̀ cɛŋwǝ tuuru wǝ́ pǝ mǝnǝ ne pi Isakǝ. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />Wǝ́ Sara ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ lo co mǝ amɔŋkpɛɛyǝ. Nyi ri ŋ nyi ŋ nóo nuŋ mǝ tuwǝ sa we, láa mɔŋ ŋ toŋ mǝ.» <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Wǝ́ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Ǝlǝ ŋ nóo koru e tíi Abǝrahamǝ ǝkǝnǝŋ Sara lah pa mɛɛnɩ piyǝ jirǝ rɛ? Paape ŋ́ nǝ mǝ bǝrǝŋpirǝ ŋ́ no koonu ŋwǝ mǝŋ no kǝnyumukǝ!»<verse eid="GEN 21:7" /></para>
  <para style="s">Abǝrahamǝ le piri Agarǝ mǝ ne pi Isǝmayɛlǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Kǝ́ Isakǝ ŋ ya ŋ náa naanǝ we, wǝ́ Sara ŋ sǝ̀ ŋwǝ. Jirǝ we Sara ŋ nǝ sǝ piyǝ sa we, wǝ́ Abǝrahamǝ ŋ càa keerimumuŋwǝ rɛ pǝ rili wǝcɛkpǝ. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />Jirɛɛrǝ we, wǝ́ Sara ŋ nyɩnɩ kǝ́ Ejipǝtetǝtieyǝ we pǝ lóo pwo Agarǝ le piyǝ we ŋ mǝnǝ ŋ kòonu Abǝrahamǝ ŋ yà ŋ náa wʊrʊ wǝ. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Wǝ́ ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: «Piri rɔŋyǝ sa mǝ ne piyǝ. Rɔŋyǝ sa le piyǝ sa lee kpii ŋ neh pe ri ǝtǝtuyǝ ŋ kʊla mǝ mǝ pi Isakǝ.» <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />Wǝ́ dierǝ sa gbìi Abǝrahamǝ la awɛɛlɩkǝ ŋpa, duturǝ ɖi Isǝmayɛlǝ ŋwǝ ŋkpɛ ri ne pimǝyǝ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Wǝ́ Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ pee kpii lǝ́ awɛɛlɩkǝ rǝ lé piyǝ sa mǝ lá rɔŋyǝ sa lo yurǝ. Tɛɛnɩ e yee a saŋ rǝ tu ri ŋ tu Sara ŋ ne tíi lǝ́ wǝ. Kpiikǝ Isakǝ lǝ mǝrǝ wǝ́ wǝmǝkpǝ we ŋ cò lǝ́ garǝ wǝ loh ru wǝ. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Ŋ́ nóo koonu kǝ kǝkpǝŋkǝ rɛ ŋkee kǝ ru rǝ Agarǝ le piyǝ we mǝrǝ duturǝ ɖi lé piyǝ wǝ́ ŋ ri.» <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />Gaalǝǝrǝkǝ wǝ́ Abǝrahamǝ ŋ yili mǝ ɖokoŋpirǝ ŋalaŋala wǝ́ ŋ fǝ̀ keeriwǝ, wǝ́ ŋ kpìi mɛŋwǝ mǝ fwɛɛwǝ le diirǝ wǝ́ ŋ fǝ̀ ŋ tɛ̀ɛ Agarǝ rǝ goŋkoŋrǝ, wǝ́ ŋ fǝ̀ piyǝ we ŋ kpìi ŋwǝ rǝ akaakǝ, wǝ́ ŋ cò na kʊŋ. Wǝ́ Agarǝ ŋ kolu ŋ cò ŋ ka ŋ tɛlɩ rǝ nyɔŋkpaakǝtǝǝwǝ rǝ Bɛrǝseba la gaarǝ.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />Kǝ́ na mɛŋwǝ we wǝ la lɛ we, wǝ́ ŋ màa piyǝ we ŋ tǝ̀nǝ rǝ wǝciipikpǝ rɛ kǝnǝŋkǝ. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Wǝ́ ŋ rùu ŋ cɛ̀ ŋ kolu ŋ tini rǝ nɔ wǝ lǝ́ǝ lǝ mǝŋ mɛtayǝ tuuru. Duturǝ ɖi ka ŋ tɛŋ ǝkǝnǝŋ: «Ŋ́ nǝŋ taa ŋ́ nyɩŋ mǝ pi lǝ ǝkpǝ́kǝ.» Wǝ kǝto ŋ kolu ŋ tini rǝ nɔ, wǝ́ ŋ yà ŋ ke ŋ wee wǝǝ. <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />Wǝ́ Worokoyǝ ŋ nunu piyǝ we la kpɛɛwǝ. Wǝ́ Worokoyǝ le picoŋpiyǝ ŋ pwò Agarǝ rǝ yulaarǝ ŋ manǝ, wǝ́ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Agarǝ, kǝ́ wǝ ya wǝ lée yee lǝ́? Poo suu vurǝ. Worokoyǝ lo nuŋ piyǝ we lo owoolukǝ rǝ fɛɛwǝ we ŋ kpɛlɩ wǝ. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Yi ǝ kǝ fǝ lé piyǝ kǝ a ta ŋwǝ kpoŋkpoŋ. Duturǝ ɖi ŋ́ nóo koonu ŋwǝ ŋ mǝ kǝkpǝŋmumuŋkǝ rɛ.» <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />Wǝ́ Worokoyǝ ŋ wùru Agarǝ le enimiyǝ, wǝ́ ŋ nyɩnɩ mɛŋfuŋwǝ rɛ, wǝ́ ŋ kolu ŋ tʊ̀ʊ mɛŋwǝ ŋ lǝ̀ǝrǝ na fwɛɛwǝ le diirǝ we wǝ́ ŋ kòonu piyǝ we ŋ ŋunu. <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />Worokoyǝ yɩ̀rɩ piyǝ sa lo yurǝ wǝ́ ŋ wàsa. Wǝ́ ŋ kpìi rǝ nyɔŋkpaakǝtǝǝwǝ. Wǝ́ ŋ sìɛrɩ ŋ yeli kpaŋmumuŋyǝ rɛ. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Kolu tini rǝ Paraŋ la nyɔŋkpaakǝtǝǝwǝ. Wǝ́ ne lee ŋ fǝ̀ Ejipǝtetǝtieyǝ ŋ kòonu ŋwǝ ŋ lɔ̀.<verse eid="GEN 21:21" /></para>
  <para style="s">Abǝrahamǝ mǝ Abimelɛkǝ pǝ la parǝ dierǝ pǝ lǝ tǝnǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Rǝ eniyǝ we mǝrǝ wǝ́ Abimelɛkǝ mǝ na kɔŋtǝpiliyǝ we pǝ lóo pwo Pikɔlʊ pǝ pǝlǝ pǝ nyɩnɩ Abǝrahamǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Worokoyǝ kʊla mǝ lǝ́ rǝ ló tu ri ŋ tu e lée yee wǝ. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Rǝkǝsa we tu Worokoyǝ ǝkǝnǝŋ ŋlǝ́ ǝ lǝŋ pǝ tǝǝnǝ mǝ, mǝ epipǝ amaa mǝ epilepipǝ. Mǝŋ kǝ́ ŋ́ ne yee lǝ́ wǝceeceekpǝ ŋ́ na pa tɛlɩ we, ŋlá ŋkpɛ yee mǝ wǝceeceekpǝ mǝŋ gǝŋrǝ sa e le pe tii wǝ.» <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no tu Worokoyǝ.» <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />Wǝ́ Abǝrahamǝ ŋ tìi Abimelɛkǝ mǝ kǝ́ ne enyipǝ pǝ la pa lɔ na mɛŋfuŋwǝ mǝ okopi mǝ okopi wǝ. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Wǝ́ Abimelɛkǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nee ci yǝ we ŋ ne yee tuwǝ sa. Wǝ́ ŋlá ŋkpɛ e lee ce e tìi mǝ wǝ. Wǝ́ ŋ́ naa lɛ ŋ́ nuŋ rɛ ŋ tɛŋ wǝ, we ruŋruŋ le jirǝ sa ko».<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Wǝ́ Abǝrahamǝ ŋ fǝ̀ amɛɛpǝ, epereceepǝ mǝ anɛŋpǝ ŋ kòonu Abimelɛkǝ wǝ́ pǝle eyi pǝ pàrǝ dierǝ pǝ tǝ̀nǝ. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Wǝ́ Abǝrahamǝ ŋ pɔ̀rʊ amɛɛyeepǝ apǝrɩmata ŋ tǝ̀nǝ kpoo. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Wǝ́ Abimelɛkǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ a la pɔrʊ amɛɛyeepǝ sa apǝrɩmata ǝ lǝ tǝnǝ kpoo wǝ?» <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lɔ amɛɛyeepǝ sa apǝrɩmata kǝ wǝ ri ɖaŋsieyǝ ǝkǝnǝŋ ŋmǝ ŋ́ ne nyiŋ mɛŋfuŋwǝ sa.» <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />Wǝ kǝto pǝ lóo pwo fɛɛwǝ we ǝkǝnǝŋ Bɛrǝseba<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">Bɛrǝseba lo duturǝ ɖi: Apǝrɩmata la mɛŋfuŋwǝ amaa dieparǝtǝnǝrǝ la mɛŋfuŋwǝ.</char></note>, kpiikǝ fɛɛwǝ we wǝ́ pǝle eyi pǝ pàrǝ dierǝ pǝ tǝ̀nǝ wǝǝ.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Kǝ́ pǝ la parǝ dierǝ pǝ le tǝnǝ pǝ la lɛ rǝ Bɛrǝseba we, wǝ́ Abimelɛkǝ mǝ na kɔŋtǝpiliyǝ Pikɔlʊ pǝ fǝ̀ kʊŋwǝ, wǝ́ ŋ kpǝ̀lǝŋ ŋ ko ŋ ko Efilisitǝpǝ lǝ gǝŋrǝ. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Wǝ́ Abǝrahamǝ ŋ tɔ̀ wǝciikpǝ rɛ pǝ lóo pwo tamarisǝ rǝ Bɛrǝseba. Wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ mǝ ŋ pwo Worokoyǝ we ŋ kpii kǝkpakǝkpa wǝ. Wǝ́ ŋ ko ŋ pwo ŋwǝ Ǝtǝ Woroko. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Abǝrahamǝ tini Efilisitǝpǝ lǝ gǝŋrǝ sa pànǝ.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">Worokoyǝ le tie Abǝrahamǝ la yɩrɩ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Rǝ wǝla kǝmaakǝ we, wǝ́ Worokoyǝ ŋ tìe Abǝrahamǝ ŋ yɩ̀rɩ. Wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Abǝrahamǝ!» Wǝ́ Abǝrahamǝ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ!» <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />Wǝ́ Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Fǝ lé pi Isakǝ, lé piceŋceŋyǝ we o lǝŋ kuŋ orukǝ wǝ. Mǝ ko Moriya la gaarǝ. Ŋ́ nah ka kaŋ lǝ́ dutupirǝ rɛ. Kǝ ǝ fǝ lé piyǝ sa a ka wʊ o tu naawǝ o toolu o koonu mǝ rǝ we.» <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />Gaalǝǝrǝkǝ wǝ́ Abǝrahamǝ ŋ yili ŋalaŋala wǝ́ ŋ nyàalǝ ǝrǝǝyǝ pǝ leh ke kpii naawǝ pǝ yee otoolukǝ we wǝ. Wǝ́ ŋ kpàka no rookɛtɛyǝ we ŋ nah tɛ ŋ ko na gʊŋrǝ sa wǝ. Wǝ́ ŋ fǝ̀ na asʊmatǝpǝ rɛ eyi ŋ kʊ̀la mǝ ne pi Isakǝ. Wǝ́ ŋ rù ŋ ko ŋ ko fɛɛwǝ we Worokoyǝ ŋ tɛnɩ wǝ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Juutatǝrǝ we, wǝ́ Abǝrahamǝ ŋ nyɩnɩ fɛɛwǝ we ŋ manǝ. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Wǝ́ ŋ tìi na asʊmatǝpǝ we ǝkǝnǝŋ: «Nǝ yaa rǝ sa mǝŋ rookɛtɛyǝ sa. Ŋlǝ mǝ mǝ pi yǝ lah rɛ la ka sʊma Worokoyǝ rǝ ɖeeni kǝ lǝ mǝ pǝ.» <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />Wǝ́ Abǝrahamǝ ŋ rǝ̀ǝrǝ ǝrǝǝyǝ we ŋ tɛ̀ɛ ne pi Isakǝ, wǝ́ ŋwǝŋwǝ ŋ fǝ̀ naawǝ mǝ tʊkʊwǝ. Pǝle eyi pǝ kpii pǝ lóo ko fɛɛceŋceŋ, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />wǝ́ Isakǝ ŋ pǝlǝ ŋ pwò nǝ tǝ ǝkǝnǝŋ: «Mǝ tǝ!» Wǝ́ nǝ tǝ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ, mǝ pi!» Wǝ́ Isakǝ ŋ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Naawǝ ǝwǝǝ, ǝrǝǝyǝ ŋyǝ ŋkpɛ ǝyǝǝ, wǝ́ kǝnǝ mɛɛtǝŋrǝ we yǝ loh ko la ka wʊ lo tu naawǝ lo toolu wǝǝ?» <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pi, Worokoyǝ ŋwǝŋwǝ láa taa ŋ koonu lǝ.» Wǝ́ pǝle eyi pǝ tǝ pǝ kpìi pǝ ko ŋ ko fɛɛceŋceŋ.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Kǝ́ pǝ lo ko ro fɛɛwǝ we Worokoyǝ ŋ kanǝ ŋwǝ we, wǝ́ Abǝrahamǝ ŋ tɔ̀ otoolucuukǝ wǝ́ ŋ fǝ̀ ǝrǝǝyǝ we ŋ tɛ̀ɛ. Wǝ́ ŋ pàrǝ ne pi Isakǝ ŋ tɛ̀ɛ rǝ ǝrǝǝyǝ we rǝ otoolucuukǝ we. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Wǝ́ ŋ kòonu akaakǝ ŋ fǝ̀ tʊkʊwǝ kǝ ŋ sǝ ne pi lo yurǝ. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Wǝ́ Ǝtǝ Woroko le picoŋpiyǝ ŋ pwò Abǝrahamǝ ŋ manǝ rǝ yulaarǝ ǝkǝnǝŋ: «Abǝrahamǝ! Abǝrahamǝ!» Wǝ́ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ!» <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />Wǝ́ Ǝtǝ Woroko le picoŋpiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo ru piyǝ we! Pee yee mǝ no turɔɔrɔɔwǝ rɛ! Rǝkǝsa ŋ́ ne ci wǝ ǝkǝnǝŋ o lóo suu Worokoyǝ duturǝ ɖi a laa kʊʊ ŋwǝ lé piyǝ, lé piceŋceŋyǝ.» <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />Mǝŋ eyiili yurǝ we wǝ́ Abǝrahamǝ ŋ nyɩ̀nɩ kǝ́ mɛɛkpaturǝ rɛ yaa, rǝlo ofoŋyǝ yǝ la kpara rǝ kpiriŋwǝ rɛ. Wǝ́ ŋ kolu ŋ lɔ̀ rǝ ŋ pǝlǝ ŋ wʊlʊ ŋ tù naawǝ ŋ tòolu ŋ kòonu Worokoyǝ rǝ ne pi lo yuwǝ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Wǝ́ Abǝrahamǝ ŋ kpìi fɛɛwǝ we la nyɩŋrǝ ǝkǝnǝŋ: «Ǝtǝ Woroko láa taa ŋ koonu.» Wǝ kǝto pǝ lǝ́ǝ tǝ pǝ ŋ tɛŋ wǝ po ro ruŋruŋ ǝkǝnǝŋ: «Rǝ dutupirǝ lo oŋuŋkǝ we, Ǝtǝ Woroko láa taa ŋ koonu».<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Wǝ́ Ǝtǝ Woroko le picoŋpiyǝ ŋ tǝ ŋ pwò Abǝrahamǝ ŋ manǝ rǝ yulaarǝ kǝyitǝkǝ. <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝtǝ Woroko ŋ ya ŋ náa tɛŋ tuwǝ sa ǝkǝnǝŋ: “Kǝ́ e le yee tuwǝ sa, wǝ́ a laa kʊʊ mǝ lé piyǝ sa ŋ ri lé piceŋceŋyǝ kǝto we, ŋ́ no tu mǝ wɛ, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />ŋ́ náa pɛɛrɩ lǝ́ ŋpa, ŋ́ nóo koonu kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ ŋpa mǝŋ wǝŋɔŋkpǝ rǝ yulaarǝ kǝtǝ amaa mǝŋ naŋrǝ rǝ apʊyǝ kǝlɛɛrɩkǝ kǝtǝ. Lǝ́ wǝmǝkpǝ wǝ láa lɔ pǝlǝ ǝkǝǝkpǝlǝtǝpǝ lǝ ǝtǝŋtǝǝyǝ pǝ kaa. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />Kǝ́ e le yee a la Saŋ rǝ mǝ tutɛŋwǝ kǝto we, ŋ́ náa pɛɛrɩ wǝkpǝŋkpǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ saŋ rǝ lǝ́ wǝmǝkpǝ.”»<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Wǝ́ Abǝrahamǝ ŋ sìɛnɩ ŋ pǝlǝ ŋ tùu na asʊmatǝpǝ we, wǝ́ pǝlo kpǝlo pǝ kpǝ̀lǝŋ pǝ ko ŋ ko Bɛrǝseba. Duturǝ ɖi Bɛrǝseba wǝ́ Abǝrahamǝ ŋ pǝlǝ ŋ tini wǝ.<verse eid="GEN 22:19" /></para>
  <para style="s">Nakɔrǝ le epipǝ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Rǝ otuyǝ sa la kǝmaakǝ we, wǝ́ pǝ pǝlǝ pǝ tìi Abǝrahamǝ ǝkǝnǝŋ Milǝka ŋwǝ ŋkpɛ lǝ mǝ ǝpǝrǝŋpipǝ lo koonu ŋwǝ Abǝrahamǝ la paanʊ Nakɔrǝ. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Mumuŋyǝ ŋ kaamǝ Usǝ. Na apaanʊpǝ pǝ kaamǝ: Buzǝ, Aramǝ lǝ tǝ Kemwɛlɩ, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />Kesɛɛdǝ, Azo, Pilǝdasǝ, Yilafǝ mǝ Betwɛlǝ. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betwɛlǝ ŋ mǝnǝ Rebeka. Ǝpǝrǝŋpipǝ we anɛŋ Milǝka ŋ mǝnǝ ŋ kòonu Abǝrahamǝ la paanʊ Nakɔrǝ wǝǝ. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Nakɔrǝ kǝ lǝǝmǝ tieyitǝyǝ rɛ, ŋwǝ ŋ ke ri Rewuma. Ŋwǝ ŋkpɛ mǝnǝ ǝpǝrǝŋpipǝ, ŋpǝ pǝ kaamǝ Teba, Gahamǝ, Tahasǝ mǝ Mahaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">Abǝrahamǝ lo fuu kǝtǝǝwǝ la ŋwaa Sara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Sara kùru lɔ̀ cɛŋwǝ tuuru mǝ tiyi mǝ pǝrɩmata. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Wǝ́ ŋ kpǝ̀ rǝ Kiriyatǝ Arǝba pǝ lǝ́ǝ tǝ pǝ ŋ pwo Hebǝrɔŋ rǝ Kanaŋ lǝ gǝŋrǝ. Wǝ́ Abǝrahamǝ ŋ weli ne tie Sara ŋpa, ŋ fìi gʊʊpirǝ.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Wǝ́ ŋ yili rǝ nyiǝtǝyǝ we lǝ kpǝŋ, wǝ́ ŋ kolu ŋ wɛ̀ɛlɩ mǝ Ehititǝpǝ. <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Sǝǝyǝ wǝ́ ŋ ri, wǝ́ ŋ kpii rǝ nǝ mǝrǝ. Nǝ dɔɔkpɛ nǝ siiri kǝtǝǝwǝ nǝ koonu mǝ rǝ nǝ kpǝŋ ŋ́ ŋwaa mǝ tie.» <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />Wǝ́ Ehititǝpǝ we pǝ tìi Abǝrahamǝ ǝkǝnǝŋ: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />«Dɔɔkpɛ, a la nyɩŋ, nyimumuŋyǝ rɛ Worokoyǝ ŋ na pɛɛrɩ wǝ́ e ri rǝ lǝh mǝrǝ. Ka ŋwaa lé tie rǝ lah wǝnyaŋceeceeceeceekpǝ lǝ mǝrǝ. Rɛ lee kpii rǝ lǝh mǝrǝ ŋ nah kʊʊ lǝ́ wǝnyaŋkpǝ<note caller="+" style="f"><char style="fr" closed="false">23:6 </char><char style="ft" closed="false">Eniyǝ we we, nyarǝ ri ŋ nyarǝ wǝ kǝ lǝǝmǝ wǝnyaŋkpǝ pǝ láa ŋwaa enyipǝ. Vǝ́ nyiyǝ lǝ kpǝ́ we, ǝ pǝ ŋ ka taanǝ kpǝ ŋwaa ŋwǝ ǝ pǝ ŋ tǝ pǝ taŋ kpǝ mǝ ɖurǝ.</char></note> a ŋwaa lé tie.» <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />Wǝ́ Abǝrahamǝ ŋ yili ŋ kʊnʊ Ehititǝpǝ we pǝ ke kpii rǝ gaarǝ we ŋ kpìi dɔɔkpɛɛrǝ. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nya nyɩŋ, mǝŋ nǝ nyáa tɛɛnɩ kǝceece ŋ́ ŋwaa mǝ tie rǝ fɛɛwǝ sa we, nǝ tɔɔ nǝ kpɛɛ Sowarǝ le pi Efǝrɔŋ nǝ koonu mǝ, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />kǝ ŋ nya fɛɛ ŋ fǝ na wǝnyaŋkpǝ we wǝ yaa rǝ na atɛɛkǝ we la kpaalǝwǝ rǝ Makpela ŋ siiri ŋ koonu mǝ rǝ wǝlo okurupoŋpiyǝ rǝ nǝ enimiyǝ. Eniyǝ we wǝ le yee mǝ wǝnɛŋ kǝ ŋ́ ŋwaa ŋwǝ rǝ we.» <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />Hititǝpiyǝ sa pǝ lóo pwo Efǝrɔŋ, ke tini rǝ fɛɛwǝ we kʊ̀la mǝ nǝ ǝtǝŋhititǝpǝ we pǝ kùu pǝ ke tini rǝ tǝŋtǝǝwǝ we lo guŋpolurǝ wǝ. Wǝ́ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ ŋ ke ŋ tíi Abǝrahamǝ kǝ pǝlo kpǝlo pǝ nya fɛɛ pǝ nuŋ ǝkǝnǝŋ: <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />«Kulǝtǝyǝ dɔɔkpɛ, ŋ́ nǝ fǝ wǝnyaŋkpǝ we wǝ yaa rǝ atɛɛkǝ we la kpaalǝwǝ mǝŋ atɛɛkǝ we ŋ́ na cɛɛ lǝ́ rǝ mǝ ǝtǝŋpǝ sa le enimiyǝ. O lóo koru a ka ŋwaa le tie rǝ we.» <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />Wǝ́ Abǝrahamǝ ŋ sʊ̀ʊ ŋ kʊnʊ kǝkpǝŋkǝ we rǝ gǝŋrǝ we. <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />Wǝ́ ŋ rɛ̀ɛrɩ mǝ kpɛɛwǝ kǝ enyikpǝlo pǝ nya fɛɛ pǝ nuŋ. Wǝ́ ŋ tìi Efǝrɔŋ ǝkǝnǝŋ: «A la nyɩŋ, dɔɔkpɛ ŋ́ nǝ pǝ́ ŋ́ mwara lǝ́ atɛɛkǝ we lo wǝtookpǝ. Lɔ sɩkayǝ sa kǝ ŋ́ nya fɛɛ ŋ́ ka ŋwaa mǝ tie.» <verse eid="GEN 23:13" /><verse number="14" style="v" sid="GEN 23:14" />Wǝ́ Efǝrɔŋ ŋ tìi Abǝrahamǝ ǝkǝnǝŋ: <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />«Kulǝtǝyǝ, dɔɔkpɛ, a la nyɩŋ, sɩkakpɛɛlɩyǝ sekɛlɩyǝ<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">Eniyǝ nɔ we, pǝ ke ŋ tie zɩkakʊʊrǝ pǝ ŋ fuu otuyǝ. Kǝto ŋrǝ zɩkakʊʊrǝ sa tuuruniǝ loh koru alɔ kiloyǝ niǝ mǝ afa. Ŋrǝ zɩkagʊʊrǝ sa wǝ́ pǝ ko ŋ pwo Sekɛlǝyǝ.</char></note> tuuruniǝ lǝ kǝtǝǝwǝ, wǝ leh yee kǝ́ rǝ ŋlǝ mǝ lǝ́ lǝ mǝrǝ? Mǝ ko a ka ŋwaa le tie rǝ!» <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />Wǝ́ Abǝrahamǝ ŋ tɛ̀ɛnɩ Efǝrɔŋ le dierǝ we. Wǝ́ ŋ tìe sɩkayǝ we Efǝrɔŋ ŋ tɛnɩ ŋ náa lɔ rǝ sǝkeliyǝ ŋ kòonu ŋwǝ rǝ Ehititǝpǝ la kǝnyɩŋkǝ, sɩkakpɛɛlɩyǝ sekɛlɩyǝ tuuruniǝ araasaŋtǝpǝ pǝ ke ŋ pi pǝ ŋ ri wǝ.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Fǝ ǝrǝ eniyǝ we wǝ́ Efǝrɔŋ la atɛɛkǝ we kǝ yaa rǝ Makpela, rǝ Mamǝre la kǝcɔkɔŋpoŋkǝ we, kǝ sìɛrɩ kǝ yeli Abǝrahamǝ la kǝnɛŋ mǝŋ wǝnyaŋkpǝ we wǝ ka yaa rǝ kǝ, mǝŋ eciiyǝ we kpǝlo kɩɩkɩ yǝ ke kpii rǝ atɛɛkǝ we mǝrǝ wǝ. <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />Ehititǝpǝ we kpǝlo kɩɩkɩ pǝ pǝlǝ tǝŋtǝǝwǝ we lo guŋpolurǝ pǝ ke ri tuwǝ sa la araŋsietǝpǝ. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Wǝ́ Abǝrahamǝ ŋ kolu ŋ ŋwàa ne tie rǝ wǝnyaŋkpǝ we wǝ kpii rǝ atɛɛkǝ we rǝ Makpela rǝ Mamǝre la kǝcɔkɔŋpoŋkǝ amaa Hebǝrɔŋ rǝ Kanaŋ lǝ gǝŋrǝ wǝ. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Wǝ́ Ehititǝpǝ pǝ tɛ̀ɛ akaa ǝkǝnǝŋ atɛɛkǝ we mǝ wǝnyaŋkpǝ we yǝ lo ru rǝ pǝla akaakǝ. Yǝ la siɛrɩ yǝ le yee Abǝrahamǝ la anɛŋ, ŋ nya mǝ ŋ ŋwaa ne enyipǝ.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">Abǝrahamǝ la lɔ tieyǝ lo koonu ne pi Isakǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Abǝrahamǝ kùru ŋpa. Ǝtǝ Woroko pɛ̀ɛrɩ ŋwǝ rǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Jirɛɛrǝ wǝ́ Abǝrahamǝ ŋ tìi na asʊmatǝpǝ lo mumuŋyǝ ŋ náa yɩrɩ no otulǝmǝyǝ lo yurǝ ǝkǝnǝŋ: «Dɔɔkpɛ kpii lá akaakǝ rǝ mǝ gbaakpaarǝ kǝnǝŋkǝ,<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">Rǝ Oyudatǝpǝ lǝ kpǝŋ we, mǝŋ pǝ le tíi rɛ ŋ kpii akaakǝ rǝ nyiyǝ la gbaakpaarǝ kǝnǝŋkǝ kǝ ŋ tu we, wǝ kpii kǝ yǝ we ŋ yee ŋ saŋ rǝ tuwǝ we ŋ no tu wǝ, mǝŋ ŋkǝ kaa wǝǝ we lǝŋ pǝ mǝ piyǝ rǝ na vɔrʊrǝ.</char></note> <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />kǝ o tu Ǝtǝ Woroko, oŋuŋkǝ mǝ kǝtǝǝwǝ lo Worokoyǝ ǝkǝnǝŋ ŋlǝ́ ǝ lǝŋ pǝ fǝ Kanaŋ lǝ gǝŋrǝ sa ŋ́ kpii le tieyǝ rɛ o koonu mǝ pi ŋ lɔ wǝtiekpǝ. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />O lóo ko mǝ gǝŋrǝ we ŋ́ no ru wǝ, kǝ ǝ kǝ fǝ tieyǝ rǝ mǝ otuulupǝ lǝ kpǝŋ o po koonu mǝ pi Isakǝ ŋ lɔ.» <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />Wǝ́ na sʊmatǝyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ayɩrɛ tieyǝ we lǝh kǝ sǝ́ŋ lǝŋ siimǝ mǝ ŋ pǝ sa. We ŋ́ re lé pi ŋ́ ko lǝ́ gǝŋrǝ we o lo ru wǝ?» <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />Wǝ́ Abǝrahamǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, pee ci kǝ e re mǝ piyǝ o ko fɛɛwǝ we oo! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Ǝtǝ Woroko, Worokoyǝ we ŋ tɛ rǝ oŋuŋkǝ we, la pɔrʊ mǝ lo ru rǝ mǝ tǝ la nyarǝwǝ, mǝ mǝ gǝŋrǝ. La wɛɛlɩ mǝ mǝ, wǝ́ ŋ no tu ŋ ne tíi mǝ ǝkǝnǝŋ ŋ nǝ́ǝ fǝ gǝŋrǝ sa ŋ koonu mǝ epilepipǝ. Ŋwǝŋwǝ lée kpii ne picoŋpiyǝ ŋ po coŋ mǝ lǝ́, kǝ a nya fɛɛ e ke re tieyǝ rǝ we o po koonu mǝ pi. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Mǝŋ tieyǝ we lǝŋ tɛɛnɩ ŋ siimǝ lǝ́ ŋ pǝ we, o lóo turu o lo ru rǝ wǝ. Paape we, pee ce e re mǝ pi o ko fɛɛwǝ we.» <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Wǝ́ kǝceece sʊmatǝyǝ sa ŋ kpìi akaakǝ rǝ no kulǝtǝyǝ Abǝrahamǝ la gbaakpaarǝ kǝnǝŋkǝ, wǝ́ ŋ tù ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ née yee ŋ́ saŋ rǝ tuwǝ we a la tɛŋ e le tíi mǝ wǝ.» <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />Wǝ́ ŋ fǝ̀ no kulǝtǝyǝ la akpɔŋkɔpǝ ǝtǝ, wǝ́ ŋ fǝ̀ no kulǝtǝyǝ lo otulǝmǝceeceeyǝ ŋ rè. Wǝ́ ŋ fǝ̀ gʊŋrǝ ŋ ko ŋ ko Nakɔrǝ lǝ tǝŋtǝǝwǝ rǝ Mezopotami lo kǝŋuŋsiɛɛkǝ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Kǝ́ ŋ no ko ro mɛŋfuŋwǝ we wǝ yaa rǝ tǝŋtǝǝwǝ we la kǝlɛɛrɩkǝ we, wǝ́ ŋ kòonu akpɔŋkɔpǝ we pǝ kpɛlɩ pǝ kaŋ wɛ̀ɛ rǝ we. Ɖiɔrǝ gǝ lǝǝwe, eniyǝ etiepǝ pǝ lǝ́ǝ pǝ pǝ ŋ tʊʊ mɛŋwǝ wǝ. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />Wǝ́ ŋ mwɛnɩ nyuŋkpǝ ǝkǝnǝŋ: «Ǝtǝ Woroko, mǝ kulǝtǝyǝ Abǝrahamǝ lo Worokoyǝ, dɔɔkpɛ koonu kǝ ŋ́ ca gbarǝsiɛrɩrǝ ruŋruŋ oo. Pɔrʊ lé wǝceeceekpǝ a kaŋ mǝ kulǝtǝyǝ Abǝramǝ. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />A lǝŋ nyɩŋ, ŋ́ yaa rǝ mɛŋfuŋwǝ sa la kǝlɛɛrɩkǝ. Tǝŋtǝǝwǝ sa la akɔrʊpǝ pǝ lǝh pǝ pǝ pa tʊʊ mɛŋwǝ. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Koonu kǝ gɔsɔkɔrʊpirǝ we ŋ́ neh tíi ǝkǝnǝŋ: “Dɔɔkpɛ, pɛɛlɩ lá bwɛŋpirǝ a maa mɛŋwǝ o koonu mǝ ŋ́ ŋuŋ oo.” Wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ: “Ŋuŋ! Vǝ́ a la lɛ ŋ́ náa tʊʊ ŋ koonu lá akpɔŋkɔpǝ sa ŋpǝ ŋkpɛ pǝ ŋuŋ we, ŋ́ née ci wǝ ǝkǝnǝŋ ŋwǝ wǝ́ a la saa a la pɔrʊ o koonu Isakǝ lá sʊmatǝyǝ.” Mǝŋkǝsa we, ŋ́ née ci wǝ ǝkǝnǝŋ a la pɔrʊ lé wǝceeceekpǝ a la kaŋ mǝ kulǝtǝyǝ.» <verse eid="GEN 24:14" /><verse number="15" style="v" sid="GEN 24:15" />Kǝ ŋ pǝ mǝŋ lɛ no nyuŋmwɛŋwǝ sa we, wǝ́ Betwɛlǝ la kɔrʊ Rebeka ŋ pǝlǝ ŋ ko ŋ ru mǝ na bwɛŋpirǝ rǝ goŋkoŋrǝ. Betwɛlǝ le lee ŋ kaamǝ Milǝka wǝ́ nǝ tǝ ŋ kaamǝ Abǝrahamǝ la paanʊ Nakɔrǝ. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Gɔsɔkɔrʊpikpatɩrǝ! Lee ci pǝrǝŋyǝ. Bǝlǝ dɛ̀lɩ zʊ̀ʊ mɛŋfuŋwǝ we golu dʊ̀ʊ mɛŋwǝ, wǝ́ ɖù ga ŋ rɛ. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />Wǝ́ Abǝrahamǝ la sʊmatǝyǝ we ŋ sùu ŋ kolu ŋ kù mǝ ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ, maa lá mɛŋwǝ sa tɩ o koonu mǝ ŋ́ ŋuŋ.» <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />Wǝ́ Rebeka ŋ yìili ǝkǝnǝŋ: «Keyi! Lɔ o ŋuŋ kulǝtǝyǝ!» Wǝ́ ŋ sʊ̀ʊrʊ bwɛŋpirǝ we kalaŋ ŋ tɛ̀ɛ rǝ kǝnukǝ ŋ kòonu ŋwǝ ŋ ŋuŋ. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Kǝ́ ŋ no koonu ŋwǝ ŋ no ŋuŋ ŋ na lɛ we, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ náa tʊʊ mɛŋwǝ ŋ́ koonu lá akpɔŋkɔpǝ sa ŋpǝ ŋkpɛ pǝ ŋuŋ kǝ wǝ yɔɔ pǝla kpɛɛ.» <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Kalaŋ wǝ́ ŋ tɛ̀ɛlɩ mɛŋwǝ we ŋ kpìi rǝ akɛɛpǝ la fɛɛŋuŋmɛŋwǝ. Wǝ́ ŋ tǝ ŋ sùu ŋ kolu ŋ tʊ̀ʊ mɛŋwǝ, wǝ́ ŋ tʊ̀ʊ ŋ kòonu akpɔŋkɔpǝ we kpǝlo kɩɩkɩ. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Wǝ́ kɛrɩyǝ we ŋ kpǝ́ ŋ yà ŋ ka ŋ yɩrɩ ŋwǝ lee tii na tǝrɛ. Wǝ́ ŋ kǝ ŋ pǝ́ na wɛ rǝ mǝrǝ ǝkǝnǝŋ: «Amaa Ǝtǝ Woroko lo kuŋ ŋ́ ca gbarǝsiɛrɩrǝ rǝ mǝ gʊŋrǝ sa?» <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />Kǝ́ akpɔŋkɔpǝ sa pǝ lo ŋuŋ mɛŋwǝ sa pǝ la lɛ we, wǝ́ kɛrɩyǝ sa ŋ fǝ̀ zɩkawarǝpirǝ rɛ mǝ sɩkawarǝwǝ yi, yǝ la lɔ okuruyǝ ŋpa ŋ kòonu ŋwǝ. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Wǝ́ kɛrɩyǝ sa ŋ kǝ ŋ pǝ́ kɔrʊyǝ sa ǝkǝnǝŋ: «Dɔɔkpɛ, ǝlǝ la kɔrʊyǝ wǝ́ e ri? Yǝ lóo koru a nya fɛɛwǝ la sʊʊrʊ rǝ lǝ́ tǝ la nyarǝwǝ?» <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />Wǝ́ Rebeka ŋ tìi ŋwǝ ǝkǝnǝŋ: «Betwɛlǝ le piyǝ wǝ́ ŋ́ ri. Milǝka mǝ Nakɔrǝ le pilepiyǝ wǝ́ ŋ ri.» <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Wǝ́ Rebeka ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Bɔɔrǝ<note caller="+" style="f"><char style="fr" closed="false">24:25 </char><char style="ft" closed="false">Keeriwǝ we sʊmatǝyǝ we la akpɔŋkɔpǝ pǝ láa nya pǝ ri wǝ́ Rebeka ŋ ke reemǝ.</char></note> gbɛlɩ lǝ ŋpa, wǝ́ yǝ la kpaalǝ eweyǝ yǝ lǝ tǝnǝ. Fɛɛwǝ wǝ kpii lǝ nǝ nyáa nya nǝ sʊʊrʊ.» <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />Wǝ́ kɛrɩyǝ sa ŋ sʊ̀ʊ ŋ kʊnʊ wǝ́ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ ŋ cèeni Ǝtǝ Woroko. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko le yeekǝ, mǝ kulǝtǝyǝ Abǝrahamǝ lo Worokoyǝ. Rǝ mǝ gʊŋsaŋrǝ sa we, la pɔrʊ ne wǝceeceekpǝ la kaŋ mǝ kulǝtǝyǝ. Ǝtǝ Woroko le re mǝ laa ǝrǝ mǝ kulǝtǝyǝ lo tuuluyǝ la nyarǝwǝ.» <verse eid="GEN 24:27" /><verse number="28" style="v" sid="GEN 24:28" />Wǝ́ kɔrʊyǝ sa ŋ sùu ŋ kolu ŋ fǝ̀ tuwǝ sa ŋ pɔ̀ ne lee la amayǝ. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Rebeka kǝ lǝǝmǝ paanʊyǝ rɛ pǝ lóo pwo Labaŋ. Wǝ́ Labaŋ ŋ yili pǝra ŋ sùu ŋ kolu ŋ tùu kɛrɩyǝ sa rǝ mɛŋfuŋwǝ we lǝ kpǝŋ. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Kǝ́ ŋ na nya ŋ na nyɩŋ na paatɛ ŋ ne kpii warǝpirǝ mǝ awarǝyǝ rǝ wǝnukpǝ, wǝ́ ŋ na lɛ ŋ no nuŋ Rebeka ŋ na tɛŋ etieyǝ we kɛrɩyǝ we ŋ ne tíi ŋwǝ ko we, wǝ́ ŋ kolu ŋ tùu kɛrɩyǝ sa yaa ŋpǝ mǝ na akpɔŋkɔpǝ rǝ mɛŋfuŋwǝ we la kǝlɛɛrɩkǝ. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Wǝ́ Labaŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ yǝ we Ǝtǝ Woroko ŋ na pɛɛrɩ wǝ, pǝ kǝ lo ko nyarǝwǝ. Nɛ kǝto wǝ́ a yaa rǝ koruwǝ, rǝ kǝ́ ŋ́ na kpaka nyarǝwǝ ŋ́ nǝ tǝnǝ lǝ́ wǝ? Wǝ́ ŋ́ no toolu fɛɛwǝ ŋ́ nǝ tǝnǝ lá akpɔŋkɔpǝ sa wǝ?» <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />Wǝ́ Abǝrahamǝ la sʊmatǝyǝ we ŋ tɛ̀ɛmǝ Labaŋ ŋ ko ŋ ko nyarǝwǝ. Kǝ́ pǝ le ke fii nyarǝwǝ we, wǝ́ pǝ wàla akpɔŋkɔpǝ we le eleeyǝ pǝ tǝ̀nǝ, wǝ́ pǝ kòonu pǝ la bɔɔrǝ mǝ eweyǝ pǝ la kpaalǝ pǝ lǝ tǝnǝ pǝ wolu. Wǝ́ pǝ kòonu Abǝrahamǝ la sʊmatǝyǝ mǝ enyipǝ we pǝ siimǝ ŋwǝ la mɛŋwǝ pǝ wɛɛ akparǝyǝ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Wǝ́ pǝ fǝ̀ keeriwǝ pǝ pǝlǝ pǝ kòonu pǝ. Paa wǝ́ Abǝrahamǝ la sʊmatǝyǝ sa ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ náa pɔ nǝ mǝ amayǝ ŋ́ lɛ kpɛŋ kǝ ŋ́ ci e ri.» Wǝ́ Labaŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ wɛɛlɩ!» <verse eid="GEN 24:33" /><verse number="34" style="v" sid="GEN 24:34" />Wǝ́ ŋ yìili ǝkǝnǝŋ: «Abǝrahamǝ la sʊmatǝyǝ wǝ́ ŋ́ ri. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Ǝtǝ Woroko la pɛɛrɩ mǝ kulǝtǝyǝ ŋpa, wǝ́ ŋ ne yee nyimumuŋyǝ rɛ kiŋtiŋ. Ǝtǝ Woroko lo koonu na amɛɛpǝ, epereceepǝ, anɛŋpǝ sɩkakpɛɛlɩyǝ mǝ sɩkamwɛɛrɩyǝ, asʊmatǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ, akpɔŋkɔpǝ mǝ orookɛtɛpǝ. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Ne tie Sara we, mǝŋ ne kǝtiekurukǝ paape lǝ mǝ bǝrǝŋpirǝ lo koonu ŋwǝ. Wǝ́ mǝ kulǝtǝyǝ ŋ nǝ fǝ no otulǝmǝyǝ kpǝlo kɩɩkɩ ŋ no koonu ŋwǝ. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Mǝ kulǝtǝyǝ tìi mǝ ǝkǝnǝŋ: “Tu e tíi mǝ ǝkǝnǝŋ ŋlǝ́ ǝ lǝŋ pǝ fǝ Kanaŋ lǝ gǝŋrǝ sa ŋ́ kpii le tieyǝ o koonu mǝ pi ŋ lɔ wǝtiekpǝ. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />O lóo ko mǝ enyipǝ lǝ kpǝŋ, rǝ mǝ tǝ la nyarǝwǝ, kǝ ǝ kǝ fǝ tieyǝ rǝ we o po koonu mǝ pi.” <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Wǝ́ ŋ́ yìili ŋ́ pǝ̀ ŋwǝ ǝkǝnǝŋ: “Wǝ́ mǝŋ tieyǝ we lǝ kǝ sǝ́ŋ nǝŋ siimǝ mǝ pa?” <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />Wǝ́ mǝ kulǝtǝyǝ ŋ tìi mǝ ǝkǝnǝŋ: “Ǝtǝ Woroko, yǝ we kǝnyɩŋkǝ ŋ́ ne re mǝ wɛ we, lée kpii ne picoŋpiyǝ ŋ coŋ mǝ lǝ́ ŋ ko. Lóo koonu kǝ a ca gbarǝsiɛrɩrǝ rǝ lá gʊŋrǝ sa. Ǝ lǝh kǝ fǝ tieyǝ rǝ mǝ gbǝŋrǝ lǝ kpǝŋ, rǝ mǝ tǝ la nyarǝwǝ o po koonu mǝ pi ŋ lɔ wǝtiekpǝ. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Mǝŋ o lo ko mǝ gbǝŋrǝ lǝ kpǝŋ wǝ́ e lee ce a ka nya tieyǝ rǝ we we, o lóo turu o lo ru rǝ wǝ. Mǝ vwɛɛrɩrǝ lǝŋ tǝ duu lǝ́.”» <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />Ruŋruŋ kǝ́ ŋ́ no po ro mɛŋfuŋwǝ sa we, wǝ́ ŋ́ na mwɛŋ nyuŋkpǝ sa ǝkǝnǝŋ: «Ǝtǝ Woroko, mǝ kulǝtǝyǝ Abǝrahamǝ lo Worokoyǝ, dɔɔkpɛ koonu kǝ ŋ́ ca gbarǝsiɛrɩrǝ rǝ mǝ gʊŋrǝ sa ŋ́ na saŋ wǝ. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Ŋ́ yaa rǝ mɛŋfuŋwǝ sa la kǝlɛɛrɩkǝ rǝkǝsa. Gɔsɔkɔrʊpirǝ we lǝh pǝ ba tʊʊ mɛŋwǝ we, ŋ́ náa ria ŋwǝ ŋ maa mɛŋwǝ tɩ rǝ na bwɛŋpirǝ ŋ koonu mǝ ŋ́ ŋuŋ. <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />Mǝŋ le tíi mǝ ǝkǝnǝŋ: “Ŋuŋ! Vǝ́ a la lɛ ŋ́ náa tʊʊ ŋ́ koonu lá akpɔŋkɔpǝ sa ŋpǝ ŋkpɛ pǝ ŋuŋ we, ŋwǝ ŋ ri tieyǝ we Ǝtǝ Woroko ŋ na pɔrʊ ŋ no koonu mǝ kulǝtǝyǝ le pi wǝ.” <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />Ŋ́ fee ce ŋ mwɛŋ nyuŋkpǝ sa ŋ́ lɛ rǝ mǝ mǝrǝ wǝ́ Rebeka ŋ nǝ pǝ ŋ noh ru mǝ na bwɛŋpirǝ rǝ goŋkoŋrǝ. Wǝ́ ŋ na sʊʊ ŋ na ka tʊʊ mɛŋwǝ. Wǝ́ ŋ́ ne tíi ŋwǝ ǝkǝnǝŋ: “Dɔɔkpɛ, maa mɛŋwǝ o koonu mǝ ŋ́ ŋuŋ.” <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Wǝ́ ŋ na pɛɛlɩ na bwɛŋpirǝ kalaŋ ŋ no koonu mǝ wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ: “Ŋuŋ! Vǝ́ a la lɛ, ŋ́ náa tʊʊ ŋ koonu lá akpɔŋkɔpǝ sa.” Wǝ́ ŋ́ no ŋuŋ, wǝ́ ŋ no koonu akpɔŋkɔpǝ we ŋpǝ ŋkpɛ pǝ lo ŋuŋ. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Wǝ́ ŋ́ nǝ pǝ́ ŋwǝ ǝlǝ la kɔrʊyǝ wǝ́ ŋ ri? Wǝ́ ŋ ne tíi mǝ ǝkǝnǝŋ: “Betwɛlǝ la kɔrʊyǝ wǝ́ ŋ́ ri, Milǝka mǝ Nakɔrǝ le pilepiyǝ.” Ko wǝ́ ŋ́ nǝ fǝ warǝpirǝ ŋ́ ne kpii ŋwǝ rǝ kǝŋwɛɛkǝ, wǝ́ ŋ́ ne kpii na awarǝyǝ rǝ wǝnukpǝ. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />Wǝ́ ŋ́ na sʊʊ ŋ́ na kʊŋ ŋ́ na tɔ kǝtukǝ rǝ kǝtǝǝwǝ ŋ́ na sʊma Ǝtǝ Woroko, wǝ́ ŋ́ ne ceeni Ǝtǝ Woroko, mǝ kulǝtǝyǝ Abǝrahamǝ lo Worokoyǝ we ŋ rè mǝ sɩsiɛrɩ rǝ mǝ gʊŋrǝ sa, kǝ ŋ́ nya fɛɛ ŋ́ pǝ fǝ mǝ kulǝtǝyǝ la paanʊ la kɔrʊyǝ ŋ po koonu mǝ kulǝtǝyǝ le piyǝ wǝ.» <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Rǝkǝsa nǝ tíi mǝ, nǝ nyée yee wǝceeceekpǝ sa nǝ koonu mǝ kulǝtǝyǝ kǝceece? Mǝŋ nǝ nyǝŋ yee wǝ we, nǝ tíi mǝ, kǝ ŋ́ nya fɛɛ ŋ́ mǝ ŋ ko fɛɛpʊŋpwawǝ. <verse eid="GEN 24:49" /><verse number="50" style="v" sid="GEN 24:50" />Wǝ́ Labaŋ mǝ Betwɛlǝ pǝ yìili pǝ tìi ŋwǝ ǝkǝnǝŋ: «Dierǝ lǝ ɖǝǝ we, lo ru rǝ Ǝtǝ Woroko lǝ kpǝŋ. Ŋlǝ we, yǝ lǝŋ koru etii lǝ́ ǝŋ amaa ow. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Rebeka ŋ yaa rǝ lá kǝnyɩŋkǝ ǝnǝ. Fǝ ŋwǝ o mǝ ko o ko koonu ló kulǝtǝyǝ le pi ŋ lɔ wǝtiekpǝ, mǝŋ kǝ́ Ǝtǝ Woroko ŋ na tɛŋ wǝ kǝtǝ.» <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />Kǝ́ Abǝrahamǝ la sʊmatǝyǝ sa ŋ no nuŋ etieyǝ sa we, wǝ́ ŋ kʊnʊ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ ŋ cèeni Ǝtǝ Woroko. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Wǝ́ Abǝrahamǝ la sʊmatǝyǝ sa ŋ pɔ̀rʊ asɩkakpɛɛlɩtuyǝ mǝ asɩkamwɛɛrɩtuyǝ mǝ wǝkpakpǝ ŋ kòonu Rebeka. Wǝ́ ŋ pɔ̀rʊ otuyǝ yǝ la lɔ okuruyǝ ŋpa ŋ cɛ̀ɛ Rebeka le mǝtee mǝ ne lee. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Wǝla kǝmaakǝ wǝ́ Abǝrahamǝ la sʊmatǝyǝ sa mǝ enyipǝ we pǝ ke siimǝ ŋwǝ pǝ ci erili wǝ́ pǝ ŋunu wǝ́ pǝ kolu pǝ kpɛlɩ. Gaalǝǝrǝkǝ lo ɖokoŋpirǝ kǝ́ pǝ le yi we, wǝ́ Abǝrahamǝ la sʊmatǝyǝ ŋ tìi Rebeka le mǝtee mǝ Rebeka le lee ǝkǝnǝŋ: «Nǝ co mǝ kʊŋ ŋ́ kpǝlǝŋ ŋ́ mǝ ŋ ko mǝ kulǝtǝyǝ lǝ kpǝŋ.» <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Rebeka lée ce ŋ tii rǝ lǝh kpǝŋ ko kuŋ eniyǝ rɛ mǝŋ wǝcuutǝkpǝ rɛ kpɛŋ kǝ ŋ ci apa pwɛyɩ mǝ ŋ ko.» <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />Wǝ́ sʊmatǝyǝ sa ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ paa lɔ mǝ nǝ tǝnǝ. Kǝ́ Ǝtǝ Woroko ŋ na nya ŋ no kuŋ ŋ́ na ca gbarǝsiɛrɩrǝ rǝ mǝ gʊŋrǝ sa we, nǝ maa mǝ ŋ́ kpǝlǝŋ mǝ ŋ ko mǝ kulǝtǝyǝ lǝ kpǝŋ.» <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />Wǝ́ pǝ yìili pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Kǝ lo pwo kɔrʊyǝ sa ŋwǝŋwǝ ŋ pǝ kǝ lǝ pǝ́ ŋwǝ lo nuŋ.» <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Wǝ́ pǝ pwò Rebeka ŋ pǝlǝ, wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ǝ lǝ́ǝ pǝ́ e siimǝ kɛrɩyǝ sa o mǝ ko?» Wǝ́ Rebeka ŋ tìi pǝ ǝkǝnǝŋ: «Ǝŋ, ŋ́ née siimǝ ŋwǝ.» <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />Wǝ́ pǝ cò pǝ la paatɛ Rebeka mǝ na zaŋsaŋkperepirǝ la kʊŋ pǝ ko ŋ ko mǝŋ Abǝrahamǝ la sʊmatǝyǝ sa mǝ epǝ we pǝ ke siimǝ ŋwǝ wǝ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Wǝ́ pǝ pɛ̀ɛrɩ Rebeka pǝ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 24:60">«Ŋlǝ́ lah paatɛ,</para>
  <para style="q1" vid="GEN 24:60">Worokoyǝ ŋ pɛɛrɩ lǝ́ kǝ ǝ mǝ wǝtirikpǝ mǝ wǝkpɛɛkpǝ!</para>
  <para style="q1" vid="GEN 24:60">Lǝ́ wǝmǝkpǝ</para>
  <para style="q1" vid="GEN 24:60">wǝ lɔ pǝlǝ ǝkǝǝkpǝlǝtǝpǝ lǝ ǝtǝŋtǝǝyǝ pǝ kaa!»<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Wǝ́ Rebeka mǝ na asʊmatǝkɔrʊpipǝ pǝ yili pǝ rɛ̀ pǝ tini rǝ akpɔŋkɔpǝ we, wǝ́ pǝ sìimǝ Abǝrahamǝ la sʊmatǝyǝ we pǝ ko ŋ ko. Wǝ́ Abǝrahamǝ la sʊmatǝyǝ we ŋ fǝ̀ Rebeka ŋ ko ŋ ko.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Eniyǝ we we, anyɩŋ Isakǝ le yi rǝ Lahayirɔyi la mɛŋfuŋwǝ we le pe tii rǝ Negɛvǝ la gaarǝ. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Ɖiɔrǝ rɛ we, wǝ́ Isakǝ ŋ rù ŋ sìri rǝ gaarǝ we ŋ ka ŋ tɛlɩ. Kpii lóo ko, kǝ́ ŋ ne pe ke yiili anyɩŋkǝ kǝtǝrǝceŋceŋ we, wǝ́ ŋ nyɩnɩ rǝ akpɔŋkɔpǝ pǝ lǝ́ǝ pǝ. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Kǝ́ Rebeka ŋ ne yiili anyɩŋkǝ we, wǝ́ ŋ nyɩnɩ Isakǝ, wǝ́ ŋ kpà ŋ yili rǝ kpɔŋkɔyǝ we ŋ pǝlǝ ŋ sʊ̀ʊ, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />Wǝ́ ŋ kǝ ŋ pǝ́ Abǝrahamǝ la sʊmatǝyǝ sa ǝkǝnǝŋ: «Pǝrǝŋyǝ rǝ fǝŋ ŋ́ na nyɩŋ ŋ sanǝ rǝ gborǝ ŋ nǝ́ǝ pǝ rǝ lǝh kpǝŋ ǝnǝ?» Wǝ́ Abǝrahamǝ la sʊmatǝyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ kulǝtǝyǝ ŋ lǝǝwe.» Wǝ́ Rebeka ŋ fǝ̀ na nyaŋrǝ ŋ sìi na anyɩŋkǝ. <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />Wǝ́ sʊmatǝyǝ sa ŋ fǝ̀ tu ri ŋ tu ŋ kolu ŋ yeli ŋ pɔ̀ Isakǝ la amayǝ. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Wǝ́ Isakǝ ŋ fǝ̀ Rebeka ŋ ko ŋ ko ne lee Sara le bwiirǝ we ŋ ke kpii wǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ lɔ̀, wǝ́ Rebeka ŋ sìɛrɩ ŋ yeli ne tieyǝ. Isakǝ ka ŋ taa Rebeka lǝ kǝǝwǝ, ŋ wǝ wǝ tà no turuwǝ rǝ ne lee lǝ ǝkpǝ́kǝ sa wǝ.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">Abǝrahamǝ lǝ ǝkpǝ́kǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Abǝrahamǝ tǝ lɔ̀ tiepʊŋpwayǝ rɛ, ŋwǝ ŋ ke ri Ketura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Wǝ́ tieyǝ sa ŋ mǝnǝ ǝpǝrǝŋpipǝ sa ŋ kòonu ŋwǝ: Zimǝraŋ, Yɔkǝsaŋ, Medaŋ, Madiaŋ, Isǝbakǝ mǝ Suwa. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Wǝ́ Yɔkǝsaŋ ŋ mǝnǝ ǝpǝrǝŋpipǝ: Saba mǝ Dedaŋ. Dedaŋ lǝ wǝmǝkpǝ wǝ ka kaamǝ Asuritǝpǝ, Eletusitǝpǝ mǝ Elewumitǝpǝ. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Madiaŋ le ǝpǝrǝŋpipǝ pǝ ka kaamǝ: Efa, Efɛrǝ, Hanɔkǝ, Abida mǝ Ɛlǝda. Ŋpǝ ǝpǝ kpǝlo kɩɩkɩ pǝ ke ri Ketura lǝ wǝmǝkpǝ.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Abǝrahamǝ fǝ̀ no otulǝmǝyǝ kpǝlo kɩɩkɩ kòonu Isakǝ <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Paa eniyǝ we ŋ kǝ tǝ ŋ kpii vɔrʊrǝ we, wǝ́ ŋ cɛ̀ɛ ne epwetaatiepǝ we lǝ ǝpǝrǝŋpipǝ lo otuyǝ rǝ. Wǝ́ ŋ cò pǝla kʊŋ pǝ pwɛ̀yɩ pǝ cɛ̀ ne pi Isakǝ pǝ ko ŋ ko ciriciri rǝ gǝŋrǝ rɛ gbii rǝ kǝcɔkɔŋpoŋkǝ la gaarǝ. <verse eid="GEN 25:6" /><verse number="7" style="v" sid="GEN 25:7" />Abǝrahamǝ lɔ̀ cɛŋwǝ tuuru mǝ tǝpǝrɩmata mǝ tʊʊ. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Wǝ́ ŋ kpǝ̀. Tini pànǝ wǝ́ ŋ kùru kɔfɩkɔfɩ kpɛŋ wǝ́ ŋ cìi ǝkpǝ́ ŋ kolu ŋ tùu omumuŋpǝ. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Wǝ́ nǝ ǝpǝrǝŋpipǝ Isakǝ mǝ Isǝmayɛlǝ pǝ ŋwàa ŋwǝ rǝ wǝnyaŋkpǝ we wǝ yaa rǝ Makpela, rǝ Sowarǝ le pi Efǝrɔŋ, Hititǝnyiyǝ we la atɛɛkǝ rǝ Mamǝre la kǝlɛɛrɩkǝ wǝ. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Abǝrahamǝ fùu atɛɛkǝ sa rǝ Hɛtǝ le epilepipǝ lǝ kpǝŋ. Wǝ́ pǝ ŋwàa ŋwǝ rǝ we ŋpǝ mǝ ne tie Sara. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Kǝ́ Abǝrahamǝ ŋ nǝ kpǝ́ la kǝmaakǝ we, wǝ́ Worokoyǝ ŋ pɛ̀ɛrɩ ne pi Isakǝ ŋ ke kpii rǝ Lahayirɔyi la mɛŋfuŋwǝ we kǝlɛɛrɩkǝ wǝ.<verse eid="GEN 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Isǝmayɛlǝ lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ. Abǝrahamǝ lǝ bǝrǝŋpirǝ gaamǝ Isǝmayɛlǝ. Agarǝ, Ejipǝtetǝtieyǝ sa ŋ ke ri Sara la rɔŋyǝ ŋ mǝnǝ ŋwǝ. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />Isǝmayɛlǝ lǝ ǝpǝrǝŋpipǝ la anyɩŋyǝ mǝŋ kǝ́ pǝ mǝnǝ pǝ pǝ tɛ̀ɛ rǝ awɛ we, yǝ kaamǝ ǝyǝ ǝnǝ: Nebayɔtǝ, Kedarǝ, Adǝbeyɛlɩ, Mibǝsamǝ, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />Misema, Duma, Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />Adadǝ, Tema, Yetu, Nafisǝ mǝ Kedǝma. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Ŋpǝ ǝpǝ pǝ ri Isǝmayɛlǝ lǝ ǝpǝrǝŋpipǝ we tǝ mǝ eyipǝ wǝ. Yǝ ŋ ri yǝ ke ri mumuŋyǝ kòonu na kǝsiɛrikǝ. Wǝ́ pǝ fǝ̀ pǝla anyɩŋyǝ pǝ kpìi pǝlǝ ǝtǝŋtǝǝyǝ mǝ pǝle wǝtiikpǝ la anyɩŋyǝ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Isǝmayɛlǝ kùru lɔ̀ cɛŋwǝ tuuru mǝ tǝta mǝ pǝrɩmata wǝ́ ŋ kpǝ̀ ŋ kolu ŋ tùu omumuŋpǝ. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Isǝmayɛlǝ lǝ wǝmǝkpǝ wǝ lɔ̀ gaarǝ we ga kpɛlɩ rǝ Avila mǝ Surǝ le kǝtiitiikǝ wǝ. Surǝ maarǝ mǝ Ejipǝte, rǝ kǝ́ wǝ loh ko rǝ Asurǝ la gaarǝ. Pǝ pɔ̀rʊ pǝla wɛ rǝ Abǝrahamǝ lǝ wǝmǝtuturukpǝ lǝ mǝrǝ pǝ kolu pǝ tini kpoo.<verse eid="GEN 25:18" /></para>
  <para style="s">Esawʊ mǝ Yakɔbǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Abǝrahamǝ le pi Isakǝ le dierǝ gaamǝ ɖǝ ǝnǝ. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Isakǝ lɔ̀ cɛŋwǝ tǝniǝ wǝ́ ŋ fǝ̀ Betwɛlǝ ŋ no ru rǝ Mezopotami la kɔrʊ Rebeka ŋ lɔ̀. Rebeka le mǝteeyǝ ŋ kaamǝ Labaŋ. Aramǝtǝpǝ wǝ́ Betwɛlǝ mǝ Labaŋ pǝ ri. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />Rebeka lǝǝ kǝ ŋ mǝ, wǝ kǝto Isakǝ ŋ mwɛnɩ nyuŋkpǝ ŋ kpìi Ǝtǝ Woroko la dɔɔkpɛɛrǝ ŋ kòonu ne tie wǝǝ. Wǝ́ Ǝtǝ Woroko ŋ nunu no nyuŋmwɛŋwǝ wǝ́ Rebeka ŋ rè wǝwɛɛpikulukpǝ. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Anyɩŋ epipǝ we pǝ kpii pǝ láa fia mǝ awɛ rǝ na lɛrǝ. Wǝ́ Rebeka ŋ kǝ ŋ pǝ́ na wɛ ǝkǝnǝŋ: «Kǝ́ lo tu wǝ ya wǝ lée yee mǝ ǝnǝ?» Wǝ́ ŋ kolu ŋ kǝ pǝ́ wǝ ŋ nuŋ rǝ Ǝtǝ Woroko lǝ kpǝŋ. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />Wǝ́ Ǝtǝ Woroko ŋ tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 25:23">«Wǝkpǝŋkpǝ wǝyi wǝ kpii rǝ lá lɛrǝ.</para>
  <para style="q1" vid="GEN 25:23">Wǝkpǝŋkpǝ wǝyi kpookpoo wǝ́ ǝ lǝh mǝ.</para>
  <para style="q1" vid="GEN 25:23">Ceŋceŋ láa lɛnyɩ ŋ teeri na kɛrɩyǝ.</para>
  <para style="q1" vid="GEN 25:23">Kǝ mumuŋyǝ ŋ pa sʊma pipiyǝ».<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Kǝ́ ne enimǝyǝ yǝ lo ro we, wǝ́ ŋ mǝnǝ awɛɛpipǝ kǝceece. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Sǝsǝŋyǝ we ŋ rù we, ka mwɛɛrɩ. Wǝ́ ŋ kǝ lǝǝmǝ ɖorǝ fʊcafʊca kǝ a tɛŋ kɛɛyǝ rɛ la fwɛɛwǝ wǝ́ pǝ lǝ fǝ pǝ le sii ŋwǝ. Wǝ́ pǝ kpìi na nyɩŋrǝ ǝkǝnǝŋ Esawʊ <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Wǝ́ yitǝyǝ ŋwǝ ŋkpɛ ŋ pǝlǝ ŋ rù, la ta Esawʊ la niɛtiŋtiŋrǝ re mǝ akaakǝ. Wǝ́ pǝ kpìi na nyɩŋrǝ Yakɔbǝ. Kǝ́ pǝ mǝnǝ epipǝ sa anyɩŋ Isakǝ la lɔ cɛŋwǝ tǝkʊraŋ.<verse eid="GEN 25:26" /></para>
  <para style="s">Esawʊ le siiri no kǝmumuŋkǝ lo koonu Yakɔbǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Wǝ́ epipǝ sa pǝ pǝlǝ pǝ nàanǝ. Esawʊ pǝlǝ yeli kpaŋyǝ, lée fii bɔɔrǝ eni ri ŋ ni. Yakɔbǝ ŋwǝ paa nyikpirikpiriyǝ ŋ kǝ lǝǝwe, eni ri ŋ ni anyɩŋ kpii rǝ epwiiyǝ. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Isakǝ ka ŋ taa rǝ Esawʊ lǝ kǝǝwǝ kpiikǝ láa taa kǝpɔɔkpaakakǝ kǝto. Rebeka ŋwǝ paa kaŋ taa rǝ Yakɔbǝ lǝ kǝǝwǝ.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Jirɛɛrǝ Yakɔbǝ yà ka ŋ caa keeriwǝ wǝ́ Esawʊ ŋ rù rǝ bɔɔrǝ ŋ pǝlǝ ŋ fìi, la faŋ ŋpa. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Wǝ́ ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «Ŋ́ nǝŋ tǝ ŋ́ koru. Maa lé keerimwɛɛrɩwǝ sa o koonu mǝ ŋ́ ri.» Wǝ kǝto pǝ kpìi Esawʊ la jɛnyɩŋrǝ ǝkǝnǝŋ Edɔmǝ, rǝlo duturǝ ɖi «Mǝmwɛɛrɩyǝ» <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />Wǝ́ Yakɔbǝ ŋ yìili ŋ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Siiri ló kǝmumuŋkǝ o koonu mǝ kpɛŋ.» <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />Wǝ́ Esawʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yɩrɩ re, ŋ́ nǝh kpǝ́ mǝ kǝtɛŋkǝ. Kǝ́ wǝ́ kǝmumuŋkǝ sa kǝ leh pe yee kǝ koonu mǝ?» <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tu e tíi mǝ kpɛŋ.» Wǝ́ Esawʊ ŋ tù ǝkǝnǝŋ ŋ ne siiri no kǝmumuŋkǝ ŋ no koonu ŋwǝ. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />Wǝ́ Yakɔbǝ ŋ kòonu Esawʊ la kpɔnɔyǝ mǝ zimwɛɛrɩrǝ lo oyupǝ. Wǝ́ Esawʊ ŋ rili wǝ́ ŋ ŋunu, wǝ́ ŋ yili ŋ pwɛ̀yɩ. Kǝ́ Esawʊ ŋ yeli wǝ́ ŋ nǝǝ fǝ no kǝmumuŋkǝ ŋ yee tǝrɛ wǝǝ.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">Isakǝ mǝ Abimelɛkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Kǝtɛŋkǝ kǝ rù rǝ gǝŋrǝ we, gǝ ǝnǝ kǝ la cɛkɛlɛ<note caller="+" style="f"><char style="fr" closed="false">26:1 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ: «Kǝtɛŋkǝ kǝ rù rǝ gǝŋrǝ we fǝ kʊla mǝ kǝsǝsǝŋkǝ we kǝ rù mǝ Abǝrahamǝ le diirǝ wǝ».</char></note> mǝ gǝ we kǝ rù mǝ Abǝrahamǝ le diirǝ wǝ. Wǝ́ Isakǝ ŋ pwɛ̀yɩ ŋ ko ŋ ko Efilisitǝpǝ le piliyǝ Abimelɛkǝ lǝ kpǝŋ rǝ Gerarǝ. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Ǝtǝ Woroko pɔ̀rʊ na wɛ kanǝ Isakǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo ko Ejipǝte, mǝ ko e ke tii rǝ gǝŋrǝ we ŋ́ nah kaŋ lǝ́ e tii wǝ. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ce e tii rǝ gǝŋrǝ sa, ŋ́ née kpii ŋ́ kʊla mǝ lǝ́ kǝ ŋ́ pɛɛrɩ lǝ́. Ŋ́ nǝ́ǝ fǝ ǝkǝtǝǝyǝ sa ŋ koonu lǝ́, ŋnǝ mǝ lǝ́ wǝmǝkpǝ. Mǝŋkǝsa we, tuwǝ we la garǝ ŋ́ cò lǝ́ tǝ Abǝrahamǝ we, o lóo turu ŋ́ ne yee wǝ. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ŋ́ nóo kuŋ kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ mǝŋ wǝŋɔŋkpǝ rǝ yulaarǝ kǝtǝ, ŋ́ nǝ́ǝ fǝ ǝkǝtǝǝyǝ sa kpǝlo kɩɩkɩ ŋ́ koonu pǝ. Ŋ́ náa pɛɛrɩ wǝkpǝŋkpǝ kpǝlo kɩɩkɩ rǝ ǝrǝkǝ ŋ́ saŋ rǝ lǝ́ wǝmǝkpǝ. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />Kpiikǝ Abǝrahamǝ lo co kǝtukoŋkǝ rǝ mǝ wǝ́ ŋ ne yee ŋ na saŋ rǝ mǝ tutɛŋwǝ, mǝ ǝkpǝlǝyǝ mǝ mǝ esepǝ».<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Wǝ́ Isakǝ ŋ kolu ŋ tini rǝ Gerarǝ. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />Vǝ́ enyipǝ pǝ lǝ pǝ́ ne etieyǝ pǝ lo ru rǝ ne tie lo oŋuŋkǝ we, ŋ tíi pǝ ǝkǝnǝŋ: «Mǝ paatɛ ŋ lǝǝwe.» Loo ko ŋ tu turuwǝ mǝ ŋ tɛŋ ǝkǝnǝŋ Rebeka ri ne tieyǝ. Ko ŋ suu vurǝ ǝkǝnǝŋ enyipǝ sa pǝ lah pa wʊ ŋwǝ rǝ Rebeka lo yurǝ duturǝ ɖi Rebeka ko ponu ŋpa.<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Isakǝ ke kpii rǝ fɛɛwǝ we wǝ panǝ ŋpa. Wǝ́ jirɛɛrǝ Efilisitǝpǝ le piliyǝ Abimelɛkǝ ŋ ka ŋ yɩrɩ rǝ fasǝrɛyǝ, wǝ́ ŋ nyɩnɩ kǝ́ Isakǝ ŋ ya ŋ náa wʊrʊ mǝ ne tie Rebeka wǝ. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Wǝ́ Abimelɛkǝ ŋ pwò Isakǝ ŋ pǝlǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝceece le tie ŋ lǝǝwe! Kǝ́ kǝto wǝ́ a ka ŋ tɛŋ ǝkǝnǝŋ lá paatɛyǝ ŋ lǝǝwe wǝ?» Wǝ́ Isakǝ ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ tɛnɩ wǝ ǝnǝ duturǝ ɖi ŋ́ ko ŋ suu vurǝ pǝ lah pa wʊ mǝ rǝ no yurǝ kǝto.» <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />Wǝ́ Abimelɛkǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ lo tu wǝ́ e le yee mǝ lǝ ǝnǝ? Wǝ lo tuuru rǝ tɩ, mǝ kǝkpǝŋkǝ sa la rɛ kah kpɛɛ mǝ le tie, kǝ ǝ kǝ fǝ bɔtɔɔrǝ o koonu lǝ!»<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Rǝ kɔɔwe wǝ́ Abimelɛkǝ ŋ ke ŋ kpii seyǝ mǝ ŋ koonu nǝ kǝkpǝŋkǝ we ǝkǝnǝŋ: «Yǝ we ŋ nóo tu turuwǝ ŋ ruu nyiyǝ sa amaa ne tie we, pǝ láa wʊ yǝ we taa».<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Cɛŋwǝ we, wǝ́ Isakǝ ŋ kpɛnɩ atɛɛkǝ rǝ gǝŋrǝ we. Wǝ́ na atɛɛtɛɛtuyǝ yǝ nyɩnɩ ŋpa duturǝ ɖi Ǝtǝ Woroko ka ŋ pɛɛrɩ ŋwǝ. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Wǝ́ ŋ nyà na wɛ. Wǝ́ no otulǝmǝyǝ yǝ ka ŋ ta yǝ ŋ kʊla rǝ ko, wǝ́ ŋ pǝlǝ ŋ nyà na wɛ ŋpa. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Kǝ lǝ̀ǝmǝ amɛɛpǝ, epereceepǝ mǝ anɛŋpǝ wǝ́ ŋ ka lɛ ŋ lǝ̀ǝmǝ asʊmatǝpǝ kǝkpǝŋkǝ. Wǝ́ wǝ pǝlǝ wǝ ka ŋ mwɛɛrɩ Efilisitǝpǝ le nimirǝ.<verse eid="GEN 26:14" /></para>
  <para style="s">Isakǝ mǝ Abimelɛkǝ pǝ la parǝ dierǝ pǝ lǝ tǝnǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 26:15" />Kǝ́ Isakǝ lǝ tǝ Abǝrahamǝ ŋ ke kpii vɔrʊrǝ we, wǝ́ na asʊmatǝpǝ pǝ nyini amɛŋfuŋyǝ. Wǝ́ Efilisitǝpǝ pǝ kolu pǝ nyini kǝnyaanǝkǝ pǝ lǝ̀ǝrǝ amɛŋfuŋyǝ we kpǝlo kɩɩkɩ. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />Wǝ́ Abimelɛkǝ ŋ tìi Isakǝ ǝkǝnǝŋ: «A la pa nya okopiyǝ e le teeri lǝ kururu. Pwɛyɩ rǝ fɛɛwǝ sa!»<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Wǝ́ Isakǝ ŋ yili ŋ pwɛ̀yɩ rǝ we. Wǝ́ ŋ kolu ŋ tɔ̀ ne epwiiyǝ rǝ Gera la gbɛnɛŋrǝ we. Fɛɛwǝ ŋ kolu ŋ tini wǝǝ. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Wǝ́ Isakǝ ŋ kpǝ̀lǝŋ ŋ nyini amɛŋfuŋyǝ we pǝ nyini rǝ nǝ tǝ Abǝrahamǝ le diirǝ ǝkǝ Efilisitǝpǝ pǝ pǝlǝ pǝ nǝ̀ǝnǝ kǝ́ Abǝrahamǝ ŋ nǝ kpǝ́ la kǝmaakǝ wǝ. Wǝ́ Isakǝ ŋ fǝ̀ anyɩŋyǝ we nǝ tǝ ŋ kpìi yǝ we, ŋ tǝ ŋ kpìi yǝ.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Wǝ́ jirɛɛrǝ Isakǝ la asʊmatǝpǝ pǝ nyini mɛŋfuŋwǝ rɛ rǝ gbɛnɛŋrǝ we wǝ́ pǝ kolu pǝ rù rǝ mɛŋmumuŋwǝ rɛ. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Wǝ́ Egeratǝpǝ la akɛɛrǝŋtǝpǝ pǝ pǝlǝ pǝ ke ŋ yee etieyǝ mǝ Isakǝ la akɛɛrǝŋtǝpǝ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Mɛŋwǝ sa wǝ ri lah nɛŋ.» Wǝ́ Isakǝ ŋ ko ŋ pwo mɛŋfuŋwǝ sa ǝkǝnǝŋ Esɛkǝ, wǝlo duturǝ ɖi akpaŋyǝ, kpiikǝ Egeratǝpǝ la akɛɛrǝŋtǝpǝ we pǝ tàa na akpaŋyǝ rǝ. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Wǝ́ Isakǝ la asʊmatǝpǝ pǝ tǝ pǝ kolu pǝ nyini mɛŋfuŋpʊŋpwawǝ rɛ wǝ́ wǝkpaŋkpǝ wǝ tǝ wǝ pǝlǝ. Wǝ́ Isakǝ ŋ ko ŋ pwo mɛŋfuŋwǝ sa ǝkǝnǝŋ Sitǝna, wǝlo duturǝ ɖi kǝǝkpǝlǝwǝ. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Wǝ́ ŋ tǝ ŋ pwɛ̀yɩ rǝ we ŋ kolu ŋ nyini mɛŋfuŋpʊŋpwawǝ. Wǝkpaŋkpǝ rɛ wǝ lǝǝ tǝ wǝ pǝ rǝ wǝ ǝnǝ. Wǝ́ Isakǝ ŋ ko ŋ pwo wǝ ǝkǝnǝŋ Rewobɔtǝ, wǝlo duturǝ ɖi ayɔkɔɔkpiikǝ, duturǝ ɖi kaŋ tɛŋ ǝkǝnǝŋ: «Rǝkǝsa we, Ǝtǝ Woroko lo koonu lǝ fɛɛwǝ nyiyǝ rɛ nǝŋ kpii awɛɛlɩkǝ, kǝ la nya fɛɛ la nya lah wɛ rǝ gǝŋrǝ sa!»<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Wǝ́ ŋ yili rǝ we ŋ ko ŋ ko Bɛrǝseba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Jirǝ we ŋ yili ŋ pwɛ̀yɩ ŋ ko ŋ ko lo dumurǝ wǝ́ Ǝtǝ Woroko ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri lǝ́ tǝ Abǝrahamǝ lo Worokoyǝ. Poo suu vurǝ. Duturǝ ɖi ŋ́ kpii ŋ́ kʊla mǝ lǝ́. Ŋ́ náa pɛɛrɩ lǝ́. Ŋ́ nóo kuŋ kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ rǝ mǝ sʊmatǝyǝ Abǝrahamǝ lo yurǝ kǝto.» <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />Wǝ́ Isakǝ ŋ tɔ̀ otoolucuukǝ rǝ fɛɛwǝ we, wǝ́ ŋ ka ŋ mwɛŋ nyuŋkpǝ mǝ ŋ pwo Ǝtǝ Woroko la nyɩŋrǝ. Wǝ́ ŋ tɔ̀ epwiiyǝ rǝ fɛɛwǝ we wǝ́ na asʊmatǝpǝ pǝ tǝ pǝ nyini mɛŋfuŋpʊŋpwawǝ.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Wǝ́ Abimelɛkǝ ŋ rù rǝ Gera ŋ pa nyɩŋ Isakǝ, ŋpǝ mǝ ne pwetaa Awuzatǝ mǝ na kɔŋtǝpiliyǝ Pikɔlʊ. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Wǝ́ Isakǝ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nyǝ pǝ nǝ pa nyɩŋ mǝ wǝ? Ŋkǝ ŋnǝ nǝ nyǝ́ǝ kpǝlǝ mǝ kǝǝwǝ, wǝ́ nǝ nye piri mǝ rǝ nǝ kpǝŋ?» <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Rǝkǝsa yǝ la nyɩŋ wǝ yǝ le ci sɩsiɛrɩ ǝkǝnǝŋ Ǝtǝ Woroko kpii kʊla mǝ lǝ́. Fɛɛwǝ yǝ la tɛŋ ǝkǝnǝŋ wǝ kpii kǝ ŋlǝ mǝ lǝ́ lo tu le kpii awɛ dɔɔkpɛ, kǝ la parǝ dierǝ lǝ tǝnǝ mǝ lǝ́. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />Tu e tíi lǝ ǝkǝnǝŋ ŋlǝ́ e lǝŋ pe yee mǝ lǝ́ turɔɔrɔɔwǝ rɛ. Duturǝ ɖi yǝ lee yee mǝ lǝ́ turɔɔrɔɔwǝ rɛ. Wǝceeceekpǝ sɔŋ wǝ́ yǝ le yee lǝ́, wǝ́ yǝ la lɛ yǝ la maa lǝ́ a la pwɛyɩ mǝ wǝtaarǝkpǝ. Rǝkǝsa e ri rǝ Ǝtǝ Woroko le nyipɛɛrɩyǝ!»<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Wǝ́ Isakǝ ŋ càa keerimumuŋwǝ rɛ ŋ lɔ̀ pǝ. Wǝ́ pǝ rili wǝ́ pǝ ŋunu. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Gaalǝǝrǝkǝ wǝ́ pǝ yili mǝ ɖokoŋpirǝ ŋalaŋala wǝ́ pǝ tù pǝ kpìi awɛ. Wǝ́ Isakǝ ŋ cò pǝla kʊŋ, wǝ́ pǝ pwɛ̀yɩ rǝ nǝ kpǝŋ pǝ ko ŋ ko mǝ wǝtaarǝkpǝ.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Jirǝ we jirǝ we, wǝ́ Isakǝ la asʊmatǝpǝ pǝ pǝlǝ pǝ ko ŋ co tɛɛrɩwǝ pǝ ŋ tíi ŋwǝ ru rǝ mɛŋfuŋwǝ rɛ pǝ ya pǝ lée nyiŋ wǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la ka nya mɛŋwǝ.» <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Wǝ́ Isakǝ ŋ kpìi mɛŋfuŋwǝ sa la nyɩŋrǝ ǝkǝnǝŋ Siba, wǝlo duturǝ ɖi Otukǝ, wǝ kǝto pǝ ko ŋ pwo tǝŋtǝǝwǝ sa po ro ruŋruŋ ǝkǝnǝŋ Bɛrǝseba. Wǝlo duturǝ ɖi Otukǝ la mɛŋfuŋwǝ.<verse eid="GEN 26:33" /></para>
  <para style="s">Esawʊ le dielɔrǝ</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Kǝ́ Esawʊ ŋ na lɔ cɛŋwǝ tǝniǝ we, wǝ́ ŋ fǝ̀ Ehititǝtiepǝ eyi ŋ lɔ̀. Beri la kɔrʊ Yewuditǝ mǝ Elɔŋ la kɔrʊ Basǝmatǝ. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Etiepǝ sa pǝ kòonu vɔrʊrǝ bìa mǝ Isakǝ mǝ Rebeka.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">Yakɔbǝ la lɔ Esawʊ la wǝpɛɛrɩkpǝ le yee na wǝnɛŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Isakǝ pǝlǝ kùru, anyɩŋ ne enimiyǝ yǝ la faŋ, lǝǝ tǝ ka ŋ nyɩŋ. Wǝ́ ŋ pwò ne pimumuŋyǝ Esawʊ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pi!» Wǝ́ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ.» <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />Wǝ́ Isakǝ ŋ yìili ǝkǝnǝŋ: «A ya láa nyɩŋ, ŋ́ no kuru wǝ́ ŋ́ nee ci mǝ jikpǝ́rǝ. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Rǝkǝsa we, dɔɔkpɛ fǝ lá akɔŋtuyǝ, lé kǝteŋteŋkǝ mǝ lá dɛnɩfɔrǝ kǝ e fii bɔɔrǝ. Ka wʊ kǝpɔɔkpaakakǝ o po koonu mǝ. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Kǝ a caa keeriwǝ o koonu mǝ mǝŋ kǝ́ ŋ́ náa taa wǝ. Kǝ ǝ fǝ wǝ o po koonu mǝ ŋ́ ri, kǝ ŋ́ pɛɛrɩ lǝ́ kpɛŋ kǝ ŋ́ ci ǝ pǝ kpǝ́.» <verse eid="GEN 27:4" /><verse number="5" style="v" sid="GEN 27:5" />Keci Rebeka yà ko ŋ nuŋ kǝ́ Isakǝ ŋ ka ŋ wɛɛlɩ mǝ ne pi Esawʊ wǝ. Kǝ́ Esawʊ ŋ na pwɛyɩ ŋ na tɛlɩ bɔɔrǝ ŋ ka taa kǝpɔɔkpaakakǝ ŋ re ŋ pǝ we, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />wǝ́ Rebeka ŋ tìi ne pi Yakɔbǝ ǝkǝnǝŋ: «Ŋ́ no nuŋ lǝ́ tǝ ya lée tíi lé mǝtee Esawʊ ǝkǝnǝŋ: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />“Taa kǝpɔɔkpaakakǝ o po koonu mǝ, kǝ a caa keericeeceewǝ rɛ o koonu mǝ ŋ́ ri, kǝ ŋ́ pɛɛrɩ lǝ́ rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ kpɛŋ kǝ ŋ́ ci ǝkpǝ́.” <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Rǝkǝsa we, mǝ pi, co kǝtukoŋkǝ rǝ mǝ kpǝŋ kǝ e yee tuwǝ sa ŋ́ nah tɛŋ ŋ́ tíi lǝ́ wǝ. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Mǝ ko akɛɛpǝ we lǝ́ mǝrǝ kǝ a ka lɔ epereceepipǝ eyi pǝ ponu o po koonu mǝ ŋ́ caa keericeeceewǝ rɛ ŋ́ koonu lǝ́ tǝ, mǝŋ kǝ́ ŋ náa taa wǝ. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Kǝ ǝ fǝ wǝ o ko koonu lǝ́ tǝ, eniyǝ we le ri wǝ kǝ ŋ nya fɛɛ ŋ pɛɛrɩ lǝ́ kpɛŋ kǝ ŋ ci ǝkpǝ́!»<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Wǝ́ Yakɔbǝ ŋ yìili ŋ tìi ne lee Rebeka ǝkǝnǝŋ: «Paa mǝ mǝtee Esawʊ ri nyiyǝ ŋ lǝǝmǝ ɖorǝ fʊcafʊca. Ŋmǝ paa ŋ́ nǝǝ lǝmǝ ɖorǝ. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ayɩrɛ mǝ tǝ loh ko ruu mǝ ŋ yɩrɩ. Láa nyɩŋ wǝ ŋ ci ǝkǝnǝŋ ŋ́ nǝ pǝ ŋ́ pǝ tǝǝnǝ ŋwǝ rǝ. O lóo turu ŋ́ no pwo vwɛɛrɩrǝ ŋ́ na tɛ rǝ mǝ wɛ, wǝ lǝŋ tǝ wǝ ri wǝpɛɛrɩkpǝ.» <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />Wǝ́ ne lee ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pi, ŋ́ na lɔ lá vwɛɛrɩrǝ sa ŋ́ na tɛ rǝ mǝ wɛ! Ŋlǝ́ co kǝtukoŋkǝ rǝ mǝ kpǝŋ rǝ, kǝ o ko a ka lɔ pǝ o po koonu mǝ.» <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />Wǝ́ Yakɔbǝ ŋ kolu ŋ lɔ̀ epereceepipǝ we ŋ pǝlǝ ŋ kòonu ne lee ŋ càa keericeeceewǝ mǝŋ kǝ́ nǝ tǝ ŋ náa taa wǝ. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Wǝ́ Rebeka ŋ pɔ̀rʊ ne pimumuŋyǝ Esawʊ la wǝkpakpǝ we wǝ ka kpɛlɩ rǝ nǝ kpǝŋ rǝ nyarǝwǝ le wǝceeceekpǝ ŋ kpìi Yakɔbǝ, ne pipipiyǝ we. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Wǝ́ ŋ fǝ̀ epereceepipǝ we la afwɛɛyǝ ŋ mìli Yakɔbǝ lo wǝnukpǝ mǝ ne dǝreerǝ la gaarǝ we lǝ kpʊlʊkpʊlʊ wǝ. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Wǝ́ ŋ fǝ̀ keericeeceewǝ we ŋ na caa, mǝ kpɔnɔyǝ ŋ kpìi ne pi Yakɔbǝ rǝ akaakǝ. <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />Wǝ́ Yakɔbǝ ŋ fìi ŋ kolu ŋ tùu nǝ tǝ. Wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Mǝ tǝ!» Wǝ́ ŋ yɩ̀rɩ ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ. Ŋlǝ́ mǝ piyǝ rǝ fǝŋ ǝ lǝǝwe?» <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />Wǝ́ Yakɔbǝ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Ŋmǝ Esawʊ lé pimumuŋyǝ ŋ́ lǝǝwe. Ŋ́ ne ke yee mǝŋ kǝ́ e le tíi mǝ kǝtǝ. Dɔɔkpɛ, yi e pe tii, kǝ o wo mǝ kǝpɔɔkpaakakǝ sa, kǝ a nya fɛɛ a pɛɛrɩ mǝ ŋlǝ́ŋlǝ́.» <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />Wǝ́ Isakǝ ŋ yìili ŋ pǝ̀ ne pi ǝkǝnǝŋ: «Mǝ pi, wǝ le yee nɛ wǝ́ ǝ lǝ fǝǝlǝ anya kǝpɔɔkpaakakǝ ǝnǝ?» Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ǝtǝ Woroko, ló Worokoyǝ ŋ no koonu ŋ́ na ca gbarǝsiɛrɩrǝ sa.» <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />Wǝ́ Isakǝ ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «Mǝ pi, ruu ǝ kǝlǝ mǝ mǝ, kǝ ŋ́ ruu lǝ́ ŋ́ yɩrɩ mǝŋ kǝceece ŋlǝ́ e ri mǝ pi Esawʊ amaa ŋkǝ ŋlǝ́?» <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />Wǝ́ Yakɔbǝ ŋ rùu ŋ kǝ̀lǝ mǝ nǝ tǝ Isakǝ. Wǝ́ Isakǝ ŋ rùu ŋwǝ ŋ yɩ̀rɩ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kpɛɛwǝ sa we, Yakɔbǝ la kpɛɛwǝ wǝ lǝǝwe, paa wǝkaakpǝ sa we, Esawʊ la wǝkaakpǝ wǝ lǝǝwe.» <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Isakǝ laa nyɩŋ ŋwǝ ŋ ci, duturǝ ɖi no wǝnukpǝ wǝ kǝ lǝ̀ǝmǝ ɖorǝ fʊcafʊca kǝ a tɛŋ rǝ ne mǝtee Esawʊ lo wǝnukpǝ, wǝ́ ŋ pɛ̀ɛrɩ ŋwǝ. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />Wǝ́ Isakǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝto kǝceece ŋlǝ́ mǝ pi Esawʊ ǝ lǝǝwe?» Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Awo, ŋmǝ ŋ́ lǝǝwe».<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Wǝ́ Isakǝ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Mǝ pi, ruu keeriwǝ sa ǝ kǝlǝ mǝ mǝ, kǝ ŋ́ wo lá kǝpɔɔkpaakakǝ sa, kǝ ŋ́ nya fɛɛ ŋ́ pɛɛrɩ lǝ́ ŋmǝŋmǝ.» Wǝ́ Yakɔbǝ ŋ fǝ̀ keeriwǝ sa ŋ pǝlǝ ŋ kòonu ŋwǝ, wǝ́ ŋ rili. Wǝ́ ŋ fǝ̀ vɛŋyǝ ŋ pǝlǝ ŋ kòonu ŋwǝ, wǝ́ ŋ ŋunu. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Wǝ́ nǝ tǝ Isakǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pi, ruu ǝ kǝlǝ mǝ mǝ, kǝ a pala mǝ!» <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />Wǝ́ Yakɔbǝ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ, wǝ́ ŋ pàla ŋwǝ. Wǝ́ Isakǝ ŋ ŋwɛ̀nɩ Yakɔbǝ la wǝkpakpǝ ŋ yɩ̀rɩ, wǝ́ ŋ pɛ̀ɛrɩ ŋwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ǝŋ! Mǝ pi la jwɩɩrǝ lǝ rǝ mǝŋ atɛɛkǝ Ǝtǝ Woroko ŋ na pɛɛrɩ la jwɩɩrǝ kǝtǝ.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />“Worokoyǝ ŋ koonu kǝ yulaarǝ la mɛŋrǝ jo goonu lǝ́,</para>
  <para style="q1" vid="GEN 27:28">ŋ koonu lǝ́ ǝkǝtǝǝceeceeyǝ.</para>
  <para style="q1" vid="GEN 27:28">Ŋ koonu lǝ́ bǝleyǝ mǝ vɛŋŋwɛŋyǝ ŋpa.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Wǝkpǝŋkpǝ wǝ sʊma lǝ́,</para>
  <para style="q1" vid="GEN 27:29">kǝ ǝkǝŋyǝ yǝ pa pɛɛlɩ yǝ koonu lǝ́!</para>
  <para style="q1" vid="GEN 27:29">E lée ri lá apaanʊpǝ lo kulǝtǝyǝ,</para>
  <para style="q1" vid="GEN 27:29">kǝ lé lee le epipǝ pǝ pa pɛɛlɩ pǝ koonu lǝ́!</para>
  <para style="q1" vid="GEN 27:29">Yǝ we ŋ náa fwɛɛrɩ lǝ́ we, Worokoyǝ láa fwɛɛrɩ ŋwǝ!</para>
  <para style="q1" vid="GEN 27:29">Yǝ we ŋ náa pɛɛrɩ lǝ́ we, Worokoyǝ láa pɛɛrɩ ŋwǝ!”»<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Kǝ́ Isakǝ ŋ na pɛɛrɩ Yakɔbǝ ŋ na lɛ ko we, wǝ́ Yakɔbǝ ŋ rù. Mǝŋ apwɛyɩ rǝ nǝ tǝ lǝ kpǝŋ eni we, wǝ́ Esawʊ ŋ rù fɛɛfǝŋwǝ ŋ pǝlǝ ŋ ke ŋ fii. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Wǝ́ ŋwǝ ŋkpɛ ŋ càa keericeeceewǝ rɛ ŋ pǝlǝ ŋ kòonu nǝ tǝ. Wǝ́ Esawʊ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Mǝ tǝ, yi kǝ o wo lé pi la kǝpɔɔkpaakakǝ we, kǝ a nya fɛɛ a pɛɛrɩ mǝ ŋlǝ́ŋlǝ́.» <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />Wǝ́ nǝ tǝ Isakǝ ŋ yìili ŋ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Ŋlǝ́ ǝlǝ ǝ lǝǝwe?» Wǝ́ Esawʊ ŋ yìili ǝkǝnǝŋ: «Ŋmǝ Esawʊ, lé pimumuŋyǝ ŋ́ lǝǝwe.» <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />Isakǝ lóo yo yaya! Wǝ́ ŋ yìili ǝkǝnǝŋ: «Wǝ́ ǝlǝ ŋ nǝ kǝ fǝŋ, wǝ́ ŋ no po koonu mǝ kǝpɔɔkpaakakǝ wǝ? Ŋ́ no wo kǝ kɩɩkɩ kpɛŋ wǝ́ e lée ci efii. Kǝ́ ŋ́ na pɛɛrɩ ŋwǝ ko, wǝpɛɛrɩkpǝ we wǝ ri na wǝnɛŋ rǝ!»<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Kǝ́ Esawʊ ŋ no nuŋ nǝ tǝ le etieyǝ sa we, wǝ́ wǝ fìi ŋwǝ, wǝ́ ŋ cà narǝwǝ kǝŋkǝŋ ŋ yà ŋ ke ŋ wee. Wǝ́ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Ao mǝ tǝ! Pɛɛrɩ mǝ ŋmǝ ŋkpɛ oo!» <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />Wǝ́ Isakǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá paanʊ lǝ pǝ tǝǝnǝ mǝ wǝ́ ŋ na lɔ lá wǝpɛɛrɩkpǝ.» <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />Wǝ́ Esawʊ ŋ tɛnɩ ǝkǝnǝŋ: «Amaa kǝ́ pǝ lóo pwo ŋwǝ Yakɔbǝ, yǝ we ŋ née sisi enyipǝ kǝto wǝ́ ŋ ne sisi mǝ pǝrǝŋwǝ kǝyi wǝ? La ta mǝ kǝmumuŋkǝ la lɔ rǝ mǝ. A lǝŋ nyɩŋ kǝ́ rǝkǝsa ŋ na ta mǝ wǝpɛɛrɩkpǝ ŋ na lɔ wǝ! Kǝto o loo tuuru wǝpɛɛrɩkpǝ rɛ ǝ tǝnǝ mǝ?» <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />Wǝ́ Isakǝ ŋ yìili ŋ tìi Esawʊ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, ŋ́ nǝ fǝ ŋwǝ ŋ́ ne yee ló kulǝtǝyǝ. Wǝ́ ŋ́ nǝ fǝ na apaanʊpǝ kpǝlo kɩɩkɩ ŋ́ ne yee na asʊmatǝpǝ. Ŋ́ no koonu ne bǝleyǝ mǝ vɛŋŋwɛŋyǝ. Mǝ pi, kǝ́ wǝ́ ŋ́ nǝh tǝ ŋ́ koru eyee ŋ́ koonu lǝ́?» <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />Wǝ́ Esawʊ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Mǝ tǝ, we wǝpɛɛrɩkpǝ sa wǝceŋceŋ ko wǝ́ ǝ lǝǝmǝ? Pɛɛrɩ mǝ ŋmǝ ŋkpɛ oo!» Wǝ́ Esawʊ ŋ sìe narǝwǝ kǝŋkǝŋ ŋ yà ŋ ke ŋ wee. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />Wǝ́ nǝ tǝ Isakǝ ŋ tìi ŋwǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 27:39">«A lǝŋ nyɩŋ, lé kǝtiikǝ kǝ lǝ́ǝ lǝǝrǝ mǝ ǝkǝtǝǝceeceeyǝ,</para>
  <para style="q1" vid="GEN 27:39">kǝ kǝ lɛ kǝ lǝǝrǝ mǝ yulaarǝ la mɛŋrǝ.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Lá tʊkʊwǝ wǝ lóo koonu lǝ́ e tii vɔrʊrǝ.</para>
  <para style="q1" vid="GEN 27:40">A lah mǝ sʊma lá paanʊ</para>
  <para style="q1" vid="GEN 27:40">wǝ́ rǝ ló ocotɛlɩkǝ we, o loh po ru rǝ nǝ kǝnǝŋkǝ!»<verse eid="GEN 27:40" /></para>
  <para style="s">Yakɔbǝ lo suu la tɛlɩ nǝ kpǝǝtǝ Labaŋ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Wǝ́ Esawʊ ŋ kpǝ̀lǝ Yakɔbǝ lǝ kǝǝwǝ rǝ wǝpɛɛrɩkpǝ we ŋ lɔ̀ rǝ nǝ tǝ kǝto. Wǝ́ ŋ tɛnɩ rǝ nǝ mǝrǝ ǝkǝnǝŋ: «Mǝ tǝ lǝh kpǝ́ rǝ wǝǝ. Eniyǝ we ŋ́ nóo koru awʊ mǝ paanʊ Yakɔbǝ.» <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />Wǝ́ pǝ kolu pǝ sìe Rebeka la fʊrʊwǝ kǝ́ ne pimumuŋyǝ Esawʊ ŋ ya ŋ nǝ́ǝ kǝ tǝrɛ wǝǝ. Wǝ́ Rebeka ŋ kpìi pǝ kolu pǝ pwò Yakɔbǝ ne pipipiyǝ we. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, lé mǝtee Esawʊ ya lǝ́ǝ pǝ́ ŋ wʊ lǝ́ ŋ ca kpawǝ. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Rǝkǝsa we, mǝ pi co kǝtukoŋkǝ rǝ mǝ kpǝŋ, yi! Suu o mǝ ko mǝ mǝtee Labaŋ lǝ kpǝŋ rǝ Haraŋ. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ke ce e tii rǝ nǝ kpǝŋ ko ro eniyǝ we lé mǝtee la kpɛɛmʊrʊwǝ wǝ láa taarǝ ŋwǝ wǝ. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Vǝ́ lé mǝtee la kpɛɛmʊrʊwǝ ŋ nǝ fǝ ŋ na tɛ rǝ lǝ́ wǝ la taarǝ ŋwǝ wǝ́ ŋ no yuu tuwǝ sa e le yee mǝ ŋwǝ la kpɛɛ we, ŋ́ née kpii pǝ pa taa lǝ́ rǝ fɛɛwǝ we. Mǝ epipǝ eyi pǝ lǝŋ kpǝ́ pǝ maa mǝ jiceŋceŋ! Nɛ kǝto?»<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Wǝ́ Rebeka ŋ tìi Isakǝ ǝkǝnǝŋ: «Vɔrʊrǝ la pia mǝ mǝ rǝ Hɛtǝ la akɔrʊpǝ sa kǝto. Mǝŋ Yakɔbǝ ŋwǝ ŋkpɛ la pa lɔ Hɛtǝ la akɔrʊpǝ sa pǝ kpii rǝ gǝŋrǝ sa la rɛ mǝŋ ǝpǝ ǝnǝ kǝtǝ we, we ŋ́ nǝ́ǝ kpǝ́, wǝ ponu wǝ teeri!»<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Wǝ́ Isakǝ ŋ pwò Yakɔbǝ ŋ pǝlǝ, wǝ́ ŋ pɛ̀ɛrɩ ŋwǝ. Wǝ́ ŋ kpìi seyǝ ŋ kòonu ŋwǝ ǝkǝnǝŋ: «Pǝǝ fǝ Kanaŋtǝkɔrʊyǝ rɛ a lɔ. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Yi! Mǝ ko lé lee lǝ tǝ Betwɛlǝ lǝ kpǝŋ rǝ Padaŋ Aramǝ, kǝ fǝ lǝ́ kpǝǝtǝ Labaŋ la akɔrʊpǝ we la rɛ a lɔ rǝ fɛɛwǝ we.<verse eid="GEN 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 28:3" />Worokokopilǝtǝyǝ ŋ pɛɛrɩ lǝ́, ŋ koonu lǝ́ ǝ mǝ, kǝ ŋ koonu lé epipǝ pǝ yaarǝ,</para>
  <para style="q1" vid="GEN 28:3">kǝ a nya fɛɛ e ri wǝkpǝŋkpǝ lǝ tǝtǝyǝ!<verse eid="GEN 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 28:4" />Ŋ fǝ Abǝrahamǝ la wǝpɛɛrɩkpǝ we lǝ kǝtǝŋkǝ ŋ koonu lǝ́,</para>
  <para style="q1" vid="GEN 28:4">ŋnǝ mǝ lǝ́ wǝmǝkpǝ,</para>
  <para style="q1" vid="GEN 28:4">kǝ gǝŋrǝ sa e ce e kpii we,</para>
  <para style="q1" vid="GEN 28:4">gǝŋrǝ sa ŋ fǝ̀ ŋ kòonu Abǝrahamǝ we nya fɛɛ yee lá nɛŋ.» <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Wǝ́ Isakǝ ŋ cò Yakɔbǝ la kʊŋ mǝ ŋ ko Aramǝtǝnyiyǝ sa pǝ lóo pwo Betwɛlǝ le pi Labaŋ lǝ kpǝŋ rǝ Padaŋ Aramǝ. Rebeka le mǝtee ŋ kaamǝ Labaŋ. Esawʊ mǝ Yakɔbǝ le lee ǝrǝ Rebeka.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Wǝ́ Esawʊ ŋ pǝlǝ ŋ nyɩnɩ tuwǝ sa ŋ cìi ǝkǝnǝŋ Isakǝ la pɛɛrɩ Yakɔbǝ wǝ́ ŋ no co na kʊŋ mǝ ŋ ko Padaŋ Aramǝ kǝ ŋ kǝ fǝ tieyǝ rǝ we ŋ lɔ. Kǝ́ ŋ ya ŋ náa pɛɛrɩ ŋwǝ we, wǝ́ ŋ kpìi seyǝ ŋ kòonu ŋwǝ ǝkǝnǝŋ: «Pǝǝ fǝ Kanaŋtǝkɔrʊyǝ rɛ a lɔ.» <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />Wǝ́ Yakɔbǝ ŋ nunu nǝ tǝ mǝ ne lee lo tutɛŋwǝ wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko Padaŋ Aramǝ. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Wǝ́ Esawʊ ŋ nyɩnɩ tuwǝ sa ŋ cìi ǝkǝnǝŋ Akanaŋtǝkɔrʊpǝ lo tuwǝ wǝ loo poŋ mǝ nǝ tǝ Isakǝ. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />Wǝ́ Esawʊ ŋ kolu ŋ nyɩnɩ Isǝmayɛlǝ. Wǝ́ ŋ fǝ̀ Mahalatǝ ŋ lɔ̀ ŋ kʊ̀la mǝ ne etiepǝ. Abǝrahamǝ le piyǝ ŋ kaamǝ Isǝmayɛlǝ. Isǝmayɛlǝ la kɔrʊyǝ ŋ kaamǝ Mahalatǝ, Nebayɔtǝ la paatɛyǝ ŋ lǝǝwe.<verse eid="GEN 28:9" /></para>
  <para style="s">Yakɔbǝ la kpɛɛ kǝtʊkpɛɛkǝ rɛ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Wǝ́ Yakɔbǝ ŋ rù rǝ Bɛrǝseba ŋ ko ŋ ko Haraŋ. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Kǝ́ ŋ no ko ro fɛɛwǝ rɛ we, o turu cɔkɔŋyǝ la tɔɔ. Wǝ́ ŋ ka ŋ kpɛɛ rǝ fɛɛwǝ we. Wǝ́ ŋ fǝ̀ ɖurǝ rɛ rǝ fɛɛwǝ we ŋ tɛ̀ɛ yurǝ wǝ́ ŋ sʊ̀ʊ ŋ kpɛlɩ rǝ we. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Wǝ́ ŋ kpɛlɩ kǝtʊkpɛɛkǝ rɛ. Wǝ́ ŋ nyɩnɩ akpayǝ rɛ yǝ tɔ̀ rǝ kǝtǝǝwǝ, wǝ́ yǝle nyiŋwǝ wǝ kolu wǝ yɔ̀ɔ yulaarǝ. Worokoyǝ le epicoŋpipǝ pǝ láa rɛ pǝ láa sʊʊ rǝ yǝ. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Wǝ́ Ǝtǝ Woroko ŋ pǝlǝ ŋ yàa rǝ Yakɔbǝ la kǝlɛɛrɩkǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Ǝtǝ Woroko, lǝ́ tǝtǝ Abǝrahamǝ lo Worokoyǝ mǝ lǝ́ tǝ Isakǝ lo Worokoyǝ! Kǝtǝǝwǝ sa a kpɛlɩ we, ŋ́ nǝh pǝ fǝ wǝ ŋ koonu ŋnǝ mǝ lǝ́ wǝmǝkpǝ. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Lǝ́ wǝmǝkpǝ wǝ lah pa naanǝ kpǝŋwǝ mǝŋ guŋkuŋrǝ rǝ kǝtǝǝwǝ kǝtǝ. Nǝ nyáa yɔkɔ nǝ kpii rǝ kǝcɔkɔŋtɔɔkǝ, rǝ kǝcɔkɔŋpoŋkǝ, rǝ kǝŋuŋsiɛɛkǝ mǝ kǝpɔɔlʊsiɛɛkǝ. Ŋ́ náa pɛɛrɩ wǝkpǝŋkpǝ kpǝlo rǝ kǝtǝǝwǝ saŋ rǝ ŋnǝ mǝ lǝ́ wǝmǝkpǝ. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Yɩrɩ re! Ŋ́ kpii ŋ kʊla mǝ lǝ́. Fɛɛ ri ŋ fɛɛ o lóo ko we, ŋ́ nǝ́ǝ kǝrǝŋ lǝ́. Ŋ́ nah pa siɛnɩ mǝ lǝ́ ŋ́ pǝ kǝtǝǝwǝ sa. Ŋ́ nǝŋ pa nyarǝ lǝ́ ŋ́ co, ko ro eniyǝ we ŋ́ ne yee otuyǝ we kpǝlo kɩɩkɩ ŋ́ no co lǝ́ garǝ wǝ.» <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />Wǝ́ Yakɔbǝ ŋ sàanǝ rǝ ne eniŋrieyǝ sa, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝceece, Ǝtǝ Woroko kpii rǝ fɛɛwǝ sa! Wǝ́ ŋmǝ paa ŋ́ nee ke ci wǝ.» <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Wǝ́ vurǝ vìi ŋwǝ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Fɛɛwǝ sa wǝ lóo co vurǝ we! Kǝceece Worokoyǝ la nyarǝwǝ wǝ lǝǝwe. Yulaarǝ lo guŋpolurǝ lǝǝwe!» <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />Wǝ́ Yakɔbǝ ŋ yili mǝ ɖokoŋpirǝ ŋalaŋala, wǝ́ ŋ fǝ̀ ɖurǝ we ŋ na tɛ yurǝ we, ŋ tɔ̀. Wǝ́ ŋ cò apɔŋpǝ ŋ fìeni ɖurǝ sa. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Wǝ́ Yakɔbǝ ŋ pwò fɛɛwǝ sa ǝkǝnǝŋ Bɛtɛlǝ, wǝlo duturǝ ɖi Worokoyǝ la nyarǝwǝ. Paa pǝ kǝ ŋ sǝŋ pwo tǝŋtǝǝwǝ sa ǝkǝnǝŋ Lusǝ. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />Wǝ́ Yakɔbǝ ŋ yɩ̀rɩ gɔrǝ sa ǝkǝnǝŋ: «Mǝŋ Worokoyǝ la kʊla mǝ mǝ, wǝ́ ŋ nǝ kǝrǝŋ mǝ rǝ mǝ gʊŋrǝ sa ŋ́ kpii ŋ́ nóo ko, wǝ́ ŋ no koonu mǝ keeriwǝ ŋ́ ne ri, mǝ wǝkpakpǝ ŋ́ ne kpii we, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />mǝŋ ŋ́ na siɛnɩ ŋ́ nǝ pǝ mǝ tǝ la nyarǝwǝ purupuru we, we Ǝtǝ Woroko lée ri mǝ Worokoyǝ. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Ɖurǝ sa ŋ́ na tɔ we, ŋ́ ne tiini rǝ. Lée ri Worokoyǝ la nyarǝwǝ. Wǝ́ tu ri ŋ tu o loh ko koonu mǝ we, ŋ́ nǝ́ǝ fǝ wǝlǝ tǝtǝwǝ ŋ po koonu lǝ́.»<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">Yakɔbǝ lo ku mǝ Labaŋ la kɔrʊ Rasiɛlǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Wǝ́ Yakɔbǝ ŋ tǝ ŋ yili ŋ fǝ̀ kʊŋwǝ. Wǝ́ ŋ ko ŋ ko enyipǝ we pǝ kpii rǝ kǝcɔkɔŋpoŋkǝ lǝ gǝŋrǝ. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Kǝtǝrǝceŋceŋ wǝ́ ŋ nyɩnɩ mɛŋfuŋwǝ rɛ rǝ gborǝ we, wǝ́ ŋ nyɩnɩ mɛɛkpǝŋwǝ ta. Pǝ kpɛlɩ rǝ mɛŋfuŋwǝ we la kǝlɛɛrɩkǝ, duturǝ ɖi pǝ kǝ ŋ pǝ pǝ ŋ koonu pǝla mɛŋwǝ pǝ ŋ ŋuŋ rǝ fɛɛwǝ we. Pǝ fǝ̀ ɖumumuŋrǝ rɛ pǝ sìi mɛŋfuŋwǝ sa lo nyuŋkpǝ. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Vǝ́ amɛɛkpǝŋyǝ we kpǝlo kɩɩkɩ yǝ lo po ku yǝ la lɛ we, ǝ pǝ ŋ pǝǝlǝ ɖurǝ we pǝ cɛ rǝ mɛŋfuŋwǝ we, o pǝ ŋ koonu pǝla mɛŋwǝ pǝ ŋuŋ. Vǝ́ pǝ lo koonu akɛɛpǝ we la mɛŋwǝ pǝ lo ŋuŋ pǝ la lɛ we, ǝ pǝ ŋ tǝ pǝ pǝǝlǝ ɖurǝ we pǝ sii mɛŋfuŋwǝ we. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />Wǝ́ Yakɔbǝ ŋ pǝ̀ amɛɛrǝŋtǝpǝ we ǝkǝnǝŋ: «Lǝh ǝtǝŋ, nǝ nyo ru rǝ fǝŋ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lo ru rǝ Haraŋ.» <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ cii Nakɔrǝ le pi Labaŋ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ǝŋ, le cii ŋwǝ.» <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />Wǝ́ ŋ tǝ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kpii sɩsiɛrɩ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ǝŋ, kpii sɩsiɛrɩ. A lǝŋ nyɩŋ, na kɔrʊ Rasiɛlǝ ŋ nǝ́ǝ pǝ mǝ amɛɛpǝ ǝnǝ.» <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />Wǝ́ Yakɔbǝ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Nǝ yɩrɩ re, jɔkɔŋrǝ wǝ́ le kpii ǝnǝ, ŋkǝ eniyǝ pǝ lóo ko mǝ akɛɛpǝ rǝ deerǝ wǝǝ. Nǝ koonu amɛɛpǝ sa la mɛŋwǝ pǝ ŋuŋ kǝ nǝ siɛnɩ mǝ pǝ nǝ ko fɛɛwowǝ.» <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lǝŋ koru wǝ le eyee ǝnǝ. We amɛɛkpǝŋyǝ we kpǝlo kɩɩkɩ yǝ lo po ku yǝ la lɛ. Eniyǝ we yǝ lóo koru ǝpǝǝlǝ ɖurǝ we la cɛ rǝ mɛŋfuŋwǝ sa, kǝ lo koonu amɛɛpǝ sa la mɛŋwǝ pǝ ŋuŋ.»<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Yakɔbǝ tǝ yà ka ŋ wɛɛlɩ mǝ enyipǝ we wǝ́ Rasiɛlǝ ŋ pǝlǝ ŋ ko ŋ ru mǝ nǝ tǝ la mɛɛkpǝŋwǝ, duturǝ ɖi mɛɛrǝŋtǝyǝ wǝ́ ŋ ke ri. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kǝ́ Yakɔbǝ ŋ na nyɩŋ nǝ kpǝǝtǝ Labaŋ la kɔrʊ Rasiɛlǝ mǝ nǝ kpǝǝtǝ Labaŋ la amɛɛpǝ we, wǝ́ ŋ rùu ŋ ko ŋ ko, wǝ́ ŋ pǝ̀ǝlǝ ɖurǝ we ŋ cɛ̀ rǝ mɛŋfuŋwǝ we lo nyuŋkpǝ. Wǝ́ ŋ kòonu nǝ kpǝǝtǝ Labaŋ la amɛɛpǝ la mɛŋwǝ pǝ ŋunu. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Wǝ́ Yakɔbǝ ŋ kolu ŋ pùru Rasiɛlǝ ŋ rè, wǝ́ ŋ sìe narǝwǝ ŋ yà ŋ ke ŋ wee. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Kǝ́ Yakɔbǝ ŋ na pɔrʊ ŋ ne tíi Rasiɛlǝ ǝkǝnǝŋ ŋwǝ ŋ ri nǝ tǝ lo tuuluyǝ mǝ Rebeka le piyǝ we, wǝ́ Rasiɛlǝ ŋ sùu ŋ kolu ŋ tìi nǝ tǝ lo tuwǝ sa. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />Kǝ́ Labaŋ ŋ no nuŋ nǝ kpǝrǝ Yakɔbǝ la nyɩŋrǝ we, wǝ́ ŋ sùu ŋ ko ŋ ko ŋ ko ku mǝ ŋwǝ. Wǝ́ ŋ pùru ŋwǝ, wǝ́ ŋ pàla ŋwǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ ko ŋ ko nyarǝwǝ. Wǝ́ Yakɔbǝ ŋ fǝ̀ etieyǝ we kpǝlo kɩɩkɩ ŋ pɔ̀ Labaŋ la amayǝ. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Wǝ́ Labaŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝceece mǝ piyǝ pʊrɩpʊrɩ wǝ́ e ri.» Wǝ́ Yakɔbǝ ŋ tini Labaŋ lǝ kpǝŋ kɛɛnyɔŋyǝ milimili.<verse eid="GEN 29:14" /></para>
  <para style="s">Yakɔbǝ la sʊma Labaŋ, wǝ́ ŋ nǝ fǝ Leya mǝ Rasiɛlǝ ŋ na lɔ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />Wǝ́ jirɛɛrǝ Labaŋ ŋ pǝlǝ ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «Kpawǝ we le ri otuulupǝ kǝto kǝ a sʊma mǝ o co rǝ? Tii mǝ wǝtookpǝ we a láa lɔ wǝ.»<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Labaŋ kǝ lǝǝmǝ akɔrʊpǝ eyi. Mumuŋyǝ ŋ ke ri Leya, wǝ́ pipiyǝ ŋ ke ri Rasiɛlǝ. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Leya le enimiyǝ yǝ kǝ lǝ tɛlɛŋ<note caller="+" style="f"><char style="fr" closed="false">29:17 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ Leya le enimiyǝ yǝ ko ponu.</char></note>, paa Rasiɛlǝ we, ko ŋ poŋ ayɩrɩ ŋpa. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Yakɔbǝ ka ŋ taa Rasiɛlǝ lǝ kǝǝwǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ náa sʊma lǝ́ cɛŋwǝ pǝrɩmata kǝ ǝ fǝ lá kɔrʊpipi Rasiɛlǝ o koonu mǝ.» <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />Wǝ́ Labaŋ ŋ yìili ǝkǝnǝŋ: «Mǝŋ ŋ́ nǝ fǝ ŋwǝ ŋ́ no koonu lǝ́ we, wǝ ponu mǝ mǝ wǝ teeri kǝ́ ŋ́ nǝh fǝ ŋwǝ ŋ koonu nyipʊŋpwayǝ rɛ. Tii rǝ mǝ kpǝŋ.» <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Wǝ́ Yakɔbǝ ŋ sʊ̀ma Labaŋ cɛŋwǝ pǝrɩmata kǝ ŋ lɔ Rasiɛlǝ. Paape acɛŋyǝ sa yǝ kǝ lǝ rǝ mǝŋ ecipiyǝ rɛ yǝ kòonu Yakɔbǝ, kpiikǝ ka ŋ taa Rasiɛlǝ lǝ kǝǝwǝ ŋpa kǝto. <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />Wǝ́ Yakɔbǝ ŋ tìi Labaŋ ǝkǝnǝŋ: «Fǝ mǝ tieyǝ o koonu mǝ. Eniyǝ yǝ lo ro kǝ ŋ́ toomu mǝ ŋwǝ.»<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Wǝ́ Labaŋ ŋ pwòlu fɛɛwǝ we le enyipǝ kpǝlo kɩɩkɩ ŋ pǝlǝ. Wǝ́ ŋ càa keerimumuŋwǝ rɛ pǝ rili wǝcɛkpǝ. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Ɖiɔrǝ we, wǝ́ Labaŋ ŋ fǝ̀ na kɔrʊ Leya ŋ kolu ŋ kòonu Yakɔbǝ, wǝ́ ŋ kpɛlɩ mǝ ŋwǝ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Wǝ́ Labaŋ ŋ fǝ̀ na sʊmatǝtieyǝ we pǝ lóo pwo Zilǝpa ŋ kòonu na kɔrʊ Leya, kǝ ŋ yee na sʊmatǝtieyǝ. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Kǝ́ kǝ la kaalǝ we, wǝ́ ŋ nyɩnɩ rǝ Leya! Wǝ́ Yakɔbǝ ŋ pǝ̀ Labaŋ ǝkǝnǝŋ: «Kǝ́ wǝ́ e le yee mǝ mǝ ǝnǝ? Mǝŋkǝ ŋ́ na sʊma lǝ́ kǝ ŋ́ lɔ Rasiɛlǝ rǝ? Kǝ́ kǝto wǝ́ ǝ lǝ tǝǝnǝ mǝ wǝ?» <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />Wǝ́ Labaŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Rǝ lǝh kpǝŋ we, rɛ lǝŋ yee wǝ ǝnǝ, rɛ lǝŋ koonu kɔrʊpipiyǝ lo wǝnuŋkpǝ ŋ coŋ ŋ koonu kɔrʊmumuŋyǝ. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Rǝkǝsa we, ka lɛ atiɛŋwɛŋciyǝ sa apǝrɩmata mǝ mumuŋyǝ sa kpɛŋ, kǝ ǝ tǝ a sʊma mǝ cɛŋwǝ pǝrɩmata kǝ lǝ fǝ pipiyǝ sa ŋwǝ ŋkpɛ lo koonu lǝ́.» <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />Wǝ́ Yakɔbǝ ŋ tɛ̀ɛnɩ Labaŋ le dierǝ we. Wǝ́ ŋ lɛ̀ atiɛŋwɛŋciyǝ we apǝrɩmatayǝ mǝ Leya. Wǝ́ Labaŋ ŋ fǝ̀ na kɔrʊ Rasiɛlǝ ŋ kòonu Yakɔbǝ ŋ lɔ̀. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Wǝ́ Labaŋ ŋ fǝ̀ na sʊmatǝtieyǝ we pǝ lóo pwo Bila ŋ kòonu na kɔrʊ Rasiɛlǝ, kǝ ŋ yee na sʊmatǝtieyǝ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Wǝ́ Yakɔbǝ ŋ tòomu mǝ Rasiɛlǝ ŋwǝ ŋkpɛ. Ka ŋ tàa Rasiɛlǝ lǝ kǝǝwǝ mǝ ŋ teeri Leya. Wǝ́ Yakɔbǝ ŋ tǝ ŋ sʊ̀ma Labaŋ cɛŋwǝ pǝrɩmata ke.<verse eid="GEN 29:30" /></para>
  <para style="s">Yakɔbǝ le epipǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Kǝ́ Ǝtǝ Woroko ŋ na nyɩŋ ǝkǝnǝŋ Yakɔbǝ lǝŋ taa Leya lǝ kǝǝwǝ we, wǝ́ ŋ kòonu Leya ŋ kǝ ŋ mǝ epipǝ. Paa Rasiɛlǝ lǝǝ kǝ ŋ mǝ. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Wǝ́ Leya ŋ rè wǝkulukpǝ, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ ko ŋ pwo ŋwǝ ǝkǝnǝŋ Rubɛnǝ, duturǝ ɖi tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko la nyɩŋ mǝ kǝyepukǝ. Rǝkǝsa we, mǝ nuŋ lah mǝ taa mǝ kǝǝwǝ.» <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />Wǝ́ ŋ tǝ ŋ rè wǝkulukpǝ. Wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Awo, Ǝtǝ Woroko lo nuŋ wǝ ǝkǝnǝŋ pǝ lǝŋ taa mǝ kǝǝwǝ kǝto wǝ́ ŋ nǝ tǝ ŋ no koonu mǝ yǝ ǝnǝ.» Wǝ́ ŋ ko ŋ pwo ŋwǝ ǝkǝnǝŋ Simewɔŋ. <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />Wǝ́ ŋ tǝ ŋ rè wǝkulukpǝ, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝǝ paa, mǝ nuŋ lǝŋ tǝ ŋ pa waarǝ mǝ mǝ, kpiikǝ ŋ́ nǝ mǝ ǝpǝrǝŋpipǝ ata ŋ́ no koonu ŋwǝ.» Wǝ kǝto Yakɔbǝ ŋ ko ŋ pwo ŋwǝ ǝkǝnǝŋ Levi. <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />Wǝ́ ŋ tǝ ŋ rè wǝkulukpǝ, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Rǝkǝsa we, ŋ́ nǝh mǝ kǝ Ǝtǝ Woroko!» Wǝ kǝto Leya ŋ ko ŋ pwo ŋwǝ ǝkǝnǝŋ Yuda wǝǝ. Wǝ́ ŋ ce ŋ yàa mǝ ǝmǝkǝ.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Kǝ́ Rasiɛlǝ ŋ na nyɩŋ ǝkǝnǝŋ ŋ naa ya ŋ nǝ́ǝ mǝ mǝ ŋ koonu Yakɔbǝ we, wǝ́ ŋ ke ŋ yee ne yeeti la wǝtɛlɩkpǝ. Wǝ́ ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «Koonu kǝ ŋ́ mǝ epipǝ, mǝŋ ŋkǝ kaa wǝǝ, ŋ́ nǝ́ǝ kpǝ́.» <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />Wǝ́ Yakɔbǝ ŋ fǝ̀ Rasiɛlǝ la kpɛɛmʊrʊwǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Worokoyǝ? Ŋwǝ ŋ nǝ sǝŋ lǝ́ ǝmǝkǝ wǝ!» <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />Wǝ́ Rasiɛlǝ ŋ yìili ǝkǝnǝŋ: «A lǝŋ nyɩŋ kǝ́ Bila mǝ sʊmatǝtieyǝ ŋ yaa wǝ! Ka kpɛɛ mǝ ŋwǝ kǝ ŋ nya fɛɛ ŋ mǝ ŋ tɛ mǝ rǝ akpaakpaayǝ. Eniyǝ we saŋ rǝ no oŋuŋkǝ we, ŋmǝ ŋkpɛ ŋ́ náa nya bǝrǝŋpirǝ.» <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />Wǝ́ Rasiɛlǝ ŋ fǝ̀ na sʊmatǝtieyǝ Bila ŋ kòonu Yakɔbǝ ŋ lɔ̀. Wǝ́ Yakɔbǝ ŋ kpɛlɩ mǝ ŋwǝ. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Wǝ́ Bila ŋ rè wǝkulukpǝ. Wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ ŋ kòonu Yakɔbǝ. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Wǝ́ Rasiɛlǝ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ la pɛɛnɩ mǝ! Lo co kǝtukoŋkǝ rǝ mǝ nyuŋmwɛŋwǝ ŋmǝ ŋkpɛ, wǝ́ ŋ no koonu mǝ bǝrǝŋpirǝ.» Wǝ kǝto ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Danǝ wǝǝ. <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />Wǝ́ Rasiɛlǝ la sʊmatǝtieyǝ we pǝ lóo pwo Bila ŋ tǝ ŋ rè wǝkulukpǝ. Wǝ́ ŋ mǝnǝ bǝrǝŋpiyitǝrǝ ŋ kòonu Yakɔbǝ. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Wǝ́ Rasiɛlǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ na fia oworokoŋfiakǝ rɛ mǝ mǝ yeeti, wǝ́ ŋ́ ne ri yurǝ.» Wǝ́ ŋ kpìi piyǝ we la nyɩŋrǝ ǝkǝnǝŋ Nɛfǝtali. <verse eid="GEN 30:8" /><verse number="9" style="v" sid="GEN 30:9" />Kǝ́ Leya ŋ na nyɩŋ ǝkǝnǝŋ ne kǝpimǝkǝ kǝ la yaa we, wǝ́ ŋ fǝ̀ na sʊmatǝtieyǝ we pǝ lóo pwo Zilǝpa ŋ kòonu Yakɔbǝ ŋ lɔ̀. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Wǝ́ Leya la sʊmatǝtieyǝ we pǝ lóo pwo Zilǝpa ŋ mǝnǝ bǝrǝŋpirǝ ŋ kòonu Yakɔbǝ <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />wǝ́ Leya ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ lo yupoŋrǝ wǝǝ!» Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Gadǝ. <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />Wǝ́ Leya la sʊmatǝtieyǝ Zilǝpa ŋ mǝnǝ bǝrǝŋpiyitǝrǝ ŋ kòonu Yakɔbǝ <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />wǝ́ Leya ŋ tɛnɩ ǝkǝnǝŋ: «Kǝ́ la wǝsiɛrɩkpǝ wǝ́ ŋ́ na nya ǝnǝ! Rǝkǝsa etiepǝ pǝ lah mǝ tɛŋ ǝkǝnǝŋ ŋmǝ yǝ ŋ́ no co yǝ», wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Asɛrǝ. <verse eid="GEN 30:13" /><verse number="14" style="v" sid="GEN 30:14" />Jirɛɛrǝ we, wǝ́ Rubɛnǝ ŋ kolu atɛɛkǝ mǝ eniŋce bǝleyǝ. Wǝ́ ŋ kolu ŋ nya atɛɛlɩyǝ rɛ pǝ lóo pwo maŋdǝragɔrǝyǝ<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft" closed="false">Eniyǝ we we, enyipǝ pǝ kaŋ tɛŋ ǝkǝnǝŋ atɛɛlɩyǝ sa yǝ lóo koonu tieyǝ lǝ ǝmǝkǝ.</char></note>. Wǝ́ ŋ rè yǝ ŋ pǝlǝ ŋ kòonu ne lee Leya. Wǝ́ Rasiɛlǝ ŋ tìi Leya ǝkǝnǝŋ: «Dɔɔkpɛ, maa lǝ́ pi la maŋdǝragɔrǝyǝ sa tɩpɩrɩ o koonu mǝ oo.» <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />Wǝ́ Leya ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ a la ta mǝ nuŋyǝ a la lɔ rǝ mǝ wǝǝ, wǝ loo ro lǝ́? Wǝ́ ǝ tǝ a ya lǝ́ǝ pǝ́ a ta mǝ piyǝ la maŋdǝragɔrǝyǝ ŋwǝ ŋkpɛ a lɔ?» Wǝ́ Rasiɛlǝ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Wǝ ponu! We fǝ lé pi la maŋdǝragɔrǝyǝ sa o koonu mǝ, kǝ Yakɔbǝ ŋ pa kpɛɛ lǝ́ kpǝŋ mǝ dumurǝ sa ŋ kpii wǝlo yuwǝ.» <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />Ɖiɔrǝ, kǝ́ Yakɔbǝ ŋ no ru atɛɛkǝ ŋ no furu we, wǝ́ Leya ŋ rù ŋ kolu ŋ kù mǝ ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «A láa kpɛɛ mǝ kpǝŋ ruŋruŋ. Duturǝ ɖi ŋ́ nǝ fǝ mǝ piyǝ la maŋdǝragɔrǝyǝ ŋ́ na mwara Rasiɛlǝ kǝ ŋ́ nya fɛɛ ŋ́ nya lǝ́.» Wǝ́ Yakɔbǝ ŋ kpɛlɩ mǝ ŋwǝ dumurǝ we. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />Wǝ́ Worokoyǝ ŋ cò kǝtukoŋkǝ rǝ Leya lo nyuŋmwɛŋwǝ, wǝ́ Leya ŋ rè wǝkulukpǝ. Wǝ́ ŋ mǝnǝ bǝrǝŋpitʊʊtǝrǝ ŋ kòonu Yakɔbǝ. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Wǝ́ Leya ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ la mwara mǝ wǝtookpǝ mǝ kǝ ŋ́ nǝ fǝ mǝ sʊmatǝtieyǝ ŋ́ no koonu mǝ nuŋ ŋ na lɔ kǝto.» Wǝ́ ŋ kpii na nyɩŋrǝ ǝkǝnǝŋ Isaka. <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />Wǝ́ Leya ŋ tǝ ŋ rè wǝkulukpǝ, wǝ́ ŋ mǝnǝ bǝrǝŋpikʊraŋtǝrǝ ŋ kòonu Yakɔbǝ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ la cɛɛ mǝ tukpatɩwǝ rɛ! Mǝŋ wǝǝ paa we, mǝ nuŋ lǝh mǝ kǝ mǝ. Duturǝ ɖi ŋ́ nǝ mǝ ǝpǝrǝŋpipǝ akʊraŋ ŋ́ no koonu ŋwǝ.» Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Zabulɔŋ. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />Rǝ wǝla kǝmaakǝ wǝ́ Leya ŋ mǝnǝ diepirǝ. Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Wǝ́ Worokoyǝ ŋ tàalǝ Rasiɛlǝ, wǝ́ ŋ cò kǝtukoŋkǝ rǝ no nyuŋmwɛŋwǝ. Wǝ́ ŋ tàanǝ nǝ ǝmǝkǝ. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Wǝ́ ŋ rè wǝkulukpǝ, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Akaanɛŋ Worokoyǝ la pɔrʊ mǝ nʊŋsɔɔwǝ!» <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Yosɛfʊ<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">Rǝ Kǝhebǝritǝkǝ we, nyɩŋrǝ sa lo duturǝ ɖi: Tǝ o koonu.</char></note>, ŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko ŋ tǝ ŋ koonu mǝ bǝrǝŋpirǝ!» <verse eid="GEN 30:24" /><verse number="25" style="v" sid="GEN 30:25" />Kǝ́ Rasiɛlǝ ŋ na nya ŋ nǝ mǝ Yosɛfʊ we, wǝ́ Yakɔbǝ ŋ tìi Labaŋ ǝkǝnǝŋ: «Maa mǝ ŋ́ kpǝlǝŋ mǝ ŋ ko mǝ kpǝŋ, rǝ mǝ gǝŋrǝ. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Fǝ mǝ epipǝ mǝ mǝ etiepǝ we yurǝ kǝto wǝ́ ŋ́ na sʊma lǝ́ we, o koonu mǝ kǝ mǝ ŋ ko. E cii kǝnǝnɛkǝ we ŋ́ ne yee ŋ́ no koonu lǝ́ sɩsiɛrɩ.» <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />Wǝ́ Labaŋ ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ, yee mǝ lɛsiɛrɩwǝ. Ŋ́ na kpaa ŋ́ no nuŋ ǝkǝnǝŋ ŋlǝ́ kǝto wǝ́ Ǝtǝ Woroko ŋ na pɛɛrɩ mǝ wǝ.» <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Wǝ́ Labaŋ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Tɛŋ ló wǝtoorikpǝ a lah mǝ lɔ e tíi mǝ, ŋ́ nah pa mwara lǝ́ kpǝ.» <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ŋlǝ́ e cii kǝ́ ŋ́ na sʊma lǝ́ ŋ́ nǝ fǝ wǝ. Mǝ kǝ́ lá akɛɛpǝ pǝ la yaarǝ pǝ lǝ fǝ rǝ mǝ akaakǝ wǝ. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Kpɛŋ kǝ ŋ́ pǝ pǝ lǝ́ kpǝŋ we, ǝ lǝǝ kǝ lǝmǝ tukpaawǝ rɛ. Rǝkǝsa pǝ la yaarǝ ŋpa kǝ́ ŋ́ ne re pǝ wǝ, wǝ́ Ǝtǝ Woroko ŋ na pɛɛrɩ lǝ́. Rǝkǝsa wǝǝ, eniyǝ rǝ fǝŋ wǝ́ ŋmǝ ŋkpɛ ŋ́ neh pe yee kǝnǝnɛkǝ ŋ́ yɩrɩ mǝ nyarǝwǝ lo yurǝ wǝ?» <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />Wǝ́ Labaŋ ŋ pǝ̀ ǝkǝnǝŋ: «Kǝ́ wǝ́ ŋ́ noh koonu lǝ́?» Wǝ́ Yakɔbǝ ŋ yìili ǝkǝnǝŋ: «E lee kpii o lóo koonu mǝ tǝrɛ. Mǝŋ a láa tɛɛnɩ e yee a saŋ rǝ dierǝ sa ŋ́ neh tíi lǝ́ we, ŋ́ kǝh tǝ ŋ́ kpǝlǝŋ mǝŋ rǝŋ lá amɛɛpǝ sa. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Ruŋruŋ we, ŋ́ née siri rǝ lá akɛɛpǝ sa lo kuwǝ sa kpǝlo kɩɩkɩ lǝ mǝrǝ ŋ́ tɛlɩ. Ŋ́ na saa amɛɛpipǝ we kpǝlo kɩɩkɩ pǝ lǝ tarakataraka, amaa pǝ lǝ matamata mǝ amɛɛpitipǝ kpǝlo kɩɩkɩ. Epereceepǝ we kpǝlo kɩɩkɩ pǝ lǝ tarakataraka, amaa pǝ lǝ matamata wǝ. Akɛɛpǝ sa pǝ leh ri mǝ wǝtoorikpǝ wǝ. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Mǝ anʊkɔrǝyǝ yǝ leh pe ri ɖaŋsieyǝ yǝ koonu mǝ soosowǝ sa. Vǝ́ ǝ lǝ pǝ a pa yɩrɩ mǝ wǝtoorikpǝ sa we, kɛɛyǝ we ŋ nǝǝ lǝ tarakataraka amaa matamata rǝ epereceepǝ lǝ mǝrǝ amaa kɛɛyǝ we ŋ nee ti rǝ amɛɛpǝ lǝ mǝrǝ we, we ŋ́ na yɩɩ ŋwǝ rǝ.» <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />Wǝ́ Labaŋ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ ponu, ŋ́ na tɛɛnɩ tuwǝ we a la tɛŋ wǝ.» <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Jirǝ we jirǝ we wǝ́ Labaŋ ŋ pɔ̀rʊ epereceekpatuyǝ we yǝ lǝǝmǝ wǝŋʊrʊkpǝ miaamiaa amaa tarakataraka mǝ eyiyeepǝ we pǝ lǝ matamata amaa tarakataraka, mǝ epǝ we kpǝlo kɩɩkɩ pǝ tɛ mǝ otukpɛɛlɩyǝ ŋ tǝ̀nǝ kpoo. Wǝ́ ŋ pɔ̀rʊ amɛɛpitipǝ we kpǝlo ŋ tǝ̀nǝ kpoo. Wǝ́ ŋ fǝ̀ akɛɛpǝ sa ŋ kòonu nǝ ǝpǝrǝŋpipǝ pǝ ŋ rǝŋ. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Wǝ́ ŋ pwɛ̀yɩ mǝ akɛɛpǝ we rǝ Yakɔbǝ lǝ kpǝŋ. Ru rǝ Yakɔbǝ lǝ kpǝŋ ko fɛɛwǝ we we, pǝ láa saŋ gʊŋrǝ we juu ta. Wǝ́ yakɔbǝ ŋwǝ paa ŋ kǝ ŋ rǝŋ Labaŋ la akɛɛtuturupǝ we. <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />Wǝ́ Yakɔbǝ ŋ kolu ŋ sǝ̀ wǝciikpǝ rɛ wǝta le eciitipikookooyǝ. Wǝ́ ŋ sìe eciitipiyǝ sa lǝ ǝfǝfǝŋyǝ ŋ wàarǝ kǝwaakǝ rǝ afɛɛrɛɛyǝ anyɩŋ afɛɛyǝ we yǝ la kpɛɛlɩ fuu, wǝ ŋ màa afɛɛrɛɛyǝ la kǝwaakǝ. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Wǝ́ ŋ fǝ̀ eciitipiyǝ sa yǝ lǝ sǝ mǝ apayǝ ŋ kolu ŋ tǝnǝ rǝ akɛɛpǝ we la kǝnyɩŋkǝ rǝ pǝla fɛɛŋuŋmɛŋwǝ. Duturǝ ɖi akɛɛpǝ sa pǝ láa tɛɛnɩ pǝ ŋ rɛ awɛ vǝ́ pǝ lǝ pǝ pǝ po ŋuŋ mɛŋwǝ. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Wǝ́ akɛɛpǝ sa pǝ kǝ ŋ pǝ pǝ ŋ rɛ awɛ rǝ eciitipiyǝ sa la kǝnyɩŋkǝ, kǝto vǝ́ pǝ lǝ mǝ birǝ we, anyɩŋ dɛɛ mǝ wǝŋʊrʊkpǝ miaamiaa amaa anyɩŋ lǝ matamata amaa tarakataraka. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Wǝ́ Yakɔbǝ ŋ tǝ̀nǝ amɛɛpǝ kpoo, wǝ́ ŋ siɛrɩ pǝ pǝ ka ŋ yɩrɩ Labaŋ la akɛɛpǝ we pǝ kǝ lǝ matamata mǝ epǝ we pǝ ke ti wǝ. Wǝ́ ŋ kǝ ŋ tǝnǝ ŋwǝŋwǝ na mɛɛkuwǝ. Laa ka ŋ maa pǝ pǝ kʊla mǝ Labaŋ la akɛɛpǝ. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Eni ri ŋ eni vǝ́ akɛɛpǝ we pǝ la nya wɛɛwǝ pǝ lah rɛ awɛ ko we, Yakɔbǝ ŋ kǝ fǝ eciitipiyǝ we ŋ pǝ tǝnǝ rǝ pǝla kǝnyɩŋkǝ rǝ pǝla fɛɛŋuŋmɛŋwǝ kǝ pǝ nya fɛɛ pǝ ŋ rɛ awɛ rǝ eciitipiyǝ we kǝnyɩŋkǝ. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Paa vǝ́ akɛɛpǝ we pǝ lah rɛ awɛ pǝ laa nya wɛɛwǝ we, Yakɔbǝ lǝŋ tǝnǝ eciitipiyǝ we rǝ we. Kǝto akɛɛpǝ we pǝ laa nya wɛɛwǝ we pǝ ke ri Labaŋ la anɛŋ, wǝ́ epǝ we pǝ la nya wɛɛwǝ we pǝ ke ri Yakɔbǝ la anɛŋ.<verse eid="GEN 30:42" /></para>
  <para style="s">Yakɔbǝ lo suu la pwɛyɩ rǝ Labaŋ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 30:43" />Wǝ́ Yakɔbǝ ŋ pǝlǝ ŋ nyà otulǝmǝyǝ ŋpaŋpa. Kǝ lǝǝmǝ amɛɛpǝ mǝ epereceepǝ ŋpa, asʊmatǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ, akpɔŋkɔpǝ mǝ orookɛtɛpǝ.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Yakɔbǝ pǝlǝ nunu ǝkǝnǝŋ Labaŋ lǝ ǝpǝrǝŋpipǝ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ: «Yakɔbǝ la kparǝ lǝh tǝ lo otuyǝ kpǝlo kɩɩkɩ la kaa. Lǝh tǝ lo oŋuŋkǝ kǝto wǝ́ ŋ na nya otulǝmǝyǝ sa kpǝlo kɩɩkɩ ǝnǝ!» <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Wǝ́ Yakɔbǝ ŋ nyɩnɩ wǝ ŋ cìi ǝkǝnǝŋ Labaŋ lǝǝ tǝ ya lée re anyɩŋceeceekǝ rɛ mǝ ŋ pǝ rǝ nǝ kpǝŋ mǝŋ eniyǝ nɔ kǝtǝ. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />Wǝ́ Ǝtǝ Woroko ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «Kpǝlǝŋ o mǝ ko lǝ́ tǝ peni mǝ ló otuulupǝ lǝ gǝŋrǝ, ŋ́ née kpii ŋ́ kʊla mǝ lǝ́.» <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />Wǝ́ Yakɔbǝ ŋ kpìi pǝ kolu pǝ pwò Rasiɛlǝ mǝ Leya pǝ cò ŋwǝ rǝ bɔɔrǝ we ŋpǝ mǝ na akɛɛpǝ pǝ ka yaa wǝ. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ náa nyɩŋ wǝ ǝkǝnǝŋ nǝ tǝ lǝǝ tǝ ya lée re anyɩŋceeceekǝ rɛ mǝ ŋ pǝ rǝ mǝ kpǝŋ mǝŋ eniyǝ nɔ kǝtǝ. Paape mǝ tǝ lo Worokoyǝ kpii kʊla mǝ mǝ. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Ŋnǝ paa we, nǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ ŋ́ na sʊma nǝ tǝ mǝ mǝ okopiyǝ kpǝlo kɩɩkɩ. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Nǝ tǝ lǝ tǝǝnǝ mǝ wǝ́ ŋ na cɛkɛlɛ mǝ wǝtoomwarakpǝ pǝrǝŋwǝ kǝtǝ, paape Worokoyǝ laa maa ŋwǝ ŋ yee mǝ mǝ turɔɔrɔɔwǝ rɛ. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Vǝ́ la tɛŋ ǝkǝnǝŋ: “Akɛɛpǝ we pǝ lǝ tarakataraka pǝ ri ló wǝtoomwarakpǝ” we, akɛɛpǝ we kpǝlo kɩɩkɩ pǝ ŋ mǝ epipǝ pǝ lǝ tarakataraka wǝ. Vǝ́ la tɛŋ ǝkǝnǝŋ: “Akɛɛpǝ we pǝ lǝǝmǝ wǝŋʊrʊkpǝ miaamiaa pǝ ri ló wǝtoomwarakpǝ” we, akɛɛpǝ we kpǝlo kɩɩkɩ pǝ ŋ mǝ epipǝ pǝ lǝǝmǝ wǝŋʊrʊkpǝ miaamiaa wǝ. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Kǝ́ Worokoyǝ ŋ ne yee wǝ́ ŋ na ta na akɛɛpǝ ŋ na lɔ rǝ nǝ tǝ wǝ́ ŋ nǝ fǝ pǝ ŋ no koonu mǝ wǝǝ. <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />Rǝ eniyǝ we akɛɛpǝ pǝ láa rɛ awɛ lǝ mǝrǝ we, wǝ́ ŋ́ kpɛlɩ kǝtʊkpɛɛkǝ wǝ́ ŋ́ nyɩnɩ epereceekpatuyǝ we mǝ wǝŋʊrʊkpǝ miaamiaa, eyǝ we yǝ lǝ tarakataraka mǝ eyǝ we yǝ lǝ matamata we, yǝ ka ŋ rɛ akɛɛyeepǝ we wǝ. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Wǝ́ Worokoyǝ le picoŋpiyǝ ŋ pwò mǝ rǝ kǝtʊkpɛɛkǝ we mǝrǝ ǝkǝnǝŋ: “Yakɔbǝ!” Wǝ́ ŋ́ yɩ̀rɩ: “Ŋmǝ ǝyǝǝ.” <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Wǝ́ ŋ tǝ ŋ yìili ǝkǝnǝŋ: “Yiili a yɩrɩ akpatuyǝ sa kpǝlo kɩɩkɩ yǝ ya yǝ láa rɛ epereceepǝ sa mǝ amɛɛpǝ sa we, yǝ lǝǝmǝ wǝŋʊrʊkpǝ miaamiaa, amaa yǝ lǝ tarakataraka amaa matamata, duturǝ ɖi ŋ́ na nyɩŋ otuyǝ we Labaŋ ŋ ya ŋ née yee mǝ lǝ́ kǝto. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Ŋmǝ ŋ́ ri Worokoyǝ we ŋ pɔ̀rʊ na wɛ ŋ kanǝ lǝ́ rǝ Bɛtɛlǝ, fɛɛwǝ we a tɔ̀ ɖurǝ wǝ́ e fìeni rǝ la apɔŋpǝ wǝ. Fɛɛwǝ we wǝ́ a yɩ̀rɩ gɔrǝ rǝ mǝ kpǝŋ wǝ. Rǝkǝsa yi, pwɛyɩ rǝ gǝŋrǝ sa. Kpǝlǝŋ o mǝ ko ló otuulupǝ lǝ gǝŋrǝ.”» <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />Wǝ́ Rasiɛlǝ mǝ Leya pǝ yìili pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Lǝ tǝ lǝ lǝǝmǝ tǝrɛ amaa ǝtǝtuyǝ rɛ rǝ lǝh tǝ la nyarǝwǝ? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Mǝŋkǝ lǝ fǝ lǝ mǝŋ ǝsǝǝpǝ rɛ wǝ́ le ri? Duturǝ ɖi le siiri lǝ, wǝ́ ŋ na lɛ ŋ na lɔ mǝŋ sɩkayǝ we pǝ lǝ pǝ́ lǝ yurǝ ŋ ne ri. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Kǝto we, otulǝmǝyǝ we kpǝlo kɩɩkɩ Worokoyǝ ŋ na ta ŋ na lɔ rǝ lǝh tǝ we, yǝ ri ŋlǝ mǝ leh epipǝ la anɛŋ. Kǝto rǝkǝsa we, tu ri ŋ tu Worokoyǝ ŋ ne tíi lǝ́ e yee we, yee wǝ.»<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Wǝ́ Yakɔbǝ ŋ yili, wǝ́ ŋ fǝ̀ ne epipǝ mǝ ne etiepǝ ŋ tɛ̀ɛ rǝ akpɔŋkɔpǝ. <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />Wǝ́ ŋ fǝ̀ na akɛɛpǝ kpǝlo kɩɩkɩ mǝ no otulǝmǝyǝ we kpǝlo kɩɩkɩ ŋ nyà wǝ, akɛɛpǝ sa pǝ ri otuyǝ ŋ nyà rǝ Padaŋ Aramǝ wǝ. Wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko nǝ tǝ Isakǝ lǝ kpǝŋ rǝ Kanaŋ lǝ gǝŋrǝ. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />Eniyǝ we Labaŋ ŋ kolu ŋ ko puu na akɛɛpǝ lo ɖorǝ we, wǝ́ Rasiɛlǝ ŋ yɩ̀ɩ nǝ tǝ le etiŋyǝ. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Wǝ́ Yakɔbǝ ŋ tǝ̀ǝnǝ Labaŋ Aramǝtǝnyiyǝ sa mǝ kǝ́ ŋ sùu ŋ pwɛ̀yɩ ŋ naa kǝra ŋwǝ wǝ. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Wǝ́ ŋ sùu mǝ no otuyǝ kpǝlo kɩɩkɩ ŋ pwɛ̀yɩ. Wǝ́ ŋ tà kpanǝwǝ, wǝ́ ŋ fǝ̀ ŋ ko ŋ ko rǝ Galadǝ lo otutupiyǝ la gaarǝ. <verse eid="GEN 31:21" /><verse number="22" style="v" sid="GEN 31:22" />Juutatǝrǝ wǝ́ pǝ kolu pǝ tìi Labaŋ ǝkǝnǝŋ Yakɔbǝ lo suu la pwɛyɩ. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Wǝ́ Labaŋ ŋ fǝ̀ na apaanʊpǝ ŋ kʊ̀la mǝ na wɛ, wǝ́ pǝ sìimǝ Yakɔbǝ la akʊŋyǝ wǝcukpǝ wǝpǝrɩmata. Wǝ́ pǝ kolu pǝ tùu ŋwǝ rǝ Galadǝ lo otutupiyǝ. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Dumurǝ we, wǝ́ Worokoyǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Labaŋ, Aramǝtǝnyiyǝ sa rǝ kǝtʊkpɛɛkǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yee yurǝ, paa tɛŋ tǝrɛ o ko rǝ Yakɔbǝ lǝ kpǝŋ. Wǝ ke ri ceecee amaa rɔɔrɔɔ<note caller="+" style="f"><char style="fr" closed="false">31:24 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ: «Pee ci kǝ e tíi Yakɔbǝ la tǝrɛ».</char></note>!»<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Labaŋ kolu tùu Yakɔbǝ rǝ Galadǝ lo otutupiyǝ, o turu la tɔ̀ ne bwiirǝ rǝ fɛɛwǝ we. Wǝ́ Labaŋ mǝ na apaanʊpǝ we ŋpǝ ŋkpɛ pǝ tɔ̀ pǝla nɛŋrǝ<note caller="+" style="f"><char style="fr" closed="false">31:25 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la tɛŋ ǝkǝnǝŋ: «Wǝ́ Labaŋ ŋ tɔ̀ ne bwiirǝ».</char></note> <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Wǝ́ Labaŋ ŋ pǝ̀ Yakɔbǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ e le yee ǝnǝ? Ǝ lǝ tǝǝnǝ mǝ wǝ́ ǝ lǝ fǝ mǝ akɔrʊpǝ a la pwɛyɩ mǝŋ kǝ́ pǝ láa lɔ arɔŋpǝ rǝ akɔŋkǝ kǝtǝ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Kǝ́ kǝto wǝ́ a la ŋwaa o lo suu, wǝ́ ǝ lǝ tǝǝnǝ mǝ wǝ? A kah kǝra mǝ we, ŋ́ koh co lá kʊŋwǝ mǝ faawǝ, anɔŋyǝ mǝ ǝpǝŋyǝ mǝ ɖuleyǝ. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />A laa maa mǝ ŋ́ pala mǝ epilepipǝ mǝ ma akɔrʊpǝ ǝkǝŋtǝ. E le yee purutuwǝ kǝceece! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Ŋ́ lǝǝmǝ okopiyǝ ŋ́ keh yee mǝ nǝ turɔɔrɔɔwǝ. Paape nǝ tǝtǝ peni lo Worokoyǝ tìi mǝ ǝsǝǝkǝ mǝ dumurǝ ǝkǝnǝŋ: “Yee yurǝ, paa tɛŋ tǝrɛ o ko rǝ Yakɔbǝ lǝ kpǝŋ. Wǝ ke ri ceecee amaa rɔɔrɔɔ!” <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Rǝkǝsa we, a la pwɛyɩ duturǝ ɖi lǝ́ tǝ la nyarǝwǝ wǝ ya wǝ láa ca lá kpɛɛ kǝto. Rǝkǝsa kǝ́ kǝto wǝ́ a la yɩɩ mǝ oworokopǝ wǝ?» <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ no suu vurǝ rǝ, wǝ́ ŋ́ no pu yurǝ ayɩrɛ a lah pa ta lá akɔrʊpǝ a lɔ rǝ mǝ mǝ okopi mǝ okopi kǝto. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Yǝ we lǝ kpǝŋ a lah ka nyɩŋ ló oworokopǝ we, yǝ we lǝ́ǝ kpǝ́. Rǝ loh otuulupǝ sa le enimiyǝ we, yɩrɩ tuwǝ we wǝ ri lá nɛŋ wǝ́ wǝ kpii rǝ mǝ kpǝŋ we, kǝ ǝ fǝ wǝ.» Yakɔbǝ lee ke ci wǝ ǝkǝnǝŋ Rasiɛlǝ ŋ yɩ̀ɩ Labaŋ lo oworokopǝ we.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Wǝ́ Labaŋ ŋ fìi ŋ tàa Yakɔbǝ mǝ Leya mǝ na asʊmatǝtiepǝ we eyipǝ le epwiiyǝ, laa nyɩŋ tǝrɛ. Kǝ́ ŋ no ru rǝ Leya le bwiirǝ we, wǝ́ ŋ fìi Rasiɛlǝ la nɛŋrǝ. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Ke ci Rasiɛlǝ ŋ na yɩɩ etiŋyǝ we, wǝ́ ŋ fǝ̀ yǝ ŋ ŋwàa rǝ na kpɔŋkɔyǝ la zaarǝ kǝnǝŋkǝ. Wǝ́ ŋ sɔ̀ ŋ tini rǝ rǝ. Wǝ́ Labaŋ ŋ tàa bwiirǝ we kpǝlo kɩɩkɩ, laa nyɩŋ tǝrɛ. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />Wǝ́ Rasiɛlǝ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Mǝ kulǝtǝyǝ, dɔɔkpɛ wǝ pee fii lǝ́ mǝ kǝ́ ŋ́ noo koru eyi ŋ́ yaa rǝ lá kǝnyɩŋkǝ wǝ. Duturǝ ɖi ŋ́ nǝŋ fii kǝto.» Wǝ́ Labaŋ ŋ tàa etiŋyǝ we, laa nyɩŋ yǝ.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Wǝ́ Yakɔbǝ ŋ fǝ̀ kpɛɛmʊrʊwǝ wǝ́ ŋ kpanǝ mǝ Labaŋ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ ŋ́ na fʊmʊ? Kǝ́ lo turɔɔrɔɔ wǝ́ ŋ́ ne yee wǝ́ o mumu e siimǝ mǝ akʊŋyǝ a láa tɛlɩ ǝnǝ? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Kǝ́ a la wala mǝ otuyǝ kpǝlo kɩɩkɩ a la yɩrɩ wǝǝ, a la nyɩŋ tuwǝ rɛ ceŋceŋ wǝ ri lá nyarǝwǝ lo tuwǝ? Kǝ ǝ fǝ wǝ a kaŋ mǝ enyipǝ mǝ lé enyipǝ, kǝ pǝ tɛŋ ŋlǝ mǝ lǝ́ leh eyi la wǝkpaŋkpǝ! <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Ŋ́ kpii rǝ lǝ́ kpǝŋ wǝ le yee cɛŋwǝ tiyi, lé epereceepǝ amaa lá amɛɛpǝ pǝ laa pɔrʊ lɛrǝ pǝ nyɩŋ! Ŋ́ naa pa lɔ lá mɛɛkpaturǝ rɛ rǝ lá akɛɛpǝ mǝrǝ ŋ́ wo ŋ́ nyɩŋ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Vǝ́ kɛɛyǝ rɛ la lɔ lá kɛɛyǝ lo wo we, ŋ́ nǝŋ pǝ mǝ na tǝrɛ ŋ́ pa kaŋ lǝ́, paa mǝ ŋ taa no yuwǝ ŋ́ kpii. Wǝ ke ri dumurǝ amaa jɔkɔŋrǝ wǝ́ pǝ la yɩɩ lá kɛɛyǝ rɛ we a ya mǝ pǝ́ mǝ ŋwǝ! <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Kǝ́ cɔkɔŋyǝ ŋ re mǝ ŋ náa nyɔŋ mǝ jɔkɔŋrǝ wǝǝ, dumurǝ kǝ́ ziɛrǝ ya láa wʊ mǝ wǝǝ. Eniŋrieyǝ yǝ lo suu rǝ mǝ enimiyǝ! <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Wǝ le yee cɛŋwǝ tiyi kǝ́ ŋ́ kpii rǝ lá nyarǝwǝ wǝǝ. Ŋ́ na sʊma lǝ́ mǝŋ rɔŋyǝ kǝtǝ cɛŋwǝ tǝ mǝ niǝ ŋ́ ne kpii lá akɔrʊpǝ sa eyipǝ lo yuwǝ. Wǝ́ ŋ́ ne yee cɛŋwǝ kʊʊraŋ mǝ lá akɛɛpǝ! Paa ŋlǝ́ we, a la cɛkɛlɛ mǝ wǝtoomwarakpǝ pǝrǝŋwǝ kǝtǝ! <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Mǝŋ mǝ tǝ lo Worokoyǝ, Abǝrahamǝ lo Worokoyǝ, Worokoyǝ we Isakǝ ŋ ko ŋ suu lee ke kpii ŋ kʊla mǝ mǝ we, o ko cò mǝ kʊŋwǝ mǝ ŋ ko akaakpaakpa. Paa Worokoyǝ nyɩnɩ mǝ kǝyepukǝ mǝ anǝnɛlɛnyɩyǝ we mǝ wǝkaakpǝ wǝ le yee wǝ, wǝ́ ǝsǝǝkǝ lo dumurǝ sa ŋ sǝ̀ wǝkpaŋkpǝ sa.» <verse eid="GEN 31:42" /><verse number="43" style="v" sid="GEN 31:43" />Wǝ́ Labaŋ ŋ yìili ǝkǝnǝŋ: «Akɔrʊpǝ sa pǝ ri mǝ akɔrʊpǝ, epipǝ sa pǝ ri mǝ epipǝ, amɛɛpǝ sa pǝ ri mǝ amɛɛpǝ. Otuyǝ sa kpǝlo kɩɩkɩ a ya láa nyɩŋ we, yǝ ri mǝ anɛŋ. Ruŋruŋwǝ sa kǝ́ wǝ́ ŋ́ neh yee mǝ mǝ akɔrʊpǝ amaa epipǝ sa pǝ lǝ mǝǝnǝ wǝ? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Mǝ pǝ, eniyǝ yǝ lo ro kǝ ŋlǝ mǝ lǝ́ la parǝ dierǝ lǝ tǝnǝ. Wǝ kaamǝ kǝ ɖaŋsielǝtǝyǝ rɛ ŋ kpii rǝ ŋlǝ mǝ lǝ́ le kǝtiitiikǝ.»<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Wǝ́ Yakɔbǝ ŋ fǝ̀ ɖurǝ rɛ ŋ tɔ̀. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Wǝ́ ŋ tìi no otuulupǝ ǝkǝnǝŋ: «Nǝ rɛmɩ oruyǝ nǝ ca kuwǝ.» Wǝ́ pǝ rɛ̀mɩ oruyǝ pǝ cà kuwǝ. Wǝ́ pǝ rili rǝ rukuwǝ sa lo oŋuŋkǝ. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Wǝ́ Labaŋ ŋ kpìi fɛɛwǝ sa la nyɩŋrǝ ǝkǝnǝŋ Yegarǝ Sahaduta, paa wǝ́ Yakɔbǝ ŋ kpìi wǝla nyɩŋrǝ ǝkǝnǝŋ Galeyɛdǝ. <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />Wǝ́ Labaŋ ŋ tɛnɩ ǝkǝnǝŋ: «Ruŋruŋ le jirǝ sa we, rukuwǝ sa wǝ ri ɖaŋsieyǝ wǝ koonu ŋlǝ mǝ lǝ́». Wǝ kǝto pǝ kpìi fɛɛwǝ we la nyɩŋrǝ ǝkǝnǝŋ Galeyɛdǝ. Wǝlo duturǝ ɖi ɖaŋsieyǝ lo rukuwǝ. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Pǝ lǝ́ǝ tǝ pǝ ŋ pwo fɛɛwǝ sa ǝkǝnǝŋ Misǝpa, wǝlo duturǝ ɖi ǝrǝŋkǝ la fɛɛwǝ, kpiikǝ Labaŋ tɛnɩ ǝkǝnǝŋ: «Ǝtǝ Woroko ŋ rǝŋ lǝ vǝ́ yǝ lǝǝ tǝ lǝ kǝlǝ mǝ awɛ wǝ. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Mǝŋ e le ke pieeli mǝ akɔrʊpǝ sa, amaa a la ka lɔ etiepǝ a la kʊla mǝ pǝ we, mǝŋkǝ rɛ ŋ naa kʊla mǝ lǝ we, ci wǝ ǝkǝnǝŋ Worokoyǝ ŋ ri ŋlǝ mǝ lǝ́ la ɖaŋsielǝtǝyǝ.»<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Wǝ́ Labaŋ ŋ tìi Yakɔbǝ ǝkǝnǝŋ: «A lǝŋ nyɩŋ rukuwǝ sa ŋ́ nǝ tǝnǝ rǝ ŋlǝ mǝ lǝ́ le kǝtiitiikǝ wǝ, a lǝŋ nyɩŋ ɖurǝ sa dɔ wǝ, <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />rukuwǝ sa wǝ ri ɖaŋsieyǝ, ɖurǝ sa dɔ ɖi ɖaŋsieyǝ. Ŋmǝ we, ŋ́ no tu ǝkǝnǝŋ ŋ́ nǝŋ pa tɛlɩ rukuwǝ sa, mǝ ɖurǝ sa dɔ wǝ ŋ́ pǝ lá gaarǝ mǝ oyupurɔɔrɔɔyǝ. Ŋlá ŋkpɛ, tu ǝkǝnǝŋ ŋlǝ́ a lǝŋ pa tɛlɩ rukuwǝ sa, mǝ ɖurǝ sa dɔ ǝ pǝ mǝ gaarǝ mǝ oyupurɔɔrɔɔyǝ. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Abǝrahamǝ lo Worokoyǝ mǝ Nakɔrǝ lo Worokoyǝ, ŋ ri kpaŋtɛŋtǝyǝ rǝ ŋlǝ mǝ lǝ́ mǝrǝ.<note caller="+" style="f"><char style="fr" closed="false">31:53 </char><char style="ft" closed="false">Arɛɛpǝ pǝ la maa: «Ŋwǝ ŋ ri pǝlǝ tǝ lo Worokoyǝ pǝ lo co».</char></note>» Wǝ́ Yakɔbǝ ŋ tù Worokoyǝ we ŋ ko ŋ co nǝ tǝ Isakǝ lo vurǝ wǝ. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Wǝ́ Yakɔbǝ ŋ yeli otoolukǝ rǝ dutupirǝ we. Wǝ́ ŋ pwòlu no otuulupǝ pǝ pe ri, kǝ́ pǝ le ri pǝ la lɛ we, wǝ́ pǝ kpɛlɩ rǝ dutupirǝ we pǝ kàalǝ.<verse eid="GEN 31:54" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Labaŋ yili mǝ ɖokoŋpirǝ ŋalaŋala. Wǝ́ ŋ pùru na akɔrʊpǝ mǝ ne epilepipǝ. Wǝ́ ŋ pɛ̀ɛrɩ pǝ, wǝ́ ŋ sìɛnɩ ŋ ko ŋ ko na nyarǝwǝ<verse eid="GEN 32:1" /></para>
  <para style="s">Yakɔbǝ la kpaka ŋ ko ku mǝ ne mǝtee Esawʊ</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />Kǝ́ Yakɔbǝ ŋ kpii ŋ nóo ko we, wǝ́ Worokoyǝ le epicoŋpipǝ pǝ pǝlǝ pǝ tùu ŋwǝ. <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />Kǝ́ ŋ na nya ŋ na nyɩŋ pǝ eni we, wǝ́ ŋ cà narǝwǝ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ le kǝtiikǝ oo!». Wǝ́ ŋ kpìi fɛɛwǝ we la nyɩŋrǝ ǝkǝnǝŋ Mahanayimǝ. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Wǝ́ Yakɔbǝ ŋ kpìi enyipǝ ŋ còonu ŋ manǝ ne mǝtee Esawʊ rǝ Seyirǝ lǝ gǝŋrǝ rǝ Edɔmǝ lǝ kǝtǝǝwǝ. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Wǝ́ ŋ cìi ŋ tìi pǝ ŋ tɛnɩ ǝkǝnǝŋ: «Dierǝ lǝ ɖǝ nǝ nyeh ke tíi mǝ kulǝtǝyǝ Esawʊ lǝmǝ ɖǝ ǝnǝ: “Lá sʊmatǝyǝ Yakɔbǝ ǝkǝnǝŋ: Ŋ́ na pwɛyɩ ŋ́ ne ce ŋ́ ne ke tii rǝ Labaŋ lǝ kpǝŋ, wǝ́ ŋ́ ne tii rǝ we wɩɩ po ro ruŋruŋ. <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />Ŋ́ lǝǝmǝ anɛŋpǝ mǝ orookɛtɛpǝ, epereceepǝ mǝ amɛɛpǝ, asʊmatǝpǝ mǝŋ etie mǝŋ ǝpǝrǝŋ. Ŋ́ ne kpii enyipǝ pǝ pe tíi ŋlǝ́ mǝ kulǝtǝyǝ Esawʊ le etieyǝ sa kǝ a nya fɛɛ a nyɩŋ mǝ tǝlarǝwǝ.”»<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Wǝ́ enyikpiipǝ we pǝ sìɛnɩ pǝ pǝlǝ pǝ tùu Yakɔbǝ, wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la ka nyɩŋ lé mǝtee Esawʊ. Ŋwǝ ŋkpɛ lǝ fǝ enyipǝ tuuruniǝ lo furu ŋ po ku mǝ lǝ́.» <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Wǝ́ vurǝ mǝ kǝǝnǝwǝ wǝ fìi Yakɔbǝ ŋpa. Wǝ́ ŋ sǝ̀pǝ enyipǝ we pǝ ke sìimǝ ŋwǝ kpǝŋwǝ yi. Wǝ́ ŋ lɛ̀ ŋ sǝ̀pǝ mǝŋ amɛɛpǝ we mǝŋ epereceepǝ we, mǝŋ anɛŋpǝ we mǝŋ akpɔŋkɔpǝ we kpee yi kpee yi. <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝŋ Esawʊ la pa ya lée yee akɔŋkǝ mǝ nyikpǝŋwǝ sa la rɛ, wǝ́ ŋ ya ŋ née ri pǝ lo yurǝ we, nyikpǝŋtuturuwǝ we wǝ lóo koru osuu».<verse eid="GEN 32:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 32:10" />Wǝ́ Yakɔbǝ ŋ mwɛnɩ nyuŋkpǝ ǝkǝnǝŋ: «Mǝ tǝtǝ Abǝrahamǝ lo Worokoyǝ! Mǝ tǝ Isakǝ lo Worokoyǝ! O! Ǝtǝ Woroko, ŋlǝ́ yǝ we e le tíi mǝ ǝkǝnǝŋ: “Siɛnɩ o mǝ ko lǝ́ gǝŋrǝ mǝ ló otuulupǝ lǝ kpǝŋ kǝ ŋ́ yee lǝ́ wǝceeceekpǝ wǝ”. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ŋ́ nee ce ŋ́ ri tǝrɛ, paape a la pɔrʊ lǝ́ kǝǝtaawǝ mǝ lá wǝkʊʊkpǝ a la kaŋ ŋmǝ lá sʊmatǝyǝ. Duturǝ ɖi mǝ ciisaŋwǝ sa ko wǝ́ ŋ́ ke re ŋ́ pǝlǝ ŋ́ tà Yɔrǝdaŋ la kpanǝwǝ sa. Paape ruŋruŋ le jirǝ sa ŋ́ na siɛnɩ ŋ́ no furu mǝ nyikpǝŋwǝ yi. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Dɔɔkpɛ, pɔrʊ mǝ o ru rǝ mǝ mǝtee Esawʊ la akaakǝ. Duturǝ ɖi ŋ́ ya ŋ́ nóo suu ŋwǝ. Ŋ́ ya ŋ́ nóo suu vurǝ ŋ paa pa lɔ mǝ ŋ wʊ, kǝ ŋ wʊ leeyǝ mǝ epipǝ. <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />Ŋlǝ́ yǝ we e le tíi mǝ ǝkǝnǝŋ: “Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ yee lǝ́ wǝceeceekpǝ, kǝ ŋ́ koonu kǝ lǝ́ wǝmǝkpǝ wǝ yaarǝ mǝŋ apʊyǝ la naŋrǝ kǝtǝ kǝ o turu pǝ lǝŋ koru ǝkǝ wǝ.”»<verse eid="GEN 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 32:14" />Wǝ́ Yakɔbǝ ŋ kpɛlɩ fɛɛwǝ we ŋ kàalǝ. Wǝ́ ŋ pɔ̀rʊ na akɛɛpǝ we ŋ kǝ lǝǝmǝ la arɛɛpǝ ŋ manǝ pǝ ka cɛɛ ne mǝtee Esawʊ. <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />Epereceeyeepǝ tuuruyi mǝ onunuŋpǝ tiyi, amɛɛyeepǝ tuuruyi mǝ onunuŋpǝ tiyi. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Akpɔŋkɔpǝ we pǝ ya pǝ láa mɛɛnɩ epipǝ tǝta mǝ pǝle epipǝ, anɛŋyeepǝ tǝniǝ mǝ onunuŋpǝ tǝ. Orookɛtɛyeepǝ tiyi mǝ onunuŋpǝ tǝ. <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />Wǝ́ ŋ fǝ̀ akɛɛpǝ sa kpookpookpoo ŋ kòonu na asʊmatǝpǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pǝ sǝpǝ nǝ yaa rǝ mǝ kǝnyɩŋkǝ kǝ nǝ tǝnǝ doloŋrǝ rǝ akɛɛpǝ we lǝ wǝkpǝŋkpǝ mǝrǝ.» <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />Wǝ́ ŋ tìi sʊmatǝsǝsǝŋyǝ we ǝkǝnǝŋ: «Vǝ́ mǝ mǝtee Esawʊ lo ko ku mǝ lǝ́, wǝ́ ŋ nǝ pǝ́ lǝ́ ǝkǝnǝŋ ǝlǝ ŋ ri ló kulǝtǝyǝ? Fǝŋ wǝ́ o loh ko? Ǝlǝ la akɛɛpǝ pǝ kaamǝ ǝpǝ e re we, <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />tíi ŋwǝ ǝkǝnǝŋ: “Lá sʊmatǝyǝ Yakɔbǝ la anɛŋ. Le kpii mǝ ǝkǝnǝŋ ŋmǝ ŋ́ fǝ pǝ ŋ́ pa cɛɛ ŋlǝ́ mǝ kulǝtǝyǝ Esawʊ. Ŋwǝŋwǝ tǝǝlǝ lǝ rǝ.”» <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Wǝ́ ŋ cìi ŋ tìi sʊmatǝyitǝyǝ we mǝŋkǝsa ke. Wǝ́ ŋ tìi tatǝyǝ we, wǝ́ ŋ lɛ̀ ŋ tìi epǝ we kpǝlo pǝ ke re akɛɛpǝ we ǝkǝnǝŋ: «Kǝ́ ŋnǝ ŋkpɛ nǝ nyeh ke tíi mǝ kulǝtǝyǝ Esawʊ vǝ́ nǝ nya ka nyɩŋ ŋwǝ wǝǝ. <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Nǝ nyeh ke tíi ŋwǝ ǝkǝnǝŋ: “Lá sʊmatǝyǝ Yakɔbǝ ŋwǝ ŋkpɛ lo furu, tǝǝlǝ lǝ rǝ.”» Duturǝ ɖi Yakɔbǝ ke ŋ tíi na wɛ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ fǝ otucɛɛyǝ ŋ́ kuŋ pǝ coŋ pǝ ka taarǝ ŋwǝ. Wǝla kǝmaakǝ kǝ ŋ́ ko nǝ kpǝŋ. Ayɩrɛ láa lɔ mǝ sɩsiɛrɩ.» <verse eid="GEN 32:21" /><verse number="22" style="v" sid="GEN 32:22" />Wǝ́ asʊmatǝpǝ we pǝ fǝ̀ otucɛɛyǝ we pǝ conu, wǝ́ ŋwǝ paa ŋ tùmǝ ŋ tini rǝ kǝtiikǝ we mǝ dumurǝ we.<verse eid="GEN 32:22" /></para>
  <para style="s">Yakɔbǝ mǝ Worokoyǝ pǝla fia mǝ awɛ</para>
  <para style="p">
    <verse number="23-24" style="v" sid="GEN 32:23-24" />Wǝ́ Yakɔbǝ ŋ yili dumurǝ we, wǝ́ ŋ fǝ̀ ne etiepǝ we pǝle eyi mǝ na asʊmatǝtiepǝ eyi mǝ ne epipǝ tǝ mǝ ceŋceŋ mǝŋ no otulǝmǝyǝ kpǝlo wǝ́ ŋ tà Yabɔkǝ la kpanǝwǝ rǝ pɔɔlʊwǝ ŋ kolu ŋ rù. <verse eid="GEN 32:23-24" /><verse number="25" style="v" sid="GEN 32:25" />Wǝ́ ŋwǝ ceŋceŋ ŋ tùuru. Wǝ́ nyiyǝ rɛ ŋ pǝlǝ ŋ ka ŋ fia mǝ ŋwǝ ko ro ǝrǝ rǝkaalǝwǝ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Kǝ́ nyiyǝ we ŋ na nyɩŋ ŋ ne ci ǝkǝnǝŋ ŋ naa ya ŋ nóo koru eri Yakɔbǝ lo yurǝ we, wǝ́ ŋ cà Yakɔbǝ rǝ kǝtɔŋkǝ mǝ eniyǝ we pǝ yà pǝ ka ŋ fia wǝ, wǝ́ kǝtɔŋkǝ we kǝ polu. <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />Wǝ́ nyiyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ lah kaalǝ kǝto nyarǝ mǝ o co kǝ mǝ ŋ ko.» Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝŋ nyarǝ lǝ́ ŋ́ co, we a láa pɛɛrɩ mǝ kpɛŋ.» <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />Wǝ́ nyiyǝ we ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Lá nyɩŋrǝ ɖi nɛ?» Wǝ́ ŋ tìi ǝkǝnǝŋ: «Yakɔbǝ». <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />Wǝ́ nyiyǝ we ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ lǝŋ tǝ pǝ ŋ pwo lǝ́ Yakɔbǝ, pǝ loh mǝ pwo lǝ́ Isǝrayɛlǝ, duturǝ ɖi a la fia mǝ Worokoyǝ wǝ́ a la fia mǝ anyɩmaasɩpǝ wǝ́ e le ri yurǝ.» <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ ŋlǝ́ e ri nɛ?» Wǝ́ Nyiyǝ we ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ a ya lǝ́ǝ pǝ́ e ci mǝ nyɩŋrǝ wǝ?» Rǝ fɛɛwǝ we wǝ́ ŋ pɛ̀ɛrɩ Yakɔbǝ. <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />Wǝ́ Yakɔbǝ ŋ kpìi fɛɛwǝ we la nyɩŋrǝ ǝkǝnǝŋ Peniɛlǝ. Wǝlo duturǝ ɖi Worokoyǝ la anyɩŋkǝ. Kpiikǝ ŋ́ na nyɩŋ Worokoyǝ niminimi, wǝ́ ŋ́ tǝ ŋ́ kpii vɔrʊrǝ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Wǝ́ Yakɔbǝ ŋ yili ŋ sǝ̀ Peniɛlǝ ŋ tɛ̀lɩ anyɩŋ cɔkɔŋyǝ lo poŋ. Na kǝtɔŋkǝ we kǝto sanǝ ko ŋ ko kɛɛrɩkɛɛrɩ. <verse eid="GEN 32:32" /><verse number="33" style="v" sid="GEN 32:33" />Fɛɛwǝ kǝto Isǝrayɛlǝtǝpǝ pǝ lǝŋ wo fiiniwǝ we wǝ kpii rǝ kǝtɔŋkǝ lo doŋrǝ po ro ruŋruŋ wǝǝ. Kpiikǝ fiiniwǝ we wǝ́ pǝ nyàanǝ Yakɔbǝ wǝ.<verse eid="GEN 32:33" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">Yakɔbǝ lo ko ku mǝ Esawʊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Kǝ́ Yakɔbǝ ŋ ne yiili yurǝ eni we, wǝ́ ŋ nyɩnɩ kǝ́ Esawʊ ŋpǝ mǝ enyipǝ tuuruniǝ pǝ lǝ́ǝ pǝ wǝ. Wǝ́ ŋ sǝpǝ epipǝ we ŋ kòonu Leya mǝ Rasiɛlǝ mǝ asʊmatǝtiepǝ we eyipǝ. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Wǝ́ ŋ fǝ̀ asʊmatǝtiepǝ we mǝ pǝle epipǝ ŋ còonu, wǝ́ ŋ fǝ̀ Leya mǝ ne epipǝ ŋ tɛ̀ɛ, wǝ́ ŋ ci ǝfǝ̀ Rasiɛlǝ mǝ Yosɛfʊ ŋ tɛ̀ɛ. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Wǝ́ ŋwǝŋwǝ ŋ tɛlɩ pǝ ŋ kolu ŋ conu wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ pǝrǝŋwǝ kǝpǝrɩmata kpɛŋ wǝ́ ŋ ci okolu ŋ tù ne mǝtee. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />Wǝ́ Esawʊ ŋ sùu ŋ pǝlǝ ŋ kù mǝ ŋwǝ. Wǝ́ ŋ pùru ŋwǝ ŋ rè rǝ dǝreerǝ. Wǝ́ pǝle eyi pǝ yà pǝ ke ŋ wee. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Kǝ́ Esawʊ ŋ ne yiili anyɩŋkǝ we, wǝ́ ŋ nyɩnɩ etiepǝ we mǝ epipǝ we. Wǝ́ ŋ pǝ̀ ǝkǝnǝŋ: «Ǝpǝ rǝ fǝŋ pǝ lǝmǝ ǝpǝ?» Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Epipǝ we Worokoyǝ ŋ ne yee mǝ lɛsiɛrɩwǝ, ŋ no koonu ŋmǝ lá sʊmatǝyǝ pǝ lǝǝwe.» <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />Wǝ́ asʊmatǝtiepǝ we mǝ pǝle epipǝ pǝ rùu pǝ kǝ̀lǝ, wǝ́ pǝ sʊ̀ʊ pǝ kʊnʊ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Wǝ́ Leya mǝ ne epipǝ pǝ rùu pǝ kǝ̀lǝ ŋpǝ ŋkpɛ, wǝ́ pǝ sʊ̀ʊ pǝ kʊnʊ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ. Wǝla kǝmaakǝ, wǝ́ Yosɛfʊ mǝ Rasiɛlǝ pǝ rùu pǝ kǝ̀lǝ, wǝ́ pǝ sʊ̀ʊ pǝ kʊnʊ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ ŋpǝ ŋkpɛ. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />Wǝ́ Esawʊ ŋ pǝ̀ ǝkǝnǝŋ: «Kǝ́ wǝ́ ǝ lǝ pǝ́ e ke yee mǝ akɛɛpǝ sa ŋ́ no ku mǝ wǝ?» Wǝ́ Yakɔbǝ ŋ tíi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ pǝ́ ŋ́ fǝ akɛɛpǝ sa ŋ taarǝ ŋlǝ́ mǝ kulǝtǝyǝ la ziɔŋrǝ rǝ.» <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />Wǝ́ Esawʊ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ paanʊ, ŋ́ lǝǝmǝ otuyǝ ŋpa. Maa ló otuyǝ sa yǝ kpɛɛ yǝ koonu lǝ́ rǝ.» <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ow, dɔɔkpɛ, mǝŋ lɛrǝ la taarǝ lǝ́ we, we kǝ a lɔ otuyǝ sa ŋ́ nǝ pǝ ŋ́ pa cɛɛ lǝ́ wǝ. Duturǝ ɖi kǝ́ ŋ́ na pa nyɩŋ lǝ́ wǝ́ a la lɔ mǝ sɩsiɛrɩ we, wǝ tǝ wǝ lǝ rǝ mǝŋ kǝ́ ŋ́ no ku mǝ Worokoyǝ kǝtǝ. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Kǝto ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ lǝ́, tɛɛnɩ a lɔ otuyǝ sa ŋ́ na cɛɛ lǝ́ wǝ. Duturǝ ɖi Worokoyǝ la pɛɛrɩ mǝ, wǝ́ ŋ́ lǝǝmǝ tu ri ŋ tu ŋ́ nǝ́ǝ pǝ́ wǝ.» Wǝ́ Yakɔbǝ ŋ nyɩ̀ɩ mǝ Esawʊ wǝ́ ŋ pǝlǝ ŋ tɛ̀ɛnɩ. <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />Wǝ́ Esawʊ ŋ tɛnɩ ǝkǝnǝŋ: «Yi kǝ lo ko, ŋ́ nóo coŋ kǝ e siimǝ mǝ.» <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ e cii wǝ ǝkǝnǝŋ ŋ́ re alaatiepipǝ, wǝ́ ŋ́ lɛ ŋ́ re amɛɛyeepǝ mǝ anɛŋyeepǝ pǝ ya pǝ láa mɛɛnɩ pǝle epipǝ wǝ. Mǝŋ yǝ lo suu mǝ pǝ jirǝ jeŋceŋ ǝkǝŋtǝ we, amɛɛpǝ we, epereceepǝ we kpǝlo pǝ lǝ́ǝ kpǝ́ǝlǝ. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Kǝto dɔɔkpɛ mǝ kulǝtǝyǝ, ka tɛlɩ o coŋ ŋmǝ lá sʊmatǝyǝ. Kǝ ŋmǝ paa ŋ́ saŋ ŋ́ siimǝ alaatiepipǝ sa mǝ akɛɛpǝ sa rɛyɩɩ ŋ́ po tuu lǝ́ rǝ Seyirǝ.» <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />Wǝ́ Esawʊ ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ maa enyipǝ sa pǝ siimǝ mǝ la arɛɛpǝ ŋ́ tǝnǝ rǝ lǝ́ kpǝŋ.» Wǝ́ Yakɔbǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto? Kulǝtǝyǝ, kǝ́ a la nyɩŋ mǝ tǝlarǝwǝ we, wǝ lo ro mǝ kaka.»<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Jirǝ we jirǝ we wǝ́ Esawʊ ŋ tǝ ŋ sìɛnɩ mǝ kʊŋwǝ we ŋ ko ŋ ko Seyirǝ. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Wǝ́ Yakɔbǝ ŋwǝ paa ŋ fǝ̀ ŋ ko ŋ ko Sukɔtǝ. Wǝ́ ŋ kolu ŋ tɔ̀ na nyarǝwǝ mǝ na akɛɛpǝ le bwiirǝ rǝ we. Wǝ kǝto pǝ lóo pwo fɛɛwǝ we ǝkǝnǝŋ Sukɔtǝ. Wǝlo duturǝ ɖi epwiiyǝ.<verse eid="GEN 33:17" /></para>
  <para style="s">Yakɔbǝ le ke fii Kanaŋ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Kǝ́ Yakɔbǝ ŋ rù rǝ Padaŋ Aramǝ ŋ kǝ ŋ pǝ we, wǝ́ ŋ pǝlǝ ŋ fìi Sikɛmǝ lǝ tǝŋtǝǝwǝ rǝ Kanaŋ lǝ gǝŋrǝ cʊrʊcʊrʊ. Wǝ́ ŋ kolu ŋ tɔ̀ kǝtiikǝ rǝ tǝŋtǝǝwǝ we la kǝlɛɛrɩkǝ. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Wǝ́ ŋ fùu kǝtǝǝwǝ sɩkakpotokpotoyǝ tuuru rǝ Sikɛmǝ lǝ tǝ Hamɔrǝ le epilepipǝ lǝ kpǝŋ. Fɛɛwǝ we wǝ́ ŋ tɔ̀ ne bwiirǝ wǝ. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Wǝ́ ŋ tɔ̀ otoolucuukǝ rǝ fɛɛwǝ we, wǝ́ ŋ kpìi kǝ la nyɩŋrǝ ǝkǝnǝŋ: «Ɛlǝ, Isǝrayɛlǝ lo Worokoyǝ.»<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">Simewɔŋ mǝ Levi pǝ la wʊʊlʊ enyipǝ rǝ Dina lo yurǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Jirɛɛrǝ we, Leya la kɔrʊyǝ we ŋ mǝnǝ ŋ kòonu Yakɔbǝ pǝ lóo pwo Dina sìri kolu ǝtǝŋtǝǝtǝpǝ we la akɔrʊpǝ lǝ kpǝŋ. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Wǝ́ Hivitǝpiliyǝ we rǝ gǝŋrǝ we pǝ lóo pwo Hamɔrǝ le pi Sikɛmǝ ŋ nyɩnɩ ŋwǝ, wǝ́ ŋ fǝ̀ ŋwǝ ŋ sùu ŋ kolu ŋ fìa mǝ ŋwǝ ŋ kpɛlɩ mǝ. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Wǝ́ Yakɔbǝ la kɔrʊ Dina lo tuwǝ wǝ ponu mǝ Sikɛmǝ ŋpa. Wǝ́ ŋ ka ŋ taa nǝ kǝǝwǝ, wǝ́ ŋ pɔ̀rʊ wǝ ŋ tìi Dina. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Wǝ́ Sikɛmǝ ŋ kolu ŋ tìi nǝ tǝ Hamɔrǝ ǝkǝnǝŋ: «Kǝ́ pǝ́ kɔrʊyǝ sa lo yurǝ o koonu mǝ ŋ́ lɔ». <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />Yakɔbǝ nunu wǝ ǝkǝnǝŋ Sikɛmǝ lǝ pǝlǝ na kɔrʊ Dina. Paape kǝ́ nǝ ǝpǝrǝŋpipǝ we pǝ kolu mǝ akɛɛpǝ rǝ bɔɔrǝ kǝto laa tɛŋ tǝrɛ. Wǝ́ ŋ màa pǝ pǝlǝ pǝ fìi kpɛŋ. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />Wǝ́ Sikɛmǝ lǝ tǝ Hamɔrǝ ŋ pǝlǝ ŋ pa wɛɛlɩ mǝ Yakɔbǝ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Kǝ́ Yakɔbǝ lǝ ǝpǝrǝŋpipǝ we pǝ lo ru rǝ bɔɔrǝ pǝ le pe fii we, wǝ́ pǝ nunu tuwǝ we wǝ lǝ pǝ wǝ. Wǝ́ wǝ kpìi pǝ la awɛɛlɩkǝ, wǝ́ pǝ fǝ̀ kpɛɛmʊrʊwǝ ŋpa, duturǝ ɖi Sikɛmǝ le kpii Isǝrayɛlǝ le kǝyepukǝ mǝ kǝ́ ŋ na ka fia mǝ Yakɔbǝ la kɔrʊyǝ ŋ na kpɛɛ mǝ wǝ. Le yee tuwǝ pǝ lǝŋ yee wǝ. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />Wǝ́ Hamɔrǝ ŋ wɛ̀ɛlɩ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ kɔrʊ lo tuwǝ wǝ ponu mǝ mǝ pi Sikɛmǝ ŋpa, kǝto nǝ dɔɔkpɛ, nǝ fǝ ŋwǝ nǝ koonu ŋwǝ ŋ lɔ oo. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Nǝ maa kǝ le yee nyiyǝ ceŋceŋ saŋ rǝ dielɔrǝ oo, kǝ lǝ mǝ fǝ nǝ akɔrʊpǝ la mǝ lɔ, kǝ nǝ mǝ fǝ lah akɔrʊpǝ nǝ mǝ lɔ. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Nǝ nyée tii nǝ kʊla mǝ lǝ, kǝ gǝŋrǝ sa gbɛɛ goonu nǝ faa. Nǝ nyóo koru e tii rǝ fɛɛ ri ŋ fɛɛ wǝ ponu mǝ nǝ faa, kǝ nǝ mǝ yee nǝ anǝnɛyǝ rǝ gǝŋrǝ sa kǝ nǝ nya otulǝmǝyǝ.»<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Wǝ́ Sikɛmǝ ŋ tìi Dina lǝ tǝ mǝ Dina le emǝteepǝ we ǝkǝnǝŋ: «Nǝ nyɩŋ mǝ tǝlarǝwǝ. Tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ nǝ ru rǝ mǝ akaakǝ we, ŋ́ nóo koonu nǝ wǝ. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Nǝ nyóo koru ǝsǝ oyupǝ́tuyǝ mǝ otukoonuyǝ nǝ tɛɛ mǝ ŋpa, kǝ ŋ́ lɛ ŋ́ mwara tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ nǝ ru rǝ mǝ akaakǝ wǝ. Nǝ nya nǝ fǝ kɔrʊyǝ sa nǝ koonu mǝ ŋ́ lɔ rǝ ko.» <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />Wǝ́ Yakɔbǝ lǝ ǝpǝrǝŋpipǝ we pǝ wɛ̀ɛlɩ mǝ Sikɛmǝ mǝ nǝ tǝ Hamɔrǝ pǝ tǝ̀ǝnǝ, duturǝ ɖi Sikɛmǝ lǝ pǝlǝ pǝla paatɛ Dina. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Pǝ tìi pǝ ǝkǝnǝŋ: «Yǝ lǝŋ koru eyee tuwǝ sa nǝ ya nǝ nyáa tɛŋ, kǝ lǝ fǝ lah paatɛ lo koonu fufoolǝtǝyǝ ŋ lɔ, wǝ lée kpii lǝ kǝyepukǝ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Kpɛŋ kǝ la pa tɛɛnɩ tuwǝ sa we, pǝ lǝ́ǝ kǝǝlǝ nǝ ǝpǝrǝŋpǝ kpǝlo kɩɩkɩ mǝŋ ŋlǝ kǝtǝ. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Mǝŋkǝsa we, nǝ nyóo koru a mǝ lɔ lah akɔrʊpǝ, kǝ ŋla ŋkpɛ la mǝ lɔ nǝ anɛŋpǝ. Yǝ lée tii la kʊla mǝ nǝ, kǝ la siɛrɩ le yee kǝkpǝŋkǝ kǝceŋceŋ. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Paa mǝŋ nǝ nyaa tɛɛnɩ pǝ kǝǝlǝ nǝ we, yǝ lǝ́ǝ fǝ lah kɔrʊ kǝ la pwɛyɩ.» <verse eid="GEN 34:17" /><verse number="18" style="v" sid="GEN 34:18" />Wǝ́ pǝle etieyǝ sa yǝ cà Hamɔrǝ mǝ ne pi Sikɛmǝ la kpɛɛ. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Kosopiyǝ we laa lɔ tuwǝ we pǝ tìi ŋwǝ ŋ ko kǝmaakǝ. Duturǝ ɖi ka ŋ taa Yakɔbǝ la kɔrʊ lǝ kǝǝwǝ ŋpa. Ŋwǝ ŋ ke ri nyiyǝ ŋ no ru okuruyǝ rǝ nǝ tǝ la nyarǝwǝ wǝ. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Wǝ́ Hamɔrǝ mǝ ne pi Sikɛmǝ pǝ kolu pǝlǝ tǝŋtǝǝwǝ lo guŋpolurǝ pǝ kolu pǝ tìi pǝlǝ ǝtǝŋtǝǝtǝpǝ ǝkǝnǝŋ: <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />«Enyitaarǝpǝ wǝ́ enyipǝ sa pǝ ri mǝ lǝ. Nǝ maa kǝ pǝ tii rǝ gǝŋrǝ sa, kǝ pǝ ŋ yee pǝla anǝnɛyǝ, kǝ gǝŋrǝ sa gbɛɛ goonu pǝ faa. Yǝ lóo koru alɔ pǝla akɔrʊpǝ, kǝ ŋla ŋkpɛ lǝ fǝ lah anɛŋpǝ lo koonu pǝ pǝ lɔ. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Mǝŋ yǝ láa tɛɛnɩ pǝ kǝǝlǝ lǝh ǝpǝrǝŋpǝ kpǝlo kɩɩkɩ mǝŋ kǝ́ pǝlǝ kǝǝlǝ pǝla anɛŋpǝ kǝtǝ we, pǝ láa tɛɛnɩ pǝ tii pǝ kʊla mǝ lǝ, kǝ la siɛrɩ le yee kǝkpǝŋkǝ kǝceŋceŋ. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Mǝŋ yǝ láa tɛɛnɩ we, eniyǝ we pǝ le pe tii pǝ la kʊla mǝ lǝ. Jirǝ rɛ eniyǝ sa pǝla akɛɛpǝ kpǝlo kɩɩkɩ mǝ pǝlo otulǝmǝyǝ yǝ la siɛrɩ yǝ le yee lah anɛŋ.» <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />Wǝ́ enyipǝ we kpǝlo kɩɩkɩ pǝ kǝ ŋ pǝ pǝ ŋ tɛlɩ rǝ guŋpolurǝ we pǝ tɛɛnɩ Hamɔrǝ mǝ ne pi Sikɛmǝ le dierǝ we. Wǝ́ pǝ kǝ̀ǝlǝ ǝpǝrǝŋpǝ we kpǝlo kɩɩkɩ pǝ kǝ ŋ pǝ pǝ ŋ tɛlɩ rǝ tǝŋtǝǝwǝ we lo guŋpolurǝ wǝ.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Juutatǝrǝ we, kǝ́ enyipǝ we pǝ ya pǝ lóo fuu we, wǝ́ Yakɔbǝ lǝ ǝpǝrǝŋpipǝ eyi, Simewɔŋ mǝ Levi, Dina le emǝteepǝ, pǝ fǝ̀ atʊkʊyǝ pǝ fìi tǝŋtǝǝwǝ we lǝ mǝrǝ vu lee yee pǝ, wǝ́ pǝ wʊ̀ʊlʊ ǝpǝrǝŋpǝ we kpǝlo kɩɩkɩ. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Wǝ́ pǝ lɛ̀ pǝ tù Hamɔrǝ mǝ ne pi Sikɛmǝ la tʊkʊwǝ pǝ wʊlʊ. Wǝ́ pǝ kolu pǝ fǝ̀ Dina rǝ Sikɛmǝ la nyarǝwǝ wǝ́ pǝ pwɛ̀yɩ. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Wǝ́ Yakɔbǝ lǝ ǝpǝrǝŋpituturupǝ we pǝ kolu pǝ yɩ̀ɩ enyiǝtǝpǝ we lo okurutuyǝ we pǝ ke re wǝ, wǝ́ pǝ yɩ̀ɩ otuyǝ kpǝlo rǝ tǝŋtǝǝwǝ we pǝ pwɛ̀yɩ. Duturǝ ɖi pǝ le si pǝla paatɛ pǝ la kpɛɛ mǝ.<verse eid="GEN 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 34:28" />Wǝ́ pǝ fǝ̀ ǝtǝŋtǝǝtǝpǝ we la amɛɛpǝ mǝ pǝle epereceepǝ mǝ pǝla anɛŋpǝ mǝ pǝlo orookɛtɛpǝ fǝ kʊla mǝ tu ri ŋ tu pǝ nyɩnɩ rǝ tǝŋtǝǝwǝ we mǝ wǝtɛɛkpǝ pǝ pwɛ̀yɩ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Wǝ́ pǝ lɔ̀ ǝtǝŋtǝǝtǝpǝ we le etiepǝ kpǝlo mǝ pǝle epipǝ kpǝlo. Wǝ́ pǝ wʊ̀ʊ pǝlo otulǝmǝyǝ fǝ kʊla mǝ tu ri ŋ tu wǝ ka kpɛlɩ rǝ nyarǝwǝ pǝ pwɛ̀yɩ. <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />Wǝ́ Yakɔbǝ ŋ tìi Simewɔŋ mǝ Levi ǝkǝnǝŋ: «Nǝ nya wʊ mǝ nǝ nyo co mǝ kǝ́ nǝ nyǝ pǝlǝ mǝ nyɩŋrǝ rǝ Akanaŋtǝpǝ mǝ Eperisitǝpǝ sa pǝ kpii rǝ gǝŋrǝ sa le enimiyǝ wǝ. Yǝ lee ce la naanǝ. Pǝ láa ca pǝ ku kǝ pǝ yi pǝ tɛɛ rǝ mǝ. Pǝ láa wʊ mǝ, ŋlǝ mǝ mǝ anyarǝtǝpǝ.» <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />Wǝ́ Simewɔŋ mǝ Levi pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Wǝ kaamǝ kǝ pǝ yee mǝ lah paatɛ mǝŋ tuutuuyǝ kǝtǝ?»<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">Worokoyǝ la pɛɛrɩ Yakɔbǝ rǝ Bɛtɛlǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Jirɛɛrǝ Worokoyǝ tìi Yakɔbǝ ǝkǝnǝŋ: «Yi o mǝ ko Bɛtɛlǝ, kǝ e ke tii rǝ we. Ka tɔ otoolucuukǝ rǝ we o koonu Worokoyǝ we ŋ pɔ̀rʊ na wɛ ŋ kanǝ lǝ́ mǝ eniyǝ we o sùu a pwɛ̀yɩ rǝ lé mǝtee Esawʊ lǝ kpǝŋ wǝ.» <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />Wǝ́ Yakɔbǝ ŋ tìi na anyarǝtǝpǝ mǝ epǝ we kpǝlo pǝ ke siimǝ ŋwǝ ǝkǝnǝŋ: «Nǝ pɔrʊ ǝsǝǝworokopǝ we pǝ kpii rǝ nǝ mǝrǝ nǝ co. Nǝ yee mǝ nǝ wɛ kenikeni, kǝ nǝ cɛkɛlɛ wǝkpakpǝ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Nǝ yi kǝ lo ko Bɛtɛlǝ kǝ ŋ́ ka tɔ otoolucuukǝ ŋ koonu Worokoyǝ we ŋ tonu mǝ rǝ mǝ arianyɩŋyǝ lǝ mǝrǝ wǝ. Ŋwǝ ŋ rè mǝ rǝ mǝ gʊŋsaŋrǝ wǝ.» <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Wǝ́ enyipǝ we pǝ pɔ̀rʊ ǝsǝǝworokopǝ we kpǝlo pǝ ke re, mǝ otukoŋwarǝpiyǝ we pǝ ke kpii pǝ kòonu Yakɔbǝ. Wǝ́ Yakɔbǝ ŋ nyini fuŋwǝ ŋ fǝ̀ yǝ ŋ pǝnǝ rǝ wǝciimumuŋkpǝ rɛ lǝ kǝnǝŋkǝ rǝ Sikɛmǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko. Wǝ́ Worokoyǝ ŋ kòonu vumumuŋrǝ rɛ vìi ǝtǝŋtǝǝyǝ we yǝ kpii rǝ gaarǝ we, kǝto rɛ loo tu turuwǝ ŋ yi ŋ piri Yakɔbǝ le epipǝ mǝ ŋ pǝ. <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />Wǝ́ Yakɔbǝ ŋ kolu ŋ fìi Lusǝ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Bɛtɛlǝ rǝ Kanaŋ lǝ gǝŋrǝ, ŋpǝ mǝ enyipǝ we kpǝlo pǝ ke siimǝ ŋwǝ wǝ. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Wǝ́ ŋ tɔ̀ otoolucuukǝ rǝ fɛɛwǝ we. Wǝ́ ŋ kpìi wǝ la nyɩŋrǝ ǝkǝnǝŋ: «Ɛlǝ Bɛtɛlǝ» kpiikǝ fɛɛwǝ sa wǝ́ Worokoyǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ ŋwǝ mǝ eniyǝ we ŋ sùu ŋ pwɛ̀yɩ rǝ ne mǝtee lǝ kpǝŋ wǝ. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />Wǝ́ Debora ŋ pǝlǝ ŋ kpǝ̀. Ŋwǝ Deborayǝ sa ŋ ke ŋ re Rebeka mǝ kǝpiŋwɛŋkǝ. Wǝ́ pǝ ŋwàa ŋwǝ rǝ Bɛtɛlǝ la kǝlɛɛrɩkǝ rǝ wǝciimumuŋkpǝ rɛ lǝ kǝnǝŋkǝ. Yakɔbǝ ko ŋ pwo wǝciikpǝ we ǝkǝnǝŋ eweekǝ le wǝciikpǝ. <verse eid="GEN 35:8" /><verse number="9" style="v" sid="GEN 35:9" />Wǝ́ Worokoyǝ ŋ tǝ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Yakɔbǝ mǝ eniyǝ we ŋ rù rǝ Padaŋ Aramǝ ŋ kǝ ŋ pǝ wǝ. Wǝ́ ŋ pɛ̀ɛrɩ ŋwǝ. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Wǝ́ Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá nyɩŋrǝ ɖi Yakɔbǝ, paape pǝ lǝŋ tǝ pǝ ŋ pwo lǝ́ Yakɔbǝ. Pǝ lóo mǝ pwo lǝ́ Isǝrayɛlǝ.» Wǝ́ Worokoyǝ ŋ pwò ŋwǝ Isǝrayɛlǝ. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />Wǝ́ Worokoyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Worokokopilǝtǝyǝ. Ŋ́ nóo koonu kǝ ǝmǝ epipǝ kǝ pǝ yaarǝ, kǝ a siɛrɩ e yee kǝkpǝŋmumuŋkǝ rɛ mǝ wǝkpǝŋmumuŋkpǝ rɛ lǝ tǝtǝtǝtǝyǝ. Epilipǝ pǝ lóo ru rǝ lǝ́ wǝmǝkpǝ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Ŋ́ nǝ́ǝ fǝ gǝŋrǝ we ŋ́ kòonu Abǝrahamǝ mǝ Isakǝ ŋ́ koonu lǝ́, kǝ ŋ́ pǝ fǝ rǝ ŋ koonu lǝ́ wǝmǝkpǝ we pǝ lǝh pǝ mǝ rǝ lá kǝmaakǝ wǝ.»<verse eid="GEN 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />Wǝ́ Worokoyǝ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we ŋ wɛ̀ɛlɩ mǝ ŋwǝ ŋ ka ŋ rɛ. <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />Wǝ́ Yakɔbǝ ŋ fǝ̀ ɖurǝ ŋ tɔ̀ rǝ fɛɛwǝ we Worokoyǝ ŋ wɛ̀ɛlɩ mǝ ŋwǝ wǝ. Wǝ́ ŋ cò apɔŋpǝ ŋ fìeni rǝ, wǝ́ ŋ lɛ̀ ŋ cò ǝfǝŋpǝ ŋ fìeni rǝ. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Wǝ́ Yakɔbǝ ŋ ko ŋ pwo fɛɛwǝ we Worokoyǝ ŋ wɛ̀ɛlɩ mǝ ŋwǝ ǝkǝnǝŋ Bɛtɛlǝ<note caller="+" style="f"><char style="fr" closed="false">35:15 </char><char style="ft" closed="false">Wǝlo duturǝ ɖi Worokoyǝ la nyarǝwǝ.</char></note>.<verse eid="GEN 35:15" /></para>
  <para style="s">Bɛnǝyaminǝ lǝ ǝmǝkǝ mǝ Rasiɛlǝ lǝ ǝkpǝ́kǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Yakɔbǝ mǝ na anyarǝtǝpǝ pǝ pwɛ̀yɩ rǝ Bɛtɛlǝ pǝ ko ŋ ko. Kǝ́ pǝ lǝh kǝlǝ mǝ Efǝrata we, wǝ́ Rasiɛlǝ ŋ mǝnǝ. Nǝ ǝmǝkǝ sa kǝ ka lɛnyɩ. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Eniyǝ we ŋ yà ŋ kǝ ŋ mǝ mǝ ŋ faŋ we, wǝ́ tieyǝ we ŋ nǝ́ǝ mǝǝnǝ enyipǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Poo suu vurǝ duturǝ ɖi ǝ lǝ tǝ ǝ lǝ mǝ bǝrǝŋpirǝ.» <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Kǝ́ Rasiɛlǝ ŋ nah ta ŋ kpǝ́ we, wǝ́ ŋ kpìi piyǝ we la nyɩŋrǝ ǝkǝnǝŋ Bɛnǝwoni. Wǝlo duturǝ ɖi arianyɩŋyǝ le piyǝ. Paa wǝ́ nǝ tǝ ŋ ko ŋ pwo ŋwǝ Bɛnǝyaminǝ. Wǝlo duturǝ ɖi kǝnirikǝ lǝ bǝrǝŋpirǝ. <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />Wǝ́ Rasiɛlǝ ŋ kpǝ̀, wǝ́ pǝ ŋwàa ŋwǝ rǝ Efǝrata pǝ lǝ́ǝ tǝ pǝ ŋ pwo Bɛtǝlɛhɛmǝ la gʊŋrǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Wǝ́ Yakɔbǝ ŋ tɔ̀ ɖurǝ rǝ Rasiɛlǝ lo vuŋtɔŋrǝ we. Pǝ lóo pwo rǝ ǝkǝnǝŋ Rasiɛlǝ lo vuŋtɔŋrǝ lo ɖurǝ. Wǝ́ ɖurǝ we dǝ dɔ̀ po ro ruŋruŋ.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Wǝ́ Isǝrayɛlǝ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we ŋ kolu ŋ tɔ̀ ne bwiirǝ rǝ Midalǝ Edɛrǝ la kǝmaakǝ. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />Eniyǝ we ŋ kolu ŋ tini rǝ gaarǝ we we, wǝ́ Rubɛnǝ ŋ kolu ŋ kpɛlɩ mǝ nǝ tǝ le pwetaatieyǝ Bila. Wǝ́ Isǝrayɛlǝ ŋ nunu wǝ. Yakɔbǝ lǝ ǝpǝrǝŋpipǝ pǝ kǝ lǝ tǝ mǝ eyi. <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />Leya lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ ǝnǝ:</para>
  <para style="q1" vid="GEN 35:23">Rubɛnǝ ŋ ri Yakɔbǝ le pisǝŋmǝyǝ, Simewɔŋ, Levi, Yuda, Isaka mǝ Zabulɔŋ.<verse eid="GEN 35:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 35:24" />Rasiɛlǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ ǝnǝ:</para>
  <para style="q1" vid="GEN 35:24">Yosɛfʊ mǝ Bɛnǝyaminǝ.<verse eid="GEN 35:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="GEN 35:25" />Rasiɛlǝ la sʊmatǝtieyǝ we pǝ lóo pwo Bila lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ ǝnǝ:</para>
  <para style="q1" vid="GEN 35:25">Daŋ mǝ Nɛfǝtali.<verse eid="GEN 35:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="GEN 35:26" />Leya la sʊmatǝtieyǝ we pǝ lóo pwo Zilǝpa lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ ǝnǝ:</para>
  <para style="q1" vid="GEN 35:26">Gadǝ mǝ Asɛrǝ.</para>
  <para style="m" vid="GEN 35:26">Ŋpǝ pǝ ri ǝpǝrǝŋpipǝ we pǝ mǝnǝ pǝ kòonu Yakɔbǝ rǝ Padaŋ Aramǝ wǝ.<verse eid="GEN 35:26" /></para>
  <para style="s">Isakǝ lǝ ǝkpǝ́kǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Yakɔbǝ pǝlǝ nǝ tǝ lǝ kpǝŋ rǝ Mamǝre rǝ Kirǝya Arǝba pǝ lǝ́ǝ tǝ pǝ ŋ pwo Hebǝrɔŋ. Fɛɛwǝ we wǝ́ Abǝrahamǝ mǝ Isakǝ pǝ ke ce pǝ kpii wǝ. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Isakǝ lɔ̀ cɛŋwǝ tuuru mǝ tǝnɛŋ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Wǝ́ ŋ kpǝ́ ŋ kolu ŋ tùu nǝ ǝtǝtǝpǝ. Tini vɔrʊrǝ kùru kɔfɩkɔfɩ. Wǝ́ nǝ ǝpǝrǝŋpipǝ Esawʊ mǝ Yakɔbǝ pǝ ŋwàa ŋwǝ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Esawʊ le etiepǝ mǝ ne epipǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Esawʊ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Edɔmǝ lǝ wǝmǝkpǝ wǝ kaamǝ gbǝ ǝnǝ. <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />Akanaŋtǝtiepǝ we Esawʊ ŋ lɔ̀ pǝ kaamǝ: Hititǝkɛrɩyǝ we pǝ lóo pwo Elɔŋ la kɔrʊ Ada, Hivitǝkɛrɩyǝ we pǝ lóo pwo Ana la kɔrʊ Oholibama ŋ ɖi Sibewɔŋ le pilepiyǝ wǝ, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />fǝ kʊla mǝ Isǝmayɛlǝ la kɔrʊ Basǝma, Nebayɔtǝ la paatɛyǝ. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />Ada mǝnǝ Elifazǝ kòonu Esawʊ, wǝ́ Basǝma ŋ mǝnǝ Rewɛlǝ ŋ kòonu ŋwǝ. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Oholibama ŋ mǝnǝ Yewusǝ, Yalamǝ mǝ Kora.</para>
  <para style="p" vid="GEN 36:5">Ǝpǝrǝŋpipǝ sa wǝ́ pǝ mǝnǝ pǝ kòonu Esawʊ rǝ Kanaŋ wǝ.<verse eid="GEN 36:5" /></para>
  <para style="s">Esawʊ la pwɛyɩ le ke tii rǝ Seyirǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />Esawʊ fǝ̀ ne etiepǝ, no okosopipǝ mǝ na akɔsɔkɔrʊpǝ mǝ na anyarǝtǝpǝ kpǝlo, na akɛɛpǝ, na amɛɛpǝ mǝ ne epereceepǝ kpǝlo fǝ kʊla mǝ no otulǝmǝyǝ we kpǝlo ŋ nyà rǝ Kanaŋ wǝ, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko gǝŋrǝ rɛ lǝǝ kǝlǝ mǝ na paanʊ Yakɔbǝ wǝ. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Duturǝ ɖi pǝlo otulǝmǝyǝ yǝ ka naanǝ kururu kǝto pǝ lǝŋ koru etii fɛɛceŋceŋ. Wǝ́ gǝŋrǝ we pǝ cè pǝ kolu pǝ tini lǝǝ tǝ go ŋ ro pǝla akɛɛpǝ. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Wǝ́ Esawʊ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Edɔmǝ ŋ kolu ŋ tini rǝ Seyirǝ lo otutupiyǝ la gaarǝ.<verse eid="GEN 36:8" /></para>
  <para style="s">Esawʊ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Edɔmǝtǝpǝ lǝ tǝtǝtǝtǝyǝ ŋ kaamǝ Esawʊ. Nǝ wǝmǝkpǝ mǝ eniyǝ we ŋ kolu ŋ tini rǝ Seyirǝ lo otutupiyǝ la gaarǝ wǝ kaamǝ gbǝ ǝnǝ. <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />Nǝ ǝpǝrǝŋpipǝ la anyɩŋyǝ yǝ kaamǝ ǝyǝ: Ne tie Ada lo kosopi Elifazǝ mǝ ne tie Basǝma lo kosopi Rewɛlǝ. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />Elifazǝ lǝ ǝpǝrǝŋpipǝ pǝ ka kaamǝ Temaŋ, Omarǝ, Sefo, Gatamǝ mǝ Kenasǝ. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Timǝna ŋ ke ri Esawʊ lo kosopi Elifazǝ le pwetaatieyǝ. Wǝ́ ŋ mǝnǝ Amalɛkǝ ŋ kòonu Elifazǝ. Kǝto Esawʊ le tie Ada le epilepipǝ pǝ kaamǝ epǝ we.<verse eid="GEN 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 36:13" />Rewɛlǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ, Nahatǝ, Zera, Sama mǝ Miza. Esawʊ le tie Basǝma le epilepipǝ pǝ kaamǝ ǝpǝ we. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />Esawʊ le tie Oholibama, ŋwǝ ŋ ri Ana la kɔrʊyǝ, wǝ́ ŋ tǝ ŋ ri Sibewɔŋ le pilepiyǝ. Mǝnǝ Yewusǝ, Yalamǝ mǝ Kora kòonu Esawʊ.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Esawʊ lǝ wǝmǝkpǝ lo omumuŋpǝ pǝ kaamǝ ǝpǝ ǝnǝ: Elifazǝ ŋ ri Esawʊ lǝ bǝrǝŋpisǝsǝŋrǝ. Nǝ wǝmǝkpǝ lo omumuŋpǝ pǝ kaamǝ ne epipǝ sa ǝnǝ: Temaŋ, Omarǝ, Sefo, Kenasǝ, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />Kora, Gatamǝ mǝ Amalɛkǝ. Ŋpǝ ǝpǝ pǝ ke ri Elifazǝ lǝ wǝmǝkpǝ lo omumuŋpǝ rǝ Edɔmǝ wǝ. Ŋpǝ pǝ ri Ada lǝ epilepipǝ. <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />Esawʊ le pi Rewɛlǝ lǝ wǝmǝkpǝ lo omumuŋpǝ pǝ kaamǝ: Nahatǝ, Zera, Sama mǝ Miza. Ǝpǝ pǝ ke ri Rewɛlǝ lǝ wǝmǝkpǝ lo omumuŋpǝ rǝ Edɔmǝ. Ŋpǝ pǝ ke ri Esawʊ le tie Basǝma le epilepipǝ. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />Esawʊ le tie Oholibama lǝ ǝpǝrǝŋpipǝ we pǝ ri wǝmǝkpǝ lo omumuŋpǝ pǝ kaamǝ: Yewusǝ, Yalamǝ mǝ Kora. Ŋpǝ ǝpǝ pǝ ri Esawʊ le tie Oholibama lǝ ǝpǝrǝŋpipǝ we pǝ ri wǝmǝkpǝ lo omumuŋpǝ. Ana la kɔrʊyǝ ŋ ri Oholibama. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />Ŋpǝ ǝpǝ pǝ ri Esawʊ lǝ ǝpǝrǝŋpipǝ mǝ pǝlǝ wǝmǝkpǝ lo omumuŋpǝ. Esawʊ wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Edɔmǝ.<verse eid="GEN 36:19" /></para>
  <para style="s">Seyirǝ lǝ wǝmǝkpǝ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Horitǝnyiyǝ we pǝ lóo pwo Seyirǝ ŋ ke kpii rǝ Edɔmǝtǝpǝ lǝ gǝŋrǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ ǝpǝ: Lotaŋ, Sovalǝ, Sibewɔŋ, Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Disɔŋ, Esɛrǝ mǝ Disaŋ. Ŋpǝ Seyirǝ le epipǝ sa pǝ ke ri Hori lǝ wǝmǝkpǝ lo omumuŋpǝ rǝ Edɔmǝ lǝ gǝŋrǝ wǝ. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />Lotaŋ lǝ ǝpǝrǝŋpipǝ pǝ ka kaamǝ Hori mǝ Hemamǝ. Lotaŋ la paatɛ ŋ ke ri Timǝna. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />Sovalǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Alǝwaŋ, Manahatǝ, Evalǝ, Sefo mǝ Onamǝ. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />Sibewɔŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Aya mǝ Ana. Ana ŋ kolu ŋ nyɩnɩ kǝ mɛŋkunaawǝ wǝ ya wǝ lée wee rǝ nyɔŋkpaakǝtǝǝwǝ mǝ eniyǝ we ŋ kǝ ŋ rǝŋ nǝ tǝ Sibewɔŋ lo orookɛtɛpǝ wǝ. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />Ana le epipǝ pǝ kaamǝ: na kɔrʊ Oholibama mǝ no kosopi Disɔŋ. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />Disɔŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Hɛmǝda, Ɛsǝba, Yitǝraŋ mǝ Keraŋ. <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />Esɛrǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Bilaŋ, Zawaŋ, Akaŋ. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />Disaŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Usǝ mǝ Araŋ. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />Hori lǝ wǝmǝkpǝ lo omumuŋpǝ pǝ kaamǝ: Lotaŋ, Sovalǝ, Sibewɔŋ, Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Disɔŋ, Esɛrǝ, Disaŋ. Hori lǝ wǝmǝkpǝ lo omumuŋpǝ we pǝ ke kpii rǝ Seyirǝ lǝ gǝŋrǝ wǝǝ. <verse eid="GEN 36:30" /><verse number="31" style="v" sid="GEN 36:31" />Epilipǝ we pǝ le tii pǝ la pa tɛlɩ rǝ Edɔmǝ lǝ gǝŋrǝ kpɛŋ wǝ́ Isǝrayɛlǝtǝpiyǝ ŋ ci ǝpǝlǝ ŋ tini wǝpilikpǝ pǝ kaamǝ: <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />Bewɔrǝ le pi Bela tini wǝpilikpǝ rǝ Edɔmǝ. Nǝ tǝŋtǝǝwǝ wǝ ka kaamǝ Dinaba. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />Kǝ́ Bela ŋ kpǝ̀ we, wǝ́ Zera le pi Yobabǝ ŋ no ru rǝ Bosǝra ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />Kǝ́ Yobabǝ ŋ nǝ kpǝ́ we, wǝ́ Husamǝ ŋ no ru rǝ Temaŋ la gaarǝ ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />Kǝ́ Husamǝ ŋ nǝ kpǝ́ we, wǝ́ Bedadǝ le pi Hadadǝ ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. Wǝ́ ŋ rili Amadiaŋtǝpǝ lo yurǝ rǝ Mowabǝ lǝ gǝŋrǝ. Nǝ tǝŋtǝǝwǝ wǝ ke ri Avivǝ. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />Kǝ́ Hadadǝ ŋ nǝ kpǝ́ we, wǝ́ Hamǝla ŋ no ru rǝ Maseka ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />Kǝ́ Hamǝla ŋ nǝ kpǝ́ we, wǝ́ Sawulǝ ŋ no ru rǝ Rewobɔtǝ Naharǝ ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />Kǝ́ Sawulǝ ŋ nǝ kpǝ́ we, wǝ́ Akǝbɔrǝ le pi Balǝ Hanaŋ ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />Kǝ́ Akǝbɔrǝ le pi Balǝ Hanaŋ ŋ nǝ kpǝ́ we, wǝ́ Hadarǝ ŋ no ru rǝ Pawu ŋ pǝlǝ ŋ tini wǝpilikpǝ rǝ no yuwǝ. Ne tie wǝ́ pǝ ko ŋ pwo Metabɛlǝ. Marɛdǝ la kɔrʊyǝ ŋ kǝ lǝǝwe. Nǝ tǝtǝ ŋ ke ri Mezabǝ<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Esawʊ lǝ wǝmǝkpǝ lo omumuŋpǝ la anyɩŋyǝ mǝ pǝle kǝtiikǝ mǝ pǝla anyarǝyǝ yǝ kaamǝ ǝyǝ ǝnǝ: Timǝna, Alǝva, Yetɛtǝ, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Oholibama, Ɛla, Pinɔŋ, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Kenasǝ, Temaŋ, Mibǝsarǝ, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Madiɛlǝ, Iramǝ. Edɔmǝ lǝ wǝmǝkpǝ lo omumuŋpǝ mǝ pǝle kǝtiikǝ rǝ gǝŋrǝ we ge ri pǝla nɛŋ wǝǝ. Esawʊ ŋ ri Edɔmǝtǝpǝ lǝ tǝtǝtǝtǝyǝ.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">Yosɛfʊ mǝ nǝ emǝteepǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Yakɔbǝ ke kpii rǝ Kanaŋ lǝ gǝŋrǝ. Gǝŋrǝ sa wǝ́ nǝ tǝ ŋ cè ŋ kolu ŋ tini wǝ. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />Yakɔbǝ le dierǝ gaamǝ ɖǝ ǝnǝ. Yosɛfʊ kǝ lǝǝmǝ cɛŋwǝ tǝ mǝ pǝrɩmata, wǝ́ ŋ ke ŋ siimǝ ne emǝteepǝ mǝ ŋ ko fɛɛrǝŋamɛɛpǝ mǝ epereceepǝ. Nǝ tǝ le etiepǝ Bila mǝ Zilǝpa le epipǝ pǝ ke ri ne emǝteepǝ sa. Wǝ́ Yosɛfʊ ŋ kǝ ŋ fǝ ne mǝtee peni le etierɔɔrɔɔyǝ we pǝ ka ŋ tɛŋ mǝ ŋ pǝ mǝ ŋ pɔ pǝlǝ tǝ la amayǝ. <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />Isǝrayɛlǝ ka ŋ taa Yosɛfʊ lǝ kǝǝwǝ mǝ ŋ teeri ne epituturupǝ we, duturǝ ɖi mǝnǝ ŋwǝ mǝ eniyǝ we ŋ kùru wǝ. Kàla kǝkpakpurumukǝ rɛ mǝ okuruyǝ kòonu ŋwǝ. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Ne emǝteepǝ we pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ pǝlǝ tǝ láa taa Yosɛfʊ lǝ kǝǝwǝ mǝ ŋ teeri pǝlo kpǝlo. Kǝto pǝ kpǝ̀lǝ nǝ kǝǝwǝ wǝ́ pǝ ka ŋ wɛɛlɩ mǝ ŋwǝ pǝ ŋ fapǝ rǝ. <verse eid="GEN 37:4" /><verse number="5" style="v" sid="GEN 37:5" />Jirɛɛrǝ wǝ́ Yosɛfʊ ŋ kpɛlɩ kǝtʊkpɛɛkǝ. Wǝ́ ŋ fǝ̀ ŋ tìi ne mǝtee peni. Wǝ́ pǝ tǝ pǝ kpǝ̀lǝ nǝ kǝǝwǝ pǝ kʊ̀la. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Tìi pǝ ǝkǝnǝŋ: «Nǝ nuŋ kǝtʊkpɛɛkǝ rɛ ŋ́ na kpɛɛ re. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />La yaa rǝ atɛɛkǝ yǝ láa parǝ otoyǝ. Kǝtǝrǝceŋceŋ ko wǝ́ mǝ dorǝ le yi la ya, wǝ́ nǝ anɛŋyǝ yǝ lo po cò yǝ le siri rǝ, wǝ́ yǝ la pɛɛlɩ yǝ lo koonu rǝ.» <verse eid="GEN 37:7" /><verse number="8" style="v" sid="GEN 37:8" />Wǝ́ ne emǝteepǝ we pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «We a ya lǝ́ǝ pǝ́ e ri leh piliyǝ kǝ e ri loh yurǝ?» Wǝ́ pǝ tǝ pǝ kpǝ̀lǝ nǝ kǝǝwǝ pǝ kʊ̀la rǝ na wǝtʊkpɛɛkpǝ we mǝ etieyǝ we ŋ ya ŋ náa tɛŋ wǝ. <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />Yosɛfʊ tǝ kpɛlɩ kǝtʊkpɛɛkǝ, wǝ́ ŋ fǝ̀ kǝ ŋ tìi ne mǝtee peni: «Nǝ yɩrɩ re, ŋ́ nǝ tǝ ŋ́ na kpɛɛ kǝtʊkpɛɛkǝ ǝkǝnǝŋ cɔkɔŋyǝ mǝ kɛɛnyɔŋyǝ mǝ wǝŋɔŋkpǝ tǝ mǝ wǝceŋceŋ yǝ ya yǝ láa pɛɛlɩ yǝ ŋ koonu mǝ.» <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />Wǝ́ Yosɛfʊ ŋ fǝ̀ kǝtʊkpɛɛkǝ sa ŋ kolu ŋ tìi nǝ tǝ ŋwǝ ŋkpɛ. Wǝ́ Yakɔbǝ ŋ kpanǝ mǝ ŋwǝ. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝtʊkpɛɛkǝ sa a la kpɛɛ lo duturǝ ɖi nɛ? Ŋlǝ mǝ lé lee mǝ lé mǝtee peni la pa sʊʊ la kʊŋ la tɔ kǝtukǝ rǝ kǝtǝǝwǝ lo koonu lǝ́?» <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Wǝ́ ne mǝtee peni pǝ fǝ̀ na kpɛɛmʊrʊwǝ. Wǝ́ nǝ tǝ paa ŋ lɔ̀ otuyǝ sa ŋ kpii rǝ yurǝ.<verse eid="GEN 37:11" /></para>
  <para style="s">Pǝ le siiri Yosɛfʊ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Jirɛɛrǝ Yosɛfʊ le emǝteepǝ pǝ kolu pǝ kǝ ŋ rǝŋ pǝlǝ tǝ le epereceepǝ mǝ amɛɛpǝ rǝ bɔɔrǝ rǝ Sikɛmǝ. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Wǝ́ nǝ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lé mǝtee peni pǝ ya pǝ lǝ́ǝ rǝŋ akɛɛpǝ rǝ Sikɛmǝ. Ŋ́ neh kpii lǝ́ rǝ pǝlǝ kpǝŋ oo.» Wǝ́ Yosɛfʊ ŋ tɛ̀ɛnɩ ǝkǝnǝŋ: «Yoo, mǝ tǝ». <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />Wǝ́ Isǝrayɛlǝ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Ko a ka yɩrɩ lé mǝtee peni mǝ akɛɛpǝ we pǝ kpii sɩsiɛrɩ? Kǝ a siɛnɩ e pe tíi mǝ.» Ke kpii rǝ Hebǝrɔŋ la gbɛnɛŋrǝ, wǝ́ ŋ kpìi Yosɛfʊ. Wǝ́ Yosɛfʊ ŋ kolu ŋ fìi Sikɛmǝ. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />Wǝ́ kɛrɩyǝ rɛ ŋ kolu ŋ nyɩnɩ ŋwǝ taa ne mǝtee peni láa tɛlɩ rǝ gborǝ we. Wǝ́ kɛrɩyǝ we ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ a ya láa taa?» <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />Wǝ́ Yosɛfʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ náa taa mǝ mǝtee peni. Dɔɔkpɛ, kaŋ mǝ fɛɛwǝ we pǝ ya pǝ lǝ́ǝ rǝŋ akɛɛpǝ wǝ.» <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />Wǝ́ kɛrɩyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ la pwɛyɩ rǝ fɛɛwǝ sa. Ŋ́ no nuŋ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ pǝ loh ko Dotaŋ.» Wǝ́ Yosɛfʊ ŋ sìimǝ ne mǝtee peni la akʊŋyǝ, wǝ́ ŋ kolu ŋ nyɩnɩ pǝ rǝ Dotaŋ.<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />Wǝ́ ne mǝtee peni pǝ nyɩnɩ ŋwǝ pǝ manǝ. Kpɛŋ kǝ ŋ pǝ kǝlǝ mǝ pǝ we, wǝ́ pǝ rili nyuŋkpǝ kǝ pǝ wʊ ŋwǝ. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />Wǝ́ pǝ tìi awɛ ǝkǝnǝŋ: «A lǝŋ nyɩŋ, yǝ we ŋ náa kpɛɛlɩ wǝtʊkpɛɛkpǝ ŋ nǝ́ǝ pǝ ǝnǝ. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Rǝkǝsa nǝ pǝ kǝ la wʊ ŋwǝ, kǝ lǝ fǝ ŋwǝ le tie le kpii rǝ ofuŋyǝ<note caller="+" style="f"><char style="fr" closed="false">37:20 </char><char style="ft" closed="false">Pǝ nyini ofuŋyǝ sa pǝ ŋ lɔ ŋʊŋtɛmɛŋwǝ rǝ.</char></note> sa la rɛ lǝ mǝrǝ, kǝ la ka tɛŋ ǝkǝnǝŋ kɛɛlɔyǝ rɛ ŋ na lɔ ŋwǝ. Eniyǝ we yǝ láa nyɩŋ kǝ́ na wǝtʊkpɛɛkpǝ we wǝ lée yee kǝ wǝ po ru wǝ.» <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />Rubɛnǝ yà ko ŋ nuŋ etieyǝ sa, wǝ́ ŋ kǝ ŋ pǝ́ ŋ pɔrʊ Yosɛfʊ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Rɛ ŋ paa wʊ ŋwǝ». <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Wǝ́ ŋ tǝ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ paa lʊ ŋpǝrayǝ. Nǝ fǝ ŋwǝ nǝ tie nǝ kpii rǝ nyɔŋkpaakǝtǝǝwǝ lo fuŋwǝ sa. Rɛ ŋ poo ruu ŋwǝ.» Rubɛnǝ tɛnɩ wǝ ǝnǝ kǝ ŋ nya fɛɛ ŋ pɔrʊ ŋwǝ kǝ ŋ fǝ̀ ŋwǝ ŋ ko koonu nǝ tǝ. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />Kǝ́ Yosɛfʊ ŋ no po tuu ne mǝtee peni we, wǝ́ pǝ lɔ̀ ŋwǝ. Wǝ́ pǝ pɔ̀rʊ kǝkpakǝ we ŋ ke kpii wǝ, na kǝkpakǝ we kǝ lo ru okuruyǝ wǝ. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />Wǝ́ pǝ lɔ̀ Yosɛfʊ pǝ tìe pǝ kpìi rǝ fuŋwǝ we. Fuŋwǝ we wǝ ka kpɛlɩ akpaakpa, mɛŋwǝ wǝ lee ke kpii rǝ wǝ. <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />Wǝ́ pǝ sɔ̀ pǝ tini pǝ ke ŋ ri. Kǝ́ pǝ le yiili anyɩŋkǝ eni we, wǝ́ pǝ nyɩnɩ kǝ́ Isǝmayɛlǝ lǝ wǝmǝkpǝ lǝ kpǝŋwǝ rɛ wǝ lǝ́ǝ pǝ wǝ. Pǝ lo ru rǝ Galadǝ pǝ loh ko Ejipǝte. Pǝla akpɔŋkɔpǝ pe ke re wǝciikpǝ kpookpoo wǝta la amɛŋfɛŋfɛŋyǝ.<note caller="+" style="f"><char style="fr" closed="false">37:25 </char><char style="ft" closed="false">Pǝ kǝ ŋ fǝ eciyǝ sa pǝ ŋ ca enyipǝ, wǝ́ pǝ ka ŋ lɛ pǝ ŋ fǝ yǝ pǝ ŋ nuŋ enyiǝtǝpǝ kǝ pǝ kpɛɛ pǝ panǝ. </char></note> <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />Wǝ́ Yuda ŋ tìi na apaanʊpǝ we ǝkǝnǝŋ: «Mǝŋ yǝ la wʊ lah paanʊ, wǝ́ yǝ la ŋwaa na gbɛŋrǝ wǝǝ, kǝ́ wǝ́ yǝ lah nya rǝ mǝrǝ we? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Nǝ pǝ kǝ lǝ fǝ ŋwǝ le siiri lo koonu Isǝmayɛlǝ lǝ wǝmǝkpǝ sa, kǝ rɛ ŋ poo ru na vɔrʊrǝ. Duturǝ ɖi lah paanʊyǝ ŋ lǝǝwe, ŋpǝrayǝ ceŋceŋ le epipǝ wǝ́ le ri.» Wǝ́ Yuda la apaanʊpǝ we pǝ tɛ̀ɛnɩ. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />Wǝ́ Amadiaŋtǝpǝ la araasaŋtǝpǝ pǝ pǝlǝ pǝ ka ŋ tɛlɩ rǝ fɛɛwǝ we. Wǝ́ pǝ pɔ̀rʊ Yosɛfʊ rǝ fuŋwǝ we lǝ mǝrǝ pǝ sìiri sɩkakpɛɛlɩyǝ sekɛlɩyǝ tiyi pǝ kòonu Isǝmayɛlǝ lǝ wǝmǝkpǝ we. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ rè pǝ ko ŋ ko Ejipǝte. <verse eid="GEN 37:28" /><verse number="29" style="v" sid="GEN 37:29" />Kǝ́ Rubɛnǝ ŋ na siɛnɩ ŋ ka yɩrɩ fuŋwǝ we we, laa ka nyɩŋ Yosɛfʊ. Wǝ́ wǝ fìi ŋwǝ. Wǝ́ ŋ làarǝ na wǝkpakpǝ. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ ŋ tùu na apaanʊpǝ we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Piyǝ we lǝǝ tǝ ŋ kpii rǝ fuŋwǝ we re! Kǝ ŋmǝ yǝ ŋ́ fǝ rǝ fǝŋ?» <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />Wǝ́ pǝ lɔ̀ bereceekpaturǝ pǝ wʊlʊ, wǝ́ pǝ fǝ̀ Yosɛfʊ la kǝkpakǝ we pǝ kpìi rǝ ŋpǝrayǝ we. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Wǝ́ pǝ fǝ̀ kǝkpakǝ we pǝ manǝ pǝlǝ tǝ. Wǝ́ pǝ cò na tɔɔwǝ ǝkǝnǝŋ: «Yǝ la ka nyɩŋ tuwǝ sa, yɩrɩ mǝŋ lé piyǝ la kǝkpakǝ kǝ lǝǝwe amaa ŋkǝ na kǝnɛŋ.» <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />Wǝ́ Yakɔbǝ ŋ nyɩnɩ kǝkpakǝ we ŋ cìi, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Ao, mǝ pi la kǝkpakǝ kǝ lǝǝwe! Kɛɛlɔyǝ rɛ la ka lɔ Yosɛfʊ la laarǝ, ǝtǝmǝlǝ kǝ lee kpii. Lo wo ŋwǝ!» <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />Wǝ́ tuwǝ sa wǝ fìi Yakɔbǝ, wǝ́ ŋ làarǝ na wǝkpakpǝ, wǝ́ ŋ kolu ŋ fǝ̀ gbǝ́nyaŋrǝ ŋ tonu rǝ kǝtɔŋkǝ, wǝ́ ŋ weli ne pi wǝcukpǝ wǝpakawǝpaka. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Wǝ́ ne epipǝ kpǝlo mǝŋ okosopi mǝŋ akɔsɔkɔrʊ pǝ pǝlǝ pǝ ka ŋ ta no turuwǝ, paape wǝ́ ŋ sǝnǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ née wee ŋ́ ko tuu mǝ pi rǝ akpɛŋtɛkǝ rǝ.» Wǝ́ ŋ tǝ ŋ weli ŋwǝ. <verse eid="GEN 37:35" /><verse number="36" style="v" sid="GEN 37:36" />Wǝ́ Amadiaŋtǝpǝ we pǝ kolu pǝ sìiri Yosɛfʊ rǝ Ejipǝte pǝ kòonu Potifarǝ. Potifarǝ ke ri Farawo la nǝnɛyeetǝyǝ. Ka lɛ ri Farawo lǝ ǝrǝŋtǝpǝ lo mumuŋyǝ.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Yuda mǝ Tamarǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Rǝ eniyǝ we lǝ mǝrǝ we, wǝ́ Yuda ŋ pwɛ̀yɩ rǝ na apaanʊpǝ lǝ kpǝŋ, wǝ́ ŋ ko ŋ ko kɛrɩyǝ rɛ pǝ lóo pwo Hira lǝ kpǝŋ rǝ Adulamǝ. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Fɛɛwǝ we wǝ́ Yuda ŋ kolu ŋ nyɩnɩ Kanaŋtǝkɛrɩyǝ rɛ pǝ lóo pwo Suwa la kɔrʊyǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ lɔ̀. Wǝ́ ŋ kpɛlɩ mǝ ŋwǝ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Wǝ́ tieyǝ we ŋ pǝlǝ ŋ rè, wǝ́ ŋ mǝnǝ bǝrǝŋpirǝ. Wǝ́ Yuda ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Ɛrǝ. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Wǝ́ tieyǝ we ŋ tǝ ŋ pǝlǝ ŋ rè, wǝ́ ŋ mǝnǝ bǝrǝŋpipʊŋpwarǝ. Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Onaŋ. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Wǝ́ ŋ tǝ ŋ pǝlǝ ŋ mǝnǝ bǝrǝŋpipʊŋpwarǝ. Wǝ́ ŋ kpìi na nyɩŋrǝ ǝkǝnǝŋ Sela. Eniyǝ we tieyǝ sa ŋ kǝ ŋ mǝ Sela we, anyɩŋ Yuda kpii rǝ Kesiva.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Wǝ́ Yuda ŋ lɔ̀ tieyǝ rɛ pǝ lóo pwo Tamarǝ ŋ kòonu ne pisǝsǝŋyǝ we pǝ lóo pwo Ɛrǝ wǝ. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Yuda le pisǝsǝŋyǝ sa pǝ lóo pwo Ɛrǝ tini vɔrʊrɔɔrɔɔrǝ loo ko poŋ mǝ Ǝtǝ Woroko, wǝ́ ŋ wʊlʊ ŋwǝ. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />Wǝ́ Yuda ŋ tìi Onaŋ ǝkǝnǝŋ: «Fǝ lé mǝteeyǝ sa ŋ nǝ kpǝ́ le tieyǝ e wiiri mɛŋwǝ, kǝ e yee mǝŋ kǝ́ tǝpiyǝ ŋ née yee kǝtǝ, kǝ ǝ tǝnǝ wǝmǝkpǝ o koonu lé mǝtee». <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Paa Onaŋ ke cìi wǝ ǝkǝnǝŋ wǝmǝkpǝ we ŋpǝ mǝ kpeetieyǝ we pǝ lǝh tǝnǝ wǝ lǝŋ pe ri na wǝnɛŋ. Tuwǝ kǝto, vǝ́ la ka kpɛɛ mǝ ne mǝteeyǝ we ŋ nǝ kpǝ́ le tie we, ŋ pɔrʊ na nʊnɔmɛŋwǝ ŋ lʊ rǝ kǝtǝǝwǝ kǝ ŋ paa nya fɛɛ ŋ tǝnǝ wǝmǝkpǝ ŋ koonu ne mǝtee. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Tuwǝ we ŋ ke ŋ yee we, wǝ loo ko poŋ mǝ Ǝtǝ Woroko. Wǝ́ Ǝtǝ Woroko ŋ wʊlʊ ŋwǝ ŋkpɛ. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />Wǝ́ Yuda ŋ tìi ne pi le tie Tamarǝ ǝkǝnǝŋ: «Kǝ́ e le yee kpeetieyǝ kǝto we, mǝ ko e ke tii rǝ lǝ́ tǝ lǝ kpǝŋ ko ro eniyǝ we mǝ pi Sela ŋ náa naanǝ wǝ.» Tìi nǝ wǝ ǝnǝ duturǝ ɖi ka ŋ tɛŋ ǝkǝnǝŋ Sela ŋwǝ ŋkpɛ ŋ pǝǝ pǝ kpǝ́ mǝŋ ne mǝtee peni kǝtǝ. Wǝ́ Tamarǝ ŋ kolu ŋ tini rǝ nǝ tǝ lǝ kpǝŋ. <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />Rǝ acɛŋyǝ rɛ la kǝmaakǝ we, wǝ́ Yuda le tieyǝ sa ŋ ke ri Suwa la kɔrʊ ŋ kpǝ́. Kǝ́ Yuda ŋ ne tii kǝtǝǝwǝ ŋ na lɛ we, wǝ́ ŋpǝ mǝ na kɛrɩ Hira ŋ no ru rǝ Adulamǝ pǝ pwɛ̀yɩ pǝ ko ŋ ko Timǝna. Pǝ kolu pǝ ka yɩrɩ epǝ we pǝ lóo pu na amɛɛpǝ lo ɖorǝ wǝ. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />Kǝ́ Tamarǝ ŋ no nuŋ ǝkǝnǝŋ no nuŋ lǝ tǝ loh ko Timǝna ŋ ko pu na amɛɛpǝ lo ɖorǝ we, <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />wǝ́ ŋ pɔ̀rʊ ne wǝkpeetiekpakpǝ we ŋ tǝ̀nǝ. Wǝ́ ŋ fǝ̀ nyaŋrǝ ŋ sìi na wɛ kǝ pǝ paa nyɩŋ ŋwǝ pǝ ci. Wǝ́ ŋ kolu ŋ tini rǝ Timǝna la gʊŋrǝ we kǝ ǝ fǝ e mǝ fii Enayimǝ wǝ. Duturǝ ɖi nyɩnɩ wǝ ǝkǝnǝŋ Sela la naanǝ, paa pǝ lǝǝ fǝ̀ ŋwǝ Tamarǝ pǝ koonu ŋwǝ ŋ lɔ. <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />Kǝ́ Yuda ŋ na nyɩŋ Tamarǝ we, wǝ́ ŋ fǝ̀ ŋwǝ rǝ mǝŋ tuutuuyǝ rɛ ŋ lǝǝwe, duturǝ ɖi fǝ̀ tuwǝ sìi anyɩŋkǝ. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Kpiikǝ Yuda ŋ nee ke ci wǝ ǝkǝnǝŋ ne pi le tie ŋ kǝ lǝǝwe kǝto we, wǝ́ ŋ nyàlǝ ŋ kolu ŋ tùu Tamarǝ rǝ kʊŋlɛɛrɩwǝ we. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ, pǝ kǝ lo ko ŋ́ ka kpɛɛ mǝ lǝ́.» Wǝ́ Tamarǝ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Mǝŋ a la kpɛɛ mǝ mǝ wǝǝ, kǝ́ wǝ́ o lóo koonu mǝ?» <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />Wǝ́ Yuda ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ fǝ mǝ bereceepirǝ jeŋceŋ ŋ́ maŋ lǝ́.» Wǝ́ Tamarǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yoo, paape fǝ lá tǝrɛ ǝ tǝnǝ rǝ mǝ kpǝŋ kpɛŋ, vǝ́ a la pa maŋ bereceepirǝ we, kǝ a pa lɔ wǝ.» <verse eid="GEN 38:17" /><verse number="18-19" style="v" sid="GEN 38:18-19" />Wǝ́ Yuda ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ ǝ lǝ pǝ́ ŋ́ fǝ ŋ́ tǝnǝ?» Wǝ́ Tamarǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Fǝ lé temuwǝ sa wǝ tɛɛ mǝ lá nyɩŋrǝ mǝ wǝla ŋwɛɛwǝ mǝ ciisaŋwǝ sa e re rǝ akaakǝ ǝ tǝnǝ.» Wǝ́ Yuda ŋ fǝ̀ yǝ ŋ kòonu ŋwǝ, wǝ́ ŋ kolu ŋ kpɛlɩ mǝ ŋwǝ. Wǝ́ Tamarǝ ŋ yili ŋ ko ŋ ko nyarǝwǝ. Wǝ́ ŋ kolu ŋ wàla nyaŋrǝ we ŋ tǝ̀nǝ, wǝ́ ŋ fǝ̀ ne wǝkpeetiekpakpǝ we ŋ tǝ ŋ kpìi. Wǝ́ Tamarǝ ŋ rè ŋ kòonu Yuda. <verse eid="GEN 38:18-19" /><verse number="20" style="v" sid="GEN 38:20" />Wǝ́ Yuda ŋ kolu ŋ kpìi ne pwetaayǝ we rǝ Adulamǝ ŋ fǝ bereceepirǝ we ŋ ko kǝ ŋ ka lɔ otuyǝ we ŋ fǝ̀ ŋ tǝ̀nǝ rǝ tieyǝ we lǝ kpǝŋ ŋ pǝ. Paape ne pwetaayǝ we laa ka nyɩŋ tieyǝ we. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Wǝ́ ŋ pǝ̀ Enayimǝtǝpǝ we ǝkǝnǝŋ: «Tuutuuyǝ we ŋ née tii rǝ kʊŋlɛɛrɩwǝ sa pa?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Tuutuuyǝ rɛ fee tii rǝ fɛɛwǝ sa ŋ nyɩŋ.» <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ ŋ tìi Yuda ǝkǝnǝŋ ŋ naa nyɩŋ ŋwǝ, wǝ́ ǝtǝŋtǝǝtǝpǝ we ŋpǝ ŋkpɛ pǝ le tíi ŋwǝ ǝkǝnǝŋ tuutuuyǝ fee tíi rǝ fɛɛwǝ we ŋ nyɩŋ. <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />Wǝ́ Yuda ŋ tɛnɩ ǝkǝnǝŋ: «We ŋ fǝ otuyǝ we yǝ kpɛlɩ rǝ nǝ kpǝŋ ǝkǝ! Ŋ́ nǝ fǝ bereceepirǝ we ŋ na maŋ ŋwǝ, wǝ́ ŋlá ŋkpɛ o lo ko a laa ka nyɩŋ ŋwǝ. Rɛ ŋ pǝǝ tǝ ŋ kpii lah wɛ le kǝyepukǝ.» <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />Akɛɛnyɔŋpǝ ata la kǝmaakǝ we, wǝ́ pǝ pǝlǝ pǝ tìi Yuda ǝkǝnǝŋ: «Lé pi le tie Tamarǝ le yee kǝtuutuukǝ, wǝ́ ŋ ne re kʊraa.» Wǝ́ Yuda ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pɔrʊ ŋwǝ nǝ ru rǝ tǝŋtǝǝwǝ, kǝ nǝ tu na naa kǝrǝkǝrǝ.» <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />Kǝ́ pǝ lo ru mǝ Tamarǝ pǝ lóo ko we, wǝ́ ŋ kpìi pǝ ke tíi no nuŋ lǝ tǝ ǝkǝnǝŋ: «Yɩrɩ temuwǝ sa mǝ ŋwɛɛwǝ sa mǝ cisaŋwǝ sa. Yǝ we ŋ ne kpii mǝ lɛrǝ la anɛŋ yǝ lǝǝwe. Dɔɔkpɛ, nyɩɩ kǝ e ci yǝ we la anɛŋ yǝ lǝǝwe.» <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />Wǝ́ Yuda ŋ nyɩnɩ otuyǝ we ŋ cìi, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Le yee la saŋ rǝ seyǝ le teeri mǝ. Kǝceece ŋ́ kǝh fǝ ŋwǝ ŋ́ koonu mǝ pi Sela ŋ lɔ, paape ŋ́ nee yee wǝ.» Yuda lǝǝ tǝ ŋ pa kpɛɛ mǝ Tamarǝ kʊrakʊra. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />Kǝ́ Tamarǝ le enimǝyǝ yǝ lo ro we, wǝ́ pǝ nyɩnɩ wǝ pǝ cìi ǝkǝnǝŋ lǝh mǝ awɛɛpipǝ. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Kǝ́ ŋ nǝh mǝ we, wǝ́ pǝle ceŋceŋ ŋ ru mǝ kǝnukǝ. Wǝ́ tieyǝ we ŋ nǝ́ǝ mǝǝnǝ etiepǝ ŋ tà kǝnukǝ we, wǝ́ ŋ fǝ̀ ŋwɛɛmwɛɛrɩwǝ ŋ tonu kǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ nǝ sǝŋ orukǝ wǝ.» <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Paape wǝ́ piyǝ we ŋ sìɛnɩ mǝ kǝnukǝ we ŋ fìi. Wǝ́ na paanʊ ŋ rù. Wǝ́ tieyǝ we ŋ nǝ́ǝ mǝǝnǝ etiepǝ ŋ tɛnɩ ǝkǝnǝŋ: «E le yee nɛ wǝ́ a la nyaa gʊŋrǝ o lo koonu lá wɛ wǝ?» Wǝ́ pǝ kpìi na nyɩŋrǝ ǝkǝnǝŋ Perɛzǝ. Wǝlo duturǝ ɖi gʊŋnyaarǝ. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Wǝla kǝmaakǝ wǝ́ na paanʊyǝ we pǝ lǝ fǝ ŋwɛɛmwɛɛrɩwǝ pǝ la parǝ rǝ kǝnukǝ ŋ ci oru. Wǝ́ pǝ kpìi na nyɩŋrǝ ǝkǝnǝŋ Zera.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">Yosɛfʊ le ke fii Potifarǝ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Kǝ́ Isǝmayɛlǝ lǝ wǝmǝkpǝ we pǝ le ke fii mǝ Yosɛfʊ rǝ Ejipǝte we, wǝ́ pǝ sìiri ŋwǝ pǝ kòonu Ejipǝtetǝnyiyǝ rɛ pǝ lóo pwo Potifarǝ. Potifarǝ ke ri Farawo la nǝnɛyeetǝmumuŋyǝ mǝ ŋwǝ Farawo lǝ ǝrǝŋtǝpǝ lo mumuŋyǝ. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />Ǝtǝ Woroko ke kpii kʊ̀la mǝ Yosɛfʊ, anyɩŋ tu ri ŋ tu wǝ ya wǝ lóo poŋ wǝ ŋ koonu ŋwǝ. Ke kpii rǝ no kulǝtǝyǝ Ejipǝtetǝnyiyǝ we la nyarǝwǝ. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />No kulǝtǝyǝ nyɩnɩ wǝ cìi ǝkǝnǝŋ Ǝtǝ Woroko kpii kʊla mǝ ŋwǝ. Vǝ́ lǝ fǝ tu ri ŋ tu Ǝtǝ Woroko ŋ yee o wǝ ŋ poŋ wǝ koonu ŋwǝ. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Yosɛfʊ lo tuwǝ wǝ ko ponu mǝ no kulǝtǝyǝ. Wǝ́ no kulǝtǝyǝ sa ŋ lɔ̀ ŋwǝ kǝ mǝ ŋ yee anǝnɛyǝ mǝ ŋ koonu ŋwǝ. Fǝ na nyarǝwǝ mǝ no otuyǝ kpǝlo kɩɩkɩ kpìi ŋwǝ rǝ akaakǝ mǝ ŋ yɩrɩ. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Kǝ́ Potifarǝ ŋ nǝ fǝ na nyarǝwǝ mǝ no otulǝmǝyǝ kpǝlo kɩɩkɩ ŋ ne kpii Yosɛfʊ rǝ akaakǝ mǝ ŋ yɩrɩ we, wǝ́ Ǝtǝ Woroko ŋ sanǝ rǝ Yosɛfʊ wǝ́ ŋ pɛ̀ɛrɩ na nyarǝwǝ. Ǝtǝ Woroko la wǝpɛɛrɩkpǝ sa wǝ ka tɛɛ rǝ no otulǝmǝyǝ kpǝlo kɩɩkɩ rǝ na nyarǝwǝ mǝŋ atɛɛkǝ. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Wǝ́ Potifarǝ ŋ màa no tu ri ŋ tu ŋ kpìi Yosɛfʊ rǝ akaakǝ. Ŋwǝ paa lǝǝ tǝ ke ŋ yee tǝrɛ, we keeriwǝ we ŋ neh ri ko lǝ kpǝŋ wǝ́ ŋ ka ŋ yɩrɩ.</para>
  <para style="s" vid="GEN 39:6">Yosɛfʊ mǝ no kulǝtǝyǝ le tie</para>
  <para style="p" vid="GEN 39:6">Yosɛfʊ ko ŋ poŋ ayɩrɩ ŋpa. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Wǝla kǝmaakǝ we, wǝ́ no kulǝtǝyǝ le tie ŋ pǝlǝ ŋ ka ŋ mɔŋ mǝ ŋ ca mǝ ŋwǝ. Wǝ́ tieyǝ sa ŋ tìi Yosɛfʊ ŋ pa kpɛɛ mǝ ŋwǝ. <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />Wǝ́ Yosɛfʊ ŋ sǝnǝ, wǝ́ ŋ tìi no kulǝtǝyǝ le tieyǝ ǝkǝnǝŋ: «E cii, mǝ kulǝtǝyǝ la tɛɛ kpɛɛwǝ rǝ mǝ, wǝ́ ŋ nǝ fǝ no otulǝmǝyǝ kpǝlo ŋ ne kpii mǝ rǝ akaakǝ mǝ ŋ yɩrɩ. Kǝto lǝǝ tǝ ya laa yɩrɩ tǝrɛ lǝ kpǝŋ rǝ nyarǝwǝ sa. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Rǝ nyarǝwǝ sa we, mǝ kulǝtǝyǝ lǝǝ lǝǝmǝ okopiyǝ ŋ teeri mǝ. La pɔrʊ gʊŋrǝ lo koonu mǝ rǝ tu ri ŋ tu lo oŋuŋkǝ, we ŋlǝ́ ko. Duturǝ ɖi ne tie wǝ́ e ri. Kǝ ŋ́ koru pusuŋtǝtuwǝ sa mǝ turɔɔrɔɔwǝ sa le eyee rǝ Worokoyǝ le enimiyǝ rǝ nɛ ǝnǝ?» <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Wǝ́ tieyǝ sa ŋ rè ŋ yà ŋ ke ŋ kpii Yosɛfʊ la awɛɛlɩkǝ ji ri ŋ ji paape laa pa tɛɛnɩ ne dierǝ we kǝ ŋ kpɛɛ nǝ kpǝŋ kǝ wǝ pe ri lo toomu mǝ ŋwǝ.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Wǝ́ jirɛɛrǝ Yosɛfʊ ŋ pǝlǝ nyarǝwǝ we ŋ pe yee anǝnɛyǝ, anyɩŋ asʊmatǝpǝ we la rɛ lee ke kpii rǝ nyarǝwǝ. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Wǝ́ Potifarǝ le tie ŋ tà Yosɛfʊ rǝ kǝkpakǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pa kpɛɛ mǝ mǝ!» Wǝ́ Yosɛfʊ ŋ rù rǝ kǝkpakǝ we lǝ mǝrǝ ŋ kpìi ŋwǝ rǝ akaakǝ, wǝ́ ŋ rù ŋ sùu rǝ nyarǝwǝ we. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />Kǝ́ tieyǝ sa ŋ na nyɩŋ wǝ ǝkǝnǝŋ Yosɛfʊ la maa na kǝkpakǝ le kpii ŋwǝ rǝ akaakǝ wǝ́ ŋ no ru ŋ no suu we, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />wǝ́ ŋ pwò na asʊmatǝpǝ ǝkǝnǝŋ: «Nǝ pa yɩrɩ re! Mǝ nuŋ lǝ kǝ fǝ Hebǝritǝpiyǝ sa lǝ pǝ tǝnǝ lǝ kǝ ŋ kpii lǝ kǝyepukǝ. Lǝ pǝ mǝ kpǝŋ ŋ pa kpɛɛ mǝ mǝ, wǝ́ ŋ́ na ca narǝmumuŋwǝ rɛ. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Kǝ́ ŋ na nyɩŋ ǝkǝnǝŋ ŋmǝ ŋ́ na ca narǝmumuŋwǝ sa we, wǝ́ ŋ na maa na kǝkpakǝ rǝ mǝ kǝlɛɛrɩkǝ, wǝ́ ŋ no ru ŋ no suu.»<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Wǝ́ ŋ fǝ̀ kǝkpakǝ we ŋ tǝ̀nǝ rǝ nǝ kpǝŋ wɩɩ wǝ́ Yosɛfʊ lo kulǝtǝyǝ ŋ pǝlǝ ŋ fìi nyarǝwǝ rǝ. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Wǝ́ ŋ fǝ̀ dierǝ sa ke ŋ pɔ̀ na amayǝ ǝkǝnǝŋ: «Hebǝritǝrɔŋyǝ sa e le re o lo po koonu lǝ rǝ nyarǝwǝ sa we, lǝ pǝ mǝ kpǝŋ ŋ pe kpii mǝ kǝyepukǝ. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Paape kǝ́ ŋ na nyɩŋ ŋ́ na ca narǝmumuŋwǝ rɛ we, wǝ́ ŋ no ru ŋ no suu ŋ na maa na kǝkpakǝ ŋ nǝ tǝnǝ rǝ mǝ kǝlɛɛrɩkǝ.» <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />Kǝ́ Yosɛfʊ lo kulǝtǝyǝ sa ŋ no nuŋ ne tie la amayǝ sa ǝkǝnǝŋ «kǝ́ lá rɔŋyǝ sa ŋ ne yee mǝ mǝ wǝǝ» we, wǝ́ ŋ fǝ̀ kpɛɛmʊrʊwǝ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Wǝ́ ŋ kòonu pǝ lɔ̀ Yosɛfʊ pǝ tanǝ, rǝ fɛɛwǝ we pǝ láa taŋ piliyǝ lo okukpɛɛtǝpǝ wǝ.<verse eid="GEN 39:20" /></para>
  <para style="s">Yosɛfʊ kpii rǝ gukpɛɛkpǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 39:21" />Ǝtǝ Woroko ka kʊla mǝ Yosɛfʊ mǝ eniyǝ we ŋ ke kpii rǝ gukpɛɛkpǝ we wǝ. Wǝ́ ŋ yeli na lɛsiɛrɩwǝ. Wǝ́ ŋ lɛ̀ ŋ yeli wǝ́ Yosɛfʊ lo tuwǝ wǝ pònu mǝ okukpɛɛtǝpǝ we lǝ rǝŋtǝyǝ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Wǝ́ okukpɛɛtǝpǝ we lǝ rǝŋtǝyǝ sa ŋ pǝlǝ ŋ fǝ̀ okukpɛɛtǝpǝ we kpǝlo pǝ ke kpii rǝ gukpɛɛkpǝ we ŋ kpìi Yosɛfʊ rǝ akaakǝ mǝ ŋ yɩrɩ. Tu ri ŋ tu okukpɛɛtǝpǝ we pǝ ke ŋ yee rǝ we we, ŋwǝ ŋ ka ŋ yɩrɩ pǝ. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Okukpɛɛtǝpǝ we lǝ rǝŋtǝyǝ sa lǝǝ tǝ ka ŋ yɩrɩ anǝnɛyǝ we ŋ fǝ̀ ŋ kpìi Yosɛfʊ rǝ akaakǝ lǝ kpǝŋ. Duturǝ ɖi Ǝtǝ Woroko ka kʊla mǝ ŋwǝ. Vǝ́ lǝ fǝ tu ri ŋ tu Ǝtǝ Woroko ŋ yee o wǝ ŋ poŋ wǝ koonu ŋwǝ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Rǝ otuyǝ sa la kǝmaakǝ we, wǝ́ Ejipǝtetǝpiliyǝ la anǝnɛyeetǝmumuŋpǝ rɛ eyi pǝ yeli pǝ fɔ̀ pǝ pǝ̀lǝ rǝ piliyǝ lǝ kpǝŋ. Ǝfǝŋcotǝpǝ lo mumuŋyǝ mǝ akpɔnɔyeetǝpǝ lo mumuŋyǝ pǝ kǝ lǝǝwe. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Wǝ́ Farawo ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋ tɛ̀ɛ rǝ anǝnɛyeetǝpǝ sa pǝle eyi, ǝfǝŋcotǝpǝ lo mumuŋyǝ we mǝ akpɔnɔyeetǝpǝ lo mumuŋyǝ we. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Wǝ́ ŋ kòonu pǝ lɔ̀ pǝ pǝ tanǝ rǝ gukpɛɛkpǝ we wǝ kpii rǝ Farawo lǝ ǝrǝŋtǝpǝ lo mumuŋyǝ la nyarǝwǝ wǝ. Fɛɛwǝ we wǝ́ pǝ tanǝ Yosɛfʊ pǝ kpìi wǝ. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Wǝ́ ǝrǝŋtǝpǝ lo mumuŋyǝ sa ŋ fǝ̀ pǝ ŋ kpìi Yosɛfʊ rǝ akaakǝ mǝ ŋ sʊma pǝ. Wǝ́ pǝ kpìi rǝ gukpɛɛkpǝ sa ko ro eniyǝ rɛ.<verse eid="GEN 40:4" /></para>
  <para style="s">Yosɛfʊ la pɔrʊ okukpɛɛtǝpǝ we eyipǝ la wǝtʊkpɛɛkpǝ lo duturǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />Jirɛɛrǝ lo dumurǝ we, wǝ́ Ejipǝtetǝpiliyǝ lǝ ǝfǝŋcotǝpǝ lo mumuŋyǝ we mǝ na akpɔnɔyeetǝpǝ lo mumuŋyǝ we pǝ la taŋ we, pǝle eyi pǝ kpɛlɩ wǝtʊkpɛɛkpǝ, yǝ mǝ yǝ la kǝtʊkpɛɛkǝ mǝ kǝlo duturǝ. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />Ɖokoŋpirǝ, kǝ́ Yosɛfʊ ŋ nǝ pǝ ŋ pa yɩrɩ pǝ we, wǝ́ ŋ nyɩnɩ pǝ tini rɛyɩɩ. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Wǝ́ Yosɛfʊ ŋ pǝ̀ Farawo la anǝnɛyeetǝpǝ we ŋpǝ mǝ pǝ pǝ ke kpii rǝ gukpɛɛkpǝ we rǝ no kulǝtǝyǝ la nyarǝwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ tini rɛyɩɩ ruŋruŋ ǝnǝ?» <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />Wǝ́ pǝ kpǝ̀lǝŋ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ la kpɛɛ wǝtʊkpɛɛkpǝ rɛ, wǝ́ rɛ lee kpii ŋ nah pɔrʊ wǝlo duturǝ ŋ tíi lǝ.» Wǝ́ Yosɛfʊ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝto ŋkǝ Worokoyǝ ŋ nóo koonu nyiyǝ lo otuciyǝ ŋ pɔrʊ kǝtʊkpɛɛkǝ lo duturǝ? Dɔɔkpɛ, nǝ tɛŋ nǝ wǝtʊkpɛɛkpǝ we nǝ tíi mǝ.» <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />Wǝ́ ǝfǝŋcotǝpǝ lo mumuŋyǝ sa ŋ yìili ǝkǝnǝŋ: «Ŋ́ na nyɩŋ rɛzɛŋyǝ lo guŋrǝ rǝ mǝ kǝnyɩŋkǝ rǝ kǝtʊkpɛɛkǝ. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />Lǝǝmǝ laŋwǝ ta. Kǝ́ lo ru eweŋwɛŋyǝ eni ko we, wǝ́ la mɔŋ. Wǝ́ otumɔŋyǝ we yǝ la tɛɛ mǝ arɛzɛŋtǝnǝyǝ yǝ la mwɛɛrɩ wǝ. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ŋ́ ke re Farawo la kɔpʊwǝ we ŋ nóo ŋuŋ ǝfǝŋpǝ mǝ akaakǝ. Wǝ́ ŋ́ na ya ŋ́ náa lɛ rɛzɛŋyǝ mǝ ŋ mʊʊrʊ mɛŋwǝ mǝ ŋ kpii rǝ Farawo la kɔpʊwǝ we mǝrǝ. Wǝ́ ŋ́ nǝ fǝ ŋ́ no koonu ŋwǝ.» <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />Wǝ́ Yosɛfʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá kǝtʊkpɛɛkǝ sa lo duturǝ gaamǝ ɖǝ ǝnǝ: Laŋwǝ we tawǝ we, wǝ kaamǝ wǝcukpǝ wǝta. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Rǝ wǝcukpǝ wǝta lǝ mǝrǝ we, Farawo láa rɛɛrɩ mǝ lǝ́. Lǝ́ǝ tǝ ŋ fǝ lá kǝnǝnɛkǝ ŋ kpii lǝ́ rǝ akaakǝ. Ǝ lǝh mǝ tǝ ǝ mǝ fǝ kɔpʊwǝ o mǝ koonu ŋwǝ mǝŋ kǝ́ e ke ŋ ce e mǝ ŋ yee wǝ kǝtǝ. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Vǝ́ wǝ lo po ko poŋ wǝ lo koonu lǝ́ we, dɔɔkpɛ poo yuu mǝ kpɛɛ oo, nyɩŋ mǝ tǝlarǝwǝ. Tɛŋ mǝ tuwǝ e tíi Farawo, kǝ a pɔrʊ mǝ o ru rǝ gukpɛɛkpǝ sa. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Pǝ la yɩɩ mǝ pǝ lo suu rǝ Ehebǝritǝpǝ lǝ gǝŋrǝ pǝ lǝ pǝ. Wǝ́ mǝŋ fɛɛwǝ sa we, ŋ́ nee yee tǝrɛ wǝ kaamǝ kǝ pǝ lɔ mǝ pǝ taŋ.» <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />Kǝ́ akpɔnɔyeetǝpǝ lo mumuŋyǝ sa ŋ na nyɩŋ ǝkǝnǝŋ kǝtʊkpɛɛkǝ we lo duturǝ Yosɛfʊ ŋ na pɔrʊ bonu we, wǝ́ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋmǝ ŋkpɛ ŋ́ na kpɛɛ kǝtʊkpɛɛkǝ. Rǝ kǝtʊkpɛɛkǝ sa we, ŋ́ ke re kɛŋtɛwǝ ta rǝ yurǝ. Yǝ ke kpii mǝ kpɔnɔyǝ. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Kɛŋtɛŋuŋnɛŋwǝ we we, wǝ ke kpii mǝ akpɔnɔpǝ we kǝtǝŋkǝ kpǝlo Farawo ŋ náa taa kǝǝwǝ wǝ. Wǝ́ ofuripǝ pǝ la ya pǝ lǝh pǝ pǝ ŋ sieni pǝ pǝ ŋ ri rǝ kɛŋtɛwǝ we wǝ tɛɛ mǝ rǝ yurǝ wǝ.» <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />Wǝ́ Yosɛfʊ ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lá kǝtʊkpɛɛkǝ lo duturǝ gaamǝ ɖǝ ǝnǝ. Kɛŋtɛwǝ we tawǝ wǝ kaamǝ wǝcukpǝ wǝta. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Rǝ wǝcukpǝ wǝta lǝ mǝrǝ we, Farawo lǝ́ǝ sǝ ló yurǝ. Pǝ lóo toŋ lǝ́ golurǝ pǝ sɔɔmʊ rǝ wǝciikpǝ, kǝ ofuripǝ pǝ pe sieni lǝ́.» <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />Juutatǝrǝ we wǝ́ Farawo ŋ ke ŋ ri ne jimǝrǝ la wǝcɛkpǝ. Wǝ́ ŋ cà keeriwǝ ŋ kòonu na anǝnɛyeetǝpǝ kpǝlo kɩɩkɩ. Rǝ pǝlo kpǝlo la kǝnyɩŋkǝ wǝ́ ŋ pɔ̀rʊ ǝfǝŋcotǝpǝ lo mumuŋyǝ we mǝ akpɔnɔyeetǝpǝ lo mumuŋyǝ we rǝ gukpɛɛkpǝ. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Wǝ́ Farawo ŋ fǝ̀ ǝfǝŋcotǝpǝ lo mumuŋyǝ we la kǝnǝnɛkǝ ŋ tǝ ŋ kpìi ŋwǝ rǝ akaakǝ. Wǝ́ ŋ kǝ ŋ tǝ mǝ ŋ fǝ kɔpʊwǝ mǝ ŋ koonu ŋwǝ. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />Paa wǝ́ ŋ tìi pǝ tonu akpɔnɔyeetǝpǝ lo mumuŋyǝ we lo golurǝ mǝŋ kǝ́ Yosɛfʊ ŋ tìi pǝ lǝ wǝ kǝtǝ. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Paape wǝ́ ǝfǝŋcotǝpǝ lo mumuŋyǝ sa ŋ naa ka taalǝ Yosɛfʊ, wǝ́ ŋ yùu na kpɛɛ.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">Farawo la wǝtʊkpɛɛkpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Cɛŋwǝ yi la kǝmaakǝ we, wǝ́ Farawo ŋ kpɛlɩ kǝtʊkpɛɛkǝ rɛ ǝkǝnǝŋ ŋ ka yaa rǝ kpanǝwǝ we pǝ lóo pwo Nilǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />Kǝtǝrǝceŋceŋ wǝ́ ŋ nyɩnɩ anɛŋyeekpatɩpǝ rɛ pǝ la nya wɛɛwǝ apǝrɩmata pǝ lo ru rǝ kpanǝwǝ we pǝ láa rɛ. Wǝ́ pǝ pǝlǝ pǝ yà pǝ ko ŋ wo bɔɔrǝ rǝ kǝpǝŋpǝŋkǝ. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Kǝtǝrǝceŋceŋ wǝ́ anɛŋyeepʊŋpwapǝ apǝrɩmata, pǝ lǝ sǝǝ kokǝlokokǝlo, pǝ lǝŋ poŋ ayɩrɩ pǝ rù rǝ kpanǝwǝ sa pǝ sìimǝ pǝ pǝ ka ŋ rɛ. Wǝ́ pǝ pǝlǝ pǝ yàa rǝ ǝsǝsǝŋpǝ we lǝ kpǝŋ rǝ kǝpǝŋpǝŋkǝ. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Wǝ́ anɛŋpǝ we apǝrɩmata pǝ lǝ sǝǝ kokǝlokokǝlo pǝ lǝŋ poŋ ayɩrɩ pǝ lɔ̀ okpǝkpoopupǝ we apǝrɩmata pǝ lóo poŋ ayɩrɩ we pǝ pɔ̀ɔlʊ. Ko, wǝ́ Farawo ŋ cɩ̀ɩlɩ ŋ sàanǝ. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />Kǝ́ eniŋrieyǝ yǝ lǝ tǝ yǝ lǝ fǝ ŋwǝ we, wǝ́ ŋ kaŋ kpɛɛ kǝtʊkpɛɛyitǝkǝ. Kǝtǝrǝceŋceŋ wǝ́ ŋ nyɩnɩ bǝleyǝ lo guŋrǝ jeŋceŋ lo póŋ bǝleyǝ laapǝrɩmata, wǝ le fii epiiyǝ nyɩrɩrɩ wǝ́ wǝ lóo poŋ ayɩrɩ. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Wǝla kǝmaakǝ we, kǝtǝrǝceŋceŋ wǝ́ ŋ tǝ ŋ nyɩnɩ bǝleyǝ laapǝrɩmata wǝ lo póŋ wǝ láa rɛ rǝ ǝsǝsǝŋyǝ we la kǝmaakǝ. Yǝ lǝ mʊsɩmʊsɩ, wǝ́ nyɔŋkpaakǝtǝǝwǝ lǝ ǝrǝfuŋkuunaakǝ kǝ la kpaalǝ yǝ. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Wǝ́ alaamʊsɩmʊsɩyǝ we yǝ lɔ̀ laapǝrɩmataceeceewǝ we wǝ le fii epiiyǝ nyɩrɩrɩ yǝ pɔ̀ɔlʊ. Wǝ́ Farawo ŋ sàanǝ, wǝ́ ŋ ci e cìi wǝ ǝkǝnǝŋ ŋ na kpɛɛ kǝtʊkpɛɛkǝ rǝ. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />Kǝ́ kǝ la kaalǝ we, wǝ́ Farawo ŋ fìi kǝǝnǝwǝ. Wǝ́ ŋ kpìi pǝ pwòlu Ejipǝtetǝtucitǝpǝ kpǝlo mǝ akpaatǝpǝ kpǝlo pǝ pǝlǝ. Wǝ́ ŋ fǝ̀ na wǝtʊkpɛɛkpǝ we ŋ tìi pǝ, paape rɛ loo koru kpǝ lo duturǝ la apɔrʊ. <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />Fɛɛwǝ ǝfǝŋcotǝpǝ lo mumuŋyǝ sa ŋ née tíi Farawo ǝkǝnǝŋ: «Piliyǝ, ruŋruŋ ŋ́ na taalǝ mǝ turɔɔrɔɔwǝ rɛ ŋ́ yeli wǝ. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Kǝ́ ǝ fǝ̀ kpɛɛmʊrʊwǝ a tɛ̀ɛ rǝ ŋlǝ mǝ akpɔnɔyeetǝpǝ lo mumuŋyǝ we, wǝ́ o kòonu pǝ lɔ̀ lǝ pǝ kolu pǝ tanǝ rǝ ǝrǝŋtǝpǝ lo mumuŋyǝ la nyarǝwǝ we, <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />wǝ́ leh eyi la kpɛlɩ wǝtʊkpɛɛkpǝ rǝ dumurǝ jeŋceŋ lǝ mǝrǝ. Wǝtʊkpɛɛkpǝ we lǝ gǝ ri ŋ gǝ mǝ kǝlo duturǝ <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Hebǝritǝkosopiyǝ rɛ ka kʊla mǝ lǝ rǝ gukpɛɛkpǝ we. Ǝrǝŋtǝpǝ lo mumuŋyǝ la rɔŋyǝ ŋ kǝ lǝǝwe. Wǝ́ lǝ fǝ̀ lah wǝtʊkpɛɛkpǝ sa le tìi ŋwǝ. Wǝ́ ŋ pɔ̀rʊ nyi ri ŋ nyi la kǝtʊkpɛɛkǝ lo duturǝ ŋ tìi ŋwǝ. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Wǝ́ kǝceece tu ri ŋ tu wǝ pǝlǝ pɛpɛ mǝŋ kǝ́ ŋ tɛnɩ ŋ tìi lǝ wǝ. Ǝ lǝ tǝ ǝ lǝ fǝ mǝ kǝnǝnɛkǝ e le kpii mǝ rǝ akaakǝ, wǝ́ pǝ tonu akpɔnɔyeetǝpǝ lo mumuŋyǝ lo golurǝ.»<verse eid="GEN 41:13" /></para>
  <para style="s">Yosɛfʊ la pɔrʊ Farawo la wǝtʊkpɛɛkpǝ we lo duturǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Wǝ́ Farawo ŋ kpìi pǝ ko pwo Yosɛfʊ ŋ pǝ. Wǝ́ pǝ sùu kalaŋ pǝ kolu pǝ pɔ̀rʊ ŋwǝ rǝ gukpɛɛkpǝ we. Wǝ́ ŋ pùu yurǝ mǝŋ gurǝ, wǝ́ ŋ cɛ̀kɛlɛ wǝkpakpǝ. Wǝ́ ŋ kolu ŋ rù rǝ Farawo lǝ kpǝŋ. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />Wǝ́ Farawo ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋ́ na kpɛɛ kǝtʊkpɛɛkǝ rɛ, wǝ́ rɛ loo koru kǝlo duturǝ la apɔrʊ. Wǝ́ pǝ le tíi mǝ ǝkǝnǝŋ ŋlǝ́ paa we, mǝŋ pǝ le tíi lǝ́ kǝtʊkpɛɛkǝ rɛ ko we, o lóo koru apɔrʊ kǝlo duturǝ.» <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />Wǝ́ Yosɛfʊ ŋ kpǝ̀lǝŋ ŋ tìi Farawo ǝkǝnǝŋ: «Ŋkǝ ŋmǝ! Worokoyǝ ŋ náa pɔrʊ kǝtʊkpɛɛkǝ lo duturǝ kǝ wǝ poŋ mǝ lǝ́ wǝ.» <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />Wǝ́ Farawo ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋ́ na kpɛɛ kǝtʊkpɛɛkǝ ǝkǝnǝŋ ŋ́ yaa rǝ kpanǝwǝ we pǝ lóo pwo Nilǝ la kǝlɛɛrɩkǝ. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />Kǝtǝrǝceŋceŋ wǝ́ ŋ́ nyɩnɩ anɛŋyeekpatɩpǝ rɛ pǝ la nya wɛɛwǝ apǝrɩmata pǝ lo ru rǝ kpanǝwǝ we pǝ láa rɛ. Wǝ́ pǝ pǝlǝ pǝ yà pǝ ko ŋ wo bɔɔrǝ rǝ kǝpǝŋpǝŋkǝ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Kǝtǝrǝceŋceŋ wǝ́ anɛŋyeepʊŋpwapǝ apǝrɩmata, pǝ lǝ sǝǝ kokǝlokokǝlo, pǝ lǝŋ poŋ ayɩrɩ kʊrakʊra pǝ rù rǝ kpanǝwǝ sa pǝ sìimǝ pǝ pǝ ka ŋ rɛ. Ŋ́ faa nyɩŋ anɛŋpǝ rɛ pǝ lǝŋ poŋ ayɩrɩ ǝnǝ ŋ́ tǝnǝ rǝ Ejipǝte lǝ gǝŋrǝ sa kpǝlo! <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Wǝ́ anɛŋyeepǝ sa pǝ lǝ sǝǝ kokǝlokokǝlo, pǝ lǝŋ poŋ ayɩrɩ pǝ la lɔ ǝsǝsǝŋpǝ we pǝ la nya wɛɛwǝ pǝla apǝrɩmata pǝ la pɔɔlʊ. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Mǝŋkǝ́ pǝ la lɔ ǝsǝsǝŋpǝ we pǝ la pɔɔlʊ paape, rɛ lǝŋ lɔ wǝ ŋ nuŋ ǝkǝnǝŋ pǝ la pɔɔ tǝrɛ, pǝ lǝ tǝ pǝ lǝ sǝǝ pǝ yaa mǝŋ kǝ́ pǝ kǝ lǝ kǝtǝ. Wǝ́ ŋ́ na saanǝ. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />Wǝ́ ŋ́ nǝ tǝ ŋ́ na kpɛɛ kǝtʊkpɛɛrɛɛkǝ. Kǝtǝrǝceŋceŋ wǝ́ ŋ́ na nyɩŋ bǝleyǝ lo guŋrǝ jeŋceŋ lo póŋ bǝleyǝ laapǝrɩmata wǝ le fii epiiyǝ nyɩrɩrɩ wǝ́ wǝ lóo poŋ ayɩrɩ. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Wǝla kǝmaakǝ we, kǝtǝrǝceŋceŋ wǝ́ laapʊpʊŋpwawǝ rɛ pǝrɩmata wǝ lo póŋ wǝ lah rɛ rǝ ǝsǝsǝŋyǝ we la kǝmaakǝ. Alaayǝ sa yǝ kǝ lǝ twiɛtwiɛrɛɛ, mʊsɩmʊsɩ wǝ́ nyɔŋkpaakǝtǝǝwǝ lǝ ǝrǝfuŋkuunaakǝ kǝ la kpaalǝ yǝ. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Wǝ́ alaamʊsɩmʊsɩyǝ we yǝ la lɔ laapǝrɩmataceeceewǝ we wǝ le fii epiiyǝ nyɩrɩrɩ yǝ la pɔɔlʊ. Ŋ́ na tɛŋ wǝtʊkpɛɛkpǝ sa ŋ́ ne tíi akpaatǝpǝ, paape pǝla rɛ loo koru apɔrʊ kpǝ lo duturǝ ŋ tíi mǝ.» <verse eid="GEN 41:24" /><verse number="25" style="v" sid="GEN 41:25" />Wǝ́ Yosɛfʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Piliyǝ, kǝtʊkpɛɛkǝ kǝceŋceŋ wǝ́ a la kpɛɛ. Worokoyǝ ya lée tíi lǝ́ tuwǝ ŋ neh yee rǝ. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Anɛŋyeekpatɩpǝ we apǝrɩmatapǝ we, pǝ kaamǝ cɛŋwǝ pǝrɩmata. Bǝleyǝ we la laaceeceepǝrɩmatawǝ we we, wǝ kaamǝ cɛŋwǝ pǝrɩmata. Kǝto kǝtʊkpɛɛkǝ kǝceŋceŋ kǝ lǝǝwe. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Anɛŋyeepǝ sa apǝrɩmatapǝ pǝ lǝ sǝǝ kokǝlokokǝlo, pǝ lǝŋ poŋ ayɩrɩ, pǝ pǝlǝ pǝ tǝ̀ǝlǝ we, pǝ kaamǝ cɛŋwǝ pǝrɩmata. Bǝlelaapɩrɩmatawǝ we wǝ lǝ mʊsɩmʊsɩ wǝ́ nyɔŋkpaakǝtǝǝwǝ lǝ ǝrǝfuŋkuunaakǝ kǝ la kpaalǝ we, ŋ wǝ ŋkpɛ wǝ kaamǝ cɛŋwǝ pǝrɩmata. Wǝlo duturǝ ɖi kǝtɛŋkǝ kǝ lóo ru cɛŋwǝ pǝrɩmata. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />Piliyǝ, mǝŋ kǝ́ ŋ́ ne tíi lǝ́ wǝ ŋ́ na pa tɛlɩ we, Worokoyǝ la pɔrʊ tuwǝ we ŋ neh yee la kaŋ lǝ́ rǝ. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Cɛŋpǝrɩmatawǝ sa wǝ lo furu we, keeriwǝ wǝ láa nya ŋpa rǝ Ejipǝte lǝ gǝŋrǝ sa kpǝlo kɩɩkɩ. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Rǝ wǝla kǝmaakǝ we, kǝtɛŋkǝ kǝ lée fii cɛŋwǝ pǝrɩmata. Enyipǝ pǝ lóo yuu kpɛɛ ǝkǝnǝŋ keeriwǝ wǝ la nya wǝ la pa tɛlɩ rǝ Ejipǝte lǝ gǝŋrǝ. Kǝtɛŋkǝ sa kǝ lǝ́ǝ pǝlǝ otuyǝ rǝ gǝŋrǝ sa ŋpa. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Kǝtɛŋkǝ sa kǝ láa lɛnyɩ ŋpaŋpa, enyipǝ pǝ lǝŋ tǝ pǝ pe ci wǝ ǝkǝnǝŋ keeriwǝ wǝ la nya wǝ la pa tɛlɩ rǝ gǝŋrǝ sa. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Piliyǝ, mǝŋ a la kpɛɛ kǝtʊkpɛɛkǝ sa kǝyi we, wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ lǝ fǝ wǝ la tɛɛ rǝ na wɛ, ŋ née yee wǝ taa. Wǝ́ wǝ lǝŋ lɛ wǝ panǝ, lée yee wǝ. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />Piliyǝ, rǝkǝsa we, taa nyiyǝ ŋ sieni nimirǝ wǝ́ ŋ cii otuyǝ kǝ o koonu no okopiyǝ rǝ Ejipǝte lǝ gǝŋrǝ. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Tǝnǝ anǝnɛyeetǝpǝ a tɛlɩ rǝ gǝŋrǝ sa, pǝ ŋ lɔ ekeeriyǝ la tʊʊtǝwǝ rǝ cɛŋpǝrɩmatawǝ sa lǝ mǝrǝ keeriwǝ wǝ lah nya wǝ. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Kǝ pǝ kpǝ ekeeriyǝ kpǝlo rǝ cɛŋceeceepǝrɩmatawǝ sa wǝ lo furu wǝ. Rǝ lá nyɩŋrǝ we, kǝ pǝ toolu bǝleyǝ pǝ tǝnǝ rǝ owulǝŋyǝ rǝ ǝtǝŋtǝǝyǝ, kǝ pǝ ŋ yɩrɩ yǝ. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Mǝŋkǝsa we, o lóo turu Ejipǝte lǝ gǝŋrǝ la nya keeriwǝ lǝ tǝnǝ kǝmaakǝ koonu cɛŋpǝrɩmatawǝ we kǝtɛŋkǝ kǝ leh pe fii wǝ. Eniyǝ we enyipǝ pǝ lǝŋ pǝ kpǝ́ mǝ kǝtɛŋkǝ rǝ gǝŋrǝ sa.»<verse eid="GEN 41:36" /></para>
  <para style="s">Yosɛfʊ le yee Ejipǝte lǝ kǝŋyɩrɩtǝyǝ</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Wǝ́ tuwǝ sa wǝ ponu mǝ Farawo mǝ na acaamɩpǝ. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Wǝ́ Farawo ŋ tìi na acaamɩpǝ we ǝkǝnǝŋ: «Worokoyǝ la wɛɛrǝ gbii rǝ nyiyǝ sa. Yǝ lóo koru a pa nya nyipʊŋpwayǝ rɛ mǝŋ nǝ kǝtǝ?» <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />Wǝ́ Farawo ŋ yìili ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Kǝ́ wǝ ri ǝkǝnǝŋ Worokoyǝ ŋ na pɔrʊ otuyǝ sa kpǝlo ŋ na kaŋ lǝ́ we, rɛ lee kpii ŋ sieni nimirǝ wǝ́ ŋ cii otuyǝ mǝŋ ŋlǝ́ kǝtǝ. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Kǝto we, ŋlǝ́ e lée ri kǝŋyɩrɩtǝyǝ rǝ mǝ gǝŋrǝ sa. Mǝ kǝkpǝŋkǝ kpǝlo kǝ loh mǝ nuŋ ló tutɛŋwǝ. Mǝ kǝpilikǝ sa ceŋceŋ wǝ́ ŋ́ nǝ́ǝ fǝ ŋ teeri lǝ́ wǝ. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />Rǝkǝsa ŋ́ no koonu lǝ́ okopiyǝ rǝ Ejipǝte lǝ gǝŋrǝ kpǝlo lo oŋuŋkǝ.» <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Wǝ́ Farawo ŋ pɔ̀rʊ na warǝpirǝ rǝ gaapirǝ ŋ kpìi Yosɛfʊ rǝ gaapirǝ. Wǝ́ ŋ fǝ̀ wǝkurukpakpǝ ŋ kpìi ŋwǝ, wǝ́ ŋ fǝ̀ sɩkakpɛtɛɛlawǝ ŋ kpìi ŋwǝ rǝ dǝreerǝ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Wǝ́ ŋ tìi pǝ fǝ Yosɛfʊ mǝ na gɔŋtǝŋwaayitǝrǝ, enyipǝ pǝ conu, pǝ wòolu pǝ lóo ko ǝkǝnǝŋ: «Nǝ kuŋ gʊŋrǝ! Nǝ kuŋ gʊŋrǝ!» Kǝ́ Farawo ŋ tìini Yosɛfʊ kǝŋyɩrɩtǝyǝ rǝ Ejipǝte kpǝlo kɩɩkɩ ŋ sanǝ wǝǝ.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Wǝ́ Farawo ŋ tǝ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri piliyǝ rǝ Ejipǝte. Paape, rǝ gǝŋrǝ sa kpǝlo kɩɩkɩ we, rɛ lee kpii ŋ née yee tǝrɛ mǝŋ o loo koonu yǝ we la gʊŋrǝ wǝ.» <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Wǝ́ Farawo ŋ kpìi Yosɛfʊ la nyɩŋrǝ ǝkǝnǝŋ Safǝnatǝ Paneya<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft" closed="false">Nyɩŋrǝ sa lo duturǝ ɖi: «Worokoyǝ we ŋ na wɛɛlɩ wǝ́ ŋ kpii vɔrʊrǝ wǝ».</char></note>. Wǝ́ ŋ kòonu ne tieyǝ, ŋwǝ ŋ ke ri Asǝnatǝ. Toolutǝyǝ Potifera la kɔrʊyǝ ŋ lǝǝwe. Potifera lo ru rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Onǝ. Wǝla kǝmaakǝ wǝ́ Yosɛfʊ ŋ pwɛ̀yɩ rǝ piliyǝ lǝ kpǝŋ ŋ ko ŋ ko ŋ ke siri Ejipǝte lǝ gǝŋrǝ we ŋ yɩrɩ. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />Yosɛfʊ lɔ̀ cɛŋwǝ tǝta kǝ́ pǝ pǝlǝ mǝ ŋwǝ rǝ Farawo, Ejipǝtetǝpiliyǝ sa lǝ kpǝŋ wǝ. Wǝ́ Yosɛfʊ ŋ pwɛ̀yɩ rǝ nǝ kpǝŋ wǝ́ ŋ ko ŋ ko. Wǝ́ ŋ kolu ŋ sìri Ejipǝte lǝ gǝŋrǝ we kpǝlo kɩɩkɩ ŋ yɩ̀rɩ. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Rǝ cɛŋpǝrɩmatawǝ we lǝ mǝrǝ keeriwǝ wǝ lah nya we, wǝ́ atɛɛtɛɛtuyǝ yǝ pònu ŋpa. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Rǝ ŋ wǝ cɛŋpǝrɩmatawǝ we lǝ mǝrǝ we, wǝ́ Yosɛfʊ ŋ kpǝ̀ ekeeriyǝ kpǝlo ŋ tǝ̀nǝ rǝ ǝtǝŋtǝǝyǝ rǝ Ejipǝte. Ka ŋ lɔ ekeeriyǝ rǝ epwiitǝŋyǝ mǝ ŋ pǝ mǝ ŋ toolu mǝ ŋ tǝnǝ rǝ ǝtǝŋtǝǝyǝ. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Wǝ́ Yosɛfʊ ŋ kpìi bǝleyǝ rǝ owulǝŋyǝ ŋ tǝ̀nǝ o lǝŋ koru ǝkǝ. Duturǝ ɖi bǝleyǝ we ka naanǝ ŋpaŋpa mǝŋ apʊyǝ la naŋrǝ kǝtǝ. Wǝ́ pǝ wɛ̀ɛ mǝ ǝkǝkǝ duturǝ ɖi pǝ lǝŋ tǝ pǝ koru ǝkǝ. <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />Toolutǝyǝ we rǝ Onǝ pǝ lóo pwo Potifera la kɔrʊ Asǝnatǝ mǝnǝ ǝpǝrǝŋpipǝ eyi kòonu Yosɛfʊ kpɛŋ wǝ́ kǝtɛŋkǝ sa kǝ ke ŋ ci o ru. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Wǝ́ Yosɛfʊ ŋ kpìi ne pimumuŋyǝ la nyɩŋrǝ ǝkǝnǝŋ Manase, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ lo koonu wǝ́ ŋ́ no yuu mǝ acʊcʊʊrʊpiyǝ kpǝlo kɩɩkɩ mǝ mǝ gbǝŋrǝ we kpǝlo ŋ́ nǝ sǝrǝ mǝ la kpɛɛ.» <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Wǝ́ ŋ kpìi ne piyitǝyǝ we ǝkǝnǝŋ Efǝrayimǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Worokoyǝ lo koonu mǝ epipǝ rǝ gǝŋrǝ sa ŋ́ na nyɩŋ ariaayǝ ŋpa wǝ.» <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />Wǝ́ cɛŋpǝrɩmatawǝ we keeriwǝ wǝ nyà we, wǝ pǝlǝ wǝ tɛ̀lɩ rǝ Ejipǝte lǝ gǝŋrǝ. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />Wǝ́ cɛŋpǝrɩmatawǝ we mǝ kǝtɛŋkǝ wǝ ke ŋ tie, mǝŋ kǝ́ Yosɛfʊ ŋ tɛnɩ wǝ kǝtǝ. Wǝ́ kǝtɛŋkǝ kǝ fìi ǝkǝŋyǝ kpǝlo kɩɩkɩ, paa keeriwǝ wǝ ke kpii rǝ Ejipǝte kpǝlo. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Wǝ́ kǝtɛŋkǝ kǝ tìe Ejipǝtetǝpǝ kpǝlo la awʊkǝ. Wǝ́ pǝ kolu pǝ ko ŋ woolu pǝ ŋ pǝ́ Farawo le keeriwǝ. Wǝ́ Farawo ŋ yìili ŋ tìi Ejipǝtetǝpǝ kpǝlo kɩɩkɩ ǝkǝnǝŋ: «Nǝ mǝ ko nǝ ka nyɩŋ Yosɛfʊ. Tuwǝ we ŋ ne tíi nǝ we, nǝ yee wǝ.» <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />Wǝ́ kǝtɛŋkǝ kǝ tò gǝŋrǝ sa kpǝlo kɩɩkɩ. Wǝ́ Yosɛfʊ ŋ kòonu pǝ tàanǝ owulǝŋyǝ we kpǝlo kɩɩkɩ, wǝ́ pǝ ke ŋ siiri keeriwǝ pǝ ŋ koonu Ejipǝtetǝpǝ. Wǝ́ kǝtɛŋkǝ kǝ tǝ kǝ ka ŋ lɛnyɩ kǝ ŋ kpii rǝ Ejipǝte rǝ.<verse eid="GEN 41:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 41:57" />Wǝ́ enyipǝ pǝ ko ŋ ru rǝ ǝkǝŋyǝ kpǝlo kɩɩkɩ pǝ ŋ pǝ Ejipǝte pǝ ŋ fuu bǝleyǝ rǝ Yosɛfʊ. Duturǝ ɖi kǝtɛŋkǝ we kǝ ka lɛnyɩ rǝ fɛɛ ri ŋ fɛɛ.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">Yakɔbǝ le kpii nǝ ǝpǝrǝŋpipǝ la maŋ rǝ Ejipǝte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Kǝ́ Yakɔbǝ ŋ no nuŋ ǝkǝnǝŋ bǝleyǝ kpii rǝ Ejipǝte we, wǝ́ ŋ tìi nǝ ǝpǝrǝŋpipǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ tini nǝ nyáa yɩrɩ awɛ wǝ? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />A lǝŋ nyɩŋ, ŋ́ no nuŋ pǝ la tɛŋ ǝkǝnǝŋ bǝleyǝ kpii rǝ Ejipǝte. Kǝto nǝ ko nǝ ko fuu ŋwǝ nǝ pǝ kǝ la pa nya le mǝ ri, kǝ le tii vɔrʊrǝ, kǝ rɛ ŋ pǝǝ kpǝ́.» <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />Wǝ́ enyitǝ rǝ Yosɛfʊ la apaanʊpǝ we lǝ mǝrǝ pǝ yili pǝ ko ŋ ko Ejipǝte pǝ ko fuu bǝleyǝ we. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Paape Yakɔbǝ laa maa Yosɛfʊ la paanʊ Bɛnǝyaminǝ ŋ siimǝ pǝ. Duturǝ ɖi yà ko ŋ suu vurǝ ǝkǝnǝŋ turɔɔrɔɔwǝ rɛ wǝ leh pe ke yee ŋwǝ. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Wǝ́ Isǝrayɛlǝ le epipǝ sa ŋpǝ ŋkpɛ pǝ kolu Ejipǝte pǝ ko fuu bǝleyǝ mǝŋ otuturupǝ kǝtǝ. Duturǝ ɖi kǝtɛŋkǝ kǝ fìi Kanaŋ lǝ gǝŋrǝ we.<verse eid="GEN 42:5" /></para>
  <para style="s">Yosɛfʊ laa lɔ na paanʊ peni sɩsiɛrɩ</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Yosɛfʊ ŋ ke ri kǝŋyɩrɩtǝyǝ rǝ gǝŋrǝ we. Ŋwǝ ŋ ka ŋ lɛ mǝ ŋ siiri bǝleyǝ mǝ ŋ koonu gǝŋrǝ we le enyipǝ kpǝlo. Wǝ́ na apaanʊpǝ we pǝ pǝlǝ pǝ sʊ̀ʊ pǝ kʊnʊ ŋwǝ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Kǝ́ Yosɛfʊ ŋ na nyɩŋ pǝ we, wǝ́ ŋ nyɩnɩ pǝ ŋ cìi. Paape laa pɔrʊ na wɛ ŋ kaŋ pǝ. Wǝ́ ŋ wɛ̀ɛlɩ mǝ pǝ kǝnyǝnyakǝnyǝnya ŋ pǝ̀ ǝkǝnǝŋ: «Nǝ nyo ru rǝ fǝŋ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lo ru rǝ Kanaŋ lo po fuu keeriwǝ.» <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />Wǝ́ Yosɛfʊ ŋ nyɩnɩ pǝ ŋ cìi, ŋpǝ paa pǝ laa nyɩŋ ŋwǝ pǝ ci. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Wǝ́ ŋ tàalǝ wǝtʊkpɛɛkpǝ we ŋ ka ŋ kpɛɛlɩ mǝ ŋ ru rǝ pǝ wǝ. Wǝ́ Yosɛfʊ ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Enyiwɛtǝpǝ wǝ́ nǝ ri! Nǝ nyǝ pǝ nǝ pa taa lah akʊŋyǝ rǝ gǝŋrǝ sa!» <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ow, kǝŋyɩrɩtǝyǝ, ŋlǝ lá asʊmatǝpǝ yǝ lǝ pǝ lo po fuu keeriwǝ rǝ oo! <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Loh kpǝlo tǝyǝ ceŋceŋ le epipǝ wǝ́ le ri. Anʊkɔrǝritǝpǝ wǝ́ le ri, yǝ lǝǝ pǝ la pa wɛ nǝ rǝ.» <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />Wǝ́ Yosɛfʊ ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyáa nia, nǝ nyǝ pǝ nǝ pa taa lǝ akʊŋyǝ rǝ gǝŋrǝ sa rǝ.» <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />Wǝ́ pǝ tìi Yosɛfʊ ǝkǝnǝŋ: «Ow, yǝ lóo ru rǝ Kanaŋ. Tǝyǝ ceŋceŋ le epipǝ wǝ́ le ri. Lǝ lǝ tǝ mǝ eyi. Rǝ wǝ la yaa we, lah paanʊpipiyǝ kpii rǝ lǝh tǝ lǝ kpǝŋ, rɛɛyǝ lǝǝ tǝ ŋ kpii.» <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />Wǝ́ Yosɛfʊ ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝ́ ŋ́ ne tíi nǝ wǝǝ, nǝ nyǝ pǝ nǝ pa wɛ lǝ rǝ! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Paape ŋ́ née tie nǝ ŋ́ yɩrɩ. Ŋ́ no tu Farawo, vǝ́ nǝ paanʊpipiyǝ we lǝǝ pǝ fɛɛwǝ sa we, nǝ nyǝŋ pwɛyɩ rǝ gǝŋrǝ sa. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Nǝ kpii nyiyǝ ceŋceŋ rǝ nǝ mǝrǝ ŋ kǝ fǝ ŋwǝ ŋ pǝ, kǝ pǝ lɔ otuturupǝ pǝ taŋ. Kǝ le tie nǝ etieyǝ sa nǝ nya tɛŋ la yɩrɩ mǝŋ kǝceecee wǝ lǝǝwe. Mǝŋ wǝ lǝǝ lǝ ǝnǝ we, ŋ́ no tu Farawo, we nǝ nyǝ pǝ nǝ pa wɛ lǝ rǝ.» <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Wǝ́ Yosɛfʊ ŋ lɔ̀ pǝ ŋ tanǝ wǝcukpǝ wǝta. <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />Juutatǝrǝ we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Fɛɛwǝ sa ŋ́ yaa we, ŋ́ nóo suu Worokoyǝ. Kǝto mǝŋ nǝ nyǝ́ǝ pǝ́ nǝ tii vɔrʊrǝ we, nǝ yee tuwǝ sa ŋ́ neh tíi nǝ wǝ.» <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Mǝŋ anʊkɔrǝritǝpǝ wǝ́ nǝ ri we, nǝ tɛɛnɩ kǝ nǝ paanʊyǝ rɛ ŋ kpɛɛ gukpǝ rǝ nyarǝwǝ sa pǝ la lɔ nǝ pǝ la taŋ wǝ. Kǝ ŋnǝ otuturupǝ we nǝ fǝ bǝleyǝ nǝ ko koonu nǝ enyipǝ pǝ fǝ pǝ cá kǝtɛŋkǝ sa. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Kǝ nǝ kǝ fǝ nǝ paanʊpipiyǝ we nǝ po koonu mǝ. Eniyǝ we ŋ́ ne ci wǝ ǝkǝnǝŋ etieyǝ sa nǝ nya tɛŋ we, yǝ kpii kǝceece, kǝ nǝ pǝǝ kpǝ́. Wǝ́ pǝ yeli pǝ sanǝ rǝ Yosɛfʊ le dierǝ we. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />Wǝ́ pǝ yìili pǝ ke ŋ tìi awɛ ǝkǝnǝŋ: «Nǝ nya nyɩŋ, tuwǝ we le yeli mǝ lah paanʊ Yosɛfʊ kǝto wǝ́ la ya yǝ láa lɔ tukoŋtawǝ sa ǝnǝ. La nyɩnɩ kǝ́ ŋ yà ŋ ka ŋ cʊʊrʊ mǝŋkǝsa, wǝ́ ŋ yà ŋ ke ŋ kpii lǝ dɔɔkpɛɛrǝ paape yǝ lǝǝ kpǝlǝŋ ŋwǝ. Tuwǝ sa kǝto wǝ́ turɔɔrɔɔwǝ sa wǝ ya wǝ lǝ́ǝ pǝ wǝ ŋ tuu lǝ wǝ.» <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />Wǝ́ Rubɛnǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ tìi nǝ ǝkǝnǝŋ rɛ ŋ pee yee mǝ piyǝ sa lo turɔɔrɔɔwǝ, paape nǝ nyoo nuŋ mǝ tutɛŋwǝ. Ruŋruŋ le jirǝ la ya yǝ láa lɔ na gbɛŋrǝ lo wǝtoomwarakpǝ.» <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Pǝ lee ke ci wǝ ǝkǝnǝŋ Yosɛfʊ ya lóo nuŋ tuwǝ we pǝ ya pǝ láa tɛŋ wǝ, duturǝ ɖi nyipʊŋpwayǝ ŋ yà ŋ ko ŋ nuŋ mǝ ŋ tɛŋ mǝ ŋ tíi pǝle kpeewǝ wǝle yi. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Wǝ́ Yosɛfʊ ŋ cɛ̀ rǝ pǝlǝ kpǝŋ ŋ kolu ŋ weli.</para>
  <para style="s" vid="GEN 42:24">Yosɛfʊ la apaanʊpǝ pǝ lǝ kpǝlǝŋ pǝ lo ko Kanaŋ</para>
  <para style="p" vid="GEN 42:24">Wǝ́ ŋ sìɛnɩ ŋ pǝlǝ ŋ tùu pǝ wǝ́ ŋ wɛ̀ɛlɩ mǝ pǝ. Wǝ́ ŋ lɔ̀ Simewɔŋ rǝ pǝlǝ mǝrǝ. Wǝ́ ŋ kòonu pǝ pàrǝ ŋwǝ rǝ pǝle enimiyǝ. <verse eid="GEN 42:24" /><verse number="25" style="v" sid="GEN 42:25" />Wǝ́ ŋ tìi pǝ kpii pǝle bǝleyǝ rǝ okotokuyǝ pwɩpwɩ, kǝ pǝ fǝ yǝ ri ŋ yǝ la sɩkayǝ pǝ kpii ŋwǝ rǝ no kotokuwǝ mǝrǝ. Wǝ́ ŋ tìi pǝ koonu pǝle keeriwǝ pǝ ke ri rǝ gʊŋrǝ. Wǝ́ pǝ yeli wǝ mǝŋkɔɔwe. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />Wǝ́ pǝ rǝ̀ǝrǝ pǝle bǝleyǝ pǝ tɛ̀ɛ rǝ pǝlo orookɛtɛpǝ, wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Kǝ́ pǝ lo ko ro fɛɛwǝ pǝ lah sʊʊrʊ pǝ kpɛɛ we, wǝ́ pǝle ceŋceŋ ŋ pǝ̀ ŋ koonu no rookɛtɛyǝ le keeriwǝ. Kǝ́ ŋ no wuru no kotokuwǝ eni we, wǝ́ ŋ nyɩnɩ kǝ́ na sɩkayǝ ŋ kpii rǝ kotokuwǝ we lo nyuŋkpǝ. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Wǝ́ ŋ tìi na apaanʊpǝ we ǝkǝnǝŋ: «Pǝ lǝ kpǝlǝŋ mǝ mǝ sɩkayǝ pǝ lo koonu mǝ oo! Ŋwǝ ŋ kpii rǝ mǝ kotokuwǝ ǝnǝ!» Wǝ́ pǝ fìi vurǝ ŋpa, wǝ́ pǝ ka ŋ ca kpakpa. Wǝ́ pǝ kǝ ŋ pǝ́ awɛ ǝkǝnǝŋ: «Kǝ́ wǝ́ Worokoyǝ ŋ ne yee mǝ lǝ ǝnǝ?»<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Kǝ́ pǝ le ke fìi pǝlǝ tǝ Yakɔbǝ lǝ kpǝŋ rǝ Kanaŋ we, wǝ́ pǝ fǝ̀ tu ri ŋ tu wǝ pǝlǝ wǝ tùu pǝ pǝ pɔ̀ na amayǝ. <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Nyiyǝ we ŋ ya ŋ náa yɩrɩ gǝŋrǝ we wɛ̀ɛlɩ mǝ lǝ kǝnyǝnyakǝnyǝnya. Ka ŋ nyɩŋ lǝ rǝ mǝŋ ŋlǝ yǝ lǝ pǝ la pa wɛ gǝŋrǝ we rǝ. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Wǝ́ le tìi ŋwǝ ǝkǝnǝŋ: “Anʊkɔrǝritǝpǝ wǝ́ le ri. Ŋkǝ yǝ lǝ́ǝ pǝ la pa wɛ gǝŋrǝ sa rǝ. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Lǝ kǝ lǝ ǝpǝrǝŋpipǝ tǝ mǝ eyi, tǝceŋceŋ le epipǝ. Lah paanʊyǝ ceŋceŋ lǝǝ tǝ ŋ kpii. Paa rǝ wǝ ǝnǝ la yaa we, lah paanʊpipiyǝ kpii rǝ Kanaŋ ŋpǝ mǝ lǝh tǝ.” <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Wǝ́ kɛrɩyǝ sa ŋ yìili ŋ tìi lǝ ǝkǝnǝŋ: “Tuwǝ ŋ́ neh yee kǝ ŋ́ ci wǝ ǝkǝnǝŋ kǝceece anʊkɔrǝritǝpǝ wǝ́ nǝ ri we, wǝ kaamǝ wǝǝ. Nǝ maa nǝ rɛ ceŋceŋ nǝ tǝnǝ rǝ mǝ kpǝŋ, nǝ fǝ keeriwǝ we wǝ lóo ro nǝ enyipǝ pǝ cá kǝtɛŋkǝ wǝ, kǝ nǝ mǝ ko. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Kǝ nǝ ke re nǝ paanʊpipiyǝ we nǝ po koonu mǝ, kǝ ŋ́ nya fɛɛ ŋ́ ci wǝ ǝkǝnǝŋ ŋkǝ nǝ nyǝ pǝ nǝ pa wɛ gǝŋrǝ sa rǝ, paa anʊkɔrǝritǝpǝ wǝ́ nǝ ri. Eniyǝ we ŋ́ na nyarǝ nǝ paanʊ Simewɔŋ ŋ́ no co ŋ́ no koonu nǝ. Nǝ nyóo koru esiri nǝ tɛlɩ rǝ gǝŋrǝ sa.”»<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Kǝ́ pǝ la tɛɛlɩ pǝle bǝleyǝ we rǝ okotokuyǝ we, wǝ́ yǝ ri ŋ yǝ ŋ nyɩnɩ na sɩkayǝ kpii rǝ zɩkalotorǝ, rǝ no kotokuwǝ lǝ mǝrǝ. Kǝ́ pǝ la nyɩŋ sɩkayǝ sa we, wǝ́ pǝlo kpǝlo pǝ fìi vurǝ mǝŋ pǝlǝ tǝ Yakɔbǝ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Wǝ́ Yakɔbǝ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nya marǝ nǝ nyo koonu wǝ́ mǝ epipǝ eyi pǝ lǝǝ tǝ pǝ kpii. Yosɛfʊ lǝǝ tǝ ŋ kpii, Simewɔŋ lǝǝ tǝ ŋ kpii. Wǝ́ rǝkǝsa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ lɔ Bɛnǝyaminǝ ŋwǝ ŋkpɛ rǝ mǝ! Kǝ otuyǝ sa kpǝlo yǝ ya yǝ ŋ tuu ŋmǝ ceŋceŋ ǝnǝ?» <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />Wǝ́ Rubɛnǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Fǝ Bɛnǝyaminǝ e kpii mǝ rǝ akaakǝ, kǝ ŋ́ ka siɛnɩ mǝ ŋwǝ ŋ́ pǝ. Vǝ́ ŋ́ naa siɛnɩ mǝ ŋwǝ ŋ́ po koonu lǝ́ we, kǝ a wʊ mǝ ǝpǝrǝŋpipǝ sa pǝle eyi.» <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />Wǝ́ Yakɔbǝ ŋ kpǝ̀lǝŋ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ sǝ́ŋ, mǝ pi lǝŋ siimǝ nǝ ŋ ko. Ne mǝtee lǝ kpǝ́, ŋwǝ ceŋceŋ ŋ no tuuru mǝ. Mǝŋ turɔɔrɔɔwǝ rɛ wǝ le ke yee ŋwǝ rǝ gʊŋrǝ pa? Ŋ́ no kuru, nǝ nyóo koonu ŋ́ nʊmʊ ŋ́ kpǝ́.»<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">Yakɔbǝ la tɛɛnɩ ne pi Bɛnǝyaminǝ ŋ siimǝ ne emǝteepǝ ŋ ko Ejipǝte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Kǝtɛŋkǝ kǝ tǝ kǝ ka ŋ lɛnyɩ kǝ ŋ kʊla rǝ Kanaŋ lǝ gǝŋrǝ we rǝ. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Kǝ́ Yakɔbǝ mǝ na anyarǝtǝpǝ pǝ le ri bǝleyǝ we pǝ rè rǝ Ejipǝte pǝ pǝlǝ pǝ la lɛ we, wǝ́ Yakɔbǝ ŋ tìi ne epipǝ ǝkǝnǝŋ: «Nǝ siɛnɩ nǝ ko Ejipǝte nǝ ko fuu ekeeriyǝ tɩpɩrɩ nǝ po koonu lǝ.» <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />Wǝ́ Yuda ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝŋyɩrɩtǝyǝ we rǝ Ejipǝte tìi lǝ wǝ sɩsiɛrɩ ǝkǝnǝŋ: “Mǝŋ nǝ nyee re nǝ baanʊpirǝ we nǝ pǝ we, nǝ kǝnie rǝ mǝ kpǝŋ!” <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Kǝto mǝŋ a la tɛɛnɩ lah paanʊ Bɛnǝyaminǝ ŋ siimǝ lǝ we, yǝ lóo ko lo ko fuu keeriwǝ lo po koonu lǝ́. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Paa mǝŋ ǝ lǝ sǝ́ŋ we, yǝ lǝŋ ko. Duturǝ ɖi nyiyǝ sa tìi lǝ wǝ sɩsiɛrɩ ǝkǝnǝŋ: “Mǝŋ nǝ nyee re nǝ baanʊpirǝ we nǝ pǝ we, nǝ kǝnie rǝ mǝ kpǝŋ!”» <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />Wǝ́ Isǝrayɛlǝ ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ tìi ŋwǝ ǝkǝnǝŋ ŋnǝ nǝ lǝǝmǝ paanʊpʊŋpwayǝ rɛ wǝ? Nǝ nya wʊ mǝ nǝ nyo co.» <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />Wǝ́ pǝ yìili pǝ ke ŋ tíi ŋwǝ ǝkǝnǝŋ: «Ŋwǝ ŋ yà ŋ ko ŋ kooru etieyǝ mǝ ŋ pǝ́ lǝ ru rǝ ŋlǝ mǝ lah nyarǝwǝ lo oŋuŋkǝ ǝkǝnǝŋ: “Nǝ tǝ tǝ kpii vɔrʊrǝ? Kǝto nǝ tǝ nǝ lǝǝmǝ paanʊpʊŋpwayǝ rɛ?” Ne etieyǝ we ŋ pǝ̀ lǝ we, ŋyǝ wǝ́ la pɔ̀rʊ le tíi ŋwǝ. Yǝ leh yee nɛ kǝ le ci wǝ ǝkǝnǝŋ leh tíi lǝ ŋlǝ le ke re lah baanʊpirǝ we lǝ pǝ wǝ?»<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Wǝ́ Yuda ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Mǝ tǝ, maa piyǝ sa ŋ siimǝ mǝ, kǝ la nya fɛɛ le yi la pwɛyɩ. Mǝŋkǝsa we, kǝ le tii vɔrʊrǝ kǝ lǝ pǝǝ kpǝ́, ŋlǝ mǝ lǝ́ mǝ leh epipǝ. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Ne die ri ŋ die vǝ mǝ. Mǝŋ ŋ́ nee re ŋwǝ ŋ́ po koonu lǝ́ we, mǝŋ ŋ́ nee re ŋwǝ ŋ pǝ lá kǝnyɩŋkǝ we, kǝ ǝ mǝ pǝ́ mǝ ŋwǝ, kǝ a tɔɔ mǝ bɔrǝ rǝ mǝ vɔrʊrǝ kǝkpakǝkpa. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Mǝŋ ŋkǝ kǝ́ yǝ lǝ pǝ tǝǝlǝ kururu kʊraa we, o koh mǝ pwo yǝ lo ko kǝyitǝkǝ yǝ lǝ pǝ pǝ kaka.» <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />Wǝ́ pǝlǝ tǝ Yakɔbǝ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ wǝ lǝ ǝnǝ we, we nǝ yee nǝ saŋ eni: Nǝ fǝ lǝh gǝŋrǝ sa lo otuceeceeyǝ rɛ nǝ kpii rǝ eleeyǝ nǝ ka cɛɛ kɛrɩyǝ sa. Nǝ re eciiyǝ kpookpoo la amɛŋfɛŋfɛŋyǝ tɩpɩrɩ, bwɛrǝ tɩpɩrɩ mǝ eciitǝnǝpiyǝ rɛ pǝ lóo pwo amaŋdǝyǝ mǝ pitasǝyǝ tɩpɩrɩ. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Nǝ kpǝlǝŋ mǝ sɩkayǝ we nǝ nyɩnɩ rǝ no okotokuyǝ lo nyuŋkpǝ nǝ ko. Ayɩrɛ yǝ we tǝǝlǝ rǝ. Kǝ nǝ tǝ nǝ fǝ sɩka pʊŋpwayǝ nǝ re. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Rǝkǝsa we, nǝ re nǝ paanʊ, kǝ nǝ kpǝlǝŋ nǝ mǝ ko kɛrɩyǝ we lǝ kpǝŋ. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Worokokopilǝtǝyǝ ŋ koonu nyiyǝ sa ŋ nyɩŋ nǝ tǝlarǝwǝ kǝ ŋ nyarǝ Bɛnǝyaminǝ mǝ Simewɔŋ ŋ co ŋ koonu nǝ. Ŋmǝ paa we, ŋ́ neh kpii fǝŋ mǝ piyǝ, kǝ a tɛŋ ŋmǝ ŋ́ nǝǝ mǝ ŋ́ nyɩŋ rǝ.»<verse eid="GEN 43:14" /></para>
  <para style="s">Yosɛfʊ la caa keeriwǝ la lɔ na apaanʊpǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Wǝ́ Yosɛfʊ le emǝteepǝ sa pǝ fǝ̀ otuyǝ we pǝ loh ko pǝ ka cɛɛ wǝ. Wǝ́ pǝ fǝ̀ sɩkayǝ we pǝ nyɩnɩ rǝ pǝlo okotokuyǝ we lo nyuŋkpǝ, fǝ kʊla mǝ sɩkapʊŋpwayǝ pǝ rè. Wǝ́ pǝ rù pǝ ko ŋ ko Ejipǝte mǝŋ Bɛnǝyaminǝ. Kǝ́ pǝ le ke fii we, wǝ́ pǝ kolu pǝ pɔ̀rʊ pǝla wɛ pǝ kanǝ Yosɛfʊ. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Kǝ́ Yosɛfʊ ŋ na nyɩŋ Bɛnǝyaminǝ kʊla mǝ pǝ we, wǝ́ ŋ tìi nyiyǝ we ŋ náa yɩrɩ na nyarǝwǝ ǝkǝnǝŋ: «Fǝ enyipǝ sa o ko nyarǝwǝ. Ka wʊ kɛɛyǝ kǝ a caa keeriwǝ, duturǝ ɖi ŋlǝ mǝ pǝ yǝ lée ri mǝ jɔkɔŋrǝ sa.» <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />Wǝ́ nyiyǝ sa ŋ yeli mǝŋ kǝ́ Yosɛfʊ ŋ tìi ŋwǝ wǝ. Wǝ́ ŋ fǝ̀ enyipǝ sa ŋ kolu no kulǝtǝyǝ Yosɛfʊ la nyarǝwǝ. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Kǝ́ pǝ loh ko mǝ pǝ rǝ Yosɛfʊ la nyarǝwǝ we, wǝ́ vurǝ ge ŋ yee pǝ. Wǝ́ pǝ ka ŋ tɛŋ pǝ ŋ tíi awɛ ǝkǝnǝŋ: «Sɩkayǝ sa pǝ fǝ̀ pǝ kpìi lǝ rǝ loh okotokuyǝ lǝ mǝrǝ kǝ́ lǝ sǝnǝ lǝ pǝlǝ kǝto wǝ́ pǝ lǝ fǝ lǝ pǝ lǝ pǝ fɛɛwǝ sa. Pǝ lée si lǝ pǝ maarǝ ŋwɩ, kǝ pǝ pieeli lǝ. Pǝ láa lɔ loh orookɛtɛpǝ, kǝ pǝ fǝ lǝ pǝ yee arɔŋpǝ.» <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />Eniyǝ we pǝ leh fii nyarǝwǝ, rǝ guŋpolurǝ we, wǝ́ pǝ rùu pǝ kǝ̀lǝ mǝ nyiyǝ sa ŋ náa yɩrɩ nyarǝwǝ sa wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />«Kulǝtǝyǝ, dɔɔkpɛ, lǝ sǝnǝ lǝ pǝlǝ lo fùu keeriwǝ. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Kǝ́ yǝ lo ko ro fɛɛwǝ we yǝ lah sʊʊrʊ la kpɛɛ we, kǝ́ yǝ lo wuru loh okotokuyǝ eni we, wǝ́ la nyɩnɩ yǝ ri ŋ yǝ la sɩkayǝ kǝ́ ŋ kpii rǝ no kotokuwǝ lo nyuŋkpǝ wǝ. Sɩkayǝ we la mwàra kpaŋ ŋ kǝ lǝǝwe. Kǝto yǝ le re ŋwǝ sɩkayǝ we yǝ lǝ pǝ. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Wǝ́ yǝ le ci ere sɩkapʊŋpwayǝ lo po fuu keeriwǝ wǝ. Yǝ lee ci yǝ ŋ sìɛnɩ mǝ sɩkayǝ sa ŋ kpìi rǝ loh okotokuyǝ wǝ.» <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />Wǝ́ nyiyǝ sa ŋ yìili ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Nǝ ta nǝ wɛ, nǝ pǝǝ tǝ nǝ suu vurǝ. Nǝ Worokoyǝ, nǝ tǝ lo Worokoyǝ ŋ na ŋwaa ŋ ne kpii nǝ sɩkayǝ sa rǝ nǝ okotokuyǝ lǝ mǝrǝ. Mǝŋ nǝ sɩkayǝ we nǝ mwàra we, ŋ lɔ̀ ŋwǝ kǝceece.» Wǝ́ nyiyǝ sa ŋ kolu ŋ nyàrǝ Simewɔŋ ŋ cò ŋ kòonu pǝ.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Wǝ́ ŋ fìi mǝ enyipǝ sa kpǝlo kɩɩkɩ rǝ Yosɛfʊ la nyarǝwǝ. Wǝ́ ŋ tʊ̀ʊ mɛŋwǝ ŋ kòonu pǝ pǝ wɛ̀ɛ akparǝyǝ. Wǝ́ ŋ kòonu pǝlo orookɛtɛpǝ we la bɔɔrǝ. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Wǝ́ pǝ kpàka otuyǝ we pǝ le re pǝ pa cɛɛ pǝ tǝ̀nǝ pǝ kǝ ŋ rǝŋ Yosɛfʊ lǝ ǝpǝkǝ mǝ cɔkɔŋtiizaarǝ. Kpiikǝ pǝ nunu wǝ ǝkǝnǝŋ ŋpǝ pǝ lée ri rǝ we mǝŋ ŋwǝ.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Kǝ́ Yosɛfʊ ŋ na nya ŋ ne pe fii nyarǝwǝ ko, wǝ́ pǝ fǝ̀ otuyǝ we pǝ le re pǝ pa cɛɛ ŋwǝ pǝ kòonu ŋwǝ, wǝ́ pǝ sʊ̀ʊ pǝ kʊnʊ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ rǝ na kǝnyɩŋkǝ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ la kaalǝ nǝ?» Wǝ́ ŋ tǝ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ tǝ nyumuyǝ we nǝ cò tɛɛrɩwǝ nǝ tìi mǝ pa, kǝ la kaalǝ ŋwǝ? Tǝ kpii vɔrʊrǝ?» <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Awo, lá sʊmatǝyǝ, lǝh tǝ, kpii sɩsiɛrɩ.» Wǝ́ pǝ tǝ pǝ sʊ̀ʊ pǝ kʊnʊ ŋwǝ pǝ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />Kǝ́ Yosɛfʊ ŋ ne yiili anyɩŋkǝ we, wǝ́ ŋ nyɩnɩ na paanʊ Bɛnǝyaminǝ, ne lee le piyǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝto nǝ paanʊpipiyǝ we nǝ ke ŋ tíi mǝ ǝ yǝǝ?» Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pi, Worokoyǝ ŋ pɛɛrɩ lǝ́!»<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />Kǝ́ Yosɛfʊ ŋ na nyɩŋ na paanʊ we, wǝ́ wǝ yeli na tǝrɛ ŋpa, wǝ́ enimiyǝ yǝ tǝ̀nǝ ŋwǝ yǝlǝŋyǝlǝŋ. Wǝ́ ŋ yili kalaŋ ŋ ke ŋ fii no gukpǝ ŋ kolu ŋ weli. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />Wǝ́ ŋ wɛ̀ɛ anyɩŋkǝ kpɛŋ wǝ́ ŋ ci o rù ŋ pǝlǝ. Wǝ́ ŋ tà na wɛ, wǝ́ ŋ tìi pǝ sǝpǝ keeriwǝ we. <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />Wǝ́ pǝ kpìi Yosɛfʊ le keeriwǝ pǝ tǝ̀nǝ ŋwǝ ceŋceŋ kpoo. Wǝ́ pǝ kpìi na paanʊ peni ŋpǝ ŋkpɛ kpoo. Ejipǝtetǝpǝ we pǝ lo pwo pǝ pe ri ŋpǝ ŋkpɛ kpoo, duturǝ ɖi wǝ lee kpii kǝ Ejipǝtetǝpǝ pǝ ri pǝ kʊla mǝ Ehebǝritǝpǝ, kǝpɔkǝ wǝ́ wǝ ri wǝ koonu Ejipǝtetǝpǝ. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Wǝ́ Yosɛfʊ la apaanʊpǝ sa pǝ tini rǝ Yosɛfʊ la kǝnyɩŋkǝ. Wǝ́ pǝ tìini pǝ rǝ tɛɛ rǝ tɛɛ, fǝ rǝ mumuŋyǝ ko ru ǝrǝ laatiepiyǝ. Wǝ́ pǝ fǝ̀ pǝ kpǝ̀ pǝ tini pǝ ka ŋ yɩrɩ awɛ rǝ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Wǝ́ Yosɛfʊ ŋ tìi pǝ pǝlǝ pǝ mwɛ̀nɩ keeriwǝ we wǝ ka kpɛlɩ rǝ na kǝnyɩŋkǝ pǝ kpìi pǝ. Wǝ́ ŋ tìi pǝ kpìi Bɛnǝyaminǝ le keeriwǝ wǝ nàanǝ wǝ tèeri ne emǝteetuturupǝ la nɛŋwǝ pǝrǝŋwǝ kǝtʊʊ. Wǝ́ pǝlo kpǝlo mǝŋ Yosɛfʊ pǝ ŋunu pǝ pìemu.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Pǝ la tɛɛ Bɛnǝyaminǝ la acɛɛyǝ ǝkǝnǝŋ la yɩɩ Yosɛfʊ la sɩkakɔpʊwǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Wǝla kǝmaakǝ wǝ́ Yosɛfʊ ŋ tìi nyiyǝ we ŋ náa yɩrɩ na nyarǝwǝ ǝkǝnǝŋ: «Lǝǝrǝ enyipǝ sa lo okotokuyǝ mǝ keeriwǝ. Kpii pǝ kǝ́ pǝ lóo koru ere rǝ ko, kǝ a lɛ ǝ fǝ nyi ri ŋ nyi la sɩkayǝ e kpii ŋwǝ rǝ no kotokuwǝ lo nyuŋkpǝ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Fǝ mǝ kɔpʊwǝ, mǝ sɩkakɔpʊwǝ e kpii rǝ pipiyǝ we lo kotokuwǝ a kʊla mǝ sɩkayǝ we ŋ ne re ŋ po fuu keeriwǝ wǝ.» Wǝ́ nyiyǝ sa ŋ yeli mǝŋ kǝ́ Yosɛfʊ ŋ tìi ŋwǝ wǝ. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />Gaalǝǝrǝkǝ lo ɖokoŋpirǝ ŋalaŋala we wǝ́ pǝ cò pǝ la kʊŋ pǝ ko ŋ ko mǝŋ pǝlo orookɛtɛpǝ. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Wǝ́ pǝ rù rǝ tǝŋtǝǝwǝ sa, paa pǝ faa ka maa pǝ lǝǝrǝ. Wǝ́ Yosɛfʊ ŋ tìi nyiyǝ we ŋ náa yɩrɩ na nyarǝwǝ ǝkǝnǝŋ: «Yi! Piri enyipǝ sa o ko tuu. Vǝ́ o lo ko tuu pǝ we, pǝ́ pǝ ǝkǝnǝŋ: “Kǝ́ kǝto wǝ́ nǝ nyǝ fǝ wǝrɔɔrɔɔkpǝ nǝ nya mwara wǝceeceekpǝ pǝ le yee nǝ wǝ? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Kǝ́ kǝto wǝ́ nǝ nya yɩɩ mǝ kulǝtǝyǝ la kɔpʊwǝ ŋ nǝ́ǝ fǝ mǝ ŋ ŋuŋ mɛŋwǝ wǝ́ ŋ náa lɛ mǝ ŋ fǝ mǝ ŋ kpaa wǝ? Tuwǝ sa nǝ nye yee wǝ pǝlǝ!”»<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Kǝ́ nyiyǝ sa ŋ no ko tuu pǝ we, wǝ ŋ fǝ̀ etieyǝ sa ŋ pǝ̀ pǝ. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Wǝ́ Yosɛfʊ la apaanʊpǝ sa pǝ yìili pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, nɛ kǝto wǝ́ a láa tɛŋ tuwǝ sa wǝrʊʊkpǝ a tɛɛ rǝ lǝ ǝnǝ? Ŋlǝ lá asʊmatǝpǝ yǝ lǝŋ koru otu turuwǝ le yee tuwǝ sa wǝrʊʊkpǝ pwi! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Yɩrɩ re! Yǝ le re sɩkayǝ we la nyɩnɩ rǝ loh okotokuyǝ lo nyuŋkpǝ rǝ Kanaŋ yǝ lóo po koonu lǝ́. Wǝ́ wǝ lée yee nɛ kǝ lo koru a pa yɩɩ sɩkakpɛɛlɩyǝ amaa sɩkamwɛɛrɩyǝ rǝ ló kulǝtǝyǝ la nyarǝwǝ wǝ? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Kulǝtǝyǝ, mǝŋ a la nyɩŋ kɔpʊwǝ sa rǝ lah rɛ le eleeyǝ mǝrǝ we, yǝ we ŋ kpǝ́. Kǝ ŋlǝ otuturupǝ sa we, la siɛrɩ le yee lá arɔŋpǝ!» <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />Wǝ́ nyiyǝ sa ŋ yìili ǝkǝnǝŋ: «Wǝ ponu! Ŋ́ na tɛɛnɩ nǝ dierǝ sa. Paa we, yǝ we lǝ kpǝŋ pǝ láa nyɩŋ kɔpʊwǝ sa we, ŋwǝ ŋ née ri mǝ rɔŋyǝ wǝ. Ŋnǝ otuturupǝ we, o lóo turu nǝ nyóo ru rǝ wǝ.» <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />Rǝ kǝyaakǝ we wǝ́ nyi ri ŋ nyi ŋ sʊ̀ʊrʊ ne eleeyǝ kalaŋ rǝ no rookɛtɛyǝ ŋ tǝ̀nǝ rǝ kǝtǝǝwǝ. Wǝ́ pǝ wùru okotokuyǝ we. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Wǝ́ nyiyǝ sa ŋ tàa okotokuyǝ sa kpǝlo kɩɩkɩ. Sǝnǝ rǝ mumuŋyǝ we lo kotokuwǝ, wǝ́ ŋ kolu ŋ tǝ̀ǝlǝ mǝ laatiepiyǝ we la nɛŋwǝ. Wǝ́ pǝ nyɩnɩ kɔpʊwǝ we rǝ Bɛnǝyaminǝ lo kotokuwǝ mǝrǝ. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Wǝ́ wǝ fìi pǝ, wǝ́ pǝ làarǝ pǝla wǝkpakpǝ. Wǝ́ nyi ri ŋ nyi ŋ tǝ ŋ rǝ̀ǝrǝ ne eleeyǝ ŋ tɛ̀ɛ rǝ no rookɛtɛyǝ, wǝ́ pǝ kpǝ̀lǝŋ pǝ ko ŋ ko tǝŋtǝǝwǝ sa.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Wǝ́ Yuda mǝ na apaanʊpǝ pǝ kolu pǝ fìi Yosɛfʊ la nyarǝwǝ. Yosɛfʊ kǝ tǝ kpìi rǝ nyarǝwǝ. Wǝ́ pǝ sʊ̀ʊ pǝ kpɛlɩ pǝ pùnu anyɩŋkǝ rǝ kǝtǝǝwǝ rǝ na kǝnyɩŋkǝ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Wǝ́ Yosɛfʊ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nye yee tuwǝ sa ǝnǝ? Nǝ nyee ci wǝ ǝkǝnǝŋ nyi mǝŋ ŋmǝ lǝǝmǝ okopiyǝ ŋ náa kpaa?» <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />Wǝ́ Yuda ŋ lɔ̀ kpɛɛwǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kǝŋyɩrɩtǝyǝ, kǝ́ wǝ́ yǝ lah tɛŋ! Kǝ́ wǝ́ lǝ lǝǝmǝ yǝ lah tɛŋ rǝkǝsa? Yǝ lǝǝ lǝmǝ dierǝ rɛ lah pɔrʊ gaŋ ǝkǝnǝŋ ŋlǝ yǝ lee yee tǝrɛ! Worokoyǝ ŋ na saarǝ ŋlǝ lá asʊmatǝpǝ lo turɔɔrɔɔwǝ. Kǝto yǝ lée ri lá arɔŋpǝ mǝŋ yǝ we le eleeyǝ mǝrǝ pǝ la nyɩŋ kɔpʊwǝ we wǝ.» <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />Wǝ́ Yosɛfʊ ŋ yìili ǝkǝnǝŋ: «Ow, ŋ́ nǝŋ tu turuwǝ ŋ́ yee wǝ ǝnǝ pwi. Yǝ we lǝ kpǝŋ pǝ la nyɩŋ kɔpʊwǝ sa we, ŋwǝ ko ŋ née ri mǝ rɔŋyǝ wǝ. Ŋnǝ we, nǝ kpǝlǝŋ nǝ mǝ ko nǝ tǝ lǝ kpǝŋ rǝ wǝtaarǝkpǝ.»<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Wǝ́ Yuda ŋ rùu ŋ kǝ̀lǝ mǝ Yosɛfʊ wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Dɔɔkpɛ, Kulǝtǝyǝ, koonu mǝ gʊŋrǝ ŋ tɛŋ dierǝ rɛ ŋ́ tíi lǝ́ oo. Pǝǝ fǝ kpɛɛmʊrʊwǝ mǝ ŋmǝ lá sʊmatǝyǝ oo. Duturǝ ɖi ŋnǝ mǝ Farawo nǝ kaa rǝ. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Kulǝtǝyǝ, ǝ sǝnǝ ǝ pǝ̀ lǝ, ŋlǝ lá asʊmatǝpǝ mǝŋ lǝ lǝǝmǝ tǝyǝ amaa paanʊpʊŋpwayǝ rɛ. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Wǝ́ le tìi lǝ́ ǝkǝnǝŋ: “Lǝ lǝǝmǝ tǝyǝ, paa lo kuru. Wǝ́ la lɛ lǝ lǝǝmǝ baanʊpirǝ. Lǝh tǝ kùru kpɛŋ wǝ́ ŋ cìi ǝ mǝnǝ ŋwǝ. Piyǝ sa le mǝteeyǝ lǝ kpǝ́. Ŋwǝ ŋ ri ne lee le piceŋceŋyǝ ŋ kpii vɔrʊrǝ wǝ. Wǝ́ nǝ tǝ ŋ náa taa nǝ kǝǝwǝ.” <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Wǝ́ e tìi lǝ ǝkǝnǝŋ: “Nǝ re ŋwǝ nǝ po koonu mǝ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ nyɩŋ ŋwǝ.” <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Wǝ́ la pɔ̀rʊ wǝ le tìi lǝ́ ǝkǝnǝŋ piyǝ sa lǝŋ koru apwɛyɩ rǝ nǝ tǝ lǝ kpǝŋ. Mǝŋ la pwɛyɩ la maa ŋwǝ we, nǝ tǝ lǝ́ǝ kpǝ́. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Wǝ́ e tìi lǝ ǝkǝnǝŋ mǝŋ lah paanʊpipiyǝ we laa tɛɛmǝ lǝ ŋ pǝ we, we leh kǝnie! <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Kǝ́ yǝ la sìɛnɩ yǝ lo ko tuu lǝh tǝ, lá sʊmatǝyǝ we we, wǝ́ lǝ fǝ̀ dierǝ we a tɛnɩ la pɔ̀ na amayǝ. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Kǝ́ ŋ neh kpii lǝ lǝ tǝ lo po fuu keeriwǝ we, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />wǝ́ le tìi ŋwǝ ǝkǝnǝŋ: “Yǝ lǝŋ koru oko, we lah paanʊpipiyǝ sa láa tɛɛmǝ lǝ ŋ ko kpɛŋ. Duturǝ ɖi mǝŋ laa kʊla mǝ lǝ we, kǝŋyɩrɩtǝyǝ we lǝŋ ka lɔ lǝ.” <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />Wǝ́ lǝh tǝ ŋ yìili ŋ tìi lǝ ǝkǝnǝŋ: “Nǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ epipǝ eyi ko wǝ́ mǝ tie Rasiɛlǝ ŋ mǝnǝ ŋ kòonu mǝ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Ceŋceŋ la pwɛyɩ rǝ mǝ kpǝŋ, ŋ́ cii wǝ ǝkǝnǝŋ kɛɛyǝ rɛ la ka lɔ ŋwǝ lo wo. Duturǝ ɖi ŋ́ nǝǝ tǝ ŋ́ pa nyɩŋ ŋwǝ po ro ruŋruŋ. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Wǝ́ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ fǝ yǝ ǝnǝ ŋwǝ ŋkpɛ rǝ mǝ kpǝŋ! Vǝ́ turɔɔrɔɔwǝ rɛ wǝ le ke yee ŋwǝ we, ŋ́ no kuru, nǝ nyóo koonu ŋ́ nʊmʊ ŋ́ kpǝ́.” <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />Kǝŋyɩrɩtǝyǝ, rǝkǝsa ŋ́ nǝŋ koru asiɛnɩ ŋ́ ko tuu mǝ tǝ kǝ oturu piyǝ sa laa kʊla mǝ lǝ! Piyǝ sa kǝto wǝ́ mǝ tǝ ŋ tini vɔrʊrǝ wǝ. <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />Mǝŋ laa nyɩŋ piyǝ sa ŋ kʊla mǝ lǝ we, lǝ́ǝ kpǝ́. O lóo turu ŋlǝ yǝ lo koonu wǝ́ ŋ na nʊmʊ ŋ nǝ kpǝ́ rǝ no kǝnyumukǝ wǝ. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Tǝ fǝ kʊla we, ŋmǝ ŋ́ yàa piyǝ sa la kǝmaakǝ rǝ mǝ tǝ la kǝnyɩŋkǝ. Wǝ́ ŋ́ tìi ŋwǝ ǝkǝnǝŋ: “Mǝŋ ŋ́ nee re ŋwǝ ŋ po koonu lǝ́ we, kǝ a tɔɔ mǝ bɔrǝ kǝkpakǝkpa.” <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />Dɔɔkpɛ, rǝkǝsa we, maa kǝ ŋ́ ri lá rɔŋyǝ kǝ mǝ ŋ sʊma lǝ́ rǝ piyǝ sa lo yuwǝ, kǝ ŋ nya fɛɛ mǝ ŋ ko ŋpǝ mǝ na apaanʊtuturupǝ. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Mǝŋ ŋ́ nee re piyǝ sa we, ŋ́ nǝŋ koru ǝkpǝlǝŋ ŋ́ ko mǝ tǝ lǝ kpǝŋ pwi. Ŋ́ nǝŋ ko koru ayɩrɩ boŋpomumuŋrǝ sa loh tuu mǝ tǝ mǝ mǝ enimiyǝ.»<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">Yosɛfʊ la pɔrʊ na wɛ la kaŋ na apaanʊpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Rǝ fɛɛwǝ we we, Yosɛfʊ lǝǝ tǝ ŋ koru na wɛ la ata rǝ enyipǝ we kpǝlo kɩɩkɩ pǝ ka yaa rǝ nǝ kpǝŋ la kǝnyɩŋkǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ pɔrʊ nyi ri ŋ nyi nǝ ru rǝ mǝ kpǝŋ!» Rɛ ri ŋ rɛ lǝǝ kǝ tǝ ŋ yaa rǝ nǝ kpǝŋ kǝ́ ŋ ka ŋ pɔrʊ na wɛ mǝ ŋ kaŋ na apaanʊpǝ we wǝ. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Wǝ́ Yosɛfʊ ŋ sìe narǝwǝ ŋ yà ŋ ke ŋ wee kǝŋkǝŋ. Wǝ́ Ejipǝtetǝpǝ we pǝ nunu, wǝ́ tuwǝ sa wǝ kolu wǝ rù ǝrǝ Farawo la nyarǝwǝ. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />Wǝ́ Yosɛfʊ ŋ tìi na paanʊ peni ǝkǝnǝŋ: «Ŋmǝ Yosɛfʊ ŋ́ lǝǝwe! Kǝto mǝ tǝ kpii vɔrʊrǝ?» Wǝ́ wǝ rili na paanʊ peni lo mumuŋ wǝ́ pǝ kpǝ̀ pǝ yàa pǝ ka ŋ yɩrɩ ŋwǝ pǝ lee ci wǝ pǝ leh tíi ŋwǝ. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ dɔɔkpɛ, nǝ ruu nǝ kǝlǝ mǝ mǝ.» Wǝ́ pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ Yosɛfʊ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Ŋmǝ Yosɛfʊ ŋ́ lǝǝwe. Nǝ paanʊyǝ we nǝ sìiri pǝ fǝ pǝ ko ŋ ko Ejipǝte wǝ. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Paa rǝkǝsa we, nǝ pǝǝ kǝǝnǝ, nǝ pǝǝ fǝ nǝ wɛ la kpɛɛmʊrʊwǝ mǝ kǝ́ nǝ sìiri mǝ wǝ́ pǝ fǝ̀ mǝ pǝ kǝ ŋ pǝ fɛɛwǝ sa wǝ. Worokoyǝ ŋ ne kpii mǝ ŋ na maŋ rǝ fɛɛwǝ sa ŋ no coonu, kǝ ŋ́ nya fɛɛ ŋ́ pa lɔ nǝ vɔrʊrǝ. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Duturǝ ɖi wǝ le yee cɛŋwǝ yi kǝ́ kǝtɛŋkǝ kǝ lo ru rǝ gǝŋrǝ sa wǝ. Wǝ lǝ tǝ wǝ lo tuuru cɛŋwǝ tʊʊ milimili enyipǝ pǝ lǝŋ pa kpɛŋ wǝ́ pǝ lǝŋ pǝ fǝ keeriwǝ. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Worokoyǝ le kpii mǝ rǝ gǝŋrǝ sa lo coonu rǝ nǝ kǝnyɩŋkǝ, kǝ nǝ nya fɛɛ nǝ pǝ tǝnǝ wǝmǝkpǝ, kǝ nǝ nya fɛɛ nǝ tii vɔrʊrǝ saŋ rǝ alɔkuŋmumuŋkǝ rɛ. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Kǝto ŋkǝ ŋnǝ nǝ nye kpii mǝ nǝ nya maŋ rǝ fɛɛwǝ sa, Worokoyǝ ŋ lǝǝwe. Worokoyǝ lǝ fǝ mǝ le yee Ejipǝtetǝpiliyǝ lǝ tǝyǝ, kulǝtǝyǝ rǝ na nyarǝwǝ kpǝlo, mǝ Ejipǝte kpǝlo lǝ kǝŋyɩrɩtǝyǝ. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Kǝto rǝkǝsa we, nǝ fǝǝlǝ, nǝ mǝ ko mǝ tǝ lǝ kpǝŋ. Nǝ ke tíi ŋwǝ ǝkǝnǝŋ ne pi Yosɛfʊ ŋ no co tɔɔwǝ sa pǝ pe tíi ŋwǝ ǝkǝnǝŋ: “Worokoyǝ lǝ fǝ mǝ le yee kulǝtǝyǝ rǝ Ejipǝte lǝ gǝŋrǝ kpǝlo. Pǝǝ tǝǝlǝ, yi kalaŋ ǝ mǝ pǝ mǝ kpǝŋ. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />E leh pe tii rǝ Gosɛnǝ la gaarǝ kǝ a nya fɛɛ ǝ kǝlǝ mǝ mǝ, ŋlǝ́, lé epipǝ, lé epilepipǝ, lá amɛɛpǝ, lé epereceepǝ, lá anɛŋpǝ mǝ ló otulǝmǝyǝ kpǝlo kɩɩkɩ. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Ŋ́ nah mǝ yɩrɩ lǝ́ yurǝ rǝ fɛɛwǝ we, ŋlǝ́, ló otuulupǝ mǝ ló otulǝmǝyǝ kpǝlo kǝ tǝrɛ wǝ pee pe yee nǝ ariaayǝ. Duturǝ ɖi kǝtɛŋkǝ sa kǝ lǝ́ǝ tǝ kǝ yee cɛŋwǝ tʊʊ.”» <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />Wǝ́ Yosɛfʊ ŋ tǝ ŋ yìili ǝkǝnǝŋ: «Ŋnǝŋnǝ nǝ ya nǝ nyáa nyɩŋ mǝ nǝ enimiyǝ, wǝ́ otukpǝlo mǝ paanʊ Bɛnǝyaminǝ ŋwǝ ŋkpɛ ŋ ya ŋ náa nyɩŋ wǝ ǝkǝnǝŋ ŋmǝ Yosɛfʊ ŋ́ no wuru nyuŋkpǝ ŋ́ ya ŋ́ náa wɛɛlɩ mǝ nǝ. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Nǝ ka pɔrʊ nǝ tíi mǝ tǝ, kǝ́ enyipǝ pǝ lǝ́ǝ kǝ mǝ pǝ ŋ fǝ rǝ Ejipǝte lǝ gǝŋrǝ sa wǝ. Nǝ lɛ nǝ fǝ tu ri ŋ tu nǝ nya pa nyɩŋ nǝ pɔ na amayǝ. Nǝ fǝǝlǝ kǝ nǝ kǝ fǝ ŋwǝ nǝ pǝ fɛɛwǝ sa.» <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />Wǝ́ Yosɛfʊ ŋ kolu ŋ pùru Bɛnǝyaminǝ rǝ dǝreerǝ wǝ́ pǝle eyi pǝ pàla awɛ pǝ rè wǝ́ pǝ yà pǝ ke ŋ wee. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Wǝ́ Yosɛfʊ ŋ kolu ŋ pàla na apaanʊpǝ we kpǝlo mǝ enimiyǝ. Wǝ́ na apaanʊpǝ we pǝ cìi o kòru a tɛ̀ɛrɩ mǝ ŋwǝ.<verse eid="GEN 45:15" /></para>
  <para style="s">Farawo lo pwo Yakɔbǝ ŋ pǝ Ejipǝte</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Wǝ́ pǝ nunu wǝ rǝ Farawo la nyarǝwǝ ǝkǝnǝŋ Yosɛfʊ la apaanʊpǝ pǝ lǝ pǝ Ejipǝte. Wǝ́ tuwǝ sa wǝ ranǝ mǝ Farawo mǝ na asʊmatǝpǝ. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Wǝ́ Farawo ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Tíi lá apaanʊpǝ we pǝ rǝǝrǝ pǝle eleeyǝ pǝ tɛɛ pǝlo orookɛtɛpǝ kǝ pǝ kpǝlǝŋ pǝ ŋ ko Kanaŋ lǝ gǝŋrǝ, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />kǝ pǝ kǝ fǝ pǝlǝ tǝ mǝ pǝlo otuulupǝ pǝ pǝ mǝ kpǝŋ. Ŋ́ nǝh pǝ fǝ Ejipǝte lǝ gǝŋrǝ lo otuceeceeceeceeyǝ ŋ́ koonu pǝ, kǝ pǝ ŋ ri kǝtǝǝwǝ we lo otuceeceeyǝ. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />Kǝ ǝ tǝ e tíi lá apaanʊpǝ we ǝkǝnǝŋ pǝ fǝ orookɛtɛŋwaayǝ rǝ Ejipǝte pǝ ŋ ko pǝ kǝ fǝ pǝle etiepǝ, pǝle epipǝ mǝŋ pǝlǝ tǝ pǝ pǝ. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Pǝ pǝǝ kǝǝnǝ otuyǝ we pǝ lah maa pǝ co rǝ we wǝ, duturǝ ɖi Ejipǝte lǝ gǝŋrǝ kpǝlo lo otuceeceeceeceeyǝ we, yǝ leh pe ri pǝla anɛŋ.»<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Wǝ́ Isǝrayɛlǝ le epipǝ we pǝ yeli pǝ sanǝ mǝŋ kǝ́ pǝ tìi pǝ wǝ. Wǝ́ Yosɛfʊ ŋ kòonu pǝ lo orookɛtɛŋwaayǝ mǝŋ kǝ́ Farawo ŋ tìi ŋwǝ wǝ. Wǝ́ ŋ lɛ̀ ŋ kòonu pǝle keeriwǝ pǝ leh ke ri rǝ gʊŋrǝ wǝ. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Wǝ́ ŋ kòonu nyi ri ŋ nyi la kǝkpacɛkǝ kǝceŋceŋ, paa wǝ́ ŋ kòonu Bɛnǝyaminǝ wǝtʊʊ mǝ sɩkakpɛɛlɩyǝ sekɛlɩyǝ tuuruta. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Wǝ́ ŋ ci ǝfǝ̀ Ejipǝte lo otuceeceeceeceeyǝ ŋ tɛ̀ɛ orookɛtɛpǝ ǝtǝ pǝ ko koonu nǝ tǝ. Wǝ́ ŋ fǝ̀ bǝleyǝ, kpɔnɔyǝ mǝ ekeeripʊŋpwayǝ ŋ tɛ̀ɛ orookɛtɛyeepǝ ǝtǝ pǝ ko koonu nǝ tǝ ŋ pe re ŋ saŋ gʊŋrǝ. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Wǝ́ Yosɛfʊ ŋ cò na paanʊ peni la kʊŋ. Kǝ́ pǝ lah pwɛyɩ we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ paa ka kpaŋ rǝ gʊŋrǝ oo.» <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />Wǝ́ pǝ pwɛ̀yɩ rǝ Ejipǝte lǝ gǝŋrǝ pǝ kolu pǝ tùu pǝlǝ tǝ Yakɔbǝ rǝ Kanaŋ lǝ gǝŋrǝ. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yosɛfʊ tǝ kpii vɔrʊrǝ oo! Wǝ́ ŋwǝ ŋ ri kǝŋyɩrɩtǝyǝ rǝ Ejipǝte lǝ gǝŋrǝ kpǝlo kɩɩkɩ!» Wǝ́ Yakɔbǝ ŋ kpǝ̀ ŋ yàa laa lɔ pǝ ŋ nuŋ. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Wǝ́ pǝ fǝ̀ etieyǝ we kpǝlo kɩɩkɩ Yosɛfʊ ŋ tìi pǝ we, pǝ pɔ̀ pǝlǝ tǝ Yakɔbǝ la amayǝ. Wǝ́ ŋ nyɩnɩ orookɛtɛŋwaayǝ we Yosɛfʊ ŋ kpìi ŋ manǝ yǝ pǝ fǝ ŋwǝ wǝ. Wǝ́ no susuyǝ ŋ ci a sàanǝ. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Wǝ́ Isǝrayɛlǝ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ lo roo mǝ! Akparǝkǝ mǝ pi Yosɛfʊ ŋ tǝ ŋ kpii vɔrʊrǝ wǝ! Ŋ́ nǝ́ǝ pǝ́ ŋ́ ko ŋ́ ka nyɩŋ ŋwǝ kpɛŋ kǝ ŋ́ ci ǝkpǝ́!»<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">Yakɔbǝ la tɛlɩ Ejipǝte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Wǝ́ Isǝrayɛlǝ ŋ kʊ̀laŋ no otuyǝ kpǝlo kɩɩkɩ wǝ́ ŋ fǝ̀ gʊŋrǝ. Kǝ́ ŋ ne ke fii Bɛrǝseba we, wǝ́ ŋ yeli otoolukǝ ŋ kòonu nǝ tǝ Isakǝ lo Worokoyǝ <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Wǝlo dumurǝ we we, wǝ́ Worokoyǝ ŋ wɛ̀ɛlɩ mǝ ŋwǝ rǝ kǝtʊkpɛɛkǝ. Wǝ́ ŋ pwò ŋwǝ ǝkǝnǝŋ: «Yakɔbǝ! Yakɔbǝ!» Wǝ́ Yakɔbǝ ŋ yìili ǝkǝnǝŋ: «Ŋmǝ ǝyǝǝ.» <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />Wǝ́ Worokoyǝ ŋ yìili ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Worokoyǝ, lǝ́ tǝ lo Worokoyǝ. Ejipǝte lo okookǝ kǝ poo co lǝ́ vurǝ. Duturǝ ɖi fɛɛwǝ we wǝ́ ŋ́ nǝh kǝ fǝ lǝ́ ŋ yee kǝkpǝŋmumuŋkǝ rɛ wǝ. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Ŋmǝŋmǝ ŋ́ náa ca lǝ́ ŋ́ ko Ejipǝte. Wǝ́ ŋmǝ ke ŋ́ nah ka siɛnɩ mǝ lǝ́ ŋ́ pǝ kǝceece. Yosɛfʊ ŋ nah pa ka lɔ lé enimiyǝ ŋ sii vǝ́ ǝ lǝ kpǝ́ wǝ.» <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />Wǝ́ Yakɔbǝ ŋ pwɛ̀yɩ rǝ Bɛrǝseba. Wǝ́ Isǝrayɛlǝ lǝ ǝpǝrǝŋpipǝ pǝ fǝ̀ pǝlǝ tǝ Yakɔbǝ, pǝle epipǝ mǝ pǝle etiepǝ pǝ kpìi rǝ orookɛtɛŋwaayǝ we Farawo ŋ kpìi ŋ manǝ yǝ kǝ fǝ pǝ wǝ. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Wǝ́ pǝ rè pǝla akɛɛpǝ mǝ pǝlo otulǝmǝyǝ we pǝ nyà rǝ Kanaŋ lǝ gǝŋrǝ pǝ pwɛ̀yɩ. Wǝ́ Yakɔbǝ mǝ nǝ wǝmǝkpǝ kpǝlo kɩɩkɩ pǝ ko ŋ ko Ejipǝte. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Nǝ ǝpǝrǝŋpipǝ mǝ ne etiepipǝ, ne epilepipǝrǝŋpipǝ mǝ ne epilepitiepipǝ, wǝ́ ŋ rè nǝ wǝmǝkpǝ kpǝlo kɩɩkɩ ŋ kolu Ejipǝte.<verse eid="GEN 46:7" /></para>
  <para style="s">Yakɔbǝ lǝ kǝkpǝŋkǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Isǝrayɛlǝ le epipǝ we pǝ pǝlǝ Ejipǝte la anyɩŋyǝ yǝ kaamǝ ǝyǝ ǝnǝ: Yakɔbǝ, ne epipǝ mǝ ne epilepipǝ.</para>
  <para style="p" vid="GEN 46:8">Yakɔbǝ le pisǝŋmǝyǝ ŋ kaamǝ Rubɛnǝ. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />Rubɛnǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Hanɔkǝ, Palu, Ɛsǝrɔŋ, Karǝmi.<verse eid="GEN 46:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="GEN 46:10" />Simewɔŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Yemwɛlǝ, Yaminǝ, Ohadǝ, Yakinǝ, Sowarǝ, Sawulǝ ŋ ke ri Kanaŋtǝtieyǝ we le piyǝ.<verse eid="GEN 46:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="GEN 46:11" />Levi lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Gɛrǝsɔŋ, Kehatǝ mǝ Merari.<verse eid="GEN 46:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="GEN 46:12" />Yuda lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Ɛrǝ, Onanǝ, Sela, Perɛsɩ mǝ Zera. Paa Ɛrǝ mǝ Onanǝ pǝ kpǝ̀ rǝ Kanaŋ lǝ gǝŋrǝ. Perɛsɩ lǝ ǝpǝrǝŋpipǝ pǝ ka kàamǝ Ɛsǝrɔŋ mǝ Amulǝ.<verse eid="GEN 46:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="GEN 46:13" />Isaka lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Tola, Puva, Yɔvǝ, Simǝronǝ.<verse eid="GEN 46:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="GEN 46:14" />Zabulɔŋ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Serɛdǝ, Elɔŋ, Yaleyɛlǝ.<verse eid="GEN 46:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="GEN 46:15" />Leya lǝ ǝpǝrǝŋpipǝ ŋ mǝnǝ ŋ kòonu Yakɔbǝ rǝ Aramǝ lǝ kǝtǝǝtapɩtapɩwǝ wǝǝ, fǝ kʊla mǝ na kɔrʊ Dina. Nǝ ǝpǝrǝŋpipǝ mǝ ne etiepipǝ pǝlo kpǝlo kɩɩkɩ pǝ kǝ lǝ̀ tǝta mǝ enyi ata. <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />Gadǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Sefɔŋ, Agi, Suni, Esǝbɔŋ, Eri, Arodi mǝ Areli.<verse eid="GEN 46:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="GEN 46:17" />Asɛrǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Yimǝna, Yisǝva, Yisǝvi, Beriya mǝ pǝla paatɛ Sera. Beriya kǝ lǝ̀ǝmǝ ǝpǝrǝŋpipǝ eyi, Ebɛrǝ mǝ Malǝkiɛl.<verse eid="GEN 46:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="GEN 46:18" />Zilǝpa lǝ ǝpǝrǝŋpipǝ we ŋ mǝnǝ ŋ kòonu Yakɔbǝ wǝǝ, pǝlo kpǝlo kɩɩkɩ pǝ lǝ enyipǝ tǝ mǝ akʊraŋ. Labaŋ ŋ fǝ̀ Zilǝpa ŋ kòonu na kɔrʊ Leya ŋ ri na sʊmatǝtieyǝ.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Yakɔbǝ le tie Rasiɛlǝ mǝnǝ ǝpǝrǝŋpipǝ eyi kòonu Yakɔbǝ, ŋpǝ pǝ kaamǝ: Yosɛfʊ mǝ Bɛnǝyaminǝ. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Asǝnatǝ mǝnǝ ǝpǝrǝŋpipǝ eyi kòonu Yosɛfʊ rǝ Ejipǝte lǝ gǝŋrǝ: Manase mǝ Efǝrayimǝ. Toolutǝyǝ we pǝ lóo pwo Potifera rǝ Onǝ lǝ tǝŋtǝǝwǝ la kɔrʊ ŋ kaamǝ Asǝnatǝ. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />Bɛnǝyaminǝ lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Bela, Bekɛrǝ, Asebɛlǝ, Gera, Namaŋ, Ehi, Rɔsǝ, Mupimǝ, Hupimǝ mǝ Arǝde. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />Rasiɛlǝ lǝ ǝpǝrǝŋpipǝ ŋ mǝnǝ ŋ kòonu Yakɔbǝ wǝǝ, pǝlo kpǝlo kɩɩkɩ pǝ kǝ lǝ tǝ mǝ enyi eniǝ.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />Danǝ lǝ bǝrǝŋpirǝ gaamǝ Usimǝ. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />Nɛfǝtali lǝ ǝpǝrǝŋpipǝ pǝ kaamǝ: Yasiɛlǝ, Guni, Yesɛrǝ mǝ Silɛmǝ.<verse eid="GEN 46:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="GEN 46:25" />Bila lǝ ǝpǝrǝŋpipǝ we ŋ mǝnǝ ŋ kòonu Yakɔbǝ wǝǝ, pǝlo kpǝlo kɩɩkɩ pǝ lǝ enyi apǝrɩmata. Labaŋ ŋ fǝ̀ Bila ŋ kòonu na kɔrʊ Rasiɛlǝ ŋ ri na sʊmatǝtieyǝ. <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />Yakɔbǝ la anyarǝtǝpǝ, ŋwǝŋwǝ na nʊnɔmɛŋwǝ lǝ wǝmǝkpǝ wǝ rù wǝ kolu Ejipǝte pǝ kʊ̀la mǝ ŋwǝ we, pǝlo kpǝlo kɩɩkɩ pǝ kǝ lǝ enyipǝ tǝkʊraŋ mǝ akʊraŋ. Ne epiletiepǝ pǝ laa kʊla. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Yakɔbǝ lǝ kǝkpǝŋkǝ we kǝ kolu kǝ tini rǝ Ejipǝte fǝ kʊla mǝ Yosɛfʊ lǝ ǝpǝrǝŋpipǝ we eyipǝ pǝ mǝnǝ rǝ Ejipǝte pǝ kòonu ŋwǝ we, pǝlo kpǝlo kɩɩkɩ pǝ kǝ lǝ enyipǝ tǝpǝrɩmata.<verse eid="GEN 46:27" /></para>
  <para style="s">Yakɔbǝ mǝ nǝ kǝkpǝŋkǝ pǝ le ke fii Ejipǝte</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Wǝ́ Yakɔbǝ ŋ kpìi Yuda ŋ conu ŋ ko Yosɛfʊ lǝ kpǝŋ, kǝ Yuda ŋ nya fɛɛ ŋ coŋ mǝ ŋwǝ ŋ po tuu pǝ rǝ Gosɛnǝ. Kǝ́ Yakɔbǝ mǝ nǝ kǝkpǝŋkǝ pǝ le pe fii Gosɛnǝ lǝ kǝtǝǝwǝ we, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />wǝ́ Yosɛfʊ ŋ kpàka na gɔŋtǝŋwaarǝ, wǝ́ ŋ fìi rǝ ŋ kǝ ŋ pǝ ŋ po ku mǝ nǝ tǝ Isǝrayɛlǝ rǝ Gosɛnǝ. Kǝ́ ŋ na nya ŋ no ko ru rǝ nǝ tǝ eni we, wǝ Yosɛfʊ ŋ kolu ŋ pùru nǝ tǝ rǝ dǝreerǝ. Wǝ́ ŋ yà ŋ ke ŋ wee, la pala ŋwǝ re. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />Wǝ́ Isǝrayɛlǝ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋ́ nǝ tǝ ŋ́ na nya lá anyɩŋkǝ ŋ́ na nyɩŋ! Rǝkǝsa we, ŋ́ nóo koru ǝkpǝ́ duturǝ ɖi ǝ tǝ e kpii vɔrʊrǝ.» <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />Wǝ́ Yosɛfʊ ŋ tìi na apaanʊpǝ we mǝ nǝ tǝ la anyarǝtǝnyituturupǝ ǝkǝnǝŋ: «Ŋ́ nóo ko ŋ́ ke tíi Farawo ǝkǝnǝŋ mǝ apaanʊpǝ mǝ mǝ tǝ la anyarǝtǝpǝ kpǝlo kɩɩkɩ pǝ ke kpii rǝ Kanaŋ lǝ gǝŋrǝ we, pǝ le pe fii mǝ kpǝŋ. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Ŋ́ neh ke tíi ŋwǝ ǝkǝnǝŋ nǝ nyǝ́ǝ rǝŋ amɛɛpǝ mǝ epereceepǝ, wǝ́ nǝ nyóo co akɛɛpǝ. Wǝ́ nǝ nyée re nǝ amɛɛpǝ, ne epereceepǝ, mǝ nǝ anɛŋpǝ mǝŋ nǝ otulǝmǝyǝ kpǝlo kɩɩkɩ nǝ nyǝ pǝ. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Mǝŋ Farawo le kpii pǝ lo po pwo nǝ, wǝ́ ŋ nǝ pǝ́ nǝ kǝnǝnɛkǝ nǝ nyée yee we, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />nǝ tíi ŋwǝ ǝkǝnǝŋ: “Ŋlǝ lá asʊmatǝpǝ yǝ lóo co akɛɛpǝ ǝrǝ lah kǝlaatiekǝ po ro eniyǝ sa, mǝŋ kǝ́ lǝh ǝtǝtǝpǝ pǝ ke ŋ yee wǝ kǝtǝ. Mǝŋkǝsa we, nǝ nyóo koru e ke tii rǝ Gosɛnǝ la gaarǝ we. Duturǝ ɖi Ejipǝtetǝpǝ pǝ lǝŋ taa epǝ we pǝ lǝ́ǝ rǝŋ amɛɛpǝ mǝ epereceepǝ lǝ kǝǝwǝ kʊrakʊra.”»<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">Yosɛfʊ lo ko Farawo lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Yosɛfʊ kolu nyɩnɩ Farawo wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ tǝ mǝ mǝ apaanʊpǝ pǝ lo ru rǝ Kanaŋ pǝ lǝ pǝ. Pǝ le re pǝla amɛɛpǝ mǝ pǝle epereceepǝ fǝ kʊla mǝ pǝla anɛŋpǝ mǝ pǝlo otulǝmǝyǝ kpǝlo, wǝ́ pǝ kpii rǝ Gosɛnǝ la gaarǝ.» <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Wǝ́ Yosɛfʊ ŋ fǝ̀ na apaanʊpǝ atʊʊ ŋ kolu ŋ pɔ̀rʊ ŋ kanǝ Farawo. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />Wǝ́ Farawo ŋ pǝ̀ Yosɛfʊ la apaanʊpǝ we ǝkǝnǝŋ: «Anǝnɛyǝ rǝ fǝŋ wǝ́ nǝ nyée yee?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ lá asʊmatǝpǝ yǝ lǝ́ǝ rǝŋ amɛɛpǝ mǝ epereceepǝ, mǝŋ kǝ́ lǝh ǝtǝtǝpǝ pǝ ke ŋ yee wǝ kǝtǝ.» <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Wǝ́ pǝ tǝ pǝ tìi Farawo ǝkǝnǝŋ: «Yǝ lǝ pǝ le pe ce le tii rǝ gǝŋrǝ sa duturǝ ɖi kǝtɛŋkǝ kǝ le fii ŋpa rǝ Kanaŋ lǝ gǝŋrǝ. Wǝ́ bɔɔrǝ lǝǝ tǝ gbii lah amɛɛpǝ mǝ leh epereceepǝ pǝ loh wo. Kǝto dɔɔkpɛ pɔrʊ gʊŋrǝ o koonu lǝ le ke tii rǝ Gosɛnǝ la gaarǝ.» <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />Wǝ́ Farawo ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Lǝ́ tǝ mǝ lá apaanʊpǝ pǝ lo po tuu lǝ́. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />Ejipǝte lǝ ǝkǝtǝǝyǝ kpǝlo yǝ kpɛlɩ rǝ lá kǝnyɩŋkǝ yǝ lóo ko ǝnǝ. Taa kǝtǝǝceeceewǝ o koonu pǝ pǝ tii. Pǝ lóo koru e ke tii rǝ Gosɛnǝ la gaarǝ. Mǝŋ a la nyɩŋ enyipǝ rɛ pǝ lée yee wɛɛlɛŋwǝ rǝ pǝlǝ mǝrǝ we, kǝ ǝ fǝ mǝ akɛɛpǝ o koonu pǝ pǝ ŋ yɩrɩ yurǝ.» <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />Wǝ́ Yosɛfʊ ŋ fǝ̀ nǝ tǝ Yakɔbǝ ŋ kolu ŋ pɔ̀rʊ ŋ kanǝ Farawo. Wǝ́ Yakɔbǝ ŋ kolu ŋ cèeni ŋwǝ. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Wǝ́ Farawo ŋ pǝ̀ Yakɔbǝ ǝkǝnǝŋ: «Cɛŋ paka wǝ́ ǝ lǝǝmǝ?» <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />Wǝ́ Yakɔbǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Cɛŋ tuuru mǝ tǝtatǝwǝ wǝǝ kǝ́ ŋ́ ya ŋ́ née siri mǝ ŋ tɛlɩ rǝ ǝkǝŋyǝ. Mǝ acɛŋyǝ yǝ laa naanǝ, wǝ́ ŋ́ na lɛ ŋ́ na cʊʊrʊ ŋpa. Mǝ ǝtǝtǝpǝ ŋpǝ ŋkpɛ pǝ ke ŋ siri pǝ ŋ tɛlɩ rǝ ǝkǝŋyǝ mǝŋkǝsa paape mǝ acɛŋyǝ yǝ lee ce yǝ ro pǝla anɛŋyǝ.» <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Wǝ́ Yakɔbǝ ŋ tǝ ŋ cèeni Farawo, wǝ́ ŋ pwɛ̀yɩ rǝ nǝ kpǝŋ ŋ ko ŋ ko. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />Wǝ́ Yosɛfʊ ŋ tìini nǝ tǝ mǝ na apaanʊpǝ. Wǝ́ ŋ kòonu pǝ lǝ ǝkǝtǝǝyǝ rǝ Ejipǝte lǝ gǝŋrǝ we. Ǝkǝtǝǝceeceeyǝ we yǝ kpii rǝ Ramǝsɛsǝ la gaarǝ wǝ, mǝŋ kǝ́ Farawo ŋ tìi ŋwǝ kǝtǝ. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Wǝ́ Yosɛfʊ ŋ ko ŋ koonu pǝ le keeriwǝ eni ri ŋ ni mǝ ŋ kaa mǝ pǝle epipǝ lǝ wǝkǝkpǝ. Ko ŋ koonu nǝ tǝ, na apaanʊpǝ mǝ nǝ tǝ la nyarǝwǝ kpǝlo le enyipǝ.<verse eid="GEN 47:12" /></para>
  <para style="s">Kǝtɛŋkǝ kǝ le fii rǝ Ejipǝte</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Kǝtɛŋkǝ sa kǝ ka naanǝ ŋpa, kǝto keeriwǝ wǝ lǝǝ kǝ tǝ wǝ kpii rǝ gǝŋrǝ we kpǝlo kɩɩkɩ. Ejipǝtetǝpǝ mǝ Akanaŋtǝpǝ pǝ sǝ̀, pǝ lǝǝ kǝ tǝ pǝ lǝmǝ okopiyǝ rǝ kǝtɛŋkǝ we kǝto. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Wǝ́ Yosɛfʊ ŋ ke ŋ siiri bǝleyǝ mǝ ŋ koonu Ejipǝtetǝpǝ mǝ Akanaŋtǝpǝ, wǝ́ ŋ lɔ̀ pǝla sɩkayǝ kpǝlo kɩɩkɩ. Wǝ́ ŋ fǝ̀ sɩkayǝ sa ŋ kolu ŋ tǝnǝ rǝ Farawo la nyarǝwǝ. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Kǝ́ sɩkayǝ ŋ na lɛ̀ rǝ Ejipǝte lǝ gǝŋrǝ mǝ Kanaŋ gǝŋrǝ we, wǝ́ Ejipǝtetǝpǝ kpǝlo pǝ pǝlǝ pǝ tìi Yosɛfʊ ǝkǝnǝŋ: «Koonu lǝ keeriwǝ le ri. Amaa kǝ́ yǝ lǝǝ tǝ lǝ lǝmǝ sɩkayǝ yǝ loh fuu keeriwǝ kǝto a láa yaa a mǝ yɩrɩ lǝ kǝ lǝ kpǝ́?» <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />Wǝ́ Yosɛfʊ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ nǝ nyǝǝ tǝ nǝ lǝmǝ sɩkayǝ we, nǝ fǝ nǝ akɛɛpǝ nǝ pa cɛkɛlɛ mǝ keeriwǝ rǝ mǝ kpǝŋ.» <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Wǝ́ pǝ kolu pǝ fǝ̀ pǝla akɛɛpǝ pǝlǝ pǝ kòonu Yosɛfʊ, wǝ́ ŋ kòonu pǝle keeriwǝ rǝ pǝlo oroopǝ, amɛɛpǝ, epereceepǝ, anɛŋpǝ mǝ orookɛtɛpǝ lo yuwǝ. Cɛŋwǝ we lǝ mǝrǝ we, pǝ fǝ̀ pǝla akɛɛpǝ kpǝlo pǝ pǝlǝ pǝ cɛ̀kɛlɛ mǝ keeriwǝ rǝ Yosɛfʊ lǝ kpǝŋ. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />Kǝ́ cɛŋwǝ wǝ la lɛ we, wǝ́ pǝ tǝ pǝ sìɛnɩ pǝ pǝlǝ pǝ tìi Yosɛfʊ mǝ cɛŋyitǝwǝ we ǝkǝnǝŋ: «Kulǝtǝ kǝŋyɩrɩtǝyǝ, yǝ lǝŋ koru lǝ́ ǝtǝǝnǝ. Yǝ lǝǝ tǝ lǝ lǝmǝ sɩkayǝ, wǝ́ lah akɛɛpǝ ke pǝ la marǝ asiɛrɩ pǝ le yee lá anɛŋ. Tǝrɛ wǝ lǝǝ tǝ wǝ kpɛɛ lǝ wǝ teeri ŋlǝŋlǝ lah wɛ mǝ lǝh ǝkǝtǝǝyǝ. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Amaa a láa yaa a mǝ yɩrɩ lǝ kǝ lǝ kpǝ́ kǝ lǝh ǝkǝtǝǝyǝ yǝ co? Fuu ŋlǝ mǝ lǝh ǝkǝtǝǝyǝ e kpii keeriwǝ lo yuwǝ, kǝ la siɛrɩ le yee Farawo la arɔŋpǝ, kǝ lǝh ǝkǝtǝǝyǝ yǝ yee Farawo la anɛŋ. Koonu lǝ oturʊʊyǝ la rʊʊ, kǝ la nya fɛɛ le tii vɔrʊrǝ, kǝ lǝ pǝǝ kpǝ́. Eniyǝ we lǝh ǝkǝtǝǝyǝ yǝ lǝŋ kpɛɛ akpaakpaa.» <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />Wǝ́ Yosɛfʊ ŋ fùu Ejipǝte lǝ ǝkǝtǝǝyǝ kpǝlo ŋ kòonu Farawo. Kǝtɛŋkǝ we kǝ ka naanǝ ŋpa, tuwǝ kǝto Ejipǝtetǝpǝ nyi ri ŋ nyi ŋ ke ŋ siiri na wǝtɛɛkpǝ wǝǝ. Wǝ́ gǝŋrǝ we kpǝlo zìɛrɩ yeli Farawo la nɛŋ. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Wǝ́ Yosɛfʊ ŋ fǝ̀ gǝŋrǝ we kpǝlo le enyipǝ ŋ yeli arɔŋpǝ, fǝ rǝ Ejipǝte le nyiŋwǝ ǝrǝ kuruwǝ. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Paa Yosɛfʊ loo fuu otoolutǝpǝ lǝ ǝkǝtǝǝyǝ duturǝ ɖi Farawo pɔ̀rʊ seyǝ rɛ rù ŋ ko ŋ toŋ pǝ. Wǝ́ Farawo ŋ lɛ̀ ŋ ko ŋ koonu pǝ le keeriwǝ pǝ ŋ ri. Wǝ kǝto ŋpǝ paa pǝ loo koru e siiri pǝlǝ ǝkǝtǝǝyǝ wǝǝ. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />Wǝ́ Yosɛfʊ ŋ tìi kǝkpǝŋkǝ we ǝkǝnǝŋ: «Nǝ yɩrɩ re, ruŋruŋ le jirǝ, ŋ́ no fuu ŋnǝ mǝ nǝ ǝkǝtǝǝyǝ ŋ́ no koonu Farawo. Ŋ́ nóo koonu nǝ oturʊʊyǝ nǝ rʊʊ rǝ nǝ wǝtɛɛkpǝ. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Vǝ́ nǝ nyée pe ce otuyǝ sa nǝ nyah rʊʊ we, nǝ sǝpǝ yǝ fɛɛwǝ kpee tʊʊ, kǝ nǝ fǝ kpee ceŋceŋ nǝ po koonu Farawo. Kpeeniǝwǝ we wǝ loh tuuru we, wǝ ri nǝ nɛŋ. Wǝlǝ mǝrǝ wǝ nǝ nyah pɔrʊ nǝ ka rʊʊ, kǝ nǝ lɛ nǝ ri ŋnǝ mǝ nǝ epipǝ mǝ epǝ we pǝ ri nǝ anyarǝtǝpǝ wǝ.» <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />Wǝ́ kǝkpǝŋkǝ we kǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, a la pɔrʊ lah vɔrʊrǝ fee. Kǝ́ wǝ ri a ya láa nyɩŋ lǝ tǝlarǝwǝ kǝto we, yǝ lée ri Farawo la arɔŋpǝ.» <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />Wǝ́ Yosɛfʊ ŋ fǝ̀ dierǝ sa ŋ tɛnɩ ŋ yeli seyǝ, wǝ́ pǝ ya pǝ láa saŋ rǝ ŋwǝ po ro ruŋruŋ le jirǝ rǝ Ejipǝte lǝ gǝŋrǝ we kpǝlo. Rǝ Ejipǝte lǝ gǝŋrǝ we, vǝ́ pǝ le ce pǝle ekeeriyǝ we, pǝ lǝ́ǝ sǝpǝ yǝ fɛɛwǝ kpee tʊʊ, o turu pǝ lǝ fǝ kpee ceŋceŋ pǝ lo ko koonu Farawo. Otoolutǝpǝ lǝ ǝkǝtǝǝyǝ ko yǝ lee ri Farawo la anɛŋ wǝ.<verse eid="GEN 47:26" /></para>
  <para style="s">Yakɔbǝ lǝ pǝ́ tututuruwǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Isǝrayɛlǝ mǝ ne epipǝ pǝ nyà kǝtiikǝ rǝ Ejipǝte lǝ gǝŋrǝ rǝ Gosɛnǝ la gaarǝ. Wǝ́ pǝ pǝlǝ pǝ yeli ǝkǝtǝǝlǝtǝpǝ. Wǝ́ pǝ lɛ pǝ mǝnǝ epipǝ, wǝ́ pǝ pǝlǝ pǝ yàarǝ ŋpa. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />Yakɔbǝ yeli cɛŋ tǝ mǝ pǝrɩmata rǝ Ejipǝte lǝ gǝŋrǝ. Yakɔbǝ la acɛŋyǝ kpǝlo kɩɩkɩ yǝ kǝ lǝ tuuru mǝ tǝniǝ mǝ pǝrɩmata. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Kǝ́ Isǝrayɛlǝ le jikpǝ́rǝ lah ta ɖo we, wǝ́ ŋ pwò ne pi Yosɛfʊ ŋ tìi ǝkǝnǝŋ: «Dɔɔkpɛ, mǝŋ a láa taa mǝ kǝǝwǝ we, pɔrʊ lǝ kǝǝtaawǝ mǝ lá anʊkɔrǝyǝ a kaŋ kǝ e kpii lá akaakǝ rǝ mǝ gbaakpaarǝ lǝ kǝnǝŋkǝ kǝ o tu e tíi mǝ ǝkǝnǝŋ ŋlǝ́ a lǝŋ pa ŋwaa mǝ rǝ Ejipǝte. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Vǝ́ ŋ́ nǝ kpǝ́ we, fǝ mǝ a pwɛyɩ rǝ Ejipǝte a ka ŋwaa rǝ lǝh ǝtǝtǝpǝ lo wǝfuŋkpǝ oo.» Wǝ́ Yosɛfʊ ŋ tìi ŋwǝ ǝkǝnǝŋ ŋ née yee tuwǝ sa ŋ ne tíi ŋwǝ wǝ. <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />Wǝ́ Isǝrayɛlǝ ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tu e tíi mǝ». Wǝ́ Yosɛfʊ ŋ tù ŋ tìi ŋwǝ. Wǝ́ Isǝrayɛlǝ ŋ pɛ̀ɛlɩ yurǝ rɛyɩɩ rǝ na fɛɛkpɛɛwǝ lo oyutǝyǝ.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">Yakɔbǝ la pɛɛrɩ Yosɛfʊ le epipǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Rǝ otuyǝ sa la kǝmaakǝ we, wǝ́ pǝ pǝlǝ pǝ tìi Yosɛfʊ ǝkǝnǝŋ nǝ tǝ ya lǝ́ǝ fǝrǝ oo. Wǝ́ Yosɛfʊ ŋ fǝ̀ nǝ ǝpǝrǝŋpipǝ we eyipǝ, Manase mǝ Efǝrayimǝ ŋ rè wǝ́ ŋ ko ŋ ko ŋ ka yɩrɩ ŋwǝ. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Kǝ́ pǝ le ke tìi Isǝrayɛlǝ ǝkǝnǝŋ «A lǝŋ nyɩŋ, lé pi Yosɛfʊ lǝ pǝ ŋ pa yɩrɩ lǝ́» we, wǝ́ ŋ nyɩ̀ɩ ŋ yili ŋ tini rǝ na fɛɛkpɛɛwǝ. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />Wǝ́ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Worokokopilǝtǝyǝ pɔ̀rʊ na wɛ kanǝ mǝ rǝ Lusǝ rǝ Kanaŋ lǝ gǝŋrǝ, wǝ́ ŋ pɛ̀ɛrɩ mǝ. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Tɛnɩ ǝkǝnǝŋ: “Ŋ́ nóo koonu kǝ ǝ mǝ epipǝ ŋpa, kǝ pǝ yaarǝ ŋpa, kǝ ŋ́ fǝ lǝ́ ŋ́ yee wǝkpǝŋmumuŋkpǝ rɛ lǝ tǝtǝtǝtǝyǝ. Ŋ́ nǝ́ǝ fǝ gǝŋrǝ sa ŋ́ koonu lǝ́ wǝmǝkpǝ kǝ ziɛrɩ yee pǝla nɛŋ kǝkpakǝkpa.” <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />Rǝkǝsa we, ǝpǝrǝŋpipǝ sa eyipǝ ǝ lǝ mǝ rǝ Ejipǝte kpɛŋ wǝ́ ŋ́ ne ci o po tuu lǝ́ we, pǝ lée ri mǝ anɛŋ. Efǝrayimǝ mǝ Manase pǝ ri mǝ anɛŋ mǝŋ Rubɛnǝ mǝ Simewɔŋ kǝtǝ. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Paa epituturupǝ we ǝ lǝh pǝ mǝ a tɛɛ mǝ pǝ we, pǝ lée ri lá anɛŋ. Paa pǝ lǝ́ǝ kǝ pǝ pǝ kʊla mǝ epǝ we pǝ leh pe ri Efǝrayimǝ mǝ Manase lǝ ǝtǝtuyǝ. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Ŋmǝ paa we, kǝ́ ŋ́ rù rǝ Mezopotami ŋ́ kǝ ŋ pǝ we, kpɛŋ kǝ ŋ́ ci e pe fii tǝŋtǝǝwǝ we pǝ lóo pwo Efǝrata we, rǝ Kanaŋ lǝ gǝŋrǝ we, wǝ́ lé lee Rasiɛlǝ ŋ kpǝ̀ rǝ mǝ akaakǝ rǝ gʊŋrǝ we. Wǝ́ ŋ́ ŋwàa ŋwǝ rǝ gʊŋrǝ we la kǝlɛɛrɩkǝ.» Efǝrata wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Bɛtǝlɛhɛmǝ. <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />Kǝ́ Yakɔbǝ ŋ na pa nyɩŋ Yosɛfʊ lǝ ǝpǝrǝŋpipǝ we we, wǝ́ ŋ pǝ̀ Yosɛfʊ ǝkǝnǝŋ: «Ǝpǝ rǝ fǝŋ pǝ lǝmǝ ǝpǝ?» <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />Wǝ́ Yosɛfʊ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ tǝ, epipǝ we Worokoyǝ ŋ no koonu mǝ rǝ gǝŋrǝ sa pǝ lǝǝwe.» Wǝ́ nǝ tǝ ŋ tǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ, ruu pǝ ǝ kǝlǝ mǝ mǝ kǝ ŋ́ pɛɛrɩ pǝ.» <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />Anyɩŋ Isǝrayɛlǝ lo kuru, wǝ́ ne enimiyǝ yǝ yeli ŋwǝ kpǝŋ, kǝto lǝǝ tǝ ka ŋ nyɩŋ sɩsiɛrɩ. Wǝ́ Yosɛfʊ ŋ rùu pǝ ŋ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ Isǝrayɛlǝ ŋ pùru pǝ ŋ rè. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Wǝ́ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ao, ŋ́ naa tɛɛ kpɛɛ ǝkǝnǝŋ ŋ́ nǝh pǝ tǝ ŋ́ nyɩŋ lǝ́, paape Worokoyǝ rǝkǝsa lo koonu wǝ́ ŋ́ na nyɩŋ mǝŋ lé epipǝ.» <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />Wǝ́ Yosɛfʊ ŋ tà epipǝ we ŋ cɛ̀ rǝ nǝ tǝ la akpaakpaayǝ lǝ kpǝŋ. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ ŋ tɔ̀ kǝtukǝ rǝ kǝtǝǝwǝ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Wǝ́ Yosɛfʊ ŋ tà ne epipǝ we eyipǝ mǝ akaakǝ, Efǝrayimǝ mǝ kǝnirikǝ, wǝ lo ko rǝ Isǝrayɛlǝ la kǝpɛŋkǝ. Manase mǝ kǝpɛŋkǝ, wǝ lo ko rǝ Isǝrayɛlǝ le kǝnirikǝ. Wǝ́ ŋ rùu pǝ ŋ kǝ̀lǝ mǝ pǝlǝ tǝtǝ. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Wǝ́ Isǝrayɛlǝ ŋ kpɛ̀tɛ onuyǝ. Wǝ́ ŋ kòonu yǝ, wǝ́ ŋ fǝ̀ kǝnirikǝ ŋ tɛ̀ɛ Efǝrayimǝ rǝ yurǝ, paa ŋwǝ ŋ ke ri pipiyǝ wǝ. Wǝ́ ŋ fǝ̀ kǝpɛŋkǝ ŋ tɛ̀ɛ Manase rǝ yurǝ, paa ŋwǝ ŋ ke ri mumuŋyǝ wǝ. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />Wǝ́ ŋ pɛ̀ɛrɩ Yosɛfʊ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 48:15">«Worokoyǝ we le enimiyǝ mǝ tǝ Isakǝ mǝ mǝ tǝtǝ Abǝrahamǝ pǝ le tii vɔrʊrǝ sɩsiɛrɩ wǝ́ pǝ la sʊma we,</para>
  <para style="q1" vid="GEN 48:15">Worokoyǝ we ŋ na yɩrɩ mǝ yurǝ ǝrǝ mǝ kǝpiŋwɛŋkǝ po ro ruŋruŋ le jirǝ we,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />Picoŋpiyǝ we ŋ na pɔrʊ mǝ rǝ oturɔɔrɔɔyǝ kpǝlo lǝ mǝrǝ we,</para>
  <para style="q1" vid="GEN 48:16">ŋ pɛɛrɩ epipǝ sa.</para>
  <para style="q1" vid="GEN 48:16">Saŋ rǝ epipǝ sa we,</para>
  <para style="q1" vid="GEN 48:16">Mǝ nyɩŋrǝ gbɛɛ kǝkpakǝkpa.</para>
  <para style="q1" vid="GEN 48:16">Pǝlǝ tǝtǝtǝtǝyǝ Abǝrahamǝ la nyɩŋrǝ gbɛɛ kǝkpakǝkpa.</para>
  <para style="q1" vid="GEN 48:16">Kǝ pǝlǝ tǝtǝ Isakǝ la nyɩŋrǝ gbɛɛ kǝkpakǝkpa.</para>
  <para style="q1" vid="GEN 48:16">Pǝlǝ wǝmǝkpǝ wǝ yaarǝ ŋpa</para>
  <para style="q1" vid="GEN 48:16">rǝ gǝŋrǝ sa kpǝlo.»<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Kǝ́ Yosɛfʊ ŋ na nyɩŋ ǝkǝnǝŋ nǝ tǝ lǝ fǝ kǝnirikǝ la tɛɛ rǝ Efǝrayimǝ lo yurǝ we, wǝ́ wǝ pǝ̀lǝ mǝ ŋwǝ. Wǝ́ ŋ tà nǝ tǝ la akaakǝ ŋ nyɩ̀ɩrɩ rǝ Efǝrayimǝ lo yurǝ ŋ ka tɛɛ rǝ Manase la nɛŋrǝ. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Wǝ́ ŋ tìi nǝ tǝ ǝkǝnǝŋ: «Ow, ŋkǝ kaa wǝǝ mǝ tǝ, yǝ ǝnǝ ŋ ri mumuŋyǝ. Fǝ lé kǝnirikǝ a tɛɛ rǝ no yurǝ bomu.» <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />Paape wǝ́ nǝ tǝ ŋ sǝnǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ cii wǝ, mǝ piyǝ, ŋ́ cii wǝ. Manase ŋwǝ ŋkpɛ nǝ wǝmǝkpǝ wǝ leh pe yee kǝkpǝŋmumuŋkǝ rɛ. Paape na paanʊ lée teeri ŋwǝ. Nǝ wǝmǝkpǝ wǝ leh pe yee wǝkpǝŋmumuŋkpǝ rɛ.»<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Jirǝ we we, Yakɔbǝ pɛ̀ɛrɩ epipǝ we tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 48:20">«Isǝrayɛlǝtǝpǝ pǝ lǝh mǝ fǝ nǝ anyɩŋyǝ pǝ ŋ pɛɛrɩ enyipǝ pǝ ŋ tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 48:20">“Worokoyǝ ŋ pɛɛrɩ lǝ́ mǝŋ Efǝrayimǝ mǝ Manase kǝtǝ”».</para>
  <para style="m" vid="GEN 48:20">Kǝ́ wǝ yeli wǝ́ Isǝrayɛlǝ ŋ fǝ̀ Efǝrayimǝ ŋ conu ŋ kòonu Manase wǝǝ. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />Wǝ́ Isǝrayɛlǝ ŋ tìi Yosɛfʊ ǝkǝnǝŋ: «Ŋ́ nǝh kpǝ́, paape Worokoyǝ lée tii ŋ kʊla mǝ nǝ, kǝ ŋ siɛnɩ mǝ nǝ ŋ ko nǝ ǝtǝtǝpǝ lǝ gǝŋrǝ. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Ŋmǝ paa we, Sikɛmǝ lǝ gǝŋrǝ we ŋ́ fǝ̀ tʊkʊwǝ mǝ kǝteŋteŋkǝ ŋ́ yeli akɔŋkǝ mǝ Amoritǝpǝ wǝ́ ŋ́ lɔ̀ we, ŋ́ nǝ fǝ rǝ ŋ́ no koonu lǝ́. Sikɛmǝ lǝ gǝŋrǝ sa wǝ́ ǝ lǝ́ǝ fǝ e teeri lá paanʊ peni.»<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">Yakɔbǝ la pɛɛrɩ nǝ ǝpǝrǝŋpipǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Yakɔbǝ pwò nǝ ǝpǝrǝŋpipǝ pǝlǝ wǝ́ ŋ tìi pǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="GEN 49:1">«Nǝ pa ca nǝ ku kǝ ŋ́ tìi nǝ,</para>
  <para style="q1" vid="GEN 49:1">tuwǝ we wǝ lǝh pǝ wǝ po tuu nǝ sooso wǝ.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />Yakɔbǝ le epipǝ, nǝ po ku kǝ nǝ co kǝtukoŋkǝ.</para>
  <para style="q1" vid="GEN 49:2">Nǝ co kǝtukoŋkǝ rǝ nǝ tǝ Isǝrayɛlǝ.<verse eid="GEN 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />Ŋlǝ́ Rubɛnǝ, ŋlǝ́ e ri mǝ pisǝŋmǝyǝ.</para>
  <para style="q1" vid="GEN 49:3">Mǝ kǝpǝrǝŋpikǝ le pisǝsǝŋyǝ mǝ eniyǝ we ŋ kǝ lǝ̀ǝmǝ okopiyǝ wǝ.</para>
  <para style="q1" vid="GEN 49:3">Pǝ lóo pu lǝ́ pǝ ŋ teeri lá apaanʊpǝ,</para>
  <para style="q1" vid="GEN 49:3">Wǝ́ a lɛ ǝ lǝǝmǝ okopiyǝ e teeri pǝ.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Ǝ lǝ mǝŋ kǝ́ kpanǝwǝ wǝ lǝ́ǝ lǝ wǝ ŋ yee alʊlʊyǝ kǝtǝ.</para>
  <para style="q1" vid="GEN 49:4">Paape kǝ́ a la rɛ lǝ́ tǝ la ɖaŋraŋrǝ a la ka kpɛɛ mǝ lǝ́ tǝ le tie,</para>
  <para style="q1" vid="GEN 49:4">wǝ́ a la cɩɩrɩ ɖaŋraŋrǝ sa ŋ́ kpɛlɩ kǝto we, ǝ lǝŋ tǝ e ri pisǝsǝŋyǝ.<verse eid="GEN 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />Simewɔŋ mǝ Levi pǝ ri apaanʊpǝ,</para>
  <para style="q1" vid="GEN 49:5">pǝ lée ri nyuŋkpǝ pǝ ŋ yee okopituyǝ.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Paape ŋ́ nǝŋ pa kʊla mǝ pǝlo nyuŋrikpǝ ŋ́ nyɩŋ,</para>
  <para style="q1" vid="GEN 49:6">ŋ́ nǝŋ pe tii ŋ́ kʊla mǝ pǝlo okukǝ. Duturǝ ɖi pǝ fǝ̀ kpɛɛmʊrʊwǝ,</para>
  <para style="q1" vid="GEN 49:6">wǝ́ pǝ wʊ̀ʊlʊ enyipǝ.</para>
  <para style="q1" vid="GEN 49:6">Rǝ pǝle biemurǝ we lǝ mǝrǝ we, pǝ nyàanǝ anɛŋnuŋyǝ rǝ acɩɩnɛyǝ.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Ŋ́ na fwɛɛrɩ pǝla kpɛɛmʊrʊwǝ we,</para>
  <para style="q1" vid="GEN 49:7">duturǝ ɖi wǝ ka lɛnyɩ kururu.</para>
  <para style="q1" vid="GEN 49:7">Pǝla lɛkuunaawǝ we,</para>
  <para style="q1" vid="GEN 49:7">duturǝ ɖi wǝ kǝ pǝlǝ kururu.</para>
  <para style="q1" vid="GEN 49:7">Ŋ́ nǝ́ǝ sǝpǝ pǝ ŋ́ kpii rǝ Isǝrayɛlǝ lǝ gǝŋrǝ,</para>
  <para style="q1" vid="GEN 49:7">kǝ ŋ́ caŋ pǝ ŋ kpii rǝ gǝŋrǝ we kpǝlo.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />O Yuda, lá apaanʊpǝ pǝ lah pa nɔŋ pǝ kǝ lǝ́!</para>
  <para style="q1" vid="GEN 49:8">E lée ri ǝkǝǝkpǝlǝtǝpǝ lo yurǝ.</para>
  <para style="q1" vid="GEN 49:8">Kǝ lǝ́ tǝ lǝ ǝpǝrǝŋpipǝ pǝ pa pɛɛlɩ pǝ koonu lǝ́. <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />O mǝ pi Yuda, ǝ lǝ rǝ mǝŋ kɛɛlɔyǝ le biirǝ</para>
  <para style="q1" vid="GEN 49:9">la ka wʊ kɛɛyǝ lo wo lǝ́ǝ pǝ rǝla fɛɛkpɛɛwǝ wǝ!</para>
  <para style="q1" vid="GEN 49:9">Wǝ́ la pa sʊʊ la kpɛɛ</para>
  <para style="q1" vid="GEN 49:9">mǝŋ kǝ́ kɛɛlɔyǝ ŋ née yee kǝtǝ.</para>
  <para style="q1" vid="GEN 49:9">Mǝŋ kɛɛlɔyeeyǝ kǝtǝ wǝǝ, ǝlǝ ŋ nóo koru ŋwǝ le eyiili?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Wǝpilikpǝ wǝ lǝŋ pa pwɛyɩ rǝ Yuda la nyarǝwǝ,</para>
  <para style="q1" vid="GEN 49:10">piliciiwǝ wǝ lée kpii rǝ nǝ wǝmǝkpǝ la akaakǝ</para>
  <para style="q1" vid="GEN 49:10">ko ro eniyǝ we tulǝtǝpoŋpiyǝ ŋ nǝ́ǝ pǝ wǝ.</para>
  <para style="q1" vid="GEN 49:10">Yǝ we enyipǝ kpǝlo pǝ loh po co kǝtukoŋkǝ wǝ. <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />Láa kɔŋ no rookɛtɛyǝ rǝ rɛzɛŋkolurǝ ŋrǝŋrǝ, kǝ ŋ kɔŋ no rookɛtɛpirǝ rǝ rɛzɛŋkolurǝ we la laŋceeceewǝ.</para>
  <para style="q1" vid="GEN 49:11">Lǝ́ǝ fǝ vɛŋyǝ ŋ wɛɛ na kǝkpakǝ,</para>
  <para style="q1" vid="GEN 49:11">kǝ ŋ fǝ rɛzɛŋyǝ la mɛŋwǝ ŋ wɛɛ na kǝkpakpurumukǝ.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Lóo ŋuŋ vɛŋyǝ, kǝ ne enimiyǝ yǝ mwɛɛrɩ kpaŋkpaŋ, kǝ ŋ lɛ ŋ ŋuŋ akɔɔrʊnyɩŋpǝ kǝ no oroŋyǝ yǝ kpɛɛlɩ fuu.<verse eid="GEN 49:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 49:13" />Zabulɔŋ leh ke tii rǝ apʊyǝ la kǝlɛɛrɩkǝ,</para>
  <para style="q1" vid="GEN 49:13">fɛɛwǝ we akpanǝŋwaayǝ yǝ lǝ́ǝ pǝ yǝ ŋ yaa wǝ.</para>
  <para style="q1" vid="GEN 49:13">Nǝ kǝtǝǝwǝ wǝ láa yɔkɔ wǝ ke fii ǝrǝ Zidɔŋ.<verse eid="GEN 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />Isaka lǝ mǝŋ rookɛtɛlɛnyɩyǝ rɛ kǝtǝ.</para>
  <para style="q1" vid="GEN 49:14">Wǝ́ ŋ kpɛlɩ rǝ kɩlɩkpayǝ le kǝtiitiikǝ.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Wǝ́ ŋ na nyɩŋ ǝkǝnǝŋ na fɛɛwǝ we ŋ kpɛlɩ wǝ ponu,</para>
  <para style="q1" vid="GEN 49:15">wǝ́ gǝŋrǝ we lɛ bonu.</para>
  <para style="q1" vid="GEN 49:15">Wǝ́ ŋ na tɛɛnɩ ŋ na pɛɛlɩ no goŋkoŋrǝ ŋ re eleeyǝ,</para>
  <para style="q1" vid="GEN 49:15">wǝ́ ŋ nǝ fǝ na wɛ ŋ ne yee rɔŋyǝ ŋ née re eleeyǝ.<verse eid="GEN 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />Daŋ lah pa tɛŋ wǝkpaŋkpǝ mǝ nǝ kǝkpǝŋkǝ mǝŋ Isǝrayɛlǝ lǝ wǝkpǝŋtuturukpǝ.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Daŋ lo ru kǝpɔɔkǝ kǝ kpɛlɩ rǝ gʊŋrǝ wǝ.</para>
  <para style="q1" vid="GEN 49:17">Lo ru matakpayǝ rɛ ŋ kpɛlɩ rǝ gʊŋrǝ.</para>
  <para style="q1" vid="GEN 49:17">Kǝ́ rootɛɛtǝyǝ ŋ nah tɛlɩ mǝ no rooyǝ we, wǝ́ matakpayǝ we ŋ ne sie rooyǝ we rǝ cɩɩnɛwǝ.</para>
  <para style="q1" vid="GEN 49:17">Wǝ́ rootɛɛtǝyǝ we ŋ nǝ kpǝlǝŋ ŋ na ka tɔɔ.<verse eid="GEN 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />O Ǝtǝ Woroko, ŋ́ ya ŋ́ nǝ́ǝ rǝŋ lǝ́ a pa pɔrʊ mǝ!<verse eid="GEN 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />Gadǝ we, ayɩlayɩtǝpǝ lǝ kpǝŋwǝ wǝ le yi wǝ la tɛɛ rǝ ŋwǝ.</para>
  <para style="q1" vid="GEN 49:19">Paape ŋwǝ ŋ neh pe yi ŋ tɛɛ rǝ pǝ kǝ ŋ piri pǝ wǝ.<verse eid="GEN 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />Asɛrǝ lǝ gǝŋrǝ le ekeeriyǝ yǝ lóo poŋ ŋpa.</para>
  <para style="q1" vid="GEN 49:20">Nǝ kǝtǝǝwǝ wǝ́ pǝ láa nya epilikeeriyǝ wǝ.<verse eid="GEN 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />Nɛfǝtali lǝ mǝŋ kɔɔyǝ rɛ pǝ la nyarǝ pǝ lo co wǝ,</para>
  <para style="q1" vid="GEN 49:21">wǝ́ ŋ ya ŋ nǝ́ǝ mǝǝnǝ epiceeceepǝ wǝ.<verse eid="GEN 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />Yosɛfʊ lǝ mǝŋ wǝciikpǝ rɛ wǝ láa nyɩŋ wǝ,</para>
  <para style="q1" vid="GEN 49:22">lǝ mǝŋ wǝciikpǝ rɛ wǝ yaa rǝ kpanǝlɛɛrɩwǝ wǝ́ wǝ láa nyɩŋ wǝ.</para>
  <para style="q1" vid="GEN 49:22">Wǝla alaŋyǝ yǝ le kpiri wǝ́ yǝ la tɛlɩ giriŋrǝ.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Eteŋteŋcatǝpǝ pǝ le yi pǝ la tɛɛ rǝ ŋwǝ,</para>
  <para style="q1" vid="GEN 49:23">wǝ́ pǝ lo wu na akpaŋyǝ, wǝ́ pǝ le yee akɔŋkǝ mǝ ŋwǝ.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Paape wǝ́ Yosɛfʊ ŋ nyɩ̀ɩ ŋ tà ne kǝteŋteŋkǝ ŋ rè kpoŋkpoŋ,</para>
  <para style="q1" vid="GEN 49:24">wǝ́ ŋ kǝ ŋ fǝǝlǝ mǝ ŋ ca kǝ.</para>
  <para style="q1" vid="GEN 49:24">Saŋ rǝ Yakɔbǝ lo Worokoyǝ we ŋ lɛnyɩ lo okopiyǝ we,</para>
  <para style="q1" vid="GEN 49:24">A la siɛrɩ e le yee Isǝrayɛlǝ lǝ rǝŋtǝyǝ mǝ</para>
  <para style="q1" vid="GEN 49:24">Isǝrayɛlǝ lo ɖutɛɛrǝ.<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />Lǝ́ tǝ lo Worokoyǝ lóo toŋ lǝ́,</para>
  <para style="q1" vid="GEN 49:25">Worokokopilǝtǝyǝ láa pɛɛrɩ lǝ́.</para>
  <para style="q1" vid="GEN 49:25">Ŋ pɛɛrɩ lǝ́ mǝ ŋʊŋtɛyǝ. Ŋ koonu kǝ kǝtǝǝwǝ wǝ wee mɛŋwǝ wǝ koonu lǝ́.</para>
  <para style="q1" vid="GEN 49:25">Láa pɛɛrɩ lǝ́ mǝ akɛɛpǝ mǝ epipǝ.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Lǝ́ tǝ la wǝpɛɛrɩkpǝ sa ŋ ya ŋ nóo koonu lǝ́ wǝ naanǝ wǝ teeri gbǝ we akakatǝtutupiyǝ yǝ ko ŋ kòonu wǝ.</para>
  <para style="q1" vid="GEN 49:26">Wǝ teeri gbǝ we akakatǝtutupipiyǝ yǝ lóo koonu wǝ.</para>
  <para style="q1" vid="GEN 49:26">Wǝpɛɛrɩkpǝ sa wǝ pǝ wǝ koonu Yosɛfʊ,</para>
  <para style="q1" vid="GEN 49:26">wǝ pǝ wǝ koonu yǝ we pǝ le tiini wǝpilikpǝ rǝ na apaanʊpǝ lǝ mǝrǝ wǝ.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />Bɛnǝyaminǝ lǝ mǝŋ pɔɔkpaacɩkɛɛyǝ rɛ ŋ náa laarǝ otuyǝ wǝ.</para>
  <para style="q1" vid="GEN 49:27">Ɖokoŋpirǝ, ŋ lɔ kɛɛyǝ ŋ wo</para>
  <para style="q1" vid="GEN 49:27">ɖiɔrǝ ŋ sǝpǝ tuwǝ we ŋ ne re ŋ nǝ pǝ wǝ.»<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Pǝlo kpǝlowǝ sa pǝ kaamǝ Isǝrayɛlǝ lǝ wǝkpǝŋkpǝ we tǝ mǝ wǝyikpǝ wǝ. Etieyǝ sa wǝ́ pǝlǝ tǝ ŋ tɛnɩ ŋ tìi pǝ mǝ eniyǝ we ŋ ka ŋ pɛɛrɩ pǝ wǝ. Wǝ́ ŋ kòonu nyi ri ŋ nyi mǝ na wǝpɛɛrɩkpǝ.<verse eid="GEN 49:28" /></para>
  <para style="s">Yakɔbǝ lǝ ǝkpǝ́kǝ</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Wǝ́ ŋ cìi ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ nah ta ŋ pǝ kpǝ́ ŋ ko tuu mǝ ǝtǝtǝpǝ. Vǝ́ ŋ́ nǝ kpǝ́ we, nǝ ka ŋwaa mǝ rǝ mǝ ǝtǝtǝpǝ la wǝnyaŋkpǝ we wǝ yaa rǝ Hɛtǝ le piyǝ we pǝ lóo pwo Efǝrɔŋ la atɛɛkǝ wǝ. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />Wǝnyaŋkpǝ we wǝ yaa rǝ atɛɛkǝ we rǝ Makpela, rǝ Mamǝre la kǝlɛɛrɩkǝ, rǝ Kanaŋ lǝ gǝŋrǝ. Atɛɛkǝ sa wǝ́ Abǝrahamǝ ŋ fùu rǝ Hɛtǝ le piyǝ we pǝ lóo pwo Efǝrɔŋ lǝ kpǝŋ, kǝ ŋ nya mǝ ŋ ŋwaa enyipǝ. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Fɛɛwǝ we wǝ́ pǝ ŋwàa Abǝrahamǝ mǝ ne tie Sara wǝ́ pǝ lɛ̀ pǝ ŋwàa Isakǝ mǝ ne tie Rebeka rǝ we. Fɛɛwǝ we wǝ́ ŋ́ ŋwàa Leya. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Pǝ fùu atɛɛkǝ we mǝ wǝnyaŋkpǝ we wǝ kpii rǝ kǝ rǝ Hɛtǝ le epipǝ lǝ kpǝŋ.»<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Kǝ́ Yakɔbǝ ŋ ne ci etieyǝ sa ŋ ne tíi ne epipǝ ŋ na lɛ we, wǝ́ ŋ fǝ̀ na akparǝyǝ ŋ tɛ̀ɛ rǝ ɖaŋraŋrǝ we, wǝ́ ŋ kpǝ́ ŋ kolu ŋ tùu nǝ ǝtǝtǝpǝ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="s">Yosɛfʊ le yee Yakɔbǝ gbǝ́rǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Rǝ fɛɛwǝ we, wǝ́ Yosɛfʊ ŋ tɔ̀ɔ ŋ si nǝ tǝ rǝ anyɩŋkǝ wǝ́ ŋ yà ŋ ke ŋ wee mǝ ŋ fìeni ŋwǝ, wǝ́ ŋ ke mili rǝ ŋwǝ. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Wǝ́ Yosɛfʊ ŋ tìi na awɛɛcátǝpǝ ǝkǝnǝŋ pǝ nuŋ no ocukuluyǝ kǝ ŋ nya fɛɛ ŋ kpɛɛ ŋ panǝ. Wǝ́ awɛɛcátǝpǝ we pǝ nunu Isǝrayɛlǝ lo ocukuluyǝ. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Pǝ fǝ̀ juu tǝniǝ milimili pǝ nunu no ocukuluyǝ we. Eciyǝ sa kǝtǝŋkǝ wǝ́ pǝ lǝ́ǝ fǝ pǝ ŋ nuŋ nyiǝtǝyǝ lo ocukuluyǝ wǝ. Wǝ́ Ejipǝtetǝpǝ pǝ weli ŋwǝ juu tǝpǝrɩmata milimili. <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />Kǝ́ eniweeyǝ we yǝ la pa tɛlɩ we, wǝ́ Yosɛfʊ ŋ tìi Farawo la acaamɩpǝ ǝkǝnǝŋ: «Nǝ dɔɔkpɛ, nǝ nyɩŋ mǝ tǝlarǝwǝ, kǝ nǝ ke tíi Farawo ǝkǝnǝŋ: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />“Mǝ tǝ tìi mǝ ǝkǝnǝŋ ŋmǝ ŋ́ tu ŋ́ tíi ŋwǝ ǝkǝnǝŋ vǝ́ ŋ nǝ kpǝ́ we, ŋmǝ ŋ́ nah ka ŋwaa ŋwǝ rǝ Kanaŋ lǝ gǝŋrǝ rǝ no wǝfuŋkpǝ we ŋ ne nyiŋ ŋ nǝ tǝnǝ na wɛ wǝ. Kǝto dɔɔkpɛ rǝkǝsa we, koonu mǝ gʊŋrǝ ŋ́ ka ŋwaa mǝ tǝ kǝ ŋ́ mǝ ŋ pǝ oo.”» <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />Wǝ́ Farawo ŋ tìi pǝ pǝ pe tíi ŋwǝ ǝkǝnǝŋ: «Yoo, mǝ ko a ka ŋwaa lǝ́ tǝ mǝŋ kǝ́ ŋ tìi lǝ́ o tù e tìi ŋwǝ kǝtǝ wǝ.» <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />Wǝ́ Yosɛfʊ ŋ pwɛ̀yɩ ŋ ko ŋ ko ŋ ka ŋwaa nǝ tǝ. Wǝ́ Farawo la acaamɩpǝ kpǝlo mǝŋ na nyarǝwǝ lo omumuŋpǝ fǝ kʊla mǝ omumuŋpǝ kpǝlo rǝ Ejipǝte pǝ sìimǝ ŋwǝ pǝ kolu. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Yosɛfʊ la nyarǝwǝ kpǝlo mǝŋ na apaanʊpǝ fǝ kʊla mǝ nǝ tǝ la nyarǝwǝ kpǝlo le enyipǝ ŋpǝ ŋkpɛ pǝ kolu. Pǝle epipǝ fǝ kʊla mǝ pǝla akɛɛpǝ ko wǝ́ pǝ màa pǝ tǝnǝ rǝ Gosɛnǝ wǝ. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Enyipǝ pǝ rè akɔŋtǝŋwaayǝ, wǝ́ arɛɛpǝ pǝ tɛ̀ɛ oroopǝ pǝ sìimǝ ŋwǝ pǝ kolu. Epǝ we pǝ sìimǝ ŋwǝ pǝ kolu pǝ ka naanǝ ŋpa.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Kǝ́ pǝ la ta Yɔrǝdaŋ pǝ lo ru pǝ le ke fii Atadǝ le deerǝ we we, wǝ́ pǝ weli pǝ nʊ̀mʊ ŋpa. Wǝ́ Yosɛfʊ ŋ yeli nǝ tǝ lǝ gbǝ́rǝ juu pǝrɩmata milimili. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Kǝ́ Akanaŋtǝpǝ we pǝ ke kpii rǝ gaarǝ we pǝ la nyɩŋ gbǝ́rǝ sa ǝnǝ rǝ Atadǝ le deerǝ we we, wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ejipǝtetǝpǝ pǝ ya pǝ lée yee gbǝ́mumuŋrǝ rɛ fee.» Tuwǝ kǝto pǝ lóo pwo fɛɛwǝ wǝ ya rǝ Yɔrǝdaŋ la kǝtakǝ we ǝkǝnǝŋ Ejipǝte lǝ gbǝ́yeerǝ. <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />Wǝ́ Yakɔbǝ lǝ ǝpǝrǝŋpipǝ pǝ yeli tuwǝ we pǝlǝ tǝ ŋ tìi pǝ pǝ kòonu ŋwǝ. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Wǝ́ pǝ rè ŋwǝ pǝ kolu Kanaŋ lǝ gǝŋrǝ pǝ kolu pǝ ŋwàa rǝ wǝnyaŋkpǝ we wǝ kpii rǝ atɛɛkǝ we rǝ Makpela. Abǝrahamǝ fùu atɛɛkǝ sa rǝ Hititǝnyiyǝ we pǝ lóo pwo Efǝrɔŋ lǝ kpǝŋ mǝ ŋ ŋwaa enyipǝ. Wǝ yaa rǝ Mamǝre la kǝlɛɛrɩkǝ.<verse eid="GEN 50:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 50:14" />Kǝ́ Yosɛfʊ ŋ na ka ŋwaa nǝ tǝ ŋ na lɛ we, wǝ́ ŋ sìɛnɩ ŋ pǝlǝ Ejipǝte ŋpǝ mǝ na apaanʊpǝ mǝ epǝ we kpǝlo pǝ cà ŋwǝ pǝ kolu fɛɛŋwaawǝ we wǝ.<verse eid="GEN 50:14" /></para>
  <para style="s">Yosɛfʊ le emǝteepǝ pǝ le pe kpii Yosɛfʊ la dɔɔkpɛɛrǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Kǝ́ Yosɛfʊ le emǝteepǝ sa pǝ la nyɩŋ ǝkǝnǝŋ pǝlǝ tǝ lǝǝ tǝ ŋ kpii we, wǝ́ pǝ kǝ ŋ pǝ̀ awɛ ǝkǝnǝŋ: «Wǝ́ mǝŋ rǝkǝsa Yosɛfʊ le yi la tɛɛ rǝ lǝ, wǝ́ ŋ́ nah mwara lǝ turɔɔrɔɔwǝ we le yeli mǝ ŋwǝ lo wǝtookpǝ kpǝlo pa?» <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Wǝ́ pǝ kpìi enyipǝ pǝ ke tíi Yosɛfʊ ǝkǝnǝŋ: «Kpɛŋ kǝ lǝ́ tǝ ŋ pǝ kpǝ́ we, tɛnɩ ǝkǝnǝŋ: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />“Nǝ pe tíi Yosɛfʊ ǝkǝnǝŋ na dɔɔkpɛ, ŋ fǝ ne mǝtee peni la bɔtɔɔrǝ mǝ pǝlo oturɔɔrɔɔyǝ ŋ cɛɛ pǝ. Kǝceecee pǝ le yee mǝ lǝ́ turɔɔrɔɔwǝ fee, paape dɔɔkpɛ, rǝkǝsa fǝ a cɛɛ lǝ́ tǝ lo Worokoyǝ la asʊmatǝpǝ oo.”» Kǝ́ pǝ le ke tíi Yosɛfʊ le dierǝ sa we, wǝ́ Yosɛfʊ ŋ yà ŋ ke ŋ wee.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Wǝ́ ne emǝteepǝ ŋpǝŋpǝ pǝ pǝlǝ nǝ kpǝŋ, wǝ́ pǝ pǝlǝ pǝ tɔ̀ɔ pǝ kpɛlɩ ŋwǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Lá asʊmatǝpǝ wǝ́ le ri.» <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />Wǝ́ Yosɛfʊ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ poo suu vurǝ, ŋkǝ ŋmǝ ŋ́ ri Worokoyǝ. <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Ŋnǝ we, nǝ nyǝ pǝ́ nǝ yee mǝ mǝ turɔɔrɔɔwǝ, paa Worokoyǝ la siɛrɩ wǝ le yee tuceeceewǝ, kǝ ŋ nya fɛɛ ŋ lɔ ŋ koonu kǝnyikpǝŋmumuŋkǝ rɛ, mǝŋ kǝ́ nǝ ya nǝ nyáa nyɩŋ wǝ ruŋruŋ le jirǝ wǝ. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Kǝto nǝ poo suu vurǝ, ŋ́ náa yɩrɩ ŋnǝ mǝ nǝ epipǝ lo yurǝ.» Wǝ́ Yosɛfʊ ŋ fǝ̀ na ziɔŋrǝ fee ŋ wɛ̀ɛlɩ ŋ tìi pǝ, wǝ́ ŋ tà pǝlo turuwǝ.<verse eid="GEN 50:21" /></para>
  <para style="s">Yosɛfʊ lǝ kpǝ́</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Yosɛfʊ tini rǝ Ejipǝte ŋpǝ mǝ nǝ tǝ la anyarǝtǝpǝ. Tini vɔrʊrǝ cɛŋwǝ tuuru mǝ tǝ. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Yosɛfʊ nyɩnɩ ne pi Efǝrayimǝ lǝ wǝmǝtatǝkpǝ. Wǝ́ ŋ lɛ ŋ rè Manase le pi Makirǝ le epipǝ rǝ akpaakpaayǝ. <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />Wǝ́ Yosɛfʊ ŋ tìi na apaanʊpǝ ǝkǝnǝŋ: «Ŋ́ nǝh kpǝ́, wǝ́ ŋ́ cii wǝ ǝkǝnǝŋ Worokoyǝ láa yɩrɩ nǝ yurǝ kokoko. Lǝ́ǝ fǝ nǝ ŋ pwɛyɩ rǝ gǝŋrǝ sa ŋ ko gǝŋrǝ we ŋ cò Abǝrahamǝ mǝ Isakǝ mǝ Yakɔbǝ la garǝ wǝ.» <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Wǝ́ Yosɛfʊ ŋ tìi Isǝrayɛlǝ le epipǝ we ǝkǝnǝŋ pǝ tu pǝ tíi ŋwǝ ǝkǝnǝŋ: «Vǝ́ Worokoyǝ la pa yɩrɩ nǝ yurǝ we, kǝ nǝ ka pɔrʊ mǝ okopiyǝ nǝ re nǝ pwɛyɩ.»<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Yosɛfʊ lɔ̀ cɛŋwǝ tuuru mǝ tǝ wǝ́ ŋ kpǝ̀. Pǝ nunu no ocukuluyǝ wǝ́ pǝ fǝ̀ ŋwǝ pǝ kpìi rǝ arakayǝ rɛ rǝ Ejipǝte.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>