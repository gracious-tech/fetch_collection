<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">Yude</para>
  <para style="toc3">Yud</para>
  <para style="toc2">Yude</para>
  <para style="toc1">Yude la kǝfwɛɛkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Yude</para>
  <para style="mt2">la kǝfwɛɛkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Yude ŋ na ŋʊrʊ kǝfwɛɛkǝ sa. La ŋʊrʊ kǝ la maŋ ekǝrisotǝpǝ kpǝlo rǝ. Na kǝfwɛɛkǝ sa le etieyǝ yǝ kaa rǝ mǝ Pɛtǝro la kǝfwɛɛyitǝkǝ le etieyǝ. Rǝ na kǝfwɛɛkǝ sa mǝrǝ we, Yude le yi la tɛɛ rǝ enyipǝ we pǝ láa kaŋ oturɔɔrɔɔyǝ wǝ́ pǝ lée ri dʊkpaatǝfɔrʊrǝ wǝ. Le yi la tɛɛ rǝ ŋpǝ enyipǝ sa pǝ láa kaŋ anianiatǝtuyǝ pǝ le pe fii asʊmatǝpǝ la wǝcakukpǝ mǝrǝ wǝ, wǝ́ ŋ ya ŋ náa tɛŋ bɔtɔɔrǝ we dɛɛ rǝ pǝlo kpǝlo kɩɩkɩ wǝ. Yude le ci la kaŋ ekǝrisotǝpǝ pǝ tɔ pǝ yaa rǝ pǝla lɔnuŋrǝ. Kǝfwɛɛkǝ sa kǝ lǝ kǝ tǝǝlǝ mǝ Worokoyǝ we ceŋceŋ ŋ ri lah Lɔkuŋtǝyǝ saŋ rǝ Yesu Kǝriso lǝ ǝkǝkǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1-2</para>
  <para style="io">- Anianiatǝtukaŋtǝpǝ lǝ wǝlǝkpǝ 3-16</para>
  <para style="io">- Ecikaŋkǝ koonu ekǝrisotǝpǝ 17-23</para>
  <para style="io">- Yude lǝ kǝ Worokoyǝ 24-25</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />Ŋmǝ Yude ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa. Yesu Kǝriso la sʊmatǝyǝ mǝ Yakubu la paanʊyǝ wǝ́ ŋ́ ri. Ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ́ na maŋ ŋnǝ epǝ we Worokoyǝ ŋ no pwo wǝ. Worokoyǝ we ŋ ri Tǝyǝ láa taa nǝ kǝǝwǝ wǝ́ ŋ ya ŋ náa yɩrɩ nǝ yurǝ mǝ ŋ tǝnǝ Yesu Kǝriso. <verse eid="JUD 1:1" /><verse number="2" style="v" sid="JUD 1:2" />Worokoyǝ la tǝlarǝnyɩŋwǝ, na wǝtaarǝkpǝ mǝ nǝ kǝǝtaawǝ yǝ pǝ yǝ koonu nǝ ŋpa.<verse eid="JUD 1:2" /></para>
  <para style="s">Anianiatǝtukaŋtǝpǝ</para>
  <para style="r">(<ref loc="2PE 2:1-17">2 Pɛtǝro 2:1-17</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />Mǝ ǝkǝǝtaatǝpǝ, ŋ́ kǝ ŋ pǝ́ wǝ ŋpa ŋ́ ŋʊrʊ ŋ́ maŋ nǝ ŋ́ ru rǝ alɔkuŋceŋceŋkǝ sa kǝ kpii kǝ koonu ŋlǝ mǝ nǝ wǝ. Rǝkǝsa ŋ́ na nyɩŋ ǝkǝnǝŋ wǝ lǝ kpuŋkpuruŋ, kǝ ŋ́ ŋʊrʊ kǝfwɛɛkǝ sa, ŋ́ fǝ ŋ kpii nǝ okopiyǝ kǝ nǝ mǝ fia koonu lɔnuŋrǝ<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Lɔnuŋrǝ rǝ fɛɛwǝ sa we, wǝ lóo koru eri anʊkɔrǝyǝ we Worokoyǝ ŋ na pɔrʊ ŋ na kaŋ wǝ.</char></note> sa Worokoyǝ ŋ nǝ fǝ ŋ no koonu na anɛŋpǝ kǝceŋceŋ ko kǝkpakǝkpa wǝ. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />Ŋ́ ya ŋ́ náa ŋʊrʊ ŋ́ maŋ nǝ duturǝ ɖi enyipǝ rɛ pǝ lǝŋ suu Worokoyǝ pǝ la ŋwaa pǝ le pe fii nǝ mǝrǝ. Pǝ ya pǝ láa siɛrɩ Worokoyǝ le dierǝ pǝ ŋ tɛŋ, ǝkǝnǝŋ Worokoyǝ láa nyɩŋ enyipǝ la tǝlarǝwǝ kǝto yǝ lóo koru eyee turɔɔrɔɔwǝ we wǝ ponu mǝ lǝ wǝ. Mǝŋkǝsa we, pǝ ya pǝ lǝ́ǝ sǝ́ŋ Yesu Kǝriso pǝ ŋ co, ŋwǝ yǝ we ceŋceŋ ŋ ri loh Mumuŋyǝ mǝ loh Kulǝtǝyǝ wǝ. Wǝ la panǝ ŋpa kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ tuwǝ sa ǝkǝnǝŋ tukoŋtawǝ wǝ tɛɛ rǝ enyipǝ sa. <verse eid="JUD 1:4" /><verse number="5" style="v" sid="JUD 1:5" />Nǝ marǝ nǝ cii otuyǝ sa sɩsiɛrɩ paape ŋ́ nǝ pǝ́ ŋ́ tǝ ŋ́ taalǝ nǝ yǝ. Ǝtǝ Woroko ŋ pɔ̀rʊ Isǝrayɛlǝ lǝ kǝkpǝŋkǝ ŋ rù rǝ Ejipǝte. Paape rǝ wǝla kǝmaakǝ we, wǝ́ ŋ wʊ̀ʊlʊ epǝ we pǝ laa lɔ ŋwǝ pǝ nuŋ wǝ. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />Nǝ taalǝ epicoŋpipǝ we le dierǝ! Pǝ màa okopiyǝ we Worokoyǝ ŋ kòonu pǝ pǝ cò, wǝ́ pǝ pwɛ̀yɩ rǝ fɛɛwǝ we Worokoyǝ ŋ tìini pǝ wǝ. Kǝto Worokoyǝ le kpii pǝ la akpɛtɛɛyǝ kǝkpakǝkpa lǝ tǝnǝ rǝ nuŋtumuwǝ lǝ mǝrǝ pǝ lǝ́ǝ rǝŋ wǝkpaŋtɛŋkpǝ le jimumuŋrǝ we. <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />Nǝ taalǝ Sodomǝ mǝ Gomora, mǝ ǝtǝŋtǝǝyǝ we yǝ ka màarǝ mǝ yǝ wǝ! Ǝtǝŋtǝǝyǝ sa le enyipǝ ŋpǝ ŋkpɛ pǝ yeli epicoŋpipǝ sa lo nuŋruwǝ we kǝtǝŋkǝ, wǝ́ pǝ kǝ ŋ pǝ́ pǝ toomu mǝ enyipǝ mǝ wǝlǝkpǝ rɛ wǝ laa laka nyɩmaasɩyǝ ŋ yee wǝ. Pǝ ya pǝ láa lɔ tukoŋtawǝ rǝ naalaalɛwǝ lǝ mǝrǝ. Mǝŋkǝsa we, kǝ wǝ fǝ wǝ kaŋ enyipǝ kpǝlo kɩɩkɩ lo otuyǝ. <verse eid="JUD 1:7" /><verse number="8" style="v" sid="JUD 1:8" />Kaa ŋpǝ enyipǝ sa ŋpǝ ŋkpɛ pǝ ya pǝ lée yee wǝǝ. Pǝ láa kpɛɛlɩ wǝtʊkpɛɛkpǝ rɛ wǝrʊʊkpǝ wǝ lóo koonu pǝ ŋ cɩɩrɩ pǝla wɛ mǝ nuŋruwǝ. Pǝ ya pǝ láa fʊ Worokoyǝ lo okopiyǝ pǝ ŋ sǝǝlǝ. Wǝ́ pǝ ya pǝ láa fɛɛpɩ otuyǝ we yǝ lo ru okuruyǝ yǝ kpii rǝ yulaarǝ wǝ. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />Misiɛlɩ ŋ ri epicoŋpipǝ lo mumuŋyǝ ǝkǝŋtǝ lee yee tuwǝ sa kǝtǝŋkǝ! Kǝ́ ŋpǝ mǝ Abʊŋsamʊyǝ pǝ yà pǝ ka ŋ kpaŋ pǝ ŋ kpii Mose le kǝnyiǝtǝkǝ we, loo tu turuwǝ ŋ fɛɛ ŋwǝ! Tuwǝ ŋ tìi ŋwǝ kɩɩkɩ wǝ kaamǝ: «Ǝtǝ Woroko ŋ ta lǝ́ kǝtukoŋkǝ.» <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />Paa enyipǝ sa ǝnǝ we, pǝ láa fɛɛpɩ tuwǝ we pǝ lee ci wǝ. Otuyǝ pǝ cii we, yǝ lǝ rǝ mǝŋ kǝ́ tuwǝ wǝ láa saanǝ rǝ apɔɔkɛɛpǝ mǝrǝ kǝtǝ. Ŋyǝ yǝ lǝ́ǝ nǝǝnǝ pǝ wǝ. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />Pǝla paapɔ mǝ pǝla aria! Pǝ le siimǝ Kayɩŋ la cawǝ. Rǝ sɩkayǝ pǝ lah lɔ kǝto wǝ́ pǝ lo yuu pǝla wɛ, wǝ́ pǝ le yee turɔɔrɔɔwǝ mǝŋ Balamǝ kǝtǝ. Pǝ lǝ kpǝ́ pǝ lǝ nǝŋ mǝŋ Kore kǝtǝ, kpiikǝ pǝ le yi pǝ la tɛɛ rǝ Worokoyǝ kǝto. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />Ŋpǝ enyipǝ sa pǝ láa cɩɩrɩ ŋnǝ apaanʊkǝrisotǝpǝ le ekeeriyǝ we nǝ nyóo ku nyǝ ŋ ri wǝ. Pǝ lée yee erikpaakǝ wǝ lǝŋ yee pǝla nʊŋsɔɔwǝ! Pǝla nɛŋwǝ ko wǝ́ pǝ lǝ́ǝ pǝ́. Pǝ lǝ rǝ mǝŋ aŋɔɔyǝ we ǝrǝfuŋkǝ kǝ re kǝ láa tɛlɩ yǝ lǝŋ pǝ mǝ ŋʊŋtɛyǝ wǝ! Ŋpǝ enyipǝ sa pǝ kaa rǝ mǝ eciiyǝ we yǝ lǝŋ nyɩŋ ǝtǝnǝyǝ mǝŋ daalǝnyɩŋrǝ ǝkǝŋtǝ wǝ! Mǝŋ pǝ lo nuru yǝ we, ǝ yǝ ŋ kpǝ́ fee. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />Pǝ lǝ rǝ mǝŋ apʊyǝ la mɛŋyicawǝ wǝ lǝ fǝ kpɛɛmʊrʊwǝ kǝtǝ. Pǝ ya pǝ láa pɔrʊ pǝla anʊŋsɔɔtǝtuyeeyǝ pǝ ŋ fɛlɩ rǝ ŋpǝŋpǝ pǝla kǝnyɩŋkǝ mǝŋ kǝ́ apʊyǝ yǝ lée re dʊtʊʊrǝ yǝ ŋ pǝ yǝ ŋ fieni waa rǝ dǝǝtǝǝrǝ kǝtǝ. Pǝ lǝ rǝ mǝŋ wǝŋɔŋkpǝ rɛ wǝ siri wǝ láa tɛlɩ kǝtǝ. Wǝ́ Worokoyǝ la taa fɛɛtiiwǝ kǝkpakǝkpa lǝ tǝnǝ pǝ rǝ nuŋtumuwǝ we wǝ la ta fwafwa wǝ le teeri lǝ mǝrǝ.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />Enɔkǝ ŋ ri tǝtǝpǝrɩmatatǝyǝ ru ǝrǝ Adamǝ we, tɛnɩ dierǝ tǝ̀nǝ rù rǝ enyipǝ sa ǝkǝnǝŋ: «Nǝ nuŋ: Kulǝtǝyǝ kpii lǝ́ǝ pǝ ŋpǝ mǝ ne epicoŋpipǝ lafawǝ pakapaka, <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />kǝ ŋ pa tɛŋ enyipǝ kpǝlo kɩɩkɩ la akpaŋyǝ. Láa tɔɔ oturɔɔrɔɔyeetǝpǝ kpǝlo kɩɩkɩ la bɔrǝ rǝ pǝlo oturɔɔrɔɔyǝ we kpǝlo kɩɩkɩ pǝ le yee mǝ kǝ́ pǝ le yi pǝ la tɛɛ rǝ Worokoyǝ wǝ. Láa tɔɔ ŋpǝ awɛɛlaapɛɛlɩtǝpǝ sa la bɔrǝ rǝ pǝlo onyuŋsusutieyǝ we kpǝlo kɩɩkɩ pǝ la tɛŋ pǝ lo ru rǝ Worokoyǝ kǝto.» <verse eid="JUD 1:15" /><verse number="16" style="v" sid="JUD 1:16" />Ŋpǝ enyipǝ sa pǝ lǝŋ nya faawǝ kʊrakʊra! Eni ri ŋ ni pǝ ya pǝ láa nʊmʊ pǝ ŋ ru rǝ pǝla wɛ. Ŋpǝŋpǝ pǝlo otucakpɛɛrɔɔrɔɔyǝ we ko wǝ́ pǝ siimǝ pǝ láa tɛlɩ. Pǝ láa wɛɛlɩ otukǝŋkǝŋtuyǝ. Pǝ láa raanǝ nyuŋkpǝ pǝ ŋ tǝǝnǝ nyiyǝ we lǝ kpǝŋ pǝ láa nya tǝrɛ pǝ ru wǝ.<verse eid="JUD 1:16" /></para>
  <para style="s">Pǝ le ci pǝ la kaŋ ekǝrisotǝpǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />Ŋnǝ paa we, mǝ ǝkǝǝtaatǝpǝ, nǝ mǝ taalǝ etieyǝ we loh Kulǝtǝyǝ Yesu Kǝriso le enyikpiipǝ we pǝ tɛnɩ pǝ tìi nǝ rǝ gakarǝ wǝ. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />Pǝ tìi nǝ ǝkǝnǝŋ: «Rǝ enituturuyǝ we lǝ mǝrǝ we, enyipǝ pǝ lah mǝ mɔɔnʊ nǝ. Pǝ lóo ruu pǝ ru rǝ Worokoyǝ lǝ kpǝŋ, kǝ pǝ tii vɔrʊrǝ saŋ rǝ pǝlo otucakpɛɛrɔɔrɔɔyǝ lǝ mǝrǝ.» <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />Ŋpǝ enyipǝ sa pǝ lée kpii wǝsǝpǝkpǝ rǝ enyipǝ mǝrǝ wǝ. Anyɩmaasɩpǝ lo otuyeeyǝ ko yǝ kpii pǝ rǝ yurǝ. Pǝ lǝǝ lǝmǝ Wɛɛkenikenirǝ! <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />Mǝ ǝkǝǝtaatǝpǝ, ŋnǝ paa we, nǝ tǝ nǝ mǝ tɔ nǝ vɔrʊrǝ nǝ mǝ tɛɛ rǝ nǝ lɔnuŋkenikenirǝ we. Nǝ mǝ mwɛŋ nyuŋkpǝ mǝ Wɛɛkenikenirǝ lo okopiyǝ. <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />Nǝ tǝ nǝ mǝ re nǝ wɛ rǝ Worokoyǝ lǝ kǝǝtaawǝ mǝrǝ. Nǝ mǝ rǝŋ loh Kulǝtǝyǝ Yesu Kǝriso kǝ ŋ po koonu nǝ vɔrʊlaalɛɛrǝ. Lée yee wǝ kpiikǝ tǝlarǝnyɩŋtǝyǝ wǝ́ ŋ ri.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />Nǝ nyɩŋ epǝ we pǝ ya pǝ lǝ́ǝ tǝmǝlǝ la tǝlarǝwǝ! <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />Nǝ tiini arɛɛpǝ nǝ pɔrʊ nǝ ru rǝ naawǝ, eniyǝ we nǝ nya lɔ nǝ nyo koonu pǝ wǝǝ. Nǝ nyɩŋ arɛɛpǝ ŋpǝ ŋkpɛ la tǝlarǝwǝ. Paape nǝ yee wǝ mǝ vusuurǝ! Nǝ pǝǝ fǝ nǝ wɛ nǝ mili mǝ pǝ. Pǝla wǝkpakpǝ ǝkǝŋtǝ wǝ la cɩɩ mǝ pǝlo oturɔɔrɔɔyǝ we pǝ ya pǝ lée yee wǝ!<verse eid="JUD 1:23" /></para>
  <para style="s">Yude lǝ kǝ Worokoyǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />Kǝ lǝ kǝ yǝ we ŋ nóo koru ata nǝ akaa mǝ akaa kǝ nǝ paa tɔɔ wǝ. Ŋwǝ ŋ née re nǝ mǝ faa mǝ faa ŋ ko na wǝnyɩɩnɩkpǝ we lǝ kpǝŋ, wǝfɔkpǝ rɛ wǝ lǝŋ tɛɛ rǝ nǝ. <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />Ŋwǝ ceŋceŋ ŋ ri Worokoyǝ we ŋ na pɔrʊ lǝ saŋ rǝ loh Kulǝtǝyǝ Yesu Kǝriso wǝ! Ŋwǝ ŋ kaamǝ ǝkǝkǝ, anaanǝkǝ, okopiyǝ mǝ alɛnyɩkǝ eni ri ŋ ni, fǝ rǝkǝsa mǝ ko alaalɛɛkǝ! Amɛnǝ.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>