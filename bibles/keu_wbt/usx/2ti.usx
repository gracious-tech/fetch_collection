<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">Akebou: La Bible en akebou</book>
  <para style="h">2 Timote</para>
  <para style="toc3">2Ti</para>
  <para style="toc2">2 Timote</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ Timote wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Timote</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Kǝfwɛɛkǝ sa kǝ kaamǝ kǝfwɛɛyitǝkǝ we Pɔlʊ ŋ na ŋʊrʊ ŋ na maŋ Timote wǝ. Timote ŋ ke ri ŋwǝ Pɔlʊ la kɛrɩnǝnɛyeetǝyǝ wǝ. Pɔlʊ ka ŋ taa Timote le kǝǝwǝ ŋpa. Kǝto fǝ̀ ŋwǝ rǝ mǝŋ ne piyǝ kǝtǝ. Pɔlʊ ŋʊ̀rʊ kǝfwɛɛkǝ sa mǝ eniyǝ we ŋ ke kpii rǝ gukpɛɛkpǝ rǝ Roma wǝ (<char style="xt"><ref loc="2TI 1:17">1:17</ref></char>). Kǝfwɛɛkǝ sa kǝ ya kǝ láa wɛɛlɩ kǝ ŋ ru rǝ Pɔlʊ ŋwǝŋwǝ kpɛŋ: Na anǝnɛyǝ, no otukaŋyǝ mǝ na ariaayǝ we ŋ na nyɩŋ rǝ Dieceeceerǝ we lo yurǝ wǝ. Fɛɛwǝ kǝto ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ Timote kǝ ŋ nya fɛɛ ŋ kpii no okopiyǝ, kǝ ŋ lɛ ŋ ci ŋ kaŋ ŋwǝ kǝ́ ŋ née re na wɛ ŋ fǝ rǝ lɔnuŋrǝ lǝ mǝrǝ wǝ. Kǝfwɛɛkǝ sa kǝ kpii mǝ ecikaŋkǝ ŋpa kǝ koonu ŋlǝ ekǝrisotǝpǝ, otukpǝlo epǝ we pǝ ri zʊmarǝ lo omumuŋpǝ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-2</para>
  <para style="io">- Pɔlʊ lo Worokoyǝ lǝ ǝkǝkǝ rǝ Timote lo yurǝ 1:3-5</para>
  <para style="io">- Pɔlʊ le ecikaŋkǝ koonu Timote 1:6–4:5</para>
  <para style="io">- Pɔlʊ ŋwǝŋwǝ ne etieyǝ 4:6-18</para>
  <para style="io">- Eceenituturukǝ 4:19-22</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Ŋmǝ Pɔlʊ, ŋ́ ri Yesu Kǝriso le nyikpiiyǝ mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ wǝ wǝ. Worokoyǝ le kpii mǝ ǝkǝnǝŋ ŋmǝ ŋ́ pa tɛŋ vɔrʊrǝ we ŋ no co lǝ garǝ saŋ rǝ Yesu Kǝriso. <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />Ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa mǝ ŋ maŋ ŋlǝ́ Timote, mǝ pikǝǝtaatǝyǝ. Lǝh Tǝ Worokoyǝ mǝ loh Kulǝtǝyǝ Yesu Kǝriso pǝ yee lǝ́ lɛsiɛrɩwǝ, kǝ pǝ nyɩŋ lǝ́ tǝlarǝwǝ, kǝ pǝ koonu lǝ́ wǝtaarǝkpǝ.<verse eid="2TI 1:2" /></para>
  <para style="s">Pɔlʊ ya lée ci mǝ ŋ kaŋ Timote</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Ŋ́ ya ŋ́ née ceeni Worokoyǝ, yǝ we ŋ́ ya ŋ́ náa sʊma mǝ kʊmaceeceeyǝ, mǝŋ kǝ́ mǝ ǝtǝtǝpǝ pǝ ke ŋ yee wǝ kǝtǝ wǝ. Vǝ́ ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ eni ri ŋ ni mǝŋ dumu mǝŋ jɔkɔŋ we, ŋ́ náa taalǝ lǝ́. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Vǝ́ ŋ́ na taalǝ lé eweekǝ we we, a wǝ ŋ mǝ ca mǝ kpɛɛ ŋpa ŋ́ nyɩŋ lǝ́, kǝ ŋ́ nya fɛɛ ŋ́ lǝ mǝ faawǝ. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />Ŋ́ ya ŋ́ náa taalǝ lá anʊkɔrǝyǝ la lɔnuŋrǝ we gbii rǝ lǝ́ mǝrǝ wǝ. Lɔnuŋrǝ sa kǝtǝŋkǝ ge kpii rǝ lá paapa Loyisǝ mǝ lé lee Enisǝ lǝ mǝrǝ wǝ. Wǝ́ ŋ́ cii wǝ ǝkǝnǝŋ ŋrǝ lɔnuŋrǝ sa gbii rǝ lǝ́ mǝrǝ wǝ.<verse eid="2TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />Kǝto ŋ́ ya ŋ́ náa taalǝ lǝ́ wǝ, kǝ a nya fɛɛ e kpii wɛɛlɛŋwǝ rǝ tuwǝ we Worokoyǝ ŋ kòonu lǝ́ wǝ. Tuwǝ sa wǝ́ ŋ kòonu lǝ́ mǝ eniyǝ we ŋ́ tɛ̀ɛ lǝ́ wǝkaakpǝ wǝ. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Duturǝ ɖi ŋkǝ vusuurǝ la Wɛɛrǝ wǝ́ Worokoyǝ ŋ no koonu lǝ, paa ɖi rǝ okopiyǝ la Wɛɛrǝ, kǝǝtaawǝ la Wɛɛrǝ mǝ Wɛɛrǝ we lóo koonu kǝ le ri lah wɛ lo yurǝ wǝ. <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />Kǝto poo suu nʊŋsɔɔwǝ mǝ kǝ́ e leh ri ɖaŋsieyǝ o koonu loh Kulǝtǝyǝ wǝ. Paa lɛ o suu ŋmǝ yǝ ŋ́ ri kukpɛɛtǝyǝ rǝ no yurǝ la nʊŋsɔɔwǝ. Paape saŋ rǝ Worokoyǝ lo okopiyǝ we, nyɩɩ kǝ a nyɩŋ ariaayǝ a kʊla mǝ mǝ koonu Dieceeceerǝ we. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Ŋwǝ Worokoyǝ ŋ na pɔrʊ lǝ, wǝ́ ŋ no pwo lǝ le pe ri nǝ kǝkpǝŋkǝ. Ŋkǝ saŋ rǝ lah anǝnɛyǝ kǝto wǝ́ ŋ ne yee wǝ ǝnǝ, paa saŋ rǝ ŋwǝŋwǝ na akʊŋyǝ mǝ na lɛsiɛrɩwǝ. Kpɛŋ kǝ ǝrǝkǝ kǝ ci ǝpǝ sǝŋ we, Worokoyǝ yeli lǝ lɛsiɛrɩwǝ sa sanǝ rǝ Yesu Kǝriso. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Wǝ́ ruŋruŋ le jirǝ Worokoyǝ ŋ na pɔrʊ lɛsiɛrɩwǝ sa ŋ na kaŋ saŋ rǝ kǝ́ Yesu Kǝriso, lah Lɔkuŋtǝyǝ ŋ nǝ pǝ wǝ. Ŋwǝ ŋ ne ri gbɛŋrǝ lo okopiyǝ lo yurǝ. Saŋ rǝ Dieceeceerǝ we lo oŋuŋkǝ we, lo koonu lǝ vɔrʊrǝ, kǝ la paa nya fɛɛ lǝ kpǝ́. <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />Ŋrǝ Dieceeceerǝ sa kǝto wǝ́ Worokoyǝ ŋ nǝ fǝ mǝ ŋ ne yee worokoŋtietɛŋtǝyǝ mǝ nyikpiiyǝ mǝ tukaŋtǝyǝ wǝ. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Wǝ kǝto ŋ́ ya ŋ́ náa nyɩŋ ariaayǝ sa wǝǝ. Paape ŋ́ naa ya ŋ́ nóo suu nʊŋsɔɔwǝ, duturǝ ɖi ŋ́ cii yǝ we kǝtǝŋkǝ ŋ́ na tɛɛ kpɛɛwǝ rǝ wǝ. Wǝ́ ŋ́ lɛ ŋ cii wǝ ǝkǝnǝŋ nyiyǝ we lǝǝmǝ okopiyǝ ŋ náa ta tuwǝ we ŋ no koonu mǝ ŋ re ko ro ǝrǝ jirǝ we ŋ náa siɛnɩ ŋ pǝ wǝ. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />Fǝ anʊkɔrǝtieyǝ we ŋ́ na tɛŋ ŋ́ ne tíi lǝ́ ǝ fǝ e yee tunyɩŋcamǝwǝ, kǝ a tɔ a yaa rǝ lɔnuŋrǝ mǝ kǝǝtaawǝ we yǝ kpii rǝ Yesu Kǝriso lǝ mǝrǝ wǝ. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Saŋ rǝ Wɛɛkenikenirǝ we gbii rǝ lǝh mǝrǝ we, toolu otuceeceeyǝ we Worokoyǝ ŋ no koonu lǝ́ ǝ tǝnǝ.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Mǝŋ kǝ́ e cii wǝ we, lǝh ǝtǝŋpǝ we kpǝlo pǝ kpii rǝ Azi pǝ lǝ sǝ́ŋ mǝ pǝ lo co. Enyipǝ mǝŋ Figɛlǝ mǝ Ɛrǝmozɛnǝ. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />Kulǝtǝyǝ ŋ yee Onesifɔrǝ mǝ na nyarǝwǝ la lɛsiɛrɩwǝ, duturǝ ɖi lée kpii mǝ okopiyǝ eni ri ŋ ni, wǝ́ mǝ gukpɛɛkpǝ sa wǝ lǝŋ co na nʊŋsɔɔwǝ. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />Paa kǝ́ ŋ na nya ŋ nǝ pǝ Roma we, wǝ́ ŋ na nyɩɩ ŋ na taa mǝ ŋ na pa nyɩŋ. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Kulǝtǝyǝ ŋ toŋ Onesifɔrǝ kǝ ŋ nya fɛɛ ŋ nya Worokoyǝ la lɛsiɛrɩwǝ mǝ jirǝ we Yesu ŋ nǝ́ǝ pǝ wǝ. E cii kǝnǝnɛkǝ we ŋ ne yee ŋ no koonu mǝ rǝ Efeso sɩsiɛrɩ.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Tɔ a yaa rǝ Kǝriso lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Mǝ pi, ŋlǝ́ paa we, lɛsiɛrɩwǝ we wǝ kpii rǝ Yesu Kǝriso lǝ mǝrǝ we, wǝ kpii lǝ́ okopiyǝ. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Otuyǝ we o lo nuŋ ŋ́ na kaŋ rǝ araŋsielǝtǝpǝ wa la kǝnyɩŋkǝ we, fǝ yǝ a kaŋ enyipǝ we o lóo koru atɛ kpɛɛwǝ wǝ, kǝ oturu ŋpǝ ŋkpɛ pǝ lóo koru akaŋ enyipʊŋpwapǝ lǝ yǝ wǝ. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />Nyɩŋ ariaayǝ sa a kʊla mǝ mǝ mǝŋ Yesu Kǝriso lo tuusiitǝceeceeyǝ kǝtǝ. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Tuusiitǝyǝ rɛ lee kpii kǝ oturu ŋ ya ŋ nǝ́ǝ pǝ́ ŋ yee no kulǝtǝyǝ lǝ kǝǝpǝ́wǝ, kǝ ŋ tǝ mǝ ŋ yee vɔrʊrǝ sa la anǝnɛpʊŋpwayǝ. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Kpɛŋ kǝ suutǝyǝ rɛ ŋ pe ri yurǝ kǝ ŋ lɔ wǝtoomwarakpǝ we, wǝ kaamǝ kǝ ŋ suu ŋ saŋ rǝ osuukǝ le esepǝ. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Tɛɛtɛɛkpɛŋtǝyǝ we ŋ náa nyɩɩ we, ŋwǝ ŋ nóo coŋ keeriwǝ la anya wǝ. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Pu yurǝ o ru rǝ otuyǝ sa ŋ́ ya ŋ́ náa tɛŋ wǝ, kǝ Kulǝtǝyǝ ŋ toŋ lǝ́ kǝ o nuŋ tu ri ŋ tu lo duturǝ.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Mǝŋ kǝ́ ŋ́ ya ŋ́ náa tɛŋ wǝ rǝ Dieceeceerǝ we kǝtǝ we, mǝ taalǝ Yesu Kǝriso. La saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ. Davidǝ le pilepiyǝ wǝ́ ŋ ri. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Ŋrǝ Dieceeceerǝ sa kǝto, wǝ́ ŋ́ ya ŋ́ náa cʊʊrʊ, wǝ́ kʊraa pǝ le pe kpii mǝ akpɛtɛɛyǝ mǝŋ yɩlayɩtǝyǝ kǝtǝ. Paape rɛ laa taŋ Worokoŋtierǝ ŋ kpii rǝ gukpɛɛkpǝ. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Kǝto ŋ́ na tɛɛnɩ ŋ́ re eleeyǝ sa kpǝlo rǝ epǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ lo yurǝ, kǝ ŋpǝ ŋkpɛ pǝ nya fɛɛ pǝ nya alɔkuŋkǝ we kǝ kpii rǝ Yesu Kǝriso lǝ mǝrǝ, mǝŋ wǝnyɩɩnɩlaalɛɛkpǝ we. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />Dierǝ sa ǝnǝ we, anʊkɔrǝyǝ yǝ lǝǝwe:</para>
  <para style="q1" vid="2TI 2:11">Mǝŋ yǝ lǝ kpǝ́ yǝ la kʊla mǝ Yesu we,</para>
  <para style="q1" vid="2TI 2:11">Yǝ láa lɛ le tii vɔrʊrǝ la kʊla mǝ ŋwǝ.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Mǝŋ yǝ la nyɩɩ yǝ la tɔ yǝ la yaa we,</para>
  <para style="q1" vid="2TI 2:12">Yǝ lée ri wǝpilikpǝ la kʊla mǝ ŋwǝ.</para>
  <para style="q1" vid="2TI 2:12">Mǝŋ yǝ lǝ sǝ́ŋ ŋwǝ yǝ lo co we,</para>
  <para style="q1" vid="2TI 2:12">Ŋwǝ ŋkpɛ lǝ́ǝ sǝ́ŋ lǝ ŋ co.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Mǝŋ yǝ lǝŋ yee anʊkɔrǝyǝ we,</para>
  <para style="q1" vid="2TI 2:13">Ŋwǝ paa nʊkɔrǝlǝtǝyǝ wǝ́ ŋ ri.</para>
  <para style="q1" vid="2TI 2:13">Duturǝ ɖi lǝŋ koru atɛŋ dierǝ, kǝ ŋ pee yee ŋ saŋ rǝ rǝ.<verse eid="2TI 2:13" /></para>
  <para style="s">Tɛŋ Worokoŋtierǝ rǝ wǝkʊʊkpǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Taalǝ etieyǝ sa a kaŋ enyipǝ. Fǝ Ǝtǝ Worokoyǝ e kpii pǝ la dɔɔkpɛɛrǝ, kǝ e tíi pǝ ǝkǝnǝŋ pǝ paa mǝ kpaŋ rǝ etieyǝ lo yurǝ. Duturǝ ɖi yǝ lǝǝ lǝmǝ vasʊ, paa yǝ lǝ́ǝ pǝlǝ epǝ we pǝ ya pǝ lóo nuŋ yǝ rǝ. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Nyɩɩ kǝ e re lá wɛ sɩsiɛrɩ, kǝ ló tuwǝ wǝ poŋ mǝ Worokoyǝ, mǝŋ nǝnɛyeetǝyǝ we ŋ náa nya faawǝ rǝ na kǝnǝnɛkǝ, wǝ́ ŋ náa tɛŋ Worokoyǝ la nʊkɔrǝtierǝ sɩsiɛrɩ wǝ. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Sǝ́ŋ awɛɛlɩkpaakpaakǝ we kǝ laa kaamǝ lɔnuŋrǝ wǝ. Duturǝ ɖi epǝ we pǝ láa taa awɛɛlɩkpaakpaakǝ lǝ kǝǝwǝ we, pǝ lóo ruu pǝ ŋ cɛ tɩpɩtɩpɩ rǝ Worokoyǝ lǝ kpǝŋ. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Ŋpǝ enyipǝ sa le etietɛŋyǝ yǝ lǝ rǝ mǝŋ kpaŋkokoyǝ ŋ ya ŋ náa nyaanǝ kǝtǝ. Imene mǝ Filɛtǝ pǝ kʊla mǝ enyipǝ sa kǝtǝŋkǝ. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Ŋpǝ enyipǝ sa pǝ la cɛ rǝ anʊkɔrǝyǝ lǝ kpǝŋ. Wǝ́ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ enyiǝtǝpǝ pǝ la marǝ asaanǝ pǝ la pa tɛlɩ. Wǝ́ pǝ ya pǝ lée kpii enyipǝ wa la lɔnuŋrǝ la gbaraarǝ.<verse eid="2TI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19" />Paape kǝtɛɛkǝ we Worokoyǝ ŋ no co we, kǝ la tɔ kǝ yaa kiŋkiŋ kǝ lǝŋ ruu wɛɛwǝ. Etieyǝ we pǝ la ŋʊrʊ pǝ la tɛɛ rǝ kǝtɛɛkǝ we yǝ kaamǝ ǝyǝ ǝnǝ: «Ǝtǝ Woroko cii na anɛŋpǝ.» Wǝ́ pǝ lǝ tǝ pǝ la ŋʊrʊ ǝkǝnǝŋ: «Yǝ we ŋ na tɛŋ ǝkǝnǝŋ ŋwǝ ŋ ri Ǝtǝ Woroko la nɛŋyǝ we, wǝ kpii kǝ ŋ ruu ŋ cɛ rǝ turɔɔrɔɔwǝ lǝ kpǝŋ».<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Ŋkǝ sɩkamwɛɛrɩyǝ mǝ sɩkakpɛɛlɩyǝ la wǝsiɛkpǝ ko wǝ́ pǝ láa nyɩŋ rǝ sɩkalǝtǝyǝ la nyarǝwǝ. Paa pǝ láa nyɩŋ mǝŋ wǝkǝtǝǝsiɛkpǝ mǝ gbǝ we pǝ lǝ kpǝ mǝ ciiwǝ wǝ. Wǝsiɛrɛɛkpǝ wǝ lóo toŋ mǝ wǝcɛkpǝ le eniyǝ, wǝ́ wǝrɛɛkpǝ wǝ lóo toŋ mǝ ecipǝlǝpǝlǝyǝ. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Kǝto mǝŋ rɛ la pɔrʊ na wɛ lo ru rǝ oturɔɔrɔɔyǝ sa lǝ mǝrǝ we, yǝ we kǝtǝŋkǝ lée ri kǝsiɛkǝ we kǝ lóo toŋ mǝ wǝcɛkpǝ le eniyǝ wǝ. Pǝ la kʊʊ kǝ pǝ lǝ tǝnǝ Kulǝtǝyǝ. Ŋkǝ kǝsiɛkǝ sa kǝ lóo toŋ kǝlo kulǝtǝyǝ, wǝ́ ŋ nǝ́ǝ fǝ kǝ mǝ ŋ yee wǝnǝnɛkpatɩkpǝ kpǝlo.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Ruu o ru rǝ oturɔɔrɔɔyǝ we yǝ láa ca okosopipǝ la kpɛɛ lǝ kpǝŋ. Taa wǝkʊʊkpǝ, lɔnuŋrǝ, kǝǝtaawǝ mǝ wǝtaarǝkpǝ la akʊŋyǝ. Maa kǝ ŋyǝ otuyǝ sa yǝ kpii rǝ ŋnǝ mǝ epǝ we nǝ nyǝ fǝ ziɔŋceeceerǝ nǝ ya nǝ nyóo pwo Kulǝtǝyǝ wǝ. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Paa, sǝ́ŋ awɛɛlɩkpaakpaakǝ, mǝ awɛɛlɩkǝ we kǝ lǝǝ lǝmǝ duturǝ wǝ. E cii wǝ ǝkǝnǝŋ kǝ lóo co akpaŋyǝ. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Duturǝ ɖi Worokoyǝ le nyiyǝ lǝŋ yee akpaŋyǝ. No tuwǝ wǝ poŋ mǝ nyi ri ŋ nyi bomu. Ŋ ri yǝ we ŋ nóo koru otuyǝ la akaŋ, wǝ́ ŋ náa tɛɛnɩ pǝ tiini etieyǝ mǝ ŋwǝ. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />Wǝ kaamǝ kǝ ŋ fǝ lɛtaarǝwǝ ŋ ci ŋ kaŋ epǝ we pǝ le yi pǝ la tɛɛ rǝ ŋwǝ wǝ. Rɛ lee ci, ayɩrɛ Worokoyǝ lóo koonu kǝ pǝ siɛrɩ, kǝ pǝ nya fɛɛ pǝ ci anʊkɔrǝyǝ. <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />Eniyǝ we pǝ la siɛnɩ pǝ le fii pǝla wɛ lǝ mǝrǝ, kǝ pǝ ru rǝ satana la kpɛrɛwǝ we lǝ mǝrǝ pǝ ke kpii ǝkǝ pǝ ke ŋ yee nǝ kǝǝpǝ́wǝ wǝ.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Arianyɩŋyǝ we yǝ lo furu yǝ pǝ pǝ mǝ ecituturuyǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Ci wǝ ǝkǝnǝŋ rǝ ecituruyǝ lǝ mǝrǝ we, enilɛnyɩyǝ yǝ lǝh pǝ pǝ. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Enyipǝ pǝ lah mǝ taa rǝ pǝla nɛŋwǝ ko, kǝ pǝ ŋ taa sɩkayǝ lǝ kǝǝwǝ. Pǝ lǝh mǝ kǝ pǝla wɛ, kǝ pǝ ŋ rɛɛrɩ mǝ pǝla wɛ rǝ oŋuŋkǝ, kǝ pǝ lɛ pǝ ŋ wɛɛlɩ opusuŋtǝtuyǝ pǝ ŋ ru rǝ Worokoyǝ. Enyipǝ pǝ lǝŋ tǝ pǝ ŋ pu pǝlǝ ǝtǝpǝ mǝ pǝle eleepǝ. Vǝ́ e le yee tuwǝ o lo koonu pǝ we, pǝ lǝŋ nyɩŋ wǝ pǝ ci kǝ pǝ pe ceeni lǝ́. Pǝ lǝŋ tǝ pǝ ŋ pu Worokoyǝ lo otuyǝ. <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />Enyipǝ pǝ láa lɛnyɩ yurǝ, pǝ lǝŋ nyɩŋ nyiyǝ la tǝlarǝwǝ. Arɛɛpǝ pǝ lah mǝ tɛŋ enyipǝ, kǝ pǝ ŋ yee kǝpɔɔkɛɛkǝ, kǝ pǝ ŋ yururu, kǝ pǝ lɛ pǝ yi pǝ tɛɛ rǝ tuceeceewǝ. <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />Enyipǝ pǝ leh mǝ siiri pǝlǝ ǝtǝŋpǝ, kǝ arɛɛpǝ pǝ ŋ yee akpɛɛmʊrʊtuyǝ. Enyipǝ pǝ lah mǝ rɛɛrɩ mǝ pǝla wɛ rǝ oŋuŋkǝ ŋpa, kaa kǝ pǝ taa Worokoyǝ lǝ kǝǝwǝ we, pǝ lah mǝ taa rǝ otucakpɛɛyǝ lǝ kǝǝwǝ. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />Pǝ lah mǝ kaŋ pǝla wɛ mǝŋ pǝ kʊʊ rǝ Worokoyǝ le enimiyǝ, paa rǝ anʊkɔrǝyǝ we, pǝ lǝ sǝ́ŋ lɔnuŋrǝ lo okopiyǝ pǝ lo co. Pǝǝ mǝ kǝlǝ mǝ ŋpǝ enyipǝ sa kǝtǝŋkǝ. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />Enyirɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ leh mǝ fii anyarǝyǝ, kǝ pǝ tǝǝnǝ etiepǝ we pǝ laa lɛnyɩ pǝ ŋ kpii, ŋpǝ epǝ we pǝ lée yee oturɔɔrɔɔyǝ piripiwǝ, wǝ́ pǝ láa lɛ pǝ ŋ siimǝ tucakpɛ ri ŋ tucakpɛ la akʊŋyǝ wǝ. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Ŋpǝ etiepǝ sa pǝ re pǝ ya mǝ otukarǝyǝ, paape pǝ lǝŋ nyɩŋ anʊkɔrǝyǝ pǝ ci kʊrakʊra. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Mǝŋ kǝ́ Yanɛsɩ mǝ Yamure pǝ yili pǝ tɛ̀ɛ rǝ Mose we, kǝ́ ŋpǝ enyipǝ sa pǝ lée yi pǝ ŋ tɛɛ rǝ anʊkɔrǝyǝ wǝǝ. Ŋpǝ enyipǝ sa lo oturɔɔrɔɔyǝ we pǝ ya pǝ lée yee yǝ la lɔ pǝlo susuyǝ, wǝ́ pǝla lɔnuŋrǝ lǝǝ lǝmǝ vasʊ. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Paape ŋpǝ enyipǝ sa pǝ lǝŋ re pǝ ko wǝlǝǝrǝkpǝ, duturǝ ɖi enyipǝ kpǝlo pǝ lah pa nyɩŋ pǝlo yufiirǝ sa pǝ ci mǝŋ kǝ́ wǝ pǝlǝ wǝ tùu Yanɛsɩ mǝ Yamure wǝ.<verse eid="2TI 3:9" /></para>
  <para style="s">Mǝ yee a mǝ saŋ rǝ otuyǝ we a la karǝ wǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Ŋlǝ́ paa we, o lo nuŋ mǝ otukaŋyǝ, e le siimǝ mǝ wǝlǝkpǝ, mǝ oyupuyǝ, mǝ lɔnuŋrǝ, mǝ lɛtaarǝwǝ, mǝ kǝǝtaawǝ, mǝ anyɩɩkǝ. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />A nyɩnɩ kǝ́ pǝ yili pǝ tɛ̀ɛ rǝ mǝ wǝ, mǝ ariaayǝ we ŋ́ nyɩnɩ rǝ Aŋtiokia, Ikonio mǝ Lisǝra wǝ. Pǝ yili pǝ tɛ̀ɛ rǝ mǝ ŋpa oo! Paape Kulǝtǝyǝ ŋ lɛ̀ ŋ pɔ̀rʊ mǝ rǝ yǝ lo kpǝlo lǝ mǝrǝ. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Rǝ anʊkɔrǝyǝ we, epǝ we kpǝlo pǝ ya pǝ lǝ́ǝ pǝ́ pǝ tii vɔrʊrǝ rǝ wǝkʊʊkpǝ rǝ Yesu Kǝriso lǝ mǝrǝ we, enyipǝ pǝ lée yi pǝ tɛɛ rǝ pǝ. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Paa enyirɔɔrɔɔpǝ mǝ anianiatǝpǝ we, pǝ lah mǝ nyɩɩ pǝ ŋ yee turɔɔrɔɔwǝ rǝ ko. Pǝ lǝh mǝ tǝǝnǝ enyipǝ kǝ pǝ lɛ pǝ ŋ tǝǝnǝ ŋpǝŋpǝ pǝla wɛ.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Ŋlǝ́ paa we, mǝ tii vɔrʊrǝ rǝ otuyǝ we a la karǝ, wǝ́ e cii ǝkǝnǝŋ yǝ ri anʊkɔrǝyǝ wǝ. E cii epǝ we lǝ kpǝŋ a kàrǝ ŋyǝ otuyǝ sa wǝ. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />Kǝceecee e cii Wǝŋʊrʊkenikenikpǝ ǝrǝ lá kǝlaatiekǝ. Ŋkpǝ Wǝŋʊrʊkpǝ sa wǝ lóo koru okoonu lǝ́ otuciyǝ. Otuciyǝ sa yǝ lée re lǝ́ kǝ a nya alɔkuŋkǝ mǝ kǝ́ a la lɔ Yesu Kǝriso o lo nuŋ wǝ. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Worokoyǝ ŋ sanǝ rǝ enyipǝ wǝ́ pǝ ŋʊ̀rʊ Wǝŋʊrʊkenikenikpǝ kpǝlo. Wǝŋʊrʊkpǝ sa wǝ lóo poŋ kǝ pǝ fǝ pǝ kaŋ enyipǝ la anʊkɔrǝyǝ, kǝ pǝ fǝ pǝ sǝ́ŋ turɔɔrɔɔwǝ pǝ koonu nyiyǝ, kǝ pǝ fǝ pǝ kʊʊrʊ nyiyǝ, kǝ pǝ lɛ pǝ fǝ pǝ kaŋ nyiyǝ lo otuyǝ rǝ wǝkʊʊkpǝ. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />Mǝŋkǝsa we, o lóo turu Worokoyǝ le nyiyǝ lo to. La kpaka tini koonu kǝnǝnɛkǝ we kǝ nya kǝ ponu le eyeekǝ.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="s">Ecikaŋtuturukǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Timote, rǝ Worokoyǝ le enimiyǝ mǝ Yesu Kǝriso le enimiyǝ, ŋwǝ yǝ we ŋ no furu ŋ pe ri wǝpilikpǝ mǝŋ piliyǝ kǝtǝ, kǝ ŋ tɛŋ wǝkpaŋkpǝ mǝ enyipǝ we pǝ kpii vɔrʊrǝ mǝ enyiǝtǝpǝ we, ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ lǝ́: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Mǝ nyɩɩ a mǝ tɛŋ Worokoŋtierǝ wǝ ke ce wǝ ri eniceeceeyǝ amaa enirɔɔrɔɔyǝ. Sǝ́ŋ dierǝ o koonu enyipǝ, kpaŋ mǝ enyipǝ, kpii enyipǝ lo okopiyǝ, kǝ ǝ fǝ lɛtaarǝwǝ ŋpa a mǝ kaŋ otuyǝ.<verse eid="2TI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 4:3" />Duturǝ ɖi eniyǝ rɛ yǝ lo furu enyipǝ pǝ lǝŋ tǝ pǝ po co kǝtukoŋkǝ rǝ otukaŋceeceeyǝ, paa kǝ pǝ ŋ siimǝ rǝ ŋpǝŋpǝ pǝlo otucakpɛɛyǝ. Eniyǝ we pǝ lǝ fǝ pǝla wɛ pǝ lo koonu otukaŋtǝpǝ wa, kǝ pǝ nya fɛɛ pǝ ŋ kaŋ pǝ lo otuyǝ we pǝ láa taa pǝ ŋ nuŋ wǝ. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Pǝ láa taŋ pǝlo otukoŋyǝ kǝ pǝ paa nya fɛɛ pǝ nuŋ nʊkɔrǝtierǝ, paa kǝ etiekpǝtɛŋyǝ yǝ ŋ raŋ mǝ pǝlo onuŋkǝ. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Ŋlǝ́ paa we, ta lá wɛ rǝ tu ri ŋ tu lǝ mǝrǝ. Nyɩɩ kǝ a nyɩŋ ariaayǝ, mǝ yee worokoŋtietɛŋtɛlɩtǝyǝ la kǝnǝnɛkǝ.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Rǝ mǝ kǝtakǝ we, pǝ la marǝ ǝfǝ mǝ pǝ leh yee otoolukǝ. Wǝ́ eniyǝ we ŋ́ nah pwɛyɩ rǝ ǝrǝkǝ sa yǝ la marǝ oro. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Ŋ́ na fia afiaceeceekǝ, ŋ́ no suu mǝ osuukǝ ŋ́ na lɛ, wǝ́ ŋ́ tǝ ŋ́ lǝǝmǝ lɔnuŋrǝ. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Rǝkǝsa sa we, Worokoyǝ lo toolu wǝkʊʊkpǝ le bilituurǝ lǝ tǝnǝ mǝ. Wǝ́ Kulǝtǝyǝ, yǝ we ŋ ri kpaŋtɛŋtǝceeceeyǝ ŋ nǝh pǝ fǝ bilituurǝ sa ŋ koonu mǝ mǝ jitɛŋakpaŋyǝ we wǝ. Ŋkǝ ŋmǝ ceŋceŋ ko wǝ́ ŋ noh koonu rǝ, lóo koonu mǝŋ epǝ we kpǝlo pǝ lǝ fǝ kǝǝtaawǝ pǝ ya pǝ lǝ́ǝ rǝŋ nǝ ǝpǝkǝ wǝ.<verse eid="2TI 4:8" /></para>
  <para style="s">Pɔlʊ le tíi Timote ŋ po tuu ŋwǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Nyɩɩ kǝ o po tuu mǝ kalaŋ. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Duturǝ ɖi Demasǝ la maa mǝ lo co. Kpiikǝ ŋ náa taa rǝkǝsa lǝ ǝrǝkǝ lo otuyǝ kǝto la pwɛyɩ la tɛlɩ Tesalonika. Kǝresike lo ko Galatia, wǝ́ Tito ŋ no ko Dalǝmatia. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Luka ceŋceŋ ko ŋ kpii ŋ kʊla mǝ mǝ. Vǝ́ o lo furu we, kǝ e re Marǝko ǝ pǝ. Duturǝ ɖi lóo koru o po toŋ rǝ mǝ kǝnǝnɛkǝ sa mǝrǝ. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Ŋ́ ne kpii Tisiko rǝ Efeso. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Vǝ́ o lo furu we, kǝ e re mǝ kǝkpakpurumukǝ we ǝ pǝ. Ŋ́ màa kǝ ŋ́ tǝnǝ rǝ Tǝrowa rǝ Karǝpo lǝ kpǝŋ, kǝ a lɛ e re wǝfwɛɛkpǝ ǝ pǝ, otukpǝlo gbǝ we pǝ la ŋʊrʊ pǝ la tɛɛ rǝ fwɛɛwǝ wǝ. <verse eid="2TI 4:13" /><verse number="14" style="v" sid="2TI 4:14" />Kʊʊtǝyǝ we pǝ lóo pwo Alɛsaŋto le yee mǝ mǝ turɔɔrɔɔwǝ fee. Kulǝtǝyǝ láa mwara nǝ wǝ lo wǝtookpǝ. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Ŋlá ŋkpɛ yee yurǝ rǝ nǝ kpǝŋ. Duturǝ ɖi le yi la tɛɛ rǝ loh otukaŋyǝ mǝ okopiyǝ. <verse eid="2TI 4:15" /><verse number="16" style="v" sid="2TI 4:16" />Kǝsǝsǝŋkǝ we pǝ pwò mǝ rǝ fɛɛtɛŋakpaŋyǝ kǝ ŋ́ ka tɛŋ ŋ́ pɛɛnɩ mǝ wɛ we, pǝlo kpǝlo pǝ màa mǝ pǝ cò. Rɛ loo ko ŋ ka tɛŋ ŋ toŋ mǝ. Worokoyǝ ŋ fǝ ŋ cɛɛ pǝ. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Paape Kulǝtǝyǝ lɔ̀ kòonu mǝ, wǝ́ ŋ kpìi mǝ okopiyǝ, wǝ́ ŋ́ kòru atɛnɩ ne dierǝ sɩsiɛrɩ, wǝ́ epǝ we pǝ lee ri Oyudatǝpǝ pǝ nunu dierǝ sa. Wǝ́ ŋ lɛ̀ ŋ pɔ̀rʊ mǝ ŋ rù rǝ kɛɛlɔyǝ lo nyuŋkpǝ. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Kulǝtǝyǝ lǝ́ǝ tǝ mǝ ŋ pɔrʊ mǝ rǝ oturɔɔrɔɔyǝ kpǝlo lǝ mǝrǝ, kǝ ŋ koonu kǝ ŋ́ ke fii ne wǝpilirikpǝ we rǝ yulaarǝ cʊrʊcʊrʊ. Ŋwǝ Kulǝtǝyǝ ŋ kaamǝ ǝkǝkǝ kǝkpakǝkpa! Amɛnǝ.<verse eid="2TI 4:18" /></para>
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Ceeni Pǝrisǝka mǝ Akila mǝŋ Onesifɔrǝ la anyarǝtǝpǝ. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erasǝ la siɛnɩ tini rǝ Korɛŋto, Tǝrofimǝ laa kpaa, wǝ́ ŋ́ na maa ŋwǝ rǝ Mile. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Nyɩɩ kǝ ǝ pǝ kpɛŋ kǝ asiɛniyǝ yǝ ci oro.</para>
  <para style="q1" vid="2TI 4:21">Ebulo mǝ Pudɛŋ mǝ Linu mǝ Kǝlodia mǝ apaanʊpǝ kpǝlo pǝ lée ceeni lǝ́.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Kulǝtǝyǝ ŋ tii ŋ kʊla mǝ lǝ́! Worokoyǝ la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ kpǝlo.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>