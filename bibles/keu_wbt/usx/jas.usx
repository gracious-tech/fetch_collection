<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">Akebou: La Bible en akebou</book>
  <para style="h">Yakubu</para>
  <para style="toc3">Yak</para>
  <para style="toc2">Yakubu</para>
  <para style="toc1">Yakubu la kǝfwɛɛkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Yakubu la kǝfwɛɛkǝ we</para>
  <para style="mt2">ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Yakubu ŋ na ŋʊrʊ kǝfwɛɛkǝ sa. Yesu la paanʊyǝ wǝ́ ŋ ri. La ŋʊrʊ kǝfwɛɛkǝ sa la maŋ Worokoyǝ lǝ kǝkpǝŋkǝ kǝ ŋ fǝ ŋ ci ŋ kaŋ pǝ. Rǝ alɔnuŋtǝpǝ we lǝ mǝrǝ we, arɛɛpǝ lǝ wǝlǝkpǝ wǝ laa pɔrʊ wǝ kaŋ ǝkǝnǝŋ pǝ ri alɔnuŋtǝpǝ. Epǝ we pǝ ke ri asɩkalǝtǝpǝ pǝ ka ŋ rɛɛrɩ mǝ pǝla wɛ, wǝ́ ariariatǝpǝ paa pǝ ka ŋ nyɩŋ ariaayǝ. Tuwǝ kǝto Yakubu ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ na maŋ pǝ kǝ ŋ fǝ ŋ ci ŋ kaŋ pǝ ǝkǝnǝŋ vǝ́ rɛ la lɔ lo nuŋ we, wǝ kaamǝ kǝ wǝ nyɩnɩ rǝ no otuceeceeyǝ le eyeekǝ, kǝ pǝ lɛ pǝ ci awɛ le ere rǝ Worokoyǝ lǝ mǝrǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Eceenikǝ 1:1</para>
  <para style="io">- Lɔnuŋrǝ mǝ atɔyaakǝ 1:2-18</para>
  <para style="io">- Kǝ lo nuŋ Worokoŋtierǝ kǝ lǝ fǝ rǝ le yee kǝnǝnɛkǝ 1:19-27</para>
  <para style="io">- Loh kpǝlo la kaa rǝ 2:1-13</para>
  <para style="io">- Lɔnuŋrǝ mǝ tuceeceewǝ le eyeekǝ 2:14-26</para>
  <para style="io">- Eciawɛɛlɩkǝ 3:1-18</para>
  <para style="io">- Kǝwɛlɛŋfwɛɛkǝ lo otucakpɛɛyǝ 4:1–5:6</para>
  <para style="io">- Ecikaŋkǝ 5:7-20</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Ŋmǝ Yakubu, ŋ́ ri Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso la sʊmatǝyǝ, ŋ́ ya ŋ́ náa ŋʊrʊ kǝfwɛɛkǝ sa mǝ ŋ maŋ Yuda lǝ ǝkpǝŋyǝ we tǝ mǝ eyi yǝ la caŋ yǝ láa tɛlɩ rǝ ǝrǝkǝ kpǝlo wǝ. Ŋ́ née ceeni nǝ.<verse eid="JAS 1:1" /></para>
  <para style="s">Nǝ lɔ nǝ nuŋ kǝ nǝ tɔ nǝ yaa</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Lǝh ǝtǝŋ, mǝŋ acʊcʊʊrʊpiyǝ kǝkpǝŋkǝ yǝ lo tuu nǝ we, nǝ lɔ wǝ mǝ faawǝ. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />Kpiikǝ nǝ cii wǝ ǝkǝnǝŋ vǝ́ nǝ lɔnuŋrǝ la nyɩɩ le fii rǝ acʊcʊʊrʊyǝ mǝrǝ lo ko ru we, wǝ lóo koonu kǝ nǝ tɔ nǝ yaa. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Paape wǝ kaamǝ kǝ nǝ atɔyaakǝ sa kǝ nyɩnɩ rǝ nǝ otuyeeyǝ lǝ mǝrǝ. Eniyǝ we nǝ nyo to milimili, tǝrɛ wǝ poo tuuru rǝ nǝ wǝlǝkpǝ. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Mǝŋ rɛ rǝ nǝ mǝrǝ ya lǝ́ǝ pǝ́ otuciyǝ we, yǝ we ŋ pǝ́ Worokoyǝ we ŋ nóo koonu otuyǝ mǝ lɛtaarǝwǝ wǝ́ ŋ nǝŋ kpamǝ nyiyǝ wǝ, lóo koonu ŋwǝ. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Paa yǝ we ŋ pǝ́ mǝ lɔnuŋrǝ, ŋ pǝǝ tǝmǝlǝ. Kpiikǝ yǝ we ŋ nǝ́ǝ pǝ́ tuwǝ mǝ ŋ tǝmǝlǝ we, lǝ rǝ mǝŋ apʊyǝ la mɛŋwǝ ǝrǝfuŋkǝ kǝ ya kǝ lée yiili kǝ ŋ ca ko eni pǝ eni. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Nyiyǝ sa kǝtǝŋkǝ ŋ paa tɛɛ kpɛɛwǝ ǝkǝnǝŋ ŋ náa lɔ tuwǝ rɛ ŋ ru rǝ Ǝtǝ Woroko lǝ kpǝŋ. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />Duturǝ ɖi nyiyǝ sa lǝ́ǝ tǝmǝlǝ, wǝ́ ŋ nǝǝ lǝmǝ yupurǝ jeŋceŋ rǝ tu ri ŋ tu ŋ née yee wǝ.<verse eid="JAS 1:8" /></para>
  <para style="s">Riariatǝyǝ mǝ sɩkalǝtǝyǝ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Paanʊyǝ we ŋ ri riariatǝyǝ we, ŋ nya faawǝ ǝkǝnǝŋ ŋ na lɔ okuruyǝ rǝ Worokoyǝ le enimiyǝ. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Kǝ paanʊyǝ we ŋ ri sɩkalǝtǝyǝ paa ŋ nya faawǝ ǝkǝnǝŋ Worokoyǝ la pɛɛlɩ ŋwǝ. Duturǝ ɖi no otulǝmǝyǝ sa yǝ lah pa tɛlɩ mǝŋ otumɔŋyǝ kǝtǝ. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Vǝ́ cɔkɔŋyǝ lo poŋ wǝ́ ŋ ya ŋ náa nyɔŋ kɩrɩrɩ we, láa kpaalǝ bɔɔrǝ. Bɔɔrǝ sa lo otumɔŋyǝ yǝ ŋ mʊsɩ yǝ tɔɔlʊ. Yǝ ŋ lǝǝrǝ yǝlo wǝpoŋkpǝ kǝtǝrǝceŋceŋ. Kǝ́ sɩkalǝtǝyǝ ŋwǝ ŋkpɛ ŋ nǝh pǝ kpǝ́ rǝ na kǝnǝnɛkǝ mǝrǝ wǝǝ.<verse eid="JAS 1:11" /></para>
  <para style="s">Worokoyǝ lǝŋ kpii nyiyǝ lǝ gbǝǝrǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Yǝ we ŋ na nyɩɩ ŋ na tɔ ŋ na yaa rǝ acʊcʊʊrʊpiyǝ lǝ mǝrǝ we, ŋwǝ yǝ lo co yǝ. Kpiikǝ mǝŋ le fii rǝ yǝlǝ mǝrǝ la ka tɛlɩ, wǝ́ ŋ naa tɔɔ we, kpii lǝ́ǝ pǝ ŋ pa lɔ wǝtoomwarakpǝ. Wǝtoomwarakpǝ sa wǝ kaamǝ vɔrʊrǝ we Ǝtǝ Woroko ŋ no co garǝ ŋ nǝ tǝnǝ enyipǝ we pǝ láa taa nǝ kǝǝwǝ wǝ. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Mǝŋ pǝ le kpii rɛ lǝ gbǝǝrǝ we, yǝ we ŋ paa tɛŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii nǝ rǝ. Kpiikǝ tǝrɛ wǝ lǝŋ tu Worokoyǝ ŋ yee turɔɔrɔɔwǝ. Ŋwǝ ŋkpɛ lǝŋ kpii rɛ lǝ gbǝǝrǝ. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Paa nyɩmaasɩyǝ ŋwǝŋwǝ no otucakpɛɛyǝ yǝ lǝ́ǝ tǝǝnǝ ŋwǝ yǝ ŋ kpii rǝ gbǝǝrǝ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Mǝŋ tucakpɛɛwǝ rɛ wǝ la lɔ kǝtiikǝ rǝ nyiyǝ lǝ mǝrǝ we, wǝ lǝ́ǝ pǝ mǝ turɔɔrɔɔwǝ. Turɔɔrɔɔwǝ la anaanǝkǝ wǝ lǝ́ǝ pǝ mǝ gbɛŋrǝ. <verse eid="JAS 1:15" /><verse number="16" style="v" sid="JAS 1:16" />Mǝ apaanʊkǝǝtaatǝpǝ, nǝ pǝǝ tǝǝnǝ nǝ wɛ. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Wǝsiɛrɩkpǝ kpǝlo mǝ otukoonuceeceeyǝ kpǝlo yǝ lo ru rǝ yulaarǝ, rǝ Worokoyǝ lǝ kpǝŋ. Ŋwǝ Worokoyǝ ŋ ne yee cɔkɔŋyǝ, kɛɛnyɔŋyǝ mǝ wǝŋɔŋkpǝ. Ŋwǝ we, lǝŋ cɛkɛlɛ. Lǝŋ ruu wɛɛwǝ, lǝŋ siɛrɩ ŋ kaalǝ kǝtakǝceŋceŋ kǝ ŋ maa kǝtayitǝkǝ rǝ nuŋtumuwǝ mǝrǝ. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Wǝ lo poŋ mǝ ŋwǝ Worokoyǝ sa, wǝ́ ŋ no koonu lǝ vɔrʊŋwɛŋrǝ saŋ rǝ ne dierǝ we ɖi anʊkɔrǝyǝ wǝ, kǝ la nya fɛɛ le pe yee mǝŋ otulɛsǝsǝŋyǝ pǝ la kʊʊ pǝ lǝ tǝnǝ Worokoyǝ rǝ na wǝyaakpǝ kpǝlo lǝ mǝrǝ.<verse eid="JAS 1:18" /></para>
  <para style="s">Dierǝ lo onuŋkǝ sɔŋ wǝ loo ro</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Mǝ apaanʊkǝǝtaatǝpǝ, nǝ mǝ taalǝ tuwǝ sa ǝkǝnǝŋ: «Nyi ri ŋ nyi ŋ fǝǝlǝ rǝ dierǝ lo onuŋkǝ, ŋ pǝǝ mǝ fǝ nyuŋkpǝ kǝ ŋ pǝǝ mǝ fǝ kpɛɛmʊrʊwǝ kalaŋkalaŋ.» <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Kpiikǝ nyɩmaasɩyǝ la kpɛɛmʊrʊwǝ wǝ lǝŋ maa ŋwǝ ŋ yee tuwǝ wǝ kʊʊ rǝ Worokoyǝ la anyɩŋkǝ. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Kǝto nǝ wɛ mǝ arɛɛyǝ kpǝlo kɩɩkɩ lo otuyeeyǝ mǝ vɔrʊrɔɔrɔɔrǝ le etiikǝ. Nǝ pɛɛlɩ nǝ wɛ nǝ koonu dierǝ we Worokoyǝ ŋ nǝ fǝ ŋ ne kpii nǝ rǝ ziɔŋrǝ mǝrǝ, wǝ́ lóo koru alɔ goonu nǝ wǝ.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Nǝ fǝ dierǝ we nǝ yee kǝnǝnɛkǝ. Nǝ poo nuŋ rǝ ko kǝ wǝ lɛ, kǝ nǝ mǝ tǝǝnǝ nǝ wɛ. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Kpiikǝ nyɩmaasɩyǝ we ŋ no nuŋ dierǝ, wǝ́ ŋ nǝǝ fǝ rǝ ŋ yee kǝnǝnɛkǝ we, lo ru nyiyǝ rɛ ŋ na yɩrɩ na anyɩŋkǝ rǝ tǝraanyɩwǝ mǝŋ kǝ́ kǝ lǝ wǝ. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />Kǝ́ ŋ na yɩrɩ na wɛ ŋ na lɛ, wǝ́ ŋ na pwɛyɩ. Rǝ kɔɔwǝ we ŋ nóo ko we, lo yuu na anyɩŋkǝ lǝ ǝlǝkǝ la kpɛɛ kaka. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Paa nyɩmaasɩyǝ we ŋ nóo co nimirǝ rǝ seyǝ we ŋ no to wǝ́ ŋ nóo kuŋ diiwɛɛrǝ wǝ́ nyiyǝ sa ŋ na tɔ ŋ na yaa loo yukpɛ, wǝ́ ŋ nǝ fǝ seyǝ sa ŋ ne yee kǝnǝnɛkǝ we, Worokoyǝ láa pɛɛrɩ ŋwǝ rǝ no tu ri ŋ tu ŋ née yee wǝ. <verse eid="JAS 1:25" /><verse number="26" style="v" sid="JAS 1:26" />Mǝŋ rɛ lǝ́ǝ kǝ wǝ ǝkǝnǝŋ ŋ náa sʊma Worokoyǝ wǝ́ ŋ nǝŋ ci no kǝroŋfwɛɛkǝ le ere we, yǝ we ya lǝ́ǝ tǝǝnǝ na wɛ. Zʊmakpaakpaarǝ lǝǝwe. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Worokoŋsʊmarǝ we la lɔ okuruyǝ wǝ́ laa tɛɛ mǝ arɛɛyǝ rǝ Worokoyǝ we ŋ ri Tǝyǝ la kǝnyɩŋkǝ we, gaamǝ ǝkǝnǝŋ nyɩmaasɩyǝ ŋ yɩrɩ akʊʊpipǝ mǝ ekpeetiepǝ lo yurǝ rǝ pǝla arianyɩŋyǝ mǝrǝ, kǝ ŋ paa cɩɩrɩ na wɛ mǝ ǝrǝkǝ sa lo oturɔɔrɔɔyǝ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Nǝ paa yɩrɩ rǝ anyɩŋkǝ kǝ nǝ ci eyee tǝrɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Lǝh ǝtǝŋ, ŋnǝ epǝ we nǝ nya lɔ loh Kulǝtǝyǝ Yesu Kǝriso, yǝ we ŋ kaamǝ ǝkǝkǝ nǝ nyo nuŋ we, nǝ paa yɩrɩ rǝ anyɩŋkǝ nǝ yee tǝrɛ. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Kǝ lǝ fǝ wǝ mǝŋ kɛrɩyǝ rɛ ŋ ne kpii zɩkawarǝpirǝ mǝ wǝkpaceeceekpǝ ŋ ne pǝ fii nǝ wǝcakukpǝ mǝrǝ. Wǝ́ riariatǝyǝ rɛ ŋ nǝ kpii wǝkpacɩɩkpǝ ŋwǝ ŋkpɛ ŋ ne pǝ fii. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />Wǝ́ nǝ nyo co nimirǝ rǝ yǝ we ŋ ne kpii wǝkpaceeceekpǝ lǝ kpǝŋ, wǝ́ nǝ nye tíi ŋwǝ ǝkǝnǝŋ: «Pǝ e pe tii rǝ fɛɛticeeceewǝ sa». Paa wǝ́ nǝ nye tíi riariatǝyǝ we ǝkǝnǝŋ «Ŋlǝ́ pa yaa rǝ sa amaa pe tii rǝ kǝtǝǝwǝ rǝ sa» wǝǝ, <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />kǝto nǝ nyaa marǝ nǝ nye kpii wǝsǝpǝkpǝ rǝ nǝ mǝrǝ? Nǝ nyaa marǝ nǝ ya nǝ nyǝ́ǝ fǝ oyupurɔɔrɔɔyǝ nyǝ ŋ kpii wǝsǝpǝkpǝ?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Mǝ apaanʊkǝǝtaatǝpǝ, nǝ co kǝtukoŋkǝ. Worokoyǝ ŋ na saa ariariatǝpǝ rǝ ǝrǝkǝ sa mǝrǝ pǝ nya pǝla wɛ rǝ na anyɩŋkǝ, mǝ kǝ́ pǝ la lɔ Yesu Kǝriso pǝ lo nuŋ wǝ, kǝ pǝ nya fɛɛ pǝ lɔ Worokoyǝ lo otuceeceeyǝ, kǝ pǝ lɛ pǝ ke fii ne wǝpilirikpǝ we ŋ na tɔɔ ŋ nǝ tǝnǝ epǝ we pǝ láa taa nǝ kǝǝwǝ. <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Paape ŋnǝ we, nǝ nyǝŋ kǝ ariariatǝpǝ nǝ kpii mǝ kpǝŋwǝ. Ŋkǝ asɩkalǝtǝpǝ pǝ le si nǝ pǝ la marǝ wǝ? Ŋkǝ ŋpǝ pǝ tiini nǝ pǝ láa tɛlɩ rǝ afɛɛtɛŋakpaŋyǝ wǝ? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Ŋkǝ ŋpǝ ke pǝ ya pǝ láa cɩɩrɩ Yesu Kǝriso la nyɩŋceeceerǝ sa pǝ le kpii nǝ wǝ? <verse eid="JAS 2:7" /><verse number="8" style="v" sid="JAS 2:8" />Worokoyǝ le esemumuŋpǝ we le ceŋceŋ ŋ kaamǝ yǝ ǝnǝ: «Wǝ kpii kǝ a taa lá kɛrɩyǝ lǝ kǝǝwǝ mǝŋ ŋlǝ́ŋlǝ́ lá wɛ kǝtǝ». Mǝŋ nǝ nye yee nǝ nya saŋ rǝ ŋwǝ seyǝ sa we, o lóo turu nǝ nye yee wǝ ponu. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Paa mǝŋ nǝ nya yɩrɩ rǝ anyɩŋkǝ we, nǝ nye yee turɔɔrɔɔwǝ. Seyǝ la tɔɔ nǝ bɔrǝ duturǝ ɖi nǝ nyee yee nǝ saŋ rǝ ŋwǝ. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Kpiikǝ nyɩmaasɩyǝ we ŋ ne yee ŋ na saŋ rǝ esepǝ kpǝlo kɩɩkɩ, wǝ́ ŋ na tɔɔ seyǝ ceŋceŋ pɛ we, la tɔɔ pǝ lo kpǝlo. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Kpiikǝ Worokoyǝ we ŋ na tɛŋ ǝkǝnǝŋ: «Pee yee nuŋruwǝ» we, ŋwǝ ke ŋ na tɛŋ ǝkǝnǝŋ: «Paa wʊ nyiyǝ». Kǝto mǝŋ e lee yee nuŋruwǝ paa wǝ́ a la wʊ nyiyǝ we, a la tɔɔ bɔrǝ rǝ esepǝ we kpǝlo kpeŋkpeŋ lǝ kpǝŋ. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Nǝ tutɛŋwǝ mǝ nǝ tuyeewǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ seyǝ we ŋ nóo koonu enyipǝ le diiwɛɛrǝ, wǝ́ pǝ lǝh pǝ fǝ pǝ tɛŋ nǝ wǝkpaŋkpǝ. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Kpiikǝ yǝ we ŋ nǝŋ nyɩŋ nyiyǝ la tǝlarǝwǝ we, ŋwǝ ŋkpɛ Worokoyǝ lǝŋ nyɩŋ na tǝlarǝwǝ rǝ wǝkpaŋtɛŋkpǝ. Nyiyǝ we ŋ náa nyɩŋ enyipǝ la tǝlarǝwǝ we, lǝŋ suu vurǝ rǝ Worokoyǝ la wǝkpaŋtɛŋkpǝ.<verse eid="JAS 2:13" /></para>
  <para style="s">Lɔnuŋrǝ we kǝnǝnɛkǝ kǝ laa kʊla we, ɖi lɔnuŋkpaakpaarǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Lǝh ǝtǝŋ, mǝŋ rɛ la tɛŋ ǝkǝnǝŋ ŋ na lɔ Worokoyǝ ŋ no nuŋ wǝ́ no otuyeeyǝ yǝ laa pɔrʊ na lɔnuŋrǝ we yǝ kaŋ wǝǝ, wǝla tǝtatɛɛwǝ wǝ kaamǝ wǝ rǝ fǝŋ? Na lɔnuŋrǝ we lóo koru apɔrʊ ŋwǝ? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Mǝŋ paanʊyǝ rɛ amaa paatɛyǝ rɛ loh ru kǝtaŋkpaakǝ, wǝ́ ŋ nǝŋ lɛ ŋ nya tuwǝ ŋ neh ri rǝ jɔkoŋcirǝ, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />wǝ́ nǝ rɛ ŋ ne tíi ŋwǝ ǝkǝnǝŋ ko kǝ ǝ pǝ oo! Saŋ sɩsiɛrɩ oo! Ziɛrǝ baa wʊ lǝ́ oo! Ri kǝ o wu oo! Wǝ́ paa laa nya tuwǝ we wɛlɛŋrǝ lǝ pǝ́ ŋ koonu ŋwǝ wǝǝ, wǝla tǝtatɛɛwǝ ǝrǝ wǝ rǝ fǝŋ? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Kǝ́ wǝ lǝ wǝ koonu lɔnuŋrǝ wǝǝ. Mǝŋ otuyeeyǝ yǝ laa kʊla mǝ rǝ we, lɔnuŋkpaakpaarǝ lǝǝwe.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Wǝ́ mǝŋ rɛ láa tɛŋ ǝkǝnǝŋ: «Ŋlǝ́ ǝ lǝǝmǝ lɔnuŋrǝ wǝ́ ŋmǝ we ŋ́ lǝǝmǝ otuyeeyǝ», ŋ́ née tíi yǝ we ŋ kaŋ mǝ kǝ́ ŋ nóo koru ǝlǝmǝ lɔnuŋrǝ paa kǝ ŋ pee yee otuyǝ, kǝ ŋmǝ ŋkpɛ ŋ́ kaŋ ŋwǝ mǝ lɔnuŋrǝ saŋ rǝ mǝ otuyeeyǝ. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Kǝ́ a la lɔ o lo nuŋ ǝkǝnǝŋ Worokoyǝ ceŋceŋ ŋ kpii we, e le yee wǝ ponu. Kaa wǝǝ awɛɛrɔɔrɔɔyǝ ŋyǝ ŋkpɛ yǝ la lɔ yǝ lo nuŋ, a yǝ ŋ mǝ ca kpakpa. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Ao tuleecitǝyǝ sa! A ya lǝ́ǝ pǝ́ pǝ kaŋ lǝ́ ǝkǝnǝŋ lɔnuŋrǝ we otuyeeyǝ yǝ laa kʊla ɖi rǝ lɔnuŋkpaakpaarǝ? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Kǝ́ kǝto wǝ́ Worokoyǝ ŋ nyɩnɩ lǝh tǝtǝ Abǝrahamǝ ǝkǝnǝŋ ri nyikʊʊyǝ rǝ ne enimiyǝ wǝ? Ŋkǝ kǝ́ ŋ fǝ̀ ne pi Isakǝ ŋ ko tòolu ŋ koonu Worokoyǝ rǝ no otoolucuukǝ kǝto? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />A ya láa nyɩŋ! Na lɔnuŋrǝ mǝ no otuyeeyǝ yǝ láa saŋ cɛɛcɛ, wǝ́ no otuyeeyǝ yǝ lo kuŋ wǝ́ na lɔnuŋrǝ lo to milimili. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Kǝ́ wǝ le yee wǝ́ kǝworokoŋfwɛɛkǝ sa le dierǝ we lo ru wǝǝ. Ǝkǝnǝŋ: «Abǝrahamǝ tɛ̀ɛ kpɛɛwǝ rǝ Worokoyǝ, wǝ́ Worokoyǝ ŋ fǝ̀ ŋwǝ ŋ yeli nyikʊʊyǝ rǝ na lɔnuŋrǝ kǝto.» Wǝ́ Worokoyǝ ŋ pwò ŋwǝ ǝkǝnǝŋ ne pwetaayǝ. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Nǝ ya nǝ nyáa nyɩŋ ǝkǝnǝŋ Worokoyǝ láa nyɩŋ mǝ ŋ ci ǝkǝnǝŋ nyiyǝ kʊʊ saŋ rǝ yǝ we lo otuyeeyǝ. Ŋkǝ saŋ rǝ yǝ we la lɔnuŋrǝ sɔŋ ko. <verse eid="JAS 2:24" /><verse number="25" style="v" sid="JAS 2:25" />Nǝ yɩrɩ Rahabǝ, nuŋruyeetǝyǝ sa rǝ paape, wǝ́ Worokoyǝ ŋ nyɩnɩ ŋwǝ mǝŋ nyikʊʊyǝ kǝtǝ saŋ rǝ no otuyeeyǝ kǝto. Lɔ̀ Isǝrayɛlǝ la akʊŋkpiitǝpǝ we lǝ kǝsǝǝkǝ. Pǝ pǝlǝ pǝ pe siri tǝŋtǝǝwǝ we ŋ ke kpii pǝ yɩrɩ. Wǝ́ ŋ lɛ̀ ŋ kanǝ pǝ la kʊŋpʊŋpwawǝ pǝ sùu pǝ pwɛ̀yɩ. <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Rǝkǝsa we, mǝŋ kǝ́ vǝ́ wɛɛnwanwarǝ lee kpii rǝ wɛlɛŋrǝ rɛ oturu wɛlɛŋrǝ we lǝ kpǝ́ we, kaa wǝǝ mǝŋ otuyeeyǝ yǝ laa kʊla mǝ lɔnuŋrǝ we, oturu lɔnuŋrǝ sa ŋre lǝ kpǝ́.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Nǝ ci nǝ kǝroŋfwɛɛkǝ le ere rǝ nǝ awɛɛlɩkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Lǝh ǝtǝŋ, enyipǝ wa pǝ pee yi rǝ nǝ mǝrǝ ǝkǝnǝŋ pǝ lah kaŋ otuyǝ. Kpiikǝ nǝ cii wǝ ǝkǝnǝŋ Worokoyǝ lah pa tɛŋ wǝkpaŋkpǝ mǝ lǝ ŋ teeri enyituturupǝ. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Kpiikǝ loh kpǝlo kpeŋkpeŋ yǝ la fɔ wǝ rǝ wǝlǝkpǝ kpookpoo mǝrǝ. Mǝŋ nyiyǝ rɛ lǝŋ farǝ nyuŋkpǝ rǝ na awɛɛlɩkǝ we, yǝ we lo to milimili, lóo koru na wɛ la ata re cocoroo. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Nǝ nyɩŋ re: Yǝ lée kpii oroopǝ la tʊkʊtuwǝ rǝ nyuŋkpǝ kǝ pǝ nya fɛɛ pǝ yɔ pǝla wɛ pǝ koonu lǝ kǝ lo koru asiɛrɩ pǝla wɛlɛŋrǝ eni ri ŋ ni mǝŋ kǝ́ wǝ ponu mǝ lǝ wǝ. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Nǝ yɩrɩ akpanǝŋwaayǝ re, mǝŋkǝ́ yǝ naanǝ wǝ́ ǝrǝfuŋmumuŋkǝ kǝ lóo tu yǝ paape we, tʊkʊtupiwǝ rɛ wǝ lée re rǝ mǝŋ kǝ́ caatǝyǝ we ŋ nǝ pǝ́ wǝ.<verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />Kaa wǝǝ kǝroŋfwɛɛkǝ kǝ ri wɛlɛŋrǝ lo gbuŋtupirǝ paape kǝ lǝ́ǝ kǝ otumumuŋyǝ. Nǝ nyɩŋ re! Naapʊrɛwǝ wǝ lóo tu koŋmumuŋwǝ la naa! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Kǝroŋfwɛɛkǝ ŋkǝ ŋkpɛ naawǝ rɛ wǝ́ kǝ ri. Kǝ ri ǝrǝkǝ rɛ kǝ lǝ lǝ mǝ oturɔɔrɔɔyǝ. Kǝroŋfwɛɛkǝ kǝ maarǝ mǝ okpuŋtututuruyǝ wǝ́ kǝ ya kǝ láa cɩɩrɩ wɛlɛŋrǝ kpǝlo kɩɩkɩ. Kǝ ya kǝ lóo tu vɔrʊrǝ la naa tɩpɩtɩpɩ. Kǝroŋfwɛɛkǝ la naawǝ we, naalaalɛɛwǝ wǝ wǝ ri. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Nyɩmaasɩyǝ lóo koru eri akɛɛpǝ lo yurǝ: Apɔɔkɛɛpǝ, ofuripǝ, akɛɛtiinipǝ mǝ akpanǝkɛɛpǝ. Wǝ́ kǝceece le ri pǝlo kpǝlo lo yurǝ. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Paa rɛ lǝǝ lǝmǝ okopiyǝ rǝ kǝroŋfwɛɛkǝ lo oŋuŋkǝ. Kǝroŋfwɛɛkǝ kǝ pǝlǝ wǝ́ kǝ lǝŋ kpɛɛ yiriri, kǝ lǝ lǝ mǝ wǝpwɛkpǝ wǝ láa wʊ nyɩmaasɩyǝ. <figure style="fig" alt="Le mors sur la bouche du cheval" file="hk00029c.tif" size="col" copy="Horace Knowles" ref="3:3">Tʊkʊtuwǝ we pǝ lée kpii oroopǝ rǝ nyuŋkpǝ kǝ pǝ nya fɛɛ pǝ yɔ pǝla wɛ wǝ</figure><verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />Ŋkǝ wǝ́ yǝ lǝ́ǝ fǝ yǝ ŋ kǝ Ǝtǝ Woroko, lǝh Tǝ. Wǝ́ ŋkǝ ke wǝ́ yǝ lǝ́ǝ fǝ yǝ ŋ fwɛɛrɩ anyɩmaasɩpǝ Worokoyǝ ŋ na yaa rǝ nǝ wǝlǝkpǝ. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Nyuŋkpǝ we wǝ lǝ́ǝ kǝ Worokoyǝ we, ŋkpǝ ke wǝ láa fwɛɛrɩ nyiyǝ. Lǝh ǝtǝŋ wǝ pǝǝ lǝ ǝnǝ. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Kǝto mɛŋfuŋpirǝ ŋrǝ ceŋceŋ lóo koru ewee mɛŋraŋwǝ mǝ mɛŋwǝ we wǝ lǝǝmǝ kaawǝ wǝ? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Lǝh ǝtǝŋ, wǝcookpǝ wǝ lǝŋ nyɩŋ ayɔpiyǝ. Rɛzɛŋyǝ lo guŋrǝ lǝŋ nyɩŋ ocootǝnǝyǝ. Pǝ lǝŋ tʊʊ mɛŋraŋwǝ rǝ fuŋpirǝ we lée wee tǝraŋmɛŋwǝ lǝ mǝrǝ.<verse eid="JAS 3:12" /></para>
  <para style="s">Nimisiewǝ we wǝ lo ru rǝ yulaarǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Mǝŋ rɛ sieni nimirǝ wǝ́ ŋ ci otuyǝ rǝ nǝ mǝrǝ we, yǝ we ŋ pɔrʊ wǝ ŋ kaŋ saŋ rǝ na vɔrʊceeceerǝ le etiikǝ, kǝ ŋ lɛ ŋ yee tu ri ŋ tu mǝ wɛɛpɛɛlɩwǝ we wǝ lo ru rǝ nimisiewǝ lǝ mǝrǝ wǝ. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Paa mǝŋ wǝtɛlɩrɔɔrɔɔkpǝ wǝ kpii rǝ nǝ, wǝ́ nyi ri ŋ nyi ŋ nǝ́ǝ pǝ́ na nɛŋwǝ ko wǝ poŋ we, nǝ paa nya faawǝ ǝkǝnǝŋ ŋnǝ nǝ sieni nimirǝ. Nǝ paa nia nǝ tɛɛ rǝ anʊkɔrǝyǝ. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Nimisiewǝ sa wǝ loo ru rǝ yulaarǝ, kǝtǝǝnɛŋwǝ wǝ lǝǝwe, kǝwɛlɛŋfwɛɛkǝ mǝ wɛɛrɔɔrɔɔrǝ la nɛŋ. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Kpiikǝ fɛɛwǝ we wǝtɛlɩkpǝ wǝ kpii wǝ́ nyɩmaasɩyǝ ŋ nǝ́ǝ pǝ́ na nɛŋwǝ ko lo opoŋkǝ we, atʊkpaatuyǝ mǝ oturɔɔrɔɔyǝ kpǝlo kɩɩkɩ yǝ kpii rǝ fɛɛwǝ we. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Nǝ nyǝŋ nyɩŋ kǝ́ yulaarǝ le nimisiewǝ wǝ lǝ wǝǝ: sǝsǝŋwǝ, wǝ lǝǝ lǝmǝ arɛɛyǝ. Wǝla kǝmaakǝ nyiyǝ we ŋ lǝǝmǝ nimisiewǝ sa we, taarǝ lɛrǝ, lǝŋ taa wǝkpaŋkpǝ, lóo nuŋ otuyǝ lo duturǝ, láa nyɩŋ nyiyǝ la tǝlarǝwǝ ŋpa, lée yee eceeceeyǝ ŋpa, lǝŋ yɩrɩ rǝ anyɩŋkǝ, wǝ́ loo suunu mǝrǝ. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Enyipǝ we pǝ ya pǝ lǝ́ǝ pǝ́ wǝtaarǝkpǝ we, ŋpǝ pǝ láa rʊʊ wǝtaarǝkpǝ. Vǝ́ wǝ le wi we, wǝ láa nyɩŋ ǝtǝnǝyǝ yǝ ri vɔrʊkʊʊrǝ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Enyipǝ we pǝ lǝǝ lǝmǝ ziɔŋrǝ jeŋceŋ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Kǝ́ wǝ lǝ́ǝ pǝ mǝ afiaakǝ mǝ akpaŋyǝ rǝ nǝ mǝrǝ wǝ? Kǝto ŋkǝ nǝ otucakpɛɛyǝ we yǝ kpii yǝ láa fia rǝ nǝ wɛlɛŋrǝ mǝrǝ yǝ ya yǝ lǝ́ǝ pǝ mǝ yǝ wǝ? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Nǝ ya nyáa mwɛɛrɩ otuyǝ le nimirǝ, paape nǝ nyǝŋ nya yǝ. Wǝ́ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ wʊ nyiyǝ. Nǝ ya nǝ nyée yee otuyǝ la wǝtɛlɩrɔɔrɔɔkpǝ paape yǝ lǝŋ fii nǝ akaakǝ, wǝ́ nǝ ya nǝ nyáa fia. Tuwǝ we nǝ ya nǝ nyáa taa we, nǝ nyaa nya wǝ, kpiikǝ nǝ nyǝǝ pǝ́ Worokoyǝ lǝ wǝ kǝto. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Nǝ ya nǝ nyǝ́ǝ pǝ́ tuwǝ, paape Worokoyǝ lǝŋ koonu nǝ wǝ, kpiikǝ nǝ nyǝ pǝ́ wǝ mǝ oyupurɔɔrɔɔyǝ, kǝ nǝ fǝ nǝ kpii nǝ wɛlɛŋrǝ lo otucakpɛɛyǝ la faawǝ ko fee wǝǝ. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Nǝ ri alakpatǝpǝ rǝ Worokoyǝ le enimiyǝ! Nǝ nyee ci wǝ ǝkǝnǝŋ yǝ we ŋ náa taa ǝrǝkǝ lǝ kǝǝwǝ lǝ kpǝlǝ Worokoyǝ lǝ kǝǝwǝ rǝ? Mǝŋ rɛ lǝ pǝ́ ŋ fǝ ǝrǝkǝ le wǝpwetaakpǝ we, yǝ we le yee Worokoyǝ lǝ kǝǝkpǝlǝtǝyǝ. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Nǝ pǝǝ kǝ wǝ ǝkǝnǝŋ tuŋtuŋ wǝ́ pǝ la ŋʊrʊ rǝ Worokoŋtierǝ ǝkǝnǝŋ: «Worokoyǝ lée yee wǝtɛlɩkpǝ mǝ ŋ koonu wɛɛrǝ we ŋ nǝ fǝ ŋ ne kpii rǝ lǝ mǝrǝ wǝ». <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Paape lɛsiɛrɩwǝ we Worokoyǝ ŋ ne yee ŋ no koonu lǝ we wǝ naanǝ wǝ teeri. Mǝŋ kǝ́ pǝ la ŋʊrʊ rǝ kǝworokoŋfwɛɛkǝ kǝtǝ ǝkǝnǝŋ: «Worokoyǝ le yi la tɛɛ rǝ enyipǝ we pǝ láa rɛɛrɩ mǝ pǝla wɛ, paa lée yee wǝceeceekpǝ mǝŋ koonu awɛɛpɛɛlɩtǝpǝ». <verse eid="JAS 4:6" /><verse number="7" style="v" sid="JAS 4:7" />Wǝ lo yurǝ kǝto nǝ pɛɛlɩ nǝ wɛ nǝ koonu Worokoyǝ kǝ nǝ yi nǝ tɛɛ rǝ satana kǝ ŋ nya fɛɛ ŋ suu rǝ nǝ kpǝŋ mǝ ŋ ko ciri ciri. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Nǝ ruu nǝ kǝlǝ mǝ Worokoyǝ, ŋwǝ ŋkpɛ lóo ruu ŋ kǝlǝ mǝ nǝ. Ŋnǝ oturɔɔrɔɔyeetǝpǝ, nǝ wii kǝ nǝ wɛɛ nǝ arɛɛyǝ nǝ co. Ŋnǝ epǝ we la ziɔŋrǝ lǝ sǝpǝ wǝ, nǝ yee mǝ nǝ ziɔŋrǝ kenikeni. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Nǝ nyɩŋ wǝ nǝ ci ǝkǝnǝŋ nǝ oturɔɔrɔɔyeeyǝ kǝto wǝ́ nǝ ya nǝ nyáa nyɩŋ ariaayǝ wǝ. Nǝ mǝ nʊmʊ kǝ nǝ mǝ wee! Nǝ amɔŋkǝ kǝ siɛrɩ kǝ yee anʊmʊkǝ, kǝ nǝ faawǝ wǝ siɛrɩ wǝ yee gʊpifiirǝ! <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Nǝ pɛɛlɩ nǝ wɛ rǝ Kulǝtǝyǝ la kǝnyɩŋkǝ, kǝ ŋ nya fɛɛ ŋ fǝ nǝ ŋ rɛɛrɩ.<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Lǝh ǝtǝŋ, nǝ paa mǝ wɛɛlɩ rɔɔrɔ nǝ mǝ ru rǝ awɛ. Yǝ we ŋ na wɛɛlɩ rɔɔrɔ ŋ no ru rǝ paanʊyǝ rɛ lo oŋuŋkǝ amaa ŋ na tɛŋ wǝkpaŋkpǝ mǝ na paanʊyǝ we, la wɛɛlɩ rɔɔrɔ lo ru rǝ Worokoyǝ le seyǝ wǝ́ ŋ na tɛŋ wǝkpaŋkpǝ mǝ seyǝ sa. Wǝ́ mǝŋ a la tɛŋ wǝkpaŋkpǝ mǝ Worokoyǝ le seyǝ we, ǝ lǝǝ tǝ e ri sesiimǝtǝyǝ. A la siɛrɩ e le yee na kpaŋtɛŋtǝyǝ. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Worokoyǝ ceŋceŋ ŋ née kpii seyǝ, ŋwǝ ke ŋ náa tɛŋ akpaŋyǝ. Lóo koru alɔ ŋ kuŋ nyiyǝ, ŋwǝ ke ŋ nóo koru nyiyǝ lǝ ǝnǝǝnǝ. Ŋlǝ́ e ri ǝlǝ kǝ atɛŋ lá kɛrɩyǝ la wǝkpaŋkpǝ wǝ?<verse eid="JAS 4:12" /></para>
  <para style="s">Epǝ we pǝ lée yee dukǝrǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Rǝkǝsa nǝ nuŋ, ŋnǝ epǝ we nǝ yaa nǝ nyáa tɛŋ ǝkǝnǝŋ: «Ruŋruŋ amaa sooso yǝ lóo ko tǝŋtǝǝwǝ sa ǝnǝ kǝ le ke tii cɛŋwǝ ceŋceŋ la saŋ ɖaasaŋrǝ kǝ la nya tǝtatɛɛwǝ». <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Paa nǝ nyee ci tuwǝ we wǝ lǝh pǝ sooso amaa kǝ́ nǝ vɔrʊrǝ lǝh pǝ lǝ wǝ. Nǝ lǝ rǝ mǝŋ dusiirǝ kǝtǝ, lée sii rǝ enipiyǝ rɛ lǝ mǝrǝ ko oturu le celi. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Nǝ kah mǝ tɛŋ ǝkǝnǝŋ: «Mǝŋ Ǝtǝ Woroko la tɛɛnɩ, wǝ́ yǝ lée tii vɔrʊrǝ we, yǝ lée yee tuwǝ sa ǝnǝ amaa wǝ eni». <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Paa rǝkǝsa nǝ ya nǝ nyáa ca turuwǝ nyǝ ŋ rɛɛrɩ mǝ nǝ wɛ, wɛɛrɛɛrɩmǝwǝ sa wǝrʊʊkpǝ we, wǝ loo poŋ. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Kǝto yǝ we ŋ cii kǝ pǝ lée yee tuceeceewǝ, wǝ́ ŋ nǝŋ yee wǝ we, wǝ ri rǝ turɔɔrɔɔwǝ wǝ koonu ŋwǝ.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Pǝ le ci pǝ la kaŋ asɩkalǝtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Ŋnǝ asɩkalǝtǝpǝ, nǝ nuŋ rǝkǝsa! Nǝ mǝ wee, nǝ ca opupuyǝ duturǝ ɖi ariaayǝ yǝ lǝh pǝ yǝ po tu nǝ. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Nǝ otulǝmǝmumuŋyǝ we kpǝlo kɩɩkɩ yǝ lǝ pǝlǝ, wǝ́ zaŋrǝ lo wo nǝ wǝkpakpǝ. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Nǝ sɩkayǝ, mǝ nǝ sɩka kpɛɛlɩyǝ la kpɛɛ ɖaarǝrǝ. Jirǝ we Worokoyǝ ŋ náa tɛŋ akpaŋyǝ we, ɖaarǝrǝ sa leh ke ri ɖaŋsieyǝ dɛɛ rǝ nǝ. Kpiikǝ nǝ nyǝǝ fǝ nǝ otulǝmǝyǝ sa nǝ yee kǝnǝnɛceeceekǝ. Ɖaarǝrǝ sa lée ri nǝ wɛlɛŋrǝ mǝŋ kǝ́ naawǝ wǝ lée yee tuwǝ kǝtǝ. Ǝrǝkǝ kǝ lǝh pǝ kǝ pa lɛ paape nǝ nya kʊʊ asɩkatuyǝ nǝ nyǝ tǝnǝ. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Nǝ nyaa mwara apaalǝtǝpǝ we pǝ la kpɛŋ nǝ wǝtɛɛkpǝ wǝ́ pǝ la lɛ nǝ atɛɛtɛɛtuyǝ pǝ lo koonu nǝ wǝ. Nǝ nuŋ kǝ́ pǝ ya pǝ láa ca opupuyǝ re! Wǝ́ pǝlo opupuyǝ sa yǝ la ka tɔɔ Ǝtǝ Woroko Kopilǝtǝyǝ lo otukoŋyǝ. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Nǝ nye ri vɔrʊrǝ rǝ kǝtǝǝwǝ nǝ nyaa sʊʊ naawʊrǝ. Nǝ nya tɔɔ wǝpɔŋkpǝ mǝŋ kɛɛyǝ pǝ la yɩrɩ yurǝ sɩsiɛrɩ pǝ lǝ tǝnǝ pǝ pa wʊ kǝtǝ. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Nǝ nya tɔɔ nyikʊʊyǝ la bɔrǝ, wǝ́ nǝ nya wʊ ŋwǝ, lee yee okopiyǝ mǝ nǝ.<verse eid="JAS 5:6" /></para>
  <para style="s">Nǝ taarǝ lɛrǝ, Kulǝtǝyǝ Yesu lo furu</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Kǝto we mǝ apaanʊpǝ, nǝ nya lɛtaarǝwǝ ko ro jirǝ we Kulǝtǝyǝ Yesu ŋ nǝh pǝ wǝ. Nǝ yɩrɩ tɛɛtɛɛkpɛŋtǝyǝ re! Láa taarǝ lɛrǝ mǝ ŋ rǝŋ na atɛɛtɛɛtuceeceeyǝ ŋ nah nya ŋ ru rǝ kǝtǝǝwǝ wǝ. Lǝ́ǝ rǝŋ ŋʊŋtɛsǝsǝŋyǝ ŋ pǝ kǝ ŋ nya fɛɛ ŋ rʊ otuyǝ. Lǝ́ǝ tǝ mǝ ŋ rǝŋ ŋʊŋtɛtǝtǝǝlǝyǝ kǝ na atɛɛtɛɛtuyǝ yǝ fii epiyǝ kǝ yǝ kuru. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Ŋnǝ ŋkpɛ nǝ nya lɛtaarǝwǝ kǝ nǝ ta nǝ wɛ lo turuwǝ, kpiikǝ Kulǝtǝyǝ Yesu lǝ ǝpǝkǝ kǝ lǝ kǝlǝ.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Lǝh ǝtǝŋ, nǝ paa ca awɛ la cwɩɩwǝ kǝ Worokoyǝ ŋ paa tɛŋ wǝkpaŋkpǝ mǝ nǝ. Nǝ nyɩŋ re, kpaŋtɛŋtǝyǝ yaa rǝ guŋpolurǝ. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Lǝh ǝtǝŋ nǝ taalǝ oworokokpɛɛnuŋtɛŋtǝpǝ we pǝ ka ŋ wɛɛlɩ rǝ Ǝtǝ Woroko la nyɩŋrǝ wǝ, pǝ nyɩnɩ ariaayǝ paape pǝ nya lɛtaarǝwǝ. Pǝlǝ wǝlǝkpǝ sa wǝ ri tufǝcamǝwǝ wǝ koonu nǝ. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Nǝ yɩrɩ re, yǝ lóo pwo epǝ we pǝ la ta pǝla wɛ lo turuwǝ rǝ arianyɩŋyǝ mǝrǝ ǝkǝnǝŋ enyipɛɛrɩpǝ. Nǝ nyo nuŋ pǝ la tɛŋ Yɔbǝ la atɔyaakǝ le dierǝ pǝ le tíi nǝ. Wǝ́ nǝ nya nyɩŋ otukpatɩyǝ we Ǝtǝ Woroko ŋ pǝlǝ ŋ kòonu ŋwǝ ŋ tǝ̀ǝlǝ wǝ. Kpiikǝ Ǝtǝ Woroko láa nyɩŋ nyiyǝ la tǝlarǝwǝ wǝ́ ŋ nóo fuu mǝ ŋ kuŋ nyiyǝ. <verse eid="JAS 5:11" /><verse number="12" style="v" sid="JAS 5:12" />Lǝh ǝtǝŋ, tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ kaamǝ wǝ ǝnǝ: nǝ poo tu tǝrɛ, mǝŋ yulaarǝ, mǝŋ kǝtǝǝwǝ amaa tupʊŋpwawǝ rɛ. Paa we, mǝŋ nǝ nya nyɩŋ tǝrɛ wǝ kpɛɛlɩ rǝ we, nǝ tɛŋ ǝkǝnǝŋ wǝ kpɛɛlɩ, wǝ́ mǝŋ nǝ nya nyɩŋ tǝrɛ wǝ mwɛɛrɩ rǝ we nǝ tɛŋ ǝkǝnǝŋ wǝ mwɛɛrɩ kǝ Worokoyǝ ŋ paa tɛŋ nǝ wǝkpaŋkpǝ.<verse eid="JAS 5:12" /></para>
  <para style="s">Nǝ mwɛŋ nyuŋkpǝ nǝ koonu awɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Mǝŋ nǝ rɛ kpii rǝ arianyɩŋyǝ we, yǝ we ŋ mwɛŋ nyuŋkpǝ. Mǝŋ rɛ ya láa nya faawǝ we, yǝ we ŋ nɔŋ ŋ kǝ Worokoyǝ. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Mǝŋ nǝ rɛ laa kpaa we, yǝ we ŋ pwo na zʊmarǝ lo omumuŋpǝ kǝ pǝ pa mwɛŋ nyuŋkpǝ pǝ koonu ŋwǝ kǝ pǝ nuŋ na apɔŋpǝ rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Mǝŋ pǝ la mwɛŋ nyuŋkpǝ, wǝ́ pǝ la lɔ pǝ lo nuŋ ǝkǝnǝŋ Kulǝtǝyǝ láa cá ŋwǝ we, yǝ we láa kpaa. Wǝ́ mǝŋ le yee oturɔɔrɔɔyǝ rɛ we, Kulǝtǝyǝ lǝ́ǝ fǝ ŋ cɛɛ ŋwǝ. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Kǝto we, nǝ mǝ tɛŋ nǝ oturɔɔrɔɔyǝ nǝ mǝ tíi awɛ, nǝ mwɛŋ nyuŋkpǝ nǝ koonu awɛ, kǝ nǝ nya fɛɛ nǝ kpaa. Nyikʊʊyǝ lo nyuŋmwɛŋwǝ wǝ lǝǝmǝ okopiyǝ ŋpa, wǝ́ wǝ lée yee kǝnǝnɛkǝ. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Worokokpɛɛnuŋtɛŋtǝyǝ Eliya ke ri nyɩmaasɩyǝ mǝŋ lǝ kǝtǝ. Wǝ́ ŋ mwɛnɩ nyuŋkpǝ mǝ wɛɛlɛŋwǝ ǝkǝnǝŋ ŋʊŋtɛyǝ ŋ pǝǝ pǝ. Wǝ́ kǝceece ǝrǝkǝ kǝ yili cɛŋwǝ ta mǝ akɛɛnyɔŋpǝ akʊraŋ. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Wǝ́ ŋ tǝ ŋ mwɛnɩ nyuŋkpǝ kpɛŋ wǝ́ Worokoyǝ ŋ ci okoonu ŋʊŋtɛyǝ ŋ pǝlǝ. Wǝ́ otuyǝ yǝ ci ǝtǝ yǝ ka ŋ nyɩŋ rǝ wǝtɛɛkpǝ.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Lǝh ǝtǝŋ, mǝŋ rɛ rǝ nǝ mǝrǝ lo ru la cɛ rǝ anʊkɔrǝyǝ lǝ kpǝŋ wǝ́ nyipʊŋpwayǝ rɛ ŋ na siɛnɩ mǝ ŋwǝ ŋ nǝ pǝ we, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />nǝ ci wǝ ǝkǝnǝŋ nyɩmaasɩyǝ we ŋ na siɛnɩ mǝ turɔɔrɔɔyeetǝyǝ rǝ na kʊŋrɔɔrɔɔwǝ we, la pɔrʊ yǝ we la vɔrʊrǝ lo ru rǝ gbɛŋrǝ. Wǝ́ ŋ no kuŋ kǝ Worokoyǝ ŋ fǝ turɔɔrɔɔyeetǝyǝ sa lo oturɔɔrɔɔyǝ ŋ cɛɛ ŋwǝ. Worokoyǝ lǝŋ tǝ ŋ pa taalǝ yǝ.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>