<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">Akebou: La Bible en akebou</book>
  <para style="h">3 Yowanɛsɩ</para>
  <para style="toc3">3Yo</para>
  <para style="toc2">3 Yowanɛsɩ</para>
  <para style="toc1">Yowanɛsɩ la kǝfwɛɛtatǝkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Yowanɛsɩ</para>
  <para style="mt2">la kǝfwɛɛtatǝkǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Yowanɛsɩ la kǝfwɛɛtatǝkǝ we ŋ na ŋʊrʊ kǝ kaamǝ gǝ ǝnǝ. La ŋʊrʊ kǝ la maŋ zʊmarǝ lo mumuŋyǝ rɛ pǝ lóo pwo Gayo mǝ eniyǝ we Demetio ŋ ko ŋ ko ŋ ka tɛŋ Worokoŋtierǝ rǝ gaarǝ we. Demetio ke ri worokoŋtietɛŋtɛlɩtǝyǝ. Zʊmarǝ lo mumuŋpʊŋpwayǝ rɛ pǝ lóo pwo Diotɛrɛfʊ ke kpii rǝ Gayo la zʊmarǝ we. Ŋwǝ Diotɛrɛfʊ lǝǝ kǝ ŋ kǝ Yowanɛsɩ mǝ ŋ kpii rǝ tǝrɛ. Laa ka ŋ tɛɛnɩ mǝŋ lɔ oworokoŋtietɛŋtǝpǝ lǝ kǝsǝǝkǝ, wǝ́ ŋ ka ŋ lɛ mǝ ŋ sǝŋ gʊŋrǝ mǝ ŋ koonu alɔnuŋtǝtuturupǝ ŋpǝ ŋkpɛ pǝ paa mǝ lɔ pǝ lǝ kǝsǝǝkǝ, wǝ́ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ mǝŋ rɛ la lɔ pǝ lǝ kǝsǝǝkǝ we, ŋ née piri ŋwǝ rǝ zʊmarǝ. Fɛɛwǝ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ ceeni Gayo ŋ manǝ mǝ nǝ kǝsǝǝlɔkǝ, kǝ ŋ lɛ ŋ wɛɛlɩ ŋ ru rǝ Diotɛrɛfʊ lǝ wǝlǝkpǝ we ŋ ya ŋ née re wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1-4</para>
  <para style="io">- Yowanɛsɩ lǝ kǝ Gayo wǝ́ ŋ ne kpii no okopiyǝ 5-8</para>
  <para style="io">- Pǝ la tɔɔ Diotɛrɛfʊ la bɔrǝ 9-10</para>
  <para style="io">- Yowanɛsɩ lǝ kǝ Demetio 11-12</para>
  <para style="io">- Eceenituturukǝ 13-15</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Ŋmǝ zʊmarǝ lo mumuŋyǝ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ́ na maŋ ŋlǝ́ Gayo mǝ kǝǝtaatǝyǝ. Ŋ́ náa taa lǝ́ kǝǝwǝ rǝ anʊkɔrǝyǝ. <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />Mǝ kǝǝtaatǝyǝ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ tu ri ŋ tu wǝ poŋ wǝ koonu lǝ́ sɩsiɛrɩ, kǝ a lɛ e tii purupuru mǝŋ kǝ́ e tini purupuru rǝ wɛɛrǝ la kǝtakǝ kǝtǝ. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Apaanʊpǝ rɛ pǝ pǝlǝ pǝ wɛ̀ɛlɩ pǝ rù rǝ anʊkɔrǝyǝ we yǝ kpii rǝ lǝ́ mǝrǝ mǝ kǝ́ a ya lée tii vɔrʊrǝ rǝ anʊkɔrǝyǝ mǝrǝ wǝ. Wǝ́ ŋ́ nyà faawǝ ŋpa. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Tǝrɛ wǝ lee kpii wǝ lóo koonu mǝ faawǝ wǝ ŋ teeri kǝ́ ŋ́ no nuŋ ǝkǝnǝŋ mǝ epipǝ pǝ ya pǝ lée tii vɔrʊrǝ rǝ anʊkɔrǝyǝ mǝrǝ wǝ.<verse eid="3JN 1:4" /></para>
  <para style="s">Yowanɛsɩ lǝ kǝ Gayo wǝ́ ŋ ne kpii no okopiyǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Mǝ kǝǝtaatǝyǝ, a ya lée ri anʊkɔrǝyǝ rǝ otuyǝ we kpǝlo a ya e lée yee o mǝ ŋ koonu apaanʊpǝ mǝ apaatɛpǝ wǝ ke ce wǝ ri e lee ci pǝ wǝ. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Pǝ le ri ɖaŋsieyǝ ru rǝ kǝ́ a la taa pǝlǝ kǝǝwǝ rǝ asʊmatǝpǝ la wǝcakukpǝ we la kǝnyɩŋkǝ. Ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ lǝ́ kǝ o toŋ pǝ rǝ pǝla gʊŋsaŋrǝ sa mǝŋ kǝ́ wǝ lóo koru o poŋ mǝ Worokoyǝ wǝ. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Duturǝ ɖi Kǝriso la nyɩŋrǝ kǝto wǝ́ pǝ le yi pǝ ya pǝ láa saŋ gʊŋrǝ sa wǝ. Wǝ́ pǝ laa lɛ pǝ tɛɛnɩ pǝ lɔ tǝrɛ rǝ epǝ we pǝ lee ci Worokoyǝ lǝ kpǝŋ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Kǝto we, wǝ kaamǝ kǝ ŋlǝ paa lo toŋ ŋpǝ enyipǝ sa kǝtǝŋkǝ, o lóo turu ŋla ŋkpɛ la ya yǝ lée yee anǝnɛyǝ yǝ ŋ kʊla mǝ pǝ rǝ anʊkɔrǝyǝ we la anǝnɛyǝ.<verse eid="3JN 1:8" /></para>
  <para style="s">Diotɛrɛfʊ mǝ Demetio</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ŋ́ na ŋʊrʊ kǝfwɛɛpikǝ rɛ ŋ́ na maŋ nǝ wǝcakukpǝ we. Paape Diotɛrɛfʊ lǝǝ kǝ mǝ ŋ kpii rǝ tǝrɛ, duturǝ ɖi lǝ́ǝ pǝ́ ŋwǝŋwǝ mǝ ŋ lɔ rǝ kǝnyɩŋkǝ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Kǝto vǝ́ ŋ́ nǝ pǝ pǝ we, ŋ́ náa pɔrʊ otuyǝ we ŋ ya ŋ née yee ŋ́ tɛŋ. Ŋwǝ ŋ ya ŋ náa wɛɛlɩ onyuŋsusutǝtieyǝ mǝ ŋ tɛɛ rǝ lǝ wǝ. Wǝ laa kpaa rǝ we, lǝ́ǝ sǝ́ŋ lǝŋ lɔ apaanʊpǝ we pǝ lah tɛlɩ lǝ kǝsǝǝkǝ. Wǝ́ ŋ náa lɛ mǝ ŋ sǝŋ gʊŋrǝ mǝ ŋ koonu epǝ we pǝ lǝ́ǝ pǝ́ pǝ ŋ lɔ pǝlǝ kǝsǝǝkǝ wǝ. Lée kpii pǝ lo vurǝ ǝkǝnǝŋ mǝŋ pǝ la lɔ pǝlǝ kǝsǝǝkǝ we, ŋ née piri pǝ rǝ asʊmatǝpǝ la wǝcakukpǝ sa.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Mǝ kǝǝtaatǝyǝ, paa karǝ rɛ lo turɔɔrɔɔwǝ e yee. Paa we, karǝ rǝ ceeceewǝ bomu. Yǝ we ŋ née yee tuceeceewǝ we, ri rǝ Worokoyǝ le nyiyǝ. Paa yǝ we ŋ née yee turɔɔrɔɔwǝ we, lee ci Worokoyǝ. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Nyi ri ŋ nyi láa tɛŋ Demetio le dieceeceerǝ. Anʊkɔrǝyǝ we yǝ kpii rǝ nǝ mǝrǝ yǝ la pɔrʊ yǝ la kaŋ ǝkǝnǝŋ ri nyiceeceeyǝ. Ŋla ŋkpɛ la ya yǝ lée ri ɖaŋsieyǝ ru rǝ ŋwǝ ǝkǝnǝŋ nyiceeceeyǝ wǝ́ ŋ ri, wǝ́ e cii wǝ ǝkǝnǝŋ lah ɖaŋsieyǝ sa we, anʊkɔrǝyǝ yǝ lǝǝwe.<verse eid="3JN 1:12" /></para>
  <para style="s">Eceenituturukǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ŋ́ tǝ ŋ́ lǝǝmǝ otuyǝ ŋpa ŋ́ née tíi lǝ́. Paape ŋ́ nǝŋ ŋʊrʊ yǝ ŋ́ kpii rǝ kǝfwɛɛkǝ ŋ́ maŋ lǝ́ rǝ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ŋ́ ya ŋ́ nǝ́ǝ rǝŋ ŋlǝ mǝ lǝ́ lo po ku rǝ enipiyǝ rɛ la kǝmaakǝ, kǝ la pa nya fɛɛ la tɛɛrɩ niminimi. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Ŋ́ nǝ pǝ́ wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ lǝ́. Lé epwetapǝ we pǝ lée ceeni lǝ́. Ŋ́ née ceeni leh epwetapǝ we yǝ ri ŋ yǝ.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>