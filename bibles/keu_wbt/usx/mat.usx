<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">Akebou: La Bible en akebou</book>
  <para style="h">Matewu</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matewu</para>
  <para style="toc1">Matewu le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="mt1">Matewu</para>
  <para style="mt2">le Dieceeceerǝ we ŋ na ŋʊrʊ wǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Matewu ŋ na ŋʊrʊ Dieceeceerǝ sa. Yesu le enyikpiipǝ we le ceŋceŋ ŋ lǝǝwe. Ŋʊ̀rʊ Dieceeceerǝ sa kòonu Oyudatǝpǝ we pǝ la siɛrɩ pǝ le yee ekǝrisotǝpǝ wǝ. Rǝ kǝfwɛɛkǝ sa mǝrǝ we, Matewu la pɔrʊ la kaŋ ǝkǝnǝŋ Yesu ŋ ri Piliyǝ we mǝ Lɔkuŋtǝyǝ we Worokoyǝ ŋ cò nǝ kǝkpǝŋkǝ la garǝ wǝ. Worokoyǝ le yee otuyǝ we kpǝlo ŋ cò garǝ la saŋ rǝ Yesu. Matewu la wɛɛlɩ lo ru rǝ Yesu lǝ ǝtǝtǝpǝ, Yesu lǝ ǝmǝkǝ, na kǝlaatiekǝ, no worokomɛŋwiiriwǝ, Yesu le etieyɩrɩkǝ, Yesu la anǝnɛyǝ rǝ Galileya (kanǝ otuyǝ wǝ́ ŋ cà anyaatǝpǝ), wǝ́ ŋ ci ǝpǝlǝ ŋ ko ŋ ko Yerusalɛmǝ kǝ ŋ kǝ kpǝ́, kǝ juutatǝrǝ ŋ saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ. La lɛ la wɛɛlɩ lo ru rǝ Yesu lo otukaŋyǝ rǝ tɛɛ rǝ tɛɛ: Yesu la awɛɛlɩkǝ rǝ dutupirǝ, fɛɛwǝ ŋ kanǝ no otukarǝtǝpǝ kǝ́ pǝ lée tii vɔrʊrǝ pǝ fǝ wǝ (Matewu 5-7). Yesu le ci la kaŋ no otukarǝtǝpǝ we pǝ loh ko pǝ ka tɛŋ Dieceeceerǝ we pǝ tɛlɩ wǝ (Matewu 10). Yesu la kaŋ tuwǝ yulaarǝ le wǝpilirikpǝ we wǝ ri saŋ rǝ otutucayǝ (Matewu 13). Kǝ́ Kǝriso lǝ kǝkpǝŋkǝ kǝ lée re awɛ kǝ fǝ rǝ kǝtǝǝwǝ sa wǝ (Matewu 18). Kǝ́ pǝ lǝ́ǝ rǝŋ yulaarǝ lo yuritutururǝ we pǝ fǝ wǝ (Matewu 24-25). Dieceeceerǝ sa lee ri Oyudatǝpǝ ceŋceŋ la nɛŋ, gbii goonu wǝkpǝŋkpǝ kpǝlo rǝ kǝtǝǝwǝ (Matewu 28:19-20). Wǝ la nyɩnɩ rǝ Matewu la kǝfwɛɛkǝ sa ǝkǝnǝŋ Yesu ŋ ri Kulǝtǝyǝ we ŋ nǝh pǝ ŋ pe tie mǝ ǝrǝŋwɛŋkǝ we rǝ Yulaarǝ wǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Yesu lǝ ǝtǝtǝpǝ mǝ nǝ ǝmǝkǝ 1:1–2:23</para>
  <para style="io">- Yowanɛsɩ worokomɛŋwiiritǝyǝ we la kǝnǝnɛkǝ 3:1-12</para>
  <para style="io">- Yesu lo worokomɛŋwiiriwǝ mǝ ne etieyɩrɩkǝ 3:13–4:11</para>
  <para style="io">- Yesu la anǝnɛyeeyǝ rǝ enyikpǝlo la kǝnyɩŋkǝ rǝ Galileya 4:12–18:35</para>
  <para style="io">- Yesu la gʊŋsaŋrǝ ru rǝ Galileya ko Yerusalɛmǝ 19:1–20:34</para>
  <para style="io">- Yesu le ecituturuyǝ coŋ koonu nǝ ǝkpǝ́kǝ 21:1–27:66</para>
  <para style="io">- Yesu la assaanǝkǝ mǝ na wɛ la apɔrʊkaŋkǝ 28:1-20</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Yesu lǝ ǝtǝtǝpǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Yesu Kǝriso lǝ ǝtǝtǝpǝ la anyɩŋyǝ yǝ kaamǝ ǝyǝ ǝnǝ: Yesu lǝ tǝtǝtǝtǝyǝ ŋ kaamǝ Davidǝ. Wǝ́ Davidǝ lǝ tǝtǝtǝtǝyǝ ŋ kaamǝ Abǝrahamǝ.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Abǝrahamǝ ŋ mǝnǝ Isakǝ, wǝ́ Isakǝ ŋ mǝnǝ Yakɔbǝ. Yakɔbǝ ŋ mǝnǝ Yuda mǝ na apaanʊpǝ. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Wǝ́ Yuda ŋ mǝnǝ Farɛsɩ mǝ Zara, pǝle lee ŋ kaamǝ Tamarǝ. Farɛsɩ ŋ mǝnǝ Ɛsǝrɔŋ wǝ́ Ɛsǝrɔŋ ŋ mǝnǝ Aramǝ. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aramǝ ŋ mǝnǝ Aminadabǝ, wǝ́ Aminadabǝ ŋ mǝnǝ Nasɔŋ. Nasɔŋ ŋ mǝnǝ Salǝmɔ, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />wǝ́ Salǝmɔ ŋ mǝnǝ Bowazǝ. Bowazǝ le lee ŋ kaamǝ Rahabǝ. Bowazǝ ŋ mǝnǝ Obɛdǝ. Obɛdǝ le lee ŋ kaamǝ Rutǝ. Wǝ́ Obɛdǝ ŋ mǝnǝ Yese. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yese ŋ mǝnǝ piliyǝ Davidǝ.</para>
  <para style="p" vid="MAT 1:6">Wǝ́ Davidǝ ŋ mǝnǝ Salomo. Salomo le lee ŋ kaamǝ Uri le tie. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Wǝ́ Salomo ŋ mǝnǝ Robowamǝ, Robowamǝ ŋ mǝnǝ Abiya. Wǝ́ Abiya ŋ mǝnǝ Asafǝ. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asafǝ ŋ mǝnǝ Yosafatǝ, wǝ́ Yosafatǝ ŋ mǝnǝ Yoramǝ. Yoramǝ ŋ mǝnǝ Oziasǝ, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />wǝ́ Oziasǝ ŋ mǝnǝ Yotamǝ. Yotamǝ ŋ mǝnǝ Ahazǝ, wǝ́ Ahazǝ ŋ mǝnǝ Ezekiasǝ. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ezekiasǝ ŋ mǝnǝ Manase, wǝ́ Manase ŋ mǝnǝ Amonǝ, wǝ́ Amonǝ ŋ mǝnǝ Yoziasǝ. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yoziasǝ ŋ mǝnǝ Yekonia mǝ na apaanʊpǝ. Eniyǝ we wǝ́ pǝ lɔ̀ Isǝrayɛlǝtǝpǝ pǝ kolu ɖɔŋpirǝ rǝ Babilonia. <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Kǝ́ pǝ la lɔ Isǝrayɛlǝtǝpǝ pǝ lo ko ɖɔŋpirǝ rǝ Babilonia la kǝmaakǝ we, wǝ́ Yekonia ŋ mǝnǝ Salatiɛlǝ. Salatiɛlǝ ŋ mǝnǝ Zorobabɛlǝ, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />wǝ́ Zorobabɛlǝ ŋ mǝnǝ Abiwudǝ, wǝ́ Abiwudǝ ŋ mǝnǝ Eliakimǝ. Eliakimǝ ŋ mǝnǝ Asɔrǝ, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />wǝ́ Asɔrǝ ŋ mǝnǝ Sadɔkǝ. Sadɔkǝ ŋ mǝnǝ Akimǝ, wǝ́ Akimǝ ŋ mǝnǝ Eliwudǝ. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliwudǝ ŋ mǝnǝ Eleazarǝ, wǝ́ Eleazarǝ ŋ mǝnǝ Matanǝ. Matanǝ ŋ mǝnǝ Yakɔbǝ, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />wǝ́ Yakɔbǝ ŋ mǝnǝ Yosɛfʊ. Yosɛfʊ le tie ŋ kaamǝ Marɩya yǝ we ŋ mǝnǝ Yesu pǝ lóo pwo Kǝriso wǝ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Kǝto fǝ rǝ Abǝrahamǝ pa kpaa rǝ Davidǝ we, yǝ lǝ́ǝ kǝ wǝmǝkpǝ tǝ mǝ wǝniǝ. Fǝ rǝ Davidǝ fǝ pǝ eniyǝ we pǝ lɔ̀ Isǝrayɛlǝtǝpǝ pǝ kolu ɖɔŋpirǝ rǝ Babilonia we, yǝ lǝ́ǝ kǝ wǝmǝkpǝ tǝ mǝ wǝniǝ. Fǝ rǝ Isǝrayɛlǝtǝpǝ la ɖɔŋpirǝ sa fǝ pǝ Kǝriso lǝ ǝmǝkǝ we, yǝ lǝ́ǝ kǝ wǝmǝkpǝ tǝ mǝ wǝniǝ.<verse eid="MAT 1:17" /></para>
  <para style="s">Yesu lǝ ǝmǝkǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />A lǝŋ nyɩŋ kǝ́ pǝ mǝnǝ Yesu Kǝriso pǝ fǝ̀ wǝ: Yesu le lee Marɩya we, ke ri Yosɛfʊ le tietɔɔyǝ. Paape kpɛŋ kǝ pǝ pǝ fǝ awɛ pǝ lɔ pǝ ke tii fɛɛceŋceŋ we, anyɩŋ Marɩya le re wǝkulukpǝ saŋ rǝ Wɛɛkenikenirǝ lo okopiyǝ. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />No nuŋ Yosɛfʊ ŋ ke ri nyikʊʊyǝ we, lǝǝ pǝ́ ŋ kpii Marɩya le kǝyepukǝ rǝ enyipǝ mǝrǝ. Wǝ́ ŋ tɛnɩ rǝ nǝ mǝrǝ ǝkǝnǝŋ ŋ nǝ́ǝ sǝrǝ mǝ ŋwǝ paape ŋ nǝŋ saarǝ ŋwǝ. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Eniyǝ we ŋ ya ŋ nóo pu tuwǝ sa lo yurǝ we, wǝ́ Ǝtǝ Woroko le picoŋpiyǝ rɛ ŋ pǝlǝ ŋ rù rǝ ŋwǝ rǝ kǝtʊkpɛɛkǝ. Wǝ́ picoŋpiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yosɛfʊ, Davidǝ le pilepi, poo suu vurǝ ǝkǝnǝŋ ŋlǝ́ ǝ fǝ Marɩya a lɔ wǝtiekpǝ. Duturǝ ɖi le re wǝkulukpǝ sa saŋ rǝ Wɛɛkenikenirǝ lo okopiyǝ. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Lǝ́ǝ mǝ bǝrǝŋpirǝ, kǝ e kpii na nyɩŋrǝ Yesu<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Yesu lo duturǝ ɖi Ǝtǝ Woroko ŋ ri Lɔkuŋtǝyǝ. </char></note> duturǝ ɖi ŋwǝ ŋ nah pa pɔrʊ nǝ kǝkpǝŋkǝ ŋ ru rǝ pǝlo oturɔɔrɔɔyǝ mǝrǝ.»<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Otuyǝ sa kpǝlo kɩɩkɩ yǝ pǝlǝ ǝnǝ kǝ Ǝtǝ Woroko le dierǝ we ŋ tɛnɩ ŋ sanǝ rǝ worokokpɛɛnuŋtɛŋtǝyǝ lo oŋuŋkǝ we, nya fɛɛ bǝ.<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />Ǝkǝnǝŋ: «Yɩrɩ re, kɔrʊyǝ rɛ ŋ nee ci pǝrǝŋyǝ lée re, kǝ ŋ mǝ bǝrǝŋpirǝ.</para>
  <para style="q1" vid="MAT 1:23">Pǝ loh mǝ pwo ŋwǝ Emaniɛlɩ»,</para>
  <para style="q1" vid="MAT 1:23">wǝlo duturǝ ɖi Worokoyǝ kpii mǝ lǝ.<verse eid="MAT 1:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 1:24" />Kǝ́ Yosɛfʊ ŋ na saanǝ we, wǝ́ ŋ yeli mǝŋ kǝ́ Ǝtǝ Woroko le picoŋpiyǝ we ŋ tìi ŋwǝ kǝtǝ. Wǝ́ ŋ fǝ Marɩya ŋ lɔ̀ wǝtiekpǝ. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Paape laa pa kpɛɛ mǝ ŋwǝ ŋ nyɩŋ wǝ́ Marɩya ŋ pǝlǝ ŋ mǝnǝ piyǝ we rǝ! Mǝnǝ bǝrǝŋpirǝ, wǝ́ Yosɛfʊ ŋ kpìi piyǝ we la nyɩŋrǝ ǝkǝnǝŋ Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Otucitǝpǝ pǝ lǝ pǝ pǝ pa sʊma Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Pǝ mǝnǝ Yesu rǝ Bɛtǝlɛhɛmǝ rǝ Yudeya lǝ kǝtǝǝwǝ, eniyǝ we Erodɛsɩ ŋ ke tini zaarǝ rǝ Yudeya. Kǝ́ pǝ lǝ mǝ Yesu we, wǝ́ otucitǝpǝ rɛ pǝ la karǝ otuyǝ pǝ lo ru rǝ wǝŋɔŋkpǝ pǝ rù rǝ kǝcɔkɔŋpoŋkǝ la gaarǝ pǝ pǝlǝ Yerusalɛmǝ lǝ tǝŋtǝǝwǝ. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Wǝ́ pǝ pǝ̀ enyipǝ ǝkǝnǝŋ: «Kǝ la nyɩŋ piyǝ we pǝ lǝ mǝ ŋ ri Oyudatǝpǝ le piliyǝ wǝǝ? Yǝ la nyɩŋ na kǝŋɔŋkǝ kǝ la nyɩnɩ rǝ kǝcɔkɔŋpoŋkǝ, wǝ́ yǝ lǝ pǝ la pa sʊma ŋwǝ.» <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Kǝ́ piliyǝ Erodɛsɩ ŋ no nuŋ tuwǝ sa we, wǝ́ ŋ fìi kǝǝnǝwǝ ŋpǝ mǝ Eyerusalɛmǝtǝpǝ kpǝlo kɩɩkɩ. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Wǝ́ piliyǝ Erodɛsɩ ŋ kù mǝ Oyudatǝpǝ lo otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ kǝ ŋ pǝ́ fɛɛwǝ we pǝ tɛnɩ pǝ lǝh pǝ mǝ Kǝrisoyǝ we wǝ. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Rǝ Bɛtǝlɛhɛmǝ rǝ Yudeya la gaarǝ, kpiikǝ kpɛɛnuŋtɛŋtǝyǝ la ŋʊrʊ ǝkǝnǝŋ:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“Ŋlǝ́ Bɛtǝlɛhɛmǝ,</para>
  <para style="q1" vid="MAT 2:6">e lee ri tǝŋtǝǝwǝ wǝ loo ru nyɩŋrǝ rǝ Yuda lǝ ǝtǝŋtǝǝyǝ we yǝ lo ru nyɩŋrǝ wǝ. Kpiikǝ piliyǝ rɛ loh po ru rǝ lǝ́ mǝrǝ.</para>
  <para style="q1" vid="MAT 2:6">Ŋwǝ ŋ neh pe ri mǝ kǝkpǝŋkǝ Isǝrayɛlǝ lǝ rǝŋtǝyǝ wǝ.”»<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Wǝ́ Erodɛsɩ ŋ pwò otucitǝpǝ we rǝ kǝŋwaakǝ wǝ́ ŋ pǝ̀ pǝ ŋ nunu eniyǝ we kororo kǝŋɔŋkǝ we kǝ nyɩnɩ wǝ. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Wǝ́ ŋ cò pǝla kʊŋ pǝ ŋ ko Bɛtǝlɛhɛmǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ ko kǝ nǝ kǝ pǝ́ etieyǝ nǝ nuŋ sɩsiɛrɩ nǝ ru rǝ piyǝ we, vǝ́ nǝ nya nyɩŋ ŋwǝ we, nǝ siɛnɩ nǝ pe tíi mǝ wǝ, kǝ ŋmǝ ŋkpɛ ŋ́ nya fɛɛ ŋ́ ka sʊma ŋwǝ.» <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Kǝ́ piliyǝ Erodɛsɩ ŋ na wɛɛlɩ ŋ ne tíi pǝ ŋ na lɛ we, wǝ́ otucitǝpǝ sa pǝ pwɛ̀yɩ pǝ ko ŋ ko. Kǝtǝrǝceŋceŋ wǝ́ pǝ tǝ pǝ nyɩnɩ kǝŋɔŋkǝ we pǝ sǝnǝ pǝ nyɩnɩ rǝ kǝcɔkɔŋpoŋkǝ wǝ. Wǝ́ kǝ conu mǝ pǝ kǝ ko ŋ ko. Kǝ́ kǝ lo ko ro fɛɛwǝ we piyǝ we ŋ ke kpii we, wǝ́ kǝŋɔŋkǝ we kǝ tùumǝ kǝ yàa. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Wǝ́ pǝ nyà faamumuŋwǝ rɛ ŋpaŋpa kǝ́ pǝ la nyɩŋ kǝŋɔŋkǝ we kǝ la yaa wǝ. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Wǝ́ pǝ fìi nyarǝwǝ we. Wǝ́ pǝ nyɩnɩ piyǝ we mǝ ne lee Marɩya. Wǝ́ pǝ sʊ̀ʊ pǝ kʊnʊ pǝ sʊ̀ma piyǝ sa. Wǝ́ pǝ wàla pǝle eleeyǝ, wǝ́ pǝ cɛ̀ɛ no otuyǝ yǝ la lɔ okuruyǝ: Sɩkayǝ, alifuyǝ mǝ apɔŋfɛŋfɛŋpǝ rɛ pǝ lo pwo mirǝyǝ. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Wǝ́ Worokoyǝ ŋ cìi ŋ kanǝ pǝ rǝ kǝtʊkpɛɛkǝ ǝkǝnǝŋ pǝ pǝǝ kpǝlǝŋ pǝ fǝ rǝ Erodɛsɩ lǝ kpǝŋ, wǝ́ pǝ fǝ̀ mǝ kʊŋpʊŋpwawǝ rɛ pǝ ko ŋ ko pǝla fɛɛwǝ. <figure style="fig" alt="Les mages visitent lʼenfant Jésus" file="lb00295c.tif" size="col" copy="Louise Bass" ref="2:12">Otucitǝpǝ rɛ pǝ lǝ pǝ pǝ pa yɩrɩ Yesu</figure><verse eid="MAT 2:12" /></para>
  <para style="s">Pǝ lo suu mǝ Yesu pǝ lo ko Ejipǝte</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Kǝ́ otucitǝpǝ sa pǝ la tɛlɩ la kǝmaa, wǝ́ Ǝtǝ Woroko le picoŋpiyǝ ŋ pǝlǝ ŋ rù rǝ Yosɛfʊ rǝ kǝtʊkpɛɛkǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi kǝ ǝ fǝ piyǝ sa mǝ ne lee o suu o mǝ ko Ejipǝte lǝ gǝŋrǝ. Nǝ tii rǝ we wǝ ko ro eniyǝ we ŋ́ née tíi lǝ́ a siɛnɩ ǝ mǝ pǝ wǝ. Kpiikǝ Erodɛsɩ lah pa taa piyǝ sa ŋ pa nyɩŋ kǝ ŋ wʊ ŋwǝ.» <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Wǝ́ Yosɛfʊ ŋ yili kǝceece, wǝ́ ŋ fǝ̀ piyǝ we mǝ ne lee ŋ pwɛ̀yɩ mǝ dumurǝ ŋ ko ŋ ko Ejipǝte. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Tini rǝ Ejipǝte ko ro jirǝ we Erodɛsɩ ŋ kpǝ̀ wǝ. Tuwǝ sa wǝ pǝlǝ ǝnǝ kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ Ǝtǝ Woroko le dierǝ we ŋ tɛnɩ saŋ rǝ kpɛɛnuŋtɛŋtǝyǝ lo nyuŋkpǝ ǝkǝnǝŋ, «Ŋ́ no pwo mǝ piyǝ ŋ ru ŋ pwɛyɩ rǝ Ejipǝte» we, nya fɛɛ bǝ.<verse eid="MAT 2:15" /></para>
  <para style="s">Erodɛsɩ tàa kʊŋwǝ ŋ wʊ Yesu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kǝ́ Erodɛsɩ ŋ ne ci wǝ ǝkǝnǝŋ otucitǝpǝ sa pǝ lǝ tǝǝnǝ ŋwǝ we, wǝ́ ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋpaŋpa. Wǝ́ ŋ kòonu kpɛɛwǝ pǝ wʊ ǝpǝrǝŋpipǝ we kpǝlo kɩɩkɩ pǝ la lɔ cɛŋwǝ yi fǝ mǝ sʊʊ, pǝ kpii rǝ Bɛtǝlɛhɛmǝ mǝ ǝtǝŋtǝǝpiyǝ we yǝ maarǝ mǝ wǝ wǝ. Yeli wǝ ǝnǝ kpiikǝ otucitǝpǝ sa pǝ tìi ŋwǝ eniyǝ kǝŋɔŋkǝ sa kǝ la nyɩnɩ wǝ. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Fɛɛwǝ kpɛɛnuŋtɛŋtǝyǝ Yeremiya le dietɛŋrǝ ɖù wǝǝ, ǝkǝnǝŋ:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Pupuwǝ wǝ la tɔɔ rǝ Rama,</para>
  <para style="q1" vid="MAT 2:18">Pǝ lo nuŋ eweekǝ mǝ anʊmʊmumuŋkǝ,</para>
  <para style="q1" vid="MAT 2:18">Rasiɛlǝ<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="JER 31:15">Yer 31:15</ref></char>. </char></note> ya lée wee ne epipǝ.</para>
  <para style="q1" vid="MAT 2:18">Lǝ sǝ́ŋ pǝ paa ta no turuwǝ, kpiikǝ ne epipǝ pǝ lǝǝ tǝ pǝ kpii.»<verse eid="MAT 2:18" /></para>
  <para style="s">Pǝ la siɛnɩ mǝ Yesu pǝ lǝ pǝ Isǝrayɛlǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Kǝ́ Erodɛsɩ ŋ nǝ kpǝ́ we, wǝ́ Ǝtǝ Woroko le picoŋpiyǝ ŋ pǝlǝ ŋ rù rǝ Yosɛfʊ rǝ kǝtʊkpɛɛkǝ rǝ Ejipǝte lǝ gǝŋrǝ. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yi kǝ ǝ fǝ piyǝ sa mǝ ne lee kǝ ǝ kpǝlǝŋ mǝ pǝ nǝ mǝ ko Isǝrayɛlǝ lǝ gǝŋrǝ kpiikǝ enyipǝ we pǝ kǝ ŋ pǝ́ pǝ wʊ piyǝ sa we, pǝ lǝ kpǝ́.» <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Wǝ́ Yosɛfʊ ŋ yili kǝceece, wǝ́ ŋ fǝ̀ piyǝ sa mǝ ne lee ŋ kpǝ̀lǝŋ ŋ ko ŋ ko Isǝrayɛlǝ lǝ gǝŋrǝ. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Paa kǝ́ Yosɛfʊ ŋ no nuŋ ǝkǝnǝŋ Erodɛsɩ le piyǝ Akelɔsɩ ŋ na lɔ zaarǝ ŋ ne tii nǝ tǝ lo yuwǝ rǝ Yudeya lǝ gǝŋrǝ we, wǝ́ ŋ sùu vurǝ kǝ́ ŋ née yee kǝ ŋ ko Yudeya wǝ. Wǝ́ Worokoyǝ ŋ cìi ŋ kanǝ ŋwǝ rǝ kǝtʊkpɛɛpʊŋpwakǝ, wǝ́ ŋ pwɛ̀yɩ ŋ kolu ŋ tini rǝ Galileya lǝ gǝŋrǝ. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Kǝ́ ŋ ne ke fii Galileya we, wǝ́ ŋ kolu ŋ tini rǝ tǝŋtǝǝwǝ rɛ pǝ lóo pwo Nazarɛtǝ. Tuwǝ sa wǝ pǝlǝ mǝŋkǝsa kǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ akpɛɛnuŋtɛŋtǝpǝ le dierǝ we pǝ tɛnɩ we, lǝ pǝ. Pǝ tɛnɩ ǝkǝnǝŋ: «Pǝ loh mǝ pwo ŋwǝ ǝkǝnǝŋ Nazarɛtǝtǝpiyǝ.»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yowanɛsɩ worokomɛŋwiiritǝyǝ lo worokoŋtietɛŋrǝ</para>
  <para style="r">(<ref loc="MRK 1:1-18">Marǝko 1:1-18</ref>, <ref loc="LUK 3:1-18">Luka 3:1-18</ref>, <ref loc="JHN 1:19-28">Yowanɛsɩ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Rǝ eniyǝ we mǝrǝ we, wǝ́ Yowanɛsɩ worokomɛŋwiiritǝyǝ ŋ kolu ŋ rù rǝ Yudeya la nyɔŋkpaakǝtǝǝwǝ we. Wǝ́ ŋ ka ŋ tɛŋ Worokoŋtierǝ ǝkǝnǝŋ: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />«Nǝ cɛkɛlɛ vɔrʊrǝ duturǝ ɖi yulaarǝ le wǝpilirikpǝ wǝ lǝ kǝlǝ.» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yowanɛsɩ wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya ŋ ke reemǝ kǝ́ ŋ tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 3:3">«Nyiyǝ rɛ ya lóo woolu rǝ nyɔŋkpaakǝtǝǝwǝ mǝ ŋ tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 3:3">“Nǝ toolu Ǝtǝ Woroko la gʊŋrǝ!</para>
  <para style="q1" vid="MAT 3:3">Nǝ kʊʊrʊ na akʊŋpiyǝ!”»<verse eid="MAT 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />Kpɔŋkɔyǝ lo ɖorǝ wǝ́ pǝ fǝ̀ pǝ yeli kǝkpakǝ we Yowanɛsɩ ŋ ke kpii wǝ. Wǝ́ ŋ fǝ̀ fwɛɛwǝ la apɔsɔyǝ ŋ pàrǝ rǝ kǝtɔŋkǝ. Okokoyǝ mǝ bwɛrǝ yǝ ke ri ne keeriwǝ. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Wǝ́ enyipǝ pǝ ko ŋ ru rǝ Yerusalɛmǝ mǝ Yudeya la afɛɛtuturuyǝ we kpǝlo kɩɩkɩ mǝ Yɔrǝdaŋ la gaarǝ we kpǝlo kɩɩkɩ pǝ ŋ ko Yowanɛsɩ lǝ kpǝŋ. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Wǝ́ pǝ ka ŋ tɛŋ pǝlo oturɔɔrɔɔyǝ, wǝ́ ŋ ke ŋ wiiri pǝ lo worokomɛŋwǝ rǝ Yɔrǝdaŋ la kpanǝwǝ mǝrǝ.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Kǝ́ Yowanɛsɩ ŋ na nyɩŋ Afarisitǝpǝ mǝ Asadukitǝpǝ wa pǝ lǝ pǝ nǝ kpǝŋ kǝ ŋ wiiri pǝ lo worokomɛŋwǝ we, wǝ́ ŋ ke ŋ tíi pǝ ǝkǝnǝŋ: «Amatakpapǝ rɛ pǝ kpii pǝ láa tɛlɩ, ǝlǝ ŋ ne ci ŋ na kaŋ nǝ ǝkǝnǝŋ ŋnǝ nǝ suu nǝ cɛ Worokoyǝ la kpɛɛmʊrʊwǝ sa wǝ lo furu wǝ? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Nǝ nyɩŋ ǝtǝnǝyǝ yǝ láa pɔrʊ yǝ kaŋ ǝkǝnǝŋ ŋnǝ nǝ nya cɛkɛlɛ vɔrʊrǝ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Nǝ pee ce nǝ pu yurǝ ǝkǝnǝŋ ŋnǝ nǝ nyée mǝ tíi nǝ wɛ ǝkǝnǝŋ: “Lǝh tǝtǝ ǝrǝ Abǝrahamǝ”. Duturǝ ɖi ŋ́ ya ŋ́ née tíi nǝ wǝ ǝkǝnǝŋ oruyǝ sa nǝ ya nǝ nyáa nyɩŋ we, Worokoyǝ lóo koru asiɛrɩ yǝ ŋ yee Abǝrahamǝ le epilepipǝ. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Pǝ la marǝ pǝ lǝ fǝ kǝsɔɔkǝ pǝ loh nuuru eciiyǝ. Kǝto wǝcii ri ŋ cii wǝ lǝŋ nyɩŋ dǝnǝceeceerǝ we, pǝ lóo co kpǝ kǝ pǝ tu kpǝ la naa. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ŋmǝ we, mɛŋwǝ wǝ́ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née wiiri nǝ worokomɛŋwǝ kǝ wǝ fǝ wǝ kaŋ ǝkǝnǝŋ nǝ nya cɛkɛlɛ vɔrʊrǝ. Paa nyiyǝ rɛ lo furu rǝ mǝ kǝmaakǝ, lɛnyɩ teeri mǝ. Wǝ́ ŋ́ naa kaamǝ kǝ ŋ́ pɔrʊ na afʊkpayǝ. Ŋwǝ nyiyǝ sa lǝh pǝ fǝ Wɛɛkenikenirǝ mǝ naawǝ ŋ wiiri nǝ worokomɛŋwǝ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Re waawǝ mǝ akaakǝ, kǝ ŋ pa fɛɛ apɔɔtuyǝ ŋ pɔrʊ rǝ ekeeripiyǝ lǝ mǝrǝ, kǝ ŋ fǝ ekeeripiyǝ we ŋ ko toolu ŋ tǝnǝ rǝ wulǝŋwǝ, paa kǝ ŋ tu apɔɔtuyǝ we la naa rǝ naawǝ we wǝ lǝŋ rǝŋ lǝ mǝrǝ.»<verse eid="MAT 3:12" /></para>
  <para style="s">Pǝ le wiiri Yesu lo worokomɛŋwǝ</para>
  <para style="r">(<ref loc="MRK 1:9-11">Marǝko 1:9-11</ref>, <ref loc="LUK 3:21-22">Luka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Wǝ́ Yesu ŋ rù rǝ Galileya ŋ pǝlǝ Yowanɛsɩ lǝ kpǝŋ rǝ Yɔrǝdaŋ la kpanǝwǝ kǝ Yowanɛsɩ ŋ wiiri no worokomɛŋwǝ. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Paa Yowanɛsɩ laa tɛɛnɩ wǝ. Wǝ́ ŋ tìi Yesu ǝkǝnǝŋ: «Ŋmǝ bomu ŋ́ kǝh pǝ kǝ e wiiri mǝ worokomɛŋwǝ wǝ! Wǝ́ ŋlǝ́ o lo ko ru ǝ lǝ́ǝ pǝ mǝ kpǝŋ?» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Rǝ eniyǝ sa mǝrǝ we maa kǝ wǝ lǝ ǝnǝ rǝ. Duturǝ ɖi kǝ́ wǝ lǝ pǝ́ le yee tu ri ŋ tu Worokoyǝ ŋ nǝ pǝ́ wǝǝ.» Wǝ́ Yowanɛsɩ ŋ tɛ̀ɛnɩ wǝ ŋ kòonu ŋwǝ. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Kǝ́ pǝ la nya pǝ le wiiri Yesu lo worokomɛŋwǝ eni ko, wǝ́ ŋ rù rǝ mɛŋwǝ we. Rǝ kǝyaakǝ we wǝ́ yulaarǝ dàanǝ gòonu ŋwǝ. Wǝ́ ŋ nyɩnɩ kǝ́ Worokoyǝ la Wɛɛrǝ lo ru láa sʊʊ mǝŋ tookpaayǝ kǝtǝ wǝ́ bǝlǝ dɛ̀ rǝ ŋwǝ. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Wǝ́ kpɛɛwǝ rɛ wǝ rù rǝ yulaarǝ wǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ ri mǝ Piyǝ ŋ́ náa taa kǝǝwǝ ŋpa wǝ. Ŋ́ na nya faawǝ kɩɩkɩ rǝ ŋwǝ.»<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Satana le tie Yesu la yɩrɩ</para>
  <para style="r">(<ref loc="MRK 1:12-13">Marǝko 1:12-13</ref>, <ref loc="LUK 4:1-13">Luka 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Wǝ́ Worokoyǝ la Wɛɛrǝ vǝ̀ Yesu go ŋ ko nyɔŋkpaakǝtǝǝwǝ, kǝ Abʊŋsamʊyǝ ŋ ka nya fɛɛ ŋ tie ŋwǝ ŋ yɩrɩ. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Kǝ́ Yesu ŋ na ka parǝ nyuŋkpǝ acɔkɔŋciyǝ tǝniǝ mǝ otumuyǝ tǝniǝ ŋ na lɛɛ we, wǝ́ kǝtɛŋkǝ kǝ ka ŋ wʊ ŋwǝ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Wǝ́ nyiyǝ we ŋ née tie enyipǝ mǝŋ yɩrɩ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ, wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ e ri Worokoyǝ le Piyǝ we, tíi oruyǝ sa yǝ siɛrɩ yǝ yee keeriwǝ.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Paape wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ ŋkǝ keeriwǝ ko wǝ́ nyɩmaasɩyǝ ŋ née tii vɔrʊrǝ ŋ koonu. Paa lée tii vɔrʊrǝ rǝ die ri ŋ die lóo ru rǝ Worokoyǝ lo nyuŋkpǝ.» <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Wǝ́ Abʊŋsamʊyǝ ŋ fǝ̀ Yesu ŋ kolu Yerusalɛmǝ tǝŋtǝǝkenikeniwǝ we lǝ mǝrǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kolu ŋ tɛ̀ɛ rǝ Worokoyǝ la nyarǝwǝ lo oŋuŋkǝ. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ e ri Worokoyǝ le Piyǝ we, kpa e yi a ka tɔɔ rǝ kǝtǝǝwǝ. Duturǝ ɖi pǝ la ŋʊrʊ pǝ lǝ tǝnǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 4:6">“Worokoyǝ lée tíi ne epicoŋpipǝ</para>
  <para style="q1" vid="MAT 4:6">pǝ lɔ lǝ́ pǝ re mǝ pǝla wǝkaakpǝ</para>
  <para style="q1" vid="MAT 4:6">kǝ lá kǝkparǝkǝ kǝ paa nya fɛɛ kǝ kpara mǝ ɖurǝ rɛ.”»<verse eid="MAT 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pǝ lǝ tǝ pǝ la ŋʊrʊ rǝ Worokoŋtierǝ mǝrǝ ǝkǝnǝŋ: “Pee tie Ǝtǝ Woroko, ló Worokoyǝ a yɩrɩ.”» <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Wǝ́ Abʊŋsamʊyǝ ŋ tǝ ŋ fǝ̀ Yesu ŋ kolu ŋ tɛ̀ɛ rǝ dutupirǝ rɛ gǝnǝ ŋpa lo oŋuŋkǝ. Wǝ́ ŋ pɔ̀rʊ ǝrǝkǝ lǝ ǝkǝŋyǝ kpǝlo mǝ yǝlo otulǝmǝyǝ ŋ kanǝ ŋwǝ. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ fǝ otuyǝ sa kpǝlo ŋ koonu lǝ́, mǝŋ a la sʊʊ a la kʊŋ mǝ wǝ́ a la sʊma mǝ wǝǝ.» <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pwɛyɩ rǝ mǝ kpǝŋ, Satana! Duturǝ ɖi pǝ la ŋʊrʊ ǝkǝnǝŋ: “Ǝtǝ Woroko ló Worokoyǝ wǝ́ a láa pɛɛlɩ o koonu. Ŋwǝ ceŋceŋ ko wǝ́ a láa sʊma.”»<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Wǝ́ Abʊŋsamʊyǝ ŋ pwɛ̀yɩ rǝ Yesu lǝ kpǝŋ. Kǝtǝrǝceŋceŋ wǝ́ epicoŋpipǝ pǝ pǝlǝ pǝ ke ŋ re ŋwǝ.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesu le tie worokoŋtietɛŋrǝ rǝ Galileya</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu nunu ǝkǝnǝŋ pǝ la lɔ Yowanɛsɩ pǝ la taŋ, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko Galileya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Lee ke tii rǝ Nazarɛtǝ, wǝ́ ŋ kolu ŋ tini rǝ Kapɛrǝnawumǝ, tǝŋtǝǝwǝ sa wǝ yaa rǝ Galileya lo puŋkɔwǝ we la kǝlɛɛrɩkǝ rǝ Zabulɔŋ mǝ Nɛfǝtali la gaarǝ we. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Wǝ pǝlǝ ǝnǝ kǝ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya le dierǝ ŋ tɛnɩ nya fɛɛ bǝ. Tɛnɩ ǝkǝnǝŋ:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Zabulɔŋ lǝ kǝtǝǝwǝ mǝ Nɛfǝtali lǝ kǝtǝǝwǝ,</para>
  <para style="q1" vid="MAT 4:15">wǝ lóo ko rǝ apʊyǝ la gaarǝ, rǝ Yɔrǝdaŋ la kǝtakǝ nɔ,</para>
  <para style="q1" vid="MAT 4:15">epǝ we pǝ lee ri Oyudatǝpǝ la Galileya!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Kǝkpǝŋkǝ we kǝ kpii rǝ nuŋtumuwǝ we,</para>
  <para style="q1" vid="MAT 4:16">kǝ la nyɩŋ wǝnyɩɩnɩmumuŋkpǝ rɛ.</para>
  <para style="q1" vid="MAT 4:16">Epǝ we pǝ kpii rǝ gbɛŋrǝ lǝ tǝŋtǝǝwǝ we wǝ kpii rǝ nuŋtumuwǝ we,</para>
  <para style="q1" vid="MAT 4:16">wǝnyɩɩnɩkpǝ wǝ lo ru wǝ lo koonu pǝ!»<verse eid="MAT 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 4:17" />Fǝ rǝ eniyǝ we mǝ ko wǝ́ Yesu ŋ tìe worokoŋtietɛŋrǝ ǝkǝnǝŋ: «Nǝ cɛkɛlɛ vɔrʊrǝ duturǝ ɖi yulaarǝ le wǝpilirikpǝ wǝ lǝ kǝlǝ.»<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu lo pwo no otukarǝtǝsǝsǝŋpǝ</para>
  <para style="r">(<ref loc="MRK 1:16-20">Marǝko 1:16-20</ref>, <ref loc="LUK 5:1-11">Luka 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Wǝ́ kǝ́ Yesu ŋ sanǝ màarǝ mǝ Galileya lo puŋkɔwǝ we ŋ nóo ko we, wǝ́ ŋ nyɩnɩ enyipǝ rɛ eyi, nyi mǝ na paanʊ, Sɩmɔ pǝ lóo pwo Pɛtǝro mǝ Aŋdǝre, asafʊcotǝpǝ wǝ́ pǝ ri. Pǝ ya pǝ lóo co safʊyǝ rǝ puŋkɔwǝ we. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ pe siimǝ mǝ, kǝ ŋ́ fǝ nǝ ŋ́ yee epǝ we pǝ lǝ́ǝ pǝ mǝ enyipǝ rǝ mǝ kpǝŋ wǝ.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Kǝtǝrǝceŋceŋ wǝ́ pǝ màa pǝla asafʊpǝ pǝ cò wǝ́ pǝ sìimǝ ŋwǝ. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Kǝ́ ŋ nǝ tǝ ŋ no ruu ŋ no ko we, wǝ́ ŋ nyɩnɩ apaanʊpʊŋpwapǝ rɛ eyi: Zebede le pi Yakubu mǝ na paanʊ Yowanɛsɩ. Pǝ ke kpii rǝ pǝla gʊrɔrǝ mǝŋ pǝlǝ tǝ Zebede pǝ ko ŋ toolu pǝla asafʊpǝ. Wǝ́ ŋ pwò pǝ. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Kǝtǝrǝceŋceŋ wǝ́ pǝ màa gʊrɔrǝ we mǝ pǝlǝ tǝ pǝ cò, wǝ́ pǝ sìimǝ ŋwǝ.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu la kaŋ otuyǝ wǝ́ ŋ na cá enyipǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu kolu sìri Galileya la gaarǝ we kpǝlo kɩɩkɩ tɛ̀lɩ. Wǝ́ ŋ ka ŋ kaŋ otuyǝ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ mǝ ŋ tɛŋ Dieceeceerǝ we mǝ ŋ ru rǝ yulaarǝ le wǝpilirikpǝ we. Wǝ́ ŋ ka ŋ cá anyarǝpiyǝ kpǝlo kɩɩkɩ mǝ ofuuyǝ kpǝlo kɩɩkɩ rǝ kǝkpǝŋkǝ mǝrǝ. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Wǝ́ Yesu la nyɩŋrǝ dò kpoo rǝ Siri lǝ gǝŋrǝ kpǝlo kɩɩkɩ. Wǝ́ enyipǝ pǝ kǝ ŋ fǝ anyaatǝpǝ we kpǝlo kɩɩkɩ pǝ ya pǝ láa cʊʊrʊ mǝ anyarǝpiyǝ kpookpoo pǝ ŋ pǝ nǝ kpǝŋ: Epǝ we pǝ ya pǝ lóo fuu, epǝ we pǝ kpii mǝ awɛɛrɔɔrɔɔyǝ, epǝ we pǝ láa tɔɔ wǝ, mǝ ǝsǝ́ŋpǝ. Wǝ́ Yesu ŋ cà pǝ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Wǝ́ wǝnyikpǝŋmumuŋkpǝ rɛ wǝ ke ŋ siimǝ ŋwǝ. Pǝ ko ŋ ru rǝ Galileya, Dekapolǝ, Yerusalɛmǝ, Yudeya, mǝ Yɔrǝdaŋ la kǝtakǝ nɔ la gaarǝ.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesu la tɛŋ Worokoŋtierǝ rǝ dutupirǝ lo oŋuŋkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Kǝ́ Yesu ŋ na nyɩŋ wǝnyikpǝŋkpǝ sa we, wǝ́ ŋ yili ŋ ka ŋ rɛ dutupirǝ rɛ lo oŋuŋkǝ ŋ kolu ŋ tini. Wǝ́ no otukarǝtǝpǝ we pǝ pǝlǝ pǝ kù rǝ nǝ kpǝŋ. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Wǝ́ Yesu ŋ yà ŋ ka ŋ kaŋ pǝ lo otuyǝ ǝkǝnǝŋ:<verse eid="MAT 5:2" /></para>
  <para style="s">Wǝsiɛrɩpoŋpikpǝ</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Epǝ we pǝ cii wǝ rǝ ŋpǝŋpǝ pǝlǝ mǝrǝ ǝkǝnǝŋ ŋpǝ pǝ ri ariariatǝpǝ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:3">Duturǝ ɖi yulaarǝ le wǝpilirikpǝ we wǝ ri pǝla wǝnɛŋ.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Epǝ we pǝ ya pǝ lée wee we, pǝ lo co yǝ,</para>
  <para style="q1" vid="MAT 5:4">duturǝ ɖi Worokoyǝ lah pa ta pǝlo turuwǝ!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Epǝ we pǝ lǝǝmǝ wǝlǝtaarǝkpǝ we, pǝ lo co yǝ,</para>
  <para style="q1" vid="MAT 5:5">duturǝ ɖi ŋpǝ pǝ lah pa lɔ kǝtǝǝwǝ we Worokoyǝ ŋ no co garǝ wǝ!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Epǝ we wǝ láa ca pǝla kpɛɛ ŋpa pǝ tii vɔrʊrǝ mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:6">Duturǝ ɖi Worokoyǝ lóo koonu pǝlǝ kǝǝpǝ́wǝ kpǝlo kɩɩkɩ wǝ pǝ wǝ koonu pǝ!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Epǝ we pǝ láa nyɩŋ enyipǝ la tǝlarǝwǝ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:7">Duturǝ ɖi Worokoyǝ lah pa nyɩŋ pǝ la tǝlarǝwǝ!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Epǝ we pǝ lǝǝmǝ ziɔŋceeceerǝ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:8">Duturǝ ɖi pǝ lah pa nyɩŋ Worokoyǝ.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Epǝ we pǝ lǝ́ǝ pǝ mǝ wǝtaarǝkpǝ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:9">Duturǝ ɖi Worokoyǝ loh mǝ pwo pǝ ne epipǝ!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Epǝ we enyipǝ pǝ le yi pǝ la tɛɛ rǝ, mǝ kǝ́ pǝ lée tii vɔrʊrǝ mǝŋ kǝ́ Worokoyǝ ŋ nǝ pǝ́ we, pǝ lo co yǝ!</para>
  <para style="q1" vid="MAT 5:10">Duturǝ ɖi pǝ leh pe ke tii rǝ yulaarǝ le wǝpilirikpǝ we wǝ ri pǝla wǝnɛŋ wǝ!<verse eid="MAT 5:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 5:11" />Mǝŋ enyipǝ pǝ la fɛɛpɩ nǝ, wǝ́ pǝ le yi pǝ la tɛɛ rǝ nǝ, wǝ́ pǝ la nia etierɔɔrɔɔyǝ kpoo kpoo kpoo pǝ la tɛɛ rǝ nǝ rǝ mǝ yurǝ we, nǝ nyo co yǝ. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Nǝ nya faawǝ, nǝ mǝ yo mǝ faawǝ duturǝ ɖi wǝtoomwaramumuŋkpǝ rɛ wǝ kpɛlɩ nǝ rǝ yulaarǝ! Kaa wǝǝ pǝ yili pǝ tɛ̀ɛ rǝ oworokokpɛɛnuŋtɛŋtǝpǝ we pǝ le tii vɔrʊrǝ pǝ lo coŋ pǝ lo koonu nǝ wǝǝ.<verse eid="MAT 5:12" /></para>
  <para style="s">Atǝraŋpǝ mǝ wǝnyɩɩnɩkpǝ</para>
  <para style="r">(<ref loc="MRK 9:50">Marǝko 9:50</ref>, <ref loc="LUK 14:34-35">Luka 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Ŋnǝ nǝ ri atǝraŋpǝ nǝ koonu ǝrǝkǝ. Paa mǝŋ atǝraŋpǝ pǝ lǝǝ tǝ pǝ lǝmǝ wǝraŋkpǝ wǝǝ, kǝ́ wǝ́ pǝ lǝ́ǝ tǝ pǝ fǝ pǝ raanǝ pǝ wǝ? Pǝ lǝǝ tǝ pǝ lǝmǝ vasʊyǝ rɛ! We pǝ lǝ́ǝ fǝ pǝ pǝ ko co rǝ koruwǝ rǝ kǝ enyipǝ pǝ yapǝ pǝ.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Ŋnǝ nǝ ri wǝnyɩɩnɩkpǝ nǝ koonu ǝrǝkǝ wǝ. Tǝŋtǝǝwǝ we wǝ tɛɛ rǝ dutupirǝ we, wǝ lǝŋ ŋwaa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Pǝ lǝŋ too kaŋrewǝ pǝ lɛ kǝ pǝ fǝ zomurǝ pǝ punu wǝ. Paa pǝ láa tɛɛ wǝ rǝ tutɛɛkaŋrewǝ, kǝ wǝ ŋ nyɩnɩ epǝ we kpǝlo kɩɩkɩ pǝ kpii rǝ nyarǝwǝ wǝ. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Wǝ kaamǝ kǝ nǝ wǝnyɩɩnɩkpǝ wǝ nyɩnɩ enyipǝ kpǝlo kɩɩkɩ mǝŋkǝsa. Eniyǝ we pǝ la nyɩŋ otuceeceeyǝ we nǝ ya nǝ nyée yee wǝ, kǝ pǝ nya fɛɛ pǝ kǝ nǝ Tǝ rǝ yulaarǝ.<verse eid="MAT 5:16" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ Mose le seyǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Nǝ poo pu wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝ pǝ ŋ́ pa pɔrʊ Mose le seyǝ amaa oworokokpɛɛnuŋtɛŋtǝpǝ lo otukaŋyǝ ŋ́ cɛ oo! Ŋ́ nǝǝ pǝ ŋ́ pa pɔrʊ yǝ ŋ́ cɛ rǝ! Paa ŋ́ yee yǝ kǝ yǝ to milimili. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, kǝ́ yulaarǝ mǝ kǝtǝǝwǝ yǝ nya yǝ kpii rǝ we, pǝ lǝŋ pa pɔrʊ Mose le seyǝ la kǝŋʊrʊpipipipikǝ amaa ŋʊrʊwǝ lo tupiwǝ rɛ pǝ cɛ, kǝ o po nuŋ tu ri ŋ tu wǝ lǝ pǝ wǝ la lɛ rǝ! <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Kǝto we, wǝ ke ce wǝ ri esepǝ sa le pipipipiyǝ ǝkǝŋtǝ, wǝ́ rɛ ŋ nǝ sǝ́ŋ ŋwǝ ŋ no co, wǝ́ ŋ na kaŋ enyipʊŋpwapǝ pǝ sǝ́ŋ ŋwǝ pǝ co we, ŋwǝ nyiyǝ sa ŋ neh ke ri pipipipiyǝ rǝ yulaarǝ le wǝpilirikpǝ we lǝ mǝrǝ wǝ. Paa mǝŋ rɛ le yee la saŋ rǝ esepǝ sa, wǝ́ ŋ na lɛ ŋ na kaŋ enyipʊŋpwapǝ ŋpǝ ŋkpɛ pǝ yee pǝ saŋ rǝ esepǝ sa we, leh ke ri nyimumuŋyǝ rǝ yulaarǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, mǝŋ nǝ nyee yee Worokoyǝ lo tuwǝ we ŋ nǝ pǝ́ nǝ teeri esekaŋtǝpǝ mǝ Afarisitǝpǝ we, nǝ nyǝŋ pe ke fii yulaarǝ le wǝpilirikpǝ we mǝrǝ pwi.<verse eid="MAT 5:20" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kpɛɛmʊrʊwǝ</para>
  <para style="r">(<ref loc="MRK 11:25">Marǝko 11:25</ref>, <ref loc="LUK 12:57-59">Luka 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Nǝ nyo nuŋ pǝ tìi lǝh ǝtǝtǝpǝ ǝkǝnǝŋ: “Paa wʊ nyiyǝ. Yǝ we ŋ náa wʊ nyiyǝ we, wǝ kpii kǝ pǝ ko mǝ ŋwǝ rǝ akpaŋtɛŋtǝpǝ lǝ kpǝŋ.” <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ, yǝ we ŋ nǝ́ǝ fǝ kpɛɛmʊrʊwǝ ŋ tɛɛ rǝ na kɛrɩyǝ we, wǝ kpii kǝ pǝ ko mǝ ŋwǝ rǝ akpaŋtɛŋtǝpǝ lǝ kpǝŋ. Mǝŋ rɛ le tíi na kɛrɩyǝ ǝkǝnǝŋ “Ǝ lǝ kpǝ́ yurǝ!” we, wǝ kpii kǝ pǝ ko mǝ ŋwǝ rǝ akpaŋtɛŋtǝpǝ la wǝcakumumuŋkpǝ we lǝ kpǝŋ. Wǝ́ yǝ we ŋ née tíi na kɛrɩyǝ ǝkǝnǝŋ Yufiitǝyǝ we, wǝ kaamǝ kǝ ŋ fii naalaalɛwǝ. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Kǝto mǝŋ o lo ru mǝ ló tukoonuwǝ o lo furu e pe yee otoolukǝ o koonu Worokoyǝ rǝ otoolucuukǝ, wǝ́ a la taalǝ rǝ fɛɛwǝ we ǝkǝnǝŋ dierǝ rɛ gbii rǝ ŋnǝ mǝ lá kɛrɩyǝ lǝ mǝrǝ we, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />nyarǝ ló tukoonuwǝ we ǝ tǝnǝ rǝ otoolucuukǝ we la kǝnyɩŋkǝ. Ko e ke yee nyuŋceŋceŋ mǝ lá kɛrɩyǝ we kpɛŋ kǝ e ci asiɛnɩ o po kuŋ ló tukoonuwǝ.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Mǝŋ rɛ lo ko pwo lǝ́ rǝ etieyǝ, wǝ́ ŋnǝ mǝ ŋwǝ nǝ nyo ru nǝ sanǝ nǝ nyóo ko fɛɛtɛŋakpaŋyǝ we we, nyɩɩ kǝ nǝ nuŋ awɛ lo duturǝ rǝ gʊŋrǝ. Mǝŋ ŋkǝ kaa wǝǝ we, lǝh kǝ fǝ lǝ́ ŋ kpii kpaŋtɛŋtǝyǝ we rǝ akaakǝ. Eniyǝ we kpaŋtɛŋtǝyǝ sa lǝ fǝ lǝ́ le kpii otuusiitǝpǝ rǝ akaakǝ, kǝ pǝ fǝ lǝ́ pǝ ka taŋ. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ a laa mwara ló wǝtookpǝ we a lɛ kɩɩkɩ we, o lǝŋ po ru rǝ gukpɛɛkpǝ we pwi.<verse eid="MAT 5:26" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kǝtienaakǝ mǝ vúuyɩɩrǝ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Nǝ nyo nuŋ pǝ la tɛŋ ǝkǝnǝŋ: “Pee yee kǝtienaakǝ amaa paa yɩɩ vúurǝ!” <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ: “Yǝ we ŋ náa yɩrɩ tieyǝ rɛ kǝ ŋ ca na kpɛɛ we, la marǝ le yee kǝtienaakǝ mǝ tieyǝ sa rǝ na ziɔŋrǝ kaka. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Kǝto mǝŋ lé kǝnirikǝ le nimirǝ lóo koru otu lǝ́ gbii rǝ turɔɔrɔɔwǝ we, pɔrʊ rǝ e tie o co ciriciri. Duturǝ ɖi mǝŋ ǝ lǝ lǝǝrǝ ló gbuŋturǝ rɛ jeŋceŋ we, wǝ lóo poŋ lǝ́ wǝ teeri kǝ́ pǝ lǝh fǝ lá wɛlɛŋrǝ sa milimili pǝ tie pǝ kpii rǝ naalaalɛwǝ wǝ.” <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Mǝŋ lé kǝnirikaakǝ kǝ lóo koonu kǝ e yee turɔɔrɔɔwǝ we, we sǝ kǝ e tie o co ciriciri. Duturǝ ɖi mǝŋ ǝ lǝ lǝǝrǝ ló gbuŋturǝ rɛ jeŋceŋ we, wǝ lóo poŋ lǝ́ wǝ teeri kǝ́ lá wɛlɛŋrǝ sa milimili loh ko naalaalɛwǝ wǝ.<verse eid="MAT 5:30" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kǝ́ pǝ lǝ́ǝ sǝ́ŋ tieyǝ pǝ fǝ wǝ</para>
  <para style="r">(<ref loc="MAT 19:9">Matewu 19:9</ref>, <ref loc="MRK 10:11-12">Marǝko 10:11-12</ref>, <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Pǝ la lɛ pǝ la tɛŋ ǝkǝnǝŋ: “Nyiyǝ we ŋ nǝ́ǝ sǝ́ŋ ne tieyǝ we, wǝ kpii kǝ ŋ koonu na kǝraŋsiefwɛɛkǝ kǝ la pɔrʊ kǝ la kaŋ ǝkǝnǝŋ lǝ sǝ́ŋ ŋwǝ”. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ mǝŋ nyiyǝ rɛ lǝ sǝ́ŋ ne tieyǝ, wǝ́ wǝ lee ri ǝkǝnǝŋ tieyǝ we la yɩɩ vúurǝ rǝ we, yǝ we ya lóo tu tieyǝ sa ŋ ka yɩɩ vúurǝ rǝ. Wǝ́ mǝŋ nyiyǝ rɛ lǝ kǝ fǝ tieyǝ pǝ lǝ sǝ́ŋ la lɔ we, yǝ we le yee kǝtienaakǝ.<verse eid="MAT 5:32" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ otukǝ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Nǝ nyǝ tǝ nǝ nyo nuŋ pǝ tìi nǝ ǝtǝtǝpǝ ǝkǝnǝŋ: “Poo tu tǝrɛ a tɛɛ rǝ! Paa we, yee tuwǝ we o lo tu a la tɛŋ rǝ Ǝtǝ Woroko la kǝnyɩŋkǝ ǝkǝnǝŋ ŋlǝ́ e lée yee wǝ”. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ, nǝ pee ce nǝ tu tǝrɛ pwi. Nǝ poo tu yulaarǝ, duturǝ ɖi yulaarǝ ɖi Worokoyǝ le bilisaarǝ wǝ. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Nǝ paa lɛ nǝ tu kǝtǝǝwǝ duturǝ ɖi kǝtǝǝwǝ wǝ ri Worokoyǝ la fɛɛtǝnǝakparǝyǝ. Kaa wǝǝ, nǝ poo tu Yerusalɛmǝ duturǝ ɖi Pilimumuŋyǝ we lǝ tǝŋtǝǝwǝ wǝ lǝǝwe. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Wǝ́ paa lɛ o tu ló yurǝ. Duturǝ ɖi o lǝŋ koru akpɛɛlɩ amaa etiiri ló kǝyurookǝ mǝŋ kǝceŋceŋ ri ŋ ceŋceŋ. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Mǝŋ dierǝ rɛ lǝ ǝnǝ we, tɛŋ Ǝŋ. Mǝŋ lǝǝ lǝ ǝnǝ we, tɛŋ Ow. Diepʊŋpwarǝ a láa tɛŋ a kʊla we, lo ru rǝ Abʊŋsamʊyǝ lǝ kpǝŋ.<verse eid="MAT 5:37" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kpacawǝ</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Nǝ nyo nuŋ pǝ la tɛŋ ǝkǝnǝŋ: “Mǝŋ rɛ la wɔɔ lé nimirǝ we, pǝ láa wɔɔ na nɛŋrǝ. Wǝ́ mǝŋ rɛ la pɔrʊ ló ɖoŋrǝ we, pǝ láa pɔrʊ na nɛŋrǝ.” <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ mǝŋ rɛ le yee mǝ nǝ turɔɔrɔɔwǝ we, nǝ paa ca nǝ wǝ la kpawǝ. Mǝŋ rɛ la ca lǝ́ kaafieliwǝ rǝ nirikalawǝ we, siɛrɩ pɛŋnɛŋwǝ o koonu ŋwǝ. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Mǝŋ rɛ lǝ pǝ́ ŋ pwo lǝ́ rǝ etieyǝ kǝ ŋ lɔ lá kǝkpapoŋpikǝ we, maa ŋwǝ ŋ lɔ mǝŋ lá nyaŋsiirǝ ŋrǝ ŋkpɛ. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Mǝŋ rɛ la nyɩɩ mǝ lǝ́ kɩnɩkɩnɩ ŋlǝ́ e re ne eleeyǝ a saŋ kpaarayǝ ceŋceŋ we, saŋ o ko mǝ ŋwǝ kpaarayǝ yi. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Mǝŋ rɛ la ria tuwǝ rǝ lǝ́ we, koonu nǝ wǝ. Wǝ́ mǝŋ rɛ lǝ pǝ́ ŋ tuu tuwǝ rǝ lǝ́ kpǝŋ we, pǝǝ sǝ́ŋ.<verse eid="MAT 5:42" /></para>
  <para style="s">Yesu la kaŋ otuyǝ ǝkǝnǝŋ ŋlǝ la taa lǝh ǝkǝǝkpǝlǝtǝpǝ lǝ kǝǝwǝ</para>
  <para style="r">(<ref loc="LUK 6:27-36">Luka 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Nǝ nyo nuŋ pǝ la tɛŋ ǝkǝnǝŋ: “Taa lá kɛrɩyǝ lǝ kǝǝwǝ, kǝ ǝ kpǝlǝ lǝ́ kǝǝkpǝlǝtǝyǝ lǝ kǝǝwǝ.” <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Paa ŋmǝ we, ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ, nǝ taa nǝ ǝkǝǝkpǝlǝtǝpǝ lǝ kǝǝwǝ. Nǝ mwɛŋ nyuŋkpǝ nǝ koonu epǝ we pǝ le yi pǝ la tɛɛ rǝ nǝ wǝ. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Mǝŋkǝsa we, nǝ nyée ri nǝ Tǝ ŋ kpii rǝ yulaarǝ le epipǝ. Ŋwǝ ŋ née yee oturu na cɔkɔŋyǝ lo poŋ lo koonu mǝŋ enyirɔɔrɔɔpǝ mǝŋ eceeceepǝ. Ŋwǝ ŋ nóo kuŋ ŋwʊŋtɛyǝ ŋ pǝ ŋ koonu enyikʊʊpǝ mǝŋ enyilaakʊʊpǝ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Wǝ́ mǝŋ epǝ we pǝ láa taa nǝ kǝǝwǝ sɔŋ wǝ́ nǝ nyáa taa kǝǝwǝ wǝǝ, nǝ nyóo pu wǝ ǝkǝnǝŋ nǝ nyah ka lɔ wǝtoomwarakpǝ rɛ rǝ Worokoyǝ lǝ kpǝŋ? Alaŋpoolɔtǝpǝ ǝkǝŋtǝ pǝ lée yee wǝ ǝnǝ! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Wǝ́ mǝŋ nǝ ǝtǝŋpǝ sɔŋ wǝ́ nǝ nyée ceeni wǝǝ, nǝ nyóo pu wǝ ǝkǝnǝŋ tumumuŋwǝ rɛ wǝ́ nǝ nyée yee? Epǝ we pǝ lee ci Worokoyǝ ǝkǝŋtǝ kǝ́ pǝ lée yee wǝǝ! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kǝto nǝ to milimili mǝŋ kǝ́ nǝ Tǝ rǝ yulaarǝ ŋ no to milimili kǝtǝ.»<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kǝ́ pǝ lóo koonu riariatǝyǝ lo tuwǝ pǝ ŋ fǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«Nǝ yee yurǝ! Nǝ pee mǝ yee tuwǝ Worokoyǝ ŋ nǝ pǝ́ rǝ enyipǝ le enimiyǝ kǝ pǝ nyɩŋ nǝ pǝ ci. Mǝŋ ŋkǝ kaa wǝǝ, nǝ nyǝŋ pa ka lɔ wǝtoomwarakpǝ rɛ rǝ nǝ Tǝ rǝ yulaarǝ lǝ kpǝŋ. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Kǝto vǝ́ o loh koonu riariatǝyǝ lo tuwǝ we, paa ca wǝ lo goŋkoŋrǝ. Alakpatǝpǝ pǝ lée yee wǝ ǝnǝ rǝ okumwɛŋnyuŋyǝ mǝ atɔŋyǝ kǝ enyipǝ pǝ nya fɛɛ pǝ ŋ kǝ pǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, pǝ la marǝ alɔ pǝlo wǝtoomwarakpǝ kaka! <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Paa ŋlǝ́ we, vǝ́ o loh koonu riariatǝyǝ lo tuwǝ we, poo kuŋ kǝ lá kǝpɛŋkǝ kǝ ci tuwǝ we lé kǝnirikǝ kǝ ya kǝ lée yee wǝ. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Wǝ kaamǝ kǝ ló tuwǝ we o lo koonu we, wǝ kpii rǝ kǝŋwaakǝ. Lǝ́ Tǝ Worokoyǝ ŋ náa nyɩŋ rǝ kǝŋwaakǝ we, láa mwara lǝ́ wǝlo wǝtookpǝ.»<verse eid="MAT 6:4" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ nyuŋmwɛŋwǝ</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />«Vǝ́ nǝ nyah mwɛŋ nyuŋkpǝ we, nǝ poo ru alakpatǝpǝ! Pǝ láa taa pǝ ŋ yaa rǝ pǝ ŋ mwɛŋ nyuŋkpǝ rǝ okumwɛŋnyuŋyǝ mǝ atɔŋlɛɛrɩyǝ kǝ enyikpǝlo pǝ nya fɛɛ pǝ nyɩŋ pǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, pǝ la marǝ alɔ pǝlo wǝtoomwarakpǝ kaka! <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Paa ŋlǝ́ we, vǝ́ ǝ lǝh pǝ́ a mwɛŋ nyuŋkpǝ we, mǝ fii ló gumǝnɛŋkpǝ. Taŋ ŋwaarǝ kǝ a mwɛŋ nyuŋkpǝ e tíi lǝ́ Tǝ Worokoyǝ we ŋ kpii rǝ fɛɛwǝ we wǝ la ŋwaa wǝ. Ŋwǝ yǝ we ŋ náa nyɩŋ tuwǝ a ya lée yee rǝ kǝŋwaakǝ we, ŋ mwara lǝ́ wǝlo wǝtookpǝ.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Vǝ́ nǝ ya nǝ nyáa mwɛŋ nyuŋkpǝ we, nǝ pee re nǝ mǝ tɛŋ etieyǝ kǝkpǝŋkǝ yǝ lǝǝ lǝmǝ duturǝ wǝ, mǝŋ epǝ we pǝ lee ci Worokoyǝ sɩsiɛrɩ kǝtǝ. Pǝ lóo pu wǝ ǝkǝnǝŋ vǝ́ ŋpǝ pǝ la wɛɛlɩ ŋpa we, Worokoyǝ lóo nuŋ pǝlo nyuŋmwɛŋwǝ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Nǝ paa karǝ pǝ, duturǝ ɖi nǝ Tǝ cii tuwǝ we wǝ ya wǝ lée yee nǝ ariaayǝ coonu kaka kpɛŋ kǝ nǝ ci ǝ pǝ pǝ́ nǝ wǝ. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Kǝto nǝ mǝ mwɛŋ nyuŋkpǝ eni:</para>
  <para style="q1" vid="MAT 6:9">“Lǝh Tǝ rǝ yulaarǝ,</para>
  <para style="q1" vid="MAT 6:9">kuŋ kǝ pǝ ci wǝ ǝkǝnǝŋ lá nyɩŋrǝ lǝ kenikeni.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Lé wǝpilirikpǝ wǝ pǝ.</para>
  <para style="q1" vid="MAT 6:10">Kuŋ kǝ pǝ yee lǝ́ kǝǝpǝ́wǝ rǝ kǝtǝǝwǝ mǝŋ kǝ́ pǝ lée yee wǝ rǝ yulaarǝ kǝtǝ.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Koonu lǝ ruŋruŋ le keeriwǝ we yǝ lée ri wǝ.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Fǝ loh oturɔɔrɔɔyǝ a cɛɛ lǝ,</para>
  <para style="q1" vid="MAT 6:12">mǝŋ kǝ́ ŋla ŋkpɛ yǝ lǝ́ǝ fǝ yǝ ŋ cɛɛ epǝ we pǝ lo wu lǝ kǝtǝ.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Paa maa kǝ pǝ kpii lǝ gbǝǝrǝ.</para>
  <para style="q1" vid="MAT 6:13">Paa pɔrʊ lǝ o ru rǝ Abʊŋsamʊyǝ la akaakǝ<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Wǝŋʊrʊkuukuurɛɛkpǝ wǝ lǝ kǝ tǝǝlǝ fɛɛkǝwǝ sa mǝ etieyǝ sa ǝnǝ: «Duturǝ ɖi ŋlǝ́ a kaamǝ wǝpilirikpǝ, okopiyǝ mǝ ǝkǝkǝ kǝkpakǝkpa. Amɛnǝ.»</char></note>”.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Mǝŋ nǝ nyǝ́ǝ fǝ nǝ nyǝ ŋ cɛɛ epǝ we pǝ lo wu nǝ we, ŋnǝ ŋkpɛ nǝ Tǝyǝ rǝ yulaarǝ lǝ́ǝ fǝ ŋ cɛɛ nǝ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Paa mǝŋ nǝ nyǝŋ fǝ nǝ cɛɛ enyipǝ we, ŋnǝ ŋkpɛ nǝ Tǝyǝ lǝŋ pǝ fǝ nǝ oturɔɔrɔɔyǝ ŋ cɛɛ nǝ.<verse eid="MAT 6:15" /></para>
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ nyuŋparǝkpǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Vǝ́ nǝ ya nǝ nyáa parǝ nyuŋkpǝ we, nǝ paa lɔ anyɩŋkǝ nǝ nyarǝ mǝŋ kǝ́ alakpatǝpǝ pǝ lée yee wǝ kǝtǝ. Pǝ láa lɔ anyɩŋkǝ pǝ ŋ nyarǝ kǝ enyipǝ pǝ nya fɛɛ pǝ nyɩŋ pǝ ci ǝkǝnǝŋ ŋpǝ pǝ ya pǝ láa parǝ nyuŋkpǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, pǝ la marǝ alɔ pǝlo wǝtoomwarakpǝ kaka. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ŋlǝ́ paa we, vǝ́ a ya láa parǝ nyuŋkpǝ we, wɛɛ lá anyɩŋkǝ kǝ o toolu ló yurǝ sɩsiɛrɩ, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />kǝ rɛ ŋ pee ci wǝ ǝkǝnǝŋ ŋlǝ́ a ya láa parǝ nyuŋkpǝ, we lǝ́ Tǝ Worokoyǝ ŋ kpii ŋ kʊla mǝ lǝ́ rǝ kǝŋwaakǝ we ceŋceŋ ko. Kǝ ŋwǝ lǝ́ Tǝyǝ sa ŋ ya ŋ náa nyɩŋ tuwǝ we a ya lée yee rǝ kǝŋwaakǝ we, ŋ pa mwara lǝ́ wǝlo wǝtookpǝ.<verse eid="MAT 6:18" /></para>
  <para style="s">Yulaarǝ ɖi fɛɛwǝ nyiyǝ ŋ nóo toolu no otulǝmǝyǝ ŋ tǝnǝ wǝ</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Nǝ paa ca otulǝmǝyǝ lo kuwǝ nǝ tǝnǝ nǝ wɛ rǝ kǝtǝǝwǝ sa zaŋrǝ mǝ ɖaarǝrǝ lǝ́ǝ pǝlǝ yǝ wǝ, ayɩlayɩtǝpǝ pǝ láa nyaa pǝ ŋ fii anyarǝyǝ pǝ ŋ ko pǝ ŋ yɩɩ yǝ wǝ. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Paa nǝ ca otulǝmǝyǝ lo kuwǝ nǝ tǝnǝ nǝ wɛ rǝ yulaarǝ. Zaŋrǝ amaa ɖaarǝrǝ lee kpii rǝ fɛɛwǝ we lǝh pǝ pǝlǝ yǝ, wǝ́ yɩlayɩtǝyǝ rɛ lee kpii rǝ fɛɛwǝ we ŋ nah pa nyaa ŋ fii nyarǝwǝ rɛ ŋ ka yɩɩ yǝ. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Duturǝ ɖi fɛɛwǝ we ló otulǝmǝyǝ yǝ kpɛlɩ we, fɛɛwǝ ló yurǝ dɛɛ wǝǝ.<verse eid="MAT 6:21" /></para>
  <para style="s">Wɛlɛŋrǝ la kaŋrewǝ</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Enimiyǝ yǝ ri wɛlɛŋrǝ la kaŋrewǝ. Mǝŋ lé enimiyǝ yǝ ponu lǝ́ we, lá wɛlɛŋrǝ kpǝlo kɩɩkɩ gbii rǝ wǝnyɩɩnɩkpǝ. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Paa mǝŋ lé enimiyǝ yǝ loo poŋ lǝ́ we, lá wɛlɛŋrǝ kpǝlo kɩɩkɩ gbii rǝ nuŋtumuwǝ. Wǝ́ mǝŋ wǝnyɩɩnɩkpǝ we wǝ kpii rǝ lǝ́ wǝ ri rǝ nuŋtumuwǝ we, we lǝ mǝrǝ zuunu ŋpa!<verse eid="MAT 6:23" /></para>
  <para style="s">Yǝ we wǝ kaamǝ kǝ pǝ sʊma wǝ</para>
  <para style="r">(<ref loc="LUK 16:13">Luka 16:13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Rɛ lǝŋ koru asʊma okulǝtǝpǝ eyi kǝtǝrǝ ceŋceŋ. We lǝh mǝ kpǝlǝ ceŋceŋ lǝ kǝǝwǝ kǝ mǝ ŋ taa ceŋceŋ lǝ kǝǝwǝ, amaa láa kpaa ŋ maarǝ mǝ ceŋceŋ kǝ ŋ sǝ́ŋ ceŋceŋ. Nǝ nyǝŋ koru asʊma Worokoyǝ mǝ sɩkayǝ kǝtǝrǝ ceŋceŋ.<verse eid="MAT 6:24" /></para>
  <para style="s">Tɛɛ kpɛɛwǝ rǝ Worokoyǝ</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luka 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ, nǝ pǝǝ kǝǝnǝ tuwǝ nǝ nyée ri, mǝ tuwǝ nǝ nyóo ŋuŋ kǝ nǝ tii vɔrʊrǝ wǝ, amaa kǝkpakǝ nǝ nyée kpii wɛlɛŋrǝ wǝ! Nǝ nyee ci wǝ ǝkǝnǝŋ nǝ vɔrʊrǝ lo ru okuruyǝ le teeri keeriwǝ? Wǝ́ nǝ wɛlɛŋrǝ lo ru okuruyǝ le teeri kǝkpakǝ? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Nǝ yɩrɩ ofuripǝ re, pǝ lǝŋ rʊ tǝrɛ, wǝ́ pǝ lǝŋ fa tǝrɛ, wǝ́ pǝ lǝŋ toolu keeri pǝ tǝnǝ rǝ wulǝŋ, paape nǝ Tǝ rǝ yulaarǝ lóo kuŋ pǝ le keeriwǝ! Kǝto nǝ nyoo ru okuruyǝ ŋpa nǝ teeri ofuripǝ? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ǝlǝ ŋ kpii rǝ nǝ mǝrǝ ŋ nóo koru ata enipiyǝ rɛ tɩpɩrɩ ŋ tɛɛ rǝ na vɔrʊrǝ le eciyǝ, rǝ kǝǝnǝwǝ kǝto? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Wǝ́ kǝ́ kǝto wǝ́ nǝ ya nǝ nyǝ́ǝ kǝǝnǝ rǝ wǝkpakpǝ wǝ? Nǝ yɩrɩ kǝ́ otumɔŋyǝ rǝ bɔɔrǝ yǝ lée wii yǝ ŋ fǝ re! Yǝ lǝŋ yee kǝnǝnɛkǝ rɛ wǝ́ yǝ lǝŋ yaa nyaŋrǝ rɛ! <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Paape ŋ́ ya ŋ́ née tíi nǝ wǝ: Piliyǝ Salomo kǝ lǝǝmǝ na wɛ ŋpa, paape na wǝkpakpǝ wǝ loo poŋ wǝ kaamǝ otumɔŋyǝ sa la rɛ! <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Wǝ́ mǝŋ Worokoyǝ láa cɛ mǝ bɔɔrǝ lo otumɔŋyǝ sa yǝ yaa ruŋruŋ, paape sooso ko pǝ le tie rǝ pǝ le kpii rǝ naawǝ wǝǝ, kǝ ŋ wɛɛ lǝŋ cɛ mǝ nǝ ŋ teeri? Kǝ́ kǝto wǝ́ nǝ lɔnuŋrǝ laa naanǝ mǝŋ tɩ ǝnǝ? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Kǝto we, nǝ pǝǝ tǝ nǝ kǝǝnǝ kǝ nǝ mǝ pǝ́ ǝkǝnǝŋ: “Kǝ́ wǝ́ yǝ leh ri? Kǝ́ wǝ́ yǝ loh ŋuŋ? Kǝ́ la kǝkpa wǝ́ yǝ lah nya le kpii?” <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Epǝ we pǝ lee ci Worokoyǝ we, ŋpǝ pǝ re pǝ yaa mǝ otuyǝ sa kpǝlo la ataakǝ etiikǝ kǝ lee kpii. Paa nǝ Tǝ rǝ yulaarǝ we, cii wǝ ǝkǝnǝŋ ŋyǝ otuyǝ sa kpǝlo kɩɩkɩ yǝ ya yǝ lée yee nǝ ariaayǝ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Nǝ taa Worokoyǝ le wǝpilirikpǝ mǝ na wǝkʊʊkpǝ we kpɛŋ, mǝŋkǝsa we, lǝ́ǝ fǝ otututuruyǝ we kpǝlo kɩɩkɩ ŋ koonu nǝ ŋ kʊla. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Kǝto we, nǝ pǝǝ kǝǝnǝ sooso le jirǝ. Sooso le jirǝ lóo pu yurǝ ɖu rǝ rǝla wɛ. Ji ri ŋ ji mǝ rǝla vaŋrǝ.»<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Paa tɛŋ rɛ la wǝkpaŋkpǝ</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luka 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />«Nǝ paa tɛŋ rɛ la wǝkpaŋkpǝ kǝ Worokoyǝ ŋ paa tɛŋ nǝ wǝkpaŋkpǝ. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Duturǝ ɖi Worokoyǝ lah pa tɛŋ nǝ wǝkpaŋkpǝ mǝŋ kǝ́ nǝ nyáa tɛŋ akpaŋyǝ kǝtǝ. Tuwǝ we nǝ nyǝ́ǝ fǝ nǝ nyǝ ŋ kaa nǝ nyǝ ŋ koonu enyipǝ we, ŋ wǝ wǝ́ Worokoyǝ ŋ nǝh pǝ fǝ ŋ kaa ŋ koonu nǝ wǝ. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />A ya láa yɩrɩ kǝyurookǝ we kǝ kpii rǝ lá paanʊyǝ le nimirǝ. Paa ciituwǝ we wǝ kpii rǝ lé nimirǝ we, a laa ya láa nyɩŋ wǝ e mǝ ŋ ci! Kǝ́ kǝto? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Nɛ kǝto wǝ́ o lóo koru etíi lá paanʊyǝ ǝkǝnǝŋ: “Maa kǝ ŋ́ pɔrʊ kǝyurookǝ sa rǝ lé nimirǝ, paa ciituwǝ wǝ kpii rǝ lá nɛŋrǝ wǝ?” <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Lakpatǝnyiyǝ rɛ! Pɔrʊ ciituwǝ sa rǝ lé nimirǝ kpɛŋ! Eniyǝ we a láa nyɩŋ sɩsiɛrɩ, kǝ a nya fɛɛ a pɔrʊ kǝyurookǝ we rǝ lá paanʊ le nimirǝ.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Nǝ pee tie nǝ okurutulaayǝ nǝ co rǝ afáŋpǝ la kǝnyɩŋkǝ! Pǝ lah pa yapǝ yǝ. Nǝ pǝǝ fǝ tukenikeniwǝ nǝ koonu acɩkɛɛpǝ! Pǝ lah pa siɛrɩ pǝ tɛɛ rǝ nǝ kǝ pǝ laarǝ nǝ.<verse eid="MAT 7:6" /></para>
  <para style="s">Nǝ pǝ́, nǝ taa, nǝ ca ŋwaarǝ</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Nǝ pǝ́ kǝ pǝ koonu nǝ, nǝ taa kǝ nǝ nya, nǝ ca ŋwaarǝ kǝ pǝ taanǝ nǝ rǝ. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Duturǝ ɖi yǝ we ŋ na nya ŋ nǝ pǝ́ tuwǝ ko láa lɔ wǝ, yǝ we ŋ na taa láa nya, wǝ́ yǝ we ŋ na ca ŋwaarǝ we, pǝ láa taanǝ nǝ rǝ. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Ǝlǝ rǝ nǝ mǝrǝ, mǝŋ ne piyǝ lǝ pǝ́ na kpɔnɔyǝ, kǝ yǝ we ŋ fǝ ɖurǝ ŋ koonu ŋwǝ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Amaa mǝŋ piyǝ we lǝ pǝ́ na kǝpwɛɛkǝ wǝǝ, lǝ́ǝ fǝ kǝpɔɔkǝ ŋ koonu ŋwǝ? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Enyirɔɔrɔɔpǝ wǝ́ nǝ ri, paape nǝ cii kǝ́ nǝ nyóo koonu nǝ epipǝ lo otuceeceeyǝ wǝ. Kǝ nǝ Tǝ rǝ yulaarǝ ŋ wɛɛ ŋ pǝǝ fǝ otuceeceeyǝ ŋ koonu epǝ we pǝ ya pǝ lǝ́ǝ pǝ́ nǝ yǝ wǝ?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Otuyǝ we kpǝlo kɩɩkɩ nǝ nyǝ́ǝ pǝ́ enyipǝ pǝ yee pǝ koonu nǝ we, ŋnǝ ŋkpɛ nǝ yee yǝ nǝ koonu pǝ. Tuwǝ Mose le seyǝ mǝ oworokokpɛɛnuŋtɛŋtǝpǝ la wǝfwɛɛkpǝ wǝ ya wǝ láa kaŋ wǝǝ.<verse eid="MAT 7:12" /></para>
  <para style="s">Guŋpolumʊlɩŋtɩŋrǝ we</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Nǝ fǝ rǝ guŋpolumʊlɩŋtɩŋrǝ we nǝ fii vɔrʊpoŋpirǝ we lǝ mǝrǝ! Kpiikǝ guŋpoluyɔkɔɔrǝ we, mǝ kʊŋyɔkɔɔwǝ we we, yǝ lóo ko mǝ nyiyǝ rǝ gbɛŋrǝ. Wǝ́ enyipǝ wa pǝ lǝ́ǝ fǝ rǝ we. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Paa guŋpolumʊlɩŋtɩŋrǝ we mǝ kʊŋcʊkacʊkawǝ we we, wǝ lóo ko mǝ nyiyǝ rǝ vɔrʊrǝ. Wǝ́ enyipǝ rɛ kpekperee ko pǝ láa nyɩŋ rǝ pǝ ŋ ci wǝ.<verse eid="MAT 7:14" /></para>
  <para style="s">Anianiatǝkpɛɛnuŋtɛŋtǝpǝ</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Nǝ yee yurǝ rǝ anianiatǝkpɛɛnuŋtɛŋtǝpǝ lǝ kpǝŋ! Vǝ́ pǝ lǝh pǝ nǝ kpǝŋ we, pǝ ŋ yee mǝ pǝla wɛ mǝŋ amɛɛpǝ kǝtǝ, paa rǝ mǝrǝ we, ecekeeteerɔɔrɔɔyǝ wǝ́ pǝ ri. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Nǝ nyáa nyɩŋ pǝ nǝ ci saŋ rǝ pǝlo otuyeeyǝ. Pǝ lǝŋ lɛ rɛzɛŋyǝ rǝ owukoluyǝ! Wǝ́ pǝ lǝŋ lɛ ocootǝnǝyǝ rǝ wǝwuciikpǝ! <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Wǝciiceeceekpǝ wǝ láa nyɩŋ ǝtǝnǝceeceeyǝ wǝ́ wǝciirɔɔrɔɔkpǝ wǝ láa nyɩŋ ǝtǝnǝrɔɔrɔɔyǝ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Wǝciiceeceekpǝ wǝ lǝŋ koru anyɩŋ ǝtǝnǝrɔɔrɔɔyǝ, wǝ́ wǝciirɔɔrɔɔkpǝ wǝ lǝŋ koru anyɩŋ ǝtǝnǝceeceeyǝ. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Mǝŋ wǝciikpǝ rɛ wǝ lǝŋ nyɩŋ ǝtǝnǝceeceeyǝ we, pǝ lǝ́ǝ sǝ kpǝ pǝ ŋ co, ǝ pǝ ŋ fǝ kpǝ pǝ kpii rǝ naawǝ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kǝto we, nǝ nyáa nyɩŋ anianiatǝkpɛɛnuŋtɛŋtǝpǝ nǝ ci saŋ rǝ pǝlo otuyeeyǝ. <figure style="fig" alt="Plants de raisin" file="hk00112c.tif" size="col" copy="Horace Knowles" ref="7:16">Rɛzɛŋkuŋrǝ</figure><verse eid="MAT 7:20" /></para>
  <para style="s">Ǝpǝ rǝ fǝŋ pǝ loh po ko yulaarǝ wǝ</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Ŋkǝ epǝ we kpǝlo kɩɩkɩ pǝ ya pǝ lóo pwo mǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, Kulǝtǝyǝ”, pǝ leh pe ke fii yulaarǝ le wǝpilirikpǝ we lǝ mǝrǝ! We epǝ we pǝ ya pǝ lée yee mǝ Tǝ rǝ yulaarǝ lǝ kǝǝpǝ́wǝ ceŋceŋ. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Jitɛŋakpaŋyǝ we, enyipǝ wa pǝ lǝh mǝ pǝ́ mǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, Kulǝtǝyǝ, kǝto ŋkǝ rǝ lá nyɩŋrǝ lo oŋuŋkǝ wǝ́ la tɛnɩ Worokoŋtierǝ? Rǝ lá nyɩŋrǝ lo oŋuŋkǝ wǝ́ le pìri awɛɛrɔɔrɔɔyǝ! Rǝ lá nyɩŋrǝ lo oŋuŋkǝ wǝ́ le yeli otucovurǝ ŋpa! Amaa?” <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Eniyǝ we ŋ́ na tɛŋ ŋ́ ne tíi pǝ feŋteŋ ǝkǝnǝŋ: “Ŋ́ nee ci nǝ pwi! Nǝ lǝǝ rǝ mǝ enimiyǝ, ŋnǝ oturɔɔrɔɔyeetǝpǝ sa”.<verse eid="MAT 7:23" /></para>
  <para style="s">Nyarǝwǝ we yiwǝ wǝ</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Kǝto we, nyi ri ŋ nyi ŋ no nuŋ mǝ etieyǝ sa ŋ́ na tɛŋ wǝ, wǝ́ ŋ ne yee ŋ na saŋ rǝ yǝ we, yǝ we lǝ rǝ mǝŋ tucitǝyǝ rɛ ŋ na tɔ no gukpǝ ŋ na tɛɛ rǝ ɖutɛɛrǝ kǝtǝ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Kǝ́ ŋʊŋtɛyǝ ŋ nǝ pǝ we, wǝ́ akpanǝyǝ yǝ lǝ lǝ, Wǝ́ kǝkpǝkǝ kǝ lo fuŋ kǝ le tie nyarǝwǝ sa, paape wǝ laa tɔɔ. Kpiikǝ pǝ cò wǝle giriŋrǝ we la kǝtɛɛkǝ pǝ tɛ̀ɛ rǝ ɖutɛɛrǝ kǝto. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Paa yǝ we ŋ no nuŋ mǝ etieyǝ sa ŋ́ na tɛŋ wǝ wǝ́ ŋ nee yee ŋ saŋ rǝ yǝ we, lǝ rǝ mǝŋ tuleecitǝyǝ rɛ ŋ na tɔ na nyarǝwǝ rǝ naŋrǝ kǝtǝ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Kǝ́ ŋʊŋtɛyǝ ŋ nǝ pǝ we, wǝ́ akpanǝyǝ yǝ lǝ lǝ, wǝ́ kǝkpǝkǝ kǝ lo fuŋ kǝ le tie nyarǝwǝ sa ko wǝ́ wǝ la tɔɔ muru wǝ́ wǝ la wɔ kɩɩkɩ.»<verse eid="MAT 7:27" /></para>
  <para style="s">Yesu la kaŋ otuyǝ mǝ okopiyǝ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ na lɛ we, wǝ́ no otukaŋyǝ sa yǝ rili nyikpǝŋwǝ we kpǝlo kɩɩkɩ lo mumuŋ. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Duturǝ ɖi Yesu laa kaŋ otuyǝ sa mǝŋ pǝle esekaŋtǝpǝ we kǝtǝ, paa kanǝ yǝ mǝ okopiyǝ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu la cá nyarǝpimwɛɛrɩlǝtǝyǝ rɛ</para>
  <para style="r">(<ref loc="MRK 1:40-45">Marǝko 1:40-45</ref>, <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Kǝ́ Yesu ŋ no ru rǝ dutupirǝ we ŋ na pa sʊʊ we, wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ sìimǝ ŋwǝ. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Wǝ́ nyarǝpimwɛɛrɩlǝtǝyǝ rɛ ŋ ko ŋ ruu mǝ ŋ kǝlǝ mǝ ŋwǝ. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ wǝ ponu mǝ lǝ́ we, o lóo koru acá mǝ.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Wǝ́ Yesu ŋ kòonu kǝnukǝ, wǝ́ ŋ rùu ŋwǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ ponu mǝ mǝ, kpaa!» Rǝ kǝyaakǝ we wǝ́ nyiyǝ sa la nyarǝpimwɛɛrɩrǝ we jɛ̀ rǝ ŋwǝ. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yee yurǝ! Paa tɛŋ wǝ e tíi rɛ ŋ ri rɛ. Paa mǝ ko, kǝ fǝ lá wɛ a kaŋ toolutǝyǝ, kǝ o koonu otuyǝ we Mose le seyǝ ŋ na tɛŋ pǝ kuŋ wǝ, kǝ wǝ nya fɛɛ wǝ ri ɖaŋsieyǝ wǝ koonu pǝ.»<verse eid="MAT 8:4" /></para>
  <para style="s">Oromatǝpǝ lo otuusiitǝpǝ lo mumuŋyǝ rɛ la tɛɛ kpɛɛwǝ rǝ Yesu</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7:1-10</ref>, <ref loc="JHN 4:43-54">Yowanɛsɩ 4:43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kǝ́ Yesu ŋ ne ke fii Kapɛrǝnawumǝ we, wǝ́ Oromatǝpǝ lo otuusiitǝpǝ lo mumuŋyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ wǝ́ ŋ tɔ̀ɔ ŋ kpɛlɩ ŋwǝ, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝ sʊmatǝyǝ laa kpaa, kpɛlɩ rǝ nyarǝwǝ. Otoŋyǝ yǝ lǝ kpǝ́ ŋwǝ wǝ́ ŋ ya ŋ náa cʊʊrʊ ŋpa!» <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nóo ko ŋ́ ka cá ŋwǝ.»<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ko ŋ́ ka cá ŋwǝ?»</char></note> <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Wǝ́ tuusiitǝmumuŋyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋ́ naa kaamǝ kǝ e fii mǝ nyarǝwǝ. Paa ŋlǝ́ tɛŋ dierǝ rɛ jeŋceŋ rǝ ko, eniyǝ we mǝ sʊmatǝyǝ la kpaa. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Duturǝ ɖi ŋmǝŋmǝ ŋ́ lǝǝmǝ okulǝtǝpǝ. Wǝ́ ŋ́ lɛ ŋ́ lǝǝmǝ otuusiitǝpǝ ŋ́ née kpii akʊŋyǝ. Vǝ́ ŋ́ ne tíi yǝ ǝnǝ ŋ ko ɖeeni, ŋ ko, vǝ́ ŋ́ ne tíi yǝ eni ŋ pǝ, ŋ pǝ. Vǝ́ ŋ́ ne tíi mǝ sʊmatǝyǝ ŋ yee tuwǝ sa, ŋ yee wǝ.» <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Kǝ́ Yesu ŋ no nuŋ etieyǝ sa we, wǝ́ wǝ rili no mumuŋ, wǝ́ wǝ cà na kpɛɛ. Wǝ́ ŋ tìi epǝ we pǝ ke siimǝ ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋ́ faa nyɩŋ nyiyǝ rɛ ŋ na tɛɛ kpɛɛwǝ rǝ mǝ mǝŋkǝsa rǝ Isǝrayɛlǝ ŋ́ nyɩŋ. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ŋ́ ya ŋ́ náa tɛŋ wǝ mǝ ŋ tíi nǝ, enyipǝ wa pǝ loh po ru rǝ kǝcɔkɔŋpoŋkǝ mǝ kǝcɔkɔŋtɔɔkǝ pǝ pǝ, kǝ pǝ pe tii pǝ ri pǝ kʊla mǝ Abǝrahamǝ, Isakǝ mǝ Yakɔbǝ rǝ yulaarǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Paa pǝ lǝ́ǝ fǝ epǝ we kaŋfɩ pǝ kaamǝ yulaarǝ le wǝpilirikpǝ we we, pǝ tie pǝ co rǝ koruwǝ rǝ nuŋtumuwǝ mǝrǝ. Rǝ fɛɛwǝ we we, pǝ lée wee kǝ pǝ ŋ wo oroŋciiyǝ.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Wǝ́ Yesu ŋ tìi tuusiitǝmumuŋyǝ we ǝkǝnǝŋ: «Kpǝlǝŋ o mǝ ko lá nyarǝwǝ! Wǝ pǝ wǝ koonu lǝ́ mǝŋ kǝ́ a la tɛɛ kpɛɛwǝ rǝ mǝ kǝtǝ!» Wǝ́ tuusiitǝmumuŋyǝ sa la sʊmatǝyǝ we ŋ kpàa rǝ ŋyǝ eniyǝ we kpaŋ lǝ mǝrǝ.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu la cá anyaatǝpǝ wa</para>
  <para style="r">(<ref loc="MRK 1:29-34">Marǝko 1:29-34</ref>, <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Wǝ́ Yesu ŋ ko ŋ ko Pɛtǝro la nyarǝwǝ. Wǝ́ ŋ kolu ŋ nyɩnɩ Pɛtǝro lo nutǝtieyǝ kpɛlɩ rǝ, láa rɛ naawǝ pʊrɩpʊrɩ. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Wǝ́ Yesu ŋ rùu ŋwǝ rǝ akaakǝ, wǝ́ wɛɛkuunaawǝ we wǝ cɛ̀ rǝ ŋwǝ. Wǝ́ ŋ yili, wǝ́ ŋ lɔ̀ɔ Yesu lǝ kǝsǝǝkǝ.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Kǝ́ wǝ lo ro ɖiɔrǝ we, wǝ́ pǝ fǝ̀ enyipǝ wa awɛɛrɔɔrɔɔyǝ yǝ kpii rǝ pǝ, pǝ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ Yesu ŋ ka ŋ wɛɛlɩ rǝ mǝ ŋ piri awɛɛrɔɔrɔɔyǝ sa wǝ́ ŋ lɛ̀ ŋ cà anyaatǝpǝ kpǝlo kɩɩkɩ. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Kǝ́ ŋ ne yee wǝ ǝnǝ we, wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya le dierǝ we ŋ tɛnɩ we, bǝlǝ. Tɛnɩ ǝkǝnǝŋ: «La lɔ loh ofuuyǝ wǝ́ ŋ nǝ rǝǝrǝ lah anyarǝpiyǝ ŋ ne re».<verse eid="MAT 8:17" /></para>
  <para style="s">Epǝ we pǝ lǝ́ǝ pǝ́ pǝ siimǝ Yesu wǝ</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Kǝ́ Yesu ŋ na nyɩŋ nyikpǝŋwǝ we wǝ lo co wǝ le siri ŋwǝ we, wǝ́ ŋ tìi no otukarǝtǝpǝ we pǝ pǝ kǝ pǝ ko puŋkɔwǝ we la kǝtakǝ nɔ. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Wǝ́ sekaŋtǝyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ Yesu. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, fɛɛ ri ŋ fɛɛ o lóo ko we, ŋ́ née siimǝ lǝ́ mǝ ŋ tɛlɩ.» <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Osupǝ pǝ lǝǝmǝ pǝlo ofuŋyǝ, wǝ́ ofuripǝ pǝ lǝǝmǝ pǝlo okuyǝ. Paape Nyɩmaasɩ le Pi lǝǝ lǝmǝ fɛɛwǝ ŋ náa kpɛɛ ŋ wɛɛ wǝ.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Wǝ́ nyipʊŋpwayǝ rɛ ŋ ri Yesu lo otukarǝtǝpǝ we le ceŋceŋ, ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, koonu mǝ gʊŋrǝ ŋ́ ka ŋwaa mǝ tǝ kpɛŋ kǝ mǝ ŋ pǝ». <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siimǝ mǝ, kǝ a maa enyiǝtǝpǝ pǝ ŋ ŋwaa pǝle enyiǝtǝpǝ».<verse eid="MAT 8:22" /></para>
  <para style="s">Yesu la taarǝ kǝkpǝkǝ</para>
  <para style="r">(<ref loc="MRK 4:35-41">Marǝko 4:35-41</ref>, <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Wǝ́ Yesu ŋ fìi gʊrɔrǝ, wǝ́ no otukarǝtǝpǝ we ŋpǝ ŋkpɛ pǝ sìimǝ ŋwǝ pǝ fìi rǝ. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kǝtǝrǝceŋceŋ wǝ́ kǝkpǝmumuŋkǝ rɛ kǝ ko ŋ fuŋ rǝ puŋkɔwǝ we. Wǝ́ mɛŋwǝ wǝ ke ŋ yi wǝ ŋ fii gʊrɔrǝ we. Rǝ eniyǝ we mǝrǝ we, Yesu ya láa kpɛɛ eniŋrieyǝ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ sàanǝ ŋwǝ pǝ tìi ǝkǝnǝŋ: «Kulǝtǝyǝ, lɔ o koonu lǝ oo! Yǝ lǝh kpǝ́!» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo suu vurǝ wǝ? Nǝ lɔnuŋrǝ laa naanǝ!» Wǝ́ ŋ yili, wǝ́ ŋ fanǝ ǝrǝfuŋkǝ we mǝ mɛŋwǝ we, wǝ́ fɛɛwǝ we wǝ rǝnǝ yiriri. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Wǝ́ wǝ rili pǝlo kpǝlo lo mumuŋ wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Ǝlǝ ŋ kaamǝ nyiyǝ sa kǝtǝŋkǝ? Wǝ́ mǝŋ ǝrǝfuŋkǝ, mǝŋ mɛŋwǝ yǝ lóo nuŋ no tutɛŋwǝ!»<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu la cá enyipǝ rɛ eyi awɛɛrɔɔrɔɔyǝ yǝ kpii rǝ wǝ</para>
  <para style="r">(<ref loc="MRK 5:1-20">Marǝko 5:1-20</ref>, <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Kǝ́ Yesu ŋ na ka ta puŋkɔwǝ we la kǝtakǝ nɔ we, wǝ́ ŋ kolu ŋ fìi Agadaratǝpǝ lǝ gǝŋrǝ. Wǝ́ enyipǝ rɛ eyi pǝ rù rǝ ofuŋtɔŋyǝ lǝ mǝrǝ pǝ kǝ ŋ pǝ pǝ po ku mǝ ŋwǝ. Awɛɛrɔɔrɔɔyǝ yǝ ke kpii rǝ enyipǝ sa mǝrǝ. Enyipǝ sa pǝ ko ŋ yururu ŋpa kǝto rɛ loo ko ŋ tu turuwǝ ŋ saŋ kʊŋwǝ we. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Wǝ́ pǝ ya pǝ ko ŋ woolu ǝkǝnǝŋ: «Worokoyǝ le Piyǝ, kǝ́ wǝ kpii rǝ ŋlǝ mǝ lǝ́ lǝ mǝrǝ? Ǝ lǝ pǝ fɛɛwǝ sa e pe pieeli lǝ o coŋ o koonu eniyǝ we Worokoyǝ ŋ nǝ tǝnǝ wǝ?»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Kǝ́ wǝ lo ruu wǝ lo ko rǝ nɔ we, anyɩŋ fáŋkpǝŋmumuŋwǝ rɛ wǝ ya wǝ lée ri. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Wǝ́ awɛɛrɔɔrɔɔyǝ we yǝ ke ŋ kpii Yesu la dɔɔkpɛɛrǝ ǝkǝnǝŋ: «Mǝŋ ǝ lǝ́ǝ pǝ́ e piri lǝ we, we piri lǝ e kpii rǝ fáŋkpǝŋwǝ sa eni.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Wǝ́ Yesu ŋ tìi yǝ ǝkǝnǝŋ: «Nǝ tɛlɩ nǝ mǝ ko!» Wǝ́ awɛɛrɔɔrɔɔyǝ we yǝ rù rǝ enyipǝ we eyipǝ lǝ mǝrǝ. Wǝ́ yǝ kolu yǝ fìi rǝ afáŋpǝ we. Kǝtǝrǝceŋceŋ wǝ́ fáŋkpǝŋwǝ sa kpǝlo kɩɩkɩ wǝ rù rǝ kǝlaŋlaŋkǝ rɛ lo oŋuŋkǝ wǝ pǝlǝ wǝ tɔ̀ɔ puŋkɔwǝ we wǝ́ pǝ kpǝ́ rǝ mɛŋwǝ we mǝrǝ. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Wǝ́ afáŋrǝŋtǝpǝ we pǝ sùu pǝ pwɛ̀yɩ, pǝ ko ŋ ko tǝŋtǝǝwǝ. Wǝ́ pǝ kolu pǝ fǝ̀ tuwǝ we kpǝlo kɩɩkɩ wǝ lǝ pǝ pǝ pɔ̀ amayǝ, otukpǝlo tuwǝ we wǝ pǝlǝ wǝ kòonu enyipǝ we eyipǝ awɛɛrɔɔrɔɔyǝ yǝ ke kpii rǝ wǝ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Wǝ́ ǝtǝŋtǝǝtǝpǝ we kpǝlo kɩɩkɩ pǝ rù pǝ kǝ ŋ pǝ pǝ po ku mǝ Yesu. Kǝ́ pǝ la pa nyɩŋ ŋwǝ we, wǝ́ pǝ ka ŋ tɔɔ pǝ ŋ kpɛɛ ŋwǝ ŋ pwɛyɩ rǝ pǝla gaarǝ we.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu la cá sǝŋyǝ rɛ</para>
  <para style="r">(<ref loc="MRK 2:1-12">Marǝko 2:1-12</ref>, <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Wǝ́ Yesu ŋ fìi gʊrɔrǝ ŋ tǝ ŋ tà puŋkɔwǝ we, wǝ́ ŋ ko ŋ ko ŋwǝŋwǝ nǝ tǝŋtǝǝwǝ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Wǝ́ pǝ rè nyiyǝ rɛ ŋ nǝ kpǝ́ otoŋyǝ kpǝlo kɩɩkɩ mǝ vǝŋkǝrǝ pǝ pǝlǝ Yesu lǝ kpǝŋ. Kǝ́ Yesu ŋ na nyɩŋ enyipǝ sa la lɔnuŋrǝ we, wǝ́ ŋ tìi nyiyǝ sa ŋ nǝ kpǝ́ otoŋyǝ ǝkǝnǝŋ: «Mǝ pi, turuwǝ wǝ ta lǝ́! Pǝ lǝ fǝ ló oturɔɔrɔɔyǝ pǝ la cɛɛ lǝ́.» <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Esekaŋtǝpǝ rɛ pǝ ke tini rǝ fɛɛwǝ we. Wǝ́ ŋpǝŋpǝ pǝ ka ŋ tɛŋ rǝ pǝla wɛ mǝrǝ ǝkǝnǝŋ: «Nyiyǝ sa láa wɛɛlɩ opusuŋtǝtuyǝ!» <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Yesu nyɩnɩ pǝlo oyupuyǝ cìi wǝ́ ŋ pǝ́ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyóo pu oyurɔɔrɔɔyǝ ǝnǝ? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Mǝŋ ŋ́ na tɛŋ ǝkǝnǝŋ: “Pǝ lǝ fǝ ló oturɔɔrɔɔyǝ pǝ la cɛɛ lǝ́” amaa ŋ́ na tɛŋ ǝkǝnǝŋ: “Yi kǝ a mǝ saŋ” wǝǝ, etieyǝ sa lǝ ɖǝ rǝ fǝŋ yɔlʊ atɛŋkǝ deeri wǝ? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Wǝ ponu! Nǝ nyáa nyɩŋ wǝ nǝ ci ǝkǝnǝŋ Nyɩmaasɩ le Pi lǝǝmǝ okopiyǝ rǝ kǝtǝǝwǝ ŋ nǝ́ǝ fǝ oturɔɔrɔɔyǝ ŋ cɛɛ.» Wǝ́ ŋ tìi sǝŋyǝ we ǝkǝnǝŋ: «Yi, fǝ lǝ́ vǝŋkǝrǝ kǝ o mǝ ko nyarǝwǝ!» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Wǝ́ nyiyǝ sa ŋ yili, wǝ́ ŋ ko ŋ ko nyarǝwǝ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Kǝ́ nyikpǝŋwǝ we wǝ la nyɩŋ tuwǝ sa we, wǝ́ wǝ fìi vurǝ, wǝ́ wǝ kǝ ŋ kǝ Worokoyǝ we ŋ nǝ fǝ okopiyǝ sa wǝrʊʊkpǝ ŋ no koonu enyipǝ wǝ.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu lo pwo Matewu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Marǝko 2:13-17</ref>, <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Wǝ́ Yesu ŋ pwɛ̀yɩ rǝ fɛɛwǝ we ŋ ko ŋ ko. Kǝ́ ŋ no ko ŋ nah tɛlɩ we, wǝ́ ŋ nyɩnɩ nyiyǝ rɛ pǝ lóo pwo Matewu, tini rǝ fɛɛlɔlaŋpooyǝ. Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siimǝ mǝ!» Wǝ́ ŋ yili ŋ sìimǝ ŋwǝ.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kǝ́ Yesu ŋ ne ke tii ŋ née ri rǝ Matewu la nyarǝwǝ we, wǝ́ alaŋpoolɔtǝpǝ wa mǝ oturɔɔrɔɔyeetǝpǝ, pǝ pǝlǝ pǝ tini pǝ ke ŋ ri pǝ ŋ kʊla mǝ Yesu mǝ no otukarǝtǝpǝ. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Kǝ́ Afarisitǝpǝ rɛ pǝ la nyɩŋ tuwǝ sa we, wǝ́ pǝ kǝ ŋ pǝ́ otukarǝtǝpǝ we ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ tukaŋtǝyǝ sa ŋ tini ŋ née ri mǝ ŋ kʊla mǝ alaŋpoolɔtǝpǝ mǝ oturɔɔrɔɔyeetǝpǝ ǝnǝ?» <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Wǝ́ Yesu ŋ nunu, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Anyaatǝpǝ pǝ lǝ pǝ́ wɛɛcátǝyǝ wǝ, ŋkǝ epǝ we pǝ kpaa purupuru wǝ. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Nǝ ko nǝ kǝ pǝ́ dierǝ sa Worokoyǝ ŋ na tɛŋ lo duturǝ nǝ nuŋ, ǝkǝnǝŋ: “Ŋ́ nǝ́ǝ pǝ́ nǝ mǝ nyɩŋ enyipǝ la tǝlarǝwǝ, wǝ ponu wǝ teeri kǝ́ nǝ nyée yee otoolukǝ nǝ koonu mǝ wǝ. Duturǝ ɖi ŋ́ nǝǝ pǝ ŋ́ po pwo enyikʊʊpǝ, oturɔɔrɔɔyeetǝpǝ wǝ́ ŋ́ nǝ pǝ ŋ́ po pwo.”»<verse eid="MAT 9:13" /></para>
  <para style="s">Pǝ lǝ pǝ́ Yesu le dierǝ pǝ lo ru rǝ nyuŋparǝkpǝ</para>
  <para style="r">(<ref loc="MRK 2:18-22">Marǝko 2:18-22</ref>, <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Rǝ wǝla kǝmaakǝ wǝ́ Yowanɛsɩ worokomɛŋwiiritǝyǝ lo otukarǝtǝpǝ pǝ rùu pǝ kǝ̀lǝ mǝ Yesu. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ mǝ Afarisitǝpǝ yǝ láa parǝ nyuŋkpǝ eni ri ŋ ni. Kǝ́ kǝto wǝ́ ló otukarǝtǝpǝ paa pǝ lǝŋ parǝ nyuŋkpǝ wǝ?» <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyo pu wǝ ǝkǝnǝŋ tiɛŋwɛŋlǝtǝyǝ lǝ ǝtǝŋpǝ pǝ lée fii gʊʊpirǝ kǝ́ tiɛŋwɛŋlǝtǝyǝ ŋ tini ŋ kʊla mǝ pǝ wǝ? Wǝ lǝǝ lǝ ǝnǝ! Paa eniyǝ yǝ kpii yǝ lǝ́ǝ pǝ, pǝ lǝh pǝ fǝ tiɛŋwɛŋlǝtǝyǝ pǝ cɛ rǝ pǝlǝ kpǝŋ. Eniyǝ we we, pǝ lah mǝ parǝ nyuŋkpǝ.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Rɛ lǝŋ fǝ nyaŋŋwɛŋrǝ lo tuwǝ ŋ ka tɛɛ kǝkpakuukuukǝ. Duturǝ ɖi nyaŋŋwɛŋrǝ we lo tuwǝ wǝ lée tiini kǝkpakuukuukǝ sa. A láa nyɩŋ fɛɛlarǝwǝ sa wǝ láa naanǝ wǝ teeri! <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kaa wǝǝ, rɛ lǝŋ kpii ǝfǝŋŋwɛŋpǝ rǝ fwɛɛwǝ le diikuukuurǝ. Mǝŋ rɛ le yee wǝ we, fwɛɛwǝ le diirǝ we láa larǝ. Ǝfǝŋpǝ we pǝ láa lʊ, eniyǝ we fwɛɛwǝ le diirǝ sa lǝ pǝlǝ lo co. Kǝto we, pǝ lée kpii ǝfǝŋŋwɛŋpǝ rǝ fwɛɛwǝ le diiŋwɛŋrǝ. Oturu mǝŋ ǝfǝŋpǝ we, mǝŋ diirǝ we, yǝ kpɛlɩ sɩsiɛrɩ.» <figure style="fig" alt="Une outre" file="lb00145c.tif" size="col" copy="Louise Bass" ref="9:17">Fwɛɛwǝ le diirǝ</figure><verse eid="MAT 9:17" /></para>
  <para style="s">Yesu la cá tieyǝ rɛ wǝ́ ŋ na saanǝ gɔrʊpirǝ rɛ lǝ kpǝ́ wǝ</para>
  <para style="r">(<ref loc="MRK 5:21-43">Marǝko 5:21-43</ref>, <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Eniyǝ we Yesu ŋ ya ŋ náa wɛɛlɩ mǝ ŋ tíi pǝ ǝnǝ we, wǝ́ Oyudatǝpǝ lo mumuŋyǝ rɛ ŋ pǝlǝ ŋ ko ŋ ru. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ. Wǝ́ ŋ tìi Yesu ǝkǝnǝŋ: «Rǝkǝsa rǝkǝsa wǝ́ mǝ gɔrʊpirǝ lǝ kpǝ́. Paape pǝ kǝ a pa tɛɛ na akaakǝ kǝ ŋ saanǝ.» <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Wǝ́ Yesu ŋ yili, wǝ́ ŋ sìimǝ ŋwǝ ŋpǝ mǝ no otukarǝtǝpǝ.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Wǝ́ tieyǝ rɛ ŋ ka ŋ sʊʊ ŋpǝrayǝ cɛŋwǝ tǝ mǝ yi milimili, ŋ ko ŋ ruu mǝ ŋ kǝlǝ mǝ ŋwǝ rǝ kǝmaakǝ. Wǝ́ ŋ rùu na kǝkpakǝ la laawǝ. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Yeli wǝ ǝnǝ duturǝ ɖi tìi na wɛ ǝkǝnǝŋ: «Mǝŋ ŋ́ na nya ŋ́ no ruu na kǝkpakǝ rǝ ko we, ŋ́ náa kpaa.» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Wǝ́ Yesu ŋ sìɛrɩ, wǝ́ ŋ nyɩnɩ ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ kɔrʊ, ta turuwǝ! Lá lɔnuŋrǝ la pɔrʊ lǝ́.» Rǝ kǝyaakǝ we wǝ́ tieyǝ sa ŋ kpàa. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Wǝ́ Yesu ŋ kolu ŋ fìi Oyudatǝpǝ lo mumuŋyǝ sa la nyarǝwǝ. Wǝ́ ŋ nyɩnɩ kǝ́ nyikpǝŋwǝ wǝ tini wǝ lóo woolu fǝ kʊla mǝ enyipǝ we pǝ ya pǝ lǝ́ǝ kpǝǝ etelɛɛyǝ wǝ. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ tɛlɩ nǝ ru! Gɔrʊpirǝ sa lǝǝ kpǝ́, ya láa kpɛɛ eniŋrieyǝ rǝ.» Wǝ́ pǝ yà pǝ ka ŋ mɔɔnʊ ŋwǝ. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Kǝ́ pǝ la pɔrʊ enyipǝ we pǝ lo ru pǝ la lɛ we, wǝ́ Yesu ŋ fìi gukpǝ we. Wǝ́ ŋ tà gɔrʊpirǝ sa la akaakǝ, wǝ́ gɔrʊpirǝ sa yili. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Wǝ́ tuwǝ sa wǝ tò kpoo rǝ gaarǝ we kpǝlo kɩɩkɩ.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu la cá alaanyɩŋtǝpǝ rɛ eyi</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Kǝ́ Yesu ŋ na pwɛyɩ rǝ fɛɛwǝ we we, wǝ́ alaanyɩŋtǝpǝ rɛ eyi pǝ sìimǝ ŋwǝ, wǝ́ pǝ ko ŋ woolu ǝkǝnǝŋ: «Davidǝ le Pilepi, nyɩŋ lǝ tǝlarǝwǝ oo!»<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Kǝ́ Yesu ŋ ne ke fii nyarǝwǝ we, wǝ́ alaanyɩŋtǝpǝ sa pǝ pǝlǝ pǝ tùu ŋwǝ. Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nya lɔ nǝ nyo nuŋ ǝkǝnǝŋ ŋmǝ ŋ́ nóo koru tuwǝ sa nǝ ya nǝ nyǝ́ǝ pǝ́ mǝ le eyee?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Awo, Kulǝtǝyǝ!» <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Wǝ́ Yesu ŋ rùu pǝle enimiyǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Tuwǝ sa wǝ pǝ wǝ koonu nǝ mǝŋ kǝ́ nǝ nya lɔ nǝ nyo nuŋ kǝtǝ!» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Wǝ́ pǝle enimiyǝ yǝ wùru pǝ. Wǝ́ Yesu ŋ kanǝ ŋ tìi pǝ kǝnyǝnyakǝnyǝnya ǝkǝnǝŋ: «Nǝ nuŋ sɩsiɛrɩ, rɛ ŋ ri rɛ ŋ pee ci wǝ oo!» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Paape kǝ́ pǝ la nya pǝ la cɛ rǝ fɛɛwǝ we eni ko, wǝ́ pǝ tɛnɩ Yesu lo tuwǝ pǝ ka ŋ tɛlɩ rǝ gaarǝ we kpǝlo kɩɩkɩ.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu la cá omumuuyǝ rɛ</para>
  <para style="r">(<ref loc="LUK 11:14-15">Luka 11:14-15</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Kǝ́ enyipǝ we pǝ la pwɛyɩ rǝ Yesu lǝ kpǝŋ pǝ lóo ko we, wǝ́ enyirɛɛpǝ pǝ fǝ̀ nyiyǝ rɛ pǝ pǝlǝ Yesu lǝ kpǝŋ. Wɛɛrɔɔrɔɔrǝ rɛ lǝ fǝ ŋwǝ le yee omumuuyǝ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Wǝ́ Yesu ŋ pìri wɛɛrɔɔrɔɔrǝ we, wǝ́ omumuuyǝ we ŋ ka ŋ wɛɛlɩ. Wǝ́ tuwǝ sa wǝ rili kǝnyikpǝŋkǝ we lo mumuŋ. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «La faa nyɩŋ tuwǝ sa kǝtǝŋkǝ lǝ tǝnǝ rǝ Isǝrayɛlǝ pwi!» <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Wǝ́ Afarisitǝpǝ paa pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Awɛɛrɔɔrɔɔyǝ le piliyǝ ŋ no koonu no okopiyǝ ŋ ya ŋ née piri awɛɛrɔɔrɔɔyǝ».<verse eid="MAT 9:34" /></para>
  <para style="s">Wǝnyikpǝŋkpǝ we lo tuwǝ wǝ lo co Yesu la tǝlarǝwǝ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Wǝ́ Yesu ŋ ko ŋ ko ǝtǝŋtǝǝyǝ mǝ ǝtǝŋtǝǝpiyǝ mǝ ŋ kaŋ otuyǝ mǝ ŋ tɛlɩ rǝ Oyudatǝpǝ lo okumwɛŋnyuŋyǝ. Wǝ́ ŋ kaŋ tɛŋ Dieceeceerǝ we mǝ ŋ ru rǝ yulaarǝ le wǝpilirikpǝ we. Wǝ́ ŋ ka ŋ cá anyarǝpiyǝ kpǝlo kɩɩkɩ mǝŋ ofuuyǝ kpǝlo kɩɩkɩ. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Kǝ́ Yesu ŋ na nyɩŋ wǝnyikpǝŋkpǝ we we, wǝ́ wǝ cò na tǝlarǝwǝ. Duturǝ ɖi enyipǝ sa pǝ la faŋ, pǝ lǝǝ tǝ pǝ lǝmǝ kpɛɛtɛɛwǝ, pǝ kǝ lǝ rǝ mǝŋ amɛɛpǝ pǝ lǝǝ lǝmǝ rǝŋtǝyǝ kǝtǝ! <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Wǝ kǝto ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: «Atɛɛtɛɛtuyǝ yǝ le fii ŋpa, paa alɛɛtǝpǝ pǝ laa naanǝ. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Kǝto nǝ tɔɔ nǝ kpɛɛ tɛɛlǝtǝyǝ we ŋ kpii alɛɛtǝpǝ ŋ maŋ pǝ pa lɛɛ atɛɛtɛɛtuyǝ sa.»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesu la saa enyipǝ tǝ mǝ eyi pǝ ri ne enyikpiipǝ</para>
  <para style="r">(<ref loc="MRK 3:13-19">Marǝko 3:13-19</ref>, <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Wǝ́ Yesu ŋ pwò no otukarǝtǝpǝ we tǝ mǝ eyipǝ ŋ pǝlǝ. Wǝ́ ŋ kòonu pǝ lo okopiyǝ pǝ ŋ piri awɛɛrɔɔrɔɔyǝ, kǝ pǝ ŋ cá anyarǝpiyǝ kpǝlo kɩɩkɩ mǝ ofuuyǝ kpǝlo kɩɩkɩ. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Enyikpiipǝ we tǝ mǝ eyipǝ la anyɩŋyǝ yǝ kaamǝ ǝyǝ ǝnǝ: Sǝsǝŋyǝ, Sɩmɔ pǝ lóo pwo Pɛtǝro mǝ na paanʊ Aŋdǝre, Zebede le pi Yakubu mǝ na paanʊ Yowanɛsɩ, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo mǝ Batelemi, Toma mǝ Matewu laŋpoolɔtǝyǝ we, Alǝfe le pi Yakubu mǝ Tade, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Sɩmɔ, yǝ we ŋ náa kɔŋ mǝ ŋ kuŋ nǝ gǝŋrǝ wǝ mǝ Yuda Isǝkario, ŋwǝ ŋ pǝlǝ ŋ fǝ̀ Yesu ŋ kpìi enyipǝ rǝ akaakǝ wǝ.<verse eid="MAT 10:4" /></para>
  <para style="s">Yesu le kpii ne enyikpiitǝmeyipǝ we la gʊŋrǝ</para>
  <para style="r">(<ref loc="MRK 6:7-13">Marǝko 6:7-13</ref>, <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ŋpǝ enyikpiipǝ sa pǝlǝ tǝ mǝ eyi wǝ́ Yesu ŋ kpìi gʊŋrǝ wǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ poo ko epǝ we pǝ lee ri Oyudatǝpǝ la gaarǝ! Nǝ pee fii Asamariatǝpǝ lǝ tǝŋtǝǝwǝ rɛ! <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Bomu nǝ mǝ ko rǝ Isǝrayɛlǝtǝpipǝ we pǝ lǝ rǝ mǝŋ amɛɛpǝ pǝ lǝ lǝǝ kǝtǝ we, lǝ kpǝŋ. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Vǝ́ nǝ kpii nǝ nyóo ko we, nǝ mǝ tɛŋ ǝkǝnǝŋ: “Yulaarǝ le wǝpilirikpǝ we wǝ lǝ kǝlǝ!” <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Nǝ cá anyaatǝpǝ, nǝ saanǝ enyiǝtǝpǝ, nǝ cá anyarǝpimwɛɛrɩlǝtǝpǝ kǝ nǝ piri awɛɛrɔɔrɔɔyǝ. Pǝ lo koonu nǝ pǝ la cɛɛ rǝ, kǝto ŋnǝ ŋkpɛ nǝ koonu nǝ cɛɛ. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Nǝ pee re sɩkayǝ rɛ rǝ nǝ bierǝ. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Nǝ pee re akpoyǝ rɛ nǝ ko gʊŋrǝ sa. Nǝ pee re wǝkpakpǝ wǝyi, nǝ pee re afʊkpayǝ rɛ amaa ciisaŋwǝ rɛ. Duturǝ ɖi wǝ kpii kǝ pǝ koonu nǝnɛyeetǝyǝ le keeriwǝ.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Vǝ́ nǝ nye fii tǝŋtǝǝwǝ rɛ amaa dǝŋtǝǝpirǝ rɛ we, nǝ taa nyiyǝ we ŋ náa tɛɛnɩ ŋ lɔ nǝ kǝsǝǝkǝ wǝ, kǝ nǝ ka sʊʊrʊ rǝ yǝ we lǝ kpǝŋ. Nǝ tii rǝ nǝ kpǝŋ ko ro kǝ́ nǝ nyáa pwɛyɩ rǝ fɛɛwǝ we wǝ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Vǝ́ nǝ nye fii nyarǝwǝ rɛ we, nǝ ceeni anyarǝlǝtǝpǝ we ǝkǝnǝŋ: “Wǝtaarǝkpǝ wǝ tii wǝ kʊla mǝ nǝ!” <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Mǝŋ anyarǝlǝtǝpǝ we pǝ la tɛɛnɩ pǝ la lɔ nǝ we, kǝ nǝ maa wǝtaarǝkpǝ we nǝ nyǝ pǝ́ nǝ nyo koonu pǝ we, wǝ tii wǝ kʊla mǝ pǝ. Paa mǝŋ pǝ laa tɛɛnɩ pǝ lɔ nǝ we, kǝ nǝ wǝtaarǝkpǝ sa wǝ siɛnɩ wǝ po tuu nǝ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Mǝŋ nyarǝwǝ rɛ amaa tǝŋtǝǝwǝ rɛ wǝ lǝ sǝ́ŋ wǝ laa lɔ nǝ kǝsǝǝkǝ amaa wǝ loo nuŋ nǝ dierǝ we, nǝ tɛrɩ naŋrǝ we dɛɛ rǝ nǝ akparǝyǝ nǝ tǝnǝ kǝ nǝ pwɛyɩ rǝ we. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ŋ́ ya ŋ́ née tíi nǝ wǝ rǝ anʊkɔrǝyǝ, jirǝ we Worokoyǝ ŋ náa tɛŋ akpaŋyǝ we, láa ta ǝtǝŋtǝǝtǝpǝ sa lo kǝtukoŋkǝ ŋ teeri Osodomǝtǝpǝ mǝ Ogomoratǝpǝ.»<verse eid="MAT 10:15" /></para>
  <para style="s">Yesu la tɛŋ acʊcʊʊrʊyǝ we yǝ lo furu le tíi ne enyikpiipǝ we</para>
  <para style="r">(<ref loc="MRK 13:9-13">Marǝko 13:9-13</ref>, <ref loc="LUK 21:12-17">Luka 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />«Nǝ nyɩŋ re! Nǝ lǝ rǝ mǝŋ amɛɛpǝ kǝtǝ. Wǝ́ ŋ́ neh kpii nǝ ŋ́ maŋ rǝ ecekeeteeyǝ lǝ mǝrǝ. Kǝto nǝ sie nimirǝ mǝŋ kǝpɔɔkǝ kǝtǝ, kǝ nǝ wi nǝ ru mǝŋ tookpaayǝ kǝtǝ. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Nǝ yee yurǝ! Duturǝ ɖi enyipǝ pǝ loh po ko mǝ nǝ rǝ fɛɛtɛŋakpaŋyǝ. Pǝ loh po culu nǝ mǝ fwɛɛpǝlawǝ rǝ pǝlo okumwɛŋnyuŋyǝ. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Pǝ loh po ko mǝ nǝ rǝ ǝkǝŋyɩrɩtǝpǝ mǝ epilipǝ lǝ kpǝŋ rǝ mǝ yurǝ kǝto, kǝ nǝ nya fɛɛ nǝ ri ɖaŋsieyǝ nǝ ru rǝ mǝ nǝ tíi pǝ mǝŋ epǝ we pǝ lee ri Oyudatǝpǝ. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Vǝ́ pǝ lo ko mǝ nǝ rǝ fɛɛtɛŋakpaŋyǝ we, nǝ pǝǝ kǝǝnǝ dierǝ we nǝ nyah ka tɛŋ amaa wǝlǝkpǝ we nǝ nyáa tɛŋ rǝ nǝ fǝ wǝ. Vǝ́ eniyǝ we yǝ lo ro we, Worokoyǝ lǝ́ǝ fǝ etieyǝ we nǝ nyáa tɛŋ ŋ koonu nǝ. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Duturǝ ɖi ŋkǝ ŋnǝ nǝ nyáa wɛɛlɩ, paa nǝ Tǝ la Wɛɛrǝ láa wɛɛlɩ zaŋ rǝ nǝ. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Paanʊyǝ lǝ́ǝ fǝ ŋwǝŋwǝ na paanʊyǝ ŋ kpii enyipǝ rǝ akaakǝ kǝ pǝ wʊ ŋwǝ, kǝ tǝyǝ ŋ fǝ ne piyǝ ŋ kpii enyipǝ rǝ akaakǝ pǝ wʊ. Epipǝ pǝ lée yi pǝ tɛɛ rǝ pǝlǝ ǝtǝpǝ mǝ pǝle eleepǝ kǝ pǝ fǝ pǝ pǝ kpii enyipǝ rǝ akaakǝ pǝ wʊ. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ŋmǝ kǝto enyipǝ kpǝlo kɩɩkɩ pǝ lǝ́ǝ kpǝlǝ nǝ kǝǝwǝ. Paape yǝ we ŋ náa tɔ ŋ yaa ǝrǝ alɛɛkǝ we, yǝ we láa nya alɔkuŋkǝ. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Mǝŋ pǝ le yi pǝ la tɛɛ rǝ nǝ rǝ tǝŋtǝǝwǝ rɛ we, nǝ suu nǝ mǝ ko pʊŋpwawǝ. Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, nǝ nyǝŋ pe siri Isǝrayɛlǝ lǝ ǝtǝŋtǝǝyǝ nǝ lɛ kpɛŋ kǝ Nyɩmaasɩ le Pi ŋ ci ǝpǝ.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Tukarǝtǝpiyǝ rɛ lee kpii ŋ teeri no tukaŋtǝyǝ. Sʊmatǝyǝ rɛ lee kpii ŋ teeri no kulǝtǝyǝ. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Tukarǝtǝpiyǝ ŋ nya ŋ lǝ mǝŋ no tukaŋtǝyǝ rǝ ko, kǝ sʊmatǝyǝ ŋ nya ŋ lǝ mǝ no kulǝtǝyǝ rǝ ko. Mǝŋ pǝ lo pwo nyarǝwǝ rɛ lo mumuŋyǝ ǝkǝnǝŋ Bɛzebulǝ wǝǝ, we pǝ lǝŋ fɛɛpɩ enyituturupǝ we rǝ nyarǝwǝ we pǝ teeri?»<verse eid="MAT 10:25" /></para>
  <para style="s">Nyiyǝ we wǝ kpii kǝ pǝ suu wǝ</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />«Kǝto nǝ poo suu epǝ we pǝ lée yi pǝ ŋ tɛɛ rǝ enyipǝ lo vurǝ. Tu ri ŋ tu wǝ la ŋwaa we, pǝ lǝ́ǝ pǝ pǝ ŋ nyɩŋ wǝ. Wǝ́ tuŋwaawǝ rɛ wǝ lee kpii enyipǝ pǝ lǝŋ pe ci wǝ. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Tuwǝ sa ŋ́ ya ŋ́ née tíi nǝ rǝ nuŋtumuwǝ mǝrǝ we, nǝ tɛŋ wǝ mǝ jɔkɔŋrǝ ketekete. Tuwǝ we pǝ la ŋwaa pǝ le tíi lǝ́ rǝ kǝtukoŋkǝ we, ca wǝlo goŋkoŋrǝ rǝ canɩyǝ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Nǝ poo suu epǝ we pǝ láa wʊ wɛlɛŋrǝ paa pǝ lǝŋ koru awʊ kǝrukǝ wǝ. Bomu nǝ suu Worokoyǝ we ŋ nóo koru ǝnǝǝnǝ mǝŋ wɛlɛŋrǝ mǝŋ kǝrukǝ rǝ naalaalɛwǝ wǝ. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Enyipǝ pǝ cii wǝ ǝkǝnǝŋ pǝ lóo koru esiiri akpaŋsapǝ eyi bie. Paape pǝle ceŋceŋ ri ŋ ceŋceŋ lǝŋ tɔɔ kǝtǝǝwǝ mǝŋ ŋkǝ nǝ Tǝ Worokoyǝ ŋ no kuŋ kʊŋwǝ wǝ. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ŋnǝ paa we, nǝ oyurooyǝ ǝkǝŋtǝ we, Worokoyǝ cii yǝlo kuruyuwǝ. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Kǝto nǝ poo suu vurǝ! Ŋnǝ we, nǝ nya lɔ okuruyǝ ŋpa nǝ nye teeri akpaŋsapǝ wa.»<verse eid="MAT 10:31" /></para>
  <para style="s">Wǝ kaamǝ kǝ nǝ ri Yesu Kǝriso la anɛŋpǝ rǝ enyikpǝlo le enimiyǝ</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luka 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«Nyi ri ŋ nyi ŋ náa tɛŋ rǝ enyipǝ le enimiyǝ ǝkǝnǝŋ ŋwǝ ŋ ri mǝ nɛŋyǝ we, ŋmǝ ŋkpɛ ŋ́ nah ka nyɩŋ ŋwǝ ŋ́ ci rǝ mǝ Tǝ rǝ yulaarǝ le enimiyǝ ǝkǝnǝŋ yǝ we ri mǝ nɛŋyǝ. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Paa nyiyǝ we ŋ náa tɛŋ rǝ enyipǝ le enimiyǝ ǝkǝnǝŋ ŋwǝ ŋ nee ci mǝ we, ŋmǝ ŋkpɛ ŋ́ nah ka tɛŋ rǝ mǝ Tǝ rǝ yulaarǝ le enimiyǝ ǝkǝnǝŋ ŋ́ nee ci ŋwǝ.»<verse eid="MAT 10:33" /></para>
  <para style="s">Yesu lǝ pǝ mǝ wǝsǝpǝkpǝ rǝ enyipǝ lǝ mǝrǝ</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12:51-53</ref>, <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Nǝ poo pu wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝ pǝ ŋ́ po koonu wǝtaarǝkpǝ rǝ kǝtǝǝwǝ rǝ oo! Ŋ́ nǝǝ pǝ ŋ́ po koonu wǝtaarǝkpǝ, paa ŋ́ nǝ pǝ mǝ tʊkʊwǝ. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ŋ́ nǝ pǝ ŋ́ pǝ sǝpǝ kosopiyǝ mǝ nǝ tǝyǝ, kɔrʊyǝ mǝ ne leeyǝ, piletieyǝ mǝ nuŋleeyǝ. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Wǝ́ nyɩmaasɩyǝ lǝ ǝkǝǝkpǝlǝtǝpǝ pǝ lée ri ŋwǝŋwǝ na anyarǝtǝpǝ. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Yǝ we ŋ náa taa nǝ tǝyǝ amaa ne leeyǝ lǝ kǝǝwǝ mǝ ŋ teeri ŋmǝ we, yǝ we laa kaamǝ kǝ ŋ ri mǝ tukarǝtǝyǝ. Yǝ we ŋ náa taa nǝ bǝrǝŋpirǝ amaa ne diepirǝ lǝ kǝǝwǝ mǝ ŋ teeri ŋmǝ we, yǝ we laa kaamǝ kǝ ŋ ri mǝ tukarǝtǝyǝ. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Yǝ ŋ nǝǝ fǝ na kpɛtɛkpǝlɛciiwǝ ŋ re ŋ siimǝ mǝ kǝ ŋ kǝ kpǝ́ rǝ we, yǝ we laa kaamǝ kǝ ŋ ri mǝ tukarǝtǝyǝ. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Yǝ we ŋ nǝ pǝ́ ŋ pɔrʊ na wɛ la vɔrʊrǝ we, lǝ́ǝ lǝǝrǝ rǝ. Paa yǝ we ŋ nǝ́ǝ lǝǝrǝ na vɔrʊrǝ rǝ mǝ yurǝ we, yǝ we láa pɔrʊ na wɛ la vɔrʊrǝ.<verse eid="MAT 10:39" /></para>
  <para style="s">Wǝceeceeyeekpǝ mǝ wǝlo wǝtoomwarakpǝ</para>
  <para style="r">(<ref loc="MRK 9:41">Marǝko 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«Yǝ we ŋ na lɔ nǝ kǝsǝǝkǝ we, ŋmǝ wǝ ŋ na lɔ. Wǝ́ nyiyǝ we ŋ na lɔ mǝ kǝsǝǝkǝ we, yǝ we ŋ ne kpii mǝ ŋ na maŋ wǝ́ ŋ na lɔ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Yǝ we ŋ na lɔ worokokpɛɛnuŋtɛŋtǝyǝ lǝ kǝsǝǝkǝ mǝ kǝ́ ŋ ri worokokpɛɛnuŋtɛŋtǝyǝ we, ŋwǝ nyiyǝ sa lah pa lɔ wǝtookpǝ we pǝ láa mwara worokokpɛɛnuŋtɛŋtǝyǝ wǝ. Wǝ́ yǝ we ŋ náa lɔ nyikʊʊyǝ lǝ kǝsǝǝkǝ mǝ kǝ́ ŋ ri nyikʊʊyǝ we, nyiyǝ sa lah pa lɔ nyikʊʊyǝ lo wǝtoomwarakpǝ. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, yǝ we ŋ no koonu mǝ otukarǝtǝpǝ sa le pipiyǝ rɛ la mɛŋtaarǝwǝ kɔpʊwǝ ceŋceŋ ǝkǝŋtǝ mǝ kǝ́ ŋ ri mǝ tukarǝtǝyǝ we, yǝ we láa lɔ wǝlo wǝtoomwarakpǝ.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yowanɛsɩ worokomɛŋwiiritǝyǝ we lǝ pǝ́ ŋ ci mǝŋ Yesu ŋ ri Mesiyayǝ we wǝ</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Kǝ́ Yesu ŋ na wɛɛlɩ ŋ ne tíi ne enyikpiitǝmeyipǝ we ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ rǝ we. Wǝ́ ŋ ko ŋ ko ǝtǝŋtǝǝyǝ we yǝ kpii rǝ gaarǝ we ŋ ka kaŋ otuyǝ kǝ ŋ tɛŋ Dieceeceerǝ we.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yowanɛsɩ worokomɛŋwiiritǝyǝ we ke kpii rǝ gukpɛɛkpǝ, wǝ́ ŋ nunu anǝnɛyǝ we Kǝriso ŋ ya ŋ née yee wǝ. Wǝ́ ŋ kpìi no otukarǝtǝpǝ rɛ, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />pǝ kǝ pǝ́ Yesu ǝkǝnǝŋ: «Ŋlǝ́ e ri Mesiyayǝ we ŋ nǝh pǝ wǝ, amaa lǝ tǝ lǝ mǝ rǝŋ nyipʊŋpwayǝ rɛ?» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ ko nǝ ka tɛŋ otuyǝ we nǝ ya nǝ nyóo nuŋ wǝ́ nǝ ya nǝ nyáa nyɩŋ nǝ tíi Yowanɛsɩ. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Alaanyɩŋtǝpǝ pǝ ya pǝ láa nyɩŋ, ǝsǝ́ŋpǝ pǝ ya pǝ láa saŋ, anyarǝpimwɛɛrɩlǝtǝpǝ pǝ la kpaa, oloonuŋtǝpǝ pǝ ya pǝ lóo nuŋ, enyiǝtǝpǝ pǝ ya pǝ láa saanǝ, wǝ́ ariariatǝpǝ pǝ ya pǝ lóo nuŋ Dieceeceerǝ we. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Yǝ we ŋ nǝǝ lǝǝrǝ na lɔnuŋrǝ rǝ mǝ we, ŋwǝ yǝ lo co yǝ!»<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Kǝ́ Yowanɛsɩ lo otukarǝtǝpǝ we pǝ la pwɛyɩ pǝ la tɛlɩ we, wǝ́ Yesu ŋ yà ŋ ka ŋ wɛɛlɩ mǝ ŋ ru rǝ Yowanɛsɩ mǝ ŋ tíi nyikpǝŋwǝ we ǝkǝnǝŋ: «Kǝ́ nǝ nyo ko nyɔŋkpaakǝtǝǝwǝ wǝǝ kǝ́ wǝ́ nǝ nya ka nyɩŋ? Ŋkǝ gáarǝ rɛ ǝrǝkǝ kǝ ya kǝ lóo fuŋ lǝǝwe? Ow! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />We kǝ́ wǝ́ nǝ nya ka nyɩŋ? Nyiyǝ rɛ ŋ na cɛ mǝ wǝkpakpǝ wǝ la lɔ okuruyǝ wǝ? Epǝ we pǝ la cɛ mǝ wǝkpakpǝ we wǝ la lɔ okuruyǝ we, epilipǝ la anyarǝyǝ wǝ́ pǝ kpii. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />We kǝ́ wǝ́ nǝ nya ka nyɩŋ? Worokokpɛɛnuŋtɛŋtǝyǝ rɛ? Awo, ŋ́ ya ŋ́ née tíi nǝ wǝ, teeri worokokpɛɛnuŋtɛŋtǝyǝ kʊraa. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Duturǝ ɖi Yowanɛsɩyǝ sa le dierǝ wǝ́ pǝ la tɛŋ rǝ Worokoyǝ la kǝfwɛɛkǝ mǝrǝ ǝkǝnǝŋ: “A lǝŋ nyɩŋ, ŋ́ née kpii mǝ nyikpiiyǝ ŋ coŋ ŋ koonu lǝ́. Loh ko toolu lá gʊŋrǝ ŋ tǝnǝ lǝ́.”» <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, rɛ lee kpii rǝ anyɩmaasɩpǝ lǝ mǝrǝ ŋ teeri Yowanɛsɩ worokomɛŋwiiritǝyǝ we. Paape yǝ we ŋ ri pipipipiyǝ rǝ yulaarǝ le wǝpilirikpǝ we lǝ mǝrǝ we, naanǝ teeri ŋwǝ. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Fǝ ǝrǝ Yowanɛsɩ worokomɛŋwiiritǝyǝ le eniyǝ po ro ruŋruŋ le jirǝ we, pǝ ya pǝ lée kpii yulaarǝ le wǝpilirikpǝ we la jʊʊrʊrǝ mǝ okopi mǝ okopi.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">Pǝ lóo koru onuŋ wǝlo duturǝ ǝkǝnǝŋ: Yulaarǝ ya láa nyaa rǝla cawǝ mǝ okopi mǝ okopi.</char></note> Wǝ́ okopilǝtǝpǝ pǝ ya pǝ láa nyɩɩ kɩnɩkɩnɩ kǝ pǝ kparǝ ŋkpǝ wǝpilirikpǝ sa pǝ kaa. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Duturǝ ɖi, oworokokpɛɛnuŋtɛŋtǝpǝ kpǝlo kɩɩkɩ fǝ kʊla mǝ Mose le seyǝ pǝ la wɛɛlɩ pǝ lo ru rǝ yulaarǝ le wǝpilirikpǝ po ro ǝrǝ Yowanɛsɩ le eniyǝ. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Wǝ́ mǝŋ nǝ nyǝ́ǝ pǝ́ nǝ lɔ etieyǝ sa ŋ́ ya ŋ́ náa tɛŋ nǝ nuŋ we, nǝ ci wǝ ǝkǝnǝŋ Yowanɛsɩ ŋ kaamǝ Eliya, nyiyǝ sa pǝ tɛnɩ ǝkǝnǝŋ ŋ nǝ́ǝ pǝ ŋ coonu wǝ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Yǝ we ŋ lǝǝmǝ otukoŋyǝ ŋ nóo nuŋ tuwǝ we, ŋ nuŋ oo!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Ǝlǝ wǝ́ ŋ́ noh koru ǝfǝ rǝkǝsa le enyipǝ ŋ́ ca mǝ wǝ? Pǝ lo ru alaatiepipǝ pǝ tini rǝ canɩyǝ. Wǝ́ arɛɛpǝ pǝ ya pǝ láa ca narǝwǝ pǝ ŋ tíi apʊŋpwapǝ ǝkǝnǝŋ: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />“Yǝ la ca bǝŋrǝ yǝ le kpii nǝ, paape nǝ nyoo yo! Yǝ le kpii akpɩtɩnɔŋyǝ paape nǝ nyaa nʊmʊ!” <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Duturǝ ɖi, kǝ́ Yowanɛsɩ ŋ pǝlǝ we, lee ke ŋ ri keeriwǝ mǝŋkǝsa, wǝ́ ŋ noo ko ŋ ŋuŋ ǝfǝŋpǝ. Wǝ́ nǝ ka ŋ tɛŋ ǝkǝnǝŋ: “Wɛɛrɔɔrɔɔrǝ gbii rǝ ŋwǝ!” <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Kǝ́ Nyɩmaasɩ le Pi ŋ nǝ pǝ we, lée ri wǝ́ ŋ nóo ŋuŋ. Wǝ́ nǝ nyáa tɛŋ ǝkǝnǝŋ: “Rikpaatǝyǝ mǝ fǝŋŋuŋtǝyǝ wǝ́ ŋ ri. Alaŋpoolɔtǝpǝ mǝ oturɔɔrɔɔyeetǝpǝ la kɛrɩyǝ wǝ́ ŋ ri”. Paape pǝ láa nyɩŋ wǝ pǝ ŋ ci ǝkǝnǝŋ Worokoyǝ lo otuciyǝ yǝ ponu saŋ rǝ yǝla anǝnɛyǝ.»<verse eid="MAT 11:19" /></para>
  <para style="s">Ǝtǝŋtǝǝyǝ we yǝ lǝ sǝ́ŋ yǝ laa lɔ Yesu yǝ nuŋ wǝ</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ǝtǝŋtǝǝyǝ we Yesu ŋ yeli no otucovurǝ la kǝtamumuŋkǝ we, ǝtǝŋtǝǝyǝ sa le enyipǝ pǝ sǝ́nǝ pǝ laa siɛrɩ vɔrʊrǝ. Wǝ kǝto Yesu ŋ yà ŋ ka ŋ kpaŋ mǝ pǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Ŋnǝ Okoraziŋtǝpǝ, nǝ paapɔ mǝ nǝ aria! Ŋnǝ Abɛsayɩdatǝpǝ, ŋnǝ ŋkpɛ nǝ paapɔ mǝ nǝ aria! Duturǝ ɖi ŋ́ yeli otuyǝ yǝ lóo co vurǝ rǝ nǝ kpǝŋ. Mǝŋ ŋ́ ke yeli yǝ ǝnǝ rǝ Tiro mǝ Zidɔŋ we, o koh mǝ pwo Etirotǝpǝ mǝ Ezidɔŋtǝpǝ pǝ le kpii wǝkpekpekotokukpakpǝ kaka kǝ pǝ nuŋ atʊkpɔrɔyǝ, kǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ pǝ la siɛrɩ vɔrʊrǝ. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ wǝ, jitɛŋakpaŋyǝ we, Worokoyǝ láa ta nǝ kǝtukoŋkǝ ŋ teeri Etirotǝpǝ mǝ Ezidɔŋtǝpǝ. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ŋnǝ Akapɛrǝnawumǝtǝpǝ ŋnǝ ŋkpɛ, nǝ nyo pu wǝ ǝkǝnǝŋ Worokoyǝ lah rɛɛrɩ mǝ nǝ ǝrǝ yulaarǝ? Bomu lah sʊʊrʊ mǝ nǝ ǝrǝ akpɛŋtɛkǝ. Duturǝ ɖi mǝŋ otucovurǝ sa pǝ yeli rǝ nǝ mǝrǝ, pǝ ke yeli yǝ rǝ Sodomǝ we, o koh mǝ pwo tǝŋtǝǝwǝ sa wǝ tǝ wǝ kpii mǝŋ ruŋruŋ le jirǝ sa! <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ wǝ, jitɛŋakpaŋyǝ we, Worokoyǝ láa ta nǝ kǝtukoŋkǝ ŋ teeri Osodomǝtǝpǝ.»<verse eid="MAT 11:24" /></para>
  <para style="s">Yesu la pɔrʊ nǝ Tǝ Worokoyǝ la kaŋ no otukarǝtǝpǝ</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Rǝ eniyǝ we mǝrǝ wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Mǝ Tǝ, yulaarǝ mǝ kǝtǝǝwǝ lo Kulǝtǝyǝ, e le yeekǝ. Duturǝ ɖi tuwǝ we ǝ lǝ fǝ a la ŋwaa enimisietǝpǝ mǝ otucitǝpǝ we, ǝ lǝ fǝ wǝ a la kaŋ alaatiepipǝ. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Kǝceece, mǝ Tǝ, ŋlǝ́ŋlǝ́ ǝ lǝ pǝ́ wǝ lǝ ǝnǝ. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Mǝ Tǝ lǝ fǝ tu ri ŋ tu le kpii mǝ rǝ akaakǝ. Rɛ lee ci nyiyǝ we ŋ ri Piyǝ. We Tǝyǝ ceŋceŋ ko ŋ cii wǝ. Wǝ́ rɛ lee ci yǝ we ŋ ri Tǝyǝ. Ŋwǝ Piyǝ ceŋceŋ ko, mǝ enyipǝ we ŋ nǝ pǝ́ ŋ fǝ Tǝyǝ ŋ kaŋ wǝ.»<verse eid="MAT 11:27" /></para>
  <para style="s">Nǝ pǝ Yesu lǝ kpǝŋ kǝ nǝ nya diiwɛɛrǝ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />«Nǝ ruu nǝ pǝ mǝ kpǝŋ, ŋnǝ epǝ we kpǝlo kɩɩkɩ nǝ re eleeyǝ mǝ nuruwǝ wǝ́ nǝ nya faŋ wǝ, kǝ ŋmǝ we, ŋ́ koonu nǝ diiwɛɛrǝ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Nǝ lɔ mǝ eleeyǝ nǝ tɛɛ rǝ nǝ wɛ rǝ! Kǝ nǝ maa kǝ ŋ́ kaŋ nǝ otuyǝ. Duturǝ ɖi ŋ́ taarǝ lɛrǝ, wǝ́ ŋ́ lǝǝmǝ wɛɛpɛɛlɩwǝ rǝ mǝ ziɔŋrǝ. Mǝŋkǝsa we, ŋnǝŋnǝ nǝ nyáa nya diiwɛɛrǝ. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Awo! Eleeyǝ sa ŋ́ ya ŋ́ née tíi nǝ nǝ fǝ we, yǝ laa lɛnyɩ ereekǝ, mǝ eleeyǝ we, yǝ lǝ fokofoko.»<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yesu ri Kulǝtǝyǝ koonu sabatǝyǝ le jirǝ</para>
  <para style="r">(<ref loc="MRK 2:23-28">Marǝko 2:23-28</ref>, <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Rǝ ŋyǝ eniyǝ we lǝ mǝrǝ we, sabatǝyǝ le jirɛɛrǝ wǝ́ Yesu ŋ sanǝ ŋ kolu ŋ ka ŋ tɛlɩ bǝleyǝ la wǝtɛɛkpǝ rɛ. Anyɩŋ kǝtɛŋkǝ kǝ ya kǝ láa wʊ no otukarǝtǝpǝ we. Wǝ́ pǝ ka ŋ pɔɔpʊ bǝleyǝ we le epiyǝ pǝ ŋ wo. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Kǝ́ Afarisitǝpǝ pǝ la nyɩŋ tuwǝ sa ǝnǝ we, wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Yɩrɩ re, ló otukarǝtǝpǝ sa pǝ ya pǝ lée yee tuwǝ leh Seyǝ ŋ nǝ kpǝlǝ eyeekǝ mǝ sabatǝyǝ le jirǝ wǝ!» <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyǝǝ kǝ tuwǝ Davidǝ ŋ yeli jirǝ we kǝtɛŋkǝ kǝ ka ŋ wʊ ŋpǝ mǝ enyipǝ we pǝ ke siimǝ ŋwǝ nǝ nyɩŋ? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Davidǝ fìi Worokoyǝ la nyarǝwǝ. Wǝ́ ŋpǝ mǝ enyipǝ we pǝ ke siimǝ ŋwǝ pǝ wolu akpɔnɔpǝ we pǝ lo koonu Worokoyǝ wǝ. Paa mǝŋ ŋwǝ, mǝŋ epǝ we pǝ ke siimǝ ŋwǝ wǝ, gʊŋrǝ lee kpii kǝ pǝ wo kpɔnɔyǝ sa! We otoolutǝpǝ ko.» <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Amaa nǝ nyǝǝ kǝ tuwǝ sa rǝ Mose le seyǝ we mǝrǝ? Ǝkǝnǝŋ otoolutǝpǝ we pǝ lée yee kǝnǝnɛkǝ rǝ Worokoyǝ la nyarǝwǝ mǝ sabatǝyǝ le jirǝ we, pǝ lǝŋ yee pǝ saŋ rǝ sabatǝyǝ le seyǝ. Paape pǝ lǝŋ tɔɔ pǝ la bɔrǝ rɛ! <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Paa ŋ́ ya ŋ́ née tíi nǝ wǝ ǝkǝnǝŋ tuwǝ rɛ wǝ yaa rǝ fɛɛwǝ sa wǝ teeri Worokoyǝ la nyarǝwǝ. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Worokoyǝ la tɛŋ rǝ Wǝŋʊrʊkpǝ lǝ mǝrǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ pǝ́ nǝ mǝ nyɩŋ enyipǝ la tǝlarǝwǝ, wǝ ponu wǝ teeri kǝ́ nǝ nyée yee otoolukǝ nǝ koonu mǝ wǝ.» Mǝŋ kǝceece nǝ koh nuŋ dierǝ sa lo duturǝ we, nǝ nyǝŋ ka tɔɔ epǝ we pǝ lee yee tǝrɛ la bɔrǝ! <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Duturǝ ɖi Nyɩmaasɩ le Pi ri Kulǝtǝyǝ koonu sabatǝyǝ le jirǝ.<verse eid="MAT 12:8" /></para>
  <para style="s">Yesu la cá nyiyǝ rɛ ŋ nǝ kpǝ́ kǝnukǝ mǝ sabatǝyǝ le jirǝ</para>
  <para style="r">(<ref loc="MRK 3:1-6">Marǝko 3:1-6</ref>, <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Kǝ́ Yesu ŋ na pwɛyɩ rǝ fɛɛwǝ we we, wǝ́ ŋ ko ŋ ko pǝlo gumwɛŋnyuŋkpǝ. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Nyiyǝ rɛ ŋ nǝ kpǝ́ kǝnukǝ ke kpii rǝ we. Wǝ́ Afarisitǝpǝ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Leh seyǝ lo kuŋ gʊŋrǝ pǝ cá nyiyǝ mǝ sabatǝyǝ le jirǝ?» Pǝ kǝ ŋ pǝ́ pǝ yee dierǝ mǝ ŋwǝ rǝ. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Mǝŋ rɛ rǝ nǝ mǝrǝ lǝǝmǝ mɛɛyǝ ceŋceŋ, wǝ́ mɛɛyǝ sa ŋ na ka tɔɔ fuŋwǝ rɛ mǝ sabatǝyǝ le jirǝ wǝǝ, nyiyǝ sa lǝŋ ko ŋ ka pɔrʊ ŋwǝ ŋ ru rǝ wǝ? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Paa nyɩmaasɩyǝ la lɔ okuruyǝ le teeri mɛɛyǝ ŋpaŋpa! Kǝto rǝ seyǝ we, gʊŋrǝ gbɛlɩ kǝ pǝ yee wǝceeceekpǝ mǝ sabatǝyǝ le jirǝ.» <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Wǝ́ Yesu ŋ tìi nyiyǝ we ǝkǝnǝŋ: «Nwiɛnɩ ló kǝnukǝ.» Wǝ́ ŋ nwìɛnɩ kǝ. Wǝ́ no kǝnukǝ we kǝ sàanǝ. Wǝ́ kǝ kolu kǝ kaamǝ kǝnuyitǝkǝ we rǝ. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Kǝ́ pǝ la nya pǝ lo ru eni we, wǝ́ Afarisitǝpǝ we pǝ kolu pǝ kù pǝ tà etieyǝ kǝ pǝ nyɩŋ kǝ́ pǝ lée yee kǝ pǝ wʊ Yesu wǝ.<verse eid="MAT 12:14" /></para>
  <para style="s">Yesu ŋ ri sʊmatǝyǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ wǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Kǝ́ Yesu ŋ no nuŋ tuwǝ sa we, wǝ́ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we. Wǝ́ kǝkpǝŋmumuŋkǝ rɛ kǝ sìimǝ ŋwǝ. Wǝ́ ŋ cà anyaatǝpǝ kpǝlo kɩɩkɩ. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Paa wǝ́ ŋ kpìi seyǝ ŋ kòonu pǝ kpuŋkpuruŋ pǝ paa ka tɛŋ nyiyǝ ŋwǝ ŋ ri pǝ tíi rɛ. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Wǝ pǝlǝ ǝnǝ kǝ worokokpɛɛnuŋtɛŋtǝyǝ Ezaya le etieyǝ we ŋ tɛnɩ yǝ nya fɛɛ yǝ pǝ. Tɛnɩ ǝkǝnǝŋ:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Worokoyǝ la tɛŋ ǝkǝnǝŋ: “A lǝŋ nyɩŋ, mǝ sʊmatǝyǝ we ŋ́ na saa ŋ́ na pɔrʊ wǝǝ.</para>
  <para style="q1" vid="MAT 12:18">Yǝ we ŋ́ náa taa kǝǝwǝ wǝ, ŋ́ náa nya mǝ faawǝ kpǝlo kɩɩkɩ rǝ ŋwǝ.</para>
  <para style="q1" vid="MAT 12:18">Ŋ́ nǝ́ǝ fǝ mǝ Wɛɛrǝ ŋ́ kpii rǝ ŋwǝ,</para>
  <para style="q1" vid="MAT 12:18">kǝ ŋ pa tɛŋ mǝ wǝkpaŋtɛŋkpǝ le dierǝ ŋ tíi wǝkpǝŋkpǝ. <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />Lǝŋ pe yee dierǝ mǝ rɛ, lǝŋ pa ca narǝ!</para>
  <para style="q1" vid="MAT 12:19">Wǝ́ pǝ lǝŋ po nuŋ na kpɛɛwǝ rǝ canɩtiwǝ.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Lǝŋ po po gáarǝ rɛ le si yaa wǝ!</para>
  <para style="q1" vid="MAT 12:20">Wǝ́ lǝŋ pa lɛ ŋ rǝǝnǝ kaŋrewǝ we wǝ lah ta wǝ rǝŋ wǝ.</para>
  <para style="q1" vid="MAT 12:20">Lée re ŋ yaa mǝŋkǝsa ko ro kǝ́ wǝkpaŋtɛŋkpǝ rǝ wǝkʊʊkpǝ wǝ lée ri yurǝ wǝ.”»<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Wǝkpǝŋkpǝ kpǝlo kɩɩkɩ wǝ láa tɛɛ kpɛɛwǝ rǝ ŋwǝ.<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu lée piri awɛɛrɔɔrɔɔyǝ</para>
  <para style="r">(<ref loc="MRK 3:22-30">Marǝko 3:22-30</ref>, <ref loc="LUK 11:14-23">Luka 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Wǝ́ enyipǝ rɛ pǝ fǝ̀ laanyɩŋtǝyǝ rɛ ŋ lɛ ŋ ri omumuuyǝ pǝ pǝlǝ Yesu lǝ kpǝŋ. Wɛɛrɔɔrɔɔrǝ rɛ ge kpii rǝ nyiyǝ sa mǝrǝ. Wǝ́ Yesu ŋ cà ŋwǝ, wǝ́ nyiyǝ sa ŋ ka ŋ nyɩŋ wǝ́ ŋ ka ŋ lɛ mǝ ŋ wɛɛlɩ. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Wǝ́ tuwǝ sa wǝ rili kǝnyikpǝŋkǝ we kpǝlo kɩɩkɩ lo mumuŋ! Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kǝto ŋkǝ Davidǝ le Pilepiyǝ we ŋ kaamǝ nyiyǝ sa?» <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Kǝ́ Afarisitǝpǝ pǝ lo nuŋ tuwǝ sa enyipǝ pǝ ya pǝ láa tɛŋ we, wǝ́ pǝ kaŋ tɛŋ ǝkǝnǝŋ: «Mǝŋ nyiyǝ sa ya lée piri awɛɛrɔɔrɔɔyǝ we, awɛɛrɔɔrɔɔyǝ le piliyǝ Bɛzebulǝ ŋ no koonu no okopiyǝ!» <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Paa Yesu ke cii pǝlo oyupuyǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝŋ wǝpilirikpǝ rɛ le enyipǝ pǝ lǝ sǝpǝ wǝ́ pǝ le yi pǝ la tɛɛ rǝ awɛ we, wǝpilirikpǝ sa wǝ láa wɔ. Kaa wǝǝ, mǝŋ tǝŋtǝǝwǝ rɛ amaa nyarǝwǝ rɛ le enyipǝ pǝ le yi pǝ ya pǝ láa kɔŋ awɛ we, tǝŋtǝǝwǝ sa amaa nyarǝwǝ sa wǝ láa wɔ. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Wǝ́ mǝŋ Satana ya lée piri Satana we, we lǝ sǝpǝ wǝ́ ŋ ne yi ŋ na tɛɛ rǝ na wɛ wǝǝ! Wǝ lée yee nɛ kǝ ne wǝpilirikpǝ wǝ tǝ wǝ tɔ wǝ yaa? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Wǝ́ mǝŋ Bɛzebulǝ ŋ no koonu mǝ okopiyǝ ŋ́ nǝ fǝ ŋ́ ya ŋ́ née piri awɛɛrɔɔrɔɔyǝ, ŋnǝ no otukarǝtǝpǝ wǝǝ, ǝlǝ ŋ no koonu pǝ lo okopiyǝ pǝ lǝ́ǝ fǝ pǝ ŋ piri awɛɛrɔɔrɔɔyǝ wǝ? Kǝto nǝ otukarǝtǝpǝ ŋpǝŋpǝ pǝ ya pǝ láa tɔɔ nǝ bɔrǝ. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Wǝ́ mǝŋ Worokoyǝ la Wɛɛrǝ lo koonu mǝ okopiyǝ ŋ́ ya ŋ́ née piri awɛɛrɔɔrɔɔyǝ we, we wǝ ya wǝ láa pɔrʊ wǝ ŋ kaŋ ǝkǝnǝŋ Worokoyǝ le wǝpilirikpǝ we wǝ le pe fii nǝ kpǝŋ wǝ la lɛ. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Rɛ lǝŋ koru e ke fii kopilǝtǝyǝ la nyarǝwǝ kǝ ŋ kʊlaŋ no otulǝmǝyǝ ŋ pwɛyɩ, mǝŋ ŋkǝ la parǝ kopilǝtǝyǝ sa lǝ tǝnǝ kpɛŋ! Paa mǝŋ la parǝ ŋwǝ la lɛ we, lóo koru akʊlaŋ tu ri ŋ tu rǝ na nyarǝwǝ sa. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Nyiyǝ we ŋ naa kʊla mǝ mǝ we, le yi la tɛɛ rǝ mǝ. Yǝ we ŋ naa ya ŋ nóo toŋ mǝ kǝ la ca enyipǝ lo ku lo koonu Worokoyǝ we, ya lée piri enyipǝ rǝ. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ: Worokoyǝ lǝh pǝ fǝ enyipǝ lo oturɔɔrɔɔyǝ kpǝlo kɩɩkɩ pǝ le yee mǝ opusuŋtǝtuyǝ kpǝlo kɩɩkɩ pǝ la wɛɛlɩ pǝ lo ru rǝ ŋwǝ ŋ cɛɛ pǝ. Paa yǝ we ŋ náa wɛɛlɩ opusuŋtǝtuyǝ ŋ ru rǝ Wɛɛkenikenirǝ we, Worokoyǝ lǝŋ pǝ fǝ wǝ ŋ cɛɛ ŋwǝ pwi. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Mǝŋ rɛ la tɛŋ tuwǝ rɛ la tɛɛ rǝ Nyɩmaasɩ le Pi we, Worokoyǝ lǝ́ǝ fǝ ŋ cɛɛ ŋwǝ. Paa yǝ we ŋ náa tɛŋ tuwǝ rɛ ŋ tɛɛ rǝ Wɛɛkenikenirǝ we, Worokoyǝ lǝŋ pǝ fǝ ŋ cɛɛ ŋwǝ pwi, wǝ ke ri ǝrǝ ǝrǝkǝ la alɛɛkǝ amaa wǝla kǝmaakǝ wǝ!»<verse eid="MAT 12:32" /></para>
  <para style="s">Pǝ láa nyɩŋ wǝciiceeceekpǝ pǝ ŋ ci saŋ rǝ wǝlǝ ǝtǝnǝyǝ</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />«Mǝŋ wǝciikpǝ rɛ wǝ ponu we, wǝlǝ ǝtǝnǝyǝ ŋyǝ ŋkpɛ yǝ lóo poŋ. Mǝŋ wǝciikpǝ rɛ wǝ loo poŋ we, wǝlǝ ǝtǝnǝyǝ yǝ lǝŋ poŋ. Pǝ láa nyɩŋ wǝciikpǝ pǝ ŋ ci saŋ rǝ wǝlǝ ǝtǝnǝyǝ we wǝ láa nyɩŋ wǝ. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Amatakpapǝ rɛ pǝ kpii pǝ láa tɛlɩ! Wǝ lée yee nɛ kǝ nǝ koru otuceeceeyǝ la atɛŋ rǝ kǝ́ nǝ ri enyirɔɔrɔɔpǝ wǝ? Duturǝ ɖi tuwǝ we wǝ lǝ lǝ wǝ kpii nyiyǝ rǝ ziɔŋrǝ we, ŋ wǝ wǝ lóo ru ŋwǝ rǝ nyuŋkpǝ wǝ. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nyiceeceeyǝ we, lée yee rǝ otuceeceeyǝ. Kpiikǝ na ziɔŋrǝ lǝ lǝ mǝ otuceeceeyǝ. Paa nyirɔɔrɔɔyǝ we, lée yee rǝ oturɔɔrɔɔyǝ. Kpiikǝ na ziɔŋrǝ lǝ lǝ mǝ oturɔɔrɔɔyǝ wǝ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, jirǝ we Worokoyǝ ŋ náa tɛŋ enyipǝ la akpaŋyǝ we, nyi ri ŋ nyi lah ka pɔrʊ na atʊkpaatǝtieyǝ we kpǝlo kɩɩkɩ ŋ na wɛɛlɩ ŋ na nyɩŋ lo duturǝ ŋ tíi Worokoyǝ. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Duturǝ ɖi lé etieyǝ wǝ́ Worokoyǝ ŋ nǝ́ǝ fǝ ŋ pɛɛnɩ lǝ́ amaa ŋ tɔɔ lǝ́ bɔrǝ wǝ.»<verse eid="MAT 12:37" /></para>
  <para style="s">Enyipǝ pǝ lǝ pǝ́ Yesu ŋ yee tucovurǝ rɛ</para>
  <para style="r">(<ref loc="MRK 8:11-12">Marǝko 8:11-12</ref>, <ref loc="LUK 11:29-32">Luka 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Wǝ́ esekaŋtǝpǝ rɛ mǝ Afarisitǝpǝ rɛ pǝ tìi Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, la ya yǝ lǝ́ǝ pǝ́ e yee tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii lǝ́ ŋ na maŋ wǝ.» <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Ruŋruŋ le enyipǝ sa pǝ pǝlǝ pǝ lǝŋ ri anʊkɔrǝyǝ pǝ koonu Worokoyǝ. Paa pǝ ya pǝ lǝ́ǝ pǝ́ pǝ nyɩŋ tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii mǝ ŋ na maŋ. Pǝ lǝŋ pa nyɩŋ tucovurǝ sa wǝrʊʊkpǝ pwi, we tɛŋ worokokpɛɛnuŋtɛŋtǝyǝ Yona la nɛŋwǝ we ceŋceŋ rǝ. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Duturǝ ɖi, mǝŋ kǝ́ Yona ŋ yeli acɔkɔŋciyǝ ata mǝ otumuyǝ ata rǝ kǝpwɛɛmumuŋkǝ we la lɛrǝ we, kǝ́ Nyɩmaasɩ le Pi ŋwǝ ŋkpɛ ŋ neh pe yee acɔkɔŋciyǝ ata mǝ otumuyǝ ata rǝ kǝtǝǝwǝ mǝrǝ wǝǝ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Wǝkpaŋtɛŋkpǝ le jirǝ we, Eninivetǝpǝ pǝ lée yi pǝ yaa rǝ rǝkǝsa le enyipǝ la kǝnyɩŋkǝ, kǝ pǝ tɔɔ pǝ la bɔrǝ. Duturǝ ɖi Eninivetǝpǝ pǝ nunu Yona lo Worokoŋtierǝ wǝ́ pǝ sìɛrɩ vɔrʊrǝ. Paa nǝ yɩrɩ re, nyiyǝ rɛ yaa rǝ fɛɛwǝ sa teeri Yona.» <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Wǝkpaŋtɛŋkpǝ le jirǝ we, pilitieyǝ we ŋ no ru rǝ gǝŋrǝ we pǝ lóo pwo Saba we, leh pe yi ŋ yaa rǝ rǝkǝsa le enyipǝ la kǝnyɩŋkǝ, kǝ ŋ tɔɔ pǝ la bɔrǝ. Duturǝ ɖi rù rǝ gǝŋrǝ rɛ ciriciri ŋ po nuŋ Salomo lo otuciyǝ le etieyǝ. Paa nǝ yɩrɩ re, nyiyǝ rɛ yaa rǝ fɛɛwǝ sa teeri Salomo.<verse eid="MAT 12:42" /></para>
  <para style="s">Wɛɛrɔɔrɔɔrǝ lǝ́ǝ tǝ lǝ ŋ koru asiɛnɩ bǝ rǝle kǝtiikuukuukǝ</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«Vǝ́ wɛɛrɔɔrɔɔrǝ lo ru rǝ nyiyǝ we, a lǝ ŋ ka ya lǝ ŋ siri rǝ nyɔŋkpaakǝtǝǝwǝ lǝ ŋ taa fɛɛtiiwǝ. Mǝŋ laa nya fɛɛwǝ we, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />a lǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋ́ náa siɛnɩ ŋ́ ko mǝ kǝtiikǝ we ŋ́ no ru wǝ.” Vǝ́ wɛɛrɔɔrɔɔrǝ sa la siɛnɩ lǝ pǝ fɛɛtiikuukuuwǝ sa, wǝ́ lo turu wǝ kpɛlɩ akpaakpa, wǝ la cɛɛlɩ, wǝ lo toolu we, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />oturu la siɛnɩ la ka taa awɛɛrɔɔrɔɔpʊŋpwayǝ apǝrɩmata, yǝ pǝlǝ yǝ teeri rǝ gʊla mǝ rǝla wɛ. Yǝ ŋ mǝ pǝ yǝ pe tii rǝ nyiyǝ we lǝ mǝrǝ. Nyiyǝ we la vɔrʊrǝ lǝ ŋ siɛnɩ bǝlǝ deeri kǝsǝŋkǝ. Kǝ́ wǝ lǝh pǝ lǝ wǝ koonu rǝkǝsa le enyirɔɔrɔɔpǝ sa wǝǝ.»<verse eid="MAT 12:45" /></para>
  <para style="s">Yesu le lee mǝ Yesu la apaanʊpǝ pǝ lǝ pǝ Yesu lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MRK 3:31-35">Marǝko 3:31-35</ref>, <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Eniyǝ we Yesu ŋ tǝ ŋ ya ŋ náa wɛɛlɩ mǝ ŋ tíi kǝnyikpǝŋkǝ we we, wǝ́ ne lee mǝ na apaanʊpǝ pǝ pǝlǝ pǝ rù. Pǝ yàa rǝ koruwǝ wǝ́ pǝ kǝ ŋ pǝ́ pǝ wɛɛlɩ mǝ ŋwǝ. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Wǝ́ nyiyǝ rɛ ŋ tìi Yesu ǝkǝnǝŋ: «Yɩrɩ re! Lé lee mǝ lá apaanʊpǝ pǝ yaa rǝ koruwǝ ǝnǝ! Pǝ ya pǝ lǝ́ǝ pǝ́ pǝ wɛɛlɩ mǝ lǝ́.»<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊrɛɛkpǝ lǝ mǝrǝ.</char></note> <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Wǝ́ Yesu ŋ pǝ̀ nyiyǝ sa ŋ pǝlǝ ŋ tìi no tuwǝ sa ǝkǝnǝŋ: «Ǝlǝ ŋ ri mǝ lee? Wǝ́ ǝpǝ rǝ fǝŋ pǝ ri mǝ apaanʊpǝ?» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Wǝ́ ŋ kàa no otukarǝtǝpǝ we la akaakǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «A lǝŋ nyɩŋ! Mǝ lee mǝ mǝ apaanʊpǝ wǝǝ. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Duturǝ ɖi yǝ we ŋ ya ŋ née yee mǝ Tǝ ŋ kpii rǝ yulaarǝ lǝ kǝǝpǝ́wǝ we, ŋwǝ ŋ ri mǝ paanʊyǝ, mǝ paatɛyǝ, mǝ mǝ leeyǝ wǝ.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ tɛɛtɛɛkpɛŋtǝyǝ rɛ</para>
  <para style="r">(<ref loc="MRK 4:1-9">Marǝko 4:1-9</ref>, <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Ŋrǝ jirǝ we we, wǝ́ Yesu ŋ rù rǝ nyarǝwǝ ŋ kolu ŋ tini rǝ puŋkɔwǝ la kǝlɛɛrɩkǝ. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ pǝlǝ wǝ kù rǝ nǝ kpǝŋ, wǝ kǝto ŋ kolu ŋ fìi gʊrɔrǝ rɛ ŋ tini wǝǝ. Nyikpǝŋwǝ we kpǝlo kɩɩkɩ wǝ ka yaa rǝ kǝpǝŋpǝŋkǝ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Wǝ́ ŋ wɛ̀ɛlɩ ŋ rù rǝ otuyǝ kǝkpǝŋkǝ ŋ tìi pǝ saŋ rǝ otutucayǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Tɛɛtɛɛkpɛŋtǝyǝ rɛ kolu ŋ ka caŋ otuyǝ rǝ na atɛɛkǝ. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Kǝ́ ŋ ya ŋ nóo co otuyǝ we we, wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ kʊŋlɛɛrɩwǝ yǝ kolu. Wǝ́ ofuripǝ pǝ pǝlǝ pǝ sìeni yǝ pǝ pɔ̀ɔlʊ kɩɩkɩ. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ zwiɛŋrǝ la fɛɛwǝ, kǝnyaanǝkǝ kǝ laa naanǝ rǝ fɛɛwǝ sa. Wǝ́ epiyǝ sa yǝ wìili kǝtǝrǝceŋceŋ kpiikǝ kǝtǝǝwǝ we wǝ loo ko suunu kǝto. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kǝ́ cɔkɔŋyǝ ŋ no kuu we, wǝ́ ŋ yeli yǝ. Wǝ́ yǝ kpǝ̀, kpiikǝ yǝ lǝǝ lǝmǝ okuruŋkuyǝ kǝ yǝ naanǝ kǝto. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ owuyǝ la fɛɛwǝ. Kǝ́ owuyǝ we yǝ le yi we, wǝ́ yǝ lɔ̀ epiyǝ we yǝ le wiili wǝ. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Wǝ́ epirɛɛyǝ yǝ tɔ̀ɔlʊ rǝ kǝtǝǝceeceewǝ. Wǝ́ yǝ nyɩnɩ ǝtǝnǝyǝ, arɛɛyǝ tuuru, arɛɛyǝ tǝkʊraŋ, arɛɛyǝ tǝta.» <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Yǝ we ŋ lǝǝmǝ otukoŋyǝ ŋ nóo nuŋ tuwǝ we, ŋ nuŋ oo!»<verse eid="MAT 13:9" /></para>
  <para style="s">Tuwǝ kǝto Yesu ŋ náa wɛɛlɩ mǝ ŋ ca rǝ otutuyǝ wǝ</para>
  <para style="r">(<ref loc="MRK 4:10-12">Marǝko 4:10-12</ref>, <ref loc="LUK 8:9-10">Luka 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ Yesu. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ a ya láa wɛɛlɩ a mǝ ŋ ca pǝ rǝ otutuyǝ ǝnǝ?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝ we, Worokoyǝ lo koonu nǝ nǝ ci yulaarǝ le wǝpilirikpǝ we lo otuŋwaayǝ. Paa ǝpǝ ǝnǝ we, loo koonu pǝ pǝ ci yǝ. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Duturǝ ɖi yǝ we ŋ lǝǝmǝ tuwǝ we, pǝ lǝ́ǝ tǝ pǝ koonu ŋwǝ pǝ kʊla, kǝ ŋ nya fɛɛ ŋ lǝmǝ ŋpa. Paa yǝ we ŋ nǝǝ lǝmǝ tǝrɛ we, pǝ láa lɔ tuwǝ rǝ ŋwǝ, mǝŋ pipiwǝ we wǝ kpɛlɩ ŋwǝ wǝ. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Wǝ kǝto ŋ́ ya ŋ́ náa wɛɛlɩ mǝ ŋ ca pǝ rǝ otutuyǝ wǝǝ. Kpiikǝ pǝ ya pǝ láa yɩrɩ paape pǝ lǝŋ nyɩŋ. Wǝ́ pǝ ya pǝ lóo co otukoŋyǝ paape pǝ laa ya pǝ lóo nuŋ wǝ́ pǝ lǝŋ lɛ pǝ nuŋ tǝrɛ lo duturǝ. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Worokokpɛɛnuŋtɛŋtǝyǝ Ezaya lo tuwǝ we ŋ tɛnɩ wǝ ya wǝ lǝ́ǝ pǝ wǝ ŋ tuu pǝ ǝnǝ! Tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 13:14">“Nǝ nyoh mǝ nuŋ tuwǝ sɩsiɛrɩ paape nǝ nyǝŋ nuŋ wǝlo duturǝ!</para>
  <para style="q1" vid="MAT 13:14">Nǝ nyah mǝ yɩrɩ tuwǝ mǝŋkǝsa paape nǝ nyǝŋ nyɩŋ tǝrɛ!<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Duturǝ ɖi kǝkpǝŋkǝ sa lo yurǝ la lɛnyɩ,</para>
  <para style="q1" vid="MAT 13:15">pǝ lǝ tǝnǝ kǝtukoŋkǝ!</para>
  <para style="q1" vid="MAT 13:15">Pǝ la lɔ enimiyǝ pǝ le simi,</para>
  <para style="q1" vid="MAT 13:15">kǝ pǝle enimiyǝ sa yǝ paa nya fɛɛ yǝ nyɩŋ,</para>
  <para style="q1" vid="MAT 13:15">kǝ pǝlo otukoŋyǝ yǝ poo nuŋ,</para>
  <para style="q1" vid="MAT 13:15">kǝ pǝla mɔlɩɩyǝ ŋ poo nuŋ tǝrɛ lo dutu!</para>
  <para style="q1" vid="MAT 13:15">Mǝŋkǝsa we, kǝ pǝ paa nya fɛɛ pǝ siɛnɩ pǝ pǝ mǝ kpǝŋ kǝ ŋ́ pa cá pǝ.”<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Ŋnǝ paa we, nǝ nyo co yǝ kpiikǝ nǝ enimiyǝ yǝ láa nyɩŋ, wǝ́ nǝ otukoŋyǝ yǝ lóo nuŋ! <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, oworokokpɛɛnuŋtɛŋtǝpǝ wa, mǝ enyikʊʊpǝ wa pǝ lǝ pǝ́ pǝ ka nyɩŋ tuwǝ sa nǝ ya nǝ nyáa nyɩŋ wǝ, paape pǝ laa nya wǝ pǝ nyɩŋ! Pǝ lǝ pǝ́ pǝ ko nuŋ tuwǝ sa nǝ ya nǝ nyóo nuŋ wǝ, paape pǝ laa nya wǝ pǝ nuŋ!»<verse eid="MAT 13:17" /></para>
  <para style="s">Yesu la pɔrʊ duturǝ we ŋ na ca lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MRK 4:13-20">Marǝko 4:13-20</ref>, <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«Nǝ co kǝtukoŋkǝ, ŋ́ náa pɔrʊ duturǝ sa ŋ́ na ca ŋ́ no ru rǝ tɛɛtɛɛkpɛŋtǝyǝ we, lǝ mǝrǝ ŋ́ tíi nǝ. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Epǝ we pǝ lóo nuŋ Worokoyǝ le wǝpilirikpǝ we le dierǝ, ǝkǝ pǝ lǝŋ nuŋ rǝlo duturǝ we, pǝ lǝ rǝ mǝŋ kʊŋlɛɛrɩwǝ we epirɛɛyǝ yǝ tɔ̀ɔlʊ yǝ kolu wǝ. Vǝ́ Abʊŋsamʊyǝ lǝ pǝ we, ŋ ta tuwǝ we pǝ la rʊ rǝ pǝla ziɔŋrǝ ŋ pɔrʊ. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Arɛɛpǝ pǝ lǝ rǝ mǝŋ zwiɛŋrǝ lǝ kǝtǝǝwǝ we epirɛɛyǝ yǝ la tɔɔlʊ wǝ. Vǝ́ pǝ lo nuŋ dierǝ sa we, pǝ ŋ lɔ rǝ kǝtǝrǝceŋceŋ mǝ faawǝ. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Paa pǝ lǝŋ maa dierǝ sa ɖu okuruŋkuyǝ rǝ pǝlǝ mǝrǝ. Pǝ láa lɔ pǝ ŋ nuŋ rǝ enipiyǝ rɛ lǝ mǝrǝ ko. Vǝ́ acʊcʊʊrʊyǝ yǝ lo tuu pǝ amaa pǝ le yi pǝ la tɛɛ rǝ pǝ rǝ ŋrǝ Worokoŋtierǝ sa kǝto we, kalaŋ, pǝ ŋ nyarǝ lɔnuŋrǝ pǝ co. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Arɛɛpǝ pǝ lǝ rǝ mǝŋ owuyǝ lǝ kǝtǝǝwǝ we epirɛɛyǝ yǝ la tɔɔlʊ wǝ. Ŋpǝ pǝ kaamǝ enyipǝ we pǝ lóo nuŋ Worokoŋtierǝ we, paape ǝrǝkǝ sa lo oyupuyǝ mǝ otulǝmǝyǝ sa yǝ lǝ́ǝ tǝǝnǝ nyiyǝ we, yǝ láa lɔ dierǝ sa oturu lǝŋ tɛɛ mǝ ǝtǝnǝyǝ. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Arɛɛpǝ pǝ lǝ mǝŋ kǝtǝǝceeceewǝ we epirɛɛyǝ yǝ tɔ̀ɔlʊ kǝtǝ. Ŋpǝ pǝ kaamǝ epǝ we pǝ lóo nuŋ Dierǝ we, pǝ ŋ nuŋ rǝ lo duturǝ. Pǝ láa nyɩŋ ǝtǝnǝyǝ, arɛɛpǝ tuuru, arɛɛpǝ tǝkʊraŋ, arɛɛpǝ tǝta.»<verse eid="MAT 13:23" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ bɔɔrɔɔrɔɔrǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Wǝ́ Yesu ŋ tǝ ŋ cà dutupʊŋpwarǝ rɛ ŋ tìi pǝ ǝkǝnǝŋ: «Yulaarǝ le wǝpilirikpǝ we wǝ lo ru nyiyǝ rɛ ŋ na rʊʊ oturʊʊpiceeceeyǝ rɛ rǝ na atɛɛkǝ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Eniyǝ we nyi ri ŋ nyi ŋ na kpɛɛ we, wǝ́ nǝ kǝǝkpǝlǝtǝyǝ ŋ na pa rʊʊ bɔɔrɔɔrɔɔrǝ rɛ ŋ na kʊla mǝ oturʊʊpiceeceeyǝ we. Wǝ́ ŋ na pwɛyɩ. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kǝ́ oturʊʊyǝ sa yǝ le wiili yǝ la naanǝ wǝ́ yǝ le tie anyɩŋkǝ we, wǝ́ bɔɔrɔɔrɔɔrǝ we ŋrǝ ŋkpɛ ga ŋ nyɩnɩ. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Wǝ́ tɛɛlǝtǝyǝ sa la asʊmatǝpǝ pǝ pǝlǝ pǝ tìi ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, oturʊʊpiceeceeyǝ wǝ́ a rʊ̀ʊ rǝ lá atɛɛkǝ we, amaa? Wǝ́ bɔɔrɔɔrɔɔrǝ sa lo ru rǝ fǝŋ?” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: “Kǝǝkpǝlǝtǝyǝ rɛ ŋ ne yee wǝ ǝnǝ.” Wǝ́ asʊmatǝpǝ we pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: “Ǝ lǝ pǝ́ lo ko lo ko nuuru bɔɔrɔɔrɔɔrǝ we la cɛ?” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Wǝ́ kulǝtǝyǝ we ŋ yìili ǝkǝnǝŋ: “Ow! Duturǝ ɖi mǝŋ nǝ nya ka ya nǝ nyóo nuuru bɔɔrɔɔrɔɔrǝ we we, nǝ nyoh po ko nuuru oturʊʊpiceeceeyǝ we nǝ kʊla mǝ bɔɔrǝ sa. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Nǝ maa yǝlo kpǝlo yǝ ŋ naanǝ. Vǝ́ eniŋceyǝ yǝ lo ro we, ŋ́ née tíi ecetǝpǝ we pǝ pɔrʊ bɔɔrɔɔrɔɔrǝ we kpɛŋ, kǝ pǝ parǝ rǝ mǝ otoyǝ pǝ tu naawǝ. Wǝla kǝmaakǝ we kǝ pǝ wʊʊ ekeeripiyǝ we pǝ ke kpii rǝ mǝ wulǝŋwǝ.”»<verse eid="MAT 13:30" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ durʊʊŋɩnɩŋɩnɩpirǝ rɛ</para>
  <para style="r">(<ref loc="MRK 4:30-32">Marǝko 4:30-32</ref>, <ref loc="LUK 13:18-19">Luka 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Wǝ́ Yesu ŋ tǝ ŋ cà pǝ lo dutupʊŋpwarǝ rɛ ǝkǝnǝŋ: «Yulaarǝ le wǝpilirikpǝ we wǝ lo ru durʊʊŋɩnɩŋɩnɩpirǝ rɛ nyiyǝ rɛ ŋ nǝ fǝ ŋ na ka rʊʊ rǝ na atɛɛkǝ. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Durʊʊpirǝ sa ɖi oturʊʊpiyǝ kpǝlo kɩɩkɩ le bipipipirǝ, paape kǝ́ le wi we, ŋrǝ le pe yee guŋmumuŋrǝ rǝ oturʊʊyǝ we lo okuŋyǝ mǝrǝ kpǝlo kɩɩkɩ rǝ atɛɛkǝ sa. Le yee wǝciikpǝ wǝ́ ofuripǝ pǝ ya pǝ lǝ́ǝ pǝ pǝ ŋ co pǝlo okuyǝ rǝ wǝla alaŋyǝ rǝ!»<verse eid="MAT 13:32" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ dafaŋrǝ</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luka 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Wǝ́ Yesu ŋ tǝ ŋ cà pǝ lo duturǝ rɛ ǝkǝnǝŋ: «Yulaarǝ le wǝpilirikpǝ wǝ lǝ rǝ mǝŋ dafaŋrǝ tieyǝ rɛ ŋ na tʊʊ ŋ nǝ fǝ ŋ no furu fuŋtumumuŋwǝ rɛ. Wǝ́ fuŋtuwǝ we kpǝlo kɩɩkɩ wǝ lo fuunu.»<verse eid="MAT 13:33" /></para>
  <para style="s">Kǝ́ kǝto wǝ́ Yesu ŋ náa wɛɛlɩ mǝ ŋ ca rǝ otutuyǝ wǝ</para>
  <para style="r">(<ref loc="MRK 4:33-34">Marǝko 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Wǝ́ Yesu ŋ ke ŋ tíi wǝnyikpǝŋkpǝ sa lo otuyǝ sa kpǝlo kɩɩkɩ saŋ rǝ otutuyǝ. Laa ka ŋ tɛŋ tǝrɛ mǝ ŋ tíi pǝ kǝ oturu laa wɛɛlɩ ŋ saŋ rǝ otutuyǝ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ke ŋ yee wǝ ǝnǝ kǝ worokokpɛɛnuŋtɛŋtǝyǝ lo tuwǝ ŋ tɛnɩ wǝ nya fɛɛ wǝ pǝ. Tɛnɩ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 13:35">«Ŋ́ nah mǝ wɛɛlɩ mǝ ŋ ca rǝ otutuyǝ.</para>
  <para style="q1" vid="MAT 13:35">Ŋ́ nah mǝ tɛŋ otuyǝ we yǝ la ŋwaa ru ǝrǝ kǝ́ Worokoyǝ ŋ cò ǝrǝkǝ wǝ.»<verse eid="MAT 13:35" /></para>
  <para style="s">Yesu la pɔrʊ duturǝ we ŋ na ca ŋ no ru rǝ bɔɔrɔɔrɔɔrǝ we, lǝ mǝrǝ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Wǝ́ Yesu ŋ pwɛ̀yɩ rǝ kǝkpǝŋkǝ we lǝ kpǝŋ. Wǝ́ ŋ ko ŋ ko nyarǝwǝ. Wǝ́ no otukarǝtǝpǝ we pǝ rùu pǝ kǝlǝ mǝ ŋwǝ, wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pɔrʊ duturǝ we a la ca o lo ru rǝ bɔɔrɔɔrɔɔrǝ we rǝ atɛɛkǝ lǝ mǝrǝ e tíi lǝ.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Wǝ́ Yesu ŋ kpǝ̀lǝŋ ŋ tìi pǝ ǝkǝnǝŋ: «Yǝ we ŋ ya ŋ náa rʊʊ oturʊʊpiceeceeyǝ we, ŋwǝ ŋ kaamǝ Nyɩmaasɩ le Pi. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Atɛɛkǝ we kǝ kaamǝ ǝrǝkǝ sa. Oturʊʊpiceeceeyǝ we yǝ kaamǝ epǝ we pǝ kpii pǝ koonu yulaarǝ le wǝpilirikpǝ we wǝ. Bɔɔrɔɔrɔɔrǝ we gaamǝ enyipǝ we pǝ kpii pǝ koonu Abʊŋsamʊyǝ wǝ. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Kǝǝkpǝlǝtǝyǝ we ŋ na rʊʊ bɔɔrɔɔrɔɔrǝ we ŋ kaamǝ Abʊŋsamʊyǝ. Eniŋceyǝ we yǝ kaamǝ ǝrǝkǝ la alɛɛkǝ, wǝ́ ecetǝpǝ we pǝ kaamǝ epicoŋpipǝ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Mǝŋ kǝ́ pǝ lóo nuuru bɔɔrɔɔrɔɔrǝ pǝ ŋ kpii rǝ naawǝ we, kǝ́ wǝ lǝh pǝ lǝ mǝ ǝrǝkǝ la alɛɛkǝ wǝǝ. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Nyɩmaasɩ le Pi leh pe kpii ne epicoŋpipǝ ŋ maŋ. Pǝ lah pa pɔrʊ epǝ we pǝ lo tu pǝlǝ ǝtǝŋpǝ pǝ le kpii rǝ turɔɔrɔɔwǝ, mǝ epǝ we kpǝlo kɩɩkɩ pǝ lée yee turɔɔrɔɔwǝ we pǝ cɛ rǝ ne wǝpilirikpǝ we lǝ mǝrǝ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Kǝ pǝ tie pǝ pǝ kpii rǝ naamumuŋwǝ we lǝ mǝrǝ. Fɛɛwǝ enyipǝ wa pǝ loh ko pǝ ke wee kǝ pǝ wo oroŋciiyǝ wǝǝ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Paa epǝ we pǝ kʊʊ rǝ Worokoyǝ le enimiyǝ we, pǝ lah mǝ nyɔŋ mǝŋ cɔkɔŋyǝ kǝtǝ rǝ pǝlǝ Tǝ le wǝpilirikpǝ we mǝrǝ. Yǝ we ŋ lǝǝmǝ otukoŋyǝ ŋ nóo nuŋ tuwǝ we, ŋ nuŋ oo!»<verse eid="MAT 13:43" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ otulǝmǝyǝ we yǝ la ŋwaa wǝ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Yulaarǝ le wǝpilirikpǝ we wǝ lǝ rǝ mǝŋ otulǝmǝyǝ rɛ pǝ lǝ fǝ pǝ la ka ŋwaa rǝ atɛɛkǝ rɛ. Wǝ́ nyiyǝ rɛ ŋ na ka nyɩŋ otulǝmǝyǝ sa. Wǝ́ nyiyǝ sa ŋ nǝ fǝ yǝ ŋ nǝ tǝ ŋ na ŋwaa, wǝ́ ŋ na nya faawǝ ŋpa, wǝ lo koonu wǝ́ ŋ ne ke siiri no otulǝmǝyǝ kpǝlo kɩɩkɩ. Wǝ́ ŋ na siɛnɩ ŋ no po fuu atɛɛkǝ we.<verse eid="MAT 13:44" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ okurutulaayǝ rɛ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«Yulaarǝ le wǝpilirikpǝ we wǝ tǝ wǝ lǝ rǝ mǝŋ raasaŋtǝyǝ rɛ ŋ ya ŋ náa taa otulaaceeceeyǝ rɛ kǝtǝ. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Wǝ́ ŋ na ka nya kurutulaawǝ rɛ. Wǝ́ ŋ ne ke siiri no otulǝmǝyǝ kpǝlo kɩɩkɩ ŋ nǝ fǝ ŋ no ko fuu tulaawǝ sa.»<verse eid="MAT 13:46" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ safʊyǝ rɛ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«Yulaarǝ le wǝpilirikpǝ we wǝ lǝ tǝ wǝ lo ru safʊyǝ pǝ le tie pǝ le kpii rǝ puŋkɔwǝ. Láa lɔ wǝpwɛɛ ri ŋ wǝpwɛɛ. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Vǝ́ lǝ lǝ we, asafʊcotǝpǝ we pǝ ŋ tiini ŋwǝ pǝ pǝ tǝnǝ rǝ kǝpǝŋpǝŋkǝ. Pǝ ŋ sɔ pǝ tii pǝ saa kpǝ. Pǝ ŋ wʊʊ wǝceeceekpǝ we pǝ kpii rǝ akɛŋtɛyǝ. Ǝ pǝ ŋ fǝ gbǝ we wǝ lǝŋ poŋ eyee tǝrɛ pǝ co. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Kǝ́ wǝ lǝh pǝ lǝ mǝ ǝrǝkǝ la alɛɛkǝ wǝǝ! Epicoŋpipǝ pǝ lóo ru pǝ pǝ, pǝ pa saa enyirɔɔrɔɔpǝ pǝ cɛ rǝ enyikʊʊpǝ lǝ kpǝŋ. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Kǝ pǝ tie pǝ pǝ kpii rǝ naamumuŋwǝ we lǝ mǝrǝ. Fɛɛwǝ enyipǝ wa pǝ loh ko pǝ ke wee kǝ pǝ wo oroŋciiyǝ wǝǝ.»<verse eid="MAT 13:50" /></para>
  <para style="s">Otulǝmǝŋwɛŋyǝ mǝ okuukuuyǝ</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nyo nuŋ otuyǝ sa kpǝlo kɩɩkɩ lo duturǝ?» Wǝ́ pǝ yìili ǝkǝnǝŋ: «Awo!» <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Wǝ́ Yesu ŋ tǝ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝto we, sekaŋtǝyǝ le yǝ we ŋ na siɛrɩ ŋ ne yee yulaarǝ le wǝpilirikpǝ we lo tukarǝtǝyǝ we, lǝ rǝ mǝŋ nyarǝlǝtǝyǝ rɛ ŋ ya ŋ náa pɔrʊ otuŋwɛŋyǝ mǝ okuukuuyǝ mǝ ŋ ru rǝ fɛɛwǝ we ŋ nǝ tǝnǝ no otulǝmǝyǝ wǝ».<verse eid="MAT 13:52" /></para>
  <para style="s">Yesu lǝ ǝtǝŋtǝǝtǝpǝ pǝ laa lɔ Yesu pǝ nuŋ</para>
  <para style="r">(<ref loc="MRK 6:1-6">Marǝko 6:1-6</ref>, <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Kǝ́ Yesu ŋ na ca otutuyǝ sa ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Wǝ́ ŋ ko ŋ ko nǝ tǝŋtǝǝwǝ. Wǝ́ ŋ kolu ŋ yà ŋ ka ŋ kaŋ enyipǝ lo otuyǝ rǝ pǝlo gumwɛŋnyuŋkpǝ. Wǝ́ wǝ rili enyipǝ we kpǝlo kɩɩkɩ lo mumuŋ, wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Fǝŋ wǝ́ ŋ na nya otuciyǝ sa ŋ no ru? Wǝ́ fǝŋ wǝ́ ŋ na nya okopiyǝ ŋ ya ŋ née yee otucovurǝ sa ǝnǝ? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Kǝto ŋkǝ kusiitǝyǝ we le piyǝ ŋ lǝǝwe? Ŋkǝ ne lee ǝrǝ Marɩya? Ŋkǝ na apaanʊpǝ pǝ kaamǝ Yakubu, Yosɛfʊ, Sɩmɔ mǝ Yuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Mǝŋkǝ na apaatɛpǝ kpǝlo kɩɩkɩ pǝ kpii rǝ lǝh mǝrǝ? Wǝ́ fǝŋ wǝ́ ŋ na nya okopiyǝ sa ŋ no ru?» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Wǝ́ pǝ sǝ́nǝ pǝ laa lɔ ŋwǝ pǝ nuŋ. Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Pǝ lóo pu worokokpɛɛnuŋtɛŋtǝyǝ rǝ fɛɛ ri ŋ fɛɛ, we tɛŋ nǝ gǝŋrǝ mǝ na nyarǝwǝ ceŋceŋ.» <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kǝto Yesu lee yee otucovurǝ kpaa rǝ fɛɛwǝ we, kpiikǝ pǝ laa lɔ ŋwǝ pǝ nuŋ wǝ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Erodɛsɩ Aŋtipa lo nuŋ Yesu la nyɩŋrǝ</para>
  <para style="r">(<ref loc="MRK 6:14-16">Marǝko 6:14-16</ref>, <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Rǝ eniyǝ we lǝ mǝrǝ we, anyɩŋ Erodɛsɩ Aŋtipa ŋ ke ri kǝŋyɩrɩtǝyǝ rǝ Galileya. Wǝ́ ŋ nunu Yesu la nyɩŋrǝ. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Wǝ́ ŋ tìi na asʊmatǝpǝ ǝkǝnǝŋ: «Nyiyǝ sa we, Yowanɛsɩ worokomɛŋwiiritǝyǝ we ŋ lǝǝwe. La saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ! Wǝ kǝto ŋ na nya okopiyǝ ŋ ya ŋ née yee otucovurǝ wǝǝ.»<verse eid="MAT 14:2" /></para>
  <para style="s">Yowanɛsɩ worokomɛŋwiiritǝyǝ we lǝ ǝkpǝ́kǝ</para>
  <para style="r">(<ref loc="MRK 6:17-29">Marǝko 6:17-29</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Rǝ anʊkɔrǝyǝ we, Erodɛsɩ ŋ kòonu pǝ lɔ̀ Yowanɛsɩ, pǝ pàrǝ ŋwǝ mǝ akpɛtɛɛyǝ wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ tanǝ rǝ gukpɛɛkpǝ. Yeli wǝ ǝnǝ rǝ ne mǝtee Filipo le tie Erodia lo yurǝ. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Duturǝ ɖi Yowanɛsɩ sǝ́nǝ kòonu ŋwǝ ǝkǝnǝŋ: «Gʊŋrǝ lee kpii goonu lǝ́ kǝ ǝ fǝ Erodia a lɔ wǝtiekpǝ!» <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Erodɛsɩ kǝ ŋ pǝ́ ŋ wʊ Yowanɛsɩ, paape ko ŋ suu Oyudatǝpǝ lǝ kǝkpǝŋkǝ lo vurǝ. Duturǝ ɖi pǝ ka ŋ nyɩŋ wǝ ǝkǝnǝŋ worokokpɛɛnuŋtɛŋtǝyǝ wǝ́ Yowanɛsɩ ŋ ri. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Paa jirǝ we Erodɛsɩ ŋ ke ŋ ri ne jimǝrǝ la wǝcɛkpǝ we, wǝ́ Erodia la gɔrʊpirǝ yà go ŋ yo rǝ enyipǝ we ŋ pwò pǝ pǝlǝ la kǝnyɩŋkǝ. Wǝ́ no tuwǝ wǝ cà Erodɛsɩ la kpɛɛ ŋpa! <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Wǝ́ ŋ tù ŋ tìi gɔrʊpirǝ sa ǝkǝnǝŋ tu ri ŋ tu ŋ nǝ́ǝ pǝ́ ŋwǝ we, ŋ nóo koonu nǝ wǝ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Wǝ́ ne leeyǝ ŋ tù ŋwǝ ŋ kpìi ŋ pe tíi Erodɛsɩ ǝkǝnǝŋ: «Ka tɛɛ Yowanɛsɩ worokomɛŋwiiritǝyǝ we lo yurǝ rǝ kpɛtɛlɛyǝ o po koonu mǝ rǝ fɛɛwǝ sa!» <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Wǝ́ tuwǝ sa wǝ fǝ̀rǝ piliyǝ ŋpa, paape kǝ́ ŋ tù ŋ tǝ̀nǝ rǝ enyipǝ we ŋ pwòolu le enimiyǝ kǝto we, wǝ́ ŋ tɛ̀ɛnɩ pǝ ke yee tuwǝ we ŋ nǝ pǝ́ pǝ po koonu ŋwǝ. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Wǝ́ ŋ kpìi pǝ kolu pǝ sǝ̀ Yowanɛsɩ worokomɛŋwiiritǝyǝ we lo yurǝ rǝ gukpɛɛkpǝ we. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Wǝ́ pǝ tɛ̀ɛ yurǝ we rǝ kpɛtɛlɛyǝ pǝ pǝlǝ pǝ kòonu gɔrʊpirǝ sa. Wǝ́ ŋ fǝ̀ rǝ ŋ kolu ŋ kòonu ne leeyǝ. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Wǝ́ Yowanɛsɩ lo otukarǝtǝpǝ we pǝ pǝlǝ pǝ fǝ̀ Yowanɛsɩ le kǝnyiǝtǝkǝ we pǝ kolu pǝ ŋwàa. Wǝ́ pǝ kolu pǝ tìi Yesu lo tuwǝ sa.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu lo koonu enyipǝ lafawǝ tʊʊ mǝ otuyǝ le keeriwǝ pǝ le ri</para>
  <para style="r">(<ref loc="MRK 6:30-44">Marǝko 6:30-44</ref>, <ref loc="LUK 9:10-17">Luka 9:10-17</ref>, <ref loc="JHN 6:1-14">Yowanɛsɩ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Kǝ́ Yesu ŋ no nuŋ dierǝ sa we, wǝ́ ŋ fìi gʊrɔrǝ ŋ pwɛ̀yɩ ŋ ko ŋ ko fɛɛwǝ rɛ nyiyǝ ŋ nǝǝ kǝlǝ ŋwǝ ceŋceŋ. Paape wǝ́ wǝnyikpǝŋkpǝ wǝ nunu wǝ. Wǝ́ pǝ rù rǝ ǝtǝŋtǝǝyǝ pǝ sanǝ rǝ kǝpǝŋpǝŋkǝ pǝ sìimǝ Yesu. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Kǝ́ Yesu ŋ no ru rǝ gʊrɔrǝ we we, wǝ́ ŋ nyɩnɩ nyikpǝŋmumuŋwǝ rɛ! Wǝ́ pǝlo tuwǝ wǝ cò na tǝlarǝwǝ, wǝ́ ŋ yà ŋ ka ŋ cá pǝla anyarǝpiyǝ. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Kǝ́ ɖiɔrǝ lo ro we, wǝ́ no otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ lah ta kǝ cɩɩ, wǝ́ nyarǝwǝ rɛ wǝ lǝǝ kǝlǝ mǝ fɛɛwǝ sa la yaa wǝ. Kǝto co enyipǝ sa la kʊŋ kǝ pǝ nya fɛɛ pǝ ko ǝtǝŋtǝǝpiyǝ pǝ ko fuu keeriwǝ pǝ ri.» <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Wǝ lǝǝ pǝ́ kǝ pǝ pwɛyɩ, ŋnǝŋnǝ nǝ koonu pǝ pǝ ri!» <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kpɔnɔyǝ tʊʊ mǝ wǝpwɛɛkpǝ wǝyi ko wǝ́ le re rǝ sa.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ fǝ yǝ nǝ po koonu mǝ.» <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Wǝ́ ŋ tìi nyikpǝŋwǝ we wǝ sɔ wǝ tii rǝ bɔɔrǝ. Wǝ́ ŋ fǝ̀ kpɔnɔyǝ we na tʊʊ mǝ wǝpwɛɛkpǝ we wǝle wǝyi. Wǝ́ ŋ yìili ŋ yɩ̀rɩ yulaarǝ, wǝ́ ŋ mwɛnɩ nyuŋkpǝ ŋ pɛ̀ɛrɩ kpɔnɔyǝ we mǝ wǝpwɛɛkpǝ we. Wǝ́ ŋ pòolu kpɔnɔyǝ we, wǝ́ ŋ fǝ̀ ŋ kòonu no otukarǝtǝpǝ we pǝ fǝ̀ pǝ sǝ̀pǝ nyikpǝŋwǝ we. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Wǝ́ nyi ri ŋ nyi ŋ rili ŋ wulu. Wǝ́ pǝ rɛ̀mɩ otoopiyǝ we yǝ lo turu kɛŋtɛwǝ tǝ mǝ yi pwɩpwɩ pǝ rè pǝ pwɛ̀yɩ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Enyipǝ we pǝ rili we, ǝpǝrǝŋpǝ lo kuruyuwǝ wǝ lǝh mǝ lǝ mǝŋ lafawǝ tʊʊ. Pǝ lǝǝ kǝ etiepǝ mǝ epipǝ.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu la saŋ rǝ mɛŋwǝ lo oŋuŋkǝ</para>
  <para style="r">(<ref loc="MRK 6:45-52">Marǝko 6:45-52</ref>, <ref loc="JHN 6:16-21">Yowanɛsɩ 6:16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Kǝtǝrǝceŋceŋ wǝ́ Yesu ŋ ko ŋ tu no otukarǝtǝpǝ we rǝ, pǝ fìi gʊrɔrǝ pǝ coŋ pǝ ŋ ta puŋkɔwǝ we la kǝtakǝ nɔ, kǝ ŋwǝ paa mǝ ŋ co nyikpǝŋwǝ we la kʊŋ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Kǝ́ ŋ no co nyikpǝŋwǝ we la kʊŋ ŋ na lɛ we, wǝ́ ŋ rɛ̀ dutupirǝ ŋ ka mwɛŋ nyuŋkpǝ. Ǝrǝkǝ kǝ la cɩɩ, Yesu ceŋceŋ ŋ no tuuru ŋ yaa rǝ fɛɛwǝ we. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Rǝ eniyǝ we lǝ mǝrǝ we, anyɩŋ gʊrɔrǝ we lǝ lǝǝrǝ mǝ kǝtǝǝwǝ ŋpa. Wǝ́ mɛŋwǝ wǝ ke ŋ yi wǝ ŋ ca gʊrɔrǝ sa duturǝ ɖi ǝrǝkǝ kǝ ko ŋ fuŋ kǝ ŋ pǝ kǝ ŋ kumǝ gʊrɔrǝ sa rǝ. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Kǝ́ kǝ lah ta kǝ kaalǝ we, wǝ́ Yesu ŋ kolu ŋ ru ŋ kǝ ŋ pǝ no otukarǝtǝpǝ we lǝ kpǝŋ, sanǝ rǝ mɛŋwǝ lo oŋuŋkǝ lǝ́ǝ pǝ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Kǝ́ pǝ la nyɩŋ ŋwǝ ŋ sanǝ rǝ mɛŋwǝ lo oŋuŋkǝ ŋ nǝ́ǝ pǝ we, wǝ́ pǝ fìi vurǝ ŋpa. Wǝ́ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Nyiǝtǝyǝ ŋ lǝǝwe!» Wǝ́ pǝ ya pǝ ka ŋ lɔ anarǝyǝ. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Kǝtǝrǝceŋceŋ wǝ́ Yesu ŋ wɛ̀ɛlɩ mǝ pǝ ǝkǝnǝŋ: «Nǝ ta nǝ wɛ, ŋmǝ ŋ́ lǝǝwe, nǝ poo suu vurǝ!» <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Wǝ́ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ kǝceece ŋlǝ́ ǝ lǝǝwe we, tíi mǝ ŋ́ saŋ rǝ mɛŋwǝ sa lo oŋuŋkǝ ŋ́ po tuu lǝ́.» <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ pǝ!» Wǝ́ Pɛtǝro ŋ rù rǝ gʊrɔrǝ we ŋ sanǝ rǝ mɛŋwǝ we lo oŋuŋkǝ ŋ ko ŋ ko Yesu lǝ kpǝŋ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Paa kǝ́ ŋ na nyɩŋ kǝ́ ǝrǝkǝ we kǝ ya kǝ lóo fuŋ mǝ okopiyǝ we, wǝ́ ŋ sùu vurǝ. Wǝ́ ŋ tìe ǝnǝŋkǝ rǝ mɛŋwǝ we. Wǝ́ ŋ cà narǝwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, lɔ o koonu mǝ oo!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Kǝtǝrǝceŋceŋ wǝ Yesu ŋ kòonu kǝnukǝ ŋ tà ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «A laa tɛɛ kpɛɛwǝ rǝ mǝ ŋpa! Kǝ́ kǝto wǝ́ ǝ lǝ tǝmǝlǝ wǝ?» <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Wǝ pǝle eyi pǝ fìi gʊrɔrǝ we, wǝ́ ǝrǝfuŋkǝ we kǝ rǝnǝ. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Wǝ́ otukarǝtǝpǝ we kpǝlo kɩɩkɩ pǝ ke kpii rǝ gʊrɔrǝ we pǝ sʊ̀ʊ pǝ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ. Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Kǝceece, Woroko le Pi wǝ́ e ri!»<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu la cá anyaatǝpǝ rǝ Genezarɛtǝ la gaarǝ we</para>
  <para style="r">(<ref loc="MRK 6:53-56">Marǝko 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Kǝ́ pǝ la ka ta puŋkɔwǝ sa pǝ la lɛ we, wǝ́ pǝ fìi Genezarɛtǝ la gaarǝ. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Wǝ́ fɛɛwǝ we le enyipǝ pǝ nyɩnɩ Yesu pǝ cìi, wǝ́ pǝ tɛnɩ wǝ pǝ tɛlɩ rǝ gaarǝ we kpǝlo. Wǝ́ pǝ kǝ ŋ fǝ anyaatǝpǝ kpǝlo kɩɩkɩ pǝ ŋ pǝ nǝ kpǝŋ. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Wǝ́ pǝ ka ŋ tɔɔ pǝ ŋ kpɛɛ ŋwǝ ŋ maa pǝ pǝ rɔsɩ pǝ ruu na kǝkpakǝ la laawǝ rǝ ko! Wǝ́ epǝ we kpǝlo kɩɩkɩ pǝ ko ŋ ruu ŋwǝ we, pǝ kpàa.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Oyudatǝpǝ lǝ ǝtǝtǝpǝ lo kǝsuŋkǝ</para>
  <para style="r">(<ref loc="MRK 7:1-13">Marǝko 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Rǝ eniyǝ we mǝrǝ wǝ́ Afarisitǝpǝ rɛ mǝ esekaŋtǝpǝ rɛ pǝ rù rǝ Yerusalɛmǝ pǝ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Kǝ́ kǝto wǝ́ ló otukarǝtǝpǝ sa pǝ lǝŋ yee pǝ saŋ rǝ lǝh ǝtǝtǝpǝ lo kǝsuŋkǝ wǝ? Duturǝ ɖi pǝ lǝŋ naŋ mǝŋ kǝ́ loh kǝsuŋkǝ kǝ lǝ pǝ́ wǝ kpɛŋ kǝ pǝ ci eri.» <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Wǝ́ Yesu ŋ yìili ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Wǝ́ ŋnǝ pa? Kǝ́ kǝto wǝ́ nǝ nyǝŋ yee nǝ saŋ rǝ Worokoyǝ le seyǝ, paa wǝ́ nǝ nyée yee nyǝ ŋ saŋ rǝ ŋnǝŋnǝ nǝ kǝsuŋkǝ wǝ? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Duturǝ ɖi Worokoyǝ la tɛŋ ǝkǝnǝŋ: “Pu lǝ́ tǝ mǝ lé lee.” Wǝ́ ŋ na lɛ ŋ na tɛŋ ǝkǝnǝŋ: “Yǝ we ŋ náa tɛŋ turɔɔrɔɔwǝ rɛ ŋ tíi nǝ tǝ amaa ne lee we, wǝ kpii kǝ pǝ wʊ ŋwǝ.” <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Paa ŋnǝ we, nǝ ya nǝ nyáa kaŋ otuyǝ ǝkǝnǝŋ mǝŋ rɛ le tíi nǝ tǝ amaa ne lee ǝkǝnǝŋ: “Tuwǝ we ŋ́ kǝ fǝ ŋ́ toŋ lǝ́ we, ŋ́ nǝ fǝ wǝ ŋ́ nǝ tǝnǝ Worokoyǝ”. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />We wǝ lǝǝ tǝ wǝ pǝ́ kǝ yǝ we ŋ pu nǝ tǝyǝ amaa ne leeyǝ. Nǝ nyǝŋ nyɩŋ, nǝ kǝsuŋkǝ kǝto wǝ́ nǝ nyo kuŋ Worokoyǝ le dierǝ lǝǝ tǝ lɔ okuruyǝ! <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Alakpatǝpǝ rɛ! Ezaya la pɛŋ kǝ́ ŋ tɛnɩ dierǝ ŋ tǝ̀nǝ ŋ rù rǝ nǝ wǝ. Tɛnɩ ǝkǝnǝŋ:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“Worokoyǝ ǝkǝnǝŋ, kǝkpǝŋkǝ sa kǝ lǝ́ǝ kǝ mǝ mǝ nyuŋkpǝ ko feepi wǝǝ,</para>
  <para style="q1" vid="MAT 15:8">paa kǝla ziɔŋrǝ lǝǝrǝ mǝ mǝ.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Tuŋtuŋ wǝ́ pǝ ya pǝ láa sʊma mǝ.</para>
  <para style="q1" vid="MAT 15:9">Duturǝ ɖi otukaŋyǝ we pǝ ya pǝ láa kaŋ we, anyɩmaasɩpǝ le esepǝ pǝ lǝǝwe.”»<verse eid="MAT 15:9" /></para>
  <para style="s">Otuyǝ we yǝ láa cɩɩrɩ nyiyǝ wǝ</para>
  <para style="r">(<ref loc="MRK 7:14-23">Marǝko 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Wǝ́ Yesu ŋ pwò kǝnyikpǝŋkǝ we, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ co kǝtukoŋkǝ, kǝ nǝ nuŋ tuwǝ sa lo duturǝ. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ŋkǝ tuwǝ we wǝ lée fii nyɩmaasɩyǝ lo nyuŋkpǝ wǝ láa cɩɩrɩ ŋwǝ wǝ. Paa tuwǝ we wǝ lóo ru ŋwǝ rǝ nyuŋkpǝ we, ŋ wǝ wǝ láa cɩɩrɩ ŋwǝ wǝ.» <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «E cii wǝ ǝkǝnǝŋ kǝ́ Afarisitǝpǝ sa pǝ lo nuŋ dierǝ sa a la tɛŋ we, wǝ́ wǝ le fii pǝ?» <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Wǝ́ ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Wǝcii ri ŋ cii wǝ yaa, wǝ lee ri mǝ Tǝ rǝ yulaarǝ ŋ na tɔ we, pǝ lóo nuru kpǝ pǝ cɛ. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Nǝ pǝǝ kpǝlǝŋ pǝ! Pǝ ri rǝ alaanyɩŋtǝpǝ we pǝ conu mǝ alaanyɩŋtǝpǝ wǝ. Wǝ́ mǝŋ laanyɩŋtǝyǝ rɛ ŋ conu mǝ laanyɩŋtǝyǝ we, pǝle eyi pǝ lah ka tɔɔ fuŋwǝ.» <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Wǝ́ Pɛtǝro ŋ lɔ̀ kpɛɛwǝ wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Pɔrʊ duturǝ sa lǝ mǝrǝ e tíi lǝ.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Wǝ́ Yesu ŋ yìili ŋ pǝ̀ pǝ ǝkǝnǝŋ: «We ŋnǝ ŋkpɛ nǝ foo nuŋ tǝrɛ lo duturǝ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Kǝto nǝ nyee ci wǝ ǝkǝnǝŋ tu ri ŋ tu wǝ lée fii nyuŋkpǝ wǝ lóo ko rǝ lɛrǝ, a pǝ ŋ ka ca wǝ pǝ co rǝ tɔwǝ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Paa tuwǝ we wǝ lóo ru rǝ nyɩmaasɩyǝ lo nyuŋkpǝ we, wǝ lo ru rǝ yǝ we la ziɔŋrǝ. Wǝ́ ŋ wǝ tuwǝ sa wǝ láa cɩɩrɩ nyɩmaasɩyǝ wǝ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Duturǝ ɖi nyɩmaasɩyǝ la ziɔŋrǝ mǝrǝ wǝ́ oyupurɔɔrɔɔyǝ yǝ lóo ru wǝ. Ŋyǝ yǝ lóo tu nyiyǝ yǝ ŋ kpii rǝ kǝnyiwʊkǝ, kǝtienaakǝ amaa vúuyɩɩrǝ, nuŋruwǝ, ayɩɩkǝ, nianiatǝraŋsieyǝ, kǝnyitɛŋkǝ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Otuyǝ sa yǝ láa cɩɩrɩ nyɩmaasɩyǝ wǝ! Paa mǝŋ nyiyǝ rɛ laa naŋ ŋ saŋ rǝ pǝlo kǝsuŋkǝ pe kǝ ŋ ci eri we, wǝ lǝŋ cɩɩrɩ ŋwǝ.»<verse eid="MAT 15:20" /></para>
  <para style="s">Tieyǝ rɛ ŋ nee ri Oyudatǝpǝ la lɔ Yesu lo nuŋ</para>
  <para style="r">(<ref loc="MRK 7:24-30">Marǝko 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Wǝ́ Yesu ŋ pwɛ̀yɩ rǝ fɛɛwǝ sa ŋ ko ŋ ko Tiro mǝ Zidɔŋ la gaarǝ we. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Wǝ́ Kananǝtǝtieyǝ rɛ ŋ ke kpii rǝ gaarǝ we we, ŋ pǝlǝ Yesu lǝ kpǝŋ. Wǝ́ ŋ yà ŋ ko ŋ woolu mǝ tɛŋ ǝkǝnǝŋ: «Kulǝtǝyǝ, Davidǝ le Pilepi, nyɩŋ mǝ tǝlarǝwǝ oo! Wɛɛrɔɔrɔɔrǝ rɛ ya lée kpii mǝ gɔrʊpirǝ la awɛɛlɩkǝ ŋpa.» <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Paape Yesu lǝǝ kpǝlǝŋ ŋwǝ. Wǝ́ no otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Piri ŋwǝ mǝ ŋ ko, duturǝ ɖi woolu siimǝ lǝ lǝ́ǝ pǝ kururu.» <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Pǝ le kpii mǝ pǝ la maŋ rǝ Isǝrayɛlǝtǝpǝ we pǝ lǝ rǝ mǝŋ amɛɛpǝ pǝ lǝ lǝǝ lǝ kpǝŋ ceŋceŋ ko.» <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Paape wǝ́ tieyǝ sa ŋ kǝ ŋ pǝ, ŋ pǝlǝ ŋ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, lɔ o koonu mǝ!» <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ laa laka kǝ pǝ fǝ epipǝ le keeriwǝ pǝ co acɩkɛɛpipǝ». <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Wǝ́ tieyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, wǝ lǝ ǝnǝ! Paape acɩkɛɛpipǝ pǝ lée ri pǝlo okulǝtǝpǝ le ekeeritupiyǝ we yǝ lo puulu rǝ kpǝlɔyǝ yǝ la tɔɔlʊ wǝ». <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Wǝ́ Yesu ŋ tìi tieyǝ sa ǝkǝnǝŋ: «Kuleleyǝ, lá lɔnuŋrǝ naanǝ oo! Tuwǝ we a ya lǝ́ǝ pǝ́ we, wǝ pǝ wǝ koonu lǝ́ ǝnǝ.» Wǝ́ na gɔrʊpirǝ we gbàa rǝ kǝyaakǝ we.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu la cá anyaatǝpǝ wa</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Kǝ́ Yesu ŋ na pwɛyɩ rǝ fɛɛwǝ we we, wǝ́ ŋ ko ŋ ko Galileya lo puŋkɔwǝ we la kǝlɛɛrɩkǝ. Wǝ́ ŋ rɛ̀ dutupirǝ rɛ ŋ kolu ŋ tini. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Wǝ́ enyikpǝŋmumuŋyǝ rɛ yǝ kǝ ŋ pǝ nǝ kpǝŋ. Anyɩŋ pǝ re ǝsǝ́ŋpǝ, alaanyɩŋtǝpǝ, ǝpǝ pǝ lǝ kpǝ́ otoŋyǝ, omumuupǝ, mǝ anyaatǝpʊŋpwapǝ wa pǝ lǝ́ǝ pǝ. Wǝ́ pǝ kǝ ŋ pǝ pǝ ŋ tǝnǝ pǝ rǝ Yesu la kǝnyɩŋkǝ. Wǝ́ ŋ ka ŋ cá pǝ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Kǝ́ enyipǝ pǝ la nyɩŋ omumuupǝ pǝ ya pǝ láa wɛɛlɩ, epǝ we pǝ lǝ kpǝ́ otoŋyǝ lo otoŋyǝ yǝ la saanǝ, ǝsǝ́ŋpǝ pǝ ya pǝ láa saŋ wǝ́ alaanyɩŋtǝpǝ pǝ ya pǝ láa nyɩŋ we, wǝ́ wǝ rili pǝ lo mumuŋ. Wǝ́ pǝ yà pǝ kǝ ŋ kǝ Isǝrayɛlǝ lo Worokoyǝ.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesu lo koonu enyipǝ lafawǝ niǝ mǝ otuyǝ le keeriwǝ pǝ le ri</para>
  <para style="r">(<ref loc="MRK 8:1-10">Marǝko 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Wǝ́ Yesu ŋ pwò no otukarǝtǝpǝ we. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝnyikpǝŋkǝ sa lo tuwǝ wǝ ya wǝ lóo co mǝ tǝlarǝwǝ. Duturǝ ɖi wǝ la marǝ wǝ le yee wǝcukpǝ wǝta kǝ́ pǝ yaa rǝ mǝ kpǝŋ wǝǝ! Wǝ́ pǝ lee re tǝrɛ pǝ láa nya pǝ ri. Ŋ́ nǝŋ taa ŋ́ co pǝ la kʊŋ pǝ ŋ ko mǝ lɛkpaakpaarǝ. Pǝ lóo koru a ka tɔɔ sipopokuyǝ rǝ kʊŋwǝ!» <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Wǝ́ otukarǝtǝpǝ we pǝ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «Fǝŋ wǝ́ yǝ lóo koru anya keeriwǝ lo koonu nyikpǝŋmumuŋwǝ sa pǝ ri pǝ wu rǝ fɛɛwǝ sa nyiyǝ ŋ nǝǝ kǝlǝ wǝ?» <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kpɔnɔyǝ paka wǝ́ nǝ re?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Pǝrɩmata mǝ wǝpwɛɛpikpǝ rɛ.» <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Wǝ́ Yesu ŋ tìi nyikpǝŋwǝ we wǝ sɔ wǝ tii rǝ kǝtǝǝwǝ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Wǝ́ ŋ fǝ̀ kpɔnɔyǝ we na pǝrɩmata mǝ wǝpwɛɛkpǝ we, kǝ́ ŋ ne ceeni Worokoyǝ ŋ na lɛ we, wǝ́ ŋ pòolu ŋwǝ, wǝ́ ŋ fǝ̀ ŋ kòonu no otukarǝtǝpǝ we. Wǝ́ pǝ fǝ̀ pǝ sǝ̀pǝ enyipǝ we kpǝlo kɩɩkɩ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Wǝ́ pǝlo kpǝlo kɩɩkɩ pǝ rili pǝ wulu. Wǝ́ pǝ wʊ̀ʊ otoopiyǝ we yǝ lo turu kɛŋtɛwǝ pǝrɩmata pwɩpwɩ pǝ rè pǝ pwɛ̀yɩ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ǝpǝrǝŋpǝ we pǝ rili lo kuruyuwǝ wǝ kǝ lǝ lafawǝ niǝ, pǝ lǝǝ kǝ etiepǝ mǝ epipǝ pǝ kʊla. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Kǝ́ Yesu ŋ no co nyikpǝŋwǝ we la kʊŋ ŋ na lɛ we, wǝ́ ŋ fìi gʊrɔrǝ ŋ ko ŋ ko Magadaŋ la gaarǝ.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Afarisitǝpǝ mǝ Asadukitǝpǝ pǝ lǝ pǝ́ Yesu ŋ yee tucovurǝ rɛ</para>
  <para style="r">(<ref loc="MRK 8:11-13">Marǝko 8:11-13</ref>, <ref loc="LUK 12:54-56">Luka 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Wǝ́ Afarisitǝpǝ rɛ mǝ Asadukitǝpǝ pǝ rùu pǝ kǝ̀lǝ mǝ Yesu. Kǝ pǝ fǝ pǝ kɔŋ na kpɛrɛwǝ we, wǝ́ pǝ tìi ŋwǝ ŋ yee tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii ŋwǝ ŋ na maŋ wǝ. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Vǝ́ cɔkɔŋyǝ lah tɔɔ we, nǝ nyǝ ŋ mǝ tɛŋ ǝkǝnǝŋ: “Ǝrǝkǝ sa kǝ lǝŋ poŋ, duturǝ ɖi yulaarǝ la mwɛɛrɩ kǝto.” <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ɖokoŋpirǝ we, nǝ nyǝ ŋ mǝ tɛŋ ǝkǝnǝŋ: “Ruŋruŋ ǝrǝkǝ we kǝ loo poŋ duturǝ ɖi kǝ le rimi.” Mǝŋkǝsa we, nǝ nyáa nyɩŋ ǝrǝkǝ lǝ wǝlǝkpǝ nǝ nyǝ ŋ ci. Paa otuyǝ we yǝ ya yǝ lǝ́ǝ pǝ rǝkǝsa we, nǝ nyǝŋ koru anyɩŋ tuwǝ yǝ ya yǝ láa kaŋ nǝ ci!<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Fɛɛkǝyitǝwǝ sa mǝ tatǝwǝ sa yǝ lee kpii rǝ wǝŋʊrʊkuukuurɛɛkpǝ mǝrǝ.</char></note> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Ruŋruŋ le enyipǝ sa pǝ pǝlǝ. Pǝ lǝŋ ri anʊkɔrǝyǝ pǝ koonu Worokoyǝ. Paa pǝ ya pǝ lǝ́ǝ pǝ́ pǝ nyɩŋ tucovurǝ rɛ wǝ láa pɔrʊ wǝ kaŋ ǝkǝnǝŋ Worokoyǝ ŋ ne kpii mǝ ŋ na maŋ! Pǝ lǝŋ pa nyɩŋ tucovurǝ sa wǝrʊʊkpǝ pwi, we tɛŋ Yona la nɛŋwǝ we ceŋceŋ rǝ!» Wǝ́ ŋ pwɛ̀yɩ ŋ màa pǝ rǝ we.<verse eid="MAT 16:4" /></para>
  <para style="s">Afarisitǝpǝ mǝ Asadukitǝpǝ la dafaŋrǝ</para>
  <para style="r">(<ref loc="MRK 8:14-21">Marǝko 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Kǝ́ otukarǝtǝpǝ we pǝ la ka ta puŋkɔwǝ we la kǝtakǝ nɔ we, wǝ́ pǝ tàalǝ ǝkǝnǝŋ ŋpǝ pǝ lo yuu kpɛɛ pǝ lǝǝ fǝ kpɔnɔyǝ. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ yee yurǝ! Nǝ ci nǝ wɛ le ere rǝ Afarisitǝpǝ mǝ Asadukitǝpǝ la dafaŋrǝ lǝ kpǝŋ.» <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Wǝ́ otukarǝtǝpǝ we pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: «Kǝ́ yǝ lee re kpɔnɔyǝ kǝto wǝ́ ŋ na wɛɛlɩ ǝnǝ.» <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Wǝ́ Yesu ŋ nyɩnɩ wǝ ŋ cìi. Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyée tíi awɛ ǝkǝnǝŋ kǝ́ yǝ lee re kpɔnɔyǝ kǝto wǝ? Nǝ lɔnuŋrǝ laa naanǝ mǝŋ tɩ! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />We nǝ faa maa nǝ nuŋ tǝrɛ lo dutu? Nǝ nyaa ya nǝ nyáa taalǝ kpɔnɔyǝ we tʊʊ nǝ sǝ̀pǝ enyipǝ lafawǝ tʊʊ wǝ́ kɛŋtɛwǝ paka lǝ mǝrǝ wǝ́ nǝ rɛmɩ otoopiyǝ we nǝ rè nǝ pwɛ̀yɩ? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Wǝ́ nǝ nyǝŋ taalǝ kpɔnɔyǝ we pǝrɩmata nǝ sǝ̀pǝ enyipǝ lafawǝ niǝ wǝ, wǝ́ kɛŋtɛwǝ paka lǝ mǝrǝ wǝ́ nǝ rɛ̀mɩ otoopiyǝ we nǝ rè nǝ pwɛ̀yɩ wǝ? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Wǝ lée yee nɛ wǝ́ nǝ nyoo nuŋ tuwǝ sa nǝ ci ǝkǝnǝŋ ŋkǝ kpɔnɔyǝ wǝ́ ŋ́ ke reemǝ, kǝ́ ŋ́ na ya ŋ́ née tíi nǝ ǝkǝnǝŋ nǝ ci nǝ wɛ le ere rǝ Afarisitǝpǝ mǝ Asadukitǝpǝ la dafaŋrǝ lǝ kpǝŋ wǝ?» <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Wǝ́ otukarǝtǝpǝ we pǝ nunu wǝlo duturǝ ǝkǝnǝŋ ŋkǝ le tíi pǝ pǝ ci pǝla wɛ le ere rǝ dafaŋrǝ we pǝ lée kpii kpɔnɔyǝ lǝ kpǝŋ. Paa Afarisitǝpǝ mǝ Asadukitǝpǝ lo otukaŋyǝ wǝ́ ŋ ke reemǝ.<verse eid="MAT 16:12" /></para>
  <para style="s">Pɛtǝro la pɔrʊ wǝ la tɛŋ ǝkǝnǝŋ Yesu ŋ ri Mesiyayǝ we</para>
  <para style="r">(<ref loc="MRK 8:27-30">Marǝko 8:27-30</ref>, <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Wǝ́ Yesu ŋ kolu tǝŋtǝǝwǝ we pǝ lóo pwo Sezare Filipo la gaarǝ we. Kǝ́ pǝ le ke fii we, wǝ́ ŋ kǝ ŋ pǝ́ no otukarǝtǝpǝ we ǝkǝnǝŋ: «Ǝlǝ wǝ́ enyipǝ pǝ láa tɛŋ ǝkǝnǝŋ Nyɩmaasɩ le Pi ŋ ri wǝ?» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Wǝ́ pǝ yìili ǝkǝnǝŋ: «Arɛɛpǝ pǝ láa tɛŋ ǝkǝnǝŋ ŋlǝ́ e ri Yowanɛsɩ worokomɛŋwiiritǝyǝ we. Arɛɛpǝ ǝkǝnǝŋ ŋlǝ́ e ri Eliya. Wǝ́ apʊŋpwapǝ ke ǝkǝnǝŋ ŋlǝ́ e ri Yeremiya amaa oworokokpɛɛnuŋtɛŋtǝpǝ le ceŋceŋ.» <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Wǝ́ ŋnǝ pa, ǝlǝ wǝ́ nǝ nyáa tɛŋ ŋmǝ ŋ́ ri?» <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Wǝ́ Sɩmɔ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Ŋlǝ́ e ri Mesiyayǝ we, Worokoyǝ we ŋ kpii vɔrʊrǝ le Pi.» <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Yona le pi Sɩmɔ, o lo co yǝ! Duturǝ ɖi ŋkǝ nyɩmaasɩyǝ rɛ ŋ na pɔrʊ anʊkɔrǝyǝ sa ŋ na kaŋ lǝ́, mǝ Tǝ ŋ kpii rǝ yulaarǝ ŋ lǝǝwe. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Ŋmǝ we, ŋ́ ya ŋ́ née tíi ŋlǝ́ Pɛtǝro ǝkǝnǝŋ: Ŋlǝ́ e ri ɖutɛɛrǝ! Wǝ́ ŋlǝ́ ɖutɛɛrǝ<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Rǝ Kǝhelatǝkǝ we, Pɛtǝro lo duturǝ ɖi ɖutɛɛrǝ.</char></note> sa lo oŋuŋkǝ wǝ́ ŋ́ náa tɔ mǝ zʊmarǝ la wǝcakukpǝ ŋ tɛɛ wǝ. Gbɛŋrǝ ǝkǝŋtǝ lǝŋ koru eri rǝlo yurǝ. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ŋ́ nǝ́ǝ fǝ yulaarǝ le wǝpilirikpǝ we la asafwepǝ ŋ́ koonu lǝ́. Tu ri ŋ tu ǝ lǝ́ǝ sǝ́ŋ rǝ kǝtǝǝwǝ we, pǝ lǝ́ǝ sǝ́ŋ wǝ rǝ yulaarǝ. Tu ri ŋ tu a láa tɛɛnɩ rǝ kǝtǝǝwǝ we, pǝ láa tɛɛnɩ wǝ rǝ yulaarǝ.» <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Wǝ́ Yesu ŋ kanǝ ŋ tìi no otukarǝtǝpǝ we kpuŋkpuruŋ pǝ paa tɛŋ pǝ tíi rɛ ǝkǝnǝŋ ŋwǝ ŋ ri Mesiyayǝ we.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu la wɛɛlɩ lo ru rǝ nǝ ǝkpǝ́kǝ mǝ na asaanǝkǝ</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Marǝko 8:31–9:1</ref>, <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Fǝ rǝ eniyǝ we mǝ pǝ we, wǝ́ Yesu ŋ ka ŋ wɛɛlɩ feŋteŋ mǝ ŋ tíi no otukarǝtǝpǝ ǝkǝnǝŋ: «Wǝ kpii kǝ ŋ́ ko Yerusalɛmǝ kǝ ŋ́ ka cʊʊrʊ ŋpa rǝ ǝtǝŋtǝǝtǝmumuŋpǝ, otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ la akaakǝ. Pǝ lóo kuŋ pǝ wʊ mǝ, kǝ juutatǝrǝ we, ŋ́ saanǝ.» <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Wǝ́ Pɛtǝro ŋ kpàrǝ ŋwǝ ŋ rù kǝlɛɛrɩkǝ. Wǝ́ ŋ yà ŋ ka ŋ kpamǝ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, Worokoyǝ ŋ kǝrǝŋ lǝ́. Ow, tuwǝ sa wǝ lǝŋ pǝ wǝ tuu lǝ́ ǝnǝ pwi!» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Wǝ́ Yesu ŋ sìɛrɩ ŋ tìi Pɛtǝro ǝkǝnǝŋ: «Ruu o ru rǝ mǝ kpǝŋ! Tɛlɩ o ko mǝ kǝmaakǝ Satana! E ri gbaraarǝ o koonu mǝ. Duturǝ ɖi ló oyupuyǝ yǝ lee ri Worokoyǝ la anɛŋyǝ, paa anyɩmaasɩpǝ la anɛŋyǝ yǝ lǝǝwe.»<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ ǝkǝnǝŋ: «Mǝŋ rɛ lǝ́ǝ pǝ́ ŋ siimǝ mǝ we, yǝ we ŋ yuu na wɛ la kpɛɛ ŋ co, kǝ ŋ fǝ na kpɛtɛkpǝlɛciiwǝ ŋ re ŋ siimǝ mǝ kǝ ŋ kǝ kpǝ́ rǝ. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Duturǝ ɖi yǝ we ŋ nǝ́ǝ pǝ́ ŋ pɔrʊ na wɛ la vɔrʊrǝ we, lǝ́ǝ lǝǝrǝ rǝ. Paa yǝ we ŋ nǝ́ǝ lǝǝrǝ na vɔrʊrǝ rǝ mǝ yurǝ we, yǝ we láa pɔrʊ na wɛ la vɔrʊrǝ. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mǝŋ nyiyǝ rɛ la nya ǝrǝkǝ sa kpǝlo kɩɩkɩ lo otuyǝ wǝ́ ŋ nǝ lǝǝrǝ na vɔrʊrǝ wǝǝ, vasʊyǝ rǝ fǝŋ wǝ́ ŋ na nya? Kǝ́ lo tu wǝ́ nyɩmaasɩyǝ ŋ nóo koru ǝ fǝ ŋ cɛkɛlɛ mǝ na vɔrʊrǝ? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Duturǝ ɖi Nyɩmaasɩ le Pi kpii lǝ́ǝ pǝ rǝ nǝ Tǝ la wǝnyɩɩnɩkpǝ mǝrǝ ŋpǝ mǝ ne epicoŋpipǝ. Eniyǝ ŋ nah pa mwara nyi ri ŋ nyi saŋ rǝ vɔrʊrǝ we yǝ we ŋ ne re wǝǝ. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, rǝ enyipǝ sa pǝ yaa rǝ fɛɛwǝ sa lǝ mǝrǝ we, arɛɛpǝ pǝ lǝŋ kpǝ́ kpɛŋ kǝ pǝ ci anyɩŋ Nyɩmaasɩ le Pi kǝ́ ŋ no ru ŋ nǝ́ǝ pǝ mǝŋ Piliyǝ kǝtǝ wǝ.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yesu la nyɩnɩ mǝ Worokoyǝ la wǝnyɩɩnɩkpǝ</para>
  <para style="r">(<ref loc="MRK 9:2-13">Marǝko 9:2-13</ref>, <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Juu kʊʊraŋ la kǝmaakǝ we, wǝ́ Yesu ŋ fǝ̀ Pɛtǝro, Yakubu mǝ na paanʊ Yowanɛsɩ ŋ kʊ̀la mǝ na wɛ ŋ re ŋ kolu kǝlɛɛrɩkǝ rǝ dutupikǝŋrǝ rɛ lo oŋuŋkǝ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Wǝ́ Yesu lǝ wǝlǝkpǝ wǝ sìɛrɩ rǝ pǝle enimiyǝ. Wǝ́ na anyɩŋkǝ kǝ ke ŋ sie ŋaŋa mǝŋ cɔkɔŋyǝ kǝtǝ. Wǝ́ na wǝkpakpǝ wǝ kpɛ̀ɛlɩ fuu fitefite mǝŋ wǝnyɩɩnɩkpǝ kǝtǝ. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kǝtǝrǝceŋceŋ wǝ́ pǝ nyɩnɩ kǝ́ Mose mǝ Eliya pǝ ya pǝ láa tɛɛrɩ mǝ Yesu wǝ. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Wǝ́ Pɛtǝro ŋ tìi Yesu ǝkǝnǝŋ: «Kulǝtǝyǝ, wǝ ponu kǝ le tii rǝ fɛɛwǝ sa. Mǝŋ ǝ lǝ́ǝ pǝ́ we, ŋ́ náa tɔ epwiiyǝ ata rǝ fɛɛwǝ sa, lá nɛŋrǝ jeŋceŋ, Mose la nɛŋrǝ jeŋceŋ, Eliya la nɛŋrǝ jeŋceŋ.» <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Eniyǝ we ŋ tǝ ŋ ya ŋ náa wɛɛlɩ we, wǝ́ ŋɔɔrǝ rɛ láa nyɩnɩ bǝlǝ zìi pǝ, wǝ́ pǝ nunu kpɛɛwǝ rɛ rǝ ŋɔɔrǝ we lǝ mǝrǝ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ ri mǝ piyǝ ŋ́ náa taa kǝǝwǝ ŋpa wǝ. Ŋ́ na nya faawǝ kɩɩkɩ rǝ ŋwǝ. Nǝ co kǝtukoŋkǝ rǝ ŋwǝ!» <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Kǝ́ otukarǝtǝpǝ sa pǝ lo nuŋ kpɛɛwǝ sa we, wǝ́ pǝ fìi vurǝ ŋpa, wǝ́ pǝ tɔ̀ɔlʊ pǝ pùnu anyɩŋkǝ rǝ kǝtǝǝwǝ. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Wǝ́ Yesu ŋ rùu ŋ kǝ̀lǝ mǝ pǝ. Wǝ́ ŋ rùu pǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ yi! Nǝ pǝǝ tǝ nǝ suu vurǝ!» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Kǝ́ pǝ le yiili pǝ la yɩrɩ we, pǝ lǝǝ tǝ pǝ nyɩŋ rɛ rǝ fɛɛwǝ we, we Yesu ceŋceŋ ko. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Kǝ́ pǝ lo ru rǝ dutupirǝ we pǝ láa sʊʊ we, wǝ́ Yesu ŋ kpìi seyǝ ŋ kòonu pǝ ǝkǝnǝŋ: «Nǝ paa ka tɛŋ tuwǝ sa pǝ la pɔrʊ pǝ la kaŋ nǝ nǝ tíi rɛ, ko ro ǝrǝ kǝ́ Nyɩmaasɩ le Pi ŋ náa saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ».<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Wǝ́ otukarǝtǝpǝ we pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ esekaŋtǝpǝ pǝ láa tɛŋ ǝkǝnǝŋ wǝ kpii kǝ Eliya ŋ pǝ kpɛŋ wǝ?» <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Kǝceece Eliya lǝ́ǝ pǝ ŋ coonu, kǝ ŋ po toolu tu ri ŋ tu ŋ tǝnǝ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Paa ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ Eliya la marǝ ǝpǝ. Paa enyipǝ pǝ laa nyɩŋ ŋwǝ pǝ ci. Wǝ́ pǝ le yee mǝ no tuwǝ we wǝ ponu mǝ pǝ wǝ. Kaa wǝǝ Nyɩmaasɩ le Pi ŋwǝ ŋkpɛ ŋ nah pa cʊʊrʊ rǝ pǝla akaakǝ wǝǝ.» <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Wǝ́ otukarǝtǝpǝ we pǝ nunu wǝlo duturǝ ǝkǝnǝŋ Yowanɛsɩ worokomɛŋwiiritǝyǝ we wǝ́ ŋ reemǝ.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu la cá piyǝ rɛ ŋ náa tɔɔ wǝ</para>
  <para style="r">(<ref loc="MRK 9:14-29">Marǝko 9:14-29</ref>, <ref loc="LUK 9:37-43">Luka 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Kǝ́ pǝ lǝ pǝ kǝlǝ mǝ nyikpǝŋwǝ we we, wǝ́ kɛrɩyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ Yesu. Wǝ́ ŋ sʊ̀ʊ ŋ kʊnʊ rǝ na kǝnyɩŋkǝ. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Kulǝtǝyǝ, nyɩŋ mǝ pi la tǝlarǝwǝ oo! Láa tɔɔ! Ya láa cʊʊrʊ ŋpa. Lǝ́ǝ pǝ mǝ ŋ tɔɔ rǝ naawǝ amaa mɛŋwǝ. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ŋ́ nǝ fǝ ŋwǝ ŋ́ nǝ pǝ ló otukarǝtǝpǝ sa lǝ kpǝŋ, paape pǝ loo koru ŋwǝ la acá.» <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Wǝ́ Yesu ŋ tà ŋ yìili ǝkǝnǝŋ: «Ŋnǝ rǝkǝsa le enyipǝ, enyirɔɔrɔɔpǝ rɛ pǝ laa lɔ pǝ nuŋ wǝ́ nǝ ri! Ŋ́ tǝ ŋ́ tii ŋ́ kʊla mǝ nǝ ko ro ɖeci? Ŋ́ tǝ ŋ́ re nǝ ko ro ɖeci? Nǝ fǝ piyǝ we nǝ po koonu mǝ rǝ fɛɛwǝ sa.» <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Wǝ́ Yesu ŋ fanǝ wɛɛrɔɔrɔɔrǝ sa, wǝ́ ɖù rǝ piyǝ we. Wǝ́ ŋ kpàa rǝ kǝyaakǝ we. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />Wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ Yesu ŋpǝ sɔŋ, wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ ŋlǝ paa yǝ loo koru wɛɛrǝ we le epiri wǝ?» <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Kpiikǝ nǝ lɔnuŋrǝ laa naanǝ mǝŋ tɩ kǝto. Ŋ́ yaa ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ nǝ lɔnuŋrǝ gah naanǝ ɖo durʊʊŋɩnɩŋɩnɩpirǝ rɛ rǝ we, nǝ keh mǝ tíi dutupirǝ sa ǝkǝnǝŋ: “Nuru a cɛ rǝ fɛɛwǝ sa kǝ a ka yaa rǝ ɖeeni!” O lǝ ŋ nuru jɛ. Tǝrɛ wǝ lǝŋ ke mǝ teeri nǝ eyeekǝ. [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Wǝ́ wɛɛrǝ sa wǝrʊʊkpǝ we, nyuŋmwɛŋwǝ mǝ nyuŋparǝkpǝ ceŋceŋ wǝ lóo koru epiri rǝ.<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuurɛɛkpǝ mǝrǝ. Yɩrɩ Marǝko 9:29.</char></note>»]<verse eid="MAT 17:21" /></para>
  <para style="s">Yesu lǝ tǝ la wɛɛlɩ lo ru rǝ nǝ ǝkpǝ́kǝ mǝ na asaanǝkǝ</para>
  <para style="r">(<ref loc="MRK 9:30-32">Marǝko 9:30-32</ref>, <ref loc="LUK 9:43-45">Luka 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kǝ́ Yesu lo otukarǝtǝpǝ we kpǝlo kɩɩkɩ pǝ lo ko ku rǝ Galileya we, wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Pǝ lǝh pǝ fǝ Nyɩmaasɩ le Pi pǝ kpii enyipǝ rǝ akaakǝ. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Pǝ láa wʊ ŋwǝ. Paape juutatǝrǝ we, láa saanǝ.» Wǝ́ otukarǝtǝpǝ we pǝ fìi gʊʊpirǝ ŋpa.<verse eid="MAT 17:23" /></para>
  <para style="s">Yesu mǝ Pɛtǝro pǝ lo koonu Worokoyǝ la nyarǝwǝ la jɛŋkpǝrǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Kǝ́ Yesu mǝ no otukarǝtǝpǝ we pǝ le ke fii Kapɛrǝnawumǝ we, wǝ́ epǝ we pǝ láa lɔ jɛŋkpǝrǝ rǝ Worokoyǝ la nyarǝwǝ pǝ rùu pǝ kǝ̀lǝ mǝ Pɛtǝro. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Nǝ Kulǝtǝyǝ lǝŋ koonu Worokoyǝ la nyarǝwǝ la jɛŋkpǝrǝ?» <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Wǝ́ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Ǝŋkǝ́, lóo koonu». Kǝ́ Pɛtǝro ŋ ne pe fii nyarǝwǝ kǝtǝrǝceŋceŋ wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Sɩmɔ, a la nyɩŋ tuwǝ sa ǝ lǝ fǝ nɛ? Kǝtǝǝwǝ sa le epilipǝ pǝ láa lɔ jɛŋkpǝrǝ amaa laŋpooyǝ rǝ ǝpǝ rǝ fǝŋ? Rǝ ǝtǝŋtǝǝtǝpipǝ amaa ǝsǝǝpǝ?» <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Wǝ́ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Ǝsǝǝpǝ». Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «We ǝtǝŋtǝǝtǝpipǝ pǝ lǝŋ koonu. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Paape we, ŋ́ nǝŋ taa le kpii enyipǝ sa la kpɛɛmʊrʊwǝ. Kǝto we, mǝ ko puŋkɔwǝ kǝ o ko co garawarǝ. Kǝpwɛɛsǝsǝŋkǝ we a láa pɔrʊ we, wuru kǝlo nyuŋkpǝ, a láa nyɩŋ sɩkayǝ rɛ. Lóo ro ŋlǝ mǝ lǝ́ la jɛŋkpǝrǝ. Fǝ ŋwǝ o ko koonu ŋlǝ mǝ lǝ́ la jɛŋkpǝrǝ.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Yǝ we ŋ ri mumuŋyǝ rǝ yulaarǝ le wǝpilirikpǝ we mǝrǝ wǝ</para>
  <para style="r">(<ref loc="MRK 9:33-37">Marǝko 9:33-37</ref>, <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Rǝ eniyǝ we lǝ mǝrǝ wǝ́ otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ Yesu. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ǝlǝ ŋ ri mumuŋyǝ rǝ yulaarǝ le wǝpilirikpǝ we mǝrǝ wǝ?» <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Wǝ́ Yesu ŋ pwò laatiepiyǝ rɛ ŋ pǝlǝ ŋ yàalǝ rǝ pǝle kǝtiitiikǝ. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ nǝ nyaa siɛrɩ nǝ yee mǝŋ alaatiepipǝ kǝtǝ we, nǝ nyǝŋ pe fii yulaarǝ le wǝpilirikpǝ we mǝrǝ nǝ nyɩŋ pwi. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Yǝ we ŋ ri mumuŋyǝ rǝ yulaarǝ le wǝpilirikpǝ we mǝrǝ we, ŋ kaamǝ yǝ we ŋ náa pɛɛlɩ na wɛ kǝ ŋ siɛrɩ ŋ yee mǝŋ laatieyǝ sa kǝtǝ wǝ. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Wǝ́ nyiyǝ we ŋ náa lɔ piyǝ rɛ mǝŋ yǝ ǝnǝ kǝtǝ sɩsiɛrɩ rǝ mǝ yurǝ we, ŋmǝŋmǝ wǝ́ yǝ we ŋ na lɔ ǝnǝ.<verse eid="MAT 18:5" /></para>
  <para style="s">Rɛ ŋ poo tu na kɛrɩyǝ ŋ kpii rǝ turɔɔrɔɔwǝ</para>
  <para style="r">(<ref loc="MRK 9:42-48">Marǝko 9:42-48</ref>, <ref loc="LUK 17:1-2">Luka 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Mǝŋ rɛ lo tu epipǝ sa pǝ la lɔ mǝ pǝ lo nuŋ la rɛ le kpii rǝ turɔɔrɔɔwǝ we, mǝŋ pǝ le kpii yǝ we lǝ wǝtǝǝmumuŋkpǝ rɛ rǝ dǝreerǝ wǝ́ pǝ lǝ fǝ ŋwǝ pǝ le tie pǝ le kpii rǝ apʊyǝ lǝ kǝnǝŋkǝ we, wǝ lóo poŋ ŋwǝ wǝ teeri. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Anyɩmaasɩpǝ kpǝlo kɩɩkɩ rǝ ǝrǝkǝ, nǝ paapɔ mǝ nǝ aria, rǝ otuyǝ sa kpǝlo kɩɩkɩ yǝ lóo tu nyiyǝ yǝ ŋ kpii rǝ turɔɔrɔɔwǝ lǝ mǝrǝ kǝto. Ŋyǝ otuyǝ sa yǝ lǝ́ǝ pǝ taa, paape nyiyǝ we lo oŋuŋkǝ tuwǝ sa wǝ láa saŋ wǝ pǝ we, yǝ we na paapɔ mǝ na aria! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Mǝŋ lá akaakǝ amaa lá kǝkparǝkǝ kǝ lóo kuŋ kǝ e yee turɔɔrɔɔwǝ we, we sǝ yǝ e tie o co ciriciri. Mǝŋ o lo ko vɔrʊlaalɛɛrǝ mǝ kǝnukǝ kǝceŋceŋ amaa kǝkparǝkǝ kǝceŋceŋ we, wǝ ponu wǝ teeri kǝ́ pǝ le tie lǝ́ pǝ kpii rǝ naalaalɛɛwǝ mǝ lá wǝkaakpǝ wǝyi amaa lá wǝkparǝkpǝ wǝyi wǝ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Wǝ́ mǝŋ lé nimirǝ lóo kuŋ kǝ e yee turɔɔrɔɔwǝ we, pɔrʊ rǝ e tie o co ciriciri. Mǝŋ o lo ko vɔrʊlaalɛɛrǝ mǝ nimirǝ jeŋceŋ we, wǝ ponu wǝ teeri kǝ́ pǝ le tie lǝ́ pǝ le kpii rǝ naalaalɛɛwǝ mǝ lé enimiyǝ eyi wǝ.»<verse eid="MAT 18:9" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ mɛɛyǝ rɛ ŋ nǝ lǝǝ wǝ</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«Nǝ yee yurǝ! Nǝ paa fʊʊ alaatiepǝ sa le ceŋceŋyǝ rɛ nǝ sǝǝlǝ. Duturǝ ɖi ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ yulaarǝ we, pǝle epicoŋpipǝ pǝ yaa rǝ mǝ Tǝ ŋ kpii rǝ yulaarǝ la kǝnyɩŋkǝ eni ri ŋ ni [<verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Duturǝ ɖi Nyɩmaasɩ le Pi lǝ pǝ ŋ pa pɔrʊ epǝ we pǝ lǝ̀ǝ wǝ.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuurɛɛkpǝ lǝ mǝrǝ.</char></note>»] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />«Nǝ nya nyɩŋ nǝ nyǝ fǝ nɛ? Mǝŋ nyiyǝ rɛ lǝǝmǝ amɛɛpǝ tuuru, wǝ́ pǝle ceŋceŋ ŋ nǝ lǝǝ wǝǝ, lǝŋ maa amɛɛtuturupǝ we tǝfaŋceŋceŋ mǝ afaŋceŋceŋ ŋ yaalǝ rǝ dutupirǝ kǝ ŋ taa ceŋceŋyǝ we ŋ nǝ lǝǝ mǝ ŋ tɛlɩ? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ la ka nyɩŋ ŋwǝ we, láa nya faawǝ rǝ mɛɛyǝ sa lo yurǝ ŋ teeri amɛɛtuturupǝ we tǝfaŋceŋceŋ mǝ afaŋceŋceŋ pǝ lǝǝ lǝǝ wǝ. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Kaa wǝǝ nǝ Tǝ ŋ kpii rǝ yulaarǝ we ŋ nǝŋ taa epipǝ sa la rɛ ŋ lǝǝ wǝǝ.»<verse eid="MAT 18:14" /></para>
  <para style="s">Mǝŋ rɛ le yee mǝ lǝ́ turɔɔrɔɔwǝ lǝ kǝ́ e lée yee ǝ fǝ wǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Mǝŋ lá kɛrɩyǝ rɛ rǝ zʊmarǝ le yee mǝ lǝ́<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ lee kpii «mǝ lǝ́». </char></note> turɔɔrɔɔwǝ rɛ we, ko a ka nyɩŋ ŋwǝ, ŋwǝ ceŋceŋ. Nǝ eyi we, kǝ a pɔrʊ tuwǝ we ŋ ne yee e tíi ŋwǝ. Mǝŋ lo nuŋ duturǝ lo kuŋ lǝ́ we, o lóo turu a la siɛnɩ mǝ ŋwǝ ǝ lǝ pǝ gʊŋceeceerǝ. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Paa mǝŋ lǝ sǝ́ŋ loo nuŋ duturǝ ŋ koonu lǝ́ we, ka taa nyiyǝ ceŋceŋ amaa eyi a kʊla mǝ lá wɛ nǝ ko. Mǝŋkǝsa we kǝ dierǝ we nya fɛɛ zǝrǝ rǝ enyi eyi amaa enyi ata pǝ ri araŋsielǝtǝpǝ lo tutɛŋwǝ. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Wǝ́ mǝŋ lǝ sǝ́ŋ loo nuŋ pǝlo tutɛŋwǝ we, pa tɛŋ dierǝ we rǝ zʊmarǝ. Wǝ́ mǝŋ lǝ sǝ́ŋ loo nuŋ zʊmarǝ lo tutɛŋwǝ we, mǝ nyɩŋ ŋwǝ rǝ mǝŋ nyiyǝ ŋ nee ci Worokoyǝ sɩsiɛrɩ wǝ amaa laŋpoolɔtǝyǝ rɛ.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />«Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, tu ri ŋ tu nǝ nyǝ́ǝ sǝ́ŋ rǝ kǝtǝǝwǝ we, pǝ lǝ́ǝ sǝ́ŋ wǝ rǝ yulaarǝ. Wǝ́ tu ri ŋ tu nǝ nyáa tɛɛnɩ rǝ kǝtǝǝwǝ we, pǝ láa tɛɛnɩ wǝ rǝ yulaarǝ.<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="MAT 16:9">16:9</ref></char>.</char></note> <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Ŋ́ tǝ ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ mǝŋ enyi eyi rǝ nǝ mǝrǝ rǝ kǝtǝǝwǝ sa pǝ le yee nyuŋceŋceŋ wǝ́ pǝ la mwɛŋ nyuŋkpǝ pǝ lǝ pǝ́ tuwǝ rɛ we, mǝ Tǝ ŋ kpii rǝ yulaarǝ we, lée yee wǝ ŋ koonu pǝ. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Duturǝ ɖi fɛɛwǝ we enyi eyi amaa enyi ata pǝ lo ku pǝ yaa rǝ mǝ nyɩŋrǝ we, ŋ́ yaa ŋ́ kʊla mǝ pǝ.»<verse eid="MAT 18:20" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ sʊmatǝyǝ rɛ ŋ lɛnyɩ yurǝ wǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Wǝ́ Pɛtǝro ŋ rùu ŋ kǝ̀lǝ mǝ Yesu. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, mǝŋ mǝ kɛrɩyǝ rɛ re lée yee mǝ mǝ turɔɔrɔɔwǝ rɛ, kǝpaka wǝ́ ŋ́ nǝ́ǝ fǝ ŋ́ cɛɛ ŋwǝ wǝ? Kǝpǝrɩmata?» <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ nǝŋ tíi lǝ́ ǝkǝnǝŋ ko ro kǝpǝrɩmata, paa kǝtǝpǝrɩmata kpeewǝ pǝrɩmata<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Pǝ lóo koru onuŋ wǝlo duturǝ ǝkǝnǝŋ: Kǝtǝpǝrɩmata mǝ kǝpǝrɩmata.</char></note>. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Wǝ kǝto yulaarǝ le wǝpilirikpǝ wǝ lǝ rǝ mǝŋ piliyǝ rɛ ŋ pǝ̀ ŋ yee akʊŋtayǝ mǝ na asʊmatǝpǝ wǝ. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Kǝ́ ŋ ne tie eni we, wǝ́ pǝ pǝlǝ mǝ nyiyǝ rɛ ŋ ke re no wǝtoomumuŋkpǝ rɛ ŋpa wǝ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Nyiyǝ sa lǝǝ kǝ lǝmǝ tǝrɛ ŋ nǝh fǝ ŋ mwara wǝtookpǝ sa. Wǝ́ no kulǝtǝyǝ ŋ tìi pǝ fǝ ŋwǝ pǝ ke siiri mǝŋ rɔŋyǝ kǝtǝ, kǝ pǝ siiri mǝŋ ne tie mǝ ne epipǝ mǝŋ no otulǝmǝyǝ kpǝlo kɩɩkɩ, kǝ pǝ nya fɛɛ pǝ pa mwara no wǝtookpǝ sa. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Wǝ́ sʊmatǝyǝ sa ŋ kolu ŋ kʊnʊ rǝ no kulǝtǝyǝ la kǝnyɩŋkǝ ŋ kpìi na dɔɔkpɛɛrǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, lɛrǝ daarǝ lǝ́ rǝ mǝ oŋuŋkǝ. Ŋ́ nah pa mwara lǝ́ wǝtookpǝ sa wǝlo kpǝlo kɩɩkɩ!” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Wǝ́ sʊmatǝyǝ sa lo tuwǝ wǝ cò no kulǝtǝyǝ la tǝlarǝwǝ. Wǝ́ ŋ fǝ̀ wǝtookpǝ we ŋ cɛ̀ɛ ŋwǝ, wǝ́ ŋ nyàrǝ ŋwǝ ŋ cò ŋ ko ŋ ko. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Kǝ́ sʊmatǝyǝ sa ŋ no ru we, wǝ́ ŋ kù mǝ na kɛrɩsʊmatǝyǝ rɛ ŋ ke re no wǝtoopikpǝ rɛ wǝ. Wǝ́ ŋ kpìi na gbɛɛsɔrǝ ŋ mʊ̀ʊrʊ ŋwǝ ŋpa. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Mwara wǝtookpǝ we e re mǝ wǝ!” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Wǝ́ na kɛrɩyǝ we ŋ sʊ̀ʊ ŋ kʊnʊ ŋwǝ. Wǝ́ ŋ kpìi na dɔɔkpɛɛrǝ ǝkǝnǝŋ: “Lɛrǝ daarǝ lǝ́ rǝ mǝ oŋuŋkǝ. Ŋ́ nah pa mwara lǝ́ wǝtookpǝ sa wǝlo kpǝlo kɩɩkɩ!” <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Wǝ́ sʊmatǝyǝ sa ŋwǝ paa ŋ sǝ́nǝ. Tǝ fǝ kʊla we, wǝ́ ŋ kolu ŋ tanǝ ŋwǝ ko ro eniyǝ we ŋ náa mwara wǝtookpǝ we wǝ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kǝ́ asʊmatǝtuturupǝ we pǝ la nyɩŋ tuwǝ sa we, wǝ́ wǝ yeli pǝ la tǝrɛ ŋpaŋpa. Wǝ́ pǝ fǝ̀ tu ri ŋ tu pǝ kolu pǝ pɔ̀ pǝlo kulǝtǝyǝ la amayǝ. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Wǝ́ kulǝtǝyǝ ŋ kpìi pǝ kolu pǝ pwò sʊmatǝyǝ sa pǝ pǝlǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Sʊmatǝrɔɔrɔɔyǝ rɛ wǝ́ e ri! Kǝ́ e le kpii mǝ dɔɔkpɛɛrǝ kǝto wǝ́ ŋ́ nǝ fǝ ló wǝtookpǝ we kpǝlo kɩɩkɩ ŋ́ na cɛɛ lǝ́. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ŋlá ŋkpɛ a kah nyɩŋ lá kɛrɩyǝ la tǝlarǝwǝ mǝŋ kǝ́ ŋ́ na nyɩŋ lǝ́ tǝlarǝwǝ kǝtǝ.” <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Wǝ́ kulǝtǝyǝ sa ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋpa, wǝ́ ŋ fǝ̀ sʊmatǝyǝ sa ŋ kpìi okukpɛɛtǝpǝ lǝ ǝrǝŋtǝpǝ rǝ akaakǝ kǝ pǝ ta no kǝtukoŋkǝ ŋpa ko ro eniyǝ we ŋ náa mwara wǝtookpǝ we kpǝlo kɩɩkɩ ŋ lɛ wǝ.»<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ nǝŋ fǝ ŋ cɛɛ na kɛrɩyǝ ŋ ru ǝrǝ na ziɔŋrǝ mǝrǝ we, kǝ́ mǝ Tǝ rǝ yulaarǝ ŋ neh pe ke yee mǝ ŋwǝ wǝǝ».<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesu la kaŋ otuyǝ lo ru rǝ kǝtiesǝ́ŋkǝ</para>
  <para style="r">(<ref loc="MRK 10:1-12">Marǝko 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Kǝ́ Yesu ŋ na tɛŋ etieyǝ sa ŋ ne tíi pǝ ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ rǝ Galileya la gaarǝ we ŋ ko ŋ ko Yudeya la gaarǝ gbii rǝ Yɔrǝdaŋ la kǝtakǝ nɔ wǝ. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ sìimǝ ŋwǝ. Wǝ́ ŋ cà anyaatǝpǝ rǝ fɛɛwǝ we. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Wǝ́ Afarisitǝpǝ rɛ pǝ rùu pǝ kǝlǝ mǝ Yesu mǝ yupurǝ ŋpǝ pǝ kɔŋ na kpɛrɛwǝ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Pǝ la pɔrʊ gʊŋrǝ pǝ lo koonu pǝrǝŋyǝ ŋ sǝ́ŋ ne tieyǝ rǝ die ri ŋ die lo yurǝ?» <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nyǝǝ kǝ rǝ Worokoyǝ le dierǝ lǝ mǝrǝ nǝ nyɩŋ ǝkǝnǝŋ rǝ kǝsǝŋkǝ we, yǝ we ŋ cò nyɩmaasɩyǝ we, cò ŋwǝ pǝrǝŋyǝ mǝ tieyǝ?»<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 1:27">1Mo 1:27</ref></char>.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Wǝ kǝto pǝrǝŋyǝ láa pwɛyɩ rǝ nǝ tǝ mǝ ne lee lǝ kpǝŋ, kǝ ŋ ka kpaa ŋ maarǝ mǝ ne tie, kǝ pǝle eyi pǝ siɛrɩ pǝ yee nyiyǝ ceŋceŋ.<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 2:24">1Mo 2:24</ref></char>.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Mǝŋkǝsa we, pǝ lǝǝ tǝ pǝ lǝ enyi eyi, paa nyiyǝ ceŋceŋ. Kǝto rɛ ŋ pǝǝ sǝpǝ tuwǝ we Worokoyǝ ŋ na ca ŋ ne kpii rǝ awɛ wǝ.» <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Wǝ́ Afarisitǝpǝ we pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ Mose paa ŋ na tɛŋ ǝkǝnǝŋ mǝŋ pǝrǝŋyǝ rɛ lǝ́ǝ sǝ́ŋ ne tieyǝ we, ŋ koonu na kǝraŋsiefwɛɛkǝ<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="MAT 5:31">5:31</ref></char>.</char></note> kǝ la pɔrʊ kǝ la kaŋ ǝkǝnǝŋ lǝ sǝ́ŋ ŋwǝ wǝ?» <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ yulɛnyɩrǝ kǝto wǝ́ Mose ŋ no koonu nǝ gʊŋrǝ ŋnǝ nǝ mǝ sǝ́ŋ ne etiepǝ wǝ. Paa rǝ kǝsǝŋkǝ we, wǝ lǝǝ kǝ lǝ ǝnǝ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, mǝŋ nyiyǝ rɛ lǝ sǝ́ŋ ne tie, wǝ lee ri ǝkǝnǝŋ tieyǝ sa la yɩɩ vúurǝ rǝ, wǝ́ ŋ nǝ fǝ tiepʊŋpwayǝ rɛ ŋ na lɔ we, yǝ we le yee kǝtienaakǝ.»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Wǝ́ no otukarǝtǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ pǝrǝŋyǝ mǝ ne tie le dierǝ lǝ vǝ ǝnǝ we, we mǝŋ a laa lɔ tieyǝ kʊraa, wǝ ponu wǝ teeri oo». <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋkǝ enyikpǝlo pǝ lóo koru alɔ otukaŋyǝ sa! We tɛŋ epǝ we Worokoyǝ ŋ no koonu pǝ lǝ wǝ ceŋceŋ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Duturǝ ɖi otuyǝ kpookpoo yǝ kpii yǝ lo koonu enyirɛɛpǝ pǝ lǝŋ koru alɔ tieyǝ wǝ: Arɛɛpǝ we, kǝ́ pǝ lǝ mǝ pǝ wǝǝ. Arɛɛpǝ we, enyipǝ pǝ la fwɛ pǝ! Apʊŋpwapǝ we, rǝ yulaarǝ le wǝpilirikpǝ we kǝto pǝ lǝŋ koru alɔ tieyǝ! Yǝ we ŋ nóo koru alɔ dierǝ sa we, kǝ ŋ lɔ rǝ!»<verse eid="MAT 19:12" /></para>
  <para style="s">Yesu la pɛɛrɩ alaatiepipǝ</para>
  <para style="r">(<ref loc="MRK 10:13-16">Marǝko 10:13-16</ref>, <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Enyipǝ pǝ kǝ ŋ fǝ̀ alaatiepipǝ pǝ ŋ pǝ kǝ Yesu ŋ nya fɛɛ ŋ tɛɛ pǝ la akaakǝ, kǝ ŋ mwɛŋ nyuŋkpǝ ŋ koonu pǝ. Paape wǝ́ otukarǝtǝpǝ we pǝ ka ŋ kpaŋ mǝ pǝ. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ maa alaatiepipǝ pǝ pǝ mǝ kpǝŋ. Nǝ pǝǝ sǝŋ wǝla gʊŋrǝ nǝ koonu pǝ. Duturǝ ɖi epǝ we pǝ lǝ mǝŋ alaatiepipǝ sa kǝtǝ we, yulaarǝ le wǝpilirikpǝ we wǝ ri pǝla wǝnɛŋ.» <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Kǝ́ Yesu ŋ na tɛɛ epipǝ we la akaakǝ ŋ na lɛ we, wǝ́ ŋ pwɛ̀yɩ rǝ fɛɛwǝ we.<verse eid="MAT 19:15" /></para>
  <para style="s">Kosopisɩkalǝtǝyǝ rɛ</para>
  <para style="r">(<ref loc="MRK 10:17-31">Marǝko 10:17-31</ref>, <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Wǝ́ nyiyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ Yesu. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, kǝ́ lo tuceecee wǝ́ ŋ́ née yee kǝ ŋ́ nya vɔrʊlaalɛɛrǝ?» <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ ǝ lǝ́ǝ pǝ́ mǝ dierǝ o ru rǝ tuwǝ wǝ ri tuceeceewǝ wǝ? Worokoyǝ ceŋceŋ ko ŋ ponu wǝ. Mǝŋ ǝ lǝ́ǝ pǝ́ e fii vɔrʊrǝ we mǝrǝ we, mǝ yee a mǝ saŋ rǝ esepǝ we.» <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Wǝ́ nyiyǝ sa ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Esepǝ rǝ fǝŋ?» Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Paa wʊ nyiyǝ, pee yee kǝtienaakǝ, paa yɩɩ, paa nia a tɛɛ rǝ rɛ, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />pu lǝ́ tǝ mǝ lé lee, taa lá kɛrɩyǝ lǝ kǝǝwǝ mǝŋ ŋlǝ́ŋlǝ́ lá wɛ kǝtǝ». <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Wǝ́ kosopiyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ née yee mǝ ŋ saŋ rǝ esepǝ sa kɩɩkɩ. Kǝ́ lo tu wǝ lo tuuru ŋ́ yee?» <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝŋ ǝ lǝ́ǝ pǝ́ o to milimili we, ko e ke siiri ló otulǝmǝyǝ kpǝlo kɩɩkɩ, kǝ ǝ fǝ sɩkayǝ we o koonu ariariatǝpǝ. Mǝŋkǝsa we ǝ lǝ́ǝ lǝmǝ otuyǝ rǝ yulaarǝ, kǝ ǝ mǝ pǝ e pe siimǝ mǝ.» <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Paa kǝ́ kosopiyǝ sa ŋ no nuŋ tuwǝ sa we, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko mǝ tǝlarǝ mǝ tǝlarǝ. Duturǝ ɖi kǝ lǝǝmǝ otuyǝ ŋpa!<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, nyiyǝ we ŋ lǝǝmǝ na wɛ we, kǝ́ wǝ lɛnyɩ wǝ koonu ŋwǝ kǝ ŋ fii yulaarǝ le wǝpilirikpǝ we mǝrǝ we! <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ŋ́ tǝ ŋ́ ya ŋ́ née tíi nǝ tuwǝ sa ǝkǝnǝŋ wǝ yɔlʊ wǝ koonu kpɔŋkɔyǝ kǝ ŋ fii ŋ ka tɛlɩ rǝ nimiwǝ lo ŋuŋrǝ wǝ teeri kǝ́ sɩkalǝtǝyǝ ŋ neh fii Worokoyǝ le wǝpilirikpǝ we mǝrǝ wǝ.» <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Kǝ́ Yesu lo otukarǝtǝpǝ we pǝ lo nuŋ etieyǝ sa we, wǝ́ wǝ rili pǝlo mumuŋ ŋpa wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «We ǝlǝ ŋ nóo koru anya alɔkuŋkǝ wǝ?» <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Wǝ́ Yesu ŋ yɩ̀rɩ pǝ pʊrɩpʊrɩ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Anyɩmaasɩpǝ pǝ lǝŋ koru tuwǝ sa le eyee, paa Worokoyǝ lóo koru tu ri ŋ tu le eyee». <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Wǝ́ Pɛtǝro ŋ yìili ǝkǝnǝŋ: «Yɩrɩ re, ŋlǝ ǝpǝ ǝnǝ yǝ la maa tu ri ŋ tu yǝ lo co, wǝ́ le siimǝ lǝ́ wǝǝ kǝto wǝ lǝh kǝ lǝ lǝ wǝ fǝ nɛ?» <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, vǝ́ Nyɩmaasɩ le Pi le pe ke tii rǝ ne bilisaamumuŋrǝ we rǝ eniyǝ we pǝ láa siɛrɩ tu ri ŋ tu pǝ yee aŋwǝŋwɛŋ we, ŋnǝ ǝpǝ ǝnǝ nǝ nye siimǝ mǝ we, ŋnǝ ŋkpɛ nǝ nyeh ke tii rǝ epilisaayǝ tǝ mǝ eyi nǝ tɛŋ akpaŋyǝ mǝ Isǝrayɛlǝ lǝ ǝkpǝŋtǝmeyiyǝ we. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Wǝ́ epǝ we kpǝlo kɩɩkɩ pǝ láa nyarǝ pǝla anyarǝyǝ pǝ co, pǝla apaanʊpǝ, pǝla apaatɛpǝ, pǝlǝ ǝtǝpǝ, pǝle eleepǝ pǝle epipǝ, pǝla wǝtɛɛkpǝ pǝ co rǝ mǝ yurǝ we, pǝ lah pa lɔ yǝ kpeewǝ tuuru kǝ pǝ lɛ pǝ nya vɔrʊlaalɛɛrǝ. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Paape we, enyisǝsǝŋpǝ wa pǝ leh pe ri ǝtǝtǝǝlǝpǝ, kǝ enyitǝtǝǝlǝpǝ wa pǝ pe ri ǝsǝsǝŋpǝ.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ apaalǝtǝpǝ rɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Nǝ nuŋ tuwǝ lǝ wǝ yulaarǝ le wǝpilirikpǝ wǝ lo ru wǝ. Kulǝtǝyǝ rɛ rù mǝ ɖokoŋpirǝ kolu tàa apaalǝtǝpǝ pǝ ko na arɛzɛŋtɛɛkǝ. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Wǝ́ pǝ nunu awɛ lo duturǝ ǝkǝnǝŋ ŋ nah pa mwara pǝ jirǝ jeŋceŋ sɩkakpotokpotoyǝ ceŋceŋ, wǝ́ ŋ màa pǝ pǝ ko ŋ ko atɛɛkǝ we. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Wǝ́ Kulǝtǝyǝ sa ŋ tǝ ŋ rù mǝ ɖokoŋpirǝ le eniyǝ faŋceŋceŋ, wǝ́ ŋ nyɩnɩ apaalǝtǝpʊŋpwapǝ pǝ yaa rǝ canɩyǝ pǝ laa ya pǝ lée yee tǝrɛ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋnǝ ŋkpɛ nǝ mǝ ko nǝ ke yee anǝnɛyǝ rǝ mǝ atɛɛkǝ sa kǝ ŋ́ mwara nǝ sɩkayǝ we ŋ kaamǝ wǝ.» <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Wǝ́ kǝceece pǝ ko ŋ ko atɛɛkǝ we. Wǝ́ kulǝtǝyǝ we ŋ tǝ ŋ rù mǝ cɔkɔŋtiizaarǝ le eniyǝ, wǝ́ ŋ tǝ ŋ rù mǝ ɖiɔrǝ le eniyǝ ta wǝ́ ŋ tǝ ŋ yeli wǝ mǝŋkɔɔwe. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Kǝ́ wǝ la ca ɖiɔrǝ le eniyǝ tʊʊ we, wǝ́ kulǝtǝyǝ sa ŋ tǝ ŋ rù wǝ́ ŋ nyɩnɩ enyipǝ rɛ pǝ yaa. Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ nya pa yaa rǝ fɛɛwǝ sa jɔkɔŋcirǝ sa fee wǝ́ nǝ nyaa ya nǝ nyée yee tǝrɛ wǝ?» <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Wǝ́ pǝ tìi kulǝtǝyǝ we ǝkǝnǝŋ: «Rɛ loo koonu lǝ anǝnɛyǝ le yee kǝto.» Wǝ́ kulǝtǝyǝ we ŋ tìi pǝ ǝkǝnǝŋ: «We ŋnǝ ŋkpɛ nǝ mǝ ko nǝ ke yee anǝnɛyǝ rǝ mǝ atɛɛkǝ we».<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Kǝ́ cɔkɔŋyǝ ŋ nah tɔɔ we, wǝ́ tɛɛlǝtǝyǝ we ŋ tìi yǝ we ŋ náa yɩrɩ no otuyǝ ǝkǝnǝŋ: «Pwo apaalǝtǝpǝ we, kǝ a mwara pǝlo wǝtookpǝ. Tie rǝ epǝ we pǝ lo ko atɛɛkǝ we pǝ lǝ tǝǝlǝ kǝ a ka lɛ mǝ epǝ we pǝ lǝ sǝŋ oko wǝ.» <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Wǝ́ apaalǝtǝpǝ we pǝ kolu mǝ ɖiɔrǝ le eniyǝ tʊʊ pǝ conu pǝ pǝlǝ pǝ yàa. Wǝ́ nyi ri ŋ nyi ŋ lɔ̀ sɩkakpotokpotoyǝ ceŋceŋ. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Wǝ́ wǝ pǝlǝ wǝ tùu epǝ we pǝ sǝnǝ atɛɛkǝ we lo oko wǝ. Pǝ ko ŋ pu wǝ ǝkǝnǝŋ pǝ lah mwara pǝ pǝ teeri. Paape, wǝ́ ŋpǝ ŋkpɛ pǝ lɔ̀ sɩkakpotokpotoyǝ ceŋceŋ ceŋceŋ. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Kǝ́ pǝ la lɔ sɩkayǝ sa ǝnǝ we, wǝ́ pǝ yà pǝ ka ŋ kpaŋ mǝ tɛɛlǝtǝyǝ we ǝkǝnǝŋ: <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />«Enyipǝ sa pǝ lǝ pǝ atɛɛkǝ sa pǝ lǝ tǝǝlǝ wǝ, eniyǝ ceŋceŋ ko wǝ́ pǝ la yaa rǝ atɛɛkǝ sa pǝ le yee anǝnɛyǝ. Ŋlǝ paa yǝ le yee anǝnɛyǝ yǝ la faŋ jirǝ sa kpǝlo kɩɩkɩ rǝ cɔkɔŋkeleleyǝ sa, wǝ́ paa a la mwara ŋlǝ mǝ pǝ wǝtookpǝ wǝceŋceŋ!» <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Wǝ́ kulǝtǝyǝ we ŋ tìi pǝle ceŋceŋ ǝkǝnǝŋ: «Kɛrɩ, ŋ́ nee sisi lǝ́ o. Mǝŋkǝ yǝ lo nuŋ awɛ lo duturǝ ǝkǝnǝŋ ŋlǝ́ e lée yee anǝnɛyǝ kǝ ŋ́ mwara lǝ́ sɩkakpotokpotoyǝ ceŋceŋ? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Lɔ lá sɩkayǝ kǝ a pwɛyɩ. Ŋmǝŋmǝ ŋ́ nǝ pǝ́ ŋ́ mwara nyiyǝ sa ŋ nǝ pǝ ŋ nǝ tǝǝlǝ mǝŋ kǝ́ ŋ na mwara lǝ́ wǝ. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Wǝ laa kaamǝ kǝ ŋ́ fǝ mǝ sɩkayǝ ŋ́ yee tuwǝ we wǝ ponu mǝ mǝ wǝ? Amaa kǝ́ ŋ́ ne yee wǝceeceekpǝ kǝto wǝ́ wǝ ya wǝ lée fii lǝ́ wǝ? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Mǝŋkǝsa we, enyitǝtǝǝlǝpǝ pǝ leh pe ri ǝsǝsǝŋpǝ, kǝ enyisǝsǝŋpǝ pǝ pe ri ǝtǝtǝǝlǝpǝ.»<verse eid="MAT 20:16" /></para>
  <para style="s">Yesu lǝ tǝ la wɛɛlɩ kǝtatǝkǝ lo ru rǝ nǝ ǝkpǝ́kǝ mǝ na asaanǝkǝ</para>
  <para style="r">(<ref loc="MRK 10:32-34">Marǝko 10:32-34</ref>, <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesu ko ŋ ko Yerusalɛmǝ wǝ́ ŋ pɔ̀rʊ ne enyikpiipǝ we pǝlǝ tǝ mǝ eyi kpoo ŋ sanǝ mǝ pǝ ŋ ko ŋ ko, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />Nǝ nyǝŋ nyɩŋ, yǝ loh ko Yerusalɛmǝ, kǝ pǝ kǝ fǝ Nyɩmaasɩ le Pi pǝ kpii otoolutǝmumuŋpǝ mǝ esekaŋtǝpǝ rǝ akaakǝ, kǝ pǝ tɔɔ na gbɛŋpɔrǝ. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Pǝ lǝ́ǝ fǝ ŋwǝ pǝ kpii epǝ we pǝ lee ri Oyudatǝpǝ rǝ akaakǝ, kǝ pǝ mɔɔnʊ ŋwǝ, kǝ pǝ culu ŋwǝ mǝ fwɛɛpǝlawǝ, kǝ pǝ lɛ pǝ kpaa ŋwǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ kǝ ŋ kpǝ́, kǝ juutatǝrǝ ŋ saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.<verse eid="MAT 20:19" /></para>
  <para style="s">Yakubu mǝ Yowanɛsɩ le lee lǝ pǝ́ Yesu ŋ yee tǝrɛ ŋ koonu ne epipǝ sa</para>
  <para style="r">(<ref loc="MRK 10:35-45">Marǝko 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Wǝla kǝmaakǝ wǝ́ Zebede le tie ŋ rùu ŋ kǝ̀lǝ mǝ Yesu ŋpǝ mǝ nǝ ǝpǝrǝŋpipǝ eyi. Wǝ́ tieyǝ sa ŋ sʊ̀ʊ ŋ kʊnʊ rǝ Yesu la kǝnyɩŋkǝ kǝ ŋ pǝ́ na tǝrɛ. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Wǝ́ Yesu ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ a ya lǝ́ǝ pǝ́?» Wǝ́ tieyǝ sa ŋ tìi ŋwǝ ǝkǝnǝŋ: «Dɔɔkpɛ, co mǝ garǝ ǝkǝnǝŋ vǝ́ e le pe yi e leh ri wǝpilikpǝ sa we, kǝ mǝ ǝpǝrǝŋpipǝ sa pǝ pe tíi ceŋceŋ rǝ lé kǝnirisiɛɛkǝ ceŋceŋ rǝ lá kǝpɛŋsiɛɛkǝ». <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nyee ci tuwǝ nǝ ya nǝ nyǝ́ǝ pǝ́ wǝ. Nǝ nyóo koru atɛɛnɩ pǝ ŋʊʊnʊ nǝ acʊcʊʊrʊpiyǝ sa pǝ lah ŋʊʊnʊ mǝ wǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Yǝ lóo koru.» <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Awo, nǝ nyáa tɛɛnɩ pǝ ŋʊʊnʊ nǝ acʊcʊʊrʊpiyǝ we pǝ lah ŋʊʊnʊ mǝ wǝ. Paape we, ŋkǝ ŋmǝ ŋ́ náa tɛŋ ǝkǝnǝŋ yǝ ǝnǝ ŋ pe tii rǝ mǝ kǝnirisiɛɛkǝ amaa mǝ kǝpɛŋsiɛɛkǝ. Afɛɛtiiyǝ sa we, yǝ ri rǝ epǝ we mǝ Tǝ ŋ na kpaka yǝ ŋ nǝ tǝnǝ la anɛŋ.» <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Kǝ́ enyikpiituturupǝ we pǝlǝ tǝ pǝ lo nuŋ dierǝ sa we, wǝ́ pǝ fǝ̀ kpɛɛmʊrʊwǝ pǝ tɛ̀ɛ rǝ apaanʊpǝ we pǝle eyi. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Wǝ́ Yesu ŋ pwò pǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ cii, epǝ we pǝ ri ǝkǝŋyǝ le epilipǝ we, pǝ lée si pǝlǝ ǝkǝŋyǝ le enyipǝ pǝ ŋ maarǝ. Wǝ́ omumuŋpǝ rǝ gǝŋrǝ we pǝ la nya okopiyǝ rǝ otuturupǝ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ŋnǝ paa we, wǝ pǝǝ lǝ ǝnǝ rǝ nǝ mǝrǝ. Paa mǝŋ rɛ lǝ́ǝ pǝ́ ŋ ri mumuŋyǝ rǝ nǝ mǝrǝ we, yǝ we ŋ ri nǝ sʊmatǝyǝ. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Wǝ́ mǝŋ rɛ ya lǝ́ǝ pǝ́ ŋ ri sǝsǝŋyǝ rǝ nǝ mǝrǝ we, we yǝ we ŋ ri nǝ sʊmatǝyǝ. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Kaa wǝǝ Nyɩmaasɩ le Pi lǝ pǝ ŋkǝ kǝ pǝ pa sʊma ŋwǝ rǝ, paa lǝ pǝ ŋ pa sʊma enyipǝ, kǝ ŋ fǝ na vɔrʊrǝ ŋ koonu, kǝ ŋ nya fɛɛ ŋ lɔ ŋ koonu enyipǝ wa.»<verse eid="MAT 20:28" /></para>
  <para style="s">Yesu la cá alaanyɩŋtǝpǝ rɛ eyi</para>
  <para style="r">(<ref loc="MRK 10:46-52">Marǝko 10:46-52</ref>, <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Kǝ́ pǝ ka ŋ pwɛyɩ rǝ Yeriko we, anyɩŋ nyikpǝŋmumuŋwǝ rɛ wǝ siimǝ Yesu. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Alaanyɩŋtǝpǝ rɛ eyi pǝ tini rǝ kʊŋlɛɛrɩwǝ. Kǝ́ pǝ la nya pǝ lo nuŋ ǝkǝnǝŋ Yesu ŋ nǝ pǝ ŋ náa tɛlɩ we, wǝ́ pǝ ko ŋ woolu ǝkǝnǝŋ: «Kulǝtǝyǝ, Davidǝ le Pilepi, nyɩŋ lǝ tǝlarǝwǝ oo!» <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Wǝ́ nyikpǝŋwǝ we wǝ yà wǝ ka ŋ kpaŋ mǝ pǝ kǝ pǝ rǝŋ. Paape wǝ́ pǝ ci ǝtǝ pǝ yà pǝ ko ŋ woolu ŋpa ǝkǝnǝŋ: «Kulǝtǝyǝ, Davidǝ le pilepi, nyɩŋ lǝ tǝlarǝwǝ oo!» <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Wǝ́ Yesu ŋ tùumǝ ŋ yàa, Wǝ́ ŋ pwò pǝ, wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nǝ ya nǝ nyǝ́ǝ pǝ́ ŋ́ yee ŋ́ koonu nǝ?» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Wǝ́ alaanyɩŋtǝpǝ we pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kulǝtǝyǝ, yǝ lǝ́ǝ pǝ́ leh enimiyǝ yǝ ŋ nyɩŋ.» <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Wǝ́ pǝlo tuwǝ wǝ cò Yesu la tǝlarǝwǝ, wǝ́ ŋ rùu pǝle enimiyǝ. Rǝ kǝyaakǝ we, wǝ́ pǝ ka ŋ nyɩŋ. Wǝ́ pǝ sìimǝ Yesu.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu leh fii Yerusalɛmǝ</para>
  <para style="r">(<ref loc="MRK 11:1-11">Marǝko 11:1-11</ref>, <ref loc="LUK 19:28-40">Luka 19:28-40</ref>, <ref loc="JHN 12:12-19">Yowanɛsɩ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Kǝ́ Yesu mǝ no otukarǝtǝpǝ we pǝ lo ruu pǝ lǝh kǝlǝ mǝ Yerusalɛmǝ we, anyɩŋ pǝ leh fii dǝŋtǝǝpirǝ we pǝ lóo pwo Befage kǝ́ o loh ko rǝ oliviepǝ lo dutupirǝ we we, wǝ́ Yesu ŋ kpìi no otukarǝtǝpǝ eyi. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ ko dǝŋtǝǝpirǝ sa yaa rǝ nǝ kǝnyɩŋkǝ. Vǝ́ nǝ nye ke fii kǝtǝrǝceŋceŋ we, nǝ nyáa nyɩŋ pǝ la kɔŋ rookɛtɛyeeyǝ rɛ. Ne birǝ yaa rǝ na kǝlɛɛrɩkǝ. Nǝ wuru pǝ nǝ po koonu mǝ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Wǝ́ mǝŋ rɛ le tíi nǝ tǝrɛ we, nǝ tíi ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ ya lǝ́ǝ pǝ́ pǝ.” Pǝ láa nyarǝ pǝ pǝ co pǝ koonu nǝ kǝtǝrǝceŋceŋ.»<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Tuwǝ sa wǝ pǝlǝ ǝnǝ kǝ worokokpɛɛnuŋtɛŋtǝyǝ le dierǝ we ŋ tɛnɩ we, nya fɛɛ bǝ. Tɛnɩ ǝkǝnǝŋ:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«Nǝ tíi Aziɔŋtǝnyipǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 21:5">Nǝ yɩrɩ re, nǝ piliyǝ lo furu nǝ kpǝŋ!</para>
  <para style="q1" vid="MAT 21:5">Wǝlǝtaarǝkpǝ wǝ kpii rǝ ŋwǝ,</para>
  <para style="q1" vid="MAT 21:5">tɛɛ rǝ rookɛtɛyeeyǝ lǝ́ǝ pǝ.</para>
  <para style="q1" vid="MAT 21:5">Wǝ́ ŋ tɛɛ rǝ ɖookɛtɛpirǝ, kɛɛyǝ sa ŋ née re eleeyǝ.»<verse eid="MAT 21:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Wǝ́ kǝceece otukarǝtǝpǝ we pǝ ko ŋ ko wǝ́ pǝ kolu pǝ yeli mǝŋ kǝ́ Yesu ŋ tìi pǝ ŋ fǝ̀ wǝ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Wǝ́ pǝ lɔ̀ rookɛtɛyeeyǝ we mǝ ne birǝ pǝ rè pǝ pǝlǝ. Wǝ́ pǝ fǝ̀ pǝla wǝkpakpǝ pǝ tɛ̀ɛ rǝ akɛɛpǝ we, wǝ́ Yesu ŋ rɛ̀ ŋ tini rǝ pǝ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Wǝ́ nyikpǝŋmumuŋwǝ rɛ wǝ pɔ̀rʊ wǝla wǝkpakpǝ pǝ cò gʊŋrǝ we, wǝ́ arɛɛpǝ pǝ ko ŋ pòolu eciilaŋpiyǝ pǝ ŋ co gʊŋrǝ we. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Nyikpǝŋwǝ we wǝ ko conu mǝ ŋwǝ mǝ epǝ we pǝ kǝ tǝǝlǝ pǝ ko ŋ woolu pǝ ŋ tɛŋ ǝkǝnǝŋ: «Nǝ kǝ Davidǝ le pilepiyǝ! Woroko ŋ pɛɛrɩ yǝ we ŋ no furu rǝ Ǝtǝ Woroko la nyɩŋrǝ wǝ! Nǝ kǝ Worokoyǝ we ŋ tɛɛ rǝ oŋuŋkǝ wǝ!» <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />Kǝ́ Yesu ŋ ne ke fii Yerusalɛmǝ we, wǝ́ tǝŋtǝǝwǝ sa kpǝlo kɩɩkɩ wǝ cà mǝ awɛ. Wǝ́ enyipǝ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Ǝlǝ ŋ kaamǝ nyiyǝ lǝ yǝ ǝnǝ?» <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Wǝ́ enyipǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Yesu, worokokpɛɛnuŋtɛŋtǝyǝ we ŋ no ru rǝ Nazarɛtǝ rǝ Galileya la gaarǝ wǝ».<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu le piri otusiiritǝpǝ rǝ Worokoyǝ la nyarǝwǝ</para>
  <para style="r">(<ref loc="MRK 11:15-19">Marǝko 11:15-19</ref>, <ref loc="LUK 19:45-48">Luka 19:45-48</ref>, <ref loc="JHN 2:13-22">Yowanɛsɩ 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Wǝ́ Yesu ŋ kolu ŋ fìi Worokoyǝ la nyarǝwǝ. Wǝ́ ŋ pìri epǝ we kpǝlo kɩɩkɩ pǝ yà pǝ ke ŋ siiri otuyǝ mǝ epǝ we pǝ yà pǝ ko ŋ fuu otuyǝ rǝ Worokoyǝ la nyarǝwǝ le etikeŋtikǝ wǝ. Wǝ́ ŋ rè epǝ we pǝ láa nyaa sɩkayǝ<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">Oyudatǝpǝ we pǝ ko ŋ ru rǝ ǝkǝŋpʊŋpwayǝ pǝ ŋ pǝ we, pǝ ka ŋ nyaa pǝla sɩkayǝ kǝ pǝ nya fɛɛ pǝ koru ofuu akɛɛpǝ pǝ ke yee otoolukǝ kǝ pǝ lɛ pǝ mwara jɛŋkpǝrǝ rǝ Worokoyǝ la nyarǝwǝ.</char></note> la akpǝlɔpǝ ŋ cò. Wǝ́ ŋ lɛ̀ ŋ rè epǝ we pǝ ya pǝ lée siiri otookpapǝ la asaayǝ ŋ cò. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoŋtierǝ la tɛŋ ǝkǝnǝŋ: “Pǝ loh mǝ pwo mǝ nyarǝwǝ ǝkǝnǝŋ fɛɛmwɛŋnyuŋkpǝ.” Wǝ́ ŋnǝ paa nǝ nyǝ fǝ wǝ nǝ nye yee ayɩlayɩtǝpǝ la fɛɛŋwaawǝ.» <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Wǝ́ alaanyɩŋtǝpǝ mǝ ǝsǝ́ŋpǝ pǝ ko ŋ ruu pǝ ŋ kǝlǝ mǝ Yesu rǝ Worokoyǝ la nyarǝwǝ, wǝ́ ŋ cà pǝ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Kǝ́ otoolutǝmumuŋpǝ we mǝ esekaŋtǝpǝ we pǝ la nyɩŋ otucovurǝ we Yesu ŋ ne yee fǝ kʊla mǝ epipǝ we pǝ ya pǝ lóo woolu rǝ Worokoyǝ la nyarǝwǝ pǝ ŋ tɛŋ ǝkǝnǝŋ «Nǝ kǝ Davidǝ le Pilepi!» we, wǝ́ pǝ fǝ̀ kpɛɛmʊrʊwǝ. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Wǝ́ pǝ kǝ ŋ pǝ́ Yesu ǝkǝnǝŋ: «A ya lóo nuŋ tuwǝ pǝ ya pǝ láa tɛŋ wǝ?» Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Awo! Nǝ fǝǝ kǝ Worokoŋtierǝ la fɛɛwǝ sa wǝ la tɛŋ ǝkǝnǝŋ: “A la kpaka lǝ ǝkǝkǝ ǝ lǝ tǝnǝ saŋ rǝ alaatiepipǝ mǝ epiŋwɛŋpǝ lo nyuŋkpǝ” nǝ nyɩŋ?» <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Wǝ́ Yesu ŋ màa pǝ rǝ we, wǝ́ ŋ pwɛ̀yɩ rǝ tǝŋtǝǝwǝ sa ŋ ko ŋ ko Betania. Wǝ́ ŋ kolu ŋ kpɛ̀lɩ rǝ we.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu la fwɛɛrɩ wǝcookpǝ rɛ wǝ lǝŋ nyɩŋ wǝ</para>
  <para style="r">(<ref loc="MRK 11:12-14">Marǝko 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Gaalǝǝrǝkǝ, mǝ ɖokoŋpirǝ we, kǝ́ Yesu ŋ nǝ kpǝlǝŋ ŋ nǝh pǝ tǝŋtǝǝwǝ we, anyɩŋ kǝtɛŋkǝ kǝ ya kǝ láa wʊ ŋwǝ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wǝ́ ŋ nyɩnɩ wǝcookpǝ rɛ wǝ yaa rǝ kʊŋlɛɛrɩwǝ. Wǝ́ ŋ rùu ŋ kǝ̀lǝ mǝ kpǝ. Paa laa nya dǝnǝrǝ rɛ, eweyǝ sɔŋ. Wǝ́ ŋ tìi wǝcookpǝ sa ǝkǝnǝŋ: «Ǝ lǝŋ tǝ a pa tɛɛ mǝ dǝnǝrǝ pwi!» Rǝ kǝyaakǝ we, wǝ́ wǝcookpǝ sa wǝ kpàa. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Kǝ́ no otukarǝtǝpǝ we pǝ la nyɩŋ tuwǝ sa we, wǝ́ wǝ rili pǝ lo mumuŋ wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Wǝ le yee wǝ lǝ fǝ nɛ wǝ́ wǝcookpǝ sa wǝ la kpaa kǝtǝrǝceŋceŋ ǝnǝ?» <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, mǝŋ nǝ nya lɔ nǝ nyo nuŋ, wǝ́ nǝ nyǝŋ tǝmǝlǝ we, ŋkǝ tuwǝ sa ŋ́ ne yee mǝ wǝcookpǝ sa ceŋceŋ ko wǝ́ nǝ nyoh mǝ koru eyee. Paa wǝ ke ce wǝ ri nǝ nyée tíi dutupirǝ sa ǝkǝnǝŋ: “Nuru a cɛ rǝ fɛɛwǝ we kǝ a ka tɔɔ rǝ apʊyǝ mǝrǝ”, kǝ wǝ pǝ ǝnǝ. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Mǝŋ nǝ nya lɔ nǝ nyo nuŋ we, tu ri ŋ tu nǝ nyǝ́ǝ pǝ́ rǝ nyuŋmwɛŋwǝ we, nǝ nyáa lɔ wǝ.»<verse eid="MAT 21:22" /></para>
  <para style="s">Pǝ lǝ pǝ́ Yesu le etieyǝ pǝ lo ru rǝ no okopiyǝ lo oŋuŋkǝ</para>
  <para style="r">(<ref loc="MRK 11:27-33">Marǝko 11:27-33</ref>, <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Kǝ́ Yesu ŋ na siɛnɩ ŋ no ko Worokoyǝ la nyarǝwǝ we, wǝ́ ŋ kolu ŋ yà ŋ ka ŋ kaŋ otuyǝ. Wǝ́ otoolutǝmumuŋpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Kǝ́ lo okopi wǝ́ a la nya a ya e lée yee otuyǝ sa ǝnǝ? Wǝ́ ǝlǝ ŋ no koonu lǝ́ ŋyǝ okopiyǝ sa wǝ?» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ nǝ́ǝ pǝ́ nǝ dierǝ jeŋceŋ, jeŋceŋ ko, mǝŋ nǝ nyo koonu mǝ kpǝkpǝlǝŋkuŋwǝ we, ŋ́ née tíi nǝ okopiyǝ le eyǝ we ŋ́ nǝ fǝ ŋ́ ya ŋ́ née yee otuyǝ sa wǝ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yowanɛsɩ lo worokomɛŋwiiriwǝ we wǝǝ, wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ amaa anyɩmaasɩpǝ lǝ kpǝŋ?» Wǝ́ pǝ ka ŋ ŋwaa pǝ ŋ tíi awɛ ǝkǝnǝŋ: «Mǝŋ yǝ la tɛŋ Worokoyǝ we, lǝ́ǝ pǝ́ lǝ ǝkǝnǝŋ: “Kǝ́ kǝto wǝ́ nǝ nyaa lɔ Yowanɛsɩ nǝ nuŋ wǝ?” <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Wǝ́ mǝŋ yǝ la tɛŋ ǝkǝnǝŋ anyɩmaasɩpǝ lǝ kpǝŋ we, yǝ lǝŋ suu nyikpǝŋwǝ sa lo vurǝ? Duturǝ ɖi pǝlo kpǝlo kɩɩkɩ pǝ lɔ̀ pǝ nunu ǝkǝnǝŋ Yowanɛsɩ ke ri worokokpɛɛnuŋtɛŋtǝyǝ.» <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Wǝ́ pǝ tìi Yesu ǝkǝnǝŋ: «Yǝ lee ci.» Wǝ́ ŋwǝ ŋkpɛ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋmǝ ŋkpɛ ŋ́ nǝŋ tíi nǝ okopiyǝ we ŋ́ nǝ fǝ ŋ́ ya ŋ́ née yee otuyǝ sa wǝ».<verse eid="MAT 21:27" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ ǝpǝrǝŋpipǝ rɛ eyipǝ wǝ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Nǝ nya nyɩŋ tuwǝ sa nǝ nyǝ fǝ nɛ? Kɛrɩyǝ rɛ kǝ lǝǝmǝ ǝpǝrǝŋpipǝ eyi. Wǝ́ ŋ yìili ŋ ke ŋ tíi sǝsǝŋyǝ we ǝkǝnǝŋ: “Mǝ pi, ko e ke yee anǝnɛyǝ rǝ mǝ atɛɛkǝ we ruŋruŋ.” <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Wǝ́ piyǝ we ŋ yìili ǝkǝnǝŋ: “Ŋ́ nǝŋ ko.” Paa kǝmaamaa wǝ́ wǝ yeli na tǝrɛ, wǝ́ ŋ ko ŋ ko atɛɛkǝ we. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Wǝ́ tǝyǝ sa ŋ kolu ŋ tìi piyitǝyǝ we ŋwǝ ŋkpɛ lo tuwǝ we ke. Wǝ́ yǝ ǝnǝ ŋ tɛ̀ɛnɩ ǝkǝnǝŋ: “Yoo, mǝ tǝ, ŋ́ nóo ko.” Paa loo po ko. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Epipǝ sa eyipǝ lǝ ǝlǝ ŋ ne yee nǝ tǝ lǝ kǝǝpǝ́wǝ wǝ?» Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Sǝsǝŋyǝ we.» Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, alaŋpoolɔtǝpǝ sa mǝ otuutuupǝ sa we, pǝ ya pǝ lóo coŋ pǝ koonu nǝ rǝ Worokoyǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Duturǝ ɖi Yowanɛsɩ worokomɛŋwiiritǝyǝ we lǝ pǝ nǝ kpǝŋ ŋ pa kaŋ nǝ gʊŋkʊʊrǝ we, wǝ́ nǝ nyaa lɔ ŋwǝ nǝ nuŋ! Paa alaŋpoolɔtǝpǝ mǝ otuutuupǝ pǝ la lɔ ŋwǝ pǝ lo nuŋ. Wǝ́ ŋnǝ, mǝŋkǝ́ nǝ nya nyɩŋ tuwǝ sa sɩsiɛrɩ paape nǝ nyaa siɛrɩ rǝ nǝ mǝrǝ kǝ nǝ lɔ ŋwǝ nǝ nuŋ!»<verse eid="MAT 21:32" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ apaalǝtǝpǝ rɛ pǝ lɛnyɩ yurǝ wǝ</para>
  <para style="r">(<ref loc="MRK 12:1-12">Marǝko 12:1-12</ref>, <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ tǝ nǝ nuŋ dutupʊŋpwarǝ rɛ re: Tɛɛtɛɛkpɛŋtǝyǝ rɛ kpɛnɩ arɛzɛŋtɛɛkǝ. Wǝ́ ŋ tɔ̀ kɩlɩkpayǝ ŋ kpìi atɛɛkǝ we. Wǝ́ ŋ nyini fɛɛmʊʊrʊrɛzɛŋyǝ. Wǝ́ ŋ tɔ̀ wǝkukpǝ pǝ leh mǝ tíi pǝ ŋ rǝŋ atɛɛkǝ sa wǝ. Wǝ́ ŋ fǝ̀ atɛɛkǝ sa ŋ kpìi apaalǝtǝpǝ rǝ akaakǝ, wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko gʊŋrǝ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Kǝ́ eniŋlɛɛyǝ yǝ lo ro we, wǝ́ ŋ kpìi na asʊmatǝpǝ ŋ manǝ apaalǝtǝpǝ we, kǝ pǝ ka lɔ na nɛŋ rɛzɛŋyǝ pǝ po koonu ŋwǝ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Paa wǝ́ apaalǝtǝpǝ sa pǝ lɔ̀ asʊmatǝpǝ we, wǝ́ pǝ cùlu ceŋceŋ, wǝ́ pǝ wʊlʊ rɛɛyǝ, wǝ́ pǝ tìeni tatǝyǝ lo oruyǝ pǝ wʊlʊ. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Wǝ́ tɛɛlǝtǝyǝ we ŋ tǝ ŋ kpìi na asʊmatǝpʊŋpwapǝ, pǝ ka nàanǝ kpǝŋwǝ pǝ tèeri ǝsǝsǝŋpǝ we. Paape wǝ́ apaalǝtǝpǝ sa pǝ tǝ pǝ yeli mǝ pǝ mǝŋ ǝsǝsǝŋpǝ we kǝtǝ. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Tuturuwǝ we, wǝ́ ŋ kpìi ne piyǝ ŋ manǝ pǝ, mǝ yupurǝ ǝkǝnǝŋ: “Pǝ loh ko suu mǝ pi le enimiyǝ.” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Paa kǝ́ apaalǝtǝpǝ sa pǝ la nyɩŋ piyǝ sa we, wǝ́ pǝ ke ŋ tíi awɛ ǝkǝnǝŋ: “Nyiyǝ sa ŋ nǝh pǝ ŋ pe ri ǝtǝtuyǝ sa wǝ! Nǝ pǝ kǝ la wʊ ŋwǝ, kǝ ǝtǝtuyǝ we yǝ siɛrɩ yǝ yee lah anɛŋ.” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Wǝ́ pǝ lɔ̀ ŋwǝ. Wǝ́ pǝ rù mǝ ŋwǝ rǝ arɛzɛŋtɛɛkǝ we pǝ tìe pǝ cò. Wǝ́ pǝ wʊlʊ ŋwǝ.» <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Wǝ́ Yesu ŋ pǝ̀ ǝkǝnǝŋ: «Rǝkǝsa, vǝ́ tɛɛlǝtǝyǝ sa lǝ pǝ wǝǝ, kǝ́ wǝ́ ŋ neh pe yee mǝ apaalǝtǝpǝ sa?» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Wǝ́ pǝ yìili pǝ ke ŋ tìi ŋwǝ ǝkǝnǝŋ: «Lah pa wʊʊlʊ ŋpǝ oyulɛnyɩtǝpǝ sa, tǝlarǝnyɩŋwǝ rɛ wǝ lee kpii, kǝ ŋ fǝ atɛɛkǝ we ŋ kpii apaalǝtǝpʊŋpwapǝ rǝ akaakǝ. Epǝ we pǝ lǝh mǝ fǝ na nɛŋ rɛzɛŋyǝ pǝ ŋ koonu ŋwǝ rǝ eniyǝ we tutu pǝ láa lɛ ŋwǝ wǝ.»<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ fǝǝ kǝ tuwǝ Wǝŋʊrʊkenikenikpǝ we wǝ la tɛŋ nǝ nyɩŋ?</para>
  <para style="q1" vid="MAT 21:42">“Ɖurǝ we okumarǝtǝpǝ pǝ lǝ sǝ́ŋ pǝ lo co we,</para>
  <para style="q1" vid="MAT 21:42">ŋrǝ le yee yusirurǝ wǝ.</para>
  <para style="q1" vid="MAT 21:42">Ǝtǝ Woroko ŋ ne yee wǝ ǝnǝ.</para>
  <para style="q1" vid="MAT 21:42">Kǝ́ lo tucovurǝ wǝ́ yǝ láa nyɩŋ ǝnǝ!”»<verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Wǝ kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ pǝ lah pa lɔ Worokoyǝ le wǝpilirikpǝ we rǝ nǝ, kǝ pǝ fǝ kpǝ pǝ koonu kǝkpǝŋkǝ we kǝ láa nyɩŋ ǝtǝnǝyǝ wǝ. [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Yǝ we ŋ nóo ru ŋ pa tɔɔ rǝ ɖurǝ sa we, lóo poolu. Wǝ́ mǝŋ ɖurǝ sa lo ru la tɔɔ rɛ we, yǝ we lǝ́ǝ tǝǝ kɩɩkɩ<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuurɛɛkpǝ lǝ mǝrǝ. Yɩrɩ Luka 20:18.</char></note>.»] <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Kǝ́ otoolutǝmumuŋpǝ we mǝ Afarisitǝpǝ we pǝ lo nuŋ Yesu lo otutuyǝ sa we, wǝ́ pǝ cìi wǝ ǝkǝnǝŋ ŋpǝ wǝ́ Yesu ŋ reemǝ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Wǝ́ pǝ ka ŋ taa kʊŋwǝ kǝ pǝ lɔ ŋwǝ, paape pǝ ko ŋ suu kǝkpǝŋkǝ lo vurǝ duturǝ ɖi pǝ ka ŋ nyɩŋ ǝkǝnǝŋ Yesu ri worokokpɛɛnuŋtɛŋtǝyǝ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ dielɔrǝ la wǝcɛkpǝ rɛ</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Wǝ́ Yesu ŋ tǝ ŋ wɛ̀ɛlɩ ŋ tìi kǝkpǝŋkǝ we saŋ rǝ otutucayǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«Yulaarǝ le wǝpilirikpǝ we wǝ lo ru tuwǝ sa ǝnǝ, piliyǝ rɛ càa keeriwǝ mǝ ne pi le dielɔrǝ le jirǝ. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Wǝ́ ŋ kpìi na asʊmatǝpǝ pǝ ko pwo enyipǝ we ŋ pwò pǝ pǝ dielɔrǝ sa wǝ. Paa wǝ́ enyipǝ sa pǝ sǝ́nǝ pǝ lǝǝ pǝ. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Wǝ́ ŋ tǝ ŋ kpìi asʊmatǝpʊŋpwapǝ pǝ ke tíi pǝ ǝkǝnǝŋ: “Ŋ́ na caa mǝ keeriwǝ we ŋ́ na lɛ. Ŋ́ na wʊ mǝ anɛŋnuŋyǝ we mǝ mǝ akɛɛpǝ we pǝ la tɔɔ wǝpɔŋkpǝ. Tu ri ŋ tu wǝ lo to wǝ kpɛlɩ rǝ. Nǝ mǝ pǝ dielɔrǝ sa la fɛɛriwǝ!” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Paape enyipǝ we pǝ lo pwo pǝ loo co oku, wǝ́ yǝ mǝ yǝ ŋ ko ŋ ko na fɛɛwǝ wǝ ponu mǝ ŋwǝ wǝ. Wǝ́ rɛɛyǝ ŋ ko ŋ ko atɛɛkǝ, rɛɛyǝ no otusiiriyǝ. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Wǝ́ arɛɛpǝ pǝ lɔ̀ piliyǝ sa la asʊmatǝpǝ we, wǝ́ pǝ pìeeli pǝ, wǝ́ pǝ wʊlʊ pǝ. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Wǝ́ piliyǝ sa ŋ fǝ̀ kpɛɛmʊrʊwǝ ŋpa, wǝ́ ŋ kpìi no otuusiitǝpǝ pǝ ka wʊʊlʊ enyiwʊʊlʊtǝpǝ sa, kǝ pǝ tu pǝlǝ tǝŋtǝǝwǝ we la naawǝ. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Wǝ́ ŋ tìi na asʊmatǝpǝ we ǝkǝnǝŋ: “Pǝ la caa dielɔrǝ le keeriwǝ we wǝ kpɛlɩ rǝ, paa enyipǝ we ŋ́ no pwo pǝ laa kaamǝ wǝle erikǝ. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Kǝto nǝ mǝ ko mǝ akʊŋyǝ kǝ nǝ ko pwo epǝ we nǝ nyáa nya nǝ nyɩŋ rǝ ko, pǝ pǝ dielɔrǝ sa la fɛɛriwǝ.” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Wǝ́ asʊmatǝpǝ sa pǝ ko ŋ ko mǝ akʊŋyǝ pǝ kolu pǝ pwòlu enyipǝ we kpǝlo kɩɩkɩ pǝ la nya pǝ la nyɩŋ rǝ ko, mǝŋ eceece, mǝŋ arɔɔrɔ. Wǝ koonu kǝto wǝ́ gukpǝ we wǝ lǝ̀ mǝ enyipǝ. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Wǝ́ piliyǝ sa ŋ fìi gukpǝ we ŋ ka yɩrɩ enyipǝ we pǝ lo pwo wǝ. Wǝ́ ŋ nyɩnɩ nyiyǝ rɛ lee kpii wǝkpacɛkpǝ. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: “Mǝ kɛrɩyǝ, wǝ le yee nɛ wǝ́ e le fii fɛɛwǝ sa e lee kpii wǝkpacɛkpǝ wǝ?” Nyiyǝ sa laa nya tuwǝ ŋ nah tɛŋ. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Wǝ́ piliyǝ sa ŋ tìi na asʊmatǝpǝ ǝkǝnǝŋ: “Nǝ parǝ ŋwǝ mǝŋ akparǝ mǝŋ onu, kǝ nǝ tie ŋwǝ nǝ co rǝ koruwǝ rǝ nuŋtumuwǝ we lǝ mǝrǝ. Fɛɛwǝ we wǝ́ ŋ née wee kǝ ŋ wo oroŋciiyǝ wǝ.” <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: “Pǝ lo pwo enyipǝ wa, paape enyipipǝ rɛ ko wǝ́ pǝ la saa pǝ la pɔrʊ.”»<verse eid="MAT 22:14" /></para>
  <para style="s">Pǝ lǝ pǝ́ Yesu le dierǝ pǝ lo ru rǝ laŋpooyǝ la amwarakǝ</para>
  <para style="r">(<ref loc="MRK 12:13-17">Marǝko 12:13-17</ref>, <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Wǝ́ Afarisitǝpǝ we pǝ kolu okukǝ, wǝ́ pǝ tà wǝ pǝ yɩ̀rɩ kǝ́ pǝ láa kɔŋ Yesu la kpɛrɛwǝ pǝ fǝ saŋ rǝ etieyǝ pǝ lǝh pǝ́ ŋwǝ wǝ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Wǝ́ Afarisitǝpǝ sa pǝ kpìi pǝlo otukarǝtǝpǝ rɛ fǝ kʊla mǝ epǝ we pǝ ka kʊla rǝ Erodɛsɩ la wǝcakukpǝ la arɛɛpǝ pǝ manǝ Yesu, pǝ ke tíi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, le cii wǝ ǝkǝnǝŋ a láa tɛŋ anʊkɔrǝyǝ. Wǝ́ Worokoyǝ la akʊŋyǝ wǝ́ a ya láa kaŋ mǝ anʊkɔrǝyǝ. Wǝ́ a lǝŋ maa rɛ ŋ cɩɩlɩ lǝ́, wǝ́ a lǝŋ lɛ a yɩrɩ rǝ nyiyǝ lǝ wǝ ŋ ri wǝ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tíi lǝ kǝ́ a la nyɩŋ tuwǝ sa ǝ lǝ fǝ wǝ: Gʊŋrǝ gbɛlɩ kǝ la mwara laŋpooyǝ lo koonu Kayizaro amaa gʊŋrǝ laa kpɛɛ?» <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Paa Yesu ke cii pǝlo oyupurɔɔrɔɔyǝ we pǝ ke re wǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Alakpatǝpǝ wǝ́ nǝ ri! Kǝ́ kǝto wǝ́ nǝ ya nǝ nyáa kɔŋ mǝ kpɛrɛwǝ wǝ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Nǝ kaŋ mǝ sɩkayǝ we pǝ lǝ́ǝ fǝ pǝ ŋ mwara laŋpooyǝ wǝ!» Wǝ́ pǝ fǝ̀ sɩkakpotokpotoyǝ we ceŋceŋ pǝ pǝlǝ pǝ kòonu ŋwǝ. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Wǝ́ Yesu ŋ yìili ŋ kǝ ŋ pǝ́ pǝ ǝkǝnǝŋ: «Ǝlǝ la anyɩŋkǝ mǝ nyɩŋrǝ yǝ tɛɛ rǝ sɩkayǝ sa ǝnǝ?» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kayizaro ŋ lǝǝwe». Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «We nǝ fǝ otuyǝ we yǝ ri Kayizaro la anɛŋyǝ nǝ koonu Kayizaro, kǝ nǝ fǝ Worokoyǝ lo otuyǝ nǝ koonu Worokoyǝ.» <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Kǝ́ pǝ lo nuŋ dierǝ sa we, wǝ́ pǝ fǝ̀ pǝ kpǝ̀ pǝ yàa pǝ ka ŋ yɩrɩ ŋwǝ rǝ. Wǝ́ pǝ màa ŋwǝ, wǝ́ pǝ pwɛ̀yɩ pǝ ko ŋ ko.<verse eid="MAT 22:22" /></para>
  <para style="s">Pǝ lǝ pǝ́ Yesu le dierǝ pǝ lo ru rǝ enyiǝtǝpǝ la asaanǝkǝ</para>
  <para style="r">(<ref loc="MRK 12:18-27">Marǝko 12:18-27</ref>, <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ŋrǝ jirǝ we ke wǝ́ Asadukitǝpǝ rɛ pǝ pǝlǝ Yesu lǝ kpǝŋ. Ŋpǝ pǝ láa tɛŋ ǝkǝnǝŋ enyiǝtǝpǝ pǝ lǝŋ pa saanǝ wǝ. Wǝ́ pǝ pǝ̀ Yesu le dierǝ sa ǝkǝnǝŋ: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«Tukaŋtǝyǝ, Mose tɛnɩ ǝkǝnǝŋ: “Mǝŋ nyiyǝ rɛ la lɔ tieyǝ, wǝ́ pǝ lǝǝ mǝ, wǝ́ pǝrǝŋyǝ we ŋ nǝ kpǝ́ ŋ na maa tieyǝ we, nyiyǝ we ŋ nǝ kpǝ́ la paanʊ lǝ́ǝ fǝ kpeetieyǝ we ŋ lɔ, kǝ ŋ tǝnǝ yuwǝ ŋ koonu yǝ we ŋ nǝ kpǝ́ wǝ”. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Rǝkǝsa apaanʊpǝ rɛ apǝrɩmata pǝ ke kpii rǝ lǝh mǝrǝ. Wǝ́ mumuŋyǝ we ŋ lɔ̀ tieyǝ. Pǝ lǝǝ mǝ, wǝ́ pǝrǝŋyǝ we ŋ kpǝ̀. Wǝ́ ŋ màa kpeetieyǝ we ŋ tǝ̀nǝ na paanʊyǝ we ŋ ka tɛɛmǝ ŋwǝ wǝ. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Wǝ́ tuwǝ sa wǝ tǝ wǝ pǝlǝ wǝ tùu paanʊyitǝyǝ we. Tatǝyǝ we ŋwǝ ŋkpɛ mǝŋ kaa wǝ, wǝ́ wǝ pǝlǝ wǝ tùu pǝla apǝrɩmata ko to rǝ! <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Kǝ́ pǝlo kpǝlo kɩɩkɩ pǝ lǝ kpǝ́ we, wǝla kǝmaakǝ wǝ́ tieyǝ we ŋwǝ ŋkpɛ ŋ kpǝ̀. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Kǝ́ wǝ ri pǝla apǝrɩmata pǝ la lɔ tieyǝ sa wǝǝ, vǝ́ enyiǝtǝpǝ pǝ la pa saanǝ wǝǝ, tieyǝ sa leh pe ri pǝlǝ ǝlǝ le tieyǝ?» <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ya nǝ nyǝ́ǝ tǝǝnǝ nǝ wɛ, kpiikǝ nǝ nyee ci mǝŋ Wǝŋʊrʊkenikenikpǝ we, mǝŋ Worokoyǝ lo okopiyǝ kǝto. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Duturǝ ɖi vǝ́ enyiǝtǝpǝ pǝ la pa saanǝ we, pǝ lǝŋ tǝ pǝ pa lɔ tieyǝ amaa pǝ lǝŋ tǝ pǝ pa caa wǝnuŋkpǝ. Paa pǝ lǝ́ǝ lǝ mǝŋ epicoŋpipǝ rǝ yulaarǝ kǝtǝ. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ko rǝ enyiǝtǝpǝ la asaanǝkǝ wǝǝ, nǝ nyǝǝ kǝ tuwǝ Worokoyǝ ŋ na tɛŋ ŋ ne tíi nǝ nǝ nyɩŋ? La tɛŋ ǝkǝnǝŋ: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />“Ŋmǝ ŋ́ ri Abǝrahamǝ lo Worokoyǝ, Isakǝ lo Worokoyǝ mǝ Yakɔbǝ lo Worokoyǝ.” Worokoyǝ lee ri enyiǝtǝpǝ lo Worokoyǝ, paa ri epǝ we pǝ kpii vɔrʊrǝ lo Worokoyǝ.» <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Kǝ́ nyikpǝŋwǝ we wǝ lo nuŋ Yesu le etieyǝ sa we, wǝ́ no otukaŋyǝ we yǝ rili pǝ lo mumuŋ.<verse eid="MAT 22:33" /></para>
  <para style="s">Esepǝ kpǝlo lǝ sǝsǝŋyǝ</para>
  <para style="r">(<ref loc="MRK 12:28-34">Marǝko 12:28-34</ref>, <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kǝ́ Afarisitǝpǝ pǝ lo nuŋ ǝkǝnǝŋ Yesu le sii Asadukitǝpǝ lo nyuŋkpǝ we, wǝ́ pǝ kolu pǝ kù. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Wǝ́ ceŋceŋ rǝ pǝlǝ mǝrǝ, sekaŋtǝyǝ ŋ kǝ lǝǝwe, ŋ pǝ̀ ŋ kɔŋ Yesu la kpɛrɛwǝ. Wǝ́ ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«Tukaŋtǝyǝ, rǝ esepǝ kpǝlo kɩɩkɩ lǝ mǝrǝ wǝǝ, seyǝ rǝ fǝŋ ŋ ri sǝsǝŋyǝ wǝ?» <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «A lah mǝ taa Ǝtǝ Woroko, ló Worokoyǝ lǝ kǝǝwǝ mǝ lá ziɔŋrǝ kpǝlo, ló kǝrukǝ kpǝlo, mǝ ló otuciyǝ kpǝlo. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Yǝ ǝnǝ ŋ ri semumuŋyǝ mǝ sesǝsǝŋyǝ wǝ. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />A lǝŋ nyɩŋ seyitǝyǝ ŋwǝ ŋkpɛ ŋ no ru sǝsǝŋyǝ sa ŋ kaamǝ yǝ ǝnǝ: “Taa lá kɛrɩyǝ lǝ kǝǝwǝ mǝŋ ŋlǝ́ŋlǝ́ lá wɛ kǝtǝ.” <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Mose le seyǝ we kpǝlo kɩɩkɩ mǝŋ oworokokpɛɛnuŋtɛŋtǝpǝ lo otukaŋyǝ kpǝlo kɩɩkɩ yǝ kpii rǝ esepǝ sa eyipǝ lǝ mǝrǝ.»<verse eid="MAT 22:40" /></para>
  <para style="s">Mesiyayǝ we mǝ Davidǝ</para>
  <para style="r">(<ref loc="MRK 12:35-37">Marǝko 12:35-37</ref>, <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Rǝkǝsa kǝ́ Afarisitǝpǝ we pǝ lo ko ku pǝ tini we, wǝ́ Yesu ŋ pǝ̀ pǝ le dierǝ sa ǝkǝnǝŋ: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Kǝ́ lo yu wǝ́ nǝ ya nǝ nyóo pu nǝ nyǝ ŋ ru rǝ Mesiyayǝ we lo oŋuŋkǝ? Ǝlǝ le pilepiyǝ wǝ́ ŋ ri?» Wǝ́ pǝ yìili pǝ tìi ŋwǝ ǝkǝnǝŋ: «Davidǝ le pilepiyǝ ŋ lǝǝwe.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Wǝ́ Yesu ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Wǝ yeli nɛ ǝkǝ saŋ rǝ Wɛɛkenikenirǝ wǝ́ Davidǝ ŋ pwò ŋwǝ ǝkǝnǝŋ “Kulǝtǝyǝ” wǝ? Duturǝ ɖi Davidǝ la tɛŋ ǝkǝnǝŋ:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“Ǝtǝ Woroko le tíi mǝ Kulǝtǝyǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 22:44">Pe tii rǝ mǝ kǝnirisiɛɛkǝ</para>
  <para style="q1" vid="MAT 22:44">Ko ro eniyǝ we ŋ́ nǝ fǝ lǝ́ ǝkǝǝkpǝlǝtǝpǝ ŋ́ kpii lǝ́ rǝ lá akparǝyǝ lǝ kǝnǝŋkǝ.”<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Wǝ́ mǝŋ Davidǝ lo pwo ŋwǝ ǝkǝnǝŋ: Kulǝtǝyǝ wǝǝ, wǝ lée yee nɛ kǝ ŋ pe ri Davidǝ le pilepiyǝ wǝ?» <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Rɛ ri ŋ rɛ loo koru anya kpǝkpǝlǝŋwǝ ŋ koonu ŋwǝ. Wǝ́ fǝ ǝrǝ jirǝ we rɛ lǝǝ tǝ ŋ po tu turuwǝ ŋ pǝ́ ne dierǝ rɛ.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu le ci la kaŋ enyipǝ lo ru rǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ lo oŋuŋkǝ</para>
  <para style="r">(<ref loc="MRK 12:38-39">Marǝko 12:38-39</ref>, <ref loc="LUK 11:43">Luka 11:43</ref>,<ref loc="LUK 11:46">46</ref>, <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Rǝ wǝla kǝmaakǝ wǝ́ Yesu ŋ ka ŋ wɛɛlɩ mǝ ŋ tíi nyikpǝŋwǝ we kpǝlo kɩɩkɩ fǝ kʊla mǝ no otukarǝtǝpǝ we ǝkǝnǝŋ: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«Esekaŋtǝpǝ mǝ Afarisitǝpǝ pǝ lǝǝmǝ okopiyǝ pǝ láa pɔrʊ Mose le esepǝ we lo duturǝ wǝ. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Kǝto wǝ kpii kǝ nǝ co kǝtukoŋkǝ rǝ pǝ, kǝ nǝ yee tu ri ŋ tu pǝ le tíi nǝ wǝ. Paa nǝ paa karǝ pǝlo otuyeeyǝ! Duturǝ ɖi otuyǝ we pǝ láa kaŋ we, ŋpǝŋpǝ pǝ lǝŋ yee pǝ saŋ rǝ yǝ. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Pǝ láa parǝ eleeyǝ yǝ lǝǝmǝ nuruwǝ piŋpiŋ, yǝ lɛnyɩ ereekǝ, pǝ ŋ tɛɛ enyipǝ rǝ yurǝ pǝ re! Paa ŋpǝŋpǝ pǝ lǝ sǝ́ŋ pǝ lǝŋ ruu yǝ mǝ gaapirǝ jeŋceŋ ǝkǝŋtǝ pǝ yɩrɩ! <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Tu ri ŋ tu pǝ lée yee we, pǝ lée yee wǝ kǝ enyipǝ pǝ rɔsɩ pǝ nyɩŋ pǝ rǝ ko. Vɔpirǝ we pǝ lée kpii Worokoyǝ le eserɛɛpǝ pǝ ŋ toŋ rǝ kǝtukǝ amaa rǝ nutarǝ we, enyipǝ sa ŋpǝ paa pǝla nɛŋrǝ yɔkɔ deeri nyi ri ŋ nyi la nɛŋrǝ. Pǝla wǝkpakpurumukpǝ la alaayǝ yǝ konu yǝ teeri nyi ri ŋ nyi la anɛŋyǝ! <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Pǝ láa taa pǝ ŋ tii rǝ omumuŋpǝ la afɛɛtiiyǝ rǝ okumwɛŋnyuŋyǝ mǝ afɛɛtiiriyǝ. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Pǝ láa taa enyipǝ pǝ ŋ ceeni pǝ rǝ acanɩtiyǝ. Wǝ́ pǝ láa taa enyipǝ pǝ ŋ pwo pǝ ǝkǝnǝŋ Tukaŋtǝyǝ. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ŋnǝ paa we, nǝ paa maa enyipǝ pǝ ŋ pwo nǝ Tukaŋtǝyǝ, duturǝ ɖi tukaŋtǝyǝ ceŋceŋ ko wǝ́ nǝ lǝǝmǝ, wǝ́ nǝ kpǝlo kɩɩkɩ we, apaanʊpǝ wǝ́ nǝ ri. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Nǝ poo pwo rɛ rǝ kǝtǝǝwǝ nǝ “Tǝ”, duturǝ ɖi Tǝyǝ ceŋceŋ ko wǝ́ nǝ lǝǝmǝ, yǝ we ŋ kpii rǝ yulaarǝ wǝ. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Nǝ paa lɛ nǝ kuŋ enyipǝ pǝ ŋ pwo nǝ “Coŋtǝyǝ”, duturǝ ɖi coŋtǝyǝ ceŋceŋ ko wǝ́ nǝ lǝǝmǝ, ŋwǝ ŋ kaamǝ Mesiyayǝ we. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Yǝ we ŋ ri mumuŋyǝ rǝ nǝ mǝrǝ we, wǝ kpii kǝ ŋ ri nǝ sʊmatǝyǝ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Yǝ we ŋ náa rɛɛrɩ mǝ na wɛ we, Worokoyǝ láa sʊʊrʊ mǝ ŋwǝ. Wǝ́ yǝ we ŋ náa pɛɛlɩ na wɛ we, Worokoyǝ láa rɛɛrɩ mǝ ŋwǝ. <figure style="fig" alt="Phylactère" file="hk00274c.tif" size="col" copy="Horace Knowles" ref="23:5">Vɔpirǝ we pǝ lée kpii Worokoyǝ le eserɛɛpǝ pǝ ŋ toŋ rǝ kǝtukǝ amaa nutarǝ wǝ</figure><verse eid="MAT 23:12" /></para>
  <para style="s">Yesu la saarǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ la alakpayǝ pǝ le yee wǝ</para>
  <para style="r">(<ref loc="MRK 12:40">Marǝko 12:40</ref>, <ref loc="LUK 11:39-52">Luka 11:39-52</ref>, <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ ya nǝ nyáa taŋ yulaarǝ le wǝpilirikpǝ we la ŋwaarǝ rǝ enyipǝ la kǝnyɩŋkǝ. Ŋnǝŋnǝ nǝ nyǝŋ fii, wǝ́ nǝ nyǝŋ maa epǝ we pǝ ya pǝ lǝ́ǝ pǝ́ pǝ fii we, pǝ fii.</para>
  <para style="p" vid="MAT 23:13">[<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ nyée sisi ekpeetiepǝ nyǝ ŋ lɔ pǝlo otuyǝ kɩɩkɩ. Nǝ kah ya nǝ mǝ mwɛŋ nyuŋkpǝ, o lóo ko ǝrǝ fǝŋ, kǝ ǝ pǝ, nǝ faa lɛ, kǝ enyipǝ pǝ nya fɛɛ pǝ ŋ nyɩŋ nǝ. Kǝto nǝ tukoŋtawǝ wǝ lah pa lɛnyɩ wǝ teeri.]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Fɛɛwǝ sa wǝ lee kpii rǝ wǝŋʊrʊkuukuukpǝ wa mǝrǝ. Yɩrɩ Marǝko 12:40.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ siri nǝ nyáa tɛlɩ rǝ apʊyǝ mǝ kǝtǝǝwǝ kǝ nǝ siɛrɩ nyiyǝ mǝ ŋ sʊma Worokoyǝ mǝŋ kǝ́ nǝ nyée yee wǝ kǝtǝ! Wǝ́ vǝ́ nǝ nya nya ŋwǝ nǝ nya siɛrɩ we, oturu nǝ nye ci ǝfǝ ŋwǝ nǝ yee naalaalɛwǝ le nyiyǝ nǝ teeri nǝ wɛ kǝyi!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ eretǝpǝ sa nǝ nyǝ tǝrǝ wǝ, ŋnǝ nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ: “Mǝŋ rɛ lo tu Worokoyǝ la nyarǝwǝ ǝkǝnǝŋ ŋ née yee tuwǝ rɛ, wǝ́ ŋ nee yee wǝ we, wǝ lǝŋ yee tǝrɛ. Paa mǝŋ rɛ lo tu sɩkamwɛɛrɩyǝ we ŋ kpɛlɩ rǝ Worokoyǝ la nyarǝwǝ we, wǝ kpii kǝ yǝ we ŋ yee ŋ saŋ rǝ tuwǝ we ŋ no tu ŋ na tɛŋ taa.” <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Otuleecitǝpǝ mǝ alaanyɩŋtǝpǝ wǝ́ nǝ ri! Tuwǝ rǝ fǝŋ wǝ la lɔ okuruyǝ wǝ le teeri wǝ? Sɩkamwɛɛrɩyǝ we amaa Worokoyǝ la nyarǝwǝ we wǝ lo kuŋ sɩkayǝ sa ŋ ne yee tukenikeniwǝ wǝ? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Nǝ nyǝ́ǝ tǝ nǝ ŋ tɛŋ ǝkǝnǝŋ: “Mǝŋ rɛ lo tu otoolucuukǝ ǝkǝnǝŋ ŋ née yee tuwǝ rɛ, wǝ́ ŋ nee yee wǝ we, wǝ lǝŋ yee tǝrɛ. Paa mǝŋ rɛ lo tu toolutuwǝ we wǝ tɛɛ rǝ otoolucuukǝ we, wǝ kpii kǝ yǝ we ŋ yee ŋ saŋ rǝ tuwǝ we ŋ no tu ŋ na tɛŋ taa.” <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Alaanyɩŋtǝpǝ sa! Tuwǝ rǝ fǝŋ wǝ la lɔ okuruyǝ wǝ le teeri wǝ? Toolutuwǝ we amaa otoolucuukǝ we kǝ lo kuŋ toolutuwǝ sa wǝ le yee tukenikeniwǝ wǝ? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Kǝto mǝŋ rɛ lo tu otoolucuukǝ we, yǝ we lo tu otoolucuukǝ we mǝŋ otoolutuyǝ we kpǝlo kɩɩkɩ yǝ tɛɛ rǝ otoolucuukǝ sa wǝ. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Yǝ we ŋ no tu Worokoyǝ la nyarǝwǝ we, lo tu Worokoyǝ la nyarǝwǝ mǝŋ Worokoyǝ we ŋ kpii rǝ wǝ wǝ. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Yǝ we ŋ no tu yulaarǝ we, lo tu Worokoyǝ le bilisaarǝ mǝŋ Worokoyǝ we ŋ tini rǝ rǝ wǝ.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ nyóo koonu Worokoyǝ lo tutǝtǝwǝ ko ru mǝŋ ayɩlɩtuyǝ mǝ eweyǝ we pǝ lée ri wǝ. Paa otuyǝ we yǝ lǝ kpuŋkpuruŋ rǝ seyǝ we mǝrǝ mǝŋ: tuyeewǝ rǝ wǝkʊʊkpǝ, tǝlarǝnyɩŋwǝ, mǝ anʊkɔrǝyǝ we, nǝ nya maa yǝ nǝ nyo co. Ŋyǝ otuyǝ sa wǝ́ wǝ kaamǝ kǝ nǝ yee kpɛŋ. Paa kǝ nǝ poo yuu otuturuyǝ we la kpɛɛ. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Eretǝpǝ sa pǝ lǝ tǝrǝ wǝ! Nǝ nyóo tuu ǝfǝŋpǝ nǝ pɔrʊ osusupipǝ, paa nǝ nyǝ ŋ pɔ kpɔŋkɔyǝ milimili!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ nyáa wɛɛ nǝ akɔpʊyǝ mǝ nǝ wǝsiɛkpǝ la kǝmaakǝ sɩsiɛrɩ. Paa yǝlǝ mǝrǝ lǝ lǝ mǝ nǝ ayɩlayɩtǝtuyǝ mǝ nǝ otucakpɛɛrɔɔrɔɔyǝ we pwɩ. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ŋlǝ́ Farisitǝnyiyǝ sa nǝŋtǝrǝtǝyǝ sa! Wɛɛ lá kɔpʊwǝ lǝ mǝrǝ kpɛŋ, mǝŋkǝsa we, wǝla kǝmaakǝ ŋke kǝ láa lɛrɩ.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ lǝ rǝ mǝŋ ofuŋtɔŋyǝ pǝ lo nuŋ sereyǝ pǝ lo toolu kǝtǝ. Rǝ dǝǝtǝǝrǝ we, yǝ lóo poŋ ayɩrɩ, paa yǝlǝ mǝrǝ we, yǝ lǝ lǝ mǝ enyiǝtǝkopiyǝ mǝ otufwetuyǝ sɔŋ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Kǝ́ ŋnǝ ŋkpɛ nǝ lǝ wǝǝ. Rǝ dǝǝtǝǝrǝ sa we, pǝ láa nyɩŋ nǝ mǝŋ enyikʊʊpǝ rɛ! Paa rǝ mǝrǝ we, nǝ nyǝ lǝ pwɩ mǝ alakpayǝ mǝ turɔɔrɔɔwǝ le eyeekǝ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Nǝ paapɔ mǝ nǝ aria, ŋnǝ esekaŋtǝpǝ mǝ Afarisitǝpǝ, alakpatǝpǝ sa! Nǝ ya nǝ nyáa tɔ oworokokpɛɛnuŋtɛŋtǝpǝ lo ofuŋtɔŋyǝ. Wǝ́ nǝ nyáa cɛ mǝ enyikʊʊpǝ lo ofuŋtɔŋyǝ. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Wǝ́ nǝ ya nǝ nyáa tɛŋ ǝkǝnǝŋ: “Mǝŋ le ke kpii mǝ lǝh ǝtǝpǝ le diirǝ we, yǝ laa ka kʊla mǝ pǝ, la wʊʊlʊ oworokokpɛɛnuŋtɛŋtǝpǝ.” <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Mǝŋkǝsa we, ŋnǝŋnǝ nǝ ya nǝ nyée ri wǝla ɖaŋsieyǝ ǝkǝnǝŋ ŋnǝ nǝ ri epilepipǝ nǝ koonu epǝ we pǝ la wʊʊlʊ oworokokpɛɛnuŋtɛŋtǝpǝ wǝ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Wǝ ponu, tuwǝ we nǝ ǝtǝtǝpǝ pǝ tie eyeekǝ we, nǝ re wǝ nǝ mǝ ko, kǝ nǝ ka lɛ wǝ rǝ! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Wǝpɔɔkpǝ rɛ, mǝ amatakpapǝ rɛ pǝ kpii pǝ láa tɛlɩ! Nǝ nyo pu wǝ ǝkǝnǝŋ ŋnǝ nǝ nyóo koru acɛ Worokoyǝ la wǝkpaŋtɛŋkpǝ sa, kǝ nǝ cɛ naalaalɛwǝ we lo tukoŋtawǝ sa? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Wǝ kǝto ŋ́ née kpii oworokokpɛɛnuŋtɛŋtǝpǝ, otucitǝpǝ mǝ esekaŋtǝpǝ ŋ́ maŋ nǝ. Nǝ nyah pa wʊʊlʊ arɛɛpǝ kǝ nǝ kpaa arɛɛpǝ nǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ, kǝ nǝ culu arɛɛpǝ mǝ fwɛɛpǝlawǝ rǝ nǝ okumwɛŋnyuŋyǝ. Nǝ nyée yi nǝ tɛɛ rǝ arɛɛpǝ kǝ nǝ mǝ piri pǝ rǝ tǝŋtǝǝ ri ŋ tǝŋtǝǝ pǝ lo ko wǝ. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Mǝŋkǝsa we, enyikʊʊpǝ we kpǝlo kɩɩkɩ la ŋpǝrayǝ we ŋ na lʊ rǝ kǝtǝǝwǝ we, ŋnǝ nǝ nyáa lɔ wǝlo tukoŋtawǝ wǝ. Fǝ ǝrǝ Abɛlǝ nyikʊʊyǝ we la awʊkǝ po ru Baraki le pi Zakari, yǝ we nǝ wʊlʊ rǝ Worokoyǝ la nyarǝwǝ rǝ fɛɛkenikeniwǝ mǝ otoolucuukǝ we le kǝtiitiikǝ.<note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 4:8">1Mo 4:8</ref></char>. </char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, otuyǝ sa kpǝlo kɩɩkɩ lo tukoŋtawǝ wǝ lǝ́ǝ pǝ wǝ tu rǝkǝsa le enyipǝ.<verse eid="MAT 23:36" /></para>
  <para style="s">Yesu lǝ kǝǝnǝ lo kuŋ Yerusalɛmǝ lǝ tǝŋtǝǝwǝ</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luka 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Ao, ŋnǝ Eyerusalɛmǝtǝpǝ, ŋnǝ epǝ we nǝ nyáa wʊʊlʊ oworokokpɛɛnuŋtɛŋtǝpǝ, wǝ́ nǝ nyée tieni Worokoyǝ le enyipǝ we ŋ ne kpii ŋ na maŋ nǝ lo oruyǝ nǝ nyǝ ŋ wʊʊlʊ wǝ. Ŋ́ nǝ pǝ́ eni ri ŋ ni ŋ́ kparǝ nǝ ŋ́ maarǝ mǝ mǝ wɛ mǝŋ kǝ́ kʊkɔyǝ ŋ náa kparǝ ne epipǝ mǝ ŋ kpii rǝ na wǝkʊŋkpǝ kǝtǝ. Paape nǝ nyaa tɛɛnɩ wǝ! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Rǝkǝsa we, Worokoyǝ láa maa nǝ nyarǝwǝ ŋ tǝnǝ nǝ, kǝ wǝ yee gutoorǝ wǝ yaa! <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, nǝ nyǝŋ tǝ nǝ pa nyɩŋ mǝ, ko ro jirǝ we nǝ nyáa tɛŋ ǝkǝnǝŋ: “Worokoyǝ ŋ pɛɛrɩ yǝ we ŋ no furu rǝ Ǝtǝ Woroko la nyɩŋrǝ wǝ.”»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu la tɛŋ Worokoyǝ la nyarǝwǝ la awɔɔkǝ</para>
  <para style="r">(<ref loc="MRK 13:1-2">Marǝko 13:1-2</ref>, <ref loc="LUK 21:5-6">Luka 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Wǝ́ Yesu ŋ rù rǝ Worokoyǝ la nyarǝwǝ ŋ ko ŋ ko. Kǝ́ ŋ kpii ŋ nóo ko we, wǝ́ no otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ kǝ pǝ kaŋ ŋwǝ kǝ́ pǝ la tɔ Worokoyǝ la nyarǝwǝ we pǝ lǝ fǝ wǝ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ nya nyɩŋ otuyǝ sa kpǝlo kɩɩkɩ? Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ɖurǝ rɛ mǝŋ jeŋceŋ lǝŋ po tuuru dɛɛ rǝ ɖupʊŋpwarǝ rɛ rǝ fɛɛwǝ sa. Pǝ lée re yǝ pǝ co kpǝlo kɩɩkɩ.»<verse eid="MAT 24:2" /></para>
  <para style="s">Otuyǝ we yǝ lǝh pǝ yǝ coŋ yǝ koonu ǝrǝkǝ la alɛɛkǝ wǝ</para>
  <para style="r">(<ref loc="MRK 13:1-2">Marǝko 13:1-2</ref>, <ref loc="LUK 21:5-6">Luka 21:5-6</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Kǝ́ Yesu ŋ ne ke tii rǝ oliviepǝ lo dutupirǝ we we, wǝ́ no otukarǝtǝpǝ we pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ rǝ kǝlɛɛrɩkǝ. Wǝ́ pǝ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Tíi lǝ, eniyǝ rǝ fǝŋ wǝ́ otuyǝ sa yǝ lǝh pǝ wǝ? Kǝ́ wǝ́ yǝ lǝ́ǝ fǝ la nyɩŋ le ci ǝkǝnǝŋ lǝ́ ǝpǝkǝ mǝ ǝrǝkǝ la alɛɛkǝ le eniyǝ yǝ lǝ kǝlǝ wǝ?» <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Wǝ́ Yesu ŋ yìili ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ yee yurǝ, rɛ ŋ pǝǝ tǝǝnǝ nǝ! <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Duturǝ ɖi enyipǝ wa pǝ loh po ru, kǝ pǝ fǝ mǝ nyɩŋrǝ pǝ kpii pǝla wɛ. Kǝ yǝ mǝ yǝ mǝ ŋ tɛŋ ǝkǝnǝŋ: “Ŋmǝ ŋ́ ri Mesiyayǝ we”, kǝ pǝ tǝǝnǝ enyipǝ wa. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Nǝ nyoh po nuŋ akɔŋkǝ kǝ ya kǝ lǝ́ǝ pǝ, amaa pǝ ya pǝ láa wɛɛlɩ pǝ ŋ ru rǝ akɔŋkǝ rɛ kǝ lǝh pǝ pǝ wǝ. Paape turuwǝ wǝ paa nyaa nǝ mɛŋwǝ. Wǝ kpii kǝ tuwǝ sa wǝ pǝ ǝnǝ, paa wǝ lǝŋ maa wǝ ri ǝrǝkǝ sa la alɛɛkǝ. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Ǝkǝŋyǝ yǝ leh pe yi yǝ tɛɛ rǝ awɛ. Epilipǝ pǝ leh pe yi pǝ tɛɛ rǝ awɛ. Kǝtɛŋkǝ kǝ loh po ru rǝ afɛɛ mǝ afɛɛyǝ, kǝtǝǝwǝ wǝ leh mǝ tikili rǝ afɛɛ mǝ afɛɛyǝ. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Otuyǝ sa kpǝlo kɩɩkɩ yǝ lǝ rǝ mǝŋ kǝ́ kuluretǝyǝ ŋ ne tie oroonukǝ lo vuurǝ kǝtǝ. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Rǝ eniyǝ we mǝrǝ we, pǝ lǝ́ǝ fǝ nǝ pǝ kpii enyipǝ rǝ akaakǝ pǝ pieeli nǝ kǝ pǝ wʊ nǝ. Enyipǝ rǝ ǝkǝŋyǝ kpǝlo kɩɩkɩ pǝ lǝ́ǝ kpǝlǝ nǝ kǝǝwǝ rǝ mǝ yurǝ. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Rǝ eniyǝ we mǝrǝ we, enyipǝ wa pǝ láa nyarǝ lɔnuŋrǝ pǝ co. Pǝ leh mǝ siiri awɛ, kǝ pǝ ŋ kpǝlǝ awɛ lǝ kǝǝwǝ. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Anianiatǝkpɛɛnuŋtɛŋtǝpǝ wa pǝ loh po ru, kǝ pǝ tǝǝnǝ enyipǝ wa. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Turɔɔrɔɔwǝ wǝ lah pa naanǝ ŋpa eniyǝ we enyipǝ wa lǝ kǝǝtaawǝ wǝ la pɔrʊ wǝ lǝ sǝǝlǝ. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Paa yǝ we ŋ náa tɔ ŋ yaa ǝrǝ alɛɛkǝ we, yǝ we láa nya alɔkuŋkǝ. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Pǝ láa tɛŋ yulaarǝ le wǝpilirikpǝ sa le Dieceeceerǝ pǝ tɛlɩ rǝ ǝrǝkǝ kpǝlo kɩɩkɩ, kǝ wǝ ri ɖaŋsieyǝ wǝ koonu wǝkpǝŋkpǝ kpǝlo kɩɩkɩ kpɛŋ! Eniyǝ we alɛɛkǝ kǝ leh ci ǝpǝ wǝǝ.»<verse eid="MAT 24:14" /></para>
  <para style="s">Acʊcʊʊrʊmumuŋyǝ le eniyǝ</para>
  <para style="r">(<ref loc="MRK 13:14-23">Marǝko 13:14-23</ref>, <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«Vǝ́ nǝ nyah pa nyɩŋ tuwǝ we wǝ laa laka eyeekǝ, wǝ láa wɔɔ fɛɛwǝ kɩɩkɩ wǝ la pa lɔ kǝtiikǝ rǝ Worokoyǝ la nyarǝwǝ mǝŋ kǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Daniɛlɩ ŋ tɛnɩ wǝ kǝtǝ we, (yǝ we ŋ ya ŋ nǝ́ǝ kǝ otuyǝ sa ŋ nuŋ yǝlo duturǝ!) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />eniyǝ we lǝ mǝrǝ we, epǝ we pǝ kpii rǝ Yudeya pǝ suu pǝ ŋ ko otutupiyǝ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Yǝ we ŋ tɛɛ rǝ akpanyaŋkǝ we, ŋ paa sʊʊ ŋ fii gukpǝ ŋ kǝ fǝ tǝrɛ. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Yǝ we ŋ kpii rǝ atɛɛkǝ we, ŋ paa siɛnɩ ŋ pǝ nyarǝwǝ ŋ pǝ fǝ na kǝkpakǝ. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Okuluretǝpǝ mǝ epǝ we pǝ re epipǝ pǝ láa mɛɛnɩ rǝ ŋyǝ eciyǝ we mǝrǝ we, pǝla paapɔ mǝ pǝla aria! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Nǝ mǝ mwɛŋ nyuŋkpǝ kǝ nǝ poo po suu nǝ pwɛyɩ mǝ asiɛniyǝ amaa sabatǝyǝ le jirǝ! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Duturǝ ɖi, rǝ ŋyǝ eniyǝ we mǝrǝ we, enyipǝ pǝ láa cʊʊrʊ ŋpa wǝlǝ kǝtǝŋkǝ wǝ lee kpii ru ǝrǝ ǝrǝkǝ le kǝtiekǝ po ro ruŋruŋ. Wǝ́ wǝlǝ kǝtǝŋkǝ wǝ lǝŋ lɛ wǝ pe kpii kʊrakʊra. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Mǝŋ ŋkǝ kǝ́ Worokoyǝ ŋ nǝ sǝ eciyǝ we ŋ nǝ sǝǝlǝ rǝ we, rɛ ri ŋ rɛ lǝŋ ko tuuru ŋ tii vɔrʊrǝ. Paa rǝ epǝ we ŋ na saa ŋ nǝ tǝnǝ kǝto we, wǝ́ ŋ nǝ sǝ eciyǝ we ŋ nǝ sǝǝlǝ. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Kǝto mǝŋ rɛ le pe tíi nǝ ǝkǝnǝŋ: “Nǝ yɩrɩ re, Mesiyayǝ we kpii rǝ ɖǝǝnǝ!” amaa “Kpii rǝ ɖeeni!” we, nǝ paa lɔ yǝ we nǝ nuŋ. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Duturǝ ɖi anianiatǝmesiyapǝ mǝ anianiatǝkpɛɛnuŋtɛŋtǝpǝ pǝ loh po ru. Pǝ leh mǝ yee otulaanyɩŋtǝnǝyǝ mǝ otucovurǝ pǝ fǝ pǝ tǝǝnǝ enyipǝ. Mǝŋ pǝ koh mǝ koru kʊraa kǝ pǝ tǝǝnǝ mǝŋ epǝ we Worokoyǝ ŋ na saa ŋ nǝ tǝnǝ wǝ. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Nǝ nuŋ! Ŋ́ ne tíi nǝ wǝ ŋ́ no coonu. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Kǝto mǝŋ pǝ le tíi nǝ ǝkǝnǝŋ: “Nǝ yɩrɩ re, ŋwǝ ŋ yaa rǝ nyɔŋkpaakǝtǝǝwǝ ǝnǝ” we, nǝ poo ko. Amaa mǝŋ pǝ le tíi nǝ ǝkǝnǝŋ: “Nǝ yɩrɩ re, la ŋwaa kpii rǝ sa” we, nǝ paa lɔ nǝ nuŋ. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Duturǝ ɖi Nyɩmaasɩ le Pi lǝ ǝpǝkǝ kǝ lǝh pǝ lǝ mǝŋ kǝ́ ǝrǝkǝ kǝ lée sie rǝ kǝcɔkɔŋpoŋkǝ, kǝ ŋ nyɩnɩ kǝ ko ru ǝrǝ kǝcɔkɔŋtɔɔkǝ kǝtǝ wǝ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Fɛɛwǝ we kɛɛkpǝ́yǝ ŋ co we, fɛɛwǝ we wǝ́ otoŋtoŋkɛɛpǝ pǝ lóo ku wǝ.»<verse eid="MAT 24:28" /></para>
  <para style="s">Nyɩmaasɩ le Pi lǝ ǝpǝkǝ</para>
  <para style="r">(<ref loc="MRK 13:24-27">Marǝko 13:24-27</ref>, <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«Vǝ́ arianyɩŋmumuŋyǝ sa le eciyǝ yǝ la nya yǝ la tɛlɩ ko, cɔkɔŋyǝ lée fii nuŋtumuwǝ, kɛɛnyɔŋyǝ lǝŋ tǝ ŋ nyɔŋ. Wǝŋɔŋkpǝ wǝ loh mǝ ru rǝ yulaarǝ wǝ ŋ pǝ wǝ ŋ tɔɔlʊ kǝ okopiyǝ we yǝ kpii rǝ oŋuŋkǝ yǝ tikili. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Rǝ eniyǝ we mǝrǝ we, Nyɩmaasɩ le Pi la barǝ láa nyɩnɩ rǝ yulaarǝ, kǝ wǝnyikpǝŋkpǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ wǝ fii kǝǝnǝwǝ. Pǝ láa nyɩŋ Nyɩmaasɩ le Pi tɛɛ rǝ aŋɔɔyǝ lǝ́ǝ pǝ mǝ no okopiyǝ kpǝlo kɩɩkɩ, mǝ na wǝnyɩɩnɩkpǝ kpǝlo kɩɩkɩ. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Pǝ lǝ́ǝ kpǝǝ kǝpɛrɩmumuŋkǝ we, eniyǝ we le kpii ne epicoŋpipǝ la maŋ rǝ ǝrǝkǝ kpǝlo siri po ku, kǝ pǝ ka ca epǝ we ŋ na saa ŋ nǝ tǝnǝ pǝ ku, fǝ ǝrǝ ǝrǝkǝ le nyiŋwǝ ko ru ǝrǝ kǝlo kuruwǝ.»<verse eid="MAT 24:31" /></para>
  <para style="s">Otukarǝyǝ ru rǝ eciiyǝ</para>
  <para style="r">(<ref loc="MRK 13:28-31">Marǝko 13:28-31</ref>, <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«Nǝ karǝ otuyǝ nǝ ru rǝ dierǝ sa ŋ́ nah tɛŋ ŋ́ ca mǝ wǝcookpǝ wǝ. Vǝ́ wǝcookpǝ la alaŋyǝ yǝ la tarǝ, wǝ́ yǝ lo ru eweyǝ we, nǝ nyǝ ŋ ci wǝ ǝkǝnǝŋ aŋʊŋtɛniyǝ yǝ lǝ kǝlǝ. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kaa wǝǝ vǝ́ nǝ nya pa nyɩŋ otuyǝ sa kpǝlo kɩɩkɩ we, nǝ ci wǝ ǝkǝnǝŋ Nyɩmaasɩ le Pi lǝ ǝpǝkǝ kǝ lǝ kǝlǝ, wǝ́ ŋ yaa rǝ nǝ guŋpolurǝ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, rǝkǝsa le enyipǝ pǝ lǝŋ pǝ kpǝ́ pǝ lɛ kpɛŋ kǝ otuyǝ sa kpǝlo kɩɩkɩ yǝ ci ǝpǝ. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Yulaarǝ mǝ kǝtǝǝwǝ yǝ lah pa tɛlɩ, paa mǝ etieyǝ yǝ lǝŋ pa tɛlɩ kʊrakʊra.<verse eid="MAT 24:35" /></para>
  <para style="s">Rɛ lee ci eniyǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ wǝ</para>
  <para style="r">(<ref loc="MRK 13:32-37">Marǝko 13:32-37</ref>, <ref loc="LUK 17:26-30">Luka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Paa mǝŋ jirǝ we amaa eniyǝ we otuyǝ sa yǝ lǝ́ǝ pǝ we, rɛ ri ŋ rɛ lee ci yǝ, mǝŋ epicoŋpipǝ rǝ yulaarǝ, mǝŋ Piyǝ.<note caller="+" style="f"><char style="fr" closed="false">24:36 </char><char style="ft" closed="false">«Mǝŋ Piyǝ» lee kpii rǝ wǝŋʊrʊkuukuurɛɛkpǝ, Yɩrɩ Marǝko 13:32.</char></note> We Tǝyǝ ceŋceŋ ko ŋ cii yǝ wǝ. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Tuwǝ we wǝ pǝlǝ rǝ Nowa le eniyǝ we we, ŋ wǝ ke wǝ lǝ́ǝ tǝ wǝ pǝ mǝ Nyɩmaasɩ le Pi lǝ ǝpǝkǝ wǝ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Duturǝ ɖi, rǝ eniyǝ we we, kpɛŋ kǝ ŋʊŋtɛmumuŋyǝ we ŋ pǝ pǝ we, enyipǝ pǝ ke ŋ ri wǝ́ pǝ ko ŋ ŋuŋ. Pǝ ka ŋ lɔ etiepǝ wǝ́ pǝ kǝ ŋ fǝ pǝla akɔrʊpǝ pǝ ŋ koonu wǝnuŋkpǝ ko ro ǝrǝ jirǝ we Nowa<note caller="+" style="f"><char style="fr" closed="false">24:38 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 6:9-7:6">1Mo 6:9–7:6</ref></char>.</char></note> ŋ fìi arakayǝ we wǝ. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Enyipǝ pǝ lee ke ci tuwǝ wǝ lǝh pǝ, po ro ǝrǝ eniyǝ we ŋʊŋtɛmumuŋyǝ we ŋ pǝlǝ ŋ wʊ̀ʊ pǝlo kpǝlo kɩɩkɩ wǝ.<note caller="+" style="f"><char style="fr" closed="false">24:39 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="GEN 7:7-24">1Mo 7:7-24</ref></char>.</char></note> Kǝ́ wǝ lǝh pǝ lǝ mǝ Nyɩmaasɩ le Pi lǝ ǝpǝkǝ wǝǝ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Rǝ eniyǝ we lǝ mǝrǝ we, enyi eyi pǝ láa yaa rǝ atɛɛkǝ, pǝ lǝ́ǝ fǝ ceŋceŋ kǝ pǝ maa ceŋceŋ pǝ tǝnǝ. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Etiepǝ eyi pǝ láa ya pǝ ŋ tǝǝ fuŋtuwǝ rǝ wǝtǝǝkpǝ. Pǝ lǝ́ǝ fǝ ceŋceŋ kǝ pǝ maa ceŋceŋ pǝ tǝnǝ. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Kǝto nǝ saanǝ nǝ tii nǝ mǝ rǝŋ duturǝ ɖi nǝ nyee ci jirǝ we nǝ Kulǝtǝyǝ ŋ nǝ́ǝ pǝ wǝ. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nǝ cii wǝ ǝkǝnǝŋ mǝŋ nyarǝlǝtǝyǝ keh ci dumurǝ le eniyǝ lǝ ǝyǝ yɩlayɩtǝyǝ ŋ nǝ́ǝ pǝ we, kah saanǝ ŋ tii ŋ rǝŋ, lǝŋ ka maa ŋwǝ ŋ wǝǝrǝ giriŋrǝ ŋ fii na nyarǝwǝ. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Wǝ kǝto ŋnǝ ŋkpɛ nǝ kpaka nǝ tii. Duturǝ ɖi Nyɩmaasɩ le Pi lǝh pǝ pǝ mǝ eniyǝ we nǝ nyǝǝ kǝ wǝ wǝ.<verse eid="MAT 24:44" /></para>
  <para style="s">Nʊkɔrǝtǝsʊmatǝyǝ mǝ sʊmatǝrɔɔrɔɔyǝ</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Ǝlǝ ŋ ri nʊkɔrǝtǝsʊmatǝyǝ we ŋ cii otuyǝ wǝ? Ŋwǝ ŋ kaamǝ yǝ we kulǝtǝyǝ ŋ nǝ fǝ na nyarǝwǝ la asʊmatǝtuturupǝ ŋ ne kpii rǝ akaakǝ kǝ mǝ ŋ koonu pǝle keeriwǝ rǝ eniyǝ we yǝ kaa wǝ. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ŋwǝ sʊmatǝyǝ sa lo co yǝ mǝŋ no kulǝtǝyǝ lo ko ru lǝ́ǝ pǝ wǝ́ ŋ na pa nyɩŋ ŋwǝ ya lée yee kǝnǝnɛkǝ sa sɩsiɛrɩ wǝ! <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, kulǝtǝyǝ sa lǝ́ǝ fǝ no otulǝmǝyǝ kpǝlo kɩɩkɩ ŋ kpii ŋwǝ rǝ akaakǝ ŋ mǝ ŋ yɩrɩ yurǝ. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Wǝ́ mǝŋ sʊmatǝrɔɔrɔɔyǝ wǝ́ ŋ ri we, lée tíi na wɛ ǝkǝnǝŋ: “Mǝ kulǝtǝyǝ lǝŋ pa maa ŋ pǝ”, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />eniyǝ we leh kpii mǝ ŋ culu nǝ ǝtǝŋsʊmatǝpǝ we, kǝ mǝ ŋ ri, mǝ ŋ ŋuŋ mǝ ŋ kʊla mǝ ǝfǝŋŋuŋtǝpǝ. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Kulǝtǝyǝ leh pe fii mǝ jirǝ we sʊmatǝyǝ sa ŋ naa tɛɛ kpɛɛwǝ wǝ, mǝ eniyǝ we ŋ nee ci wǝ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Kulǝtǝyǝ sa lée piri ŋwǝ kǝ ŋ ta no kǝtukoŋkǝ ŋpa, mǝŋ kǝ́ pǝ láa ta epǝ we pǝ lée yee alakpayǝ lo kǝtukoŋkǝ kǝtǝ rǝ fɛɛwǝ we eweekǝ mǝ oroŋciwoyǝ yǝ kpii wǝ.»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Yesu la ca duturǝ lo ru rǝ akɔsɔkɔrʊpipǝ rɛ ǝtǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«Kaa wǝǝ, yulaarǝ le wǝpilirikpǝ wǝ lo ru akɔsɔkɔrʊpipǝ rɛ ǝtǝ pǝ fǝ̀ pǝla akaŋreyǝ pǝ rù pǝ ko ŋ ko pǝ ko ku mǝ tiɛŋwɛŋlǝtǝyǝ wǝ. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Atʊʊ rǝ pǝlǝ mǝrǝ pǝ ko puru, wǝ́ atʊʊ pǝ ke sieni nimirǝ. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Akɔrʊpipǝ we pǝ ko puru we, pǝ fǝ̀ pǝla akaŋreyǝ, paa pǝ loo pu yurǝ ǝkǝnǝŋ ŋpǝ pǝ lée re kɛrɛsɩnɩyǝ. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Wǝ́ akɔsɔkɔrʊpǝ we pǝ sieni nimirǝ ŋpǝ paa pǝ rè kɛrɛsɩnɩyǝ mǝ apʊrʊŋtwapiyǝ pǝ kʊ̀la mǝ pǝla akaŋreyǝ. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Kǝ́ tiɛŋwɛŋlǝtǝyǝ we ŋ naa ya ŋ nǝ́ǝ pǝ kǝto we, wǝ́ eniŋrieyǝ yǝ pǝlǝ yǝ ka ŋ rɔɔnʊ pǝ. Wǝ́ pǝlo kpǝlo pǝ kpɛlɩ eniŋrieyǝ. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Kǝ́ kǝ la cɩɩ kǝ lǝ sǝpǝ we, wǝ́ pǝ nunu pǝ la ca narǝwǝ ǝkǝnǝŋ: “Nǝ yɩrɩ tiɛŋwɛŋlǝtǝ re! Nǝ ru nǝ ko kumǝ ŋwǝ!” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Wǝ́ akɔsɔkɔrʊpipǝ sa kpǝlo pǝ sàanǝ, wǝ́ pǝ ka ŋ rɛɛrɩ mǝ pǝla akaŋreyǝ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Wǝ́ epǝ we pǝ puru we, pǝ ke ŋ tíi epǝ we pǝ sieni nimirǝ ǝkǝnǝŋ: “Nǝ maa nǝ kɛrɛsɩnɩyǝ sa tɩpɩrɩ nǝ koonu lǝ oo, lah akaŋreyǝ yǝ lǝh rǝŋ.” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Wǝ́ epǝ we pǝ sieni nimirǝ pǝ ke ŋ tíi pǝ ǝkǝnǝŋ: “Ow, kɛrɛsɩnɩyǝ sa le re we, lǝŋ ro ŋlǝ mǝ nǝ. Bomu nǝ ko nǝ ko fuu rǝ akɛrɛsɩnɩsiiritǝpǝ lǝ kpǝŋ.” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Wǝ́ pǝ rù pǝ ko ŋ ko pǝ ko fuu. Eniyǝ we wǝ́ tiɛŋwɛŋlǝtǝyǝ we ŋ pǝlǝ ŋ fìi. Wǝ́ ŋpǝ mǝ akɔsɔkɔrʊpipǝ we atʊʊpǝ pǝ kpàka pǝ tini pǝ kǝ ŋ rǝŋ we, pǝ yili pǝ ke ŋ fii wǝtiɛŋwɛŋkukpǝ we. Wǝ́ pǝ lɔ̀ ŋwaarǝ we pǝ tanǝ mǝ safweyǝ. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Wǝla kǝmaa wǝ́ akɔsɔkɔrʊpituturupǝ we pǝ pǝlǝ pǝ rù. Wǝ́ pǝ ka ŋ ca narǝwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, kulǝtǝyǝ, taanǝ lǝ!” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Wǝ́ tiɛŋwɛŋlǝtǝyǝ we ŋ yìili ǝkǝnǝŋ: “Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, ŋ́ nee ci nǝ.” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: “Kǝto we, nǝ saanǝ nǝ tii nǝ mǝ rǝŋ! Duturǝ ɖi nǝ nyee ci jirǝ we amaa eniyǝ we.”»<verse eid="MAT 25:13" /></para>
  <para style="s">Yesu la ca duturǝ lo ru rǝ asʊmatǝpǝ rɛ ata</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«Yulaarǝ le wǝpilirikpǝ wǝ lo ru dierǝ sa: Nyiyǝ rɛ kǝ ŋ pǝ́ ŋ ko gʊŋrǝ. Wǝ́ ŋ pwò na asʊmatǝpǝ ŋ pǝlǝ, wǝ́ ŋ fǝ̀ no otulǝmǝyǝ ŋ kpìi pǝ rǝ akaakǝ. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Wǝ́ ŋ kòonu rɛɛyǝ sɩkakpotokpotoyǝ tuurutʊʊ. Wǝ́ ŋ kòonu yitǝyǝ tuuruyi, wǝ́ ŋ kòonu tatǝyǝ tuuru. Nyi ri ŋ nyi lɔ̀ kǝ́ ŋ nóo koru wǝ. Wǝ́ ŋ pwɛ̀yɩ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Kǝtǝrǝceŋceŋ wǝ́ sʊmatǝyǝ we ŋ lɔ̀ sɩkakpotokpotoyǝ tuurutʊʊ we, ŋ fǝ̀ ŋwǝ ŋ kolu ŋ ka ŋ saŋ ɖaasaŋrǝ. Wǝ́ ŋ nyà sɩkakpotokpotoyǝ tuurutʊʊ ŋ tɛ̀ɛ. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Wǝ́ yǝ we ŋ lɔ̀ tuuruyi ŋwǝ ŋkpɛ ŋ yeli mǝŋ kɔɔwe. Wǝ́ ŋ nyà sɩkakpotokpotoyǝ tuuruyi ŋ tɛ̀ɛ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Wǝ́ yǝ we ŋ lɔ̀ tuuru we, ŋwǝ paa ŋ kolu ŋ nyini fuŋwǝ, wǝ́ ŋ fǝ̀ no kulǝtǝyǝ la sɩkayǝ we ŋ ŋwàa rǝ fuŋwǝ we.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Wǝ́ wǝ pànǝ ŋpa kpɛŋ wǝ́ asʊmatǝpǝ sa lo kulǝtǝyǝ ŋ ci asiɛnɩ ŋ pǝlǝ. Wǝ́ ŋ yà ŋ ke ŋ yee akʊŋtayǝ mǝ pǝ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Wǝ́ yǝ we ŋ lɔ̀ sɩkakpotokpotoyǝ tuurutʊʊ ŋ rùu ŋ kǝ̀lǝ, wǝ́ ŋ fǝ̀ sɩkakpotokpotoyǝ we tuurutʊʊ ŋ na ta ŋ na tɛɛ ŋ pǝlǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Kulǝtǝyǝ, o kòonu mǝ sɩkakpotokpotoyǝ tuurutʊʊ, wǝ́ ŋ́ na nya tǝtatɛɛyǝ tuurutʊʊ ŋ́ na kʊla, ŋwǝ ǝyǝǝ.” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Wǝ́ no kulǝtǝyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Wǝ ponu, sʊmatǝceeceeyǝ mǝ nʊkɔrǝlǝtǝyǝ wǝ́ e ri. E le ri anʊkɔrǝyǝ rǝ otuyǝ yǝ laa lɔ okuruyǝ lǝ mǝrǝ. Kǝto ŋ́ nǝ́ǝ fǝ ǝyǝ yǝ la lɔ okuruyǝ ŋpa ŋ kpii lǝ́ rǝ akaakǝ. Mǝ pǝ a pa nya faawǝ a kʊla mǝ mǝ.” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Wǝ́ sʊmatǝyǝ we ŋ lɔ̀ sɩkakpotokpotoyǝ tuuruyi ŋ rùu ŋ kǝ̀lǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Kulǝtǝyǝ, o kòonu mǝ sɩkakpotokpotoyǝ tuuruyi, wǝ́ ŋ́ na nya tǝtatɛɛyǝ tuuruyi ŋ́ na kʊla, ŋwǝ ǝyǝǝ.” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Wǝ́ no kulǝtǝyǝ ŋ tìi ŋwǝ ǝkǝnǝŋ: “Wǝ ponu, sʊmatǝceeceeyǝ mǝ nʊkɔrǝlǝtǝyǝ wǝ́ e ri. E le ri anʊkɔrǝyǝ rǝ otuyǝ yǝ laa lɔ okuruyǝ lǝ mǝrǝ. Kǝto ŋ́ nǝ́ǝ fǝ ǝyǝ yǝ la lɔ okuruyǝ ŋpa ŋ kpii lǝ́ rǝ akaakǝ. Mǝ pǝ a pa nya faawǝ a kʊla mǝ mǝ.” <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Rǝkǝsa wǝ́ sʊmatǝyǝ we ŋ lɔ̀ tuuru we, ŋ rùu ŋ kǝ̀lǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: “Kulǝtǝyǝ ŋ́ cii wǝ ǝkǝnǝŋ a lɛnyɩ kǝtukǝ. E lée ce rǝ fɛɛwǝ we a laa caŋ tǝrɛ wǝ. Wǝ́ a láa lɛɛ tuwǝ we a laa rʊʊ wǝ. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Vurǝ le yee mǝ, wǝ́ ŋ́ ne ke nyiŋ fuŋwǝ ŋ́ na ŋwaa lá sɩkayǝ we. Alǝŋ nyɩŋ, lɔ ló tuwǝ.” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Wǝ́ no kulǝtǝyǝ ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: “Sʊmatǝrɔɔrɔɔyǝ rɛ wǝ́ e ri, fanacitǝ! E ke cii wǝ ǝkǝnǝŋ ŋ́ née ce rǝ fɛɛwǝ we ŋ́ naa caŋ tǝrɛ wǝ. Wǝ́ ŋ́ náa lɛɛ tuwǝ we ŋ́ naa rʊʊ wǝ. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />We ǝ kǝh fǝ mǝ sɩkayǝ ǝ kǝ tǝnǝ rǝ fɛɛtǝnǝsɩkayǝ! Mǝŋkǝsa kǝ́ ŋ́ na siɛnɩ ŋ́ nǝ pǝ pǝ we, ŋ́ koh ko ŋ́ ka lɔ mǝ sɩkayǝ mǝŋ tǝtatɛɛyǝ. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Nǝ ta sɩkakpotokpotoyǝ we nǝ lɔ rǝ ŋwǝ kǝ nǝ fǝ nǝ koonu yǝ we ŋ lǝǝmǝ sɩkakpotokpotoyǝ lafa wǝ. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Duturǝ ɖi yǝ we ŋ lǝǝmǝ tuwǝ we, ŋwǝ wǝ́ pǝ lóo koonu tuwǝ pǝ ŋ kʊla wǝ, kǝ ŋ nya fɛɛ ŋ lǝmǝ ŋpa. Paa yǝ we ŋ nǝǝ lǝmǝ tǝrɛ we, pǝ láa lɔ pipiwǝ we ǝkǝŋtǝ wǝ lo tuuru ŋwǝ we, rǝ ŋwǝ. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Paa mǝŋ sʊmatǝkpaakpaayǝ sa we, nǝ tie ŋwǝ nǝ co rǝ koruwǝ, rǝ nuŋtumuwǝ we lǝ mǝrǝ, fɛɛwǝ we eweekǝ mǝ oroŋciwoyǝ yǝ kpii wǝ”.<verse eid="MAT 25:30" /></para>
  <para style="s">Kǝ́ Nyɩmaasɩ le Pi ŋ nah pa tɛŋ akpaŋyǝ ŋ fǝ wǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Vǝ́ Nyɩmaasɩ le Pi le pe fii rǝ na wǝnyɩɩnɩkpǝ lǝ mǝrǝ mǝ epicoŋpipǝ kpǝlo kɩɩkɩ pǝ siimǝ ŋwǝ we, leh ke tii rǝ na wǝnyɩɩnɩkpǝ le bilisaarǝ we. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Wǝkpǝŋkpǝ kpǝlo kɩɩkɩ rǝ kǝtǝǝwǝ wǝ loh po ku rǝ na kǝnyɩŋkǝ. Eniyǝ we lǝh sǝpǝ pǝ rǝ awɛ mǝŋ kǝ́ mɛɛrǝŋtǝyǝ ŋ nǝ́ǝ sǝpǝ amɛɛpǝ mǝ ŋ cɛ rǝ epereceepǝ lǝ kpǝŋ wǝ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Lǝ́ǝ tǝnǝ amɛɛpǝ rǝ ne kǝnirisiɛɛkǝ, kǝ ŋ tǝnǝ epereceepǝ rǝ na kǝpɛŋsiɛɛkǝ. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Eniyǝ we piliyǝ we le tíi epǝ we pǝ yaa rǝ ne kǝnirisiɛɛkǝ ǝkǝnǝŋ: “Nǝ mǝ pǝ, ŋnǝ epǝ we mǝ Tǝ ŋ na pɛɛrɩ wǝ. Nǝ mǝ fii yulaarǝ le wǝpilirikpǝ we wǝ ri nǝ wǝnɛŋ wǝ. Worokoyǝ ŋ na kpaka kpǝ ŋ nǝ tǝnǝ nǝ ǝrǝ kǝ́ ŋ ko ŋ co ǝrǝkǝ wǝ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Duturǝ ɖi kǝtɛŋkǝ kǝ wʊlʊ mǝ, wǝ́ nǝ kòonu mǝ keeriwǝ ŋ́ rili. Kǝmɛŋtɛŋkǝ kǝ wʊlʊ mǝ, wǝ́ nǝ kòonu mǝ mɛŋwǝ ŋ́ ŋunu. Ŋ́ ke ri sǝǝyǝ, wǝ́ nǝ lɔ̀ mǝ kǝsǝǝkǝ rǝ nǝ kpǝŋ. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ŋ́ ka ŋ tɛlɩ kǝtaŋkpa, wǝ́ nǝ kpìi mǝ wǝkpakpǝ. Ŋ́ naa ka kpaa wǝ́ nǝ yɩ̀rɩ mǝ yurǝ. Ŋ́ ke kpii rǝ gukpɛɛkpǝ wǝ́ nǝ pǝlǝ nǝ yɩ̀rɩ mǝ.” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Kǝ epǝ we pǝ le yee Worokoyǝ lǝ kǝǝpǝ́wǝ we, pǝ yiili pǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, eniyǝ rǝ fǝŋ wǝ́ la nyɩnɩ lǝ́ kǝtɛŋkǝ kǝ ya kǝ láa wʊ lǝ́ wǝ́ lo kòonu lǝ́ keeriwǝ e rili wǝ? Amaa kǝmɛŋtɛŋkǝ kǝ ya kǝ láa wʊ lǝ́ wǝ́ lo kòonu lǝ́ mɛŋwǝ o ŋunu wǝ? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Eniyǝ rǝ fǝŋ wǝ́ la nyɩnɩ lǝ́ e ri sǝǝyǝ, wǝ́ la lɔ̀ lǝ́ kǝsǝǝkǝ rǝ lǝh kpǝŋ wǝ? Amaa a láa tɛlɩ kǝtaŋkpa, wǝ́ le kpìi lǝ́ wǝkpakpǝ wǝ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Eniyǝ rǝ fǝŋ wǝ́ la nyɩnɩ lǝ́ a laa kpaa amaa e ke kpii rǝ gukpɛɛkpǝ wǝ́ lǝ pǝlǝ la yɩ̀rɩ lǝ́ wǝ?” <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Eniyǝ we piliyǝ we le yiili le tíi pǝ ǝkǝnǝŋ: “Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, eni ri ŋ ni nǝ nya nya nǝ nye yee wǝ nǝ nyo koonu mǝ apaanʊpǝ sa la rɛ, wǝ ke ce wǝ ri pǝle pipipipiyǝ rɛ we, ŋmǝ wǝ́ nǝ nye yee wǝ nǝ nyo koonu”.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Rǝkǝsa piliyǝ we lée tíi epǝ we pǝ yaa rǝ na kǝpɛŋsiɛɛkǝ ǝkǝnǝŋ: “Nǝ pwɛyɩ rǝ mǝ kpǝŋ, ŋnǝ ǝpǝ Worokoyǝ ŋ na fwɛɛrɩ wǝ! Nǝ mǝ ko naalaalɛwǝ we pǝ la kpaka pǝ lǝ tǝnǝ Abʊŋsamʊyǝ mǝ ne epicoŋpipǝ wǝ! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Duturǝ ɖi kǝtɛŋkǝ kǝ wʊlʊ mǝ paape nǝ nyoo koonu mǝ keeriwǝ ŋ́ ri. Kǝmɛŋtɛŋkǝ kǝ wʊlʊ mǝ paape nǝ nyoo koonu mǝ mɛŋwǝ ŋ́ ŋuŋ. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ŋ́ ke ri sǝǝyǝ paape nǝ nyaa lɔ mǝ kǝsǝǝkǝ. Ŋ́ ka ŋ tɛlɩ kǝtaŋkpa paape nǝ nyee kpii mǝ wǝkpakpǝ. Ŋ́ naa ka kpaa wǝ́ ŋ́ ke kpii rǝ gukpɛɛkpǝ paape nǝ nyaa pa yɩrɩ mǝ yurǝ.” <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Ŋpǝ ŋkpɛ pǝ lée yiili pǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: “Kulǝtǝyǝ, eniyǝ rǝ fǝŋ wǝ́ la nyɩnɩ lǝ́ kǝtɛŋkǝ kǝ ya kǝ láa wʊ lǝ́, amaa kǝmɛŋtɛŋkǝ kǝ ya kǝ láa wʊ lǝ́, amaa e ri sǝǝyǝ, amaa a láa tɛlɩ kǝtaŋkpa, amaa a laa kpaa, amaa e ke kpii rǝ gukpɛɛkpǝ wǝ́ yǝ loo toŋ lǝ́ wǝ?” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Piliyǝ we lée yiili mǝŋ tíi pǝ ǝkǝnǝŋ: “Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, eni ri ŋ ni nǝ nyaa nya nǝ yee wǝ nǝ koonu epipipipipǝ sa la rɛ ko we, ŋmǝ wǝ́ nǝ nyee yee wǝ nǝ koonu.” <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Ŋpǝ enyipǝ sa pǝ lóo ko rǝ tukoŋtalaalɛɛwǝ we mǝrǝ. Paa epǝ we pǝ le yee Worokoyǝ lǝ kǝǝpǝ́wǝ we, pǝ lóo ko vɔrʊlaalɛɛrǝ we mǝrǝ.»<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Oyudatǝpǝ pǝ le ri nyuŋkpǝ pǝ la tɛɛ rǝ Yesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Marǝko 14:1-2</ref>, <ref loc="LUK 22:1-2">Luka 22:1-2</ref>, <ref loc="JHN 11:45-53">Yowanɛsɩ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Kǝ́ Yesu ŋ na kaŋ otuyǝ sa kpǝlo kɩɩkɩ ŋ na lɛ we, wǝ́ ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Nǝ cii wǝ ǝkǝnǝŋ wǝ lo tuuru juu yi kǝ pǝ ri eyinyapǝkǝ la wǝcɛkpǝ. Pǝ lǝ́ǝ fǝ Nyɩmaasɩ le Pi pǝ kpii enyipǝ rǝ akaakǝ kǝ pǝ kpaa ŋwǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ.»<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Wǝ́ rǝkǝsa otoolutǝmumuŋpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ kolu pǝ kù rǝ toolutǝmumuŋyǝ we pǝ lóo pwo Kayifa la fɛɛlǝwǝ. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Wǝ́ pǝlo kpǝlo pǝ fǝ̀ pǝ tɛ̀ɛ rǝ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ lóo kuŋ pǝ lɔ Yesu mǝ wǝpiekpǝ kǝ pǝ wʊ ŋwǝ. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Paa wǝ́ pǝ tǝ pǝ tɛnɩ ǝkǝnǝŋ: «Yǝ lǝŋ lɔ ŋwǝ mǝ wǝcɛkpǝ sa, mǝŋ ŋkǝ kaa wǝǝ, kǝkpǝŋkǝ sa kǝ kah lɔ gasarǝ».<verse eid="MAT 26:5" /></para>
  <para style="s">Tieyǝ rɛ lo co apɔŋfɛŋfɛŋpǝ rɛ le fieni Yesu rǝ yurǝ</para>
  <para style="r">(<ref loc="MRK 14:3-9">Marǝko 14:3-9</ref>, <ref loc="JHN 12:1-8">Yowanɛsɩ 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesu ke kpii rǝ Betania, rǝ Sɩmɔ nyarǝpimwɛɛrɩlǝtǝyǝ we la nyarǝwǝ. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Eniyǝ we pǝ tini pǝ lée ri we, wǝ́ tieyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ Yesu. Tieyǝ sa ke re bʊrʊŋtwapirǝ rɛ pǝ lǝ fǝ ɖurǝ rɛ pǝ lóo pwo Alǝbatǝrǝyǝ pǝ le yee wǝ. Bʊrʊŋtwapirǝ we lǝ lǝ pwɩ mǝ apɔŋfɛŋfɛŋpǝ rɛ. Apɔŋpǝ sa pǝ lo ru okuruyǝ ŋpa. Wǝ́ ŋ fǝ̀ apɔŋpǝ we ŋ fìeni Yesu rǝ yurǝ. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Kǝ́ otukarǝtǝpǝ we pǝ la nyɩŋ tuwǝ sa we, wǝ́ wǝ fìi pǝ. Wǝ́ pǝ kǝ ŋ pǝ́ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ ŋ nǝ fǝ apɔŋfɛŋfɛŋpǝ sa ŋ nǝ pǝlǝ ǝnǝ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Pǝ koh koru esiiri apɔŋpǝ sa mǝ okuruyǝ, kǝ pǝ fǝ sɩkayǝ we pǝ koonu ariariatǝpǝ!»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Wǝ́ Yesu ŋ nyɩnɩ tuwǝ pǝ ya pǝ láa tɛŋ ŋ cìi. Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ kǝto wǝ́ nǝ ya nǝ nyée kpii tieyǝ sa la awɛɛlɩkǝ ǝnǝ? Tuwǝ sa ŋ ne yee ŋ no koonu mǝ we, tuceeceewǝ rɛ wǝ́ wǝ ri. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Duturǝ ɖi ariariatǝpǝ we pǝ kpii mǝ nǝ kǝkpakǝkpa. Ŋmǝ paa we, ŋ nǝŋ kpii mǝ nǝ kǝkpakǝkpa. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Apɔŋfɛŋfɛŋpǝ sa ŋ ne fieni mǝ we, lo toolu mǝ lo koonu mǝ aŋwaakǝ. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, fɛɛ ri ŋ fɛɛ rǝ ǝrǝkǝ sa kpǝlo pǝ lah mǝ tɛŋ Dieceeceerǝ sa we, pǝ lah mǝ tɛŋ tuwǝ sa tieyǝ sa ŋ yeli wǝ, kǝ pǝ fǝ pǝ ŋ taalǝ ŋwǝ.»<verse eid="MAT 26:13" /></para>
  <para style="s">Yuda la tɛɛnɩ ŋ fǝ Yesu ŋ kpii enyipǝ rǝ akaakǝ</para>
  <para style="r">(<ref loc="MRK 14:10-11">Marǝko 14:10-11</ref>, <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Wǝ́ rǝkǝsa Yesu le enyikpiipǝ we tǝ mǝ eyipǝ le ceŋceŋ pǝ lóo pwo Yuda Isǝkario we, ŋ kolu ŋ nyɩnɩ otoolutǝmumuŋpǝ we. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nǝ nyóo koonu mǝ mǝŋ ŋ́ nǝ fǝ Yesu ŋ ne kpii nǝ rǝ akaakǝ wǝ?» Wǝ́ enyipǝ sa pǝ kǝ̀ sɩkakpotokpotoyǝ tǝta pǝ kòonu ŋwǝ. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Fǝ rǝ eniyǝ we wǝ́ Yuda ŋ ka ŋ taa kʊŋwǝ kǝ ŋ fǝ Yesu ŋ kpii pǝ rǝ akaakǝ.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu le ri eyinyapǝkǝ la wǝcɛkpǝ ŋpǝ mǝ no otukarǝtǝpǝ</para>
  <para style="r">(<ref loc="MRK 14:12-21">Marǝko 14:12-21</ref>, <ref loc="LUK 22:7-14">Luka 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>, <ref loc="JHN 13:21-30">Yowanɛsɩ 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Kpɔnɔyǝ we pǝ lee kpii dafaŋrǝ la wǝcɛkpǝ le jisǝsǝŋrǝ we, wǝ́ Yesu lo otukarǝtǝpǝ we pǝ pǝlǝ pǝ pǝ̀ Yesu ǝkǝnǝŋ: «Fǝŋ wǝ́ ǝ lǝ́ǝ pǝ́ la ka caa eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ lo koonu lǝ́?» <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ ko tǝŋtǝǝwǝ sa, nyiyǝ sa eni lǝ kpǝŋ, kǝ nǝ tíi ŋwǝ ǝkǝnǝŋ: “Tukaŋtǝyǝ ǝkǝnǝŋ ne eniyǝ yǝ lǝ kǝlǝ. Lá nyarǝwǝ wǝ́ ŋ neh pe tii ŋ ri eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ ŋpǝ mǝ no otukarǝtǝpǝ.”» <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Wǝ́ otukarǝtǝpǝ we pǝ yeli pǝ sanǝ rǝ tuwǝ we Yesu ŋ tìi pǝ wǝ. Wǝ́ pǝ càa eyinyapǝkǝ la wǝcɛkpǝ le keeriwǝ we.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Kǝ́ wǝ lo ro ɖiɔrǝ we, wǝ́ Yesu ŋ kolu ŋ tini ŋpǝ mǝ no otukarǝtǝpǝ we tǝ mǝ eyipǝ pǝ ke ŋ ri. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Kǝ́ pǝ tini pǝ lée ri we, wǝ́ Yesu ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi nǝ wǝ, rǝ anʊkɔrǝyǝ we, rɛ rǝ nǝ mǝrǝ lǝh pǝ fǝ mǝ ŋ kpii enyipǝ rǝ akaakǝ.» <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Wǝ́ otukarǝtǝpǝ we pǝ fìi gʊʊpirǝ ŋpa. Wǝ́ pǝ kǝ ŋ pǝ́ Yesu rǝ tɛɛ rǝ tɛɛ ǝkǝnǝŋ: «Kulǝtǝyǝ, ŋmǝ ŋ́ lǝǝwe?» <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Wǝ́ Yesu ŋ yìili ǝkǝnǝŋ: «Yǝ we ŋ ne kpii akaakǝ ŋ na kʊla mǝ mǝ rǝ kǝsiɛkǝ sa mǝrǝ we, ŋwǝ ŋ nǝh fǝ mǝ ŋ kpii enyipǝ rǝ akaakǝ wǝ. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nyɩmaasɩ le Pi lǝ́ǝ kpǝ́ mǝŋ kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ wǝ wǝ lo ru rǝ ŋwǝ wǝ. Paa yǝ we ŋ nǝ́ǝ fǝ Nyɩmaasɩ le Pi ŋ kpii enyipǝ rǝ akaakǝ we, na paapɔ mǝ na aria! O koh nuŋ pǝ lǝǝ mǝ yǝ we kʊraa we, wǝ koh poŋ ŋwǝ wǝ teeri.» <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Wǝ́ Yuda yǝ we ŋ kǝ ŋ pǝ ŋ pǝ fǝ Yesu ŋ kpii enyipǝ rǝ akaakǝ we, ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Tukaŋtǝyǝ, ŋmǝ ŋ́ lǝǝwe?» Wǝ́ Yesu ŋ yìili ŋ tíi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ a ya láa tɛŋ wǝ».<verse eid="MAT 26:25" /></para>
  <para style="s">Keerikenikeniwǝ</para>
  <para style="r">(<ref loc="MRK 14:22-26">Marǝko 14:22-26</ref>, <ref loc="LUK 22:14-20">Luka 22:14-20</ref>, <ref loc="1CO 11:23-25">1 Okorɛŋtotǝpǝ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Kǝ́ pǝ tini pǝ lée ri we, wǝ́ Yesu ŋ fǝ̀ kpɔnɔyǝ. Kǝ́ ŋ ne ceeni Worokoyǝ ŋ na lɛ we, wǝ́ ŋ pò ŋwǝ, wǝ́ ŋ fǝ̀ ŋ kòonu no otukarǝtǝpǝ we. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ lɔ nǝ wo, wǝ ǝnǝ wǝ ri mǝ wɛlɛŋrǝ.» <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Rǝ wǝla kǝmaakǝ wǝ́ ŋ fǝ̀ kɔpʊwǝ rɛ wǝ kpii mǝ vɛŋyǝ. Kǝ́ ŋ ne ceeni Worokoyǝ ŋ na lɛ we, wǝ́ ŋ fǝ̀ wǝ ŋ kòonu pǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ kpǝlo kɩɩkɩ nǝ ŋuŋ. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Duturǝ ɖi wǝ ǝnǝ wǝ ri mǝ ŋpǝrayǝ. Ŋpǝrayǝ sa wǝ́ Worokoyǝ ŋ nǝ fǝ ŋ na tɛɛ gaapirǝ rǝ ne dierǝ we ŋ na parǝ ŋ nǝ tǝnǝ rǝ ŋpǝ mǝ enyipǝ le kǝtiitiikǝ wǝ. Ŋpǝrayǝ sa ŋ na lʊ rǝ enyipǝ wa lo yurǝ, koonu oturɔɔrɔɔyǝ lǝ ǝfǝcɛɛkǝ. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ŋ́ ya ŋ́ née tíi nǝ wǝ, fǝ rǝkǝsa mǝ ko, ŋ́ nǝŋ tǝ ŋ́ po ŋuŋ vɛŋyǝ sa ko ro jirǝ we ŋ́ nóo ŋuŋ vɛŋŋwɛŋyǝ ŋlǝ mǝ nǝ rǝ mǝ Tǝ le wǝpilirikpǝ we mǝrǝ.» <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Kǝ́ Yesu mǝ no otukarǝtǝpǝ pǝ la nɔŋ oworokonɔŋyǝ we pǝ láa nɔŋ mǝ eyinyapǝkǝ la wǝcɛkpǝ pǝ la lɛ we, wǝ́ pǝ rù pǝ ko ŋ ko Oliviepǝ lo dutupirǝ we.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesu la tɛŋ lǝ tǝnǝ ǝkǝnǝŋ Pɛtǝro lǝh pǝ sǝ́ŋ ŋwǝ ŋ co</para>
  <para style="r">(<ref loc="MRK 14:27-31">Marǝko 14:27-31</ref>, <ref loc="LUK 22:31-34">Luka 22:31-34</ref>, <ref loc="JHN 13:36-38">Yowanɛsɩ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Wǝ́ Yesu ŋ tìi no otukarǝtǝpǝ we ǝkǝnǝŋ: «Dumurǝ sa we, nǝ kpǝlo kɩɩkɩ nǝ nyáa maa mǝ nǝ co. Duturǝ ɖi pǝ la ŋʊrʊ rǝ Wǝŋʊrʊkenikenikpǝ mǝrǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="MAT 26:31">“Ŋ́ náa wʊ mɛɛrǝŋtǝyǝ we,</para>
  <para style="q1" vid="MAT 26:31">kǝ mɛɛkpǝŋwǝ we wǝ suu wǝ caŋ awɛ”.<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Paape vǝ́ ŋ́ na saanǝ ŋ́ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, ŋ́ nóo coŋ ŋ́ ka ya mǝ ŋ rǝŋ nǝ rǝ Galileya.» <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Wǝ́ Pɛtǝro ŋ lɔ̀ kpɛɛwǝ, wǝ́ ŋ tìi Yesu ǝkǝnǝŋ: «Wǝ ke ce wǝ ri enyipǝ kpǝlo kɩɩkɩ pǝ la maa lǝ́ pǝ lo co we, ŋmǝ paa ŋ́ nǝŋ pa maa lǝ́ ŋ́ co pwi.» <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Wǝ́ Yesu ŋ́ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋ́ ya ŋ́ née tíi lǝ́ wǝ, rǝ anʊkɔrǝyǝ we, kpɛŋ kǝ kʊkɔyǝ ŋ pǝ kpǝǝ mǝ dumurǝ sa we, ǝ lǝ́ǝ sǝ́ŋ mǝ o co pǝrǝŋwǝ kǝta.» <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Wǝ́ Pɛtǝro ŋ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ ke ce wǝ ri ǝkǝnǝŋ ŋmǝ ŋ́ nǝ́ǝ kpǝ́ ŋ́ kʊla mǝ lǝ́ we, ŋ́ nǝŋ pǝ sǝ́ŋ lǝ́ ŋ́ co.» Wǝ́ otukarǝtǝtuturupǝ we ŋpǝ ŋkpɛ pǝ tɛnɩ wǝ mǝŋkɔɔwe.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu la mwɛŋ nyuŋkpǝ rǝ Gecemanɩ</para>
  <para style="r">(<ref loc="MRK 14:32-42">Marǝko 14:32-42</ref>, <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Wǝ́ Yesu mǝ no otukarǝtǝpǝ we pǝ kolu pǝ fìi fɛɛwǝ rɛ pǝ lóo pwo Gecemanɩ wǝ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ tíi rǝ fɛɛwǝ sa kǝ ŋ́ ko ŋ́ ka mwɛŋ nyuŋkpǝ rǝ ɖeeni.» <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Wǝ́ ŋ rè Pɛtǝro mǝ Zebede le epipǝ we pǝle eyi ŋ kʊla mǝ na wɛ. Wǝ́ ŋ tìe gʊʊpifiirǝ mǝ kǝǝnǝwǝ. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ne fii gʊʊpirǝ mǝŋ ŋ́ kpǝ́ rǝ! Nǝ tii rǝ sa, nǝ saanǝ nǝ tii nǝ mǝ rǝŋ nǝ kʊla mǝ mǝ.» <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Wǝ́ ŋ rùu ŋ kolu tɩpɩrɩ. Wǝ́ ŋ sʊ̀ʊ ŋ kpɛlɩ ŋ pùnu anyɩŋkǝ rǝ kǝtǝǝwǝ. Wǝ́ ŋ mwɛnɩ nyuŋkpǝ ǝkǝnǝŋ: «Mǝ Tǝ, mǝŋ wǝ lóo poŋ we, ruu acʊcʊʊrʊyǝ sa a cɛ rǝ mǝ kpǝŋ! Paa yee rǝ lǝ́ kǝǝpǝ́wǝ, ŋkǝ mǝ nɛŋwǝ oo.» <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Kǝ́ ŋ na siɛnɩ ŋ no po tuu otukarǝtǝpǝ we atapǝ we, wǝ́ ŋ tùru kǝ́ pǝ la kpɛɛ eniŋrieyǝ wǝ. Wǝ́ ŋ pǝ̀ Pɛtǝro ǝkǝnǝŋ: «We nǝ nyoo koru a saanǝ nǝ tii nǝ mǝ rǝŋ nǝ kʊla mǝ mǝ eniyǝ buŋrǝ jeŋceŋ ǝkǝŋtǝ? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Nǝ tii nǝ mǝ rǝŋ, kǝ nǝ mǝ mwɛŋ nyuŋkpǝ, kǝ nǝ paa nya fɛɛ nǝ fii rǝ gbǝǝrǝ. Nyɩmaasɩyǝ lǝ́ǝ pǝ́ ŋ yee tuceeceewǝ paape lǝǝ lǝmǝ okopiyǝ.» <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Wǝ́ Yesu ŋ tǝ ŋ rùu ŋ kolu kǝyitǝkǝ, wǝ́ ŋ mwɛnɩ nyuŋkpǝ ǝkǝnǝŋ: «Mǝ Tǝ, mǝŋ wǝ ri ǝkǝnǝŋ acʊcʊʊrʊyǝ sa yǝ lǝŋ koru oruu yǝ cɛ rǝ mǝ kpǝŋ mǝŋ ŋkǝ ŋ́ na cʊʊrʊ yǝ rǝ we, we yee rǝ lǝ́ kǝǝpǝ́wǝ!» <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Wǝ́ ŋ tǝ ŋ sìɛnɩ ŋ pǝlǝ, wǝ́ ŋ nyɩnɩ pǝ, pǝ ya pǝ láa kpɛɛ eniŋrieyǝ. Duturǝ ɖi pǝ loo ko ŋ koru owuru enimiyǝ pǝ re. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Wǝ́ Yesu ŋ tǝ ŋ pwɛ̀yɩ rǝ pǝlǝ kpǝŋ wǝ́ ŋ tǝ ŋ rùu ŋ kolu. Wǝ́ ŋ mwɛnɩ nyuŋkpǝ kǝtatǝkǝ ŋ tɛnɩ etieyǝ we ke. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Wǝ́ ŋ tǝ ŋ sìɛnɩ ŋ pǝlǝ otukarǝtǝpǝ we lǝ kpǝŋ. Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ tǝ nǝ ya nǝ nyáa kpɛɛ eniŋrieyǝ, nǝ kpɛɛ nǝ mǝ wɛɛ rǝ! Nǝ nyǝŋ nyɩŋ eniyǝ yǝ lo ro rǝkǝsa pǝ lǝh fǝ Nyɩmaasɩ le Pi pǝ kpii oturɔɔrɔɔyeetǝpǝ rǝ akaakǝ! <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Nǝ yi kǝ lo ko! Nǝ yɩrɩ re, yǝ we ŋ nǝh fǝ mǝ ŋ kpii pǝ rǝ akaakǝ lo po ru!»<verse eid="MAT 26:46" /></para>
  <para style="s">Pǝ la lɔ Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Marǝko 14:43-50</ref>, <ref loc="LUK 22:47-53">Luka 22:47-53</ref>, <ref loc="JHN 18:3-12">Yowanɛsɩ 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Eniyǝ we Yesu ŋ tǝ ŋ ya ŋ náa wɛɛlɩ we, wǝ́ Yuda, ŋ ri enyikpiitǝmeyipǝ we le ceŋceŋ ŋ pǝlǝ ŋ rù kǝtǝrǝceŋceŋ ŋpǝ mǝ nyikpǝŋmumuŋwǝ rɛ wǝ re atʊkʊyǝ mǝ eleŋkpeyǝ. Otoolutǝmumuŋpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ le kpii pǝ. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yudayǝ sa ŋ kǝ ŋ fǝ ŋwǝ ŋ kpii pǝ rǝ akaakǝ tìi pǝ tǝ̀nǝ tuwǝ we ŋ neh pe yee ŋ kaŋ pǝ wǝ. Tìi pǝ ǝkǝnǝŋ: «Yǝ we ŋ́ noh ko puru we, ŋwǝ ŋ lǝǝwe. Nǝ lɔ ŋwǝ.» <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Kǝ́ Yuda ŋ ne pe fii ko we, wǝ́ ŋ rùu ŋ kǝlǝ mǝ Yesu. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tukaŋtǝyǝ, paasɩ!» Wǝ́ ŋ pùru ŋwǝ. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Mǝ kɛrɩyǝ, tuwǝ we ǝ lǝ pǝ e pe yee we, yee wǝ kalaŋ.» Wǝ́ otuturupǝ we pǝ ko ŋ ruu pǝ ŋ kǝlǝ mǝ Yesu, wǝ́ pǝ lɔ̀ ŋwǝ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Wǝ́ epǝ we pǝ ka kʊla mǝ Yesu le ceŋceŋ ŋ pùuru na tʊkʊwǝ wǝ́ ŋ sìe toolutǝmumuŋyǝ we la sʊmatǝyǝ ŋ wàarǝ no kǝtukoŋkǝ. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Siɛnɩ mǝ lá tʊkʊwǝ e kpii rǝ wǝla fɛɛwǝ. Duturǝ ɖi epǝ we kpǝlo kɩɩkɩ pǝ lǝ́ǝ fǝ tʊkʊwǝ pǝ ŋ tɛɛ rǝ nyiyǝ we, tʊkʊwǝ wǝ lǝ́ǝ pǝ wǝ ŋ wʊ pǝ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />O lo pu wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝŋ ko koru opwo mǝ Tǝ? Keh kpii epicoŋpipǝ we pǝ ri akɔŋtǝpǝ lǝ kpǝŋwǝ wǝ teeri tǝ mǝ yi, ŋ maŋ mǝ rǝkǝsarǝkǝsa. <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Wǝ́ mǝŋ wǝ lǝ lǝ ǝnǝ wǝǝ wǝ keh yee nɛ kǝ tuwǝ we Worokoyǝ le dierǝ la tɛŋ wǝ nya fɛɛ wǝ pǝ? Duturǝ ɖi Worokoyǝ le dierǝ we la tɛŋ ǝkǝnǝŋ otuyǝ sa yǝ lǝ́ǝ pǝ mǝŋkǝsa.»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Wǝ́ Yesu ŋ tìi kǝkpǝŋkǝ we ǝkǝnǝŋ: «Nǝ nyóo ko ru mǝ atʊkʊyǝ mǝ eleŋkpeyǝ nǝ nyǝ́ǝ pǝ nǝ pa lɔ mǝ mǝŋ nyiwʊʊlʊtǝyǝ rɛ wǝ́ ŋ́ ri. Ji ri ŋ ji ŋ́ tini rǝ Worokoyǝ la nyarǝwǝ ŋ́ náa kaŋ otuyǝ, nǝ nyaa pa lɔ mǝ. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Paape otuyǝ sa kpǝlo kɩɩkɩ yǝ lǝ pǝ ǝnǝ kǝ oworokokpɛɛnuŋtɛŋtǝpǝ le etieyǝ we pǝ la ŋʊrʊ pǝ le kpii rǝ Wǝŋʊrʊkenikenikpǝ mǝrǝ we, yǝ nya fɛɛ yǝ pǝ.» Wǝ́ otukarǝtǝpǝ we kpǝlo kɩɩkɩ pǝ màa Yesu pǝ cò wǝ́ pǝ sùu pǝ pwɛ̀yɩ.<verse eid="MAT 26:56" /></para>
  <para style="s">Pǝ lo koomǝ Yesu rǝ Oyudatǝpǝ la fɛɛtɛŋakpaŋyǝ</para>
  <para style="r">(<ref loc="MRK 14:53-65">Marǝko 14:53-65</ref>, <ref loc="LUK 22:54-55">Luka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>, <ref loc="JHN 18:13-14">Yowanɛsɩ 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Wǝ́ enyipǝ we pǝ pǝlǝ pǝ lɔ̀ Yesu we, pǝ fǝ̀ ŋwǝ pǝ kolu toolutǝmumuŋyǝ we pǝ lóo pwo Kayifa lǝ kpǝŋ, fɛɛwǝ esekaŋtǝpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ kù pǝ ke tini wǝǝ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Wǝ́ Pɛtǝro ŋ sìimǝ Yesu rǝ kǝmaakǝ rǝ nɔ ŋ ko ŋ ko ǝrǝ toolutǝmumuŋyǝ we la nyarǝwǝ le etikeŋtikǝ. Wǝ́ ŋ fìi ŋ kolu ŋ tini ŋ kʊ̀la mǝ ǝrǝŋtǝpǝ we kǝ ŋ nyɩŋ kǝ́ wǝ lah ka lɛ wǝ fǝ wǝ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Rǝkǝsa wǝ́ otoolutǝmumuŋpǝ we mǝ Oyudatǝpǝ la akpaŋtɛŋtǝpǝ we kpǝlo kɩɩkɩ la wǝcakumumuŋkpǝ we pǝ ka ŋ taa dierǝ pǝ láa nia pǝ tɛɛ rǝ Yesu kǝ pǝ nya fɛɛ pǝ tɔɔ na gbɛŋpɔrǝ wǝ. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Paape pǝ laa nya dierǝ rɛ mǝŋkǝ́ enyipǝ wa pǝ pǝlǝ pǝ nìa etieyǝ pǝ tɛ̀ɛ rǝ ŋwǝ wǝ. Kǝ́ wǝ lo ko wǝ lah lɛ we, wǝ́ enyipǝ rɛ eyi pǝ pǝlǝ pǝ rù wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />«Nyiyǝ sa la tɛŋ ǝkǝnǝŋ: “Ŋ́ nóo koru awɔɔ Worokoyǝ la nyarǝwǝ sa, kǝ ŋ́ siɛnɩ ŋ́ tɔ wǝ rǝ juu ta lǝ mǝrǝ”.»<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="JHN 2:19">Yow 2:19</ref></char>.</char></note> <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Wǝ́ toolutǝmumuŋyǝ we ŋ yili ŋ yàa, wǝ́ ŋ pǝ̀ Yesu ǝkǝnǝŋ: «Ǝ lǝǝ lǝmǝ tǝrɛ a láa tɛŋ o ru rǝ etieyǝ sa enyipǝ sa pǝ ya pǝ láa tɛŋ pǝ ŋ tɛɛ rǝ lǝ́ wǝ?» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Paape wǝ́ Yesu ŋ rǝnǝ kpiri. Wǝ́ toolutǝmumuŋyǝ we ŋ tìi ŋwǝ ǝkǝnǝŋ: «Tu Worokoyǝ we ŋ kpii vɔrʊrǝ kǝ e tíi lǝ: Mǝŋ ŋlǝ́ e ri Mesiyayǝ, Worokoyǝ le Piyǝ we wǝ.» <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Wǝ́ Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ a la tɛŋ wǝ. Paa ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ fǝ rǝ eniyǝ sa mǝ ko we, nǝ nyáa nyɩŋ Nyɩmaasɩ le Pi tini rǝ Woroko Kopilǝtǝyǝ le kǝnirisiɛɛkǝ. Nǝ nyah pa lɛ nǝ nyɩŋ ŋwǝ kǝ́ ŋ tɛɛ rǝ yulaarǝ la aŋɔɔyǝ ŋ nǝ́ǝ pǝ wǝ.» <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Kǝtǝrǝceŋceŋ wǝ́ toolutǝmumuŋyǝ we ŋ tà ŋwǝŋwǝ na wǝkpakpǝ ŋ làarǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «La fɛɛ Worokoyǝ! Yǝ lǝǝ tǝ lǝ pǝ́ ɖaŋsielǝtǝyǝ rɛ! Nǝ nyo nuŋ busuŋtǝtierǝ sa! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Nǝ nya nyɩŋ wǝ nɛ?» Wǝ́ pǝ yìili ǝkǝnǝŋ: «Wǝ kaamǝ kǝ ŋ kpǝ́.» <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Wǝ́ pǝ ko ŋ tó dutomirǝ pǝ ŋ fieni ŋwǝ rǝ anyɩŋkǝ. Wǝ́ pǝ ko ŋ tuu na akpaŋkʊyǝ. Wǝ́ arɛɛpǝ pǝ ka ŋ waarǝ na akaafieliyǝ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />pǝ ŋ tɛŋ ǝkenǝŋ: «Ŋlǝ́ Mesiyayǝ, nyɩŋ yǝ we ŋ na ca lǝ́ e tíi lǝ!»<verse eid="MAT 26:68" /></para>
  <para style="s">Pɛtǝro la cwɩɩ ǝkǝnǝŋ ŋ nee ci Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Marǝko 14:66-72</ref>, <ref loc="LUK 22:56-62">Luka 22:56-62</ref>, <ref loc="JHN 18:15-18">Yowanɛsɩ 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pɛtǝro ke tini rǝ koruwǝ rǝ etikeŋtikǝ wǝ́ sʊmatǝtieyǝ rɛ ŋ rùu ŋ kǝ̀lǝ mǝ ŋwǝ. Wǝ́ ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlá ŋkpɛ a ka kʊla mǝ Yesu, Galileya tǝ kɛrɩyǝ sa!» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Wǝ́ ŋ cwɩ̀ɩ wǝ ŋ tɛnɩ rǝ enyikpǝlo la kǝnyɩŋkǝ ǝkǝnǝŋ: «Ŋ́ nee ci tuwǝ a ya lǝ́ǝ pǝ́ a tɛŋ!» <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Wǝ́ ŋ ko ŋ ko rǝ etikeŋtikǝ we lo guŋpolurǝ. Wǝ́ sʊmatǝtiepʊŋpwayǝ rɛ ŋ nyɩnɩ ŋwǝ. Wǝ́ ŋ tìi enyipǝ we pǝ ka yaa rǝ we ǝkǝnǝŋ: «Nyiyǝ sa ka kʊla mǝ Nazarɛtǝtǝ Yesu.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Wǝ́ Pɛtǝro ŋ tǝ ŋ cwìɩ wǝ ke. Wǝ́ ŋ tù ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ nee ci nyiyǝ sa».<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Rǝ enipiyǝ rɛ la kǝmaa we, wǝ́ epǝ we pǝ ka yaa rǝ we pǝ rùu pǝ kǝlǝ mǝ Pɛtǝro. Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Kǝceece, ŋlá ŋkpɛ a kʊla mǝ enyipǝ sa! Ló tuwɛɛlɩwǝ wǝ la pɔrʊ fɛɛwǝ o lo ru wǝ la kaŋ.» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Wǝ́ Pɛtǝro ŋ tìe na wɛ la afwɛɛrɩkǝ mǝŋ ŋ na nia rǝ wǝ, wǝ́ ŋ tù ŋ tɛnɩ ǝkǝnǝŋ: «Ŋ́ nee ci nyiyǝ sa!» Kǝtǝrǝceŋceŋ wǝ́ kʊkɔyǝ ŋ kǝ ŋ kpǝǝ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Wǝ́ Pɛtǝro ŋ tàalǝ tuwǝ we Yesu ŋ tìi ŋwǝ ǝkǝnǝŋ: «Kpɛŋ kǝ kʊkɔyǝ ŋ pǝ kpǝǝ we, ǝ lǝ́ǝ sǝ́ŋ mǝ o co pǝrǝŋwǝ kǝta.» Wǝ́ ŋ rù, wǝ́ ŋ weli ŋpa.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Pǝ lǝ fǝ Yesu pǝ lo ko Pilato lǝ kpǝŋ</para>
  <para style="r">(<ref loc="MRK 15:1">Marǝko 15:1</ref>, <ref loc="LUK 23:12">Luka 23:12</ref>, <ref loc="JHN 18:28-32">Yowanɛsɩ 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ɖokoŋpirǝ ŋalaŋala we, wǝ́ otoolutǝmumuŋpǝ we kpǝlo kɩɩkɩ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ kù. Wǝ́ pǝlo kpǝlo pǝ fǝ̀ pǝ tɛ̀ɛ rǝ pǝla wɛ ǝkǝnǝŋ ŋpǝ pǝ lóo kuŋ pǝ wʊ Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Wǝ́ pǝ pàrǝ ŋwǝ, wǝ́ pǝ fǝ̀ ŋwǝ pǝ kolu pǝ kpìi Pilato Romatǝkǝŋyɩrɩtǝyǝ rǝ akaakǝ.<verse eid="MAT 27:2" /></para>
  <para style="s">Yuda Isǝkario lǝ ǝkpǝ́kǝ</para>
  <para style="r">(<ref loc="ACT 1:18-19">Anǝnɛyeeyǝ 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kǝ́ Yuda, yǝ we ŋ fǝ̀ Yesu ŋ kpìi enyipǝ rǝ akaakǝ ŋ no nuŋ ǝkǝnǝŋ pǝ la tɔɔ Yesu la gbɛŋpɔrǝ we, wǝ́ wǝ kpìi na awɛɛlɩkǝ ŋpa. Wǝ́ ŋ sìɛnɩ mǝ sɩkakpotokpotoyǝ we nǝ tǝta ŋ kolu ŋ kòonu otoolutǝmumuŋpǝ we mǝ ǝtǝŋtǝǝtǝmumuŋpǝ we. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Ŋ́ ne yee turɔɔrɔɔwǝ, ŋ́ no kuŋ pǝ la wʊ nyiyǝ ŋ nee yee turɔɔrɔɔwǝ rɛ wǝ!» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Wǝ lǝǝ fǝ lǝ! Lé dierǝ lǝǝwe!» <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Wǝ́ Yuda ŋ fǝ̀ sɩkayǝ we ŋ tìe ŋ cò rǝ Worokoyǝ la nyarǝwǝ wǝ́ ŋ pwɛ̀yɩ. Wǝ́ ŋ kolu ŋ tonu na wɛ lo golurǝ. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Wǝ́ otoolutǝmumuŋpǝ we pǝ rɛ̀mɩ sɩkayǝ we wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Leh seyǝ loo kuŋ lǝ gʊŋrǝ lǝ fǝ sɩkayǝ sa la ka kʊla mǝ otukoonuyǝ rǝ Worokoyǝ la nyarǝwǝ. Duturǝ ɖi ŋpǝrayǝ la sɩkayǝ ŋ lǝǝwe.» <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Kǝ́ pǝ la tá sɩkayǝ sa le dierǝ pǝ la yɩrɩ pǝ la lɛ we, wǝ́ pǝ tɛ̀ɛ akaa wǝ́ pǝ fǝ̀ sɩkayǝ sa pǝ fùu kpɛɛyaatǝyǝ we la atɛɛkǝ. Wǝ́ pǝ fǝ̀ atɛɛkǝ we pǝ yeli ǝsǝǝpǝ la fɛɛŋwaaenyipǝ. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Wǝ kǝto po ro ruŋruŋ pǝ lóo pwo atɛɛkǝ sa ǝkǝnǝŋ: «Ŋpǝrayǝ la atɛɛkǝ.» <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Kǝ́ wǝ yeli wǝ́ worokokpɛɛnuŋtɛŋtǝyǝ Yeremiya le dietɛŋrǝ bǝlǝ wǝǝ. Tɛnɩ ǝkǝnǝŋ: «Pǝ la lɔ sɩkakpotokpotoyǝ we nǝ tǝta. Okuruyǝ Isǝrayɛlǝtǝpǝ pǝ nyɩnɩ ǝkǝnǝŋ nyiyǝ sa ŋ náa lɔ wǝǝ. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Wǝ́ pǝ fǝ̀ sɩkayǝ sa pǝ fùu kpɛɛyaatǝyǝ we la atɛɛkǝ mǝŋ kǝ́ Ǝtǝ Woroko ŋ tɛnɩ wǝ ŋ tìi mǝ wǝ.»<verse eid="MAT 27:10" /></para>
  <para style="s">Pilato lǝ pǝ́ Yesu le etieyǝ</para>
  <para style="r">(<ref loc="MRK 15:2-5">Marǝko 15:2-5</ref>, <ref loc="LUK 23:3-5">Luka 23:3-5</ref>, <ref loc="JHN 18:33-38">Yowanɛsɩ 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Wǝ́ pǝ fǝ̀ Yesu pǝ kolu kǝŋyɩrɩtǝyǝ Pilato la kǝnyɩŋkǝ. Wǝ́ kǝŋyɩrɩtǝyǝ sa ŋ pǝ̀ ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ e ri Oyudatǝpǝ le piliyǝ?» Wǝ́ Yesu ŋ yìili ŋ tìi ŋwǝ ǝkǝnǝŋ: «Ŋlǝ́ a ya láa tɛŋ wǝ.» <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Wǝla kǝmaakǝ wǝ́ otoolutǝmumuŋpǝ we mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ yà pǝ ka ŋ tɛŋ etieyǝ pǝ ŋ tɛ̀ɛ rǝ ŋwǝ. Paape lǝǝ kpǝlǝŋ pǝ! <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Wǝ́ Pilato ŋ kǝ ŋ pǝ́ ŋwǝ ǝkǝnǝŋ: «A laa ya lóo nuŋ etieyǝ sa kpǝlo kɩɩkɩ pǝ ya pǝ láa tɛŋ pǝ ŋ tɛɛ rǝ lǝ́ wǝ?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Paape Yesu lee tìi ne titi, lee tìi na mǝmwɛɛrɩ ŋ ru rǝ etieyǝ we ŋ pǝ̀ ŋwǝ la ɖɛ. Wǝ́ tuwǝ sa wǝ rili kǝŋyɩrɩtǝyǝ lo mumuŋ ŋpa.<verse eid="MAT 27:14" /></para>
  <para style="s">Pǝ la tɔɔ Yesu la gbɛŋpɔrǝ</para>
  <para style="r">(<ref loc="MRK 15:6-15">Marǝko 15:6-15</ref>, <ref loc="LUK 23:13-25">Luka 23:13-25</ref>, <ref loc="JHN 18:39-19:16">Yowanɛsɩ 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Eyinyapǝkǝ la wǝcɛ ri ŋ cɛ we, kǝŋyɩrɩtǝyǝ ke ŋ pi mǝ ŋ nyarǝ kukpɛɛtǝyǝ ceŋceŋ mǝ ŋ co, yǝ we kǝkpǝŋkǝ kǝ lǝ pǝ́ wǝ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Rǝ eniyǝ we mǝrǝ we, anyɩŋ kukpɛɛtǝyǝ rɛ ŋ no ru nyɩŋrǝ ke kpii rǝ we, pǝ lóo pwo ŋwǝ Baraba<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Wǝŋʊrʊkuukuurɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Yesu Baraba».</char></note> <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Wǝ́ Pilato ŋ pǝ̀ kǝkpǝŋkǝ we kǝ kù rǝ fɛɛwǝ we ǝkǝnǝŋ: «Ǝlǝ wǝ́ nǝ ya nǝ nyǝ́ǝ pǝ́ ŋ́ nyarǝ ŋ́ co ŋ́ koonu nǝ wǝ? Baraba amaa Yesu yǝ we pǝ lóo pwo Mesiyayǝ wǝ?» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Duturǝ ɖi Pilato ke cii wǝ sɩsiɛrɩ ǝkǝnǝŋ Oyudatǝmumuŋpǝ pǝ kpǝ̀lǝ Yesu lǝ kǝǝwǝ rǝ, wǝ kǝto pǝ fǝ̀ ŋwǝ pǝ pǝlǝ pǝ kpìi ŋwǝ rǝ akaakǝ wǝǝ. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Eniyǝ we Pilato ŋ tini rǝ fɛɛtɛŋakpaŋyǝ we, wǝ́ ne tie ŋ kpìi pǝ pe tíi ŋwǝ ǝkǝnǝŋ: «Pee yee mǝ nyikʊʊyǝ sa la tǝrɛ oo! Duturǝ ɖi dumurǝ sa we, ŋ́ na cʊʊrʊ ŋpa rǝ kǝtʊkpɛɛkǝ rǝ no yurǝ.»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Wǝ́ otoolutǝmumuŋpǝ we mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ kpìi nyikpǝŋwǝ we wǝ ka yaa lo otukoŋyǝ ǝkǝnǝŋ pǝ pǝ́ Pilato ŋ nyarǝ Baraba ŋ co kǝ pǝ wʊ Yesu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Wǝ́ kǝŋyɩrɩtǝyǝ we ŋ tǝ ŋ lɔ̀ɔ kpɛɛwǝ, wǝ́ ŋ tǝ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Pǝle eyi lǝ ǝlǝ wǝ́ nǝ nyǝ́ǝ pǝ ŋ́ nyarǝ ŋ́ co wǝ?» Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Baraba!» <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Wǝ́ Pilato ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ wǝ́ nǝ nyǝ́ǝ pǝ́ ŋ́ yee mǝ Yesu, yǝ we pǝ lóo pwo Mesiyayǝ wǝ?» Wǝ́ pǝlo kpǝlo kɩɩkɩ pǝ tɛnɩ ǝkǝnǝŋ: «Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Wǝ́ ŋ pǝ̀ pǝ ǝkǝnǝŋ: «Kǝ́ lo turɔɔrɔɔ wǝ́ ŋ ne yee?» Wǝ́ pǝ yà pǝ ko ŋ woolu mǝ okopiyǝ ǝkǝnǝŋ: «Kpaa ŋwǝ a maarǝ rǝ kpɛtɛkpǝlɛciiwǝ!» <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Kǝ́ Pilato ŋ na nyɩŋ ǝkǝnǝŋ tuyeewǝ rɛ wǝ lǝǝ tǝ wǝ kpii ŋwǝ we, wǝ́ enyipǝ pǝ tǝ pǝ ya pǝ láa nyɩɩ pǝ ŋ lɔ gasarǝ rǝ we, wǝ́ ŋ kolu ŋ fǝ̀ mɛŋwǝ wǝ́ ŋ nanǝ rǝ nyikpǝŋwǝ we la kǝnyɩŋkǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ sa la gbɛŋrǝ laa tɛɛ mǝ rǝ yu oo! Nǝ dierǝ lǝǝwe!» <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Wǝ́ kǝkpǝŋkǝ we kpǝlo kɩɩkɩ kǝ tà kǝ lɔ̀ ǝkǝnǝŋ: «Nyiyǝ sa la gbɛŋrǝ dɛɛ rǝ ŋlǝ mǝ leh epipǝ lo yurǝ!» <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Wǝ́ Pilato ŋ nyàrǝ Baraba ŋ cò ŋ kòonu pǝ. Wǝ́ ŋ kòonu pǝ cùlu Yesu mǝ fwɛɛpǝlawǝ. Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kpìi enyipǝ rǝ akaakǝ pǝ ka kpaa ŋwǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ.<verse eid="MAT 27:26" /></para>
  <para style="s">Otuusiitǝpǝ pǝ ya pǝ láa mɔɔnʊ Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Marǝko 15:16-20</ref>, <ref loc="JHN 19:2-3">Yowanɛsɩ 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Wǝ́ kǝŋyɩrɩtǝyǝ lo otuusiitǝpǝ pǝ fǝ̀ Yesu pǝ kolu ŋwǝ kǝŋyɩrɩtǝyǝ la fɛɛlǝwǝ. Wǝ́ otuusiitǝpǝ lǝ kpǝŋwǝ we kpǝlo kɩɩkɩ wǝ pǝlǝ wǝ cò wǝ kǝ̀rǝŋ ŋwǝ. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Wǝ́ pǝ wàla na wǝkpakpǝ, wǝ́ pǝ fǝ̀ nyaŋmwɛɛrɩrǝ rɛ pǝ sìi ŋwǝ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Wǝ́ pǝ fǝ̀ owuyǝ la alaŋyǝ pǝ yàa bilituurǝ pǝ sìi ŋwǝ rǝ yurǝ. Wǝ́ pǝ fǝ̀ gáarǝ lo toowǝ rɛ pǝ kpìi ŋwǝ rǝ kǝnirikaakǝ. Wǝ́ pǝ pǝlǝ pǝ kʊnʊ rǝ na kǝnyɩŋkǝ pǝ ka ŋ mɔɔnʊ ŋwǝ pǝ ŋ tɛŋ ǝkǝnǝŋ: «Yudatǝpiliyǝ, oru!» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Wǝ́ pǝ ko ŋ toopu dutomirǝ pǝ ŋ fieni ŋwǝ, wǝ́ pǝ kǝ ŋ fǝ gáarǝ we pǝ ca ŋwǝ rǝ yurǝ. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Kǝ́ pǝ la mɔɔnʊ ŋwǝ pǝ la lɛ we, wǝ́ pǝ wàla nyaŋrǝ we rǝ ŋwǝ, wǝ́ pǝ fǝ̀ ŋwǝŋwǝ na wǝkpakpǝ pǝ sìɛnɩ pǝ kpìi ŋwǝ. Wǝ́ pǝ fǝ̀ ŋwǝ pǝ ko ŋ ko pǝ ka kpaa pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ.<verse eid="MAT 27:31" /></para>
  <para style="s">Pǝ la kpaa Yesu pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ</para>
  <para style="r">(<ref loc="MRK 15:21-32">Marǝko 15:21-32</ref>, <ref loc="LUK 23:26-43">Luka 23:26-43</ref>, <ref loc="JHN 19:17-27">Yowanɛsɩ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Kǝ́ pǝ lo ru rǝ tǝŋtǝǝwǝ eni wǝ́ pǝ nyɩnɩ nyiyǝ rɛ ŋ no ru rǝ Sirɛnǝ wǝ. Ŋwǝ ŋ ri Sɩmɔ. Wǝ́ otuusiitǝpǝ we pǝ rǝ̀ǝrǝ Yesu la kpɛtɛkpǝlɛciiwǝ we pǝ tɛ̀ɛ ŋwǝ mǝ okopi mǝ okopi. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Wǝ́ pǝ kolu pǝ rò fɛɛwǝ we pǝ lóo pwo Golǝgata, wǝlo duturǝ wǝ ri «Yufoopiwǝ la fɛɛwǝ.» <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Wǝ́ pǝ fǝ̀ vɛŋyǝ pǝ la kʊla tuwǝ rɛ wǝ lǝǝmǝ kaawǝ pǝ kòonu Yesu ŋ ŋuŋ. Wǝ́ ŋ rà vɛŋyǝ we ŋ yɩ̀rɩ, laa tɛ̀ɛnɩ ŋ ŋuŋ ŋwǝ. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Wǝ́ pǝ kpàa ŋwǝ pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ. Wǝ́ pǝ cò eciiyǝ pǝ sǝ̀pǝ na wǝkpakpǝ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Wǝ́ pǝ sɔ̀ pǝ tini rǝ we pǝ kǝ ŋ rǝŋ ŋwǝ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pǝ ŋʊ̀rʊ tuwǝ wǝ lo kuŋ wǝ́ pǝ la tɔɔ Yesu la gbɛŋpɔrǝ pǝ tɛ̀ɛ rǝ no yuteewǝ. Pǝ ŋʊ̀rʊ ǝkǝnǝŋ: «Yǝ ǝnǝ ŋ ri Yesu, Oyudatǝpǝ le piliyǝ.» <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Otuusiitǝpǝ sa pǝ lɛ̀ pǝ kpàa enyiwʊʊlʊtǝpǝ rɛ eyi pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ rǝ Yesu la kǝlɛɛrɩkǝ. Ceŋceŋ rǝ ne kǝnirisiɛɛkǝ, ceŋceŋ rǝ na kǝpɛŋsiɛɛkǝ.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Enyipǝ we pǝ kǝ ŋ pǝ pǝ ŋ tɛlɩ rǝ fɛɛwǝ we we, pǝ ke ŋ tikili yurǝ wǝ́ pǝ ka ŋ fɛɛpɩ ŋwǝ <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />pǝ ŋ tɛŋ ǝkǝnǝŋ: «Ŋkǝ ŋlǝ́ a ka ŋ tɛŋ ŋlǝ́ a láa wɔɔ Worokoyǝ la nyarǝwǝ, kǝ a siɛnɩ a tɔ wǝ rǝ juu ta lǝ mǝrǝ? Ŋlǝ́ŋlǝ́ pɔrʊ lá wɛ mǝŋ Worokoyǝ le Pi wǝ́ e ri wǝ, kǝ a tɛlɩ a sʊʊ rǝ kpɛtɛkpǝlɛciiwǝ sa!» <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Kaa wǝǝ otoolutǝmumuŋpǝ, esekaŋtǝpǝ mǝ ǝtǝŋtǝǝtǝmumuŋpǝ ŋpǝ ŋkpɛ pǝ mɔ̀ɔnʊ Yesu ǝkǝnǝŋ: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«La lɔ lo kuŋ enyipǝ, paa lǝŋ koru alɔ ŋ koonu ŋwǝŋwǝ na wɛ! Ŋkǝ ŋwǝ ŋ ri Isǝrayɛlǝ le piliyǝ? We ŋ tɛlɩ ŋ sʊʊ rǝ kpɛtɛkpǝlɛciiwǝ sa rǝkǝsa kǝ la nya fɛɛ la lɔ ŋwǝ lo nuŋ. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />La tɛɛ kpɛɛwǝ rǝ Worokoyǝ wǝ́ ŋ na tɛŋ ǝkǝnǝŋ: “Ŋ́ ri Worokoyǝ le Piyǝ.” Mǝŋ Worokoyǝ láa taa nǝ kǝǝwǝ we, we ŋ lɔ ŋ koonu ŋwǝ ǝkǝ!» <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mǝŋ enyiwʊʊlʊtǝpǝ we eyipǝ pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ rǝ Yesu la kǝlɛɛrɩkǝ we, ŋpǝ ŋkpɛ pǝ ka ŋ fɛɛpɩ ŋwǝ Yesu!<verse eid="MAT 27:44" /></para>
  <para style="s">Yesu lǝ ǝkpǝ́kǝ</para>
  <para style="r">(<ref loc="MRK 15:33-41">Marǝko 15:33-41</ref>, <ref loc="LUK 23:44-49">Luka 23:44-49</ref>, <ref loc="JHN 19:28-30">Yowanɛsɩ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Kǝ́ cɔkɔŋyǝ ŋ ne tii zaarǝ we, wǝ́ kǝtǝǝwǝ kpǝlo wǝ fìi nuŋtumuwǝ ko ro ǝrǝ ɖiɔrǝ eniyǝ ta. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Kǝ́ wǝ lah ca eniyǝ ta we, wǝ́ Yesu ŋ cà narǝwǝ mǝ okopiyǝ ŋ tɛnɩ ǝkǝnǝŋ: «Eli, Eli, lema sabaktani?» Wǝlo duturǝ ɖi «Mǝ Worokoyǝ, mǝ Worokoyǝ, kǝ́ kǝto wǝ́ a la maa mǝ o lo co wǝ?» <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Kǝ́ epǝ we pǝ ka yaa rǝ fɛɛwǝ we la arɛɛpǝ pǝ lo nuŋ ŋwǝ we, wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Ya lóo pwo Eliya!» <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Kǝtǝrǝceŋceŋ wǝ́ pǝla rɛɛyǝ ŋ sùu ŋ kolu ŋ fǝ̀ tutuuwǝ ŋ tɛ̀kɛ rǝ vɛŋnyarǝyǝ wǝ́ ŋ fǝ̀ wǝ ŋ pàrǝ rǝ gáarǝ, wǝ́ ŋ fǝ̀ ŋ ko ŋ koonu ŋwǝ ŋ ŋuŋ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Paa wǝ́ enyituturupǝ pǝ ka ŋ tɛŋ ǝkǝnǝŋ: «Yaa kpɛŋ, yǝ láa nyɩŋ mǝŋ Eliya lǝ́ǝ pǝ ŋ pa lɔ ŋ koonu ŋwǝ wǝ!» <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Wǝ́ Yesu ŋ tǝ ŋ cà narǝmumuŋwǝ rɛ, wǝ́ ŋ kpǝ̀. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Rǝ eniyǝ we mǝrǝ we, wǝ́ nyaŋrǝ we pǝ fǝ̀ pǝ sǝnǝ fɛɛkenikeniwǝ we rǝ Worokoyǝ la nyarǝwǝ làrǝ kpee yi ru rǝ oŋuŋkǝ pa sʊʊ rǝ. Wǝ́ kǝtǝǝwǝ wǝ tìkili, wǝ́ orutɛɛyǝ yǝ nyàalǝ. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Wǝ́ ofuŋtɔŋyǝ yǝ tàanǝ wǝ́ alɔnuŋtǝpǝ wa pǝ lǝ kpǝ́ we, pǝ sàanǝ. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Kǝ́ Yesu ŋ na saanǝ ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ ŋ na lɛ we, wǝ́ alɔnuŋtǝpǝ we pǝ la saanǝ we, pǝ rù rǝ ofuŋtɔŋyǝ we. Wǝ́ pǝ fìi Yerusalɛmǝ tǝŋtǝǝkenikeniwǝ we lǝ mǝrǝ. Wǝ́ pǝ pɔ̀rʊ pǝla wɛ pǝ kanǝ enyipǝ wa. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Kǝ́ romatǝtuusiitǝmumuŋyǝ we mǝ otuusiitǝpǝ we pǝ yà pǝ kǝ ŋ rǝŋ Yesu pǝ la nyɩŋ kǝtǝǝtikiliwǝ sa mǝ otuyǝ we kpǝlo kɩɩkɩ yǝ pǝlǝ we, wǝ́ vurǝ vìi pǝ ŋpa. Wǝ́ pǝ tɛnɩ ǝkǝnǝŋ: «Nyiyǝ sa ke ri Worokoyǝ le Piyǝ kǝceece!» <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Etiepǝ wa pǝ ka yaa rǝ nɔ pǝ ka ŋ yɩrɩ pǝ ŋ maŋ. Pǝ sìimǝ Yesu ru ǝrǝ Galileya, wǝ́ pǝ ka ŋ yɩrɩ no yurǝ. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ŋpǝ etiepǝ sa la arɛɛpǝ pǝ kaamǝ: Marɩya ŋ no ru rǝ Magǝdala wǝ, Marɩya yǝ we ŋ ri Yakubu mǝ Yosɛfʊ le lee fǝ kʊla mǝ Zebede le tie.<verse eid="MAT 27:56" /></para>
  <para style="s">Yesu la aŋwaakǝ</para>
  <para style="r">(<ref loc="MRK 15:42-47">Marǝko 15:42-47</ref>, <ref loc="LUK 23:50-56">Luka 23:50-56</ref>, <ref loc="JHN 19:38-42">Yowanɛsɩ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ɖiɔrǝ we, wǝ́ sɩkalǝtǝyǝ rɛ pǝ lóo pwo Yosɛfʊ, ŋ no ru rǝ Arimata we, ŋ pǝlǝ ŋ rù. Nyiyǝ sa ŋwǝ ŋkpɛ ke ri Yesu lo tukarǝtǝyǝ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Wǝ́ ŋ kolu ŋ nyɩnɩ Pilato. Wǝ́ ŋ pǝ̀ Yesu le kǝnyiǝtǝkǝ we rǝ ŋwǝ. Wǝ́ Pilato ŋ tìi pǝ kǝ fǝ ŋwǝ pǝ koonu Yosɛfʊ. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Wǝ́ Yosɛfʊ ŋ lɔ̀ nyiǝtǝyǝ we. Wǝ́ ŋ fǝ̀ kɛlɛlɛŋwɛŋyǝ ŋ mùlu ŋwǝ. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Wǝ́ ŋ fǝ̀ ŋwǝ ŋ kolu ŋ ŋwàa rǝ ŋwǝŋwǝ no wǝfuŋŋwɛŋkpǝ ŋ kòonu pǝ nyini rǝ ɖutɛɛrǝ rɛ mǝrǝ pǝ kòonu ŋwǝ wǝ. Wǝ́ ŋ pǝ̀ǝlǝ ɖumumuŋrǝ rɛ ŋ tanǝ wǝfuŋkpǝ we lo nyuŋkpǝ. Wǝ́ ŋ pwɛ̀yɩ ŋ ko ŋ ko. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Marɩya ŋ no ru rǝ Magǝdala mǝ Marɩya yǝ eni pǝ ke tini rǝ fɛɛwǝ we, rǝ wǝfuŋkpǝ we la kǝnyɩŋkǝ.<verse eid="MAT 27:61" /></para>
  <para style="s">Otuusiitǝpǝ pǝ ya pǝ lǝ́ǝ rǝŋ wǝfuŋkpǝ we</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Gaalǝǝrǝkǝ we, wǝ ke ri jirǝ Oyudatǝpǝ pǝ láa kpaka sabatǝyǝ we, wǝ́ otoolutǝmumuŋpǝ mǝ Afarisitǝpǝ pǝ rù pǝ ko ŋ ko Pilato lǝ kpǝŋ fɛɛceŋceŋ. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Wǝ́ pǝ tìi ŋwǝ ǝkǝnǝŋ: «Mumuŋyǝ, yǝ láa taalǝ ǝkǝnǝŋ kǝ́ nyitǝǝnǝtǝyǝ sa ŋ ke kpii vɔrʊrǝ we, tɛnɩ ǝkǝnǝŋ: “Vǝ́ ŋ́ nǝ kpǝ́ we, rǝ juu ta lǝ mǝrǝ we, ŋ́ náa saanǝ.” <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Kǝto we, tíi otuusiitǝpǝ pǝ ka yaa pǝ ŋ rǝŋ wǝfuŋkpǝ we ko ro juutatǝrǝ. Mǝŋ ŋkǝ kaa wǝǝ, no otukarǝtǝpǝ we pǝ lóo koru a ka yɩɩ ne kǝnyiǝtǝkǝ we pǝ pwɛyɩ kǝ pǝ ŋ tɛŋ pǝ ŋ tíi kǝkpǝŋkǝ ǝkǝnǝŋ: “La saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ.” Kǝnyitǝǝnǝkǝ lǝ gǝ ǝnǝ we, kǝ lǝ́ǝ pǝlǝ kǝ teeri kǝsǝsǝŋkǝ we.» <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Wǝ́ Pilato ŋ tìi pǝ ǝkǝnǝŋ: «Otuusiitǝpǝ we pǝ lǝ́ǝ rǝŋ pǝ kaamǝ ǝpǝ ǝnǝ. Nǝ koonu pǝ rǝŋ wǝfuŋkpǝ we mǝŋ kǝ́ nǝ nya nyɩŋ wǝ láa kaamǝ wǝ.» <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Wǝ́ pǝ ko ŋ ko pǝ kolu pǝ kpàka kǝ́ pǝ lǝh mǝ rǝŋ wǝfuŋkpǝ we pǝ fǝ wǝ. Wǝ́ pǝ cà ɖurǝ we ga tanǝ rǝ wǝfuŋkpǝ we lo nyuŋkpǝ la baŋrǝ. Wǝ́ pǝ pɔ̀rʊ otuusiitǝpǝ pǝ tǝ̀nǝ pǝ ŋ rǝŋ kpǝ.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Yesu la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ</para>
  <para style="r">(<ref loc="MRK 16:1-10">Marǝko 16:1-10</ref>, <ref loc="LUK 24:1-12">Luka 24:1-12</ref>, <ref loc="JHN 20:1-10">Yowanɛsɩ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Sabatǝyǝ la gaalǝǝrǝkǝ, wǝ ri kɔsɩrayǝ lo ɖokoŋpirǝ we, wǝ́ Marɩya ŋ no ru rǝ Magǝdala wǝ, mǝ Marɩya yǝ eni we, pǝ kolu pǝ ka yɩrɩ vuŋtɔŋrǝ we. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Kǝtǝrǝceŋceŋ wǝ́ kǝtǝǝwǝ wǝ tìkili ŋpa duturǝ ɖi Ǝtǝ Woroko le picoŋpiyǝ rɛ rù rǝ yulaarǝ sʊ̀ʊ pǝlǝ pǝ̀ǝlǝ ɖurǝ we cɛ̀ wǝ́ ŋ sɔ̀ɔ ŋ tini rǝ rǝ. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Lée sie ŋaŋa mǝŋ ǝrǝsiekǝ kǝtǝ. Wǝ́ na wǝkpakpǝ wǝ ka kpɛɛlɩ fuu fitefite. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Wǝ́ vurǝ vìi otuusiitǝpǝ we pǝ kǝ ŋ rǝŋ wǝfuŋkpǝ we ŋpa, wǝ́ pǝ ka ŋ ca kpakpa, wǝ́ pǝ sìɛrɩ pǝ yeli mǝŋ pǝ lǝ kpǝ́ rǝ. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Wǝ́ picoŋpiyǝ we ŋ yìili ŋ ke ŋ tíi etiepǝ we ǝkǝnǝŋ: «Nǝ poo suu vurǝ! Ŋ́ cii ǝkǝnǝŋ nǝ ya nǝ nyáa taa Yesu, yǝ we pǝ la kpaa pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Lee kpii rǝ fɛɛwǝ sa. La saanǝ mǝŋ kǝ́ ŋ tɛnɩ wǝ kǝtǝ. Nǝ pǝ nǝ pa yɩrɩ fɛɛwǝ we ŋ ka kpɛlɩ re! <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Nǝ mǝ ko kalaŋ nǝ ke tíi no otukarǝtǝpǝ we ǝkǝnǝŋ: “La saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. Rǝkǝsa loh ko ŋ ka ya mǝ ŋ rǝŋ nǝ rǝ Galileya. Fɛɛwǝ nǝ nyah ka nyɩŋ ŋwǝ wǝǝ.” Dierǝ ŋ́ lǝǝmǝ ŋ́ née tíi nǝ wǝǝ.» <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Wǝ́ pǝ pwɛ̀yɩ rǝ wǝfuŋkpǝ we la fɛɛwǝ kalaŋ mǝ vu mǝ vu paape anyɩŋ pǝ la nyà faawǝ ŋpa. Wǝ́ pǝ sùu pǝ ko ŋ ko pǝ ke tíi Yesu lo otukarǝtǝpǝ we lǝ wǝ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Kǝtǝrǝceŋceŋ wǝ́ Yesu ŋ pǝlǝ ŋ kù mǝ pǝ wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Mǝ nǝ asaŋ!» Wǝ́ pǝ rùu pǝ kǝ̀lǝ mǝ ŋwǝ, wǝ́ pǝ tà na wǝkparǝkpǝ, wǝ́ pǝ sʊ̀ma ŋwǝ. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Wǝ́ Yesu ŋ tìi pǝ ǝkǝnǝŋ: «Nǝ poo suu vurǝ! Nǝ mǝ ko nǝ ke tíi mǝ apaanʊpǝ ǝkǝnǝŋ pǝ ŋ ko Galileya. Fɛɛwǝ pǝ lah ka nyɩŋ mǝ wǝǝ».<verse eid="MAT 28:10" /></para>
  <para style="s">Otuusiitǝpǝ we la amapɔyǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Eniyǝ we etiepǝ sa pǝ kpii pǝ lóo ko mǝ gʊŋrǝ we, wǝ́ otuusiitǝpǝ we pǝ kolu pǝ kǝ rǝŋ wǝfuŋkpǝ we la arɛɛpǝ pǝ sìɛnɩ pǝ pǝlǝ tǝŋtǝǝwǝ. Wǝ́ pǝ pǝlǝ pǝ fǝ̀ otuyǝ we kpǝlo kɩɩkɩ yǝ lǝ pǝ we, pǝ pɔ̀ otoolutǝmumuŋpǝ we la amayǝ. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Wǝ́ otoolutǝmumuŋpǝ we mǝ ǝtǝŋtǝǝtǝmumuŋpǝ pǝ kù, wǝ́ pǝ yeli nyuŋceŋceŋ. Wǝ́ pǝ fǝ̀ sɩkamumuŋyǝ rɛ pǝ kòonu otuusiitǝpǝ we. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Wǝ́ pǝ tìi pǝ ǝkǝnǝŋ: «Nǝ mǝ tɛŋ ǝkǝnǝŋ nyiyǝ sa lo otukarǝtǝpǝ we pǝ la pa yɩɩ ne kǝnyiǝtǝkǝ we mǝ dumurǝ, eniyǝ we yǝ la kpɛɛ wǝ. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Wǝ́ mǝŋ kǝŋyɩrɩtǝyǝ lo nuŋ wǝ we, yǝ láa pɔrʊ wǝlǝ mǝrǝ le tíi ŋwǝ kǝ nǝ paa nya fɛɛ nǝ fii rǝ dierǝ.» <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Wǝ́ otuusiitǝpǝ we pǝ lɔ̀ sɩkayǝ we. Wǝ́ pǝ yeli pǝ sanǝ mǝŋ kǝ́ pǝ tìi pǝ kǝtǝ. Wǝ́ dierǝ sa dò kpoo rǝ Oyudatǝpǝ lǝ mǝrǝ wǝ́ pǝ re dierǝ sa pǝ láa tɛŋ po ro ruŋruŋ le jirǝ sa.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesu la pɔrʊ na wɛ la kaŋ no otukarǝtǝpǝ wǝ́ ŋ ne kpii pǝ la anǝnɛyǝ</para>
  <para style="r">(<ref loc="MRK 16:14-18">Marǝko 16:14-18</ref>, <ref loc="LUK 24:36-49">Luka 24:36-49</ref>, <ref loc="JHN 20:19-23">Yowanɛsɩ 20:19-23</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Wǝ́ rǝkǝsa Yesu le enyikpiipǝ we pǝlǝ tǝ mǝ ceŋceŋ pǝ ko ŋ ko Galileya, rǝ dutupirǝ we Yesu ŋ kanǝ pǝ pǝ ŋ ko wǝ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Kǝ́ pǝ la nyɩŋ ŋwǝ we, wǝ́ pǝ sʊ̀ma ŋwǝ. Paape arɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ kǝ ŋ tǝmǝlǝ. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Wǝ́ Yesu ŋ rùu ŋ kǝ̀lǝ mǝ pǝ, wǝ́ ŋ tìi pǝ ǝkǝnǝŋ: «Worokoyǝ lǝ fǝ̀ okopiyǝ kpǝlo kɩɩkɩ rǝ yulaarǝ mǝ kǝtǝǝwǝ le kpii mǝ rǝ akaakǝ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Kǝto nǝ mǝ ko wǝkpǝŋkpǝ kpǝlo rǝ kǝtǝǝwǝ lǝ kpǝŋ, kǝ nǝ siɛrɩ pǝ nǝ yee mǝ otukarǝtǝpǝ. Nǝ wiiri pǝ lo worokomɛŋwǝ rǝ Tǝyǝ mǝ Piyǝ mǝ Wɛɛkenikenirǝ la nyɩŋrǝ mǝrǝ. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Nǝ kaŋ pǝ kǝ pǝ ŋ yee pǝ ŋ saŋ rǝ otuyǝ we kpǝlo kɩɩkɩ ŋ́ ne kpii nǝ nǝ mǝ yee wǝ. Nǝ ci wǝ ǝkǝnǝŋ ŋ́ kpii ŋ́ kʊla mǝ nǝ eciyǝ kpǝlo kɩɩkɩ ko ro ǝrǝ ǝrǝkǝ la alɛɛkǝ.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>