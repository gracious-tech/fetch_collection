<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">Akebou: La Bible en Akebou</book>
  <para style="h">2 Etesalonikatǝpǝ</para>
  <para style="toc3">2Et</para>
  <para style="toc2">2 Etesalonikatǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ Etesalonikatǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Etesalonikatǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ Etesalonikatǝpǝ kǝ kaamǝ gǝ ǝnǝ. Rǝ kǝfwɛɛyitǝkǝ sa lǝ mǝrǝ we, Pɔlʊ lǝ tǝ la wɛɛlɩ lo ru rǝ Yesu lǝ ǝpǝkǝ le tíi pǝ. Enyipǝ rɛ pǝ ke kpii rǝ Tesalonika pǝ ko ŋ pu wǝ ǝkǝnǝŋ Kǝriso lǝ pǝ la pa tɛlɩ. Arɛɛpǝ ŋpǝ paa ǝkǝnǝŋ fǝǝ pǝ, paape nǝ ǝpǝkǝ kǝ lǝ kǝlǝ, tuwǝ kǝto pǝ ka ŋ tɛŋ ǝkǝnǝŋ ŋpǝ pǝ ke yee anǝnɛyǝ oo, pǝ leh yee yǝ pǝ co rǝ. Kǝto pǝ lǝǝ tǝ pǝ ke ŋ yee tǝrɛ. Wǝ́ paa pǝ ko ŋ ko pǝ ŋ ri rǝ epǝ we pǝ ke ŋ yee anǝnɛyǝ lǝ kpǝŋ. Fɛɛwǝ Pɔlʊ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ pǝ kǝ ŋ fǝ ŋ toolu wǝlǝrɔɔrɔɔkpǝ we wǝ kǝ ŋ pǝ rǝ Etesalonikatǝpǝ la wǝcakukpǝ we mǝrǝ. Cìi kanǝ pǝ ǝkǝnǝŋ wǝ kaamǝ kǝ nyi ri ŋ nyi ŋ yee anǝnɛyǝ kǝ ŋ nya fɛɛ ŋ nya keeriwǝ ŋ née ri wǝ, kǝ pǝ lɛ pǝ tɔ pǝ yaa rǝ lɔnuŋrǝ, duturǝ ɖi Kǝriso faa maa ŋ pǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-2</para>
  <para style="io">- Wǝkpaŋtɛŋkpǝ mǝ Yesu Kǝriso le jirǝ we 1:3-12</para>
  <para style="io">- Otukaŋyǝ ru rǝ Yesu Kǝriso lǝ ǝpǝkǝ 2:1-12</para>
  <para style="io">- Atɔyaakǝ rǝ lɔnuŋrǝ 2:13-17</para>
  <para style="io">- Nyuŋmwɛŋkpǝ koonu Pɔlʊ mǝ nǝ ǝtǝŋpǝ 3:1-5</para>
  <para style="io">- Ecikaŋkǝ ru rǝ anǝnɛyeeyǝ 3:6-15</para>
  <para style="io">- Eceenikǝ 3:16-18</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">Pɔlʊ ya le ceeni ekǝrisotǝpǝ we pǝ kpii rǝ Tesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Ŋmǝ Pɔlʊ, ŋlǝ mǝ Silasǝ mǝ Timote yǝ la ŋʊrʊ kǝfwɛɛkǝ sa yǝ la maŋ asʊmatǝpǝ we pǝ kpii rǝ Tesalonika wǝ. Asʊmatǝpǝ sa pǝ ri lǝh Tǝ Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso la anɛŋ.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Lǝh Tǝ Worokoyǝ mǝ loh Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ koonu nǝ wǝtaarǝkpǝ.<verse eid="2TH 1:2" /></para>
  <para style="s">Wǝkpaŋtɛŋkpǝ mǝ Yesu Kǝriso le jirǝ we</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Lǝh ǝtǝŋ, wǝ kpii kǝ le mǝ ceeni Worokoyǝ eni ri ŋ ni rǝ nǝ yurǝ. Wǝ kaamǝ kǝ le yee wǝ mǝŋkɔɔwe, duturǝ ɖi nǝ lɔnuŋrǝ ya lóo ko kǝnyɩŋkǝ ŋpa, wǝ́ kǝǝtaawǝ we nǝ kpǝlo nǝ nyǝ fǝ nǝ nyo koonu awɛ we, wǝ ya wǝ láa ta wǝ ŋ kʊla. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Ŋ wǝ kǝto wǝ́ yǝ lǝ́ǝ fǝ nǝ yǝ ŋ faa faawǝ, wǝ́ yǝ láa tɛŋ nǝ tuwǝ rǝ Worokoyǝ la asʊmatuturuyǝ le enimiyǝ. Duturǝ ɖi nǝ ya nǝ nyáa cʊʊrʊ wǝ́ nǝ ya nǝ nyáa nyɩŋ ariaayǝ paape nǝ nya nyɩɩ nǝ nya tɔ nǝ yaa rǝ lɔnuŋrǝ.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Ŋyǝ acʊcʊʊrʊpiyǝ sa kpǝlo yǝ la pɔrʊ yǝ la kaŋ ǝkǝnǝŋ Worokoyǝ la wǝkpaŋtɛŋkpǝ wǝ kʊʊ. Duturǝ ɖi yǝ lóo koonu kǝ nǝ nya fɛɛ nǝ kaamǝ Worokoyǝ le wǝpilirikpǝ we. Ŋkpǝ wǝpilirikpǝ sa kǝto wǝ́ nǝ ya nǝ nyáa cʊʊrʊ wǝ. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Kǝceece Worokoyǝ kʊʊ. Kǝto lóo koonu acʊcʊʊrʊpiyǝ yǝ pǝ yǝ tuu epǝ we pǝ ya pǝ lée kpii nǝ acʊcʊʊrʊpiyǝ wǝ. <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />Paa ŋnǝ epǝ we nǝ ya nǝ nyáa cʊʊrʊ we, vǝ́ Kulǝtǝyǝ Yesu la pa nyɩnɩ rǝ yulaarǝ lǝ́ǝ pǝ ŋpǝ mǝ ne epicoŋpilɛnyɩpǝ we, Worokoyǝ lóo koonu nǝ diiwɛɛrǝ, kǝ ŋ koonu lǝ rǝ ŋla ŋkpɛ. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />Yesu lǝ́ǝ pǝ rǝ naawǝ rɛ wǝ ya wǝ láa ta pǝlapǝla lǝ mǝrǝ, kǝ ŋ pa ta enyipǝ lo kǝtukoŋkǝ. Ŋpǝ enyipǝ sa pǝ kaamǝ epǝ we pǝ lǝ sǝ́ŋ Worokoyǝ pǝ lo co wǝ́ pǝ lǝŋ yee pǝ saŋ rǝ loh Kulǝtǝyǝ Yesu le Dieceeceerǝ we ŋ nǝ pǝ mǝ wǝ. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Pǝlo tukoŋtawǝ wǝ kaamǝ acʊcʊʊrʊpiyǝ kǝkpakǝkpa. Pǝ lǝ́ǝ lǝǝrǝ mǝ Kulǝtǝyǝ mǝ na wǝnyɩɩnɩmumuŋkpǝ we lǝ kpǝŋ. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />Tuwǝ sa wǝ lǝ́ǝ pǝ mǝ eniyǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ wǝ. Jirǝ we we, epǝ we pǝ ri ŋwǝ Kulǝtǝyǝ la anɛŋpǝ wǝ́ pǝ la lɔ ŋwǝ pǝ lo nuŋ we, pǝ lǝ́ǝ kǝ ŋwǝ kǝ pǝ rɛɛrɩ mǝ ŋwǝ rǝ oŋuŋkǝ. Ŋnǝ ŋkpɛ nǝ nyah pa kʊla mǝ pǝ, duturǝ ɖi nǝ nya lɔ dierǝ we yǝ le tíi nǝ nǝ nyo nuŋ. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />Tuwǝ kǝto yǝ láa mwɛŋ nyuŋkpǝ yǝ ŋ koonu nǝ eni ri ŋ ni, kǝ loh Worokoyǝ ŋ nya fɛɛ ŋ koonu kǝ nǝ kaamǝ vɔrʊrǝ we ŋ no pwo nǝ nǝ pe tii wǝ. Ŋ saŋ rǝ no okopiyǝ kǝ ŋ koonu kǝ nǝ koru eyee wǝceeceekpǝ we nǝ nyǝ́ǝ pǝ́ nǝ yee wǝ, kǝ ŋ koonu kǝ nǝ lɔnuŋrǝ yee anǝnɛyǝ. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Mǝŋkǝsa we, nǝ nyáa rɛɛrɩ mǝ loh Kulǝtǝyǝ Yesu la nyɩŋrǝ, kǝ loh Kulǝtǝyǝ ŋwǝ ŋkpɛ ŋ rɛɛrɩ mǝ nǝ rǝ oŋuŋkǝ. Ŋ wǝ tuwǝ sa wǝ lée ri loh Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ la kǝnǝnɛkǝ.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Otuyǝ yǝ lǝ́ǝ pǝ yǝ coŋ yǝ koonu Yesu lǝ ǝpǝkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Lǝh ǝtǝŋ, rǝkǝsa ŋ́ nǝ pǝ́ ŋ́ wɛɛlɩ ŋ́ ru rǝ jirǝ we loh Kulǝtǝyǝ Yesu Kǝriso ŋ nǝ́ǝ pǝ wǝ, mǝ kǝ́ Worokoyǝ ŋ náa ca lǝ ŋ ku rǝ nǝ kpǝŋ wǝ. Yǝ lǝ pǝ́ yǝ lo ru rǝ nǝ kpǝŋ ǝkǝnǝŋ: <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />«Mǝŋ nyiyǝ rɛ le pe tíi nǝ ǝkǝnǝŋ Kulǝtǝyǝ le jirǝ we lo ro we», turuwǝ wǝ paa marǝ wǝ nya nǝ rɛ la mɛŋwǝ kǝ ŋ lǝǝ rǝ na wɛ lǝ mǝrǝ. Wǝ ke ce wǝ ri kpɛɛnuŋtɛŋtǝyǝ rɛ ŋ na pa tɛŋ wǝ amaa rɛ le dietɛŋrǝ amaa nyiyǝ rɛ ŋ na pa tɛŋ ǝkǝnǝŋ ŋlǝ yǝ la ŋʊrʊ wǝ yǝ le kpii rǝ kǝfwɛɛkǝ rɛ we, nǝ paa lɔ wǝ nǝ nuŋ. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Nǝ paa maa rɛ ŋ pǝ tǝǝnǝ nǝ mǝ wǝlǝkpǝ rɛ mǝŋ tɩ. Duturǝ ɖi kpɛŋ kǝ jirǝ we ji ǝpǝ we, enyipǝ pǝ lée yi pǝ tɛɛ rǝ Worokoyǝ ŋpa, kǝ nyirɔɔrɔɔyǝ we ŋ pɔrʊ na wɛ ŋ kaŋ. Ŋwǝ nyirɔɔrɔɔyǝ sa ŋ kpii ŋ koonu ǝkpǝ́nǝŋkǝ wǝ. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />Ŋwǝ nyirɔɔrɔɔyǝ sa leh pe yi ŋ tɛɛ rǝ tu ri ŋ tu enyipǝ pǝ láa nyɩŋ ǝkǝnǝŋ wǝ ri worokoyǝ wǝ́ pǝ láa sʊma wǝ, kǝ ŋ lɛ ŋ pe ke fii ŋ ke tii ǝrǝ Worokoyǝ la nyarǝwǝ, kǝ mǝ ŋ tɛŋ ǝkǝnǝŋ ŋwǝ ŋ ri Worokoyǝ. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />Nǝ nyǝŋ taalǝ ǝkǝnǝŋ ŋmǝ ŋ́ tìi nǝ ŋyǝ otuyǝ sa mǝ eniyǝ we ŋ́ kǝ tǝ ŋ́ kpii rǝ nǝ kpǝŋ wǝ? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Wǝ́ rǝkǝsa nǝ cii tuwǝ we wǝ ya wǝ lǝ́ǝ sǝŋ nyirɔɔrɔɔyǝ sa la gʊŋrǝ kǝ ŋ paa maa ŋ pǝ ko ro eniyǝ we pǝ lǝ tǝnǝ ŋwǝ kpɛŋ wǝ. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Nyirɔɔrɔɔyǝ we lo okopiyǝ we yǝ la ŋwaa we, yǝ marǝ yǝ ya yǝ lée yee anǝnɛyǝ. Vǝ́ nyiyǝ we ŋ ya ŋ nǝ́ǝ sǝŋ na gʊŋrǝ la pa cɛ we, o lóo turu lǝŋ tǝ ŋ yee tǝrɛ ŋ ŋwaa. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Eniyǝ we wǝ́ nyirɔɔrɔɔyǝ we ŋ náa pɔrʊ na wɛ ŋ kaŋ, kǝ Kulǝtǝyǝ Yesu ŋ furu ŋwǝ mǝ no nyuŋkpǝ ŋ wʊ. Yesu la wǝnyɩɩnɩkpǝ we mǝrǝ ŋ noh ru ŋ pǝ lo okopiyǝ yǝ lǝ́ǝ nǝǝnǝ ŋwǝ. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Nyirɔɔrɔɔyǝ we lǝ́ǝ pǝ mǝ Satana lo okopiyǝ, kǝ ŋ pa ya mǝ ŋ yee otumumuŋyǝ mǝ otucovurǝ kpookpookpoo mǝ ŋ tǝǝnǝ enyipǝ. <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />Lǝ́ǝ fǝ oturɔɔrɔɔyǝ kpǝlo le eyeekǝ ŋ tǝǝnǝ epǝ we pǝ lǝ lǝǝ cawǝ wǝ. Ŋpǝ enyipǝ sa pǝ lǝ lǝǝ cawǝ duturǝ ɖi pǝ lǝ sǝ́ŋ pǝ laa lɔ anʊkɔrǝyǝ we, wǝ́ pǝ laa lɛ pǝ taa ŋyǝ anʊkɔrǝyǝ sa lǝ kǝǝwǝ. Ŋyǝ yǝ kah pɔrʊ pǝ kaŋfɩ. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Ŋ wǝ kǝto wǝ́ Worokoyǝ ŋ nǝ fǝ ǝtǝǝnǝkǝ lo okopiyǝ ŋ na maŋ pǝ, kǝ pǝ nya fɛɛ pǝ ŋ lɔ rǝ niarǝ pǝ ŋ nuŋ. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />Mǝŋkǝsa we, epǝ we kpǝlo pǝ laa lɔ anʊkɔrǝyǝ we pǝ nuŋ, wǝ́ paa turɔɔrɔɔwǝ le eyeekǝ wǝ ranǝ mǝ pǝ we, Worokoyǝ láa tɔɔ pǝ la bɔrǝ.<verse eid="2TH 2:12" /></para>
  <para style="s">Nǝ tɔ nǝ yaa rǝ lɔnuŋrǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Lǝh ǝtǝŋ, ŋnǝ ǝpǝ we Kulǝtǝyǝ ŋ náa taa kǝǝwǝ we, wǝ kaamǝ kǝ ŋlǝ paa le mǝ ceeni Worokoyǝ eni ri ŋ ni rǝ nǝ yurǝ. Duturǝ ɖi Worokoyǝ la saa nǝ ǝrǝ ǝrǝkǝ lǝ kǝsǝŋkǝ kǝ ŋ pɔrʊ nǝ. La pɔrʊ nǝ saŋ rǝ kǝ́ Wɛɛkenikenirǝ lo koonu wǝ́ nǝ ya nǝ nyée tii vɔrʊkenikenirǝ, wǝ́ nǝ nya lɛ nǝ nya lɔ anʊkɔrǝyǝ we nǝ nyo nuŋ wǝ. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Tuwǝ sa kǝto wǝ́ Worokoyǝ ŋ no pwo nǝ saŋ rǝ Dieceeceerǝ we la tɛnɩ le tìi nǝ wǝ. Ŋwǝ Worokoyǝ lǝ pǝ́ nǝ pa kʊla mǝ loh Kulǝtǝyǝ Yesu Kǝriso la wǝnyɩɩnɩkpǝ we mǝrǝ. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Kǝto we, lǝh ǝtǝŋ, nǝ tɔ nǝ yaa kǝ nǝ mǝ ta otuyǝ we la kanǝ nǝ re kpoŋkpoŋ. Wǝ ke ce wǝ ri eyǝ we la wɛɛlɩ le tìi nǝ amaa eyǝ we la ŋʊ̀rʊ la manǝ nǝ wǝ.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Lǝh Tǝ Worokoyǝ la taa lǝ kǝǝwǝ, wǝ́ saŋ rǝ na lɛsiɛrɩwǝ we, la ta lǝ turulaalɛɛwǝ, wǝ́ ŋ na lɛ ŋ no koonu lǝ ǝrǝŋceeceekǝ. La ya yǝ lǝ́ǝ pǝ́ yǝ ŋ ru rǝ ŋpǝ mǝ loh Kulǝtǝyǝ Yesu Kǝriso ŋwǝŋwǝ lǝ kpǝŋ, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />pǝ kpii nǝ wɛɛlɛŋwǝ, kǝ pǝ koonu nǝ okopiyǝ kǝ nǝ nya fɛɛ nǝ mǝ yee wǝceeceekpǝ eni ri ŋ ni rǝ nǝ otuyeeyǝ mǝ nǝ awɛɛlɩkǝ lǝ mǝrǝ.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu lǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Rǝ kǝlɛɛkǝ we, lǝh ǝtǝŋ, nǝ mǝ mwɛŋ nyuŋkpǝ nǝ mǝ koonu lǝ, kǝ Kulǝtǝyǝ le dierǝ nya fɛɛ do fɛɛ ri ŋ fɛɛ kalaŋ, kǝ epǝ we pǝ lóo nuŋ dierǝ sa pǝ nya fɛɛ pǝ rɛɛrɩ mǝ rǝ rǝ oŋuŋkǝ mǝŋ kǝ́ nǝ yeli wǝ rǝ nǝ kpǝŋ wǝ. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Nǝ lɛ nǝ mǝ mwɛŋ nyuŋkpǝ kǝ Worokoyǝ ŋ pɔrʊ lǝ ŋ ru rǝ enyirɔɔrɔɔpǝ mǝ oyulɛnyɩtǝpǝ la akaakǝ. Duturǝ ɖi ŋkǝ nyi ri ŋ nyi ŋ na lɔ Worokoyǝ ŋ no nuŋ.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />Paa we, nʊkɔrǝlǝtǝyǝ wǝ́ Kulǝtǝyǝ ŋ ri, lée kpii nǝ okopiyǝ, kǝ ŋ lɛ ŋ pɔrʊ nǝ rǝ Abʊŋsamʊyǝ we la akaakǝ. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Kulǝtǝyǝ lo koonu wǝ́ yǝ láa tɛɛ kpɛɛwǝ rǝ nǝ ǝkǝnǝŋ nǝ ya nǝ nyée yee otuyǝ we yǝ le tíi nǝ wǝ. Wǝ́ nǝ nyée re nǝ ya nǝ mǝ yee yǝ ke. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Kulǝtǝyǝ Yesu Kǝriso ŋ re nǝ ziɔŋrǝ kǝ nǝ nya fɛɛ nǝ tɔ nǝ ya mǝŋ ŋwǝ kǝtǝ, kǝ nǝ lɛ nǝ mǝ taa Worokoyǝ lǝ kǝǝwǝ,<verse eid="2TH 3:5" /></para>
  <para style="s">Wǝ kaamǝ kǝ nyi ri ŋ nyi ŋ yee anǝnɛyǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Lǝh ǝtǝŋ, la ya yǝ lǝ́ǝ pǝ́ yǝ ŋ ru rǝ nǝ akaakǝ rǝ Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ ǝkǝnǝŋ we, nǝ ruu nǝ ru rǝ apaanʊpǝ we amaa apaatɛpǝ we pǝ lée yee fanaciwǝ, wǝ́ pǝ lǝŋ lɛ pǝ yee pǝ saŋ rǝ otuyǝ we la kanǝ pǝ wǝ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Ŋnǝ paa we, nǝ marǝ nǝ cii kǝ́ nǝ nyáa karǝ lǝ nǝ fǝ wǝ. Duturǝ ɖi kǝ́ le ke kpii rǝ nǝ kpǝŋ we, yǝ lee yee fanaciwǝ. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Yǝ lǝǝ pǝ pǝ́ rɛ ŋ koonu lǝ keeriwǝ le ri. Paa ŋlǝŋlǝ la ka ŋ nyɩɩ yǝ ŋ yee anǝnɛyǝ yǝ ŋ nyɩŋ ariaayǝ mǝŋ dumu mǝŋ jɔkɔŋ, kǝ la paa nya fɛɛ le yee eleeyǝ la tɛɛ rǝ nǝ rɛ. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Kaŋfɩ wǝ ke kpii wǝ koonu nǝ kǝ nǝ yɩrɩ lǝ yurǝ paape yǝ lǝǝ pǝ́ nǝ wǝ la rɛ. Le ke ŋ yee anǝnɛyǝ ǝnǝ kǝ lǝ fǝ la kaŋ nǝ anyɩŋcamǝkǝ rǝ. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Duturǝ ɖi kǝ́ le ke kpii rǝ nǝ kpǝŋ we, la ka ŋ tɛŋ wǝ yǝ ŋ tìi nǝ kpuŋkpuruŋ ǝkǝnǝŋ: «Yǝ we ŋ nǝŋ pǝ́ ŋ yee anǝnɛyǝ we, ŋ pee ri».<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Duturǝ ɖi la ya yǝ lóo nuŋ ǝkǝnǝŋ enyipǝ rɛ pǝ kpii rǝ nǝ mǝrǝ pǝ lée yee fanaciwǝ. Pǝ lǝŋ yee anǝnɛyǝ rɛ, paa tuwǝ we wǝ lǝǝ fǝ pǝla fɛɛwǝ rɛ we, ŋ wǝ wǝ́ pǝ lée kpii nyuŋkpǝ wǝ. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />La ya yǝ lǝ́ǝ pǝ́ yǝ ŋ ru rǝ ŋpǝ enyipǝ sa lǝ kpǝŋ wǝ́ la ya yǝ lée ci yǝ ŋ kaŋ pǝ ǝkǝnǝŋ rǝ Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ, pǝ taarǝ pǝ yee anǝnɛyǝ kǝ pǝ nya fɛɛ pǝ nya keeriwǝ pǝ lée ri wǝ.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />Ŋnǝ paa we, lǝh ǝtǝŋ, nǝ paa faŋ mǝ wǝceeceekpǝ le eyeekǝ. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Mǝŋ rɛ lǝ sǝ́ŋ ŋ nǝŋ yee ŋ saŋ rǝ etieyǝ sa yǝ la ŋʊrʊ yǝ le kpii rǝ kǝfwɛɛkǝ sa we, nǝ saarǝ ŋwǝ kǝ nǝ pǝǝ tǝ nǝ saŋ mǝ ŋwǝ, kǝ ŋ nya fɛɛ ŋ fii nʊŋsɔɔwǝ. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Paape nǝ pǝǝ fǝ ŋwǝ mǝŋ kǝǝkpǝlǝtǝyǝ kǝtǝ. Nǝ kpaŋ mǝ ŋwǝ mǝŋ kǝ́ nyiyǝ ŋ náa kpaŋ mǝ na paanʊyǝ kǝtǝ.<verse eid="2TH 3:15" /></para>
  <para style="s">Wǝpɛɛrɩkpǝ mǝ eceenikǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Ǝtǝ Woroko, yǝ we ŋ nóo koonu wǝtaarǝkpǝ, ŋwǝŋwǝ ŋ koonu nǝ wǝtaarǝkpǝ rǝ tu ri ŋ tu lǝ mǝrǝ eni ri ŋ ni. Ǝtǝ Woroko ŋ tii ŋ kʊla mǝ nǝ kpǝlo.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Kǝfwɛɛkǝ sa la fɛɛwǝ sa pǝ ya pǝ lée ceeni nǝ we, ŋmǝ Pɔlʊ, ŋmǝŋmǝ ŋ́ na ŋʊrʊ wǝ mǝ mǝ akaakǝ. Rǝ mǝ wǝfwɛɛkpǝ kpǝlo lǝ mǝrǝ we, kǝ́ ŋ́ náa ŋʊrʊ wǝǝ. Mǝ otuŋʊrʊyǝ yǝ lǝǝwe. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />Loh Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ kpǝlo.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>