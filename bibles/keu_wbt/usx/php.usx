<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">Akebou: La Bible en akebou</book>
  <para style="h">Efilipitǝpǝ</para>
  <para style="toc3">Efi</para>
  <para style="toc2">Efilipitǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ Efilipitǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Efilipitǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ tǝ̀nǝ zʊmarǝ rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Filipi wǝ. Tǝŋtǝǝwǝ sa wǝ kpii rǝ Ehelatǝpǝ lǝ gǝŋrǝ rǝ Makedonia la gaarǝ. Filipi la zʊmarǝ sa ɖi zʊmasǝsǝŋrǝ Pɔlʊ ŋ tǝ̀nǝ rǝ Bwerenikǝŋrǝ wǝ. Kǝfwɛɛkǝ sa Pɔlʊ ŋ ŋʊ̀rʊ ŋ manǝ ekǝrisotǝpǝ we pǝ kpii rǝ Filipi we, kǝ la pɔrʊ kǝloŋceeceekǝ we kǝ ke kpii rǝ Pɔlʊ mǝ kǝkpǝŋkǝ sa lǝ mǝrǝ kǝ la kaŋ. Pɔlʊ ke kpii rǝ gukpɛɛkpǝ wǝ́ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa. Rǝ eniyǝ we mǝrǝ we anyɩŋ ekǝrisotǝrɛɛpǝ pǝ le yi pǝ ya pǝ láa kaŋ otuyǝ mǝ oyupurɔɔrɔɔyǝ rɛ rǝ zʊmarǝ sa mǝrǝ. Wǝ́ tuwǝ sa wǝ kpìi Pɔlʊ la awɛɛlɩkǝ. Rǝ kǝfwɛɛkǝ sa mǝrǝ we, Pɔlʊ cèeni alɔnuŋtǝpǝ we pǝ kpii rǝ Filipi mǝ kǝ́ pǝ tonu ŋwǝ pǝ manǝ wǝ. Wǝ́ ŋ lɛ̀ ŋ cìi ŋ kanǝ pǝ wǝ́ ŋ tà pǝlo turuwǝ rǝ pǝla lɔnuŋrǝ.</para>
  <para style="ip">Pɔlʊ wɛ̀ɛlɩ rù rǝ Kulǝtǝyǝ Yesu la vɔrʊrǝ mǝ na gbɛŋrǝ tìi pǝ (<char style="xt"><ref loc="PHP 2:6-11">2:6-11</ref></char>). Yesu nyàrǝ tu ri ŋ tu ŋ cò. Tuwǝ sa kǝto wǝ́ Worokoyǝ ŋ na rɛɛrɩ mǝ ŋwǝ ŋ ne teeri tu ri ŋ tu, mǝ nyi ri ŋ nyi wǝ. Kaa wǝǝ Pɔlʊ ŋwǝ ŋkpɛ ŋ na nyarǝ na afasʊtuyǝ we ŋ kǝ lǝǝmǝ ŋ no co wǝǝ. Wǝ́ ŋ na tɛɛnɩ ŋ cʊʊrʊ ŋ koonu Yesu Kǝriso. Ŋ kǝ mǝ kpǝ́ oo, wǝ lǝŋ tíi na tǝrɛ, duturǝ ɖi lǝǝmǝ kpɛɛtɛɛwǝ ǝkǝnǝŋ jirǝ rɛ gbii lǝ́ǝ pǝ, ŋwǝ ŋ nah pa saanǝ ŋ ru rǝ gbɛŋrǝ lǝ mǝrǝ.</para>
  <para style="ip">Wǝ́ Pɔlʊ ŋ ne ci ŋ na kaŋ Efilipitǝpǝ pǝ karǝ ŋwǝ (<char style="xt"><ref loc="PHP 3:17-4:9">3:17–4:9</ref></char>).</para>
  <para style="ip">Pɔlʊ la ta Efilipitǝpǝ lo turuwǝ ǝkǝnǝŋ pǝ tii vɔrʊrǝ mǝ faawǝ. Vǝ́ ekǝrisotǝpǝ pǝ le yee nyiceŋceŋ mǝ Kulǝtǝyǝ Yesu we, wǝ ke ce wǝ ri pǝ kpii rǝ gbaraarǝ mǝrǝ we, pǝ láa nya faawǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1-11</para>
  <para style="io">- Pɔlʊ la arianyɩŋyǝ 1:12-26</para>
  <para style="io">- Vɔrʊtiirǝ rǝ nyuŋceŋceŋkpǝ mǝ Kǝriso 1:27–2:18</para>
  <para style="io">- Pɔlʊ lo yupurǝ ŋ ne yee rǝ Timote mǝ Epafǝroditǝ lo oŋuŋkǝ 2:19-30</para>
  <para style="io">- Ecikaŋkǝ ru rǝ ǝkǝǝkpǝlǝtǝpǝ mǝ otuyǝ we yǝ lóo co vurǝ wǝ 3:1–4:9</para>
  <para style="io">- Pɔlʊ mǝ ne epwetapǝ rǝ Filipi 4:10-20</para>
  <para style="io">- Pɔlʊ le etietuturuyǝ 4:21-23</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Ŋmǝ Pɔlʊ, ŋlǝ mǝ Timote, Yesu Kǝriso la asʊmatǝpǝ wǝ́ le ri. Yǝ la ŋʊrʊ kǝfwɛɛkǝ sa yǝ la maŋ ŋnǝ epǝ we kpǝlo nǝ ri Worokoyǝ la anɛŋpǝ rǝ Filipi saŋ rǝ Yesu Kǝriso wǝ. Kǝfwɛɛkǝ sa kǝ ko zʊmarǝ le eretǝpǝ lǝ kpǝŋ mǝŋ zʊmarǝ la anyɩŋyaatǝpǝ lǝ kpǝŋ. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />Lǝh Tǝ Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso, pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ koonu nǝ wǝtaarǝkpǝ.<verse eid="PHP 1:2" /></para>
  <para style="s">Eceenikǝ mǝ nyuŋmwɛŋwǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Eni ri ŋ ni vǝ́ ŋ́ na nya ŋ́ na taalǝ nǝ we, e mǝ ŋ mǝ ceeni mǝ Worokoyǝ. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />Eni ri ŋ ni vǝ́ ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ ŋ koonu nǝ kpǝlo we, a mǝ ŋ mǝ mwɛŋ kpǝ mǝ faawǝ. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />Duturǝ ɖi nǝ nyóo toŋ mǝ rǝ Dieceeceerǝ we la atɛŋkǝ fǝ rǝ jisǝsǝŋrǝ we po ro ruŋruŋ. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Tuwǝ ŋ́ cii sɩsiɛrɩ wǝ kaamǝ wǝ ǝnǝ: Worokoyǝ we ŋ ne tie kǝnǝnɛkpatɩkǝ sa rǝ nǝ mǝrǝ we, lée re kǝ mǝ ŋ yee kǝ ŋ ka lɛ kǝ rǝ, ǝrǝ Yesu Kǝriso le jirǝ we ŋ nǝ́ǝ pǝ wǝ. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Wǝ kaamǝ kǝ ŋ́ pu yuceeceerǝ sa ŋ́ tɛɛ rǝ nǝ kpǝlo. Duturǝ ɖi ŋ́ náa ta nǝ kǝǝwǝ ŋpa. Kǝceece, nǝ kʊla rǝ lɛsiɛrɩwǝ we Worokoyǝ ŋ ne yee mǝ wǝ. Duturǝ ɖi wǝ ke ce wǝ ri rǝ gukpɛɛkpǝ oo, wǝ ke ce wǝ ri rǝ Dieceeceerǝ we la akɔɔlʊkpiikǝ amaa rǝla atɛŋkǝ oo, nǝ nyóo toŋ mǝ. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Awo, Worokoyǝ cii wǝ ǝkǝnǝŋ kǝceece Yesu Kǝriso lǝ kǝǝtaawǝ we wǝ́ ŋ́ nǝ fǝ ŋ́ na taa nǝ. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />Ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ kǝ Worokoyǝ ŋ koonu kǝ nǝ kǝǝtaawǝ wǝ naanǝ wǝ kʊla ŋpa, kǝ nǝ nyɩŋ anʊkɔrǝyǝ nǝ ci, kǝ nǝ lɛ nǝ nuŋ otuyǝ lo duturǝ sɩsiɛrɩ. <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />Eniyǝ we nǝ nyée ci tuwǝ we wǝ ponu wǝ teeri wǝ. Mǝŋkǝsa we, jirǝ we Kǝriso ŋ nǝ́ǝ pǝ we, nǝ nyǝ lǝ kenikeni, wǝ́ pǝ lǝŋ lɛ pǝ nyɩŋ turɔɔrɔɔwǝ rɛ pǝ tɛŋ pǝ ru rǝ nǝ. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Nǝ anǝnɛkʊʊyǝ yǝ láa naanǝ. Enyipǝ pǝ láa rɛɛrɩ mǝ Worokoyǝ rǝ oŋuŋkǝ, kǝ pǝ kǝ ŋwǝ saŋ rǝ yǝ. Ŋyǝ anǝnɛyǝ sa we, Yesu Kǝriso ŋ née yee yǝ.<verse eid="PHP 1:11" /></para>
  <para style="s">Dieceeceerǝ we ya lóo ko kǝnyɩŋkǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Lǝh ǝtǝŋ, ŋ́ nǝ pǝ́ nǝ ci wǝ ǝkǝnǝŋ tuwǝ we wǝ lǝ pǝ wǝ lo tu mǝ we, wǝ lo toŋ kǝ Dieceeceerǝ we go kǝnyɩŋkǝ rǝ. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Duturǝ ɖi kǝŋyɩrɩtǝyǝ we lǝ ǝrǝŋtǝpǝ kpǝlo mǝŋ enyipʊŋpwapǝ kpǝlo pǝ le ci wǝ rǝkǝsa ǝkǝnǝŋ Kǝriso kǝto wǝ́ pǝ la lɔ mǝ pǝ la taŋ wǝ. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Kǝ́ ekǝrisotǝpǝ la kǝtamumuŋkǝ pǝ la nyɩŋ ǝkǝnǝŋ ŋmǝ ŋ́ kpii rǝ gukpɛɛkpǝ we, wǝ́ pǝ tɛ̀ɛ kpɛɛwǝ ŋpa rǝ Kulǝtǝyǝ. Wǝ́ pǝ tǝ pǝ nyà okopiyǝ pǝ kʊ̀la pǝ ka ŋ tɛŋ Worokoŋtierǝ vu lee kpii. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />Rǝ anʊkɔrǝyǝ we, arɛɛpǝ pǝ kpii rǝ pǝlǝ mǝrǝ pǝ ya pǝ láa tɛŋ Worokoŋtierǝ we pǝ ŋ mwɛɛrɩ nimirǝ rǝ mǝ. Wǝ́ pǝ ya pǝ lǝ́ǝ pǝ́ pǝ yi pǝ tɛɛ rǝ mǝ. Paa arɛɛpǝ pǝ ya pǝ láa tɛŋ rǝ mǝ ziɔŋceeceerǝ. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Ŋpǝ we, kǝǝtaawǝ kǝto wǝ́ pǝ ya pǝ lée yee wǝ ǝnǝ. Duturǝ ɖi pǝ cii wǝ ǝkǝnǝŋ mǝ kǝnǝnɛkǝ wǝ kaamǝ ǝkǝnǝŋ ŋmǝ ŋ́ kɔɔlʊ ŋ́ kpii Dieceeceerǝ we. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Paa ǝsǝsǝŋpǝ we lo tuwǝ ŋ́ na tɛŋ ŋ́ na pa tɛlɩ we, pǝ laa ya pǝ láa tɛŋ Kǝriso le dierǝ mǝ ziɔŋceeceerǝ. Pǝ ya pǝ láa tɛŋ rǝ kǝ pǝ fǝ pǝ teeri pǝlǝ ǝtǝŋpǝ rǝ. Pǝ lo pu wǝ ǝkǝnǝŋ pǝ lǝ́ǝ tǝ pǝ ŋ kpii mǝ vuurǝ pǝ kʊla rǝ gukpɛɛkpǝ sa. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Paape wǝ lǝŋ yee mǝ tǝrɛ. Oyupuyǝ we pǝ lǝ fǝ pǝ ya pǝ láa tɛŋ Worokoŋtierǝ we yǝ ke ri oyupuceeceeyǝ oo amaa oyupurɔɔrɔɔyǝ oo, tuwǝ wǝ ya wǝ lóo poŋ mǝ mǝ wǝ kaamǝ ǝkǝnǝŋ enyipǝ pǝ ya pǝ lóo nuŋ Kǝriso le dierǝ. Wǝ́ ŋ́ née re ŋ́ ya mǝ ŋ nya faawǝ rǝ ko. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />Duturǝ ɖi ŋ́ cii wǝ ǝkǝnǝŋ ŋyǝ otuyǝ sa kpǝlo yǝ lah pa pɔrʊ mǝ<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Pǝ lóo koru onuŋ wǝ lo duturǝ ǝkǝnǝŋ: Yǝ lóo kuŋ kǝ ŋ́ nya alɔkuŋkǝ.</char></note> rǝ gukpɛɛkpǝ sa saŋ rǝ nǝ onyuŋmwɛŋyǝ mǝ Yesu Kǝriso la Wɛɛrǝ lo otoŋkǝ. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Tuwǝ we ŋ́ ya ŋ́ nǝ́ǝ rǝŋ, wǝ́ ŋ́ ya ŋ́ náa tɛɛ kpɛɛwǝ kpuŋkpuruŋ wǝ kaamǝ ǝkǝnǝŋ ŋ́ pee fii nʊŋsɔɔwǝ. Paa kǝ ŋ́ tɛɛ kpɛɛwǝ ŋpa, kǝ ruŋruŋ mǝ soosowǝ sa wǝ lo furu we, enyipǝ pǝ pa nyɩŋ wǝ rǝ mǝ ǝkǝnǝŋ Kǝriso naanǝ, wǝ ke ri rǝ mǝ vɔrʊrǝ le eniyǝ amaa rǝ mǝ gbɛŋrǝ la kǝmaakǝ. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Duturǝ ɖi rǝ ŋmǝ mǝ kpǝŋ we, mǝŋ ŋ́ kpii vɔrʊrǝ we, ŋ́ kpii vɔrʊrǝ ŋ́ koonu Kǝriso lǝ ǝkǝkǝ, wǝ́ gbɛŋrǝ ɖi mǝ vasʊyǝ. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Paape mǝŋ ŋ́ née tii vɔrʊrǝ rǝ kǝtǝǝwǝ sa, kǝ ŋ́ tǝ ŋ́ yee kǝnǝnɛceeceekǝ we, we ŋ́ nee ci tuwǝ we ŋ́ náa pɔrʊ rǝ gbɛŋrǝ mǝ vɔrʊrǝ lǝ mǝrǝ. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Ŋ́ kpii rǝ wǝle yi le kǝtiitiikǝ, ŋ́ nee ci wǝ ŋ́ nǝh fǝ. Ŋmǝ paa we, wǝ ya wǝ láa ca mǝ kpɛɛ ŋ́ pwɛyɩ ŋ́ ke tii rǝ Kǝriso lǝ kpǝŋ. Wǝ lóo poŋ wǝ teeri. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />Paape rǝ nǝ yurǝ kǝto we, vǝ́ ŋ́ ne tii vɔrʊrǝ rǝ kǝtǝǝwǝ sa we, wǝ lóo poŋ wǝ teeri. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Kǝ́ ŋ́ na lɔ wǝ ŋ́ no nuŋ kǝto we, ŋ́ cii wǝ ǝkǝnǝŋ ŋ́ née tii. Ŋ́ née tii rǝ nǝ kpǝlo lǝ kpǝŋ kǝ ŋ́ nya fɛɛ mǝ ŋ toŋ nǝ kǝ nǝ ko kǝnyɩŋkǝ, kǝ nǝ lɛ nǝ nya faawǝ rǝ lɔnuŋrǝ. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Mǝŋkǝsa we, vǝ́ ŋ́ na siɛnɩ ŋ́ no po tuu nǝ we, nǝ nyǝ́ǝ tǝ nǝ nya faawǝ nǝ kʊla rǝ Yesu Kǝriso lǝ mǝrǝ rǝ mǝ yurǝ.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ kaamǝ ǝkǝnǝŋ nǝ re nǝ wɛ nǝ kaa mǝ Kǝriso le Dieceeceerǝ we. Mǝŋkǝsa we, ŋ́ ke ce ŋ́ pǝ nǝ kpǝŋ amaa ŋ́ nǝǝ pǝ nǝ kpǝŋ oo, ŋ́ nóo nuŋ wǝ rǝ nǝ ǝkǝnǝŋ ŋnǝ nǝ nyǝ́ǝ fǝ yupurǝ jeŋceŋ nǝ nya tɔ nǝ yaa kiŋkiŋ. Wǝ́ nǝ nyǝ fǝ ziɔŋrǝ jeŋceŋ nǝ ya nǝ nyáa fia nyǝ ŋ koonu lɔnuŋrǝ we gbii rǝ Dieceeceerǝ we lǝ mǝrǝ wǝ. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Nǝ paa maa nǝ ǝkǝǝkpǝlǝtǝpǝ pǝ cɩɩlɩ nǝ. Mǝŋ nǝ nye yee wǝ ǝnǝ we, wǝ láa pɔrʊ wǝ kaŋ pǝ ǝkǝnǝŋ pǝ lǝ lǝǝ, kǝ wǝ pɔrʊ wǝ kaŋ ŋnǝ paa ǝkǝnǝŋ nǝ nya nya alɔkuŋkǝ. Worokoyǝ ŋ ne yee wǝ ǝnǝ. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Duturǝ ɖi ŋwǝ Worokoyǝ ŋ ne yee nǝ lɛsiɛrɩwǝ kǝ nǝ sʊma Kǝriso, ŋkǝ kǝ nǝ pa lɔ ŋwǝ nǝ nuŋ ko. Paa kǝ nǝ lɛ nǝ nyɩŋ ariaayǝ rǝ no yurǝ. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Rǝkǝsa we, ŋnǝ ŋkpɛ nǝ nye pe fii akɔŋkǝ we lǝ mǝrǝ nǝ nya kʊla mǝ mǝ. Akɔŋkǝ sa wǝ́ ŋ́ ke ŋ yee eniyǝ nɔ, wǝ́ nǝ ka ŋ nyɩŋ mǝ. Ŋ́ tǝ ŋ́ re akɔŋkǝ sa ŋ́ ya mǝŋ kǝ́ nǝ cii wǝ wǝ.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Yesu la pɛɛlɩ na wɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Mǝŋkǝ kǝ́ nǝ nye yee nyuŋceŋcǝŋ mǝ Kǝriso kǝto wǝ́ nǝ nya nya turutawǝ? Mǝŋkǝ kǝ́ Kǝriso ŋ na taa nǝ kǝǝwǝ kǝto wǝ́ wǝ le kpii nǝ wɛɛlɛŋwǝ? Mǝŋkǝ na Wɛɛrǝ lǝ fǝ nǝ le yee nyiyǝ ceŋceŋ, kǝto wǝ́ nǝ nyée yee awɛ la lɛsiɛrɩwǝ, wǝ́ nǝ nyáa lɛ nǝ nyǝ ŋ nyɩŋ awɛ la tǝlarǝwǝ? <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />We rǝkǝsa we, nǝ yee nyuŋceŋceŋ kǝ nǝ nya fɛɛ nǝ koonu kǝ ŋ́ nya faawǝ ŋpa. Nǝ taa awɛ lǝ kǝǝwǝ, kǝ nǝ ziɔŋrǝ lǝ jeŋceŋ, kǝ nǝ yupurǝ ŋre lǝ jeŋceŋ. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Nǝ rɛ ŋ pee yee tǝrɛ kǝ ŋ fǝ ŋ faa nǝ ǝtǝŋpǝ amaa ŋ fǝ ŋ rɛɛrɩ mǝ na wɛ. Paa we, nǝ yee tuwǝ mǝ wɛɛpɛɛlɩwǝ, kǝ nǝ nyɩŋ nǝ ǝtǝŋpǝ mǝŋ pǝ teeri nǝ kǝtǝ. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Nǝ rɛ ŋ paa mǝ taa rǝ ŋwǝŋwǝ na vasʊyǝ ko, paa ŋ taa mǝŋ otuturupǝ la vasʊyǝ. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Nǝ maa kǝ wǝlǝkpǝ we wǝ ke kpii rǝ Yesu Kǝriso lǝ mǝrǝ we, wǝ kpii rǝ ŋnǝ ŋkpɛ nǝ mǝrǝ.<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />Ŋwǝ Yesu Kǝriso kǝ lǝǝmǝ Worokoyǝ lǝ wǝlǝkpǝ.</para>
  <para style="q1" vid="PHP 2:6">Paape lǝǝ pǝ́ ŋ pɔrʊ wǝ ŋ kaŋ mǝ okopiyǝ ǝkǝnǝŋ</para>
  <para style="q1" vid="PHP 2:6">ŋpǝ mǝ Worokoyǝ pǝ kaa rǝ.<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />Paape la maa no tu ri ŋ tu lo co</para>
  <para style="q1" vid="PHP 2:7">wǝ́ ŋ nǝ fǝ na wɛ ŋ ne yee sʊmatǝyǝ.</para>
  <para style="q1" vid="PHP 2:7">Lǝ pǝ lǝ mǝŋ nyɩmaasɩyǝ kǝtǝ.</para>
  <para style="q1" vid="PHP 2:7">Wǝ́ enyipǝ pǝ la nyɩŋ wǝ pǝ le ci ǝkǝnǝŋ nyɩmaasɩyǝ wǝ́ ŋ ri.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />La pɛɛlɩ na wɛ,</para>
  <para style="q1" vid="PHP 2:8">lo pu Worokoyǝ, wǝ́ ŋ na tɛɛnɩ ŋ nǝ kǝ kpǝ́</para>
  <para style="q1" vid="PHP 2:8">ǝrǝ kpɛtɛkpǝlɛciiwǝ lo oŋuŋkǝ.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Tuwǝ kǝto Worokoyǝ ŋ na rɛɛrɩ mǝ ŋwǝ rǝ oŋuŋ rǝ oŋuŋ,</para>
  <para style="q1" vid="PHP 2:9">wǝ́ ŋ nǝ fǝ nyɩŋrǝ we le ri anyɩŋyǝ kpǝlo kɩɩkɩ lo yurǝ ŋ ne kpii ŋwǝ.<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />Mǝŋkǝsa we vǝ́ pǝ la nya pǝ lo pwo Yesu la nyɩŋrǝ we,</para>
  <para style="q1" vid="PHP 2:10">wǝ kpii kǝ tu ri ŋ tu rǝ yulaarǝ, kǝtǝǝwǝ mǝ kǝtǝǝwǝ lǝ mǝrǝ</para>
  <para style="q1" vid="PHP 2:10">wǝ sʊʊ wǝ kʊŋ,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />kǝ yǝlo kpǝlo yǝ pɔrʊ yǝ tɛŋ ǝkǝnǝŋ Yesu Kǝriso ŋ ri Kulǝtǝyǝ</para>
  <para style="q1" vid="PHP 2:11">kǝ wǝ fǝ wǝ kǝ Worokoyǝ we ŋ ri Tǝyǝ.<verse eid="PHP 2:11" /></para>
  <para style="s">Ekǝrisotǝpǝ pǝ ri wǝnyɩɩnɩkpǝ rǝ ǝrǝkǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, nǝ ko ŋ nuŋ mǝ tutɛŋwǝ eni ri ŋ ni mǝ eniyǝ we ŋ́ ke kpii rǝ nǝ kpǝŋ wǝ. Kǝto kǝ́ ŋ́ nǝǝ tǝ ŋ́ kpii rǝ nǝ kpǝŋ we, nǝ tǝ nǝ nyɩɩ nǝ yee wǝ nǝ teeri. Nǝ fǝ wɛɛpɛɛlɩmumuŋwǝ rɛ nǝ nuŋ Worokoyǝ lo tutɛŋwǝ. Nǝ fǝ vusuumumuŋrǝ rɛ nǝ mǝ yee anǝnɛyǝ kǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ ŋnǝ nya nya alɔkuŋkǝ. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Duturǝ ɖi Worokoyǝ ŋ née yee kǝnǝnɛkǝ sa rǝ nǝ mǝrǝ, kǝ wǝ ca nǝ kpɛɛ nǝ yee nǝ kǝǝpǝ́wǝ, kǝ nǝ lɛ nǝ koru wǝ le eyee. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />Nǝ pee yee tǝrɛ mǝ acwɩɩcayǝ. Nǝ paa lɛ nǝ yee tǝrɛ kǝ nǝ ŋwaa nǝ wɛɛlɩ wǝ. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />Mǝŋkǝsa we, nǝ nyǝ́ǝ lǝ kenikeni, rɛ lǝŋ nyɩŋ bɔtɔɔrǝ rɛ rǝ nǝ. Nǝ nyée ri Worokoyǝ le epipǝ we pǝ lǝǝ lǝmǝ turɔɔrɔɔwǝ rǝ ǝrǝkǝ sa kǝ lǝ pǝlǝ wǝ́ kǝ lǝ lǝ mǝ oturɔɔrɔɔyǝ wǝ. Wǝ kaamǝ kǝ nǝ nyɩnɩ mǝŋ akaŋreyǝ kǝtǝ rǝ ǝrǝkǝ sa lǝ mǝrǝ. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />Kpiikǝ nǝ nya ta vɔrʊrǝ le dierǝ nǝ re kǝto we, jirǝ we Kǝriso ŋ nǝ́ǝ pǝ we, ŋ́ nah pa nya faawǝ ǝkǝnǝŋ ŋ́ nee yee kǝnǝnɛkpaakpaakǝ, wǝ́ ŋ́ naa lɛ ŋ́ faŋ ŋ́ co. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Wǝ ke ce wǝ ri pǝ láa lʊ mǝ ŋpǝrayǝ pǝ kʊla mǝ nǝ lɔnuŋrǝ we lǝ rǝ mǝŋ toolutuwǝ kǝtǝ we, ŋ́ náa nya faawǝ kǝ ŋ́ lɛ ŋ́ nya faawǝ mǝ nǝ kpǝlo. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Kaa wǝǝ ŋnǝ ŋkpɛ nǝ nya faawǝ, kǝ nǝ lɛ nǝ nya faawǝ nǝ kʊla mǝ mǝ.<verse eid="PHP 2:18" /></para>
  <para style="s">Pɔlʊ le kpii Timote mǝ Epafǝroditǝ la maŋ Efilipitǝpǝ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Rǝkǝsa we, mǝŋ Kulǝtǝyǝ Yesu la tɛɛnɩ we, wǝ lǝŋ panǝ ŋ́ née kpii Timote ŋ́ maŋ nǝ. Mǝŋkǝsa we, vǝ́ ŋ́ no nuŋ kǝ́ nǝ kpii nǝ fǝ rǝ nǝ kpǝŋ we, wǝ lée kpii mǝ wɛɛlɛŋwǝ. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Rǝ anʊkɔrǝyǝ we, rɛ lǝǝ tǝ ŋ kpii ŋ lǝǝmǝ oyupuyǝ mǝŋ ŋmǝ kǝtǝ ŋ kʊla mǝ ŋwǝ, wǝ́ ŋ náa lɛ mǝ ŋ kǝǝnǝ nǝ. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Otuturupǝ we, pǝ ya pǝ lǝ́ǝ kǝǝnǝ pǝ ŋ koonu rǝ pǝla wɛ. Pǝ lǝŋ nya akaa rǝ Yesu Kǝriso la nɛŋwǝ. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Timote ŋwǝ paa we, ŋnǝŋnǝ nǝ cii kǝ́ ŋ ne yee kǝnǝnɛkǝ mǝ kǝnʊkɔrʊkǝ wǝ. Yeli anǝnɛyǝ kʊ̀la mǝ mǝ rǝ Dieceeceerǝ we la atɛŋkǝ. Yeli yǝ mǝŋ piyǝ ŋ ya ŋ née yee anǝnɛyǝ mǝ nǝ tǝ kǝtǝ. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Kǝto ŋ́ ya ŋ́ nǝ́ǝ rǝŋ, vǝ́ ŋ́ na nyɩŋ kǝ́ mǝ etieyǝ sa yǝ lǝ yǝ fǝ sɩsiɛrɩ we, ŋwǝ wǝ́ ŋ́ née kpii ŋ́ maŋ nǝ wǝ. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Wǝ́ ŋ́ na lɔ ŋ́ no nuŋ rǝ Kulǝtǝyǝ la nyɩŋrǝ ǝkǝnǝŋ wǝ lǝŋ panǝ, ŋmǝŋmǝ ŋ́ nǝ́ǝ pǝ nǝ kpǝŋ.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ wǝ lǝ kpuŋkpuruŋ kǝ ŋ́ siɛnɩ ŋ́ kpii mǝ paanʊ Epafǝroditǝ, yǝ we ŋlǝ mǝ ŋwǝ yǝ le yee anǝnɛyǝ mǝ akɔŋkǝ wǝ, yǝ we nǝ kpii ŋ fǝ otuyǝ ŋ po koonu mǝ wǝ. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Wǝ ya wǝ láa ca na kpɛɛ ŋpa ŋ tǝ ŋ pa nyɩŋ nǝ. Duturǝ ya lǝ́ǝ kǝǝnǝ mǝ kǝ́ nǝ nunu ǝkǝnǝŋ ŋ naa kpaa wǝ. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Kǝceecee Epafǝroditǝ fǝ̀rǝ ŋpa, pǝlǝ ŋ pǝ kpǝ́. Paape Worokoyǝ nyɩnɩ na tǝlarǝwǝ. Ŋkǝ ŋwǝ ceŋceŋ ko. Nyɩnɩ mǝ tǝlarǝwǝ ŋmǝ ŋkpɛ kǝ ŋ́ paa nya fɛɛ ŋ́ fii gʊʊpirǝ ŋ kǝ sǝ ŋ́ tɛlɩ. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Tuwǝ kǝto ŋ́ nǝ fǝǝlǝ ŋ́ nǝ fǝ ŋwǝ ŋ́ na maŋ nǝ, kǝ nǝ nya fɛɛ nǝ tǝ nǝ nyɩŋ ŋwǝ, kǝ nǝ nya faawǝ. Mǝŋkǝsa we wǝ láa pɔrʊ mǝ gʊʊpifiirǝ wǝ sǝǝlǝ. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Kǝto nǝ fǝ faamumuŋwǝ rɛ nǝ lɔ ŋwǝ rǝ Kulǝtǝyǝ lǝ mǝrǝ. Wǝ kaamǝ kǝ nǝ pu ŋpǝ enyipǝ sa kǝtǝŋkǝ. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />Duturǝ ɖi la ka nyɩŋ gbɛŋrǝ kǝlǝkǝlǝ, mǝ kǝ́ ŋ ne yee anǝnɛyǝ ŋ no koonu Kǝriso wǝ. Wǝ́ ŋ nǝ fǝ na vɔrʊrǝ ŋ no koonu, kǝ ŋ nya fɛɛ ŋ toŋ mǝ rǝ kǝnǝnɛkǝ we ŋnǝŋnǝ nǝ nyǝŋ koru otoŋ mǝ wǝ.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Pɔlʊ la tɛɛ kpɛɛwǝ rǝ Yesu ceŋceŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Rǝkǝsa we lǝh ǝtǝŋ, nǝ mǝ nya faawǝ rǝ Kulǝtǝyǝ lǝ mǝrǝ. Ŋ́ kǝ tǝ mǝ ŋ ŋʊrʊ ŋyǝ otuyǝ sa ke mǝ ŋ maŋ nǝ we, wǝ lǝŋ kpii mǝ awɛɛlɩkǝ. Rǝ nǝ kpǝŋ we, ŋyǝ otuyǝ sa yǝ lóo koonu nǝ okopiyǝ. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Nǝ yee yurǝ rǝ anǝnɛyeetǝrɔɔrɔɔpǝ we lǝ kpǝŋ. Pǝ lǝ rǝ mǝŋ acɩkɛɛpǝ kǝtǝ. Wǝ́ pǝ lǝ́ǝ fǝ ǝkǝǝlǝkǝ mǝŋ tumumuŋwǝ rɛ wǝ lǝǝwe. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Ŋlǝ le ri epǝ we pǝ lǝ kǝǝlǝ kǝceece wǝ, wǝ́ la ya yǝ láa sʊma Worokoyǝ saŋ rǝ na Wɛɛrǝ. La ya yǝ láa nya faawǝ mǝ kǝ́ le ri Yesu Kǝriso la anɛŋpǝ wǝ. Paa yǝ laa ya yǝ láa tɛɛ kpɛɛwǝ rǝ ŋlǝŋlǝ lah wɛ. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Ŋmǝ paa we, ŋ́ nóo koru atɛ kpɛɛwǝ rǝ ŋmǝŋmǝ mǝ wɛ. Mǝŋ rɛ la nyɩŋ wǝ ǝkǝnǝŋ ŋ nóo koru atɛ kpɛɛwǝ rǝ ŋwǝŋwǝ na wɛ we, ŋmǝ we, ŋ́ nóo koru atɛŋ wǝ ŋ́ teeri yǝ we. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Kǝ́ pǝ lǝ mǝ mǝ lo junɛŋtǝrǝ we, wǝ́ pǝ kǝ̀ǝlǝ mǝ. Isǝrayɛlǝtǝpǝ wǝ́ ŋ́ ri. Ŋ́ no ru rǝ Bɛnǝyaminǝ lǝ gbǝŋrǝ mǝrǝ. Hebǝritǝpiyǝ wǝ́ ŋ́ ri duturǝ ɖi Ehebǝritǝpǝ pǝ lǝ mǝ mǝ. Ŋ́ née yee mǝ ŋ saŋ rǝ Oyudatǝpǝ le seyǝ mǝŋ kǝ́ Afarisitǝpǝ pǝ lée yee wǝ kǝtǝ. <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />Ŋ́ ka ŋ kɔŋ mǝ ŋ koonu seyǝ sa ŋpa, tuwǝ kǝto ŋ́ yili ŋ́ tɛ̀ɛ rǝ ekǝrisotǝpǝ la wǝcakukpǝ wǝǝ. Kǝ pǝ yee pǝ saŋ rǝ seyǝ la wǝkʊʊkpǝ we, rɛ laa pa nya bɔtɔɔrǝ rɛ rǝ mǝ. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Paape otuyǝ sa ŋ́ ka ŋ nyɩŋ ǝkǝnǝŋ vasʊyǝ wǝ́ yǝ ke ri yǝ kòonu mǝ we, rǝkǝsa rǝ Kǝriso kǝto we ŋ́ ya ŋ́ náa nyɩŋ yǝ mǝŋ otukpaakpaayǝ wǝ́ yǝ ri. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Rǝ kǝnʊkɔrʊkǝ we, ŋ́ na nyɩŋ wǝ ŋ́ ne ci ǝkǝnǝŋ Kulǝtǝyǝ Yesu Kǝriso le ecikǝ kǝ teeri tu ri ŋ tu. Ŋwǝ Yesu Kǝriso kǝto wǝ́ ŋ́ na tɛɛnɩ ŋ́ na nyarǝ tu ri ŋ tu ŋ́ no co wǝ. Wǝ́ ŋ́ na lɛ ŋ́ nǝ fǝ yǝ mǝŋ otuyǝ yǝ cò rǝ doŋtoŋrǝ kǝtǝ, kǝ ŋ́ nya fɛɛ ŋ́ nya Kǝriso, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />kǝ ŋ́ siɛrɩ ŋ́ yee ne nyiyǝ fee. Eniyǝ we ŋ́ nǝŋ tǝ ŋ́ yee tǝrɛ kǝ ŋ́ fǝ ŋ́ kaŋ mǝ wɛ ǝkǝnǝŋ ŋmǝ ŋ́ kʊʊ rǝ Oyudatǝpǝ le seyǝ lǝ kpǝŋ. Paa kǝ mǝ lɔnuŋrǝ bɔrʊ gaŋ ǝkǝnǝŋ ŋmǝ ŋ́ kʊʊ mǝ kǝ́ ŋ́ na lɔ Kǝriso ŋ́ no nuŋ wǝ. Worokoyǝ ŋ nóo koonu epǝ we pǝ la lɔ pǝ lo nuŋ la wǝkʊʊkpǝ sa. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Tuwǝ ceŋceŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ wǝ kaamǝ ǝkǝnǝŋ ŋmǝ ŋ́ ci Kǝriso, kǝ ŋ́ lɛ ŋ́ ci okopiyǝ we yǝ sàanǝ ŋwǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ. Ŋ́ tǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ cʊʊrʊ mǝŋ kǝ́ ŋ cʊ̀ʊrʊ wǝ, kǝ ŋ́ lɛ ŋ́ kpǝ́ mǝŋ kǝ́ ŋ kpǝ̀ wǝ. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />Mǝŋkǝsa we, ŋmǝ ŋkpɛ ŋ́ nóo koru ǝrǝŋ ǝkǝnǝŋ ŋ́ nah pa saanǝ rǝ enyiǝtǝpǝ lǝ mǝrǝ.<verse eid="PHP 3:11" /></para>
  <para style="s">Yurirǝ lo wǝtoomwarakpǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Ŋ́ naa ya ŋ́ náa tɛŋ ǝkǝnǝŋ ŋ́ na marǝ oko tuu tuwǝ we ŋ́ ya ŋ́ née piri ŋ́ ka lɔ wǝ, amaa ŋ́ na marǝ oto milimili ŋ́ na lɛ. Paape ŋ́ tǝ ŋ́ ya ŋ́ née piri wǝ, kǝ ŋ́ nyɩɩ ŋ́ ka lɔ wǝlo wǝtoomwarakpǝ. Duturǝ ɖi Yesu Kǝriso la marǝ ǝfǝ mǝ le yee na nɛŋyǝ la lɛ. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Lǝh ǝtǝŋ, ŋ́ naa ya ŋ́ nóo pu wǝ kʊrakʊra ǝkǝnǝŋ ŋ́ na marǝ alɔ wǝtoomwarakpǝ we. Paape tǝrɛ ceŋceŋ ko wǝ́ ŋ́ ya ŋ́ née yee. Tuwǝ we wǝ kaamǝ ǝkǝnǝŋ: Ŋ́ no yuu otuyǝ we yǝ la pa tɛlɩ la kpɛɛ, wǝ́ ŋ́ ya ŋ́ náa yɩrɩ rǝ kǝnyɩŋkǝ. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Ŋ́ ya ŋ́ nóo suu kǝ ŋ́ ke fii, kǝ ŋ́ nya fɛɛ ŋ́ ka lɔ wǝtoomwarakpǝ we Worokoyǝ ŋ no pwo lǝ la pa lɔ rǝ yulaarǝ saŋ rǝ Yesu Kǝriso wǝ.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Wǝ kaamǝ kǝ ŋlǝ ekǝrisotǝpǝ we yǝ lo kuru rǝ lɔnuŋrǝ we, lǝ lǝmǝ yupurǝ sa kǝtǝŋkǝ. Wǝ́ mǝŋ nǝ rɛ lǝǝmǝ yupupʊŋpwarǝ rɛ we, Worokoyǝ lóo toŋ nǝ kǝ nǝ nuŋ rǝlǝ mǝrǝ. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Wǝ ke ce wǝ yee nɛ we, nǝ maa kǝ le siimǝ gʊŋrǝ we le re yǝ lǝ́ǝ pǝ po ro ruŋruŋ wǝ.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Lǝh ǝtǝŋ, nǝ kpǝlo nǝ fǝ mǝ akparǝtǝnǝyǝ. Yǝ lo koonu nǝ anyɩŋcamǝkǝ. Kǝto we, nǝ fǝ nǝ enimiyǝ nǝ tǝnǝ kǝ nǝ mǝ yɩrɩ epǝ we pǝ ya pǝ láa saŋ rǝ anyɩŋcamǝkǝ sa wǝ. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Ŋ́ ne tíi nǝ wǝ ŋ́ na pa tɛlɩ, wǝ́ ŋ́ tǝ ŋ́ ya ŋ́ née tíi nǝ wǝ mǝ enimiyǝ ǝkǝnǝŋ enyipǝ wa pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ ŋpǝ pǝ siimǝ Yesu paape pǝlǝ wǝlǝkpǝ wǝ le yi wǝ la tɛɛ rǝ otukaŋyǝ we yǝ la wɛɛlɩ yǝ lo ru rǝ Kǝriso la gbɛŋrǝ we ŋ kpǝ̀ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Ŋpǝ enyipǝ sa la kǝlɛɛkǝ kǝ kaamǝ naalaalɛɛwǝ duturǝ ɖi pǝ lǝ fǝ pǝla lɛrǝ pǝ le yee pǝlo worokoyǝ. Vǝ́ pǝ le yee nʊŋsɔɔtǝtuwǝ kaa kǝ pǝ fii nʊŋsɔɔwǝ we, a pǝ ŋ mǝ nya rǝ faawǝ. Ǝkǝtǝǝtuyǝ ko wǝ́ pǝlo yupurǝ dɛɛ rǝ. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Ŋlǝ paa we, yulaarǝ le epipǝ wǝ́ le ri. La ya yǝ lǝ́ǝ rǝŋ loh Kulǝtǝyǝ Yesu Kǝriso ŋ ru rǝ yulaarǝ sa ŋ pǝ. Ŋwǝ ŋ ri lah Lɔkuŋtǝyǝ wǝ. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />Ŋwǝ ŋ nah pa siɛrɩ lah wɛɛlɛŋrǝ sa lǝǝ lǝmǝ okopiyǝ wǝ, kǝ gaa mǝ na wǝnyɩɩnɩkpǝ la wɛɛlɛŋrǝ we. Duturǝ ɖi lǝǝmǝ okopiyǝ ŋ nóo koru eri tu ri ŋ tu lo yurǝ.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Kǝto we lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ wǝ ŋpa ŋ́ tǝ ŋ pa nyɩŋ nǝ. Ŋnǝ nǝ ri mǝ faawǝ. Wǝ́ nǝ lɛ nǝ lǝ rǝ mǝŋ mǝ yurirǝ lo wǝtoomwarakpǝ. Kǝto we, mǝ ǝkǝǝtaatǝpǝ, nǝ tɔ nǝ yaa mǝŋkǝsa sɩsiɛrɩ rǝ Kulǝtǝyǝ lǝ mǝrǝ.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ Evodi mǝ Sɛŋtisǝ. Ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ pǝ rǝ, pǝ yee nyuŋceŋceŋ rǝ Kulǝtǝyǝ lǝ mǝrǝ. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Ŋlǝ́ yǝ ǝnǝ e le yee anǝnɛyǝ mǝ anʊkɔrǝyǝ mǝ mǝ we, ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ ŋlá ŋkpɛ kǝ o toŋ ŋpǝ etiepǝ sa. Ŋpǝ mǝ Kǝlema fǝ kʊla mǝ anǝnɛyeetǝpʊŋpwapǝ pǝ nyɩ̀ɩ pǝ tonu mǝ ŋpa rǝ Dieceeceerǝ we la atɛŋkǝ. Pǝ la ŋʊrʊ pǝla anyɩŋyǝ rǝ vɔrʊrǝ la kǝfwɛɛkǝ mǝrǝ.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Nǝ mǝ nya faawǝ kǝkpakǝkpa rǝ Kulǝtǝyǝ lǝ mǝrǝ. Ŋ́ tǝ ŋ́ ya ŋ́ náa tɛŋ ǝkǝnǝŋ nǝ nya faawǝ. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Nǝ kuŋ kǝ enyipǝ pǝ ci ǝkǝnǝŋ ŋnǝ nǝ lǝǝmǝ lɛtaarǝwǝ. Kulǝtǝyǝ lǝ ǝpǝkǝ kǝ lǝ kǝlǝ. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Nǝ pǝǝ kǝǝnǝ tǝrɛ pwi. Paa vǝ́ nǝ ya nǝ nyáa mwɛŋ nyuŋkpǝ we, nǝ tɛŋ otuyǝ we kpǝlo nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ tíi Worokoyǝ, kǝ nǝ lɛ nǝ ceeni ŋwǝ. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Mǝŋkǝsa we, Worokoyǝ la wǝtaarǝkpǝ we ŋlǝ anyɩmaasɩpǝ yǝ lǝŋ koru onuŋ duturǝ we, wǝ lée tii wǝ rǝŋ nǝ asiɔŋyǝ mǝ nǝ oyupuyǝ rǝ Yesu Kǝriso mǝrǝ.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Lǝh ǝtǝŋ, kǝ ŋ́ fǝ ŋ́ tǝǝlǝ nǝ we, mǝŋ nǝ nyoh pu yurǝ rɛ we, nǝ pu yurǝ nǝ ru rǝ otuceeceeyǝ lo oŋuŋkǝ, eyǝ we kpǝlo yǝ kaamǝ, yǝ kʊʊ, yǝ lǝ kenikeni, yǝ kaamǝ kǝ pǝ taa kǝǝwǝ wǝ, yǝ láa ca kpɛɛwǝ wǝ, yǝ ponu ŋpa wǝ́ yǝ kaamǝ ǝkǝkǝ wǝ. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Nǝ yee nǝ saŋ rǝ otuyǝ we nǝ nya karǝ wǝ́ nǝ nya lɔ, mǝ eyǝ we nǝ nyo nuŋ, wǝ́ nǝ nya nyɩŋ rǝ mǝ kpǝŋ wǝ. Mǝŋkǝsa we, Worokoyǝ we ŋ nóo koonu wǝtaarǝkpǝ lée tii ŋ kʊla mǝ nǝ.<verse eid="PHP 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Ŋ́ na nya faawǝ ŋpa rǝ Kulǝtǝyǝ lǝ mǝrǝ mǝ kǝ́ nǝ nyǝ tǝ nǝ nya pɔrʊ nǝ nya kaŋ ǝkǝnǝŋ ŋnǝ nǝ ya nǝ nyáa taalǝ mǝ wǝ. Ŋ́ naa ya ŋ́ náa tɛŋ ǝkǝnǝŋ nǝ nyǝǝ tǝ nǝ ya nǝ nyáa taalǝ mǝ oo, paa nǝ nyaa nya kʊŋwǝ nǝ pɔrʊ wǝ nǝ kaŋ mǝ. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Ŋkǝ ǝkǝnǝŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ tǝrɛ kǝto wǝ́ ŋ́ ya ŋ́ náa wɛɛlɩ ǝnǝ oo. Duturǝ ɖi wǝlǝ ri ŋ wǝlǝ lǝ mǝrǝ we, ŋ́ na karǝ kǝ́ pǝ láa nya faawǝ wǝ. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Ŋ́ cii kǝ́ nyɩmaasɩyǝ ŋ née re na wɛ mǝ ŋ fǝ rǝ ariaayǝ mǝ asɩkaniyǝ mǝrǝ. Eni ri ŋ ni rǝ fɛɛ ri ŋ fɛɛ we, ŋ́ na karǝ kǝ́ nyɩmaasɩyǝ ŋ née re na wɛ mǝ ŋ fǝ wǝ. Wǝ ke ce wǝ ri atɛŋwʊniyǝ amaa ekeeriniyǝ, ariaayǝ amaa asɩkaniyǝ. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Kǝriso ŋ nóo toŋ mǝ wǝ́ ŋ́ nóo koru ŋyǝ otuyǝ sa le eyee wǝ. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />Paape we, nǝ nye yee wǝ ponu kǝ́ nǝ nyo toŋ mǝ rǝ acʊcʊʊrʊyǝ lǝ mǝrǝ wǝ. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Ŋnǝ Efilipitǝpǝ, ŋnǝŋnǝ nǝ cii wǝ ǝkǝnǝŋ, kǝ́ ŋ́ ke ŋ tie Dieceeceerǝ we la atɛŋkǝ ǝkǝ ŋ́ pwɛ̀yɩ rǝ Makedonia we, ŋnǝ ceŋceŋ nǝ ke ri asʊmatǝpǝ la wǝcakukpǝ we wǝ ko ŋ toŋ mǝ, wǝ́ nǝ lɛ nǝ ko ŋ koonu mǝ otuyǝ wǝ. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />Kǝ́ ŋ́ ke kpii rǝ Tesalonika kʊraa we, ŋnǝ nǝ ka ŋ maŋ mǝ otuyǝ we yǝ ke ŋ yee mǝ ariaayǝ, wǝ́ ŋkǝ kǝceŋceŋ.<verse eid="PHP 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 4:17" />Ŋkǝ ǝkǝnǝŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ lɔ tǝrɛ ŋ́ ru rǝ nǝ kpǝŋ oo. Paape ŋ́ ya ŋ́ nǝ pǝ́ nǝ nya tuwǝ we nǝ nye yee la tǝtatɛɛwǝ. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ŋ́ na lɔ otuyǝ we kpǝlo nǝ nya maŋ mǝ wǝ, yǝ naanǝ kwa. Otuyǝ we ŋ́ ya ŋ́ nǝ́ǝ pǝ́ we, ŋ́ na nya yǝ. Duturǝ ɖi otuyǝ we nǝ nyo koonu Epafǝroditǝ ŋ po koonu mǝ we, yǝ lo po tu mǝ. Ŋyǝ otuyǝ sa yǝ láa wɛɛ fɛŋfɛŋ mǝŋ kɛɛyǝ pǝ la wʊ pǝ lo tu naa pǝ lo toolu pǝ lo koonu Worokoyǝ la jwɩɩrǝ, wǝ́ wǝ lo poŋ mǝ Worokoyǝ, wǝ́ ŋ na tɛɛ wǝla akaa. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Mǝ Worokoyǝ lǝǝmǝ na wɛ ŋpa. Kǝto lée yee otuyǝ we kpǝlo yǝ ya yǝ lée yee nǝ ariaayǝ ŋ koonu nǝ saŋ rǝ Yesu Kǝriso. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Lǝh Tǝ Worokoyǝ ŋ kaamǝ ǝkǝkǝ kǝkpakǝkpa. Amɛnǝ.<verse eid="PHP 4:20" /></para>
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Nǝ ceeni epǝ we pǝ ri Worokoyǝ la anɛŋpǝ rǝ Yesu Kǝriso la nyɩŋrǝ. Apaanʊpǝ we mǝ apaatɛpǝ we pǝ kpii rǝ mǝ kpǝŋ we, pǝ lée ceeni nǝ. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Ekǝrisotǝpǝ kpǝlo pǝ lée ceeni nǝ. Otukpǝlo epǝ we pǝ ri pilimumuŋyǝ la anǝnɛyeetǝpǝ wǝ.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>