<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">Akebou: La Bible en akebou</book>
  <para style="h">2 Okorɛŋtotǝpǝ</para>
  <para style="toc3">2Ok</para>
  <para style="toc2">2 Okorɛŋtotǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ Okorɛŋtotǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛyitǝkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Okorɛŋtotǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa. Kǝfwɛɛkǝ sa kǝ ri kǝyitǝkǝ ŋ na ŋʊrʊ ŋ na maŋ Okorɛŋtotǝpǝ wǝ. Rǝ kǝfwɛɛsǝsǝŋkǝ we lǝ mǝrǝ we, tìi pǝ ǝkǝnǝŋ ŋ nǝ́ǝ pǝ pǝlǝ kpǝŋ ŋ pa yɩrɩ pǝ, paape loo po koru oko. Nunu ǝkǝnǝŋ enyipǝ rɛ pǝ la pa ya pǝ láa tɛŋ dieceeceerǝ rɛ wǝ́ la cɛkɛlɛ mǝ ɖǝ we ŋwǝ Pɔlʊ ŋ tɛnɩ wǝ. Wǝ́ pǝ lɛ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ Pɔlʊ lee ri nyikpiipoŋpiyǝ. Etieyǝ sa yǝ fìi Pɔlʊ ŋpa. Fɛɛwǝ ŋ ŋʊ̀rʊ kǝfwɛɛyitǝkǝ sa ŋ manǝ alɔnuŋtǝpǝ la wǝcakukpǝ we rǝ Korɛŋto kǝ ŋ fǝ ŋ pɔrʊ yupurǝ we kǝto ŋ nǝǝ tǝ ŋ pǝ pǝlǝ kpǝŋ ŋ tíi pǝ. Rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ we la lɛ la tɛŋ ǝkǝnǝŋ ŋwǝ ŋ ri Kǝriso le nyikpiiyǝ, paape wǝlǝkpǝ we ŋwǝ ŋ nǝ fǝ ŋ ya ŋ née yee na kǝnǝnɛkǝ we, wǝ la cɛkɛlɛ mǝ epǝ we pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ ŋpǝ pǝ ri enyikpiipoŋpipǝ wǝ. Pɔlʊ lo ku mǝ akparaayǝ, wǝ́ ŋ na cʊʊrʊ rǝ na anǝnɛyǝ sa mǝrǝ ŋpa. La lɛ le kpii pǝ lo okopiyǝ kǝ pǝ nyɩɩ pǝ kpǝ gbǝrǝ we pǝ le kpii kǝ pǝ fǝ pǝ toŋ alɔnuŋtǝpǝ la wǝcakukpǝ we rǝ Yerusalɛmǝ wǝ. Pɔlʊ la wɛɛlɩ lo ru rǝ kǝ́ Yesu Kǝriso le nyikpiiyǝ ŋ lǝ ŋ fǝ wǝ. Yesu le nyikpiiyǝ láa tɛɛnɩ mǝ ŋ pɛɛlɩ na wɛ kǝ ŋ fǝ ŋ rɛɛrɩ mǝ otuturupǝ. Pɔlʊ la tɛɛnɩ ŋ ri fɔlɔfɔtǝyǝ kǝ ŋ nya fɛɛ ŋ nya okopiyǝ rǝ Worokoyǝ lǝ kpǝŋ. Pɔlʊ la tɛŋ rǝ kǝfwɛɛkǝ sa mǝrǝ ǝkǝnǝŋ ŋ na tɛŋ Dieceeceerǝ we ŋ ne tíi Okorɛŋtotǝpǝ ŋ na cɛɛ. Tuwǝ wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ lǝŋ lɔ tǝrɛ ŋ ru rǝ nyɩmaasɩyǝ la akaakǝ koonu na alɔkuŋkǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Eceenikǝ 1:1-11</para>
  <para style="io">- Pɔlʊ mǝ asʊmatǝpǝ we rǝ Korɛŋto 1:12–7:16</para>
  <para style="io">- Gbǝrǝ koonu alɔnuŋtǝpǝ 8:1–9:15</para>
  <para style="io">- Pɔlʊ ri nyikpiiyǝ 10:1–13:10</para>
  <para style="io">- Eceenituturukǝ 13:11-14</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Ŋmǝ Pɔlʊ, Yesu Kǝriso le nyikpiiyǝ wǝ́ ŋ́ ri saŋ rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ. Ŋlǝ mǝ paanʊyǝ Timote yǝ la ŋʊrʊ kǝfwɛɛkǝ sa yǝ la maŋ zʊmarǝ we wǝ gbii rǝ Korɛŋto mǝ epǝ we kpǝlo kɩɩkɩ pǝ ri Worokoyǝ la anɛŋpǝ rǝ Akayi la akaayǝ we kpǝlo. <verse eid="2CO 1:1" /><verse number="2" style="v" sid="2CO 1:2" />Lǝh Tǝ Worokoyǝ mǝ loh Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ koonu nǝ wǝtaarǝkpǝ.<verse eid="2CO 1:2" /></para>
  <para style="s">Pɔlʊ ya lée ceeni Worokoyǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Kǝ lǝ kǝ Worokoyǝ, loh Kulǝtǝyǝ Yesu Kǝriso lǝ Tǝ. Ŋwǝ ŋ ri Tǝyǝ we ŋ náa nyɩŋ enyipǝ la tǝlarǝwǝ ŋpa mǝ Worokoyǝ we ŋ náa ta lǝ turuwǝ eni ri ŋ ni wǝ. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Ŋwǝ ŋ náa ta lǝ turuwǝ rǝ lah acʊcʊʊrʊyǝ kpǝlo lǝ mǝrǝ, mǝŋkǝsa we, kǝ ŋla ŋkpɛ lo koru ata epǝ we pǝ ya pǝ láa cʊʊrʊ lo turuwǝ saŋ rǝ turutawǝ sa yǝ la nya rǝ Worokoyǝ lǝ kpǝŋ wǝ. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Duturǝ ɖi, kǝ́ la nya le siimǝ Kǝriso ko we, yǝ láa cʊʊrʊ ŋpa mǝŋ ŋwǝ kǝtǝ. Kaa wǝǝ yǝ lǝ́ǝ tǝ la nya turutawǝ saŋ rǝ ŋwǝ Kǝriso. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Mǝŋ la ya yǝ láa cʊʊrʊ we, yǝ lǝ pǝ́ kǝ nǝ nya turutawǝ mǝ alɔkuŋkǝ rǝ. Kaa wǝǝ mǝŋ Worokoyǝ ya láa ta lǝ turuwǝ we, ya lǝ́ǝ pǝ́ ŋnǝ ŋkpɛ nǝ nya turutawǝ rǝ, kǝ nǝ nya fɛɛ nǝ koru atɔ nǝ ya rǝ ŋyǝ acʊcʊʊrʊyǝ sa la ya yǝ láa cʊʊrʊ mǝrǝ. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Mǝŋkǝsa we, yǝ lóo koru atɛɛ kpɛɛwǝ rǝ nǝ, duturǝ ɖi le cii wǝ ǝkǝnǝŋ mǝŋ nǝ ya nǝ nyáa cʊʊrʊ nyǝ ŋ kʊla mǝ lǝ we, kaa wǝǝ Worokoyǝ ŋ náa ta nǝ turuwǝ mǝŋ kǝ́ ŋ na ta lǝ wǝ kǝtǝ.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Lǝh ǝtǝŋ, la ya yǝ lǝ́ǝ pǝ́ nǝ ci acʊcʊʊrʊyǝ we la cʊ̀ʊrʊ rǝ Azi la gaarǝ we wǝ. La cʊ̀ʊrʊ ŋpa wǝ́ wǝ tèeri lǝ. Yǝ lǝǝ tǝ la tɛɛ kpɛɛwǝ ǝkǝnǝŋ ŋlǝ yǝ láa fɔrʊ. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Rǝ anʊkɔrǝyǝ we, ŋlǝŋlǝ la nyɩnɩ wǝ le cìi ǝkǝnǝŋ tuyeewǝ rɛ wǝ lǝǝ kǝ tǝ wǝ kpii, we gbɛŋrǝ ko yà gǝ ŋ rǝŋ lǝ. Tuwǝ sa wǝ pǝlǝ wǝ tuu lǝ ǝnǝ kǝ la paa nya fɛɛ la tɛɛ kpɛɛwǝ rǝ lah wɛ, paa kǝ la tɛɛ kpɛɛwǝ rǝ Worokoyǝ we ŋ náa saanǝ enyiǝtǝpǝ wǝ. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />Ŋwǝ Worokoyǝ sa ŋ pɔ̀rʊ lǝ ŋ rù rǝ gbɛŋrǝ sa kǝtǝŋkǝ mǝrǝ, wǝ́ lah mǝ lɛ mǝ ŋ pɔrʊ lǝ mǝŋkǝsa. Awo, la tɛ̀ɛ kpɛɛwǝ rǝ ŋwǝ, wǝ́ yǝ lǝ tǝ yǝ la tɛɛ kpɛɛwǝ ǝkǝnǝŋ lǝ́ǝ tǝ ŋ pɔrʊ lǝ ke. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />Mǝŋ nǝ nya mwɛŋ nyuŋkpǝ nǝ nyo koonu lǝ we, o lóo turu nǝ nyóo toŋ lǝ. Mǝŋkǝsa saŋ rǝ enyipǝ wa lo nyuŋmwɛŋkpǝ we, Worokoyǝ lóo nuŋ, kǝ ŋ yee lǝ lɛsiɛrɩwǝ, eniyǝ we enyipǝ wa pǝ lǝ fǝ eceenikǝ pǝ lo koonu ŋwǝ rǝ loh yurǝ.<verse eid="2CO 1:11" /></para>
  <para style="s">Pɔlʊ la siɛnɩ na gʊŋsaŋrǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Tuwǝ yǝ lǝ fǝ la ya yǝ láa faa faawǝ wǝ kaamǝ ǝkǝnǝŋ le rè lah wɛ rǝ enyikpǝlo lǝ mǝrǝ otukpǝlo rǝ nǝ mǝrǝ mǝ wǝkʊʊkpǝ mǝ wɛɛpɛɛlɩwǝ. Wǝ́ lah ziɔŋrǝ ya lée ri wǝ la ɖaŋsieyǝ. Wǝlǝkpǝ sa wǝyikpǝ we, wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ. Worokoyǝ la lɛsiɛrɩwǝ wǝ ke re lǝ, ŋkǝ anyɩmaasɩpǝ le nimisiewǝ. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Rǝ anʊkɔrǝyǝ we, otuyǝ we nǝ nyóo koru ǝkǝ kǝ nǝ nuŋ duturǝ wǝ́ yǝ láa ŋʊrʊ yǝ ŋ kpii rǝ lah wǝfwɛɛkpǝ we yǝ láa maŋ nǝ wǝ. Wǝ́ ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ nǝ nyóo nuŋ lǝ duturǝ fee. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />Mǝŋ kǝ́ nǝ marǝ nǝ cii wǝ rǝ kǝtarɛɛkǝ ǝkǝnǝŋ jirǝ we loh Kulǝtǝyǝ Yesu ŋ nǝ́ǝ pǝ we, nǝ nyǝ́ǝ fǝ lǝ nǝ faa faawǝ, kǝ ŋla ŋkpɛ lǝ fǝ nǝ la faa faawǝ.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Tuwǝ sa kǝto wǝ́ ŋ́ kǝ ŋ pǝ́ ŋ́ fǝ rǝ nǝ kpǝŋ kpɛŋ kǝ ŋ́ nya fɛɛ ŋ́ pe kpii nǝ faawǝ kpeewǝ yi. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Ŋ́ kǝ ŋ pǝ́ vǝ́ ŋ́ noh ko Makedonia we, kǝ ŋ́ kǝ fǝ rǝ nǝ kpǝŋ. Vǝ́ ŋ́ no ko ru rǝ Makedonia ŋ́ nǝh pǝ we, kǝ ŋ́ kǝ tǝ ŋ́ fǝ rǝ nǝ kpǝŋ, kǝ nǝ ko po toŋ mǝ kǝ ŋ́ nya fɛɛ ŋ́ ko Yudeya. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Kǝ́ ŋ́ nǝǝ tǝ ŋ́ koru wǝ le eyee ǝnǝ wǝǝ, we o lo nuŋ tuŋtuŋ? Amaa ŋ́ na siɛrɩ ŋ́ ya ŋ́ née yee ŋmǝŋmǝ mǝ kǝǝpǝ́wǝ, kǝ ŋ́ tɛŋ «Ǝŋ» kǝ ŋ́ tǝ ŋ́ pa tɛŋ «Ow»? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />Worokoyǝ ŋwǝŋwǝ cii wǝ ǝkǝnǝŋ tuwǝ we yǝ le tíi nǝ we, wǝ lee ri «Ǝŋ» mǝ «Ow». <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Duturǝ ɖi Worokoyǝ le Pi Yesu Kǝriso, yǝ we le dierǝ ŋlǝ mǝ Silasǝ mǝ Timote lǝ pǝlǝ la tɛnɩ le tìi nǝ we, lee ri «Ǝŋ» mǝ «Ow». «Ǝŋ» ko wǝ́ ŋ ri. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Duturǝ ɖi Yesu ŋ ri «Ǝŋ» ŋ koonu akayǝ we kpǝlo Worokoyǝ ŋ no co wǝ. Tuwǝ kǝto saŋ rǝ Yesu wǝ́ yǝ láa tɛŋ Amɛnǝ yǝ ŋ tíi Worokoyǝ kǝ lǝ fǝ lǝ kǝ ŋwǝ. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Worokoyǝ ŋ ri yǝ we ŋ na tɔ ŋlǝ mǝ nǝ ŋ na yaalǝ rǝ Kǝriso mǝrǝ. Ŋwǝ ke ŋ na saa lǝ ŋ na pɔrʊ koonu na kǝnǝnɛkǝ wǝ. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />Ŋwǝ ŋ na tɛɛ lǝ barǝ, wǝ́ ŋ nǝ fǝ na Wɛɛkenikenirǝ ŋ ne kpii rǝ lah asiɔŋyǝ mǝŋ tutagbarǝrǝ kǝtǝ kǝ wǝ ŋ kaŋ ǝkǝnǝŋ ŋlǝ yǝ lah pa lɔ otuyǝ we ŋ na kʊʊ ŋ nǝ tǝnǝ lǝ wǝ.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Worokoyǝ ŋ ri mǝ ɖaŋsieyǝ. Mǝŋ ŋ́ ya ŋ́ náa nia rǝ we, ŋ wʊ mǝ. Rǝkǝsa tuwǝ kǝto ŋ́ nǝǝ tǝ ŋ́ pǝ nǝ kpǝŋ rǝ Korɛŋto wǝ kaamǝ ǝkǝnǝŋ ŋ́ nǝǝ pǝ́ ŋ́ pe kpii nǝ acʊcʊʊrʊyǝ kururu. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Ŋlǝ we, yǝ laa ya yǝ lǝ́ǝ pǝ́ le ri okulǝtǝpǝ lo koonu nǝ, kǝ le mǝ tíi nǝ ǝkǝnǝŋ wǝ kaamǝ kǝ nǝ lɔ nǝ nuŋ. Duturǝ ɖi nǝ nya marǝ alɛnyɩ rǝ lɔnuŋrǝ. Paa we la ya yǝ lóo toŋ nǝ kǝ nǝ nya fɛɛ nǝ nya faawǝ rǝ.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Kǝto ŋmǝ paa ŋ́ na tɛŋ wǝ ǝkǝnǝŋ, mǝŋ ŋ́ nǝ́ǝ pǝ nǝ kpǝŋ kǝ nǝ pe fii gʊʊpirǝ rǝ we, we ŋ́ nǝŋ pǝ! <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Duturǝ ɖi mǝŋ ŋ́ no po koonu wǝ́ nǝ nye fii gʊʊpirǝ wǝǝ, ǝlǝ ŋ neh pe kpii mǝ faawǝ wǝ? Mǝŋkǝ ŋnǝ ǝpǝ ŋ́ no koonu nǝ nye fii gʊʊpirǝ wǝ? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Tuwǝ sa kǝto wǝ́ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ ŋ́ na maŋ nǝ rǝ, mǝŋ kǝ́ ŋ́ ŋʊ̀rʊ kǝ ŋ pǝlǝ ŋ́ tɛlɩ wǝ, kǝ wǝ pee pe yee ǝkǝnǝŋ ŋmǝ ŋ́ nǝ pǝ nǝ kpǝŋ wǝ́ ŋnǝ epǝ we wǝ kaamǝ kǝ nǝ kpii mǝ faawǝ we, kǝ nǝ po koonu ŋ́ fii rǝ gʊʊpirǝ. Duturǝ ɖi ŋ́ cii wǝ ǝkǝnǝŋ vǝ́ ŋ́ na nya faawǝ we, ŋnǝ ŋkpɛ nǝ nyáa nya faawǝ. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Ŋ́ nǝ fǝ vuurǝ, gʊʊpifiirǝ mǝ enimiyǝ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ́ na maŋ nǝ. Ŋ́ naa ŋʊrʊ kǝ ŋ́ maŋ nǝ kǝ nǝ fii gʊʊpirǝ rǝ, paa kǝ nǝ ci wǝ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa nǝ kǝǝwǝ ŋpa.<verse eid="2CO 2:4" /></para>
  <para style="s">Pɔlʊ lǝ fǝ la cɛɛ yǝ we ŋ no wu ŋwǝ wǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Mǝŋ rɛ rǝ nǝ mǝrǝ le yee tuwǝ rɛ, wǝ́ wǝ lo koonu otuturupǝ pǝ le fii gʊʊpirǝ we, ŋkǝ ŋmǝ wǝ́ yǝ we ŋ no koonu ŋ́ ne fii gʊʊpirǝ. Nǝ kpǝlo nǝ nye fii gʊʊpirǝ, paa kǝ ŋ́ paa nia rooroo we, nǝ kǝtarɛɛkǝ kǝ le fii gʊʊpirǝ. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Nyiyǝ sa wǝrʊʊkpǝ we, mǝŋ kǝkpǝŋkǝ kǝ la ta no kǝtukoŋkǝ ko, wǝ lo ro. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Wǝ kpii kǝ nǝ fǝ nǝ cɛɛ ŋwǝ kǝ nǝ ta no turuwǝ, kǝ ŋ paa nya fɛɛ ŋ pe fii rǝ gʊʊpimumuŋrǝ rɛ lǝ mǝrǝ. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Kǝto ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ pɔrʊ nǝ kaŋ ŋwǝ ǝkǝnǝŋ ŋnǝ nǝ nyáa taa nǝ kǝǝwǝ. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Ŋ wǝ kǝto wǝ́ ŋ́ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ́ na maŋ nǝ, kǝ ŋ́ nyɩŋ mǝŋ nǝ nyáa tɛɛnɩ nǝ yee nǝ saŋ rǝ mǝ tutɛŋwǝ wǝ. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Mǝŋ nǝ nyǝ fǝ nǝ nya cɛɛ nyiyǝ rɛ we, ŋmǝ ŋkpɛ ŋ́ nǝ́ǝ fǝ ŋ́ cɛɛ ŋwǝ. Duturǝ ɖi mǝŋ ŋ́ nǝ fǝ ŋ́ na cɛɛ, amaa ŋ́ na nya ŋ́ nǝ fǝ ŋ́ na cɛɛ rɛ we, ŋnǝ kǝto wǝ́ ŋ́ nǝ fǝ ŋ́ na cɛɛ ŋwǝ rǝ Kǝriso la kǝnyɩŋkǝ. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />Ŋ́ ne yee wǝ ǝnǝ kǝ Satana ŋ paa nya fɛɛ ŋ pǝ tǝǝnǝ nǝ. Duturǝ ɖi le cii no oyupuyǝ sɩsiɛrɩ.<verse eid="2CO 2:11" /></para>
  <para style="s">Pɔlʊ lo ko Tǝrowa</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Kǝ́ ŋ́ kolu Tǝrowa ŋ́ ka tɛŋ Kǝriso le Dieceeceerǝ we we, ŋ́ nyɩnɩ wǝ ŋ́ cìi ǝkǝnǝŋ Kulǝtǝyǝ la taanǝ gʊŋrǝ lo koonu mǝ kǝ ŋ́ nya fɛɛ ŋ́ tɛŋ rǝ. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Paape ŋ́ yà ŋ́ kǝ ŋ kǝǝnǝ ŋpa, duturǝ ɖi ŋ́ naa ka nyɩŋ mǝ paanʊ Tito. Ŋ wǝ tuwǝ sa kǝto wǝ́ ŋ́ pwɛyɩ rǝ Otǝrowatǝpǝ we lǝ kpǝŋ ŋ́ ko ŋ ko Makedonia wǝǝ.<verse eid="2CO 2:13" /></para>
  <para style="s">Yesu Kǝriso le ri yurǝ lo koonu lǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Kǝ le mǝ ceeni Worokoyǝ, duturǝ ɖi ŋwǝ ŋ née re lǝ mǝ ŋ tɛlɩ rǝ Kǝriso lo yurirǝ we la faawǝ mǝrǝ eni ri ŋ ni. Láa saŋ rǝ loh oŋuŋkǝ ŋ pɔrʊ Kǝriso ŋ kaŋ rǝ fɛɛ ri ŋ fɛɛ. Wǝ lǝ rǝ mǝŋ kǝ́ apɔŋfɛŋfɛŋpǝ la jwɩɩrǝ láa lɔ fɛɛ ri ŋ fɛɛ kǝtǝ. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Rǝ Worokoyǝ le enimiyǝ we, lǝ lǝ rǝ mǝŋ apɔŋfɛŋfɛŋpǝ rɛ Kǝriso ŋ nǝ́ǝ fǝ mǝŋ koonu Worokoyǝ wǝ. Wǝ́ apɔŋfɛŋfɛŋpǝ sa we, pǝ ri rǝ epǝ we pǝ kpii rǝ alɔkuŋkǝ la cawǝ mǝ epǝ we pǝ lee siimǝ cawǝ sa la anɛŋ. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Ko rǝ epǝ we pǝ lee siimǝ cawǝ la kǝtakǝ we, apɔŋpǝ sa pǝ láa wɛɛ gbɛŋrǝ la jwɩɩrǝ, wǝ́ jwɩɩrǝ sa lée re pǝ lǝ ŋ ko gbɛŋrǝ. Ko rǝ epǝ we pǝ kpii rǝ alɔkuŋkǝ la cawǝ sa pǝ lóo ko la kǝtakǝ we, apɔŋpǝ sa pǝ láa wɛɛ vɔrʊrǝ la jwɩɩrǝ, wǝ́ jwɩɩrǝ sa lóo ko mǝ pǝ rǝ vɔrʊrǝ mǝrǝ. Wǝ́ ǝlǝ ŋ nóo koru eyee kǝnǝnɛkǝ sa kǝtǝŋkǝ? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Ŋlǝ we, yǝ lǝǝ lǝ mǝŋ enyipǝ wa, pǝ lǝ́ǝ fǝ Worokoŋtierǝ pǝ ŋ yee ɖaasaŋrǝ. Ŋlǝ we, le kpii rǝ Kǝriso lǝ mǝrǝ, wǝ́ la ya yǝ láa tɛŋ anʊkɔrǝyǝ we yǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ mǝŋ Worokoyǝ le enyipǝ kǝtǝ rǝ Worokoyǝ la kǝnyɩŋkǝ.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">Anǝnɛyeetǝpǝ rǝ Dieparǝtǝnǝŋwɛŋrǝ we mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Mǝŋ ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ ǝnǝ wǝǝ, wǝlo duturǝ wǝ ri ǝkǝnǝŋ ŋlǝ yǝ lǝh tǝ yǝ ŋ kaŋ lah wɛ rǝ? Enyirɛɛpǝ pǝ lǝ́ǝ pǝ́ pǝ ŋʊrʊ kǝfwɛɛkǝ pǝ koonu pǝ pǝ re pǝ ŋ tɛlɩ, kǝ wǝ ŋ kaŋ kǝ́ pǝ lée yee anǝnɛyǝ sɩsiɛrɩ pǝ ŋ fǝ wǝ. Ŋlǝ paa we, wǝ lǝǝ pǝ́ la kaŋ nǝ kǝfwɛɛkǝ sa wǝrʊʊkpǝ. Wǝ́ yǝ lǝŋ lɛ lǝ pǝ́ nǝ ŋʊrʊ kǝfwɛɛkǝ rɛ mǝŋkǝsa nǝ koonu lǝ. <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Ŋnǝ nǝ ri lah kǝfwɛɛkǝ wǝ. Pǝ la ŋʊrʊ kǝ pǝ le kpii rǝ lah asiɔŋyǝ, wǝ́ nyi ri ŋ nyi ŋ cii kǝ, wǝ́ ŋ nǝ́ǝ kǝ kǝ. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Wǝ la pɔrʊ wǝ la kaŋ sɩsiɛrɩ ǝkǝnǝŋ ŋnǝ nǝ ri Kǝriso la kǝfwɛɛkǝ we ŋ na ŋʊrʊ saŋ rǝ lah kǝnǝnɛkǝ wǝ. Wǝ́ kǝfwɛɛkǝ sa we, ŋkǝ jitipiŋʊrʊrǝ wǝ́ pǝ lǝ fǝ pǝ la ŋʊrʊ kǝ, paa pǝ la ŋʊrʊ kǝ mǝ Worokoyǝ we ŋ kpii vɔrʊrǝ la Wɛɛrǝ. Wǝ́ ŋkǝ ɖurǝ lo oŋuŋkǝ wǝ́ pǝ la ŋʊrʊ kǝ pǝ la tɛɛ, paa pǝ la ŋʊrʊ kǝ pǝ la tɛɛ rǝ anyɩmaasɩpǝ la asiɔŋyǝ.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />La ya yǝ láa tɛŋ wǝ ǝnǝ kpiikǝ yǝ la tɛɛ kpɛɛwǝ rǝ Worokoyǝ saŋ rǝ Kǝriso kǝto. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Ŋlǝŋlǝ le cii wǝ ǝkǝnǝŋ yǝ lǝŋ koru tǝrɛ le eyee mǝ loh okopiyǝ. Paa mǝŋ yǝ lo koru tǝrɛ le eyee we, we Worokoyǝ ŋ no koonu lǝ okopiyǝ le yee wǝ. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Ŋwǝ ŋ no koonu lǝ okopiyǝ le ri anǝnɛyeetǝpǝ koonu Dieparǝtǝnǝŋwɛŋrǝ sa. Wǝ́ ŋrǝ dieparǝtǝnǝrǝ sa lee ri seyǝ rɛ pǝ ŋʊ̀rʊ pǝ tǝnǝ, paa lo ru rǝ Wɛɛrǝ mǝrǝ. Duturǝ ɖi seyǝ we pǝ la ŋʊrʊ pǝ lǝ tǝnǝ we, lóo koonu gbɛŋrǝ, wǝ́ Wɛɛrǝ paa we, lóo koonu vɔrʊrǝ.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Worokoyǝ ŋʊ̀rʊ seyǝ sa tɛɛ rǝ ɖurǝ. Wǝ́ Mose ŋ ka ŋ kaŋ enyipǝ lǝ ŋwǝ. Ŋwǝ seyǝ sa lóo koonu gbɛŋrǝ. Eniyǝ we Mose ŋ ru mǝ seyǝ sa rǝ Sinayi lo dutupirǝ ŋ ka ŋ sʊʊ we, wǝ́ na anyɩŋkǝ kǝ ka ŋ nyɔŋ ŋaŋa. Kǝto Isǝrayɛlǝtǝpǝ pǝ loo ko ŋ koru na anyɩŋkǝ la ayɩrɩ, mǝŋkǝ́ wǝnyɩɩnɩkpǝ we wǝ ka ŋ nyɔŋ rǝ na anyɩŋkǝ wǝ laa panǝ paape. <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />Paa Wɛɛrǝ la anǝnɛyǝ la wǝnyɩɩnɩkpǝ wǝ láa nyɔŋ wǝ teeri. <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Mǝŋ Mose la kǝnǝnɛkǝ we ŋ ke ŋ yee mǝ ŋ koonu seyǝ sa ŋ nóo koonu gbɛŋrǝ kǝ lo ru mǝ wǝnyɩɩnɩkpǝ ǝnǝ wǝǝ, we Wɛɛrǝ la kǝnǝnɛkǝ la wǝnyɩɩnɩkpǝ wǝ láa nyɔŋ wǝ teeri. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Rǝ anʊkɔrǝyǝ we, mǝŋ yǝ lǝ fǝ wǝnyɩɩnɩkpǝ we wǝ la nyɔŋ wǝ la pa tɛɛlɩ yǝ lǝ fǝ yǝ la ca mǝ ruŋruŋ la wǝnyɩɩnɩkpǝ sa we, ruŋruŋ lǝ gbǝ ǝnǝ wǝ naanǝ ŋpaŋpa wǝ teeri. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Duturǝ ɖi mǝŋ tuwǝ wǝ lǝŋ panǝ, wǝ lo ru mǝ wǝnyɩɩnɩkpǝ wǝǝ, kǝ tuwǝ wǝ kpii kǝkpakǝkpa wǝ wɛ wǝ lǝŋ ru mǝ wǝnyɩɩnɩkpǝ wǝ teeri?<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Tuwǝ sa kǝtǝŋkǝ wǝ́ la ya yǝ lǝ́ǝ rǝŋ, kǝto lǝ lǝǝmǝ kpɛɛtɛɛwǝ ŋpa. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Ŋlǝ we, yǝ lǝŋ yee mǝŋ Mose kǝtǝ. Mose we, kǝ ŋ fǝ tuwǝ mǝ ŋ sii na anyɩŋkǝ kǝ Isǝrayɛlǝtǝpǝ pǝ paa nyɩŋ wǝnyɩɩnɩkpǝ sa wǝ lǝŋ ce wǝ panǝ la alɛɛkǝ. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Paape pǝlo susuyǝ loo wuru pǝ. Wǝ́ po ro ruŋruŋ le jirǝ we, vǝ́ pǝ ya pǝ lǝ́ǝ kǝ Dieparǝtǝnǝkuukuurǝ la wǝfwɛɛkpǝ we, oturu tuwǝ we ke wǝ le sii pǝlo susuyǝ. Mǝŋ tuwǝ we wǝ lǝ pǝ wǝ lóo wuru rǝ rɛ lo susuyǝ we, we yǝ we le yee nyiceŋceŋ mǝ Kǝriso rǝ. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Wǝ́ kǝceece, po ro ruŋruŋ le jirǝ we, vǝ́ Isǝrayɛlǝtǝpǝ pǝ la nya pǝ lǝh kǝ Mose la wǝfwɛɛkpǝ we, oturu tuwǝ rɛ wǝ le sii pǝlo susuyǝ. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />Paa mǝŋ rɛ la lɔ Kulǝtǝyǝ lo nuŋ we, oturu tuwǝ we wǝ lo wuru wǝ la cɛ. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Duturǝ ɖi Kulǝtǝyǝ sa pǝ ya pǝ lóo pwo rǝ fɛɛwǝ sa we, Wɛɛrǝ lǝǝwe. Wǝ́ fɛɛwǝ we Kulǝtǝyǝ la Wɛɛrǝ gbii we, diiwɛɛrǝ gbii rǝ we. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Rǝkǝsa Worokoyǝ lo wuru tuwǝ we wǝ ke sii loh kpǝlo rǝ wǝnyɩŋkpǝ la cɛ. Wǝ́ Kulǝtǝyǝ la wǝnyɩɩnɩkpǝ wǝ ya wǝ láa nyɔŋ rǝ lah wǝnyɩŋkpǝ sa mǝŋ tǝraanyɩwǝ kǝtǝ. Kǝto Kulǝtǝyǝ ya láa siɛrɩ lǝ kǝ lǝ lǝ mǝŋ ŋwǝ kǝtǝ, mǝŋkǝsa we, yǝ lǝ́ǝ tǝ la mǝ nyɔŋ la mǝ kʊla rǝ. Kulǝtǝyǝ la Wɛɛrǝ lée yee kǝnǝnɛkǝ sa kǝtǝŋkǝ.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Yǝ lǝǝ lǝmǝ okopiyǝ rɛ paa Worokoyǝ ŋwǝ lǝǝmǝ yǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Worokoyǝ lǝ fǝ kǝnǝnɛkǝ sa le kpii lǝ rǝ akaakǝ saŋ rǝ na tǝlarǝnyɩŋwǝ. Wǝ kǝto yǝ lǝŋ kpii lah wɛ la wɛɛyɔɔwǝ. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Yǝ lǝ sǝ́ŋ anʊŋsɔɔtǝtuyǝ mǝ otuŋwaayeeyǝ yǝ lo co. Yǝ lǝŋ tǝǝnǝ rɛ, wǝ́ yǝ lǝŋ lɛ la cɛkɛlɛ Worokoŋtierǝ we la tɛŋ. Anʊkɔrǝyǝ we ko wǝ́ la ya yǝ láa pɔrʊ yǝ ŋ kaŋ sɩsiɛrɩ, mǝŋkǝsa we, kǝ enyipǝ pǝ ci rǝ pǝla ziɔŋrǝ epǝ we kǝtǝŋkǝ le ri rǝ Worokoyǝ la kǝnyɩŋkǝ. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Dieceeceerǝ we la ya yǝ láa tɛŋ we, lǝ rǝ mǝŋ nuŋtumuwǝ goonu epǝ we pǝ lǝ lǝǝ cawǝ wǝ. Duturǝ ɖi pǝ lǝŋ nuŋ rǝlo duturǝ. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Ŋpǝ enyipǝ sa pǝ laa lɔ pǝ nuŋ, duturǝ ɖi Satana, yǝ we ŋ ri ǝrǝkǝ sa lo worokoyǝ la wɔɔ pǝle enimiyǝ, kǝ pǝ paa nya fɛɛ pǝ nyɩŋ Dieceeceerǝ we la wǝnyɩɩnɩkpǝ. Wǝ́ ŋrǝ Dieceeceerǝ sa la pɔrʊ Kǝriso la wǝnyɩɩnɩkpǝ la kaŋ. Ŋwǝ Kǝriso ŋ ri Worokoyǝ lǝ wǝlǝkpǝ wǝ. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Duturǝ ɖi vǝ́ la ya yǝ láa tɛŋ Worokoŋtierǝ we, yǝ lǝŋ wɛɛlɩ lo ru rǝ lah wɛ, paa yǝ láa wɛɛlɩ yǝ ŋ tɛŋ ǝkǝnǝŋ Yesu Kǝriso ŋ ri Kulǝtǝyǝ. Ŋlǝ paa we, le ri rǝ nǝ asʊmatǝpǝ rǝ Yesu Kǝriso kǝto. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Worokoyǝ we ŋ tɛnɩ ǝkǝnǝŋ «Wǝnyɩɩnɩkpǝ wǝ nyɩnɩ rǝ nuŋtumuwǝ» we, ŋwǝ Worokoyǝ sa ke ŋ no koonu wǝ́ na wǝnyɩɩnɩkpǝ wǝ la nyɩnɩ rǝ lah asiɔŋyǝ mǝrǝ, kǝ la nya fɛɛ le ci wǝnyɩɩnɩkpǝ we wǝ ya wǝ láa nyɔŋ rǝ Kǝriso la anyɩŋkǝ wǝ. <verse eid="2CO 4:6" /><verse number="7" style="v" sid="2CO 4:7" />Paa ŋlǝ epǝ we lǝ lǝǝmǝ sɩkatuwǝ sa we, lǝ lǝ rǝ mǝŋ wǝkǝtǝǝsiɛkpǝ kǝtǝ. Mǝŋkǝsa we, kǝ enyipǝ pǝ nyɩŋ wǝ pǝ ci ǝkǝnǝŋ okopimumuŋyǝ sa yǝ loo ru rǝ lǝh kpǝŋ paa yǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Enyipǝ pǝ ya pǝ láa kɔŋ lǝ kǝta ri ŋ ta, paape pǝ lee ri lǝ yurǝ. Pǝ le kpii lǝ akparaayǝ, paape yǝ lǝǝ lǝǝrǝ kpɛɛtɛɛwǝ. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />Pǝ le yi pǝ la tɛɛ rǝ lǝ, paa Worokoyǝ laa maa lǝ ŋ co. Pǝ lǝ kpǝ lǝ pǝ la ca, paape yǝ lǝǝ kpǝ́. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />La ya yǝ láa ra Yesu la gbɛŋrǝ ji ri ŋ ji rǝ lah vɔrʊrǝ, kǝ wǝ nya fɛɛ wǝ pɔrʊ Yesu la vɔrʊrǝ wǝ kaŋ saŋ rǝ lah wɛlɛŋrǝ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Le kpii vɔrʊrǝ, paa gbɛŋrǝ ya láa wɛ lǝ ji ri ŋ ji rǝ Yesu kǝto. Mǝŋkǝsa we, kǝ wǝ nya fɛɛ wǝ pɔrʊ Yesu la vɔrʊrǝ wǝ kaŋ saŋ rǝ lah wɛlɛŋrǝ sa lǝ́ǝ kpǝ́ wǝ. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Mǝŋkǝsa we, o lóo turu gbɛŋrǝ maarǝ mǝ lǝ láa tɛlɩ ji ri ŋ ji, kǝ ŋnǝ paa nǝ nya fɛɛ nǝ nya vɔrʊrǝ. <verse eid="2CO 4:12" /><verse number="13" style="v" sid="2CO 4:13" />Mǝŋ Wǝŋʊrʊkpǝ wǝ la tɛŋ ǝkǝnǝŋ «Ŋ́ na lɔ ŋ́ no nuŋ, wǝ kǝto ŋ́ na wɛɛlɩ wǝǝ» we, we ŋla ŋkpɛ yǝ la lɔ yǝ lo nuŋ, wǝ kǝto yǝ lah mǝ wɛɛlɩ wǝǝ. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Le cii wǝ ǝkǝnǝŋ Worokoyǝ we ŋ na saanǝ Kulǝtǝyǝ Yesu ŋ no ru rǝ gbɛŋrǝ we, lah pa saanǝ ŋla ŋkpɛ saŋ rǝ Yesu, kǝ ŋ fǝ ŋlǝ mǝ nǝ ŋ ko nǝ kpǝŋ. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Ŋnǝ kǝto wǝ́ otuyǝ sa yǝ ya yǝ lǝ́ǝ pǝ yǝ ŋ tuu lǝ wǝ, kǝ Worokoyǝ la lɛsiɛrɩwǝ wǝ nya fɛɛ wǝ ŋ ta wǝ ŋ kpii. Mǝŋkǝsa we, enyipǝ pǝ lǝ́ǝ tǝ pǝ naanǝ kpǝŋwǝ pǝ kʊla, kǝ pǝ ŋ ceeni ŋwǝ Worokoyǝ, kǝ pǝ ŋ lɛ pǝ ŋ kǝ ŋwǝ.<verse eid="2CO 4:15" /></para>
  <para style="s">Kǝ lǝ lǝmǝ kpɛɛtɛɛwǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Ŋ wǝ tuwǝ sa kǝto yǝ lǝŋ kpii wɛɛyɔɔwǝ. Wǝ ke ce wǝ ri ǝkǝnǝŋ lah wɛlɛŋrǝ guru lóo ko tɩpɩtɩpɩ we, vɔrʊŋwɛŋrǝ we gbii rǝ ŋlǝŋlǝ lǝh mǝrǝ we, ya lée yee aŋʊŋwɛŋ ji ri ŋ ji. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Duturǝ ɖi lah acʊcʊʊrʊyǝ sa la ya yǝ láa cʊʊrʊ rǝkǝsa we, yǝ lee ce yǝ ri tǝrɛ, wǝ́ yǝ lǝŋ lɛ yǝ panǝ. Paape yǝ ya yǝ láa kpaka lǝ yǝ ŋ koonu otumumuŋmumuŋyǝ rɛ yǝ lǝŋ pa lɛ wǝ. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />Duturǝ ɖi tuwǝ we la ya yǝ lǝ́ǝ rǝŋ we, wǝ lee ri tuwǝ pǝ láa nyɩŋ mǝ nimirǝ, paa wǝ ri rǝ tuwǝ pǝ lǝŋ nyɩŋ mǝ nimirǝ wǝ. Kpiikǝ tuwǝ we pǝ láa nyɩŋ mǝ nimirǝ we, wǝ lǝŋ panǝ, paa tuwǝ we pǝ lǝŋ nyɩŋ mǝ nimirǝ we, wǝ láa panǝ wǝ́ wǝ kpii kǝkpakǝkpa.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Kǝto we, wɛlɛŋrǝ sa lǝ lǝǝmǝ rǝ kǝtǝǝwǝ we, lǝ rǝ mǝŋ bwiirǝ kǝtǝ. Wǝ́ le cii wǝ ǝkǝnǝŋ mǝŋ bwiirǝ sa lǝ pǝlǝ we, lǝ lǝǝmǝ nyarǝwǝ rɛ Worokoyǝ ŋ na tɔ rǝ yulaarǝ. Nyarǝwǝ sa wǝ láa yaa kǝkpakǝkpa. Wǝ́ ŋkǝ anyɩmaasɩpǝ pǝ la tɔ wǝ. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Rǝkǝsa we, la ya yǝ lóo fuu rǝ kǝtǝǝwǝ sa duturǝ ɖi tuwǝ we wǝ ya wǝ láa ca lǝ kpɛɛ ŋpa wǝ kaamǝ ǝkǝnǝŋ Worokoyǝ ŋ ko koonu lǝ wɛlɛŋŋwɛŋrǝ we lǝ rǝ mǝŋ nyarǝwǝ kǝtǝ wǝ. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />Vǝ́ mǝŋ yǝ le ke fii wɛlɛŋŋwɛŋrǝ sa lǝ rǝ mǝŋ nyarǝwǝ kǝtǝ lǝ mǝrǝ we, Worokoyǝ lǝŋ pa nyɩŋ lǝ kǝtaŋkpa. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Kǝceece, ŋlǝ epǝ we le kpii rǝ gǝtǝǝwɛlɛŋrǝ sa we, la ya yǝ lóo fuu mǝŋ eleemumuŋyǝ rɛ yǝ tɛɛ rǝ lǝ kǝtǝ. Ŋkǝ ǝkǝnǝŋ la ya yǝ lǝ́ǝ pǝ́ la nyarǝ lǝh gǝtǝǝwɛlɛŋrǝ sa lo co rǝ, paa we, kǝ la nya fɛɛ lǝ fǝ wɛlɛŋŋwɛŋrǝ we le kpii la tɛɛ mǝŋ kǝkpakǝ kǝtǝ. Mǝŋkǝsa we, kǝ vɔrʊrǝ nya fɛɛ lɔ tukpǝ́wǝ bɔ. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Worokoyǝ ŋwǝŋwǝ ŋ na kpaka lǝ koonu vɔrʊrǝ sa ǝnǝ, wǝ́ ŋ na lɛ ŋ no koonu lǝ na Wɛɛrǝ, kǝ nya fɛɛ ɖi tutagbarǝrǝ goonu lǝ. <verse eid="2CO 5:5" /><verse number="6" style="v" sid="2CO 5:6" />Kǝto we, lǝ lǝǝmǝ turutawǝ eni ri ŋ ni ŋpa, wǝ́ le cii wǝ ǝkǝnǝŋ, kǝ́ la nya le kpii rǝ wɛlɛŋkuukuurǝ sa lǝ mǝrǝ we, leh kǝtiikǝ kǝ tǝ kǝ lǝǝrǝ mǝ Kulǝtǝyǝ. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Duturǝ ɖi la ya yǝ láa saŋ mǝ lɔnuŋrǝ, ŋkǝ rǝ anyɩŋkǝ. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Awo, lǝ lǝǝmǝ turutawǝ ŋpa, wǝ́ wǝ koh poŋ kǝ la ka pwɛyɩ la maa wɛlɛŋrǝ sa, kǝ le ke tii rǝ Kulǝtǝyǝ lǝ kpǝŋ. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Paape wǝ ke ce wǝ ri ǝkǝnǝŋ ŋlǝ le kpii rǝ wɛlɛŋrǝ sa mǝrǝ amaa yǝ la pwɛyɩ yǝ la maa rǝ wǝ́ yǝ le ke tii rǝ Kulǝtǝyǝ lǝ kpǝŋ we, tuwǝ wǝ lǝ lǝ kpuŋkpuruŋ wǝ kaamǝ ǝkǝnǝŋ loh tuwǝ wǝ poŋ mǝ ŋwǝ. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Duturǝ ɖi wǝ kpii kǝ loh kpǝlo la pa ka yaa rǝ Kǝriso la kǝnyɩŋkǝ, kǝ ŋ tɛŋ lǝ wǝkpaŋkpǝ. Mǝŋkǝsa we, nyi ri ŋ nyi láa lɔ no wǝtoomwarakpǝ saŋ rǝ otuyǝ we ŋ ne yee mǝ na wɛlɛŋrǝ, wǝ ke ce wǝ ri ceeceewǝ amaa rɔɔrɔɔwǝ.<verse eid="2CO 5:10" /></para>
  <para style="s">Worokoyǝ la ca ŋlǝ mǝ ŋwǝ le kpii rǝ awɛ saŋ rǝ Kǝriso</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Kpiikǝ le cii tuwǝ Kulǝtǝyǝ lo vusuurǝ ɖi kǝto we, la ya yǝ lǝ́ǝ pǝ́ la nyɩɩ mǝ enyipǝ kǝ pǝ lɔ Dieceeceerǝ we pǝ nuŋ. Worokoyǝ cii lǝ sɩsiɛrɩ, wǝ́ ŋ́ na lɔ ŋ́ no nuŋ nǝ cii lǝ sɩsiɛrɩ rǝ nǝ asiɔŋyǝ mǝrǝ. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Ŋkǝ la ya yǝ láa kaŋ lah wɛ rǝ nǝ enimiyǝ rǝ oo, paa we, la ya yǝ láa kaŋ nǝ gʊŋrǝ we lóo koonu kǝ nǝ fǝ lǝ nǝ faa faawǝ rǝ. Mǝŋkǝsa we, nǝ nyáa nya dierǝ nǝ kpǝlǝŋ nǝ koonu epǝ we pǝ lǝ́ǝ fǝ ǝtǝǝtǝǝtuyǝ pǝ ŋ faa faawǝ, paa pǝ laa nya akaa rǝ ziɔŋrǝ lo otuyǝ wǝ. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Mǝŋ nǝ nya nyɩŋ wǝ ǝkǝnǝŋ ŋlǝ le yeli yufiitǝtuwǝ we, we Worokoyǝ wǝ́ le yeli wǝ lo koonu. Wǝ́ mǝŋ nǝ nya nyɩŋ ǝkǝnǝŋ leh dierǝ mǝ loh tuyeewǝ yǝ lǝǝmǝ duturǝ we, we yǝ lǝǝmǝ duturǝ yǝ koonu nǝ. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Duturǝ ɖi Kǝriso lǝ kǝǝtaawǝ we wǝ ya wǝ lée piemu lǝ, ŋlǝ epǝ we yǝ la nyɩŋ wǝ yǝ le ci ǝkǝnǝŋ nyiyǝ ceŋceŋ ŋ nǝ kpǝ́ rǝ enyikpǝlo lo yurǝ, we wǝ la kaŋ enyikpǝlo pǝ lǝ kpǝ́. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Lǝ kpǝ́ kǝ epǝ we pǝ kpii vɔrʊrǝ pǝ pǝǝ tǝ pǝ tii vɔrʊrǝ pǝ koonu pǝla wɛ, paa kǝ pǝ tii vɔrʊrǝ pǝ koonu yǝ we ŋ nǝ kpǝ́ rǝ pǝlo yuwǝ wǝ́ ŋ na siɛnɩ ŋ na saanǝ rǝ pǝlo yuwǝ wǝ. <verse eid="2CO 5:15" /><verse number="16" style="v" sid="2CO 5:16" />Kǝto fǝ rǝkǝsa mǝ ko we, yǝ lǝŋ tǝ la nyɩŋ nyiyǝ mǝŋ kǝ́ ǝrǝkǝ enyipǝ pǝ láa nyɩŋ nyiyǝ pǝ ŋ fǝ kǝtǝ. Eniyǝ nɔ we, la ka ŋ nyɩŋ Kǝriso mǝŋ kǝ́ enyikpǝlo pǝ ka ŋ nyɩŋ ŋwǝ kǝtǝ. Paa rǝkǝsa we, yǝ lǝŋ tǝ la nyɩŋ ŋwǝ ǝnǝ. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Kǝto mǝŋ nyiyǝ rɛ le yee nyiceŋceŋ mǝ Kǝriso we, yǝ we la siɛrɩ le yee nyiŋwɛŋyǝ. Otukuukuuyǝ we yǝ la pa tɛlɩ, a lǝŋ nyɩŋ, otuŋwɛŋyǝ yǝ lǝ pǝ. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Ŋyǝ otuyǝ sa kpǝlo yǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ, ŋwǝ yǝ we ŋ na ca ŋlǝ mǝ ŋwǝ ŋ ne kpii rǝ awɛ saŋ rǝ Kǝriso wǝ. Ŋwǝ ŋ ne kpii lǝ anǝnɛyǝ sa kǝ lo koonu kǝ enyipǝ pǝ nya fɛɛ pǝ ca awɛ pǝ kpii mǝ ŋwǝ. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Duturǝ ɖi Worokoyǝ ŋwǝŋwǝ ŋ ka ŋ ca ŋpǝ mǝ anyɩmaasɩpǝ mǝ ŋ kpii rǝ awɛ saŋ rǝ Kǝriso, laa ka ŋ yɩrɩ pǝlo oturɔɔrɔɔyǝ. Ŋwǝ ŋ nǝ fǝ nyuŋceŋceŋkpǝ la anǝnɛyǝ sa ŋ ne kpii lǝ le yee.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />Kǝto Kǝriso ŋ ne kpii lǝ la pa wɛɛlɩ rǝ na nyɩŋrǝ. Wǝ tǝ wǝ lǝ rǝ mǝŋ Worokoyǝ ŋwǝŋwǝ ŋ ya ŋ náa wɛɛlɩ mǝ nǝ saŋ rǝ lǝ. Kǝto la ya yǝ láa tɔɔ yǝ ŋ kpɛɛ nǝ rǝ Kǝriso la nyɩŋrǝ kǝ nǝ tɛɛnɩ nǝ yee nyuŋceŋceŋ mǝ Worokoyǝ. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Kǝriso lee yee turɔɔrɔɔwǝ rɛ ŋ nyɩŋ, paape Worokoyǝ lǝ fǝ loh oturɔɔrɔɔyǝ la tɛɛ rǝ ŋwǝ. Mǝŋkǝsa we, saŋ rǝ Kǝriso we, kǝ la nya fɛɛ le yee enyikʊʊpǝ rǝ Worokoyǝ la kǝnyɩŋkǝ.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Kpiikǝ la ya yǝ lée yee anǝnɛyǝ yǝ ŋ kʊla mǝ Worokoyǝ kǝto we, la ya yǝ lée ci yǝ ŋ kaŋ nǝ ǝkǝnǝŋ: Nǝ paa maa lɛsiɛrɩwǝ sa Worokoyǝ ŋ ne yee lǝ wǝ pǝlǝ wǝ co. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Duturǝ ɖi Worokoyǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="2CO 6:2">«Kǝ́ eniyǝ yǝ lo ro we, wǝ́ ŋ́ cò kǝtukoŋkǝ rǝ lǝ́,</para>
  <para style="q1" vid="2CO 6:2">Kǝ́ alɔkuŋkǝ le eniyǝ yǝ lo ro we, wǝ́ ŋ́ na pa lɔ ŋ́ no koonu lǝ́.»</para>
  <para style="m" vid="2CO 6:2">Kǝto a lǝŋ nyɩŋ, eniyǝ sa yǝ ri eniceeceeceeceeyǝ. Ruŋruŋ wǝ ri alɔkuŋkǝ le jirǝ.<verse eid="2CO 6:2" /></para>
  <para style="s">Gbaraarǝ we gbii rǝ Dieceeceerǝ we la atɛŋkǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Yǝ laa ya yǝ lǝ́ǝ pǝ́ le pe yee tǝrɛ kǝ wǝ pe kpii rɛ la gbaraarǝ, kǝ yǝ we ŋ paa pa nya turɔɔrɔɔwǝ rɛ ŋ tɛŋ ŋ ru rǝ lah anǝnɛyǝ sa. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />Bomu we, rǝ tu ri ŋ tu yǝ lée yee lǝ mǝrǝ we, yǝ láa pɔrʊ lah wɛ yǝ ŋ kaŋ ǝkǝnǝŋ ŋlǝ le ri Worokoyǝ la anǝnɛyeetǝpǝ mǝ kǝ́ yǝ láa nyɩɩ yǝ ŋ tɔ yǝ ŋ yaa ŋpa rǝ acʊcʊʊrʊyǝ mǝrǝ, rǝ enilɛnyɩyǝ mǝrǝ, rǝ akparaayǝ mǝrǝ. <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />Pǝ cùlu lǝ, pǝ tanǝ lǝ, pǝ yili pǝ tɛ̀ɛ rǝ lǝ, le yeli anǝnɛlɛnyɩyǝ yǝ lee tii la wɛ, yǝ laa ka ŋ nya kǝniŋriekǝ la kpɛɛ, kǝtɛŋkǝ kǝ wʊlʊ lǝ. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />Yǝ láa pɔrʊ lah wɛ yǝ ŋ kaŋ mǝ ziɔŋceeceerǝ ǝkǝnǝŋ ŋlǝ le ri Worokoyǝ la anǝnɛyeetǝpǝ mǝ kǝ́ le cii Worokoyǝ wǝ, rǝ lɛtaarǝwǝ mǝrǝ, rǝ wǝceeceeyeekpǝ mǝrǝ. Wɛɛkenikenirǝ gbii gʊla mǝ lǝ, wǝ́ lǝ lǝǝmǝ kǝǝtaapoŋpiwǝ lo koonu enyipǝ. <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />Yǝ láa tɛŋ anʊkɔrǝyǝ le dierǝ. Le kpii vɔrʊrǝ saŋ rǝ Worokoyǝ lo okopiyǝ, wǝ́ yǝ lǝ́ǝ fǝ wǝkʊʊkpǝ mǝŋ akɔŋtuyǝ kǝtǝ yǝ ŋ kǝrǝŋ lah wɛ amaa yǝ ŋ kɔŋ. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />Yǝ láa lɛ yǝ ŋ pɔrʊ lah wɛ yǝ ŋ kaŋ mǝŋkǝsa mǝ eniyǝ we mǝrǝ enyipǝ pǝ ya pǝ lǝ́ǝ kǝ lǝ amaa pǝ ya pǝ lée kpii lǝ kǝyepukǝ wǝ. Rǝ eniyǝ we mǝrǝ enyipǝ pǝ ya pǝ láa wɛɛlɩ rɔɔrɔɔ pǝ ŋ ru rǝ lǝ amaa pǝ ya pǝ láa wɛɛlɩ sɩsiɛrɩ pǝ ŋ ru rǝ lǝ wǝ. Pǝ láa nyɩŋ lǝ rǝ mǝŋ anianiatǝpǝ wǝ́ le ri, paa anʊkɔrǝlǝtǝpǝ wǝ́ le ri kaŋfɩ. <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />Pǝ láa nyɩŋ lǝ rǝ mǝŋ enyipǝ nyiyǝ rɛ ŋ nee ci wǝ, paa enyipǝ pǝ cii lǝ. Pǝ láa nyɩŋ lǝ rǝ mǝŋ enyipǝ pǝ lah ta pǝ kpǝ́ wǝ́ le ri paa le kpii vɔrʊrǝ. Pǝ láa ta lǝ kǝtukoŋkǝ eni ri ŋ ni paa pǝ lǝŋ wʊ lǝ. <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />Pǝ lo koonu yǝ le fii gʊʊpirǝ paape le re yǝ láa nya faawǝ rǝ ko. Pǝ láa nyɩŋ lǝ rǝ mǝŋ ariariatǝpǝ wǝ́ le ri, paa ŋlǝ yǝ lóo toŋ enyipǝ a pǝ ŋ nya pǝla wɛ. Pǝ láa nyɩŋ lǝ rǝ mǝŋ yǝ lǝǝ lǝmǝ tǝrɛ, paa ŋlǝ lǝ lǝǝmǝ otuyǝ kpǝlo wǝ.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />Lǝh ǝtǝŋ Okorɛŋtotǝpǝ, yǝ lo wuru lah ziɔŋrǝ yǝ lo koonu nǝ wǝ́ yǝ la wɛɛlɩ fee yǝ le tíi nǝ. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Yǝ la pɔrʊ yǝ la kaŋ nǝ ǝkǝnǝŋ ŋlǝ yǝ láa taa nǝ kǝǝwǝ, ŋnǝ paa we wǝ lǝ mǝŋ nǝ nyǝŋ taa lǝ kǝǝwǝ. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Ŋ́ ya ŋ́ náa wɛɛlɩ mǝ nǝ mǝŋ kǝ́ tǝyǝ ŋ náa wɛɛlɩ mǝ ne piyǝ kǝtǝ, ŋnǝ ŋkpɛ nǝ yee wǝ nǝ koonu lǝ ǝnǝ, nǝ wuru nǝ ziɔŋrǝ fee nǝ koonu lǝ.<verse eid="2CO 6:13" /></para>
  <para style="s">Nuŋtumuwǝ mǝ wǝnyɩɩnɩkpǝ wǝ lǝŋ koru etii fɛɛwǝ ceŋceŋ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Nǝ pee yee nyiceŋceŋ mǝ epǝ we pǝ lǝŋ sʊma Worokoyǝ. Duturǝ ɖi kǝloŋkǝ rǝ fǝŋ kǝ kpii rǝ wǝkʊʊkpǝ mǝ turɔɔrɔɔwǝ mǝrǝ? Wǝ́ kǝtuuluukǝ rǝ fǝŋ kǝ kpii rǝ wǝnyɩɩnɩkpǝ mǝ nuŋtumuwǝ mǝrǝ? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Nyuŋceŋceŋkpǝ rǝ fǝŋ wǝ kpii rǝ Kǝriso mǝ Satana mǝrǝ? Amaa kǝ́ lo kǝloŋ kǝ kpii rǝ lɔnuŋtǝyǝ mǝ yǝ we ŋ naa lɔ ŋ nuŋ lǝ mǝrǝ? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Kǝ́ lo tu wǝ kpii rǝ Worokoyǝ la nyarǝwǝ mǝ etiŋyǝ mǝrǝ? Duturǝ ɖi ŋlǝ we, le ri Worokoyǝ we ŋ kpii vɔrʊrǝ la nyarǝwǝ. Worokoyǝ ŋwǝŋwǝ la tɛŋ wǝ ǝkǝnǝŋ:</para>
  <para style="q1" vid="2CO 6:16">«Ŋ́ née tii rǝ pǝlǝ mǝrǝ kǝ ŋ́ lɛ ŋ́ saŋ rǝ pǝlǝ mǝrǝ,</para>
  <para style="q1" vid="2CO 6:16">ŋ́ née ri pǝlo Worokoyǝ, kǝ ŋpǝ pǝ ri mǝ kǝkpǝŋkǝ.<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />Kǝto we,</para>
  <para style="q1" vid="2CO 6:17">nǝ tɛlɩ nǝ ru rǝ enyipǝ sa lǝ mǝrǝ, nǝ ruu nǝ cɛ rǝ pǝlǝ kpǝŋ, Ǝtǝ Woroko ŋ na tɛŋ wǝ.</para>
  <para style="q1" vid="2CO 6:17">Nǝ poo ruu tucɩɩwǝ rɛ,</para>
  <para style="q1" vid="2CO 6:17">kǝ ŋmǝ paa ŋ́ nya fɛɛ ŋ́ lɔ nǝ atuu. <verse eid="2CO 6:17" /><verse number="18" style="v" sid="2CO 6:18" />Ŋ́ née ri tǝyǝ ŋ́ koonu nǝ, kǝ nǝ ri epipǝ nǝ koonu mǝ. Ǝtǝ Woroko Kopilǝtǝyǝ ŋ na tɛŋ wǝ.»<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, kǝ́ wǝ ri ǝkǝnǝŋ akayǝ sa pǝ lo co yǝ ri lah anɛŋ we, nǝ pǝ kǝ la lɛrɩ lah wɛ, kǝ rɛ ŋ pǝǝ tǝ ŋ yee otuyǝ we yǝ láa cɩɩrɩ wɛlɛŋrǝ mǝ wɛɛrǝ wǝ. Nǝ pǝ kǝ la nyɩɩ le re lah wɛ kenikeni fee saŋ rǝ Worokoyǝ lo vusuurǝ.<verse eid="2CO 7:1" /></para>
  <para style="s">Pɔlʊ mǝ Okorɛŋtotǝpǝ pǝ la ca awɛ pǝ le kpii</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Nǝ fǝ nǝ ziɔŋrǝ nǝ koonu lǝ. Yǝ lee yee mǝ rɛ lo turɔɔrɔɔwǝ rɛ, yǝ loo koonu kǝ rɛ ŋ lǝǝrǝ lɔnuŋrǝ, yǝ laa lɛ le pieeli rɛ le ri. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Mǝŋ ŋ́ na tɛŋ wǝ ǝnǝ we, ŋkǝ ŋ́ ya ŋ́ náa tɔɔ nǝ bɔrǝ rǝ oo. Duturǝ ɖi ŋ́ na tɛŋ wǝ ŋ́ na pa tɛlɩ ǝkǝnǝŋ yǝ lǝ fǝ lah ziɔŋrǝ yǝ lo koonu nǝ, wǝ ke ri gbɛŋrǝ amaa vɔrʊrǝ mǝrǝ. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Ŋ́ na tɛɛ kpɛɛwǝ rǝ nǝ ŋpa, wǝ́ ŋ́ ya ŋ́ nǝ́ǝ fǝ nǝ mǝ ŋ faa faawǝ. Ŋ́ na nya turutawǝ ŋpa. Mǝŋkǝ́ le kpii rǝ acʊcʊʊrʊyǝ mǝrǝ paape we, ŋ́ na nya faawǝ ŋpa.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Rǝ anʊkɔrǝyǝ we, ǝrǝ kǝ́ yǝ le pe fii Makedonia we, le fee tii la wɛ mǝŋ tɩpɩrɩ. Yǝ la cʊʊrʊ ŋpa, afiakǝ rǝ dǝǝtǝǝrǝ, vurǝ rǝ lah asiɔŋyǝ mǝrǝ. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Paape Worokoyǝ we ŋ née kpii epǝ we pǝ lǝ lǝǝrǝ turutawǝ la wɛɛlɛŋwǝ we, le kpii lǝ wɛɛlɛŋwǝ mǝ Tito lǝ ǝpǝkǝ. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Ŋkǝ Tito lǝ ǝpǝkǝ ceŋceŋ ko wǝ́ ŋ ne kpii lǝ wɛɛlɛŋwǝ sa, paa we, kǝ́ ŋ ne pe tíi lǝ ǝkǝnǝŋ nǝ nye kpii ŋwǝ ŋkpɛ la wɛɛlɛŋwǝ wǝ. Le pe tíi lǝ ǝkǝnǝŋ wǝ ya wǝ láa ca nǝ kpɛɛ ŋpa ŋnǝ nǝ tǝ nǝ nyɩŋ mǝ. La lɛ la wɛɛlɩ lo ru rǝ kǝ́ tuwǝ we nǝ yeli wǝ ya wǝ lée kpii nǝ awɛɛlɩkǝ wǝ, wǝ́ ŋ na tɛŋ ǝkǝnǝŋ ŋnǝ nǝ nya kpaka nǝ tini rǝ, kǝ nǝ kɔɔlʊ mǝ. Ŋ wǝ wǝ lo koonu wǝ́ mǝ faawǝ wǝ la naanǝ wǝ la kʊla ŋpa wǝ.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Ŋ́ cii wǝ ǝkǝnǝŋ kǝfwɛɛkǝ sa ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ kǝ lo koonu nǝ nye fii gʊʊpirǝ. Ŋmǝ paa wǝ laa yaa wǝ lée kpii mǝ awɛɛlɩkǝ. Awo, ŋ́ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ kǝfwɛɛkǝ we ŋ́ ŋʊ̀rʊ ŋ́ manǝ nǝ we kǝ kòonu nǝ fii gʊʊpirǝ tɩpɩrɩ, wǝ́ wǝ kpìi mǝ awɛɛlɩkǝ rǝ eniyǝ we. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Paa ŋ́ ya ŋ́ náa nya faawǝ rǝkǝsa, ŋkǝ kǝ́ nǝ fìi gʊʊpirǝ kǝto, paa rǝ kǝ́ kǝfwɛɛkǝ sa kǝ lo koonu wǝ́ nǝ nya siɛrɩ kǝto. Duturǝ ɖi kǝ́ nǝ fìi gʊʊpirǝ we, Worokoyǝ tɛ̀ɛ wǝ la akaakǝ. Kǝto rǝ lǝh kpǝŋ we, ŋkǝ turɔɔrɔɔwǝ rɛ wǝ́ yǝ le yee mǝ nǝ. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Duturǝ ɖi gʊʊpifiirǝ we Worokoyǝ ŋ na tɛɛ akaakǝ we, lóo koonu wɛɛsiɛrɩwǝ we wǝ lée re nyiyǝ wǝ ŋ ko alɔkuŋkǝ lǝ kpǝŋ. Wǝ́ gʊʊpifiirǝ sa lǝŋ lɛ gbii nyiyǝ la awɛɛlɩkǝ. Paa gʊʊpifiirǝ we lǝŋ siɛrɩ nyiyǝ we, lóo koonu gbɛŋrǝ. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Nǝ gʊʊpirǝ we nǝ nye fii we, la ca Worokoyǝ la kpɛɛ. Rǝkǝsa nǝ yɩrɩ tuwǝ we nǝ nya nya nǝ nyo ru rǝ mǝrǝ we re! Nǝ ya nǝ nyée kpii wɛɛlɛŋwǝ rǝ tuceeceewǝ le eyeekǝ. Nǝ ya nǝ nyǝ́ǝ sǝrǝ kǝfǝrawǝ rǝ otuyǝ we nǝ nye yee wǝ. Nǝ nyǝ fǝ kpɛɛmʊrʊwǝ nǝ nya tɛɛ rǝ turɔɔrɔɔwǝ we pǝ le yee wǝ. Nǝ ya nǝ nyóo suu Worokoyǝ lo vurǝ. Nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ tǝ nǝ nyɩŋ mǝ. Nǝ ya nǝ nyée kpii wɛɛlɛŋwǝ koonu Worokoyǝ la kǝnǝnɛkǝ. Wǝ́ nǝ nyáa ta yǝ we ŋ ne yee turɔɔrɔɔwǝ lo kǝtukoŋkǝ. Rǝ ŋyǝ otuyǝ sa kpǝlo lǝ mǝrǝ we, nǝ nya pɔrʊ nǝ wɛ nǝ nya kaŋ ǝkǝnǝŋ ŋnǝ nǝ nyee ci wǝ la tǝrɛ.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />Kǝto we, kǝfwɛɛkǝ sa ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ we, ŋkǝ yǝ we ŋ ne yee rɔɔrɔɔwǝ amaa yǝ we pǝ le yee mǝ rɔɔrɔɔwǝ kǝto wǝ́ ŋ́ na ŋʊrʊ kǝ. Paa we, ŋ́ na maŋ nǝ kǝ kǝ ŋ́ fǝ ŋ́ pɔrʊ nǝ wɛɛlɛŋwǝ we nǝ lǝǝmǝ nǝ koonu lǝ ŋ́ kaŋ nǝ rǝ Worokoyǝ la kǝnyɩŋkǝ rǝ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Kǝto we, turuwǝ wǝ la ta lǝ.</para>
  <para style="p" vid="2CO 7:13">Fǝ kʊla mǝ turutawǝ sa we, yǝ lǝ tǝ yǝ la nya faawǝ ŋpa yǝ le teeri saŋ rǝ Tito la faawǝ we ŋ nyà wǝ. Duturǝ ɖi nǝ kpǝlo nǝ nya taarǝ na lɛrǝ. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Ŋ́ nǝ fǝ nǝ ŋ́ na faa faawǝ rǝ Tito la kǝnyɩŋkǝ, wǝ loo co mǝ nʊŋsɔɔwǝ. Duturǝ ɖi arekpeyǝ we ŋ na ca ŋ́ no ru rǝ nǝ rǝ Tito la kǝnyɩŋkǝ we, wǝ la nyɩnɩ ǝkǝnǝŋ anʊkɔrǝyǝ yǝ lǝǝwe. Wǝ tǝ wǝ lǝ rǝ mǝŋ kǝ́ yǝ lée tíi nǝ anʊkɔrǝyǝ eni ri ŋ ni wǝ. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Mǝŋkǝsa we, vǝ́ la taalǝ kǝ́ nǝ kpǝlo nǝ cò kǝtukoŋkǝ rǝ ŋwǝ nǝ fǝ̀, wǝlǝkpǝ we nǝ fǝ̀ wɛɛpɛɛlɩwǝ mǝ vurǝ nǝ lɔ̀ ŋwǝ nǝ fǝ̀ we, nǝ kǝǝtaawǝ we ŋ lǝǝmǝ ŋ koonu nǝ we, wǝ ŋ tǝ wǝ ŋ naanǝ wǝ ŋ kʊla. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Ŋ́ ya ŋ́ náa nya faawǝ mǝ kǝ́ ŋ́ nóo koru atɛɛ kpɛɛwǝ rǝ nǝ rǝ tu ri ŋ tu lǝ mǝrǝ wǝ.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Pǝ lǝ kpǝ gbǝrǝ koonu alɔnuŋtǝpǝ la wǝcakukpǝ we kpǝlo rǝ Yudeya</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Lǝh ǝtǝŋ, la ya yǝ lǝ́ǝ pǝ́ nǝ ci wǝceeceekpǝ we Worokoyǝ ŋ ne yee alɔnuŋtǝpǝ la wǝcakukpǝ we kpǝlo rǝ Makedonia wǝ. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />Arianyɩŋmumuŋyǝ rɛ yǝ le tie pǝ yǝ la yɩrɩ, paape mǝŋ pǝla ariamumuŋyǝ we, pǝ lǝ fǝ faamumuŋwǝ rɛ pǝ lo koonu otuyǝ, wǝ́ pǝ la pɔrʊ pǝ la kaŋ ǝkǝnǝŋ ŋpǝ pǝ lǝŋ kʊʊ otuyǝ. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Ŋ́ ya ŋ́ née ri ɖaŋsieyǝ ǝkǝnǝŋ pǝ lo koonu otuyǝ mǝŋ kǝ́ pǝ lóo koru wǝ, kʊraa pǝ lo koonu pǝ lǝ sǝ pǝ la tɛlɩ, wǝ́ pǝ la lɛ pǝle yee wǝ mǝ ziɔŋrǝ fee. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />Pǝ la lɛ pǝ lǝ pǝ́ pǝ lo ru rǝ lǝ kpuŋkpuruŋ ǝkǝnǝŋ ŋlǝ lo koonu pǝ la gʊŋrǝ kǝ ŋpǝ ŋkpɛ pǝ nya fɛɛ pǝ kʊla rǝ otoŋkǝ we pǝ leh yee pǝ koonu alɔnuŋtǝpǝ we rǝ Yudeya wǝ. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Pǝ le yee wǝ pǝ le teeri kǝ́ lǝ kǝ ŋ kǝ wǝ wǝ. Ŋpǝŋpǝ pǝ fǝ̀ pǝla wɛ pǝ kòonu Kulǝtǝyǝ kpɛŋ, wǝ́ saŋ rǝ Worokoyǝ lǝ kǝǝpǝ́wǝ we, pǝ fǝ pǝ la wɛɛ pǝ koonu lǝ. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Kǝto yǝ le kpii Tito la wɛɛlɛŋwǝ ŋ siɛnɩ ŋ pǝ nǝ kpǝŋ kǝ ŋ pe kpii nǝ wɛɛlɛŋwǝ, kǝ nǝ kpǝ gbǝrǝ sa nǝ ka lɛ mǝ ziɔŋceeceerǝ. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Kpiikǝ nǝ nya lɔ otuyǝ kpǝlo ŋpa we: lɔnuŋrǝ, eciawɛɛlɩkǝ, otuciyǝ mǝ wɛɛlɛŋwǝ rǝ tu ri ŋ tu lǝ mǝrǝ mǝ kǝǝtaawǝ we nǝ nya nya nǝ nyo ru rǝ lǝh kpǝŋ, kǝto nǝ fǝ tuwǝ nǝ lǝǝmǝ nǝ pɔrʊ nǝ wǝceeceeyeekpǝ nǝ kaŋ saŋ rǝ gbǝrǝ sa.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Ŋkǝ ŋ́ ya ŋ́ née si nǝ rǝ. Paa we, kǝ́ ŋ́ ya ŋ́ náa wɛɛlɩ mǝ ŋ ru rǝ apʊŋpwapǝ la wɛɛlɛŋwǝ we, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ yɩrɩ mǝŋ nǝ kǝǝtaawǝ wǝ ri rǝ kǝǝtaapoŋpiwǝ wǝ? <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Duturǝ ɖi nǝ cii loh Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ we. Kaŋfɩ kǝ lǝǝmǝ na wɛ, paape ŋnǝ kǝto wǝ́ ŋ na siɛrɩ ŋ ne yee riariatǝyǝ kǝ ŋ nya fɛɛ ŋ koonu kǝ nǝ siɛrɩ nǝ yee enyipǝ pǝ lǝǝmǝ pǝla wɛ saŋ rǝ na ariaayǝ sa.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Tuwǝ ŋmǝ ŋ́ na nyɩŋ rǝ dierǝ sa lǝ mǝrǝ wǝ kaamǝ wǝ ǝnǝ: Acɛŋkǝ we, ŋnǝ nǝ ke ri enyisǝsǝŋpǝ nǝ tɛnɩ ǝkǝnǝŋ ŋnǝ nǝ nyée yee kǝnǝnɛkǝ sa nǝ toŋ alɔnuŋtǝpǝ la wǝcakukpǝ, wǝ́ ŋnǝ nǝ ka lɛ nǝ ri enyisǝsǝŋpǝ nǝ tìe kǝnǝnɛkǝ sa le eyeekǝ. Wǝ ponu kǝ nǝ yee kǝnǝnɛkǝ sa nǝ ka lɛ rǝ. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />Kǝto rǝkǝsa we, nǝ yee kǝnǝnɛkǝ sa nǝ ka lɛ rǝ mǝŋ kǝ́ nǝ nyóo koru wǝ. Nǝ fǝ nǝ tɛɛ rǝ nǝ wɛ kǝ nǝ yee kǝ nǝ ka lɛ rǝ mǝŋ kǝ́ nǝ tɛnɩ ǝkǝnǝŋ ŋnǝ nǝ nyée yee kǝ wǝ. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Duturǝ ɖi mǝŋ ǝ lǝ fǝ ziɔŋceeceerǝ o lo koonu tuwǝ we, Worokoyǝ láa lɔ tukoonuwǝ sa. Tuwǝ ǝ lǝǝmǝ wǝ́ ŋ nǝ́ǝ pǝ́ lǝ́ wǝ, lǝŋ pǝ́ tuwǝ ǝ lǝǝ lǝmǝ wǝ.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Ŋkǝ ŋ́ reemǝ nǝ toŋ nǝ ǝtǝŋpǝ kǝ ŋnǝ paa nǝ fii ariaayǝ oo, paa wǝ kaamǝ kǝ yǝ we ŋ no koonu tuwǝ mǝ yǝ we ŋ na lɔ tuwǝ we pǝ kaa rǝ. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Rǝ wǝlǝkpǝ sa lǝ mǝrǝ we, otuyǝ we yǝ lo to nǝ yǝ lo turu we, yǝ lóo toŋ epǝ we yǝ ya yǝ lée yee ariaayǝ wǝ. Kaa wǝǝ vǝ́ jirǝ rɛ tǝrɛ wǝ le yee nǝ ariaayǝ, wǝ́ ŋpǝ paa yǝ lo to pǝ yǝ lo turu we, eyǝ we yǝ lo to pǝ yǝ turu we, yǝ lóo toŋ nǝ. O lóo turu wǝ la ka kaa rǝ. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Yǝ we ŋ wʊ̀ʊ keeriwǝ ŋpa we, wǝ loo to ŋwǝ wǝ turu, wǝ́ yǝ we ŋ wʊ̀ʊ keeriwǝ kpekperee we, wǝ lee yee na ariaayǝ».<verse eid="2CO 8:15" /></para>
  <para style="s">Tito mǝ nǝ ǝtǝŋpǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Worokoyǝ le yeekǝ mǝ kǝ́ ŋ nǝ fǝ otoŋkǝ sa lo tuwǝ ŋ ne kpii Tito rǝ ziɔŋrǝ kǝ ŋ nya fɛɛ ŋ toŋ nǝ mǝŋ kǝ́ ŋ́ kǝ ŋ pǝ́ ŋ́ toŋ kǝtǝ. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Kǝ́ le tìi Tito ŋ pǝ nǝ kpǝŋ we, lǝǝ sǝ́ŋ. Wɛɛlɛŋwǝ rɛ ke wǝ ke kpii rǝ nǝ mǝrǝ kǝto wǝ́ ŋ yili kǝtǝrǝceŋceŋ ŋ kǝ ŋ pǝ nǝ kpǝŋ. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Yǝ le kpii paanʊyǝ rɛ yǝ la kʊla mǝ ŋwǝ. Ŋwǝ paanʊyǝ sa wǝ́ alɔnuŋtǝpǝ la acakuyǝ kpǝlo pǝ lǝ́ǝ kǝ rǝ na kǝnǝnɛkǝ koonu Dieceeceerǝ we wǝ. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Tǝ fǝ kʊla we, alɔnuŋtǝpǝ la acakuyǝ we kpǝlo pǝ la pɔrʊ ŋwǝ ŋ siimǝ lǝ rǝ otukoonuyǝ sa lǝ ǝsǝpǝtɛlɩkǝ. Ŋyǝ anǝnɛyǝ sa wǝ́ la ya yǝ lée yee koonu Kulǝtǝyǝ ŋwǝŋwǝ na nyɩŋrurǝ. Eniyǝ we wǝ la lɛ wǝ la pɔrʊ loh otoŋkǝ lǝ kǝǝpǝ́wǝ wǝ la kaŋ. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />Yǝ laa ya yǝ lǝ́ǝ pǝ́ enyipǝ pǝ pa ya pǝ ŋ wɛɛlɩ rɔɔrɔɔ pǝ ŋ ru rǝ kǝ́ yǝ lée re sɩkamumuŋyǝ sa lǝ fǝ wǝ. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />La ya yǝ lǝ́ǝ pǝ́ le yee tuceeceewǝ, ŋkǝ rǝ Kulǝtǝyǝ la kǝnyɩŋkǝ ceŋceŋ, paa mǝŋ anyɩmaasɩpǝ la kǝnyɩŋkǝ. <verse eid="2CO 8:21" /><verse number="22" style="v" sid="2CO 8:22" />Yǝ lǝ tǝ yǝ le kpii paanʊpʊŋpwayǝ rɛ yǝ la kʊla mǝ pǝ. Yǝ le tie ŋwǝ yǝ la yɩrɩ kǝpakakǝpaka, wǝ́ yǝ la nyɩŋ wǝ yǝ le ci rǝ ŋwǝ ǝkǝnǝŋ lǝǝmǝ wɛɛlɛŋwǝ koonu Worokoyǝ la kǝnǝnɛkǝ eni ri ŋ ni. Rǝkǝsa we, tǝ ya lée kpii wɛɛlɛŋwǝ mǝ ŋ kʊla mǝ ŋ teeri, duturǝ ɖi la tɛ̀ɛ kpɛɛwǝ rǝ nǝ ŋpa. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Tito we, ŋwǝ ŋ ri mǝ kɛrɩnǝnɛyeetǝyǝ, wǝ́ ŋ náa lɛ mǝ ŋ yee anǝnɛyǝ mǝ ŋ kʊla mǝ mǝ rǝ nǝ kpǝŋ. Lah apaanʊpǝ we eyipǝ we, ŋpǝ pǝ ri alɔnuŋtǝpǝ la acakuyǝ we kpǝlo le enyikpiipǝ. Pǝ ya pǝ lée yee anǝnɛyǝ koonu Kǝriso la nyɩŋrurǝ. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Nǝ pɔrʊ nǝ kaŋ pǝ ǝkǝnǝŋ ŋnǝ nǝ nyáa taa pǝlǝ kǝǝwǝ, kǝ alɔnuŋtǝpǝ pǝ nyɩŋ wǝ pǝ ci ǝkǝnǝŋ ŋkǝ tuŋtuŋ wǝ́ lǝ fǝ̀ nǝ la fàa faawǝ wǝ.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">Nǝ kpii mǝ faawǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Ko rǝ otukoonuyǝ we nǝ nyoh koonu alɔnuŋtǝpǝ we rǝ Yudeya we, wǝ lǝǝ tǝ wǝ pǝ́ kǝ ŋ́ ŋʊrʊ tǝrɛ ŋ́ maŋ nǝ ŋ́ ru rǝ wǝ. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Duturǝ ɖi ŋ́ cii wǝ ǝkǝnǝŋ nǝ ri enyipǝ pǝ lǝ́ǝ pǝ́ pǝ ŋ toŋ wǝ. Ŋ́ nǝ fǝ nǝ ŋ́ na faa faawǝ ŋ́ ne tíi Amakedoniatǝpǝ ǝkǝnǝŋ: «Lǝh ǝtǝŋpǝ we rǝ Akayi pǝ la kpaka pǝ ya pǝ lǝ́ǝ rǝŋ pǝ koonu otuyǝ ǝrǝ acɛŋkǝ.» Kǝto nǝ wɛɛlɛŋwǝ sa wǝ la ta alɔnuŋtǝpǝ la acakututuruyǝ we le enyipǝ wa lo turuwǝ. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Ŋ́ ne kpii apaanʊpǝ sa ŋ́ na maŋ nǝ. Kǝto nǝ kpaka nǝ tii mǝŋ kǝ́ ŋ́ tɛnɩ wǝ wǝ, kǝ pǝ pa nyɩŋ ǝkǝnǝŋ faawǝ we ŋ́ fǝ̀ nǝ ŋ́ faa we, wǝ lee ri niarǝ. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Mǝŋ ŋkǝ kaa wǝǝ we, vǝ́ ŋlǝ mǝ Amakedoniatǝpǝ yǝ lǝ pǝ wǝ́ pǝ laa pa nyɩŋ nǝ nya kpaka nǝ ya nǝ nyǝ́ǝ rǝŋ we, o lóo turu yǝ le fii nʊŋsɔɔwǝ rǝ dierǝ sa. Wǝ lée ri ŋnǝ ŋkpɛ nǝ nʊŋsɔɔwǝ. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Tuwǝ kǝto ŋ́ ne kpii apaanʊpǝ sa la wɛɛlɛŋwǝ pǝ coŋ pǝ pǝ nǝ kpǝŋ wǝǝ, kǝ pǝ pa kpaka nǝ otukoonuyǝ we nǝ cò garǝ pǝ tǝnǝ. Mǝŋkǝsa we, yǝ lóo to yǝ kpɛɛ kpɛŋ kǝ ŋ́ ci ǝpǝ. Ŋ wǝ wǝ láa kaŋ ǝkǝnǝŋ ŋnǝ nǝ nyǝ fǝ nǝ ziɔŋrǝ fee nǝ nyo koonu yǝ, wǝ́ ŋkǝ pǝ la nyɩɩnɩ nǝ rǝ.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Kǝ nǝ ci wǝ ǝkǝnǝŋ, yǝ we ŋ na rʊʊ tuwǝ tɩpɩrɩ we, lah pa fa tɩpɩrɩ, wǝ́ yǝ we ŋ na rʊʊ tuwǝ ŋpa we, lah pa fa ŋpa. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Nyi ri ŋ nyi ŋ koonu mǝŋ kǝ́ na ziɔŋrǝ le tíi ŋwǝ ŋ koonu wǝ. Poo koonu tuwǝ a lɛ kǝ wǝ kpii lǝ́ awɛɛlɩkǝ amaa wǝ pee ri pǝ le si lǝ́ rǝ kpɛŋ wǝ́ o lo koonu. Duturǝ ɖi Worokoyǝ láa taa yǝ we ŋ nóo koonu tuwǝ mǝ faawǝ wǝ. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Worokoyǝ lǝǝmǝ okopiyǝ ŋ nǝ́ǝ fǝ otuceeceeyǝ kpǝlo ŋ koonu nǝ. Mǝŋkǝsa we, nǝ nyǝ́ǝ lǝmǝ tuwǝ we wǝ lóo ro nǝ eni ri ŋ ni wǝ. Nǝ nyǝ́ǝ lǝmǝ otuyǝ ŋpa nǝ teeri, kǝ nǝ nya fɛɛ nǝ fǝ yǝ nǝ yee wǝnǝnɛceeceekpǝ kpǝlo. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Mǝŋ kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="2CO 9:9">«La lɛmɩ no otuyǝ lo koonu ariariatǝpǝ.</para>
  <para style="q1" vid="2CO 9:9">Ne wǝceeceeyeekpǝ wǝ la kpɛɛ kǝkpakǝkpa.»<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />Worokoyǝ we ŋ nóo koonu tɛɛtɛɛkpɛŋtǝyǝ lo oturʊʊyǝ, wǝ́ ŋ náa lɛ mǝ ŋ koonu ne keeriwǝ ŋ ri we, lóo koonu nǝ oturʊʊyǝ ŋnǝ ŋkpɛ. Lóo koonu kǝ yǝ naanǝ yǝ kʊla. Mǝŋkǝsa we, nǝ wǝceeceeyeekpǝ wǝ láa nyɩŋ ǝtǝnǝyǝ ŋpa. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Nǝ nyáa nya nǝ wɛ rǝ tu ri ŋ tu lǝ mǝrǝ, kǝ nǝ nya fɛɛ nǝ tǝ nǝ mǝ yee wǝceeceekpǝ rǝ ko. Mǝŋkǝsa we enyipǝ wa pǝ leh mǝ ceeni Worokoyǝ rǝ otuyǝ we nǝ nyo koonu lǝ lo ko koonu pǝ wǝ. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />Duturǝ ɖi otukoonuyǝ la kǝnǝnɛkǝ sa nǝ ya nǝ nyée yee we, ŋkǝ wǝ loh toŋ alɔnuŋtǝpǝ rǝ otuyǝ we yǝ ya yǝ lée yee pǝ la ariaayǝ ceŋceŋ ko, paa wǝ lǝ́ǝ tǝ wǝ ŋ toŋ kǝ enyipǝ pǝ ŋ fǝ eceenikǝ pǝ ŋ koonu Worokoyǝ. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Pǝ láa nyɩŋ nǝ otuyǝ sa nǝ nyo koonu lo okuruyǝ pǝ ci, eniyǝ we pǝ lǝ fǝ ǝkǝkǝ pǝ lo koonu Worokoyǝ. Pǝ láa lɛ pǝ nyɩŋ wǝ pǝ ci ǝkǝnǝŋ ŋnǝ nǝ nyóo co kǝtukoŋkǝ rǝ Kǝriso le Dieceeceerǝ we. Pǝ láa lɛ pǝ fǝ ǝkǝkǝ pǝ koonu ŋwǝ mǝ kǝ́ nǝ nyǝ fǝ nǝ otulǝmǝyǝ nǝ ya nǝ nyée yee wǝceeceekpǝ nyǝ ŋ koonu pǝ mǝŋ enyikpǝlo kǝto. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Mǝŋkǝsa we, pǝ lah mǝ mwɛŋ nyuŋkpǝ pǝ ŋ koonu nǝ, kǝ pǝ ŋ pɔrʊ pǝlǝ kǝǝtaawǝ we pǝ lǝǝmǝ pǝ ŋ kaŋ nǝ, mǝ kǝ́ Worokoyǝ ŋ ne yee nǝ lɛsiɛrɩmumuŋwǝ sa kǝto. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Kǝ le ceeni Worokoyǝ rǝ no tukoonumumuŋwǝ sa wǝ teeri tu ri ŋ tu wǝ.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Pɔlʊ la kɔɔlʊ le kpii na anǝnɛyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Ŋmǝ Pɔlʊ, ŋ́ ya ŋ́ née ci mǝ ŋ kaŋ nǝ saŋ rǝ Kǝriso lǝ wǝlǝtaarǝkpǝ mǝ ne wǝceeceeyeekpǝ. Ŋmǝ yǝ ǝnǝ enyipǝ pǝ láa tɛŋ ǝkǝnǝŋ vǝ́ ŋ́ yaa rǝ nǝ kpǝŋ niminimi we, ŋ́ nǝŋ koru awɛɛlɩ, paa vǝ́ ŋ́ nǝǝ kǝlǝ mǝ nǝ we, wǝ́ ŋ́ náa wɛɛlɩ mǝ okopiyǝ wǝ. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Ŋ́ ya ŋ́ náa tɔɔ mǝ ŋ kpɛɛ nǝ, nǝ poo koonu kǝ ŋ́ pa wɛɛlɩ mǝ nǝ mǝ okopiyǝ vǝ́ ŋ́ nǝ pǝ pǝ nǝ kpǝŋ, mǝŋ kǝ́ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ pe yee wǝ mǝ epǝ we pǝ ya pǝ lóo pu wǝ ǝkǝnǝŋ ŋlǝ la ya yǝ lée yee otuyǝ mǝŋ ǝrǝkǝ le enyipǝ kǝtǝ wǝ. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Le cii wǝ ǝkǝnǝŋ kǝceece anyɩmaasɩpǝ wǝ́ le ri mǝŋ enyikpǝlo kǝtǝ, paa yǝ laa ya yǝ láa kɔŋ mǝŋ anyɩmaasɩpǝ kǝtǝ. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Duturǝ ɖi akɔŋtuyǝ we yǝ lǝ́ǝ fǝ yǝ ŋ kɔŋ yǝ lee ri anyɩmaasɩpǝ la anɛŋyǝ. Lah akɔŋtuyǝ we lo okopiyǝ yǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ. Yǝ lóo toŋ lǝ ǝ yǝ ŋ koru awɔɔ kǝǝkpǝlǝtǝyǝ la afɛɛyǝ we yǝ lɛnyɩ efiikǝ wǝ. Yǝ láa wɔɔ anianiatǝyupuyǝ. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Okopi ri ŋ okopi yǝ láa rɛɛrɩ mǝ yǝla wɛ, wǝ́ yǝ ya yǝ lǝ́ǝ sǝŋ enyipǝ la gʊŋrǝ kǝ pǝ pee ci Worokoyǝ we, yǝ lǝ́ǝ pǝlǝ ŋyǝ ŋkpɛ. Yǝ láa lɔ anyɩmaasɩpǝ lo oyupuyǝ kpǝlo kǝ la nya fɛɛ lo koonu kǝ pǝ co kǝtukoŋkǝ rǝ Kǝriso. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Yǝ la kpaka le tini rǝ, vǝ́ nǝ kǝtukoŋcokǝ sa kǝ lo ko to kǝ la lɛ we, o lóo turu yǝ loh koonu yǝ we ŋ nǝŋ co kǝtukoŋkǝ lo tukoŋtawǝ.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Nǝ co nimirǝ kǝ nǝ nyɩŋ kǝ́ otuyǝ yǝ lǝ yǝ fǝ wǝ. Mǝŋ rɛ la lɔ lo nuŋ ǝkǝnǝŋ ŋwǝ ŋ ri Kǝriso la nɛŋyǝ we, yǝ we ŋ ci wǝ sɩsiɛrɩ ǝkǝnǝŋ mǝŋ ŋ ri Kǝriso la nɛŋyǝ we, ŋla ŋkpɛ le ri Kǝriso la anɛŋpǝ. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Wǝ ke ce wǝ ri ǝkǝnǝŋ ŋ́ nǝ́ǝ fǝ okopiyǝ we Kulǝtǝyǝ ŋ no koonu lǝ ŋ́ faa faawǝ ŋ́ sǝ ŋ́ tɛlɩ tɩpɩrɩ we, ŋ́ née yee wǝ ŋ́ nǝŋ suu nʊŋsɔɔwǝ. Duturǝ ɖi lo koonu lǝ okopiyǝ sa kǝ lǝ fǝ lo toŋ nǝ rǝ, ŋkǝ kǝ lǝ pǝlǝ nǝ rǝ. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Wǝ lee ri ǝkǝnǝŋ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ cɩɩlɩ nǝ mǝ wǝfwɛɛkpǝ we ŋ́ ya ŋ́ náa ŋʊrʊ mǝ ŋ maŋ nǝ wǝ. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Duturǝ ɖi enyipǝ pǝ láa tɛŋ ǝkǝnǝŋ: «Pɔlʊ la wǝfwɛɛkpǝ wǝ lǝǝmǝ nuruwǝ, wǝ́ wǝ lɛnyɩ. Paa vǝ́ lo po tuu lǝ we, o turu la yɔ, o turu ne etieyǝ yǝ lǝǝ tǝ yǝ ri tǝrɛ.» <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Yǝ we ŋ ya ŋ náa tɛŋ dierǝ sa ǝnǝ ŋ ci wǝ ǝkǝnǝŋ wǝlǝkpǝ we lǝ lǝ rǝ wǝlǝǝrǝkpǝ wǝ́ yǝ la ŋʊrʊ wǝfwɛɛkpǝ sa we, kaa wǝǝ vǝ́ yǝ lǝ́ǝ pǝ pǝ nǝ kpǝŋ we, kǝ́ loh otuyeeyǝ yǝ lǝ́ǝ tǝ yǝ ŋ lǝ wǝǝ.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Yǝ lǝŋ tu turuwǝ lǝ fǝ lah wɛ la ca mǝ amaa la kaamǝ epǝ we pǝ láa kaŋ pǝla wɛ wǝ. Ŋpǝŋpǝ pǝ lǝ́ǝ fǝ pǝla wɛ pǝ ŋ yee tukaawǝ pǝ ŋ kaa pǝla wɛ. Ŋpǝ enyipǝ sa pǝ lee ci tǝrɛ. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Ŋlǝ paa we, yǝ lǝŋ fǝ lah wɛ la faa faawǝ le ke teeri. Mǝŋ yǝ lǝ́ǝ fǝ lah wɛ la faa faawǝ we, yǝ le yee wǝ yǝ la tɛɛ rǝ kǝnǝnɛkǝ we Worokoyǝ ŋ ne kpii lǝ la bɛŋrǝ. Ŋ wǝ wǝ koonu wǝ́ yǝ lo po ru ǝrǝ nǝ kpǝŋ wǝ. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Kǝ́ yǝ lo po ru ǝrǝ nǝ kpǝŋ we, yǝ lee yi la nyapǝ bɛŋrǝ sa. Wǝ́ kǝceece ŋlǝ le ri enyisǝsǝŋpǝ yǝ lo po tuu nǝ mǝ Kǝriso le Dieceeceerǝ we. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Yǝ lǝŋ sǝ bɛŋrǝ la tɛlɩ lǝ kǝ fǝ rɛ la kǝnǝnɛkǝ la faa faawǝ. Paa yǝ la tɛɛ kpɛɛwǝ ǝkǝnǝŋ, mǝŋ nǝ lɔnuŋrǝ la naanǝ la kʊla we, o lóo turu lah kǝnǝnɛkǝ kǝ lǝ tǝ kǝ la ta kǝ le kpii rǝ nǝ kpǝŋ. Paa yǝ lǝŋ nyapǝ bɛŋrǝ we Worokoyǝ ŋ nǝ tǝnǝ lǝ wǝ. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />Mǝŋkǝsa we, yǝ lǝ́ǝ fǝ Dieceeceerǝ we la ka tɛŋ rǝ akaayǝ we yǝ kpii rǝ nǝ kǝmaakǝ wǝ. Mǝŋkǝsa we yǝ lǝŋ pǝ kǝ fǝ rɛ la kǝnǝnɛkǝ ŋ ne yee rǝ na nɛŋ fɛɛwǝ la faa faawǝ. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />«Mǝŋ rɛ lǝ́ǝ fǝ na wɛ ŋ faa faawǝ we, mǝ ŋ faa faawǝ rǝ tuwǝ we Kulǝtǝyǝ ŋ ne yee wǝ.» <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Ǝlǝ lo tuwǝ wǝ ponu mǝ Kulǝtǝyǝ wǝ? Ŋkǝ yǝ we ŋwǝŋwǝ ŋ nǝ́ǝ kǝ na wɛ wǝ, paa yǝ we Kulǝtǝyǝ ŋwǝŋwǝ ŋ nǝ́ǝ kǝ wǝ.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Pɔlʊ le yi la tɛɛ rǝ anianiatǝnyikpiipǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Rǝkǝsa nǝ nya lɛtaarǝwǝ nǝ koonu mǝ, ŋ́ nah wɛɛlɩ mǝŋ yufiitǝyǝ kǝtǝ. Awo nǝ nya lɛtaarǝwǝ nǝ koonu mǝ. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Ŋ́ née yee wǝtɛlɩkpǝ rǝ nǝ yurǝ mǝŋ wǝtɛlɩkpǝ we wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ kǝtǝ wǝ. Duturǝ ɖi ŋ́ na tɔɔ nǝ ŋ́ no koonu nuŋyǝ ceŋceŋ, ŋwǝ ŋ ri Kǝriso. Wǝ́ ŋ́ nǝ pǝ́ ŋ́ pɔrʊ nǝ ŋ́ kaŋ ŋwǝ mǝŋ gɔrʊpipoŋpirǝ we vee ci pǝrǝŋyǝ kǝtǝ. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Paape ŋ́ ya ŋ́ nóo suu vurǝ ǝkǝnǝŋ rɛ lǝ́ǝ pǝ tǝǝnǝ nǝ, kǝ nǝ ruu nǝ cɛ rǝ Kǝriso lǝ kpǝŋ kǝ nǝ pǝǝ tǝ nǝ sʊma ŋwǝ mǝ anʊkɔrǝyǝ mǝ ziɔŋlɛrɩrǝ, mǝŋ kǝ́ kǝpɔɔkǝ kǝ pǝlǝ kǝ tǝ̀ǝnǝ Awa mǝ wǝpiekpǝ kǝtǝ. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Duturǝ ɖi mǝŋ nyiyǝ rɛ la pa tɛŋ Yesupʊŋpwayǝ rɛ le dierǝ la cɛkɛlɛ mǝ yǝ we le dierǝ la tɛnɩ le tíi nǝ amaa nǝ nya lɔ wɛɛrǝ rɛ la cɛkɛlɛ mǝ ɖǝ we nǝ lɔ̀ amaa nǝ nya lɔ Dieceeceerǝ rɛ la cɛkɛlɛ mǝ ɖǝ we nǝ lɔ̀ we, ŋ́ nyɩŋ wǝ ǝkǝnǝŋ nǝ nyáa lɔ otuyǝ sa sɩsiɛrɩ. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />Paa ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ ŋpǝ enyipǝ sa nǝ nyáa nyɩŋ ǝkǝnǝŋ pǝ ri enyikpiimumuŋpǝ rɛ kwa we, pǝ lee teeri mǝ rǝ tǝrɛ pwi. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Wǝ ke ce wǝ ri ǝkǝnǝŋ ŋmǝ ŋ́ nǝŋ ci atɛŋ we, mǝŋ otuciyǝ paa ŋ́ cii yǝ. Wǝ́ yǝ la pɔrʊ wǝ yǝ la kaŋ nǝ rǝ eni ri ŋ ni rǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="2CO 11:6" /><verse number="7" style="v" sid="2CO 11:7" />Kǝ́ ŋ́ tɛnɩ Worokoyǝ le Dieceeceerǝ we ŋ́ tìi nǝ ŋ́ cɛ̀ɛ, ǝkǝ ŋ́ pɛ̀ɛlɩ mǝ wɛ kǝ ŋnǝ nǝ nya fɛɛ nǝ rɛ oŋuŋkǝ wǝǝ, we ŋ́ yeli wǝ loo poŋ rǝ? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Kǝ́ ŋ́ ke ŋ yee anǝnɛyǝ rǝ nǝ kpǝŋ we, acakupʊŋpwayǝ le enyipǝ pǝ ka ŋ mwara mǝ a mǝ ŋ nya fɛɛ ŋ́ yee mǝ kǝnǝnɛkǝ. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Eniyǝ we ŋ́ ke kpii rǝ nǝ kpǝŋ wǝ́ otuyǝ yǝ ke ŋ yee mǝ ariaayǝ we, ŋ́ naa siɛrɩ ŋ́ yee eleeyǝ ŋ koonu rɛ. Duturǝ ɖi apaanʊpǝ we pǝ ru rǝ Makedonia pǝ rè otuyǝ we yǝ ke ŋ yee mǝ ariaayǝ pǝ pǝlǝ pǝ kòonu mǝ. Ŋ́ ya ŋ́ náa nyɩɩ eni ri ŋ ni kǝ ŋ paa nya fɛɛ ŋ́ yee eleeyǝ ŋ́ koonu nǝ, wǝ́ ŋ́ náa nyɩɩ kǝ ŋ re wǝ ŋ́ ya mǝŋkǝsa. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Rǝ Kǝriso la anʊkɔrǝyǝ we yǝ kpii rǝ mǝ mǝrǝ we, ŋ́ ya ŋ́ náa tɛŋ wǝ ǝkǝnǝŋ rɛ lǝŋ pǝ sǝŋ gʊŋrǝ ŋ koonu mǝ ŋ́ fǝ tuwǝ sa ŋ́ faa faawǝ rǝ Akayi la akayǝ we kpǝlo. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Kǝ́ kǝto wǝ́ ŋ́ na tɛŋ wǝ ǝnǝ? Nǝ nyo pu wǝ ǝkǝnǝŋ ŋ́ nǝŋ taa nǝ kǝǝwǝ rǝ kǝto? Worokoyǝ cii wǝ ǝkǝnǝŋ ŋmǝ ŋ́ náa taa nǝ kǝǝwǝ. <verse eid="2CO 11:11" /><verse number="12" style="v" sid="2CO 11:12" />Kǝ́ ŋ́ nǝ sǝ́ŋ ŋ́ nǝŋ lɔ wǝtoomwarakpǝ rǝ kǝnǝnɛkǝ sa ŋ́ ya ŋ́ née yee we, ŋ́ née re mǝ ŋ yee wǝ mǝŋkǝsa. Mǝŋkǝsa we, epǝ we pǝ ya pǝ láa taa tuwǝ pǝ lǝ́ǝ fǝ pǝ faa faawǝ ǝkǝnǝŋ ŋlǝ la kaa rǝ we, pǝ lǝŋ pa nya wǝ. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Ŋpǝ enyipǝ sa we, anianiatǝnyikpiipǝ wǝ́ pǝ ri, alakpatǝnǝnɛyeetǝpǝ wǝ́ pǝ ri. Pǝ lǝ́ǝ fǝ pǝla wɛ mǝŋ ŋpǝ pǝ ri Kǝriso le enyikpiipǝ. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Wǝ́ tuwǝ sa wǝ lǝŋ lɛ wǝ ri lǝ mumuŋ, duturǝ ɖi Satana ŋwǝŋwǝ láa siɛrɩ na wɛ mǝ ŋ yee mǝŋ wǝnyɩɩnɩkpǝ le picoŋpiyǝ. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Kǝto wǝ lee ri tulɛnyɩwǝ rɛ wǝ koonu ŋpǝ Satana la anǝnɛyeetǝpǝ sa kǝ pǝ siɛrɩ pǝla wɛ pǝ yee mǝŋ wǝkʊʊkpǝ la anǝnɛyeetǝpǝ. Pǝla kǝlɛɛkǝ kǝ lah pa kaa rǝ mǝ pǝla anǝnɛyǝ.<verse eid="2CO 11:15" /></para>
  <para style="s">Pɔlʊ la arianyɩŋyǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Ŋ́ tǝ ŋ́ ya ŋ́ náa tɛŋ wǝ ǝkǝnǝŋ, rɛ ŋ paa nyɩŋ mǝ mǝŋ yufiitǝyǝ wǝ́ ŋ́ ri. Amaa nǝ tɛɛnɩ ǝkǝnǝŋ ŋmǝ ŋ́ ri yufiitǝyǝ kǝ ŋ́ nya fɛɛ ŋ́ nya tuwǝ ŋ́ faa faawǝ tɩpɩrɩ. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Dierǝ sa ŋ́ nah tɛŋ we, ŋ́ nǝŋ tɛŋ rǝ mǝŋ kǝ́ Kulǝtǝyǝ ŋ nǝ pǝ́ wǝ, paa ŋ́ náa tɛŋ ɖǝ mǝ ŋ yufiitǝyǝ kǝtǝ kǝ ŋ́ nya fɛɛ ŋ́ nya tuwǝ ŋ́ faa faawǝ ŋmǝ ŋkpɛ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Kpiikǝ wǝ ri ǝkǝnǝŋ enyipǝ wa pǝ lǝ fǝ anyɩmaasɩpǝ lo oyupuyǝ pǝ ya pǝ láa faa faawǝ we, ŋmǝ ŋkpɛ ŋ́ nǝ́ǝ fǝ yǝ ŋ́ faa faawǝ. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Nǝ nyáa tɛŋ ǝkǝnǝŋ enimisietǝpǝ wǝ́ ŋnǝ nǝ ri, wǝ́ paa nǝ nyáa nya lɛtaarǝwǝ nyǝ ŋ nuŋ oyukpǝ́tǝpǝ le etieyǝ! <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Pǝ ke mǝ yee mǝ nǝ mǝŋ arɔŋpǝ kǝtǝ oo, pǝ ka ya pǝ ŋ pieeli nǝ pǝ ŋ ri oo, pǝ ka mǝ wʊʊ nǝ otulǝmǝyǝ kɩɩkɩ oo, pǝ ka mǝ fʊʊ nǝ pǝ ŋ sǝǝlǝ oo, pǝ ka mǝ ca nǝ kaafieliwǝ oo, nǝ nyáa nya lɛtaarǝwǝ nyǝ ŋ koonu ŋpǝ enyipǝ sa. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Ŋ́ ya ŋ́ náa tɛŋ tuwǝ sa mǝ nʊŋsɔ mǝ nʊŋsɔ, la nyàrǝ lah wɛ lo cò lo koonu nǝ kururu.</para>
  <para style="p" vid="2CO 11:21">Rǝkǝsa we, ŋ́ náa wɛɛlɩ mǝ ŋ yufiitǝyǝ kǝtǝ. Tu ri ŋ tu nyɩmaasɩyǝ ŋ nóo tu turuwǝ ŋ yee we, ŋmǝ ŋkpɛ ŋ́ nóo tu turuwǝ ŋ́ yee wǝ. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Mǝŋkǝ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ pǝ ri Ehebǝritǝpǝ? Ŋmǝ ŋkpɛ Ehebǝritǝpǝ wǝ́ ŋ́ ri! Mǝŋkǝ pǝ ri Isǝrayɛlǝtǝpǝ? Ŋmǝ ŋkpɛ Isǝrayɛlǝtǝpǝ wǝ́ ŋ́ ri! Mǝŋkǝ pǝ ri Abǝrahamǝ le epilepipǝ? Ŋmǝ ŋkpɛ Abǝrahamǝ le pilepiyǝ wǝ́ ŋ́ ri! <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Mǝŋ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ ŋpǝ pǝ ri Kǝriso la anǝnɛyeetǝpǝ we, ŋ́ ri Kǝriso la nǝnɛyeetǝyǝ ŋ́ teeri pǝ, ŋ́ nah wɛɛlɩ mǝŋ yufiitǝyǝ kǝtǝ. Ŋ́ na cʊʊrʊ ŋ́ ne teeri pǝ, pǝ la taŋ mǝ pǝ le teeri pǝ, pǝ lo culu mǝ pǝ le teeri pǝ, wǝ́ ŋ́ na nyɩŋ gbɛŋrǝ kǝlǝkǝlǝ ŋ́ ne teeri pǝ. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Oyudatǝpǝ pǝ la ca mǝ kǝnǝŋkǝ kǝtǝta mǝ kǝfaŋceŋceŋ pǝrǝŋwǝ kǝtʊʊ pǝ la nyɩŋ. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Pǝ cùlu mǝ mǝ fwɛɛpǝlawǝ pǝrǝŋwǝ kǝta. Pǝ tìeni mǝ oruyǝ kǝceŋceŋ. Gbanǝŋwaarǝ lǝ nǝŋ mǝ mǝ kǝta. Wǝ́ ŋ́ yeli jɔkɔŋrǝ jeŋceŋ mǝ dumurǝ jeŋceŋ rǝ apʊyǝ. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Ŋ́ na saŋ gʊŋrǝ mǝ enirɛɛyǝ, wǝ́ ŋ́ nyɩnɩ gbɛŋrǝ kǝlǝkǝlǝ: Akpanǝyǝ yǝ pǝlǝ yǝ pe ri mǝ. Ŋ́ pǝlǝ ŋ́ pǝ kpǝ́ rǝ ayɩlayɩtǝpǝ la wǝkaakpǝ. Ŋ́ pǝlǝ ŋ́ pǝ kpǝ́ rǝ mǝ ǝtǝŋ oyudatǝpǝ mǝŋ epǝ we pǝ lee ri oyudatǝpǝ la wǝkaakpǝ. Ŋ́ pǝlǝ ŋ́ pǝ kpǝ́ rǝ ǝtǝŋtǝǝyǝ, rǝ nyɔŋkpaakǝtǝǝwǝ mǝ apʊyǝ mǝrǝ. Ŋ́ pǝlǝ ŋ́ pǝ kpǝ́ rǝ anianiatǝpaanʊpǝ ŋpǝ ŋkpɛ la wǝkaakpǝ. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Ŋ́ yeli anǝnɛlɛnyɩyǝ wǝ́ ŋ́ fanǝ. Enirɛɛyǝ ŋ́ naa ka ŋ kpɛɛ eniŋrieyǝ. Kǝtɛŋkǝ mǝ kǝmɛŋtɛŋkǝ kǝ wʊlʊ mǝ. Enirɛɛyǝ ŋ́ nǝŋ nya keeriwǝ ŋ́ neh ri. Ziɛrǝ wʊlʊ mǝ paape ŋ́ naa nya nyaŋrǝ ŋ́ neh sii. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Ŋ́ nǝŋ pǝ́ ŋ wɛɛlɩ ŋ́ ru rǝ otututuruyǝ. Mǝ ji ri ŋ ji lo yupurǝ dɛɛ rǝ alɔnuŋtǝpǝ la acakuyǝ kpǝlo lo oŋuŋkǝ. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Vǝ́ rɛ la yɔ we, oturu ŋmǝ ŋkpɛ ŋ́ na yɔ, wǝ́ mǝŋ rɛ le yee turɔɔrɔɔwǝ we, wǝ lǝ́ǝ fǝrǝ mǝ ŋpa. <verse eid="2CO 11:29" /><verse number="30" style="v" sid="2CO 11:30" />Mǝŋ wǝ kpii kǝ ŋ́ faa faawǝ we, ŋ́ náa faa faawǝ ŋ́ ru rǝ mǝ wǝfɔkpǝ. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Worokoyǝ we ŋ ri Kulǝtǝyǝ Yesu lǝ Tǝyǝ we, cii wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝŋ nia. Ŋwǝ ŋ kaamǝ ǝkǝkǝ kǝkpakǝkpa wǝ. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />Kǝ́ ŋ ke kpii rǝ Damasǝko we, piliyǝ la maayaatǝyǝ kpii enyipǝ pǝ ka ya pǝ ŋ rǝŋ tǝŋtǝǝwǝ we lo okuŋpoluyǝ kǝ pǝ nya fɛɛ pǝ lɔ mǝ. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />Paape enyipǝ pǝ fǝ̀ mǝ pǝ kpii rǝ kɛŋtɛwǝ rɛ mǝrǝ, wǝ́ pǝ kpìi wǝ la ŋwɛɛwǝ, wǝ́ pǝ rù mǝ wǝ rǝ fasǝrɛyǝ pǝ màarǝ rǝ giriŋrǝ pǝ sʊʊ mǝ mǝ. Wǝ́ ŋ́ nya gʊŋrǝ ŋ́ sùu.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Kulǝtǝyǝ la pɔrʊ otuyǝ la kaŋ Pɔlʊ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Ŋ́ kǝ tǝ ŋ faa faawǝ oo, ŋ́ nǝŋ nya tǝrɛ rǝ wǝlǝ mǝrǝ. Paa rǝkǝsa we, ŋ́ náa wɛɛlɩ ŋ́ ru rǝ otuyǝ we Kulǝtǝyǝ ŋ na pɔrʊ ŋ na kaŋ mǝ ǝkǝ ŋ́ na nyɩŋ wǝ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Ŋ́ cii nyiyǝ rɛ ŋ ri Kǝriso la nɛŋyǝ wǝ. Worokoyǝ fǝ̀ ŋwǝ rɛ̀ yulaarǝ rǝ oŋuŋ rǝ oŋuŋ cɛŋwǝ tǝ mǝ niǝtǝwǝ wǝǝ. Ŋ́ nee ci mǝŋ kǝceece Worokoyǝ fǝ̀ nyiyǝ sa la wɛlɛŋrǝ rɛ̀ amaa kǝtʊkpɛɛkǝ kǝ kǝ lǝǝwe. Worokoyǝ ŋwǝ paa cii wǝ. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Wǝ́ ayɩrɛ kǝceece Worokoyǝ fǝ̀ nyiyǝ sa la wɛlɛŋrǝ rɛ amaa kǝtʊkpɛɛkǝ kǝ kǝ lǝǝwe oo, ŋ́ nee ci. Worokoyǝ ŋwǝ paa cii wǝ. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />Worokoyǝ fǝ̀ nyiyǝ sa kolu ǝrǝ paradisoyǝ mǝrǝ, wǝ́ ŋ kolu ŋ nunu etieyǝ rɛ nyiyǝ ŋ nǝŋ koru a awɛɛlɩ ŋ tɛŋ, wǝ́ gʊŋrǝ laa kpɛɛ pǝ lǝ́ǝ kpǝlǝŋ pǝ tɛŋ ŋyǝ etieyǝ sa. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Ŋ́ koh koru afaa faawǝ rǝ nyiyǝ sa lo oŋuŋkǝ, paape rǝ ŋmǝ mǝ kpǝŋ we, tuwǝ ceŋceŋ ŋ́ nóo koru ǝfǝ ŋ́ faa faawǝ we, wǝ kaamǝ mǝ wǝfɔkpǝ. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Mǝŋ ŋ́ kǝh mǝ pǝ́ ŋ́ faa faawǝ we, ŋ́ nǝŋ ke ri yufiitǝyǝ, anʊkɔrǝyǝ ko wǝ́ ŋ́ kah mǝ tɛŋ. Paape ŋ́ nǝŋ yee wǝ. Duturǝ ɖi ŋ́ naa ya ŋ́ nǝ́ǝ pǝ́ rɛ ŋ pa rɛɛrɩ mǝ mǝ ŋ teeri tuwǝ we ŋ na nyɩŋ, ŋ́ ne yee amaa ŋ no nuŋ ŋ́ na tɛŋ wǝ.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Otuyǝ we Kulǝtǝyǝ ŋ na pɔrʊ ŋ na kaŋ mǝ we, yǝ lóo poŋ ayɩrɩ ŋpa. Tuwǝ kǝto kǝ ŋ́ paa pa ya mǝ ŋ rɛɛrɩ mǝ mǝ wɛ we, wǝ́ Worokoyǝ ŋ nǝ fǝ nyarǝpirǝ rɛ ŋ ne kpii mǝ rǝ mǝ wɛlɛŋrǝ kǝ lǝ ŋ kpii mǝ vuurǝ. Wǝ tǝ wǝ lǝ rǝ mǝŋ Satana le picoŋpiyǝ rɛ wǝ́ pǝ le kpii ŋ na pa ca mǝ kǝ ŋ́ paa nya fɛɛ ŋ rɛɛrɩ mǝ mǝ wɛ. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Ŋ́ na mwɛŋ nyuŋkpǝ pǝrǝŋwǝ kǝta ŋ́ no pwo Kulǝtǝyǝ kǝ ŋ nya fɛɛ ŋ pɔrʊ mǝ ŋ cɛ rǝ vuurǝ sa mǝrǝ. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Paape wǝ́ ŋ tìi mǝ ǝkǝnǝŋ: «Mǝ lɛsiɛrɩwǝ we ŋ́ ne yee lǝ́ we, wǝ lo ro lǝ́! Wǝ́ ŋ́ náa pɔrʊ mǝ okopiyǝ mǝ ŋ kaŋ saŋ rǝ lá wǝfɔkpǝ mǝrǝ.» Kǝto we ŋ́ nǝh mǝ fǝ mǝ wǝfɔkpǝ mǝ ŋ faa faawǝ, kǝ Kǝriso lo okopiyǝ yǝ nya fɛɛ yǝ tɛ̀ɛ rǝ mǝ. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Tuwǝ kǝto wǝ ke ce wǝ ri okopiyǝ yǝ la lɛ mǝ oo, amaa pǝ ka mǝ fɛɛpɩ mǝ oo, amaa gbaraarǝ oo, amaa pǝ le yi pǝ la tɛɛ rǝ mǝ oo, amaa vaŋrǝ we ŋ́ ya ŋ́ náa faŋ rǝ Kǝriso lo yurǝ we, ŋ́ na lɔ tu ri ŋ tu mǝ faawǝ. Duturǝ ɖi eniyǝ we ŋ́ kpii rǝ wǝfɔkpǝ mǝrǝ we, eniyǝ we wǝ́ ŋ́ náa lɛnyɩ mǝ ŋ kʊla wǝ.<verse eid="2CO 12:10" /></para>
  <para style="s">Pɔlʊ ya lǝ́ǝ kǝǝnǝ mǝ ŋ koonu Okorɛŋtotǝpǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Nǝ nya nyɩŋ kǝ́ ŋ́ na wɛɛlɩ mǝŋ yufiitǝyǝ kǝtǝ wǝ. Ŋnǝ nǝ nyo co mǝ yǝ. Kaŋfɩ ŋnǝ nǝ kah wɛɛlɩ nǝ kǝ mǝ ǝnǝ. Duturǝ ɖi wǝ ke ce wǝ ri ǝkǝnǝŋ ŋ́ nee ri tǝrɛ kʊraa we, nǝ enyipǝ we nǝ ya nǝ nyóo pwo ǝkǝnǝŋ enyikpiimumuŋpǝ we, pǝ lee teeri mǝ rǝ tǝrɛ. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />Anǝnɛyǝ we yǝ la pɔrʊ yǝ la kaŋ ǝkǝnǝŋ ŋmǝ ri nyikpiiyǝ we, ŋ́ ne yee yǝ rǝ nǝ kpǝŋ mǝ lɛtaarǝmumuŋwǝ rɛ. Ŋyǝ yǝ kaamǝ otucovurǝ, otumumuŋyǝ la faa nyɩŋ lǝ tǝnǝ mǝ otuyǝ we ŋ́ yeli ŋ́ sanǝ rǝ Worokoyǝ lo okopiyǝ wǝ. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Kǝ́ lo tu wǝ́ ŋ́ ne yee ŋ́ no koonu alɔnuŋtǝpǝ la wǝcakukpǝ rɛ wǝ́ ŋ́ nee yee wǝ ŋ́ koonu nǝ? Amaa kǝ́ ŋmǝ paa ŋ́ nee pe yee eleeyǝ ŋ́ koonu nǝ kǝto? Nǝ fǝ turɔɔrɔɔwǝ sa nǝ cɛɛ mǝ.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Ŋ́ na kpaka ŋ́ na lɛ ŋ́ nǝh tǝ mǝ ŋ pǝ nǝ kpǝŋ kǝtatǝkǝ. Ŋkǝ ŋ́ nǝh pǝ ŋ́ pe yee eleeyǝ ŋ́ koonu nǝ rǝ oo, duturǝ ɖi ŋkǝ nǝ otulǝmǝyǝ wǝ́ ŋ́ ya ŋ́ nǝ́ǝ pǝ́, paa ŋnǝŋnǝ wǝ́ ŋ́ ya ŋ́ nǝ́ǝ pǝ́. Ŋkǝ epipǝ pǝ láa ŋwaa dulǝmǝrǝ pǝ ŋ tǝnǝ koonu pǝlǝ ǝmǝtǝpǝ lo sooso, paa ǝmǝtǝpǝ pǝ lée yee wǝ wǝ. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Rǝ ŋmǝ mǝ kpǝŋ we, ŋ́ náa nya faawǝ ŋ́ pɔrʊ mǝ sɩkayǝ ŋ co rǝ nǝ yurǝ, kǝ ŋ́ lɛ ŋ́ fǝ mǝ wɛ kpǝlo ŋ́ koonu rǝ nǝ yurǝ. Mǝŋ ŋ́ na taa nǝ kǝǝwǝ mǝŋkǝsa wǝǝ, ŋ wǝ wǝ lóo koonu kǝ nǝ pɔrʊ nǝ kǝǝtaawǝ we nǝ lǝǝmǝ nǝ koonu mǝ nǝ sǝǝlǝ? <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />Kǝ lǝ fǝ wǝ, ŋ́ nee yee eleeyǝ ŋ́ koonu nǝ. Paape arɛɛpǝ pǝ lah mǝ tɛŋ ǝkǝnǝŋ ŋmǝ ŋ nee tíi nǝ anʊkɔrǝyǝ wǝ́ ŋ́ na lɛ ŋ́ na kɔŋ nǝ kpɛrɛwǝ mǝ wǝpiekpǝ wǝ́ nǝ nya tɔɔ wǝ. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Nǝ yɩrɩ enyipǝ we kpǝlo kɩɩkɩ ŋ́ ne kpii pǝ lǝ pǝ nǝ kpǝŋ, pǝlǝ ǝlǝ wǝ́ ŋ́ ne kpii ŋ ne pe pieeli nǝ ŋ ne ri? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Ŋ́ tɔɔ ŋ́ kpɛlɩ Tito wǝ́ ŋ́ kpìi ŋpǝ mǝ paanʊyǝ rɛ ŋ́ manǝ nǝ. Amaa Tito pǝlǝ pìeeli nǝ lɔ̀ tǝrɛ? Mǝŋkǝ ŋlǝ mǝ ŋwǝ lǝ fǝ yupurǝ jeŋceŋ le ke ŋ yee anǝnɛyǝ wǝ́ la lɛ̀ le siimǝ gʊŋrǝ jeŋceŋ? <verse eid="2CO 12:18" /><verse number="19" style="v" sid="2CO 12:19" />Nǝ ya nyóo pu wǝ ǝrǝ eniyǝ nɔ ǝkǝnǝŋ ŋlǝ la ya yǝ láa kɔɔlʊ lah wɛ rǝ nǝ kǝnyɩŋkǝ. Ow ŋkǝ nǝ kǝnyɩŋkǝ, paa la ya yǝ láa wɛɛlɩ rǝ Worokoyǝ la kǝnyɩŋkǝ rǝ Kǝriso mǝrǝ. Lǝh ǝtǝŋ, la ya yǝ láa tɛŋ etieyǝ sa kpǝlo yǝ ŋ tíi nǝ ǝnǝ kǝ yǝ nya fɛɛ yǝ toŋ nǝ kǝ nǝ tɔ nǝ yaa rǝ lɔnuŋrǝ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Ŋ́ ya ŋ́ nǝ́ǝ kǝǝnǝ, ayɩrɛ vǝ́ ŋ́ nǝ pǝ nǝ kpǝŋ we, ŋ́ nǝŋ pa nyɩŋ nǝ mǝŋ kǝ́ ŋ́ nǝ pǝ́ wǝ wǝ. Ŋnǝ ŋkpɛ nǝ nyǝŋ pa nyɩŋ mǝ mǝŋ kǝ́ nǝ nyǝ pǝ́ wǝ wǝ. Ŋ́ ya ŋ́ nǝ́ǝ kǝǝnǝ ayɩrɛ ŋ́ nah pa nyɩŋ akpaŋyǝ, nimimwɛɛrɩwǝ, kpɛɛmʊrʊwǝ mǝ otukpaarǝkaayǝ, kǝnyitɛŋkǝ mǝ kǝnyipǝlǝkǝ, wɛɛrɛɛrɩmǝwǝ mǝ kǝtʊkpaakǝ yǝ kpii rǝ nǝ mǝrǝ. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Ŋ́ tǝ ŋ́ ya ŋ́ nǝ́ǝ kǝǝnǝ ayɩrɛ vǝ́ ŋ́ nǝ pǝ nǝ kpǝŋ we, Worokoyǝ leh pe kpii mǝ kǝyepukǝ rǝ nǝ enimiyǝ, kǝ ŋ́ lɛ ŋ́ wee ŋpa rǝ epǝ we pǝ tǝ pǝ re pǝ ya pǝ lée yee oturɔɔrɔɔyǝ mǝŋ eniyǝ nɔ kǝtǝ lo yurǝ. Pǝ laa nyarǝ nuŋruwǝ, kǝtienaakǝ amaa vuuyɩɩrǝ mǝ pǝ la vɔrʊrɔɔrɔɔrǝ we pǝ co.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Pɔlʊ le ecikaŋtuturukǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Kǝtatǝkǝ wǝ́ ŋ́ nǝh pǝ nǝ kpǝŋ wǝǝ. Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Kpɛŋ kǝ pǝ pa tɛŋ wǝkpaŋkpǝ rɛ we, wǝ kpii kǝ pǝ nuŋ araŋsielǝtǝpǝ eyi amaa ata le dietɛŋrǝ». <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Kǝ́ ŋ́ pǝlǝ nǝ kpǝŋ mǝ kǝyitǝkǝ we we, ŋ́ tɛnɩ dierǝ sa, wǝ́ ruŋruŋ le jirǝ sa ŋ́ nǝǝ tǝ ŋ́ kǝlǝ mǝ nǝ we, ŋ́ nǝ́ǝ tǝ mǝ ŋ tɛŋ rǝ ŋ́ tíi ŋnǝ epǝ we nǝ yeli oturɔɔrɔɔyǝ eniyǝ nɔ mǝ ŋnǝ otuturupǝ we kpǝlo ǝkǝnǝŋ, vǝ́ ŋ́ na pa siɛnɩ ŋ́ nǝ pǝ we, ŋ́ neh pe yee mǝ nǝ ǝfǝcɛɛkǝ kǝ lǝŋ pe kpii. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Mǝŋkǝ nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ nyɩŋ tuwǝ wǝ ya wǝ láa kaŋ ǝkǝnǝŋ Kǝriso ya láa wɛɛlɩ mǝ ŋ saŋ rǝ mǝ wǝ? Vǝ́ Kǝriso ya lée yee kǝnǝnɛkǝ rǝ nǝ we, lee ri fɔlɔfɔtǝyǝ. Paa we, láa pɔrʊ no okopiyǝ mǝ ŋ kaŋ rǝ nǝ mǝrǝ. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Rǝ anʊkɔrǝyǝ we, kǝ́ pǝ kpàa Kǝriso pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ we, lǝǝ kǝ tǝ ŋ lǝmǝ okopiyǝ rɛ, paa rǝkǝsa kpii vɔrʊrǝ saŋ rǝ Worokoyǝ lo okopiyǝ. Kpiikǝ yǝ le yee nyiceŋceŋ mǝ Kǝriso kǝto we, ŋla ŋkpɛ le ri afɔlɔfɔtǝpǝ, paape yǝ leh pe tii vɔrʊrǝ la kʊla mǝ ŋwǝ Kǝriso lo koonu nǝ saŋ rǝ Worokoyǝ lo okopiyǝ.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Ŋnǝŋnǝ nǝ tie nǝ wɛ nǝ yɩrɩ kǝ nǝ nyɩŋ mǝŋ nǝ kpii rǝ lɔnuŋrǝ we mǝrǝ. Nǝ tie nǝ wɛ nǝ yɩrɩ! Amaa nǝ nyee ci wǝ ǝkǝnǝŋ Yesu Kǝriso kpii rǝ nǝ? We tɛŋ nǝ nye tie nǝ wɛ nǝ nya yɩrɩ wǝ́ nǝ nya nyɩŋ ǝkǝnǝŋ ŋnǝ nǝ nya tɔɔ ceŋceŋ. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Ŋ́ na lɔ ŋ́ no nuŋ nǝ nyah pa nyɩŋ wǝ nǝ ci ǝkǝnǝŋ ŋlǝ paa yǝ laa tɔɔ. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />La ya yǝ láa mwɛŋ nyuŋkpǝ yǝ ŋ pwo Worokoyǝ kǝ nǝ paa nya fɛɛ nǝ yee turɔɔrɔɔwǝ rɛ. Ŋkǝ la ya yǝ lǝ́ǝ pǝ́ la pɔrʊ la kaŋ ǝkǝnǝŋ yǝ le ri yurǝ rǝ lah anǝnɛyǝ rǝ o. Paa la ya yǝ lǝ́ǝ pǝ́ nǝ yee rǝ tuceeceewǝ, wǝ ke ce wǝ ri enyipǝ pǝ ya pǝ pǝ lóo pu wǝ ǝkǝnǝŋ ŋlǝ yǝ láa tɔɔ. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Duturǝ ɖi yǝ lǝŋ koru ǝsǝŋ gʊŋrǝ lo koonu Worokoyǝ la anʊkɔrǝyǝ. Paa yǝ lóo koru eyee anǝnɛyǝ lo koonu anʊkɔrǝyǝ we. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Vǝ́ yǝ le yee afɔlɔfɔtǝpǝ wǝ́ ŋnǝ paa nǝ nya nya okopiyǝ we, oturu la ya yǝ láa nya faawǝ. Loh nyuŋmwɛŋwǝ koonu nǝ wǝ kaamǝ ǝkǝnǝŋ ŋnǝ nǝ to milimili. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Tuwǝ kǝto mǝŋkǝ́ ŋ́ nǝǝ kǝlǝ mǝ nǝ we, ŋ́ ya ŋ́ náa ŋʊrʊ tuwǝ sa mǝ ŋ maŋ nǝ. Mǝŋkǝsa we, vǝ́ ŋ́ nǝ pǝ pǝ we, kǝ ŋ́ pǝǝ pǝ fǝ kǝtulɛŋkǝ ŋ́ tɛŋ akpaŋyǝ mǝ okopiyǝ we Kulǝtǝyǝ ŋ no koonu mǝ wǝ. Lo koonu mǝ ŋyǝ okopiyǝ sa kǝ ŋ́ fǝ ŋ́ toŋ rǝ, ŋkǝ kǝ ŋ́ fǝ ŋ́ pǝlǝ rǝ.<verse eid="2CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Rǝkǝsa we, lǝh ǝtǝŋ, nǝ tii rǝ faawǝ mǝrǝ, nǝ nyɩɩ kǝ nǝ to milimili, nǝ kpii awɛ lo okopiyǝ, nǝ yee nyuŋceŋceŋ kǝ nǝ tii rǝ wǝtaarǝkpǝ mǝrǝ. Mǝŋkǝsa we, kǝǝtaawǝ mǝ wǝtaarǝkpǝ lo Worokoyǝ lée tii ŋ kʊla mǝ nǝ. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" />Nǝ ceeni awɛ sɩsiɛrɩ mǝ kǝǝtaawǝ mǝŋ apaanʊpǝ mǝ apaatɛpǝ kǝtǝ. Alɔnuŋtǝpǝ kpǝlo pǝ lée ceeni nǝ. <verse eid="2CO 13:12" /><verse number="13-14" style="v" sid="2CO 13:13-14" />Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ, Worokoyǝ lǝ kǝǝtaawǝ mǝ Wɛɛkenikenirǝ lo nyuŋceŋceŋkpǝ yǝ tii yǝ kʊla mǝ nǝ kpǝlo.<verse eid="2CO 13:13-14" /></para>
  <chapter eid="2CO 13" />
</usx>