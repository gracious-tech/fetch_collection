<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">Akebou: La Bible en akebou</book>
  <para style="h">1 Okorɛŋtotǝpǝ</para>
  <para style="toc3">1Ok</para>
  <para style="toc2">1 Okorɛŋtotǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛsǝsǝŋkǝ we ŋ na ŋʊrʊ ŋ na maŋ Okorɛŋtotǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛsǝsǝŋkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Okorɛŋtotǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ ŋ na ŋʊrʊ kǝfwɛɛkǝ sa ŋ na maŋ alɔnuŋtǝpǝ we rǝ Korɛŋto. Kǝfwɛɛkǝ sa kǝ ri kǝsǝsǝŋkǝ ŋ na maŋ pǝ wǝ. Korɛŋto lǝ tǝŋtǝǝwǝ sa wǝ ke ri ɖaasaŋrǝ lǝ tǝŋtǝǝwǝ, kǝto enyipǝ pǝ kǝ lǝǝmǝ pǝla wɛ rǝ tǝŋtǝǝwǝ sa, wǝ́ asʊmayǝ kpookpookpoo yǝ ke kpii rǝ tǝŋtǝǝwǝ sa. Ŋ wǝ tuwǝ sa kǝto enyipǝ pǝ ke ŋ tii vɔrʊrǝ mǝŋ kǝ́ wǝ ponu mǝ pǝ wǝ, wǝ́ pǝ ka ŋ lɛ pǝ ŋ sʊma etiŋyǝ. Epǝ we pǝ siɛrɩ pǝ yeli ekǝrisotǝpǝ we, pǝ rù rǝ ŋyǝ asʊmayǝ sa, anyɩŋ pǝla vɔrʊrɔɔrɔɔrǝ we pǝ ke ŋ re gǝ tǝ gbii rǝ pǝ. Wǝ́ Pɔlʊ ŋ nunu wǝlǝkpǝ we pǝ ya pǝ lée tii vɔrʊrǝ pǝ ŋ fǝ wǝ. Wǝ́ ŋpǝŋpǝ pǝ ŋʊ̀rʊ kǝfwɛɛkǝ pǝ manǝ ŋwǝ pǝ pǝ̀ ne etieyǝ pǝ rù rǝ wǝlǝkpǝ we pǝ lée re pǝ la wɛ pǝ fǝ mǝŋ ekǝrisotǝpǝ kǝtǝ wǝ. Fɛɛwǝ Pɔlʊ ŋ ŋʊ̀rʊ kǝfwɛɛkǝ sa ŋ manǝ pǝ kǝ ŋ fǝ ŋ pɔrʊ tu ri ŋ tu lo duturǝ ŋ tíi pǝ wǝǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Eceenikǝ 1:1-9</para>
  <para style="io">- Wǝsǝpǝkpǝ rǝ asʊmatǝpǝ la wǝcakukpǝ mǝrǝ 1:10–4:21</para>
  <para style="io">- Nuŋruyeewǝ rǝ alɔnuŋtǝpǝ lǝ mǝrǝ 5:1–7:21</para>
  <para style="io">- Wǝfɛɛkpǝ la kɛɛtooluyǝ la gakǝ 8:1–11:1</para>
  <para style="io">- Ǝpǝrǝŋpǝ mǝ etiepǝ la wǝkpakpiikpǝ rǝ zʊmarǝ 11:2–14:40</para>
  <para style="io">- Kǝriso la asaanǝkǝ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ 15:1-58</para>
  <para style="io">- Gbǝrǝ koonu alɔnuŋtǝpǝ 16:1-4</para>
  <para style="io">- Pɔlʊ ŋwǝŋwǝ ne etietuturuyǝ koonu zʊmarǝ 16:5-24</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">Eceenikǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Ŋmǝ Pɔlʊ, Worokoyǝ ŋ no pwo mǝ saŋ rǝ nǝ kǝǝpǝ́wǝ ŋmǝ ŋ́ pe ri Yesu Kǝriso le nyikpiiyǝ. Ŋlǝ mǝ paanʊyǝ Sosǝtɛnǝ <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />la ya yǝ láa ŋʊrʊ kǝfwɛɛkǝ sa yǝ ŋ maŋ Worokoyǝ la asʊmatǝpǝ la wǝcakukpǝ we wǝ kpii rǝ Korɛŋto, epǝ we Worokoyǝ ŋ no pwo, wǝ́ ŋ na kʊʊ ŋ nǝ tǝnǝ ǝkǝ pǝ le yee nyiceŋceŋ mǝ Kǝriso wǝ́ pǝ lǝ kenikeni wǝ. Pǝ lo pwo nǝ mǝŋ epǝ we kpǝlo kɩɩkɩ rǝ fɛɛ ri ŋ fɛɛ pǝ lóo pwo loh Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ wǝ. Ŋwǝ ŋ ri pǝlo Kulǝtǝyǝ mǝ loh Kulǝtǝyǝ wǝ. <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />Lǝh Tǝ Worokoyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso pǝ yee nǝ lɛsiɛrɩwǝ kǝ pǝ koonu nǝ wǝtaarǝkpǝ. <verse eid="1CO 1:3" /><verse number="4" style="v" sid="1CO 1:4" />Ŋ́ ya ŋ́ née ceeni mǝ Worokoyǝ eni ri ŋ ni rǝ nǝ yurǝ, rǝ lɛsiɛrɩwǝ sa ŋ ne yee nǝ saŋ rǝ Yesu Kǝriso wǝ. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Duturǝ ɖi kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kǝriso kǝto we, lǝ fǝ otulǝmǝyǝ kpǝlo kɩɩkɩ lo koonu nǝ, otukpǝlo eciawɛɛlɩkǝ mǝ otuciyǝ. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Kpiikǝ Kǝriso le dierǝ we pǝ la tɛŋ pǝ le tíi nǝ we, la tɔ okuruŋkuyǝ ŋpa rǝ nǝ mǝrǝ. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Kǝto Worokoyǝ lo tukoonuwǝ rɛ mǝŋ ceŋceŋ wǝ lee kpii wǝ leh pe yee ŋnǝ epǝ we nǝ ya nǝ nyǝ́ǝ rǝŋ eniyǝ we loh Kulǝtǝyǝ Yesu Kǝriso ŋ noh po ru we, la ariaayǝ. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Ŋwǝ ŋ nah pa lɛ ŋ tɔ nǝ ŋ yaalǝ kiŋkiŋ ka lɛ rǝ. Mǝŋkǝsa we, rɛ lǝŋ pa nya tuwǝ ŋ nǝ́ǝ fǝ ŋ kpaŋ mǝ nǝ jirǝ we Kulǝtǝyǝ Yesu Kǝriso ŋ nǝ́ǝ pǝ wǝ. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Worokoyǝ we ŋ no pwo nǝ nǝ pe yee nyiceŋceŋ mǝ ne Pi Yesu Kǝriso, yǝ we ŋ ri loh Kulǝtǝyǝ we, nʊkɔrǝlǝtǝyǝ wǝ́ ŋ ri.<verse eid="1CO 1:9" /></para>
  <para style="s">Wǝsǝpǝkpǝ wǝ lǝ pǝ rǝ asʊmatǝpǝ la wǝcakukpǝ mǝrǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Lǝh ǝtǝŋ, ŋ́ nǝ fǝ loh Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ ŋ́ na tɔɔ ŋ́ na kpɛɛ nǝ, nǝ yee nyuŋceŋceŋ. Wǝsǝpǝkpǝ rɛ wǝ pee kpii rǝ nǝ mǝrǝ. Nǝ nyɩɩ nǝ yee nyiceŋceŋ, kǝ nǝ lǝmǝ dutunuŋrǝ jeŋceŋ mǝ yupurǝ jeŋceŋ. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Lǝh ǝtǝŋ, kǝceece we, Kǝlowe la anyarǝtǝpǝ pǝ le pe tíi mǝ ǝkǝnǝŋ akpaŋyǝ yǝ kpii rǝ nǝ mǝrǝ. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Tuwǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ tɛŋ wǝ kaamǝ wǝ ǝnǝ, nyi ri ŋ nyi rǝ nǝ mǝrǝ ya láa tɛŋ na nɛŋwǝ. Yǝ ǝnǝ ya láa tɛŋ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Pɔlʊ la nɛŋ». Yǝ eni ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Apolo la nɛŋ». Pʊŋpwayǝ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Kefasǝ<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Pɛtǝro wǝ́ pǝ lǝ́ǝ tǝ pǝ ŋ pwo Kefasǝ.</char></note> la nɛŋ». Rɛɛyǝ ŋwǝ ŋkpɛ ǝkǝnǝŋ: «Ŋmǝ ŋ́ ri Kǝriso la nɛŋ». <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Kǝto nǝ nyo pu wǝ ǝkǝnǝŋ Kǝriso lǝ sǝpǝ? O lo nuŋ Pɔlʊ wǝ́ pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ rǝ nǝ yurǝ? Amaa pǝ wìiri nǝ worokomɛŋwǝ rǝ Pɔlʊ la nyɩŋrǝ? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Worokoyǝ sa le yeekǝ wǝ́ ŋ́ nee wiiri nǝ rɛ lo worokomɛŋwǝ wǝ, we Kǝripo mǝ Gayo ceŋceŋ ko. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Kǝto rɛ lǝŋ koru atɛŋ ǝkǝnǝŋ pǝ wìiri nǝ worokomɛŋwǝ rǝ mǝ nyɩŋrǝ! <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Ee! Ŋ́ na taalǝ, ŋ́ lɛ̀ ŋ wìiri Sitefana la anyarǝtǝpǝ lo worokomɛŋwǝ. Rǝ wǝla kǝmaakǝ we, ŋ́ naa lɔ ŋ́ nuŋ mǝŋ ŋ́ tǝ ŋ́ wìiri rɛ lo worokomɛŋwǝ ŋ kʊ̀la wǝ. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kǝriso lee kpii mǝ ŋ́ pe wiiri enyipǝ lo worokomɛŋwǝ. Le kpii mǝ ŋ́ pa tɛŋ Dieceeceerǝ we rǝ, ŋkǝ mǝ anyɩmaasɩpǝ le nimisiewǝ le eciatɛŋkǝ. Mǝŋkǝsa we, kǝ okopiyǝ we yǝ kpii rǝ Kǝriso la gbɛŋrǝ sa rǝ kpɛtɛkpǝlɛciiwǝ we, yǝ pee yee tukpaakpaawǝ.<verse eid="1CO 1:17" /></para>
  <para style="s">Yesu Kǝriso ŋ ri Worokoyǝ lo okopiyǝ mǝ ne nimisiewǝ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Kǝceece, vǝ́ pǝ ya pǝ láa tɛŋ Worokoŋtierǝ pǝ ŋ ru rǝ Kǝriso la gbɛŋrǝ rǝ kpɛtɛkpǝlɛciiwǝ we, anyɩŋ wǝ ri rǝ dʊkpaatǝtierǝ wǝ koonu epǝ we pǝ lǝ lǝǝ Worokoyǝ la cawǝ wǝ. Paa ŋlǝ epǝ we le kpii rǝ alɔkuŋkǝ la cawǝ we, dierǝ sa ɖi rǝ Worokoyǝ lo okopiyǝ goonu lǝ.<verse eid="1CO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CO 1:19" />Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1CO 1:19">«Ŋ́ nǝ́ǝ pǝlǝ enimisietǝpǝ le nimisiewǝ,</para>
  <para style="q1" vid="1CO 1:19">ŋ́ nǝ́ǝ nǝǝnǝ otucitǝpǝ lo otuciyǝ.»<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Kǝ la nyɩŋ nimisietǝyǝ wǝǝ? Kǝ la nyɩŋ sekaŋtǝyǝ wǝǝ? Kǝ la nyɩŋ ǝrǝkǝ sa le ciatɛŋtǝyǝ wǝǝ? Kǝto Worokoyǝ laa pɔrʊ ŋ kaŋ ǝkǝnǝŋ ǝrǝkǝ sa le nimisiewǝ wǝ ri rǝ tʊkpaatuwǝ? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Rǝ anʊkɔrǝyǝ we, Worokoyǝ ŋwǝŋwǝ la saŋ rǝ ne nimisiewǝ wǝ́ ŋ ne yee kǝ anyɩmaasɩpǝ, mǝŋ pǝle nimisiewǝ paape kǝ pǝ paa nyɩŋ Worokoyǝ pǝ ci. Kǝto Worokoyǝ lǝ fǝ la tɛɛ rǝ na wɛ ǝkǝnǝŋ ŋ náa lɔ ŋ koonu epǝ we pǝ la lɔ ŋwǝ pǝ lo nuŋ saŋ rǝ dierǝ sa enyipǝ pǝ ya pǝ láa nyɩŋ mǝŋ dʊkpaatǝtierǝ wǝ. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Oyudatǝpǝ we, pǝ lǝ́ǝ pǝ́ pǝ nyɩŋ rǝ tucovurǝ, wǝ́ Ehelatǝpǝ pǝ láa taa rǝ nimisiewǝ. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Ŋlǝ paa we, la ya yǝ láa tɛŋ Kǝriso pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ le dierǝ. Kpɛtɛkpǝlɛciiwǝ le dierǝ sa ɖi rǝ gbaraarǝ goonu Oyudatǝpǝ, wǝ́ ɖi dʊkpaatǝtierǝ goonu epǝ we pǝ lee ri Oyudatǝpǝ wǝ. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Paa epǝ we Worokoyǝ ŋ no pwo we, mǝŋ Oyudatǝ mǝŋ Ehelatǝ, Kǝriso ri Worokoyǝ lo okopiyǝ mǝ Worokoyǝ le nimisiewǝ koonu pǝ. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Duturǝ ɖi tuwǝ we enyipǝ pǝ ya pǝ láa nyɩŋ ǝkǝnǝŋ wǝ ri Worokoyǝ la tʊkpaatuwǝ we, wǝ sieni nimirǝ wǝ teeri anyɩmaasɩpǝ le nimisiewǝ. Wǝ́ tuwǝ we enyipǝ pǝ ya pǝ láa nyɩŋ ǝkǝnǝŋ wǝ ri Worokoyǝ la wǝfɔkpǝ we, wǝ lǝǝmǝ okopiyǝ wǝ teeri anyɩmaasɩpǝ lo okopiyǝ.<verse eid="1CO 1:25" /></para>
  <para style="s">Tuwǝ we Worokoyǝ ŋ na saa ŋ na pɔrʊ wǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Lǝh ǝtǝŋ, nǝ yɩrɩ enyipǝ nǝ ri, ŋnǝ epǝ we Worokoyǝ ŋ no pwo wǝ: Enimisietǝpǝ pǝ laa naanǝ rǝ nǝ mǝrǝ, okopilǝtǝpǝ pǝ laa naanǝ rǝ nǝ mǝrǝ, wǝ́ enyipǝ pǝ lo ru okuruyǝ pǝ laa lɛ pǝ naanǝ rǝ nǝ mǝrǝ. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Paa Worokoyǝ la saa tuwǝ wǝ ri tʊkpaatuwǝ rǝ ǝrǝkǝ le enimiyǝ la pɔrʊ ŋ fǝ ŋ kpii enimisietǝpǝ le kǝyepukǝ. Wǝ́ ŋ na saa tuwǝ wǝ ri fɔlɔfɔtǝtuwǝ rǝ ǝrǝkǝ le enimiyǝ ŋ na pɔrʊ ŋ fǝ ŋ kpii okopilǝtǝpǝ le kǝyepukǝ. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Tuwǝ we ǝrǝkǝ kǝ láa nyɩŋ wǝ laa lɔ okuruyǝ rɛ, pǝ lǝŋ kǝ wǝ pǝ kpii rǝ tǝrɛ lǝ mǝrǝ, wǝ́ pǝ láa fʊʊ wǝ pǝ ŋ sǝǝlǝ we, Worokoyǝ la saa wǝ la pɔrʊ ŋ fǝ ŋ nǝǝnǝ tuwǝ we ǝrǝkǝ kǝ la nyɩŋ wǝ la lɔ okuruyǝ wǝ. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Mǝŋkǝsa we, kǝ nyɩmaasɩyǝ rɛ ŋ paa pa rɛɛrɩ mǝ na wɛ rǝ Worokoyǝ la kǝnyɩŋkǝ. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Saŋ rǝ ŋwǝ Worokoyǝ wǝ́ nǝ nye yee nyiceŋceŋ mǝ Yesu Kǝriso. Wǝ́ Kǝriso ŋ na siɛrɩ ŋ ne yee nimisiewǝ we wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ ŋ no koonu lǝ. Saŋ rǝ Kǝriso wǝ́ yǝ le yee enyikʊʊpǝ rǝ Worokoyǝ la kǝnyɩŋkǝ. La saa lǝ le tii vɔrʊrǝ lo koonu Worokoyǝ, wǝ́ ŋ náa lɛ mǝ ŋ pɔrʊ lǝ mǝ ŋ ru rǝ oturɔɔrɔɔyǝ lǝ mǝrǝ. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Kǝto we, mǝŋ kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ wǝ kǝtǝ we: «Mǝŋ rɛ lǝ́ǝ fǝ na wɛ ŋ faa faawǝ we, mǝ ŋ faa faawǝ rǝ tuwǝ we Kulǝtǝyǝ ŋ ne yee wǝ.»<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Pɔlʊ la tɛŋ Kǝriso pǝ la kpaa pǝ la maarǝ rǝ kpɛtɛkpǝlɛciiwǝ le dierǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Lǝh ǝtǝŋ, wǝ kǝto ŋmǝ ŋkpɛ kǝ́ ŋ́ pǝlǝ nǝ kpǝŋ ŋ́ pa tɛŋ Worokoyǝ le dieŋwaarǝ sa ŋ́ tíi nǝ we, ŋ́ nǝǝ fǝ etiekpoopuyǝ rɛ amaa eciatɛŋkǝ ŋ́ wɛɛlɩ. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Duturǝ ɖi kǝ́ ŋ́ ke kpii rǝ nǝ kpǝŋ we, ŋ́ nǝǝ pǝ́ ŋ́ ci tu ri ŋ tu ŋ́ teeri Yesu Kǝriso, yǝ we pǝ kpàa pǝ màarǝ rǝ kpɛtɛkpǝlɛciiwǝ wǝ. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Kǝ́ ŋ́ ke kpii rǝ nǝ kpǝŋ we ŋmǝŋmǝ ŋ́ ke ri fɔlɔfɔtǝyǝ, fusuutǝyǝ, wǝ́ ŋ́ ka ŋ ca kpakpa. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Rǝ mǝ awɛɛlɩkǝ mǝ mǝ otukaŋyǝ mǝrǝ we, nimisiewǝ le eciawɛɛlɩkǝ la tǝrɛ wǝ lee ke kpii, paa Worokoyǝ la Wɛɛrǝ lo okopiyǝ yǝ ka ŋ nyɩnɩ rǝ mǝ tutɛŋwǝ, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />kǝ nǝ lɔnuŋrǝ baa nya fɛɛ dɔ dɛɛ rǝ anyɩmaasɩpǝ le nimisiewǝ, paa kǝ dɔ dɛɛ rǝ Worokoyǝ lo okopiyǝ.<verse eid="1CO 2:5" /></para>
  <para style="s">Worokoyǝ le nimisiewǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Ŋlǝ paa we, nimisiewǝ rɛ wǝ́ ŋla ŋkpɛ la ya yǝ láa kaŋ alɔnuŋtǝpǝ we pǝ la wasa rǝ lɔnuŋrǝ wǝ. Nimisiewǝ sa we, wǝ lee ri ǝrǝkǝ sa le nimisiewǝ amaa epǝ we pǝ ya pǝ lée ri wǝpilikpǝ rǝ ǝrǝkǝ sa ǝkǝ pǝ lǝh pǝ kpǝ́ pǝ nǝŋ la nɛŋwǝ. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Paa Worokoyǝ le nimisiewǝ we wǝ ri tuŋwaawǝ ǝkǝ wǝ la ŋwaa wǝ kpɛlɩ we, wǝ́ la ya yǝ láa kaŋ. Kpɛŋ kǝ Worokoyǝ ŋ po co ǝrǝkǝ we, anyɩŋ la marǝ la kpaka nimisiewǝ sa lǝ tǝnǝ ŋ pǝ fǝ ŋ rɛɛrɩ mǝ lǝ. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Epǝ we pǝ ya pǝ lée ri wǝpilikpǝ rǝ ǝrǝkǝ sa la rɛ lee ke ci nimisiewǝ sa. Mǝŋ pǝ ke cii wǝ we, pǝ laa ka kpaa wǝnyɩɩnɩkpǝ lo Kulǝtǝyǝ pǝ maarǝ rǝ kpɛtɛkpǝlɛciiwǝ. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Paa mǝŋ kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ we:</para>
  <para style="q1" vid="1CO 2:9">«Tuwǝ we nimirǝ vaa nyɩŋ dǝnǝ,</para>
  <para style="q1" vid="1CO 2:9">tuwǝ we kǝtukoŋkǝ kǝ foo nuŋ kǝ tǝnǝ,</para>
  <para style="q1" vid="1CO 2:9">tuwǝ we wǝ fǝǝ pǝ nyiyǝ lo yurǝ wǝ nyɩŋ we,</para>
  <para style="q1" vid="1CO 2:9">Ŋ wǝ wǝ́ Worokoyǝ ŋ na kpaka ŋ nǝ tǝnǝ epǝ we pǝ láa taa nǝ kǝǝwǝ wǝ».<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ŋlǝ wǝ́ Worokoyǝ ŋ na pɔrʊ wǝ ŋ na kaŋ saŋ rǝ Wɛɛkenikenirǝ. Duturǝ ɖi Wɛɛkenikenirǝ lóo co nimirǝ lǝ ŋ yɩrɩ tu ri ŋ tu sɩsiɛrɩ, wǝ ke ce wǝ ri Worokoyǝ lo oyupuyǝ we yǝ la ŋwaa rǝ ŋwǝ Worokoyǝ lǝ mǝrǝ wǝ. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ǝlǝ ŋ cii tuwǝ wǝ kpii nyɩmaasɩyǝ rǝ yurǝ wǝ? We tɛŋ wɛɛrǝ we gbii rǝ nyiyǝ we ceŋceŋ ko. Kaa wǝǝ rɛ lee ci tuwǝ wǝ kpii Worokoyǝ rǝ yurǝ, we tɛŋ Worokoyǝ la Wɛɛrǝ ceŋceŋ ko. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ŋlǝ we, yǝ laa lɔ ǝrǝkǝ sa la wɛɛrǝ, paa Wɛɛrǝ we lo ru rǝ Worokoyǝ lǝ kpǝŋ wǝ́ yǝ la lɔ, kǝ la nya fɛɛ le ci otukoonuyǝ we Worokoyǝ ŋ no koonu lǝ rǝ na lɛsiɛrɩwǝ we mǝrǝ wǝ. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />Wǝ́ yǝ lǝŋ fǝ etieyǝ we anyɩmaasɩpǝ le nimisiewǝ wǝ la kaŋ la wɛɛlɩ lo ru rǝ otukoonuyǝ sa, paa etieyǝ we Worokoyǝ la Wɛɛrǝ la kaŋ lǝ wǝ́ yǝ lǝ́ǝ fǝ yǝ ŋ wɛɛlɩ yǝ ŋ ru rǝ otukoonuyǝ sa. Kǝ́ yǝ láa pɔrʊ anʊkɔrǝyǝ we yǝ kpii rǝ Wɛɛrǝ lo duturǝ yǝ ŋ tíi epǝ we pǝ kpii mǝ ŋrǝ Wɛɛrǝ sa yǝ ŋ fǝ wǝǝ.<verse eid="1CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 2:14" />Nyɩmaasɩyǝ we ŋ nǝǝ lǝmǝ Worokoyǝ la Wɛɛrǝ we, lǝŋ koru alɔ otuyǝ we yǝ lo ru rǝ Worokoyǝ la Wɛɛrǝ lǝ kpǝŋ. Yǝ ri rǝ atʊkpaatuyǝ yǝ koonu ŋwǝ, wǝ́ lǝŋ lɛ ŋ koru onuŋ yǝlo duturǝ kpiikǝ Worokoyǝ la Wɛɛrǝ ceŋceŋ ko lóo koonu nyiyǝ ŋ tie yǝ ŋ yɩrɩ kǝ ŋ nuŋ yǝlo duturǝ wǝ. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Paa nyiyǝ we ŋ lǝǝmǝ Worokoyǝ la Wɛɛrǝ we, lóo koru etie tu ri ŋ tu ŋ yɩrɩ kǝ ŋ nuŋ yǝlo duturǝ. Ŋwǝ paa rɛ lǝŋ koru etie ŋwǝ ŋ yɩrɩ kǝ ŋ nuŋ no duturǝ. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1CO 2:16">«Ǝlǝ ŋ cii Ǝtǝ Woroko lo yupurǝ?</para>
  <para style="q1" vid="1CO 2:16">Ǝlǝ ŋ nóo koru eci ŋ kaŋ ŋwǝ?»</para>
  <para style="m" vid="1CO 2:16">Ŋlǝ paa we, Kǝriso lo yupurǝ wǝ́ lǝ lǝǝmǝ.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Oworokoŋtietɛŋtǝpǝ la kǝnǝnɛkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Lǝh ǝtǝŋ, ŋmǝ we, kǝ́ ŋ́ ke kpii rǝ nǝ kpǝŋ we, ŋ́ noo koru awɛɛlɩ ŋ́ tíi nǝ mǝŋ enyipǝ rɛ pǝ lǝǝmǝ Worokoyǝ la Wɛɛrǝ kǝtǝ. Ŋ́ wɛ̀ɛlɩ ŋ́ tìi nǝ mǝŋ kǝ́ ŋ́ náa wɛɛlɩ ŋ́ tíi ǝrǝkǝ sa le enyipǝ kǝtǝ, mǝŋ kǝ́ ŋ́ náa wɛɛlɩ ŋ́ tíi ekǝrisotǝpǝ we pǝ tǝ pǝ ri epiŋwɛŋpǝ rǝ lɔnuŋrǝ mǝrǝ kǝtǝ. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Akɔɔrʊnyɩŋpǝ wǝ́ ŋ́ no koonu nǝ, ŋkǝ keeriwǝ wǝ tǝnǝ wǝ́ ŋ́ no koonu nǝ. Duturǝ ɖi nǝ nyoo ko koru wǝ le eri mǝ eniyǝ we. Wǝ ke ce wǝ ri rǝkǝsa kʊraa we, nǝ nyǝŋ koru eri wǝ. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Duturǝ ɖi nǝ tǝ nǝ ya nǝ nyée tii vɔrʊrǝ mǝŋ ǝrǝkǝ sa le enyipǝ kǝtǝ, wǝ́ wǝtɛlɩkpǝ mǝ akpaŋyǝ yǝ kpii rǝ nǝ mǝrǝ. Kǝto ŋkǝ nǝ tǝ nǝ ya nǝ nyée tii vɔrʊrǝ mǝŋ ǝrǝkǝ sa le enyipǝ kǝtǝ rǝ? Kǝto ŋkǝ nǝ tǝ nǝ ya nǝ nyée re nǝ wɛ mǝŋ kǝ́ enyikpǝlo pǝ lée re pǝla wɛ kǝtǝ rǝ? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Kǝ́ rǝ nǝ mǝrǝ nyirɛɛyǝ ŋ ya ŋ náa tɛŋ ǝkǝnǝŋ «Ŋmǝ ŋ́ ri Pɔlʊ la nɛŋ», wǝ́ pʊŋpwayǝ ǝkǝnǝŋ «Ŋmǝ ŋ́ ri Apolo la nɛŋ» wǝǝ, kǝto ŋkǝ nǝ tǝ nǝ yaa nǝ nyée yee otuyǝ mǝŋ kǝ́ enyikpǝlo pǝ lée yee kǝtǝ rǝ?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Ǝlǝ ŋ ri Apolo? Wǝ́ ǝlǝ ŋ ri Pɔlʊ? Worokoyǝ la anǝnɛyeetǝpǝ wǝ́ le ri ko feepi wǝǝ, wǝ́ saŋ rǝ ŋlǝ wǝ́ Worokoyǝ ŋ nǝ fǝ nǝ ŋ ne yee alɔnuŋtǝpǝ. Nyi ri ŋ nyi rǝ lǝh mǝrǝ le yee kǝnǝnɛkǝ we Ǝtǝ Worokoyǝ ŋ ne kpii ŋwǝ ŋ yee saŋ rǝ tukoonuwǝ we ŋ no koonu ŋwǝ wǝ. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ŋmǝ we, ŋ́ na tɔ wǝciikpǝ, wǝ́ Apolo ŋ ne fieni kpǝ la mɛŋwǝ, paa Worokoyǝ ŋ no koonu wǝ́ wǝ la naanǝ. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Kǝto we, yǝ we ŋ na tɔ mǝ yǝ we ŋ ne fieni mɛŋwǝ we, pǝ lee ri tǝrɛ. Worokoyǝ ceŋceŋ ŋ lǝ kpuŋkpuruŋ wǝ, ŋwǝ yǝ we ŋ no kuŋ wǝciikpǝ sa wǝ la naanǝ wǝ. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Yǝ we ŋ náa tɔ wǝciikpǝ mǝ yǝ we ŋ née fieni kpǝ la mɛŋwǝ we, pǝ kaa rǝ. Worokoyǝ lah pa mwara yǝ ri ŋ yǝ lo wǝtookpǝ saŋ rǝ yǝ we la kǝnǝnɛkǝ ŋ ne yee wǝ. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Duturǝ ɖi la ya yǝ lée yee anǝnɛyǝ fɛɛceŋceŋ yǝ ŋ koonu Worokoyǝ, wǝ́ ŋnǝ nǝ ri Worokoyǝ la atɛɛkǝ, wǝ́ nǝ lɛ nǝ ri Worokoyǝ la nyarǝwǝ. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Saŋ rǝ Worokoyǝ la lɛsiɛrɩwǝ we ŋ ne yee mǝ we, ŋ́ no co giriŋrǝ la kǝtɛɛkǝ mǝŋ kumarǝtǝyǝ rɛ ŋ cii kǝnǝnɛkǝ sɩsiɛrɩ kǝtǝ. Wǝ́ nyipʊŋpwayǝ rɛ ŋ ya ŋ náa tɔ mǝ ŋ tɛɛ. Paa wǝ kpii kǝ nyi ri ŋ nyi ŋ yee yurǝ rǝ wǝlǝkpǝ we ŋ ya ŋ náa tɔ kpǝ mǝ ŋ fǝ wǝ. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Rɛ lǝŋ koru oco kǝtɛɛpʊŋpwakǝ rɛ, duturǝ ɖi kǝtɛɛkǝ kǝ cò kaka. Kǝtɛɛkǝ sa kǝ kaamǝ Yesu Kǝriso. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Wǝ ke ri rɛ lǝ fǝ rǝ sɩkamwɛɛrɩyǝ, wǝ́ rɛ sɩkakpɛɛlɩyǝ, wǝ́ rɛ asɩkaruyǝ, wǝ́ rɛ eciiyǝ, wǝ́ rɛ bɔɔrǝ amaa gáarǝ la marǝ la tɛɛ rǝ kǝtɛɛkǝ sa we, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />jitɛŋakpaŋyǝ we, nyi ri ŋ nyi la kǝnǝnɛkǝ ŋ ne yee kǝ láa nyɩnɩ, kǝ pǝ nyɩŋ kǝ pǝ ci. Duturǝ ɖi jirǝ we loh po ru mǝ naawǝ, kǝ naawǝ sa wǝ tie nyi ri ŋ nyi la kǝnǝnɛkǝ wǝ yɩrɩ tuwǝ wǝrʊʊkpǝ kǝ ri wǝ. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Mǝŋ rɛ la kǝnǝnɛkǝ ŋ ne yee ŋ na tɛɛ rǝ kǝtɛɛkǝ sa kǝ lo koru atɔ kǝ la yaa rǝ naawǝ sa we, yǝ we láa lɔ wǝtoomwarakpǝ. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Paa mǝŋ rɛ la kǝnǝnɛkǝ ŋ ne yee kǝ le yee naa we, yǝ we lǝ́ǝ lǝǝrǝ no wǝtoomwarakpǝ. Ŋwǝŋwǝ we, láa nya alɔkuŋkǝ, paa wǝ lǝ́ǝ lǝ rǝ mǝŋ kǝ́ nyiyǝ ŋ no suu ŋ no ru rǝ naawǝ rɛ mǝrǝ kǝtǝ.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Kǝto nǝ nyee ci wǝ ǝkǝnǝŋ Worokoyǝ la nyarǝwǝ wǝ́ nǝ ri, wǝ́ Worokoyǝ la Wɛɛrǝ gbii rǝ nǝ mǝrǝ? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Mǝŋ rɛ la wɔɔ Worokoyǝ la nyarǝwǝ we, Worokoyǝ lǝ́ǝ nǝǝnǝ ŋwǝ. Awo, Worokoyǝ la nyarǝwǝ wǝ lǝ kenikeni, wǝ́ ŋnǝ nǝ ri Worokoyǝ la nyarǝwǝ sa wǝ.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Rɛ ŋ pǝǝ tǝǝnǝ na wɛ oo. Mǝŋ rɛ rǝ nǝ mǝrǝ ya lóo pu wǝ ǝkǝnǝŋ ŋwǝ ŋ sieni nimirǝ mǝŋ kǝ́ ǝrǝkǝ kǝ lǝ pǝ́ wǝ we, yǝ we ŋ siɛrɩ na wɛ ŋ yee owuuyǝ bomu kǝ ŋ nya fɛɛ ŋ siɛrɩ ŋ yee nimisietǝpoŋpiyǝ. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Duturǝ ɖi ǝrǝkǝ sa le nimisiewǝ we, wǝ ri rǝ tʊkpaatuwǝ rǝ Worokoyǝ le enimiyǝ. Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Worokoyǝ láa pɔrʊ enimisietǝpǝ rǝ ŋpǝŋpǝ pǝle wǝpiekpǝ la kpɛrɛwǝ». <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Wǝ lǝ tǝ wǝ la tɛŋ ǝkǝnǝŋ: «Ǝtǝ Woroko cii enimisietǝpǝ lo oyupuyǝ. Cii wǝ ǝkǝnǝŋ tukpaakpaawǝ wǝ́ yǝ ri.» <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Kǝto rɛ ŋ pǝǝ fǝ nyɩmaasɩyǝ ŋ faa faawǝ, duturǝ ɖi tu ri ŋ tu wǝ ri nǝ nɛŋ. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Wǝ ke ri Pɔlʊ oo, wǝ ke ri Apolo amaa Kefasǝ oo, wǝ ke ri ǝrǝkǝ sa oo, vɔrʊrǝ amaa gbɛŋrǝ oo, wǝ ke ri otuyǝ we yǝ kpii rǝkǝsa amaa ǝyǝ yǝ leh pe kpii kǝmaamaa oo, yǝlo kpǝlo kɩɩkɩ yǝ ri nǝ anɛŋ. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />Paa ŋnǝ we, nǝ ri Kǝriso la anɛŋ wǝ́ Kǝriso ŋ ri Worokoyǝ la nɛŋ.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Kǝriso le enyikpiipǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Wǝ kpii kǝ nǝ mǝ nyɩŋ lǝ rǝ mǝŋ Kǝriso la anǝnɛyeetǝpǝ mǝ Worokoyǝ lo otuŋwaayǝ lo oyuyɩrɩtǝpǝ. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Tuwǝ pǝ lǝ pǝ́ pǝ lo ru rǝ oyuyɩrɩtǝpǝ lǝ kpǝŋ wǝ kaamǝ ǝkǝnǝŋ pǝ ri anʊkɔrǝyǝ. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ŋmǝ paa we, nǝ ka tɛŋ mǝ wǝkpaŋkpǝ oo, amaa anyɩmaasɩpǝ pǝ ka tɛŋ mǝ wǝkpaŋkpǝ rǝ fɛɛtɛŋakpaŋyǝ rɛ oo, wǝ lǝǝ fǝ mǝ fɛɛwǝ rɛ. Ŋ́ nǝŋ lɛ ŋ́ tɛŋ mǝ wɛ la wǝkpaŋkpǝ ŋmǝŋmǝ. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Ŋ́ naa ya ŋ́ náa tɔɔ mǝ wɛ la bɔrǝ rǝ tǝrɛ, paape wǝ laa kaŋ ǝkǝnǝŋ ŋmǝ ŋ́ kʊʊ oo. Ǝtǝ Woroko ŋ ri mǝ kpaŋtɛŋtǝyǝ wǝ. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Kǝto nǝ paa tɛŋ rɛ la wǝkpaŋkpǝ kpɛŋ kǝ eniyǝ yǝ ci oro, eniyǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ wǝ. Otuyǝ we kpǝlo kɩɩkɩ yǝ la ŋwaa yǝ kpii rǝ nuŋtumuwǝ we, loh po ru mǝ yǝ rǝ wǝnyɩɩnɩkpǝ kǝ ŋ pɔrʊ enyipǝ lo oyupuyǝ we yǝ la ŋwaa yǝ kpii pǝ rǝ yurǝ ŋ kaŋ. Eniyǝ we Worokoyǝ lǝh fǝ nyi ri ŋ nyi lǝ ǝkǝkǝ we kǝ kaamǝ ŋwǝ we, ŋ koonu ŋwǝ.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Lǝh ǝtǝŋ, nǝ yurǝ kǝto wǝ́ ŋ́ nǝ fǝ ŋmǝŋmǝ mǝ wɛ mǝ Apolo ŋ́ ne yee anyɩŋcamǝkǝ rǝ dierǝ sa wǝ. Ŋ́ nǝ pǝ́ nǝ karǝ tutɛŋwǝ sa lo duturǝ nǝ ru rǝ lah anyɩŋcamǝkǝ sa ǝkǝnǝŋ: «Nǝ poo ruu nǝ ko nǝ teeri tuwǝ we pǝ la ŋʊrʊ wǝ». Rɛ ŋ paa rɛɛrɩ mǝ na wɛ mǝ kǝ́ ŋ kpii rǝ nyiyǝ rɛ la kǝtakǝ kǝ ŋ yi ŋ tɛɛ rǝ nyipʊŋpwayǝ. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ǝlǝ paa ŋ nǝ fǝ lǝ́ ǝkǝnǝŋ ŋlǝ́ e teeri enyituturupǝ wǝ? Kǝ́ lo tu wǝ́ ǝ lǝǝmǝ kǝ oturu ŋkǝ Worokoyǝ ŋ no koonu lǝ́ wǝ wǝ? Kǝ́ e cii wǝ ǝnǝ wǝǝ, kǝ́ kǝto wǝ́ a ya láa rɛɛrɩ mǝ lá wɛ rǝ tuwǝ sa ǝ lǝǝmǝ kǝ a tɛŋ pǝ loo koonu lǝ́ wǝ rǝ ǝnǝ? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />Nǝ nya marǝ anya tu ri ŋ tu nǝ ya nǝ nyǝ́ǝ pǝ́ wǝ! Nǝ nya marǝ anya nǝ wɛ! Nǝ nya siɛrɩ nǝ nye yee epilipǝ paa ŋlǝ yǝ laa kʊla! Ŋ́ nǝ pǝ́ nǝ ke ri epilipǝ kǝceece, kǝ ŋla ŋkpɛ la ka nya fɛɛ le pe ri wǝpilikpǝ la kʊla mǝ nǝ! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Kpiikǝ we, wǝ lǝ mǝ rǝ mǝŋ Worokoyǝ lǝ fǝ ŋlǝ enyikpiipǝ le yee anyɩmaasɩpǝ lǝ ǝtǝtǝǝlǝpǝ, mǝŋ pǝ la tɔɔ lǝ gbɛŋpɔrǝ rǝ canɩtiwǝ. Pǝ lǝ fǝ lǝ pǝ lo co dumɔŋrǝ pǝ lo koonu ǝrǝkǝ kpǝlo mǝ epicoŋpipǝ mǝŋ anyɩmaasɩpǝ. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Yǝ la siɛrɩ yǝ le yee oyufiitǝpǝ rǝ Kǝriso lo yurǝ kǝto, paa ŋnǝ we, nǝ sieni nimirǝ mǝ kǝ́ nǝ nye yee nyiceŋceŋ mǝ Kǝriso kǝto. Ŋlǝ we, afɔlɔfɔtǝpǝ wǝ́ le ri, paa ŋnǝ we, okopilǝtǝpǝ wǝ́ nǝ ri. Pǝ lóo pu nǝ, paa ŋlǝ we, pǝ lǝŋ kǝ lǝ pǝ kpii rǝ tǝrɛ! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Po ro ǝrǝ eniyǝ sa wǝ́ lǝ tǝ la ya yǝ láa wʊ kǝtɛŋkǝ mǝ kǝmɛŋtɛŋkǝ. Yǝ lǝǝ lǝmǝ kǝkpakǝ, yǝ la lɔ ocuculupiyǝ wǝ́ lo co yǝ láa tɛlɩ. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />La ya yǝ láa nyɩɩ yǝ ŋ yee anǝnɛyǝ mǝ ŋlǝŋlǝ lah wǝkaakpǝ. Vǝ́ enyipǝ pǝ la fɛɛpɩ lǝ we, a yǝ ŋ pɛɛrɩ pǝ. Vǝ́ pǝ le yi pǝ la tɛɛ rǝ lǝ we, a yǝ ŋ lɔ wǝ mǝ turutawǝ. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Vǝ́ enyipǝ pǝ tɛnɩ lǝ pǝ láa tɛlɩ we, ŋlǝ paa yǝ láa wɛɛlɩ mǝ pǝ mǝ wǝtaarǝkpǝ. Po ro ruŋruŋ we, yǝ la siɛrɩ yǝ le yee rǝ mǝŋ otucɛɛlɩyǝ, mǝŋ otuyǝ yǝ co rǝ doŋtoŋrǝ yǝ lo koonu ǝrǝkǝ.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ŋ́ naa ŋʊrʊ otuyǝ sa kǝ ŋ́ fǝ ŋ́ kpii nǝ kǝyepukǝ rǝ, paa kǝ ŋ́ fǝ ŋ́ ci ŋ́ kaŋ nǝ mǝŋ mǝ epipǝ ŋ́ nǝŋ kuŋ oruukǝ kǝtǝ. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Duturǝ ɖi wǝ ke ce wǝ ri ǝkǝnǝŋ ŋnǝ nǝ lǝǝmǝ otukaŋtǝpǝ lafawǝ tǝ pǝ ya pǝ láa kaŋ nǝ kǝ́ nǝ nyée tii vɔrʊrǝ rǝ Kǝriso mǝrǝ nǝ fǝ we, tǝyǝ ceŋceŋ ko wǝ́ nǝ lǝǝmǝ. Rǝ nǝ vɔrʊrǝ rǝ Yesu Kǝriso mǝrǝ we, ŋmǝ ŋ́ nǝ mǝ nǝ, kpiikǝ ŋmǝ ŋ́ tɛnɩ Dieceeceerǝ we ŋ́ tìi nǝ wǝ. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Tuwǝ kǝto ŋ́ ya ŋ́ náa nyɩɩ mǝ nǝ kǝ nǝ karǝ mǝ wǝǝ. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Ŋ wǝ kǝto wǝ́ ŋ́ ne kpii Timote ŋ́ na maŋ nǝ. Mǝ piyǝ ŋ́ náa taa kǝǝwǝ mǝ nʊkɔrǝlǝtǝyǝ rǝ Kulǝtǝyǝ mǝrǝ wǝ́ ŋ ri. Lah pa taalǝ nǝ wǝlǝkpǝ we ŋ́ ne re mǝ vɔrʊrǝ rǝ Kǝriso mǝrǝ wǝ, mǝŋ kǝ́ ŋ́ náa kaŋ wǝ mǝ ŋ tɛlɩ rǝ fɛɛ ri ŋ fɛɛ, rǝ alɔnuŋtǝpǝ la wǝcakukpǝ kpǝlo kɩɩkɩ wǝ. <verse eid="1CO 4:17" /><verse number="18" style="v" sid="1CO 4:18" />Arɛɛpǝ pǝ lo pu wǝ ǝkǝnǝŋ ŋmǝ ŋ́ nǝŋ tǝ ŋ́ pa siɛnɩ ŋ́ pǝ nǝ kpǝŋ, wǝ́ pǝ ya pǝ láa rɛɛrɩ mǝ pǝla wɛ. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Paa mǝŋ Kulǝtǝyǝ la tɛɛnɩ we, wǝ lǝŋ panǝ ŋ́ nǝ́ǝ pǝ nǝ kpǝŋ. Ŋkǝ kǝ ŋ́ pe ci etieyǝ we ŋpǝ awɛɛrɛɛrɩmǝtǝpǝ sa pǝ ya pǝ láa wɛɛlɩ wǝ, paa kǝ ŋ́ pa nyɩŋ pǝlo okopiyǝ ŋ́ ci. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Duturǝ ɖi Worokoyǝ le wǝpilirikpǝ we, wǝ lee ri rǝ awɛɛlɩkǝ, paa okopiyǝ lo tuwǝ wǝ lǝǝwe. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Nǝ nyǝ́ǝ pǝ́ rǝ kǝ́? Ŋ́ fǝ rǝ fwɛɛpǝlawǝ amaa ziɔŋrǝ lǝ lǝ mǝ kǝǝtaawǝ mǝ wǝlǝtaarǝkpǝ ŋ́ pǝ nǝ kpǝŋ?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Enyipǝ pǝ ya pǝ lée yee nuŋruwǝ rǝ alɔnuŋtǝpǝ lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Yǝ lo nuŋ enyipǝ pǝ ya pǝ láa tɛŋ rǝ fɛɛ ri ŋ fɛɛ ǝkǝnǝŋ arɛɛpǝ rǝ nǝ mǝrǝ pǝ ya pǝ lée yee nuŋruwǝ rɛ. Nuŋruwǝ sa wǝrʊʊkpǝ we, epǝ we pǝ lǝŋ sʊma Worokoyǝ ǝkǝŋtǝ pǝ lǝŋ yee wǝ. Wǝ ri nɛ? Rɛ rǝ nǝ mǝrǝ láa kpɛɛ mǝ nǝ tǝ le tie! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Wǝ́ nǝ ya nǝ nyáa rɛɛrɩ mǝ nǝ wɛ ǝnǝ! Bomu nǝ keh fii gʊʊpirǝ ŋpa kǝ nǝ pɔrʊ yǝ we ŋ ne yee tuwǝ sa nǝ cɛ rǝ nǝ mǝrǝ. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ŋmǝ paa we, ŋ́ lǝǝrǝ mǝ nǝ rǝ wɛlɛŋrǝ, paape ŋ́ kpii ŋ kʊla mǝ nǝ rǝ wɛɛrǝ mǝrǝ. Kǝto ŋ́ na marǝ ŋ́ na tɛŋ yǝ we ŋ ne yee tuwǝ sa wǝrʊʊkpǝ la wǝkpaŋkpǝ kǝ a tɛŋ ŋmǝ ŋ́ kpii ŋ́ kʊla mǝ nǝ rǝ. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Vǝ́ nǝ nyo po ko ku rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ mǝrǝ mǝ no okopiyǝ mǝrǝ we, ŋ́ née kpii ŋ́ kʊla mǝ nǝ rǝ wɛɛrǝ. <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />Nǝ fǝ nyiyǝ sa wǝrʊʊkpǝ nǝ kpii Satana rǝ akaakǝ kǝ ŋ pǝlǝ na wɛlɛŋrǝ ŋ co, paa kǝ na wɛɛrǝ nya alɔkuŋkǝ mǝ Kulǝtǝyǝ le jirǝ we.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Wǝ laa laka kǝ nǝ mǝ rɛɛrɩ mǝ nǝ wɛ! Nǝ nyee ci wǝ sɩsiɛrɩ ǝkǝnǝŋ dafaŋrǝ ŋɩnɩŋɩnɩ ko lóo fuunu fuŋtuwǝ pǝ lo furu kpǝlo kɩɩkɩ wǝ? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Kǝto nǝ lɛrɩ nǝ wɛ. Nǝ pɔrʊ turɔɔrɔɔwǝ la dafaŋkururǝ sa nǝ cɛ rǝ nǝ mǝrǝ. Mǝŋkǝsa we, nǝ nyǝ́ǝ lǝ mǝŋ fuŋtuŋwɛŋwǝ pǝ lo furu wǝ́ pǝ lee kpii dafaŋrǝ kǝtǝ. Wǝ́ kǝceece kǝ́ nǝ marǝ nǝ lǝ wǝǝ, duturǝ ɖi Kǝriso ŋ ri lah mɛɛpirǝ we pǝ lǝ fǝ pǝ le yee otoolukǝ mǝ Eyinyapǝkǝ la wǝcɛkpǝ wǝ. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Kǝto nǝ pǝ kǝ le ri Eyinyapǝkǝ la wǝcɛkpǝ sa mǝ kpɔnɔyǝ we pǝ lee kpii dafaŋrǝ mǝ ziɔŋrǝ gʊʊ mǝ anʊkɔrǝyǝ. Ŋkǝ mǝ kpɔnɔyǝ we ŋ kpii mǝ dafaŋkururǝ wǝ. Dafaŋkururǝ sa gaamǝ turɔɔrɔɔwǝ mǝ yulɛnyɩrǝ.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Ŋ́ ŋʊ̀rʊ ŋ́ kpìi nǝ rǝ mǝ kǝfwɛɛkǝ we ŋ́ manǝ nǝ ǝkǝnǝŋ nǝ poo toomu kǝloŋkǝ mǝ epǝ we pǝ lée yee nuŋruwǝ wǝ. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Ŋkǝ epǝ we kpǝlo kɩɩkɩ pǝ lée yee nuŋruwǝ rǝ ǝrǝkǝ sa amaa epǝ we pǝ láa mwɛɛrɩ otuyǝ le nimirǝ, ayɩlayɩtǝpǝ amaa afɛɛsʊmatǝpǝ wǝ́ ŋ́ reemǝ. Mǝŋ kaa wǝǝ we, we nǝ koh ru nǝ cɛ rǝ ǝrǝkǝ rǝ! <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Ŋ́ kǝ ŋ pǝ́ ŋ́ tíi nǝ we, mǝŋ rɛ lóo pwo na wɛ kǝrisotǝpiyǝ paa wǝ́ ŋ née yee nuŋruwǝ amaa nimimwɛɛrɩwǝ, wǝ́ ŋ náa sʊma afɛɛyǝ amaa ŋ náa tɛŋ enyipǝ, wǝ́ ŋ ri fǝŋpiemutǝyǝ amaa ŋ náa yɩɩ we, nǝ poo toomu kǝloŋkǝ mǝ yǝ we. Nǝ pee ce nǝ kpii akaakǝ nǝ ri fɛɛceŋceŋ mǝ nyiyǝ sa wǝrʊʊkpǝ. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />Ŋkǝ ŋmǝ ŋ́ náa tɛŋ epǝ we pǝ lee ri ekǝrisotǝpǝ la wǝkpaŋkpǝ. Paa epǝ we pǝ ri ekǝrisotǝpǝ mǝŋ ŋnǝ kǝtǝ we, ŋnǝ nǝ nyáa tɛŋ pǝla wǝkpaŋkpǝ wǝ. <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Epǝ we pǝ lee ri ekǝrisotǝpǝ we, Worokoyǝ ŋ náa tɛŋ pǝla wǝkpaŋkpǝ wǝ. Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Nǝ piri nyirɔɔrɔɔyǝ rǝ nǝ mǝrǝ».<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Nǝ tɛŋ nǝ wǝkpaŋkpǝ rǝ alɔnuŋtǝpǝ lǝ kpǝŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Vǝ́ kǝwɛɛlɩkǝ rɛ kǝ lǝ pǝ rǝ nǝ mǝrǝ we, nǝ nyǝŋ tɛŋ wǝkpaŋkpǝ sa rǝ epǝ we pǝ ri Worokoyǝ la anɛŋpǝ lǝ kpǝŋ, paa oturu nǝ nyáa tɛlɩ nǝ ka tɛŋ kpǝ rǝ epǝ we pǝ lǝŋ sʊma Worokoyǝ lǝ kpǝŋ. Nɛ kǝto wǝ́ nǝ nyáa ca turuwǝ nyǝ ŋ yee wǝ ǝnǝ? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Nǝ nyee ci wǝ ǝkǝnǝŋ Worokoyǝ la anɛŋpǝ pǝ lah pa ka tɛŋ ǝrǝkǝ sa la wǝkpaŋkpǝ wǝ? Wǝ́ mǝŋ ŋnǝ nǝ nyah pa tɛŋ ǝrǝkǝ sa la wǝkpaŋkpǝ wǝǝ, kǝ nǝ fɔ etiepiyǝ sa yǝ lee ri tǝrɛ la atɛŋkǝ? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Nǝ nyee ci wǝ ǝkǝnǝŋ ŋlǝ yǝ lah pa ka tɛŋ epicoŋpipǝ la wǝkpaŋkpǝ wǝ? Kǝ e ci ǝ pǝ pǝ́ rǝ vɔrʊrǝ sa le etieyǝ? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Paape vǝ́ etieyǝ sa wǝrʊʊkpǝ yǝ lǝ pǝ rǝ nǝ mǝrǝ we, oturu nǝ nye yi mǝ yǝ nǝ nyo ko tuu epǝ we alɔnuŋtǝpǝ la wǝcakukpǝ pǝ lǝŋ kǝ pǝ kpii rǝ tǝrɛ pǝ tɛŋ yǝ pǝ koonu nǝ! <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Nǝ wɛ la nʊŋsɔɔ! Kǝto nimisietǝyǝ rɛ mǝŋ ceŋceŋ lee kpii rǝ nǝ mǝrǝ ŋ nóo koru atɛŋ wǝkpaŋkpǝ ŋ koonu nǝ ǝtǝŋ alɔnuŋtǝpǝ? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Kǝto wǝ kaamǝ kǝ lɔnuŋtǝyǝ rɛ mǝ na kɛrɩ lɔnuŋtǝyǝ pǝ ka tɛŋ wǝkpaŋkpǝ rǝ epǝ we pǝ laa lɔ Worokoyǝ pǝ nuŋ lǝ kpǝŋ? <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />Tuwǝ sa nǝ ya nǝ nyáa tɛŋ akpaŋyǝ mǝ awɛ we, wǝ la kaŋ ǝkǝnǝŋ nǝ nya marǝ atɔɔ. Kǝ́ kǝto wǝ́ nǝ nyǝŋ koru amaa pǝ sisi nǝ rǝ bomu? Kǝ́ kǝto wǝ́ nǝ nyǝŋ maa rɛ ŋ yɩɩ nǝ rǝ bomu? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Paa ŋnǝ nǝ ya nǝ nyée sisi, wǝ́ nǝ ya nǝ nyáa yɩɩ apʊŋpwapǝ wǝ. Nǝ ǝtǝŋpǝ wǝ́ nǝ ya nǝ nyée yee mǝ ǝnǝ! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Nǝ nyee ci wǝ ǝkǝnǝŋ epǝ we pǝ lée yee rɔɔrɔɔwǝ pǝ lǝŋ pa ka nya fɛɛtiiwǝ rǝ Worokoyǝ le wǝpilirikpǝ we mǝrǝ? Nǝ pǝǝ tǝǝnǝ nǝ wɛ oo! Onuŋruyeetǝpǝ, afɛɛsʊmatǝpǝ, epǝ we pǝ lée yee kǝtienaakǝ amaa pǝ láa yɩɩ vúurǝ, ǝpǝrǝŋpǝ we pǝ láa kpɛɛ mǝ awɛ amaa etiepǝ we pǝ láa kpɛɛ mǝ awɛ, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ayɩlayɩtǝpǝ, epǝ we pǝ láa mwɛɛrɩ otuyǝ le nimirǝ, ǝfǝŋpiemutǝpǝ, epǝ we pǝ láa tɛŋ enyipǝ, anaanaatǝpǝ pǝ lǝŋ pa ka nya fɛɛtiiwǝ rǝ Worokoyǝ le wǝpilirikpǝ we mǝrǝ. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Tuwǝ arɛɛpǝ rǝ nǝ mǝrǝ pǝ ke ri wǝǝ. Paape Worokoyǝ la lɛrɩ nǝ. Worokoyǝ la pɔrʊ nǝ lǝ tǝnǝ na wɛ. Rǝ na kǝnyɩŋkǝ we, nǝ nye yee enyikʊʊpǝ saŋ rǝ Kulǝtǝyǝ Yesu Kǝriso la nyɩŋrǝ mǝ loh Worokoyǝ la Wɛɛrǝ.<verse eid="1CO 6:11" /></para>
  <para style="s">Nǝ fǝ nǝ wɛlɛŋrǝ nǝ kǝ Worokoyǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Arɛɛpǝ rǝ nǝ mǝrǝ pǝ láa tɛŋ ǝkǝnǝŋ: «Gʊŋrǝ gbɛlɩ mǝ ŋ́ née yee tu ri ŋ tu» paape ŋkǝ tu ri ŋ tu wǝ lóo toŋ nyɩmaasɩyǝ. «Gʊŋrǝ gbɛlɩ mǝ ŋ́ née yee tu ri ŋ tu» paape ŋ́ nǝŋ koonu tǝrɛ la gʊŋrǝ wǝ ri mǝ yurǝ. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Nǝ nyáa lɛ nyǝ ŋ tɛŋ ǝkǝnǝŋ: «Ekeeriyǝ yǝ kpii yǝ koonu lɛrǝ, wǝ́ lɛrǝ gbii goonu ekeeriyǝ». Kǝceece, paape Worokoyǝ kpii lǝ́ǝ pǝ ŋ pǝ nǝǝnǝ tuwǝ sa wǝle yi. Paa Worokoyǝ lee yee wɛlɛŋrǝ ŋ koonu rǝ nuŋruwǝ. Wɛlɛŋrǝ gbii goonu Kulǝtǝyǝ la asʊmakǝ, wǝ́ Kulǝtǝyǝ ŋ náa yɩrɩ wɛlɛŋrǝ lo yurǝ wǝ. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Worokoyǝ ŋ na saanǝ Kulǝtǝyǝ ŋ no ru rǝ gbɛŋrǝ, wǝ́ kǝ́ ŋ nah pa saanǝ ŋla ŋkpɛ ŋ ru rǝ gbɛŋrǝ saŋ rǝ no okopiyǝ wǝǝ. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Nǝ nyee ci wǝ ǝkǝnǝŋ nǝ wɛlɛŋrǝ sa ɖi rǝ gbuŋturǝ goonu Kǝriso la wɛlɛŋrǝ? Kǝ ŋ́ fǝ Kǝriso lo okpuŋtuyǝ ŋ́ ke yee tuutuuyǝ lo okpuŋtuyǝ rǝ nɛ ǝnǝ? Kʊrakʊra, ŋ́ nǝŋ yee wǝ! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Nǝ nyee ci wǝ ǝkǝnǝŋ pǝrǝŋyǝ we ŋ na kpɛɛ mǝ tuutuuyǝ wǝǝ, ŋpǝ mǝ ŋwǝ pǝ la siɛrɩ pǝ le yee wɛlɛŋrǝ jeŋceŋ? Duturǝ ɖi Wǝŋʊrʊkenikenikpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Pǝle eyi pǝ láa siɛrɩ pǝ yee nyiyǝ ceŋceŋ». <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Paa nyiyǝ we ŋ na kpaa ŋ na maarǝ mǝ Kulǝtǝyǝ we, ŋpǝ mǝ ŋwǝ pǝ le yee nyiyǝ ceŋceŋ rǝ wɛɛrǝ mǝrǝ. <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />Nǝ suu rǝ nuŋruwǝ lǝ kpǝŋ. Oturɔɔrɔɔtuturuyǝ kpǝlo kɩɩkɩ nyiyǝ ŋ née yee we, yǝ lǝŋ mili na wɛlɛŋrǝ. Paa yǝ we ŋ née yee nuŋruwǝ we, ya lée yee turɔɔrɔɔwǝ mǝ ŋwǝŋwǝ na wɛlɛŋrǝ. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Nǝ nyee ci wǝ ǝkǝnǝŋ nǝ wɛlɛŋrǝ ɖi Wɛɛkenikenirǝ lo gukpǝ? Ŋrǝ Wɛɛrǝ sa gbii rǝ nǝ mǝrǝ wǝ, wǝ́ Worokoyǝ ŋ no koonu nǝ rǝ. Nǝ nyee kpii nǝ koonu nǝ wɛ, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />duturǝ ɖi Worokoyǝ lo fuu nǝ mǝ okurumumuŋyǝ rɛ, kǝto nǝ fǝ nǝ wɛlɛŋrǝ nǝ kǝ Worokoyǝ.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Ecikaŋkǝ ru rǝ dielɔrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Rǝkǝsa we, ŋ́ nǝ pǝ́ ŋ́ wɛɛlɩ ŋ́ ru rǝ dierǝ we nǝ ŋʊ̀rʊ nǝ kpii rǝ nǝ kǝfwɛɛkǝ we nǝ manǝ mǝ wǝ. Wǝ ponu kǝ pǝrǝŋyǝ ŋ paa lɔ tieyǝ. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Paape kǝ nǝ fǝ nǝ sǝŋ gʊŋrǝ nǝ koonu nuŋruwǝ le eyeekǝ we, wǝ lǝ pǝ́ kǝ pǝrǝŋ ri ŋ pǝrǝŋ ŋ lǝmǝ ne tieyǝ, kǝ tie ri ŋ tie ŋ lǝmǝ no nuŋyǝ. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Tuwǝ wǝ kpii kǝ nuŋyǝ ŋ yee ŋ ko rǝ ne tieyǝ lǝ kpǝŋ we, ŋ yee wǝ, wǝ́ tuwǝ wǝ kpii kǝ tieyǝ ŋ yee ŋ ko rǝ no nuŋyǝ lǝ kpǝŋ we, ŋ yee wǝ. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Tieyǝ lǝŋ koru ǝfǝ ŋwǝŋwǝ na wɛlɛŋrǝ ŋ yee tuwǝ ŋ nǝ pǝ́ wǝ, kpiikǝ na wɛlɛŋrǝ ɖi no nuŋ la nɛŋ. Kǝ́ pǝrǝŋyǝ ŋwǝ ŋkpɛ ŋ nǝŋ koru ǝfǝ ŋwǝŋwǝ na wɛlɛŋrǝ ŋ yee tuwǝ ŋ nǝ pǝ́ wǝǝ, kpiikǝ na wɛlɛŋrǝ ɖi ne tie la nɛŋ. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Nǝ pǝǝ sǝ́ŋ otoomukǝ mǝ awɛ, we tɛŋ nǝ nyo nuŋ awɛ lo duturǝ koonu eniyǝ rɛ, kǝ nǝ nya fɛɛ nǝ nya eniyǝ nǝ mwɛŋ nyuŋkpǝ. Rǝ wǝla kǝmaakǝ we, nǝ siɛnɩ nǝ tǝ nǝ pe tii tie mǝ no nuŋ. Mǝŋ ŋkǝ kaa wǝǝ, vǝ́ nǝ nyoo koru nǝ wɛ la ata re we, Satana láa nya gʊŋrǝ ŋ kpii nǝ gbǝǝrǝ. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Tuwǝ sa ŋ́ ya ŋ́ née tíi nǝ we, wǝ lee ri ŋ́ ya ŋ́ náa nyɩɩ mǝ nǝ nǝ yee ǝnǝ, paa tuwǝ ŋmǝ ŋ́ nǝ pǝ́ nǝ ke yee wǝǝ. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ŋ́ nǝ pǝ́ kǝ ǝpǝrǝŋpǝ kpǝlo kɩɩkɩ pǝ kǝ lǝ mǝŋ ŋmǝ kǝtǝ. Paape yǝ mǝ yǝ mǝ no tuwǝ Worokoyǝ ŋ no koonu ŋwǝ wǝ. Yǝ ǝnǝ la lɔ tukoonuwǝ lǝ wǝ ǝnǝ, yǝ eni la lɔ tukoonuwǝ lǝ wǝ eni. <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />Ŋ́ ya ŋ́ née tíi arianyapǝ mǝ ekpeetiepǝ ǝkǝnǝŋ wǝ ponu kǝ pǝ tii ǝnǝ mǝŋ ŋmǝ kǝtǝ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Paa mǝŋ pǝ lǝŋ koru ata pǝla wɛ pǝ re we, we pǝ lɔ tieyǝ amaa pǝ caa wǝnuŋkpǝ, wǝ ponu wǝ teeri kǝ́ pǝ lée tii pǝ ŋ lʊʊrʊ wɛɛwǝ wǝ. <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />Epǝ we pǝ la lɔ awɛ pǝ tini we, dierǝ ŋ́ neh tíi pǝ gaamǝ ɖǝ ǝnǝ: Tieyǝ ŋ pǝǝ sǝrǝ mǝ no nuŋyǝ. Dierǝ sa loo ru rǝ mǝ kpǝŋ, lo ru rǝ Kulǝtǝyǝ lǝ kpǝŋ. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Mǝŋ lǝ sǝrǝ mǝ ŋwǝ we, we ŋ pǝǝ tǝ ŋ siɛnɩ ŋ caa wǝnuŋkpǝ, amaa láa siɛnɩ pǝ ka ca awɛ pǝ kpii ŋpǝ mǝ no nuŋyǝ rǝ. Wǝ́ pǝrǝŋyǝ ŋwǝ ŋkpɛ we, ŋ pee piri ne tieyǝ.<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">Yɩrɩ <char style="xt"><ref loc="MRK 10:11-12">Mar 10:11-12</ref>, <ref loc="LUK 16:18">Luk 16:18</ref></char>. </char></note> <verse eid="1CO 7:11" /><verse number="12" style="v" sid="1CO 7:12" />Ko rǝ otuturupǝ lǝ kpǝŋ we, ŋmǝ ŋ́ ya ŋ́ náa tɛŋ, ŋkǝ Kulǝtǝyǝ, ǝkǝnǝŋ mǝŋ lɔnuŋtǝyǝ rɛ la lɔ tieyǝ ŋ naa lɔ Worokoyǝ ŋ nuŋ, paa wǝ́ tieyǝ sa ŋ na tɛɛnɩ ǝkǝnǝŋ ŋ née tii mǝ lɔnuŋtǝyǝ sa we, lɔnuŋtǝyǝ sa ŋ pee piri ŋwǝ. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Wǝ́ mǝŋ tieyǝ ŋ ri lɔnuŋtǝyǝ la caa pǝrǝŋyǝ rɛ ŋ naa lɔ Worokoyǝ ŋ nuŋ paa wǝ́ pǝrǝŋyǝ sa ŋ na tɛɛnɩ ǝkǝnǝŋ ŋ née tii mǝ tieyǝ sa we, tieyǝ sa ŋ pǝǝ sǝ́ŋ ŋwǝ. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Duturǝ ɖi pǝrǝŋyǝ sa ŋ naa lɔ Worokoyǝ ŋ nuŋ we, kǝlǝ mǝ Worokoyǝ mǝ kǝ́ ŋ ne yee nyiceŋceŋ mǝ ne tieyǝ sa kǝto. Kaa wǝǝ tieyǝ sa ŋ naa lɔ Worokoyǝ ŋ nuŋ we, kǝlǝ mǝ Worokoyǝ mǝ kǝ́ ŋ ne yee nyiceŋceŋ mǝ no nuŋyǝ sa ŋ ri lɔnuŋtǝyǝ kǝto. Mǝŋ wǝ lǝǝ kǝ lǝ ǝnǝ we, we o koh turu ne epipǝ pǝ lǝǝrǝ mǝ Worokoyǝ. Paa rǝ anʊkɔrǝyǝ we, pǝ kǝlǝ mǝ Worokoyǝ. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Paape mǝŋ yǝ we ŋ naa lɔ Worokoyǝ ŋ nuŋ lǝ́ǝ pǝ́ ŋ sǝrǝ mǝ ne tieyǝ sa amaa no nuŋyǝ sa ŋ ri lɔnuŋtǝyǝ we, pǝ maa ŋwǝ ŋ sǝrǝ mǝ ŋwǝ rǝ. Mǝŋ wǝ lǝ pǝ ǝnǝ we, paanʊyǝ sa amaa paatɛyǝ sa lǝǝ tǝ ŋ lǝmǝ gbaraarǝ rɛ. Duturǝ ɖi Worokoyǝ lo pwo nǝ nǝ pe tii vɔrʊrǝ rǝ wǝtaarǝkpǝ mǝrǝ. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Ŋlǝ́ tieyǝ e ri lɔnuŋtǝyǝ, ǝlǝ ŋ cii, ayɩrɛ saŋ rǝ ló oŋuŋkǝ ló nuŋyǝ láa nya alɔkuŋkǝ! Ŋlǝ́, pǝrǝŋyǝ e ri lɔnuŋtǝyǝ, ǝlǝ ŋ cii, ayɩrɛ saŋ rǝ ló oŋuŋkǝ lé tieyǝ láa nya alɔkuŋkǝ!<verse eid="1CO 7:16" /></para>
  <para style="s">Tii vɔrʊrǝ mǝŋ kǝ́ Worokoyǝ ŋ no pwo lǝ́ wǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Nyi ri ŋ nyi ŋ tii vɔrʊrǝ ŋ saŋ rǝ tuwǝ we Kulǝtǝyǝ ŋ no koonu ŋwǝ mǝ tuwǝ we ŋ ke ri eniyǝ we Worokoyǝ ŋ pwò ŋwǝ wǝ, we tɛŋ dierǝ sa ŋ́ na tɛŋ ŋ́ na pa tɛlɩ ceŋceŋ. Tuwǝ ŋ́ ya ŋ́ náa tɛŋ mǝ ŋ tíi alɔnuŋtǝpǝ kpǝlo kɩɩkɩ la wǝcakukpǝ rǝ fɛɛ ri ŋ fɛɛ wǝǝ. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Mǝŋ rɛ kǝ̀ǝlǝ kpɛŋ wǝ́ Worokoyǝ ŋ ci opwò ŋwǝ we, yǝ we ŋ pǝǝ nǝǝnǝ ǝkǝǝlǝkǝ sa la barǝ rǝ na wɛ. Mǝŋ rɛ lǝǝ kǝǝlǝ kpɛŋ kǝ Worokoyǝ ŋ ci opwo ŋwǝ we, wǝ lee kpii kǝ yǝ we ŋ kǝǝlǝ. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Ǝ lǝ kǝǝlǝ oo, ǝ lǝǝ kǝǝlǝ oo, wǝ lee ri tǝrɛ. Tuwǝ wǝ lǝ kpuŋkpuruŋ wǝ kaamǝ ǝkǝnǝŋ ŋlǝ́ e yee a saŋ rǝ Worokoyǝ lo otutɛŋyǝ. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Wǝ kaamǝ kǝ nyi ri ŋ nyi ŋ tii vɔrʊrǝ rǝ wǝlǝkpǝ we mǝrǝ ŋ ke kpii mǝ eniyǝ we Worokoyǝ ŋ pwò ŋwǝ wǝ. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Rɔŋyǝ wǝ́ e ke ri kǝ́ Worokoyǝ ŋ pwò lǝ́ wǝ? Wǝ pee yee lǝ́ tǝrɛ. Paa mǝŋ a la pa nya gʊŋrǝ kǝ e tii o koonu lá wɛ we, paa maa wǝ sǝ lǝ́ wǝ tɛlɩ. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Duturǝ ɖi rɔŋyǝ we Ǝtǝ Woroko ŋ no pwo we, ri Ǝtǝ Woroko le nyiyǝ ŋ ne tii ŋ no koonu na wɛ wǝ. Kaa wǝǝ nyiyǝ we ŋ tini ŋ koonu na wɛ ǝkǝ Ǝtǝ Woroko ŋ no pwo ŋwǝ we, ri rɔŋyǝ koonu Kǝriso. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Worokoyǝ la lɔ nǝ lo fuu mǝ okurumumuŋyǝ kǝto nǝ paa siɛrɩ nǝ yee anyɩmaasɩpǝ la arɔŋpǝ. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Lǝh ǝtǝŋ, wǝ kaamǝ kǝ nyi ri ŋ nyi ŋ tii vɔrʊrǝ rǝ Worokoyǝ la kǝnyɩŋkǝ rǝ wǝlǝkpǝ we mǝrǝ ŋ ke kpii mǝ eniyǝ we Worokoyǝ ŋ pwò ŋwǝ wǝ.<verse eid="1CO 7:24" /></para>
  <para style="s">Arianyapǝ, epǝ we pǝ laa caa wǝnuŋkpǝ mǝ ekpeetiepǝ le dierǝ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Ko rǝ epǝ we pǝ faa caa wǝnuŋkpǝ amaa pǝ faa lɔ tieyǝ we, ŋ́ naa lɔ tutɛŋwǝ rɛ ŋ́ ru rǝ Kulǝtǝyǝ lǝ kpǝŋ ŋ́ koonu pǝ. Paape ŋ́ náa tɛŋ mǝ yupurǝ, mǝŋ nyɩmaasɩyǝ wǝ kaamǝ kǝ pǝ tɛɛ kpɛɛwǝ lo yupurǝ kǝtǝ, kpiikǝ Kulǝtǝyǝ la lɛsiɛrɩwǝ wǝ tɛɛ rǝ mǝ. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Rǝkǝsa la akparaayǝ sa kǝto we, mǝ yupurǝ gaamǝ ɖǝ ǝnǝ: Wǝ ponu kǝ nyi ri ŋ nyi ŋ tii mǝŋ kǝ́ ŋ lǝ wǝ. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Ǝ lǝǝmǝ tieyǝ? Pǝǝ pǝ́ ŋlǝ́ ǝ lǝ́ǝ sǝ́ŋ ŋwǝ. Ǝ lǝǝ lǝmǝ tieyǝ? Paa taa tieyǝ. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Paape mǝŋ a láa lɔ tieyǝ we, e lee yee turɔɔrɔɔwǝ. Wǝ́ mǝŋ gɔsɔkɔrʊpirǝ la caa wǝnuŋkpǝ we, lee yee turɔɔrɔɔwǝ. Paape epǝ we pǝ la lɔ tieyǝ amaa pǝ la caa wǝnuŋkpǝ we, vɔrʊrǝ sa la akparaayǝ yǝ lóo tuu pǝ, wǝ́ ŋmǝ we, ŋ́ nǝ pǝ́ ŋ́ ca yǝ ŋ́ cɛ nǝ rǝ. <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />Lǝh ǝtǝŋ, tuwǝ ŋ́ ya ŋ́ náa tɛŋ wǝ kaamǝ wǝ ǝnǝ: Eniyǝ yǝ lo tuuru yǝ lǝǝ tǝ yǝ naanǝ. Fǝ rǝkǝsa mǝ ko we, epǝ we pǝ lǝǝmǝ etiepǝ we, pǝ tii vɔrʊrǝ mǝŋ pǝ lǝǝ lǝmǝ etiepǝ kǝtǝ. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Epǝ we pǝ ya pǝ lée wee we, pǝ tii vɔrʊrǝ mǝŋ pǝ laa ya pǝ lée wee. Epǝ we pǝ ya pǝ láa nya faawǝ, pǝ tii mǝŋ pǝ laa ya pǝ láa nya faawǝ. Epǝ we pǝ ya pǝ lóo fuu otuyǝ pǝ tii mǝŋ pǝ lǝǝ lǝmǝ tǝrɛ. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Epǝ we pǝ ya pǝ láa nya vasʊyǝ rǝ ǝrǝkǝ sa we, pǝ tii vɔrʊrǝ mǝŋ pǝ laa ya pǝ láa nya vasʊyǝ pǝ ŋ ru rǝ kǝ. Duturǝ ɖi ǝrǝkǝ sa lǝ kǝ́ kǝ lǝ kǝ fǝ we, kǝ lǝŋ tǝ kǝ pa panǝ. <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />Ŋ́ nǝ pǝ́ nǝ pǝǝ tǝ nǝ kǝǝnǝ. Yǝ we ŋ naa lɔ tieyǝ we, láa yɩrɩ rǝ Kulǝtǝyǝ lo otuyǝ lǝ kpǝŋ. Lǝ́ǝ pǝ́ wǝ kpuŋkpuruŋ kǝ no tuwǝ wǝ poŋ mǝ Kulǝtǝyǝ. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Paa yǝ we ŋ na lɔ tieyǝ we, láa yɩrɩ rǝ ǝrǝkǝ lo otuyǝ lǝ kpǝŋ, láa taa kǝ́ ŋ née yee kǝ no tuwǝ wǝ poŋ mǝ ne tie. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Mǝŋkǝsa we o turu pǝrǝŋyǝ sa lo oyupuyǝ yǝ lǝ sǝpǝ kpeewǝ yi. Kaa wǝ lǝ wǝǝ, tieyǝ we ŋ faa caa wǝnuŋkpǝ mǝ akɔrʊpǝ we, pǝ láa nya akaa rǝ Kulǝtǝyǝ lo otuyǝ, wǝ́ pǝ lǝ́ǝ pǝ́ pǝ fǝ pǝla wɛ fee pǝ koonu Kulǝtǝyǝ. Paa tieyǝ we ŋ na caa wǝnuŋkpǝ we, láa nya akaa rǝ ǝrǝkǝ lo otuyǝ kǝ no tuwǝ wǝ nya fɛɛ wǝ poŋ mǝ no nuŋ. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Ŋ́ ya ŋ́ náa tɛŋ tuwǝ sa ǝnǝ kǝ wǝ nya fɛɛ wǝ toŋ nǝ rǝ oo, ŋkǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ kpara nǝ rǝ. Paa we, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ yee rǝ tuwǝ we wǝ ponu wǝ teeri wǝ, kǝ nǝ nya fɛɛ nǝ sʊma Kulǝtǝyǝ fee, rɛ ŋ paa yɩrɩ rǝ fɛɛwǝ rɛ.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Paape mǝŋ pǝrǝŋyǝ rɛ la tɔɔ tieyǝ, wǝ́ ŋ na nyɩŋ wǝ ǝkǝnǝŋ ŋ nǝŋ po koru ata na wɛ mǝ eniyǝ we mǝrǝ, wǝ́ ŋ nǝ pǝ́ pǝ lɔ awɛ we, pǝ lɔ awɛ mǝŋ kǝ́ ŋ nǝ pǝ́ faa. Ŋkǝ turɔɔrɔɔwǝ wǝ́ pǝrǝŋyǝ we ŋ ne yee. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Paa mǝŋ pǝrǝŋyǝ we ŋwǝŋwǝ ŋ nǝ fǝ ŋ na tɛɛ rǝ na wɛ ǝkǝnǝŋ ŋwǝ ŋ nǝŋ tǝ ŋ lɔ ne tietɔɔyǝ we, wǝ́ ŋ na tɔ ŋ na yaa rǝ ne dierǝ sa, wǝ́ wǝ lee ri rɛ ŋ no tu ŋwǝ we, mǝŋ lóo koru na wɛ la ata re we, le yee wǝ ponu. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Kǝto yǝ we ŋ na lɔ ne tietɔɔyǝ we, le yee wǝ ponu, paa yǝ we ŋ nǝ sǝ́ŋ ŋ nǝŋ tǝ ŋ lɔ ne tietɔɔyǝ we, na nɛŋwǝ wǝ tǝ wǝ ponu wǝ teeri.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Tieyǝ we ŋ na caa wǝnuŋkpǝ, wǝ́ no nuŋ ŋ kpii vɔrʊrǝ we, gʊŋrǝ laa kpɛɛ ŋwǝ kǝ ŋ sǝ́ŋ ŋwǝ kǝ ŋ ka caa pǝrǝŋpʊŋpwayǝ. Paa mǝŋ no nuŋ lǝ kpǝ́ we, gʊŋrǝ gbɛlɩ ŋ nah ka caa pǝrǝŋyǝ we ŋ ponu mǝ ŋwǝ wǝ, paa kǝ wǝ ri rǝ kǝrisotǝnyiyǝ. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Paa ŋ́ na nyɩŋ wǝ ǝkǝnǝŋ mǝŋ tieyǝ sa le tii mǝŋkɔɔwe laa siɛnɩ ŋ caa wǝnuŋkpǝ we, láa nya na wɛ ŋ teeri. Mǝ yupurǝ wǝǝ. Ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ Worokoyǝ la Wɛɛrǝ gbii rǝ mǝ.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Kɛɛyǝ we pǝ la wʊ pǝ lo toolu afɛɛyǝ la gakǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Rǝkǝsa we, ŋ́ nǝ pǝ́ ŋ́ wɛɛlɩ ŋ́ ru rǝ kɛɛyǝ we pǝ la wʊ pǝ lo toolu afɛɛyǝ la gakǝ wǝ. Le cii wǝ sɩsiɛrɩ ǝkǝnǝŋ loh kpǝlo lǝ lǝǝmǝ otuciyǝ. Paa otuciyǝ yǝ lóo koonu wɛɛrɛɛrɩmǝwǝ, wǝ́ kǝǝtaawǝ paa wǝ lóo toolu enyipǝ lǝ mǝrǝ. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Yǝ we ŋ ya ŋ náa nyɩŋ na wɛ ǝkǝnǝŋ ŋwǝ ŋ cii otuyǝ we, ŋ ci wǝ ǝkǝnǝŋ ŋwǝ ŋ fee ci mǝŋ kǝ́ wǝ kaamǝ kǝ nyiyǝ ŋ ci otuyǝ wǝ. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Paa yǝ we ŋ náa taa Worokoyǝ lǝ kǝǝwǝ we, Worokoyǝ cii ŋwǝ.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Rǝkǝsa we, diepǝ́rǝ gaamǝ ǝkǝnǝŋ, yǝ lóo koru owo kɛɛyǝ we pǝ la wʊ pǝ lo toolu afɛɛyǝ la gakǝ? Le cii wǝ ǝkǝnǝŋ wǝfɛɛkpǝ wǝ lee ri tǝrɛ rǝ ǝrǝkǝ sa, wǝ́ la lɛ le cii wǝ ǝkǝnǝŋ worokopʊŋpwayǝ rɛ lǝǝ tǝ ŋ kpii ŋ kʊla mǝ Worokoceŋceŋyǝ sa. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Mǝŋ kǝceece wǝ ri ǝkǝnǝŋ oworokopǝ rɛ pǝ kpii rǝ yulaarǝ amaa rǝ kǝtǝǝwǝ, wǝ́ kǝceece oworokopǝ mǝ okulǝtǝpǝ pǝ kpii pǝ naanǝ we, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ŋlǝ paa rǝ lǝh kpǝŋ we, Worokoyǝ ceŋceŋ ko ŋ kpii. Ŋwǝ ŋ ri Tǝyǝ we ŋ no co tu ri ŋ tu wǝ. Ŋwǝ wǝ́ le kpii vɔrʊrǝ lo koonu. Wǝ́ Kulǝtǝyǝ ceŋceŋ ŋ lɛ ŋ kpii, ŋwǝ ŋ ri Yesu Kǝriso. Ŋwǝ Yesu Kǝriso lo oŋuŋkǝ wǝ́ Worokoyǝ ŋ na saŋ ŋ ne yee tu ri ŋ tu wǝ kpii wǝ, ŋwǝ kǝto wǝ́ le kpii vɔrʊrǝ wǝ.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Paape ŋkǝ enyikpǝlo pǝ cii tuwǝ sa. Arɛɛpǝ we, vɛɛsʊmarǝ la kaa pǝle nimirǝ. Po roo ruŋruŋ vǝ́ pǝ lo wo kɛɛyǝ we pǝ la wʊ pǝ lo toolu wǝfɛɛkpǝ la gakǝ we, pǝ ŋ pu wǝ ǝkǝnǝŋ kǝceece wǝfɛɛkpǝ la gakǝ kǝ lǝǝwe, duturǝ ɖi pǝla ziɔŋrǝ laa lɛnyɩ kǝto a pǝ ŋ mǝ tɛŋ ǝkǝnǝŋ pǝ la cɩɩrɩ pǝla wɛ. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Paa ŋkǝ keeriwǝ wǝ lóo ruu lǝ wǝ kǝlǝ mǝ Worokoyǝ kaŋfɩ. Mǝŋ yǝ loo wo gakǝ sa we, wǝ lǝŋ pɔrʊ tǝrɛ wǝ sǝǝlǝ rǝ lǝ, wǝ́ mǝŋ yǝ lo wo kǝ we, yǝ lǝŋ lɛ la nya tǝrɛ la kʊla. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />Nǝ nyóo koru eyee tuwǝ we wǝ ponu mǝ nǝ wǝ. Paape nǝ yee yurǝ kǝ tuwǝ nǝ nyée yee wǝ pee kpii yǝ we ŋ naa lɛnyɩ rǝ lɔnuŋrǝ la gbaraarǝ. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Kǝ lǝ fǝ wǝ ǝkǝnǝŋ yǝ we ŋ naa lɛnyɩ ziɔŋrǝ la pa nyɩŋ ŋlǝ́ yǝ we e cii otuyǝ e tini e lée ri keeriwǝ pǝ lo co wǝfɛɛkpǝ rǝ wǝfɛɛkukpǝ wǝǝ, ŋkǝ eniyǝ we e le kpii na ziɔŋrǝ lo okopiyǝ ŋwǝ ŋkpɛ mǝ ŋ wo kɛɛyǝ we pǝ la wʊ pǝ lo toolu la gakǝ rǝ? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Mǝŋkǝsa we, ŋlǝ́ yǝ we a ya láa tɛŋ ǝkǝnǝŋ ŋlǝ́ e cii otuyǝ we, o lo koonu nyiyǝ sa ŋ naa lɛnyɩ ziɔŋrǝ ŋ lǝǝ rǝ. Kaŋfɩ Kǝriso lǝ kpǝ́ la tɛɛ rǝ ŋwǝ paanʊyǝ sa ŋwǝ ŋkpɛ rǝ. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Mǝŋ nǝ nye yee turɔɔrɔɔwǝ nǝ nya tɛɛ rǝ nǝ ǝtǝŋpǝ mǝŋkǝsa, wǝ́ nǝ nye kpii pǝla ziɔŋrǝ we laa lɛnyɩ la kǝrɛŋkǝ we, o lóo turu nǝ nye yee turɔɔrɔɔwǝ rǝ Kǝriso lǝ kpǝŋ. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Kǝto mǝŋ ŋ́ née ri keeriwǝ rɛ, kǝ wǝ po tu mǝ kɛrɩyǝ wǝ kpii rǝ turɔɔrɔɔwǝ we, we ŋ́ náa wɛɛ mǝ gawokǝ kǝkpakǝkpa, kǝ ŋ́ poo po tu ŋwǝ ŋ́ kpii rǝ turɔɔrɔɔwǝ mǝrǝ.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Pɔlʊ ya láa wɛɛlɩ mǝŋ ru rǝ na kǝnǝnɛkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Mǝŋkǝ́ gʊŋrǝ gbɛlɩ ŋ́ née yee tu ri ŋ tu? Mǝŋkǝ́ nyikpiiyǝ wǝ́ ŋ́ ri? Kǝto mǝŋkǝ́ ŋ́ na nyɩŋ loh Kulǝtǝyǝ Yesu? Mǝŋkǝ́ ŋnǝ nǝ ri mǝ anǝnɛyǝ we ŋ́ ne yee ŋ́ no koonu Kulǝtǝyǝ lǝ ǝtǝnǝyǝ? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Mǝŋ enyirɛɛpǝ pǝ láa tɛŋ ǝkǝnǝŋ ŋmǝ ŋ́ nee ri nyikpiiyǝ we, ŋnǝ paa ǝkǝŋtǝ we, nǝ cii wǝ ǝkǝnǝŋ ŋmǝ ŋ́ ri nyikpiiyǝ. Duturǝ ɖi ŋnǝ nǝ ri ǝtǝnǝyǝ we yǝ la pɔrʊ yǝ la kaŋ ǝkǝnǝŋ ŋmǝ ŋ́ ne yee nyikpiiyǝ la kǝnǝnɛkǝ ŋ́ no koonu Kulǝtǝyǝ. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />Epǝ we pǝ ya pǝ láa tɛŋ etieyǝ pǝ ŋ tɛɛ rǝ mǝ we, pǝ nuŋ ǝkǝnǝŋ: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />We gʊŋrǝ laa kpɛɛ kǝ pǝ koonu lǝ keeriwǝ mǝ mɛŋwǝ rǝ kǝnǝnɛkǝ la ya yǝ lée yee wǝ? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Amaa ŋlǝ yǝ laa laka la lɔ ekǝrisotǝtiepǝ kǝ le re pǝ pǝ siimǝ lǝ pǝ ŋ tɛlɩ mǝŋ kǝ́ enyikpiituturupǝ we amaa mǝŋ kǝ́ Kulǝtǝyǝ la apaanʊpǝ mǝ Pɛtǝro pǝ lée yee wǝ kǝtǝ wǝ? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Nǝ nyoh mǝ pu wǝ ǝkǝnǝŋ ŋlǝ mǝ Banaba ko la kaamǝ kǝ le yee anǝnɛyǝ kǝ le ci anya tuwǝ yǝ lée ri wǝ? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Tuusiitǝyǝ rǝ fǝŋ ŋwǝŋwǝ ŋ náa mwara na wɛ rǝ na kǝnǝnɛkǝ mǝrǝ wǝ? Ǝlǝ ŋ náa tɔ wǝciikpǝ rǝ atɛɛkǝ wǝ́ ŋ nǝŋ ri wǝlǝ ǝtǝnǝyǝ wǝ? Amaa kɛɛrǝŋtǝyǝ rǝ fǝŋ ŋ nǝŋ ŋuŋ akɛɛpǝ we ŋ ya ŋ nǝ́ǝ rǝŋ la akɔɔrʊnyɩŋpǝ wǝ?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Otutuyǝ sa ŋ́ na ca we, ŋkǝ anyɩmaasɩpǝ ko pǝ láa ca yǝ. Duturǝ ɖi Mose le seyǝ la tɛŋ ŋyǝ otuyǝ sa mǝŋkǝsa. <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Pǝ la ŋʊrʊ rǝ Mose le seyǝ ǝkǝnǝŋ: «Paa parǝ nɛŋnuŋrǝ we ya lée yee anǝnɛyǝ lo nyuŋkpǝ mǝ eniŋceamɔɔrʊyǝ». Nǝ nyo pu wǝ ǝkǝnǝŋ Worokoyǝ ya lǝ́ǝ kǝǝnǝ anɛŋpǝ rǝ? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Ŋlǝ kǝto wǝ́ ŋ na tɛŋ wǝ ǝnǝ. Ŋlǝ kǝto wǝ́ pǝ ŋʊ̀rʊ seyǝ sa kǝceece. Duturǝ ɖi wǝ kaamǝ kǝ yǝ we ŋ na caŋ mǝ yǝ we ŋ no culu ekeeripiyǝ pǝ lǝmǝ kpɛɛtɛɛwǝ ǝkǝnǝŋ ŋpǝ pǝ láa nya pǝla nɛŋwǝ. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Ŋlǝ we, yǝ la rʊʊ Worokoyǝ la Wɛɛrǝ lo otuyǝ rǝ nǝ ziɔŋrǝ, wǝ́ mǝŋ yǝ la lɔ otulǝmǝyǝ rǝ nǝ kpǝŋ wǝǝ, we yǝ le sisi nǝ rǝ? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Mǝŋ enyipʊŋpwapǝ pǝ ya pǝ láa lɔ ŋyǝ otuyǝ sa rǝ nǝ wǝǝ, kǝ ŋlǝ la wɛ la paa lɔ yǝ rǝ nǝ le teeri?</para>
  <para style="p" vid="1CO 9:12">Paa ŋlǝ we yǝ lee yee wǝ ǝnǝ, yǝ lǝ́ǝ fǝ tu ri ŋ tu ǝnǝ, kǝ la paa nya fɛɛ la kpara Kǝriso le Dieceeceerǝ we.<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />Nǝ nyee ci wǝ ǝkǝnǝŋ epǝ we pǝ lée yee anǝnɛyǝ rǝ Worokoyǝ la nyarǝwǝ wǝǝ, pǝ láa nya pǝla nɛŋ keeriwǝ rǝ Worokoyǝ la nyarǝwǝ? Wǝ́ nǝ nyee ci wǝ ǝkǝnǝŋ epǝ we pǝ lée yee otoolukǝ rǝ otoolucuukǝ wǝǝ, pǝ láa nya pǝla kǝnɛŋ kǝkakǝ rǝ otoolucuukǝ we? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Kaa wǝǝ Kulǝtǝyǝ ŋ na tɛŋ ŋ nǝ tǝnǝ ǝkǝnǝŋ epǝ we pǝ ya pǝ láa tɛŋ Dieceeceerǝ we we, pǝ ŋ nya pǝle keeriwǝ pǝ ŋ ru rǝ Dieceeceerǝ we la atɛŋkǝ. <verse eid="1CO 9:14" /><verse number="15" style="v" sid="1CO 9:15" />Ŋmǝ paa we, ŋ́ nee pe tíi nǝ nǝ koonu mǝ ŋyǝ otuyǝ sa la rɛ. Wǝ́ mǝŋ ŋ́ na ŋʊrʊ wǝ ŋ́ ne kpii rǝ kǝfwɛɛkǝ sa we, ŋkǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ nǝ yee wǝ nǝ koonu mǝ rǝ. Mǝŋ ŋ́ nǝ kpǝ́ we, wǝ ponu wǝ teeri kǝ́ rɛ ŋ nah lɔ mǝ tuwǝ ŋ́ nǝ́ǝ fǝ ŋ́ ca arekpeyǝ wǝ. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Paa Dieceeceerǝ la atɛŋkǝ kǝ lee ri tuwǝ ŋ́ nǝ́ǝ fǝ ŋ́ ca arekpeyǝ, duturǝ ɖi pǝ la tɛɛ mǝ eleeyǝ sa ŋmǝ ŋ́ tɛŋ rǝ rǝ. Wǝ́ mǝŋ ŋ́ naa tɛŋ Dieceeceerǝ sa we, mǝ paapɔ mǝ mǝ aria. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />O koh nuŋ ŋmǝŋmǝ ŋ na saa kǝnǝnɛkǝ sa ŋ na pɔrʊ we, ŋ́ kah mǝ lɔ wǝtoomwarakpǝ. Paape kpiikǝ pǝ le kpii mǝ kǝ rǝ we, ŋ́ nǝ́ǝ fǝ ŋ́ tɛɛ rǝ mǝ wɛ kǝ mǝ ŋ yee kǝ rǝ ko. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Mǝ wǝtoomwarakpǝ wǝ kaamǝ gbǝ rǝ fǝŋ? Ŋkpǝ wǝ kaamǝ ǝkǝnǝŋ ŋmǝ ŋ́ tɛŋ Dieceeceerǝ we ŋ́ cɛɛ, kǝ ŋ́ paa lɔ wǝtoomwarakpǝ we wǝ kaamǝ wǝ koonu nyiyǝ we ŋ náa tɛŋ Dieceeceerǝ we wǝ.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Rɛ lee kpii ŋ née si mǝ ŋ́ yee tǝrɛ, paape ŋ́ nǝ fǝ mǝ wɛ ŋ́ ne yee rɔŋyǝ ŋ́ no koonu nyi ri ŋ nyi, kǝ ŋ́ nya fɛɛ ŋ́ koonu kǝ enyipǝ ŋpa pǝ lɔ Kǝriso pǝ nuŋ. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Vǝ́ ŋ́ no ko Oyudatǝpǝ lǝ kpǝŋ we, ŋ́ née re mǝ wɛ mǝŋ Oyudatǝpǝ wǝ́ ŋ́ ri, kǝ ŋ́ nya fɛɛ ŋ́ koonu kǝ pǝ lɔ Kǝriso pǝ nuŋ. Vǝ́ ŋ́ no ko epǝ we pǝ kpii rǝ Mose le seyǝ we kǝnǝŋkǝ lǝ kpǝŋ we, ŋ́ née re mǝ wɛ mǝŋ ŋpǝ kǝtǝ, paa ŋ́ nee kpii rǝ seyǝ sa kǝnǝŋkǝ, kǝ ŋ́ nya fɛɛ ŋ koonu kǝ pǝ lɔ Kǝriso pǝ nuŋ. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Vǝ́ ŋ́ no ko epǝ we pǝ lee ci Mose le seyǝ lǝ kpǝŋ we, ŋ́ née re mǝ wɛ mǝŋ yǝ we ŋ nee ci Mose le seyǝ sa kǝtǝ, kǝ ŋ́ nya fɛɛ ŋ́ koonu kǝ pǝ lɔ Kǝriso pǝ nuŋ. Paa kaŋfɩ ŋ́ née yee mǝ ŋ saŋ rǝ Worokoyǝ le seyǝ, duturǝ ɖi ŋ́ née yee mǝ ŋ saŋ rǝ Kǝriso le seyǝ. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kaa wǝǝ vǝ́ ŋ́ no ko ekǝrisotǝpǝ we pǝ laa lɛnyɩ rǝ lɔnuŋrǝ lǝ kpǝŋ we, ŋ́ née re mǝ wɛ mǝŋ yǝ we ŋ naa lɛnyɩ rǝ lɔnuŋrǝ kǝtǝ, kǝ ŋ́ nya fɛɛ ŋ́ koonu kǝ pǝ tɔ pǝ yaa rǝ Kǝriso mǝrǝ. Ŋ́ náa nyɩɩ mǝ ŋ yee ŋyǝ otuyǝ sa kpǝlo kɩɩkɩ ǝnǝ, kǝ ŋ́ nya fɛɛ ŋ́ koonu kǝ pǝla arɛɛpǝ pǝ lɔ Kǝriso pǝ nuŋ. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Dieceeceerǝ sa kǝto wǝ́ ŋ́ née yee ŋyǝ otuyǝ sa kpǝlo ǝnǝ, kǝ ŋ́ nya fɛɛ ŋ́ pa lɔ wǝpɛɛrɩkpǝ we wǝ kpii rǝ rǝlǝ mǝrǝ.<verse eid="1CO 9:23" /></para>
  <para style="s">Ekǝrisotǝpǝ la anyɩɩkǝ</para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Nǝ cii wǝ ǝkǝnǝŋ, vǝ́ pǝ leh yee etieyɩrɩkǝ pǝ koonu osuutǝpǝ we, osuutǝpǝ we kpǝlo pǝ lóo suu. Paa ceŋceŋ ko ŋ nóo ko mǝ ŋ lɔ wǝtoomwarakpǝ we wǝ. Kǝto nǝ nyɩɩ nǝ suu mǝŋkǝsa kǝ nǝ ka lɔ wǝtoomwarakpǝ we. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Kpɛŋ kǝ osuutǝpǝ pǝ po ko etieyɩrɩkǝ sa we, pǝ láa kpaka pǝ ŋ pieeli pǝla wɛ ŋpa. Pǝ lée yee wǝ ǝnǝ kǝ pǝ nya fɛɛ pǝ lɔ yurituwǝ we wǝ lǝ́ǝ pǝlǝ wǝ. Ŋlǝ paa we, yǝ lée yee wǝ kǝ la nya fɛɛ la lɔ yurituwǝ we wǝ lǝŋ pǝlǝ kʊrakʊra wǝ. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Tuwǝ kǝto ŋmǝ paa ŋ́ naa ya ŋ́ nóo suu akpaakpaa. Wǝ tǝ wǝ lǝ mǝŋ kǝ́ kpaŋkʊcatǝyǝ ŋ nǝŋ furu ŋ fɔ kǝtǝ. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Kǝto ŋ́ ya ŋ́ née pieeli mǝ wɛ ŋpa, kǝ ŋ́ nya fɛɛ ŋ́ ri mǝ wɛ lo yurǝ sɩsiɛrɩ, kǝ wǝ pee pe yee ǝkǝnǝŋ ŋmǝ ŋ́ na tɛŋ Dieceeceerǝ we ŋ́ ne tíi enyipǝ ŋ́ na lɛ, kǝ Worokoyǝ ŋ pǝ sǝ́ŋ mǝ ŋ co.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Otukaŋyǝ ru rǝ etiŋyǝ la asʊmakǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Lǝh ǝtǝŋ, ŋ́ nǝ pǝ́ nǝ ci tuwǝ we wǝ pǝlǝ wǝ tuu lǝh ǝtǝtǝpǝ rǝ Mose le eniyǝ we wǝ. Kǝ́ pǝ lo ru rǝ Ejipǝte pǝ la pwɛyɩ we, Worokoyǝ fǝ̀ ŋɔɔrǝ rè pǝ, wǝ́ pǝlo kpǝlo pǝ pǝlǝ pǝ tà apʊmwɛɛrɩyǝ. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Wǝ́ Worokoyǝ ŋ wìiri pǝlo kpǝlo lo worokomɛŋwǝ rǝ ŋɔɔrǝ we mǝ apʊyǝ we lǝ mǝrǝ kǝ pǝ nya fɛɛ pǝ siimǝ Mose. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Pǝlo kpǝlo pǝ rili wɛɛrǝ le keeriwǝ we ceŋceŋ Worokoyǝ ŋ kòonu pǝ wǝ. <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />Wǝ́ pǝ lɛ̀ pǝ ŋunu wɛɛrǝ la mɛŋwǝ ceŋceŋ. Duturǝ ɖi wɛɛrǝ lo ɖutɛɛrǝ rɛ ge siimǝ pǝ, wǝ́ ge ŋ wee mɛŋwǝ lǝ ŋ koonu pǝ pǝ ŋ ŋuŋ. Ɖutɛɛrǝ sa ge ri Kǝriso. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Paa we, enyipǝ wa rǝ pǝlǝ mǝrǝ lo tuwǝ wǝ loo ko poŋ mǝ Worokoyǝ. Tuwǝ kǝto pǝ kpǝ̀ǝlǝ rǝ nyɔŋkpaakǝtǝǝwǝ wǝǝ.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Otuyǝ sa yǝ pǝlǝ mǝŋkǝsa kǝ la nya fɛɛ la karǝ otuyǝ lo ru rǝ yǝ, kǝ otucakpɛɛrɔɔrɔɔyǝ yǝ paa nya fɛɛ yǝ ca lǝ kpɛɛ eyeekǝ mǝŋ ŋpǝ kǝtǝ. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Nǝ paa sʊma etiŋyǝ mǝŋ kǝ́ arɛɛpǝ rǝ lǝh ǝtǝtǝpǝ lǝ mǝrǝ pǝ ka ŋ sʊma yǝ kǝtǝ. Pǝ la ŋʊrʊ wǝ rǝ Worokoŋtierǝ mǝrǝ ǝkǝnǝŋ: «Kǝnyikpǝŋkǝ kǝ la ka sɔ kǝ le tii kǝ ya kǝ lée ri wǝ́ kǝ ya kǝ lóo ŋuŋ, wǝ́ kǝ le pe yi kǝ ya kǝ láa wʊrʊ.» <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Lah rɛ ŋ pee re nuŋruwǝ la vɔrʊrǝ mǝŋ kǝ́ arɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ ke ŋ re rǝ kǝtǝ, wǝ́ enyipǝ lafawǝ tiyi mǝ ta pǝ kpǝ̀ǝlǝ jirǝ jeŋceŋ wǝ. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Lah rɛ ŋ pee tie Kǝriso ŋ yɩrɩ mǝŋ kǝ́ arɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ yeli wǝ kǝtǝ, wǝ́ wǝpɔɔkpǝ wǝ ròonu pǝ wǝ wʊ̀ʊlʊ wǝ. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Rǝ kǝlɛɛkǝ we, nǝ paa mǝ kpaŋ ŋʊnʊŋʊnʊ nǝ mǝ ru rǝ Worokoyǝ, mǝŋ kǝ́ arɛɛpǝ rǝ pǝlǝ mǝrǝ pǝ yeli wǝ kǝtǝ, wǝ́ gbɛŋrǝ le picoŋpiyǝ ŋ pǝlǝ ŋ wʊ̀ʊlʊ pǝ wǝ.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Otuyǝ sa kpǝlo yǝ pǝlǝ yǝ tùu lǝh ǝtǝtǝpǝ kǝ la nya fɛɛ la karǝ otuyǝ lo ru rǝ yǝ. Pǝ la ŋʊrʊ ŋyǝ otuyǝ sa kǝ pǝ fǝ pǝ ci pǝ kaŋ lǝ rǝ. Duturǝ ɖi yǝ lǝ kǝlǝ mǝ ǝrǝkǝ la alɛɛkǝ. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Kǝto yǝ we ŋ ya ŋ náa nyɩŋ ǝkǝnǝŋ ŋ na tɔ ŋ yaa kiŋkiŋ we, ŋ yee yurǝ kǝ ŋ poo po ru ŋ tɔɔ. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Nǝ ci wǝ ǝkǝnǝŋ otuyǝ we yǝ lóo tu nǝ yǝ ŋ kpii rǝ oturɔɔrɔɔyǝ lǝ mǝrǝ we, ŋyǝ ke yǝ lóo tu enyipǝ kpǝlo yǝ ŋ kpii rǝ oturɔɔrɔɔyǝ mǝrǝ wǝ. Paape nʊkɔrǝlǝtǝyǝ wǝ́ Worokoyǝ ŋ ri wǝ́ lǝŋ pa maa tǝrɛ wǝ pǝ wǝ tuu nǝ kǝ oturu wǝ teeri nǝ. Mǝŋ tǝrɛ wǝ ya wǝ lóo tu nǝ kǝ nǝ yee turɔɔrɔɔwǝ we, Worokoyǝ lóo koonu nǝ okopiyǝ kǝ nǝ nya fɛɛ nǝ tɔ nǝ yaa kǝ nǝ lɛ nǝ ru rǝ wǝlǝ mǝrǝ.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Kǝto we, lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, nǝ ruu nǝ ru rǝ vɛɛsʊmarǝ lǝ kpǝŋ. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ŋ́ ya ŋ́ náa wɛɛlɩ mǝ nǝ mǝŋ enyipǝ pǝ cii otuyǝ kǝtǝ. Ŋnǝŋnǝ nǝ pu yurǝ nǝ ru rǝ etieyǝ sa ŋ́ ya ŋ́ née tíi nǝ nǝ yɩrɩ. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Mǝŋ la ya yǝ lée ri keerikenikeniwǝ wǝǝ, mǝŋkǝ vɛŋyǝ we yǝ lóo ŋuŋ láa pɔrʊ mǝ ŋ kaŋ ǝkǝnǝŋ ŋlǝ yǝ le yee nyiceŋceŋ mǝ Kǝriso saŋ rǝ na ŋpǝrayǝ rǝ? Wǝ́ mǝŋkǝ kpɔnɔyǝ we yǝ lóo po yǝ ŋ sǝpǝ awɛ ya lǝ́ǝ fǝ lǝ mǝ ŋ yee nyiceŋceŋ mǝ Kǝriso la wɛlɛŋrǝ rǝ? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Kpɔnɔyǝ ceŋceŋ ŋ kpɛlɩ. Mǝŋkǝ́ la naanǝ paape we, kpɔnɔyǝ we ceŋceŋ wǝ́ yǝ lóo po yǝ ŋ sǝpǝ awɛ. Kǝto loh kpǝlo yǝ la siɛrɩ yǝ le yee wɛlɛŋrǝ jeŋceŋ. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />Nǝ taalǝ Isǝrayɛlǝtǝpǝ! Pǝ ka ŋ wʊ kɛɛyǝ pǝ ŋ toolu pǝ ŋ koonu Worokoyǝ rǝ otoolucuukǝ. Epǝ we pǝ ko ŋ wo gakǝ we we, pǝ le yee nyiceŋceŋ mǝ otoolucuukǝ we. <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Wǝlo duturǝ ɖi nɛ? O lo nuŋ ŋ́ ya ŋ́ náa tɛŋ ǝkǝnǝŋ kɛɛyǝ we pǝ la wʊ pǝ lo toolu diŋrǝ la gakǝ sa kǝ lo ru okuruyǝ rɛ rǝ? Amaa diŋrǝ we ŋrǝŋrǝ lo ru okuruyǝ rɛ rǝ? Kʊrakʊra. <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Tuwǝ ŋ́ ya ŋ́ nǝ́ǝ pǝ́ ŋ́ tɛŋ wǝ kaamǝ ǝkǝnǝŋ vǝ́ epǝ we pǝ lee ci Worokoyǝ pǝ leh yee otoolukǝ we, pǝ lǝŋ wʊ kɛɛyǝ pǝ koonu Worokoyǝ. Paa pǝ láa wʊ kɛɛyǝ pǝ ŋ koonu rǝ awɛɛrɔɔrɔɔyǝ. Paa ŋ́ naa ya ŋ́ nǝ́ǝ pǝ́ nǝ toomu kǝloŋkǝ mǝ awɛɛrɔɔrɔɔyǝ. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Nǝ nyǝŋ koru oŋuŋ mǝ Kulǝtǝyǝ la kɔpʊwǝ nǝ lɛ, kǝ nǝ tǝ nǝ ko ŋuŋ mǝ awɛɛrɔɔrɔɔyǝ la kɔpʊwǝ. Kaa wǝǝ nǝ nyǝŋ koru etii nǝ ri Kulǝtǝyǝ le keeriwǝ nǝ lɛ, kǝ nǝ tǝ nǝ siɛnɩ nǝ ke ri awɛɛrɔɔrɔɔyǝ le keeriwǝ ke. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Amaa la ya yǝ lǝ́ǝ pǝ́ la saanǝ Kulǝtǝyǝ la wǝtɛlɩkpǝ rǝ? Yǝ lo pu wǝ ǝkǝnǝŋ ŋlǝ lǝ lǝǝmǝ okopiyǝ le teeri ŋwǝ?<verse eid="1CO 10:22" /></para>
  <para style="s">Yee tuwǝ we wǝ lóo toŋ lá kɛrɩyǝ wǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />«Gʊŋrǝ gbɛlɩ yǝ lóo koru eyee tu ri ŋ tu» paape ŋkǝ tu ri ŋ tu wǝ lóo toŋ nyɩmaasɩyǝ. «Gʊŋrǝ gbɛlɩ yǝ lóo koru eyee tu ri ŋ tu» paape ŋkǝ tu ri ŋ tu wǝ lóo ko mǝ nyɩmaasɩyǝ rǝ kǝnyɩŋkǝ. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Rɛ ŋ pǝǝ pǝ́ ŋwǝ ceŋceŋ ko le ceeceewǝ, paa ŋ pǝ́ mǝŋ nǝ ǝtǝŋpǝ la nɛŋwǝ. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />Mǝŋ nǝ nyǝ pǝ́ nǝ fuu gakǝ rǝ wǝraakpǝ nǝ wo we, nǝ fuu nǝ wo faa nǝ pǝǝ pǝ́ dierǝ rɛ kǝ wǝ pe kpii nǝ ziɔŋrǝ la awɛɛlɩkǝ. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Duturǝ ɖi kǝtǝǝwǝ mǝ tu ri ŋ tu wǝ kpii rǝ wǝ we, yǝ ri rǝ Ǝtǝ Woroko la anɛŋ. <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />Mǝŋ nyiyǝ rɛ ŋ nee ri kǝrisotǝpiyǝ lo pwo nǝ nǝ pe ri rǝ nǝ kpǝŋ, wǝ́ nǝ nya tɛɛnɩ nyo ko we, nǝ ri tu ri ŋ tu pǝ lóo koonu nǝ, nǝ pǝǝ pǝ́ dierǝ rɛ kǝ wǝ pe kpii nǝ ziɔŋrǝ la awɛɛlɩkǝ. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Paa mǝŋ rɛ le pe tíi nǝ ǝkǝnǝŋ pǝ la wʊ kɛɛyǝ sa pǝ lo toolu etiŋyǝ rǝ we, we nǝ poo wo kǝ. Mǝŋ ŋkǝ kaa wǝǝ we, wǝ lée kpii ziɔŋrǝ la awɛɛlɩkǝ. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Ŋkǝ nǝ ziɔŋrǝ wǝ́ ŋ́ reemǝ wǝ lée kpii awɛɛlɩkǝ wǝ. Paa yǝ we ŋ na tɛŋ tuwǝ sa la ziɔŋrǝ wǝ́ ŋ́ reemǝ. Kǝ́ kǝto wǝ́ tuwǝ we wǝ lée kpii nyipʊŋpwayǝ la ziɔŋrǝ la awɛɛlɩkǝ wǝ lóo koru ǝsǝŋ gʊŋrǝ wǝ koonu tuwǝ we ŋ́ nóo koru eyee wǝ? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Mǝŋ ŋ́ ne ceeni Worokoyǝ rǝ keeriwǝ we ŋ́ neh ri wǝǝ, kǝ́ kǝto wǝ́ nyipʊŋpwayǝ ŋ nǝh tǝ mǝ ŋ tɔɔ mǝ bɔrǝ rǝ keeriwǝ sa lo oŋuŋkǝ ŋ́ ne ceeni Worokoyǝ wǝ? <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />Kǝto ŋ́ ya ŋ́ née tíi nǝ ǝkǝnǝŋ tu ri ŋ tu nǝ nyée ri amaa tu ri ŋ tu nǝ nyóo ŋuŋ amaa tu ri ŋ tu nǝ nyée yee we, nǝ yee wǝlo kpǝlo kǝ wǝ rɛɛrɩ mǝ Worokoyǝ rǝ oŋuŋkǝ. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Paa nǝ pee yee tǝrɛ kǝ wǝ pe ri gbaraarǝ wǝ koonu rɛ. Wǝ ke ce wǝ ri Yudatǝnyiyǝ amaa yǝ we ŋ nee ri Yudatǝnyiyǝ amaa Worokoyǝ la wǝcakukpǝ. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Nǝ re nǝ wɛ mǝŋ ŋmǝ kǝtǝ. Ŋ́ náa nyɩɩ kǝ o turu tu ri ŋ tu ŋ́ née yee wǝ poŋ mǝ nyi ri ŋ nyi. Ŋ́ nǝŋ pǝ́ mǝ nɛŋwǝ ko wǝ poŋ, paa ŋ́ nǝ́ǝ pǝ́ kǝ enyipǝ wa la nɛŋwǝ wǝ poŋ wǝ koonu pǝ, kǝ pǝ nya fɛɛ pǝ nya alɔkuŋkǝ.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Nǝ karǝ mǝ mǝŋ kǝ́ ŋmǝ ŋkpɛ ŋ́ na karǝ Kǝriso kǝtǝ.<verse eid="1CO 11:1" /></para>
  <para style="s">Ǝpǝrǝŋpǝ mǝ etiepǝ lǝ wǝlǝkpǝ rǝ zʊmarǝ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Ŋ́ ya ŋ́ nǝ́ǝ kǝ nǝ mǝ kǝ́ nǝ nyáa taalǝ mǝ rǝ tu ri ŋ tu lǝ mǝrǝ, fǝ kʊla mǝ kǝ́ nǝ ya nǝ nyée yee nyǝ ŋ saŋ rǝ otuyǝ we ŋ́ ne ci ŋ́ na kaŋ nǝ wǝ. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Paa ŋ́ nǝ pǝ́ nǝ ci wǝ ǝkǝnǝŋ we, Kǝriso ŋ ri yurǝ ŋ koonu ǝpǝrǝŋpǝ kpǝlo. Wǝ́ pǝrǝŋyǝ ŋ ri yurǝ ŋ koonu ne tie. Wǝ́ Worokoyǝ ŋ ri yurǝ ŋ koonu Kǝriso. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Kǝto vǝ́ pǝrǝŋyǝ ya láa mwɛŋ nyuŋkpǝ amaa ya láa tɛŋ dierǝ we ŋ na lɔ ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ, wǝ́ ŋ ne sii tuwǝ rǝ yurǝ we, ya lée kpii Kǝriso le kǝyepukǝ rǝ. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Paa mǝŋ tieyǝ ya láa mwɛŋ nyuŋkpǝ amaa ya láa tɛŋ dierǝ we ŋ na lɔ ŋ no ru rǝ Worokoyǝ lǝ kpǝŋ wǝ́ ŋ nee sii tuwǝ rǝ yurǝ we, ya lée kpii no nuŋ le kǝyepukǝ rǝ. Wǝ́ wǝ lɛ wǝ lǝ rǝ mǝŋ tieyǝ sa la kɔlɩ yurǝ rǝ. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Mǝŋ tieyǝ rɛ lǝŋ sii tuwǝ rǝ yurǝ we, we ŋ kɔlɩ yurǝ amaa ŋ puu rǝ. Paa mǝŋ yukɔlɩrǝ amaa yupuurǝ lóo co nʊŋsɔɔwǝ we, we ŋ sii tuwǝ rǝ yurǝ. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Wǝ lee kpii kǝ pǝrǝŋyǝ ŋ sii tuwǝ rǝ yurǝ kpɛŋ kǝ ŋ ci amwɛŋ nyuŋkpǝ. Duturǝ ɖi pǝrǝŋyǝ lo ru Worokoyǝ wǝ́ ŋ náa lɛ mǝ ŋ pɔrʊ na anaanǝkǝ mǝ ŋ kaŋ. Tieyǝ paa láa pɔrʊ no nuŋyǝ la anaanǝkǝ mǝ ŋ kaŋ. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Duturǝ ɖi ŋkǝ tieyǝ wǝ́ Worokoyǝ ŋ fʊ̀ ŋ yàa pǝrǝŋyǝ ŋ rù, paa we pǝrǝŋyǝ wǝ́ Worokoyǝ ŋ fʊ̀ ŋ yàa tieyǝ. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Wǝ́ ke ŋkǝ tieyǝ kǝto wǝ́ Worokoyǝ ŋ cò pǝrǝŋyǝ, paa we pǝrǝŋyǝ kǝto wǝ́ Worokoyǝ ŋ cò tieyǝ wǝ. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" /><note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Fɛɛwǝ sa lo dutunuŋrǝ lɛnyɩ, kǝto enyipǝ pǝ la pɔrʊ wǝ lo duturǝ kpookpoo.</char></note>Ŋ wǝ tuwǝ sa kǝto wǝ́ wǝ kaamǝ kǝ tieyǝ ŋ sii tuwǝ rǝ yurǝ kǝ wǝ pɔrʊ wǝ kaŋ ǝkǝnǝŋ kpii rǝ no nuŋ lǝ kǝnǝŋkǝ. Mǝŋkǝsa we, vǝ́ epicoŋpipǝ pǝ la nyɩŋ tieyǝ we, pǝ ŋ ci wǝ ǝkǝnǝŋ kpii rǝ pǝrǝŋyǝ lǝ kǝnǝŋkǝ. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Mǝŋ kǝ́ wǝ lǝ ǝnǝ we, wǝ kaamǝ kǝ ŋlǝ epǝ we yǝ le yee nyiceŋceŋ mǝ Kulǝtǝyǝ le ci wǝ ǝkǝnǝŋ tieyǝ lee kpii ŋ koonu na wɛ mǝŋ pǝrǝŋyǝ laa kʊla mǝ ŋwǝ, wǝ́ pǝrǝŋyǝ ŋwǝ ŋkpɛ le kpii ŋ koonu na wɛ mǝŋ tieyǝ laa kʊla mǝ ŋwǝ. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Duturǝ ɖi kǝ́ Worokoyǝ ŋ na fʊ pǝrǝŋyǝ ŋ na yaa tieyǝ we, kaa wǝǝ tieyǝ ŋwǝ ŋkpɛ ŋ nǝ́ǝ mǝ pǝrǝŋyǝ wǝǝ. Wǝ́ tu ri ŋ tu wǝ lo ru rǝ Worokoyǝ lǝ kpǝŋ.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Ŋnǝŋnǝ nǝ pu wǝ nǝ yɩrɩ oo, mǝŋ tieyǝ ya láa mwɛŋ nyuŋkpǝ mǝ ŋ pwo Worokoyǝ wǝ́ ŋ nee sii tuwǝ rǝ yurǝ wǝǝ, wǝ ponu? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Ǝrǝkǝ sa kǝ laa ya kǝ láa kaŋ lǝ ǝkǝnǝŋ mǝŋ pǝrǝŋyǝ la maa no oyurooyǝ yǝ lo koŋ wǝǝ, kǝyepukǝ wǝ́ wǝ ri? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Tieyǝ ŋwǝ paa we, nimifiwǝ wǝ́ wǝ ri wǝ koonu ŋwǝ. Duturǝ ɖi Worokoyǝ lo koonu no oyurokoŋyǝ kǝ yǝ nya fɛɛ yǝ ŋ sii no yurǝ. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Wǝ́ mǝŋ rɛ lǝ pǝ́ ŋ tǝ ŋ tiini dierǝ ŋ ru rǝ tuwǝ sa we, yǝ we ŋ ci wǝ ǝkǝnǝŋ yǝ lǝŋ yee wǝ ǝnǝ, wǝ́ alɔnuŋtǝpǝ la wǝcakukpǝ ŋ wǝ ŋkpɛ pǝ lǝŋ yee wǝ ǝnǝ.<verse eid="1CO 11:16" /></para>
  <para style="s">Kulǝtǝyǝ le keeriwǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Tǝrɛ wǝ kpii ŋ́ nǝh tǝ mǝ ŋ tíi nǝ. Wǝ ǝnǝ paa ŋ́ nǝŋ kǝ nǝ. Tuwǝ sa wǝ kaamǝ ǝkǝnǝŋ vǝ́ nǝ nyo ku, kaa kǝ okukǝ sa kǝ yee nǝ ceeceewǝ we, ǝ kǝ ŋ yee nǝ rǝ rɔɔrɔɔ wǝ. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Tusǝsǝŋwǝ wǝ kaamǝ wǝ ǝnǝ, ŋ́ no nuŋ ǝkǝnǝŋ vǝ́ nǝ nyo ko ku we, o turu nǝ ya nǝ nyée kpii wǝsǝpǝkpǝ rǝ awɛ. Wǝ́ ŋ́ na lɔ ŋ́ no nuŋ ǝkǝnǝŋ ayɩrɛ wǝ lóo koru ǝlǝ ǝnǝ. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Wǝ́ paa wǝ kaamǝ kǝ wǝsǝpǝkpǝ wǝ kpii rǝ nǝ mǝrǝ kǝ la nya fɛɛ la nyɩŋ epǝ we pǝ ri anʊkɔrǝtǝsʊmatǝpǝ le ci. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Kǝto nǝ ci wǝ ǝkǝnǝŋ vǝ́ nǝ nyo ko ku mǝŋkǝsa we, ŋkǝ Kulǝtǝyǝ le keeriwǝ wǝ́ nǝ nyóo ko nyǝ ŋ ri oo. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Duturǝ ɖi vǝ́ nǝ nye ke tii nǝ nyeh ri we, nyi ri ŋ nyi ŋ fuunu ŋ ri ŋwǝŋwǝ ne keeriwǝ ŋ lɛ, lǝŋ koonu nǝ ǝtǝŋpǝ. Ŋ wǝ wǝ lóo koonu o turu eniyǝ we kǝtɛŋkǝ kǝ ya kǝ láa wʊ arɛɛpǝ we, o turu arɛɛpǝ paa pǝ lo ŋuŋ pǝ le piemu. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Nǝ nyǝǝ lǝmǝ anyarǝyǝ kǝ o turu nǝ nyée ri kǝ nǝ ŋuŋ rǝ we? Amaa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ kpii alɔnuŋtǝpǝ la wǝcakukpǝ le kǝyepukǝ rǝ? Amaa nǝ ya nǝ nyǝ́ǝ pǝ́ nǝ kpii epǝ we pǝ lǝǝ lǝmǝ tǝrɛ le kǝyepukǝ rǝ? Nǝ nyo pu wǝ ǝkǝnǝŋ kǝ́ wǝ́ ŋ́ neh tíi nǝ? Kǝ ŋ́ ya mǝ ŋ kǝ nǝ rǝ tuwǝ sa nǝ nye yee wǝ? Ŋ́ nǝŋ koru ǝkǝ nǝ kʊrakʊra rǝ tuwǝ sa nǝ nye yee wǝ.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ŋmǝ paa we, tuwǝ we ŋ́ na karǝ ŋ́ no ru rǝ Kulǝtǝyǝ lǝ kpǝŋ wǝ́ ŋ́ na lɛ ŋ́ na kaŋ nǝ we, wǝ kaamǝ wǝ ǝnǝ: Dumurǝ we pǝ kǝ ŋ fǝ Kulǝtǝyǝ Yesu pǝ kpii enyipǝ rǝ akaakǝ we, wǝ́ ŋ fǝ̀ kpɔnɔyǝ, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />wǝ́ ŋ mwɛnɩ nyuŋkpǝ ŋ ceeni Worokoyǝ ŋ tɛ̀ɛ rǝ kpɔnɔyǝ sa, wǝ́ ŋ pò ŋwǝ. Wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Nǝ lɔ. Wǝ ǝnǝ wǝ ri mǝ wɛlɛŋrǝ ŋ́ nǝ fǝ ŋ́ no koonu rǝ nǝ yurǝ wǝ. Nǝ mǝ yee tuwǝ sa, kǝ nǝ mǝ fǝ nǝ mǝ taalǝ mǝ.» <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Kǝ́ pǝ le ri pǝ la lɛ we, wǝ́ ŋ tǝ ŋ fǝ̀ kɔpʊwǝ wǝ kpii mǝ vɛŋyǝ, wǝ́ ŋ tɛnɩ ǝkǝnǝŋ: «Vɛŋyǝ sa ŋ kpii rǝ kɔpʊwǝ sa we, ŋ kaamǝ Dieparǝtǝnǝŋwɛŋrǝ we Worokoyǝ ŋ na parǝ mǝ nǝ saŋ rǝ mǝ ŋpǝrayǝ wǝ. Eni ri ŋ ni nǝ nyóo ŋuŋ vɛŋyǝ sa rǝ wǝlǝkpǝ sa we, nǝ mǝ yee wǝ kǝ nǝ mǝ fǝ nǝ mǝ taalǝ mǝ.» <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Kǝto eni ri ŋ ni nǝ nyáa nya nǝ wo kpɔnɔyǝ kǝ nǝ ŋuŋ vɛŋyǝ rǝ kɔpʊwǝ sa we, o lóo turu nǝ ya nǝ nyáa tɛŋ Kulǝtǝyǝ lǝ ǝkpǝ́kǝ le dierǝ ko ro ǝrǝ eniyǝ we ŋ náa siɛnɩ ŋ pǝ wǝ. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Kǝto yǝ we ŋ nóo wo Kulǝtǝyǝ la kpɔnɔyǝ sa wǝ́ ŋ nóo ŋuŋ na kɔpʊwǝ sa la vɛŋyǝ mǝ wǝlǝrɔɔrɔɔkpǝ we, yǝ we ya le yee turɔɔrɔɔwǝ ko rǝ Kulǝtǝyǝ la wɛlɛŋrǝ mǝ na ŋpǝrayǝ lǝ kpǝŋ. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Kǝto nyi ri ŋ nyi ŋ fii na wɛ lǝ mǝrǝ ŋ yɩrɩ kpɛŋ, kǝ ŋ ci owo kpɔnɔyǝ sa, kǝ ŋ ŋuŋ kɔpʊwǝ sa la vɛŋyǝ. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Duturǝ ɖi mǝŋ rɛ lo wo kpɔnɔyǝ sa, wǝ́ ŋ no ŋuŋ kɔpʊwǝ sa la vɛŋyǝ wǝ́ ŋ naa nyɩŋ kǝloŋkǝ we kǝ kpii rǝ ŋyǝ mǝ Kulǝtǝyǝ la wɛlɛŋrǝ ŋ ci we, yǝ we ya lóo pwo wǝkpaŋtɛŋkpǝ mǝ ŋ tɛɛ rǝ na wɛ rǝ. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ŋ wǝ tuwǝ sa kǝto wǝ́ enyipǝ wa rǝ nǝ mǝrǝ pǝ ya pǝ lǝ́ǝ fǝrǝ, wǝ́ arɛɛpǝ pǝ lǝ kpǝ́ otoŋyǝ, wǝ́ arɛɛpǝ pǝ lǝ kpǝ́ wǝǝ. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Paa mǝŋ ŋlǝŋlǝ yǝ le fii lah wɛ lǝ mǝrǝ yǝ la yɩrɩ we, Worokoyǝ lǝŋ tɛŋ wǝkpaŋkpǝ mǝ lǝ. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Paape mǝŋ Ǝtǝ Woroko la ta lǝ kǝtukoŋkǝ wǝ́ ŋ na kʊʊrʊ lǝ we, le yee wǝ ǝnǝ kǝ ŋ paa pa tɔɔ lǝ bɔrǝ ŋ kʊla mǝ ǝrǝkǝ rǝ. <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />Kǝto we, lǝh ǝtǝŋ, vǝ́ nǝ nyo ko ku nǝ nyeh ri Kulǝtǝyǝ le keeriwǝ we, nǝ yaa nǝ rǝŋ awɛ. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Mǝŋ kǝtɛŋkǝ kǝ ya kǝ láa wʊ rɛ wǝ́ ŋ nǝŋ po koru ayaa ŋ rǝŋ nǝ ǝtǝŋpǝ we, yǝ we ŋ ri rǝ nyarǝwǝ kpɛŋ kǝ ŋ ci ǝpǝ. Mǝŋkǝsa we, Worokoyǝ lǝŋ pa tɔɔ nǝ bɔrǝ vǝ́ nǝ nyo po ku wǝ. Vǝ́ ŋ́ nǝ pǝ pǝ we, ŋ́ noh po toolu otututuruyǝ we ŋ́ koonu nǝ.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Worokoyǝ la Wɛɛrǝ lo otukoonuyǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Lǝh ǝtǝŋ, rǝ Worokoyǝ la Wɛɛrǝ lo otukoonuyǝ la kǝtakǝ we, ŋ́ nǝǝ pǝ́ tǝrɛ wǝ ŋwaa wǝ kpii nǝ ru rǝ yǝ. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Nǝ taalǝ ǝkǝnǝŋ eniyǝ we nǝ nyee ke ci Worokoyǝ we, pǝ ke ŋ re nǝ pǝ ŋ ko etiŋyǝ we yǝ lǝŋ wɛɛlɩ lǝ kpǝŋ. Nǝ nyoo ko ŋ koru ǝsǝ́ŋ. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Kǝto ŋ́ nǝ pǝ́ nǝ ci wǝ ǝkǝnǝŋ mǝŋ nyiyǝ rɛ la tɛŋ ǝkǝnǝŋ «Worokoyǝ la fwɛɛrɩ Yesu» we, ŋkǝ Worokoyǝ la Wɛɛrǝ lo tu ŋwǝ ŋ tɛŋ wǝ. Wǝ́ nyiyǝ rɛ lǝŋ koru atɛŋ ǝkǝnǝŋ «Yesu ŋ ri Kulǝtǝyǝ» mǝŋ Wɛɛkenikenirǝ loo tu ŋwǝ ŋ tɛŋ wǝ wǝ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Wɛɛkenikenirǝ lo otukoonuyǝ yǝ kpii kpookpoo, paape Wɛɛkenikenirǝ we rǝle jeŋceŋ lóo koonu enyipǝ lǝ yǝ. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Anǝnɛyǝ we yǝ lée yee yǝ ŋ koonu Kulǝtǝyǝ yǝ kpii kpookpoo, paape ŋwǝ Kulǝtǝyǝ we ceŋceŋ wǝ́ yǝ lée yee yǝ yǝ ŋ koonu. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Anǝnɛyeeyǝ kpookpoo yǝ kpii, paape Worokoyǝ ŋ née yee yǝlo kpǝlo saŋ rǝ enyikpǝlo. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Wɛɛkenikenirǝ lo koonu nyi ri ŋ nyi rǝ lǝh mǝrǝ la tǝrɛ, kǝ wǝ nya fɛɛ wǝ toŋ loh kpǝlo. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Wɛɛkenikenirǝ lo koonu nyirɛɛyǝ ŋ wɛɛlɩ mǝ nimisiewǝ. Wǝ́ ŋrǝ Wɛɛkenikenirǝ sa lo koonu nyipʊŋpwayǝ ŋ wɛɛlɩ mǝ otuciyǝ. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Ŋrǝ Wɛɛkenikenirǝ sa jeŋceŋ ke lóo koonu nyirɛɛyǝ la lɔnuŋrǝ, ŋrǝ ke lóo koonu nyipʊŋpwayǝ lo okopiyǝ ŋ koru anyarǝpiyǝ la acá. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Wɛɛkenikenirǝ lóo koonu nyirɛɛyǝ ŋ koru otucovurǝ le eyee, nyipʊŋpwayǝ ŋ koru onuŋ Worokoyǝ la kpɛɛwǝ ŋ tɛŋ, nyirɛɛyǝ ŋ koru anyɩŋ ŋ ci mǝŋ wɛɛrǝ rɛ ɖi Worokoyǝ la Wɛɛrǝ amaa wɛɛrɔɔrɔɔrǝ wǝ. Lóo koonu nyirɛɛyǝ ŋ koru awɛɛlɩ wǝrǝpʊŋpwakpǝ nyɩmaasɩyǝ ŋ nǝŋ koru onuŋ wǝ, ŋrǝ lóo koonu nyipʊŋpwayǝ ŋ koru apɔrʊ wǝrǝpʊŋpwakpǝ sa lo duturǝ ŋ tɛŋ. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Wɛɛkenikenirǝ sa rǝle jeŋceŋ ko le yee anǝnɛyǝ sa kpǝlo. Ŋrǝ láa lɛmɩ nyi ri ŋ nyi lo otukoonuyǝ kpookpoo, mǝŋ kǝ́ wǝ ponu mǝ rǝ wǝ.<verse eid="1CO 12:11" /></para>
  <para style="s">Ekǝrisotǝpǝ la wǝcakukpǝ kpǝlo wǝ lo ru nyɩmaasɩyǝ la wɛlɛŋrǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Le cii wǝ ǝkǝnǝŋ nyɩmaasɩyǝ lǝǝmǝ wɛlɛŋrǝ jeŋceŋ, wǝ́ wɛlɛŋrǝ sa lǝǝmǝ okpuŋtuyǝ kǝkpǝŋkǝ. Mǝŋkǝ́ okpuŋtuyǝ sa yǝ naanǝ kǝkpǝŋkǝ we, yǝlo kpǝlo yǝ la ca yǝ le kpii rǝ awɛ wǝ́ yǝ le yee wɛlɛŋrǝ jeŋceŋ, kǝ́ wǝ lǝ Kǝriso wǝǝ. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Kǝto wǝ ke ce wǝ ri Oyudatǝpǝ amaa epǝ we pǝ lee ri Oyudatǝpǝ, arɔŋpǝ amaa epǝ we pǝ tini pǝ koonu pǝla wɛ we, kǝ́ pǝ la nya pǝ le wiiri loh kpǝlo lo worokomɛŋwǝ we, yǝ la siɛrɩ yǝ le yee wɛlɛŋrǝ jeŋceŋ saŋ rǝ Wɛɛkenikenirǝ we jeŋceŋ. Ŋrǝ Wɛɛkenikenirǝ sa ke wǝ́ pǝ lo tuumu lǝ mǝŋ kǝ́ pǝ lóo tuumu nyiyǝ la mɛŋwǝ kǝtǝ.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Wɛlɛŋrǝ lǝǝ lǝmǝ gbuŋturǝ jeŋceŋ ko, paa lǝǝmǝ yǝ yǝ naanǝ. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Mǝŋ kǝkparǝkǝ kǝ la tɛŋ ǝkǝnǝŋ: «Kpiikǝ ŋ́ nee ri akaakǝ kǝto ŋ́ nǝŋ kʊla mǝ wɛlɛŋrǝ» we, kǝkparǝkǝ sa kǝ lǝŋ koru apɔrʊ kǝ la wɛ kǝ cɛ rǝ wɛlɛŋrǝ sa kʊrakʊra. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Kaa wǝǝ mǝŋ kǝtukoŋkǝ kǝ la tɛŋ ǝkǝnǝŋ: «Kpiikǝ ŋ́ nee ri nimirǝ kǝto ŋ́ nǝŋ kʊla mǝ wɛlɛŋrǝ» we, kǝtukoŋkǝ sa kǝ lǝŋ koru apɔrʊ kǝla wɛ kǝ cɛ rǝ wɛlɛŋrǝ kʊrakʊra. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Mǝŋ wɛlɛŋrǝ kpǝlo kɩɩkɩ geh ri rǝ nimirǝ ceŋceŋ wǝǝ, le keh yee nɛŋ kǝ lo mǝ nuŋ? Amaa mǝŋ wɛlɛŋrǝ kpǝlo kɩɩkɩ geh ri rǝ kǝtukoŋkǝ wǝǝ, le keh yee nɛŋ kǝ lo mǝ nuŋ jwɩɩrǝ? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Paape Worokoyǝ ŋ na tɛɛ okpuŋtuyǝ sa rǝ wɛlɛŋrǝ mǝŋ kǝ́ ŋ nǝ pǝ́ wǝ. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Mǝŋ wɛlɛŋrǝ gǝh lǝmǝ gbuŋturǝ jeŋceŋ ko we, pǝ lǝŋ kǝ tǝ pǝ ŋ pwo rǝ wɛlɛŋrǝ. <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Kǝto we okpuŋtuyǝ yǝ kpii yǝ naanǝ, paa wɛlɛŋrǝ jeŋceŋ ko gbii.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Kǝto nimirǝ lǝŋ koru etíi akaakǝ ǝkǝnǝŋ: «Ŋ́ naa ya ŋ́ née wee lǝ́!» Amaa yurǝ lǝŋ koru etíi akparǝyǝ ǝkǝnǝŋ: «Ŋ́ naa ya ŋ́ née wee nǝ!» <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Paa we, okpuŋtuyǝ we yǝ láa nyɩŋ ǝkǝnǝŋ yǝ lee ri tǝrɛ we, yǝ lǝ kpuŋkpuruŋ. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Wǝ́ okpuŋtuyǝ we yǝ lǝŋ kǝ le kpii rǝ tǝrɛ we, ŋyǝ wǝ́ yǝ lée ci ere yǝ ŋ teeri. Kaa wǝǝ eyǝ we yǝ lóo co nʊŋsɔɔwǝ we, ŋyǝ wǝ́ yǝ láa cɛ mǝ yǝ ŋ teeri wǝ. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Okpuŋtuyǝ we yǝ lǝŋ co nʊŋsɔɔwǝ paa we, yǝ lǝǝ pǝ́ wǝ. Worokoyǝ ŋ no co wɛlɛŋrǝ ǝnǝ, wǝ́ ŋ na lɛ ŋ ne yee kǝ pǝ fǝ ǝkǝmumuŋkǝ rɛ pǝ koonu okpuŋtuyǝ we yǝ lǝŋ kǝ le kpii rǝ tǝrɛ wǝ. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Worokoyǝ yeli wǝ ǝnǝ kǝ wǝsǝpǝkpǝ rɛ wǝ pee kpii rǝ wɛlɛŋrǝ, paa kǝ okpuŋtuyǝ we yǝ nya fɛɛ yǝ re awɛ sɩsiɛrɩ. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Mǝŋ gbuŋturǝ rɛ ya lóo fuu we, o turu okpuŋtututuruyǝ we yǝ ya yǝ lóo fuu yǝ ŋ toŋ rǝ. Mǝŋ pǝ la rɛɛrɩ mǝ gbuŋturǝ rɛ we, okpuŋtuyǝ we kpǝlo kɩɩkɩ yǝ ŋ mǝ nya faawǝ yǝ ŋ kʊla mǝ rǝ. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />Ŋnǝ paa we, nǝ ri Kǝriso la wɛlɛŋrǝ. Wǝ́ nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ ri gbuŋturǝ ŋ koonu wɛlɛŋrǝ sa. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Kaa wǝǝ rǝ alɔnuŋtǝpǝ la wǝcakukpǝ mǝrǝ we, enyisǝsǝŋpǝ Worokoyǝ ŋ nǝ tǝnǝ pǝ kaamǝ enyikpiipǝ. Eyitǝpǝ pǝ kaamǝ akpɛɛnuŋtɛŋtǝpǝ. Atatǝpǝ pǝ kaamǝ otukaŋtǝpǝ. Wǝ́ epǝ we pǝ lǝǝmǝ otukoonututuruyǝ sa ǝnǝ pǝ tɛɛ: Ŋyǝ yǝ kaamǝ otucovurǝ le eyeekǝ, wɛɛcáwǝ, kǝnyitoŋkǝ, kǝnyirekǝ mǝ wǝrǝpʊŋpwakpǝ nyɩmaasɩyǝ ŋ nǝŋ koru onuŋ la awɛɛlɩkǝ. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Ŋkǝ pǝlo kpǝlo pǝ ri enyikpiipǝ amaa akpɛɛnuŋtɛŋtǝpǝ amaa otukaŋtǝpǝ. Ŋkǝ pǝlo kpǝlo pǝ lée yee otucovurǝ. <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Ŋkǝ pǝlo kpǝlo pǝ láa cá enyipǝ amaa pǝ láa wɛɛlɩ wǝrǝpʊŋpwakpǝ nyɩmaasɩyǝ ŋ nǝŋ koru onuŋ amaa pǝ láa pɔrʊ ŋkpǝ wǝrǝpʊŋpwakpǝ sa lo duturǝ pǝ ŋ tɛŋ. <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Kǝto nǝ pǝ́ kǝ Wɛɛkenikenirǝ goonu nǝ tukoonuwǝ we wǝ lo ru okuruyǝ wǝ.</para>
  <para style="p" vid="1CO 12:31">Rǝkǝsa we ŋ́ náa kaŋ nǝ gʊŋrǝ we deeri tu ri ŋ tu wǝ.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Kǝǝtaawǝ wǝ teeri tu ri ŋ tu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Mǝŋ wǝ ri ǝkǝnǝŋ ŋ́ náa wɛɛlɩ anyɩmaasɩpǝ lǝ wǝrǝkpǝ amaa epicoŋpipǝ lǝ wǝrǝkpǝ, wǝ́ paa ŋ́ nǝŋ taa mǝ kɛrɩyǝ lǝ kǝǝwǝ we, o lóo turu mǝ awɛɛlɩkǝ kǝ lǝ rǝ mǝŋ goŋkoŋrǝ amaa gbaŋkarǝ we pǝ ya pǝ láa ca wǝ. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Ŋ́ nóo koru eri nyiyǝ we ŋ nóo nuŋ Worokoyǝ la kpɛɛwǝ mǝ ŋ tɛŋ, kǝ ŋ́ koru onuŋ Worokoyǝ lo otuŋwaayǝ kpǝlo lo duturǝ, mǝ otuciyǝ kpǝlo, kǝ ŋ́ lǝmǝ lɔnuŋrǝ ŋpa lóo koru onuru otutupiyǝ. Paape mǝŋ ŋ́ nǝŋ taa mǝ kɛrɩyǝ lǝ kǝǝwǝ we, o lóo turu ŋ́ nee ri tǝrɛ. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Ŋ́ kǝ fǝ mǝ otulǝmǝyǝ kpǝlo ŋ́ sǝpǝ ariariatǝpǝ, kǝ ŋ́ fǝ mǝ wɛlɛŋrǝ ŋ koonu pǝ tu naa we, wǝ́ ŋ nǝŋ taa mǝ kɛrɩyǝ lǝ kǝǝwǝ we, o lóo turu otuyǝ sa ŋ́ ne yee yǝ lǝǝ lǝmǝ vasʊyǝ rɛ.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Yǝ we ŋ náa taa na kɛrɩyǝ lǝ kǝǝwǝ we, lǝǝmǝ lɛtaarǝwǝ wǝ́ ŋ náa lɛ mǝ ŋ toŋ. Yǝ we lǝŋ mwɛɛrɩ otuyǝ le nimirǝ, lǝŋ kaŋ na wɛ, wǝ́ ŋ nǝŋ lɛ ŋ rɛɛrɩ mǝ na wɛ. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Yǝ we ŋ náa taa na kɛrɩyǝ lǝ kǝǝwǝ we, lǝŋ yee otuyǝ yǝ lóo co nʊŋsɔɔwǝ, lǝŋ pǝ́ na nɛŋwǝ ceŋceŋ ko wǝ poŋ, lǝŋ fǝ kpɛɛmʊrʊwǝ kalaŋkalaŋ, lǝŋ lɛ ŋ rɔɔ nyiyǝ. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Yǝ we ŋ náa taa na kɛrɩyǝ lǝ kǝǝwǝ we, lǝŋ nya faawǝ rǝ tuwǝ wǝ laa kʊʊ lo oŋuŋkǝ, paa láa nya faawǝ rǝ anʊkɔrǝyǝ lo oŋuŋkǝ. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Yǝ we ŋ náa taa na kɛrɩyǝ lǝ kǝǝwǝ we, lǝ́ǝ fǝ tu ri ŋ tu mǝ ŋ cɛɛ, láa lɔ tu ri ŋ tu mǝ ŋ nuŋ, lǝ́ǝ rǝŋ tu ri ŋ tu, wǝ́ ŋ náa lɛ mǝ ŋ tɔ mǝ ŋ yaa rǝ tu ri ŋ tu lǝ mǝrǝ. <verse eid="1CO 13:7" /><verse number="8" style="v" sid="1CO 13:8" />Kǝǝtaawǝ wǝ lǝŋ nǝŋ kʊrakʊra. Worokokpɛɛnuŋtɛŋwǝ we, wǝ lah pa tɛlɩ. Wǝrǝpʊŋpwakpǝ nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, wǝ lah pa wɛɛ. Otuciyǝ ŋyǝ ŋkpɛ yǝ lah pa tɛlɩ. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Duturǝ ɖi loh otuciyǝ yǝ loo to. Wǝ́ lah kpɛɛnuŋtɛŋwǝ wǝ laa lɛ wǝ to. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Paa vǝ́ tuwǝ we wǝ lo to milimili wǝ la pa nyɩnɩ we, rǝkǝsa lo otuyǝ we yǝ loo to we, yǝ lǝ́ǝ nǝŋ.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Eniyǝ we ŋ́ ke ri laatiepirǝ we, ŋ́ ka ŋ wɛɛlɩ mǝŋ laatiepirǝ kǝtǝ, wǝ́ ŋ́ lɛ̀ ŋ́ ko ŋ pu yurǝ mǝŋ laatiepirǝ kǝtǝ. Paa rǝkǝsa we, ŋ́ ne yee mumuŋyǝ, kǝto ŋ́ na nyarǝ alaatiepituyǝ ŋ́ no co. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Rǝkǝsa we, wǝ lǝ mǝŋ la ya yǝ láa yɩrɩ otuyǝ rǝ tǝraanyɩŋwǝ, kǝto yǝ laa ya yǝ láa nyɩŋ yǝ sɩsiɛrɩ. Paape jirǝ gbii lǝ́ǝ pǝ, yǝ lah pa ka nyɩŋ tu ri ŋ tu niminimi. Rǝkǝsa we, ŋ́ fee ci Worokoyǝ ŋ́ ko to sɩsiɛrɩ. Paa jirǝ rɛ gbii lǝ́ǝ pǝ, ŋ́ neh pe ci ŋwǝ sɩsiɛrɩ ŋ ko to mǝŋ kǝ́ ŋwǝŋwǝ ŋ cii mǝ wǝ.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Rǝkǝsa we, tuwǝ ta wǝ lo tuuru wǝ kpii. Ŋyǝ yǝ kaamǝ: Lɔnuŋrǝ, ǝrǝŋkǝ mǝ kǝǝtaawǝ. Paa rǝ tuwǝ sa ta lǝ mǝrǝ we, kǝǝtaawǝ wǝ ri mumuŋwǝ.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Kpɛɛnuŋtɛŋwǝ mǝ wǝrǝpʊŋpwakpǝ la awɛɛlɩkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Nǝ nyɩɩ nǝ siimǝ kǝǝtaawǝ la akʊŋyǝ. Wɛɛkenikenirǝ lo otukoonuyǝ yǝ lɛ yǝ ŋ ca nǝ kpɛɛ, otukpǝlo worokokpɛɛnuŋtɛŋwǝ. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Yǝ we ŋ náa wɛɛlɩ wǝrǝpʊŋpwakpǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, Worokoyǝ wǝ́ ŋ ya ŋ náa wɛɛlɩ mǝ ŋkǝ anyɩmaasɩpǝ duturǝ ɖi nyɩmaasɩyǝ rɛ lǝŋ koru onuŋ dierǝ we ŋ ya ŋ náa tɛŋ lo duturǝ. Saŋ rǝ Wɛɛkenikenirǝ lo oŋuŋkǝ ŋ mǝ tɛŋ otuŋwaayǝ. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Paa yǝ we ŋ ya ŋ nóo nuŋ Worokoyǝ la kpɛɛwǝ mǝ ŋ tɛŋ we, ya láa wɛɛlɩ mǝ ŋ tíi anyɩmaasɩpǝ rǝ. Ne dierǝ we ŋ ya ŋ náa tɛŋ lóo toŋ, lée kpii enyipǝ la wɛɛlɛŋwǝ, wǝ́ láa ta enyipǝ lo turuwǝ. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Yǝ we ŋ ya ŋ náa wɛɛlɩ kǝrǝpʊŋpwakǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, ya lóo toŋ na wɛ rǝ. Paa yǝ we ŋ ya ŋ nóo nuŋ Worokoyǝ la kpɛɛwǝ mǝ ŋ tɛŋ we, ya lóo toŋ alɔnuŋtǝpǝ la wǝcakukpǝ rǝ.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Ŋ́ nǝ pǝ́ kǝ nǝ kpǝlo nǝ mǝ wɛɛlɩ wǝrǝpʊŋpwakpǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ wǝ, paa mǝŋ nǝ nyo nuŋ Worokoyǝ la kpɛɛwǝ nǝ nya tɛŋ we, wǝ ponu mǝ mǝ wǝ teeri. Duturǝ ɖi yǝ we ŋ nóo nuŋ Worokoyǝ la kpɛɛwǝ mǝ ŋ tɛŋ we, lóo toŋ mǝ ŋ teeri yǝ we ŋ ya ŋ náa wɛɛlɩ ŋkpǝ wǝrǝpʊŋpwakpǝ sa wǝ, we tɛŋ nyiyǝ rɛ kpii ŋ náa pɔrʊ no tutɛŋwǝ sa lo duturǝ, kǝ wǝ nya fɛɛ wǝ toŋ alɔnuŋtǝpǝ la wǝcakukpǝ. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Lǝh ǝtǝŋ, kǝ lǝ fǝ wǝ mǝŋ ŋ́ nǝ pǝ nǝ kpǝŋ ŋ́ pa yɩrɩ nǝ, wǝ́ ŋ́ na pa ya ŋ́ náa wɛɛlɩ kǝrǝpʊŋpwakǝ nyɩmaasɩyǝ ŋ nǝŋ nuŋ mǝ nǝ wǝǝ, wǝ lóo koru otoŋ nǝ kǝ nǝ nuŋ tǝrɛ lo duturǝ? Wǝ ke ce wǝ ri Worokoyǝ la pɔrʊ tǝrɛ la kaŋ mǝ amaa lo koonu mǝ tuciwǝ rɛ ŋ koonu nǝ amaa Worokoyǝ la kpɛɛwǝ wǝ́ ŋ no nuŋ amaa otukaŋyǝ wǝ́ ŋ́ ne re ŋ́ nǝ pǝ we, wǝ lǝŋ toŋ nǝ kʊrakʊra.<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Kǝ́ wǝ lǝ wǝ koonu delɛɛrǝ mǝ ɖuleyǝ wǝǝ. Mǝŋ pǝ ya pǝ lǝ́ǝ kpǝǝ delɛɛrǝ wǝ́ pǝ ya pǝ láa ca ɖuleyǝ cɛɛcɛ mǝ kpɛɛwǝ ceŋceŋ wǝǝ, yǝ lée yee nɛ kǝ lo nuŋ yǝla akpɛɛyǝ le ci. <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Mǝŋ pataputuyǝ la kpɛɛwǝ wǝ loo ru sɩsiɛrɩ wǝǝ, ǝlǝ ŋ nóo koru akpaka ŋ ko akɔŋkǝ? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Kǝ́ wǝ lǝ wǝǝ, mǝŋ nǝ ya nǝ nyáa wɛɛlɩ kǝrǝkǝ pǝ lǝŋ nuŋ we, nǝ ci wǝ ǝkǝnǝŋ rɛ lǝ ŋ po nuŋ tuwǝ we nǝ ya nǝ nyáa tɛŋ lo duturǝ, kpiikǝ nǝ otutɛŋyǝ we yǝ lǝǝ lǝmǝ duturǝ. Nǝ nyah mǝ wɛɛlɩ nǝ mǝ co rǝ. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Wǝrǝkpǝ kpookpoo wǝ kpii rǝ ǝrǝkǝ wǝ naanǝ. Paape wǝlo kpǝlo kɩɩkɩ wǝ lǝǝmǝ duturǝ wǝ koonu epǝ we pǝ láa wɛɛlɩ kpǝ wǝ. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Paape mǝŋ nyiyǝ rɛ ya láa wɛɛlɩ kǝrǝkǝ rɛ ŋ́ nǝŋ nuŋ we, ŋwǝ nyiyǝ sa lah mǝ nyɩŋ mǝ rǝ mǝŋ sǝǝyǝ wǝ́ ŋ́ ri, wǝ́ ŋmǝ ŋkpɛ ŋ́ nah mǝ nyɩŋ ŋwǝ mǝŋ sǝǝyǝ wǝ́ ŋ ri. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Kǝto ŋnǝ ŋkpɛ we, kpiikǝ nǝ ya nǝ nyǝ́ǝ pǝ́ Wɛɛkenikenirǝ lo otukoonuyǝ kpuŋkpuruŋ we, nǝ nyɩɩ nǝ taa eyǝ we yǝ lóo toŋ alɔnuŋtǝpǝ la wǝcakukpǝ kǝ yǝ naanǝ ŋpa.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Kǝto yǝ we ŋ náa wɛɛlɩ kǝrǝpʊŋpwakǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, ŋ mwɛŋ nyuŋkpǝ kǝ Worokoyǝ ŋ toŋ ŋwǝ kǝ mǝ ŋ koru kǝrǝpʊŋpwakǝ sa la apɔrʊtɛŋ. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Duturǝ ɖi mǝŋ ŋ́ ya ŋ́ náa mwɛŋ nyuŋkpǝ mǝ kǝrǝpʊŋpwakǝ sa we, o turu mǝ wɛɛrǝ ya láa mwɛŋ nyuŋkpǝ paa mǝ otuciyǝ yǝ lǝŋ yee tǝrɛ. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Tuwǝ ŋ́ neh mǝ yee wǝ kaamǝ wǝ ǝnǝ: Ŋ́ nah mǝ mwɛŋ nyuŋkpǝ rǝ wɛɛrǝ, kǝ ŋ́ lɛ mǝ ŋ mwɛŋ nyuŋkpǝ mǝ mǝ otuciyǝ. Ŋ́ nah mǝ nɔŋ mǝ wɛɛrǝ, kǝ ŋ́ lɛ mǝ ŋ nɔŋ mǝ mǝ otuciyǝ. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Mǝŋ a ya láa mwɛŋ nyuŋkpǝ rǝ wɛɛrǝ sɔŋ e mǝ ŋ ceeni Worokoyǝ rǝ alɔnuŋtǝpǝ mǝrǝ, wǝ́ nyiyǝ rɛ ŋ nee ci tuwǝ sa la tǝrɛ ŋ tini ŋ kʊla mǝ pǝ wǝǝ, lée yee nɛ kǝ ŋ tɛɛnɩ «Amɛnǝ» ŋ koonu ló nyuŋmwɛŋwǝ we? Kpiikǝ lee ci tuwǝ a ya láa tɛŋ wǝ. <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ayɩrɛ ŋlǝ́ paa a ya lée ceeni Worokoyǝ sɩsiɛrɩ, paape a laa ya lóo toŋ enyituturupǝ.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ŋ́ ya ŋ́ née ceeni Worokoyǝ mǝ kǝ́ ŋ́ náa wɛɛlɩ wǝrǝŋwɛŋkpǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ mǝ ŋ teeri nǝ kpǝlo wǝ. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Paape mǝŋ rǝ alɔnuŋtǝpǝ la wǝcakukpǝ mǝrǝ we, vǝ́ ŋ́ na tɛŋ etieyǝ atʊʊ yǝ lǝǝmǝ duturǝ ŋ́ na kaŋ enyipǝ lo otuyǝ we, wǝ ponu wǝ teeri kǝ́ ŋ́ nah wɛɛlɩ ŋ́ tɛŋ etieyǝ lafawǝ tǝ mǝ wǝrǝpʊŋpwakpǝ sa.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Lǝh ǝtǝŋ nǝ poo mǝ pu yurǝ mǝŋ alaatiepipǝ kǝtǝ. Ko rǝ turɔɔrɔɔwǝ le eyeekǝ lǝ kpǝŋ we, nǝ ru alaatiepipǝ. Paa mǝŋ nǝ nyoh pu yurǝ we, nǝ pu rǝ mǝŋ omumuŋpǝ kǝtǝ. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Tuwǝ Worokoŋtierǝ la tɛŋ wǝ kaamǝ wǝ ǝnǝ, Ǝtǝ Woroko la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1CO 14:21">«Ŋ́ née kpii enyipǝ pǝ láa wɛɛlɩ wǝrǝpʊŋpwakpǝ mǝ ǝsǝǝpǝ</para>
  <para style="q1" vid="1CO 14:21">pǝ pa tɛŋ mǝ dierǝ pǝ tíi mǝ kǝkpǝŋkǝ.</para>
  <para style="q1" vid="1CO 14:21">Wǝ́ ŋ́ lɛ ŋ́ cii wǝ ǝkǝnǝŋ pǝ lǝŋ po co kǝtukoŋkǝ rǝ mǝ.»<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Kǝto mǝŋ rɛ ya láa wɛɛlɩ kǝrǝpʊŋpwakǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, wǝ ri rǝ barǝ wǝ koonu epǝ we pǝ laa lɔ pǝ nuŋ wǝ, ŋkǝ alɔnuŋtǝpǝ. Wǝ́ mǝŋ rɛ lo nuŋ Worokoyǝ la kpɛɛwǝ la tɛŋ we, wǝ ri rǝ barǝ wǝ koonu alɔnuŋtǝpǝ, ŋkǝ epǝ we pǝ laa lɔ pǝ nuŋ wǝ. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Kǝ lǝ fǝ wǝ mǝŋ alɔnuŋtǝpǝ la wǝcakukpǝ kpǝlo wǝ lo ko ku, wǝ́ pǝ lo kpǝlo pǝ ya pǝ láa wɛɛlɩ wǝrǝpʊŋpwakpǝ sa, wǝ́ enyipǝ rɛ pǝ lee ci tuwǝ sa la tǝrɛ amaa epǝ we pǝ laa lɔ pǝ nuŋ pǝ lo po ru rǝ nǝ wǝǝ, pǝ lǝŋ tɛŋ ǝkǝnǝŋ ŋnǝ nǝ ya nǝ nyée fii yurǝ rǝ? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Paa mǝŋ nǝ kpǝlo nǝ ya nǝ nyóo nuŋ Worokoyǝ la kpɛɛwǝ nyǝ ŋ tɛŋ, wǝ́ nyiyǝ rɛ ŋ nee ci tuwǝ sa la tǝrɛ amaa yǝ we ŋ naa lɔ ŋ nuŋ ŋ no po ru rǝ nǝ we, lóo nuŋ etieyǝ we nǝ ya nǝ nyáa tɛŋ lo duturǝ, kǝ ŋ nyɩŋ na wɛ ŋ ci ǝkǝnǝŋ ŋwǝ ŋ ri turɔɔrɔɔyeetǝyǝ, wǝ́ Worokoyǝ ŋ na tɔɔ na bɔrǝ. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Dierǝ sa láa saarǝ tuwǝ we wǝ la ŋwaa wǝ kpii ŋwǝ rǝ ziɔŋrǝ, kǝ ŋ lɛ ŋ sʊʊ ŋ kʊŋ ŋ tɔ kǝtukǝ rǝ kǝtǝǝwǝ ŋ sʊma Worokoyǝ ŋ tɛŋ ǝkǝnǝŋ: «Worokoyǝ kʊla mǝ nǝ kǝceece!»<verse eid="1CO 14:25" /></para>
  <para style="s">Worokoyǝ lǝŋ yee no otuyǝ kǝyakpaakǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Lǝh ǝtǝŋ, kǝ́ wǝ kaamǝ kǝ le yee rǝkǝsa? Vǝ́ nǝ nyo ko ku we, rɛ rǝ nǝ mǝrǝ lóo koru anɔŋ, kǝ rɛɛyǝ ŋ kaŋ otuyǝ. Rɛɛyǝ lóo koru atɛŋ Worokoyǝ lo tuwǝ we ŋ na pɔrʊ ŋ na kaŋ ŋwǝ wǝ, kǝ nyipʊŋpwayǝ ŋ wɛɛlɩ kǝrǝpʊŋpwakǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ wǝ. Rɛɛyǝ lóo koru apɔrʊ kǝrǝpʊŋpwakǝ sa lo duturǝ ŋ tɛŋ. Wǝ kpii kǝ ŋyǝ otuyǝ sa kpǝlo yǝ toŋ wǝcakukpǝ we kpǝlo. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Mǝŋ pǝ láa wɛɛlɩ kǝrǝpʊŋpwakǝ rɛ nyɩmaasɩyǝ ŋ nǝŋ nuŋ we, wǝ pee teeri enyi eyi amaa ata, kǝ pǝ lɛ pǝ wɛɛlɩ rǝ tɛɛ rǝ tɛɛ. Wǝ́ wǝ kaamǝ kǝ rɛ ŋ pɔrʊ tuwǝ we pǝ la tɛŋ lo duturǝ. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Wǝ́ mǝŋ rɛ lee kpii ŋ náa pɔrʊ ŋ tɛŋ we, we kǝ pǝ rǝŋ, kǝ nyi ri ŋ nyi mǝ ŋ wɛɛlɩ mǝ na wɛ, kǝ ŋ lɛ mǝ ŋ wɛɛlɩ mǝ Worokoyǝ. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Ko rǝ epǝ we pǝ lóo nuŋ Worokoyǝ la kpɛɛwǝ pǝ ŋ tɛŋ lǝ kpǝŋ we, enyi eyi amaa ata pǝ wɛɛlɩ kǝ enyituturupǝ pǝ co kǝtukoŋkǝ pǝ nuŋ mǝŋ kǝceece amaa niarǝ. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Paa mǝŋ Worokoyǝ la pɔrʊ tǝrɛ la kaŋ nyipʊŋpwayǝ ŋ tɛŋ mǝ eniyǝ we yǝ eni ŋ ya ŋ náa wɛɛlɩ we, wǝ kpii kǝ yǝ we ŋ ya ŋ náa wɛɛlɩ ŋ rǝŋ. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Nǝ kpǝlo nǝ nyóo koru onuŋ Worokoyǝ la kpɛɛwǝ nǝ tɛŋ, paape nǝ yee wǝ rǝ tɛɛ rǝ tɛɛ. Mǝŋ nǝ nye yee wǝ mǝŋkǝsa we, nǝ kpǝlo nǝ nyáa karǝ tǝrɛ, kǝ wǝ lɛ wǝ kpii nǝ okopiyǝ. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Kpɛɛnuŋtɛŋtǝyǝ lée ri kpɛɛnuŋtɛŋwǝ la wɛɛrǝ we gbii rǝ ŋwǝ lo yurǝ. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Duturǝ ɖi Worokoyǝ lee ri kǝyakpaakǝ lo Worokoyǝ, paa wǝtaarǝkpǝ lo Worokoyǝ wǝ́ ŋ ri.</para>
  <para style="p" vid="1CO 14:33">Mǝŋ kǝ́ pǝ lée yee wǝ rǝ alɔnuŋtǝpǝ kpǝlo kɩɩkɩ la wǝcakukpǝ rǝ fɛɛ ri ŋ fɛɛ kǝtǝ we, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />vǝ́ nǝ nyo ko ku we, wǝ kpii kǝ etiepǝ pǝ rǝŋ yiriri pǝ tii. Gʊŋrǝ laa kpɛɛ pǝ láa lɔ kpɛɛwǝ pǝ tɛŋ dierǝ rɛ. Pǝ pɛɛlɩ pǝla wɛ mǝŋ kǝ́ Mose le seyǝ ŋ na tɛŋ wǝ kǝtǝ. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Mǝŋ pǝ lǝ pǝ́ pǝ nuŋ tǝrɛ lo duturǝ we, pǝ kǝ pǝ́ pǝlo onuŋpǝ rǝ nyarǝwǝ. Wǝ laa kaamǝ kǝ tieyǝ ŋ lɔ kpɛɛwǝ ŋ wɛɛlɩ rǝ wǝcakukpǝ rɛ.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Nǝ nyo pu wǝ ǝkǝnǝŋ nǝ kpǝŋ wǝ́ Worokoŋtierǝ we lo ru lǝ pǝ wǝ? Amaa ŋnǝ ceŋceŋ wǝ́ Worokoŋtierǝ sa lǝ pǝ lo koonu? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Mǝŋ rɛ cii wǝ ǝkǝnǝŋ ŋwǝ ŋ na lɔ Wɛɛkenikenirǝ amaa ŋwǝ ŋ ri worokokpɛɛnuŋtɛŋtǝyǝ we, yǝ we ŋ nyɩŋ tuwǝ sa ŋ́ na ŋʊrʊ ŋ́ na maŋ nǝ ŋ ci ǝkǝnǝŋ Kulǝtǝyǝ lo tutɛŋwǝ wǝ lǝǝwe. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Paa mǝŋ yǝ we laa nyɩŋ wǝ ŋ ci ǝnǝ we, wǝ la pɔrʊ wǝ la kaŋ ǝkǝnǝŋ Worokoyǝ ŋwǝ ŋkpɛ lee ci ŋwǝ nyiyǝ sa.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Kǝto we, lǝh ǝtǝŋ wǝ kpii kǝ nǝ taa rǝ kpɛɛnuŋtɛŋwǝ lo tukoonuwǝ. Paape nǝ pǝǝ sǝŋ gʊŋrǝ nǝ koonu enyipǝ pǝ wɛɛlɩ wǝrǝpʊŋpwakpǝ we nyɩmaasɩyǝ ŋ nǝŋ nuŋ wǝ, <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />paa kǝ nǝ yee tu ri ŋ tu mǝŋ kǝ́ wǝ lǝ pǝ́ wǝ, rǝ tɛɛ rǝ tɛɛ.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Kǝriso la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Lǝh ǝtǝŋ, ŋ́ ya ŋ́ náa taalǝ nǝ Dieceeceerǝ we ŋ́ tɛnɩ ŋ́ tìi nǝ wǝ. Ɖǝ we nǝ lɔ̀ nǝ nunu wǝ́ nǝ nya lɛ nǝ nya ta nǝ re kpamama wǝ. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Mǝŋ nǝ nya ta Dieceeceerǝ sa nǝ re kpamama mǝŋ kǝ́ ŋ́ tɛnɩ rǝ ŋ́ tìi nǝ we, Worokoyǝ lah pa saŋ rǝ rǝ ŋ pɔrʊ nǝ. Mǝŋ ŋkǝ kaa wǝǝ we, o lóo turu nǝ nya lɔ nǝ nyo nuŋ akpaakpaa. <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />Tusǝsǝŋwǝ pǝ kanǝ mǝ ǝkǝ ŋ́ nǝ fǝ ŋ́ na kaŋ nǝ wǝ kaamǝ wǝ ǝnǝ: Kǝriso lǝ kpǝ́ rǝ loh oturɔɔrɔɔyǝ lo yurǝ mǝŋ kǝ́ Worokoŋtierǝ la tɛŋ wǝ kǝtǝ. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Wǝ́ pǝ kolu pǝ ŋwàa ŋwǝ, wǝ́ juutatǝrǝ ŋ sàanǝ mǝŋ kǝ́ Wǝŋʊrʊkenikenikpǝ wǝ tɛnɩ kǝtǝ. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Kefasǝ, wǝla kǝmaakǝ wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ enyikpiitǝmeyipǝ we. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Wǝla kǝmaakǝ wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ otukarǝtǝpǝ tuurutʊʊ mǝ otuyǝ kǝtǝrǝceŋceŋ. Enyipǝ wa rǝ pǝlǝ mǝrǝ pǝ tǝ pǝ kpii vɔrʊrǝ, arɛɛpǝ pǝ lǝ kpǝ́. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Wǝla kǝmaakǝ wǝ́ ŋ pɔ̀rʊ na wɛ ŋ kanǝ Yakubu, wǝ́ ŋ pɔrʊ na wɛ ŋ kanǝ enyikpiipǝ we kpǝlo. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Rǝ kǝlɛɛkǝ we, wǝ́ ŋ lɛ̀ ŋ pɔ̀rʊ na wɛ ŋ kanǝ mǝ. Eniyǝ we ŋ́ kǝ lǝ rǝ mǝŋ piyǝ we ŋ noo to akɛɛnyɔŋpǝ wǝ. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Duturǝ ɖi ŋ́ ri enyikpiipǝ le pipipipiyǝ. Rǝ anʊkɔrǝyǝ we, wǝ lee ce wǝ kaamǝ kǝ pǝ pwo mǝ nyikpiiyǝ kaŋfɩ. Duturǝ ɖi ŋ́ yili ŋ́ tɛ̀ɛ rǝ alɔnuŋtǝpǝ la wǝcakukpǝ. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Paape rǝ Worokoyǝ la lɛsiɛrɩwǝ kǝto we, ŋ́ na pa siɛrɩ ŋ́ ne yee nyiyǝ sa nǝ ya nǝ nyáa nyɩŋ ruŋruŋ wǝ. Wǝ́ na lɛsiɛrɩwǝ sa ŋ ne yee mǝ we, wǝ lee ri tukpaakpaawǝ. Ŋmǝ bomu ŋ́ ne pe yee anǝnɛyǝ ŋ́ ne teeri enyikpiipǝ we kpǝlo, ŋkǝ ŋmǝŋmǝ ŋ́ ne yee yǝ, paa Worokoyǝ la lɛsiɛrɩwǝ we ŋ ne yee mǝ wǝ lǝǝwe. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Kǝto wǝ ke ce wǝ ri ŋmǝ ŋ́ ya ŋ́ náa tɛŋ Worokoŋtierǝ amaa enyikpiituturupǝ we pǝ ya pǝ láa tɛŋ rǝ we, dierǝ we rǝle jeŋceŋ wǝ́ la ya yǝ láa tɛŋ. Ŋrǝ wǝ́ nǝ nya lɔ nǝ nyo nuŋ.<verse eid="1CO 15:11" /></para>
  <para style="s">Enyiǝtǝpǝ pǝ lah pa saanǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Dieceeceerǝ we la ya yǝ láa tɛŋ gaamǝ ǝkǝnǝŋ Kǝriso la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ. Kǝ́ kǝto wǝ́ enyirɛɛpǝ rǝ nǝ mǝrǝ pǝ ya pǝ láa tɛŋ ǝkǝnǝŋ Worokoyǝ lǝŋ pa saanǝ enyiǝtǝpǝ wǝ? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Mǝŋ wǝ keh ri ǝkǝnǝŋ Worokoyǝ lǝŋ pa saanǝ enyiǝtǝpǝ we, we Kǝriso ŋwǝ ŋkpɛ lǝŋ ka saanǝ. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Wǝ́ mǝŋ Kǝriso laa ka saanǝ ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, o koh turu yǝ la tɛŋ Dieceeceerǝ we yǝ lo co rǝ, wǝ́ ŋnǝ ŋkpɛ nǝ nya lɔ nǝ nyo nuŋ nǝ nyo co rǝ. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Tǝ fǝ kʊla we, mǝŋ kǝceece enyiǝtǝpǝ pǝ lǝŋ pa saanǝ we, a kah nyɩŋ Worokoyǝ laa saanǝ Kǝriso ŋ ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝǝ. O koh turu yǝ la nia yǝ la tɛɛ rǝ Worokoyǝ ǝkǝnǝŋ la saanǝ Kǝriso rǝ enyiǝtǝpǝ lǝ mǝrǝ, paa kǝ o turu lee yee wǝ. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Mǝŋ Worokoyǝ lǝŋ pa saanǝ enyiǝtǝpǝ we, we laa saanǝ Kǝriso ŋwǝ ŋkpɛ. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Wǝ́ mǝŋ Kǝriso laa ka saanǝ we, nǝ lɔnuŋrǝ geh ri tukpaakpaawǝ, a kah nyɩŋ nǝ tǝ nǝ tini rǝ nǝ oturɔɔrɔɔyǝ lǝ mǝrǝ tapɩ. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />A kah nyɩŋ epǝ we pǝ la lɔ Kǝriso pǝ lo nuŋ kpɛŋ wǝ́ pǝ le ci ǝkpǝ́ la nɛŋwǝ wǝ la lɛ wǝǝ. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Wǝ́ mǝŋ yǝ lǝ fǝ lah kpɛɛwǝ yǝ la tɛɛ rǝ Kǝriso rǝ kǝtǝǝwǝ la vɔrʊrǝ sa ceŋceŋ ko we, loh tuwǝ wǝ koh co tǝlarǝwǝ wǝ teeri nyi ri ŋ nyi.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Paa rǝ anʊkɔrǝyǝ we, Kǝriso la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ, kǝ wǝ fǝ wǝ tɛɛ ɖurǝ ǝkǝnǝŋ enyiǝtǝpǝ ŋpǝ ŋkpɛ pǝ lah pa saanǝ. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Duturǝ ɖi kǝ́ gbɛŋrǝ la saŋ rǝ nyiyǝ ceŋceŋ lo oŋuŋkǝ lǝ pǝ ǝrǝkǝ we, kaa wǝǝ saŋ rǝ nyiyǝ ceŋceŋ lo oŋuŋkǝ we, enyiǝtǝpǝ pǝ láa saanǝ. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Mǝŋ kǝ́ anyɩmaasɩpǝ kpǝlo kɩɩkɩ pǝ lǝ́ǝ kpǝ́ mǝ kǝ́ pǝ le yee nyiceŋceŋ mǝ Adamǝ we, kaa wǝǝ anyɩmaasɩpǝ kpǝlo kɩɩkɩ pǝ láa nya vɔrʊrǝ mǝ kǝ́ pǝ le yee nyiceŋceŋ mǝ Kǝriso wǝ. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Paape Worokoyǝ lah pa saanǝ nyi ri ŋ nyi rǝ tɛɛ rǝ tɛɛ. Kǝriso ŋ na saanǝ ŋ no coŋ ŋ no koonu enyikpǝlo. Wǝla kǝmaakǝ we, epǝ we pǝ ri Kǝriso la anɛŋpǝ pǝ lah pa saanǝ mǝ eniyǝ we ŋwǝ Kǝriso ŋ nǝ́ǝ pǝ wǝ. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Rǝ wǝla kǝmaakǝ we, eniyǝ we ǝrǝkǝ la alɛɛkǝ kǝ lo ro. Kǝriso lǝ́ǝ nǝǝnǝ asaatiitǝpǝ kpǝlo, okopiyǝ kpǝlo mǝ alɛnyɩkǝ kpǝlo, kǝ ŋ fǝ wǝpilirikpǝ we ŋ koonu Worokoyǝ we ŋ ri Tǝyǝ. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Wǝ kpii kǝ Kǝriso ŋ ri wǝpilikpǝ ko ro ǝrǝ eniyǝ we Worokoyǝ ŋ nǝ́ǝ fǝ nǝ ǝkǝǝkpǝlǝtǝpǝ ŋ kpii ŋwǝ rǝ akparǝyǝ kǝnǝŋkǝ. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Kǝǝkpǝlǝtǝtuturuyǝ Worokoyǝ ŋ nǝh pǝ nǝǝnǝ ŋ kaamǝ gbɛŋrǝ. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Duturǝ ɖi pǝ la ŋʊrʊ pǝ le kpii rǝ Worokoŋtierǝ ǝkǝnǝŋ: «Worokoyǝ lǝ fǝ tu ri ŋ tu le kpii ŋwǝ rǝ akparǝyǝ kǝnǝŋkǝ». Paape mǝŋ pǝ la tɛŋ ǝkǝnǝŋ tu ri ŋ tu wǝ kpii ŋwǝ rǝ kǝnǝŋkǝ we, wǝlo duturǝ wǝ ri ǝkǝnǝŋ otuyǝ kpǝlo kɩɩkɩ. Worokoyǝ ŋwǝ paa laa kʊla, duturǝ ɖi ŋwǝ Worokoyǝ ŋ no koonu Kǝriso lo okopiyǝ sa rǝ tu ri ŋ tu lo oŋuŋkǝ wǝ. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Vǝ́ Worokoyǝ lǝ fǝ tu ri ŋ tu le kpii Kǝriso rǝ kǝnǝŋkǝ la lɛ we, o lóo turu Kǝriso yǝ we ŋ ri Piyǝ we, ŋwǝŋwǝ láa pɛɛlɩ ŋ koonu Worokoyǝ we ŋ nǝ fǝ tu ri ŋ tu ŋ ne kpii ŋwǝ rǝ kǝnǝŋkǝ wǝ. Mǝŋkǝsa we, Worokoyǝ lée ri wǝpilikpǝ fee rǝ tu ri ŋ tu.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Mǝŋ wǝ lǝǝ kǝ lǝ ǝnǝ wǝǝ, kǝ́ kǝto wǝ́ enyipǝ pǝ ko ŋ ko pǝ ŋ wii worokomɛŋwǝ rǝ enyiǝtǝpǝ lo yuwǝ wǝ? Mǝŋ wǝ keh ri kǝceece enyiǝtǝpǝ pǝ lǝŋ pa saanǝ wǝǝ, kǝ́ kǝto wǝ́ enyipǝ pǝ ke ŋ wii worokomɛŋwǝ rǝ pǝlo yuwǝ wǝ? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Mǝŋ Worokoyǝ lǝŋ pa saanǝ enyiǝtǝpǝ wǝǝ, kǝ́ kǝto wǝ́ ŋlǝ paa lǝ tǝ la sanǝ rǝ gbɛŋrǝ la gʊŋrǝ sa yǝ lóo ko wǝ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Lǝh ǝtǝŋ, ji ri ŋ ji ŋ́ náa nyɩŋ gbɛŋrǝ kǝlǝkǝlǝ. Rǝ anʊkɔrǝyǝ we, ŋ́ ya ŋ́ náa nya faawǝ rǝ nǝ mǝ kǝ́ nǝ nye yee nyiceŋceŋ mǝ Yesu Kǝriso, loh Kulǝtǝyǝ wǝ. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Kǝ́ ŋ́ fìa mǝ apɔɔkɛɛpǝ rǝ Efeso wǝǝ, o koh nuŋ anyɩmaasɩpǝ ceŋceŋ kǝto wǝ́ ŋ́ fìa ǝnǝ wǝǝ, vasʊyǝ rǝ fǝŋ wǝ́ ŋ́ kah nya? Mǝŋ enyiǝtǝpǝ pǝ lǝŋ pa saanǝ we, we nǝ pǝ kǝ le yee mǝŋ kǝ́ pǝ láa tɛŋ wǝ kǝtǝ: Kǝ le mǝ ri, kǝ lo mǝ ŋuŋ duturǝ ɖi soosowǝ sa wǝ lo furu yǝ lǝh kpǝ́. <verse eid="1CO 15:32" /><verse number="33" style="v" sid="1CO 15:33" />Nǝ pǝǝ tǝǝnǝ nǝ wɛ oo, vǝ́ mǝŋ a láa saŋ mǝ nyirɔɔrɔɔyǝ we, lǝ́ wǝlǝceeceekpǝ wǝ lǝ́ǝ pǝlǝ. <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Nǝ siɛnɩ nǝ pǝ nǝ wɛ lǝ mǝrǝ mǝŋ kǝ́ wǝ lǝ pǝ́ wǝ, kǝ nǝ wɛɛ mǝ turɔɔrɔɔwǝ. Ŋ́ na tɛŋ wǝ ǝnǝ kǝ nʊŋsɔɔwǝ wǝ yee nǝ, duturǝ ɖi enyirɛɛpǝ rǝ nǝ mǝrǝ pǝ lee ci Worokoyǝ.<verse eid="1CO 15:34" /></para>
  <para style="s">Nɛ wǝ́ enyiǝtǝpǝ pǝ lah pa saanǝ pǝ fǝ?</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Enyipǝ rǝ nǝ mǝrǝ pǝ ya pǝ lǝ́ǝ pǝ́ ǝkǝnǝŋ: «Nɛ wǝ́ enyiǝtǝpǝ pǝ lah pa saanǝ pǝ fǝ? Wɛlɛŋrǝ rǝ fǝŋ wǝ́ pǝ lǝ́ǝ lǝmǝ?» Yǝ we ŋ nǝ́ǝ pǝ́ dierǝ sa ǝnǝ we, <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />tuleecitǝyǝ wǝ́ ŋ ri. Ŋlǝ́, vǝ́ a la rʊʊ tuwǝ wǝǝ, ŋkǝ wǝ lǝ́ǝ kpǝ́ kpɛŋ ǝ wǝ ŋ ci ewii? <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Tuwǝ we a la rʊʊ we, wǝ lee ri jiirǝ we le wii wǝ, paa turʊʊwǝ wǝ lǝǝwe, ayɩrɛ dupirǝ amaa turʊʊpʊŋpwawǝ rɛ. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Wǝla kǝmaakǝ we Worokoyǝ ŋ koonu jiirǝ we le wii lǝ wǝlǝkpǝ mǝŋ kǝ́ ŋ nǝ pǝ́ wǝ. Lóo koonu turʊʊ ri ŋ turʊʊ mǝ wǝlǝ wǝlǝkpǝ. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Otuyǝ we kpǝlo yǝ kpii vɔrʊrǝ yǝ lǝǝ lǝmǝ wɛlɛŋrǝ jeŋceŋ. Anyɩmaasɩpǝ mǝ pǝla wɛlɛŋrǝ, akɛɛpǝ mǝ pǝla wɛlɛŋrǝ, ofuripǝ mǝ pǝla wɛlɛŋrǝ mǝ wǝpwɛɛkpǝ mǝ wǝla wɛlɛŋrǝ. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Yulaarǝ lo otuyǝ yǝ kpii wǝ́ kǝtǝǝwǝ la anɛŋyǝ yǝ kpii. Yulaarǝ lo otuyǝ la wǝnyɩɩnɩkpǝ wǝ la cɛkɛlɛ mǝ kǝtǝǝwǝ la wǝnɛŋkpǝ <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Cɔkɔŋyǝ lǝǝmǝ na wǝnyɩɩnɩkpǝ, kɛɛnyɔŋyǝ lǝǝmǝ na wǝnɛŋkpǝ wǝ́ wǝŋɔŋkpǝ wǝ lǝǝmǝ wǝla wǝnɛŋkpǝ. Wǝ́ rǝ wǝŋɔŋkpǝ lǝ mǝrǝ we, wǝla wǝnyɩɩnɩkpǝ wǝ la cɛkɛlɛ mǝ awɛ. <verse eid="1CO 15:41" /><verse number="42" style="v" sid="1CO 15:42" />Kǝ́ wǝ lǝh pǝ lǝ mǝ eniyǝ we enyiǝtǝpǝ pǝ láa saanǝ wǝǝ. Vǝ́ pǝ lǝ fǝ nyiǝtǝyǝ pǝ la ka ŋwaa we, ŋ yɛɛlɩ. Paa vǝ́ la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, lǝŋ tǝ ŋ yɛɛlɩ. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Vǝ́ pǝ la ka ŋwaa nyiǝtǝyǝ we, lǝŋ tǝ ŋ poŋ ayɩrɩ, wǝ́ lǝǝ tǝ ŋ lǝmǝ okopiyǝ rɛ. Paa vǝ́ la saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, ŋ mǝ poŋ ayɩrɩ, ŋ lɛ ŋ lǝmǝ okopiyǝ. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Vǝ́ pǝ la ŋwaa nyiǝtǝyǝ we, o turu na wɛlɛŋpoŋpirǝ wǝ́ pǝ la ŋwaa. Vǝ́ la pa saanǝ lo ru rǝ enyiǝtǝpǝ lǝ mǝrǝ we, o turu le yi mǝ Wɛɛkenikenirǝ la wɛlɛŋrǝ. Kǝto wɛlɛŋpoŋpirǝ gbii, wǝ́ Wɛɛkenikenirǝ la wɛlɛŋrǝ lɛ gbii. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Duturǝ ɖi pǝ la ŋʊrʊ rǝ Worokoŋtierǝ mǝrǝ ǝkǝnǝŋ: «Nyisǝsǝŋyǝ we pǝ lóo pwo Adamǝ we, sìɛrɩ yeli nyɩmaasɩyǝ ŋ kpii vɔrʊrǝ». Paa Adamǝ tǝtǝǝlǝyǝ ŋwǝ paa lǝ lǝ mǝ Wɛɛrǝ we lóo koonu vɔrʊrǝ wǝ. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ŋkǝ Wɛɛkenikenirǝ la wɛlɛŋrǝ lǝ́ǝ pǝ lǝ ŋ coonu wǝ, paa wɛlɛŋpoŋpirǝ lǝ́ǝ pǝ lǝ ŋ coonu wǝ, o turu Wɛɛkenikenirǝ la wɛlɛŋrǝ lǝ pǝ kǝmaamaa. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Pǝ pɔ̀rʊ nyisǝsǝŋyǝ we pǝ ru rǝ kǝtǝǝwǝ, duturǝ ɖi kǝnyaanǝkǝ wǝ́ pǝ fǝ̀ pǝ yàa ŋwǝ. Nyiyitǝyǝ we lo ru rǝ yulaarǝ rǝ. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Ǝkǝtǝǝnyipǝ pǝ lo ru nyiyǝ we pǝ lǝ fǝ kǝnyaanǝkǝ pǝ la yaa wǝ. Kaa wǝǝ enyipǝ we pǝ kpii rǝ yulaarǝ pǝ lo ru nyiyǝ we ŋ no ru rǝ yulaarǝ. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Kǝ́ wǝ ri ǝkǝnǝŋ ŋlǝ yǝ lo ru nyiyǝ we pǝ la yaa mǝ kǝnyaanǝkǝ we, kaa wǝǝ yǝ loh po ko ru yulaarǝ le nyiyǝ we.<verse eid="1CO 15:49" /></para>
  <para style="s">Yuritutururǝ</para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Lǝh ǝtǝŋ, tuwǝ ŋ́ nǝ pǝ́ ŋ́ tɛŋ wǝ kaamǝ ǝkǝnǝŋ lah wɛlɛŋrǝ sa mǝ rǝla ŋpǝrayǝ we, yǝ lǝŋ po koru efii Worokoyǝ le wǝpilirikpǝ mǝrǝ. Tuwǝ we wǝ lǝ́ǝ pǝlǝ we, wǝ lǝŋ koru efii vɔrʊlaalɛɛrǝ mǝrǝ.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Ŋ́ nah pɔrʊ Worokoyǝ lo otuŋwaayǝ we ŋ kaŋ nǝ. Loh kpǝlo yǝ lǝŋ kpǝ́, paa Worokoyǝ láa siɛrɩ loh kpǝlo, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />rǝ enipiyǝ rɛ mǝrǝ, rǝ enimicasimiyǝ mǝrǝ, rǝ kǝpɛrɩtuturukǝ lǝ ǝkpǝǝkǝ mǝrǝ. Duturǝ ɖi vǝ́ pǝ lǝ kpǝǝ kǝpɛrɩtuturukǝ we we, enyiǝtǝpǝ pǝ láa saanǝ pǝ lǝŋ tǝ pǝ kpǝ́, kǝ Worokoyǝ ŋ siɛrɩ lǝh wǝlǝkpǝ. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Duturǝ ɖi wɛlɛŋrǝ sa lǝ́ǝ pǝlǝ we, láa siɛrɩ yee wɛlɛŋrǝ lǝŋ pǝlǝ wǝ, kǝ wɛlɛŋrǝ sa lǝ́ǝ kpǝ́ we ziɛrɩ yee wɛlɛŋrǝ lǝŋ kpǝ́ wǝ. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Vǝ́ wɛlɛŋrǝ we lǝ́ǝ pǝlǝ la siɛrɩ le yee wɛlɛŋrǝ we lǝŋ pǝlǝ, wǝ́ wɛlɛŋrǝ we lǝ́ǝ kpǝ́ la siɛrɩ le yee wɛlɛŋrǝ lǝŋ kpǝ́ we, o lóo turu dierǝ we pǝ la tɛŋ rǝ Wǝŋʊrʊkenikenikpǝ lǝ mǝrǝ lǝ pǝ. Pǝ la tɛŋ ǝkǝnǝŋ:</para>
  <para style="q1" vid="1CO 15:54">«Worokoyǝ le ri gbɛŋrǝ lo yurǝ, wǝ́ ŋ nǝ nǝǝnǝ rǝ!<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />Ŋlǝ́ gbɛŋrǝ, ló yurirǝ we pa?</para>
  <para style="q1" vid="1CO 15:55">Ŋlǝ́ gbɛŋrǝ, lá kǝtɛnɩkǝ we pa?»<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Gbɛŋrǝ la kǝtɛnɩkǝ kǝ kaamǝ turɔɔrɔɔwǝ, wǝ́ seyǝ ŋ nóo koonu turɔɔrɔɔwǝ lo okopiyǝ wǝ. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Paa we kǝ le ceeni Worokoyǝ, ŋwǝ yǝ we ŋ no koonu wǝ́ yǝ le ri yurǝ saŋ rǝ loh Kulǝtǝyǝ Yesu Kǝriso wǝ. <figure style="fig" alt="La trompette" file="hk00190c.tif" size="col" copy="Horace Knowles" ref="15:52">Kǝpɛrɩtuturukǝ we lǝ ǝkpǝǝkǝ</figure><verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Kǝto we lǝh ǝtǝŋ ǝkǝǝtaatǝpǝ, nǝ nyɩɩ kǝ nǝ tɔ nǝ yaa. Nǝ re Kulǝtǝyǝ la anǝnɛyǝ nǝ mǝ ko nǝ paa faŋ. Nǝ ci wǝ ǝkǝnǝŋ anǝnɛyǝ we nǝ ya nǝ nyée yee nyǝ ŋ koonu Kulǝtǝyǝ we, yǝ lǝŋ ri anǝnɛkpaakpaayǝ kʊrakʊra.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Pǝ lǝ kpǝ sɩkayǝ pǝ lo koonu alɔnuŋtǝpǝ la wǝcakukpǝ we rǝ Yerusalɛmǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Ko rǝ gbǝrǝ we le kpii koonu alɔnuŋtǝpǝ we rǝ Yerusalɛmǝ we, ŋnǝ ŋkpɛ nǝ mǝ yee mǝŋ kǝ́ ŋ́ tìi alɔnuŋtǝpǝ kpǝlo kɩɩkɩ la wǝcakukpǝ rǝ fɛɛ ri ŋ fɛɛ rǝ Galatia wǝ. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Kɔsɩra ri ŋ kɔsɩra we, nyi ri ŋ nyi ŋ toolu sɩkayǝ ŋ no koru anya ŋ tǝnǝ, eniyǝ we rɛ lǝŋ pa maa ŋ́ pǝ kpɛŋ kǝ nǝ ci ǝpǝ kpǝ gbǝrǝ. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Vǝ́ ŋ́ ne pe fii we, ŋ́ née kpii enyipǝ we ŋnǝŋnǝ nǝ nya saa nǝ nyáa pɔrʊ, kǝ ŋ́ ŋʊrʊ kǝfwɛɛkǝ ŋ́ koonu pǝ pǝ re pǝ kʊla, kǝ pǝ fǝ otuyǝ we nǝ nyo koonu pǝ ko Yerusalɛmǝ. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Mǝŋ wǝ lǝ pǝ́ kǝ ŋmǝŋmǝ ŋ́ ko we, ŋlǝ mǝ pǝ yǝ láa saŋ lo ko.<verse eid="1CO 16:4" /></para>
  <para style="s">Otuyǝ we Pɔlʊ ŋ ya ŋ nǝ́ǝ pǝ́ ŋ yee wǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ŋ́ náa saŋ rǝ Makedonia ŋ́ pǝ nǝ kpǝŋ. Duturǝ ɖi ŋ́ nǝ pǝ́ ŋ́ fǝ rǝ we kpɛŋ. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Ayɩrɛ ŋ́ neh pe yee eciyǝ rɛ rǝ nǝ kpǝŋ. Wǝ lóo koru eri asiɛniyǝ we kpǝlo lǝ mǝrǝ, kǝ nǝ pa nya fɛɛ nǝ toŋ mǝ ŋ́ saŋ mǝ gʊŋrǝ ŋ́ ko fɛɛwǝ we ŋ́ noh ko wǝ. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Wǝ ǝnǝ we, ŋ́ naa ya ŋ́ nǝ́ǝ pǝ́ ŋ́ pa nyɩŋ nǝ rǝ ko kǝ ŋ́ tǝ mǝ ŋ ko. Mǝŋ Worokoyǝ lo koonu gʊŋrǝ we, ŋ́ neh pe yee eciyǝ rɛ rǝ nǝ kpǝŋ.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Paape ŋ́ née tii rǝ Efeso rǝ sa ko ro Paŋtekotǝyǝ le jirǝ. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Duturǝ ɖi Worokoyǝ la taanǝ gʊŋmumuŋrǝ rɛ lo koonu mǝ kǝ ŋ́ yee mǝ kǝnǝnɛkǝ, wǝ́ ǝkǝǝkpǝlǝtǝpǝ pǝ lɛ pǝ naanǝ.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Vǝ́ Timote le pe fii we, nǝ re ŋwǝ sɩsiɛrɩ kǝ tǝrɛ wǝ pee kpii na awɛɛlɩkǝ. Duturǝ ɖi ya lée yee Kulǝtǝyǝ la anǝnɛyǝ mǝŋ ŋmǝ kǝtǝ. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Nǝ rɛ ŋ paa fʊʊ ŋwǝ ŋ sǝǝlǝ. Eniyǝ we ŋ nah siɛnɩ ŋ pwɛyɩ we, nǝ koonu no otuyǝ yǝ lóo toŋ ŋwǝ rǝ na gʊŋsaŋrǝ, kǝ ŋ nya fɛɛ ŋ po tuu mǝ rǝ wǝtaarǝkpǝ. Duturǝ ɖi ŋlǝ mǝ mǝ ǝtǝŋpǝ la ya yǝ lǝ́ǝ rǝŋ ŋwǝ.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Lah paanʊ Apolo ŋwǝ paa we, ŋ́ náa nyɩɩ mǝ ŋwǝ eni ri ŋ ni kǝ ŋpǝ mǝ apaanʊpʊŋpwaapǝ pǝ nya fɛɛ pǝ pǝ nǝ kpǝŋ, paape laa ya lǝ́ǝ pǝ́ ŋ pǝ rǝkǝsa kʊrakʊra. Paa vǝ́ gʊŋrǝ la pa kpɛɛ ŋwǝ we, lǝ́ǝ pǝ.<verse eid="1CO 16:12" /></para>
  <para style="s">Ecikaŋtuturukǝ mǝ eceenikǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Nǝ tii mǝ ǝrǝŋkǝ kǝ nǝ tɔ nǝ yaa rǝ lɔnuŋrǝ. Nǝ yee kǝpǝrǝŋkǝ, nǝ lɛnyɩ. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Nǝ yee tu ri ŋ tu mǝ kǝtaawǝ. <verse eid="1CO 16:14" /><verse number="15" style="v" sid="1CO 16:15" />Nǝ cii Sitefana mǝ na anyarǝtǝpǝ, ŋpǝ pǝ ri enyisǝsǝŋpǝ pǝ lɔ̀ Kǝriso pǝ nunu rǝ Akayi la gaarǝ we wǝ. Pǝ lǝ fǝ pǝ la tɛɛ rǝ pǝla wɛ kǝ pǝ ŋ toŋ lǝh ǝtǝŋ tuturupǝ we. Lǝh ǝtǝŋ, ŋ́ ya ŋ́ nǝ́ǝ pǝ́ mǝ ŋ ru rǝ nǝ akaakǝ <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />nǝ mǝ co kǝtukoŋkǝ rǝ ŋpǝ enyipǝ sa wǝrʊʊkpǝ mǝ epǝ we kpǝlo pǝ ya pǝ lée yee anǝnɛyǝ mǝ pǝ, wǝ́ pǝ láa nyɩɩ pǝ ŋ kʊla mǝ pǝ wǝ.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Ŋ́ ya ŋ́ náa nya faawǝ rǝ Sitefana, Fɔrǝtunato mǝ Akayiko lǝ ǝpǝkǝ. Ŋpǝ pǝ lo po koonu mǝ otuyǝ rǝ nǝ yuwǝ, mǝ kǝ́ nǝ nyee kpii wǝ. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Duturǝ ɖi pǝ la pa ta mǝ turuwǝ, wǝ́ pǝ la lɛ pǝ la ta ŋnǝ ŋkpɛ nǝ turuwǝ. Nǝ ci kǝ́ nǝ nyóo pu enyipǝ sa wǝrʊʊkpǝ nǝ fǝ wǝ.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Alɔnuŋtǝpǝ la acakuyǝ we yǝ kpii rǝ Azi lǝ gǝŋrǝ yǝ lée ceeni nǝ. Akila mǝ Pǝrisǝka mǝ asʊmatǝpǝ we kpǝlo pǝ lóo ku rǝ pǝlǝ kpǝŋ pǝ lée ceeni nǝ sɩsiɛrɩ rǝ Kulǝtǝyǝ lǝ mǝrǝ. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Lǝh ǝtǝŋpǝ we kpǝlo pǝ kpii rǝ ɖǝǝnǝ pǝ lée ceeni nǝ. Nǝ ceeni awɛ sɩsiɛrɩ mǝ kǝǝtaawǝ mǝŋ apaanʊpǝ mǝ apaatɛpǝ kǝtǝ. <verse eid="1CO 16:20" /><verse number="21" style="v" sid="1CO 16:21" />Ŋmǝ Pɔlʊ ŋ́ nǝ fǝ mǝ akaakǝ ŋ́ na ŋʊrʊ eceenikǝ sa. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Mǝŋ rɛ lǝŋ taa Kulǝtǝyǝ lǝ kǝǝwǝ we, Worokoyǝ ŋ fwɛɛrɩ ŋwǝ! Kulǝtǝyǝ, mǝ pǝ! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Ŋ́ náa taa nǝ kpǝlo lǝ kǝǝwǝ rǝ Yesu Kǝriso mǝrǝ.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>