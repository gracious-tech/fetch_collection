<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">Akebou: La Bible en akébou</book>
  <para style="h">1 Etesalonikatǝpǝ</para>
  <para style="toc3">1Et</para>
  <para style="toc2">1 Etesalonikatǝpǝ</para>
  <para style="toc1">Pɔlʊ la kǝfwɛɛsǝsǝŋkǝ we ŋ na ŋʊrʊ ŋ na maŋ Etesalonikatǝpǝ wǝ</para>
  <para style="mt2">Pɔlʊ la kǝfwɛɛsǝsǝŋkǝ we ŋ na ŋʊrʊ ŋ na maŋ</para>
  <para style="mt1">Etesalonikatǝpǝ</para>
  <para style="imt">Ŋwaataanǝtierǝ</para>
  <para style="ip">Pɔlʊ tǝ̀nǝ zʊmarǝ rǝ Tesalonika mǝ eniyǝ we ŋ sanǝ gʊŋrǝ kǝyitǝkǝ koonu Worokoŋtietɛŋtɛlɩrǝ wǝ. Rù rǝ tǝŋtǝǝwǝ we pǝ lóo pwo Filipi kolu Tesalonika. Makedonia la gaarǝ we lǝ tǝŋtǝǝmumuŋwǝ wǝ kaamǝ Tesalonika. Oyudatǝpǝ pǝ ka naanǝ rǝ tǝŋtǝǝwǝ sa. Pǝla arɛɛpǝ pǝ laa lɔ Pɔlʊ lo otukaŋyǝ sa, wǝ́ pǝ pìri ŋwǝ. Wǝ́ ŋ ko ŋ ko tǝŋtǝǝwǝ we pǝ lóo pwo Bere. Pɔlʊ ke kpii rǝ Korɛŋto wǝ́ Timote ŋ pǝlǝ ŋ pɔ̀ na amayǝ ŋ rù rǝ kǝ́ asʊmatǝpǝ we rǝ Tesalonika pǝ ya pǝ láa sʊma pǝ ŋ fǝ wǝ. Fɛɛwǝ ŋpǝ mǝ Timote mǝ Silasǝ pǝ ŋʊ̀rʊ kǝfwɛɛsǝsǝŋkǝ sa pǝ manǝ pǝ wǝǝ.</para>
  <para style="ip">Rǝ kǝfwɛɛkǝ sa lǝ mǝrǝ we, Pɔlʊ ya láa ta asʊmatǝpǝ we pǝ kpii rǝ Tesalonika lo turuwǝ, kǝ pǝ tɔ pǝ yaa rǝ Kǝriso mǝrǝ. Tǝ ya lée kpii pǝla wɛɛlɛŋwǝ kǝ pǝ nyɩɩ pǝ ŋ yee anǝnɛyǝ, eniyǝ we pǝ lóo koru pǝla wɛ lo yurǝ la ayɩrɩ kǝ pǝ paa nya fɛɛ pǝ yee eleeyǝ pǝ koonu rɛ. Pɔlʊ la lɛ lo koonu kǝkpǝŋkǝ sa lǝ kpǝkpǝlǝŋkuŋwǝ ru rǝ etieyǝ rɛ yǝ ya yǝ lée kpii pǝ la kǝwɛɛlɩkǝ wǝ. Ŋyǝ etieyǝ we yǝ kaamǝ: Enyiǝtǝpǝ la asaanǝkǝ mǝ Yesu la asiɛnɩpǝkǝ.</para>
  <para style="ip">Yǝ lóo koru ǝsǝpǝ kǝfwɛɛkǝ sa la saŋ eni:</para>
  <para style="io">- Ŋwaataanǝtierǝ 1:1</para>
  <para style="io">- Worokoyǝ le eceenikǝ mǝ nǝ ǝkǝkǝ 1:2–3:13</para>
  <para style="io">- Ecikaŋkǝ ru rǝ ekǝrisotǝpǝ lǝ wǝlǝkpǝ 4:1-12</para>
  <para style="io">- Otukaŋyǝ ru rǝ Kǝriso la asiɛnɩpǝkǝ 4:13–5:11</para>
  <para style="io">- Ecikaŋtuturukǝ 5:12-22</para>
  <para style="io">- Dierǝ la gʊʊcarǝ 5:23-28</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">Pɔlʊ ya lée ceeni ekǝrisotǝpǝ we pǝ kpii rǝ Tesalonika wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Ŋmǝ Pɔlʊ, ŋlǝ mǝ Silasǝ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Silasǝ yǝ sa wǝ́ pǝ lóo pwo mǝ Kǝhelatǝkǝ ǝkǝnǝŋ Silǝvɛŋ.</char></note> mǝ Timote, yǝ la ŋʊrʊ yǝ la maŋ asʊmatǝpǝ we pǝ kpii rǝ Tesalonika wǝ. Asʊmatǝpǝ sa pǝ ri Worokoyǝ we ŋ ri Tǝyǝ mǝ Kulǝtǝyǝ Yesu Kǝriso la anɛŋ. Worokoyǝ ŋ yee nǝ lɛsiɛrɩwǝ kǝ ŋ koonu nǝ wǝtaarǝkpǝ.<verse eid="1TH 1:1" /></para>
  <para style="s">Pɔlʊ ya lée ceeni Worokoyǝ rǝ Etesalonikatǝpǝ la lɔnuŋrǝ kǝto</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Eni ri ŋ ni, yǝ lée ceeni Worokoyǝ rǝ nǝ kpǝlo kɩɩkɩ lo yurǝ. Wǝ́ yǝ láa lɛ yǝ ŋ taalǝ nǝ rǝ loh onyuŋmwɛŋyǝ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Eni ri ŋ ni rǝ lǝh Tǝ Worokoyǝ la kǝnyɩŋkǝ we, yǝ láa taalǝ nǝ lɔnuŋrǝ la anǝnɛyǝ mǝ nǝ kǝǝtaawǝ la anǝnɛyǝ. Wǝ́ yǝ láa lɛ la ŋ taalǝ nǝ atɔyaakǝ rǝ Kulǝtǝyǝ Yesu Kǝriso lǝ ǝrǝŋkǝ mǝrǝ. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Lǝh ǝtǝŋ, le cii wǝ ǝkǝnǝŋ Worokoyǝ láa taa nǝ kǝǝwǝ, wǝ́ ŋ na saa nǝ ŋ na pɔrʊ kǝ nǝ ri na anɛŋpǝ. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Duturǝ ɖi Dieceeceerǝ we lǝ pǝlǝ la tɛnɩ le tìi nǝ we, wǝ lee ke ri ǝkǝnǝŋ dierǝ rǝ ko wǝ la tɛnɩ! Paa la tɛnɩ rǝ mǝ okopiyǝ. Wɛɛkenikenirǝ donu lǝ, wǝ́ lǝ fǝ̀ kpɛɛtɛɛmumuŋwǝ rɛ la tɛnɩ rǝ. Mǝŋkǝ nǝ cii kǝ́ le rè lah wɛ lǝ fǝ rǝ nǝ mǝrǝ, kǝ wǝ nya fɛɛ wǝ toŋ nǝ wǝ. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Ŋnǝ we, nǝ nye siimǝ lah wǝkparǝtǝnǝkpǝ mǝ Kulǝtǝyǝ la wǝkparǝtǝnǝkpǝ. Mǝŋ nǝ acʊcʊʊrʊpiyǝ paape nǝ lɔ̀ Dierǝ sa mǝ faawǝ we Wɛɛkenikenirǝ lóo koonu wǝ. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Mǝŋkǝsa we, nǝ nya siɛrɩ nǝ nye yee tufǝcamǝwǝ nǝ nyo koonu alɔnuŋtǝpǝ we kpǝlo kɩɩkɩ pǝ kpii rǝ Makedonia mǝ Akayi wǝ. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Duturǝ ɖi we, nǝ kpǝŋ wǝ́ Kulǝtǝyǝ le Dierǝ sa lo ru la yaarǝ lo ko Makedonia mǝ Akayi. Tǝ fǝ kʊla we, kǝ́ nǝ nya lɔ Worokoyǝ nǝ nyo nuŋ we, enyipǝ pǝ lo nuŋ wǝ rǝ fɛɛ ri ŋ fɛɛ. Kǝto wǝ lǝǝ tǝ wǝ pǝ́ la wɛɛlɩ lo ru rǝ nǝ lɔnuŋrǝ sa. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Nyi ri ŋ nyi lóo co tɛɛrɩwǝ mǝ ŋ ru rǝ nǝ, wǝlǝkpǝ we nǝ fǝ̀ nǝ lɔ̀ lǝ sɩsiɛrɩ kǝ́ lǝ pǝlǝ nǝ kpǝŋ wǝ, mǝŋ kǝ́ nǝ nyǝ sǝ́ŋ afɛɛyǝ nǝ nyo co wǝ́ nǝ nya siɛrɩ nǝ nyǝ pǝ Worokoyǝ lǝ kpǝŋ, ŋwǝ yǝ we ŋ ri Worokopoŋpiyǝ ŋ kpii vɔrʊrǝ wǝ. <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />Nǝ ya nǝ nyǝ́ǝ rǝŋ ne Pi Yesu ŋ ru rǝ yulaarǝ ŋ pǝ. Ŋwǝ wǝ́ Worokoyǝ ŋ na saanǝ ŋ no ru rǝ enyiǝtǝpǝ lǝ mǝrǝ wǝ. Ŋwǝ ŋ náa pɔrʊ lǝ ŋ ru rǝ Worokoyǝ la kpɛɛmʊrʊwǝ sa wǝ lo furu wǝ.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Pɔlʊ la anǝnɛyeeyǝ rǝ Tesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Lǝh ǝtǝŋ, ŋnǝŋnǝ nǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ ŋlǝ yǝ lǝǝ pǝ nǝ kpǝŋ lo co. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Nǝ lɛ nǝ cii wǝ ǝkǝnǝŋ enyipǝ pǝ pìeeli lǝ rǝ Filipi wǝ́ pǝ lɛ̀ pǝ fɛ̀ɛpɩ lǝ. Paape Worokoyǝ kòonu lǝ turusǝŋwǝ ŋlǝ la tɛŋ ne Dieceeceerǝ sa le tíi nǝ, mǝŋ kǝ́ enyipǝ pǝ yili pǝ tɛ̀ɛ rǝ lǝ wǝ. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Duturǝ ɖi, vǝ́ la ya yǝ lée tíi enyipǝ ǝkǝnǝŋ pǝ lɔ Dieceeceerǝ sa we, ŋkǝ kǝnyitǝǝnǝkǝ kǝ lǝǝwe! Ŋkǝ yǝ lo pu yurɔɔrɔɔrǝ rɛ rǝ. Wǝ́ yǝ laa ya yǝ lǝ́ǝ tǝǝnǝ rɛ mǝ wǝpiekpǝ! <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Paa Worokoyǝ le tie lǝ la yɩrɩ, wǝ́ ŋ na tɛɛ kpɛɛwǝ rǝ lǝ. Wǝ́ ŋ nǝ fǝ ne Dieceeceerǝ sa ŋ no koonu lǝ la tɛŋ. Kǝto ŋkǝ yǝ láa tɛŋ Dierǝ sa kǝ lo poŋ mǝ enyipǝ rǝ! Paa yǝ láa tɛŋ rǝ kǝ lo poŋ mǝ Worokoyǝ we ŋ náa nyɩŋ ǝrǝ lah ziɔŋrǝ mǝrǝ wǝ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Nǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ ŋlǝ la faa wɛɛlɩ lǝ tǝǝnǝ enyipǝ la nyɩŋ pwi. Wǝ́ yǝ laa lɛ lo pu yurǝ ǝkǝnǝŋ ŋlǝ yǝ láa mwɛɛrɩ nǝ otulǝmǝyǝ le nimirǝ pwi. Worokoyǝ ŋ ri lah ɖaŋsielǝtǝyǝ! <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Yǝ laa lɛ lǝ pǝ́ rɛ ŋ kǝ lǝ, wǝ ke ri ŋnǝ amaa enyipʊŋpwapǝ rɛ! <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />Lo koh koru anya okopiyǝ rǝ nǝ oŋuŋkǝ paa, duturǝ ɖi Kǝriso le enyikpiipǝ wǝ́ le ri. Paape kǝ́ le ke kpii mǝ nǝ we, lǝ fǝ̀ kǝǝtaawǝ le rè nǝ mǝŋ kǝ́ leeyǝ ŋ náa yɩrɩ ne epipǝ lo yurǝ kǝtǝ. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />La tàa nǝ kǝǝwǝ ŋpa. Kǝto lǝ fǝ̀ la tɛ̀ɛ rǝ lah wɛ, ŋkǝ kǝ la tɛŋ Worokoyǝ le Dieceeceerǝ we ceŋceŋ ko le tíi nǝ! Paa kǝ lǝ fǝ mǝŋ ŋlǝŋlǝ lah vɔrʊrǝ lo koonu rǝ nǝ yuwǝ. Duturǝ ɖi nǝ pǝlǝ nǝ yeli enyipǝ pǝ la lɔ̀ okuruyǝ ŋpa nǝ kòonu lǝ.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />Lǝh ǝtǝŋ, nǝ nyáa taalǝ lah anǝnɛyǝ mǝ lah vaŋrǝ! Le ke ŋ yee anǝnɛyǝ mǝŋ dumu mǝŋ jɔkɔŋ kǝ la paa nya fɛɛ le yee eleeyǝ la tɛɛ rǝ nǝ rɛ, mǝ eniyǝ we la ka ŋ tɛŋ Worokoyǝ le Dieceeceerǝ we le ŋ tìi nǝ wǝ. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Nǝ ri lah araŋsielǝtǝpǝ wǝ́ Worokoyǝ ŋwǝ ŋkpɛ ri lah ɖaŋsielǝtǝyǝ! Wǝlǝkpǝ le rè lah wɛ rǝ ŋnǝ alɔnuŋtǝpǝ lǝ kpǝŋ we, wǝ ka kʊʊ. Wǝ́ rɛ lǝŋ koru anya tǝrɛ ŋ tɔɔ lǝ bɔrǝ. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Nǝ lɛ nǝ cii wǝ ǝkǝnǝŋ, ŋlǝ yǝ lǝ fǝ nyi ri ŋ nyi rǝ nǝ mǝrǝ mǝŋ kǝ́ tǝyǝ ŋ née yee mǝ epipǝ kǝtǝ. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Yǝ le ci yǝ la kaŋ nǝ, wǝ́ yǝ la ta nǝ turuwǝ. Wǝ́ yǝ la tɔɔ yǝ la kpɛɛ nǝ kpuŋkpuruŋ nǝ tii vɔrʊrǝ lóo poŋ mǝ Worokoyǝ wǝ, ŋwǝ yǝ we ŋ ya ŋ nóo pwo nǝ koonu ne wǝpilirikpǝ mǝ na wǝnyɩɩnɩkpǝ wǝ.<verse eid="1TH 2:12" /></para>
  <para style="s">Etesalonikatǝpǝ pǝ la lɔ Worokoŋtierǝ sɩsiɛrɩ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Tuwǝ rɛ ceŋceŋ kǝto wǝ́ yǝ lǝŋ wɛɛ mǝ Worokoyǝ le eceenikǝ wǝ. Ŋ wǝ wǝ ri ǝkǝnǝŋ: Kǝ́ nǝ nyo nuŋ Worokoŋtierǝ we yǝ la tɛŋ yǝ le tíi nǝ we, nǝ nyaa lɔ rǝ mǝŋ nyɩmaasɩyǝ le dietɛŋrǝ rɛ ko, paa nǝ nya lɔ rǝ mǝŋ Worokoyǝ le dierǝ. Wǝ́ kǝceece Worokoyǝ le dierǝ lǝǝwe. Wǝ́ ya lée yee anǝnɛyǝ rǝ nǝ, ŋnǝ epǝ we nǝ ri alɔnuŋtǝpǝ wǝ. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Lǝh ǝtǝŋ, tuwǝ we wǝ pǝlǝ wǝ tùu Worokoyǝ la asʊmayǝ we yǝ la lɔ Yesu yǝ lo nuŋ, wǝ́ yǝ kpìi rǝ Yudeya we, ŋ wǝ kpaŋ wǝ lǝ pǝ wǝ lo tuu nǝ wǝ. Nǝ nya cʊʊrʊ rǝ ŋnǝŋnǝ nǝ ǝtǝŋtǝǝtǝpǝ la wǝkaakpǝ. Kǝ́ asʊmayǝ sa yǝ ŋkpɛ yǝ cʊ̀ʊrʊ rǝ Oyudatǝpǝ la wǝkaakpǝ wǝǝ! <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />Ŋpǝ Oyudatǝpǝ sa pǝ wʊlʊ Kulǝtǝyǝ Yesu mǝ oworokokpɛɛnuŋtɛŋtɛpǝ wǝ. Wǝ́ pǝ le pieeli lǝ ŋla ŋkpɛ! Pǝ lǝŋ pǝ́ pǝ poŋ mǝ Worokoyǝ. Wǝ́ pǝ le yee enyipǝ kpǝlo kɩɩkɩ lǝ ǝkǝǝkpǝlǝtǝpǝ! <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />Pǝ ya pǝ lǝ́ǝ sǝŋ lǝ gʊŋrǝ kǝ la paa nya fɛɛ la tɛŋ dierǝ we le tíi epǝ we pǝ lee ri Oyudatǝpǝ kǝ pǝ nya alɔkuŋkǝ. Mǝŋkǝsa we, ŋpǝ Oyudatǝpǝ sa pǝ ya pǝ lóo koonu ŋpǝŋpǝ pǝlo oturɔɔrɔɔyǝ we pǝ lée ce pǝ ŋ yee yǝ ŋ naanǝ kpǝŋwǝ yǝ ŋ kʊla rǝ. Paape rǝ kǝtǝǝlǝkǝ we, Worokoyǝ la kpɛɛmʊrʊwǝ wǝ la pa sʊʊ rǝ pǝ.<verse eid="1TH 2:16" /></para>
  <para style="s">Pɔlʊ lǝ pǝ́ ŋ tǝ ŋ ka nyɩŋ alɔnuŋtǝpǝ we pǝ kpii rǝ Tesalonika wǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Lǝh ǝtǝŋ, rǝ lǝh kpǝŋ we, yǝ la pwɛyɩ rǝ nǝ kpǝŋ rǝ eniyǝ rɛ lǝ mǝrǝ ko. Yǝ lǝǝ tǝ la yaa yǝ láa nyɩŋ nǝ mǝ nimirǝ. Paape loh oyupuyǝ yǝ tɛɛ rǝ nǝ! Wǝ ya wǝ láa ca lǝ kpɛɛ ŋpa, lǝ tǝ la pa nyɩŋ nǝ. Wǝ́ la ya yǝ láa fia rǝ wǝlo oŋuŋkǝ kpuŋkpuruŋ. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Kǝto yǝ lǝ pǝ́ lǝ kǝ pǝ la pa yɩrɩ nǝ. Ŋmǝŋmǝ Pɔlʊ ŋ́ nǝ pǝ́ wǝ, kǝpakakpǝpaka! Paape Satana lǝ sǝŋ lǝ wǝla gʊŋrǝ. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Awo! Lah kpɛɛtɛɛwǝ mǝ lah faawǝ wǝ kaamǝ ŋnǝ! Jirǝ we loh Kulǝtǝyǝ Yesu Kǝriso ŋ nǝ́ǝ pǝ we, ŋnǝ nyeh pe ri loh wǝtoomwarakpǝ wǝ. Wǝtoomwarakpǝ we pǝ lóo koonu oyuritǝpǝ wǝ. Rǝ na kǝnyɩŋkǝ we, yǝ láa nya nimifiiwǝ rǝ nǝ yurǝ. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Kǝceece, ŋnǝ nǝ ri leh nimifiiwǝ mǝ lah faawǝ!<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Kǝ́ wǝ ri yǝ lǝŋ tǝ lo koru ayaa lǝ mǝ rǝŋ we, wǝ́ yǝ la nyɩŋ wǝ ǝkǝnǝŋ yǝ lo mumu yǝ le tii rǝ Atɛnǝ ŋlǝ ceceŋ. <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />Wǝ́ yǝ le kpii lah paanʊ Timote yǝ la maŋ nǝ. Lée yee anǝnɛyǝ mǝ Worokoyǝ<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ «lah akɛrɩnǝnɛyeetǝpǝ» wǝ́ wǝrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ «Worokoyǝ la nǝnɛyeetǝyǝ».</char></note> saŋ rǝ Kǝriso le Dieceeceerǝ we la atɛŋkǝ. Yǝ lǝ pǝ́ ŋ pe kpii nǝ lɔnuŋrǝ lo okopiyǝ, kǝ ŋ lɛ ŋ ta nǝ turuwǝ. <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />Mǝŋkǝsa we, kǝ nǝ rɛ ŋ paa maa ruŋruŋ la acʊcʊʊrʊpiyǝ sa yǝ re ŋwǝ yǝ co. Ŋnǝŋnǝ nǝ cii wǝ ǝkǝnǝŋ yǝ kʊla rǝ Worokoyǝ lo yupurǝ we ŋ lǝǝmǝ ŋ ru rǝ lǝ wǝ. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Kǝ́ le ke kpii rǝ nǝ kpǝŋ we, le tìi nǝ wǝ lo còonu ǝkǝnǝŋ yǝ lah pa cʊʊrʊ ŋpa. Ŋ wǝ wǝ lǝ pǝ, wǝ́ nǝ ya nǝ nyáa nyɩŋ ǝnǝ, nǝ cii wǝ! <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Kǝ́ wǝ ri ŋ́ nǝǝ tǝ ŋ́ koru ǝrǝŋ we, ŋ wǝ kǝto wǝ́ ŋ́ ne kpii Timote ŋ́ na maŋ kǝ ŋ pa nyɩŋ kǝ́ nǝ lɔnuŋrǝ lǝ vǝ wǝ. Ŋ́ ya ŋ́ nóo suu vurǝ ayɩrɛ Satana le kpii nǝ gbǝǝrǝ! O koh turu yǝ le yee anǝnɛyǝ yǝ lo co!<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Rǝkǝsa, kǝ́ Timote ŋ no ru rǝ nǝ kpǝŋ ŋ ne pe fii we, le re amaceeceeyǝ la pa pɔ lǝ ru rǝ nǝ lɔnuŋrǝ mǝ nǝ kǝǝtaawǝ. Le tíi lǝ ǝkǝnǝŋ ŋnǝ nǝ tǝ nǝ ya nǝ nyáa taalǝ lǝ sɩsiɛrɩ. Wǝ́ la ya yǝ láa ca nǝ kpɛɛ mǝŋ kǝ́ ŋnǝ ŋkpɛ nǝ ya nǝ nyáa ca lǝ kpɛɛ kǝtǝ. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Lǝh ǝtǝŋ, le kpii rǝ wǝrɔɔrɔɔkpǝ mǝ acʊcʊʊrʊyǝ lǝ mǝrǝ. Paape nǝ lɔnuŋrǝ kǝto we, turuwǝ wǝ la ta lǝ. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Rǝkǝsa we, yǝ lǝ tǝ yǝ la nya vɔrʊrǝ kpiikǝ nǝ nya tɔ nǝ nya yaa rǝ Kulǝtǝyǝ mǝrǝ kǝto. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Yǝ lee ci kǝ́ yǝ leh ceeni Worokoyǝ lǝ fǝ, rǝ nǝ yurǝ! Duturǝ ɖi nǝ nye kpii lǝ faamumuŋwǝ rɛ rǝ na kǝnyɩŋkǝ! <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Mǝŋ dumu mǝŋ jɔkɔŋ, la ya yǝ láa mwɛŋ nyuŋkpǝ kpuŋkpuruŋ ŋ koonu lǝ gʊŋrǝ kǝ lǝ tǝ la pa nyɩŋ awɛ nimi nimi. Eniyǝ we tuwǝ we wǝ lo tuuru nǝ lɔnuŋrǝ we, kǝ lǝ fǝ wǝ la kʊla nǝ. <verse eid="1TH 3:10" /><verse number="11" style="v" sid="1TH 3:11" />Lǝh Tǝ Worokoyǝ ŋwǝŋwǝ mǝ loh Kulǝtǝyǝ Yesu, pǝ re lǝ pǝ pe fii ǝrǝ nǝ kpǝŋ. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Kulǝtǝyǝ ŋ koonu kǝ kǝǝwǝ we nǝ nyáa taa awɛ mǝ kǝǝwǝ we nǝ nyáa taa enyipǝ kpǝlo kɩɩkɩ we, wǝ ŋ ta wǝ ŋ kpii kǝ wǝ lǝ, mǝŋ kǝ́ yǝ láa taa nǝ kǝǝwǝ kǝtǝ. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Kulǝtǝyǝ lée kpii nǝ ziɔŋrǝ lo okopiyǝ, mǝŋkǝsa we, jirǝ we ŋ nǝ́ǝ pǝ ŋpǝ mǝ epǝ we kpǝlo kɩɩkɩ pǝ ri na anɛŋpǝ<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Ŋ nǝ́ǝ pǝ ŋpǝ mǝ ne epicoŋpipǝ».</char></note> we, nǝ nyǝ́ǝ lǝ kenikeni rǝ lǝh Tǝ Worokoyǝ la kǝnyɩŋkǝ. Eniyǝ we pǝ lǝŋ nya tuwǝ pǝ lǝh fǝ pǝ kpaŋ mǝ nǝ!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Vɔrʊrǝ we láa ca Worokoyǝ la kpɛɛwǝ wǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Lǝh ǝtǝŋ, nǝ nya karǝ nǝ nyo ru rǝ lǝh kpǝŋ kǝ́ nǝ nyée tii vɔrʊrǝ nǝ fǝ kǝ wǝ poŋ mǝ Worokoyǝ wǝ. Wǝ́ kǝceece, kǝ́ nǝ ya nǝ nyée yee wǝǝ! Paape yǝ la tɔɔ yǝ la kpɛɛ nǝ rǝ Kulǝtǝyǝ Yesu la nyɩŋrǝ wǝ́ la ya yǝ lée ci yǝ ŋ kaŋ nǝ, nǝ tǝ nǝ mǝ nyɩɩ nǝ mǝ kʊla! <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Duturǝ ɖi nǝ cii Kulǝtǝyǝ Yesu le ecikaŋkǝ we yǝ lo koonu nǝ wǝ! <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Tuwǝ Worokoyǝ ŋ ya ŋ nǝ́ǝ pǝ́ wǝ kaamǝ ǝkǝnǝŋ ŋnǝ nǝ lǝ kenikeni, rɛ ŋ pee yee nuŋruwǝ. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />Nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ ci kǝ́ ŋ náa lɔ tieyǝ ŋ fǝ, rǝ wǝlǝkenikenikpǝ mǝ wǝlǝkpǝ we wǝ kaamǝ wǝ<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Nyi ri ŋ nyi rǝ nǝ mǝrǝ ŋ ci kǝ́ ŋ née re na wɛ ŋ fǝ, kǝ ŋ tii vɔrʊrǝ rǝ wǝlǝkpǝ we wǝ kaamǝ wǝ». </char></note>. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />Rɛ ŋ paa nyarǝ na wɛ ŋ co ŋ koonu kpɛɛcarɔɔrɔɔwǝ mǝŋ kǝ́ epǝ we pǝ lee ci Worokoyǝ pǝ lée yee kǝtǝ. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Rǝ ŋkpǝ wǝlǝkpǝ sa mǝrǝ we, rɛ ŋ paa tɔɔ na kɛrɩyǝ la bɔrǝ amaa rɛ ŋ pǝǝ tǝǝnǝ na kɛrɩyǝ. Yǝ la tɛŋ wǝ yǝ le tíi nǝ, wǝ́ lǝ tǝ la ya yǝ láa tɛŋ wǝ! Kulǝtǝyǝ lah pa ta enyipǝ lo kǝtukoŋkǝ rǝ wǝlǝkpǝ sa kpǝlo kɩɩkɩ lo oŋuŋkǝ. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Duturǝ ɖi Worokoyǝ loo pwo lǝ le pe tii vɔrʊrɔɔrɔɔrǝ rɛ! Paa lo pwo lǝ le pe tii vɔrʊkenikenirǝ. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Kǝto yǝ we ŋ nǝ sǝ́ŋ ecikaŋkǝ sa ŋ no co we, ŋkǝ nyɩmaasɩyǝ wǝ́ ŋ nǝ sǝ́ŋ ŋ no co. Paa Worokoyǝ we ŋ nóo koonu na Wɛɛkenikenirǝ wǝ́ ŋ nǝ sǝ́ŋ ŋ no co.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Mǝŋ rǝ awɛ lǝ kǝǝtaawǝ la kǝtakǝ we, lǝh tǝŋ, wǝ lǝǝ tǝ wǝ pǝ́ kǝ pǝ ŋʊrʊ tǝrɛ pǝ maŋ nǝ! Duturǝ ɖi Worokoyǝ la marǝ la kaŋ nǝ ǝkǝnǝŋ ŋnǝ nǝ taa awɛ lǝ kǝǝwǝ. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Wǝ́ kǝceece nǝ ya nǝ nyáa pɔrʊ ŋ wǝ kǝǝtaawǝ sa nǝ nyǝ ŋ kaŋ lǝh tǝŋ ekǝrisotǝpǝ we pǝ kpii rǝ Makedonia kpǝlo kɩɩkɩ. Paape we, lǝh ǝtǝŋ la ya yǝ lée kpii nǝ wɛɛlɛŋwǝ nǝ tǝ nǝ mǝ nyɩɩ mǝŋkɔɔwe nǝ mǝ kʊla. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />Nǝ nyɩɩ nǝ tii vɔrʊrǝ rǝ wǝtaarǝkpǝ lǝ mǝrǝ. Nyi ri ŋ nyi mǝ ŋ yɩrɩ rǝ na nɛŋwǝ lǝ kpǝŋ. Nǝ yee anǝnɛyǝ mǝ ŋnǝŋnǝ nǝ wǝkaakpǝ nǝ yɩrɩ nǝ wɛ lo yurǝ mǝŋ kǝ́ yǝ le tíi nǝ wǝ yǝ la pa tɛlɩ kǝtǝ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />Mǝŋ nǝ nye re nǝ vɔrʊrǝ ǝnǝ we, epǝ we pǝ lee ri ekǝrisotǝpǝ pǝ loh mǝ pu nǝ. Tǝ fǝ kʊla we, nǝ nyǝŋ pe yee eleeyǝ nǝ tɛɛ rǝ rɛ.<verse eid="1TH 4:12" /></para>
  <para style="s">Worokoyǝ lah pa saanǝ enyiǝtǝpǝ mǝ jitutururǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Lǝh ǝtǝŋ, yǝ lǝ́ǝ pǝ́ nǝ ci anʊkɔrǝyǝ ru rǝ enyiǝtǝpǝ lo tuwǝ. Mǝŋkǝsa we, nǝ nyǝŋ tǝ nǝ ya nǝ mǝ fii gʊʊpirǝ mǝŋ enyipʊŋpwapǝ pǝ lǝǝ lǝmǝ kpɛɛtɛɛwǝ rɛ kǝtǝ. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Yǝ la lɔ yǝ lo nuŋ ǝkǝnǝŋ Yesu lǝ kpǝ́ wǝ́ ŋ na saanǝ ŋ no ru rǝ gbɛŋrǝ. Kǝ́ yǝ lǝ tǝ yǝ la lɔ yǝ lo nuŋ wǝǝ, ǝkǝnǝŋ saŋ rǝ Yesu we, Worokoyǝ lah pa saanǝ epǝ we pǝ lǝ kpǝ́ rǝ Yesu mǝrǝ ŋ kʊla mǝ ŋwǝ Yesu.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />Kulǝtǝyǝ ŋwǝŋwǝ ne dierǝ ŋ na tɛŋ wǝ́ la ya yǝ láa tɛŋ yǝ ŋ tíi nǝ ǝkǝnǝŋ jirǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ we, ŋlǝ epǝ we le kpii vɔrʊrǝ we, yǝ lǝŋ po coŋ lo koonu epǝ we pǝ lǝ kpǝ́ wǝ. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Jirǝ we we, pǝ lóo kuŋ kpɛɛwǝ. Epicoŋpipǝ lo mumuŋyǝ láa ca narǝwǝ, kǝ pǝ lɛ pǝ kpǝǝ Worokoyǝ la kǝpɛrɩkǝ. Eniyǝ we Kulǝtǝyǝ ŋwǝŋwǝ lóo ru rǝ yulaarǝ mǝ ŋ sʊʊ. Alɔnuŋtǝpǝ we pǝ lǝ kpǝ́ rǝ Kǝriso mǝrǝ we, pǝ láa saanǝ kpɛŋ. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Wǝla kǝmaakǝ we, ŋlǝ epǝ we lǝ tǝ le kpii vɔrʊrǝ rǝ eniyǝ we mǝrǝ we, pǝ lǝ́ǝ fǝ lǝ pǝ kʊla mǝ pǝ pǝ ŋ rɛ rǝ aŋɔɔyǝ lo ko ku mǝ Kulǝtǝyǝ rǝ oŋuŋkǝ. Mǝŋkǝsa we, eniyǝ we yǝ le ke tii yǝ la kʊla mǝ Kulǝtǝyǝ kǝkpakǝkpa. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Kǝto we, nǝ fǝ etieyǝ sa nǝ mǝ ta awɛ lo turuwǝ.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">Nǝ kpaka nǝ tii nǝ mǝ rǝŋ Kulǝtǝyǝ lǝ ǝpǝkǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Lǝh ǝtǝŋ, wǝ lǝǝ pǝ́ kǝ rɛ ŋ ŋʊrʊ kǝfwɛɛkǝ ŋ ru rǝ eniyǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ ŋ maŋ nǝ! <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Duturǝ ɖi ŋnǝŋnǝ nǝ cii wǝ sɩsiɛrɩ ǝkǝnǝŋ jirǝ we Kulǝtǝyǝ ŋ nǝ́ǝ pǝ we, loh po somu lǝ rǝ, mǝŋ kǝ́ yɩlayɩtǝyǝ ŋ nóo somu nyiyǝ mǝ dumurǝ kǝtǝ. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Eniyǝ we enyipǝ pǝ lah mǝ tɛŋ ǝkǝnǝŋ: «Yǝ la nya wǝtaarǝkpǝ! Rɛ lǝŋ tǝ ŋ kǝǝnǝ!» Eniyǝ we kpaŋ wǝ́ wǝrɔɔrɔɔkpǝ wǝ lóo somu pǝ kǝtǝrǝceŋceŋ. Wǝ loh po somu pǝ mǝŋ kǝ́ oroonukǝ kǝ lóo somu kuluretǝyǝ kǝtǝ! Pǝ lǝŋ po koru acɛ wǝ! <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Lǝh ǝtǝŋ, paa ŋnǝ we, nǝ nyee kpii rǝ nuŋtumuwǝ kǝ jirǝ we bo somu nǝ mǝŋ yɩlayɩtǝyǝ kǝtǝ. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Nǝ kpǝlo kɩɩkɩ we, wǝnyɩɩnɩkpǝ le enyipǝ wǝ́ nǝ ri. Jɔkɔŋrǝ le enyipǝ wǝ́ nǝ ri. Yǝ lee ri dumurǝ le enyipǝ amaa nuŋtumuwǝ le enyipǝ! <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Kǝto la paa kpɛɛ eniŋrieyǝ mǝŋ enyituturupǝ kǝtǝ. Paa kǝ le tii lǝ mǝ rǝŋ, kǝ la lɛ la ta lah wɛ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Eniŋriekpɛɛtǝpǝ we, dumurǝ wǝ́ pǝ láa kpɛɛ eniŋrieyǝ. Ǝfǝŋŋuŋtǝpǝ we, dumurǝ wǝ́ pǝ lée piemu ǝfǝŋpǝ. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Ŋlǝ paa we, jɔkɔŋrǝ le enyipǝ wǝ́ le ri. Kǝto we, kǝ la ta lah wɛ! Nǝ pǝ kǝ lǝ fǝ lɔnuŋrǝ mǝ kǝǝtaawǝ lǝ kǝrǝŋ lah wɛ mǝŋ kǝ́ nyiyǝ ŋ ne kpii kǝtʊkʊkpakǝ ŋ nǝ kǝrǝŋ na wɛ kǝtǝ. Nǝ pǝ kǝ lǝ fǝ alɔkuŋkǝ lǝ ǝrǝŋkǝ le sii mǝŋ dʊkʊtuurǝ kǝtǝ. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Duturǝ ɖi Worokoyǝ loo pwo lǝ, kǝ ŋ pǝ fǝ kpɛɛmʊrʊwǝ ŋ tɛɛ rǝ lǝ rǝ! Paa lǝ pǝ́ ŋ lɔ ŋ koonu lǝ saŋ rǝ loh Kulǝtǝyǝ Yesu Kǝriso. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Yesu lǝ kpǝ́ rǝ loh yurǝ. Mǝŋkǝsa we, wǝ ke ri yǝ lǝ kpǝ́ oo, wǝ ke ri le kpii vɔrʊrǝ oo, kǝ la nya fɛɛ le ke tii vɔrʊrǝ mǝŋ ŋwǝ. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Kǝto we, nǝ ta awɛ lo turuwǝ, kǝ nǝ kpii awɛ lo okopiyǝ rǝ lɔnuŋrǝ mǝŋ kǝ́ nǝ marǝ nǝ ya nǝ nyée yee wǝ kǝtǝ.<verse eid="1TH 5:11" /></para>
  <para style="s">Ecikaŋtuturukǝ mǝ eceenikǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Lǝh ǝtǝŋ, yǝ la tɔɔ yǝ la kpɛɛ nǝ ǝkǝnǝŋ nǝ pu enyipǝ we pǝ ya pǝ lée yee anǝnɛyǝ rǝ nǝ mǝrǝ mǝŋ eretǝpǝ wǝ. Kulǝtǝyǝ ŋ nǝ fǝ pǝ ŋ no koonu nǝ kǝ pǝ ŋ ci pǝ ŋ kaŋ nǝ. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Nǝ pu pǝ ŋpa, kǝ nǝ lɛ nǝ taa pǝlǝ kǝǝwǝ rǝ kǝnǝnɛkǝ we pǝ ya pǝ lée yee kǝto. Nǝ tii mǝ awɛ rǝ wǝtaarǝkpǝ lǝ mǝrǝ. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Lǝh ǝtǝŋ, lǝ tǝ la ya yǝ láa tɔɔ yǝ ŋ kpɛɛ nǝ ǝkǝnǝŋ nǝ kpaŋ mǝ afanaciyeetǝpǝ<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Wǝŋʊrʊrɛɛkpǝ wǝ la tɛŋ ǝkǝnǝŋ: «Epǝ we la vɔrʊrǝ laa kʊʊ wǝ».</char></note>. Epǝ we pǝ lǝ lǝǝrǝ turutawǝ we, nǝ ta pǝlo turuwǝ. Nǝ toŋ epǝ we pǝ la yɔ wǝ. Nǝ nya lɛtaarǝwǝ mǝ enyipǝ kpǝlo kɩɩkɩ. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Nǝ yee yurǝ, rɛ ŋ pǝǝ fǝ turɔɔrɔɔwǝ ŋ ca turɔɔrɔɔwǝ la kpawǝ! Paa nǝ mǝ yee awɛ le eceeceeyǝ eni ri ŋ ni, kǝ nǝ mǝ yee enyipǝ kpǝlo kɩɩkɩ le eceeceeyǝ.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Nǝ mǝ nya faawǝ eni ri ŋ ni. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Nǝ mǝ mwɛŋ nyuŋkpǝ eni ri ŋ ni <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Tu ri ŋ tu wǝ lǝ́ǝ pǝ we, nǝ ceeni Worokoyǝ. Duturǝ ɖi tuwǝ ŋ ya ŋ nǝ́ǝ pǝ́ mǝ ŋ ru rǝ ŋnǝ epǝ we nǝ nye yee nyiceŋceŋ mǝ Yesu Kǝriso wǝǝ.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Nǝ pǝǝ sǝŋ gʊŋrǝ nǝ koonu Wɛɛkenikenirǝ yee anǝnɛyǝ. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Nǝ pǝǝ fǝ oworokokpɛɛnuŋtɛŋtǝpǝ le etietɛŋyǝ nǝ kpii rǝ kǝpɛŋkǝ. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Paa nǝ tie tu ri ŋ tu nǝ yɩrɩ sɩsiɛrɩ, kǝ nǝ lɔ wǝ we wǝ ponu nǝ re. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Nǝ sǝ́ŋ turɔɔrɔɔ ri ŋ turɔɔrɔɔ. <verse eid="1TH 5:22" /><verse number="23" style="v" sid="1TH 5:23" />Wǝtaarǝkpǝ lo Worokoyǝ ŋwǝŋwǝ ŋ koonu kǝ nǝ yee na anɛŋ fee. Ŋ re nǝ sɩsiɛrɩ, ŋ re nǝ wɛɛrǝ, nǝ kǝrukǝ mǝ nǝ wɛlɛŋrǝ sɩsiɛrɩ. Mǝŋkǝsa we, kǝ rɛ ŋ paa nya bɔtɔɔrǝ rɛ ŋ ru rǝ nǝ jirǝ we Kulǝtǝyǝ Yesu Kǝriso ŋ nǝ́ǝ pǝ wǝ. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Yǝ we ŋ no pwo nǝ we, nʊkɔrǝlǝtǝyǝ wǝ́ ŋ ri, wǝ́ láa lɛ ŋ yee wǝ.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Lǝh ǝtǝŋ, nǝ mwɛŋ nyuŋkpǝ nǝ koonu lǝ. <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />Nǝ ceeni lǝh ǝtǝŋ ekǝrisotǝpǝ kpǝlo kɩɩkɩ sɩsiɛrɩ mǝ kǝǝtaawǝ mǝŋ apaanʊpǝ mǝ apaatɛpǝ kǝtǝ. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Ŋ́ na tɔɔ ŋ́ na kpɛɛ nǝ rǝ Kulǝtǝyǝ la nyɩŋrǝ nǝ kǝ kǝfwɛɛkǝ sa nǝ tíi lǝh ǝtǝŋ ekǝrisotǝpǝ kpǝlo kɩɩkɩ.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Loh Kulǝtǝyǝ Yesu Kǝriso la lɛsiɛrɩwǝ wǝ tii wǝ kʊla mǝ nǝ.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>