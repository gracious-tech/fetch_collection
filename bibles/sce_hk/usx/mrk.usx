  <para style="h">Make Chonjisan Gouxioxi</para>
  <para style="toc1">Make Chonjisan Gouxioxi</para>
  <para style="toc2">Make</para>
  <para style="toc3">Mak</para>
  <para style="mt">Make Chonjisan Gouxioxi</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Xili Gieghasan Yaheiya Moni Zhunbei Giezho</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-9">Luj 3:1-9</ref>, <ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Yah 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Hudai kewon <char style="pn">Ersa</char> Mexihani gouxioxi ingiezhi kaishi giezho. <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/><char style="pn">Isaiya</char> xienzhini shu jiere huaizho,</para>
  <para style="q1" vid="MRK 1:2">"Uzhe, bi qinsi kunne chii melie peizhi</para>
  <para style="q2" vid="MRK 1:2">chii moni zhunbei gieghane.<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Hontande nie kun waradazho,</para>
  <para style="q2" vid="MRK 1:3">'Ezhanni moni zhunbei gie!</para>
  <para style="q2" vid="MRK 1:3">Hhei moni zhidagha!'"<verse eid="MRK 1:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4"/>Zhao ene kielien mutun xili gieghasan <char style="pn">Yaheiya</char> hontande irezhi kunlade xili gieghazhi, "Ta geizhen giendu, Huda tai zuini rouliene." giezhi chonjizhi kieliezho. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/><char style="png">Yudaya</char>ni go orondedu kun, <char style="png">Yelusalen</char>yi kunla man <char style="pn">Yaheiya</char>i hhende echidene zuine renjizhi <char style="png">Yedanhe</char>de <char style="pn">Yaheiya</char>se xili jienliezho. <verse eid="MRK 1:5"/><verse number="6" style="v" sid="MRK 1:6"/><char style="pn">Yaheiya</char> loto noghosunghala giesan jienyi musizhi arasunni pixie pixieliezho. Machazi, shimei ijiezho. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Hhe chonjizhi kieliewo, "Mase khuina irechen kun mase nenli fugie wo. Bi ghodeizhi hhende mahei deizi andaghaseye pei dane. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Bi usughala tai xili gieghazhoma, hhe Shenlinghala tai xili gieghane."<verse eid="MRK 1:8"/></para>
  <para style="s">Ersa Xilini Jienliezho</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3:13-17</ref>; <ref loc="LUK 3:21-22">Luj 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Hhe shihoude <char style="pn">Ersa</char> <char style="png">Jialili</char>ni <char style="png">Nasale</char>se <char style="png">Yedanhe</char>de ire <char style="pn">Yaheiya</char>se xilii jienliewo. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/><char style="pn">Ersa</char> dei ususe khizhese asiman keizhi Shenlin ghoghochen mutun goyai jiere bouzhesei chanlawo. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Ingiedene asiman jierese shenqi irezhi kieliewo, "Chishi bi oresan kewon wo. Bi chade xiqi wo."<verse eid="MRK 1:11"/></para>
  <para style="s">Ibilisi Ersani Shiizho</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13-4:11</ref>; <ref loc="LUK 3:21-22">Luj 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Deigo Shenlin <char style="pn">Ersa</char>i biizhi hontande echighawo. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Hhe hontande souzhi Ibilisi 40 qien shiizho. Yewolase hhantu wo. Qienxienla ushilazho.<verse eid="MRK 1:13"/></para>
  <para style="s">Ersa Jialilide Gouxioxi Chonjizho</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4:1-11</ref>; <ref loc="LUK 4:1-13">Luj 4:1-13</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>
    <char style="pn">Yaheiya</char>i barei echise <char style="pn">Ersa</char> <char style="png">Jialili</char>de ire, Hudai gouxioxini chonjizhi kieliewo, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>"Udu kuruwo. Hudai gojia chadashiwo. Ta geizhen giezhi gouxioxini xianxin gie."<verse eid="MRK 1:15"/></para>
  <para style="s">Tujilani Uruzho</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="LUK 5:1-11">Luj 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>
    <char style="pn">Ersa</char> <char style="png">Jialilihai</char> bienzide yozhi daokude <char style="pn">Ximun</char>, <char style="pn">Ximun</char>ni jiu <char style="pn">Andelie</char> haide on xiaisei chanlawo. Hhelashi zhaghasun bareisan kun wo. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta iredene mii dagha. Bi tai zhaghasun bareiku mutun kun bareichen gholughane." <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Hhela onni deigo jiedene hhei daghawo. <verse eid="MRK 1:18"/><verse number="19" style="v" sid="MRK 1:19"/><char style="pn">Ersa</char> melie gouji yodene pse <char style="pn">Xibitai</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>i jiuni <char style="pn">Yaheiya</char>ni chanlawo. Hhela chon jiere on huduzho. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/><char style="pn">Ersa</char> deigo hhelai uruse hhela <char style="pn">Xibitai</char> adane, pse guisan kunlai chon jiere jiedene <char style="pn">Ersa</char>ni daghawo.<verse eid="MRK 1:20"/></para>
  <para style="s">Zannan Ruhherni Tou Khighazho</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luj 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Hhela <char style="png">Jiabainun</char>de kudene <char style="pn">Ersa</char> hhamuraku udude deigo huitande orozhi kunlade sughazhi kieliezho. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Chenliesan kunla hhe sughasande ghanirazho. <char style="pn">Ersa</char> hhelade sughadan jinwun hanjialai buxian wo, nie qienlitu kunni xianli. <verse eid="MRK 1:22"/><verse number="23" style="v" sid="MRK 1:23"/>Ingiekude hhelai huitande nie kunni zannan ruhher heizho. Waradazhi kieliewo, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>"<char style="png">Nasale</char> kun <char style="pn">Ersa</char>, chi bijienyi jiohoro bu gie. Chi bijienyi widaghale irewu? Chishi kien bikui bi mejiene. Chishi Hudase iresan hhe zhiguitu wo!" <verse eid="MRK 1:24"/><verse number="25" style="v" sid="MRK 1:25"/><char style="pn">Ersa</char> hhei sugiezhi kieliewo, "Amanne menji. Ene kunni jierese khizhe!" <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Zannan ruhher hhe kunni nie tigharagha, fugiede waradadene hhe kunni jierese khizhewo. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Kunla man ghanirazhi nieniedene asazhi kieliezho, "Eneshi yan shiqin wo? Eneshi nie nenlitu, shini daoli wo. Hhe zannan ruhherde minlin xiaise hhei kielienyi chenliene!" <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>Ingie <char style="pn">Ersa</char>i minshen <char style="png">Jialili</char> oronde man chonji keiwo.<verse eid="MRK 1:28"/></para>
  <para style="s">Gientulani Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 4:38-41">Luj 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Hhela huitanse dei khizhe <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char>re hhantu <char style="pn">Ximun</char>, <char style="pn">Andelie</char>tai giede echiwo. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/><char style="pn">Ximun</char>yi ghadunmekieni fashao gie kijiezho. Kunla deigo <char style="pn">Ersa</char>de kieliewo. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/><char style="pn">Ersa</char> hhei shida ire khasei feizhi bosighase fashao giesan daowo. Ingiedene ghadunmekieni hhelai ushilazho.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Khara oluse kunla yanyanji giemeresan kun, sheitan heisan kunlai man <char style="pn">Ersa</char>i shida uduru irewo. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Chenshini kunla man wijien konde hhantulazho. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/><char style="pn">Ersa</char> olon gientulai goudaghawo. Olon sheitanlai tou khighawo. Hhe sheitanlai kielien ese kielieghazho, sheitanla hhei tanine.<verse eid="MRK 1:34"/></para>
  <para style="s">Jialilide Jiomun Chonjizho</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luj 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Khuichuduni eqiemagha ese ogheikude <char style="pn">Ersa</char> bosizhedene hontande echi onxian giezho. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/><char style="pn">Ximun</char> hhantuku kunlarene ereile echiwo. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Ereizhi oludene hhende kieliewo, "Kunla man chii ereizho." <verse eid="MRK 1:37"/><verse number="38" style="v" sid="MRK 1:38"/><char style="pn">Ersa</char> hhelade kieliewo, "Matan psedulade yozhi shidadu aghinlade jiomun chonjiye. Bishi ene shiqinde iresan wo." <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Ingie <char style="png">Jialili</char>ni gochude man yozhi hhelai huitanlade chonjizhi sheitan touzho.<verse eid="MRK 1:39"/></para>
  <para style="s">Pifugientuni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luj 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Nie pifugientu <char style="pn">Ersa</char>i melie ire xiutuliedene xiahua giezhi kieliewo, "Chi duran bise mini ganjinragha shidane." <verse eid="MRK 1:40"/><verse number="41" style="v" sid="MRK 1:41"/><char style="pn">Ersa</char>i zhugheni zholierese khane zhighazhi hhei maqizhi kieliewo, "Bi duran wine. Chi ganjinra!" <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Pifugien deigo likai giese hhe ganjinrawo. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/><char style="pn">Ersa</char> hhei echighakude hende fenfulazhi kieliewo, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>"Chi kiemade yama bu kieliedene echizhi beyene buwade uzhegha. <char style="pn">Musa</char>i shu jiere fenfulasan mutun beyechii ganjinrasande oluzhi Hudade mure ogizhi kunlade ganzhen bei." <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>Hhe kun khireidene olon kielien kieliezhi ene shiqinyi gochude kieliese <char style="pn">Ersa</char> khuinashi mindaminji chenshide echi dazhi zinie hontande wo. Go oronse kunla hhei ereizhi echizho.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Tanhon Giesan Gientuni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luj 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Giedudu daose <char style="pn">Ersa</char> pse <char style="png">Jiabainun</char>de echiwo. <char style="pn">Ersa</char> giedoura bikui kunla sonosudene <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>olon kunla hhantulazhi wijien konde oron goujida uwo. <char style="pn">Ersa</char> hhelade Hudai kielienyi chonjizho. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Nie tanhon giesan gientui jieran kun qienliedene <char style="pn">Ersa</char>i hhende irewo. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Kun olonshi <char style="pn">Ersa</char>i shida qienliezhi echi dazho. Ingie hhe bisan oronni giei nouzii cheizhi chouraghadene ruzi lienqien boughawo. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/><char style="pn">Ersa</char> hhelai xianxin giekui uzhedene tanhon giesan gientude kieliewo, "Gaijiu, chii zuini mienliewo." <verse eid="MRK 2:5"/><verse number="6" style="v" sid="MRK 2:6"/>Giedun jinwun hanjiala hhende sousenu zhughedene sumulazhi kieliezho, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>"Ene kun yangiezhi imutui kieliezho? Hhe kufurei fanjizho! Hudase chugo zuini kien mienliene?" <verse eid="MRK 2:7"/><verse number="8" style="v" sid="MRK 2:8"/><char style="pn">Ersa</char> hhelai zhughenughunyi mejiedene kieliewo, "Ta yangiezhi zhughedene imutui sumulane? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Tanhon giesan gientude chii zuini mienliewo giese sunfan onu, ruzine agisenu yo giese sunfan wo? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Kunnikewon duyade zuini mienlieku qienli bikui tande mejieghane giezho." Ingie tanhon giesan gientude kieliewo, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>"Bi chade kielieye, bosidene ruzine agisenu giedene echi!" <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>Hhe kun bosidene deigo ruzine agi kunlai melieghun khireiwo. Kunla man ghaniradene Hudai kuaizhi kieliezho, "Bijien imutu shiqin uzhezhi ese daozho!"<verse eid="MRK 2:12"/></para>
  <para style="s">Liwini Uruzho</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luj 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>
    <char style="pn">Ersa</char> pse haibienzide echiwo. Kunla man hhei shida irese hhelade sughazho. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/><char style="pn">Ersa</char> melie yose <char style="pn">Yalefei</char>ni kewon <char style="pn">Liwi</char> shui shanjisan oronde sousei chanlawo. Hhende kieliewo, "Chi mii dagha." Ingie hhe bosizhedene <char style="pn">Ersa</char>i daghawo. <verse eid="MRK 2:14"/><verse number="15" style="v" sid="MRK 2:15"/><char style="pn">Ersa</char> <char style="pn">Liwi</char>ni giede ijiekude olon shui shanjisan kun, zuirenla <char style="pn">Ersa</char>, <char style="pn">Ersa</char>i tujilare man hhantu soudene ijienduzho. Imutu kunla olon <char style="pn">Ersa</char>i daghazho. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Falisai kunni jinwun hanjiala <char style="pn">Ersa</char> shui shanjisan kun, zuirenlare hhantu ijiesei chanladene hhe yangiezhi shui shanjisan kun, zuirenlare hhantu ijiezho giezhi tujiladeni kieliezho. <verse eid="MRK 2:16"/><verse number="17" style="v" sid="MRK 2:17"/><char style="pn">Ersa</char> sonosudene hhelade kieliezho, "Gien witu kunla deifu ulie kerene. Gientula deifu kerene. Bi gou kunlai ereile ese irezho, zuirenlai ereile irezho."<verse eid="MRK 2:17"/></para>
  <para style="s">Orozo Bareikui Kieliezho</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luj 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Hhe xienzide <char style="pn">Yaheiya</char>ni tujila, Falisai kunla orozo bareizho. Kunla iredene <char style="pn">Ersa</char>de kieliezho, "<char style="pn">Yaheiya</char>ni tujila, Falisai kunni tujila orozo bareizho. Chii tujila yale orozo ulie bareine?" <verse eid="MRK 2:18"/><verse number="19" style="v" sid="MRK 2:19"/><char style="pn">Ersa</char> hhelade kieliewo, "Ghurunde iresan zhochenla shini khughon bikude matugie orozo bareine? Shini khughon hhelase hhantushi hhela orozo barei danema, <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>shini khughonni kunla lai echiku udu kuzhene. Hhe udude hhela orozo bareine."<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>"Shini popui khuichen jien jiere huduchen kun uwo. Qingiese hudusan shini popu khuichen jienni tanturaghasan pse fugiedane. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Shini jiuni khuichen tulunde zhonlochen kun uwo. Qingie zhonlose shini jiu tulunni ghalughazhi, jiu usuru khizhezhi tulunye qida olune. Shini jiuni shini tulunde zhonlone."<verse eid="MRK 2:22"/></para>
  <para style="s">Hhamuraku Uduni Ezhan</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luj 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Nie hhamuraku udude <char style="pn">Ersa</char> boudei ghazhaghun yozhi daokude tujilani boudei qiorun sidazho. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Falisai kunla <char style="pn">Ersa</char>de kieliezho, "Uzhe, hhela yangiezhi hhamuraku udude ulie giekui giezho?" <verse eid="MRK 2:24"/><verse number="25" style="v" sid="MRK 2:25"/><char style="pn">Ersa</char> hhelade kieliezho, "<char style="pn">Dawude</char>, hhantuku kunlarene oliesukude giesan shiqinyi ta onshizhi ese daowu? <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/><char style="pn">Yabiyata</char> zui fugie buwa danlakude hhe Hudai giede orodene Hudade ogiku ginanyi ijiewo. Pse hhantuku kunladene ogiwo. Ene ginanyi buwase andase kiema ijiezhi ulie olune." <verse eid="MRK 2:26"/><verse number="27" style="v" sid="MRK 2:27"/>Pse hhelade kieliewo, "Hhamuraku udushi kunde giesan wo. Kunshi hhamuraku udude giesan pusho. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Kunnikewonshi hhamuraku uduni Ezhan wo."<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Kha Ghosan Kunni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luj 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>
    <char style="pn">Ersa</char> pse huitande orowo. Hhende nie khani ghosan kun wine. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Kunla <char style="pn">Ersa</char> hhamuraku udude goudaghase zhane giezhi xianxide uzhezho. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/><char style="pn">Ersa</char> khani ghosan kunde kieliezho, "Bosizhedene dunda bei." <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/><char style="pn">Ersa</char> kunlade kieliezho, "Hhamuraku udude gouni giese gou onu, huaini giese gou wo? Aminni jiuinu, heine? Alinie oluzho?" Hhela yama shenqi ese khizhewo. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/><char style="pn">Ersa</char> hokuzhi zhouwine kunlai uzhezho. Hhelai zhughe khidunshi nango giezhi hhe kunde, "Khane khizhegha." giezhi kieliese hhe khane khizheghase khani goudawo. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Falisai kunla khizhi echidene deigo Hherodepai kunlare shanlian giezhi <char style="pn">Ersa</char>i matui widaghane giezho.<verse eid="MRK 3:6"/></para>
  <para style="s">Olon Kun Ersai Daghazho</para>
  <para style="p">
    <verse number="7-8" style="v" sid="MRK 3:7-8"/>
    <char style="pn">Ersa</char> tujilarene likai gie haibienzide echise tebieji olon kunla hhei daghazho. Olon kunla hhe giesan shiqinni sonosudene <char style="png">Jialili</char>, <char style="png">Yudaya</char>, <char style="png">Yelusalen</char>, <char style="png">Itumai</char>, <char style="png">Yedanhe</char>ni dunmien, <char style="png">Tuilo</char>, <char style="png">Xidun</char> zhouwini oronse man hhei shida irezho. <verse eid="MRK 3:7-8"/><verse number="9" style="v" sid="MRK 3:9"/>Kun olonshi jigheidane. <char style="pn">Ersa</char> tujiladene chon nie zhunbei gie giezhi kieliewo. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Ingiekushi <char style="pn">Ersa</char> olon kunyi goudaghawo. Gientula man jigheidazhi hhei maqine giezho. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Zannan ruhherla hhei chanlase chishi Hudai Kewon wo giezhi niefanie papaladene waradazhi kieliene. <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Ingiese <char style="pn">Ersa</char> hhelade hheshi kien bikui bu kielie giezhi hende minlin xiaizho.<verse eid="MRK 3:12"/></para>
  <para style="s">Ersa 12 Gie Shitu Sunghuzho</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luj 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>
    <char style="pn">Ersa</char> ulade khirei, goya zhughe jieredu kunlane uruse hhela hhei shida irewo. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Hhe 12 gie kun sunghudene shitu danlaghawo. Hhelai goyarene chan hhantu beighazhi peidene jiomun chonjighazhi <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>sheitan touku qienli ogine giezho. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Hhe sunghusan 12 gie kunshi <char style="pn">Ersa</char> <char style="pn">Beduru</char> giezhi niere ogisan <char style="pn">Ximun</char> wo, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/><char style="pn">Xibitai</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>ni jiuni <char style="pn">Yaheiya</char> wo. Ene ghualade <char style="pn">Ersa</char> <char style="pn">Banniqi</char> giezhi niere ogiwo. Isishi xinbinni olien tungulieku niekielien wo. <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Pse <char style="pn">Andelie</char>, <char style="pn">Feili</char>, <char style="pn">Badolomai</char>, <char style="pn">Matai</char>, <char style="pn">Doma</char>, <char style="pn">Yalefei</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Datai</char>, Rexinpaini <char style="pn">Ximun</char>, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>pse <char style="pn">Ersa</char>i ghudandusan <char style="png">Jialie</char> kun <char style="pn">Yuda</char> wo.<verse eid="MRK 3:19"/></para>
  <para style="s">Kunla Ersai Biexibu Giezho</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-23">Luj 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>
    <char style="pn">Ersa</char> nie giedoura orowo. Kunla olon hhantulazho. Hhelade ijieku gunfuye uwo. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/><char style="pn">Ersa</char>i gieini kunla <char style="pn">Ersa</char> fenjiulizho giezhi kieliesei sonosudene khizhesenu hhei laizhi echine giezho.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>
    <char style="png">Yelusalen</char>se bouzhesan jinwun hanjiala kieliezho, "Hhei jiere <char style="pn">Biexibu</char> wine. Hhe sheitanni touzii kouizhi sheitan touzho." <verse eid="MRK 3:22"/><verse number="23" style="v" sid="MRK 3:23"/><char style="pn">Ersa</char> hhelai uruzhi ire bilazhi kieliewo, "Ibilisi matugie Ibilisini toune? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Nie gojia goyalane eghinduse hhe gojia bei dane. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Nie giede goyalane eghinduse hhe gie bei dane. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Ibilisi goyalane eghinduse hhela bei dazhi widane. <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/>Kun liliantu kunyi giede orozhi dunxilai qianlane giese xien liliantu kunyi ulie banlase qianla dane. <verse eid="MRK 3:27"/><verse number="28" style="v" sid="MRK 3:28"/>Bi tande shuhua kielieye, kunla fanjisan soyuji zui, hu kieliesanlai man roulienema, <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Shenlinni hu kieliese chanqi ulie rouliene. Zui chanqi wine." <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Ene kielienyi kieliekushi hhela, "Hhei jiere zannan ruhher wine." giezhi kieliezho.<verse eid="MRK 3:30"/></para>
  <para style="s">Ersani Ana Gaijiulani</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luj 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Hhe shihoude <char style="pn">Ersa</char>i anani, gaijiulani iredene ghadane beizhi kunlai <char style="pn">Ersa</char>i urughale echiwo. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Olon kunla <char style="pn">Ersa</char>i izhonde souzho. Ingie <char style="pn">Ersa</char>de kieliewo, "Uzhe, anachii, gaijiulachii, eghechijiulachii ghadane chii ereizho." <verse eid="MRK 3:32"/><verse number="33" style="v" sid="MRK 3:33"/><char style="pn">Ersa</char> hhelade kieliewo, "Kienshi mii ana wo? Kienshi mii gaijiula wo?" <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Zhouwidene sousan kunlai uzhezhi kieliewo, "Uzhe, mii ana, mii gaijiula wo! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Hudai isii zunjizhi giesan kunlashi mii gaijiu, eghechijiu, ana wo."<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Fure Shizhikui Bilazho</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luj 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>
    <char style="pn">Ersa</char> pse haibienzide sughazhi qiiwo. Tebieji olon kunla hhei shida hhantulase hhe haini chon jiere khirei souwo. Kunla man haibienzide wo. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/><char style="pn">Ersa</char> hhelade bilazhi olon sughazho. Sughakudeni hhelade kieliewo, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>"Ta chenliendu, nie kun shizhile echiwo. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Shizhikudeni niezhanla mo jiere luise bunzhula ire ijie agiwo. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Niezhanla tura olon witu tashitu oronde luise tura ninkienshi niazi faizhi ghujin woma, <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>genzi uwoshi naran khizhe nie xiese ghowo. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Pse niezhanla eghesun dunda luise eghesun khizhezhi jigheidase bolu dawo. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Da niezhanla gou ghazhade luise osizhi fugiedadene 30 pei, 60 pei, 100 pei zhonjia souwo." <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/><char style="pn">Ersa</char> pse kieliewo, "Chighin bitu kunla chenliendu!"<verse eid="MRK 4:9"/></para>
  <para style="s">Bilasanni Muji</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luj 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>
    <char style="pn">Ersa</char> niezheghanne bikude daghasan kunla, 12 gie shitu bilasan isii asazho. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/><char style="pn">Ersa</char> hhelade kieliewo, "Hudai gojiai mimii tande mejieghawoma, ghadanedu kunlade bilazhi kieliekushi,<verse eid="MRK 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12"/>'Hhela uzhese minbai olu dane,</para>
  <para style="q2" vid="MRK 4:12">chenliese dunjire dane.</para>
  <para style="q1" vid="MRK 4:12">Pse kharei daorese Huda hhelai zuini mienliekuse ayizho.'"<verse eid="MRK 4:12"/></para>
  <para style="s">Bilasanni Mejieghazho</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="LUK 8:11-15">Luj 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Pse hhelade kieliewo, "Ta ene bilasei mejie danu? Qinse ta soyuji bilasei matugie mejiene? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Fure shizhisan kun shizhisanshi Hudai kielien wo. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Mo bienzide luisanshi kun Hudai kielienyi chenliedene Ibilisi deigo ire sudoro shizhisan kielienyi agi echiwo. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Tashitu oronde luisanshi kun kielienyi chenliedene bayasuzhi deigo jienliewoma, <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>zhughedeni genzi wise niechaku wo. Kielienyi yenyinghala zeinan onu heiku kuzhese deigo furawo. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Eghesun dunda luisanshi kun kielienyi chenliewoma, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>duyai munan gieku, baer miiku, pse duyai yanyanji onxian giekughala kielienyi jigheidazhi yama sou dawo. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Gou ghazhade luisanshi kun kielienyi chenliezhi jienliedene 30 pei, 60 pei, 100 pei zhonjia souwo."<verse eid="MRK 4:20"/></para>
  <para style="s">Igha Douradu Zhula</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luj 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>
    <char style="pn">Ersa</char> pse kieliewo, "Kun zhulai agi irese ighaghala komoronu? Chonban doura jienu? Zhula teiku teizi jiere jiene. <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Niuighasanlai ulie khizheghakui uwo. Ghulazhi giesan shiqinlai ulie khizheghakui uwo. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Chighin bitu kunla chenliendu!"<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>
    <char style="pn">Ersa</char> pse kieliewo, "Ta goude chenliendu, ta kunlade yanghala nanjizhi ogise tandeye yanghala nanjizhi ogine, da olon ogine. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Bichen kunde pse olon ogine. Wichen kunse bisanlainiye agi echine."<verse eid="MRK 4:25"/></para>
  <para style="s">Fure Osikui Bilazho</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>
    <char style="pn">Ersa</char> pse kieliewo, "Hudai gojia kun fureni ghazhade shizhisei xianli. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Xieni kijiene, udu bosine, ene fure matui niazi faizhi osisei hhe kun ulie mejiene. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Ghazhase zhonjia goya osine. Xien niazi faine, khuinashi fugiedazhi qiorun khidene chuduzho. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Zhonjia boluse liendaoghala ghadune. Ghuraku shihou oluwo."<verse eid="MRK 4:29"/></para>
  <para style="s">Caizi Furei Bilazho</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>; <ref loc="LUK 13:18-19">Luj 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>
    <char style="pn">Ersa</char> pse kieliewo, "Hudai gojia yanni xianli? Matan yanghala bilane? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Nie caizi furei xianli. Zemin jiere shizhisan furese zui gaji woma, <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>shizhidene khizhese yan caiseliuzhe fugie wo. Chalani fugiedazhi asiman jieredu bunzhula holiene."<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>
    <char style="pn">Ersa</char> zhao hhela dunjire shidaku mutun bilazhi olon kieliezho. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Bilazhi ulie kieliese hhelade ulie kieliene. Kun widakude tujiladene isii kieliezhi man mejieghazho.<verse eid="MRK 4:34"/></para>
  <para style="s">Ersa Keini Beighazho</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luj 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Hhe xii <char style="pn">Ersa</char> tujiladene kieliewo, "Matan hai duimiende daoye." <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Tujilani olon kunlase likai gie <char style="pn">Ersa</char> sousan chon jiere khireidene hhantu echiwo. Psedu chonlaye hhantu yozho. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Menzhali honfen kei bosidene lan chonni eghizhi chonde usu durune giezho. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/><char style="pn">Ersa</char> chonni khuina zhentouni zhentoula kijie hhunturazho. Tujilani hhei xiereigha kieliewo, "Loushi, bijienyi amin widane giezho! Chi ulie gonjinu?" <verse eid="MRK 4:38"/><verse number="39" style="v" sid="MRK 4:39"/><char style="pn">Ersa</char> xiereidene keini nie sugiezhi haide kieliewo, "Bei! Nanranshi!" Ingiese kei beiwo, fugiede nanranshiwo. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta yangiezhi ayizho? Tande xianxin giekui uwonu?" <verse eid="MRK 4:40"/><verse number="41" style="v" sid="MRK 4:41"/>Hhela fugiede ayizhi nieniedene kieliezho, "Eneshi yan kun wo? Kei, haiye kielienyini chenliene."<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Gelasenni Sheitan Heisan Kunni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:26-39">Luj 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Hhela hai duimienni <char style="png">Gelasen</char> kunyi oronde irewo. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/><char style="pn">Ersa</char> chon jierese bouzhese nie zannan ruhher heisan kun mezase khizhe <char style="pn">Ersa</char>i shida irewo. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Hhe kun chan meza sudoro souzho. Hhei kunla banla dazhi qieshenghalaye han wo. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Kunla niefanie qieshen, jielioghala sozilase qieshenyi denji siraghazhi jielioni zhazhazi gholughane. Kiemada hhei hanshilie dane. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Hhe xieni uduji meza konde, ulade onghonozhi da tashighala goyane zaizho. <verse eid="MRK 5:5"/><verse number="6" style="v" sid="MRK 5:6"/>Hhe gholose <char style="pn">Ersa</char>i chanladene holu ire hhei melie xiutuliedene <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>fugiede waradazhi kieliewo, "Zui Undu Hudai kewon <char style="pn">Ersa</char>, chi mii jiohoro bu gie. Bi Hudai zhiizhi chii xiahua gieye, mii bu zayala!" <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Ingiekushi <char style="pn">Ersa</char> zannan ruhherde ene kunyi jierese khizhe giezhi fenfulazhi daozho. <verse eid="MRK 5:8"/><verse number="9" style="v" sid="MRK 5:9"/><char style="pn">Ersa</char> hhende asawo, "Chii nierei yan giene?" Hhe kieliewo, "Bijien olonshi <char style="pn">Iban</char> giezhi uruzho." <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Hhe <char style="pn">Ersa</char>de oruntanyi hhe oronse bu yolagha giezhi hende xiahua giezho.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Hhe popo jiere idaban khighei ijiezhi souzho. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Zannan ruhher <char style="pn">Ersa</char>de, "Bijienyi khigheilai dunda echighazhi hhelai jiere khigha!" giezhi xiahua giewo. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/><char style="pn">Ersa</char> dain giese zannan ruhher khizhedene khigheilai jiere khiwo. Khigheila egheide chunji bou, haide yenji alawo. Khighei chabudu 2000 wo. <verse eid="MRK 5:13"/><verse number="14" style="v" sid="MRK 5:14"/>Khighei adulasan kunla holu echidene chenshi, aghinlade kieliese kunla yan shiqin fashen giewo giezhi uzhele irewo. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Hhela <char style="pn">Ersa</char>i shida ire uzhese eqighandei "<char style="pn">Iban</char>" sheitan heisan hhe kun jien musizhi jinshen goudazhi souzho. Ingiese hhela ayizho. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Sheitan heisan kunde fashen giesan shiqin, khigheini shiqinyi chanlasan kunla kunlade kieliezho. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Ingiese kunla <char style="pn">Ersa</char>i, "Enense likai gie!" giezhi xiahua giezho. <verse eid="MRK 5:17"/><verse number="18" style="v" sid="MRK 5:18"/><char style="pn">Ersa</char> chon jiere khireikude eqighandei sheitan heisan kun <char style="pn">Ersa</char>i xiahua giezhi hhere hhantulane giese, <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/><char style="pn">Ersa</char> dain ese giezhi hhende kieliewo, "Chi giedene echizhi jiawune kunlade Ezhan chade giesan fugie shiqin, pse matugiezhi ubali xiisei man kielie." <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Hhe kun echidene <char style="png">Jijiapoli</char>de <char style="pn">Ersa</char> hhende giesan fugie shiqinyi chonji qiise kunla man ghanirazho.<verse eid="MRK 5:20"/></para>
  <para style="s">Yalui Oqinji Chusun Usurusan Bierei</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luj 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>
    <char style="pn">Ersa</char> pse chon souzhi hai duimiende daose olon kunla hhei shida hhantulazho. Hhe zhen haibienzide wo. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Nie huitan gonjisan kunyi niereni <char style="pn">Yalu</char> giene. Ire <char style="pn">Ersa</char>i chanladene kon kondei papala <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>hende xiahua giezhi kieliewo, "Mii ga oqin ede duya ijiene giezho. Chi yodene hhei jiere khane teizhi onxian giese hhe goudazhi aminne olune." <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>Ingiese <char style="pn">Ersa</char> hhere hhantu echiwo.</para>
  <para style="p" vid="MRK 5:24">Tebieji olon kunla hhei daghazhi jigheidazho. <verse eid="MRK 5:24"/><verse number="25" style="v" sid="MRK 5:25"/>Nie biereii chusun usurusan gien 12 nien olune. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Deifulai khade olon shouku giezhi bisan baerlane man huai widaghazho. Goujida ese goudadene kharei gundudazho. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Hhe <char style="pn">Ersa</char>i shiqinyi sonosudene kunlai dunda jiaidene <char style="pn">Ersa</char>i khuinase jienni nie maqiwo. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Hhe, <char style="pn">"Ersa</char>i jienni nie maqise gienni goudane." giezhi sumulazho. <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>Ingiese usurusan chusunni deigo beizhi goyane uzhese goudawo. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/><char style="pn">Ersa</char> jieresene nenli khisei deigo mejiedene ochira daozhe kieliewo, "Mii jienni kien maqiwo?" <verse eid="MRK 5:30"/><verse number="31" style="v" sid="MRK 5:31"/>Tujilani <char style="pn">Ersa</char>de kieliewo, "Imegheni kun jigheidazho. Chi da, 'Kien maqiwo.' giezhi asane." <verse eid="MRK 5:31"/><verse number="32" style="v" sid="MRK 5:32"/><char style="pn">Ersa</char> zhouwidene ene shiqinni giesan biereii uzhene giezho. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Ene bierei jiereni gholusan shiqinyi mejie, ayi pugharazhi <char style="pn">Ersa</char>i melie ire papaladene shuhuane man kieliewo. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/><char style="pn">Ersa</char> hhende kieliewo, "Funi, chii xianxin gieku chii jiuiwo. Pinnande echi, chii gien goudawo."<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>
    <char style="pn">Ersa</char> zhen kieliekude huitan gonjisan kunni giese kunla kieliele irewo, "Oqinchii duya ijiewo. Loushii pse mafan bu giegha." <verse eid="MRK 5:35"/><verse number="36" style="v" sid="MRK 5:36"/><char style="pn">Ersa</char> hhela kieliesei ese gonjidene huitan gonjisan kunde kieliewo, "Bu ayi, zi xianxin gie." <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Ingie <char style="pn">Ersa</char> kunlai ese daghaghadene <char style="pn">Beduru</char>, <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>i jiuni <char style="pn">Yaheiya</char> enela hhantu echiwo. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Hhela huitan gonjisan kunyi giede irese kunla fugiede wilazhi onghonozhi lon chouisei <char style="pn">Ersa</char> chujieghewo. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Sudoro orodene hhelade kieliewo, "Ta yangiezhi lon chouizhi wilazho? Oqin ese duya ijiezho, hhunturazho." <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Ingiese hhela <char style="pn">Ersa</char>i uzhezhi xiniezho. <char style="pn">Ersa</char> hhelai man tou khighadene ada, anaini, daghasan kunlai uduru oqinyi giedera orowo. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Ingie oqinni khai bareidene kieliewo, "Talita kumu!" Isishi oqin, bosizhe giezho. <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Oqin deigo bosizhe yowo. Oqin 12 olune. Kunla hende ghanirazho. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Ersa ene shiqinyi kiemade bu mejiegha giezhi kunlade hende fenfuladene oqinde ijiuni ogi giezhi kieliewo.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Goya Oronni Kunla Ersani Ese Jienliezho</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luj 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>
    <char style="pn">Ersa</char> hhense likai giedene goya orondene irewo. Tujilani hhei daghazho. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Hhamuraku udude <char style="pn">Ersa</char> huitande kunlade sughase kunla chenliedene ghanirazhi kieliewo, "Ene kunde khalase imutu benshi irezho? Hhende ogisanshi yan agheli wo? Hhe matugie imutu nenlitu shiqin giezho? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Eneshi hhe mujian pushonu? <char style="pn">Mereiyen</char>ni kewon pushonu? Gaijiulani <char style="pn">Yagebu</char>, <char style="pn">Yusei</char>, <char style="pn">Yuda</char>, <char style="pn">Ximun</char>, oqinjiulani mai enende uwonu?" Hhela <char style="pn">Ersa</char>de hokuzho. <verse eid="MRK 6:3"/><verse number="4" style="v" sid="MRK 6:4"/><char style="pn">Ersa</char> hhelade kieliewo, "Xienzhini goya oron, goya minzu, goya giese chugo khalaliuzhe zunjine." <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>Hhela <char style="pn">Ersa</char>i xianxin ese giese <char style="pn">Ersa</char> hhende nenlitu shiqinyi olon ese giewo. Zinie giedun gientulai jiere khane teizhi onxian giedene goudaghawo. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Hhela xianxin ese giese <char style="pn">Ersa</char> ghanirawo.</para>
  <para style="s" vid="MRK 6:6">12 Gie Shitulani Peizhi Echighazho</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:1">Mat 10:1</ref>, <ref loc="MAT 10:5-15">5-15</ref>; <ref loc="LUK 9:1-6">Luj 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">
    <char style="pn">Ersa</char> go aghinlai yo baraghazhi sughazho. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/><char style="pn">Ersa</char> 12 gie tujini uru ire ghua ghuaji peizhi echighakude hhelade zannan ruhher touku qienli ogiwo. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/><char style="pn">Ersa</char> hhelade fenfulawo, "Mo yose zhugunse andase ijiuni, kuabao bu barei. Kakade maqie bu barei. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Maheine musidene jien ghua bu barei." <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Pse hhelade kieliewo, "Ta alinie giede orose hhe oronse likai gietula hhe giede sou. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Alinie oronyi kunla tai ulie jienliezhi ulie chenliese hhense likai giekude kon jieredu turane kui boughazhi fandui giezhi zhenmin gie." <verse eid="MRK 6:11"/><verse number="12" style="v" sid="MRK 6:12"/>Shitula khizhi echidene kunlade, "Geizhen gie!" giezhi chonjizho. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Olon sheitanlai tou khighazhi olon gientulai jiere tosun fureizhi goudaghazho.<verse eid="MRK 6:13"/></para>
  <para style="s">Xili Gieghasan Yaheiyani Alazho</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luj 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>
    <char style="pn">Ersa</char>i minshenyi chonji khireise <char style="pn">Hherode</char> honshan sonosuwo. Niezhan kunla kieliezho, "Xili gieghasan <char style="pn">Yaheiya</char> fugudene aminne oluwo. Ingiese ene nenlitu shiqinla hhei jierese khizhezho." <verse eid="MRK 6:14"/><verse number="15" style="v" sid="MRK 6:15"/>Psedu kunla kieliese hheshi <char style="pn">Iliya</char> wo giezho. Da kunla kieliese hheshi melieshiku nie xienzhi wo giezho. <verse eid="MRK 6:15"/><verse number="16" style="v" sid="MRK 6:16"/><char style="pn">Hherode</char> enei sonosudene kieliewo, "Bi qiorunyini pienjisan <char style="pn">Yaheiya</char> aminne oluwo."<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Eqighandei ene <char style="pn">Hherode</char> honshan jiuni <char style="pn">Feili</char>ni bierei <char style="pn">Xiloji</char>ni yenyinghala kun peizhi <char style="pn">Yaheiya</char>i bareidene banlasenu bafanzide khawo. Ingiekushi <char style="pn">Hherode</char> hhe biereii agizho. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/><char style="pn">Yaheiya</char> <char style="pn">Hherode</char>de, "Chi jiune biereii agise ese oluzho." giezhi kieliezho. <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>Ingiese <char style="pn">Xiloji</char> hhei henjizhi alane giezhoma, ala dakushi <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/><char style="pn">Hherode</char> <char style="pn">Yaheiya</char>se ayizho, hhei huizho. Ingiekushi <char style="pn">Yaheiya</char>shi nie gou kun, zhiguitu kun wo. <char style="pn">Hherode</char> hhei kielienyi chenliedene munan giezhoma kielienyini chenliekude xiqi wo. <verse eid="MRK 6:20"/><verse number="21" style="v" sid="MRK 6:21"/>Niudude gou jihui irewo. <char style="pn">Hherode</char>ni olusan udu kuzhese xi beilazhi fugie noyen, buduini lindao, pse <char style="png">Jialili</char>ni lindaolai xinlazhi irewo. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/><char style="pn">Xiloji</char>ni oqin orozhedene wu jiuliwo. <char style="pn">Hherode</char>, xi sousan kunla man bayasuwo. Honshan oqinde kieliewo, "Chi mase yan kerese yan ogiye." <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Pse fayen giezhi kieliewo, "Chi mase yan kerezhi xiahua giese mii gojiani olieliuzhe ogine!" <verse eid="MRK 6:23"/><verse number="24" style="v" sid="MRK 6:24"/>Hhe khizhi echidene anadene asawo, "Bi yan kerene?" Anani kieliewo, "Xili gieghasan <char style="pn">Yaheiya</char>ni qiorunyi kere." <verse eid="MRK 6:24"/><verse number="25" style="v" sid="MRK 6:25"/>Hhe jindazhi orodene honshande kieliewo. "Bi xili gieghasan <char style="pn">Yaheiya</char>ni qiorunyi kerene. Ede hhamusade donjidene made ogi." <verse eid="MRK 6:25"/><verse number="26" style="v" sid="MRK 6:26"/>Honshan hhantu sousan kunlai melie fayen giese hende munan giezhi fura dazho. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Honshan deigo nie binni peidene <char style="pn">Yaheiya</char>i qiorunyi agizhe giezho. Bin echidene bafanzide <char style="pn">Yaheiya</char>i qiorunyi chizhisenu <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>hhamusade donji ire oqinde ogise oqin anadene ogiwo. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/><char style="pn">Yaheiya</char>i tujila enei sonosudene ire beyeini linlasenu mezade teiwo.<verse eid="MRK 6:29"/></para>
  <para style="s">Ersa 5000 Kunde Ijie Chudughazho</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luj 9:10-17</ref>; <ref loc="JHN 6:1-14">Yah 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Shitula <char style="pn">Ersa</char>i shida iredene giesan shiqin, chonjisanlane man hhende kieliewo. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Irewo echiwoji kun olonshi hhelade ijieku gunfuda uwo. Ingiese <char style="pn">Ersa</char> hhelade kieliewo, "Ta ire, matan konkonji hontande yodene niecha hhamuraye." <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Hhela chonni soudene konkonji hontande echiwo. <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>Olon kunla hhela yolasei chanladene hhelai tanidene go chenshise holuzhi hhelase melieshida kuruwo. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/><char style="pn">Ersa</char> chon jierese bouzhese tebieji olon kunlai chanladene ubali xiiwo. Hhela adulachen witu ghonilai xianli. Ingie hhelade olon sughazhi qiiwo. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Khara olune gie tujilani hhei shida ire kieliewo, "Eneshi hontan wo. Shihou udazho. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Kunlai sandaghazhi hhela goyalane zhouwini go oron, aghinlade echidene agizhi ijiele echigieba." <verse eid="MRK 6:36"/><verse number="37" style="v" sid="MRK 6:37"/><char style="pn">Ersa</char> kieliewo, "Ta hhelade ogizhi ijiegha." Tujila kieliewo, "Bijien 200 gie miengughala hhelade ginan agizhi ijieghanu?" <verse eid="MRK 6:37"/><verse number="38" style="v" sid="MRK 6:38"/><char style="pn">Ersa</char> kieliewo, "Tande ginan giedughon wo? Nie uzhele echi." Hhela uzhedene kieliewo, "Tawun ginanji ghua zhaghasun wo." <verse eid="MRK 6:38"/><verse number="39" style="v" sid="MRK 6:39"/><char style="pn">Ersa</char> hhelade fenfulazhi kunlai iban ibanji osuntu oronde sougha giezho. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Kunla iban ibanji souzho. Ibande 100 gie, 50 gie souzho. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/><char style="pn">Ersa</char> tawun ginan, ghua zhaghasunyi barei, asimanyi uzhe Hudade mafan kieliedene ginanyi ghulu keigha, tujiladene ogise tujila kunlai melie teiwo. Ghua zhaghasunyiye kunlade ghughazhi ogiwo. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Dajiala man ijiedene chuduwo. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Hhela feiliesan ginan, zhaghasun zhazhai hhantulaghase 12 gie lanzi zhonlowo. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Ginan ijiesan ere kun 5000 wo.<verse eid="MRK 6:44"/></para>
  <para style="s">Ersa Usu Jiere Yozho</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:15-21">Yah 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>
    <char style="pn">Ersa</char> deigo tujilai biizhi chon jiere khighadene xien hai duimienni <char style="png">Bosaida</char>de echigha goyane olon kunlai sandaghazho. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Hhe hhelai khozhi yolaghadene goyane ula jiere khisenu onxian giele echiwo. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Khara oluse chon hai dunda wo. <char style="pn">Ersa</char> niezheghanne zemin jiere wo. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/><char style="pn">Ersa</char> tujilai uzhese kei shun uwoshi chonni huaizhi chijia no wo. Xieni 3 jiense 6 jienni shihoude hhe haini usu jiere yozhi hhelai hhense daone giezho. <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>Tujila hai jiere hhe yosei chanladene perei wo gie waradazho. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Hhela hhei chanladene ayizho. <char style="pn">Ersa</char> deigo hhelade kieliewo, "Ta zhughelane tei. Bi wo. Bu ayi!" <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/><char style="pn">Ersa</char> hhelare hhantu chon jiere khireise kei beiwo. Hhela hende ghanirazho. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Ingiekushi hhela ginan ijieghasan shiqinyi minbai olu dazho. Zhughelani khidun wo.<verse eid="MRK 6:52"/></para>
  <para style="s">Genisaleni Gientulani Goudaghazho</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Hhela haini daodene <char style="png">Genisale</char>ni haibienzide chonni beighawo. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Chon jierese bouzhese kunla deigo <char style="pn">Ersa</char>i taniwo. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Ingie kunla hhe oronne holu onjighadene <char style="pn">Ersa</char> khala bikui mejiese gientulai ruzide qienlie hhei shida irewo. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/><char style="pn">Ersa</char> ali aghin, chenshi, xiande echise kunla gientulai qienliedene geidoude jiene. <char style="pn">Ersa</char>i xiahua giezhi lien jien ghizhane nie maqigha giezho. Maqisan kunla man goudawo.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Xienrenlai Xigonyi Kieliezho</para>
  <para style="r">(<ref loc="MAT 15:1-20">Mat 15:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Falisai kun, giedun jinwun hanjiala <char style="png">Yelusalen</char>se ire <char style="pn">Ersa</char>i hhende hhantulazho. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/><char style="pn">Ersa</char>i niezhan tujila khane ese wagha ijiesei hhela chanlawo. <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>Falisai kun, soyuji <char style="png">Yutai</char> kunla man xienrenla sughasan xigonyi zunjizho. Khane ulie waghatula ulie ijiene. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Jise irese ulie waghatula ulie ijiene. Hhela da zunjisan xigon olon wo. Beizi, huhu, aduma enelai waghane. <verse eid="MRK 7:4"/><verse number="5" style="v" sid="MRK 7:5"/>Falisai kun, jinwun hanjiala <char style="pn">Ersa</char>de asawo, "Chii tujila yangiezhi xienrenla sughasan xigonni ulie zunjidene khane ulie wagha ijiene?" <verse eid="MRK 7:5"/><verse number="6" style="v" sid="MRK 7:6"/>Ingiese <char style="pn">Ersa</char> kieliewo, "<char style="pn">Isaiya</char> ta jiazhon giesan kunlai zhiizhi melieshida kieliesan ese codazho. Jinwun jiere kieliezho,</para>
  <para style="q1" vid="MRK 7:6">'Ene bexinla amanghalane mii zunjine,</para>
  <para style="q2" vid="MRK 7:6">zhugheni mase gholo wo.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Hhela kunni guijinyi zhenzhenji daoli mutun kunlade sughazho,</para>
  <para style="q2" vid="MRK 7:7">ingiese mii beiise yama oronde uwo.'<verse eid="MRK 7:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8"/>Ta Hudai minlinyi jiezhi kunni xigonyi zunjine." <verse eid="MRK 7:8"/><verse number="9" style="v" sid="MRK 7:9"/><char style="pn">Ersa</char> pse kieliewo, "Ta goya xigonne zunjine giezhi Hudai minlinyi gou banfaghala bendawo. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/><char style="pn">Musa</char>, 'Ada anane zunji, ada anane sugiesan kunni ala.' giezhi kieliezho. <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Ingieliuzhe ta, 'Kun ada anadene bi tande ogi shidakui gurubani giewo.' giezhi kieliese <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>hhe kun ada anadene yama ulie giese olune giezho. (Gurubani isishi Hudade ogikui kieliezho.) <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Ingiezhi ta goya xigonghalane Hudai kielienyi widaghazho. Ta dou intu shiqin olon giezho."<verse eid="MRK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>
    <char style="pn">Ersa</char> pse kunlai uruzhi ire hhelade kieliewo, "Ta man mii kielienyi chenliezhi minbai olu, <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>ghadanese orosan kunyi ulie zannanshighanema, sudorose khizhesan kunyi zannanshighane."<verse eid="MRK 7:15"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>
    <char style="pn">Ersa</char> kunlase likai gie giedoura orose tujilani bilasan isini asazho. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/><char style="pn">Ersa</char> hhelade kieliewo, "Taye minbai olu danu? Ghadanese orosan kunyi ulie zannanshighakui ta ulie mejienu? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Ghadanese orosan kunyi zhughede oro dazhi kielighun mekiende echizho." Ingiezhi kieliezhi ijiekulashi man ganjinni wo giezho. <verse eid="MRK 7:19"/><verse number="20" style="v" sid="MRK 7:20"/><char style="pn">Ersa</char> kieliewo, "Kunyi sudorose khizhesan kunni zannanshighane. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Doghunni sumulakulashi kunyi zhughese khizhezho. Lon kijieku, ghulaku, alaku, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>piofen gieku, tanxin, doghunni, piendaku, hu gieku, dubilieku, sugieku, kondaku, benni wo. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Ene doghun shiqinlashi man kunyi sudorose khizhezhi kunni zannanshighane."<verse eid="MRK 7:23"/></para>
  <para style="s">Niman Biereini Xianxin Gieku</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>
    <char style="pn">Ersa</char> hhense likai giedene <char style="png">Tuilo</char> oronde echi nie giede orowo. Kunlade mejieghaku duran uwoma, ingieliuzhe kunla mejiezho. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Nie biereini oqinyi zannan ruhher heizho. <char style="pn">Ersa</char>i shiqinyi sonosudene ire <char style="pn">Ersa</char>i kon melieni papalawo. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Ene biereishi niman kun wo. <char style="png">Xiliyani-Feiniji</char> minzu wo. Hhe <char style="pn">Ersa</char>i xiahua giezhi oqinyini jierese sheitanyi tou khigha giezho. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/><char style="pn">Ersa</char> hhende kieliewo, "Kesilade xien ijiezhi chudughakuni wo, kesilai ginanyi ga nogheide bendazhi ogise ese oluzho." <verse eid="MRK 7:27"/><verse number="28" style="v" sid="MRK 7:28"/>Bierei kieliewo, "Ezhan, kesila ijiezhi feiliesan zhazhai nogheiye shire doura ijiene." <verse eid="MRK 7:28"/><verse number="29" style="v" sid="MRK 7:29"/><char style="pn">Ersa</char> hhende kieliewo, "Ene nie aman kielienghala chi khareizhi echi. Sheitan chii oqinse likai giewo." <verse eid="MRK 7:29"/><verse number="30" style="v" sid="MRK 7:30"/>Hhe khareizhi echi uzhese sheitan khizhi echizhi oqin chonban jiere kijiezho.<verse eid="MRK 7:30"/></para>
  <para style="s">Dulei Yabani Goudaghazho</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>
    <char style="pn">Ersa</char> <char style="png">Tuilo</char>se likai gie <char style="png">Xidun</char>se daozhi <char style="png">Jijiapoli</char> orondedu <char style="png">Jialilihai</char>de echiwo. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Hhe oronyi kunla dulei yaba gholusan nie kunyi uduruzhi <char style="pn">Ersa</char>i ochirale irewo. <char style="pn">Ersa</char>i xiahua giezhi khane beye jiereni tei giezho. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/><char style="pn">Ersa</char> hhei uduruzhi olon kunse likai giezhi nimande echiwo. Kha ghurunne ghua chighindei teiwo. Ingie nunpudene kielien jiereni moiwo. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Asimanyi uzhezhi nie shanholo hhende kieliewo, "Ifada!" Isishi keii giezho. <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Hhei chighinni deigo keiwo. Kielienni goudazhi kielien kielieseye qinchu wo. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/><char style="pn">Ersa</char> kunlade bu kielie giezhi hhelade fenfulazhoma, ye fenfulase ye chonji keighawo. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Olon kun hende ghuduredene kieliezho, "Hhe giesan shiqinla man gou wo. Duleii sonosughawo. Yabaiye kielien kielieghawo."<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">4000 Kunde Ijie Chudughazho</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Hhe shihoude pse olon kun hhantulase ijiekui uwo. <char style="pn">Ersa</char> tujilane uruzhi ire kieliewo, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>"Ene kunla mare hhantu ghurudu oluzho, hhelade ijiekui widazho. Bi hhelade ubali xiizho. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Bi hhelai oliesuzhi giedei echighase hhela mo jiere injirene. Gholose iresanye wine." <verse eid="MRK 8:3"/><verse number="4" style="v" sid="MRK 8:4"/>Tujilani hhende kieliewo, "Ene hontande imeghei kunlade matugie ginanyi ijiezhi chudughane?" <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/><char style="pn">Ersa</char> hhelade asawo, "Tande ginan giedughon wo?" Hhela kieliewo, "Dolon wo." <verse eid="MRK 8:5"/><verse number="6" style="v" sid="MRK 8:6"/><char style="pn">Ersa</char> olon kunlai fenfulazhi zemin jiere soughadene dolon ginanyi barei mafan kieliedene ghulu tujilade ogise tujila olon kunlai melie beilawo. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Pse hhelade giedun zhaghasun wo. <char style="pn">Ersa</char> mafan kieliedene fenfulazhi kunlai melie beilaghawo. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Hhela ijiezhi chududene feiliesei dolon lanzi zhonlowo. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Hhende chabudu 4000 kun wo. <char style="pn">Ersa</char> hhelani dafalazhi echighawo. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Deigo tujilarene hhantu chon jiere khirei <char style="png">Damanuta</char> oronde echiwo.<verse eid="MRK 8:10"/></para>
  <para style="s">Falisai Kunla Ghudureqi Uzhene Giezho</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Falisai kunla <char style="pn">Ersa</char>i shida ire jianjindu qiiwo. Hhela <char style="pn">Ersa</char>i shiizhi, "Asiman jierese iresan ghudureqi xienjigha." giezhi xiahua giezho. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/><char style="pn">Ersa</char> zhughedene hende nie shanholo kieliewo, "Ene idai kunla yangiezhi ghudureqii kerene? Bi tande shuhua kielieye, ene idai kunlade xienjighaku ghudureqi uwo." <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Ingiedene hhelase likai gie, chon jiere khirei hai duimiende daowo.<verse eid="MRK 8:13"/></para>
  <para style="s">Falisai Kunlani Kuniegheni Fangula</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Tujila ginan bareikui matazho. Chon jiere khireise zinie ginan wo. Pse ijiuni uwo. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/><char style="pn">Ersa</char> hhelade fenfulazhi kieliezho, "Ta Falisai kunni kunieghe, Hherode kunni kunieghei jinxin giezhi fangula." <verse eid="MRK 8:15"/><verse number="16" style="v" sid="MRK 8:16"/>Tujila nieniedene kielienduzho, "Matande ginan wise ingiezhi kieliezhoba." <verse eid="MRK 8:16"/><verse number="17" style="v" sid="MRK 8:17"/><char style="pn">Ersa</char> mejiedene hhelade kieliewo, "Ta yangiezhi ginan wikui kielienduzho? Ta dou mejie dazhi minbai olu danu? Ta dou intu men onu? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Tande nudun wine, uzhe danu? Chighin wine, chenlie danu? Ta jila dazhou? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Tawun ginanyi ghuludene 5000 kunde ogikude zhazhai giedun lanzi zhonlowo?" Hhela kieliewo, "12 gie wo." <verse eid="MRK 8:19"/><verse number="20" style="v" sid="MRK 8:20"/>"Pse dolon ginanyi ghuludene 4000 kunde ogikude zhazhai giedun lanzi zhonlowo?" Hhela kieliewo, "Dolon wo." <verse eid="MRK 8:20"/><verse number="21" style="v" sid="MRK 8:21"/><char style="pn">Ersa</char> kieliewo, "Ta dou minbai olu danu?"<verse eid="MRK 8:21"/></para>
  <para style="s">Bosaidade Sughoni Goudaghazho</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Hhela <char style="png">Bosaida</char>de irewo. Kunla nie sughoi uduruzhi ire <char style="pn">Ersa</char>i xiahua giezhi hhei nie maqi giezho. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/><char style="pn">Ersa</char> sughoi khase laidene aghin ghadane echiwo. Nudun jierei nunpudene ghua khane hhei jiere teizhi, "Chi yan chanlawo." giezhi asazho. <verse eid="MRK 8:23"/><verse number="24" style="v" sid="MRK 8:24"/>Hhe qiorunne qila nie uzhe kieliewo, "Bi kunlai chanlawo. Hhela mutunyi xianli, da yozho." <verse eid="MRK 8:24"/><verse number="25" style="v" sid="MRK 8:25"/><char style="pn">Ersa</char> pse khane nudun jierei teizho. Sugho xianxide uzhese goudadene yanyanjilai qinchude chanlawo. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/><char style="pn">Ersa</char> hhei giedei echighakude, "Aghinde bu echi." giezhi kieliewo.<verse eid="MRK 8:26"/></para>
  <para style="s">Beduru Ersashi Mexiha Wo Giezhi Kieliezho</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luj 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>
    <char style="pn">Ersa</char> tujilarene khidene <char style="png">Kaisaliya-Feilibi</char>ni aghinlade echiwo. Mo jiere tujiladene asazho, "Kunla kieliese bishi kien wo giezho?" <verse eid="MRK 8:27"/><verse number="28" style="v" sid="MRK 8:28"/>Hhela kieliewo, "Kunla kieliese xili gieghasan <char style="pn">Yaheiya</char> wo giezho. Niezhan kunla kieliese <char style="pn">Iliya</char> wo giezho. Pse niezhan kunla kieliese xienzhi dundadu nie wo giezho." <verse eid="MRK 8:28"/><verse number="29" style="v" sid="MRK 8:29"/><char style="pn">Ersa</char> hhelade asawo, "Ta kieliese bishi kien wo?" <char style="pn">Beduru</char> kieliewo, "Chishi Mexiha wo." <verse eid="MRK 8:29"/><verse number="30" style="v" sid="MRK 8:30"/><char style="pn">Ersa</char> orunyi kiemade bu kielie giezhi hhelade hende fenfulawo.<verse eid="MRK 8:30"/></para>
  <para style="s">Ersa Shouku Giekune Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luj 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Ingiedene <char style="pn">Ersa</char> hhelade sughazhi qiiwo, "Kunnikewon matugieseda hende shouku giezhi zhanlao, fugie buwa, jinwun hanjiala mii fandui giezhi alane. Ghurudu oludene aminne olune." <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/><char style="pn">Ersa</char> ene kielienyi mindamin kieliese <char style="pn">Beduru</char> hhei laidene kheila qiiwo. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/><char style="pn">Ersa</char> ochira daore tujilai uzhedene <char style="pn">Beduru</char>i kheilazhi kieliewo, "Ibilisi, mii khuina dao! Chi Hudai isii ulie sumulazhi kunni isii sumulane!"<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>
    <char style="pn">Ersa</char> olon kun, tujilane uruzhi ire kieliewo, "Kien mii daghane giese goyane sheidene shizijiane beiliezhi mii daghakuni wo. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Kien aminne jiuine giese aminne widaghane. Made, gouxioxide oluzhi aminne widaghase aminne jiuine. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Kun duyani man zhenjidene goya aminne widaghase yande gou wo? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Kun pse yanghala aminne arunzhane? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Kien ene piofen giezhi zui fanjisan duyade bi, kieliensemi jiuren giese Kunnikewon Adane fama dunda zhiguitu qienxienlare hhantu irekude hhenseye jiuren giene."<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Bi tande shuhua kielieye, enende beisan kun dunda niezhanla Hudai gojia nenli dunda irekui ulie chanlatula ulie fugune."<verse eid="MRK 9:1"/></para>
  <para style="s">Ula Jiere Ersani Yanzi Bienjizho</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luj 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Zhighudu daose <char style="pn">Ersa</char> <char style="pn">Beduru</char>, <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char>i danxin uduru undu ulade khireidene hhelai melie bienjiwo. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Jienni gon faidene chighande duya jiere popu waghachen kun dunda kiema qingiezhi waghazhi chighashigha dane. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/><char style="pn">Iliya</char>, <char style="pn">Musa</char> <char style="pn">Ersa</char>re kielien kieliesei hhela chujieghewo. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/><char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliewo, "Loushi, matan enende gou wo. Enende ghuran zhanfan daiye. Niei chade, niei <char style="pn">Musa</char>de, niei <char style="pn">Iliya</char>de." <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Ingiekushi hhela hende ayidene <char style="pn">Beduru</char> yan kieliekune ulie mejiene. <verse eid="MRK 9:6"/><verse number="7" style="v" sid="MRK 9:7"/>Niegieda olien iredene hhelai khawo. Oliense shenqi irezhi kieliewo, "Eneshi bi oresan mii kewon wo. Ta hhei kielienyi chenlie!" <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Menzhali tujila zhouwidene nie uzhese kiemai ese chanlawo. Zi <char style="pn">Ersa</char> hhelare hhantuwo.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Ulase boukude <char style="pn">Ersa</char>, "Kunnikewon fugusan kun dundase aminne ulie olutula chanlasei kiemade bu kielie!" giezhi hhelade fenfulawo. <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>Tujila ene kielienyi zhughedene jilasenu, "Fugusanse aminne olune giese yan isi wo." giezhi kielienduzho. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>Hhela <char style="pn">Ersa</char>de asawo, "Jinwun hanjiala yangiezhi <char style="pn">Iliya</char> ijinyo xien irene giezhi kieliezho?" <verse eid="MRK 9:11"/><verse number="12" style="v" sid="MRK 9:12"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Iliya</char> xien iredene man erchan gie goudaghakuni woma, jinwun jiere yangiezhi, 'Kunnikewon olon shouku giezhi kunla hhei uzhe dane?' giezhi huaizho? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Bi tande kielieye, <char style="pn">Iliya</char> shuhuajia irezhoma, jinwun jiere kieliesan mutun kunla hhei shimatu giezho."<verse eid="MRK 9:13"/></para>
  <para style="s">Ersa Sheitan Heisan Kewonni Goudaghazho</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>; <ref loc="LUK 9:37-43">Luj 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Hhela psedu tujilai hhende khareizhi irese olon kunla wiqizhi jinwun hanjiala tujilare jianjindusei chanlawo. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Kunla man <char style="pn">Ersa</char>i chanladene ghudurezho. Ingie holu echi kielien asazho. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/><char style="pn">Ersa</char> hhelade asawo, "Ta hhelare yan jianjinduzho?" <verse eid="MRK 9:16"/><verse number="17" style="v" sid="MRK 9:17"/>Kunlai dundase nie kun kieliewo, "Loushi, bi kewonne uduruzhi chii enende irewo. Hhei yaba sheitan heizho. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Khalaliuzhe sheitan hhei barei agise hhei banjighazhi amansei momozi moine. Shidunne zhouzhi beyeni khiduzhezho. Bi chii tujilade kieliezhi sheitanyi tou khigha giese hhela han wo." <verse eid="MRK 9:18"/><verse number="19" style="v" sid="MRK 9:19"/><char style="pn">Ersa</char> kieliewo, "Ai, ta ene xianxin ulie giechen idaini kunla! Bi tanse rennai giezhi giedoghoncha beine? Kewonni uduruzhi mii enende ire!" <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Hhela kewonni uduru irewo. Sheitan <char style="pn">Ersa</char>i chanlasenu kewonni hende nie tigharaghawo. Kewon zemin jiere unadene ghoghoreizhi amansei momozi moizho. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/><char style="pn">Ersa</char> adadei asawo, "Hhe giemerezhi giedoghoncha oluzho?" Adani kieliewo, "Ga xienzise ingiezho. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Sheitan hhei niefanie khande, usude bendazhi fugughane giezho. Chi gie shidase bijiende ubali xiizhi banman nie gie." <verse eid="MRK 9:22"/><verse number="23" style="v" sid="MRK 9:23"/><char style="pn">Ersa</char> hhende kieliewo, "Gie shidaseshi yan kielien wo? Xianxin giesan kunde yanniliuzhe giene." <verse eid="MRK 9:23"/><verse number="24" style="v" sid="MRK 9:24"/>Ingie adani deigo fugiede kieliewo, "Bi xianxin giene, bi xianxin gie dasei chi made banman gie!" <verse eid="MRK 9:24"/><verse number="25" style="v" sid="MRK 9:25"/><char style="pn">Ersa</char> olon kunla holu iresei chanlasenu zannan ruhheryi sugiezhi kieliewo, "Chi ene dulei yaba sheitan, bi minlin xiaiye, ene kunyi jierese khizhedene pse bu oro!" <verse eid="MRK 9:25"/><verse number="26" style="v" sid="MRK 9:26"/>Sheitan fugiede nie warada kewonni nie tigharaghadene khizhewo. Kewon fugusan niekielien wo. Olon kunla kieliese hhe fuguwo giezho. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/><char style="pn">Ersa</char> hhei khase laidene feizhi bosighase hhe bosizhewo. <verse eid="MRK 9:27"/><verse number="28" style="v" sid="MRK 9:28"/><char style="pn">Ersa</char> giedera orose tujilani konkonji asawo, "Bijien yangiezhi ene sheitanyi khigha dane?" <verse eid="MRK 9:28"/><verse number="29" style="v" sid="MRK 9:29"/><char style="pn">Ersa</char> hhelade kieliewo, "Onxian ulie giese ene izhun sheitanni khigha dane."<verse eid="MRK 9:29"/></para>
  <para style="s">Ersa Duya Ijiezhi Aminne Olukui 2 Hui Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luj 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Hhela hhe oronse likai giezhi <char style="png">Jialili</char>yi daowo. <char style="pn">Ersa</char> kunlade mejieghaku duran uwo. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>Ingiekushi Kunnikewonyi kunlai khade jiuidene hhela alase ghurudude aminne olune giezhi <char style="pn">Ersa</char> tujiladene sughazho. <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>Tujila ene kielienyi dunjire dazho, ayizhi asaye dazho.<verse eid="MRK 9:32"/></para>
  <para style="s">Kien Fugie Wo Giezho</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luj 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Hhela <char style="png">Jiabainun</char>de irese <char style="pn">Ersa</char> giedoura tujilade asawo, "Ta mo jiere yan zhenjinduzho?" <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Tujila shenqi ese khizhezho. Hhela mo jiere kien zui fugie wo giezhi zhenjinduzho. <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/><char style="pn">Ersa</char> sousenu 12 gie tujii uruzhi ire kieliewo, "Kien laoda danlane giese kunlase gajishizhi ushilachen kun danlakuni wo." <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Ingie <char style="pn">Ersa</char> nie kewosii uduru ire hhelai dunda beighadene qioru hhelade kieliewo, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>"Kien mii niereghala intu kewosii jienliese mii jienliezho. Kien mii jienliese mii ese jienliezho, mii peizhi ireghasan hhei jienliezho."<verse eid="MRK 9:37"/></para>
  <para style="s">Fandui Ulie Giese Matande Oluzhi Giezho</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luj 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>
    <char style="pn">Yaheiya</char> <char style="pn">Ersa</char>de kieliewo, "Loushi, bijien nie kunyi uzhese chii niereghala sheitan touzho. Bijien danlazhi ese toughawo. Hhe matanyi ese daghazho." <verse eid="MRK 9:38"/><verse number="39" style="v" sid="MRK 9:39"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Bu danla. Mii niereghala fugie shiqin giedene deigo mii sugiechen kun uwo. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Matanyi fandui ulie giese matande oluzhi giezho. <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Bi tande shuhua kielieye, kien tande tashi Mexihanughun wo giezhi nie beizi usu ogiliuzhe hhende jianli kenjin ogine."<verse eid="MRK 9:41"/></para>
  <para style="s">Kunni Zui Bu Fanjigha</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luj 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>"Kien mii xianxin giesan enezighan ga kun dundadu niei zui fanjighase ghuzhundeni qiemanshai banladene haide bendase da gou wo. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Chii nie kha chii zui fanjighase chizhidene agi! Beyechii canfei gholuzhi chanqi amitukude echiku ghua kha bidene dozode, ulie xinieku khande orokuse gou wo. <verse eid="MRK 9:43"/><verse number="45" style="v" sid="MRK 9:45"/>Chii nie kon chii zui fanjighase chizhidene agi! Beyechii canfei gholuzhi chanqi amitukude echiku ghua kon bidene dozode bendakuse gou wo. <verse eid="MRK 9:45"/><verse number="47" style="v" sid="MRK 9:47"/>Chii nie nudun chii zui fanjighase waidene agi! Chade nie nudun chaizhi Hudai gojiade oroku ghua nudun bidene dozode bendakuse gou wo. <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Hhende ghughei ulie fugune, khan ulie xiniene. <verse eid="MRK 9:48"/><verse number="49" style="v" sid="MRK 9:49"/>Khan dansun wo giezhi jien kunyi yenliene. <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>Dansunshi gouni wo. Widaoni widase matugie koudaghane? Tai dunda dansun bizhi nieniedene heqishi."<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Biereine Ulie Kereku Shiqin</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luj 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>
    <char style="pn">Ersa</char> hhense likai giezhi <char style="png">Yudaya</char> oronde, <char style="png">Yedanhe</char> duimiende irewo. Kunla pse hhei hhende hhantulase <char style="pn">Ersa</char> chanqiku mutun kunlade sughazho. <verse eid="MRK 10:1"/><verse number="2" style="v" sid="MRK 10:2"/>Falisai kunla ire <char style="pn">Ersa</char>i shiizhi asazho, "Ere kun biereine lihun gieghase olunulie?" <verse eid="MRK 10:2"/><verse number="3" style="v" sid="MRK 10:3"/><char style="pn">Ersa</char> hhelade kieliewo, "<char style="pn">Musa</char> tande matugie fenfulazho?" <verse eid="MRK 10:3"/><verse number="4" style="v" sid="MRK 10:4"/>Hhela kieliewo, "<char style="pn">Musa</char> kieliese lihun qiuzi huaidene lihun giese olune giezho." <verse eid="MRK 10:4"/><verse number="5" style="v" sid="MRK 10:5"/><char style="pn">Ersa</char> hhelade kieliewo, "Tai zhughe khidunshi <char style="pn">Musa</char> ene minlinyi huaizho. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Duyai zhayaghakude Huda ere kun, eme kunyi zhayaghawo. <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Ingiese kun ada anasene likai giedene biereighalane hhantulazhi <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ghuala nie beye gholune. Hhela ghua pusho, nie wo. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Ingiese Huda hhantulaghasei kun fenkai gieghase ulie olune."<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Giedoura orose tujila <char style="pn">Ersa</char>de ene shiqinyi pse asazho. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/><char style="pn">Ersa</char> hhelade kieliewo, "Kien biereighalane lihun giedene pse agise piofen giezho. Biereine kuighazho. <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Bierei zhanguijighalane lihun giedene pse loujide khiseye piofen giezho."<verse eid="MRK 10:12"/></para>
  <para style="s">Kesilade Oluzhi Onxian Giezho</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luj 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Kunla kesilane uduruzhi <char style="pn">Ersa</char>i melie ire maqighane giese tujila hhelai sugiezho. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/><char style="pn">Ersa</char> chanladene hokuzhi tujilade kieliewo, "Kesilai bu dui, mii shida ire gie. Hudai gojiashi imutu kunlanughun wo. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Bi tande shuhua kielieye, kien kewosi mutun Hudai gojiai ulie jienliese hhende oro dane." <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Ingie kesilai qiorudene hhelai jiere khane teizhi gouni kieliezho.<verse eid="MRK 10:16"/></para>
  <para style="s">Nie Baertu Kun</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luj 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>
    <char style="pn">Ersa</char> yozhi qiikude nie kun holuzhi iredene hhei melie xiutuliezhi asawo, "Gou loushi, bi matui giese chanqiku aminni jienliene?" <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/><char style="pn">Ersa</char> hhende kieliewo, "Chi mii yangiezhi gou wo giezho? Hudase chugo gouni uwo. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Minlinyi chi mejiene, kun bu ala, piofen bu gie, bu ghula, jia ganzhen bu bei, bu pienda, ada anane zunji giezho." <verse eid="MRK 10:19"/><verse number="20" style="v" sid="MRK 10:20"/>Hhe kun kieliewo, "Loushi, enelai bi ga xienzise man zunjizho." <verse eid="MRK 10:20"/><verse number="21" style="v" sid="MRK 10:21"/><char style="pn">Ersa</char> hhei uzhedene orezhi kieliewo, "Chade da nie chaizho. Echidene bisanlane man huizhi nanxin kunlade ogi. Ingiese chii boubei asiman jiere wo. Ingiedene irezhi mii dagha." <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Hhende caichan olonshi ene kielienyi chenliedene ungieni bouzhi yuchourazhi yolawo.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>
    <char style="pn">Ersa</char> zhouwidene uzhe tujiladene kieliewo, "Baertu kun Hudai gojiade oroku chijia no wo." <verse eid="MRK 10:23"/><verse number="24" style="v" sid="MRK 10:24"/>Tujila ene kieliende ghudurezho. Ingiese <char style="pn">Ersa</char> hhelade kieliewo, "Kesila, Hudai gojiade oroku chijia no wo. <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Loto zhun boghose daoku bayan kun Hudai gojiade orokuse da sunfan wo." <verse eid="MRK 10:25"/><verse number="26" style="v" sid="MRK 10:26"/>Tujila hende ghanirazhi nieniedene asazho, "Ingiese kienyi jiui shidane?" <verse eid="MRK 10:26"/><verse number="27" style="v" sid="MRK 10:27"/><char style="pn">Ersa</char> hhelai uzhedene kieliewo, "Kun gie danema, Huda buxian wo. Huda yanniliuzhe giene." <verse eid="MRK 10:27"/><verse number="28" style="v" sid="MRK 10:28"/><char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliewo, "Uzhe, bijien man bendadene chii daghazho!" <verse eid="MRK 10:28"/><verse number="29" style="v" sid="MRK 10:29"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, kun made, gouxioxide oluzhi gie, gaijiu, eghechijiu, ada, ana, kesila, ghazhane bendase <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ene duyade gie, gaijiu, eghechijiu, ana, kesila, ghazha 100 pei ogine. Ogikude heikuiye hhantu ogine. Houshide chanqiku amin ogine. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Ingiese olon melieshikula khuinashilane, khuinashikula melieshilane."<verse eid="MRK 10:31"/></para>
  <para style="s">Ersa Shouku Giezhi Aminne Olukuni Ji 3 Hui Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luj 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Hhela <char style="png">Yelusalen</char>de khireiku mo jiere <char style="pn">Ersa</char> melie yozho. Tujilani ghanirazho, daghasan kunla ayizho. <char style="pn">Ersa</char> pse 12 gie tujii uruzhi ire goyade kuzheku shiqinyi kielie qiiwo, <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>"Uzhe, matan <char style="png">Yelusalen</char>de khireine. Kunnikewonyi fugie buwa, jinwun hanjialade jiuise hhela hhei sixin panjidene niman kunlade jiuine. <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Hhela hhei xilun giene, ungie jiere nunpune, mabienzighala eghine, da alane. Ingie ghurudu daose aminne olune."<verse eid="MRK 10:34"/></para>
  <para style="s">Yagebu Yaheiyaghala Xiahua Giesan</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>
    <char style="pn">Xibitai</char>ni ghua kewon <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char> <char style="pn">Ersa</char>i melie ire kieliewo, "Loushi, bijien yan xiahua giese chi bijiende yan ogiba." <verse eid="MRK 10:35"/><verse number="36" style="v" sid="MRK 10:36"/><char style="pn">Ersa</char> kieliewo, "Ta mii yan gieghane?" <verse eid="MRK 10:36"/><verse number="37" style="v" sid="MRK 10:37"/>Hhela kieliewo, "Chi famatu baozo jiere soukude bijienyi niei borun miende niei soghei miende sougha." <verse eid="MRK 10:37"/><verse number="38" style="v" sid="MRK 10:38"/><char style="pn">Ersa</char> kieliewo, "Ta yan keresanne ulie mejiene. Bi shouiku kuni ta shoui shidanu? Bi jienlieku xilini ta jienlienu?" <verse eid="MRK 10:38"/><verse number="39" style="v" sid="MRK 10:39"/>Hhela kieliewo, "Jienliene." <char style="pn">Ersa</char> kieliewo, "Bi shouiku kuni ta shoui, bi jienlieku xilini ta jienlienema, <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>mii lianmien kanzide soughakui bi ogiku pusho. Kiende zhunbei giezhoshi kiende ogine." <verse eid="MRK 10:40"/><verse number="41" style="v" sid="MRK 10:41"/>Psedu hharan tujini sonosudene <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char>ghalade hokuzho. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/><char style="pn">Ersa</char> hhelai uruzhi ire kieliewo, "Niman kunlai dunda lindao, noyen giezhi urusanla qienli bareizhi kunlai gonjisei ta mejiene. <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Ta niekielien pusho, tai dunda kien fugieni danlane giese tande ushilachen kun danlakuni wo. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Tai dunda kien laoda danlane giese dajialade hoji danlakuni wo. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Kunnikewon irekushi kunlai ushilaghale ese irezho. Kharei kunlai ushilazhi aminne sheidene olon kunlade shuiku Jiage danlale irezho."<verse eid="MRK 10:45"/></para>
  <para style="s">Sugho Bajimaini Goudaghazho</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luj 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Hhela <char style="png">Yelige</char>de irewo. <char style="pn">Ersa</char> tuji, tebieji olon kunlare <char style="png">Yelige</char>se likai giekude nie ghuichen sugho <char style="pn">Jimai</char>ni kewon <char style="pn">Bajimai</char> mo bienzide souzho. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Hhe chenliese <char style="png">Nasale</char>ni <char style="pn">Ersa</char> wo giese warada qiiwo, "<char style="pn">Dawude</char>ni houdei <char style="pn">Ersa</char>, made ubali nie xii!" <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>Olon kunla hhei jiebalazhi shenqi bu khizhe giese hhe genjia fugiede waradazhi kieliezho, "<char style="pn">Dawude</char>ni houdei, made ubali nie xii!" <verse eid="MRK 10:48"/><verse number="49" style="v" sid="MRK 10:49"/><char style="pn">Ersa</char> beidene kieliewo, "Hhei uru daozhe." Hhela sughoi uruzhi kieliewo, "Zhughene teidene bosizhe. Hhe chii uruzho." <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Sugho jienne jiezhi jiuli bosizhedene <char style="pn">Ersa</char>i hhende yozhi irewo. <verse eid="MRK 10:50"/><verse number="51" style="v" sid="MRK 10:51"/><char style="pn">Ersa</char> kieliewo, "Bi chade yan giene?" Sugho kieliewo, "Loushi, bi chanlaku duran wo!" <verse eid="MRK 10:51"/><verse number="52" style="v" sid="MRK 10:52"/><char style="pn">Ersa</char> kieliewo, "Chi echi. Chii xianxin gieku chii jiuiwo." Sugho deigo chanladene mo jiere <char style="pn">Ersa</char>i daghawo.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Honshan Mutun Yelusalende Orozho</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luj 19:28-40</ref>; <ref loc="JHN 12:12-19">Yah 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Hhela <char style="png">Yelusalen</char>se chadashizhi <char style="png">Ganlanshan</char>ni <char style="png">Bofaqi</char>, <char style="png">Bodani</char>de kuzhekude <char style="pn">Ersa</char> ghua tujine peizhi <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>hhelade kieliewo, "Ta duimienni aghinde echi. Dei orose nie huiyasan ga enzheghei chanlane. Kieme unuzhi ese daozho. Ta andaghadene lai ire. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Kunla tande enei, 'Yangiezhi giezho?' giese ta 'Ezhan injine. Ingie deigo enende khugho ireghane.' giezhi kielie." <verse eid="MRK 11:3"/><verse number="4" style="v" sid="MRK 11:4"/>Hhela echise nie ga enzheghei wijien konni mo jiere huiya jiesei chanlawo. Hhela hhei andaghase <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>hhende beisan giedun kunla asawo, "Ta ga enzhegheni andaghazhi yan giene?" <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Tujila <char style="pn">Ersa</char> kieliesan mutun kieliese hhela laighawo. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Hhela ga enzheghei lai <char style="pn">Ersa</char>i shida ire goya jienlane enzheghe jiere daidene <char style="pn">Ersa</char>i unughawo. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Olon kunla jienlane mo jiere peizho. Psedu kunla ghazhase chizhisan mutun chalai mo jiere peizho. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Melie khuinadu kunla waradazhi kieliezho,</para>
  <para style="q1" vid="MRK 11:9">"Hesanna!<note caller="+" style="f"><char style="fr">11:9</char> <char style="em">Bijienyi jiui!</char> </note></para>
  <para style="q2" vid="MRK 11:9">Ezhanyi niereghala iresan hhei doulandu!<verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>Mai xienren <char style="pn">Dawude</char>ni gojia iresande doulandu!</para>
  <para style="q2" vid="MRK 11:10">Zui Undudedu Hudade doulandu! Hesanna!"<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de kuru mechide orozhi zhouwini man nie uzhewo. Khara oluse <char style="pn">Ersa</char> 12 gie shiturene chenshise khirei <char style="png">Bodani</char>de echiwo.<verse eid="MRK 11:11"/></para>
  <para style="s">Uhuago Mutunni Kharazho</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Khuichudu hhela <char style="png">Bodani</char>se khizhese <char style="pn">Ersa</char> oliesuzho. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Gholose nie lachen winetu nie uhuago mutunyi chanlawo. Hhende echizhi mutun jierese alima ereizhi olune giezho. Hhe mutun doura echise yama uwo, zinie lachen bikushi alima souku shihou pusho. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/><char style="pn">Ersa</char> mutunde kieliewo, "Enedu khuinase chii jiere pse ibeizi alima ulie soune!" Tujilani kielienyini sonosuzho.<verse eid="MRK 11:14"/></para>
  <para style="s">Ersa Mechini Ganjinraghawo</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luj 19:45-48</ref>; <ref loc="JHN 2:13-22">Yah 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Hhela <char style="png">Yelusalen</char>de irewo. <char style="pn">Ersa</char> mechide orodene meimei giesan kunlai tou khighawo. Baer arunzhasan kunlai shire, ghoghochen huisan kunlai bandoulai tungu unaghawo. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Kunlai mechise dunxilai agizhi ese daoghazho. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Hhelade sughazhi kieliezho,</para>
  <para style="q1" vid="MRK 11:17">"'Mii giei go minzula onxian gieku gie giezhi urune.'</para>
  <para style="m" vid="MRK 11:17">giezhi jinwun jiere ese huaizhou? Ta hhei ghughei ho gholughazho!"<verse eid="MRK 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MRK 11:18"/>Fugie buwa, jinwun hanjiala ene kielienyi chenliedene banfa xianjizhi <char style="pn">Ersa</char>i widaghane giezho. Olon kunla man hhe sughasan tebie gou wo giese hhense ayizho. <verse eid="MRK 11:18"/><verse number="19" style="v" sid="MRK 11:19"/>Khara olukude hhela chenshi ghadane khireizho.<verse eid="MRK 11:19"/></para>
  <para style="s">Ghosan Uhuago Mutunse Suruku</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Eqiemagha hhela hhense yozhi daokude uhuago mutun lien genzi ghosei chanlawo. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/><char style="pn">Beduru</char> <char style="pn">Ersa</char>i kielienyi sumula ire hhende kieliewo, "Loushi, uzhe! Chi kharasan uhuago mutun ghozho." <verse eid="MRK 11:21"/><verse number="22" style="v" sid="MRK 11:22"/><char style="pn">Ersa</char> kieliewo, "Ta Hudai xianxin gie. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Bi tande shuhua kielieye, kien zhughedene inxin ulie giezhi ene ulade oronsene noidene haide bou giese jiu qingiezhi gholune. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Ingiese bi tande kielieye, ta onxian giezhi xiahua giekude tande ogiwo giezhi xianxin giema, tande qingiezhi gholune. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Ta beidene onxian giekude kunla chii hokughasei sumula irese roulie. Asiman jieredu adataiye tai codasei rouliene."<verse eid="MRK 11:25"/></para>
  <para style="s">Ersani Qienlini Asazho</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luj 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Hhela pse <char style="png">Yelusalen</char>de irewo. <char style="pn">Ersa</char> mechide yokude fugie buwa, jinwun hanjia, zhanlaola <char style="pn">Ersa</char>i shida iredene <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>hhende kieliezho, "Chi yan qienlighala ene shiqinlai giezho? Kien chade ene qienlii ogizhi ene shiqinyi gieghazho?" <verse eid="MRK 11:28"/><verse number="29" style="v" sid="MRK 11:29"/><char style="pn">Ersa</char> hhelade kieliewo, "Biye tande nie unqi asaye. Ta made huida giese bi yan qienlighala ene shiqinlai giesei tande kieliene. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/><char style="pn">Yaheiya</char>i xili gieghaku qienli asimanse onu, kunlase wo? Ta made huida gie." <verse eid="MRK 11:30"/><verse number="31" style="v" sid="MRK 11:31"/>Hhela goyalane shanlian giezhi kieliewo, "Matan asimanse wo giese ta yale hhei xianxin ulie giene giezhi hhe kieliene. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Kunlase wo giese?" Jien kunla man <char style="pn">Yaheiya</char>shi zhenzhenji xienzhi wo giese hhela bexinlase ayizho. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Ingie <char style="pn">Ersa</char>de kieliewo, "Bijien ulie mejiene." <char style="pn">Ersa</char> hhelade kieliewo, "Biye tande yan qienlighala ene shiqinlai giesei ulie kieliene."<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Doghun Bouisan Kunlai Bilazho</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luj 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>
    <char style="pn">Ersa</char> hhelade bilazhi kielie qiiwo, "Nie kun nie yenzi putou zeiladene izhonyini qienjiwo. Jiu daruku chizi waizhi yenzi uzheku teizi giedene kunlade bouizhi ogi, gholode echiwo. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Shihou kuzhese nie hojine peizhi bouisan kunlase nexianne ghuraghale echiwo. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Bouisan kunla hhei bareidene idun eghi khosun khareighawo. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Pse nie hoji peizhi echighase hhela qiorunyini eghi ghalughazhi shizheghazho. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Pse nie hoji peizhi echighase hhela hhei alawo. Khuinashida olon hojilai peizhi echighase niezhanlai eghizho, niezhanlai alazho. <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>Yenzii ezhande oresan niekozi kewon wo. Zuihoude hhei peizhi echighazhi kieliezho, 'Hhela kewonyimi zunjineba.' <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>Ingie bouisan kunla nieniedene kieliewo, 'Eneshi jiachanni jienliechen wo. Matan enei alayema, jiachanni manughun gholune!' <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Ingie hhei bareidene alazhi putou yenzise benda khighawo. <verse eid="MRK 12:8"/><verse number="9" style="v" sid="MRK 12:9"/>Ingiese putou yenzii ezhan matugiene? Hhe iredene bouisan kunlai alazhi putou yenzii psedu kunlade ogine. <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Ta ene idon jinwunni onshizhi ese daowu?</para>
  <para style="q1" vid="MRK 12:10">'Gie giesan kunla bendasan tashi</para>
  <para style="q2" vid="MRK 12:10">giei zhunyo tashi gholuwo.<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>Eneshi Ezhan giesan wo.</para>
  <para style="q2" vid="MRK 12:11">Matan uzhese xihan giezho.'"<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>
    <char style="pn">Ersa</char> hhelai zhiizhi bilazhi kieliesei hhela uzhe khizhedene bareine giezhoma, olon kunlase ayidene <char style="pn">Ersa</char>se likai gie yolawo.<verse eid="MRK 12:12"/></para>
  <para style="s">Shui Jiuiku Unqi</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:19-26">Luj 20:19-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Hhela giedun Falisai kun, Hherodepai kunni peizhi <char style="pn">Ersa</char>i hhende echighadene hhei kielienghala heine giezho. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Hhela iredene hhende kieliewo, "Loushi, chi shuhua kieliekui bijien mejiene. Chi yan kunyiliuzhe niekielien uzhezhi kunni mienzii ulie uzhene. Hudai daolini shixinde sughazho. Matan <char style="pn">Kaisa</char> Honshande shui jiuise oluzhou ese oluzho? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Matan jiuiku onu, ulie jiuiku wo?" <char style="pn">Ersa</char> hhelai jiazhon giesei mejiedene hhelade kieliewo, "Ta mii shiizhi yan giene? Made miengui agizhedene nie uzhegha." <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Hhela agizhese <char style="pn">Ersa</char> kieliewo, "Ene qiorun, haoshi kiennughun wo?" Hhela kieliewo, "<char style="pn">Kaisa</char>nughun wo." <verse eid="MRK 12:16"/><verse number="17" style="v" sid="MRK 12:17"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Kaisa</char>nughunshi <char style="pn">Kaisa</char>de ogi, Hudanughunshi Hudade ogi." Ingiese hhela <char style="pn">Ersa</char>de hende ghanirazho.<verse eid="MRK 12:17"/></para>
  <para style="s">Aminne Oluku</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luj 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Fuho gieku shiqin uwo giesan Sadugai kunla ire <char style="pn">Ersa</char>de asazho, <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>"Loushi, <char style="pn">Musa</char> guijin jiere huaizho, nie kun bierei agidene kewosi wi duya ijiese jiuni zhoui gaidene houdei liuikuni wo giezho. <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Gaijiu dololie, laoda bierei agidene kewosi wi duya ijiewo. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Laoer hhei zhouidene kewosi wi duya ijiewo. Laosanye ingiezho. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Hhe dololiede kewosi nieda uye feiliezho. Zuihou biereiye duya ijiewo. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Ingiese fuho giekude hheshi kienyi bierei wo? Gaijiu dololie man hhei agiwo." <verse eid="MRK 12:23"/><verse number="24" style="v" sid="MRK 12:24"/><char style="pn">Ersa</char> hhelade kieliewo, "Tanughun codazho. Ta jinwunni mejie dazho, Hudai nenliniye mejie dazho. Eneshi tai codasan yenyin wo. <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Kun aminne olukude ulie agine, ulie dafalane, asiman jieredu qienxien niekielien wo. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Duya ijiesan kun aminne olukui kieliese ta eghesun khan siderasan jinwunni <char style="pn">Musa</char>i shu jiere onshizhi ese daowu? Huda <char style="pn">Musa</char>de, 'Bishi <char style="pn">Iburaheimu</char>ni Huda wo, <char style="pn">Isaghei</char>ni Huda wo, <char style="pn">Yagebu</char>ni Huda wo.' giezhi kieliezho. <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Hudashi duya ijiesan kunyi Huda pusho, amitu kunyi Huda wo. Tanughun fugiede codazho."<verse eid="MRK 12:27"/></para>
  <para style="s">Zui Zhunyo Minlin</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luj 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Nie jinwun hanjia ire hhela jianjindusei sonosuwo. <char style="pn">Ersa</char> kieliesan gou bikui mejiedene <char style="pn">Ersa</char>de asazho, "Minlin dunda alinie zui zhunyo wo?" <verse eid="MRK 12:28"/><verse number="29" style="v" sid="MRK 12:29"/><char style="pn">Ersa</char> kieliewo, "Ji 1 gieshi ene wo, <char style="png">Isilie</char>ya, chenliendu! Ezhan mai Hudashi zi niekozi wo. <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Chi qienbuji zhughe, qienbuji jinshen, qienbuji sumulaku, qienbuji lilianghalane Ezhan Hudadene ore giezho. <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Jie 2 gieshi ene wo, goyadene mutun giebeidene ore giezho. Ene ghua minlinse fugieni uwo." <verse eid="MRK 12:31"/><verse number="32" style="v" sid="MRK 12:32"/>Jinwun hanjia <char style="pn">Ersa</char>de kieliewo, "Loushi, chi kieliesan oluzho. Hudashi nie wo. Hhense chugo pse Huda uwo. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Qienbuji zhughe, qienbuji sumulaku, qienbuji lilianghalane Ezhan Hudadene oreku, pse goyadene mutun giebeidene oreku yanyanji sideraghaku sidagha, ogiku murelase zhunyo wo." <verse eid="MRK 12:33"/><verse number="34" style="v" sid="MRK 12:34"/><char style="pn">Ersa</char> uzhese hhe huida giesande agheli wine. Ingie hhende kieliewo, "Chi Hudai gojiase gholo uwo." Enense khuinashi kunla hhende yama asa dazho.<verse eid="MRK 12:34"/></para>
  <para style="s">Mexiha Dawude Ghualai Gonxi</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luj 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>
    <char style="pn">Ersa</char> mechide sughakude kieliezho, "Jinwun hanjiala matugie Mexihashi <char style="pn">Dawude</char>ni houdei wo giezhi kieliezho? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/><char style="pn">Dawude</char> goya Shenlinni tungo giezhi kieliewo,</para>
  <para style="q1" vid="MRK 12:36">'Ezhan mii Ezhande kieliewo,</para>
  <para style="q2" vid="MRK 12:36">"Bi duitoulaichii kon dourachii teitula</para>
  <para style="q3" vid="MRK 12:36">chi mini borun miende sou."'<verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>
    <char style="pn">Dawude</char> goyane Mexihai Ezhan giezhi uruse Mexiha matugie <char style="pn">Dawude</char>ni houdei wo?" Ingiese tebieji olon kunla hhenughunyi chenliekude xiqi wo.<verse eid="MRK 12:37"/></para>
  <para style="s">Jinwun Hanjiai Kheilazho</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luj 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>
    <char style="pn">Ersa</char> kunlade sughakude kieliewo, "Ta jinwun hanjialai fangula. Hhela fudu jien musidene geidoude toreizhi kunla hhelade kielien asakude xiqi wo. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Huitanni undu wizi, xini shanxide soukude xiqi wo. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Hhela guafui gieni chigheine. Jiazhon giezhi oloncha onxian giene. Enezighan kunlai pse gundude faine."<verse eid="MRK 12:40"/></para>
  <para style="s">Guafu Baer Teiku</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luj 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>
    <char style="pn">Ersa</char> mechii baer teiku xianzii duimiende soudene kunla matui baer teisanyi uzhezho. Olon bayan kunla xianzide baer olon teizho. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Nie nanxin guafu iredene ghua fenfenzi baer teizho. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/><char style="pn">Ersa</char> tujilane uruzhi ire kieliewo, "Bi tande shuhua kielieye, ene nanxin guafu xianzide teisan soyuji kunlase olon wo. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Kunla olonsene teiwo, guafude yama uwoma, udu daoku baerlane man teiwo."<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Mechini Cheikui Ersa Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="LUK 21:5-6">Luj 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>
    <char style="pn">Ersa</char> mechise khizhekude nie tujini hhende kieliewo, "Loushi, uzhe! Ene tashi, loula matu fama wo!" <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/><char style="pn">Ersa</char> hhende kieliewo, "Chi ene fugie gielai chanlawu? Jianlai man cheizhi tashi jiere tashi nieda ulie jiene."<verse eid="MRK 13:2"/></para>
  <para style="s">Duya Baraku Zunji</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-19">Luj 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>
    <char style="pn">Ersa</char> mechini duimienni <char style="png">Ganlanshan</char>de soukude <char style="pn">Beduru</char>, <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char>, <char style="pn">Andelie</char> konkonji ire asazho, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>"Yan xienzide ene shiqinla fashen giene? Enela man chenjikude yan zunji bikui bijiende nie kielie." <verse eid="MRK 13:4"/><verse number="5" style="v" sid="MRK 13:5"/><char style="pn">Ersa</char> hhelade kielie qiiwo, "Ta xioxin giezhi kunlai bu miigha. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Olon kunla mii niereghala iredene bishi hhe enbene giezhi olon kunlai miine. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Ta eghindusan, eghindune giesan xioxini sonosuse bu jinda. Ene shiqin kenjin fashen gienema, duya baraku shihou dou ese kuzhezho. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Minzu minzula eghindune, gojia gojiala eghindune. Gochude zemin gojioluzhi oliesune. Eneshi tendunni keitou wo."<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>"Ingiese ta goyane xioxin gie. Kunla tai zui fugie fayende jiuine. Huitanlade eghine. Mii yenyinghala ta shenzhan, honshanlai melie beizhi ganzhen beine. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Pse gouxioxini go minzulade matugieseda xien chonjizhi ogine. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Kunla tai bareizhi fayende jiuikude ta yan kieliekui melieshighan munan bu gie. Hhe shihoude tande yan kielieghase yan kielie. Kieliesanshi ta pusho, Shenlin wo. <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>Gaijiu gaijiune, ada kewosine ghudanduzhi fugughakude kune. Kesila ada, anane zodui giezhi fugughakude jiuine. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Mii yenyinghala soyuji kunla man tai henjine. Ingieliuzhe rennai giezhi zuihou kusanlai jiuine."<verse eid="MRK 13:13"/></para>
  <para style="s">Fugie Zeinan</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luj 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>"Hhe pohai giezhi hanzhan gieghaku ulie beiku oronde beisei ta chanlane. (Onshichen kunla, ene kielienni isii dunjirekuni wo.) Ingiekude <char style="png">Yudaya</char>de sousan kunla, ulade piile echi. <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Gie jieredula, bu bouzhezhi giederase dunxi agile bu oro. <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Ghazha jieredula, jienne agile khareizhi bu echi. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Hhe udude kewosi laisan, gogoghasanlade gou widawo. <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Enei unchade bu kuzhegha giezhi onxian gie. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Ingiekushi hhezighan udude zeinan fugie wo. Huda duyai zhayaghazhi eli kutula imutu zeinan uwo, khuinashiye uwo. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Ezhan hhezighan zeinantu udui ese choghonshighazhoshi nieda jiui danema, hhe sunghusan kunladene oluzhi choghonshighawo. <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/>Hhe udude kunla tande uzhe, Mexiha enende wo, uzhe, hhende wo giese ta xianxin bu gie. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Jia Mexiha, jia xienzhila khizhezhi ghudureqi, fugie shiqinlai giekushi sunghusanlaiye kenen miine. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Ta xioxin gie, bi shiqinlai tande man eqie kieliewo."<verse eid="MRK 13:23"/></para>
  <para style="s">Kunnikewon Ireku</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luj 21:25-28</ref>)</para>
  <para style="q1">
    <verse number="24" style="v" sid="MRK 13:24"/>"Hhezighan zeinanni udu daose</para>
  <para style="q2" vid="MRK 13:24">naran kharalane, sara gon ulie faine.<verse eid="MRK 13:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="MRK 13:25"/>Hodunla asiman jierese anda bouzhene.</para>
  <para style="q2" vid="MRK 13:25">Asiman jieredu lilianla gojiolune.<verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>Ingiekude Kunnikewon fugie nenlighala famade olien jierese irekui kunla chanlane. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Hhe qienxienlai peizhi zemin enemanse asiman hhemande kutula sunghusan kunlane simiense uruzhi hhantulaghane."<verse eid="MRK 13:27"/></para>
  <para style="s">Uhuago Mutunse Suruku</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:29-33">Luj 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>"Ta uhuago mutunyi bilasei suru. Mutun niazi faizhi lachen keise khaluncha orokui ta mejiene. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Taye niekielien wo. Ta ene shiqinla fashen giesei chanlase hhe shihou chadashizhi shida kuzhesei mejiene. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Bi tande shuhua kielieye, ene idaini kunla fugutula ene shiqinla man gholune. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Asiman zemin widaliuzhe mii kielien kenjin ulie widane."<verse eid="MRK 13:31"/></para>
  <para style="s">Hhe Udui Kieme Ulie Mejiene</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>"Hhe udu hhe shihouni kiema ulie mejiene. Asiman jieredu qienxienlaye ulie mejiene. Kewonye ulie mejiene. Zinie Ada mejiene. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Ta xioxin giezhi jinxin gie, hhe shihouni ta ulie mejiene. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Eneshi nie kun giesene likai giezhi gholode echikude hojiladene gonjighazhi wilielai nanpei gie, wijien sagheisande jinxin gie giezhi fenfulasei xianli. <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>Ingiese ta jinxin gie. Giei ezhan yan xienzide irekui ulie mejiene. Khara olukude onu, banyede onu, tigha kheilakude onu, eqiemagha irekui ulie mejiene. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Hhe menzhali irese ta kijiesei chanlakuse ayizho. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Bi tande kieliesan kielienshi soyuji kunlade kieliesan wo. Ta jinxin gie!"<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Ersai Alane Giezhi Shanlian Giezho</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luj 22:1-2</ref>; <ref loc="JHN 11:45-53">Yah 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Ghuarudu daose Jiulidaosan Jie, jiushi Tanmien Jie wo. Fugie buwa, jinwun hanjiala <char style="pn">Ersa</char>i piendazhi bareidene matui alane giezhi banfa xianjizhi kieliezho, <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>"Jieqii udude ulie olune, bexinla londane."<verse eid="MRK 14:2"/></para>
  <para style="s">Bodanidedu Bierei Ersai Jiere Xianshui Kiezho</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Yah 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>
    <char style="pn">Ersa</char> <char style="png">Bodani</char>de pifugientu <char style="pn">Ximun</char>yi giede ijiekude nie bierei ishighala giesan huapinde guizhuntu zhen nada xianshuini agizhedene eghi ghalugha <char style="pn">Ersa</char>i qiorun jiere kiewo. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Giedun kunlai zhughede hokuzhi kieliewo, "Xianshuii ingiezhi lanfei giezhi yan giene? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ene xianshuii 300 gie miengu huidene nanxin kunlade ogikui wo!" Hhela hhe biereii kheilazho. <verse eid="MRK 14:5"/><verse number="6" style="v" sid="MRK 14:6"/><char style="pn">Ersa</char> kieliewo, "Bu danla. Hhende chijia teizhi yan giene? Hhe made nie gou shiqin giewo. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Nanxin kunla tanre chan hhantu wo. Ta hhelade banman giese yan xienzideliuzhe olune. Bi tanre chan hhantu uwo. <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Hhe gie shidakune jinlianji giezho. Xianshuini mii jiere kiezhi mii bulakude zhunbei giezho. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Bi tande shuhua kielieye, gouxioxini chonjizhi qienxiade kutula ene bierei gieseiye kieliezhi jilane."<verse eid="MRK 14:9"/></para>
  <para style="s">Yuda Ersai Ghudanduzho</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="LUK 22:3-6">Luj 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>12 gie tuji dundadu <char style="png">Jialie</char> kun <char style="pn">Yuda</char> <char style="pn">Ersa</char>i ghudandune giezhi fugie buwalai hhende echiwo. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Hhela chenliedene bayasuzhi hhende baer ogikui dain giewo. Ingiese <char style="pn">Yuda</char> <char style="pn">Ersa</char>i ghudanduku jihui ereizho.<verse eid="MRK 14:11"/></para>
  <para style="s">Daosan Jieni Zhunbei Giezho</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luj 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yah 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Tanmien Jieni tou 1 qien, Jiulidaosan Jieni ghoni zharuku udude tujilani <char style="pn">Ersa</char>de kieliewo, "Bijien Jiulidaosan Jieni xini chade khala zhunbei giene?" <verse eid="MRK 14:12"/><verse number="13" style="v" sid="MRK 14:13"/><char style="pn">Ersa</char> ghua tujii peidene kieliewo, "Ta chenshide echi. Nie tunzi usu qilasan kunyi penjine. Ta hhei daghazhi <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>hhe ali giede orose ta oro, hhe giei zhanguijide kielie, 'Loushi asazho, "Bi tujilarene Jiulidaosan Jieni daoghaku gie khala wo?"' <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Hhe tande lou jiere fugie gieni uzheghane. Man qiendaghazhi zhunbei gie goudaghazho. Ta hhende matande zhunbei gie." <verse eid="MRK 14:15"/><verse number="16" style="v" sid="MRK 14:16"/>Tujila khizhi echi chenshide echidene chanlasan <char style="pn">Ersa</char> kieliesanghala niekielien wo. Ingie hhela hhende Jiulidaosan Jieni zhunbei giewo. <verse eid="MRK 14:16"/><verse number="17" style="v" sid="MRK 14:17"/>Khara oluse <char style="pn">Ersa</char> 12 gie tujirene irewo. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Hhela xi souzhi ijiekude <char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, tai dunda mase hhantu ijiesan nie kun mii ghudandune." <verse eid="MRK 14:18"/><verse number="19" style="v" sid="MRK 14:19"/>Hhela munan giedene bi pushoba giezhi nienieji asa qiiwo. <verse eid="MRK 14:19"/><verse number="20" style="v" sid="MRK 14:20"/><char style="pn">Ersa</char> hhelade kieliewo, "Tai 12 gie dundadu mare hhantu jiezise zhanjizhi ijiesan nie kun wo. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Kunnikewon jinwun jiere huaisan mutun fugunema, hhei ghudandusan kunde gou widawo! Hhe kunyi ese oluzhoshida gou wo."<verse eid="MRK 14:21"/></para>
  <para style="s">Ezhanni Heifan</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="LUK 22:14-20">Luj 22:14-20</ref>; <ref loc="1CO 11:23-25">1Gel 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Hhela ijiekude <char style="pn">Ersa</char> ginanyi barei onxian giedene ghulu hhelade ogi kieliewo, "Ta barei, eneshi mii beye wo." <verse eid="MRK 14:22"/><verse number="23" style="v" sid="MRK 14:23"/>Pse beizii barei mafan kieliedene hhelade ogise hhela man ochiwo. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/><char style="pn">Ersa</char> kieliewo, "Eneshi olon kunlade usurusan bi yenjisan chusun wo. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Bi tande shuhua kielieye, bi pse putoujiuni ulie ochizhi Hudai gojiade shinii ochiku hhe udu kune." <verse eid="MRK 14:25"/><verse number="26" style="v" sid="MRK 14:26"/>Hhela douladene khizhe <char style="png">Ganlanshan</char>de echiwo.<verse eid="MRK 14:26"/></para>
  <para style="s">Ersa Beduru Hhei Ulie Renjine Giezhi Melie Kieliezho</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luj 22:31-34</ref>; <ref loc="JHN 13:36-38">Yah 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Ta man mii bendane. Jinwun jiere kieliezho,</para>
  <para style="q1" vid="MRK 14:27">'Bi yanbashii eghi unaghase</para>
  <para style="q2" vid="MRK 14:27">ghonila sandane.'<verse eid="MRK 14:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28"/>Ingieliuzhe bi aminne oludene tanse melie <char style="png">Jialili</char>de echine." <verse eid="MRK 14:28"/><verse number="29" style="v" sid="MRK 14:29"/><char style="pn">Beduru</char> kieliewo, "Kunla man chii bendaliuzhe bi ulie bendane!" <verse eid="MRK 14:29"/><verse number="30" style="v" sid="MRK 14:30"/><char style="pn">Ersa</char> hhende kieliewo, "Bi chade shuhua kielieye, ene xii tigha lianhui kheilatula chi mii 3 hui ulie renjine." <verse eid="MRK 14:30"/><verse number="31" style="v" sid="MRK 14:31"/><char style="pn">Beduru</char> khidunde kieliewo, "Bi chare hhantu fuguliuzhe chii tani dane giezhi ulie kieliene!" Tujilaye man qingiezhi kieliezho.<verse eid="MRK 14:31"/></para>
  <para style="s">Ersa Keximanide Onxian Giezho</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:39-46">Luj 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Hhela nie <char style="png">Keximani</char> giesan oronde irewo. <char style="pn">Ersa</char> tujiladene kieliewo, "Ta enende sou, bi onxian giele echine." <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Ingie <char style="pn">Beduru</char>, <char style="pn">Yagebu</char>, <char style="pn">Yaheiya</char> enelai uduru hhantu echiwo. <char style="pn">Ersa</char> hende jindazhi nango giedene <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>hhelade kieliewo, "Mii zhughede nango giezhi fugukui xianli, ta enende sagheizhi jinxin gie." <verse eid="MRK 14:34"/><verse number="35" style="v" sid="MRK 14:35"/>Hhe gouji melie yodene zemin jiere papala olu shidase hhe shihoui daogha giezhi onxian giezho. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/><char style="pn">Ersa</char> kieliewo, "Aba, Ada, chi yanniliuzhe giene. Ene shouku giekui made bu iregha! Ingieliuzhe mii duranghala bu gie, chii duranghala gie." <verse eid="MRK 14:36"/><verse number="37" style="v" sid="MRK 14:37"/><char style="pn">Ersa</char> irese hhela hhunturasei chanladene <char style="pn">Beduru</char>de kieliewo, "<char style="pn">Ximun</char>, chi hhunturazhou? Nie zhuntouye jinxin gie danu? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Jinxin giezhi onxian gie, pse miine. Tai zhughede duran winema, beyetai zholien wo." <verse eid="MRK 14:38"/><verse number="39" style="v" sid="MRK 14:39"/>Ingie pse likai gie onxian giewo. Kieliesan melieshidakughala niekielien wo. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Pse irese hhela hhunturasei chanlawo. Hhela nokuzhi nudunne nie dazho. <char style="pn">Ersa</char>de yan huida giekui ulie mejiene. <verse eid="MRK 14:40"/><verse number="41" style="v" sid="MRK 14:41"/>3 huide ire hhelade kieliewo, "Ta dou hhunturazhi hhamuranu? Ede oluwo, shihou kuzhewo. Uzhe, Kunnikewonyi zuirenlai khade ghudanduwo. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Bosizhe, matan yoye. Uzhe, mii ghudandusan kun irewo."<verse eid="MRK 14:42"/></para>
  <para style="s">Ersai Bareizho</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="LUK 22:47-53">Luj 22:47-53</ref>; <ref loc="JHN 18:3-12">Yah 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Ersa zhen kieliekude 12 gie tuji dundadu <char style="pn">Yuda</char> fugie buwa, jinwun hanjia, zhanlaola peisan iban banban, khudogho bareisan kunlare hhantu irewo. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/><char style="pn">Ersa</char>i ghudandusan kun hhelade nie jihao kieliezhi bi kiende orese kien enbene. Ta hhei bareidene xioxin giezhi lai echi giezho. <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/><char style="pn">Yuda</char> iredene <char style="pn">Ersa</char>i shida echi loushi giedene orewo. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Ingiese hhela <char style="pn">Ersa</char>i bareiwo. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Kanzide beisan nie kun khudoghoi lai khizhe zui fugie buwai hojii nie chighinyi chizhi agiwo. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta khudogho, banbanlai bareidene mii qiandao mutun bareile irewu? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Niudunie bi mechide sughakude tanre hhantu wo, ta ulie bareine. Eneshi jinwun jieredu kielienyi gholughane giezho." <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>Tujila man <char style="pn">Ersa</char>se likai gie holu widawo. <verse eid="MRK 14:50"/><verse number="51" style="v" sid="MRK 14:51"/>Nie nasuchighan kun hulan muchughun jierene bosii nanbezhi <char style="pn">Ersa</char>i daghazho. Kunla hhei bareine giese <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>hhe bosii benda jiedene hulan muchughun holu widawo.<verse eid="MRK 14:52"/></para>
  <para style="s">Ersai Shenwun Giezho</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>; <ref loc="LUK 22:54-55">Luj 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yah 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Hhela <char style="pn">Ersa</char>i zui fugie buwai hhende lai echiwo. Hhende fugie buwa, zhanlao, jinwun hanjiala man hhantulazho. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/><char style="pn">Beduru</char> gholose <char style="pn">Ersa</char>i daghazhi zui fugie buwai ghoronde orodene wijien sagheisan kunlare hhantu khan xiezho. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Fugie buwa, zui fugie fayenni soyuji kunla man ganzhen ereizhi <char style="pn">Ersa</char>i alane giezhoma, yama zhenji erei dazho. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Olon kunla jia ganzhen beizhoma, kieliesanlani izhi uwo. <verse eid="MRK 14:56"/><verse number="57" style="v" sid="MRK 14:57"/>Giedun kunla bosizhedene jia ganzhen beizhi kieliewo, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>"Bijien kielieseini chenliese bi kun giesan mechii cheidene ghurudude pse nie kun uye giesei gie khighane giezho." <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Ingiezhi ganzhen beiliuzhe izhi uwo. <verse eid="MRK 14:59"/><verse number="60" style="v" sid="MRK 14:60"/>Zui fugie buwa bosizhe dunda beidene <char style="pn">Ersa</char>de asawo, "Ene kunla ganzhen beizhi zhasande chi yama huida ulie gienu?" <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/><char style="pn">Ersa</char> shenqi ese khizhezhi nie amanda huida ese giezho. Zui fugie buwa pse asazho, "Chishi Mexiha, indan doulaku Hudai kewon enbenu?" <verse eid="MRK 14:61"/><verse number="62" style="v" sid="MRK 14:62"/><char style="pn">Ersa</char> kieliezho, "Bi enbene. Ta Kunnikewon Nenlitu Hudai borun miende sousei, pse asimanni olien jierese irekui chanlane." <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>Zui fugie buwa jienne sida keigha kieliewo, "Matan pse yan ganzhen beiku kun kerene? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Hhe kufurei fanjisei ta chenliewo! Ta kieliese matugiene?" Hhela man fuguku zui jinjizho. <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>Niezhanla ungie jiereni nunpuzho. Pse ungieini huighadene chuidazhi kieliezho, "Chii kien eghisei kielie?" Wijien sagheisan kunla laizhi daodene hhaghadazho.<verse eid="MRK 14:65"/></para>
  <para style="s">Beduru Ersai 3 Hui Ese Renjizho</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:56-62">Luj 22:56-62</ref>; <ref loc="JHN 18:15-18">Yah 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>
    <char style="pn">Beduru</char> doura ghoronde bikude zui fugie buwai nie hoji oqin ire <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/><char style="pn">Beduru</char> khan konde khan xiesei chanla, uzhedene kieliewo, "Chiye <char style="png">Nasale</char>ni <char style="pn">Ersa</char>re hhantuku wo." <verse eid="MRK 14:67"/><verse number="68" style="v" sid="MRK 14:68"/><char style="pn">Beduru</char> ese renjizhi kieliewo, "Chi yan kieliesei bi ulie mejiene, dunjireye dane." Ingie khizhedene melie yenzide echise tigha kheilawo. <verse eid="MRK 14:68"/><verse number="69" style="v" sid="MRK 14:69"/>Hhe hoji oqin chanladene kanzii beisan kunlade kieliewo, "Eneshi hhelare hhantuku kun wo." <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/><char style="pn">Beduru</char> pse ese renjiwo. Goujicha beise kanzii kunla pse kieliewo, "Chishi <char style="png">Jialili</char> kun wo, kenjin hhelare hhantuku wo." <verse eid="MRK 14:70"/><verse number="71" style="v" sid="MRK 14:71"/><char style="pn">Beduru</char> fayen giezhi khara qiiwo, "Ene kunyi bi tani dane!" <verse eid="MRK 14:71"/><verse number="72" style="v" sid="MRK 14:72"/>Deigo tigha lianhui kheilawo. <char style="pn">Beduru</char> <char style="pn">Ersa</char> kieliesan tigha lianhui kheilatula chi mii 3 hui ulie renjine giesei sumula ire bazilie da wila qiiwo.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Bilado Ersai Shenwun Giezho</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luj 23:1-5</ref>; <ref loc="JHN 18:28-38">Yah 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Eqiemagha kuse deigo fugie buwa, zhanlao, jinwun hanjiala, zui fugie fayenni soyuji kunlare hhantu shanlian giezho. Hhela <char style="pn">Ersa</char>i banladene laizhi <char style="pn">Bilado</char>de jiuiwo. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/><char style="pn">Bilado</char> <char style="pn">Ersa</char>de asawo, "Chishi <char style="png">Yutai</char> kunni honshan onu?" <char style="pn">Ersa</char> kieliewo, "Chi kieliezho." <verse eid="MRK 15:2"/><verse number="3" style="v" sid="MRK 15:3"/>Fugie buwala hhei olon shiqinde zhase <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/><char style="pn">Bilado</char> pse asazho, "Chi uzhe, hhela chii imegheni zhase, chi yama ulie kielienu?" <verse eid="MRK 15:4"/><verse number="5" style="v" sid="MRK 15:5"/><char style="pn">Ersa</char> yama huida ese giese <char style="pn">Bilado</char> ghanirazho.<verse eid="MRK 15:5"/></para>
  <para style="s">Ersani Sixin Panjizho</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luj 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yah 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Niefanie ene jieqide shenzhan bexinla keresan mutun nie fanren andaghane. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Nie kunyi nierei <char style="pn">Balaba</char> giene. Panlon giesan kunlare hhantu khazho. Hhela panlon giekude kun alazhi daozho. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Olon kunla <char style="pn">Bilado</char>i melie echi, "Melieshidaku mutun banji." giezhi xiahua gie qiiwo. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/><char style="pn">Bilado</char> kieliezho, "Tande <char style="png">Yutai</char> kunni honshanyi tei giezhou?" <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Fugie buwala <char style="pn">Ersa</char>i dubiliezhi hhende jiuizhi ogisei hhe mejiedene ingiezhi asazho. <verse eid="MRK 15:10"/><verse number="11" style="v" sid="MRK 15:11"/>Fugie buwala bexinlai shanjizhi, "<char style="pn">Balaba</char>i andagha!" giezhi xiahua gieghazho. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/><char style="pn">Bilado</char> pse kieliewo, "Qinse ta <char style="png">Yutai</char> kunni honshan wo giesan enei matugiene?" <verse eid="MRK 15:12"/><verse number="13" style="v" sid="MRK 15:13"/>Ingiese hhela pse waradazho, "Hhei shizijia jiere ghada!" <verse eid="MRK 15:13"/><verse number="14" style="v" sid="MRK 15:14"/><char style="pn">Bilado</char> kieliezho, "Yangiezhi? Hhe yan doghun shiqin giewo?" Hhela pse hende waradazhi kieliezho, "Hhei shizijia jiere ghada!" <verse eid="MRK 15:14"/><verse number="15" style="v" sid="MRK 15:15"/>Ingiese <char style="pn">Bilado</char> bexinlai bayasughazhi <char style="pn">Balaba</char>i andaghawo. <char style="pn">Ersa</char>i mabienzighala eghidene kunlade jiuizhi shizijia jiere ghada giezho.<verse eid="MRK 15:15"/></para>
  <para style="s">Buduila Ersai Xilun Giezho</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2-3">Yah 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Buduila <char style="pn">Ersa</char>i laizhi shenzhan sousan oronyi ghoronde echi, nie tonni buduilai man uruzhi hhantulaghawo. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Hhela <char style="pn">Ersa</char>de zishei fudu jienyi musighazhi eghesunni maghala onjidene zhoghawo. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Ingiedene <char style="png">Yutai</char> kunni honshan, onsui giezhi jinli giewo. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Ingie qiorun jierei ghulusunghala eghizhi jierei nunpuzho. Xietuliedene hhei beiizho. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Xilun gie balu, zishei fudu jienyi teigha, jienyini musighadene lai khirei shizijia jiere ghadane giezho.<verse eid="MRK 15:20"/></para>
  <para style="s">Ersani Shizijia Jiere Ghadazho</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="LUK 23:26-43">Luj 23:26-43</ref>; <ref loc="JHN 19:17-27">Yah 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Nie xianse iresan <char style="png">Gulinai</char> kun <char style="pn">Ximun</char> wo. <char style="pn">Yalishanda</char>, <char style="pn">Lufu</char>ni ada wo. Hhense daokude buduila hhende ninkounin <char style="pn">Ersa</char>i shizijiai beilieghawo. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Hhela <char style="pn">Ersa</char>ni laizhi <char style="png">Gegeta</char> giesan oronde kuruwo. Isishi qiorun yasun oron wo. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Guizhuntu caoyeni jiude huigha <char style="pn">Ersa</char>de ogise ese kerewo. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Ingie shizijia jiere ghadawo. Hhela fendan qianguzhi jienni kiende kune giezho. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Eqiemagha 9 jiende hhela <char style="pn">Ersa</char>i shizijia jiere ghadawo. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Peizi jiere <char style="png">Yutai</char> kunni honshan giezhi zuinini huaizho. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Hhela hhere hhantu ghua qiandaoi shizijia jiere niei borun miende, niei soghei miende ghadazho. <verse eid="MRK 15:27"/><verse number="29" style="v" sid="MRK 15:29"/>Hhense yozhi daosan kunla sugiezhi qiorunne shuiqizhi kieliezho, "Ai! Chi mechii cheise ghurudude gie khighane giesan, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>chi goyane jiuizhi shizijia jierese bouzhesha!" <verse eid="MRK 15:30"/><verse number="31" style="v" sid="MRK 15:31"/>Fugie buwa, jinwun hanjialaye ingiezhi uzhezhi xiniezhi nieniedene kielienduzho, "Hhe kunlai jiuiwo, goyane jiui dane. <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/><char style="png">Isilie</char>ni honshan Mexiha, ede shizijia jierese bouzhesha, bijien uzhedene xianxin gieye." Hhantu ghadasan kunlaye sugiezho.<verse eid="MRK 15:32"/></para>
  <para style="s">Ersa Duya Ijiezho</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luj 23:44-49</ref>; <ref loc="JHN 19:28-30">Yah 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Zhunwuse xiawu 3 jien olutula zemin man kharalazho. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>3 jien oluse <char style="pn">Ersa</char> fugiede, "Ili, Ili, lamasabagedani?" giezhi waradazho. Isishi, "Mii Huda, mii Huda, chi mii yangiezhi ulie gonjine?" giezho. <verse eid="MRK 15:34"/><verse number="35" style="v" sid="MRK 15:35"/>Kanzide beisan niezhan kunla chenliedene kieliezho, "Uzhe, hhe <char style="pn">Iliya</char>ni waradazho." <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Nie kun holuzhi echi, haimiende cui zhanji, ghulusun jiere banla hhende ughadene kieliezho, "Gouji saghei, matan <char style="pn">Iliya</char> hhei bouzheghale irenu ulie irekui uzheye." <verse eid="MRK 15:36"/><verse number="37" style="v" sid="MRK 15:37"/><char style="pn">Ersa</char> fugiede nie warada, ho sirawo. <verse eid="MRK 15:37"/><verse number="38" style="v" sid="MRK 15:38"/>Ingiekude dajienni sudorodu menlienzi jierese doura kei echidene ghua gholuwo. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Duimiende beisan baifuzhan <char style="pn">Ersa</char> ingiezhi ho sirasei chanladene kieliewo, "Ene kunshi zhenzhenji Hudai kewon enbene!" <verse eid="MRK 15:39"/><verse number="40" style="v" sid="MRK 15:40"/>Pse giedun biereila gholose uzhezho. Hhelai dunda <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, ga <char style="pn">Yagebu</char>, <char style="pn">Yusei</char> ghualai anani <char style="pn">Mereiyen</char>, <char style="pn">Salomi</char> wo. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/><char style="pn">Ersa</char> <char style="png">Jialili</char>de bikude daghazhi ushilasan kunla wo. Pse <char style="pn">Ersa</char>se hhantu <char style="png">Yelusalen</char>de iresan olon biereilaye uzhezho.<verse eid="MRK 15:41"/></para>
  <para style="s">Ersani Bulazho</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luj 23:50-56</ref>; <ref loc="JHN 19:38-42">Yah 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Eneshi zhunbei gieku udu, Hhamuraku uduni melieshi niudu wo. <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>Khara oluse <char style="png">Yalimatai</char>ni <char style="pn">Yusufu</char> irewo. Hheshi fugie fayenni nie noyen wo, kunla man zunjine. Hheye Hudai gojiani sagheizho. Hhe danzine fugiedagha <char style="pn">Bilado</char>i ochirale oro <char style="pn">Ersa</char>i beyei xiahua giezhi kerewo. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/><char style="pn">Bilado</char> <char style="pn">Ersa</char> ijin duya ijiewo giese ghaniradene baifuzhanyi uruzhi ire <char style="pn">Ersa</char> duya ijiezhi nietan oluwoye giezho. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/><char style="pn">Bilado</char> baifuzhanse qinkonyi mejiedene <char style="pn">Ersa</char>i beyeni <char style="pn">Yusufu</char>de ogiwo. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/><char style="pn">Yusufu</char> bosii baerghala agi ire beyeni agi bouzhe boside boui goudagha tashide waisan mezade teiwo. Tashii ghoghoreighazhi meza kouzii duighawo. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/><char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, <char style="pn">Yusei</char>ni anani <char style="pn">Mereiyen</char> beyeni teisan oronyi uzhezho.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Ersa Aminne Oluzho</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="LUK 24:1-12">Luj 24:1-12</ref>; <ref loc="JHN 20:1-10">Yah 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Hhamuraku udu daose <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, <char style="pn">Yagebu</char>i anani <char style="pn">Mereiyen</char>, <char style="pn">Salomi</char> enela <char style="pn">Ersa</char>i beye jiere fureine giezhi xianlio agiwo. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Xinqini ogheikude hhela mezade irewo. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Matande tashii meza kouzise kien ghoghorei daoghane giezhi nieniedene kielienduzho. <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Hhela nie uzhese tashi ghoghorei daozho. Hhe tashi fugie no wo. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Hhela mezade orodene uzhese nie nasuchighan kun borun miende souzho. Chighan fudu jien musizho. Hhela hende ayizho. <verse eid="MRK 16:5"/><verse number="6" style="v" sid="MRK 16:6"/>Nasuchighan kun kieliezho, "Bu ayi! Ta shizijia jiere ghadasan <char style="png">Nasale</char>ni <char style="pn">Ersa</char>i ereizhou? Hhe aminne oluzho. Enende uwo. Hhei jiesan oronni ta uzhe. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Ta echidene tujiladeni <char style="pn">Beduru</char>de kielie, hhe tanse melie <char style="png">Jialili</char>de echine. Tande melieshida kieliesan mutun ta hhende hhei chanlane gie." <verse eid="MRK 16:7"/><verse number="8" style="v" sid="MRK 16:8"/>Hhela hende ayizhi pugharadene mezase khirei holuzho. Ayizhi kunlade yama ese kieliezho. (<char style="pn">Ersa</char> hhelade fenfulasanlai man <char style="pn">Beduru</char>tande jiendande kieliewo. Khuinashi <char style="pn">Ersa</char> tujilai tungo giezhi zhiguitu, ulie widaku, chanqi jiuiku daolini dunmiense ximiende kutula chonjiwo. Amine.)</para>
  <para style="s" vid="MRK 16:8">Modalani Mereiyende Chujiegheghazho</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="JHN 20:11-18">Yah 20:11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">(<verse eid="MRK 16:8"/><verse number="9" style="v" sid="MRK 16:9"/>Xinqii eqiemagha <char style="pn">Ersa</char> aminne oludene xien <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>de chujiegheghazho. <char style="pn">Ersa</char> melieshida hhei jierese dolon sheitan tou khighazho. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Hhe echidene nango giezhi wilazhi sousan tujilade kieliewo. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Hhela <char style="pn">Ersa</char> aminne oluzhi <char style="pn">Mereiyen</char>de chujiegheghawo giesei chenliedene xianxin ese giezho.)</para>
  <para style="s" vid="MRK 16:11">Ghua Tujide Chujiegheghazho</para>
  <para style="r" vid="MRK 16:11">(<ref loc="LUK 24:13-35">Luj 24:13-35</ref>)</para>
  <para style="p" vid="MRK 16:11">(<verse eid="MRK 16:11"/><verse number="12" style="v" sid="MRK 16:12"/>Enense khuinashi tuji dundadu ghuala xiande echine giezhi mo jiere yokude <char style="pn">Ersa</char> pse nie yanzighala chujiegheghawo. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Hhela echidene psedu tujilade kieliese xianxin ese giezho.)</para>
  <para style="s" vid="MRK 16:13">Tujilani Peizhi Echighazho</para>
  <para style="r" vid="MRK 16:13">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:36-49">Luj 24:36-49</ref>; <ref loc="JHN 20:19-23">Yah 20:19-23</ref>; <ref loc="ACT 1:6-8">Tuj 1:6-8</ref>)</para>
  <para style="p" vid="MRK 16:13">(<verse eid="MRK 16:13"/><verse number="14" style="v" sid="MRK 16:14"/>Khuinashida 11 gie tujila ijiekude <char style="pn">Ersa</char> hhelade chujiegheghawo. Hhela <char style="pn">Ersa</char> aminne oludene chanlawo giesan kunlai xianxin ese giese <char style="pn">Ersa</char> hhelai zhughe khidun, xianxin ese giewo giezhi kheilazho. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>Pse hhelade kieliewo, "Ta qienxiade man echizhi gouxioxii soyuji zhayaghasanlade chonji. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Xianxin giezhi xilii jienliese jiuine, xianxin ulie giese zui jinjine. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Xianxin giesan kunla enezighan ghudureqilai giene. Mii niereghala sheitan toune. Shini kielien kieliene. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Khaghala moghei bareizhi yan du ochiliuzhe yama ulie giene. Khane gientulai jiere teise gien goudane.")</para>
  <para style="s" vid="MRK 16:18">Ersa Asiman Jiere Khireizho</para>
  <para style="r" vid="MRK 16:18">(<ref loc="LUK 24:50-53">Luj 24:50-53</ref>; <ref loc="ACT 1:9-11">Tuj 1:9-11</ref>)</para>
  <para style="p" vid="MRK 16:18">(<verse eid="MRK 16:18"/><verse number="19" style="v" sid="MRK 16:19"/>Ezhan <char style="pn">Ersa</char> hhelade kielie baludene hhei asiman jiere jienlie khirei Hudai borun miende soughawo. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Tujila khizhi gochude gouxioxii chonjise Ezhan hhelare hhantu wilie giezho. Ghudureqila daghazhi Hudai kielienyi chonjisande ganzhen beizho. Amine.)<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
