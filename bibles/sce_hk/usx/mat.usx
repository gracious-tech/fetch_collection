  <para style="toc3">Mat</para>
  <para style="mt">Matai Chonjisan Gouxioxi</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s">Ersa Mexihani Xienrenla</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luj 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Eneshi <char style="pn">Ersa</char> Mexihani<note caller="+" style="f"><char style="fr">1:1</char> <char style="em">tosun teisan</char> </note> xienrenlai niereni jilasan shu wo. Hheshi <char style="pn">Iburaheimu</char>, <char style="pn">Dawude</char>ni houdei wo. <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/><char style="pn">Iburaheimu</char>de <char style="pn">Isaghei</char>ni oluwo. <char style="pn">Isaghei</char>de <char style="pn">Yagebu</char>ni oluwo. <char style="pn">Yagebu</char>de <char style="pn">Yuda</char>, gaijiulaini oluwo. <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/><char style="pn">Tama</char> <char style="pn">Yuda</char>de <char style="pn">Falesi</char>, <char style="pn">Xiela</char> ghualai oluwo. <char style="pn">Falesi</char>de <char style="pn">Xisilun</char>ni oluwo. <char style="pn">Xisilun</char>de <char style="pn">Lan</char>ni oluwo. <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/><char style="pn">Lan</char>de <char style="pn">Yaminada</char>ni oluwo. <char style="pn">Yaminada</char>de <char style="pn">Nashun</char>ni oluwo. <char style="pn">Nashun</char>de <char style="pn">Samen</char>ni oluwo. <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/><char style="pn">Lahe</char> <char style="pn">Samen</char>de <char style="pn">Boasi</char>ni oluwo. <char style="pn">Lude</char> <char style="pn">Boasi</char>de <char style="pn">Ebeide</char>ni oluwo. <char style="pn">Ebeide</char>de <char style="pn">Yexi</char>ni oluwo. <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/><char style="pn">Yexi</char>de <char style="pn">Dawude</char> honshanni oluwo.</para>
  <para style="p" vid="MAT 1:6">
    <char style="pn">Uliya</char>ni bierei <char style="pn">Dawude</char>de <char style="pn">Sulumane</char>ni oluwo. <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/><char style="pn">Sulumane</char>de <char style="pn">Loboan</char>ni oluwo. <char style="pn">Loboan</char>de <char style="pn">Yabiya</char>ni oluwo. <char style="pn">Yabiya</char>de <char style="pn">Yasa</char>ni oluwo. <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/><char style="pn">Yasa</char>de <char style="pn">Yeshafa</char>ni oluwo. <char style="pn">Yeshafa</char>de <char style="pn">Yelan</char>ni oluwo. <char style="pn">Yelan</char>de <char style="pn">Uxiya</char>ni oluwo. <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/><char style="pn">Uxiya</char>de <char style="pn">Yetan</char>ni oluwo. <char style="pn">Yetan</char>de <char style="pn">Yahasi</char>ni oluwo. <char style="pn">Yahasi</char>de <char style="pn">Xixijia</char>ni oluwo. <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/><char style="pn">Xixijia</char>de <char style="pn">Manaxi</char>ni oluwo. <char style="pn">Manaxi</char>de <char style="pn">Yamen</char>ni oluwo. <char style="pn">Yamen</char>de <char style="pn">Yexiya</char>ni oluwo. <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>Bexinlai <char style="png">Babilun</char>de touzhi echikude <char style="pn">Yexiya</char>de <char style="pn">Yegeniya</char>, gaijiulani oluwo.<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>Touzhi <char style="png">Babilun</char>de echidene <char style="pn">Yegeniya</char>de <char style="pn">Salaqie</char>ni oluwo. <char style="pn">Salaqie</char>de <char style="pn">Solobabo</char>ni oluwo. <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/><char style="pn">Solobabo</char>de <char style="pn">Yabii</char>ni oluwo. <char style="pn">Yabii</char>de <char style="pn">Iliyajin</char>ni oluwo. <char style="pn">Iliyajin</char>de <char style="pn">Yaso</char>ni oluwo. <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/><char style="pn">Yaso</char>de <char style="pn">Sadu</char>ni oluwo. <char style="pn">Sadu</char>de <char style="pn">Yajin</char>ni oluwo. <char style="pn">Yajin</char>de <char style="pn">Ili</char>ni oluwo. <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/><char style="pn">Ili</char>de <char style="pn">Iliyasa</char>ni oluwo. <char style="pn">Iliyasa</char>de <char style="pn">Madan</char>ni oluwo. <char style="pn">Madan</char>de <char style="pn">Yagebu</char>ni oluwo. <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/><char style="pn">Yagebu</char>de <char style="pn">Yusufu</char>ni oluwo. <char style="pn">Yusufu</char>shi <char style="pn">Mereiyen</char>ni zhanguiji wo. <char style="pn">Mereiyen</char> Mexiha giesan <char style="pn">Ersa</char>i oluwo. <verse eid="MAT 1:16"/><verse number="17" style="v" sid="MAT 1:17"/>Ingiese <char style="pn">Iburaheimu</char>se <char style="pn">Dawude</char>shi 14 dai wo. <char style="pn">Dawude</char>se bexinlai touzhi <char style="png">Babilun</char>de echikude 14 dai wo. Touzhi <char style="png">Babilun</char>de echidene Mexihashi 14 dai wo.<verse eid="MAT 1:17"/></para>
  <para style="s">Ersa Mexihani Oluzho</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luj 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>
    <char style="pn">Ersa</char> Mexihai olusan shiqinshi imutui wo. Hhei anai <char style="pn">Mereiyen</char>ni <char style="pn">Yusufu</char>de boluzho. Dou ese agikude <char style="pn">Mereiyen</char> Shenlinghala kewosi laiwo. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Hhei zhanguijini <char style="pn">Yusufu</char>shi nie gou kun wo. Hhei minminji shizheghaku duran uwo. Qioqioji siraghane giezho. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>Hhe zhen ene shiqinni sumulakude Ezhanni qienxien zhoujindei xienjighazhi kieliewo, "<char style="pn">Dawude</char>ni houdei <char style="pn">Yusufu</char>, chi bu ayidene <char style="pn">Mereiyen</char>ni agizhi ire. Hhe Shenlinghala kewosi laiwo. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Hhe nie kewon olune. Niereini <char style="pn">Ersa</char><note caller="+" style="f"><char style="fr">1:21</char> <char style="em">Huda jiuine</char> </note> giezhi ogi. Hhe bexinlane zui dundase jiuine." <verse eid="MAT 1:21"/><verse number="22" style="v" sid="MAT 1:22"/>Ene shiqinla man fashen giekushi Ezhan xienzhini tungo giezhi kieliesan kielien mutun gholughane giezho,<verse eid="MAT 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23"/>"Nie ese dafalasan oqin kewon laizhi olune.</para>
  <para style="q2" vid="MAT 1:23">Niereini <char style="pn">Imaneili</char> giene."</para>
  <para style="m" vid="MAT 1:23">
    <char style="pn">Imaneili</char>ni isishi Huda matanre hhantu wo. <verse eid="MAT 1:23"/><verse number="24" style="v" sid="MAT 1:24"/><char style="pn">Yusufu</char> xiereidene Ezhanni qienxien fenfulasan mutun biereii agizhi irewoma, <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>kewosi ese olutula ghuala hhantu ese kijiezho. Kewonni oludene hhende <char style="pn">Ersa</char> giezhi niere ogiwo.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s">Aghelitu Kunla Ersani Beiile Irezho</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>
    <char style="pn">Hherode</char> honshan danlakude <char style="pn">Ersa</char>i <char style="png">Yudaya</char>ni <char style="png">Bolihen</char>de oluwo. Dunbangiese aghelitu kunla <char style="png">Yelusalende</char> ire asawo, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>"Olusan hhe nie <char style="png">Yutai</char> kunni honshan khala wine? Bijien dunbangiese hodunyini chanladene hhei beiile irewo." <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/><char style="pn">Hherode</char> honshan enei sonosudene zhughedeni nanran uwo. Nie <char style="png">Yelusalen</char>ni kunladeye nanran uwo. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Ingie honshan bexinlai fugie buwa, jinwun hanjialai man uruzhi hhantulagha asazho, "Mexihani khala olune?" <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Hhela kieliewo, "<char style="png">Yudaya</char>ni <char style="png">Bolihen</char>de olune. Xienzhini shu jiere huaizho,<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>'<char style="png">Yuda</char> oronni <char style="png">Bolihen</char>ya,</para>
  <para style="q2" vid="MAT 2:6">chi <char style="png">Yuda</char>ni chenshi dundase zui gani pusho.</para>
  <para style="q1" vid="MAT 2:6">Mii bexin <char style="png">Isilie</char>yi uduruchen nie lindao</para>
  <para style="q2" vid="MAT 2:6">chii hhense khizhene.'"<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Ingie <char style="pn">Hherode</char> aghelitu kunlai ghulazhi uru iredene hodun yan xienzide khizhesei xianxide asazho. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Ingiedene hhelai <char style="png">Bolihen</char>de peizhi echigha kieliewo, "Ta echidene xianxide hhe kewonni daqinla. Ereizhi oludene made kieliele ire. Biye hhei beiile echine." <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>Hhela honshanyi kielienyi chenliedene echiwo. Dunbangiese chanlasan hhe hodun hhelai melie yozho. Izhi hhe kewonyi qiorun qiende yozhi echi beiwo. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Hhela hodunni chanladene hende bayasuzho. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Giedoura orose kewonni, anaini <char style="pn">Mereiyen</char>yi chanlawo, papaladene hhe kewonni beiiwo. Boubei xiaxiane keighadene antan, xian, guizhuntu caoyeni mure ogiwo. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Huda aghelitu kunlai zhoujinde <char style="pn">Hherode</char>i ochirale bu echi giezhi mejieghase psedu mose goya orondene echiwo.<verse eid="MAT 2:12"/></para>
  <para style="s">Aijide Piile Echizho</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Hhela echidene Ezhanni qienxien <char style="pn">Yusufu</char>i zhoujinde xienjizhi kieliewo, "Chi bosizhedene kewon, anaini uduruzhi <char style="png">Aiji</char>de piile echi. Bi fenfulatula hhende sou. Ene kewonni <char style="pn">Hherode</char> ereizhi alane giezho!" <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>Ingie <char style="pn">Yusufu</char> xienidei bosizhedene kewon, anaini uduruzhi <char style="png">Aiji</char>de echi <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/><char style="pn">Hherode</char> fugutula hhende souwo. Ingiekushi Ezhan xienzhii tungo giezhi kieliesan kielien mutun gholughane giezho, "Bi kewonne <char style="png">Aiji</char>se uruzhi khizhewo."<verse eid="MAT 2:15"/></para>
  <para style="s">Ga Kewonlani Man Alazho</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Aghelitu kunla piendasei <char style="pn">Hherode</char> mejiedene hende hokuzho. Ingiedene aghelitu kunlase hodun kaishi giezhi khizhesan shijienni mejiedene kun peizhi <char style="png">Bolihen</char> chenshi pse zhouwidedu ghuase meilani kewonlai man alawo. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Ingiese Ezhan <char style="pn">Yelimi</char> xienzhii tungo giezhi kieliesan kielien mutun gholuwo,<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>"<char style="png">Rama</char>de nango giezhi hende wilasan shenqini sonosuwo.</para>
  <para style="q2" vid="MAT 2:18">
    <char style="pn">Lajie</char> kesiladene oluzhi wilazho.</para>
  <para style="q1" vid="MAT 2:18">Kesilani man widase sidaghazhi kieliesei ese chenliewo."<verse eid="MAT 2:18"/></para>
  <para style="s">Aijise Nasalede Khareiwo</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>
    <char style="pn">Hherode</char> fugudene Ezhanyi qienxien <char style="png">Aiji</char>de <char style="pn">Yusufu</char>ni zhoujinde xienjighazhi kieliewo, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>"Chi bosizhedene kewosi, anaini uduruzhi <char style="png">Isilie</char> oronde echi. Kewonni alane giesan kunla ijin fuguwo." <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>Ingie <char style="pn">Yusufu</char> bosizhedene kewosi, anaini uduruzhi <char style="png">Isilie</char> oronde khareizhi irewo. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/><char style="pn">Yajilao</char> <char style="pn">Hherode</char> adane oronde <char style="png">Yudaya</char>ni honshan danlasei <char style="pn">Yusufu</char> sonosudene hhende echikuse ayizho. Ingie zhoujindeni Ezhan mejieghase <char style="png">Jialili</char> oronde echidene <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/><char style="png">Nasale</char> giesan chenshide souwo. Ingiekushi Ezhan xienzhilai tungo giezhi, "Hhei <char style="png">Nasale</char> kun giezhi urune." giezhi kieliesan kielien mutun gholughane giezho.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s">Xili Gieghasan Yaheiya Chonjizho</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mak 1:1-8</ref>; <ref loc="LUK 3:1-18">Luj 3:1-18</ref>; <ref loc="JHN 1:19-28">Yah 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Hhe xienzide xili gieghasan <char style="pn">Yaheiya</char> <char style="png">Yudaya</char>ni hontande khizhedene chonjizhi kieliewo, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>"Ta geizhen giendu, asiman gojia chadashiwo!" <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Eneshi <char style="pn">Isaiya</char> xienzhi kieliesan hhe kun wo.</para>
  <para style="q1" vid="MAT 3:3">"Hontande nie kun waradazho.</para>
  <para style="q2" vid="MAT 3:3">'Ezhanni moni zhunbei gie!</para>
  <para style="q2" vid="MAT 3:3">Hhei moni zhidagha!'"<verse eid="MAT 3:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4"/>
    <char style="pn">Yaheiya</char> loto noghosunghala giesan jienyi musizhi arasunni pixie pixieliezho. Hhe ijiesanshi machazi, shimei wo. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/><char style="png">Yelusalen</char>, <char style="png">Yudaya</char>ni go oron, <char style="png">Yedanhe</char>ni idou oronlade sousan kunla man <char style="pn">Yaheiya</char>i hhende echidene <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>zuine renjizhi <char style="png">Yedanhe</char>de <char style="pn">Yaheiya</char>se xili jienliezho.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>
    <char style="pn">Yaheiya</char> olon Falisai kun, Sadugai kunla xili jienliele iresei chanladene kieliewo, "Du mogheini zhunzhughala, kien tande jianlai ireku Hudai hokukuse anda shidane giezhi kieliewo? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Ta geizhen giesanne giekughala zhenmin gie. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/><char style="pn">Iburaheimu</char>shi bijienyi xienren wo giezhi ta zhughedene bu sumula. Bi tande kielieye, Huda ene tashilani <char style="pn">Iburaheimu</char>ni houdei gholugha shidane! <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Ede sugiei mutun genzide teiwo. Gou alima ulie souku mutunlani man chizhidene khande teine. <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>Bi tai geizhen gieghane giezhi usughala xili gieghazhoma, mase khuina iresan kun mase nenli fugie wo. Bi hhende maheini qilaseye pei dane. Hhe Shenlin, khanghala tai xili gieghane. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Hhe khadene baqi bareizhi tughonni boudeii baqiliezhi agidene cankude zhonlone. Arasunlai ulie xinieku khande teine."<verse eid="MAT 3:12"/></para>
  <para style="s">Ersa Xilini Jienliezho</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mak 1:9-11</ref>; <ref loc="LUK 3:21-22">Luj 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Hhe shihoude <char style="pn">Ersa</char> <char style="png">Jialili</char>se <char style="png">Yedanhe</char>de irezhi <char style="pn">Yaheiya</char>se xili jienliene giezho. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/><char style="pn">Yaheiya</char> hhei danlazhi kieliewo, "Bi indan chase xilii jienliese oluzho. Chi matugie mase jienliele irewo?" <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/><char style="pn">Ersa</char> kieliewo, "Chi dain gie. Matan ingiezhi giedene gounilai man chenjighakui wo." Ingiese <char style="pn">Yaheiya</char> dain giewo. <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/><char style="pn">Ersa</char> xilii jienliedene dei ususe khizhekude asiman menzhali keizhi Hudai Ruhher ghoghochen mutun bouzhezhi goyai jiere luisei chanlawo. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Pse asiman jierese shenqi irezhi kieliewo, "Eneshi bi oresan kewon wo. Bi hhende xiqi wo."<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s">Ersani Shiizho</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mak 1:12-13</ref>; <ref loc="LUK 4:1-13">Luj 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Ingiedene Shenlin <char style="pn">Ersa</char>i udurusenu hontande echise Ibilisi hhei shiizho. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/><char style="pn">Ersa</char> 40 qiende xieni udu orozo bareidene oliesuzho. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Shiichen iredene <char style="pn">Ersa</char>de kieliewo, "Chi Hudai kewon enbese enezighan tashii fenfulazhi ginan gholugha." <verse eid="MAT 4:3"/><verse number="4" style="v" sid="MAT 4:4"/><char style="pn">Ersa</char> kieliewo, "Jinwun jiere huaizho,</para>
  <para style="q1" vid="MAT 4:4">'Kun amitushi zinie ginande ulie kouine.</para>
  <para style="q2" vid="MAT 4:4">Hudai amanse khizhesan soyuji kieliende kouine.'"<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Ingie Ibilisi <char style="pn">Ersa</char>i uduruzhi zhiguitu chenshi <char style="png">Yelusalen</char>de echi mechii zui undu oronde beigha <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>kieliewo, "Chi Hudai kewon enbese jiuli bou. Jinwun jiere,</para>
  <para style="q1" vid="MAT 4:6">'Hhe chade oluzhi qienxienladene fenfulazhi khaghalani</para>
  <para style="q2" vid="MAT 4:6">chii feizhi konnichii tashi jiere ulie mughughane.'</para>
  <para style="m" vid="MAT 4:6">giezhi huaizho." <verse eid="MAT 4:6"/><verse number="7" style="v" sid="MAT 4:7"/><char style="pn">Ersa</char> hhende kieliewo, "'Ezhan Hudane bu shii.' giezhi jinwun jiereye huaizho."<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Ibilisi pse hhei uduruzhi tebie undu ula jiere khireidene duyani soyuji gojia, pse gojialani henni man uzheghazhi <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>kieliewo, "Chi papalazhi mii beiise enelai man chade ogiye." <verse eid="MAT 4:9"/><verse number="10" style="v" sid="MAT 4:10"/><char style="pn">Ersa</char> hhende kieliewo, "Ibilisi, chi yola! Jinwun jiere huaizho, 'Zinie Ezhan Hudane beiizhi hhei shunji.'" <verse eid="MAT 4:10"/><verse number="11" style="v" sid="MAT 4:11"/>Ingie Ibilisi <char style="pn">Ersa</char>se likai gie, qienxienla irezhi hhei ushilazho.<verse eid="MAT 4:11"/></para>
  <para style="s">Ersa Chonjizhi Qiiwo</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mak 1:14-15</ref>; <ref loc="LUK 4:14-15">Luj 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>
    <char style="pn">Ersa</char> <char style="pn">Yaheiya</char>i barei echisei mejiedene <char style="png">Jialili</char>de khareiwo. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Khuinashi <char style="png">Jialili</char>ni <char style="png">Nasale</char>se likai gie <char style="png">Jiabainun</char>de echi souwo. Eneshi <char style="png">Xibulun</char>, <char style="png">Nafutali</char>dedu <char style="png">Jialilihai</char>ni kouisan oron wo. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Ingiekushi Ezhan <char style="pn">Isaiya</char> xienzhini tungo giezhi kieliesan kielien mutun gholughane giezho,<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>"<char style="png">Xibulun</char>, <char style="png">Nafutali</char>dedu kunla,</para>
  <para style="q2" vid="MAT 4:15">haibienzini mo jiere,</para>
  <para style="q2" vid="MAT 4:15">
    <char style="png">Yedanhe</char>ni hhemiende</para>
  <para style="q2" vid="MAT 4:15">niman kunlai <char style="png">Jialili</char>de sousan kunla,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>Hhe khara oronde sousan bexinla fugie gonni chanlawo.</para>
  <para style="q2" vid="MAT 4:16">Fugusan oronde sousan kunlade gon zhouiwo."<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Hhe shihouse kaishi giezhi <char style="pn">Ersa</char> chonjizhi kieliewo, "Ta geizhen giendu. Asiman gojia chadashiwo."<verse eid="MAT 4:17"/></para>
  <para style="s">Tujilani Uruzho</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mak 1:16-20</ref>; <ref loc="LUK 5:1-11">Luj 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>
    <char style="pn">Ersa</char> <char style="png">Jialilihai</char> bienzide yokude <char style="pn">Beduru</char> giesan <char style="pn">Ximun</char>, jiuni <char style="pn">Andelie</char> ghuala haide on xiaisei chanlawo. Hhelashi zhaghasun bareisan kun wo. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta iredene mii dagha. Bi tai zhaghasun bareiku mutun kun bareichen gholughane." <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Hhela onni deigo jiedene hhei daghawo. <verse eid="MAT 4:20"/><verse number="21" style="v" sid="MAT 4:21"/><char style="pn">Ersa</char> hhense melie yodene pse gaijiu ghualai chanlawo. Hhelashi <char style="pn">Xibitai</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>i jiuni <char style="pn">Yaheiya</char> wo. Hhela adarene hhantu chon jiere on huduzho. <char style="pn">Ersa</char> hhelai uruse <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>hhela deigo chon, adasene likai gie hhei daghawo.<verse eid="MAT 4:22"/></para>
  <para style="s">Olon Kunlade Gouxioxi Chonjizho</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luj 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>
    <char style="pn">Ersa</char> <char style="png">Jialili</char>ni gochude man yozhi hhelai huitanlade sughazhi Hudai gojiai gouxioxini chonjizhi bexinlai yanyanji gien nouzhi giemeresanlai goudaghazho. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/><char style="pn">Ersa</char>i minshen <char style="png">Xiliya</char>de man chonji kuruwo. Kunla yanyanji gientulai uduruzhi irese <char style="pn">Ersa</char> goudaghawo. Yanyanji giemerezhi tendun shouisan, sheitan heisan, yanjiofen nousan, tanhon giesanlai man ireghazho. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Tebieji olon kunla <char style="png">Jialili</char>, <char style="png">Jijiapoli</char>, <char style="png">Yelusalen</char>, <char style="png">Yudaya</char>, <char style="png">Yedanhe</char>ni dunmiense hhei daghawo.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s">Ula Jieredu Sughasan Kielien</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>
    <char style="pn">Ersa</char> olon kunlai chujieghedene ulade khirei souwo. Tujilani melie irese <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>hhelade sughazhi kielie qiiwo.<verse eid="MAT 5:2"/></para>
  <para style="s">Fuqi Winetu Kun</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luj 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>"Zhughede nanxin kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:3">asiman gojiashi hhelanughun wo.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Nango giechen kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:4">hhelai sidaghazhi kieliene.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Goyane meilade uzhechen kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:5">hhela ghazhai jienliene.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Gundanni giene giezhi oliesuzhi undasuchen kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:6">hhelade kurughane.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Ubali xiichen kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:7">hhelade ubali xiine.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Zhughe ganjintu kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:8">hhela Hudai chujieghene.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Heqishighachen kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:9">hhelai Hudai kewosi giezhi urune.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Gundannide oluzhi heikui shouisan kunlade fuqi wine,</para>
  <para style="q2" vid="MAT 5:10">asiman gojiashi hhelanughun wo."<verse eid="MAT 5:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 5:11"/>"Mii yenyinghala kunla tai shizheghazhi, heizhi, shiheni doghunnighala ghudan kieliezhi tai sugiese tande fuqi wine. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Ta hende bayasundu, asiman jiere tande ogiku jianli fugie wo. Tanse melieshiku xienzhilaiye ingiezhi biizhi daozho."<verse eid="MAT 5:12"/></para>
  <para style="s">Duyani Dansunji Gon</para>
  <para style="r">(<ref loc="MRK 9:50">Mak 9:50</ref>; <ref loc="LUK 14:34-35">Luj 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>"Tashi duyai dansun wo. Dansunde widao widase matugie koudaghane? Yamade inji dadene bendase kunla taine."<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>"Tashi duyai gon wo. Ula jiere beighasan chenshini niuigha dane. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Kun zhulai jienjise ighaghala ulie komorone, zhula teiku teizi jiere jiene. Ingiese nie gie kunlade gieghan wo. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Ingiezhi ta gonne kunlai melie zhouidene kunla ta goude giesei chanlazhi asiman jieredu adadene kuaikui ogigha."<verse eid="MAT 5:16"/></para>
  <para style="s">Guijinni Kieliezho</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>"Bi irese guijin, xienzhilai shuni widaghane giekui ta bu sumula. Bi guijinni widaghale ese irezho, chengun olughale irezho. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Bi tande shuhua kielieye, asiman zemin widatula guijin jieredu nie jienjien nie bihuada ulie widazhi man chengun olune. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Ingiese kienliuzhe enezighan minlin jieredu zui ganii ulie zunjizhi kunlade ulie zunjise olune giezhi sughase asiman gojiade zui gani giezhi urune. Kienliuzhe minlinyi zunjizhi kunlade sughase asiman gojiade fugieni giezhi urune. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Bi tande kielieye, tai gouni jinwun hanjia, Falisai kunlase ulie daose jiedui asiman gojiade oro dane."<verse eid="MAT 5:20"/></para>
  <para style="s">Ho Kuruku</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>"'Kun bu ala! Kun alase panjine.' giezhi eqighanku kunlade kieliesei ta chenliezhi daozhoma, <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>bi tande kielieye, gaijiudene hokuse panjine. Gaijiune, 'Guazi' giese zui fugie fayende lai echine. 'Yanhunzi' giezhi sugiese dozoheini khande orone. <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>Ingiese chi sidagha gieku teizi jiere mure ogikude gaijiuchii chade hokusei sumula irese <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>mureni sidagha gieku teizi konde jiesenu gaijiughalane xien goudadene mure ogile ire. <verse eid="MAT 5:24"/><verse number="25" style="v" sid="MAT 5:25"/>Chi duitoughalane zhale echikude mo jiere ghujighan hheghala gouda. Pse duitou chii panjiku noyende jiuise panjiku noyen chii gunnande jiuizhi bafanzide khane. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Bi tande shuhua kielieye, chi 1 fen baerniliuzhe honjizhi ulie qindaghase bafanzise khizhe dane."<verse eid="MAT 5:26"/></para>
  <para style="s">Piofen Gieku</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>"'Piofen bu gie.' giesan kielienyi ta chenliezhi daozhoma, <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>bi tande kielieye, biereini uzhezhi hu sumulase ijin zhughedeni piofen giewo. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Chii borun nudun chii zui fanjighase waidene benda. Chii beyese iyanzi widazhi beyechii man dozode orokuse gou wo! <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Chii borun kha chii zui fanjighase chizhidene benda. Chii beyese iyanzi widazhi beyechii man dozode orokuse gou wo!"<verse eid="MAT 5:30"/></para>
  <para style="s">Lihun Gieku</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19:9</ref>; <ref loc="MRK 10:11-12">Mak 10:11-12</ref>; <ref loc="LUK 16:18">Luj 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>"Pse, 'Biereine ulie kerese hhende lihun qiuzi ogikuni wo.' giezhi kieliezhoma, <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>bi tande kielieye, biereini lon kijieku yenyinse chugo lihun giese biereini piofen gieghazho. Pse lihun giesan biereini agisan kunye piofen giezho."<verse eid="MAT 5:32"/></para>
  <para style="s">Fayen Gieku</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>"Pse, 'Fayen giesanne bu fura. Ezhande fayen giesanne zunji.' giezhi eqighanku kunlade kieliesei ta chenliezhi daozhoma, <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>bi tande kielieye, yama fayen bu gie. Asimanyi zhiizhi fayen bu gie. Hheshi Hudai baozo wo. <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Zeminyi zhiizhi fayen bu gie. Hheshi Ezhan kon teiku bandou wo. <char style="png">Yelusalen</char>yi zhiizhi fayen bu gie. Hheshi fugie honshanni chenshi wo. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Qiorunne zhiizhi fayen bu gie. Chi qiorun jieredu nie ganzi usunne chighashigha dazhi kharalagha dane. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Tai kielien enbeneshi enbene gie, pushoshi pusho gie. Enense olon kieliese Ibilisinughun wo."<verse eid="MAT 5:37"/></para>
  <para style="s">Bouchou Gieku</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luj 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>"'Nudunde nudun honji, shidunde shidun honji.' giesan kielienyi ta chenliezhi daozhoma, <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>bi tande kielieye, doghun kunlare zodui bu gie. Kunla borun khizhaichii eghise soghei khizhaneye eghigha. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Kunla chii zhazhi chii lizii jienni kerene giese mienzine jienniye ogi. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Kunla chii biizhi 1 li mo yoghase hhere hhantu 2 li mo yo. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Chii xiahua giezhi kerese ogi. Chase dunxi ghuise uwo giezhi bu kielie."<verse eid="MAT 5:42"/></para>
  <para style="s">Duitoudene Ore</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luj 6:27-28</ref>, <ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>"'Ta giebeidene ore, duitoune henji.' giesan kielienyi chenliezhi daozhoma, <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>bi tande kielieye, duitoudene ore, tai heisanlade oluzhi onxian gie. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Ingiezhi giese ta asimanni Adadene kewosi danlane. Hhe naranne doghun kun, gou kunni jiere man zhouighazho. Ghurani gou kun, gou witu kunde man bouzheghazho. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Ta zinie tande oresan kunlade orese tande yan jianli ogine? Lien shui shanjisan kunlaye ingiezhi giene. <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Ta zinie gaijiudene zhaohu daise kunlase giedun gou wo? Lien niman kunlaye ingiezhi giene. <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Ingiese asiman jieredu Adatai onqien biku mutun taye onqienshi."<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s">Nanxin Kunlade Ogiku</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>"Ta gouni giekude xioxin giezhi kunlai melie uzheghane giezhi bu gie. Qingiezhi giese asiman jieredu tai Adase yama jianli jienlie dane. <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>Chi nanxin kunlade ogikude jiazhon giesan kunla mutun bu gie. Hhela goyane kuaighane giezhi huitan, geidoude fugiede tunguliene. Bi tande shuhua kielieye, hhelade jianli ijin ogiwo. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Chi nanxin kunlade ogikude borun kha giesei soghei khade bu mejiegha. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Chi ogisanne kunlade bu mejiegha. Beichazide uzhesan Adachii tande jianli ogine."<verse eid="MAT 6:4"/></para>
  <para style="s">Onxian Gieku</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>"Ta onxian giekude jiazhon giesan kunla mutun bu gie. Hhela kunlade uzheghane giezhi huitan, shizilukoude beidene onxian giekude xiqi wo. Bi tande shuhua kielieye, hhelade jianli ijin ogiwo. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Ta onxian giekude giedera orodene wijienyi khadene beichazide bisan Adasene onxian gie. Beichazide uzhesan Adachii jianli ogine. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Ta onxian giekude niman kunla mutun touchan erchanji yama isi witu kielienyi bu kielie. Hhela sumulase ologhan kieliese chenliemu giezho. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Ta hhela mutun bu gie. Ta xiahua gieku melie ta yan keresei Adatai mejiene."<verse eid="MAT 6:8"/></para>
  <para style="s">Ezhan Sughasan Onxian</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luj 11:2-4</ref>)</para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 6:9"/>"Ingiese ta ingiezhi onxian gie,</para>
  <para style="q1" vid="MAT 6:9">'Asiman jieredu mai Ada,</para>
  <para style="q2" vid="MAT 6:9">chi nierene zhiguishigha.<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Chii gojiai iregha.</para>
  <para style="q2" vid="MAT 6:10">Chi isine asiman jiere mutun</para>
  <para style="q2" vid="MAT 6:10">zemin jiere chenjigha.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Niudunieku ijiuni enedu bijiende ogi.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Bijiende codasan kunlai bijien rouliesan mutun</para>
  <para style="q2" vid="MAT 6:12">bijien codasei roulie.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Bijienyi shiikude bu echighazhi</para>
  <para style="q2" vid="MAT 6:13">Ibilisii khase khizhegha.</para>
  <para style="q1" vid="MAT 6:13">Gojia, qienli, famashi chanqi chinughun wo. Amine!'<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Kunla codasei ta rouliese asiman jieredu Adataiye tai rouliene. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Kunla codasei ta ulie rouliese asiman jieredu Adataiye tai ulie rouliene."<verse eid="MAT 6:15"/></para>
  <para style="s">Orozo Bareiku</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>"Ta orozo bareikude jiazhon giesan kunla mutun uxinne bu bougha. Hhela orozo bareisei kunlade mejieghane giezhi guyide ghuniraku yanzi khizheghane. Bi tande shuhua kielieye, hhelade jianli ijin ogiwo. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Chi orozo bareikude qiorunne sanlazhi nune waghadene <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>orozo bareisei kunlade bu chujiegheghazhi beichazide bisan Adadene uzhegha. Ingiese beichazide uzhesan Adachii chade jianli ogine."<verse eid="MAT 6:18"/></para>
  <para style="s">Boubeini Asiman Jiere Sunji</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luj 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>"Goyadene oluzhi boubeini zemin jiere bu sunji. Zemin jiere ghughei ghazhazhi xiuqirane. Ghughei nudurun waizhi ghulane. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Boubeini asiman jiere sunji. Asiman jiere ghughei ghazha dane, ulie xiuqirane. Ghughei nudurun waizhi ghula dane. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Chii boubei khalashi zhughechiiye khala wo."<verse eid="MAT 6:21"/></para>
  <para style="s">Beyeni Zhula</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luj 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>"Nudunchiishi beyeni zhula wo. Nudunchii goushi beyechii man gieghan wo. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Nudunchii gou wise beyechii man khara wo. Chii sudorodu gon kharashi hhe kharani zhengiejia fugie wo. <verse eid="MAT 6:23"/><verse number="24" style="v" sid="MAT 6:24"/>Kienliuzhe ghua ezhanni shunji dane. Ene niede henjise hhe niede orene. Ene niede gundushi hhe niede gongien wo. Ta Huda baer ghualai hhantu shunji dane."<verse eid="MAT 6:24"/></para>
  <para style="s">Munan Bu Gie</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luj 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>"Ingiese bi tande kielieye, ta amindene oluzhi yan ijiene, ochine giezhi munan bu gie. Beyedene oluzhi yan musine giezhi munan bu gie. Amin ijiekuse zhunyo uwonu? Beye musikuse zhunyo uwonu? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Ta asiman jieredu bunzhulai nie sumula, hhela ulie tareine, ulie ghurane, cankude ulie sunjine, tai asiman jieredu ada hhelai qiezhene. Ta bunzhulase zhunyo uwonu? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Tani dunda kien zhughe chilakughala aminne niecha fududagha shidane? <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/>Musikude yangiezhi munan giezho? Ta banche jieredu baihe chizhe matugie osisei nie sumula, hhela ulie khishilane, bosiye ulie giene. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Bi tande kielieye, <char style="pn">Sulumane</char> honshan zui henni xienzide musisanla ene nie chizhede ulie kurune. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Ta goude xianxin ulie giechen kunla, banche jieredu osun enedu wine, maghashijie luzide teiliuzhe Huda dou ingiezhi dabalaghazho. Tai qingie ulie gienu? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Ingiese, 'Ta yan ijiene? Yan ochine? Yan musine?' giezhi zhughe bu chila. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Enelashi man niman kunla xiahua giekuni wo. Asiman jieredu Adatai tande enezighan chaisanlai man mejiene. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Ta xien Hudai gojia, hhei gundanni xiahua gie, ingiese enelai man tande ogine. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Ingiese ta maghashijiekude munan bu gie. Maghashijiekude maghashijie munan giekui wine. Niuduku chijiani niudushi kuruzho."<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s">Kunlani Bu Kielie</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luj 6:37-38</ref>, <ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>"Ta kunlai bu kielie, pse taiye kieliene. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Ta kunlai matui kieliese taiye qingiezhi kieliene. Ta yanghala nanjizhi ogise tandeye yanghala nanjizhi ogine. <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>Chi yangiezhi gaijiune nudundedu osun zhazhai chanlane, goya nudundedu lianni chanla dane? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Chii nudunde lian bidene matui gaijiudene, 'Bi chini nudundedu osun zhazhai agiye.' giezhi kieliene? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Chi ene jiazhon giesan kun, xien goya nudundedu lianni agidene uzhezhi qinchu olusenu gaijiune nudundedu osun zhazhai agi."<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>"Zhiguitu dunxini nogheide bu ogi. Ochira daozhese tai zhoune. Manouni khigheini melie bu tei. Khigheila manouni taine."<verse eid="MAT 7:6"/></para>
  <para style="s">Xiahua Giese Tande Ogine</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luj 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>"Ta xiahua gie, tande ogine. Erei, ereizhi olune. Wijienni eghi, tande niene. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Xiahua giechen kunlade ogine. Ereichen kunla ereizhi olune. Wijienni eghichen kunlade niene. <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>Tai dunda yan kunyi kewon ginan kerese tashi ogine? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Zhaghasun kerese moghei ogine? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Ta gou wiliuzhe kesiladene gouni ogikuni mejiene, asiman jieredu Adatai xiahua giechen kunlade gou dunxini genjia ulie oginu? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Ingiese ta kunlai goyadene matugie gieghaku duranshi taye kunlade qingiezhi gie. Eneshi guijin, xienzhilai shu wo."<verse eid="MAT 7:12"/></para>
  <para style="s">Witan Wijiense Oro</para>
  <para style="r">(<ref loc="LUK 13:24">Luj 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>"Ta witan wijiense oro. Fugughakude uduruku wijien fugie wo. Mo aghui wo. Orochen kun olon wo. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Aminde uduruku wijien witan wo. Mo yozhi chijia wo. Ereizhi oluchen kun choghon wo."<verse eid="MAT 7:14"/></para>
  <para style="s">Alimaghala Mutunni Mejiene</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luj 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>"Ta jia xienzhilai fangula. Hhela ghoni arasunyi zhozhi tai enende irene, sudoroni wizha zhanghei wo. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Hhelai alimaghala hhelai tanine. Eghesun jierese putou zhei shidanu? Osun jierese uhuago zhei shidanu? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Jien gou mutun jiere gou alima soune. Langan mutun jiere langan alima soune. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Gou mutun jiere langan alima sou dane. Langan mutun jiere gou alima sou dane. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Jien gou alima ulie souku mutunlai chizhidene khande teine. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Ingiese hhelai alimaghala hhelai tanine."<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>"Mii, 'Ezhan, Ezhan!' giezhi waradachen kunla man asiman gojiade orokui pusho. Zinie asimandedu Adaimi kielien mutun giechen kunla orone. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Hhe zuihouku udude olon kunla made kieliene, 'Ezhan, Ezhan, bijien chini niereghala chonjiwola? Chini niereghala sheitanlai touwola? Chini niereghala olon nenlitu shiqin giewola?' <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Hhe shihoude bi mindaminji hhelade kieliene, 'Bi tai tani dane. Ta enezighan uhun kunla, mase likai gie!'"<verse eid="MAT 7:23"/></para>
  <para style="s">Tashi, Shazi Jiere Beighasan Gie</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luj 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>"Ingiese mii enezighan kielienyi chenliedene giesan kunshi jienzha kun wo. Hoxian gieni fugie tashi jiere giesanghala niekielien wo. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Ghura bou, fugie usu chunji, kei hende feiliezhi eghiliuzhe gieni ulie enbereine. Gieni jigunni fugie tashi jiere giezho. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Mii enezighan kielienyi chenliedene ulie giesan kunshi men kun wo. Hoxian gieni shazi jiere giesanghala niekielien wo. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Ghura bou, fugie usu chunji, kei hende feiliezhi eghise gie enbereine. Da enbereisan fugie wo."<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>
    <char style="pn">Ersa</char> enezighan kielienyi jianji baraghase olon kunla hhe sughasande ghanirazho. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/><char style="pn">Ersa</char> hhelade sughadan hhelai jinwun hanjialai buxian wo, nie qienlitu kunni xianli.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s">Pifugientuni Goudaghazho</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mak 1:40-45</ref>; <ref loc="LUK 5:12-16">Luj 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>
    <char style="pn">Ersa</char> ula jierese bouzhi irese tebieji olon kunla hhei daghawo. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Ingiekude nie pifugientu <char style="pn">Ersa</char>i melie ire papaladene kieliewo, "Ezhan, chi duran bise mini ganjinragha shidane." <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/><char style="pn">Ersa</char> khane zhighazhi hhei maqizhi kieliewo, "Bi duran wine. Chi ganjinra!" Ingiese hhei pifugienni deigo ganjinrawo. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/><char style="pn">Ersa</char> hhende kieliewo, "Chi kiemade bu kieliedene echizhi beyene buwade uzhegha. <char style="pn">Musa</char>i shu jiere fenfulasan mutun Hudade mure ogizhi kunlade ganzhen bei."<verse eid="MAT 8:4"/></para>
  <para style="s">Baifuzhanni Hojini Goudaghazho</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luj 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>
    <char style="pn">Ersa</char> <char style="png">Jiabainun</char>de orose nie baifuzhan melieni irezhi <char style="pn">Ersa</char>i xiahua giezhi kieliewo, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>"Ezhan, hojimi tanhon giesenu giede kijiedene tendun shouizho." <verse eid="MAT 8:6"/><verse number="7" style="v" sid="MAT 8:7"/><char style="pn">Ersa</char> hhende kieliewo, "Bi hhei goudaghale yoye." <verse eid="MAT 8:7"/><verse number="8" style="v" sid="MAT 8:8"/>Baifuzhan kieliewo, "Ezhan, chi mii giede irese bi pei dane. Chii nie aman kielienshi hojimi goudane. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Biye kunlai kha doura wo, buduila mii kha doura wo. Bi buduiladene, 'Echi!' giese echine, 'Ire!' giese irene, 'Enei gie!' giese hhe giene." <verse eid="MAT 8:9"/><verse number="10" style="v" sid="MAT 8:10"/><char style="pn">Ersa</char> chenliedene ghanirazhi daghasan kunlade kieliewo, "Bi tande shuhua kielieye, bi intu xianxin giekui <char style="png">Isilie</char>de uzhezhi uye daozho. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Bi tande kielieye, dunmien ximiense olon niman kunla irezhi asiman gojiade <char style="pn">Iburaheimu</char>, <char style="pn">Isaghei</char>, <char style="pn">Yagebu</char>re hhantu xi soune. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Kharei <char style="png">Isilie</char> kunlai tousenu ghadanedu kharanide echighase hhela hhende shidunne zhouzhi wilane." <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>Ingie <char style="pn">Ersa</char> baifuzhande kieliewo, "Chi kharei. Chi xianxin giesan mutun gholu gie." Hhe shihoude hojini goudawo.<verse eid="MAT 8:13"/></para>
  <para style="s">Olon Kunlani Goudaghazho</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mak 1:29-34</ref>; <ref loc="LUK 4:38-41">Luj 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>
    <char style="pn">Ersa</char> <char style="pn">Beduru</char>i giede echise <char style="pn">Beduru</char>i ghadunmekieni fashao giedene kijiesei chanlawo. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/><char style="pn">Ersa</char> hhei khani nie maqise fashao giesan daodene hhe bosizhe <char style="pn">Ersa</char>i ushilawo. <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>Khara oluse kunla sheitan heisan olon kunlai <char style="pn">Ersa</char>i shida uduru irewo. <char style="pn">Ersa</char> nie aman kielienghala sheitanlai tou khighawo. Pse gien wineku kunlai man goudaghawo. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Ingiekushi Ezhan <char style="pn">Isaiya</char> xienzhii tungo giezhi kieliesan kielien mutun gholughane giezho,</para>
  <para style="q1" vid="MAT 8:17">"Hhe matanyi bixinni deilawo.</para>
  <para style="q2" vid="MAT 8:17">Matanyi gienlai danjiwo."<verse eid="MAT 8:17"/></para>
  <para style="s">Ersani Daghaku</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luj 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>
    <char style="pn">Ersa</char> olon kunla hhei wiqisei chujieghedene, "Hai duimiende daoye!" giezhi fenfulawo. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Nie jinwun hanjia melie ire hhende kieliewo, "Loushi, chi khala echise bi chii daghane." <verse eid="MAT 8:19"/><verse number="20" style="v" sid="MAT 8:20"/><char style="pn">Ersa</char> kieliewo, "Funieghede dun wine, asiman jieredu bunzhude ho wine, Kunnikewonde nie zhentou teiku oronda uwo." <verse eid="MAT 8:20"/><verse number="21" style="v" sid="MAT 8:21"/>Pse nie tuji iredene <char style="pn">Ersa</char>de kieliewo, "Ezhan, bi xien adane bulale echiye." <verse eid="MAT 8:21"/><verse number="22" style="v" sid="MAT 8:22"/><char style="pn">Ersa</char> hhende kieliewo, "Fugusan kun fugusan kunlane bulale echi gie. Chi mii dagha."<verse eid="MAT 8:22"/></para>
  <para style="s">Keini Beighazho</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mak 4:35-41</ref>; <ref loc="LUK 8:22-25">Luj 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>
    <char style="pn">Ersa</char> chon jiere khireise tujilani hhei daghazho. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Menzhali hai jiere fugie kei bosiwo. Lan chabudu chonni unaghane. <char style="pn">Ersa</char> da hhunturazho. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Tujilani echizhi <char style="pn">Ersa</char>i uru xiereigha kieliewo, "Ezhan, bijienyi jiui! Bijienyi amin widane giezho!" <verse eid="MAT 8:25"/><verse number="26" style="v" sid="MAT 8:26"/><char style="pn">Ersa</char> kieliewo, "Ta ene Hudai gou xianxin ulie giechen kunla, yangiezhi ayizho?" Ingie bosizhedene kei, haini nie sugiese nanranghane gholuwo. <verse eid="MAT 8:26"/><verse number="27" style="v" sid="MAT 8:27"/>Kunla ghaniradene kieliewo, "Eneshi yan kun wo? Kei, haiye kielienyini chenliene."<verse eid="MAT 8:27"/></para>
  <para style="s">Ghua Sheitan Heisan Kunni Goudaghazho</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mak 5:1-20</ref>; <ref loc="LUK 8:26-39">Luj 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>
    <char style="pn">Ersa</char> hai duimiende daosenu <char style="png">Jiadala</char> kunyi oronde irewo. Ghua sheitan heisan kun mezase khizhedene hhei shida texien wizhashi kiemada hhe mose yo dazho. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Hhela deigo warada qiiwo, "Hudai kewon, chi bijienyi jiohoro bu gie. Shihou da uye kuruzho, chi enende irezhi bijienyi zayalanu?" <verse eid="MAT 8:29"/><verse number="30" style="v" sid="MAT 8:30"/>Hhelase gouji gholode idaban khighei ijiezhi souzho. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Sheitanla <char style="pn">Ersa</char>i xiahua giezhi chi bijienyi tou khighane giese bijienyi khighei jiere echigha giewo. <verse eid="MAT 8:31"/><verse number="32" style="v" sid="MAT 8:32"/>Ingie <char style="pn">Ersa</char> echi giese sheitanla khizhedene khigheilai jiere khiwo. Menzhali khigheila egheide chunji bou, haide yenji alawo. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Khighei adulasan kunla holudene chenshide echi sheitan heisan ene kunlai shiqinyi kunlade man kieliewo. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Ingiese nie chenshini kunla man <char style="pn">Ersa</char>i ochirale khizhewo. Hhei uzhedene, "Enense likai gie." giezhi xiahua giewo.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s">Tanhon Giesan Kunni Goudaghazho</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mak 2:1-12</ref>; <ref loc="LUK 5:17-26">Luj 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>
    <char style="pn">Ersa</char> chon jiere khirei hai hhemiende daozhi goya chenshidene irewo. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Ingiekude kunla nie tanhon giesan gientui ruzide qienlie <char style="pn">Ersa</char>i shida irewo. <char style="pn">Ersa</char> hhelai xianxin giekui uzhedene tanhon giesan gientude kieliewo, "Gaijiu, zhughene tei, chii zuini mienliewo." <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>Ingiekude giedun jinwun hanjiala zhughedene kieliezho, "Ene kun kufurei fanjizho!" <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/><char style="pn">Ersa</char> hhela yan sumulasei mejiedene kieliewo, "Ta zhughedene yale doghunni sumulane? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>'Chii zuini mienliewo.' giese sunfan onu, 'Bosizhe yo.' giese sunfan wo? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Kunnikewon duyade zuini mienlieku qienli bikui tande mejieghane giezho." Ingiedene tanhon giesan gientude kieliewo, "Bosidene ruzine agi, giedene echi!" <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Hhe kun bosidene giedene echiwo. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Kunla chanladene man ayizho. Imutu fugie qienlini kunlade ogiwo giezhi Hudai kuaizho.<verse eid="MAT 9:8"/></para>
  <para style="s">Mataini Uruzho</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mak 2:13-17</ref>; <ref loc="LUK 5:27-32">Luj 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>
    <char style="pn">Ersa</char> hhense melie yose <char style="pn">Matai</char> giesan nie kun shui shanjisan oronde sousei chanlawo. Hhende kieliewo, "Chi mii dagha." Ingie hhe bosizhedene <char style="pn">Ersa</char>i daghawo.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>
    <char style="pn">Ersa</char> giedera ijiekude olon shui shanjisan kun, zuirenla <char style="pn">Ersa</char>, <char style="pn">Ersa</char>i tujilare man hhantu soudene ijienduzho. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Falisai kunla chanladene <char style="pn">Ersa</char>i tujilade kieliezho, "Tai loushi yale shui shanjisan kun, zuirenlare hhantu ijiene?" <verse eid="MAT 9:11"/><verse number="12" style="v" sid="MAT 9:12"/><char style="pn">Ersa</char> sonosudene kieliewo, "Gien witu kunla deifu ulie kerene, gientula deifu kerene. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Ta echidene, 'Bi ubali xiikude xiqi wo, murede xiqi uwo.' giesan jinwun jieredu ene kielienyi isii suru. Bi gou kunlai ereile ese irezho. Zuirenlai ereile irezho."<verse eid="MAT 9:13"/></para>
  <para style="s">Orozoni Shiqin</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mak 2:18-22</ref>; <ref loc="LUK 5:33-39">Luj 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Ingiekude <char style="pn">Yaheiya</char>ni tujila <char style="pn">Ersa</char>i ochirale ire kieliewo, "Bijien, pse Falisai kunla chan orozo bareizho, chii tujila yale orozo ulie bareine?" <verse eid="MAT 9:14"/><verse number="15" style="v" sid="MAT 9:15"/><char style="pn">Ersa</char> hhelade kieliewo, "Ghurunde iresan zhochenla shini khughon bikude matugie nango giene? Shini khughonni kunla lai echiku udu kuzhene. Hhe shihoude hhela orozo bareine. <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/>Shini popui khuichen jien jiere huduchen kun uwo. Qingiese hudusan oron jienni qida olughane, tanturasan pse fugiedane. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Shini jiuni khuichen tulunde zhonlochen kun uwo. Qingie zhonlose tulun ghaluzhi jiu usuru khizhese tulunye qida olune. Shini jiuni shini tulunde zhonlose ghuala gou wo."<verse eid="MAT 9:17"/></para>
  <para style="s">Noyenni Oqinji Chusun Usurusan Biereini Goudaghazho</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mak 5:21-43</ref>; <ref loc="LUK 8:40-56">Luj 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>
    <char style="pn">Ersa</char> hhelade zhen ene kielienyi kieliekude nie huitan gonjisan kun ire papalazhi kieliewo, "Mii oqin jian duya ijiewo. Chi yodene hhei jiere khane teizhi onxian giema, hhe aminne olune." <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/><char style="pn">Ersa</char> bosizhedene tujilarene hhantu hhei daghazhi echiwo.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Zhen qingiekude nie chusun usuruzhi 12 nien olusan bierei <char style="pn">Ersa</char>i khuina iredene jien ghizhaseni nie maqiwo. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Hhe "<char style="pn">Ersa</char>i jienni nie maqise gienni goudane." giezhi zhughedene sumulazho. <verse eid="MAT 9:21"/><verse number="22" style="v" sid="MAT 9:22"/><char style="pn">Ersa</char> ochira daozhe hhei uzhezhi kieliewo, "Funi, zhughene tei! Chii xianxin gieku chii jiuiwo." Hhe shihoude bierei goudawo.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>
    <char style="pn">Ersa</char> gonjisan kunni giede kuruse kunla fugusan kunde xiu feiliezhi lon chouisei chanlawo. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Ingie kieliewo, "Daodu. Oqin ese duya ijiezho, hhunturazho." Ingiese hhela <char style="pn">Ersa</char>i uzhezhi xiniezho. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Kunlai khighadene <char style="pn">Ersa</char> oro echi oqinni khase nie laise oqin bosizhewo. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Ene xioxi hhe oronde man chonji kuruwo.<verse eid="MAT 9:26"/></para>
  <para style="s">Ghua Sughoi Goudaghazho</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>
    <char style="pn">Ersa</char> hhense melie yose ghua sugho hhei daghadene waradazho, "<char style="pn">Dawude</char>ni houdei, bijiende ubali nie xii!" <verse eid="MAT 9:27"/><verse number="28" style="v" sid="MAT 9:28"/><char style="pn">Ersa</char> giedera orose sughola hhei melie irewo. <char style="pn">Ersa</char> kieliewo, "Bi ene shiqinyi gie shidakui ta xianxin gienu?" Hhela kieliewo, "Ezhan, bijien xianxin giene!" <verse eid="MAT 9:28"/><verse number="29" style="v" sid="MAT 9:29"/><char style="pn">Ersa</char> hhelai nudunyi moizhi kieliewo, "Ta xianxin giesan mutun gholu gie." <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Ingiese hhelai nudun goudawo. <char style="pn">Ersa</char> hhelade hende fenfulazhi, "Ta ene shiqinyi kunlade bu mejiegha." giewo. <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Ingieliuzhe hhela khizhi echidene <char style="pn">Ersa</char>i xioxii hhe oronde man chonji kurughawo.<verse eid="MAT 9:31"/></para>
  <para style="s">Yabani Goudaghazho</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Hhela khizhi echikude kunla nie sheitan heisan yabai <char style="pn">Ersa</char>i shida uduru irewo. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Sheitanni touzhi khighase yaba kielien kielie qiiwo. Kunla man ghanirazhi kieliewo, "<char style="png">Isilie</char>de intu shiqin uzhezhi ese daowo!" <verse eid="MAT 9:33"/><verse number="34" style="v" sid="MAT 9:34"/>Falisai kunla kieliezho, "Hhe sheitanni touzii kouizhi sheitan touzho."<verse eid="MAT 9:34"/></para>
  <para style="s">Olon Kunlade Ubali Xiizho</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>
    <char style="pn">Ersa</char> go chenshi, aghinlai yo baraghazhi hhelai huitanlade kunlade sughazhi asiman gojiani gouxioxini chonjizho. Yanyanji gien nouzhi giemeresanlai goudaghazho. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Olon kunlai chanladene ubali xiizho. Hhela kunnan wo, banman giechen uwo. Ghonide asuchi uwokughala niekielien wo. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Ingie tujiladene kieliewo, "Zhonjia olon wo, wiliechi choghon wo. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Ta zhonjiani ezhanyi xiahua giezhi wiliechilai peidene zhonjiane ghuragha gie."<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s">12 Gie Shituni Sunghuzho</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mak 3:13-19</ref>; <ref loc="LUK 6:12-16">Luj 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>
    <char style="pn">Ersa</char> 12 gie tujine uruzhi iresenu hhelade zannan ruhher touzhi yanyanji gien nouzhi giemeresanlai goudaghaku qienli ogiwo. <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>12 gie shituni tou 1 gieni niereshi, <char style="pn">Beduru </char> giezhi urusan <char style="pn">Ximun</char>, hhei jiu <char style="pn">Andelie</char>, <char style="pn">Xibitai</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>ni gaijiu <char style="pn">Yaheiya</char>, <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/><char style="pn">Feili</char>, <char style="pn">Badolomai</char>, <char style="pn">Doma</char>, shui shanjisan <char style="pn">Matai</char>, <char style="pn">Yalefei</char>ni kewon <char style="pn">Yagebu</char>, <char style="pn">Datai</char>, <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>Rexinpaini <char style="pn">Ximun</char>, pse <char style="pn">Ersa</char>i ghudandusan <char style="png">Jialie</char> kun <char style="pn">Yuda</char> wo.<verse eid="MAT 10:4"/></para>
  <para style="s">12 Gie Shituni Peizhi Echighazho</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mak 6:7-13</ref>; <ref loc="LUK 9:1-6">Luj 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>
    <char style="pn">Ersa</char> ene 12 gie kunni peizhi echighakude fenfulazhi kieliewo, "Ta niman kunlai oronde bu echi. <char style="png">Samaliya</char> kunlai chenshide bu oro. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Zinie <char style="png">Isilie</char> kunla dunda echi. Hhela miisan ghoni niekielien wo. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Xien yo xien chonjizhi kielie, 'Asiman gojia chadashiwo!' <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Giemeresan kunlai goudaghazhi fugusan kunlai aminne olugha. Pifugientulai ganjinraghazhi sheitanlani tou khigha. Ta belien jienliewoma, belien ogi. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Kakadene antan, miengu, baer bu barei. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Mo yose kuabao, ghua jien, mahei, zhugun bu barei. Wilie giechen kunla ijiuni indan jienliekuni wo. <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>Ta alinie chenshi, aghinde echise gou kun khala bikui daqinladene likai gietula hhei giede sou. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Hheni giede orokude salan gie. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Hhe giei kunla tai pei shidase ta onxian giesan pinnan hhelai jiere wo. Pei dase ta onxian giesan pinnan yen tai jiere irene. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Kien tai ulie jienliezhi kielienyi ulie chenliese hhei gie, hhe chenshise likai giekude kon jieredu turane kui bougha. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Bi tande shuhua kielieye, panjiku udude hhe chenshi shouiku zeinan <char style="png">Sodoma</char>, <char style="png">Emola</char> oronse da fugie wo!"<verse eid="MAT 10:15"/></para>
  <para style="s">Kunla Tujilani Heine</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mak 13:9-13</ref>; <ref loc="LUK 21:12-19">Luj 21:12-19</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>"Uzhe, bi tai peizhi echighase ghonilai zhanghei dunda echighasan niekielien wo. Ingiese ta moghei mutun jienzharazhi ghoghochen mutun ganjinra. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>Ta kunlai xioxin gie. Kunla tai zui fugie fayende jiuine. Hhelai huitanlade mabienzighala eghine. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Mii yenyinghala tai shenzhan, honshanlai melie lai echine. Ta hhelai melie, niman kunlai melie made ganzhen beine. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Kunla tai jiuikude ta matui, yan kieliekui munan bu gie. Hhe shihoude yan kieliekui tande mejieghane. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Kieliesanshi ta pusho, Adaitai Ruhher tai sudoro kieliezho. <verse eid="MAT 10:20"/><verse number="21" style="v" sid="MAT 10:21"/>Gaijiu gaijiune, ada kewosine ghudanduzhi fugughakude jiuine. Kesila ada, anane zodui giezhi fugughakude kune. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Mii yenyinghala soyuji kunla tai henjine. Ingieliuzhe rennai giezhi zuihou kusanlai jiuine. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Kunla tai ene chenshide heise da nie chenshide holu. Bi tande shuhua kielieye, <char style="png">Isilie</char>ni chenshilai ta yozhi baraghatula Kunnikewon irene."<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>"Xieshen loushise fugie uwo, hoji ezhanse fugie uwo. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Xieshen loushighala niekielien, hoji ezhanghala niekielien gholuse kuruwo. Kunla gieni zhanguijini, 'Sheitanni touzi.' giezhi sugiese gieni kunlai genjia ulie sugienu?"<verse eid="MAT 10:25"/></para>
  <para style="s">Bu Ayi</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luj 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>"Ingiese ta hhelase bu ayi. Khaghasanlai ulie khizheghakui uwo. Niuighasanlai ulie mejieghakui uwo. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Bi tande beichazide kieliesei ta mindamin kielie. Ta chighindene chenliesei gie jierese fugiede kielie. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Beyeni alane, ruhherni ala dachen hhelase bu ayi. Zinie beye, ruhher ghualai widaghadene dozoheide echigha shidachen hhense ayi. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Ghua bunzhui 1 mao baer huinela? Ingieliuzhe asimanni adatai dain ulie giese nieda andazhi bouzhe dane. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Tai kieliese tai qiorun jieredu usunniliuzhe toulazhi agizho. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Ingiese ta bu ayi, ta olon bunzhulase zhunyo wo."<verse eid="MAT 10:31"/></para>
  <para style="s">Kunlani Melie Mexihani Renji</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luj 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>"Kien kunlai melie mini renjise biye asiman jieredu adane melie hhei renjine. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Kien kunlai melie mini ulie renjise biye asiman jieredu adane melie hhei ulie renjine."<verse eid="MAT 10:33"/></para>
  <para style="s">Tuji Danlaku Daijia</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luj 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>"Bi irekushi zemin jiere pinnan deilazhi iresei ta bu sumula. Bi irekushi pinnan deilazhi ese iredene khudogho deilazhi irezho. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Bi irekushi,</para>
  <para style="q1" vid="MAT 10:35">'Kun adarene, oqin anarene, konbierei ghadunmekierene</para>
  <para style="q2" vid="MAT 10:35">zodui gieghale irezho.<verse eid="MAT 10:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="MAT 10:36"/>Kunni duitoushi gieni kun wo.'<verse eid="MAT 10:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 10:37"/>Ada anadene mase olon orese mii pei dane. Kesiladene mase olon orese mii pei dane. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Kien shizijiane beiliezhi mii ulie daghase mii pei dane. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Aminne ulie widaghane giese aminne widaghane. Made oluzhi aminne widaghase aminne ulie widaghane."<verse eid="MAT 10:39"/></para>
  <para style="s">Jianli Ogiku</para>
  <para style="r">(<ref loc="MRK 9:41">Mak 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>"Kun tai jienliese mii jienliezho. Mii jienliese mii peizhi ireghasan hhei jienliezho. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Kien xienzhini xienzhi danlaghazhi jienliese xienzhini jianlini linlane. Kien gou kunni gou kun danlaghazhi jienliese gou kunni jianlini linlane. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Bi tande shuhua kielieye, kien mii tujila dundadu zui ganide mii tuji danlaghazhi nie beizi usu ogiliuzhe hhende jianli kenjin ogine."<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>
    <char style="pn">Ersa</char> 12 gie tujidene fenfulazhi baludene hhense likai gie hhelai go chenshilade echizhi kunlade sughazhi chonjizho.<verse eid="MAT 11:1"/></para>
  <para style="s">Yaheiya Tujilane Ersai Uzheghale Echizho</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luj 7:18-35</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>
    <char style="pn">Yaheiya</char> bafanzise Mexiha giesan shiqinyi sonosudene tujilane peizhi echighawo. <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>Hhela <char style="pn">Ersa</char>de asawo, "Hhe irene giesanshi chi onu, bijien pse niei saghei?" <verse eid="MAT 11:3"/><verse number="4" style="v" sid="MAT 11:4"/><char style="pn">Ersa</char> kieliewo, "Ta echidene sonosusanyi, chanlasanyi <char style="pn">Yaheiya</char>de kielie. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Sugho chanlasanyi, dogholon yosanyi, pifugientui goudaghasanyi, dulei sonosusanyi, fugusan kun aminne olusanyi, pse nanxin kunlade gouxioxi chonjikui kielie. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Mii inxin ulie giechen kunde fuqi wine."<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>
    <char style="pn">Yaheiya</char>i tujila yoladene <char style="pn">Ersa</char> kunlade <char style="pn">Yaheiya</char>i kieliezho, "Ta hontande yan kunyi uzhele echiwo? Kei feiliezhi gojiolusan ghulusun mutun zholien kunyi uzhele echiwu? Pusho! <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Ta yan kunyi uzhele echiwo? Seighan jien musisan kunyi uzhele echiwu? Seighan jien musisan kunla hongunde wo! <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Ta jiujin yan kunyi uzhele echiwo? Xienzhii uzhele echiwu? Enbene! Bi tande kielieye, hheshi xienzhise da fugieni wo. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Jinwun jiere,</para>
  <para style="q1" vid="MAT 11:10">'Uzhe, bi qinsi kunne chii melie peizhi</para>
  <para style="q2" vid="MAT 11:10">chii moni zhunbei gieghane.'</para>
  <para style="m" vid="MAT 11:10">giezhi huaisanshi ene kun wo. <verse eid="MAT 11:10"/><verse number="11" style="v" sid="MAT 11:11"/>Bi tande shuhua kielieye, biereila olusan kun dunda xili gieghasan <char style="pn">Yaheiya</char>se fugieni nieda uwoma, asiman gojiade zui meila kun hhense fugie wo. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/><char style="pn">Yaheiya</char>ni hhe xienzise eli kutula asiman gojiani hende eghizho, lihaitu kun hhei qianlazho. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Soyuji xienzhishu, guijinshu jiere melie kieliesanlashi man <char style="pn">Yaheiya</char>se jieshu oluwo. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Kieliesanlai ta xianxin giene giese <char style="pn">Yaheiya</char>shi irene giesan <char style="pn">Iliya</char> enbene. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Chighin bitu kunla chenliendu!"<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>"Bi ene idai kunlai yanghala bilane? Hoxian geidoude souzhi nadusan kesilai xianli. Hhela nieniedene waradazhi kieliene,<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>'Bijien tande bierei agiku xiu feiliese ta ulie jiuline.</para>
  <para style="q2" vid="MAT 11:17">Kun fuguwo giezhi wilase ta ulie wilane.'<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>
    <char style="pn">Yaheiya</char> iredene ulie ijiezhi ulie ochise kunla hhei jiere sheitan wine giezhi kieliene. <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Kunnikewon iredene ijiezhi ochise kunla ene kun jin ijiezhi ochikure wo. Shui shanjisan kun, zuirenlani zhanlien wo giezhi kieliene. Ingieliuzhe aghelishi giekughala olusan bikuni zhenmin giene."<verse eid="MAT 11:19"/></para>
  <para style="s">Geizhen Ese Giesan Kunlade Jingao Giezho</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luj 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Hhe xienzide <char style="pn">Ersa</char> nenlitu shiqin olon giese chenshii kunla geizhen ese giese hhelade jingao giezhi kieliewo, <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>"<char style="png">Gelaxin</char>, <char style="png">Bosaida</char>, tande gou widawo! Tai dunda giesan nenlitu shiqinni <char style="png">Tuilo</char>, <char style="png">Xidun</char>de giewoshi hhela eqighanse madei zhodene jierene funiesun teizhi geizhen giewo. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Bi tande kielieye, panjiku udude ta shouiku zeinan <char style="png">Tuilo</char>, <char style="png">Xidun</char>se da fugie wo! <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/><char style="png">Jiabainun</char>, chii undudaghazhi asiman jiere khireighanu? Chii dozoheide anda boughane. Chii hhende giesan nenlitu shiqinni <char style="png">Sodoma</char>de giezhoshi hhe chenshi eli kutula wine. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Bi tande kielieye, panjiku udude ta shouiku zeinan <char style="png">Sodoma</char>se da fugie wo!"<verse eid="MAT 11:24"/></para>
  <para style="s">Mini Shida Iredene Hhamura</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luj 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Hhe xienzide <char style="pn">Ersa</char> kieliewo, "Asiman zeminni Ezhan, Ada, chii mafan gieghawo. Chi ene shiqinlani agheli, erlintu kunlade niuighazhi ga kewosi mutun kunlade mejieghawo. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Ada, enbene, eneshi chi duranghalane giesanwo. <verse eid="MAT 11:26"/><verse number="27" style="v" sid="MAT 11:27"/>Yanniliuzhe Adami made ogiwo. Adase chugo kiema kewonni mejie dane. Kewon, pse kewon yenyi mejieghasan kunse chugo kiema Adai mejie dane. <verse eid="MAT 11:27"/><verse number="28" style="v" sid="MAT 11:28"/>Jien khishulazhi gunduni beiliesan kunla man mii shida ire. Bi tai hhamuraghaye. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Ta mii jiabanyi jierene zhozhi mase suru. Mii zhughede renyi, meilade uzhekui wine. Tai zhughe hhamura shidane. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Mii jiaban sunfan wo. Mii danzi gongien wo."<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s">Hhamuraku Udude Boudei Qiorun Sidazho</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mak 2:23-28</ref>; <ref loc="LUK 6:1-5">Luj 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Hhe xienzide <char style="pn">Ersa</char> hhamuraku udude boudei ghazhaghun yozhi daozho. Tujilani oliesuse boudei qiorunni sidazhi ijiezho. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Falisai kunla chanladene <char style="pn">Ersa</char>de kieliewo, "Uzhe, chii tujila hhamuraku udude ulie giekui giezho!" <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/><char style="pn">Ersa</char> hhelade kieliewo, "<char style="pn">Dawude</char>, hhantuku kunlarene oliesukude giesan shiqinyi ta onshizhi ese daowu? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Hhe mechide orodene Hudade ogiku ginanyi ijiewo. Ene ginanyi hhe, pse hhantuku kunlai ijiezhi ulie olune. Zinie buwa ijiese olune. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Pse buwala hhamuraku udude mechide hhamuraku udui guijinni fanjiliuzhe zui ulie sanakui ta guijinshu jiere onshizhi ese daowu? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Bi tande kielieye, enende nie kun mechise da fugie wo. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>'Bi ubali xiikude xiqi wo. Murede xiqi uwo.' giesan ene kielienyi isii ta mejiese zui witude zui ulie soughane. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Kunnikewonshi hhamuraku uduni Ezhan wo."<verse eid="MAT 12:8"/></para>
  <para style="s">Khani Goudaghazho</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mak 3:1-6</ref>; <ref loc="LUK 6:6-11">Luj 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>
    <char style="pn">Ersa</char> hhe oronse likai gie huitande orowo. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Hhende nie khani ghosan kun wine. Kunla <char style="pn">Ersa</char>i zhane giezhi, "Hhamuraku udude goudaghase olunulie?" giezhi asawo. <verse eid="MAT 12:10"/><verse number="11" style="v" sid="MAT 12:11"/><char style="pn">Ersa</char> kieliewo, "Tai dunda kien hhamuraku udude ghoni nokiende anda bouse laizhi ulie khizhenu? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Kun ghonise giedughon zhigui wo. Ingiese hhamuraku udude gouni giese oluzho." <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>Ingie, "Hhe kunde khane khizhegha." giezhi kieliewo. Hhe khane khizheghase khani goudazhi da nie khaghalai niekielien gholuwo. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Falisai kunla khizhi echidene <char style="pn">"Ersa</char>i matugie widaghane?" giezhi shanlian giewo.<verse eid="MAT 12:14"/></para>
  <para style="s">Huda Sunghusan Hoji</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>
    <char style="pn">Ersa</char> mejiedene hhense likai giewo. Tebieji olon kunla hhei daghazho. Hhe gientulai man goudaghadene <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>hhelade, "Hheshi kien bikui bu kielie!" giezhi minlin xiaiwo. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Ingiekushi Ezhan <char style="pn">Isaiya</char> xienzhini tungo giezhi kieliesan kielien mutun gholughane giezho,<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>"Uzhe, eneshi bi sunghusan mii hoji wo.</para>
  <para style="q2" vid="MAT 12:18">Bi hhende orezhi xiqi hen wo.</para>
  <para style="q1" vid="MAT 12:18">Bi ruhherne hhende ogine.</para>
  <para style="q2" vid="MAT 12:18">Ingiedene hhe gundanni minzulade chonjine.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Hhe ulie zhenjindune, ulie onghonone.</para>
  <para style="q2" vid="MAT 12:19">Geidoude hhei shenqini kiema sonosu dane.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Ghurane giesan ghulusunyi hhe ulie ghuraghane.</para>
  <para style="q2" vid="MAT 12:20">Xiniene giesan zhulai ulie xinieghane.</para>
  <para style="q1" vid="MAT 12:20">Izhi gundanni injitula giene.<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>Minzula hhei nierei xiwon giene."<verse eid="MAT 12:21"/></para>
  <para style="s">Ersa Biexibughala</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mak 3:20-30</ref>; <ref loc="LUK 11:14-23">Luj 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Ingiekude kunla nie sheitan heisan sugho, yabai <char style="pn">Ersa</char>i shida uduru irewo. <char style="pn">Ersa</char> hheni goudaghase hhe kielien kieliezhi chanlawo. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Kunla man ghanirazhi kieliewo, "Eneshi <char style="pn">Dawude</char>ni houdei enbeneba?" <verse eid="MAT 12:23"/><verse number="24" style="v" sid="MAT 12:24"/>Falisai kunla chenliedene kieliewo, "Ene kun sheitanni touzi <char style="pn">Biexibu</char>i ulie kouise sheitan tou dane." <verse eid="MAT 12:24"/><verse number="25" style="v" sid="MAT 12:25"/><char style="pn">Ersa</char> hhela yan sumulasei mejiedene kieliewo, "Alinie gojia goyalane eghinduse hontan gholune. Alinie chenshiwonu, alinie giei kunla goyalane eghinduse bei dane. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Ibilisi Ibilisine touse goyalane eghinduzho, hhei gojia matugie beine? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Bi <char style="pn">Biexibu</char>ni kouizhi sheitan touse tai tujila kienyi kouizhi sheitan touzho? Ingiese tai tujila zhenmin giese tanughun codazho. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Bi Hudai Ruhherghala sheitan touse Hudai gojia tande irezho. <verse eid="MAT 12:28"/><verse number="29" style="v" sid="MAT 12:29"/>Pse kun liliantu kunyi giede orozhi dunxilai qianlane giese xien liliantu kunyi ulie banlase matugie man qianla echine? <verse eid="MAT 12:29"/><verse number="30" style="v" sid="MAT 12:30"/>Mii miende ulie beise mii duitou wo. Mare ulie hhantulachen kunshi sandachen kun wo. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Ingiese bi tande kielieye, yanyanji zui, hu kieliesanlai man roulienema, Shenlinni hu kieliese ulie rouliene. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Kunnikewonni fandui giezhi kieliese roulienema, Shenlinni fandui giezhi kieliese duyade ulie rouliene, houshideye ulie rouliene."<verse eid="MAT 12:32"/></para>
  <para style="s">Alimaghala Mutunni Mejiene</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luj 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>"Mutun goushi alima gou wo. Mutun bixinshi alimaye bixin wo. Alimaghala mutunni mejiene. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Ta ene du mogheini zhunzhughala, ta doghunshi matugie gou kielien kieliezhi khizheghane? Zhughede durusei amande kielie khizheghane. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Gou kunlai zhughede gounishi yen gouni khizheghane. Doghun kunlai zhughede doghunnishi yen doghunni khizheghane. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Bi tande kielieye, xienhua kieliechen kunlai panjiku udude nie aman nie amanji renjighane. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Tai kielienghala tai gounii sanane. Tai kielienghala tai zuini jinjine."<verse eid="MAT 12:37"/></para>
  <para style="s">Yunusini Ghudureqi</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mak 8:11-12</ref>; <ref loc="LUK 11:29-32">Luj 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Ingiekude giedun jinwun hanjia, Falisai kun <char style="pn">Ersa</char>de kieliewo, "Loushi, chi gieku ghudureqini bijien uzhene giezho." <verse eid="MAT 12:38"/><verse number="39" style="v" sid="MAT 12:39"/><char style="pn">Ersa</char> hhelade kieliewo, "Ene idaini kunla doghun nefuxin giezho, ta dou ghudureqi kerezhoma, xienzhi <char style="pn">Yunusi</char>i ghudureqise chugo uzheghaku ghudureqi uwo. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/><char style="pn">Yunusi</char> ghurudu ghuran xii fugie zhaghasunyi kielide wo. Kunnikewonye ghurudu ghuran xii zemin jizide beine. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Panjiku udude <char style="png">Niniwi</char> kunla bosizhezhi ene idai kunlai zuini jinjine. Ingiekushi <char style="png">Niniwi</char> kunla <char style="pn">Yunusi</char> chonjisei chenliedene geizhen giewo. Uzhe, enende <char style="pn">Yunusi</char>se pse fugieni wine! <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Panjiku udude nanfanni bierei honshan bosizhedene ene idai kunlai zuini jinjine. Ingiekushi hhe gholose <char style="pn">Sulumane</char>ni aghelini chenliele irewo. Uzhe, enende <char style="pn">Sulumane</char>se pse fugieni wine!"<verse eid="MAT 12:42"/></para>
  <para style="s">Zannan Ruhher Kharei Irewo</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luj 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>"Nie zannan ruhher kunni jierese likai giedene usu witu oronde izhigie yozhi hhamuraku oron ereizho. Ereizhi olu dadene <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>kieliewo, 'Bi yen khizhesan hhe giedene echine.' Khareizhi echi nie uzhese kunkunji shuzhi goudagha jiezho. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Ingie khizhi echi goyasene dolon doghun ruhheryi uduruzhi ire souwo. Ingiese hhe kunni qinkon melieshidakude pse ese kuruwo. Ene idaini doghun kunlaye eneghala niekielien gholune."<verse eid="MAT 12:45"/></para>
  <para style="s">Ersani Nie Gie Kun</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mak 3:31-35</ref>; <ref loc="LUK 8:19-21">Luj 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>
    <char style="pn">Ersa</char> kunlade kieliekude ana, gaijiulani iredene ghadane beizhi hhere kielien kieliene giezho. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Nie kun hhende kieliewo, "Uzhe, anachii, gaijiulachii ghadane sagheizhi chare kielien kieliene giezho." <verse eid="MAT 12:47"/><verse number="48" style="v" sid="MAT 12:48"/><char style="pn">Ersa</char> khareizhi hhe kieliesan kunde kieliewo, "Kienshi mii ana wo? Kienshi mii gaijiula wo?" <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Ingie tujilane zhiizhi kieliewo, "Uzhe, mii ana, mii gaijiula wo. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Asiman jieredu adaimi isii zunjizhi giesan kunlashi mii gaijiu, eghechijiu, ana wo."<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s">Fure Shizhikuni Bilazho</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mak 4:1-9</ref>; <ref loc="LUK 8:4-8">Luj 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Yen hhe udude <char style="pn">Ersa</char> giederase khizhedene haibienzide souwo. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Tebieji olon kunla hhei shida irezhi hhantulase hhe chon jiere khirei souwo. Kunla man haibienzide beizho. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/><char style="pn">Ersa</char> kunlade bilazhi olon kieliewo, "Nie kun shizhile echiwo. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Shizhikudeni niezhanla mo jiere luise bunzhula ire ijie agiwo. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Niezhanla tura olon witu tashitu oronde luise tura ninkienshi niazi faizhi ghujin woma, <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>genzi uwoshi naran khizhe nie xiese ghowo. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Pse niezhanla eghesun dunda luise eghesun khizhezhi hhei jigheidawo. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Da niezhanla gou ghazhade luise 100 pei, 60 pei, 30 pei zhonjia souwo. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Chighin bitu kunla chenliendu!"<verse eid="MAT 13:9"/></para>
  <para style="s">Bilaku Muji</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mak 4:10-12</ref>; <ref loc="LUK 8:9-10">Luj 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Tujilani <char style="pn">Ersa</char>i shida ire asawo, "Kunlade yale bilazhi kieliene?" <verse eid="MAT 13:10"/><verse number="11" style="v" sid="MAT 13:11"/><char style="pn">Ersa</char> hhelade kieliewo, "Hudai gojiai mimii zinie tande mejieghawoma, hhelade ese mejieghawo. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Bichen kunde pse olon ogizhi feilieghane. Wichen kunse bisanlainiye agi echine. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Bi hhelade bilazhi kieliekushi hhela uzhese qinchu olu dane, chenliese sonosu dazhi minbai olu dane. <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/><char style="pn">Isaiya</char> melie kieliesan kielien mutun hhelai jiere shuhua gholuwo,</para>
  <para style="q1" vid="MAT 13:14">'Ta izhi chenliezhoma, dunjire dane.</para>
  <para style="q2" vid="MAT 13:14">Ta izhi uzhezhoma, minbai olu dane.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Ene bexinlai zhughe khiduzhezhi</para>
  <para style="q2" vid="MAT 13:15">chighin beidazhi</para>
  <para style="q2" vid="MAT 13:15">nudunne hameizho.</para>
  <para style="q1" vid="MAT 13:15">Pse nudunni chanlazhi</para>
  <para style="q2" vid="MAT 13:15">chighinni sonosuzhi</para>
  <para style="q2" vid="MAT 13:15">zhughedeni minbai oludene kharei daorese</para>
  <para style="q1" vid="MAT 13:15">Bi hhelai goudaghakuse ayizho.'<verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Ingieliuzhe tande fuqi wine. Tai nudunde chanlazhi chighinde sonosuzho. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Bi tande shuhua kielieye, olon xienzhi, gou kunla ta uzhesei uzhene giezhoma, uzhe dazho. Ta chenliesei chenliene giezhoma, chenlie dazho."<verse eid="MAT 13:17"/></para>
  <para style="s">Bilasanni Mejieghazho</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mak 4:13-20</ref>; <ref loc="LUK 8:11-15">Luj 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>"Ingiese ta ene fure shizhisan kunni bilasei chenlie. <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Kienliuzhe asiman gojiani kielienyi chenliedene dunjire dase Ibilisi iredene zhughedeni shizhisei agi echine. Eneshi mo jiere luisan fure wo. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Tashitu oronde luisanshi kielienyi chenliedene bayasuzhi deigo jienliewoma, <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>zhughedeni genzi wise niechaku wo. Kielienyi yenyinghala zeinan onu heiku kuzhese deigo furawo. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Eghesun dunda luisanshi kielienyi chenliewoma, duyai munan gieku, baer miise kielienyi jigheidazhi yama sou dawo. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Gou ghazhade luisanshi kielienyi chenliezhi dunjiresan kun wo. 100 pei, 60 pei, 30 pei zhonjia souwo."<verse eid="MAT 13:23"/></para>
  <para style="s">Yemeini Bilazho</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>
    <char style="pn">Ersa</char> hhelade pse bilazhi kieliewo, "Asiman gojia hoxian kun ghazhadene boudei fure shizhisei xianli. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Ashighala hhunturakude duitouni iredene yemeini boudei dundani shizhi yolawo. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Boudei osizhi qiorun khise yemeiye khizhewo. <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>Hojilani iredene ezhandene kieliewo, 'Ezhan, chi boudei fureni ghazhade ese tareiwu? Khalase iresan yemei wo?' <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/>Ezhan hhelade kieliewo, 'Eneshi duitou giesan wo.' Hojilani kieliewo, 'Bijien echidene xi agimu?' <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/>Ezhanni kieliewo, 'Bu echi, yemeini xise boudeiniye xi khizhene. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Ghuala hhantu osi gie. Sagheizhi xiku shihoude bi ghurachen kunlade kielieye, "Xien yemeii xisenu chouladene khan tei. Boudeini yanchidene cankude ghura." giezhi.'"<verse eid="MAT 13:30"/></para>
  <para style="s">Caizi Fureji Kuniegheni Bilazho</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mak 4:30-32</ref>; <ref loc="LUK 13:18-21">Luj 13:18-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>
    <char style="pn">Ersa</char> hhelade pse bilazhi kieliewo, "Asiman gojia nie caizi furei xianli. Kun agizhi echi ghazhadene tareiwo. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Eneshi fure dundase zui gani woma, osizhi khizhese yan caiseliuzhe fugie wo. Mutun gholudene bunzhula chala jiereni holiene."<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Pse hhelade bilazhi kieliewo, "Asiman gojia hoxian kuniegheni xianli. Nie bierei agizhi echidene nie deizi ghurunde teizhi man faighawo."<verse eid="MAT 13:33"/></para>
  <para style="s">Bilasanni Muji</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mak 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Enelashi man <char style="pn">Ersa</char> olon kunlade bilazhi kieliesan wo. Bilazhi ulie kieliese hhelade ulie kieliene. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Ingiekushi Ezhan xienzhini tungo giezhi kieliesan kielien mutun gholughane giezho,</para>
  <para style="q1" vid="MAT 13:35">"Bi bilazhi kielieye.</para>
  <para style="q2" vid="MAT 13:35">Duyai zhayaghasanse niuighasan shiqinlai kieliezhi khizheghaye."<verse eid="MAT 13:35"/></para>
  <para style="s">Yemeini Bilasei Mejieghazho</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Ingiedene <char style="pn">Ersa</char> kunlase likai gie giedera orowo. Tujila shidani ire kieliewo, "Ghazha jieredu yemeini bilasei bijiende mejiegha." <verse eid="MAT 13:36"/><verse number="37" style="v" sid="MAT 13:37"/>Hhe kieliewo, "Boudei furei shizhisanshi Kunnikewon wo. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Ghazhashi duya wo. Boudei fureshi asiman gojiai kunla wo. Yemeishi hhe doghunnii kunla wo. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Yemei shizhisan duitoushi Ibilisi wo. Ghuraku shihoushi duya baraku shihou wo. Ghurachenshi qienxienla wo. <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>Yemeini xi agidene khande sideraghaku mutun duya barakudeye ingiene. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Kunnikewon qienxienlane peizhi zui fanjighasanlai, uhunni giesanlai man asiman gojiasene zhiizhi khizhedene <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>fugie khantu nokiende benda oroghase hhende shidunne zhouzhi wilane. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Ingiekude gou kunla adane gojiade naran nudun mutun gieran faine. Chighin bitu kunla chenliendu!"<verse eid="MAT 13:43"/></para>
  <para style="s">Boubeini Bilazho</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>"Asiman gojia hoxian ghazhade niuighasan boubeini xianli. Nie kun hhei chanladene niuighawo. Bayasuzhi echidene goyane dunxilai man huisenu ene ghazhai agiwo."<verse eid="MAT 13:44"/></para>
  <para style="s">Manoui Bilazho</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>"Pse asiman gojia hoxian nie meimei kun zhiguitu manou ereisei xianli. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Nie fugie jiagetu manoui penjise echidene goya dunxilane man huisenu ene manoui agiwo."<verse eid="MAT 13:46"/></para>
  <para style="s">Zhaghasun Bareiku Onni Bilazho</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>"Pse asiman gojia hoxian haide xiaisan onni xianli. Yanyanji zhaghasunlai bareizhi <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>on duruse usu bienzide laizhi khizhedene sousenu gounilai sunghuzhi tunzide teine. Bixinnilai bendane. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Duya barakudeye ingiene. Qienxienla irese doghun kunni gou kun dundase sunghu khizhedene <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>fugie khantu nokiende bendase hhende shidunne zhouzhi wilane."<verse eid="MAT 13:50"/></para>
  <para style="s">Shini Khuichen Dunxi</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>
    <char style="pn">Ersa</char> kieliewo, "Enezighan kielienyi ta man dunjirewoye?" Hhela huida giewo, "Bijien dunjirewo." <verse eid="MAT 13:51"/><verse number="52" style="v" sid="MAT 13:52"/><char style="pn">Ersa</char> kieliewo, "Jien asiman gojiade tuji danlasan jinwun hanjiala hoxian gieni zhanguijii xianli. Hhe kufansene shini, khuichen dunxilai agi khizhene."<verse eid="MAT 13:52"/></para>
  <para style="s">Ersai Nasalede Ese Jienliezho</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mak 6:1-6</ref>; <ref loc="LUK 4:16-30">Luj 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>
    <char style="pn">Ersa</char> enezighan bilasei kielie baraghadene hhense likai giewo. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ingiedene hhe goya orondene irezhi hhelai huitande kunlade sughase hhela man ghanirazhi kieliewo, "Ene kunde imutu agheli, fugie shiqin khalase irezho? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Eneshi mujianyi kewon pushonu? Hhei ananishi <char style="pn">Mereiyen</char> pushonu? Gaijiulanishi <char style="pn">Yagebu</char>, <char style="pn">Yusufu</char>, <char style="pn">Ximun</char>, <char style="pn">Yuda</char> pushonu? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Hhei oqinjiulani mai enende uwonu? Ene kunde khalase iresan benshi wo?" <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Hhela <char style="pn">Ersa</char>de hokuzho. Ingiese <char style="pn">Ersa</char> hhelade kieliewo, "Xienzhini goyai oron, goyai giese chugo khalaliuzhe zunjine." <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>Hhela <char style="pn">Ersa</char>i xianxin ese giese <char style="pn">Ersa</char> hhende famatu shiqin olon ese giezho.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s">Yaheiyani Alazho</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mak 6:14-29</ref>; <ref loc="LUK 9:7-9">Luj 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Hhe xienzide <char style="pn">Hherode</char> on <char style="pn">Ersa</char>i shiqinyi sonosudene <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>kha dourashiku kunlade kieliewo, "Eneshi xili gieghasan <char style="pn">Yaheiya</char> wo. Hhe fugudene aminne oluwo. Ingiese ene nenlitu shiqinla hhei jierese khizhezho."<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Eneshi <char style="pn">Hherode</char> jiu biereine <char style="pn">Xiloji</char>ni yenyinghala <char style="pn">Yaheiya</char>i bareidene banlasenu bafanzide khazho. <char style="pn">Hherode</char>i jiushi <char style="pn">Feili</char> wo. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/><char style="pn">Yaheiya</char> <char style="pn">Hherode</char>de, "Chi hhei agise ese oluzho." giezhi kieliezho. <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Ingiese <char style="pn">Hherode</char> <char style="pn">Yaheiya</char>ni alane giezhoma, bexinla hhei xienzhi wo giese hhelase ayizho. <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/><char style="pn">Hherode</char>ni olusan udu kuzhese xi beilazhi <char style="pn">Xiloji</char>ni oqin kunlai melie wu jiulizho. <char style="pn">Hherode</char> hende bayasuzho, <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ingiese fayen giezhi oqinde yan kerese yan ogiye giezhi dain giewo. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Anani oqinne, "Xili gieghasan <char style="pn">Yaheiya</char>ni qiorunyi hhamusade teidene made iregha." giezhi kielieghase oqin kieliewo. <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/><char style="pn">Hherode</char> hende munan giezho. Ingieliuzhe olon kunlai melie fayen giese fenfulazhi hhende ogine giewo. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Ingie kun peidene bafanzide <char style="pn">Yaheiya</char>i qiorunyi chizhighawo. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Qiorunyini hhamusade agi ire oqinde ogiwo. Oqin pse anadene ogiwo. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/><char style="pn">Yaheiya</char>i tujila iredene beyeini linlasenu buladene <char style="pn">Ersa</char>de echi kieliewo.<verse eid="MAT 14:12"/></para>
  <para style="s">5000 Kunde Chudughazho</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mak 6:30-44</ref>; <ref loc="LUK 9:10-17">Luj 9:10-17</ref>; <ref loc="JHN 6:1-14">Yah 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>
    <char style="pn">Ersa</char> enei mejiedene chon souzhi hhense likai gie niezheghan hontande echiwo. Olon kunla <char style="pn">Ersa</char> yolasei mejiedene chenshilase yozhi hhei daghazho. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/><char style="pn">Ersa</char> chon jierese bouzhese tebieji olon kunlai chanladene ubali xiiwo. Hhelai giemeresan kunlai goudaghawo. <verse eid="MAT 14:14"/><verse number="15" style="v" sid="MAT 14:15"/>Khara olukude tujilani hhei shida ire kieliewo, "Eneshi hontan wo. Shihou eqie widawo. Kunlai sandaghazhi hhela goyalane aghinlade agizhi ijiele echigieba." <verse eid="MAT 14:15"/><verse number="16" style="v" sid="MAT 14:16"/><char style="pn">Ersa</char> kieliewo, "Hhelai echighaku biyo uwo. Ta hhelade ogizhi ijiegha." <verse eid="MAT 14:16"/><verse number="17" style="v" sid="MAT 14:17"/>Tujilani kieliewo, "Matai enende zi tawun ginanji ghua zhaghasun wo." <verse eid="MAT 14:17"/><verse number="18" style="v" sid="MAT 14:18"/><char style="pn">Ersa</char> kieliewo, "Mii enende agizhi iregha." <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Ingie olon kunlai fenfulazhi osuntu oronde soughawo. Pse tawun ginan, ghua zhaghasunyi barei, asimanyi uzhe Hudade mafan kieliedene ghulusenu tujilade ogise tujila kunlade ogiwo. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Dajiala man ijiedene chuduwo. Tujila feiliesan zhazhai hhantulaghase 12 gie lanzi zhonlowo. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Ijiesan kun dunda bierei kewosilai ulie sanase chabudu 5000 ere kun wo.<verse eid="MAT 14:21"/></para>
  <para style="s">Hai Jiere Yozho</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mak 6:45-52</ref>; <ref loc="JHN 6:15-21">Yah 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>
    <char style="pn">Ersa</char> deigo tujilai biizhi chon jiere khighadene xien hai duimiende daogha goyane olon kunlai sandaghawo. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Kunlai sandaghadene ulade niezheghan onxian giele echiwo. Khara oluse hhende niezheghan wo. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Qingiekude chon haibienzise gholo wo. Kei shun wise lan chonni eghizhi yuqighazho. <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>Xieni 3 jiense 6 jienni shihoude <char style="pn">Ersa</char> tujilai hhende echine giezhi haini usu jiere yozho. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Tujila hai jiere hhe yosei chanladene jindazhi ayidene waradawo, "Perei wo!" <verse eid="MAT 14:26"/><verse number="27" style="v" sid="MAT 14:27"/><char style="pn">Ersa</char> deigo hhelade kieliewo, "Ta zhughelane tei. Bi wo. Bu ayi!" <verse eid="MAT 14:27"/><verse number="28" style="v" sid="MAT 14:28"/><char style="pn">Beduru</char> kieliewo, "Ezhan, chi enbese minlin xiaizhi mii hai jiereghun goyane hhende yozhi echigha." <verse eid="MAT 14:28"/><verse number="29" style="v" sid="MAT 14:29"/><char style="pn">Ersa</char>, "Chi ire." giezhi kieliese <char style="pn">Beduru</char> chon jierese boudene <char style="pn">Ersa</char>i hhende echine giezhi hai jiereghun yo qiiwo. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Kei fugiede feiliesei chanla ayidene haide anda boune giese waradazhi kieliewo, "Ezhan, mii jiui!" <verse eid="MAT 14:30"/><verse number="31" style="v" sid="MAT 14:31"/><char style="pn">Ersa</char> deigo khaghalane laidene kieliezho, "Chi ene xianxin gieku zhughe gajitu kun. Yangiezhi inxin giezho?" <verse eid="MAT 14:31"/><verse number="32" style="v" sid="MAT 14:32"/><char style="pn">Ersa</char> <char style="pn">Beduru</char>ghala chon jiere khise kei beiwo. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Chon jieredu kunla <char style="pn">Ersa</char>i beiizhi kieliewo, "Chishi shuhua Hudai kewon enbene!"<verse eid="MAT 14:33"/></para>
  <para style="s">Genisalededu Gientui Goudaghazho</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mak 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Hhela haini daodene <char style="png">Genisale</char> oronde irewo. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Hhendedu kunla <char style="pn">Ersa</char>i tanidene hhe iresan xioxini go oronlade chonjizhi giemeresan kunlai man udurudene <char style="pn">Ersa</char>i hhende irewo. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Hhela <char style="pn">Ersa</char>i xiahua giezhi jien ghizhane nie maqigha giezho. Maqisan kunla man goudawo.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s">Zhughede Ganjinraghaku</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mak 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Ingiekude Falisai kun, jinwun hanjiala <char style="png">Yelusalen</char>se <char style="pn">Ersa</char>i hhende ire asawo, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>"Chii tujila yangiezhi xienrenla sughasan xigonni ulie zunjine? Hhela ijiekude khane ulie wagha ijiezho." <verse eid="MAT 15:2"/><verse number="3" style="v" sid="MAT 15:3"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta yangiezhi goya xigonghalane Hudai minlinni ulie zunjine? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Huda, 'Ada anane zunji', 'Ada anane sugiesan kunni ala.' giezhi kieliezho. <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Ingieliuzhe ta kieliene, 'Kien ada anadene bi tande ogi shidakui Hudade ogiwo.' giezhi kieliese <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>hhe kun adane ulie zunjise olune giezho. Ingiezhi ta goya xigonghalane Hudai kielienyi widaghazho. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Jiazhon giesan kunlaya, <char style="pn">Isaiya</char> tai zhiizhi melieshida kieliesan ese codazho. Hhe kieliezho,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>'Ene bexinla amanghalane mii zunjine.</para>
  <para style="q2" vid="MAT 15:8">Zhugheni mase gholo wo.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Hhela kunni guijinyi zhenzhenji daoli mutun kunlade sughazho.</para>
  <para style="q2" vid="MAT 15:9">Ingiese mii beiise yama oronde uwo.'"<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>
    <char style="pn">Ersa</char> kunlai uruzhi ire hhelade kieliewo, "Ta chenliezhi minbai olu, <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>amanse orosan kunyi ulie zannanshighanema, amanse khizhesan kunyi zannanshighane." <verse eid="MAT 15:11"/><verse number="12" style="v" sid="MAT 15:12"/>Ingie tujila hhei melie ire kieliewo, "Falisai kun ene kielienyi chenliese hokusanni chi mejielie?" <verse eid="MAT 15:12"/><verse number="13" style="v" sid="MAT 15:13"/><char style="pn">Ersa</char> kieliewo, "Asiman jieredu adami zeilasan pushoshi man xi khizhene. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Hhelai bu gonji. Hhelashi sughoi uduruchen sugho wo. Sugho sughone uduruse ghuala nokiende anda boune."<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>
    <char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliewo, "Ene bilazhi kieliesei bijiende kieliezhi minbai olugha." <verse eid="MAT 15:15"/><verse number="16" style="v" sid="MAT 15:16"/><char style="pn">Ersa</char> kieliewo, "Ta dou minbai olu dawu? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Amande orosan kielighun mekiende echisei ta ulie mejienu? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Amanse khizhesanshi zhughese khizhesanwo. Ene caigie kunni zannanshighane. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Zhughese khizhesanshi doghunde sumulaku, alaku, piofen gieku, lon kijieku, ghulaku, jia ganzhen beiku, sugieku wo. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Enela man kunni zannanshighane. Khane ulie wagha ijiese kunni ulie zannanshighane."<verse eid="MAT 15:20"/></para>
  <para style="s">Nie Niman Kunni Biereini Xianxin Gieku</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mak 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>
    <char style="pn">Ersa</char> hhense likai giedene <char style="png">Tuilo</char>, <char style="png">Xidun</char>ni oronde echiwo. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Nie niman kunyi<note caller="+" style="f"><char style="fr">15:22</char> <char style="em">Jianan kun</char> </note> bierei hhe oronse khizhedene waradazhi kieliewo, "Ezhan, <char style="pn">Dawude</char>ni houdei, made ubali nie xii! Mii oqinyi sheitan heisan hen wo." <verse eid="MAT 15:22"/><verse number="23" style="v" sid="MAT 15:23"/>Ingieliuzhe <char style="pn">Ersa</char> yama huida ese giezho. Tujilani melie ire xiahua giezhi kieliewo, "Hhei khareighaba. Ene bierei mai khuinase waradazho." <verse eid="MAT 15:23"/><verse number="24" style="v" sid="MAT 15:24"/><char style="pn">Ersa</char> kieliewo, "Mii peizhi zinie <char style="png">Isilie</char>ni kunlai dundadu miisan ghonilade oluzhi ireghazho." <verse eid="MAT 15:24"/><verse number="25" style="v" sid="MAT 15:25"/>Hhe bierei ire <char style="pn">Ersa</char>i beiizhi kieliewo, "Ezhan, made banman nie gie!" <verse eid="MAT 15:25"/><verse number="26" style="v" sid="MAT 15:26"/><char style="pn">Ersa</char> kieliewo, "Kesilai ginanyi ga nogheide bendazhi ogise ese oluzho." <verse eid="MAT 15:26"/><verse number="27" style="v" sid="MAT 15:27"/>Hhe bierei kieliewo, "Ezhan, oluzhoma, nogheiye ezhanne shire doura bousan zhazhai ijiene." <verse eid="MAT 15:27"/><verse number="28" style="v" sid="MAT 15:28"/>Ingiese <char style="pn">Ersa</char> kieliewo, "Funi, chii xianxin gieku fugie wo. Chi keresan mutun chade gholu gie." Hhe shihoude oqinni goudawo.<verse eid="MAT 15:28"/></para>
  <para style="s">Olon Gientulai Goudaghazho</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>
    <char style="pn">Ersa</char> hhense likai giezhi <char style="png">Jialilihai</char> bienzide iredene ulade khirei souwo. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Tebieji olon kunla hhei hhende iredene dogholon, sugho, sanfei, yaba, pse olon gientulai hhei konshida jiese hhe goudaghawo. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Yaba kielien kielie, sanfei gouda, dogholon yo, sugho chanlasei olon kunla uzhedene ghanirazhi <char style="png">Isilie</char>ni Hudai kuaiwo.<verse eid="MAT 15:31"/></para>
  <para style="s">4000 Kunde Chudughazho</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mak 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>
    <char style="pn">Ersa</char> tujilane uruzhi ire kieliewo, "Ene kunla mare hhantu ghurudu oluzho, hhelade ijiekui widazho. Bi hhelade ubali xiizho. Bi hhelai oliesuzhi echighaku duran uwo. Mo jiere echise injirekuse ayizho." <verse eid="MAT 15:32"/><verse number="33" style="v" sid="MAT 15:33"/>Tujila hhende kieliewo, "Ene hontande imeghei kunlade ijie chudughaku ginan bijiende khalase irene?" <verse eid="MAT 15:33"/><verse number="34" style="v" sid="MAT 15:34"/><char style="pn">Ersa</char> hhelade kieliewo, "Tande ginan giedughon wo?" Hhela kieliewo, "Dolon wo, pse giedun ga zhaghasun wo." <verse eid="MAT 15:34"/><verse number="35" style="v" sid="MAT 15:35"/><char style="pn">Ersa</char> olon kunlai fenfulazhi zemin jiere soughadene <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>dolon ginan, giedun zhaghasunyi barei mafan kieliedene ghulu tujilade ogise tujila olon kunlade ogiwo. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Dajiala man ijiezhi chududene feiliesan zhazhai dolon lanzi zhonlowo. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Ijiesan kun dunda bierei kewosilai ulie sanase 4000 ere kun wo. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/><char style="pn">Ersa</char> kunlai sandaghadene chon jiere khirei <char style="png">Majiadan</char> oronde echiwo.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s">Ersase Ghudureqi Uzhene Giezho</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mak 8:11-13</ref>; <ref loc="LUK 12:54-56">Luj 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Falisai kun, Sadugai kunla <char style="pn">Ersa</char>i shida iredene hhei shiizhi asiman jierese iresan ghudureqi uzhegha giezhi yoqiu giezho. <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/><char style="pn">Ersa</char> hhelade kieliewo, "Khara olukude olien shouizhi daose, 'Maghashijie arulune.' giezhi ta kieliene. <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Eqiemagha olien shouizhi dao dase, 'Enedu kei feiliezhi ghura boune.' giezhi kieliene. Ta asimanni qinkonyi fenjine, ene shidaini ghudureqini fenji dane. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Ene idaini kunla, doghun nefuxin giezho, ta dou ghudureqi kerezhoma, <char style="pn">Yunusi</char>i ghudureqise chugo uzheghaku ghudureqi uwo." Ingiedene hhelase likai giewo.<verse eid="MAT 16:4"/></para>
  <para style="s">Falisai Kun, Sadugai Kunlani Fangula</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mak 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Tujila hai duimiende daose ginan bareikui matazho. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta Falisai kun, Sadugai kunlai kuniegheni jinxin giezhi fangula." <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>Tujila nieniedene kielienduzho, "Matan ginan ese bareise ingiezhi kieliezhoba." <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/><char style="pn">Ersa</char> mejiedene kieliewo, "Ta ene xianxin gieku zhughe gajitu kunla, ta yangiezhi ginan wikui kielienduzho? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Ta dou minbai olu dazhou? Tawun ginanyi 5000 kunde ogizhi giedun lanzi zhonlosei jila danu? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Pse dolon ginanyi 4000 kunde ogizhi giedun lanzi zhonlosei jila danu? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Bi kieliesanshi ginanyi ese kieliesei ta matugie mejie dane? Ta jinxin giezhi Falisai kun, Sadugai kunlai kuniegheni fangula." <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Ingiekude tujila <char style="pn">Ersa</char> ginan kuniegheni ese kieliezhi Falisai kun, Sadugai kunla surughasei fangula giesei mejiewo.<verse eid="MAT 16:12"/></para>
  <para style="s">Ersashi Mexiha Wo Giezhi Beduru Chenren Giezho</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mak 8:27-30</ref>; <ref loc="LUK 9:18-21">Luj 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>
    <char style="pn">Ersa</char> <char style="png">Kaisaliya-Feilibi</char> oronde iredene tujiladene asazho, "Kunla kieliese Kunnikewonshi kien wo giezho?" <verse eid="MAT 16:13"/><verse number="14" style="v" sid="MAT 16:14"/>Hhela kieliewo, "Kunla kieliese xili gieghasan <char style="pn">Yaheiya</char> wo giezho. Niezhan kunla kieliese <char style="pn">Iliya</char> wo giezho. Pse niezhan kunla kieliese <char style="pn">Yelimi</char> onu, xienzhi dundadu nie wo giezho." <verse eid="MAT 16:14"/><verse number="15" style="v" sid="MAT 16:15"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta kieliese bishi kien wo?" <verse eid="MAT 16:15"/><verse number="16" style="v" sid="MAT 16:16"/><char style="pn">Ximun-Beduru</char> kieliewo, "Chishi Mexiha wo. Chanqiku Hudai kewon wo." <verse eid="MAT 16:16"/><verse number="17" style="v" sid="MAT 16:17"/><char style="pn">Ersa</char> hhende kieliewo, "<char style="pn">Ximun-Bayena</char>, chade fuqi wine! Enei chade mejieghasanshi kun pusho, asiman jieredu adami wo. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Bi pse chade kielieye, chishi <char style="pn">Beduru</char><note caller="+" style="f"><char style="fr">16:18</char> <char style="em">tashi</char> </note> wo. Bi jiohuine ene tashi jiere giene. Dozoni lilian hhense inji dane. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Bi asiman gojiani yeshii chade ogiye. Chi zemin jiere yan banlase asiman jiereye yan banlane. Chi zemin jiere yan andaghase asiman jiereye yan andaghane." <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Ingiedene <char style="pn">Ersa</char>, "Goyaneshi Mexiha bikui kiemade bu kielie!" giezhi tujilade fenfulawo.<verse eid="MAT 16:20"/></para>
  <para style="s">Ersa Goyane Shouku Giekui Kieliezho</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mak 8:31-9:1</ref>; <ref loc="LUK 9:22-27">Luj 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Hhe shihouse <char style="pn">Ersa</char> matugieseda <char style="png">Yelusalen</char>de echidene zhanlao, fugie buwa, jinwun hanjialase hende shouku giezhi goyai aladene ghurudude aminne olukui tujiladene kielie qiiwo. <verse eid="MAT 16:21"/><verse number="22" style="v" sid="MAT 16:22"/><char style="pn">Beduru</char> <char style="pn">Ersa</char>i laidene kheila qiiwo, "Ezhan, ulie olune! Intui chii jiere ulie irene." <verse eid="MAT 16:22"/><verse number="23" style="v" sid="MAT 16:23"/><char style="pn">Ersa</char> ochira daore <char style="pn">Beduru</char>de kieliewo, "Ibilisi, mii khuina dao! Chi mii unaghane. Chi Hudai isii ulie sumulazhi kunni isii sumulane."<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>
    <char style="pn">Ersa</char> tujiladene kieliewo, "Kien mii daghane giese goyane sheidene shizijiane beiliezhi mii daghakuni wo. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Kien aminne jiuine giese aminne widaghane. Made oluzhi aminne widaghase aminne ulie widaghane. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Kun duyani man zhenjidene goya aminne widaghase yande gou wo? Kun pse yanghala aminne arunzhane? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Kunnikewon qienxienlarene hhantu hhei adani fama dunda irene. Ingiekude zhao kunni giekughala jien kunde kharulune. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Bi tande shuhua kielieye, enende beisan kun dunda niezhanla Kunnikewon qienline bareizhi irekui ulie chanlatula ulie fugune."<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s">Ula Jiere Ersani Yanzi Bienjizho</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mak 9:2-13</ref>; <ref loc="LUK 9:28-36">Luj 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Zhighudu daose <char style="pn">Ersa</char> <char style="pn">Beduru</char>, <char style="pn">Yagebu</char>, <char style="pn">Yagebu</char>i jiuni <char style="pn">Yaheiya</char>i danxin uduru undu ulade khireidene <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>hhelai melie bienjiwo. Ungieni naran mutun gieghan wo, jienni chighande gon niekielien wo. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Menzhali <char style="pn">Musa</char>, <char style="pn">Iliya</char>ghala <char style="pn">Ersa</char>re kielien kieliesei hhela chujieghewo. <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/><char style="pn">Beduru</char> <char style="pn">Ersa</char>de kieliezho, "Ezhan, matan enende gou wo. Chi duran bise bi enende ghuran zhanfan daiye. Niei chade, niei <char style="pn">Musa</char>de, niei <char style="pn">Iliya</char>de." <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/><char style="pn">Beduru</char> kieliekude menzhali niegieda gon faisan olien iredene hhelai khawo. Oliense shenqi irezhi kieliewo, "Eneshi bi oresan mii kewon wo. Bi hhende xiqi wo. Ta hhei kielienyi chenlie!" <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>Tujila sonosudene hende ayizhi zemin jiere papalawo. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/><char style="pn">Ersa</char> melie iredene hhelai maqizhi kieliewo, "Bosizhe, bu ayi." <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Hhela qiorunne qila uzhese <char style="pn">Ersa</char>se chugo kiemai ese chanlawo.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Ulase boukude <char style="pn">Ersa</char> hhelade fenfulazhi kieliewo, "Kunnikewon fugusan kun dundase aminne ulie olutula ta chanlasei kiemade bu kielie." <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>Tujila <char style="pn">Ersa</char>de asawo, "Qinse jinwun hanjiala yangiezhi <char style="pn">Iliya</char> ijinyo xien irene giezhi kieliezho?" <verse eid="MAT 17:10"/><verse number="11" style="v" sid="MAT 17:11"/><char style="pn">Ersa</char> kieliewo, "<char style="pn">Iliya</char> irezhi man erchan gie goudaghanema, <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>bi tande kielieye, hhe ijin irezhoma, kunla hhei tani dazhi shimatu giezho. Kunnikewonniye niekielienji zayalane." <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/><char style="pn">Ersa</char> xili gieghasan <char style="pn">Yaheiya</char>i zhiizhi kieliesei tujila caigie minbai oluzho.<verse eid="MAT 17:13"/></para>
  <para style="s">Sheitan Heisan Kewonni Goudaghazho</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mak 9:14-29</ref>; <ref loc="LUK 9:37-43">Luj 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>
    <char style="pn">Ersa</char> tujilarene iban kunlai shida irese nie kun <char style="pn">Ersa</char>i melie ire xiutuliezhi kieliewo, <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>"Ezhan, mii kewonde ubali nie xii! Hhende kharalaku gien kurudene tendun fugie wo. Haojihui khande usude anda bouzho. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Bi udurudene tujila shidachii echise hhela goudagha dane." <verse eid="MAT 17:16"/><verse number="17" style="v" sid="MAT 17:17"/><char style="pn">Ersa</char> kieliewo, "Ai, ta ene xianxin gieku witu, xiemecha yochen kunla, bi tanse rennai giezhi giedoghoncha beine? Kewonni uduruzhi mii enende ire!" <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/><char style="pn">Ersa</char> sheitanyi nie sugiese sheitan khizhewo. Hhe shihoude kewon goudawo. <verse eid="MAT 17:18"/><verse number="19" style="v" sid="MAT 17:19"/>Ingiekude tujila <char style="pn">Ersa</char>i shida konkonji ire asawo, "Bijien yangiezhi ene sheitanyi khigha dane?" <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/><char style="pn">Ersa</char> kieliewo, "Tai xianxin gieku texien gaji wo. Bi tande shuhua kielieye, tande caizi fure chigei xianxin gieku bise ta ene ulade enense noidene hhende dao giezhi kieliese daone, ingiese ta yama gie dakui uwo."<verse eid="MAT 17:20"/></para>
  <para style="s">Ersa Duya Ijiezhi Aminne Olukui 2 Hui Kieliezho</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mak 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luj 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Hhela <char style="png">Jialili</char>de hhantulakude <char style="pn">Ersa</char> tujilade kieliewo, "Kunnikewonni kunlai khade jiuidene <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>hhela alase ghurudude aminne olune." Ingiese tujila hende yuchou giezho.<verse eid="MAT 17:23"/></para>
  <para style="s">Mechide Shui Shanjikui Kieliezho</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Hhela <char style="png">Jiabainun</char>de irese mechide shui shanjisan kunla <char style="pn">Beduru</char>i melie ire kieliewo, "Tai loushi shui ulie jiuinu?" <verse eid="MAT 17:24"/><verse number="25" style="v" sid="MAT 17:25"/><char style="pn">Beduru</char> kieliewo, "Jiuine." <char style="pn">Beduru</char> giedoura orose <char style="pn">Ersa</char> xien hhende asawo, "<char style="pn">Ximun</char>, chii isi matugiezho? Duyani honshanla kiense shui, baer ghurazho? Goya kunlase onu, niman kunlase wo?" <verse eid="MAT 17:25"/><verse number="26" style="v" sid="MAT 17:26"/><char style="pn">Beduru</char> kieliezho, "Niman kunlase wo." <char style="pn">Ersa</char> kieliezho, "Qingiese goya kunlanughunne mienlienema, <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>matan reikusene ayine, chi haibienzide echisenu zhaghasun barei. Touchan bareisan amanyini keighama, nie miengui chanlane. Chi agizhi echidene matan ghualanughunyi jiui."<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s">Kien Zui Fugie Wo Giezho</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mak 9:33-37</ref>; <ref loc="LUK 9:46-48">Luj 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Hhe shihoude tujilani <char style="pn">Ersa</char>i shida ire asawo, "Asiman gojiade kien zui fugie wo?" <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/><char style="pn">Ersa</char> nie kewosii uruzhi ire hhelai dunda beighadene kieliewo, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>"Bi tande shuhua kielieye, ta geizhen giezhi kewosi mutun ulie gholuse asiman gojiade oro dane. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Ingiese kien ene kewosi mutun goyane meilade uzhese asiman gojiade zui fugie wo. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Kien mii niereghala intu kewosii jienliese mii jienliezho."<verse eid="MAT 18:5"/></para>
  <para style="s">Zui Fanjighaku</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mak 9:42-48</ref>; <ref loc="LUK 17:1-2">Luj 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>"Kien mii xianxin giesan enezighan ga kun dundadu niei zui fanjighase ghuzhundeni qiemanshai banladene haini gunde boughase da gou wo. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>Zui fanjiku yenyinghala ene duyade gou widawo. Zui fanjighaku shiqin chan winema, kunlai zui fanjighasan hhe kunde gou widawo! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Chii nie kha onu nie kon chii zui fanjighase chizhidene benda! Ghua kha ghua kon bidene chanqiku khande bendatula nie kha onu nie kon feiliedene chanqi amitukude orose da gou wo. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Chii nie nudun chii zui fanjighase waidene benda! Ghua nudun bidene dozoheini khande bendatula nie nudun feiliedene chanqi amitukude orose da gou wo."<verse eid="MAT 18:9"/></para>
  <para style="s">Miisan Ghonii Bilazho</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luj 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>"Ta xioxin giezhi enezighan ga kun dundase nieiliuzhe meilade bu uzhe. Bi tande kielieye, hhelai qienxienla asiman jieredu adaimi shida chanqi wine. <verse eid="MAT 18:10"/><verse number="12" style="v" sid="MAT 18:12"/>Nie kunde 100 gie ghoni wo. Nieni yo widase ta sumulase matugiene? 99 gieni ulade jiesenu widasan ghonii ereile ulie echinu? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Bi tande shuhua kielieye, hhe ereizhi oluse uye widasan 99 giese da olon bayasune. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Tai asiman jieredu adaye niekielien wo. Enezighan ga kun dundadu nieiliuzhe widaghaku duran uwo."<verse eid="MAT 18:14"/></para>
  <para style="s">Zui Fanjisan Gaijiude Matugie Giene</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>"Gaijiuchii zui fanjise hhei hhende echizhi zinie ta ghuala bikude codaseini kielie. Hhe chii kielienyi chenliese chade nie gaijiu olodowo. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Hhe ulie chenliese kun nie ghua urudene tanghala echi. Ingiese 'jien zhasan shiqinlai ghua, ghuran kunni ganzhenghala shidaghane.' <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Hhe pse ulie chenliese jiohuide kielie. Jiohuini kunlanughunyiye ulie chenliese niman kun, shui shanjisan kun mutun uzhe. <verse eid="MAT 18:17"/><verse number="18" style="v" sid="MAT 18:18"/>Bi tande shuhua kielieye, ta zemin jiere yan banlase, asiman jiereye yan banlane. Ta zemin jiere yan andaghase asiman jiereye yan andaghane. <verse eid="MAT 18:18"/><verse number="19" style="v" sid="MAT 18:19"/>Bi pse tande kielieye, tai dunda ghuala hhantulazhi nie zhugheghala zemin jiere onxian giesanlai asiman jiereshiku adami man chenjighane. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Ghua ghuran kun mii niereghala khala hhantulase bi hhelai dunda wine."<verse eid="MAT 18:20"/></para>
  <para style="s">Ubali Ulie Xiichen Hoji</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Ingiekude <char style="pn">Beduru</char> shidani ire kieliewo, "Ezhan, jiumi made gieduifa zui fanjise bi gieduifa hhei rouliene? Doleifashi kurulie?" <verse eid="MAT 18:21"/><verse number="22" style="v" sid="MAT 18:22"/><char style="pn">Ersa</char> kieliewo, "Bi chade kielieye, doleifa ulie kurune, 70 gie doleifa wo. <verse eid="MAT 18:22"/><verse number="23" style="v" sid="MAT 18:23"/>Ingiese asiman gojiashi hoxian honshan hojilarene zhan sanaku niekielien wo. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Sanazhi qiikude 50 on antan<note caller="+" style="f"><char style="fr">18:24</char> <char style="em">10000 talante</char> </note> chaisan kunyi uduruzhi irewo. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Hhende yama honjikui uwo, ezhanni minlin xiaizhi hhei, biereiini, kesilaini, pse bisanlaini man huidene honji giezho. <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>Hhe hoji papaladene, 'Made shijien pse gouji ogi, bi man honjine.' giezhi kieliezho. <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Ezhanni hhende ubali xiidene andaghazhi chaisan baerni man rouliewo."<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>"Ene hoji khizhedene hhende hharan miengu chaisan hhantuku kunyi penjidene bareizhi ghuzhunsei nieqidene, 'Chaisan baerni iregha.' giezho. <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/>Hhantuku kunni papaladene 'Shijien gouji ogima, bi honjiye.' giezhi xiahua giezho. <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>Hhe kun ulie olune giedene chaisan baerni honjitula bafanzide khazho. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Pseshiku hojila enei chanladene hende nango giedene echi ene shiqinyi man ezhandene huibao giewo. <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>Ingie ezhanni hhe kunyi uru iredene kieliewo, 'Chi ene doghun hoji! Chi mii xiahua giese bi chi chaisanlai man rouliewo. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Bi chade ubali xiizho giezhi chi hhantuku kundene qingiezhi indan ubali xiise ulie olunu?' <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Ezhanni hende hokudene chaisan baerni man honjitula bafanzi sagheisan kunlade jiuizhi eghighazho. <verse eid="MAT 18:34"/><verse number="35" style="v" sid="MAT 18:35"/>Ta gaijiune zhughesene ingiezhi ulie rouliese asiman jieredu adamiye tande ingiezhi giene."<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s">Lihun Gieku Shiqin</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mak 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>
    <char style="pn">Ersa</char> ene kielienlai kielie baraghadene <char style="png">Jialili</char>se likai giezhi <char style="png">Yedanhe</char> duimienni <char style="png">Yudaya</char> oronde irewo. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Tebieji olon kunla hhei daghazho, <char style="pn">Ersa</char> hhende kunlai goudaghawo.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Falisai kunla ire <char style="pn">Ersa</char>i shiizhi asazho, "Kun yan yenyinghalaliuzhe biereine lihun gieghase olunulie?" <verse eid="MAT 19:3"/><verse number="4" style="v" sid="MAT 19:4"/><char style="pn">Ersa</char> kieliewo, "Kunyi zhayaghasan Huda dei qiikude ere kun, eme kunyi zhayaghawo giezho. <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Pse, 'Ingiese kun ada anasene likai giedene biereighalane hhantulazhi ghuala nie beye gholune.' giezhi kieliesan jinwunni ta onshizhi ese daowu? <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Hhela ghua pusho, nie wo. Ingiese Huda hhantulaghasei kun fenkai gieghase ulie olune." <verse eid="MAT 19:6"/><verse number="7" style="v" sid="MAT 19:7"/>Falisai kunla asawo, "Qinse <char style="pn">Musa</char> yangiezhi lihun qiuzi ogidene lihun gie giezhi fenfulawo?" <verse eid="MAT 19:7"/><verse number="8" style="v" sid="MAT 19:8"/><char style="pn">Ersa</char> hhelade kieliewo, "Tai zhughe khidunshi <char style="pn">Musa</char> ta biereine lihun gieghase olune giezhoma, dei qiikude ingie ese giezho. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Bi tande kielieye, kien lon kijieku yenyinse chugo biereighalane lihun giedene pse agise piofen giezho."<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Tujilani <char style="pn">Ersa</char>de kieliewo, "Ere kun bierei kunyi gonxi imutuishi jiehun ulie giese da gou wo." <verse eid="MAT 19:10"/><verse number="11" style="v" sid="MAT 19:11"/><char style="pn">Ersa</char> kieliewo, "Ene kielienyi kienliuzhe man jienlie shidaku pusho, kiende nengou ogise kien jienliene. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Niezhan kunla olusanse jiehun gie dane. Niezhan kunlai kunla ataladene jiehun gie dane. Pse niezhan kunla asiman gojiade oluzhi goyane jiehun ulie giene. Ene kielienyi kien jienlie shidase jienliedu."<verse eid="MAT 19:12"/></para>
  <para style="s">Ersa Kesilade Oluzhi Onxian Giezho</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mak 10:13-16</ref>; <ref loc="LUK 18:15-17">Luj 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Ingiekude kunla kesilane uduruzhi <char style="pn">Ersa</char>i melie ire hhelai jiere kha teizhi onxian gieghane giese tujila hhelai sugiezho. <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>Ingiese <char style="pn">Ersa</char> kieliezho, "Kesilai bu dui, mii shida ire gie. Asiman gojiashi imutu kunlanughun wo." <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/><char style="pn">Ersa</char> hhelai jiere khane teidene hhense likai giewo.<verse eid="MAT 19:15"/></para>
  <para style="s">Nasuchighan Baertu Kun</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mak 10:17-31</ref>; <ref loc="LUK 18:18-30">Luj 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Nie kun <char style="pn">Ersa</char>i melie iredene kieliewo, "Loushi, bi yan gouni giese chanqiku amin wine?" <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/><char style="pn">Ersa</char> kieliewo, "Chi made yangiezhi gouni asane? Zi niekozishi gouni wo. Chi chanqiku aminyi jienliene giese minlinni zunji." <verse eid="MAT 19:17"/><verse number="18" style="v" sid="MAT 19:18"/>Hhe asawo, "Yan minlin wo?" <char style="pn">Ersa</char> kieliewo, "Kun bu ala, piofen bu gie, bu ghula, jia ganzhen bu bei, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ada anane zunji, goyadene mutun giebeidene ore." <verse eid="MAT 19:19"/><verse number="20" style="v" sid="MAT 19:20"/>Nasuchighan kun kieliewo, "Enelai bi man zunjiwo, pse yan chaizho?" <verse eid="MAT 19:20"/><verse number="21" style="v" sid="MAT 19:21"/><char style="pn">Ersa</char> hhende kieliewo, "Chi man qiendaghaku duran bise echidene bisanlane man huizhi nanxin kunlade ogi. Ingiese chii boubei asiman jiere wo. Ingiedene irezhi mii dagha." <verse eid="MAT 19:21"/><verse number="22" style="v" sid="MAT 19:22"/>Nasuchighan kunde caichan olonshi ene kielienyi chenliedene yuchourazhi yolawo.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>
    <char style="pn">Ersa</char> tujiladene kieliewo, "Bi tande shuhua kielieye, bayan kun asiman gojiade oroku chijia wo. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Bi tande pse kielieye, loto zhun boghose daoku bayan kun Hudai gojiade orokuse da sunfan wo." <verse eid="MAT 19:24"/><verse number="25" style="v" sid="MAT 19:25"/>Tujila enei chenliedene ghanirazhi kieliewo, "Ingiese kienyi jiui shidane?" <verse eid="MAT 19:25"/><verse number="26" style="v" sid="MAT 19:26"/><char style="pn">Ersa</char> hhelai uzhedene kieliewo, "Kun enei gie danema, Huda yanniliuzhe giene."<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Ingiekude <char style="pn">Beduru</char> kieliewo, "Uzhe, bijien man bendadene chii daghazho. Jianlai bijiende yan wine?" <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, shini duyade Kunnikewon goyane famatu baozo jiere soukude, ta enezighan mii daghasan kunlaye 12 gie baozo jiere souzhi <char style="png">Isilie</char>ni 12 gie paini gonjine. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Kien mii nierede oluzhi gie, gaijiu, eghechijiu, ada, ana, kesila, ghazhane bendase 100 pei ogine, da chanqiku aminni jienliene. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Ingiese olon melieshikula khuinashilane, khuinashikula melieshilane."<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s">Putou Yenzide Kun Guisan Zhanguiji</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>"Asiman gojia hoxian nie gieni zhanguijii xianli. Eqiemagha eqie khizhi echizhi kun guidene putou yenzidene wilie gieghane giezho. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Wiliechilaghala niudu nie miengu ogikui kielie goudaghadene hhelai putou yenzide echighawo. <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>Eqiemagha 9 jien olukude zhanguiji khizhi echise jide xien beisan kunyi chanladene <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>hhelade kieliewo, 'Taye putou yenzide ire, tande heshide baer ogine.' <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Ingie hhela echiwo. Xiawu 12 jien, pse 3 jien olukude zhanguiji khizhi echidene ye ingiezhi giewo. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Hhe xiawu 5 jien olukude pse khizhi echise dou xien beisan kunni chanladene hhelade asawo, 'Ta niudu enende beizhi wilie giele yale ese echizho?' <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/>Hhela kieliewo, 'Bijienyi kieme ese guizho.' Hhe kieliewo, 'Taye putou yenzide ire.' <verse eid="MAT 20:7"/><verse number="8" style="v" sid="MAT 20:8"/>Khara oluse putou yenzii zhanguiji duizhande kieliewo, 'Wilie giesan kunlai uruzhedene zui khuina iresanse baerlaini ogizhi zui melie kuru.' <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>Xiawu 5 jien olukude iresan kunla nie kun nie miengu linlawo. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Zui melie iresan kun iredene olon ogimu giezhoma, yen nie kun nie miengu linlawo. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Hhela linladene zhanguijide boxin giezhi kieliezho, <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>'Bijien khara naran doura niudu khishilazho. Enezighan khuina iredene nie zhuntou wilie giesan kunlai bijienre niekielien uzhezho.' <verse eid="MAT 20:12"/><verse number="13" style="v" sid="MAT 20:13"/>Ingiese zhanguiji hhelai dundashiku nie kunde kieliewo, 'Zhanlien, bi chii ese kuighazho. Matan ghuala kieliesanshi nie miengu wola? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Goyanughunne agidene echi. Zui khuina iresan hhe kunde chade ogisanghala niekielien ogise bi yenyi wo. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Bi duranghalane baerne injise ulie olunu? Bi gou kun danlase chi dubilienu?' <verse eid="MAT 20:15"/><verse number="16" style="v" sid="MAT 20:16"/>Ingiese khuinashikula melieshilane, melieshikula khuinashilane."<verse eid="MAT 20:16"/></para>
  <para style="s">Ersa Ku Shouizhi Aminne Olukui Ji 3 Hui Kieliezho</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mak 10:32-34</ref>; <ref loc="LUK 18:31-34">Luj 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de khireikude mo jiere 12 gie tujine uruzhi ire hhelade kieliewo, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>"Uzhe, matan <char style="png">Yelusalen</char>de khireine. Kunnikewonyi fugie buwa, jinwun hanjialade jiuise hhela hhei sixin panjidene <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>niman kunlade jiuine. Hhela hhei xilun giene, mabienzighala eghine, shizijia jiere ghada alane. Ingie ghurudude aminne olune."<verse eid="MAT 20:19"/></para>
  <para style="s">Ghua Tujini Anani Ersai Xiahua Giezho</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mak 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Ingiekude <char style="pn">Xibitai</char>ni bierei ghua kewonne uduruzhi <char style="pn">Ersa</char>i melie ire xiutuliezhi xiahua giezho. <verse eid="MAT 20:20"/><verse number="21" style="v" sid="MAT 20:21"/><char style="pn">Ersa</char> kieliewo, "Chi yan kerene?" Hhe kieliewo, "Mii onxianshi ghua kewonyimi chii gojiade niei chii borun miende niei soghei miende sougha." <verse eid="MAT 20:21"/><verse number="22" style="v" sid="MAT 20:22"/><char style="pn">Ersa</char> kieliewo, "Ta ghuala yan keresanne ulie mejiene. Bi shouiku kuni ta shoui shidanu?" Hhela kieliewo, "Shouine." <verse eid="MAT 20:22"/><verse number="23" style="v" sid="MAT 20:23"/><char style="pn">Ersa</char> kieliewo, "Bi shouiku kuni ta shouinema, mii lianmien kanzide soughakui bi ogiku pusho. Adami kiende zhunbei giezhoshi kiende ogine."<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Psedu hharan tujini sonosudene hhe gaijiughalade hokuzho. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/><char style="pn">Ersa</char> hhelai uruzhi ire kieliewo, "Niman kunlai dunda lindao, noyenla qienli bareizhi kunlai gonjisei ta mejiene. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Ta niekielien pusho, tai dunda kien fugieni danlane giese tande ushilachen kun danlakuni wo. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Tai dunda kien laoda danlane giese tande hoji danlakuni wo. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Kunnikewon irekushi kunlai ushilaghale ese irezho. Kharei kunlai ushilazhi aminne sheidene olon kunlade shuiku Jiage danlale irezho."<verse eid="MAT 20:28"/></para>
  <para style="s">Ghua Sughoi Goudaghazho</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mak 10:46-52</ref>; <ref loc="LUK 18:35-43">Luj 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Hhela <char style="png">Yelige</char>se likai giekude tebieji olon kunla <char style="pn">Ersa</char>i daghazho. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Ghua sugho mo bienzide souzho. <char style="pn">Ersa</char> daosei sonosudene waradazho, "Ezhan, <char style="pn">Dawude</char>ni houdei, bijiende ubali nie xii!" <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>Kunla jiebalazhi shenqi bu khizhe giese hhela genjia fugiede waradazhi kieliezho, "Ezhan, <char style="pn">Dawude</char>ni houdei, bijiende ubali nie xii!" <verse eid="MAT 20:31"/><verse number="32" style="v" sid="MAT 20:32"/><char style="pn">Ersa</char> beidene hhelai uruzhi ire kieliezho, "Bi tande yan giene?" <verse eid="MAT 20:32"/><verse number="33" style="v" sid="MAT 20:33"/>Hhela kieliezho, "Ezhan, bijienyi nudunyi goudagha!" <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/><char style="pn">Ersa</char>i zhugheni zholieredene hhelai nudunyi nie moise hhela deigo chanladene <char style="pn">Ersa</char>i daghawo.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s">Honshan Mutun Yelusalende Orozho</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mak 11:1-11</ref>; <ref loc="LUK 19:28-40">Luj 19:28-40</ref>; <ref loc="JHN 12:12-19">Yah 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Hhela <char style="png">Yelusalen</char>se chadashizhi <char style="png">Ganlanshan</char>ni <char style="png">Bofaqi</char>de irekude <char style="pn">Ersa</char> ghua tujine peizhi <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>hhelade kieliewo, "Ta duimienni aghinde echi. Hhende nie huiyasan enzheghei deigo chanlane, shidai da nie unaghan wo. Ta andaghadene mii shida lai ire. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Kunla tande asase, 'Ezhan hhelai injine.' giezhi kieliema, hhe kun deigo laighane."<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Ene shiqin fashen giekushi Ezhan xienzhini tungo giezhi kieliesan kielien mutun gholughane giezho,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>"<char style="png">Xiwun</char>ni<note caller="+" style="f"><char style="fr">21:5</char> <char style="em">Yelusalen</char> </note> kunlade kielie.</para>
  <para style="q2" vid="MAT 21:5">Uzhe, tai honshan tai hhende irewo.</para>
  <para style="q1" vid="MAT 21:5">Hhe goyane meilade uzhezhi enzheghe unuzho.</para>
  <para style="q2" vid="MAT 21:5">Unusanshi ga enzheghe wo."<verse eid="MAT 21:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6"/>Tujila echidene <char style="pn">Ersa</char> fenfulasan mutun giewo. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Hhela enzheghe, ga enzheghei lai ire goya jienlane enzheghe jiere daidene <char style="pn">Ersa</char>i unughawo. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Olon kunla jienlane mo jiere peizho. Psedu kunla mutun chalai chizhidene mo jiere peizho. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Melie khuinadu olon kunla waradazhi kieliezho,</para>
  <para style="q1" vid="MAT 21:9">"Hesanna! <char style="pn">Dawude</char>ni houdeii doulandu!<note caller="+" style="f"><char style="fr">21:9</char> <char style="em">Bijienyi jiui!</char> </note></para>
  <para style="q2" vid="MAT 21:9">Ezhanni niereghala iresan hhei doulandu!</para>
  <para style="q2" vid="MAT 21:9">Zui undudedu Hudai doulandu!"<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>
    <char style="pn">Ersa</char> <char style="png">Yelusalen</char>de orose kunla man hunnerei daghazhi eneshi kien wo giezho. <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>Olon kunla kieliezho, "Eneshi <char style="png">Jialili</char>yi <char style="png">Nasale</char>ni xienzhi <char style="pn">Ersa</char> wo."<verse eid="MAT 21:11"/></para>
  <para style="s">Mechini Arughazho</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mak 11:15-19</ref>; <ref loc="LUK 19:45-48">Luj 19:45-48</ref>; <ref loc="JHN 2:13-22">Yah 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>
    <char style="pn">Ersa</char> mechide orodene meimei giesan kunlai man tou khighawo. Baer arunzhasan kunlai shire, ghoghochen huisan kunlai bandoulai tungu unaghawo. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Hhelade kieliewo,</para>
  <para style="q1" vid="MAT 21:13">"Mii giei onxian gieku gie giezhi urune giezhi jinwun jiere huaizho.</para>
  <para style="q2" vid="MAT 21:13">Ta ghughei ho gholughazho!"<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Mechi sudoro sugho, dogholonla <char style="pn">Ersa</char>i shida irese hhelai goudaghawo. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Fugie buwa, jinwun hanjiala <char style="pn">Ersa</char> ghaniraku shiqin giesei chanladene pse kesila mechi doura Hesanna! <char style="pn">Dawude</char>ni houdeii doulandu giezhi onghonosei sonosudene hende hokuzhi <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/><char style="pn">Ersa</char>de asawo, "Enezighan kesila kieliesei chi sonosuwoye?" <char style="pn">Ersa</char> kieliewo, "Sonosuwo. Jinwun jiere chi yeliwa, ga kesilai amanghala goyane doulaghawo giesei ta onshizhi ese daowu?" <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>Ingie hhelase likai giezhi chenshise khidene <char style="png">Bodani</char>de echi nie xii souwo.<verse eid="MAT 21:17"/></para>
  <para style="s">Uhuago Mutunni Kharazho</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mak 11:12-14</ref>, <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>
    <char style="pn">Ersa</char> eqiemagha chenshide khareikude oliesuzho. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Mo bienzide nie uhuago mutunyi chanlawo. Shidani echi nie uzhese mutun jiere lachen wine, alima uwo. <char style="pn">Ersa</char> mutunde, "Enedu khuinase chii jiere ibeizi alima ulie soune." giezhi kieliese uhuago mutun deigo gho fuguwo. <verse eid="MAT 21:19"/><verse number="20" style="v" sid="MAT 21:20"/>Tujila uzhedene ghudurezhi, "Uhuago mutun matugie deigo gho fuguwo." giezhi kieliezho. <verse eid="MAT 21:20"/><verse number="21" style="v" sid="MAT 21:21"/><char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, tande xianxin gieku bizhi inxin ulie giese bi uhuago mutun jiere giesei taye gie shidane, da ene ulade oronsene noidene haide bou giezhi kieliese boune. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Ta xianxin giedene xiahua giezhi onxian giese man ogine."<verse eid="MAT 21:22"/></para>
  <para style="s">Ersani Qienlini Asazho</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mak 11:27-33</ref>; <ref loc="LUK 20:1-8">Luj 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>
    <char style="pn">Ersa</char> mechide orodene kunlade sughakude fugie buwa, bexinlai zhanlaola hhei shida ire kieliezho, "Chi yan qienlighala ene shiqinlai giezho? Kien chade ene qienlii ogizho?" <verse eid="MAT 21:23"/><verse number="24" style="v" sid="MAT 21:24"/><char style="pn">Ersa</char> hhelade kieliewo, "Biye tande nie unqi asaye. Ta made kieliese biye yan qienlighala ene shiqinlai giesei tande kieliene. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/><char style="pn">Yaheiya</char>i xili gieghaku qienli khalase irezho? Asimanse onu, kunlase wo?" Hhela goyalane shanlian giezhi kieliewo, "Matan asimanse wo giese, 'Ta yale hhei xianxin ulie giene.' giezhi hhe matande kieliene. <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Kunlase wo giese matan bexinlase ayizho, hhela man <char style="pn">Yaheiya</char>shi xienzhi wo giezho." <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>Ingie <char style="pn">Ersa</char>de kieliewo, "Bijien ulie mejiene." <char style="pn">Ersa</char> hhelade kieliewo, "Biye tande yan qienlighala ene shiqinlai giesei ulie kieliene."<verse eid="MAT 21:27"/></para>
  <para style="s">Ghua Kewonni Bilazho</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>"Ta nie sumula bi ede bilaku matugiezho? Nie kunde ghua kewon wo. Hhe fugie kewondene kieliezho, 'Mii kewon, chi enedu putou yenzide wilie giele echi.' <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>Kewonni kieliewo, 'Bi ulie echine.' Khuinashida houhui giedene echiwo. <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>Adani echidene meila kewondene ye niekielienji kieliezho. Kewonni kieliewo, 'Ada, bi echiye.' Ingiedene ese echiwo. <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>Ta sumulase ene ghua kewonlani alinie adane kielienyi chenliezho?" Hhela kieliewo, "Fugie kewon wo." <char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, shui shanjisan kun, biozila tanse melie Hudai gojiade orone. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/><char style="pn">Yaheiya</char> tai hhende irekude gou moni uzheghazho. Ta hhei xianxin ulie giene, shui shanjisan kun, biozila hhei xianxin giezho. Ta hhela xianxin giesei uzhedene dou geizhen ulie giezhi xianxin ulie giene."<verse eid="MAT 21:32"/></para>
  <para style="s">Doghun Wiliechilani Bilazho</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mak 12:1-12</ref>; <ref loc="LUK 20:9-19">Luj 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>"Ta pse nie bilasei chenlie. Nie gieni zhanguiji nie yenzi putou zeiladene izhonyini qienjiwo. Sudoroni jiu daruku chizi waizhi yenzi uzheku teizi giedene kunlade bouizhi ogi, gholode echiwo. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Ghuraku shihou oluse hojilai peizhi bouisan kunlase nexianne ghuraghale echiwo. <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>Bouisan kunla hojilaini bareidene nieini eghiwo, nieini alawo, nieini tashida alawo. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Zhanguijii pse genjia olon hojilai peizhi echighase bouisan kunla yen qingiezhi duidai giewo. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Zuihoude hhela kewonyimi zunjineba giezhi kewonne peizhi echighawo. <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/>Bouisan kunla kewonyini chanladene nieniedene kielienduzho, 'Eneshi jiachanni jienliechen wo. Matan enei aladene jiachanni zhanjiye!' <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Ingie hhei bareidene putou yenzise tungu khigha alawo. <verse eid="MAT 21:39"/><verse number="40" style="v" sid="MAT 21:40"/>Ingiese putou yenzii zhanguiji irekude bouisan kunlai matugiene?"<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Hhela kieliewo, "Doghun kunlai ese rouliezhi aladene putou yenzini nanshi putou jiuichen kunlade bouizhi ogine." <verse eid="MAT 21:41"/><verse number="42" style="v" sid="MAT 21:42"/><char style="pn">Ersa</char> hhelade kieliewo. "Ta jinwun jiere onshizhi ese daowu?</para>
  <para style="q1" vid="MAT 21:42">'Gie giesan kunla bendasan tashi</para>
  <para style="q2" vid="MAT 21:42">giei zhunyo tashi gholuwo.</para>
  <para style="q1" vid="MAT 21:42">Eneshi Ezhan giesanwo.</para>
  <para style="q2" vid="MAT 21:42">Matan uzhese xihan giezho.'<verse eid="MAT 21:42"/></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43"/>Ingiese bi tande kielieye, Hudai gojiai tanse agi echidene Hudai gojiade oluzhi jiego khizheghasan minzude ogine. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Kien ene tashi jiere anda bouse zhazhazi gholune. Ene tashi kienyi jiere anda bouse zai miendaghane."<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Fugie buwa, Falisai kunla <char style="pn">Ersa</char> bilasei chenliedene hhelai zhiizhi kieliesei mejie <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/><char style="pn">Ersa</char>i bareine giese olon kunlase ayizho. Olon kunla <char style="pn">Ersa</char>i xienzhi wo giezho.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s">Ghurunde Xinlaku</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luj 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>
    <char style="pn">Ersa</char> hhelade pse bilazhi kieliewo, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>"Asiman gojia hoxian nie honshan kewondene bierei agizhi xi beilasei xianli. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Hhe hojilane peizhi xinlasan kunlai ghurunde ire giezhi urughale echiwoma, hhela ulie irene. <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>Honshan psedu hojilai peizhi kieliewo, 'Ta xinlasan kunlade kielie. Bi ijin xini beila goudaghawo. Fughe, taghun tughuchalai zharuzhi man zhunbei giewo. Ta ghurunde irendu.' <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>Hhezighan kunla ese gonjidene yolawo. Nieni ghazha jierene echiwo, nieni meimei giele echiwo. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Pseshikula honshanyi hojilai bareidene shizheghazhi alawo. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Honshan hokudene buduilai peizhi hhezighan alasan kunlai aladene hhelai chenshini tulie widaghawo. <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>Ingie hojiladene kieliewo. 'Ghurunni zhunbei giezhi goudaghazhoma, xinlasan kunla pei dane. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Ta dalu kouzide echisenu chanlasan kunlai man ghurunde xinlazhi ire.' <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Hhezighan hojilani dalu jiere echidene gou kun, doghun kunni ese gonjidene man uruzhi ire ghurunde zhochen duruwo. <verse eid="MAT 22:10"/><verse number="11" style="v" sid="MAT 22:11"/>Honshan orozhedene shire jieredu zhochenlai nie uzhese ghurunde musiku jien uye musisan nie kunni chanla, <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>hhende 'zhanlien, chi enende irese yangiezhi ghurunde musiku jien ese musizho?' giese hhe kunde yama shenqi uwo. <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/>Ingie honshan ushilachen kunlade kieliewo, 'Kha konyini banladene ghadanedu kharanide benda, hhende shidunne zhouzhi wila gie.' <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/>Urusan kun olon wo, sunghusan kun choghon wo."<verse eid="MAT 22:14"/></para>
  <para style="s">Shui Jiuiku</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mak 12:13-17</ref>; <ref loc="LUK 20:20-26">Luj 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Falisai kunla echidene shanlian giezhi <char style="pn">Ersa</char>i kieliense matugie maobin ereizhi heine giezho. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Hhela tujilane, Hherodepai kunni peizhi <char style="pn">Ersa</char>i hhende echighase kieliewo, "Loushi, chi shuhua kieliekui bijien mejiene. Chi yan kunyiliuzhe niekielien uzhezhi kunni mienzii ulie uzhene. Hudai daolini shixinde sughazho. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Chii isi matugiezho? Bijiende nie kielie, matan <char style="pn">Kaisa</char> honshande shui jiuise oluzhou ese oluzho?" <verse eid="MAT 22:17"/><verse number="18" style="v" sid="MAT 22:18"/><char style="pn">Ersa</char> hhelai doghunni uzhe khizhedene kieliewo, "Jiazhon giesan kunla, ta mii shiizhi yangiene? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Shui jiuiku baerni made nie uzhegha." Hhela nie mienguni agizhese <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/><char style="pn">Ersa</char> kieliewo, "Ene qiorun, haoshi kiennughun wo?" <verse eid="MAT 22:20"/><verse number="21" style="v" sid="MAT 22:21"/>Hhela kieliewo, "<char style="pn">Kaisa</char>nughun wo." <char style="pn">Ersa</char> kieliewo, "Qinse <char style="pn">Kaisa</char>nughunshi <char style="pn">Kaisa</char>de ogi, Hudanughunshi Hudade ogi." <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>Hhela chenliedene ghanirazhi <char style="pn">Ersa</char>se likai gie yolawo.<verse eid="MAT 22:22"/></para>
  <para style="s">Aminne Oluku</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mak 12:18-27</ref>; <ref loc="LUK 20:27-40">Luj 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Fuho gieku shiqin uwo giesan Sadugai kunla yen hhe udude <char style="pn">Ersa</char>i shida ire asawo, <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>"Loushi, <char style="pn">Musa</char> guijin jiere kieliezho, nie kunde kewosi wi fuguse jiuni gaine biereii zhoui gaidene houdei liuikuni wo giezho. <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Bijienyi enende gaijiu dololie wo. Laodani bierei agidene kewosi wi fuguse jiuni zhouiwo. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Laoer, laosan, dololie man ingiezho. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Zuihoude biereiye fuguwo. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Ingiese fuho giekude hheshi dololie dundadu kienyi bierei wo? Hhela man hhei agiwo."<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>
    <char style="pn">Ersa</char> hhelade kieliewo, "Tanughun codazho. Ta jinwunni mejie dazho, Hudai nenliniye mejie dazho. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Kun aminne olukude ulie agine, ulie dafalane, asiman jieredu qienxien niekielien wo. <verse eid="MAT 22:30"/><verse number="31-32" style="v" sid="MAT 22:31-32"/>Fugusan kun aminne olukui kieliese 'bishi <char style="pn">Iburaheimu</char>ni Huda wo, <char style="pn">Isaghei</char>ni Huda wo, <char style="pn">Yagebu</char>ni Huda wo' giezhi Huda tande kieliesei ta onshizhi ese daowu? Hudashi fugusan kunyi Huda pusho, amitu kunyi Huda wo." <verse eid="MAT 22:31-32"/><verse number="33" style="v" sid="MAT 22:33"/>Olon kunla ene kielienyi chenliedene hhe sughasande hende ghanirazho.<verse eid="MAT 22:33"/></para>
  <para style="s">Zui Fugie Minlin</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mak 12:28-34</ref>; <ref loc="LUK 10:25-28">Luj 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Falisai kunla <char style="pn">Ersa</char> Sadugai kunlai kielie beighasei mejiedene hhantulazho. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Hhelai dundadu nie jinwun loushi <char style="pn">Ersa</char>i shiizhi asawo, <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>"Loushi, minlin dunda alinie zui fugie wo?" <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/><char style="pn">Ersa</char> hhende kieliewo, "Chi qienbuji zhughe, qienbuji jinshen, qienbuji sumulakughalane ezhan Hudadene ore. <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Eneshi zui fugie, ji 1 gie minlin wo. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Ji 2 gie hheghala niekielien wo. 'Goyadene mutun giebeidene ore.' <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Ene ghua minlinshi soyuji guijinshu, xienzhishuni jichu wo."<verse eid="MAT 22:40"/></para>
  <para style="s">Mexihashi Dawudeni Houdei Wo</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mak 12:35-37</ref>; <ref loc="LUK 20:41-44">Luj 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Falisai kunla hhantulakude <char style="pn">Ersa</char> hhelade asazho, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>"Mexihani kieliese ta matugie sumulazho? Hheshi kienyi houdei wo?" Hhela kieliewo, "<char style="pn">Dawude</char>ni houdei wo." <verse eid="MAT 22:42"/><verse number="43" style="v" sid="MAT 22:43"/><char style="pn">Ersa</char> kieliewo, "Qingiese <char style="pn">Dawude</char> Shenlinni tungo giezhi matugie Mexihani Ezhan giezhi uruzho? <char style="pn">Dawude</char> kieliezho,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>'Ezhan mii Ezhande kieliewo,</para>
  <para style="q2" vid="MAT 22:44">"Bi duitoulaichii kon dourachii teitula chi mii borun miende sou."'<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Qingiese <char style="pn">Dawude</char> Mexihai Ezhan giezhi uruse Mexiha matugie <char style="pn">Dawude</char>ni houdei wo?" <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Kiemada hhende yama huida gie dawo. Hhe uduse khuinashi kiemada hhende yama asa dazho.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s">Jinwun Hanjia, Falisai Kunlai Kheilazho</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mak 12:38-40</ref>; <ref loc="LUK 11:37-52">Luj 11:37-52</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Ingiedene <char style="pn">Ersa</char> olon kunlade, tujiladene kieliewo, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>"Jinwun hanjia, Falisai kunla <char style="pn">Musa</char>ni guijinyi jieshi gieku qienli bareizho. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Ingiese hhela tande sughasei ta man zunjizhi giema, hhelai giekuni bu dagha. Hhela sughasanne ulie giene. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Hhela banlasan gundu danzilani kunlai dalou jiere jiedene goyala nie kha ghurunneliuzhe ulie gojiolughane. <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/>Hhela giesan soyuji shiqinlane kunlade uzheghane giezhi giezho. Hhela zhoku jinwun xiaxiani giezhi fugiedaghazho. Jienni sasuiye giezhi fududaghazho. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Hhela xini shanxide, huitanni undu wizide soukude xiqi wo. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Giedoude kunla hhelade kielien asazhi loushi giezhi urukude xiqi wo. <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/>Ta kunlai goyane loushi giezhi bu urugha, tande zi niekozi loushi wo, ta manshi gaijiu wo. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Zemin jieredu kunni ada giezhi bu uru, tande zi niekozi ada wo, hheshi asiman jieredu ada wo. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Ta kunlai goyane shifu giezhi bu urugha. Tande zi niekozi shifu wo, hheshi Mexiha wo. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Tai dunda zui fugienishi tande hoji danlakuni wo. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Kien goyane undudaghase boghonidaghane. Goyane boghonidaghase undudaghane."<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta kunlade asiman gojiani wijienyi khazhi goyalane ese orozho, orone giechen kunlaiye ese oroghazho." <verse eid="MAT 23:13"/><verse number="15" style="v" sid="MAT 23:15"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta nie kunyi jiopaidene oroghane giezhi zemin haini yo baraghane. Hhei jiopaidene oroghadene dozoheini kun gholughazhi tanse da olon doghunshighane."<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>"Ta mo udurusan sugholade gou widawo! Ta kieliese mechii zhiizhi fayen giese yama ulie sananema, mechii antanni zhiizhi fayen giese kieliendene kuru giezho. <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Sughotu guazila, alinieshi zhunyoni wo? Antan onu? Antanni zhiguishighasan mechi wo? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Ta pse kieliese sidagha gieku teizini zhiizhi fayen giese yama ulie sananema, sidagha gieku teizi jieredu dunxilai zhiizhi fayen giese kieliendene kuru giezho. <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Sughola, daoji mure zhunyo onu mureni zhiguishighaku sidagha gieku teizi zhunyo wo? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Ingiese kien sidagha gieku teizini zhiizhi fayen giese sidagha gieku teizi, sidagha gieku teizi jiereshiku dunxilani man zhiizhi fayen giezho; <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Kien mechii zhiizhi fayen giese mechi sudoro sousan Hudai zhiizhi fayen giezho. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Kien asimanyi zhiizhi fayen giese Hudai baozo, baozo jiere sousan Hudai zhiizhi fayen giezho."<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta bohe, huajio, ziranlasene Hudade ushirei ogizhoma, guijin jieredu gundande gieku, ubali xiiku, kekaoni enezighan genjia zhunyoni ulie giene. Enelai ta indan giekui wo, psedulaiye ulie giekui pusho. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Ta mo udurusan sughola, ta meiyen ghugheini liizhi khizheghane, lotoni hulun yenjine."<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta beizi, jiezilai mienzii wagha arughazhoma, sudoroni tanxin gieku, lon giekula duruzho. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Ta sughotu Falisai kunla, xien beizi sudorodui waghazhi arugha, mienziye arune."<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta fenshua giesan mezai xianli, ghadanese uzhese gou wo, sudoro fugusan kunyi yasun, yanyanji zannanni duruzho. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Taiye kunla mienzise uzhese gou wo, sudorotai jiazhon gieku, mouxienni duruzho."<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>"Ta jiazhon giesan jinwun hanjia, Falisai kunlade gou widawo! Ta xienzhilai mezai giezho, gou kunni jilaku peizii giezhi mezai goudaghadene <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>'Xienrenlane hhe xienzide bijien bizhoshi xienzhii chusunyi xienrenlarene hhantu ulie usurughane.' giezhi kieliezho. <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Ingiezhi ta xienzhilani alasan kunlai houdei bikui zhenmin giezho. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Ta xienrenlane zuini giezhi baraghale echi! <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/>Ta enezighan moghei, du mogheini zhunzhugha. Ta matugie dozoheini faikuse andane? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Ingiese bi xienzhi, aghelitu, jinwun hanjialai tai enende peizhi ireghane. Ta niezhanlai alane, niezhanlai shizijia jiere ghadane, pse niezhanlai huitande mabienzighala eghine, ene chenshise touzhi hhe chenshide echighane. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Ingiese gou kun <char style="pn">Hhabi</char>se qiizhi izhi dajienji sidagha gieku teizi dunda alasan <char style="pn">Balajia</char>ni kewon <char style="pn">Sajialiya</char>i zuini guide kurutula soyuji gou kunla usurusan chusunni guini man tai jiere ireghane. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Bi tande shuhua kielieye, ene guini man ene idai kunlai jiere ireghane."<verse eid="MAT 23:36"/></para>
  <para style="s">Yelusalende Oluzhi Shonholozho</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luj 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>"<char style="png">Yelusalen</char>, <char style="png">Yelusalen</char>! Peizhi ireghasan xienzhilai tashidazhi alasan chenshiya, bi chii kesilani gieduifa muji tigha zhunzhughalane siban doura hhantulaghaku mutun hhantulaghane giese ta duran uwo. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Uzhe, chii gie hontan gholuzhi chade zinie hontan feiliene. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Bi chade kielieye, chi 'Ezhanni niereghala iresan kunni doulandu.' giezhi kielietula mii pse chanla dane."<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s">Jianlai Mechini Widaghane</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mak 13:1-2</ref>; <ref loc="LUK 21:5-6">Luj 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>
    <char style="pn">Ersa</char> mechise khizhedene yokude tujilani ire mechii loulani hhende zhiizhi uzheghawo. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/><char style="pn">Ersa</char> tujiladene kieliewo, "Ta enelai man chanlawu? Bi tande shuhua kielieye, jianlai man cheizhi tashi jiere tashi nieda ulie jiene."<verse eid="MAT 24:2"/></para>
  <para style="s">Duyani Zuihouku Zunji</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mak 13:3-13</ref>; <ref loc="LUK 21:7-19">Luj 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>
    <char style="pn">Ersa</char> <char style="png">Ganlanshan</char>de soukude tujila konkonji ire asazho, "Yan xienzide ene shiqinla fashen giene? Chi irezhi duya barakude yan zunji bikui bijiende nie kielie." <verse eid="MAT 24:3"/><verse number="4" style="v" sid="MAT 24:4"/><char style="pn">Ersa</char> hhelade kieliewo, "Ta xioxin giezhi kunlai bu piendagha. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Olon kunla mii niereghala iredene bishi Mexiha wo giezhi olon kunlai miine. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Ta eghindusan, eghindune giesan xioxini sonosune. Ingiese goujida bu jinda. Ene shiqin kenjin fashen gienema, duya baraku shihou dou ese kuzhezho. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Minzu, minzula eghindune. Gojia, gojiala eghindune. Gochude oliesuzhi zemin gojiolune. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Eneshi tendunni keitou wo."<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>"Hhe shihoude kunla tai barei echidene heizhi alane. Mii yenyinghala go minzula tai henjine. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Hhe shihoude olon kunla jiomunni bendane. Nieniene ghudanduzhi henjindune. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Olon jia xienzhila khizhedene olon kunlai miine. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Mouxienni olodozhi kunlai oreku zhughe widane. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Ingieliuzhe rennai giezhi zuihou kusanlai jiuine. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Asiman gojiani gouxioxini qienxiade chonji kurughazhi soyuji minzulade ganzhen beidene caigie duya baraku kuzhene."<verse eid="MAT 24:14"/></para>
  <para style="s">Fugie Zeinan</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mak 13:14-23</ref>; <ref loc="LUK 21:20-24">Luj 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>"Ingiese <char style="pn">Danyili</char> xienzhi kieliesan hhe pohai giezhi hanzhan gieghaku zhiguitu oronde beisei ta chanlane. (Onshichen kunla, ene kielienni isii dunjirekuni wo.) <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Ingiekude <char style="png">Yudaya</char>de sousan kunla, ulade piile echi. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Gie jieredula, giederase dunxi agile bu bouzhe. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Ghazha jieredula, khareizhi jienne agile bu echi. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Hhe udude kewosi laisan, gogoghasanlade gou widawo. <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Ta holukude uncha, hhamuraku udui bu kuzhegha giezhi onxian gie. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Ingiekushi hhezighan udude zeinan zui fugie wo. Duya kaishi giesanse eli kutula imutu zeinan uwo, khuinashiye uwo. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Hhezighan zeinantu udui ese choghonshighazhoshi nieda jiui danema, sunghusan kunladene oluzhi choghonshighane. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Hhe udude kunla tande uzhe, Mexiha enende wo, hhende wo giese ta xianxin bu gie. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Jia Mexiha, jia xienzhila khizhezhi fugie ghudureqi, fugie shiqinlai giekushi sunghusanlaiye kenen miine. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Uzhe, bi shiqinlai tande eqie kieliewo. <verse eid="MAT 24:25"/><verse number="26" style="v" sid="MAT 24:26"/>Ingiese kunla tande uzhe, 'Mexiha hontande wo.' giezhi kieliese ta khizhi bu echi. Pse, 'Uzhe, hhe giedera wo.' giezhi kieliese ta xianxin bu gie. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Shanjien dunmiense khizhezhi ximiende zhouiku mutun Kunnikewon irekudeye ingiene. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Fugusan dunxi khalashi inye khala wo."<verse eid="MAT 24:28"/></para>
  <para style="s">Kunnikewon Ireku</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mak 13:24-27</ref>; <ref loc="LUK 21:25-28">Luj 21:25-28</ref>)</para>
  <para style="q1">
    <verse number="29" style="v" sid="MAT 24:29"/>"Hhezighan zeinanni udu jian daose</para>
  <para style="q2" vid="MAT 24:29">naran kharalane.</para>
  <para style="q2" vid="MAT 24:29">Sara gon ulie faine.</para>
  <para style="q2" vid="MAT 24:29">Hodunla asiman jierese anda bouzhene.</para>
  <para style="q2" vid="MAT 24:29">Asimanyi lilianla gojiolune.<verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>Ingiekude Kunnikewonyi zunji asiman jiere khizhene. Zemin jieredu minzula man wilane. Hhela Kunnikewon nenli, famanude olien jiere irekui chanlane. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Laba fugiede tunguliese Kunnikewon qienxienlane peizhi asiman enemanse hhemande kutula sunghusan kunlane simiense uruzhi hhantulaghane."<verse eid="MAT 24:31"/></para>
  <para style="s">Uhuago Mutunse Suruku</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mak 13:28-31</ref>; <ref loc="LUK 21:29-33">Luj 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>"Ta uhuago mutunyi bilasei suru. Mutun niazi faizhi lachen keise khaluncha orokui ta mejiene. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Taye niekielien wo. Ta ene shiqinla fashen giesei man chanlase hhe shihou chadashizhi shida kuzhesei mejiene. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Bi tande shuhua kielieye, ene idaini kunla fugutula ene shiqinla man gholune. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Asiman, zemin widaliuzhe mii kielien kenjin ulie widane."<verse eid="MAT 24:35"/></para>
  <para style="s">Hhe Uduni Mejiechen Kun Uwo</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mak 13:32-37</ref>; <ref loc="LUK 17:26-30">Luj 17:26-30</ref>, <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>"Hhe udu, hhe shihouni kiema ulie mejiene. Asiman jieredu qienxienlaye ulie mejiene. Kewonye ulie mejiene. Zinie Ada mejiene. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/><char style="pn">Nuhha</char>ni xienzide matugiezhoshi Kunnikewon irekudeye qingiene. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Hunshuise melieshidaku hhe xienzide kunla ijiezho, ochizho, bierei agizho, dafalazhi izhi <char style="pn">Nuhha</char> chon sudoro oroku hhe udude kuruwo. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Yamai mejie dakude hunshui iredene kunlai man tou yolawo. Kunnikewon irekudeye ingiene. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Hhe shihoude ghua kun ghazha jiereshi niei uduru echine, niei jiene. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Ghua bierei qieman sidase niei uduru echine, niei jiene. <verse eid="MAT 24:41"/><verse number="42" style="v" sid="MAT 24:42"/>Ingiese ta jinxin gie. Tai Ezhan yan xienzide irekui ulie mejiene. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Ta enei mejie, giei ezhan ghughei yan xienzide irekui mejiese jinxin giezhi giedene ulie oroghane. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Ingiese ta goude zhunbei giendu, ta mejie dakude Kunnikewon irene."<verse eid="MAT 24:44"/></para>
  <para style="s">Kekaotu Kekao Witu Hojila</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luj 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>"Qinse kienshi kekaotu jienzha hoji wo? Zhanguijini hhende giededu hojilai, ijiekulani man gonjighasan pushonu? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Zhanguiji irekude hoji ingiezhi giesei chanlase hhe hojide fuqi wine. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Bi tande shuhua kielieye, zhanguiji hhende caichanlane man gonjighane. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Hhe doghun hoji zhughedene sumulazhi mini zhanguiji deigo ulie irene gie, <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>psedu hojilai eghizhi sudosan kunlare ochizhi ijiese, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>hhe sumula daku udu, mejie daku shihoude zhanguijini iredene <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>hhei sidasunyi qiuizhi jiazhon giesan kunlare hhantu faise hhende shidunne zhouzhi wilane."<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s">Hharan Shini Biereini Bilazho</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>"Hhe shihoude asiman gojia hoxian hharan shini bierei zhula bareidene shini khughonyi jienliekui xianli. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Hhelai dunda tawun benni, tawun jienzhani wo. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Tawun bennila zhula bareidene tosun ese bareizho. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Tawun jienzhanila zhula bareidene hulude tosun bareizho. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Shini khughon udazhi da ese irese hhela man nokuzhi kijie hhunturawo. <verse eid="MAT 25:5"/><verse number="6" style="v" sid="MAT 25:6"/>Banyedei kunla waradazho, 'Bosizhendu! Shini khughon irewo! Ghujighan jienliele khizhendu!' <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>Shini biereila man bosizhedene zhulalane zhendunlawo. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Bennila jienzhanilade kieliewo, 'Tosunsene gouji ogi, zhulabijienyi xiniene giezho.' <verse eid="MAT 25:8"/><verse number="9" style="v" sid="MAT 25:9"/>Jienzhanila kieliewo, 'Ulie olune. Manlade injizhi ulie kurune. Ta huisan kunlase agile echi.' <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>Hhela agile echikude shini khughon irewo. Zhunbei gie goudaghasanla shini khughonre hhantu ghurunde echise wijienyi khawo. <verse eid="MAT 25:10"/><verse number="11" style="v" sid="MAT 25:11"/>Khuinashi psedu shini biereila iredene kieliewo, 'Ezhan, Ezhan, bijiende wijienyi nieya!' <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>Shini khughon kieliewo, 'Bi tande shuhua kielieye, bi tai tani dane.' <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/>Ingiese ta jinxin gie, hhe udu, hhe zhuntouni ta ulie mejiene."<verse eid="MAT 25:13"/></para>
  <para style="s">Ghuran Hojini Bilazho</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luj 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>"Asiman gojia hoxian nie kun gholode echine giezhi hojilane uruzhi ire baerne hhelade jiuizhi gonjighakui xianli. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Zhao hhelai benshizhe niede 500 antan, niede 200 antan, niede 100 antan ogidene gholode echiwo. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>500 linlasan deigo echidene meimei giezhi 500 zhenjiwo. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>200 linlasanye 200 zhenjiwo. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>100 linlasan echidene zeminde oko wai ezhanne baerni niuighawo. <verse eid="MAT 25:18"/><verse number="19" style="v" sid="MAT 25:19"/>Hende oloncha beidene ezhanni ire hhelase zhan sanazho. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>500 linlasan ezhanne shida ire zhenjisan 500 ne bareizhi kieliewo, 'Ezhan, chi made 500 ogiwo. Uzhe, bi pse 500 zhenjiwo.' <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>Ezhanni kieliewo, 'Giesan gou wo. Chishi gou, kekaotu hoji wo. Ga shiqinde shixinji giezho, bi chii olon shiqinlai gonjighane. Ezhanghalane hhantu bayasu.' <verse eid="MAT 25:21"/><verse number="22" style="v" sid="MAT 25:22"/>200 linlasan ire kieliewo, 'Ezhan, chi made 200 ogiwo. Uzhe, bi pse 200 zhenjiwo.' <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>Ezhanni kieliewo, 'Giesan gou wo. Chishi gou, kekaotu hoji wo. Ga shiqinde shixinji giezho. Bi chii olon shiqinlai gonjighane. Ezhanghalane hhantu bayasu.' <verse eid="MAT 25:23"/><verse number="24" style="v" sid="MAT 25:24"/>100 linlasan ire kieliewo, 'Ezhan, chishi jiafatu kun bikui bi mejiene. Ese tareisan oronse ghurane, ese shizhisan oronse hhantulaghane. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Bi ayizhi echidene chii 100 ni zeminde niuighawo. Uzhe, chii miengu enende wo.' <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/>Ezhanni hhende kieliewo, 'Chi ene doghun, langantu hoji, bi ese tareisan oronse ghurane, ese shizhisan oronse hhantulaghakui chi mejiese <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>mii baerni inhande jiekuni wo, bi irekude benqien lixiji agi khizhene. <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>Ta hhei baerlani agi echidene hhe 1000 bisande ogi. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Bichen kunlade pse olon ogizhi feilieghane, wichen kunlase bisanlainiye agi echine. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ene yama zoin witu hojini ghadanedu kharanide benda. Hhende shidunne zhouzhi wila gie!'"<verse eid="MAT 25:30"/></para>
  <para style="s">Zuihoude Panjiku</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>"Kunnikewon qienxienlare man hhantu goya fama dunda irekude hhe famatu baozo jierene soune. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Duyani soyuji minzulai hhei melie hhantulaghazhi hhe hhelai fenji keighane. Hoxian ghoni adulachen ghoni, imanyi fenji keighakui xianli. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Ghonilai borun miendene teine, imanlai soghei miendene teine. <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>Ingie honshan borun mienne kunlade kieliene, 'Adami fuqi ogisan kunla, irendu. Duyai zhayaghazhi iresanse tande zhunbei giesan gojiani jienliendu. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Bi oliesukude ta made ijieghazho, undasukudei made ochighazho. Bi chumen giekude ta mii soughazho. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Bi hulan muchughun bikude ta made musighazho. Bi giemerekude ta mii ushilazho. Bi bafanzideshi ta mii uzhele irezho.' <verse eid="MAT 25:36"/><verse number="37" style="v" sid="MAT 25:37"/>Gou kunla kieliene, 'Ezhan, bijien yan xienzide chi oliesusei chanladene chade ijieghazhi undasusei chanladene chade ochighawo? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Yan xienzide chumen giesei chanladene chii soughazhi hulan muchughun bikude chade jien musighawo? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Pse chi yan xienzide giemeresei chanladene ushilazhi bafanzideshi chii uzhele irewo?' <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>Honshan kieliewo, 'Bi tande shuhua kielieye, ta enezighan mii gaijiu dunda zui ganide oluzhi giese made oluzhi giezho.'"<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>"Ingie honshan soghei mienne kunlade kieliene, 'Ta ene kharasan kunla, yola. Ibilisi, Ibilisii hojilade zhunbei giesan ulie xinieku khande oro! <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Bi oliesukude ta made ese ijieghazhi undasukude made ese ochighawo. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Bi chumen giekude ta mii ese soughawo. Bi hulan muchughun bikude made ese musighawo. Bi giemerekude ta mii ese ushilazhi bafanzideshi ta mii uzhele ese irewo.' <verse eid="MAT 25:43"/><verse number="44" style="v" sid="MAT 25:44"/>Hhelaye kieliene, 'Ezhan, bijien yan xienzide chi oliesusei, undasusei, chumen giesei, hulan muchughun bikui, giemeresei, bafanzide bikui chanlazhi ese banman giewo?' <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>Honshan kieliene, 'Bi tande shuhua kielieye, ta enezighan kun dunda zui ganide ese oluzhi giese made oluzhi ese giezho.' <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>Enezighan kunla chanqi faikude orone, gou kunla chanqi amitukude orone."<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s">Ersai Alane Giezho</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mak 14:1-2</ref>; <ref loc="LUK 22:1-2">Luj 22:1-2</ref>; <ref loc="JHN 11:45-53">Yah 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>
    <char style="pn">Ersa</char> enezighan kielienlai man kielie baragha tujiladene kieliewo, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>"Pse ghuarudushi Jiulidaosan Jiei ta mejiene. Kunnikewonyi kunlade jiuidene shizijia jiere ghadazhi fugughane." <verse eid="MAT 26:2"/><verse number="3" style="v" sid="MAT 26:3"/>Qingiekude fugie buwa, bexinlani zhanlaola <char style="pn">Gaiyafa</char> giezhi urusan zui fugie buwai ghoronde hhantulazho. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Hhela piendaku banfaghala <char style="pn">Ersa</char>i bareidene alane giezhi shanlian giezho, <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>"Jieqii udude ulie olune, bexinla londane."<verse eid="MAT 26:5"/></para>
  <para style="s">Nie Bierei Ersai Jiere Xianshui Kiezho</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mak 14:3-9</ref>; <ref loc="JHN 12:1-8">Yah 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>
    <char style="pn">Ersa</char> <char style="png">Bodani</char>de pifugientu <char style="pn">Ximun</char>yi giede bikude <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>nie bierei ishighala giesan huapinde guizhuntu xianshuini hhei shida agizhi ire <char style="pn">Ersa</char> ijiezhi soukude qiorun jiereni kiewo. <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>Tujila chanladene hokuzhi kieliewo, "Ingiezhi lanfei giezhi yangiene? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Ene xianshuini olon baer huidene nanxin kunlade ogikui wo." <verse eid="MAT 26:9"/><verse number="10" style="v" sid="MAT 26:10"/><char style="pn">Ersa</char> hhelai isii mejiedene kieliewo, "Ene biereide chijia teizhi yangiene? Hhe made nie gou shiqin giewo. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Nanxin kunla tanre chan hhantu woma, bi chan hhantu uwo. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Ene bierei xianshuini mii jiere kiekushi mii bulakude zhunbei giezho. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Bi tande shuhua kielieye, ene gouxioxini chonjizhi qienxiade kutula ene bierei gieseiye kieliezhi jilane."<verse eid="MAT 26:13"/></para>
  <para style="s">Yuda Ersai Ghudanduzho</para>
  <para style="r">(<ref loc="MRK 4:10-11">Mak 4:10-11</ref>; <ref loc="LUK 22:3-6">Luj 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Ingiedene 12 gie tuji dundadu <char style="png">Jialie</char> kun <char style="pn">Yuda</char> giesan tuji fugie buwalai hhende echi kieliewo, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>"Bi hhei tande bareighase ta made yan ogine?" Hhela 30 gie miengu ogiwo. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Hhe shihouse <char style="pn">Yuda</char> <char style="pn">Ersa</char>i ghudanduku jihui ereizho.<verse eid="MAT 26:16"/></para>
  <para style="s">Ersa Tujilarene Daosan Jieni Daoghazho</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mak 14:12-21</ref>; <ref loc="LUK 22:7-14">Luj 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yah 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Tanmien Jieni tou 1 qiende tujila <char style="pn">Ersa</char>i shida ire asawo, "Bijien Jiulidaosan Jieni xini chade khala zhunbei giene?" <verse eid="MAT 26:17"/><verse number="18" style="v" sid="MAT 26:18"/>Hhe kieliewo, "Ta chenshini nie kunyi hhende echidene kielie, 'Loushi kieliezho, "Mii shihou ghujinlazho. Bi tujilarene chii giede Jiulidaosan Jieni daoghane."'" <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Tujila <char style="pn">Ersa</char> kieliesan mutun echidene Jiulidaosan Jieni zhunbei giewo. <verse eid="MAT 26:19"/><verse number="20" style="v" sid="MAT 26:20"/>Khara oluse <char style="pn">Ersa</char> 12 gie tujirene hhantu xi souzho. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Hhela ijiekude <char style="pn">Ersa</char> kieliewo, "Bi tande shuhua kielieye, tai dunda nie kun mii ghudandune." <verse eid="MAT 26:21"/><verse number="22" style="v" sid="MAT 26:22"/>Hhela hende munan giedene Ezhan, bi pushoba giezhi nienieji asa qiiwo. <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/><char style="pn">Ersa</char> kieliewo, "Mare hhantu jiezise zhanjizhi ijiesan kun mii ghudandune. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Kunnikewon jinwun jiere huaisan mutun fugunema, hhei ghudandusan kunde gou widawo! Hhe kunyi ese oluzhoshida gou wo." <verse eid="MAT 26:24"/><verse number="25" style="v" sid="MAT 26:25"/><char style="pn">Ersa</char>i ghudandusan <char style="pn">Yuda</char> hhende asawo, "Loushi, bi pushoba?" Ersa kieliewo, "Chi enbene, goyane kieliewo."<verse eid="MAT 26:25"/></para>
  <para style="s">Zuihouku Heifan</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mak 14:22-26</ref>; <ref loc="LUK 22:15-20">Luj 22:15-20</ref>; <ref loc="1CO 11:23-25">1Gel 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Hhela ijiekude <char style="pn">Ersa</char> ginanyi barei onxian giedene ghulu, tujilade ogi kieliewo, "Ta bareidene ijie. Eneshi mii beye wo." <verse eid="MAT 26:26"/><verse number="27" style="v" sid="MAT 26:27"/>Pse beizii barei mafan kieliedene hhelade ogi kieliewo, "Ta man enei ochi. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Eneshi olon kunlai zuini mienliene giezhi usurusan bi yenjisan chusun wo. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Bi tande kielieye, bi pse ene putoujiuni ulie ochizhi adaimi gojiade tanre hhantu shinii ochiku hhe udu kune." <verse eid="MAT 26:29"/><verse number="30" style="v" sid="MAT 26:30"/>Hhela douladene khizhe <char style="png">Ganlanshan</char>de echiwo.<verse eid="MAT 26:30"/></para>
  <para style="s">Ersa Tujilani Hhei Bendakui Kieliezho</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mak 14:27-31</ref>; <ref loc="LUK 22:31-34">Luj 22:31-34</ref>; <ref loc="JHN 13:36-38">Yah 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Ingiedene <char style="pn">Ersa</char> tujiladene kieliewo, "Ene xii ta man mii bendane. Jinwun jiere kieliezho,</para>
  <para style="q1" vid="MAT 26:31">'Bi yanbashii eghi unaghase</para>
  <para style="q2" vid="MAT 26:31">ghonila sandane.'<verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Ingieliuzhe bi aminne oludene tanse melie <char style="png">Jialili</char>de echine." <verse eid="MAT 26:32"/><verse number="33" style="v" sid="MAT 26:33"/>Ingiese <char style="pn">Beduru</char> kieliewo, "Kunla man chii bendaliuzhe bi jiedui ulie bendane!" <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/><char style="pn">Ersa</char> hhende kieliewo, "Bi chade shuhua kielieye, ene xii tigha kheilatula chi mii 3 hui ulie renjine." <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/><char style="pn">Beduru</char> kieliewo, "Bi chare hhantu fuguliuzhe chii tani dane giezhi ulie kieliene!" Tujilaye man qingiezhi kieliezho.<verse eid="MAT 26:35"/></para>
  <para style="s">Keximanide Onxian Giezho</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mak 14:32-42</ref>; <ref loc="LUK 22:39-46">Luj 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>
    <char style="pn">Ersa</char> tujilare nie <char style="png">Keximani</char> giesan oronde ire tujilade kieliewo, "Ta enende sou, bi hhemiende onxian giele echine." <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/><char style="pn">Ersa</char> <char style="pn">Beduru</char>, <char style="pn">Xibitai</char>ni ghua kewonni uduruzhi echiwo. Ingie yuchou giezhi nango gie qii <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>hhelade kieliewo, "Mii zhughede nango giezhi fugukui xianli. Ta enende sagheizhi mare hhantu jinxin gie." <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/>Hhe goujinie melie yodene zemin jiere papala onxian giezhi kieliewo, "Mii ada, olu shidase ene shouku giekui made bu iregha! Ingieliuzhe mii duranghala bu gie, chii duranghala gie." <verse eid="MAT 26:39"/><verse number="40" style="v" sid="MAT 26:40"/><char style="pn">Ersa</char> tujilai hhende irese hhela hhunturasei chanladene <char style="pn">Beduru</char>de kieliewo, "Ta mare nie zhuntouye jinxin gie danu? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Jinxin giezhi onxian gie, pse miine. Tai zhughede duran winema, beyetai zholien wo." <verse eid="MAT 26:41"/><verse number="42" style="v" sid="MAT 26:42"/>Ingie pse erchan likai giedene onxian giezhi kieliewo, "Mii ada, ene kuni bi ulie shouizhi ulie oluse, chi duranghalane gie." <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>Pse irese hhela hhunturasei chanlawo. Hhela nokuzhi nudunne nie dazho. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/><char style="pn">Ersa</char> pse hhelase likai gie ji 3 hui onxian giele echiwo. Kieliesan kielien melieshidakughala niekielien wo. <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>Ingie tujilai hhende ire hhelade kieliewo, "Ta dou hhunturazhi hhamuranu? Uzhe, shihou kuzhewo. Kunnikewonyi zuirenlai khade ghudanduwo. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Bosizhe, matan yoye. Uzhe, mii ghudandusan kun irewo."<verse eid="MAT 26:46"/></para>
  <para style="s">Ersai Bareiwo</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="LUK 22:47-53">Luj 22:47-53</ref>; <ref loc="JHN 18:3-12">Yah 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>
    <char style="pn">Ersa</char> zhen kieliekude 12 gie tuji dundadu <char style="pn">Yuda</char> fugie buwa, bexinlai zhanlaola peisan idaban banban, khudogho bareisan kunlare hhantu irewo. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/><char style="pn">Ersa</char>i ghudandusan kun hhelade nie jihao kieliezho, "Bi kiende orese kien enbene. Ta hhei barei." <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/><char style="pn">Yuda</char> dei <char style="pn">Ersa</char>i shida echi loushi, salan giedene orewo. <verse eid="MAT 26:49"/><verse number="50" style="v" sid="MAT 26:50"/><char style="pn">Ersa</char> hhende kieliewo, "Zhanlien, chi giele iresan shiqinne gie." Ingiese hhela melie ire <char style="pn">Ersa</char>i bareiwo. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Ingiekude <char style="pn">Ersa</char>re hhantuku nie kun khudoghoi lai khizhe zui fugie buwai hojii nie chighinyi chizhi agiwo. <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/><char style="pn">Ersa</char> hhende kieliewo, "Khudoghone xiuzide orogha. Kien khudogho gojiolughase khudogho doura fugune. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Bi Adane xiahua giese hhe made deigo 12 gie buduitonse da olon qienxienyi ireghakui chi mejie dazhou? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Qingiese bixi fashen giene giezhi kieliesan jinwunlani matugie gholughane?" <verse eid="MAT 26:54"/><verse number="55" style="v" sid="MAT 26:55"/>Hhe shihoude <char style="pn">Ersa</char> kunlade kieliewo, "Ta khudogho, banbanlai bareidene mii qiandao mutun bareile irewu? Niudunie bi mechide soudene sughase ulie bareine. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Enela man fashen giekushi xienzhini shu jieredu kielienyi gholughane giezho." Ingiekude tujila man <char style="pn">Ersa</char>se likai gie holu widawo.<verse eid="MAT 26:56"/></para>
  <para style="s">Yutai Kunla Ersai Shenwun Giezho</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mak 14:53-65</ref>; <ref loc="LUK 22:54-55">Luj 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yah 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>
    <char style="pn">Ersa</char>i bareisan kunla <char style="pn">Ersa</char>i zui fugie buwa <char style="pn">Gaiyafa</char>i hhende lai echiwo. Hhende jinwun hanjia, zhanlaola hhantulazho. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/><char style="pn">Beduru</char> gholose daghazhi zui fugie buwai ghoronde orodene wijien sagheisan kunlare hhantu souzhi ene shiqin matui gholukui uzhezho. <verse eid="MAT 26:58"/><verse number="59" style="v" sid="MAT 26:59"/>Fugie buwa, zui fugie fayenni soyuji kunla man jia ganzhen ereizhi <char style="pn">Ersa</char>i alane giezho. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Olon kunla khizhezhi jia ganzhen beizhoma, zhenji erei dazho. Zuihoude ghua kun ire kieliewo, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>"Ene kun orun mechii cheidene ghurudude gie khigha shidane giezhi kieliezho." <verse eid="MAT 26:61"/><verse number="62" style="v" sid="MAT 26:62"/>Zui fugie buwa bosizhedene <char style="pn">Ersa</char>de kieliewo, "Ene kunla ganzhen beizhi zhasande chi yama huida ulie gienu?" <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/><char style="pn">Ersa</char> shenqi ese khizhezho. Zui fugie buwa kieliewo, "Chanqiku Hudade bi chii fayen gieghaye. Chishi Mexiha, Hudai kewon enbese bijiende kielie." <verse eid="MAT 26:63"/><verse number="64" style="v" sid="MAT 26:64"/><char style="pn">Ersa</char> hhende kieliezho, "Chi goyane kieliezho. Ingiezhoma bi tande kielieye,</para>
  <para style="q1" vid="MAT 26:64">Ta enedu khuinashi</para>
  <para style="q2" vid="MAT 26:64">Kunnikewon Nenlitu Hudai borun miende sousei,</para>
  <para style="q2" vid="MAT 26:64">pse asimanni olien jierese irekui chanlane."<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Zui fugie buwa jienne sida keigha kieliewo, "Hhe kufurei fanjiwo! Matan pse yan ganzhen beiku kun kerene? Hhe kufurei fanjisei ta jian chenliewo. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Ta kieliese matugiene?" Hhela kieliese sixin panjikuni wo giezho. <verse eid="MAT 26:66"/><verse number="67" style="v" sid="MAT 26:67"/>Hhela ungie jiereni nunpuzhi chuidazho. Niezhanla hhaghadazhi kieliezho, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>"Mexiha, chii kien eghisei bijiende nie kielie."<verse eid="MAT 26:68"/></para>
  <para style="s">Beduru Ersani Ese Renjizho</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mak 14:66-72</ref>; <ref loc="LUK 22:56-62">Luj 22:56-62</ref>; <ref loc="JHN 18:15-18">Yah 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Ingiekude <char style="pn">Beduru</char> ghadanedu ghoronde souzho. Nie hoji oqin hhei melie iredene kieliewo, "Chiye <char style="png">Jialili</char>ni <char style="pn">Ersa</char>re hhantuku wo." <verse eid="MAT 26:69"/><verse number="70" style="v" sid="MAT 26:70"/><char style="pn">Beduru</char> dajialai melie ese renjizhi kieliewo, "Chi yan kieliesei bi ulie mejiene." <verse eid="MAT 26:70"/><verse number="71" style="v" sid="MAT 26:71"/>Hhe wijien shida echise da nie hoji oqin chanladene hhendedu kunlade kieliewo, "Ene kunshi <char style="png">Nasale</char> kun <char style="pn">Ersa</char>re hhantuku wo." <verse eid="MAT 26:71"/><verse number="72" style="v" sid="MAT 26:72"/><char style="pn">Beduru</char> pse ese renjidene fayen giezhi kieliewo, "Bi hhe kunyi tani dane." <verse eid="MAT 26:72"/><verse number="73" style="v" sid="MAT 26:73"/>Goujicha beidene shidani beisan kunla <char style="pn">Beduru</char>i melie ire kieliewo, "Chi kenjinshi hhelare hhantuku kun wo. Chii kouin chii mejieghawo." <verse eid="MAT 26:73"/><verse number="74" style="v" sid="MAT 26:74"/><char style="pn">Beduru</char> fayen giezhi khara qiiwo, "Hhe kunyi bi tani dane!" Deigo tigha kheilawo. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/><char style="pn">Beduru</char> <char style="pn">Ersa</char> kieliesan tigha kheilatula chi mii 3 hui ulie renjine giesei sumula ire, khizhi echidene nango giezhi hende wilawo.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s">Ersani Biladode Jiuizho</para>
  <para style="r">(<ref loc="MRK 15:1">Mak 15:1</ref>; <ref loc="LUK 23:1-2">Luj 23:1-2</ref>; <ref loc="JHN 18:28-32">Yah 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Eqiemagha oluse fugie buwa, bexinlani zhanlaola man shanlian giezhi <char style="pn">Ersa</char>i alane giezho. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Hhela <char style="pn">Ersa</char>i banladene laizhi <char style="pn">Bilado</char> shenzhande jiuiwo.<verse eid="MAT 27:2"/></para>
  <para style="s">Yuda Goyane Fuguzho</para>
  <para style="r">(<ref loc="ACT 1:18-19">Tuj 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>
    <char style="pn">Ersa</char>ni ghudandusan <char style="pn">Yuda</char> <char style="pn">Ersa</char>de zui jinjisei chanladene houhui giezho. Hhe 30 gie mienguni fugie buwa, zhanlaolade khareizhi ogidene kieliewo, <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>"Bi hanhanji kunyi ghudanduse made zui wo." Hhela kieliewo, "Eneshi chii shiqin wo. Bijienre yan gonxi wo?" <verse eid="MAT 27:4"/><verse number="5" style="v" sid="MAT 27:5"/><char style="pn">Yuda</char> miengui mechide benda jiedene khizhi echi jiuzhilie fuguwo. <verse eid="MAT 27:5"/><verse number="6" style="v" sid="MAT 27:6"/>Fugie buwala miengui qiangudene kieliezho, "Eneshi chusun qien wo. Mechini kufande teizhi ulie olune." <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Hhela shanlian giedene hhe baerghala gan giesan kunyi ghazhai agizhi niman kunyi meza giewo. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Ingiese eli kutula hhe ghazhai chusun ghazha giezho. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Ingiese Ezhan <char style="pn">Yelimi</char> xienzhii tungo giezhi kieliesan kielien mutun gholuwo, "Hhela <char style="png">Isilie</char> kun hhei aminde jinjisan 30 gie miengughala <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>gan giesan kunyi ghazhai agiwo. Eneshi Huda made fenfulasan wo."<verse eid="MAT 27:10"/></para>
  <para style="s">Bilado Ersai Shenwun Giezho</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mak 15:2-5</ref>; <ref loc="LUK 23:3-5">Luj 23:3-5</ref>; <ref loc="JHN 18:33-38">Yah 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>
    <char style="pn">Ersa</char> <char style="pn">Bilado</char> shenzhanni melie beizho. Shenzhan hhende asawo, "Chishi <char style="png">Yutai</char> kunni honshan onu?" <char style="pn">Ersa</char> kieliewo, "Chi kieliezho." <verse eid="MAT 27:11"/><verse number="12" style="v" sid="MAT 27:12"/>Fugie buwa, zhanlaola hhei zhase hhe yama ulie kieliene. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Ingie <char style="pn">Bilado</char> asawo, "Hhela chii imegheni zhase chi ese sonosuzhou?" <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/><char style="pn">Ersa</char> nie amanda huida ese giese shenzhan hende ghanirazho.<verse eid="MAT 27:14"/></para>
  <para style="s">Ersani Sixin Panjizho</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mak 15:6-15</ref>; <ref loc="LUK 23:13-25">Luj 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yah 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Niefanie ene jieqide shenzhan bexinla keresan mutun nie fanren andaghaku xigon wine. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Hhe shihoude nie chumin giesan fanrenni <char style="pn">Balaba</char> giene. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Kunla hhantulakude <char style="pn">Bilado</char> hhelade kieliewo, "Bi tande aliniei andagha? <char style="pn">Balaba</char> onu, Mexiha giesan <char style="pn">Ersa</char> wo?" <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Hhela <char style="pn">Ersa</char>i dubiliezhi hhende jiuizhi ogisei hhe mejiedene ingiezhi asazho. <verse eid="MAT 27:18"/><verse number="19" style="v" sid="MAT 27:19"/>Hhe shenpantai jiere soukude biereini kun peizhi iregha kieliewo, "Chi ene gou kunni shiqinyi goujida bu gonji. Ene xii mii zhoujinde hhei yenyin jiere bi hende munan giezho." <verse eid="MAT 27:19"/><verse number="20" style="v" sid="MAT 27:20"/>Fugie buwa, zhanlaola bexinlai shanjizhi <char style="pn">Balaba</char>i andagha, <char style="pn">Ersa</char>i ala giezho. <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>Shenzhan hhelade kieliewo, "Bi ene ghualase tande aliniei andagha?" Hhela kieliewo, "<char style="pn">Balaba</char> wo!" <verse eid="MAT 27:21"/><verse number="22" style="v" sid="MAT 27:22"/><char style="pn">Bilado</char> kieliewo, "Qinse Mexiha wo giesan <char style="pn">Ersa</char>i bi matugiene?" Hhela man kieliewo, "Hhei shizijia jiere ghada!" <verse eid="MAT 27:22"/><verse number="23" style="v" sid="MAT 27:23"/><char style="pn">Bilado</char> kieliewo, "Yangiezhi? Hhe yan doghun shiqin giewo?" Hhela pse hende waradazhi kieliewo, "Hhei shizijia jiere ghada!" <verse eid="MAT 27:23"/><verse number="24" style="v" sid="MAT 27:24"/><char style="pn">Bilado</char> uzhese goya kieliesan yama oronde uwo, kharei londakui xianli. Ingie bexinlai melie usu agizhe, khane wagha kieliewo, "Ene kunni chusun usurusan zui mii jiere uwo. Ta goyalane danji." <verse eid="MAT 27:24"/><verse number="25" style="v" sid="MAT 27:25"/>Bexinla man hhantu kieliezho, "Hhei chusun bijien, bijienyi houdeini jiere ire gie!" <verse eid="MAT 27:25"/><verse number="26" style="v" sid="MAT 27:26"/>Ingiese <char style="pn">Bilado</char> <char style="pn">Balaba</char>i andaghawo. <char style="pn">Ersa</char>i mabienzighala eghidene kunlade jiuizhi shizijia jiere ghada giezho.<verse eid="MAT 27:26"/></para>
  <para style="s">Buduila Ersai Xilun Giezho</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mak 15:16-20</ref>; <ref loc="JHN 19:2-3">Yah 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Shenzhanni buduila <char style="pn">Ersa</char>i laizhi shenzhan sousan oronde echi, nie tonni buduilai man hhei shida hhantulaghawo. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Hhela <char style="pn">Ersa</char>i jienyi teighadene dahun fudu jienyi musighawo. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Eghesunyi honshan zhoku maghalai onjidene qiorun jierei zhoghasenu borun khadei ghulusunyi bareighadene meliei xiutuliezhi <char style="png">Yutai</char> kunni honshan, onsui giezhi xilun giezho. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Hhei jiere nunpuzhi qiorun jierei ghulusunghala eghizho. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Xilun gie balu, fudu jienyi teigha, jienyini musighadene lai shizijia jiere ghadale echiwo.<verse eid="MAT 27:31"/></para>
  <para style="s">Ersani Shizijia Jiere Ghadazho</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mak 15:21-32</ref>; <ref loc="LUK 23:26-43">Luj 23:26-43</ref>; <ref loc="JHN 19:17-27">Yah 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Hhela khikude <char style="png">Gulinai</char>ni nie <char style="pn">Ximun</char> giesan kunyi penjidene ninkounin <char style="pn">Ersa</char>i shizijiai beilieghawo. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/><char style="png">Gegeta</char> giesan nie oronde kuruwo. <char style="png">Gegeta</char>ni isishi qiorun yasun oron wo. <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Buduila kudanni jiude huigha <char style="pn">Ersa</char>de ochighase goujinie ochi ese ochiwo. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Hhela <char style="pn">Ersa</char>i shizijia jiere ghadadene fendan qianguzhi jienyini ghughasenu <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>hhende souzhi uzhezho. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Peizi jiere eneshi <char style="png">Yutai</char> kunni honshan Ersa wo giezhi zuinini huaidene qiorun qiendei guaiwo. <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Ingiedene hhere hhantu ghua qiandaoi shizijia jiere niei borun miende niei soghei miende ghadawo. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Hhense yozhi daosan kunla sugiezhi qiorunne shuiqizhi kieliezho, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>"Chi mechii cheise ghurudude gie khighane giesan, chi Hudai kewon enbese goyane jiuizhi shizijia jierese bouzhesha!" <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>Fugie buwa, jinwun hanjia, zhanlaolaye ingiezhi uzhezhi xiniezhi kielienduzho, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>"Hhe kunlai jiuiwo, goyane jiui dane. Hheshi <char style="png">Isilie</char>ni honshan wo. Ede shizijia jierese bouzhe giema, bijien xianxin gieye. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Hhe Hudai kouizho, dou orunshi Hudai kewon wo giezho. Qinse Huda duran bise ede hhei jiui gie!" <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Hhantu ghadasan qiandaolaye ingiezhi sugiezho.<verse eid="MAT 27:44"/></para>
  <para style="s">Ersa Duya Ijiewo</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mak 15:33-41</ref>; <ref loc="LUK 23:44-49">Luj 23:44-49</ref>; <ref loc="JHN 19:28-30">Yah 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Zhunwuse xiawu 3 jien olutula zemin man kharalazho. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Chabudu 3 jien oluse <char style="pn">Ersa</char> fugiede, "Ili, Ili, lamasabagedani?" giezhi waradazho. Isishi, "Mii Huda, mii Huda, chi mii yangiezhi ulie gonjine?" giezho. <verse eid="MAT 27:46"/><verse number="47" style="v" sid="MAT 27:47"/>Hhende beisan niezhan kunla chenliedene kieliezho, "Ene kun <char style="pn">Iliya</char>ni waradazho." <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>Hhelai dundadu nie kun deigo holu echi, haimiende cui zhanji ghulusun jiere banla hhende ughawo. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Psedu kunla kieliezho, "Gouji saghei, matan <char style="pn">Iliya</char> hhei jiuile irenu ulie irekui uzheye." <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/><char style="pn">Ersa</char> pse fugiede nie warada, ho sirawo. <verse eid="MAT 27:50"/><verse number="51" style="v" sid="MAT 27:51"/>Zhen ingiekude dajienni sudorodu menlienzi jierese doura kei echidene ghua gholuwo. Zemin gojioluzhi tashila ghaluwo. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Mezala keizhi olon duya ijiesan shentulai beyela aminne oluwo. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/><char style="pn">Ersa</char> aminne oludene hhela mezase khizhezhi zhiguitu chenshi <char style="png">Yelusalen</char>de oro, olon kunlade chujiegheghawo. <verse eid="MAT 27:53"/><verse number="54" style="v" sid="MAT 27:54"/>Baifuzhan, pse hhere hhantu <char style="pn">Ersa</char>i sagheisan kunla zemin gojiolusan, psedu shiqinlai chanladene hende ayizhi, "Ene kunshi zhenzhenji Hudai Kewon enbene." giezhi kieliezho. <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>Hhende <char style="png">Jialili</char>se <char style="pn">Ersa</char>i daghazhi ushilasan olon biereila gholose uzhezho. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Hhelai dunda <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, <char style="pn">Yagebu</char> <char style="pn">Yusufu</char> ghualai anani <char style="pn">Mereiyen</char>, <char style="pn">Xibitai</char>ni kewonlai anani wo.<verse eid="MAT 27:56"/></para>
  <para style="s">Ersai Mezade Teizho</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mak 15:42-47</ref>; <ref loc="LUK 23:50-56">Luj 23:50-56</ref>; <ref loc="JHN 19:38-42">Yah 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Khara oluse <char style="png">Yalimatai</char>ni <char style="pn">Yusufu</char> giesan nie bayan kun irewo. Hheshiye <char style="pn">Ersa</char>i tuji wo. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Ene kun <char style="pn">Bilado</char>i hhende echidene <char style="pn">Ersa</char>i beyeni xiahua giezhi kerewo. Ingie <char style="pn">Bilado</char> ogi giezhi fenfulawo. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/><char style="pn">Yusufu</char> beyeni agi bouzhe, ganjin boside boui goudaghawo. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Tashide waisan goya shini mezadene teiwo. Pse fugie tashii ghoghoreighazhi meza kouzii duighadene likai giewo. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Hhende <char style="png">Modala</char>ni <char style="pn">Mereiyen</char>, da nie <char style="pn">Mereiyen</char>ghala mezai duimiende souzho.<verse eid="MAT 27:61"/></para>
  <para style="s">Mezai Sagheizho</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Khuichudushi hhamuraku udu wo. Fugie buwa, Falisai kunla <char style="pn">Bilado</char>i hhende hhantuladene kieliewo, <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>"Noyen, bijien jilase kunlai piendasan hhe kun ese fugukudei ghurudushi aminne olune giezhi kieliezho. <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Chi ghurudu olutula mezai uzhezhi goudagha giezhi fenfula. Pse tujilani ghula echizhi bexinlade, 'Hhe fugudene aminne oluwo.' giezhi kieliene. Ingiese kun piendaku melieshikuse pse hendane." <verse eid="MAT 27:64"/><verse number="65" style="v" sid="MAT 27:65"/><char style="pn">Bilado</char> kieliewo, "Ta buduilai uduru echi. Jinlianji uzhezhi goudagha." <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Hhela echi meza kouzini tashii fenjidene buduilade goude uzheghawo.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s">Ersa Aminne Oluzho</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mak 16:1-8</ref>; <ref loc="LUK 24:1-12">Luj 24:1-12</ref>; <ref loc="JHN 20:1-10">Yah 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Hhamuraku udu daozhi xinqini ogheikude <char style="png">Modala</char>ni <char style="pn">Mereiyen</char> da nie <char style="pn">Mereiyen</char>ghala mezai uzhele irewo. <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>Menzhali zemin hende gojiolukushi Ezhanyi qienxien asiman jierese bouzhe tashii ghoghorei daogha jierei souzho. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Hhei yanzini gieghande gon faisei xianli, jienni chighande zhansunyi xianli. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Mezai sagheisan kunla ayizhi pugharadene fugusan kun mutun gholuwo. <verse eid="MAT 28:4"/><verse number="5" style="v" sid="MAT 28:5"/>Qienxien biereilade kieliewo, "Bu ayi! Ta shizijia jiere ghadasan <char style="pn">Ersa</char>i ereisei bi mejiene. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Hhe enende uwo. Hhe kieliesan mutun aminne oluwo. Hhe kijiesan oronni ta uzhele ire. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Ta ghujighan echidene tujiladeni hhe fugusan kun dundase aminne oluwo. Tanse melie <char style="png">Jialili</char>de echine. Ta hhende hhei chanlane giezhi kielie. Uzhe, bi tande kieliesei jila." <verse eid="MAT 28:7"/><verse number="8" style="v" sid="MAT 28:8"/>Biereila jindazhi mezase khizhe, hende bayasuzhi ayidene holuzhi tujiladeni kieliele echiwo. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Menzhali <char style="pn">Ersa</char> hhelai penji, "Ta gou onu?" giezhi kieliezho. Hhela shidani echi konsei qioru hhei beiizho. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/><char style="pn">Ersa</char> hhelade kieliezho, "Bu ayi! Ta echidene mii gaijiulade <char style="png">Jialili</char>de echi giezhi kielie. Hhela hhende mii ochirane."<verse eid="MAT 28:10"/></para>
  <para style="s">Fugie Buwala Buduilai Ghudan Kielieghazho</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Biereila echikude giedun uzhesan buduila chenshide echi, fashen giesan shiqinlai fugie buwalade man kieliewo. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Fugie buwa zhanlaola hhantulazhi shanlian giedene buduilade olon baer ogizhi kieliezho, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>"Ta 'Bijien xieni kijiekude tujilani ire hhei beyeni ghula echiwo.' giezhi kielie. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ene kielien shenzhanyi chighinde echise bijien hhende kieliezhi tai yama bu gieghaye." <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Buduila baerni jienliedene hhela fenfulasan mutun giewo. Ene kielien <char style="png">Yutai</char> kunyi dunda chonjizhi eli kuzho.<verse eid="MAT 28:15"/></para>
  <para style="s">Go Minzulade Echi!</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mak 16:14-18</ref>; <ref loc="LUK 24:36-49">Luj 24:36-49</ref>; <ref loc="JHN 20:19-23">Yah 20:19-23</ref>; <ref loc="ACT 1:6-8">Tuj 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>11 gie tujila <char style="png">Jialili</char>de echizhi <char style="pn">Ersa</char> jinjisan ulade khireiwo. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Hhela <char style="pn">Ersa</char>i chujieghedene beiizho, niezhan kunla inxin giezho. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/><char style="pn">Ersa</char> melie ire hhelade kieliewo, "Asiman, zemin jieredu qienlilani man made ogiwo. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Ingiese ta echidene soyuji minzuni kunlai Ada, Kewon, Shenlinni niereghala xili gieghazhi tuji gholugha. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Bi tande fenfulasan soyujilai hhelade sughazhi zunjigha. Uzhe, bi duya baratula tanre chanqi hhantu wo."<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
