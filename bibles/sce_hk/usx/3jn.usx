  <para style="h">Yaheiya Huaisan Ji 3 Hui Xin</para>
  <para style="toc1">Yaheiya Huaisan Ji 3 Hui Xin</para>
  <para style="toc2">3Yaheiya</para>
  <para style="toc3">3Yah</para>
  <para style="mt">Yaheiya Huaisan Ji 3 Hui Xin</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="s">Kielien Asazho</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>Bishi nie zhanlao wo, zhughe jieredu <char style="pn">Gaiyu</char>de xin huaizho. Bi chade shixin orezho.<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>Mii orentu, ruhherchii gou biku mutun shiqinlachii, beyechii man gou woshijiu. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Gaijiula kharei iredene chii zhughede zhendao wine, pse chi zhao zhendao mutun giezho giezhi zhenmin giese bi hende bayasuzho. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Bi chenliese kesilami zhao zhendao mutun giezho giese enense bayasukui uwo.<verse eid="3JN 1:4"/></para>
  <para style="s">Gouxioxi Chonjisan Wiliechilai Zhaogu Gie</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Mii orentu, chi gaijiulade tani daseye shixinde zhaogu giezho. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Hhela iredene ene jiohuini kunlade chi hhelade oresei kieliezho. Hhela mo yokude Huda bayasuku mutun ta izhi hhelai khughose gou wo. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Hhela <char style="pn">Ersa</char> Mexihani nierede oluzhi ghadane khireiwo, xianxin uye giechen niman kunlase yama ese kerewo. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Matan indan imutu kunlade banman giese oluzho. Ingiese matan zhendaode oluzhi hhelare lienshou gholune.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Ene shiqinde melieshida bi jiohuide xin huaizhoma, touzi danlakude xiqi bitu <char style="pn">Jiutefei</char> bijiennughunyi ese chenliezho. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Ingie bi echise hhe giesan shiqinlani kielie khizheghane. Hhe doghun kielienghala bijienni heizho. Dou enende ese kuruzhi mo yozhi chonjisan gaijiulani goya ulie jienliene, jienliene giesan kunyi ulie jienlieghane, da jiohuise tou khighane. <verse eid="3JN 1:10"/><verse number="11" style="v" sid="3JN 1:11"/>Mii orentu, doghunnii bu dagha, gounii dagha. Gouni giesanlashi Hudanughun wo, doghunni giesanla Hudai uzhezhi ese daozho.<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>Olon kunla <char style="pn">Jimijiu</char>shi gou kun wo giezho, zhendao benshen hhende ganzhen beine. Bijienye hhende ganzhen beine. Bijien beisan ganzhenshi zhenni bikuni ta mejiene.<verse eid="3JN 1:12"/></para>
  <para style="s">Zuihouku Kielien</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>Bi chade huaiku shiqin da olon woma, meshui, bighala huaiku duran uwo. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Bi xiwon giese ghujighan chii chujieghedene danmien kielieku duran wo. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>Chade pinnan ogi gie. Zhanlienla man chii asazho. Chii hhendedu zhanlienlai zhao nierezhe kielien asa.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
